  let _ : CategoryTheory.IsFiltered Idx := filtIdx
  have hStageEx : ∀ j : Idx,
      let M := ↥j.1.1.1
      let _ : FiniteDimensional K M := j.1.1.2.1
      let _ : IsGalois K M := j.1.1.2.2
      let _ : Finite ↥j.1.2 := j.2.1
      ∃ (ℋ : CategoryTheory.Sheaf J_K AddCommGrpCat.{u}) (ι_ℋ : ℋ ⟶ G) (r : ℕ),
        ℓ • CategoryTheory.CategoryStruct.id ℋ = 0 ∧
        (∀ U : S_K.Etale,
