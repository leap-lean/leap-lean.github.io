    let pbSub : ∀ {X Y : 𝒜} (f : X ⟶ Y), Subobject Y → Subobject X :=
      fun f A => Subobject.mk (Limits.pullback.fst f A.arrow)
    have hPbMono : ∀ {X Y : 𝒜} (f : X ⟶ Y) {A₁ A₂ : Subobject Y},
