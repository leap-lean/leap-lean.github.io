    let U_u : S₂.Etale := weilGysinEtaleObj u hu
    let φ₁ : M_u.obj T₁ ⟶ U_u := CategoryTheory.MorphismProperty.Over.homMk T₁.hom rfl
    let t₁ : ↥((M_pull.obj ℐ).obj.obj (Opposite.op T₁)) := (ℐ.obj.map φ₁.op).hom t_u
    let h_t₁ : Aℤ ⟶ (M_pull.obj ℐ).obj.obj (Opposite.op T₁) :=
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • t₁
          map_zero' := zero_zsmul t₁
          map_add' := fun a b => add_zsmul t₁ a.down b.down }
    let g_M : C₁.obj Aℤ ⟶ M_pull.obj ℐ := (adj₁.homEquiv Aℤ (M_pull.obj ℐ)).symm h_t₁
    let g_ℐ : C₁.obj Aℤ ⟶ P_u.obj ℐ := g_M ≫ α_MB.inv.app ℐ
    refine ⟨g_ℐ, ?_⟩
    have hM_eq : g_M ≫ M_pull.map π = ι_M ≫ M_pull.map f_c := by
      apply (adj₁.homEquiv Aℤ (M_pull.obj 𝒬)).injective
      rw [hadj₁_comp, hadj₁_comp]
      ext ⟨n⟩
      have hn_eq : (ULift.up n : Aℤ) = n • (ULift.up (1 : ℤ) : Aℤ) := by
        ext
        simp
      rw [hn_eq, map_zsmul, map_zsmul]
      congr 1
      change (π.hom.app (Opposite.op (M_u.obj T₁))).hom ((1 : ℤ) • t₁) =
        (f_c.hom.app (Opposite.op (M_u.obj T₁))).hom
          (((C₂.obj Aℤ).obj.map σ.op).hom ((adj₂.unit.app Aℤ).hom (ULift.up (1 : ℤ))))
      rw [one_zsmul]
      have hLHS :
          (π.hom.app (Opposite.op (M_u.obj T₁))).hom t₁ =
            (𝒬.obj.map φ₁.op).hom ((π.hom.app (Opposite.op U_u)).hom t_u) :=
        congrArg (fun m => m.hom t_u) (π.hom.naturality φ₁.op)
      rw [hLHS, ht_u]
      let shAdj₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
      let Pℤ₂ := (CategoryTheory.Functor.const (Opposite S₂.Etale)).obj Aℤ
      let ηℤ := shAdj₂.unit.app Pℤ₂
      have hnat_fc :
          (𝒬.obj.map φ₁.op).hom ((f_c.hom.app (Opposite.op U_u)).hom
              ((ηℤ.app (Opposite.op U_u)).hom (ULift.up (1 : ℤ)))) =
            (f_c.hom.app (Opposite.op (M_u.obj T₁))).hom
              (((C₂.obj Aℤ).obj.map φ₁.op).hom
                ((ηℤ.app (Opposite.op U_u)).hom (ULift.up (1 : ℤ)))) :=
        (congrArg (fun m => m.hom ((ηℤ.app (Opposite.op U_u)).hom (ULift.up (1 : ℤ))))
          (f_c.hom.naturality φ₁.op)).symm
      rw [hnat_fc]
      congr 1
      have hnat_η₁ :
          ((C₂.obj Aℤ).obj.map φ₁.op).hom ((ηℤ.app (Opposite.op U_u)).hom (ULift.up (1 : ℤ))) =
            (ηℤ.app (Opposite.op (M_u.obj T₁))).hom (ULift.up (1 : ℤ)) :=
        (congrArg (fun m => m.hom (ULift.up (1 : ℤ))) (ηℤ.naturality φ₁.op)).symm
      have hadj₂_unit : adj₂.unit.app Aℤ = ηℤ.app (Opposite.op T₂) := by
        change ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT₂).comp shAdj₂).unit.app Aℤ = _
        rw [CategoryTheory.Adjunction.comp_unit_app,
          CategoryTheory.constantPresheafAdj_unit_app AddCommGrpCat.{u} hT₂ Aℤ,
          CategoryTheory.Category.id_comp]
        rfl
      have hnat_η₂ :
          ((C₂.obj Aℤ).obj.map σ.op).hom ((ηℤ.app (Opposite.op T₂)).hom (ULift.up (1 : ℤ))) =
            (ηℤ.app (Opposite.op (M_u.obj T₁))).hom (ULift.up (1 : ℤ)) :=
        (congrArg (fun m => m.hom (ULift.up (1 : ℤ))) (ηℤ.naturality σ.op)).symm
      exact hnat_η₁.trans
        (hnat_η₂.symm.trans
          (congrArg
            (fun m : Aℤ ⟶ (C₂.obj Aℤ).obj.obj (Opposite.op T₂) =>
              ((C₂.obj Aℤ).obj.map σ.op).hom (m.hom (ULift.up (1 : ℤ))))
            hadj₂_unit.symm))
    calc
      g_ℐ ≫ P_u.map π
        = g_M ≫ (α_MB.inv.app ℐ ≫ P_u.map π) := CategoryTheory.Category.assoc _ _ _
      _ = (g_M ≫ M_pull.map π) ≫ α_MB.inv.app 𝒬 := by
            rw [← α_MB.inv.naturality π, ← CategoryTheory.Category.assoc]
      _ = (ι_M ≫ M_pull.map f_c) ≫ α_MB.inv.app 𝒬 := by rw [hM_eq]
      _ = ιℤ ≫ α_MB.hom.app (C₂.obj Aℤ) ≫ (M_pull.map f_c ≫ α_MB.inv.app 𝒬) := by
            rw [← hιℤ_α]
            simp only [CategoryTheory.Category.assoc]
      _ = ιℤ ≫ (α_MB.hom.app (C₂.obj Aℤ) ≫ α_MB.inv.app (C₂.obj Aℤ)) ≫ P_u.map f_c := by
            rw [α_MB.inv.naturality f_c, ← CategoryTheory.Category.assoc (α_MB.hom.app _)]
      _ = ιℤ ≫ P_u.map f_c := by
            rw [α_MB.hom_inv_id_app, CategoryTheory.Category.id_comp]

  
  let S_F := AlgebraicGeometry.Spec (CommRingCat.of F)
  let J_F := S_F.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let C_F := CategoryTheory.constantSheaf J_F AddCommGrpCat.{u}
  induction r generalizing 𝒢 with
  | zero =>
    let ℐ := CategoryTheory.Injective.under 𝒢
    let ι : 𝒢 ⟶ ℐ := CategoryTheory.Injective.ι 𝒢
    let 𝒬 := CategoryTheory.Limits.cokernel ι
    let π : ℐ ⟶ 𝒬 := CategoryTheory.Limits.cokernel.π ι
    let sc := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
    have hSES : sc.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel ι) inferInstance inferInstance
    have hw_ι : w.comp (CategoryTheory.Abelian.Ext.mk₀ sc.f) (Nat.add_zero 1) = 0 :=
      CategoryTheory.Abelian.Ext.eq_zero_of_injective _
    obtain ⟨c, hc⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (C_F.obj Aℤ) hSES w hw_ι rfl
    let f_c : C_F.obj Aℤ ⟶ 𝒬 := CategoryTheory.Abelian.Ext.homEquiv₀ c
    have hfc_eq : (CategoryTheory.Abelian.Ext.mk₀ f_c).comp hSES.extClass (Nat.zero_add 1) = w := by
      rw [CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply]
      exact hc
    let T_F₀ : S_F.Etale := weilCupPDTraceTerminalObj S_F
    let shAdj_F := CategoryTheory.sheafificationAdjunction J_F AddCommGrpCat.{u}
    let Pℤ_F := (CategoryTheory.Functor.const (Opposite S_F.Etale)).obj Aℤ
    let ηℤ_F := shAdj_F.unit.app Pℤ_F
    let s₀ : ↥(𝒬.obj.obj (Opposite.op T_F₀)) :=
      (f_c.hom.app (Opposite.op T_F₀)).hom
        ((ηℤ_F.app (Opposite.op T_F₀)).hom (ULift.up (1 : ℤ)))
    obtain ⟨N, hFieldN, hAlgN, hFinN, hGalN, hu, t_N, ht_N⟩ := hEpiLift ℐ 𝒬 π s₀
    let _ : Field N := hFieldN
    let _ : Algebra F N := hAlgN
    have : FiniteDimensional F N := hFinN
    have : IsGalois F N := hGalN
    let u := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F N))
    let U_u : S_F.Etale := weilGysinEtaleObj u hu
    let ρ_u : U_u ⟶ T_F₀ :=
      CategoryTheory.MorphismProperty.Over.homMk u (CategoryTheory.Category.comp_id u)
    have ht_u :
        (π.hom.app (Opposite.op U_u)).hom t_N =
          (f_c.hom.app (Opposite.op U_u)).hom
            ((ηℤ_F.app (Opposite.op U_u)).hom (ULift.up (1 : ℤ))) := by
      rw [ht_N ρ_u]
      have h1 := (congrArg
        (fun m => m.hom ((ηℤ_F.app (Opposite.op T_F₀)).hom (ULift.up (1 : ℤ))))
        (f_c.hom.naturality ρ_u.op)).symm
      have h2 := (congrArg (fun m => m.hom (ULift.up (1 : ℤ)))
        (ηℤ_F.naturality ρ_u.op)).symm
      exact h1.trans (congrArg (f_c.hom.app (Opposite.op U_u)).hom h2)
    refine ⟨N, hFieldN, hAlgN, hFinN, hGalN, ?_⟩
    dsimp only
    intro _hCont _hAdj p_u hp_u
    rw [← hfc_eq]
    exact (hSyzygy u hSES).2 f_c p_u hp_u
      (fun T₁ hT₁ T₂ hT₂ ιℤ hπι =>
        hEtaleFactor u hu T₁ hT₁ T₂ hT₂ ℐ 𝒬 π f_c t_N ht_u ιℤ hπι)
  | succ r' ih =>
    let ℐ := CategoryTheory.Injective.under 𝒢
    let ι : 𝒢 ⟶ ℐ := CategoryTheory.Injective.ι 𝒢
    let 𝒬 := CategoryTheory.Limits.cokernel ι
    let π : ℐ ⟶ 𝒬 := CategoryTheory.Limits.cokernel.π ι
    let sc := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
    have hSES : sc.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel ι) inferInstance inferInstance
    have hw_ι : w.comp (CategoryTheory.Abelian.Ext.mk₀ sc.f) (Nat.add_zero (r' + 2)) = 0 :=
      CategoryTheory.Abelian.Ext.eq_zero_of_injective _
    obtain ⟨c, hc⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (C_F.obj Aℤ) hSES w hw_ι rfl
    obtain ⟨N, hFieldN, hAlgN, hFinN, hGalN, hKill_c⟩ := ih 𝒬 c
    let _ : Field N := hFieldN
    let _ : Algebra F N := hAlgN
    have : FiniteDimensional F N := hFinN
    refine ⟨N, hFieldN, hAlgN, hFinN, hGalN, ?_⟩
    dsimp only
    intro _hCont _hAdj p_u hp_u
    rw [← hc]
    exact (hSyzygy _ hSES).1 r' c p_u hp_u (fun p₃ hp₃ => hKill_c p₃ hp₃)

theorem weil_alt_cd_subfield_galois_adjoinRoot_descent (L : Type u) [Field L] (𝒟 : Set (Subfield L))
    (hNe : 𝒟.Nonempty) (hDir : DirectedOn (· ≤ ·) 𝒟) (hExh : ∀ x : L, ∃ E ∈ 𝒟, x ∈ E)
    (E₀ : Subfield L) (hE₀ : E₀ ∈ 𝒟)
    (N : Type u) [Field N] [Algebra L N] [FiniteDimensional L N] [IsGalois L N] :
    ∃ (E' : Subfield L) (_ : E' ∈ 𝒟) (hle : E₀ ≤ E')
      (d : ℕ) (_ : 1 ≤ d)
      (g' : Polynomial ↥E')
      (_ : g'.Monic) (_ : g'.natDegree = d)
      (hIrr' : Fact (Irreducible g')) (_ : g'.Separable)
      (hIrr : Fact (Irreducible (g'.map E'.subtype)))
      (_ : AdjoinRoot (g'.map E'.subtype) ≃ₐ[L] N)
      (φ_K : AdjoinRoot g' →+* AdjoinRoot (g'.map E'.subtype))
      (r' : Fin d → AdjoinRoot g'),
      φ_K.comp (algebraMap ↥E' (AdjoinRoot g')) =
        (algebraMap L (AdjoinRoot (g'.map E'.subtype))).comp E'.subtype ∧
      φ_K (AdjoinRoot.root g') = AdjoinRoot.root (g'.map E'.subtype) ∧
      _root_.Pairwise (fun i j : Fin d => r' i ≠ r' j) ∧
      g'.map (algebraMap ↥E' (AdjoinRoot g')) =
        ∏ i : Fin d, (Polynomial.X - Polynomial.C (r' i)) :=
by
  letI : DecidableEq L := Classical.decEq L
  letI : DecidableEq N := Classical.decEq N
  
  obtain ⟨α, hα⟩ := Field.exists_primitive_element L N
  have hInt : IsIntegral L α := Algebra.IsIntegral.isIntegral α
  let g₀ : Polynomial L := minpoly L α
  let d : ℕ := g₀.natDegree
  have hd : 1 ≤ d := minpoly.natDegree_pos hInt
  have hg₀_monic : g₀.Monic := minpoly.monic hInt
  have hg₀_irr : Irreducible g₀ := minpoly.irreducible hInt
  have hg₀_sep : g₀.Separable := Algebra.IsSeparable.isSeparable L α
  
  have hAeval_surj : ∀ y : N, ∃ Q : Polynomial L, Polynomial.aeval α Q = y := by
    letI : Fact (Irreducible g₀) := ⟨hg₀_irr⟩
    have h_eval₀ : Polynomial.eval₂ (algebraMap L N) α g₀ = 0 := by
      rw [← Polynomial.aeval_def]
      exact minpoly.aeval L α
    let f₀ : AdjoinRoot g₀ →ₐ[L] N :=
      { AdjoinRoot.lift (algebraMap L N) α h_eval₀ with
        commutes' := fun x => by
          change AdjoinRoot.lift (algebraMap L N) α h_eval₀ (algebraMap L (AdjoinRoot g₀) x) = _
          rw [AdjoinRoot.algebraMap_eq, AdjoinRoot.lift_of] }
    have hα_mem : α ∈ f₀.fieldRange :=
      ⟨AdjoinRoot.root g₀, AdjoinRoot.lift_root h_eval₀⟩
    have htop_le : (⊤ : IntermediateField L N) ≤ f₀.fieldRange := by
      rw [← hα, IntermediateField.adjoin_simple_le_iff]
      exact hα_mem
    intro y
    obtain ⟨z, hz⟩ := htop_le (IntermediateField.mem_top : y ∈ (⊤ : IntermediateField L N))
    obtain ⟨Q, rfl⟩ := AdjoinRoot.mk_surjective z
    refine ⟨Q, ?_⟩
    rw [Polynomial.aeval_def]
    exact (AdjoinRoot.lift_mk h_eval₀ Q).symm.trans hz
  
  let g_N : Polynomial N := g₀.map (algebraMap L N)
  have hg_N_monic : g_N.Monic := hg₀_monic.map (algebraMap L N)
  have hg_N_deg : g_N.natDegree = d := hg₀_monic.natDegree_map (algebraMap L N)
  have hg_N_splits : g_N.Splits := IsGalois.splits L α
  have hg_N_sep : g_N.Separable := (Polynomial.separable_map (algebraMap L N)).mpr hg₀_sep
  have hg_N_nodup : g_N.roots.Nodup := Polynomial.nodup_roots hg_N_sep
  have hg_N_card : g_N.roots.card = d := hg_N_splits.natDegree_eq_card_roots.symm.trans hg_N_deg
  let S_roots : Finset N := g_N.roots.toFinset
  have hS_card : S_roots.card = d :=
    (Multiset.toFinset_card_of_nodup hg_N_nodup).trans hg_N_card
  let e_fin : Fin d ≃ ↥S_roots := (Finset.equivFinOfCardEq hS_card).symm
  let β : Fin d → N := fun i => (e_fin i : N)
  have hβ_inj : Function.Injective β := Subtype.val_injective.comp e_fin.injective
  have hβ_dist : _root_.Pairwise (fun i j : Fin d => β i ≠ β j) :=
    fun _ _ hij => hβ_inj.ne hij
  have hg_N_prod : g_N = ∏ i : Fin d, (Polynomial.X - Polynomial.C (β i)) := by
    have h1 : (g_N.roots.map (fun a : N => Polynomial.X - Polynomial.C a)).prod = g_N :=
      Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hg_N_monic
        (hg_N_card.trans hg_N_deg.symm)
    have h2 : S_roots.val = g_N.roots := by
      dsimp [S_roots]
      exact Multiset.dedup_eq_self.mpr hg_N_nodup
    calc
      g_N = (g_N.roots.map (fun a : N => Polynomial.X - Polynomial.C a)).prod := h1.symm
      _ = (S_roots.val.map (fun a : N => Polynomial.X - Polynomial.C a)).prod := by rw [h2]
      _ = ∏ x ∈ S_roots, (Polynomial.X - Polynomial.C x) := rfl
      _ = ∏ x : ↥S_roots, (Polynomial.X - Polynomial.C (x : N)) :=
        (Finset.prod_coe_sort S_roots (fun a : N => Polynomial.X - Polynomial.C a)).symm
      _ = ∏ i : Fin d, (Polynomial.X - Polynomial.C (β i)) :=
        (Equiv.prod_comp e_fin (fun x : ↥S_roots => Polynomial.X - Polynomial.C (x : N))).symm
  let P : Fin d → Polynomial L := fun i => Classical.choose (hAeval_surj (β i))
  have hP : ∀ i : Fin d, Polynomial.aeval α (P i) = β i :=
    fun i => Classical.choose_spec (hAeval_surj (β i))
  
  let S_all : Finset L := g₀.coeffs ∪ Finset.univ.biUnion (fun i : Fin d => (P i).coeffs)
  have hFin_desc : ∀ T : Finset L, ∃ E' ∈ 𝒟, E₀ ≤ E' ∧ (T : Set L) ⊆ (E' : Set L) := by
    intro T
    induction T using Finset.induction_on with
    | empty =>
      exact ⟨E₀, hE₀, le_refl E₀, by simp⟩
    | @insert x T' _ ih =>
      obtain ⟨E₁, hE₁, hle₁, hsub₁⟩ := ih
      obtain ⟨Ex, hEx, hx⟩ := hExh x
      obtain ⟨E₂, hE₂, h₁₂, hx₂⟩ := hDir E₁ hE₁ Ex hEx
      refine ⟨E₂, hE₂, le_trans hle₁ h₁₂, ?_⟩
      intro y hy
      rw [Finset.mem_coe, Finset.mem_insert] at hy
      rcases hy with rfl | hy'
      · exact hx₂ hx
      · exact h₁₂ (hsub₁ (Finset.mem_coe.mpr hy'))
  obtain ⟨E', hE', hle, hS_sub⟩ := hFin_desc S_all
  
  have hRange : Set.range ⇑E'.subtype = (E' : Set L) := by
    rw [Subfield.coe_subtype, Subtype.range_coe_subtype]
    rfl
  have hg₀_lift : g₀ ∈ Polynomial.lifts E'.subtype := by
    rw [Polynomial.lifts_iff_coeffs_subset_range, hRange]
    exact Set.Subset.trans (Finset.coe_subset.mpr Finset.subset_union_left) hS_sub
  obtain ⟨g', hg'_map⟩ := (Polynomial.mem_lifts g₀).mp hg₀_lift
  have hP_lift : ∀ i : Fin d, P i ∈ Polynomial.lifts E'.subtype := by
    intro i
    rw [Polynomial.lifts_iff_coeffs_subset_range, hRange]
    refine Set.Subset.trans ?_ hS_sub
    intro c hc
    rw [Finset.mem_coe] at hc ⊢
    exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, hc⟩)
  have hex_P' : ∀ i : Fin d, ∃ q : Polynomial ↥E', q.map E'.subtype = P i :=
    fun i => (Polynomial.mem_lifts (P i)).mp (hP_lift i)
  let P' : Fin d → Polynomial ↥E' := fun i => Classical.choose (hex_P' i)
  have hP'_map : ∀ i : Fin d, (P' i).map E'.subtype = P i :=
    fun i => Classical.choose_spec (hex_P' i)
  have hg'_monic : g'.Monic := by
    apply (E'.subtype.injective.monic_map_iff).mpr
    rw [hg'_map]
    exact hg₀_monic
  have hg'_deg : g'.natDegree = d := by
    have hdeg := hg'_monic.natDegree_map E'.subtype
    rw [hg'_map] at hdeg
    exact hdeg.symm
  have hg'_sep : g'.Separable := by
    apply (Polynomial.separable_map E'.subtype).mp
    rw [hg'_map]
    exact hg₀_sep
  have hIrr_map : Irreducible (g'.map E'.subtype) := by
    rw [hg'_map]
    exact hg₀_irr
  have hg'_irr : Irreducible g' :=
    Polynomial.Monic.irreducible_of_irreducible_map E'.subtype g' hg'_monic hIrr_map
  let hIrr' : Fact (Irreducible g') := ⟨hg'_irr⟩
  let hIrr : Fact (Irreducible (g'.map E'.subtype)) := ⟨hIrr_map⟩
  
  let g₁ : Polynomial L := g'.map E'.subtype
  have h_eval_g₁ : Polynomial.eval₂ (algebraMap L N) α g₁ = 0 := by
    change Polynomial.eval₂ (algebraMap L N) α (g'.map E'.subtype) = 0
    rw [hg'_map, ← Polynomial.aeval_def]
    exact minpoly.aeval L α
  let f_N_ring : AdjoinRoot g₁ →+* N := AdjoinRoot.lift (algebraMap L N) α h_eval_g₁
  let f_N : AdjoinRoot g₁ →ₐ[L] N :=
    { f_N_ring with
      commutes' := fun x => by
        change f_N_ring (algebraMap L (AdjoinRoot g₁) x) = algebraMap L N x
        rw [AdjoinRoot.algebraMap_eq, AdjoinRoot.lift_of] }
  have hf_N_inj : Function.Injective f_N := by
    letI : Fact (Irreducible g₁) := hIrr
    exact fun _ _ h => f_N_ring.injective h
  have hf_N_surj : Function.Surjective f_N := by
    intro y
    obtain ⟨Q, hQ⟩ := hAeval_surj y
    refine ⟨AdjoinRoot.mk g₁ Q, ?_⟩
    change f_N_ring (AdjoinRoot.mk g₁ Q) = y
    rw [AdjoinRoot.lift_mk h_eval_g₁ Q, ← Polynomial.aeval_def, hQ]
  let e_N : AdjoinRoot g₁ ≃ₐ[L] N :=
    AlgEquiv.ofBijective f_N ⟨hf_N_inj, hf_N_surj⟩
  have he_N_apply : ∀ z : AdjoinRoot g₁, e_N z = f_N_ring z :=
    fun z => congrFun (AlgEquiv.coe_ofBijective f_N ⟨hf_N_inj, hf_N_surj⟩) z
  let j : ↥E' →+* AdjoinRoot g₁ := (algebraMap L (AdjoinRoot g₁)).comp E'.subtype
  have h_eval_g' : Polynomial.eval₂ j (AdjoinRoot.root g₁) g' = 0 := by
    refine (Polynomial.eval₂_map E'.subtype (algebraMap L (AdjoinRoot g₁))
      (AdjoinRoot.root g₁)).symm.trans ?_
    rw [AdjoinRoot.algebraMap_eq]
    exact AdjoinRoot.eval₂_root g₁
  let φ_K : AdjoinRoot g' →+* AdjoinRoot g₁ :=
    AdjoinRoot.lift j (AdjoinRoot.root g₁) h_eval_g'
  have hφ_comp : φ_K.comp (algebraMap ↥E' (AdjoinRoot g')) =
      (algebraMap L (AdjoinRoot (g'.map E'.subtype))).comp E'.subtype := by
    ext x
    rw [RingHom.comp_apply, AdjoinRoot.algebraMap_eq, AdjoinRoot.lift_of]
  have hφ_root : φ_K (AdjoinRoot.root g') = AdjoinRoot.root (g'.map E'.subtype) :=
    AdjoinRoot.lift_root h_eval_g'
  let r' : Fin d → AdjoinRoot g' := fun i => AdjoinRoot.mk g' (P' i)
  let ψ : AdjoinRoot g' →+* N := e_N.toRingHom.comp φ_K
  have hψ_inj : Function.Injective ψ := by
    letI : Fact (Irreducible g') := hIrr'
    exact ψ.injective
  have he_N_comp_j : e_N.toRingHom.comp j = (algebraMap L N).comp E'.subtype := by
    ext x
    exact e_N.commutes (E'.subtype x)
  have hψ_comp : ψ.comp (algebraMap ↥E' (AdjoinRoot g')) = (algebraMap L N).comp E'.subtype := by
    rw [RingHom.comp_assoc, hφ_comp, he_N_comp_j]
  have he_N_root : e_N (AdjoinRoot.root g₁) = α :=
    (he_N_apply _).trans (AdjoinRoot.lift_root h_eval_g₁)
  have hψ_r' : ∀ i : Fin d, ψ (r' i) = β i := by
    intro i
    have h1 : φ_K (r' i) =
        Polynomial.eval₂ (algebraMap L (AdjoinRoot g₁)) (AdjoinRoot.root g₁) (P i) := by
      change AdjoinRoot.lift j (AdjoinRoot.root g₁) h_eval_g' (AdjoinRoot.mk g' (P' i)) = _
      rw [AdjoinRoot.lift_mk h_eval_g' (P' i)]
      refine (Polynomial.eval₂_map E'.subtype (algebraMap L (AdjoinRoot g₁))
        (AdjoinRoot.root g₁)).symm.trans ?_
      rw [hP'_map i]
    change e_N.toAlgHom (φ_K (r' i)) = β i
    rw [h1, Polynomial.algHom_eval₂_algebraMap (P i) e_N.toAlgHom (AdjoinRoot.root g₁)]
    change Polynomial.eval₂ (algebraMap L N) (e_N (AdjoinRoot.root g₁)) (P i) = β i
    rw [he_N_root, ← Polynomial.aeval_def, hP i]
  have hr'_dist : _root_.Pairwise (fun i j : Fin d => r' i ≠ r' j) := by
    intro i₁ i₂ hine heq
    apply hβ_dist hine
    rw [← hψ_r' i₁, ← hψ_r' i₂, heq]
  have hr'_split : g'.map (algebraMap ↥E' (AdjoinRoot g')) =
      ∏ i : Fin d, (Polynomial.X - Polynomial.C (r' i)) := by
    apply Polynomial.map_injective ψ hψ_inj
    have hLHS : (g'.map (algebraMap ↥E' (AdjoinRoot g'))).map ψ = g_N := by
      rw [Polynomial.map_map, hψ_comp, ← Polynomial.map_map E'.subtype (algebraMap L N) g', hg'_map]
    have hRHS : (∏ i : Fin d, (Polynomial.X - Polynomial.C (r' i))).map ψ =
        ∏ i : Fin d, (Polynomial.X - Polynomial.C (β i)) := by
      rw [Polynomial.map_prod]
      refine Finset.prod_congr rfl fun i _ => ?_
      rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, hψ_r' i]
    rw [hLHS, hRHS]
    exact hg_N_prod
  exact ⟨E', hE', hle, d, hd, g', hg'_monic, hg'_deg, hIrr', hg'_sep, hIrr,
    e_N, φ_K, r', hφ_comp, hφ_root, hr'_dist, hr'_split⟩

