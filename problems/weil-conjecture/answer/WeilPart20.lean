theorem weil_etale_projective_integral_sylow_devissage_to_constant (hDimZero : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      [AlgebraicGeometry.LocallyOfFiniteType Z.hom]
      [AlgebraicGeometry.QuasiCompact Z.hom],
      topologicalKrullDim Z.left ≤ (0 : WithBot ℕ∞) →
      ∀ (𝒢 : CategoryTheory.Sheaf Z.left.smallEtaleTopology AddCommGrpCat.{u})
        (r : ℕ), 1 ≤ r → Subsingleton (𝒢.H r))
    (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (hFinIntClosure : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k₀ A] [Algebra.FiniteType k₀ A]
      (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K],
      Module.Finite A ↥(integralClosure A K) ∧ IsIntegrallyClosed ↥(integralClosure A K))
    (hFinProjDim : ∀ {Y Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀))}
      (g : Y ⟶ Z),
      AlgebraicGeometry.IsIntegral Y.left →
      AlgebraicGeometry.IsIntegral Z.left →
      IsProjectiveOverField k₀ Z →
      AlgebraicGeometry.IsFinite g.left →
      AlgebraicGeometry.Surjective g.left →
      IsProjectiveOverField k₀ Y ∧ topologicalKrullDim Y.left = topologicalKrullDim Z.left)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC₀ : WeilProperModPrimeBaseChangeHolds k₀ ℓ)
    (m' q : ℕ) (hq : 2 * (m' + 1) < q)
    (hSubDim : ∀ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
      [AlgebraicGeometry.IsProper W.hom],
      topologicalKrullDim W.left ≤ (m' : WithBot ℕ∞) →
      ∀ (r : ℕ), 2 * m' < r →
      ∀ (𝒜 : CategoryTheory.Sheaf W.left.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id 𝒜 = 0 → Subsingleton (𝒜.H r))
    (hConstProj : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀))),
      AlgebraicGeometry.IsIntegral Y.left →
      IsProjectiveOverField k₀ Y →
      topologicalKrullDim Y.left = ((m' + 1 : ℕ) : WithBot ℕ∞) →
      Subsingleton (weilEtaleTorsionH Y.left ℓ q))
    (V₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
    [AlgebraicGeometry.IsProper V₀.hom]
    (hIntV₀ : AlgebraicGeometry.IsIntegral V₀.left)
    (hProjV₀ : IsProjectiveOverField k₀ V₀)
    (hDimV₀ : topologicalKrullDim V₀.left = ((m' + 1 : ℕ) : WithBot ℕ∞))
    (ℱ₀ : CategoryTheory.Sheaf V₀.left.smallEtaleTopology AddCommGrpCat.{u})
    (hℱ₀ : WeilIsConstructibleModPrimeSheaf ℓ V₀.left ℱ₀) :
    Subsingleton (ℱ₀.H q) :=
by
  classical
  let _ := @hFinIntClosure
  obtain ⟨hPullEx, hPullIso, hPullComp, hPullConst, -, hPullExact⟩ :=
    weil_etale_pullback_exact_and_pseudofunctor.{u} ℓ
  obtain ⟨hEmptyZero, hTorConst, hTorPush, -, -, -, -⟩ :=
    weil_etale_degree_zero_pushforward_exact_and_comp.{u} ℓ
  obtain ⟨hCont, hPfProps, -⟩ := weil_etale_pushforward_continuous_comp_and_injective.{u}

  
  
  
  have hGeomPkg :
      let Y₀ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal
        (⊤ : TopologicalSpace.Closeds ↥V₀.left)).subscheme
      let iY₀ := (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal
        (⊤ : TopologicalSpace.Closeds ↥V₀.left)).subschemeι
      CategoryTheory.IsIso iY₀ ∧
      AlgebraicGeometry.IsIntegral Y₀ ∧
      (∀ (U₂ : Y₀.Opens), Nonempty U₂ →
        ∃ (C_bad : TopologicalSpace.Closeds ↥V₀.left),
          (C_bad : Set ↥V₀.left) = ⇑iY₀.base '' ((U₂ : Set ↥Y₀)ᶜ) ∧
          (C_bad : Set ↥V₀.left) ≠ Set.univ ∧
          AlgebraicGeometry.IsProper
            ((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_bad).subschemeι ≫ V₀.hom) ∧
          topologicalKrullDim
            (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_bad).subscheme ≤
              (m' : WithBot ℕ∞)) ∧
      (∀ (U₂ : Y₀.Opens), Nonempty U₂ →
        ∀ (Y' : AlgebraicGeometry.Scheme.{u}), AlgebraicGeometry.IsIntegral Y' →
        ∀ (ν : Y' ⟶ Y₀), AlgebraicGeometry.IsFinite ν →
        AlgebraicGeometry.Surjective (ν ∣_ U₂) →
        let Y := CategoryTheory.Over.mk ((ν ≫ iY₀) ≫ V₀.hom)
        AlgebraicGeometry.IsProper Y.hom ∧
        IsProjectiveOverField k₀ Y ∧
        topologicalKrullDim Y' = ((m' + 1 : ℕ) : WithBot ℕ∞)) ∧
      (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
        [AlgebraicGeometry.IsProper Y.hom],
        AlgebraicGeometry.IsIntegral Y.left →
        topologicalKrullDim Y.left = ((m' + 1 : ℕ) : WithBot ℕ∞) →
        ∀ (W' : AlgebraicGeometry.Scheme.{u}) (iW' : W' ⟶ Y.left),
        AlgebraicGeometry.IsClosedImmersion iW' →
        ¬ CategoryTheory.IsIso iW' →
        AlgebraicGeometry.IsProper (iW' ≫ Y.hom) ∧
        topologicalKrullDim W' ≤ (m' : WithBot ℕ∞)) := by
    have hKrullDrop : ∀ (T : Type u) [TopologicalSpace T] [IrreducibleSpace T],
        topologicalKrullDim T = ((m' + 1 : ℕ) : WithBot ℕ∞) →
        ∀ (S : Type u) [TopologicalSpace S] (e : S → T),
        Topology.IsClosedEmbedding e →
        Set.range e ≠ Set.univ →
        topologicalKrullDim S ≤ (m' : WithBot ℕ∞) := by
      intro T _ _ hDimT S _ e he hne
      suffices hlt : Order.krullDim (TopologicalSpace.IrreducibleCloseds S) <
          ((m' + 1 : ℕ) : WithBot ℕ∞) by
        change Order.krullDim (TopologicalSpace.IrreducibleCloseds S) ≤ (m' : WithBot ℕ∞)
        rcases h_eq : Order.krullDim (TopologicalSpace.IrreducibleCloseds S) with _ | d_enat
        · exact bot_le
        · rw [h_eq] at hlt
          rcases d_enat with _ | k_nat
          · exfalso
            exact not_top_lt (WithBot.coe_lt_coe.mp hlt)
          · have hk : (k_nat : ℕ∞) < ((m' + 1 : ℕ) : ℕ∞) := WithBot.coe_lt_coe.mp hlt
            have hk' : k_nat < m' + 1 := ENat.natCast_lt_natCast.mp hk
            exact WithBot.coe_le_coe.mpr (ENat.natCast_le_natCast.mpr (Nat.lt_succ_iff.mp hk'))
      rw [Order.krullDim_lt_coe_iff]
      intro l
      let Φ : TopologicalSpace.IrreducibleCloseds S → TopologicalSpace.IrreducibleCloseds T :=
        fun K => ⟨e '' K.carrier, K.isIrreducible'.image e he.continuous.continuousOn,
          he.isClosedMap _ K.isClosed'⟩
      have hStrict : StrictMono Φ := by
        intro K₁ K₂ hK
        rw [lt_iff_le_not_ge] at hK ⊢
        refine ⟨Set.image_mono hK.1, fun hge => hK.2 (fun x hx => ?_)⟩
        obtain ⟨y, hy, hyx⟩ := hge ⟨x, hx, rfl⟩
        exact he.injective hyx ▸ hy
      let l' : LTSeries (TopologicalSpace.IrreducibleCloseds T) := l.map Φ hStrict
      let U_top : TopologicalSpace.IrreducibleCloseds T :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ T, isClosed_univ⟩
      have hlast_lt : l'.last < U_top := by
        rw [lt_iff_le_not_ge]
        refine ⟨Set.subset_univ _, fun hge => hne (Set.eq_univ_of_forall fun t => ?_)⟩
        have ht : t ∈ (l'.last : Set T) := hge (Set.mem_univ t)
        have hlast_eq : l'.last = Φ l.last := rfl
        rw [hlast_eq] at ht
