            CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
            CategoryTheory.Category.comp_id]
        · change (c_lift ≫ (Fgt_X.map σ'_e).left) ≫ (Fgt_X.obj (B_π.obj U'_Y)).hom =
            O'.ι ≫ (Fgt_X.obj (B_π.obj U'_Y)).hom
          have hf'_snd : (Fgt_X.map σ'_e).left ≫ (Fgt_X.obj (B_π.obj U'_Y)).hom =
