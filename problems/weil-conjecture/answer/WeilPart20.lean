        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc map_K_NL.left
              (wPullSec E₀.subtype ψ₀ hψ₀).left _).trans
            ((congrArg (map_K_NL.left ≫ ·) hw₁_fst).trans
