        intro s j
        apply (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map_injective
        ext U_op y
        let U := U_op.unop
        have h := hDescSpec s U U (𝟙 U) (((c.ι.app j).hom.app (Opposite.op U)).hom y) j y (by simp)
