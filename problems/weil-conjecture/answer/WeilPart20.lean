      simpa using ht_i
    let t : ∀ i : I, ℰ₁.val.obj (Opposite.op (E i)) := fun i => Classical.choose (hLiftLoc i)
    have ht : ∀ i : I, ψ.hom.app (Opposite.op (E i)) (t i) = ℰ₂.val.map (π i).op s :=
      fun i => Classical.choose_spec (hLiftLoc i)
    let P₁ := ((sheafForget J).obj ℰ₁).val
    let P₂ := ((sheafForget J).obj ℰ₂).val
    have hCompat : Presieve.Arrows.Compatible P₁ π t := by
      intro i j Z_et g₁ g₂ heq
      by_cases hij : i = j
      · subst hij
        have hleft : g₁.left ≫ (O_u i).ι = g₂.left ≫ (O_u i).ι :=
          congrArg (fun u : Z_et ⟶ T_S => u.left) heq
        have hg_eq : g₁ = g₂ :=
          MorphismProperty.Over.Hom.ext ((cancel_mono (O_u i).ι).mp hleft)
        rw [hg_eq]
      · have hij_down : i.down ≠ j.down := fun h => hij (ULift.ext _ _ h)
        have hEmp : IsEmpty ↥Z_et.left := ⟨fun z => by
          have hmem_i : (g₁ ≫ π i).left.base z ∈ O_u i := (g₁.left.base z).2
          have hmem_j : (g₂ ≫ π j).left.base z ∈ O_u j := (g₂.left.base z).2
          rw [heq] at hmem_i
          exact (disjoint_iff_inf_le.mp (hDisj i.down j.down hij_down) ⟨hmem_i, hmem_j⟩ : False)⟩
        exact @Subsingleton.elim _ (hEmptySub Z_et hEmp ℰ₁) _ _
    have hSheaf₁ : Presieve.IsSheafFor P₁ (Presieve.ofArrows E π) :=
      (Presieve.isSheafFor_iff_generate (Presieve.ofArrows E π)).mpr
        (((sheafForget J).obj ℰ₁).cond.isSheafFor (Sieve.ofArrows E π) hCovSieve)
    obtain ⟨t_glob_raw, ht_glob, -⟩ := (Presieve.isSheafFor_arrows_iff P₁ π).mp hSheaf₁ t hCompat
    let t_glob : ↑(ℰ₁.val.obj (Opposite.op T_S)) := t_glob_raw
    have hSheaf₂ : Presieve.IsSheafFor P₂ (Presieve.ofArrows E π) :=
      (Presieve.isSheafFor_iff_generate (Presieve.ofArrows E π)).mpr
        (((sheafForget J).obj ℰ₂).cond.isSheafFor (Sieve.ofArrows E π) hCovSieve)
    have hCompat_s : Presieve.Arrows.Compatible P₂ π (fun i => ℰ₂.val.map (π i).op s) := by
      intro i j Z_et g₁ g₂ heq
      change (ℰ₂.val.map (π i).op ≫ ℰ₂.val.map g₁.op) s =
        (ℰ₂.val.map (π j).op ≫ ℰ₂.val.map g₂.op) s
      rw [← ℰ₂.val.map_comp, ← ℰ₂.val.map_comp, ← op_comp, ← op_comp, heq]
    obtain ⟨_, _, hUniq₂⟩ :=
      (Presieve.isSheafFor_arrows_iff P₂ π).mp hSheaf₂ (fun i => ℰ₂.val.map (π i).op s) hCompat_s
    have hψ_glob : ψ.hom.app (Opposite.op T_S) t_glob = s := by
      have h1 : ∀ i : I,
          (ConcreteCategory.hom (P₂.map (π i).op)) (ψ.hom.app (Opposite.op T_S) t_glob) =
            ℰ₂.val.map (π i).op s := by
        intro i
        have hnat : (ℰ₁.val.map (π i).op ≫ ψ.hom.app (Opposite.op (E i))) t_glob =
            (ψ.hom.app (Opposite.op T_S) ≫ ℰ₂.val.map (π i).op) t_glob := by
          rw [ψ.hom.naturality]
        calc
          ℰ₂.val.map (π i).op (ψ.hom.app (Opposite.op T_S) t_glob)
            = (ψ.hom.app (Opposite.op T_S) ≫ ℰ₂.val.map (π i).op) t_glob := rfl
          _ = (ℰ₁.val.map (π i).op ≫ ψ.hom.app (Opposite.op (E i))) t_glob := hnat.symm
          _ = ψ.hom.app (Opposite.op (E i)) (t i) :=
            congrArg (ψ.hom.app (Opposite.op (E i))) (ht_glob i)
          _ = ℰ₂.val.map (π i).op s := ht i
      have h2 : ∀ i : I,
          (ConcreteCategory.hom (P₂.map (π i).op)) s = ℰ₂.val.map (π i).op s :=
        fun _ => rfl
      exact (hUniq₂ _ h1).trans (hUniq₂ s h2).symm
    let g_grp : Z_grp ⟶ ℰ₁.val.obj (Opposite.op T_S) :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • t_glob
          map_zero' := zero_zsmul t_glob
          map_add' := fun a b => add_zsmul t_glob a.down b.down }
    have hg_comp : g_grp ≫ ψ.hom.app (Opposite.op T_S) = f_grp := by
      ext z
      have hz : z = z.down • u₁ := by
        ext
        change z.down = z.down • (1 : ℤ)
        simp
      change ψ.hom.app (Opposite.op T_S) (z.down • t_glob) = f_grp z
      rw [map_zsmul, hψ_glob]
      conv_rhs => rw [hz]
      exact (map_zsmul f_grp.hom z.down u₁).symm
    refine ⟨(adj.homEquiv Z_grp ℰ₁).symm g_grp, ?_⟩
    have hnat_adj := Adjunction.homEquiv_naturality_right_symm adj g_grp ψ
    change (adj.homEquiv Z_grp ℰ₁).symm g_grp ≫ ψ = f_hom
    rw [← hnat_adj]
    change (adj.homEquiv Z_grp ℰ₂).symm (g_grp ≫ ψ.hom.app (Opposite.op T_S)) = f_hom
    rw [hg_comp, Equiv.symm_apply_apply]
  
  obtain ⟨n, O, hCov, hDisj, hProps⟩ := hStage1
  have hProj : CategoryTheory.Projective
      ((CategoryTheory.constantSheaf Z.left.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))) := by
    refine hStage3 Z.left n O hCov hDisj (fun i => (hProps i).1) ?_
    intro i W hNE_W f _
    letI : AlgebraicGeometry.IsAffine (O i : AlgebraicGeometry.Scheme.{u}) := (hProps i).2.1
    exact hStage2 (O i : AlgebraicGeometry.Scheme.{u}) W hNE_W f (hProps i).2.2.1 (hProps i).2.2.2
  let Fℤ := (CategoryTheory.constantSheaf Z.left.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  haveI : CategoryTheory.Projective Fℤ := hProj
  haveI : CategoryTheory.HasProjectiveDimensionLT Fℤ 1 :=
    (CategoryTheory.projective_iff_hasProjectiveDimensionLT_one).mp hProj
  exact CategoryTheory.HasProjectiveDimensionLT.subsingleton Fℤ 1 q hq 𝒢

theorem weil_krullDim_irredComponents_and_vanishingIdeal_subscheme : (∀ (T : Type u) [TopologicalSpace T],
      (∀ E ∈ irreducibleComponents T, topologicalKrullDim ↥E = (1 : WithBot ℕ∞)) →
      topologicalKrullDim T ≤ (1 : WithBot ℕ∞)) ∧
    (∀ (T : Type u) [TopologicalSpace T] [IrreducibleSpace T] (m' : ℕ),
      topologicalKrullDim T ≤ ((m' + 1 : ℕ) : WithBot ℕ∞) →
      ∀ (C : Set T), IsClosed C → C ≠ Set.univ →
        topologicalKrullDim ↥C ≤ (m' : WithBot ℕ∞)) ∧
    (∀ (k₀ : Type u) [Field k₀],
      (∀ (N : ℕ), AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k₀ N).hom) ∧
      (∀ (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
        [AlgebraicGeometry.LocallyOfFiniteType X.hom]
        [AlgebraicGeometry.QuasiCompact X.hom],
        TopologicalSpace.NoetherianSpace ↥X.left)) ∧
    (∀ (Y : AlgebraicGeometry.Scheme.{u}) (C : TopologicalSpace.Closeds ↥Y),
      let I_C := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C
      AlgebraicGeometry.IsClosedImmersion I_C.subschemeι ∧
      Set.range I_C.subschemeι.base = (C : Set ↥Y) ∧
      (IsIrreducible (C : Set ↥Y) → AlgebraicGeometry.IsIntegral I_C.subscheme)) :=
by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro T _ hComp
    change Order.krullDim (TopologicalSpace.IrreducibleCloseds T) ≤ (1 : WithBot ℕ∞)
    by_cases hne : Nonempty (TopologicalSpace.IrreducibleCloseds T)
    · rw [@Order.krullDim_eq_iSup_length _ _ hne]
      let M : ℕ∞ := ⨆ p : LTSeries (TopologicalSpace.IrreducibleCloseds T), (p.length : ℕ∞)
      change (M : WithBot ℕ∞) ≤ ((1 : ℕ∞) : WithBot ℕ∞)
      refine WithBot.coe_le_coe.mpr (iSup_le fun p => ?_)
      obtain ⟨E, hE, hlast⟩ :=
        exists_mem_irreducibleComponents_subset_of_isIrreducible (p.last : Set T) p.last.isIrreducible
      have hsub : ∀ i : Fin (p.length + 1), (p i : Set T) ⊆ E :=
        fun i => Set.Subset.trans (LTSeries.monotone p (Fin.le_last i)) hlast
      let fE : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥E := fun i =>
        ⟨(Subtype.val : ↥E → T) ⁻¹' (p i : Set T),
         ⟨by
            obtain ⟨x₀, hx₀⟩ := (p i).isIrreducible.nonempty
            exact ⟨⟨x₀, hsub i hx₀⟩, hx₀⟩,
          by
            intro u v hu hv ⟨y₁, hy₁p, hy₁u⟩ ⟨y₂, hy₂p, hy₂v⟩
            obtain ⟨U, hU, rfl⟩ := isOpen_induced_iff.mp hu
            obtain ⟨V, hV, rfl⟩ := isOpen_induced_iff.mp hv
            obtain ⟨z, hzp, hzU, hzV⟩ := (p i).isIrreducible.isPreirreducible U V hU hV
              ⟨y₁.1, hy₁p, hy₁u⟩ ⟨y₂.1, hy₂p, hy₂v⟩
            exact ⟨⟨z, hsub i hzp⟩, hzp, hzU, hzV⟩⟩,
         (p i).isClosed.preimage continuous_subtype_val⟩
      have hfE : ∀ i : Fin p.length, fE i.castSucc < fE i.succ := by
        intro i
        have hlt : p i.castSucc < p i.succ :=
          LTSeries.strictMono p (Fin.castSucc_lt_succ : i.castSucc < i.succ)
        have hle : (Subtype.val : ↥E → T) ⁻¹' (p i.castSucc : Set T) ⊆
            (Subtype.val : ↥E → T) ⁻¹' (p i.succ : Set T) :=
          Set.preimage_mono (show (p i.castSucc : Set T) ⊆ (p i.succ : Set T) from le_of_lt hlt)
        refine lt_of_le_of_ne hle (fun heq => ?_)
        have himg : Subtype.val '' (fE i.castSucc : Set ↥E) = Subtype.val '' (fE i.succ : Set ↥E) :=
          congrArg (fun c : TopologicalSpace.IrreducibleCloseds ↥E => Subtype.val '' (c : Set ↥E)) heq
        have h1 : Subtype.val '' (fE i.castSucc : Set ↥E) = (p i.castSucc : Set T) :=
          Set.image_preimage_eq_of_subset (fun x hx => ⟨⟨x, hsub i.castSucc hx⟩, rfl⟩)
        have h2 : Subtype.val '' (fE i.succ : Set ↥E) = (p i.succ : Set T) :=
          Set.image_preimage_eq_of_subset (fun x hx => ⟨⟨x, hsub i.succ hx⟩, rfl⟩)
        rw [h1, h2] at himg
        exact ne_of_lt hlt (TopologicalSpace.IrreducibleCloseds.ext himg)
      let q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥E) := RelSeries.mk p.length fE hfE
      have hlen : ((p.length : ℕ∞) : WithBot ℕ∞) ≤ ((1 : ℕ∞) : WithBot ℕ∞) := by
        have hq : (q.length : WithBot ℕ∞) ≤ topologicalKrullDim ↥E :=
          Order.LTSeries.length_le_krullDim q
        rw [hComp E hE] at hq
        exact hq
      exact WithBot.coe_le_coe.mp hlen
    · have hempty : IsEmpty (TopologicalSpace.IrreducibleCloseds T) := not_nonempty_iff.mp hne
      rw [Order.krullDim_eq_bot_iff.mpr hempty]
      exact bot_le
  · intro T _ _ m' hDimT C hC hProper
    change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥C) ≤ (m' : WithBot ℕ∞)
    by_cases hne : Nonempty (TopologicalSpace.IrreducibleCloseds ↥C)
    · rw [@Order.krullDim_eq_iSup_length _ _ hne]
      let M : ℕ∞ := ⨆ p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥C), (p.length : ℕ∞)
      change (M : WithBot ℕ∞) ≤ ((m' : ℕ∞) : WithBot ℕ∞)
      refine WithBot.coe_le_coe.mpr (iSup_le fun p => ?_)
      let fT : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds T := fun i =>
        ⟨(Subtype.val : ↥C → T) '' (p i : Set ↥C),
         (p i).isIrreducible.image Subtype.val continuous_subtype_val.continuousOn,
         hC.isClosedMap_subtype_val _ (p i).isClosed⟩
      have hfT : ∀ i : Fin p.length, fT i.castSucc < fT i.succ := by
        intro i
        have hlt : p i.castSucc < p i.succ :=
          LTSeries.strictMono p (Fin.castSucc_lt_succ : i.castSucc < i.succ)
        refine lt_of_le_of_ne
          (Set.image_mono (show (p i.castSucc : Set ↥C) ⊆ (p i.succ : Set ↥C) from le_of_lt hlt))
          (fun heq => ?_)
        have himg : (Subtype.val : ↥C → T) '' (p i.castSucc : Set ↥C) =
            (Subtype.val : ↥C → T) '' (p i.succ : Set ↥C) :=
          congrArg SetLike.coe heq
        exact ne_of_lt hlt
          (TopologicalSpace.IrreducibleCloseds.ext (Subtype.val_injective.image_injective himg))
      let q : LTSeries (TopologicalSpace.IrreducibleCloseds T) := RelSeries.mk p.length fT hfT
      let topT : TopologicalSpace.IrreducibleCloseds T :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ T, isClosed_univ⟩
      have hlt_top : q.last < topT := by
        refine lt_of_le_of_ne (show (q.last : Set T) ⊆ (topT : Set T) from Set.subset_univ _)
          (fun heq => hProper ?_)
        apply Set.univ_subset_iff.mp
        have hquniv : (q.last : Set T) = Set.univ := congrArg SetLike.coe heq
        rw [← hquniv]
        change (Subtype.val : ↥C → T) '' (p.last : Set ↥C) ⊆ C
        rintro _ ⟨y, _, rfl⟩
        exact y.2
      let q_ext : LTSeries (TopologicalSpace.IrreducibleCloseds T) := q.snoc topT hlt_top
      have hle1 : (((p.length + 1 : ℕ) : ℕ∞) : WithBot ℕ∞) ≤ (((m' + 1 : ℕ) : ℕ∞) : WithBot ℕ∞) :=
        (Order.LTSeries.length_le_krullDim q_ext).trans hDimT
      have hle2 : p.length + 1 ≤ m' + 1 :=
        ENat.natCast_le_natCast.mp (WithBot.coe_le_coe.mp hle1)
      exact ENat.natCast_le_natCast.mpr (by omega)
    · have hempty : IsEmpty (TopologicalSpace.IrreducibleCloseds ↥C) := not_nonempty_iff.mp hne
      rw [Order.krullDim_eq_bot_iff.mpr hempty]
      exact bot_le
  · intro k₀ _
    refine ⟨?_, ?_⟩
    · intro N
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k₀
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      letI : IsScalarTower k₀ ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k₀) :=
        @IsScalarTower.of_algebraMap_eq k₀ ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k₀) _ _ _ _ _ _
          (fun s => ((SetLike.GradeZero.algebraMap_apply 𝒜 (algebraMap k₀ ↥(𝒜 0) s)).trans
            (SetLike.GradeZero.coe_algebraMap 𝒜 s)).symm)
      letI : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k₀) :=
        Algebra.FiniteType.of_restrictScalars_finiteType k₀ ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k₀)
      haveI : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) := inferInstance
      have hbij : Function.Bijective (algebraMap k₀ ↥(𝒜 0)) := by
        refine ⟨?_, ?_⟩
        · intro a b hab
          have hval : ((algebraMap k₀ ↥(𝒜 0) a) : MvPolynomial (Fin (N + 1)) k₀) =
              ((algebraMap k₀ ↥(𝒜 0) b) : MvPolynomial (Fin (N + 1)) k₀) :=
            congrArg Subtype.val hab
          rw [SetLike.GradeZero.coe_algebraMap, SetLike.GradeZero.coe_algebraMap] at hval
          exact MvPolynomial.C_injective (Fin (N + 1)) k₀ hval
        · intro x
          refine ⟨x.1.coeff 0, Subtype.ext ?_⟩
          rw [SetLike.GradeZero.coe_algebraMap]
          have hhom : x.1.IsHomogeneous 0 :=
            (MvPolynomial.mem_homogeneousSubmodule 0 x.1).mp x.2
          have hdeg : x.1.totalDegree = 0 :=
            (MvPolynomial.totalDegree_zero_iff_isHomogeneous (Fin (N + 1))).mpr hhom
          exact (MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp hdeg).symm
      let e₀ : k₀ ≃+* ↥(𝒜 0) := RingEquiv.ofBijective (algebraMap k₀ ↥(𝒜 0)) hbij
      haveI : CategoryTheory.IsIso
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₀ ↥(𝒜 0)))) := by
        change CategoryTheory.IsIso (AlgebraicGeometry.Spec.map e₀.toCommRingCatIso.hom)
        infer_instance
      change AlgebraicGeometry.IsProper
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₀ ↥(𝒜 0))))
      infer_instance
    · intro X _ _
      haveI : AlgebraicGeometry.IsLocallyNoetherian X.left :=
        AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian X.hom
      haveI : CompactSpace ↥X.left :=
        AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace X.hom
      haveI : AlgebraicGeometry.IsNoetherian X.left := AlgebraicGeometry.IsNoetherian.mk
      infer_instance
  · intro Y C
    dsimp only
    let I_C := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C
    have hRange : Set.range I_C.subschemeι.base = (C : Set ↥Y) :=
      (AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι I_C).trans
        (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal C)
    refine ⟨inferInstance, hRange, fun hIrr => ?_⟩
    have hsupp : I_C.support = C :=
      TopologicalSpace.Closeds.ext
        (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal C)
    have hrad : I_C.radical = I_C := by
      rw [← AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support, hsupp]
    have hChartRed : ∀ U : Y.affineOpens,
        AlgebraicGeometry.IsReduced (I_C.subschemeCover.openCover.X U) := by
      intro U
      have hRadU : (I_C.ideal U).IsRadical := by
        intro f hf
        rwa [← I_C.radical_ideal U, hrad] at hf
      haveI : IsReduced (↑(Y.presheaf.obj (Opposite.op U.1)) ⧸ I_C.ideal U) :=
        (Ideal.isRadical_iff_quotient_reduced (I_C.ideal U)).mp hRadU
      change AlgebraicGeometry.IsReduced
        (AlgebraicGeometry.Spec (CommRingCat.of (↑(Y.presheaf.obj (Opposite.op U.1)) ⧸ I_C.ideal U)))
      infer_instance
    haveI : AlgebraicGeometry.IsReduced I_C.subscheme :=
      @AlgebraicGeometry.IsReduced.of_openCover I_C.subscheme I_C.subschemeCover.openCover hChartRed
    let e : ↥I_C.subscheme ≃ₜ ↥(Set.range I_C.subschemeι.base) :=
      I_C.subschemeι.isEmbedding.toHomeomorph
    have hIrrRange : IsIrreducible (Set.range I_C.subschemeι.base) := hRange.symm ▸ hIrr
    haveI : IrreducibleSpace ↥(Set.range I_C.subschemeι.base) :=
      Subtype.irreducibleSpace hIrrRange
    have hIrrUnivR : IsIrreducible (Set.univ : Set ↥(Set.range I_C.subschemeι.base)) :=
      IrreducibleSpace.isIrreducible_univ _
    have hIrrTop : IsIrreducible (⊤ : Set ↥I_C.subscheme) := by
      change IsIrreducible (Set.univ : Set ↥I_C.subscheme)
      rw [← e.symm.surjective.range_eq, ← Set.image_univ]
      exact hIrrUnivR.image e.symm e.symm.continuous.continuousOn
    haveI : IrreducibleSpace ↥I_C.subscheme :=
      (irreducibleSpace_def ↥I_C.subscheme).mpr hIrrTop
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced I_C.subscheme

theorem weil_etale_acyclic_pushforward_and_pbc_fiber_vanishing (hDimZero : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      [AlgebraicGeometry.LocallyOfFiniteType Z.hom]
      [AlgebraicGeometry.QuasiCompact Z.hom],
      topologicalKrullDim Z.left ≤ (0 : WithBot ℕ∞) →
      ∀ (𝒢 : CategoryTheory.Sheaf Z.left.smallEtaleTopology AddCommGrpCat.{u})
        (r : ℕ), 1 ≤ r → Subsingleton (𝒢.H r))
    (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC₀ : WeilProperModPrimeBaseChangeHolds k₀ ℓ) :
    (∀ {Z Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀))}
        [AlgebraicGeometry.LocallyOfFiniteType Y.hom]
        (i : Z ⟶ Y) [AlgebraicGeometry.IsClosedImmersion i.left]
        [_hc : (weilEtaleSitePullback i.left).IsContinuous
          Y.left.smallEtaleTopology Z.left.smallEtaleTopology]
        [_hr : ((weilEtaleSitePullback i.left).sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.left.smallEtaleTopology Z.left.smallEtaleTopology).IsRightAdjoint]
        (𝒜 : CategoryTheory.Sheaf Z.left.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id 𝒜 = 0 →
      ∀ (r : ℕ),
        Subsingleton ((((weilEtaleSitePullback i.left).sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.left.smallEtaleTopology Z.left.smallEtaleTopology).obj 𝒜).H r) ↔
        Subsingleton (𝒜.H r)) ∧
    (∀ {V Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀))}
        [AlgebraicGeometry.LocallyOfFiniteType Y.hom]
        (ψ : V ⟶ Y) [AlgebraicGeometry.IsProper ψ.left]
        [_hc : (weilEtaleSitePullback ψ.left).IsContinuous
