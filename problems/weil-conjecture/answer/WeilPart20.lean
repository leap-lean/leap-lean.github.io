    intro q
    match q with
    | 0 =>
      intro Λ _ _ D hSub
      refine ⟨fun x y => ?_⟩
      have hzero : ∀ z : CategoryTheory.Abelian.Ext.{u} U₀ (CategoryTheory.Limits.colimit D) 0,
          z = 0 := by
        intro z
        obtain ⟨j, z_j, hz_j⟩ := hExt0Surj Λ D z
        have hz0 : z_j = 0 := Subsingleton.elim z_j 0
        rw [← hz_j, hz0, CategoryTheory.Abelian.Ext.zero_comp]
      rw [hzero x, hzero y]
    | r + 1 =>
      exact hPos r
  intro R J 𝒞 oneR T_S Γ_S hSepData hΓ
  have hHomSurj : ∀ (Λ : Type u) [CategoryTheory.SmallCategory Λ] [CategoryTheory.IsFiltered Λ]
      (M : CategoryTheory.Functor Λ 𝒞) (f : oneR ⟶ CategoryTheory.Limits.colimit M),
      ∃ (j : Λ) (f_j : oneR ⟶ M.obj j),
        CategoryTheory.CategoryStruct.comp f_j (CategoryTheory.Limits.colimit.ι M j) = f := by
    intro Λ _ _ M f
    let hT : CategoryTheory.Limits.IsTerminal T_S :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
          (CategoryTheory.Category.comp_id U.hom) trivial)
        (fun U g => CategoryTheory.MorphismProperty.Over.Hom.ext
          ((CategoryTheory.Category.comp_id g.left).symm.trans
            (CategoryTheory.MorphismProperty.Over.w g)))
    let adj := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) hT
    let R_mod : ModuleCat.{u, u} R := ModuleCat.of R R
    let g : R_mod ⟶ Γ_S.obj (CategoryTheory.Limits.colimit M) :=
      (adj.homEquiv R_mod (CategoryTheory.Limits.colimit M)) f
    let G₀ : CategoryTheory.Functor 𝒞 (Type u) :=
      CategoryTheory.Functor.comp Γ_S (CategoryTheory.forget (ModuleCat.{u, u} R))
    have : CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u} Γ_S := hΓ
    have hc₀ : CategoryTheory.Limits.IsColimit
        (G₀.mapCocone (CategoryTheory.Limits.colimit.cocone M)) :=
      CategoryTheory.Limits.isColimitOfPreserves G₀ (CategoryTheory.Limits.colimit.isColimit M)
    obtain ⟨j, x_j, hx_j⟩ :=
      CategoryTheory.Limits.Types.jointly_surjective_of_isColimit hc₀ (g.hom (1 : R))
    let x_j' : ↑(Γ_S.obj (M.obj j)) := x_j
    let g_j : R_mod ⟶ Γ_S.obj (M.obj j) :=
      ModuleCat.ofHom (LinearMap.toSpanSingleton R (↑(Γ_S.obj (M.obj j))) x_j')
    have hg_eq : CategoryTheory.CategoryStruct.comp g_j
        (Γ_S.map (CategoryTheory.Limits.colimit.ι M j)) = g := by
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro r
      have hx_eq : (Γ_S.map (CategoryTheory.Limits.colimit.ι M j)).hom x_j' = g.hom (1 : R) := hx_j
      change (Γ_S.map (CategoryTheory.Limits.colimit.ι M j)).hom (r • x_j') = g.hom r
      rw [map_smul, hx_eq, ← map_smul, smul_eq_mul, mul_one]
    refine ⟨j, (adj.homEquiv R_mod (M.obj j)).symm g_j, ?_⟩
    rw [← CategoryTheory.Adjunction.homEquiv_naturality_right_symm]
    change (adj.homEquiv R_mod (CategoryTheory.Limits.colimit M)).symm
      (CategoryTheory.CategoryStruct.comp g_j (Γ_S.map (CategoryTheory.Limits.colimit.ι M j))) = f
    rw [hg_eq, Equiv.symm_apply_apply]
  obtain ⟨I₀_S, L_S, hIsSep_S, hLNoeth_S, hLComp_S⟩ := hSepData
  obtain ⟨hNoethComp, hIndNoeth⟩ :=
    h_s1 𝒞 I₀_S L_S hIsSep_S hLNoeth_S hLComp_S
  have hInjColim : ∀ (Λ : Type u) [CategoryTheory.SmallCategory Λ] [CategoryTheory.IsFiltered Λ]
      (D : CategoryTheory.Functor Λ 𝒞),
      (∀ j : Λ, CategoryTheory.Injective (D.obj j)) →
      CategoryTheory.Injective (CategoryTheory.Limits.colimit D) :=
    h_s2 𝒞 I₀_S L_S hIsSep_S (fun i K m_hom hm_mono =>
      hNoethComp K (@CategoryTheory.isNoetherianObject_of_mono 𝒞 _ K (L_S i) m_hom hm_mono
        (hLNoeth_S i)))
  have hExtColim : ∀ (q : ℕ) (Λ : Type u) [CategoryTheory.SmallCategory Λ]
      [CategoryTheory.IsFiltered Λ] (D : CategoryTheory.Functor Λ 𝒞),
      (∀ j : Λ, Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (D.obj j) q)) →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (CategoryTheory.Limits.colimit D) q) :=
    h_s3 𝒞 oneR hHomSurj hInjColim
  refine ⟨hNoethComp, hInjColim, hExtColim, ?_⟩
  intro q F hNoethExt
