        (Set.range ι₁.base : Set ↥(AlgebraicGeometry.Proj 𝒜)) = Set.univ
      rw [hRange₀, hRange₁, Set.eq_univ_iff_forall]
      intro p
      by_contra hp
      rw [Set.mem_union, not_or] at hp
