    let S₁ := AlgebraicGeometry.Spec (CommRingCat.of F₁)
    let h := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
    let B := weilAltCdSitePullback h
    let J₀ := S₀.smallEtaleTopology
    let J₁ := S₁.smallEtaleTopology
    let Fgt₀ := AlgebraicGeometry.Scheme.Etale.forget S₀
    let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget S₁
    let P_push := B.sheafPushforwardContinuous A J₀ J₁
    let P_pull := B.sheafPullback A J₀ J₁
