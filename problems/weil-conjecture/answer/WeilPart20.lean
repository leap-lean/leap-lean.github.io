    · intro F
      let α₀ := Functor.whiskerLeft (diagFG F) η_G
      let β₀ := Functor.whiskerLeft (diagFG F) (diff_G 0)
      have hαβ₀ : α₀ ≫ β₀ = 0 := by
        ext p
        exact (hEx0_G (subOf p : 𝒜)).1
      obtain ⟨hcol₀, hEx_col₀⟩ := hColimExact α₀ β₀ hαβ₀
        (fun p => (hEx0_G (subOf p : 𝒜)).2)
      have h0_F : η_raw.app F ≫ (diff_raw 0).app F = 0 := by
        change (eId.hom.app F ≫ Limits.colim.map α₀) ≫ Limits.colim.map β₀ = 0
        rw [Category.assoc, hcol₀, Limits.comp_zero]
      refine ⟨h0_F, ?_⟩
      have iso_sc0 : ShortComplex.mk (Limits.colim.map α₀) (Limits.colim.map β₀) hcol₀ ≅
          ShortComplex.mk (η_raw.app F) ((diff_raw 0).app F) h0_F :=
        ShortComplex.isoMk (eId.app F).symm (Iso.refl _) (Iso.refl _)
          (by
            change eId.inv.app F ≫ (eId.hom.app F ≫ Limits.colim.map α₀) =
              Limits.colim.map α₀ ≫ 𝟙 _
            rw [Iso.inv_hom_id_app_assoc, Category.comp_id])
          (by
            change 𝟙 _ ≫ Limits.colim.map β₀ = Limits.colim.map β₀ ≫ 𝟙 _
            rw [Category.id_comp, Category.comp_id])
      exact (ShortComplex.exact_iff_of_iso iso_sc0).mp hEx_col₀
    · intro q F
      let α_q := Functor.whiskerLeft (diagFG F) (diff_G q)
      let β_q := Functor.whiskerLeft (diagFG F) (diff_G (q + 1))
      have hαβ_q : α_q ≫ β_q = 0 := by
        ext p
        exact (hExq_G q (subOf p : 𝒜)).1
      exact hColimExact α_q β_q hαβ_q (fun p => (hExq_G q (subOf p : 𝒜)).2)
    · intro q k hk F
      exact hExtColimA k hk (IdxFG F) (diagFG F ⋙ G q)
        (fun p => hG_acyc q k hk (subOf p : 𝒜))
  
  
  
  have hSubNoeth := hPillar1 (𝒜 := 𝒞) hNoethGen
  obtain ⟨G_ord, η_ord, diff_ord, hG_props, hη_ord, hEx0_ord, hExq_ord, hAcyc_ord, _⟩ := hOrd
  have hRaw := hPillar2 (𝒜 := 𝒞) oneR G_ord η_ord diff_ord
    hG_props hη_ord hEx0_ord hExq_ord hAcyc_ord
    hNoethCompact hExtColim hSubNoeth
  obtain ⟨𝒯, η, diff, h𝒯_props, hZero, hMono, hEx0, hExq, hAcyc⟩ :=
    hPillar3 (𝒜 := 𝒞) oneR hCD hRaw
  have hSecLift_S : ∀ {E : 𝒞} (y : ↑(Γ_S.obj E)),
      ∃ u_E : oneR ⟶ E, ∀ {B : 𝒞} (g : B ⟶ E) (u_B : oneR ⟶ B),
        u_B ≫ g = u_E → ∃ x : ↑(Γ_S.obj B), (Γ_S.map g).hom x = y := by
    intro E y
    have hTerm_S : Limits.IsTerminal T_S := weilEtaleIdTerminalIsTerminal.{u} S
    let adj := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) hTerm_S
    let φ_y : ModuleCat.of R R ⟶ Γ_S.obj E :=
      ModuleCat.ofHom (LinearMap.toSpanSingleton R (↑(Γ_S.obj E)) y)
    refine ⟨(adj.homEquiv (ModuleCat.of R R) E).symm φ_y, fun {B} g u_B hu_B => ?_⟩
    refine ⟨((adj.homEquiv (ModuleCat.of R R) B) u_B).hom (1 : R), ?_⟩
    have hnat : (adj.homEquiv (ModuleCat.of R R) B) u_B ≫ Γ_S.map g = φ_y := by
      have hn := adj.homEquiv_naturality_right u_B g
      change (adj.homEquiv (ModuleCat.of R R) E) (u_B ≫ g) =
        (adj.homEquiv (ModuleCat.of R R) B) u_B ≫ Γ_S.map g at hn
      rw [← hn, hu_B, Equiv.apply_symm_apply]
    have hev := congrArg (fun ψ : ModuleCat.of R R ⟶ Γ_S.obj E => ψ.hom (1 : R)) hnat
    simpa [φ_y, LinearMap.toSpanSingleton_apply] using hev
  have : Limits.PreservesFilteredColimitsOfSize.{u, u} Γ_S := hΓ
  refine ⟨𝒯, η, diff, fun q => (h𝒯_props q).1, hZero, hMono, hEx0, hExq, hAcyc, fun q => ?_⟩
  have := (h𝒯_props q).1
  have := (h𝒯_props q).2.1
  have := (h𝒯_props q).2.2.1
  have := (h𝒯_props q).2.2.2
  exact hPillar4 (𝒜 := 𝒞) oneR Γ_S (@hSecLift_S) (𝒯 q) (hAcyc q 1 le_rfl)

theorem weil_etale_noetherian_ind_godement_and_colimit_reduction (k : Type u) [Field k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType X.hom]
    [AlgebraicGeometry.QuasiCompact X.hom]
    [AlgebraicGeometry.IsSeparated X.hom] :
    (∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ),
      WeilHasOrdinaryGodementResolution X.left ℓ →
      (∀ (ℬ : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsConstructibleModPrimeSheaf ℓ X.left ℬ → Subsingleton (ℬ.H q)) →
      ∀ (𝒜 : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id 𝒜 = 0 → Subsingleton (𝒜.H q)) ∧
    (∀ (d m : ℕ), 1 ≤ m →
      WeilHasOrdinaryGodementResolution X.left m →
      (∀ (q : ℕ), 2 * d < q →
        ∀ (F : CategoryTheory.Sheaf X.left.smallEtaleTopology
            (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))),
          Subsingleton (CategoryTheory.Abelian.Ext.{u} (weilEtaleModuleUnit X.left m) F q)) →
      WeilHasTruncatedGodementComplex X.left d m) :=
by
  classical
  let S : AlgebraicGeometry.Scheme.{u} := X.left
  have : CompactSpace ↥S :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace X.hom
  have : S.IsSeparated := by
    have hTerm : CategoryTheory.Limits.terminal.from S =
        X.hom ≫ CategoryTheory.Limits.terminal.from _ :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    exact AlgebraicGeometry.Scheme.IsSeparated.mk (hTerm ▸ inferInstance)
  obtain ⟨hNoethFree, hNoethConstr⟩ :=
    weil_etale_noetherian_localFree_and_constructible_mod_prime k X
  refine ⟨?_, ?_⟩
  · intro ℓ hPrime q hOrd_ℓ hConstr 𝒜 h𝒜
    let R_ℓ := ULift.{u, 0} (ZMod ℓ)
    let J := S.smallEtaleTopology
    let Fgt := CategoryTheory.forget₂ (ModuleCat.{u, u} R_ℓ) AddCommGrpCat.{u}
    let U_ℓ := CategoryTheory.Sheaf.composeAndSheafify J Fgt
    have htor : ∀ (V : (S.Etale)ᵒᵖ) (x : ↑(𝒜.obj.obj V)), ℓ • x = 0 := by
      intro V x
      have h1 : (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map
          (ℓ • CategoryTheory.CategoryStruct.id 𝒜) = 0 := by
        rw [h𝒜, CategoryTheory.Functor.map_zero]
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id] at h1
      have h2 := congrArg (fun η => (η.app V).hom x) h1
      simpa using h2
    let modInst : ∀ (V : (S.Etale)ᵒᵖ), Module R_ℓ ↑(𝒜.obj.obj V) :=
      fun V =>
        letI : Module (ZMod ℓ) ↑(𝒜.obj.obj V) := AddCommGroup.zmodModule (htor V)
        Module.compHom (↑(𝒜.obj.obj V)) (ULift.ringEquiv (R := ZMod ℓ)).toRingHom
    have h_smul : ∀ (V : (S.Etale)ᵒᵖ) (r : R_ℓ) (x : ↑(𝒜.obj.obj V)),
        @SMul.smul R_ℓ (↑(𝒜.obj.obj V)) (modInst V).toSMul r x = r.down.val • x := by
      intro V r x
      let _ : Module (ZMod ℓ) ↑(𝒜.obj.obj V) := AddCommGroup.zmodModule (htor V)
      change (r.down : ZMod ℓ) • x = r.down.val • x
      conv_lhs =>
        rw [← ZMod.natCast_zmod_val r.down, Nat.cast_smul_eq_nsmul]
    let P_tilde : (S.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R_ℓ :=
      { obj := fun V => @ModuleCat.of R_ℓ _ (↑(𝒜.obj.obj V)) (𝒜.obj.obj V).str (modInst V)
        map := fun {V₁ V₂} f =>
          letI : Module R_ℓ ↑(𝒜.obj.obj V₁) := modInst V₁
          letI : Module R_ℓ ↑(𝒜.obj.obj V₂) := modInst V₂
          ModuleCat.ofHom
            { toAddHom := (𝒜.obj.map f).hom.toAddHom
              map_smul' := fun r x => by
                change (𝒜.obj.map f).hom (@SMul.smul R_ℓ _ (modInst V₁).toSMul r x) =
                  @SMul.smul R_ℓ _ (modInst V₂).toSMul r ((𝒜.obj.map f).hom x)
                rw [h_smul V₁ r x, h_smul V₂ r ((𝒜.obj.map f).hom x), map_nsmul] }
        map_id := fun V => by
          ext x
          simp
        map_comp := fun f g => by
          ext x
          simp }
    let e_presheaf : P_tilde ⋙ Fgt ≅ 𝒜.obj :=
      CategoryTheory.NatIso.ofComponents
        (fun V => (AddEquiv.refl (↑(𝒜.obj.obj V))).toAddCommGrpIso)
        (fun f => by ext x; rfl)
    have hSheaf_comp : CategoryTheory.Presheaf.IsSheaf J (P_tilde ⋙ Fgt) :=
      (CategoryTheory.Presheaf.isSheaf_of_iso_iff e_presheaf.symm).mpr 𝒜.property
    have hSheaf : CategoryTheory.Presheaf.IsSheaf J P_tilde :=
      CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J P_tilde Fgt hSheaf_comp
    let A_tilde : CategoryTheory.Sheaf J (ModuleCat.{u, u} R_ℓ) := ⟨P_tilde, hSheaf⟩
    let e_sheaf : U_ℓ.obj A_tilde ≅ 𝒜 :=
      ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).mapIso e_presheaf) ≪≫
        CategoryTheory.asIso
          ((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).counit.app 𝒜)
    obtain ⟨hComp_ℓ, hΓ_ℓ, ⟨I₀, W, hWAff, hWSep⟩⟩ :=
      weil_etale_affine_filtered_colimits_and_compact_freeYoneda S ℓ
    let L_ℓ : I₀ → CategoryTheory.Sheaf J (ModuleCat.{u, u} R_ℓ) :=
      fun i => weilEtaleLocalFreeSheaf S ℓ (W i)
    have hLNoeth_ℓ : ∀ i : I₀, CategoryTheory.IsNoetherianObject (L_ℓ i) :=
      fun i => hNoethFree ℓ hPrime.out.one_le (W i) (hWAff i)
    have hLComp_ℓ : ∀ i : I₀,
        CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u}
          (CategoryTheory.coyoneda.obj (Opposite.op (L_ℓ i))) :=
      fun i => hComp_ℓ (W i) (hWAff i)
    have hGroth_ℓ := weil_etale_grothendieck_ext_filtered_colimit_subsingleton S ℓ
      ⟨I₀, L_ℓ, hWSep, hLNoeth_ℓ, hLComp_ℓ⟩ hΓ_ℓ
    obtain ⟨_, _, _, _, _, _, _, _, hExtEquiv_ℓ⟩ := hOrd_ℓ
    have hSubExt_A : Subsingleton
        (CategoryTheory.Abelian.Ext.{u} (weilEtaleModuleUnit S ℓ) A_tilde q) := by
      apply hGroth_ℓ.2.2.2 q A_tilde
      intro P hP
      have hConstr_P : WeilIsConstructibleModPrimeSheaf ℓ S (U_ℓ.obj P) :=
        hNoethConstr ℓ P hP
      have hSubH_P : Subsingleton ((U_ℓ.obj P).H q) :=
        hConstr (U_ℓ.obj P) hConstr_P
      obtain ⟨e_P⟩ := hExtEquiv_ℓ q P
      exact e_P.toEquiv.subsingleton
    obtain ⟨e_Atilde⟩ := hExtEquiv_ℓ q A_tilde
    have hSubH_Atilde : Subsingleton ((U_ℓ.obj A_tilde).H q) :=
      e_Atilde.symm.toEquiv.subsingleton
    refine ⟨fun x y => ?_⟩
    have hzero : ∀ z : 𝒜.H q, z = 0 := by
      intro z
      have hz_inv : z.comp (CategoryTheory.Abelian.Ext.mk₀ e_sheaf.inv) (Nat.add_zero q) = 0 :=
        Subsingleton.elim _ 0
      calc
        z = z.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 𝒜)) (Nat.add_zero q) := by simp
        _ = z.comp (CategoryTheory.Abelian.Ext.mk₀ (e_sheaf.inv ≫ e_sheaf.hom)) (Nat.add_zero q) := by
          rw [e_sheaf.inv_hom_id]
        _ = (z.comp (CategoryTheory.Abelian.Ext.mk₀ e_sheaf.inv) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ e_sheaf.hom) (Nat.add_zero q) := by
          rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ e_sheaf.inv e_sheaf.hom,
            ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q)]
        _ = 0 := by rw [hz_inv]; simp
    rw [hzero x, hzero y]
  · intro d m hm hOrd_m hCD
    obtain ⟨hComp_m, hΓ_m, ⟨I₀, W, hWAff, hWSep⟩⟩ :=
      weil_etale_affine_filtered_colimits_and_compact_freeYoneda S m
    let L_m : I₀ → CategoryTheory.Sheaf S.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) :=
      fun i => weilEtaleLocalFreeSheaf S m (W i)
    have hLNoeth_m : ∀ i : I₀, CategoryTheory.IsNoetherianObject (L_m i) :=
      fun i => hNoethFree m hm (W i) (hWAff i)
    have hLComp_m : ∀ i : I₀,
        CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u}
          (CategoryTheory.coyoneda.obj (Opposite.op (L_m i))) :=
      fun i => hComp_m (W i) (hWAff i)
    obtain ⟨hNoethCompact_m, _, hExtColim_m, _⟩ :=
      weil_etale_grothendieck_ext_filtered_colimit_subsingleton S m
        ⟨I₀, L_m, hWSep, hLNoeth_m, hLComp_m⟩ hΓ_m
    exact weil_etale_ind_godement_truncated_complex_of_noetherian_generators S d m hm
      hOrd_m hCD hNoethCompact_m ⟨I₀, L_m, hWSep, hLNoeth_m⟩ hΓ_m
      (fun k' _ => hExtColim_m k')

theorem weil_etale_dim_zero_algClosed_cohomology_subsingleton (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
    [AlgebraicGeometry.LocallyOfFiniteType Z.hom]
    [AlgebraicGeometry.QuasiCompact Z.hom]
    (hDimZ : topologicalKrullDim Z.left ≤ (0 : WithBot ℕ∞))
    (𝒢 : CategoryTheory.Sheaf Z.left.smallEtaleTopology AddCommGrpCat.{u})
    (q : ℕ) (hq : 1 ≤ q) :
    Subsingleton (𝒢.H q) :=
by
  classical
  
  have hStage1 : ∃ (n : ℕ) (O : Fin n → Z.left.Opens),
      TopologicalSpace.IsOpenCover O ∧
      (∀ (i j : Fin n), i ≠ j → Disjoint (O i) (O j)) ∧
      ∀ (i : Fin n),
        Nonempty ↥(O i) ∧
        AlgebraicGeometry.IsAffineOpen (O i) ∧
        (∃ φ : k₀ →+* ↑((O i : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)),
          φ.FiniteType) ∧
        (∃ 𝔪 : Ideal ↑((O i : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)),
          𝔪.IsMaximal ∧ IsNilpotent 𝔪 ∧
          ∀ (p : Ideal ↑((O i : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤))),
            p.IsPrime → p = 𝔪) := by
    have hIsoFT : ((Scheme.ΓSpecIso (CommRingCat.of k₀)).inv.hom).FiniteType := by
      apply RingHom.FiniteType.of_surjective
      intro y
      refine ⟨(Scheme.ΓSpecIso (CommRingCat.of k₀)).hom.hom y, ?_⟩
      change ((Scheme.ΓSpecIso (CommRingCat.of k₀)).hom ≫
        (Scheme.ΓSpecIso (CommRingCat.of k₀)).inv).hom y = y
      simp
    have hSing : ∀ x : ↥Z.left, ∃ O_x : Z.left.Opens,
        IsAffineOpen O_x ∧ (O_x : Set ↥Z.left) = {x} := by
      intro x
      obtain ⟨U, hU, hx, -⟩ :=
        exists_isAffineOpen_mem_and_subset (show x ∈ (⊤ : Z.left.Opens) from trivial)
      let R : Type u := ↑(Z.left.presheaf.obj (Opposite.op U))
      let φ_U : k₀ →+* R :=
        ((Z.hom.appLE ⊤ U le_top).hom).comp ((Scheme.ΓSpecIso (CommRingCat.of k₀)).inv.hom)
      have hφ_U : φ_U.FiniteType :=
        RingHom.FiniteType.comp
          (LocallyOfFiniteType.finiteType_appLE Z.hom (isAffineOpen_top _) hU le_top) hIsoFT
      letI : Algebra k₀ R := φ_U.toAlgebra
      haveI : Algebra.FiniteType k₀ R := hφ_U
      haveI : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing k₀ R
      let e_homeo : ↥(U : Scheme.{u}) ≃ₜ PrimeSpectrum R := hU.isoSpec.hom.homeomorph
      have hKrullR : ringKrullDim R ≤ (0 : WithBot ℕ∞) := by
        rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim R,
          ← e_homeo.isHomeomorph.topologicalKrullDim_eq]
        exact (topologicalKrullDim_subspace_le ↥Z.left (U : Set ↥Z.left)).trans hDimZ
      haveI : IsArtinianRing R :=
        isArtinianRing_iff_isNoetherianRing_krullDimLE_zero.mpr
          ⟨inferInstance, Ring.krullDimLE_iff.mpr hKrullR⟩
      haveI : Finite (PrimeSpectrum R) := IsArtinianRing.instFinitePrimeSpectrum R
      letI : Fintype (PrimeSpectrum R) := Fintype.ofFinite (PrimeSpectrum R)
      let x_U : ↥(U : Scheme.{u}) := ⟨x, hx⟩
      let p_x : PrimeSpectrum R := e_homeo x_U
      let S_other : Finset (PrimeSpectrum R) := Finset.univ.erase p_x
      have h_sep : ∀ q ∈ S_other, ∃ g : R, g ∈ q.asIdeal ∧ g ∉ p_x.asIdeal := by
        intro q hq
        have hq_ne : q ≠ p_x := (Finset.mem_erase.mp hq).1
        have hq_max : q.asIdeal.IsMaximal := IsArtinianRing.isMaximal_of_isPrime q.asIdeal
        have hnot_sub : ¬ ((q.asIdeal : Set R) ⊆ (p_x.asIdeal : Set R)) := by
          intro hle
          exact hq_ne (PrimeSpectrum.ext (hq_max.eq_of_le p_x.isPrime.ne_top hle))
        exact Set.not_subset.mp hnot_sub
      let g_fn : {q // q ∈ S_other} → R := fun q => Classical.choose (h_sep q.1 q.2)
      have hg_in : ∀ q : {q // q ∈ S_other}, g_fn q ∈ q.1.asIdeal :=
        fun q => (Classical.choose_spec (h_sep q.1 q.2)).1
      have hg_not_in : ∀ q : {q // q ∈ S_other}, g_fn q ∉ p_x.asIdeal :=
        fun q => (Classical.choose_spec (h_sep q.1 q.2)).2
      let f_x : R := ∏ q ∈ S_other.attach, g_fn q
      have hfx_not_in : f_x ∉ p_x.asIdeal := by
        have h_ind : ∀ (T : Finset {q // q ∈ S_other}), (∏ q ∈ T, g_fn q) ∉ p_x.asIdeal := by
          intro T
          induction T using Finset.induction_on with
          | empty =>
            rw [Finset.prod_empty]
            exact fun h1 => p_x.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
          | @insert a s ha ih =>
            rw [Finset.prod_insert ha]
            intro hmul
            rcases p_x.isPrime.mem_or_mem hmul with h1 | h2
            · exact hg_not_in a h1
            · exact ih h2
        exact h_ind S_other.attach
      have hfx_in : ∀ q : PrimeSpectrum R, q ≠ p_x → f_x ∈ q.asIdeal := by
        intro q hq_ne
        have hq_mem : q ∈ S_other := Finset.mem_erase.mpr ⟨hq_ne, Finset.mem_univ q⟩
        obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem g_fn (Finset.mem_attach S_other ⟨q, hq_mem⟩)
        have h_eq : f_x = g_fn ⟨q, hq_mem⟩ * c := hc
        rw [h_eq]
        exact q.asIdeal.mul_mem_right c (hg_in ⟨q, hq_mem⟩)
      refine ⟨Z.left.basicOpen f_x, hU.basicOpen f_x, ?_⟩
      have h_base : ∀ y : ↥(U : Scheme.{u}), hU.fromSpec.base (e_homeo y) = y.1 := by
        intro y
        rw [← hU.isoSpec_inv_ι]
        change U.ι.base ((hU.isoSpec.hom ≫ hU.isoSpec.inv).base y) = y.1
        rw [Iso.hom_inv_id]
        rfl
      have h_pre : ∀ p : PrimeSpectrum R,
          p ∈ (TopologicalSpace.Opens.map hU.fromSpec.base).obj (Z.left.basicOpen f_x) ↔
            p ∈ PrimeSpectrum.basicOpen f_x :=
        SetLike.ext_iff.mp (hU.fromSpec_preimage_basicOpen f_x)
      ext z
      simp only [SetLike.mem_coe, Set.mem_singleton_iff]
      constructor
      · intro hz
        have hzU : z ∈ U := Z.left.basicOpen_le f_x hz
        let y : ↥(U : Scheme.{u}) := ⟨z, hzU⟩
        have h_in_pre : e_homeo y ∈
            (TopologicalSpace.Opens.map hU.fromSpec.base).obj (Z.left.basicOpen f_x) := by
          change hU.fromSpec.base (e_homeo y) ∈ Z.left.basicOpen f_x
          rw [h_base y]
          exact hz
        rw [h_pre, PrimeSpectrum.mem_basicOpen] at h_in_pre
        have h_eq_p : e_homeo y = p_x := by
          by_contra hne
          exact h_in_pre (hfx_in (e_homeo y) hne)
        exact congrArg Subtype.val (e_homeo.injective h_eq_p)
