            rw [AddCommGrpCat.mono_iff_injective]
            intro x₁ x₂ hx
            have hsub : (δ.app (Opposite.op U)) (x₁ - x₂) = 0 := by
              rw [map_sub, hx, sub_self]
            let d_x : CategoryTheory.Abelian.Ext (L_W W) S_ex.X₃ b := x₁ - x₂
            obtain ⟨x_mid, hx_mid⟩ :=
              CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ (L_W W) hS_ex d_x rfl hsub
            have hm0 : x_mid = 0 := @Subsingleton.elim _ hSub_b x_mid 0
            rw [hm0, CategoryTheory.Abelian.Ext.zero_comp] at hx_mid
            exact sub_eq_zero.mp hx_mid.symm
          have h_epi : CategoryTheory.Epi (δ.app (Opposite.op U)) := by
            rw [AddCommGrpCat.epi_iff_surjective]
            intro y
            let y' : CategoryTheory.Abelian.Ext (L_W W) S_ex.X₁ (b + 1) := y
            have hy0 : y'.comp (CategoryTheory.Abelian.Ext.mk₀ S_ex.f) (Nat.add_zero (b + 1)) = 0 :=
