        apply (adjL.homEquiv A (C₁.obj A)).injective
        rw [CategoryTheory.Adjunction.homEquiv_leftAdjointUniq_hom_app]
        have hcomp : adjL.homEquiv A (C₁.obj A) πA =
            adj₂.homEquiv A (P_push.obj (C₁.obj A)) (adj_pull.homEquiv (C₂.obj A) (C₁.obj A) πA) := by
          rw [CategoryTheory.Adjunction.comp_homEquiv]
