      let g' : A ⟶ 𝒢.obj.obj (Opposite.op T'₂) :=
        u'₁ ≫ (C₁.obj A).obj.map (hT'₁.from (B.obj T'₂)).op
      apply congrArg (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).symm
      change (adj₂.homEquiv A 𝒢).symm g = (adj'₂.homEquiv A 𝒢).symm g'
      rw [← hSymmTrans S₂ hT₂ hT'₂ β A 𝒢 g]
      apply congrArg (adj'₂.homEquiv A 𝒢).symm
      change (u₁ ≫ (C₁.obj A).obj.map (hT₁.from (B.obj T₂)).op) ≫
          (C₁.obj A).obj.map (B.map β).op =
        u'₁ ≫ (C₁.obj A).obj.map (hT'₁.from (B.obj T'₂)).op
      have hu'₁ : u'₁ = u₁ ≫ (C₁.obj A).obj.map α.op := hUnitTrans S₁ hT₁ hT'₁ α A
      have hcomm : B.map β ≫ hT₁.from (B.obj T₂) = hT'₁.from (B.obj T'₂) ≫ α :=
        hT₁.hom_ext _ _
      rw [CategoryTheory.Category.assoc, ← (C₁.obj A).obj.map_comp, ← op_comp, hcomm,
        op_comp, (C₁.obj A).obj.map_comp, ← CategoryTheory.Category.assoc, ← hu'₁]
    · intro T₁ hT₁ T₂ hT₂
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
