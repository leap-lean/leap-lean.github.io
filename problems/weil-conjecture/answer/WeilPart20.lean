                change ((𝒞₁.obj.map (Opposite.op (F_M.map u)) ≫
                    𝒞₁.obj.map (Opposite.op (F_M.map j₂))).hom)
                    (Classical.choose (hGlue_β_inv V₁_op.unop f)) =
                  ((𝒞₁.obj.map (Opposite.op (F_M.map j₁)) ≫
                    𝒞₁.obj.map (Opposite.op (F_M.map u_sub))).hom)
                    (Classical.choose (hGlue_β_inv V₁_op.unop f))
                rw [← 𝒞₁.obj.map_comp, ← 𝒞₁.obj.map_comp]
                exact congrArg (fun k => (𝒞₁.obj.map (Opposite.op (F_M.map k))).hom _) hcomm_j
              exact hmap_comp.trans
                ((congrArg (𝒞₁.obj.map (Opposite.op (F_M.map u_sub))).hom
