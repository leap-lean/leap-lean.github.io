                  weilCupPDTraceOpenSubobj S_M V₁_op.unop O₁ :=
                CategoryTheory.MorphismProperty.Over.homMk u_sub_left
                  (by
                    change u_sub_left ≫ (O₁.ι ≫ V₁_op.unop.hom) = O₂.ι ≫ V₂_op.unop.hom
                    rw [← Category.assoc, hu_sub_ι, Category.assoc]
                    exact congrArg (O₂.ι ≫ ·) (CategoryTheory.MorphismProperty.Over.w u))
