              refine ⟨fun z => hx12 ?_⟩
              have hz_eq := congrArg (fun m => m.left.base z) hcomm
              rw [show (h₁ ≫ F_M.map (j_pt x₁)).left.base z =
                  (O_pt x₁).ι.base (h₁.left.base z) from rfl,
                show (h₂ ≫ F_M.map (j_pt x₂)).left.base z =
                  (O_pt x₂).ι.base (h₂.left.base z) from rfl] at hz_eq
              have h1 : (O_pt x₁).ι.base (h₁.left.base z) = x₁ := (h₁.left.base z).2
              have h2 : (O_pt x₂).ι.base (h₂.left.base z) = x₂ := (h₂.left.base z).2
              exact h1.symm.trans (hz_eq.trans h2)
            have _ := hEmptySubsingleton 𝒞₁ Z hEmpZ
            exact Subsingleton.elim _ _
    refine ⟨hFor.amalgamate fam hCompat, fun x => ?_, fun y hy => ?_⟩
    · exact (hFor.valid_glue hCompat (F_M.map (j_pt x))
        (CategoryTheory.Presieve.ofArrows.mk x)).trans (hFamVal x)
    · refine hFor.isSeparatedFor.ext (fun W g hg => ?_)
      cases hg with
      | mk x =>
        exact (hy x).trans
          ((hFamVal x).symm.trans
            (hFor.valid_glue hCompat (F_M.map (j_pt x))
              (CategoryTheory.Presieve.ofArrows.mk x)).symm)

  let β_inv : PShf 1 ⟶ F_M_star.obj 𝒞₁ :=
