      exact h_comp.trans h_ev_pull.symm
    have hs₀_zero : (ℱ₀.obj.map e_id₀.hom.op).hom (evH0 S₀ ℱ₀ ξ) = 0 :=
      (hFieldPullPresAndInj E₀.subtype ℱ₀).1 E₀.subtype rfl _ h_pull_zero
    have hev_zero : evH0 S₀ ℱ₀ ξ = 0 := by
      have h_inv := congrArg ((ℱ₀.obj.map e_id₀.inv.op).hom) hs₀_zero
      rw [map_zero] at h_inv
      have h_id : ((ℱ₀.obj.map e_id₀.inv.op).hom)
          (((ℱ₀.obj.map e_id₀.hom.op).hom) (evH0 S₀ ℱ₀ ξ)) = evH0 S₀ ℱ₀ ξ := by
        have hc : (ℱ₀.obj.map e_id₀.hom.op ≫ ℱ₀.obj.map e_id₀.inv.op) = 𝟙 _ := by
