        rw [hzero x, hzero y]
      | succ k ih =>
        intro Λ _ _ D hSub
        have hSubK : ∀ j : Λ,
            Subsingleton (CategoryTheory.Abelian.Ext.{u} U₀
              ((CategoryTheory.Functor.comp D K_coker).obj j) (k + 1)) := by
