        (fun x => match x with
          | none => CategoryTheory.Iso.refl U.left
          | some _ => CategoryTheory.Iso.refl W.left)
        (by
          intro X Y g
          let g' : CategoryTheory.Limits.WidePullbackShape.Hom X Y := g
          change F_forget.map (D_et.map g') ≫ _ = _ ≫ D_sch.map g'
          cases g' with
          | id X =>
            change F_forget.map (D_et.map (𝟙 X)) ≫ _ = _ ≫ D_sch.map (𝟙 X)
            rw [D_et.map_id, F_forget.map_id, D_sch.map_id,
              CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
          | term j =>
            change f.left ≫ 𝟙 U.left = 𝟙 W.left ≫ f.left
            rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    let e_pres : F_forget.obj (CategoryTheory.Limits.limit D_et) ≅
        CategoryTheory.Limits.limit (D_et ⋙ F_forget) :=
      CategoryTheory.preservesLimitIso F_forget D_et
    let e_lim : CategoryTheory.Limits.limit (D_et ⋙ F_forget) ≅
        CategoryTheory.Limits.limit D_sch :=
      CategoryTheory.Limits.HasLimit.isoOfNatIso e_diag
    let e_tot : ((CategoryTheory.Arrow.mk f).cechNerve.obj
        (Opposite.op (SimplexCategory.mk n))).left ≅
        CategoryTheory.Limits.widePullback U.left
          (fun _ : Fin (n + 1) => W.left) (fun _ => f.left) :=
      (CategoryTheory.eqToIso (congrArg F_forget.obj
        (CategoryTheory.Arrow.cechNerve_obj (CategoryTheory.Arrow.mk f)
          (Opposite.op (SimplexCategory.mk n))))).trans
        (e_pres.trans e_lim)
    have : AlgebraicGeometry.IsAffine
        (CategoryTheory.Limits.widePullback U.left
          (fun _ : Fin (n + 1) => W.left) (fun _ => f.left)) :=
      hWideAff n
    have : AlgebraicGeometry.IsAffine
        ((CategoryTheory.Arrow.mk f).cechNerve.obj
          (Opposite.op (SimplexCategory.mk n))).left :=
      AlgebraicGeometry.IsAffine.of_isIso e_tot.hom
    exact ⟨AlgebraicGeometry.Scheme.compactSpace_of_isAffine _,
      AlgebraicGeometry.Scheme.instIsSeparatedOfIsAffine⟩

  · 
    intro 𝒢 W f hf_cov C_𝒢 aug₀
    let N := (CategoryTheory.Arrow.mk f).cechNerve
    let W₀ : S.Etale := CategoryTheory.Limits.widePullback U (fun _ : Fin 1 => W) (fun _ => f)
    let W₁ : S.Etale := CategoryTheory.Limits.widePullback U (fun _ : Fin 2 => W) (fun _ => f)
    let aug₀' : W₀ ⟶ U := aug₀
    change Function.Injective (𝒢.obj.map aug₀'.op).hom ∧
      ∀ x : ↥(𝒢.obj.obj (Opposite.op W₀)), (C_𝒢.d 0 1).hom x = 0 →
        ∃ s : ↥(𝒢.obj.obj (Opposite.op U)), (𝒢.obj.map aug₀'.op).hom s = x
    let π₀ : W₀ ⟶ W := CategoryTheory.Limits.WidePullback.π (fun _ : Fin 1 => f) 0
    let ι₀ : W ⟶ W₀ := CategoryTheory.Limits.WidePullback.lift f
      (fun _ : Fin 1 => 𝟙 W) (fun _ => CategoryTheory.Category.id_comp f)
    have h_aug_eq : aug₀' = CategoryTheory.Limits.WidePullback.base (fun _ : Fin 1 => f) :=
      CategoryTheory.Arrow.augmentedCechNerve_hom_app (CategoryTheory.Arrow.mk f)
        (Opposite.op (SimplexCategory.mk 0))
    have h_π₀_f : π₀ ≫ f = aug₀' := by
      rw [h_aug_eq]
      exact CategoryTheory.Limits.WidePullback.π_arrow (fun _ : Fin 1 => f) 0
    have h_ι₀_aug : ι₀ ≫ aug₀' = f := by
      rw [h_aug_eq]
      exact CategoryTheory.Limits.WidePullback.lift_base _ _ _ _
    have hAug_cov : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton aug₀') ∈
        S.smallEtaleTopology U := by
      refine S.smallEtaleTopology.superset_covering ?_ hf_cov
      intro Z g hg
      rcases hg with ⟨Y, u, f', hf', rfl⟩
      cases hf'
      exact ⟨W₀, u ≫ ι₀, aug₀', CategoryTheory.Presieve.singleton.mk, by
        rw [CategoryTheory.Category.assoc, h_ι₀_aug]⟩
    let G_type : CategoryTheory.Functor (S.Etale)ᵒᵖ (Type u) :=
      𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    have hShG : CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology G_type :=
      CategoryTheory.GrothendieckTopology.HasSheafCompose.isSheaf 𝒢.obj 𝒢.property
    have hSheafAug : CategoryTheory.Presieve.IsSheafFor G_type
        (CategoryTheory.Presieve.singleton aug₀') :=
      (CategoryTheory.Presieve.isSheafFor_iff_generate _).mpr (hShG.isSheafFor _ hAug_cov)
    rw [CategoryTheory.Presieve.isSheafFor_singleton] at hSheafAug
    refine ⟨?_, ?_⟩
    · intro s₁ s₂ hs
      have hCompat : ∀ {Z : S.Etale} (p₁ p₂ : Z ⟶ W₀),
          p₁ ≫ aug₀' = p₂ ≫ aug₀' →
          (CategoryTheory.ConcreteCategory.hom (G_type.map p₁.op)) ((𝒢.obj.map aug₀'.op).hom s₁) =
            (CategoryTheory.ConcreteCategory.hom (G_type.map p₂.op)) ((𝒢.obj.map aug₀'.op).hom s₁) := by
        intro Z p₁ p₂ hp
        change (𝒢.obj.map p₁.op).hom ((𝒢.obj.map aug₀'.op).hom s₁) =
          (𝒢.obj.map p₂.op).hom ((𝒢.obj.map aug₀'.op).hom s₁)
        have h1 : (𝒢.obj.map p₁.op).hom ((𝒢.obj.map aug₀'.op).hom s₁) =
            (𝒢.obj.map (p₁ ≫ aug₀').op).hom s₁ := by
          rw [op_comp, CategoryTheory.Functor.map_comp]
          rfl
        have h2 : (𝒢.obj.map p₂.op).hom ((𝒢.obj.map aug₀'.op).hom s₁) =
            (𝒢.obj.map (p₂ ≫ aug₀').op).hom s₁ := by
          rw [op_comp, CategoryTheory.Functor.map_comp]
          rfl
        rw [h1, h2, hp]
      obtain ⟨s, _, hs_uniq⟩ := hSheafAug ((𝒢.obj.map aug₀'.op).hom s₁) hCompat
      have heq1 : s₁ = s := hs_uniq s₁ rfl
      have heq2 : s₂ = s := hs_uniq s₂ hs.symm
      exact heq1.trans heq2.symm
    · intro x hx
      let X_cosimp := CategoryTheory.opOp SimplexCategory ⋙ N.op ⋙ 𝒢.obj
      have hd_eq : C_𝒢.d 0 1 = AlgebraicTopology.AlternatingCofaceMapComplex.objD X_cosimp 0 := by
        change (AlgebraicTopology.AlternatingCofaceMapComplex.obj X_cosimp).d 0 (0 + 1) =
          AlgebraicTopology.AlternatingCofaceMapComplex.objD X_cosimp 0
        dsimp only [AlgebraicTopology.AlternatingCofaceMapComplex.obj]
        rw [CochainComplex.of_d]
      have hx' : (AlgebraicTopology.AlternatingCofaceMapComplex.objD X_cosimp 0).hom x = 0 := by
        rw [← hd_eq]
        exact hx
      let δ₀_et : W₁ ⟶ W₀ := N.δ (0 : Fin 2)
      let δ₁_et : W₁ ⟶ W₀ := N.δ (1 : Fin 2)
      have hδ_eq : (𝒢.obj.map δ₀_et.op).hom x = (𝒢.obj.map δ₁_et.op).hom x := by
        have hx'' : ((𝒢.obj.map δ₀_et.op).hom + -(𝒢.obj.map δ₁_et.op).hom) x = 0 := by
          dsimp [AlgebraicTopology.AlternatingCofaceMapComplex.objD,
            CategoryTheory.CosimplicialObject.δ, X_cosimp,
            CategoryTheory.SimplicialObject.δ, δ₀_et, δ₁_et] at hx' ⊢
          simp only [Fin.sum_univ_two, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
            one_zsmul, neg_one_zsmul, AddCommGrpCat.hom_add, AddCommGrpCat.hom_neg] at hx'
          exact hx'
        rw [AddMonoidHom.add_apply, AddMonoidHom.neg_apply, add_neg_eq_zero] at hx''
        exact hx''
      have hδ₁_π₀ : δ₁_et ≫ π₀ = CategoryTheory.Limits.WidePullback.π (fun _ : Fin 2 => f) 0 := by
        change N.map (SimplexCategory.δ (1 : Fin 2)).op ≫ _ = _
        rw [CategoryTheory.Arrow.cechNerve_map]
        exact CategoryTheory.Limits.WidePullback.lift_π _ _ _ _ 0
      have hδ₁_base : δ₁_et ≫ CategoryTheory.Limits.WidePullback.base (fun _ : Fin 1 => f) =
          CategoryTheory.Limits.WidePullback.base (fun _ : Fin 2 => f) := by
        change N.map (SimplexCategory.δ (1 : Fin 2)).op ≫ _ = _
        rw [CategoryTheory.Arrow.cechNerve_map]
        exact CategoryTheory.Limits.WidePullback.lift_base _ _ _ _
      have hδ₀_π₀ : δ₀_et ≫ π₀ = CategoryTheory.Limits.WidePullback.π (fun _ : Fin 2 => f) 1 := by
        change N.map (SimplexCategory.δ (0 : Fin 2)).op ≫ _ = _
        rw [CategoryTheory.Arrow.cechNerve_map]
        exact CategoryTheory.Limits.WidePullback.lift_π _ _ _ _ 0
      have hδ₀_base : δ₀_et ≫ CategoryTheory.Limits.WidePullback.base (fun _ : Fin 1 => f) =
          CategoryTheory.Limits.WidePullback.base (fun _ : Fin 2 => f) := by
        change N.map (SimplexCategory.δ (0 : Fin 2)).op ≫ _ = _
        rw [CategoryTheory.Arrow.cechNerve_map]
        exact CategoryTheory.Limits.WidePullback.lift_base _ _ _ _
      have hCompat : ∀ {Z : S.Etale} (p₁ p₂ : Z ⟶ W₀),
          p₁ ≫ aug₀' = p₂ ≫ aug₀' →
          (CategoryTheory.ConcreteCategory.hom (G_type.map p₁.op)) x =
            (CategoryTheory.ConcreteCategory.hom (G_type.map p₂.op)) x := by
        intro Z p₁ p₂ hp
        let q_map : Z ⟶ W₁ := CategoryTheory.Limits.WidePullback.lift
          (p₁ ≫ aug₀')
          (Fin.cases (p₁ ≫ π₀) (fun _ => p₂ ≫ π₀))
          (fun k => Fin.cases
            (by dsimp; rw [CategoryTheory.Category.assoc, h_π₀_f])
            (fun _ => by dsimp; rw [CategoryTheory.Category.assoc, h_π₀_f, hp.symm]) k)
        have hq1 : q_map ≫ δ₁_et = p₁ := by
          apply CategoryTheory.Limits.WidePullback.hom_ext
          · intro j
            rw [Subsingleton.elim j 0, CategoryTheory.Category.assoc, hδ₁_π₀]
            exact CategoryTheory.Limits.WidePullback.lift_π _ _ _ _ (0 : Fin 2)
          · rw [CategoryTheory.Category.assoc, hδ₁_base,
              CategoryTheory.Limits.WidePullback.lift_base, h_aug_eq]
        have hq0 : q_map ≫ δ₀_et = p₂ := by
          apply CategoryTheory.Limits.WidePullback.hom_ext
          · intro j
            rw [Subsingleton.elim j 0, CategoryTheory.Category.assoc, hδ₀_π₀]
            exact CategoryTheory.Limits.WidePullback.lift_π _ _ _ _ (1 : Fin 2)
          · rw [CategoryTheory.Category.assoc, hδ₀_base,
              CategoryTheory.Limits.WidePullback.lift_base, hp, h_aug_eq]
        change (𝒢.obj.map p₁.op).hom x = (𝒢.obj.map p₂.op).hom x
        rw [← hq1, ← hq0, op_comp, op_comp, CategoryTheory.Functor.map_comp,
          CategoryTheory.Functor.map_comp]
        change (𝒢.obj.map q_map.op).hom ((𝒢.obj.map δ₁_et.op).hom x) =
          (𝒢.obj.map q_map.op).hom ((𝒢.obj.map δ₀_et.op).hom x)
        rw [hδ_eq]
      obtain ⟨s, hs, _⟩ := hSheafAug x hCompat
      exact ⟨s, hs⟩

theorem weil_alt_cd_injective_sheaf_cech_exactAt (S : AlgebraicGeometry.Scheme.{u})
    (ℐ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
    [CategoryTheory.Injective ℐ]
    (f : CategoryTheory.Arrow S.Etale) (p : ℕ) (hp : 1 ≤ p) :
    (AlgebraicTopology.AlternatingCofaceMapComplex.obj
      (CategoryTheory.opOp SimplexCategory ⋙ f.cechNerve.op ⋙ ℐ.obj)).ExactAt p :=
by
  obtain ⟨q₀, rfl⟩ : ∃ q₀ : ℕ, p = q₀ + 1 := ⟨p - 1, (Nat.sub_add_cancel hp).symm⟩
  let P : (S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := ℐ.obj
  have : CategoryTheory.Injective
      ((CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj ℐ) :=
    CategoryTheory.Injective.injective_of_adjoint
      (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}) ℐ
  have : CategoryTheory.Injective P := ‹_›
  let N : CategoryTheory.SimplicialObject S.Etale := f.cechNerve

  have hObjExact : ∀ Z : S.Etale,
      (AlgebraicTopology.AlternatingFaceMapComplex.obj
        ((N ⋙ CategoryTheory.coyoneda.obj (Opposite.op Z)) ⋙
          AddCommGrpCat.free.{u})).ExactAt (q₀ + 1) := by
    intro Z
    let A : Type u := (Z ⟶ f.left)
    let I_Z : Type u := Set.range (fun g : A => g ≫ f.hom)
    let π_Z : A ⟶ I_Z := TypeCat.ofHom (fun g => ⟨g ≫ f.hom, ⟨g, rfl⟩⟩)
    let arr_Z : CategoryTheory.Arrow (Type u) := CategoryTheory.Arrow.mk π_Z
    have hSplit : CategoryTheory.SplitEpi arr_Z.hom :=
      { section_ := TypeCat.ofHom (fun y => y.2.choose)
        id := by
          ext y
          exact Subtype.ext y.2.choose_spec }
    let isoObj : ∀ X : SimplexCategoryᵒᵖ,
        (N ⋙ CategoryTheory.coyoneda.obj (Opposite.op Z)).obj X ≅ arr_Z.cechNerve.obj X :=
      fun X =>
        let J_X := Fin (X.unop.len + 1)
        let arr_f : J_X → (f.left ⟶ f.right) := fun _ => f.hom
        let arr_π : J_X → (A ⟶ I_Z) := fun _ => π_Z
        let L_X : Type u := (Z ⟶ Limits.widePullback f.right (fun _ : J_X => f.left) arr_f)
        let R_X : Type u := Limits.widePullback I_Z (fun _ : J_X => A) arr_π
        let fs_X : J_X → (L_X ⟶ A) :=
          fun j => TypeCat.ofHom (fun h => h ≫ Limits.WidePullback.π arr_f j)
        let base_X : L_X ⟶ I_Z := fs_X 0 ≫ π_Z
        have hcomm_X : ∀ j : J_X, fs_X j ≫ π_Z = base_X := by
          intro j
          ext h
          change (h ≫ Limits.WidePullback.π arr_f j) ≫ f.hom =
            (h ≫ Limits.WidePullback.π arr_f 0) ≫ f.hom
          rw [Category.assoc, Category.assoc, Limits.WidePullback.π_arrow,
            Limits.WidePullback.π_arrow]
        let φ_X : L_X ⟶ R_X := Limits.WidePullback.lift base_X fs_X hcomm_X
        let ψ_X : R_X ⟶ L_X := TypeCat.ofHom (fun w =>
          Limits.WidePullback.lift
            (ConcreteCategory.hom (Limits.WidePullback.base arr_π) w).1
            (fun j => ConcreteCategory.hom (Limits.WidePullback.π arr_π j) w)
            (fun j => by
              have hπ : ((ConcreteCategory.hom (Limits.WidePullback.π arr_π j ≫ arr_π j)) w).1 =
                  ((ConcreteCategory.hom (Limits.WidePullback.base arr_π)) w).1 :=
                congrArg Subtype.val
                  (CategoryTheory.congr_fun (Limits.WidePullback.π_arrow arr_π j) w)
              exact hπ))
        (show L_X ≅ R_X from
          { hom := φ_X
            inv := ψ_X
            hom_inv_id := by
              refine CategoryTheory.ConcreteCategory.ext_apply (fun h =>
                Limits.WidePullback.hom_ext arr_f _ _ (fun j => ?_) ?_)
              · change ConcreteCategory.hom ψ_X (ConcreteCategory.hom φ_X h) ≫
                    Limits.WidePullback.π arr_f j =
                  h ≫ Limits.WidePullback.π arr_f j
                dsimp only [ψ_X]
                rw [TypeCat.ofHom_apply, Limits.WidePullback.lift_π]
                exact CategoryTheory.congr_fun
                  (Limits.WidePullback.lift_π arr_π base_X fs_X hcomm_X j) h
              · change ConcreteCategory.hom ψ_X (ConcreteCategory.hom φ_X h) ≫
                    Limits.WidePullback.base arr_f =
                  h ≫ Limits.WidePullback.base arr_f
                dsimp only [ψ_X]
                rw [TypeCat.ofHom_apply, Limits.WidePullback.lift_base]
                have hb : ((ConcreteCategory.hom (φ_X ≫ Limits.WidePullback.base arr_π)) h).1 =
                    ((ConcreteCategory.hom base_X) h).1 :=
                  congrArg Subtype.val
                    (CategoryTheory.congr_fun
                      (Limits.WidePullback.lift_base arr_π base_X fs_X hcomm_X) h)
                exact hb.trans (by
                  change (h ≫ Limits.WidePullback.π arr_f 0) ≫ f.hom =
                    h ≫ Limits.WidePullback.base arr_f
                  rw [Category.assoc, Limits.WidePullback.π_arrow])
            inv_hom_id := by
              refine Limits.WidePullback.hom_ext arr_π _ _ (fun j => ?_) ?_
              · dsimp only [φ_X]
                rw [Category.assoc, Limits.WidePullback.lift_π, Category.id_comp]
                refine CategoryTheory.ConcreteCategory.ext_apply (fun w => ?_)
                change ConcreteCategory.hom ψ_X w ≫ Limits.WidePullback.π arr_f j =
                  ConcreteCategory.hom (Limits.WidePullback.π arr_π j) w
                dsimp only [ψ_X]
                rw [TypeCat.ofHom_apply, Limits.WidePullback.lift_π]
              · dsimp only [φ_X]
                rw [Category.assoc, Limits.WidePullback.lift_base, Category.id_comp]
                refine CategoryTheory.ConcreteCategory.ext_apply (fun w => Subtype.ext ?_)
                change (ConcreteCategory.hom ψ_X w ≫ Limits.WidePullback.π arr_f 0) ≫ f.hom =
                  (ConcreteCategory.hom (Limits.WidePullback.base arr_π) w).1
                dsimp only [ψ_X]
                rw [TypeCat.ofHom_apply, Limits.WidePullback.lift_π]
                have hπ0 : ((ConcreteCategory.hom (Limits.WidePullback.π arr_π 0 ≫ arr_π 0)) w).1 =
                    ((ConcreteCategory.hom (Limits.WidePullback.base arr_π)) w).1 :=
                  congrArg Subtype.val
                    (CategoryTheory.congr_fun (Limits.WidePullback.π_arrow arr_π 0) w)
                exact hπ0 })
    have hIsoNat : ∀ {X Y : SimplexCategoryᵒᵖ} (θ : X ⟶ Y),
        (N ⋙ CategoryTheory.coyoneda.obj (Opposite.op Z)).map θ ≫ (isoObj Y).hom =
          (isoObj X).hom ≫ arr_Z.cechNerve.map θ := by
      intro X Y θ
      let arr_πY : Fin (Y.unop.len + 1) → (A ⟶ I_Z) := fun _ => π_Z
      let arr_fX : Fin (X.unop.len + 1) → (f.left ⟶ f.right) := fun _ => f.hom
      let arr_fY : Fin (Y.unop.len + 1) → (f.left ⟶ f.right) := fun _ => f.hom
      refine Limits.WidePullback.hom_ext arr_πY _ _ (fun i => ?_) ?_
      · dsimp [isoObj, arr_Z]
        rw [Category.assoc, Limits.WidePullback.lift_π, Category.assoc,
          Arrow.cechNerve_map, Limits.WidePullback.lift_π, Limits.WidePullback.lift_π]
        ext h
        change (h ≫ f.cechNerve.map θ) ≫ Limits.WidePullback.π arr_fY i =
          h ≫ Limits.WidePullback.π arr_fX (θ.unop.toOrderHom i)
        rw [Category.assoc, Arrow.cechNerve_map, Limits.WidePullback.lift_π]
      · dsimp [isoObj, arr_Z]
        rw [Category.assoc, Limits.WidePullback.lift_base, Category.assoc,
          Arrow.cechNerve_map, Limits.WidePullback.lift_base, Limits.WidePullback.lift_base]
        ext h
        change ((h ≫ f.cechNerve.map θ) ≫ Limits.WidePullback.π arr_fY 0) ≫ f.hom =
          (h ≫ Limits.WidePullback.π arr_fX 0) ≫ f.hom
        rw [Category.assoc, Limits.WidePullback.π_arrow, Category.assoc,
          Arrow.cechNerve_map, Limits.WidePullback.lift_base,
          Category.assoc, Limits.WidePullback.π_arrow]
    let eSimp : N ⋙ CategoryTheory.coyoneda.obj (Opposite.op Z) ≅ arr_Z.cechNerve :=
      NatIso.ofComponents isoObj (fun θ => hIsoNat θ)
    let eChain := (AlgebraicTopology.alternatingFaceMapComplex AddCommGrpCat.{u}).mapIso
      (CategoryTheory.Functor.isoWhiskerRight eSimp AddCommGrpCat.free.{u})
    let ed := (CategoryTheory.Arrow.AugmentedCechNerve.extraDegeneracy arr_Z hSplit).map
      AddCommGrpCat.free.{u}
    let E_Z := (HomotopyEquiv.ofIso eChain).trans ed.homotopyEquiv
    let S₀ := (ChainComplex.single₀ AddCommGrpCat.{u}).obj
      (SimplicialObject.Augmented.point.obj
        (((SimplicialObject.Augmented.whiskering (Type u) AddCommGrpCat.{u}).obj
          AddCommGrpCat.free.{u}).obj arr_Z.augmentedCechNerve))
    have hZero_p : CategoryTheory.Limits.IsZero (S₀.X (q₀ + 1)) :=
      HomologicalComplex.isZero_single_obj_X (ComplexShape.down ℕ) 0 _ (q₀ + 1)
        (Nat.succ_ne_zero q₀)
    have hExact_S₀ : S₀.ExactAt (q₀ + 1) := by
      rw [HomologicalComplex.exactAt_iff' S₀ (q₀ + 2) (q₀ + 1) q₀ (by simp) (by simp)]
      exact CategoryTheory.ShortComplex.exact_of_isZero_X₂ _ hZero_p
    have : QuasiIsoAt E_Z.hom (q₀ + 1) := HomotopyEquiv.quasiIsoAt_hom E_Z (q₀ + 1)
    exact (exactAt_iff_of_quasiIsoAt E_Z.hom (q₀ + 1)).mpr hExact_S₀

  let L_free :=
    (CategoryTheory.Functor.whiskeringRight (S.Etale)ᵒᵖ (Type u) AddCommGrpCat.{u}).obj
      AddCommGrpCat.free.{u}
  let R_fgt :=
    (CategoryTheory.Functor.whiskeringRight (S.Etale)ᵒᵖ AddCommGrpCat.{u} (Type u)).obj
      (CategoryTheory.forget AddCommGrpCat.{u})
  let F_free : S.Etale ⥤ ((S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}) :=
    CategoryTheory.yoneda ⋙ L_free
  let K : ChainComplex ((S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}) ℕ :=
    AlgebraicTopology.AlternatingFaceMapComplex.obj (N ⋙ F_free)
  let SC : CategoryTheory.ShortComplex ((S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}) :=
    K.sc' (q₀ + 2) (q₀ + 1) q₀
  have hSC : SC.Exact := by
    have hZeroObj : ∀ Z : S.Etale,
        CategoryTheory.Limits.IsZero (SC.homology.obj (Opposite.op Z)) := by
      intro Z
      let ev_Z := (CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op Z)
      let mapK := (ev_Z.mapHomologicalComplex (ComplexShape.down ℕ)).obj K
      have heq_Z : mapK =
          AlgebraicTopology.AlternatingFaceMapComplex.obj
            ((N ⋙ CategoryTheory.coyoneda.obj (Opposite.op Z)) ⋙ AddCommGrpCat.free.{u}) :=
        congrArg (fun H => H.obj (N ⋙ F_free))
          (AlgebraicTopology.map_alternatingFaceMapComplex ev_Z)
      have hex_mapK : mapK.ExactAt (q₀ + 1) := by
        rw [heq_Z]
        exact hObjExact Z
      rw [HomologicalComplex.exactAt_iff' _ (q₀ + 2) (q₀ + 1) q₀ (by simp) (by simp)] at hex_mapK
      have hf_eq : mapK.d (q₀ + 2) (q₀ + 1) = ev_Z.map (K.d (q₀ + 2) (q₀ + 1)) :=
        Functor.mapHomologicalComplex_obj_d ev_Z (ComplexShape.down ℕ) K (q₀ + 2) (q₀ + 1)
      have hg_eq : mapK.d (q₀ + 1) q₀ = ev_Z.map (K.d (q₀ + 1) q₀) :=
        Functor.mapHomologicalComplex_obj_d ev_Z (ComplexShape.down ℕ) K (q₀ + 1) q₀
      let e_sc : SC.map ev_Z ≅ mapK.sc' (q₀ + 2) (q₀ + 1) q₀ :=
        CategoryTheory.ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _)
          ((Category.id_comp (mapK.d (q₀ + 2) (q₀ + 1))).trans
            (hf_eq.trans (Category.comp_id (ev_Z.map (K.d (q₀ + 2) (q₀ + 1)))).symm))
          ((Category.id_comp (mapK.d (q₀ + 1) q₀)).trans
            (hg_eq.trans (Category.comp_id (ev_Z.map (K.d (q₀ + 1) q₀))).symm))
      have hex_evSC : (SC.map ev_Z).Exact :=
        (CategoryTheory.ShortComplex.exact_iff_of_iso e_sc).mpr hex_mapK
      have hZero_mapH : CategoryTheory.Limits.IsZero (SC.map ev_Z).homology :=
        (CategoryTheory.ShortComplex.exact_iff_isZero_homology (SC.map ev_Z)).mp hex_evSC
      exact CategoryTheory.Limits.IsZero.of_iso hZero_mapH
        (CategoryTheory.ShortComplex.mapHomologyIso SC ev_Z).symm
    have hIdZero : 𝟙 SC.homology = 0 := by
      ext W_op : 2
      exact (CategoryTheory.Limits.IsZero.iff_id_eq_zero _).mp (hZeroObj W_op.unop)
    exact (CategoryTheory.ShortComplex.exact_iff_isZero_homology SC).mpr
      ((CategoryTheory.Limits.IsZero.iff_id_eq_zero SC.homology).mpr hIdZero)

  let adj_psh : L_free ⊣ R_fgt := AddCommGrpCat.adj.whiskerRight (S.Etale)ᵒᵖ
  let e_yon : ∀ X : S.Etale, (F_free.obj X ⟶ P) ≃ ↥(P.obj (Opposite.op X)) :=
    fun X => (adj_psh.homEquiv (CategoryTheory.yoneda.obj X) P).trans CategoryTheory.yonedaEquiv
  let ι₀ : ∀ X : S.Etale, ↥((F_free.obj X).obj (Opposite.op X)) :=
    fun X => ConcreteCategory.hom
      ((adj_psh.unit.app (CategoryTheory.yoneda.obj X)).app (Opposite.op X)) (𝟙 X)
  have he_yon_apply : ∀ (X : S.Etale) (η : F_free.obj X ⟶ P),
      e_yon X η = (η.app (Opposite.op X)).hom (ι₀ X) := by
    intro X η
    dsimp [e_yon]
    rw [CategoryTheory.yonedaEquiv_apply, CategoryTheory.Adjunction.homEquiv_unit]
    rfl
  let Φ : ∀ X : S.Etale, (F_free.obj X ⟶ P) ≃+ ↥(P.obj (Opposite.op X)) :=
    fun X =>
      { toEquiv := e_yon X
        map_add' := fun η₁ η₂ => by
          change e_yon X (η₁ + η₂) = e_yon X η₁ + e_yon X η₂
          rw [he_yon_apply, he_yon_apply, he_yon_apply]
          simp only [CategoryTheory.NatTrans.app_add, AddCommGrpCat.hom_add,
            AddMonoidHom.add_apply] }
  have hΦ_nat : ∀ {X Y : S.Etale} (g : X ⟶ Y) (η : F_free.obj Y ⟶ P),
      Φ X (F_free.map g ≫ η) = (P.map g.op).hom (Φ Y η) := by
    intro X Y g η
    change CategoryTheory.yonedaEquiv
        ((adj_psh.homEquiv (CategoryTheory.yoneda.obj X) P)
          (L_free.map (CategoryTheory.yoneda.map g) ≫ η)) =
      (ConcreteCategory.hom ((R_fgt.obj P).map g.op))
        (CategoryTheory.yonedaEquiv ((adj_psh.homEquiv (CategoryTheory.yoneda.obj Y) P) η))
    rw [CategoryTheory.Adjunction.homEquiv_naturality_left,
      ← CategoryTheory.yonedaEquiv_naturality]

  let Y_cosimp : CategoryTheory.CosimplicialObject AddCommGrpCat.{u} :=
    CategoryTheory.opOp SimplexCategory ⋙ N.op ⋙ P
  let C_P : CochainComplex AddCommGrpCat.{u} ℕ :=
    AlgebraicTopology.AlternatingCofaceMapComplex.obj Y_cosimp
  let X_lvl : ℕ → S.Etale := fun m => N.obj (Opposite.op (SimplexCategory.mk m))
  let evalAt : ∀ {M₁ M₂ : AddCommGrpCat.{u}}, ↥M₁ → (M₁ ⟶ M₂) →+ ↥M₂ :=
    fun v =>
      { toFun := fun φ => φ.hom v
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
  have hInter : ∀ (n : ℕ) (η : K.X n ⟶ P),
      Φ (X_lvl (n + 1)) (K.d (n + 1) n ≫ η) =
        (C_P.d n (n + 1)).hom (Φ (X_lvl n) η) := by
    intro n η
    have hLHS : Φ (X_lvl (n + 1)) (K.d (n + 1) n ≫ η) =
        ∑ i : Fin (n + 2), (-1 : ℤ) ^ (i : ℕ) •
          (P.map (N.δ i).op).hom (Φ (X_lvl n) η) := by
      have hd_K : K.d (n + 1) n =
          ∑ i : Fin (n + 2), (-1 : ℤ) ^ (i : ℕ) • F_free.map (N.δ i) :=
        AlgebraicTopology.AlternatingFaceMapComplex.obj_d_eq (N ⋙ F_free) n
      rw [hd_K, CategoryTheory.Preadditive.sum_comp, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [CategoryTheory.Preadditive.zsmul_comp, map_zsmul, hΦ_nat (N.δ i) η]
    have hRHS1 : (C_P.d n (n + 1)).hom (Φ (X_lvl n) η) =
        evalAt (Φ (X_lvl n) η)
          (∑ i : Fin (n + 2), (-1 : ℤ) ^ (i : ℕ) • Y_cosimp.δ i) := by
      dsimp [C_P, AlgebraicTopology.AlternatingCofaceMapComplex.obj]
      rw [CochainComplex.of_d]
      rfl
    have hRHS2 : evalAt (Φ (X_lvl n) η)
          (∑ i : Fin (n + 2), (-1 : ℤ) ^ (i : ℕ) • Y_cosimp.δ i) =
        ∑ i : Fin (n + 2), (-1 : ℤ) ^ (i : ℕ) •
          (Y_cosimp.δ i).hom (Φ (X_lvl n) η) := by
      rw [map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_zsmul]
      rfl
    exact hLHS.trans (hRHS1.trans hRHS2).symm

  change C_P.ExactAt (q₀ + 1)
  rw [HomologicalComplex.exactAt_iff' C_P q₀ (q₀ + 1) (q₀ + 2) (by simp) (by simp)]
  rw [CategoryTheory.ShortComplex.ab_exact_iff_function_exact]
  intro x
  constructor
  · intro hx
    let x₂ : ↥(C_P.X (q₀ + 1)) := x
    let α : K.X (q₀ + 1) ⟶ P := (Φ (X_lvl (q₀ + 1))).symm x₂
    have hα_apply : Φ (X_lvl (q₀ + 1)) α = x₂ :=
      (Φ (X_lvl (q₀ + 1))).apply_symm_apply x₂
    have hα_d : K.d (q₀ + 2) (q₀ + 1) ≫ α = 0 := by
      apply (Φ (X_lvl (q₀ + 2))).injective
      rw [map_zero, hInter (q₀ + 1) α, hα_apply]
      exact hx
    have hα_cocycle : SC.f ≫ α = 0 := hα_d
    let β : K.X q₀ ⟶ P := hSC.descToInjective α hα_cocycle
    have hβ : K.d (q₀ + 1) q₀ ≫ β = α := hSC.comp_descToInjective α hα_cocycle
    refine ⟨Φ (X_lvl q₀) β, ?_⟩
    change (C_P.d q₀ (q₀ + 1)).hom (Φ (X_lvl q₀) β) = x₂
    rw [← hInter q₀ β, hβ, hα_apply]
  · rintro ⟨y, rfl⟩
    exact CategoryTheory.ConcreteCategory.congr_hom
      (C_P.d_comp_d q₀ (q₀ + 1) (q₀ + 2)) y

theorem weil_alt_cd_cartan_cech_acyclicity_sheaf_cohomology_vanishing (S : AlgebraicGeometry.Scheme.{u}) [CompactSpace ↥S] [S.IsSeparated]
    (hCover : ∀ (U : S.Etale) [CompactSpace ↥U.left] [U.left.IsSeparated],
      (∀ (ℐ 𝒬 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
          (π : ℐ ⟶ 𝒬) [CategoryTheory.Epi π]
          (q₀ : ↥(𝒬.obj.obj (Opposite.op U))),
        ∃ (W : S.Etale) (_ : AlgebraicGeometry.IsAffine W.left) (f : W ⟶ U)
          (x₀ : ↥(ℐ.obj.obj (Opposite.op ((CategoryTheory.Arrow.mk f).cechNerve.obj
            (Opposite.op (SimplexCategory.mk 0)))))),
          CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton f) ∈
            S.smallEtaleTopology U ∧
          (π.hom.app (Opposite.op ((CategoryTheory.Arrow.mk f).cechNerve.obj
            (Opposite.op (SimplexCategory.mk 0))))).hom x₀ =
            (𝒬.obj.map (((CategoryTheory.Arrow.mk f).augmentedCechNerve.hom.app
              (Opposite.op (SimplexCategory.mk 0)))).op).hom q₀) ∧
      (∀ (W : S.Etale) [AlgebraicGeometry.IsAffine W.left] (f : W ⟶ U) (n : ℕ),
        CompactSpace ↥((CategoryTheory.Arrow.mk f).cechNerve.obj
          (Opposite.op (SimplexCategory.mk n))).left ∧
        ((CategoryTheory.Arrow.mk f).cechNerve.obj
          (Opposite.op (SimplexCategory.mk n))).left.IsSeparated) ∧
      (∀ (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
          (W : S.Etale) (f : W ⟶ U),
        CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton f) ∈
          S.smallEtaleTopology U →
        let C_𝒢 := AlgebraicTopology.AlternatingCofaceMapComplex.obj
          (CategoryTheory.opOp SimplexCategory ⋙ (CategoryTheory.Arrow.mk f).cechNerve.op ⋙ 𝒢.obj)
        let aug₀ := (CategoryTheory.Arrow.mk f).augmentedCechNerve.hom.app
          (Opposite.op (SimplexCategory.mk 0))
        Function.Injective (𝒢.obj.map aug₀.op).hom ∧
        ∀ x : ↥(C_𝒢.X 0), (C_𝒢.d 0 1).hom x = 0 →
          ∃ s : ↥(𝒢.obj.obj (Opposite.op U)), (𝒢.obj.map aug₀.op).hom s = x))
    (hInjCech : ∀ (ℐ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        [CategoryTheory.Injective ℐ]
        (f : CategoryTheory.Arrow S.Etale) (p : ℕ), 1 ≤ p →
      (AlgebraicTopology.AlternatingCofaceMapComplex.obj
        (CategoryTheory.opOp SimplexCategory ⋙ f.cechNerve.op ⋙ ℐ.obj)).ExactAt p)
    (𝒥 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
    (hCech : ∀ (U : S.Etale) [CompactSpace ↥U.left] [U.left.IsSeparated]
        (W : S.Etale) [AlgebraicGeometry.IsAffine W.left] (f : W ⟶ U),
      CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton f) ∈
        S.smallEtaleTopology U →
      ∀ (p : ℕ), 1 ≤ p →
        (AlgebraicTopology.AlternatingCofaceMapComplex.obj
          (CategoryTheory.opOp SimplexCategory ⋙ (CategoryTheory.Arrow.mk f).cechNerve.op ⋙ 𝒥.obj)).ExactAt p)
    (r : ℕ) (hr : 1 ≤ r) :
    Subsingleton (𝒥.H r) :=
by
  let J := S.smallEtaleTopology
  let ℤ_u : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let eℤ : ∀ (A : AddCommGrpCat.{u}), (ℤ_u ⟶ A) ≃ ↥A := fun A =>
    { toFun := fun u => u.hom (ULift.up (1 : ℤ))
      invFun := fun a => AddCommGrpCat.ofHom
        { toFun := fun m => m.down • a
          map_zero' := zero_zsmul a
          map_add' := fun m₁ m₂ => add_zsmul a m₁.down m₂.down }
      left_inv := fun u => by
        ext m
        have hm : m = m.down • ULift.up (1 : ℤ) := by ext; simp
        change m.down • u.hom (ULift.up (1 : ℤ)) = u.hom m
        conv_rhs => rw [hm]
        exact (map_zsmul u.hom m.down (ULift.up (1 : ℤ))).symm
      right_inv := fun a => by
        change (1 : ℤ) • a = a
        exact one_zsmul a }
  have hFreeNat : ∀ (V : S.Etale) {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (g : CategoryTheory.Sheaf.freeYoneda J V ℤ_u ⟶ 𝒢₁) (φ : 𝒢₁ ⟶ 𝒢₂),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (g ≫ φ) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv g ≫ φ.hom.app (Opposite.op V) := by
    intro V 𝒢₁ 𝒢₂ g φ
    let adj_s := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let P_V := CategoryTheory.Presheaf.freeYoneda V ℤ_u
    have h1 : (adj_s.homEquiv P_V 𝒢₂) (g ≫ φ) = (adj_s.homEquiv P_V 𝒢₁) g ≫ φ.hom :=
      adj_s.homEquiv_naturality_right g φ
    exact (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv h1).trans
      (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _)
  let evalExt₀ : ∀ (V : S.Etale) (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
      CategoryTheory.Abelian.Ext.{u} (CategoryTheory.Sheaf.freeYoneda J V ℤ_u) 𝒢 0 ≃
        ↥(𝒢.obj.obj (Opposite.op V)) :=
    fun V 𝒢 =>
      CategoryTheory.Abelian.Ext.homEquiv₀.trans
        (CategoryTheory.Sheaf.freeYonedaHomEquiv.trans (eℤ (𝒢.obj.obj (Opposite.op V))))
  have hEvalNat : ∀ (V : S.Etale) {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (φ : 𝒢₁ ⟶ 𝒢₂)
      (x : CategoryTheory.Abelian.Ext.{u} (CategoryTheory.Sheaf.freeYoneda J V ℤ_u) 𝒢₁ 0),
      evalExt₀ V 𝒢₂ (x.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)) =
        (φ.hom.app (Opposite.op V)).hom (evalExt₀ V 𝒢₁ x) := by
    intro V 𝒢₁ 𝒢₂ φ x
    let g : CategoryTheory.Sheaf.freeYoneda J V ℤ_u ⟶ 𝒢₁ :=
      CategoryTheory.Abelian.Ext.homEquiv₀ x
    have hg : CategoryTheory.Abelian.Ext.mk₀ g = x :=
      CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply x
    have hcomp : x.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0) =
        CategoryTheory.Abelian.Ext.mk₀ (g ≫ φ) := by
      rw [← hg, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    have hhom : CategoryTheory.Abelian.Ext.homEquiv₀
        (x.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)) = g ≫ φ := by
      rw [hcomp, ← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply, Equiv.apply_symm_apply]
    dsimp [evalExt₀]
    rw [hhom, hFreeNat V g φ]
    rfl
  have hEvalZero : ∀ (V : S.Etale) (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
      evalExt₀ V 𝒢 0 = 0 := by
    intro V 𝒢
    have h0 := hEvalNat V (0 : 𝒢 ⟶ 𝒢) 0
    rw [CategoryTheory.Abelian.Ext.zero_comp _ 0 _ 0 (Nat.add_zero 0)] at h0
    simpa using h0

  let CechHyp : CategoryTheory.Sheaf J AddCommGrpCat.{u} → Prop := fun 𝒢 =>
    ∀ (U : S.Etale) [CompactSpace ↥U.left] [U.left.IsSeparated]
      (W : S.Etale) [AlgebraicGeometry.IsAffine W.left] (f : W ⟶ U),
      CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton f) ∈ J U →
      ∀ (p : ℕ), 1 ≤ p →
        (AlgebraicTopology.AlternatingCofaceMapComplex.obj
          (CategoryTheory.opOp SimplexCategory ⋙
            (CategoryTheory.Arrow.mk f).cechNerve.op ⋙ 𝒢.obj)).ExactAt p

  have hStep : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
      CechHyp 𝒢 →
      ∃ (𝒬 : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        CechHyp 𝒬 ∧
        (∀ (V : S.Etale) [CompactSpace ↥V.left] [V.left.IsSeparated],
          Subsingleton (CategoryTheory.Abelian.Ext.{u}
            (CategoryTheory.Sheaf.freeYoneda J V ℤ_u) 𝒢 1)) ∧
        (∀ (U : S.Etale) (m' : ℕ),
          Subsingleton (CategoryTheory.Abelian.Ext.{u}
            (CategoryTheory.Sheaf.freeYoneda J U ℤ_u) 𝒬 (m' + 1)) →
          Subsingleton (CategoryTheory.Abelian.Ext.{u}
            (CategoryTheory.Sheaf.freeYoneda J U ℤ_u) 𝒢 (m' + 2))) := by
    intro 𝒢 hCech𝒢
    let ℐ : CategoryTheory.Sheaf J AddCommGrpCat.{u} := CategoryTheory.Injective.under 𝒢
    let ι : 𝒢 ⟶ ℐ := CategoryTheory.Injective.ι 𝒢
    let 𝒬 : CategoryTheory.Sheaf J AddCommGrpCat.{u} := CategoryTheory.Limits.cokernel ι
    let π : ℐ ⟶ 𝒬 := CategoryTheory.Limits.cokernel.π ι
    have h0 : ι ≫ π = 0 := CategoryTheory.Limits.cokernel.condition ι
    have hSES : (CategoryTheory.ShortComplex.mk ι π h0).ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel ι) inferInstance inferInstance

    have hLocInj : ∀ (V : S.Etale), Function.Injective (ι.hom.app (Opposite.op V)).hom := by
      intro V
      have hMonoP : CategoryTheory.Mono ((CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map ι) :=
        CategoryTheory.Functor.map_mono (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}) ι
      have hMonoV : CategoryTheory.Mono
          (((CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op V)).map
            ((CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map ι)) :=
        CategoryTheory.Functor.map_mono _ _
      exact (AddCommGrpCat.mono_iff_injective (ι.hom.app (Opposite.op V))).mp hMonoV

    have hLocKer : ∀ (V : S.Etale) (x : ↥(ℐ.obj.obj (Opposite.op V))),
        (π.hom.app (Opposite.op V)).hom x = 0 ↔
          ∃ y : ↥(𝒢.obj.obj (Opposite.op V)), (ι.hom.app (Opposite.op V)).hom y = x := by
      intro V x
      constructor
      · intro hx
        let ℤ_V := CategoryTheory.Sheaf.freeYoneda J V ℤ_u
        let x₀ : CategoryTheory.Abelian.Ext.{u} ℤ_V ℐ 0 := (evalExt₀ V ℐ).symm x
        have hx₀_π : x₀.comp (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero 0) = 0 := by
          apply (evalExt₀ V 𝒬).injective
          rw [hEvalNat V π x₀, (evalExt₀ V ℐ).apply_symm_apply, hx, hEvalZero V 𝒬]
        obtain ⟨y₀, hy₀⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ ℤ_V hSES x₀ hx₀_π
        refine ⟨evalExt₀ V 𝒢 y₀, ?_⟩
        rw [← hEvalNat V ι y₀, hy₀, (evalExt₀ V ℐ).apply_symm_apply]
      · rintro ⟨y, rfl⟩
        change ((ι ≫ π).hom.app (Opposite.op V)).hom y = 0
        rw [h0]
        simp

    have hSurj_all : ∀ (V : S.Etale) [CompactSpace ↥V.left] [V.left.IsSeparated],
        Function.Surjective (π.hom.app (Opposite.op V)).hom := by
      intro V _ _ q₀
      obtain ⟨W, hAffW, f, x₀, hf, hx₀⟩ := (hCover V).1 ℐ 𝒬 π q₀
      have : AlgebraicGeometry.IsAffine W.left := hAffW
      let N := (CategoryTheory.Arrow.mk f).cechNerve
      let W₀ : S.Etale := N.obj (Opposite.op (SimplexCategory.mk 0))
      let W₁ : S.Etale := N.obj (Opposite.op (SimplexCategory.mk 1))
      let W₂ : S.Etale := N.obj (Opposite.op (SimplexCategory.mk 2))
      let N_cos := CategoryTheory.opOp SimplexCategory ⋙ N.op
      let aug := (CategoryTheory.Arrow.mk f).augmentedCechNerve
      let aug₀ : W₀ ⟶ V := aug.hom.app (Opposite.op (SimplexCategory.mk 0))
      let aug₁ : W₁ ⟶ V := aug.hom.app (Opposite.op (SimplexCategory.mk 1))
      let C_obj : CategoryTheory.Sheaf J AddCommGrpCat.{u} → CochainComplex AddCommGrpCat.{u} ℕ :=
        fun ℱ => AlgebraicTopology.AlternatingCofaceMapComplex.obj (N_cos ⋙ ℱ.obj)
      let C_map : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}},
          (ℱ₁ ⟶ ℱ₂) → (C_obj ℱ₁ ⟶ C_obj ℱ₂) :=
        fun α => AlgebraicTopology.AlternatingCofaceMapComplex.map
          (CategoryTheory.Functor.whiskerLeft N_cos α.hom)
      have hAugCocycle : ((C_obj 𝒬).d 0 1).hom ((𝒬.obj.map aug₀.op).hom q₀) = 0 := by
        have hδ_eq : ∀ i : Fin 2,
            (CosimplicialObject.δ (N_cos ⋙ 𝒬.obj) i).hom ((𝒬.obj.map aug₀.op).hom q₀) =
              (𝒬.obj.map aug₁.op).hom q₀ := by
          intro i
          let d_i : W₁ ⟶ W₀ := N.map (@SimplexCategory.δ 0 i).op
          have hnat' : d_i ≫ aug₀ = aug₁ := by
            have hnat := aug.hom.naturality (@SimplexCategory.δ 0 i).op
            dsimp [d_i, W₀, W₁, N, aug₀, aug₁, aug] at hnat ⊢
            exact hnat.trans (CategoryTheory.Category.comp_id _)
          have hmap : 𝒬.obj.map aug₀.op ≫ CosimplicialObject.δ (N_cos ⋙ 𝒬.obj) i =
              𝒬.obj.map aug₁.op := by
            change 𝒬.obj.map aug₀.op ≫ 𝒬.obj.map d_i.op = 𝒬.obj.map aug₁.op
            rw [← 𝒬.obj.map_comp, ← CategoryTheory.op_comp, hnat']
          exact CategoryTheory.ConcreteCategory.congr_hom hmap q₀
        have hd01 : (C_obj 𝒬).d 0 1 =
            AlgebraicTopology.AlternatingCofaceMapComplex.objD (N_cos ⋙ 𝒬.obj) 0 := by
          dsimp [C_obj, AlgebraicTopology.AlternatingCofaceMapComplex.obj]
          exact CochainComplex.of_d _ _ 0
        rw [hd01]
        dsimp [AlgebraicTopology.AlternatingCofaceMapComplex.objD]
        rw [Fin.sum_univ_two]
        simp only [Fin.val_zero, pow_zero, one_zsmul, Fin.val_one, pow_one, neg_one_zsmul]
        change (CosimplicialObject.δ (N_cos ⋙ 𝒬.obj) 0).hom ((𝒬.obj.map aug₀.op).hom q₀) +
            -(CosimplicialObject.δ (N_cos ⋙ 𝒬.obj) 1).hom ((𝒬.obj.map aug₀.op).hom q₀) = 0
        rw [hδ_eq 0, hδ_eq 1, add_neg_cancel]
      let u₁ : ↥((C_obj ℐ).X 1) := ((C_obj ℐ).d 0 1).hom x₀
      have hu₁_π : ((C_map π).f 1).hom u₁ = 0 := by
        have hcomm := CategoryTheory.ConcreteCategory.congr_hom ((C_map π).comm 0 1) x₀
        have hcomm' : ((C_map π).f 1).hom u₁ =
            ((C_obj 𝒬).d 0 1).hom (((C_map π).f 0).hom x₀) := hcomm.symm
        rw [hcomm']
        change ((C_obj 𝒬).d 0 1).hom ((π.hom.app (Opposite.op W₀)).hom x₀) = 0
        rw [hx₀]
        exact hAugCocycle
      obtain ⟨z₁_raw, hz₁_raw⟩ := (hLocKer W₁ u₁).mp hu₁_π
      let z₁ : ↥((C_obj 𝒢).X 1) := z₁_raw
      have hz₁ : ((C_map ι).f 1).hom z₁ = u₁ := hz₁_raw
      have hz₁_cocycle : ((C_obj 𝒢).d 1 2).hom z₁ = 0 := by
        have hinj2 : Function.Injective (((C_map ι).f 2).hom) := hLocInj W₂
        apply hinj2
        rw [map_zero]
        have hcomm := CategoryTheory.ConcreteCategory.congr_hom ((C_map ι).comm 1 2) z₁
        have hcomm' : ((C_map ι).f 2).hom (((C_obj 𝒢).d 1 2).hom z₁) =
            ((C_obj ℐ).d 1 2).hom (((C_map ι).f 1).hom z₁) := hcomm.symm
        rw [hcomm', hz₁]
        exact CategoryTheory.ConcreteCategory.congr_hom ((C_obj ℐ).d_comp_d 0 1 2) x₀
      have hex₁ : (C_obj 𝒢).ExactAt 1 := hCech𝒢 V W f hf 1 le_rfl
      rw [HomologicalComplex.exactAt_iff' (C_obj 𝒢) 0 1 2 (by simp) (by simp),
        CategoryTheory.ShortComplex.ab_exact_iff_function_exact] at hex₁
      obtain ⟨y₀_raw, hy₀_raw⟩ := (hex₁ z₁).mp hz₁_cocycle
      let y₀ : ↥((C_obj 𝒢).X 0) := y₀_raw
      have hy₀ : ((C_obj 𝒢).d 0 1).hom y₀ = z₁ := hy₀_raw
      let x₀_c : ↥((C_obj ℐ).X 0) := x₀
      let x₀' : ↥((C_obj ℐ).X 0) := x₀_c - ((C_map ι).f 0).hom y₀
      have hx₀'_cocycle : ((C_obj ℐ).d 0 1).hom x₀' = 0 := by
        dsimp [x₀']
        rw [map_sub]
        have hcomm := CategoryTheory.ConcreteCategory.congr_hom ((C_map ι).comm 0 1) y₀
        have hcomm' : ((C_obj ℐ).d 0 1).hom (((C_map ι).f 0).hom y₀) =
            ((C_map ι).f 1).hom (((C_obj 𝒢).d 0 1).hom y₀) := hcomm
        rw [hcomm', hy₀, hz₁]
        exact sub_self u₁
      obtain ⟨s_glob, hs_glob⟩ := ((hCover V).2.2 ℐ W f hf).2 x₀' hx₀'_cocycle
      let x₀_w : ↥(ℐ.obj.obj (Opposite.op W₀)) := x₀
      let y₀_w : ↥(𝒢.obj.obj (Opposite.op W₀)) := y₀
      have hx₀_w : (π.hom.app (Opposite.op W₀)).hom x₀_w = (𝒬.obj.map aug₀.op).hom q₀ := hx₀
      have hs_glob_w : (ℐ.obj.map aug₀.op).hom s_glob =
          x₀_w - (ι.hom.app (Opposite.op W₀)).hom y₀_w := hs_glob
      have hιπ₀ : (π.hom.app (Opposite.op W₀)).hom ((ι.hom.app (Opposite.op W₀)).hom y₀_w) = 0 := by
        change ((ι ≫ π).hom.app (Opposite.op W₀)).hom y₀_w = 0
        rw [h0]
        simp
      refine ⟨s_glob, ?_⟩
      apply ((hCover V).2.2 𝒬 W f hf).1
      change (𝒬.obj.map aug₀.op).hom ((π.hom.app (Opposite.op V)).hom s_glob) =
        (𝒬.obj.map aug₀.op).hom q₀
      calc
        (𝒬.obj.map aug₀.op).hom ((π.hom.app (Opposite.op V)).hom s_glob)
          = (π.hom.app (Opposite.op W₀)).hom ((ℐ.obj.map aug₀.op).hom s_glob) :=
            (CategoryTheory.ConcreteCategory.congr_hom (π.hom.naturality aug₀.op) s_glob).symm
        _ = (π.hom.app (Opposite.op W₀)).hom (x₀_w - (ι.hom.app (Opposite.op W₀)).hom y₀_w) := by
            rw [hs_glob_w]
        _ = (π.hom.app (Opposite.op W₀)).hom x₀_w -
              (π.hom.app (Opposite.op W₀)).hom ((ι.hom.app (Opposite.op W₀)).hom y₀_w) :=
            map_sub (π.hom.app (Opposite.op W₀)).hom x₀_w ((ι.hom.app (Opposite.op W₀)).hom y₀_w)
        _ = (𝒬.obj.map aug₀.op).hom q₀ := by
            rw [hx₀_w, hιπ₀, sub_zero]

    refine ⟨𝒬, ?_, ?_, ?_⟩
    · intro U' _ _ W' _ f hf p hp
      let N' := (CategoryTheory.Arrow.mk f).cechNerve
      let N'_cos := CategoryTheory.opOp SimplexCategory ⋙ N'.op
      let C_obj : CategoryTheory.Sheaf J AddCommGrpCat.{u} → CochainComplex AddCommGrpCat.{u} ℕ :=
        fun ℱ => AlgebraicTopology.AlternatingCofaceMapComplex.obj (N'_cos ⋙ ℱ.obj)
      let F₁ : C_obj 𝒢 ⟶ C_obj ℐ :=
        AlgebraicTopology.AlternatingCofaceMapComplex.map
          (CategoryTheory.Functor.whiskerLeft N'_cos ι.hom)
      let F₂ : C_obj ℐ ⟶ C_obj 𝒬 :=
        AlgebraicTopology.AlternatingCofaceMapComplex.map
          (CategoryTheory.Functor.whiskerLeft N'_cos π.hom)
      have hF12 : F₁ ≫ F₂ = 0 := by
        apply HomologicalComplex.hom_ext
        intro n
        change (ι ≫ π).hom.app (Opposite.op (N'.obj (Opposite.op (SimplexCategory.mk n)))) = 0
        rw [h0]
        simp
      let S_cech := CategoryTheory.ShortComplex.mk F₁ F₂ hF12
      have hSE_cech : S_cech.ShortExact := by
        apply HomologicalComplex.shortExact_of_degreewise_shortExact
        intro n
        let W'_n := N'.obj (Opposite.op (SimplexCategory.mk n))
        obtain ⟨hComp_n, hSep_n⟩ := (hCover U').2.1 W' f n
        have : CompactSpace ↥W'_n.left := hComp_n
        have : W'_n.left.IsSeparated := hSep_n
        have hMono_n : CategoryTheory.Mono ((S_cech.map (HomologicalComplex.eval _ _ n)).f) :=
          (AddCommGrpCat.mono_iff_injective _).mpr (hLocInj W'_n)
        have hEpi_n : CategoryTheory.Epi ((S_cech.map (HomologicalComplex.eval _ _ n)).g) :=
          (AddCommGrpCat.epi_iff_surjective _).mpr (hSurj_all W'_n)
        have hEx_n : (S_cech.map (HomologicalComplex.eval _ _ n)).Exact := by
          rw [CategoryTheory.ShortComplex.ab_exact_iff_function_exact]
          exact hLocKer W'_n
        exact CategoryTheory.ShortComplex.ShortExact.mk' hEx_n hMono_n hEpi_n
      have hEx_hom :=
        CategoryTheory.ShortComplex.ShortExact.homology_exact₃ hSE_cech p (p + 1) (by simp)
      have hZ₁ : CategoryTheory.Limits.IsZero ((C_obj ℐ).homology p) :=
        HomologicalComplex.ExactAt.isZero_homology
          (hInjCech ℐ (CategoryTheory.Arrow.mk f) p hp)
      have hZ₃ : CategoryTheory.Limits.IsZero ((C_obj 𝒢).homology (p + 1)) :=
        HomologicalComplex.ExactAt.isZero_homology
          (hCech𝒢 U' W' f hf (p + 1) (by omega))
      have hZ₂ : CategoryTheory.Limits.IsZero ((C_obj 𝒬).homology p) :=
        CategoryTheory.ShortComplex.Exact.isZero_of_both_zeros hEx_hom
          (hZ₁.eq_of_src _ _) (hZ₃.eq_of_tgt _ _)
      exact (HomologicalComplex.exactAt_iff_isZero_homology (C_obj 𝒬) p).mpr hZ₂
    · intro V _ _
      let ℤ_V := CategoryTheory.Sheaf.freeYoneda J V ℤ_u
      refine subsingleton_of_forall_eq 0 (fun ξ => ?_)
      have hξ_ι : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero 1) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨q₀, hq₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ ℤ_V hSES ξ hξ_ι (Nat.zero_add 1)
      obtain ⟨s, hs⟩ := hSurj_all V (evalExt₀ V 𝒬 q₀)
      let s₀ : CategoryTheory.Abelian.Ext.{u} ℤ_V ℐ 0 := (evalExt₀ V ℐ).symm s
      have hs₀_π : s₀.comp (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero 0) = q₀ := by
        apply (evalExt₀ V 𝒬).injective
        rw [hEvalNat V π s₀, (evalExt₀ V ℐ).apply_symm_apply, hs]
      rw [← hq₀, ← hs₀_π,
        CategoryTheory.Abelian.Ext.comp_assoc s₀ (CategoryTheory.Abelian.Ext.mk₀ π)
          hSES.extClass (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
        hSES.comp_extClass,
        CategoryTheory.Abelian.Ext.comp_zero s₀ 𝒢 1 1 (Nat.zero_add 1)]
    · intro U m' hSub𝒬
      let ℤ_U := CategoryTheory.Sheaf.freeYoneda J U ℤ_u
      refine subsingleton_of_forall_eq 0 (fun ξ => ?_)
      have hξ_ι : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero (m' + 2)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨η, hη⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ ℤ_U hSES ξ hξ_ι rfl
      have hη₀ : η = 0 := @Subsingleton.elim _ hSub𝒬 η 0
      rw [← hη, hη₀]
      exact CategoryTheory.Abelian.Ext.zero_comp ℤ_U (m' + 1) hSES.extClass (m' + 2) rfl

  have hMain : ∀ (m : ℕ) (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
      CechHyp 𝒢 →
      ∀ (U : S.Etale) [CompactSpace ↥U.left] [U.left.IsSeparated],
        Subsingleton (CategoryTheory.Abelian.Ext.{u}
          (CategoryTheory.Sheaf.freeYoneda J U ℤ_u) 𝒢 (m + 1)) := by
    intro m
    induction m with
    | zero =>
      intro 𝒢 hCech𝒢 U _ _
      obtain ⟨_, _, hBase, _⟩ := hStep 𝒢 hCech𝒢
      exact hBase U
    | succ m' ih =>
      intro 𝒢 hCech𝒢 U _ _
      obtain ⟨𝒬, hCech𝒬, _, hShift⟩ := hStep 𝒢 hCech𝒢
      exact hShift U m' (ih 𝒬 hCech𝒬 U)

  let T_S : S.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 S)
      (inferInstance : AlgebraicGeometry.Etale (𝟙 S))
  have hT_S : CategoryTheory.Limits.IsTerminal T_S :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom (CategoryTheory.Category.comp_id U.hom))
      (fun U m => CategoryTheory.MorphismProperty.Over.Hom.ext (by
        have hw := CategoryTheory.MorphismProperty.Over.w m
        dsimp [T_S] at hw ⊢
        exact (CategoryTheory.Category.comp_id m.left).symm.trans hw))
  have hCompTS : CompactSpace ↥T_S.left := by change CompactSpace ↥S; infer_instance
  have hSepTS : T_S.left.IsSeparated := by change S.IsSeparated; infer_instance

  let F_ℤ : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
    (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj ℤ_u
  let ℤ_TS : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
    CategoryTheory.Sheaf.freeYoneda J T_S ℤ_u
  let adj_c := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S
  let α_hom : ℤ_TS ⟶ F_ℤ :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv.symm (adj_c.homEquiv ℤ_u F_ℤ (𝟙 F_ℤ))
  let α_inv : F_ℤ ⟶ ℤ_TS :=
    (adj_c.homEquiv ℤ_u ℤ_TS).symm (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 ℤ_TS))
  have hα_comp : α_inv ≫ α_hom = 𝟙 F_ℤ := by
    apply (adj_c.homEquiv ℤ_u F_ℤ).injective
    rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
    change adj_c.homEquiv ℤ_u ℤ_TS α_inv ≫ α_hom.hom.app (Opposite.op T_S) =
      adj_c.homEquiv ℤ_u F_ℤ (𝟙 F_ℤ)
    rw [(adj_c.homEquiv ℤ_u ℤ_TS).apply_symm_apply,
      ← hFreeNat T_S (𝟙 ℤ_TS) α_hom, CategoryTheory.Category.id_comp]
    exact CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _

  have hSubTS : Subsingleton (CategoryTheory.Abelian.Ext.{u} ℤ_TS 𝒥 r) := by
    have hm₀ : (r - 1) + 1 = r := Nat.sub_add_cancel hr
    rw [← hm₀]
    exact hMain (r - 1) 𝒥 hCech T_S

  change Subsingleton (CategoryTheory.Abelian.Ext.{u} F_ℤ 𝒥 r)
  refine subsingleton_of_forall_eq 0 (fun ξ => ?_)
  have hξ₀ : (CategoryTheory.Abelian.Ext.mk₀ α_hom).comp ξ (Nat.zero_add r) = 0 :=
    @Subsingleton.elim _ hSubTS _ 0
  calc
    ξ = (CategoryTheory.Abelian.Ext.mk₀ (𝟙 F_ℤ)).comp ξ (Nat.zero_add r) :=
      (CategoryTheory.Abelian.Ext.mk₀_id_comp ξ).symm
    _ = (CategoryTheory.Abelian.Ext.mk₀ (α_inv ≫ α_hom)).comp ξ (Nat.zero_add r) := by
      rw [hα_comp]
    _ = (CategoryTheory.Abelian.Ext.mk₀ α_inv).comp
          ((CategoryTheory.Abelian.Ext.mk₀ α_hom).comp ξ (Nat.zero_add r)) (Nat.zero_add r) :=
      (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc α_inv α_hom ξ).symm
    _ = (CategoryTheory.Abelian.Ext.mk₀ α_inv).comp 0 (Nat.zero_add r) := by
      rw [hξ₀]
    _ = 0 := CategoryTheory.Abelian.Ext.comp_zero _ _ r r (Nat.zero_add r)

theorem weil_alt_cd_grothendieck_filtered_colimit_H_vanishing (S : AlgebraicGeometry.Scheme.{u})
    (hH0Surj : ∀ (Idx₀ : Type u) [CategoryTheory.SmallCategory Idx₀] [CategoryTheory.IsFiltered Idx₀]
      (D₀ : CategoryTheory.Functor Idx₀
        (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}))
      (c₀ : CategoryTheory.Limits.Cocone D₀), CategoryTheory.Limits.IsColimit c₀ →
      ∀ ξ : c₀.pt.H 0, ∃ (j : Idx₀) (ξ_j : (D₀.obj j).H 0),
        ξ_j.comp (CategoryTheory.Abelian.Ext.mk₀ (c₀.ι.app j)) (Nat.add_zero 0) = ξ)
    (hInjColimAcyclic : ∀ (Idx₀ : Type u) [CategoryTheory.SmallCategory Idx₀] [CategoryTheory.IsFiltered Idx₀]
      (I_diag : CategoryTheory.Functor Idx₀
        (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})),
      (∀ j : Idx₀, CategoryTheory.Injective (I_diag.obj j)) →
      ∀ (c_I : CategoryTheory.Limits.Cocone I_diag), CategoryTheory.Limits.IsColimit c_I →
      ∀ (r : ℕ), 1 ≤ r → Subsingleton (c_I.pt.H r))
    (Idx : Type u) [CategoryTheory.SmallCategory Idx] [CategoryTheory.IsFiltered Idx]
    (D : CategoryTheory.Functor Idx
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}))
    (c : CategoryTheory.Limits.Cocone D) (hc : CategoryTheory.Limits.IsColimit c)
    (q : ℕ) (hVanish : ∀ j : Idx, Subsingleton ((D.obj j).H q)) :
    Subsingleton (c.pt.H q) :=
by
  have hExtClassNat : ∀ (C : Type (u + 1)) [CategoryTheory.Category.{u + 1, u + 1} C]
      [CategoryTheory.Abelian C] [CategoryTheory.HasExt.{u} C]
      {S₁ S₂ : CategoryTheory.ShortComplex C}
      (hS₁ : S₁.ShortExact) (hS₂ : S₂.ShortExact) (φ : S₁ ⟶ S₂),
      (CategoryTheory.Abelian.Ext.mk₀ φ.τ₃).comp hS₂.extClass (Nat.zero_add 1) =
        hS₁.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ φ.τ₁) (Nat.add_zero 1) := by
    clear hH0Surj hInjColimAcyclic D c hc q hVanish
    intro C _ _ _ S₁ S₂ hS₁ hS₂ φ
    letI : HasDerivedCategory C := HasDerivedCategory.standard C
    rw [CategoryTheory.Abelian.Ext.ext_iff,
      ← CategoryTheory.Abelian.Ext.singleFunctor_map_comp_hom,
      ← CategoryTheory.Abelian.Ext.hom_comp_singleFunctor_map_shift,
      CategoryTheory.ShortComplex.ShortExact.extClass_hom,
      CategoryTheory.ShortComplex.ShortExact.extClass_hom]
    let F₀ : CategoryTheory.Functor C (CochainComplex C ℤ) := CochainComplex.singleFunctor C 0
    let T₁ := S₁.map F₀
    let T₂ := S₂.map F₀
    have hT₁ : T₁.ShortExact := hS₁.map_of_exact F₀
    have hT₂ : T₂.ShortExact := hS₂.map_of_exact F₀
    let φ_C : T₁ ⟶ T₂ := CategoryTheory.ShortComplex.homMk
      (F₀.map φ.τ₁) (F₀.map φ.τ₂) (F₀.map φ.τ₃)
      (by dsimp [T₁, T₂]; rw [← F₀.map_comp, ← F₀.map_comp, φ.comm₁₂])
      (by dsimp [T₁, T₂]; rw [← F₀.map_comp, ← F₀.map_comp, φ.comm₂₃])
    let M_cone : CochainComplex.mappingCone.triangle T₁.f ⟶
        CochainComplex.mappingCone.triangle T₂.f :=
      CochainComplex.mappingCone.triangleMap T₁.f T₂.f φ_C.τ₁ φ_C.τ₂ φ_C.comm₁₂.symm
    let m_cone : CochainComplex.mappingCone T₁.f ⟶ CochainComplex.mappingCone T₂.f :=
      CochainComplex.mappingCone.map T₁.f T₂.f φ_C.τ₁ φ_C.τ₂ φ_C.comm₁₂.symm
    have h_cone_desc :
        CategoryTheory.CategoryStruct.comp m_cone
          (CochainComplex.mappingCone.descShortComplex T₂) =
        CategoryTheory.CategoryStruct.comp
          (CochainComplex.mappingCone.descShortComplex T₁) φ_C.τ₃ := by
      ext j
      rw [CochainComplex.mappingCone.ext_from_iff T₁.f (j + 1) j (by omega)]
      constructor
      · simp only [HomologicalComplex.comp_f, ← CategoryTheory.Category.assoc,
          CochainComplex.mappingCone.inl_v_descShortComplex_f, CategoryTheory.Limits.zero_comp]
        have hinl :
            CategoryTheory.CategoryStruct.comp
              ((CochainComplex.mappingCone.inl T₁.f).v (j + 1) j (by omega)) (m_cone.f j) =
            CategoryTheory.CategoryStruct.comp
              (φ_C.τ₁.f (j + 1)) ((CochainComplex.mappingCone.inl T₂.f).v (j + 1) j (by omega)) := by
          rw [CochainComplex.mappingCone.ext_to_iff T₂.f j (j + 1) (by omega)]
          constructor
          · simp [m_cone, CochainComplex.mappingCone.map_eq_mapOfHomotopy,
              CochainComplex.mappingCone.mapOfHomotopy]
          · simp [m_cone, CochainComplex.mappingCone.map_eq_mapOfHomotopy,
              CochainComplex.mappingCone.mapOfHomotopy]
        rw [hinl, CategoryTheory.Category.assoc,
          CochainComplex.mappingCone.inl_v_descShortComplex_f, CategoryTheory.Limits.comp_zero]
      · have hinr : CategoryTheory.CategoryStruct.comp
            (CochainComplex.mappingCone.inr T₁.f) m_cone =
            CategoryTheory.CategoryStruct.comp φ_C.τ₂ (CochainComplex.mappingCone.inr T₂.f) := by
          have hc₂ := M_cone.comm₂
          rw [CochainComplex.mappingCone.triangle_mor₂,
            CochainComplex.mappingCone.triangle_mor₂,
            CochainComplex.mappingCone.triangleMap_hom₂,
            CochainComplex.mappingCone.triangleMap_hom₃] at hc₂
          exact hc₂
        have h_eq : CategoryTheory.CategoryStruct.comp (CochainComplex.mappingCone.inr T₁.f)
            (CategoryTheory.CategoryStruct.comp m_cone
              (CochainComplex.mappingCone.descShortComplex T₂)) =
          CategoryTheory.CategoryStruct.comp (CochainComplex.mappingCone.inr T₁.f)
            (CategoryTheory.CategoryStruct.comp
              (CochainComplex.mappingCone.descShortComplex T₁) φ_C.τ₃) := by
          rw [← CategoryTheory.Category.assoc, hinr, CategoryTheory.Category.assoc,
            CochainComplex.mappingCone.inr_descShortComplex,
            ← CategoryTheory.Category.assoc,
            CochainComplex.mappingCone.inr_descShortComplex,
            φ_C.comm₂₃]
        exact HomologicalComplex.congr_hom h_eq j
    let Ψ : hS₁.singleTriangle ⟶ hS₂.singleTriangle :=
      CategoryTheory.CategoryStruct.comp hS₁.singleTriangleIso.hom
        (CategoryTheory.CategoryStruct.comp (DerivedCategory.triangleOfSESIso hT₁).hom
          (CategoryTheory.CategoryStruct.comp (DerivedCategory.Q.mapTriangle.map M_cone)
            (CategoryTheory.CategoryStruct.comp (DerivedCategory.triangleOfSESIso hT₂).inv
              hS₂.singleTriangleIso.inv)))
    have hΨ₁ : Ψ.hom₁ = (DerivedCategory.singleFunctor C 0).map φ.τ₁ := by
      simp [Ψ, M_cone, φ_C, F₀, DerivedCategory.triangleOfSESIso]
      rfl
    have hΨ₃ : Ψ.hom₃ = (DerivedCategory.singleFunctor C 0).map φ.τ₃ := by
      have hQ_desc : CategoryTheory.CategoryStruct.comp (DerivedCategory.Q.map m_cone)
          (DerivedCategory.Q.map (CochainComplex.mappingCone.descShortComplex T₂)) =
        CategoryTheory.CategoryStruct.comp
          (DerivedCategory.Q.map (CochainComplex.mappingCone.descShortComplex T₁))
          (DerivedCategory.Q.map φ_C.τ₃) := by
        rw [← DerivedCategory.Q.map_comp, ← DerivedCategory.Q.map_comp, h_cone_desc]
      have : QuasiIso (CochainComplex.mappingCone.descShortComplex T₁) :=
        CochainComplex.mappingCone.quasiIso_descShortComplex hT₁
      have : CategoryTheory.IsIso
          (DerivedCategory.Q.map (CochainComplex.mappingCone.descShortComplex T₁)) :=
        (DerivedCategory.isIso_Q_map_iff_quasiIso C _).mpr this
      simp [Ψ, M_cone, φ_C, F₀, DerivedCategory.triangleOfSESIso]
      change CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.id (DerivedCategory.Q.obj T₁.X₃))
        (CategoryTheory.CategoryStruct.comp
          (CategoryTheory.inv (DerivedCategory.Q.map (CochainComplex.mappingCone.descShortComplex T₁)))
          (CategoryTheory.CategoryStruct.comp (DerivedCategory.Q.map m_cone)
            (CategoryTheory.CategoryStruct.comp
              (DerivedCategory.Q.map (CochainComplex.mappingCone.descShortComplex T₂))
              (CategoryTheory.CategoryStruct.id (DerivedCategory.Q.obj T₂.X₃))))) =
        (DerivedCategory.singleFunctor C 0).map φ.τ₃
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id,
        hQ_desc, ← CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
        CategoryTheory.Category.id_comp]
      rfl
    have hcomm₃ := (CategoryTheory.Pretriangulated.TriangleMorphism.comm₃ Ψ).symm
    rwa [hS₁.singleTriangle_mor₃, hS₂.singleTriangle_mor₃, hΨ₁, hΨ₃] at hcomm₃
  have hFuncInj : ∀ (C : Type (u + 1)) [CategoryTheory.Category.{u + 1, u + 1} C]
      [CategoryTheory.Abelian C] [CategoryTheory.IsGrothendieckAbelian.{u} C],
      ∃ (J_inj Q_coker : CategoryTheory.Functor C C)
        (ι_inj : CategoryTheory.Functor.id C ⟶ J_inj)
        (π_coker : J_inj ⟶ Q_coker)
        (hzero : ∀ X : C, CategoryTheory.CategoryStruct.comp (ι_inj.app X) (π_coker.app X) = 0),
        (∀ X : C, CategoryTheory.Injective (J_inj.obj X)) ∧
        (∀ X : C,
          (CategoryTheory.ShortComplex.mk (ι_inj.app X) (π_coker.app X) (hzero X)).ShortExact) := by
    clear hH0Surj hInjColimAcyclic D c hc q hVanish hExtClassNat
    intro C _ _ _
    obtain ⟨Z₀, hZ₀⟩ := @CategoryTheory.Limits.HasZeroObject.zero C _ inferInstance
    let W₁ := CategoryTheory.MorphismProperty.monomorphisms C
    let FFD := CategoryTheory.MorphismProperty.functorialFactorizationData W₁ W₁.rlp
    let toZero : CategoryTheory.Functor C (CategoryTheory.Arrow C) :=
      { obj := fun X => CategoryTheory.Arrow.mk (0 : X ⟶ Z₀)
        map := fun g => CategoryTheory.Arrow.homMk g (0 : Z₀ ⟶ Z₀) (hZ₀.eq_of_tgt _ _)
        map_id := fun X => CategoryTheory.CommaMorphism.ext (by simp) (hZ₀.eq_of_tgt _ _)
        map_comp := fun f g => CategoryTheory.CommaMorphism.ext (by simp) (hZ₀.eq_of_tgt _ _) }
    let J_inj : CategoryTheory.Functor C C := CategoryTheory.Functor.comp toZero FFD.Z
    let ι_inj : CategoryTheory.Functor.id C ⟶ J_inj :=
      { app := fun X => FFD.i.app (toZero.obj X)
        naturality := fun X Y g => FFD.i.naturality (toZero.map g) }
    have hMono_ι : ∀ X : C, CategoryTheory.Mono (ι_inj.app X) :=
      fun X => FFD.hi (toZero.obj X)
    have hInj : ∀ X : C, CategoryTheory.Injective (J_inj.obj X) := by
      intro X
      refine CategoryTheory.Injective.mk (fun {A B} g f hf => ?_)
      have hfW : W₁ f := hf
      have hlp : CategoryTheory.HasLiftingProperty f (FFD.p.app (toZero.obj X)) :=
        FFD.hp (toZero.obj X) f hfW
      have sq : CategoryTheory.CommSq g f (FFD.p.app (toZero.obj X)) (0 : B ⟶ Z₀) :=
        ⟨hZ₀.eq_of_tgt _ _⟩
      have hsl : sq.HasLift :=
        @CategoryTheory.HasLiftingProperty.sq_hasLift _ _ _ _ _ _ f
          (FFD.p.app (toZero.obj X)) hlp _ _ sq
      obtain ⟨l⟩ := hsl.exists_lift
      exact ⟨l.l, l.fac_left⟩
    let Q_coker : CategoryTheory.Functor C C :=
      { obj := fun X => CategoryTheory.Limits.cokernel (ι_inj.app X)
        map := fun {X Y} g =>
          CategoryTheory.Limits.cokernel.map (ι_inj.app X) (ι_inj.app Y) g (J_inj.map g)
            (ι_inj.naturality g).symm
        map_id := fun X =>
          (CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π (ι_inj.app X))).mp (by simp)
        map_comp := fun {X Y Z} f g =>
          (CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π (ι_inj.app X))).mp (by simp) }
    let π_coker : J_inj ⟶ Q_coker :=
      { app := fun X => CategoryTheory.Limits.cokernel.π (ι_inj.app X)
        naturality := fun X Y g => by simp [Q_coker] }
    have hzero : ∀ X : C, CategoryTheory.CategoryStruct.comp (ι_inj.app X) (π_coker.app X) = 0 :=
      fun X => CategoryTheory.Limits.cokernel.condition (ι_inj.app X)
    refine ⟨J_inj, Q_coker, ι_inj, π_coker, hzero, hInj, fun X => ?_⟩
    have hEpi : CategoryTheory.Epi (π_coker.app X) := by dsimp [π_coker]; infer_instance
    exact CategoryTheory.ShortComplex.ShortExact.mk'
      (CategoryTheory.ShortComplex.exact_cokernel (ι_inj.app X)) (hMono_ι X) hEpi
  have hColimSES : ∀ (C : Type (u + 1)) [CategoryTheory.Category.{u + 1, u + 1} C]
      [CategoryTheory.Abelian C]
      (Idx₀ : Type u) [CategoryTheory.SmallCategory Idx₀]
      [CategoryTheory.Limits.HasColimitsOfShape Idx₀ C]
      [CategoryTheory.HasExactColimitsOfShape Idx₀ C]
      (F₁ F₂ F₃ : CategoryTheory.Functor Idx₀ C)
      (α : F₁ ⟶ F₂) (β : F₂ ⟶ F₃)
      (h0 : ∀ j : Idx₀, CategoryTheory.CategoryStruct.comp (α.app j) (β.app j) = 0),
      (∀ j : Idx₀, (CategoryTheory.ShortComplex.mk (α.app j) (β.app j) (h0 j)).ShortExact) →
      ∀ (c₁ : CategoryTheory.Limits.Cocone F₁), CategoryTheory.Limits.IsColimit c₁ →
      ∃ (c₂ : CategoryTheory.Limits.Cocone F₂) (_ : CategoryTheory.Limits.IsColimit c₂)
        (c₃ : CategoryTheory.Limits.Cocone F₃) (_ : CategoryTheory.Limits.IsColimit c₃)
        (f_colim : c₁.pt ⟶ c₂.pt) (g_colim : c₂.pt ⟶ c₃.pt)
        (h0_colim : CategoryTheory.CategoryStruct.comp f_colim g_colim = 0),
        (CategoryTheory.ShortComplex.mk f_colim g_colim h0_colim).ShortExact ∧
        (∀ j : Idx₀,
          CategoryTheory.CategoryStruct.comp (c₁.ι.app j) f_colim =
            CategoryTheory.CategoryStruct.comp (α.app j) (c₂.ι.app j)) ∧
        (∀ j : Idx₀,
          CategoryTheory.CategoryStruct.comp (c₂.ι.app j) g_colim =
            CategoryTheory.CategoryStruct.comp (β.app j) (c₃.ι.app j)) := by
    clear hH0Surj hInjColimAcyclic D c hc q hVanish hExtClassNat hFuncInj
    intro C _ _ Idx₀ _ _ _ F₁ F₂ F₃ α β h0 hSES c₁ hc₁
    have hαβ : CategoryTheory.CategoryStruct.comp α β = 0 := by
      ext j
      exact h0 j
    let S_diag := CategoryTheory.ShortComplex.mk α β hαβ
    have hMono_α : CategoryTheory.Mono α :=
      @CategoryTheory.NatTrans.mono_of_mono_app _ _ _ _ _ _ α (fun j => (hSES j).mono_f)
    have hEpi_β : CategoryTheory.Epi β :=
      @CategoryTheory.NatTrans.epi_of_epi_app _ _ _ _ _ _ β (fun j => (hSES j).epi_g)
    have hExact_diag : S_diag.Exact := by
      rw [CategoryTheory.ShortComplex.exact_iff_isZero_homology,
        CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext j
      have hZero_j : CategoryTheory.Limits.IsZero (S_diag.homology.obj j) :=
        ((CategoryTheory.ShortComplex.exact_iff_isZero_homology _).mp (hSES j).exact).of_iso
          (S_diag.mapHomologyIso ((CategoryTheory.evaluation Idx₀ C).obj j)).symm
      exact hZero_j.eq_of_src _ _
    have hSES_diag : S_diag.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' hExact_diag hMono_α hEpi_β
    have hSES_map : (S_diag.map (CategoryTheory.Limits.colim (J := Idx₀) (C := C))).ShortExact :=
      hSES_diag.map_of_exact _
    let c₂ := CategoryTheory.Limits.colimit.cocone F₂
    let hc₂ := CategoryTheory.Limits.colimit.isColimit F₂
    let c₃ := CategoryTheory.Limits.colimit.cocone F₃
    let hc₃ := CategoryTheory.Limits.colimit.isColimit F₃
    let e₁ : CategoryTheory.Limits.colimit F₁ ≅ c₁.pt :=
      CategoryTheory.Limits.colimit.isoColimitCocone ⟨c₁, hc₁⟩
    let f_colim : c₁.pt ⟶ c₂.pt :=
      CategoryTheory.CategoryStruct.comp e₁.inv (CategoryTheory.Limits.colim.map α)
    let g_colim : c₂.pt ⟶ c₃.pt := CategoryTheory.Limits.colim.map β
    have h0_colim : CategoryTheory.CategoryStruct.comp f_colim g_colim = 0 := by
      change CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp e₁.inv (CategoryTheory.Limits.colim.map α))
        (CategoryTheory.Limits.colim.map β) = 0
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp, hαβ,
        CategoryTheory.Functor.map_zero, CategoryTheory.Limits.comp_zero]
    let S_colim := CategoryTheory.ShortComplex.mk f_colim g_colim h0_colim
    let iso_colim : S_diag.map (CategoryTheory.Limits.colim (J := Idx₀) (C := C)) ≅ S_colim :=
      CategoryTheory.ShortComplex.isoMk e₁ (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        (by simp [S_diag, S_colim, f_colim]) (by simp [S_diag, S_colim, g_colim])
    refine ⟨c₂, hc₂, c₃, hc₃, f_colim, g_colim, h0_colim,
      CategoryTheory.ShortComplex.shortExact_of_iso iso_colim hSES_map, fun j => ?_, fun j => ?_⟩
    · change CategoryTheory.CategoryStruct.comp (c₁.ι.app j)
        (CategoryTheory.CategoryStruct.comp e₁.inv (CategoryTheory.Limits.colim.map α)) =
        CategoryTheory.CategoryStruct.comp (α.app j) (CategoryTheory.Limits.colimit.ι F₂ j)
      rw [← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.colimit.isoColimitCocone_ι_inv ⟨c₁, hc₁⟩ j,
        CategoryTheory.Limits.colimit.ι_map α j]
    · exact CategoryTheory.Limits.colimit.ι_map β j
  let Sh := CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}
  let ℤ_S : Sh := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  obtain ⟨J_inj, Q_coker, ι_inj, π_coker, hzero, hInjObj, hSESObj⟩ := hFuncInj Sh
  have hUnivSurj : ∀ (n : ℕ) (D₀ : CategoryTheory.Functor Idx Sh)
      (c₀ : CategoryTheory.Limits.Cocone D₀), CategoryTheory.Limits.IsColimit c₀ →
      ∀ ξ : c₀.pt.H n, ∃ (j : Idx) (ξ_j : (D₀.obj j).H n),
        ξ_j.comp (CategoryTheory.Abelian.Ext.mk₀ (c₀.ι.app j)) (Nat.add_zero n) = ξ := by
    intro n
    induction n with
    | zero =>
      intro D₀ c₀ hc₀ ξ
      exact hH0Surj Idx D₀ c₀ hc₀ ξ
    | succ m ih =>
      intro D₀ c₀ hc₀ ξ
      let F₂ : CategoryTheory.Functor Idx Sh := CategoryTheory.Functor.comp D₀ J_inj
      let F₃ : CategoryTheory.Functor Idx Sh := CategoryTheory.Functor.comp D₀ Q_coker
      let α : D₀ ⟶ F₂ := CategoryTheory.Functor.whiskerLeft D₀ ι_inj
      let β : F₂ ⟶ F₃ := CategoryTheory.Functor.whiskerLeft D₀ π_coker
      have h0_diag : ∀ j : Idx, CategoryTheory.CategoryStruct.comp (α.app j) (β.app j) = 0 :=
        fun j => hzero (D₀.obj j)
      have hSES_diag : ∀ j : Idx,
          (CategoryTheory.ShortComplex.mk (α.app j) (β.app j) (h0_diag j)).ShortExact :=
        fun j => hSESObj (D₀.obj j)
      obtain ⟨c_I, hc_I, c_Q, hc_Q, f_colim, g_colim, h0_colim, hSES_colim, hcomm₁, hcomm₂⟩ :=
        hColimSES Sh Idx D₀ F₂ F₃ α β h0_diag hSES_diag c₀ hc₀
      have hSub_I : Subsingleton (c_I.pt.H (m + 1)) :=
        hInjColimAcyclic Idx F₂ (fun j => hInjObj (D₀.obj j)) c_I hc_I (m + 1)
          (Nat.le_add_left 1 m)
      have hξ_f : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ f_colim) (Nat.add_zero (m + 1)) = 0 :=
        @Subsingleton.elim _ hSub_I _ 0
      obtain ⟨η, hη⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ ℤ_S hSES_colim ξ hξ_f rfl
      obtain ⟨j, η_j, hη_j⟩ := ih F₃ c_Q hc_Q η
      let φ_j : CategoryTheory.ShortComplex.mk (ι_inj.app (D₀.obj j)) (π_coker.app (D₀.obj j))
            (hzero (D₀.obj j)) ⟶
          CategoryTheory.ShortComplex.mk f_colim g_colim h0_colim :=
        CategoryTheory.ShortComplex.homMk (c₀.ι.app j) (c_I.ι.app j) (c_Q.ι.app j)
          (hcomm₁ j) (hcomm₂ j)
      have hNat_j :
          (CategoryTheory.Abelian.Ext.mk₀ (c_Q.ι.app j)).comp hSES_colim.extClass
              (Nat.zero_add 1) =
            (hSESObj (D₀.obj j)).extClass.comp
              (CategoryTheory.Abelian.Ext.mk₀ (c₀.ι.app j)) (Nat.add_zero 1) :=
        hExtClassNat Sh (hSESObj (D₀.obj j)) hSES_colim φ_j
      let ξ_j : (D₀.obj j).H (m + 1) :=
        η_j.comp (hSESObj (D₀.obj j)).extClass rfl
      refine ⟨j, ξ_j, ?_⟩
      change (η_j.comp (hSESObj (D₀.obj j)).extClass rfl).comp
        (CategoryTheory.Abelian.Ext.mk₀ (c₀.ι.app j)) (Nat.add_zero (m + 1)) = ξ
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        ← hNat_j,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero,
        hη_j, hη]
  refine subsingleton_of_forall_eq 0 (fun ξ => ?_)
  obtain ⟨j, ξ_j, hξ_j⟩ := hUnivSurj q D c hc ξ
  have hξ_j0 : ξ_j = 0 := @Subsingleton.elim _ (hVanish j) ξ_j 0
  rw [← hξ_j, hξ_j0]
  exact CategoryTheory.Abelian.Ext.zero_comp ℤ_S q
    (CategoryTheory.Abelian.Ext.mk₀ (c.ι.app j)) q (Nat.add_zero q)

theorem weil_alt_cd_filtered_colimit_sheaf_cohomology_vanishing (S : AlgebraicGeometry.Scheme.{u}) [CompactSpace ↥S] [S.IsSeparated]
    (hEvalColim : ∀ (Idx₀ : Type u) [CategoryTheory.SmallCategory Idx₀]
        [CategoryTheory.IsFiltered Idx₀]
      (D₀ : CategoryTheory.Functor Idx₀
        (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}))
      (c₀ : CategoryTheory.Limits.Cocone D₀),
      CategoryTheory.Limits.IsColimit c₀ →
      ∀ (U : S.Etale) [CompactSpace ↥U.left] [U.left.IsSeparated],
        Nonempty (CategoryTheory.Limits.IsColimit
          ((CategoryTheory.Functor.comp
            (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u})
            ((CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).obj
              (Opposite.op U))).mapCocone c₀)))
    (Idx : Type u) [CategoryTheory.SmallCategory Idx] [CategoryTheory.IsFiltered Idx]
    (D : CategoryTheory.Functor Idx
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}))
    (c : CategoryTheory.Limits.Cocone D)
    (hc : CategoryTheory.Limits.IsColimit c)
    (q : ℕ)
    (hVanish : ∀ j : Idx, Subsingleton ((D.obj j).H q)) :
    Subsingleton (c.pt.H q) :=
by
  let J := S.smallEtaleTopology
  have hH0Surj : ∀ (Idx₀ : Type u) [CategoryTheory.SmallCategory Idx₀]
      [CategoryTheory.IsFiltered Idx₀]
    (D₀ : CategoryTheory.Functor Idx₀ (CategoryTheory.Sheaf J AddCommGrpCat.{u}))
    (c₀ : CategoryTheory.Limits.Cocone D₀),
    CategoryTheory.Limits.IsColimit c₀ →
    ∀ ξ : c₀.pt.H 0, ∃ (j : Idx₀) (ξ_j : (D₀.obj j).H 0),
      ξ_j.comp (CategoryTheory.Abelian.Ext.mk₀ (c₀.ι.app j)) (Nat.add_zero 0) = ξ := by
    intro Idx₀ _ _ D₀ c₀ hc₀ ξ
    let T_S : S.Etale := weilEtaleIdTerminal.{u} S
    let hT_S : CategoryTheory.Limits.IsTerminal T_S := weilEtaleIdTerminalIsTerminal.{u} S
    have hCompTS : CompactSpace ↥T_S.left := by change CompactSpace ↥S; infer_instance
    have hSepTS : T_S.left.IsSeparated := by change S.IsSeparated; infer_instance
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let adj_c := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S
    let f_hom : (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ ⟶ c₀.pt :=
      CategoryTheory.Abelian.Ext.homEquiv₀ ξ
    let u_hom : Aℤ ⟶ c₀.pt.obj.obj (Opposite.op T_S) :=
      adj_c.homEquiv Aℤ c₀.pt f_hom
    obtain ⟨hc_eval⟩ := hEvalColim Idx₀ D₀ c₀ hc₀ T_S
    let hc_types :=
      CategoryTheory.Limits.isColimitOfPreserves (CategoryTheory.forget AddCommGrpCat.{u}) hc_eval
    obtain ⟨j, s_j₀, hs_j⟩ :=
      CategoryTheory.Limits.Types.jointly_surjective_of_isColimit hc_types
        (u_hom.hom (ULift.up (1 : ℤ)))
    let s_j : ↥((D₀.obj j).obj.obj (Opposite.op T_S)) := s_j₀
    let u_j : Aℤ ⟶ (D₀.obj j).obj.obj (Opposite.op T_S) :=
      AddCommGrpCat.ofHom
        { toFun := fun m => m.down • s_j
          map_zero' := zero_zsmul s_j
          map_add' := fun m₁ m₂ => add_zsmul s_j m₁.down m₂.down }
    have hu_j : CategoryTheory.CategoryStruct.comp u_j
        ((c₀.ι.app j).hom.app (Opposite.op T_S)) = u_hom := by
      ext m
      have hm : m = m.down • ULift.up (1 : ℤ) := by
        ext
        simp
      have hs_j' : ((c₀.ι.app j).hom.app (Opposite.op T_S)).hom s_j =
          u_hom.hom (ULift.up (1 : ℤ)) := hs_j
      change ((c₀.ι.app j).hom.app (Opposite.op T_S)).hom (m.down • s_j) = u_hom.hom m
      rw [map_zsmul, hs_j']
      conv_rhs => rw [hm]
      exact (map_zsmul u_hom.hom m.down (ULift.up (1 : ℤ))).symm
    let f_j : (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ ⟶ D₀.obj j :=
      (adj_c.homEquiv Aℤ (D₀.obj j)).symm u_j
    have hf_j : CategoryTheory.CategoryStruct.comp f_j (c₀.ι.app j) = f_hom := by
      apply (adj_c.homEquiv Aℤ c₀.pt).injective
      change adj_c.homEquiv Aℤ c₀.pt (f_j ≫ c₀.ι.app j) = u_hom
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      have h_app : adj_c.homEquiv Aℤ (D₀.obj j) f_j = u_j :=
        (adj_c.homEquiv Aℤ (D₀.obj j)).apply_symm_apply u_j
      rw [h_app]
      exact hu_j
    refine ⟨j, CategoryTheory.Abelian.Ext.mk₀ f_j, ?_⟩
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hf_j,
      CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply]
  have hInjColimAcyclic : ∀ (Idx₀ : Type u) [CategoryTheory.SmallCategory Idx₀]
      [CategoryTheory.IsFiltered Idx₀]
    (I_diag : CategoryTheory.Functor Idx₀ (CategoryTheory.Sheaf J AddCommGrpCat.{u})),
    (∀ j : Idx₀, CategoryTheory.Injective (I_diag.obj j)) →
