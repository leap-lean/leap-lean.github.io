          exact ⟨Opposite.op ⟨⟨a₀, δ₀⟩, hδ₀_s⟩⟩
      let J_idx : CategoryTheory.Functor ℐ_s (Opposite S.Etale) :=
        { obj := fun j => Opposite.op (W_S (Opposite.unop j).1.1)
          map := fun {_ _} f => f.unop.1.op
          map_id := fun _ => rfl
          map_comp := fun _ _ => rfl }
      let D_fun : CategoryTheory.Functor
          (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
          (CategoryTheory.Functor ℐ_s AddCommGrpCat.{u}) :=
        (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).comp
          ((CategoryTheory.Functor.whiskeringLeft ℐ_s (Opposite S.Etale) AddCommGrpCat.{u}).obj J_idx)
      let Stalk_s : CategoryTheory.Functor
          (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) AddCommGrpCat.{u} :=
        D_fun.comp CategoryTheory.Limits.colim
      have hPres_Stalk : CategoryTheory.Limits.PreservesFiniteLimits Stalk_s := inferInstance
      have h_adj_stalk : Nonempty (Stalk_s ⊣ R_sh.comp P_s) := by
        let γ_of_τ : ∀ {U : S.Etale}, (T_K ⟶ B_s.obj U) → { γ : S_K ⟶ U.left // γ ≫ U.hom = s } :=
          fun {U} τ =>
            let u_hom : U.left ⟶ S := U.hom
            let t_left : S_K ⟶ (B_s.obj U).left := τ.left
            ⟨t_left ≫ CategoryTheory.Limits.pullback.fst u_hom s,
              (CategoryTheory.Category.assoc t_left
                (CategoryTheory.Limits.pullback.fst u_hom s) u_hom).trans
                ((congrArg (t_left ≫ ·) CategoryTheory.Limits.pullback.condition).trans
                  ((CategoryTheory.Category.assoc t_left
                    (CategoryTheory.Limits.pullback.snd u_hom s) s).symm.trans
                    ((congrArg (· ≫ s) (CategoryTheory.MorphismProperty.Over.w τ)).trans
                      (CategoryTheory.Category.id_comp s))))⟩
        let τ_of_p : ∀ (p : N_s), (T_K ⟶ B_s.obj (W_S p.1.1)) := fun p =>
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.Limits.pullback.lift p.1.2 (𝟙 S_K)
              (p.2.trans (CategoryTheory.Category.id_comp s).symm))
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
        let ι_stalk : ∀ (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (p : N_s),
            ℱ.obj.obj (Opposite.op (W_S p.1.1)) ⟶ Stalk_s.obj ℱ :=
          fun ℱ p => CategoryTheory.Limits.colimit.ι (D_fun.obj ℱ) (Opposite.op p)
        have h_stalk_eval : ∀ (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
            {M : AddCommGrpCat.{u}} (α : Stalk_s.obj ℱ ⟶ M)
            {U : S.Etale} (γ : S_K ⟶ U.left) (hγ : γ ≫ U.hom = s)
            (p₁ p₂ : N_s) (v₁ : W_S p₁.1.1 ⟶ U) (v₂ : W_S p₂.1.1 ⟶ U),
            p₁.1.2 ≫ v₁.left = γ → p₂.1.2 ≫ v₂.left = γ →
            ℱ.obj.map v₁.op ≫ ι_stalk ℱ p₁ ≫ α =
              ℱ.obj.map v₂.op ≫ ι_stalk ℱ p₂ ≫ α := by
          intro ℱ M α U γ hγ p₁ p₂ v₁ v₂ hv₁ hv₂
          let u_hom : U.left ⟶ S := U.hom
          let v₁_left : (W_S p₁.1.1).left ⟶ U.left := v₁.left
          let v₂_left : (W_S p₂.1.1).left ⟶ U.left := v₂.left
          let d₁ : S_K ⟶ (W_S p₁.1.1).left := p₁.1.2
          let d₂ : S_K ⟶ (W_S p₂.1.1).left := p₂.1.2
          have hv₁_w : v₁_left ≫ u_hom = (W_S p₁.1.1).hom :=
            CategoryTheory.MorphismProperty.Over.w v₁
          have hv₂_w : v₂_left ≫ u_hom = (W_S p₂.1.1).hom :=
            CategoryTheory.MorphismProperty.Over.w v₂
          have hv₁_et : P_et v₁_left :=
            CategoryTheory.MorphismProperty.of_postcomp P_et v₁_left u_hom U.prop
              (hv₁_w.symm ▸ (W_S p₁.1.1).prop)
          have hv₂_et : P_et v₂_left :=
            CategoryTheory.MorphismProperty.of_postcomp P_et v₂_left u_hom U.prop
              (hv₂_w.symm ▸ (W_S p₂.1.1).prop)
          let P_U := CategoryTheory.Limits.pullback v₁_left v₂_left
          let fst_U := CategoryTheory.Limits.pullback.fst v₁_left v₂_left
          let snd_U := CategoryTheory.Limits.pullback.snd v₁_left v₂_left
          have h_fstU_et : P_et fst_U :=
            CategoryTheory.MorphismProperty.pullback_fst v₁_left v₂_left hv₂_et
          have hPU_et : P_et ((fst_U ≫ v₁_left) ≫ u_hom) :=
            CategoryTheory.MorphismProperty.comp_mem P_et (fst_U ≫ v₁_left) u_hom
              (CategoryTheory.MorphismProperty.comp_mem P_et fst_U v₁_left h_fstU_et hv₁_et) U.prop
          let γ_PU : S_K ⟶ P_U := CategoryTheory.Limits.pullback.lift d₁ d₂ (hv₁.trans hv₂.symm)
          have hγ_PU : γ_PU ≫ ((fst_U ≫ v₁_left) ≫ u_hom) = s :=
            (CategoryTheory.Category.assoc γ_PU (fst_U ≫ v₁_left) u_hom).symm.trans
              ((congrArg (· ≫ u_hom)
                ((CategoryTheory.Category.assoc γ_PU fst_U v₁_left).symm.trans
                  ((congrArg (· ≫ v₁_left) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                    hv₁))).trans hγ)
          obtain ⟨a₃, δ₃, w₃, hδ₃_s, hδ₃_w⟩ :=
            h_shrink ((fst_U ≫ v₁_left) ≫ u_hom) hPU_et γ_PU hγ_PU
          have hw₃_w : w₃.left ≫ ((fst_U ≫ v₁_left) ≫ u_hom) = (W_S a₃).hom :=
            CategoryTheory.MorphismProperty.Over.w w₃
          let p₃ : N_s := ⟨⟨a₃, δ₃⟩, hδ₃_s⟩
          let m₁ : p₃ ⟶ p₁ :=
            ⟨CategoryTheory.MorphismProperty.Over.homMk (w₃.left ≫ fst_U)
              ((CategoryTheory.Category.assoc w₃.left fst_U (W_S p₁.1.1).hom).trans
                ((congrArg (w₃.left ≫ ·)
                  ((congrArg (fst_U ≫ ·) hv₁_w.symm).trans
                    (CategoryTheory.Category.assoc fst_U v₁_left u_hom).symm)).trans hw₃_w))
              trivial,
              (CategoryTheory.Category.assoc δ₃ w₃.left fst_U).symm.trans
                ((congrArg (· ≫ fst_U) hδ₃_w).trans
                  (CategoryTheory.Limits.pullback.lift_fst _ _ _))⟩
          let m₂ : p₃ ⟶ p₂ :=
            ⟨CategoryTheory.MorphismProperty.Over.homMk (w₃.left ≫ snd_U)
              ((CategoryTheory.Category.assoc w₃.left snd_U (W_S p₂.1.1).hom).trans
                ((congrArg (w₃.left ≫ ·)
                  ((congrArg (snd_U ≫ ·) hv₂_w.symm).trans
                    ((CategoryTheory.Category.assoc snd_U v₂_left u_hom).symm.trans
                      (congrArg (· ≫ u_hom) CategoryTheory.Limits.pullback.condition.symm)))).trans
                  hw₃_w))
              trivial,
              (CategoryTheory.Category.assoc δ₃ w₃.left snd_U).symm.trans
                ((congrArg (· ≫ snd_U) hδ₃_w).trans
                  (CategoryTheory.Limits.pullback.lift_snd _ _ _))⟩
          have hm_v : m₁.1 ≫ v₁ = m₂.1 ≫ v₂ :=
            CategoryTheory.MorphismProperty.Comma.Hom.ext
              ((CategoryTheory.Category.assoc w₃.left fst_U v₁_left).trans
                ((congrArg (w₃.left ≫ ·) CategoryTheory.Limits.pullback.condition).trans
                  (CategoryTheory.Category.assoc w₃.left snd_U v₂_left).symm))
              (Subsingleton.elim _ _)
          have h_colim₁ : ℱ.obj.map m₁.1.op ≫ ι_stalk ℱ p₃ = ι_stalk ℱ p₁ :=
            CategoryTheory.Limits.colimit.w (D_fun.obj ℱ) m₁.op
          have h_colim₂ : ℱ.obj.map m₂.1.op ≫ ι_stalk ℱ p₃ = ι_stalk ℱ p₂ :=
            CategoryTheory.Limits.colimit.w (D_fun.obj ℱ) m₂.op
          have h_fmap : ℱ.obj.map v₁.op ≫ ℱ.obj.map m₁.1.op =
              ℱ.obj.map v₂.op ≫ ℱ.obj.map m₂.1.op := by
            rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]
            exact congrArg (fun u => ℱ.obj.map u.op) hm_v
          exact (congrArg (ℱ.obj.map v₁.op ≫ ·)
            ((congrArg (· ≫ α) h_colim₁.symm).trans
              (CategoryTheory.Category.assoc (ℱ.obj.map m₁.1.op) (ι_stalk ℱ p₃) α))).trans
            ((CategoryTheory.Category.assoc (ℱ.obj.map v₁.op) (ℱ.obj.map m₁.1.op)
              (ι_stalk ℱ p₃ ≫ α)).symm.trans
              ((congrArg (· ≫ (ι_stalk ℱ p₃ ≫ α)) h_fmap).trans
                ((CategoryTheory.Category.assoc (ℱ.obj.map v₂.op) (ℱ.obj.map m₂.1.op)
                  (ι_stalk ℱ p₃ ≫ α)).trans
                  (congrArg (ℱ.obj.map v₂.op ≫ ·)
                    ((CategoryTheory.Category.assoc (ℱ.obj.map m₂.1.op) (ι_stalk ℱ p₃) α).symm.trans
                      (congrArg (· ≫ α) h_colim₂))))))
        have h_to_R_ex : ∀ (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
            (M : AddCommGrpCat.{u}) (α : Stalk_s.obj ℱ ⟶ M) (U : S.Etale),
            ∃ (f_app : ℱ.obj.obj (Opposite.op U) ⟶ ∏ᶜ (fun _ : (T_K ⟶ B_s.obj U) => M)),
              ∀ (τ : T_K ⟶ B_s.obj U) (p : N_s) (v : W_S p.1.1 ⟶ U),
                p.1.2 ≫ v.left = (γ_of_τ τ).1 →
                f_app ≫ CategoryTheory.Limits.Pi.π (fun _ : (T_K ⟶ B_s.obj U) => M) τ =
                  ℱ.obj.map v.op ≫ ι_stalk ℱ p ≫ α := by
          intro ℱ M α U
          have h_ex_pair : ∀ (τ : T_K ⟶ B_s.obj U),
              ∃ (pv : N_s × Σ a : M_S, (W_S a ⟶ U)),
                pv.2.1 = pv.1.1.1 ∧
                ∀ h_eq : pv.2.1 = pv.1.1.1,
                  pv.1.1.2 ≫ (h_eq ▸ pv.2.2).left = (γ_of_τ τ).1 := by
            intro τ
            obtain ⟨a, δ, v, hδ_s, hδ_v⟩ := h_shrink U.hom U.prop (γ_of_τ τ).1 (γ_of_τ τ).2
            exact ⟨(⟨⟨a, δ⟩, hδ_s⟩, ⟨a, v⟩), rfl, fun _ => hδ_v⟩
          let pick_p : (T_K ⟶ B_s.obj U) → N_s :=
            fun τ => (Classical.choose (h_ex_pair τ)).1
          let pick_v : ∀ (τ : T_K ⟶ B_s.obj U), W_S (pick_p τ).1.1 ⟶ U :=
            fun τ => (Classical.choose_spec (h_ex_pair τ)).1 ▸ (Classical.choose (h_ex_pair τ)).2.2
          have h_pick_spec : ∀ (τ : T_K ⟶ B_s.obj U),
              (pick_p τ).1.2 ≫ (pick_v τ).left = (γ_of_τ τ).1 :=
            fun τ => (Classical.choose_spec (h_ex_pair τ)).2 (Classical.choose_spec (h_ex_pair τ)).1
          refine ⟨CategoryTheory.Limits.Pi.lift (f := fun _ : (T_K ⟶ B_s.obj U) => M)
            (fun τ => ℱ.obj.map (pick_v τ).op ≫ ι_stalk ℱ (pick_p τ) ≫ α), ?_⟩
          intro τ p v hv
          exact (pi_lift_π M _ τ).trans
            (h_stalk_eval ℱ α (γ_of_τ τ).1 (γ_of_τ τ).2 (pick_p τ) p (pick_v τ) v (h_pick_spec τ) hv)
        have h_to_R_fun : ∃ (to_R_app :
            ∀ (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
              (M : AddCommGrpCat.{u}) (α : Stalk_s.obj ℱ ⟶ M) (U : S.Etale),
              ℱ.obj.obj (Opposite.op U) ⟶ ∏ᶜ (fun _ : (T_K ⟶ B_s.obj U) => M)),
            ∀ (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
              (M : AddCommGrpCat.{u}) (α : Stalk_s.obj ℱ ⟶ M) (U : S.Etale)
              (τ : T_K ⟶ B_s.obj U) (p : N_s) (v : W_S p.1.1 ⟶ U),
              p.1.2 ≫ v.left = (γ_of_τ τ).1 →
              to_R_app ℱ M α U ≫
                CategoryTheory.Limits.Pi.π (fun _ : (T_K ⟶ B_s.obj U) => M) τ =
                ℱ.obj.map v.op ≫ ι_stalk ℱ p ≫ α :=
          ⟨fun ℱ M α U => Classical.choose (h_to_R_ex ℱ M α U),
           fun ℱ M α U => Classical.choose_spec (h_to_R_ex ℱ M α U)⟩
        obtain ⟨to_R_app, h_to_R_char⟩ := h_to_R_fun
        have h_from_R_fun : ∃ (from_R :
            ∀ (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
              (M : AddCommGrpCat.{u}),
              (ℱ ⟶ (R_sh.comp P_s).obj M) → (Stalk_s.obj ℱ ⟶ M)),
            ∀ (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
              (M : AddCommGrpCat.{u}) (β : ℱ ⟶ (R_sh.comp P_s).obj M) (p : N_s),
              ι_stalk ℱ p ≫ from_R ℱ M β =
                (β.hom.app (Opposite.op (W_S p.1.1)) :
                  ℱ.obj.obj (Opposite.op (W_S p.1.1)) ⟶
                    ∏ᶜ (fun _ : (T_K ⟶ B_s.obj (W_S p.1.1)) => M)) ≫
                  CategoryTheory.Limits.Pi.π (fun _ : (T_K ⟶ B_s.obj (W_S p.1.1)) => M)
                    (τ_of_p p) := by
          refine ⟨fun ℱ M β =>
            CategoryTheory.Limits.colimit.desc (D_fun.obj ℱ)
              { pt := M
                ι :=
                  { app := fun j =>
                      let p := Opposite.unop j
                      (β.hom.app (Opposite.op (W_S p.1.1)) :
                        ℱ.obj.obj (Opposite.op (W_S p.1.1)) ⟶
                          ∏ᶜ (fun _ : (T_K ⟶ B_s.obj (W_S p.1.1)) => M)) ≫
                        CategoryTheory.Limits.Pi.π (fun _ : (T_K ⟶ B_s.obj (W_S p.1.1)) => M)
                          (τ_of_p p)
                    naturality := fun {j₁ j₂} m => by
                      rcases j₁ with ⟨p₁⟩
                      rcases j₂ with ⟨p₂⟩
                      let u : p₂ ⟶ p₁ := m.unop
                      dsimp [D_fun, J_idx]
                      rw [CategoryTheory.Category.comp_id]
                      have h_nat : ℱ.obj.map u.1.op ≫
                          (β.hom.app (Opposite.op (W_S p₂.1.1)) :
                            ℱ.obj.obj (Opposite.op (W_S p₂.1.1)) ⟶
                              ∏ᶜ (fun _ : (T_K ⟶ B_s.obj (W_S p₂.1.1)) => M)) =
                        (β.hom.app (Opposite.op (W_S p₁.1.1)) :
                          ℱ.obj.obj (Opposite.op (W_S p₁.1.1)) ⟶
                            ∏ᶜ (fun _ : (T_K ⟶ B_s.obj (W_S p₁.1.1)) => M)) ≫
                          (R_pre M).map (B_s.map u.1).op :=
                        β.hom.naturality u.1.op
                      have h_tau_eq : τ_of_p p₂ ≫ B_s.map u.1 = τ_of_p p₁ := by
                        apply CategoryTheory.MorphismProperty.Comma.Hom.ext _
                          (Subsingleton.elim _ _)
                        apply CategoryTheory.Limits.pullback.hom_ext
                        · exact (CategoryTheory.Category.assoc _ _ _).trans
                            ((congrArg _ (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                                ((congrArg (· ≫ u.1.left)
                                  (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                                  (u.2.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm))))
                        · exact (CategoryTheory.Category.assoc _ _ _).trans
                            ((congrArg _ (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                              ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                                (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm))
                      have h_pi : (R_pre M).map (B_s.map u.1).op ≫
                          CategoryTheory.Limits.Pi.π (fun _ : (T_K ⟶ B_s.obj (W_S p₂.1.1)) => M)
                            (τ_of_p p₂) =
                        CategoryTheory.Limits.Pi.π (fun _ : (T_K ⟶ B_s.obj (W_S p₁.1.1)) => M)
                          (τ_of_p p₁) :=
                        (pi_lift_π M _ (τ_of_p p₂)).trans
                          (congrArg (CategoryTheory.Limits.Pi.π _) h_tau_eq)
                      exact (CategoryTheory.Category.assoc (ℱ.obj.map u.1.op) _ _).symm.trans
                        ((congrArg (· ≫ _) h_nat).trans
                          ((CategoryTheory.Category.assoc _ _ _).trans
                            (congrArg _ h_pi))) } }, ?_⟩
          intro ℱ M β p
          exact CategoryTheory.Limits.colimit.ι_desc _ (Opposite.op p)
        obtain ⟨from_R, h_from_R_char⟩ := h_from_R_fun
        refine ⟨CategoryTheory.Adjunction.mkOfHomEquiv
          { homEquiv := fun ℱ M =>
              { toFun := fun α =>
                  { hom :=
                      { app := fun U_op => to_R_app ℱ M α (Opposite.unop U_op)
                        naturality := fun {U₁_op U₂_op} g => by
                          rcases U₁_op with ⟨U₁⟩
                          rcases U₂_op with ⟨U₂⟩
                          change ℱ.obj.map g ≫ to_R_app ℱ M α U₂ =
                            to_R_app ℱ M α U₁ ≫ (R_pre M).map (B_s.op.map g)
                          apply CategoryTheory.Limits.Pi.hom_ext
                          intro τ₂
                          let τ₁ : T_K ⟶ B_s.obj U₁ := τ₂ ≫ B_s.map g.unop
                          obtain ⟨a₂, δ₂, v₂, hδ₂_s, hδ₂_v⟩ :=
                            h_shrink U₂.hom U₂.prop (γ_of_τ τ₂).1 (γ_of_τ τ₂).2
                          let p₂ : N_s := ⟨⟨a₂, δ₂⟩, hδ₂_s⟩
                          have hv₁ : p₂.1.2 ≫ (v₂ ≫ g.unop).left = (γ_of_τ τ₁).1 :=
                            (CategoryTheory.Category.assoc δ₂ v₂.left g.unop.left).symm.trans
                              ((congrArg (· ≫ g.unop.left) hδ₂_v).trans
                                ((CategoryTheory.Category.assoc τ₂.left
                                  (CategoryTheory.Limits.pullback.fst U₂.hom s) g.unop.left).trans
                                  ((congrArg (τ₂.left ≫ ·)
                                    (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm).trans
                                    (CategoryTheory.Category.assoc τ₂.left (B_s.map g.unop).left _).symm)))
                          have h_rhs : (to_R_app ℱ M α U₁ ≫ (R_pre M).map (B_s.op.map g)) ≫
                              CategoryTheory.Limits.Pi.π (fun _ : (T_K ⟶ B_s.obj U₂) => M) τ₂ =
                              to_R_app ℱ M α U₁ ≫
                                CategoryTheory.Limits.Pi.π (fun _ : (T_K ⟶ B_s.obj U₁) => M) τ₁ :=
                            (CategoryTheory.Category.assoc _ _ _).trans
                              (congrArg _ (pi_lift_π M _ τ₂))
                          exact (CategoryTheory.Category.assoc (ℱ.obj.map g) (to_R_app ℱ M α U₂) _).trans
                            ((congrArg (ℱ.obj.map g ≫ ·) (h_to_R_char ℱ M α U₂ τ₂ p₂ v₂ hδ₂_v)).trans
                              ((CategoryTheory.Category.assoc (ℱ.obj.map g) (ℱ.obj.map v₂.op)
                                (ι_stalk ℱ p₂ ≫ α)).symm.trans
                                ((congrArg (· ≫ (ι_stalk ℱ p₂ ≫ α)) (ℱ.obj.map_comp g v₂.op).symm).trans
                                  ((h_to_R_char ℱ M α U₁ τ₁ p₂ (v₂ ≫ g.unop) hv₁).symm.trans
                                    h_rhs.symm)))) } }
                invFun := fun β => from_R ℱ M β
                left_inv := fun α => by
                  apply CategoryTheory.Limits.colimit.hom_ext
                  intro ⟨p⟩
                  let id_w : W_S p.1.1 ⟶ W_S p.1.1 := 𝟙 (W_S p.1.1)
                  have h_id : p.1.2 ≫ id_w.left = (γ_of_τ (τ_of_p p)).1 :=
                    (CategoryTheory.Category.comp_id p.1.2).trans
                      (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
                  exact (h_from_R_char ℱ M _ p).trans
                    ((h_to_R_char ℱ M α (W_S p.1.1) (τ_of_p p) p id_w h_id).trans
                      ((congrArg (· ≫ (ι_stalk ℱ p ≫ α))
                        (ℱ.obj.map_id (Opposite.op (W_S p.1.1)))).trans
                        (CategoryTheory.Category.id_comp _)))
                right_inv := fun β => by
                  apply CategoryTheory.Sheaf.hom_ext
                  apply CategoryTheory.NatTrans.ext
                  funext U_op
                  rcases U_op with ⟨U⟩
                  change to_R_app ℱ M (from_R ℱ M β) U =
                    (β.hom.app (Opposite.op U) :
                      ℱ.obj.obj (Opposite.op U) ⟶ ∏ᶜ (fun _ : (T_K ⟶ B_s.obj U) => M))
                  apply CategoryTheory.Limits.Pi.hom_ext
                  intro τ
                  obtain ⟨a, δ, v, hδ_s, hδ_v⟩ :=
