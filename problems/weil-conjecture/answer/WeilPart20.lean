                rw [Classical.choose_spec (h_ex_m u hu U₂_op ((W_pre.map g) s)), h_nat_q,
                  Classical.choose_spec (h_ex_m u hu U₁_op s), h_nat_u] }
        have h_lift_fac : ∀ {W_pre : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}}
            (u : W_pre ⟶ P_b 0 S_ex.X₃) (hu : u ≫ δ₀ = 0),
            lift_q u hu ≫ q_desc = u := by
          intro W_pre u hu
          ext U_op s
