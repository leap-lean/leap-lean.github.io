        | false => toHom _ u ≫ G.obj.map (Opposite.op (d_site Y))
      obtain ⟨t, _, ht_uniq⟩ := hFor x_fam (hCompat x_fam)
      have hu : toHom _ u = t := ht_uniq (toHom _ u) (fun b => by cases b <;> rfl)
      have hv : toHom _ v = t := ht_uniq (toHom _ v) (fun b => by
        cases b
        · change toHom _ v ≫ G.obj.map (Opposite.op (d_site Y)) =
            toHom _ u ≫ G.obj.map (Opposite.op (d_site Y))
          rw [hToHom_comp, hToHom_comp, hd]
        · change toHom _ v ≫ G.obj.map (Opposite.op (c_site Y)) =
            toHom _ u ≫ G.obj.map (Opposite.op (c_site Y))
          rw [hToHom_comp, hToHom_comp, hc])
      calc
        u = (toHom _ u).hom (ULift.up 1) := (hToHom_eval u).symm
        _ = (toHom _ v).hom (ULift.up 1) := by rw [hu, hv]
        _ = v := hToHom_eval v
    · intro x₁
      let x_fam : ∀ b : Bool, P_Z.obj (Opposite.op (famObj b)) := fun b =>
        match b with
        | true => toHom _ x₁
        | false => (0 : Aℤ ⟶ G.obj.obj (Opposite.op (Y₂_of Y)))
      obtain ⟨z_hom, hz, _⟩ := hFor x_fam (hCompat x_fam)
      refine ⟨z_hom.hom (ULift.up 1), ?_, ?_⟩
      · have htrue : z_hom ≫ G.obj.map (Opposite.op (c_site Y)) = toHom _ x₁ := hz true
        calc
          (G.obj.map (Opposite.op (c_site Y))).hom (z_hom.hom (ULift.up 1))
            = (z_hom ≫ G.obj.map (Opposite.op (c_site Y))).hom (ULift.up 1) := rfl
          _ = (toHom _ x₁).hom (ULift.up 1) := by rw [htrue]
          _ = x₁ := hToHom_eval x₁
      · have hfalse : z_hom ≫ G.obj.map (Opposite.op (d_site Y)) =
            (0 : Aℤ ⟶ G.obj.obj (Opposite.op (Y₂_of Y))) := hz false
        exact congrArg (fun k : Aℤ ⟶ G.obj.obj (Opposite.op (Y₂_of Y)) => k.hom (ULift.up 1))
          hfalse

  let δ_inv : ∀ W : S.Etale, B_s.obj (j_s.obj W) ⟶ W := fun W =>
    let w_hom := (FgtS.obj W).hom
    CategoryTheory.MorphismProperty.Over.homMk
      (CategoryTheory.Limits.pullback.fst (CategoryTheory.CategoryStruct.comp w_hom s) s)
      ((cancel_mono s).mp
        ((CategoryTheory.Category.assoc _ w_hom s).trans
          (CategoryTheory.Limits.pullback.condition
            (f := CategoryTheory.CategoryStruct.comp w_hom s) (g := s))))
      trivial
  have hδ_inv_nat : ∀ {W₁ W₂ : S.Etale} (f : W₁ ⟶ W₂),
      CategoryTheory.CategoryStruct.comp (B_s.map (j_s.map f)) (δ_inv W₂) =
        CategoryTheory.CategoryStruct.comp (δ_inv W₁) f := by
    intro W₁ W₂ f
    refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _

  have hAdjClopen : Nonempty (pf_s ⊣ j_push) := by
    let glue0_hom : ∀ (G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (Y : X₀.Etale),
