      rintro ⟨z, hz⟩
      obtain ⟨a, ⟨w₁, hw₁, rfl⟩, b, ⟨w₂, hw₂, rfl⟩, rfl⟩ := AddSubgroup.mem_sup.mp hz
      exact ⟨(⟨w₁, hw₁⟩, ⟨w₂, hw₂⟩), rfl⟩
    have hRestr : ∀ (L₀ : GalSub) [Normal K ↥L₀.1] (h₀ : L₀.1 ≤ L₃.1) (u₃ : U_of L₃ ⟶ U_of L₃),
        ∃ u₀ : U_of L₀ ⟶ U_of L₀, u₃ ≫ π_of h₀ = π_of h₀ ≫ u₀ := by
      intro L₀ _ h₀ u₃
      obtain ⟨φ₃, hφ₃⟩ := hEndToAlg L₃ u₃
      let ψ₀ : ↥L₀.1 →ₐ[K] K_sep := L₃.1.val.comp (φ₃.comp (IntermediateField.inclusion h₀))
      have hrange : ψ₀.fieldRange = L₀.1 := AlgHom.fieldRange_of_normal ψ₀
      have hmem₀ : ∀ x : ↥L₀.1, ψ₀ x ∈ L₀.1 := by
        intro x
        have hx : ψ₀ x ∈ ψ₀.fieldRange := ψ₀.mem_fieldRange_self x
        rwa [hrange] at hx
      let φ₀ : ↥L₀.1 →ₐ[K] ↥L₀.1 :=
        { toFun := fun x => ⟨ψ₀ x, hmem₀ x⟩
