    · exact ((CategoryTheory.Category.assoc _ _ _).trans
        (congrArg _ (CategoryTheory.Limits.pullback.lift_snd _ _ _))).trans
        ((CategoryTheory.MorphismProperty.Over.w f).trans
          ((CategoryTheory.Limits.pullback.lift_snd _ _ _).symm.trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              (congrArg _ (CategoryTheory.Limits.pullback.lift_snd _ _ _))).symm))
  have hc_site_nat : ∀ {Y₁ Y₂ : X₀.Etale} (g : Y₁ ⟶ Y₂),
      CategoryTheory.CategoryStruct.comp (j_s.map (B_s.map g)) (c_site Y₂) =
        CategoryTheory.CategoryStruct.comp (c_site Y₁) g := by
    intro Y₁ Y₂ g
    refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hSite_tri1 : ∀ W : S.Etale,
      CategoryTheory.CategoryStruct.comp (j_s.map (η_site W)) (c_site (j_s.obj W)) =
        CategoryTheory.CategoryStruct.id (j_s.obj W) := by
    intro W
    refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hSite_tri2 : ∀ Y : X₀.Etale,
      CategoryTheory.CategoryStruct.comp (η_site (B_s.obj Y)) (B_s.map (c_site Y)) =
        CategoryTheory.CategoryStruct.id (B_s.obj Y) := by
    intro Y
    refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact ((CategoryTheory.Category.assoc _ _ _).trans
        (congrArg _ (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
        (((CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans
          (CategoryTheory.Category.id_comp _)).trans
          (CategoryTheory.Category.id_comp _).symm)
    · exact ((CategoryTheory.Category.assoc _ _ _).trans
        (congrArg _ (CategoryTheory.Limits.pullback.lift_snd _ _ _))).trans
        ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
