                CommRingCat.ofHom eq_ring.symm.toRingHom = 𝟙 _ :=
              CommRingCat.hom_ext (RingHom.ext fun x => eq_ring.symm_apply_apply x)
            rw [hid, AlgebraicGeometry.Spec.map_id]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Spec.map_comp]
            have hid : CommRingCat.ofHom eq_ring.symm.toRingHom ≫
                CommRingCat.ofHom eq_ring.toRingHom = 𝟙 _ :=
              CommRingCat.hom_ext (RingHom.ext fun x => eq_ring.apply_symm_apply x)
            rw [hid, AlgebraicGeometry.Spec.map_id] }
      exact ⟨iso3 ≪≫ iso2.symm ≪≫ iso1.symm, trivial⟩
    let e_chart : ∀ j : J,
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↑(R_cat j.1))) ≅ Q j :=
      fun j => Classical.choose (hChartIso j)
    let g_chart : ∀ j : J,
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↑(R_cat j.1))) ⟶ W :=
      fun j => (e_chart j).hom ≫ m_chart j
    have hOpen_g : ∀ j : J, AlgebraicGeometry.IsOpenImmersion (g_chart j) := by
      intro j
      haveI := hOpen_m j
      dsimp [g_chart]
      infer_instance
    haveI : ∀ j : J, AlgebraicGeometry.IsOpenImmersion (g_chart j) := hOpen_g
    have hCovW : ∀ w : ↥W,
        ∃ (j : J) (p : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↑(R_cat j.1))))),
          (g_chart j).base p = w := by
      intro w
      let j₀ : covY.I₀ × covP.I₀ :=
        (AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight covY covP Y.hom P₁.hom).idx w
      have hcov_w : w ∈ Set.range
          ((AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight covY covP Y.hom P₁.hom).f j₀).base :=
        (AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight covY covP Y.hom P₁.hom).covers w
      rw [AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight_f] at hcov_w
      obtain ⟨q, hq⟩ := hcov_w
      let j : J := j₀
      let q' : ↥(Q j) := q
      have hq' : (m_chart j).base q' = w := hq
      refine ⟨j, (e_chart j).inv.base q', ?_⟩
      change ((e_chart j).hom ≫ m_chart j).base ((e_chart j).inv.base q') = w
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
      have hinv : (e_chart j).hom.base ((e_chart j).inv.base q') = q' := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, (e_chart j).inv_hom_id]
        rfl
      rw [hinv]
      exact hq'
    let covW : W.OpenCover :=
      AlgebraicGeometry.Scheme.Cover.mkOfCovers J
        (fun j => AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↑(R_cat j.1))))
        g_chart hCovW
    haveI hRedW : AlgebraicGeometry.IsReduced W := by
      haveI : ∀ j : covW.I₀, AlgebraicGeometry.IsReduced (covW.X j) := by
        intro j
        haveI : IsDomain ↑(R_cat j.1) := hDom_y j.1
        haveI : IsDomain (Polynomial ↑(R_cat j.1)) := inferInstance
        change AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↑(R_cat j.1))))
        infer_instance
      exact AlgebraicGeometry.IsReduced.of_openCover W covW
    let s_Y : Y.left ⟶ W :=
      CategoryTheory.Limits.pullback.lift (𝟙 Y.left) (Y.hom ≫ s₁)
        (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hs₁,
          CategoryTheory.Category.comp_id])
    let O_chart : J → TopologicalSpace.Opens ↥W := fun j => (g_chart j).opensRange
    have hPre_O : ∀ j : J, IsPreirreducible (O_chart j : Set ↥W) := by
      intro j
      haveI : IsDomain ↑(R_cat j.1) := hDom_y j.1
      haveI : IsDomain (Polynomial ↑(R_cat j.1)) := inferInstance
      have hIrrDom : IrreducibleSpace
          ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↑(R_cat j.1)))) :=
        PrimeSpectrum.irreducibleSpace
      have hImg : IsIrreducible (Set.range (g_chart j).base) := by
        rw [← Set.image_univ]
        exact hIrrDom.isIrreducible_univ.image (g_chart j).base (g_chart j).continuous.continuousOn
      exact hImg.isPreirreducible
    have hMemSection : ∀ (j : J) (y_star : ↥Y.left), y_star ∈ U_y j.1 →
        s_Y.base y_star ∈ (O_chart j : Set ↥W) := by
      intro j y_star hy_star
      have hy_r : y_star ∈ Set.range (f_y j.1).base := by
        change y_star ∈ Set.range (hAff_y j.1).fromSpec.base
        rw [(hAff_y j.1).range_fromSpec]
        exact hy_star
      obtain ⟨u_y, hu_y⟩ := hy_r
      have hRange_sub : Set.range ((f_y j.1 ≫ Y.hom) ≫ s₁).base ⊆ Set.range (ι_b j.2).base := by
        rintro _ ⟨pt, rfl⟩
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
        exact hs₁_b j.2 ⟨(f_y j.1 ≫ Y.hom).base pt, rfl⟩
      let σ_j : AlgebraicGeometry.Spec (R_cat j.1) ⟶ A1 :=
        AlgebraicGeometry.IsOpenImmersion.lift (ι_b j.2) ((f_y j.1 ≫ Y.hom) ≫ s₁) hRange_sub
      have hσ_fac : σ_j ≫ ι_b j.2 = (f_y j.1 ≫ Y.hom) ≫ s₁ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (ι_b j.2) ((f_y j.1 ≫ Y.hom) ≫ s₁) hRange_sub
      have hτ_cond : 𝟙 (AlgebraicGeometry.Spec (R_cat j.1)) ≫ (f_y j.1 ≫ Y.hom) =
          σ_j ≫ (ι_b j.2 ≫ P₁.hom) := by
        rw [CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc, hσ_fac,
          CategoryTheory.Category.assoc, hs₁, CategoryTheory.Category.comp_id]
      let τ_j : AlgebraicGeometry.Spec (R_cat j.1) ⟶ Q j :=
        CategoryTheory.Limits.pullback.lift (𝟙 _) σ_j hτ_cond
      have hτ_eq : τ_j ≫ m_chart j = f_y j.1 ≫ s_Y := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · calc
            (τ_j ≫ m_chart j) ≫ CategoryTheory.Limits.pullback.fst Y.hom P₁.hom
              = τ_j ≫ (m_chart j ≫ CategoryTheory.Limits.pullback.fst Y.hom P₁.hom) :=
                  CategoryTheory.Category.assoc _ _ _
            _ = τ_j ≫ (CategoryTheory.Limits.pullback.fst _ _ ≫ f_y j.1) := by
                  dsimp [m_chart]
                  rw [CategoryTheory.Limits.pullback.lift_fst]
            _ = 𝟙 _ ≫ f_y j.1 := by
                  dsimp [τ_j]
                  rw [CategoryTheory.Limits.pullback.lift_fst_assoc]
            _ = f_y j.1 := CategoryTheory.Category.id_comp _
            _ = f_y j.1 ≫ 𝟙 Y.left := (CategoryTheory.Category.comp_id _).symm
            _ = f_y j.1 ≫ (s_Y ≫ CategoryTheory.Limits.pullback.fst Y.hom P₁.hom) := by
                  dsimp [s_Y]
                  rw [CategoryTheory.Limits.pullback.lift_fst]
            _ = (f_y j.1 ≫ s_Y) ≫ CategoryTheory.Limits.pullback.fst Y.hom P₁.hom :=
                  (CategoryTheory.Category.assoc _ _ _).symm
        · calc
            (τ_j ≫ m_chart j) ≫ CategoryTheory.Limits.pullback.snd Y.hom P₁.hom
              = τ_j ≫ (m_chart j ≫ CategoryTheory.Limits.pullback.snd Y.hom P₁.hom) :=
                  CategoryTheory.Category.assoc _ _ _
            _ = τ_j ≫ (CategoryTheory.Limits.pullback.snd _ _ ≫ ι_b j.2) := by
                  dsimp [m_chart]
                  rw [CategoryTheory.Limits.pullback.lift_snd]
            _ = σ_j ≫ ι_b j.2 := by
                  dsimp [τ_j]
                  rw [CategoryTheory.Limits.pullback.lift_snd_assoc]
            _ = (f_y j.1 ≫ Y.hom) ≫ s₁ := hσ_fac
            _ = f_y j.1 ≫ (Y.hom ≫ s₁) := CategoryTheory.Category.assoc _ _ _
            _ = f_y j.1 ≫ (s_Y ≫ CategoryTheory.Limits.pullback.snd Y.hom P₁.hom) := by
                  dsimp [s_Y]
                  rw [CategoryTheory.Limits.pullback.lift_snd]
            _ = (f_y j.1 ≫ s_Y) ≫ CategoryTheory.Limits.pullback.snd Y.hom P₁.hom :=
                  (CategoryTheory.Category.assoc _ _ _).symm
      change s_Y.base y_star ∈ Set.range (g_chart j).base
      refine ⟨(e_chart j).inv.base (τ_j.base u_y), ?_⟩
      change ((e_chart j).hom ≫ m_chart j).base ((e_chart j).inv.base (τ_j.base u_y)) = s_Y.base y_star
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
      have hinv : (e_chart j).hom.base ((e_chart j).inv.base (τ_j.base u_y)) = τ_j.base u_y := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, (e_chart j).inv_hom_id]
        rfl
      rw [hinv, ← AlgebraicGeometry.Scheme.Hom.comp_apply, hτ_eq,
        AlgebraicGeometry.Scheme.Hom.comp_apply, hu_y]
    have hPairwise : _root_.Pairwise (Function.onFun (fun U₁ U₂ => ¬ Disjoint U₁ U₂) O_chart) := by
      intro j₁ j₂ _ hDisj
      have hOpen1 : IsOpen (U_y j₁.1 : Set ↥Y.left) := (U_y j₁.1).isOpen
      have hOpen2 : IsOpen (U_y j₂.1 : Set ↥Y.left) := (U_y j₂.1).isOpen
      have hNe1 : (Set.univ ∩ (U_y j₁.1 : Set ↥Y.left)).Nonempty :=
        ⟨j₁.1, trivial, hy_mem j₁.1⟩
      have hNe2 : (Set.univ ∩ (U_y j₂.1 : Set ↥Y.left)).Nonempty :=
        ⟨j₂.1, trivial, hy_mem j₂.1⟩
      obtain ⟨y_star, hy_inter⟩ :=
        (IrreducibleSpace.isIrreducible_univ ↥Y.left).isPreirreducible
          (U_y j₁.1) (U_y j₂.1) hOpen1 hOpen2 hNe1 hNe2
      simp only [Set.mem_inter_iff, Set.mem_univ, true_and] at hy_inter
      obtain ⟨hy1, hy2⟩ := hy_inter
      have hw1 : s_Y.base y_star ∈ (O_chart j₁ : Set ↥W) := hMemSection j₁ y_star hy1
      have hw2 : s_Y.base y_star ∈ (O_chart j₂ : Set ↥W) := hMemSection j₂ y_star hy2
      exact Set.disjoint_left.mp (TopologicalSpace.Opens.coe_disjoint.mpr hDisj) hw1 hw2
    have hSubUniv : (Set.univ : Set ↥W) ⊆ ⋃ j : J, (O_chart j : Set ↥W) := by
      intro w _
      obtain ⟨j, p, hp⟩ := hCovW w
      exact Set.mem_iUnion.mpr ⟨j, ⟨p, hp⟩⟩
    have hPreW : IsPreirreducible (Set.univ : Set ↥W) :=
      IsPreirreducible.of_subset_iUnion hPairwise hPre_O isOpen_univ hSubUniv
    haveI : PreirreducibleSpace ↥W := ⟨hPreW⟩
    haveI : IrreducibleSpace ↥W := ⟨⟨s_Y.base (Classical.choice hNeY)⟩⟩
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced W

  induction δ with
  | zero =>
    refine ⟨?_, ?_, ?_⟩
    · change AlgebraicGeometry.IsProper (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
      infer_instance
    · change AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec (CommRingCat.of k))
      infer_instance
    · change AlgebraicGeometry.SmoothOfRelativeDimension 0
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
      infer_instance
  | succ d ih =>
    obtain ⟨hProp_d, hInt_d, hSm_d⟩ := ih
    let Y := weilPolyP1Over k d
    letI : AlgebraicGeometry.IsProper Y.hom := hProp_d
    letI : AlgebraicGeometry.IsProper P₁.hom := hProp_P1
    letI : AlgebraicGeometry.SmoothOfRelativeDimension d Y.hom := hSm_d
    refine ⟨?_, ?_, ?_⟩
    · change AlgebraicGeometry.IsProper
        (CategoryTheory.Limits.pullback.fst Y.hom P₁.hom ≫ Y.hom)
      infer_instance
    · exact hPillarC Y hInt_d
    · have hSm_fst : AlgebraicGeometry.SmoothOfRelativeDimension 1
          (CategoryTheory.Limits.pullback.fst Y.hom P₁.hom) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)
          (CategoryTheory.IsPullback.of_hasPullback Y.hom P₁.hom).flip hSm_P1
      letI := hSm_fst
      have hSm_comp : AlgebraicGeometry.SmoothOfRelativeDimension (1 + d)
          (CategoryTheory.Limits.pullback.fst Y.hom P₁.hom ≫ Y.hom) := inferInstance
      rw [Nat.add_comm 1 d] at hSm_comp
      exact hSm_comp

theorem weil_alt_cd_noetherian_closed_reduction_and_dim_zero (k : Type u) [Field k] [IsAlgClosed k]
    (m ℓ q : ℕ) (hq : 2 * m < q)
    (hIntegralPos : ∀ (e : ℕ), 1 ≤ e → e ≤ m →
      ∀ (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsProper V.hom] [AlgebraicGeometry.IsIntegral V.left],
        topologicalKrullDim V.left = (e : WithBot ℕ∞) →
        ∀ (𝒢 : CategoryTheory.Sheaf V.left.smallEtaleTopology AddCommGrpCat.{u}),
          ℓ • CategoryTheory.CategoryStruct.id 𝒢 = 0 →
          Subsingleton (𝒢.H q))
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper W.hom]
    (hDimW : topologicalKrullDim W.left ≤ (m : WithBot ℕ∞))
    (ℱ : CategoryTheory.Sheaf W.left.smallEtaleTopology AddCommGrpCat.{u})
    (hℓ_ℱ : ℓ • CategoryTheory.CategoryStruct.id ℱ = 0) :
    Subsingleton (ℱ.H q) :=
by
  
  
  
  have hAffLift : ∀ {A A_Z B_Z_ring : Type u} [CommRing A] [CommRing A_Z] [CommRing B_Z_ring]
      (π : A →+* A_Z) (_hπ_surj : Function.Surjective π)
      (f_Z : A_Z →+* B_Z_ring) (_hf_et : RingHom.Etale f_Z),
      ∃ (B_A : Type u) (_ : CommRing B_A) (g_A : A →+* B_A) (π_B : B_A →+* B_Z_ring),
        RingHom.Etale g_A ∧
        π_B.comp g_A = f_Z.comp π ∧
        CategoryTheory.IsPushout (CommRingCat.ofHom g_A) (CommRingCat.ofHom π)
          (CommRingCat.ofHom π_B) (CommRingCat.ofHom f_Z) := by
    clear * -
    intro A A_Z B_Z_ring _ _ _ π hπ_surj f_Z hf_et
    let _ : Algebra A_Z B_Z_ring := f_Z.toAlgebra
    have : Algebra.Etale A_Z B_Z_ring := RingHom.etale_algebraMap.mp hf_et
    have hStd₀ : Algebra.IsStandardSmoothOfRelativeDimension 0 A_Z B_Z_ring :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
    rcases hStd₀.out with ⟨ι₀, σ₀, hFin_σ, hFin_ι, P₀, hdim₀⟩
    obtain ⟨n_v, ⟨e_ι⟩⟩ := @Finite.exists_equiv_fin ι₀ hFin_ι
    obtain ⟨n_r, ⟨e_σ⟩⟩ := @Finite.exists_equiv_fin σ₀ hFin_σ
    let P_Z : Algebra.SubmersivePresentation A_Z B_Z_ring (Fin n_v) (Fin n_r) :=
      P₀.reindex e_ι.symm e_σ.symm
    have hcard_ι : Nat.card ι₀ = n_v :=
      (Nat.card_congr e_ι).trans (Nat.card_fin n_v)
    have hcard_σ : Nat.card σ₀ = n_r :=
      (Nat.card_congr e_σ).trans (Nat.card_fin n_r)
    have hdim_sub : n_v - n_r = 0 := by
      change Nat.card ι₀ - Nat.card σ₀ = 0 at hdim₀
      rwa [hcard_ι, hcard_σ] at hdim₀
    let rel_A : Fin n_r → MvPolynomial (Fin n_v) A :=
      fun c => Classical.choose (MvPolynomial.map_surjective π hπ_surj (P_Z.relation c))
    have hrel_A : ∀ c : Fin n_r, MvPolynomial.map π (rel_A c) = P_Z.relation c :=
      fun c => Classical.choose_spec (MvPolynomial.map_surjective π hπ_surj (P_Z.relation c))
    let I_A : Ideal (MvPolynomial (Fin n_v) A) := Ideal.span (Set.range rel_A)
    let Q_A : Type u := MvPolynomial (Fin n_v) A ⧸ I_A
    let P_Q : Algebra.PreSubmersivePresentation A Q_A (Fin n_v) (Fin n_r) :=
      Algebra.PreSubmersivePresentation.naive (v := rel_A) P_Z.map P_Z.map_inj
    let j_Q : Q_A := P_Q.jacobian
    let B_A : Type u := Localization.Away j_Q
    let g_A : A →+* B_A := algebraMap A B_A
    let Q_loc : Algebra.PreSubmersivePresentation Q_A B_A Unit Unit :=
      Algebra.PreSubmersivePresentation.localizationAway B_A j_Q
    let P_tot : Algebra.PreSubmersivePresentation A B_A (Unit ⊕ Fin n_v) (Unit ⊕ Fin n_r) :=
      Q_loc.comp P_Q
    have hUnit_jQ : IsUnit (algebraMap Q_A B_A j_Q) := IsLocalization.Away.algebraMap_isUnit j_Q
    have hUnit_tot : IsUnit P_tot.jacobian := by
      dsimp only [P_tot]
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
        Algebra.PreSubmersivePresentation.localizationAway_jacobian, Algebra.smul_def]
      exact hUnit_jQ.mul hUnit_jQ
    let P_sub_tot : Algebra.SubmersivePresentation A B_A (Unit ⊕ Fin n_v) (Unit ⊕ Fin n_r) :=
      { __ := P_tot, jacobian_isUnit := hUnit_tot }
    have hdim_tot : P_sub_tot.dimension = 0 := by
      change (Q_loc.comp P_Q).dimension = 0
      rw [Algebra.PreSubmersivePresentation.dimension_comp_eq_dimension_add_dimension]
      have hd₁ : Q_loc.dimension = 0 := by
        change Nat.card Unit - Nat.card Unit = 0
        omega
      have hd₂ : P_Q.dimension = 0 := by
        change Nat.card (Fin n_v) - Nat.card (Fin n_r) = 0
        rw [Nat.card_fin, Nat.card_fin]
        exact hdim_sub
      omega
    have hStd_A : Algebra.IsStandardSmoothOfRelativeDimension 0 A B_A :=
      ⟨⟨Unit ⊕ Fin n_v, Unit ⊕ Fin n_r, inferInstance, inferInstance, P_sub_tot, hdim_tot⟩⟩
    have hEt_alg : Algebra.Etale A B_A :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr hStd_A
    have hg_et : RingHom.Etale g_A := RingHom.etale_algebraMap.mpr hEt_alg
    let aeval_Z : MvPolynomial (Fin n_v) A_Z →+* B_Z_ring := (MvPolynomial.aeval P_Z.val).toRingHom
    have hker_Z : Ideal.span (Set.range P_Z.relation) = RingHom.ker aeval_Z := by
      have hspan := P_Z.span_range_relation_eq_ker
      have halg : algebraMap P_Z.Ring B_Z_ring = aeval_Z :=
        RingHom.ext (fun x => P_Z.algebraMap_apply x)
      exact hspan.trans (congrArg RingHom.ker halg)
    let φ_poly : MvPolynomial (Fin n_v) A →+* B_Z_ring := aeval_Z.comp (MvPolynomial.map π)
    have hI_le_ker : I_A ≤ RingHom.ker φ_poly := by
      rw [Ideal.span_le]
      rintro _ ⟨c, rfl⟩
      change aeval_Z (MvPolynomial.map π (rel_A c)) = 0
      rw [hrel_A c]
      have hmem : P_Z.relation c ∈ RingHom.ker aeval_Z := by
        rw [← hker_Z]
        exact Ideal.subset_span ⟨c, rfl⟩
      exact hmem
    let q₀ : Q_A →+* B_Z_ring := Ideal.Quotient.lift I_A φ_poly hI_le_ker
    have hq₀_jQ : q₀ j_Q = P_Z.jacobian := by
      dsimp only [j_Q]
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
        Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
        P_Z.algebraMap_apply]
      change aeval_Z ((MvPolynomial.map π) P_Q.jacobiMatrix.det) = aeval_Z P_Z.jacobiMatrix.det
      congr 1
      rw [RingHom.map_det]
      congr 1
      refine Matrix.ext (fun i j => ?_)
      change MvPolynomial.map π (P_Q.jacobiMatrix i j) = P_Z.jacobiMatrix i j
      rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      have hmap_eq : P_Q.map i = P_Z.map i := rfl
      have hrel_eq : P_Q.relation j = rel_A j := rfl
      rw [hmap_eq, hrel_eq, ← MvPolynomial.pderiv_map, hrel_A j]
    have hUnit_q₀ : IsUnit (q₀ j_Q) := by
      rw [hq₀_jQ]
      exact P_Z.jacobian_isUnit
    let π_B : B_A →+* B_Z_ring := IsLocalization.Away.lift j_Q hUnit_q₀
    have hπB_q₀ : π_B.comp (algebraMap Q_A B_A) = q₀ :=
      RingHom.ext (fun x => IsLocalization.Away.lift_eq j_Q hUnit_q₀ x)
    have hπB_comm : π_B.comp g_A = f_Z.comp π := by
      ext a
      change π_B (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.C a))) = f_Z (π a)
      have h1 := RingHom.congr_fun hπB_q₀ (Ideal.Quotient.mk I_A (MvPolynomial.C a))
      rw [RingHom.comp_apply] at h1
      rw [h1]
      change (MvPolynomial.aeval P_Z.val) (MvPolynomial.map π (MvPolynomial.C a)) = f_Z (π a)
      rw [MvPolynomial.map_C]
      exact MvPolynomial.aeval_C P_Z.val (π a)
    have hπB_surj : Function.Surjective π_B := by
      intro b
      obtain ⟨p_Z, hp_Z⟩ := P_Z.aeval_val_surjective b
      obtain ⟨p_A, hp_A⟩ := MvPolynomial.map_surjective π hπ_surj p_Z
      refine ⟨algebraMap Q_A B_A (Ideal.Quotient.mk I_A p_A), ?_⟩
      have h1 := RingHom.congr_fun hπB_q₀ (Ideal.Quotient.mk I_A p_A)
      rw [RingHom.comp_apply] at h1
      rw [h1]
      change aeval_Z (MvPolynomial.map π p_A) = b
      rw [hp_A]
      exact hp_Z
    have hcomm_cat : CommRingCat.ofHom g_A ≫ CommRingCat.ofHom π_B =
        CommRingCat.ofHom π ≫ CommRingCat.ofHom f_Z := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hπB_comm]
    let e_quot : (MvPolynomial (Fin n_v) A_Z ⧸ RingHom.ker aeval_Z) ≃+* B_Z_ring :=
      RingHom.quotientKerEquivOfSurjective P_Z.aeval_val_surjective
    have he_quot_symm : ∀ p_Z : MvPolynomial (Fin n_v) A_Z,
        e_quot.symm (aeval_Z p_Z) = Ideal.Quotient.mk (RingHom.ker aeval_Z) p_Z := by
      intro p_Z
      apply e_quot.injective
      rw [e_quot.apply_symm_apply]
      rfl
    have hdesc_cone : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom g_A) (CommRingCat.ofHom π)),
        ∃ w : B_Z_ring →+* ↑s.pt,
          w.comp π_B = s.inl.hom ∧ w.comp f_Z = s.inr.hom := by
      intro s
      let u₁ : B_A →+* ↑s.pt := s.inl.hom
      let u₂ : A_Z →+* ↑s.pt := s.inr.hom
      have hu_comm : u₁.comp g_A = u₂.comp π := congrArg CommRingCat.Hom.hom s.condition
      let x_R : Fin n_v → ↑s.pt :=
        fun i => u₁ (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.X i)))
      let ψ_R : MvPolynomial (Fin n_v) A_Z →+* ↑s.pt := MvPolynomial.eval₂Hom u₂ x_R
      have hψ_map : ψ_R.comp (MvPolynomial.map π) =
          u₁.comp ((algebraMap Q_A B_A).comp (Ideal.Quotient.mk I_A)) := by
        apply MvPolynomial.ringHom_ext'
        · ext a
          change ψ_R (MvPolynomial.map π (MvPolynomial.C a)) = u₁ (g_A a)
          rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
          exact (RingHom.congr_fun hu_comm a).symm
        · intro i
          change ψ_R (MvPolynomial.map π (MvPolynomial.X i)) = x_R i
          rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
      have hker_le : RingHom.ker aeval_Z ≤ RingHom.ker ψ_R := by
        rw [← hker_Z, Ideal.span_le]
        rintro _ ⟨c, rfl⟩
        change ψ_R (P_Z.relation c) = 0
        rw [← hrel_A c]
        have h1 := RingHom.congr_fun hψ_map (rel_A c)
        rw [RingHom.comp_apply] at h1
        rw [h1]
        have hmk0 : Ideal.Quotient.mk I_A (rel_A c) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨c, rfl⟩)
        simp [hmk0]
      have hker_zero : ∀ a ∈ RingHom.ker aeval_Z, ψ_R a = 0 := fun _ ha => hker_le ha
      let w : B_Z_ring →+* ↑s.pt :=
        (Ideal.Quotient.lift (RingHom.ker aeval_Z) ψ_R hker_zero).comp e_quot.symm.toRingHom
      have hw_aeval : ∀ p_Z : MvPolynomial (Fin n_v) A_Z, w (aeval_Z p_Z) = ψ_R p_Z := by
        intro p_Z
        change Ideal.Quotient.lift (RingHom.ker aeval_Z) ψ_R hker_zero (e_quot.symm (aeval_Z p_Z)) =
          ψ_R p_Z
        rw [he_quot_symm p_Z]
        exact Ideal.Quotient.lift_mk (RingHom.ker aeval_Z) ψ_R hker_zero
      refine ⟨w, ?_, ?_⟩
      · apply IsLocalization.ringHom_ext (Submonoid.powers j_Q)
        rw [RingHom.comp_assoc, hπB_q₀]
        refine RingHom.ext (fun p_q => ?_)
        obtain ⟨p_A, rfl⟩ := Ideal.Quotient.mk_surjective p_q
        change w (aeval_Z (MvPolynomial.map π p_A)) =
          u₁ (algebraMap Q_A B_A (Ideal.Quotient.mk I_A p_A))
        rw [hw_aeval]
        exact RingHom.congr_fun hψ_map p_A
      · refine RingHom.ext (fun a_z => ?_)
        have hC : aeval_Z (MvPolynomial.C a_z) = f_Z a_z := MvPolynomial.aeval_C P_Z.val a_z
        change w (f_Z a_z) = u₂ a_z
        rw [← hC, hw_aeval, MvPolynomial.eval₂Hom_C]
    have hColim : Limits.IsColimit
        (Limits.PushoutCocone.mk (CommRingCat.ofHom π_B) (CommRingCat.ofHom f_Z) hcomm_cat) := by
      refine Limits.PushoutCocone.IsColimit.mk hcomm_cat
        (fun s => CommRingCat.ofHom (Classical.choose (hdesc_cone s)))
        (fun s => CommRingCat.Hom.ext (Classical.choose_spec (hdesc_cone s)).1)
        (fun s => CommRingCat.Hom.ext (Classical.choose_spec (hdesc_cone s)).2)
        (fun s m hm₁ _ => CommRingCat.Hom.ext (RingHom.ext fun b => by
          obtain ⟨a, rfl⟩ := hπB_surj b
          exact (congrArg (fun k : CommRingCat.of B_A ⟶ s.pt => k a) hm₁).trans
            (RingHom.congr_fun (Classical.choose_spec (hdesc_cone s)).1 a).symm))
    exact ⟨B_A, inferInstance, g_A, π_B, hg_et, hπB_comm,
      { w := hcomm_cat, isColimit' := ⟨hColim⟩ }⟩

  
  
  
  have hPtSieve_glob : ∀ {W : Scheme.{u}} {U : W.Etale} {R : Sieve U},
      (∀ x : ↥U.left, ∃ (Y : W.Etale) (f : Y ⟶ U) (y : ↥Y.left),
        R.arrows f ∧ Etale f.left ∧ f.left y = x) →
      R ∈ W.smallEtaleTopology U := by
    clear * -
    intro W U R hpt
    let P_et : MorphismProperty Scheme.{u} := @Etale
    have hJ := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology W (le_refl P_et)
    change R ∈ Scheme.smallGrothendieckTopology P_et W U
    rw [hJ]
    exact (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U R).mpr hpt
  have hEmptySheafSub_glob : ∀ {W : Scheme.{u}}
      (𝒢 : Sheaf W.smallEtaleTopology AddCommGrpCat.{u}) (W₀ : W.Etale),
      IsEmpty ↥W₀.left → Subsingleton (𝒢.obj.obj (Opposite.op W₀)) := by
    clear * - hPtSieve_glob
    intro W 𝒢 W₀ hEmp
    have hF_type : Presieve.IsSheaf W.smallEtaleTopology (𝒢.obj ⋙ forget AddCommGrpCat.{u}) := by
      rw [← isSheaf_iff_isSheaf_of_type]
      exact Presheaf.isSheaf_comp_of_isSheaf W.smallEtaleTopology 𝒢.obj
        (forget AddCommGrpCat.{u}) 𝒢.property
    refine ⟨fun a b => ?_⟩
    have hbot : (⊥ : Sieve W₀) ∈ W.smallEtaleTopology W₀ :=
      hPtSieve_glob (fun x => IsEmpty.elim hEmp x)
    obtain ⟨t₀, _, ht₀_uniq⟩ := (hF_type ⊥ hbot)
      (fun _ _ hf => False.elim hf)
      (fun _ _ _ _ _ _ _ hf₁ _ _ => False.elim hf₁)
    exact (ht₀_uniq a (fun _ _ hf => False.elim hf)).trans
      (ht₀_uniq b (fun _ _ hf => False.elim hf)).symm

  
  
  
  have hClosedDevissage : ∀ (S : AlgebraicGeometry.Scheme.{u})
      {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (i₁ : Quiver.Hom Y₁ S) (i₂ : Quiver.Hom Y₂ S)
      [AlgebraicGeometry.IsClosedImmersion i₁] [AlgebraicGeometry.IsClosedImmersion i₂]
      (_hCover : Set.range i₁.base ∪ Set.range i₂.base = Set.univ)
      (ℓ₀ q₀ : ℕ)
      (_hVan₁ : ∀ (𝒢₁ : CategoryTheory.Sheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ₀ • CategoryTheory.CategoryStruct.id 𝒢₁ = 0 → Subsingleton (𝒢₁.H q₀))
      (_hVan₂ : ∀ (𝒢₂ : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ₀ • CategoryTheory.CategoryStruct.id 𝒢₂ = 0 → Subsingleton (𝒢₂.H q₀))
      (ℱ₀ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (_hℓ_ℱ₀ : ℓ₀ • CategoryTheory.CategoryStruct.id ℱ₀ = 0),
      Subsingleton (ℱ₀.H q₀) := by
    clear * - hAffLift
    intro S Y₁ Y₂ i₁ i₂ _ _ hCover ℓ₀ q₀ hVan₁ hVan₂ ℱ₀ hℓ_ℱ₀
    let P_et : MorphismProperty Scheme.{u} := @Etale
    let J_S := S.smallEtaleTopology
    have hPtSieve : ∀ {W : Scheme.{u}} {U : W.Etale} {R : Sieve U},
        (∀ x : ↥U.left, ∃ (Y : W.Etale) (f : Y ⟶ U) (y : ↥Y.left),
          R.arrows f ∧ Etale f.left ∧ f.left y = x) →
        R ∈ W.smallEtaleTopology U := by
      intro W U R hpt
      have hJ := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology W (le_refl P_et)
      change R ∈ Scheme.smallGrothendieckTopology P_et W U
      rw [hJ]
      exact (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U R).mpr hpt
    have hSievePt : ∀ {W : Scheme.{u}} {U : W.Etale} {R : Sieve U},
        R ∈ W.smallEtaleTopology U →
        ∀ x : ↥U.left, ∃ (Y : W.Etale) (f : Y ⟶ U) (y : ↥Y.left),
          R.arrows f ∧ Etale f.left ∧ f.left y = x := by
      intro W U R hR x
      have hJ := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology W (le_refl P_et)
      have hR' : R ∈ (Scheme.smallPretopology P_et P_et).toGrothendieck U := by
        change R ∈ Scheme.smallGrothendieckTopology P_et W U at hR
        rwa [hJ] at hR
      exact (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U R).mp hR' x
    have hEtLeft : ∀ {W : Scheme.{u}} {U₁ U₂ : W.Etale} (f : U₁ ⟶ U₂), Etale f.left := by
      intro W U₁ U₂ f
      have hcomp : P_et (f.left ≫ U₂.hom) := by
        rw [MorphismProperty.Over.w f]
        exact U₁.prop
      exact @MorphismProperty.of_postcomp _ _ P_et P_et _ U₁.left U₂.left W f.left U₂.hom U₂.prop hcomp
    have hEmptySheafSub : ∀ {W : Scheme.{u}} (𝒢 : Sheaf W.smallEtaleTopology AddCommGrpCat.{u})
        (W₀ : W.Etale),
        IsEmpty ↥W₀.left → Subsingleton (𝒢.obj.obj (Opposite.op W₀)) := by
      intro W 𝒢 W₀ hEmp
      have hF_type : Presieve.IsSheaf W.smallEtaleTopology (𝒢.obj ⋙ forget AddCommGrpCat.{u}) := by
        rw [← isSheaf_iff_isSheaf_of_type]
        exact Presheaf.isSheaf_comp_of_isSheaf W.smallEtaleTopology 𝒢.obj
          (forget AddCommGrpCat.{u}) 𝒢.property
      refine ⟨fun a b => ?_⟩
      have hbot : (⊥ : Sieve W₀) ∈ W.smallEtaleTopology W₀ := hPtSieve (fun x => IsEmpty.elim hEmp x)
      obtain ⟨t₀, _, ht₀_uniq⟩ := (hF_type ⊥ hbot)
        (fun _ _ hf => False.elim hf)
        (fun _ _ _ _ _ _ _ hf₁ _ _ => False.elim hf₁)
      exact (ht₀_uniq a (fun _ _ hf => False.elim hf)).trans
        (ht₀_uniq b (fun _ _ hf => False.elim hf)).symm
    
    let e_small := equivSmallModel.{u} S.AffineEtale
    let g₀ : SmallModel.{u} S.AffineEtale → S.Etale := fun idx =>
      let W_obj := e_small.inverse.obj idx
      MorphismProperty.Over.mk ⊤ W_obj.hom W_obj.prop
    let Stage_S : ℕ → Σ (X : Type u), (X → S.Etale) :=
      Nat.rec
        ⟨PUnit.{u + 1} ⊕ SmallModel.{u} S.AffineEtale, Sum.elim (fun _ => ⊤_ S.Etale) g₀⟩
        (fun _ prev =>
          ⟨prev.1 ⊕ Σ (a b c : prev.1) (f₁ : prev.2 a ⟶ prev.2 c) (f₂ : prev.2 b ⟶ prev.2 c),
            PUnit.{1},
           Sum.elim prev.2 (fun p => Limits.pullback p.2.2.2.1 p.2.2.2.2.1)⟩)
    let Idx_S : Type u := Σ n₀ : ℕ, (Stage_S n₀).1
    let eval_S : Idx_S → S.Etale := fun p => (Stage_S p.1).2 p.2
    let D_S : Type u := InducedCategory S.Etale eval_S
    let G_S : D_S ⥤ S.Etale := inducedFunctor eval_S
    have lift_add : ∀ (n₀ d₀ : ℕ) (x : (Stage_S n₀).1),
        ∃ y : (Stage_S (n₀ + d₀)).1, (Stage_S (n₀ + d₀)).2 y = (Stage_S n₀).2 x := by
      intro n₀ d₀ x
      induction d₀ with
      | zero => exact ⟨x, rfl⟩
      | succ d₀ ih =>
        obtain ⟨y, hy⟩ := ih
        exact ⟨Sum.inl y, hy⟩
    have lift_le : ∀ {n₀ N : ℕ} (hle : n₀ ≤ N) (x : (Stage_S n₀).1),
        ∃ y : (Stage_S N).1, (Stage_S N).2 y = eval_S ⟨n₀, x⟩ := by
      intro n₀ N hle x
      obtain ⟨y, hy⟩ := lift_add n₀ (N - n₀) x
      have hN : n₀ + (N - n₀) = N := Nat.add_sub_of_le hle
      revert y
      rw [hN]
      exact fun y hy => ⟨y, hy⟩
    let t₀ : D_S := (⟨0, Sum.inl PUnit.unit⟩ : Idx_S)
    have ht₀ : Limits.IsTerminal t₀ :=
      Limits.IsTerminal.ofUniqueHom
        (fun d => InducedCategory.homMk (Limits.terminal.from (eval_S d)))
        (fun d f => InducedCategory.hom_ext (Limits.terminal.hom_ext f.hom _))
    have : Limits.HasTerminal D_S := ht₀.hasTerminal
    have hPresTerm : Limits.PreservesLimit (Functor.empty.{0} D_S) G_S := by
      have hmap_term : Limits.IsLimit (G_S.mapCone (Limits.asEmptyCone t₀)) :=
        { lift := fun s => (Limits.terminal.from s.pt : s.pt ⟶ ⊤_ S.Etale)
          fac := fun s j => j.as.elim
          uniq := fun s f _ => Limits.terminal.hom_ext (f : s.pt ⟶ ⊤_ S.Etale) _ }
      exact Limits.preservesLimit_of_preserves_limit_cone ht₀ hmap_term
    have : Limits.PreservesLimitsOfShape (Discrete PEmpty.{1}) G_S :=
      Limits.preservesLimitsOfShape_pempty_of_preservesTerminal G_S
    have hCospan : ∀ (K : Limits.WalkingCospan ⥤ D_S),
        ∃ (c : Limits.Cone K), Nonempty (Limits.IsLimit (G_S.mapCone c)) := by
      intro K
      let d₁ : Idx_S := K.obj Limits.WalkingCospan.left
      let d₂ : Idx_S := K.obj Limits.WalkingCospan.right
      let d₃ : Idx_S := K.obj Limits.WalkingCospan.one
      let u : K.obj Limits.WalkingCospan.left ⟶ K.obj Limits.WalkingCospan.one :=
        K.map Limits.WalkingCospan.Hom.inl
      let v : K.obj Limits.WalkingCospan.right ⟶ K.obj Limits.WalkingCospan.one :=
        K.map Limits.WalkingCospan.Hom.inr
      obtain ⟨N, ⟨x₁, hx₁⟩, ⟨x₂, hx₂⟩, ⟨x₃, hx₃⟩⟩ :
          ∃ N : ℕ,
            (∃ x₁ : (Stage_S N).1, (Stage_S N).2 x₁ = G_S.obj (K.obj Limits.WalkingCospan.left)) ∧
            (∃ x₂ : (Stage_S N).1, (Stage_S N).2 x₂ = G_S.obj (K.obj Limits.WalkingCospan.right)) ∧
            (∃ x₃ : (Stage_S N).1, (Stage_S N).2 x₃ = G_S.obj (K.obj Limits.WalkingCospan.one)) :=
        ⟨max d₁.1 (max d₂.1 d₃.1),
          lift_le (le_max_left _ _) d₁.2,
          lift_le ((le_max_left _ _).trans (le_max_right _ _)) d₂.2,
          lift_le ((le_max_right _ _).trans (le_max_right _ _)) d₃.2⟩
      let X₁ : S.Etale := (Stage_S N).2 x₁
      let X₂ : S.Etale := (Stage_S N).2 x₂
      let X₃ : S.Etale := (Stage_S N).2 x₃
      let f₁ : X₁ ⟶ X₃ := eqToHom hx₁ ≫ G_S.map u ≫ eqToHom hx₃.symm
      let f₂ : X₂ ⟶ X₃ := eqToHom hx₂ ≫ G_S.map v ≫ eqToHom hx₃.symm
      let pr₁_et : Limits.pullback f₁ f₂ ⟶ G_S.obj (K.obj Limits.WalkingCospan.left) :=
        Limits.pullback.fst f₁ f₂ ≫ eqToHom hx₁
      let pr₂_et : Limits.pullback f₁ f₂ ⟶ G_S.obj (K.obj Limits.WalkingCospan.right) :=
        Limits.pullback.snd f₁ f₂ ≫ eqToHom hx₂
      have hcond_et : pr₁_et ≫ G_S.map u = pr₂_et ≫ G_S.map v := by
        have hpb_f : Limits.pullback.fst f₁ f₂ ≫ f₁ = Limits.pullback.snd f₁ f₂ ≫ f₂ :=
          Limits.pullback.condition
        have h1 : (Limits.pullback.fst f₁ f₂ ≫ f₁) ≫ eqToHom hx₃ = pr₁_et ≫ G_S.map u := by
          dsimp only [f₁, pr₁_et]
          rw [Category.assoc, Category.assoc, Category.assoc, eqToHom_trans, eqToHom_refl,
            Category.comp_id, Category.assoc]
        have h2 : (Limits.pullback.snd f₁ f₂ ≫ f₂) ≫ eqToHom hx₃ = pr₂_et ≫ G_S.map v := by
          dsimp only [f₂, pr₂_et]
          rw [Category.assoc, Category.assoc, Category.assoc, eqToHom_trans, eqToHom_refl,
            Category.comp_id, Category.assoc]
        rw [← h1, ← h2, hpb_f]
      have hlim_pure : Limits.IsLimit (Limits.PullbackCone.mk pr₁_et pr₂_et hcond_et) := by
        refine Limits.PullbackCone.IsLimit.mk hcond_et
          (fun s => Limits.pullback.lift (s.fst ≫ eqToHom hx₁.symm) (s.snd ≫ eqToHom hx₂.symm) (by
            dsimp only [f₁, f₂]
            rw [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp,
              Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp,
              ← Category.assoc, s.condition, Category.assoc]))
          (fun s => by
            dsimp only [pr₁_et]
            rw [← Category.assoc, Limits.pullback.lift_fst, Category.assoc,
              eqToHom_trans, eqToHom_refl, Category.comp_id])
          (fun s => by
            dsimp only [pr₂_et]
            rw [← Category.assoc, Limits.pullback.lift_snd, Category.assoc,
              eqToHom_trans, eqToHom_refl, Category.comp_id])
          (fun s f hm₁ hm₂ => by
            apply Limits.pullback.hom_ext
            · rw [Limits.pullback.lift_fst, ← hm₁]
              dsimp only [pr₁_et]
              rw [Category.assoc, Category.assoc, eqToHom_trans, eqToHom_refl, Category.comp_id]
            · rw [Limits.pullback.lift_snd, ← hm₂]
              dsimp only [pr₂_et]
              rw [Category.assoc, Category.assoc, eqToHom_trans, eqToHom_refl, Category.comp_id])
      let p_obj : D_S := (⟨N + 1, Sum.inr ⟨x₁, x₂, x₃, f₁, f₂, PUnit.unit⟩⟩ : Idx_S)
      let p₁ : p_obj ⟶ K.obj Limits.WalkingCospan.left := InducedCategory.homMk pr₁_et
      let p₂ : p_obj ⟶ K.obj Limits.WalkingCospan.right := InducedCategory.homMk pr₂_et
      have hcond_D : p₁ ≫ u = p₂ ≫ v := InducedCategory.hom_ext hcond_et
      let c₀ : Limits.PullbackCone u v := Limits.PullbackCone.mk p₁ p₂ hcond_D
      have hc₀_lim : Limits.IsLimit (G_S.mapCone c₀) :=
        (Limits.PullbackCone.isLimitMapConeEquiv c₀ G_S).symm hlim_pure
      let c : Limits.Cone K := (Limits.Cone.postcompose (Limits.diagramIsoCospan K).inv).obj c₀
      refine ⟨c, ⟨?_⟩⟩
      let isoMap : G_S.mapCone c ≅
          (Limits.Cone.postcompose (Functor.isoWhiskerRight (Limits.diagramIsoCospan K) G_S).inv).obj
            (G_S.mapCone c₀) :=
        Limits.Cone.ext (Iso.refl _) (fun j => by
          dsimp [c]
          rw [Functor.map_comp, Category.id_comp])
      exact Limits.IsLimit.ofIsoLimit
        ((Limits.IsLimit.postcomposeInvEquiv
          (Functor.isoWhiskerRight (Limits.diagramIsoCospan K) G_S) _).symm hc₀_lim)
        isoMap.symm
    have : Limits.HasPullbacks D_S :=
      ⟨fun K =>
        let ⟨c, ⟨hc⟩⟩ := hCospan K
        ⟨⟨c, Limits.isLimitOfReflects G_S hc⟩⟩⟩
    have : Limits.PreservesLimitsOfShape Limits.WalkingCospan G_S :=
      ⟨fun {K} =>
        let ⟨c, ⟨hc⟩⟩ := hCospan K
        Limits.preservesLimit_of_preserves_limit_cone (Limits.isLimitOfReflects G_S hc) hc⟩
    have : Limits.HasFiniteLimits D_S :=
      Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have : Limits.PreservesFiniteLimits G_S :=
      Limits.preservesFiniteLimits_of_preservesTerminal_and_pullbacks G_S
    
    have hStage0OfSpec : ∀ {U : S.Etale} (R_aff : CommRingCat.{u})
        (f_spec : Spec R_aff ⟶ U.left) (hf_et : Etale f_spec),
        let V_et : S.Etale := MorphismProperty.Over.mk ⊤ (f_spec ≫ U.hom)
          (MorphismProperty.comp_mem P_et _ _ hf_et U.prop)
        ∃ (d_i : D_S) (s_hom : (G_S.obj d_i).left ⟶ Spec R_aff)
          (s_inv : Spec R_aff ⟶ (G_S.obj d_i).left)
          (v_et : G_S.obj d_i ⟶ V_et) (u_et : G_S.obj d_i ⟶ U),
          s_inv ≫ s_hom = 𝟙 (Spec R_aff) ∧
          u_et = v_et ≫ MorphismProperty.Over.homMk f_spec rfl ∧
