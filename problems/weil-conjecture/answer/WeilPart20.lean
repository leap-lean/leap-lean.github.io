    let L₁ := j₁.1.1
    let L₂ := j₂.1.1
    have _ : FiniteDimensional K ↥L₁.1 := L₁.2.1
    have _ : IsGalois K ↥L₁.1 := L₁.2.2
    have _ : Normal K ↥L₁.1 := L₁.2.2.to_normal
    have _ : FiniteDimensional K ↥L₂.1 := L₂.2.1
    have _ : IsGalois K ↥L₂.1 := L₂.2.2
    have _ : Normal K ↥L₂.1 := L₂.2.2.to_normal
    let E₃ : IntermediateField K K_sep := L₁.1 ⊔ L₂.1
