    have hξ_zero : ξ = 0 := (evH0 S₀ ℱ₀).injective (hev_zero.trans (map_zero _).symm)
    exact ⟨E₀, hE₀, le_rfl, fun p₁ _ => by rw [hξ_zero, map_zero]⟩

  · 
    intro ζ
    let z_L := evH0 S_L (P_L.obj ℱ₀) ζ
    obtain ⟨K_L, _, _, _, _, _, M₀, _, _, _, _, _, ψ₀, hψ₀, s_M₀, hz_KL⟩ :=
      (hFieldPullPresAndInj E₀.subtype ℱ₀).2 z_L
    obtain ⟨E₁, hE₁, hle, N₁, _, _, _, _, _, ψ₁, hψ₁,
