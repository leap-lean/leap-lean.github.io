      let p_snd : (B.obj (Tid S₂)).left ⟶ S₁ :=
        CategoryTheory.Limits.pullback.snd (CategoryTheory.CategoryStruct.id S₂) h
      have hp_snd : CategoryTheory.IsIso p_snd :=
        CategoryTheory.Limits.pullback_snd_iso_of_left_iso (CategoryTheory.CategoryStruct.id S₂) h
      let e_pb : B.obj (Tid S₂) ≅ Tid S₁ :=
        CategoryTheory.MorphismProperty.Over.isoMk (@CategoryTheory.asIso _ _ _ _ p_snd hp_snd)
          (CategoryTheory.Category.comp_id p_snd)
      let e₁ : Tid S₁ ≅ T₁ := (hTid S₁).uniqueUpToIso hT₁
      let e_τ : B.obj T₂ ≅ T₁ := (B.mapIso e₂).trans (e_pb.trans e₁)
      have hτ_eq : τ = e_τ.hom := hT₁.hom_ext τ e_τ.hom
      let Γ₁ := (CategoryTheory.sheafSections J₁ AddCommGrpCat.{u}).obj (Opposite.op T₁)
      let Γ₂ := (CategoryTheory.sheafSections J₂ AddCommGrpCat.{u}).obj (Opposite.op T₂)
      let θ : Γ₁ ≅ P_push.comp Γ₂ :=
        CategoryTheory.NatIso.ofComponents
          (fun ℱ =>
            { hom := ℱ.obj.map τ.op
              inv := ℱ.obj.map e_τ.inv.op
              hom_inv_id := by
                change ℱ.obj.map τ.op ≫ ℱ.obj.map e_τ.inv.op =
                  CategoryTheory.CategoryStruct.id (ℱ.obj.obj (Opposite.op T₁))
                rw [← ℱ.obj.map_comp, ← op_comp, hτ_eq, e_τ.inv_hom_id, op_id, ℱ.obj.map_id]
