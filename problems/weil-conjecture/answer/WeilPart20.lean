      hGaloisSubfieldDescent L 𝒟 hNe hDir hExh E₀ hE₀ K_L M₀ ψ₀ hψ₀
    refine ⟨E₁, hE₁, hle, ?_⟩
    intro h₁ h₁L _hCont₁ _hAdj₁ _hCont₁L _hAdj₁L
    let S₁ := AlgebraicGeometry.Spec (CommRingCat.of ↥E₁)
    let J₁ := S₁.smallEtaleTopology
    have hh_comp : h₁L ≫ h₁ = hL := by
      dsimp [h₁L, h₁, hL]
      rw [← AlgebraicGeometry.Spec.map_comp]
      rfl
    let B₁ := weilAltCdSitePullback h₁
    let B₁L := weilAltCdSitePullback h₁L
    haveI : B₁.IsContinuous J₀ J₁ := _hCont₁
    haveI : (B₁.sheafPushforwardContinuous A J₀ J₁).IsRightAdjoint := _hAdj₁
    haveI : B₁L.IsContinuous J₁ J_L := _hCont₁L
    haveI : (B₁L.sheafPushforwardContinuous A J₁ J_L).IsRightAdjoint := _hAdj₁L
    let P₁ := B₁.sheafPullback A J₀ J₁
    let P₁L := B₁L.sheafPullback A J₁ J_L
    let adj_p₁ := B₁.sheafAdjunctionContinuous A J₀ J₁
    let adj_p₁L := B₁L.sheafAdjunctionContinuous A J₁ J_L
    obtain ⟨η, hη_iso, hη_unit⟩ := hCompPullIso h₁L h₁ hL hh_comp
    refine ⟨η, hη_iso, ?_⟩

    let W_M₀ := weilAltCdSpecEtaleObj ↥E₀ M₀
    let V_N₁ := weilAltCdSpecEtaleObj ↥E₁ N₁
    let V_NL := weilAltCdSpecEtaleObj L N_L
    let U_KL := weilAltCdSpecEtaleObj L K_L
    let T₁_id := weilEtaleIdTerminal.{u} S₁
    let hT₁_id := weilEtaleIdTerminalIsTerminal.{u} S₁
    let u_N₁ : V_N₁ ⟶ T₁_id := hT₁_id.from V_N₁
    let u_NL : V_NL ⟶ T_L_id := hT_L_id.from V_NL
    let u_KL : U_KL ⟶ T_L_id := hT_L_id.from U_KL

    have hψ_0L : (ι₁L.comp ψ₁).comp (algebraMap ↥E₀ M₀) = (algebraMap L N_L).comp E₀.subtype := by
      ext c
      change ι₁L (ψ₁ (algebraMap ↥E₀ M₀ c)) = algebraMap L N_L (E₀.subtype c)
      rw [show ι₁L (ψ₁ (algebraMap ↥E₀ M₀ c)) = ι_K (ψ₀ (algebraMap ↥E₀ M₀ c)) from
          congrFun (congrArg DFunLike.coe hComm) _,
