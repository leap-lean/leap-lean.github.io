          let W := B_f.obj U
          have hSub_b : Subsingleton (CategoryTheory.Abelian.Ext (L_W W) S_ex.X₂ b) := hInjSub W b hb
          have hSub_b1 : Subsingleton (CategoryTheory.Abelian.Ext (L_W W) S_ex.X₂ (b + 1)) :=
            hInjSub W (b + 1) (by omega)
