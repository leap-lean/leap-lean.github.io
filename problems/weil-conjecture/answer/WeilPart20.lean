                  rw [← hb_fac, CategoryTheory.Category.assoc, hσ_fst']
        have h_cancel := congrArg (· ≫ e.inv) h_post
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
