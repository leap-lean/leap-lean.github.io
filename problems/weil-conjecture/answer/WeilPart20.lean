      have hnat₁ := (shAdj₁.unit.app PA₁).naturality (hTa.from (B.obj U₂)).op
      change 𝟙 A ≫ u_BU₂ = u_Ta ≫ (C₁.obj A).obj.map (hTa.from (B.obj U₂)).op at hnat₁
      rw [CategoryTheory.Category.id_comp] at hnat₁
