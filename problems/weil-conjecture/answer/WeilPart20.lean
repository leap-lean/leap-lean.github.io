          · exact (hglue0_d G₂ Y _).trans
              ((map_zero (φ.hom.app (Opposite.op (Y₂_of Y))).hom).symm.trans
                ((congrArg ((φ.hom.app (Opposite.op (Y₂_of Y))).hom)
                  (hglue0_d G₁ Y x₁')).symm.trans
