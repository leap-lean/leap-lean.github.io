  let c_site : ∀ Y : X₀.Etale, j_s.obj (B_s.obj Y) ⟶ Y := fun Y =>
    let y_hom := (FgtX.obj Y).hom
    CategoryTheory.MorphismProperty.Over.homMk
      (CategoryTheory.Limits.pullback.fst y_hom s)
      (CategoryTheory.Limits.pullback.condition (f := y_hom) (g := s)) trivial
  have hη_site_nat : ∀ {W₁ W₂ : S.Etale} (f : W₁ ⟶ W₂),
      CategoryTheory.CategoryStruct.comp f (η_site W₂) =
        CategoryTheory.CategoryStruct.comp (η_site W₁) (B_s.map (j_s.map f)) := by
    intro W₁ W₂ f
    refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact ((CategoryTheory.Category.assoc _ _ _).trans
        (congrArg _ (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
        ((CategoryTheory.Category.comp_id _).trans
          (((CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans
            (CategoryTheory.Category.id_comp _)).symm.trans
            ((CategoryTheory.Category.assoc _ _ _).trans
