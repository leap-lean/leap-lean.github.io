    have hz_NL : (((P_L.obj ℱ₀).obj.map u_NL.op).hom) z_L =
        pullSec E₀.subtype (ι₁L.comp ψ₁) hψ_0L ℱ₀ s_M₀ := by
      let map_K_NL := weilAltCdSpecEtaleMap L ι_K
      have hu_eq : map_K_NL ≫ u_KL = u_NL := hT_L_id.hom_ext _ _
      rw [← hu_eq, op_comp, CategoryTheory.Functor.map_comp]
      change (((P_L.obj ℱ₀).obj.map map_K_NL.op).hom)
        ((((P_L.obj ℱ₀).obj.map u_KL.op).hom) z_L) = _
      rw [hz_KL]
      have hw_eq : map_K_NL ≫ wPullSec E₀.subtype ψ₀ hψ₀ =
          wPullSec E₀.subtype (ι₁L.comp ψ₁) hψ_0L := by
        have hw₁_fst : (wPullSec E₀.subtype ψ₀ hψ₀).left ≫
            CategoryTheory.Limits.pullback.fst W_M₀.hom hL =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) :=
