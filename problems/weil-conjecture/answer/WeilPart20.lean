        rw [← Subobject.underlyingIso_hom_comp_eq_mk, Iso.inv_hom_id_assoc, Limits.image.fac]
      calc
        u₁ ≫ (Subobject.mk (Limits.image.ι (i ≫ f₂))).arrow ≫
            Limits.cokernel.π (Subobject.mk (Limits.image.ι f₂)).arrow
