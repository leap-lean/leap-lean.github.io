          { obj := fun M => ⟨skyPresheaf.obj M, hIsSheaf M⟩
            map := fun k => { hom := skyPresheaf.map k }
            map_id := fun M => CategoryTheory.Sheaf.hom_ext (skyPresheaf.map_id M)
            map_comp := fun f g => CategoryTheory.Sheaf.hom_ext (skyPresheaf.map_comp f g) }
        Nonempty (ev_Ω ⊣ sky_Ω) := by
    intro Ω _ _ S_Ω J_Ω T_Ω ev_Ω skyPresheaf
    let Fgt_Ω := AlgebraicGeometry.Scheme.Etale.forget S_Ω
    let pt_Ω : ↥S_Ω := (⊥ : PrimeSpectrum Ω)
    have hFactor : ∀ (W : S_Ω.Etale) (R : CategoryTheory.Sieve W),
        R ∈ J_Ω W → ∀ (u : T_Ω ⟶ W),
          ∃ (Y₀ : S_Ω.Etale) (f : Y₀ ⟶ W) (v : T_Ω ⟶ Y₀), R.arrows f ∧ v ≫ f = u := by
      intro W R hR u
      let fu : S_Ω ⟶ (Fgt_Ω.obj W).left := (Fgt_Ω.map u).left
      obtain ⟨Y₀, f, y₀, hfR, hEt_f, hy₀⟩ :=
        (hMemTop S_Ω W R).mp hR (fu.base pt_Ω)
      let ff := (Fgt_Ω.map f).left
      have hEt_ff : AlgebraicGeometry.Etale ff := hEt_f
      obtain ⟨z₀, -, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := ff) (g := fu) y₀ pt_Ω hy₀
      have hEt_snd : AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.snd ff fu) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.Etale)
          (CategoryTheory.IsPullback.of_hasPullback ff fu) hEt_ff
      obtain ⟨s₀, hs₀, -⟩ :=
        @hEtaleSecAt Ω _ _ (CategoryTheory.Limits.pullback ff fu)
          (CategoryTheory.Limits.pullback.snd ff fu) hEt_snd z₀
      let v_left : S_Ω ⟶ (Fgt_Ω.obj Y₀).left :=
        s₀ ≫ CategoryTheory.Limits.pullback.fst ff fu
      have hv_f : v_left ≫ ff = fu := by
        dsimp [v_left]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
          ← CategoryTheory.Category.assoc, hs₀, CategoryTheory.Category.id_comp]
      have hv_hom : v_left ≫ Y₀.hom = T_Ω.hom := by
        change v_left ≫ (Fgt_Ω.obj Y₀).hom = (Fgt_Ω.obj T_Ω).hom
        rw [← (Fgt_Ω.map f).w, ← CategoryTheory.Category.assoc, hv_f]
        exact (Fgt_Ω.map u).w
      let v : T_Ω ⟶ Y₀ := CategoryTheory.MorphismProperty.Over.homMk v_left hv_hom trivial
      exact ⟨Y₀, f, v, hfR, CategoryTheory.MorphismProperty.Over.Hom.ext hv_f⟩
    have hIsSheaf : ∀ M : AddCommGrpCat.{u},
        CategoryTheory.Presheaf.IsSheaf J_Ω (skyPresheaf.obj M) := by
      intro M E W R hR x hx
      have hIndep : ∀ (u : T_Ω ⟶ W) (e : ↑E)
          (Y₁ : S_Ω.Etale) (f₁ : Y₁ ⟶ W) (hf₁ : R.arrows f₁) (v₁ : T_Ω ⟶ Y₁) (hv₁ : v₁ ≫ f₁ = u)
          (Y₂ : S_Ω.Etale) (f₂ : Y₂ ⟶ W) (hf₂ : R.arrows f₂) (v₂ : T_Ω ⟶ Y₂) (hv₂ : v₂ ≫ f₂ = u),
          ((x f₁ hf₁).hom e) v₁ = ((x f₂ hf₂).hom e) v₂ := by
        intro u e Y₁ f₁ hf₁ v₁ hv₁ Y₂ f₂ hf₂ v₂ hv₂
        let P₁₂ : S_Ω.Etale := CategoryTheory.Limits.pullback f₁ f₂
        let g₁ : P₁₂ ⟶ Y₁ := CategoryTheory.Limits.pullback.fst f₁ f₂
        let g₂ : P₁₂ ⟶ Y₂ := CategoryTheory.Limits.pullback.snd f₁ f₂
        let v₁₂ : T_Ω ⟶ P₁₂ := CategoryTheory.Limits.pullback.lift v₁ v₂ (hv₁.trans hv₂.symm)
        have hc := hx g₁ g₂ hf₁ hf₂ CategoryTheory.Limits.pullback.condition
        have hc_ev := congrArg
          (fun φ : E ⟶ (skyPresheaf.obj M).obj (Opposite.op P₁₂) => (φ.hom e) v₁₂) hc
        change ((x f₁ hf₁).hom e) (v₁₂ ≫ g₁) = ((x f₂ hf₂).hom e) (v₁₂ ≫ g₂) at hc_ev
        rwa [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_snd] at hc_ev
      let amal : E ⟶ (skyPresheaf.obj M).obj (Opposite.op W) :=
        AddCommGrpCat.ofHom
          { toFun := fun e u =>
              let ch := hFactor W R hR u
              ((x ch.choose_spec.choose ch.choose_spec.choose_spec.choose_spec.1).hom e)
                ch.choose_spec.choose_spec.choose
            map_zero' := funext fun u => by
              let ch := hFactor W R hR u
              change ((x _ _).hom 0) _ = 0
              rw [map_zero]
              rfl
            map_add' := fun e₁ e₂ => funext fun u => by
              let ch := hFactor W R hR u
              change ((x _ _).hom (e₁ + e₂)) _ = ((x _ _).hom e₁) _ + ((x _ _).hom e₂) _
              rw [map_add]
              rfl }
      refine ⟨amal, ?_, ?_⟩
      · intro Y f hf
        apply AddCommGrpCat.ext
        intro e
        funext v
        let ch := hFactor W R hR (v ≫ f)
        exact hIndep (v ≫ f) e
          ch.choose ch.choose_spec.choose ch.choose_spec.choose_spec.choose_spec.1
          ch.choose_spec.choose_spec.choose ch.choose_spec.choose_spec.choose_spec.2
          Y f hf v rfl
      · intro amal' hamal'
        apply AddCommGrpCat.ext
        intro e
        funext u
        let ch := hFactor W R hR u
        let Y₀ := ch.choose
        let f₀ := ch.choose_spec.choose
        let v₀ := ch.choose_spec.choose_spec.choose
        have hf₀ : R.arrows f₀ := ch.choose_spec.choose_spec.choose_spec.1
        have hv₀ : v₀ ≫ f₀ = u := ch.choose_spec.choose_spec.choose_spec.2
        have h1 := congrArg
          (fun φ : E ⟶ (skyPresheaf.obj M).obj (Opposite.op Y₀) => (φ.hom e) v₀)
          (hamal' f₀ hf₀)
        change (amal'.hom e) (v₀ ≫ f₀) = ((x f₀ hf₀).hom e) v₀ at h1
        rw [hv₀] at h1
        exact h1
    refine ⟨hIsSheaf, ?_⟩
    intro sky_Ω
    let homEquivFn : ∀ (F : CategoryTheory.Sheaf J_Ω AddCommGrpCat.{u}) (M : AddCommGrpCat.{u}),
        (ev_Ω.obj F ⟶ M) ≃ (F ⟶ sky_Ω.obj M) := fun F M =>
      { toFun := fun φ =>
          { hom :=
              { app := fun W => AddCommGrpCat.ofHom
                  { toFun := fun sec u => φ.hom ((F.obj.map u.op).hom sec)
                    map_zero' := funext fun u => by simp
                    map_add' := fun s₁ s₂ => funext fun u => by simp }
                naturality := fun {W₁ W₂} g => AddCommGrpCat.ext fun sec => funext fun u => by
                  change φ.hom ((F.obj.map u.op).hom ((F.obj.map g).hom sec)) =
                    φ.hom ((F.obj.map (u ≫ g.unop).op).hom sec)
                  have hcomp := congrArg (fun ψ => φ.hom (ψ.hom sec)) (F.obj.map_comp g u.op)
                  simpa [op_comp] using hcomp.symm } }
        invFun := fun η =>
          AddCommGrpCat.ofHom
            { toFun := fun sec => ((η.hom.app (Opposite.op T_Ω)).hom sec) (𝟙 T_Ω)
              map_zero' := by
                change ((η.hom.app (Opposite.op T_Ω)).hom 0) (𝟙 T_Ω) = 0
                rw [map_zero]
                rfl
              map_add' := fun s₁ s₂ => by
                change ((η.hom.app (Opposite.op T_Ω)).hom (s₁ + s₂)) (𝟙 T_Ω) = _
                rw [map_add]
                rfl }
        left_inv := fun φ => AddCommGrpCat.ext fun sec => by
          change φ.hom ((F.obj.map (Opposite.op (𝟙 T_Ω))).hom sec) = φ.hom sec
          have hid : F.obj.map (Opposite.op (𝟙 T_Ω)) = 𝟙 (F.obj.obj (Opposite.op T_Ω)) :=
            F.obj.map_id (Opposite.op T_Ω)
          rw [hid]
          rfl
        right_inv := fun η => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext W
          apply AddCommGrpCat.ext
          intro sec
          funext u
          have hnat := congrArg (fun ψ => (ψ.hom sec) (𝟙 T_Ω)) (η.hom.naturality u.op)
          change ((η.hom.app (Opposite.op T_Ω)).hom ((F.obj.map u.op).hom sec)) (𝟙 T_Ω) =
            ((η.hom.app W).hom sec) (𝟙 T_Ω ≫ u) at hnat
          rw [CategoryTheory.Category.id_comp] at hnat
          exact hnat }
    exact ⟨CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := homEquivFn
        homEquiv_naturality_left_symm := fun {F' F M} h η => AddCommGrpCat.ext fun sec => rfl
        homEquiv_naturality_right := fun {F M M'} φ k => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext W
          apply AddCommGrpCat.ext
          intro sec
          rfl }⟩

  
  have hZeroStalk : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (y : ↥S),
        let κ := S.residueField y
        let Ω := AlgebraicClosure ↥κ
        let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
        let bar_y : Quiver.Hom S_Ω S :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
            (S.fromSpecResidueField y)
        Subsingleton ↥((((weilEtaleSitePullback bar_y).sheafPullback AddCommGrpCat.{u}
          S.smallEtaleTopology S_Ω.smallEtaleTopology).obj G).obj.obj
          (Opposite.op (weilEtaleIdTerminal S_Ω)))) →
      CategoryTheory.Limits.IsZero G := by
    intro S G hSub
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext W_op
    let W : S.Etale := W_op.unop
    apply AddCommGrpCat.ext
    intro sec
    change sec = 0
    have hLocalZero : ∀ w : ↥W.left,
        ∃ (V : S.Etale) (f : V ⟶ W) (v : ↥V.left),
          AlgebraicGeometry.Etale f.left ∧ f.left.base v = w ∧ G.obj.map f.op sec = 0 := by
      intro w
      let y : ↥S := W.hom.base w
      let κ := S.residueField y
      let Ω := AlgebraicClosure ↥κ
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let T_Ω := weilEtaleIdTerminal S_Ω
      let pt_Ω : ↥S_Ω := (⊥ : PrimeSpectrum Ω)
      let bar_y : Quiver.Hom S_Ω S :=
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
          (S.fromSpecResidueField y)
      have hbar_pt : bar_y.base pt_Ω = y := by
        change (S.fromSpecResidueField y).base
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω))).base pt_Ω) = y
        exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply y _
      let Fgt_S := AlgebraicGeometry.Scheme.Etale.forget S
      let Fgt_Ω := AlgebraicGeometry.Scheme.Etale.forget S_Ω
      let B_y := weilEtaleSitePullback bar_y
      let fib_y : S.Etale ⥤ Type u := B_y ⋙ CategoryTheory.coyoneda.obj (Opposite.op T_Ω)
      haveI : CategoryTheory.Limits.PreservesFiniteLimits B_y := hPresLimSite bar_y
      haveI : CategoryTheory.IsCofiltered fib_y.Elements :=
        CategoryTheory.Functor.isCofiltered_elements fib_y
      let ι_aff : CategoryTheory.SmallModel.{u} S.AffineEtale ⥤ S.Etale :=
        (CategoryTheory.equivSmallModel.{u} S.AffineEtale).inverse ⋙
          AlgebraicGeometry.Scheme.AffineEtale.Spec S
      let initSet : Set fib_y.Elements :=
        Set.range (fun p : Σ m : CategoryTheory.SmallModel.{u} S.AffineEtale,
          fib_y.obj (ι_aff.obj m) => CategoryTheory.Functor.elementsMk fib_y (ι_aff.obj p.1) p.2)
      haveI : CategoryTheory.InitiallySmall.{u} fib_y.Elements := by
        refine CategoryTheory.initiallySmall_of_small_weakly_initial_set initSet ?_
        intro elem
        let U_e : S.Etale := elem.fst
        let σ_e : T_Ω ⟶ B_y.obj U_e := elem.snd
        let f_σe : S_Ω ⟶ (Fgt_Ω.obj (B_y.obj U_e)).left := (Fgt_Ω.map σ_e).left
        let p_fst_Ue : (Fgt_Ω.obj (B_y.obj U_e)).left ⟶ (Fgt_S.obj U_e).left :=
          CategoryTheory.Limits.pullback.fst ((Fgt_S.obj U_e).hom) bar_y
        let p_snd_Ue : (Fgt_Ω.obj (B_y.obj U_e)).left ⟶ S_Ω :=
          CategoryTheory.Limits.pullback.snd ((Fgt_S.obj U_e).hom) bar_y
        have h_pb_Ue : p_fst_Ue ≫ (Fgt_S.obj U_e).hom = p_snd_Ue ≫ bar_y :=
          CategoryTheory.Limits.pullback.condition
        let γ_e : S_Ω ⟶ (Fgt_S.obj U_e).left := f_σe ≫ p_fst_Ue
        let u_pt : ↥((Fgt_S.obj U_e).left) := γ_e.base pt_Ω
        obtain ⟨O_u, hAff_u, hu_mem, -⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := u_pt) (U := (⊤ : ((Fgt_S.obj U_e).left).Opens)) trivial
        let R_u := ((Fgt_S.obj U_e).left).presheaf.obj (Opposite.op O_u)
        haveI : AlgebraicGeometry.Etale ((Fgt_S.obj U_e).hom) := U_e.prop
        haveI : AlgebraicGeometry.Etale (hAff_u.fromSpec ≫ (Fgt_S.obj U_e).hom) := inferInstance
        let A_et : S.AffineEtale :=
          AlgebraicGeometry.Scheme.AffineEtale.mk (R := R_u) (hAff_u.fromSpec ≫ (Fgt_S.obj U_e).hom)
        let m₀ : CategoryTheory.SmallModel.{u} S.AffineEtale :=
          (CategoryTheory.equivSmallModel.{u} S.AffineEtale).functor.obj A_et
        let iso_m₀ : ι_aff.obj m₀ ≅ (AlgebraicGeometry.Scheme.AffineEtale.Spec S).obj A_et :=
          (AlgebraicGeometry.Scheme.AffineEtale.Spec S).mapIso
            ((CategoryTheory.equivSmallModel.{u} S.AffineEtale).unitIso.symm.app A_et)
        let inv_left : AlgebraicGeometry.Spec R_u ⟶ (Fgt_S.obj (ι_aff.obj m₀)).left :=
          (Fgt_S.map iso_m₀.inv).left
        let hom_left : (Fgt_S.obj (ι_aff.obj m₀)).left ⟶ AlgebraicGeometry.Spec R_u :=
          (Fgt_S.map iso_m₀.hom).left
        let j_A : (AlgebraicGeometry.Scheme.AffineEtale.Spec S).obj A_et ⟶ U_e :=
          CategoryTheory.MorphismProperty.Over.homMk hAff_u.fromSpec rfl trivial
        let g_m₀ : ι_aff.obj m₀ ⟶ U_e := iso_m₀.hom ≫ j_A
        have hSub_Ω : Subsingleton ↥S_Ω := by
          change Subsingleton (PrimeSpectrum Ω)
          infer_instance
        have hrange_γ : Set.range γ_e.base ⊆ Set.range hAff_u.fromSpec.base := by
          rintro _ ⟨pt', rfl⟩
          rw [hSub_Ω.elim pt' pt_Ω, hAff_u.range_fromSpec]
          exact hu_mem
        let γ_lift : S_Ω ⟶ AlgebraicGeometry.Spec R_u :=
          AlgebraicGeometry.IsOpenImmersion.lift hAff_u.fromSpec γ_e hrange_γ
        have hγ_fac : γ_lift ≫ hAff_u.fromSpec = γ_e :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac hAff_u.fromSpec γ_e hrange_γ
        have hγ_bar : (γ_lift ≫ inv_left) ≫ (Fgt_S.obj (ι_aff.obj m₀)).hom =
            𝟙 S_Ω ≫ bar_y := by
          have hw_inv : inv_left ≫ (Fgt_S.obj (ι_aff.obj m₀)).hom =
              hAff_u.fromSpec ≫ (Fgt_S.obj U_e).hom :=
            (Fgt_S.map iso_m₀.inv).w
          have hw_σe : f_σe ≫ p_snd_Ue = 𝟙 S_Ω := (Fgt_Ω.map σ_e).w
          rw [CategoryTheory.Category.assoc, hw_inv, ← CategoryTheory.Category.assoc, hγ_fac]
          dsimp [γ_e]
          rw [CategoryTheory.Category.assoc, h_pb_Ue, ← CategoryTheory.Category.assoc, hw_σe]
        let σ_m₀ : T_Ω ⟶ B_y.obj (ι_aff.obj m₀) :=
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.Limits.pullback.lift (γ_lift ≫ inv_left) (𝟙 S_Ω) hγ_bar)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
        have hσ_map : fib_y.map g_m₀ σ_m₀ = σ_e := by
          change σ_m₀ ≫ B_y.map g_m₀ = σ_e
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          let f_σm₀ : S_Ω ⟶ (Fgt_Ω.obj (B_y.obj (ι_aff.obj m₀))).left := (Fgt_Ω.map σ_m₀).left
          let p_fst_m₀ : (Fgt_Ω.obj (B_y.obj (ι_aff.obj m₀))).left ⟶
              (Fgt_S.obj (ι_aff.obj m₀)).left :=
            CategoryTheory.Limits.pullback.fst ((Fgt_S.obj (ι_aff.obj m₀)).hom) bar_y
          change f_σm₀ ≫ (Fgt_Ω.map (B_y.map g_m₀)).left = f_σe
          apply CategoryTheory.Limits.pullback.hom_ext
          · have hB_fst : (Fgt_Ω.map (B_y.map g_m₀)).left ≫ p_fst_Ue =
                p_fst_m₀ ≫ (Fgt_S.map g_m₀).left :=
              CategoryTheory.Limits.pullback.lift_fst _ _ _
            have hσ_fst0 : f_σm₀ ≫ p_fst_m₀ = γ_lift ≫ inv_left :=
              CategoryTheory.Limits.pullback.lift_fst _ _ _
            change (f_σm₀ ≫ (Fgt_Ω.map (B_y.map g_m₀)).left) ≫ p_fst_Ue = γ_e
            rw [CategoryTheory.Category.assoc, hB_fst, ← CategoryTheory.Category.assoc, hσ_fst0]
            change (γ_lift ≫ inv_left) ≫ (hom_left ≫ hAff_u.fromSpec) = γ_e
            have h_iso_id : inv_left ≫ hom_left = 𝟙 _ := by
              change (Fgt_S.map iso_m₀.inv).left ≫ (Fgt_S.map iso_m₀.hom).left = 𝟙 _
              rw [← CategoryTheory.Over.comp_left, ← Fgt_S.map_comp, iso_m₀.inv_hom_id,
                Fgt_S.map_id]
              rfl
            calc (γ_lift ≫ inv_left) ≫ (hom_left ≫ hAff_u.fromSpec)
                = γ_lift ≫ (inv_left ≫ hom_left) ≫ hAff_u.fromSpec := by
                    simp only [CategoryTheory.Category.assoc]
              _ = γ_e := by
                    rw [h_iso_id, CategoryTheory.Category.id_comp, hγ_fac]
          · exact (Fgt_Ω.map (σ_m₀ ≫ B_y.map g_m₀)).w.trans (Fgt_Ω.map σ_e).w.symm
        refine ⟨CategoryTheory.Functor.elementsMk fib_y (ι_aff.obj m₀) σ_m₀, ⟨⟨m₀, σ_m₀⟩, rfl⟩,
          ⟨CategoryTheory.CategoryOfElements.homMk g_m₀ hσ_map⟩⟩
      let Φ_y : CategoryTheory.GrothendieckTopology.Point.{u} S.smallEtaleTopology :=
        { fiber := fib_y
          jointly_surjective := by
            intro U_x R hR σ_x
            let f_σx : S_Ω ⟶ (Fgt_Ω.obj (B_y.obj U_x)).left := (Fgt_Ω.map σ_x).left
            let p_fst_Ux : (Fgt_Ω.obj (B_y.obj U_x)).left ⟶ (Fgt_S.obj U_x).left :=
              CategoryTheory.Limits.pullback.fst ((Fgt_S.obj U_x).hom) bar_y
            let p_snd_Ux : (Fgt_Ω.obj (B_y.obj U_x)).left ⟶ S_Ω :=
              CategoryTheory.Limits.pullback.snd ((Fgt_S.obj U_x).hom) bar_y
            have h_pb_Ux : p_fst_Ux ≫ (Fgt_S.obj U_x).hom = p_snd_Ux ≫ bar_y :=
              CategoryTheory.Limits.pullback.condition
            let γ_x : S_Ω ⟶ (Fgt_S.obj U_x).left := f_σx ≫ p_fst_Ux
            obtain ⟨Y₀, f, y₀, hfR, hEt_f, hy₀⟩ :=
              (hMemTop S U_x R).mp hR (γ_x.base pt_Ω)
            let ff := (Fgt_S.map f).left
            have hEt_ff : AlgebraicGeometry.Etale ff := hEt_f
            obtain ⟨z₀, -, -⟩ :=
              AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
                (f := ff) (g := γ_x) y₀ pt_Ω hy₀
            let P₀ := CategoryTheory.Limits.pullback ff γ_x
            let p₂ : P₀ ⟶ S_Ω := CategoryTheory.Limits.pullback.snd ff γ_x
            have hEt_p₂ : AlgebraicGeometry.Etale p₂ :=
              CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
                (P := @AlgebraicGeometry.Etale)
                (CategoryTheory.IsPullback.of_hasPullback ff γ_x) hEt_ff
            obtain ⟨s₀, hs₀, -⟩ := @hEtaleSecAt Ω _ _ P₀ p₂ hEt_p₂ z₀
            let γ_Y : S_Ω ⟶ (Fgt_S.obj Y₀).left := s₀ ≫ CategoryTheory.Limits.pullback.fst ff γ_x
            have hγY_f : γ_Y ≫ ff = γ_x := by
              dsimp [γ_Y]
              rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
                ← CategoryTheory.Category.assoc, hs₀, CategoryTheory.Category.id_comp]
            have hγY_bar : γ_Y ≫ (Fgt_S.obj Y₀).hom = 𝟙 S_Ω ≫ bar_y := by
              have hw_f : ff ≫ (Fgt_S.obj U_x).hom = (Fgt_S.obj Y₀).hom := (Fgt_S.map f).w
              have hw_σx : f_σx ≫ p_snd_Ux = 𝟙 S_Ω := (Fgt_Ω.map σ_x).w
              rw [← hw_f, ← CategoryTheory.Category.assoc, hγY_f]
              dsimp [γ_x]
