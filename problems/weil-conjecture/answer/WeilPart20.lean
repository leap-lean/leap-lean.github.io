  have hAdjOpen : Nonempty (j_push ⊣ pf_s) := by
    refine ⟨CategoryTheory.Adjunction.mkOfUnitCounit {
      unit := {
        app := fun G => {
          hom := {
            app := fun opY => G.obj.map (Opposite.op (c_site (Opposite.unop opY)))
            naturality := fun {Y₁ Y₂} g => by
              change G.obj.map g ≫ G.obj.map (Opposite.op (c_site (Opposite.unop Y₂))) =
                G.obj.map (Opposite.op (c_site (Opposite.unop Y₁))) ≫
                  G.obj.map (Opposite.op (j_s.map (B_s.map g.unop)))
              rw [← G.obj.map_comp, ← G.obj.map_comp]
              exact congrArg (fun k => G.obj.map (Opposite.op k)) (hc_site_nat g.unop).symm } }
        naturality := fun {G₁ G₂} φ => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext opY
          exact (φ.hom.naturality (Opposite.op (c_site (Opposite.unop opY)))).symm }
      counit := {
        app := fun H => {
          hom := {
            app := fun opW => H.obj.map (Opposite.op (η_site (Opposite.unop opW)))
            naturality := fun {W₁ W₂} f => by
              change H.obj.map (Opposite.op (B_s.map (j_s.map f.unop))) ≫
                H.obj.map (Opposite.op (η_site (Opposite.unop W₂))) =
                H.obj.map (Opposite.op (η_site (Opposite.unop W₁))) ≫ H.obj.map f
              rw [← H.obj.map_comp, ← H.obj.map_comp]
              exact congrArg (fun k => H.obj.map (Opposite.op k)) (hη_site_nat f.unop).symm } }
        naturality := fun {H₁ H₂} ψ => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext opW
          exact (ψ.hom.naturality (Opposite.op (η_site (Opposite.unop opW)))).symm }
      left_triangle := by
        ext G : 2
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext opW
        change G.obj.map (Opposite.op (c_site (j_s.obj (Opposite.unop opW)))) ≫
          G.obj.map (Opposite.op (j_s.map (η_site (Opposite.unop opW)))) = 𝟙 _
        rw [← G.obj.map_comp]
        exact (congrArg (fun k => G.obj.map (Opposite.op k))
          (hSite_tri1 (Opposite.unop opW))).trans (G.obj.map_id _)
      right_triangle := by
        ext H : 2
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext opY
        change H.obj.map (Opposite.op (B_s.map (c_site (Opposite.unop opY)))) ≫
          H.obj.map (Opposite.op (η_site (B_s.obj (Opposite.unop opY)))) = 𝟙 _
        rw [← H.obj.map_comp]
        exact (congrArg (fun k => H.obj.map (Opposite.op k))
          (hSite_tri2 (Opposite.unop opY))).trans (H.obj.map_id _) }⟩

  
  have hEmptySub : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (V : Z.Etale),
      IsEmpty ↥((AlgebraicGeometry.Scheme.Etale.forget Z).obj V).left →
      Subsingleton ↥(F.obj.obj (Opposite.op V)) := by
    intro Z F V hEmp
    have hBot : ⊥ ∈ Z.smallEtaleTopology V :=
      (hMemEtaleTop V ⊥).mpr (fun x => IsEmpty.elim hEmp x)
    have hTerm : CategoryTheory.Limits.IsTerminal (F.obj.obj (Opposite.op V)) :=
      CategoryTheory.Sheaf.isTerminalOfBotCover F V hBot
    have hZero : CategoryTheory.Limits.IsZero (F.obj.obj (Opposite.op V)) :=
      CategoryTheory.Limits.IsTerminal.isZero hTerm
    refine ⟨fun a b => ?_⟩
    have hid0 : CategoryTheory.CategoryStruct.id (F.obj.obj (Opposite.op V)) = 0 :=
      hZero.eq_of_src _ _
    calc
      a = (CategoryTheory.CategoryStruct.id (F.obj.obj (Opposite.op V))).hom a := rfl
      _ = (0 : F.obj.obj (Opposite.op V) ⟶ F.obj.obj (Opposite.op V)).hom a := by rw [hid0]
      _ = 0 := rfl
      _ = (0 : F.obj.obj (Opposite.op V) ⟶ F.obj.obj (Opposite.op V)).hom b := rfl
      _ = (CategoryTheory.CategoryStruct.id (F.obj.obj (Opposite.op V))).hom b := by rw [hid0]
      _ = b := rfl

  have hClosed_range : IsClosed (Set.range s.base) := s.isClosedEmbedding.isClosed_range
  let O₂ : X₀.Opens := ⟨(Set.range s.base)ᶜ, hClosed_range.isOpen_compl⟩
  let U₂_of : ∀ Y : X₀.Etale, ((FgtX.obj Y).left).Opens :=
    fun Y => (TopologicalSpace.Opens.map ((FgtX.obj Y).hom).base).obj O₂
  let Y₂_of : ∀ Y : X₀.Etale, X₀.Etale := fun Y =>
    letI : AlgebraicGeometry.Etale ((FgtX.obj Y).hom) := Y.prop
    CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.comp (U₂_of Y).ι ((FgtX.obj Y).hom)) inferInstance
  let d_site : ∀ Y : X₀.Etale, Y₂_of Y ⟶ Y := fun Y =>
    CategoryTheory.MorphismProperty.Over.homMk (U₂_of Y).ι rfl trivial

  have hc_range : ∀ (Y : X₀.Etale) (x : ↥(FgtX.obj Y).left),
      ((FgtX.obj Y).hom).base x ∈ Set.range s.base →
      x ∈ Set.range ((FgtX.map (c_site Y)).left).base := by
    intro Y x ⟨w, hw⟩
    obtain ⟨z, hz_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
        (f := (FgtX.obj Y).hom) (g := s) x w hw.symm
    exact ⟨z, hz_fst⟩

  have hd_range : ∀ (Y : X₀.Etale) (x : ↥(FgtX.obj Y).left),
      ((FgtX.obj Y).hom).base x ∉ Set.range s.base →
      x ∈ Set.range ((FgtX.map (d_site Y)).left).base := by
    intro Y x hx
    exact ⟨⟨x, hx⟩, rfl⟩

  have hDisj_cd : ∀ (Y : X₀.Etale) (x : ↥(FgtX.obj Y).left),
      x ∈ Set.range ((FgtX.map (c_site Y)).left).base →
      x ∈ Set.range ((FgtX.map (d_site Y)).left).base → False := by
    intro Y x ⟨z₁, hz₁⟩ ⟨z₂, hz₂⟩
    have h1 : ((FgtX.obj Y).hom).base x ∈ Set.range s.base := by
      rw [← hz₁]
      change (CategoryTheory.Limits.pullback.fst ((FgtX.obj Y).hom) s ≫
        (FgtX.obj Y).hom).base z₁ ∈ Set.range s.base
      rw [CategoryTheory.Limits.pullback.condition]
      exact ⟨(CategoryTheory.Limits.pullback.snd ((FgtX.obj Y).hom) s).base z₁, rfl⟩
    have h2 : ((FgtX.obj Y).hom).base x ∉ Set.range s.base := by
      rw [← hz₂]
      exact z₂.2
    exact h2 h1

  have hSheafCD : ∀ (G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (Y : X₀.Etale),
      (∀ u v : ↥(G.obj.obj (Opposite.op Y)),
        (G.obj.map (Opposite.op (c_site Y))).hom u = (G.obj.map (Opposite.op (c_site Y))).hom v →
        (G.obj.map (Opposite.op (d_site Y))).hom u = (G.obj.map (Opposite.op (d_site Y))).hom v →
        u = v) ∧
      (∀ x₁ : ↥(G.obj.obj (Opposite.op (j_s.obj (B_s.obj Y)))),
        ∃ z : ↥(G.obj.obj (Opposite.op Y)),
          (G.obj.map (Opposite.op (c_site Y))).hom z = x₁ ∧
          (G.obj.map (Opposite.op (d_site Y))).hom z = 0) := by
    intro G Y
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let toHom : ∀ (M : AddCommGrpCat.{u}), ↥M → (Aℤ ⟶ M) := fun M x =>
      AddCommGrpCat.ofHom
        { toFun := fun k => k.down • x
          map_zero' := zero_zsmul x
          map_add' := fun a b => add_zsmul x a.down b.down }
    have hToHom_comp : ∀ {M N : AddCommGrpCat.{u}} (x : ↥M) (f : M ⟶ N),
        toHom M x ≫ f = toHom N (f.hom x) := by
      intro M N x f
      ext k
      exact map_zsmul f.hom k.down x
    have hToHom_eval : ∀ {M : AddCommGrpCat.{u}} (x : ↥M),
        (toHom M x).hom (ULift.up 1) = x := fun x => one_zsmul x
    let famObj : Bool → X₀.Etale := fun b => if b then j_s.obj (B_s.obj Y) else Y₂_of Y
    let famHom : ∀ b : Bool, famObj b ⟶ Y := fun b =>
      match b with
      | true => c_site Y
      | false => d_site Y
    have hSieve : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows famObj famHom) ∈
        J_X Y := by
      rw [hMemEtaleTop Y]
      intro x
      by_cases hx : ((FgtX.obj Y).hom).base x ∈ Set.range s.base
      · exact ⟨famObj true, famHom true,
          ⟨famObj true, 𝟙 _, famHom true, CategoryTheory.Presieve.ofArrows.mk true,
            CategoryTheory.Category.id_comp _⟩,
          hc_range Y x hx⟩
      · exact ⟨famObj false, famHom false,
          ⟨famObj false, 𝟙 _, famHom false, CategoryTheory.Presieve.ofArrows.mk false,
            CategoryTheory.Category.id_comp _⟩,
          hd_range Y x hx⟩
    let P_Z := G.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ)
    have hIsSheafZ : CategoryTheory.Presieve.IsSheaf J_X P_Z := G.property Aℤ
    have hFor : CategoryTheory.Presieve.IsSheafFor P_Z
        (CategoryTheory.Presieve.ofArrows famObj famHom) :=
      (CategoryTheory.Presieve.isSheafFor_iff_generate
        (CategoryTheory.Presieve.ofArrows famObj famHom)).mpr (hIsSheafZ _ hSieve)
    rw [CategoryTheory.Presieve.isSheafFor_arrows_iff] at hFor
    have hCompat : ∀ (x_fam : ∀ b : Bool, P_Z.obj (Opposite.op (famObj b))),
        CategoryTheory.Presieve.Arrows.Compatible P_Z famHom x_fam := by
      intro x_fam b₁ b₂ V g₁ g₂ hg
      cases b₁ <;> cases b₂
      · 
        have hMono_d : CategoryTheory.Mono ((FgtX.map (d_site Y)).left) := by
          change CategoryTheory.Mono (U₂_of Y).ι
          infer_instance
        have hg_left : CategoryTheory.CategoryStruct.comp ((FgtX.map g₁).left)
            ((FgtX.map (d_site Y)).left) =
            CategoryTheory.CategoryStruct.comp ((FgtX.map g₂).left)
              ((FgtX.map (d_site Y)).left) :=
          congrArg (fun k => (FgtX.map k).left) hg
        have heq : g₁ = g₂ :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext
            ((cancel_mono ((FgtX.map (d_site Y)).left)).mp hg_left) (Subsingleton.elim _ _)
        subst heq
        rfl
      · 
        have hEmp : IsEmpty ↥(FgtX.obj V).left := ⟨fun v => by
          have hv_eq : (CategoryTheory.CategoryStruct.comp ((FgtX.map g₁).left)
              ((FgtX.map (d_site Y)).left)).base v =
              (CategoryTheory.CategoryStruct.comp ((FgtX.map g₂).left)
                ((FgtX.map (c_site Y)).left)).base v :=
            congrArg (fun k => ((FgtX.map k).left).base v) hg
          exact hDisj_cd Y (((FgtX.map (c_site Y)).left).base (((FgtX.map g₂).left).base v))
            ⟨((FgtX.map g₂).left).base v, rfl⟩
            ⟨((FgtX.map g₁).left).base v, hv_eq⟩⟩
        change (_ : Aℤ ⟶ G.obj.obj (Opposite.op V)) = _
        ext k
        exact (hEmptySub G V hEmp).elim _ _
      · 
        have hEmp : IsEmpty ↥(FgtX.obj V).left := ⟨fun v => by
          have hv_eq : (CategoryTheory.CategoryStruct.comp ((FgtX.map g₁).left)
              ((FgtX.map (c_site Y)).left)).base v =
              (CategoryTheory.CategoryStruct.comp ((FgtX.map g₂).left)
                ((FgtX.map (d_site Y)).left)).base v :=
            congrArg (fun k => ((FgtX.map k).left).base v) hg
          exact hDisj_cd Y (((FgtX.map (c_site Y)).left).base (((FgtX.map g₁).left).base v))
            ⟨((FgtX.map g₁).left).base v, rfl⟩
            ⟨((FgtX.map g₂).left).base v, hv_eq.symm⟩⟩
        change (_ : Aℤ ⟶ G.obj.obj (Opposite.op V)) = _
        ext k
        exact (hEmptySub G V hEmp).elim _ _
      · 
        have hMono_c : CategoryTheory.Mono ((FgtX.map (c_site Y)).left) := by
          change CategoryTheory.Mono (CategoryTheory.Limits.pullback.fst ((FgtX.obj Y).hom) s)
          have : AlgebraicGeometry.IsOpenImmersion
              (CategoryTheory.Limits.pullback.fst ((FgtX.obj Y).hom) s) := inferInstance
