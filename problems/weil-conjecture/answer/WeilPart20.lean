                    map_zero' := h_q_inj_app U_op (by
                      rw [Classical.choose_spec (h_ex_m u hu U_op 0), map_zero, map_zero])
                    map_add' := fun s₁ s₂ => h_q_inj_app U_op (by
                      rw [Classical.choose_spec (h_ex_m u hu U_op (s₁ + s₂)), map_add, map_add,
                        Classical.choose_spec (h_ex_m u hu U_op s₁),
                        Classical.choose_spec (h_ex_m u hu U_op s₂)]) }
              naturality := fun {U₁_op U₂_op} g => by
                ext s
                apply h_q_inj_app U₂_op
                have h_nat_q := congrArg (fun φ : M_pre.obj U₁_op ⟶ (P_b 0 S_ex.X₃).obj U₂_op =>
                  φ (Classical.choose (h_ex_m u hu U₁_op s))) (q_desc.naturality g)
                have h_nat_u := congrArg (fun φ : W_pre.obj U₁_op ⟶ (P_b 0 S_ex.X₃).obj U₂_op =>
                  φ s) (u.naturality g)
