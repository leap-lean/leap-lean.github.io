import WeilPart19
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_etale_grothendieck_ext_filtered_colimit_subsingleton (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
    let R := ULift.{u, 0} (ZMod m)
    let J := S.smallEtaleTopology
    let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
    let oneR := weilEtaleModuleUnit S m
    let T_S : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.id S)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S))
    let Γ_S : CategoryTheory.Functor 𝒞 (ModuleCat.{u, u} R) :=
      CategoryTheory.Functor.comp (CategoryTheory.sheafToPresheaf J (ModuleCat.{u, u} R))
        ((CategoryTheory.evaluation (Opposite S.Etale) (ModuleCat.{u, u} R)).obj (Opposite.op T_S))
    (∃ (I₀ : Type u) (L : I₀ → 𝒞),
      (CategoryTheory.ObjectProperty.ofObj L).IsSeparating ∧
      (∀ i : I₀, CategoryTheory.IsNoetherianObject (L i)) ∧
      (∀ i : I₀, CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u}
        (CategoryTheory.coyoneda.obj (Opposite.op (L i))))) →
    CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u} Γ_S →
    (∀ (Q : 𝒞), CategoryTheory.IsNoetherianObject Q →
      CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u}
        (CategoryTheory.coyoneda.obj (Opposite.op Q))) ∧
    (∀ (Λ : Type u) [CategoryTheory.SmallCategory Λ] [CategoryTheory.IsFiltered Λ]
        (D : CategoryTheory.Functor Λ 𝒞),
      (∀ j : Λ, CategoryTheory.Injective (D.obj j)) →
      CategoryTheory.Injective (CategoryTheory.Limits.colimit D)) ∧
    (∀ (q : ℕ) (Λ : Type u) [CategoryTheory.SmallCategory Λ] [CategoryTheory.IsFiltered Λ]
        (D : CategoryTheory.Functor Λ 𝒞),
      (∀ j : Λ, Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (D.obj j) q)) →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (CategoryTheory.Limits.colimit D) q)) ∧
    (∀ (q : ℕ) (F : 𝒞),
      (∀ (P : 𝒞), CategoryTheory.IsNoetherianObject P →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR P q)) →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR F q)) :=
by
  classical
  have h_s1 : ∀ (𝒜 : Type (u + 1)) [CategoryTheory.Category.{u + 1} 𝒜]
      [CategoryTheory.Abelian 𝒜] [CategoryTheory.IsGrothendieckAbelian.{u} 𝒜]
      (I₀ : Type u) (L : I₀ → 𝒜),
      (CategoryTheory.ObjectProperty.ofObj L).IsSeparating →
      (∀ i : I₀, CategoryTheory.IsNoetherianObject (L i)) →
      (∀ i : I₀, CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u}
        (CategoryTheory.coyoneda.obj (Opposite.op (L i)))) →
      (∀ (Q : 𝒜), CategoryTheory.IsNoetherianObject Q →
        CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u}
          (CategoryTheory.coyoneda.obj (Opposite.op Q))) ∧
      (∀ (F : 𝒜), ∃ (Λ : Type u) (_ : CategoryTheory.SmallCategory Λ)
          (_ : CategoryTheory.IsFiltered Λ) (D : CategoryTheory.Functor Λ 𝒜),
        (∀ j : Λ, CategoryTheory.IsNoetherianObject (D.obj j)) ∧
        Nonempty (CategoryTheory.Limits.colimit D ≅ F)) := by
    clear S m
    intro 𝒜 _ _ _ I₀ L hSep hNoeth hComp
    have := CategoryTheory.IsGrothendieckAbelian.locallySmall.{u} (C := 𝒜)
    have := CategoryTheory.IsGrothendieckAbelian.wellPowered.{u} (C := 𝒜)
    have := CategoryTheory.IsGrothendieckAbelian.hasFilteredColimitsOfSize.{u} (C := 𝒜)
    let Z₀ : 𝒜 := Classical.choose (CategoryTheory.Limits.HasZeroObject.zero (C := 𝒜))
    have hZero : CategoryTheory.Limits.IsZero Z₀ :=
      Classical.choose_spec (CategoryTheory.Limits.HasZeroObject.zero (C := 𝒜))
    have hNoethEpi : ∀ {X Y : 𝒜} (e : X ⟶ Y) [CategoryTheory.Epi e],
        CategoryTheory.IsNoetherianObject X → CategoryTheory.IsNoetherianObject Y := by
      intro X Y e _ hX
      have hReflect : ∀ (P₁ P₂ : CategoryTheory.Subobject Y),
          (CategoryTheory.Subobject.pullback e).obj P₂ ≤
            (CategoryTheory.Subobject.pullback e).obj P₁ → P₂ ≤ P₁ := by
        intro P₁ P₂ hpb
        let fst₁ := CategoryTheory.Limits.pullback.fst P₁.arrow e
        let snd₁ := CategoryTheory.Limits.pullback.snd P₁.arrow e
        let fst₂ := CategoryTheory.Limits.pullback.fst P₂.arrow e
        let snd₂ := CategoryTheory.Limits.pullback.snd P₂.arrow e
        have : CategoryTheory.Mono snd₁ := CategoryTheory.Limits.pullback.snd_of_mono
        have : CategoryTheory.Mono snd₂ := CategoryTheory.Limits.pullback.snd_of_mono
        have : CategoryTheory.Epi fst₂ := CategoryTheory.Abelian.epi_pullback_of_epi_g P₂.arrow e
        have hmk : CategoryTheory.Subobject.mk snd₂ ≤ CategoryTheory.Subobject.mk snd₁ := by
          simpa [snd₁, snd₂, CategoryTheory.Subobject.pullback_obj] using hpb
        let u := CategoryTheory.Subobject.ofMkLEMk snd₂ snd₁ hmk
        have hu : CategoryTheory.CategoryStruct.comp u snd₁ = snd₂ :=
          CategoryTheory.Subobject.ofMkLEMk_comp hmk
        have hcomm : CategoryTheory.CategoryStruct.comp fst₂ P₂.arrow =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp u fst₁) P₁.arrow := by
          calc
            CategoryTheory.CategoryStruct.comp fst₂ P₂.arrow
              = CategoryTheory.CategoryStruct.comp snd₂ e :=
                CategoryTheory.Limits.pullback.condition
            _ = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp u snd₁) e := by
                rw [hu]
            _ = CategoryTheory.CategoryStruct.comp u
                  (CategoryTheory.CategoryStruct.comp snd₁ e) :=
                CategoryTheory.Category.assoc _ _ _
            _ = CategoryTheory.CategoryStruct.comp u
                  (CategoryTheory.CategoryStruct.comp fst₁ P₁.arrow) := by
                rw [CategoryTheory.Limits.pullback.condition]
            _ = CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.CategoryStruct.comp u fst₁) P₁.arrow :=
                (CategoryTheory.Category.assoc _ _ _).symm
        have hcok : CategoryTheory.CategoryStruct.comp P₂.arrow
            (CategoryTheory.Limits.cokernel.π P₁.arrow) = 0 := by
          apply (CategoryTheory.cancel_epi fst₂).mp
          rw [← CategoryTheory.Category.assoc, hcomm, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.comp_zero,
            CategoryTheory.Limits.comp_zero]
        let hk := CategoryTheory.Abelian.monoIsKernelOfCokernel _
          (CategoryTheory.Limits.cokernelIsCokernel P₁.arrow)
        let fk := CategoryTheory.Limits.KernelFork.ofι P₂.arrow hcok
        exact CategoryTheory.Subobject.le_of_comm (hk.lift fk)
          (hk.fac fk CategoryTheory.Limits.WalkingParallelPair.zero)
      rw [CategoryTheory.isNoetherianObject_iff_monotone_chain_condition]
      intro f
      let g : ℕ →o CategoryTheory.Subobject X :=
        ⟨fun n => (CategoryTheory.Subobject.pullback e).obj (f n),
          fun a b hab => (CategoryTheory.Subobject.pullback e).monotone (f.monotone hab)⟩
      obtain ⟨N, hN⟩ :=
        (CategoryTheory.isNoetherianObject_iff_monotone_chain_condition X).mp hX g
      exact ⟨N, fun m hm => le_antisymm (f.monotone hm)
        (hReflect (f N) (f m) (le_of_eq (hN m hm).symm))⟩
    have hNoethBiprod : ∀ {A C : 𝒜},
        CategoryTheory.IsNoetherianObject A → CategoryTheory.IsNoetherianObject C →
        CategoryTheory.IsNoetherianObject (A ⊞ C) := by
      intro A C hA hC
      let f : A ⟶ A ⊞ C := CategoryTheory.Limits.biprod.inl
      let g : A ⊞ C ⟶ C := CategoryTheory.Limits.biprod.snd
      rw [CategoryTheory.isNoetherianObject_iff_monotone_chain_condition]
      intro P
      let P_A : ℕ →o CategoryTheory.Subobject A :=
        ⟨fun n => (CategoryTheory.Subobject.pullback f).obj (P n),
          fun a b hab => (CategoryTheory.Subobject.pullback f).monotone (P.monotone hab)⟩
      let P_C : ℕ →o CategoryTheory.Subobject C :=
        ⟨fun n => CategoryTheory.Subobject.mk
            (CategoryTheory.Limits.image.ι (CategoryTheory.CategoryStruct.comp (P n).arrow g)),
          fun a b hab => by
            let u := CategoryTheory.Subobject.ofLE (P a) (P b) (P.monotone hab)
            let mf : CategoryTheory.Limits.MonoFactorisation
                (CategoryTheory.CategoryStruct.comp (P a).arrow g) :=
              { I := CategoryTheory.Limits.image
                  (CategoryTheory.CategoryStruct.comp (P b).arrow g)
                m := CategoryTheory.Limits.image.ι
                  (CategoryTheory.CategoryStruct.comp (P b).arrow g)
                e := CategoryTheory.CategoryStruct.comp u
                  (CategoryTheory.Limits.factorThruImage
                    (CategoryTheory.CategoryStruct.comp (P b).arrow g))
                fac := by
                  rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.image.fac,
                    ← CategoryTheory.Category.assoc, CategoryTheory.Subobject.ofLE_arrow] }
            exact CategoryTheory.Subobject.mk_le_mk_of_comm
              (CategoryTheory.Limits.image.lift mf)
              (CategoryTheory.Limits.image.lift_fac mf)⟩
      obtain ⟨N_A, hN_A⟩ :=
        (CategoryTheory.isNoetherianObject_iff_monotone_chain_condition A).mp hA P_A
      obtain ⟨N_C, hN_C⟩ :=
        (CategoryTheory.isNoetherianObject_iff_monotone_chain_condition C).mp hC P_C
      let N := max N_A N_C
      refine ⟨N, fun m hm => le_antisymm (P.monotone hm) ?_⟩
      have hPA_eq : P_A N = P_A m :=
        (hN_A N (le_max_left _ _)).symm.trans (hN_A m (le_trans (le_max_left _ _) hm))
      have hPC_eq : P_C N = P_C m :=
        (hN_C N (le_max_right _ _)).symm.trans (hN_C m (le_trans (le_max_right _ _) hm))
      let i_N := (P N).arrow
      let i_m := (P m).arrow
      let u := CategoryTheory.Subobject.ofLE (P N) (P m) (P.monotone hm)
      let v := CategoryTheory.Subobject.ofMkLEMk
        (CategoryTheory.Limits.image.ι (CategoryTheory.CategoryStruct.comp i_m g))
        (CategoryTheory.Limits.image.ι (CategoryTheory.CategoryStruct.comp i_N g))
        (le_of_eq hPC_eq.symm)
      have hv : CategoryTheory.CategoryStruct.comp v
          (CategoryTheory.Limits.image.ι (CategoryTheory.CategoryStruct.comp i_N g)) =
          CategoryTheory.Limits.image.ι (CategoryTheory.CategoryStruct.comp i_m g) :=
        CategoryTheory.Subobject.ofMkLEMk_comp _
      let α := CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Limits.factorThruImage (CategoryTheory.CategoryStruct.comp i_m g)) v
      let p_N := CategoryTheory.Limits.factorThruImage (CategoryTheory.CategoryStruct.comp i_N g)
      let W := CategoryTheory.Limits.pullback α p_N
      let π₁ : W ⟶ _ := CategoryTheory.Limits.pullback.fst α p_N
      let π₂ : W ⟶ _ := CategoryTheory.Limits.pullback.snd α p_N
      have : CategoryTheory.Epi π₁ := CategoryTheory.Abelian.epi_pullback_of_epi_g α p_N
      let δ : W ⟶ A ⊞ C :=
        CategoryTheory.CategoryStruct.comp π₁ i_m - CategoryTheory.CategoryStruct.comp π₂ i_N
      have hδg : CategoryTheory.CategoryStruct.comp δ g = 0 := by
        dsimp [δ]
        rw [CategoryTheory.Preadditive.sub_comp, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc]
        have h₁ : CategoryTheory.CategoryStruct.comp π₁
            (CategoryTheory.CategoryStruct.comp i_m g) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp π₁ α)
              (CategoryTheory.Limits.image.ι (CategoryTheory.CategoryStruct.comp i_N g)) := by
          dsimp [α]
          rw [CategoryTheory.Category.assoc π₁,
            CategoryTheory.Category.assoc (CategoryTheory.Limits.factorThruImage _),
            hv, CategoryTheory.Limits.image.fac]
        have h₂ : CategoryTheory.CategoryStruct.comp π₂
            (CategoryTheory.CategoryStruct.comp i_N g) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp π₂ p_N)
              (CategoryTheory.Limits.image.ι (CategoryTheory.CategoryStruct.comp i_N g)) := by
          dsimp [p_N]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.image.fac]
        rw [h₁, h₂, CategoryTheory.Limits.pullback.condition, sub_self]
      let d : W ⟶ A := CategoryTheory.CategoryStruct.comp δ CategoryTheory.Limits.biprod.fst
      have hdf : CategoryTheory.CategoryStruct.comp d f = δ := by
        apply CategoryTheory.Limits.biprod.hom_ext
        · dsimp [d, f]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.biprod.inl_fst,
            CategoryTheory.Category.comp_id]
        · dsimp [d, f]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.biprod.inl_snd,
            CategoryTheory.Limits.comp_zero]
          exact hδg.symm
      have hpb_eq : CategoryTheory.CategoryStruct.comp
          (π₁ - CategoryTheory.CategoryStruct.comp π₂ u) i_m =
          CategoryTheory.CategoryStruct.comp d f := by
        rw [CategoryTheory.Preadditive.sub_comp, CategoryTheory.Category.assoc,
          CategoryTheory.Subobject.ofLE_arrow, hdf]
      let l_m : W ⟶ CategoryTheory.Limits.pullback i_m f :=
        CategoryTheory.Limits.pullback.lift (π₁ - CategoryTheory.CategoryStruct.comp π₂ u) d hpb_eq
      have hl_snd : CategoryTheory.CategoryStruct.comp l_m
          (CategoryTheory.Limits.pullback.snd i_m f) = d :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have : CategoryTheory.Mono (CategoryTheory.Limits.pullback.snd i_m f) :=
        CategoryTheory.Limits.pullback.snd_of_mono
      have : CategoryTheory.Mono (CategoryTheory.Limits.pullback.snd i_N f) :=
        CategoryTheory.Limits.pullback.snd_of_mono
      have hPA_le : CategoryTheory.Subobject.mk (CategoryTheory.Limits.pullback.snd i_m f) ≤
          CategoryTheory.Subobject.mk (CategoryTheory.Limits.pullback.snd i_N f) := by
        simpa [P_A, i_m, i_N, CategoryTheory.Subobject.pullback_obj] using le_of_eq hPA_eq.symm
      let q_A := CategoryTheory.Subobject.ofMkLEMk
        (CategoryTheory.Limits.pullback.snd i_m f)
        (CategoryTheory.Limits.pullback.snd i_N f) hPA_le
      have hq_A : CategoryTheory.CategoryStruct.comp q_A
          (CategoryTheory.Limits.pullback.snd i_N f) =
          CategoryTheory.Limits.pullback.snd i_m f :=
        CategoryTheory.Subobject.ofMkLEMk_comp hPA_le
      have hδ_fac : δ = CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp l_m
            (CategoryTheory.CategoryStruct.comp q_A
              (CategoryTheory.Limits.pullback.fst i_N f))) i_N := by
        calc
          δ = CategoryTheory.CategoryStruct.comp d f := hdf.symm
          _ = CategoryTheory.CategoryStruct.comp l_m
                (CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd i_m f) f) := by
              rw [← hl_snd, CategoryTheory.Category.assoc]
          _ = CategoryTheory.CategoryStruct.comp l_m
                (CategoryTheory.CategoryStruct.comp q_A
                  (CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.Limits.pullback.snd i_N f) f)) := by
              rw [← hq_A, CategoryTheory.Category.assoc]
          _ = CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp l_m
                  (CategoryTheory.CategoryStruct.comp q_A
                    (CategoryTheory.Limits.pullback.fst i_N f))) i_N := by
              rw [← CategoryTheory.Limits.pullback.condition,
                CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
      have hπ₁_fac : CategoryTheory.CategoryStruct.comp π₁ i_m =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp l_m
              (CategoryTheory.CategoryStruct.comp q_A
                (CategoryTheory.Limits.pullback.fst i_N f)) + π₂) i_N := by
        rw [CategoryTheory.Preadditive.add_comp, ← hδ_fac]
        dsimp [δ]
        abel
      have hcok_m : CategoryTheory.CategoryStruct.comp i_m
          (CategoryTheory.Limits.cokernel.π i_N) = 0 := by
        apply (CategoryTheory.cancel_epi π₁).mp
        rw [← CategoryTheory.Category.assoc, hπ₁_fac, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.comp_zero,
          CategoryTheory.Limits.comp_zero]
      let hk_N := CategoryTheory.Abelian.monoIsKernelOfCokernel _
        (CategoryTheory.Limits.cokernelIsCokernel i_N)
      let fk_m := CategoryTheory.Limits.KernelFork.ofι i_m hcok_m
      exact CategoryTheory.Subobject.le_of_comm (hk_N.lift fk_m)
        (hk_N.fac fk_m CategoryTheory.Limits.WalkingParallelPair.zero)
    let biprodObj : 𝒜 → 𝒜 → 𝒜 := fun A B => A ⊞ B
    let inlAB : ∀ (A B : 𝒜), A ⟶ biprodObj A B :=
      fun _ _ => CategoryTheory.Limits.biprod.inl
    let inrAB : ∀ (A B : 𝒜), B ⟶ biprodObj A B :=
      fun _ _ => CategoryTheory.Limits.biprod.inr
    let descAB : ∀ (A B Z : 𝒜), (A ⟶ Z) → (B ⟶ Z) → (biprodObj A B ⟶ Z) :=
      fun _ _ _ f₁ f₂ => CategoryTheory.Limits.biprod.desc f₁ f₂
    let inlDescAB : ∀ (A B Z : 𝒜) (f₁ : A ⟶ Z) (f₂ : B ⟶ Z),
        CategoryTheory.CategoryStruct.comp (inlAB A B) (descAB A B Z f₁ f₂) = f₁ :=
      fun _ _ _ f₁ f₂ => CategoryTheory.Limits.biprod.inl_desc f₁ f₂
    let inrDescAB : ∀ (A B Z : 𝒜) (f₁ : A ⟶ Z) (f₂ : B ⟶ Z),
        CategoryTheory.CategoryStruct.comp (inrAB A B) (descAB A B Z f₁ f₂) = f₂ :=
      fun _ _ _ f₁ f₂ => CategoryTheory.Limits.biprod.inr_desc f₁ f₂
    let genSum : List I₀ → 𝒜 :=
      fun l => List.rec Z₀ (fun i _ acc => biprodObj (L i) acc) l
    let inlGen : ∀ (i : I₀) (tl : List I₀), L i ⟶ genSum (i :: tl) :=
      fun i tl => inlAB (L i) (genSum tl)
    let inrGen : ∀ (i : I₀) (tl : List I₀), genSum tl ⟶ genSum (i :: tl) :=
      fun i tl => inrAB (L i) (genSum tl)
    let descGen : ∀ (i : I₀) (tl : List I₀) {Z : 𝒜},
        (L i ⟶ Z) → (genSum tl ⟶ Z) → (genSum (i :: tl) ⟶ Z) :=
      fun i tl {Z} f₁ f₂ => descAB (L i) (genSum tl) Z f₁ f₂
    let inlDescGen : ∀ (i : I₀) (tl : List I₀) {Z : 𝒜} (f₁ : L i ⟶ Z) (f₂ : genSum tl ⟶ Z),
        CategoryTheory.CategoryStruct.comp (inlGen i tl) (descGen i tl f₁ f₂) = f₁ :=
      fun i tl {Z} f₁ f₂ => inlDescAB (L i) (genSum tl) Z f₁ f₂
    let inrDescGen : ∀ (i : I₀) (tl : List I₀) {Z : 𝒜} (f₁ : L i ⟶ Z) (f₂ : genSum tl ⟶ Z),
        CategoryTheory.CategoryStruct.comp (inrGen i tl) (descGen i tl f₁ f₂) = f₂ :=
      fun i tl {Z} f₁ f₂ => inrDescAB (L i) (genSum tl) Z f₁ f₂
    have hGenNoeth : ∀ l : List I₀, CategoryTheory.IsNoetherianObject (genSum l) := by
      intro l
      induction l with
      | nil => exact CategoryTheory.isNoetherianObject_of_isZero hZero
      | cons i tl ih => exact hNoethBiprod (hNoeth i) ih
    have mkComp : ∀ (X : 𝒜),
        (∀ (Λ : Type u) [CategoryTheory.SmallCategory Λ] [CategoryTheory.IsFiltered Λ]
            (D : CategoryTheory.Functor Λ 𝒜) {c : CategoryTheory.Limits.Cocone D}
            (_ : CategoryTheory.Limits.IsColimit c),
          (∀ (u : X ⟶ c.pt), ∃ (j : Λ) (u_j : X ⟶ D.obj j),
            CategoryTheory.CategoryStruct.comp u_j (c.ι.app j) = u) ∧
          (∀ (j₁ j₂ : Λ) (u₁ : X ⟶ D.obj j₁) (u₂ : X ⟶ D.obj j₂),
            CategoryTheory.CategoryStruct.comp u₁ (c.ι.app j₁) =
              CategoryTheory.CategoryStruct.comp u₂ (c.ι.app j₂) →
            ∃ (k : Λ) (w₁ : j₁ ⟶ k) (w₂ : j₂ ⟶ k),
              CategoryTheory.CategoryStruct.comp u₁ (D.map w₁) =
                CategoryTheory.CategoryStruct.comp u₂ (D.map w₂))) →
        CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u}
          (CategoryTheory.coyoneda.obj (Opposite.op X)) := by
      intro X hX
      refine CategoryTheory.Limits.PreservesFilteredColimitsOfSize.mk (fun Λ _ _ => ?_)
      refine CategoryTheory.Limits.PreservesColimitsOfShape.mk (fun {D} => ?_)
      refine CategoryTheory.Limits.PreservesColimit.mk (fun {c} hc => ⟨?_⟩)
      obtain ⟨hsurj, hinj⟩ := hX Λ D hc
      refine CategoryTheory.Limits.Types.FilteredColimit.isColimitOf _ _ ?_ ?_
      · intro u
        obtain ⟨j, u_j, hu_j⟩ := hsurj u
        exact ⟨j, u_j, hu_j.symm⟩
      · intro j₁ j₂ u₁ u₂ heq
        exact hinj j₁ j₂ u₁ u₂ heq
    have elimComp : ∀ {X : 𝒜},
        CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u}
          (CategoryTheory.coyoneda.obj (Opposite.op X)) →
        ∀ (Λ : Type u) [CategoryTheory.SmallCategory Λ] [CategoryTheory.IsFiltered Λ]
          (D : CategoryTheory.Functor Λ 𝒜) {c : CategoryTheory.Limits.Cocone D}
          (hc : CategoryTheory.Limits.IsColimit c),
          (∀ (u : X ⟶ c.pt), ∃ (j : Λ) (u_j : X ⟶ D.obj j),
            CategoryTheory.CategoryStruct.comp u_j (c.ι.app j) = u) ∧
          (∀ (j₁ j₂ : Λ) (u₁ : X ⟶ D.obj j₁) (u₂ : X ⟶ D.obj j₂),
            CategoryTheory.CategoryStruct.comp u₁ (c.ι.app j₁) =
              CategoryTheory.CategoryStruct.comp u₂ (c.ι.app j₂) →
