        let Ω := AlgebraicClosure ↥κ
        let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
        let T_Ω := weilEtaleIdTerminal S_Ω
        let bar_y : Quiver.Hom S_Ω S₁ :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
            (S₁.fromSpecResidueField y)
        let bar_y₂ : Quiver.Hom S_Ω S₂ := bar_y ≫ h
        obtain ⟨hLimE1, _, hZeroE1⟩ := hGeomStalkExact S₁ Ω bar_y
        obtain ⟨hLimE2, _, hZeroE2⟩ := hGeomStalkExact S₂ Ω bar_y₂
        obtain ⟨_, ⟨adj_sky⟩⟩ := hSkyAdj Ω
        let getR {L : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u}}
            {R : AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}}
            (_ : L ⊣ R) := R
        let sky_Ω := getR adj_sky
        let B_1 := weilEtaleSitePullback bar_y
        let B_2 := weilEtaleSitePullback bar_y₂
        let pf_1 := B_1.sheafPushforwardContinuous AddCommGrpCat.{u}
          S₁.smallEtaleTopology S_Ω.smallEtaleTopology
        let pb_1 := B_1.sheafPullback AddCommGrpCat.{u}
          S₁.smallEtaleTopology S_Ω.smallEtaleTopology
        let pf_2 := B_2.sheafPushforwardContinuous AddCommGrpCat.{u}
          S₂.smallEtaleTopology S_Ω.smallEtaleTopology
        let pb_2 := B_2.sheafPullback AddCommGrpCat.{u}
          S₂.smallEtaleTopology S_Ω.smallEtaleTopology
        let ev_Ω : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
          CategoryTheory.sheafToPresheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u} ⋙
            (CategoryTheory.evaluation (S_Ω.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op T_Ω)
        let E_1 : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
          pb_1 ⋙ ev_Ω
        let E_2 : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
          pb_2 ⋙ ev_Ω
        haveI : E_1.PreservesZeroMorphisms := hZeroE1
        haveI : E_2.PreservesZeroMorphisms := hZeroE2
        haveI : CategoryTheory.Limits.PreservesFiniteLimits E_1 := hLimE1
        haveI : CategoryTheory.Limits.PreservesFiniteLimits E_2 := hLimE2
        let adj_E1 : E_1 ⊣ sky_Ω ⋙ pf_1 :=
          (B_1.sheafAdjunctionContinuous AddCommGrpCat.{u}
            S₁.smallEtaleTopology S_Ω.smallEtaleTopology).comp adj_sky
        let adj_E2 : E_2 ⊣ sky_Ω ⋙ pf_2 :=
          (B_2.sheafAdjunctionContinuous AddCommGrpCat.{u}
            S₂.smallEtaleTopology S_Ω.smallEtaleTopology).comp adj_sky
