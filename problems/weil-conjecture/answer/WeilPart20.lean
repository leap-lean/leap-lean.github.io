  have hEtaleSecAt : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (Z : AlgebraicGeometry.Scheme.{u})
      (p_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      [AlgebraicGeometry.Etale p_Z] (z : ↥Z),
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let pt_Ω : ↥S_Ω := (⊥ : PrimeSpectrum Ω)
      ∃ (s_z : S_Ω ⟶ Z), s_z ≫ p_Z = 𝟙 S_Ω ∧ s_z.base pt_Ω = z := by
    intro Ω _ _ Z p_Z _ z S_Ω pt_Ω
    obtain ⟨O_z, hAff, hz_mem, -⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
      (x := z) (U := (⊤ : Z.Opens)) trivial
    let E_cat := Z.presheaf.obj (Opposite.op O_z)
    have hz_range : z ∈ Set.range hAff.fromSpec.base := by
      rw [hAff.range_fromSpec]
      exact hz_mem
    obtain ⟨q_z, hqz⟩ := hz_range
    let f_E : AlgebraicGeometry.Spec E_cat ⟶ S_Ω := hAff.fromSpec ≫ p_Z
    have hEt_fE : AlgebraicGeometry.Etale f_E := inferInstance
    let φ_Ω : CommRingCat.of Ω ⟶ E_cat := AlgebraicGeometry.Spec.preimage f_E
    have hmap_φ : AlgebraicGeometry.Spec.map φ_Ω = f_E := AlgebraicGeometry.Spec.map_preimage f_E
    have hEt_hom : RingHom.Etale φ_Ω.hom := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale), hmap_φ]
      exact hEt_fE
    letI : Algebra Ω ↑E_cat := φ_Ω.hom.toAlgebra
    have hEt_alg : Algebra.Etale Ω ↑E_cat := RingHom.etale_algebraMap.mp hEt_hom
    have hFT_alg : Algebra.FiniteType Ω ↑E_cat := inferInstance
    have hFin_alg : Module.Finite Ω ↑E_cat := by
      obtain ⟨I, hFinI, Ai, hField, hAlg, e_prod, hFin_i⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod Ω (↑E_cat)).mp hEt_alg
      haveI : Finite I := hFinI
      letI : ∀ i : I, Field (Ai i) := hField
      letI : ∀ i : I, Algebra Ω (Ai i) := hAlg
      haveI : ∀ i : I, Module.Finite Ω (Ai i) := fun i => (hFin_i i).1
      exact Module.Finite.equiv (AlgEquiv.toLinearEquiv e_prod).symm
    haveI : IsArtinianRing ↑E_cat := IsArtinianRing.of_finite Ω (↑E_cat)
    haveI : q_z.asIdeal.IsPrime := q_z.isPrime
    have hq_max : q_z.asIdeal.IsMaximal := IsArtinianRing.isMaximal_of_isPrime q_z.asIdeal
    obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
    let q_hom : MvPolynomial (Fin n_mv) Ω →+* ↑E_cat := q_mv.toRingHom
    have hq_hom_surj : Function.Surjective q_hom := hq_surj
    let m_mv : Ideal (MvPolynomial (Fin n_mv) Ω) := Ideal.comap q_hom q_z.asIdeal
    have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
    let ev_hom : MvPolynomial (Fin n_mv) Ω →+* Ω := (MvPolynomial.aeval a_pt).toRingHom
    have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
      intro f_p hf_p
      rw [RingHom.mem_ker] at hf_p
      have hmem : f_p ∈ m_mv := by
        change q_hom f_p ∈ q_z.asIdeal
        rw [hf_p]
        exact q_z.asIdeal.zero_mem
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
      exact hmem
    let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
    let σ_E : ↑E_cat →+* Ω :=
      (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
    have hσ_comp : φ_Ω ≫ CommRingCat.ofHom σ_E = 𝟙 (CommRingCat.of Ω) := by
      ext c
      change σ_E (algebraMap Ω (↑E_cat) c) = c
      have hq_C : q_hom (MvPolynomial.C c) = algebraMap Ω (↑E_cat) c := q_mv.commutes c
      rw [← hq_C]
      dsimp [σ_E]
      have heq_q : e_quot.symm (q_hom (MvPolynomial.C c)) =
          Ideal.Quotient.mk (RingHom.ker q_hom) (MvPolynomial.C c) := by
        apply e_quot.injective
        simp [e_quot]
      rw [heq_q, Ideal.Quotient.lift_mk]
      exact (MvPolynomial.aeval a_pt).commutes c
    have hqz_le_ker : q_z.asIdeal ≤ RingHom.ker σ_E := by
      intro x hx
      obtain ⟨f_p, rfl⟩ := hq_hom_surj x
      rw [RingHom.mem_ker]
      dsimp [σ_E]
      have heq_q : e_quot.symm (q_hom f_p) = Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
        apply e_quot.injective
        simp [e_quot]
      rw [heq_q, Ideal.Quotient.lift_mk]
      have hmem : f_p ∈ m_mv := hx
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
      exact hmem
    have hker_ne_top : RingHom.ker σ_E ≠ ⊤ := RingHom.ker_ne_top σ_E
    have hker_eq : RingHom.ker σ_E = q_z.asIdeal := (hq_max.eq_of_le hker_ne_top hqz_le_ker).symm
    let s_E : S_Ω ⟶ AlgebraicGeometry.Spec E_cat :=
