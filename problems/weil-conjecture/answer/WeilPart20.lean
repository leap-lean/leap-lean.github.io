        change v ≫ q₁ = p₁
        dsimp [v]
        rw [Category.assoc, Category.assoc, Subobject.underlyingIso_hom_comp_eq_mk,
          Subobject.ofLE_arrow, ← Subobject.underlyingIso_hom_comp_eq_mk p₁,
          Iso.inv_hom_id_assoc]
      rw [hSubLE]
      apply (cancel_epi (Limits.pullback.snd f A.arrow)).mp
