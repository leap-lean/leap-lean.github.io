  let B_L := weilAltCdSitePullback hL
  let P_L := B_L.sheafPullback A J₀ J_L
  let adj_L := B_L.sheafAdjunctionContinuous A J₀ J_L
  let T₀_id := weilEtaleIdTerminal.{u} S₀
  let T_L_id := weilEtaleIdTerminal.{u} S_L
  let hT_L_id := weilEtaleIdTerminalIsTerminal.{u} S_L

  constructor
  · 
    intro ξ pL hpL hpL_zero
    haveI : Algebra.Etale ↥E₀ ↥E₀ := hSepEtale ↥E₀ ↥E₀
    haveI : Algebra.Etale L L := hSepEtale L L
    let W_E₀ := weilAltCdSpecEtaleObj ↥E₀ ↥E₀
    let V_L := weilAltCdSpecEtaleObj L L
    have h_id_E₀ : W_E₀.hom = 𝟙 S₀ := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥E₀ ↥E₀)) = 𝟙 S₀
      rw [show CommRingCat.ofHom (algebraMap ↥E₀ ↥E₀) = 𝟙 (CommRingCat.of ↥E₀) from
        CommRingCat.hom_ext (RingHom.ext fun _ => rfl), AlgebraicGeometry.Spec.map_id]
    let e_id₀ : W_E₀ ≅ T₀_id :=
      CategoryTheory.MorphismProperty.Over.isoMk (CategoryTheory.Iso.refl S₀)
        ((CategoryTheory.Category.id_comp _).trans h_id_E₀.symm)
    let w_id_L : V_L ⟶ B_L.obj T₀_id :=
      wPullSec E₀.subtype E₀.subtype rfl ≫ B_L.map e_id₀.hom
    have h_ev_pull := hEvalPullH0 hL ℱ₀ pL hpL ξ V_L w_id_L
    rw [hpL_zero, map_zero, map_zero] at h_ev_pull
    have h_pull_zero : pullSec E₀.subtype E₀.subtype rfl ℱ₀
        ((ℱ₀.obj.map e_id₀.hom.op).hom (evH0 S₀ ℱ₀ ξ)) = 0 := by
      have h_nat_u : ((adj_L.unit.app ℱ₀).hom.app (Opposite.op W_E₀)).hom
          ((ℱ₀.obj.map e_id₀.hom.op).hom (evH0 S₀ ℱ₀ ξ)) =
          (((P_L.obj ℱ₀).obj.map (B_L.map e_id₀.hom).op).hom)
            (((adj_L.unit.app ℱ₀).hom.app (Opposite.op T₀_id)).hom (evH0 S₀ ℱ₀ ξ)) :=
        ConcreteCategory.congr_hom
          ((adj_L.unit.app ℱ₀).hom.naturality e_id₀.hom.op) (evH0 S₀ ℱ₀ ξ)
      change (((P_L.obj ℱ₀).obj.map (wPullSec E₀.subtype E₀.subtype rfl).op).hom)
        (((adj_L.unit.app ℱ₀).hom.app (Opposite.op W_E₀)).hom
          ((ℱ₀.obj.map e_id₀.hom.op).hom (evH0 S₀ ℱ₀ ξ))) = 0
      rw [h_nat_u]
      have h_comp : (((P_L.obj ℱ₀).obj.map (wPullSec E₀.subtype E₀.subtype rfl).op).hom)
          ((((P_L.obj ℱ₀).obj.map (B_L.map e_id₀.hom).op).hom)
            (((adj_L.unit.app ℱ₀).hom.app (Opposite.op T₀_id)).hom (evH0 S₀ ℱ₀ ξ))) =
          (((P_L.obj ℱ₀).obj.map w_id_L.op).hom)
            (((adj_L.unit.app ℱ₀).hom.app (Opposite.op T₀_id)).hom (evH0 S₀ ℱ₀ ξ)) := by
        dsimp only [w_id_L]
        rw [op_comp, CategoryTheory.Functor.map_comp]
