    have hDisj_comp : Disjoint
        (Set.range ((Fgt_X.map (ι'₂ ≫ B_π.map v_Y)).left).base)
        (Set.range ((Fgt_X.map σ_e).left).base) := by
      rw [Set.disjoint_left]
      rintro _ ⟨u_pt, rfl⟩ h_in
      have h_pre : ((Fgt_X.map ι'₂).left).base u_pt ∈
          f_BvY.base ⁻¹' Set.range ((Fgt_X.map σ_e).left).base := h_in
      exact Set.disjoint_left.mp hDisj_ι'₂ ⟨u_pt, rfl⟩ (hPreimageSub h_pre)
    
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let ξ_π_raw := CategoryTheory.Sheaf.freeYonedaHomEquiv α_π
    let ξ'_π_raw := CategoryTheory.Sheaf.freeYonedaHomEquiv α'_π
    let ξ_π : AM ⟶ L_X.obj.obj (Opposite.op (B_π.obj U_Y)) := ξ_π_raw
