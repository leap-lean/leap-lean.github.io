    · have : Nonempty ↥Y_O := not_isEmpty_iff.mp hEmp
      by_cases hPre : PreirreducibleSpace ↥Y_O
      · have : IrreducibleSpace ↥Y_O := { toPreirreducibleSpace := hPre, toNonempty := inferInstance }
        have : IsReduced Y_O := hRed_O O
        have : IsIntegral Y_O := isIntegral_of_irreducibleSpace_of_isReduced Y_O
        have hPropWO : IsProper (i_O ≫ W.hom) := inferInstance
        let W_O : CategoryTheory.Over (Spec (CommRingCat.of k)) := CategoryTheory.Over.mk (i_O ≫ W.hom)
        have : IsProper W_O.hom := hPropWO
        have : IsIntegral W_O.left := ‹IsIntegral Y_O›
        let l₀ : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y_O) :=
          RelSeries.singleton _ ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥Y_O, isClosed_univ⟩
        have h0_le : (0 : WithBot ℕ∞) ≤ topologicalKrullDim Y_O :=
          Order.LTSeries.length_le_krullDim l₀
        have hle_m : topologicalKrullDim Y_O ≤ ((m : ℕ∞) : WithBot ℕ∞) := hDim_O O
        rcases hd : topologicalKrullDim Y_O with _ | d_top
        · rw [hd] at h0_le
          exact absurd h0_le (WithBot.not_coe_le_bot 0)
        · rcases d_top with _ | e
          · rw [hd] at hle_m
            exact absurd (WithBot.coe_le_coe.mp hle_m) (not_le_of_gt (ENat.natCast_lt_top m))
          · rw [hd] at hle_m
            have he_le : e ≤ m := Nat.cast_le.mp (WithBot.coe_le_coe.mp hle_m)
            rcases Nat.eq_zero_or_pos e with rfl | he_pos
            · exact hDimZero q hq1 W_O hd 𝒢
            · exact hIntegralPos e he_pos he_le W_O hd 𝒢 hℓ_𝒢
      · have hNotPreUniv : ¬ IsPreirreducible (Set.univ : Set ↥Y_O) :=
          fun hU_pre => hPre ⟨hU_pre⟩
        rw [isPreirreducible_iff_isClosed_union_isClosed] at hNotPreUniv
        push Not at hNotPreUniv
        rcases hNotPreUniv with ⟨C₁, C₂, hC₁, hC₂, hUniv_sub, hNot₁, hNot₂⟩
        have hUnion : C₁ ∪ C₂ = Set.univ := Set.Subset.antisymm (fun _ _ => trivial) hUniv_sub
        obtain ⟨y₁, -, hy₁⟩ := Set.not_subset.mp hNot₁
        obtain ⟨y₂, -, hy₂⟩ := Set.not_subset.mp hNot₂
        have hCl : Topology.IsClosedEmbedding i_O.base := IsClosedImmersion.isClosedEmbedding i_O
        let F₁ : Set ↥W.left := i_O.base '' C₁
        let F₂ : Set ↥W.left := i_O.base '' C₂
        have hF₁ : IsClosed F₁ := hCl.isClosedMap C₁ hC₁
        have hF₂ : IsClosed F₂ := hCl.isClosedMap C₂ hC₂
        let O₁ : W.left.Opens := ⟨F₁ᶜ, hF₁.isOpen_compl⟩
        let O₂ : W.left.Opens := ⟨F₂ᶜ, hF₂.isOpen_compl⟩
        have hF₁_sub : F₁ ⊆ (O : Set ↥W.left)ᶜ := by
          rw [← hRange_O O]
          rintro _ ⟨y, _, rfl⟩
          exact ⟨y, rfl⟩
        have hF₂_sub : F₂ ⊆ (O : Set ↥W.left)ᶜ := by
          rw [← hRange_O O]
          rintro _ ⟨y, _, rfl⟩
          exact ⟨y, rfl⟩
        have hlt₁ : O < O₁ := by
          refine lt_of_le_not_ge (fun w hw hwF₁ => hF₁_sub hwF₁ hw) (fun hge => ?_)
          have hy₁_in_O₁ : i_O.base y₁ ∈ O₁ := by
            rintro ⟨y', hy'C₁, heq⟩
            exact hy₁ (hCl.injective heq ▸ hy'C₁)
          have hy₁_not_O : i_O.base y₁ ∉ (O : Set ↥W.left) := by
            have hmem : i_O.base y₁ ∈ (O : Set ↥W.left)ᶜ := by
              rw [← hRange_O O]; exact ⟨y₁, rfl⟩
            exact hmem
          exact hy₁_not_O (hge hy₁_in_O₁)
        have hlt₂ : O < O₂ := by
          refine lt_of_le_not_ge (fun w hw hwF₂ => hF₂_sub hwF₂ hw) (fun hge => ?_)
          have hy₂_in_O₂ : i_O.base y₂ ∈ O₂ := by
            rintro ⟨y', hy'C₂, heq⟩
            exact hy₂ (hCl.injective heq ▸ hy'C₂)
          have hy₂_not_O : i_O.base y₂ ∉ (O : Set ↥W.left) := by
            have hmem : i_O.base y₂ ∈ (O : Set ↥W.left)ᶜ := by
              rw [← hRange_O O]; exact ⟨y₂, rfl⟩
            exact hmem
          exact hy₂_not_O (hge hy₂_in_O₂)
        have hle_I₁ : I_of O ≤ I_of O₁ :=
          Scheme.IdealSheafData.vanishingIdeal_antimono (show (O₁ : Set ↥W.left)ᶜ ⊆ (O : Set ↥W.left)ᶜ by
            change F₁ᶜᶜ ⊆ (O : Set ↥W.left)ᶜ
            rw [compl_compl]
            exact hF₁_sub)
        have hle_I₂ : I_of O ≤ I_of O₂ :=
          Scheme.IdealSheafData.vanishingIdeal_antimono (show (O₂ : Set ↥W.left)ᶜ ⊆ (O : Set ↥W.left)ᶜ by
            change F₂ᶜᶜ ⊆ (O : Set ↥W.left)ᶜ
            rw [compl_compl]
            exact hF₂_sub)
        let j₁ : (I_of O₁).subscheme ⟶ Y_O := Scheme.IdealSheafData.inclusion hle_I₁
        let j₂ : (I_of O₂).subscheme ⟶ Y_O := Scheme.IdealSheafData.inclusion hle_I₂
        have hj₁_fac : j₁ ≫ i_O = (I_of O₁).subschemeι :=
          Scheme.IdealSheafData.inclusion_subschemeι hle_I₁
        have hj₂_fac : j₂ ≫ i_O = (I_of O₂).subschemeι :=
          Scheme.IdealSheafData.inclusion_subschemeι hle_I₂
        have hCover_j : Set.range j₁.base ∪ Set.range j₂.base = Set.univ := by
          ext y
          simp only [Set.mem_union, Set.mem_range, Set.mem_univ, iff_true]
          have hy_un : y ∈ C₁ ∪ C₂ := by rw [hUnion]; trivial
          rcases hy_un with hyC₁ | hyC₂
          · have hmem : i_O.base y ∈ Set.range (I_of O₁).subschemeι.base := by
              rw [hRange_O O₁]
              change i_O.base y ∈ F₁ᶜᶜ
              rw [compl_compl]
              exact ⟨y, hyC₁, rfl⟩
            rcases hmem with ⟨z₁, hz₁⟩
            refine Or.inl ⟨z₁, hCl.injective ?_⟩
            change (j₁ ≫ i_O).base z₁ = i_O.base y
            rwa [hj₁_fac]
          · have hmem : i_O.base y ∈ Set.range (I_of O₂).subschemeι.base := by
              rw [hRange_O O₂]
              change i_O.base y ∈ F₂ᶜᶜ
              rw [compl_compl]
              exact ⟨y, hyC₂, rfl⟩
            rcases hmem with ⟨z₂, hz₂⟩
            refine Or.inr ⟨z₂, hCl.injective ?_⟩
            change (j₂ ≫ i_O).base z₂ = i_O.base y
            rwa [hj₂_fac]
        exact hClosedDevissage Y_O j₁ j₂ hCover_j ℓ q (ih O₁ hlt₁) (ih O₂ hlt₂) 𝒢 hℓ_𝒢
  
  have hCover_bot : Set.range (I_of ⊥).subschemeι.base ∪ Set.range (I_of ⊥).subschemeι.base = Set.univ := by
    rw [Set.union_self, hRange_O ⊥]
    ext x
    simp
  exact hClosedDevissage W.left (I_of ⊥).subschemeι (I_of ⊥).subschemeι hCover_bot ℓ q
    (hStep ⊥) (hStep ⊥) ℱ hℓ_ℱ

theorem weil_alt_cd_zero_outside_subsheaf_exhaustion (k : Type u) [Field k] [IsAlgClosed k]
    (d : ℕ)
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper W.hom]
    (ℱ : CategoryTheory.Sheaf W.left.smallEtaleTopology AddCommGrpCat.{u})
    (hSupp : ∀ x : ↥W.left,
      (d : WithBot ℕ∞) < topologicalKrullDim ↥(closure ({x} : Set ↥W.left)) →
      WeilAltCdStalkZeroAt W.left ℱ x) :
    ∃ (Idx : Type u) (_ : CategoryTheory.SmallCategory Idx) (_ : CategoryTheory.IsFiltered Idx)
      (D : CategoryTheory.Functor Idx
        (CategoryTheory.Sheaf W.left.smallEtaleTopology AddCommGrpCat.{u}))
      (c : CategoryTheory.Limits.Cocone D),
      c.pt = ℱ ∧
      Nonempty (CategoryTheory.Limits.IsColimit c) ∧
      (∀ j : Idx, CategoryTheory.Mono (c.ι.app j)) ∧
      (∀ j : Idx, ∃ C : TopologicalSpace.Closeds ↥W.left,
        topologicalKrullDim ↥(C : Set ↥W.left) ≤ (d : WithBot ℕ∞) ∧
        ∀ U : W.left.Etale,
          Set.range U.hom.base ⊆ (C : Set ↥W.left)ᶜ →
          Subsingleton ↥((D.obj j).obj.obj (Opposite.op U))) :=
by
  
  
  
  have hMemSmallEtale : ∀ {V : W.left.Etale} (R : CategoryTheory.Sieve V),
      (∀ x : ↥V.left, ∃ (Y : W.left.Etale) (f : Y ⟶ V) (y : ↥Y.left),
        R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x) →
      R ∈ W.left.smallEtaleTopology V := by
    intro V R hCov
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      { comp_mem := fun f g hf hg => by
          have : AlgebraicGeometry.Etale f := hf
          have : AlgebraicGeometry.Etale g := hg
          infer_instance }
    exact Eq.mpr
      (congrArg (fun J₀ : CategoryTheory.GrothendieckTopology W.left.Etale => R ∈ J₀ V)
        (AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          W.left (le_refl (@AlgebraicGeometry.Etale))))
      ((AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology V R).mpr hCov)

  have hSheafSep : ∀ (𝒢 : CategoryTheory.Sheaf W.left.smallEtaleTopology AddCommGrpCat.{u})
      {V : W.left.Etale} (R : CategoryTheory.Sieve V),
      R ∈ W.left.smallEtaleTopology V →
      ∀ y₁ y₂ : ↥(𝒢.obj.obj (Opposite.op V)),
        (∀ {Y : W.left.Etale} (g : Y ⟶ V), R.arrows g →
          𝒢.obj.map (Opposite.op g) y₁ = 𝒢.obj.map (Opposite.op g) y₂) →
        y₁ = y₂ := by
    intro 𝒢 V R hR y₁ y₂ hEqOn
    obtain ⟨hc_V⟩ :=
      (CategoryTheory.Presheaf.isSheaf_iff_isLimit W.left.smallEtaleTopology 𝒢.obj).mp
        𝒢.property R hR
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let α : Aℤ ⟶ (𝒢.obj.mapCone R.arrows.cocone.op).pt :=
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • (y₁ - y₂)
          map_zero' := zero_zsmul _
          map_add' := fun a b => add_zsmul _ a.down b.down }
    have hα_zero : α = 0 := by
      refine hc_V.hom_ext (fun I => ?_)
      rw [CategoryTheory.Limits.zero_comp]
      let g_I : (R.arrows.diagram.obj I.unop) ⟶ V := R.arrows.cocone.ι.app I.unop
      have hg_zero : (𝒢.obj.map (Opposite.op g_I)).hom (y₁ - y₂) = 0 := by
        rw [map_sub, sub_eq_zero]
        exact hEqOn g_I I.unop.property
      ext n
      change (𝒢.obj.map (Opposite.op g_I)).hom (n.down • (y₁ - y₂)) = 0
      rw [map_zsmul, hg_zero, zsmul_zero]
    have h1 : α (ULift.up 1) = (0 : Aℤ ⟶ (𝒢.obj.mapCone R.arrows.cocone.op).pt) (ULift.up 1) :=
      congrArg (fun φ : Aℤ ⟶ (𝒢.obj.mapCone R.arrows.cocone.op).pt => φ (ULift.up 1)) hα_zero
    have hsub : (1 : ℤ) • (y₁ - y₂) = 0 := h1
    rw [one_zsmul] at hsub
    exact sub_eq_zero.mp hsub

  
  
  
  
  have hBotDim :
      topologicalKrullDim ↥((⊥ : TopologicalSpace.Closeds ↥W.left) : Set ↥W.left) ≤
        (d : WithBot ℕ∞) := by
    have hEmptySub : IsEmpty ↥((⊥ : TopologicalSpace.Closeds ↥W.left) : Set ↥W.left) :=
      ⟨fun z => z.2⟩
    have hEmptyIC :
        IsEmpty (TopologicalSpace.IrreducibleCloseds
          ↥((⊥ : TopologicalSpace.Closeds ↥W.left) : Set ↥W.left)) :=
      ⟨fun K => let ⟨z, _⟩ := K.isIrreducible.nonempty; hEmptySub.false z⟩
    change Order.krullDim _ ≤ _
    rw [Order.krullDim_eq_bot]
    exact bot_le

  have hPullChain : ∀ {C U_cl : TopologicalSpace.Closeds ↥W.left} (hCU : C ≤ U_cl)
      (l : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(U_cl : Set ↥W.left))),
      (∀ z ∈ (l (Fin.last l.length) : Set ↥(U_cl : Set ↥W.left)), z.1 ∈ (C : Set ↥W.left)) →
      (l.length : WithBot ℕ∞) ≤ topologicalKrullDim ↥(C : Set ↥W.left) := by
    intro C U_cl hCU l hTop
    let ι : ↥(C : Set ↥W.left) → ↥(U_cl : Set ↥W.left) := fun y => ⟨y.1, hCU y.2⟩
    have hContι : Continuous ι := continuous_subtype_val.subtype_mk _
    have hIndι : Topology.IsInducing ι :=
      Topology.IsInducing.of_comp hContι continuous_subtype_val Topology.IsInducing.subtypeVal
    have hRangeι : ∀ r : Fin (l.length + 1),
        (l r : Set ↥(U_cl : Set ↥W.left)) ⊆ Set.range ι := by
      intro r z hz
      have hle : l r ≤ l (Fin.last l.length) := l.strictMono.monotone (Fin.le_last r)
      exact ⟨⟨z.1, hTop z (hle hz)⟩, rfl⟩
    let pullIC : ∀ r : Fin (l.length + 1),
        TopologicalSpace.IrreducibleCloseds ↥(C : Set ↥W.left) := fun r =>
      { carrier := ι ⁻¹' (l r : Set ↥(U_cl : Set ↥W.left))
        isIrreducible' := by
          refine ⟨?_, ?_⟩
          · obtain ⟨z, hz⟩ := (l r).isIrreducible.nonempty
            obtain ⟨y, rfl⟩ := hRangeι r hz
            exact ⟨y, hz⟩
          · intro O₁ O₂ hO₁ hO₂ ⟨y₁, hy₁P, hy₁O⟩ ⟨y₂, hy₂P, hy₂O⟩
            obtain ⟨O₁', hO₁', rfl⟩ := hIndι.isOpen_iff.mp hO₁
            obtain ⟨O₂', hO₂', rfl⟩ := hIndι.isOpen_iff.mp hO₂
            obtain ⟨z, hzK, hzO₁, hzO₂⟩ := (l r).isIrreducible.isPreirreducible O₁' O₂' hO₁' hO₂'
              ⟨ι y₁, hy₁P, hy₁O⟩ ⟨ι y₂, hy₂P, hy₂O⟩
            obtain ⟨y, rfl⟩ := hRangeι r hzK
            exact ⟨y, hzK, hzO₁, hzO₂⟩
        isClosed' := (l r).isClosed.preimage hContι }
    let l_C : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(C : Set ↥W.left)) :=
      { length := l.length
        toFun := pullIC
        step := fun i => by
          have hlt : l (Fin.castSucc i) < l (Fin.succ i) := l.step i
          have hle_ic : l (Fin.castSucc i) ≤ l (Fin.succ i) := le_of_lt hlt
          have hle : pullIC (Fin.castSucc i) ≤ pullIC (Fin.succ i) := fun _ hy => hle_ic hy
          refine lt_of_le_not_ge hle (fun hge => not_le_of_gt hlt (fun z hz => ?_))
          obtain ⟨y, rfl⟩ := hRangeι (Fin.succ i) hz
          exact hge hz }
    exact Order.LTSeries.length_le_krullDim l_C

  have hSupDim : ∀ C₁ C₂ : TopologicalSpace.Closeds ↥W.left,
      topologicalKrullDim ↥(C₁ : Set ↥W.left) ≤ (d : WithBot ℕ∞) →
      topologicalKrullDim ↥(C₂ : Set ↥W.left) ≤ (d : WithBot ℕ∞) →
      topologicalKrullDim ↥((C₁ ⊔ C₂ : TopologicalSpace.Closeds ↥W.left) : Set ↥W.left) ≤
        (d : WithBot ℕ∞) := by
    intro C₁ C₂ h₁ h₂
    let U₁₂ := C₁ ⊔ C₂
    by_cases hEmptyIC :
        IsEmpty (TopologicalSpace.IrreducibleCloseds ↥(U₁₂ : Set ↥W.left))
    · change Order.krullDim _ ≤ _
      rw [Order.krullDim_eq_bot]
      exact bot_le
    · have : Nonempty (TopologicalSpace.IrreducibleCloseds ↥(U₁₂ : Set ↥W.left)) :=
        not_isEmpty_iff.mp hEmptyIC
      change Order.krullDim _ ≤ ((d : ℕ∞) : WithBot ℕ∞)
      rw [Order.krullDim_eq_iSup_length]
      refine WithBot.coe_le_coe.mpr (iSup_le fun l => ?_)
      let K_top := l (Fin.last l.length)
      let F₁ : Set ↥(U₁₂ : Set ↥W.left) := Subtype.val ⁻¹' (C₁ : Set ↥W.left)
      let F₂ : Set ↥(U₁₂ : Set ↥W.left) := Subtype.val ⁻¹' (C₂ : Set ↥W.left)
      have hF₁ : IsClosed F₁ := C₁.isClosed.preimage continuous_subtype_val
      have hF₂ : IsClosed F₂ := C₂.isClosed.preimage continuous_subtype_val
      have hSubOr : (K_top : Set _) ⊆ F₁ ∨ (K_top : Set _) ⊆ F₂ := by
        by_contra! hnot
        obtain ⟨hnot₁, hnot₂⟩ := hnot
        rw [Set.not_subset] at hnot₁ hnot₂
        obtain ⟨z₁, hz₁K, hz₁F⟩ := hnot₁
        obtain ⟨z₂, hz₂K, hz₂F⟩ := hnot₂
        obtain ⟨z, _hzK, hzF₁, hzF₂⟩ :=
          K_top.isIrreducible.isPreirreducible F₁ᶜ F₂ᶜ hF₁.isOpen_compl hF₂.isOpen_compl
            ⟨z₁, hz₁K, hz₁F⟩ ⟨z₂, hz₂K, hz₂F⟩
        rcases z.2 with hz₁ | hz₂
        · exact hzF₁ hz₁
        · exact hzF₂ hz₂
      rcases hSubOr with hSub₁ | hSub₂
      · have hle := (hPullChain le_sup_left l hSub₁).trans h₁
        exact WithBot.coe_le_coe.mp hle
      · have hle := (hPullChain le_sup_right l hSub₂).trans h₂
        exact WithBot.coe_le_coe.mp hle

  
  
  
  have hGeomLift : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S)
      [AlgebraicGeometry.Etale f] (η : ↥X),
      let x : ↥S := f.base η
      let Ω := AlgebraicClosure ↥(S.residueField x)
      ∃ (u : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X),
        CategoryTheory.CategoryStruct.comp u f =
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(S.residueField x) Ω)))
            (S.fromSpecResidueField x) ∧
        ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), u.base pt = η := by
    intro X S f _ η x Ω
    have hEFT_stalk : (f.stalkMap η).hom.EssFiniteType :=
      AlgebraicGeometry.LocallyOfFiniteType.stalkMap f η
    have hFU_stalk : (f.stalkMap η).hom.FormallyUnramified := by
      refine AlgebraicGeometry.HasRingHomProperty.stalkMap
        (P := @AlgebraicGeometry.FormallyUnramified)
        (Q := @RingHom.FormallyUnramified) ?_
        (inferInstance : AlgebraicGeometry.FormallyUnramified f) η
      intro R A _ _ g hg J hJ
      have : J.IsPrime := hJ
      have : (Ideal.comap g J).IsPrime := Ideal.IsPrime.comap g
      let _ : Algebra R A := g.toAlgebra
      have : Algebra.FormallyUnramified R A :=
        (RingHom.formallyUnramified_algebraMap (R := R) (S := A)).mp hg
      have hFU_RJ : Algebra.FormallyUnramified R (Localization.AtPrime J) :=
        Algebra.FormallyUnramified.instLocalization (R := R) (S := A) J.primeCompl
      have hCompFU : (algebraMap R (Localization.AtPrime J)).FormallyUnramified :=
        (RingHom.formallyUnramified_algebraMap (R := R) (S := Localization.AtPrime J)).mpr hFU_RJ
      rw [IsScalarTower.algebraMap_eq R A (Localization.AtPrime J)] at hCompFU
      have hLocComp :
          (Localization.localRingHom (Ideal.comap g J) J g rfl).comp
            (algebraMap R (Localization.AtPrime (Ideal.comap g J))) =
          (algebraMap A (Localization.AtPrime J)).comp g := by
        ext r
        exact Localization.localRingHom_to_map (Ideal.comap g J) J g rfl r
      change ((algebraMap A (Localization.AtPrime J)).comp g).FormallyUnramified at hCompFU
      rw [← hLocComp] at hCompFU
      exact RingHom.FormallyUnramified.of_comp hCompFU
    let R_S := ↑(S.presheaf.stalk x)
    let R_X := ↑(X.presheaf.stalk η)
    let _ : Algebra R_S R_X := (f.stalkMap η).hom.toAlgebra
    have : IsLocalHom (algebraMap R_S R_X) :=
      show IsLocalHom (f.stalkMap η).hom from inferInstance
    have : Algebra.EssFiniteType R_S R_X := hEFT_stalk
    have : Algebra.FormallyUnramified R_S R_X :=
      (RingHom.formallyUnramified_algebraMap (R := R_S) (S := R_X)).mp hFU_stalk
    have _hFin_stalk : Module.Finite (IsLocalRing.ResidueField R_S) (IsLocalRing.ResidueField R_X) :=
      Algebra.instFiniteResidueFieldOfFormallyUnramified
    have hAlg_stalk :
        Algebra.IsAlgebraic (IsLocalRing.ResidueField R_S) (IsLocalRing.ResidueField R_X) :=
      Algebra.IsAlgebraic.of_finite _ _
    let _ : Algebra ↥(S.residueField x) ↥(X.residueField η) :=
      (f.residueFieldMap η).hom.toAlgebra
    have : Algebra.IsAlgebraic ↥(S.residueField x) ↥(X.residueField η) := by
      refine ⟨fun y => ?_⟩
      obtain ⟨p, hp_ne, hp_eval⟩ := hAlg_stalk.isAlgebraic y
      exact ⟨p, hp_ne, hp_eval⟩
    let ψ : ↥(X.residueField η) →ₐ[↥(S.residueField x)] Ω := IsAlgClosed.lift
    let φ_res : X.residueField η ⟶ CommRingCat.of Ω := CommRingCat.ofHom ψ.toRingHom
    let u : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X :=
      AlgebraicGeometry.Spec.map φ_res ≫ X.fromSpecResidueField η
    refine ⟨u, ?_, ?_⟩
    · change (AlgebraicGeometry.Spec.map φ_res ≫ X.fromSpecResidueField η) ≫ f = _
      rw [CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField f η,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      congr 1
      apply CommRingCat.hom_ext
      exact ψ.comp_algebraMap
    · intro pt
      exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply η _

  
  
  
  let Idx : Type u :=
    { C : TopologicalSpace.Closeds ↥W.left //
      topologicalKrullDim ↥(C : Set ↥W.left) ≤ (d : WithBot ℕ∞) }
  letI : OrderBot Idx :=
    { bot := ⟨⊥, hBotDim⟩
      bot_le := fun a => (bot_le : (⊥ : TopologicalSpace.Closeds ↥W.left) ≤ a.1) }
  letI : SemilatticeSup Idx :=
    { sup := fun j₁ j₂ => ⟨j₁.1 ⊔ j₂.1, hSupDim j₁.1 j₂.1 j₁.2 j₂.2⟩
      le_sup_left := fun a b => (le_sup_left : a.1 ≤ a.1 ⊔ b.1)
      le_sup_right := fun a b => (le_sup_right : b.1 ≤ a.1 ⊔ b.1)
      sup_le := fun a b c h₁ h₂ => (sup_le h₁ h₂ : a.1 ⊔ b.1 ≤ c.1) }
  have : Nonempty Idx := ⟨⊥⟩
  have : CategoryTheory.IsFiltered Idx :=
    CategoryTheory.isFiltered_of_semilatticeSup_nonempty Idx

  have hMemFinsetSupCloseds : ∀ {Y : Type u} [TopologicalSpace Y] {ι : Type u}
      (s : Finset ι) (f_cl : ι → TopologicalSpace.Closeds Y) (y : Y),
      y ∈ ((s.sup f_cl : TopologicalSpace.Closeds Y) : Set Y) →
      ∃ i ∈ s, y ∈ (f_cl i : Set Y) := by
    intro Y _ ι s f_cl y hy
    classical
    induction s using Finset.induction_on with
    | empty =>
      rw [Finset.sup_empty] at hy
      exact False.elim hy
    | @insert a s' _ ih =>
      rw [Finset.sup_insert] at hy
      rcases hy with ha | hs'
      · exact ⟨a, Finset.mem_insert_self a s', ha⟩
      · obtain ⟨i, hi, hyi⟩ := ih hs'
        exact ⟨i, Finset.mem_insert_of_mem hi, hyi⟩

  have hExhaust : ∀ (U : W.left.Etale), CompactSpace ↥U.left →
      ∀ (s : ↥(ℱ.obj.obj (Opposite.op U))),
      ∃ j : Idx, ∀ (V : W.left.Etale) (v : V ⟶ U),
        Set.range V.hom.base ⊆ (j.1 : Set ↥W.left)ᶜ →
        ℱ.obj.map (Opposite.op v) s = 0 := by
    intro U hU_qc s
    have : CompactSpace ↥U.left := hU_qc
    have : AlgebraicGeometry.Etale U.hom := U.prop
    have : AlgebraicGeometry.IsLocallyNoetherian U.left :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian (U.hom ≫ W.hom)
    have : AlgebraicGeometry.IsNoetherian U.left := {}
    have : TopologicalSpace.NoetherianSpace ↥U.left :=
      AlgebraicGeometry.IsNoetherian.noetherianSpace (X := U.left)
    let O_zero : Set ↥U.left :=
      { y : ↥U.left | ∃ (V : W.left.Etale) (v : V ⟶ U),
        y ∈ Set.range v.left.base ∧ ℱ.obj.map (Opposite.op v) s = 0 }
    have hOpenO : IsOpen O_zero := by
      rw [isOpen_iff_forall_mem_open]
      rintro y ⟨V, v, hy, hv0⟩
      have hEt_v : AlgebraicGeometry.Etale v.left := by
        have hw : v.left ≫ U.hom = V.hom := CategoryTheory.MorphismProperty.Over.w v
        exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          v.left U.hom U.prop (hw.symm ▸ V.prop)
      have : AlgebraicGeometry.Etale v.left := hEt_v
      have hOpenRange : IsOpen (Set.range v.left.base) :=
        (AlgebraicGeometry.Scheme.Hom.isOpenMap v.left).isOpen_range
      exact ⟨Set.range v.left.base, fun y' hy' => ⟨V, v, hy', hv0⟩, hOpenRange, hy⟩
    let Z_s : TopologicalSpace.Closeds ↥U.left := ⟨O_zeroᶜ, hOpenO.isClosed_compl⟩
    obtain ⟨S_K, hIrr, hSupZ⟩ := TopologicalSpace.NoetherianSpace.exists_finset_irreducible Z_s
    classical
    let pts : Finset ↥W.left :=
      S_K.attach.image (fun K => U.hom.base (hIrr K).genericPoint)
    have hDimPts : ∀ x ∈ pts,
        topologicalKrullDim ↥(closure ({x} : Set ↥W.left)) ≤ (d : WithBot ℕ∞) := by
      intro x hx
      obtain ⟨K, -, rfl⟩ := Finset.mem_image.mp hx
      set η_K : ↥U.left := (hIrr K).genericPoint
      have hGen : IsGenericPoint η_K (K.1 : Set ↥U.left) :=
        IsIrreducible.isGenericPoint_genericPoint (hIrr K) K.1.isClosed
      have hη_memK : η_K ∈ (K.1 : Set ↥U.left) := hGen.mem
      have hK_le : K.1 ≤ Z_s := by
        rw [hSupZ]
        exact Finset.le_sup (f := id) K.2
      have hη_not_O : η_K ∉ O_zero := hK_le hη_memK
      by_contra hnot_le
      have hgt : (d : WithBot ℕ∞) < topologicalKrullDim ↥(closure ({U.hom.base η_K} : Set ↥W.left)) :=
        lt_of_not_ge hnot_le
      obtain ⟨u_pt, hu_comp, hu_base⟩ := hGeomLift U.hom η_K
      obtain ⟨V₀, v₀, w₀, hw₀_comp, hv₀_zero⟩ :=
        hSupp (U.hom.base η_K) hgt U u_pt hu_comp s
      let Ω₀ := AlgebraicClosure ↥(W.left.residueField (U.hom.base η_K))
      obtain ⟨pt₀⟩ : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω₀)) := inferInstance
      have hη_in_range : η_K ∈ Set.range v₀.left.base := by
        refine ⟨w₀.base pt₀, ?_⟩
        calc
          v₀.left.base (w₀.base pt₀) = (w₀ ≫ v₀.left).base pt₀ := rfl
          _ = u_pt.base pt₀ := congrArg (fun φ => φ.base pt₀) hw₀_comp
          _ = η_K := hu_base pt₀
      exact hη_not_O ⟨V₀, v₀, hη_in_range, hv₀_zero⟩
    let f_idx : ↥pts → Idx :=
      fun x => ⟨⟨closure ({x.1} : Set ↥W.left), isClosed_closure⟩, hDimPts x.1 x.2⟩
    let j_star : Idx := pts.attach.sup f_idx
    refine ⟨j_star, fun V v hRangeV => ?_⟩
    have hV_in_O : ∀ z : ↥V.left, v.left.base z ∈ O_zero := by
      intro z
      by_contra hz_not
      have hz_Z : v.left.base z ∈ (Z_s : Set ↥U.left) := hz_not
      rw [hSupZ] at hz_Z
      obtain ⟨K, hK_mem, hz_K⟩ := hMemFinsetSupCloseds S_K id (v.left.base z) hz_Z
      dsimp at hz_K
      let K_sub : ↥S_K := ⟨K, hK_mem⟩
      set η_K : ↥U.left := (hIrr K_sub).genericPoint
      have hGen : IsGenericPoint η_K (K : Set ↥U.left) :=
        IsIrreducible.isGenericPoint_genericPoint (hIrr K_sub) K.isClosed
      have hClEq : closure ({η_K} : Set ↥U.left) = (K : Set ↥U.left) :=
        isGenericPoint_def.mp hGen
      rw [← hClEq] at hz_K
      have hImg_mem : U.hom.base (v.left.base z) ∈ U.hom.base '' closure ({η_K} : Set ↥U.left) :=
        ⟨v.left.base z, hz_K, rfl⟩
      have hCl_mem : U.hom.base (v.left.base z) ∈ closure ({U.hom.base η_K} : Set ↥W.left) := by
        have hsub :=
          image_closure_subset_closure_image U.hom.base.hom.continuous (s := ({η_K} : Set ↥U.left))
        rw [Set.image_singleton] at hsub
        exact hsub hImg_mem
      have hVz_eq : U.hom.base (v.left.base z) = V.hom.base z := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.MorphismProperty.Over.w v]
      rw [hVz_eq] at hCl_mem
      have hx_pts : U.hom.base η_K ∈ pts :=
        Finset.mem_image.mpr ⟨K_sub, Finset.mem_attach S_K K_sub, rfl⟩
      have hle_j : f_idx ⟨U.hom.base η_K, hx_pts⟩ ≤ j_star :=
        Finset.le_sup (f := f_idx) (Finset.mem_attach pts ⟨U.hom.base η_K, hx_pts⟩)
      have hz_jstar : V.hom.base z ∈ (j_star.1 : Set ↥W.left) := hle_j hCl_mem
      exact hRangeV ⟨z, rfl⟩ hz_jstar
    set s_V := ℱ.obj.map (Opposite.op v) s
    let R_zero : CategoryTheory.Sieve V :=
      { arrows := fun {Y'} g => ℱ.obj.map (Opposite.op g) s_V = 0
        downward_closed := by
          intro Y' Z' g hg h
          change (ℱ.obj.map (Opposite.op g ≫ Opposite.op h)) s_V = 0
          rw [ℱ.obj.map_comp]
          change (ℱ.obj.map (Opposite.op h)).hom ((ℱ.obj.map (Opposite.op g)).hom s_V) = 0
          rw [hg, map_zero] }
    have hR_mem : R_zero ∈ W.left.smallEtaleTopology V := by
      refine hMemSmallEtale R_zero (fun z => ?_)
      obtain ⟨W_z, w_z, ⟨t_z, ht_z⟩, hw_zero⟩ := hV_in_O z
      have hEt_v : AlgebraicGeometry.Etale v.left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          v.left U.hom U.prop ((CategoryTheory.MorphismProperty.Over.w v).symm ▸ V.prop)
      have hEt_wz : AlgebraicGeometry.Etale w_z.left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          w_z.left U.hom U.prop ((CategoryTheory.MorphismProperty.Over.w w_z).symm ▸ W_z.prop)
      have : AlgebraicGeometry.Etale v.left := hEt_v
      have : AlgebraicGeometry.Etale w_z.left := hEt_wz
      let P_sch := CategoryTheory.Limits.pullback v.left w_z.left
      let fst_z : P_sch ⟶ V.left := CategoryTheory.Limits.pullback.fst v.left w_z.left
      let snd_z : P_sch ⟶ W_z.left := CategoryTheory.Limits.pullback.snd v.left w_z.left
      have : AlgebraicGeometry.Etale V.hom := V.prop
      let P_et : W.left.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (fst_z ≫ V.hom) inferInstance
      let p₁_z : P_et ⟶ V :=
        CategoryTheory.MorphismProperty.Over.homMk fst_z rfl
      let p₂_z : P_et ⟶ W_z :=
        CategoryTheory.MorphismProperty.Over.homMk snd_z (by
          change snd_z ≫ W_z.hom = fst_z ≫ V.hom
          rw [← CategoryTheory.MorphismProperty.Over.w v,
            ← CategoryTheory.MorphismProperty.Over.w w_z,
            ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.condition])
      have hp_comm : p₁_z ≫ v = p₂_z ≫ w_z :=
        CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
      obtain ⟨q_z, hq_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z t_z ht_z.symm
      refine ⟨P_et, p₁_z, q_z, ?_, inferInstance, hq_fst⟩
      change ℱ.obj.map (Opposite.op p₁_z) (ℱ.obj.map (Opposite.op v) s) = 0
      have hcomp_eq : (ℱ.obj.map (Opposite.op v) ≫ ℱ.obj.map (Opposite.op p₁_z)) s =
          (ℱ.obj.map (Opposite.op w_z) ≫ ℱ.obj.map (Opposite.op p₂_z)) s := by
        rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]
        exact congrArg (fun u_hom : P_et ⟶ U => (ℱ.obj.map (Opposite.op u_hom)) s) hp_comm
      change (ℱ.obj.map (Opposite.op v) ≫ ℱ.obj.map (Opposite.op p₁_z)) s = 0
      rw [hcomp_eq]
      change (ℱ.obj.map (Opposite.op p₂_z)).hom ((ℱ.obj.map (Opposite.op w_z)).hom s) = 0
      rw [hw_zero, map_zero]
    exact hSheafSep ℱ R_zero hR_mem s_V 0 (fun g hg => by rw [hg, map_zero])

  
  
  
  let A_sub : Idx → ∀ U : W.left.Etale, AddSubgroup ↥(ℱ.obj.obj (Opposite.op U)) :=
    fun j U =>
      { carrier := { s | ∀ (V : W.left.Etale) (v : V ⟶ U),
          Set.range V.hom.base ⊆ (j.1 : Set ↥W.left)ᶜ → ℱ.obj.map (Opposite.op v) s = 0 }
        zero_mem' := fun _ _ _ => map_zero _
        add_mem' := fun {a b} ha hb V v hV => by
          rw [map_add, ha V v hV, hb V v hV, add_zero]
        neg_mem' := fun {a} ha V v hV => by
          rw [map_neg, ha V v hV, neg_zero] }

  have hSubMono : ∀ {j₁ j₂ : Idx}, j₁ ≤ j₂ → ∀ U : W.left.Etale, A_sub j₁ U ≤ A_sub j₂ U :=
    fun hle _ _ hs V v hV => hs V v (hV.trans (Set.compl_subset_compl.mpr hle))

  let P_sub : Idx → CategoryTheory.Functor (W.left.Etale)ᵒᵖ AddCommGrpCat.{u} :=
    fun j =>
      { obj := fun X => AddCommGrpCat.of ↥(A_sub j X.unop)
        map := fun {X₁ X₂} f =>
          AddCommGrpCat.ofHom
            { toFun := fun s =>
                ⟨ℱ.obj.map f s.1, fun V v hV => by
                  have hEq : ℱ.obj.map (Opposite.op v) (ℱ.obj.map f s.1) =
                      ℱ.obj.map (Opposite.op (v ≫ f.unop)) s.1 := by
                    change (ℱ.obj.map f ≫ ℱ.obj.map (Opposite.op v)) s.1 =
                      ℱ.obj.map (f ≫ Opposite.op v) s.1
                    rw [ℱ.obj.map_comp]
                  rw [hEq]
                  exact s.2 V (v ≫ f.unop) hV⟩
              map_zero' := Subtype.ext (map_zero _)
              map_add' := fun a b => Subtype.ext (map_add _ a.1 b.1) }
        map_id := fun X => by
          ext s
          change (ℱ.obj.map (𝟙 X)) s.1 = s.1
          rw [ℱ.obj.map_id]
          rfl
        map_comp := fun f g => by
          ext s
          change (ℱ.obj.map (f ≫ g)) s.1 = (ℱ.obj.map g) ((ℱ.obj.map f) s.1)
          rw [ℱ.obj.map_comp]
          rfl }

  let ι_pre : ∀ j : Idx, P_sub j ⟶ ℱ.obj := fun j =>
    { app := fun X => AddCommGrpCat.ofHom (A_sub j X.unop).subtype
      naturality := fun _ _ _ => rfl }

  have hSubOut : ∀ (j : Idx) (U : W.left.Etale),
      Set.range U.hom.base ⊆ (j.1 : Set ↥W.left)ᶜ →
      Subsingleton ↥((P_sub j).obj (Opposite.op U)) := by
    intro j U hU
    refine subsingleton_of_forall_eq 0 (fun s => Subtype.ext ?_)
    have h0 : (ℱ.obj.map (𝟙 (Opposite.op U))) s.1 = 0 := s.2 U (𝟙 U) hU
    rw [ℱ.obj.map_id] at h0
    exact h0

  have hSheafP : ∀ j : Idx, CategoryTheory.Presheaf.IsSheaf W.left.smallEtaleTopology (P_sub j) := by
    intro j
    rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
    intro U R hR
    obtain ⟨hc_ℱ⟩ :=
      (CategoryTheory.Presheaf.isSheaf_iff_isLimit W.left.smallEtaleTopology ℱ.obj).mp
        ℱ.property R hR
    refine ⟨{
      lift := fun s =>
        let s_ℱ : CategoryTheory.Limits.Cone (R.arrows.diagram.op ⋙ ℱ.obj) :=
          { pt := s.pt
            π := s.π ≫ CategoryTheory.Functor.whiskerLeft R.arrows.diagram.op (ι_pre j) }
        let L : s.pt ⟶ (ℱ.obj.mapCone R.arrows.cocone.op).pt := hc_ℱ.lift s_ℱ
        have hL_mem : ∀ m : ↥s.pt, L m ∈ A_sub j U := by
          intro m V v hV
          let R' : CategoryTheory.Sieve V := R.pullback v
          have hR' : R' ∈ W.left.smallEtaleTopology V :=
            W.left.smallEtaleTopology.pullback_stable v hR
          refine hSheafSep ℱ R' hR' (ℱ.obj.map (Opposite.op v) (L m)) 0 (fun {W'} w hw => ?_)
          rw [map_zero]
          let I₀ : R.arrows.category := ⟨CategoryTheory.Over.mk (w ≫ v), hw⟩
          have hMapEq : ℱ.obj.map (Opposite.op w) (ℱ.obj.map (Opposite.op v) (L m)) =
              ((L ≫ (ℱ.obj.mapCone R.arrows.cocone.op).π.app (Opposite.op I₀)) m) := by
            change (ℱ.obj.map (Opposite.op v) ≫ ℱ.obj.map (Opposite.op w)) (L m) =
              (ℱ.obj.map (Opposite.op (w ≫ v))) (L m)
            rw [← ℱ.obj.map_comp]
            rfl
          rw [hMapEq, hc_ℱ.fac s_ℱ (Opposite.op I₀)]
          have hW_range : Set.range W'.hom.base ⊆ (j.1 : Set ↥W.left)ᶜ := by
            rintro _ ⟨y, rfl⟩
            have hhom : W'.hom.base y = V.hom.base (w.left.base y) := by
              rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
                CategoryTheory.MorphismProperty.Over.w w]
            rw [hhom]
            exact hV ⟨w.left.base y, rfl⟩
          have hsub0 : (s.π.app (Opposite.op I₀) m : ↥((P_sub j).obj (Opposite.op W'))) = 0 :=
            @Subsingleton.elim _ (hSubOut j W' hW_range) _ 0
          change ((ι_pre j).app (Opposite.op W')) (s.π.app (Opposite.op I₀) m) = 0
          rw [hsub0, map_zero]
        AddCommGrpCat.ofHom
          { toFun := fun m => ⟨L m, hL_mem m⟩
            map_zero' := Subtype.ext (map_zero _)
            map_add' := fun a b => Subtype.ext (map_add _ a b) }
      fac := fun s I => by
        let s_ℱ : CategoryTheory.Limits.Cone (R.arrows.diagram.op ⋙ ℱ.obj) :=
          { pt := s.pt
            π := s.π ≫ CategoryTheory.Functor.whiskerLeft R.arrows.diagram.op (ι_pre j) }
        have hfac := hc_ℱ.fac s_ℱ I
        refine AddCommGrpCat.ext (fun m => Subtype.ext ?_)
        exact congrArg (fun φ : s.pt ⟶ (R.arrows.diagram.op ⋙ ℱ.obj).obj I => φ m) hfac
      uniq := fun s f hf => by
        let s_ℱ : CategoryTheory.Limits.Cone (R.arrows.diagram.op ⋙ ℱ.obj) :=
          { pt := s.pt
            π := s.π ≫ CategoryTheory.Functor.whiskerLeft R.arrows.diagram.op (ι_pre j) }
        let f_ℱ : s.pt ⟶ (ℱ.obj.mapCone R.arrows.cocone.op).pt :=
          f ≫ (ι_pre j).app (Opposite.op U)
        have hf_ℱ : f_ℱ = hc_ℱ.lift s_ℱ := by
          refine hc_ℱ.uniq s_ℱ f_ℱ (fun I => ?_)
          change (f ≫ ((P_sub j).mapCone R.arrows.cocone.op).π.app I) ≫
              (ι_pre j).app (R.arrows.diagram.op.obj I) =
            s.π.app I ≫ (ι_pre j).app (R.arrows.diagram.op.obj I)
          rw [hf I]
        refine AddCommGrpCat.ext (fun m => Subtype.ext ?_)
        exact congrArg (fun φ : s.pt ⟶ (ℱ.obj.mapCone R.arrows.cocone.op).pt => φ m) hf_ℱ }⟩

  let D : CategoryTheory.Functor Idx
      (CategoryTheory.Sheaf W.left.smallEtaleTopology AddCommGrpCat.{u}) :=
    { obj := fun j => ⟨P_sub j, hSheafP j⟩
      map := fun {j₁ j₂} φ =>
        ⟨{ app := fun X =>
             AddCommGrpCat.ofHom (AddSubgroup.inclusion (hSubMono (leOfHom φ) X.unop))
           naturality := fun _ _ _ => rfl }⟩
      map_id := fun _ => rfl
      map_comp := fun _ _ => rfl }

  let ι_sh : ∀ j : Idx, D.obj j ⟶ ℱ := fun j => ⟨ι_pre j⟩

  have hMono_ι : ∀ j : Idx, CategoryTheory.Mono (ι_sh j) := by
    intro j
    refine ⟨fun {G} g₁ g₂ hg => ?_⟩
    ext X y
    have hy : ((g₁ ≫ ι_sh j).hom.app X) y = ((g₂ ≫ ι_sh j).hom.app X) y := by
      rw [hg]
    exact hy

  let c_colim : CategoryTheory.Limits.Cocone D :=
    { pt := ℱ
      ι :=
        { app := ι_sh
          naturality := fun _ _ _ => by
            ext X s
            rfl } }

  
  have hc_colim : CategoryTheory.Limits.IsColimit c_colim := by
    let R_exh : ∀ (U₀ : W.left.Etale), ↥(ℱ.obj.obj (Opposite.op U₀)) →
        CategoryTheory.Sieve U₀ := fun U₀ s₀ =>
      { arrows := fun {V} g => ∃ j : Idx, ℱ.obj.map (Opposite.op g) s₀ ∈ A_sub j V
        downward_closed := by
          rintro V W' g ⟨j, hj⟩ h
          refine ⟨j, ?_⟩
          have hEq : ℱ.obj.map (Opposite.op (h ≫ g)) s₀ =
              ℱ.obj.map (Opposite.op h) (ℱ.obj.map (Opposite.op g) s₀) := by
            change (ℱ.obj.map (Opposite.op g ≫ Opposite.op h)) s₀ = _
            rw [ℱ.obj.map_comp]
            rfl
          rw [hEq]
          exact ((P_sub j).map (Opposite.op h) ⟨_, hj⟩).2 }
    have hR_exh_mem : ∀ (U₀ : W.left.Etale) (s₀ : ↥(ℱ.obj.obj (Opposite.op U₀))),
        R_exh U₀ s₀ ∈ W.left.smallEtaleTopology U₀ := by
      intro U₀ s₀
      refine hMemSmallEtale (R_exh U₀ s₀) (fun z => ?_)
      obtain ⟨O_z, hAff_z, hz_mem, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤) trivial
      have : AlgebraicGeometry.IsAffine (O_z : AlgebraicGeometry.Scheme.{u}) := hAff_z
      have : AlgebraicGeometry.Etale U₀.hom := U₀.prop
      let U_z : W.left.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (O_z.ι ≫ U₀.hom) inferInstance
      let g_z : U_z ⟶ U₀ :=
        CategoryTheory.MorphismProperty.Over.homMk O_z.ι rfl
      have hU_z_qc : CompactSpace ↥U_z.left :=
        show CompactSpace ↥(O_z : AlgebraicGeometry.Scheme.{u}) from inferInstance
      exact ⟨U_z, g_z, ⟨z, hz_mem⟩,
        hExhaust U_z hU_z_qc (ℱ.obj.map (Opposite.op g_z) s₀), inferInstance, rfl⟩
    have hIndep_j : ∀ (t : CategoryTheory.Limits.Cocone D) {V : W.left.Etale} {j₁ j₂ : Idx}
        {x : ↥(ℱ.obj.obj (Opposite.op V))}
        (hx₁ : x ∈ A_sub j₁ V) (hx₂ : x ∈ A_sub j₂ V),
        ((t.ι.app j₁).hom.app (Opposite.op V)) ⟨x, hx₁⟩ =
          ((t.ι.app j₂).hom.app (Opposite.op V)) ⟨x, hx₂⟩ := by
      intro t V j₁ j₂ x hx₁ hx₂
      have hle_j : ∀ {a b : Idx} (hab : a ≤ b) (hxa : x ∈ A_sub a V),
          ((t.ι.app a).hom.app (Opposite.op V)) ⟨x, hxa⟩ =
            ((t.ι.app b).hom.app (Opposite.op V)) ⟨x, hSubMono hab V hxa⟩ := by
        intro a b hab hxa
        have hnat := t.ι.naturality (CategoryTheory.homOfLE hab)
        have hApp := congrArg
          (fun φ : D.obj a ⟶ ((CategoryTheory.Functor.const Idx).obj t.pt).obj b =>
            φ.hom.app (Opposite.op V) ⟨x, hxa⟩)
          hnat
        exact hApp.symm
      exact (hle_j le_sup_left hx₁).trans (hle_j le_sup_right hx₂).symm
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let cone_s₀ : ∀ (t : CategoryTheory.Limits.Cocone D) (U₀ : W.left.Etale)
        (s₀ : ↥(ℱ.obj.obj (Opposite.op U₀))),
        CategoryTheory.Limits.Cone ((R_exh U₀ s₀).arrows.diagram.op ⋙ t.pt.obj) :=
      fun t U₀ s₀ =>
        let R₀ := R_exh U₀ s₀
        let locVal : ∀ I : R₀.arrows.category, ↥(t.pt.obj.obj (Opposite.op I.obj.left)) :=
          fun I =>
            ((t.ι.app (Classical.choose I.property)).hom.app (Opposite.op I.obj.left))
              ⟨ℱ.obj.map (Opposite.op I.obj.hom) s₀, Classical.choose_spec I.property⟩
        { pt := Aℤ
          π :=
            { app := fun I =>
                AddCommGrpCat.ofHom
                  { toFun := fun n => n.down • locVal I.unop
                    map_zero' := zero_zsmul _
                    map_add' := fun a b => add_zsmul _ a.down b.down }
              naturality := fun {I₁ I₂} u => by
                let V₁ : W.left.Etale := I₁.unop.obj.left
                let V₂ : W.left.Etale := I₂.unop.obj.left
                let h : V₂ ⟶ V₁ := u.unop.hom.left
                let g₁ : V₁ ⟶ U₀ := I₁.unop.obj.hom
                let g₂ : V₂ ⟶ U₀ := I₂.unop.obj.hom
                have hh_w : h ≫ g₁ = g₂ := CategoryTheory.Over.w u.unop.hom
                let j₁ := Classical.choose I₁.unop.property
                have hj₁ : (ℱ.obj.map g₁.op).hom s₀ ∈ A_sub j₁ V₁ :=
                  Classical.choose_spec I₁.unop.property
                have hMap_h : (ℱ.obj.map g₂.op).hom s₀ =
                    (ℱ.obj.map h.op).hom ((ℱ.obj.map g₁.op).hom s₀) := by
                  rw [← hh_w]
                  change (ℱ.obj.map (g₁.op ≫ h.op)).hom s₀ = _
                  rw [ℱ.obj.map_comp]
                  rfl
                have hj₂_from_j₁ : (ℱ.obj.map g₂.op).hom s₀ ∈ A_sub j₁ V₂ := by
                  rw [hMap_h]
                  exact ((P_sub j₁).map h.op ⟨_, hj₁⟩).2
                have hNat_tj := (t.ι.app j₁).hom.naturality h.op
                have hApp := congrArg
                  (fun φ : (D.obj j₁).obj.obj (Opposite.op V₁) ⟶
                      t.pt.obj.obj (Opposite.op V₂) =>
                    φ ⟨(ℱ.obj.map g₁.op).hom s₀, hj₁⟩)
                  hNat_tj
                dsimp at hApp
                have hLoc_step : (t.pt.obj.map h.op).hom (locVal I₁.unop) =
                    locVal I₂.unop := by
                  refine hApp.symm.trans ?_
                  have hSubEq :
                      ((P_sub j₁).map h.op ⟨(ℱ.obj.map g₁.op).hom s₀, hj₁⟩ : ↥(A_sub j₁ V₂)) =
                      ⟨(ℱ.obj.map g₂.op).hom s₀, hj₂_from_j₁⟩ :=
                    Subtype.ext hMap_h.symm
                  exact (congrArg ((t.ι.app j₁).hom.app (Opposite.op V₂))
                    hSubEq).trans (hIndep_j t hj₂_from_j₁ (Classical.choose_spec I₂.unop.property))
                ext n
                change n.down • locVal I₂.unop =
                  (t.pt.obj.map h.op).hom (n.down • locVal I₁.unop)
                rw [map_zsmul, hLoc_step] } }
    let glueSec : ∀ (t : CategoryTheory.Limits.Cocone D) (U₀ : W.left.Etale)
        (s₀ : ↥(ℱ.obj.obj (Opposite.op U₀))),
        ↥(t.pt.obj.obj (Opposite.op U₀)) := fun t U₀ s₀ =>
      let R₀ := R_exh U₀ s₀
      let hc_t := Classical.choice
        ((CategoryTheory.Presheaf.isSheaf_iff_isLimit W.left.smallEtaleTopology t.pt.obj).mp
          t.pt.property R₀ (hR_exh_mem U₀ s₀))
      (hc_t.lift (cone_s₀ t U₀ s₀)) (ULift.up 1)
    have hGlueSpec : ∀ (t : CategoryTheory.Limits.Cocone D) (U₀ : W.left.Etale)
        (s₀ : ↥(ℱ.obj.obj (Opposite.op U₀))) {V : W.left.Etale} (g : V ⟶ U₀) (j : Idx)
        (hj : ℱ.obj.map (Opposite.op g) s₀ ∈ A_sub j V),
        t.pt.obj.map (Opposite.op g) (glueSec t U₀ s₀) =
          ((t.ι.app j).hom.app (Opposite.op V)) ⟨ℱ.obj.map (Opposite.op g) s₀, hj⟩ := by
      intro t U₀ s₀ V g j hj
      let R₀ := R_exh U₀ s₀
      let hc_t := Classical.choice
        ((CategoryTheory.Presheaf.isSheaf_iff_isLimit W.left.smallEtaleTopology t.pt.obj).mp
          t.pt.property R₀ (hR_exh_mem U₀ s₀))
      let I₀ : R₀.arrows.category := ⟨CategoryTheory.Over.mk g, ⟨j, hj⟩⟩
      have hfac := congrArg
        (fun φ : Aℤ ⟶ ((R₀.arrows.diagram.op ⋙ t.pt.obj).obj (Opposite.op I₀)) => φ (ULift.up 1))
        (hc_t.fac (cone_s₀ t U₀ s₀) (Opposite.op I₀))
      change (t.pt.obj.map (Opposite.op g)) (glueSec t U₀ s₀) =
        (1 : ℤ) • (((t.ι.app (Classical.choose I₀.property)).hom.app (Opposite.op V))
          ⟨ℱ.obj.map (Opposite.op g) s₀, Classical.choose_spec I₀.property⟩) at hfac
      rw [one_zsmul] at hfac
      exact hfac.trans (hIndep_j t (Classical.choose_spec I₀.property) hj)
    let desc_fn : ∀ t : CategoryTheory.Limits.Cocone D, ℱ ⟶ t.pt := fun t =>
      ⟨{ app := fun X =>
           AddCommGrpCat.ofHom
             { toFun := glueSec t X.unop
               map_zero' := by
                 have h0_mem : ℱ.obj.map (Opposite.op (𝟙 X.unop)) (0 : ↥(ℱ.obj.obj X)) ∈
                     A_sub ⊥ X.unop := by
                   rw [map_zero]
                   exact (A_sub ⊥ X.unop).zero_mem
                 have hspec := hGlueSpec t X.unop 0 (𝟙 X.unop) ⊥ h0_mem
                 change (t.pt.obj.map (𝟙 (Opposite.op X.unop))) (glueSec t X.unop 0) = _ at hspec
                 rw [t.pt.obj.map_id] at hspec
                 have hzero_sub : (⟨ℱ.obj.map (Opposite.op (𝟙 X.unop)) 0, h0_mem⟩ :
                     ↥(A_sub ⊥ X.unop)) = 0 := Subtype.ext (map_zero _)
                 exact hspec.trans (by rw [hzero_sub, map_zero])
               map_add' := fun s₁ s₂ => by
                 let U₀ := X.unop
                 let R₁₂ := R_exh U₀ s₁ ⊓ R_exh U₀ s₂
                 have hR₁₂ : R₁₂ ∈ W.left.smallEtaleTopology U₀ :=
                   W.left.smallEtaleTopology.intersection_covering
                     (hR_exh_mem U₀ s₁) (hR_exh_mem U₀ s₂)
                 refine hSheafSep t.pt R₁₂ hR₁₂ (glueSec t U₀ (s₁ + s₂))
                   (glueSec t U₀ s₁ + glueSec t U₀ s₂)
                   (fun {V} g ⟨⟨j₁, hj₁⟩, ⟨j₂, hj₂⟩⟩ => ?_)
                 let j := j₁ ⊔ j₂
                 have hj₁' : ℱ.obj.map (Opposite.op g) s₁ ∈ A_sub j V :=
                   hSubMono le_sup_left V hj₁
                 have hj₂' : ℱ.obj.map (Opposite.op g) s₂ ∈ A_sub j V :=
                   hSubMono le_sup_right V hj₂
                 have hj₁₂ : ℱ.obj.map (Opposite.op g) (s₁ + s₂) ∈ A_sub j V := by
                   rw [map_add]
                   exact (A_sub j V).add_mem hj₁' hj₂'
                 rw [map_add, hGlueSpec t U₀ (s₁ + s₂) g j hj₁₂,
                   hGlueSpec t U₀ s₁ g j hj₁', hGlueSpec t U₀ s₂ g j hj₂',
                   ← map_add]
                 congr 1
                 exact Subtype.ext (map_add _ s₁ s₂) }
         naturality := fun {X₁ X₂} f => by
           ext s₀
           let U₂ := X₁.unop
           let U₁ := X₂.unop
           let u : U₁ ⟶ U₂ := f.unop
           let R_pb := (R_exh U₂ s₀).pullback u
           have hR_pb : R_pb ∈ W.left.smallEtaleTopology U₁ :=
             W.left.smallEtaleTopology.pullback_stable u (hR_exh_mem U₂ s₀)
           refine hSheafSep t.pt R_pb hR_pb
             (glueSec t U₁ (ℱ.obj.map f s₀))
             (t.pt.obj.map f (glueSec t U₂ s₀))
             (fun {V} g ⟨j, hj⟩ => ?_)
           have hEqF : ℱ.obj.map (Opposite.op g) (ℱ.obj.map f s₀) =
               ℱ.obj.map (Opposite.op (g ≫ u)) s₀ := by
             change (ℱ.obj.map f ≫ ℱ.obj.map (Opposite.op g)) s₀ =
               ℱ.obj.map (f ≫ Opposite.op g) s₀
             rw [ℱ.obj.map_comp]
           have hj_g : ℱ.obj.map (Opposite.op g) (ℱ.obj.map f s₀) ∈ A_sub j V := by
             rw [hEqF]
             exact hj
           have hEqT : t.pt.obj.map (Opposite.op g) (t.pt.obj.map f (glueSec t U₂ s₀)) =
               t.pt.obj.map (Opposite.op (g ≫ u)) (glueSec t U₂ s₀) := by
             change (t.pt.obj.map f ≫ t.pt.obj.map (Opposite.op g)) (glueSec t U₂ s₀) =
               t.pt.obj.map (f ≫ Opposite.op g) (glueSec t U₂ s₀)
             rw [t.pt.obj.map_comp]
           rw [hEqT, hGlueSpec t U₁ (ℱ.obj.map f s₀) g j hj_g,
             hGlueSpec t U₂ s₀ (g ≫ u) j hj]
           congr 1
           exact Subtype.ext hEqF }⟩
    exact
      { desc := desc_fn
        fac := fun t j => by
          ext X s
          let U₀ := X.unop
          have hid_mem : ℱ.obj.map (Opposite.op (𝟙 U₀)) s.1 ∈ A_sub j U₀ := by
            change (ℱ.obj.map (𝟙 (Opposite.op U₀))) s.1 ∈ A_sub j U₀
            rw [ℱ.obj.map_id]
            exact s.2
          have hspec := hGlueSpec t U₀ s.1 (𝟙 U₀) j hid_mem
          change (t.pt.obj.map (𝟙 (Opposite.op U₀))) (glueSec t U₀ s.1) = _ at hspec
          rw [t.pt.obj.map_id] at hspec
          change glueSec t U₀ s.1 = ((t.ι.app j).hom.app X) s
          refine hspec.trans ?_
          congr 1
          apply Subtype.ext
          change (ℱ.obj.map (𝟙 (Opposite.op U₀))) s.1 = s.1
          rw [ℱ.obj.map_id]
          rfl
        uniq := fun t m hm => by
          ext X s₀
          rcases X with ⟨U₀⟩
          refine hSheafSep t.pt (R_exh U₀ s₀) (hR_exh_mem U₀ s₀)
            (m.hom.app (Opposite.op U₀) s₀) (glueSec t U₀ s₀) (fun {V} g hg => ?_)
          rcases hg with ⟨j, hj⟩
          have hNatM := congrArg
            (fun φ : ℱ.obj.obj (Opposite.op U₀) ⟶ t.pt.obj.obj (Opposite.op V) => φ s₀)
            (m.hom.naturality (Opposite.op g))
          dsimp at hNatM
          have hmj := congrArg
            (fun ψ : D.obj j ⟶ t.pt => ψ.hom.app (Opposite.op V) ⟨ℱ.obj.map (Opposite.op g) s₀, hj⟩)
            (hm j)
          exact hNatM.symm.trans (hmj.trans (hGlueSpec t U₀ s₀ g j hj).symm) }

  exact ⟨Idx, inferInstance, inferInstance, D, c_colim, rfl, ⟨hc_colim⟩, hMono_ι,
    fun j => ⟨j.1, j.2, hSubOut j⟩⟩

theorem weil_alt_cd_closed_immersion_support_cohomology_vanishing {Z S : AlgebraicGeometry.Scheme.{u}} [S.IsSeparated]
    (i : Z ⟶ S) [AlgebraicGeometry.IsClosedImmersion i]
    (ℓ q : ℕ)
    (hVanishZ : ∀ (𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id 𝒢 = 0 → Subsingleton (𝒢.H q))
    (ℋ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
    (hℓ_ℋ : ℓ • CategoryTheory.CategoryStruct.id ℋ = 0)
    (hZeroOut : ∀ U : S.Etale,
      Set.range U.hom.base ⊆ (Set.range i.base)ᶜ →
      Subsingleton ↥(ℋ.obj.obj (Opposite.op U))) :
    Subsingleton (ℋ.H q) :=
by
  
  have hAffLift : ∀ (A A_Z B_Z : Type u) [CommRing A] [CommRing A_Z] [CommRing B_Z]
      (π : A →+* A_Z) (f_Z : A_Z →+* B_Z),
      Function.Surjective π → f_Z.Etale →
      ∃ (B_A : Type u) (_ : CommRing B_A) (f_A : A →+* B_A) (π_B : B_A →+* B_Z),
        f_A.Etale ∧
        CategoryTheory.IsPushout
          (CommRingCat.ofHom π) (CommRingCat.ofHom f_A)
          (CommRingCat.ofHom f_Z) (CommRingCat.ofHom π_B) := by
    intro A A_Z B_Z _ _ _ π f_Z hπ hf_Z
    classical
    letI : Algebra A_Z B_Z := f_Z.toAlgebra
    have hf_Z_alg : Algebra.Etale A_Z B_Z := RingHom.etale_algebraMap.mp hf_Z
    have hStdZ : Algebra.IsStandardSmoothOfRelativeDimension 0 A_Z B_Z :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hf_Z_alg
    rcases hStdZ.out with ⟨ι₀, σ₀, hFin_σ₀, hFin_ι₀, P₀, hdim₀⟩
    letI : Fintype ι₀ := Fintype.ofFinite ι₀
    letI : Fintype σ₀ := Fintype.ofFinite σ₀
    have hCardLe : Nat.card σ₀ ≤ Nat.card ι₀ :=
      Nat.card_le_card_of_injective P₀.map P₀.map_inj
    have hCardEq : Nat.card ι₀ = Nat.card σ₀ := by
      have hd : Nat.card ι₀ - Nat.card σ₀ = 0 := hdim₀
      omega
    have hMapSurj : Function.Surjective (MvPolynomial.map π : MvPolynomial ι₀ A →+* MvPolynomial ι₀ A_Z) :=
      MvPolynomial.map_surjective π hπ
    let rel_A : σ₀ → MvPolynomial ι₀ A := fun c => Classical.choose (hMapSurj (P₀.relation c))
    have hrel_A : ∀ c : σ₀, MvPolynomial.map π (rel_A c) = P₀.relation c :=
      fun c => Classical.choose_spec (hMapSurj (P₀.relation c))
    let I_A : Ideal (MvPolynomial ι₀ A) := Ideal.span (Set.range rel_A)
    let Q_A : Type u := MvPolynomial ι₀ A ⧸ I_A
    let P_Q : Algebra.PreSubmersivePresentation A Q_A ι₀ σ₀ :=
      Algebra.PreSubmersivePresentation.naive (v := rel_A) P₀.map P₀.map_inj
    let j_Q : Q_A := P_Q.jacobian
    let B_A : Type u := Localization.Away j_Q
    let f_A : A →+* B_A := algebraMap A B_A
    let Q_loc : Algebra.PreSubmersivePresentation Q_A B_A Unit Unit :=
      Algebra.PreSubmersivePresentation.localizationAway B_A j_Q
    let P_comp : Algebra.PreSubmersivePresentation A B_A (Unit ⊕ ι₀) (Unit ⊕ σ₀) :=
      Q_loc.comp P_Q
    have hDimComp : P_comp.dimension = 0 := by
      change Nat.card (Unit ⊕ ι₀) - Nat.card (Unit ⊕ σ₀) = 0
      rw [Nat.card_sum, Nat.card_sum, Nat.card_unique, hCardEq, Nat.sub_self]
    have hj_unit : IsUnit (algebraMap Q_A B_A j_Q) :=
      IsLocalization.Away.algebraMap_isUnit j_Q
    have hJacUnit : IsUnit P_comp.jacobian := by
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
        Algebra.PreSubmersivePresentation.localizationAway_jacobian, Algebra.smul_def]
      exact hj_unit.mul hj_unit
    let P_sub : Algebra.SubmersivePresentation A B_A (Unit ⊕ ι₀) (Unit ⊕ σ₀) :=
      { P_comp with jacobian_isUnit := hJacUnit }
    have hStdA : Algebra.IsStandardSmoothOfRelativeDimension 0 A B_A :=
      ⟨⟨Unit ⊕ ι₀, Unit ⊕ σ₀, inferInstance, inferInstance, P_sub, hDimComp⟩⟩
    have hEtAlgA : Algebra.Etale A B_A :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr hStdA
    have hf_A : f_A.Etale := RingHom.etale_algebraMap.mpr hEtAlgA
    let p_Z : MvPolynomial ι₀ A_Z →+* B_Z := algebraMap P₀.Ring B_Z
    have hp_Z_aeval : ∀ w : MvPolynomial ι₀ A_Z, p_Z w = MvPolynomial.aeval P₀.val w :=
      fun w => P₀.algebraMap_apply w
    have hp_Z_surj : Function.Surjective p_Z := P₀.algebraMap_surjective
    have hp_Z_ker : RingHom.ker p_Z = Ideal.span (Set.range P₀.relation) :=
      P₀.span_range_relation_eq_ker.symm
    let ev₀ : MvPolynomial ι₀ A →+* B_Z := p_Z.comp (MvPolynomial.map π)
    have hI_le_ker : I_A ≤ RingHom.ker ev₀ := by
      rw [Ideal.span_le]
      rintro _ ⟨c, rfl⟩
      change p_Z (MvPolynomial.map π (rel_A c)) = 0
      rw [hrel_A c]
      have hmem : P₀.relation c ∈ Ideal.span (Set.range P₀.relation) :=
        Ideal.subset_span ⟨c, rfl⟩
      rw [← hp_Z_ker] at hmem
      exact hmem
    let q₀ : Q_A →+* B_Z := Ideal.Quotient.lift I_A ev₀ hI_le_ker
    have hq₀_mk : ∀ w : MvPolynomial ι₀ A, q₀ (Ideal.Quotient.mk I_A w) = ev₀ w :=
      fun _ => rfl
    have hMatEq : (MvPolynomial.map π).mapMatrix P_Q.jacobiMatrix = P₀.jacobiMatrix := by
      refine Matrix.ext fun r s => ?_
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      change MvPolynomial.map π ((MvPolynomial.pderiv (P₀.map r)) (rel_A s)) =
        (MvPolynomial.pderiv (P₀.map r)) (P₀.relation s)
      rw [← MvPolynomial.pderiv_map, hrel_A s]
    have hq₀_j : q₀ j_Q = P₀.jacobian := by
      change q₀ P_Q.jacobian = P₀.jacobian
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
        Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
      change q₀ (Ideal.Quotient.mk I_A P_Q.jacobiMatrix.det) = p_Z P₀.jacobiMatrix.det
      rw [hq₀_mk]
      change p_Z ((MvPolynomial.map π) P_Q.jacobiMatrix.det) = p_Z P₀.jacobiMatrix.det
      rw [RingHom.map_det, hMatEq]
    have hq₀_unit : IsUnit (q₀ j_Q) := by
      rw [hq₀_j]
      exact P₀.jacobian_isUnit
    let π_B : B_A →+* B_Z := IsLocalization.Away.lift j_Q hq₀_unit
    have hCommSq : (CommRingCat.ofHom π ≫ CommRingCat.ofHom f_Z) =
        (CommRingCat.ofHom f_A ≫ CommRingCat.ofHom π_B) := by
      apply CommRingCat.hom_ext
      ext a
      change f_Z (π a) = π_B (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.C a)))
      rw [IsLocalization.Away.lift_eq j_Q hq₀_unit, hq₀_mk]
      change f_Z (π a) = p_Z (MvPolynomial.map π (MvPolynomial.C a))
      rw [MvPolynomial.map_C, hp_Z_aeval, MvPolynomial.aeval_C]
      rfl
    refine ⟨B_A, inferInstance, f_A, π_B, hf_A, ?_⟩
    refine CategoryTheory.IsPushout.of_isColimit (c := CategoryTheory.Limits.PushoutCocone.mk
      (CommRingCat.ofHom f_Z) (CommRingCat.ofHom π_B) hCommSq) ?_
    refine CategoryTheory.Limits.PushoutCocone.isColimitAux' _ (fun s => ?_)
    let g₁ : A_Z →+* s.pt := s.inl.hom
    let g₂ : B_A →+* s.pt := s.inr.hom
    have hg_comm : g₁.comp π = g₂.comp f_A := by
      ext a
      exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom s.condition) a
    let x_gen : ι₀ → B_A := fun k => algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.X k))
    have hπ_B_x : ∀ k : ι₀, π_B (x_gen k) = P₀.val k := by
      intro k
      change π_B (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.X k))) = P₀.val k
      rw [IsLocalization.Away.lift_eq j_Q hq₀_unit, hq₀_mk]
      change p_Z (MvPolynomial.map π (MvPolynomial.X k)) = P₀.val k
      rw [MvPolynomial.map_X, hp_Z_aeval, MvPolynomial.aeval_X]
    let ψ : MvPolynomial ι₀ A_Z →+* s.pt := MvPolynomial.eval₂Hom g₁ (fun k => g₂ (x_gen k))
    have hψ_map : ψ.comp (MvPolynomial.map π) = (g₂.comp (algebraMap Q_A B_A)).comp (Ideal.Quotient.mk I_A) := by
      apply MvPolynomial.ringHom_ext
      · intro a
        change ψ (MvPolynomial.map π (MvPolynomial.C a)) =
          g₂ (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.C a)))
        rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
        exact RingHom.congr_fun hg_comm a
      · intro k
        change ψ (MvPolynomial.map π (MvPolynomial.X k)) = g₂ (x_gen k)
        rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
    have hker_le : RingHom.ker p_Z ≤ RingHom.ker ψ := by
      rw [hp_Z_ker, Ideal.span_le]
      rintro _ ⟨c, rfl⟩
      change ψ (P₀.relation c) = 0
      rw [← hrel_A c]
      have h0 : Ideal.Quotient.mk I_A (rel_A c) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨c, rfl⟩)
      have hval := RingHom.congr_fun hψ_map (rel_A c)
      change ψ (MvPolynomial.map π (rel_A c)) = g₂ (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (rel_A c))) at hval
      rw [hval, h0, map_zero, map_zero]
    let e_quot : MvPolynomial ι₀ A_Z ⧸ RingHom.ker p_Z ≃+* B_Z :=
      RingHom.quotientKerEquivOfSurjective hp_Z_surj
    let h_hom : B_Z →+* s.pt :=
      (Ideal.Quotient.lift (RingHom.ker p_Z) ψ hker_le).comp e_quot.symm.toRingHom
    have hh_pZ : ∀ w : MvPolynomial ι₀ A_Z, h_hom (p_Z w) = ψ w := by
      intro w
      have he : e_quot.symm (p_Z w) = Ideal.Quotient.mk (RingHom.ker p_Z) w := by
        apply e_quot.injective
        rw [RingEquiv.apply_symm_apply]
        rfl
      change Ideal.Quotient.lift (RingHom.ker p_Z) ψ hker_le (e_quot.symm (p_Z w)) = ψ w
      rw [he]
      rfl
    have hh_inl : CommRingCat.ofHom f_Z ≫ CommRingCat.ofHom h_hom = s.inl := by
      apply CommRingCat.hom_ext
      ext a_z
      change h_hom (f_Z a_z) = g₁ a_z
      have hfZ_eq : f_Z a_z = p_Z (MvPolynomial.C a_z) := by
        rw [hp_Z_aeval, MvPolynomial.aeval_C]
        rfl
      rw [hfZ_eq, hh_pZ, MvPolynomial.eval₂Hom_C]
    have hh_inr : CommRingCat.ofHom π_B ≫ CommRingCat.ofHom h_hom = s.inr := by
      apply CommRingCat.hom_ext
      apply IsLocalization.ringHom_ext (Submonoid.powers j_Q)
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        change h_hom (π_B (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.C a)))) =
          g₂ (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.C a)))
        rw [IsLocalization.Away.lift_eq j_Q hq₀_unit, hq₀_mk]
        change h_hom (p_Z (MvPolynomial.map π (MvPolynomial.C a))) =
          g₂ (algebraMap Q_A B_A (Ideal.Quotient.mk I_A (MvPolynomial.C a)))
        rw [hh_pZ]
        exact RingHom.congr_fun hψ_map (MvPolynomial.C a)
      · intro k
        change h_hom (π_B (x_gen k)) = g₂ (x_gen k)
        rw [hπ_B_x k]
        have hpval : P₀.val k = p_Z (MvPolynomial.X k) := by
          rw [hp_Z_aeval, MvPolynomial.aeval_X]
        rw [hpval, hh_pZ, MvPolynomial.eval₂Hom_X']
    refine ⟨CommRingCat.ofHom h_hom, hh_inl, hh_inr, fun {m} hm₁ hm₂ => ?_⟩
    apply CommRingCat.hom_ext
    ext b
    obtain ⟨w, rfl⟩ := hp_Z_surj b
    change m.hom (p_Z w) = h_hom (p_Z w)
    rw [hh_pZ]
    have hm_eq : m.hom.comp p_Z = ψ := by
      apply MvPolynomial.ringHom_ext
      · intro a_z
        change m.hom (p_Z (MvPolynomial.C a_z)) = ψ (MvPolynomial.C a_z)
        rw [MvPolynomial.eval₂Hom_C]
        have hfZ_eq : p_Z (MvPolynomial.C a_z) = f_Z a_z := by
          rw [hp_Z_aeval, MvPolynomial.aeval_C]
          rfl
        rw [hfZ_eq]
        exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm₁) a_z
      · intro k
        change m.hom (p_Z (MvPolynomial.X k)) = ψ (MvPolynomial.X k)
        rw [MvPolynomial.eval₂Hom_X']
        have hpval : p_Z (MvPolynomial.X k) = π_B (x_gen k) := by
          rw [hπ_B_x k, hp_Z_aeval, MvPolynomial.aeval_X]
        rw [hpval]
        exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm₂) (x_gen k)
    exact RingHom.congr_fun hm_eq w

  
  have hExtVanish : ∀ {C₁ C₂ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C₁]
      [CategoryTheory.Category.{u + 1, u + 1} C₂]
      [CategoryTheory.Abelian C₁] [CategoryTheory.Abelian C₂]
      [CategoryTheory.EnoughInjectives C₁]
      [CategoryTheory.HasExt.{u} C₁] [CategoryTheory.HasExt.{u} C₂]
      (F : CategoryTheory.Functor C₁ C₂)
      [F.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      (_hInj : ∀ I : C₁, CategoryTheory.Injective I → CategoryTheory.Injective (F.obj I))
      (A₁ : C₁) (A₂ : C₂) (ρ : A₂ ⟶ F.obj A₁)
      (_hHom0 : ∀ Y : C₁,
        Function.Surjective (fun (α : A₁ ⟶ Y) => CategoryTheory.CategoryStruct.comp ρ (F.map α)))
      (q₀ : ℕ) (Y : C₁),
      Subsingleton (CategoryTheory.Abelian.Ext.{u} A₁ Y q₀) →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} A₂ (F.obj Y) q₀) := by
    intro C₁ C₂ _ _ _ _ _ _ _ F _ _ _ hInj A₁ A₂ ρ hHom0 q₀ Y
    let Θ : ∀ (m : ℕ) (W : C₁),
        CategoryTheory.Abelian.Ext.{u} A₁ W m → CategoryTheory.Abelian.Ext.{u} A₂ (F.obj W) m :=
      fun m W e =>
        (CategoryTheory.Abelian.Ext.mk₀ ρ).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor F e) (Nat.zero_add m)
    have hΘ_surj : ∀ (m : ℕ) (W : C₁), Function.Surjective (Θ m W) := by
      intro m
      induction m with
      | zero =>
        intro W y
        obtain ⟨α, hα⟩ := hHom0 W (CategoryTheory.Abelian.Ext.homEquiv₀ y)
        dsimp only at hα
        refine ⟨CategoryTheory.Abelian.Ext.mk₀ α, ?_⟩
        dsimp [Θ]
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hα,
          CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply]
      | succ m ih =>
        intro W y
        let I : C₁ := CategoryTheory.Injective.under W
        let ι : W ⟶ I := CategoryTheory.Injective.ι W
        let Q : C₁ := CategoryTheory.Limits.cokernel ι
        let π : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι
        let S₀ : CategoryTheory.ShortComplex C₁ :=
          CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
        have hSES : S₀.ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk'
            (CategoryTheory.ShortComplex.exact_cokernel ι) inferInstance inferInstance
        have hSES_F : (S₀.map F).ShortExact := hSES.map_of_exact F
        haveI : CategoryTheory.Injective (S₀.map F).X₂ := hInj I inferInstance
        have hy_zero : y.comp (CategoryTheory.Abelian.Ext.mk₀ (S₀.map F).f) (Nat.add_zero (m + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨x₃, hx₃⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ A₂ hSES_F y hy_zero (rfl : m + 1 = m + 1)
        obtain ⟨z₃, hz₃⟩ := ih Q x₃
        refine ⟨z₃.comp hSES.extClass (rfl : m + 1 = m + 1), ?_⟩
        dsimp [Θ] at hz₃ ⊢
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
          ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add m) (rfl : m + 1 = m + 1) (Nat.zero_add (m + 1)),
          hz₃, hx₃]
    intro hSub
    refine subsingleton_of_forall_eq 0 (fun y => ?_)
    obtain ⟨e, rfl⟩ := hΘ_surj q₀ Y y
    have he : e = 0 := @Subsingleton.elim _ hSub e 0
    rw [he]
    dsimp [Θ]
    have hmk0 : CategoryTheory.Abelian.Ext.mapExactFunctor F
        (0 : CategoryTheory.Abelian.Ext.{u} A₁ A₁ 0) = 0 := by
      rw [← CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀, F.map_zero,
        CategoryTheory.Abelian.Ext.mk₀_zero]
    have h0 : CategoryTheory.Abelian.Ext.mapExactFunctor F
        (0 : CategoryTheory.Abelian.Ext.{u} A₁ Y q₀) = 0 := by
      have h1 := CategoryTheory.Abelian.Ext.mapExactFunctor_comp F
        (0 : CategoryTheory.Abelian.Ext.{u} A₁ A₁ 0)
        (0 : CategoryTheory.Abelian.Ext.{u} A₁ Y q₀) (Nat.zero_add q₀)
      rw [CategoryTheory.Abelian.Ext.zero_comp, hmk0, CategoryTheory.Abelian.Ext.zero_comp] at h1
      exact h1
    rw [h0, CategoryTheory.Abelian.Ext.comp_zero]

  
  have hCompBaseApply : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}}
      (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃) (x : ↥X₁),
      (f ≫ g).base x = g.base (f.base x) :=
    fun _ _ _ => rfl

  have hEtaleCoverIff : ∀ (X : AlgebraicGeometry.Scheme.{u}) (U : X.Etale) (R : Sieve U),
      (R ∈ X.smallEtaleTopology U →
        ∀ z : ↥U.left, ∃ (W : X.Etale) (g : W ⟶ U) (w : ↥W.left), R g ∧ g.left.base w = z) ∧
      ((∀ x : ↥U.left, ∃ (V : X.Etale) (g : V ⟶ U) (y : ↥V.left), R g ∧ g.left.base y = x) →
        R ∈ X.smallEtaleTopology U) := by
    intro X U R
    let P_et : MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    have hTopEq : X.smallGrothendieckTopology P_et = (X.smallPretopology P_et P_et).toGrothendieck :=
      @AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        P_et P_et X inferInstance inferInstance inferInstance inferInstance inferInstance (le_refl P_et)
    let U' : P_et.Over ⊤ X := U
    let R' : Sieve U' := R
    have hMemEq : (R ∈ X.smallEtaleTopology U) ↔ (R' ∈ (X.smallPretopology P_et P_et).toGrothendieck U') := by
      change (R' ∈ (X.smallGrothendieckTopology P_et) U') ↔ _
      rw [hTopEq]
    constructor
    · intro hR z
      have hR' : R' ∈ (X.smallPretopology P_et P_et).toGrothendieck U' := hMemEq.mp hR
      rw [Pretopology.mem_toGrothendieck] at hR'
      rcases hR' with ⟨R₀, hR₀_cov, hR₀_le⟩
      rcases hR₀_cov.1 z with ⟨Y_sch, g_sch, hg_map, w, hw⟩
      cases hg_map with
      | of hg_ov =>
        cases hg_ov with
        | of hg_et =>
          cases hg_et with
          | of hg_R₀ =>
            exact ⟨_, _, w, @hR₀_le _ _ hg_R₀, hw⟩
    · intro hHit
      apply hMemEq.mpr
      rw [Pretopology.mem_toGrothendieck]
      let V_fam : ↥U.left → P_et.Over ⊤ X := fun x => Classical.choose (hHit x)
      let g_fam : ∀ x : ↥U.left, V_fam x ⟶ U' := fun x => Classical.choose (Classical.choose_spec (hHit x))
      have hg_spec : ∀ x : ↥U.left, ∃ y : ↥(V_fam x).left, R (g_fam x) ∧ (g_fam x).left.base y = x :=
        fun x => Classical.choose_spec (Classical.choose_spec (hHit x))
      refine ⟨Presieve.ofArrows V_fam g_fam, ?_, ?_⟩
      · change Presieve.map (Over.forget X)
            (Presieve.map (MorphismProperty.Over.forget P_et ⊤ X)
              (Presieve.ofArrows V_fam g_fam)) ∈
          (AlgebraicGeometry.Scheme.precoverage P_et).coverings U'.left
        rw [Presieve.map_ofArrows, Presieve.map_ofArrows]
        refine (AlgebraicGeometry.Scheme.ofArrows_mem_precoverage_iff P_et).mpr ⟨fun x => ?_, fun x => ?_⟩
        · obtain ⟨y, _, hy⟩ := hg_spec x
          exact ⟨x, y, hy⟩
        · change P_et (g_fam x).left
          have hw : (g_fam x).left ≫ U'.hom = (V_fam x).hom := MorphismProperty.Over.w (g_fam x)
          have hU_et : P_et U'.hom := U'.prop
          have hV_et : P_et (V_fam x).hom := (V_fam x).prop
          exact MorphismProperty.of_postcomp P_et (W' := P_et) (g_fam x).left U'.hom hU_et (hw.symm ▸ hV_et)
      · intro W g hg
        rcases hg with ⟨x⟩
        exact (hg_spec x).choose_spec.1

  have hSubsingletonOfEmpty : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (𝒢 : Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (W : X.Etale),
      IsEmpty ↥W.left → Subsingleton ↥(𝒢.obj.obj (Opposite.op W)) := by
    intro X 𝒢 W hEmp
    have hBotMem : (⊥ : Sieve W) ∈ X.smallEtaleTopology W :=
      (hEtaleCoverIff X W ⊥).2 (fun z => IsEmpty.elim hEmp z)
    refine subsingleton_of_forall_eq 0 (fun s => ?_)
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let downHom : ULift.{u} ℤ →+ ℤ :=
      { toFun := ULift.down, map_zero' := rfl, map_add' := fun _ _ => rfl }
    let e_s : Aℤ ⟶ 𝒢.obj.obj (Opposite.op W) :=
      AddCommGrpCat.ofHom ((zmultiplesHom ↥(𝒢.obj.obj (Opposite.op W)) s).comp downHom)
    have heq : e_s = 0 :=
      𝒢.property.hom_ext ⟨⊥, hBotMem⟩ e_s 0 (fun I => False.elim I.hf)
    have hval := ConcreteCategory.congr_hom heq (ULift.up (1 : ℤ))
    simpa [e_s, downHom] using hval

  have hExistsPreimageOfIsPullback : ∀ {P X Y B : AlgebraicGeometry.Scheme.{u}}
      {f₁ : P ⟶ X} {f₂ : P ⟶ Y} {g₁ : X ⟶ B} {g₂ : Y ⟶ B},
      IsPullback f₁ f₂ g₁ g₂ → ∀ (x₀ : ↥X) (y₀ : ↥Y), g₁.base x₀ = g₂.base y₀ →
      ∃ p : ↥P, f₁.base p = x₀ ∧ f₂.base p = y₀ := by
    intro P X Y B f₁ f₂ g₁ g₂ hPB x₀ y₀ hxy
    obtain ⟨q_pt, hq₁, hq₂⟩ := Scheme.Pullback.exists_preimage_pullback x₀ y₀ hxy
    refine ⟨hPB.isoPullback.inv.base q_pt, ?_, ?_⟩
    · exact (hCompBaseApply hPB.isoPullback.inv f₁ q_pt).symm.trans
        ((congrArg (fun k : _ ⟶ X => k.base q_pt) hPB.isoPullback_inv_fst).trans hq₁)
    · exact (hCompBaseApply hPB.isoPullback.inv f₂ q_pt).symm.trans
        ((congrArg (fun k : _ ⟶ Y => k.base q_pt) hPB.isoPullback_inv_snd).trans hq₂)

  have hPullbackMapSquare : ∀ {V₀ U₀ Z₀ S₀ : AlgebraicGeometry.Scheme.{u}}
      (u_hom : U₀ ⟶ S₀) (v_hom : V₀ ⟶ S₀) (i₀ : Z₀ ⟶ S₀) (g_left : V₀ ⟶ U₀)
      (bg_left : Limits.pullback v_hom i₀ ⟶ Limits.pullback u_hom i₀),
      g_left ≫ u_hom = v_hom →
      bg_left ≫ Limits.pullback.fst u_hom i₀ = Limits.pullback.fst v_hom i₀ ≫ g_left →
      bg_left ≫ Limits.pullback.snd u_hom i₀ = Limits.pullback.snd v_hom i₀ →
      IsPullback bg_left (Limits.pullback.fst v_hom i₀) (Limits.pullback.fst u_hom i₀) g_left := by
    intro V₀ U₀ Z₀ S₀ u_hom v_hom i₀ g_left bg_left hv hfst hsnd
    have hRight : IsPullback (Limits.pullback.snd u_hom i₀) (Limits.pullback.fst u_hom i₀) i₀ u_hom :=
      (IsPullback.of_hasPullback u_hom i₀).flip
    have hOuter : IsPullback (bg_left ≫ Limits.pullback.snd u_hom i₀)
        (Limits.pullback.fst v_hom i₀) i₀ (g_left ≫ u_hom) := by
      rw [hsnd, hv]
      exact (IsPullback.of_hasPullback v_hom i₀).flip
    exact IsPullback.of_right hOuter hfst hRight

  have hIsPullbackFromSpecApp : ∀ {X₁ Y₁ : AlgebraicGeometry.Scheme.{u}}
      (f : X₁ ⟶ Y₁) (U₁ : Y₁.Opens) (hU₁ : IsAffineOpen U₁)
      (hZ₁ : IsAffineOpen ((TopologicalSpace.Opens.map f.base).obj U₁)),
      IsPullback hZ₁.fromSpec (AlgebraicGeometry.Spec.map (f.app U₁)) f hU₁.fromSpec := by
    intro X₁ Y₁ f U₁ hU₁ hZ₁
    let Z₁ : X₁.Opens := (TopologicalSpace.Opens.map f.base).obj U₁
    let g_spec : AlgebraicGeometry.Spec (X₁.presheaf.obj (Opposite.op Z₁)) ⟶
        AlgebraicGeometry.Spec (Y₁.presheaf.obj (Opposite.op U₁)) :=
      AlgebraicGeometry.Spec.map (f.app U₁)
    have hg_appLE : g_spec = AlgebraicGeometry.Spec.map (f.appLE U₁ Z₁ (le_refl _)) := by
      dsimp [g_spec]
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
    have hSqIso : hZ₁.isoSpec.inv ≫ (f ∣_ U₁) = g_spec ≫ hU₁.isoSpec.inv := by
      apply (cancel_mono U₁.ι).mp
      rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, IsAffineOpen.isoSpec_inv_ι,
        Category.assoc, IsAffineOpen.isoSpec_inv_ι, hg_appLE,
        IsAffineOpen.SpecMap_appLE_fromSpec f hU₁ hZ₁ (le_refl _)]
    have hLeftPB : IsPullback hZ₁.isoSpec.inv g_spec (f ∣_ U₁) hU₁.isoSpec.inv :=
      IsPullback.of_horiz_isIso ⟨hSqIso⟩
    have hRightPB : IsPullback Z₁.ι (f ∣_ U₁) f U₁.ι :=
      (isPullback_morphismRestrict f U₁).flip
    have hPaste := hLeftPB.paste_horiz hRightPB
    rw [IsAffineOpen.isoSpec_inv_ι, IsAffineOpen.isoSpec_inv_ι] at hPaste
    exact hPaste

  have hFromSpecIsoSpecApply : ∀ {X₀ : AlgebraicGeometry.Scheme.{u}} (V : X₀.Opens)
      (hV_aff : IsAffineOpen V) (x : ↥X₀) (hxV : x ∈ V),
      hV_aff.fromSpec.base (hV_aff.isoSpec.hom.base (⟨x, hxV⟩ : ↥(V : AlgebraicGeometry.Scheme.{u}))) = x := by
    intro X₀ V hV_aff x hxV
    let p : ↥(V : AlgebraicGeometry.Scheme.{u}) := ⟨x, hxV⟩
    exact (hCompBaseApply hV_aff.isoSpec.hom hV_aff.fromSpec p).symm.trans
      (congrArg (fun k : (V : AlgebraicGeometry.Scheme.{u}) ⟶ X₀ => k.base p)
        hV_aff.isoSpec_hom_fromSpec)

  have hPullbackConeOfEqToHom : ∀ {C : Type (u + 1)} [Category.{u, u + 1} C] [Limits.HasPullbacks C]
      {a₁ a₂ a₃ b₁ b₂ b₃ : C}
      (hx₁ : a₁ = b₁) (hx₂ : a₂ = b₂) (hx₃ : a₃ = b₃)
      (f₁ : b₁ ⟶ b₃) (f₂ : b₂ ⟶ b₃),
      ∃ (pc : Limits.PullbackCone f₁ f₂),
        pc.pt = Limits.pullback (eqToHom hx₁ ≫ f₁ ≫ eqToHom hx₃.symm)
          (eqToHom hx₂ ≫ f₂ ≫ eqToHom hx₃.symm) ∧
        Nonempty (Limits.IsLimit pc) := by
    intro C _ _ a₁ a₂ a₃ b₁ b₂ b₃ hx₁ hx₂ hx₃ f₁ f₂
    subst hx₁; subst hx₂; subst hx₃
    simp only [eqToHom_refl, Category.id_comp, Category.comp_id]
    exact ⟨Limits.pullback.cone f₁ f₂, rfl, ⟨Limits.pullback.isLimit f₁ f₂⟩⟩

  
  have hPushEquiv :
      ∃ (F_push : CategoryTheory.Functor
          (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
          (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}))
        (_ : F_push.Additive)
        (_ : CategoryTheory.Limits.PreservesFiniteLimits F_push)
        (_ : CategoryTheory.Limits.PreservesFiniteColimits F_push)
        (ρ_ℤ : (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ)) ⟶
          F_push.obj ((CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ)))),
        (∀ (I : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.Injective I → CategoryTheory.Injective (F_push.obj I)) ∧
        (∀ (𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
          Function.Surjective
            (fun (α : (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
                (AddCommGrpCat.of (ULift.{u} ℤ)) ⟶ 𝒢) =>
              CategoryTheory.CategoryStruct.comp ρ_ℤ (F_push.map α))) ∧
        ∃ (𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
          ℓ • CategoryTheory.CategoryStruct.id 𝒢 = 0 ∧
          Nonempty (ℋ ≅ F_push.obj 𝒢) := by
    let P_et : MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    letI : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_i : S.Etale ⥤ Z.Etale := MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
    haveI : Limits.PreservesFiniteLimits B_i :=
      MorphismProperty.Over.instPreservesFiniteLimitsTopPullback (@AlgebraicGeometry.Etale) i
    haveI : RepresentablyFlat B_i := flat_of_preservesFiniteLimits B_i
    have hPB_Bi_map : ∀ {V U : S.Etale} (g : V ⟶ U),
        let u_hom : U.left ⟶ S := U.hom
        let v_hom : V.left ⟶ S := V.hom
        let g_left : V.left ⟶ U.left := g.left
        let bg_left : (B_i.obj V).left ⟶ (B_i.obj U).left := (B_i.map g).left
        IsPullback bg_left (Limits.pullback.fst v_hom i) (Limits.pullback.fst u_hom i) g_left := by
      intro V U g u_hom v_hom g_left bg_left
      exact hPullbackMapSquare u_hom v_hom i g_left bg_left
        (MorphismProperty.Over.w g)
        (Limits.pullback.lift_fst _ _ _)
        (Limits.pullback.lift_snd _ _ _)
    haveI hCont_Bi : B_i.IsContinuous S.smallEtaleTopology Z.smallEtaleTopology := by
      refine Functor.isContinuous_of_coverPreserving
        (compatiblePreservingOfFlat Z.smallEtaleTopology B_i) ⟨fun {U} {R} hR => ?_⟩
      apply (hEtaleCoverIff Z (B_i.obj U) _).2
      intro z
      let u_hom : U.left ⟶ S := U.hom
      let x : ↥U.left := (Limits.pullback.fst u_hom i).base z
      obtain ⟨V, g, y, hgR, hy⟩ := (hEtaleCoverIff S U R).1 hR x
      obtain ⟨w, hw_z, _⟩ := hExistsPreimageOfIsPullback (hPB_Bi_map g) z y hy.symm
      exact ⟨B_i.obj V, B_i.map g, w, ⟨V, g, 𝟙 (B_i.obj V), hgR, (Category.id_comp _).symm⟩, hw_z⟩
    let F_push := B_i.sheafPushforwardContinuous AddCommGrpCat.{u} S.smallEtaleTopology Z.smallEtaleTopology

    let T_S : S.Etale := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : AlgebraicGeometry.Etale (𝟙 S))
    have hT_S : Limits.IsTerminal T_S :=
      Limits.IsTerminal.ofUniqueHom
        (fun W =>
          let w_hom : W.left ⟶ S := W.hom
          MorphismProperty.Over.homMk w_hom (Category.comp_id w_hom) trivial)
        (fun W m =>
          let m_left : W.left ⟶ S := m.left
          MorphismProperty.Comma.Hom.ext
            ((Category.comp_id m_left).symm.trans (MorphismProperty.Over.w m))
            (Subsingleton.elim _ _))
    have hBT_S : Limits.IsTerminal (B_i.obj T_S) :=
      Limits.isLimitChangeEmptyCone Z.Etale (Limits.isLimitOfPreserves B_i hT_S)
        (Limits.asEmptyCone (B_i.obj T_S)) (Iso.refl _)

    let M_S : Type u := SmallModel.{u} S.AffineEtale
    let inclAff : S.AffineEtale ⥤ S.Etale :=
      MorphismProperty.CostructuredArrow.toOver (@AlgebraicGeometry.Etale) AlgebraicGeometry.Scheme.Spec S
    let StagePkg : ℕ → Σ (X : Type u), (X → S.Etale) :=
      Nat.rec
        ⟨ULift.{u} Unit ⊕ M_S,
          fun s => Sum.elim (fun _ => T_S)
            (fun m => inclAff.obj ((equivSmallModel.{u} S.AffineEtale).inverse.obj m)) s⟩
        (fun _ ih =>
          ⟨ih.1 ⊕ (Σ (a b c : ih.1) (f₁ : ih.2 a ⟶ ih.2 c) (f₂ : ih.2 b ⟶ ih.2 c), ULift.{u} Unit),
            fun s => Sum.elim ih.2 (fun p => Limits.pullback p.2.2.2.1 p.2.2.2.2.1) s⟩)
    let evalD : (Σ n : ℕ, (StagePkg n).1) → S.Etale := fun d => (StagePkg d.1).2 d.2
    let D_S : Type u := InducedCategory S.Etale evalD
    let G_S : D_S ⥤ S.Etale := inducedFunctor evalD

    have hLimitInDS : ∀ {J : Type} [SmallCategory J] (K : J ⥤ D_S) (d₀ : D_S)
        (c_et : Limits.Cone (K ⋙ G_S)) (hc_et : Limits.IsLimit c_et)
        (hd₀ : G_S.obj d₀ = c_et.pt),
        Limits.HasLimit K ∧ Limits.PreservesLimit K G_S := by
      intro J _ K d₀ c_et hc_et hd₀
      let c₀ : Limits.Cone K :=
        { pt := d₀
          π :=
            { app := fun j => G_S.preimage (eqToHom hd₀ ≫ c_et.π.app j)
              naturality := fun j₁ j₂ u => G_S.map_injective (by
                simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.id_comp,
                  Functor.map_comp, Functor.map_preimage, Category.assoc]
                exact congrArg (eqToHom hd₀ ≫ ·) (c_et.π.naturality u)) } }
      have hc₀_G : Limits.IsLimit (G_S.mapCone c₀) :=
        Limits.IsLimit.ofIsoLimit hc_et
          (Limits.Cones.ext (eqToIso hd₀.symm) (fun j => by
            change c_et.π.app j = eqToHom hd₀.symm ≫ G_S.map (G_S.preimage (eqToHom hd₀ ≫ c_et.π.app j))
            rw [G_S.map_preimage, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]))
      have hc₀ : Limits.IsLimit c₀ := Limits.isLimitOfReflects G_S hc₀_G
      exact ⟨⟨⟨⟨c₀, hc₀⟩⟩⟩, Limits.preservesLimit_of_preserves_limit_cone hc₀ hc₀_G⟩

    have hTermBoth : Limits.HasLimitsOfShape (Discrete PEmpty.{1}) D_S ∧
        Limits.PreservesLimitsOfShape (Discrete PEmpty.{1}) G_S := by
      refine ⟨⟨fun K => ?_⟩, ⟨fun {K} => ?_⟩⟩
      · let c_et : Limits.Cone (K ⋙ G_S) :=
          { pt := T_S, π := { app := fun ⟨e⟩ => e.elim, naturality := fun ⟨e⟩ => e.elim } }
        have hc_et : Limits.IsLimit c_et :=
          { lift := fun s => hT_S.from s.pt
            fac := fun _ ⟨e⟩ => e.elim
            uniq := fun s _ _ => hT_S.hom_ext _ _ }
        exact (hLimitInDS K ⟨0, Sum.inl ⟨()⟩⟩ c_et hc_et rfl).1
      · let c_et : Limits.Cone (K ⋙ G_S) :=
          { pt := T_S, π := { app := fun ⟨e⟩ => e.elim, naturality := fun ⟨e⟩ => e.elim } }
        have hc_et : Limits.IsLimit c_et :=
          { lift := fun s => hT_S.from s.pt
            fac := fun _ ⟨e⟩ => e.elim
            uniq := fun s _ _ => hT_S.hom_ext _ _ }
        exact (hLimitInDS K ⟨0, Sum.inl ⟨()⟩⟩ c_et hc_et rfl).2

    have hLiftStage : ∀ (d : D_S) (N : ℕ), d.1 ≤ N →
        ∃ y : (StagePkg N).1, (StagePkg N).2 y = G_S.obj d := by
      intro d N hle
      induction N with
      | zero =>
        have hd0 : d.1 = 0 := Nat.eq_zero_of_le_zero hle
        rcases d with ⟨n, x⟩
        subst hd0
        exact ⟨x, rfl⟩
      | succ N ih =>
        rcases Nat.of_le_succ hle with hleN | heq
        · obtain ⟨y, hy⟩ := ih hleN
          exact ⟨Sum.inl y, hy⟩
        · rcases d with ⟨n, x⟩
          subst heq
          exact ⟨x, rfl⟩

    have hPullBoth : ∀ (K : Limits.WalkingCospan ⥤ D_S),
        Limits.HasLimit K ∧ Limits.PreservesLimit K G_S := by
      intro K
      let d₁ := K.obj Limits.WalkingCospan.left
      let d₂ := K.obj Limits.WalkingCospan.right
      let d₃ := K.obj Limits.WalkingCospan.one
      let N := max d₁.1 (max d₂.1 d₃.1)
      obtain ⟨x₁, hx₁⟩ := hLiftStage d₁ N (le_max_left _ _)
      obtain ⟨x₂, hx₂⟩ := hLiftStage d₂ N ((le_max_left _ _).trans (le_max_right _ _))
      obtain ⟨x₃, hx₃⟩ := hLiftStage d₃ N ((le_max_right _ _).trans (le_max_right _ _))
      let f₁ : G_S.obj d₁ ⟶ G_S.obj d₃ := G_S.map (K.map Limits.WalkingCospan.Hom.inl)
      let f₂ : G_S.obj d₂ ⟶ G_S.obj d₃ := G_S.map (K.map Limits.WalkingCospan.Hom.inr)
      obtain ⟨pc, hpc_pt, ⟨hpc⟩⟩ := hPullbackConeOfEqToHom hx₁ hx₂ hx₃ f₁ f₂
      let f₁' : (StagePkg N).2 x₁ ⟶ (StagePkg N).2 x₃ :=
        eqToHom hx₁ ≫ f₁ ≫ eqToHom hx₃.symm
      let f₂' : (StagePkg N).2 x₂ ⟶ (StagePkg N).2 x₃ :=
        eqToHom hx₂ ≫ f₂ ≫ eqToHom hx₃.symm
      let d₀ : D_S := ⟨N + 1, Sum.inr ⟨x₁, x₂, x₃, f₁', f₂', ⟨()⟩⟩⟩
      let c_et : Limits.Cone (K ⋙ G_S) :=
        (Limits.Cones.postcompose (Limits.diagramIsoCospan (K ⋙ G_S)).inv).obj pc
      have hc_et : Limits.IsLimit c_et :=
        (Limits.IsLimit.postcomposeInvEquiv (Limits.diagramIsoCospan (K ⋙ G_S)) pc).symm hpc
      exact hLimitInDS K d₀ c_et hc_et hpc_pt.symm

    haveI : Limits.HasTerminal D_S := hTermBoth.1
    haveI : Limits.PreservesLimitsOfShape (Discrete PEmpty.{1}) G_S := hTermBoth.2
    haveI : Limits.HasPullbacks D_S := ⟨fun K => (hPullBoth K).1⟩
    haveI : Limits.PreservesLimitsOfShape Limits.WalkingCospan G_S := ⟨fun {K} => (hPullBoth K).2⟩
    haveI : Limits.HasFiniteLimits D_S := Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    haveI : Limits.PreservesFiniteLimits G_S :=
      Limits.preservesFiniteLimits_of_preservesTerminal_and_pullbacks G_S

    have hStage0OfSpec : ∀ (R_c : CommRingCat.{u}) (f_spec : AlgebraicGeometry.Spec R_c ⟶ S),
        AlgebraicGeometry.Etale f_spec →
        ∃ (d₀ : D_S) (e_sch : (G_S.obj d₀).left ≅ AlgebraicGeometry.Spec R_c),
          e_sch.hom ≫ f_spec = (G_S.obj d₀).hom := by
      intro R_c f_spec hf_et
      let A_obj : S.AffineEtale :=
        MorphismProperty.CostructuredArrow.mk ⊤ (A := Opposite.op R_c) f_spec hf_et
      let m : M_S := (equivSmallModel.{u} S.AffineEtale).functor.obj A_obj
      let d₀ : D_S := ⟨0, Sum.inr m⟩
      let iso_aff : (equivSmallModel.{u} S.AffineEtale).inverse.obj m ≅ A_obj :=
        (equivSmallModel.{u} S.AffineEtale).unitIso.symm.app A_obj
      let iso_et : G_S.obj d₀ ≅ inclAff.obj A_obj := inclAff.mapIso iso_aff
      let F_sch : S.Etale ⥤ AlgebraicGeometry.Scheme.{u} :=
        AlgebraicGeometry.Scheme.Etale.forget S ⋙ Over.forget S
      let e_sch : (G_S.obj d₀).left ≅ AlgebraicGeometry.Spec R_c := F_sch.mapIso iso_et
      exact ⟨d₀, e_sch, MorphismProperty.Over.w iso_et.hom⟩

    haveI : G_S.IsCoverDense S.smallEtaleTopology := by
      refine ⟨fun U => ?_⟩
      apply (hEtaleCoverIff S U _).2
      intro x
      obtain ⟨V, hV_aff, hxV, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := U.left) (U := ⊤) (by trivial : x ∈ (⊤ : U.left.Opens))
      let u_hom : U.left ⟶ S := U.hom
      let f_spec : AlgebraicGeometry.Spec ↑Γ(U.left, V) ⟶ S := hV_aff.fromSpec ≫ u_hom
      have hf_et : AlgebraicGeometry.Etale f_spec := by
        haveI : AlgebraicGeometry.Etale u_hom := U.prop
        exact inferInstance
      obtain ⟨d₀, e_sch, he_hom⟩ := hStage0OfSpec (U.left.presheaf.obj (Opposite.op V)) f_spec hf_et
      let v_hom : (G_S.obj d₀).left ⟶ U.left := e_sch.hom ≫ hV_aff.fromSpec
      have hv_w : v_hom ≫ u_hom = (G_S.obj d₀).hom :=
        (Category.assoc e_sch.hom hV_aff.fromSpec u_hom).trans he_hom
      let v_et : G_S.obj d₀ ⟶ U := MorphismProperty.Over.homMk v_hom hv_w trivial
      let y_spec : ↥(AlgebraicGeometry.Spec (U.left.presheaf.obj (Opposite.op V))) :=
        hV_aff.isoSpec.hom.base (⟨x, hxV⟩ : ↥(V : AlgebraicGeometry.Scheme.{u}))
      let y₀ : ↥(G_S.obj d₀).left := e_sch.inv.base y_spec
      have hy₀ : v_et.left.base y₀ = x := by
        have h1 : (e_sch.hom ≫ hV_aff.fromSpec).base (e_sch.inv.base y_spec) =
            hV_aff.fromSpec.base y_spec := by
          rw [← hCompBaseApply e_sch.inv (e_sch.hom ≫ hV_aff.fromSpec),
            ← Category.assoc, e_sch.inv_hom_id, Category.id_comp]
        exact h1.trans (hFromSpecIsoSpecApply V hV_aff x hxV)
      exact ⟨G_S.obj d₀, v_et, y₀, ⟨d₀, 𝟙 (G_S.obj d₀), v_et, Category.id_comp _⟩, hy₀⟩

    let K_S : GrothendieckTopology D_S := G_S.inducedTopology S.smallEtaleTopology
    haveI : Functor.IsDenseSubsite K_S S.smallEtaleTopology G_S := inferInstance
    let E_S := G_S.sheafPushforwardContinuous AddCommGrpCat.{u} K_S S.smallEtaleTopology
    haveI : E_S.IsEquivalence := inferInstance

    let F₀ : D_S ⥤ Z.Etale := G_S ⋙ B_i
    haveI : F₀.IsContinuous K_S Z.smallEtaleTopology :=
      Functor.isContinuous_comp G_S B_i K_S S.smallEtaleTopology Z.smallEtaleTopology
    haveI : Limits.PreservesFiniteLimits F₀ := Limits.comp_preservesFiniteLimits G_S B_i
    haveI : RepresentablyFlat F₀ := flat_of_preservesFiniteLimits F₀

    haveI : Limits.PreservesFiniteLimits (F₀.op.lan (H := AddCommGrpCat.{u})) := by
      refine ⟨fun J _ _ => ?_⟩
      apply Limits.preservesLimitsOfShape_of_evaluation
      intro W
      let K_W := CostructuredArrow.proj F₀.op W
      let G_W : (D_Sᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ AddCommGrpCat.{u} :=
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u}).obj K_W ⋙ Limits.colim
      haveI : Limits.PreservesLimitsOfShape J ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u}).obj K_W) :=
        inferInstance
      haveI : Limits.PreservesLimitsOfShape J (Limits.colim (J := CostructuredArrow F₀.op W) (C := AddCommGrpCat.{u})) :=
        Limits.filtered_colim_preservesFiniteLimits
      haveI : Limits.PreservesLimitsOfShape J G_W := Limits.comp_preservesLimitsOfShape _ _
      let e_W : G_W ≅ F₀.op.lan ⋙ (evaluation (Z.Etale)ᵒᵖ AddCommGrpCat.{u}).obj W :=
        NatIso.ofComponents
          (fun P => (F₀.op.leftKanExtensionObjIsoColimit P W).symm)
          (fun {P₁ P₂} φ => by
            dsimp only [G_W, Functor.comp_obj, Functor.whiskeringLeft_obj_obj, Limits.colim_obj]
            apply Limits.colimit.hom_ext
            intro f
            have hLHS : Limits.colimit.ι (K_W ⋙ P₁) f ≫
                (Limits.colimMap (K_W.whiskerLeft φ) ≫
                  (F₀.op.leftKanExtensionObjIsoColimit P₂ W).inv) =
                φ.app f.left ≫ (F₀.op.leftKanExtensionUnit P₂).app f.left ≫
                  (F₀.op.leftKanExtension P₂).map f.hom := by
              rw [Limits.ι_colimMap_assoc, Functor.ι_leftKanExtensionObjIsoColimit_inv]
              rfl
            let φ_W : (F₀.op.leftKanExtension P₁).obj W ⟶ (F₀.op.leftKanExtension P₂).obj W :=
              (F₀.op.lan.map φ).app W
            have hRHS : Limits.colimit.ι (K_W ⋙ P₁) f ≫
                ((F₀.op.leftKanExtensionObjIsoColimit P₁ W).inv ≫ φ_W) =
                ((F₀.op.leftKanExtensionUnit P₁).app f.left ≫
                  (F₀.op.leftKanExtension P₁).map f.hom) ≫ φ_W :=
              (Category.assoc _ _ φ_W).symm.trans
                (congrArg (· ≫ φ_W) (Functor.ι_leftKanExtensionObjIsoColimit_inv F₀.op P₁ W f))
            have hUnitNat : φ.app f.left ≫ (F₀.op.leftKanExtensionUnit P₂).app f.left =
                (F₀.op.leftKanExtensionUnit P₁).app f.left ≫
                  (F₀.op.lan.map φ).app (F₀.op.obj f.left) :=
              congrArg (fun η : P₁ ⟶ F₀.op ⋙ F₀.op.lan.obj P₂ => η.app f.left)
                (F₀.op.lanUnit.naturality φ)
            have hMapNat : (F₀.op.lan.map φ).app (F₀.op.obj f.left) ≫
                (F₀.op.leftKanExtension P₂).map f.hom =
                (F₀.op.leftKanExtension P₁).map f.hom ≫ (F₀.op.lan.map φ).app W :=
              ((F₀.op.lan.map φ).naturality f.hom).symm
            exact hLHS.trans ((Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ _) hUnitNat).trans
                ((Category.assoc _ _ _).trans
                  ((congrArg (_ ≫ ·) hMapNat).trans
                    ((Category.assoc _ _ _).symm.trans hRHS.symm))))))
      exact Limits.preservesLimitsOfShape_of_natIso e_W

    haveI : Limits.PreservesFiniteLimits (F₀.sheafPullback AddCommGrpCat.{u} K_S Z.smallEtaleTopology) :=
      Functor.sheafPullbackConstruction.preservesFiniteLimits F₀ AddCommGrpCat.{u} K_S Z.smallEtaleTopology
    let adj₀ := F₀.sheafAdjunctionContinuous AddCommGrpCat.{u} K_S Z.smallEtaleTopology
    let P_pull := E_S ⋙ F₀.sheafPullback AddCommGrpCat.{u} K_S Z.smallEtaleTopology
    haveI : Limits.PreservesFiniteLimits P_pull := Limits.comp_preservesFiniteLimits _ _
    let e_comp := Functor.sheafPushforwardContinuousComp G_S B_i AddCommGrpCat.{u}
      K_S S.smallEtaleTopology Z.smallEtaleTopology
    let iso_R : F₀.sheafPushforwardContinuous AddCommGrpCat.{u} K_S Z.smallEtaleTopology ⋙ E_S.inv ≅ F_push :=
      calc
        F₀.sheafPushforwardContinuous AddCommGrpCat.{u} K_S Z.smallEtaleTopology ⋙ E_S.inv
          ≅ (F_push ⋙ E_S) ⋙ E_S.inv := Functor.isoWhiskerRight e_comp.symm E_S.inv
        _ ≅ F_push ⋙ (E_S ⋙ E_S.inv) := Functor.associator _ _ _
        _ ≅ F_push ⋙ 𝟭 _ := Functor.isoWhiskerLeft F_push E_S.asEquivalence.unitIso.symm
        _ ≅ F_push := Functor.rightUnitor F_push
    let adj_i : P_pull ⊣ F_push :=
      (E_S.asEquivalence.toAdjunction.comp adj₀).ofNatIsoRight iso_R
    haveI : P_pull.Additive := Functor.additive_of_preserves_binary_products P_pull
    haveI : F_push.Additive := adj_i.right_adjoint_additive
    haveI : Limits.PreservesLimitsOfSize.{0, 0} F_push := adj_i.rightAdjoint_preservesLimits
    haveI : Limits.PreservesFiniteLimits F_push := inferInstance

    have hChartLift : ∀ (U : S.Etale) (W_Z : Z.Etale) (g : W_Z ⟶ B_i.obj U) (w : ↥W_Z.left),
        let u_hom : U.left ⟶ S := U.hom
        ∃ (d_x : D_S) (v_x : G_S.obj d_x ⟶ U) (w_x : B_i.obj (G_S.obj d_x) ⟶ W_Z),
          w_x ≫ g = B_i.map v_x ∧
          (Limits.pullback.fst u_hom i).base (g.left.base w) ∈ Set.range v_x.left.base := by
      intro U W_Z g w u_hom
      let U₀ : AlgebraicGeometry.Scheme.{u} := U.left
      let P_U : AlgebraicGeometry.Scheme.{u} := Limits.pullback u_hom i
      let ι'_U : P_U ⟶ U₀ := Limits.pullback.fst u_hom i
      let p_Z_U : P_U ⟶ Z := Limits.pullback.snd u_hom i
      let W₀ : AlgebraicGeometry.Scheme.{u} := W_Z.left
      let g₀ : W₀ ⟶ P_U := g.left
      haveI : AlgebraicGeometry.IsClosedImmersion ι'_U := inferInstance
      let z : ↥P_U := g₀.base w
      let x : ↥U₀ := ι'_U.base z
      obtain ⟨U_aff, hU_aff, hxU, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := U₀) (U := ⊤) (by trivial : x ∈ (⊤ : U₀.Opens))
      let Z_aff : P_U.Opens := (TopologicalSpace.Opens.map ι'_U.base).obj U_aff
      have hzZ : z ∈ Z_aff := hxU
      have hZ_aff : IsAffineOpen Z_aff := AlgebraicGeometry.IsAffineHom.isAffine_preimage U_aff hU_aff
      let A_c : CommRingCat.{u} := U₀.presheaf.obj (Opposite.op U_aff)
      let A_Zc : CommRingCat.{u} := P_U.presheaf.obj (Opposite.op Z_aff)
      let π_c : A_c ⟶ A_Zc := ι'_U.app U_aff
      have hπ_surj : Function.Surjective π_c.hom :=
        AlgebraicGeometry.Scheme.Hom.app_surjective ι'_U U_aff hU_aff
      obtain ⟨W_aff, hW_aff, hwW, hW_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := W₀)
          (U := (TopologicalSpace.Opens.map g₀.base).obj Z_aff) hzZ
      have hW_le : W_aff ≤ (TopologicalSpace.Opens.map g₀.base).obj Z_aff := hW_sub
      let B_Zc : CommRingCat.{u} := W₀.presheaf.obj (Opposite.op W_aff)
      let f_Zc : A_Zc ⟶ B_Zc := g₀.appLE Z_aff W_aff hW_le
      have hg₀_et : AlgebraicGeometry.Etale g₀ := by
        have hw_g : g₀ ≫ p_Z_U = W_Z.hom := MorphismProperty.Over.w g
        have hp_et : P_et p_Z_U := (B_i.obj U).prop
        have hWZ_et : P_et W_Z.hom := W_Z.prop
        exact MorphismProperty.of_postcomp P_et (W' := P_et) g₀ p_Z_U hp_et (hw_g.symm ▸ hWZ_et)
      have hf_Z_et : f_Zc.hom.Etale :=
        AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale) g₀ hg₀_et
          ⟨Z_aff, hZ_aff⟩ ⟨W_aff, hW_aff⟩ hW_le
      obtain ⟨B_A, instCommBA, f_A, π_B, hf_A_et, hPush⟩ :=
        hAffLift A_c A_Zc B_Zc π_c.hom f_Zc.hom hπ_surj hf_Z_et
      letI : CommRing B_A := instCommBA
      have hPush' : CategoryTheory.IsPushout π_c (CommRingCat.ofHom f_A) f_Zc (CommRingCat.ofHom π_B) := by
        simpa [CommRingCat.ofHom_hom] using hPush
      have hSpecPB : IsPullback (AlgebraicGeometry.Spec.map f_Zc)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B))
          (AlgebraicGeometry.Spec.map π_c)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_A)) :=
        AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush'
      have hChartPB := hIsPullbackFromSpecApp ι'_U U_aff hU_aff hZ_aff
      let u_A : AlgebraicGeometry.Spec (CommRingCat.of B_A) ⟶ U₀ :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_A) ≫ hU_aff.fromSpec
      have hPaste1 : IsPullback (AlgebraicGeometry.Spec.map f_Zc ≫ hZ_aff.fromSpec)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B)) ι'_U u_A :=
        hSpecPB.paste_horiz hChartPB
      haveI : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_A)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf_A_et
      haveI : AlgebraicGeometry.Etale u_hom := U.prop
      have hf_BA_et : AlgebraicGeometry.Etale (u_A ≫ u_hom) := inferInstance
      obtain ⟨d_x, e_dx, he_dx_hom⟩ := hStage0OfSpec (CommRingCat.of B_A) (u_A ≫ u_hom) hf_BA_et
      let d_x_left : AlgebraicGeometry.Scheme.{u} := (G_S.obj d_x).left
      let v_x_left : d_x_left ⟶ U₀ := e_dx.hom ≫ u_A
      have hv_x_w : v_x_left ≫ u_hom = (G_S.obj d_x).hom :=
        (Category.assoc e_dx.hom u_A u_hom).trans he_dx_hom
      let v_x : G_S.obj d_x ⟶ U := MorphismProperty.Over.homMk v_x_left hv_x_w trivial
      have hBotPB : IsPullback u_A e_dx.inv (𝟙 U₀) v_x_left :=
        IsPullback.of_vert_isIso ⟨by
          change u_A ≫ 𝟙 U₀ = e_dx.inv ≫ (e_dx.hom ≫ u_A)
          rw [Category.comp_id, ← Category.assoc, e_dx.inv_hom_id, Category.id_comp]⟩
      have hPB_BZ : IsPullback (AlgebraicGeometry.Spec.map f_Zc ≫ hZ_aff.fromSpec)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B) ≫ e_dx.inv) ι'_U v_x_left := by
        have hp := hPaste1.paste_vert hBotPB
        rwa [Category.comp_id] at hp
      have hPB_vx : IsPullback ((B_i.map v_x).left)
          (Limits.pullback.fst (G_S.obj d_x).hom i) ι'_U v_x_left :=
        hPB_Bi_map v_x
      let iso_BZ : (B_i.obj (G_S.obj d_x)).left ≅ AlgebraicGeometry.Spec B_Zc :=
        IsPullback.isoIsPullback _ _ hPB_vx hPB_BZ
      have hiso_top : iso_BZ.hom ≫ (AlgebraicGeometry.Spec.map f_Zc ≫ hZ_aff.fromSpec) = (B_i.map v_x).left :=
        IsPullback.isoIsPullback_hom_fst _ _ hPB_vx hPB_BZ
      have hfZ_fromSpec : AlgebraicGeometry.Spec.map f_Zc ≫ hZ_aff.fromSpec = hW_aff.fromSpec ≫ g₀ :=
        IsAffineOpen.SpecMap_appLE_fromSpec g₀ hZ_aff hW_aff hW_le
      let P_dx : AlgebraicGeometry.Scheme.{u} := (B_i.obj (G_S.obj d_x)).left
      let w_x_left : P_dx ⟶ W₀ := iso_BZ.hom ≫ hW_aff.fromSpec
      have hwx_g₀ : w_x_left ≫ g₀ = (B_i.map v_x).left := by
        change (iso_BZ.hom ≫ hW_aff.fromSpec) ≫ g₀ = (B_i.map v_x).left
        rw [Category.assoc, ← hfZ_fromSpec]
        exact hiso_top
      have hwx_w : w_x_left ≫ W_Z.hom = (B_i.obj (G_S.obj d_x)).hom := by
        have hw_g : g₀ ≫ p_Z_U = W_Z.hom := MorphismProperty.Over.w g
        have hbv_w : (B_i.map v_x).left ≫ p_Z_U = (B_i.obj (G_S.obj d_x)).hom :=
          MorphismProperty.Over.w (B_i.map v_x)
        calc
          w_x_left ≫ W_Z.hom = w_x_left ≫ (g₀ ≫ p_Z_U) := congrArg (w_x_left ≫ ·) hw_g.symm
          _ = (w_x_left ≫ g₀) ≫ p_Z_U := (Category.assoc _ _ _).symm
          _ = (B_i.map v_x).left ≫ p_Z_U := congrArg (· ≫ p_Z_U) hwx_g₀
          _ = (B_i.obj (G_S.obj d_x)).hom := hbv_w
      let w_x : B_i.obj (G_S.obj d_x) ⟶ W_Z := MorphismProperty.Over.homMk w_x_left hwx_w trivial
      have hwx_eq : w_x ≫ g = B_i.map v_x :=
        MorphismProperty.Comma.Hom.ext hwx_g₀ (Subsingleton.elim _ _)
      let w_spec : ↥(AlgebraicGeometry.Spec B_Zc) :=
        hW_aff.isoSpec.hom.base (⟨w, hwW⟩ : ↥(W_aff : AlgebraicGeometry.Scheme.{u}))
      let q₀ : ↥P_dx := iso_BZ.inv.base w_spec
      let d_hom : d_x_left ⟶ S := (G_S.obj d_x).hom
      let p₀ : ↥d_x_left := (Limits.pullback.fst d_hom i).base q₀
      have hp₀_hit : v_x_left.base p₀ = x := by
        have h1 : (Limits.pullback.fst d_hom i ≫ v_x_left) = (w_x_left ≫ g₀) ≫ ι'_U := by
          rw [hwx_g₀]
          exact (Limits.pullback.lift_fst _ _ _).symm
        have h2 : v_x_left.base p₀ = ι'_U.base (g₀.base (w_x_left.base q₀)) :=
          (hCompBaseApply (Limits.pullback.fst d_hom i) v_x_left q₀).symm.trans
            ((congrArg (fun k : P_dx ⟶ U₀ => k.base q₀) h1).trans
              ((hCompBaseApply (w_x_left ≫ g₀) ι'_U q₀).trans
                (congrArg ι'_U.base (hCompBaseApply w_x_left g₀ q₀))))
        have h3 : w_x_left.base q₀ = w := by
          have hc : (iso_BZ.inv ≫ w_x_left) = hW_aff.fromSpec := by
            dsimp [w_x_left]
            rw [← Category.assoc, iso_BZ.inv_hom_id, Category.id_comp]
          have hc' : w_x_left.base q₀ = hW_aff.fromSpec.base w_spec :=
            (hCompBaseApply iso_BZ.inv w_x_left w_spec).symm.trans
              (congrArg (fun k : AlgebraicGeometry.Spec B_Zc ⟶ W₀ => k.base w_spec) hc)
          exact hc'.trans (hFromSpecIsoSpecApply W_aff hW_aff w hwW)
        exact h2.trans (congrArg (fun t => ι'_U.base (g₀.base t)) h3)
      exact ⟨d_x, v_x, w_x, hwx_eq, ⟨p₀, hp₀_hit⟩⟩

    have hPresEpi : ∀ {𝒢₁ 𝒢₂ : Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
        (φ : 𝒢₁ ⟶ 𝒢₂) [Epi φ], Epi (F_push.map φ) := by
      intro 𝒢₁ 𝒢₂ φ _
      haveI : Sheaf.IsLocallySurjective φ :=
        (Sheaf.isLocallySurjective_iff_epi' (φ := φ)).mpr inferInstance
      haveI hLocSurj : Sheaf.IsLocallySurjective (F_push.map φ) := by
        refine ⟨fun {U} t => ?_⟩
        apply (hEtaleCoverIff S U _).2
        intro x
        let U₀ : AlgebraicGeometry.Scheme.{u} := U.left
        let u_hom : U₀ ⟶ S := U.hom
        let ι'_U : Limits.pullback u_hom i ⟶ U₀ := Limits.pullback.fst u_hom i
        haveI : AlgebraicGeometry.IsClosedImmersion ι'_U := inferInstance
        by_cases hx_in : x ∈ Set.range ι'_U.base
        · rcases hx_in with ⟨z, hz⟩
          have hImgZ : Presheaf.imageSieve φ.hom t ∈ Z.smallEtaleTopology (B_i.obj U) :=
            Presheaf.imageSieve_mem Z.smallEtaleTopology φ.hom t
          obtain ⟨W_Z, g, w, ⟨s_w, hs_w⟩, hw_z⟩ := (hEtaleCoverIff Z (B_i.obj U) _).1 hImgZ z
          obtain ⟨d_x, v_x, w_x, hwx_eq, ⟨p₀, hp₀⟩⟩ := hChartLift U W_Z g w
          have hp₀' : v_x.left.base p₀ = x :=
            hp₀.trans ((congrArg ι'_U.base hw_z).trans hz)
          refine ⟨G_S.obj d_x, v_x, p₀, ⟨𝒢₁.obj.map w_x.op s_w, ?_⟩, hp₀'⟩
          change φ.hom.app (Opposite.op (B_i.obj (G_S.obj d_x))) (𝒢₁.obj.map w_x.op s_w) =
            𝒢₂.obj.map (B_i.map v_x).op t
          have hnat := ConcreteCategory.congr_hom (φ.hom.naturality w_x.op) s_w
          change φ.hom.app (Opposite.op (B_i.obj (G_S.obj d_x))) (𝒢₁.obj.map w_x.op s_w) =
            𝒢₂.obj.map w_x.op (φ.hom.app (Opposite.op W_Z) s_w) at hnat
          rw [hnat, hs_w]
          have hcomp_t : 𝒢₂.obj.map w_x.op (𝒢₂.obj.map g.op t) = 𝒢₂.obj.map (g.op ≫ w_x.op) t := by
            rw [𝒢₂.obj.map_comp]
            rfl
          rw [hcomp_t, ← op_comp, hwx_eq]
        · let O₀ : U₀.Opens :=
            ⟨(Set.range ι'_U.base)ᶜ, (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ι'_U).isClosed_range.isOpen_compl⟩
          haveI : AlgebraicGeometry.Etale u_hom := U.prop
          let V₀ : S.Etale := MorphismProperty.Over.mk ⊤ (O₀.ι ≫ u_hom) inferInstance
          let j₀ : V₀ ⟶ U := MorphismProperty.Over.homMk O₀.ι rfl trivial
          have hEmpV₀ : IsEmpty ↥(B_i.obj V₀).left := by
            refine ⟨fun q_pt => ?_⟩
            let bj₀_left : Limits.pullback (O₀.ι ≫ u_hom) i ⟶ Limits.pullback u_hom i := (B_i.map j₀).left
            let q_U : ↥(Limits.pullback u_hom i) := bj₀_left.base q_pt
            have hq_eq : ι'_U.base q_U = O₀.ι.base ((Limits.pullback.fst (O₀.ι ≫ u_hom) i).base q_pt) :=
              (hCompBaseApply bj₀_left ι'_U q_pt).symm.trans
                ((congrArg (fun k : Limits.pullback (O₀.ι ≫ u_hom) i ⟶ U₀ => k.base q_pt)
                  (Limits.pullback.lift_fst _ _ _)).trans
                  (hCompBaseApply (Limits.pullback.fst (O₀.ι ≫ u_hom) i) O₀.ι q_pt))
            have hmemO₀ : ι'_U.base q_U ∈ (Set.range ι'_U.base)ᶜ := by
              rw [hq_eq]
              exact ((Limits.pullback.fst (O₀.ι ≫ u_hom) i).base q_pt).2
            exact hmemO₀ ⟨q_U, rfl⟩
          have hSubV₀ : Subsingleton ↥(𝒢₂.obj.obj (Opposite.op (B_i.obj V₀))) :=
            hSubsingletonOfEmpty Z 𝒢₂ (B_i.obj V₀) hEmpV₀
          refine ⟨V₀, j₀, ⟨x, hx_in⟩, ⟨0, @Subsingleton.elim _ hSubV₀ _ _⟩, rfl⟩
      exact Sheaf.epi_of_isLocallySurjective (F_push.map φ)

    haveI : Limits.PreservesFiniteColimits F_push := by
      rw [Functor.preservesFiniteColimits_iff_forall_exact_map_and_epi]
      intro S₀ hS₀
      haveI : Epi S₀.g := hS₀.epi_g
      refine ⟨?_, hPresEpi S₀.g⟩
      exact ShortComplex.exact_of_f_is_kernel (S₀.map F_push)
        (Limits.IsLimit.ofIsoLimit
          (Limits.isLimitForkMapOfIsLimit F_push _ hS₀.fIsKernel)
          (Limits.Fork.ext (Iso.refl _) (Category.id_comp _)))

    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let C_S := constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    let C_Z := constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}
    let adj_CS := constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S
    let adj_CZ := constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hBT_S
    let u_Z : Aℤ ⟶ ((sheafSections S.smallEtaleTopology AddCommGrpCat.{u}).obj (Opposite.op T_S)).obj
        (F_push.obj (C_Z.obj Aℤ)) :=
      adj_CZ.unit.app Aℤ
    let ρ_ℤ : C_S.obj Aℤ ⟶ F_push.obj (C_Z.obj Aℤ) :=
      (adj_CS.homEquiv Aℤ (F_push.obj (C_Z.obj Aℤ))).symm u_Z
    have hHom0 : ∀ (𝒢 : Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
        Function.Surjective (fun (α : C_Z.obj Aℤ ⟶ 𝒢) => ρ_ℤ ≫ F_push.map α) := by
      intro 𝒢 β
      let g_sec : Aℤ ⟶ ((sheafSections Z.smallEtaleTopology AddCommGrpCat.{u}).obj (Opposite.op (B_i.obj T_S))).obj 𝒢 :=
        adj_CS.homEquiv Aℤ (F_push.obj 𝒢) β
      let α : C_Z.obj Aℤ ⟶ 𝒢 := (adj_CZ.homEquiv Aℤ 𝒢).symm g_sec
      refine ⟨α, (adj_CS.homEquiv Aℤ (F_push.obj 𝒢)).injective ?_⟩
      have h1 := Adjunction.homEquiv_naturality_right adj_CS ρ_ℤ (F_push.map α)
      have h2 : (adj_CS.homEquiv Aℤ (F_push.obj (C_Z.obj Aℤ))) ρ_ℤ = u_Z :=
        (adj_CS.homEquiv Aℤ (F_push.obj (C_Z.obj Aℤ))).apply_symm_apply u_Z
      have h3 : u_Z ≫ ((sheafSections S.smallEtaleTopology AddCommGrpCat.{u}).obj (Opposite.op T_S)).map
          (F_push.map α) = (adj_CZ.homEquiv Aℤ 𝒢) α :=
        Adjunction.homEquiv_unit adj_CZ Aℤ 𝒢 α |>.symm
      have h4 : (adj_CZ.homEquiv Aℤ 𝒢) α = g_sec :=
        (adj_CZ.homEquiv Aℤ 𝒢).apply_symm_apply g_sec
      exact h1.trans ((congrArg (· ≫ _) h2).trans (h3.trans h4))

    refine ⟨F_push, inferInstance, inferInstance, inferInstance, ρ_ℤ,
      fun I hI => @Adjunction.map_injective _ _ _ _ P_pull F_push adj_i _ I hI,
      hHom0, ?_⟩
    let P_ℋ : D_Sᵒᵖ ⥤ AddCommGrpCat.{u} := (E_S.obj ℋ).obj
    let L_ℋ : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := F₀.op.lan.obj P_ℋ
    let Shf_Z := presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}
    let 𝒢 : Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} := Shf_Z.obj L_ℋ
    let E_pre : Sheaf S.smallEtaleTopology AddCommGrpCat.{u} ⥤ (D_Sᵒᵖ ⥤ AddCommGrpCat.{u}) :=
      E_S ⋙ sheafToPresheaf K_S AddCommGrpCat.{u}
    haveI : Limits.PreservesFiniteLimits (sheafToPresheaf K_S AddCommGrpCat.{u}) := inferInstance
    haveI : Limits.PreservesFiniteLimits E_pre := Limits.comp_preservesFiniteLimits _ _
    haveI : E_pre.Additive := Functor.additive_of_preserves_binary_products _
    haveI : (F₀.op.lan (H := AddCommGrpCat.{u})).Additive :=
      Functor.additive_of_preserves_binary_products _
    haveI : Shf_Z.Additive := Functor.additive_of_preserves_binary_products _
    have hℓ_PH : ℓ • 𝟙 P_ℋ = 0 := by
      change ℓ • 𝟙 (E_pre.obj ℋ) = 0
      rw [← E_pre.map_id, ← Functor.map_nsmul, hℓ_ℋ, Functor.map_zero]
    have hℓ_LH : ℓ • 𝟙 L_ℋ = 0 := by
      change ℓ • 𝟙 ((F₀.op.lan (H := AddCommGrpCat.{u})).obj P_ℋ) = 0
      rw [← (F₀.op.lan (H := AddCommGrpCat.{u})).map_id, ← Functor.map_nsmul, hℓ_PH, Functor.map_zero]
    have hℓ_G : ℓ • 𝟙 𝒢 = 0 := by
      change ℓ • 𝟙 (Shf_Z.obj L_ℋ) = 0
      rw [← Shf_Z.map_id, ← Functor.map_nsmul, hℓ_LH, Functor.map_zero]

    let u_pre : P_ℋ ⟶ F₀.op ⋙ 𝒢.obj :=
      F₀.op.leftKanExtensionUnit P_ℋ ≫ Functor.whiskerLeft F₀.op (toSheafify Z.smallEtaleTopology L_ℋ)
    let u_raw : E_S.obj ℋ ⟶ E_S.obj (F_push.obj 𝒢) := ObjectProperty.homMk u_pre

    have hMemKS : ∀ (d_U : D_S) (R : Sieve d_U),
        (∀ x : ↥(G_S.obj d_U).left, ∃ (d' : D_S) (p : d' ⟶ d_U) (y : ↥(G_S.obj d').left),
          R p ∧ (G_S.map p).left.base y = x) →
        R ∈ K_S d_U := by
      intro d_U R hHit
      apply (Functor.IsDenseSubsite.functorPushforward_mem_iff (J := K_S) (K := S.smallEtaleTopology) (G := G_S)).mp
      apply (hEtaleCoverIff S (G_S.obj d_U) _).2
      intro x
      obtain ⟨d', p, y, hpR, hy⟩ := hHit x
      exact ⟨G_S.obj d', G_S.map p, y, ⟨d', p, 𝟙 (G_S.obj d'), hpR, (Category.id_comp _).symm⟩, hy⟩

    have hOutNbhd : ∀ (d_U : D_S) (x : ↥(G_S.obj d_U).left),
        (G_S.obj d_U).hom.base x ∉ Set.range i.base →
        ∃ (d_x : D_S) (p_x : d_x ⟶ d_U) (y₀ : ↥(G_S.obj d_x).left),
          (G_S.map p_x).left.base y₀ = x ∧
          Subsingleton ↥(P_ℋ.obj (Opposite.op d_x)) ∧
          Subsingleton ↥(𝒢.obj.obj (Opposite.op (F₀.obj d_x))) := by
      intro d_U x hx_out
      let U₀ : AlgebraicGeometry.Scheme.{u} := (G_S.obj d_U).left
      let u_hom : U₀ ⟶ S := (G_S.obj d_U).hom
      let O_out : U₀.Opens :=
        ⟨u_hom.base ⁻¹' (Set.range i.base)ᶜ,
          u_hom.base.hom.continuous.isOpen_preimage _
            (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding i).isClosed_range.isOpen_compl⟩
      obtain ⟨V_aff, hV_aff, hxV, hV_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := U₀) (U := O_out) hx_out
      haveI : AlgebraicGeometry.Etale u_hom := (G_S.obj d_U).prop
      obtain ⟨d_x, e_dx, he_dx_hom⟩ :=
        hStage0OfSpec (U₀.presheaf.obj (Opposite.op V_aff)) (hV_aff.fromSpec ≫ u_hom) inferInstance
      let d_x_left : AlgebraicGeometry.Scheme.{u} := (G_S.obj d_x).left
      let v_hom : d_x_left ⟶ U₀ := e_dx.hom ≫ hV_aff.fromSpec
      have hv_w : v_hom ≫ u_hom = (G_S.obj d_x).hom :=
        (Category.assoc e_dx.hom hV_aff.fromSpec u_hom).trans he_dx_hom
      let v_et : G_S.obj d_x ⟶ G_S.obj d_U := MorphismProperty.Over.homMk v_hom hv_w trivial
      let p_x : d_x ⟶ d_U := G_S.preimage v_et
      have hp_x_map : G_S.map p_x = v_et := G_S.map_preimage v_et
      let y_spec : ↥(AlgebraicGeometry.Spec (U₀.presheaf.obj (Opposite.op V_aff))) :=
        hV_aff.isoSpec.hom.base (⟨x, hxV⟩ : ↥(V_aff : AlgebraicGeometry.Scheme.{u}))
      let y₀ : ↥d_x_left := e_dx.inv.base y_spec
      have hy₀ : (G_S.map p_x).left.base y₀ = x := by
        have hmap_left : (G_S.map p_x).left = v_hom := congrArg (fun m => m.left) hp_x_map
        have h1 : v_hom.base y₀ = hV_aff.fromSpec.base y_spec := by
          have hc : e_dx.inv ≫ v_hom = hV_aff.fromSpec := by
            dsimp [v_hom]
            rw [← Category.assoc, e_dx.inv_hom_id, Category.id_comp]
          exact (hCompBaseApply e_dx.inv v_hom y_spec).symm.trans
            (congrArg (fun k : _ ⟶ U₀ => k.base y_spec) hc)
        exact (congrArg (fun k : d_x_left ⟶ U₀ => k.base y₀) hmap_left).trans
          (h1.trans (hFromSpecIsoSpecApply V_aff hV_aff x hxV))
      let d_hom : d_x_left ⟶ S := (G_S.obj d_x).hom
      have hRangeOut : Set.range d_hom.base ⊆ (Set.range i.base)ᶜ := by
        rintro _ ⟨y, rfl⟩
        have hy_eq : d_hom.base y = u_hom.base (hV_aff.fromSpec.base (e_dx.hom.base y)) :=
          (congrArg (fun k : d_x_left ⟶ S => k.base y) hv_w.symm).trans
            ((hCompBaseApply v_hom u_hom y).trans
              (congrArg u_hom.base (hCompBaseApply e_dx.hom hV_aff.fromSpec y)))
        rw [hy_eq]
        have hmemV : hV_aff.fromSpec.base (e_dx.hom.base y) ∈ V_aff.carrier := by
          have hr : Set.range hV_aff.fromSpec.base = (V_aff : Set ↥U₀) := IsAffineOpen.range_fromSpec hV_aff
          change hV_aff.fromSpec.base (e_dx.hom.base y) ∈ (V_aff : Set ↥U₀)
          rw [← hr]
          exact ⟨e_dx.hom.base y, rfl⟩
        exact hV_sub hmemV
      have hSubP : Subsingleton ↥(P_ℋ.obj (Opposite.op d_x)) := hZeroOut (G_S.obj d_x) hRangeOut
      have hEmpZ : IsEmpty ↥(F₀.obj d_x).left := by
        refine ⟨fun q_pt => ?_⟩
        have hq_eq : d_hom.base ((Limits.pullback.fst d_hom i).base q_pt) =
            i.base ((Limits.pullback.snd d_hom i).base q_pt) :=
          (hCompBaseApply (Limits.pullback.fst d_hom i) d_hom q_pt).symm.trans
            ((congrArg (fun k : Limits.pullback d_hom i ⟶ S => k.base q_pt)
              (Limits.pullback.condition (f := d_hom) (g := i))).trans
              (hCompBaseApply (Limits.pullback.snd d_hom i) i q_pt))
        exact hRangeOut ⟨(Limits.pullback.fst d_hom i).base q_pt, rfl⟩
          ⟨(Limits.pullback.snd d_hom i).base q_pt, hq_eq.symm⟩
      exact ⟨d_x, p_x, y₀, hy₀, hSubP, hSubsingletonOfEmpty Z 𝒢 (F₀.obj d_x) hEmpZ⟩

    have hLocInj : Sheaf.IsLocallyInjective u_raw := by
      refine ⟨fun {d_U_op} s₁ s₂ hs => ?_⟩
      let d_U : D_S := d_U_op.unop
      apply hMemKS d_U
      intro x
      by_cases hx_in : (G_S.obj d_U).hom.base x ∈ Set.range i.base
      · rcases hx_in with ⟨z₀, hz₀⟩
        let U₀ : AlgebraicGeometry.Scheme.{u} := (G_S.obj d_U).left
        let u_hom : U₀ ⟶ S := (G_S.obj d_U).hom
        obtain ⟨z, hz_x, _⟩ := Scheme.Pullback.exists_preimage_pullback x z₀ hz₀.symm
        let t₁ : ↥(L_ℋ.obj (Opposite.op (F₀.obj d_U))) :=
          (F₀.op.leftKanExtensionUnit P_ℋ).app (Opposite.op d_U) s₁
        let t₂ : ↥(L_ℋ.obj (Opposite.op (F₀.obj d_U))) :=
          (F₀.op.leftKanExtensionUnit P_ℋ).app (Opposite.op d_U) s₂
        have ht_eq : (toSheafify Z.smallEtaleTopology L_ℋ).app (Opposite.op (F₀.obj d_U)) t₁ =
            (toSheafify Z.smallEtaleTopology L_ℋ).app (Opposite.op (F₀.obj d_U)) t₂ := hs
        have hEqMem : Presheaf.equalizerSieve t₁ t₂ ∈ Z.smallEtaleTopology (F₀.obj d_U) :=
          Presheaf.IsLocallyInjective.equalizerSieve_mem t₁ t₂ ht_eq
        obtain ⟨W_z, g_z, w, hg_eq, hw_z⟩ := (hEtaleCoverIff Z (F₀.obj d_U) _).1 hEqMem z
        let K_Wz := CostructuredArrow.proj F₀.op (Opposite.op W_z) ⋙ P_ℋ
        let c_mk : CostructuredArrow F₀.op (Opposite.op W_z) := CostructuredArrow.mk g_z.op
        have hColimEq : (Limits.colimit.ι K_Wz c_mk) s₁ = (Limits.colimit.ι K_Wz c_mk) s₂ := by
          let iso_c := F₀.op.leftKanExtensionObjIsoColimit P_ℋ (Opposite.op W_z)
          apply (ConcreteCategory.bijective_of_isIso iso_c.inv).1
          have hι := Functor.ι_leftKanExtensionObjIsoColimit_inv F₀.op P_ℋ (Opposite.op W_z) c_mk
          have hι₁ := ConcreteCategory.congr_hom hι s₁
          have hι₂ := ConcreteCategory.congr_hom hι s₂
          change iso_c.inv ((Limits.colimit.ι K_Wz c_mk) s₁) = L_ℋ.map g_z.op t₁ at hι₁
          change iso_c.inv ((Limits.colimit.ι K_Wz c_mk) s₂) = L_ℋ.map g_z.op t₂ at hι₂
          rw [hι₁, hι₂]
          exact hg_eq
        let hc_type := Limits.isColimitOfPreserves (CategoryTheory.forget AddCommGrpCat.{u})
          (Limits.colimit.isColimit K_Wz)
        obtain ⟨c', f_arr, hf_eq⟩ :=
          (Limits.Types.FilteredColimit.isColimit_eq_iff' hc_type (i := c_mk) s₁ s₂).mp hColimEq
        let d' : D_S := c'.left.unop
        let β : W_z ⟶ F₀.obj d' := c'.hom.unop
        let p_u : d' ⟶ d_U := f_arr.left.unop
        have hβ_comp : β.left ≫ (F₀.map p_u).left = g_z.left :=
          congrArg (fun m => m.left) (Quiver.Hom.op_inj (CostructuredArrow.w f_arr))
        let d'_left : AlgebraicGeometry.Scheme.{u} := (G_S.obj d').left
        let d'_hom : d'_left ⟶ S := (G_S.obj d').hom
        let pu_left : d'_left ⟶ U₀ := (G_S.map p_u).left
        let fpu_left : Limits.pullback d'_hom i ⟶ Limits.pullback u_hom i := (F₀.map p_u).left
        let β_left : W_z.left ⟶ Limits.pullback d'_hom i := β.left
        let y₀ : ↥d'_left := (Limits.pullback.fst d'_hom i).base (β_left.base w)
        have hy₀ : pu_left.base y₀ = x := by
          have h1 : Limits.pullback.fst d'_hom i ≫ pu_left =
              fpu_left ≫ Limits.pullback.fst u_hom i :=
            (Limits.pullback.lift_fst _ _ _).symm
          have h2 : pu_left.base y₀ =
              (Limits.pullback.fst u_hom i).base (fpu_left.base (β_left.base w)) :=
            (hCompBaseApply (Limits.pullback.fst d'_hom i) pu_left (β_left.base w)).symm.trans
              ((congrArg (fun k : Limits.pullback d'_hom i ⟶ U₀ => k.base (β_left.base w)) h1).trans
                (hCompBaseApply fpu_left (Limits.pullback.fst u_hom i) (β_left.base w)))
          have h3 : fpu_left.base (β_left.base w) = z :=
            (hCompBaseApply β_left fpu_left w).symm.trans
              ((congrArg (fun k : W_z.left ⟶ Limits.pullback u_hom i => k.base w) hβ_comp).trans hw_z)
          exact h2.trans ((congrArg (Limits.pullback.fst u_hom i).base h3).trans hz_x)
        exact ⟨d', p_u, y₀, hf_eq, hy₀⟩
      · obtain ⟨d_x, p_x, y₀, hy₀, hSubP, _⟩ := hOutNbhd d_U x hx_in
        exact ⟨d_x, p_x, y₀, @Subsingleton.elim _ hSubP _ _, hy₀⟩

    have hLocSurj : Sheaf.IsLocallySurjective u_raw := by
      refine ⟨fun {d_U} ξ => ?_⟩
      apply hMemKS d_U
      intro x
      by_cases hx_in : (G_S.obj d_U).hom.base x ∈ Set.range i.base
      · rcases hx_in with ⟨z₀, hz₀⟩
        let U₀ : AlgebraicGeometry.Scheme.{u} := (G_S.obj d_U).left
        let u_hom : U₀ ⟶ S := (G_S.obj d_U).hom
        obtain ⟨z, hz_x, _⟩ := Scheme.Pullback.exists_preimage_pullback x z₀ hz₀.symm
        have hImgZ : Presheaf.imageSieve (toSheafify Z.smallEtaleTopology L_ℋ) ξ ∈
            Z.smallEtaleTopology (F₀.obj d_U) :=
          Presheaf.imageSieve_mem Z.smallEtaleTopology (toSheafify Z.smallEtaleTopology L_ℋ) ξ
        obtain ⟨W_z, g_z, w, ⟨ξ_w, hξ_w⟩, hw_z⟩ := (hEtaleCoverIff Z (F₀.obj d_U) _).1 hImgZ z
        let K_Wz := CostructuredArrow.proj F₀.op (Opposite.op W_z) ⋙ P_ℋ
        let iso_c := F₀.op.leftKanExtensionObjIsoColimit P_ℋ (Opposite.op W_z)
        let hc_type := Limits.isColimitOfPreserves (CategoryTheory.forget AddCommGrpCat.{u})
          (Limits.colimit.isColimit K_Wz)
        obtain ⟨c_a, s_a, hs_a⟩ := Limits.Types.jointly_surjective_of_isColimit hc_type (iso_c.hom ξ_w)
        have hs_a_unit : L_ℋ.map c_a.hom ((F₀.op.leftKanExtensionUnit P_ℋ).app c_a.left s_a) = ξ_w := by
          have hι := Functor.ι_leftKanExtensionObjIsoColimit_inv F₀.op P_ℋ (Opposite.op W_z) c_a
          have hι_app := ConcreteCategory.congr_hom hι s_a
          change iso_c.inv ((Limits.colimit.ι K_Wz c_a) s_a) =
            L_ℋ.map c_a.hom ((F₀.op.leftKanExtensionUnit P_ℋ).app c_a.left s_a) at hι_app
          rw [← hι_app]
          have hinv : (iso_c.hom ≫ iso_c.inv) ξ_w = ξ_w := by
            rw [iso_c.hom_inv_id]; rfl
          have hs_a' : (Limits.colimit.ι K_Wz c_a) s_a = iso_c.hom ξ_w := hs_a
          rw [hs_a']
          exact hinv
        let d_a : D_S := c_a.left.unop
        let α_a : W_z ⟶ F₀.obj d_a := c_a.hom.unop
        let d_Q : D_S := Limits.prod d_U d_a
        let pr₁ : d_Q ⟶ d_U := Limits.prod.fst
        let pr₂ : d_Q ⟶ d_a := Limits.prod.snd
        let iso_prod : F₀.obj d_Q ≅ Limits.prod (F₀.obj d_U) (F₀.obj d_a) :=
          Limits.PreservesLimitPair.iso F₀ d_U d_a
        let γ_z : W_z ⟶ F₀.obj d_Q := Limits.prod.lift g_z α_a ≫ iso_prod.inv
        have hγ_pr₁ : γ_z ≫ F₀.map pr₁ = g_z := by
          dsimp [γ_z, iso_prod, d_Q, pr₁]
          rw [Category.assoc, Limits.PreservesLimitPair.iso_inv_fst, Limits.prod.lift_fst]
        have hγ_pr₂ : γ_z ≫ F₀.map pr₂ = α_a := by
          dsimp [γ_z, iso_prod, d_Q, pr₂]
          rw [Category.assoc, Limits.PreservesLimitPair.iso_inv_snd, Limits.prod.lift_snd]
        obtain ⟨d_x, v_x, w_x, hwx_γ, ⟨y₀, hy₀⟩⟩ := hChartLift (G_S.obj d_Q) W_z γ_z w
        let p_x : d_x ⟶ d_Q := G_S.preimage v_x
        have hp_x_map : G_S.map p_x = v_x := G_S.map_preimage v_x
        have hF₀_px : F₀.map p_x = w_x ≫ γ_z := by
          change B_i.map (G_S.map p_x) = w_x ≫ γ_z
          rw [hp_x_map, hwx_γ]
        let q_x : d_x ⟶ d_U := p_x ≫ pr₁
        let s_x : ↥(P_ℋ.obj (Opposite.op d_x)) := P_ℋ.map (p_x ≫ pr₂).op s_a
        have hy₀_hit : (G_S.map q_x).left.base y₀ = x := by
          let dQ_left : AlgebraicGeometry.Scheme.{u} := (G_S.obj d_Q).left
          let dQ_hom : dQ_left ⟶ S := (G_S.obj d_Q).hom
          let dx_left : AlgebraicGeometry.Scheme.{u} := (G_S.obj d_x).left
          let qx_left : dx_left ⟶ U₀ := (G_S.map q_x).left
          let pr₁_left : dQ_left ⟶ U₀ := (G_S.map pr₁).left
          let fpr₁_left : Limits.pullback dQ_hom i ⟶ Limits.pullback u_hom i := (F₀.map pr₁).left
          let γ_left : W_z.left ⟶ Limits.pullback dQ_hom i := γ_z.left
          have hqx_comp : qx_left = v_x.left ≫ pr₁_left := by
            have hc : G_S.map q_x = v_x ≫ G_S.map pr₁ := by
              dsimp [q_x]
              rw [G_S.map_comp, hp_x_map]
            exact congrArg (fun m => m.left) hc
          have h0 : qx_left.base y₀ = pr₁_left.base (v_x.left.base y₀) :=
            (congrArg (fun k : dx_left ⟶ U₀ => k.base y₀) hqx_comp).trans
              (hCompBaseApply v_x.left pr₁_left y₀)
          have h1 : Limits.pullback.fst dQ_hom i ≫ pr₁_left =
              fpr₁_left ≫ Limits.pullback.fst u_hom i :=
            (Limits.pullback.lift_fst _ _ _).symm
          have h2 : pr₁_left.base ((Limits.pullback.fst dQ_hom i).base (γ_left.base w)) =
              (Limits.pullback.fst u_hom i).base (fpr₁_left.base (γ_left.base w)) :=
            (hCompBaseApply (Limits.pullback.fst dQ_hom i) pr₁_left (γ_left.base w)).symm.trans
              ((congrArg (fun k : Limits.pullback dQ_hom i ⟶ U₀ => k.base (γ_left.base w)) h1).trans
                (hCompBaseApply fpr₁_left (Limits.pullback.fst u_hom i) (γ_left.base w)))
          have hγ_left : γ_left ≫ fpr₁_left = g_z.left :=
            congrArg (fun m => m.left) hγ_pr₁
          have h3 : fpr₁_left.base (γ_left.base w) = z :=
            (hCompBaseApply γ_left fpr₁_left w).symm.trans
              ((congrArg (fun k : W_z.left ⟶ Limits.pullback u_hom i => k.base w) hγ_left).trans hw_z)
          exact h0.trans ((congrArg pr₁_left.base hy₀).trans
            (h2.trans ((congrArg (Limits.pullback.fst u_hom i).base h3).trans hz_x)))
        refine ⟨d_x, q_x, y₀, ⟨s_x, ?_⟩, hy₀_hit⟩
        change (toSheafify Z.smallEtaleTopology L_ℋ).app (Opposite.op (F₀.obj d_x))
            ((F₀.op.leftKanExtensionUnit P_ℋ).app (Opposite.op d_x) s_x) =
          𝒢.obj.map (F₀.map q_x).op ξ
        have hunit_nat := ConcreteCategory.congr_hom
          ((F₀.op.leftKanExtensionUnit P_ℋ).naturality (p_x ≫ pr₂).op) s_a
        change (F₀.op.leftKanExtensionUnit P_ℋ).app (Opposite.op d_x) s_x =
          L_ℋ.map (F₀.map (p_x ≫ pr₂)).op ((F₀.op.leftKanExtensionUnit P_ℋ).app c_a.left s_a) at hunit_nat
        have hw_pr₂ : F₀.map (p_x ≫ pr₂) = w_x ≫ α_a := by
          rw [F₀.map_comp, hF₀_px, Category.assoc, hγ_pr₂]
        have hLH_eq : (F₀.op.leftKanExtensionUnit P_ℋ).app (Opposite.op d_x) s_x =
            L_ℋ.map w_x.op ξ_w := by
          rw [hunit_nat, hw_pr₂, op_comp, L_ℋ.map_comp]
          change (L_ℋ.map c_a.hom ≫ L_ℋ.map w_x.op)
              ((F₀.op.leftKanExtensionUnit P_ℋ).app c_a.left s_a) =
            L_ℋ.map w_x.op ξ_w
          have hcomp_app : (L_ℋ.map c_a.hom ≫ L_ℋ.map w_x.op)
              ((F₀.op.leftKanExtensionUnit P_ℋ).app c_a.left s_a) =
              L_ℋ.map w_x.op (L_ℋ.map c_a.hom ((F₀.op.leftKanExtensionUnit P_ℋ).app c_a.left s_a)) :=
            rfl
          rw [hcomp_app, hs_a_unit]
        rw [hLH_eq]
        have hsh_nat := ConcreteCategory.congr_hom
          ((toSheafify Z.smallEtaleTopology L_ℋ).naturality w_x.op) ξ_w
        change (toSheafify Z.smallEtaleTopology L_ℋ).app (Opposite.op (F₀.obj d_x)) (L_ℋ.map w_x.op ξ_w) =
          𝒢.obj.map w_x.op ((toSheafify Z.smallEtaleTopology L_ℋ).app (Opposite.op W_z) ξ_w) at hsh_nat
        rw [hsh_nat, hξ_w]
        have hw_pr₁ : F₀.map q_x = w_x ≫ g_z := by
          dsimp [q_x]
          rw [F₀.map_comp, hF₀_px, Category.assoc, hγ_pr₁]
        rw [hw_pr₁, op_comp, 𝒢.obj.map_comp]
        rfl
      · obtain ⟨d_x, p_x, y₀, hy₀, _, hSubG⟩ := hOutNbhd d_U x hx_in
        refine ⟨d_x, p_x, y₀, ⟨0, @Subsingleton.elim _ hSubG _ _⟩, hy₀⟩

    have hIso_uraw : IsIso u_raw :=
      (Sheaf.isLocallyBijective_iff_isIso u_raw).mp ⟨hLocInj, hLocSurj⟩
    let iso_ES : E_S.obj ℋ ≅ E_S.obj (F_push.obj 𝒢) := @asIso _ _ _ _ u_raw hIso_uraw
    exact ⟨𝒢, hℓ_G, ⟨E_S.preimageIso iso_ES⟩⟩

  
  obtain ⟨F_push, instAdd, instLim, instColim, ρ_ℤ, hInj, hHom0, 𝒢, hℓ_𝒢, ⟨iso_ℋ⟩⟩ := hPushEquiv
  letI : F_push.Additive := instAdd
  letI : CategoryTheory.Limits.PreservesFiniteLimits F_push := instLim
  letI : CategoryTheory.Limits.PreservesFiniteColimits F_push := instColim
  have hSubZ : Subsingleton (𝒢.H q) := hVanishZ 𝒢 hℓ_𝒢
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_S := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  have hSubPush : Subsingleton (CategoryTheory.Abelian.Ext.{u} Fℤ_S (F_push.obj 𝒢) q) :=
    hExtVanish F_push hInj Fℤ_Z Fℤ_S ρ_ℤ hHom0 q 𝒢 hSubZ
  refine subsingleton_of_forall_eq 0 (fun w => ?_)
  have hw_hom : w.comp (CategoryTheory.Abelian.Ext.mk₀ iso_ℋ.hom) (Nat.add_zero q) = 0 :=
    @Subsingleton.elim _ hSubPush _ 0
  have hw_inv := congrArg
    (fun e : CategoryTheory.Abelian.Ext.{u} Fℤ_S (F_push.obj 𝒢) q =>
      e.comp (CategoryTheory.Abelian.Ext.mk₀ iso_ℋ.inv) (Nat.add_zero q))
    hw_hom
  rw [CategoryTheory.Abelian.Ext.zero_comp,
    CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
    CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, iso_ℋ.hom_inv_id,
    CategoryTheory.Abelian.Ext.comp_mk₀_id] at hw_inv
  exact hw_inv

theorem weil_alt_cd_qcsep_etale_filtered_colimit_eval_iso (S : AlgebraicGeometry.Scheme.{u})
    (Idx : Type u) [CategoryTheory.SmallCategory Idx] [CategoryTheory.IsFiltered Idx]
    (D : CategoryTheory.Functor Idx
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}))
    (c : CategoryTheory.Limits.Cocone D)
    (hc : CategoryTheory.Limits.IsColimit c)
    (U : S.Etale) [CompactSpace ↥U.left] [U.left.IsSeparated] :
    Nonempty (CategoryTheory.Limits.IsColimit
      ((CategoryTheory.Functor.comp
        (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u})
        ((CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).obj
          (Opposite.op U))).mapCocone c)) :=
by
  
  have hFinLift : ∀ {α : Type} [DecidableEq α] (s : Finset α)
      (F : α → CategoryTheory.Functor Idx (Type u))
      (κ : ∀ a : α, CategoryTheory.Limits.Cocone (F a))
      (y : ∀ a : α, (κ a).pt),
      (∀ a ∈ s, ∃ (j : Idx) (x : (F a).obj j), (κ a).ι.app j x = y a) →
      ∃ (j : Idx) (x : ∀ a : α, a ∈ s → (F a).obj j),
        ∀ (a : α) (ha : a ∈ s), (κ a).ι.app j (x a ha) = y a := by
    intro α _ s F κ y hall
    induction s using Finset.induction_on with
    | empty =>
      obtain ⟨j₀⟩ := CategoryTheory.IsFiltered.nonempty (C := Idx)
      exact ⟨j₀, fun a ha => False.elim (Finset.notMem_empty a ha),
        fun a ha => False.elim (Finset.notMem_empty a ha)⟩
    | @insert a₀ s' _ha₀ ih =>
      obtain ⟨j₀, x₀, hx₀⟩ := hall a₀ (Finset.mem_insert_self a₀ s')
      obtain ⟨j₁, x₁, hx₁⟩ := ih (fun a ha => hall a (Finset.mem_insert_of_mem ha))
      let j_max := CategoryTheory.IsFiltered.max j₀ j₁
      let ℓ := CategoryTheory.IsFiltered.leftToMax j₀ j₁
      let r := CategoryTheory.IsFiltered.rightToMax j₀ j₁
      refine ⟨j_max, fun a ha =>
        if h : a = a₀ then h ▸ (F a₀).map ℓ x₀
        else (F a).map r (x₁ a (Finset.mem_of_mem_insert_of_ne ha h)), ?_⟩
      intro a ha
      dsimp only
      split_ifs with h
      · subst h
        have hw := CategoryTheory.ConcreteCategory.congr_hom ((κ a).w ℓ) x₀
        dsimp at hw
        exact hw.trans hx₀
      · have has' : a ∈ s' := Finset.mem_of_mem_insert_of_ne ha h
        have hw := CategoryTheory.ConcreteCategory.congr_hom ((κ a).w r) (x₁ a has')
        dsimp at hw
        exact hw.trans (hx₁ a has')

  have hFinEq : ∀ {α : Type} [DecidableEq α] (s : Finset α)
      (F : α → CategoryTheory.Functor Idx (Type u))
      (j₀ : Idx) (u₁ u₂ : ∀ a : α, (F a).obj j₀),
      (∀ a ∈ s, ∃ (k : Idx) (φ : j₀ ⟶ k), (F a).map φ (u₁ a) = (F a).map φ (u₂ a)) →
      ∃ (k : Idx) (ψ : j₀ ⟶ k),
        ∀ a ∈ s, (F a).map ψ (u₁ a) = (F a).map ψ (u₂ a) := by
    intro α _ s F j₀ u₁ u₂ hall
    induction s using Finset.induction_on with
    | empty =>
      exact ⟨j₀, 𝟙 j₀, fun a ha => False.elim (Finset.notMem_empty a ha)⟩
    | @insert a₀ s' _ha₀ ih =>
      obtain ⟨k₀, φ₀, hφ₀⟩ := hall a₀ (Finset.mem_insert_self a₀ s')
      obtain ⟨k₁, ψ₁, hψ₁⟩ := ih (fun a ha => hall a (Finset.mem_insert_of_mem ha))
      let α₀ := CategoryTheory.IsFiltered.leftToMax k₀ k₁
      let α₁ := CategoryTheory.IsFiltered.rightToMax k₀ k₁
      let k_coeq := CategoryTheory.IsFiltered.coeq (φ₀ ≫ α₀) (ψ₁ ≫ α₁)
      let β := CategoryTheory.IsFiltered.coeqHom (φ₀ ≫ α₀) (ψ₁ ≫ α₁)
      have hcoeq : (φ₀ ≫ α₀) ≫ β = (ψ₁ ≫ α₁) ≫ β :=
        CategoryTheory.IsFiltered.coeq_condition (φ₀ ≫ α₀) (ψ₁ ≫ α₁)
      refine ⟨k_coeq, (ψ₁ ≫ α₁) ≫ β, fun a ha => ?_⟩
      rcases Finset.mem_insert.mp ha with rfl | has'
      · rw [← hcoeq, Category.assoc, Functor.map_comp]
        simp only [ConcreteCategory.comp_apply, hφ₀]
      · rw [Category.assoc, Functor.map_comp]
        simp only [ConcreteCategory.comp_apply, hψ₁ a has']

  
  let Z_free : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let isoCoyonedaForget : CategoryTheory.coyoneda.obj (Opposite.op Z_free) ≅
      CategoryTheory.forget AddCommGrpCat.{u} :=
    CategoryTheory.NatIso.ofComponents
      (fun M =>
        { hom := TypeCat.ofHom (fun (f : Z_free ⟶ M) => f (ULift.up (1 : ℤ)))
          inv := TypeCat.ofHom (fun (x : M) =>
            AddCommGrpCat.ofHom
              { toFun := fun n => n.down • x
                map_zero' := zero_zsmul x
                map_add' := fun a b => add_zsmul x a.down b.down })
          hom_inv_id := by
            ext f
            apply AddCommGrpCat.ext
            rintro ⟨n⟩
            let f_hom : Z_free ⟶ M := f
            change n • f_hom (ULift.up (1 : ℤ)) = f_hom (ULift.up n)
            have hn : ULift.up n = n • (ULift.up (1 : ℤ) : Z_free) := by
              ext
              change n = n • (1 : ℤ)
              simp
            rw [hn, map_zsmul]
          inv_hom_id := by
            ext x
            exact one_zsmul x })
      (fun {_M _N} _g => by
        ext _f
        rfl)

  have hSheafToTypes : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C)
      (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
      CategoryTheory.Presieve.IsSheaf J (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) := by
    intro C _ J 𝒢
    have hZ : CategoryTheory.Presieve.IsSheaf J
        (𝒢.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Z_free)) := 𝒢.property Z_free
    exact CategoryTheory.Presieve.isSheaf_iso J
      (CategoryTheory.Functor.isoWhiskerLeft 𝒢.obj isoCoyonedaForget) hZ

  have hTypesToSheaf : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C)
      (P : Cᵒᵖ ⥤ AddCommGrpCat.{u}),
      CategoryTheory.Presieve.IsSheaf J (P ⋙ CategoryTheory.forget AddCommGrpCat.{u}) →
      CategoryTheory.Presheaf.IsSheaf J P := by
    intro C _ J P hP
    exact CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J P
      (CategoryTheory.forget AddCommGrpCat.{u})
      ((CategoryTheory.isSheaf_iff_isSheaf_of_type J _).mpr hP)

  
  have hTypeCoverGlue : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      [CategoryTheory.Limits.HasPullbacks C]
      (M : CategoryTheory.Functor Idx (Cᵒᵖ ⥤ Type u))
      (γ : CategoryTheory.Limits.Cocone M)
      (W₀ : C) (m : ℕ) (V : Fin m → C) (h : ∀ a : Fin m, V a ⟶ W₀),
      (∀ j : Idx, CategoryTheory.Presieve.IsSheafFor (M.obj j)
        (CategoryTheory.Presieve.ofArrows V h)) →
      (∀ a : Fin m, CategoryTheory.Limits.IsColimit
        (((CategoryTheory.evaluation Cᵒᵖ (Type u)).obj (Opposite.op (V a))).mapCocone γ)) →
      (∀ a b : Fin m, CategoryTheory.Limits.IsColimit
        (((CategoryTheory.evaluation Cᵒᵖ (Type u)).obj
          (Opposite.op (CategoryTheory.Limits.pullback (h a) (h b)))).mapCocone γ)) →
      ((∀ (y : ∀ a : Fin m, γ.pt.obj (Opposite.op (V a))),
          CategoryTheory.Presieve.Arrows.PullbackCompatible γ.pt h y →
          ∃ (j₂ : Idx) (s₂ : (M.obj j₂).obj (Opposite.op W₀)),
            ∀ a : Fin m,
              γ.pt.map (h a).op ((γ.ι.app j₂).app (Opposite.op W₀) s₂) = y a) ∧
       (∀ (j₀ : Idx) (s₁ s₂ : (M.obj j₀).obj (Opposite.op W₀)),
          (∀ a : Fin m,
            (γ.ι.app j₀).app (Opposite.op (V a)) ((M.obj j₀).map (h a).op s₁) =
            (γ.ι.app j₀).app (Opposite.op (V a)) ((M.obj j₀).map (h a).op s₂)) →
          ∃ (k : Idx) (ψ : j₀ ⟶ k),
            (M.map ψ).app (Opposite.op W₀) s₁ = (M.map ψ).app (Opposite.op W₀) s₂)) := by
    intro C _ _ M γ W₀ m V h hSheafM hColimV hColimVV
    constructor
    · intro y hy
      have hLiftEach : ∀ a ∈ (Finset.univ : Finset (Fin m)),
          ∃ (j : Idx) (x : (M.obj j).obj (Opposite.op (V a))),
            (((CategoryTheory.evaluation Cᵒᵖ (Type u)).obj
              (Opposite.op (V a))).mapCocone γ).ι.app j x = y a := by
        intro a _
        exact CategoryTheory.Limits.Types.jointly_surjective_of_isColimit (hColimV a) (y a)
      obtain ⟨j₁, x₁_mem, hx₁_mem⟩ := hFinLift Finset.univ
        (fun a => M ⋙ (CategoryTheory.evaluation Cᵒᵖ (Type u)).obj (Opposite.op (V a)))
        (fun a => ((CategoryTheory.evaluation Cᵒᵖ (Type u)).obj (Opposite.op (V a))).mapCocone γ)
        y hLiftEach
      let x₁ : ∀ a : Fin m, (M.obj j₁).obj (Opposite.op (V a)) :=
        fun a => x₁_mem a (Finset.mem_univ a)
      have hx₁ : ∀ a : Fin m, (γ.ι.app j₁).app (Opposite.op (V a)) (x₁ a) = y a :=
        fun a => hx₁_mem a (Finset.mem_univ a)
      let F_pb : Fin m × Fin m → CategoryTheory.Functor Idx (Type u) :=
        fun p => M ⋙ (CategoryTheory.evaluation Cᵒᵖ (Type u)).obj
          (Opposite.op (CategoryTheory.Limits.pullback (h p.1) (h p.2)))
      let u_pb : ∀ p : Fin m × Fin m, (F_pb p).obj j₁ :=
        fun p => (M.obj j₁).map (CategoryTheory.Limits.pullback.fst (h p.1) (h p.2)).op (x₁ p.1)
      let v_pb : ∀ p : Fin m × Fin m, (F_pb p).obj j₁ :=
        fun p => (M.obj j₁).map (CategoryTheory.Limits.pullback.snd (h p.1) (h p.2)).op (x₁ p.2)
      have hEqEach : ∀ p ∈ (Finset.univ : Finset (Fin m × Fin m)),
          ∃ (k : Idx) (φ : j₁ ⟶ k), (F_pb p).map φ (u_pb p) = (F_pb p).map φ (v_pb p) := by
        intro p _
        refine (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff'
          (hColimVV p.1 p.2) (u_pb p) (v_pb p)).mp ?_
        have hnat₁ := CategoryTheory.ConcreteCategory.congr_hom
          ((γ.ι.app j₁).naturality (CategoryTheory.Limits.pullback.fst (h p.1) (h p.2)).op)
          (x₁ p.1)
        have hnat₂ := CategoryTheory.ConcreteCategory.congr_hom
          ((γ.ι.app j₁).naturality (CategoryTheory.Limits.pullback.snd (h p.1) (h p.2)).op)
          (x₁ p.2)
        dsimp [u_pb, v_pb] at hnat₁ hnat₂ ⊢
        rw [hnat₁, hx₁ p.1, hnat₂, hx₁ p.2]
        exact hy p.1 p.2
      obtain ⟨j₂, ψ, hψ⟩ := hFinEq Finset.univ F_pb j₁ u_pb v_pb hEqEach
      let x₂ : ∀ a : Fin m, (M.obj j₂).obj (Opposite.op (V a)) :=
        fun a => (M.map ψ).app (Opposite.op (V a)) (x₁ a)
      have hCompat₂ : CategoryTheory.Presieve.Arrows.PullbackCompatible (M.obj j₂) h x₂ := by
        intro a b
        have hnat₁ := CategoryTheory.ConcreteCategory.congr_hom
          ((M.map ψ).naturality (CategoryTheory.Limits.pullback.fst (h a) (h b)).op) (x₁ a)
        have hnat₂ := CategoryTheory.ConcreteCategory.congr_hom
          ((M.map ψ).naturality (CategoryTheory.Limits.pullback.snd (h a) (h b)).op) (x₁ b)
        simp only [ConcreteCategory.comp_apply] at hnat₁ hnat₂
        dsimp [x₂]
        rw [← hnat₁, ← hnat₂]
        exact hψ (a, b) (Finset.mem_univ (a, b))
      obtain ⟨s₂, hs₂, _⟩ :=
        (CategoryTheory.Presieve.isSheafFor_arrows_iff_pullbacks (M.obj j₂) h).mp
          (hSheafM j₂) x₂ hCompat₂
      refine ⟨j₂, s₂, fun a => ?_⟩
      have hnat := CategoryTheory.ConcreteCategory.congr_hom
        ((γ.ι.app j₂).naturality (h a).op) s₂
      dsimp at hnat
      rw [← hnat, hs₂ a]
      dsimp [x₂]
      have hw := CategoryTheory.ConcreteCategory.congr_hom
        (CategoryTheory.NatTrans.congr_app (γ.w ψ) (Opposite.op (V a))) (x₁ a)
      dsimp at hw
      exact hw.trans (hx₁ a)
    · intro j₀ s₁ s₂ hEqV
      let F_V : Fin m → CategoryTheory.Functor Idx (Type u) :=
        fun a => M ⋙ (CategoryTheory.evaluation Cᵒᵖ (Type u)).obj (Opposite.op (V a))
      let u_V : ∀ a : Fin m, (F_V a).obj j₀ := fun a => (M.obj j₀).map (h a).op s₁
      let v_V : ∀ a : Fin m, (F_V a).obj j₀ := fun a => (M.obj j₀).map (h a).op s₂
      have hEqEach : ∀ a ∈ (Finset.univ : Finset (Fin m)),
          ∃ (k : Idx) (φ : j₀ ⟶ k), (F_V a).map φ (u_V a) = (F_V a).map φ (v_V a) := by
        intro a _
        exact (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff'
          (hColimV a) (u_V a) (v_V a)).mp (hEqV a)
      obtain ⟨k, ψ, hψ⟩ := hFinEq Finset.univ F_V j₀ u_V v_V hEqEach
      refine ⟨k, ψ, ?_⟩
      let t₁ := (M.map ψ).app (Opposite.op W₀) s₁
      let t₂ := (M.map ψ).app (Opposite.op W₀) s₂
      let x_k : ∀ a : Fin m, (M.obj k).obj (Opposite.op (V a)) :=
        fun a => (M.obj k).map (h a).op t₁
      have hCompat_k : CategoryTheory.Presieve.Arrows.PullbackCompatible (M.obj k) h x_k := by
        intro a b
        dsimp [x_k]
        rw [← ConcreteCategory.comp_apply, ← (M.obj k).map_comp, ← op_comp,
          CategoryTheory.Limits.pullback.condition, op_comp, (M.obj k).map_comp,
          ConcreteCategory.comp_apply]
      obtain ⟨_, _, hUniq⟩ :=
        (CategoryTheory.Presieve.isSheafFor_arrows_iff_pullbacks (M.obj k) h).mp
          (hSheafM k) x_k hCompat_k
      have ht₁ : t₁ = _ := hUniq t₁ (fun _ => rfl)
      have ht₂ : t₂ = _ := hUniq t₂ (fun a => by
        dsimp [t₁, t₂, x_k]
        have hnat₁ := CategoryTheory.ConcreteCategory.congr_hom
          ((M.map ψ).naturality (h a).op) s₁
        have hnat₂ := CategoryTheory.ConcreteCategory.congr_hom
          ((M.map ψ).naturality (h a).op) s₂
        simp only [ConcreteCategory.comp_apply] at hnat₁ hnat₂
        rw [← hnat₂, ← hnat₁]
        exact (hψ a (Finset.mem_univ a)).symm)
      exact ht₁.trans ht₂.symm

  
  have hFinitarySiteEval : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      [CategoryTheory.Limits.HasPullbacks C]
      (J : CategoryTheory.GrothendieckTopology C)
      (hFinCov : ∀ (X : C) (R : CategoryTheory.Sieve X), R ∈ J X →
        ∃ (m : ℕ) (V : Fin m → C) (h : ∀ a : Fin m, V a ⟶ X),
          CategoryTheory.Sieve.ofArrows V h ≤ R ∧
          CategoryTheory.Sieve.ofArrows V h ∈ J X)
      (D₀ : CategoryTheory.Functor Idx (CategoryTheory.Sheaf J AddCommGrpCat.{u}))
      (c₀ : CategoryTheory.Limits.Cocone D₀)
      (hc₀ : CategoryTheory.Limits.IsColimit c₀)
      (X : C),
      CategoryTheory.Limits.IsColimit
        ((CategoryTheory.Functor.comp
          (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u})
          ((CategoryTheory.evaluation Cᵒᵖ AddCommGrpCat.{u}).obj
            (Opposite.op X))).mapCocone c₀) := by
    intro C _ _ J hFinCov D₀ c₀ hc₀ X
    have hCreates : CategoryTheory.CreatesColimit D₀
        (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}) := by
      refine CategoryTheory.Sheaf.createsColimitOfIsSheaf D₀ (fun E hE => ?_)
      apply hTypesToSheaf J E.pt
      let W_fgt := (CategoryTheory.Functor.whiskeringRight Cᵒᵖ AddCommGrpCat.{u} (Type u)).obj
        (CategoryTheory.forget AddCommGrpCat.{u})
      let M : CategoryTheory.Functor Idx (Cᵒᵖ ⥤ Type u) :=
        (D₀ ⋙ CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}) ⋙ W_fgt
      let γ : CategoryTheory.Limits.Cocone M := W_fgt.mapCocone E
      have hColimPt : ∀ W : C, CategoryTheory.Limits.IsColimit
          (((CategoryTheory.evaluation Cᵒᵖ (Type u)).obj (Opposite.op W)).mapCocone γ) := by
        intro W
        have hEvalE : CategoryTheory.Limits.IsColimit
            (((CategoryTheory.evaluation Cᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op W)).mapCocone E) :=
          CategoryTheory.Limits.isColimitOfPreserves _ hE
        have hFgtEval : CategoryTheory.Limits.IsColimit
            ((CategoryTheory.forget AddCommGrpCat.{u}).mapCocone
              (((CategoryTheory.evaluation Cᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op W)).mapCocone E)) :=
          CategoryTheory.Limits.isColimitOfPreserves (CategoryTheory.forget AddCommGrpCat.{u}) hEvalE
        exact CategoryTheory.Limits.IsColimit.ofIsoColimit hFgtEval
          ((CategoryTheory.Functor.mapCoconeMapCocone E).trans
            (CategoryTheory.Functor.mapCoconeMapCocone E).symm)
      have hFinArrows : ∀ (Y : C) (m : ℕ) (P : Fin m → C) (p : ∀ a : Fin m, P a ⟶ Y),
          CategoryTheory.Sieve.ofArrows P p ∈ J Y →
          CategoryTheory.Presieve.IsSheafFor γ.pt (CategoryTheory.Sieve.ofArrows P p).arrows := by
        intro Y m P p hMem
        rw [← CategoryTheory.Presieve.isSheafFor_iff_generate]
        have hSheafM : ∀ j : Idx, CategoryTheory.Presieve.IsSheafFor (M.obj j)
            (CategoryTheory.Presieve.ofArrows P p) := by
          intro j
          exact (CategoryTheory.Presieve.isSheafFor_iff_generate
            (CategoryTheory.Presieve.ofArrows P p)).mpr
            (hSheafToTypes J (D₀.obj j) _ hMem)
        obtain ⟨hGlueLift, hGlueEq⟩ := hTypeCoverGlue M γ Y m P p hSheafM
          (fun a => hColimPt (P a))
          (fun a b => hColimPt (CategoryTheory.Limits.pullback (p a) (p b)))
        refine (CategoryTheory.Presieve.isSheafFor_arrows_iff_pullbacks γ.pt p).mpr
          (fun y hy => ?_)
        obtain ⟨j₂, s₂, hs₂⟩ := hGlueLift y hy
        refine ⟨(γ.ι.app j₂).app (Opposite.op Y) s₂, hs₂, fun s' hs' => ?_⟩
        obtain ⟨j₀, s₁', s₁, hs₁', hs₁⟩ :=
          CategoryTheory.Limits.Types.FilteredColimit.jointly_surjective_of_isColimit₂
            (hColimPt Y) s' ((γ.ι.app j₂).app (Opposite.op Y) s₂)
        dsimp at hs₁' hs₁
        have hEqOnP : ∀ a : Fin m,
            (γ.ι.app j₀).app (Opposite.op (P a)) ((M.obj j₀).map (p a).op s₁') =
            (γ.ι.app j₀).app (Opposite.op (P a)) ((M.obj j₀).map (p a).op s₁) := by
          intro a
          have hnat₁ := CategoryTheory.ConcreteCategory.congr_hom
            ((γ.ι.app j₀).naturality (p a).op) s₁'
          have hnat₂ := CategoryTheory.ConcreteCategory.congr_hom
            ((γ.ι.app j₀).naturality (p a).op) s₁
          dsimp at hnat₁ hnat₂
          rw [hnat₁, hs₁', hs' a, hnat₂, hs₁, hs₂ a]
        obtain ⟨k, ψ, hψ⟩ := hGlueEq j₀ s₁' s₁ hEqOnP
        have hw₁ := CategoryTheory.ConcreteCategory.congr_hom
          (CategoryTheory.NatTrans.congr_app (γ.w ψ) (Opposite.op Y)) s₁'
        have hw₂ := CategoryTheory.ConcreteCategory.congr_hom
          (CategoryTheory.NatTrans.congr_app (γ.w ψ) (Opposite.op Y)) s₁
        dsimp at hw₁ hw₂
        calc
          s' = (γ.ι.app j₀).app (Opposite.op Y) s₁' := hs₁'.symm
          _ = (γ.ι.app k).app (Opposite.op Y) ((M.map ψ).app (Opposite.op Y) s₁') := hw₁.symm
          _ = (γ.ι.app k).app (Opposite.op Y) ((M.map ψ).app (Opposite.op Y) s₁) := by rw [hψ]
          _ = (γ.ι.app j₀).app (Opposite.op Y) s₁ := hw₂
          _ = (γ.ι.app j₂).app (Opposite.op Y) s₂ := hs₁
      intro Y₀ R hR
      obtain ⟨m, V, h, h_le, h_mem⟩ := hFinCov Y₀ R hR
      refine CategoryTheory.Presieve.isSheafFor_subsieve γ.pt (S := CategoryTheory.Sieve.ofArrows V h)
        h_le (fun Y f => ?_)
      let P : Fin m → C := fun a => CategoryTheory.Limits.pullback (h a) f
      let p₁ : ∀ a : Fin m, P a ⟶ Y := fun a => CategoryTheory.Limits.pullback.snd (h a) f
      have hEqPb : CategoryTheory.Sieve.ofArrows P p₁ =
          CategoryTheory.Sieve.pullback f (CategoryTheory.Sieve.ofArrows V h) :=
        CategoryTheory.Sieve.ofArrows_eq_pullback_of_isPullback h
          (fun a => (CategoryTheory.IsPullback.of_hasPullback (h a) f).flip)
      rw [← hEqPb]
      refine hFinArrows Y m P p₁ ?_
      rw [hEqPb]
      exact J.pullback_stable f h_mem
    have : CategoryTheory.Limits.PreservesColimit D₀
        (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}) :=
      CategoryTheory.preservesColimit_of_createsColimit_and_hasColimit D₀
        (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u})
    exact CategoryTheory.Limits.isColimitOfPreserves
      (CategoryTheory.Functor.comp
        (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u})
        ((CategoryTheory.evaluation Cᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op X))) hc₀

  
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have hMemSmallEtale : ∀ (X₀ : S.Etale) (R₀ : CategoryTheory.Sieve X₀),
      R₀ ∈ S.smallEtaleTopology X₀ ↔
      ∀ (x : ↥X₀.left), ∃ (Y : S.Etale) (f : Y ⟶ X₀) (y : ↥Y.left),
        R₀.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left y = x := by
    intro X₀ R₀
    let X₀' : P_et.Over ⊤ S := X₀
    let R₀' : CategoryTheory.Sieve X₀' := R₀
    change R₀' ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et S X₀' ↔ _
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) S le_rfl]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology X₀' R₀'

  have hAffEtaleFinCov : ∀ (X : S.AffineEtale) (R : CategoryTheory.Sieve X),
      R ∈ (AlgebraicGeometry.Scheme.AffineEtale.topology S) X →
      ∃ (m : ℕ) (V : Fin m → S.AffineEtale) (h : ∀ a : Fin m, V a ⟶ X),
        CategoryTheory.Sieve.ofArrows V h ≤ R ∧
        CategoryTheory.Sieve.ofArrows V h ∈ (AlgebraicGeometry.Scheme.AffineEtale.topology S) X := by
    intro X R hR
    let G : S.AffineEtale ⥤ S.Etale := AlgebraicGeometry.Scheme.AffineEtale.Spec S
    have : CategoryTheory.Functor.IsDenseSubsite
        (AlgebraicGeometry.Scheme.AffineEtale.topology S) S.smallEtaleTopology G := by
      dsimp [G]
      infer_instance
    have hPush : CategoryTheory.Sieve.functorPushforward G R ∈ S.smallEtaleTopology (G.obj X) :=
      (CategoryTheory.Functor.IsDenseSubsite.functorPushforward_mem_iff
        (J := AlgebraicGeometry.Scheme.AffineEtale.topology S)
        (K := S.smallEtaleTopology) (G := G)).mpr hR
    have hPt : ∀ x : ↥(G.obj X).left,
        ∃ (Z : S.AffineEtale) (g : Z ⟶ X),
          R.arrows g ∧ x ∈ Set.range (G.map g).left := by
      intro x
      have hPush' := (hMemSmallEtale (G.obj X) _).mp hPush x
      obtain ⟨_Y_et, f_et, y_et, hf_push, _, hy_et⟩ := hPush'
      rcases hf_push with ⟨Z, g, w, hg, rfl⟩
      exact ⟨Z, g, hg, w.left y_et, hy_et⟩
    choose Z_pt g_pt hg_pt hx_pt using hPt
    have hEtMap : ∀ x : ↥(G.obj X).left, AlgebraicGeometry.Etale (G.map (g_pt x)).left := by
      intro x
      refine CategoryTheory.MorphismProperty.of_postcomp P_et
        (G.map (g_pt x)).left (G.obj X).hom (G.obj X).prop ?_
      change AlgebraicGeometry.Etale ((G.map (g_pt x)).left ≫ (G.obj X).hom)
      rw [CategoryTheory.MorphismProperty.Over.w (G.map (g_pt x))]
      exact (G.obj (Z_pt x)).prop
    have hOpenRange : ∀ x : ↥(G.obj X).left, IsOpen (Set.range (G.map (g_pt x)).left) := by
      intro x
      have : AlgebraicGeometry.Etale (G.map (g_pt x)).left := hEtMap x
      exact (AlgebraicGeometry.Scheme.Hom.isOpenMap (G.map (g_pt x)).left).isOpen_range
    have hCoverUniv : Set.univ ⊆ ⋃ x : ↥(G.obj X).left, Set.range (G.map (g_pt x)).left :=
      fun x _ => Set.mem_iUnion.mpr ⟨x, hx_pt x⟩
    have : CompactSpace ↥(G.obj X).left := by
      change CompactSpace ↥(AlgebraicGeometry.Scheme.Spec.obj X.left)
      infer_instance
    obtain ⟨s_fin, hs_fin⟩ := isCompact_univ.elim_finite_subcover
      (fun x => Set.range (G.map (g_pt x)).left) hOpenRange hCoverUniv
    let m := s_fin.card
    let e_fin : Fin m ≃ ↥s_fin := s_fin.equivFin.symm
    let V : Fin m → S.AffineEtale := fun a => Z_pt (e_fin a).1
    let h : ∀ a : Fin m, V a ⟶ X := fun a => g_pt (e_fin a).1
    refine ⟨m, V, h, ?_, ?_⟩
    · exact (CategoryTheory.Sieve.generate_le_iff _ _).mpr
        (CategoryTheory.Presieve.ofArrows_le_iff.mpr (fun a => hg_pt (e_fin a).1))
    · rw [← CategoryTheory.Functor.IsDenseSubsite.functorPushforward_mem_iff
          (J := AlgebraicGeometry.Scheme.AffineEtale.topology S)
          (K := S.smallEtaleTopology) (G := G),
        hMemSmallEtale]
      intro x
      have hx_mem := hs_fin (Set.mem_univ x)
      rw [Set.mem_iUnion₂] at hx_mem
      rcases hx_mem with ⟨p, hp, y, hy⟩
      obtain ⟨a, ha⟩ := e_fin.surjective ⟨p, hp⟩
      have ha_eq : (e_fin a).1 = p := congrArg Subtype.val ha
      clear ha hp
      subst ha_eq
      exact ⟨G.obj (V a), G.map (h a), y,
        ⟨V a, h a, 𝟙 _, CategoryTheory.Sieve.ofArrows_mk V h a,
          (CategoryTheory.Category.id_comp _).symm⟩,
        hEtMap (e_fin a).1, hy⟩

  
  let e_aff := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv S AddCommGrpCat.{u}
  have hc_aff : CategoryTheory.Limits.IsColimit (e_aff.inverse.mapCocone c) :=
    CategoryTheory.Limits.isColimitOfPreserves e_aff.inverse hc

  have hAffEval : ∀ (W : S.Etale) [AlgebraicGeometry.IsAffine W.left],
      CategoryTheory.Limits.IsColimit
        ((CategoryTheory.Functor.comp
          (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u})
          ((CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).obj
            (Opposite.op W))).mapCocone c) := by
    intro W _
    let X_W : S.AffineEtale :=
      CategoryTheory.MorphismProperty.CostructuredArrow.mk ⊤
        (CategoryTheory.CategoryStruct.comp W.left.isoSpec.inv W.hom)
        (by infer_instance)
    let W' : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ X_W.hom X_W.prop
    let iso_W : W ≅ W' :=
      CategoryTheory.MorphismProperty.Over.isoMk W.left.isoSpec
        (CategoryTheory.Iso.hom_inv_id_assoc W.left.isoSpec W.hom)
    have hc_XW : CategoryTheory.Limits.IsColimit
        ((CategoryTheory.Functor.comp
          (CategoryTheory.sheafToPresheaf (AlgebraicGeometry.Scheme.AffineEtale.topology S)
            AddCommGrpCat.{u})
          ((CategoryTheory.evaluation (S.AffineEtale)ᵒᵖ AddCommGrpCat.{u}).obj
            (Opposite.op X_W))).mapCocone (e_aff.inverse.mapCocone c)) :=
      hFinitarySiteEval (AlgebraicGeometry.Scheme.AffineEtale.topology S) hAffEtaleFinCov
        (D ⋙ e_aff.inverse) (e_aff.inverse.mapCocone c) hc_aff X_W
    have hc_W' : CategoryTheory.Limits.IsColimit
        ((CategoryTheory.Functor.comp
          (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u})
          ((CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).obj
            (Opposite.op W'))).mapCocone c) :=
      CategoryTheory.Limits.IsColimit.ofIsoColimit hc_XW
        (CategoryTheory.Functor.mapCoconeMapCocone c)
    let isoEval :
        CategoryTheory.Functor.comp
          (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u})
          ((CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op W')) ≅
        CategoryTheory.Functor.comp
          (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u})
          ((CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op W)) :=
      CategoryTheory.Functor.isoWhiskerLeft
        (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u})
        ((CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).mapIso iso_W.op)
    exact CategoryTheory.Limits.IsColimit.mapCoconeEquiv isoEval hc_W'

  
  have hAffOpenPt : ∀ x : ↥U.left,
      ∃ O : U.left.Opens, AlgebraicGeometry.IsAffineOpen O ∧ x ∈ O := by
    intro x
    obtain ⟨O_set, hO_mem, hxO, _⟩ :=
      (AlgebraicGeometry.Scheme.isBasis_affineOpens U.left).exists_subset_of_mem_open
        (Set.mem_univ x) isOpen_univ
    rcases hO_mem with ⟨O, hO_aff, rfl⟩
    exact ⟨O, hO_aff, hxO⟩
  choose O_pt hO_aff hx_O using hAffOpenPt
  have hCoverU : Set.univ ⊆ ⋃ x : ↥U.left, (O_pt x : Set ↥U.left) :=
    fun x _ => Set.mem_iUnion.mpr ⟨x, hx_O x⟩
  obtain ⟨s_U, hs_U⟩ := isCompact_univ.elim_finite_subcover
    (fun x => (O_pt x : Set ↥U.left)) (fun x => (O_pt x).isOpen) hCoverU
  let m := s_U.card
  let e_U : Fin m ≃ ↥s_U := s_U.equivFin.symm
  let W_open : Fin m → U.left.Opens := fun a => O_pt (e_U a).1
  have : AlgebraicGeometry.Etale U.hom := U.prop
  let E : Fin m → S.Etale := fun a =>
    CategoryTheory.MorphismProperty.Over.mk ⊤ ((W_open a).ι ≫ U.hom) (by infer_instance)
  let h : ∀ a : Fin m, E a ⟶ U := fun a =>
    CategoryTheory.MorphismProperty.Over.homMk (W_open a).ι rfl
  have hCovU : CategoryTheory.Sieve.ofArrows E h ∈ S.smallEtaleTopology U := by
    rw [hMemSmallEtale]
    intro x
    have hx_mem := hs_U (Set.mem_univ x)
    rw [Set.mem_iUnion₂] at hx_mem
    rcases hx_mem with ⟨p, hp, hx_p⟩
    let a : Fin m := e_U.symm ⟨p, hp⟩
    have ha_eq : (e_U a).1 = p := congrArg Subtype.val (e_U.apply_symm_apply ⟨p, hp⟩)
    have hx_a : x ∈ W_open a := by
      dsimp [W_open]
      rwa [ha_eq]
    exact ⟨E a, h a, ⟨x, hx_a⟩, CategoryTheory.Sieve.ofArrows_mk E h a,
      show AlgebraicGeometry.Etale (W_open a).ι from inferInstance, rfl⟩
  have hAffE : ∀ a : Fin m, AlgebraicGeometry.IsAffine (E a).left :=
    fun a => hO_aff (e_U a).1
  have hAffPB : ∀ a b : Fin m,
      AlgebraicGeometry.IsAffine (CategoryTheory.Limits.pullback (h a) (h b)).left := by
    intro a b
    let Fgt₁ : S.Etale ⥤ CategoryTheory.Over S := AlgebraicGeometry.Scheme.Etale.forget S
    let Fgt₂ : CategoryTheory.Over S ⥤ AlgebraicGeometry.Scheme.{u} :=
      CategoryTheory.Over.forget S
    have : CategoryTheory.Limits.PreservesLimitsOfShape
        CategoryTheory.Limits.WalkingCospan Fgt₁ := by
      dsimp [Fgt₁]
      infer_instance
    have : CategoryTheory.Limits.PreservesLimitsOfShape
        CategoryTheory.Limits.WalkingCospan Fgt₂ := by
      dsimp [Fgt₂]
      infer_instance
    have : CategoryTheory.Limits.PreservesLimitsOfShape CategoryTheory.Limits.WalkingCospan
        (Fgt₁ ⋙ Fgt₂) :=
      CategoryTheory.Limits.comp_preservesLimitsOfShape Fgt₁ Fgt₂
    have : AlgebraicGeometry.IsAffine (E a).left := hAffE a
    have : AlgebraicGeometry.IsAffine (E b).left := hAffE b
    have : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from U.left) :=
      (AlgebraicGeometry.Scheme.isSeparated_iff U.left).mp inferInstance
    have hCompTerm : CategoryTheory.CategoryStruct.comp (h b).left
        (CategoryTheory.Limits.terminal.from U.left) =
        CategoryTheory.Limits.terminal.from (E b).left :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    have : AlgebraicGeometry.IsAffineHom
        (CategoryTheory.CategoryStruct.comp (h b).left
          (CategoryTheory.Limits.terminal.from U.left)) := by
      rw [hCompTerm]
      infer_instance
    have : AlgebraicGeometry.IsAffineHom (h b).left :=
      AlgebraicGeometry.IsAffineHom.of_comp (h b).left (CategoryTheory.Limits.terminal.from U.left)
    have hAffPullSch : AlgebraicGeometry.IsAffine
        (CategoryTheory.Limits.pullback (h a).left (h b).left) :=
      AlgebraicGeometry.isAffine_of_isAffineHom
        (CategoryTheory.Limits.pullback.fst (h a).left (h b).left)
    let isoPB : (Fgt₁ ⋙ Fgt₂).obj (CategoryTheory.Limits.pullback (h a) (h b)) ≅
        CategoryTheory.Limits.pullback ((Fgt₁ ⋙ Fgt₂).map (h a)) ((Fgt₁ ⋙ Fgt₂).map (h b)) :=
      CategoryTheory.Limits.PreservesPullback.iso (Fgt₁ ⋙ Fgt₂) (h a) (h b)
    have : AlgebraicGeometry.IsAffine
        (CategoryTheory.Limits.pullback ((Fgt₁ ⋙ Fgt₂).map (h a)) ((Fgt₁ ⋙ Fgt₂).map (h b))) :=
      hAffPullSch
    change AlgebraicGeometry.IsAffine
      ((Fgt₁ ⋙ Fgt₂).obj (CategoryTheory.Limits.pullback (h a) (h b)))
    exact AlgebraicGeometry.IsAffine.of_isIso isoPB.hom

  
  have : CategoryTheory.Limits.ReflectsColimitsOfShape Idx
      (CategoryTheory.forget AddCommGrpCat.{u}) :=
    CategoryTheory.Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
  refine ⟨CategoryTheory.Limits.isColimitOfReflects (CategoryTheory.forget AddCommGrpCat.{u}) ?_⟩
  let W_fgt := (CategoryTheory.Functor.whiskeringRight (S.Etale)ᵒᵖ AddCommGrpCat.{u} (Type u)).obj
    (CategoryTheory.forget AddCommGrpCat.{u})
  let c_sh := (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).mapCocone c
  let M : CategoryTheory.Functor Idx ((S.Etale)ᵒᵖ ⥤ Type u) :=
    (D ⋙ CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}) ⋙ W_fgt
  let γ : CategoryTheory.Limits.Cocone M := W_fgt.mapCocone c_sh
  have hIsoEvalType : ∀ (Z : S.Etale),
      (CategoryTheory.forget AddCommGrpCat.{u}).mapCocone
        ((CategoryTheory.Functor.comp
          (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u})
          ((CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).obj
            (Opposite.op Z))).mapCocone c) ≅
      (((CategoryTheory.evaluation (S.Etale)ᵒᵖ (Type u)).obj (Opposite.op Z)).mapCocone γ) := by
    intro Z
    let evalZ := (CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op Z)
    let iso₁ : evalZ.mapCocone c_sh ≅
        (CategoryTheory.Functor.comp
          (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u})
          evalZ).mapCocone c :=
      CategoryTheory.Functor.mapCoconeMapCocone c
    let iso₂ : (CategoryTheory.forget AddCommGrpCat.{u}).mapCocone (evalZ.mapCocone c_sh) ≅
        (((CategoryTheory.evaluation (S.Etale)ᵒᵖ (Type u)).obj (Opposite.op Z)).mapCocone γ) :=
      (CategoryTheory.Functor.mapCoconeMapCocone c_sh).trans
        (CategoryTheory.Functor.mapCoconeMapCocone c_sh).symm
    exact ((CategoryTheory.Limits.Cocone.functoriality _
      (CategoryTheory.forget AddCommGrpCat.{u})).mapIso iso₁.symm).trans iso₂
  have hColimTypeZ : ∀ (Z : S.Etale) [AlgebraicGeometry.IsAffine Z.left],
      CategoryTheory.Limits.IsColimit
        (((CategoryTheory.evaluation (S.Etale)ᵒᵖ (Type u)).obj (Opposite.op Z)).mapCocone γ) := by
    intro Z _
    have hZ := CategoryTheory.Limits.isColimitOfPreserves
      (CategoryTheory.forget AddCommGrpCat.{u}) (hAffEval Z)
    exact CategoryTheory.Limits.IsColimit.ofIsoColimit hZ (hIsoEvalType Z)
  have hSheafM : ∀ j : Idx, CategoryTheory.Presieve.IsSheafFor (M.obj j)
      (CategoryTheory.Presieve.ofArrows E h) := by
    intro j
    exact (CategoryTheory.Presieve.isSheafFor_iff_generate
      (CategoryTheory.Presieve.ofArrows E h)).mpr
      (hSheafToTypes S.smallEtaleTopology (D.obj j) _ hCovU)
  have hSheafPt : CategoryTheory.Presieve.IsSheafFor γ.pt
      (CategoryTheory.Presieve.ofArrows E h) :=
    (CategoryTheory.Presieve.isSheafFor_iff_generate
      (CategoryTheory.Presieve.ofArrows E h)).mpr
      (hSheafToTypes S.smallEtaleTopology c.pt _ hCovU)
  obtain ⟨hGlueLift, hGlueEq⟩ := hTypeCoverGlue M γ U m E h hSheafM
    (fun a => @hColimTypeZ (E a) (hAffE a))
    (fun a b => @hColimTypeZ (CategoryTheory.Limits.pullback (h a) (h b)) (hAffPB a b))
  have hColimTypeU : CategoryTheory.Limits.IsColimit
      (((CategoryTheory.evaluation (S.Etale)ᵒᵖ (Type u)).obj (Opposite.op U)).mapCocone γ) := by
    refine CategoryTheory.Limits.Types.FilteredColimit.isColimitOf' _ _ (fun t => ?_)
      (fun j₀ s₁ s₂ hs => ?_)
    · let y : ∀ a : Fin m, γ.pt.obj (Opposite.op (E a)) := fun a => γ.pt.map (h a).op t
      have hy : CategoryTheory.Presieve.Arrows.PullbackCompatible γ.pt h y := by
        intro a b
        dsimp [y]
        rw [← ConcreteCategory.comp_apply, ← γ.pt.map_comp, ← op_comp,
          CategoryTheory.Limits.pullback.condition, op_comp, γ.pt.map_comp,
          ConcreteCategory.comp_apply]
      obtain ⟨j₂, s₂, hs₂⟩ := hGlueLift y hy
      obtain ⟨_, _, hUniq⟩ :=
        (CategoryTheory.Presieve.isSheafFor_arrows_iff_pullbacks γ.pt h).mp hSheafPt y hy
      refine ⟨j₂, s₂, ?_⟩
      exact (hUniq t (fun _ => rfl)).trans
        (hUniq ((γ.ι.app j₂).app (Opposite.op U) s₂) hs₂).symm
    · refine hGlueEq j₀ s₁ s₂ (fun a => ?_)
      have hnat₁ := CategoryTheory.ConcreteCategory.congr_hom
        ((γ.ι.app j₀).naturality (h a).op) s₁
      have hnat₂ := CategoryTheory.ConcreteCategory.congr_hom
        ((γ.ι.app j₀).naturality (h a).op) s₂
      dsimp at hnat₁ hnat₂ hs
      rw [hnat₁, hs, ← hnat₂]
  exact CategoryTheory.Limits.IsColimit.ofIsoColimit hColimTypeU (hIsoEvalType U).symm

theorem weil_alt_cd_qcsep_single_affine_etale_cover_and_nerve (S : AlgebraicGeometry.Scheme.{u})
    (U : S.Etale) [CompactSpace ↥U.left] [U.left.IsSeparated] :
    (∀ (ℐ 𝒬 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (π : ℐ ⟶ 𝒬) [CategoryTheory.Epi π]
        (q₀ : ↥(𝒬.obj.obj (Opposite.op U))),
      ∃ (W : S.Etale) (_ : AlgebraicGeometry.IsAffine W.left) (f : W ⟶ U)
        (x₀ : ↥(ℐ.obj.obj (Opposite.op ((CategoryTheory.Arrow.mk f).cechNerve.obj
          (Opposite.op (SimplexCategory.mk 0)))))),
        CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton f) ∈
          S.smallEtaleTopology U ∧
        (π.hom.app (Opposite.op ((CategoryTheory.Arrow.mk f).cechNerve.obj
          (Opposite.op (SimplexCategory.mk 0))))).hom x₀ =
          (𝒬.obj.map (((CategoryTheory.Arrow.mk f).augmentedCechNerve.hom.app
            (Opposite.op (SimplexCategory.mk 0)))).op).hom q₀) ∧
    (∀ (W : S.Etale) [AlgebraicGeometry.IsAffine W.left] (f : W ⟶ U) (n : ℕ),
      CompactSpace ↥((CategoryTheory.Arrow.mk f).cechNerve.obj
        (Opposite.op (SimplexCategory.mk n))).left ∧
      ((CategoryTheory.Arrow.mk f).cechNerve.obj
        (Opposite.op (SimplexCategory.mk n))).left.IsSeparated) ∧
    (∀ (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (W : S.Etale) (f : W ⟶ U),
      CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton f) ∈
        S.smallEtaleTopology U →
      let C_𝒢 := AlgebraicTopology.AlternatingCofaceMapComplex.obj
        (CategoryTheory.opOp SimplexCategory ⋙ (CategoryTheory.Arrow.mk f).cechNerve.op ⋙ 𝒢.obj)
      let aug₀ := (CategoryTheory.Arrow.mk f).augmentedCechNerve.hom.app
        (Opposite.op (SimplexCategory.mk 0))
      Function.Injective (𝒢.obj.map aug₀.op).hom ∧
      ∀ x : ↥(C_𝒢.X 0), (C_𝒢.d 0 1).hom x = 0 →
        ∃ s : ↥(𝒢.obj.obj (Opposite.op U)), (𝒢.obj.map aug₀.op).hom s = x) :=
by
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have hMemJ : ∀ {X : S.Etale} (R : CategoryTheory.Sieve X),
      R ∈ S.smallEtaleTopology X ↔
        ∀ x : ↥X.left, ∃ (Y : S.Etale) (g : Y ⟶ X) (y : ↥Y.left),
          R.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left y = x := by
    intro X R
    let X' : P_et.Over ⊤ S := X
    let R' : CategoryTheory.Sieve X' := R
    change R' ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et S X' ↔ _
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) S le_rfl]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology X' R'

  refine ⟨?_, ?_, ?_⟩
  · 
    intro ℐ 𝒬 π _ q₀
    have : CategoryTheory.Sheaf.IsLocallySurjective π :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} π).mpr inferInstance
    have hImgMem : CategoryTheory.Presheaf.imageSieve π.hom q₀ ∈ S.smallEtaleTopology U :=
      CategoryTheory.Presheaf.imageSieve_mem S.smallEtaleTopology π.hom q₀
    have hPt : ∀ u : ↥U.left,
        ∃ (Z : S.Etale) (_ : AlgebraicGeometry.IsAffine Z.left) (h : Z ⟶ U)
          (z : ↥Z.left) (s : ↥(ℐ.obj.obj (Opposite.op Z))),
          AlgebraicGeometry.Etale h.left ∧
          h.left z = u ∧
          (π.hom.app (Opposite.op Z)).hom s = (𝒬.obj.map h.op).hom q₀ := by
      intro u
      obtain ⟨Y_u, g_u, y_u, hg_sieve, hg_et, hy_u⟩ := (hMemJ _).mp hImgMem u
      let 𝒜 := Y_u.left.affineCover
      let i_u : 𝒜.I₀ := 𝒜.idx y_u
      obtain ⟨z_u, hz_u⟩ := 𝒜.covers y_u
