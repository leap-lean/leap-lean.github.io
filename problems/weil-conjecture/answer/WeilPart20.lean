    weil_etale_open_extensionByZero_and_finite_baseChange k₀ ℓ hPBC₀ V₀
      (⊤ : TopologicalSpace.Closeds ↥V₀.left) U₂ Y' ν hFin_ν C_bad hC_bad_eq

  
  have hNotIsoW' : ¬ CategoryTheory.IsIso iW' := by
    intro hIsoW'
    have hZero_S₀X₁ : CategoryTheory.Limits.IsZero S₀.X₁ :=
      hIsoW'_zero Y W' iW' hIsoW' S₀ hS₀_ex hS₀_X₂ hS₀_X₃
    have hZero_TU'_Fl : CategoryTheory.Limits.IsZero
        (T_U' (weilEtaleTorsionSheaf U'.toScheme ℓ)) :=
      hS₀_X₁ ▸ hZero_S₀X₁
    let A_ℓ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    have : NeZero ℓ := ⟨(Fact.out : Nat.Prime ℓ).ne_zero⟩
    have hFinA_ℓ : Finite A_ℓ := by
      change Finite (ULift.{u, 0} (ZMod ℓ))
      infer_instance
    have hTorA_ℓ : ℓ • CategoryTheory.CategoryStruct.id A_ℓ = 0 := by
      ext ⟨x⟩
      change ULift.up (ℓ • x) = ULift.up 0
      rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    let ℒ₀ := weilEtaleTorsionSheaf U₂.toScheme ℓ
    obtain ⟨ℳ₀, m₀, 𝒩₀, hPull_ℳ₀, ⟨i_L₀, r_L₀, hRet_L₀⟩, hN₀_0, hN₀_m, hN₀_step⟩ :=
      weil_etale_sylow_trace_retract_and_pgroup_filtration ℓ
        U₂.toScheme U'.toScheme U'' (ν ∣_ U₂) π'
        hEt_νU₂ hSurj_νU₂ hIntU'' hEt_π' hSurj_π'
        I_G S_idx H hCoprime hPGrp actG secS γ_G hSec hPerm hγG hCovG
        actH γ_H hActH_hom hActH_one hActH_mul hγH hCovH
        A_ℓ hFinA_ℓ hTorA_ℓ ℒ₀ (hTorConst U₂.toScheme)
        (hPullConst (π' ≫ (ν ∣_ U₂)) A_ℓ)
    have hZero_filt₀ : ∀ k : Fin (m₀ + 1), CategoryTheory.Limits.IsZero (T_U' (𝒩₀ k)) := by
      intro k
      induction k using Fin.induction with
      | zero => exact (hTU'_basic (𝒩₀ 0) (𝒩₀ 0)).1 hN₀_0
      | succ r ih =>
        obtain ⟨S_r, hSr_ex, hSr_X₁, hSr_X₂, hSr_X₃⟩ := hN₀_step r
        obtain ⟨S'_r, hS'r_ex, hS'r_X₁, hS'r_X₂, hS'r_X₃⟩ := hTU'_exact S_r hSr_ex
        have hZ1 : CategoryTheory.Limits.IsZero S'_r.X₁ := by
          rw [hS'r_X₁, hSr_X₁]; exact ih
        have hZ3 : CategoryTheory.Limits.IsZero S'_r.X₃ := by
          rw [hS'r_X₃, hSr_X₃]; exact hZero_TU'_Fl
        have hZ2 : CategoryTheory.Limits.IsZero S'_r.X₂ :=
          ((hExtProps Y').2.2.2 S'_r hS'r_ex).1 hZ1 hZ3
        rwa [hS'r_X₂, hSr_X₂] at hZ2
    obtain ⟨e_last₀⟩ := (hTU'_basic (𝒩₀ (Fin.last m₀)) ℳ₀).2.2 hN₀_m
    have hZero_TU'M₀ : CategoryTheory.Limits.IsZero (T_U' ℳ₀) :=
      CategoryTheory.Limits.IsZero.of_iso (hZero_filt₀ (Fin.last m₀)) e_last₀.symm
    have hTor_M₀ : ℓ • CategoryTheory.CategoryStruct.id ℳ₀ = 0 :=
      hTorOfPull (ν ∣_ U₂) ℒ₀ ℳ₀ (hTorConst U₂.toScheme) hPull_ℳ₀
    obtain ⟨e_bc₀⟩ := hBC_ν ℳ₀ hTor_M₀
    have hZero_TU₂_R0M₀ : CategoryTheory.Limits.IsZero
        (T_U₂ (weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ₀)) :=
      CategoryTheory.Limits.IsZero.of_iso ((hDir0Props ν (T_U' ℳ₀)).1 hZero_TU'M₀) e_bc₀.symm
    obtain ⟨i₀, r₀_ret, hRet₀⟩ :=
      hTU₂_retract ℒ₀ (weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ₀) ⟨i_L₀, r_L₀, hRet_L₀⟩
    have hZero_TU₂L₀ : CategoryTheory.Limits.IsZero (T_U₂ ℒ₀) := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero, ← hRet₀,
        hZero_TU₂_R0M₀.eq_of_tgt i₀ 0, CategoryTheory.Limits.zero_comp]
    have hZero_R0_TU₂L₀ : CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage iY₀ 0 (T_U₂ ℒ₀)) :=
      (hDir0Props iY₀ (T_U₂ ℒ₀)).1 hZero_TU₂L₀
    have hConstr_Fl : WeilIsConstructibleModPrimeSheaf ℓ V₀.left
        (weilEtaleTorsionSheaf V₀.left ℓ) :=
      (weil_etale_constructible_mod_prime_extraction_over_algClosed k₀ V₀ ℓ 0).1
    obtain ⟨S_Fl, hSFl_ex, hSFl_X₁, hSFl_X₂, hSFl_X₃⟩ :=
      hExc_V₀ (weilEtaleTorsionSheaf V₀.left ℓ) (weilEtaleTorsionSheaf Z_bad ℓ) ℒ₀
        hConstr_Fl (hVacTop (weilEtaleTorsionSheaf V₀.left ℓ))
        (hPullConst iC_bad A_ℓ) (hPullConst (U₂.ι ≫ iY₀) A_ℓ)
    have hZero_SFlX₁ : CategoryTheory.Limits.IsZero S_Fl.X₁ := hSFl_X₁ ▸ hZero_R0_TU₂L₀
    have hf0_Fl : S_Fl.f = 0 := hZero_SFlX₁.eq_of_src S_Fl.f 0
    have : CategoryTheory.Mono S_Fl.g := hSFl_ex.exact.mono_g_iff.mpr hf0_Fl
    have : CategoryTheory.Epi S_Fl.g := hSFl_ex.epi_g
    have hIso_gFl : CategoryTheory.IsIso S_Fl.g :=
      CategoryTheory.isIso_of_mono_of_epi S_Fl.g
    let e_Fl_bad : weilEtaleTorsionSheaf V₀.left ℓ ≅
        weilEtaleHigherDirectImage iC_bad 0 (weilEtaleTorsionSheaf Z_bad ℓ) :=
      (CategoryTheory.eqToIso hSFl_X₂).symm ≪≫
        @CategoryTheory.asIso _ _ _ _ S_Fl.g hIso_gFl ≪≫
        CategoryTheory.eqToIso hSFl_X₃
    exact hNonIso_bad V₀ C_bad hC_bad_ne ⟨e_Fl_bad⟩

  
  obtain ⟨hPropW', hDimW'⟩ := hW'_gen Y hIntY' hDimY W' iW' hClW' hNotIsoW'
  let W'_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)) :=
    CategoryTheory.Over.mk (iW' ≫ Y.hom)
  have : AlgebraicGeometry.IsProper W'_ov.hom := hPropW'
  have : AlgebraicGeometry.IsClosedImmersion iW' := hClW'
  have hSub_W'_r₀ : Subsingleton ((weilEtaleTorsionSheaf W' ℓ).H r₀) :=
    hSubDim W'_ov hDimW' r₀ hr₀_gt (weilEtaleTorsionSheaf W' ℓ) (hTorConst W')
  let iW'_ov : W'_ov ⟶ Y := CategoryTheory.Over.homMk iW' rfl
  have hAcyc_iW' : ∀ b : ℕ, CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage iW' (b + 1) (weilEtaleTorsionSheaf W' ℓ)) :=
    hFinAcyclic W'_ov Y iW'_ov (show AlgebraicGeometry.IsFinite iW' from inferInstance)
      (weilEtaleTorsionSheaf W' ℓ) (hTorConst W')
  have hSub_S₀X₃_r₀ : Subsingleton (S₀.X₃.H r₀) := by
    rw [hS₀_X₃]
    exact (hDir0Props iW' (weilEtaleTorsionSheaf W' ℓ)).2 hAcyc_iW' r₀ hSub_W'_r₀
  have hSub_S₀X₂_r₀1 : Subsingleton (S₀.X₂.H (r₀ + 1)) := by
    rw [hS₀_X₂, hr₀_eq]
    exact hVanishConstY'
  have hVanishTU'_Fl : Subsingleton ((T_U' (weilEtaleTorsionSheaf U'.toScheme ℓ)).H q) := by
    have h1 := ((hExtProps Y').2.2.2 S₀ hS₀_ex).2.2 r₀ hSub_S₀X₃_r₀ hSub_S₀X₂_r₀1
    rwa [hS₀_X₁, hr₀_eq] at h1

  
  obtain ⟨ℒ, hPull_L, hTor_L_imp, -⟩ := hPullEx (U₂.ι ≫ iY₀) ℱ₀
  have hTor_L : ℓ • CategoryTheory.CategoryStruct.id ℒ = 0 := hTor_L_imp hTorℱ₀
  obtain ⟨F_bad₀, hPull_bad, hTor_bad_imp, -⟩ := hPullEx iC_bad ℱ₀
  have hTor_bad : ℓ • CategoryTheory.CategoryStruct.id F_bad₀ = 0 := hTor_bad_imp hTorℱ₀

  have hPull_q₀_F₀ : WeilIsEtaleSheafPullback (q₀ ≫ (p₀ ≫ (U₀.ι ≫ iY₀))) ℱ₀
      ((CategoryTheory.constantSheaf U''.smallEtaleTopology AddCommGrpCat.{u}).obj A) :=
    (hPullComp q₀ (p₀ ≫ (U₀.ι ≫ iY₀)) ℱ₀ _ _).1 hPull_p₀ (hPullConst q₀ A)
  have hMor_eq : (π' ≫ (ν ∣_ U₂)) ≫ (U₂.ι ≫ iY₀) = q₀ ≫ (p₀ ≫ (U₀.ι ≫ iY₀)) := by
    calc
      (π' ≫ (ν ∣_ U₂)) ≫ (U₂.ι ≫ iY₀) = ((π' ≫ (ν ∣_ U₂)) ≫ U₂.ι) ≫ iY₀ :=
        (CategoryTheory.Category.assoc _ _ _).symm
      _ = (q₀ ≫ p₀ ≫ U₀.ι) ≫ iY₀ := by rw [hComm_q₀]
      _ = q₀ ≫ (p₀ ≫ (U₀.ι ≫ iY₀)) := by simp only [CategoryTheory.Category.assoc]
  have hPull_comp_F₀ : WeilIsEtaleSheafPullback ((π' ≫ (ν ∣_ U₂)) ≫ (U₂.ι ≫ iY₀)) ℱ₀
      ((CategoryTheory.constantSheaf U''.smallEtaleTopology AddCommGrpCat.{u}).obj A) := by
    rwa [hMor_eq]
  have hTriv_L : WeilIsEtaleSheafPullback (π' ≫ (ν ∣_ U₂)) ℒ
      ((CategoryTheory.constantSheaf U''.smallEtaleTopology AddCommGrpCat.{u}).obj A) :=
    (hPullComp (π' ≫ (ν ∣_ U₂)) (U₂.ι ≫ iY₀) ℱ₀ ℒ _).2 hPull_L hPull_comp_F₀

  obtain ⟨ℳ, m, 𝒩, hPull_ℳ, ⟨i_L, r_L, hRet_L⟩, hN_0, hN_m, hN_step⟩ :=
    weil_etale_sylow_trace_retract_and_pgroup_filtration ℓ
      U₂.toScheme U'.toScheme U'' (ν ∣_ U₂) π'
      hEt_νU₂ hSurj_νU₂ hIntU'' hEt_π' hSurj_π'
      I_G S_idx H hCoprime hPGrp actG secS γ_G hSec hPerm hγG hCovG
      actH γ_H hActH_hom hActH_one hActH_mul hγH hCovH
      A hFinA hTorA ℒ hTor_L hTriv_L

  
  have hSub_filt : ∀ k : Fin (m + 1), Subsingleton ((T_U' (𝒩 k)).H q) := by
    intro k
    induction k using Fin.induction with
    | zero =>
      exact (hExtProps Y').1 (T_U' (𝒩 0)) q ((hTU'_basic (𝒩 0) (𝒩 0)).1 hN_0)
    | succ r ih =>
      obtain ⟨S_r, hSr_ex, hSr_X₁, hSr_X₂, hSr_X₃⟩ := hN_step r
      obtain ⟨S'_r, hS'r_ex, hS'r_X₁, hS'r_X₂, hS'r_X₃⟩ := hTU'_exact S_r hSr_ex
      have hSub1 : Subsingleton (S'_r.X₁.H q) := by rw [hS'r_X₁, hSr_X₁]; exact ih
      have hSub3 : Subsingleton (S'_r.X₃.H q) := by
        rw [hS'r_X₃, hSr_X₃]; exact hVanishTU'_Fl
      have hSub2 : Subsingleton (S'_r.X₂.H q) :=
        ((hExtProps Y').2.2.2 S'_r hS'r_ex).2.1 q hSub1 hSub3
      rwa [hS'r_X₂, hSr_X₂] at hSub2
  have hSub_TU'M : Subsingleton ((T_U' ℳ).H q) :=
    (hExtProps Y').2.2.1 q
      ((hTU'_basic ℳ (𝒩 (Fin.last m))).2.2 ⟨hN_m.some.symm⟩)
      (hSub_filt (Fin.last m))

  
  have hTor_M : ℓ • CategoryTheory.CategoryStruct.id ℳ = 0 :=
    hTorOfPull (ν ∣_ U₂) ℒ ℳ hTor_L hPull_ℳ
  have hTor_TU'M : ℓ • CategoryTheory.CategoryStruct.id (T_U' ℳ) = 0 :=
    (hTU'_basic ℳ ℳ).2.1 hTor_M
  let Y₀_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)) :=
    CategoryTheory.Over.mk (iY₀ ≫ V₀.hom)
  have : AlgebraicGeometry.LocallyOfFiniteType Y₀_ov.hom := by
    change AlgebraicGeometry.LocallyOfFiniteType (iY₀ ≫ V₀.hom)
    infer_instance
  let ν_ov : Y ⟶ Y₀_ov :=
    CategoryTheory.Over.homMk ν (CategoryTheory.Category.assoc _ _ _).symm
  have hAcyc_ν : ∀ b : ℕ, CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage ν (b + 1) (T_U' ℳ)) :=
    hFinAcyclic Y Y₀_ov ν_ov hFin_ν (T_U' ℳ) hTor_TU'M
  have hSub_R0_TU'M : Subsingleton ((weilEtaleHigherDirectImage ν 0 (T_U' ℳ)).H q) :=
    (hDir0Props ν (T_U' ℳ)).2 hAcyc_ν q hSub_TU'M
  obtain ⟨e_bc⟩ := hBC_ν ℳ hTor_M
  have hSub_TU₂_R0M : Subsingleton
      ((T_U₂ (weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ)).H q) :=
    (hExtProps Y₀).2.2.1 q ⟨e_bc.symm⟩ hSub_R0_TU'M
  have hTor_R0_TU'M : ℓ • CategoryTheory.CategoryStruct.id
      (weilEtaleHigherDirectImage ν 0 (T_U' ℳ)) = 0 :=
    hTorPush Y' Y₀ ν 0 (T_U' ℳ) hTor_TU'M
  have hTor_TU₂_R0M : ℓ • CategoryTheory.CategoryStruct.id
      (T_U₂ (weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ)) = 0 :=
    hTorOfIso ⟨e_bc.symm⟩ hTor_R0_TU'M
  obtain ⟨i₀_L, r₀_L, hRet_TU₂L⟩ :=
    hTU₂_retract ℒ (weilEtaleHigherDirectImage (ν ∣_ U₂) 0 ℳ) ⟨i_L, r_L, hRet_L⟩
  have hSub_TU₂L : Subsingleton ((T_U₂ ℒ).H q) :=
    (hExtProps Y₀).2.1 i₀_L r₀_L q hRet_TU₂L hSub_TU₂_R0M
  have hTor_TU₂L : ℓ • CategoryTheory.CategoryStruct.id (T_U₂ ℒ) = 0 := by
    calc
      ℓ • CategoryTheory.CategoryStruct.id (T_U₂ ℒ)
          = ℓ • (i₀_L ≫ 𝟙 _ ≫ r₀_L) := by
            rw [CategoryTheory.Category.id_comp, hRet_TU₂L]
      _ = i₀_L ≫ (ℓ • 𝟙 _) ≫ r₀_L := by
            rw [← CategoryTheory.Preadditive.comp_nsmul,
              ← CategoryTheory.Preadditive.nsmul_comp]
      _ = 0 := by
            rw [hTor_TU₂_R0M, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

  
  let iY₀_ov : Y₀_ov ⟶ V₀ := CategoryTheory.Over.homMk iY₀ rfl
  have hAcyc_iY₀ : ∀ b : ℕ, CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage iY₀ (b + 1) (T_U₂ ℒ)) :=
    hFinAcyclic Y₀_ov V₀ iY₀_ov (show AlgebraicGeometry.IsFinite iY₀ from inferInstance)
      (T_U₂ ℒ) hTor_TU₂L
  have hSub_R0_TU₂L : Subsingleton ((weilEtaleHigherDirectImage iY₀ 0 (T_U₂ ℒ)).H q) :=
    (hDir0Props iY₀ (T_U₂ ℒ)).2 hAcyc_iY₀ q hSub_TU₂L

  let Z_bad_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)) :=
    CategoryTheory.Over.mk (iC_bad ≫ V₀.hom)
  have : AlgebraicGeometry.IsProper Z_bad_ov.hom := hProp_bad
  have hSub_Fbad : Subsingleton (F_bad₀.H q) :=
    hSubDim Z_bad_ov hDim_bad q hq_gt F_bad₀ hTor_bad
  let iC_bad_ov : Z_bad_ov ⟶ V₀ := CategoryTheory.Over.homMk iC_bad rfl
  have hAcyc_iCbad : ∀ b : ℕ, CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage iC_bad (b + 1) F_bad₀) :=
    hFinAcyclic Z_bad_ov V₀ iC_bad_ov (show AlgebraicGeometry.IsFinite iC_bad from inferInstance)
      F_bad₀ hTor_bad
  have hSub_R0_Fbad : Subsingleton ((weilEtaleHigherDirectImage iC_bad 0 F_bad₀).H q) :=
    (hDir0Props iC_bad F_bad₀).2 hAcyc_iCbad q hSub_Fbad

  obtain ⟨S_F, hSF_ex, hSF_X₁, hSF_X₂, hSF_X₃⟩ :=
    hExc_V₀ ℱ₀ F_bad₀ ℒ ⟨hTorℱ₀, hGenℱ₀⟩ (hVacTop ℱ₀) hPull_bad hPull_L
  have hSub_SF_X₁ : Subsingleton (S_F.X₁.H q) := hSF_X₁.symm ▸ hSub_R0_TU₂L
  have hSub_SF_X₃ : Subsingleton (S_F.X₃.H q) := hSF_X₃.symm ▸ hSub_R0_Fbad
  have hSub_SF_X₂ : Subsingleton (S_F.X₂.H q) :=
    ((hExtProps V₀.left).2.2.2 S_F hSF_ex).2.1 q hSub_SF_X₁ hSub_SF_X₃
  rwa [hSF_X₂] at hSub_SF_X₂

theorem weil_etale_curve_fibration_three_step_leray_vanishing (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC₀ : WeilProperModPrimeBaseChangeHolds k₀ ℓ)
    (V₁ B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
    [AlgebraicGeometry.LocallyOfFiniteType B₀.hom]
    (f₁ : V₁ ⟶ B₀)
    (hf₁_prop : AlgebraicGeometry.IsProper f₁.left)
    (hFibVanish : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ B₀.left)
      (b : ℕ), 3 ≤ b →
      Subsingleton (weilEtaleTorsionH (CategoryTheory.Limits.pullback f₁.left s) ℓ b))
    (m' : ℕ) (hm' : 1 ≤ m')
    (hBaseVanish : ∀ (r : ℕ), 2 * m' < r →
      ∀ (𝒜 : CategoryTheory.Sheaf B₀.left.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id 𝒜 = 0 → Subsingleton (𝒜.H r))
    (q : ℕ) (hq : 2 * (m' + 1) < q) :
    Subsingleton (weilEtaleTorsionH V₁.left ℓ q) :=
by
  have h_AB1 :
      (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
        ∃ (hc : (weilEtaleSitePullback h).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology),
          let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilEtaleSitePullback h) AddCommGrpCat.{u} _ X₂.smallEtaleTopology X₁.smallEtaleTopology hc
          P_push.IsRightAdjoint ∧
          ∀ (A : AddCommGrpCat.{u}),
            WeilIsEtaleSheafPullback h
              ((CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj A)
              ((CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj A)) ∧
      (∀ (K : Type u) [Field K] [IsAlgClosed K],
        let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
        (∀ (W : S_K.Etale) (z : ↥W.left),
          ∃ u_z : weilEtaleIdTerminal S_K ⟶ W,
            AlgebraicGeometry.Etale (u_z.left : S_K ⟶ W.left) ∧
            (u_z.left : S_K ⟶ W.left).base ((⊥ : PrimeSpectrum K) : ↥S_K) = z) ∧
        (∀ R ∈ S_K.smallEtaleTopology (weilEtaleIdTerminal S_K), R = ⊤) ∧
        (∀ (Y : AlgebraicGeometry.Scheme.{u}) (p : Y ⟶ S_K)
            (ℱ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}) (b : ℕ),
          Subsingleton (ℱ.H b) →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage p b ℱ))) := by
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have h_mem_etale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (X : S.Etale) (R : CategoryTheory.Sieve X),
        R ∈ S.smallEtaleTopology X ↔
          ∀ (x : ↥X.left), ∃ (Y : S.Etale) (f : Y ⟶ X) (y : ↥Y.left),
            R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
      intro S X R
      have h_eq : (R ∈ S.smallEtaleTopology X) =
          (R ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck X) :=
        congrArg (fun (J : CategoryTheory.GrothendieckTopology S.Etale) => R ∈ J X)
          (AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
            (P := P_et) (Q := P_et) S (le_refl P_et))
      exact (iff_of_eq h_eq).trans
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) (S := S) X R)
