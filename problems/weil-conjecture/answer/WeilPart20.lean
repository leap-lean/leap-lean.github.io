        (congrArg (fun τ => τ.hom z)
          (η_shf₁.naturality (Opposite.op (adj_site.counit.app U)))).symm
      have hUnit_η : ((adj_sh.unit.app 𝒞₁).hom.app (Opposite.op U)).hom
          ((η_shf₁.app (Opposite.op U)).hom z) =
          (η_shf₁.app (Opposite.op (F_M.obj V))).hom z :=
        (congrArg (fun φ => φ.hom ((η_shf₁.app (Opposite.op U)).hom z))
          (hUnit_sh 𝒞₁ U)).trans hNat_η
      have hRHS : (((adj_shf₁.homEquiv P_const₁ (B_M_push.obj (PShf (r₀ + 1))))
          ((adj_sh.homEquiv 𝒞₁ (PShf (r₀ + 1))) (β ≫ ι_std r₀))).app (Opposite.op U)).hom z x i =
          (Fin.cons z.down (0 : Fin r₀ → ZMod ℓ) : Fin (r₀ + 1) → ZMod ℓ) i := by
        rw [@CategoryTheory.Adjunction.homEquiv_unit _ _ _ _ _ _ adj_sh _ _ (β ≫ ι_std r₀)]
        change (((ι_std r₀).hom.app (Opposite.op V)).hom
          ((β.hom.app (Opposite.op V)).hom
            (((adj_sh.unit.app 𝒞₁).hom.app (Opposite.op U)).hom
              ((η_shf₁.app (Opposite.op U)).hom z)))) x i = _
        rw [hUnit_η, hβ_app V z]
        rfl
      have hLHS : (((adj_shf₁.homEquiv P_const₁ (B_M_push.obj (PShf (r₀ + 1))))
          ((adj_sh.homEquiv 𝒞₁ (PShf (r₀ + 1))) (F_M_star.map α ≫ e_sh.hom))).app
          (Opposite.op U)).hom z x i =
          (Fin.cons z.down (0 : Fin r₀ → ZMod ℓ) : Fin (r₀ + 1) → ZMod ℓ) i := by
        rw [@CategoryTheory.Adjunction.homEquiv_unit _ _ _ _ _ _ adj_sh _ _
          (F_M_star.map α ≫ e_sh.hom)]
        change ((e_sh.hom.hom.app (Opposite.op V)).hom
          ((α.hom.app (Opposite.op (F_M.obj V))).hom
            (((adj_sh.unit.app 𝒞₁).hom.app (Opposite.op U)).hom
              ((η_shf₁.app (Opposite.op U)).hom z)))) x i = _
        rw [hUnit_η]
        have hα_V := congrArg (fun τ => (τ.app (Opposite.op (F_M.obj V))).hom z) hα_unit
        have hα_step : (α.hom.app (Opposite.op (F_M.obj V))).hom
            ((η_shf₁.app (Opposite.op (F_M.obj V))).hom z) =
            (α_pre.app (Opposite.op (F_M.obj V))).hom z := hα_V
        rw [hα_step]
        have hFrom_eq : hT₁.from (F_M.obj V) = F_M.map (hT_M.from V) ≫ u_M :=
          hT₁.hom_ext _ _
        have hα_pre_val : (α_pre.app (Opposite.op (F_M.obj V))).hom z =
            (ℱ₁.obj.map (Opposite.op (F_M.map (hT_M.from V)))).hom (z.down.val • w₀) := by
          have hmap_u : (ℱ₁.obj.map (Opposite.op (hT₁.from (F_M.obj V)))).hom (z.down.val • s₀) =
              (ℱ₁.obj.map (Opposite.op (F_M.map (hT_M.from V)))).hom
                ((ℱ₁.obj.map (Opposite.op u_M)).hom (z.down.val • s₀)) := by
            rw [hFrom_eq]
            exact congrArg (fun τ => τ.hom (z.down.val • s₀))
              (ℱ₁.obj.map_comp (Opposite.op u_M) (Opposite.op (F_M.map (hT_M.from V))))
          exact hmap_u.trans
            (congrArg (ℱ₁.obj.map (Opposite.op (F_M.map (hT_M.from V)))).hom
              (map_nsmul ((ℱ₁.obj.map (Opposite.op u_M)).hom) z.down.val s₀))
        rw [hα_pre_val]
        have he_sh : e_sh.hom.hom = e₀.hom ≫ Θ.hom :=
          (CategoryTheory.fullyFaithfulSheafToPresheaf J_M AddCommGrpCat.{u}).map_preimage
            (X := F_M_star.obj ℱ₁) (Y := PShf (r₀ + 1)) e.hom
        change (((e_sh.hom.hom).app (Opposite.op V)).hom
          ((ℱ₁.obj.map (Opposite.op (F_M.map (hT_M.from V)))).hom (z.down.val • w₀))) x i = _
        rw [he_sh]
        have he₀_nat := congrArg (fun τ => τ.hom (z.down.val • w₀))
          (e₀.hom.naturality (Opposite.op (hT_M.from V)))
        have he₀_val : (e₀.hom.app (Opposite.op V)).hom
            ((ℱ₁.obj.map (Opposite.op (F_M.map (hT_M.from V)))).hom (z.down.val • w₀)) =
            fun _ => z.down • v₀ := by
          change ((CategoryTheory.Functor.comp F_M.op ℱ₁.obj).map (Opposite.op (hT_M.from V)) ≫
              e₀.hom.app (Opposite.op V)).hom (z.down.val • w₀) = _
          rw [show ((CategoryTheory.Functor.comp F_M.op ℱ₁.obj).map (Opposite.op (hT_M.from V)) ≫
              e₀.hom.app (Opposite.op V)).hom (z.down.val • w₀) =
            ((e₀.hom.app (Opposite.op T_M) ≫
              (weilAltCdDiscreteVecPresheaf S_M ℓ (r₀ + 1)).map
                (Opposite.op (hT_M.from V))).hom) (z.down.val • w₀) from he₀_nat]
          apply funext; intro y; apply funext; intro j
          change ((e₀.hom.app (Opposite.op T_M)).hom (z.down.val • w₀))
              ((hT_M.from V).left.base y) j = (z.down • v₀) j
          rw [map_nsmul, @Subsingleton.elim ↥S_M hSub_SM ((hT_M.from V).left.base y) pt_M]
          change (z.down.val • v₀) j = (z.down • v₀) j
          simp [nsmul_eq_mul]
        change ((Θ.hom.app (Opposite.op V)).hom
          ((e₀.hom.app (Opposite.op V)).hom
            ((ℱ₁.obj.map (Opposite.op (F_M.map (hT_M.from V)))).hom (z.down.val • w₀)))) x i = _
        rw [he₀_val]
        exact congrFun (hΘ V (fun _ => z.down) x) i
      rw [hLHS, hRHS]

    have hMono_α : CategoryTheory.Mono α := by
      refine CategoryTheory.Sheaf.mono_of_injective α (fun U_op a₁ a₂ ha => ?_)
      let U := U_op.unop
      let snd_U := CategoryTheory.Limits.pullback.snd U.hom π_M
      let fst_U := CategoryTheory.Limits.pullback.fst U.hom π_M
      have _ : AlgebraicGeometry.Etale U.hom := U.prop
      have _ : AlgebraicGeometry.Etale π_M := hEtM
      let V_U : S_M.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ snd_U inferInstance
      let p_U : F_M.obj V_U ⟶ U :=
        CategoryTheory.MorphismProperty.Over.homMk fst_U
          (CategoryTheory.Limits.pullback.condition (f := U.hom) (g := π_M))
      apply hInjPull 𝒞₁ U
      have ha_pull : (α.hom.app (Opposite.op (F_M.obj V_U))).hom
          ((𝒞₁.obj.map (Opposite.op p_U)).hom a₁) =
          (α.hom.app (Opposite.op (F_M.obj V_U))).hom
            ((𝒞₁.obj.map (Opposite.op p_U)).hom a₂) := by
        have hnat₁ : (α.hom.app (Opposite.op (F_M.obj V_U))).hom
            ((𝒞₁.obj.map (Opposite.op p_U)).hom a₁) =
            (ℱ₁.obj.map (Opposite.op p_U)).hom ((α.hom.app U_op).hom a₁) :=
          congrArg (fun τ => τ.hom a₁) (α.hom.naturality (Opposite.op p_U))
        have hnat₂ : (α.hom.app (Opposite.op (F_M.obj V_U))).hom
            ((𝒞₁.obj.map (Opposite.op p_U)).hom a₂) =
            (ℱ₁.obj.map (Opposite.op p_U)).hom ((α.hom.app U_op).hom a₂) :=
          congrArg (fun τ => τ.hom a₂) (α.hom.naturality (Opposite.op p_U))
        have hmid : (ℱ₁.obj.map (Opposite.op p_U)).hom ((α.hom.app U_op).hom a₁) =
            (ℱ₁.obj.map (Opposite.op p_U)).hom ((α.hom.app U_op).hom a₂) :=
          congrArg (ℱ₁.obj.map (Opposite.op p_U)).hom ha
        exact hnat₁.trans (hmid.trans hnat₂.symm)
      have hComp_pull := congrArg (fun φ => (φ.hom.app (Opposite.op V_U)).hom) hComm_α
      have hβι_eq : ((β ≫ ι_std r₀).hom.app (Opposite.op V_U)).hom
          ((𝒞₁.obj.map (Opposite.op p_U)).hom a₁) =
          ((β ≫ ι_std r₀).hom.app (Opposite.op V_U)).hom
            ((𝒞₁.obj.map (Opposite.op p_U)).hom a₂) := by
        rw [← hComp_pull]
        exact congrArg (e_sh.hom.hom.app (Opposite.op V_U)).hom ha_pull
      have hβ_eq : (β.hom.app (Opposite.op V_U)).hom ((𝒞₁.obj.map (Opposite.op p_U)).hom a₁) =
          (β.hom.app (Opposite.op V_U)).hom ((𝒞₁.obj.map (Opposite.op p_U)).hom a₂) := by
        apply funext; intro x; apply funext; intro k
        rw [Fin.eq_zero k]
        exact congrFun (congrFun hβι_eq x) 0
      have hInv := congrArg (β_inv.hom.app (Opposite.op V_U)).hom hβ_eq
      have hId₁ := congrArg (fun φ => (φ.hom.app (Opposite.op V_U)).hom
        ((𝒞₁.obj.map (Opposite.op p_U)).hom a₁)) hβ_β_inv
      have hId₂ := congrArg (fun φ => (φ.hom.app (Opposite.op V_U)).hom
        ((𝒞₁.obj.map (Opposite.op p_U)).hom a₂)) hβ_β_inv
      exact hId₁.symm.trans (hInv.trans hId₂)

    let 𝒬₁ := CategoryTheory.Limits.cokernel α
    let π_Q : ℱ₁ ⟶ 𝒬₁ := CategoryTheory.Limits.cokernel.π α
    have hcomp_Q : α ≫ π_Q = 0 := CategoryTheory.Limits.cokernel.condition α
    have hExact₁ : (CategoryTheory.ShortComplex.mk α π_Q hcomp_Q).Exact :=
      CategoryTheory.ShortComplex.exact_of_g_is_cokernel _
        (CategoryTheory.Limits.cokernelIsCokernel α)
    have hSE₁ : (CategoryTheory.ShortComplex.mk α π_Q hcomp_Q).ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' hExact₁ hMono_α inferInstance

    have hℓ_Q : ℓ • CategoryTheory.CategoryStruct.id 𝒬₁ = 0 := by
      rw [← cancel_epi π_Q, CategoryTheory.Preadditive.comp_nsmul, Category.comp_id,
        ← Category.id_comp π_Q, ← CategoryTheory.Preadditive.nsmul_comp, hℓ_1,
        CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

    have hSE_M : ((CategoryTheory.ShortComplex.mk α π_Q hcomp_Q).map F_M_star).ShortExact :=
      hSE₁.map_of_exact F_M_star
    let hc₁ := hSE_M.gIsCokernel
    let hc₂ := (hSE_std r₀).gIsCokernel
    have hCond₁ : ((CategoryTheory.ShortComplex.mk α π_Q hcomp_Q).map F_M_star).f ≫
        (e_sh.hom ≫ π_std r₀) = 0 := by
      change F_M_star.map α ≫ (e_sh.hom ≫ π_std r₀) = 0
      rw [← Category.assoc, hComm_α, Category.assoc, hcomp_std r₀,
        CategoryTheory.Limits.comp_zero]
    have hCond₂ : (CategoryTheory.ShortComplex.mk (ι_std r₀) (π_std r₀) (hcomp_std r₀)).f ≫
        (e_sh.inv ≫ F_M_star.map π_Q) = 0 := by
      change ι_std r₀ ≫ (e_sh.inv ≫ F_M_star.map π_Q) = 0
      have hι_eq : ι_std r₀ ≫ e_sh.inv = β_iso.inv ≫ F_M_star.map α := by
        rw [← cancel_mono e_sh.hom, Category.assoc, e_sh.inv_hom_id, Category.comp_id,
          Category.assoc, hComm_α, ← Category.assoc, β_iso.inv_hom_id, Category.id_comp]
      rw [← Category.assoc, hι_eq, Category.assoc, ← F_M_star.map_comp, hcomp_Q,
        F_M_star.map_zero, CategoryTheory.Limits.comp_zero]
    let cf₁ := CategoryTheory.Limits.CokernelCofork.ofπ (e_sh.hom ≫ π_std r₀) hCond₁
    let cf₂ := CategoryTheory.Limits.CokernelCofork.ofπ (e_sh.inv ≫ F_M_star.map π_Q) hCond₂
    let φ_Q : F_M_star.obj 𝒬₁ ⟶ PShf r₀ := hc₁.desc cf₁
    let ψ_Q : PShf r₀ ⟶ F_M_star.obj 𝒬₁ := hc₂.desc cf₂
    have hπ_φ : F_M_star.map π_Q ≫ φ_Q = e_sh.hom ≫ π_std r₀ :=
      hc₁.fac cf₁ CategoryTheory.Limits.WalkingParallelPair.one
    have hπ_ψ : π_std r₀ ≫ ψ_Q = e_sh.inv ≫ F_M_star.map π_Q :=
      hc₂.fac cf₂ CategoryTheory.Limits.WalkingParallelPair.one
    let e_Q_sh : F_M_star.obj 𝒬₁ ≅ PShf r₀ :=
      { hom := φ_Q
        inv := ψ_Q
        hom_inv_id := CategoryTheory.Limits.Cofork.IsColimit.hom_ext hc₁ (by
          change F_M_star.map π_Q ≫ (φ_Q ≫ ψ_Q) = F_M_star.map π_Q ≫ 𝟙 _
          rw [← Category.assoc, hπ_φ, Category.assoc, hπ_ψ, ← Category.assoc,
            e_sh.hom_inv_id, Category.id_comp, Category.comp_id])
        inv_hom_id := CategoryTheory.Limits.Cofork.IsColimit.hom_ext hc₂ (by
          change π_std r₀ ≫ (ψ_Q ≫ φ_Q) = π_std r₀ ≫ 𝟙 _
          rw [← Category.assoc, hπ_ψ, Category.assoc, hπ_φ, ← Category.assoc,
            e_sh.inv_hom_id, Category.id_comp, Category.comp_id]) }
    have hSplit_Q : Nonempty ((CategoryTheory.Functor.comp F_M.op 𝒬₁.obj) ≅
        weilAltCdDiscreteVecPresheaf S_M ℓ r₀) :=
      ⟨(CategoryTheory.sheafToPresheaf J_M AddCommGrpCat.{u}).mapIso e_Q_sh⟩

    have hSubQ : Subsingleton (𝒬₁.H s) := ih 𝒬₁ hℓ_Q hSplit_Q
    let Fℤ₁ :=
      (CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
    refine subsingleton_of_forall_eq 0 (fun ξ => ?_)
    have hξ_π : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ π_Q) (Nat.add_zero s) = 0 :=
      @Subsingleton.elim (𝒬₁.H s) hSubQ _ 0
    obtain ⟨ξ₀, hξ₀⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ₁ hSE₁ ξ hξ_π
    have hξ₀_zero : ξ₀ = 0 :=
      @Subsingleton.elim (weilEtaleTorsionH S₁ ℓ s) hConst₁ ξ₀ 0
    rw [← hξ₀, hξ₀_zero]
    exact CategoryTheory.Abelian.Ext.zero_comp Fℤ₁ s _ s (Nat.add_zero s)

theorem weil_alt_cd_galois_split_sylow_devissage (K : Type u) [Field K]
    (ℓ s : ℕ) [Fact (Nat.Prime ℓ)] (hs : 1 ≤ s)
    (hConst : ∀ (K₁ : Type u) [Field K₁] [Algebra K K₁] [FiniteDimensional K K₁]
      [Algebra.IsSeparable K K₁],
      Subsingleton (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of K₁)) ℓ s))
    (ℱ : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u})
    (hℓ_ℱ : ℓ • CategoryTheory.CategoryStruct.id ℱ = 0)
    (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M] [IsGalois K M]
    (hEt : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K M))))
    (r : ℕ)
    (hSplit : Nonempty ((CategoryTheory.Functor.comp (weilAltCdFieldEtaleMap hEt).op ℱ.obj) ≅
      weilAltCdDiscreteVecPresheaf (AlgebraicGeometry.Spec (CommRingCat.of M)) ℓ r)) :
    Subsingleton (ℱ.H s) :=
by
  have hPrime : Nat.Prime ℓ := Fact.out
  let Γ := (M ≃ₐ[K] M)
  let _ : Fintype Γ := AlgEquiv.fintype K M
  let P : Sylow ℓ Γ := Classical.arbitrary (Sylow ℓ Γ)
  let L_sub : IntermediateField K M := IntermediateField.fixedField (P : Subgroup Γ)
  let K₁ : Type u := ↥L_sub
  have _ : Algebra.IsSeparable K K₁ := Algebra.isSeparable_tower_bot_of_isSeparable K K₁ M
  have _ : IsGalois K₁ M := IsGalois.tower_top_of_isGalois K K₁ M
  set d := Module.finrank K K₁
  have hfin_mul : d * Module.finrank K₁ M = Module.finrank K M :=
    Module.finrank_mul_finrank K K₁ M
  have hfin_P : Module.finrank K₁ M = Nat.card ↥(P : Subgroup Γ) :=
    IntermediateField.finrank_fixedField_eq_card (P : Subgroup Γ)
  have hcard_Γ : Nat.card Γ = Module.finrank K M :=
    IsGalois.card_aut_eq_finrank K M
  have hind_mul : (P : Subgroup Γ).index * Nat.card ↥(P : Subgroup Γ) = Nat.card Γ :=
    Subgroup.index_mul_card (P : Subgroup Γ)
  have hcardP_pos : 0 < Nat.card ↥(P : Subgroup Γ) := Nat.card_pos
  have hd_eq : d = (P : Subgroup Γ).index := by
    apply Nat.mul_right_cancel hcardP_pos
    rw [hfin_P] at hfin_mul
    exact hfin_mul.trans (hcard_Γ.symm.trans hind_mul.symm)
  have hnot_dvd : ¬ ℓ ∣ d := hd_eq ▸ Sylow.not_dvd_index P
  have hCoprime : Nat.Coprime d ℓ :=
    ((Nat.Prime.coprime_iff_not_dvd hPrime).mpr hnot_dvd).symm
  let _ : Fintype (M ≃ₐ[K₁] M) := AlgEquiv.fintype K₁ M
  have hcard_G₁ : Nat.card (M ≃ₐ[K₁] M) = Nat.card ↥(P : Subgroup Γ) :=
    (IsGalois.card_aut_eq_finrank K₁ M).trans hfin_P
  obtain ⟨k_P, hk_P⟩ := IsPGroup.iff_card.mp P.isPGroup'
  have hP₁ : IsPGroup ℓ (M ≃ₐ[K₁] M) := IsPGroup.of_card (hcard_G₁.trans hk_P)
  have hFieldEt : ∀ (E F : Type u) [Field E] [Field F] [Algebra E F]
      [FiniteDimensional E F] [Algebra.IsSeparable E F],
      AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E F))) := by
    intro E F _ _ _ _ _
    have hAlgEt : Algebra.Etale E F :=
      (Algebra.Etale.iff_exists_algEquiv_prod E F).mpr
        ⟨PUnit.{u + 1}, inferInstance, fun _ => F, fun _ => inferInstance,
          fun _ => inferInstance,
          { toFun := fun x _ => x
            invFun := fun f => f PUnit.unit
            left_inv := fun _ => rfl
            right_inv := fun f => funext fun ⟨⟩ => rfl
            map_mul' := fun _ _ => rfl
            map_add' := fun _ _ => rfl
            commutes' := fun _ => rfl },
          fun _ => ⟨inferInstance, inferInstance⟩⟩
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr hAlgEt)
  have hEt₁ : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁))) :=
    hFieldEt K K₁
  have hEt₂ : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₁ M))) :=
    hFieldEt K₁ M
  obtain ⟨hContF, hContB, adj_site, adj_sh, hUnit_app, hPresLim, ⟨eℤ⟩⟩ :=
    weil_alt_cd_field_etale_site_adjunction K K₁ hEt₁
  let π_star :=
    @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilAltCdFieldEtaleMap hEt₁) AddCommGrpCat.{u} _
      (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology
      (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology hContF
  let π_push :=
    @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilAltCdSitePullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁))))
      AddCommGrpCat.{u} _
      (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology
      (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology hContB
  have _ : CategoryTheory.Limits.PreservesFiniteLimits π_star := hPresLim
  have _ : π_star.Additive :=
    CategoryTheory.Functor.additive_of_preserves_binary_products π_star
  let ℱ₁ := π_star.obj ℱ
  have hℓ_1 : ℓ • CategoryTheory.CategoryStruct.id ℱ₁ = 0 := by
    change ℓ • CategoryTheory.CategoryStruct.id (π_star.obj ℱ) = 0
    rw [← π_star.map_id, ← CategoryTheory.Functor.map_nsmul, hℓ_ℱ,
      CategoryTheory.Functor.map_zero]
  let eMap : CategoryTheory.Functor.comp (weilAltCdFieldEtaleMap hEt₂)
      (weilAltCdFieldEtaleMap hEt₁) ≅ weilAltCdFieldEtaleMap hEt :=
    CategoryTheory.NatIso.ofComponents
      (fun V => CategoryTheory.MorphismProperty.Over.isoMk (CategoryTheory.Iso.refl V.left)
        ((CategoryTheory.Category.id_comp
          (CategoryTheory.CategoryStruct.comp V.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K M))))).trans
          ((congrArg (fun φ => CategoryTheory.CategoryStruct.comp V.hom
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)))
            (IsScalarTower.algebraMap_eq K K₁ M)).trans
            ((congrArg (fun f => CategoryTheory.CategoryStruct.comp V.hom
                (AlgebraicGeometry.Spec.map f))
              (CommRingCat.ofHom_comp (algebraMap K K₁) (algebraMap K₁ M))).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp V.hom)
                (AlgebraicGeometry.Spec.map_comp
                  (CommRingCat.ofHom (algebraMap K K₁))
                  (CommRingCat.ofHom (algebraMap K₁ M)))).trans
                (CategoryTheory.Category.assoc V.hom
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₁ M)))
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁)))).symm)))))
      (fun {_ _} g => CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.comp_id g.left).trans
          (CategoryTheory.Category.id_comp g.left).symm))
  have hSplit₁ : Nonempty ((CategoryTheory.Functor.comp (weilAltCdFieldEtaleMap hEt₂).op ℱ₁.obj) ≅
      weilAltCdDiscreteVecPresheaf (AlgebraicGeometry.Spec (CommRingCat.of M)) ℓ r) := by
    refine ⟨((CategoryTheory.Functor.associator (weilAltCdFieldEtaleMap hEt₂).op
        (weilAltCdFieldEtaleMap hEt₁).op ℱ.obj).symm.trans
      (CategoryTheory.Functor.isoWhiskerRight (CategoryTheory.NatIso.op eMap.symm) ℱ.obj)).trans
      (Classical.choice hSplit)⟩
  have hSub₁ : Subsingleton (ℱ₁.H s) :=
    weil_alt_cd_pgroup_galois_split_filtration_vanishing K₁ ℓ s hs (hConst K₁) M hP₁ hEt₂ r
      ℱ₁ hℓ_1 hSplit₁
  have hSubPush : Subsingleton ((π_push.obj ℱ₁).H s) :=
    weil_alt_cd_field_etale_pushforward_vanishing K K₁ hEt₁ hContF hContB adj_sh eℤ s hs ℱ₁ hSub₁
  obtain ⟨tr_π, htr_π⟩ :=
    weil_alt_cd_galois_sheet_sum_trace_retraction K K₁ M hEt₁ hEt hContF hContB adj_site ℱ
  have hRetract : CategoryTheory.CategoryStruct.comp (adj_sh.unit.app ℱ) tr_π =
      d • CategoryTheory.CategoryStruct.id ℱ :=
    htr_π (adj_sh.unit.app ℱ) (hUnit_app ℱ)
  let Fℤ_K :=
    (CategoryTheory.constantSheaf
      (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
  have hnsmul : ∀ (c : ℕ) (ξ : CategoryTheory.Abelian.Ext.{u} Fℤ_K ℱ s),
      c • ξ = ξ.comp (CategoryTheory.Abelian.Ext.mk₀ (c • CategoryTheory.CategoryStruct.id ℱ))
        (Nat.add_zero s) := by
    intro c ξ
    induction c with
    | zero =>
      rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.comp_zero]
    | succ c ih =>
      rw [succ_nsmul, succ_nsmul, ih, CategoryTheory.Abelian.Ext.mk₀_add,
        CategoryTheory.Abelian.Ext.comp_add, CategoryTheory.Abelian.Ext.comp_mk₀_id]
  refine subsingleton_of_forall_eq 0 (fun ξ => ?_)
  have hℓ_ξ : ℓ • ξ = 0 := by
    rw [hnsmul ℓ ξ, hℓ_ℱ, CategoryTheory.Abelian.Ext.mk₀_zero,
      CategoryTheory.Abelian.Ext.comp_zero]
  have hd_ξ : d • ξ = 0 := by
    rw [hnsmul d ξ, ← hRetract, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
    have hUnitZero : (ξ : CategoryTheory.Abelian.Ext.{u} Fℤ_K ℱ s).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj_sh.unit.app ℱ)) (Nat.add_zero s) = 0 :=
      @Subsingleton.elim ((π_push.obj ℱ₁).H s) hSubPush _ 0
    rw [hUnitZero]
    exact CategoryTheory.Abelian.Ext.zero_comp Fℤ_K s _ s (Nat.add_zero s)
  have hBezout : Int.gcdA d ℓ * (d : ℤ) + Int.gcdB d ℓ * (ℓ : ℤ) = 1 := by
    have hgcd := Int.gcd_eq_gcd_ab d ℓ
    rw [Int.gcd_def, Int.natAbs_natCast, Int.natAbs_natCast, hCoprime.gcd_eq_one,
      Nat.cast_one] at hgcd
    linarith
  calc
    ξ = (1 : ℤ) • ξ := (one_zsmul ξ).symm
    _ = (Int.gcdA d ℓ * (d : ℤ) + Int.gcdB d ℓ * (ℓ : ℤ)) • ξ := by rw [hBezout]
    _ = Int.gcdA d ℓ • ((d : ℤ) • ξ) + Int.gcdB d ℓ • ((ℓ : ℤ) • ξ) := by
          rw [add_zsmul, mul_zsmul, mul_zsmul]
    _ = Int.gcdA d ℓ • (d • ξ) + Int.gcdB d ℓ • (ℓ • ξ) := by
          rw [natCast_zsmul, natCast_zsmul]
    _ = 0 := by rw [hd_ξ, hℓ_ξ, zsmul_zero, zsmul_zero, add_zero]

theorem weil_alt_cd_field_sheaf_to_constant_torsion : (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (s : ℕ), 1 ≤ s →
      ∀ (ℋ : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}),
        Subsingleton (ℋ.H s)) ∧
    (∀ (K : Type u) [Field K] (ℓ s : ℕ) [Fact (Nat.Prime ℓ)], 1 ≤ s →
      (∀ (K₁ : Type u) [Field K₁] [Algebra K K₁] [FiniteDimensional K K₁]
        [Algebra.IsSeparable K K₁],
        Subsingleton (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of K₁)) ℓ s)) →
      ∀ (G : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id G = 0 →
        Subsingleton (G.H s)) :=
by
  refine ⟨?_, ?_⟩
  · intro Ω _ _ s hs ℋ
    let S_Ω : Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let J := S_Ω.smallEtaleTopology
    have _ : MorphismProperty.HasOfPostcompProperty (@Etale) (@Etale) :=
      ⟨fun {Y Z W} f g _ hfg =>
        MorphismProperty.of_postcomp (@Etale)
          (W' := @LocallyOfFiniteType ⊓ @FormallyUnramified) f g ⟨inferInstance, inferInstance⟩ hfg⟩
    have hJS : Scheme.JointlySurjective (Scheme.precoverage (@Etale)) :=
      @Scheme.instJointlySurjectivePrecoverage (@Etale)
    let T_Ω : S_Ω.Etale :=
      MorphismProperty.Over.mk ⊤ (𝟙 S_Ω) inferInstance
    have hT_Ω : Limits.IsTerminal T_Ω :=
      Limits.IsTerminal.ofUniqueHom
        (fun U => MorphismProperty.Over.homMk U.hom (Category.comp_id U.hom))
        (fun U m => MorphismProperty.Over.Hom.ext
          ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
    have hSieveId : ∀ (R : Sieve T_Ω), R ∈ J T_Ω → R.arrows (𝟙 T_Ω) := by
      intro R hR
      have hmem : R ∈ (Scheme.smallGrothendieckTopology (@Etale) (S := S_Ω)) T_Ω := hR
      obtain ⟨𝒰, h_over, hP, hle⟩ := (Scheme.mem_smallGrothendieckTopology T_Ω R).mp hmem
      let p₀ : ↥T_Ω.left := Classical.arbitrary ↥S_Ω
      let j : 𝒰.I₀ := @Scheme.Cover.idx _ _ hJS 𝒰 p₀
      obtain ⟨q₀, _⟩ := @Scheme.Cover.covers _ _ hJS 𝒰 p₀
      have hle' : @Scheme.Cover.toPresieveOverProp (@Etale) (@Etale) S_Ω _ T_Ω 𝒰 h_over hP ≤
          (R.arrows : Presieve T_Ω) := hle
      have hu_ex : ∃ (U : S_Ω.Etale) (u : U ⟶ T_Ω), R.arrows u ∧ Nonempty ↥U.left :=
        ⟨_, _, hle' _ _ (@Presieve.ofArrows.mk S_Ω.Etale _ _ _ _ _ j), ⟨q₀⟩⟩
      obtain ⟨U, u, hu_mem, ⟨q₀⟩⟩ := hu_ex
      obtain ⟨V₀, hV₀, hq₀, _⟩ :=
        exists_isAffineOpen_mem_and_subset (U := (⊤ : U.left.Opens)) (x := q₀) trivial
      let R_A : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op V₀)
      let A : Type u := ↑R_A
      let φ_sch : AlgebraicGeometry.Spec R_A ⟶ S_Ω := hV₀.fromSpec ≫ U.hom
      have hEt_φ : Etale φ_sch := by
        have : Etale U.hom := U.prop
        exact inferInstance
      let φ_ring : CommRingCat.of Ω ⟶ R_A :=
        (AlgebraicGeometry.Spec.fullyFaithful.preimage φ_sch).unop
      have hSpec_φ : AlgebraicGeometry.Spec.map φ_ring = φ_sch :=
        AlgebraicGeometry.Spec.fullyFaithful.map_preimage φ_sch
      have hEt_ring : (CommRingCat.Hom.hom φ_ring).Etale := by
        rw [← HasRingHomProperty.Spec_iff (P := @Etale), hSpec_φ]
        exact hEt_φ
      let _ : Algebra Ω A := (CommRingCat.Hom.hom φ_ring).toAlgebra
      have hAlgEt : Algebra.Etale Ω A := RingHom.etale_algebraMap.mp hEt_ring
      let pt_spec : ↥(AlgebraicGeometry.Spec R_A) := hV₀.isoSpec.hom.base ⟨q₀, hq₀⟩
      have : Nontrivial A := by
        refine ⟨⟨1, 0, fun h10 => ?_⟩⟩
        exact pt_spec.isPrime.ne_top
          (Ideal.eq_top_of_isUnit_mem _ (Submodule.zero_mem _) (by rw [← h10]; exact isUnit_one))
      obtain ⟨I, _, Ai, hFieldAi, hAlgAi, e_prod, hModAi⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod Ω A).mp hAlgEt
      let _ : ∀ i, Field (Ai i) := hFieldAi
      let _ : ∀ i, Algebra Ω (Ai i) := hAlgAi
      have hNonemptyI : Nonempty I := by
        by_contra hEmpty
        rw [not_nonempty_iff] at hEmpty
        exact @false_of_nontrivial_of_subsingleton A _ (e_prod.toEquiv.subsingleton)
      obtain ⟨i₀⟩ := hNonemptyI
      have : Module.Finite Ω (Ai i₀) := (hModAi i₀).1
      have : Algebra.IsIntegral Ω (Ai i₀) := Algebra.IsIntegral.of_finite Ω (Ai i₀)
      have hBij : Function.Bijective (algebraMap Ω (Ai i₀)) :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral
      let ψ : Ai i₀ ≃ₐ[Ω] Ω := (AlgEquiv.ofBijective (Algebra.ofId Ω (Ai i₀)) hBij).symm
      let ρ : A →ₐ[Ω] Ω := ψ.toAlgHom.comp ((Pi.evalAlgHom Ω Ai i₀).comp e_prod.toAlgHom)
      have hρ_comp : φ_ring ≫ CommRingCat.ofHom ρ.toRingHom = 𝟙 (CommRingCat.of Ω) :=
        CommRingCat.hom_ext ρ.comp_algebraMap
      let σ₀ : S_Ω ⟶ U.left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom) ≫ hV₀.fromSpec
      have hσ₀_comp : σ₀ ≫ U.hom = 𝟙 S_Ω := by
        calc
          σ₀ ≫ U.hom
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom) ≫ φ_sch :=
              Category.assoc _ _ _
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom) ≫
                AlgebraicGeometry.Spec.map φ_ring := by rw [hSpec_φ]
          _ = AlgebraicGeometry.Spec.map (φ_ring ≫ CommRingCat.ofHom ρ.toRingHom) :=
              (AlgebraicGeometry.Spec.map_comp _ _).symm
          _ = AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of Ω)) := by rw [hρ_comp]
          _ = 𝟙 S_Ω := AlgebraicGeometry.Spec.map_id _
      have hEt_σ₀ : Etale σ₀ := by
        have hEt_id : Etale (σ₀ ≫ U.hom) := by
          rw [hσ₀_comp]
          exact inferInstance
        exact MorphismProperty.of_postcomp (@Etale) (W' := @Etale) σ₀ U.hom U.prop hEt_id
      let σ : T_Ω ⟶ U := MorphismProperty.Over.homMk σ₀ hσ₀_comp
      have hσu : σ ≫ u = 𝟙 T_Ω := hT_Ω.hom_ext _ _
      rw [← hσu]
      exact R.downward_closed hu_mem σ
    let C_const := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let Γ_Ω := (CategoryTheory.sheafSections J AddCommGrpCat.{u}).obj (Opposite.op T_Ω)
    let adj : C_const ⊣ Γ_Ω := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_Ω
    have : Γ_Ω.PreservesEpimorphisms :=
      { preserves := fun {ℱ₁ ℱ₂} π hEpi => by
          rw [AddCommGrpCat.epi_iff_surjective]
          intro y
          have _ : Sheaf.IsLocallySurjective π :=
            (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} π).mpr hEpi
          have hImgMem : Presheaf.imageSieve π.hom y ∈ J T_Ω :=
            Presheaf.imageSieve_mem J π.hom y
          obtain ⟨x, hx⟩ := hSieveId _ hImgMem
          refine ⟨x, ?_⟩
          change (π.hom.app (Opposite.op T_Ω)) x = y
          simpa using hx }
    let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    have hProjAℤ : Projective Aℤ :=
      Projective.mk (fun {E X} f e hEpi => by
        have hSurj : Function.Surjective e := (AddCommGrpCat.epi_iff_surjective e).mp hEpi
        obtain ⟨x₀, hx₀⟩ := hSurj (f (ULift.up 1))
        refine ⟨AddCommGrpCat.ofHom
          { toFun := fun n => n.down • x₀
            map_zero' := zero_zsmul x₀
            map_add' := fun a b => add_zsmul x₀ a.down b.down }, ?_⟩
        ext ⟨n⟩
        change e (n • x₀) = f (ULift.up n)
        have hn : (ULift.up n : ULift.{u} ℤ) = n • ULift.up 1 := by
          ext
          simp
        rw [map_zsmul, hx₀, hn, map_zsmul])
    have : Projective (C_const.obj Aℤ) := adj.map_projective Aℤ hProjAℤ
    obtain ⟨n, rfl⟩ := Nat.exists_eq_add_of_le' hs
    exact subsingleton_of_forall_eq 0 (fun e => Abelian.Ext.eq_zero_of_projective e)
  · intro K _ ℓ s _ hs hConst G hℓ_G
    obtain ⟨Idx, hCat, hFilt, D, c, hc_pt, hc_colim, hStage⟩ :=
      weil_alt_cd_field_sheaf_galois_exhaustion K ℓ G hℓ_G
    let _ : CategoryTheory.SmallCategory Idx := hCat
    have : CategoryTheory.IsFiltered Idx := hFilt
    have hSub : ∀ j : Idx, Subsingleton ((D.obj j).H s) := by
      intro j
      obtain ⟨hℓ_Dj, M, hFieldM, hAlgM, hFinM, hGalM, hEtM, r, hSplit_j⟩ := hStage j
      let _ : Field M := hFieldM
      let _ : Algebra K M := hAlgM
      have : FiniteDimensional K M := hFinM
      have : IsGalois K M := hGalM
      exact weil_alt_cd_galois_split_sylow_devissage K ℓ s hs hConst (D.obj j) hℓ_Dj M hEtM r
        hSplit_j
    have hColimSub : Subsingleton (c.pt.H s) :=
      weil_alt_cd_field_filtered_colimit_vanishing K Idx D c hc_colim s hSub
    rwa [hc_pt] at hColimSub

theorem weil_alt_cd_subfield_colimit_deg_zero : WeilSubfieldSheafColimitAt.{u} 0 :=
by
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    ⟨fun _ _ hf hg => by have := hf; have := hg; infer_instance⟩

  let A := AddCommGrpCat.{u}
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)

  
  have hSepEtale : ∀ (F M : Type u) [Field F] [Field M] [Algebra F M]
      [FiniteDimensional F M] [Algebra.IsSeparable F M], Algebra.Etale F M :=
    fun F M _ _ _ _ _ =>
      @Algebra.Etale.mk F M _ _ _
        (Algebra.FormallyEtale.of_isSeparable F M)
        (Algebra.FinitePresentation.of_finiteType.mp inferInstance)

  
  let zHomEquiv : ∀ (M : AddCommGrpCat.{u}), (Aℤ ⟶ M) ≃+ ↥M :=
    fun M =>
      { toFun := fun φ => φ.hom (ULift.up (1 : ℤ))
        invFun := fun m => AddCommGrpCat.ofHom
          { toFun := fun z => z.down • m
            map_zero' := zero_zsmul m
            map_add' := fun a b => add_zsmul m a.down b.down }
        left_inv := fun φ => AddCommGrpCat.ext fun z => by
          change z.down • φ.hom (ULift.up (1 : ℤ)) = φ.hom z
          rw [← map_zsmul]
          congr 1
          exact ULift.ext _ _ (mul_one z.down)
        right_inv := fun m => one_zsmul m
        map_add' := fun _ _ => rfl }

  have h_apply_mk₀ : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
      [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab] {X Y : C_ab} (g : X ⟶ Y),
      (CategoryTheory.Abelian.Ext.addEquiv₀ : CategoryTheory.Abelian.Ext.{u} X Y 0 ≃+ (X ⟶ Y))
        (CategoryTheory.Abelian.Ext.mk₀ g) = g :=
    fun g => CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply g

  let evH0 : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology A),
      𝒢.H 0 ≃+ ↥(𝒢.obj.obj (Opposite.op (weilEtaleIdTerminal.{u} S))) :=
    fun S 𝒢 =>
      CategoryTheory.Abelian.Ext.addEquiv₀.trans
        (((CategoryTheory.constantSheafAdj S.smallEtaleTopology A
          (weilEtaleIdTerminalIsTerminal.{u} S)).homAddEquiv Aℤ 𝒢).trans
          (zHomEquiv _))

  have hEvPostcomp : ∀ (S : AlgebraicGeometry.Scheme.{u})
      {𝒢 𝒢' : CategoryTheory.Sheaf S.smallEtaleTopology A}
      (α : Quiver.Hom 𝒢 𝒢') (x : 𝒢.H 0),
      evH0 S 𝒢'
        (((CategoryTheory.Abelian.Ext.mk₀ α).postcomp
          ((CategoryTheory.constantSheaf S.smallEtaleTopology A).obj Aℤ)
          (Nat.add_zero 0)) x) =
        (α.hom.app (Opposite.op (weilEtaleIdTerminal.{u} S))).hom (evH0 S 𝒢 x) := by
    intro S 𝒢 𝒢' α x
    let C_S := CategoryTheory.constantSheaf S.smallEtaleTopology A
    let adj_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology A
      (weilEtaleIdTerminalIsTerminal.{u} S)
    let f : C_S.obj Aℤ ⟶ 𝒢 := CategoryTheory.Abelian.Ext.addEquiv₀ x
    have hx : x = CategoryTheory.Abelian.Ext.mk₀ f :=
      (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x).symm
    have hpost : ((CategoryTheory.Abelian.Ext.mk₀ α).postcomp (C_S.obj Aℤ) (Nat.add_zero 0)) x =
        CategoryTheory.Abelian.Ext.mk₀ (f ≫ α) := by
      change x.comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero 0) = _
      rw [hx, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    rw [hpost]
    change ((adj_S.homEquiv Aℤ 𝒢')
      (CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ (f ≫ α)))).hom
      (ULift.up (1 : ℤ)) = _
    rw [h_apply_mk₀ (f ≫ α), adj_S.homEquiv_naturality_right f α]
    rfl

  have hConstUnitNat : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C)
      [CategoryTheory.HasWeakSheafify J A]
      {T T' : C} (hT : CategoryTheory.Limits.IsTerminal T)
      (hT' : CategoryTheory.Limits.IsTerminal T') (X : A),
      (CategoryTheory.constantSheafAdj J A hT).unit.app X ≫
        ((CategoryTheory.constantSheaf J A).obj X).obj.map (hT.from T').op =
        (CategoryTheory.constantSheafAdj J A hT').unit.app X := by
    intro C _ J _ T T' hT hT' X
    unfold CategoryTheory.constantSheafAdj CategoryTheory.constantSheaf
    have hnat := ((CategoryTheory.sheafificationAdjunction J A).unit.app
      ((CategoryTheory.Functor.const Cᵒᵖ).obj X)).naturality (hT.from T').op
    simpa using hnat.symm

  have hConstHomEquivSymmNat : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C)
      [CategoryTheory.HasWeakSheafify J A]
      {T T' : C} (hT : CategoryTheory.Limits.IsTerminal T)
      (hT' : CategoryTheory.Limits.IsTerminal T') (X : A)
      (𝒢 : CategoryTheory.Sheaf J A)
      (g : X ⟶ 𝒢.obj.obj (Opposite.op T)),
      ((CategoryTheory.constantSheafAdj J A hT').homEquiv X 𝒢).symm
        (g ≫ 𝒢.obj.map (hT.from T').op) =
        ((CategoryTheory.constantSheafAdj J A hT).homEquiv X 𝒢).symm g := by
    intro C _ J _ T T' hT hT' X 𝒢 g
    let adj := CategoryTheory.constantSheafAdj J A hT
    let adj' := CategoryTheory.constantSheafAdj J A hT'
    apply (adj'.homEquiv X 𝒢).injective
    rw [(adj'.homEquiv X 𝒢).apply_symm_apply]
    let φ := (adj.homEquiv X 𝒢).symm g
    have hg : adj.homEquiv X 𝒢 φ = g := (adj.homEquiv X 𝒢).apply_symm_apply g
    change g ≫ 𝒢.obj.map (hT.from T').op = adj'.homEquiv X 𝒢 φ
    rw [← hg, CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
    change (adj.unit.app X ≫ φ.hom.app (Opposite.op T)) ≫ 𝒢.obj.map (hT.from T').op =
      adj'.unit.app X ≫ φ.hom.app (Opposite.op T')
    rw [CategoryTheory.Category.assoc, ← φ.hom.naturality (hT.from T').op,
      ← CategoryTheory.Category.assoc, hConstUnitNat J hT hT' X]

  have hEvalPullH0 : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂)
      [_hCont : (weilAltCdSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology]
      [_hAdj : ((weilAltCdSitePullback h).sheafPushforwardContinuous
        A S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint]
      (ℱ : CategoryTheory.Sheaf S₂.smallEtaleTopology A)
      (p_ℱ : ℱ.H 0 →+
