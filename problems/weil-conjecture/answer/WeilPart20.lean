            = (G.obj.map (p_Z ≫ a).op).hom s := (hMapComp p_Z a s).symm
          _ = (G.obj.map (p_U' ≫ u).op).hom s := by rw [hp_comm]
          _ = (G.obj.map p_U'.op).hom ((G.obj.map u.op).hom s) := hMapComp p_U' u s
          _ = (G.obj.map (p_Z ≫ b).op).hom w := heq_w
          _ = (G.obj.map p_Z.op).hom ((G.obj.map b.op).hom w) := hMapComp p_Z b w
    let e_sub : SubF.toFunctor ≅ P_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u} :=
      CategoryTheory.NatIso.ofComponents (fun _ => CategoryTheory.Iso.refl _) (fun _ => rfl)
    have hP_type : CategoryTheory.Presieve.IsSheaf J_K
        (P_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      CategoryTheory.Presieve.isSheaf_iso J_K e_sub hSubSheaf
    have hP_sheaf_type : CategoryTheory.Presheaf.IsSheaf J_K
        (P_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type J_K _).mpr hP_type
    have hP_sheaf : CategoryTheory.Presheaf.IsSheaf J_K P_pre :=
      CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J_K P_pre
        (CategoryTheory.forget AddCommGrpCat.{u}) hP_sheaf_type
    let ℋ : CategoryTheory.Sheaf J_K AddCommGrpCat.{u} := ⟨P_pre, hP_sheaf⟩
    let ι_ℋ : ℋ ⟶ G := CategoryTheory.ObjectProperty.homMk ι_pre
    have hℓ_ℋ : ℓ • CategoryTheory.CategoryStruct.id ℋ = 0 := by
      apply (CategoryTheory.sheafToPresheaf J_K AddCommGrpCat.{u}).map_injective
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
        CategoryTheory.Functor.map_zero]
      ext U_op y
      simp only [CategoryTheory.NatTrans.app_nsmul, CategoryTheory.NatTrans.id_app,
        CategoryTheory.NatTrans.app_zero, AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id,
        AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply,
        AddMonoidHom.zero_apply]
      exact Subtype.ext (hℓ_sec U_op.unop y.1)
    have hRange_ℋ : ∀ U : S_K.Etale,
        Function.Injective ((ι_ℋ.hom.app (Opposite.op U)).hom) ∧
        Set.range ((ι_ℋ.hom.app (Opposite.op U)).hom) = (A_of U : Set ↥(G.obj.obj (Opposite.op U))) := by
      intro U
      refine ⟨Subtype.val_injective, ?_⟩
      ext s
      exact ⟨by rintro ⟨⟨y, hy⟩, rfl⟩; exact hy, fun hs => ⟨⟨s, hs⟩, rfl⟩⟩
    obtain ⟨ι_sh, hSh_prop, hSh_cov⟩ := hSheets
    let O_pt : ∀ (V : S_M.Etale), ↥V.left → V.left.Opens :=
      fun V x => ⟨{x}, @isOpen_discrete _ _ (hDisc_M V) {x}⟩
    let Z_pt : ∀ (V : S_M.Etale), ↥V.left → S_K.Etale :=
      fun V x =>
        CategoryTheory.MorphismProperty.Over.mk ⊤ ((O_pt V x).ι ≫ (V.hom ≫ π_M))
          (by have := V.prop; have := hEt; exact inferInstance)
    let j_pt : ∀ (V : S_M.Etale) (x : ↥V.left), Z_pt V x ⟶ F_M.obj V :=
      fun V x => CategoryTheory.MorphismProperty.Over.homMk (O_pt V x).ι rfl
    let p_pt : ∀ (V : S_M.Etale) (x : ↥V.left), Z_pt V x ⟶ U_M :=
      fun V x => CategoryTheory.MorphismProperty.Over.homMk ((O_pt V x).ι ≫ V.hom)
        ((congrArg (((O_pt V x).ι ≫ V.hom) ≫ ·) (Category.id_comp π_M)).trans
          (Category.assoc (O_pt V x).ι V.hom π_M))
    have hNe_pt : ∀ (V : S_M.Etale) (x : ↥V.left), Nonempty ↥(Z_pt V x).left :=
      fun V x => ⟨⟨x, rfl⟩⟩
    have hSub_pt : ∀ (V : S_M.Etale) (x : ↥V.left), Subsingleton ↥(Z_pt V x).left :=
      fun V x => ⟨fun ⟨y₁, hy₁⟩ ⟨y₂, hy₂⟩ => Subtype.ext (hy₁.trans hy₂.symm)⟩
    have hCov_pt : ∀ (V : S_M.Etale),
        CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows (Z_pt V) (j_pt V)) ∈
          J_K (F_M.obj V) :=
      fun V => hSieveMem (F_M.obj V) ↥V.left (Z_pt V) (j_pt V) (fun x => ⟨x, ⟨x, rfl⟩, rfl⟩)
    have hUniq_pt : ∀ (V : S_M.Etale) (f : ↥V.left → ↥W) {Y : S_K.Etale}
        {x₁ x₂ : ↥V.left} {h₁ : Y ⟶ Z_pt V x₁} {h₂ : Y ⟶ Z_pt V x₂},
        h₁ ≫ j_pt V x₁ = h₂ ≫ j_pt V x₂ →
        (G.obj.map (h₁ ≫ p_pt V x₁).op).hom (f x₁).1 =
          (G.obj.map (h₂ ≫ p_pt V x₂).op).hom (f x₂).1 := by
      intro V f Y x₁ x₂ h₁ h₂ hcomm
      by_cases hEmpY : IsEmpty ↥Y.left
      · have _ := hEmptySub Y hEmpY
        exact Subsingleton.elim _ _
      · obtain ⟨y₀⟩ := not_isEmpty_iff.mp hEmpY
        have hbase := congrArg (fun m => m.left.base y₀) hcomm
        have hx₁ : (h₁ ≫ j_pt V x₁).left.base y₀ = x₁ := (h₁.left.base y₀).2
        have hx₂ : (h₂ ≫ j_pt V x₂).left.base y₀ = x₂ := (h₂.left.base y₀).2
        have hx_eq : x₁ = x₂ := hx₁.symm.trans (hbase.trans hx₂)
        subst hx_eq
        have hleft : h₁.left ≫ (O_pt V x₁).ι = h₂.left ≫ (O_pt V x₁).ι :=
          congrArg (fun m => m.left) hcomm
        have hh_eq : h₁ = h₂ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext ((cancel_mono (O_pt V x₁).ι).mp hleft)
        rw [hh_eq]
    have hArrowEx : ∀ (V : S_M.Etale) {Y : S_K.Etale} {g : Y ⟶ F_M.obj V},
        CategoryTheory.Presieve.ofArrows (Z_pt V) (j_pt V) g →
        ∃ (x : ↥V.left) (h : Y ⟶ Z_pt V x), h ≫ j_pt V x = g := by
      rintro V Y g ⟨x⟩
      exact ⟨x, 𝟙 (Z_pt V x), Category.id_comp _⟩
    let fam_pt : ∀ (V : S_M.Etale) (f : ↥V.left → ↥W),
        CategoryTheory.Presieve.FamilyOfElements
          (G.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
          (CategoryTheory.Presieve.ofArrows (Z_pt V) (j_pt V)) :=
      fun V f Y g hg =>
        let hex := hArrowEx V hg
        (G.obj.map (hex.choose_spec.choose ≫ p_pt V hex.choose).op).hom (f hex.choose).1
    have hCompat_pt : ∀ (V : S_M.Etale) (f : ↥V.left → ↥W), (fam_pt V f).Compatible := by
      intro V f Y₁ Y₂ Z₀ g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      let hex₁ := hArrowEx V hf₁
      let x₁ := hex₁.choose
      let h₁ := hex₁.choose_spec.choose
      have hf₁_eq : h₁ ≫ j_pt V x₁ = f₁ := hex₁.choose_spec.choose_spec
      let hex₂ := hArrowEx V hf₂
      let x₂ := hex₂.choose
      let h₂ := hex₂.choose_spec.choose
      have hf₂_eq : h₂ ≫ j_pt V x₂ = f₂ := hex₂.choose_spec.choose_spec
      have h_eq : (g₁ ≫ h₁) ≫ j_pt V x₁ = (g₂ ≫ h₂) ≫ j_pt V x₂ :=
        (Category.assoc g₁ h₁ _).trans
          ((congrArg (g₁ ≫ ·) hf₁_eq).trans
            (hcomm.trans ((congrArg (g₂ ≫ ·) hf₂_eq.symm).trans (Category.assoc g₂ h₂ _).symm)))
      have hun := hUniq_pt V f h_eq
      change (G.obj.map g₁.op).hom ((G.obj.map (h₁ ≫ p_pt V x₁).op).hom (f x₁).1) =
        (G.obj.map g₂.op).hom ((G.obj.map (h₂ ≫ p_pt V x₂).op).hom (f x₂).1)
      rw [Category.assoc, Category.assoc, hMapComp g₁ (h₁ ≫ p_pt V x₁),
        hMapComp g₂ (h₂ ≫ p_pt V x₂)] at hun
      exact hun
    let Ψ_raw : ∀ (V : S_M.Etale), (↥V.left → ↥W) → ↥(G.obj.obj (Opposite.op (F_M.obj V))) :=
      fun V f => (hG_type.isSheafFor _ (hCov_pt V)).amalgamate (fam_pt V f) (hCompat_pt V f)
    have hΨ_spec : ∀ (V : S_M.Etale) (f : ↥V.left → ↥W) (x : ↥V.left),
        (G.obj.map (j_pt V x).op).hom (Ψ_raw V f) = (G.obj.map (p_pt V x).op).hom (f x).1 := by
      intro V f x
      have hj_mem : CategoryTheory.Presieve.ofArrows (Z_pt V) (j_pt V) (j_pt V x) :=
        CategoryTheory.Presieve.ofArrows.mk x
      have hglue := (hG_type.isSheafFor _ (hCov_pt V)).valid_glue (hCompat_pt V f) (j_pt V x) hj_mem
      let hex := hArrowEx V hj_mem
      have hh' : hex.choose_spec.choose ≫ j_pt V hex.choose = 𝟙 (Z_pt V x) ≫ j_pt V x :=
        hex.choose_spec.choose_spec.trans (Category.id_comp _).symm
      have hun := hUniq_pt V f hh'
      rw [Category.id_comp] at hun
      exact hglue.trans hun
    have hΨ_zero : ∀ (V : S_M.Etale), Ψ_raw V 0 = 0 := by
      intro V
      refine ((hG_type.isSheafFor _ (hCov_pt V)).isSeparatedFor.ext) ?_
      rintro Y g ⟨x⟩
      change (G.obj.map (j_pt V x).op).hom (Ψ_raw V 0) = (G.obj.map (j_pt V x).op).hom 0
      rw [map_zero, hΨ_spec, show ((0 : ↥V.left → ↥W) x).1 = 0 from rfl, map_zero]
    have hΨ_add : ∀ (V : S_M.Etale) (f₁ f₂ : ↥V.left → ↥W),
        Ψ_raw V (f₁ + f₂) = Ψ_raw V f₁ + Ψ_raw V f₂ := by
      intro V f₁ f₂
      refine ((hG_type.isSheafFor _ (hCov_pt V)).isSeparatedFor.ext) ?_
      rintro Y g ⟨x⟩
      change (G.obj.map (j_pt V x).op).hom (Ψ_raw V (f₁ + f₂)) =
        (G.obj.map (j_pt V x).op).hom (Ψ_raw V f₁ + Ψ_raw V f₂)
      rw [hΨ_spec, map_add, hΨ_spec, hΨ_spec,
        show ((f₁ + f₂) x).1 = (f₁ x).1 + (f₂ x).1 from rfl, map_add]
    have hΨ_nat : ∀ {V₁ V₂ : S_M.Etale} (g : V₁ ⟶ V₂) (f : ↥V₂.left → ↥W),
        (G.obj.map (F_M.map g).op).hom (Ψ_raw V₂ f) = Ψ_raw V₁ (fun x => f (g.left.base x)) := by
      intro V₁ V₂ g f
      refine ((hG_type.isSheafFor _ (hCov_pt V₁)).isSeparatedFor.ext) ?_
      rintro Y u ⟨x⟩
      have hrange : Set.range ((O_pt V₁ x).ι ≫ g.left).base ⊆
          Set.range (O_pt V₂ (g.left.base x)).ι.base := by
        rintro _ ⟨⟨y, hy⟩, rfl⟩
        have hyx : y = x := hy
        subst hyx
        exact ⟨⟨g.left.base y, rfl⟩, rfl⟩
      let g_pt_sch := AlgebraicGeometry.IsOpenImmersion.lift (O_pt V₂ (g.left.base x)).ι
        ((O_pt V₁ x).ι ≫ g.left) hrange
      have hg_fac : g_pt_sch ≫ (O_pt V₂ (g.left.base x)).ι = (O_pt V₁ x).ι ≫ g.left :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
      let g_pt : Z_pt V₁ x ⟶ Z_pt V₂ (g.left.base x) :=
        CategoryTheory.MorphismProperty.Over.homMk g_pt_sch
          ((Category.assoc g_pt_sch (O_pt V₂ (g.left.base x)).ι (V₂.hom ≫ π_M)).symm.trans
            ((congrArg (· ≫ (V₂.hom ≫ π_M)) hg_fac).trans
              ((Category.assoc (O_pt V₁ x).ι g.left (V₂.hom ≫ π_M)).trans
                (congrArg ((O_pt V₁ x).ι ≫ ·)
                  ((Category.assoc g.left V₂.hom π_M).symm.trans
                    (congrArg (· ≫ π_M) (CategoryTheory.MorphismProperty.Over.w g)))))))
      have hj_comm : j_pt V₁ x ≫ F_M.map g = g_pt ≫ j_pt V₂ (g.left.base x) :=
        CategoryTheory.MorphismProperty.Over.Hom.ext hg_fac.symm
      have hp_comm : g_pt ≫ p_pt V₂ (g.left.base x) = p_pt V₁ x :=
        CategoryTheory.MorphismProperty.Over.Hom.ext
          ((Category.assoc g_pt_sch (O_pt V₂ (g.left.base x)).ι V₂.hom).symm.trans
            ((congrArg (· ≫ V₂.hom) hg_fac).trans
              ((Category.assoc (O_pt V₁ x).ι g.left V₂.hom).trans
                (congrArg ((O_pt V₁ x).ι ≫ ·) (CategoryTheory.MorphismProperty.Over.w g)))))
      change (G.obj.map (j_pt V₁ x).op).hom ((G.obj.map (F_M.map g).op).hom (Ψ_raw V₂ f)) =
        (G.obj.map (j_pt V₁ x).op).hom (Ψ_raw V₁ (fun x => f (g.left.base x)))
      calc
        (G.obj.map (j_pt V₁ x).op).hom ((G.obj.map (F_M.map g).op).hom (Ψ_raw V₂ f))
          = (G.obj.map (j_pt V₁ x ≫ F_M.map g).op).hom (Ψ_raw V₂ f) :=
            (hMapComp (j_pt V₁ x) (F_M.map g) (Ψ_raw V₂ f)).symm
        _ = (G.obj.map (g_pt ≫ j_pt V₂ (g.left.base x)).op).hom (Ψ_raw V₂ f) := by rw [hj_comm]
        _ = (G.obj.map g_pt.op).hom ((G.obj.map (j_pt V₂ (g.left.base x)).op).hom (Ψ_raw V₂ f)) :=
            hMapComp g_pt (j_pt V₂ (g.left.base x)) (Ψ_raw V₂ f)
        _ = (G.obj.map g_pt.op).hom ((G.obj.map (p_pt V₂ (g.left.base x)).op).hom (f (g.left.base x)).1) :=
            congrArg ((G.obj.map g_pt.op).hom) (hΨ_spec V₂ f (g.left.base x))
        _ = (G.obj.map (g_pt ≫ p_pt V₂ (g.left.base x)).op).hom (f (g.left.base x)).1 :=
            (hMapComp g_pt (p_pt V₂ (g.left.base x)) (f (g.left.base x)).1).symm
        _ = (G.obj.map (p_pt V₁ x).op).hom (f (g.left.base x)).1 := by rw [hp_comm]
        _ = (G.obj.map (j_pt V₁ x).op).hom (Ψ_raw V₁ (fun x => f (g.left.base x))) :=
            (hΨ_spec V₁ (fun x => f (g.left.base x)) x).symm
    have hΨ_inj : ∀ (V : S_M.Etale), Function.Injective (Ψ_raw V) := by
      intro V f₁ f₂ heq
      ext x
      have hspec : (G.obj.map (p_pt V x).op).hom (f₁ x).1 =
          (G.obj.map (p_pt V x).op).hom (f₂ x).1 := by
        rw [← hΨ_spec, ← hΨ_spec, heq]
      have hSub_UM : Subsingleton ↥U_M.left := by
        change Subsingleton ↥S_M
        infer_instance
      exact hPtInj (p_pt V x) (hNe_pt V x) hSub_UM hspec
    have hΨ_mem : ∀ (V : S_M.Etale) (f : ↥V.left → ↥W), Ψ_raw V f ∈ A_of (F_M.obj V) := by
      intro V f Z hZ a b
      by_cases hEmpZ : IsEmpty ↥Z.left
      · have _ := hEmptySub Z hEmpZ
        exact ⟨0, W.zero_mem, Subsingleton.elim _ _⟩
      · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hEmpZ
        let x : ↥V.left := a.left.base z₀
        have ha_range : Set.range a.left.base ⊆ Set.range (O_pt V x).ι.base := by
          rintro _ ⟨z, rfl⟩
          rw [Subsingleton.elim z z₀]
          exact ⟨⟨x, rfl⟩, rfl⟩
        let a₀_sch := AlgebraicGeometry.IsOpenImmersion.lift (O_pt V x).ι a.left ha_range
        have ha₀_fac : a₀_sch ≫ (O_pt V x).ι = a.left :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
        let a₀ : Z ⟶ Z_pt V x := CategoryTheory.MorphismProperty.Over.homMk a₀_sch
          ((Category.assoc a₀_sch (O_pt V x).ι (V.hom ≫ π_M)).symm.trans
            ((congrArg (· ≫ (V.hom ≫ π_M)) ha₀_fac).trans
              (CategoryTheory.MorphismProperty.Over.w a)))
        have ha_eq : a₀ ≫ j_pt V x = a :=
          CategoryTheory.MorphismProperty.Over.Hom.ext ha₀_fac
        let b_sch : Z.left ⟶ S_M := b.left
        have h_over_K : (a.left ≫ V.hom) ≫ π_M = b_sch ≫ π_M := by
          have ha_w : a.left ≫ (V.hom ≫ π_M) = Z.hom := CategoryTheory.MorphismProperty.Over.w a
          have hb_w : b_sch ≫ (𝟙 S_M ≫ π_M) = Z.hom := CategoryTheory.MorphismProperty.Over.w b
          exact (Category.assoc a.left V.hom π_M).trans
            (ha_w.trans (hb_w.symm.trans (congrArg (b_sch ≫ ·) (Category.id_comp π_M))))
        let q_pb : Z.left ⟶ CategoryTheory.Limits.pullback π_M π_M :=
          CategoryTheory.Limits.pullback.lift (a.left ≫ V.hom) b_sch h_over_K
        obtain ⟨σ, hσ_mem⟩ := hSh_cov (q_pb.base z₀)
        have hq_range : Set.range q_pb.base ⊆ Set.range (ι_sh σ).base := by
          rintro _ ⟨z, rfl⟩
          rw [Subsingleton.elim z z₀]
          exact hσ_mem
        have _ : AlgebraicGeometry.IsOpenImmersion (ι_sh σ) := (hSh_prop σ).1
        let q₀ := AlgebraicGeometry.IsOpenImmersion.lift (ι_sh σ) q_pb hq_range
        have hq₀_fac : q₀ ≫ ι_sh σ = q_pb := AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
        have hb_eq : q₀ = b_sch := by
          calc
            q₀ = q₀ ≫ 𝟙 S_M := (Category.comp_id q₀).symm
            _ = q₀ ≫ (ι_sh σ ≫ CategoryTheory.Limits.pullback.snd π_M π_M) := by
                rw [(hSh_prop σ).2.2]
            _ = (q₀ ≫ ι_sh σ) ≫ CategoryTheory.Limits.pullback.snd π_M π_M :=
                (Category.assoc _ _ _).symm
            _ = q_pb ≫ CategoryTheory.Limits.pullback.snd π_M π_M := by rw [hq₀_fac]
            _ = b_sch := CategoryTheory.Limits.pullback.lift_snd _ _ _
        have haV_eq : a.left ≫ V.hom =
            b_sch ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) := by
          calc
            a.left ≫ V.hom = q_pb ≫ CategoryTheory.Limits.pullback.fst π_M π_M :=
              (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
            _ = (q₀ ≫ ι_sh σ) ≫ CategoryTheory.Limits.pullback.fst π_M π_M := by rw [← hq₀_fac]
            _ = q₀ ≫ (ι_sh σ ≫ CategoryTheory.Limits.pullback.fst π_M π_M) := Category.assoc _ _ _
            _ = b_sch ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) := by
                rw [hb_eq, (hSh_prop σ).2.1]
        have hσ_π : AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) ≫ π_M = π_M := by
          dsimp only [π_M]
          rw [← AlgebraicGeometry.Spec.map_comp]
          congr 1
          exact CommRingCat.hom_ext (RingHom.ext σ.commutes)
        have hσ_w : AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) ≫ U_M.hom =
            U_M.hom :=
          ((congrArg (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) ≫ ·)
            (Category.id_comp π_M)).trans hσ_π).trans (Category.id_comp π_M).symm
        let u_σ : U_M ⟶ U_M := CategoryTheory.MorphismProperty.Over.homMk
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom)) hσ_w
        have hap_eq : a₀ ≫ p_pt V x = b ≫ u_σ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext
            ((Category.assoc a₀_sch (O_pt V x).ι V.hom).symm.trans
              ((congrArg (· ≫ V.hom) ha₀_fac).trans haV_eq))
        refine ⟨(G.obj.map u_σ.op).hom (f x).1, hGal_W u_σ (f x).1 (f x).2, ?_⟩
        calc
          (G.obj.map a.op).hom (Ψ_raw V f)
            = (G.obj.map (a₀ ≫ j_pt V x).op).hom (Ψ_raw V f) := by rw [ha_eq]
          _ = (G.obj.map a₀.op).hom ((G.obj.map (j_pt V x).op).hom (Ψ_raw V f)) :=
              hMapComp a₀ (j_pt V x) (Ψ_raw V f)
          _ = (G.obj.map a₀.op).hom ((G.obj.map (p_pt V x).op).hom (f x).1) := by rw [hΨ_spec]
          _ = (G.obj.map (a₀ ≫ p_pt V x).op).hom (f x).1 := (hMapComp a₀ (p_pt V x) (f x).1).symm
          _ = (G.obj.map (b ≫ u_σ).op).hom (f x).1 := by rw [hap_eq]
          _ = (G.obj.map b.op).hom ((G.obj.map u_σ.op).hom (f x).1) := hMapComp b u_σ (f x).1
    have hΨ_surj : ∀ (V : S_M.Etale) (s : ↥(A_of (F_M.obj V))),
        ∃ f : ↥V.left → ↥W, Ψ_raw V f = s.1 := by
      intro V ⟨s, hs⟩
      let f : ↥V.left → ↥W := fun x =>
        let hex := hs (Z_pt V x) (hSub_pt V x) (j_pt V x) (p_pt V x)
        ⟨hex.choose, hex.choose_spec.1⟩
      refine ⟨f, ?_⟩
      refine ((hG_type.isSheafFor _ (hCov_pt V)).isSeparatedFor.ext) ?_
      rintro Y g ⟨x⟩
      have hex := hs (Z_pt V x) (hSub_pt V x) (j_pt V x) (p_pt V x)
      have hf_x : (G.obj.map (j_pt V x).op).hom s = (G.obj.map (p_pt V x).op).hom (f x).1 :=
        hex.choose_spec.2
      change (G.obj.map (j_pt V x).op).hom (Ψ_raw V f) = (G.obj.map (j_pt V x).op).hom s
      rw [hΨ_spec, hf_x]
    have hMemW : ∀ w ∈ W, w ∈ Set.range ((ι_ℋ.hom.app (Opposite.op U_M)).hom) := by
      intro w hw
      rw [(hRange_ℋ U_M).2]
      let f_w : ↥T_M.left → ↥W := fun _ => ⟨w, hw⟩
      have hfw_eq : Ψ_raw T_M f_w = w := by
        refine ((hG_type.isSheafFor _ (hCov_pt T_M)).isSeparatedFor.ext) ?_
        rintro Y g ⟨x⟩
        have hpj : p_pt T_M x = j_pt T_M x :=
          CategoryTheory.MorphismProperty.Over.Hom.ext (Category.comp_id _)
        change (G.obj.map (j_pt T_M x).op).hom (Ψ_raw T_M f_w) =
          (G.obj.map (j_pt T_M x).op).hom w
        rw [hΨ_spec, hpj]
      rw [← hfw_eq]
      exact hΨ_mem T_M f_w
    have hℓ_W : ∀ w : ↥W, ℓ • w = 0 := fun w => Subtype.ext (hℓ_sec U_M w.1)
    let r_and_iso : Σ (r : ℕ),
        ((CategoryTheory.Functor.comp F_M.op ℋ.obj) ≅ weilAltCdDiscreteVecPresheaf S_M ℓ r) := by
      let modW : Module (ZMod ℓ) ↥W := AddCommGroup.zmodModule hℓ_W
      have finW : @Module.Finite (ZMod ℓ) ↥W _ _ modW :=
        @Module.Finite.of_finite (ZMod ℓ) ↥W _ _ modW inferInstance
      have freeW : @Module.Free (ZMod ℓ) ↥W _ _ modW :=
        @Module.Free.of_divisionRing (ZMod ℓ) ↥W _ _ modW
      let r : ℕ := @Module.finrank (ZMod ℓ) ↥W _ _ modW
      let b_W : @Module.Basis (Fin r) (ZMod ℓ) ↥W _ _ modW :=
        @Module.finBasis (ZMod ℓ) ↥W _ _ modW freeW inferInstance finW
      let e_W : ↥W ≃+ (Fin r → ZMod ℓ) :=
        (@Module.Basis.equivFun (Fin r) (ZMod ℓ) ↥W _ _ modW _ b_W).toAddEquiv
      let e_V : ∀ (V : S_M.Etale),
          (↥V.left → Fin r → ZMod ℓ) ≃+ ↥(A_of (F_M.obj V)) :=
        fun V =>
          (AddEquiv.arrowCongr (Equiv.refl ↥V.left) e_W.symm).trans
            (AddEquiv.ofBijective
              ({ toFun := fun f => ⟨Ψ_raw V f, hΨ_mem V f⟩
                 map_zero' := Subtype.ext (hΨ_zero V)
                 map_add' := fun f₁ f₂ => Subtype.ext (hΨ_add V f₁ f₂) } :
                (↥V.left → ↥W) →+ ↥(A_of (F_M.obj V)))
              ⟨fun f₁ f₂ h => hΨ_inj V (congrArg Subtype.val h),
               fun s => let ⟨f, hf⟩ := hΨ_surj V s; ⟨f, Subtype.ext hf⟩⟩)
      refine ⟨r, CategoryTheory.NatIso.ofComponents
        (fun V_op => (e_V V_op.unop).symm.toAddCommGrpIso) ?_⟩
      intro V₁_op V₂_op g_op
      let V₁ : S_M.Etale := V₁_op.unop
      let V₂ : S_M.Etale := V₂_op.unop
      let g : V₂ ⟶ V₁ := g_op.unop
      apply AddCommGrpCat.hom_ext
      ext s
      funext x
      let s₁ : ↥(A_of (F_M.obj V₁)) := s
      let s₂ : ↥(A_of (F_M.obj V₂)) := (ℋ.obj.map (F_M.map g).op).hom s₁
      let x₂ : ↥V₂.left := x
      change (e_V V₂).symm s₂ x₂ = (e_V V₁).symm s₁ (g.left.base x₂)
      apply e_W.symm.injective
      have h_app : ∀ (W₀ : S_M.Etale) (t : ↥(A_of (F_M.obj W₀))),
          Ψ_raw W₀ (fun y => e_W.symm ((e_V W₀).symm t y)) = t.1 := by
        intro W₀ t
        exact congrArg Subtype.val ((e_V W₀).apply_symm_apply t)
      let f_lhs : ↥V₂.left → ↥W := fun y => e_W.symm ((e_V V₂).symm s₂ y)
      let f_rhs : ↥V₂.left → ↥W := fun y => e_W.symm ((e_V V₁).symm s₁ (g.left.base y))
      have h_eq : Ψ_raw V₂ f_lhs = Ψ_raw V₂ f_rhs :=
        (h_app V₂ s₂).trans
          ((congrArg ((G.obj.map (F_M.map g).op).hom) (h_app V₁ s₁).symm).trans
            (hΨ_nat g (fun y => e_W.symm ((e_V V₁).symm s₁ y))))
      exact congrFun (@hΨ_inj V₂ f_lhs f_rhs h_eq) x₂
    exact ⟨ℋ, ι_ℋ, r_and_iso.1, hℓ_ℋ, hRange_ℋ, hMemW, ⟨r_and_iso.2⟩⟩

  obtain ⟨hEtSurj, _hDisc, hGalCov⟩ := hPart1
  let S_K : Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of K)
  let J_K := S_K.smallEtaleTopology
  let K_sep := SeparableClosure K
  have hMapComp : ∀ {X Y Z : S_K.Etale} (f : X ⟶ Y) (g : Y ⟶ Z)
      (s : ↥(G.obj.obj (Opposite.op Z))),
      (G.obj.map (f ≫ g).op).hom s = (G.obj.map f.op).hom ((G.obj.map g.op).hom s) := by
    intro X Y Z f g s
    change (G.obj.map (g.op ≫ f.op)).hom s = _
    rw [G.obj.map_comp]
    rfl
  have hℓ_sec : ∀ (U : S_K.Etale) (s : ↥(G.obj.obj (Opposite.op U))), ℓ • s = 0 := by
    intro U s
    have hpre : (CategoryTheory.sheafToPresheaf J_K AddCommGrpCat.{u}).map
        (ℓ • CategoryTheory.CategoryStruct.id G) = 0 := by
      rw [hℓ_G, CategoryTheory.Functor.map_zero]
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id] at hpre
    have happ := congrArg (fun φ => (φ.app (Opposite.op U)).hom s) hpre
    simpa only [CategoryTheory.NatTrans.app_nsmul, CategoryTheory.NatTrans.id_app,
      CategoryTheory.NatTrans.app_zero, AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id,
      AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply,
      AddMonoidHom.zero_apply] using happ
  let GalSub : Type u :=
    { E : IntermediateField K K_sep // FiniteDimensional K ↥E ∧ IsGalois K ↥E }
  have hEt_of : ∀ (L : GalSub), AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥L.1))) := by
    intro L
    have _ : FiniteDimensional K ↥L.1 := L.2.1
    have _ : IsGalois K ↥L.1 := L.2.2
    have _ : Algebra.IsSeparable K ↥L.1 := IsGalois.to_isSeparable
    exact (hEtSurj ↥L.1).1
  let U_of : GalSub → S_K.Etale := fun L =>
    (weilAltCdFieldEtaleMap (hEt_of L)).obj
      (CategoryTheory.MorphismProperty.Over.mk ⊤
        (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of ↥L.1)))
        inferInstance)
  let π_of : ∀ {L₁ L₂ : GalSub}, L₁.1 ≤ L₂.1 → (U_of L₂ ⟶ U_of L₁) :=
    fun {L₁ L₂} h =>
      CategoryTheory.MorphismProperty.Over.homMk
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IntermediateField.inclusion h).toRingHom))
        (by
          change AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (IntermediateField.inclusion h).toRingHom) ≫
            (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥L₁.1)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥L₁.1))) =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥L₂.1)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥L₂.1))
          rw [Category.id_comp, Category.id_comp, ← AlgebraicGeometry.Spec.map_comp]
          congr 1)
  have hπ_id : ∀ (L : GalSub), π_of (le_refl L.1) = 𝟙 (U_of L) := by
    intro L
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    change AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (IntermediateField.inclusion (le_refl L.1)).toRingHom) = _
    have hid : CommRingCat.ofHom (IntermediateField.inclusion (le_refl L.1)).toRingHom =
        𝟙 (CommRingCat.of ↥L.1) := by
      apply CommRingCat.hom_ext
      ext x
      rfl
    rw [hid, AlgebraicGeometry.Spec.map_id]
    rfl
  have hπ_comp : ∀ {L₁ L₂ L₃ : GalSub} (h₁₂ : L₁.1 ≤ L₂.1) (h₂₃ : L₂.1 ≤ L₃.1),
      π_of (h₁₂.trans h₂₃) = π_of h₂₃ ≫ π_of h₁₂ := by
    intro L₁ L₂ L₃ h₁₂ h₂₃
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    change AlgebraicGeometry.Spec.map _ =
      AlgebraicGeometry.Spec.map _ ≫ AlgebraicGeometry.Spec.map _
    rw [← AlgebraicGeometry.Spec.map_comp]
    congr 1
  have hEndToAlg : ∀ (L : GalSub) (u : U_of L ⟶ U_of L),
      ∃ φ : ↥L.1 →ₐ[K] ↥L.1,
        u.left = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ.toRingHom) := by
    intro L u
    let S_L : Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of ↥L.1)
    let π_L : S_L ⟶ S_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥L.1))
    let u_sch : S_L ⟶ S_L := u.left
    let r_u : CommRingCat.of ↥L.1 ⟶ CommRingCat.of ↥L.1 :=
      (AlgebraicGeometry.Spec.fullyFaithful.preimage u_sch).unop
    have hr_map : AlgebraicGeometry.Spec.map r_u = u_sch :=
