  · intro S₁ S₂ h T₁ T₁' hT₁ hT₁' T₂ T₂' hT₂ hT₂' A
    let B := weilEtaleSitePullback h
    let J₁ := S₁.smallEtaleTopology
    let J₂ := S₂.smallEtaleTopology
    let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    let shAdj₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
    let shAdj₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
    let PA₁ := (CategoryTheory.Functor.const (S₁.Etale)ᵒᵖ).obj A
    let PA₂ := (CategoryTheory.Functor.const (S₂.Etale)ᵒᵖ).obj A
    have hFormula : ∀ {Ta : S₁.Etale} (hTa : CategoryTheory.Limits.IsTerminal Ta)
        {Tb : S₂.Etale} (hTb : CategoryTheory.Limits.IsTerminal Tb),
        weilEtaleConstPullbackHom h hTa hTb A =
          (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).symm
            ((shAdj₂.homEquiv PA₂ (P_push.obj (C₁.obj A))).symm
              (CategoryTheory.Functor.whiskerLeft B.op (shAdj₁.unit.app PA₁))) := by
      intro Ta hTa Tb hTb
      dsimp [weilEtaleConstPullbackHom]
      congr 1
      let cpAdj₁ := CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hTa
      let cpAdj₂ := CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hTb
      let f₀ : A ⟶ (P_push.obj (C₁.obj A)).obj.obj (Opposite.op Tb) :=
        ((cpAdj₁.comp shAdj₁).unit.app A) ≫ (C₁.obj A).obj.map (hTa.from (B.obj Tb)).op
      change ((cpAdj₂.comp shAdj₂).homEquiv A (P_push.obj (C₁.obj A))).symm f₀ = _
      rw [CategoryTheory.Adjunction.comp_homEquiv, Equiv.symm_trans_apply]
      congr 1
      let θ := (cpAdj₂.homEquiv A (P_push.obj (C₁.obj A)).obj).symm f₀
      change θ = CategoryTheory.Functor.whiskerLeft B.op (shAdj₁.unit.app PA₁)
      have hθ_top : θ.app (Opposite.op Tb) = f₀ := by
        have hu := CategoryTheory.Adjunction.homEquiv_unit cpAdj₂ A (P_push.obj (C₁.obj A)).obj θ
        have happ := (cpAdj₂.homEquiv A (P_push.obj (C₁.obj A)).obj).apply_symm_apply f₀
        rw [hu] at happ
        have hunit₂ : cpAdj₂.unit.app A = 𝟙 A := rfl
        simpa [hunit₂] using happ
      let u_Ta : A ⟶ (C₁.obj A).obj.obj (Opposite.op Ta) :=
        (shAdj₁.unit.app PA₁).app (Opposite.op Ta)
      have hf₀_eq : f₀ = u_Ta ≫ (C₁.obj A).obj.map (hTa.from (B.obj Tb)).op := by
        dsimp [f₀]
        rw [CategoryTheory.Adjunction.comp_unit_app]
        have hunit₁ : cpAdj₁.unit.app A = 𝟙 A := rfl
        rw [hunit₁, CategoryTheory.Category.id_comp]
        rfl
      apply CategoryTheory.NatTrans.ext
      funext U₂_op
      cases U₂_op with | op U₂ =>
      let u₂ : U₂ ⟶ Tb := hTb.from U₂
      let u_BU₂ : A ⟶ (C₁.obj A).obj.obj (Opposite.op (B.obj U₂)) :=
        (shAdj₁.unit.app PA₁).app (Opposite.op (B.obj U₂))
      have hnat₂ := θ.naturality u₂.op
      change 𝟙 A ≫ θ.app (Opposite.op U₂) =
        θ.app (Opposite.op Tb) ≫ (P_push.obj (C₁.obj A)).obj.map u₂.op at hnat₂
      rw [CategoryTheory.Category.id_comp] at hnat₂
      rw [hnat₂, hθ_top, hf₀_eq]
      change (u_Ta ≫ (C₁.obj A).obj.map (hTa.from (B.obj Tb)).op) ≫
          (C₁.obj A).obj.map (B.map u₂).op = u_BU₂
      have hmap_u : (C₁.obj A).obj.map (hTa.from (B.obj Tb)).op ≫
          (C₁.obj A).obj.map (B.map u₂).op =
          (C₁.obj A).obj.map (hTa.from (B.obj U₂)).op := by
        rw [← (C₁.obj A).obj.map_comp]
        congr 1
