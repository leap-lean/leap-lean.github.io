      change (ξ_π ≫ L_X.obj.map (Opposite.op (B_π.map v_Y))) ≫ L_X.obj.map (Opposite.op σ'_e) =
        (ξ'_π ≫ locX_BU) ≫ L_X.obj.map (Opposite.op σ'_e)
      rw [CategoryTheory.Category.assoc,
        ← hMapOpComp L_X.obj σ'_e (B_π.map v_Y), hσ_nat,
        hMapOpComp L_X.obj v_X σ_e,
        ← CategoryTheory.Category.assoc, h1,
        CategoryTheory.Category.assoc, hnat_loc,
        ← CategoryTheory.Category.assoc, h2, h_id_loc, hLocX]

theorem weil_etale_bockstein_and_degenerate_leray_ext_calculus : (∀ {X Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom X Y)
