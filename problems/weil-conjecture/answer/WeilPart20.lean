      ((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT').unit.app A :
          A ⟶ (C.obj A).obj.obj (Opposite.op T')) =
        ((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT).unit.app A :
            A ⟶ (C.obj A).obj.obj (Opposite.op T)) ≫
          (C.obj A).obj.map α.op := by
    intro S T T' hT hT' α A J C
    let u := (CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit.app
      ((CategoryTheory.Functor.const (S.Etale)ᵒᵖ).obj A)
    let uT : A ⟶ (C.obj A).obj.obj (Opposite.op T) := u.app (Opposite.op T)
