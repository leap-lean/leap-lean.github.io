        have hu : u ≫ B.arrow = A.arrow :=
          hKer.fac (Limits.KernelFork.ofι A.arrow h0) Limits.WalkingParallelPair.zero
        simpa only [Subobject.mk_arrow] using Subobject.mk_le_mk_of_comm u hu
    have hSubTop : ∀ {W : 𝒜} (M : Subobject W),
