    have hs_E_pt : s_E.base pt_Ω = q_z := by
      change PrimeSpectrum.comap σ_E (⊥ : PrimeSpectrum Ω) = q_z
      ext x
      change σ_E x ∈ (⊥ : Ideal Ω) ↔ x ∈ q_z.asIdeal
      rw [Ideal.mem_bot, ← RingHom.mem_ker, hker_eq]
    refine ⟨s_E ≫ hAff.fromSpec, ?_, ?_⟩
    · change s_E ≫ f_E = 𝟙 S_Ω
      rw [← hmap_φ, ← AlgebraicGeometry.Spec.map_comp, hσ_comp, AlgebraicGeometry.Spec.map_id]
    · simp [hs_E_pt, hqz]

  
  have hSkyAdj : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
