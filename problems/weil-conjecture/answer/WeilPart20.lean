      let i_pre : P_b 0 S_ex.X₁ ⟶ P_b 0 S_ex.X₂ := p_map 0 S_ex.f
      let π_pre : P_b 0 S_ex.X₂ ⟶ P_b 0 S_ex.X₃ := p_map 0 S_ex.g
