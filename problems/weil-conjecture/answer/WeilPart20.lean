      (ιℤ_std π₂) (hιℤ_std_comp π₂).1 (hιℤ_std_comp π₂).2).2
      (weilEtaleLocalTorsionMap Y₂.left (ℓ ^ r) v₂)
      (weilEtaleLocalTorsionMap W_bar.left (ℓ ^ r) v_W)
      (α_leg W_bar Y₂ π₂ U'_W U'₂ e'_leg2 hU'₂_comm_tr (ℓ ^ r))
      (α_leg W_bar Y₂ π₂ U_W U₂ e_leg2 hSpec.2.2.2.2.2 (ℓ ^ r))
      hSq₂ q y₂'
    change Φ₂ (Φ₁.symm (weilEtaleLocalTorsionMapH Y₁.left (ℓ ^ r) v₁ q z)) =
      weilEtaleLocalTorsionMapH Y₂.left (ℓ ^ r) v₂ q y₂'
    apply Φ₂.symm.injective
    rw [Φ₂.symm_apply_apply]
    have hN1 : weilEtaleLocalTorsionMapH W_bar.left (ℓ ^ r) v_W q (Φ'₁.symm z) =
        Φ₁.symm (weilEtaleLocalTorsionMapH Y₁.left (ℓ ^ r) v₁ q z) := hNat₁
    have hN2 : weilEtaleLocalTorsionMapH W_bar.left (ℓ ^ r) v_W q (Φ'₂.symm y₂') =
        Φ₂.symm (weilEtaleLocalTorsionMapH Y₂.left (ℓ ^ r) v₂ q y₂') := hNat₂
    have hy₂' : Φ'₂.symm y₂' = Φ'₁.symm z := Φ'₂.symm_apply_apply _
    rw [hy₂'] at hN2
    exact hN1.symm.trans hN2

  · 
    intro Y₁ Y₂ U₁ U₂ e h r q z
    have : AlgebraicGeometry.IsProper Y₁.hom := h.1
    have : AlgebraicGeometry.IsProper Y₂.hom := h.2.1
    have : AlgebraicGeometry.IsAffine
        ((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).obj U₁).left := h.2.2.1
    let hc := hCanComp Y₁ Y₂ U₁ U₂ e h
    let W_bar := Classical.choose hc
    let hc1 := Classical.choose_spec hc
    let π₁ := Classical.choose hc1
    let hc2 := Classical.choose_spec hc1
    let π₂ := Classical.choose hc2
    let hc3 := Classical.choose_spec hc2
    let j := Classical.choose hc3
    let hSpec := Classical.choose_spec hc3
    have : AlgebraicGeometry.IsProper W_bar.hom := hSpec.1
    have : AlgebraicGeometry.IsOpenImmersion j := hSpec.2.2.2.1
    have : AlgebraicGeometry.IsProper π₁ := by
      have : AlgebraicGeometry.IsProper (π₁ ≫ Y₁.hom) := by rw [hSpec.2.1]; infer_instance
      exact AlgebraicGeometry.IsProper.of_comp π₁ Y₁.hom
    have : AlgebraicGeometry.IsProper π₂ := by
      have : AlgebraicGeometry.IsProper (π₂ ≫ Y₂.hom) := by rw [hSpec.2.2.1]; infer_instance
      exact AlgebraicGeometry.IsProper.of_comp π₂ Y₂.hom
    let U_W : W_bar.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ j inferInstance
    have : AlgebraicGeometry.IsAffine
        ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).left := h.2.2.1
    let e_id : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).obj U₁).left :=
      CategoryTheory.Iso.refl _
    let e_leg2 : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).obj U₂).left := e
    have hU₁_comm : CategoryTheory.CategoryStruct.comp
        (((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).hom) π₁ =
      CategoryTheory.CategoryStruct.comp e_id.hom
        (((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).obj U₁).hom) :=
      hSpec.2.2.2.2.1.trans (CategoryTheory.Category.id_comp _).symm
    let φ_cast := (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))).toAddMonoidHom
    let hEx₁ := hClopenPkg π₁ U_W U₁ e_id hU₁_comm
    let hEx₂ := hClopenPkg π₂ U_W U₂ e_leg2 hSpec.2.2.2.2.2
    have hSq₁ := (Classical.choose_spec (Classical.choose_spec hEx₁)).2.2.2.2
      (ℓ ^ (r + 1)) (ℓ ^ r) φ_cast
    have hSq₂ := (Classical.choose_spec (Classical.choose_spec hEx₂)).2.2.2.2
      (ℓ ^ (r + 1)) (ℓ ^ r) φ_cast
    let c_φ := AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ_cast)
    let trMap := fun (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) =>
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
        (CategoryTheory.CategoryStruct.comp c_φ
          (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S (ℓ ^ r) U))))
    have hNat₁ := (hLerayPkg π₁
      (weilEtaleIdTerminalIsTerminal W_bar.left)
      (weilEtaleIdTerminalIsTerminal Y₁.left)
      (ιℤ_std π₁) (hιℤ_std_comp π₁).1 (hιℤ_std_comp π₁).2).2
      (trMap Y₁.left U₁) (trMap W_bar.left U_W)
      (α_leg W_bar Y₁ π₁ U_W U₁ e_id hU₁_comm (ℓ ^ (r + 1)))
      (α_leg W_bar Y₁ π₁ U_W U₁ e_id hU₁_comm (ℓ ^ r))
      hSq₁ q z
    let Φ₁_succ := Φ_leg W_bar Y₁ π₁ U_W U₁ e_id hSpec.2.1 hU₁_comm (r + 1) q
    let Φ₂_succ := Φ_leg W_bar Y₂ π₂ U_W U₂ e_leg2 hSpec.2.2.1 hSpec.2.2.2.2.2 (r + 1) q
    let Φ₁_curr := Φ_leg W_bar Y₁ π₁ U_W U₁ e_id hSpec.2.1 hU₁_comm r q
    let Φ₂_curr := Φ_leg W_bar Y₂ π₂ U_W U₂ e_leg2 hSpec.2.2.1 hSpec.2.2.2.2.2 r q
    let y₂_succ := Φ₂_succ (Φ₁_succ.symm z)
    have hNat₂ := (hLerayPkg π₂
      (weilEtaleIdTerminalIsTerminal W_bar.left)
      (weilEtaleIdTerminalIsTerminal Y₂.left)
      (ιℤ_std π₂) (hιℤ_std_comp π₂).1 (hιℤ_std_comp π₂).2).2
      (trMap Y₂.left U₂) (trMap W_bar.left U_W)
      (α_leg W_bar Y₂ π₂ U_W U₂ e_leg2 hSpec.2.2.2.2.2 (ℓ ^ (r + 1)))
      (α_leg W_bar Y₂ π₂ U_W U₂ e_leg2 hSpec.2.2.2.2.2 (ℓ ^ r))
      hSq₂ q y₂_succ
    change weilEtaleLocalTorsionTransition Y₂.left ℓ r U₂ q y₂_succ =
      Φ₂_curr (Φ₁_curr.symm (weilEtaleLocalTorsionTransition Y₁.left ℓ r U₁ q z))
    apply Φ₂_curr.symm.injective
    rw [Φ₂_curr.symm_apply_apply]
    have hN1 : weilEtaleLocalTorsionTransition W_bar.left ℓ r U_W q (Φ₁_succ.symm z) =
        Φ₁_curr.symm (weilEtaleLocalTorsionTransition Y₁.left ℓ r U₁ q z) := hNat₁
    have hN2 : weilEtaleLocalTorsionTransition W_bar.left ℓ r U_W q (Φ₂_succ.symm y₂_succ) =
        Φ₂_curr.symm (weilEtaleLocalTorsionTransition Y₂.left ℓ r U₂ q y₂_succ) := hNat₂
    have hy₂ : Φ₂_succ.symm y₂_succ = Φ₁_succ.symm z := Φ₂_succ.symm_apply_apply _
    rw [hy₂] at hN2
    exact hN2.symm.trans hN1

  · 
    intro W_bar Y π U_W U_Y e h hπ_hom hU_comm
      Fgt_W Fgt_Y B_π J_W J_Y Aℤ_loc Fℤ_W Fℤ_Y
      _hCont _hAdj
      pf_π pb_π adj_π
      _hAdd _hLim _hColim T_W hT_W T_Y hT_Y ιℤ σ_e r α_π
      p_fst πℤ L_Y L_W ξ
      hι1 hι2 hσ hξ1 hξ2 q z
    have : AlgebraicGeometry.IsProper W_bar.hom := h.1
    have : AlgebraicGeometry.IsProper Y.hom := h.2.1
    have : AlgebraicGeometry.IsAffine
        ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).left := h.2.2.1
    have : AlgebraicGeometry.IsProper π := by
      have : AlgebraicGeometry.IsProper (π ≫ Y.hom) := by rw [hπ_hom]; infer_instance
      exact AlgebraicGeometry.IsProper.of_comp π Y.hom
    let idW := CategoryTheory.CategoryStruct.id W_bar.left
    have : AlgebraicGeometry.IsProper idW := by
      dsimp [idW]
      infer_instance
    let reflW := CategoryTheory.Iso.refl
      ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).left
    have hId_hom : CategoryTheory.CategoryStruct.comp idW W_bar.hom = W_bar.hom :=
      CategoryTheory.Category.id_comp W_bar.hom
    have hUW_id : CategoryTheory.CategoryStruct.comp
        (((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).hom) idW =
      CategoryTheory.CategoryStruct.comp reflW.hom
        (((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).hom) :=
      (CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm
    have hU_tr : CategoryTheory.CategoryStruct.comp
        (((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).hom) π =
      CategoryTheory.CategoryStruct.comp (CategoryTheory.Iso.trans reflW e).hom
        (((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U_Y).hom) := by
      change _ = (𝟙 _ ≫ e.hom) ≫ _
      rw [CategoryTheory.Category.id_comp]
      exact hU_comm
    have hΨ_leg := hΨ_indep W_bar Y U_W U_Y e h W_bar idW π U_W reflW
      hId_hom hπ_hom hUW_id hU_tr r q
    have he_tr : CategoryTheory.Iso.trans reflW e = e := by
      ext
      exact CategoryTheory.Category.id_comp _
    have hΦ_tr : Φ_leg W_bar Y π U_W U_Y (CategoryTheory.Iso.trans reflW e) hπ_hom hU_tr r q =
        Φ_leg W_bar Y π U_W U_Y e hπ_hom hU_comm r q :=
      hΦ_congr W_bar Y U_W U_Y rfl he_tr hπ_hom hπ_hom hU_tr hU_comm r q
    have hId_eq := hΦ_id W_bar U_W r q
    have hΨ_eq : Ψ W_bar Y U_W U_Y e h r q = Φ_leg W_bar Y π U_W U_Y e hπ_hom hU_comm r q := by
      rw [hΨ_leg, hΦ_tr, hId_eq]
      ext x
      rfl
    rw [hΨ_eq]
    change pullH_std π (α_leg W_bar Y π U_W U_Y e hU_comm (ℓ ^ r)) q z = _
    cases Subsingleton.elim _hCont (hc_all π)
    cases Subsingleton.elim _hAdj (hr_all π)
    cases Subsingleton.elim _hAdd (hSiteExact π).1
    cases Subsingleton.elim _hLim (hSiteExact π).2.2.1
    cases Subsingleton.elim _hColim (hSiteExact π).2.2.2
    have hπℤ_eq : πℤ = πℤ_std π :=
      hConstIndep π hT_W (weilEtaleIdTerminalIsTerminal W_bar.left)
        hT_Y (weilEtaleIdTerminalIsTerminal Y.left) Aℤ
    have hι_eq : ιℤ = ιℤ_std π := by
      calc
        ιℤ = ιℤ ≫ 𝟙 _ := (CategoryTheory.Category.comp_id _).symm
        _ = ιℤ ≫ (πℤ_std π ≫ ιℤ_std π) := by rw [(hιℤ_std_comp π).2]
        _ = (ιℤ ≫ πℤ) ≫ ιℤ_std π := by
          rw [← hπℤ_eq, CategoryTheory.Category.assoc]
        _ = 𝟙 _ ≫ ιℤ_std π := by rw [hι1]
        _ = ιℤ_std π := CategoryTheory.Category.id_comp _
    let hEx := hClopenPkg π U_W U_Y e hU_comm
    let σ_std := Classical.choose hEx
    let hSpec := Classical.choose_spec (Classical.choose_spec hEx)
    have hσ_eq : σ_e = σ_std := hSpec.2.1 σ_e hσ
    subst hσ_eq
    have hα_eq : α_π = α_leg W_bar Y π U_W U_Y e hU_comm (ℓ ^ r) :=
      (hSpec.2.2.1 (ℓ ^ r)).2.2 α_π hξ1 hξ2
    dsimp only [adj_π, Fℤ_W, Fℤ_Y, pb_π, B_π, J_W, J_Y, Aℤ_loc, L_Y, L_W]
    rw [hι_eq, hα_eq]
