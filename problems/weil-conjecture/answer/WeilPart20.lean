        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IntermediateField.inclusion h₀).toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀.toRingHom)
      rw [hu₃_eq, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
    have hGalW₃ : ∀ (u₃ : U_of L₃ ⟶ U_of L₃), ∀ w ∈ W₃, (G.obj.map u₃.op).hom w ∈ W₃ := by
      intro u₃ w hw
      obtain ⟨a, ⟨w₁, hw₁, rfl⟩, b, ⟨w₂, hw₂, rfl⟩, rfl⟩ := AddSubgroup.mem_sup.mp hw
      rw [map_add]
      obtain ⟨u₁, hu₁⟩ := hRestr L₁ h₁ u₃
      obtain ⟨u₂, hu₂⟩ := hRestr L₂ h₂ u₃
      refine W₃.add_mem ?_ ?_
      · refine AddSubgroup.mem_sup_left ⟨(G.obj.map u₁.op).hom w₁, j₁.2.2 u₁ w₁ hw₁, ?_⟩
        rw [← hMapComp (π_of h₁) u₁ w₁, ← hu₁, hMapComp u₃ (π_of h₁) w₁]
      · refine AddSubgroup.mem_sup_right ⟨(G.obj.map u₂.op).hom w₂, j₂.2.2 u₂ w₂ hw₂, ?_⟩
        rw [← hMapComp (π_of h₂) u₂ w₂, ← hu₂, hMapComp u₃ (π_of h₂) w₂]
    let j₃ : Idx := ⟨⟨L₃, W₃⟩, hFinW₃, hGalW₃⟩
    exact ⟨j₃, ⟨⟨⟨h₁, fun w hw => AddSubgroup.mem_sup_left ⟨w, hw, rfl⟩⟩⟩⟩,
      ⟨⟨⟨⟨h₂, fun w hw => AddSubgroup.mem_sup_right ⟨w, hw, rfl⟩⟩⟩⟩⟩⟩
  let filtIdx : CategoryTheory.IsFiltered Idx :=
    { nonempty := hNeIdx
      cocone_objs := fun j₁ j₂ =>
