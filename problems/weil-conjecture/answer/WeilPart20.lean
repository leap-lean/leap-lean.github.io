    hExtColim q Λ_F D_F (fun j => hNoethExt (D_F.obj j) (hD_Noeth j))
  refine ⟨fun x y => ?_⟩
  have hzero : ∀ z : CategoryTheory.Abelian.Ext.{u} oneR F q, z = 0 := by
    intro z
    have hz_inv : z.comp (CategoryTheory.Abelian.Ext.mk₀ e_F.inv) (Nat.add_zero q) = 0 :=
      @Subsingleton.elim _ hSubColim _ 0
    calc
      z = z.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id F))
            (Nat.add_zero q) := by simp
      _ = z.comp (CategoryTheory.Abelian.Ext.mk₀
            (CategoryTheory.CategoryStruct.comp e_F.inv e_F.hom))
            (Nat.add_zero q) := by
          rw [e_F.inv_hom_id]
      _ = (z.comp (CategoryTheory.Abelian.Ext.mk₀ e_F.inv) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ e_F.hom) (Nat.add_zero q) := by
          rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ e_F.inv e_F.hom,
            ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
              (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q)]
      _ = 0 := by
          rw [hz_inv, CategoryTheory.Abelian.Ext.zero_comp]
  rw [hzero x, hzero y]

theorem weil_etale_ind_godement_truncated_complex_of_noetherian_generators (S : AlgebraicGeometry.Scheme.{u}) (d m : ℕ) (hm : 1 ≤ m) :
    let R := ULift.{u, 0} (ZMod m)
    let J := S.smallEtaleTopology
    let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
    let oneR := weilEtaleModuleUnit S m
    let T_S : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.id S)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S))
    let Γ_S : CategoryTheory.Functor 𝒞 (ModuleCat.{u, u} R) :=
      CategoryTheory.Functor.comp (CategoryTheory.sheafToPresheaf J (ModuleCat.{u, u} R))
        ((CategoryTheory.evaluation (Opposite S.Etale) (ModuleCat.{u, u} R)).obj (Opposite.op T_S))
    WeilHasOrdinaryGodementResolution S m →
    (∀ (q : ℕ), 2 * d < q → ∀ (F : 𝒞),
      Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR F q)) →
    (∀ (Q : 𝒞), CategoryTheory.IsNoetherianObject Q →
      CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u}
        (CategoryTheory.coyoneda.obj (Opposite.op Q))) →
    (∃ (I₀ : Type u) (L : I₀ → 𝒞),
      (CategoryTheory.ObjectProperty.ofObj L).IsSeparating ∧
      ∀ i : I₀, CategoryTheory.IsNoetherianObject (L i)) →
    CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u} Γ_S →
    (∀ (k : ℕ), 1 ≤ k →
      ∀ (Λ : Type u) [CategoryTheory.SmallCategory Λ] [CategoryTheory.IsFiltered Λ]
        (D : CategoryTheory.Functor Λ 𝒞),
        (∀ j : Λ, Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (D.obj j) k)) →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (CategoryTheory.Limits.colimit D) k)) →
    WeilHasTruncatedGodementComplex S d m :=
by
  classical
  have _ := hm
  intro R J 𝒞 oneR T_S Γ_S hOrd hCD hNoethCompact hNoethGen hΓ hExtColim
  
  
  
  have hPillar1 : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒜]
      [CategoryTheory.Abelian 𝒜],
      (∃ (I₀ : Type u) (L : I₀ → 𝒜),
        (CategoryTheory.ObjectProperty.ofObj L).IsSeparating ∧
        ∀ i : I₀, CategoryTheory.IsNoetherianObject (L i)) →
      (∀ {X Y : 𝒜} (f : X ⟶ Y) [CategoryTheory.Epi f],
        CategoryTheory.IsNoetherianObject X → CategoryTheory.IsNoetherianObject Y) ∧
      (∀ (F : 𝒜),
        (∃ (P₀ : CategoryTheory.Subobject F), CategoryTheory.IsNoetherianObject (P₀ : 𝒜)) ∧
        ∀ (P₁ P₂ : CategoryTheory.Subobject F),
          CategoryTheory.IsNoetherianObject (P₁ : 𝒜) →
          CategoryTheory.IsNoetherianObject (P₂ : 𝒜) →
          ∃ (Q : CategoryTheory.Subobject F),
            CategoryTheory.IsNoetherianObject (Q : 𝒜) ∧ P₁ ≤ Q ∧ P₂ ≤ Q) ∧
      (∀ {E Q : 𝒜} (π : E ⟶ Q) [CategoryTheory.Epi π],
        CategoryTheory.IsNoetherianObject Q →
        ∃ (P : CategoryTheory.Subobject E),
          CategoryTheory.IsNoetherianObject (P : 𝒜) ∧
          CategoryTheory.Epi (P.arrow ≫ π)) ∧
      (∀ (F : 𝒜) (M : CategoryTheory.Subobject F),
        (∀ (P : CategoryTheory.Subobject F), CategoryTheory.IsNoetherianObject (P : 𝒜) → P ≤ M) →
        M = ⊤) := by
    intro 𝒜 _ _ ⟨I₀, L, hIsSep, hLNoeth⟩
    have hSubLE : ∀ {W : 𝒜} (A B : Subobject W),
        A ≤ B ↔ A.arrow ≫ Limits.cokernel.π B.arrow = 0 := by
      intro W A B
      constructor
      · intro h
        rw [← Subobject.ofLE_arrow h, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
      · intro h0
        have hEx := ShortComplex.exact_cokernel B.arrow
        have hKer := hEx.fIsKernel
