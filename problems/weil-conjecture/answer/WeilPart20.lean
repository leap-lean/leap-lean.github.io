    have hQuot : ∀ {X Y : 𝒜} (f : X ⟶ Y) [Epi f],
        IsNoetherianObject X → IsNoetherianObject Y := by
      intro X Y f _ hX
      rw [isNoetherianObject_iff_monotone_chain_condition] at hX ⊢
      intro c
      let c' : ℕ →o Subobject X :=
        { toFun := fun n => pbSub f (c n)
          monotone' := fun _ _ h => hPbMono f (c.monotone h) }
      obtain ⟨N, hN⟩ := hX c'
      refine ⟨N, fun n hn => le_antisymm (c.monotone hn) ?_⟩
      exact hPbRefl f (le_of_eq (hN n hn).symm)
    have hNoethIso : ∀ {X Y : 𝒜} (e : X ≅ Y),
        IsNoetherianObject X → IsNoetherianObject Y :=
      fun e hX => hQuot e.hom hX
