        let adj_s := (pt Ω S s).skyscraperSheafAdjunction (A := AddCommGrpCat.{u})
        have : F_s.IsLeftAdjoint := adj_s.isLeftAdjoint
        have : F_s.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products F_s
        have : CategoryTheory.IsIso (F_s.map φ) := hφ Ω s
