theorem weil_alt_cd_stalk_support_colimit_vanishing (k : Type u) [Field k] [IsAlgClosed k]
    (d ℓ q : ℕ)
    (hSubDim : ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsProper Z.hom],
      topologicalKrullDim Z.left ≤ (d : WithBot ℕ∞) →
      ∀ (𝒢 : CategoryTheory.Sheaf Z.left.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id 𝒢 = 0 →
        Subsingleton (𝒢.H q))
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper W.hom]
    (ℱ : CategoryTheory.Sheaf W.left.smallEtaleTopology AddCommGrpCat.{u})
    (hℓ_ℱ : ℓ • CategoryTheory.CategoryStruct.id ℱ = 0)
    (hSupp : ∀ x : ↥W.left,
      (d : WithBot ℕ∞) < topologicalKrullDim ↥(closure ({x} : Set ↥W.left)) →
      WeilAltCdStalkZeroAt W.left ℱ x) :
    Subsingleton (ℱ.H q) :=
by
  have : CompactSpace ↥W.left :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace W.hom
  have : W.left.IsSeparated := by
    rw [AlgebraicGeometry.Scheme.isSeparated_iff]
    have hSpecSep : (AlgebraicGeometry.Spec (CommRingCat.of k)).IsSeparated := inferInstance
    rw [AlgebraicGeometry.Scheme.isSeparated_iff] at hSpecSep
    have hEq : CategoryTheory.Limits.terminal.from W.left =
        W.hom ≫ CategoryTheory.Limits.terminal.from (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    rw [hEq]
    infer_instance
  obtain ⟨Idx, instSmall, instFilt, D, c, hc_pt, ⟨hc⟩, hMono, hClosedSupp⟩ :=
    weil_alt_cd_zero_outside_subsheaf_exhaustion k d W ℱ hSupp
  let : CategoryTheory.SmallCategory Idx := instSmall
  have : CategoryTheory.IsFiltered Idx := instFilt
  have hℓ_pt : ℓ • CategoryTheory.CategoryStruct.id c.pt = 0 := by
    rw [hc_pt]
    exact hℓ_ℱ
  have hVanishD : ∀ j : Idx, Subsingleton ((D.obj j).H q) := by
    intro j
    have : CategoryTheory.Mono (c.ι.app j) := hMono j
    have hℓ_Dj : ℓ • CategoryTheory.CategoryStruct.id (D.obj j) = 0 := by
      apply (CategoryTheory.cancel_mono (c.ι.app j)).mp
      rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
        CategoryTheory.Limits.zero_comp]
      calc
        ℓ • c.ι.app j = ℓ • (c.ι.app j ≫ CategoryTheory.CategoryStruct.id c.pt) :=
          congrArg (ℓ • ·) (CategoryTheory.Category.comp_id (c.ι.app j)).symm
        _ = c.ι.app j ≫ (ℓ • CategoryTheory.CategoryStruct.id c.pt) := by
          rw [CategoryTheory.Preadditive.comp_nsmul]
        _ = c.ι.app j ≫ 0 := by rw [hℓ_pt]
        _ = 0 := CategoryTheory.Limits.comp_zero
    obtain ⟨C, hDimC, hZeroC⟩ := hClosedSupp j
    let I_C := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C
    let Z_C := I_C.subscheme
    let i_C : Z_C ⟶ W.left := I_C.subschemeι
    let Z_C_over : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (CategoryTheory.CategoryStruct.comp i_C W.hom)
    have : AlgebraicGeometry.IsProper Z_C_over.hom :=
      show AlgebraicGeometry.IsProper (i_C ≫ W.hom) from inferInstance
    have hRange : Set.range i_C.base = (C : Set ↥W.left) :=
      (AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι I_C).trans
        (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal C)
    have hClEmb : Topology.IsClosedEmbedding i_C.base :=
      AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding i_C
    let f_C : ↥Z_C → ↥(C : Set ↥W.left) :=
      fun z => ⟨i_C.base z, hRange ▸ ⟨z, rfl⟩⟩
    have hf_cont : Continuous f_C :=
      i_C.base.hom.continuous.subtype_mk _
    have hf_ind : Topology.IsInducing f_C :=
      Topology.IsInducing.of_comp hf_cont continuous_subtype_val hClEmb.isInducing
    have hDimZ_C : topologicalKrullDim Z_C ≤ (d : WithBot ℕ∞) :=
      hf_ind.topologicalKrullDim_le.trans hDimC
    have hZeroOut : ∀ U : W.left.Etale,
        Set.range U.hom.base ⊆ (Set.range i_C.base)ᶜ →
        Subsingleton ↥((D.obj j).obj.obj (Opposite.op U)) := by
      intro U hU
      rw [hRange] at hU
      exact hZeroC U hU
    exact weil_alt_cd_closed_immersion_support_cohomology_vanishing
      i_C ℓ q (hSubDim Z_C_over hDimZ_C) (D.obj j) hℓ_Dj hZeroOut
  have hSubPt : Subsingleton (c.pt.H q) :=
    weil_alt_cd_filtered_colimit_sheaf_cohomology_vanishing W.left
      (fun Idx₀ _ _ D₀ c₀ hc₀ U _ _ =>
        weil_alt_cd_qcsep_etale_filtered_colimit_eval_iso W.left Idx₀ D₀ c₀ hc₀ U)
      Idx D c hc q hVanishD
  rwa [hc_pt] at hSubPt

theorem weil_alt_cd_c1_tsen_norm_surjective (κ K L : Type u) [Field κ] [IsAlgClosed κ]
    [Field K] [Algebra κ K] [Field L] [Algebra K L] [FiniteDimensional K L]
    (hFG : ∃ S : Finset K, IntermediateField.adjoin κ (S : Set K) = ⊤)
    (hTrdeg : Algebra.trdeg κ K ≤ 1) (c : K) :
    ∃ y : L, Algebra.norm K y = c :=
by
  
  have hAlgZero : ∀ (E V D : ℕ), E < V → 1 ≤ D →
      ∀ (P : Fin E → MvPolynomial (Fin V) κ),
        (∀ r : Fin E, (P r).IsHomogeneous D) →
        ∃ x : Fin V → κ, x ≠ 0 ∧ ∀ r : Fin E, MvPolynomial.eval x (P r) = 0 := by
    intro E V D hEV hD P hHom
    by_contra hNo
    have hZero : ∀ x : Fin V → κ, (∀ r : Fin E, MvPolynomial.eval x (P r) = 0) → x = 0 := by
      intro x hx
      by_contra hx0
      exact hNo ⟨x, hx0, hx⟩
    let I : Ideal (MvPolynomial (Fin V) κ) := Ideal.span (Set.range P)
    have hRad : ∀ i : Fin V, ∃ k : ℕ, (MvPolynomial.X i : MvPolynomial (Fin V) κ) ^ k ∈ I := by
      intro i
      have hmem : (MvPolynomial.X i : MvPolynomial (Fin V) κ) ∈
          MvPolynomial.vanishingIdeal κ (MvPolynomial.zeroLocus κ I) := by
        rw [MvPolynomial.mem_vanishingIdeal_iff]
        intro x hx
        rw [MvPolynomial.mem_zeroLocus_iff] at hx
        have hx0 : x = 0 := hZero x fun r => hx (P r) (Ideal.subset_span ⟨r, rfl⟩)
        subst hx0
        simp
      rw [MvPolynomial.vanishingIdeal_zeroLocus_eq_radical, Ideal.mem_radical_iff] at hmem
      exact hmem
    let k_exp : Fin V → ℕ := fun i => Classical.choose (hRad i)
    have hk_mem : ∀ i : Fin V, (MvPolynomial.X i : MvPolynomial (Fin V) κ) ^ (k_exp i) ∈ I :=
      fun i => Classical.choose_spec (hRad i)
    let N₀ : ℕ := D + 1 + ∑ i : Fin V, k_exp i
    have hdeg_eq : ∀ α : Fin V →₀ ℕ, Finsupp.degree α = ∑ i : Fin V, α i := by
      intro α
      change ∑ i ∈ α.support, α i = ∑ i : Fin V, α i
      exact Finset.sum_subset (Finset.subset_univ _) fun i _ hi =>
        Finsupp.notMem_support_iff.mp hi
    have hHighMem : ∀ (n : ℕ) (f : MvPolynomial (Fin V) κ),
        N₀ ≤ n → f.IsHomogeneous n → f ∈ I := by
      intro n f hn hf
      rw [MvPolynomial.as_sum f]
      refine I.sum_mem fun α hα => ?_
      have hcoeff_ne : f.coeff α ≠ 0 := MvPolynomial.mem_support_iff.mp hα
      have hdeg_α : Finsupp.degree α = n := by
        by_contra hne
        exact hcoeff_ne (hf.coeff_eq_zero hne)
      rw [hdeg_eq] at hdeg_α
      have hex_i : ∃ i₀ : Fin V, k_exp i₀ ≤ α i₀ := by
        by_contra! hlt
        have hsum_le : ∑ i : Fin V, α i ≤ ∑ i : Fin V, k_exp i :=
          Finset.sum_le_sum fun i _ => Nat.le_of_lt (hlt i)
        omega
      obtain ⟨i₀, hi₀⟩ := hex_i
      let β : Fin V →₀ ℕ := α - Finsupp.single i₀ (k_exp i₀)
      have hadd : Finsupp.single i₀ (k_exp i₀) + β = α := by
        ext j
        simp only [β, Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply]
        rcases eq_or_ne j i₀ with rfl | hj
        · simp only [Finsupp.single_eq_same]
          omega
        · simp [hj]
      have hmon_eq : MvPolynomial.monomial α (f.coeff α) =
          (MvPolynomial.X i₀ : MvPolynomial (Fin V) κ) ^ (k_exp i₀) *
            MvPolynomial.monomial β (f.coeff α) := by
        rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul_monomial, hadd, one_mul]
      rw [hmon_eq]
      exact I.mul_mem_right _ (hk_mem i₀)
    let φ_P : MvPolynomial (Fin E) κ →ₐ[κ] MvPolynomial (Fin V) κ := MvPolynomial.aeval P
    let S_alg : Subalgebra κ (MvPolynomial (Fin V) κ) := φ_P.range
    let F_box : Finset (Fin V → ℕ) := Fintype.piFinset fun _ : Fin V => Finset.range N₀
    let F_set : Set (MvPolynomial (Fin V) κ) :=
      (fun u : Fin V → ℕ => MvPolynomial.monomial (Finsupp.equivFunOnFinite.symm u) (1 : κ)) ''
        (F_box : Set (Fin V → ℕ))
    let M_sub : Submodule ↥S_alg (MvPolynomial (Fin V) κ) := Submodule.span ↥S_alg F_set
    have hHomInM : ∀ (n : ℕ) (h : MvPolynomial (Fin V) κ), h.IsHomogeneous n → h ∈ M_sub := by
      intro n
      induction n using Nat.strongRecOn with
      | ind n ih =>
        intro h hh
        by_cases hn : n < N₀
        · rw [MvPolynomial.as_sum h]
          refine M_sub.sum_mem fun α hα => ?_
          have hcoeff_ne : h.coeff α ≠ 0 := MvPolynomial.mem_support_iff.mp hα
          have hdeg_α : Finsupp.degree α = n := by
            by_contra hne
            exact hcoeff_ne (hh.coeff_eq_zero hne)
          rw [hdeg_eq] at hdeg_α
          have hmem_box : Finsupp.equivFunOnFinite α ∈ F_box := by
            rw [Fintype.mem_piFinset]
            intro i
            rw [Finset.mem_range]
            have hle : α i ≤ ∑ j : Fin V, α j :=
              Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
            change α i < N₀
            omega
          have hmon1 : MvPolynomial.monomial α (1 : κ) ∈ M_sub := by
            apply Submodule.subset_span
            exact ⟨Finsupp.equivFunOnFinite α, Finset.mem_coe.mpr hmem_box, by simp⟩
          have hsmul : (algebraMap κ ↥S_alg (h.coeff α)) • MvPolynomial.monomial α (1 : κ) =
              MvPolynomial.monomial α (h.coeff α) := by
            change MvPolynomial.C (h.coeff α) * MvPolynomial.monomial α (1 : κ) = _
            rw [MvPolynomial.C_mul_monomial, mul_one]
          rw [← hsmul]
          exact M_sub.smul_mem _ hmon1
        · have hN₀_le : N₀ ≤ n := Nat.le_of_not_lt hn
          have hh_I : h ∈ I := hHighMem n h hN₀_le hh
          obtain ⟨Q, hQ⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hh_I
          have hh_comp : (MvPolynomial.homogeneousComponent n) h = h := by
            simpa using MvPolynomial.homogeneousComponent_of_mem (m := n) hh
          rw [← hh_comp, ← hQ, map_sum]
          refine M_sub.sum_mem fun r _ => ?_
          change (MvPolynomial.homogeneousComponent n) (Q r * P r) ∈ M_sub
          rw [← MvPolynomial.sum_homogeneousComponent (Q r), Finset.sum_mul, map_sum]
          refine M_sub.sum_mem fun k _ => ?_
          have hmul_hom :
              ((MvPolynomial.homogeneousComponent k (Q r)) * P r).IsHomogeneous (k + D) :=
            (MvPolynomial.homogeneousComponent_isHomogeneous k (Q r)).mul (hHom r)
          rw [MvPolynomial.homogeneousComponent_of_mem hmul_hom]
          split_ifs with hnk
          · have hk_lt : k < n := by omega
            have hk_mem : MvPolynomial.homogeneousComponent k (Q r) ∈ M_sub :=
              ih k hk_lt _ (MvPolynomial.homogeneousComponent_isHomogeneous k (Q r))
            let p_S : ↥S_alg := ⟨P r, ⟨MvPolynomial.X r, MvPolynomial.aeval_X P r⟩⟩
            have hsmul_P : p_S • MvPolynomial.homogeneousComponent k (Q r) =
                MvPolynomial.homogeneousComponent k (Q r) * P r := by
              change P r * MvPolynomial.homogeneousComponent k (Q r) = _
              exact mul_comm _ _
            rw [← hsmul_P]
            exact M_sub.smul_mem p_S hk_mem
          · exact M_sub.zero_mem
    have hM_top : M_sub = ⊤ := by
      rw [eq_top_iff]
      intro g _
      rw [← MvPolynomial.sum_homogeneousComponent g]
      exact M_sub.sum_mem fun n _ =>
        hHomInM n _ (MvPolynomial.homogeneousComponent_isHomogeneous n g)
    have hFG_mod : Module.Finite ↥S_alg (MvPolynomial (Fin V) κ) :=
      Module.Finite.of_fg_top (Submodule.fg_def.mpr ⟨F_set, F_box.finite_toSet.image _, hM_top⟩)
    have : Algebra.IsIntegral ↥S_alg (MvPolynomial (Fin V) κ) :=
      Algebra.IsIntegral.of_finite ↥S_alg (MvPolynomial (Fin V) κ)
    have : Algebra.IsAlgebraic ↥S_alg (MvPolynomial (Fin V) κ) :=
      Algebra.IsIntegral.isAlgebraic
    have htr0 : Algebra.trdeg ↥S_alg (MvPolynomial (Fin V) κ) = 0 :=
      _root_.trdeg_eq_zero
    have htrV : Algebra.trdeg κ ↥S_alg = (V : Cardinal.{u}) := by
      have hadd := _root_.trdeg_add_eq κ ↥S_alg (A := MvPolynomial (Fin V) κ)
      rw [htr0, add_zero, MvPolynomial.trdeg_of_isDomain] at hadd
      simpa using hadd
    have htr_le : Algebra.trdeg κ ↥S_alg ≤ Algebra.trdeg κ (MvPolynomial (Fin E) κ) :=
      _root_.trdeg_le_of_surjective φ_P.rangeRestrict φ_P.rangeRestrict_surjective
    rw [htrV, MvPolynomial.trdeg_of_isDomain] at htr_le
    have hVE_card : (V : Cardinal.{u}) ≤ (E : Cardinal.{u}) := by simpa using htr_le
    have hVE : V ≤ E := Nat.cast_le.mp hVE_card
    omega

  
  have hPolyZero : ∀ (n W D : ℕ), 1 ≤ n → 1 ≤ D → D < W →
      ∀ (G : Fin n → MvPolynomial (Fin W × Fin n) (Polynomial κ)),
        (∀ u : Fin n, (G u).IsHomogeneous D) →
        ∃ z : Fin W × Fin n → Polynomial κ,
          z ≠ 0 ∧ ∀ u : Fin n, MvPolynomial.eval z (G u) = 0 := by
    intro n W D hn hD hDW G hGHom
    let B : ℕ := Finset.univ.sup fun u : Fin n =>
      (G u).support.sup fun α => ((G u).coeff α).natDegree
    have hB_bound : ∀ (u : Fin n) (α : (Fin W × Fin n) →₀ ℕ),
        ((G u).coeff α).natDegree ≤ B := by
      intro u α
      by_cases hα : α ∈ (G u).support
      · exact le_trans (Finset.le_sup (f := fun α => ((G u).coeff α).natDegree) hα)
          (Finset.le_sup (f := fun u : Fin n =>
            (G u).support.sup fun α => ((G u).coeff α).natDegree) (Finset.mem_univ u))
      · rw [MvPolynomial.notMem_support_iff.mp hα, Polynomial.natDegree_zero]
        exact Nat.zero_le _
    let M : ℕ := B + 2
    let K_deg : ℕ := (D + 1) * (B + 1)
    let E : ℕ := n * K_deg
    let V : ℕ := (W * n) * M
    have hEV : E < V := by
      have hKM : K_deg < W * M := by
        calc
          K_deg = (D + 1) * (B + 1) := rfl
          _ < (D + 1) * (B + 2) := Nat.mul_lt_mul_of_pos_left (by omega) (by omega)
          _ ≤ W * M := Nat.mul_le_mul_right M hDW
      calc
        E = n * K_deg := rfl
        _ < n * (W * M) := Nat.mul_lt_mul_of_pos_left hKM hn
        _ = (W * n) * M := by ring
    let eV : (Fin W × Fin n) × Fin M ≃ Fin V :=
      (finProdFinEquiv.prodCongr (Equiv.refl (Fin M))).trans finProdFinEquiv
    let eE : Fin n × Fin K_deg ≃ Fin E := finProdFinEquiv
    let A := MvPolynomial (Fin V) κ
    let ι_coeff : Polynomial κ →+* Polynomial A := Polynomial.mapRingHom MvPolynomial.C
    let Z_poly : Fin W × Fin n → Polynomial A :=
      fun w => ∑ j : Fin M, Polynomial.monomial (j : ℕ) (MvPolynomial.X (eV (w, j)))
    let Ψ : Fin n → Polynomial A := fun u => MvPolynomial.eval₂ ι_coeff Z_poly (G u)
    let Good : ℕ → ℕ → Polynomial A → Prop := fun m L Q =>
      (∀ k : ℕ, (Q.coeff k).IsHomogeneous m) ∧ (∀ k : ℕ, L < k → Q.coeff k = 0)
    have hGood_one : Good 0 0 1 := by
      refine ⟨fun k => ?_, fun k hk => ?_⟩
      · rcases eq_or_ne k 0 with rfl | hk0
        · rw [Polynomial.coeff_one_zero]
          simpa using MvPolynomial.isHomogeneous_C (Fin V) (1 : κ)
        · simp [Polynomial.coeff_one, hk0, MvPolynomial.isHomogeneous_zero]
      · have hk0 : k ≠ 0 := by omega
        simp [Polynomial.coeff_one, hk0]
    have hGood_mul : ∀ {m₁ L₁ m₂ L₂ : ℕ} {Q₁ Q₂ : Polynomial A},
        Good m₁ L₁ Q₁ → Good m₂ L₂ Q₂ → Good (m₁ + m₂) (L₁ + L₂) (Q₁ * Q₂) := by
      intro m₁ L₁ m₂ L₂ Q₁ Q₂ h₁ h₂
      refine ⟨fun k => ?_, fun k hk => ?_⟩
      · rw [Polynomial.coeff_mul]
        exact MvPolynomial.IsHomogeneous.sum _ _ _ fun ij _ => (h₁.1 ij.1).mul (h₂.1 ij.2)
      · rw [Polynomial.coeff_mul]
        refine Finset.sum_eq_zero fun ij hij => ?_
        have hsum : ij.1 + ij.2 = k := Finset.HasAntidiagonal.mem_antidiagonal.mp hij
        by_cases hi : L₁ < ij.1
        · rw [h₁.2 ij.1 hi, zero_mul]
        · have hj : L₂ < ij.2 := by omega
          rw [h₂.2 ij.2 hj, mul_zero]
    have hGood_Z : ∀ w : Fin W × Fin n, Good 1 (B + 1) (Z_poly w) := by
      intro w
      refine ⟨fun k => ?_, fun k hk => ?_⟩
      · simp only [Z_poly, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial]
        by_cases hkM : k < M
        · rw [Finset.sum_eq_single ⟨k, hkM⟩]
          · simp [MvPolynomial.isHomogeneous_X]
          · intro j _ hj
            have hj_ne : (j : ℕ) ≠ k := fun h => hj (Fin.ext h)
            simp [hj_ne]
          · intro hmem
            exact absurd (Finset.mem_univ _) hmem
        · rw [Finset.sum_eq_zero]
          · exact MvPolynomial.isHomogeneous_zero _ _ _
          · intro j _
            have hj_lt : (j : ℕ) < M := j.2
            have hj_ne : (j : ℕ) ≠ k := by omega
            simp [hj_ne]
      · simp only [Z_poly, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial]
        refine Finset.sum_eq_zero fun j _ => ?_
        have hj_lt : (j : ℕ) < B + 2 := j.2
        have hj_ne : (j : ℕ) ≠ k := by omega
        simp [hj_ne]
    have hGood_pow : ∀ (w : Fin W × Fin n) (e : ℕ),
        Good e (e * (B + 1)) (Z_poly w ^ e) := by
      intro w e
      induction e with
      | zero => simpa using hGood_one
      | succ e ih =>
        rw [pow_succ]
        have hm := hGood_mul ih (hGood_Z w)
        have heq : e * (B + 1) + (B + 1) = (e + 1) * (B + 1) := by ring
        rwa [heq] at hm
    have hGood_prod : ∀ (s : Finset (Fin W × Fin n)) (α : (Fin W × Fin n) →₀ ℕ),
        Good (∑ w ∈ s, α w) ((∑ w ∈ s, α w) * (B + 1)) (∏ w ∈ s, Z_poly w ^ α w) := by
      intro s α
      induction s using Finset.induction_on with
      | empty => simpa using hGood_one
      | @insert w₀ s hw₀ ih =>
        rw [Finset.sum_insert hw₀, Finset.prod_insert hw₀]
        have hm := hGood_mul (hGood_pow w₀ (α w₀)) ih
        have heq : α w₀ * (B + 1) + (∑ w ∈ s, α w) * (B + 1) =
            (α w₀ + ∑ w ∈ s, α w) * (B + 1) := by ring
        rwa [heq] at hm
    have hdeg_W : ∀ α : (Fin W × Fin n) →₀ ℕ, Finsupp.degree α = ∑ w : Fin W × Fin n, α w := by
      intro α
      change ∑ w ∈ α.support, α w = ∑ w : Fin W × Fin n, α w
      exact Finset.sum_subset (Finset.subset_univ _) fun w _ hw =>
        Finsupp.notMem_support_iff.mp hw
    have hGood_Ψ : ∀ u : Fin n, Good D (B + D * (B + 1)) (Ψ u) := by
      intro u
      change Good D (B + D * (B + 1)) (MvPolynomial.eval₂ ι_coeff Z_poly (G u))
      rw [MvPolynomial.eval₂_eq']
      have hterm : ∀ α ∈ (G u).support,
          Good D (B + D * (B + 1))
            (ι_coeff ((G u).coeff α) * ∏ w : Fin W × Fin n, Z_poly w ^ α w) := by
        intro α hα
        have hcoeff_ne : (G u).coeff α ≠ 0 := MvPolynomial.mem_support_iff.mp hα
        have hdeg_α : Finsupp.degree α = D := by
          by_contra hne
          exact hcoeff_ne ((hGHom u).coeff_eq_zero hne)
        rw [hdeg_W] at hdeg_α
        have hC_good : Good 0 B (ι_coeff ((G u).coeff α)) := by
          refine ⟨fun k => ?_, fun k hk => ?_⟩
          · change (Polynomial.map MvPolynomial.C ((G u).coeff α)).coeff k |>.IsHomogeneous 0
            rw [Polynomial.coeff_map]
            exact MvPolynomial.isHomogeneous_C _ _
          · change (Polynomial.map MvPolynomial.C ((G u).coeff α)).coeff k = 0
            rw [Polynomial.coeff_map,
              Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt (hB_bound u α) hk),
              map_zero]
        have hP_good : Good D (D * (B + 1)) (∏ w : Fin W × Fin n, Z_poly w ^ α w) := by
          have hp := hGood_prod Finset.univ α
          rwa [hdeg_α] at hp
        have hm := hGood_mul hC_good hP_good
        rwa [zero_add] at hm
      refine ⟨fun k => ?_, fun k hk => ?_⟩
      · rw [Polynomial.finsetSum_coeff]
        exact MvPolynomial.IsHomogeneous.sum _ _ _ fun α hα => (hterm α hα).1 k
      · rw [Polynomial.finsetSum_coeff]
        exact Finset.sum_eq_zero fun α hα => (hterm α hα).2 k hk
    let P : Fin E → A := fun r => (Ψ (eE.symm r).1).coeff ((eE.symm r).2 : ℕ)
    have hPHom : ∀ r : Fin E, (P r).IsHomogeneous D :=
      fun r => (hGood_Ψ (eE.symm r).1).1 ((eE.symm r).2 : ℕ)
    obtain ⟨x, hx_ne, hx_zero⟩ := hAlgZero E V D hEV hD P hPHom
    let z : Fin W × Fin n → Polynomial κ :=
      fun w => ∑ j : Fin M, Polynomial.monomial (j : ℕ) (x (eV (w, j)))
    have hz_ne : z ≠ 0 := by
      intro hz0
      apply hx_ne
      ext v
      let wj := eV.symm v
      have hw0 : z wj.1 = 0 := congrFun hz0 wj.1
      have hcoeff0 : (z wj.1).coeff (wj.2 : ℕ) = 0 := by rw [hw0, Polynomial.coeff_zero]
      simp only [z, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial] at hcoeff0
      rw [Finset.sum_eq_single wj.2] at hcoeff0
      · simp only [↓reduceIte] at hcoeff0
        have hev : eV (wj.1, wj.2) = v := eV.apply_symm_apply v
        rw [hev] at hcoeff0
        exact hcoeff0
      · intro j _ hj
        have hj_ne : (j : ℕ) ≠ (wj.2 : ℕ) := fun h => hj (Fin.ext h)
        simp [hj_ne]
      · intro hmem
        exact absurd (Finset.mem_univ _) hmem
    refine ⟨z, hz_ne, fun u => ?_⟩
    let φ_x : Polynomial A →+* Polynomial κ := Polynomial.mapRingHom (MvPolynomial.eval x)
    have hφ_ι : φ_x.comp ι_coeff = RingHom.id (Polynomial κ) := by
      ext p : 2
      · simp only [φ_x, ι_coeff, RingHom.coe_comp, Function.comp_apply,
          Polynomial.coe_mapRingHom, Polynomial.map_C, RingHom.id_apply, Polynomial.C_inj]
        exact MvPolynomial.eval_C p
      · simp [φ_x, ι_coeff]
    have hφ_Z : (fun i => φ_x (Z_poly i)) = z := by
      funext w
      dsimp only [Z_poly, z]
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [φ_x, Polynomial.coe_mapRingHom, Polynomial.map_monomial]
      rw [MvPolynomial.eval_X]
    have hφ_Ψ : φ_x (Ψ u) = MvPolynomial.eval z (G u) := by
      change φ_x (MvPolynomial.eval₂ ι_coeff Z_poly (G u)) = MvPolynomial.eval z (G u)
      rw [MvPolynomial.hom_eval₂, hφ_ι, hφ_Z]
      rfl
    rw [← hφ_Ψ]
    ext k
    rw [Polynomial.coeff_zero]
    change (Polynomial.map (MvPolynomial.eval x) (Ψ u)).coeff k = 0
    rw [Polynomial.coeff_map]
    by_cases hk : k < K_deg
    · have heq : (Ψ u).coeff k = P (eE (u, ⟨k, hk⟩)) := by
        simp [P]
      rw [heq]
      exact hx_zero (eE (u, ⟨k, hk⟩))
    · have hgt : B + D * (B + 1) < k := by
        have hK : K_deg = B + D * (B + 1) + 1 := by
          dsimp [K_deg]
          ring
        omega
      rw [(hGood_Ψ u).2 k hgt, map_zero]

  
  have hNormBasis : ∀ (F₀ : Type u) [Field F₀] [Algebra F₀ K] [FiniteDimensional F₀ K],
      let n := Module.finrank F₀ K
      let D := Module.finrank K L
      ∃ G : Fin n → MvPolynomial (Fin (D + 1) × Fin n) F₀,
        (∀ u : Fin n, (G u).IsHomogeneous D) ∧
        ∀ z : Fin (D + 1) × Fin n → F₀,
          z ≠ 0 → (∀ u : Fin n, MvPolynomial.eval z (G u) = 0) →
          ∃ y : L, Algebra.norm K y = c := by
    intro F₀ _ _ _ n D
    have hn_pos : 0 < n := Module.finrank_pos
    have hD_pos : 0 < D := Module.finrank_pos
    let b : Module.Basis (Fin D) K L := Module.finBasis K L
    let e : Module.Basis (Fin n) F₀ K := Module.finBasis F₀ K
    let σ := Fin (D + 1) × Fin n
    let L_lin : Fin (D + 1) → MvPolynomial σ K :=
      fun r => ∑ s : Fin n, MvPolynomial.C (e s) * MvPolynomial.X (r, s)
    have hL_hom : ∀ r : Fin (D + 1), (L_lin r).IsHomogeneous 1 := fun r =>
      MvPolynomial.IsHomogeneous.sum _ _ _ fun s _ =>
        (MvPolynomial.isHomogeneous_X K (r, s)).C_mul (e s)
    let M_mat : Matrix (Fin D) (Fin D) (MvPolynomial σ K) :=
      fun i j => ∑ k : Fin D,
        MvPolynomial.C (Algebra.leftMulMatrix b (b k) i j) * L_lin k.succ
    have hM_hom : ∀ i j : Fin D, (M_mat i j).IsHomogeneous 1 := fun i j =>
      MvPolynomial.IsHomogeneous.sum _ _ _ fun k _ =>
        (hL_hom k.succ).C_mul _
    have hDet_hom : M_mat.det.IsHomogeneous D := by
      rw [Matrix.det_apply]
      refine MvPolynomial.IsHomogeneous.sum _ _ _ fun π _ => ?_
      have hprod : (∏ i : Fin D, M_mat (π i) i).IsHomogeneous D := by
        have hp := MvPolynomial.IsHomogeneous.prod Finset.univ
          (fun i : Fin D => M_mat (π i) i) (fun _ => 1) (fun i _ => hM_hom (π i) i)
        simpa using hp
      rcases Int.units_eq_one_or (Equiv.Perm.sign π) with h1 | hm1
      · rw [h1, one_smul]
        exact hprod
      · rw [hm1, Units.neg_smul, one_smul]
        exact hprod.neg
    let H_sub : MvPolynomial σ K := M_mat.det - MvPolynomial.C c * (L_lin 0) ^ D
    have hH_hom : H_sub.IsHomogeneous D := by
      have hpow : ((L_lin 0) ^ D).IsHomogeneous D := by
        simpa using (hL_hom 0).pow D
      exact hDet_hom.sub (hpow.C_mul c)
    let G : Fin n → MvPolynomial σ F₀ := fun u =>
      ∑ α ∈ H_sub.support, MvPolynomial.monomial α (e.repr (H_sub.coeff α) u)
    have hGHom : ∀ u : Fin n, (G u).IsHomogeneous D := by
      intro u
      refine MvPolynomial.IsHomogeneous.sum _ _ _ fun α hα => ?_
      have hcoeff_ne : H_sub.coeff α ≠ 0 := MvPolynomial.mem_support_iff.mp hα
      have hdeg_α : Finsupp.degree α = D := by
        by_contra hne
        exact hcoeff_ne (hH_hom.coeff_eq_zero hne)
      exact MvPolynomial.isHomogeneous_monomial _ hdeg_α
    refine ⟨G, hGHom, fun z hz_ne hz_zero => ?_⟩
    let z_K : σ → K := fun w => algebraMap F₀ K (z w)
    let y_vec : Fin (D + 1) → K := fun r => ∑ s : Fin n, z (r, s) • e s
    have hy_ne : ∃ r₀ : Fin (D + 1), y_vec r₀ ≠ 0 := by
      have hex_w : ∃ w₀ : σ, z w₀ ≠ 0 := by
        by_contra! hall
        exact hz_ne (funext hall)
      obtain ⟨⟨r₀, s₀⟩, hw₀⟩ := hex_w
      refine ⟨r₀, fun hy0 => hw₀ ?_⟩
      have hrepr : e.repr (y_vec r₀) s₀ = 0 := by rw [hy0, map_zero, Finsupp.zero_apply]
      simp only [y_vec, map_sum, map_smul, Module.Basis.repr_self, Finsupp.smul_single,
        smul_eq_mul, mul_one, Finsupp.finsetSum_apply] at hrepr
      rw [Finset.sum_eq_single s₀] at hrepr
      · simpa using hrepr
      · intro s _ hs
        simp [hs]
      · intro hmem
        exact absurd (Finset.mem_univ _) hmem
    have heval_H : MvPolynomial.eval z_K H_sub = 0 := by
      apply e.repr.injective
      rw [map_zero]
      ext u
      rw [Finsupp.zero_apply]
      have hH_sum : MvPolynomial.eval z_K H_sub =
          ∑ α ∈ H_sub.support, (α.prod fun w m => z w ^ m) • H_sub.coeff α := by
        conv_lhs => rw [MvPolynomial.as_sum H_sub]
        rw [map_sum]
        refine Finset.sum_congr rfl fun α _ => ?_
        rw [MvPolynomial.eval_monomial, Algebra.smul_def, mul_comm]
        congr 1
        simp only [Finsupp.prod, z_K, map_prod, map_pow]
      rw [hH_sum, map_sum, Finsupp.finsetSum_apply]
      have hG_eval : MvPolynomial.eval z (G u) =
          ∑ α ∈ H_sub.support, e.repr (H_sub.coeff α) u * (α.prod fun w m => z w ^ m) := by
        simp only [G, map_sum, MvPolynomial.eval_monomial]
        rfl
      rw [← hz_zero u, hG_eval]
      refine Finset.sum_congr rfl fun α _ => ?_
      rw [map_smul, Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul, mul_comm]
    have heval_L : ∀ r : Fin (D + 1), MvPolynomial.eval z_K (L_lin r) = y_vec r := by
      intro r
      simp only [L_lin, y_vec, z_K, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X,
        Algebra.smul_def, mul_comm]
    have hMat_eq : (MvPolynomial.eval z_K).mapMatrix M_mat =
        Algebra.leftMulMatrix b (∑ k : Fin D, y_vec k.succ • b k) := by
      rw [map_sum]
      ext i j
      change MvPolynomial.eval z_K (M_mat i j) =
        (∑ k : Fin D, Algebra.leftMulMatrix b (y_vec k.succ • b k)) i j
      rw [Matrix.sum_apply]
      dsimp only [M_mat]
      rw [map_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [map_mul, MvPolynomial.eval_C, heval_L, map_smul, Matrix.smul_apply, smul_eq_mul, mul_comm]
    have hNorm_eq : Algebra.norm K (∑ k : Fin D, y_vec k.succ • b k) = c * (y_vec 0) ^ D := by
      have h0 : MvPolynomial.eval z_K M_mat.det - c * (y_vec 0) ^ D = 0 := by
        simpa [H_sub, heval_L] using heval_H
      rw [RingHom.map_det, hMat_eq, ← Algebra.norm_eq_matrix_det] at h0
      exact sub_eq_zero.mp h0
    have hy0_ne : y_vec 0 ≠ 0 := by
      intro hy0
      obtain ⟨r₀, hr₀⟩ := hy_ne
      apply hr₀
      have hpow0 : (y_vec 0) ^ D = 0 := by rw [hy0, zero_pow hD_pos.ne']
      rw [hpow0, mul_zero] at hNorm_eq
      have hsum0 : ∑ k : Fin D, y_vec k.succ • b k = 0 :=
        Algebra.norm_eq_zero_iff.mp hNorm_eq
      have hsucc0 : ∀ k : Fin D, y_vec k.succ = 0 := by
        intro k
        have hbk : b.repr (∑ j : Fin D, y_vec j.succ • b j) k = 0 := by
          rw [hsum0, map_zero, Finsupp.zero_apply]
        simp only [map_sum, map_smul, Module.Basis.repr_self, Finsupp.smul_single,
          smul_eq_mul, mul_one, Finsupp.finsetSum_apply] at hbk
        rw [Finset.sum_eq_single k] at hbk
        · simpa using hbk
        · intro j _ hj
          simp [hj]
        · intro hmem
          exact absurd (Finset.mem_univ _) hmem
      exact Fin.cases hy0 hsucc0 r₀
    refine ⟨algebraMap K L (y_vec 0)⁻¹ * ∑ k : Fin D, y_vec k.succ • b k, ?_⟩
    rw [map_mul, Algebra.norm_algebraMap, hNorm_eq]
    calc
      ((y_vec 0)⁻¹) ^ D * (c * (y_vec 0) ^ D)
        = c * ((y_vec 0)⁻¹ * y_vec 0) ^ D := by ring
      _ = c * 1 ^ D := by rw [inv_mul_cancel₀ hy0_ne]
      _ = c := by rw [one_pow, mul_one]

  
  by_cases hAlg : Algebra.IsAlgebraic κ K
  · have : Algebra.IsIntegral κ K := Algebra.IsAlgebraic.isIntegral
    have hBijK : Function.Bijective (algebraMap κ K) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    have : IsAlgClosed K :=
      IsAlgClosed.of_ringEquiv κ K (RingEquiv.ofBijective (algebraMap κ K) hBijK)
    have : Algebra.IsIntegral K L := Algebra.IsIntegral.of_finite K L
    have hBijL : Function.Bijective (algebraMap K L) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let eKL : K ≃ₗ[K] L := LinearEquiv.ofBijective (Algebra.linearMap K L) hBijL
    have hD1 : Module.finrank K L = 1 := by
      rw [← eKL.finrank_eq, Module.finrank_self]
    refine ⟨algebraMap K L c, ?_⟩
    rw [Algebra.norm_algebraMap, hD1, pow_one]
  · rw [Algebra.isAlgebraic_def, not_forall] at hAlg
    obtain ⟨t, ht_not_alg⟩ := hAlg
    let F₀_if : IntermediateField κ K := IntermediateField.adjoin κ ({t} : Set K)
    let F₀ := ↥F₀_if
    let t₀ : F₀ := ⟨t, IntermediateField.mem_adjoin_simple_self κ t⟩
    have ht₀ : Transcendental κ t₀ := by
      intro halg₀
      apply ht_not_alg
      obtain ⟨p, hp_ne, hp_ev⟩ := halg₀
      refine ⟨p, hp_ne, ?_⟩
      have heq := Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom κ F₀ K) t₀ p
      rw [hp_ev, map_zero] at heq
      exact heq
    have htr_ge1 : (1 : Cardinal.{u}) ≤ Algebra.trdeg κ F₀ := by
      have h1 : AlgebraicIndependent κ (![t₀] ∘ (Equiv.ulift : ULift.{u} (Fin 1) ≃ Fin 1)) :=
        (algebraicIndependent_iff_transcendental.mpr ht₀).comp Equiv.ulift Equiv.ulift.injective
      simpa using h1.cardinalMk_le_trdeg
    have htr_add : Algebra.trdeg κ F₀ + Algebra.trdeg F₀ K ≤ 1 := by
      rw [_root_.trdeg_add_eq κ F₀ (A := K)]
      exact hTrdeg
    have h1_lt : (1 : Cardinal.{u}) < Cardinal.aleph0 := by
      simp
    obtain ⟨a_tr, ha_tr⟩ := Cardinal.lt_aleph0.mp
      (lt_of_le_of_lt (le_trans le_self_add htr_add) h1_lt)
    obtain ⟨b_tr, hb_tr⟩ := Cardinal.lt_aleph0.mp
      (lt_of_le_of_lt (le_trans le_add_self htr_add) h1_lt)
    have ha_ge1 : 1 ≤ a_tr := by
      rw [ha_tr] at htr_ge1
      exact_mod_cast htr_ge1
    have hab_le1 : a_tr + b_tr ≤ 1 := by
      rw [ha_tr, hb_tr] at htr_add
      exact_mod_cast htr_add
    have htr_F₀K : Algebra.trdeg F₀ K = 0 := by
      rw [hb_tr]
      have hb0 : b_tr = 0 := by omega
      simp [hb0]
    have : Algebra.IsAlgebraic F₀ K := (_root_.trdeg_eq_zero_iff).mp htr_F₀K
    have : Algebra.IsIntegral F₀ K := Algebra.IsAlgebraic.isIntegral
    obtain ⟨S, hS⟩ := hFG
    let L_ad : IntermediateField F₀ K := IntermediateField.adjoin F₀ (S : Set K)
    have hFinL : FiniteDimensional F₀ ↥L_ad :=
      IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x
    have hL_top : L_ad = ⊤ := by
      have hle : IntermediateField.adjoin κ (S : Set K) ≤ L_ad.restrictScalars κ := by
        rw [IntermediateField.adjoin_le_iff]
        exact IntermediateField.subset_adjoin F₀ (S : Set K)
      rw [hS, top_le_iff] at hle
      rw [eq_top_iff]
      intro x _
      have hx : x ∈ L_ad.restrictScalars κ := by
        rw [hle]
        exact IntermediateField.mem_top
      exact hx
    let eL_K : ↥L_ad ≃ₐ[F₀] K :=
      (IntermediateField.equivOfEq hL_top).trans IntermediateField.topEquiv
    have : FiniteDimensional F₀ K := eL_K.toLinearEquiv.finiteDimensional
    set n := Module.finrank F₀ K
    set D := Module.finrank K L
    have hn : 1 ≤ n := Module.finrank_pos
    have hD : 1 ≤ D := Module.finrank_pos
    obtain ⟨G, hGHom, hGNorm⟩ := hNormBasis F₀
    let σ := Fin (D + 1) × Fin n
    let ev₀ : Polynomial κ →ₐ[κ] F₀ := Polynomial.aeval t₀
    have hev₀_inj : Function.Injective ev₀ := transcendental_iff_injective.mp ht₀
    have hRat : ∀ x : F₀, ∃ rs : Polynomial κ × Polynomial κ,
        rs.2 ≠ 0 ∧ x * ev₀ rs.2 = ev₀ rs.1 := by
      intro x
      by_cases hx : x = 0
      · exact ⟨(0, 1), one_ne_zero, by simp [hx]⟩
      · obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff κ (x : K)).mp x.2
        have hrs_F₀ : x = ev₀ r / ev₀ s := by
          ext
          change (x : K) = (ev₀ r : K) / (ev₀ s : K)
          have hr : Polynomial.aeval t r = (ev₀ r : K) :=
            Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom κ F₀ K) t₀ r
          have hs : Polynomial.aeval t s = (ev₀ s : K) :=
            Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom κ F₀ K) t₀ s
          rw [← hr, ← hs]
          exact hrs
        have hev_s : ev₀ s ≠ 0 := by
          intro hs0
          apply hx
          rw [hrs_F₀, hs0, div_zero]
        have hs_ne : s ≠ 0 := by
          intro hs0
          apply hev_s
          rw [hs0, map_zero]
        exact ⟨(r, s), hs_ne, by rw [hrs_F₀, div_mul_cancel₀ _ hev_s]⟩
    let num : Fin n → (σ →₀ ℕ) → Polynomial κ :=
      fun u α => (Classical.choose (hRat ((G u).coeff α))).1
    let den : Fin n → (σ →₀ ℕ) → Polynomial κ :=
      fun u α => (Classical.choose (hRat ((G u).coeff α))).2
    have hden_ne : ∀ u α, den u α ≠ 0 :=
      fun u α => (Classical.choose_spec (hRat ((G u).coeff α))).1
    have hnum_den : ∀ u α, (G u).coeff α * ev₀ (den u α) = ev₀ (num u α) :=
      fun u α => (Classical.choose_spec (hRat ((G u).coeff α))).2
    let d₀ : Polynomial κ := ∏ u : Fin n, ∏ α ∈ (G u).support, den u α
    have hd₀_ne : d₀ ≠ 0 := by
      rw [Finset.prod_ne_zero_iff]
      intro u _
      rw [Finset.prod_ne_zero_iff]
      intro α _
      exact hden_ne u α
    have hev_d₀ : ev₀ d₀ ≠ 0 := fun h0 => hd₀_ne (hev₀_inj (h0.trans (map_zero ev₀).symm))
    have hdvd : ∀ (u : Fin n) (α : σ →₀ ℕ), α ∈ (G u).support → den u α ∣ d₀ :=
      fun u α hα => dvd_trans (Finset.dvd_prod_of_mem _ hα)
        (Finset.dvd_prod_of_mem _ (Finset.mem_univ u))
    let q_pol : Fin n → (σ →₀ ℕ) → Polynomial κ :=
      fun u α => if hα : α ∈ (G u).support then Classical.choose (hdvd u α hα) else 0
    have hq_eq : ∀ (u : Fin n) (α : σ →₀ ℕ), α ∈ (G u).support →
        (G u).coeff α * ev₀ d₀ = ev₀ (num u α * q_pol u α) := by
      intro u α hα
      have hd_eq : d₀ = den u α * q_pol u α := by
        simp only [q_pol, hα, ↓reduceDIte]
        exact Classical.choose_spec (hdvd u α hα)
      calc
        (G u).coeff α * ev₀ d₀
          = (G u).coeff α * (ev₀ (den u α) * ev₀ (q_pol u α)) := by rw [hd_eq, map_mul]
        _ = ((G u).coeff α * ev₀ (den u α)) * ev₀ (q_pol u α) := by ring
        _ = ev₀ (num u α) * ev₀ (q_pol u α) := by rw [hnum_den u α]
        _ = ev₀ (num u α * q_pol u α) := (map_mul ev₀ _ _).symm
    let G_poly : Fin n → MvPolynomial σ (Polynomial κ) := fun u =>
      ∑ α ∈ (G u).support, MvPolynomial.monomial α (num u α * q_pol u α)
    have hGPolyHom : ∀ u : Fin n, (G_poly u).IsHomogeneous D := by
      intro u
      refine MvPolynomial.IsHomogeneous.sum _ _ _ fun α hα => ?_
      have hcoeff_ne : (G u).coeff α ≠ 0 := MvPolynomial.mem_support_iff.mp hα
      have hdeg_α : Finsupp.degree α = D := by
        by_contra hne
        exact hcoeff_ne ((hGHom u).coeff_eq_zero hne)
      exact MvPolynomial.isHomogeneous_monomial _ hdeg_α
    obtain ⟨z, hz_ne, hz_zero⟩ :=
      hPolyZero n (D + 1) D hn hD (Nat.lt_succ_self D) G_poly hGPolyHom
    let z_F : σ → F₀ := fun w => ev₀ (z w)
    have hzF_ne : z_F ≠ 0 := by
      intro hz0
      apply hz_ne
      funext w
      have hw : ev₀ (z w) = ev₀ 0 := by
        rw [map_zero]
        exact congrFun hz0 w
      exact hev₀_inj hw
    have hzF_zero : ∀ u : Fin n, MvPolynomial.eval z_F (G u) = 0 := by
      intro u
      have hmul0 : MvPolynomial.eval z_F (G u) * ev₀ d₀ = 0 := by
        conv_lhs => rw [MvPolynomial.as_sum (G u)]
        rw [map_sum, Finset.sum_mul]
        have hGp_ev : ev₀ (MvPolynomial.eval z (G_poly u)) = 0 := by
          rw [hz_zero u, map_zero]
        rw [← hGp_ev]
        simp only [G_poly, map_sum, MvPolynomial.eval_monomial, map_mul]
        refine Finset.sum_congr rfl fun α hα => ?_
        have hprod_eq : (α.prod fun w m => z_F w ^ m) = ev₀ (α.prod fun w m => z w ^ m) := by
          simp only [Finsupp.prod, z_F, map_prod, map_pow]
        have hq' : (G u).coeff α * ev₀ d₀ = ev₀ (num u α) * ev₀ (q_pol u α) := by
          rw [hq_eq u α hα, map_mul]
        calc
          (G u).coeff α * (α.prod fun w m => z_F w ^ m) * ev₀ d₀
            = ((G u).coeff α * ev₀ d₀) * ev₀ (α.prod fun w m => z w ^ m) := by
              rw [hprod_eq]
              ring
          _ = ev₀ (num u α) * ev₀ (q_pol u α) * ev₀ (α.prod fun w m => z w ^ m) := by
              rw [hq']
      exact (mul_eq_zero.mp hmul0).resolve_right hev_d₀
    exact hGNorm z_F hzF_ne hzF_zero

theorem weil_alt_cd_field_filtered_colimit_vanishing (K : Type u) [Field K]
    (Idx : Type u) [CategoryTheory.SmallCategory Idx] [CategoryTheory.IsFiltered Idx]
    (D : CategoryTheory.Functor Idx
      (CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}))
    (c : CategoryTheory.Limits.Cocone D)
    (hc : Nonempty (CategoryTheory.Limits.IsColimit c))
    (s : ℕ)
    (hSub : ∀ j : Idx, Subsingleton ((D.obj j).H s)) :
    Subsingleton (c.pt.H s) :=
by
  obtain ⟨hc₀⟩ := hc
  let S_K : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of K)
  let J := S_K.smallEtaleTopology

  
  have hH0Surj : ∀ (Idx₀ : Type u) [CategoryTheory.SmallCategory Idx₀] [CategoryTheory.IsFiltered Idx₀]
      (D₀ : CategoryTheory.Functor Idx₀
        (CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u}))
      (c₀ : CategoryTheory.Limits.Cocone D₀), CategoryTheory.Limits.IsColimit c₀ →
      ∀ ξ : c₀.pt.H 0, ∃ (j : Idx₀) (ξ_j : (D₀.obj j).H 0),
        ξ_j.comp (CategoryTheory.Abelian.Ext.mk₀ (c₀.ι.app j)) (Nat.add_zero 0) = ξ := by
    intro Idx₀ _ _ D₀ c₀ hc_c₀ ξ
    let T_K : S_K.Etale := weilEtaleIdTerminal.{u} S_K
    let hTerm : CategoryTheory.Limits.IsTerminal T_K := weilEtaleIdTerminalIsTerminal.{u} S_K
    have : CompactSpace ↥T_K.left := (inferInstance : CompactSpace ↥S_K)
    have : T_K.left.IsSeparated := (inferInstance : S_K.IsSeparated)
    obtain ⟨hc_eval⟩ :=
      weil_alt_cd_qcsep_etale_filtered_colimit_eval_iso S_K Idx₀ D₀ c₀ hc_c₀ T_K
    let hc_eval_t :=
      CategoryTheory.Limits.isColimitOfPreserves (CategoryTheory.forget AddCommGrpCat.{u}) hc_eval
    let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let C_const := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let Γ_K := (CategoryTheory.sheafSections J AddCommGrpCat.{u}).obj (Opposite.op T_K)
    let adj : C_const ⊣ Γ_K := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hTerm
    let φ : C_const.obj Aℤ ⟶ c₀.pt := CategoryTheory.Abelian.Ext.homEquiv₀ ξ
    let u : Aℤ ⟶ Γ_K.obj c₀.pt := (adj.homEquiv Aℤ c₀.pt) φ
    let oneZ : ULift.{u} ℤ := ULift.up (1 : ℤ)
    let y : ↥(c₀.pt.obj.obj (Opposite.op T_K)) := u.hom oneZ
    obtain ⟨j, y_j_raw, hy_j⟩ :=
      CategoryTheory.Limits.Types.jointly_surjective_of_isColimit hc_eval_t y
    let y_j : ↥((D₀.obj j).obj.obj (Opposite.op T_K)) := y_j_raw
    have hy_j' : ((c₀.ι.app j).hom.app (Opposite.op T_K)).hom y_j = y := hy_j
    let u_j : Aℤ ⟶ Γ_K.obj (D₀.obj j) :=
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • y_j
          map_zero' := zero_zsmul y_j
          map_add' := fun a b => add_zsmul y_j a.down b.down }
    have hu_j : CategoryTheory.CategoryStruct.comp u_j (Γ_K.map (c₀.ι.app j)) = u := by
      apply AddCommGrpCat.hom_ext
      ext ⟨n⟩
      change ((c₀.ι.app j).hom.app (Opposite.op T_K)).hom (n • y_j) = u.hom (ULift.up n)
      have hn : (ULift.up n : ULift.{u} ℤ) = n • oneZ := by
        ext
        simp [oneZ]
      calc
        ((c₀.ι.app j).hom.app (Opposite.op T_K)).hom (n • y_j)
          = n • ((c₀.ι.app j).hom.app (Opposite.op T_K)).hom y_j :=
            map_zsmul ((c₀.ι.app j).hom.app (Opposite.op T_K)).hom n y_j
        _ = n • u.hom oneZ := by rw [hy_j']
        _ = u.hom (n • oneZ) := (map_zsmul u.hom n oneZ).symm
        _ = u.hom (ULift.up n) := by rw [← hn]
    let φ_j : C_const.obj Aℤ ⟶ D₀.obj j := (adj.homEquiv Aℤ (D₀.obj j)).symm u_j
    have hφ_j : CategoryTheory.CategoryStruct.comp φ_j (c₀.ι.app j) = φ := by
      rw [← adj.homEquiv_naturality_right_symm u_j (c₀.ι.app j), hu_j]
      exact (adj.homEquiv Aℤ c₀.pt).symm_apply_apply φ
    refine ⟨j, CategoryTheory.Abelian.Ext.mk₀ φ_j, ?_⟩
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hφ_j,
      CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply]

  
  have hInjCechExact : ∀ (I : CategoryTheory.Sheaf J AddCommGrpCat.{u})
      [CategoryTheory.Injective I] {W U : S_K.Etale} (w : W ⟶ U) (p : ℕ)
      (z : ↥(I.obj.obj (Opposite.op (weilEtaleCechObj w (p + 1))))),
      weilEtaleCechDiff I.obj w (p + 1) z = 0 →
      ∃ b : ↥(I.obj.obj (Opposite.op (weilEtaleCechObj w p))),
        weilEtaleCechDiff I.obj w p b = z := by
    intro I _ W U w p z hz
    have hProjLast : ∀ (q : ℕ),
        weilEtaleCechProj w (q + 1) (Fin.last (q + 1)) =
          CategoryTheory.Limits.pullback.snd (weilEtaleCechHom w q) w := by
      intro q
      dsimp only [weilEtaleCechProj, weilEtaleCechProjSub]
      rw [Fin.lastCases_last]
    have hProjCast : ∀ (q : ℕ) (j : Fin (q + 1)),
        weilEtaleCechProj w (q + 1) j.castSucc =
          CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w q) w ≫
            weilEtaleCechProj w q j := by
      intro q j
      dsimp only [weilEtaleCechProj, weilEtaleCechProjSub]
      rw [Fin.lastCases_castSucc]
      rfl
    have hLiftProj : ∀ {Z : S_K.Etale} (h : Z ⟶ U) (q : ℕ)
        (g : Fin (q + 1) → (Z ⟶ W)) (hg : ∀ i, g i ≫ w = h) (i : Fin (q + 1)),
        (weilEtaleCechLiftSub w h q g hg).1 ≫ weilEtaleCechProj w q i = g i := by
      intro Z h q
      induction q with
      | zero =>
        intro g hg i
        have hi : i = 0 := Fin.ext (by omega)
        subst hi
        exact CategoryTheory.Category.comp_id (g 0)
      | succ q ih =>
        intro g hg i
        refine Fin.lastCases ?_ ?_ i
        · exact (congrArg ((weilEtaleCechLiftSub w h (q + 1) g hg).1 ≫ ·)
            (hProjLast q)).trans (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        · intro j
          exact ((congrArg ((weilEtaleCechLiftSub w h (q + 1) g hg).1 ≫ ·)
            (hProjCast q j)).trans
            (CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _)).trans
            (ih (fun k => g k.castSucc) (fun k => hg k.castSucc) j)
    have hCechHomExt : ∀ {Z : S_K.Etale} (q : ℕ) {l₁ l₂ : Z ⟶ weilEtaleCechObj w q},
        (∀ i : Fin (q + 1), l₁ ≫ weilEtaleCechProj w q i = l₂ ≫ weilEtaleCechProj w q i) →
        l₁ = l₂ := by
      intro Z q
      induction q with
      | zero =>
        intro l₁ l₂ hproj
        exact ((CategoryTheory.Category.comp_id l₁).symm.trans (hproj 0)).trans
          (CategoryTheory.Category.comp_id l₂)
      | succ q ih =>
        intro l₁ l₂ hproj
        refine CategoryTheory.Limits.pullback.hom_ext ?_ ?_
        · refine ih (fun j => ?_)
          exact (CategoryTheory.Category.assoc l₁ _ _).trans
            (((congrArg (l₁ ≫ ·) (hProjCast q j)).symm.trans
              ((hproj j.castSucc).trans
                (congrArg (l₂ ≫ ·) (hProjCast q j)))).trans
              (CategoryTheory.Category.assoc l₂ _ _).symm)
        · exact ((congrArg (l₁ ≫ ·) (hProjLast q)).symm.trans
            (hproj (Fin.last (q + 1)))).trans
            (congrArg (l₂ ≫ ·) (hProjLast q))
    have hFaceProj : ∀ (q : ℕ) (j : Fin (q + 2)) (i : Fin (q + 1)),
        weilEtaleCechFace w q j ≫ weilEtaleCechProj w q i =
          weilEtaleCechProj w (q + 1) (j.succAbove i) :=
      fun q j i => hLiftProj (weilEtaleCechHom w (q + 1)) q _ _ i
    have hFaceHom : ∀ (q : ℕ) (j : Fin (q + 2)),
        weilEtaleCechFace w q j ≫ weilEtaleCechHom w q = weilEtaleCechHom w (q + 1) :=
      fun q j => (weilEtaleCechLiftSub w (weilEtaleCechHom w (q + 1)) q
        (fun i => weilEtaleCechProj w (q + 1) (j.succAbove i))
        (fun i => (weilEtaleCechProjSub w (q + 1) (j.succAbove i)).2)).2
    have hFaceSimp : ∀ (i j : Fin (p + 2)), i ≤ j →
        weilEtaleCechFace w (p + 1) j.succ ≫ weilEtaleCechFace w p i =
          weilEtaleCechFace w (p + 1) i.castSucc ≫ weilEtaleCechFace w p j := by
      intro i j hij
      apply hCechHomExt p
      intro r
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        hFaceProj, hFaceProj, hFaceProj, hFaceProj]
      congr 1
      have hij_val : (i : ℕ) ≤ (j : ℕ) := hij
      simp only [Fin.succAbove]
      split_ifs <;> simp only [Fin.ext_iff, Fin.lt_def, Fin.val_succ, Fin.val_castSucc] at * <;>
        omega
    let PSh := (S_K.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}
    have hDiffSq : ∀ (P : PSh) (x : ↥(P.obj (Opposite.op (weilEtaleCechObj w p)))),
        weilEtaleCechDiff P w (p + 1) (weilEtaleCechDiff P w p x) = 0 := by
      intro P x
      simp only [weilEtaleCechDiff, AddMonoidHom.finsetSum_apply, AddMonoidHom.zsmul_apply,
        map_sum, map_zsmul, Finset.smul_sum, smul_smul]
      have hmap_comp : ∀ (k : Fin (p + 3)) (i : Fin (p + 2)),
          (P.map (weilEtaleCechFace w (p + 1) k).op).hom
            ((P.map (weilEtaleCechFace w p i).op).hom x) =
          (P.map (weilEtaleCechFace w (p + 1) k ≫ weilEtaleCechFace w p i).op).hom x := by
        intro k i
        change ((P.map (weilEtaleCechFace w p i).op ≫
          P.map (weilEtaleCechFace w (p + 1) k).op)).hom x =
          (P.map ((weilEtaleCechFace w p i).op ≫ (weilEtaleCechFace w (p + 1) k).op)).hom x
        rw [P.map_comp]
      simp_rw [hmap_comp]
      rw [Finset.sum_comm]
      have hprod :
          (∑ x_2 : Fin (p + 1 + 2), ∑ x_1 : Fin (p + 2),
            ((-1 : ℤ) ^ (x_1 : ℕ) * (-1 : ℤ) ^ (x_2 : ℕ)) •
              (P.map (weilEtaleCechFace w (p + 1) x_2 ≫ weilEtaleCechFace w p x_1).op).hom x) =
          ∑ q ∈ (Finset.univ : Finset (Fin (p + 1 + 2) × Fin (p + 2))),
            ((-1 : ℤ) ^ (q.2 : ℕ) * (-1 : ℤ) ^ (q.1 : ℕ)) •
              (P.map (weilEtaleCechFace w (p + 1) q.1 ≫ weilEtaleCechFace w p q.2).op).hom x := by
        symm
        rw [← Finset.univ_product_univ, Finset.sum_product]
      rw [hprod]
      refine Finset.sum_involution
        (fun q _ =>
          have hq1_lt : (q.1 : ℕ) < p + 3 := q.1.isLt
          have hq2_lt : (q.2 : ℕ) < p + 2 := q.2.isLt
          if h : (q.2 : ℕ) < (q.1 : ℕ) then
            (⟨(q.2 : ℕ), by omega⟩, ⟨(q.1 : ℕ) - 1, by omega⟩)
          else
            (⟨(q.2 : ℕ) + 1, by omega⟩, ⟨(q.1 : ℕ), by omega⟩))
        ?_ ?_ ?_ ?_
      · intro q _
        have hq1_lt : (q.1 : ℕ) < p + 3 := q.1.isLt
        have hq2_lt : (q.2 : ℕ) < p + 2 := q.2.isLt
        dsimp only
        split_ifs with h
        · let j : Fin (p + 2) := ⟨(q.1 : ℕ) - 1, by omega⟩
          have hq1 : q.1 = j.succ := Fin.ext (by dsimp [j]; omega)
          have hq2_le : q.2 ≤ j := show (q.2 : ℕ) ≤ (j : ℕ) by dsimp [j]; omega
          have hc1 : (⟨(q.2 : ℕ), by omega⟩ : Fin (p + 1 + 2)) = q.2.castSucc := rfl
          have hc2 : (⟨(q.1 : ℕ) - 1, by omega⟩ : Fin (p + 2)) = j := rfl
          rw [hc1, hc2, hq1, hFaceSimp q.2 j hq2_le, ← add_smul]
          have hcoef : (-1 : ℤ) ^ (q.2 : ℕ) * (-1 : ℤ) ^ (j.succ : ℕ) +
              (-1 : ℤ) ^ (j : ℕ) * (-1 : ℤ) ^ (q.2.castSucc : ℕ) = 0 := by
            simp only [Fin.val_succ, Fin.val_castSucc, pow_succ]
            ring
          rw [hcoef, zero_smul]
        · let i' : Fin (p + 2) := ⟨(q.1 : ℕ), by omega⟩
          have hq1 : q.1 = i'.castSucc := rfl
          have hi'_le : i' ≤ q.2 := show (i' : ℕ) ≤ (q.2 : ℕ) by dsimp [i']; omega
          have hc1 : (⟨(q.2 : ℕ) + 1, by omega⟩ : Fin (p + 1 + 2)) = q.2.succ := rfl
          have hc2 : (⟨(q.1 : ℕ), by omega⟩ : Fin (p + 2)) = i' := rfl
          rw [hc1, hc2, hq1, ← hFaceSimp i' q.2 hi'_le, ← add_smul]
          have hcoef : (-1 : ℤ) ^ (q.2 : ℕ) * (-1 : ℤ) ^ (i'.castSucc : ℕ) +
              (-1 : ℤ) ^ (i' : ℕ) * (-1 : ℤ) ^ (q.2.succ : ℕ) = 0 := by
            simp only [Fin.val_succ, Fin.val_castSucc, pow_succ]
            ring
          rw [hcoef, zero_smul]
      · intro q _ _ heq
        have hq1_lt : (q.1 : ℕ) < p + 3 := q.1.isLt
        have hq2_lt : (q.2 : ℕ) < p + 2 := q.2.isLt
        dsimp only at heq
        split_ifs at heq with h
        · have h1 : (q.2 : ℕ) = (q.1 : ℕ) := congrArg (fun u => (u.1 : ℕ)) heq
          omega
        · have h1 : (q.2 : ℕ) + 1 = (q.1 : ℕ) := congrArg (fun u => (u.1 : ℕ)) heq
          omega
      · intro _ _
        exact Finset.mem_univ _
      · intro q _
        have hq1_lt : (q.1 : ℕ) < p + 3 := q.1.isLt
        have hq2_lt : (q.2 : ℕ) < p + 2 := q.2.isLt
        dsimp only
        by_cases h : (q.2 : ℕ) < (q.1 : ℕ)
        · have hnot : ¬ ((q.1 : ℕ) - 1 < (q.2 : ℕ)) := by omega
          simp only [dite_cond_eq_true (eq_true h), dite_cond_eq_false (eq_false hnot)]
          refine Prod.ext (Fin.ext ?_) rfl
          dsimp
          omega
        · have hlt : (q.1 : ℕ) < (q.2 : ℕ) + 1 := by omega
          simp only [dite_cond_eq_false (eq_false h), dite_cond_eq_true (eq_true hlt)]
          rfl
    let freePre : S_K.Etale → PSh := fun Y =>
      { obj := fun V => AddCommGrpCat.of ((Opposite.unop V ⟶ Y) →₀ ℤ)
        map := fun {V₁ V₂} f =>
          AddCommGrpCat.ofHom (Finsupp.mapDomain.addMonoidHom (fun l => f.unop ≫ l))
        map_id := fun V => by
          apply AddCommGrpCat.hom_ext
          apply DFunLike.ext
          intro v
          change Finsupp.mapDomain (fun l => 𝟙 V.unop ≫ l) v = v
          simp only [CategoryTheory.Category.id_comp]
          exact Finsupp.mapDomain_id
        map_comp := fun f g => by
          apply AddCommGrpCat.hom_ext
          apply DFunLike.ext
          intro v
          change Finsupp.mapDomain (fun l => (g.unop ≫ f.unop) ≫ l) v =
            Finsupp.mapDomain (fun l => g.unop ≫ l) (Finsupp.mapDomain (fun l => f.unop ≫ l) v)
          rw [← Finsupp.mapDomain_comp]
          congr 1 }
    let freePreMap : ∀ {Y₁ Y₂ : S_K.Etale}, (Y₁ ⟶ Y₂) → (freePre Y₁ ⟶ freePre Y₂) :=
      fun {Y₁ Y₂} u =>
        { app := fun V =>
            AddCommGrpCat.ofHom (Finsupp.mapDomain.addMonoidHom (fun l => l ≫ u))
          naturality := fun {V₁ V₂} f => by
            apply AddCommGrpCat.hom_ext
            apply DFunLike.ext
            intro v
            change Finsupp.mapDomain (fun l => l ≫ u) (Finsupp.mapDomain (fun l => f.unop ≫ l) v) =
              Finsupp.mapDomain (fun l => f.unop ≫ l) (Finsupp.mapDomain (fun l => l ≫ u) v)
            rw [← Finsupp.mapDomain_comp, ← Finsupp.mapDomain_comp]
            congr 1 }
    let toSec : ∀ {Y : S_K.Etale} {P : PSh}, (freePre Y ⟶ P) → ↥(P.obj (Opposite.op Y)) :=
      fun {Y P} η => (η.app (Opposite.op Y)).hom (Finsupp.single (𝟙 Y) 1)
    let ofSec : ∀ {Y : S_K.Etale} {P : PSh}, ↥(P.obj (Opposite.op Y)) → (freePre Y ⟶ P) :=
      fun {Y P} x =>
        { app := fun V =>
            AddCommGrpCat.ofHom
              ((Finsupp.lift ↥(P.obj V) ℤ (Opposite.unop V ⟶ Y)
                (fun l => (P.map l.op).hom x)).toAddMonoidHom)
          naturality := fun {V₁ V₂} f => by
            apply AddCommGrpCat.hom_ext
            apply Finsupp.addHom_ext'
            intro l
            ext
            change ((Finsupp.lift ↥(P.obj V₂) ℤ _ (fun k => (P.map k.op).hom x))
                (Finsupp.mapDomain (fun k => f.unop ≫ k) (Finsupp.single l 1))) =
              (P.map f).hom ((Finsupp.lift ↥(P.obj V₁) ℤ _ (fun k => (P.map k.op).hom x))
                (Finsupp.single l 1))
            rw [Finsupp.mapDomain_single, Finsupp.lift_apply, Finsupp.lift_apply,
              Finsupp.sum_single_index (by simp), Finsupp.sum_single_index (by simp),
              one_smul, one_smul]
            change (P.map (l.op ≫ f)).hom x = (P.map f).hom ((P.map l.op).hom x)
            rw [P.map_comp]
            rfl }
    have hToOf : ∀ {Y : S_K.Etale} {P : PSh} (x : ↥(P.obj (Opposite.op Y))),
        toSec (ofSec x) = x := by
      intro Y P x
      change (Finsupp.lift ↥(P.obj (Opposite.op Y)) ℤ _ (fun l => (P.map l.op).hom x))
        (Finsupp.single (𝟙 Y) 1) = x
      rw [Finsupp.lift_apply, Finsupp.sum_single_index (by simp), one_smul]
      change (P.map (𝟙 (Opposite.op Y))).hom x = x
      rw [P.map_id]
      rfl
    have hOfTo : ∀ {Y : S_K.Etale} {P : PSh} (η : freePre Y ⟶ P),
        ofSec (toSec η) = η := by
      intro Y P η
      ext V : 2
      apply AddCommGrpCat.hom_ext
      apply Finsupp.addHom_ext'
      intro l
      ext
      change ((Finsupp.lift ↥(P.obj V) ℤ _ (fun k => (P.map k.op).hom (toSec η)))
        (Finsupp.single l 1)) = (η.app V).hom (Finsupp.single l 1)
      rw [Finsupp.lift_apply, Finsupp.sum_single_index (by simp), one_smul]
      have hnat := η.naturality l.op
      have happ := congrArg (fun φ => φ.hom (Finsupp.single (𝟙 Y) 1)) hnat
      change (η.app V).hom (Finsupp.mapDomain (fun k => l ≫ k) (Finsupp.single (𝟙 Y) 1)) =
        (P.map l.op).hom ((η.app (Opposite.op Y)).hom (Finsupp.single (𝟙 Y) 1)) at happ
      rw [Finsupp.mapDomain_single, CategoryTheory.Category.comp_id] at happ
      exact happ.symm
    have hEvalNatSum : ∀ {A B : PSh} {ι : Type} (s : Finset ι) (c_fn : ι → ℤ)
        (F_fn : ι → (A ⟶ B)) (V : (S_K.Etale)ᵒᵖ) (v : ↥(A.obj V)),
        (((∑ i ∈ s, c_fn i • F_fn i).app V)).hom v =
          ∑ i ∈ s, c_fn i • ((F_fn i).app V).hom v := by
      intro A B ι s c_fn F_fn V v
      classical
      induction s using Finset.induction_on with
      | empty =>
        simp
      | @insert a s ha ih =>
        rw [Finset.sum_insert ha, Finset.sum_insert ha]
        change ((c_fn a • F_fn a).app V + (∑ i ∈ s, c_fn i • F_fn i).app V).hom v = _
        rw [AddCommGrpCat.hom_add, AddMonoidHom.add_apply, ih]
        congr 1
    let cechBdry : ∀ n : ℕ,
        freePre (weilEtaleCechObj w (n + 1)) ⟶ freePre (weilEtaleCechObj w n) :=
      fun n => ∑ j : Fin (n + 2), (-1 : ℤ) ^ (j : ℕ) • freePreMap (weilEtaleCechFace w n j)
    have hToSecBdry : ∀ (n : ℕ) {P : PSh} (η : freePre (weilEtaleCechObj w n) ⟶ P),
        toSec (cechBdry n ≫ η) = weilEtaleCechDiff P w n (toSec η) := by
      intro n P η
      dsimp only [toSec, cechBdry]
      rw [CategoryTheory.Preadditive.sum_comp]
      simp_rw [CategoryTheory.Preadditive.zsmul_comp]
      rw [hEvalNatSum]
      simp only [weilEtaleCechDiff, AddMonoidHom.finsetSum_apply, AddMonoidHom.zsmul_apply]
      refine Finset.sum_congr rfl fun j _ => ?_
      congr 1
      change (η.app (Opposite.op (weilEtaleCechObj w (n + 1)))).hom
        (Finsupp.mapDomain (fun l => l ≫ weilEtaleCechFace w n j) (Finsupp.single (𝟙 _) 1)) = _
      rw [Finsupp.mapDomain_single, CategoryTheory.Category.id_comp]
      conv_lhs => rw [← hOfTo η]
      change (Finsupp.lift _ ℤ _ (fun k => (P.map k.op).hom (toSec η)))
        (Finsupp.single (weilEtaleCechFace w n j) 1) = _
      rw [Finsupp.lift_apply, Finsupp.sum_single_index (by simp), one_smul]
    have hBdryZero : cechBdry (p + 1) ≫ cechBdry p = 0 := by
      rw [← hOfTo (cechBdry (p + 1) ≫ cechBdry p), ← hOfTo 0]
      congr 1
      have hcomp : cechBdry (p + 1) ≫ cechBdry p =
          cechBdry (p + 1) ≫ (cechBdry p ≫ 𝟙 (freePre (weilEtaleCechObj w p))) := by
        rw [CategoryTheory.Category.comp_id]
      rw [hcomp, hToSecBdry, hToSecBdry, hDiffSq]
      simp [toSec]
    let SC := CategoryTheory.ShortComplex.mk (cechBdry (p + 1)) (cechBdry p) hBdryZero
    have hIntHomExt : ∀ {M : Type u} [AddCommGroup M] {f g : ℤ →+ M},
        f 1 = g 1 → f = g := by
      intro M _ f g h1
      apply DFunLike.ext
      intro m
      have hm : m = m • (1 : ℤ) := by simp
      rw [hm, map_zsmul, map_zsmul, h1]
    have hObjExact : ∀ V : S_K.Etale,
        (SC.map ((CategoryTheory.evaluation (S_K.Etale)ᵒᵖ AddCommGrpCat.{u}).obj
          (Opposite.op V))).Exact := by
      intro V
      let EV := (CategoryTheory.evaluation (S_K.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op V)
      rw [CategoryTheory.ShortComplex.ab_exact_iff_function_exact]
      intro u_vec
      constructor
      · intro hu_zero
        let sStar : ∀ (g : V ⟶ U), Nonempty { h : V ⟶ W // h ≫ w = g } →
            { h : V ⟶ W // h ≫ w = g } :=
          fun _ hne => Classical.choice hne
        have hChooseEq : ∀ (g₁ g₂ : V ⟶ U) (heq : g₁ = g₂)
            (hne₁ : Nonempty { h : V ⟶ W // h ≫ w = g₁ })
            (hne₂ : Nonempty { h : V ⟶ W // h ≫ w = g₂ }),
            (sStar g₁ hne₁).1 = (sStar g₂ hne₂).1 := by
          intro g₁ g₂ heq hne₁ hne₂
          subst heq
          rfl
        let κ : ∀ (q : ℕ),
            (V ⟶ weilEtaleCechObj w q) → (V ⟶ weilEtaleCechObj w (q + 1)) :=
          fun q l =>
            let hne : Nonempty { h : V ⟶ W // h ≫ w = l ≫ weilEtaleCechHom w q } :=
              ⟨⟨l ≫ weilEtaleCechProj w q 0,
                (CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (l ≫ ·) (weilEtaleCechProjSub w q 0).2)⟩⟩
            (weilEtaleCechLiftSub w (l ≫ weilEtaleCechHom w q) (q + 1)
              (Fin.cons (sStar (l ≫ weilEtaleCechHom w q) hne).1
                (fun i => l ≫ weilEtaleCechProj w q i))
              (fun r => Fin.cases (sStar _ hne).2
                (fun i => (CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (l ≫ ·) (weilEtaleCechProjSub w q i).2)) r)).1
        have hκ_zero : ∀ l : V ⟶ weilEtaleCechObj w (p + 1),
            κ (p + 1) l ≫ weilEtaleCechFace w (p + 1) 0 = l := by
          intro l
          apply hCechHomExt (p + 1)
          intro r
          rw [CategoryTheory.Category.assoc, hFaceProj, Fin.zero_succAbove]
          exact hLiftProj _ (p + 2) _ _ r.succ
        have hκ_succ : ∀ (l : V ⟶ weilEtaleCechObj w (p + 1)) (m : Fin (p + 2)),
            κ (p + 1) l ≫ weilEtaleCechFace w (p + 1) m.succ =
              κ p (l ≫ weilEtaleCechFace w p m) := by
          intro l m
          apply hCechHomExt (p + 1)
          intro r
          refine Fin.cases ?_ ?_ r
          · rw [CategoryTheory.Category.assoc, hFaceProj]
            have hm0 : m.succ.succAbove 0 = 0 := by
              simp only [Fin.succAbove]
              split_ifs with hlt
              · rfl
              · exfalso
                exact hlt (Fin.succ_pos m)
            rw [hm0, hLiftProj, hLiftProj]
            simp only [Fin.cons_zero]
            apply hChooseEq
            rw [CategoryTheory.Category.assoc, hFaceHom]
          · intro i
            rw [CategoryTheory.Category.assoc, hFaceProj, Fin.succ_succAbove_succ,
              hLiftProj, hLiftProj]
            simp only [Fin.cons_succ]
            rw [CategoryTheory.Category.assoc, hFaceProj]
        let k_p : ((V ⟶ weilEtaleCechObj w p) →₀ ℤ) →+
            ((V ⟶ weilEtaleCechObj w (p + 1)) →₀ ℤ) :=
          Finsupp.mapDomain.addMonoidHom (κ p)
        let k_p1 : ((V ⟶ weilEtaleCechObj w (p + 1)) →₀ ℤ) →+
            ((V ⟶ weilEtaleCechObj w (p + 2)) →₀ ℤ) :=
          Finsupp.mapDomain.addMonoidHom (κ (p + 1))
        let d_p1 : ((V ⟶ weilEtaleCechObj w (p + 2)) →₀ ℤ) →+
            ((V ⟶ weilEtaleCechObj w (p + 1)) →₀ ℤ) :=
          ((SC.map EV).f).hom
        let d_p : ((V ⟶ weilEtaleCechObj w (p + 1)) →₀ ℤ) →+
            ((V ⟶ weilEtaleCechObj w p) →₀ ℤ) :=
          ((SC.map EV).g).hom
        have hHomotopy : d_p1.comp k_p1 + k_p.comp d_p = AddMonoidHom.id _ := by
          apply Finsupp.addHom_ext'
          intro l
          apply hIntHomExt
          simp only [AddMonoidHom.add_apply, AddMonoidHom.comp_apply, AddMonoidHom.id_apply,
            Finsupp.singleAddHom_apply, k_p1, k_p, Finsupp.mapDomain.addMonoidHom_apply,
            Finsupp.mapDomain_single]
          change ((cechBdry (p + 1)).app (Opposite.op V)).hom (Finsupp.single (κ (p + 1) l) 1) +
            Finsupp.mapDomain (κ p) (((cechBdry p).app (Opposite.op V)).hom (Finsupp.single l 1)) =
            Finsupp.single l 1
          dsimp only [cechBdry]
          rw [hEvalNatSum, hEvalNatSum]
          have h1 : ∀ j : Fin (p + 3),
              ((freePreMap (weilEtaleCechFace w (p + 1) j)).app (Opposite.op V)).hom
                (Finsupp.single (κ (p + 1) l) (1 : ℤ)) =
              Finsupp.single (κ (p + 1) l ≫ weilEtaleCechFace w (p + 1) j) (1 : ℤ) := fun _ =>
            Finsupp.mapDomain_single
          have h2 : ∀ j : Fin (p + 2),
              ((freePreMap (weilEtaleCechFace w p j)).app (Opposite.op V)).hom
                (Finsupp.single l (1 : ℤ)) =
              Finsupp.single (l ≫ weilEtaleCechFace w p j) (1 : ℤ) := fun _ =>
            Finsupp.mapDomain_single
          simp_rw [h1, h2]
          rw [← Finsupp.mapDomain.addMonoidHom_apply, map_sum]
          have h3 : ∀ j : Fin (p + 2),
              (Finsupp.mapDomain.addMonoidHom (κ p))
                ((-1 : ℤ) ^ (j : ℕ) • Finsupp.single (l ≫ weilEtaleCechFace w p j) (1 : ℤ)) =
              (-1 : ℤ) ^ (j : ℕ) • Finsupp.single (κ p (l ≫ weilEtaleCechFace w p j)) (1 : ℤ) := by
            intro j
            rw [map_zsmul, Finsupp.mapDomain.addMonoidHom_apply, Finsupp.mapDomain_single]
          simp_rw [h3]
          rw [Fin.sum_univ_succ, hκ_zero l, Fin.val_zero, pow_zero, one_smul, add_assoc]
          convert add_zero (Finsupp.single l (1 : ℤ))
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_eq_zero fun j _ => ?_
          rw [hκ_succ l j, ← add_smul]
          have hsign : (-1 : ℤ) ^ (j.succ : ℕ) + (-1 : ℤ) ^ (j : ℕ) = 0 := by
            rw [Fin.val_succ, pow_succ]
            ring
          rw [hsign, zero_smul]
        refine ⟨k_p1 u_vec, ?_⟩
        have happ := DFunLike.congr_fun hHomotopy u_vec
        simp only [AddMonoidHom.add_apply, AddMonoidHom.comp_apply] at happ
        have hdp_zero : d_p u_vec = 0 := hu_zero
        rw [hdp_zero, map_zero, add_zero] at happ
        exact happ
      · rintro ⟨y_vec, rfl⟩
        change (((SC.map EV).f ≫ (SC.map EV).g)).hom y_vec = 0
        rw [(SC.map EV).zero]
        rfl
    have hHomZero : CategoryTheory.Limits.IsZero SC.homology := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext V : 2
      let EV := (CategoryTheory.evaluation (S_K.Etale)ᵒᵖ AddCommGrpCat.{u}).obj V
      have hZeroV : CategoryTheory.Limits.IsZero ((SC.map EV).homology) :=
        (CategoryTheory.ShortComplex.exact_iff_isZero_homology (SC.map EV)).mp
          (hObjExact V.unop)
      have hZeroObj : CategoryTheory.Limits.IsZero (SC.homology.obj V) :=
        hZeroV.of_iso (SC.mapHomologyIso EV).symm
      exact hZeroObj.eq_of_src _ _
    have hSCExact : SC.Exact :=
      (CategoryTheory.ShortComplex.exact_iff_isZero_homology SC).mpr hHomZero
    have : CategoryTheory.Injective I.obj :=
      CategoryTheory.Injective.injective_of_adjoint
        (CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}) I
    let η_z : SC.X₂ ⟶ I.obj := ofSec z
    have hη_zero : SC.f ≫ η_z = 0 := by
      change cechBdry (p + 1) ≫ η_z = 0
      rw [← hOfTo (cechBdry (p + 1) ≫ η_z), ← hOfTo 0]
      congr 1
      rw [hToSecBdry, show toSec η_z = z from hToOf z, hz]
      simp [toSec]
    let η_b : SC.X₃ ⟶ I.obj := hSCExact.descToInjective η_z hη_zero
    have hcomp_b : cechBdry p ≫ η_b = η_z := hSCExact.comp_descToInjective η_z hη_zero
    refine ⟨toSec η_b, ?_⟩
    rw [← hToSecBdry p η_b, hcomp_b]
    exact hToOf z

  
  have hAffNerve : ∀ (U W : S_K.Etale) [U.left.IsSeparated]
      [AlgebraicGeometry.IsAffine W.left] (w : W ⟶ U) (n : ℕ),
      AlgebraicGeometry.IsAffine (weilEtaleCechObj w n).left := by
    intro U W _ _ w n
    let t_U := CategoryTheory.Limits.terminal.from U.left
    have : AlgebraicGeometry.IsSeparated t_U :=
      AlgebraicGeometry.Scheme.IsSeparated.isSeparated_terminal_from
    have : AlgebraicGeometry.IsAffineHom (w.left ≫ t_U) :=
      AlgebraicGeometry.isAffineHom_of_isAffine (w.left ≫ t_U)
    have : AlgebraicGeometry.IsAffineHom w.left :=
      AlgebraicGeometry.IsAffineHom.of_comp w.left t_U
    induction n with
    | zero =>
      exact (inferInstance : AlgebraicGeometry.IsAffine W.left)
    | succ n ih =>
      let _ : AlgebraicGeometry.IsAffine (weilEtaleCechObj w n).left := ih
      have hAff_pb : AlgebraicGeometry.IsAffine
          (CategoryTheory.Limits.pullback (weilEtaleCechHom w n).left w.left) :=
        AlgebraicGeometry.instIsAffinePullbackSchemeOfIsAffineHom_1
          (weilEtaleCechHom w n).left w.left
      let FgtSch :=
        CategoryTheory.Functor.comp
          (AlgebraicGeometry.Scheme.Etale.forget S_K)
          (CategoryTheory.Over.forget S_K)
      let e_pb :=
        CategoryTheory.Limits.PreservesPullback.iso FgtSch (weilEtaleCechHom w n) w
      exact @AlgebraicGeometry.IsAffine.of_isIso _ _ e_pb.hom
        (CategoryTheory.Iso.isIso_hom e_pb) hAff_pb

  have hDiffNat : ∀ {P₁ P₂ : (S_K.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}} (α : P₁ ⟶ P₂)
      {W U : S_K.Etale} (w : W ⟶ U) (m : ℕ)
      (x : ↥(P₁.obj (Opposite.op (weilEtaleCechObj w m)))),
      (α.app (Opposite.op (weilEtaleCechObj w (m + 1)))).hom (weilEtaleCechDiff P₁ w m x) =
        weilEtaleCechDiff P₂ w m ((α.app (Opposite.op (weilEtaleCechObj w m))).hom x) := by
    intro P₁ P₂ α W U w m x
    simp only [weilEtaleCechDiff, AddMonoidHom.finsetSum_apply, AddMonoidHom.zsmul_apply,
      map_sum, map_zsmul]
    refine Finset.sum_congr rfl fun j _ => ?_
    congr 1
    have hnat := α.naturality (weilEtaleCechFace w m j).op
    exact congrArg (fun φ => φ.hom x) hnat

  
  have hInjColimAcyclic : ∀ (Idx₀ : Type u) [CategoryTheory.SmallCategory Idx₀]
      [CategoryTheory.IsFiltered Idx₀]
      (I_diag : CategoryTheory.Functor Idx₀
        (CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u})),
      (∀ j : Idx₀, CategoryTheory.Injective (I_diag.obj j)) →
      ∀ (c_I : CategoryTheory.Limits.Cocone I_diag), CategoryTheory.Limits.IsColimit c_I →
      ∀ (r : ℕ), 1 ≤ r → Subsingleton (c_I.pt.H r) := by
    intro Idx₀ _ _ I_diag hInj c_I hc_I r hr
    refine weil_etale_qc_sep_cech_vanishing_implies_H_subsingleton S_K c_I.pt ?_ r hr
    intro U W _ _ _ w _ p z hz
    let W_p := weilEtaleCechObj w p
    let W_p1 := weilEtaleCechObj w (p + 1)
    let W_p2 := weilEtaleCechObj w (p + 2)
    have : AlgebraicGeometry.IsAffine W_p1.left := hAffNerve U W w (p + 1)
    have : AlgebraicGeometry.IsAffine W_p2.left := hAffNerve U W w (p + 2)
    obtain ⟨hc_p1_ab⟩ :=
      weil_alt_cd_qcsep_etale_filtered_colimit_eval_iso S_K Idx₀ I_diag c_I hc_I W_p1
    obtain ⟨hc_p2_ab⟩ :=
      weil_alt_cd_qcsep_etale_filtered_colimit_eval_iso S_K Idx₀ I_diag c_I hc_I W_p2
    let hc_p1 :=
      CategoryTheory.Limits.isColimitOfPreserves (CategoryTheory.forget AddCommGrpCat.{u}) hc_p1_ab
    let hc_p2 :=
      CategoryTheory.Limits.isColimitOfPreserves (CategoryTheory.forget AddCommGrpCat.{u}) hc_p2_ab
    obtain ⟨j₀, z_j₀_raw, hz_j₀⟩ :=
      CategoryTheory.Limits.Types.jointly_surjective_of_isColimit hc_p1 z
    let z_j₀ : ↥((I_diag.obj j₀).obj.obj (Opposite.op W_p1)) := z_j₀_raw
    have hz_j₀' : ((c_I.ι.app j₀).hom.app (Opposite.op W_p1)).hom z_j₀ = z := hz_j₀
    have hzero_colim :
        ((CategoryTheory.forget AddCommGrpCat.{u}).mapCocone
          (((CategoryTheory.Functor.comp
            (CategoryTheory.sheafToPresheaf S_K.smallEtaleTopology AddCommGrpCat.{u})
            ((CategoryTheory.evaluation (S_K.Etale)ᵒᵖ AddCommGrpCat.{u}).obj
              (Opposite.op W_p2)))).mapCocone c_I)).ι.app j₀
          (weilEtaleCechDiff (I_diag.obj j₀).obj w (p + 1) z_j₀) =
        ((CategoryTheory.forget AddCommGrpCat.{u}).mapCocone
          (((CategoryTheory.Functor.comp
            (CategoryTheory.sheafToPresheaf S_K.smallEtaleTopology AddCommGrpCat.{u})
            ((CategoryTheory.evaluation (S_K.Etale)ᵒᵖ AddCommGrpCat.{u}).obj
              (Opposite.op W_p2)))).mapCocone c_I)).ι.app j₀ 0 := by
      change ((c_I.ι.app j₀).hom.app (Opposite.op W_p2)).hom
          (weilEtaleCechDiff (I_diag.obj j₀).obj w (p + 1) z_j₀) =
        ((c_I.ι.app j₀).hom.app (Opposite.op W_p2)).hom 0
      rw [map_zero,
        @hDiffNat (I_diag.obj j₀).obj c_I.pt.obj (c_I.ι.app j₀).hom W U w (p + 1) z_j₀,
        hz_j₀', hz]
    obtain ⟨k, f, g, hfg⟩ :=
      (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff _ hc_p2).mp hzero_colim
    have hfk_zero :
        ((I_diag.map f).hom.app (Opposite.op W_p2)).hom
          (weilEtaleCechDiff (I_diag.obj j₀).obj w (p + 1) z_j₀) = 0 := by
      have hfg' : ((I_diag.map f).hom.app (Opposite.op W_p2)).hom
          (weilEtaleCechDiff (I_diag.obj j₀).obj w (p + 1) z_j₀) =
        ((I_diag.map g).hom.app (Opposite.op W_p2)).hom 0 := hfg
      rw [map_zero] at hfg'
      exact hfg'
    let z_k : ↥((I_diag.obj k).obj.obj (Opposite.op W_p1)) :=
      ((I_diag.map f).hom.app (Opposite.op W_p1)).hom z_j₀
    have hzk_cocycle : weilEtaleCechDiff (I_diag.obj k).obj w (p + 1) z_k = 0 := by
      rw [← @hDiffNat (I_diag.obj j₀).obj (I_diag.obj k).obj (I_diag.map f).hom W U w (p + 1) z_j₀]
      exact hfk_zero
    let _ : CategoryTheory.Injective (I_diag.obj k) := hInj k
    obtain ⟨b_k, hb_k⟩ := hInjCechExact (I_diag.obj k) w p z_k hzk_cocycle
    refine ⟨((c_I.ι.app k).hom.app (Opposite.op (weilEtaleCechObj w p))).hom b_k, ?_⟩
    rw [← @hDiffNat (I_diag.obj k).obj c_I.pt.obj (c_I.ι.app k).hom W U w p b_k, hb_k]
    have hcomm := c_I.w f
    have hcomm_app :
        ((I_diag.map f).hom.app (Opposite.op W_p1) ≫
          (c_I.ι.app k).hom.app (Opposite.op W_p1)).hom z_j₀ =
        ((c_I.ι.app j₀).hom.app (Opposite.op W_p1)).hom z_j₀ :=
      congrArg (fun ψ => (ψ.hom.app (Opposite.op W_p1)).hom z_j₀) hcomm
    exact hcomm_app.trans hz_j₀'

  
  exact weil_alt_cd_grothendieck_filtered_colimit_H_vanishing S_K hH0Surj hInjColimAcyclic
    Idx D c hc₀ s hSub

theorem weil_alt_cd_field_sheaf_galois_exhaustion (K : Type u) [Field K]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u})
    (hℓ_G : ℓ • CategoryTheory.CategoryStruct.id G = 0) :
    ∃ (Idx : Type u) (_ : CategoryTheory.SmallCategory Idx) (_ : CategoryTheory.IsFiltered Idx)
      (D : CategoryTheory.Functor Idx
        (CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}))
      (c : CategoryTheory.Limits.Cocone D),
      c.pt = G ∧
      Nonempty (CategoryTheory.Limits.IsColimit c) ∧
      ∀ j : Idx,
        ℓ • CategoryTheory.CategoryStruct.id (D.obj j) = 0 ∧
        ∃ (M : Type u) (_ : Field M) (_ : Algebra K M)
          (_ : FiniteDimensional K M) (_ : IsGalois K M)
          (hEt : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K M))))
          (r : ℕ),
          Nonempty ((CategoryTheory.Functor.comp (weilAltCdFieldEtaleMap hEt).op (D.obj j).obj) ≅
            weilAltCdDiscreteVecPresheaf (AlgebraicGeometry.Spec (CommRingCat.of M)) ℓ r) :=
by
  have hPart1 :
      (∀ (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M] [Algebra.IsSeparable K M],
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K M))) ∧
        AlgebraicGeometry.Surjective (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K M)))) ∧
      (∀ (M : Type u) [Field M] (V : (AlgebraicGeometry.Spec (CommRingCat.of M)).Etale),
        DiscreteTopology ↥V.left) ∧
      (∀ (U : (AlgebraicGeometry.Spec (CommRingCat.of K)).Etale) (p : ↥U.left),
        ∃ (L : IntermediateField K (SeparableClosure K))
          (_ : FiniteDimensional K ↥L) (_ : IsGalois K ↥L)
          (hEt : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥L))))
          (f : (weilAltCdFieldEtaleMap hEt).obj
            (CategoryTheory.MorphismProperty.Over.mk ⊤
              (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of ↥L)))
              inferInstance) ⟶ U)
          (q : ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥L))),
          f.left.base q = p) := by
    have h1 : ∀ (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M] [Algebra.IsSeparable K M],
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K M))) ∧
        AlgebraicGeometry.Surjective (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K M))) := by
      intro M _ _ _ _
      let e_punit : M ≃ₐ[K] (PUnit.{u + 1} → M) :=
        { toFun := fun m _ => m
          invFun := fun f => f PUnit.unit
          left_inv := fun _ => rfl
          right_inv := fun f => funext fun ⟨⟩ => rfl
          map_mul' := fun _ _ => rfl
          map_add' := fun _ _ => rfl
          commutes' := fun _ => rfl }
      have hAlgEt : Algebra.Etale K M :=
        (Algebra.Etale.iff_exists_algEquiv_prod K M).mpr
          ⟨PUnit.{u + 1}, inferInstance, fun _ => M, fun _ => inferInstance,
            fun _ => inferInstance, e_punit, fun _ => ⟨inferInstance, inferInstance⟩⟩
      have hRingEt : (algebraMap K M).Etale := RingHom.etale_algebraMap.mpr hAlgEt
      refine ⟨?_, ⟨fun y => ⟨Classical.arbitrary _, Subsingleton.elim _ y⟩⟩⟩
      rw [AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)]
      exact hRingEt
    refine ⟨h1, ?_, ?_⟩
    · intro M _ V
      rw [discreteTopology_iff_isOpen_singleton]
      intro x
      obtain ⟨V₀, hV₀, hx, _⟩ :=
        exists_isAffineOpen_mem_and_subset (U := (⊤ : V.left.Opens)) (x := x) trivial
      let S_M : Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of M)
      let R_A : CommRingCat.{u} := V.left.presheaf.obj (Opposite.op V₀)
      let A : Type u := ↑R_A
      let φ_sch : AlgebraicGeometry.Spec R_A ⟶ S_M := hV₀.fromSpec ≫ V.hom
      have hEt_φ : AlgebraicGeometry.Etale φ_sch := by
        have : AlgebraicGeometry.Etale V.hom := V.prop
        exact inferInstance
      let φ_ring : CommRingCat.of M ⟶ R_A :=
        (AlgebraicGeometry.Spec.fullyFaithful.preimage φ_sch).unop
      have hSpec_φ : AlgebraicGeometry.Spec.map φ_ring = φ_sch :=
        AlgebraicGeometry.Spec.fullyFaithful.map_preimage φ_sch
      have hEt_ring : (CommRingCat.Hom.hom φ_ring).Etale := by
        rw [← HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale), hSpec_φ]
        exact hEt_φ
      let _ : Algebra M A := (CommRingCat.Hom.hom φ_ring).toAlgebra
      have hAlgEt : Algebra.Etale M A := RingHom.etale_algebraMap.mp hEt_ring
      obtain ⟨I, _, Ai, hFieldAi, hAlgAi, e_prod, hModAi⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod M A).mp hAlgEt
      let _ : Fintype I := Fintype.ofFinite I
      let _ : ∀ i, Field (Ai i) := hFieldAi
      let _ : ∀ i, Algebra M (Ai i) := hAlgAi
      have _ : ∀ i, Module.Finite M (Ai i) := fun i => (hModAi i).1
      have _ : Module.Finite M A := Module.Finite.equiv e_prod.symm.toLinearEquiv
      have _ : IsArtinianRing A := IsArtinianRing.of_finite M A
      have hDiscSpec : DiscreteTopology (PrimeSpectrum A) := inferInstance
      let y : ↥(AlgebraicGeometry.Spec R_A) := hV₀.isoSpec.hom.base ⟨x, hx⟩
      have hy_open : IsOpen ({y} : Set ↥(AlgebraicGeometry.Spec R_A)) :=
        @isOpen_discrete _ _ hDiscSpec {y}
      have hy_eq : hV₀.fromSpec.base y = x := by
        change (hV₀.isoSpec.hom ≫ hV₀.fromSpec).base ⟨x, hx⟩ = x
        rw [IsAffineOpen.isoSpec_hom_fromSpec]
        rfl
      have hOpenEmb : Topology.IsOpenEmbedding hV₀.fromSpec.base :=
        AlgebraicGeometry.Scheme.Hom.isOpenEmbedding hV₀.fromSpec
      have hImg := hOpenEmb.isOpenMap {y} hy_open
      rwa [Set.image_singleton, hy_eq] at hImg
    · intro U p
      let S_K : Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of K)
      obtain ⟨V₀, hV₀, hp, _⟩ :=
        exists_isAffineOpen_mem_and_subset (U := (⊤ : U.left.Opens)) (x := p) trivial
      let R_A : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op V₀)
      let A : Type u := ↑R_A
      let φ_sch : AlgebraicGeometry.Spec R_A ⟶ S_K := hV₀.fromSpec ≫ U.hom
      have hEt_φ : AlgebraicGeometry.Etale φ_sch := by
        have : AlgebraicGeometry.Etale U.hom := U.prop
        exact inferInstance
      let φ_ring : CommRingCat.of K ⟶ R_A :=
        (AlgebraicGeometry.Spec.fullyFaithful.preimage φ_sch).unop
      have hSpec_φ : AlgebraicGeometry.Spec.map φ_ring = φ_sch :=
        AlgebraicGeometry.Spec.fullyFaithful.map_preimage φ_sch
      have hEt_ring : (CommRingCat.Hom.hom φ_ring).Etale := by
        rw [← HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale), hSpec_φ]
        exact hEt_φ
      let _ : Algebra K A := (CommRingCat.Hom.hom φ_ring).toAlgebra
      have hAlgEt : Algebra.Etale K A := RingHom.etale_algebraMap.mp hEt_ring
      obtain ⟨I, _, Ai, hFieldAi, hAlgAi, e_prod, hModAi⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K A).mp hAlgEt
      let _ : Fintype I := Fintype.ofFinite I
      let _ : DecidableEq I := Classical.decEq I
      let _ : ∀ i, Field (Ai i) := hFieldAi
      let _ : ∀ i, Algebra K (Ai i) := hAlgAi
      have _ : ∀ i, Module.Finite K (Ai i) := fun i => (hModAi i).1
      have _ : ∀ i, Algebra.IsSeparable K (Ai i) := fun i => (hModAi i).2
      let pt_A : ↥(AlgebraicGeometry.Spec R_A) := hV₀.isoSpec.hom.base ⟨p, hp⟩
      have hpt_eq : hV₀.fromSpec.base pt_A = p := by
        change (hV₀.isoSpec.hom ≫ hV₀.fromSpec).base ⟨p, hp⟩ = p
        rw [IsAffineOpen.isoSpec_hom_fromSpec]
        rfl
      have hex_i : ∃ i₀ : I, e_prod.symm (Pi.single i₀ 1) ∉ pt_A.asIdeal := by
        by_contra! hall
        have hsum : ∑ i : I, e_prod.symm (Pi.single i 1) ∈ pt_A.asIdeal :=
          Ideal.sum_mem pt_A.asIdeal fun i _ => hall i
        have hone_pi : (∑ i : I, Pi.single i (1 : Ai i)) = 1 := by
          ext j
          simp
        rw [← map_sum, hone_pi, map_one] at hsum
        exact pt_A.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr hsum)
      obtain ⟨i₀, hi₀⟩ := hex_i
      let π₀ : A →ₐ[K] Ai i₀ := (Pi.evalAlgHom K Ai i₀).comp e_prod.toAlgHom
      have hπ₀_surj : Function.Surjective π₀.toRingHom := fun y =>
        ⟨e_prod.symm (Pi.single i₀ y), by simp [π₀]⟩
      have hker_le : RingHom.ker π₀.toRingHom ≤ pt_A.asIdeal := by
        intro a ha
        have hmul_zero : a * e_prod.symm (Pi.single i₀ 1) = 0 := by
          apply e_prod.injective
          rw [map_mul, map_zero, AlgEquiv.apply_symm_apply]
          ext j
          by_cases hj : j = i₀
          · subst hj
            change π₀ a * Pi.single j 1 j = 0
            rw [show π₀ a = 0 from ha, zero_mul]
          · simp [Pi.single_eq_of_ne hj]
        have hmem : a * e_prod.symm (Pi.single i₀ 1) ∈ pt_A.asIdeal := by
          rw [hmul_zero]
          exact Ideal.zero_mem _
        exact (pt_A.isPrime.mem_or_mem hmem).resolve_right hi₀
      have hker_max : (RingHom.ker π₀.toRingHom).IsMaximal :=
        RingHom.ker_isMaximal_of_surjective π₀.toRingHom hπ₀_surj
      have hker_eq : RingHom.ker π₀.toRingHom = pt_A.asIdeal :=
        hker_max.eq_of_le pt_A.isPrime.ne_top hker_le
      let K_sep := SeparableClosure K
      let emb : Ai i₀ →ₐ[K] K_sep := IsSepClosed.lift
      let L : IntermediateField K K_sep := IntermediateField.normalClosure K (Ai i₀) K_sep
      have hFinL : FiniteDimensional K ↥L := normalClosure.is_finiteDimensional K (Ai i₀) K_sep
      have hGalL : IsGalois K ↥L := IsGalois.normalClosure K (Ai i₀) K_sep
      have hle_L : emb.fieldRange ≤ L := AlgHom.fieldRange_le_normalClosure emb
      let emb_L : Ai i₀ →ₐ[K] ↥L :=
        { toFun := fun y => ⟨emb y, hle_L (emb.mem_fieldRange_self y)⟩
          map_one' := Subtype.ext emb.map_one
          map_mul' := fun x y => Subtype.ext (emb.map_mul x y)
          map_zero' := Subtype.ext emb.map_zero
          map_add' := fun x y => Subtype.ext (emb.map_add x y)
          commutes' := fun c => Subtype.ext (emb.commutes c) }
      let ρ : A →ₐ[K] ↥L := emb_L.comp π₀
      have hEtL : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥L))) := (h1 ↥L).1
      let f_sch : AlgebraicGeometry.Spec (CommRingCat.of ↥L) ⟶ U.left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom) ≫ hV₀.fromSpec
      have hρ_ring : φ_ring ≫ CommRingCat.ofHom ρ.toRingHom =
          CommRingCat.ofHom (algebraMap K ↥L) :=
        CommRingCat.hom_ext ρ.comp_algebraMap
      have hf_w : f_sch ≫ U.hom =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of ↥L)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥L)) := by
        rw [Category.id_comp]
        calc
          f_sch ≫ U.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom) ≫ φ_sch :=
            Category.assoc _ _ _
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom) ≫
                AlgebraicGeometry.Spec.map φ_ring := by rw [hSpec_φ]
          _ = AlgebraicGeometry.Spec.map (φ_ring ≫ CommRingCat.ofHom ρ.toRingHom) :=
            (AlgebraicGeometry.Spec.map_comp _ _).symm
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥L)) := by rw [hρ_ring]
      let f : (weilAltCdFieldEtaleMap hEtL).obj
          (CategoryTheory.MorphismProperty.Over.mk ⊤
            (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of ↥L)))
            inferInstance) ⟶ U :=
        CategoryTheory.MorphismProperty.Over.homMk f_sch hf_w
      let q : ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥L)) := (⊥ : PrimeSpectrum ↥L)
      have hq_spec : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom)).base q = pt_A := by
        apply PrimeSpectrum.ext
        change Ideal.comap ρ.toRingHom ⊥ = pt_A.asIdeal
        rw [← RingHom.ker_eq_comap_bot, ← hker_eq]
        ext a
        simp only [RingHom.mem_ker]
        exact ⟨fun h => emb_L.injective (h.trans emb_L.map_zero.symm),
          fun h => by
            have h0 : π₀ a = 0 := h
            change emb_L (π₀ a) = 0
            rw [h0, map_zero]⟩
      refine ⟨L, hFinL, hGalL, hEtL, f, q, ?_⟩
      change hV₀.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom)).base q) = p
      rw [hq_spec, hpt_eq]

  have hPart2 : ∀ (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M] [IsGalois K M],
      let π_M := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K M))
      ∃ ι : (M ≃ₐ[K] M) →
        (AlgebraicGeometry.Spec (CommRingCat.of M) ⟶ CategoryTheory.Limits.pullback π_M π_M),
        (∀ σ : M ≃ₐ[K] M,
          AlgebraicGeometry.IsOpenImmersion (ι σ) ∧
          CategoryTheory.CategoryStruct.comp (ι σ) (CategoryTheory.Limits.pullback.fst π_M π_M) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) ∧
          CategoryTheory.CategoryStruct.comp (ι σ) (CategoryTheory.Limits.pullback.snd π_M π_M) =
            CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of M))) ∧
        (∀ z : ↥(CategoryTheory.Limits.pullback π_M π_M),
          ∃ σ : M ≃ₐ[K] M, z ∈ Set.range (ι σ).base) := by
    intro M _ _ _ _ π_M
    let Γ := (M ≃ₐ[K] M)
    have hFinΓ : Finite Γ := Finite.of_injective (fun σ : Γ => σ.toAlgHom) AlgEquiv.coe_toAlgHom_injective
    let _ : Fintype Γ := Fintype.ofFinite Γ
    let dec_Γ : DecidableEq Γ := Classical.decEq Γ
    let _ : DecidableEq Γ := dec_Γ
    let R := (Γ → M)
    let Ψ₀ : TensorProduct K M M →ₐ[M] R :=
      Algebra.TensorProduct.lift (Algebra.ofId M R)
        (AlgHom.pi (fun σ : Γ => σ.toAlgHom))
        (fun _ _ => Commute.all _ _)
    let b_K : Module.Basis (Fin (Module.finrank K M)) K M := Module.finBasis K M
    have hCardΓ : Fintype.card Γ = Module.finrank K M := by
      rw [Fintype.card_eq_nat_card]
      exact IsGalois.card_aut_eq_finrank K M
    let e_Γ : Γ ≃ Fin (Module.finrank K M) := Fintype.equivFinOfCardEq hCardΓ
    let b_Γ : Module.Basis Γ K M := b_K.reindex e_Γ.symm
    let b_M : Module.Basis Γ M (TensorProduct K M M) := b_Γ.baseChange M
    let B : Matrix Γ Γ M := fun σ τ => σ (b_Γ τ)
    have hLI : LinearIndependent M (fun σ : Γ => σ.toAlgHom.toLinearMap) :=
      (linearIndependent_algHom_toLinearMap K M M).comp
        (fun σ : Γ => σ.toAlgHom) AlgEquiv.coe_toAlgHom_injective
    have hVecInj : Function.Injective B.vecMul := by
      intro d₁ d₂ h
      have hd : B.vecMul (d₁ - d₂) = 0 := by
