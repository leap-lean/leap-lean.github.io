        have hInj_colim : CategoryTheory.Injective
            (CategoryTheory.Limits.colimit (CategoryTheory.Functor.comp D J_inj)) :=
          hInjColim Λ (CategoryTheory.Functor.comp D J_inj) (fun j => hInj_J (D.obj j))
        have hSub_mid : Subsingleton
            (CategoryTheory.Abelian.Ext.{u} U₀
              (CategoryTheory.Limits.colimit (CategoryTheory.Functor.comp D J_inj)) ((k + 1) + 1)) :=
          hInjExtSub _ hInj_colim (k + 1)
