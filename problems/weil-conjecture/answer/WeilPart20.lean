              (CategoryTheory.Limits.pullback.lift γ_Y (𝟙 S_Ω) hγY_bar)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
          refine ⟨Y₀, f, hfR, σ_Y, ?_⟩
          change σ_Y ≫ B_z.map f = σ_x
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          let f_σY : S_Ω ⟶ (Fgt_Ω.obj (B_z.obj Y₀)).left := (Fgt_Ω.map σ_Y).left
          let p_fst_Y₀ : (Fgt_Ω.obj (B_z.obj Y₀)).left ⟶ (Fgt_S.obj Y₀).left :=
            CategoryTheory.Limits.pullback.fst ((Fgt_S.obj Y₀).hom) z_bar
          change f_σY ≫ (Fgt_Ω.map (B_z.map f)).left = f_σx
          apply CategoryTheory.Limits.pullback.hom_ext
          · have hB_fst : (Fgt_Ω.map (B_z.map f)).left ≫ p_fst_Ux = p_fst_Y₀ ≫ ff :=
              CategoryTheory.Limits.pullback.lift_fst _ _ _
            have hσY_fst : f_σY ≫ p_fst_Y₀ = γ_Y :=
              CategoryTheory.Limits.pullback.lift_fst _ _ _
            change (f_σY ≫ (Fgt_Ω.map (B_z.map f)).left) ≫ p_fst_Ux = γ_x
            rw [CategoryTheory.Category.assoc, hB_fst, ← CategoryTheory.Category.assoc,
              hσY_fst, hγY_f]
          · exact (Fgt_Ω.map (σ_Y ≫ B_z.map f)).w.trans (Fgt_Ω.map σ_x).w.symm }
    obtain ⟨_, ⟨adj_sky⟩⟩ := hSkyAdj Ω
    let getR {L : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u}}
        {R : AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}}
        (_ : L ⊣ R) := R
    let sky_Ω := getR adj_sky
    let pf_z := B_z.sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology S_Ω.smallEtaleTopology
    let R_z := sky_Ω ⋙ pf_z
    let adj_E : E_z ⊣ R_z :=
      (B_z.sheafAdjunctionContinuous AddCommGrpCat.{u}
        S.smallEtaleTopology S_Ω.smallEtaleTopology).comp adj_sky
    let shFib : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
      Φ_z.sheafFiber (A := AddCommGrpCat.{u})
    let descFam : ∀ (F : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (M : AddCommGrpCat.{u}) (η : F ⟶ R_z.obj M) (U : S.Etale) (σ : Φ_z.fiber.obj U),
        F.obj.obj (Opposite.op U) ⟶ M :=
      fun F M η U σ => AddCommGrpCat.ofHom
        { toFun := fun s => ((η.hom.app (Opposite.op U)).hom s) σ
          map_zero' := congrArg (fun f : fib_z.obj U → ↑M => f σ)
            (η.hom.app (Opposite.op U)).hom.map_zero'
          map_add' := fun s₁ s₂ => congrArg (fun f : fib_z.obj U → ↑M => f σ)
            ((η.hom.app (Opposite.op U)).hom.map_add' s₁ s₂) }
    have descCompat : ∀ (F : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (M : AddCommGrpCat.{u}) (η : F ⟶ R_z.obj M) ⦃X Y : S.Etale⦄ (f : X ⟶ Y)
        (x : Φ_z.fiber.obj X),
        F.obj.map f.op ≫ descFam F M η X x = descFam F M η Y (Φ_z.fiber.map f x) :=
      fun F M η X Y f x => AddCommGrpCat.ext fun s =>
        congrArg (fun ψ => (ψ.hom s) x) (η.hom.naturality f.op)
    let toSkyHom : ∀ (F : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (M : AddCommGrpCat.{u}) (φ : shFib.obj F ⟶ M), F ⟶ R_z.obj M :=
      fun F M φ =>
        { hom :=
            { app := fun U_op => AddCommGrpCat.ofHom
                { toFun := fun s σ => φ.hom ((Φ_z.toPresheafFiber U_op.unop σ F.obj).hom s)
                  map_zero' := funext fun σ =>
                    (congrArg φ.hom
                      (map_zero (Φ_z.toPresheafFiber U_op.unop σ F.obj).hom)).trans
                      (map_zero φ.hom)
                  map_add' := fun s₁ s₂ => funext fun σ =>
                    (congrArg φ.hom
                      (map_add (Φ_z.toPresheafFiber U_op.unop σ F.obj).hom s₁ s₂)).trans
                      (map_add φ.hom _ _) }
              naturality := fun {U₁ U₂} g => AddCommGrpCat.ext fun s => funext fun σ =>
                congrArg (fun ψ => φ.hom (ψ.hom s))
                  (Φ_z.toPresheafFiber_w g.unop σ F.obj) } }
    let adj_Φ : shFib ⊣ R_z :=
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun F M =>
            { toFun := toSkyHom F M
              invFun := fun η => Φ_z.presheafFiberDesc (descFam F M η) (descCompat F M η)
              left_inv := fun φ => by
                apply Φ_z.presheafFiber_hom_ext
                intro U σ
                exact (Φ_z.toPresheafFiber_presheafFiberDesc
                  (descFam F M (toSkyHom F M φ)) (descCompat F M (toSkyHom F M φ)) U σ).trans
                  (AddCommGrpCat.ext fun _ => rfl)
              right_inv := fun η => by
                apply CategoryTheory.Sheaf.hom_ext
                apply CategoryTheory.NatTrans.ext
                funext U_op
                apply AddCommGrpCat.ext
                intro s
                funext σ
                exact congrArg (fun ψ : F.obj.obj U_op ⟶ M => ψ.hom s)
                  (Φ_z.toPresheafFiber_presheafFiberDesc
                    (descFam F M η) (descCompat F M η) U_op.unop σ) }
          homEquiv_naturality_left_symm := fun {F' F M} h η => by
            apply Φ_z.presheafFiber_hom_ext
            intro U σ
            let D_η := Φ_z.presheafFiberDesc (descFam F M η) (descCompat F M η)
            have h_lhs := Φ_z.toPresheafFiber_presheafFiberDesc
              (descFam F' M (h ≫ η)) (descCompat F' M (h ≫ η)) U σ
            have h_mid : descFam F' M (h ≫ η) U σ =
                h.hom.app (Opposite.op U) ≫ descFam F M η U σ :=
              AddCommGrpCat.ext fun _ => rfl
            have h_desc := congrArg (h.hom.app (Opposite.op U) ≫ ·)
              (Φ_z.toPresheafFiber_presheafFiberDesc
                (descFam F M η) (descCompat F M η) U σ).symm
            have hw : Φ_z.toPresheafFiber U σ F'.obj ≫ Φ_z.presheafFiber.map h.hom =
                h.hom.app (Opposite.op U) ≫ Φ_z.toPresheafFiber U σ F.obj :=
              Φ_z.toPresheafFiber_naturality h.hom U σ
            have h_nat : h.hom.app (Opposite.op U) ≫ (Φ_z.toPresheafFiber U σ F.obj ≫ D_η) =
                Φ_z.toPresheafFiber U σ F'.obj ≫ (shFib.map h ≫ D_η) :=
              (CategoryTheory.Category.assoc (h.hom.app (Opposite.op U))
                (Φ_z.toPresheafFiber U σ F.obj) D_η).symm.trans
                ((congrArg (· ≫ D_η) hw.symm).trans
                  (CategoryTheory.Category.assoc (Φ_z.toPresheafFiber U σ F'.obj)
                    (Φ_z.presheafFiber.map h.hom) D_η))
            exact h_lhs.trans (h_mid.trans (h_desc.trans h_nat))
          homEquiv_naturality_right := fun {F M M'} φ k => by
            apply CategoryTheory.Sheaf.hom_ext
            apply CategoryTheory.NatTrans.ext
            funext U_op
            apply AddCommGrpCat.ext
            intro s
            rfl }
    let e_Ez : shFib ≅ E_z := adj_Φ.leftAdjointUniq adj_E
    haveI : CategoryTheory.Limits.PreservesFiniteLimits shFib := inferInstance
    have hLim : CategoryTheory.Limits.PreservesFiniteLimits E_z :=
      CategoryTheory.Limits.preservesFiniteLimits_of_natIso e_Ez
    have hColim : CategoryTheory.Limits.PreservesFiniteColimits E_z := by
      haveI := adj_E.leftAdjoint_preservesColimits
      infer_instance
    haveI : pf_z.Additive :=
      { map_add := fun {_ _ _ _} => CategoryTheory.Sheaf.hom_ext
          (CategoryTheory.NatTrans.ext (funext fun _ => rfl)) }
    haveI : sky_Ω.Additive :=
      { map_add := fun {_ _ _ _} => CategoryTheory.Sheaf.hom_ext
          (CategoryTheory.NatTrans.ext (funext fun _ =>
            AddCommGrpCat.ext fun _ => funext fun _ => rfl)) }
    haveI : R_z.Additive :=
      { map_add := fun {_ _ f g} => by
          change pf_z.map (sky_Ω.map (f + g)) = pf_z.map (sky_Ω.map f) + pf_z.map (sky_Ω.map g)
          rw [CategoryTheory.Functor.map_add, CategoryTheory.Functor.map_add] }
    haveI : E_z.Additive := adj_E.left_adjoint_additive
    exact ⟨hLim, hColim, inferInstance⟩

  
  have hIsoStalk : ∀ (S : AlgebraicGeometry.Scheme.{u})
      {F G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (α : Quiver.Hom F G),
      (∀ (y : ↥S),
        let κ := S.residueField y
        let Ω := AlgebraicClosure ↥κ
        let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
        let bar_y : Quiver.Hom S_Ω S :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
            (S.fromSpecResidueField y)
        Function.Bijective
          ((((weilEtaleSitePullback bar_y).sheafPullback AddCommGrpCat.{u}
            S.smallEtaleTopology S_Ω.smallEtaleTopology).map α).hom.app
            (Opposite.op (weilEtaleIdTerminal S_Ω)))) →
      CategoryTheory.IsIso α := by
    intro S F G α hBij
    have hKerZero : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel α) := by
      apply hZeroStalk S (CategoryTheory.Limits.kernel α)
      intro y
      let κ := S.residueField y
      let Ω := AlgebraicClosure ↥κ
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let T_Ω := weilEtaleIdTerminal S_Ω
      let bar_y : Quiver.Hom S_Ω S :=
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
          (S.fromSpecResidueField y)
      obtain ⟨hLimE, _, hZeroE⟩ := hGeomStalkExact S Ω bar_y
      let pb_y := (weilEtaleSitePullback bar_y).sheafPullback AddCommGrpCat.{u}
        S.smallEtaleTopology S_Ω.smallEtaleTopology
      let ev_Ω : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
        CategoryTheory.sheafToPresheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u} ⋙
          (CategoryTheory.evaluation (S_Ω.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op T_Ω)
      let E_y : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
        pb_y ⋙ ev_Ω
      haveI : E_y.PreservesZeroMorphisms := hZeroE
      haveI : CategoryTheory.Limits.PreservesFiniteLimits E_y := hLimE
      let e_stalk := AddEquiv.ofBijective (E_y.map α).hom (hBij y)
      let inv_map : E_y.obj G ⟶ E_y.obj F := AddCommGrpCat.ofHom e_stalk.symm.toAddMonoidHom
      have h_map_inv : E_y.map α ≫ inv_map = 𝟙 _ :=
        AddCommGrpCat.ext fun x => e_stalk.symm_apply_apply x
      let isoK : E_y.obj (CategoryTheory.Limits.kernel α) ≅
          CategoryTheory.Limits.kernel (E_y.map α) :=
        CategoryTheory.Limits.PreservesKernel.iso E_y α
      have hι_zero : CategoryTheory.Limits.kernel.ι (E_y.map α) = 0 := by
        calc
          CategoryTheory.Limits.kernel.ι (E_y.map α)
            = CategoryTheory.Limits.kernel.ι (E_y.map α) ≫ (E_y.map α ≫ inv_map) := by
                rw [h_map_inv, CategoryTheory.Category.comp_id]
          _ = (CategoryTheory.Limits.kernel.ι (E_y.map α) ≫ E_y.map α) ≫ inv_map := by
                rw [← CategoryTheory.Category.assoc]
          _ = 0 := by
                rw [CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
      have hid0 : 𝟙 (CategoryTheory.Limits.kernel (E_y.map α)) = 0 :=
        (cancel_mono (CategoryTheory.Limits.kernel.ι (E_y.map α))).mp
          (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Limits.zero_comp, hι_zero])
      refine ⟨fun a b => ?_⟩
      have ha : a = 0 := by
        have := congrArg isoK.inv (congrArg (fun φ => φ (isoK.hom a)) hid0)
        simpa using this
      have hb : b = 0 := by
        have := congrArg isoK.inv (congrArg (fun φ => φ (isoK.hom b)) hid0)
        simpa using this
      exact ha.trans hb.symm
    have hCokerZero : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel α) := by
      apply hZeroStalk S (CategoryTheory.Limits.cokernel α)
      intro y
      let κ := S.residueField y
      let Ω := AlgebraicClosure ↥κ
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let T_Ω := weilEtaleIdTerminal S_Ω
      let bar_y : Quiver.Hom S_Ω S :=
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
          (S.fromSpecResidueField y)
      obtain ⟨_, hColimE, hZeroE⟩ := hGeomStalkExact S Ω bar_y
      let pb_y := (weilEtaleSitePullback bar_y).sheafPullback AddCommGrpCat.{u}
        S.smallEtaleTopology S_Ω.smallEtaleTopology
      let ev_Ω : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
        CategoryTheory.sheafToPresheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u} ⋙
          (CategoryTheory.evaluation (S_Ω.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op T_Ω)
      let E_y : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
        pb_y ⋙ ev_Ω
      haveI : E_y.PreservesZeroMorphisms := hZeroE
      haveI : CategoryTheory.Limits.PreservesFiniteColimits E_y := hColimE
      let e_stalk := AddEquiv.ofBijective (E_y.map α).hom (hBij y)
      let inv_map : E_y.obj G ⟶ E_y.obj F := AddCommGrpCat.ofHom e_stalk.symm.toAddMonoidHom
      have h_inv_map : inv_map ≫ E_y.map α = 𝟙 _ :=
        AddCommGrpCat.ext fun x => e_stalk.apply_symm_apply x
      let isoQ : E_y.obj (CategoryTheory.Limits.cokernel α) ≅
          CategoryTheory.Limits.cokernel (E_y.map α) :=
        CategoryTheory.Limits.PreservesCokernel.iso E_y α
      have hπ_zero : CategoryTheory.Limits.cokernel.π (E_y.map α) = 0 := by
        calc
          CategoryTheory.Limits.cokernel.π (E_y.map α)
            = (inv_map ≫ E_y.map α) ≫ CategoryTheory.Limits.cokernel.π (E_y.map α) := by
                rw [h_inv_map, CategoryTheory.Category.id_comp]
          _ = inv_map ≫ (E_y.map α ≫ CategoryTheory.Limits.cokernel.π (E_y.map α)) := by
                rw [CategoryTheory.Category.assoc]
          _ = 0 := by
                rw [CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.comp_zero]
      have hid0 : 𝟙 (CategoryTheory.Limits.cokernel (E_y.map α)) = 0 :=
        (cancel_epi (CategoryTheory.Limits.cokernel.π (E_y.map α))).mp
          (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Limits.comp_zero, hπ_zero])
      refine ⟨fun a b => ?_⟩
      have ha : a = 0 := by
        have := congrArg isoQ.inv (congrArg (fun φ => φ (isoQ.hom a)) hid0)
        simpa using this
      have hb : b = 0 := by
        have := congrArg isoQ.inv (congrArg (fun φ => φ (isoQ.hom b)) hid0)
        simpa using this
      exact ha.trans hb.symm
    haveI : CategoryTheory.Mono α :=
      ⟨fun {W} f₁ f₂ hf => by
        have hsub : (f₁ - f₂) ≫ α = 0 := by
          rw [CategoryTheory.Preadditive.sub_comp, hf, sub_self]
        have hl : f₁ - f₂ = CategoryTheory.Limits.kernel.lift α (f₁ - f₂) hsub ≫
            CategoryTheory.Limits.kernel.ι α :=
          (CategoryTheory.Limits.kernel.lift_ι α (f₁ - f₂) hsub).symm
        rw [hKerZero.eq_zero_of_src (CategoryTheory.Limits.kernel.ι α),
          CategoryTheory.Limits.comp_zero] at hl
        exact sub_eq_zero.mp hl⟩
    haveI : CategoryTheory.Epi α :=
      ⟨fun {W} g₁ g₂ hg => by
        have hsub : α ≫ (g₁ - g₂) = 0 := by
          rw [CategoryTheory.Preadditive.comp_sub, hg, sub_self]
        have hd : g₁ - g₂ = CategoryTheory.Limits.cokernel.π α ≫
            CategoryTheory.Limits.cokernel.desc α (g₁ - g₂) hsub :=
          (CategoryTheory.Limits.cokernel.π_desc α (g₁ - g₂) hsub).symm
        rw [hCokerZero.eq_zero_of_tgt (CategoryTheory.Limits.cokernel.π α),
          CategoryTheory.Limits.zero_comp] at hd
        exact sub_eq_zero.mp hd⟩
    exact CategoryTheory.isIso_of_mono_of_epi α

  
  have hSiteExact : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂),
      let pb_h := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology
      let pf_h := (weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology
      pb_h.Additive ∧
      pf_h.Additive ∧
      CategoryTheory.Limits.PreservesFiniteLimits pb_h ∧
      CategoryTheory.Limits.PreservesFiniteColimits pb_h := by
    intro S₁ S₂ h
    let B_h := weilEtaleSitePullback h
    let pb_h := B_h.sheafPullback AddCommGrpCat.{u}
      S₂.smallEtaleTopology S₁.smallEtaleTopology
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      S₂.smallEtaleTopology S₁.smallEtaleTopology
    let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
      S₂.smallEtaleTopology S₁.smallEtaleTopology
    have hAdd_pf : pf_h.Additive :=
      { map_add := fun {_ _ _ _} => CategoryTheory.Sheaf.hom_ext
          (CategoryTheory.NatTrans.ext (funext fun _ => rfl)) }
    letI : pf_h.Additive := hAdd_pf
    have hAdd_pb : pb_h.Additive := adj_h.left_adjoint_additive
    letI : pb_h.Additive := hAdd_pb
    haveI := adj_h.leftAdjoint_preservesColimits
    have hColim_pb : CategoryTheory.Limits.PreservesFiniteColimits pb_h := inferInstance
    haveI : ∀ {F G : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u}} (α : F ⟶ G),
        CategoryTheory.Limits.PreservesLimit (CategoryTheory.Limits.parallelPair α 0) pb_h := by
      intro F G α
      haveI : CategoryTheory.IsIso (CategoryTheory.Limits.kernelComparison α pb_h) := by
        apply hIsoStalk S₁ (CategoryTheory.Limits.kernelComparison α pb_h)
        intro y
