      fun G Y => AddCommGrpCat.ofHom
        { toFun := fun x₁ => Classical.choose ((hSheafCD G Y).2 x₁)
          map_zero' := by
            have hspec := Classical.choose_spec ((hSheafCD G Y).2 0)
            exact (hSheafCD G Y).1 _ 0
              (hspec.1.trans (map_zero _).symm)
              (hspec.2.trans (map_zero _).symm)
          map_add' := fun a b => by
            have ha := Classical.choose_spec ((hSheafCD G Y).2 a)
            have hb := Classical.choose_spec ((hSheafCD G Y).2 b)
            have hab := Classical.choose_spec ((hSheafCD G Y).2 (a + b))
            refine (hSheafCD G Y).1 _ _ ?_ ?_
            · rw [hab.1, map_add, ha.1, hb.1]
            · rw [hab.2, map_add, ha.2, hb.2, add_zero] }
    have hglue0_c : ∀ (G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
        (Y : X₀.Etale) (x₁ : ↥(G.obj.obj (Opposite.op (j_s.obj (B_s.obj Y))))),
        (G.obj.map (Opposite.op (c_site Y))).hom ((glue0_hom G Y).hom x₁) = x₁ :=
      fun G Y x₁ => (Classical.choose_spec ((hSheafCD G Y).2 x₁)).1
    have hglue0_d : ∀ (G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
        (Y : X₀.Etale) (x₁ : ↥(G.obj.obj (Opposite.op (j_s.obj (B_s.obj Y))))),
        (G.obj.map (Opposite.op (d_site Y))).hom ((glue0_hom G Y).hom x₁) = 0 :=
      fun G Y x₁ => (Classical.choose_spec ((hSheafCD G Y).2 x₁)).2
    refine ⟨CategoryTheory.Adjunction.mkOfUnitCounit {
      unit := {
        app := fun H => {
          hom := {
            app := fun opW => H.obj.map (Opposite.op (δ_inv (Opposite.unop opW)))
            naturality := fun {W₁ W₂} f => by
              change H.obj.map f ≫ H.obj.map (Opposite.op (δ_inv (Opposite.unop W₂))) =
                H.obj.map (Opposite.op (δ_inv (Opposite.unop W₁))) ≫
                  H.obj.map (Opposite.op (B_s.map (j_s.map f.unop)))
              rw [← H.obj.map_comp, ← H.obj.map_comp]
              exact congrArg (fun k => H.obj.map (Opposite.op k)) (hδ_inv_nat f.unop).symm } }
        naturality := fun {H₁ H₂} ψ => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext opW
          exact (ψ.hom.naturality (Opposite.op (δ_inv (Opposite.unop opW)))).symm }
      counit := {
        app := fun G => {
          hom := {
            app := fun opY => glue0_hom G (Opposite.unop opY)
            naturality := fun {Y₁ Y₂} g => by
              rcases Y₁ with ⟨Y⟩
              rcases Y₂ with ⟨Y'⟩
              ext x₁
              change (glue0_hom G Y').hom
                  ((G.obj.map (Opposite.op (j_s.map (B_s.map g.unop)))).hom x₁) =
                (G.obj.map g).hom ((glue0_hom G Y).hom x₁)
              refine (hSheafCD G Y').1 _ _ ?_ ?_
              · rw [hglue0_c G Y']
                symm
                have hmap_c : G.obj.map g ≫ G.obj.map (Opposite.op (c_site Y')) =
                    G.obj.map (Opposite.op (c_site Y)) ≫
                      G.obj.map (Opposite.op (j_s.map (B_s.map g.unop))) :=
                  (G.obj.map_comp _ _).symm.trans
                    ((congrArg (fun k => G.obj.map (Opposite.op k))
                      (@hc_site_nat Y' Y g.unop).symm).trans (G.obj.map_comp _ _))
                let x₁' : ↥(G.obj.obj (Opposite.op (j_s.obj (B_s.obj Y)))) := x₁
                exact (congrArg (fun m => m.hom ((glue0_hom G Y).hom x₁')) hmap_c).trans
                  (congrArg ((G.obj.map (Opposite.op (j_s.map (B_s.map g.unop)))).hom)
                    (hglue0_c G Y x₁'))
              · rw [hglue0_d G Y']
                symm
                have hRange_d : Set.range (((U₂_of Y').ι ≫ (FgtX.map g.unop).left)).base ⊆
                    Set.range (U₂_of Y).ι.base := by
                  rintro _ ⟨q, rfl⟩
                  have hq_not : ((FgtX.obj Y).hom).base (((FgtX.map g.unop).left).base
                      ((U₂_of Y').ι.base q)) ∉ Set.range s.base := by
                    have hw : (((FgtX.map g.unop).left) ≫ (FgtX.obj Y).hom).base
                        ((U₂_of Y').ι.base q) = ((FgtX.obj Y').hom).base ((U₂_of Y').ι.base q) :=
                      congrArg (fun k : (FgtX.obj Y').left ⟶ X₀ => k.base ((U₂_of Y').ι.base q))
                        (CategoryTheory.MorphismProperty.Over.w g.unop)
                    change (((FgtX.map g.unop).left) ≫ (FgtX.obj Y).hom).base
                      ((U₂_of Y').ι.base q) ∉ Set.range s.base
                    rw [hw]
                    exact q.2
                  exact ⟨⟨_, hq_not⟩, rfl⟩
                let lift_d := AlgebraicGeometry.IsOpenImmersion.lift (U₂_of Y).ι
                  ((U₂_of Y').ι ≫ (FgtX.map g.unop).left) hRange_d
                have hfac_d : lift_d ≫ (U₂_of Y).ι = (U₂_of Y').ι ≫ (FgtX.map g.unop).left :=
                  AlgebraicGeometry.IsOpenImmersion.lift_fac (U₂_of Y).ι _ hRange_d
                let g₂ : Y₂_of Y' ⟶ Y₂_of Y :=
                  CategoryTheory.MorphismProperty.Over.homMk lift_d
                    ((CategoryTheory.Category.assoc lift_d (U₂_of Y).ι _).symm.trans
                      ((congrArg (· ≫ (FgtX.obj Y).hom) hfac_d).trans
                        ((CategoryTheory.Category.assoc (U₂_of Y').ι _ _).trans
                          (congrArg ((U₂_of Y').ι ≫ ·)
                            (CategoryTheory.MorphismProperty.Over.w g.unop)))))
                    trivial
                have hd_eq : d_site Y' ≫ g.unop = g₂ ≫ d_site Y :=
                  CategoryTheory.MorphismProperty.Comma.Hom.ext hfac_d.symm (Subsingleton.elim _ _)
                have hmap_d : G.obj.map g ≫ G.obj.map (Opposite.op (d_site Y')) =
                    G.obj.map (Opposite.op (d_site Y)) ≫ G.obj.map (Opposite.op g₂) :=
                  (G.obj.map_comp _ _).symm.trans
                    ((congrArg (fun k => G.obj.map (Opposite.op k)) hd_eq).trans
