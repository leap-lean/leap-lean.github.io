        exact α_uniq.hom_inv_id_app A

  
  have hExtComp : ∀ {C D E : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C] [CategoryTheory.Abelian C]
      [CategoryTheory.HasExt.{u} C] [CategoryTheory.EnoughInjectives C]
      [CategoryTheory.Category.{u + 1, u + 1} D] [CategoryTheory.Abelian D]
      [CategoryTheory.HasExt.{u} D]
      [CategoryTheory.Category.{u + 1, u + 1} E] [CategoryTheory.Abelian E]
      [CategoryTheory.HasExt.{u} E]
      (F : CategoryTheory.Functor C D) [F.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      (G : CategoryTheory.Functor D E) [G.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      (X Y : C) (r : ℕ) (x : CategoryTheory.Abelian.Ext.{u} X Y r),
      letI : CategoryTheory.Limits.PreservesFiniteLimits (F.comp G) :=
        CategoryTheory.Limits.comp_preservesFiniteLimits F G
      letI : CategoryTheory.Limits.PreservesFiniteColimits (F.comp G) :=
        CategoryTheory.Limits.comp_preservesFiniteColimits F G
      ((F.comp G).mapExtAddHom X Y r) x =
        (G.mapExtAddHom (F.obj X) (F.obj Y) r) ((F.mapExtAddHom X Y r) x) := by
    intro C D E _ _ _ _ _ _ _ _ _ _ F _ _ _ G _ _ _ X Y r x
    have : CategoryTheory.Limits.PreservesFiniteLimits (F.comp G) :=
      CategoryTheory.Limits.comp_preservesFiniteLimits F G
    have : CategoryTheory.Limits.PreservesFiniteColimits (F.comp G) :=
      CategoryTheory.Limits.comp_preservesFiniteColimits F G
    induction r generalizing Y with
    | zero =>
      let f : X ⟶ Y := CategoryTheory.Abelian.Ext.addEquiv₀ x
      have hx : CategoryTheory.Abelian.Ext.mk₀ f = x :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x
      rw [← hx]
      simp only [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ k ih =>
      let I := CategoryTheory.Injective.under Y
      let ι : Y ⟶ I := CategoryTheory.Injective.ι Y
      let π := CategoryTheory.Limits.cokernel.π ι
      let S := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hzero : x.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, hz⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS x hzero rfl
      rw [← hz, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        CategoryTheory.Functor.mapExtAddHom_apply F,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        CategoryTheory.Functor.mapExtAddHom_apply G,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
      have ihz := ih S.X₃ z
      simp only [CategoryTheory.Functor.mapExtAddHom_apply] at ihz
      rw [ihz]

  have hExtNatIso : ∀ {C D : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C] [CategoryTheory.Abelian C]
      [CategoryTheory.HasExt.{u} C] [CategoryTheory.EnoughInjectives C]
      [CategoryTheory.Category.{u + 1, u + 1} D] [CategoryTheory.Abelian D]
      [CategoryTheory.HasExt.{u} D]
      (F G : CategoryTheory.Functor C D)
      [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      (η : F ≅ G) (X Y : C) (r : ℕ) (x : CategoryTheory.Abelian.Ext.{u} X Y r),
      (G.mapExtAddHom X Y r) x =
        (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app X)).comp
          (((F.mapExtAddHom X Y r) x).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y)) (Nat.add_zero r))
          (Nat.zero_add r) := by
    intro C D _ _ _ _ _ _ _ F G _ _ _ _ _ _ η X Y r x
    induction r generalizing Y with
    | zero =>
      let f : X ⟶ Y := CategoryTheory.Abelian.Ext.addEquiv₀ x
      have hx : CategoryTheory.Abelian.Ext.mk₀ f = x :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x
      rw [← hx, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        η.hom.naturality f, ← CategoryTheory.Category.assoc,
        η.inv_hom_id_app X, CategoryTheory.Category.id_comp]
    | succ k ih =>
      let I := CategoryTheory.Injective.under Y
      let ι : Y ⟶ I := CategoryTheory.Injective.ι Y
      let π := CategoryTheory.Limits.cokernel.π ι
      let S := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hzero : x.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, hz⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS x hzero rfl
      rw [← hz, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
      have ihz := ih S.X₃ z
      simp only [CategoryTheory.Functor.mapExtAddHom_apply] at ihz
      rw [ihz]
      let mor_sc : S.map F ⟶ S.map G :=
        CategoryTheory.ShortComplex.homMk
          (η.hom.app Y) (η.hom.app I) (η.hom.app S.X₃)
          (η.hom.naturality S.f).symm (η.hom.naturality S.g).symm
      have hExtNat :
          (hS.map_of_exact F).extClass.comp
            (CategoryTheory.Abelian.Ext.mk₀ mor_sc.τ₁) (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ mor_sc.τ₃).comp
            (hS.map_of_exact G).extClass (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality
          (hS.map_of_exact F) (hS.map_of_exact G) mor_sc
      change ((CategoryTheory.Abelian.Ext.mk₀ (η.inv.app X)).comp
          (((CategoryTheory.Abelian.Ext.mapExactFunctor F z).comp
            (CategoryTheory.Abelian.Ext.mk₀ mor_sc.τ₃) (Nat.add_zero k)))
          (Nat.zero_add k)).comp (hS.map_of_exact G).extClass rfl =
        (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app X)).comp
          (((CategoryTheory.Abelian.Ext.mapExactFunctor F z).comp
            (hS.map_of_exact F).extClass rfl).comp
            (CategoryTheory.Abelian.Ext.mk₀ mor_sc.τ₁) (Nat.add_zero (k + 1)))
          (Nat.zero_add (k + 1))
      rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add k) rfl (Nat.zero_add (k + 1)),
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero k) (Nat.zero_add 1) rfl,
        ← hExtNat,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ rfl (Nat.add_zero 1) (Nat.add_zero (k + 1))]

  
