  have hIso0 : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      Nonempty (CategoryTheory.Iso
        (CategoryTheory.sheafToPresheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Sheaf.cohomologyPresheafFunctor Y.smallEtaleTopology 0)) := by
    intro Y
    let J := Y.smallEtaleTopology
    let S_pre := CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}
    let L_sh := CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}
    let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let adj_ab := AddCommGrpCat.adj
    let adj_w := adj_ab.whiskerRight (Opposite Y.Etale)
    let F_E : Y.Etale → CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
      fun E => L_sh.obj ((CategoryTheory.yoneda.obj E).comp AddCommGrpCat.free)
    let evHom : ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (E : Y.Etale),
        (F_E E ⟶ G) ≃ ↥((S_pre.obj G).obj (Opposite.op E)) :=
      fun G E =>
        ((adj_sh.homEquiv ((CategoryTheory.yoneda.obj E).comp AddCommGrpCat.free) G).trans
          (adj_w.homEquiv (CategoryTheory.yoneda.obj E) (S_pre.obj G))).trans
          CategoryTheory.yonedaEquiv
    have hevHom : ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (E : Y.Etale)
        (f : F_E E ⟶ G),
        evHom G E f =
          ((S_pre.map f).app (Opposite.op E))
            (((adj_sh.unit.app ((CategoryTheory.yoneda.obj E).comp AddCommGrpCat.free)).app
              (Opposite.op E)) (adj_ab.unit.app (E ⟶ E) (𝟙 E))) := by
      intro G E f
      dsimp [evHom]
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
        CategoryTheory.yonedaEquiv_comp]
      rfl
    let addEquivObj : ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (E : Y.Etale),
        CategoryTheory.Abelian.Ext (F_E E) G 0 ≃+
          ↥((S_pre.obj G).obj (Opposite.op E)) :=
      fun G E =>
        AddEquiv.mk'
          (CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans (evHom G E))
          (fun α β => by
            change evHom G E (CategoryTheory.Abelian.Ext.addEquiv₀ (α + β)) =
              evHom G E (CategoryTheory.Abelian.Ext.addEquiv₀ α) +
                evHom G E (CategoryTheory.Abelian.Ext.addEquiv₀ β)
            rw [map_add, hevHom, hevHom, hevHom, S_pre.map_add]
            rfl)
    let addEquivAt : ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (W : Opposite Y.Etale),
        ↥(((CategoryTheory.Sheaf.cohomologyPresheafFunctor J 0).obj G).obj W) ≃+
          ↥((S_pre.obj G).obj W) :=
      fun G W => addEquivObj G W.unop
    let isoShRev : ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        (CategoryTheory.Sheaf.cohomologyPresheafFunctor J 0).obj G ≅ S_pre.obj G :=
      fun G => CategoryTheory.NatIso.ofComponents
        (fun W => (addEquivAt G W).toAddCommGrpIso)
        (fun {W₁ W₂} v => by
          apply AddCommGrpCat.ext
          intro α
          rw [AddCommGrpCat.comp_apply, AddCommGrpCat.comp_apply,
            AddEquiv.toAddCommGrpIso_hom, AddEquiv.toAddCommGrpIso_hom]
          let E₁ : Y.Etale := W₁.unop
          let E₂ : Y.Etale := W₂.unop
          let u : E₂ ⟶ E₁ := v.unop
          let f : F_E E₁ ⟶ G := CategoryTheory.Abelian.Ext.addEquiv₀ α
          let φ_u : F_E E₂ ⟶ F_E E₁ :=
            L_sh.map (CategoryTheory.Functor.whiskerRight
              (CategoryTheory.yoneda.map u) AddCommGrpCat.free)
          have hmap_v : (CategoryTheory.ConcreteCategory.hom
              (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J 0).obj G).map v)) α =
              CategoryTheory.Abelian.Ext.mk₀ (φ_u ≫ f) := by
            change (CategoryTheory.Abelian.Ext.mk₀ φ_u).comp α (Nat.zero_add 0) = _
            rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α]
            exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ φ_u f
          rw [hmap_v]
          change evHom G E₂ (CategoryTheory.Abelian.Ext.addEquiv₀
              (CategoryTheory.Abelian.Ext.mk₀ (φ_u ≫ f))) =
            (CategoryTheory.ConcreteCategory.hom ((S_pre.obj G).map v)) (evHom G E₁ f)
          rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply (φ_u ≫ f),
            AddEquiv.apply_symm_apply]
          dsimp only [evHom, Equiv.trans_apply, φ_u]
          rw [adj_sh.homEquiv_naturality_left,
            ← CategoryTheory.Functor.whiskeringRight_obj_map,
            adj_w.homEquiv_naturality_left,
            ← CategoryTheory.yonedaEquiv_naturality]
          simp [u])
    let isoRev : CategoryTheory.Sheaf.cohomologyPresheafFunctor J 0 ≅ S_pre :=
      CategoryTheory.NatIso.ofComponents isoShRev
        (fun {G₁ G₂} g => by
          ext W α
          let E : Y.Etale := W.unop
          let α' : CategoryTheory.Abelian.Ext (F_E E) G₁ 0 := α
          let f : F_E E ⟶ G₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α'
          change evHom G₂ E (CategoryTheory.Abelian.Ext.addEquiv₀
              (α'.comp (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.add_zero 0))) =
            (CategoryTheory.ConcreteCategory.hom ((S_pre.map g).app (Opposite.op E)))
              (evHom G₁ E f)
          have hmap_g : α'.comp (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.add_zero 0) =
              CategoryTheory.Abelian.Ext.mk₀ (f ≫ g) := by
            rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α']
            exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ f g
          rw [hmap_g, ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply (f ≫ g),
            AddEquiv.apply_symm_apply, hevHom G₂ E (f ≫ g), hevHom G₁ E f,
            S_pre.map_comp]
          rfl)
    exact ⟨isoRev.symm⟩

