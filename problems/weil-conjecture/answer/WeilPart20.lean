            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ U₀ hS_inf z hz_f (Nat.zero_add 1)
          obtain ⟨j, w_j, hw_j⟩ := hExt0Surj Λ (CategoryTheory.Functor.comp D K_coker) w
          have hw_j_ext : w_j.comp (hS_obj (D.obj j)).extClass (Nat.zero_add 1) = 0 :=
            @Subsingleton.elim _ (hSub j) _ 0
          obtain ⟨v_j, hv_j⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ U₀ (hS_obj (D.obj j)) w_j
              (Nat.zero_add 1) hw_j_ext
          have hcomm : CategoryTheory.CategoryStruct.comp
              (p_coker.app (D.obj j))
              (CategoryTheory.Limits.colimit.ι (CategoryTheory.Functor.comp D K_coker) j) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.colimit.ι (CategoryTheory.Functor.comp D J_inj) j)
                ((S_diag D).map CategoryTheory.Limits.colim).g :=
            (CategoryTheory.Limits.ι_colimMap (p_diag D) j).symm
          have hw_fac : w =
              (v_j.comp (CategoryTheory.Abelian.Ext.mk₀
                (CategoryTheory.Limits.colimit.ι (CategoryTheory.Functor.comp D J_inj) j))
                (Nat.add_zero 0)).comp
                (CategoryTheory.Abelian.Ext.mk₀ ((S_diag D).map CategoryTheory.Limits.colim).g)
                (Nat.add_zero 0) := by
            rw [← hw_j, ← hv_j,
              CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 0) (Nat.add_zero 0) (Nat.add_zero 0),
              CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hcomm,
              ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
              ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 0) (Nat.add_zero 0) (Nat.add_zero 0)]
          rw [← hw, hw_fac,
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
