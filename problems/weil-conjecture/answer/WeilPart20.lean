        | mk x₂ =>
          rw [hFamVal x₁, hFamVal x₂]
          by_cases hx12 : x₁ = x₂
          · subst hx12
            have hnat₁ := congrArg (fun τ => τ.hom (ULift.up (f x₁ 0))) (η_shf₁.naturality h₁.op)
            have hnat₂ := congrArg (fun τ => τ.hom (ULift.up (f x₁ 0))) (η_shf₁.naturality h₂.op)
            dsimp [P_const₁] at hnat₁ hnat₂
            exact hnat₁.symm.trans hnat₂
