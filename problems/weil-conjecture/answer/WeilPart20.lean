              (Fgt_X.obj U'_X).hom := (Fgt_X.map v_X).w
          have hBvY_w : f_BvY ≫ (Fgt_X.obj (B_π.obj U_Y)).hom =
              (Fgt_X.obj (B_π.obj U'_Y)).hom := (Fgt_X.map (B_π.map v_Y)).w
          rw [CategoryTheory.Category.assoc, hf'_snd, ← hvX_w,
            ← CategoryTheory.Category.assoc, hc_vX, ← hf_snd,
            ← CategoryTheory.Category.assoc, hb_fac,
            CategoryTheory.Category.assoc, hBvY_w]
      intro p' hp'
