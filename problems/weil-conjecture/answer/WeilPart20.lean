theorem weil_etale_proper_constructible_cohomological_dim_le_two_mul (hPBC : ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀] (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
