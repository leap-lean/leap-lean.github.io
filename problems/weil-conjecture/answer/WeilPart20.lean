        rw [hcomp, (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).apply_symm_apply,
          (adj₂.homEquiv A (P_push.obj (C₁.obj A))).apply_symm_apply]
        rfl
      refine ⟨α_uniq.inv.app A, ?_, ?_⟩
      · change α_uniq.inv.app A ≫ πA = CategoryTheory.CategoryStruct.id (C₁.obj A)
        rw [← hα_eq]
        exact α_uniq.inv_hom_id_app A
      · change πA ≫ α_uniq.inv.app A = CategoryTheory.CategoryStruct.id (P_pull.obj (C₂.obj A))
