          change ((C_fun q).obj SC.X₃).map ω ≫
              AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_fun.obj V₂) rfl) =
            AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_fun.obj V₁) rfl) ≫
              ((C_fun (q + 1)).obj SC.X₁).map ω
          rw [show ((C_fun q).obj SC.X₃).map ω =
              ((CategoryTheory.Abelian.extFunctor q).map (Z_fun.op.map ω)).app SC.X₃ from rfl,
            show ((C_fun (q + 1)).obj SC.X₁).map ω =
              ((CategoryTheory.Abelian.extFunctor (q + 1)).map (Z_fun.op.map ω)).app SC.X₁ from rfl,
            CategoryTheory.Abelian.extFunctor_map_app q (Z_fun.op.map ω) SC.X₃,
            CategoryTheory.Abelian.extFunctor_map_app (q + 1) (Z_fun.op.map ω) SC.X₁]
          ext x
          change ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map ω.unop)).comp x
              (Nat.zero_add q)).comp hSE.extClass rfl =
            (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map ω.unop)).comp
              (x.comp hSE.extClass rfl) (Nat.zero_add (q + 1))
          exact CategoryTheory.Abelian.Ext.comp_assoc
            (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map ω.unop)) x hSE.extClass
            (Nat.zero_add q) rfl (Nat.zero_add (q + 1)) }
    have hSurj_app : ∀ (q : ℕ) (opW : (X₀.Etale)ᵒᵖ),
        Function.Surjective ((δ_pre q).app opW).hom := by
      intro q opW y
      have hy0 : y.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero (q + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
        (Z_fun.obj (Opposite.unop opW)) hSE y hy0 rfl
    refine ⟨?_, ?_⟩
    · have hZero_pre : (C_fun 0).map SC.g ≫ δ_pre 0 = 0 := by
        apply CategoryTheory.NatTrans.ext
        funext opW
        rcases opW with ⟨V⟩
        change ((C_fun 0).map SC.g).app (Opposite.op V) ≫ (δ_pre 0).app (Opposite.op V) = 0
        rw [show ((C_fun 0).map SC.g).app (Opposite.op V) =
            (CategoryTheory.Abelian.extFunctorObj (Z_fun.obj V) 0).map SC.g from rfl,
          CategoryTheory.Abelian.extFunctorObj_map]
        exact (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero)
          (CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_fun.obj V) hSE 0 1 rfl)
      have hEpi_app : ∀ opV : (S.Etale)ᵒᵖ,
          CategoryTheory.Epi ((W_Bp.map (δ_pre 0)).app opV) := fun opV =>
        (AddCommGrpCat.epi_iff_surjective _).mpr
          (hSurj_app 0 (Opposite.op (B_p.obj (Opposite.unop opV))))
      have : CategoryTheory.Epi (W_Bp.map (δ_pre 0)) :=
        CategoryTheory.NatTrans.epi_of_epi_app (W_Bp.map (δ_pre 0))
      have : Sh_S.PreservesEpimorphisms :=
        CategoryTheory.Functor.preservesEpimorphisms_of_adjunction
          (CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u})
      let δ₀ : (R_fun 0).obj SC.X₃ ⟶ (R_fun 1).obj SC.X₁ :=
        Sh_S.map (W_Bp.map (δ_pre 0))
      have hEpi_δ₀ : CategoryTheory.Epi δ₀ := inferInstance
      have hW_add : W_Bp.Additive := ⟨fun {_ _} _ _ => rfl⟩
      have hSh_add : Sh_S.Additive := inferInstance
      have hComp0 : (R_fun 0).map SC.g ≫ δ₀ = 0 := by
        change Sh_S.map (W_Bp.map ((C_fun 0).map SC.g)) ≫ Sh_S.map (W_Bp.map (δ_pre 0)) = 0
        rw [← Sh_S.map_comp, ← W_Bp.map_comp, hZero_pre, W_Bp.map_zero, Sh_S.map_zero]
      exact ⟨δ₀, hEpi_δ₀, hComp0⟩
    · intro k₀
      have hIso_app : ∀ opW : (X₀.Etale)ᵒᵖ,
          CategoryTheory.IsIso ((δ_pre (k₀ + 1)).app opW) := by
        intro opW
        have hInj_w : Function.Injective ((δ_pre (k₀ + 1)).app opW).hom := by
          rw [injective_iff_map_eq_zero]
          intro x₃ hx₃
          obtain ⟨x₂, hx₂⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
              (Z_fun.obj (Opposite.unop opW)) hSE x₃ rfl hx₃
          have hx₂_zero : x₂ = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective x₂
          rw [← hx₂, hx₂_zero, CategoryTheory.Abelian.Ext.zero_comp]
          rfl
        let ae := AddEquiv.ofBijective ((δ_pre (k₀ + 1)).app opW).hom
          ⟨hInj_w, hSurj_app (k₀ + 1) opW⟩
        exact ⟨⟨AddCommGrpCat.ofHom ae.symm.toAddMonoidHom,
          AddCommGrpCat.ext fun x => ae.symm_apply_apply x,
          AddCommGrpCat.ext fun y => ae.apply_symm_apply y⟩⟩
      have : CategoryTheory.IsIso (δ_pre (k₀ + 1)) :=
        CategoryTheory.NatIso.isIso_of_isIso_app (δ_pre (k₀ + 1))
      exact ⟨(W_Bp ⋙ Sh_S).mapIso (CategoryTheory.asIso (δ_pre (k₀ + 1)))⟩

  
  obtain ⟨iso_rep⟩ := hIsoRep
  obtain ⟨e_comp⟩ := hIsoComp
  obtain ⟨e_R0⟩ := hIsoR0

  have hAllVanish : ∀ (k : ℕ) (H : CategoryTheory.Sheaf J_S AddCommGrpCat.{u}),
      CategoryTheory.Limits.IsZero ((R_fun (k + 1)).obj (pf_s.obj H)) := by
    intro k
    induction k with
    | zero =>
      intro H
      let I_sh : CategoryTheory.Sheaf J_S AddCommGrpCat.{u} :=
        CategoryTheory.Injective.under H
      let ι_I : H ⟶ I_sh := CategoryTheory.Injective.ι H
      let Q_sh : CategoryTheory.Sheaf J_S AddCommGrpCat.{u} :=
        CategoryTheory.Limits.cokernel ι_I
      let π_Q : I_sh ⟶ Q_sh := CategoryTheory.Limits.cokernel.π ι_I
      let SC_S : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_S AddCommGrpCat.{u}) :=
        CategoryTheory.ShortComplex.mk ι_I π_Q (CategoryTheory.Limits.cokernel.condition ι_I)
      have hSE_S : SC_S.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel ι_I) inferInstance inferInstance
      have hSE_X : (SC_S.map pf_s).ShortExact := hSE_S.map_of_exact pf_s
      obtain ⟨δ₀, hEpi_δ₀, hComp0⟩ := (@hInjConn (SC_S.map pf_s) hSE_X (hInj_pfs I_sh)).1
      have hR0_map_eq : (R_fun 0).map (pf_s.map π_Q) =
          e_R0.hom.app (pf_s.obj I_sh) ≫ e_comp.hom.app I_sh ≫ π_Q ≫
            e_comp.inv.app Q_sh ≫ e_R0.inv.app (pf_s.obj Q_sh) := by
        calc
          (R_fun 0).map (pf_s.map π_Q)
            = ((R_fun 0).map (pf_s.map π_Q) ≫ e_R0.hom.app (pf_s.obj Q_sh)) ≫
                e_R0.inv.app (pf_s.obj Q_sh) := by
              rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_app,
                CategoryTheory.Category.comp_id]
          _ = (e_R0.hom.app (pf_s.obj I_sh) ≫ pf_p.map (pf_s.map π_Q)) ≫
                e_R0.inv.app (pf_s.obj Q_sh) := by
              rw [e_R0.hom.naturality (pf_s.map π_Q)]
          _ = e_R0.hom.app (pf_s.obj I_sh) ≫
                (((pf_s ⋙ pf_p).map π_Q ≫ e_comp.hom.app Q_sh) ≫ e_comp.inv.app Q_sh) ≫
                e_R0.inv.app (pf_s.obj Q_sh) := by
              change (e_R0.hom.app (pf_s.obj I_sh) ≫ (pf_s ⋙ pf_p).map π_Q) ≫
                  e_R0.inv.app (pf_s.obj Q_sh) =
                e_R0.hom.app (pf_s.obj I_sh) ≫
                  (((pf_s ⋙ pf_p).map π_Q ≫ e_comp.hom.app Q_sh) ≫ e_comp.inv.app Q_sh) ≫
                  e_R0.inv.app (pf_s.obj Q_sh)
              rw [CategoryTheory.Category.assoc ((pf_s ⋙ pf_p).map π_Q),
                CategoryTheory.Iso.hom_inv_id_app, CategoryTheory.Category.comp_id,
                CategoryTheory.Category.assoc]
          _ = e_R0.hom.app (pf_s.obj I_sh) ≫ e_comp.hom.app I_sh ≫ π_Q ≫
                e_comp.inv.app Q_sh ≫ e_R0.inv.app (pf_s.obj Q_sh) := by
              rw [e_comp.hom.naturality π_Q]
              simp only [CategoryTheory.Functor.id_map, CategoryTheory.Category.assoc]
      have hEpi1 : CategoryTheory.Epi (e_comp.inv.app Q_sh ≫ e_R0.inv.app (pf_s.obj Q_sh)) :=
        CategoryTheory.epi_comp _ _
      have hEpi2 : CategoryTheory.Epi
          (π_Q ≫ e_comp.inv.app Q_sh ≫ e_R0.inv.app (pf_s.obj Q_sh)) :=
        CategoryTheory.epi_comp _ _
      have hEpi3 : CategoryTheory.Epi
          (e_comp.hom.app I_sh ≫ π_Q ≫ e_comp.inv.app Q_sh ≫ e_R0.inv.app (pf_s.obj Q_sh)) :=
        CategoryTheory.epi_comp _ _
      have hEpi_R0g : CategoryTheory.Epi ((R_fun 0).map (pf_s.map π_Q)) := by
        rw [hR0_map_eq]
        exact CategoryTheory.epi_comp _ _
      have hδ₀_zero : δ₀ = 0 :=
        (cancel_epi ((R_fun 0).map (pf_s.map π_Q))).mp
          (hComp0.trans (CategoryTheory.Limits.comp_zero).symm)
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply (cancel_epi δ₀).mp
      rw [hδ₀_zero, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.zero_comp]
    | succ k₀ ih =>
      intro H
      let I_sh : CategoryTheory.Sheaf J_S AddCommGrpCat.{u} :=
        CategoryTheory.Injective.under H
      let ι_I : H ⟶ I_sh := CategoryTheory.Injective.ι H
      let Q_sh : CategoryTheory.Sheaf J_S AddCommGrpCat.{u} :=
        CategoryTheory.Limits.cokernel ι_I
      let π_Q : I_sh ⟶ Q_sh := CategoryTheory.Limits.cokernel.π ι_I
      let SC_S : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_S AddCommGrpCat.{u}) :=
        CategoryTheory.ShortComplex.mk ι_I π_Q (CategoryTheory.Limits.cokernel.condition ι_I)
      have hSE_S : SC_S.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel ι_I) inferInstance inferInstance
      have hSE_X : (SC_S.map pf_s).ShortExact := hSE_S.map_of_exact pf_s
      obtain ⟨iso_shift⟩ := (@hInjConn (SC_S.map pf_s) hSE_X (hInj_pfs I_sh)).2 k₀
      exact (ih Q_sh).of_iso iso_shift.symm

  refine ⟨?_, ?_⟩
  · intro q hq
    cases q with
    | zero => omega
    | succ k =>
      change CategoryTheory.Limits.IsZero ((R_fun (k + 1)).obj L_Ss)
      exact (hAllVanish k L_TS).of_iso ((R_fun (k + 1)).mapIso iso_rep)
  · exact ⟨(e_comp.app L_TS).symm ≪≫
      (e_R0.app (pf_s.obj L_TS)).symm ≪≫
      ((R_fun 0).mapIso iso_rep).symm⟩

theorem weil_etale_algClosed_clopen_fiber_local_cohomology (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X₀ : AlgebraicGeometry.Scheme.{u})
    (π₀ : Quiver.Hom X₀ (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    [AlgebraicGeometry.IsSeparated π₀]
    (U₀ : X₀.Etale)
    (V₀ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Etale)
    [AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget (AlgebraicGeometry.Spec (CommRingCat.of Ω))).obj V₀).left]
    (e₀ : CategoryTheory.Iso
      ((AlgebraicGeometry.Scheme.Etale.forget X₀).obj U₀).left
      ((AlgebraicGeometry.Scheme.Etale.forget (AlgebraicGeometry.Spec (CommRingCat.of Ω))).obj V₀).left)
    (hcomm : CategoryTheory.CategoryStruct.comp ((AlgebraicGeometry.Scheme.Etale.forget X₀).obj U₀).hom π₀ =
      CategoryTheory.CategoryStruct.comp e₀.hom
        ((AlgebraicGeometry.Scheme.Etale.forget (AlgebraicGeometry.Spec (CommRingCat.of Ω))).obj V₀).hom)
    (m : ℕ) :
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let T_Ω : S_Ω.Etale := weilEtaleIdTerminal S_Ω
    (∀ (q : ℕ), 1 ≤ q →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage π₀ q (weilEtaleLocalTorsionSheaf X₀ m U₀))) ∧
    (1 ≤ m →
      Finite ↥(((weilEtaleLocalTorsionSheaf S_Ω m V₀).obj.obj (Opposite.op T_Ω)))) ∧
    Nonempty (↥(((weilEtaleLocalTorsionSheaf S_Ω m V₀).obj.obj (Opposite.op T_Ω))) ≃+
      ↥(((weilEtaleHigherDirectImage π₀ 0 (weilEtaleLocalTorsionSheaf X₀ m U₀)).obj.obj
        (Opposite.op T_Ω)))) :=
by
  classical
  let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  let T_Ω : S_Ω.Etale := weilEtaleIdTerminal S_Ω
  obtain ⟨n, β, s, hs, S_a, α, hSa_eq, hsec_X,
    hOpen_V, hDisj_V, hUniv_V, hOpen_U, hDisj_U, hUniv_U⟩ :=
    weil_algClosed_affine_etale_clopen_section_cover Ω X₀ π₀ U₀ V₀ e₀ hcomm
  obtain ⟨ι_V, π_V, hid_V, horth_V, hsum_V⟩ :=
    (weil_etale_localTorsion_disjoint_open_directSum_and_algClosed_point_finite.{u}).1
      S_Ω m n V₀ (fun _ => T_Ω) β hOpen_V hDisj_V hUniv_V
  obtain ⟨ι_U, π_U, hid_U, horth_U, hsum_U⟩ :=
    (weil_etale_localTorsion_disjoint_open_directSum_and_algClosed_point_finite.{u}).1
      X₀ m n U₀ S_a α hOpen_U hDisj_U hUniv_U

  
  have hAddEquivOfOrth : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Preadditive 𝒞]
      (F : CategoryTheory.Functor 𝒞 AddCommGrpCat.{u}) [F.Additive]
      {X : 𝒞} {X_part : Fin n → 𝒞}
      (ι : ∀ a : Fin n, X_part a ⟶ X) (π : ∀ a : Fin n, X ⟶ X_part a),
      (∀ a : Fin n, ι a ≫ π a = 𝟙 (X_part a)) →
      (∀ a b : Fin n, a ≠ b → ι a ≫ π b = 0) →
      (∑ a : Fin n, π a ≫ ι a) = 𝟙 X →
      Nonempty (↥(F.obj X) ≃+ (∀ a : Fin n, ↥(F.obj (X_part a)))) := by
    intro 𝒞 _ _ F _ X X_part ι π hid horth hsum
    let toPi : ↥(F.obj X) →+ (∀ a : Fin n, ↥(F.obj (X_part a))) :=
      { toFun := fun x a => (F.map (π a)).hom x
        map_zero' := by funext a; exact map_zero _
        map_add' := fun x y => by funext a; exact map_add _ x y }
    let fromPi : (∀ a : Fin n, ↥(F.obj (X_part a))) →+ ↥(F.obj X) :=
      { toFun := fun f => ∑ a : Fin n, (F.map (ι a)).hom (f a)
        map_zero' := by simp
        map_add' := fun f g => by
          simp only [Pi.add_apply, map_add, Finset.sum_add_distrib] }
    have hLeft : Function.LeftInverse fromPi toPi := by
      intro x
      change (∑ a : Fin n, (F.map (ι a)).hom ((F.map (π a)).hom x)) = x
      have hmap_sum : F.map (∑ a : Fin n, π a ≫ ι a) = ∑ a : Fin n, F.map (π a) ≫ F.map (ι a) := by
        rw [CategoryTheory.Functor.map_sum]
        exact Finset.sum_congr rfl (fun a _ => F.map_comp (π a) (ι a))
      have h_id_map : ((∑ a : Fin n, F.map (π a) ≫ F.map (ι a)).hom) x = x := by
        rw [← hmap_sum, hsum, F.map_id]
        rfl
      have hhom_sum : ∀ (S : Finset (Fin n)),
          ((∑ a ∈ S, F.map (π a) ≫ F.map (ι a)).hom) x =
            ∑ a ∈ S, (F.map (ι a)).hom ((F.map (π a)).hom x) := by
        intro S
        induction S using Finset.induction_on with
        | empty => rfl
        | @insert a S ha ih =>
          rw [Finset.sum_insert ha, Finset.sum_insert ha]
          change ((F.map (π a) ≫ F.map (ι a)).hom x) +
              ((∑ b ∈ S, F.map (π b) ≫ F.map (ι b)).hom x) = _
          rw [ih]
          rfl
      exact (hhom_sum Finset.univ).symm.trans h_id_map
    have hRight : Function.RightInverse fromPi toPi := by
      intro f
      funext b
      change (F.map (π b)).hom (∑ a : Fin n, (F.map (ι a)).hom (f a)) = f b
      rw [map_sum, Finset.sum_eq_single b]
      · change ((F.map (ι b) ≫ F.map (π b)).hom) (f b) = f b
        rw [← F.map_comp, hid b, F.map_id]
        rfl
      · intro a _ hab
        change ((F.map (ι a) ≫ F.map (π b)).hom) (f a) = 0
        rw [← F.map_comp, horth a b hab, F.map_zero]
        rfl
      · intro hb_not
        exact False.elim (hb_not (Finset.mem_univ b))
    exact ⟨{ toFun := toPi, invFun := fromPi, left_inv := hLeft, right_inv := hRight,
             map_add' := toPi.map_add }⟩

  
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) π₀ :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) π₀ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_π₀ : CategoryTheory.Functor S_Ω.Etale X₀.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ π₀
  let W_Bπ : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite X₀.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Functor (Opposite S_Ω.Etale) AddCommGrpCat.{u}) :=
    (CategoryTheory.Functor.whiskeringLeft (Opposite S_Ω.Etale) (Opposite X₀.Etale)
      AddCommGrpCat.{u}).obj B_π₀.op
  let Sh_SΩ := CategoryTheory.presheafToSheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}
  let R_fun : ∀ q : ℕ, CategoryTheory.Functor
      (CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u})
      (CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}) :=
    fun q => (CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology q).comp
      (W_Bπ.comp Sh_SΩ)
  have hCohomAdd : ∀ q : ℕ,
      (CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology q).Additive := by
    intro q
    refine ⟨fun {F₁ F₂} f g => ?_⟩
    ext W x
    let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X₀.Etale)
      (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
    let Sh_X := CategoryTheory.presheafToSheaf X₀.smallEtaleTopology AddCommGrpCat.{u}
    let Z_W : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u} :=
      Opposite.unop ((CategoryTheory.yoneda ⋙ (Free_PSh ⋙ Sh_X)).op.obj W)
    have hmap_eq : ∀ {G₁ G₂ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}}
        (u : G₁ ⟶ G₂),
        (((CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology q).map u).app W) =
          AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ u).postcomp Z_W (Nat.add_zero q)) :=
      fun u => CategoryTheory.Abelian.extFunctorObj_map Z_W q u
    rw [hmap_eq (f + g), CategoryTheory.NatTrans.app_add, hmap_eq f, hmap_eq g]
    let x_ext : CategoryTheory.Abelian.Ext Z_W F₁ q := x
    change x_ext.comp (CategoryTheory.Abelian.Ext.mk₀ (f + g)) (Nat.add_zero q) =
      x_ext.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero q) +
        x_ext.comp (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.add_zero q)
    have hmk0_add : CategoryTheory.Abelian.Ext.mk₀ (f + g) =
        CategoryTheory.Abelian.Ext.mk₀ f + CategoryTheory.Abelian.Ext.mk₀ g :=
      CategoryTheory.Abelian.Ext.addEquiv₀.symm.map_add f g
    rw [hmk0_add, CategoryTheory.Abelian.Ext.comp_add]
  let ev_TΩ : CategoryTheory.Functor
      (CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}) AddCommGrpCat.{u} :=
    CategoryTheory.sheafToPresheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u} ⋙
      (CategoryTheory.evaluation (Opposite S_Ω.Etale) AddCommGrpCat.{u}).obj (Opposite.op T_Ω)
  letI : (CategoryTheory.sheafToPresheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}).Additive :=
    CategoryTheory.Functor.additive_of_preserves_binary_products _
  letI : ev_TΩ.Additive := inferInstance

  refine ⟨?_, ?_, ?_⟩
  · 
    intro q hq
    letI : (CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology q).Additive :=
      hCohomAdd q
    letI : (R_fun q).Additive := inferInstance
    let L_U₀ := weilEtaleLocalTorsionSheaf X₀ m U₀
    change CategoryTheory.Limits.IsZero ((R_fun q).obj L_U₀)
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero, ← (R_fun q).map_id, ← hsum_U,
      CategoryTheory.Functor.map_sum]
    refine Finset.sum_eq_zero (fun a _ => ?_)
