      let ι₁₂_base : Z₁ ⟶ (P₂.comp P₁).obj Z₃ := ιℤ₁ ≫ P₁.map ιℤ₂
      let w₁₂' : CategoryTheory.Abelian.Ext ((P₂.comp P₁).obj Z₃) ((P₂.comp P₁).obj ℱ) r := w₁₂
      have hcancel : (ι₁₂_base ≫ η.hom.app Z₃) ≫ η.inv.app Z₃ = ι₁₂_base :=
        (CategoryTheory.Category.assoc ι₁₂_base (η.hom.app Z₃) (η.inv.app Z₃)).trans
          ((congrArg (ι₁₂_base ≫ ·) (η.hom_inv_id_app Z₃)).trans
            (CategoryTheory.Category.comp_id ι₁₂_base))
      rw [hp₁₂_eq x, hι₁₂]
      change (CategoryTheory.Abelian.Ext.mk₀ (ι₁₂_base ≫ η.hom.app Z₃)).comp
          ((P₁₂.mapExtAddHom Z₃ ℱ r) x) (Nat.zero_add r) =
        ((CategoryTheory.Abelian.Ext.mk₀ ι₁₂_base).comp w₁₂' (Nat.zero_add r)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app ℱ)) (Nat.add_zero r)
      rw [hExtNatIso (P₂.comp P₁) P₁₂ η Z₃ ℱ r x, hExtComp P₂ P₁ Z₃ ℱ r x]
      change (CategoryTheory.Abelian.Ext.mk₀ (ι₁₂_base ≫ η.hom.app Z₃)).comp
          ((CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Z₃)).comp
            (w₁₂'.comp (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app ℱ)) (Nat.add_zero r))
            (Nat.zero_add r)) (Nat.zero_add r) = _
      rw [← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (ι₁₂_base ≫ η.hom.app Z₃))
          (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Z₃))
          (w₁₂'.comp (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app ℱ)) (Nat.add_zero r))
          (Nat.add_zero 0) (Nat.zero_add r) (by omega),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        hcancel,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ ι₁₂_base) w₁₂'
          (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app ℱ))
          (Nat.zero_add r) (Nat.add_zero r) (by omega)]
    rw [hp₁₂_eval, ← hp₁_p₂]
    rfl

theorem weil_alt_cd_field_pos_deg_galois_effaceability (F : Type u) [Field F] (r : ℕ)
    (𝒢 : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology AddCommGrpCat.{u})
    (w : 𝒢.H (r + 1)) :
    ∃ (N : Type u) (_ : Field N) (_ : Algebra F N) (_ : FiniteDimensional F N),
      IsGalois F N ∧
      let u := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F N))
      ∀ [_hCont : (weilAltCdSitePullback u).IsContinuous
          (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of N)).smallEtaleTopology]
        [_hAdj : ((weilAltCdSitePullback u).sheafPushforwardContinuous AddCommGrpCat.{u}
          (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of N)).smallEtaleTopology).IsRightAdjoint]
        (p_u : 𝒢.H (r + 1) →+
          (((weilAltCdSitePullback u).sheafPullback AddCommGrpCat.{u}
            (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology
            (AlgebraicGeometry.Spec (CommRingCat.of N)).smallEtaleTopology).obj 𝒢).H (r + 1)),
        WeilHasGeneralEtalePullH u 𝒢 (r + 1) p_u →
        p_u w = 0 :=
by
  
  have hSyzygy :
      ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂)
        [_hCont : (weilAltCdSitePullback h).IsContinuous
          S₂.smallEtaleTopology S₁.smallEtaleTopology]
        [_hAdj : ((weilAltCdSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
          S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint]
        {S : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u})}
        (hS : S.ShortExact),
        let P_h := (weilAltCdSitePullback h).sheafPullback AddCommGrpCat.{u}
          S₂.smallEtaleTopology S₁.smallEtaleTopology
        let C₁ := CategoryTheory.constantSheaf S₁.smallEtaleTopology AddCommGrpCat.{u}
        let C₂ := CategoryTheory.constantSheaf S₂.smallEtaleTopology AddCommGrpCat.{u}
        let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
        (∀ (r' : ℕ) (c : S.X₃.H (r' + 1))
          (p₁ : S.X₁.H (r' + 2) →+ (P_h.obj S.X₁).H (r' + 2)),
          WeilHasGeneralEtalePullH h S.X₁ (r' + 2) p₁ →
          (∀ p₃ : S.X₃.H (r' + 1) →+ (P_h.obj S.X₃).H (r' + 1),
            WeilHasGeneralEtalePullH h S.X₃ (r' + 1) p₃ → p₃ c = 0) →
          p₁ (c.comp hS.extClass (rfl : (r' + 1) + 1 = r' + 2)) = 0) ∧
        (∀ (f_c : C₂.obj Aℤ ⟶ S.X₃)
          (p₁ : S.X₁.H 1 →+ (P_h.obj S.X₁).H 1),
          WeilHasGeneralEtalePullH h S.X₁ 1 p₁ →
          (∀ (T₁ : S₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
             (T₂ : S₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
             (ιℤ : C₁.obj Aℤ ⟶ P_h.obj (C₂.obj Aℤ)),
            let adj_pull := (weilAltCdSitePullback h).sheafAdjunctionContinuous AddCommGrpCat.{u}
              S₂.smallEtaleTopology S₁.smallEtaleTopology
            let P_push := (weilAltCdSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
              S₂.smallEtaleTopology S₁.smallEtaleTopology
            let adj₁ := CategoryTheory.constantSheafAdj S₁.smallEtaleTopology AddCommGrpCat.{u} hT₁
            let adj₂ := CategoryTheory.constantSheafAdj S₂.smallEtaleTopology AddCommGrpCat.{u} hT₂
            let τ : (weilAltCdSitePullback h).obj T₂ ⟶ T₁ :=
              hT₁.from ((weilAltCdSitePullback h).obj T₂)
            let πℤ : P_h.obj (C₂.obj Aℤ) ⟶ C₁.obj Aℤ :=
              (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
                ((adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).symm
                  (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
                    ((C₁.obj Aℤ).obj.map τ.op)))
            CategoryTheory.CategoryStruct.comp πℤ ιℤ =
              CategoryTheory.CategoryStruct.id (P_h.obj (C₂.obj Aℤ)) →
            ∃ g_ℐ : C₁.obj Aℤ ⟶ P_h.obj S.X₂,
              CategoryTheory.CategoryStruct.comp g_ℐ (P_h.map S.g) =
                CategoryTheory.CategoryStruct.comp ιℤ (P_h.map f_c)) →
          p₁ ((CategoryTheory.Abelian.Ext.mk₀ f_c).comp hS.extClass (Nat.zero_add 1)) = 0) := by
    intro S₁ S₂ h _hCont _hAdj S hS
    let P_h := (weilAltCdSitePullback h).sheafPullback AddCommGrpCat.{u}
      S₂.smallEtaleTopology S₁.smallEtaleTopology
    let C₁ := CategoryTheory.constantSheaf S₁.smallEtaleTopology AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf S₂.smallEtaleTopology AddCommGrpCat.{u}
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    constructor
    · intro r' c p₁ hp₁ hKill
      rcases hp₁ with ⟨hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hιπ, hπι, hp₁_eq⟩
      have : P_h.Additive := hAdd
      have : CategoryTheory.Limits.PreservesFiniteLimits P_h := hLim
      have : CategoryTheory.Limits.PreservesFiniteColimits P_h := hColim
      have hS₁ : (S.map P_h).ShortExact := hS.map_of_exact P_h
      let p₃ : S.X₃.H (r' + 1) →+ (P_h.obj S.X₃).H (r' + 1) :=
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).precomp (P_h.obj S.X₃)
          (Nat.zero_add (r' + 1))).comp
          (P_h.mapExtAddHom (C₂.obj Aℤ) S.X₃ (r' + 1))
      have hp₃_zero : p₃ c = 0 :=
        hKill p₃ ⟨hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hιπ, hπι, fun _ => rfl⟩
      have hp₃_def :
          (CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor P_h c) (Nat.zero_add (r' + 1)) = 0 := by
        simpa [p₃, CategoryTheory.Functor.mapExtAddHom_apply] using hp₃_zero
      rw [hp₁_eq, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass P_h hS]
      rw [← CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ)
        (CategoryTheory.Abelian.Ext.mapExactFunctor P_h c)
        hS₁.extClass (Nat.zero_add (r' + 1)) (rfl : (r' + 1) + 1 = r' + 2) (by omega)]
      rw [hp₃_def]
      exact CategoryTheory.Abelian.Ext.zero_comp _ _ _ _ _
    · intro f_c p₁ hp₁ hFactor
      rcases hp₁ with ⟨hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hιπ, hπι, hp₁_eq⟩
      have : P_h.Additive := hAdd
      have : CategoryTheory.Limits.PreservesFiniteLimits P_h := hLim
      have : CategoryTheory.Limits.PreservesFiniteColimits P_h := hColim
      have hS₁ : (S.map P_h).ShortExact := hS.map_of_exact P_h
      obtain ⟨g_ℐ, hg_ℐ⟩ := hFactor T₁ hT₁ T₂ hT₂ ιℤ hπι
      rw [hp₁_eq, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass P_h hS]
      rw [← CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ)
        (CategoryTheory.Abelian.Ext.mk₀ (P_h.map f_c))
        hS₁.extClass (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1)]
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← hg_ℐ]
      change (CategoryTheory.Abelian.Ext.mk₀ (g_ℐ ≫ (S.map P_h).g)).comp
        hS₁.extClass (Nat.zero_add 1) = 0
      rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ g_ℐ)
          (CategoryTheory.Abelian.Ext.mk₀ (S.map P_h).g)
          hS₁.extClass (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
        hS₁.comp_extClass]
      exact CategoryTheory.Abelian.Ext.comp_zero _ _ _ _ _

  
  have hEpiLift :
      ∀ (ℐ 𝒬 : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology AddCommGrpCat.{u})
        (π : ℐ ⟶ 𝒬) [CategoryTheory.Epi π]
        (s₀ : ↥(𝒬.obj.obj (Opposite.op
          (weilCupPDTraceTerminalObj (AlgebraicGeometry.Spec (CommRingCat.of F)))))),
        ∃ (N : Type u) (_ : Field N) (_ : Algebra F N) (_ : FiniteDimensional F N)
          (_ : IsGalois F N)
          (hu : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F N))))
          (t_N : ↥(ℐ.obj.obj (Opposite.op
            (weilGysinEtaleObj (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F N))) hu)))),
          ∀ (ρ_u : @Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F)).Etale _
              (weilGysinEtaleObj (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F N))) hu)
              (weilCupPDTraceTerminalObj (AlgebraicGeometry.Spec (CommRingCat.of F)))),
            (π.hom.app (Opposite.op
              (weilGysinEtaleObj (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F N))) hu))).hom t_N =
              (𝒬.obj.map ρ_u.op).hom s₀ := by
    intro ℐ 𝒬 π _ s₀
    let S_F := AlgebraicGeometry.Spec (CommRingCat.of F)
    let T_F₀ : S_F.Etale := weilCupPDTraceTerminalObj S_F
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale.{u}
    have : P_et.IsStableUnderComposition :=
      ⟨fun _ _ hf hg => by change AlgebraicGeometry.Etale _ at hf hg ⊢; exact inferInstance⟩
    have : CategoryTheory.Sheaf.IsLocallySurjective π :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} π).mpr inferInstance
    have hMem : CategoryTheory.Presheaf.imageSieve π.hom s₀ ∈ S_F.smallEtaleTopology T_F₀ :=
      CategoryTheory.Presheaf.imageSieve_mem S_F.smallEtaleTopology π.hom s₀
    have hJ_eq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S_F (le_refl P_et)
    have hMem' : CategoryTheory.Presheaf.imageSieve π.hom s₀ ∈
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck T_F₀ :=
      Eq.mp (congrArg (fun J => CategoryTheory.Presheaf.imageSieve π.hom s₀ ∈ J T_F₀) hJ_eq) hMem
    obtain ⟨x₀⟩ : Nonempty ↥T_F₀.left :=
      (PrimeSpectrum.nonempty_iff_nontrivial (R := F)).mpr inferInstance
    obtain ⟨V_raw, f_V_raw, y₀, hf_arr, _, _⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) T_F₀ (CategoryTheory.Presheaf.imageSieve π.hom s₀)).mp hMem' x₀
    let V : S_F.Etale := V_raw
    let f_V : V ⟶ T_F₀ := f_V_raw
    obtain ⟨t_V, ht_V⟩ :=
      Eq.mp (CategoryTheory.Presheaf.imageSieve_apply π.hom s₀ V f_V) hf_arr
    obtain ⟨V₀, hV₀, hy₀, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : V.left.Opens)) (x := y₀) trivial
    let R_A : CommRingCat.{u} := V.left.presheaf.obj (Opposite.op V₀)
    let A : Type u := ↑R_A
    have hNontrivA : Nontrivial A :=
      (PrimeSpectrum.nonempty_iff_nontrivial (R := A)).mp ⟨hV₀.primeIdealOf ⟨y₀, hy₀⟩⟩
    let v_hom : V.left ⟶ S_F := V.hom
    have : AlgebraicGeometry.Etale v_hom := V.prop
    let φ_sch : AlgebraicGeometry.Spec R_A ⟶ S_F := hV₀.fromSpec ≫ v_hom
    have hEt_sch : AlgebraicGeometry.Etale φ_sch := inferInstance
    let φ_ring : CommRingCat.of F ⟶ R_A := AlgebraicGeometry.Spec.preimage φ_sch
    have hSpec_φ : AlgebraicGeometry.Spec.map φ_ring = φ_sch :=
      AlgebraicGeometry.Spec.map_preimage φ_sch
    have hEt_ring : (CommRingCat.Hom.hom φ_ring).Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_et)).mp (hSpec_φ.symm ▸ hEt_sch)
    let _ : Algebra F A := (CommRingCat.Hom.hom φ_ring).toAlgebra
    have : Algebra.Etale F A := RingHom.etale_algebraMap.mp hEt_ring
    obtain ⟨I, _, Ai, hFieldAi, hAlgAi, e_prod, hModSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod F A).mp inferInstance
    have hNeI : Nonempty I := by
      by_contra hEmpty
      rw [not_nonempty_iff] at hEmpty
      have : Subsingleton (∀ i : I, Ai i) := inferInstance
      have : Subsingleton A := e_prod.toEquiv.subsingleton
      exact false_of_nontrivial_of_subsingleton A
    obtain ⟨i₀⟩ := hNeI
    let K₁ : Type u := Ai i₀
    let _ : Field K₁ := hFieldAi i₀
    let _ : Algebra F K₁ := hAlgAi i₀
    have : Module.Finite F K₁ := (hModSep i₀).1
    have : Algebra.IsSeparable F K₁ := (hModSep i₀).2
    let π₀ : A →ₐ[F] K₁ := (Pi.evalAlgHom F Ai i₀).comp e_prod.toAlgHom
    let Ω : Type u := SeparableClosure F
    let emb : K₁ →ₐ[F] Ω := IsSepClosed.lift
    let N_if : IntermediateField F Ω := IntermediateField.normalClosure F K₁ Ω
    let N : Type u := ↥N_if
    have : FiniteDimensional F N := normalClosure.is_finiteDimensional F K₁ Ω
    have : IsGalois F N := IsGalois.normalClosure F K₁ Ω
    let emb_N : K₁ →ₐ[F] N :=
      { toFun := fun x => ⟨emb x, AlgHom.fieldRange_le_normalClosure emb ⟨x, rfl⟩⟩
        map_one' := Subtype.ext emb.map_one
        map_mul' := fun x y => Subtype.ext (emb.map_mul x y)
        map_zero' := Subtype.ext emb.map_zero
        map_add' := fun x y => Subtype.ext (emb.map_add x y)
        commutes' := fun c => Subtype.ext (emb.commutes c) }
    let ρ : A →ₐ[F] N := emb_N.comp π₀
    have hEtAlgN : Algebra.Etale F N := by
      refine (Algebra.Etale.iff_exists_algEquiv_prod F N).mpr ?_
      refine ⟨PUnit.{u + 1}, inferInstance, fun _ => N, fun _ => inferInstance,
        fun _ => inferInstance,
        { toFun := fun x _ => x
          invFun := fun f => f PUnit.unit
          left_inv := fun _ => rfl
          right_inv := fun f => funext fun ⟨⟩ => rfl
          map_mul' := fun _ _ => rfl
          map_add' := fun _ _ => rfl
          commutes' := fun _ => rfl },
        fun _ => ⟨inferInstance, IsGalois.to_isSeparable⟩⟩
    let u := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F N))
    have hu : AlgebraicGeometry.Etale u :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_et)).mpr
        (RingHom.etale_algebraMap.mpr hEtAlgN)
    let U_u : S_F.Etale := weilGysinEtaleObj u hu
    have hφ_comp : φ_ring ≫ CommRingCat.ofHom ρ.toRingHom =
        CommRingCat.ofHom (algebraMap F N) :=
      CommRingCat.hom_ext (RingHom.ext fun x => ρ.commutes x)
    have hg_NV_w :
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom) ≫ hV₀.fromSpec) ≫ V.hom = u :=
      (CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom) ≫ ·) hSpec_φ.symm).trans
          ((AlgebraicGeometry.Spec.map_comp φ_ring (CommRingCat.ofHom ρ.toRingHom)).symm.trans
            (congrArg AlgebraicGeometry.Spec.map hφ_comp)))
    let g_NV : U_u ⟶ V :=
      CategoryTheory.MorphismProperty.Over.homMk
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom) ≫ hV₀.fromSpec) hg_NV_w
    let t_N : ↥(ℐ.obj.obj (Opposite.op U_u)) := (ℐ.obj.map g_NV.op).hom t_V
    refine ⟨N, inferInstance, inferInstance, inferInstance, inferInstance, hu, t_N, ?_⟩
    intro ρ_u_raw
    let ρ_u : U_u ⟶ T_F₀ := ρ_u_raw
    have hnat_π :
        (π.hom.app (Opposite.op U_u)).hom t_N =
          (𝒬.obj.map g_NV.op).hom ((π.hom.app (Opposite.op V)).hom t_V) :=
      congrArg (fun k => k.hom t_V) (π.hom.naturality g_NV.op)
    have ht_V' : (π.hom.app (Opposite.op V)).hom t_V = (𝒬.obj.map f_V.op).hom s₀ := ht_V
    let comp_NV : U_u ⟶ T_F₀ := g_NV ≫ f_V
    have hmap_comp :
        (𝒬.obj.map g_NV.op).hom ((𝒬.obj.map f_V.op).hom s₀) =
          (𝒬.obj.map comp_NV.op).hom s₀ :=
      congrArg (fun k => k.hom s₀) (𝒬.obj.map_comp f_V.op g_NV.op).symm
    have hhom_eq : comp_NV = ρ_u := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      have hw₁ : comp_NV.left ≫ 𝟙 S_F = u := CategoryTheory.MorphismProperty.Over.w comp_NV
      have hw₂ : ρ_u.left ≫ 𝟙 S_F = u := CategoryTheory.MorphismProperty.Over.w ρ_u
      exact (CategoryTheory.Category.comp_id comp_NV.left).symm.trans
        (hw₁.trans (hw₂.symm.trans (CategoryTheory.Category.comp_id ρ_u.left)))
    exact hnat_π.trans ((congrArg (𝒬.obj.map g_NV.op).hom ht_V').trans
      (hmap_comp.trans (congrArg (fun m => (𝒬.obj.map m.op).hom s₀) hhom_eq)))

  
  have hEtaleFactor :
      ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (u : S₁ ⟶ S₂)
        (hu : AlgebraicGeometry.Etale u)
        [_hCont : (weilAltCdSitePullback u).IsContinuous
          S₂.smallEtaleTopology S₁.smallEtaleTopology]
        [_hAdj : ((weilAltCdSitePullback u).sheafPushforwardContinuous AddCommGrpCat.{u}
          S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint]
        (T₁ : S₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        (T₂ : S₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
        (ℐ 𝒬 : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u})
