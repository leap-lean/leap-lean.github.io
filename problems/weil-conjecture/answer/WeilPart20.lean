        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              hPb_paste.lift_fst, CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              hPb_paste.lift_snd, CategoryTheory.Category.id_comp]
        inv_hom_id := by
          apply hPb_paste.hom_ext
          · rw [CategoryTheory.Category.assoc, hPb_paste.lift_fst,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, hPb_paste.lift_snd,
              CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp] },
        hPb_paste.lift_fst _ _ _,
        hPb_paste.lift_snd _ _ _⟩
    have hPbNat : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}}
        (w₁ : W₁ ⟶ U.toScheme) (w₂ : W₂ ⟶ U.toScheme) (u_left : W₁ ⟶ W₂)
        (h₁ : (w₁ ≫ U.ι) ≫ 𝟙 S = u_left ≫ w₂ ≫ U.ι) (h₂ : f ≫ 𝟙 S = 𝟙 S' ≫ f)
        (h₃ : w₁ ≫ 𝟙 U.toScheme = u_left ≫ w₂)
        (h₄ : (f ∣_ U) ≫ 𝟙 U.toScheme = 𝟙 U'.toScheme ≫ (f ∣_ U)),
        CategoryTheory.Limits.pullback.map (w₁ ≫ U.ι) f (w₂ ≫ U.ι) f u_left (𝟙 S') (𝟙 S) h₁ h₂ ≫
            (Classical.choose (hPbSch w₂)).hom =
          (Classical.choose (hPbSch w₁)).hom ≫
            CategoryTheory.Limits.pullback.map w₁ (f ∣_ U) w₂ (f ∣_ U)
              u_left (𝟙 U'.toScheme) (𝟙 U.toScheme) h₃ h₄ := by
      intro W₁ W₂ w₁ w₂ u_left h₁ h₂ h₃ h₄
      obtain ⟨hfst₁, hsnd₁⟩ := Classical.choose_spec (hPbSch w₁)
      obtain ⟨hfst₂, hsnd₂⟩ := Classical.choose_spec (hPbSch w₂)
      let hPb₂ :=
        ((CategoryTheory.IsPullback.of_hasPullback w₂ (f ∣_ U)).flip.paste_horiz hPbRestr).flip
      apply hPb₂.hom_ext
      · rw [CategoryTheory.Category.assoc, hfst₂, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc, hfst₁]
      · rw [CategoryTheory.Category.assoc, hsnd₂, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc _ _ U'.ι, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.comp_id]
        exact hsnd₁.symm
    let e_site : J_U.comp B_f ≅ B_res.comp J_U' :=
      CategoryTheory.NatIso.ofComponents
        (fun W => CategoryTheory.MorphismProperty.Over.isoMk
          (Classical.choose (hPbSch (show W.left ⟶ U.toScheme from W.hom)))
          (Classical.choose_spec (hPbSch (show W.left ⟶ U.toScheme from W.hom))).2)
        (fun {W₁ W₂} u =>
          let w₁ := (show W₁.left ⟶ U.toScheme from W₁.hom)
          let w₂ := (show W₂.left ⟶ U.toScheme from W₂.hom)
          have hu : u.left ≫ w₂ = w₁ := CategoryTheory.MorphismProperty.Over.w u
          CategoryTheory.MorphismProperty.Over.Hom.ext
            (hPbNat w₁ w₂ u.left
              (by rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc, hu])
              (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
              (by rw [CategoryTheory.Category.comp_id, hu])
              (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])))
    let _ : (J_U.comp B_f).IsContinuous U.toScheme.smallEtaleTopology S'.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp J_U B_f
        U.toScheme.smallEtaleTopology S.smallEtaleTopology S'.smallEtaleTopology
    let _ : (B_res.comp J_U').IsContinuous U.toScheme.smallEtaleTopology S'.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp B_res J_U'
        U.toScheme.smallEtaleTopology U'.toScheme.smallEtaleTopology S'.smallEtaleTopology
    let e_pf₁ := CategoryTheory.Functor.sheafPushforwardContinuousComp'
      (CategoryTheory.Iso.refl (J_U.comp B_f)) AddCommGrpCat.{u}
      U.toScheme.smallEtaleTopology S.smallEtaleTopology S'.smallEtaleTopology
    let e_pf₂ := CategoryTheory.Functor.sheafPushforwardContinuousComp'
      (CategoryTheory.Iso.refl (B_res.comp J_U')) AddCommGrpCat.{u}
      U.toScheme.smallEtaleTopology U'.toScheme.smallEtaleTopology S'.smallEtaleTopology
    let e_pf_mid := CategoryTheory.Functor.sheafPushforwardContinuousIso e_site
      AddCommGrpCat.{u} U.toScheme.smallEtaleTopology S'.smallEtaleTopology
    let e_pf : ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
          S.smallEtaleTopology S'.smallEtaleTopology).comp
        ((J_of S U).sheafPushforwardContinuous AddCommGrpCat.{u}
          U.toScheme.smallEtaleTopology S.smallEtaleTopology) ≅
        ((J_of S' U').sheafPushforwardContinuous AddCommGrpCat.{u}
          U'.toScheme.smallEtaleTopology S'.smallEtaleTopology).comp
        ((weilEtaleSitePullback (f ∣_ U)).sheafPushforwardContinuous AddCommGrpCat.{u}
          U.toScheme.smallEtaleTopology U'.toScheme.smallEtaleTopology) :=
      e_pf₁ ≪≫ e_pf_mid ≪≫ e_pf₂.symm
    let adj_U := J_U.sheafAdjunctionContinuous AddCommGrpCat.{u}
      U.toScheme.smallEtaleTopology S.smallEtaleTopology
    let adj_U' := J_U'.sheafAdjunctionContinuous AddCommGrpCat.{u}
      U'.toScheme.smallEtaleTopology S'.smallEtaleTopology
    let adj_f := B_f.sheafAdjunctionContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology S'.smallEtaleTopology
    let adj_res := B_res.sheafAdjunctionContinuous AddCommGrpCat.{u}
      U.toScheme.smallEtaleTopology U'.toScheme.smallEtaleTopology
    exact ⟨⟨e_pf⟩, ⟨CategoryTheory.Adjunction.leftAdjointUniq
      (CategoryTheory.Adjunction.ofNatIsoRight (adj_U.comp adj_f) e_pf)
      (adj_res.comp adj_U')⟩⟩

  have hOpenPbZero : ∀ {S : AlgebraicGeometry.Scheme.{u}} (O : S.Opens)
      (F : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (W : O.toScheme.Etale),
        let w_hom : W.left ⟶ O.toScheme := W.hom
        have _ : AlgebraicGeometry.Etale (w_hom ≫ O.ι) :=
          CategoryTheory.MorphismProperty.comp_mem _ _ _ W.prop inferInstance
        CategoryTheory.Limits.IsZero
          (F.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk (w_hom ≫ O.ι))))) →
      CategoryTheory.Limits.IsZero
        (((weilEtaleSitePullback O.ι).sheafPullback AddCommGrpCat.{u}
          S.smallEtaleTopology O.toScheme.smallEtaleTopology).obj F) := by
    intro S O F hW
    obtain ⟨e_st⟩ := (hOpenBase S O).2.2.2.2.2.2.2
    let j_star_O := (J_of S O).sheafPushforwardContinuous AddCommGrpCat.{u}
      O.toScheme.smallEtaleTopology S.smallEtaleTopology
    have hZ_j : CategoryTheory.Limits.IsZero (j_star_O.obj F) := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply CategoryTheory.InducedCategory.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext W_op
      let isoObj : (J_of S O).obj W_op.unop ≅
          (let w_hom : W_op.unop.left ⟶ O.toScheme := W_op.unop.hom
           have _ : AlgebraicGeometry.Etale (w_hom ≫ O.ι) :=
             CategoryTheory.MorphismProperty.comp_mem _ _ _ W_op.unop.prop inferInstance
           AlgebraicGeometry.Scheme.Etale.mk (w_hom ≫ O.ι)) :=
        CategoryTheory.MorphismProperty.Over.isoMk
          (CategoryTheory.Iso.refl W_op.unop.left)
          (CategoryTheory.Category.id_comp _)
      exact (CategoryTheory.Limits.IsZero.of_iso (hW W_op.unop)
        (F.obj.mapIso isoObj.op.symm)).eq_of_src _ _
    exact CategoryTheory.Limits.IsZero.of_iso hZ_j (e_st.app F).symm

  have hConstPbIso : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (A : AddCommGrpCat.{u}),
      Nonempty ((((weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology).obj
        ((CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj A)) ≅
        (CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj A) := by
    intro X₁ X₂ h A
    let B_h := weilEtaleSitePullback h
    let P_push := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let T₁ := etaleIdTerm X₁
    let T₂ := etaleIdTerm X₂
    have hT₁ := etaleIdTermIsTerm X₁
    have hT₂ := etaleIdTermIsTerm X₂
    let pb_id : CategoryTheory.Limits.pullback (CategoryTheory.CategoryStruct.id X₂) h ≅ X₁ :=
      { hom := CategoryTheory.Limits.pullback.snd (CategoryTheory.CategoryStruct.id X₂) h
        inv := CategoryTheory.Limits.pullback.lift h (CategoryTheory.CategoryStruct.id X₁) (by simp)
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        inv_hom_id := CategoryTheory.Limits.pullback.lift_snd _ _ _ }
    let e_T : B_h.obj T₂ ≅ T₁ :=
      CategoryTheory.MorphismProperty.Over.isoMk pb_id (CategoryTheory.Category.comp_id _)
    let adj₁ := CategoryTheory.constantSheafAdj X₁.smallEtaleTopology AddCommGrpCat.{u} hT₁
    let adj₂ := (CategoryTheory.constantSheafAdj X₂.smallEtaleTopology AddCommGrpCat.{u} hT₂).comp
      (B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology)
    let Γ₁ := (CategoryTheory.sheafSections X₁.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₁)
    let Γ₂ := (CategoryTheory.sheafSections X₂.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₂)
    have hΓ_iso : P_push.comp Γ₂ ≅ Γ₁ :=
      CategoryTheory.NatIso.ofComponents
        (fun ℱ => ℱ.obj.mapIso e_T.op.symm)
        (fun {_ _} φ => (φ.hom.naturality e_T.inv.op).symm)
    exact ⟨(CategoryTheory.Adjunction.leftAdjointUniq
      (CategoryTheory.Adjunction.ofNatIsoRight adj₂ hΓ_iso) adj₁).app A⟩

  have hTorMap : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}}
      (P : CategoryTheory.Functor
        (CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Sheaf Z₂.smallEtaleTopology AddCommGrpCat.{u}))
      [P.Additive]
      (M : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id M = 0 →
      ℓ • CategoryTheory.CategoryStruct.id (P.obj M) = 0 := by
    intro Z₁ Z₂ P _ M hM
    rw [← P.map_id, ← P.map_nsmul, hM, P.map_zero]

  have hShriekOutZero : ∀ {S : AlgebraicGeometry.Scheme.{u}} (U : S.Opens)
      [_hc_U : (J_of S U).IsContinuous U.toScheme.smallEtaleTopology S.smallEtaleTopology]
      [_hr_U : ((J_of S U).sheafPushforwardContinuous AddCommGrpCat.{u}
        U.toScheme.smallEtaleTopology S.smallEtaleTopology).IsRightAdjoint]
      (N : CategoryTheory.Sheaf U.toScheme.smallEtaleTopology AddCommGrpCat.{u})
      (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S),
      (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), s.base pt ∉ U) →
      CategoryTheory.Limits.IsZero
        (((weilEtaleSitePullback s).sheafPullback AddCommGrpCat.{u}
          S.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology).obj
          (((J_of S U).sheafPullback AddCommGrpCat.{u}
            U.toScheme.smallEtaleTopology S.smallEtaleTopology).obj N)) := by
    intro S U _hc_U _hr_U N Ω _ _ s hs
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let U' : S_Ω.Opens := (TopologicalSpace.Opens.map s.base).obj U
    have hEmpU' : IsEmpty ↥U' := ⟨fun ⟨pt, hpt⟩ => hs pt hpt⟩
    obtain ⟨_, ⟨e_bc⟩⟩ := hOpenBC s U
    have hZ := (hOpenBase S_Ω U').2.2.2.2.1 hEmpU'
      (((weilEtaleSitePullback (s ∣_ U)).sheafPullback AddCommGrpCat.{u}
        U.toScheme.smallEtaleTopology U'.toScheme.smallEtaleTopology).obj N)
    exact CategoryTheory.Limits.IsZero.of_iso hZ (e_bc.app N)

  have hMapInIso : ∀ {S : AlgebraicGeometry.Scheme.{u}} (U : S.Opens)
      [_hc_U : (J_of S U).IsContinuous U.toScheme.smallEtaleTopology S.smallEtaleTopology]
      [_hr_U : ((J_of S U).sheafPushforwardContinuous AddCommGrpCat.{u}
        U.toScheme.smallEtaleTopology S.smallEtaleTopology).IsRightAdjoint]
      {F₁ F₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : F₁ ⟶ F₂),
      CategoryTheory.IsIso (((J_of S U).sheafPushforwardContinuous AddCommGrpCat.{u}
        U.toScheme.smallEtaleTopology S.smallEtaleTopology).map φ) →
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s_y : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S),
        (∃ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), s_y.base pt ∈ U) →
        CategoryTheory.IsIso
          (((weilEtaleSitePullback s_y).sheafPullback AddCommGrpCat.{u}
            S.smallEtaleTopology
            (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology).map φ) := by
    intro S U _hc_U _hr_U F₁ F₂ φ hIsoJ Ω _ _ s_y ⟨pt_in, hpt_in⟩
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    have hsy_U : Set.range s_y.base ⊆ Set.range U.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι U]
      rintro _ ⟨q, rfl⟩
      rw [Subsingleton.elim q pt_in]
      exact hpt_in
    let s_u : S_Ω ⟶ U.toScheme := AlgebraicGeometry.IsOpenImmersion.lift U.ι s_y hsy_U
    have hsu_fac : s_u ≫ U.ι = s_y :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι s_y hsy_U
    obtain ⟨e_st⟩ := (hOpenBase S U).2.2.2.2.2.2.2
    let j_star_U := (J_of S U).sheafPushforwardContinuous AddCommGrpCat.{u}
      U.toScheme.smallEtaleTopology S.smallEtaleTopology
    let pb_Uι := (weilEtaleSitePullback U.ι).sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology U.toScheme.smallEtaleTopology
    have hpb_eq : pb_Uι.map φ = e_st.inv.app F₁ ≫ j_star_U.map φ ≫ e_st.hom.app F₂ := by
      rw [← e_st.inv.naturality_assoc φ, e_st.inv_hom_id_app, CategoryTheory.Category.comp_id]
    have _ : CategoryTheory.IsIso (j_star_U.map φ) := hIsoJ
    have _ : CategoryTheory.IsIso (pb_Uι.map φ) := by
      rw [hpb_eq]
      infer_instance
    obtain ⟨e_comp⟩ := hPbComp s_u U.ι
    let pb_sy := (weilEtaleSitePullback s_y).sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology S_Ω.smallEtaleTopology
    let pb_su := (weilEtaleSitePullback s_u).sheafPullback AddCommGrpCat.{u}
      U.toScheme.smallEtaleTopology S_Ω.smallEtaleTopology
    let e_sy : pb_sy ≅ pb_Uι.comp pb_su :=
      eqToIso (by rw [hsu_fac]) ≪≫ e_comp
    have hsy_map : pb_sy.map φ =
        e_sy.hom.app F₁ ≫ pb_su.map (pb_Uι.map φ) ≫ e_sy.inv.app F₂ := by
      change pb_sy.map φ = e_sy.hom.app F₁ ≫ (pb_Uι.comp pb_su).map φ ≫ e_sy.inv.app F₂
      rw [← e_sy.hom.naturality_assoc φ, e_sy.hom_inv_id_app, CategoryTheory.Category.comp_id]
    rw [hsy_map]
    infer_instance

  
  
  have hOpenEt : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
      [AlgebraicGeometry.IsOpenImmersion f], AlgebraicGeometry.Etale f :=
    fun f => AlgebraicGeometry.HasRingHomProperty.of_isOpenImmersion
      (P := @AlgebraicGeometry.Etale)
      (fun _ _ => RingHom.Etale.of_bijective Function.bijective_id)

  have hEtaleSec : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      {P : AlgebraicGeometry.Scheme.{u}}
      (e : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      [AlgebraicGeometry.Etale e] [Nonempty ↥P],
      ∃ (σ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ P),
        σ ≫ e = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
    intro Ω _ _ P e _ hNEP
    obtain ⟨p₀⟩ := hNEP
    obtain ⟨_, ⟨W_aff, hAff, rfl⟩, hp₀, -⟩ :=
      (AlgebraicGeometry.Scheme.isBasis_affineOpens P).exists_subset_of_mem_open
        (Set.mem_univ p₀) isOpen_univ
    let U_aff : P.Opens := W_aff
    have hAff' : AlgebraicGeometry.IsAffineOpen U_aff := hAff
    let Z_aff : AlgebraicGeometry.Scheme.{u} := U_aff.toScheme
    let _ : AlgebraicGeometry.IsAffine Z_aff := hAff'
    let R_B : CommRingCat.{u} := AlgebraicGeometry.Scheme.Γ.obj (Opposite.op Z_aff)
    let ι_aff : AlgebraicGeometry.Spec R_B ⟶ P := Z_aff.isoSpec.inv ≫ U_aff.ι
    let φ : CommRingCat.of Ω ⟶ R_B := AlgebraicGeometry.Spec.preimage (ι_aff ≫ e)
    have hSpec_φ : AlgebraicGeometry.Spec.map φ = ι_aff ≫ e :=
      AlgebraicGeometry.Spec.map_preimage _
    have hEt_ι : AlgebraicGeometry.Etale ι_aff :=
      CategoryTheory.MorphismProperty.comp_mem _ Z_aff.isoSpec.inv U_aff.ι
        (hOpenEt Z_aff.isoSpec.inv) inferInstance
    have hEt_comp : AlgebraicGeometry.Etale (ι_aff ≫ e) :=
      CategoryTheory.MorphismProperty.comp_mem _ ι_aff e hEt_ι inferInstance
    have hEt_map : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ) :=
      hSpec_φ.symm ▸ hEt_comp
    have hφ_et : (CommRingCat.Hom.hom φ).Etale :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp hEt_map
    let _ : Algebra Ω ↑R_B := (CommRingCat.Hom.hom φ).toAlgebra
    have _ : Algebra.Etale Ω ↑R_B := RingHom.Etale.toAlgebra hφ_et
    obtain ⟨w₀, -⟩ := (AlgebraicGeometry.Scheme.Opens.range_ι U_aff).symm ▸ hp₀
    let q₀ : PrimeSpectrum ↑R_B := Z_aff.isoSpec.hom.base w₀
    let L := Localization.AtPrime q₀.asIdeal
    have hBij := Algebra.FormallyUnramified.bijective_of_isAlgClosed_of_isLocalRing Ω L
    let e_L : Ω ≃+* L := RingEquiv.ofBijective (algebraMap Ω L) hBij
    let ψ : ↑R_B →+* Ω := e_L.symm.toRingHom.comp (algebraMap ↑R_B L)
    have hcomp : φ ≫ CommRingCat.ofHom ψ = 𝟙 (CommRingCat.of Ω) := by
      ext c
      change e_L.symm (algebraMap ↑R_B L (algebraMap Ω ↑R_B c)) = c
      rw [← IsScalarTower.algebraMap_apply Ω ↑R_B L c]
      exact e_L.symm_apply_apply c
    refine ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ ι_aff, ?_⟩
    exact (CategoryTheory.Category.assoc _ _ _).trans
      ((congrArg (_ ≫ ·) hSpec_φ.symm).trans
        ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
          ((congrArg AlgebraicGeometry.Spec.map hcomp).trans
            (AlgebraicGeometry.Spec.map_id _))))

  let fibOf : ∀ (Ω : Type u) [Field Ω] (W : AlgebraicGeometry.Scheme.{u})
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
      CategoryTheory.Functor W.Etale (Type u) :=
    fun Ω _ W w =>
      { obj := fun E =>
          { e : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E.left //
            e ≫ (show E.left ⟶ W from E.hom) = w }
        map := fun {E₁ E₂} u =>
          TypeCat.ofHom (fun x =>
            ⟨x.1 ≫ u.left,
              (CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (x.1 ≫ ·) (CategoryTheory.MorphismProperty.Over.w u)).trans x.2)⟩)
        map_id := fun _ => by
          ext x
          exact CategoryTheory.Category.comp_id x.1
        map_comp := fun u₁ u₂ => by
          ext x
          exact (CategoryTheory.Category.assoc x.1 u₁.left u₂.left).symm }

  have hFibJointSurj : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (W : AlgebraicGeometry.Scheme.{u})
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W)
      {E : W.Etale} (R : CategoryTheory.Sieve E),
      R ∈ W.smallEtaleTopology E →
      ∀ (x : (fibOf Ω W w).obj E),
        ∃ (Y : W.Etale) (f : Y ⟶ E) (_ : R.arrows f) (y : (fibOf Ω W w).obj Y),
          (CategoryTheory.ConcreteCategory.hom ((fibOf Ω W w).map f)) y = x := by
    intro Ω _ _ W w E R hR ⟨e, he⟩
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      W (le_refl (@AlgebraicGeometry.Etale))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) W
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance E R
    have hRW := ((iff_of_eq (congrArg (fun K : CategoryTheory.GrothendieckTopology W.Etale =>
      R ∈ K E) heq)).trans hiff).mp hR
    let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := default
    obtain ⟨Y, f, y₀, hfR, hEt_f, hy₀⟩ := hRW (e.base pt₀)
    have _ : AlgebraicGeometry.Etale f.left := hEt_f
    obtain ⟨z₀, -, -⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₀ pt₀ hy₀
    let P := CategoryTheory.Limits.pullback f.left e
    have _ : Nonempty ↥P := ⟨z₀⟩
    obtain ⟨σ, hσ⟩ := hEtaleSec Ω (CategoryTheory.Limits.pullback.snd f.left e)
    let e_Y : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y.left :=
      σ ≫ CategoryTheory.Limits.pullback.fst f.left e
    have he_Y_f : e_Y ≫ f.left = e := by
      dsimp [e_Y]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc, hσ, CategoryTheory.Category.id_comp]
    have he_Y : e_Y ≫ (show Y.left ⟶ W from Y.hom) = w := by
      rw [← CategoryTheory.MorphismProperty.Over.w f, ← CategoryTheory.Category.assoc,
        he_Y_f, he]
    exact ⟨Y, f, hfR, ⟨e_Y, he_Y⟩, Subtype.ext he_Y_f⟩

  have hDiagConeSch : ∀ {W₀ E₁₀ E₂₀ S₀ : AlgebraicGeometry.Scheme.{u}}
      (e₁_hom : E₁₀ ⟶ W₀) (e₂_hom : E₂₀ ⟶ W₀)
      [AlgebraicGeometry.Etale e₁_hom] [AlgebraicGeometry.Etale e₂_hom]
      (u₁ u₂ : E₁₀ ⟶ E₂₀) (hu : u₁ ≫ e₂_hom = u₂ ≫ e₂_hom)
      (e₁ : S₀ ⟶ E₁₀) (he₁₂ : e₁ ≫ u₁ = e₁ ≫ u₂),
      ∃ (P_eq : AlgebraicGeometry.Scheme.{u}) (p_eq : P_eq ⟶ E₁₀)
        (_ : AlgebraicGeometry.Etale (p_eq ≫ e₁_hom))
        (e_eq : S₀ ⟶ P_eq),
        e_eq ≫ p_eq = e₁ ∧ p_eq ≫ u₁ = p_eq ≫ u₂ := by
    intro W₀ E₁₀ E₂₀ S₀ e₁_hom e₂_hom _ _ u₁ u₂ hu e₁ he₁₂
    let Δ := CategoryTheory.Limits.pullback.diagonal e₂_hom
    have _ : AlgebraicGeometry.IsOpenImmersion Δ :=
      AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal e₂_hom
    let pair := CategoryTheory.Limits.pullback.lift u₁ u₂ hu
    let p_eq := CategoryTheory.Limits.pullback.snd Δ pair
    have hEt_peq : AlgebraicGeometry.Etale p_eq := hOpenEt p_eq
    have hEt_comp : AlgebraicGeometry.Etale (p_eq ≫ e₁_hom) :=
      CategoryTheory.MorphismProperty.comp_mem _ p_eq e₁_hom hEt_peq inferInstance
    have hpair : (e₁ ≫ u₁) ≫ Δ = e₁ ≫ pair := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, he₁₂]
    let e_eq := CategoryTheory.Limits.pullback.lift (e₁ ≫ u₁) e₁ hpair
    have hv_eq : p_eq ≫ u₁ = p_eq ≫ u₂ := by
      calc
        p_eq ≫ u₁ = p_eq ≫ pair ≫ CategoryTheory.Limits.pullback.fst e₂_hom e₂_hom := by
          rw [CategoryTheory.Limits.pullback.lift_fst]
        _ = (CategoryTheory.Limits.pullback.fst Δ pair ≫ Δ) ≫
              CategoryTheory.Limits.pullback.fst e₂_hom e₂_hom := by
          rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
        _ = CategoryTheory.Limits.pullback.fst Δ pair := by
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
            CategoryTheory.Category.comp_id]
        _ = (CategoryTheory.Limits.pullback.fst Δ pair ≫ Δ) ≫
              CategoryTheory.Limits.pullback.snd e₂_hom e₂_hom := by
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
            CategoryTheory.Category.comp_id]
        _ = p_eq ≫ pair ≫ CategoryTheory.Limits.pullback.snd e₂_hom e₂_hom := by
          rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
        _ = p_eq ≫ u₂ := by
          rw [CategoryTheory.Limits.pullback.lift_snd]
    exact ⟨CategoryTheory.Limits.pullback Δ pair, p_eq, hEt_comp, e_eq,
      CategoryTheory.Limits.pullback.lift_snd _ _ _, hv_eq⟩

  have hFibCofiltered : ∀ (Ω : Type u) [Field Ω] (W : AlgebraicGeometry.Scheme.{u})
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
      CategoryTheory.IsCofiltered (fibOf Ω W w).Elements := by
    intro Ω _ W w
    have hOrEmpty : CategoryTheory.IsCofilteredOrEmpty (fibOf Ω W w).Elements :=
      { cone_objs := fun X₁ X₂ => by
          let E₁ := X₁.obj
          let e₁ := X₁.val.1
          have he₁ := X₁.val.2
          let E₂ := X₂.obj
          let e₂ := X₂.val.1
          have he₂ := X₂.val.2
          let e₁_hom : E₁.left ⟶ W := E₁.hom
          let e₂_hom : E₂.left ⟶ W := E₂.hom
          have _ : AlgebraicGeometry.Etale e₁_hom := E₁.prop
          have _ : AlgebraicGeometry.Etale e₂_hom := E₂.prop
          let fst := CategoryTheory.Limits.pullback.fst e₁_hom e₂_hom
          let snd := CategoryTheory.Limits.pullback.snd e₁_hom e₂_hom
          have _ : AlgebraicGeometry.Etale (fst ≫ e₁_hom) :=
            CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance E₁.prop
          let E₁₂ : W.Etale := AlgebraicGeometry.Scheme.Etale.mk (fst ≫ e₁_hom)
          let e₁₂ := CategoryTheory.Limits.pullback.lift e₁ e₂ (he₁.trans he₂.symm)
          have he₁₂ : e₁₂ ≫ (fst ≫ e₁_hom) = w :=
            (CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans he₁
          let p₁ : E₁₂ ⟶ E₁ := CategoryTheory.MorphismProperty.Over.homMk fst rfl trivial
          let p₂ : E₁₂ ⟶ E₂ := CategoryTheory.MorphismProperty.Over.homMk snd
            CategoryTheory.Limits.pullback.condition.symm trivial
          exact ⟨CategoryTheory.Functor.elementsMk (fibOf Ω W w) E₁₂ ⟨e₁₂, he₁₂⟩,
            ⟨p₁, Subtype.ext (CategoryTheory.Limits.pullback.lift_fst _ _ _)⟩,
            ⟨p₂, Subtype.ext (CategoryTheory.Limits.pullback.lift_snd _ _ _)⟩, trivial⟩
        cone_maps := fun {X₁ X₂} f g => by
          let E₁ := X₁.obj
          let e₁ := X₁.val.1
          have he₁ := X₁.val.2
          let E₂ := X₂.obj
          let e₂ := X₂.val.1
          let u₁ := f.hom
          let u₂ := g.hom
          have hu₁_eq : e₁ ≫ u₁.left = e₂ := congrArg Subtype.val f.map_val
          have hu₂_eq : e₁ ≫ u₂.left = e₂ := congrArg Subtype.val g.map_val
          have he₁₂_eq : e₁ ≫ u₁.left = e₁ ≫ u₂.left := hu₁_eq.trans hu₂_eq.symm
          let e₁_hom : E₁.left ⟶ W := E₁.hom
          let e₂_hom : E₂.left ⟶ W := E₂.hom
          have _ : AlgebraicGeometry.Etale e₁_hom := E₁.prop
          have _ : AlgebraicGeometry.Etale e₂_hom := E₂.prop
          obtain ⟨P_eq, p_eq, hEt_comp, e_eq, he_peq, hv_eq⟩ :=
            hDiagConeSch e₁_hom e₂_hom u₁.left u₂.left
              ((CategoryTheory.MorphismProperty.Over.w u₁).trans
                (CategoryTheory.MorphismProperty.Over.w u₂).symm)
              e₁ he₁₂_eq
          let E_eq : W.Etale := AlgebraicGeometry.Scheme.Etale.mk (p_eq ≫ e₁_hom)
          have he_eq : e_eq ≫ (p_eq ≫ e₁_hom) = w :=
            (CategoryTheory.Category.assoc e_eq p_eq e₁_hom).symm.trans
              ((congrArg (· ≫ e₁_hom) he_peq).trans he₁)
          let v : E_eq ⟶ E₁ := CategoryTheory.MorphismProperty.Over.homMk p_eq rfl trivial
          refine ⟨CategoryTheory.Functor.elementsMk (fibOf Ω W w) E_eq ⟨e_eq, he_eq⟩,
            ⟨v, Subtype.ext he_peq⟩, ?_⟩
          apply CategoryTheory.Functor.Elements.hom_ext
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          exact hv_eq }
    exact { toIsCofilteredOrEmpty := hOrEmpty
            nonempty := ⟨CategoryTheory.Functor.elementsMk (fibOf Ω W w) (etaleIdTerm W)
              ⟨w, CategoryTheory.Category.comp_id w⟩⟩ }

  have hFibInitSmall : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (W : AlgebraicGeometry.Scheme.{u})
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
      CategoryTheory.InitiallySmall.{u} (fibOf Ω W w).Elements := by
    intro Ω _ _ W w
    have _ : CategoryTheory.IsCofiltered (fibOf Ω W w).Elements := hFibCofiltered Ω W w
    let ι_aff := AlgebraicGeometry.Scheme.AffineEtale.Spec W
    let e_sm := CategoryTheory.equivSmallModel W.AffineEtale
    let G_sm : CategoryTheory.Functor (CategoryTheory.SmallModel.{u} W.AffineEtale) W.Etale :=
      e_sm.inverse ⋙ ι_aff
    have hCov_G : ∀ E : W.Etale,
        CategoryTheory.Sieve.coverByImage G_sm E ∈ W.smallEtaleTopology E := by
      intro E
      refine W.smallEtaleTopology.superset_covering ?_
        (ι_aff.is_cover_of_isCoverDense W.smallEtaleTopology E)
      intro Y f hf
      rcases hf with ⟨V, g₁, g₂, rfl⟩
      exact ⟨e_sm.functor.obj V, g₁ ≫ ι_aff.map (e_sm.unitIso.app V).hom,
        ι_aff.map (e_sm.unitIso.app V).inv ≫ g₂, by simp [G_sm]⟩
    let F_sm := G_sm ⋙ fibOf Ω W w
    let I_sm : CategoryTheory.Functor F_sm.Elements (fibOf Ω W w).Elements :=
      { obj := fun c => CategoryTheory.Functor.elementsMk (fibOf Ω W w) (G_sm.obj c.obj) c.val
        map := fun {c₁ c₂} t => ⟨G_sm.map t.hom, t.map_val⟩
        map_id := fun c => CategoryTheory.Functor.Elements.hom_ext (G_sm.map_id c.obj)
        map_comp := fun t₁ t₂ => CategoryTheory.Functor.Elements.hom_ext (G_sm.map_comp t₁.hom t₂.hom) }
    have hLiftElem : ∀ d : (fibOf Ω W w).Elements,
        ∃ (c : F_sm.Elements), Nonempty (I_sm.obj c ⟶ d) := by
      intro d
      obtain ⟨Y, f, hf_cov, y, hy⟩ := hFibJointSurj Ω W w _ (hCov_G d.obj) d.val
      rcases hf_cov with ⟨X₀, g₁, g₂, rfl⟩
      let x₀ : F_sm.obj X₀ := (CategoryTheory.ConcreteCategory.hom ((fibOf Ω W w).map g₁)) y
      have hx₀ : (CategoryTheory.ConcreteCategory.hom ((fibOf Ω W w).map g₂)) x₀ = d.val := by
        dsimp [x₀]
        rw [← CategoryTheory.ConcreteCategory.comp_apply, ← (fibOf Ω W w).map_comp]
        exact hy
      exact ⟨CategoryTheory.Functor.elementsMk F_sm X₀ x₀, ⟨⟨g₂, hx₀⟩⟩⟩
    have _ : I_sm.Initial := by
      refine CategoryTheory.Functor.Initial.mk (fun d => ?_)
      have _ : CategoryTheory.IsCofiltered (CategoryTheory.CostructuredArrow I_sm d) :=
        { toIsCofilteredOrEmpty :=
            { cone_objs := fun c₁ c₂ => by
                obtain ⟨d₁, u₁, u₂, -⟩ :=
                  CategoryTheory.IsCofilteredOrEmpty.cone_objs (I_sm.obj c₁.left) (I_sm.obj c₂.left)
                obtain ⟨d₂, v, hv⟩ :=
                  CategoryTheory.IsCofilteredOrEmpty.cone_maps (u₁ ≫ c₁.hom) (u₂ ≫ c₂.hom)
                obtain ⟨c₀, ⟨w₀⟩⟩ := hLiftElem d₂
                let t₁_mor := G_sm.preimage (w₀.hom ≫ v.hom ≫ u₁.hom)
                let t₂_mor := G_sm.preimage (w₀.hom ≫ v.hom ≫ u₂.hom)
                have ht₁_map : G_sm.map t₁_mor = w₀.hom ≫ v.hom ≫ u₁.hom := G_sm.map_preimage _
                have ht₂_map : G_sm.map t₂_mor = w₀.hom ≫ v.hom ≫ u₂.hom := G_sm.map_preimage _
                let m₁ : c₀ ⟶ c₁.left := ⟨t₁_mor, by
                  change (CategoryTheory.ConcreteCategory.hom
                    ((fibOf Ω W w).map (G_sm.map t₁_mor))) c₀.val = c₁.left.val
                  exact (congrArg (fun q => (CategoryTheory.ConcreteCategory.hom
                    ((fibOf Ω W w).map q)) c₀.val) ht₁_map).trans
                    ((w₀ ≫ v ≫ u₁ : I_sm.obj c₀ ⟶ I_sm.obj c₁.left).map_val)⟩
                let m₂ : c₀ ⟶ c₂.left := ⟨t₂_mor, by
                  change (CategoryTheory.ConcreteCategory.hom
                    ((fibOf Ω W w).map (G_sm.map t₂_mor))) c₀.val = c₂.left.val
                  exact (congrArg (fun q => (CategoryTheory.ConcreteCategory.hom
                    ((fibOf Ω W w).map q)) c₀.val) ht₂_map).trans
                    ((w₀ ≫ v ≫ u₂ : I_sm.obj c₀ ⟶ I_sm.obj c₂.left).map_val)⟩
                have hm₁ : I_sm.map m₁ ≫ c₁.hom = w₀ ≫ v ≫ u₁ ≫ c₁.hom := by
                  apply CategoryTheory.Functor.Elements.hom_ext
                  change G_sm.map t₁_mor ≫ c₁.hom.hom = (w₀.hom ≫ v.hom ≫ u₁.hom) ≫ c₁.hom.hom
                  exact (congrArg (· ≫ c₁.hom.hom) ht₁_map)
                have hm₂ : I_sm.map m₂ ≫ c₂.hom = w₀ ≫ v ≫ u₂ ≫ c₂.hom := by
                  apply CategoryTheory.Functor.Elements.hom_ext
                  change G_sm.map t₂_mor ≫ c₂.hom.hom = (w₀.hom ≫ v.hom ≫ u₂.hom) ≫ c₂.hom.hom
                  exact (congrArg (· ≫ c₂.hom.hom) ht₂_map)
                have hcomm : w₀ ≫ v ≫ u₁ ≫ c₁.hom = w₀ ≫ v ≫ u₂ ≫ c₂.hom :=
                  congrArg (w₀ ≫ ·) hv
                exact ⟨CategoryTheory.CostructuredArrow.mk (w₀ ≫ v ≫ u₁ ≫ c₁.hom),
                  CategoryTheory.CostructuredArrow.homMk m₁ hm₁,
                  CategoryTheory.CostructuredArrow.homMk m₂ (hm₂.trans hcomm.symm), trivial⟩
              cone_maps := fun {c₁ c₂} f₁ f₂ => by
                obtain ⟨d', u, hu⟩ :=
                  CategoryTheory.IsCofilteredOrEmpty.cone_maps
                    (I_sm.map f₁.left) (I_sm.map f₂.left)
                obtain ⟨c₀, ⟨w₀⟩⟩ := hLiftElem d'
                let t_mor := G_sm.preimage (w₀.hom ≫ u.hom)
                have ht_map : G_sm.map t_mor = w₀.hom ≫ u.hom := G_sm.map_preimage _
                let m : c₀ ⟶ c₁.left := ⟨t_mor, by
                  change (CategoryTheory.ConcreteCategory.hom
                    ((fibOf Ω W w).map (G_sm.map t_mor))) c₀.val = c₁.left.val
                  exact (congrArg (fun q => (CategoryTheory.ConcreteCategory.hom
                    ((fibOf Ω W w).map q)) c₀.val) ht_map).trans
                    ((w₀ ≫ u : I_sm.obj c₀ ⟶ I_sm.obj c₁.left).map_val)⟩
                have hm : I_sm.map m ≫ c₁.hom = w₀ ≫ u ≫ c₁.hom := by
                  apply CategoryTheory.Functor.Elements.hom_ext
                  change G_sm.map t_mor ≫ c₁.hom.hom = (w₀.hom ≫ u.hom) ≫ c₁.hom.hom
                  exact congrArg (· ≫ c₁.hom.hom) ht_map
                refine ⟨CategoryTheory.CostructuredArrow.mk (w₀ ≫ u ≫ c₁.hom),
                  CategoryTheory.CostructuredArrow.homMk m hm, ?_⟩
                apply CategoryTheory.CostructuredArrow.hom_ext
                apply CategoryTheory.Functor.Elements.hom_ext
                apply G_sm.map_injective
                change G_sm.map (t_mor ≫ f₁.left.hom) = G_sm.map (t_mor ≫ f₂.left.hom)
                refine (G_sm.map_comp t_mor f₁.left.hom).trans ?_
                refine (congrArg (· ≫ G_sm.map f₁.left.hom) ht_map).trans ?_
                refine (CategoryTheory.Category.assoc _ _ _).trans ?_
                refine (congrArg (w₀.hom ≫ ·)
                  (congrArg CategoryTheory.Functor.Elements.Hom.hom hu)).trans ?_
                refine (CategoryTheory.Category.assoc _ _ _).symm.trans ?_
                exact (congrArg (· ≫ G_sm.map f₂.left.hom) ht_map.symm).trans
                  (G_sm.map_comp t_mor f₂.left.hom).symm }
          nonempty := by
            obtain ⟨_, ⟨g₀⟩⟩ := hLiftElem d
            exact ⟨CategoryTheory.CostructuredArrow.mk g₀⟩ }
      exact CategoryTheory.IsCofiltered.isConnected _
    exact CategoryTheory.InitiallySmall.mk' I_sm

  let pt : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (W : AlgebraicGeometry.Scheme.{u})
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
      CategoryTheory.GrothendieckTopology.Point.{u} W.smallEtaleTopology :=
    fun Ω _ _ W w =>
      @CategoryTheory.GrothendieckTopology.Point.mk _ _ W.smallEtaleTopology
        (fibOf Ω W w) (hFibCofiltered Ω W w) (hFibInitSmall Ω W w)
        (fun {_} R hR x => hFibJointSurj Ω W w R hR x)

  have hPiReindexIso : ∀ {I₁ I₂ : Type u} (eqv : I₁ ≃ I₂) (k : AddCommGrpCat.{u}),
      ∃ (e_pi : (∏ᶜ fun _ : I₁ => k) ≅ (∏ᶜ fun _ : I₂ => k)),
        (∀ (i₂ : I₂), e_pi.hom ≫ CategoryTheory.Limits.Pi.π (fun _ : I₂ => k) i₂ =
          CategoryTheory.Limits.Pi.π (fun _ : I₁ => k) (eqv.symm i₂)) := by
    intro I₁ I₂ eqv k
    refine ⟨{
      hom := CategoryTheory.Limits.Pi.lift
        (fun i₂ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => k) (eqv.symm i₂))
      inv := CategoryTheory.Limits.Pi.lift
        (fun i₁ => CategoryTheory.Limits.Pi.π (fun _ : I₂ => k) (eqv i₁))
      hom_inv_id := by
        apply CategoryTheory.Limits.Pi.hom_ext
        intro i₁
        simp
      inv_hom_id := by
        apply CategoryTheory.Limits.Pi.hom_ext
        intro i₂
        simp },
      fun i₂ => by simp⟩

  have hPiMapComm : ∀ {A₁ A₂ B₁ B₂ : Type u} {k : AddCommGrpCat.{u}}
      (α₁ : A₁ ≃ A₂) (β₁ : B₁ ≃ B₂)
      (mA : B₁ → A₁) (mB : B₂ → A₂)
      (hm : ∀ b₂ : B₂, mA (β₁.symm b₂) = α₁.symm (mB b₂))
      (f₁ : (∏ᶜ fun _ : A₁ => k) ⟶ (∏ᶜ fun _ : A₂ => k))
      (f₂ : (∏ᶜ fun _ : B₁ => k) ⟶ (∏ᶜ fun _ : B₂ => k))
      (hf₁ : ∀ a₂, f₁ ≫ CategoryTheory.Limits.Pi.π _ a₂ =
        CategoryTheory.Limits.Pi.π _ (α₁.symm a₂))
      (hf₂ : ∀ b₂, f₂ ≫ CategoryTheory.Limits.Pi.π _ b₂ =
        CategoryTheory.Limits.Pi.π _ (β₁.symm b₂)),
      CategoryTheory.Limits.Pi.map' mA (fun _ => 𝟙 k) ≫ f₂ =
        f₁ ≫ CategoryTheory.Limits.Pi.map' mB (fun _ => 𝟙 k) := by
    intro A₁ A₂ B₁ B₂ k α₁ β₁ mA mB hm f₁ f₂ hf₁ hf₂
    apply CategoryTheory.Limits.Pi.hom_ext
    intro b₂
    rw [CategoryTheory.Category.assoc, hf₂,
      CategoryTheory.Limits.Pi.map'_comp_π, CategoryTheory.Category.comp_id,
      CategoryTheory.Category.assoc, CategoryTheory.Limits.Pi.map'_comp_π,
      CategoryTheory.Category.comp_id, hf₁, hm b₂]

  have hPiMapValComm : ∀ {A₁ A₂ : Type u} {k₁ k₂ : AddCommGrpCat.{u}}
      (α₁ : A₁ ≃ A₂) (φ : k₁ ⟶ k₂)
      (f₁ : (∏ᶜ fun _ : A₁ => k₁) ⟶ (∏ᶜ fun _ : A₂ => k₁))
      (f₂ : (∏ᶜ fun _ : A₁ => k₂) ⟶ (∏ᶜ fun _ : A₂ => k₂))
      (hf₁ : ∀ a₂, f₁ ≫ CategoryTheory.Limits.Pi.π _ a₂ =
        CategoryTheory.Limits.Pi.π _ (α₁.symm a₂))
      (hf₂ : ∀ a₂, f₂ ≫ CategoryTheory.Limits.Pi.π _ a₂ =
        CategoryTheory.Limits.Pi.π _ (α₁.symm a₂)),
      CategoryTheory.Limits.Pi.map (fun _ : A₁ => φ) ≫ f₂ =
        f₁ ≫ CategoryTheory.Limits.Pi.map (fun _ : A₂ => φ) := by
    intro A₁ A₂ k₁ k₂ α₁ φ f₁ f₂ hf₁ hf₂
    apply CategoryTheory.Limits.Pi.hom_ext
    intro a₂
    rw [CategoryTheory.Category.assoc, hf₂, CategoryTheory.Limits.Pi.map_π,
      CategoryTheory.Category.assoc, CategoryTheory.Limits.Pi.map_π,
      ← CategoryTheory.Category.assoc, hf₁]

  have hPiLiftπ : ∀ {X M : AddCommGrpCat.{u}} {I : Type u}
      (l : I → (X ⟶ M)) (i₀ : I),
      CategoryTheory.Limits.Pi.lift l ≫ CategoryTheory.Limits.Pi.π (fun _ : I => M) i₀ = l i₀ := by
    intro X M I l i₀
    simp

  have hPiLiftNat : ∀ {X M : AddCommGrpCat.{u}} {I₁ I₂ : Type u}
      (g : X ⟶ X) {Y : AddCommGrpCat.{u}} (u_hom : X ⟶ Y)
      (l₁ : I₁ → (X ⟶ M)) (l₂ : I₂ → (Y ⟶ M)) (p : I₂ → I₁)
      (hl : ∀ i₂ : I₂, u_hom ≫ l₂ i₂ = l₁ (p i₂)),
      u_hom ≫ CategoryTheory.Limits.Pi.lift l₂ =
        CategoryTheory.Limits.Pi.lift l₁ ≫ CategoryTheory.Limits.Pi.map' p (fun _ => 𝟙 M) := by
    intro X M I₁ I₂ _ Y u_hom l₁ l₂ p hl
    apply CategoryTheory.Limits.Pi.hom_ext
    intro i₂
    simp [hl i₂]

  have hPiMapπ : ∀ {M : AddCommGrpCat.{u}} {I₁ I₂ : Type u}
      (p : I₂ → I₁) (i₂ : I₂),
      CategoryTheory.Limits.Pi.map' p (fun _ => 𝟙 M) ≫
        CategoryTheory.Limits.Pi.π (fun _ : I₂ => M) i₂ =
        CategoryTheory.Limits.Pi.π (fun _ : I₁ => M) (p i₂) := by
    intro M I₁ I₂ p i₂
    simp

  have hPiUniqIso : ∀ {M : AddCommGrpCat.{u}} {I : Type u} (i₀ : I) (hI : ∀ i : I, i = i₀),
      (𝟙 (∏ᶜ fun _ : I => M) ≫ CategoryTheory.Limits.Pi.π (fun _ : I => M) i₀) ≫
        CategoryTheory.Limits.Pi.lift (fun _ : I => 𝟙 M) = 𝟙 (∏ᶜ fun _ : I => M) ∧
      CategoryTheory.Limits.Pi.lift (fun _ : I => 𝟙 M) ≫
        (𝟙 (∏ᶜ fun _ : I => M) ≫ CategoryTheory.Limits.Pi.π (fun _ : I => M) i₀) = 𝟙 M := by
    intro M I i₀ hI
    refine ⟨?_, by simp⟩
    apply CategoryTheory.Limits.Pi.hom_ext
    intro i
    rw [hI i]
    simp

  have hFibBridge : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (S : AlgebraicGeometry.Scheme.{u})
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S),
      Nonempty ((pt Ω S w).sheafFiber (A := AddCommGrpCat.{u}) ≅
        ((weilEtaleSitePullback w).sheafPullback AddCommGrpCat.{u}
          S.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology) ⋙
          (pt Ω (AlgebraicGeometry.Spec (CommRingCat.of Ω))
            (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)))).sheafFiber
            (A := AddCommGrpCat.{u})) := by
    intro Ω _ _ S w
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let Φ_id := pt Ω S_Ω (𝟙 S_Ω)
    let Φ_w := pt Ω S w
    let B_w : CategoryTheory.Functor S.Etale S_Ω.Etale := weilEtaleSitePullback w
    let pf_w := B_w.sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology S_Ω.smallEtaleTopology
    let pb_w := B_w.sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology S_Ω.smallEtaleTopology
    let adj_w := B_w.sheafAdjunctionContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology S_Ω.smallEtaleTopology
    let eqvFibSch : ∀ {E₀ : AlgebraicGeometry.Scheme.{u}} (e_hom : E₀ ⟶ S),
        { e₁ : S_Ω ⟶ CategoryTheory.Limits.pullback e_hom w //
          e₁ ≫ CategoryTheory.Limits.pullback.snd e_hom w = 𝟙 S_Ω } ≃
        { e₂ : S_Ω ⟶ E₀ // e₂ ≫ e_hom = w } :=
      fun e_hom =>
        { toFun := fun x =>
            ⟨x.1 ≫ CategoryTheory.Limits.pullback.fst e_hom w, by
              rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
                ← CategoryTheory.Category.assoc, x.2, CategoryTheory.Category.id_comp]⟩
          invFun := fun y =>
            ⟨CategoryTheory.Limits.pullback.lift y.1 (𝟙 S_Ω)
              (y.2.trans (CategoryTheory.Category.id_comp w).symm),
              CategoryTheory.Limits.pullback.lift_snd _ _ _⟩
          left_inv := fun x => by
            apply Subtype.ext
            apply CategoryTheory.Limits.pullback.hom_ext
            · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
            · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans x.2.symm
          right_inv := fun _ =>
            Subtype.ext (CategoryTheory.Limits.pullback.lift_fst _ _ _) }
    let eqvFib : ∀ E : S.Etale, Φ_id.fiber.obj (B_w.obj E) ≃ Φ_w.fiber.obj E :=
      fun E => eqvFibSch (show E.left ⟶ S from E.hom)
    let appPreIso : ∀ (k : AddCommGrpCat.{u}) (j : (S.Etale)ᵒᵖ),
        (B_w.op ⋙ (Φ_id.skyscraperSheafFunctor.obj k).obj).obj j ≅
          (Φ_w.skyscraperSheafFunctor.obj k).obj.obj j :=
      fun k j => Classical.choose (hPiReindexIso (eqvFib j.unop) k)
    let preIso : ∀ k : AddCommGrpCat.{u},
        B_w.op ⋙ (Φ_id.skyscraperSheafFunctor.obj k).obj ≅
          (Φ_w.skyscraperSheafFunctor.obj k).obj :=
      fun k =>
        CategoryTheory.NatIso.ofComponents (appPreIso k)
          (fun {j₁ j₂} u => by
            let E₁ := j₁.unop
            let E₂ := j₂.unop
            have heqv_comm : ∀ b₂ : Φ_w.fiber.obj E₂,
                (CategoryTheory.ConcreteCategory.hom
                  (Φ_id.fiber.map (B_w.map u.unop))) ((eqvFib E₂).symm b₂) =
                (eqvFib E₁).symm
                  ((CategoryTheory.ConcreteCategory.hom (Φ_w.fiber.map u.unop)) b₂) := by
              intro b₂
              let e₂ := b₂.1
              have he₂ := b₂.2
              apply Subtype.ext
              let e₁_hom : E₁.left ⟶ S := E₁.hom
              let e₂_hom : E₂.left ⟶ S := E₂.hom
              have hpull_comm : ∀ (u_left : E₂.left ⟶ E₁.left)
                  (hu_w : u_left ≫ e₁_hom = e₂_hom)
                  (h₁ : e₂_hom ≫ 𝟙 S = u_left ≫ e₁_hom) (h₂ : w ≫ 𝟙 S = 𝟙 S_Ω ≫ w),
                  CategoryTheory.Limits.pullback.lift e₂ (𝟙 S_Ω)
                      (he₂.trans (CategoryTheory.Category.id_comp w).symm) ≫
                    CategoryTheory.Limits.pullback.map e₂_hom w e₁_hom w u_left (𝟙 S_Ω) (𝟙 S) h₁ h₂ =
                  CategoryTheory.Limits.pullback.lift (e₂ ≫ u_left) (𝟙 S_Ω)
                    (((CategoryTheory.Category.assoc _ _ _).trans
                      ((congrArg (e₂ ≫ ·) hu_w).trans he₂)).trans
                      (CategoryTheory.Category.id_comp w).symm) := by
                intro u_left hu_w h₁ h₂
                apply CategoryTheory.Limits.pullback.hom_ext
                · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                    CategoryTheory.Limits.pullback.lift_fst_assoc,
                    CategoryTheory.Limits.pullback.lift_fst]
                · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                    CategoryTheory.Limits.pullback.lift_snd_assoc,
                    CategoryTheory.Category.comp_id,
                    CategoryTheory.Limits.pullback.lift_snd]
              exact hpull_comm u.unop.left
                (CategoryTheory.MorphismProperty.Over.w u.unop)
                ((CategoryTheory.Category.comp_id e₂_hom).trans
                  (CategoryTheory.MorphismProperty.Over.w u.unop).symm)
                ((CategoryTheory.Category.comp_id w).trans (CategoryTheory.Category.id_comp w).symm)
            have hcore := hPiMapComm (eqvFib E₁) (eqvFib E₂)
              (CategoryTheory.ConcreteCategory.hom (Φ_id.fiber.map (B_w.map u.unop)))
              (CategoryTheory.ConcreteCategory.hom (Φ_w.fiber.map u.unop))
              heqv_comm _ _
              (Classical.choose_spec (hPiReindexIso (eqvFib E₁) k))
              (Classical.choose_spec (hPiReindexIso (eqvFib E₂) k))
            have hm₁ := Φ_id.skyscraperPresheafFunctor_obj_map k (Opposite.op (B_w.map u.unop))
            have hm₂ := Φ_w.skyscraperPresheafFunctor_obj_map k u
            exact (congrArg (· ≫ (appPreIso k j₂).hom) hm₁).trans
              (hcore.trans (congrArg ((appPreIso k j₁).hom ≫ ·) hm₂.symm)))
    let shIso : ∀ k : AddCommGrpCat.{u},
        (Φ_id.skyscraperSheafFunctor ⋙ pf_w).obj k ≅ Φ_w.skyscraperSheafFunctor.obj k :=
      fun k =>
        { hom := ⟨(preIso k).hom⟩
          inv := ⟨(preIso k).inv⟩
          hom_inv_id := CategoryTheory.InducedCategory.hom_ext (preIso k).hom_inv_id
          inv_hom_id := CategoryTheory.InducedCategory.hom_ext (preIso k).inv_hom_id }
    let e_sky : Φ_id.skyscraperSheafFunctor ⋙ pf_w ≅ Φ_w.skyscraperSheafFunctor :=
      CategoryTheory.NatIso.ofComponents shIso
        (fun {k₁ k₂} φ => by
          apply CategoryTheory.InducedCategory.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext j
          let E := j.unop
          have hcore := hPiMapValComm (eqvFib E) φ _ _
            (Classical.choose_spec (hPiReindexIso (eqvFib E) k₁))
            (Classical.choose_spec (hPiReindexIso (eqvFib E) k₂))
          have hm₁ := Φ_id.skyscraperPresheafFunctor_map_app φ (Opposite.op (B_w.obj E))
          have hm₂ := Φ_w.skyscraperPresheafFunctor_map_app φ j
          exact (congrArg (· ≫ (appPreIso k₂ j).hom) hm₁).trans
            (hcore.trans (congrArg ((appPreIso k₁ j).hom ≫ ·) hm₂.symm)))
    let adj_sky_id := Φ_id.skyscraperSheafAdjunction (A := AddCommGrpCat.{u})
    let adj_sky_w := Φ_w.skyscraperSheafAdjunction (A := AddCommGrpCat.{u})
    exact ⟨CategoryTheory.Adjunction.leftAdjointUniq adj_sky_w
      (CategoryTheory.Adjunction.ofNatIsoRight (adj_w.comp adj_sky_id) e_sky)⟩

  have hFibZeroOfPb : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      {S : AlgebraicGeometry.Scheme.{u}}
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S)
      (M : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.Limits.IsZero
        (((weilEtaleSitePullback w).sheafPullback AddCommGrpCat.{u}
          S.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology).obj M) →
      CategoryTheory.Limits.IsZero
        (((pt Ω S w).sheafFiber (A := AddCommGrpCat.{u})).obj M) := by
    intro Ω _ _ S w M hZ
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let Φ_id := pt Ω S_Ω (𝟙 S_Ω)
    let adj_sky_id := Φ_id.skyscraperSheafAdjunction (A := AddCommGrpCat.{u})
    have _ : (Φ_id.sheafFiber (A := AddCommGrpCat.{u})).IsLeftAdjoint := adj_sky_id.isLeftAdjoint
    obtain ⟨e_fib⟩ := hFibBridge Ω S w
    exact CategoryTheory.Limits.IsZero.of_iso (Φ_id.sheafFiber.map_isZero hZ) (e_fib.app M)

  have hFibIsoOfPb : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      {S : AlgebraicGeometry.Scheme.{u}}
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S)
      {M₁ M₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : M₁ ⟶ M₂),
      CategoryTheory.IsIso
        (((weilEtaleSitePullback w).sheafPullback AddCommGrpCat.{u}
          S.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology).map φ) →
      CategoryTheory.IsIso
        (((pt Ω S w).sheafFiber (A := AddCommGrpCat.{u})).map φ) := by
    intro Ω _ _ S w M₁ M₂ φ hIso
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let Φ_id := pt Ω S_Ω (𝟙 S_Ω)
    let pb_w := (weilEtaleSitePullback w).sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology S_Ω.smallEtaleTopology
    obtain ⟨e_fib⟩ := hFibBridge Ω S w
    have _ : CategoryTheory.IsIso (pb_w.map φ) := hIso
    have _ : CategoryTheory.IsIso ((pb_w ⋙ Φ_id.sheafFiber (A := AddCommGrpCat.{u})).map φ) := by
      change CategoryTheory.IsIso ((Φ_id.sheafFiber (A := AddCommGrpCat.{u})).map (pb_w.map φ))
      infer_instance
    have hmap_eq : ((pt Ω S w).sheafFiber (A := AddCommGrpCat.{u})).map φ =
        e_fib.hom.app M₁ ≫
          (pb_w ⋙ Φ_id.sheafFiber (A := AddCommGrpCat.{u})).map φ ≫
          e_fib.inv.app M₂ := by
      rw [← e_fib.hom.naturality_assoc φ, e_fib.hom_inv_id_app, CategoryTheory.Category.comp_id]
    rw [hmap_eq]
    infer_instance

  have hFibZeroCons : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (H : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S),
        CategoryTheory.Limits.IsZero ((pt Ω S w).sheafFiber.obj H)) →
      CategoryTheory.Limits.IsZero H := by
    intro S H hFibZero
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply CategoryTheory.InducedCategory.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext W
    apply AddCommGrpCat.ext
    intro s
    let E : S.Etale := Opposite.unop W
    let R_s : CategoryTheory.Sieve E :=
      { arrows := fun {_} u => H.obj.map u.op s = 0
        downward_closed := fun {_ _ u} hu v => by
          rw [op_comp, H.obj.map_comp]
          change (H.obj.map v.op) ((H.obj.map u.op) s) = 0
          rw [hu, map_zero] }
    have hRs_mem : R_s ∈ S.smallEtaleTopology E := by
      have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S (le_refl (@AlgebraicGeometry.Etale))
      have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) S
        CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
        inferInstance inferInstance inferInstance inferInstance E R_s
      refine ((iff_of_eq (congrArg (fun K : CategoryTheory.GrothendieckTopology S.Etale =>
        R_s ∈ K E) heq)).trans hiff).mpr ?_
      intro z
      let κ := E.left.residueField z
      let Ω_z := AlgebraicClosure ↥κ
      let e_z : AlgebraicGeometry.Spec (CommRingCat.of Ω_z) ⟶ E.left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥κ Ω_z)) ≫
          E.left.fromSpecResidueField z
      let w_z : AlgebraicGeometry.Spec (CommRingCat.of Ω_z) ⟶ S :=
        e_z ≫ (show E.left ⟶ S from E.hom)
      let Φ_z := pt Ω_z S w_z
      have hZ_fib : CategoryTheory.Limits.IsZero (Φ_z.sheafFiber.obj H) := hFibZero Ω_z w_z
      have hTo0 : Φ_z.toPresheafFiber E ⟨e_z, rfl⟩ H.obj = 0 :=
        hZ_fib.eq_of_tgt _ 0
      have heq_fib : (CategoryTheory.ConcreteCategory.hom
            (Φ_z.toPresheafFiber E ⟨e_z, rfl⟩ H.obj)) s =
          (CategoryTheory.ConcreteCategory.hom
            (Φ_z.toPresheafFiber E ⟨e_z, rfl⟩ H.obj)) 0 := by
        rw [hTo0]
        rfl
      obtain ⟨Y, u, y_fib, hy_fib, hmap_eq⟩ :=
        (Φ_z.toPresheafFiber_eq_iff' E ⟨e_z, rfl⟩ s 0).mp heq_fib
      have hu_s0 : H.obj.map u.op s = 0 := by
        simpa using hmap_eq
      let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω_z)) := default
      have hez_pt : e_z.base pt₀ = z := by
        have hmem : (E.left.fromSpecResidueField z).base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥κ Ω_z))).base pt₀) ∈
            Set.range ⇑(E.left.fromSpecResidueField z) := Set.mem_range_self _
        rwa [E.left.range_fromSpecResidueField z, Set.mem_singleton_iff] at hmem
      have hy_u : y_fib.1 ≫ u.left = e_z := congrArg Subtype.val hy_fib
      have hy_pt : u.left.base (y_fib.1.base pt₀) = z := by
        calc
          u.left.base (y_fib.1.base pt₀) = (y_fib.1 ≫ u.left).base pt₀ := rfl
          _ = e_z.base pt₀ := by rw [hy_u]
          _ = z := hez_pt
      have hu_et : AlgebraicGeometry.Etale u.left :=
        CategoryTheory.MorphismProperty.of_postcomp (W' := @AlgebraicGeometry.Etale)
          (@AlgebraicGeometry.Etale) u.left E.hom E.prop
          ((CategoryTheory.MorphismProperty.Over.w u).symm ▸ Y.prop)
      exact ⟨Y, u, y_fib.1.base pt₀, hu_s0, hu_et, hy_pt⟩
    obtain ⟨hLim⟩ := (CategoryTheory.Presheaf.isSheaf_iff_isLimit _ _).mp H.2 R_s hRs_mem
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let g₁ : Aℤ ⟶ H.obj.obj W := AddCommGrpCat.ofHom
      { toFun := fun n => n.down • s
        map_zero' := zero_zsmul s
        map_add' := fun a b => add_zsmul s a.down b.down }
    have hg₁ : g₁ = 0 := hLim.hom_ext (fun j => by
      refine (?_ : g₁ ≫ (H.obj.mapCone R_s.arrows.cocone.op).π.app j = 0).trans
        (CategoryTheory.Limits.zero_comp (f := (H.obj.mapCone R_s.arrows.cocone.op).π.app j)).symm
      apply AddCommGrpCat.ext
      intro n
      change (H.obj.map j.unop.obj.hom.op).hom (n.down • s) = 0
      exact (map_zsmul (H.obj.map j.unop.obj.hom.op).hom n.down s).trans
        ((congrArg (n.down • ·) j.unop.property).trans (zsmul_zero n.down)))
    have h1 := CategoryTheory.ConcreteCategory.congr_hom hg₁ (ULift.up (1 : ℤ))
    simpa [g₁] using h1

  have hConstEndFinite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (A : AddCommGrpCat.{u}),
      Finite A →
      Finite (((CategoryTheory.constantSheaf
        (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology
        AddCommGrpCat.{u}).obj A) ⟶
        ((CategoryTheory.constantSheaf
          (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology
          AddCommGrpCat.{u}).obj A)) := by
    intro Ω _ _ A hFinA
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let T_Ω := etaleIdTerm S_Ω
    have hT_Ω := etaleIdTermIsTerm S_Ω
    let C_Ω := CategoryTheory.constantSheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}
    let Γ_Ω := (CategoryTheory.sheafSections S_Ω.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T_Ω)
    let adj_const := CategoryTheory.constantSheafAdj S_Ω.smallEtaleTopology AddCommGrpCat.{u} hT_Ω
    let Φ_Ω := pt Ω S_Ω (𝟙 S_Ω)
    let t₀ : Φ_Ω.fiber.obj T_Ω := ⟨𝟙 S_Ω, CategoryTheory.Category.comp_id _⟩
    have ht₀_uniq : ∀ t : Φ_Ω.fiber.obj T_Ω, t = t₀ := by
      intro t
      apply Subtype.ext
      exact (CategoryTheory.Category.comp_id t.1).symm.trans t.2
    let morOf : ∀ (E : S_Ω.Etale), Φ_Ω.fiber.obj E → (T_Ω ⟶ E) :=
      fun E t => CategoryTheory.MorphismProperty.Over.homMk t.1 t.2 trivial
    have hmor_t₀ : morOf T_Ω t₀ = 𝟙 T_Ω :=
      CategoryTheory.MorphismProperty.Over.Hom.ext rfl
    have hfib_mor : ∀ (E : S_Ω.Etale) (t : Φ_Ω.fiber.obj E),
        (CategoryTheory.ConcreteCategory.hom (Φ_Ω.fiber.map (morOf E t))) t₀ = t :=
      fun _ t => Subtype.ext (CategoryTheory.Category.id_comp t.1)
    let fromSky : ∀ (𝒢 : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u})
        (M : AddCommGrpCat.{u}),
        (𝒢 ⟶ Φ_Ω.skyscraperSheafFunctor.obj M) → (Γ_Ω.obj 𝒢 ⟶ M) :=
      fun 𝒢 M α =>
        α.hom.app (Opposite.op T_Ω) ≫
          CategoryTheory.Limits.Pi.π (fun _ : Φ_Ω.fiber.obj T_Ω => M) t₀
    let toSky : ∀ (𝒢 : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u})
        (M : AddCommGrpCat.{u}),
        (Γ_Ω.obj 𝒢 ⟶ M) → (𝒢 ⟶ Φ_Ω.skyscraperSheafFunctor.obj M) :=
      fun 𝒢 M f =>
        { hom :=
            { app := fun W =>
                CategoryTheory.Limits.Pi.lift
                  (fun t : Φ_Ω.fiber.obj W.unop => 𝒢.obj.map (morOf W.unop t).op ≫ f)
              naturality := fun {W₁ W₂} u => by
                have hmap := Φ_Ω.skyscraperPresheafFunctor_obj_map M u
                have hmor_comp : ∀ t₂ : Φ_Ω.fiber.obj W₂.unop,
                    (morOf W₁.unop
                      ((CategoryTheory.ConcreteCategory.hom (Φ_Ω.fiber.map u.unop)) t₂)).op =
                      u ≫ (morOf W₂.unop t₂).op := by
                  intro t₂
                  have h1 : morOf W₁.unop
                      ((CategoryTheory.ConcreteCategory.hom (Φ_Ω.fiber.map u.unop)) t₂) =
                      morOf W₂.unop t₂ ≫ u.unop :=
                    CategoryTheory.MorphismProperty.Over.Hom.ext rfl
                  exact (congrArg Quiver.Hom.op h1).trans
                    (op_comp.trans
                      (congrArg (· ≫ (morOf W₂.unop t₂).op) (Quiver.Hom.op_unop u)))
                have hcore := hPiLiftNat (𝟙 (𝒢.obj.obj W₁)) (𝒢.obj.map u)
                  (fun t => 𝒢.obj.map (morOf W₁.unop t).op ≫ f)
                  (fun t₂ => 𝒢.obj.map (morOf W₂.unop t₂).op ≫ f)
                  (CategoryTheory.ConcreteCategory.hom (Φ_Ω.fiber.map u.unop))
                  (fun t₂ =>
                    (CategoryTheory.Category.assoc _ _ _).symm.trans
                      ((congrArg (· ≫ f) (𝒢.obj.map_comp u (morOf W₂.unop t₂).op).symm).trans
                        (congrArg (fun m => 𝒢.obj.map m ≫ f) (hmor_comp t₂).symm)))
                exact hcore.trans (congrArg _ hmap.symm) } }
    have hFromTo : ∀ 𝒢 M (f : Γ_Ω.obj 𝒢 ⟶ M), fromSky 𝒢 M (toSky 𝒢 M f) = f := by
      intro 𝒢 M f
      exact (hPiLiftπ (fun t : Φ_Ω.fiber.obj T_Ω => 𝒢.obj.map (morOf T_Ω t).op ≫ f) t₀).trans
        ((congrArg (fun m => 𝒢.obj.map m.op ≫ f) hmor_t₀).trans
          ((congrArg (· ≫ f) (𝒢.obj.map_id (Opposite.op T_Ω))).trans
            (CategoryTheory.Category.id_comp f)))
    have hToFrom : ∀ 𝒢 M (α : 𝒢 ⟶ Φ_Ω.skyscraperSheafFunctor.obj M),
        toSky 𝒢 M (fromSky 𝒢 M α) = α := by
      intro 𝒢 M α
      apply CategoryTheory.InducedCategory.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext W
      apply CategoryTheory.Limits.Pi.hom_ext
      intro t
      have h1 := hPiLiftπ
        (fun t' : Φ_Ω.fiber.obj W.unop =>
          𝒢.obj.map (morOf W.unop t').op ≫ fromSky 𝒢 M α) t
      have hnat := α.hom.naturality (morOf W.unop t).op
      have hmap := Φ_Ω.skyscraperPresheafFunctor_obj_map M (morOf W.unop t).op
      have hπ := hPiMapπ (M := M)
        (CategoryTheory.ConcreteCategory.hom (Φ_Ω.fiber.map (morOf W.unop t))) t₀
      exact h1.trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ CategoryTheory.Limits.Pi.π _ t₀) hnat).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (α.hom.app W ≫ ·)
                ((congrArg (· ≫ CategoryTheory.Limits.Pi.π _ t₀) hmap).trans
                  (hπ.trans
                    (congrArg (CategoryTheory.Limits.Pi.π (fun _ : Φ_Ω.fiber.obj W.unop => M))
                      (hfib_mor W.unop t)))))))))
    let counitSky : ∀ M : AddCommGrpCat.{u}, Γ_Ω.obj (Φ_Ω.skyscraperSheafFunctor.obj M) ≅ M :=
      fun M =>
        { hom := fromSky (Φ_Ω.skyscraperSheafFunctor.obj M) M (𝟙 _)
          inv := CategoryTheory.Limits.Pi.lift (fun _ : Φ_Ω.fiber.obj T_Ω => 𝟙 M)
          hom_inv_id := (hPiUniqIso t₀ ht₀_uniq).1
          inv_hom_id := (hPiUniqIso t₀ ht₀_uniq).2 }
    let Ψ : ∀ M : AddCommGrpCat.{u}, (Γ_Ω.obj (C_Ω.obj A) ⟶ M) ≃ (A ⟶ M) :=
      fun M =>
        ((Equiv.mk (toSky (C_Ω.obj A) M) (fromSky (C_Ω.obj A) M)
            (hFromTo (C_Ω.obj A) M) (hToFrom (C_Ω.obj A) M)).trans
          (adj_const.homEquiv A (Φ_Ω.skyscraperSheafFunctor.obj M))).trans
          (CategoryTheory.Iso.homCongr (CategoryTheory.Iso.refl A) (counitSky M))
    have hΨ : ∀ {M : AddCommGrpCat.{u}} (g : Γ_Ω.obj (C_Ω.obj A) ⟶ M),
        Ψ M g = adj_const.unit.app A ≫ g := by
      intro M g
      dsimp [Ψ, CategoryTheory.Iso.homCongr, counitSky]
      refine (congrArg (· ≫ fromSky _ M (𝟙 _))
        (CategoryTheory.Adjunction.homEquiv_unit adj_const A _ (toSky (C_Ω.obj A) M g))).trans ?_
      refine (CategoryTheory.Category.assoc _ _ _).trans ?_
      have hfrom_eq : Γ_Ω.map (toSky (C_Ω.obj A) M g) ≫
          fromSky (Φ_Ω.skyscraperSheafFunctor.obj M) M (𝟙 _) =
          fromSky (C_Ω.obj A) M (toSky (C_Ω.obj A) M g) :=
        (CategoryTheory.Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ _) (CategoryTheory.Category.comp_id _))
      exact congrArg (adj_const.unit.app A ≫ ·) (hfrom_eq.trans (hFromTo (C_Ω.obj A) M g))
    let r_A : Γ_Ω.obj (C_Ω.obj A) ⟶ A := (Ψ A).symm (𝟙 A)
    have hr₁ : adj_const.unit.app A ≫ r_A = 𝟙 A :=
      (hΨ r_A).symm.trans ((Ψ A).apply_symm_apply (𝟙 A))
    have hr₂ : r_A ≫ adj_const.unit.app A = 𝟙 (Γ_Ω.obj (C_Ω.obj A)) := by
      apply (Ψ (Γ_Ω.obj (C_Ω.obj A))).injective
      refine (hΨ _).trans ((CategoryTheory.Category.assoc _ _ _).symm.trans ?_)
      refine (congrArg (· ≫ adj_const.unit.app A) hr₁).trans ?_
      exact ((CategoryTheory.Category.id_comp _).trans
        (CategoryTheory.Category.comp_id _).symm).trans (hΨ _).symm
    let isoUnitA : A ≅ Γ_Ω.obj (C_Ω.obj A) := ⟨adj_const.unit.app A, r_A, hr₁, hr₂⟩
    let eqvEnd : (C_Ω.obj A ⟶ C_Ω.obj A) ≃ (A ⟶ A) :=
      (adj_const.homEquiv A (C_Ω.obj A)).trans
        (CategoryTheory.Iso.homCongr (CategoryTheory.Iso.refl A) isoUnitA.symm)
    have hFinAA : Finite (A ⟶ A) :=
      Finite.of_injective (fun f : A ⟶ A => (f : ↑A → ↑A))
        (fun f₁ f₂ h => AddCommGrpCat.ext (congrFun h))
    exact Finite.of_equiv (A ⟶ A) eqvEnd.symm

  have hDir0Iso : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S)
      (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      Nonempty (weilEtaleHigherDirectImage f 0 F ≅
        ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
          S.smallEtaleTopology X.smallEtaleTopology).obj F) := by
    intro X S f F
    let J_X := X.smallEtaleTopology
    let Z_pre : X.Etale ⥤ (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
      CategoryTheory.yoneda ⋙
        (CategoryTheory.Functor.whiskeringRight (X.Etale)ᵒᵖ (Type u) AddCommGrpCat.{u}).obj
          AddCommGrpCat.free
    let Z_sh : X.Etale ⥤ CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
      Z_pre ⋙ CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
    let adj_sh := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
    let adj_free := AddCommGrpCat.adj.whiskerRight (X.Etale)ᵒᵖ
    let eqvW : ∀ W : (X.Etale)ᵒᵖ, ↑((F.cohomologyPresheaf 0).obj W) ≃ ↑(F.obj.obj W) :=
      fun W =>
        (((CategoryTheory.Abelian.Ext.addEquiv₀ (X := Z_sh.obj W.unop) (Y := F)).toEquiv.trans
          (adj_sh.homEquiv (Z_pre.obj W.unop) F)).trans
          (adj_free.homEquiv (CategoryTheory.yoneda.obj W.unop) F.obj)).trans
          CategoryTheory.yonedaEquiv
    have hAddW : ∀ (W : (X.Etale)ᵒᵖ) (x y : ↑((F.cohomologyPresheaf 0).obj W)),
        eqvW W (x + y) = eqvW W x + eqvW W y := by
      intro W x y
      let e₁ : CategoryTheory.Abelian.Ext (Z_sh.obj W.unop) F 0 ≃+ (Z_sh.obj W.unop ⟶ F) :=
        CategoryTheory.Abelian.Ext.addEquiv₀
      have he₁ : e₁ (x + y) = e₁ x + e₁ y := e₁.map_add x y
      have hsh_add : ∀ a b : Z_sh.obj W.unop ⟶ F,
          (adj_sh.homEquiv (Z_pre.obj W.unop) F) (a + b) =
            (adj_sh.homEquiv (Z_pre.obj W.unop) F) a +
              (adj_sh.homEquiv (Z_pre.obj W.unop) F) b :=
        fun a b =>
          (CategoryTheory.Adjunction.homEquiv_unit adj_sh _ _ (a + b)).trans
            ((CategoryTheory.Preadditive.comp_add _ _ _
              (adj_sh.unit.app (Z_pre.obj W.unop)) a.hom b.hom).trans
              (congrArg₂ (· + ·)
                (CategoryTheory.Adjunction.homEquiv_unit adj_sh _ _ a).symm
                (CategoryTheory.Adjunction.homEquiv_unit adj_sh _ _ b).symm))
      exact (congrArg (fun z => CategoryTheory.yonedaEquiv
        ((adj_free.homEquiv (CategoryTheory.yoneda.obj W.unop) F.obj)
          ((adj_sh.homEquiv (Z_pre.obj W.unop) F) z))) he₁).trans
        (congrArg (fun ψ => CategoryTheory.yonedaEquiv
          ((adj_free.homEquiv (CategoryTheory.yoneda.obj W.unop) F.obj) ψ))
          (hsh_add (e₁ x) (e₁ y)))
    let isoCohW : ∀ W : (X.Etale)ᵒᵖ, (F.cohomologyPresheaf 0).obj W ≅ F.obj.obj W :=
      fun W =>
        let e_add := AddEquiv.mk' (eqvW W) (hAddW W)
        { hom := AddCommGrpCat.ofHom e_add.toAddMonoidHom
          inv := AddCommGrpCat.ofHom e_add.symm.toAddMonoidHom
          hom_inv_id := by ext z; exact e_add.symm_apply_apply z
          inv_hom_id := by ext z; exact e_add.apply_symm_apply z }
    let e_coh0 : F.cohomologyPresheaf 0 ≅ F.obj :=
      CategoryTheory.NatIso.ofComponents isoCohW
        (fun {W₁ W₂} ω => by
          have hmap_coh := CategoryTheory.Abelian.extFunctor_map_app 0 (Z_sh.op.map ω) F
          have hmap_eq : (F.cohomologyPresheaf 0).map ω =
              ((CategoryTheory.Abelian.extFunctor 0).map (Z_sh.op.map ω)).app F := rfl
          apply AddCommGrpCat.ext
          intro x
          have hlhs : ((F.cohomologyPresheaf 0).map ω ≫ (isoCohW W₂).hom) x =
              eqvW W₂ ((CategoryTheory.Abelian.Ext.mk₀ (Z_sh.map ω.unop)).comp x
                (Nat.zero_add 0)) := by
            change (isoCohW W₂).hom (((F.cohomologyPresheaf 0).map ω) x) = _
            rw [hmap_eq, hmap_coh]
            rfl
          refine hlhs.trans ?_
          let e₁_₁ : CategoryTheory.Abelian.Ext (Z_sh.obj W₁.unop) F 0 ≃+
              (Z_sh.obj W₁.unop ⟶ F) :=
            CategoryTheory.Abelian.Ext.addEquiv₀
          let e₁_₂ : CategoryTheory.Abelian.Ext (Z_sh.obj W₂.unop) F 0 ≃+
              (Z_sh.obj W₂.unop ⟶ F) :=
            CategoryTheory.Abelian.Ext.addEquiv₀
          have hcomp_mk0 : e₁_₂ ((CategoryTheory.Abelian.Ext.mk₀ (Z_sh.map ω.unop)).comp x
              (Nat.zero_add 0)) = Z_sh.map ω.unop ≫ e₁_₁ x := by
            have hx_eq : x = e₁_₁.symm (e₁_₁ x) := (e₁_₁.symm_apply_apply x).symm
            have hstep1 : (CategoryTheory.Abelian.Ext.mk₀ (Z_sh.map ω.unop)).comp x
                (Nat.zero_add 0) = e₁_₂.symm (Z_sh.map ω.unop ≫ e₁_₁ x) := by
              refine (congrArg (fun t =>
                (CategoryTheory.Abelian.Ext.mk₀ (Z_sh.map ω.unop)).comp t
                  (Nat.zero_add 0)) hx_eq).trans ?_
              exact (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (Z_sh.map ω.unop) (e₁_₁ x)).trans
                (CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply _).symm
            exact (congrArg e₁_₂ hstep1).trans (e₁_₂.apply_symm_apply _)
          let ψ₁ := (adj_sh.homEquiv (Z_pre.obj W₁.unop) F) (e₁_₁ x)
          have hsh_nat : (adj_sh.homEquiv (Z_pre.obj W₂.unop) F)
              ((CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}).map (Z_pre.map ω.unop) ≫
                e₁_₁ x) =
              Z_pre.map ω.unop ≫ ψ₁ :=
            adj_sh.homEquiv_naturality_left (Z_pre.map ω.unop) (e₁_₁ x)
          have hfree_nat : (adj_free.homEquiv (CategoryTheory.yoneda.obj W₂.unop) F.obj)
              (Z_pre.map ω.unop ≫ ψ₁) =
              CategoryTheory.yoneda.map ω.unop ≫
                (adj_free.homEquiv (CategoryTheory.yoneda.obj W₁.unop) F.obj) ψ₁ :=
            adj_free.homEquiv_naturality_left (CategoryTheory.yoneda.map ω.unop) ψ₁
          exact (congrArg (fun z => CategoryTheory.yonedaEquiv
            ((adj_free.homEquiv (CategoryTheory.yoneda.obj W₂.unop) F.obj)
              ((adj_sh.homEquiv (Z_pre.obj W₂.unop) F) z))) hcomp_mk0).trans
            ((congrArg (fun ψ => CategoryTheory.yonedaEquiv
              ((adj_free.homEquiv (CategoryTheory.yoneda.obj W₂.unop) F.obj) ψ)) hsh_nat).trans
              ((congrArg CategoryTheory.yonedaEquiv hfree_nat).trans
                (CategoryTheory.yonedaEquiv_naturality'
                  ((adj_free.homEquiv (CategoryTheory.yoneda.obj W₁.unop) F.obj) ψ₁) ω).symm)))
    let B_f : CategoryTheory.Functor S.Etale X.Etale := weilEtaleSitePullback f
    let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology X.smallEtaleTopology
    let e_whisk : B_f.op ⋙ F.cohomologyPresheaf 0 ≅ (pf_f.obj F).obj :=
      CategoryTheory.NatIso.ofComponents
        (fun U => e_coh0.app (Opposite.op (B_f.obj U.unop)))
        (fun {U₁ U₂} v => e_coh0.hom.naturality (Opposite.op (B_f.map v.unop)))
    let adj_S := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
    have hCounitIsoS : CategoryTheory.IsIso adj_S.counit :=
      CategoryTheory.Adjunction.counit_isIso_of_R_fully_faithful adj_S
    have hAppIsoS : CategoryTheory.IsIso (adj_S.counit.app (pf_f.obj F)) :=
      @CategoryTheory.NatIso.isIso_app_of_isIso _ _ _ _ _ _ adj_S.counit hCounitIsoS (pf_f.obj F)
    exact ⟨((CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).mapIso e_whisk).trans
      (@CategoryTheory.asIso _ _ _ _ (adj_S.counit.app (pf_f.obj F)) hAppIsoS)⟩

  have hLiftClosedPt : ∀ (Ω : Type u) [Field Ω]
      {W X : AlgebraicGeometry.Scheme.{u}} (ι : W ⟶ X) [AlgebraicGeometry.IsClosedImmersion ι]
      (g : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X),
      Set.range g.base ⊆ Set.range ι.base →
      ∃ (g' : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W), g' ≫ ι = g := by
    intro Ω _ W X ι _ g hsub
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    have _ : AlgebraicGeometry.QuasiCompact g :=
      AlgebraicGeometry.QuasiCompact.mk (fun U _ _ => (Set.toFinite (g.base ⁻¹' U)).isCompact)
    have hsupp_le : g.ker.support ≤ ι.ker.support := by
      change (g.ker.support : Set ↥X) ⊆ (ι.ker.support : Set ↥X)
      rw [AlgebraicGeometry.Scheme.Hom.support_ker g,
        AlgebraicGeometry.Scheme.Hom.support_ker ι]
      exact closure_mono hsub
    have hker_le_rad : ι.ker ≤ g.ker.radical := by
      rw [← AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support]
      exact AlgebraicGeometry.Scheme.IdealSheafData.le_support_iff_le_vanishingIdeal.mp hsupp_le
    have hrad_le_ker : g.ker.radical ≤ g.ker := by
      intro U x hx
      rw [AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal] at hx
      rw [AlgebraicGeometry.Scheme.Hom.ker_apply] at hx ⊢
      obtain ⟨n, hn⟩ := hx
      change (CommRingCat.Hom.hom (g.app ↑U)) x = 0
      have hpow0 : ((CommRingCat.Hom.hom (g.app ↑U)) x) ^ n = 0 := by
        rw [← map_pow]
        exact hn
      have _ : AlgebraicGeometry.IsReduced S_Ω := inferInstance
      exact IsReduced.eq_zero _ ⟨n, hpow0⟩
    have hker_le : ι.ker ≤ g.ker := le_trans hker_le_rad hrad_le_ker
    exact ⟨AlgebraicGeometry.IsClosedImmersion.lift ι g hker_le,
      AlgebraicGeometry.IsClosedImmersion.lift_fac ι g hker_le⟩

  have hConstrFin : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (ℬ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsConstructibleModPrimeSheaf ℓ X ℬ →
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s_x : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X),
        ∃ (A : AddCommGrpCat.{u}),
          Finite A ∧
          Nonempty
            ((((weilEtaleSitePullback s_x).sheafPullback AddCommGrpCat.{u}
                X.smallEtaleTopology
                (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology).obj ℬ) ≅
              (CategoryTheory.constantSheaf
                (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology
                AddCommGrpCat.{u}).obj A) := by
    intro X ℬ hℬ Ω _ _ s_x
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let pt₀ : ↥S_Ω := default
    let x₀ : ↥X := s_x.base pt₀
    let C₀ : TopologicalSpace.Closeds ↥X := ⟨closure ({x₀} : Set ↥X), isClosed_closure⟩
    let I₀ := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C₀
    let Z₀ := I₀.subscheme
    let i₀ : Z₀ ⟶ X := I₀.subschemeι
    have hRange₀ : Set.range ⇑i₀.base = closure ({x₀} : Set ↥X) := by
      change Set.range ⇑I₀.subschemeι = ↑C₀
      rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
        AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
    have hI₀_rad : I₀.radical = I₀ :=
      (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support (I := I₀)).symm.trans
        (congrArg AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal
          (SetLike.coe_injective (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal C₀)))
    have hRedZ₀ : AlgebraicGeometry.IsReduced Z₀ := by
      have _ : ∀ (U : I₀.subschemeCover.openCover.I₀),
          AlgebraicGeometry.IsReduced (I₀.subschemeCover.openCover.X U) := by
        intro U
        change AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (CommRingCat.of
            (↑(X.presheaf.obj (Opposite.op U.1)) ⧸ I₀.ideal U)))
        have hRadU : (I₀.ideal U).IsRadical := by
          have h1 : I₀.ideal U = (I₀.ideal U).radical :=
            (congrArg (fun J => J.ideal U) hI₀_rad.symm).trans
              (AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal I₀ U)
          exact h1.symm ▸ Ideal.radical_isRadical (I₀.ideal U)
        have _ : _root_.IsReduced (↑(X.presheaf.obj (Opposite.op U.1)) ⧸ I₀.ideal U) :=
          (Ideal.isRadical_iff_quotient_reduced (I₀.ideal U)).mp hRadU
        infer_instance
      exact AlgebraicGeometry.IsReduced.of_openCover Z₀ I₀.subschemeCover.openCover
    have hIrrC₀ : IsIrreducible (closure ({x₀} : Set ↥X)) := isIrreducible_singleton.closure
    have hIrrZ₀ : IrreducibleSpace ↥Z₀ :=
      { isPreirreducible_univ := by
          intro u v hu hv ⟨z₁, _, hz₁u⟩ ⟨z₂, _, hz₂v⟩
          obtain ⟨U₁, hU₁, rfl⟩ :=
            i₀.isClosedEmbedding.isEmbedding.isInducing.isOpen_iff.mp hu
          obtain ⟨U₂, hU₂, rfl⟩ :=
            i₀.isClosedEmbedding.isEmbedding.isInducing.isOpen_iff.mp hv
          have hz₁_mem : i₀.base z₁ ∈ closure ({x₀} : Set ↥X) := hRange₀ ▸ ⟨z₁, rfl⟩
          have hz₂_mem : i₀.base z₂ ∈ closure ({x₀} : Set ↥X) := hRange₀ ▸ ⟨z₂, rfl⟩
          obtain ⟨y, hyC, hyU₁, hyU₂⟩ := hIrrC₀.2 U₁ U₂ hU₁ hU₂
            ⟨i₀.base z₁, hz₁_mem, hz₁u⟩ ⟨i₀.base z₂, hz₂_mem, hz₂v⟩
          obtain ⟨z, rfl⟩ := hRange₀.symm ▸ hyC
          exact ⟨z, Set.mem_univ z, hyU₁, hyU₂⟩
        toNonempty := by
          obtain ⟨z₀, _⟩ := hRange₀.symm ▸ subset_closure (Set.mem_singleton x₀)
          exact ⟨z₀⟩ }
    have hIntZ₀ : AlgebraicGeometry.IsIntegral Z₀ :=
      @AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Z₀ hRedZ₀ hIrrZ₀
    have hsx_sub : Set.range s_x.base ⊆ Set.range i₀.base := by
      rw [hRange₀]
      rintro _ ⟨q, rfl⟩
      rw [Subsingleton.elim q pt₀]
      exact subset_closure (Set.mem_singleton x₀)
    obtain ⟨s_z, hsz_fac⟩ := hLiftClosedPt Ω i₀ s_x hsx_sub
