          have hdq1 : diff (q + 1) = eqToHom (if_pos (by omega)) ≫ diff_raw (q + 1) ≫
              eqToHom (if_pos (by omega)).symm := dif_pos (by omega)
          rw [hdq, hdq1]
          obtain ⟨h', hEx'⟩ := hExEqToHom
            (congrArg (fun H : 𝒜 ⥤ 𝒜 => H.obj F) (if_pos (by omega : q < m₀ + 2)))
            (congrArg (fun H : 𝒜 ⥤ 𝒜 => H.obj F) (if_pos (by omega : q + 1 < m₀ + 2)))
            (congrArg (fun H : 𝒜 ⥤ 𝒜 => H.obj F) (if_pos (by omega : q + 2 < m₀ + 2)))
            ((diff_raw q).app F) ((diff_raw (q + 1)).app F) hq_raw hExq_raw
          exact ⟨by simpa using h', by simpa using hEx'⟩
        · by_cases heq0 : q = m₀
          · subst heq0
            have hdq : diff m₀ = eqToHom (if_pos (by omega)) ≫ diff_raw m₀ ≫
                eqToHom (if_pos (by omega)).symm := dif_pos (by omega)
            have hdq1 : diff (m₀ + 1) = eqToHom (if_pos (by omega)) ≫ πTopNat ≫
                eqToHom (by dsimp [𝒯]; rw [if_neg (by omega), if_pos rfl]) := by
              simp [diff]
            rw [hdq, hdq1]
            have htop_eq : (by dsimp [𝒯]; rw [if_neg (by omega), if_pos rfl] :
                CokTop = 𝒯 (m₀ + 2)) =
                (by dsimp [𝒯]; rw [if_neg (by omega), if_pos rfl] :
                  𝒯 (m₀ + 2) = CokTop).symm := rfl
            obtain ⟨h', hEx'⟩ := hExEqToHom
              (congrArg (fun H : 𝒜 ⥤ 𝒜 => H.obj F) (if_pos (by omega : m₀ < m₀ + 2)))
              (congrArg (fun H : 𝒜 ⥤ 𝒜 => H.obj F) (if_pos (by omega : m₀ + 1 < m₀ + 2)))
              (congrArg (fun H : 𝒜 ⥤ 𝒜 => H.obj F)
                (by dsimp [𝒯]; rw [if_neg (by omega), if_pos rfl] : 𝒯 (m₀ + 2) = CokTop))
              ((diff_raw m₀).app F) (πTopNat.app F)
              (Limits.cokernel.condition _) (ShortComplex.exact_cokernel _)
            exact ⟨by simpa using h', by simpa using hEx'⟩
          · by_cases heq1 : q = m₀ + 1
            · subst heq1
              have hdq : diff (m₀ + 1) = eqToHom (if_pos (by omega)) ≫ πTopNat ≫
                  eqToHom (by dsimp [𝒯]; rw [if_neg (by omega), if_pos rfl]) := by
                simp [diff]
              have hdq1 : (diff (m₀ + 2)).app F = 0 := by
                dsimp [diff]
                rw [dif_neg (by omega), dif_neg (by omega)]
              refine ⟨by rw [hdq1, Limits.comp_zero], ?_⟩
              rw [ShortComplex.exact_iff_epi _ hdq1, hdq]
              let e_l := (eqToHom (if_pos (by omega : m₀ + 1 < m₀ + 2)) :
                𝒯 (m₀ + 1) ⟶ 𝒯_raw (m₀ + 1)).app F
              let e_r := (eqToHom (by dsimp [𝒯]; rw [if_neg (by omega), if_pos rfl] :
                CokTop = 𝒯 (m₀ + 2))).app F
              have : Epi (Limits.cokernel.π ((diff_raw m₀).app F) ≫ e_r) :=
                epi_comp (Limits.cokernel.π ((diff_raw m₀).app F)) e_r
              exact epi_comp e_l (Limits.cokernel.π ((diff_raw m₀).app F) ≫ e_r)
            · have hgt : m₀ + 2 < q + 1 := by omega
              have hX₂ : (𝒯 (q + 1)).obj F = Z₀ := by
                dsimp [𝒯]
                rw [if_neg (by omega), if_neg (by omega)]
                rfl
              have hdq1 : (diff (q + 1)).app F = 0 := by
                dsimp [diff]
                rw [dif_neg (by omega), dif_neg (by omega)]
              refine ⟨by rw [hdq1, Limits.comp_zero], ?_⟩
              apply ShortComplex.exact_of_isZero_X₂
              dsimp
              rw [hX₂]
              exact hZ₀
      · intro q k hk F
        dsimp [𝒯]
        split_ifs with h₁ h₂
        · exact hRawAcyc q k hk F
        · exact hCokAcyc k hk F
        · exact hZeroExt k
  
  
  
  have hPillar4 : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒜]
      [CategoryTheory.Abelian 𝒜] [CategoryTheory.IsGrothendieckAbelian.{u} 𝒜]
      (oneA : 𝒜) (Γ : CategoryTheory.Functor 𝒜 (ModuleCat.{u, u} R))
      [Γ.Additive] [CategoryTheory.Limits.PreservesFiniteLimits Γ]
      [CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u} Γ],
      (∀ {E : 𝒜} (y : ↑(Γ.obj E)),
        ∃ u_E : oneA ⟶ E, ∀ {B : 𝒜} (g : B ⟶ E) (u_B : oneA ⟶ B),
          u_B ≫ g = u_E → ∃ x : ↑(Γ.obj B), (Γ.map g).hom x = y) →
      ∀ (T : CategoryTheory.Functor 𝒜 𝒜)
        [T.Additive] [CategoryTheory.Limits.PreservesFiniteLimits T]
        [CategoryTheory.Limits.PreservesFiniteColimits T]
        [CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u} T],
        (∀ F : 𝒜, Subsingleton (CategoryTheory.Abelian.Ext.{u} oneA (T.obj F) 1)) →
        CategoryTheory.Limits.PreservesFiniteLimits (T ⋙ Γ) ∧
        CategoryTheory.Limits.PreservesFiniteColimits (T ⋙ Γ) ∧
        CategoryTheory.Limits.PreservesColimitsOfSize.{u, u} (T ⋙ Γ) := by
    intro 𝒜 _ _ _ oneA Γ _ _ _ hSecLift T _ _ _ _ hAcyc₁
    let C : 𝒜 ⥤ ModuleCat.{u, u} R := T ⋙ Γ
    have hShortEx : ∀ (S_ex : ShortComplex 𝒜), S_ex.ShortExact → (S_ex.map C).ShortExact := by
      intro S_ex hS
      have hST : (S_ex.map T).ShortExact := hS.map_of_exact T
      let S_T := S_ex.map T
      have : Mono S_T.f := hST.mono_f
      have : Mono (Γ.map S_T.f) := Γ.map_mono S_T.f
      have hEpi_g : Epi (Γ.map S_T.g) := by
        rw [ModuleCat.epi_iff_surjective]
        intro y
        obtain ⟨u_E, hu_E⟩ := hSecLift y
        let x₃ : Abelian.Ext.{u} oneA S_T.X₃ 0 := Abelian.Ext.mk₀ u_E
        have hSub₁ : Subsingleton (Abelian.Ext.{u} oneA S_T.X₁ 1) := hAcyc₁ S_ex.X₁
        have hcomp0 : x₃.comp hST.extClass (Nat.zero_add 1) = 0 := Subsingleton.elim _ 0
        obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ oneA hST x₃ (Nat.zero_add 1) hcomp0
        let u_B : oneA ⟶ S_T.X₂ := Abelian.Ext.addEquiv₀ x₂
        have hu_B : u_B ≫ S_T.g = u_E := by
          apply (Abelian.Ext.mk₀_bijective oneA S_T.X₃).1
          rw [← Abelian.Ext.mk₀_comp_mk₀ u_B S_T.g, Abelian.Ext.mk₀_addEquiv₀_apply]
          exact hx₂
        exact hu_E S_T.g u_B hu_B
      have hKer_f : Limits.IsLimit (Limits.KernelFork.ofι S_T.f S_T.zero) := hST.exact.fIsKernel
      have hKer_Γf : Limits.IsLimit (Limits.KernelFork.ofι (Γ.map S_T.f)
          (by rw [← Γ.map_comp, S_T.zero, Γ.map_zero])) := by
        have hc_map := Limits.isLimitOfPreserves Γ hKer_f
        let mkCone : ∀ {W : ModuleCat.{u, u} R} (w : W ⟶ Γ.obj S_T.X₂),
            w ≫ Γ.map S_T.g = 0 → Limits.Cone (Limits.parallelPair S_T.g 0 ⋙ Γ) :=
          fun {W} w hw =>
            { pt := W
              π :=
                { app := fun j =>
                    match j with
                    | Limits.WalkingParallelPair.zero => w
                    | Limits.WalkingParallelPair.one => 0
                  naturality := by
                    rintro (_ | _) (_ | _) (_ | _ | _)
                    · simp
                    · dsimp; rw [Category.id_comp]; exact hw.symm
                    · simp
                    · simp } }
        refine Limits.KernelFork.IsLimit.ofι _ _
          (fun {W} w hw => hc_map.lift (mkCone w hw))
          (fun {W} w hw => hc_map.fac (mkCone w hw) Limits.WalkingParallelPair.zero)
          (fun {W} w hw m_hom hm => by
            apply (cancel_mono (Γ.map S_T.f)).mp
            rw [hm]
            exact (hc_map.fac (mkCone w hw) Limits.WalkingParallelPair.zero).symm)
      have hEx_Γ : (S_T.map Γ).Exact := ShortComplex.exact_of_f_is_kernel _ hKer_Γf
      exact ShortComplex.ShortExact.mk' (S := S_ex.map C) hEx_Γ (Γ.map_mono S_T.f) hEpi_g
    obtain ⟨hC_FL, hC_FC⟩ := ((Functor.exact_tfae C).out 1 4).mp hShortEx
    have : Limits.PreservesFiniteLimits C := hC_FL
    have : Limits.PreservesFiniteColimits C := hC_FC
    have : Limits.PreservesFilteredColimitsOfSize.{u, u} C :=
      ⟨fun _ _ => ⟨fun {_} => ⟨fun hc =>
        ⟨Limits.isColimitOfPreserves Γ (Limits.isColimitOfPreserves T hc)⟩⟩⟩⟩
    have hDisc : ∀ (α : Type u), Limits.PreservesColimitsOfShape (Discrete α) C := by
      intro α
      refine ⟨fun {F_α} => ⟨fun {c} hc => ⟨?_⟩⟩⟩
      let subDiag : ∀ (s : Finset α), Discrete ↥s ⥤ 𝒜 :=
        fun s => Discrete.functor fun x : ↥s => F_α.obj ⟨x.1⟩
      let D_fin : Finset α ⥤ 𝒜 :=
        { obj := fun s => Limits.colimit (subDiag s)
          map := fun {s₁ s₂} h =>
            Limits.colimit.desc (subDiag s₁)
              ⟨Limits.colimit (subDiag s₂),
               Discrete.natTrans fun x =>
                 Limits.colimit.ι (subDiag s₂) ⟨⟨x.1.1, leOfHom h x.1.2⟩⟩⟩
          map_id := fun s => by
            apply Limits.colimit.hom_ext
            rintro ⟨⟨x, hx⟩⟩
            simp
          map_comp := fun {s₁ s₂ s₃} h₁ h₂ => by
            apply Limits.colimit.hom_ext
            rintro ⟨⟨x, hx⟩⟩
            simp }
      let c_fin : Limits.Cocone D_fin :=
        { pt := c.pt
          ι :=
            { app := fun s =>
                Limits.colimit.desc (subDiag s)
                  ⟨c.pt, Discrete.natTrans fun x => c.ι.app ⟨x.1.1⟩⟩
              naturality := fun {s₁ s₂} h => by
                apply Limits.colimit.hom_ext
                rintro ⟨⟨x, hx⟩⟩
                dsimp [D_fin]
                rw [Category.comp_id, Limits.colimit.ι_desc_assoc]
                dsimp
                rw [Limits.colimit.ι_desc, Limits.colimit.ι_desc]
                rfl } }
      have hc_fin : Limits.IsColimit c_fin := by
        refine Limits.IsColimit.mk
          (fun t => hc.desc ⟨t.pt, Discrete.natTrans fun x =>
            Limits.colimit.ι (subDiag {x.as}) ⟨⟨x.as, Finset.mem_singleton_self x.as⟩⟩ ≫
              t.ι.app {x.as}⟩)
          (fun t s => ?_)
          (fun t m_hom hm => ?_)
        · apply Limits.colimit.hom_ext
          rintro ⟨⟨a, ha⟩⟩
          dsimp [c_fin]
          rw [Limits.colimit.ι_desc_assoc]
          dsimp
          rw [hc.fac]
          dsimp
          have hle : ({a} : Finset α) ≤ s := Finset.singleton_subset_iff.mpr ha
          conv_lhs => rw [← t.w (homOfLE hle)]
          dsimp [D_fin]
          rw [Limits.colimit.ι_desc_assoc]
          rfl
        · apply hc.hom_ext
          rintro ⟨a⟩
          rw [hc.fac]
          dsimp
          rw [← hm {a}]
          dsimp [c_fin]
          rw [Limits.colimit.ι_desc_assoc]
          rfl
      have hc_C_fin := Limits.isColimitOfPreserves C hc_fin
      have hc_sub : ∀ s : Finset α,
          Limits.IsColimit (C.mapCocone (Limits.colimit.cocone (subDiag s))) := by
        intro s
        letI : Fintype ↥s := Finset.fintypeCoeSort s
        exact Limits.isColimitOfPreserves C (Limits.colimit.isColimit (subDiag s))
      let t_fin : Limits.Cocone (F_α ⋙ C) → Limits.Cocone (D_fin ⋙ C) := fun t =>
        { pt := t.pt
          ι :=
            { app := fun s =>
                (hc_sub s).desc ⟨t.pt, Discrete.natTrans fun x => t.ι.app ⟨x.1.1⟩⟩
              naturality := fun {s₁ s₂} h => by
                dsimp
                rw [Category.comp_id]
                apply (hc_sub s₁).hom_ext
                rintro ⟨⟨a, ha⟩⟩
                change (C.map (Limits.colimit.ι (subDiag s₁) ⟨⟨a, ha⟩⟩) ≫ C.map (D_fin.map h)) ≫
                    (hc_sub s₂).desc ⟨t.pt, Discrete.natTrans fun x => t.ι.app ⟨x.1.1⟩⟩ = _
                rw [← C.map_comp]
                dsimp [D_fin]
                rw [Limits.colimit.ι_desc]
                dsimp
                have hfac2 := (hc_sub s₂).fac
                  ⟨t.pt, Discrete.natTrans fun x => t.ι.app ⟨x.1.1⟩⟩
                  ⟨⟨a, leOfHom h ha⟩⟩
                have hfac1 := (hc_sub s₁).fac
                  ⟨t.pt, Discrete.natTrans fun x => t.ι.app ⟨x.1.1⟩⟩
                  ⟨⟨a, ha⟩⟩
                exact hfac2.trans hfac1.symm } }
      refine Limits.IsColimit.mk
        (fun t => hc_C_fin.desc (t_fin t)) (fun t j => ?_) (fun t m_hom hm => ?_)
      · rcases j with ⟨a⟩
        have hfac_fin := hc_C_fin.fac (t_fin t) {a}
        have hfac_sub := (hc_sub {a}).fac
          ⟨t.pt, Discrete.natTrans fun x => t.ι.app ⟨x.1.1⟩⟩
          ⟨⟨a, Finset.mem_singleton_self a⟩⟩
        dsimp [t_fin] at hfac_fin hfac_sub ⊢
        rw [← hfac_sub, ← hfac_fin, ← Category.assoc, ← C.map_comp]
        dsimp [c_fin]
        rw [Limits.colimit.ι_desc]
        rfl
      · apply hc_C_fin.hom_ext
        intro s
        rw [hc_C_fin.fac (t_fin t) s]
        dsimp [t_fin]
        apply (hc_sub s).hom_ext
        rintro ⟨⟨a, ha⟩⟩
        rw [(hc_sub s).fac]
        dsimp
        rw [← hm ⟨a⟩]
        dsimp [c_fin]
        rw [← Category.assoc, ← C.map_comp, Limits.colimit.ι_desc]
        rfl
    have hAllColim : Limits.PreservesColimitsOfSize.{u, u} C := by
      refine ⟨fun {K_sm} _ => ?_⟩
      have := hDisc K_sm
      have := hDisc ((p : K_sm × K_sm) × (p.1 ⟶ p.2))
      exact Limits.preservesColimit_of_preservesCoequalizers_and_coproduct C
    exact ⟨hC_FL, hC_FC, hAllColim⟩
  
  
  
  have hPillar2 : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒜]
      [CategoryTheory.Abelian 𝒜] [CategoryTheory.IsGrothendieckAbelian.{u} 𝒜]
      (oneA : 𝒜)
      (G : ℕ → CategoryTheory.Functor 𝒜 𝒜)
      (η_G : CategoryTheory.NatTrans (CategoryTheory.Functor.id 𝒜) (G 0))
      (diff_G : ∀ q : ℕ, CategoryTheory.NatTrans (G q) (G (q + 1))),
      (∀ q : ℕ, (G q).Additive ∧
        CategoryTheory.Limits.PreservesFiniteLimits (G q) ∧
        CategoryTheory.Limits.PreservesFiniteColimits (G q)) →
      (∀ F : 𝒜, CategoryTheory.Mono (η_G.app F)) →
      (∀ F : 𝒜, ∃ h₀ : η_G.app F ≫ (diff_G 0).app F = 0,
        (CategoryTheory.ShortComplex.mk (η_G.app F) ((diff_G 0).app F) h₀).Exact) →
      (∀ (q : ℕ) (F : 𝒜), ∃ hq : (diff_G q).app F ≫ (diff_G (q + 1)).app F = 0,
        (CategoryTheory.ShortComplex.mk ((diff_G q).app F) ((diff_G (q + 1)).app F) hq).Exact) →
      (∀ (q k : ℕ), 1 ≤ k → ∀ F : 𝒜,
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneA ((G q).obj F) k)) →
      (∀ (Q : 𝒜), CategoryTheory.IsNoetherianObject Q →
        CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u}
          (CategoryTheory.coyoneda.obj (Opposite.op Q))) →
      (∀ (k : ℕ), 1 ≤ k →
        ∀ (Λ : Type u) [CategoryTheory.SmallCategory Λ] [CategoryTheory.IsFiltered Λ]
          (D : CategoryTheory.Functor Λ 𝒜),
          (∀ j : Λ, Subsingleton (CategoryTheory.Abelian.Ext.{u} oneA (D.obj j) k)) →
          Subsingleton (CategoryTheory.Abelian.Ext.{u} oneA (CategoryTheory.Limits.colimit D) k)) →
      ((∀ {X Y : 𝒜} (f : X ⟶ Y) [CategoryTheory.Epi f],
          CategoryTheory.IsNoetherianObject X → CategoryTheory.IsNoetherianObject Y) ∧
        (∀ (F : 𝒜),
          (∃ (P₀ : CategoryTheory.Subobject F), CategoryTheory.IsNoetherianObject (P₀ : 𝒜)) ∧
          ∀ (P₁ P₂ : CategoryTheory.Subobject F),
            CategoryTheory.IsNoetherianObject (P₁ : 𝒜) →
            CategoryTheory.IsNoetherianObject (P₂ : 𝒜) →
            ∃ (Q : CategoryTheory.Subobject F),
              CategoryTheory.IsNoetherianObject (Q : 𝒜) ∧ P₁ ≤ Q ∧ P₂ ≤ Q) ∧
        (∀ {E Q : 𝒜} (π : E ⟶ Q) [CategoryTheory.Epi π],
          CategoryTheory.IsNoetherianObject Q →
          ∃ (P : CategoryTheory.Subobject E),
            CategoryTheory.IsNoetherianObject (P : 𝒜) ∧ CategoryTheory.Epi (P.arrow ≫ π)) ∧
        (∀ (F : 𝒜) (M : CategoryTheory.Subobject F),
          (∀ (P : CategoryTheory.Subobject F), CategoryTheory.IsNoetherianObject (P : 𝒜) → P ≤ M) →
          M = ⊤)) →
      ∃ (𝒯_raw : ℕ → CategoryTheory.Functor 𝒜 𝒜)
        (η_raw : CategoryTheory.NatTrans (CategoryTheory.Functor.id 𝒜) (𝒯_raw 0))
        (diff_raw : ∀ q : ℕ, CategoryTheory.NatTrans (𝒯_raw q) (𝒯_raw (q + 1))),
        (∀ q : ℕ, (𝒯_raw q).Additive ∧
          CategoryTheory.Limits.PreservesFiniteLimits (𝒯_raw q) ∧
          CategoryTheory.Limits.PreservesFiniteColimits (𝒯_raw q) ∧
          CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u} (𝒯_raw q)) ∧
        (∀ F : 𝒜, CategoryTheory.Mono (η_raw.app F)) ∧
        (∀ F : 𝒜, ∃ h₀ : η_raw.app F ≫ (diff_raw 0).app F = 0,
          (CategoryTheory.ShortComplex.mk (η_raw.app F) ((diff_raw 0).app F) h₀).Exact) ∧
        (∀ (q : ℕ) (F : 𝒜), ∃ hq : (diff_raw q).app F ≫ (diff_raw (q + 1)).app F = 0,
          (CategoryTheory.ShortComplex.mk ((diff_raw q).app F) ((diff_raw (q + 1)).app F) hq).Exact) ∧
        (∀ (q k : ℕ), 1 ≤ k → ∀ F : 𝒜,
          Subsingleton (CategoryTheory.Abelian.Ext.{u} oneA ((𝒯_raw q).obj F) k)) := by
    intro 𝒜 _ _ _ oneA G η_G diff_G hG_props hηG_mono hEx0_G hExq_G hG_acyc
      hNoethCompA hExtColimA ⟨hQuot, hDir, hSurjLift, hTop⟩
    letI : LocallySmall.{u} 𝒜 := IsGrothendieckAbelian.locallySmall
    have hNoethIso : ∀ {X Y : 𝒜} (e : X ≅ Y),
        IsNoetherianObject X → IsNoetherianObject Y :=
      fun e hX => hQuot e.hom hX
    have hSubLE : ∀ {W : 𝒜} (A B : Subobject W),
        A ≤ B ↔ A.arrow ≫ Limits.cokernel.π B.arrow = 0 := by
      intro W A B
      constructor
      · intro h
        rw [← Subobject.ofLE_arrow h, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
      · intro h0
        have hEx := ShortComplex.exact_cokernel B.arrow
        have hKer := hEx.fIsKernel
        let u : (A : 𝒜) ⟶ (B : 𝒜) := hKer.lift (Limits.KernelFork.ofι A.arrow h0)
        have hu : u ≫ B.arrow = A.arrow :=
          hKer.fac (Limits.KernelFork.ofι A.arrow h0) Limits.WalkingParallelPair.zero
        simpa only [Subobject.mk_arrow] using Subobject.mk_le_mk_of_comm u hu
    
    let SubFG : 𝒜 → Type (u + 1) := fun F => { P : Subobject F // IsNoetherianObject (P : 𝒜) }
    let IdxFG : 𝒜 → Type u := fun F => Shrink.{u} (SubFG F)
    let eFG : ∀ F : 𝒜, SubFG F ≃ IdxFG F := fun F => equivShrink.{u} (SubFG F)
    let subOf : ∀ {F : 𝒜}, IdxFG F → Subobject F := fun {F} p => ((eFG F).symm p).1
    have hNoethOf : ∀ {F : 𝒜} (p : IdxFG F), IsNoetherianObject (subOf p : 𝒜) :=
      fun {F} p => ((eFG F).symm p).2
    letI instPreIdx : ∀ F : 𝒜, Preorder (IdxFG F) := fun F => Preorder.lift (@subOf F)
    have hIdxLE : ∀ {F : 𝒜} {p₁ p₂ : IdxFG F}, (p₁ ⟶ p₂) → subOf p₁ ≤ subOf p₂ :=
      fun u => u.down.down
    let idxHom : ∀ {F : 𝒜} {p₁ p₂ : IdxFG F}, subOf p₁ ≤ subOf p₂ → (p₁ ⟶ p₂) :=
      fun h => ULift.up (PLift.up h)
    have hSubOf_eFG : ∀ {F : 𝒜} (P : SubFG F), subOf (eFG F P) = P.1 :=
      fun {F} P => congrArg Subtype.val ((eFG F).symm_apply_apply P)
    have instFiltEmptyIdx : ∀ F : 𝒜, IsFilteredOrEmpty (IdxFG F) := by
      intro F
      refine
        { cocone_objs := fun p₁ p₂ => ?_
          cocone_maps := fun _ _ _ _ => ⟨_, 𝟙 _, Subsingleton.elim _ _⟩ }
      obtain ⟨Q, hQ, h₁, h₂⟩ := (hDir F).2 (subOf p₁) (subOf p₂) (hNoethOf p₁) (hNoethOf p₂)
      let r : IdxFG F := eFG F ⟨Q, hQ⟩
      have hr : subOf r = Q := hSubOf_eFG ⟨Q, hQ⟩
      exact ⟨r, idxHom (by rw [hr]; exact h₁), idxHom (by rw [hr]; exact h₂), trivial⟩
    have : ∀ F : 𝒜, IsFilteredOrEmpty (IdxFG F) := instFiltEmptyIdx
    have instFiltIdx : ∀ F : 𝒜, IsFiltered (IdxFG F) := by
      intro F
      obtain ⟨P₀, hP₀⟩ := (hDir F).1
      exact { toIsFilteredOrEmpty := instFiltEmptyIdx F, nonempty := ⟨eFG F ⟨P₀, hP₀⟩⟩ }
    have : ∀ F : 𝒜, IsFiltered (IdxFG F) := instFiltIdx
    let diagFG : ∀ F : 𝒜, IdxFG F ⥤ 𝒜 := fun F =>
      { obj := fun p => (subOf p : 𝒜)
        map := fun {p₁ p₂} u => (subOf p₁).ofLE (subOf p₂) (hIdxLE u)
        map_id := fun p => (cancel_mono (subOf p).arrow).mp (by simp)
        map_comp := fun _ _ => (cancel_mono (subOf _).arrow).mp (by simp) }
    let ιSub : ∀ (H : 𝒜 ⥤ 𝒜) {F : 𝒜} (P : Subobject F) (q : IdxFG F),
        P ≤ subOf q → (H.obj (P : 𝒜) ⟶ Limits.colimit (diagFG F ⋙ H)) :=
      fun H {F} P q h => H.map (P.ofLE (subOf q) h) ≫ Limits.colimit.ι (diagFG F ⋙ H) q
    have hιSub_indep : ∀ (H : 𝒜 ⥤ 𝒜) {F : 𝒜} (P : Subobject F) (q₁ q₂ : IdxFG F)
        (h₁ : P ≤ subOf q₁) (h₂ : P ≤ subOf q₂),
        ιSub H P q₁ h₁ = ιSub H P q₂ h₂ := by
      intro H F P q₁ q₂ h₁ h₂
      obtain ⟨r, u₁, u₂, _⟩ := IsFilteredOrEmpty.cocone_objs q₁ q₂
      have hc₁ : P.ofLE (subOf q₁) h₁ ≫ (diagFG F).map u₁ =
          P.ofLE (subOf r) (le_trans h₁ (hIdxLE u₁)) :=
        (cancel_mono (subOf r).arrow).mp (by simp [diagFG])
      have hc₂ : P.ofLE (subOf q₂) h₂ ≫ (diagFG F).map u₂ =
          P.ofLE (subOf r) (le_trans h₁ (hIdxLE u₁)) :=
        (cancel_mono (subOf r).arrow).mp (by simp [diagFG])
      dsimp [ιSub]
      rw [← Limits.colimit.w (diagFG F ⋙ H) u₁, ← Limits.colimit.w (diagFG F ⋙ H) u₂]
      dsimp
      rw [← Category.assoc, ← Category.assoc, ← H.map_comp, ← H.map_comp, hc₁, hc₂]
    have hιSub_ofLE : ∀ (H : 𝒜 ⥤ 𝒜) {F : 𝒜} {P₁ P₂ : Subobject F} (h₁₂ : P₁ ≤ P₂)
        (q : IdxFG F) (h₂ : P₂ ≤ subOf q),
        H.map (P₁.ofLE P₂ h₁₂) ≫ ιSub H P₂ q h₂ = ιSub H P₁ q (le_trans h₁₂ h₂) := by
      intro H F P₁ P₂ h₁₂ q h₂
      dsimp [ιSub]
      rw [← Category.assoc, ← H.map_comp]
      have hc : P₁.ofLE P₂ h₁₂ ≫ P₂.ofLE (subOf q) h₂ = P₁.ofLE (subOf q) (le_trans h₁₂ h₂) :=
        (cancel_mono (subOf q).arrow).mp (by simp)
      rw [hc]
    let imObj : ∀ {F₁ F₂ : 𝒜}, (F₁ ⟶ F₂) → Subobject F₁ → Subobject F₂ :=
      fun φ P => Subobject.mk (Limits.image.ι (P.arrow ≫ φ))
    have hex_tr : ∃ (trHom : ∀ {F₁ F₂ : 𝒜} (φ : F₁ ⟶ F₂) (P : Subobject F₁),
        (P : 𝒜) ⟶ (imObj φ P : 𝒜)),
        (∀ {F₁ F₂ : 𝒜} (φ : F₁ ⟶ F₂) (P : Subobject F₁), Epi (trHom φ P)) ∧
        (∀ {F₁ F₂ : 𝒜} (φ : F₁ ⟶ F₂) (P : Subobject F₁),
          trHom φ P ≫ (imObj φ P).arrow = P.arrow ≫ φ) := by
      refine ⟨fun φ P => Limits.factorThruImage (P.arrow ≫ φ) ≫
        (Subobject.underlyingIso (Limits.image.ι (P.arrow ≫ φ))).inv,
        fun φ P => epi_comp (Limits.factorThruImage (P.arrow ≫ φ)) _,
        fun φ P => ?_⟩
      dsimp [imObj]
      rw [Category.assoc, ← Subobject.underlyingIso_hom_comp_eq_mk,
        Iso.inv_hom_id_assoc, Limits.image.fac]
    obtain ⟨trHom, hEpiTr, hTrArrow⟩ := hex_tr
    have hNoethIm : ∀ {F₁ F₂ : 𝒜} (φ : F₁ ⟶ F₂) (P : Subobject F₁),
        IsNoetherianObject (P : 𝒜) → IsNoetherianObject (imObj φ P : 𝒜) := by
      intro F₁ F₂ φ P hP
      have := hEpiTr φ P
      exact hQuot (trHom φ P) hP
    let imIdx : ∀ {F₁ F₂ : 𝒜} (φ : F₁ ⟶ F₂), IdxFG F₁ → IdxFG F₂ :=
      fun {F₁ F₂} φ p => eFG F₂ ⟨imObj φ (subOf p), hNoethIm φ (subOf p) (hNoethOf p)⟩
    have hImIdxLE : ∀ {F₁ F₂ : 𝒜} (φ : F₁ ⟶ F₂) (p : IdxFG F₁),
        imObj φ (subOf p) ≤ subOf (imIdx φ p) :=
      fun φ p => le_of_eq (hSubOf_eFG ⟨imObj φ (subOf p), hNoethIm φ (subOf p) (hNoethOf p)⟩).symm
    have hImLE_of_comm : ∀ {F₁ F₂ : 𝒜} (φ : F₁ ⟶ F₂) (P : Subobject F₁)
        (Q : Subobject F₂) (v : (P : 𝒜) ⟶ (Q : 𝒜)),
        v ≫ Q.arrow = P.arrow ≫ φ → imObj φ P ≤ Q := by
      intro F₁ F₂ φ P Q v hv
      have := hEpiTr φ P
      rw [hSubLE]
      apply (cancel_epi (trHom φ P)).mp
      rw [Limits.comp_zero, ← Category.assoc, hTrArrow, ← hv,
        Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    have hTr_ιSub_eq : ∀ (H : 𝒜 ⥤ 𝒜) {F₁ F₂ : 𝒜} (φ : F₁ ⟶ F₂)
        (P : Subobject F₁) (q_im : IdxFG F₂) (h_im : imObj φ P ≤ subOf q_im)
        (Q : Subobject F₂) (q : IdxFG F₂) (hQ : Q ≤ subOf q)
        (v : (P : 𝒜) ⟶ (Q : 𝒜)),
        v ≫ Q.arrow = P.arrow ≫ φ →
        H.map (trHom φ P) ≫ ιSub H (imObj φ P) q_im h_im =
          H.map v ≫ ιSub H Q q hQ := by
      intro H F₁ F₂ φ P q_im h_im Q q hQ v hv
      have hle : imObj φ P ≤ Q := hImLE_of_comm φ P Q v hv
      have hv_eq : v = trHom φ P ≫ (imObj φ P).ofLE Q hle := by
        apply (cancel_mono Q.arrow).mp
        rw [Category.assoc, Subobject.ofLE_arrow, hTrArrow, hv]
      rw [hv_eq, H.map_comp, Category.assoc, hιSub_ofLE]
      congr 1
      exact hιSub_indep H (imObj φ P) q_im q h_im (le_trans hle hQ)
    have hex_indMap : ∃ (indMap : ∀ (H : 𝒜 ⥤ 𝒜) {F₁ F₂ : 𝒜},
        (F₁ ⟶ F₂) → (Limits.colimit (diagFG F₁ ⋙ H) ⟶ Limits.colimit (diagFG F₂ ⋙ H))),
        (∀ (H : 𝒜 ⥤ 𝒜) {F₁ F₂ : 𝒜} (φ : F₁ ⟶ F₂) (p : IdxFG F₁),
          Limits.colimit.ι (diagFG F₁ ⋙ H) p ≫ indMap H φ =
            H.map (trHom φ (subOf p)) ≫
              ιSub H (imObj φ (subOf p)) (imIdx φ p) (hImIdxLE φ p)) ∧
        (∀ (H : 𝒜 ⥤ 𝒜) (F : 𝒜), indMap H (𝟙 F) = 𝟙 _) ∧
        (∀ (H : 𝒜 ⥤ 𝒜) {F₁ F₂ F₃ : 𝒜} (φ : F₁ ⟶ F₂) (ψ : F₂ ⟶ F₃),
          indMap H (φ ≫ ψ) = indMap H φ ≫ indMap H ψ) := by
      let m_fn : ∀ (H : 𝒜 ⥤ 𝒜) {F₁ F₂ : 𝒜},
          (F₁ ⟶ F₂) → (Limits.colimit (diagFG F₁ ⋙ H) ⟶ Limits.colimit (diagFG F₂ ⋙ H)) :=
        fun H {F₁ F₂} φ =>
          Limits.colimit.desc (diagFG F₁ ⋙ H)
            { pt := Limits.colimit (diagFG F₂ ⋙ H)
              ι :=
                { app := fun p =>
                    H.map (trHom φ (subOf p)) ≫
                      ιSub H (imObj φ (subOf p)) (imIdx φ p) (hImIdxLE φ p)
                  naturality := fun {p₁ p₂} u => by
                    dsimp [diagFG]
                    rw [Category.comp_id]
                    have hcomm : ((subOf p₁).ofLE (subOf p₂) (hIdxLE u) ≫ trHom φ (subOf p₂)) ≫
                        (imObj φ (subOf p₂)).arrow = (subOf p₁).arrow ≫ φ := by
                      rw [Category.assoc, hTrArrow, ← Category.assoc, Subobject.ofLE_arrow]
                    have heq := hTr_ιSub_eq H φ (subOf p₁) (imIdx φ p₁) (hImIdxLE φ p₁)
                      (imObj φ (subOf p₂)) (imIdx φ p₂) (hImIdxLE φ p₂)
                      ((subOf p₁).ofLE (subOf p₂) (hIdxLE u) ≫ trHom φ (subOf p₂)) hcomm
                    rw [H.map_comp, Category.assoc] at heq
                    exact heq.symm } }
      refine ⟨m_fn, fun H {F₁ F₂} φ p => Limits.colimit.ι_desc _ p, fun H F => ?_,
        fun H {F₁ F₂ F₃} φ ψ => ?_⟩
      · apply Limits.colimit.hom_ext
        intro p
        dsimp [m_fn]
        rw [Limits.colimit.ι_desc, Category.comp_id]
        dsimp
        have heq := hTr_ιSub_eq H (𝟙 F) (subOf p) (imIdx (𝟙 F) p) (hImIdxLE (𝟙 F) p)
          (subOf p) p le_rfl (𝟙 (subOf p : 𝒜)) (by simp)
        simpa [ιSub] using heq
      · apply Limits.colimit.hom_ext
        intro p
        dsimp [m_fn]
        rw [Limits.colimit.ι_desc, Limits.colimit.ι_desc_assoc]
        dsimp [ιSub]
        rw [Category.assoc, Category.assoc, Limits.colimit.ι_desc]
        dsimp
        set q₂ := imIdx φ p
        let w_comp : (subOf p : 𝒜) ⟶ (imObj ψ (subOf q₂) : 𝒜) :=
          trHom φ (subOf p) ≫
            (imObj φ (subOf p)).ofLE (subOf q₂) (hImIdxLE φ p) ≫ trHom ψ (subOf q₂)
        have hcomm : w_comp ≫ (imObj ψ (subOf q₂)).arrow =
            (subOf p).arrow ≫ (φ ≫ ψ) := by
          dsimp [w_comp]
          rw [Category.assoc, Category.assoc, hTrArrow,
            ← Category.assoc ((imObj φ (subOf p)).ofLE _ _),
            Subobject.ofLE_arrow, ← Category.assoc, hTrArrow, Category.assoc]
        have heq := hTr_ιSub_eq H (φ ≫ ψ) (subOf p) (imIdx (φ ≫ ψ) p) (hImIdxLE (φ ≫ ψ) p)
          (imObj ψ (subOf q₂)) (imIdx ψ q₂) (hImIdxLE ψ q₂) w_comp hcomm
        dsimp [ιSub] at heq
        rw [heq]
        dsimp [w_comp]
        simp only [Functor.map_comp, Category.assoc] <;> rfl
    obtain ⟨indMap, hIndMap_ι, hIndMap_id, hIndMap_comp⟩ := hex_indMap
    let IndF : (𝒜 ⥤ 𝒜) → (𝒜 ⥤ 𝒜) := fun H =>
      { obj := fun F => Limits.colimit (diagFG F ⋙ H)
        map := fun φ => indMap H φ
        map_id := hIndMap_id H
        map_comp := fun φ ψ => hIndMap_comp H φ ψ }
    let IndNat : ∀ {H₁ H₂ : 𝒜 ⥤ 𝒜}, (H₁ ⟶ H₂) → (IndF H₁ ⟶ IndF H₂) := fun {H₁ H₂} τ =>
      { app := fun F => Limits.colimMap (Functor.whiskerLeft (diagFG F) τ)
        naturality := fun {F₁ F₂} φ => by
          apply Limits.colimit.hom_ext
          intro p
          dsimp [IndF]
          rw [reassoc_of% (hIndMap_ι H₁ φ p), Limits.ι_colimMap_assoc, Functor.whiskerLeft_app,
            hIndMap_ι H₂ φ p]
          dsimp [ιSub]
          rw [Category.assoc, Limits.ι_colimMap, Functor.whiskerLeft_app]
          dsimp [diagFG]
          rw [τ.naturality_assoc, τ.naturality_assoc] }
    
    have hIndAdd : ∀ (H : 𝒜 ⥤ 𝒜) [H.Additive], (IndF H).Additive := by
      intro H _
      refine { map_add := fun {F₁ F₂} f g => ?_ }
      apply Limits.colimit.hom_ext
      intro p
      dsimp [IndF]
      rw [Preadditive.comp_add, hIndMap_ι H (f + g) p, hIndMap_ι H f p, hIndMap_ι H g p]
      obtain ⟨Q_fg, hQ_fg, hle_f, hle_g⟩ := (hDir F₂).2
        (imObj f (subOf p)) (imObj g (subOf p))
        (hNoethIm f (subOf p) (hNoethOf p)) (hNoethIm g (subOf p) (hNoethOf p))
      obtain ⟨Q, hQ, hle_fg, hle_sum⟩ := (hDir F₂).2 Q_fg (imObj (f + g) (subOf p))
        hQ_fg (hNoethIm (f + g) (subOf p) (hNoethOf p))
      let q_Q : IdxFG F₂ := eFG F₂ ⟨Q, hQ⟩
      have hQ_le : Q ≤ subOf q_Q := le_of_eq (hSubOf_eFG ⟨Q, hQ⟩).symm
      let vf : (subOf p : 𝒜) ⟶ (Q : 𝒜) :=
        trHom f (subOf p) ≫ (imObj f (subOf p)).ofLE Q (le_trans hle_f hle_fg)
      let vg : (subOf p : 𝒜) ⟶ (Q : 𝒜) :=
        trHom g (subOf p) ≫ (imObj g (subOf p)).ofLE Q (le_trans hle_g hle_fg)
      let vfg : (subOf p : 𝒜) ⟶ (Q : 𝒜) :=
        trHom (f + g) (subOf p) ≫ (imObj (f + g) (subOf p)).ofLE Q hle_sum
      have hvf : vf ≫ Q.arrow = (subOf p).arrow ≫ f := by
        simp only [vf, Category.assoc, Subobject.ofLE_arrow, hTrArrow]
      have hvg : vg ≫ Q.arrow = (subOf p).arrow ≫ g := by
        simp only [vg, Category.assoc, Subobject.ofLE_arrow, hTrArrow]
      have hvfg : vfg ≫ Q.arrow = (subOf p).arrow ≫ (f + g) := by
        simp only [vfg, Category.assoc, Subobject.ofLE_arrow, hTrArrow]
      rw [hTr_ιSub_eq H f (subOf p) _ _ Q q_Q hQ_le vf hvf,
          hTr_ιSub_eq H g (subOf p) _ _ Q q_Q hQ_le vg hvg,
          hTr_ιSub_eq H (f + g) (subOf p) _ _ Q q_Q hQ_le vfg hvfg]
      have hv_sum : vfg = vf + vg := by
        apply (cancel_mono Q.arrow).mp
        rw [Preadditive.add_comp, hvfg, hvf, hvg, Preadditive.comp_add]
      rw [hv_sum, H.map_add, Preadditive.add_comp]
    let uNat : IndF (Functor.id 𝒜) ⟶ Functor.id 𝒜 :=
      { app := fun F =>
          Limits.colimit.desc (diagFG F ⋙ Functor.id 𝒜)
            { pt := F
              ι :=
                { app := fun p => (subOf p).arrow
                  naturality := fun {p₁ p₂} u => by simp [diagFG] } }
        naturality := fun {F₁ F₂} φ => by
          apply Limits.colimit.hom_ext
          intro p
          dsimp [IndF]
          rw [reassoc_of% (hIndMap_ι (Functor.id 𝒜) φ p), Limits.colimit.ι_desc_assoc]
          dsimp [ιSub]
          rw [Category.assoc, Limits.colimit.ι_desc]
          dsimp
          rw [Subobject.ofLE_arrow, hTrArrow] }
    have huNat_iso : ∀ F : 𝒜, IsIso (uNat.app F) := by
      intro F
      let cConst : Limits.Cocone ((Functor.const (IdxFG F)).obj F) :=
        { pt := F
          ι := { app := fun _ => 𝟙 F, naturality := fun _ _ _ => by simp } }
      obtain ⟨p₀⟩ := (inferInstance : IsFiltered (IdxFG F)).nonempty
      have hcConst : Limits.IsColimit cConst :=
        Limits.IsColimit.mk
          (fun s => s.ι.app p₀)
          (fun s p => by
            dsimp [cConst]
            rw [Category.id_comp]
            obtain ⟨r, u₁, u₂, _⟩ := IsFilteredOrEmpty.cocone_objs p p₀
            have h₁ := s.w u₁
            have h₂ := s.w u₂
            dsimp at h₁ h₂
            rw [Category.id_comp] at h₁ h₂
            exact h₂.symm.trans h₁)
          (fun s m_hom hm => by
            have h₀ := hm p₀
            dsimp [cConst] at h₀
            rw [Category.id_comp] at h₀
            exact h₀)
      let α_const : (diagFG F ⋙ Functor.id 𝒜) ⟶ (Functor.const (IdxFG F)).obj F :=
        { app := fun p => (subOf p).arrow
          naturality := fun {p₁ p₂} u => by simp [diagFG] }
      have : ∀ p : IdxFG F, Mono (α_const.app p) := fun p => by
        dsimp [α_const]; infer_instance
      have : Mono α_const := NatTrans.mono_of_mono_app α_const
      have : Mono (Limits.colim.map α_const) := Limits.colim.map_mono α_const
      let iso_const := (Limits.colimit.isColimit ((Functor.const (IdxFG F)).obj F)).coconePointUniqueUpToIso hcConst
      have hu_eq : uNat.app F = Limits.colim.map α_const ≫ iso_const.hom := by
        apply Limits.colimit.hom_ext
        intro p
        dsimp [uNat, α_const, iso_const, cConst]
        simp
      have : Mono (uNat.app F) := by
        rw [hu_eq]
        exact mono_comp (Limits.colim.map α_const) iso_const.hom
      have : Epi (uNat.app F) := by
        refine ⟨fun {Z} g₁ g₂ hg => ?_⟩
        let c : F ⟶ Z := g₁ - g₂
        have hc0 : uNat.app F ≫ c = 0 := by
          simp only [c, Preadditive.comp_sub, hg, sub_self]
        let M : Subobject F := Subobject.mk (Limits.kernel.ι c)
        have hM_top : M = ⊤ := by
          apply hTop F M
          intro P hP
          let p : IdxFG F := eFG F ⟨P, hP⟩
          have hp : P ≤ subOf p := le_of_eq (hSubOf_eFG ⟨P, hP⟩).symm
          have hPc : P.arrow ≫ c = 0 := by
            have hleg : Limits.colimit.ι (diagFG F ⋙ Functor.id 𝒜) p ≫ uNat.app F =
                (subOf p).arrow := Limits.colimit.ι_desc _ p
            calc
              P.arrow ≫ c = P.ofLE (subOf p) hp ≫ (subOf p).arrow ≫ c := by
                rw [← P.ofLE_arrow hp, Category.assoc]
              _ = P.ofLE (subOf p) hp ≫
                    Limits.colimit.ι (diagFG F ⋙ Functor.id 𝒜) p ≫ (uNat.app F ≫ c) := by
                rw [← hleg, Category.assoc]
              _ = 0 := by
                rw [hc0, Limits.comp_zero, Limits.comp_zero]
          simpa only [Subobject.mk_arrow] using
            Subobject.mk_le_mk_of_comm (Limits.kernel.lift c P.arrow hPc)
              (Limits.kernel.lift_ι c P.arrow hPc)
        have : IsIso (Limits.kernel.ι c) := (Subobject.isIso_iff_mk_eq_top _).mpr hM_top
        have hc_eq0 : c = 0 := by
          apply (cancel_epi (Limits.kernel.ι c)).mp
          simp
        exact sub_eq_zero.mp hc_eq0
      exact isIso_of_mono_of_epi (uNat.app F)
    have : IsIso uNat := NatIso.isIso_of_isIso_app uNat
    let eId : Functor.id 𝒜 ≅ IndF (Functor.id 𝒜) := (asIso uNat).symm
    
    have hColimExact : ∀ {J_f : Type u} [SmallCategory J_f] [IsFiltered J_f]
        {D₁ D₂ D₃ : J_f ⥤ 𝒜} (α : D₁ ⟶ D₂) (β : D₂ ⟶ D₃) (hαβ : α ≫ β = 0),
        (∀ j : J_f, (ShortComplex.mk (α.app j) (β.app j)
          (by rw [← NatTrans.comp_app, hαβ]; rfl)).Exact) →
        ∃ h0 : Limits.colim.map α ≫ Limits.colim.map β = 0,
          (ShortComplex.mk (Limits.colim.map α) (Limits.colim.map β) h0).Exact := by
      intro J_f _ _ D₁ D₂ D₃ α β hαβ hEx_j
      have h0 : Limits.colim.map α ≫ Limits.colim.map β = 0 := by
        rw [← Limits.colim.map_comp, hαβ, Limits.colim.map_zero]
      refine ⟨h0, ?_⟩
      let Cok_α : J_f ⥤ 𝒜 :=
        { obj := fun j => Limits.cokernel (α.app j)
          map := fun {j₁ j₂} u =>
            Limits.cokernel.map (α.app j₁) (α.app j₂) (D₁.map u) (D₂.map u)
              (α.naturality u).symm
          map_id := fun j => (cancel_epi (Limits.cokernel.π (α.app j))).mp (by simp)
