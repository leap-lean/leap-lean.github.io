        · exact hℬ₀
  exact hMain d k hℓ X hDim ℬ hℬ q hq

theorem weil_etale_truncated_godement_acyclic_complex (k : Type u) [Field k] [IsAlgClosed k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper X.hom]
    (d m : ℕ) (hm : 1 ≤ m) (hUnit : IsUnit (m : k))
    (hDim : topologicalKrullDim X.left ≤ (d : WithBot ℕ∞)) :
    WeilHasTruncatedGodementComplex X.left d m :=
by
  classical
  have hColimProper : ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
      (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
      [AlgebraicGeometry.IsProper B.hom] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ),
      (∀ (ℬ : CategoryTheory.Sheaf B.left.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsConstructibleModPrimeSheaf ℓ B.left ℬ → Subsingleton (ℬ.H r)) →
      ∀ (𝒜 : CategoryTheory.Sheaf B.left.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id 𝒜 = 0 → Subsingleton (𝒜.H r) := by
    intro k₀ _ _ B _ ℓ hP r
    exact (weil_etale_noetherian_ind_godement_and_colimit_reduction k₀ B).1 ℓ r
      (weil_etale_ordinary_godement_resolution B.left ℓ hP.out.one_le)
  have hCurveVanish : ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
      (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom],
      AlgebraicGeometry.IsIntegral C.left →
      IsProjectiveOverField k₀ C →
      ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : k₀) ≠ 0 →
      ∀ (q : ℕ), 3 ≤ q → Subsingleton (weilEtaleTorsionH C.left ℓ q) := by
    intro k₀ _ _ C _ hIntC hProjC ℓ _ hℓ₀ q hq
    exact (weil_etale_smooth_proj_curve_mod_prime_cohomology k₀ C hIntC hProjC ℓ hℓ₀).2.1 q hq
  have hOrd_m : WeilHasOrdinaryGodementResolution X.left m :=
    weil_etale_ordinary_godement_resolution X.left m hm
  apply (weil_etale_noetherian_ind_godement_and_colimit_reduction k X).2 d m hm hOrd_m
  intro q hq F
  obtain ⟨_, _, _, _, _, _, _, _, hExtEquiv⟩ := hOrd_m
  obtain ⟨e_q⟩ := hExtEquiv q F
  let R := ULift.{u, 0} (ZMod m)
  let J := X.left.smallEtaleTopology
  let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let U_m := CategoryTheory.Sheaf.composeAndSheafify J FgtMod
  have hPrimeVanish : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], ℓ ∣ m →
      ∀ (𝒜 : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id 𝒜 = 0 → Subsingleton (𝒜.H q) := by
    intro ℓ _ hdvd 𝒜 h𝒜
    have hℓ_ne : (ℓ : k) ≠ 0 := by
      intro h0
      obtain ⟨c, hmc⟩ := hdvd
      have hm0 : (m : k) = 0 := by
        rw [hmc, Nat.cast_mul, h0, zero_mul]
      exact hUnit.ne_zero hm0
    exact hColimProper k X ℓ q
      (fun ℬ hℬ => weil_etale_proper_constructible_cohomological_dim_le_two_mul
        weil_etale_proper_base_change_mod_prime hCurveVanish hColimProper
        k X d ℓ hℓ_ne hDim ℬ hℬ q hq)
      𝒜 h𝒜
  have hDivVanish : ∀ (n : ℕ), 1 ≤ n → n ∣ m →
      ∀ (ℬ : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        n • CategoryTheory.CategoryStruct.id ℬ = 0 → Subsingleton (ℬ.H q) := by
    intro n
    induction n using Nat.strongRecOn with
    | ind n ih =>
      intro hn1 hnm ℬ hnℬ
      let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      by_cases hn_eq1 : n = 1
      · subst hn_eq1
        rw [one_nsmul] at hnℬ
        refine ⟨fun x y => ?_⟩
        have hzero : ∀ z : ℬ.H q, z = 0 := by
          intro z
          calc
            z = z.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 ℬ)) (Nat.add_zero q) := by simp
            _ = z.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : ℬ ⟶ ℬ)) (Nat.add_zero q) := by
              rw [hnℬ]
            _ = 0 := by simp
        rw [hzero x, hzero y]
      · obtain ⟨ℓ, hℓ_prime, hℓ_dvd_n⟩ := Nat.exists_prime_and_dvd hn_eq1
        let _hFact : Fact (Nat.Prime ℓ) := ⟨hℓ_prime⟩
        obtain ⟨c, hnc⟩ := hℓ_dvd_n
        have hc1 : 1 ≤ c := by
          by_contra hc0
          have : c = 0 := by omega
          rw [this, mul_zero] at hnc
          omega
        have hc_lt_n : c < n := by
          have hℓ2 : 2 ≤ ℓ := hℓ_prime.two_le
          nlinarith
        have hℓ_dvd_m : ℓ ∣ m := dvd_trans ⟨c, hnc⟩ hnm
        have hc_dvd_m : c ∣ m := dvd_trans ⟨ℓ, by rw [hnc, mul_comm]⟩ hnm
        let φ : ℬ ⟶ ℬ := ℓ • 𝟙 ℬ
        let K := CategoryTheory.Limits.kernel φ
        let Im := CategoryTheory.Limits.image φ
        have hcomp0 : CategoryTheory.Limits.kernel.ι φ ≫
            CategoryTheory.Limits.factorThruImage φ = 0 := by
          apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.image.ι φ)).mp
          simp
        let S_ex : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J AddCommGrpCat.{u}) :=
          CategoryTheory.ShortComplex.mk
            (CategoryTheory.Limits.kernel.ι φ)
            (CategoryTheory.Limits.factorThruImage φ) hcomp0
        have hIsKernel : CategoryTheory.Limits.IsLimit
            (CategoryTheory.Limits.KernelFork.ofι
              (CategoryTheory.Limits.kernel.ι φ) hcomp0) := by
          refine CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
            (fun {W} u hu => CategoryTheory.Limits.kernel.lift φ u ?_)
            (fun {W} u hu => CategoryTheory.Limits.kernel.lift_ι φ u _)
            (fun {W} u hu m_hom hm_eq => ?_)
          · have : (u ≫ CategoryTheory.Limits.factorThruImage φ) ≫
                CategoryTheory.Limits.image.ι φ = 0 := by
              rw [hu, CategoryTheory.Limits.zero_comp]
            simpa using this
          · apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι φ)).mp
            rw [hm_eq, CategoryTheory.Limits.kernel.lift_ι]
        have hShortExact : S_ex.ShortExact :=
          { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel S_ex hIsKernel
            mono_f := inferInstance
            epi_g := inferInstance }
        have hK_tor : ℓ • CategoryTheory.CategoryStruct.id K = 0 := by
          apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι φ)).mp
          have hcomm : (ℓ • 𝟙 K) ≫ CategoryTheory.Limits.kernel.ι φ =
              CategoryTheory.Limits.kernel.ι φ ≫ φ := by
            simp [φ]
          rw [hcomm, CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
        have hIm_tor : c • CategoryTheory.CategoryStruct.id Im = 0 := by
          apply (CategoryTheory.cancel_epi (CategoryTheory.Limits.factorThruImage φ)).mp
          have hcomm : CategoryTheory.Limits.factorThruImage φ ≫ (c • 𝟙 Im) =
              (c • 𝟙 ℬ) ≫ CategoryTheory.Limits.factorThruImage φ := by
            simp [Im]
          rw [hcomm, CategoryTheory.Limits.comp_zero]
          apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.image.ι φ)).mp
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.image.fac,
            CategoryTheory.Limits.zero_comp]
          change (c • 𝟙 ℬ) ≫ (ℓ • 𝟙 ℬ) = 0
          have hmul : (c • 𝟙 ℬ) ≫ (ℓ • 𝟙 ℬ) = (ℓ * c) • 𝟙 ℬ := by
            simp [mul_smul]
          rw [hmul, ← hnc]
          exact hnℬ
        have hSubK : Subsingleton (K.H q) := hPrimeVanish ℓ hℓ_dvd_m K hK_tor
        have hSubIm : Subsingleton (Im.H q) := ih c hc_lt_n hc1 hc_dvd_m Im hIm_tor
        refine ⟨fun x y => ?_⟩
        have hzero : ∀ z : ℬ.H q, z = 0 := by
          intro z
          have hmap0 : z.comp (CategoryTheory.Abelian.Ext.mk₀ S_ex.g) (Nat.add_zero q) = 0 :=
            Subsingleton.elim _ 0
          obtain ⟨x_K, hx_K⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ hShortExact z hmap0
          have hx0 : x_K = 0 := Subsingleton.elim x_K 0
          rw [← hx_K, hx0]
          simp
        rw [hzero x, hzero y]
  have hm_tor_UF : m • CategoryTheory.CategoryStruct.id (U_m.obj F) = 0 := by
    have hm_cast0 : (m : R) = 0 := by
      ext
      change (m : ZMod m) = 0
      exact ZMod.natCast_self m
    let P : (X.left.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := F.obj ⋙ FgtMod
    have hP0 : m • CategoryTheory.CategoryStruct.id P = 0 := by
      ext W x
      let x_mod : ↑(F.obj.obj W) := x
      change m • x_mod = 0
      rw [← Nat.cast_smul_eq_nsmul R m x_mod, hm_cast0, zero_smul]
    change m • CategoryTheory.CategoryStruct.id
        ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P) = 0
    rw [← (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map_id,
      ← CategoryTheory.Functor.map_nsmul, hP0, CategoryTheory.Functor.map_zero]
  have hSubUF : Subsingleton ((U_m.obj F).H q) :=
    hDivVanish m hm (dvd_refl m) (U_m.obj F) hm_tor_UF
  exact e_q.toEquiv.subsingleton

theorem weil_etale_local_module_to_torsion_effacement_bridge (S : AlgebraicGeometry.Scheme.{u}) (d m : ℕ)
    (tr_m : weilEtaleTorsionH S m (2 * d) →+ ZMod m)
    (θ_top : weilEtaleModuleH S m (2 * d) →+ weilEtaleTorsionH S m (2 * d))
    (hθ_top : WeilIsModuleToTorsionComparison S m (2 * d) θ_top)
    (hEff : WeilHasTorsionLocalEffacement S d m tr_m) :
    WeilHasLocalEffacement S d m (tr_m.comp θ_top) :=
by
  classical
  let R : Type u := ULift.{u, 0} (ZMod m)
  let R_mod : ModuleCat.{u, u} R := ModuleCat.of R R
  let FgtMod : CategoryTheory.Functor (ModuleCat.{u, u} R) AddCommGrpCat.{u} :=
    CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let Fℤ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let FM : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    weilEtaleTorsionSheaf S m
  let oneR : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R) :=
    weilEtaleModuleUnit S m
  let ιM : AM ⟶ FgtMod.obj R_mod := AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let ιℤ : Aℤ ⟶ FgtMod.obj R_mod :=
    CategoryTheory.CategoryStruct.comp
      (AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u} ℤ)) :
        Aℤ ⟶ AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ))
      (CategoryTheory.CategoryStruct.comp
        (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (Int.castAddHom (ZMod m))))
        ιM)

  
  have hSheafFgt : ∀ F_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R),
      CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (F_sh.obj ⋙ FgtMod) := by
    intro F_sh
    obtain ⟨U', hU'_obj, -⟩ := hθ_top
    rw [← hU'_obj F_sh]
    exact (U'.obj F_sh).property
  let U_of : CategoryTheory.Functor
      (CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R))
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
    { obj := fun F_sh => ⟨F_sh.obj ⋙ FgtMod, hSheafFgt F_sh⟩
      map := fun u => ⟨CategoryTheory.Functor.whiskerRight u.hom FgtMod⟩
      map_id := fun F_sh => by
        apply CategoryTheory.Sheaf.hom_ext
        ext W : 2
        exact FgtMod.map_id (F_sh.obj.obj W)
      map_comp := fun u v => by
        apply CategoryTheory.Sheaf.hom_ext
        ext W : 2
        exact FgtMod.map_comp (u.hom.app W) (v.hom.app W) }
  rcases hθ_top with ⟨U, hU_obj, hU_map, hAdd, hLim, hColim, T, hT,
    _hT_left, _hT_hom, u_unit, hu_unit, βM, hαβ, _hβα, hθ_eq⟩
  have hU_eq : U = U_of := by
    cases U with
    | mk U_obj U_map U_id U_comp =>
      have h_obj : U_obj = U_of.obj := by
        funext F_sh
        have h1 : (U_obj F_sh).obj = (U_of.obj F_sh).obj := hU_obj F_sh
        cases h_lhs : U_obj F_sh with
        | mk o₁ p₁ =>
          rw [h_lhs] at h1
          dsimp [U_of] at h1
          subst h1
          rfl
      subst h_obj
      have h_map : @U_map = @U_of.map := by
        funext F₁ F₂ u
        apply CategoryTheory.Sheaf.hom_ext
        ext W : 2
        exact eq_of_heq (hU_map u W)
      subst h_map
      rfl
  subst hU_eq
  let adjℤ := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT
  let adjR := CategoryTheory.constantSheafAdj S.smallEtaleTopology (ModuleCat.{u, u} R) hT
  have hu_eq : u_unit = FgtMod.map (adjR.unit.app R_mod) := eq_of_heq hu_unit
  subst hu_eq
  have _ : U_of.Additive := hAdd
  have _ : CategoryTheory.Limits.PreservesFiniteLimits U_of := hLim
  have _ : CategoryTheory.Limits.PreservesFiniteColimits U_of := hColim
  let ηℤ : Fℤ ⟶ U_of.obj oneR :=
    (adjℤ.homEquiv Aℤ (U_of.obj oneR)).symm (ιℤ ≫ FgtMod.map (adjR.unit.app R_mod))
  let αM : FM ⟶ U_of.obj oneR :=
    (adjℤ.homEquiv AM (U_of.obj oneR)).symm (ιM ≫ FgtMod.map (adjR.unit.app R_mod))
  let GenMap : ∀ (F_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)) (q : ℕ),
      CategoryTheory.Abelian.Ext.{u} oneR F_sh q →+
        CategoryTheory.Abelian.Ext.{u} Fℤ (U_of.obj F_sh) q :=
    fun F_sh q =>
      ((CategoryTheory.Abelian.Ext.mk₀ ηℤ).precomp (U_of.obj F_sh) (Nat.zero_add q)).comp
        (U_of.mapExtAddHom oneR F_sh q)

  
  have hmR : (m : R) = 0 := ULift.ext _ _ (ZMod.natCast_self m)
  have hm_mod : ∀ (M : ModuleCat.{u, u} R) (x : M), m • x = 0 := by
    intro M x
    rw [← Nat.cast_smul_eq_nsmul R m x, hmR, zero_smul]
  have hR_smul_addHom : ∀ {M₁ M₂ : Type u} [AddCommGroup M₁] [Module R M₁]
      [AddCommGroup M₂] [Module R M₂] (f : M₁ →+ M₂) (r : R) (x : M₁),
      f (r • x) = r • f x := by
    intro M₁ M₂ _ _ _ _ f r x
    obtain ⟨z, hz⟩ := ZMod.intCast_surjective r.down
    have hr : r = (z : R) := ULift.ext _ _ hz.symm
    rw [hr, Int.cast_smul_eq_zsmul R z x, Int.cast_smul_eq_zsmul R z (f x), map_zsmul]
  let tmSubgroup : ∀ A : AddCommGrpCat.{u}, AddSubgroup A := fun A =>
    { carrier := { a : A | m • a = 0 }
      add_mem' := fun {a b} ha hb => by
        change m • (a + b) = 0
        rw [smul_add, ha, hb, add_zero]
      zero_mem' := smul_zero m
      neg_mem' := fun {a} ha => by
        change m • (-a) = 0
        rw [smul_neg, ha, neg_zero] }
  let instModTm : ∀ A : AddCommGrpCat.{u}, Module R ↥(tmSubgroup A) := fun A =>
    letI : Module (ZMod m) ↥(tmSubgroup A) :=
      AddCommGroup.zmodModule (fun x => Subtype.ext x.2)
    Module.compHom ↥(tmSubgroup A) (ULift.ringEquiv : R ≃+* ZMod m).toRingHom
  let C_mod : CategoryTheory.Functor AddCommGrpCat.{u} (ModuleCat.{u, u} R) :=
    { obj := fun A => @ModuleCat.of R _ ↥(tmSubgroup A) _ (instModTm A)
      map := fun {A B} φ =>
        letI : Module R ↥(tmSubgroup A) := instModTm A
        letI : Module R ↥(tmSubgroup B) := instModTm B
        let f_add : ↥(tmSubgroup A) →+ ↥(tmSubgroup B) :=
          { toFun := fun x => ⟨φ.hom x.1, by
              change m • (φ.hom x.1) = 0
              rw [← map_nsmul, x.2, map_zero]⟩
            map_zero' := Subtype.ext (map_zero φ.hom)
            map_add' := fun x y => Subtype.ext (map_add φ.hom x.1 y.1) }
        @ModuleCat.ofHom R _ ↥(tmSubgroup A) ↥(tmSubgroup B) _ (instModTm A) _ (instModTm B)
          { toAddHom := f_add.toAddHom
            map_smul' := fun r x => hR_smul_addHom f_add r x }
      map_id := fun _ => by
        apply ModuleCat.hom_ext
        ext x
        rfl
      map_comp := fun _ _ => by
        apply ModuleCat.hom_ext
        ext x
        rfl }
  let eModR : ∀ (M : ModuleCat.{u, u} R) (A : AddCommGrpCat.{u}),
      (FgtMod.obj M ⟶ A) ≃ (M ⟶ C_mod.obj A) := fun M A =>
    { toFun := fun g =>
        let g_add : M →+ ↥(C_mod.obj A) :=
          { toFun := fun x => ⟨g.hom x, by
              change m • (g.hom x) = 0
              rw [← map_nsmul, hm_mod M x, map_zero]⟩
            map_zero' := Subtype.ext (map_zero g.hom)
            map_add' := fun x y => Subtype.ext (map_add g.hom x y) }
        ModuleCat.ofHom
          { toAddHom := g_add.toAddHom
            map_smul' := fun r x => hR_smul_addHom g_add r x }
      invFun := fun f =>
        AddCommGrpCat.ofHom
          { toFun := fun x => (f.hom x).1
            map_zero' := congrArg Subtype.val (map_zero f.hom)
            map_add' := fun x y => congrArg Subtype.val (map_add f.hom x y) }
      left_inv := fun _ => by ext x; rfl
      right_inv := fun _ => by
        apply ModuleCat.hom_ext
        ext x
        rfl }
  let C_sh : CategoryTheory.Functor
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)) :=
    { obj := fun G_sh => ⟨G_sh.obj ⋙ C_mod, fun E =>
        CategoryTheory.Presieve.isSheaf_iso S.smallEtaleTopology
          (CategoryTheory.NatIso.ofComponents
            (fun W => (eModR E (G_sh.obj.obj W)).toIso)
            (fun _ => by
              ext g
              apply ModuleCat.hom_ext
              apply LinearMap.ext
              intro y
              rfl))
          (G_sh.property (FgtMod.obj E))⟩
      map := fun v => ⟨CategoryTheory.Functor.whiskerRight v.hom C_mod⟩
      map_id := fun _ => by
        apply CategoryTheory.Sheaf.hom_ext
        ext W : 2
        apply ModuleCat.hom_ext
        ext x
        rfl
      map_comp := fun _ _ => by
        apply CategoryTheory.Sheaf.hom_ext
        ext W : 2
        apply ModuleCat.hom_ext
        ext x
        rfl }
  let eShR : ∀ (F_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R))
      (G_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      (U_of.obj F_sh ⟶ G_sh) ≃ (F_sh ⟶ C_sh.obj G_sh) := fun F_sh G_sh =>
    { toFun := fun φ =>
        ⟨{ app := fun W => eModR (F_sh.obj.obj W) (G_sh.obj.obj W) (φ.hom.app W)
           naturality := fun _ _ u => by
             apply ModuleCat.hom_ext
             ext x
             exact Subtype.ext (ConcreteCategory.congr_hom (φ.hom.naturality u) x) }⟩
      invFun := fun ψ =>
        ⟨{ app := fun W => (eModR (F_sh.obj.obj W) (G_sh.obj.obj W)).symm (ψ.hom.app W)
           naturality := fun _ _ u => by
             ext x
             exact congrArg Subtype.val (ConcreteCategory.congr_hom (ψ.hom.naturality u) x) }⟩
      left_inv := fun _ => by
        apply CategoryTheory.Sheaf.hom_ext
        ext W x
        rfl
      right_inv := fun _ => by
        apply CategoryTheory.Sheaf.hom_ext
        ext W : 2
        apply ModuleCat.hom_ext
        ext x
        rfl }

  
  have hBase0 : ∀ F_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R),
      Function.Bijective (GenMap F_sh 0) := by
    intro F_sh
    let A : ModuleCat.{u, u} R := F_sh.obj.obj (Opposite.op T)
    let eR : (R_mod ⟶ A) ≃ A :=
      { toFun := fun ψ => ψ.hom (1 : R)
        invFun := fun a => ModuleCat.ofHom (LinearMap.toSpanSingleton R A a)
        left_inv := fun ψ => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro r
          change r • ψ.hom 1 = ψ.hom r
          rw [← map_smul, smul_eq_mul, mul_one]
        right_inv := fun a => by
          change (1 : R) • a = a
          exact one_smul R a }
    let eℤ : (Aℤ ⟶ FgtMod.obj A) ≃ A :=
      { toFun := fun g => g.hom (ULift.up (1 : ℤ))
        invFun := fun a =>
          AddCommGrpCat.ofHom
            { toFun := fun z => z.down • a
              map_zero' := zero_zsmul a
              map_add' := fun x y => add_zsmul a x.down y.down }
        left_inv := fun g => by
          ext z
          change z.down • g.hom (ULift.up 1) = g.hom z
          rw [← map_zsmul]
          congr 1
          exact ULift.ext _ _ (mul_one z.down)
        right_inv := fun a => one_zsmul a }
    let eqDom : (oneR ⟶ F_sh) ≃ A := (adjR.homEquiv R_mod F_sh).trans eR
    let eqCod : (Fℤ ⟶ U_of.obj F_sh) ≃ A := (adjℤ.homEquiv Aℤ (U_of.obj F_sh)).trans eℤ
    have hHomEq : ∀ φ : oneR ⟶ F_sh, eqCod (ηℤ ≫ U_of.map φ) = eqDom φ := by
      intro φ
      have hNat : adjℤ.homEquiv Aℤ (U_of.obj F_sh) (ηℤ ≫ U_of.map φ) =
          ιℤ ≫ FgtMod.map (adjR.homEquiv R_mod F_sh φ) := by
        calc
          adjℤ.homEquiv Aℤ (U_of.obj F_sh) (ηℤ ≫ U_of.map φ)
            = adjℤ.homEquiv Aℤ (U_of.obj oneR) ηℤ ≫
                ((CategoryTheory.sheafSections S.smallEtaleTopology AddCommGrpCat.{u}).obj
                  (Opposite.op T)).map (U_of.map φ) :=
                CategoryTheory.Adjunction.homEquiv_naturality_right adjℤ ηℤ (U_of.map φ)
          _ = (ιℤ ≫ FgtMod.map (adjR.unit.app R_mod)) ≫ FgtMod.map (φ.hom.app (Opposite.op T)) := by
                rw [Equiv.apply_symm_apply]
                rfl
          _ = ιℤ ≫ FgtMod.map (adjR.unit.app R_mod ≫ φ.hom.app (Opposite.op T)) := by
                rw [CategoryTheory.Category.assoc, ← FgtMod.map_comp]
          _ = ιℤ ≫ FgtMod.map (adjR.homEquiv R_mod F_sh φ) := by
                rw [CategoryTheory.Adjunction.homEquiv_unit adjR R_mod F_sh φ]
                rfl
      change (adjℤ.homEquiv Aℤ (U_of.obj F_sh) (ηℤ ≫ U_of.map φ)).hom (ULift.up 1) =
        (adjR.homEquiv R_mod F_sh φ).hom (1 : R)
      rw [hNat]
      have hι1 : ιℤ.hom (ULift.up (1 : ℤ)) = (1 : R) := by
        change ULift.up ((Int.castAddHom (ZMod m)) 1) = (1 : R)
        exact ULift.ext _ _ Int.cast_one
      change (adjR.homEquiv R_mod F_sh φ).hom (ιℤ.hom (ULift.up 1)) = _
      rw [hι1]
    have hHomBij : Function.Bijective (fun φ : oneR ⟶ F_sh => ηℤ ≫ U_of.map φ) := by
      have hEq : (fun φ : oneR ⟶ F_sh => ηℤ ≫ U_of.map φ) = eqCod.symm ∘ eqDom := by
        funext φ
        apply eqCod.injective
        rw [Function.comp_apply, Equiv.apply_symm_apply, hHomEq]
      rw [hEq]
      exact eqCod.symm.bijective.comp eqDom.bijective
    have hMk0Dom := CategoryTheory.Abelian.Ext.mk₀_bijective oneR F_sh
    have hMk0Cod := CategoryTheory.Abelian.Ext.mk₀_bijective Fℤ (U_of.obj F_sh)
    have hComm0 : (GenMap F_sh 0) ∘ CategoryTheory.Abelian.Ext.mk₀ =
        CategoryTheory.Abelian.Ext.mk₀ ∘ (fun φ : oneR ⟶ F_sh => ηℤ ≫ U_of.map φ) := by
      funext φ
      change (CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor U_of (CategoryTheory.Abelian.Ext.mk₀ φ))
          (Nat.zero_add 0) =
        CategoryTheory.Abelian.Ext.mk₀ (ηℤ ≫ U_of.map φ)
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    have hCompBij : Function.Bijective ((GenMap F_sh 0) ∘ CategoryTheory.Abelian.Ext.mk₀) := by
      rw [hComm0]
      exact hMk0Cod.comp hHomBij
    refine ⟨?_, ?_⟩
    · intro x₁ x₂ hx
      obtain ⟨φ₁, rfl⟩ := hMk0Dom.2 x₁
      obtain ⟨φ₂, rfl⟩ := hMk0Dom.2 x₂
      exact congrArg CategoryTheory.Abelian.Ext.mk₀ (hCompBij.1 hx)
    · intro y
      obtain ⟨φ, hφ⟩ := hCompBij.2 y
      exact ⟨CategoryTheory.Abelian.Ext.mk₀ φ, hφ⟩

  have hFreeYonedaComp : ∀ {D : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} D]
      [CategoryTheory.Limits.HasCoproducts D]
      [CategoryTheory.HasWeakSheafify S.smallEtaleTopology D]
      {W : S.Etale} {M : D}
      {F G : CategoryTheory.Sheaf S.smallEtaleTopology D}
      (α : CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology W M ⟶ F) (g : F ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) := by
    intro D _ _ _ W M F G α g
    let α' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology D).obj
        (CategoryTheory.Presheaf.freeYoneda W M) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology D).homEquiv _ G) (α' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology D).homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf S.smallEtaleTopology D).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  let ιM_equiv : ∀ X : AddCommGrpCat.{u}, (FgtMod.obj R_mod ⟶ X) ≃ (AM ⟶ X) := fun X =>
    { toFun := fun g => ιM ≫ g
      invFun := fun h => (AddCommGrpCat.ofHom (AddMonoidHom.id R) : FgtMod.obj R_mod ⟶ AM) ≫ h
      left_inv := fun _ => by ext x; rfl
      right_inv := fun _ => by ext x; rfl }
  let η_mod : ∀ W : S.Etale, R_mod ⟶ (weilEtaleLocalFreeSheaf S m W).obj.obj (Opposite.op W) :=
    fun W => CategoryTheory.Sheaf.freeYonedaHomEquiv
      (CategoryTheory.CategoryStruct.id (weilEtaleLocalFreeSheaf S m W))
  let α_loc : ∀ W : S.Etale,
      weilEtaleLocalTorsionSheaf S m W ⟶ U_of.obj (weilEtaleLocalFreeSheaf S m W) :=
    fun W => CategoryTheory.Sheaf.freeYonedaHomEquiv.symm (ιM ≫ FgtMod.map (η_mod W))
  let eLoc : ∀ (W : S.Etale) (G_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      (U_of.obj (weilEtaleLocalFreeSheaf S m W) ⟶ G_sh) ≃
        (weilEtaleLocalTorsionSheaf S m W ⟶ G_sh) :=
    fun W G_sh =>
      (eShR (weilEtaleLocalFreeSheaf S m W) G_sh).trans
        (CategoryTheory.Sheaf.freeYonedaHomEquiv.trans
          ((eModR R_mod (G_sh.obj.obj (Opposite.op W))).symm.trans
            ((ιM_equiv (G_sh.obj.obj (Opposite.op W))).trans
              CategoryTheory.Sheaf.freeYonedaHomEquiv.symm)))
  have heLoc_eq : ∀ (W : S.Etale)
      (G_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (φ : U_of.obj (weilEtaleLocalFreeSheaf S m W) ⟶ G_sh),
      eLoc W G_sh φ = α_loc W ≫ φ := by
    intro W G_sh φ
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    rw [hFreeYonedaComp (α_loc W) φ]
    have hα : CategoryTheory.Sheaf.freeYonedaHomEquiv (α_loc W) = ιM ≫ FgtMod.map (η_mod W) :=
      Equiv.apply_symm_apply _ _
    rw [hα]
    dsimp [eLoc]
    rw [Equiv.apply_symm_apply]
    have hFY : CategoryTheory.Sheaf.freeYonedaHomEquiv
          (eShR (weilEtaleLocalFreeSheaf S m W) G_sh φ) =
        η_mod W ≫ (eShR (weilEtaleLocalFreeSheaf S m W) G_sh φ).hom.app (Opposite.op W) := by
      simpa [η_mod] using hFreeYonedaComp
        (CategoryTheory.CategoryStruct.id (weilEtaleLocalFreeSheaf S m W))
        (eShR (weilEtaleLocalFreeSheaf S m W) G_sh φ)
    rw [hFY]
    ext r
    rfl
  let β_loc : ∀ W : S.Etale,
      U_of.obj (weilEtaleLocalFreeSheaf S m W) ⟶ weilEtaleLocalTorsionSheaf S m W :=
    fun W => (eLoc W (weilEtaleLocalTorsionSheaf S m W)).symm
      (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m W))
  have hIsoLoc : ∀ W : S.Etale,
      (α_loc W ≫ β_loc W = CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m W)) ∧
      (β_loc W ≫ α_loc W = CategoryTheory.CategoryStruct.id (U_of.obj (weilEtaleLocalFreeSheaf S m W))) := by
    intro W
    have h1 : α_loc W ≫ β_loc W =
        CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m W) := by
      rw [← heLoc_eq W _ (β_loc W)]
      exact Equiv.apply_symm_apply _ _
    refine ⟨h1, ?_⟩
    apply (eLoc W (U_of.obj (weilEtaleLocalFreeSheaf S m W))).injective
    rw [heLoc_eq, heLoc_eq, ← CategoryTheory.Category.assoc, h1,
      CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]

  have hNatMap : ∀ {U' U : S.Etale} (v : U' ⟶ U),
      U_of.map (weilEtaleLocalFreeMap S m v) ≫ β_loc U =
        β_loc U' ≫ weilEtaleLocalTorsionMap S m v := by
    intro U' U v
    have hα_nat : α_loc U' ≫ U_of.map (weilEtaleLocalFreeMap S m v) =
        weilEtaleLocalTorsionMap S m v ≫ α_loc U := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hFreeYonedaComp, hFreeYonedaComp]
      have hαU' : CategoryTheory.Sheaf.freeYonedaHomEquiv (α_loc U') =
          ιM ≫ FgtMod.map (η_mod U') := Equiv.apply_symm_apply _ _
      have hαU : CategoryTheory.Sheaf.freeYonedaHomEquiv (α_loc U) =
          ιM ≫ FgtMod.map (η_mod U) := Equiv.apply_symm_apply _ _
      have hModMap : η_mod U' ≫ (weilEtaleLocalFreeMap S m v).hom.app (Opposite.op U') =
          η_mod U ≫ (weilEtaleLocalFreeSheaf S m U).obj.map (Opposite.op v) := by
        have hcomp := hFreeYonedaComp
          (CategoryTheory.CategoryStruct.id (weilEtaleLocalFreeSheaf S m U'))
          (weilEtaleLocalFreeMap S m v)
        rw [CategoryTheory.Category.id_comp] at hcomp
        exact hcomp.symm.trans (Equiv.apply_symm_apply _ _)
      have hTorsMap : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap S m v) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m U)) ≫
            (weilEtaleLocalTorsionSheaf S m U).obj.map (Opposite.op v) :=
        Equiv.apply_symm_apply _ _
      have hα_app_U : CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m U)) ≫
            (α_loc U).hom.app (Opposite.op U) =
          ιM ≫ FgtMod.map (η_mod U) := by
        rw [← hFreeYonedaComp _ (α_loc U), CategoryTheory.Category.id_comp, hαU]
      calc
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α_loc U') ≫
            (U_of.map (weilEtaleLocalFreeMap S m v)).hom.app (Opposite.op U')
          = ιM ≫ FgtMod.map (η_mod U' ≫ (weilEtaleLocalFreeMap S m v).hom.app (Opposite.op U')) := by
              rw [hαU', FgtMod.map_comp, CategoryTheory.Category.assoc]
              rfl
        _ = (ιM ≫ FgtMod.map (η_mod U)) ≫
              (U_of.obj (weilEtaleLocalFreeSheaf S m U)).obj.map (Opposite.op v) := by
              rw [hModMap, FgtMod.map_comp, CategoryTheory.Category.assoc]
              rfl
        _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
              (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m U)) ≫
              (α_loc U).hom.app (Opposite.op U)) ≫
              (U_of.obj (weilEtaleLocalFreeSheaf S m U)).obj.map (Opposite.op v) := by
              rw [hα_app_U]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap S m v) ≫
              (α_loc U).hom.app (Opposite.op U') := by
              rw [CategoryTheory.Category.assoc, ← (α_loc U).hom.naturality (Opposite.op v),
                ← CategoryTheory.Category.assoc, hTorsMap]
    calc
      U_of.map (weilEtaleLocalFreeMap S m v) ≫ β_loc U
        = (β_loc U' ≫ α_loc U') ≫ U_of.map (weilEtaleLocalFreeMap S m v) ≫ β_loc U := by
            rw [(hIsoLoc U').2, CategoryTheory.Category.id_comp]
      _ = β_loc U' ≫ (α_loc U' ≫ U_of.map (weilEtaleLocalFreeMap S m v)) ≫ β_loc U := by
            simp only [CategoryTheory.Category.assoc]
      _ = β_loc U' ≫ weilEtaleLocalTorsionMap S m v ≫ (α_loc U ≫ β_loc U) := by
            rw [hα_nat, CategoryTheory.Category.assoc]
      _ = β_loc U' ≫ weilEtaleLocalTorsionMap S m v := by
            rw [(hIsoLoc U).1, CategoryTheory.Category.comp_id]

  have hConstUnitApp : ∀ {D : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} D]
      [CategoryTheory.HasWeakSheafify S.smallEtaleTopology D] (X : D),
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology D hT).unit.app X =
        (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology D).unit.app
          ((CategoryTheory.Functor.const (Opposite S.Etale)).obj X)).app (Opposite.op T)) := by
    intro D _ _ X
    change ((CategoryTheory.constantPresheafAdj D hT).comp
      (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology D)).unit.app X = _
    rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.constantPresheafAdj_unit_app,
      CategoryTheory.Category.id_comp]
    rfl

  have hNatCounit : ∀ W : S.Etale,
      U_of.map (weilEtaleLocalCounit S m W) ≫ βM =
        β_loc W ≫ weilEtaleLocalTorsionCounit S m W := by
    intro W
    let τ_W : W ⟶ T := hT.from W
    have hα_counit : α_loc W ≫ U_of.map (weilEtaleLocalCounit S m W) =
        weilEtaleLocalTorsionCounit S m W ≫ αM := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hFreeYonedaComp, hFreeYonedaComp]
      have hαW : CategoryTheory.Sheaf.freeYonedaHomEquiv (α_loc W) =
          ιM ≫ FgtMod.map (η_mod W) := Equiv.apply_symm_apply _ _
      have hCounitMod : η_mod W ≫ (weilEtaleLocalCounit S m W).hom.app (Opposite.op W) =
          adjR.unit.app R_mod ≫ oneR.obj.map (Opposite.op τ_W) := by
        have hcomp := hFreeYonedaComp
          (CategoryTheory.CategoryStruct.id (weilEtaleLocalFreeSheaf S m W))
          (weilEtaleLocalCounit S m W)
        rw [CategoryTheory.Category.id_comp] at hcomp
        let uR := (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
          (ModuleCat.{u, u} R)).unit.app
          ((CategoryTheory.Functor.const (Opposite S.Etale)).obj R_mod)
        have h1 : η_mod W ≫ (weilEtaleLocalCounit S m W).hom.app (Opposite.op W) =
            (uR.app (Opposite.op W) : R_mod ⟶ oneR.obj.obj (Opposite.op W)) :=
          hcomp.symm.trans (Equiv.apply_symm_apply _ _)
        have hnat : CategoryTheory.CategoryStruct.id R_mod ≫
            (uR.app (Opposite.op W) : R_mod ⟶ oneR.obj.obj (Opposite.op W)) =
            (uR.app (Opposite.op T) : R_mod ⟶ oneR.obj.obj (Opposite.op T)) ≫
            oneR.obj.map (Opposite.op τ_W) :=
          uR.naturality (Opposite.op τ_W)
        rw [CategoryTheory.Category.id_comp] at hnat
        rw [h1, hnat, ← hConstUnitApp R_mod]
        rfl
      have hCounitTors : CategoryTheory.Sheaf.freeYonedaHomEquiv
            (weilEtaleLocalTorsionCounit S m W) =
          adjℤ.unit.app AM ≫ FM.obj.map (Opposite.op τ_W) := by
        let uZ := (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
          AddCommGrpCat.{u}).unit.app
          ((CategoryTheory.Functor.const (Opposite S.Etale)).obj AM)
        have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionCounit S m W) =
            (uZ.app (Opposite.op W) : AM ⟶ FM.obj.obj (Opposite.op W)) :=
          Equiv.apply_symm_apply _ _
        have hnat : CategoryTheory.CategoryStruct.id AM ≫
            (uZ.app (Opposite.op W) : AM ⟶ FM.obj.obj (Opposite.op W)) =
            (uZ.app (Opposite.op T) : AM ⟶ FM.obj.obj (Opposite.op T)) ≫
            FM.obj.map (Opposite.op τ_W) :=
          uZ.naturality (Opposite.op τ_W)
        rw [CategoryTheory.Category.id_comp] at hnat
        rw [h1, hnat, ← hConstUnitApp AM]
        rfl
      calc
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α_loc W) ≫
            (U_of.map (weilEtaleLocalCounit S m W)).hom.app (Opposite.op W)
          = ιM ≫ FgtMod.map (η_mod W ≫ (weilEtaleLocalCounit S m W).hom.app (Opposite.op W)) := by
              rw [hαW, FgtMod.map_comp, CategoryTheory.Category.assoc]
              rfl
        _ = (ιM ≫ FgtMod.map (adjR.unit.app R_mod)) ≫
              (U_of.obj oneR).obj.map (Opposite.op τ_W) := by
              rw [hCounitMod, FgtMod.map_comp, CategoryTheory.Category.assoc]
              rfl
        _ = (adjℤ.homEquiv AM (U_of.obj oneR) αM) ≫
              (U_of.obj oneR).obj.map (Opposite.op τ_W) := by
              rw [Equiv.apply_symm_apply]
        _ = (adjℤ.unit.app AM ≫ αM.hom.app (Opposite.op T)) ≫
              (U_of.obj oneR).obj.map (Opposite.op τ_W) := by
              rw [CategoryTheory.Adjunction.homEquiv_unit adjℤ AM (U_of.obj oneR) αM]
              rfl
        _ = adjℤ.unit.app AM ≫ (FM.obj.map (Opposite.op τ_W) ≫ αM.hom.app (Opposite.op W)) := by
              rw [CategoryTheory.Category.assoc, ← αM.hom.naturality (Opposite.op τ_W)]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionCounit S m W) ≫
              αM.hom.app (Opposite.op W) := by
              rw [← CategoryTheory.Category.assoc, ← hCounitTors]
    calc
      U_of.map (weilEtaleLocalCounit S m W) ≫ βM
        = (β_loc W ≫ α_loc W) ≫ U_of.map (weilEtaleLocalCounit S m W) ≫ βM := by
            rw [(hIsoLoc W).2, CategoryTheory.Category.id_comp]
      _ = β_loc W ≫ (α_loc W ≫ U_of.map (weilEtaleLocalCounit S m W)) ≫ βM := by
            simp only [CategoryTheory.Category.assoc]
      _ = β_loc W ≫ weilEtaleLocalTorsionCounit S m W ≫ (αM ≫ βM) := by
            rw [hα_counit, CategoryTheory.Category.assoc]
      _ = β_loc W ≫ weilEtaleLocalTorsionCounit S m W := by
            rw [hαβ, CategoryTheory.Category.comp_id]

  
  let TF : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} → Prop :=
    fun K_sh => ∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id K_sh)

  have hMonoAℤ : ∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id Aℤ) := by
    intro n hn
    rw [AddCommGrpCat.mono_iff_injective]
    have hApp : ∀ (k : ℕ) (x : Aℤ), (k • CategoryTheory.CategoryStruct.id Aℤ).hom x = k • x := by
      intro k x
      induction k with
      | zero => simp
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul, AddCommGrpCat.hom_add, AddMonoidHom.add_apply, ih]
        rfl
    intro x y hxy
    rw [hApp n x, hApp n y] at hxy
    have hdown : n • x.down = n • y.down := congrArg ULift.down hxy
    rw [nsmul_eq_mul, nsmul_eq_mul] at hdown
    exact ULift.ext _ _ (mul_left_cancel₀ (Nat.cast_ne_zero.mpr hn) hdown)

  have hInitTF : TF Fℤ := by
    intro n hn
    let P₀ : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
      (CategoryTheory.Functor.const (Opposite S.Etale)).obj Aℤ
    have hAppP₀ : ∀ (k : ℕ) (W : Opposite S.Etale),
        (k • CategoryTheory.CategoryStruct.id P₀).app W =
          k • CategoryTheory.CategoryStruct.id Aℤ := by
      intro k W
      induction k with
      | zero => simp
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul, CategoryTheory.NatTrans.app_add, ih]
        rfl
    have _ : ∀ W : Opposite S.Etale,
        CategoryTheory.Mono ((n • CategoryTheory.CategoryStruct.id P₀).app W) := by
      intro W
      rw [hAppP₀ n W]
      exact hMonoAℤ n hn
    have _ : CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id P₀) :=
      CategoryTheory.NatTrans.mono_of_mono_app (n • CategoryTheory.CategoryStruct.id P₀)
    let ShF := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    have hMapEq : ShF.map (n • CategoryTheory.CategoryStruct.id P₀) =
        n • CategoryTheory.CategoryStruct.id Fℤ := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      rfl
    rw [← hMapEq]
    exact CategoryTheory.Functor.map_mono ShF (n • CategoryTheory.CategoryStruct.id P₀)

  have hSigmaMono : ∀ (C : Type (u + 1)) [CategoryTheory.Category.{u, u + 1} C]
      [CategoryTheory.Abelian C] [CategoryTheory.IsGrothendieckAbelian.{u} C]
      (I : Type u) (fam : I → C) (n : ℕ),
      (∀ i : I, CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id (fam i))) →
      letI : CategoryTheory.Limits.HasColimitsOfSize.{u, u, u, u + 1} C :=
        CategoryTheory.IsGrothendieckAbelian.hasColimits C
      letI : CategoryTheory.Limits.HasColimitsOfSize.{0, u, u, u + 1} C :=
        CategoryTheory.Limits.hasColimitsOfSizeShrink.{0, u, u, u} C
      CategoryTheory.Mono
        (n • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.sigmaObj fam)) := by
    intro C _ _ _ I fam n hFam
    have _ : CategoryTheory.Limits.HasColimitsOfSize.{u, u, u, u + 1} C :=
      CategoryTheory.IsGrothendieckAbelian.hasColimits C
    have _ : CategoryTheory.Limits.HasColimitsOfSize.{0, u, u, u + 1} C :=
      CategoryTheory.Limits.hasColimitsOfSizeShrink.{0, u, u, u} C
    have _ : CategoryTheory.HasExactColimitsOfShape (CategoryTheory.Discrete I) C :=
      CategoryTheory.AB4OfSize.ofShape I
    let F_fam := CategoryTheory.Discrete.functor fam
    let φ_n : F_fam ⟶ F_fam := n • CategoryTheory.CategoryStruct.id F_fam
    have hAppφ : ∀ (k : ℕ) (j : CategoryTheory.Discrete I),
        (k • CategoryTheory.CategoryStruct.id F_fam).app j =
          k • CategoryTheory.CategoryStruct.id (F_fam.obj j) := by
      intro k j
      induction k with
      | zero => simp
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul, CategoryTheory.NatTrans.app_add, ih]
        rfl
    have _ : ∀ j : CategoryTheory.Discrete I, CategoryTheory.Mono (φ_n.app j) := by
      rintro ⟨i⟩
      rw [hAppφ n ⟨i⟩]
      exact hFam i
    have _ : CategoryTheory.Mono φ_n := CategoryTheory.NatTrans.mono_of_mono_app φ_n
    exact CategoryTheory.Limits.colim.map_mono' φ_n
      (CategoryTheory.Limits.colimit.isColimit F_fam)
      (CategoryTheory.Limits.colimit.isColimit F_fam)
      (n • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.sigmaObj fam))
      (fun j => by
        dsimp [φ_n]
        rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Preadditive.nsmul_comp,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])

  have hGrothCover : ∀ (C : Type (u + 1)) [CategoryTheory.Category.{u + 1, u + 1} C]
      [CategoryTheory.Abelian C] [CategoryTheory.IsGrothendieckAbelian.{u} C]
      (I : Type u) (fam : I → C) (E_obj : C) (mor : ∀ i : I, fam i ⟶ E_obj),
      (∀ (i : I) (n : ℕ), n ≠ 0 →
        CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id (fam i))) →
      (∀ {E'_obj : C} (u₁ u₂ : E_obj ⟶ E'_obj),
        (∀ i : I, mor i ≫ u₁ = mor i ≫ u₂) → u₁ = u₂) →
      ∃ (P_obj : C) (π : P_obj ⟶ E_obj),
        CategoryTheory.Epi π ∧
        (∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id P_obj)) := by
    intro C _ _ _ I fam E_obj mor hFamTF hSep
    have _ : CategoryTheory.Limits.HasColimitsOfSize.{u, u, u + 1, u + 1} C :=
      CategoryTheory.IsGrothendieckAbelian.hasColimits C
    have _ : CategoryTheory.Limits.HasColimitsOfSize.{0, u, u + 1, u + 1} C :=
      CategoryTheory.Limits.hasColimitsOfSizeShrink.{0, u, u, u} C
    have _ : CategoryTheory.HasExactColimitsOfShape (CategoryTheory.Discrete I) C :=
      CategoryTheory.AB4OfSize.ofShape I
    let P_obj : C := CategoryTheory.Limits.sigmaObj fam
    let π : P_obj ⟶ E_obj := CategoryTheory.Limits.Sigma.desc mor
    have hEpi : CategoryTheory.Epi π :=
      ⟨fun u₁ u₂ hu => hSep u₁ u₂ fun i => by
        have hi := congrArg (CategoryTheory.Limits.Sigma.ι fam i ≫ ·) hu
        dsimp [π] at hi
        rwa [CategoryTheory.Limits.Sigma.ι_comp_desc_assoc,
          CategoryTheory.Limits.Sigma.ι_comp_desc_assoc] at hi⟩
    refine ⟨P_obj, π, hEpi, fun n hn => ?_⟩
    let F_fam := CategoryTheory.Discrete.functor fam
    let φ_n : F_fam ⟶ F_fam := n • CategoryTheory.CategoryStruct.id F_fam
    have hAppφ : ∀ (k : ℕ) (j : CategoryTheory.Discrete I),
        (k • CategoryTheory.CategoryStruct.id F_fam).app j =
          k • CategoryTheory.CategoryStruct.id (F_fam.obj j) := by
      intro k j
      induction k with
      | zero => simp
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul, CategoryTheory.NatTrans.app_add, ih]
        rfl
    have _ : ∀ j : CategoryTheory.Discrete I, CategoryTheory.Mono (φ_n.app j) := by
      rintro ⟨i⟩
      rw [hAppφ n ⟨i⟩]
      exact hFamTF i n hn
    have _ : CategoryTheory.Mono φ_n := CategoryTheory.NatTrans.mono_of_mono_app φ_n
    exact CategoryTheory.Limits.colim.map_mono' φ_n
      (CategoryTheory.Limits.colimit.isColimit F_fam)
      (CategoryTheory.Limits.colimit.isColimit F_fam)
      (n • CategoryTheory.CategoryStruct.id P_obj)
      (fun j => by
        dsimp [φ_n]
        rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Preadditive.nsmul_comp,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])

  have hCoverTF : ∀ E_obj : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u},
      ∃ (P_obj : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (π : P_obj ⟶ E_obj),
        CategoryTheory.Epi π ∧ TF P_obj := by
    intro E_obj
    let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology S
    let C₀ : Type u := CategoryTheory.SmallModel.{u} S.AffineEtale
    let eAff := CategoryTheory.equivSmallModel.{u} S.AffineEtale
    let Eqv := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv S AddCommGrpCat.{u}
    have _ : CategoryTheory.Limits.PreservesBinaryBiproducts Eqv.functor :=
      CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryProducts Eqv.functor
    have _ : Eqv.functor.Additive :=
      CategoryTheory.Functor.additive_of_preservesBinaryBiproducts Eqv.functor
    let Y_aff : C₀ → CategoryTheory.Sheaf J_aff AddCommGrpCat.{u} :=
      fun x => CategoryTheory.Sheaf.freeYoneda J_aff (eAff.inverse.obj x) Aℤ
    let Y_et : C₀ → CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
      fun x => Eqv.functor.obj (Y_aff x)
    have hY_tf : ∀ x : C₀, TF (Y_et x) := by
      intro x n hn
      let P_x := CategoryTheory.Presheaf.freeYoneda (eAff.inverse.obj x) Aℤ
      have hAppPx : ∀ (k : ℕ) (V : Opposite S.AffineEtale),
          (k • CategoryTheory.CategoryStruct.id P_x).app V =
            k • CategoryTheory.CategoryStruct.id (P_x.obj V) := by
        intro k V
        induction k with
        | zero => simp
        | succ k ih =>
          rw [succ_nsmul, succ_nsmul, CategoryTheory.NatTrans.app_add, ih]
          rfl
      have _ : ∀ V : Opposite S.AffineEtale,
          CategoryTheory.Mono ((n • CategoryTheory.CategoryStruct.id P_x).app V) := by
        intro V
        rw [hAppPx n V, CategoryTheory.Presheaf.freeYoneda_obj]
        exact hSigmaMono AddCommGrpCat.{u} (Opposite.unop V ⟶ eAff.inverse.obj x)
          (fun _ => Aℤ) n (fun _ => hMonoAℤ n hn)
      have _ : CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id P_x) :=
        CategoryTheory.NatTrans.mono_of_mono_app (n • CategoryTheory.CategoryStruct.id P_x)
      let ShAff := CategoryTheory.presheafToSheaf J_aff AddCommGrpCat.{u}
      have hMapAff : ShAff.map (n • CategoryTheory.CategoryStruct.id P_x) =
          n • CategoryTheory.CategoryStruct.id (Y_aff x) := by
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
        rfl
      have _ : CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id (Y_aff x)) := by
        rw [← hMapAff]
        exact CategoryTheory.Functor.map_mono ShAff (n • CategoryTheory.CategoryStruct.id P_x)
      have hMapEt : Eqv.functor.map (n • CategoryTheory.CategoryStruct.id (Y_aff x)) =
          n • CategoryTheory.CategoryStruct.id (Y_et x) := by
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      rw [← hMapEt]
      exact CategoryTheory.Functor.map_mono Eqv.functor _
    have _ : CategoryTheory.LocallySmall.{u}
        (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.IsGrothendieckAbelian.locallySmall
    let Idx : Type u := Σ x : C₀, Shrink.{u} (Y_et x ⟶ E_obj)
    let fam : Idx → CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
      fun p => Y_et p.1
    let mor : ∀ p : Idx, fam p ⟶ E_obj :=
      fun p => (equivShrink (Y_et p.1 ⟶ E_obj)).symm p.2
    refine hGrothCover (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      Idx fam E_obj mor (fun p n hn => hY_tf p.1 n hn) ?_
    intro E'_obj u₁ u₂ hMor
    have hAllEt : ∀ (x : C₀) (g : Y_et x ⟶ E_obj), g ≫ u₁ = g ≫ u₂ := by
      intro x g
      simpa [mor] using hMor ⟨x, equivShrink (Y_et x ⟶ E_obj) g⟩
    apply Eqv.inverse.map_injective
    apply CategoryTheory.Sheaf.hom_ext
    ext V s
    let W_V : S.AffineEtale := Opposite.unop V
    let x : C₀ := eAff.functor.obj W_V
    let eV : eAff.inverse.obj x ≅ W_V := (eAff.unitIso.app W_V).symm
    let s' : ↑((Eqv.inverse.obj E_obj).obj.obj (Opposite.op (eAff.inverse.obj x))) :=
      ((Eqv.inverse.obj E_obj).obj.map eV.hom.op).hom s
    let φ_s' : Aℤ ⟶ (Eqv.inverse.obj E_obj).obj.obj (Opposite.op (eAff.inverse.obj x)) :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • s'
          map_zero' := zero_zsmul s'
          map_add' := fun a b => add_zsmul s' a.down b.down }
    let β : Y_aff x ⟶ Eqv.inverse.obj E_obj := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm φ_s'
    let g_et : Y_et x ⟶ E_obj := Eqv.functor.map β ≫ Eqv.counitIso.hom.app E_obj
    have hg_eq : g_et ≫ u₁ = g_et ≫ u₂ := hAllEt x g_et
    have hβ_eq : β ≫ Eqv.inverse.map u₁ = β ≫ Eqv.inverse.map u₂ := by
      have h1 : Eqv.functor.map (β ≫ Eqv.inverse.map u₁) ≫ Eqv.counitIso.hom.app E'_obj =
          Eqv.functor.map (β ≫ Eqv.inverse.map u₂) ≫ Eqv.counitIso.hom.app E'_obj := by
        simpa [g_et, CategoryTheory.Category.assoc, Eqv.counitIso.hom.naturality] using hg_eq
      exact Eqv.functor.map_injective ((cancel_mono (Eqv.counitIso.hom.app E'_obj)).mp h1)
    have hFreeCompAff : ∀ {F G : CategoryTheory.Sheaf J_aff AddCommGrpCat.{u}}
        (α : Y_aff x ⟶ F) (h : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ h) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫
            h.hom.app (Opposite.op (eAff.inverse.obj x)) := by
      intro F G α h
      let α' : (CategoryTheory.presheafToSheaf J_aff AddCommGrpCat.{u}).obj
          (CategoryTheory.Presheaf.freeYoneda (eAff.inverse.obj x) Aℤ) ⟶ F := α
      calc
        CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction J_aff AddCommGrpCat.{u}).homEquiv _ G)
              (α' ≫ h))
          = CategoryTheory.Presheaf.freeYonedaHomEquiv
              (((CategoryTheory.sheafificationAdjunction J_aff AddCommGrpCat.{u}).homEquiv _ F) α' ≫
                (CategoryTheory.sheafToPresheaf J_aff AddCommGrpCat.{u}).map h) := by
              rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫
              h.hom.app (Opposite.op (eAff.inverse.obj x)) :=
              CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _
    have hEv := congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv hβ_eq
    rw [hFreeCompAff, hFreeCompAff, Equiv.apply_symm_apply] at hEv
    have hs'_eq : ((Eqv.inverse.map u₁).hom.app (Opposite.op (eAff.inverse.obj x))).hom s' =
        ((Eqv.inverse.map u₂).hom.app (Opposite.op (eAff.inverse.obj x))).hom s' := by
      have h1 : (φ_s' ≫ (Eqv.inverse.map u₁).hom.app (Opposite.op (eAff.inverse.obj x))).hom
          (ULift.up (1 : ℤ)) =
        (φ_s' ≫ (Eqv.inverse.map u₂).hom.app (Opposite.op (eAff.inverse.obj x))).hom
          (ULift.up (1 : ℤ)) :=
        congrArg (fun k => k.hom (ULift.up (1 : ℤ))) hEv
      change ((Eqv.inverse.map u₁).hom.app (Opposite.op (eAff.inverse.obj x))).hom
          ((1 : ℤ) • s') =
        ((Eqv.inverse.map u₂).hom.app (Opposite.op (eAff.inverse.obj x))).hom
          ((1 : ℤ) • s') at h1
      rwa [one_zsmul] at h1
    have hTrans : ∀ u : E_obj ⟶ E'_obj,
        ((Eqv.inverse.obj E'_obj).obj.map eV.inv.op).hom
          (((Eqv.inverse.map u).hom.app (Opposite.op (eAff.inverse.obj x))).hom s') =
        ((Eqv.inverse.map u).hom.app V).hom s := by
      intro u
      have hnat : ((Eqv.inverse.map u).hom.app V).hom
          (((Eqv.inverse.obj E_obj).obj.map eV.inv.op).hom s') =
        ((Eqv.inverse.obj E'_obj).obj.map eV.inv.op).hom
          (((Eqv.inverse.map u).hom.app (Opposite.op (eAff.inverse.obj x))).hom s') :=
        congrArg (fun k => k.hom s') ((Eqv.inverse.map u).hom.naturality eV.inv.op)
      rw [← hnat]
      have h_id : (((Eqv.inverse.obj E_obj).obj.map eV.hom.op) ≫
          (Eqv.inverse.obj E_obj).obj.map eV.inv.op) =
          CategoryTheory.CategoryStruct.id ((Eqv.inverse.obj E_obj).obj.obj V) := by
        rw [← (Eqv.inverse.obj E_obj).obj.map_comp, ← op_comp, eV.inv_hom_id, op_id,
          (Eqv.inverse.obj E_obj).obj.map_id]
      have hs_id : ((Eqv.inverse.obj E_obj).obj.map eV.inv.op).hom s' = s :=
        congrArg (fun k => k.hom s) h_id
      rw [hs_id]
    rw [← hTrans u₁, ← hTrans u₂, hs'_eq]

  
  have hCsh_mono : ∀ {G₁ G₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (u : G₁ ⟶ G₂) [CategoryTheory.Mono u], CategoryTheory.Mono (C_sh.map u) := by
    intro G₁ G₂ u _
    refine ⟨fun {F_sh} f₁ f₂ hf => ?_⟩
    apply (eShR F_sh G₁).symm.injective
    rw [← cancel_mono u]
    have hnat : ∀ f : F_sh ⟶ C_sh.obj G₁,
        (eShR F_sh G₁).symm f ≫ u = (eShR F_sh G₂).symm (f ≫ C_sh.map u) := by
      intro f
      apply CategoryTheory.Sheaf.hom_ext
      ext W x
      rfl
    rw [hnat f₁, hnat f₂, hf]

  have hExtInj : ∀ (I_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R))
      [CategoryTheory.Injective I_sh]
      (S_ex : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})),
      S_ex.ShortExact → TF S_ex.X₃ →
      ∀ g₀ : S_ex.X₁ ⟶ U_of.obj I_sh, ∃ h : S_ex.X₂ ⟶ U_of.obj I_sh, S_ex.f ≫ h = g₀ := by
    intro I_sh _ S_ex hEx hTF g₀
    have _ : CategoryTheory.Mono S_ex.f := hEx.mono_f
    have _ : CategoryTheory.Epi S_ex.g := hEx.epi_g
    let m₁ : S_ex.X₁ ⟶ S_ex.X₁ := m • CategoryTheory.CategoryStruct.id S_ex.X₁
    let m₂ : S_ex.X₂ ⟶ S_ex.X₂ := m • CategoryTheory.CategoryStruct.id S_ex.X₂
    let m₃ : S_ex.X₃ ⟶ S_ex.X₃ := m • CategoryTheory.CategoryStruct.id S_ex.X₃
    let K'_bar := CategoryTheory.Limits.cokernel m₁
    let P_bar := CategoryTheory.Limits.cokernel m₂
    let p₁ : S_ex.X₁ ⟶ K'_bar := CategoryTheory.Limits.cokernel.π m₁
    let p₂ : S_ex.X₂ ⟶ P_bar := CategoryTheory.Limits.cokernel.π m₂
    have hm₁_p₂ : m₁ ≫ (S_ex.f ≫ p₂) = 0 := by
      calc
        (m • CategoryTheory.CategoryStruct.id S_ex.X₁) ≫ (S_ex.f ≫ p₂)
          = m • (CategoryTheory.CategoryStruct.id S_ex.X₁ ≫ (S_ex.f ≫ p₂)) :=
              CategoryTheory.Preadditive.nsmul_comp _ _ _
        _ = m • (S_ex.f ≫ p₂) := by rw [CategoryTheory.Category.id_comp]
        _ = S_ex.f ≫ (m • p₂) := (CategoryTheory.Preadditive.comp_nsmul _ _ _).symm
        _ = S_ex.f ≫ (m • (CategoryTheory.CategoryStruct.id S_ex.X₂ ≫ p₂)) := by
              rw [CategoryTheory.Category.id_comp]
        _ = S_ex.f ≫ (m₂ ≫ p₂) := by rw [← CategoryTheory.Preadditive.nsmul_comp]
        _ = S_ex.f ≫ 0 := by rw [CategoryTheory.Limits.cokernel.condition m₂]
        _ = 0 := CategoryTheory.Limits.comp_zero
    let ι_bar : K'_bar ⟶ P_bar := CategoryTheory.Limits.cokernel.desc m₁ (S_ex.f ≫ p₂) hm₁_p₂
    have hp₁_ι : p₁ ≫ ι_bar = S_ex.f ≫ p₂ :=
      CategoryTheory.Limits.cokernel.π_desc m₁ (S_ex.f ≫ p₂) hm₁_p₂
    have hMono_ιbar : CategoryTheory.Mono ι_bar := by
      apply CategoryTheory.Abelian.Pseudoelement.mono_of_zero_of_map_zero
      intro a_bar ha_bar
      obtain ⟨a, rfl⟩ := CategoryTheory.Abelian.Pseudoelement.pseudo_surjective_of_epi p₁ a_bar
      have hp₂_fa : CategoryTheory.Abelian.Pseudoelement.pseudoApply p₂
          (CategoryTheory.Abelian.Pseudoelement.pseudoApply S_ex.f a) = 0 := by
        rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply, ← hp₁_ι,
          CategoryTheory.Abelian.Pseudoelement.comp_apply, ha_bar]
      obtain ⟨b, hb⟩ := CategoryTheory.Abelian.Pseudoelement.pseudo_exact_of_exact
        (CategoryTheory.ShortComplex.exact_cokernel m₂) _ hp₂_fa
      by_cases hm0 : m = 0
      · have hm₂_zero : m₂ = 0 := by
          dsimp [m₂]
          rw [hm0, zero_nsmul]
        rw [hm₂_zero, CategoryTheory.Abelian.Pseudoelement.zero_apply] at hb
        have ha0 : a = 0 :=
          CategoryTheory.Abelian.Pseudoelement.zero_of_map_zero S_ex.f
            (CategoryTheory.Abelian.Pseudoelement.pseudo_injective_of_mono S_ex.f) a hb.symm
        rw [ha0, CategoryTheory.Abelian.Pseudoelement.apply_zero]
      · have _ : CategoryTheory.Mono m₃ := hTF m hm0
        have hm₃_gb : CategoryTheory.Abelian.Pseudoelement.pseudoApply m₃
            (CategoryTheory.Abelian.Pseudoelement.pseudoApply S_ex.g b) = 0 := by
          have hcomm_g : S_ex.g ≫ m₃ = m₂ ≫ S_ex.g := by
            dsimp [m₂, m₃]
            rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Preadditive.nsmul_comp,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
          rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply, hcomm_g,
            CategoryTheory.Abelian.Pseudoelement.comp_apply, hb,
            ← CategoryTheory.Abelian.Pseudoelement.comp_apply, S_ex.zero,
            CategoryTheory.Abelian.Pseudoelement.zero_apply]
        have hgb0 : CategoryTheory.Abelian.Pseudoelement.pseudoApply S_ex.g b = 0 :=
          CategoryTheory.Abelian.Pseudoelement.zero_of_map_zero m₃
            (CategoryTheory.Abelian.Pseudoelement.pseudo_injective_of_mono m₃) _ hm₃_gb
        obtain ⟨c, hc⟩ :=
          CategoryTheory.Abelian.Pseudoelement.pseudo_exact_of_exact hEx.exact b hgb0
        have hcomm_f : m₁ ≫ S_ex.f = S_ex.f ≫ m₂ := by
          dsimp [m₁, m₂]
          rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Preadditive.comp_nsmul,
            CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
        have hfc_eq : CategoryTheory.Abelian.Pseudoelement.pseudoApply S_ex.f
            (CategoryTheory.Abelian.Pseudoelement.pseudoApply m₁ c) =
            CategoryTheory.Abelian.Pseudoelement.pseudoApply S_ex.f a := by
          rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply, hcomm_f,
            CategoryTheory.Abelian.Pseudoelement.comp_apply, hc, hb]
        have hc_a : CategoryTheory.Abelian.Pseudoelement.pseudoApply m₁ c = a :=
          CategoryTheory.Abelian.Pseudoelement.pseudo_injective_of_mono S_ex.f hfc_eq
        rw [← hc_a, ← CategoryTheory.Abelian.Pseudoelement.comp_apply,
          CategoryTheory.Limits.cokernel.condition m₁,
          CategoryTheory.Abelian.Pseudoelement.zero_apply]
    have _ : CategoryTheory.Mono (C_sh.map ι_bar) := hCsh_mono ι_bar
    have hAnnCoker : ∀ {X : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}},
        m • CategoryTheory.CategoryStruct.id
          (CategoryTheory.Limits.cokernel (m • CategoryTheory.CategoryStruct.id X)) = 0 := by
      intro X
      let mX := m • CategoryTheory.CategoryStruct.id X
      let pX := CategoryTheory.Limits.cokernel.π mX
      rw [← cancel_epi pX, CategoryTheory.Limits.comp_zero]
      calc
        pX ≫ (m • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.cokernel mX))
          = m • (pX ≫ CategoryTheory.CategoryStruct.id _) :=
              CategoryTheory.Preadditive.comp_nsmul _ _ _
        _ = m • pX := by rw [CategoryTheory.Category.comp_id]
        _ = m • (CategoryTheory.CategoryStruct.id X ≫ pX) := by
              rw [CategoryTheory.Category.id_comp]
        _ = mX ≫ pX := (CategoryTheory.Preadditive.nsmul_comp _ _ _).symm
        _ = 0 := CategoryTheory.Limits.cokernel.condition mX
    have hSecAnn : ∀ {B_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}},
        m • CategoryTheory.CategoryStruct.id B_sh = 0 →
        ∀ (W : Opposite S.Etale) (x : ↑(B_sh.obj.obj W)), m • x = 0 := by
      intro B_sh hB W x
      let S2P := CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}
      have hApp : ∀ k : ℕ,
          (S2P.map (k • CategoryTheory.CategoryStruct.id B_sh)).app W =
            k • CategoryTheory.CategoryStruct.id (B_sh.obj.obj W) := by
        intro k
        induction k with
        | zero => simp
        | succ k ih =>
          rw [succ_nsmul, succ_nsmul, S2P.map_add, CategoryTheory.NatTrans.app_add, ih]
          rfl
      have hAppVal : ∀ (k : ℕ) (A : AddCommGrpCat.{u}) (y : A),
          (k • CategoryTheory.CategoryStruct.id A).hom y = k • y := by
        intro k A y
        induction k with
        | zero => simp
        | succ k ih =>
          rw [succ_nsmul, succ_nsmul, AddCommGrpCat.hom_add, AddMonoidHom.add_apply, ih]
          rfl
      have h0 := ConcreteCategory.congr_hom
        (congrArg (fun φ => (S2P.map φ).app W) hB) x
      rw [hApp m, hAppVal m _ x] at h0
      exact h0
    let mkDelta : ∀ (B_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
        m • CategoryTheory.CategoryStruct.id B_sh = 0 → (B_sh ⟶ U_of.obj (C_sh.obj B_sh)) :=
      fun B_sh hB =>
        ⟨{ app := fun W => AddCommGrpCat.ofHom
             { toFun := fun x => ⟨x, hSecAnn hB W x⟩
               map_zero' := rfl
               map_add' := fun _ _ => rfl }
           naturality := fun _ _ _ => by ext x; rfl }⟩
    let δ₁ : K'_bar ⟶ U_of.obj (C_sh.obj K'_bar) := mkDelta K'_bar hAnnCoker
    let δ₂ : P_bar ⟶ U_of.obj (C_sh.obj P_bar) := mkDelta P_bar hAnnCoker
    have hδ_nat : ι_bar ≫ δ₂ = δ₁ ≫ U_of.map (C_sh.map ι_bar) := by
      apply CategoryTheory.Sheaf.hom_ext
      ext W x
      rfl
    have hm_UI : m • CategoryTheory.CategoryStruct.id (U_of.obj I_sh) = 0 := by
      rw [← U_of.map_id, ← U_of.map_nsmul]
      let S2P_R := CategoryTheory.sheafToPresheaf S.smallEtaleTopology (ModuleCat.{u, u} R)
      have hm_I : m • CategoryTheory.CategoryStruct.id I_sh = 0 := by
        apply CategoryTheory.Sheaf.hom_ext
        ext W : 2
        apply ModuleCat.hom_ext
        ext x
        have hApp : ∀ k : ℕ,
            ((S2P_R.map (k • CategoryTheory.CategoryStruct.id I_sh)).app W).hom x = k • x := by
          intro k
          induction k with
          | zero => simp
          | succ k ih =>
            rw [succ_nsmul, succ_nsmul, S2P_R.map_add, CategoryTheory.NatTrans.app_add,
              ModuleCat.hom_add, LinearMap.add_apply, ih]
            rfl
        change ((S2P_R.map (m • CategoryTheory.CategoryStruct.id I_sh)).app W).hom x = 0
        rw [hApp m]
        exact hm_mod (I_sh.obj.obj W) x
      rw [hm_I, U_of.map_zero]
    have hm₁_g₀ : m₁ ≫ g₀ = 0 := by
      calc
        (m • CategoryTheory.CategoryStruct.id S_ex.X₁) ≫ g₀
          = m • (CategoryTheory.CategoryStruct.id S_ex.X₁ ≫ g₀) :=
              CategoryTheory.Preadditive.nsmul_comp _ _ _
        _ = m • g₀ := by rw [CategoryTheory.Category.id_comp]
        _ = m • (g₀ ≫ CategoryTheory.CategoryStruct.id (U_of.obj I_sh)) := by
              rw [CategoryTheory.Category.comp_id]
        _ = g₀ ≫ (m • CategoryTheory.CategoryStruct.id (U_of.obj I_sh)) :=
              (CategoryTheory.Preadditive.comp_nsmul _ _ _).symm
        _ = g₀ ≫ 0 := by rw [hm_UI]
        _ = 0 := CategoryTheory.Limits.comp_zero
    let g₀_bar : K'_bar ⟶ U_of.obj I_sh := CategoryTheory.Limits.cokernel.desc m₁ g₀ hm₁_g₀
    have hp₁_g₀ : p₁ ≫ g₀_bar = g₀ := CategoryTheory.Limits.cokernel.π_desc m₁ g₀ hm₁_g₀
    let η_inv_I : C_sh.obj (U_of.obj I_sh) ⟶ I_sh :=
      ⟨{ app := fun W =>
           let pr_add : ↥(C_mod.obj ((U_of.obj I_sh).obj.obj W)) →+ ↑(I_sh.obj.obj W) :=
             { toFun := fun y => y.1
               map_zero' := rfl
               map_add' := fun _ _ => rfl }
           ModuleCat.ofHom
             { toAddHom := pr_add.toAddHom
               map_smul' := fun r y => hR_smul_addHom pr_add r y }
         naturality := fun _ _ _ => by
           apply ModuleCat.hom_ext
           ext y
           rfl }⟩
    let g₀_mod : C_sh.obj K'_bar ⟶ I_sh := C_sh.map g₀_bar ≫ η_inv_I
    have hδ₁_g₀ : δ₁ ≫ U_of.map g₀_mod = g₀_bar := by
      apply CategoryTheory.Sheaf.hom_ext
      ext W x
      rfl
    let h_mod : C_sh.obj P_bar ⟶ I_sh := CategoryTheory.Injective.factorThru g₀_mod (C_sh.map ι_bar)
    have hh_mod : C_sh.map ι_bar ≫ h_mod = g₀_mod :=
      CategoryTheory.Injective.comp_factorThru g₀_mod (C_sh.map ι_bar)
    refine ⟨p₂ ≫ δ₂ ≫ U_of.map h_mod, ?_⟩
    calc
      S_ex.f ≫ p₂ ≫ δ₂ ≫ U_of.map h_mod
        = (S_ex.f ≫ p₂) ≫ δ₂ ≫ U_of.map h_mod := by
            simp only [CategoryTheory.Category.assoc]
      _ = p₁ ≫ (ι_bar ≫ δ₂) ≫ U_of.map h_mod := by
            rw [← hp₁_ι]
            simp only [CategoryTheory.Category.assoc]
      _ = p₁ ≫ δ₁ ≫ U_of.map (C_sh.map ι_bar ≫ h_mod) := by
            rw [hδ_nat, CategoryTheory.Category.assoc, ← U_of.map_comp]
      _ = p₁ ≫ (δ₁ ≫ U_of.map g₀_mod) := by
            rw [hh_mod]
      _ = g₀ := by
            rw [hδ₁_g₀, hp₁_g₀]

  
  have hSubTF : ∀ {K'_sh P_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (ι : K'_sh ⟶ P_sh) [CategoryTheory.Mono ι], TF P_sh → TF K'_sh := by
    intro K'_sh P_sh ι _ hTF_P n hn
    have _ : CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id P_sh) := hTF_P n hn
    have hcomm : (n • CategoryTheory.CategoryStruct.id K'_sh) ≫ ι =
        ι ≫ (n • CategoryTheory.CategoryStruct.id P_sh) := by
      rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Preadditive.comp_nsmul,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    have _ : CategoryTheory.Mono ((n • CategoryTheory.CategoryStruct.id K'_sh) ≫ ι) := by
      rw [hcomm]
      exact CategoryTheory.mono_comp _ _
    exact CategoryTheory.mono_of_mono (n • CategoryTheory.CategoryStruct.id K'_sh) ι

  have hAcyclic : ∀ (I_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R))
      [CategoryTheory.Injective I_sh] (p : ℕ)
      (K : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      TF K → ∀ e : CategoryTheory.Abelian.Ext.{u} K (U_of.obj I_sh) (p + 1), e = 0 := by
    intro I_sh _ p
    let Y := U_of.obj I_sh
    let R_Y := CategoryTheory.InjectiveResolution.of Y
    have hKillEpi : ∀ (r : ℕ)
        (K : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (e : CategoryTheory.Abelian.Ext.{u} K Y (r + 1)),
        ∃ (P : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (π : P ⟶ K),
          CategoryTheory.Epi π ∧ TF P ∧
          (CategoryTheory.Abelian.Ext.mk₀ π).comp e (Nat.zero_add (r + 1)) = 0 := by
      intro r K e
      obtain ⟨f, hf, rfl⟩ := R_Y.extMk_surjective e (r + 2) rfl
      let S_r : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
        CategoryTheory.ShortComplex.mk (R_Y.cocomplex.d r (r + 1))
          (R_Y.cocomplex.d (r + 1) (r + 2)) (R_Y.cocomplex.d_comp_d r (r + 1) (r + 2))
      have hExact_r : S_r.Exact := R_Y.exact_succ r
      have _ : CategoryTheory.Epi S_r.toCycles :=
        (CategoryTheory.ShortComplex.exact_iff_epi_toCycles S_r).mp hExact_r
      let k_cyc : K ⟶ S_r.cycles := S_r.liftCycles f hf
      let Q := CategoryTheory.Limits.pullback S_r.toCycles k_cyc
      let p₁ : Q ⟶ R_Y.cocomplex.X r := CategoryTheory.Limits.pullback.fst S_r.toCycles k_cyc
      let p₂ : Q ⟶ K := CategoryTheory.Limits.pullback.snd S_r.toCycles k_cyc
      have _ : CategoryTheory.Epi p₂ :=
        CategoryTheory.Abelian.epi_pullback_of_epi_f S_r.toCycles k_cyc
      obtain ⟨P, π₀, _, hTF_P⟩ := hCoverTF Q
      let π : P ⟶ K := π₀ ≫ p₂
      have hEpi_π : CategoryTheory.Epi π := CategoryTheory.epi_comp π₀ p₂
      let g : P ⟶ R_Y.cocomplex.X r := π₀ ≫ p₁
      have hg_eq : g ≫ R_Y.cocomplex.d r (r + 1) = π ≫ f := by
        change (π₀ ≫ p₁) ≫ S_r.f = (π₀ ≫ p₂) ≫ f
        calc
          (π₀ ≫ p₁) ≫ S_r.f
            = π₀ ≫ p₁ ≫ S_r.toCycles ≫ S_r.iCycles := by
                rw [← S_r.toCycles_i, CategoryTheory.Category.assoc]
          _ = π₀ ≫ (p₁ ≫ S_r.toCycles) ≫ S_r.iCycles := by
                simp only [CategoryTheory.Category.assoc]
          _ = π₀ ≫ (p₂ ≫ k_cyc) ≫ S_r.iCycles := by
                rw [CategoryTheory.Limits.pullback.condition]
          _ = (π₀ ≫ p₂) ≫ f := by
                rw [CategoryTheory.Category.assoc, S_r.liftCycles_i f hf,
                  CategoryTheory.Category.assoc]
      refine ⟨P, π, hEpi_π, hTF_P, ?_⟩
      rw [R_Y.mk₀_comp_extMk f (r + 2) rfl hf π,
        R_Y.extMk_eq_zero_iff (π ≫ f) (r + 2) rfl _ r rfl]
      exact ⟨g, hg_eq⟩
    induction p with
    | zero =>
      intro K hTF_K e
      obtain ⟨P, π, _, hTF_P, hKill⟩ := hKillEpi 0 K e
      let ι : CategoryTheory.Limits.kernel π ⟶ P := CategoryTheory.Limits.kernel.ι π
      let S_π := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.kernel.condition π)
      have hS_π : S_π.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_kernel π }
      obtain ⟨x₀, hx₀⟩ :=
        CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hS_π Y e hKill (Nat.add_zero 1)
      obtain ⟨g₀, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective S_π.X₁ Y).2 x₀
      obtain ⟨h, hh⟩ := hExtInj I_sh S_π hS_π hTF_K g₀
      rw [← hx₀, ← hh, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc hS_π.extClass
          (CategoryTheory.Abelian.Ext.mk₀ S_π.f) (CategoryTheory.Abelian.Ext.mk₀ h)
          (Nat.add_zero 1) (Nat.zero_add 0) (Nat.add_zero 1),
        hS_π.extClass_comp, CategoryTheory.Abelian.Ext.zero_comp]
    | succ p' ih =>
      intro K _ e
      obtain ⟨P, π, _, hTF_P, hKill⟩ := hKillEpi (p' + 1) K e
      let ι : CategoryTheory.Limits.kernel π ⟶ P := CategoryTheory.Limits.kernel.ι π
      let S_π := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.kernel.condition π)
      have hS_π : S_π.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_kernel π }
      obtain ⟨x₁, hx₁⟩ :=
        CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hS_π Y e hKill
          (Nat.one_add (p' + 1))
      have hx₁_zero : x₁ = 0 := ih S_π.X₁ (hSubTF ι hTF_P) x₁
      rw [← hx₁, hx₁_zero, CategoryTheory.Abelian.Ext.comp_zero]

  have hGenBij : ∀ (q : ℕ)
      (F_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)),
      Function.Bijective (GenMap F_sh q) := by
    intro q
    induction q with
    | zero => exact hBase0
    | succ q ih =>
      intro F_sh
      let I_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R) :=
        CategoryTheory.Injective.under F_sh
      have _ : CategoryTheory.Injective I_sh := CategoryTheory.Injective.injective_under F_sh
      let i_F : F_sh ⟶ I_sh := CategoryTheory.Injective.ι F_sh
      have _ : CategoryTheory.Mono i_F := CategoryTheory.Injective.ι_mono F_sh
      let Q_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R) :=
        CategoryTheory.Limits.cokernel i_F
      let p_F : I_sh ⟶ Q_sh := CategoryTheory.Limits.cokernel.π i_F
      have _ : CategoryTheory.Epi p_F := CategoryTheory.Limits.coequalizer.π_epi
      let S_F := CategoryTheory.ShortComplex.mk i_F p_F (CategoryTheory.Limits.cokernel.condition i_F)
      have hS_F : S_F.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_cokernel i_F }
      have hUS_F : (S_F.map U_of).ShortExact := hS_F.map_of_exact U_of
      have hExtModI : ∀ e : CategoryTheory.Abelian.Ext.{u} oneR I_sh (q + 1), e = 0 :=
        fun e => (CategoryTheory.hasInjectiveDimensionLT_iff I_sh 1).mp inferInstance
          (q + 1) (Nat.succ_pos q) e
      have hExtAbI : ∀ e : CategoryTheory.Abelian.Ext.{u} Fℤ (U_of.obj I_sh) (q + 1), e = 0 :=
        hAcyclic I_sh q Fℤ hInitTF
      have hCommP : ∀ x : CategoryTheory.Abelian.Ext.{u} oneR I_sh q,
          GenMap Q_sh q (x.comp (CategoryTheory.Abelian.Ext.mk₀ p_F) (Nat.add_zero q)) =
            (GenMap I_sh q x).comp (CategoryTheory.Abelian.Ext.mk₀ (U_of.map p_F)) (Nat.add_zero q) := by
        intro x
        change (CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U_of
              (x.comp (CategoryTheory.Abelian.Ext.mk₀ p_F) (Nat.add_zero q)))
            (Nat.zero_add q) =
          ((CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U_of x) (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (U_of.map p_F)) (Nat.add_zero q)
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add q) (Nat.add_zero q) (by omega)]
      have hCommConn : ∀ y : CategoryTheory.Abelian.Ext.{u} oneR Q_sh q,
          GenMap F_sh (q + 1) (y.comp hS_F.extClass rfl) =
            (GenMap Q_sh q y).comp hUS_F.extClass rfl := by
        intro y
        change (CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U_of (y.comp hS_F.extClass rfl))
            (Nat.zero_add (q + 1)) =
          ((CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U_of y) (Nat.zero_add q)).comp
            hUS_F.extClass rfl
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass U_of hS_F,
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add q) rfl (by omega)]
      refine ⟨?_, ?_⟩
      · intro z₁ z₂ hz
        have hdiff0 : GenMap F_sh (q + 1) (z₁ - z₂) = 0 := by
          rw [map_sub, hz, sub_self]
        have hi0 : (z₁ - z₂).comp (CategoryTheory.Abelian.Ext.mk₀ S_F.f) (Nat.add_zero (q + 1)) = 0 :=
          hExtModI _
        obtain ⟨y, hy⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ oneR hS_F (z₁ - z₂) hi0 rfl
        have hy_conn0 : (GenMap Q_sh q y).comp hUS_F.extClass rfl = 0 := by
          rw [← hCommConn y, hy, hdiff0]
        obtain ⟨w', hw'⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ hUS_F (GenMap Q_sh q y) rfl hy_conn0
        obtain ⟨w, rfl⟩ := (ih I_sh).2 w'
        have hw_eq : GenMap Q_sh q (w.comp (CategoryTheory.Abelian.Ext.mk₀ S_F.g) (Nat.add_zero q)) =
            GenMap Q_sh q y := by
          rw [hCommP w]
          exact hw'
        have hy_eq : w.comp (CategoryTheory.Abelian.Ext.mk₀ S_F.g) (Nat.add_zero q) = y :=
          (ih Q_sh).1 hw_eq
        have hz_sub0 : z₁ - z₂ = 0 := by
          rw [← hy, ← hy_eq, CategoryTheory.Abelian.Ext.comp_assoc w
            (CategoryTheory.Abelian.Ext.mk₀ S_F.g) hS_F.extClass (Nat.add_zero q) (Nat.zero_add 1)
            (by omega),
            hS_F.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
        exact sub_eq_zero.mp hz_sub0
      · intro z'
        have hi'0 : z'.comp (CategoryTheory.Abelian.Ext.mk₀ (S_F.map U_of).f)
            (Nat.add_zero (q + 1)) = 0 := hExtAbI _
        obtain ⟨y', hy'⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hUS_F z' hi'0 rfl
        obtain ⟨y, rfl⟩ := (ih Q_sh).2 y'
        refine ⟨y.comp hS_F.extClass rfl, ?_⟩
        rw [hCommConn y, hy']

  
  let Φ : ∀ (W : S.Etale) (q : ℕ),
      weilEtaleLocalModuleH S m W q →+ weilEtaleLocalTorsionH S m W q :=
    fun W q =>
      ((CategoryTheory.Abelian.Ext.mk₀ (β_loc W)).postcomp Fℤ (Nat.add_zero q)).comp
        (GenMap (weilEtaleLocalFreeSheaf S m W) q)
  have hΦ_bij : ∀ (W : S.Etale) (q : ℕ), Function.Bijective (Φ W q) := by
    intro W q
    let postβ := (CategoryTheory.Abelian.Ext.mk₀ (β_loc W)).postcomp Fℤ (Nat.add_zero q)
    let postα := (CategoryTheory.Abelian.Ext.mk₀ (α_loc W)).postcomp Fℤ (Nat.add_zero q)
    have hPostBij : Function.Bijective postβ := by
      refine ⟨?_, ?_⟩
      · intro a₁ a₂ ha
        have h1 := congrArg postα ha
        change (a₁.comp (CategoryTheory.Abelian.Ext.mk₀ (β_loc W)) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (α_loc W)) (Nat.add_zero q) =
          (a₂.comp (CategoryTheory.Abelian.Ext.mk₀ (β_loc W)) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (α_loc W)) (Nat.add_zero q) at h1
        rwa [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0) (by omega),
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0) (by omega),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, (hIsoLoc W).2,
          CategoryTheory.Abelian.Ext.comp_mk₀_id, CategoryTheory.Abelian.Ext.comp_mk₀_id] at h1
      · intro b
        refine ⟨postα b, ?_⟩
        change (b.comp (CategoryTheory.Abelian.Ext.mk₀ (α_loc W)) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (β_loc W)) (Nat.add_zero q) = b
        rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0) (by omega),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, (hIsoLoc W).1,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
    exact hPostBij.comp (hGenBij q (weilEtaleLocalFreeSheaf S m W))

  have hΦ_map : ∀ {U' U : S.Etale} (v : U' ⟶ U) (q : ℕ)
      (z : weilEtaleLocalModuleH S m U' q),
      Φ U q (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalFreeMap S m v))
        (Nat.add_zero q)) =
        weilEtaleLocalTorsionMapH S m v q (Φ U' q z) := by
    intro U' U v q z
    let a := CategoryTheory.Abelian.Ext.mk₀ ηℤ
    let b := CategoryTheory.Abelian.Ext.mapExactFunctor U_of z
    let c₁ := CategoryTheory.Abelian.Ext.mk₀ (U_of.map (weilEtaleLocalFreeMap S m v))
    let d₁ := CategoryTheory.Abelian.Ext.mk₀ (β_loc U)
    let c₂ := CategoryTheory.Abelian.Ext.mk₀ (β_loc U')
    let d₂ := CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S m v)
    change (a.comp (CategoryTheory.Abelian.Ext.mapExactFunctor U_of
        (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalFreeMap S m v)) (Nat.add_zero q)))
        (Nat.zero_add q)).comp d₁ (Nat.add_zero q) =
      ((a.comp b (Nat.zero_add q)).comp c₂ (Nat.add_zero q)).comp d₂ (Nat.add_zero q)
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
    change (a.comp (b.comp c₁ (Nat.add_zero q)) (Nat.zero_add q)).comp d₁ (Nat.add_zero q) = _
    calc
      (a.comp (b.comp c₁ (Nat.add_zero q)) (Nat.zero_add q)).comp d₁ (Nat.add_zero q)
        = a.comp ((b.comp c₁ (Nat.add_zero q)).comp d₁ (Nat.add_zero q)) (Nat.zero_add q) :=
            CategoryTheory.Abelian.Ext.comp_assoc a (b.comp c₁ (Nat.add_zero q)) d₁
              (Nat.zero_add q) (Nat.add_zero q) (by omega)
      _ = a.comp (b.comp (c₁.comp d₁ (Nat.add_zero 0)) (Nat.add_zero q)) (Nat.zero_add q) := by
            rw [CategoryTheory.Abelian.Ext.comp_assoc b c₁ d₁
              (Nat.add_zero q) (Nat.add_zero 0) (by omega)]
      _ = a.comp (b.comp (c₂.comp d₂ (Nat.add_zero 0)) (Nat.add_zero q)) (Nat.zero_add q) := by
            dsimp [c₁, d₁, c₂, d₂]
            rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hNatMap v,
              ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      _ = a.comp ((b.comp c₂ (Nat.add_zero q)).comp d₂ (Nat.add_zero q)) (Nat.zero_add q) := by
            rw [← CategoryTheory.Abelian.Ext.comp_assoc b c₂ d₂
              (Nat.add_zero q) (Nat.add_zero 0) (by omega)]
      _ = ((a.comp b (Nat.zero_add q)).comp c₂ (Nat.add_zero q)).comp d₂ (Nat.add_zero q) := by
            rw [← CategoryTheory.Abelian.Ext.comp_assoc a (b.comp c₂ (Nat.add_zero q)) d₂
              (Nat.zero_add q) (Nat.add_zero q) (by omega),
              ← CategoryTheory.Abelian.Ext.comp_assoc a b c₂
              (Nat.zero_add q) (Nat.add_zero q) (by omega)]

  have hΦ_counit : ∀ (W : S.Etale) (z : weilEtaleLocalModuleH S m W (2 * d)),
      θ_top (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalCounit S m W))
        (Nat.add_zero (2 * d))) =
        weilEtaleLocalTorsionCounitH S m W (2 * d) (Φ W (2 * d) z) := by
    intro W z
    rw [hθ_eq]
    let a := CategoryTheory.Abelian.Ext.mk₀ ηℤ
    let b := CategoryTheory.Abelian.Ext.mapExactFunctor U_of z
    let c₁ := CategoryTheory.Abelian.Ext.mk₀ (U_of.map (weilEtaleLocalCounit S m W))
    let d₁ := CategoryTheory.Abelian.Ext.mk₀ βM
    let c₂ := CategoryTheory.Abelian.Ext.mk₀ (β_loc W)
    let d₂ := CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionCounit S m W)
    change (a.comp (CategoryTheory.Abelian.Ext.mapExactFunctor U_of
        (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalCounit S m W))
          (Nat.add_zero (2 * d))))
        (Nat.zero_add (2 * d))).comp d₁ (Nat.add_zero (2 * d)) =
      ((a.comp b (Nat.zero_add (2 * d))).comp c₂ (Nat.add_zero (2 * d))).comp d₂
        (Nat.add_zero (2 * d))
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
    change (a.comp (b.comp c₁ (Nat.add_zero (2 * d))) (Nat.zero_add (2 * d))).comp d₁
        (Nat.add_zero (2 * d)) = _
    calc
      (a.comp (b.comp c₁ (Nat.add_zero (2 * d))) (Nat.zero_add (2 * d))).comp d₁
          (Nat.add_zero (2 * d))
        = a.comp ((b.comp c₁ (Nat.add_zero (2 * d))).comp d₁ (Nat.add_zero (2 * d)))
            (Nat.zero_add (2 * d)) :=
            CategoryTheory.Abelian.Ext.comp_assoc a (b.comp c₁ (Nat.add_zero (2 * d))) d₁
              (Nat.zero_add (2 * d)) (Nat.add_zero (2 * d)) (by omega)
      _ = a.comp (b.comp (c₁.comp d₁ (Nat.add_zero 0)) (Nat.add_zero (2 * d)))
            (Nat.zero_add (2 * d)) := by
            rw [CategoryTheory.Abelian.Ext.comp_assoc b c₁ d₁
              (Nat.add_zero (2 * d)) (Nat.add_zero 0) (by omega)]
      _ = a.comp (b.comp (c₂.comp d₂ (Nat.add_zero 0)) (Nat.add_zero (2 * d)))
            (Nat.zero_add (2 * d)) := by
            dsimp [c₁, d₁, c₂, d₂]
            rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hNatCounit W,
              ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      _ = a.comp ((b.comp c₂ (Nat.add_zero (2 * d))).comp d₂ (Nat.add_zero (2 * d)))
            (Nat.zero_add (2 * d)) := by
            rw [← CategoryTheory.Abelian.Ext.comp_assoc b c₂ d₂
              (Nat.add_zero (2 * d)) (Nat.add_zero 0) (by omega)]
      _ = ((a.comp b (Nat.zero_add (2 * d))).comp c₂ (Nat.add_zero (2 * d))).comp d₂
            (Nat.add_zero (2 * d)) := by
            rw [← CategoryTheory.Abelian.Ext.comp_assoc a (b.comp c₂ (Nat.add_zero (2 * d))) d₂
              (Nat.zero_add (2 * d)) (Nat.add_zero (2 * d)) (by omega),
              ← CategoryTheory.Abelian.Ext.comp_assoc a b c₂
              (Nat.zero_add (2 * d)) (Nat.add_zero (2 * d)) (by omega)]

  intro x _κ _Ω _gx U γ hγ
  obtain ⟨U', v, γ', hγ'_hom, hγ'_v, hVan, hBij⟩ := hEff x U γ hγ
  refine ⟨U', v, γ', hγ'_hom, hγ'_v, ?_, ?_⟩
  · intro q hq z
    apply (hΦ_bij U q).1
    rw [hΦ_map v q z, hVan q hq (Φ U' q z), map_zero]
  · have hEqFun :
        (fun z : weilEtaleLocalModuleH S m U' (2 * d) =>
          (tr_m.comp θ_top)
            (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalCounit S m U'))
              (Nat.add_zero (2 * d)))) =
        (fun w : weilEtaleLocalTorsionH S m U' (2 * d) =>
          tr_m (weilEtaleLocalTorsionCounitH S m U' (2 * d) w)) ∘ (Φ U' (2 * d)) := by
      funext z
      change tr_m (θ_top (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalCounit S m U'))
        (Nat.add_zero (2 * d)))) =
        tr_m (weilEtaleLocalTorsionCounitH S m U' (2 * d) (Φ U' (2 * d) z))
      rw [hΦ_counit U' z]
    rw [hEqFun]
    exact hBij.comp (hΦ_bij U' (2 * d))

theorem weil_algClosed_affine_etale_clopen_section_cover (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X₀ : AlgebraicGeometry.Scheme.{u})
    (π₀ : Quiver.Hom X₀ (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    (U₀ : X₀.Etale)
    (V₀ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Etale)
    [AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget (AlgebraicGeometry.Spec (CommRingCat.of Ω))).obj V₀).left]
    (e₀ : CategoryTheory.Iso
      ((AlgebraicGeometry.Scheme.Etale.forget X₀).obj U₀).left
      ((AlgebraicGeometry.Scheme.Etale.forget (AlgebraicGeometry.Spec (CommRingCat.of Ω))).obj V₀).left)
    (hcomm : CategoryTheory.CategoryStruct.comp ((AlgebraicGeometry.Scheme.Etale.forget X₀).obj U₀).hom π₀ =
      CategoryTheory.CategoryStruct.comp e₀.hom
        ((AlgebraicGeometry.Scheme.Etale.forget (AlgebraicGeometry.Spec (CommRingCat.of Ω))).obj V₀).hom) :
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let T_Ω : S_Ω.Etale := weilEtaleIdTerminal S_Ω
    let Fgt_S := AlgebraicGeometry.Scheme.Etale.forget S_Ω
    let Fgt_X := AlgebraicGeometry.Scheme.Etale.forget X₀
    ∃ (n : ℕ)
      (β : Fin n → Quiver.Hom T_Ω V₀)
      (s : Fin n → Quiver.Hom S_Ω X₀)
      (hs : ∀ a : Fin n, AlgebraicGeometry.Etale (s a))
      (S_a : Fin n → X₀.Etale)
      (α : ∀ a : Fin n, Quiver.Hom (S_a a) U₀),
      (∀ a : Fin n, S_a a = CategoryTheory.MorphismProperty.Over.mk ⊤ (s a) (hs a)) ∧
      (∀ a : Fin n, CategoryTheory.CategoryStruct.comp (s a) π₀ = CategoryTheory.CategoryStruct.id S_Ω) ∧
      (∀ a : Fin n, AlgebraicGeometry.IsOpenImmersion ((Fgt_S.map (β a)).left)) ∧
      (∀ a b : Fin n, a ≠ b →
        Disjoint (Set.range ((Fgt_S.map (β a)).left).base) (Set.range ((Fgt_S.map (β b)).left).base)) ∧
      (⋃ a : Fin n, Set.range ((Fgt_S.map (β a)).left).base) = Set.univ ∧
      (∀ a : Fin n, AlgebraicGeometry.IsOpenImmersion ((Fgt_X.map (α a)).left)) ∧
      (∀ a b : Fin n, a ≠ b →
        Disjoint (Set.range ((Fgt_X.map (α a)).left).base) (Set.range ((Fgt_X.map (α b)).left).base)) ∧
      (⋃ a : Fin n, Set.range ((Fgt_X.map (α a)).left).base) = Set.univ :=
by
  classical
  let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  let T_Ω : S_Ω.Etale := weilEtaleIdTerminal S_Ω
  let Fgt_S := AlgebraicGeometry.Scheme.Etale.forget S_Ω
  let Fgt_X := AlgebraicGeometry.Scheme.Etale.forget X₀
  have hSpecSplit : ∀ (R : CommRingCat.{u}) (φ : CommRingCat.of Ω ⟶ R),
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ) →
      ∃ (n : ℕ) (ι : Fin n → (S_Ω ⟶ AlgebraicGeometry.Spec R)),
        (∀ a : Fin n, ι a ≫ AlgebraicGeometry.Spec.map φ = 𝟙 S_Ω) ∧
        (∀ a : Fin n, AlgebraicGeometry.IsOpenImmersion (ι a)) ∧
        (∀ a b : Fin n, a ≠ b → Disjoint (Set.range (ι a).base) (Set.range (ι b).base)) ∧
        (⋃ a : Fin n, Set.range (ι a).base) = Set.univ := by
    intro R φ hEt_map
    have hEt_ring : RingHom.Etale φ.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_map
    letI : Algebra Ω ↑R := φ.hom.toAlgebra
    haveI : Algebra.Etale Ω ↑R := (RingHom.etale_algebraMap (R := Ω) (S := ↑R)).mp hEt_ring
    obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod Ω ↑R).mp inferInstance
    letI : Fintype I := Fintype.ofFinite I
    letI := hFieldAi
    letI := hAlgAi
    let n : ℕ := Fintype.card I
    let e_idx : I ≃ Fin n := Fintype.equivFin I
    have hBij_i : ∀ i : I, Function.Bijective (algebraMap Ω (Ai i)) := by
      intro i
      haveI : Module.Finite Ω (Ai i) := (hFinSep i).1
      haveI : Algebra.IsIntegral Ω (Ai i) := Algebra.IsIntegral.of_finite Ω (Ai i)
      exact IsAlgClosed.algebraMap_bijective_of_isIntegral (k := Ω) (K := Ai i)
    let e_field : ∀ i : I, Ω ≃ₐ[Ω] Ai i :=
      fun i => AlgEquiv.ofBijective (Algebra.ofId Ω (Ai i)) (hBij_i i)
    let ψ₁ : (∀ i : I, Ai i) ≃ₐ[Ω] (∀ a : Fin n, Ai (e_idx.symm a)) :=
      AlgEquiv.piCongrLeft' Ω Ai e_idx
    let ψ₂ : (∀ a : Fin n, Ai (e_idx.symm a)) ≃ₐ[Ω] (Fin n → Ω) :=
      AlgEquiv.piCongrRight (fun a => (e_field (e_idx.symm a)).symm)
    let ψ : ↑R ≃ₐ[Ω] (Fin n → Ω) := e_prod.trans (ψ₁.trans ψ₂)
    let ev_alg : Fin n → (↑R →ₐ[Ω] Ω) :=
      fun a => (Pi.evalAlgHom Ω (fun _ : Fin n => Ω) a).comp ψ.toAlgHom
    let p_hom : Fin n → (R ⟶ CommRingCat.of Ω) :=
      fun a => CommRingCat.ofHom (ev_alg a).toRingHom
    let ι : Fin n → (S_Ω ⟶ AlgebraicGeometry.Spec R) :=
      fun a => AlgebraicGeometry.Spec.map (p_hom a)
    have hsec_ring : ∀ a : Fin n, φ ≫ p_hom a = 𝟙 (CommRingCat.of Ω) := by
      intro a
      ext c
      exact (ev_alg a).commutes c
    have hsec : ∀ a : Fin n, ι a ≫ AlgebraicGeometry.Spec.map φ = 𝟙 S_Ω := by
      intro a
      dsimp [ι]
      rw [← AlgebraicGeometry.Spec.map_comp, hsec_ring a, AlgebraicGeometry.Spec.map_id]
    have hOpen : ∀ a : Fin n, AlgebraicGeometry.IsOpenImmersion (ι a) := by
      intro a
      haveI : CategoryTheory.Mono (ι a) :=
        ⟨fun g₁ g₂ h => by
          have h' := congrArg (· ≫ AlgebraicGeometry.Spec.map φ) h
          simpa [CategoryTheory.Category.assoc, hsec a] using h'⟩
      have hEt_comp : AlgebraicGeometry.Etale (ι a ≫ AlgebraicGeometry.Spec.map φ) := by
        rw [hsec a]
        infer_instance
      haveI : AlgebraicGeometry.Etale (ι a) :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          (ι a) (AlgebraicGeometry.Spec.map φ) hEt_map hEt_comp
      exact AlgebraicGeometry.IsOpenImmersion.of_flat_of_mono (ι a)
    let ε : Fin n → ↑R := fun a => ψ.symm (Pi.single a (1 : Ω))
    have hε_eval_same : ∀ a : Fin n, ev_alg a (ε a) = 1 := by
      intro a
      simp [ev_alg, ε]
    have hε_eval_ne : ∀ {a b : Fin n}, a ≠ b → ev_alg b (ε a) = 0 := by
      intro a b hab
      simp [ev_alg, ε, Pi.single_eq_of_ne (Ne.symm hab)]
    refine ⟨n, ι, hsec, hOpen, ?_, ?_⟩
    · intro a b hab
      rw [Set.disjoint_left]
      rintro z ⟨qa, rfl⟩ ⟨qb, hqb⟩
      let qa_pt : PrimeSpectrum Ω := qa
      let qb_pt : PrimeSpectrum Ω := qb
      let za_pt : PrimeSpectrum ↑R := (ι a).base qa
      let zb_pt : PrimeSpectrum ↑R := (ι b).base qb
      have hz_eq : zb_pt = za_pt := hqb
      have hmem_b : ε a ∈ zb_pt.asIdeal := by
        change ev_alg b (ε a) ∈ qb_pt.asIdeal
        rw [hε_eval_ne hab]
        exact qb_pt.asIdeal.zero_mem
      rw [hz_eq] at hmem_b
      have hmem_a : (1 : Ω) ∈ qa_pt.asIdeal := by
        rw [← hε_eval_same a]
        exact hmem_b
      exact qa_pt.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem qa_pt.asIdeal hmem_a isUnit_one)
    · ext z
      simp only [Set.mem_iUnion, Set.mem_range, Set.mem_univ, iff_true]
      let z_pt : PrimeSpectrum ↑R := z
      have hsum_one : (∑ a : Fin n, ε a) = 1 := by
        dsimp [ε]
        rw [← map_sum]
        have hpi_sum : (∑ a : Fin n, Pi.single a (1 : Ω)) = (1 : Fin n → Ω) := by
          funext k
          simp [Finset.sum_apply, Pi.single_apply]
        rw [hpi_sum, map_one]
      have hex_not_mem : ∃ a : Fin n, ε a ∉ z_pt.asIdeal := by
        by_contra hall
        push_neg at hall
        have h1_mem : (1 : ↑R) ∈ z_pt.asIdeal := by
          rw [← hsum_one]
          exact Ideal.sum_mem z_pt.asIdeal (fun a _ => hall a)
        exact z_pt.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem z_pt.asIdeal h1_mem isUnit_one)
      obtain ⟨a, ha_not_mem⟩ := hex_not_mem
      let q₀ : PrimeSpectrum Ω :=
        Classical.choice ((PrimeSpectrum.nonempty_iff_nontrivial (R := Ω)).mpr inferInstance)
      have hq₀_mem_iff : ∀ c : Ω, c ∈ q₀.asIdeal ↔ c = 0 := by
        intro c
        constructor
        · intro hc
          by_contra hc_ne
          exact q₀.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q₀.asIdeal hc (Ne.isUnit hc_ne))
        · rintro rfl
          exact q₀.asIdeal.zero_mem
      refine ⟨a, q₀, ?_⟩
      change (ι a).base q₀ = z_pt
      apply PrimeSpectrum.ext
      ext r
      change ev_alg a r ∈ q₀.asIdeal ↔ r ∈ z_pt.asIdeal
      rw [hq₀_mem_iff]
      have hprod_zero : ε a * (r - algebraMap Ω ↑R (ev_alg a r)) = 0 := by
        apply ψ.injective
        rw [map_zero, map_mul, map_sub, AlgEquiv.commutes]
        funext k
        simp only [ε, ψ.apply_symm_apply, Pi.mul_apply, Pi.sub_apply, Pi.zero_apply]
        by_cases hka : k = a
        · subst hka
          have hev_eq : ev_alg k r = ψ r k := rfl
          simp [hev_eq]
        · simp [Pi.single_eq_of_ne hka]
      have hdiff_mem : r - algebraMap Ω ↑R (ev_alg a r) ∈ z_pt.asIdeal := by
        have hmul_mem : ε a * (r - algebraMap Ω ↑R (ev_alg a r)) ∈ z_pt.asIdeal := by
          rw [hprod_zero]
          exact z_pt.asIdeal.zero_mem
        exact (z_pt.isPrime.mem_or_mem hmul_mem).resolve_left ha_not_mem
      constructor
      · intro hr0
        rw [hr0, map_zero, sub_zero] at hdiff_mem
        exact hdiff_mem
      · intro hrz
        by_contra hne0
        have hc_mem : algebraMap Ω ↑R (ev_alg a r) ∈ z_pt.asIdeal := by
          have hsub := z_pt.asIdeal.sub_mem hrz hdiff_mem
          simpa using hsub
        have hunit : IsUnit (algebraMap Ω ↑R (ev_alg a r)) :=
          (Ne.isUnit hne0).map (algebraMap Ω ↑R)
        exact z_pt.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem z_pt.asIdeal hc_mem hunit)
  let W_V₀ := (Fgt_S.obj V₀).left
  let v₀ := (Fgt_S.obj V₀).hom
  let W_U₀ := (Fgt_X.obj U₀).left
  let u₀ := (Fgt_X.obj U₀).hom
  haveI : AlgebraicGeometry.Etale v₀ := V₀.prop
  haveI : AlgebraicGeometry.Etale u₀ := U₀.prop
  let R_V := W_V₀.presheaf.obj (Opposite.op ⊤)
  let e_spec := W_V₀.isoSpec
  let φ_V : CommRingCat.of Ω ⟶ R_V := AlgebraicGeometry.Spec.preimage (e_spec.inv ≫ v₀)
  have hmap_φV : AlgebraicGeometry.Spec.map φ_V = e_spec.inv ≫ v₀ :=
    AlgebraicGeometry.Spec.map_preimage (e_spec.inv ≫ v₀)
  have hEt_φV : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_V) := by
    rw [hmap_φV]
    infer_instance
  obtain ⟨n, ι_spec, hsec_spec, hOpen_spec, hDisj_spec, hUniv_spec⟩ := hSpecSplit R_V φ_V hEt_φV
  let ι_V : Fin n → (S_Ω ⟶ W_V₀) := fun a => ι_spec a ≫ e_spec.inv
  let ι_U : Fin n → (S_Ω ⟶ W_U₀) := fun a => ι_V a ≫ e₀.inv
  let s : Fin n → (S_Ω ⟶ X₀) := fun a => ι_U a ≫ u₀
  have hsec_V : ∀ a : Fin n, ι_V a ≫ v₀ = 𝟙 S_Ω := by
    intro a
    dsimp [ι_V]
    rw [CategoryTheory.Category.assoc, ← hmap_φV]
    exact hsec_spec a
  have hsec_X : ∀ a : Fin n, s a ≫ π₀ = 𝟙 S_Ω := by
    intro a
    dsimp [s, ι_U]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hcomm,
      ← CategoryTheory.Category.assoc e₀.inv e₀.hom v₀, CategoryTheory.Iso.inv_hom_id,
      CategoryTheory.Category.id_comp]
    exact hsec_V a
  have hOpen_V : ∀ a : Fin n, AlgebraicGeometry.IsOpenImmersion (ι_V a) := by
    intro a
    haveI := hOpen_spec a
    dsimp [ι_V]
    infer_instance
  have hOpen_U : ∀ a : Fin n, AlgebraicGeometry.IsOpenImmersion (ι_U a) := by
    intro a
    haveI := hOpen_V a
    dsimp [ι_U]
    infer_instance
  have hs : ∀ a : Fin n, AlgebraicGeometry.Etale (s a) := by
    intro a
    haveI := hOpen_U a
    dsimp [s]
    infer_instance
  let S_a : Fin n → X₀.Etale :=
    fun a => CategoryTheory.MorphismProperty.Over.mk ⊤ (s a) (hs a)
  let β : Fin n → Quiver.Hom T_Ω V₀ :=
    fun a => CategoryTheory.MorphismProperty.Over.homMk (ι_V a) (hsec_V a) trivial
  let α : ∀ a : Fin n, Quiver.Hom (S_a a) U₀ :=
    fun a => CategoryTheory.MorphismProperty.Over.homMk (ι_U a) rfl trivial
  have hDisj_V : ∀ a b : Fin n, a ≠ b →
      Disjoint (Set.range (ι_V a).base) (Set.range (ι_V b).base) := by
    intro a b hab
    rw [Set.disjoint_left]
    rintro x ⟨pa, rfl⟩ ⟨pb, hpb⟩
    have heq : (ι_spec a).base pa = (ι_spec b).base pb := by
      have h1 : e_spec.hom.base (e_spec.inv.base ((ι_spec a).base pa)) =
          e_spec.hom.base (e_spec.inv.base ((ι_spec b).base pb)) :=
        congrArg e_spec.hom.base hpb.symm
      have hcomp_id : ∀ z, e_spec.hom.base (e_spec.inv.base z) = z := fun z =>
        (AlgebraicGeometry.Scheme.Hom.comp_apply e_spec.inv e_spec.hom z).symm.trans
          (congrArg (fun f : AlgebraicGeometry.Spec R_V ⟶ AlgebraicGeometry.Spec R_V => f.base z)
            e_spec.inv_hom_id)
      rwa [hcomp_id, hcomp_id] at h1
    exact Set.disjoint_left.mp (hDisj_spec a b hab) ⟨pa, rfl⟩ ⟨pb, heq.symm⟩
  have hUniv_V : (⋃ a : Fin n, Set.range (ι_V a).base) = Set.univ := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_range, Set.mem_univ, iff_true]
    have hx_spec : e_spec.hom.base x ∈ (Set.univ : Set ↥(AlgebraicGeometry.Spec R_V)) :=
      Set.mem_univ _
    rw [← hUniv_spec, Set.mem_iUnion] at hx_spec
    obtain ⟨a, pa, hpa⟩ := hx_spec
    refine ⟨a, pa, ?_⟩
    change e_spec.inv.base ((ι_spec a).base pa) = x
    rw [hpa]
    exact (AlgebraicGeometry.Scheme.Hom.comp_apply e_spec.hom e_spec.inv x).symm.trans
      (congrArg (fun f : W_V₀ ⟶ W_V₀ => f.base x) e_spec.hom_inv_id)
  have hDisj_U : ∀ a b : Fin n, a ≠ b →
      Disjoint (Set.range (ι_U a).base) (Set.range (ι_U b).base) := by
    intro a b hab
    rw [Set.disjoint_left]
    rintro x ⟨pa, rfl⟩ ⟨pb, hpb⟩
    have heq : (ι_V a).base pa = (ι_V b).base pb := by
      have h1 : e₀.hom.base (e₀.inv.base ((ι_V a).base pa)) =
          e₀.hom.base (e₀.inv.base ((ι_V b).base pb)) :=
        congrArg e₀.hom.base hpb.symm
      have hcomp_id : ∀ z, e₀.hom.base (e₀.inv.base z) = z := fun z =>
        (AlgebraicGeometry.Scheme.Hom.comp_apply e₀.inv e₀.hom z).symm.trans
          (congrArg (fun f : W_V₀ ⟶ W_V₀ => f.base z) e₀.inv_hom_id)
      rwa [hcomp_id, hcomp_id] at h1
    exact Set.disjoint_left.mp (hDisj_V a b hab) ⟨pa, rfl⟩ ⟨pb, heq.symm⟩
  have hUniv_U : (⋃ a : Fin n, Set.range (ι_U a).base) = Set.univ := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_range, Set.mem_univ, iff_true]
    have hx_V : e₀.hom.base x ∈ (Set.univ : Set ↥W_V₀) := Set.mem_univ _
    rw [← hUniv_V, Set.mem_iUnion] at hx_V
    obtain ⟨a, pa, hpa⟩ := hx_V
    refine ⟨a, pa, ?_⟩
    change e₀.inv.base ((ι_V a).base pa) = x
    rw [hpa]
    exact (AlgebraicGeometry.Scheme.Hom.comp_apply e₀.hom e₀.inv x).symm.trans
      (congrArg (fun f : W_U₀ ⟶ W_U₀ => f.base x) e₀.hom_inv_id)
  exact ⟨n, β, s, hs, S_a, α, fun _ => rfl, hsec_X,
    hOpen_V, hDisj_V, hUniv_V, hOpen_U, hDisj_U, hUniv_U⟩

theorem weil_etale_localTorsion_disjoint_open_directSum_and_algClosed_point_finite : (∀ (Z : AlgebraicGeometry.Scheme.{u}) (m n : ℕ) (U : Z.Etale)
        (U_part : Fin n → Z.Etale) (γ : ∀ a : Fin n, Quiver.Hom (U_part a) U),
      let Fgt_Z := AlgebraicGeometry.Scheme.Etale.forget Z
      (∀ a : Fin n, AlgebraicGeometry.IsOpenImmersion ((Fgt_Z.map (γ a)).left)) →
      (∀ a b : Fin n, a ≠ b →
        Disjoint (Set.range ((Fgt_Z.map (γ a)).left).base) (Set.range ((Fgt_Z.map (γ b)).left).base)) →
      (⋃ a : Fin n, Set.range ((Fgt_Z.map (γ a)).left).base) = Set.univ →
      ∃ (ι : ∀ a : Fin n, Quiver.Hom (weilEtaleLocalTorsionSheaf Z m (U_part a))
          (weilEtaleLocalTorsionSheaf Z m U))
        (π : ∀ a : Fin n, Quiver.Hom (weilEtaleLocalTorsionSheaf Z m U)
          (weilEtaleLocalTorsionSheaf Z m (U_part a))),
        (∀ a : Fin n, CategoryTheory.CategoryStruct.comp (ι a) (π a) =
          CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf Z m (U_part a))) ∧
        (∀ a b : Fin n, a ≠ b → CategoryTheory.CategoryStruct.comp (ι a) (π b) = 0) ∧
        (Finset.univ.sum fun a : Fin n => CategoryTheory.CategoryStruct.comp (π a) (ι a)) =
          CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf Z m U)) ∧
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (m : ℕ),
      1 ≤ m →
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let T_Ω : S_Ω.Etale := weilEtaleIdTerminal S_Ω
      Finite ↥(((weilEtaleLocalTorsionSheaf S_Ω m T_Ω).obj.obj (Opposite.op T_Ω)))) :=
by
  classical
  have hEtaleCoverSieve : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {I : Type u}
      (B : Z.Etale) (Y_fam : I → Z.Etale) (π : ∀ i : I, Quiver.Hom (Y_fam i) B),
      (∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget Z).obj B).left,
        ∃ (i : I) (y : ↥((AlgebraicGeometry.Scheme.Etale.forget Z).obj (Y_fam i)).left),
          (((AlgebraicGeometry.Scheme.Etale.forget Z).map (π i)).left).base y = x) →
      CategoryTheory.Sieve.ofArrows Y_fam π ∈ Z.smallEtaleTopology B := by
    intro Z I B Y_fam π hSurj
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    let _ : CategoryTheory.Category.{u, u + 1} (P_et.Over ⊤ Z) :=
      (inferInstance : CategoryTheory.Category Z.Etale)
    have hEt_π : ∀ i : I, P_et (π i).left := fun i =>
      CategoryTheory.MorphismProperty.of_postcomp P_et
        (π i).left B.hom B.prop ((CategoryTheory.MorphismProperty.Over.w (π i)).symm ▸ (Y_fam i).prop)
    let 𝒰 : AlgebraicGeometry.Scheme.Cover
        (AlgebraicGeometry.Scheme.precoverage P_et) B.left :=
      AlgebraicGeometry.Scheme.Cover.mkOfCovers I (fun i => (Y_fam i).left)
        (fun i => (π i).left) hSurj hEt_π
    let hOv_i : ∀ i : 𝒰.I₀, (𝒰.X i).Over Z :=
      fun i => CategoryTheory.OverClass.fromOver (Y_fam i).toComma
    let hCovOver : AlgebraicGeometry.Scheme.Cover.Over Z 𝒰 :=
      @AlgebraicGeometry.Scheme.Cover.Over.mk Z P_et _ _ B.left _ 𝒰 hOv_i
        (fun i => @CategoryTheory.HomIsOver.mk _ _ (𝒰.X i) B.left (𝒰.f i) Z (hOv_i i) _
          (CategoryTheory.MorphismProperty.Over.w (π i)))
    refine (AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology
      (P := P_et) B (CategoryTheory.Sieve.ofArrows Y_fam π)).mpr
      ⟨𝒰, hCovOver, fun i => (Y_fam i).prop, ?_⟩
    intro W g hg
    rcases hg with ⟨i⟩
    exact CategoryTheory.Sieve.ofArrows_mk Y_fam π i

  have hUnpackEtaleSieve : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (W : Z.Etale) (R : CategoryTheory.Sieve W),
      R ∈ Z.smallEtaleTopology W →
      ∃ (J : Type u) (Y_cov : J → Z.Etale) (u_cov : ∀ j : J, Quiver.Hom (Y_cov j) W),
        (∀ j : J, R.arrows (u_cov j)) ∧
        (∀ w : ↥((AlgebraicGeometry.Scheme.Etale.forget Z).obj W).left,
          ∃ (j : J) (z : ↥((AlgebraicGeometry.Scheme.Etale.forget Z).obj (Y_cov j)).left),
            (((AlgebraicGeometry.Scheme.Etale.forget Z).map (u_cov j)).left).base z = w) := by
    intro Z W R hR
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    let _ : CategoryTheory.Category.{u, u + 1} (P_et.Over ⊤ Z) :=
      (inferInstance : CategoryTheory.Category Z.Etale)
    obtain ⟨𝒰, hOver, hP, hle⟩ :=
      (AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology (P := P_et) W R).mp hR
    let _ : AlgebraicGeometry.Scheme.Cover.Over Z 𝒰 := hOver
    let _ : ∀ j : 𝒰.I₀, (𝒰.X j).Over Z := hOver.over
    let _ : ∀ j : 𝒰.I₀, AlgebraicGeometry.Scheme.Hom.IsOver (𝒰.f j) Z := hOver.isOver_map
    let Y_cov : 𝒰.I₀ → Z.Etale := fun j => (𝒰.X j).asOverProp Z (hP j)
    let u_cov : ∀ j : 𝒰.I₀, Quiver.Hom (Y_cov j) W :=
      fun j => AlgebraicGeometry.Scheme.Hom.asOverProp (𝒰.f j) Z
    refine ⟨𝒰.I₀, Y_cov, u_cov, ?_, ?_⟩
    · intro j
      exact hle (Y_cov j) (u_cov j) (CategoryTheory.Presieve.ofArrows.mk j)
    · intro w
      exact ⟨𝒰.idx w, Classical.choose (𝒰.covers w), Classical.choose_spec (𝒰.covers w)⟩

  let Eℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let toElem : ∀ {M : AddCommGrpCat.{u}}, (Eℤ ⟶ M) → ↥M :=
    fun φ => φ.hom (ULift.up 1)
  let ofElem : ∀ {M : AddCommGrpCat.{u}}, ↥M → (Eℤ ⟶ M) :=
    fun m => AddCommGrpCat.ofHom
      { toFun := fun z => z.down • m
        map_zero' := zero_zsmul m
        map_add' := fun a b => add_zsmul m a.down b.down }
  have hToOf : ∀ {M : AddCommGrpCat.{u}} (m : ↥M), toElem (ofElem m) = m :=
    fun m => one_zsmul m
  have hOfTo : ∀ {M : AddCommGrpCat.{u}} (φ : Eℤ ⟶ M), ofElem (toElem φ) = φ := by
    intro M φ
    apply AddCommGrpCat.ext
    intro z
    have hz : z = z.down • ULift.up (1 : ℤ) := ULift.ext _ _ (by simp)
    conv_rhs => rw [hz]
    exact (map_zsmul φ.hom z.down (ULift.up 1)).symm

  have hGlueArrows : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (ℱ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      {I : Type u} (B : Z.Etale) (Y_fam : I → Z.Etale) (π : ∀ i : I, Quiver.Hom (Y_fam i) B),
      CategoryTheory.Sieve.ofArrows Y_fam π ∈ Z.smallEtaleTopology B →
      ∀ (loc : ∀ i : I, ↥(ℱ.obj.obj (Opposite.op (Y_fam i)))),
        (∀ (i j : I) (W_et : Z.Etale) (gi : Quiver.Hom W_et (Y_fam i))
          (gj : Quiver.Hom W_et (Y_fam j)),
          CategoryTheory.CategoryStruct.comp gi (π i) =
            CategoryTheory.CategoryStruct.comp gj (π j) →
          (ℱ.obj.map (Opposite.op gi)).hom (loc i) =
            (ℱ.obj.map (Opposite.op gj)).hom (loc j)) →
        ∃! t : ↥(ℱ.obj.obj (Opposite.op B)),
          ∀ i : I, (ℱ.obj.map (Opposite.op (π i))).hom t = loc i := by
    intro Z ℱ I B Y_fam π hCov loc hCompat
    let P_ℤ : CategoryTheory.Functor (Z.Etale)ᵒᵖ (Type u) :=
      ℱ.obj.comp (CategoryTheory.coyoneda.obj (Opposite.op Eℤ))
    have hSheafGen : CategoryTheory.Presieve.IsSheafFor P_ℤ
        (CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows Y_fam π)).arrows :=
      ℱ.property Eℤ (CategoryTheory.Sieve.ofArrows Y_fam π) hCov
    have hSheafArr : CategoryTheory.Presieve.IsSheafFor P_ℤ
        (CategoryTheory.Presieve.ofArrows Y_fam π) :=
      (CategoryTheory.Presieve.isSheafFor_iff_generate
        (CategoryTheory.Presieve.ofArrows Y_fam π)).mpr hSheafGen
    let x_fam : ∀ i : I, P_ℤ.obj (Opposite.op (Y_fam i)) := fun i => ofElem (loc i)
    have hx_compat : CategoryTheory.Presieve.Arrows.Compatible P_ℤ π x_fam := by
      intro i j W_et gi gj hcomm
      have h1 : toElem ((CategoryTheory.ConcreteCategory.hom (P_ℤ.map gi.op)) (x_fam i)) =
          (ℱ.obj.map (Opposite.op gi)).hom (loc i) := by
        change (ℱ.obj.map (Opposite.op gi)).hom (toElem (ofElem (loc i))) = _
        rw [hToOf]
      have h2 : toElem ((CategoryTheory.ConcreteCategory.hom (P_ℤ.map gj.op)) (x_fam j)) =
          (ℱ.obj.map (Opposite.op gj)).hom (loc j) := by
        change (ℱ.obj.map (Opposite.op gj)).hom (toElem (ofElem (loc j))) = _
        rw [hToOf]
      rw [← hOfTo ((CategoryTheory.ConcreteCategory.hom (P_ℤ.map gi.op)) (x_fam i)),
          ← hOfTo ((CategoryTheory.ConcreteCategory.hom (P_ℤ.map gj.op)) (x_fam j)),
          h1, h2, hCompat i j W_et gi gj hcomm]
    obtain ⟨φ_t, hφ_spec, hφ_uniq⟩ :=
      (CategoryTheory.Presieve.isSheafFor_arrows_iff P_ℤ π).mp hSheafArr x_fam hx_compat
    refine ⟨toElem φ_t, ?_, ?_⟩
    · intro i
      have hi := congrArg toElem (hφ_spec i)
      change (ℱ.obj.map (Opposite.op (π i))).hom (toElem φ_t) = toElem (ofElem (loc i)) at hi
      rwa [hToOf] at hi
    · intro t' ht'
      have hφ' : ofElem t' = φ_t := by
        apply hφ_uniq
        intro i
        rw [← hOfTo ((CategoryTheory.ConcreteCategory.hom (P_ℤ.map (π i).op)) (ofElem t'))]
        change ofElem ((ℱ.obj.map (Opposite.op (π i))).hom (toElem (ofElem t'))) = ofElem (loc i)
        rw [hToOf, ht' i]
      rw [← hToOf t', hφ']

  have hEmptySub : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (ℱ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (Y_et : Z.Etale),
      IsEmpty ↥((AlgebraicGeometry.Scheme.Etale.forget Z).obj Y_et).left →
      Subsingleton ↥(ℱ.obj.obj (Opposite.op Y_et)) := by
    intro Z ℱ Y_et hEmp
    have hCov : CategoryTheory.Sieve.ofArrows
        (PEmpty.elim : PEmpty.{u + 1} → Z.Etale) (fun i => i.elim) ∈
        Z.smallEtaleTopology Y_et :=
      hEtaleCoverSieve Z Y_et PEmpty.elim (fun i => i.elim) (fun x => IsEmpty.elim hEmp x)
    obtain ⟨t₀, _, ht₀_uniq⟩ := hGlueArrows Z ℱ Y_et PEmpty.elim (fun i => i.elim) hCov
      (fun i => i.elim) (fun i => i.elim)
    refine ⟨fun s₁ s₂ => ?_⟩
    exact (ht₀_uniq s₁ (fun i => i.elim)).trans (ht₀_uniq s₂ (fun i => i.elim)).symm

  have hEquiv_comp : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W_et : S.Etale)
      (AM : AddCommGrpCat.{u})
      {F G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (α : CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology W_et AM ⟶ F)
      (g : F ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) := by
    intro S W_et AM F G α g
    let α' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda W_et AM) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
            AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
              AddCommGrpCat.{u}).homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf S.smallEtaleTopology
                AddCommGrpCat.{u}).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  refine ⟨?_, ?_⟩
  · intro Z m n U U_part γ Fgt_Z hOpen hDisj hUniv
    have hCovU : CategoryTheory.Sieve.ofArrows
        (fun i : ULift.{u} (Fin n) => U_part i.down)
        (fun i : ULift.{u} (Fin n) => γ i.down) ∈ Z.smallEtaleTopology U := by
      apply hEtaleCoverSieve
      intro x
      have hx : x ∈ (⋃ a : Fin n, Set.range ((Fgt_Z.map (γ a)).left).base) := by
        rw [hUniv]; trivial
      obtain ⟨a, y, hy⟩ := Set.mem_iUnion.mp hx
      exact ⟨ULift.up a, y, hy⟩

    have hDisjGlue : ∀ (ℱ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
        ∃ e : ↥(ℱ.obj.obj (Opposite.op U)) ≃+
            (∀ a : Fin n, ↥(ℱ.obj.obj (Opposite.op (U_part a)))),
          ∀ (s : ↥(ℱ.obj.obj (Opposite.op U))) (a : Fin n),
            e s a = (ℱ.obj.map (Opposite.op (γ a))).hom s := by
      intro ℱ
      let resHom : ↥(ℱ.obj.obj (Opposite.op U)) →+
          (∀ a : Fin n, ↥(ℱ.obj.obj (Opposite.op (U_part a)))) :=
        { toFun := fun s a => (ℱ.obj.map (Opposite.op (γ a))).hom s
          map_zero' := by funext a; exact map_zero _
          map_add' := fun s₁ s₂ => by funext a; exact map_add _ s₁ s₂ }
      have hBij : Function.Bijective resHom := by
        refine ⟨?_, ?_⟩
        · intro s₁ s₂ hs
          obtain ⟨t₀, _, ht₀_uniq⟩ := hGlueArrows Z ℱ U
            (fun i : ULift.{u} (Fin n) => U_part i.down)
            (fun i : ULift.{u} (Fin n) => γ i.down) hCovU
            (fun i => resHom s₁ i.down)
            (fun i j W_et gi gj hcomm => by
              have h1 : (ℱ.obj.map (Opposite.op gi)).hom ((ℱ.obj.map (Opposite.op (γ i.down))).hom s₁) =
                  (ℱ.obj.map (Opposite.op (gi ≫ γ i.down))).hom s₁ := by
                change ((ℱ.obj.map (γ i.down).op ≫ ℱ.obj.map gi.op).hom) s₁ = _
                rw [← ℱ.obj.map_comp]
                rfl
              have h2 : (ℱ.obj.map (Opposite.op gj)).hom ((ℱ.obj.map (Opposite.op (γ j.down))).hom s₁) =
                  (ℱ.obj.map (Opposite.op (gj ≫ γ j.down))).hom s₁ := by
                change ((ℱ.obj.map (γ j.down).op ≫ ℱ.obj.map gj.op).hom) s₁ = _
                rw [← ℱ.obj.map_comp]
                rfl
              change (ℱ.obj.map (Opposite.op gi)).hom ((ℱ.obj.map (Opposite.op (γ i.down))).hom s₁) =
                (ℱ.obj.map (Opposite.op gj)).hom ((ℱ.obj.map (Opposite.op (γ j.down))).hom s₁)
              rw [h1, h2, hcomm])
          have ht₁ : s₁ = t₀ := ht₀_uniq s₁ (fun _ => rfl)
          have ht₂ : s₂ = t₀ := ht₀_uniq s₂ (fun i => congrFun hs.symm i.down)
          exact ht₁.trans ht₂.symm
        · intro y
          obtain ⟨t, ht, _⟩ := hGlueArrows Z ℱ U
            (fun i : ULift.{u} (Fin n) => U_part i.down)
            (fun i : ULift.{u} (Fin n) => γ i.down) hCovU
            (fun i => y i.down)
            (fun i j W_et gi gj hcomm => by
              by_cases hij : i.down = j.down
              · have hij' : i = j := ULift.ext _ _ hij
                subst hij'
                have hOpen_i : AlgebraicGeometry.IsOpenImmersion ((Fgt_Z.map (γ i.down)).left) :=
                  hOpen i.down
                have hleft_eq : gi.left ≫ (γ i.down).left = gj.left ≫ (γ i.down).left :=
                  congrArg (fun k : Quiver.Hom W_et U => k.left) hcomm
                have hgi_left : gi.left = gj.left :=
                  (CategoryTheory.cancel_mono ((Fgt_Z.map (γ i.down)).left)).mp hleft_eq
                have hgi_eq : gi = gj := CategoryTheory.MorphismProperty.Over.Hom.ext hgi_left
                rw [hgi_eq]
              · have hEmp : IsEmpty ↥((Fgt_Z.obj W_et).left) := ⟨fun w => by
                  have hmem_i : ((gi ≫ γ i.down).left).base w ∈
                      Set.range ((Fgt_Z.map (γ i.down)).left).base :=
                    ⟨gi.left.base w, rfl⟩
                  have hmem_j : ((gi ≫ γ i.down).left).base w ∈
                      Set.range ((Fgt_Z.map (γ j.down)).left).base := by
                    rw [hcomm]
                    exact ⟨gj.left.base w, rfl⟩
                  exact Set.disjoint_left.mp (hDisj i.down j.down hij) hmem_i hmem_j⟩
                have hSub_W := hEmptySub Z ℱ W_et hEmp
                exact Subsingleton.elim _ _)
          exact ⟨t, funext fun a => ht (ULift.up a)⟩
      exact ⟨AddEquiv.ofBijective resHom hBij, fun s a => rfl⟩

    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let L := weilEtaleLocalTorsionSheaf Z m U
    let L_part : Fin n → CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
      fun a => weilEtaleLocalTorsionSheaf Z m (U_part a)
    let ι : ∀ a : Fin n, Quiver.Hom (L_part a) L :=
      fun a => weilEtaleLocalTorsionMap Z m (γ a)

    have hEquiv_iota : ∀ (a : Fin n)
        {F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
        (g : L ⟶ F),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (ι a ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv g ≫ F.obj.map (Opposite.op (γ a)) := by
      intro a F g
      calc
        CategoryTheory.Sheaf.freeYonedaHomEquiv (ι a ≫ g)
          = CategoryTheory.Sheaf.freeYonedaHomEquiv (ι a) ≫
              g.hom.app (Opposite.op (U_part a)) :=
            hEquiv_comp Z (U_part a) AM (ι a) g
        _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L) ≫
              L.obj.map (Opposite.op (γ a))) ≫
              g.hom.app (Opposite.op (U_part a)) := by
            rw [show CategoryTheory.Sheaf.freeYonedaHomEquiv (ι a) =
                CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L) ≫ L.obj.map (Opposite.op (γ a)) from
              Equiv.apply_symm_apply _ _]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L) ≫
              (L.obj.map (Opposite.op (γ a)) ≫ g.hom.app (Opposite.op (U_part a))) := by
            rw [CategoryTheory.Category.assoc]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L) ≫
              (g.hom.app (Opposite.op U) ≫ F.obj.map (Opposite.op (γ a))) := by
            rw [← g.hom.naturality (Opposite.op (γ a))]
        _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L) ≫
              g.hom.app (Opposite.op U)) ≫ F.obj.map (Opposite.op (γ a)) := by
            rw [CategoryTheory.Category.assoc]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv g ≫ F.obj.map (Opposite.op (γ a)) := by
            rw [← hEquiv_comp Z U AM (𝟙 L) g, CategoryTheory.Category.id_comp]

    let e_part : ∀ b : Fin n,
        ↥((L_part b).obj.obj (Opposite.op U)) ≃+
          (∀ a : Fin n, ↥((L_part b).obj.obj (Opposite.op (U_part a)))) :=
      fun b => Classical.choose (hDisjGlue (L_part b))
    have he_part : ∀ (b : Fin n) (s : ↥((L_part b).obj.obj (Opposite.op U))) (a : Fin n),
        e_part b s a = ((L_part b).obj.map (Opposite.op (γ a))).hom s :=
      fun b => Classical.choose_spec (hDisjGlue (L_part b))

    let tup_b : ∀ b : Fin n,
        ↥AM →+ (∀ a : Fin n, ↥((L_part b).obj.obj (Opposite.op (U_part a)))) :=
      fun b =>
        { toFun := fun v a =>
            if h : a = b then
              h ▸ (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L_part b))).hom v
            else 0
          map_zero' := by
            funext a
            dsimp
            split_ifs with h
            · subst h; exact map_zero _
            · rfl
          map_add' := fun v₁ v₂ => by
            funext a
            dsimp
            split_ifs with h
            · subst h; exact map_add _ v₁ v₂
            · exact (add_zero 0).symm }

    let π : ∀ b : Fin n, Quiver.Hom L (L_part b) :=
      fun b => CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
        (AddCommGrpCat.ofHom ((e_part b).symm.toAddMonoidHom.comp (tup_b b)))

    have hid : ∀ a : Fin n, CategoryTheory.CategoryStruct.comp (ι a) (π a) =
        CategoryTheory.CategoryStruct.id (L_part a) := by
      intro a
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hEquiv_iota a (π a)]
      have hπ : CategoryTheory.Sheaf.freeYonedaHomEquiv (π a) =
          AddCommGrpCat.ofHom ((e_part a).symm.toAddMonoidHom.comp (tup_b a)) :=
        Equiv.apply_symm_apply _ _
      rw [hπ]
      apply AddCommGrpCat.ext
      intro v
      change ((L_part a).obj.map (Opposite.op (γ a))).hom ((e_part a).symm (tup_b a v)) =
        (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L_part a))).hom v
      rw [← he_part a ((e_part a).symm (tup_b a v)) a, AddEquiv.apply_symm_apply]
      show tup_b a v a = _
      dsimp [tup_b]
      simp

    have horth : ∀ a b : Fin n, a ≠ b → CategoryTheory.CategoryStruct.comp (ι a) (π b) = 0 := by
      intro a b hab
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hEquiv_iota a (π b)]
      have hπ : CategoryTheory.Sheaf.freeYonedaHomEquiv (π b) =
          AddCommGrpCat.ofHom ((e_part b).symm.toAddMonoidHom.comp (tup_b b)) :=
        Equiv.apply_symm_apply _ _
      have h0 : CategoryTheory.Sheaf.freeYonedaHomEquiv (0 : L_part a ⟶ L_part b) = 0 := by
        have hid0 : (0 : L_part a ⟶ L_part b) = 𝟙 (L_part a) ≫ (0 : L_part a ⟶ L_part b) :=
          (CategoryTheory.Category.id_comp _).symm
        rw [hid0, hEquiv_comp Z (U_part a) AM (𝟙 (L_part a)) 0]
        apply AddCommGrpCat.ext
        intro v
        rfl
      rw [hπ, h0]
      apply AddCommGrpCat.ext
      intro v
      change ((L_part b).obj.map (Opposite.op (γ a))).hom ((e_part b).symm (tup_b b v)) = 0
      rw [← he_part b ((e_part b).symm (tup_b b v)) a, AddEquiv.apply_symm_apply]
      show tup_b b v a = 0
      dsimp [tup_b]
      simp [hab]

    have hsum : (Finset.univ.sum fun a : Fin n => CategoryTheory.CategoryStruct.comp (π a) (ι a)) =
        CategoryTheory.CategoryStruct.id L := by
      let S_end : L ⟶ L := Finset.univ.sum fun a : Fin n => π a ≫ ι a
      have h_iota_S : ∀ c : Fin n, ι c ≫ S_end = ι c ≫ 𝟙 L := by
        intro c
        dsimp [S_end]
        rw [CategoryTheory.Preadditive.comp_sum, Finset.sum_eq_single c]
        · rw [← CategoryTheory.Category.assoc, hid c, CategoryTheory.Category.id_comp,
            CategoryTheory.Category.comp_id]
        · intro a _ hac
          rw [← CategoryTheory.Category.assoc, horth c a hac.symm, CategoryTheory.Limits.zero_comp]
        · intro hc
          exact False.elim (hc (Finset.mem_univ c))
      obtain ⟨e_L, he_L⟩ := hDisjGlue L
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      apply AddCommGrpCat.ext
      intro v
      apply e_L.injective
      funext c
      have hL_eval : ∀ g : L ⟶ L,
          e_L ((CategoryTheory.Sheaf.freeYonedaHomEquiv g).hom v) c =
            (CategoryTheory.Sheaf.freeYonedaHomEquiv (ι c ≫ g)).hom v := by
        intro g
        rw [he_L _ c]
        change (CategoryTheory.Sheaf.freeYonedaHomEquiv g ≫ L.obj.map (Opposite.op (γ c))).hom v = _
        rw [← hEquiv_iota c g]
      rw [hL_eval S_end, hL_eval (𝟙 L), h_iota_S c]

    exact ⟨ι, π, hid, horth, hsum⟩

  · intro Ω _ _ m hm S_Ω T_Ω
    let Fgt_S := AlgebraicGeometry.Scheme.Etale.forget S_Ω
    let P_loc := weilAltLocConstPresheaf S_Ω m
    let P_set : CategoryTheory.Functor S_Ω.Etaleᵒᵖ (Type u) :=
      P_loc ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    let toLC : ∀ {V : S_Ω.Etale},
        ↥(P_loc.obj (Opposite.op V)) →
          LocallyConstant ↥(Fgt_S.obj V).left (ULift.{u} (ZMod m)) :=
      fun g => g
    let ofLC : ∀ {V : S_Ω.Etale},
        LocallyConstant ↥(Fgt_S.obj V).left (ULift.{u} (ZMod m)) →
          ↥(P_loc.obj (Opposite.op V)) :=
      fun c => c

    have hTypeSheaf : CategoryTheory.Presieve.IsSheaf S_Ω.smallEtaleTopology P_set := by
      intro W R hR x hx
      obtain ⟨J_cov, Y_cov, u_cov, hu_mem, hCovers⟩ := hUnpackEtaleSieve S_Ω W R hR
      let x_lc : ∀ {Z_et : S_Ω.Etale} (f : Quiver.Hom Z_et W), R.arrows f →
          LocallyConstant ↥(Fgt_S.obj Z_et).left (ULift.{u} (ZMod m)) :=
        fun f hf => x f hf

      have hPullCompat : ∀ {Z₁ Z₂ : S_Ω.Etale} (f₁ : Quiver.Hom Z₁ W) (f₂ : Quiver.Hom Z₂ W)
          (hf₁ : R.arrows f₁) (hf₂ : R.arrows f₂)
          (z₁ : ↥(Fgt_S.obj Z₁).left) (z₂ : ↥(Fgt_S.obj Z₂).left),
          ((Fgt_S.map f₁).left).base z₁ = ((Fgt_S.map f₂).left).base z₂ →
          (x_lc f₁ hf₁) z₁ = (x_lc f₂ hf₂) z₂ := by
        intro Z₁ Z₂ f₁ f₂ hf₁ hf₂ z₁ z₂ hz
        have hEt₁ : AlgebraicGeometry.Etale f₁.left :=
          CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale.{u})
            f₁.left W.hom W.prop ((CategoryTheory.MorphismProperty.Over.w f₁).symm ▸ Z₁.prop)
        have hEt₂ : AlgebraicGeometry.Etale f₂.left :=
          CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale.{u})
            f₂.left W.hom W.prop ((CategoryTheory.MorphismProperty.Over.w f₂).symm ▸ Z₂.prop)
        obtain ⟨q_pb, hq₁, hq₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
            (f := f₁.left) (g := f₂.left) z₁ z₂ hz
        let fst := CategoryTheory.Limits.pullback.fst f₁.left f₂.left
        let snd := CategoryTheory.Limits.pullback.snd f₁.left f₂.left
        have hEtZ₁ : AlgebraicGeometry.Etale Z₁.hom := Z₁.prop
        have hEtFst : AlgebraicGeometry.Etale fst := inferInstance
        let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
          @AlgebraicGeometry.Etale
        let _ : P_et.IsStableUnderComposition :=
          CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
        let Q_et : S_Ω.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (fst ≫ Z₁.hom)
            (P_et.comp_mem fst Z₁.hom hEtFst hEtZ₁)
        let q₁_et : Quiver.Hom Q_et Z₁ :=
          CategoryTheory.MorphismProperty.Over.homMk fst rfl trivial
        have hq₂_w : snd ≫ Z₂.hom = fst ≫ Z₁.hom := by
          calc
            snd ≫ Z₂.hom = snd ≫ (f₂.left ≫ W.hom) := by
              rw [← CategoryTheory.MorphismProperty.Over.w f₂]
            _ = (snd ≫ f₂.left) ≫ W.hom := (CategoryTheory.Category.assoc _ _ _).symm
            _ = (fst ≫ f₁.left) ≫ W.hom := by rw [CategoryTheory.Limits.pullback.condition]
            _ = fst ≫ (f₁.left ≫ W.hom) := CategoryTheory.Category.assoc _ _ _
            _ = fst ≫ Z₁.hom := by rw [CategoryTheory.MorphismProperty.Over.w f₁]
        let q₂_et : Quiver.Hom Q_et Z₂ :=
          CategoryTheory.MorphismProperty.Over.homMk snd hq₂_w trivial
        have hq_comm : q₁_et ≫ f₁ = q₂_et ≫ f₂ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
        have h_eq_lc :
            toLC ((P_loc.map (Opposite.op q₁_et)).hom (ofLC (x_lc f₁ hf₁))) =
              toLC ((P_loc.map (Opposite.op q₂_et)).hom (ofLC (x_lc f₂ hf₂))) :=
          congrArg (@toLC Q_et) (hx q₁_et q₂_et hf₁ hf₂ hq_comm)
        have h_eval := DFunLike.congr_fun h_eq_lc q_pb
        change (x_lc f₁ hf₁) (fst.base q_pb) = (x_lc f₂ hf₂) (snd.base q_pb) at h_eval
        rwa [hq₁, hq₂] at h_eval

      let idx_w : ↥(Fgt_S.obj W).left → J_cov := fun w => Classical.choose (hCovers w)
      let pt_w : ∀ w : ↥(Fgt_S.obj W).left, ↥(Fgt_S.obj (Y_cov (idx_w w))).left :=
        fun w => Classical.choose (Classical.choose_spec (hCovers w))
      have hpt_w : ∀ w : ↥(Fgt_S.obj W).left,
          ((Fgt_S.map (u_cov (idx_w w))).left).base (pt_w w) = w :=
        fun w => Classical.choose_spec (Classical.choose_spec (hCovers w))

      let g_fun : ↥(Fgt_S.obj W).left → ULift.{u} (ZMod m) :=
        fun w => (x_lc (u_cov (idx_w w)) (hu_mem (idx_w w))) (pt_w w)
      have hg_res : ∀ {Z_et : S_Ω.Etale} (f : Quiver.Hom Z_et W) (hf : R.arrows f)
          (z : ↥(Fgt_S.obj Z_et).left),
          g_fun (((Fgt_S.map f).left).base z) = (x_lc f hf) z := by
        intro Z_et f hf z
        exact hPullCompat (u_cov (idx_w (((Fgt_S.map f).left).base z))) f
          (hu_mem _) hf (pt_w _) z (hpt_w (((Fgt_S.map f).left).base z))

      have hg_lc : IsLocallyConstant g_fun := by
        intro E
        have hEq_pre : g_fun ⁻¹' E =
            ⋃ j : J_cov, ((Fgt_S.map (u_cov j)).left).base ''
              ((x_lc (u_cov j) (hu_mem j)) ⁻¹' E) := by
          ext w
          constructor
          · intro hw
            exact Set.mem_iUnion.mpr ⟨idx_w w, pt_w w, hw, hpt_w w⟩
          · intro hw
            obtain ⟨j, z, hz, rfl⟩ := Set.mem_iUnion.mp hw
            change g_fun (((Fgt_S.map (u_cov j)).left).base z) ∈ E
            rw [hg_res (u_cov j) (hu_mem j) z]
            exact hz
        rw [hEq_pre]
        refine isOpen_iUnion (fun j => ?_)
        have hEt_j : AlgebraicGeometry.Etale ((Fgt_S.map (u_cov j)).left) :=
          CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale.{u})
            (u_cov j).left W.hom W.prop
            ((CategoryTheory.MorphismProperty.Over.w (u_cov j)).symm ▸ (Y_cov j).prop)
        exact ((Fgt_S.map (u_cov j)).left).isOpenMap _
          ((x_lc (u_cov j) (hu_mem j)).isLocallyConstant E)

      let g_sec : LocallyConstant ↥(Fgt_S.obj W).left (ULift.{u} (ZMod m)) := ⟨g_fun, hg_lc⟩
      refine ⟨ofLC g_sec, ?_, ?_⟩
      · intro Z_et f hf
        exact LocallyConstant.ext (fun z => hg_res f hf z)
      · intro g' hg'
        let g'_lc : LocallyConstant ↥(Fgt_S.obj W).left (ULift.{u} (ZMod m)) := toLC g'
        show g'_lc = g_sec
        refine LocallyConstant.ext (fun w => ?_)
        let j := idx_w w
        let z₀ := pt_w w
        have hz₀ : ((Fgt_S.map (u_cov j)).left).base z₀ = w := hpt_w w
        have hg'_j : toLC ((P_loc.map (Opposite.op (u_cov j))).hom g') =
            x_lc (u_cov j) (hu_mem j) :=
          congrArg (@toLC (Y_cov j)) (hg' (u_cov j) (hu_mem j))
        calc
          g'_lc w = g'_lc (((Fgt_S.map (u_cov j)).left).base z₀) := by rw [← hz₀]
          _ = (toLC ((P_loc.map (Opposite.op (u_cov j))).hom g')) z₀ := rfl
          _ = (x_lc (u_cov j) (hu_mem j)) z₀ := DFunLike.congr_fun hg'_j z₀
          _ = g_sec w := rfl

    have hLocConstIsSheaf : CategoryTheory.Presheaf.IsSheaf S_Ω.smallEtaleTopology P_loc := by
      intro E W R hR x hx
      let x_pt : ∀ (e : ↥E), CategoryTheory.Presieve.FamilyOfElements P_set R.arrows :=
        fun e Z_et f hf => (x f hf).hom e
      have hx_pt : ∀ e : ↥E, (x_pt e).Compatible := by
        intro e Z₁ Z₂ Q_et g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
        have h_hom := hx g₁ g₂ hf₁ hf₂ hcomm
        exact congrArg (fun φ : E ⟶ P_loc.obj (Opposite.op Q_et) => φ.hom e) h_hom
      let t_pt : ↥E → ↥(P_loc.obj (Opposite.op W)) :=
        fun e => Classical.choose (hTypeSheaf R hR (x_pt e) (hx_pt e))
      have ht_amalg : ∀ e : ↥E, (x_pt e).IsAmalgamation (t_pt e) :=
        fun e => (Classical.choose_spec (hTypeSheaf R hR (x_pt e) (hx_pt e))).1
      have ht_uniq : ∀ (e : ↥E) (g' : ↥(P_loc.obj (Opposite.op W))),
          (x_pt e).IsAmalgamation g' → g' = t_pt e :=
        fun e => (Classical.choose_spec (hTypeSheaf R hR (x_pt e) (hx_pt e))).2
      have ht_zero : t_pt 0 = 0 := by
        symm
        apply ht_uniq 0 0
        intro Z_et f hf
        show (P_loc.map (Opposite.op f)).hom 0 = (x f hf).hom 0
        rw [map_zero, map_zero]
      have ht_add : ∀ e₁ e₂ : ↥E, t_pt (e₁ + e₂) = t_pt e₁ + t_pt e₂ := by
        intro e₁ e₂
        symm
        apply ht_uniq (e₁ + e₂) (t_pt e₁ + t_pt e₂)
        intro Z_et f hf
        have h1_lc : (P_loc.map (Opposite.op f)).hom (t_pt e₁) = (x f hf).hom e₁ :=
          ht_amalg e₁ f hf
        have h2_lc : (P_loc.map (Opposite.op f)).hom (t_pt e₂) = (x f hf).hom e₂ :=
          ht_amalg e₂ f hf
        show (P_loc.map (Opposite.op f)).hom (t_pt e₁ + t_pt e₂) =
          (x f hf).hom (e₁ + e₂)
        rw [map_add, map_add, h1_lc, h2_lc]
      let φ_amalg : E ⟶ P_loc.obj (Opposite.op W) :=
        AddCommGrpCat.ofHom
          { toFun := t_pt
            map_zero' := ht_zero
            map_add' := ht_add }
      refine ⟨φ_amalg, ?_, ?_⟩
      · intro Z_et f hf
        show φ_amalg ≫ P_loc.map f.op = x f hf
        apply AddCommGrpCat.ext
        intro e
        exact ht_amalg e f hf
      · intro ψ hψ
        show (ψ : E ⟶ P_loc.obj (Opposite.op W)) = φ_amalg
        apply AddCommGrpCat.ext
        intro e
        exact ht_uniq e ((ψ : E ⟶ P_loc.obj (Opposite.op W)).hom e) (fun Z_et f hf =>
          congrArg (fun η : E ⟶ P_loc.obj (Opposite.op Z_et) => η.hom e) (hψ f hf))

    have hNonempty_Ω : Nonempty ↥S_Ω :=
      (PrimeSpectrum.nonempty_iff_nontrivial (R := Ω)).mpr inferInstance
    let pt_Ω : ↥S_Ω := Classical.choice hNonempty_Ω
    have hSub_Ω : Subsingleton ↥S_Ω := by
      change Subsingleton (PrimeSpectrum Ω)
      infer_instance

    have hTermCoverSieve : ∀ (W : S_Ω.Etale),
        CategoryTheory.Sieve.ofArrows
          (fun _ : Quiver.Hom T_Ω W => T_Ω)
          (fun u : Quiver.Hom T_Ω W => u) ∈ S_Ω.smallEtaleTopology W := by
      intro W
      apply hEtaleCoverSieve
      intro w
      obtain ⟨O_w, hAff_Ow, hw_in, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (X := W.left) (x := w) (U := ⊤) trivial
      have hw_range : w ∈ Set.range hAff_Ow.fromSpec.base := by
        rw [hAff_Ow.range_fromSpec]
        exact hw_in
      obtain ⟨z_pt, hz_pt⟩ := hw_range
      let R_Ow : CommRingCat.{u} := W.left.presheaf.obj (Opposite.op O_w)
      let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
        @AlgebraicGeometry.Etale
      let _ : P_et.IsStableUnderComposition :=
        CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      have hEt_from : AlgebraicGeometry.Etale (hAff_Ow.fromSpec ≫ W.hom) :=
        P_et.comp_mem hAff_Ow.fromSpec W.hom inferInstance W.prop
      let φ : CommRingCat.of Ω ⟶ R_Ow :=
        AlgebraicGeometry.Spec.preimage (hAff_Ow.fromSpec ≫ W.hom)
      have hmap_φ : AlgebraicGeometry.Spec.map φ = hAff_Ow.fromSpec ≫ W.hom :=
        AlgebraicGeometry.Spec.map_preimage (hAff_Ow.fromSpec ≫ W.hom)
      have hEt_map : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ) := by
        rw [hmap_φ]
        exact hEt_from
      have hEt_hom : φ.hom.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_map
      let _ : Algebra Ω ↑R_Ow := φ.hom.toAlgebra
      have _ : Algebra.Etale Ω ↑R_Ow := RingHom.etale_algebraMap.mp hEt_hom
      obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSep⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod Ω ↑R_Ow).mp inferInstance
      let _ : Finite I := hFinI
      let _ : Fintype I := Fintype.ofFinite I
      let _ : ∀ i : I, Field (Ai i) := hFieldAi
      let _ : ∀ i : I, Algebra Ω (Ai i) := hAlgAi
      have hModFin : ∀ i : I, Module.Finite Ω (Ai i) := fun i => (hFinSep i).1
      let z_ps : PrimeSpectrum ↑R_Ow := z_pt
      let P : Ideal (∀ i : I, Ai i) := Ideal.comap e_prod.symm.toAlgHom.toRingHom z_ps.asIdeal
      have hP_prime : P.IsPrime := Ideal.IsPrime.comap e_prod.symm.toAlgHom.toRingHom
      let δ : I → (∀ j : I, Ai j) := fun i => Pi.single i 1
      have hsum_δ : (∑ i : I, δ i) = 1 := by
        funext j
        simp [δ]
      have hex_i : ∃ i₀ : I, δ i₀ ∉ P := by
        by_contra h_none
        have h_all : ∀ i : I, δ i ∈ P :=
          fun i => Classical.not_not.mp (fun hi => h_none ⟨i, hi⟩)
        have h1_in : (1 : ∀ j : I, Ai j) ∈ P := by
          rw [← hsum_δ]
          exact Ideal.sum_mem P (fun i _ => h_all i)
        exact hP_prime.ne_top (P.eq_top_of_isUnit_mem h1_in isUnit_one)
      obtain ⟨i₀, hi₀⟩ := hex_i
      have _ : Module.Finite Ω (Ai i₀) := hModFin i₀
      have _ : Algebra.IsIntegral Ω (Ai i₀) := inferInstance
      have hBij_i₀ : Function.Bijective (algebraMap Ω (Ai i₀)) :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral (k := Ω) (K := Ai i₀)
      let e_field : Ω ≃ₐ[Ω] Ai i₀ := AlgEquiv.ofBijective (Algebra.ofId Ω (Ai i₀)) hBij_i₀
      let ev_alg : ↑R_Ow →ₐ[Ω] Ω :=
        e_field.symm.toAlgHom.comp ((Pi.evalAlgHom Ω Ai i₀).comp e_prod.toAlgHom)
      let σ : R_Ow ⟶ CommRingCat.of Ω := CommRingCat.ofHom ev_alg.toRingHom
      have hφ_σ : φ ≫ σ = 𝟙 (CommRingCat.of Ω) := by
        ext c
        exact ev_alg.commutes c
      have hσ_pt : (AlgebraicGeometry.Spec.map σ).base pt_Ω = z_pt := by
        let q_ps : PrimeSpectrum Ω := pt_Ω
        have hq_bot : ∀ c : Ω, c ∈ q_ps.asIdeal ↔ c = 0 := by
          intro c
          constructor
          · intro hc
            by_contra hc0
            have h1 : (1 : Ω) ∈ q_ps.asIdeal := by
              have := q_ps.asIdeal.mul_mem_right c⁻¹ hc
              rwa [mul_inv_cancel₀ hc0] at this
            exact q_ps.isPrime.ne_top (q_ps.asIdeal.eq_top_of_isUnit_mem h1 isUnit_one)
          · rintro rfl
            exact q_ps.asIdeal.zero_mem
        change PrimeSpectrum.comap ev_alg.toRingHom q_ps = z_ps
        apply PrimeSpectrum.ext
        ext r
        rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, hq_bot]
        let c : Ω := ev_alg r
        have hc_i₀ : algebraMap Ω (Ai i₀) c = e_prod r i₀ := by
          change e_field (e_field.symm (e_prod r i₀)) = _
          exact e_field.apply_symm_apply _
        have hprod_zero : δ i₀ * (e_prod r - algebraMap Ω (∀ j : I, Ai j) c) = 0 := by
          funext j
          by_cases hj : j = i₀
          · subst hj
            simp [δ, Pi.algebraMap_apply, hc_i₀]
          · simp [δ, Pi.single_eq_of_ne hj]
        have hmul_in : δ i₀ * (e_prod r - algebraMap Ω (∀ j : I, Ai j) c) ∈ P := by
          rw [hprod_zero]
          exact P.zero_mem
        have hdiff_P : e_prod r - algebraMap Ω (∀ j : I, Ai j) c ∈ P :=
          (hP_prime.mem_or_mem hmul_in).resolve_left hi₀
        have hdiff_R : r - φ.hom c ∈ z_ps.asIdeal := by
          have hm : e_prod.symm (e_prod r - algebraMap Ω (∀ j : I, Ai j) c) ∈ z_ps.asIdeal :=
            hdiff_P
          rwa [map_sub, e_prod.symm_apply_apply, e_prod.symm.commutes] at hm
        change c = 0 ↔ r ∈ z_ps.asIdeal
        constructor
        · intro hc0
          have hr : r - φ.hom 0 ∈ z_ps.asIdeal := hc0 ▸ hdiff_R
          rwa [map_zero, sub_zero] at hr
        · intro hr
          by_contra hc0
          have hφc : φ.hom c ∈ z_ps.asIdeal := by
            have hsub := z_ps.asIdeal.sub_mem hr hdiff_R
            simpa using hsub
          have h1 : (1 : ↑R_Ow) ∈ z_ps.asIdeal := by
            have hmul := z_ps.asIdeal.mul_mem_right (φ.hom c⁻¹) hφc
            rw [← map_mul, mul_inv_cancel₀ hc0, map_one] at hmul
            exact hmul
          exact z_ps.isPrime.ne_top (z_ps.asIdeal.eq_top_of_isUnit_mem h1 isUnit_one)
      let u_hom : S_Ω ⟶ W.left := AlgebraicGeometry.Spec.map σ ≫ hAff_Ow.fromSpec
      have hu_w : u_hom ≫ W.hom = 𝟙 S_Ω := by
        dsimp [u_hom]
        rw [CategoryTheory.Category.assoc, ← hmap_φ, ← AlgebraicGeometry.Spec.map_comp,
            hφ_σ, AlgebraicGeometry.Spec.map_id]
      let u_et : Quiver.Hom T_Ω W :=
        CategoryTheory.MorphismProperty.Over.homMk u_hom hu_w trivial
      refine ⟨u_et, pt_Ω, ?_⟩
      change hAff_Ow.fromSpec.base ((AlgebraicGeometry.Spec.map σ).base pt_Ω) = w
      rw [hσ_pt, hz_pt]

    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let L_T := weilEtaleLocalTorsionSheaf S_Ω m T_Ω
    let F_loc : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨P_loc, hLocConstIsSheaf⟩
    let α_loc : L_T ⟶ F_loc :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm (weilAltLocConstConstHom S_Ω T_Ω m)
    let ξ_T : AM ⟶ L_T.obj.obj (Opposite.op T_Ω) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_T)

    have hTermAmalg : ∀ (W : S_Ω.Etale)
        (c : ↥(P_loc.obj (Opposite.op W))),
        ∃! t : ↥(L_T.obj.obj (Opposite.op W)),
          ∀ u : Quiver.Hom T_Ω W,
            (L_T.obj.map (Opposite.op u)).hom t =
              ξ_T.hom ((toLC c) (((Fgt_S.map u).left).base pt_Ω)) := by
      intro W c
      refine hGlueArrows S_Ω L_T W
        (fun _ : Quiver.Hom T_Ω W => T_Ω)
        (fun u : Quiver.Hom T_Ω W => u)
        (hTermCoverSieve W)
        (fun u => ξ_T.hom ((toLC c) (((Fgt_S.map u).left).base pt_Ω)))
        ?_
      intro u₁ u₂ Z_et g₁ g₂ hcomm
      have hg_eq : g₁ = g₂ :=
        (weilEtaleIdTerminalIsTerminal S_Ω).hom_ext g₁ g₂
      subst hg_eq
      by_cases hEmp : IsEmpty ↥((Fgt_S.obj Z_et).left)
      · have hSub_Z := hEmptySub S_Ω L_T Z_et hEmp
        exact Subsingleton.elim _ _
      · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hEmp
        have hpt₁ : ((Fgt_S.map g₁).left).base z₀ = pt_Ω := hSub_Ω.elim _ _
        have hbase_eq : ((Fgt_S.map u₁).left).base pt_Ω = ((Fgt_S.map u₂).left).base pt_Ω := by
          rw [← hpt₁]
          exact congrArg (fun k : Quiver.Hom Z_et W => k.left.base z₀) hcomm
        rw [hbase_eq]

    let β_fun : ∀ (W : S_Ω.Etale),
        ↥(P_loc.obj (Opposite.op W)) → ↥(L_T.obj.obj (Opposite.op W)) :=
      fun W c => Classical.choose (hTermAmalg W c)
    have hβ_spec : ∀ (W : S_Ω.Etale)
        (c : ↥(P_loc.obj (Opposite.op W)))
        (u : Quiver.Hom T_Ω W),
        (L_T.obj.map (Opposite.op u)).hom (β_fun W c) =
          ξ_T.hom ((toLC c) (((Fgt_S.map u).left).base pt_Ω)) :=
      fun W c => (Classical.choose_spec (hTermAmalg W c)).1
    have hβ_uniq : ∀ (W : S_Ω.Etale)
        (c : ↥(P_loc.obj (Opposite.op W)))
        (t : ↥(L_T.obj.obj (Opposite.op W))),
        (∀ u : Quiver.Hom T_Ω W,
          (L_T.obj.map (Opposite.op u)).hom t =
            ξ_T.hom ((toLC c) (((Fgt_S.map u).left).base pt_Ω))) →
        t = β_fun W c :=
      fun W c => (Classical.choose_spec (hTermAmalg W c)).2

    let β_app : ∀ (W : S_Ω.Etale), P_loc.obj (Opposite.op W) ⟶ L_T.obj.obj (Opposite.op W) :=
      fun W => AddCommGrpCat.ofHom
        { toFun := β_fun W
          map_zero' := by
            symm
            apply hβ_uniq W 0 0
            intro u
            rw [map_zero]
            exact (map_zero ξ_T.hom).symm
          map_add' := fun c₁ c₂ => by
            symm
            apply hβ_uniq W (c₁ + c₂) (β_fun W c₁ + β_fun W c₂)
            intro u
            rw [map_add, hβ_spec W c₁ u, hβ_spec W c₂ u]
            exact (map_add ξ_T.hom _ _).symm }

    let β_loc : F_loc ⟶ L_T := CategoryTheory.ObjectProperty.homMk
      { app := fun W_op => β_app (Opposite.unop W_op)
        naturality := fun {W₁_op W₂_op} f_op => by
          apply AddCommGrpCat.ext
          intro c
          change β_fun (Opposite.unop W₂_op) ((P_loc.map f_op).hom c) =
            (L_T.obj.map f_op).hom (β_fun (Opposite.unop W₁_op) c)
          symm
          apply hβ_uniq (Opposite.unop W₂_op) ((P_loc.map f_op).hom c)
          intro u
          have hcomp : (L_T.obj.map (Opposite.op u)).hom
              ((L_T.obj.map f_op).hom (β_fun (Opposite.unop W₁_op) c)) =
              (L_T.obj.map (Opposite.op (u ≫ f_op.unop))).hom
                (β_fun (Opposite.unop W₁_op) c) := by
            have hop : (f_op ≫ Opposite.op u) = Opposite.op (u ≫ f_op.unop) := rfl
            change ((L_T.obj.map f_op ≫ L_T.obj.map (Opposite.op u)).hom) _ = _
            rw [← L_T.obj.map_comp, hop]
            rfl
          exact hcomp.trans (hβ_spec (Opposite.unop W₁_op) c (u ≫ f_op.unop)) }

    have hSplit : α_loc ≫ β_loc = CategoryTheory.CategoryStruct.id L_T := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hEquiv_comp S_Ω T_Ω AM α_loc β_loc]
      have hα : CategoryTheory.Sheaf.freeYonedaHomEquiv α_loc =
          weilAltLocConstConstHom S_Ω T_Ω m :=
        Equiv.apply_symm_apply _ _
      rw [hα]
      apply AddCommGrpCat.ext
      intro a
      let c_a : ↥(P_loc.obj (Opposite.op T_Ω)) := (weilAltLocConstConstHom S_Ω T_Ω m).hom a
      change β_fun T_Ω c_a = ξ_T.hom a
      have h_id := hβ_spec T_Ω c_a (CategoryTheory.CategoryStruct.id T_Ω)
      have h_map_id : L_T.obj.map (Opposite.op (CategoryTheory.CategoryStruct.id T_Ω)) =
          CategoryTheory.CategoryStruct.id (L_T.obj.obj (Opposite.op T_Ω)) :=
        L_T.obj.map_id (Opposite.op T_Ω)
      have h_lhs : (L_T.obj.map (Opposite.op (CategoryTheory.CategoryStruct.id T_Ω))).hom
          (β_fun T_Ω c_a) = β_fun T_Ω c_a :=
        congrArg (fun φ : L_T.obj.obj (Opposite.op T_Ω) ⟶ L_T.obj.obj (Opposite.op T_Ω) =>
          φ.hom (β_fun T_Ω c_a)) h_map_id
      exact h_lhs.symm.trans h_id

    have hInj_α : Function.Injective ((α_loc.hom.app (Opposite.op T_Ω)).hom) := by
      intro s₁ s₂ hs
      have h_inv : ∀ s : ↥(L_T.obj.obj (Opposite.op T_Ω)),
          (β_loc.hom.app (Opposite.op T_Ω)).hom ((α_loc.hom.app (Opposite.op T_Ω)).hom s) = s := by
        intro s
        change (((α_loc ≫ β_loc).hom.app (Opposite.op T_Ω)).hom) s = s
        rw [hSplit]
        rfl
      rw [← h_inv s₁, ← h_inv s₂, hs]

    have hNeZero : NeZero m := ⟨by omega⟩
    have hSubDom : Subsingleton ↥(Fgt_S.obj T_Ω).left := hSub_Ω
    have hFinDom : Finite ↥(Fgt_S.obj T_Ω).left := Finite.of_subsingleton
    have hFinCod : Finite (ULift.{u} (ZMod m)) := inferInstance
    have hFinFun : Finite (↥(Fgt_S.obj T_Ω).left → ULift.{u} (ZMod m)) := Pi.finite
    have hFinLC : Finite ↥(F_loc.obj.obj (Opposite.op T_Ω)) :=
      @Finite.of_injective
        (LocallyConstant ↥(Fgt_S.obj T_Ω).left (ULift.{u} (ZMod m)))
        (↥(Fgt_S.obj T_Ω).left → ULift.{u} (ZMod m))
        hFinFun DFunLike.coe LocallyConstant.coe_injective
    exact @Finite.of_injective _ _ hFinLC _ hInj_α

theorem weil_etale_separated_section_localTorsion_directImage (X₀ S : AlgebraicGeometry.Scheme.{u})
    (π₀ : Quiver.Hom X₀ S) [AlgebraicGeometry.IsSeparated π₀]
    (s : Quiver.Hom S X₀) (hs : AlgebraicGeometry.Etale s)
    (hsec : CategoryTheory.CategoryStruct.comp s π₀ = CategoryTheory.CategoryStruct.id S)
    (m : ℕ) :
    let T_S : S.Etale := weilEtaleIdTerminal S
    let S_s : X₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ s hs
    (∀ (q : ℕ), 1 ≤ q →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage π₀ q (weilEtaleLocalTorsionSheaf X₀ m S_s))) ∧
    Nonempty (CategoryTheory.Iso
      (weilEtaleLocalTorsionSheaf S m T_S)
      (weilEtaleHigherDirectImage π₀ 0 (weilEtaleLocalTorsionSheaf X₀ m S_s))) :=
by
  classical
  intro T_S S_s
  
  have hEt_s : AlgebraicGeometry.Etale s := hs
  have hMono_s : CategoryTheory.Mono s := ⟨fun {Z} g₁ g₂ hg => by
    calc
      g₁ = CategoryTheory.CategoryStruct.comp g₁ (CategoryTheory.CategoryStruct.id S) :=
        (CategoryTheory.Category.comp_id g₁).symm
      _ = CategoryTheory.CategoryStruct.comp g₁ (CategoryTheory.CategoryStruct.comp s π₀) := by
        rw [hsec]
      _ = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp g₁ s) π₀ :=
        (CategoryTheory.Category.assoc g₁ s π₀).symm
      _ = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp g₂ s) π₀ := by
        rw [hg]
      _ = CategoryTheory.CategoryStruct.comp g₂ (CategoryTheory.CategoryStruct.comp s π₀) :=
        CategoryTheory.Category.assoc g₂ s π₀
      _ = CategoryTheory.CategoryStruct.comp g₂ (CategoryTheory.CategoryStruct.id S) := by
        rw [hsec]
      _ = g₂ := CategoryTheory.Category.comp_id g₂⟩
  have hOpen_s : AlgebraicGeometry.IsOpenImmersion s :=
    AlgebraicGeometry.IsOpenImmersion.of_flat_of_mono s
  have hClosed_comp : AlgebraicGeometry.IsClosedImmersion (CategoryTheory.CategoryStruct.comp s π₀) := by
    rw [hsec]
    infer_instance
  have hClosed_s : AlgebraicGeometry.IsClosedImmersion s :=
    @AlgebraicGeometry.IsClosedImmersion.of_comp _ _ _ s π₀ hClosed_comp inferInstance

  
  have hMemEtaleTop : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (X : Z.Etale)
      (S_sieve : CategoryTheory.Sieve X),
      S_sieve ∈ Z.smallEtaleTopology X ↔
        ∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget Z).obj X).left,
          ∃ (V : Z.Etale) (u : V ⟶ X),
            S_sieve.arrows u ∧
            x ∈ Set.range (((AlgebraicGeometry.Scheme.Etale.forget Z).map u).left).base := by
    intro Z X S_sieve
    let FgtZ := AlgebraicGeometry.Scheme.Etale.forget Z
    letI : CategoryTheory.Category.{u, u + 1}
        (CategoryTheory.MorphismProperty.Over (@AlgebraicGeometry.Etale.{u}) ⊤ Z) :=
      (inferInstance : CategoryTheory.Category Z.Etale)
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hEqTop :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology Z
        (le_refl (@AlgebraicGeometry.Etale))
    have hIff0 : (S_sieve ∈ Z.smallEtaleTopology X) ↔
        (S_sieve ∈ (AlgebraicGeometry.Scheme.smallGrothendieckTopology
          (@AlgebraicGeometry.Etale) Z) X) := Iff.rfl
    rw [hIff0, (Iff.of_eq (congrArg (fun J => S_sieve ∈ J X) hEqTop)).trans
      (CategoryTheory.Pretopology.mem_toGrothendieck _ X S_sieve)]
    constructor
    · rintro ⟨R, hR_cov, hR_le⟩ x
      obtain ⟨_, _, hmap3, y, hy⟩ :=
        CategoryTheory.Types.mem_jointlySurjectivePrecoverage_iff.mp hR_cov.1 x
      cases hmap3 with
      | @of _ _ hmap2 =>
        cases hmap2 with
        | @of _ _ hmap1 =>
          cases hmap1 with
          | @of V u hu_R =>
            exact ⟨V, u, hR_le V u hu_R, y, hy⟩
    · intro hCov
      refine ⟨S_sieve.arrows, ⟨?_, ?_⟩, le_rfl⟩
      · refine CategoryTheory.Types.mem_jointlySurjectivePrecoverage_iff.mpr (fun x => ?_)
        obtain ⟨V, u, hu, y, hy⟩ := hCov x
        exact ⟨_, _, CategoryTheory.Presieve.map.of
          (CategoryTheory.Presieve.map.of (CategoryTheory.Presieve.map.of hu)), y, hy⟩
      · intro _ _ hmap2
        cases hmap2 with
        | @of _ _ hmap1 =>
          cases hmap1 with
          | @of V u _ =>
            have hcomp : CategoryTheory.CategoryStruct.comp
                ((FgtZ.map u).left) ((FgtZ.obj X).hom) = (FgtZ.obj V).hom :=
              CategoryTheory.MorphismProperty.Over.w u
            have hEt_comp : AlgebraicGeometry.Etale
                (CategoryTheory.CategoryStruct.comp ((FgtZ.map u).left) ((FgtZ.obj X).hom)) := by
              rw [hcomp]
              exact V.prop
            exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
              ((FgtZ.map u).left) ((FgtZ.obj X).hom) X.prop hEt_comp

  have hc_pull : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_h : CategoryTheory.Functor Z₂.Etale Z₁.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
      B_h.IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := by
    intro Z₁ Z₂ h
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_h : CategoryTheory.Functor Z₂.Etale Z₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget Z₁
    let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget Z₂
    have hCompat_B : CategoryTheory.CompatiblePreserving Z₁.smallEtaleTopology B_h := by
      refine CategoryTheory.CompatiblePreserving.mk ?_
      intro ℱ Z_c T x_fam hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ heq
      let g₁_left := (Fgt₂.map g₁).left
      let g₂_left := (Fgt₂.map g₂).left
      have hg₁_et : AlgebraicGeometry.Etale g₁_left := by
        have hcomp : CategoryTheory.CategoryStruct.comp g₁_left ((Fgt₂.obj Z_c).hom) =
            (Fgt₂.obj Y₁).hom := CategoryTheory.MorphismProperty.Over.w g₁
        have hEt_comp : AlgebraicGeometry.Etale
            (CategoryTheory.CategoryStruct.comp g₁_left ((Fgt₂.obj Z_c).hom)) := by
          rw [hcomp]; exact Y₁.prop
        exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          g₁_left ((Fgt₂.obj Z_c).hom) Z_c.prop hEt_comp
      have hg₂_et : AlgebraicGeometry.Etale g₂_left := by
        have hcomp : CategoryTheory.CategoryStruct.comp g₂_left ((Fgt₂.obj Z_c).hom) =
            (Fgt₂.obj Y₂).hom := CategoryTheory.MorphismProperty.Over.w g₂
        have hEt_comp : AlgebraicGeometry.Etale
            (CategoryTheory.CategoryStruct.comp g₂_left ((Fgt₂.obj Z_c).hom)) := by
          rw [hcomp]; exact Y₂.prop
        exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          g₂_left ((Fgt₂.obj Z_c).hom) Z_c.prop hEt_comp
      let p₁_left := CategoryTheory.Limits.pullback.fst g₁_left g₂_left
      let p₂_left := CategoryTheory.Limits.pullback.snd g₁_left g₂_left
      have : AlgebraicGeometry.Etale p₁_left := inferInstance
      have : AlgebraicGeometry.Etale ((Fgt₂.obj Y₁).hom) := Y₁.prop
      let P_et : Z₂.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
        (CategoryTheory.CategoryStruct.comp p₁_left ((Fgt₂.obj Y₁).hom)) inferInstance
      let p₁_et : P_et ⟶ Y₁ :=
        CategoryTheory.MorphismProperty.Over.homMk p₁_left rfl trivial
      have hp₂_w : CategoryTheory.CategoryStruct.comp p₂_left ((Fgt₂.obj Y₂).hom) =
          (Fgt₂.obj P_et).hom :=
        ((congrArg (CategoryTheory.CategoryStruct.comp p₂_left)
          (CategoryTheory.MorphismProperty.Over.w g₂).symm).trans
          (CategoryTheory.Category.assoc p₂_left g₂_left _).symm).trans
          (((congrArg (fun k => CategoryTheory.CategoryStruct.comp k ((Fgt₂.obj Z_c).hom))
            (CategoryTheory.Limits.pullback.condition (f := g₁_left) (g := g₂_left)).symm).trans
            (CategoryTheory.Category.assoc p₁_left g₁_left _)).trans
            (congrArg (CategoryTheory.CategoryStruct.comp p₁_left)
              (CategoryTheory.MorphismProperty.Over.w g₁)))
      let p₂_et : P_et ⟶ Y₂ :=
        CategoryTheory.MorphismProperty.Over.homMk p₂_left hp₂_w trivial
      have hp_comm : CategoryTheory.CategoryStruct.comp p₁_et g₁ =
          CategoryTheory.CategoryStruct.comp p₂_et g₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Limits.pullback.condition (f := g₁_left) (g := g₂_left))
          (Subsingleton.elim _ _)
      let a₁ := CategoryTheory.CategoryStruct.comp ((Fgt₁.map f₁).left)
        (CategoryTheory.Limits.pullback.fst ((Fgt₂.obj Y₁).hom) h)
      let a₂ := CategoryTheory.CategoryStruct.comp ((Fgt₁.map f₂).left)
        (CategoryTheory.Limits.pullback.fst ((Fgt₂.obj Y₂).hom) h)
      have ha_eq : CategoryTheory.CategoryStruct.comp a₁ g₁_left =
          CategoryTheory.CategoryStruct.comp a₂ g₂_left := by
        have hf_eq := congrArg
          (fun k => CategoryTheory.CategoryStruct.comp ((Fgt₁.map k).left)
            (CategoryTheory.Limits.pullback.fst ((Fgt₂.obj Z_c).hom) h)) heq
        have hL : CategoryTheory.CategoryStruct.comp
            ((Fgt₁.map (CategoryTheory.CategoryStruct.comp f₁ (B_h.map g₁))).left)
            (CategoryTheory.Limits.pullback.fst ((Fgt₂.obj Z_c).hom) h) =
            CategoryTheory.CategoryStruct.comp a₁ g₁_left :=
          ((CategoryTheory.Category.assoc ((Fgt₁.map f₁).left) _ _).trans
            (congrArg (CategoryTheory.CategoryStruct.comp ((Fgt₁.map f₁).left))
              (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
            (CategoryTheory.Category.assoc _ _ _).symm
        have hR : CategoryTheory.CategoryStruct.comp
            ((Fgt₁.map (CategoryTheory.CategoryStruct.comp f₂ (B_h.map g₂))).left)
            (CategoryTheory.Limits.pullback.fst ((Fgt₂.obj Z_c).hom) h) =
            CategoryTheory.CategoryStruct.comp a₂ g₂_left :=
          ((CategoryTheory.Category.assoc ((Fgt₁.map f₂).left) _ _).trans
            (congrArg (CategoryTheory.CategoryStruct.comp ((Fgt₁.map f₂).left))
              (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
            (CategoryTheory.Category.assoc _ _ _).symm
        exact hL.symm.trans (hf_eq.trans hR)
      let a_P := CategoryTheory.Limits.pullback.lift a₁ a₂ ha_eq
      have hw_cond : CategoryTheory.CategoryStruct.comp a_P ((Fgt₂.obj P_et).hom) =
          CategoryTheory.CategoryStruct.comp ((Fgt₁.obj X).hom) h :=
        ((CategoryTheory.Category.assoc a_P p₁_left ((Fgt₂.obj Y₁).hom)).symm.trans
          (congrArg (fun k => CategoryTheory.CategoryStruct.comp k ((Fgt₂.obj Y₁).hom))
            (CategoryTheory.Limits.pullback.lift_fst a₁ a₂ ha_eq))).trans
          (((CategoryTheory.Category.assoc ((Fgt₁.map f₁).left) _ _).trans
            (congrArg (CategoryTheory.CategoryStruct.comp ((Fgt₁.map f₁).left))
              (CategoryTheory.Limits.pullback.condition (f := (Fgt₂.obj Y₁).hom) (g := h)))).trans
            ((CategoryTheory.Category.assoc ((Fgt₁.map f₁).left) _ h).symm.trans
              (congrArg (fun k => CategoryTheory.CategoryStruct.comp k h)
                (CategoryTheory.MorphismProperty.Over.w f₁))))
      let w_left := CategoryTheory.Limits.pullback.lift a_P ((Fgt₁.obj X).hom) hw_cond
      let w : X ⟶ B_h.obj P_et :=
        CategoryTheory.MorphismProperty.Over.homMk w_left
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
      have hw₁ : CategoryTheory.CategoryStruct.comp w (B_h.map p₁_et) = f₁ := by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact ((CategoryTheory.Category.assoc w_left _ _).trans
            (congrArg (CategoryTheory.CategoryStruct.comp w_left)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
            (((CategoryTheory.Category.assoc w_left _ p₁_left).symm.trans
              (congrArg (fun k => CategoryTheory.CategoryStruct.comp k p₁_left)
                (CategoryTheory.Limits.pullback.lift_fst a_P _ hw_cond))).trans
              (CategoryTheory.Limits.pullback.lift_fst a₁ a₂ ha_eq))
        · exact ((CategoryTheory.Category.assoc w_left _ _).trans
            (congrArg (CategoryTheory.CategoryStruct.comp w_left)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _))).trans
            ((CategoryTheory.Limits.pullback.lift_snd a_P _ hw_cond).trans
              (CategoryTheory.MorphismProperty.Over.w f₁).symm)
      have hw₂ : CategoryTheory.CategoryStruct.comp w (B_h.map p₂_et) = f₂ := by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact ((CategoryTheory.Category.assoc w_left _ _).trans
            (congrArg (CategoryTheory.CategoryStruct.comp w_left)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
            (((CategoryTheory.Category.assoc w_left _ p₂_left).symm.trans
              (congrArg (fun k => CategoryTheory.CategoryStruct.comp k p₂_left)
                (CategoryTheory.Limits.pullback.lift_fst a_P _ hw_cond))).trans
              (CategoryTheory.Limits.pullback.lift_snd a₁ a₂ ha_eq))
        · exact ((CategoryTheory.Category.assoc w_left _ _).trans
            (congrArg (CategoryTheory.CategoryStruct.comp w_left)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _))).trans
            ((CategoryTheory.Limits.pullback.lift_snd a_P _ hw_cond).trans
              (CategoryTheory.MorphismProperty.Over.w f₂).symm)
      have hmid := congrArg (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map w.op))
        (hx p₁_et p₂_et hg₁ hg₂ hp_comm)
      have hmap₁ : (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map w.op))
          ((CategoryTheory.ConcreteCategory.hom (ℱ.obj.map (B_h.map p₁_et).op)) (x_fam g₁ hg₁)) =
          (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map f₁.op)) (x_fam g₁ hg₁) := by
        rw [← CategoryTheory.ConcreteCategory.comp_apply, ← ℱ.obj.map_comp,
          show ((B_h.map p₁_et).op ≫ w.op) =
            Opposite.op (CategoryTheory.CategoryStruct.comp w (B_h.map p₁_et)) from rfl,
          hw₁]
        rfl
      have hmap₂ : (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map w.op))
          ((CategoryTheory.ConcreteCategory.hom (ℱ.obj.map (B_h.map p₂_et).op)) (x_fam g₂ hg₂)) =
          (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map f₂.op)) (x_fam g₂ hg₂) := by
        rw [← CategoryTheory.ConcreteCategory.comp_apply, ← ℱ.obj.map_comp,
          show ((B_h.map p₂_et).op ≫ w.op) =
            Opposite.op (CategoryTheory.CategoryStruct.comp w (B_h.map p₂_et)) from rfl,
          hw₂]
        rfl
      exact hmap₁.symm.trans (hmid.trans hmap₂)
    refine CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat_B ⟨fun {U} R hR => ?_⟩
    rw [hMemEtaleTop (B_h.obj U)]
    intro z
    let u_hom := (Fgt₂.obj U).hom
    let x : ↥(Fgt₂.obj U).left := (CategoryTheory.Limits.pullback.fst u_hom h).base z
    obtain ⟨V, u, hu, y, hy⟩ := (hMemEtaleTop U R).mp hR x
    let v_hom := (Fgt₂.obj V).hom
    let u_left := (Fgt₂.map u).left
    have hu_w : CategoryTheory.CategoryStruct.comp u_left u_hom = v_hom :=
      CategoryTheory.MorphismProperty.Over.w u
    have hpb_outer_flip : CategoryTheory.IsPullback
        (CategoryTheory.CategoryStruct.comp ((Fgt₁.map (B_h.map u)).left)
          (CategoryTheory.Limits.pullback.snd u_hom h))
        (CategoryTheory.Limits.pullback.fst v_hom h)
        h (CategoryTheory.CategoryStruct.comp u_left u_hom) := by
      have hcomp_snd : CategoryTheory.CategoryStruct.comp ((Fgt₁.map (B_h.map u)).left)
          (CategoryTheory.Limits.pullback.snd u_hom h) =
          CategoryTheory.Limits.pullback.snd v_hom h :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      rw [hcomp_snd, hu_w]
      exact (CategoryTheory.IsPullback.of_hasPullback v_hom h).flip
    have hpb_right_flip : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd u_hom h)
        (CategoryTheory.Limits.pullback.fst u_hom h)
        h u_hom :=
      (CategoryTheory.IsPullback.of_hasPullback u_hom h).flip
    have hpb_left : CategoryTheory.IsPullback
        ((Fgt₁.map (B_h.map u)).left)
        (CategoryTheory.Limits.pullback.fst v_hom h)
        (CategoryTheory.Limits.pullback.fst u_hom h) u_left :=
      CategoryTheory.IsPullback.of_right hpb_outer_flip
        (CategoryTheory.Limits.pullback.lift_fst _ _ _) hpb_right_flip
    let iso_pb := hpb_left.isoPullback
    have hyz : (CategoryTheory.Limits.pullback.fst u_hom h).base z = u_left.base y := hy.symm
    obtain ⟨q₀, hq₀_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
        (f := CategoryTheory.Limits.pullback.fst u_hom h) (g := u_left) z y hyz
    let q : ↥(Fgt₁.obj (B_h.obj V)).left := iso_pb.inv.base q₀
    have hq_map : ((Fgt₁.map (B_h.map u)).left).base q = z :=
      ((AlgebraicGeometry.Scheme.Hom.comp_apply iso_pb.inv ((Fgt₁.map (B_h.map u)).left) q₀).symm.trans
        (congrArg (fun k => k.base q₀) hpb_left.isoPullback_inv_fst)).trans hq₀_fst
    exact ⟨B_h.obj V, B_h.map u,
      CategoryTheory.Sieve.image_mem_functorPushforward B_h R hu, q, hq_map⟩

  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_s : CategoryTheory.Functor X₀.Etale S.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ s
  let B_p : CategoryTheory.Functor S.Etale X₀.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ π₀
  let j_s : CategoryTheory.Functor S.Etale X₀.Etale := weilEtalePostcomp s hs
  let FgtS := AlgebraicGeometry.Scheme.Etale.forget S
  let FgtX := AlgebraicGeometry.Scheme.Etale.forget X₀
  let J_S := S.smallEtaleTopology
  let J_X := X₀.smallEtaleTopology

  let hc_s : B_s.IsContinuous J_X J_S := hc_pull s
  let hc_p : B_p.IsContinuous J_S J_X := hc_pull π₀
  letI := hc_s
  letI := hc_p

  have hFaithful_j : j_s.Faithful := ⟨fun {_ _} {f₁ f₂} hf =>
    CategoryTheory.MorphismProperty.Comma.Hom.ext
      (congrArg (fun g => (FgtX.map g).left) hf) (Subsingleton.elim _ _)⟩
  have hFull_j : j_s.Full :=
    { map_surjective := fun {W₁ W₂} g =>
        have hw : CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp ((FgtX.map g).left) ((FgtS.obj W₂).hom)) s =
            CategoryTheory.CategoryStruct.comp ((FgtS.obj W₁).hom) s :=
          (CategoryTheory.Category.assoc ((FgtX.map g).left) ((FgtS.obj W₂).hom) s).trans
            (CategoryTheory.MorphismProperty.Over.w g)
        ⟨CategoryTheory.MorphismProperty.Over.homMk ((FgtX.map g).left)
          ((cancel_mono s).mp hw) trivial,
         CategoryTheory.MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)⟩ }
  let hDown_j : ∀ {W : S.Etale} {Y : X₀.Etale} (_ : Y ⟶ j_s.obj W),
      Σ W' : S.Etale, (j_s.obj W' ≅ Y) := fun {W Y} g =>
    let w_left := CategoryTheory.CategoryStruct.comp ((FgtX.map g).left) ((FgtS.obj W).hom)
    have hw_eq : CategoryTheory.CategoryStruct.comp w_left s = (FgtX.obj Y).hom :=
      (CategoryTheory.Category.assoc ((FgtX.map g).left) ((FgtS.obj W).hom) s).trans
        (CategoryTheory.MorphismProperty.Over.w g)
    have hEt_w : AlgebraicGeometry.Etale w_left := by
      have hEt_comp : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp w_left s) := by
        rw [hw_eq]
        exact Y.prop
      exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) w_left s hs hEt_comp
    let W' : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w_left hEt_w
    ⟨W', {
      hom := CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.CategoryStruct.id (FgtX.obj Y).left)
        ((CategoryTheory.Category.id_comp _).trans hw_eq.symm) trivial
      inv := CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.CategoryStruct.id (FgtX.obj Y).left)
        ((CategoryTheory.Category.id_comp _).trans hw_eq) trivial
      hom_inv_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
        (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
      inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
        (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _) }⟩
  have hCompat_j : CategoryTheory.CompatiblePreserving J_X j_s :=
    CategoryTheory.compatiblePreservingOfDownwardsClosed J_X j_s (fun {W Y} g => hDown_j g)
  let hc_j : j_s.IsContinuous J_S J_X := by
    refine CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat_j ⟨fun {W} R hR => ?_⟩
    rw [hMemEtaleTop (j_s.obj W)]
    intro x
    obtain ⟨V, u, hu, y, hy⟩ := (hMemEtaleTop W R).mp hR x
    exact ⟨j_s.obj V, j_s.map u,
      CategoryTheory.Sieve.image_mem_functorPushforward j_s R hu, y, hy⟩
  letI := hc_j

  let pf_s := B_s.sheafPushforwardContinuous AddCommGrpCat.{u} J_X J_S
  let pf_p := B_p.sheafPushforwardContinuous AddCommGrpCat.{u} J_S J_X
  let j_push := j_s.sheafPushforwardContinuous AddCommGrpCat.{u} J_S J_X

  
  let η_site : ∀ W : S.Etale, W ⟶ B_s.obj (j_s.obj W) := fun W =>
    let w_hom := (FgtS.obj W).hom
    CategoryTheory.MorphismProperty.Over.homMk
