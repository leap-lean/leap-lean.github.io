        A ⟶ (C.obj A).obj.obj (Opposite.op T')) =
        CategoryTheory.CategoryStruct.id A ≫ uT' := rfl
    exact h2.trans (hu.symm.trans (congrArg (· ≫ (C.obj A).obj.map α.op) h1.symm))

