                  have h₂ : S_of U x₂ ∈ J U := by
                    have h := hS_mem U x₂; rwa [CategoryTheory.Sieve.generate_sieve] at h
                  exact J.intersection_covering h₁ h₂
                refine ((hSheafOf s.pt).isSheafFor _ hS₁₂).isSeparatedFor.ext ?_
                intro V f ⟨⟨j₁, y₁, hy₁⟩, ⟨j₂, y₂, hy₂⟩⟩
                let j₃ := CategoryTheory.IsFiltered.max j₁ j₂
                let k₁ : j₁ ⟶ j₃ := CategoryTheory.IsFiltered.leftToMax j₁ j₂
                let k₂ : j₂ ⟶ j₃ := CategoryTheory.IsFiltered.rightToMax j₁ j₂
                let y₃ := ((D.map k₁).hom.app (Opposite.op V)).hom y₁ +
                  ((D.map k₂).hom.app (Opposite.op V)).hom y₂
                have hy₃ : ((c.ι.app j₃).hom.app (Opposite.op V)).hom y₃ =
                    (c.pt.obj.map f.op).hom (x₁ + x₂) := by
                  simp only [y₃, map_add]
                  have hc₁ : ((c.ι.app j₃).hom.app (Opposite.op V)).hom
                      (((D.map k₁).hom.app (Opposite.op V)).hom y₁) =
                      ((c.ι.app j₁).hom.app (Opposite.op V)).hom y₁ :=
                    congrArg (fun m => (m.hom.app (Opposite.op V)).hom y₁) (c.w k₁)
                  have hc₂ : ((c.ι.app j₃).hom.app (Opposite.op V)).hom
                      (((D.map k₂).hom.app (Opposite.op V)).hom y₂) =
                      ((c.ι.app j₂).hom.app (Opposite.op V)).hom y₂ :=
                    congrArg (fun m => (m.hom.app (Opposite.op V)).hom y₂) (c.w k₂)
                  rw [hc₁, hc₂, hy₁, hy₂]
                have hlhs := hDescSpec s U V f (x₁ + x₂) j₃ y₃ hy₃
                have hrhs₁ := hDescSpec s U V f x₁ j₁ y₁ hy₁
                have hrhs₂ := hDescSpec s U V f x₂ j₂ y₂ hy₂
                have hs₁ : ((s.ι.app j₃).hom.app (Opposite.op V)).hom
                    (((D.map k₁).hom.app (Opposite.op V)).hom y₁) =
                    ((s.ι.app j₁).hom.app (Opposite.op V)).hom y₁ :=
                  congrArg (fun m => (m.hom.app (Opposite.op V)).hom y₁) (s.w k₁)
                have hs₂ : ((s.ι.app j₃).hom.app (Opposite.op V)).hom
