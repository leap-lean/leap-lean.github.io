        have hw₂_fst : (wPullSec E₀.subtype (ι₁L.comp ψ₁) hψ_0L).left ≫
            CategoryTheory.Limits.pullback.fst W_M₀.hom hL =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι₁L.comp ψ₁)) :=
