    let ℱ₁ := P₁.obj ℱ₀
    let s₁ := pullSec (Subfield.inclusion hle) ψ₁ hψ₁ ℱ₀ s_M₀
    let e_comp : B_L ≅ CategoryTheory.Functor.comp B₁ B₁L :=
