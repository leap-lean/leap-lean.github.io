            (CategoryTheory.Limits.colimit D) ((k + 1) + 1), z = 0 := by
          intro z
          have hz_f : z.comp
              (CategoryTheory.Abelian.Ext.mk₀ ((S_diag D).map CategoryTheory.Limits.colim).f)
              (Nat.add_zero ((k + 1) + 1)) = 0 :=
            @Subsingleton.elim _ hSub_mid _ 0
          obtain ⟨w, hw⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ U₀ hS_inf z hz_f rfl
          have hw0 : w = 0 := @Subsingleton.elim _ hSub_colimK w 0
          rw [← hw, hw0, CategoryTheory.Abelian.Ext.zero_comp]
