        have hw_app : ((I_diag.map u ≫ c_I.ι.app k).hom.app (Opposite.op (W_lvl (q₀ + 1)))).hom y₂ =
            ((c_I.ι.app j₀).hom.app (Opposite.op (W_lvl (q₀ + 1)))).hom y₂ := by
          rw [hw]
        exact hw_app.trans hy₂'
      · rintro ⟨x₁, rfl⟩
        exact CategoryTheory.ConcreteCategory.congr_hom
          ((C_obj c_I.pt).d_comp_d q₀ (q₀ + 1) (q₀ + 2)) x₁
