          have e2 : π_v = 𝟙 _ ≫ π_v := (CategoryTheory.Category.id_comp π_v).symm
          have e3 : 𝟙 _ ≫ π_v = (inv_v ≫ F_s.map v) ≫ π_v :=
            congrArg (· ≫ π_v) h_inv_hom.symm
          have e4 : (inv_v ≫ F_s.map v) ≫ π_v = inv_v ≫ (F_s.map v ≫ π_v) :=
