        Equiv.apply_symm_apply,
        CategoryTheory.Category.assoc, ← hβ]
    have hα_fac : (adj_gπ.homEquiv G_Y G_X').symm α_gπ =
        η_hom G_Y ≫
          (pb_g.map ((adj_π.homEquiv G_Y G_X).symm α_π) ≫
            (adj_g.homEquiv G_X G_X').symm α_g) :=
      hMate_fac α_π α_g α_gπ hα_gπ'
    let adj_cY := CategoryTheory.constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT_Y
    let adj_cX := CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u} hT_X
    let adj_cX' := CategoryTheory.constantSheafAdj X'.smallEtaleTopology AddCommGrpCat.{u} hT_X'
    let τ_π : B_π.obj T_Y ⟶ T_X := hT_X.from (B_π.obj T_Y)
    let τ_g : B_g.obj T_X ⟶ T_X' := hT_X'.from (B_g.obj T_X)
    let τ_gπ : B_gπ.obj T_Y ⟶ T_X' := hT_X'.from (B_gπ.obj T_Y)
    let u_π : Fℤ_Y ⟶ pf_π.obj Fℤ_X :=
      (adj_cY.homEquiv Aℤ (pf_π.obj Fℤ_X)).symm
        (adj_cX.unit.app Aℤ ≫ Fℤ_X.obj.map τ_π.op)
    let u_g : Fℤ_X ⟶ pf_g.obj Fℤ_X' :=
      (adj_cX.homEquiv Aℤ (pf_g.obj Fℤ_X')).symm
        (adj_cX'.unit.app Aℤ ≫ Fℤ_X'.obj.map τ_g.op)
    let u_gπ : Fℤ_Y ⟶ pf_gπ.obj Fℤ_X' :=
      (adj_cY.homEquiv Aℤ (pf_gπ.obj Fℤ_X')).symm
        (adj_cX'.unit.app Aℤ ≫ Fℤ_X'.obj.map τ_gπ.op)
    have hu_gπ : u_gπ = u_π ≫ (pf_π.map u_g ≫ (e_pf' Fℤ_X').inv) := by
      apply (adj_cY.homEquiv Aℤ (pf_gπ.obj Fℤ_X')).injective
      have h_lhs : (adj_cY.homEquiv Aℤ (pf_gπ.obj Fℤ_X')) u_gπ =
          adj_cX'.unit.app Aℤ ≫ Fℤ_X'.obj.map τ_gπ.op :=
        Equiv.apply_symm_apply _ _
      have h_rhs1 : (adj_cY.homEquiv Aℤ (pf_gπ.obj Fℤ_X'))
            (u_π ≫ (pf_π.map u_g ≫ (e_pf' Fℤ_X').inv)) =
          (adj_cY.homEquiv Aℤ (pf_π.obj Fℤ_X)) u_π ≫
            ((CategoryTheory.sheafSections Y.smallEtaleTopology AddCommGrpCat.{u}).obj
              (Opposite.op T_Y)).map (pf_π.map u_g ≫ (e_pf' Fℤ_X').inv) :=
        CategoryTheory.Adjunction.homEquiv_naturality_right adj_cY u_π
          (pf_π.map u_g ≫ (e_pf' Fℤ_X').inv)
      have h_uπ : (adj_cY.homEquiv Aℤ (pf_π.obj Fℤ_X)) u_π =
          adj_cX.unit.app Aℤ ≫ Fℤ_X.obj.map τ_π.op :=
        Equiv.apply_symm_apply _ _
      have h_rhs_map :
          ((CategoryTheory.sheafSections Y.smallEtaleTopology AddCommGrpCat.{u}).obj
            (Opposite.op T_Y)).map (pf_π.map u_g ≫ (e_pf' Fℤ_X').inv) =
          u_g.hom.app (Opposite.op (B_π.obj T_Y)) ≫
            Fℤ_X'.obj.map (e_B.hom.app T_Y).op := by
        change ((pf_π.map u_g ≫ e_pf.inv.app Fℤ_X').hom.app (Opposite.op T_Y)) = _
        rw [CategoryTheory.Functor.sheafPushforwardContinuousIso_inv]
        rfl
      let η_X' : Aℤ ⟶ Fℤ_X'.obj.obj (Opposite.op T_X') := adj_cX'.unit.app Aℤ
      let η_X : Aℤ ⟶ Fℤ_X.obj.obj (Opposite.op T_X) := adj_cX.unit.app Aℤ
      let u_g_TY : Fℤ_X.obj.obj (Opposite.op (B_π.obj T_Y)) ⟶
          Fℤ_X'.obj.obj (Opposite.op (B_g.obj (B_π.obj T_Y))) :=
        u_g.hom.app (Opposite.op (B_π.obj T_Y))
      let u_g_TX : Fℤ_X.obj.obj (Opposite.op T_X) ⟶
          Fℤ_X'.obj.obj (Opposite.op (B_g.obj T_X)) :=
        u_g.hom.app (Opposite.op T_X)
      let e_TY : B_gπ.obj T_Y ⟶ B_g.obj (B_π.obj T_Y) := e_B.hom.app T_Y
      have h_ug_nat : Fℤ_X.obj.map τ_π.op ≫ u_g_TY =
          u_g_TX ≫ Fℤ_X'.obj.map (B_g.map τ_π).op :=
        u_g.hom.naturality τ_π.op
      have h_ug_unit : η_X ≫ u_g_TX = η_X' ≫ Fℤ_X'.obj.map τ_g.op :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_cX Aℤ (pf_g.obj Fℤ_X') u_g).symm.trans
          (Equiv.apply_symm_apply _ _)
      have h_core : η_X' ≫ Fℤ_X'.obj.map τ_gπ.op =
          (η_X ≫ Fℤ_X.obj.map τ_π.op) ≫
            (u_g_TY ≫ Fℤ_X'.obj.map e_TY.op) := by
        rw [CategoryTheory.Category.assoc η_X,
          ← CategoryTheory.Category.assoc (Fℤ_X.obj.map τ_π.op),
          h_ug_nat,
          CategoryTheory.Category.assoc u_g_TX,
          ← CategoryTheory.Category.assoc η_X,
          h_ug_unit,
          CategoryTheory.Category.assoc η_X',
          ← Fℤ_X'.obj.map_comp, ← Fℤ_X'.obj.map_comp]
        congr 2
        apply Quiver.Hom.unop_inj
        exact hT_X'.hom_ext _ _
      exact h_lhs.trans (h_core.trans
        ((congrArg₂ CategoryTheory.CategoryStruct.comp h_uπ.symm h_rhs_map.symm).trans
          h_rhs1.symm))
    let πℤ_g := weilEtaleConstPullbackHom g hT_X' hT_X Aℤ
    let πℤ_π := weilEtaleConstPullbackHom π hT_X hT_Y Aℤ
    let πℤ_gπ := weilEtaleConstPullbackHom (CategoryTheory.CategoryStruct.comp g π) hT_X' hT_Y Aℤ
    have hπℤ_fac : πℤ_gπ = η_hom Fℤ_Y ≫ (pb_g.map πℤ_π ≫ πℤ_g) :=
      hMate_fac u_π u_g u_gπ hu_gπ
    have hιℤ_coh : ιℤ_gπ ≫ η_hom Fℤ_Y = ιℤ_g ≫ pb_g.map ιℤ_π := by
      let a : Fℤ_X' ⟶ pb_g.obj (pb_π.obj Fℤ_Y) := ιℤ_gπ ≫ η_hom Fℤ_Y
      have h1 : (a ≫ pb_g.map πℤ_π) ≫ πℤ_g = 𝟙 Fℤ_X' := by
        dsimp [a]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← hπℤ_fac]
        exact hιgπ1
      have h2 : a ≫ pb_g.map πℤ_π = ιℤ_g := by
        calc
          a ≫ pb_g.map πℤ_π
            = (a ≫ pb_g.map πℤ_π) ≫ 𝟙 (pb_g.obj Fℤ_X) :=
                (CategoryTheory.Category.comp_id _).symm
          _ = (a ≫ pb_g.map πℤ_π) ≫ (πℤ_g ≫ ιℤ_g) :=
                congrArg (fun k => (a ≫ pb_g.map πℤ_π) ≫ k) hιg2.symm
          _ = ((a ≫ pb_g.map πℤ_π) ≫ πℤ_g) ≫ ιℤ_g :=
                (CategoryTheory.Category.assoc _ _ _).symm
          _ = ιℤ_g := by rw [h1, CategoryTheory.Category.id_comp]
      calc
        a = a ≫ 𝟙 (pb_g.obj (pb_π.obj Fℤ_Y)) :=
              (CategoryTheory.Category.comp_id _).symm
        _ = a ≫ pb_g.map (πℤ_π ≫ ιℤ_π) := by rw [hιπ2, pb_g.map_id]
        _ = (a ≫ pb_g.map πℤ_π) ≫ pb_g.map ιℤ_π := by
              rw [pb_g.map_comp]
              exact (CategoryTheory.Category.assoc _ _ _).symm
        _ = ιℤ_g ≫ pb_g.map ιℤ_π := by rw [h2]

    
    have hMapExact_pb :=
      hMapExact_comp_iso pb_π pb_g pb_gπ η_hom η_inv hη_hom_inv hη_inv_hom hη_nat z
    let α_π_adj := (adj_π.homEquiv G_Y G_X).symm α_π
    let α_g_adj := (adj_g.homEquiv G_X G_X').symm α_g
    change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_gπ).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_gπ z) (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ ((adj_gπ.homEquiv G_Y G_X').symm α_gπ))
        (Nat.add_zero q) =
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_g).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_g
          (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_π).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor pb_π z) (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ α_π_adj) (Nat.add_zero q)))
        (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ α_g_adj) (Nat.add_zero q)
    rw [hMapExact_pb,
      hα_fac,
      ← CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_gπ)
        (CategoryTheory.Abelian.Ext.mk₀ (η_hom Fℤ_Y)) _
        (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hιℤ_coh,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ (ιℤ_g ≫ pb_g.map ιℤ_π)) _ _,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_g
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_π z))
        (CategoryTheory.Abelian.Ext.mk₀ (η_inv G_Y)) _,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Category.assoc (η_inv G_Y),
      hη_inv_hom G_Y, CategoryTheory.Category.id_comp,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ ιℤ_g (pb_g.map ιℤ_π),
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (pb_g.map α_π_adj) α_g_adj,
      CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_g)
        (CategoryTheory.Abelian.Ext.mk₀ (pb_g.map ιℤ_π)) _
        (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q),
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_g
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_π z))
        (CategoryTheory.Abelian.Ext.mk₀ (pb_g.map α_π_adj))
        (CategoryTheory.Abelian.Ext.mk₀ α_g_adj) (Nat.add_zero q),
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ (pb_g.map ιℤ_π)) _
        (CategoryTheory.Abelian.Ext.mk₀ α_g_adj) (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_g) _
        (CategoryTheory.Abelian.Ext.mk₀ α_g_adj) (Nat.zero_add q)]
    congr 2
    rw [← CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ pb_g ιℤ_π,
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ pb_g α_π_adj,
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]

theorem weil_affine_proper_image_compactification (k : Type u) [Field k]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Z.hom]
    (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
    (u : Quiver.Hom W Z.left)
    [AlgebraicGeometry.LocallyOfFiniteType (CategoryTheory.CategoryStruct.comp u Z.hom)] :
    ∃ (W_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (π : Quiver.Hom W_bar.left Z.left)
      (j : Quiver.Hom W W_bar.left),
      AlgebraicGeometry.IsProper W_bar.hom ∧
      CategoryTheory.CategoryStruct.comp π Z.hom = W_bar.hom ∧
      AlgebraicGeometry.IsOpenImmersion j ∧
      CategoryTheory.CategoryStruct.comp j π = u :=
by
  classical
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let f_W : W ⟶ S_k := CategoryTheory.CategoryStruct.comp u Z.hom
  let R : CommRingCat.{u} := W.presheaf.obj (Opposite.op ⊤)
  let e_W : W ≅ AlgebraicGeometry.Spec R := W.isoSpec
  let φ_k : CommRingCat.of k ⟶ R := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ f_W)
  have hmap_φ : AlgebraicGeometry.Spec.map φ_k = e_W.inv ≫ f_W :=
    AlgebraicGeometry.Spec.map_preimage (e_W.inv ≫ f_W)
  have heW_φ : e_W.hom ≫ AlgebraicGeometry.Spec.map φ_k = f_W := by
    rw [hmap_φ, ← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
      CategoryTheory.Category.id_comp]
  have hLFT_map : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map φ_k) := by
    rw [hmap_φ]
    infer_instance
  have hFT_hom : RingHom.FiniteType φ_k.hom :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_map
  let _ : Algebra k ↑R := φ_k.hom.toAlgebra
  have hFT_alg : Algebra.FiniteType k ↑R := hFT_hom
  obtain ⟨N, q_alg, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
  let q : MvPolynomial (Fin N) k →+* ↑R := q_alg.toRingHom
  have hq_comm : ∀ c : k, q (MvPolynomial.C c) = φ_k.hom c := fun c => q_alg.commutes c

  let P_ring := MvPolynomial (Fin (N + 1)) k
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let P : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
  let α₀ : k →+* ↥(𝒜 0) := algebraMap k ↥(𝒜 0)
  have hα₀_coe : ∀ c : k, ((α₀ c : ↥(𝒜 0)) : P_ring) = MvPolynomial.C c :=
    fun c => SetLike.GradeZero.coe_algebraMap 𝒜 c
  have hα₀_inj : Function.Injective α₀ := by
    intro c₁ c₂ h
    have hC : (MvPolynomial.C c₁ : P_ring) = MvPolynomial.C c₂ := by
      rw [← hα₀_coe c₁, ← hα₀_coe c₂, h]
    simpa using congrArg MvPolynomial.constantCoeff hC
  have hα₀_surj : Function.Surjective α₀ := by
    intro x
    have hx : (x : P_ring) ∈ (1 : Submodule k P_ring) := by
      rw [← MvPolynomial.homogeneousSubmodule_zero (Fin (N + 1))]
      exact x.2
    obtain ⟨c, hc⟩ := Submodule.mem_one.mp hx
    refine ⟨c, Subtype.ext ?_⟩
    exact (hα₀_coe c).trans hc
  let e₀_ring : k ≃+* ↥(𝒜 0) := RingEquiv.ofBijective α₀ ⟨hα₀_inj, hα₀_surj⟩
  let c₀ : CommRingCat.of k ⟶ CommRingCat.of ↥(𝒜 0) := CommRingCat.ofHom α₀
  let c₀_inv : CommRingCat.of ↥(𝒜 0) ⟶ CommRingCat.of k :=
    CommRingCat.ofHom e₀_ring.symm.toRingHom
  have hc₀_1 : c₀ ≫ c₀_inv = 𝟙 _ :=
    CommRingCat.hom_ext (RingHom.ext fun x => e₀_ring.symm_apply_apply x)
  have hc₀_2 : c₀_inv ≫ c₀ = 𝟙 _ :=
    CommRingCat.hom_ext (RingHom.ext fun x => e₀_ring.apply_symm_apply x)
  have : CategoryTheory.IsIso c₀ := ⟨⟨c₀_inv, hc₀_1, hc₀_2⟩⟩
  have : IsScalarTower k ↥(𝒜 0) P_ring :=
    ⟨fun c y z => by
      rw [Algebra.smul_def (c • y) z, Algebra.smul_def y z,
        SetLike.GradeZero.algebraMap_apply, SetLike.GradeZero.algebraMap_apply]
      exact smul_mul_assoc c (y : P_ring) z⟩
  have : Algebra.FiniteType ↥(𝒜 0) P_ring :=
    Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) P_ring
  let p_P : P ⟶ S_k := AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫ AlgebraicGeometry.Spec.map c₀
  have : AlgebraicGeometry.IsProper p_P := inferInstance

  let X₀ : P_ring := MvPolynomial.X (0 : Fin (N + 1))
  have hX₀ : X₀ ∈ 𝒜 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 X₀).mpr (MvPolynomial.isHomogeneous_X k 0)
  let M : Submonoid P_ring := Submonoid.powers X₀
  let ev : P_ring →+* ↑R :=
    MvPolynomial.eval₂Hom φ_k.hom (Fin.cases (1 : ↑R) (fun i : Fin N => q (MvPolynomial.X i)))
  have hev_X₀ : ev X₀ = 1 := by
    dsimp [ev, X₀]
    rw [MvPolynomial.eval₂Hom_X']
    rfl
  have h_unit : ∀ y : M, IsUnit (ev y.1) := by
    intro y
    obtain ⟨n, hn⟩ := y.2
    have hy1 : ev y.1 = 1 := by
      rw [← hn, map_pow, hev_X₀, one_pow]
    rw [hy1]
    exact isUnit_one
  let ev_loc : Localization M →+* ↑R := IsLocalization.lift h_unit
  let θ : HomogeneousLocalization.Away 𝒜 X₀ →+* ↑R :=
    ev_loc.comp (algebraMap (HomogeneousLocalization.Away 𝒜 X₀) (Localization M))
  have hθ_zero : ∀ c : k,
      θ (HomogeneousLocalization.fromZeroRingHom 𝒜 M (α₀ c)) = φ_k.hom c := by
    intro c
    change ev_loc ((algebraMap (HomogeneousLocalization.Away 𝒜 X₀) (Localization M))
      (HomogeneousLocalization.fromZeroRingHom 𝒜 M (α₀ c))) = φ_k.hom c
    have hval : (algebraMap (HomogeneousLocalization.Away 𝒜 X₀) (Localization M))
        (HomogeneousLocalization.fromZeroRingHom 𝒜 M (α₀ c)) =
        algebraMap P_ring (Localization M) (MvPolynomial.C c) := by
      rw [HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_eq]
      change (HomogeneousLocalization.mk _).val = _
      rw [HomogeneousLocalization.val_mk]
      change Localization.mk ((α₀ c : ↥(𝒜 0)) : P_ring) 1 = _
      rw [Localization.mk_one_eq_algebraMap, hα₀_coe c]
    rw [hval, IsLocalization.lift_eq h_unit (MvPolynomial.C c)]
    exact MvPolynomial.eval₂Hom_C φ_k.hom _ c

  have hX_succ : ∀ i : Fin N, (MvPolynomial.X i.succ : P_ring) ∈ 𝒜 (1 • 1) := by
    intro i
    rw [one_smul]
    exact (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k i.succ)
  let σ : MvPolynomial (Fin N) k →+* HomogeneousLocalization.Away 𝒜 X₀ :=
    MvPolynomial.eval₂Hom
      ((HomogeneousLocalization.fromZeroRingHom 𝒜 M).comp α₀)
      (fun i : Fin N =>
        HomogeneousLocalization.Away.mk 𝒜 hX₀ 1 (MvPolynomial.X i.succ) (hX_succ i))
  have hθσ : θ.comp σ = q := by
    apply MvPolynomial.ringHom_ext'
    · ext c
      simp only [σ, RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
      exact (hθ_zero c).trans (hq_comm c).symm
    · intro i
      change θ (σ (MvPolynomial.X i)) = q (MvPolynomial.X i)
      rw [MvPolynomial.eval₂Hom_X']
      change ev_loc ((algebraMap (HomogeneousLocalization.Away 𝒜 X₀) (Localization M))
        (HomogeneousLocalization.Away.mk 𝒜 hX₀ 1 (MvPolynomial.X i.succ) (hX_succ i))) =
        q (MvPolynomial.X i)
      rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk']
      refine (IsLocalization.lift_mk'_spec h_unit
        (MvPolynomial.X i.succ) (q (MvPolynomial.X i))
        ⟨X₀ ^ 1, pow_mem (Submonoid.mem_powers X₀) 1⟩).mpr ?_
      have hev_Xi : ev (MvPolynomial.X i.succ) = q (MvPolynomial.X i) := by
        dsimp [ev]
        rw [MvPolynomial.eval₂Hom_X', Fin.cases_succ]
      have hev_X01 : ev (X₀ ^ 1) = 1 := by
        rw [pow_one, hev_X₀]
      change ev (MvPolynomial.X i.succ) = ev (X₀ ^ 1) * q (MvPolynomial.X i)
      rw [hev_Xi, hev_X01, one_mul]
  have hθ_surj : Function.Surjective θ := by
    intro r
    obtain ⟨p, rfl⟩ := hq_surj r
    exact ⟨σ p, DFunLike.congr_fun hθσ p⟩

  let i_closed : AlgebraicGeometry.Spec R ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 X₀)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ)
  have : AlgebraicGeometry.IsClosedImmersion i_closed :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom θ) hθ_surj
  let ι_open : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 X₀)) ⟶ P :=
    AlgebraicGeometry.Proj.awayι 𝒜 X₀ hX₀ Nat.zero_lt_one
  let i_W : W ⟶ P := e_W.hom ≫ i_closed ≫ ι_open
  have : AlgebraicGeometry.IsImmersion i_W := inferInstance
  have hring_φ : (c₀ ≫ CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜 M)) ≫
      CommRingCat.ofHom θ = φ_k :=
    CommRingCat.hom_ext (RingHom.ext fun c => hθ_zero c)
  have hiW_pP : i_W ≫ p_P = f_W := by
    dsimp [i_W, i_closed, ι_open, p_P]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      hring_φ, heW_φ]

  let Q : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback Z.hom p_P
  let p_Z : Q ⟶ Z.left := CategoryTheory.Limits.pullback.fst Z.hom p_P
  let p_aux : Q ⟶ P := CategoryTheory.Limits.pullback.snd Z.hom p_P
  have : AlgebraicGeometry.IsProper p_Z := inferInstance
  have : AlgebraicGeometry.IsProper (p_Z ≫ Z.hom) := inferInstance
  have : QuasiSeparatedSpace ↥Q :=
    (AlgebraicGeometry.quasiSeparated_iff_quasiSeparatedSpace (p_Z ≫ Z.hom)).mp inferInstance
  let γ : W ⟶ Q := CategoryTheory.Limits.pullback.lift u i_W hiW_pP.symm
  have hγ_Z : γ ≫ p_Z = u := CategoryTheory.Limits.pullback.lift_fst u i_W hiW_pP.symm
  have hγ_aux : γ ≫ p_aux = i_W := CategoryTheory.Limits.pullback.lift_snd u i_W hiW_pP.symm
  have hImm_comp : AlgebraicGeometry.IsImmersion (γ ≫ p_aux) := by
    rw [hγ_aux]
    infer_instance
  have : AlgebraicGeometry.IsImmersion γ :=
    @AlgebraicGeometry.IsImmersion.of_comp _ _ _ γ p_aux hImm_comp
  have : AlgebraicGeometry.QuasiCompact γ := inferInstance
  have : AlgebraicGeometry.IsOpenImmersion γ.toImage := inferInstance
  let j : W ⟶ γ.image := γ.toImage
  let π : γ.image ⟶ Z.left := γ.imageι ≫ p_Z
  let W_bar : CategoryTheory.Over S_k := CategoryTheory.Over.mk (π ≫ Z.hom)
  refine ⟨W_bar, π, j, ?_, rfl, inferInstance, ?_⟩
  · dsimp [W_bar, π]
    infer_instance
  · dsimp [j, π]
    rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι, hγ_Z]

theorem weil_etale_pinned_compact_support_roof_transfer (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar k) :
    ∃ Ψ : WeilRoofTransferSystem k ℓ, WeilIsPinnedRoofTransfer k ℓ Ψ :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne : (ℓ : k) ≠ 0 := by
    intro h0
    have hdvd : ringChar k ∣ ℓ := (CharP.cast_eq_zero_iff k (ringChar k) ℓ).mp h0
    rcases CharP.char_is_prime_or_zero k (ringChar k) with hp | hz
    · rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | heq
      · exact hp.ne_one h1
      · exact hℓ heq.symm
    · rw [hz, zero_dvd_iff] at hdvd
      exact hPrime.ne_zero hdvd
  have hPBC : WeilProperModPrimeBaseChangeHolds k ℓ :=
    weil_etale_proper_base_change_mod_prime k ℓ hℓ_ne
  obtain ⟨hc_all, hr_all, hSiteExact, hConstIndep, hConstIso, hFreePull,
    hZeroStalk, hIsoStalk, hClopenPkg, hCompAlpha, hCovAlpha⟩ :=
    weil_etale_pinned_clopen_section_and_stalk_criteria.{u}
  have : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂),
      (weilEtaleSitePullback f).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology :=
    @hc_all
  have : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint :=
    @hr_all
  have : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂),
      ((weilEtaleSitePullback f).sheafPullback AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology).Additive :=
    fun f => (hSiteExact f).1
  have : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂),
      CategoryTheory.Limits.PreservesFiniteLimits
        ((weilEtaleSitePullback f).sheafPullback AddCommGrpCat.{u}
          S₂.smallEtaleTopology S₁.smallEtaleTopology) :=
    fun f => (hSiteExact f).2.2.1
  have : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂),
      CategoryTheory.Limits.PreservesFiniteColimits
        ((weilEtaleSitePullback f).sheafPullback AddCommGrpCat.{u}
          S₂.smallEtaleTopology S₁.smallEtaleTopology) :=
    fun f => (hSiteExact f).2.2.2
  obtain ⟨hR0Iso, hBockstein, hLerayPkg, hPullComp⟩ :=
    weil_etale_bockstein_and_degenerate_leray_ext_calculus.{u}

  
  have hTor_ℓ : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale),
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S ℓ U) = 0 := by
    intro S U
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    let P := CategoryTheory.Presheaf.freeYoneda U AM
    let L := (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj P
    let adj := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
    have hAM_tor : ℓ • CategoryTheory.CategoryStruct.id AM = 0 := by
      ext ⟨x⟩
      apply ULift.ext
      change ℓ • x = 0
      rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
    have hEval : ∀ (g : L ⟶ L),
        CategoryTheory.Sheaf.freeYonedaHomEquiv g =
          CategoryTheory.Presheaf.freeYonedaHomEquiv (𝟙 P) ≫
            ((adj.homEquiv P L) g).app (Opposite.op U) := by
      intro g
      let η : P ⟶ (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj L :=
        (adj.homEquiv P L) g
      change CategoryTheory.Presheaf.freeYonedaHomEquiv η =
        CategoryTheory.Presheaf.freeYonedaHomEquiv (𝟙 P) ≫ η.app (Opposite.op U)
      rw [← CategoryTheory.Presheaf.freeYonedaHomEquiv_comp (𝟙 P) η, CategoryTheory.Category.id_comp]
    change ℓ • CategoryTheory.CategoryStruct.id L = 0
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    rw [hEval (ℓ • 𝟙 L), hEval 0]
    have hHom_nsmul : ((adj.homEquiv P L) (ℓ • 𝟙 L)).app (Opposite.op U) =
        ℓ • ((adj.unit.app P).app (Opposite.op U)) := by
      have hUnit : (adj.homEquiv P L) (ℓ • 𝟙 L) =
          adj.unit.app P ≫
            (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).map (ℓ • 𝟙 L) :=
        CategoryTheory.Adjunction.homEquiv_unit adj P L (ℓ • 𝟙 L)
      have hMap : (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).map
          (ℓ • 𝟙 L) = ℓ • 𝟙 ((CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj L) := by
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      rw [hUnit, hMap, CategoryTheory.NatTrans.comp_app]
      change (adj.unit.app P).app (Opposite.op U) ≫ (ℓ • 𝟙 _) = _
      rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
    have hHom_zero : ((adj.homEquiv P L) 0).app (Opposite.op U) = 0 := by
      have hUnit : (adj.homEquiv P L) 0 =
          adj.unit.app P ≫
            (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).map (0 : L ⟶ L) :=
        CategoryTheory.Adjunction.homEquiv_unit adj P L 0
      rw [hUnit, CategoryTheory.Functor.map_zero, CategoryTheory.Limits.comp_zero]
      rfl
    rw [hHom_nsmul, hHom_zero, CategoryTheory.Preadditive.comp_nsmul,
      CategoryTheory.Limits.comp_zero]
    calc
      ℓ • (CategoryTheory.Presheaf.freeYonedaHomEquiv (𝟙 P) ≫ (adj.unit.app P).app (Opposite.op U))
        = (ℓ • 𝟙 AM) ≫
            (CategoryTheory.Presheaf.freeYonedaHomEquiv (𝟙 P) ≫
              (adj.unit.app P).app (Opposite.op U)) := by
          rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp]
      _ = 0 := by
          rw [hAM_tor, CategoryTheory.Limits.zero_comp]

  
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let πℤ_std : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom X Y),
      Quiver.Hom
        (((weilEtaleSitePullback π).sheafPullback AddCommGrpCat.{u}
          Y.smallEtaleTopology X.smallEtaleTopology).obj
          ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ))
        ((CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ) :=
    fun {X Y} π =>
      weilEtaleConstPullbackHom π
        (weilEtaleIdTerminalIsTerminal X) (weilEtaleIdTerminalIsTerminal Y) Aℤ
  let ιℤ_std : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom X Y),
      Quiver.Hom
        ((CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
        (((weilEtaleSitePullback π).sheafPullback AddCommGrpCat.{u}
          Y.smallEtaleTopology X.smallEtaleTopology).obj
          ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)) :=
    fun {X Y} π =>
      @CategoryTheory.inv _ _ _ _ (πℤ_std π)
        (hConstIso π (weilEtaleIdTerminalIsTerminal X) (weilEtaleIdTerminalIsTerminal Y) Aℤ)
  have hιℤ_std_comp : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom X Y),
      CategoryTheory.CategoryStruct.comp (ιℤ_std π) (πℤ_std π) = CategoryTheory.CategoryStruct.id _ ∧
      CategoryTheory.CategoryStruct.comp (πℤ_std π) (ιℤ_std π) = CategoryTheory.CategoryStruct.id _ := by
    intro X Y π
    have := hConstIso π (weilEtaleIdTerminalIsTerminal X) (weilEtaleIdTerminalIsTerminal Y) Aℤ
    exact ⟨CategoryTheory.IsIso.inv_hom_id (πℤ_std π), CategoryTheory.IsIso.hom_inv_id (πℤ_std π)⟩
  let pullH_std : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom X Y)
      {G_Y : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
      {G_X : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}},
      Quiver.Hom G_Y
        (((weilEtaleSitePullback π).sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology X.smallEtaleTopology).obj G_X) →
      ∀ (q : ℕ), G_Y.H q →+ G_X.H q :=
    fun {X Y} π {G_Y G_X} α q =>
      let B_π := weilEtaleSitePullback π
      let pb_π := B_π.sheafPullback AddCommGrpCat.{u} Y.smallEtaleTopology X.smallEtaleTopology
      let adj_π := B_π.sheafAdjunctionContinuous AddCommGrpCat.{u}
        Y.smallEtaleTopology X.smallEtaleTopology
      let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      ((CategoryTheory.Abelian.Ext.mk₀ ((adj_π.homEquiv G_Y G_X).symm α)).postcomp
        Fℤ_X (Nat.add_zero q)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ (ιℤ_std π)).precomp (pb_π.obj G_Y)
          (Nat.zero_add q)).comp
          (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_π _ _ _ _ _ Fℤ_Y G_Y q))

  
  have hSingleBij : ∀ (W_bar Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (π : Quiver.Hom W_bar.left Y.left)
      [AlgebraicGeometry.IsProper W_bar.hom] [AlgebraicGeometry.IsProper Y.hom]
      (U_W : W_bar.left.Etale) (U_Y : Y.left.Etale)
      [AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).left]
      (e : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U_Y).left),
      CategoryTheory.CategoryStruct.comp π Y.hom = W_bar.hom →
      CategoryTheory.CategoryStruct.comp
          (((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).hom) π =
        CategoryTheory.CategoryStruct.comp e.hom
          (((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U_Y).hom) →
      ∀ [AlgebraicGeometry.IsProper π]
        (α_sys : ∀ m : ℕ, Quiver.Hom (weilEtaleLocalTorsionSheaf Y.left m U_Y)
          (((weilEtaleSitePullback π).sheafPushforwardContinuous AddCommGrpCat.{u}
            Y.left.smallEtaleTopology W_bar.left.smallEtaleTopology).obj
            (weilEtaleLocalTorsionSheaf W_bar.left m U_W)))
        (σ_e : Quiver.Hom U_W ((weilEtaleSitePullback π).obj U_Y)),
        CategoryTheory.CategoryStruct.comp
          (((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).map σ_e).left)
          (CategoryTheory.Limits.pullback.fst
            (((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U_Y).hom) π) = e.hom →
        (∀ m : ℕ,
          let L_W := weilEtaleLocalTorsionSheaf W_bar.left m U_W
          let ξ := CategoryTheory.Sheaf.freeYonedaHomEquiv (α_sys m)
          CategoryTheory.CategoryStruct.comp ξ (L_W.obj.map (Opposite.op σ_e)) =
            CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_W) ∧
          (∀ (V : W_bar.left.Etale) (w : Quiver.Hom V ((weilEtaleSitePullback π).obj U_Y)),
            Disjoint
              (Set.range (((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).map w).left).base)
              (Set.range (((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).map σ_e).left).base) →
            CategoryTheory.CategoryStruct.comp ξ (L_W.obj.map (Opposite.op w)) = 0)) →
        ∀ (r q : ℕ), Function.Bijective (pullH_std π (α_sys (ℓ ^ r)) q) := by
    intro W_bar Y π _ _ U_W U_Y _ e hπ_hom hU_comm _ α_sys σ_e hσ_e hα_char
    let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget W_bar.left
    let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget Y.left
    have hAff_UY_left : AlgebraicGeometry.IsAffine (Fgt_Y.obj U_Y).left :=
      AlgebraicGeometry.IsAffine.of_isIso e.inv
    have hAff_comp : AlgebraicGeometry.IsAffineHom
        (CategoryTheory.CategoryStruct.comp (Fgt_Y.obj U_Y).hom Y.hom) :=
      AlgebraicGeometry.isAffineHom_of_isAffine _
    have hAffHom_UY : AlgebraicGeometry.IsAffineHom (Fgt_Y.obj U_Y).hom :=
      AlgebraicGeometry.IsAffineHom.of_comp (Fgt_Y.obj U_Y).hom Y.hom
    obtain ⟨σ_std, α_std, hσ_std, hσ_uniq, hα_std_char, hStalkInj, hCoeffNat⟩ :=
      hClopenPkg π U_W U_Y e hU_comm
    have hσ_eq : σ_e = σ_std := hσ_uniq σ_e hσ_e
    subst hσ_eq
    have hα_eq : ∀ m : ℕ, α_sys m = α_std m :=
      fun m => (hα_std_char m).2.2 (α_sys m) (hα_char m).1 (hα_char m).2
    have hFiberData : ∀ (y : ↥Y.left),
        let κ := Y.left.residueField y
        let Ω := AlgebraicClosure ↥κ
        let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
        let bar_y : Quiver.Hom S_Ω Y.left :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
            (Y.left.fromSpecResidueField y)
        let pb_y := (weilEtaleSitePullback bar_y).sheafPullback AddCommGrpCat.{u}
          Y.left.smallEtaleTopology S_Ω.smallEtaleTopology
        let pf_π := (weilEtaleSitePullback π).sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.left.smallEtaleTopology W_bar.left.smallEtaleTopology
        let T_Ω := weilEtaleIdTerminal S_Ω
        (∀ (q : ℕ), 1 ≤ q →
          Subsingleton ↥((pb_y.obj
            (weilEtaleHigherDirectImage π q
              (weilEtaleLocalTorsionSheaf W_bar.left ℓ U_W))).obj.obj (Opposite.op T_Ω))) ∧
        Function.Bijective
          ((pb_y.map (α_std ℓ)).hom.app (Opposite.op T_Ω)) := by
      intro y
      let κ := Y.left.residueField y
      let Ω := AlgebraicClosure ↥κ
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let bar_y : Quiver.Hom S_Ω Y.left :=
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
          (Y.left.fromSpecResidueField y)
      let pb_y := (weilEtaleSitePullback bar_y).sheafPullback AddCommGrpCat.{u}
        Y.left.smallEtaleTopology S_Ω.smallEtaleTopology
      let pf_π := (weilEtaleSitePullback π).sheafPushforwardContinuous AddCommGrpCat.{u}
        Y.left.smallEtaleTopology W_bar.left.smallEtaleTopology
      let T_Ω := weilEtaleIdTerminal S_Ω
      let W_ybar := CategoryTheory.Limits.pullback π bar_y
      let g'_sch : Quiver.Hom W_ybar W_bar.left := CategoryTheory.Limits.pullback.fst π bar_y
      let π_ybar : Quiver.Hom W_ybar S_Ω := CategoryTheory.Limits.pullback.snd π bar_y
      let S'_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (CategoryTheory.CategoryStruct.comp bar_y Y.hom)
      let X'_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (CategoryTheory.CategoryStruct.comp g'_sch W_bar.hom)
      let f_ov : W_bar ⟶ Y := CategoryTheory.Over.homMk π hπ_hom
      let g_ov : S'_ov ⟶ Y := CategoryTheory.Over.homMk bar_y rfl
      let g'_ov : X'_ov ⟶ W_bar := CategoryTheory.Over.homMk g'_sch rfl
      let f'_ov : X'_ov ⟶ S'_ov := CategoryTheory.Over.homMk π_ybar (by
        change π_ybar ≫ (bar_y ≫ Y.hom) = g'_sch ≫ W_bar.hom
        rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition,
          CategoryTheory.Category.assoc, hπ_hom])
      let U₀ : W_ybar.Etale := (weilEtaleSitePullback g'_sch).obj U_W
      let V₀ : S_Ω.Etale := (weilEtaleSitePullback bar_y).obj U_Y
      have hPb_L : WeilIsEtaleSheafPullback g'_sch
          (weilEtaleLocalTorsionSheaf W_bar.left ℓ U_W)
          (weilEtaleLocalTorsionSheaf W_ybar ℓ U₀) :=
        ⟨hc_all g'_sch, hr_all g'_sch, hFreePull g'_sch ℓ U_W⟩
      have hPBC_all : ∀ q : ℕ,
          Nonempty (CategoryTheory.Iso
            (pb_y.obj (weilEtaleHigherDirectImage π q
              (weilEtaleLocalTorsionSheaf W_bar.left ℓ U_W)))
            (weilEtaleHigherDirectImage π_ybar q
              (weilEtaleLocalTorsionSheaf W_ybar ℓ U₀))) := by
        intro q
        obtain ⟨hc', hr', ⟨iso_q⟩⟩ :=
          hPBC W_bar Y S'_ov X'_ov f_ov g_ov f'_ov g'_ov ‹AlgebraicGeometry.IsProper π›
            (CategoryTheory.IsPullback.of_hasPullback π bar_y)
            (weilEtaleLocalTorsionSheaf W_bar.left ℓ U_W)
            (weilEtaleLocalTorsionSheaf W_ybar ℓ U₀)
            (hTor_ℓ W_bar.left U_W) hPb_L q
        cases Subsingleton.elim hc' (hc_all bar_y)
        cases Subsingleton.elim hr' (hr_all bar_y)
        exact ⟨iso_q⟩
      have hAffHom_V₀ : AlgebraicGeometry.IsAffineHom
          (CategoryTheory.Limits.pullback.snd (Fgt_Y.obj U_Y).hom bar_y) := inferInstance
      have hAff_V₀ : AlgebraicGeometry.IsAffine
          ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).obj V₀).left := by
        change AlgebraicGeometry.IsAffine (CategoryTheory.Limits.pullback (Fgt_Y.obj U_Y).hom bar_y)
        exact AlgebraicGeometry.isAffine_of_isAffineHom
          (CategoryTheory.Limits.pullback.snd (Fgt_Y.obj U_Y).hom bar_y)
      let uW_hom := (Fgt_W.obj U_W).hom
      let uY_hom := (Fgt_Y.obj U_Y).hom
      have hu_comm' : uW_hom ≫ π = e.hom ≫ uY_hom := hU_comm
      have he₀_hom_cond :
          (CategoryTheory.Limits.pullback.fst uW_hom g'_sch ≫ e.hom) ≫ uY_hom =
            (CategoryTheory.Limits.pullback.snd uW_hom g'_sch ≫ π_ybar) ≫ bar_y := by
        rw [CategoryTheory.Category.assoc, ← hu_comm', ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc]
      let e₀_hom : CategoryTheory.Limits.pullback uW_hom g'_sch ⟶
          CategoryTheory.Limits.pullback uY_hom bar_y :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst uW_hom g'_sch ≫ e.hom)
          (CategoryTheory.Limits.pullback.snd uW_hom g'_sch ≫ π_ybar)
          he₀_hom_cond
      have he₀_snd_cond :
          (CategoryTheory.Limits.pullback.fst uY_hom bar_y ≫ e.inv ≫ uW_hom) ≫ π =
            CategoryTheory.Limits.pullback.snd uY_hom bar_y ≫ bar_y :=
