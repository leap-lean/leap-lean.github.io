        _ = (i ≫ f₂) ≫ Limits.cokernel.π (Subobject.mk (Limits.image.ι f₂)).arrow := by
            rw [hu₁]
        _ = i ≫ (Limits.factorThruImage f₂ ≫
              (Subobject.underlyingIso (Limits.image.ι f₂)).inv ≫
