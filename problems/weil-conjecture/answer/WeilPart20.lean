          let x₁' : ↥(G₁.obj.obj (Opposite.op (j_s.obj (B_s.obj Y)))) := x₁
          refine (hSheafCD G₂ Y).1 _ _ ?_ ?_
          · exact (hglue0_c G₂ Y _).trans
              ((congrArg ((φ.hom.app (Opposite.op (j_s.obj (B_s.obj Y)))).hom)
