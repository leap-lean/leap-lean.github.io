    let pr₁ : Quiver.Hom (CategoryTheory.Limits.pullback u_hom π) U.left :=
      CategoryTheory.Limits.pullback.fst u_hom π
    let pr₂ : Quiver.Hom (CategoryTheory.Limits.pullback u_hom π) S₁ :=
      CategoryTheory.Limits.pullback.snd u_hom π
    obtain ⟨(Y : S_K.Etale), (f : Y ⟶ U), w, hfR, _, hfw⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology U R).mp hR (pr₁ x)
    let y_hom : Quiver.Hom Y.left S_K := Y.hom
    let f_left : Quiver.Hom Y.left U.left := f.left
    have hfw' : f_left w = pr₁ x := hfw
    obtain ⟨z, _, hz₂⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w x hfw'
    have hψ_comm : CategoryTheory.Limits.pullback.fst f_left pr₁ ≫ y_hom =
        (CategoryTheory.Limits.pullback.snd f_left pr₁ ≫ pr₂) ≫ π := by
      have hYw : f_left ≫ u_hom = y_hom := CategoryTheory.MorphismProperty.Over.w f
      rw [← hYw, ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc]
    let ψ : CategoryTheory.Limits.pullback f_left pr₁ ⟶ CategoryTheory.Limits.pullback y_hom π :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst f_left pr₁)
        (CategoryTheory.Limits.pullback.snd f_left pr₁ ≫ pr₂) hψ_comm
    let bf_left : CategoryTheory.Limits.pullback y_hom π ⟶
        CategoryTheory.Limits.pullback u_hom π := (B₁.map f).left
    have hψ_comp : ψ ≫ bf_left = CategoryTheory.Limits.pullback.snd f_left pr₁ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · have hmap_fst : bf_left ≫ pr₁ =
            CategoryTheory.Limits.pullback.fst y_hom π ≫ f_left :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        rw [CategoryTheory.Category.assoc, hmap_fst, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.condition]
      · have hmap_snd : bf_left ≫ pr₂ =
            CategoryTheory.Limits.pullback.snd y_hom π :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        rw [CategoryTheory.Category.assoc, hmap_snd, CategoryTheory.Limits.pullback.lift_snd]
    have hEtBf : AlgebraicGeometry.Etale (B₁.map f).left :=
      CategoryTheory.MorphismProperty.of_postcomp
        (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
        (f := (B₁.map f).left) (B₁.obj U).hom (B₁.obj U).prop
        (by rw [CategoryTheory.MorphismProperty.Over.w (B₁.map f)]; exact (B₁.obj Y).prop)
    have h_pt : bf_left (ψ z) = x := by
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply ψ bf_left z, hψ_comp]
      exact hz₂
    exact ⟨B₁.obj Y, B₁.map f, ψ z,
      CategoryTheory.Sieve.image_mem_functorPushforward B₁ R hfR, hEtBf, h_pt⟩
  have hContB : B₁.IsContinuous J_K J₁ :=
    CategoryTheory.Functor.isContinuous_of_coverPreserving hCompatB hCovB

  have hCompatF : CategoryTheory.CompatiblePreserving J_K F₁ := by
    refine CategoryTheory.CompatiblePreserving.mk ?_
    intro 𝒢 Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
    have h_left : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
      congrArg (fun m : X ⟶ F₁.obj Z => m.left) hfg
    have h_hom : f₁.left ≫ Y₁.hom = f₂.left ≫ Y₂.hom :=
      (congrArg (fun k : Y₁.left ⟶ S₁ => f₁.left ≫ k)
          (CategoryTheory.MorphismProperty.Over.w g₁).symm).trans
        ((CategoryTheory.Category.assoc f₁.left g₁.left Z.hom).symm.trans
          ((congrArg (fun k : X.left ⟶ Z.left => k ≫ Z.hom) h_left).trans
            ((CategoryTheory.Category.assoc f₂.left g₂.left Z.hom).trans
              (congrArg (fun k : Y₂.left ⟶ S₁ => f₂.left ≫ k)
                (CategoryTheory.MorphismProperty.Over.w g₂)))))
    let χ : X.left ⟶ S₁ := f₁.left ≫ Y₁.hom
    have h_χπ : χ ≫ π = X.hom := by
      calc
        (f₁.left ≫ Y₁.hom) ≫ π = f₁.left ≫ (Y₁.hom ≫ π) := CategoryTheory.Category.assoc _ _ _
        _ = X.hom := CategoryTheory.MorphismProperty.Over.w f₁
    have hEt_χ : AlgebraicGeometry.Etale χ := by
      have hEt_comp : AlgebraicGeometry.Etale (χ ≫ π) := h_χπ.symm ▸ X.prop
      exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (W' := @AlgebraicGeometry.Etale) χ π hEt₁ hEt_comp
    let W : S₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ χ hEt_χ
    let p₁ : W ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk f₁.left rfl
    let p₂ : W ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk f₂.left h_hom.symm
    have hp : p₁ ≫ g₁ = p₂ ≫ g₂ :=
      CategoryTheory.MorphismProperty.Over.Hom.ext h_left
    have hxW := hx p₁ p₂ hg₁ hg₂ hp
    let u : X ⟶ F₁.obj W := CategoryTheory.MorphismProperty.Over.homMk (𝟙 X.left)
      ((CategoryTheory.Category.id_comp (χ ≫ π)).trans h_χπ)
    have hu₁ : u ≫ F₁.map p₁ = f₁ :=
      CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp f₁.left)
    have hu₂ : u ≫ F₁.map p₂ = f₂ :=
      CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp f₂.left)
    calc
      (CategoryTheory.ConcreteCategory.hom (𝒢.val.map f₁.op)) (x g₁ hg₁)
        = (CategoryTheory.ConcreteCategory.hom (𝒢.val.map (u ≫ F₁.map p₁).op)) (x g₁ hg₁) := by
          rw [hu₁]
      _ = (CategoryTheory.ConcreteCategory.hom
            (𝒢.val.map (F₁.map p₁).op ≫ 𝒢.val.map u.op)) (x g₁ hg₁) := by
          rw [← 𝒢.val.map_comp]; rfl
      _ = (CategoryTheory.ConcreteCategory.hom (𝒢.val.map u.op))
            ((CategoryTheory.ConcreteCategory.hom (𝒢.val.map (F₁.map p₁).op)) (x g₁ hg₁)) :=
          CategoryTheory.ConcreteCategory.comp_apply _ _ _
      _ = (CategoryTheory.ConcreteCategory.hom (𝒢.val.map u.op))
            ((CategoryTheory.ConcreteCategory.hom (𝒢.val.map (F₁.map p₂).op)) (x g₂ hg₂)) :=
          congrArg (CategoryTheory.ConcreteCategory.hom (𝒢.val.map u.op)) hxW
      _ = (CategoryTheory.ConcreteCategory.hom
            (𝒢.val.map (F₁.map p₂).op ≫ 𝒢.val.map u.op)) (x g₂ hg₂) :=
          (CategoryTheory.ConcreteCategory.comp_apply _ _ _).symm
      _ = (CategoryTheory.ConcreteCategory.hom (𝒢.val.map (u ≫ F₁.map p₂).op)) (x g₂ hg₂) := by
          rw [← 𝒢.val.map_comp]; rfl
      _ = (CategoryTheory.ConcreteCategory.hom (𝒢.val.map f₂.op)) (x g₂ hg₂) := by
          rw [hu₂]

  have hCovF : CategoryTheory.CoverPreserving J₁ J_K F₁ := by
    refine CategoryTheory.CoverPreserving.mk (fun {V R} hR => ?_)
    have hJ₁ :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S₁ le_rfl
    have hJK :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S_K le_rfl
    change R ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) S₁ V at hR
    rw [hJ₁] at hR
    change CategoryTheory.Sieve.functorPushforward F₁ R ∈
      AlgebraicGeometry.Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) S_K (F₁.obj V)
    rw [hJK]
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (F₁.obj V) _).mpr
      (fun x => ?_)
    obtain ⟨Y, f, y, hfR, hEt_f, hfy⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology V R).mp hR x
    exact ⟨F₁.obj Y, F₁.map f, y,
      CategoryTheory.Sieve.image_mem_functorPushforward F₁ R hfR, hEt_f, hfy⟩

  have hContF : F₁.IsContinuous J₁ J_K :=
    CategoryTheory.Functor.isContinuous_of_coverPreserving hCompatF hCovF

  let π_star :=
    @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ F₁ A _ J₁ J_K hContF
  let π_push :=
    @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B₁ A _ J_K J₁ hContB

  let η_sh : 𝟭 (CategoryTheory.Sheaf J_K A) ⟶ π_star.comp π_push :=
    { app := fun ℱ =>
        { hom :=
            { app := fun U_op => ℱ.obj.map (Opposite.op (adj_site.counit.app U_op.unop))
              naturality := fun {U₁ U₂} g =>
                (ℱ.obj.map_comp g (Opposite.op (adj_site.counit.app U₂.unop))).symm.trans
                  ((congrArg (fun k => ℱ.obj.map (Opposite.op k))
                      (adj_site.counit.naturality g.unop).symm).trans
                    (ℱ.obj.map_comp (Opposite.op (adj_site.counit.app U₁.unop))
                      (Opposite.op (F₁.map (B₁.map g.unop))))) } }
      naturality := fun {ℱ₁ ℱ₂} φ =>
        CategoryTheory.Sheaf.hom_ext
          (CategoryTheory.NatTrans.ext (funext fun U_op =>
            (φ.hom.naturality (Opposite.op (adj_site.counit.app U_op.unop))).symm)) }

  let ε_sh : π_push.comp π_star ⟶ 𝟭 (CategoryTheory.Sheaf J₁ A) :=
    { app := fun 𝒢 =>
        { hom :=
            { app := fun V_op => 𝒢.obj.map (Opposite.op (adj_site.unit.app V_op.unop))
              naturality := fun {V₁ V₂} h =>
                (𝒢.obj.map_comp (Opposite.op (B₁.map (F₁.map h.unop)))
                  (Opposite.op (adj_site.unit.app V₂.unop))).symm.trans
                  ((congrArg (fun k => 𝒢.obj.map (Opposite.op k))
                      (adj_site.unit.naturality h.unop).symm).trans
                    (𝒢.obj.map_comp (Opposite.op (adj_site.unit.app V₁.unop)) h)) } }
      naturality := fun {𝒢₁ 𝒢₂} ψ =>
        CategoryTheory.Sheaf.hom_ext
          (CategoryTheory.NatTrans.ext (funext fun V_op =>
            (ψ.hom.naturality (Opposite.op (adj_site.unit.app V_op.unop))).symm)) }

  let adj_sh : π_star ⊣ π_push :=
    CategoryTheory.Adjunction.mkOfUnitCounit
      { unit := η_sh
        counit := ε_sh
        left_triangle :=
          CategoryTheory.NatTrans.ext (funext fun ℱ =>
            CategoryTheory.Sheaf.hom_ext
              (CategoryTheory.NatTrans.ext (funext fun V_op =>
                let c := Opposite.op (adj_site.counit.app (F₁.obj V_op.unop))
                let u := Opposite.op (F₁.map (adj_site.unit.app V_op.unop))
                (congrArg (fun k => ℱ.obj.map c ≫ k)
                    (CategoryTheory.Category.id_comp (ℱ.obj.map u))).trans
                  ((ℱ.obj.map_comp c u).symm.trans
                    ((congrArg (fun k => ℱ.obj.map (Opposite.op k))
                        (adj_site.left_triangle_components V_op.unop)).trans
                      (ℱ.obj.map_id (Opposite.op (F₁.obj V_op.unop))))))))
        right_triangle :=
          CategoryTheory.NatTrans.ext (funext fun 𝒢 =>
            CategoryTheory.Sheaf.hom_ext
              (CategoryTheory.NatTrans.ext (funext fun U_op =>
                let c := Opposite.op (B₁.map (adj_site.counit.app U_op.unop))
                let u := Opposite.op (adj_site.unit.app (B₁.obj U_op.unop))
                (congrArg (fun k => 𝒢.obj.map c ≫ k)
                    (CategoryTheory.Category.id_comp (𝒢.obj.map u))).trans
                  ((𝒢.obj.map_comp c u).symm.trans
                    ((congrArg (fun k => 𝒢.obj.map (Opposite.op k))
                        (adj_site.right_triangle_components U_op.unop)).trans
                      (𝒢.obj.map_id (Opposite.op (B₁.obj U_op.unop)))))))) }

  let S2P_K := CategoryTheory.sheafToPresheaf J_K A
  let S2P_1 := CategoryTheory.sheafToPresheaf J₁ A
  let W_F := (CategoryTheory.Functor.whiskeringLeft (S₁.Etale)ᵒᵖ (S_K.Etale)ᵒᵖ A).obj F₁.op
  have hEqF : π_star.comp S2P_1 = S2P_K.comp W_F := rfl
  have hLimComp₀ : CategoryTheory.Limits.PreservesFiniteLimits (S2P_K.comp W_F) :=
    @CategoryTheory.Limits.comp_preservesFiniteLimits _ _ _ _ _ _ S2P_K W_F
      inferInstance inferInstance
  have hLimComp : CategoryTheory.Limits.PreservesFiniteLimits (π_star.comp S2P_1) := by
    rw [hEqF]
    exact hLimComp₀
  have hPresLim : CategoryTheory.Limits.PreservesFiniteLimits π_star :=
    @CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _
      π_star S2P_1 hLimComp inferInstance

  let hTB₁ : CategoryTheory.Limits.IsTerminal (B₁.obj T_K) :=
    CategoryTheory.Limits.IsTerminal.isTerminalObj B₁ T_K hT_K
  let e_T : B₁.obj T_K ≅ T₁ := CategoryTheory.Limits.IsTerminal.uniqueUpToIso hTB₁ hT₁

  let C_K := CategoryTheory.constantSheaf J_K A
  let C₁ := CategoryTheory.constantSheaf J₁ A
  let Γ_K := (CategoryTheory.sheafSections J_K A).obj (Opposite.op T_K)
  let Γ₁ := (CategoryTheory.sheafSections J₁ A).obj (Opposite.op T₁)

  let e_Γ : π_push.comp Γ_K ≅ Γ₁ :=
    CategoryTheory.NatIso.ofComponents
      (fun 𝒢 => 𝒢.obj.mapIso e_T.symm.op)
      (fun {𝒢₁ 𝒢₂} φ => (φ.hom.naturality e_T.symm.op.hom).symm)

  let adj_const_K : C_K ⊣ Γ_K := CategoryTheory.constantSheafAdj J_K A hT_K
  let adj_const₁ : C₁ ⊣ Γ₁ := CategoryTheory.constantSheafAdj J₁ A hT₁
  let adj_comp : C_K.comp π_star ⊣ Γ₁ := (adj_const_K.comp adj_sh).ofNatIsoRight e_Γ
  let e_const : C_K.comp π_star ≅ C₁ :=
    CategoryTheory.Adjunction.leftAdjointUniq adj_comp adj_const₁

  exact ⟨hContF, hContB, adj_site, adj_sh, fun ℱ U => rfl, hPresLim,
    ⟨e_const.app (AddCommGrpCat.of (ULift.{u} ℤ))⟩⟩

theorem weil_alt_cd_field_etale_pushforward_vanishing (K K₁ : Type u) [Field K] [Field K₁]
    [Algebra K K₁] [FiniteDimensional K K₁] [Algebra.IsSeparable K K₁]
    (hEt₁ : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁))))
    (hContF : (weilAltCdFieldEtaleMap hEt₁).IsContinuous
      (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology
      (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology)
    (hContB : (weilAltCdSitePullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁)))).IsContinuous
      (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology
      (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology)
    (adj_sh :
      @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilAltCdFieldEtaleMap hEt₁) AddCommGrpCat.{u} _
        (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology
        (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology hContF ⊣
      @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilAltCdSitePullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁))))
        AddCommGrpCat.{u} _
        (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology
        (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology hContB)
    [CategoryTheory.Limits.PreservesFiniteLimits
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilAltCdFieldEtaleMap hEt₁) AddCommGrpCat.{u} _
        (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology
        (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology hContF)]
    (eℤ :
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilAltCdFieldEtaleMap hEt₁) AddCommGrpCat.{u} _
          (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology hContF).obj
        ((CategoryTheory.constantSheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology
          AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) ≅
        (CategoryTheory.constantSheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology
          AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))
    (s : ℕ) (hs : 1 ≤ s)
    (ℋ : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology AddCommGrpCat.{u})
    (hSub : Subsingleton (ℋ.H s)) :
    Subsingleton
      (((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilAltCdSitePullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁))))
          AddCommGrpCat.{u} _
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology hContB).obj ℋ).H s) :=
by
  have hFieldEt : ∀ (F E : Type u) [Field F] [Field E] [Algebra F E]
      [Module.Finite F E] [Algebra.IsSeparable F E],
      Algebra.Etale F E := by
    intro F E _ _ _ _ _
    exact (Algebra.Etale.iff_exists_algEquiv_prod F E).mpr
      ⟨PUnit.{u + 1}, inferInstance, fun _ => E, fun _ => inferInstance,
        fun _ => inferInstance,
        { toFun := fun x _ => x
          invFun := fun f => f PUnit.unit
          left_inv := fun _ => rfl
          right_inv := fun f => funext fun ⟨⟩ => rfl
          map_mul' := fun _ _ => rfl
          map_add' := fun _ _ => rfl
          commutes' := fun _ => rfl },
        fun _ => ⟨inferInstance, inferInstance⟩⟩

  have hMemSmallEtale : ∀ (F : Type u) [Field F]
      (U : (AlgebraicGeometry.Spec (CommRingCat.of F)).Etale)
      (R : CategoryTheory.Sieve U),
      (∀ u₀ : ↥U.left, ∃ (W : (AlgebraicGeometry.Spec (CommRingCat.of F)).Etale)
        (g : W ⟶ U) (w₀ : ↥W.left), g.left.base w₀ = u₀ ∧ R.arrows g) →
      R ∈ (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology U := by
    intro F _ U R hPt
    let S_F : Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of F)
    have _ : MorphismProperty.HasOfPostcompProperty (@Etale) (@Etale) :=
      ⟨fun {Y Z W} f g _ hfg =>
        MorphismProperty.of_postcomp (@Etale)
          (W' := @LocallyOfFiniteType ⊓ @FormallyUnramified) f g ⟨inferInstance, inferInstance⟩ hfg⟩
    choose W_fn g_fn w_fn hw_eq hR_arr using hPt
    have hEt_g : ∀ u₀ : ↥U.left, Etale (g_fn u₀).left := fun u₀ => by
      have hcomp : Etale ((g_fn u₀).left ≫ U.hom) := by
        rw [MorphismProperty.Over.w (g_fn u₀)]
        exact (W_fn u₀).prop
      exact MorphismProperty.of_postcomp (@Etale) (W' := @Etale) (g_fn u₀).left U.hom U.prop hcomp
    let P₀ : PreZeroHypercover.{u} U.left :=
      { I₀ := ↥U.left
        X := fun u₀ => (W_fn u₀).left
        f := fun u₀ => (g_fn u₀).left }
    have hmem₀ : P₀.presieve₀ ∈ (Scheme.precoverage (@Etale)).coverings U.left := by
      refine ⟨?_, ?_⟩
      · intro u₀
        refine ⟨Scheme.forget.obj (P₀.X u₀), Scheme.forget.map (P₀.f u₀), ?_, ⟨w_fn u₀, hw_eq u₀⟩⟩
        exact Presieve.map.of (Presieve.ofArrows.mk u₀)
      · rintro Y f ⟨u₀⟩
        exact hEt_g u₀
    let 𝒰 : Scheme.Cover.{u} (Scheme.precoverage (@Etale)) U.left :=
      { toPreZeroHypercover := P₀
        mem₀ := hmem₀ }
    have _ : Scheme.IsJointlySurjectivePreserving (@Etale) :=
      AlgebraicGeometry.Scheme.isJointlySurjectivePreserving (@Etale)
    change R ∈ (Scheme.smallGrothendieckTopology (@Etale) (S := S_F)) U
    refine (Scheme.mem_smallGrothendieckTopology U R).mpr
      ⟨𝒰, ⟨fun u₀ => ⟨(W_fn u₀).hom⟩, fun u₀ => ⟨MorphismProperty.Over.w (g_fn u₀)⟩⟩,
        fun u₀ => (W_fn u₀).prop, ?_⟩
    intro Z f hf
    rcases hf with ⟨u₀⟩
    exact (fun {Z' : S_F.Etale} (f' : Z' ⟶ U)
        (e_Z : Z' ⟶ W_fn u₀) (hf_eq : e_Z ≫ g_fn u₀ = f') =>
      Eq.mp (congrArg (fun h : Z' ⟶ U => R.arrows h) hf_eq)
        (R.downward_closed (hR_arr u₀) e_Z))
      _
      (MorphismProperty.Over.homMk (𝟙 (W_fn u₀).left) (Category.id_comp (W_fn u₀).hom))
      (MorphismProperty.Over.Hom.ext (Category.id_comp (g_fn u₀).left))

  have hPointFieldChart : ∀ (F : Type u) [Field F]
      (U : (AlgebraicGeometry.Spec (CommRingCat.of F)).Etale) (u₀ : ↥U.left),
      ∃ (E : Type u) (_ : Field E) (_ : Algebra F E) (_ : FiniteDimensional F E)
        (_ : Algebra.IsSeparable F E) (_ : Algebra.Etale F E)
        (j_E : weilAltCdSpecEtaleObj F E ⟶ U)
        (p_E : ↥(weilAltCdSpecEtaleObj F E).left),
        j_E.left.base p_E = u₀ := by
    intro F _ U u₀
    let S_F : Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of F)
    obtain ⟨V₀, hV₀, hu₀, _⟩ :=
      exists_isAffineOpen_mem_and_subset (U := (⊤ : U.left.Opens)) (x := u₀) trivial
    let R_A : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op V₀)
    let A : Type u := ↑R_A
    let φ_sch : AlgebraicGeometry.Spec R_A ⟶ S_F := hV₀.fromSpec ≫ U.hom
    have hEt_φ : Etale φ_sch := by
      have : Etale U.hom := U.prop
      exact inferInstance
    let φ_ring : CommRingCat.of F ⟶ R_A :=
      (AlgebraicGeometry.Spec.fullyFaithful.preimage φ_sch).unop
    have hSpec_φ : AlgebraicGeometry.Spec.map φ_ring = φ_sch :=
      AlgebraicGeometry.Spec.fullyFaithful.map_preimage φ_sch
    have hEt_ring : (CommRingCat.Hom.hom φ_ring).Etale := by
      rw [← HasRingHomProperty.Spec_iff (P := @Etale), hSpec_φ]
      exact hEt_φ
    let _ : Algebra F A := (CommRingCat.Hom.hom φ_ring).toAlgebra
    have hAlgEt : Algebra.Etale F A := RingHom.etale_algebraMap.mp hEt_ring
    obtain ⟨I, _, Ai, hFieldAi, hAlgAi, e_prod, hModAi⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod F A).mp hAlgEt
    let _ : ∀ i, Field (Ai i) := hFieldAi
    let _ : ∀ i, Algebra F (Ai i) := hAlgAi
    let _ : Fintype I := Fintype.ofFinite I
    let _ : DecidableEq I := Classical.decEq I
    let pt_spec : ↥(AlgebraicGeometry.Spec R_A) := hV₀.isoSpec.hom.base ⟨u₀, hu₀⟩
    have hpt_base : hV₀.fromSpec.base pt_spec = u₀ := by
      have hcomp := congrArg (fun f => f.base ⟨u₀, hu₀⟩) hV₀.isoSpec_hom_fromSpec
      exact hcomp
    let q₀ : Ideal (∀ i : I, Ai i) := Ideal.comap e_prod.symm.toRingHom pt_spec.asIdeal
    have _ : pt_spec.asIdeal.IsPrime := pt_spec.isPrime
    have hq₀_prime : q₀.IsPrime := Ideal.comap_isPrime e_prod.symm.toRingHom pt_spec.asIdeal
    have hex_i : ∃ i₀ : I, (Pi.single i₀ (1 : Ai i₀) : ∀ i : I, Ai i) ∉ q₀ := by
      by_contra! hall
      have hsum : (∑ i : I, (Pi.single i (1 : Ai i) : ∀ j : I, Ai j)) = 1 := by
        ext j
        simp
      have h1 : (1 : ∀ j : I, Ai j) ∈ q₀ := hsum ▸ q₀.sum_mem (fun i _ => hall i)
      exact hq₀_prime.ne_top (Ideal.eq_top_of_isUnit_mem q₀ h1 isUnit_one)
    obtain ⟨i₀, hi₀⟩ := hex_i
    let E : Type u := Ai i₀
    have _ : Module.Finite F E := (hModAi i₀).1
    have _ : FiniteDimensional F E := inferInstance
    have _ : Algebra.IsSeparable F E := (hModAi i₀).2
    have _ : Algebra.Etale F E := hFieldEt F E
    let π₀ : A →ₐ[F] E := (Pi.evalAlgHom F Ai i₀).comp e_prod.toAlgHom
    let p_E : ↥(weilAltCdSpecEtaleObj F E).left := (⊥ : PrimeSpectrum E)
    have hp_spec : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀.toRingHom)).base p_E =
        pt_spec := by
      apply PrimeSpectrum.ext
      ext a
      change π₀ a ∈ (⊥ : Ideal E) ↔ a ∈ pt_spec.asIdeal
      rw [Ideal.mem_bot]
      constructor
      · intro ha0
        have ha0' : e_prod a i₀ = 0 := ha0
        have hmul0 : (e_prod a) * (Pi.single i₀ (1 : Ai i₀) : ∀ j : I, Ai j) = 0 := by
          ext j
          by_cases hj : j = i₀
          · subst hj; simp [ha0']
          · simp [hj]
        have hmem_mul : (e_prod a) * (Pi.single i₀ (1 : Ai i₀) : ∀ j : I, Ai j) ∈ q₀ := by
          rw [hmul0]; exact q₀.zero_mem
        rcases hq₀_prime.mem_or_mem hmem_mul with ha_mem | hi_mem
        · change e_prod.symm (e_prod a) ∈ pt_spec.asIdeal at ha_mem
          simpa using ha_mem
        · exact absurd hi_mem hi₀
      · intro ha_in
        have ha_q₀ : e_prod a ∈ q₀ := by
          change e_prod.symm (e_prod a) ∈ pt_spec.asIdeal
          simpa using ha_in
        by_contra hne
        have hne' : e_prod a i₀ ≠ 0 := hne
        let b : ∀ j : I, Ai j := Pi.single i₀ (e_prod a i₀)⁻¹
        have hmul1 : (e_prod a) * b = Pi.single i₀ (1 : Ai i₀) := by
          ext j
          by_cases hj : j = i₀
          · subst hj; simp [b, mul_inv_cancel₀ hne']
          · simp [b, hj]
        exact hi₀ (hmul1 ▸ q₀.mul_mem_right b ha_q₀)
    have hj_w : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀.toRingHom) ≫ hV₀.fromSpec) ≫
        U.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E)) := by
      calc
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀.toRingHom) ≫ hV₀.fromSpec) ≫ U.hom
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀.toRingHom) ≫ φ_sch :=
            Category.assoc _ _ _
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀.toRingHom) ≫
              AlgebraicGeometry.Spec.map φ_ring := by rw [hSpec_φ]
        _ = AlgebraicGeometry.Spec.map
              (φ_ring ≫ CommRingCat.ofHom π₀.toRingHom) :=
            (AlgebraicGeometry.Spec.map_comp _ _).symm
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E)) :=
            congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext π₀.comp_algebraMap)
    let j_E : weilAltCdSpecEtaleObj F E ⟶ U :=
      @MorphismProperty.Over.homMk _ _ (@Etale) ⊤ S_F _ (weilAltCdSpecEtaleObj F E) U
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀.toRingHom) ≫ hV₀.fromSpec)
        hj_w trivial
    refine ⟨E, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      j_E, p_E, ?_⟩
    change hV₀.fromSpec.base
      ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀.toRingHom)).base p_E) = u₀
    rw [hp_spec, hpt_base]

  have hSieveFieldRefine : ∀ (F A : Type u) [Field F] [Field A] [Algebra F A]
      [FiniteDimensional F A] [Algebra.IsSeparable F A] [Algebra.Etale F A]
      (R : CategoryTheory.Sieve (weilAltCdSpecEtaleObj F A)),
      R ∈ (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology
        (weilAltCdSpecEtaleObj F A) →
      ∃ (B : Type u) (_ : Field B) (_ : Algebra F B) (_ : FiniteDimensional F B)
        (_ : Algebra.IsSeparable F B) (_ : Algebra.Etale F B) (ρ : A →ₐ[F] B),
        R.arrows (weilAltCdSpecEtaleMap F ρ) := by
    intro F A _ _ _ _ _ _ R hR
    let S_F : Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of F)
    let U_A : S_F.Etale := weilAltCdSpecEtaleObj F A
    have hJS : Scheme.JointlySurjective (Scheme.precoverage (@Etale)) :=
      @Scheme.instJointlySurjectivePrecoverage (@Etale)
    have hmem : R ∈ (Scheme.smallGrothendieckTopology (@Etale) (S := S_F)) U_A := hR
    obtain ⟨𝒰, h_over, hP, hle⟩ := (Scheme.mem_smallGrothendieckTopology U_A R).mp hmem
    let p₀ : ↥U_A.left := (⊥ : PrimeSpectrum A)
    let j : 𝒰.I₀ := @Scheme.Cover.idx _ _ hJS 𝒰 p₀
    obtain ⟨q₀, _⟩ := @Scheme.Cover.covers _ _ hJS 𝒰 p₀
    have _ : Scheme.IsJointlySurjectivePreserving (@Etale) :=
      AlgebraicGeometry.Scheme.isJointlySurjectivePreserving (@Etale)
    let _ : Scheme.Cover.Over S_F 𝒰 := h_over
    have hp_mem : 𝒰.toPresieveOverProp hP _ :=
      @Presieve.ofArrows.mk S_F.Etale inferInstance U_A _ _ _ j
    obtain ⟨W, u, hu_mem, ⟨q₀⟩⟩ :
        ∃ (W : S_F.Etale) (u : W ⟶ U_A), R.arrows u ∧ Nonempty ↥W.left :=
      ⟨_, _, hle _ _ hp_mem, ⟨q₀⟩⟩
    obtain ⟨B, hFieldB, hAlgB, hFinB, hSepB, hEtB, j_B, _, _⟩ := hPointFieldChart F W q₀
    let _ : Field B := hFieldB
    let _ : Algebra F B := hAlgB
    have _ : FiniteDimensional F B := hFinB
    have _ : Algebra.IsSeparable F B := hSepB
    have _ : Algebra.Etale F B := hEtB
    let v : weilAltCdSpecEtaleObj F B ⟶ U_A := j_B ≫ u
    have hv_mem : R.arrows v := R.downward_closed hu_mem j_B
    let φ_ring : CommRingCat.of A ⟶ CommRingCat.of B :=
      (AlgebraicGeometry.Spec.fullyFaithful.preimage v.left).unop
    have hSpec_v : AlgebraicGeometry.Spec.map φ_ring = v.left :=
      AlgebraicGeometry.Spec.fullyFaithful.map_preimage v.left
    have hSpec_eq :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F A) ≫ φ_ring) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F B)) := by
      rw [AlgebraicGeometry.Spec.map_comp, hSpec_v]
      exact MorphismProperty.Over.w v
    have hcomm_ring :
        CommRingCat.ofHom (algebraMap F A) ≫ φ_ring = CommRingCat.ofHom (algebraMap F B) :=
      congrArg Quiver.Hom.unop (AlgebraicGeometry.Spec.fullyFaithful.map_injective hSpec_eq)
    let ρ : A →ₐ[F] B :=
      { toRingHom := φ_ring.hom
        commutes' := fun c =>
          congrArg (fun f : CommRingCat.of F ⟶ CommRingCat.of B => f.hom c) hcomm_ring }
    have hv_eq : weilAltCdSpecEtaleMap F ρ = v := MorphismProperty.Over.Hom.ext hSpec_v
    exact ⟨B, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      ρ, hv_eq.symm ▸ hv_mem⟩

  have hPiFieldSheafLift : ∀ (F : Type u) [Field F] (k : ℕ)
      (L : Fin k → Type u) [∀ m, Field (L m)] [∀ m, Algebra F (L m)] [∀ m, Algebra.Etale F (L m)]
      (R : Type u) [CommRing R] [Algebra F R] [Algebra.Etale F R]
      (e_prod : R ≃ₐ[F] (∀ m : Fin k, L m))
      (𝒢₁ 𝒢₂ : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology AddCommGrpCat.{u})
      (α : 𝒢₁ ⟶ 𝒢₂)
      (y : ↥(𝒢₂.obj.obj (Opposite.op (weilAltCdSpecEtaleObj F R)))),
      (∀ m : Fin k, ∃ x_m : ↥(𝒢₁.obj.obj (Opposite.op (weilAltCdSpecEtaleObj F (L m)))),
        (α.hom.app (Opposite.op (weilAltCdSpecEtaleObj F (L m)))).hom x_m =
          (𝒢₂.obj.map (Opposite.op
            (weilAltCdSpecEtaleMap F ((Pi.evalAlgHom F L m).comp e_prod.toAlgHom)))).hom y) →
      ∃ x : ↥(𝒢₁.obj.obj (Opposite.op (weilAltCdSpecEtaleObj F R))),
        (α.hom.app (Opposite.op (weilAltCdSpecEtaleObj F R))).hom x = y := by
    intro F _ k L _ _ _ R _ _ _ e_prod 𝒢₁ 𝒢₂ α y hLift
    let S_F : Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of F)
    let J := S_F.smallEtaleTopology
    let V_R := weilAltCdSpecEtaleObj F R
    let π_m : ∀ m : Fin k, R →ₐ[F] L m := fun m => (Pi.evalAlgHom F L m).comp e_prod.toAlgHom
    let V_m : Fin k → S_F.Etale := fun m => weilAltCdSpecEtaleObj F (L m)
    let p_m : ∀ m : Fin k, V_m m ⟶ V_R := fun m => weilAltCdSpecEtaleMap F (π_m m)
    have hCov : CategoryTheory.Sieve.ofArrows V_m p_m ∈ J V_R := by
      refine hMemSmallEtale F V_R (CategoryTheory.Sieve.ofArrows V_m p_m) (fun pt => ?_)
      let q₀ : Ideal (∀ m : Fin k, L m) := Ideal.comap e_prod.symm.toRingHom pt.asIdeal
      have _ : pt.asIdeal.IsPrime := pt.isPrime
      have hq₀_prime : q₀.IsPrime := Ideal.comap_isPrime e_prod.symm.toRingHom pt.asIdeal
      have hex_m : ∃ m₀ : Fin k, (Pi.single m₀ (1 : L m₀) : ∀ m : Fin k, L m) ∉ q₀ := by
        by_contra! hall
        have hsum : (∑ m : Fin k, (Pi.single m (1 : L m) : ∀ j : Fin k, L j)) = 1 := by
          ext j
          simp
        have h1 : (1 : ∀ j : Fin k, L j) ∈ q₀ := hsum ▸ q₀.sum_mem (fun m _ => hall m)
        exact hq₀_prime.ne_top (Ideal.eq_top_of_isUnit_mem q₀ h1 isUnit_one)
      obtain ⟨m₀, hm₀⟩ := hex_m
      refine ⟨V_m m₀, p_m m₀, (⊥ : PrimeSpectrum (L m₀)), ?_,
        CategoryTheory.Sieve.ofArrows_mk V_m p_m m₀⟩
      apply PrimeSpectrum.ext
      ext a
      change π_m m₀ a ∈ (⊥ : Ideal (L m₀)) ↔ a ∈ pt.asIdeal
      rw [Ideal.mem_bot]
      constructor
      · intro ha0
        have ha0' : e_prod a m₀ = 0 := ha0
        have hmul0 : (e_prod a) * (Pi.single m₀ (1 : L m₀) : ∀ j : Fin k, L j) = 0 := by
          ext j
          by_cases hj : j = m₀
          · subst hj; simp [ha0']
          · simp [hj]
        have hmem_mul : (e_prod a) * (Pi.single m₀ (1 : L m₀) : ∀ j : Fin k, L j) ∈ q₀ := by
          rw [hmul0]; exact q₀.zero_mem
        rcases hq₀_prime.mem_or_mem hmem_mul with ha_mem | hi_mem
        · change e_prod.symm (e_prod a) ∈ pt.asIdeal at ha_mem
          simpa using ha_mem
        · exact absurd hi_mem hm₀
      · intro ha_in
        have ha_q₀ : e_prod a ∈ q₀ := by
          change e_prod.symm (e_prod a) ∈ pt.asIdeal
          simpa using ha_in
        by_contra hne
        have hne' : e_prod a m₀ ≠ 0 := hne
        let b : ∀ j : Fin k, L j := Pi.single m₀ (e_prod a m₀)⁻¹
        have hmul1 : (e_prod a) * b = Pi.single m₀ (1 : L m₀) := by
          ext j
          by_cases hj : j = m₀
          · subst hj; simp [b, mul_inv_cancel₀ hne']
          · simp [b, hj]
        exact hm₀ (hmul1 ▸ q₀.mul_mem_right b ha_q₀)
    let P₁ : S_F.Etaleᵒᵖ ⥤ Type u := 𝒢₁.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    let P₂ : S_F.Etaleᵒᵖ ⥤ Type u := 𝒢₂.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    have hSh₁ : CategoryTheory.Presieve.IsSheaf J P₁ :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type J P₁).mp
        (CategoryTheory.GrothendieckTopology.HasSheafCompose.isSheaf 𝒢₁.obj 𝒢₁.property)
    have hSh₂ : CategoryTheory.Presieve.IsSheaf J P₂ :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type J P₂).mp
        (CategoryTheory.GrothendieckTopology.HasSheafCompose.isSheaf 𝒢₂.obj 𝒢₂.property)
    have hEmptySub : ∀ (Z : S_F.Etale), IsEmpty ↥Z.left → Subsingleton (P₁.obj (Opposite.op Z)) := by
      intro Z hEmp
      have hCovEmp : CategoryTheory.Sieve.ofArrows (Empty.elim : Empty → S_F.Etale)
          (fun i => i.elim) ∈ J Z :=
        hMemSmallEtale F Z _ (fun z => hEmp.elim z)
      have hForEmp := hSh₁.isSheafFor
        (CategoryTheory.Presieve.ofArrows (Empty.elim : Empty → S_F.Etale) (fun i => i.elim))
        hCovEmp
      obtain ⟨t₀, _, ht₀_uniq⟩ :=
        (CategoryTheory.Presieve.isSheafFor_arrows_iff P₁ (fun i : Empty => i.elim)).mp
          hForEmp (fun i => i.elim) (fun i => i.elim)
      exact subsingleton_of_forall_eq t₀ (fun s => ht₀_uniq s (fun i => i.elim))
    choose x_fn hx_fn using hLift
    have hCompat : CategoryTheory.Presieve.Arrows.Compatible P₁ p_m x_fn := by
      intro m₁ m₂ Z g₁ g₂ hg
      by_cases hm : m₁ = m₂
      · subst hm
        have hSurj : Function.Surjective (π_m m₁).toRingHom := fun a =>
          ⟨e_prod.symm (Pi.single m₁ a), by simp [π_m]⟩
        have hCl : AlgebraicGeometry.IsClosedImmersion (p_m m₁).left :=
          AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
            (CommRingCat.ofHom (π_m m₁).toRingHom) hSurj
        have _ : CategoryTheory.Mono (p_m m₁).left :=
          ((AlgebraicGeometry.IsClosedImmersion.iff_isFinite_and_mono (p_m m₁).left).mp hCl).2
        have hg_left : g₁.left ≫ (p_m m₁).left = g₂.left ≫ (p_m m₁).left :=
          congrArg (fun f => f.left) hg
        have hg_eq : g₁ = g₂ := MorphismProperty.Over.Hom.ext ((cancel_mono _).mp hg_left)
        rw [hg_eq]
      · have hEmpZ : IsEmpty ↥Z.left := by
          refine ⟨fun z => ?_⟩
          let r₁ : R := e_prod.symm (Pi.single m₁ 1)
          have hpt_eq : ((p_m m₁).left.base (g₁.left.base z)).asIdeal =
              ((p_m m₂).left.base (g₂.left.base z)).asIdeal := by
            have hbase := congrArg (fun f : Z ⟶ V_R => f.left.base z) hg
            exact congrArg PrimeSpectrum.asIdeal hbase
          have hnot_in : r₁ ∉ ((p_m m₁).left.base (g₁.left.base z)).asIdeal := by
            change π_m m₁ r₁ ∉ (g₁.left.base z).asIdeal
            have h1 : π_m m₁ r₁ = 1 := by simp [π_m, r₁]
            rw [h1]
            intro h1_in
            exact (g₁.left.base z).isPrime.ne_top
              (Ideal.eq_top_of_isUnit_mem _ h1_in isUnit_one)
          have hin : r₁ ∈ ((p_m m₂).left.base (g₂.left.base z)).asIdeal := by
            change π_m m₂ r₁ ∈ (g₂.left.base z).asIdeal
            have hne₂₁ : m₂ ≠ m₁ := fun h21 => hm h21.symm
            have h0 : π_m m₂ r₁ = 0 := by simp [π_m, r₁, Pi.single_eq_of_ne hne₂₁]
            rw [h0]
            exact Ideal.zero_mem _
          exact hnot_in (hpt_eq.symm ▸ hin)
        exact @Subsingleton.elim _ (hEmptySub Z hEmpZ) _ _
    have hFor₁ := hSh₁.isSheafFor (CategoryTheory.Presieve.ofArrows V_m p_m) hCov
    obtain ⟨x, hx_glue, _⟩ :=
      (CategoryTheory.Presieve.isSheafFor_arrows_iff P₁ p_m).mp hFor₁ x_fn hCompat
    refine ⟨x, ?_⟩
    have hFor₂ := hSh₂.isSheafFor (CategoryTheory.Presieve.ofArrows V_m p_m) hCov
    let y_res : ∀ m : Fin k, P₂.obj (Opposite.op (V_m m)) :=
      fun m => (CategoryTheory.ConcreteCategory.hom (P₂.map (p_m m).op)) y
    have hCompat₂ : CategoryTheory.Presieve.Arrows.Compatible P₂ p_m y_res := by
      intro m₁ m₂ Z g₁ g₂ hg
      dsimp [y_res, P₂]
      have h1 : (𝒢₂.obj.map g₁.op).hom ((𝒢₂.obj.map (p_m m₁).op).hom y) =
          (𝒢₂.obj.map (g₁ ≫ p_m m₁).op).hom y := by
        rw [op_comp, Functor.map_comp]
        rfl
      have h2 : (𝒢₂.obj.map g₂.op).hom ((𝒢₂.obj.map (p_m m₂).op).hom y) =
          (𝒢₂.obj.map (g₂ ≫ p_m m₂).op).hom y := by
        rw [op_comp, Functor.map_comp]
        rfl
      rw [h1, h2, hg]
    obtain ⟨t, _, ht_uniq⟩ :=
      (CategoryTheory.Presieve.isSheafFor_arrows_iff P₂ p_m).mp hFor₂ y_res hCompat₂
    have h_ax : (α.hom.app (Opposite.op V_R)).hom x = t := by
      refine ht_uniq ((α.hom.app (Opposite.op V_R)).hom x) (fun m => ?_)
      have hnat := congrArg (fun f => f.hom x) (α.hom.naturality (p_m m).op)
      dsimp [P₁, P₂, y_res] at hx_glue hnat ⊢
      exact hnat.symm.trans ((congrArg (α.hom.app (Opposite.op (V_m m))).hom (hx_glue m)).trans
        (hx_fn m))
    have h_y : y = t := ht_uniq y (fun _ => rfl)
    exact h_ax.trans h_y.symm

  have hSplittingFactor : ∀ (E : Type u) [Field E] [Algebra K E]
      [FiniteDimensional K E] [Algebra.IsSeparable K E]
      (k : ℕ) (L : Fin k → Type u) [∀ m, Field (L m)] [∀ m, Algebra K₁ (L m)]
      (e_E : TensorProduct K K₁ E ≃ₐ[K₁] (∀ m : Fin k, L m))
      (E' : Fin k → Type u) [∀ m, Field (E' m)] [∀ m, Algebra K₁ (E' m)]
      [∀ m, FiniteDimensional K₁ (E' m)] [∀ m, Algebra.IsSeparable K₁ (E' m)]
      (ρ : ∀ m : Fin k, L m →ₐ[K₁] E' m),
      ∃ (N : Type u) (_ : Field N) (_ : Algebra K N) (_ : FiniteDimensional K N)
        (_ : Algebra.IsSeparable K N) (_ : Algebra.Etale K N)
        (ι_EN : E →ₐ[K] N)
        (r : ℕ) (F_fac : Fin r → Type u)
        (_ : ∀ j, Field (F_fac j)) (_ : ∀ j, Algebra K₁ (F_fac j))
        (_ : ∀ j, Algebra.Etale K₁ (F_fac j))
        (e_N : TensorProduct K K₁ N ≃ₐ[K₁] (∀ j : Fin r, F_fac j))
        (m_idx : Fin r → Fin k)
        (σ : ∀ j : Fin r, E' (m_idx j) →ₐ[K₁] F_fac j),
        ∀ j : Fin r,
          ((σ j).comp (ρ (m_idx j))).comp ((Pi.evalAlgHom K₁ L (m_idx j)).comp e_E.toAlgHom) =
            ((Pi.evalAlgHom K₁ F_fac j).comp e_N.toAlgHom).comp
              (Algebra.TensorProduct.map (AlgHom.id K₁ K₁) ι_EN) := by
    intro E _ _ _ _ k L _ _ e_E E' _ _ _ _ ρ
    let incR_E : E →+* TensorProduct K K₁ E :=
      (Algebra.TensorProduct.includeRight : E →ₐ[K] TensorProduct K K₁ E).toRingHom
    let i_m : ∀ m : Fin k, E →+* L m := fun m =>
      ((Pi.evalAlgHom K₁ L m).comp e_E.toAlgHom).toRingHom.comp incR_E
    let ψ_E : ∀ m : Fin k, E →+* E' m := fun m => (ρ m).toRingHom.comp (i_m m)
    let algKE' : ∀ m : Fin k, Algebra K (E' m) := fun m =>
      ((algebraMap K₁ (E' m)).comp (algebraMap K K₁)).toAlgebra
    let algEE' : ∀ m : Fin k, Algebra E (E' m) := fun m => (ψ_E m).toAlgebra
    let algEL : ∀ m : Fin k, Algebra E (L m) := fun m => (i_m m).toAlgebra
    have hTowerKE' : ∀ m : Fin k,
        let _ : Algebra K (E' m) := algKE' m
        IsScalarTower K K₁ (E' m) := by
      intro m
      let _ : Algebra K (E' m) := algKE' m
      exact IsScalarTower.of_algebraMap_eq' rfl
    have hTowerKEE' : ∀ m : Fin k,
        let _ : Algebra K (E' m) := algKE' m
        let _ : Algebra E (E' m) := algEE' m
        IsScalarTower K E (E' m) := by
      intro m
      let _ : Algebra K (E' m) := algKE' m
      let _ : Algebra E (E' m) := algEE' m
      refine IsScalarTower.of_algebraMap_eq (fun c => ?_)
      symm
      change ρ m (e_E ((1 : K₁) ⊗ₜ[K] algebraMap K E c) m) =
        algebraMap K₁ (E' m) (algebraMap K K₁ c)
      have htmul : ((1 : K₁) ⊗ₜ[K] algebraMap K E c : TensorProduct K K₁ E) =
          algebraMap K₁ (TensorProduct K K₁ E) (algebraMap K K₁ c) := by
        change (1 : K₁) ⊗ₜ[K] algebraMap K E c = (algebraMap K K₁ c) ⊗ₜ[K] (1 : E)
        calc
          (1 : K₁) ⊗ₜ[K] algebraMap K E c
            = (1 : K₁) ⊗ₜ[K] (c • (1 : E)) := by rw [Algebra.algebraMap_eq_smul_one]
          _ = (c • (1 : K₁)) ⊗ₜ[K] (1 : E) := (TensorProduct.smul_tmul c (1 : K₁) (1 : E)).symm
          _ = (algebraMap K K₁ c) ⊗ₜ[K] (1 : E) := by rw [Algebra.algebraMap_eq_smul_one]
      rw [htmul, AlgEquiv.commutes, Pi.algebraMap_apply, AlgHom.commutes]
    have hFinEE' : ∀ m : Fin k, @FiniteDimensional E (E' m) _ _ (algEE' m).toModule := by
      intro m
      let _ : Algebra K (E' m) := algKE' m
      let _ : Algebra E (E' m) := algEE' m
      have _ : IsScalarTower K K₁ (E' m) := hTowerKE' m
      have _ : IsScalarTower K E (E' m) := hTowerKEE' m
      have _ : Module.Finite K (E' m) := Module.Finite.trans K₁ (E' m)
      exact FiniteDimensional.right K E (E' m)
    have hSepEE' : ∀ m : Fin k, @Algebra.IsSeparable E (E' m) _ _ (algEE' m) := by
      intro m
      let _ : Algebra K (E' m) := algKE' m
      let _ : Algebra E (E' m) := algEE' m
      have _ : IsScalarTower K K₁ (E' m) := hTowerKE' m
      have _ : IsScalarTower K E (E' m) := hTowerKEE' m
      have _ : Algebra.IsSeparable K (E' m) := Algebra.IsSeparable.trans K K₁ (E' m)
      exact (Algebra.isSeparable_def E (E' m)).mpr (fun x =>
        IsSeparable.tower_top E (Algebra.IsSeparable.isSeparable K x))
    obtain ⟨α₀, hα₀⟩ := Field.exists_primitive_element K K₁
    have hAdj_α₀ : Algebra.adjoin K ({α₀} : Set K₁) = ⊤ :=
      Algebra.adjoin_eq_top_of_primitive_element (Algebra.IsAlgebraic.isAlgebraic α₀) hα₀
    let p₀ : Polynomial E := (minpoly K α₀).map (algebraMap K E)
    have hp₀_monic : p₀.Monic := (minpoly.monic (Algebra.IsIntegral.isIntegral α₀)).map _
    have hp₀_sep : p₀.Separable :=
      Polynomial.Separable.map (Algebra.IsSeparable.isSeparable K α₀)
    have hPB : ∀ m : Fin k, ∃ pb : @PowerBasis E (E' m) _ _ (algEE' m), True := by
      intro m
      let _ : Algebra E (E' m) := algEE' m
      have _ : FiniteDimensional E (E' m) := hFinEE' m
      have _ : Algebra.IsSeparable E (E' m) := hSepEE' m
      obtain ⟨β, hβ⟩ := Field.exists_primitive_element E (E' m)
      have hadj : Algebra.adjoin E ({β} : Set (E' m)) = ⊤ :=
        Algebra.adjoin_eq_top_of_primitive_element (Algebra.IsAlgebraic.isAlgebraic β) hβ
      exact ⟨PowerBasis.ofAdjoinEqTop (Algebra.IsIntegral.isIntegral β) hadj, trivial⟩
    choose pb _ using hPB
    let q_poly : Fin k → Polynomial E := fun m =>
      let _ : Algebra E (E' m) := algEE' m
      minpoly E (pb m).gen
    have hq_monic : ∀ m : Fin k, (q_poly m).Monic := by
      intro m
      let _ : Algebra E (E' m) := algEE' m
      have _ : FiniteDimensional E (E' m) := hFinEE' m
      exact minpoly.monic (Algebra.IsIntegral.isIntegral (pb m).gen)
    have hq_sep : ∀ m : Fin k, (q_poly m).Separable := by
      intro m
      let _ : Algebra E (E' m) := algEE' m
      have _ : Algebra.IsSeparable E (E' m) := hSepEE' m
      exact Algebra.IsSeparable.isSeparable E (pb m).gen
    let g : Polynomial E := p₀ * ∏ m : Fin k, q_poly m
    have hg_monic : g.Monic :=
      hp₀_monic.mul (Polynomial.monic_prod_of_monic Finset.univ q_poly (fun m _ => hq_monic m))
    let N : Type u := g.SplittingField
    have _ : Normal E N := Polynomial.SplittingField.instNormal g
    have _ : FiniteDimensional E N := inferInstance
    have hg_map_ne : g.map (algebraMap E N) ≠ 0 := (hg_monic.map (algebraMap E N)).ne_zero
    have hg_splits : (g.map (algebraMap E N)).Splits := Polynomial.SplittingField.splits g
    have _ : Algebra.IsSeparable E N := by
      have hadj_alg : Algebra.adjoin E (g.rootSet N) = ⊤ :=
        Polynomial.IsSplittingField.adjoin_rootSet N g
      have hadj_if : IntermediateField.adjoin E (g.rootSet N) = ⊤ := by
        rw [eq_top_iff]
        intro x _
        have hx : x ∈ (⊤ : Subalgebra E N) := Algebra.mem_top
        rw [← hadj_alg] at hx
        exact Algebra.adjoin_le (IntermediateField.subset_adjoin E (g.rootSet N)) hx
      have hsep_roots : ∀ z ∈ g.rootSet N, IsSeparable E z := by
        intro z hz
        have haeval : Polynomial.aeval z g = 0 := (Polynomial.mem_rootSet.mp hz).2
        have hmul0 : Polynomial.aeval z p₀ * ∏ m : Fin k, Polynomial.aeval z (q_poly m) = 0 := by
          simpa only [g, map_mul, map_prod] using haeval
        rcases mul_eq_zero.mp hmul0 with hp0 | hprod0
        · exact hp₀_sep.of_dvd (minpoly.dvd E z hp0)
        · obtain ⟨m, _, hm0⟩ := Finset.prod_eq_zero_iff.mp hprod0
          exact (hq_sep m).of_dvd (minpoly.dvd E z hm0)
      have _ : Algebra.IsSeparable E ↥(IntermediateField.adjoin E (g.rootSet N)) :=
        (IntermediateField.isSeparable_adjoin_iff_isSeparable E N).mpr hsep_roots
      let e_top : ↥(IntermediateField.adjoin E (g.rootSet N)) ≃ₐ[E] N :=
        (IntermediateField.equivOfEq hadj_if).trans IntermediateField.topEquiv
      exact (Algebra.isSeparable_def E N).mpr (fun x => by
        have hx := Algebra.IsSeparable.isSeparable E (e_top.symm x)
        have hmin : minpoly E (e_top (e_top.symm x)) = minpoly E (e_top.symm x) :=
          minpoly.algEquiv_eq e_top (e_top.symm x)
        rw [AlgEquiv.apply_symm_apply] at hmin
        rwa [IsSeparable, hmin])
    have _ : Module.Finite K N := Module.Finite.trans E N
    have _ : FiniteDimensional K N := inferInstance
    have _ : Algebra.IsSeparable K N := Algebra.IsSeparable.trans K E N
    have _ : Algebra.Etale K N := hFieldEt K N
    let ι_EN : E →ₐ[K] N := IsScalarTower.toAlgHom K E N
    have hEmbE' : ∀ m : Fin k, ∃ ι_m : @AlgHom E (E' m) N _ _ _ (algEE' m) _, True := by
      intro m
      let _ : Algebra E (E' m) := algEE' m
      have _ : FiniteDimensional E (E' m) := hFinEE' m
      have hdvd_g : q_poly m ∣ g :=
        dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem q_poly (Finset.mem_univ m)) p₀
      have hq_splits : ((q_poly m).map (algebraMap E N)).Splits :=
        hg_splits.of_dvd hg_map_ne (Polynomial.map_dvd (algebraMap E N) hdvd_g)
      have hdeg_pos : 0 < (q_poly m).natDegree :=
        minpoly.natDegree_pos (Algebra.IsIntegral.isIntegral (pb m).gen)
      have hmap_deg : ((q_poly m).map (algebraMap E N)).degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree ((hq_monic m).map (algebraMap E N)).ne_zero,
          (hq_monic m).natDegree_map (algebraMap E N)]
        exact Nat.cast_ne_zero.mpr (Nat.ne_of_gt hdeg_pos)
      obtain ⟨r_m, hr_m⟩ := hq_splits.exists_eval_eq_zero hmap_deg
      have haeval_r : Polynomial.aeval r_m (minpoly E (pb m).gen) = 0 := by
        rw [Polynomial.aeval_def, ← Polynomial.eval_map]
        exact hr_m
      exact ⟨(pb m).lift r_m haeval_r, trivial⟩
    choose ι_E' _ using hEmbE'
    have _ : Algebra.Etale K₁ (TensorProduct K K₁ N) := Algebra.Etale.baseChange K N K₁
    obtain ⟨J_raw, _, Fj_raw, hFieldFj, hAlgFj, e_N_raw, hModFj⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K₁ (TensorProduct K K₁ N)).mp inferInstance
    let _ : ∀ j, Field (Fj_raw j) := hFieldFj
    let _ : ∀ j, Algebra K₁ (Fj_raw j) := hAlgFj
    let _ : Fintype J_raw := Fintype.ofFinite J_raw
    set r := Fintype.card J_raw
    let e_fin : J_raw ≃ Fin r := Fintype.equivFin J_raw
    let F_fac : Fin r → Type u := fun j => Fj_raw (e_fin.symm j)
    let _ : ∀ j, Field (F_fac j) := fun j => hFieldFj (e_fin.symm j)
    let _ : ∀ j, Algebra K₁ (F_fac j) := fun j => hAlgFj (e_fin.symm j)
    have _ : ∀ j, Algebra.Etale K₁ (F_fac j) := fun j => by
      have _ : Module.Finite K₁ (F_fac j) := (hModFj (e_fin.symm j)).1
      have _ : Algebra.IsSeparable K₁ (F_fac j) := (hModFj (e_fin.symm j)).2
      exact hFieldEt K₁ (F_fac j)
    let e_N : TensorProduct K K₁ N ≃ₐ[K₁] (∀ j : Fin r, F_fac j) :=
      e_N_raw.trans (AlgEquiv.piCongrLeft' K₁ Fj_raw e_fin)
    have hFactorJ : ∀ j : Fin r, ∃ (m_j : Fin k) (σ_j : E' m_j →ₐ[K₁] F_fac j),
        ((σ_j.comp (ρ m_j)).comp ((Pi.evalAlgHom K₁ L m_j).comp e_E.toAlgHom)) =
          ((Pi.evalAlgHom K₁ F_fac j).comp e_N.toAlgHom).comp
            (Algebra.TensorProduct.map (AlgHom.id K₁ K₁) ι_EN) := by
      intro j
      let proj_j : TensorProduct K K₁ N →ₐ[K₁] F_fac j :=
        (Pi.evalAlgHom K₁ F_fac j).comp e_N.toAlgHom
      have hproj_surj : Function.Surjective proj_j := by
        intro y
        refine ⟨e_N.symm (Pi.single j y), ?_⟩
        simp [proj_j]
      let q_j : (∀ m : Fin k, L m) →ₐ[K₁] F_fac j :=
        (proj_j.comp (Algebra.TensorProduct.map (AlgHom.id K₁ K₁) ι_EN)).comp e_E.symm.toAlgHom
      have hex_m : ∃ m_j : Fin k, q_j (Pi.single m_j 1) ≠ 0 := by
        by_contra! hall
        have hsum : (∑ m : Fin k, (Pi.single m (1 : L m) : ∀ m' : Fin k, L m')) = 1 := by
          ext m'
          simp
        have h1 : (1 : F_fac j) = 0 := by
          rw [← map_one q_j, ← hsum, map_sum]
          exact Finset.sum_eq_zero (fun m _ => hall m)
        exact one_ne_zero h1
      obtain ⟨m_j, hm_j⟩ := hex_m
      have h_idem1 : q_j (Pi.single m_j 1) = 1 := by
        have hsq : (Pi.single m_j (1 : L m_j) : ∀ m, L m) * Pi.single m_j 1 = Pi.single m_j 1 := by
          ext m
          by_cases hm : m = m_j
          · subst hm; simp
          · simp [hm]
        have hmul : q_j (Pi.single m_j 1) * (q_j (Pi.single m_j 1) - 1) = 0 := by
          rw [mul_sub, mul_one, ← map_mul, hsq, sub_self]
        rcases mul_eq_zero.mp hmul with h0 | h1
        · exact absurd h0 hm_j
        · exact sub_eq_zero.mp h1
      let τ_j : L m_j →ₐ[K₁] F_fac j :=
        { toFun := fun a => q_j (Pi.single m_j a)
          map_one' := h_idem1
          map_mul' := fun a b => by
            rw [← map_mul]
            congr 1
            ext m
            by_cases hm : m = m_j
            · subst hm; simp
            · simp [hm]
          map_zero' := by rw [Pi.single_zero, map_zero]
          map_add' := fun a b => by rw [Pi.single_add, map_add]
          commutes' := fun c => by
            have hsc : (Pi.single m_j (algebraMap K₁ (L m_j) c) : ∀ m, L m) =
                algebraMap K₁ (∀ m, L m) c * Pi.single m_j 1 := by
              ext m
              by_cases hm : m = m_j
              · subst hm; simp
              · simp [hm]
            rw [hsc, map_mul, AlgHom.commutes, h_idem1, mul_one] }
      have hqj_eq : ∀ x : ∀ m, L m, q_j x = τ_j (x m_j) := by
        intro x
        have hx : x * Pi.single m_j 1 = Pi.single m_j (x m_j) := by
          ext m
          by_cases hm : m = m_j
          · subst hm; simp
          · simp [hm]
        calc
          q_j x = q_j x * 1 := (mul_one _).symm
          _ = q_j x * q_j (Pi.single m_j 1) := by rw [h_idem1]
          _ = q_j (x * Pi.single m_j 1) := (map_mul q_j _ _).symm
          _ = τ_j (x m_j) := by rw [hx]; rfl
      let incR_N : N →+* TensorProduct K K₁ N :=
        (Algebra.TensorProduct.includeRight : N →ₐ[K] TensorProduct K K₁ N).toRingHom
      let ν_j : N →+* F_fac j := proj_j.toRingHom.comp incR_N
      let _ : Algebra N (F_fac j) := ν_j.toAlgebra
      have hp₀_dvd : p₀ ∣ g := dvd_mul_right p₀ _
      have hp₀_splits : (p₀.map (algebraMap E N)).Splits :=
        hg_splits.of_dvd hg_map_ne (Polynomial.map_dvd (algebraMap E N) hp₀_dvd)
      let P_N : Polynomial N := (minpoly K α₀).map (algebraMap K N)
      have hPN_eq : P_N = p₀.map (algebraMap E N) := by
        dsimp [P_N, p₀]
        rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq K E N]
      have hPN_monic : P_N.Monic := (minpoly.monic (Algebra.IsIntegral.isIntegral α₀)).map _
      have hPN_splits : P_N.Splits := hPN_eq.symm ▸ hp₀_splits
      let z_j : F_fac j := proj_j (α₀ ⊗ₜ[K] (1 : N))
      have hz_root : Polynomial.aeval z_j P_N = 0 := by
        let φ_K₁ : K₁ →+* F_fac j :=
          proj_j.toRingHom.comp Algebra.TensorProduct.includeLeftRingHom
        have hcomm_K : (algebraMap N (F_fac j)).comp (algebraMap K N) =
            φ_K₁.comp (algebraMap K K₁) := by
          ext c
          change proj_j ((1 : K₁) ⊗ₜ[K] algebraMap K N c) =
            proj_j (algebraMap K K₁ c ⊗ₜ[K] (1 : N))
          have htmul : ((1 : K₁) ⊗ₜ[K] algebraMap K N c : TensorProduct K K₁ N) =
              algebraMap K K₁ c ⊗ₜ[K] (1 : N) := by
            calc
              (1 : K₁) ⊗ₜ[K] algebraMap K N c
                = (1 : K₁) ⊗ₜ[K] (c • (1 : N)) := by rw [Algebra.algebraMap_eq_smul_one]
              _ = (c • (1 : K₁)) ⊗ₜ[K] (1 : N) := (TensorProduct.smul_tmul c (1 : K₁) (1 : N)).symm
              _ = algebraMap K K₁ c ⊗ₜ[K] (1 : N) := by rw [Algebra.algebraMap_eq_smul_one]
          rw [htmul]
        rw [Polynomial.aeval_def, Polynomial.eval₂_map, hcomm_K, ← Polynomial.eval₂_map]
        have h_eval_α₀ : Polynomial.eval₂ φ_K₁ z_j ((minpoly K α₀).map (algebraMap K K₁)) =
            φ_K₁ (Polynomial.aeval α₀ (minpoly K α₀)) := by
          change Polynomial.eval₂ φ_K₁ (φ_K₁ α₀) ((minpoly K α₀).map (algebraMap K K₁)) = _
          rw [Polynomial.eval₂_map, ← Polynomial.hom_eval₂]
          rfl
        rw [h_eval_α₀, minpoly.aeval, map_zero]
      have hz_int : IsIntegral N z_j := ⟨P_N, hPN_monic, hz_root⟩
      have hmin_splits : (minpoly N z_j).Splits :=
        hPN_splits.of_dvd hPN_monic.ne_zero (minpoly.dvd N z_j hz_root)
      have hmin_deg_ne : (minpoly N z_j).degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree (minpoly.ne_zero hz_int)]
        exact Nat.cast_ne_zero.mpr (Nat.ne_of_gt (minpoly.natDegree_pos hz_int))
      obtain ⟨c₀, hc₀⟩ := hmin_splits.exists_eval_eq_zero hmin_deg_ne
      obtain ⟨h_fac, hh_fac⟩ := Polynomial.dvd_iff_isRoot.mpr hc₀
      have hX_not_unit : ¬ IsUnit (Polynomial.X - Polynomial.C c₀) :=
        Polynomial.not_isUnit_of_natDegree_pos _ (by simp)
      have hh_unit : IsUnit h_fac := by
        rcases (minpoly.irreducible hz_int).isUnit_or_isUnit hh_fac with hu | hu
        · exact absurd hu hX_not_unit
        · exact hu
      have hz_in_range : z_j ∈ ν_j.range := by
        have haeval_min := minpoly.aeval N z_j
        rw [hh_fac, map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C] at haeval_min
        have haeval_unit : IsUnit (Polynomial.aeval z_j h_fac) := hh_unit.map (Polynomial.aeval z_j)
        rcases mul_eq_zero.mp haeval_min with hsub0 | hunit0
        · exact ⟨c₀, (sub_eq_zero.mp hsub0).symm⟩
        · exact absurd hunit0 haeval_unit.ne_zero
      have hK₁_in_range : ∀ x : K₁, proj_j (x ⊗ₜ[K] (1 : N)) ∈ ν_j.range := by
        intro x
        have hx_top : x ∈ Algebra.adjoin K ({α₀} : Set K₁) := by rw [hAdj_α₀]; exact Algebra.mem_top
        let φ_left : K₁ →+* F_fac j :=
          proj_j.toRingHom.comp Algebra.TensorProduct.includeLeftRingHom
        change φ_left x ∈ ν_j.range
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hx_top
        · intro y hy
          rcases Set.mem_singleton_iff.mp hy with rfl
          exact hz_in_range
        · intro c
          refine ⟨algebraMap K N c, ?_⟩
          change proj_j ((1 : K₁) ⊗ₜ[K] algebraMap K N c) =
            proj_j (algebraMap K K₁ c ⊗ₜ[K] (1 : N))
          have htmul : ((1 : K₁) ⊗ₜ[K] algebraMap K N c : TensorProduct K K₁ N) =
              algebraMap K K₁ c ⊗ₜ[K] (1 : N) := by
            calc
              (1 : K₁) ⊗ₜ[K] algebraMap K N c
                = (1 : K₁) ⊗ₜ[K] (c • (1 : N)) := by rw [Algebra.algebraMap_eq_smul_one]
              _ = (c • (1 : K₁)) ⊗ₜ[K] (1 : N) := (TensorProduct.smul_tmul c (1 : K₁) (1 : N)).symm
              _ = algebraMap K K₁ c ⊗ₜ[K] (1 : N) := by rw [Algebra.algebraMap_eq_smul_one]
          rw [htmul]
        · intro x₁ x₂ _ _ hx₁ hx₂
          rw [map_add]
          exact ν_j.range.add_mem hx₁ hx₂
        · intro x₁ x₂ _ _ hx₁ hx₂
          rw [map_mul]
          exact ν_j.range.mul_mem hx₁ hx₂
      have hAll_in_range : ∀ u : TensorProduct K K₁ N, proj_j u ∈ ν_j.range := by
        intro u
        induction u using TensorProduct.induction_on with
        | zero =>
          rw [map_zero]; exact ν_j.range.zero_mem
        | tmul x y =>
          have hmul : (x ⊗ₜ[K] y : TensorProduct K K₁ N) = (x ⊗ₜ[K] 1) * (1 ⊗ₜ[K] y) := by
            simp
          rw [hmul, map_mul]
          exact ν_j.range.mul_mem (hK₁_in_range x) ⟨y, rfl⟩
        | add u₁ u₂ hu₁ hu₂ =>
          rw [map_add]
          exact ν_j.range.add_mem hu₁ hu₂
      have hν_surj : Function.Surjective ν_j := by
        intro w
        obtain ⟨u, rfl⟩ := hproj_surj w
        exact hAll_in_range u
      let e_ν : N ≃+* F_fac j := RingEquiv.ofBijective ν_j ⟨ν_j.injective, hν_surj⟩
      let _ : Algebra E (L m_j) := algEL m_j
      let _ : Algebra E (E' m_j) := algEE' m_j
      let τ_tilde : L m_j →ₐ[E] N :=
        { toRingHom := e_ν.symm.toRingHom.comp τ_j.toRingHom
          commutes' := fun e => by
            apply e_ν.injective
            change e_ν (e_ν.symm (τ_j (e_E ((1 : K₁) ⊗ₜ[K] e) m_j))) = e_ν (ι_EN e)
            rw [e_ν.apply_symm_apply, ← hqj_eq]
            dsimp [q_j]
            rw [AlgEquiv.symm_apply_apply]
            rfl }
      let ρ_E : L m_j →ₐ[E] E' m_j :=
        { toRingHom := (ρ m_j).toRingHom
          commutes' := fun _ => rfl }
      let ψ_emb : L m_j →ₐ[E] N := (ι_E' m_j).comp ρ_E
      let M_sub : IntermediateField E N := ψ_emb.fieldRange
      let e_sub : L m_j ≃ₐ[E] ↥M_sub := AlgEquiv.ofInjectiveField ψ_emb
      let Φ_j : N →ₐ[E] N := (τ_tilde.comp e_sub.symm.toAlgHom).liftNormal N
      have hΦ_comm : ∀ a : L m_j, Φ_j (ψ_emb a) = τ_tilde a := by
        intro a
        have heq_sub : (algebraMap ↥M_sub N) (e_sub a) = ψ_emb a := rfl
        rw [← heq_sub, AlgHom.liftNormal_commutes]
        change τ_tilde (e_sub.symm (e_sub a)) = τ_tilde a
        rw [e_sub.symm_apply_apply]
      let σ_ring : E' m_j →+* F_fac j :=
        e_ν.toRingHom.comp (Φ_j.comp (ι_E' m_j)).toRingHom
      have hσ_ρ : ∀ a : L m_j, σ_ring (ρ m_j a) = τ_j a := by
        intro a
        change e_ν (Φ_j (ψ_emb a)) = τ_j a
        rw [hΦ_comm a]
        exact e_ν.apply_symm_apply (τ_j a)
      let σ_j : E' m_j →ₐ[K₁] F_fac j :=
        { toRingHom := σ_ring
          commutes' := fun c => by
            change σ_ring (algebraMap K₁ (E' m_j) c) = algebraMap K₁ (F_fac j) c
            rw [← (ρ m_j).commutes c, hσ_ρ, τ_j.commutes] }
      refine ⟨m_j, σ_j, ?_⟩
      ext u
      change σ_ring (ρ m_j (e_E u m_j)) =
        (proj_j.comp (Algebra.TensorProduct.map (AlgHom.id K₁ K₁) ι_EN)) u
      rw [hσ_ρ, ← hqj_eq]
      dsimp [q_j]
      rw [AlgEquiv.symm_apply_apply]
    choose m_idx σ hσ_comm using hFactorJ
    exact ⟨N, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      ι_EN, r, F_fac, inferInstance, inferInstance, inferInstance, e_N, m_idx, σ, hσ_comm⟩

  let S_K : Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of K)
  let S₁ : Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of K₁)
  let π : S₁ ⟶ S_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁))
  let B₁ := weilAltCdSitePullback π
  let π_push :=
    @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      B₁ AddCommGrpCat.{u} _ S_K.smallEtaleTopology S₁.smallEtaleTopology hContB

  have hPresheafComp : ∀ {S : Scheme.{u}} (P : S.Etaleᵒᵖ ⥤ AddCommGrpCat.{u})
      {U₁ U₂ U₃ : S.Etale} (f : U₁ ⟶ U₂) (g : U₂ ⟶ U₃)
      (z : ↥(P.obj (Opposite.op U₃))),
      (P.map (Opposite.op f)).hom ((P.map (Opposite.op g)).hom z) =
        (P.map (Opposite.op (f ≫ g))).hom z := by
    intro S P U₁ U₂ U₃ f g z
    exact (congrArg (fun h => h.hom z) (P.map_comp (Opposite.op g) (Opposite.op f))).symm

  have hIsoTensor : ∀ (E : Type u) [Field E] [Algebra K E] [Algebra.Etale K E],
      have _ : Algebra.Etale K₁ (TensorProduct K K₁ E) := Algebra.Etale.baseChange K E K₁
      ∃ e_T : B₁.obj (weilAltCdSpecEtaleObj K E) ≅
          weilAltCdSpecEtaleObj K₁ (TensorProduct K K₁ E),
        e_T.hom.left = (AlgebraicGeometry.pullbackSpecIso K E K₁).hom ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.comm K K₁ E).toRingHom) ∧
        e_T.inv.left = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.comm K K₁ E).symm.toRingHom) ≫
          (AlgebraicGeometry.pullbackSpecIso K E K₁).inv := by
    intro E _ _ _
    have _ : Algebra.Etale K₁ (TensorProduct K K₁ E) := Algebra.Etale.baseChange K E K₁
    let r_equiv : TensorProduct K K₁ E ≃+* TensorProduct K E K₁ :=
      (Algebra.TensorProduct.comm K K₁ E).toRingEquiv
    let c_ring_iso : CommRingCat.of (TensorProduct K K₁ E) ≅ CommRingCat.of (TensorProduct K E K₁) :=
      { hom := CommRingCat.ofHom r_equiv.toRingHom
        inv := CommRingCat.ofHom r_equiv.symm.toRingHom
        hom_inv_id := CommRingCat.hom_ext (RingHom.ext r_equiv.symm_apply_apply)
        inv_hom_id := CommRingCat.hom_ext (RingHom.ext r_equiv.apply_symm_apply) }
    let iso_left : (B₁.obj (weilAltCdSpecEtaleObj K E)).left ≅
        (weilAltCdSpecEtaleObj K₁ (TensorProduct K K₁ E)).left :=
      (AlgebraicGeometry.pullbackSpecIso K E K₁).trans
        { hom := AlgebraicGeometry.Spec.map c_ring_iso.hom
          inv := AlgebraicGeometry.Spec.map c_ring_iso.inv
          hom_inv_id := (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
            ((congrArg AlgebraicGeometry.Spec.map c_ring_iso.inv_hom_id).trans
              (AlgebraicGeometry.Spec.map_id _))
          inv_hom_id := (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
            ((congrArg AlgebraicGeometry.Spec.map c_ring_iso.hom_inv_id).trans
              (AlgebraicGeometry.Spec.map_id _)) }
    have hw_iso : iso_left.hom ≫ (weilAltCdSpecEtaleObj K₁ (TensorProduct K K₁ E)).hom =
        (B₁.obj (weilAltCdSpecEtaleObj K E)).hom := by
      change ((AlgebraicGeometry.pullbackSpecIso K E K₁).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom r_equiv.toRingHom)) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap K₁ (TensorProduct K K₁ E))) =
        Limits.pullback.snd _ _
      rw [Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      have h_inc : CommRingCat.ofHom (algebraMap K₁ (TensorProduct K K₁ E)) ≫
          CommRingCat.ofHom r_equiv.toRingHom =
          CommRingCat.ofHom
            (↑(Algebra.TensorProduct.includeRight : K₁ →ₐ[K] TensorProduct K E K₁) :
              K₁ →+* TensorProduct K E K₁) := by
        ext x
        rfl
      exact (congrArg (fun φ => (AlgebraicGeometry.pullbackSpecIso K E K₁).hom ≫
        AlgebraicGeometry.Spec.map φ) h_inc).trans
        (AlgebraicGeometry.pullbackSpecIso_hom_snd K E K₁)
    exact ⟨MorphismProperty.Over.isoMk iso_left hw_iso, rfl, rfl⟩

  have _ : π_push.PreservesEpimorphisms := by
    refine ⟨fun {𝒢₁ 𝒢₂} α hEpi => ?_⟩
    have _ : Sheaf.IsLocallySurjective α :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} α).mpr hEpi
    have _ : Presheaf.IsLocallySurjective S_K.smallEtaleTopology (π_push.map α).hom := by
      refine Presheaf.IsLocallySurjective.mk (fun {U} y => ?_)
      refine hMemSmallEtale K U (Presheaf.imageSieve (π_push.map α).hom y) (fun u₀ => ?_)
      obtain ⟨E, hFieldE, hAlgE, hFinE, hSepE, hEtE, j_E, p_E, hp_E⟩ :=
        hPointFieldChart K U u₀
      let _ : Field E := hFieldE
      let _ : Algebra K E := hAlgE
      have _ : FiniteDimensional K E := hFinE
      have _ : Algebra.IsSeparable K E := hSepE
      have _ : Algebra.Etale K E := hEtE
      have _ : Algebra.Etale K₁ (TensorProduct K K₁ E) := Algebra.Etale.baseChange K E K₁
      obtain ⟨e_TE, he_TE, he_TE_inv⟩ := hIsoTensor E
      let y_E : ↥(𝒢₂.obj.obj
          (Opposite.op (weilAltCdSpecEtaleObj K₁ (TensorProduct K K₁ E)))) :=
        (𝒢₂.obj.map (Opposite.op (e_TE.inv ≫ B₁.map j_E))).hom y
      obtain ⟨I_E, _, Li_raw, hFieldLi, hAlgLi, e_E_raw, hModLi⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K₁ (TensorProduct K K₁ E)).mp inferInstance
      let _ : ∀ i, Field (Li_raw i) := hFieldLi
      let _ : ∀ i, Algebra K₁ (Li_raw i) := hAlgLi
      let _ : Fintype I_E := Fintype.ofFinite I_E
      set k := Fintype.card I_E
      let e_finE : I_E ≃ Fin k := Fintype.equivFin I_E
      let L : Fin k → Type u := fun m => Li_raw (e_finE.symm m)
      let _ : ∀ m, Field (L m) := fun m => hFieldLi (e_finE.symm m)
      let _ : ∀ m, Algebra K₁ (L m) := fun m => hAlgLi (e_finE.symm m)
      have _ : ∀ m, FiniteDimensional K₁ (L m) := by
        intro m
        have _ : Module.Finite K₁ (L m) := (hModLi (e_finE.symm m)).1
        exact inferInstance
      have _ : ∀ m, Algebra.IsSeparable K₁ (L m) := fun m => (hModLi (e_finE.symm m)).2
      have _ : ∀ m, Algebra.Etale K₁ (L m) := fun m => hFieldEt K₁ (L m)
      let e_E : TensorProduct K K₁ E ≃ₐ[K₁] (∀ m : Fin k, L m) :=
        e_E_raw.trans (AlgEquiv.piCongrLeft' K₁ Li_raw e_finE)
      have hLocalLift : ∀ m : Fin k,
          ∃ (E'_m : Type u) (_ : Field E'_m) (_ : Algebra K₁ E'_m)
            (_ : FiniteDimensional K₁ E'_m) (_ : Algebra.IsSeparable K₁ E'_m)
            (_ : Algebra.Etale K₁ E'_m)
            (ρ_m : L m →ₐ[K₁] E'_m)
            (x'_m : ↥(𝒢₁.obj.obj (Opposite.op (weilAltCdSpecEtaleObj K₁ E'_m)))),
            (α.hom.app (Opposite.op (weilAltCdSpecEtaleObj K₁ E'_m))).hom x'_m =
              (𝒢₂.obj.map (Opposite.op (weilAltCdSpecEtaleMap K₁ ρ_m))).hom
                ((𝒢₂.obj.map (Opposite.op
                  (weilAltCdSpecEtaleMap K₁ ((Pi.evalAlgHom K₁ L m).comp e_E.toAlgHom)))).hom
                  y_E) := by
        intro m
        let y_m := (𝒢₂.obj.map (Opposite.op
          (weilAltCdSpecEtaleMap K₁ ((Pi.evalAlgHom K₁ L m).comp e_E.toAlgHom)))).hom y_E
        have hImgMem : Presheaf.imageSieve α.hom y_m ∈
            S₁.smallEtaleTopology (weilAltCdSpecEtaleObj K₁ (L m)) :=
          Presheaf.imageSieve_mem S₁.smallEtaleTopology α.hom y_m
        obtain ⟨E'_m, hFE', hAE', hFinE', hSepE', hEtE', ρ_m, x'_m, hx'_m⟩ :=
          hSieveFieldRefine K₁ (L m) (Presheaf.imageSieve α.hom y_m) hImgMem
        exact ⟨E'_m, hFE', hAE', hFinE', hSepE', hEtE', ρ_m, x'_m, hx'_m⟩
      choose E' hFE' hAE' hFinE' hSepE' hEtE' ρ x' hx' using hLocalLift
      let _ : ∀ m, Field (E' m) := hFE'
      let _ : ∀ m, Algebra K₁ (E' m) := hAE'
      have _ : ∀ m, FiniteDimensional K₁ (E' m) := hFinE'
      have _ : ∀ m, Algebra.IsSeparable K₁ (E' m) := hSepE'
      have _ : ∀ m, Algebra.Etale K₁ (E' m) := hEtE'
      obtain ⟨N, hFN, hAN, hFinN, hSepN, hEtN, ι_EN, r, F_fac, hFF, hAF, hEtF,
          e_N, m_idx, σ, hσ_comm⟩ :=
        hSplittingFactor E k L e_E E' ρ
      let _ : Field N := hFN
      let _ : Algebra K N := hAN
      have _ : FiniteDimensional K N := hFinN
      have _ : Algebra.IsSeparable K N := hSepN
      have _ : Algebra.Etale K N := hEtN
      let _ : ∀ j, Field (F_fac j) := hFF
      let _ : ∀ j, Algebra K₁ (F_fac j) := hAF
      have _ : ∀ j, Algebra.Etale K₁ (F_fac j) := hEtF
      have _ : Algebra.Etale K₁ (TensorProduct K K₁ N) := Algebra.Etale.baseChange K N K₁
      let map_EN : TensorProduct K K₁ E →ₐ[K₁] TensorProduct K K₁ N :=
        Algebra.TensorProduct.map (AlgHom.id K₁ K₁) ι_EN
      let y_N : ↥(𝒢₂.obj.obj
          (Opposite.op (weilAltCdSpecEtaleObj K₁ (TensorProduct K K₁ N)))) :=
        (𝒢₂.obj.map (Opposite.op (weilAltCdSpecEtaleMap K₁ map_EN))).hom y_E
      have hSpecMapComp : ∀ {A₁ A₂ A₃ : Type u} [CommRing A₁] [CommRing A₂] [CommRing A₃]
          [Algebra K₁ A₁] [Algebra K₁ A₂] [Algebra K₁ A₃]
          [Algebra.Etale K₁ A₁] [Algebra.Etale K₁ A₂] [Algebra.Etale K₁ A₃]
          (f₁ : A₁ →ₐ[K₁] A₂) (f₂ : A₂ →ₐ[K₁] A₃),
          weilAltCdSpecEtaleMap K₁ (f₂.comp f₁) =
            weilAltCdSpecEtaleMap K₁ f₂ ≫ weilAltCdSpecEtaleMap K₁ f₁ := by
        intro A₁ A₂ A₃ _ _ _ _ _ _ _ _ _ f₁ f₂
        apply MorphismProperty.Over.Hom.ext
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (f₂.toRingHom.comp f₁.toRingHom)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₂.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁.toRingHom)
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
      have hLiftN : ∀ j : Fin r,
          ∃ x''_j : ↥(𝒢₁.obj.obj (Opposite.op (weilAltCdSpecEtaleObj K₁ (F_fac j)))),
            (α.hom.app (Opposite.op (weilAltCdSpecEtaleObj K₁ (F_fac j)))).hom x''_j =
              (𝒢₂.obj.map (Opposite.op
                (weilAltCdSpecEtaleMap K₁ ((Pi.evalAlgHom K₁ F_fac j).comp e_N.toAlgHom)))).hom
                y_N := by
        intro j
        let u_σ := weilAltCdSpecEtaleMap K₁ (σ j)
        refine ⟨(𝒢₁.obj.map (Opposite.op u_σ)).hom (x' (m_idx j)), ?_⟩
        have hnat : (α.hom.app (Opposite.op (weilAltCdSpecEtaleObj K₁ (F_fac j)))).hom
            ((𝒢₁.obj.map (Opposite.op u_σ)).hom (x' (m_idx j))) =
            (𝒢₂.obj.map (Opposite.op u_σ)).hom
              ((α.hom.app (Opposite.op (weilAltCdSpecEtaleObj K₁ (E' (m_idx j))))).hom
                (x' (m_idx j))) :=
          congrArg (fun f => f.hom (x' (m_idx j))) (α.hom.naturality (Opposite.op u_σ))
        have h1 : (𝒢₂.obj.map (Opposite.op u_σ)).hom
            ((𝒢₂.obj.map (Opposite.op (weilAltCdSpecEtaleMap K₁ (ρ (m_idx j))))).hom
              ((𝒢₂.obj.map (Opposite.op
                (weilAltCdSpecEtaleMap K₁
                  ((Pi.evalAlgHom K₁ L (m_idx j)).comp e_E.toAlgHom)))).hom y_E)) =
            (𝒢₂.obj.map (Opposite.op
              (weilAltCdSpecEtaleMap K₁
                (((σ j).comp (ρ (m_idx j))).comp
                  ((Pi.evalAlgHom K₁ L (m_idx j)).comp e_E.toAlgHom))))).hom y_E := by
          refine (hPresheafComp 𝒢₂.obj u_σ _ _).trans
            ((hPresheafComp 𝒢₂.obj _ _ y_E).trans ?_)
          refine congrArg (fun u => (𝒢₂.obj.map (Opposite.op u)).hom y_E) ?_
          exact (congrArg (· ≫ _) (hSpecMapComp (ρ (m_idx j)) (σ j)).symm).trans
            (hSpecMapComp _ _).symm
        have h2 : (𝒢₂.obj.map (Opposite.op
            (weilAltCdSpecEtaleMap K₁ ((Pi.evalAlgHom K₁ F_fac j).comp e_N.toAlgHom)))).hom y_N =
            (𝒢₂.obj.map (Opposite.op
              (weilAltCdSpecEtaleMap K₁
                (((Pi.evalAlgHom K₁ F_fac j).comp e_N.toAlgHom).comp map_EN)))).hom y_E := by
          refine (hPresheafComp 𝒢₂.obj _ _ y_E).trans ?_
          exact congrArg (fun u => (𝒢₂.obj.map (Opposite.op u)).hom y_E)
            (hSpecMapComp map_EN ((Pi.evalAlgHom K₁ F_fac j).comp e_N.toAlgHom)).symm
        exact (hnat.trans (congrArg _ (hx' (m_idx j)))).trans
          (h1.trans
            ((congrArg
              (fun φ => (𝒢₂.obj.map (Opposite.op (weilAltCdSpecEtaleMap K₁ φ))).hom y_E)
              (hσ_comm j)).trans h2.symm))
      obtain ⟨x_N, hx_N⟩ :=
        hPiFieldSheafLift K₁ r F_fac (TensorProduct K K₁ N) e_N 𝒢₁ 𝒢₂ α y_N hLiftN
      obtain ⟨e_TN, he_TN, _⟩ := hIsoTensor N
      let u_comp : B₁.obj (weilAltCdSpecEtaleObj K N) ⟶ B₁.obj (weilAltCdSpecEtaleObj K E) :=
        e_TN.hom ≫ weilAltCdSpecEtaleMap K₁ map_EN ≫ e_TE.inv
      let v_comp : B₁.obj (weilAltCdSpecEtaleObj K N) ⟶ B₁.obj (weilAltCdSpecEtaleObj K E) :=
        B₁.map (weilAltCdSpecEtaleMap K ι_EN)
      have hNatIso : u_comp = v_comp := by
        apply MorphismProperty.Over.Hom.ext
        apply Limits.pullback.hom_ext
        · let r_EN := CommRingCat.ofHom map_EN.toRingHom
          let r_N := CommRingCat.ofHom (Algebra.TensorProduct.comm K K₁ N).toRingHom
          let r_E_inv := CommRingCat.ofHom (Algebra.TensorProduct.comm K K₁ E).symm.toRingHom
          let r_incE := CommRingCat.ofHom
            (Algebra.TensorProduct.includeLeftRingHom : E →+* TensorProduct K E K₁)
          let r_incN := CommRingCat.ofHom
            (Algebra.TensorProduct.includeLeftRingHom : N →+* TensorProduct K N K₁)
          let r_ι := CommRingCat.ofHom ι_EN.toRingHom
          let f_EN := AlgebraicGeometry.Spec.map r_EN
          let c_N := AlgebraicGeometry.Spec.map r_N
          let c_E_inv := AlgebraicGeometry.Spec.map r_E_inv
          let fst_E := Limits.pullback.fst
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E))) π
          let fst_N := Limits.pullback.fst
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K N))) π
          have hring_fst : ((r_incE ≫ r_E_inv) ≫ r_EN) ≫ r_N = r_ι ≫ r_incN := by
            ext x
            rfl
          let p_hom_N := (AlgebraicGeometry.pullbackSpecIso K N K₁).hom
          let p_inv_E := (AlgebraicGeometry.pullbackSpecIso K E K₁).inv
          have h_sch_fst :
              ((p_hom_N ≫ c_N) ≫ f_EN ≫ c_E_inv ≫ p_inv_E) ≫ fst_E =
              fst_N ≫ AlgebraicGeometry.Spec.map r_ι :=
            calc
              ((p_hom_N ≫ c_N) ≫ f_EN ≫ c_E_inv ≫ p_inv_E) ≫ fst_E
                = p_hom_N ≫ c_N ≫ f_EN ≫ c_E_inv ≫ (p_inv_E ≫ fst_E) := by
                  simp only [Category.assoc]
              _ = p_hom_N ≫ c_N ≫ f_EN ≫ (c_E_inv ≫ AlgebraicGeometry.Spec.map r_incE) :=
                  congrArg (fun g => p_hom_N ≫ c_N ≫ f_EN ≫ c_E_inv ≫ g)
                    (AlgebraicGeometry.pullbackSpecIso_inv_fst K E K₁)
              _ = p_hom_N ≫ c_N ≫ (f_EN ≫ AlgebraicGeometry.Spec.map (r_incE ≫ r_E_inv)) :=
                  congrArg (fun g => p_hom_N ≫ c_N ≫ f_EN ≫ g)
                    (AlgebraicGeometry.Spec.map_comp r_incE r_E_inv).symm
              _ = p_hom_N ≫ (c_N ≫ AlgebraicGeometry.Spec.map ((r_incE ≫ r_E_inv) ≫ r_EN)) :=
                  congrArg (fun g => p_hom_N ≫ c_N ≫ g)
                    (AlgebraicGeometry.Spec.map_comp (r_incE ≫ r_E_inv) r_EN).symm
              _ = p_hom_N ≫ AlgebraicGeometry.Spec.map (((r_incE ≫ r_E_inv) ≫ r_EN) ≫ r_N) :=
                  congrArg (fun g => p_hom_N ≫ g)
                    (AlgebraicGeometry.Spec.map_comp ((r_incE ≫ r_E_inv) ≫ r_EN) r_N).symm
              _ = p_hom_N ≫ AlgebraicGeometry.Spec.map (r_ι ≫ r_incN) :=
                  congrArg (fun φ => p_hom_N ≫ AlgebraicGeometry.Spec.map φ) hring_fst
              _ = p_hom_N ≫ (AlgebraicGeometry.Spec.map r_incN ≫ AlgebraicGeometry.Spec.map r_ι) :=
                  congrArg (fun g => p_hom_N ≫ g)
                    (AlgebraicGeometry.Spec.map_comp r_ι r_incN)
              _ = (p_hom_N ≫ AlgebraicGeometry.Spec.map r_incN) ≫ AlgebraicGeometry.Spec.map r_ι :=
                  (Category.assoc p_hom_N (AlgebraicGeometry.Spec.map r_incN)
                    (AlgebraicGeometry.Spec.map r_ι)).symm
              _ = fst_N ≫ AlgebraicGeometry.Spec.map r_ι :=
                  congrArg (· ≫ AlgebraicGeometry.Spec.map r_ι)
                    (AlgebraicGeometry.pullbackSpecIso_hom_fst K N K₁)
          have h_u_eq :
              u_comp.left ≫ Limits.pullback.fst (weilAltCdSpecEtaleObj K E).hom π =
              ((p_hom_N ≫ c_N) ≫ f_EN ≫ c_E_inv ≫ p_inv_E) ≫ fst_E :=
            (congrArg (fun a => (a ≫ f_EN ≫ e_TE.inv.left) ≫ fst_E) he_TN).trans
              (congrArg (fun b => ((p_hom_N ≫ c_N) ≫ f_EN ≫ b) ≫ fst_E) he_TE_inv)
          have h_lhs_fst :
              u_comp.left ≫ Limits.pullback.fst (weilAltCdSpecEtaleObj K E).hom π =
              Limits.pullback.fst (weilAltCdSpecEtaleObj K N).hom π ≫
                (weilAltCdSpecEtaleMap K ι_EN).left :=
            h_u_eq.trans h_sch_fst
          have h_rhs_fst :
              v_comp.left ≫ Limits.pullback.fst (weilAltCdSpecEtaleObj K E).hom π =
              Limits.pullback.fst (weilAltCdSpecEtaleObj K N).hom π ≫
                (weilAltCdSpecEtaleMap K ι_EN).left := by
            have _ : MorphismProperty.HasPullbacksAlong (@Etale) π :=
              MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
            have _ : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) π :=
              MorphismProperty.IsStableUnderBaseChangeAlong.mk
                (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
            exact (congrArg (· ≫ Limits.pullback.fst _ _)
              (MorphismProperty.Over.pullback_map_left (@Etale) ⊤ π
                (weilAltCdSpecEtaleMap K ι_EN))).trans
              (Limits.pullback.lift_fst _ _ _)
          exact h_lhs_fst.trans h_rhs_fst.symm
        · exact (MorphismProperty.Over.w u_comp).trans (MorphismProperty.Over.w v_comp).symm
      let g_N : weilAltCdSpecEtaleObj K N ⟶ U := weilAltCdSpecEtaleMap K ι_EN ≫ j_E
      let p_N : ↥(weilAltCdSpecEtaleObj K N).left := (⊥ : PrimeSpectrum N)
      have hp_N : g_N.left.base p_N = u₀ := by
        change j_E.left.base ((weilAltCdSpecEtaleMap K ι_EN).left.base p_N) = u₀
        have hp_eq : (weilAltCdSpecEtaleMap K ι_EN).left.base p_N = p_E :=
          @Subsingleton.elim (PrimeSpectrum E) inferInstance _ _
        rw [hp_eq, hp_E]
      refine ⟨weilAltCdSpecEtaleObj K N, g_N, p_N, hp_N, ?_⟩
      refine ⟨(𝒢₁.obj.map (Opposite.op e_TN.hom)).hom x_N, ?_⟩
      change (α.hom.app (Opposite.op (B₁.obj (weilAltCdSpecEtaleObj K N)))).hom
          ((𝒢₁.obj.map (Opposite.op e_TN.hom)).hom x_N) =
        (𝒢₂.obj.map (Opposite.op (B₁.map g_N))).hom y
      have hnat_TN : (α.hom.app (Opposite.op (B₁.obj (weilAltCdSpecEtaleObj K N)))).hom
          ((𝒢₁.obj.map (Opposite.op e_TN.hom)).hom x_N) =
          (𝒢₂.obj.map (Opposite.op e_TN.hom)).hom
            ((α.hom.app (Opposite.op (weilAltCdSpecEtaleObj K₁ (TensorProduct K K₁ N)))).hom x_N) :=
        congrArg (fun f => f.hom x_N) (α.hom.naturality (Opposite.op e_TN.hom))
      refine (hnat_TN.trans (congrArg _ hx_N)).trans ?_
      refine (hPresheafComp 𝒢₂.obj e_TN.hom _ y_E).trans
        ((hPresheafComp 𝒢₂.obj _ _ y).trans ?_)
      refine congrArg (fun u => (𝒢₂.obj.map (Opposite.op u)).hom y) ?_
      exact (Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ B₁.map j_E) hNatIso).trans (B₁.map_comp _ _).symm)
    exact Sheaf.epi_of_isLocallySurjective (π_push.map α)

  have _ : Limits.PreservesLimitsOfSize.{0, 0} π_push := adj_sh.rightAdjoint_preservesLimits
  have _ : Limits.PreservesFiniteLimits π_push :=
    Limits.PreservesLimitsOfSize.preservesFiniteLimits π_push
  let _ : π_push.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products π_push
  have _ : Limits.PreservesFiniteColimits π_push := by
    rw [CategoryTheory.Functor.preservesFiniteColimits_iff_forall_exact_map_and_epi]
    intro S hS
    have _ : CategoryTheory.Epi S.g := hS.epi_g
    exact ⟨((CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono π_push).mp
      inferInstance S hS).1, inferInstance⟩
  have hPushInj : ∀ (I : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u})
      [CategoryTheory.Injective I], CategoryTheory.Injective (π_push.obj I) :=
    fun I _ => adj_sh.map_injective I inferInstance

  let Z_K := (CategoryTheory.constantSheaf S_K.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let Z_1 := (CategoryTheory.constantSheaf S₁.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))

  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le' hs
  clear hs
  change Subsingleton (CategoryTheory.Abelian.Ext.{u} Z_K (π_push.obj ℋ) (m + 1))
  change Subsingleton (CategoryTheory.Abelian.Ext.{u} Z_1 ℋ (m + 1)) at hSub
  revert ℋ hSub
  induction m with
  | zero =>
    intro ℋ hSub
    let I := CategoryTheory.Injective.under ℋ
    let ι : ℋ ⟶ I := CategoryTheory.Injective.ι ℋ
    let Q := Limits.cokernel ι
    let π_Q : I ⟶ Q := Limits.cokernel.π ι
    let S_D := ShortComplex.mk ι π_Q (Limits.cokernel.condition ι)
    have hSD : S_D.ShortExact :=
      ShortComplex.ShortExact.mk'
        (ShortComplex.exact_of_g_is_cokernel S_D (Limits.cokernelIsCokernel ι))
        inferInstance inferInstance
    have hSC : (S_D.map π_push).ShortExact := hSD.map_of_exact π_push
    have _ : CategoryTheory.Injective (S_D.map π_push).X₂ := hPushInj I
    refine subsingleton_of_forall_eq 0 (fun y => ?_)
    have hy_f : y.comp (Abelian.Ext.mk₀ (S_D.map π_push).f) (Nat.add_zero 1) = 0 :=
      Abelian.Ext.eq_zero_of_injective _
    obtain ⟨q₀, hq₀⟩ :=
      Abelian.Ext.covariant_sequence_exact₁ Z_K hSC y hy_f (Nat.zero_add 1)
    let f_C : Z_K ⟶ π_push.obj Q := Abelian.Ext.homEquiv₀ q₀
    have hq₀_mk : q₀ = Abelian.Ext.mk₀ f_C := by
      rw [← Abelian.Ext.homEquiv₀_symm_apply]
      exact (Abelian.Ext.homEquiv₀.symm_apply_apply q₀).symm
    let f_D : Z_1 ⟶ Q := eℤ.inv ≫ (adj_sh.homEquiv Z_K Q).symm f_C
    have hfD_ext : (Abelian.Ext.mk₀ f_D).comp hSD.extClass (Nat.zero_add 1) = 0 :=
      @Subsingleton.elim _ hSub _ 0
    obtain ⟨g₀, hg₀⟩ :=
      Abelian.Ext.covariant_sequence_exact₃ Z_1 hSD (Abelian.Ext.mk₀ f_D) (Nat.zero_add 1) hfD_ext
    let g_D : Z_1 ⟶ I := Abelian.Ext.homEquiv₀ g₀
    have hg₀_mk : g₀ = Abelian.Ext.mk₀ g_D := by
      rw [← Abelian.Ext.homEquiv₀_symm_apply]
      exact (Abelian.Ext.homEquiv₀.symm_apply_apply g₀).symm
    have hgD_comp : g_D ≫ π_Q = f_D := by
      rw [hg₀_mk, Abelian.Ext.mk₀_comp_mk₀] at hg₀
      exact Abelian.Ext.homEquiv₀.symm.injective
        ((Abelian.Ext.homEquiv₀_symm_apply _).trans
          (hg₀.trans (Abelian.Ext.homEquiv₀_symm_apply _).symm))
    let g_C : Z_K ⟶ π_push.obj I := (adj_sh.homEquiv Z_K I) (eℤ.hom ≫ g_D)
    have hgC_comp : g_C ≫ (S_D.map π_push).g = f_C := by
      change (adj_sh.homEquiv Z_K I) (eℤ.hom ≫ g_D) ≫ π_push.map π_Q = f_C
      rw [← adj_sh.homEquiv_naturality_right, Category.assoc, hgD_comp]
      dsimp [f_D]
      rw [← Category.assoc, eℤ.hom_inv_id, Category.id_comp, Equiv.apply_symm_apply]
    rw [← hq₀, hq₀_mk, ← hgC_comp, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ g_C) (Abelian.Ext.mk₀ (S_D.map π_push).g)
        hSC.extClass (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
      hSC.comp_extClass, Abelian.Ext.comp_zero]
  | succ k ih =>
    intro ℋ hSub
    let I := CategoryTheory.Injective.under ℋ
    let ι : ℋ ⟶ I := CategoryTheory.Injective.ι ℋ
    let Q := Limits.cokernel ι
    let π_Q : I ⟶ Q := Limits.cokernel.π ι
    let S_D := ShortComplex.mk ι π_Q (Limits.cokernel.condition ι)
    have hSD : S_D.ShortExact :=
      ShortComplex.ShortExact.mk'
        (ShortComplex.exact_of_g_is_cokernel S_D (Limits.cokernelIsCokernel ι))
        inferInstance inferInstance
    have hSC : (S_D.map π_push).ShortExact := hSD.map_of_exact π_push
    have _ : CategoryTheory.Injective (S_D.map π_push).X₂ := hPushInj I
    have hSubQ : Subsingleton (CategoryTheory.Abelian.Ext.{u} Z_1 Q (k + 1)) := by
      refine subsingleton_of_forall_eq 0 (fun x => ?_)
      have hx_ext : x.comp hSD.extClass rfl = 0 := @Subsingleton.elim _ hSub _ 0
      obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₃ Z_1 hSD x rfl hx_ext
      have hz0 : z = 0 := Abelian.Ext.eq_zero_of_injective z
      rw [← hz, hz0, Abelian.Ext.zero_comp]
    have hSubRQ : Subsingleton (CategoryTheory.Abelian.Ext.{u} Z_K (π_push.obj Q) (k + 1)) :=
      ih Q hSubQ
    refine subsingleton_of_forall_eq 0 (fun y => ?_)
    have hy_f : y.comp (Abelian.Ext.mk₀ (S_D.map π_push).f) (Nat.add_zero (k + 1 + 1)) = 0 :=
      Abelian.Ext.eq_zero_of_injective _
    obtain ⟨q_C, hq_C⟩ :=
      Abelian.Ext.covariant_sequence_exact₁ Z_K hSC y hy_f rfl
    have hq0 : q_C = 0 := @Subsingleton.elim _ hSubRQ q_C 0
    rw [← hq_C, hq0, Abelian.Ext.zero_comp]

theorem weil_alt_cd_galois_sheet_sum_trace_retraction (K K₁ M : Type u) [Field K] [Field K₁]
    [Field M] [Algebra K K₁] [Algebra K M] [Algebra K₁ M] [IsScalarTower K K₁ M]
    [FiniteDimensional K M] [IsGalois K M]
    (hEt₁ : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁))))
    (hEtM : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K M))))
    (hContF : (weilAltCdFieldEtaleMap hEt₁).IsContinuous
      (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology
      (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology)
    (hContB : (weilAltCdSitePullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁)))).IsContinuous
      (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology
      (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology)
    (adj_site : weilAltCdFieldEtaleMap hEt₁ ⊣
      weilAltCdSitePullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁))))
    (ℱ : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}) :
    ∃ tr_π :
        (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilAltCdSitePullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁))))
          AddCommGrpCat.{u} _
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology hContB).obj
        ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilAltCdFieldEtaleMap hEt₁) AddCommGrpCat.{u} _
          (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology hContF).obj ℱ) ⟶ ℱ,
      ∀ (η_ℱ : ℱ ⟶
          (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilAltCdSitePullback
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁))))
            AddCommGrpCat.{u} _
            (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology
            (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology hContB).obj
          ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilAltCdFieldEtaleMap hEt₁) AddCommGrpCat.{u} _
            (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology
            (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology hContF).obj ℱ)),
        (∀ U : (AlgebraicGeometry.Spec (CommRingCat.of K)).Etale,
          η_ℱ.hom.app (Opposite.op U) = ℱ.obj.map (Opposite.op (adj_site.counit.app U))) →
        CategoryTheory.CategoryStruct.comp η_ℱ tr_π =
          (Module.finrank K K₁) • CategoryTheory.CategoryStruct.id ℱ :=
by
  let S_K : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of K)
  let S₁ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of K₁)
  let S_M : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of M)
  let π₁ : S₁ ⟶ S_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁))
  let π_M : S_M ⟶ S_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K M))
  let J_K := S_K.smallEtaleTopology
  let J₁ := S₁.smallEtaleTopology
  let F₁ := weilAltCdFieldEtaleMap hEt₁
  let B₁ := weilAltCdSitePullback π₁
  let π_star := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
    F₁ AddCommGrpCat.{u} _ J₁ J_K hContF
  let π_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
    B₁ AddCommGrpCat.{u} _ J_K J₁ hContB
  let P := ℱ.obj
  have _ : CategoryTheory.MorphismProperty.HasOfPostcompProperty
      (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) :=
    ⟨fun {Y Z W} f g _ hfg =>
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (W' := @AlgebraicGeometry.LocallyOfFiniteType ⊓ @AlgebraicGeometry.FormallyUnramified)
        f g ⟨inferInstance, inferInstance⟩ hfg⟩

  
  have hMemTop : ∀ (X : S_K.Etale) (R : CategoryTheory.Sieve X),
      (∀ x : ↥X.left, ∃ (Y : S_K.Etale) (f : Y ⟶ X) (y : ↥Y.left),
        R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧
        (CategoryTheory.ConcreteCategory.hom f.left.base) y = x) →
      R ∈ J_K X := by
    intro X R hcov
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have hmem_pre : R ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := S_K)).toGrothendieck X :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) X R).mpr hcov
    have hTopEq : J_K =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := S_K)).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := S_K) (le_refl P_et)
    exact hTopEq.symm ▸ hmem_pre

  let P_type : (S_K.Etale)ᵒᵖ ⥤ Type u := P ⋙ CategoryTheory.forget AddCommGrpCat.{u}
  have hSh_type : CategoryTheory.Presieve.IsSheaf J_K P_type :=
    (CategoryTheory.isSheaf_iff_isSheaf_of_type J_K P_type).mp
      (CategoryTheory.GrothendieckTopology.HasSheafCompose.isSheaf P ℱ.property)

  
  have hExtFieldPts : ∀ (Z : S_K.Etale) (a b : ↥(P.obj (Opposite.op Z))),
      (∀ (E : Type u) [Field E] [Algebra K E] [Algebra.Etale K E]
         (w : weilAltCdSpecEtaleObj K E ⟶ Z),
        (P.map w.op).hom a = (P.map w.op).hom b) →
      a = b := by
    intro Z a b hFieldEq
    let R_ab : CategoryTheory.Sieve Z :=
      { arrows := fun W g => (P.map g.op).hom a = (P.map g.op).hom b
        downward_closed := by
          intro W V g hg h
          change (P.map (g.op ≫ h.op)).hom a = (P.map (g.op ≫ h.op)).hom b
          rw [P.map_comp]
          exact congrArg (P.map h.op).hom hg }
    have hR_mem : R_ab ∈ J_K Z := by
      refine hMemTop Z R_ab fun z₀ => ?_
      obtain ⟨V₀, hV₀, hz₀, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : Z.left.Opens)) (x := z₀) trivial
      let R_A : CommRingCat.{u} := Z.left.presheaf.obj (Opposite.op V₀)
      let A : Type u := ↑R_A
      let φ_sch : AlgebraicGeometry.Spec R_A ⟶ S_K := hV₀.fromSpec ≫ Z.hom
      have hEt_φ : AlgebraicGeometry.Etale φ_sch := by
        have : AlgebraicGeometry.Etale Z.hom := Z.prop
        exact inferInstance
      let φ_ring : CommRingCat.of K ⟶ R_A :=
        (AlgebraicGeometry.Spec.fullyFaithful.preimage φ_sch).unop
      have hSpec_φ : AlgebraicGeometry.Spec.map φ_ring = φ_sch :=
        AlgebraicGeometry.Spec.fullyFaithful.map_preimage φ_sch
      have hEt_ring : (CommRingCat.Hom.hom φ_ring).Etale := by
        rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale), hSpec_φ]
        exact hEt_φ
      let _ : Algebra K A := (CommRingCat.Hom.hom φ_ring).toAlgebra
      have hAlgEt : Algebra.Etale K A := RingHom.etale_algebraMap.mp hEt_ring
      obtain ⟨I, _, Ei, hFieldEi, hAlgEi, e_prod, hModEi⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K A).mp hAlgEt
      let _ : Fintype I := Fintype.ofFinite I
      let _ : DecidableEq I := Classical.decEq I
      let _ : ∀ i, Field (Ei i) := hFieldEi
      let _ : ∀ i, Algebra K (Ei i) := hAlgEi
      let pt_spec : ↥(AlgebraicGeometry.Spec R_A) := hV₀.isoSpec.hom.base ⟨z₀, hz₀⟩
      have hcomp_iso : hV₀.isoSpec.hom ≫ hV₀.fromSpec = V₀.ι := by
        rw [← hV₀.isoSpec_inv_ι, CategoryTheory.Iso.hom_inv_id_assoc]
      have hpt_base : (CategoryTheory.ConcreteCategory.hom hV₀.fromSpec.base) pt_spec = z₀ := by
        have hcongr := congrArg (fun g : V₀.toScheme ⟶ Z.left =>
          (CategoryTheory.ConcreteCategory.hom g.base) ⟨z₀, hz₀⟩) hcomp_iso
        exact hcongr
      let 𝔭 : PrimeSpectrum (∀ i : I, Ei i) :=
        PrimeSpectrum.comap e_prod.symm.toRingHom pt_spec
      have hex_i₀ : ∃ i₀ : I, Pi.single i₀ (1 : Ei i₀) ∉ 𝔭.asIdeal := by
        by_contra! hall
        have hsum : (∑ i : I, Pi.single i (1 : Ei i)) ∈ 𝔭.asIdeal :=
          Submodule.sum_mem 𝔭.asIdeal fun i _ => hall i
        have hone : (∑ i : I, Pi.single i (1 : Ei i)) = 1 := by
          ext j
          simp
        rw [hone] at hsum
        exact 𝔭.isPrime.ne_top ((Ideal.eq_top_iff_one 𝔭.asIdeal).mpr hsum)
      obtain ⟨i₀, hi₀⟩ := hex_i₀
      let E₀ : Type u := Ei i₀
      have _ : Module.Finite K E₀ := (hModEi i₀).1
      have _ : Algebra.IsSeparable K E₀ := (hModEi i₀).2
      have _ : Algebra.Etale K E₀ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K E₀).mpr
          ⟨PUnit.{u + 1}, inferInstance, fun _ => E₀, fun _ => inferInstance,
            fun _ => inferInstance,
            { toFun := fun x _ => x
              invFun := fun f => f PUnit.unit
              left_inv := fun _ => rfl
              right_inv := fun f => funext fun ⟨⟩ => rfl
              map_mul' := fun _ _ => rfl
              map_add' := fun _ _ => rfl
              commutes' := fun _ => rfl },
            fun _ => ⟨inferInstance, inferInstance⟩⟩
      let π_A : A →ₐ[K] E₀ := (Pi.evalAlgHom K Ei i₀).comp e_prod.toAlgHom
      let q_bot : ↥(AlgebraicGeometry.Spec (CommRingCat.of E₀)) := (⊥ : PrimeSpectrum E₀)
      have hq_comap : PrimeSpectrum.comap π_A.toRingHom (⊥ : PrimeSpectrum E₀) = pt_spec := by
        ext x
        change π_A x ∈ (⊥ : Ideal E₀) ↔ x ∈ pt_spec.asIdeal
        rw [Ideal.mem_bot]
        have hx_p : x ∈ pt_spec.asIdeal ↔ e_prod x ∈ 𝔭.asIdeal := by
          change x ∈ pt_spec.asIdeal ↔ e_prod.symm (e_prod x) ∈ pt_spec.asIdeal
          rw [e_prod.symm_apply_apply]
        rw [hx_p]
        change (e_prod x) i₀ = 0 ↔ e_prod x ∈ 𝔭.asIdeal
        set y := e_prod x
        constructor
        · intro hy0
          have hmul0 : Pi.single i₀ (1 : Ei i₀) * y = 0 := by
            ext j
            by_cases hj : j = i₀
            · subst hj; simp [hy0]
            · simp [Pi.single_eq_of_ne hj]
          have hmem0 : Pi.single i₀ (1 : Ei i₀) * y ∈ 𝔭.asIdeal := by
            rw [hmul0]; exact 𝔭.asIdeal.zero_mem
          exact (𝔭.isPrime.mem_or_mem hmem0).resolve_left hi₀
        · intro hymem
          by_contra hyne
          have hmul1 : Pi.single i₀ (y i₀)⁻¹ * y = Pi.single i₀ (1 : Ei i₀) := by
            ext j
            by_cases hj : j = i₀
            · subst hj; simp [inv_mul_cancel₀ hyne]
            · simp [Pi.single_eq_of_ne hj]
          have hmem1 : Pi.single i₀ (1 : Ei i₀) ∈ 𝔭.asIdeal := by
            rw [← hmul1]
            exact 𝔭.asIdeal.mul_mem_left _ hymem
          exact hi₀ hmem1
      let f₀ : AlgebraicGeometry.Spec (CommRingCat.of E₀) ⟶ Z.left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_A.toRingHom) ≫ hV₀.fromSpec
      have hπ_comp : φ_ring ≫ CommRingCat.ofHom π_A.toRingHom =
          CommRingCat.ofHom (algebraMap K E₀) :=
        CommRingCat.hom_ext π_A.comp_algebraMap
      have hf₀_hom : f₀ ≫ Z.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E₀)) := by
        calc
          f₀ ≫ Z.hom
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_A.toRingHom) ≫ φ_sch :=
              CategoryTheory.Category.assoc _ _ _
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_A.toRingHom) ≫
                AlgebraicGeometry.Spec.map φ_ring := by rw [hSpec_φ]
          _ = AlgebraicGeometry.Spec.map (φ_ring ≫ CommRingCat.ofHom π_A.toRingHom) :=
              (AlgebraicGeometry.Spec.map_comp _ _).symm
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E₀)) :=
              congrArg AlgebraicGeometry.Spec.map hπ_comp
      have hEt_f₀ : AlgebraicGeometry.Etale f₀ := by
        have hEt_comp : AlgebraicGeometry.Etale (f₀ ≫ Z.hom) := by
          rw [hf₀_hom]
          exact (weilAltCdSpecEtaleObj K E₀).prop
        exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          (W' := @AlgebraicGeometry.Etale) f₀ Z.hom Z.prop hEt_comp
      let w₀ : weilAltCdSpecEtaleObj K E₀ ⟶ Z :=
        CategoryTheory.MorphismProperty.Over.homMk f₀ hf₀_hom
      have hw₀_base : (CategoryTheory.ConcreteCategory.hom w₀.left.base) q_bot = z₀ := by
        change (CategoryTheory.ConcreteCategory.hom hV₀.fromSpec.base)
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_A.toRingHom)) q_bot) = z₀
        rw [AlgebraicGeometry.Spec.map_apply, CommRingCat.hom_ofHom, hq_comap, hpt_base]
      exact ⟨weilAltCdSpecEtaleObj K E₀, w₀, q_bot, hFieldEq E₀ w₀, hEt_f₀, hw₀_base⟩
    have hGenMem : CategoryTheory.Sieve.generate R_ab.arrows ∈ J_K Z := by
      rwa [CategoryTheory.Sieve.generate_sieve]
    exact (CategoryTheory.Presieve.IsSheaf.isSheafFor hSh_type R_ab.arrows hGenMem).isSeparatedFor.ext
      fun W g hg => hg

  
  have _ : AlgebraicGeometry.Etale π_M := hEtM
  have _ : AlgebraicGeometry.Etale π₁ := hEt₁
  have hSurj_πM : AlgebraicGeometry.Surjective π_M :=
    ⟨fun y => ⟨default, Subsingleton.elim _ _⟩⟩
  let p_fst : ∀ U : S_K.Etale, CategoryTheory.Limits.pullback U.hom π_M ⟶ U.left :=
    fun U => CategoryTheory.Limits.pullback.fst U.hom π_M
  let p_snd : ∀ U : S_K.Etale, CategoryTheory.Limits.pullback U.hom π_M ⟶ S_M :=
    fun U => CategoryTheory.Limits.pullback.snd U.hom π_M
  let U_M : S_K.Etale → S_K.Etale := fun U =>
    letI : AlgebraicGeometry.Etale U.hom := U.prop
    CategoryTheory.MorphismProperty.Over.mk ⊤ (p_fst U ≫ U.hom) inferInstance
  let u_M : ∀ U : S_K.Etale, U_M U ⟶ U := fun U =>
    CategoryTheory.MorphismProperty.Over.homMk (p_fst U) rfl
  let f_M : ∀ {U' U : S_K.Etale} (f : U' ⟶ U), U_M U' ⟶ U_M U := fun {U' U} f =>
    CategoryTheory.MorphismProperty.Over.homMk
      (CategoryTheory.Limits.pullback.lift (p_fst U' ≫ f.left) (p_snd U')
        (((CategoryTheory.Category.assoc (p_fst U') f.left U.hom).trans
          (congrArg (CategoryTheory.CategoryStruct.comp (p_fst U'))
            (CategoryTheory.MorphismProperty.Over.w f))).trans
          CategoryTheory.Limits.pullback.condition))
      (((CategoryTheory.Category.assoc _ (p_fst U) U.hom).symm.trans
        (congrArg (fun h => h ≫ U.hom)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
        ((CategoryTheory.Category.assoc (p_fst U') f.left U.hom).trans
          (congrArg (CategoryTheory.CategoryStruct.comp (p_fst U'))
            (CategoryTheory.MorphismProperty.Over.w f))))
  let α_M : ∀ (U : S_K.Etale) (γ : M ≃ₐ[K] M), U_M U ⟶ U_M U := fun U γ =>
    let m_γ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom)
    have hmγ : m_γ ≫ π_M = π_M :=
      (AlgebraicGeometry.Spec.map_comp (CommRingCat.ofHom (algebraMap K M))
        (CommRingCat.ofHom γ.toRingHom)).symm.trans
        (congrArg AlgebraicGeometry.Spec.map
          (CommRingCat.hom_ext γ.toAlgHom.comp_algebraMap))
    CategoryTheory.MorphismProperty.Over.homMk
      (CategoryTheory.Limits.pullback.lift (p_fst U) (p_snd U ≫ m_γ)
        (CategoryTheory.Limits.pullback.condition.trans
          ((congrArg (CategoryTheory.CategoryStruct.comp (p_snd U)) hmγ.symm).trans
            (CategoryTheory.Category.assoc (p_snd U) m_γ π_M).symm)))
      ((CategoryTheory.Category.assoc _ (p_fst U) U.hom).symm.trans
        (congrArg (fun h => h ≫ U.hom)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)))

  have hCoverSieve : ∀ U : S_K.Etale,
      CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton (u_M U)) ∈ J_K U := by
    intro U
    have hSurj_fst : AlgebraicGeometry.Surjective (p_fst U) := inferInstance
    have hEt_fst : AlgebraicGeometry.Etale (p_fst U) := inferInstance
    refine hMemTop U _ fun x => ?_
    obtain ⟨y, hy⟩ := hSurj_fst.surj x
    refine ⟨U_M U, u_M U, y, ?_, hEt_fst, hy⟩
    exact ⟨U_M U, 𝟙 (U_M U), u_M U, CategoryTheory.Presieve.singleton.mk,
      CategoryTheory.Category.id_comp _⟩

  have hFieldDeck : ∀ (U : S_K.Etale) (E : Type u) [Field E] [Algebra K E] [Algebra.Etale K E]
      (q₁ q₂ : weilAltCdSpecEtaleObj K E ⟶ U_M U),
      q₁ ≫ u_M U = q₂ ≫ u_M U →
      ∃ γ : M ≃ₐ[K] M, q₂ = q₁ ≫ α_M U γ := by
    intro U E _ _ _ q₁ q₂ hq
    have hq_fst : q₁.left ≫ p_fst U = q₂.left ≫ p_fst U :=
      congrArg (fun g : weilAltCdSpecEtaleObj K E ⟶ U => g.left) hq
    let s₁ : AlgebraicGeometry.Spec (CommRingCat.of E) ⟶ S_M := q₁.left ≫ p_snd U
    let s₂ : AlgebraicGeometry.Spec (CommRingCat.of E) ⟶ S_M := q₂.left ≫ p_snd U
    have hs_hom : ∀ (q : weilAltCdSpecEtaleObj K E ⟶ U_M U),
        (q.left ≫ p_snd U) ≫ π_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E)) :=
      fun q =>
        (CategoryTheory.Category.assoc q.left (p_snd U) π_M).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp q.left)
            (CategoryTheory.Limits.pullback.condition (f := U.hom) (g := π_M)).symm).trans
            (CategoryTheory.MorphismProperty.Over.w q))
    let r₁ : CommRingCat.of M ⟶ CommRingCat.of E :=
      (AlgebraicGeometry.Spec.fullyFaithful.preimage s₁).unop
    let r₂ : CommRingCat.of M ⟶ CommRingCat.of E :=
      (AlgebraicGeometry.Spec.fullyFaithful.preimage s₂).unop
    have hr₁_map : AlgebraicGeometry.Spec.map r₁ = s₁ :=
      AlgebraicGeometry.Spec.fullyFaithful.map_preimage s₁
    have hr₂_map : AlgebraicGeometry.Spec.map r₂ = s₂ :=
      AlgebraicGeometry.Spec.fullyFaithful.map_preimage s₂
    have hr_alg : ∀ (r : CommRingCat.of M ⟶ CommRingCat.of E),
        AlgebraicGeometry.Spec.map r ≫ π_M =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E)) →
        CommRingCat.ofHom (algebraMap K M) ≫ r = CommRingCat.ofHom (algebraMap K E) := by
      intro r hr
      apply Quiver.Hom.op_inj
      apply AlgebraicGeometry.Spec.fullyFaithful.map_injective
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K M) ≫ r) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K E))
      rw [AlgebraicGeometry.Spec.map_comp]
      exact hr
    have hr₁_alg := hr_alg r₁ (hr₁_map.symm ▸ hs_hom q₁)
    have hr₂_alg := hr_alg r₂ (hr₂_map.symm ▸ hs_hom q₂)
    let φ₁ : M →ₐ[K] E :=
      { toRingHom := CommRingCat.Hom.hom r₁
        commutes' := fun k => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hr₁_alg) k }
    let φ₂ : M →ₐ[K] E :=
      { toRingHom := CommRingCat.Hom.hom r₂
        commutes' := fun k => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hr₂_alg) k }
    have hex_pre : ∀ m : M, ∃ a : M, φ₁ a = φ₂ m := by
      intro m
      have hm_int : IsIntegral K m := Algebra.IsIntegral.isIntegral m
      let p : Polynomial K := minpoly K m
      have hp_monic : (p.map (algebraMap K M)).Monic :=
        (minpoly.monic hm_int).map (algebraMap K M)
      have hp_splits : (p.map (algebraMap K M)).Splits :=
        Normal.splits (IsGalois.to_normal (F := K) (E := M)) m
      obtain ⟨ms, hms⟩ := Polynomial.splits_iff_exists_multiset.mp hp_splits
      rw [hp_monic.leadingCoeff, map_one, one_mul] at hms
      have hmap_E : (p.map (algebraMap K M)).map φ₁.toRingHom = p.map (algebraMap K E) := by
        rw [Polynomial.map_map]
        congr 1
        ext k
        exact φ₁.commutes k
      have heval_zero : Polynomial.eval (φ₂ m) ((p.map (algebraMap K M)).map φ₁.toRingHom) = 0 := by
        rw [hmap_E, Polynomial.eval_map, ← Polynomial.aeval_def,
          Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]
      rw [hms, Polynomial.map_multiset_prod, Polynomial.eval_multiset_prod] at heval_zero
      have hzero_mem := Multiset.prod_eq_zero_iff.mp heval_zero
      rw [Multiset.mem_map] at hzero_mem
      obtain ⟨q_fac, hq_mem, hq_zero⟩ := hzero_mem
      rw [Multiset.mem_map] at hq_mem
      obtain ⟨q_M, hqM_mem, rfl⟩ := hq_mem
      rw [Multiset.mem_map] at hqM_mem
      obtain ⟨a, _, rfl⟩ := hqM_mem
      simp only [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
        Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hq_zero
      exact ⟨a, hq_zero.symm⟩
    let g_fun : M → M := fun m => Classical.choose (hex_pre m)
    have hg_fun : ∀ m : M, φ₁ (g_fun m) = φ₂ m := fun m => Classical.choose_spec (hex_pre m)
    have hφ₁_inj : Function.Injective φ₁ := φ₁.toRingHom.injective
    let γ₀ : M →ₐ[K] M :=
      { toFun := g_fun
        map_one' := hφ₁_inj (by rw [hg_fun, map_one, map_one])
        map_mul' := fun x y => hφ₁_inj (by rw [hg_fun, map_mul, map_mul, hg_fun, hg_fun])
        map_zero' := hφ₁_inj (by rw [hg_fun, map_zero, map_zero])
        map_add' := fun x y => hφ₁_inj (by rw [hg_fun, map_add, map_add, hg_fun, hg_fun])
        commutes' := fun k => hφ₁_inj (by rw [hg_fun, φ₂.commutes, φ₁.commutes]) }
    let γ : M ≃ₐ[K] M := AlgEquiv.ofBijective γ₀ (AlgHom.bijective γ₀)
    have hmap_γ : AlgebraicGeometry.Spec.map r₂ =
        AlgebraicGeometry.Spec.map r₁ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) := by
      rw [← AlgebraicGeometry.Spec.map_comp]
      congr 1
      ext m
      exact (hg_fun m).symm
    refine ⟨γ, ?_⟩
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact hq_fst.symm.trans
        ((congrArg (CategoryTheory.CategoryStruct.comp q₁.left)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm).trans
          (CategoryTheory.Category.assoc q₁.left (α_M U γ).left (p_fst U)).symm)
    · exact (hr₂_map.symm.trans (hmap_γ.trans
        (congrArg (fun h => h ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom))
          hr₁_map))).trans
        ((CategoryTheory.Category.assoc q₁.left (p_snd U) _).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp q₁.left)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm).trans
            (CategoryTheory.Category.assoc q₁.left (α_M U γ).left (p_snd U)).symm))

  
  have _ : FiniteDimensional K K₁ := FiniteDimensional.left K K₁ M
  have _ : Algebra.IsSeparable K K₁ := Algebra.isSeparable_tower_bot_of_isSeparable K K₁ M
  have hCardEmb : Fintype.card (K₁ →ₐ[K] M) = Module.finrank K K₁ := by
    refine AlgHom.card_of_splits K K₁ M fun x => ?_
    have hmin : minpoly K (algebraMap K₁ M x) = minpoly K x :=
      minpoly.algebraMap_eq (algebraMap K₁ M).injective x
    rw [← hmin]
    exact Normal.splits (IsGalois.to_normal (F := K) (E := M)) (algebraMap K₁ M x)

  have hAdjSq : ∀ {V' V : S₁.Etale} {U' U : S_K.Etale}
      (v : V' ⟶ V) (f : U' ⟶ U) (h' : F₁.obj V' ⟶ U') (h : F₁.obj V ⟶ U),
      F₁.map v ≫ h = h' ≫ f →
      v ≫ (adj_site.homEquiv V U) h = (adj_site.homEquiv V' U') h' ≫ B₁.map f := by
    intro V' V U' U v f h' h hsq
    apply (adj_site.homEquiv V' U).symm.injective
    rw [CategoryTheory.Adjunction.homEquiv_counit, CategoryTheory.Adjunction.homEquiv_counit,
      F₁.map_comp, F₁.map_comp, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
    have hc₁ : F₁.map ((adj_site.homEquiv V U) h) ≫ adj_site.counit.app U = h :=
      (CategoryTheory.Adjunction.homEquiv_counit adj_site V U
        ((adj_site.homEquiv V U) h)).symm.trans
        (Equiv.symm_apply_apply (adj_site.homEquiv V U) h)
    have hc₂ : F₁.map ((adj_site.homEquiv V' U') h') ≫ adj_site.counit.app U' = h' :=
      (CategoryTheory.Adjunction.homEquiv_counit adj_site V' U'
        ((adj_site.homEquiv V' U') h')).symm.trans
        (Equiv.symm_apply_apply (adj_site.homEquiv V' U') h')
    have hnat : F₁.map (B₁.map f) ≫ adj_site.counit.app U = adj_site.counit.app U' ≫ f :=
      adj_site.counit.naturality f
    erw [hc₁, hnat, ← CategoryTheory.Category.assoc, hc₂, hsq]

  let m_emb : (K₁ →ₐ[K] M) → (S_M ⟶ S₁) :=
    fun τ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.toRingHom)
  have hm_π₁ : ∀ τ : K₁ →ₐ[K] M, m_emb τ ≫ π₁ = π_M := by
    intro τ
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.toRingHom) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K₁)) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K M))
    rw [← AlgebraicGeometry.Spec.map_comp]
    exact congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext τ.comp_algebraMap)
  have hEt_memb : ∀ τ : K₁ →ₐ[K] M, AlgebraicGeometry.Etale (m_emb τ) := by
    intro τ
    have hEt_comp : AlgebraicGeometry.Etale (m_emb τ ≫ π₁) := by
      rw [hm_π₁ τ]; exact hEtM
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      (W' := @AlgebraicGeometry.Etale) (m_emb τ) π₁ hEt₁ hEt_comp
  let V_τ : ∀ (U : S_K.Etale) (τ : K₁ →ₐ[K] M), S₁.Etale := fun U τ =>
    letI : AlgebraicGeometry.Etale U.hom := U.prop
    letI : AlgebraicGeometry.Etale (m_emb τ) := hEt_memb τ
    CategoryTheory.MorphismProperty.Over.mk ⊤ (p_snd U ≫ m_emb τ) inferInstance
  have hV_hom : ∀ (U : S_K.Etale) (τ : K₁ →ₐ[K] M),
      (F₁.obj (V_τ U τ)).hom = (U_M U).hom := by
    intro U τ
    change (p_snd U ≫ m_emb τ) ≫ π₁ = p_fst U ≫ U.hom
    rw [CategoryTheory.Category.assoc, hm_π₁ τ, ← CategoryTheory.Limits.pullback.condition]
  let i_τ : ∀ (U : S_K.Etale) (τ : K₁ →ₐ[K] M), U_M U ⟶ F₁.obj (V_τ U τ) := fun U τ =>
    CategoryTheory.MorphismProperty.Over.homMk (𝟙 (U_M U).left)
      ((CategoryTheory.Category.id_comp _).trans (hV_hom U τ))
  let j_τ : ∀ (U : S_K.Etale) (τ : K₁ →ₐ[K] M), F₁.obj (V_τ U τ) ⟶ U_M U := fun U τ =>
    CategoryTheory.MorphismProperty.Over.homMk (𝟙 (U_M U).left)
      ((CategoryTheory.Category.id_comp _).trans (hV_hom U τ).symm)
  let s_τ : ∀ (U : S_K.Etale) (τ : K₁ →ₐ[K] M), V_τ U τ ⟶ B₁.obj U :=
    fun U τ => (adj_site.homEquiv (V_τ U τ) U) (j_τ U τ ≫ u_M U)
  let sh : ∀ (U : S_K.Etale) (τ : K₁ →ₐ[K] M), U_M U ⟶ F₁.obj (B₁.obj U) :=
    fun U τ => i_τ U τ ≫ F₁.map (s_τ U τ)
  let σ : ∀ U : S_K.Etale,
      P.obj (Opposite.op (F₁.obj (B₁.obj U))) ⟶ P.obj (Opposite.op (U_M U)) :=
    fun U => ∑ τ : (K₁ →ₐ[K] M), P.map (Opposite.op (sh U τ))

  have hsh_deck : ∀ (U : S_K.Etale) (γ : M ≃ₐ[K] M) (τ : K₁ →ₐ[K] M),
      α_M U γ ≫ sh U τ = sh U (γ.toAlgHom.comp τ) := by
    intro U γ τ
    let τ' : K₁ →ₐ[K] M := γ.toAlgHom.comp τ
    have hm_γτ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) ≫ m_emb τ = m_emb τ' := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.toRingHom) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ'.toRingHom)
      rw [← AlgebraicGeometry.Spec.map_comp]
      rfl
    have hβ_hom : (α_M U γ).left ≫ (V_τ U τ).hom = (V_τ U τ').hom := by
      have hsnd : (α_M U γ).left ≫ p_snd U =
          p_snd U ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      exact ((CategoryTheory.Category.assoc (α_M U γ).left (p_snd U) (m_emb τ)).symm.trans
        (congrArg (fun h => h ≫ m_emb τ) hsnd)).trans
        ((CategoryTheory.Category.assoc (p_snd U) _ (m_emb τ)).trans
          (congrArg (CategoryTheory.CategoryStruct.comp (p_snd U)) hm_γτ))
    let β : V_τ U τ' ⟶ V_τ U τ := CategoryTheory.MorphismProperty.Over.homMk (α_M U γ).left hβ_hom
    have hsq : F₁.map β ≫ (j_τ U τ ≫ u_M U) = (j_τ U τ' ≫ u_M U) ≫ 𝟙 U :=
      CategoryTheory.MorphismProperty.Over.Hom.ext
        ((congrArg (CategoryTheory.CategoryStruct.comp (α_M U γ).left)
          (CategoryTheory.Category.id_comp (p_fst U))).trans
          ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
            ((CategoryTheory.Category.id_comp (p_fst U)).symm.trans
              (CategoryTheory.Category.comp_id (𝟙 (U_M U).left ≫ p_fst U)).symm)))
    have hs_eq : β ≫ s_τ U τ = s_τ U τ' := by
      have h1 := hAdjSq β (𝟙 U) (j_τ U τ' ≫ u_M U) (j_τ U τ ≫ u_M U) hsq
      rwa [B₁.map_id, CategoryTheory.Category.comp_id] at h1
    have hi_eq : α_M U γ ≫ i_τ U τ = i_τ U τ' ≫ F₁.map β :=
      CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.comp_id (α_M U γ).left).trans
          (CategoryTheory.Category.id_comp (α_M U γ).left).symm)
    calc
      α_M U γ ≫ sh U τ
        = (α_M U γ ≫ i_τ U τ) ≫ F₁.map (s_τ U τ) := (CategoryTheory.Category.assoc _ _ _).symm
      _ = i_τ U τ' ≫ (F₁.map β ≫ F₁.map (s_τ U τ)) := by
          rw [hi_eq, CategoryTheory.Category.assoc]
      _ = i_τ U τ' ≫ F₁.map (β ≫ s_τ U τ) := by rw [← F₁.map_comp]
      _ = sh U τ' := by rw [hs_eq]

  have hσ_deck : ∀ (U : S_K.Etale) (γ : M ≃ₐ[K] M),
      σ U ≫ P.map (Opposite.op (α_M U γ)) = σ U := by
    intro U γ
    dsimp only [σ]
    rw [CategoryTheory.Preadditive.sum_comp]
    have hterm : ∀ τ : K₁ →ₐ[K] M,
        P.map (Opposite.op (sh U τ)) ≫ P.map (Opposite.op (α_M U γ)) =
          P.map (Opposite.op (sh U (γ.toAlgHom.comp τ))) := by
      intro τ
      rw [← P.map_comp]
      exact congrArg P.map (congrArg Opposite.op (hsh_deck U γ τ))
    let e_γ : (K₁ →ₐ[K] M) ≃ (K₁ →ₐ[K] M) :=
      { toFun := fun τ => γ.toAlgHom.comp τ
        invFun := fun τ => γ.symm.toAlgHom.comp τ
        left_inv := fun τ => by ext x; simp
        right_inv := fun τ => by ext x; simp }
    exact (Finset.sum_congr rfl fun τ _ => hterm τ).trans
      (Equiv.sum_comp e_γ (fun τ => P.map (Opposite.op (sh U τ))))

  have hsh_nat : ∀ {U' U : S_K.Etale} (f : U' ⟶ U) (τ : K₁ →ₐ[K] M),
      f_M f ≫ sh U τ = sh U' τ ≫ F₁.map (B₁.map f) := by
    intro U' U f τ
    have hv_hom : (f_M f).left ≫ (V_τ U τ).hom = (V_τ U' τ).hom := by
      have hsnd : (f_M f).left ≫ p_snd U = p_snd U' :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      exact (CategoryTheory.Category.assoc (f_M f).left (p_snd U) (m_emb τ)).symm.trans
        (congrArg (fun h => h ≫ m_emb τ) hsnd)
    let v_f : V_τ U' τ ⟶ V_τ U τ := CategoryTheory.MorphismProperty.Over.homMk (f_M f).left hv_hom
    have hsq : F₁.map v_f ≫ (j_τ U τ ≫ u_M U) = (j_τ U' τ ≫ u_M U') ≫ f :=
      CategoryTheory.MorphismProperty.Over.Hom.ext
        ((congrArg (CategoryTheory.CategoryStruct.comp (f_M f).left)
          (CategoryTheory.Category.id_comp (p_fst U))).trans
          ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
            (congrArg (fun h => h ≫ f.left)
              (CategoryTheory.Category.id_comp (p_fst U')).symm)))
    have hs_eq : v_f ≫ s_τ U τ = s_τ U' τ ≫ B₁.map f :=
      hAdjSq v_f f (j_τ U' τ ≫ u_M U') (j_τ U τ ≫ u_M U) hsq
    have hi_eq : f_M f ≫ i_τ U τ = i_τ U' τ ≫ F₁.map v_f :=
      CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.comp_id (f_M f).left).trans
          (CategoryTheory.Category.id_comp (f_M f).left).symm)
    calc
      f_M f ≫ sh U τ
        = (f_M f ≫ i_τ U τ) ≫ F₁.map (s_τ U τ) := (CategoryTheory.Category.assoc _ _ _).symm
      _ = i_τ U' τ ≫ (F₁.map v_f ≫ F₁.map (s_τ U τ)) := by
          rw [hi_eq, CategoryTheory.Category.assoc]
      _ = i_τ U' τ ≫ F₁.map (v_f ≫ s_τ U τ) := by rw [← F₁.map_comp]
      _ = i_τ U' τ ≫ F₁.map (s_τ U' τ ≫ B₁.map f) := by rw [hs_eq]
      _ = sh U' τ ≫ F₁.map (B₁.map f) := by rw [F₁.map_comp, CategoryTheory.Category.assoc]

  have hσ_nat : ∀ {U' U : S_K.Etale} (f : U' ⟶ U),
      σ U ≫ P.map (Opposite.op (f_M f)) =
        P.map (Opposite.op (F₁.map (B₁.map f))) ≫ σ U' := by
    intro U' U f
    dsimp only [σ]
    rw [CategoryTheory.Preadditive.sum_comp, CategoryTheory.Preadditive.comp_sum]
    refine Finset.sum_congr rfl fun τ _ => ?_
    rw [← P.map_comp, ← P.map_comp]
    exact congrArg P.map (congrArg Opposite.op (hsh_nat f τ))

  have hσ_counit : ∀ U : S_K.Etale,
      P.map (Opposite.op (adj_site.counit.app U)) ≫ σ U =
        (Module.finrank K K₁) • P.map (Opposite.op (u_M U)) := by
    intro U
    dsimp only [σ]
    rw [CategoryTheory.Preadditive.comp_sum]
    have hterm : ∀ τ : K₁ →ₐ[K] M,
        P.map (Opposite.op (adj_site.counit.app U)) ≫ P.map (Opposite.op (sh U τ)) =
          P.map (Opposite.op (u_M U)) := by
      intro τ
      rw [← P.map_comp]
      have hsh_counit : sh U τ ≫ adj_site.counit.app U = u_M U := by
        dsimp only [sh]
        rw [CategoryTheory.Category.assoc]
        have hc : F₁.map (s_τ U τ) ≫ adj_site.counit.app U = j_τ U τ ≫ u_M U :=
          (CategoryTheory.Adjunction.homEquiv_counit adj_site (V_τ U τ) U
            (s_τ U τ)).symm.trans
            (Equiv.symm_apply_apply (adj_site.homEquiv (V_τ U τ) U) (j_τ U τ ≫ u_M U))
        rw [hc, ← CategoryTheory.Category.assoc]
        have hij : i_τ U τ ≫ j_τ U τ = 𝟙 (U_M U) :=
          CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
        rw [hij, CategoryTheory.Category.id_comp]
      exact congrArg P.map (congrArg Opposite.op hsh_counit)
    refine (Finset.sum_congr rfl fun τ _ => hterm τ).trans ?_
    rw [Finset.sum_const, Finset.card_univ, hCardEmb]

  
  have hSing : ∀ U : S_K.Etale,
      CategoryTheory.Presieve.IsSheafFor P_type (CategoryTheory.Presieve.singleton (u_M U)) :=
    fun U => CategoryTheory.Presieve.IsSheaf.isSheafFor hSh_type _ (hCoverSieve U)

  have hInj_uM : ∀ (U : S_K.Etale) (y₁ y₂ : ↥(P.obj (Opposite.op U))),
      (P.map (u_M U).op).hom y₁ = (P.map (u_M U).op).hom y₂ → y₁ = y₂ := by
    intro U y₁ y₂ heq
    have hExU := (CategoryTheory.Presieve.isSheafFor_singleton.mp (hSing U))
      ((P.map (u_M U).op).hom y₁)
      (by
        intro Z g₁ g₂ hg
        change (P.map g₁.op).hom ((P.map (u_M U).op).hom y₁) =
          (P.map g₂.op).hom ((P.map (u_M U).op).hom y₁)
        have hcomp : ∀ g : Z ⟶ U_M U,
            (P.map g.op).hom ((P.map (u_M U).op).hom y₁) = (P.map (g ≫ u_M U).op).hom y₁ := by
          intro g
          change ((P.map (u_M U).op ≫ P.map g.op)).hom y₁ = (P.map (g ≫ u_M U).op).hom y₁
          rw [← P.map_comp]
          rfl
        rw [hcomp g₁, hcomp g₂, hg])
    exact (hExU.unique rfl heq.symm)

  have hDesc : ∀ (U : S_K.Etale) (z : ↥(P.obj (Opposite.op (F₁.obj (B₁.obj U))))),
      ∃ y : ↥(P.obj (Opposite.op U)), (P.map (u_M U).op).hom y = (σ U).hom z := by
    intro U z
    obtain ⟨y, hy, _⟩ := (CategoryTheory.Presieve.isSheafFor_singleton.mp (hSing U))
      ((σ U).hom z)
      (by
        intro Z g₁ g₂ hg
        refine hExtFieldPts Z ((P.map g₁.op).hom ((σ U).hom z))
          ((P.map g₂.op).hom ((σ U).hom z)) fun E _ _ _ w => ?_
        have hwg : (w ≫ g₁) ≫ u_M U = (w ≫ g₂) ≫ u_M U := by
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hg]
        obtain ⟨γ, hγ⟩ := hFieldDeck U E (w ≫ g₁) (w ≫ g₂) hwg
        have hpull : ∀ g : Z ⟶ U_M U,
            (P.map w.op).hom ((P.map g.op).hom ((σ U).hom z)) =
              (P.map (w ≫ g).op).hom ((σ U).hom z) := by
          intro g
          change ((P.map g.op ≫ P.map w.op)).hom ((σ U).hom z) =
            (P.map (w ≫ g).op).hom ((σ U).hom z)
          rw [← P.map_comp]
          rfl
        rw [hpull g₁, hpull g₂]
        have hmor : σ U ≫ P.map (w ≫ g₂).op = σ U ≫ P.map (w ≫ g₁).op :=
          (congrArg (fun q : weilAltCdSpecEtaleObj K E ⟶ U_M U => σ U ≫ P.map q.op) hγ).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp (σ U))
              (P.map_comp (Opposite.op (α_M U γ)) (w ≫ g₁).op)).trans
              ((CategoryTheory.Category.assoc (σ U)
                (P.map (Opposite.op (α_M U γ))) (P.map (w ≫ g₁).op)).symm.trans
                (congrArg (fun h => h ≫ P.map (w ≫ g₁).op) (hσ_deck U γ))))
        exact DFunLike.congr_fun (congrArg AddCommGrpCat.Hom.hom hmor.symm) z)
    exact ⟨y, hy⟩

  let tr_fun : ∀ (U : S_K.Etale),
      ↥(P.obj (Opposite.op (F₁.obj (B₁.obj U)))) → ↥(P.obj (Opposite.op U)) :=
    fun U z => Classical.choose (hDesc U z)
  have htr_spec : ∀ (U : S_K.Etale) (z : ↥(P.obj (Opposite.op (F₁.obj (B₁.obj U))))),
      (P.map (u_M U).op).hom (tr_fun U z) = (σ U).hom z :=
    fun U z => Classical.choose_spec (hDesc U z)

  let tr_app : ∀ U : S_K.Etale,
      (π_push.obj (π_star.obj ℱ)).obj.obj (Opposite.op U) ⟶ P.obj (Opposite.op U) := fun U =>
    AddCommGrpCat.ofHom
      { toFun := tr_fun U
        map_zero' := hInj_uM U _ _ (by rw [htr_spec U 0, map_zero, map_zero])
        map_add' := fun z₁ z₂ => hInj_uM U _ _ (by
          rw [htr_spec U (z₁ + z₂), map_add, map_add, htr_spec U z₁, htr_spec U z₂]) }

  have hfM_comm : ∀ {U' U : S_K.Etale} (f : U' ⟶ U),
      f_M f ≫ u_M U = u_M U' ≫ f := by
    intro U' U f
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _

  let tr_π : π_push.obj (π_star.obj ℱ) ⟶ ℱ :=
    { hom :=
        { app := fun X => tr_app X.unop
          naturality := by
            intro X Y g
            refine AddCommGrpCat.hom_ext (AddMonoidHom.ext fun z => ?_)
            refine hInj_uM Y.unop _ _ ?_
            change (P.map (u_M Y.unop).op).hom
                (tr_fun Y.unop ((P.map (Opposite.op (F₁.map (B₁.map g.unop)))).hom z)) =
              (P.map (u_M Y.unop).op).hom ((P.map g).hom (tr_fun X.unop z))
            have hRHS : (P.map (u_M Y.unop).op).hom ((P.map g).hom (tr_fun X.unop z)) =
                (P.map (f_M g.unop).op).hom ((P.map (u_M X.unop).op).hom (tr_fun X.unop z)) := by
              have hc : u_M Y.unop ≫ g.unop = f_M g.unop ≫ u_M X.unop := (hfM_comm g.unop).symm
              have hop : g ≫ (u_M Y.unop).op = (u_M X.unop).op ≫ (f_M g.unop).op := by
                change (u_M Y.unop ≫ g.unop).op = (f_M g.unop ≫ u_M X.unop).op
                rw [hc]
              change ((P.map g ≫ P.map (u_M Y.unop).op)).hom (tr_fun X.unop z) =
                ((P.map (u_M X.unop).op ≫ P.map (f_M g.unop).op)).hom (tr_fun X.unop z)
              rw [← P.map_comp, ← P.map_comp, hop]
            rw [htr_spec Y.unop _, hRHS, htr_spec X.unop z]
            exact (DFunLike.congr_fun (congrArg AddCommGrpCat.Hom.hom (hσ_nat g.unop)) z).symm } }

  refine ⟨tr_π, fun η_ℱ hη => ?_⟩
  let F_pre := CategoryTheory.sheafToPresheaf J_K AddCommGrpCat.{u}
  have hNsmul : F_pre.map ((Module.finrank K K₁) • CategoryTheory.CategoryStruct.id ℱ) =
      (Module.finrank K K₁) • F_pre.map (CategoryTheory.CategoryStruct.id ℱ) :=
    F_pre.map_nsmul
  apply CategoryTheory.Sheaf.hom_ext
  apply CategoryTheory.NatTrans.ext
  funext X
  obtain ⟨U⟩ := X
  change η_ℱ.hom.app (Opposite.op U) ≫ tr_app U =
    (F_pre.map ((Module.finrank K K₁) • CategoryTheory.CategoryStruct.id ℱ)).app (Opposite.op U)
  rw [hη U, hNsmul, F_pre.map_id, CategoryTheory.NatTrans.app_nsmul,
    CategoryTheory.NatTrans.id_app]
  refine AddCommGrpCat.hom_ext (AddMonoidHom.ext fun x => ?_)
  refine hInj_uM U _ _ ?_
  change (P.map (u_M U).op).hom
      (tr_fun U ((P.map (Opposite.op (adj_site.counit.app U))).hom x)) =
    (P.map (u_M U).op).hom
      (((Module.finrank K K₁) • CategoryTheory.CategoryStruct.id (P.obj (Opposite.op U))).hom x)
  rw [htr_spec U _]
  have hLHS_counit : (σ U).hom ((P.map (Opposite.op (adj_site.counit.app U))).hom x) =
      ((Module.finrank K K₁) • P.map (Opposite.op (u_M U))).hom x :=
    DFunLike.congr_fun (congrArg AddCommGrpCat.Hom.hom (hσ_counit U)) x
  rw [hLHS_counit, AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_nsmul,
    AddCommGrpCat.hom_id, AddMonoidHom.nsmul_apply, AddMonoidHom.nsmul_apply,
    AddMonoidHom.id_apply, map_nsmul]
  rfl

theorem weil_alt_cd_pgroup_galois_split_filtration_vanishing (K₁ : Type u) [Field K₁]
    (ℓ s : ℕ) [Fact (Nat.Prime ℓ)] (hs : 1 ≤ s)
    (hConst₁ : Subsingleton
      (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of K₁)) ℓ s))
    (M : Type u) [Field M] [Algebra K₁ M] [FiniteDimensional K₁ M] [IsGalois K₁ M]
    (hP : IsPGroup ℓ (M ≃ₐ[K₁] M))
    (hEtM : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₁ M))))
    (r : ℕ)
    (ℱ₁ : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology AddCommGrpCat.{u})
    (hℓ_1 : ℓ • CategoryTheory.CategoryStruct.id ℱ₁ = 0)
    (hSplit₁ : Nonempty ((CategoryTheory.Functor.comp (weilAltCdFieldEtaleMap hEtM).op ℱ₁.obj) ≅
      weilAltCdDiscreteVecPresheaf (AlgebraicGeometry.Spec (CommRingCat.of M)) ℓ r)) :
    Subsingleton (ℱ₁.H s) :=
by
  have step1_spec_subsingleton : ∀ (F : Type u) [Field F],
      Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := by
    intro F _
    have hBot : ∀ p : PrimeSpectrum F, p.asIdeal = ⊥ := by
      intro p
      ext a
      simp only [Ideal.mem_bot]
      refine ⟨fun ha => ?_, fun ha => ha.symm ▸ p.asIdeal.zero_mem⟩
      by_contra hne
      exact p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ ha (IsUnit.mk0 a hne))
    exact ⟨fun p q => PrimeSpectrum.ext ((hBot p).trans (hBot q).symm)⟩

  have step1_etale_field_local : ∀ (F : Type u) [Field F]
      (V : (AlgebraicGeometry.Spec (CommRingCat.of F)).Etale),
      DiscreteTopology ↥V.left ∧
      ∀ x : ↥V.left,
        ∃ (E : Type u) (hFE : Field E) (hAE : @Algebra F E _ hFE.toSemiring)
          (W : (AlgebraicGeometry.Spec (CommRingCat.of F)).Etale) (h : W ⟶ V)
          (e_W : AlgebraicGeometry.Spec (@CommRingCat.of E hFE.toCommRing) ≅ W.left),
          e_W.hom ≫ W.hom =
            AlgebraicGeometry.Spec.map
              (@CommRingCat.ofHom _ _ _ hFE.toCommRing (@algebraMap F E _ hFE.toSemiring hAE)) ∧
          x ∈ Set.range h.left.base := by
    intro F _ V
    have _ : CategoryTheory.MorphismProperty.HasOfPostcompProperty
        (@AlgebraicGeometry.Etale.{u}) (@AlgebraicGeometry.Etale.{u}) :=
      ⟨fun {Y Z W} f g hg hfg => by
        have _ : AlgebraicGeometry.Etale g := hg
        exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale.{u})
          (W' := @AlgebraicGeometry.LocallyOfFiniteType.{u} ⊓
            @AlgebraicGeometry.FormallyUnramified.{u})
          f g ⟨inferInstance, inferInstance⟩ hfg⟩
    have hFieldSpecEtale : ∀ (E : Type u) [Field E] [Algebra F E]
        [Module.Finite F E] [Algebra.IsSeparable F E],
        AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E))) := by
      intro E _ _ _ _
      have hAlgEt : Algebra.Etale F E :=
        (Algebra.Etale.iff_exists_algEquiv_prod F E).mpr
          ⟨PUnit.{u + 1}, inferInstance, fun _ => E, fun _ => inferInstance,
            fun _ => inferInstance,
            { toFun := fun x _ => x
              invFun := fun f => f PUnit.unit
              left_inv := fun _ => rfl
              right_inv := fun f => funext fun ⟨⟩ => rfl
              map_mul' := fun _ _ => rfl
              map_add' := fun _ _ => rfl
              commutes' := fun _ => rfl },
            fun _ => ⟨inferInstance, inferInstance⟩⟩
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr hAlgEt)
    have hPoint : ∀ x : ↥V.left,
        IsOpen ({x} : Set ↥V.left) ∧
        ∃ (E : Type u) (hFE : Field E) (hAE : @Algebra F E _ hFE.toSemiring)
          (W : (AlgebraicGeometry.Spec (CommRingCat.of F)).Etale) (h : W ⟶ V)
          (e_W : AlgebraicGeometry.Spec (@CommRingCat.of E hFE.toCommRing) ≅ W.left),
          e_W.hom ≫ W.hom =
            AlgebraicGeometry.Spec.map
              (@CommRingCat.ofHom _ _ _ hFE.toCommRing (@algebraMap F E _ hFE.toSemiring hAE)) ∧
          x ∈ Set.range h.left.base := by
      intro x
      obtain ⟨V₀, hV₀, hx, _⟩ :=
        exists_isAffineOpen_mem_and_subset (U := (⊤ : V.left.Opens)) (x := x) trivial
      let R_A : CommRingCat.{u} := V.left.presheaf.obj (Opposite.op V₀)
      let A : Type u := ↑R_A
      let φ_sch : AlgebraicGeometry.Spec R_A ⟶ AlgebraicGeometry.Spec (CommRingCat.of F) :=
        hV₀.fromSpec ≫ V.hom
      have hEt_φ : AlgebraicGeometry.Etale φ_sch := by
        have : AlgebraicGeometry.Etale V.hom := V.prop
        exact inferInstance
      let φ_ring : CommRingCat.of F ⟶ R_A :=
        (AlgebraicGeometry.Spec.fullyFaithful.preimage φ_sch).unop
      have hSpec_φ : AlgebraicGeometry.Spec.map φ_ring = φ_sch :=
        AlgebraicGeometry.Spec.fullyFaithful.map_preimage φ_sch
      have hEt_ring : (CommRingCat.Hom.hom φ_ring).Etale := by
        rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale),
          hSpec_φ]
        exact hEt_φ
      let _ : Algebra F A := (CommRingCat.Hom.hom φ_ring).toAlgebra
      have hAlgEt : Algebra.Etale F A := RingHom.etale_algebraMap.mp hEt_ring
      obtain ⟨I, hFinI, Ei, hFieldEi, hAlgEi, e_prod, hModEi⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod F A).mp hAlgEt
      let _ : Fintype I := Fintype.ofFinite I
      let _ : DecidableEq I := Classical.decEq I
      let _ : ∀ i, Field (Ei i) := hFieldEi
      let _ : ∀ i, Algebra F (Ei i) := hAlgEi
      let R_prod : Type u := ∀ i : I, Ei i
      have hPrimeProd : ∀ p : PrimeSpectrum R_prod,
          ∃ i₀ : I, p.asIdeal = RingHom.ker (Pi.evalRingHom Ei i₀) := by
        intro p
        have hSum1 : (∑ i : I, Pi.single i (1 : Ei i)) = (1 : R_prod) := by
          ext j
          simp [Finset.sum_apply]
          rfl
        have hex : ∃ i₀ : I, Pi.single i₀ (1 : Ei i₀) ∉ p.asIdeal := by
          by_contra! hall
          have h1 : (1 : R_prod) ∈ p.asIdeal :=
            hSum1 ▸ Submodule.sum_mem p.asIdeal fun i _ => hall i
          exact p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
        obtain ⟨i₀, hi₀⟩ := hex
        let e₀ : R_prod := Pi.single i₀ (1 : Ei i₀)
        have hmul0 : (1 - e₀) * e₀ = 0 := by
          ext j
          change (1 - e₀ j) * e₀ j = 0
          by_cases hj : j = i₀
          · subst hj
            simp [e₀]
          · simp [e₀, hj]
        have h1_sub : 1 - e₀ ∈ p.asIdeal := by
          rcases p.isPrime.mem_or_mem (hmul0 ▸ p.asIdeal.zero_mem) with h | h
          · exact h
          · exact False.elim (hi₀ h)
        refine ⟨i₀, Ideal.ext fun b => ⟨fun hb => ?_, fun hb => ?_⟩⟩
        · change b i₀ = 0
          by_contra hne
          let u : R_prod := Pi.single i₀ (b i₀)⁻¹
          have hbu : b * u = e₀ := by
            ext j
            change b j * u j = e₀ j
            by_cases hj : j = i₀
            · subst hj
              simp [u, e₀, mul_inv_cancel₀ hne]
            · simp [u, e₀, hj]
          have he₀_mem : e₀ ∈ p.asIdeal := hbu ▸ p.asIdeal.mul_mem_right u hb
          exact hi₀ he₀_mem
        · change b i₀ = 0 at hb
          have hbu : b * (1 - e₀) = b := by
            ext j
            change b j * (1 - e₀ j) = b j
            by_cases hj : j = i₀
            · subst hj
              simp [e₀, hb]
            · simp [e₀, hj]
          exact hbu ▸ p.asIdeal.mul_mem_left b h1_sub
      have hMax_i : ∀ i : I, (RingHom.ker (Pi.evalRingHom Ei i)).IsMaximal := fun i =>
        RingHom.ker_isMaximal_of_surjective (Pi.evalRingHom Ei i)
          (fun c => ⟨Pi.single i c, Pi.single_eq_same i c⟩)
      let ptOfIdx : I → PrimeSpectrum R_prod :=
        fun i => ⟨RingHom.ker (Pi.evalRingHom Ei i), (hMax_i i).isPrime⟩
      have hSurjPt : Function.Surjective ptOfIdx := by
        intro p
        obtain ⟨i₀, hi₀⟩ := hPrimeProd p
        exact ⟨i₀, PrimeSpectrum.ext hi₀.symm⟩
      have _ : Finite (PrimeSpectrum R_prod) := Finite.of_surjective ptOfIdx hSurjPt
      have _ : T1Space (PrimeSpectrum R_prod) :=
        ⟨fun p => by
          obtain ⟨i₀, hi₀⟩ := hPrimeProd p
          rw [PrimeSpectrum.isClosed_singleton_iff_isMaximal, hi₀]
          exact hMax_i i₀⟩
      have hDiscProd : DiscreteTopology (PrimeSpectrum R_prod) := Finite.instDiscreteTopology
      let r_to_prod : R_A ⟶ CommRingCat.of R_prod := CommRingCat.ofHom e_prod.toRingHom
      let prod_to_r : CommRingCat.of R_prod ⟶ R_A := CommRingCat.ofHom e_prod.symm.toRingHom
      have he_id : r_to_prod ≫ prod_to_r = 𝟙 R_A :=
        CommRingCat.hom_ext (RingHom.ext fun a => e_prod.symm_apply_apply a)
      let φ_V₀ : V₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_prod) :=
        hV₀.isoSpec.hom ≫ AlgebraicGeometry.Spec.map prod_to_r
      let ψ_V₀ : AlgebraicGeometry.Spec (CommRingCat.of R_prod) ⟶ V₀.toScheme :=
        AlgebraicGeometry.Spec.map r_to_prod ≫ hV₀.isoSpec.inv
      have hφψ : φ_V₀ ≫ ψ_V₀ = 𝟙 V₀.toScheme := by
        change (hV₀.isoSpec.hom ≫ AlgebraicGeometry.Spec.map prod_to_r) ≫
            (AlgebraicGeometry.Spec.map r_to_prod ≫ hV₀.isoSpec.inv) = 𝟙 V₀.toScheme
        rw [Category.assoc, ← Category.assoc (AlgebraicGeometry.Spec.map prod_to_r),
          ← AlgebraicGeometry.Spec.map_comp, he_id, AlgebraicGeometry.Spec.map_id,
          Category.id_comp, hV₀.isoSpec.hom_inv_id]
      let p_x : PrimeSpectrum R_prod := φ_V₀.base ⟨x, hx⟩
      have hPre_x : φ_V₀.base ⁻¹' ({p_x} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R_prod))) =
          ({⟨x, hx⟩} : Set ↥V₀.toScheme) := by
        ext y
        simp only [Set.mem_preimage]
        refine ⟨fun hy => ?_, fun hy => hy ▸ rfl⟩
        have h1 : (φ_V₀ ≫ ψ_V₀).base y = (φ_V₀ ≫ ψ_V₀).base ⟨x, hx⟩ := by
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply]
          exact congrArg ψ_V₀.base (Set.mem_singleton_iff.mp hy)
        rw [hφψ] at h1
        exact Set.mem_singleton_iff.mpr h1
      have hOpen_sub : IsOpen ({⟨x, hx⟩} : Set ↥V₀.toScheme) := by
        rw [← hPre_x]
        exact (@isOpen_discrete (PrimeSpectrum R_prod) _ hDiscProd {p_x}).preimage
          φ_V₀.base.hom.continuous
      have hOpen_x : IsOpen ({x} : Set ↥V.left) := by
        have hImg : V₀.ι.base '' ({⟨x, hx⟩} : Set ↥V₀.toScheme) = ({x} : Set ↥V.left) := by
          ext y
          simp only [Set.mem_image, Set.mem_singleton_iff]
          exact ⟨by rintro ⟨z, rfl, rfl⟩; rfl, fun hy => ⟨⟨x, hx⟩, rfl, hy.symm⟩⟩
        rw [← hImg]
        exact (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding V₀.ι).isOpenMap _ hOpen_sub
      obtain ⟨i₀, hi₀⟩ := hPrimeProd p_x
      let E : Type u := Ei i₀
      have _ : Module.Finite F E := (hModEi i₀).1
      have _ : Algebra.IsSeparable F E := (hModEi i₀).2
      have hEtE : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E))) :=
        hFieldSpecEtale E
      let ρ : A →ₐ[F] E := (Pi.evalAlgHom F Ei i₀).comp e_prod.toAlgHom
      have hρ_comp : φ_ring ≫ CommRingCat.ofHom ρ.toRingHom =
          CommRingCat.ofHom (algebraMap F E) :=
        CommRingCat.hom_ext ρ.comp_algebraMap
      let h_left : AlgebraicGeometry.Spec (CommRingCat.of E) ⟶ V.left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom) ≫ hV₀.fromSpec
      have hh_comp : h_left ≫ V.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E)) := by
        calc
          h_left ≫ V.hom
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom) ≫ φ_sch :=
              Category.assoc _ _ _
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom) ≫
                AlgebraicGeometry.Spec.map φ_ring := by rw [hSpec_φ]
          _ = AlgebraicGeometry.Spec.map (φ_ring ≫ CommRingCat.ofHom ρ.toRingHom) :=
              (AlgebraicGeometry.Spec.map_comp _ _).symm
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E)) := by rw [hρ_comp]
      have hEt_hleft : AlgebraicGeometry.Etale h_left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale.{u})
          (W' := @AlgebraicGeometry.Etale.{u}) h_left V.hom V.prop (hh_comp.symm ▸ hEtE)
      let W_E : (AlgebraicGeometry.Spec (CommRingCat.of F)).Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E))) hEtE
      let h_over : W_E ⟶ V := CategoryTheory.MorphismProperty.Over.homMk h_left hh_comp
      refine ⟨hOpen_x, E, inferInstance, inferInstance, W_E, h_over,
        CategoryTheory.Iso.refl _, Category.id_comp _, ?_⟩
      let pt_E : ↥(AlgebraicGeometry.Spec (CommRingCat.of E)) := Classical.arbitrary _
      have hpt_E_bot : (pt_E : PrimeSpectrum E).asIdeal = ⊥ := by
        ext a
        simp only [Ideal.mem_bot]
        refine ⟨fun ha => ?_, fun ha => ha.symm ▸ (pt_E : PrimeSpectrum E).asIdeal.zero_mem⟩
        by_contra hne
        exact (pt_E : PrimeSpectrum E).isPrime.ne_top
          (Ideal.eq_top_of_isUnit_mem _ ha (IsUnit.mk0 a hne))
      refine ⟨pt_E, ?_⟩
      have hρ_split : CommRingCat.ofHom ρ.toRingHom =
          r_to_prod ≫ CommRingCat.ofHom (Pi.evalRingHom Ei i₀) :=
        CommRingCat.hom_ext rfl
      have hFromSpec : hV₀.fromSpec = hV₀.isoSpec.inv ≫ V₀.ι :=
        (AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι hV₀).symm
      have hh_eq : h_left =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom Ei i₀)) ≫
            (ψ_V₀ ≫ V₀.ι) := by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ.toRingHom) ≫ hV₀.fromSpec =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom Ei i₀)) ≫
            ((AlgebraicGeometry.Spec.map r_to_prod ≫ hV₀.isoSpec.inv) ≫ V₀.ι)
        rw [hρ_split, AlgebraicGeometry.Spec.map_comp, hFromSpec, Category.assoc, Category.assoc]
      change h_left.base pt_E = x
      rw [hh_eq, AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply]
      have hpt_comap :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom Ei i₀))).base pt_E =
            p_x := by
        apply PrimeSpectrum.ext
        rw [hi₀]
        ext b
        change b ∈ Ideal.comap (Pi.evalRingHom Ei i₀) (pt_E : PrimeSpectrum E).asIdeal ↔ _
        rw [hpt_E_bot]
        simp [RingHom.mem_ker]
      rw [hpt_comap]
      have hψp : ψ_V₀.base p_x = ⟨x, hx⟩ := by
        change (φ_V₀ ≫ ψ_V₀).base ⟨x, hx⟩ = ⟨x, hx⟩
        rw [hφψ]
        rfl
      rw [hψp]
      rfl
    exact ⟨discreteTopology_iff_isOpen_singleton.mpr (fun x => (hPoint x).1),
      fun x => (hPoint x).2⟩

  have step2_mem_etale_iff : ∀ (S : AlgebraicGeometry.Scheme.{u}) (X : S.Etale)
      (R : CategoryTheory.Sieve X),
      R ∈ S.smallEtaleTopology X ↔
        ∀ (x : ↥X.left), ∃ (Y : S.Etale) (f : Y ⟶ X) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S X R
    have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition
        (@AlgebraicGeometry.Etale.{u}) :=
      ⟨fun _ _ hf hg => by have := hf; have := hg; infer_instance⟩
    have _ : CategoryTheory.MorphismProperty.HasOfPostcompProperty
        (@AlgebraicGeometry.Etale.{u}) (@AlgebraicGeometry.Etale.{u}) :=
      ⟨fun {Y Z W} f g hg hfg => by
        have _ : AlgebraicGeometry.Etale g := hg
        exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale.{u})
          (W' := @AlgebraicGeometry.LocallyOfFiniteType.{u} ⊓
            @AlgebraicGeometry.FormallyUnramified.{u})
          f g ⟨inferInstance, inferInstance⟩ hfg⟩
    change R ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology
      (@AlgebraicGeometry.Etale.{u}) S X ↔ _
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale.{u}) (Q := @AlgebraicGeometry.Etale.{u}) S le_rfl]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology X R

  have step2_singleton_mem : ∀ {S : AlgebraicGeometry.Scheme.{u}} {U V : S.Etale}
      (f : U ⟶ V) [AlgebraicGeometry.Surjective f.left],
      CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton f) ∈
        S.smallEtaleTopology V := by
    intro S U V f _
    have _ : CategoryTheory.MorphismProperty.HasOfPostcompProperty
        (@AlgebraicGeometry.Etale.{u}) (@AlgebraicGeometry.Etale.{u}) :=
      ⟨fun {Y Z W} f g hg hfg => by
        have _ : AlgebraicGeometry.Etale g := hg
        exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale.{u})
          (W' := @AlgebraicGeometry.LocallyOfFiniteType.{u} ⊓
            @AlgebraicGeometry.FormallyUnramified.{u})
          f g ⟨inferInstance, inferInstance⟩ hfg⟩
    have hEt_f : AlgebraicGeometry.Etale f.left :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale.{u})
        (W' := @AlgebraicGeometry.Etale.{u}) f.left V.hom V.prop
        ((CategoryTheory.MorphismProperty.Over.w f).symm ▸ U.prop)
    rw [step2_mem_etale_iff S V]
    intro x
    obtain ⟨y, hy⟩ := AlgebraicGeometry.Surjective.surj (f := f.left) x
    exact ⟨U, f, y, ⟨U, 𝟙 U, f, CategoryTheory.Presieve.singleton.mk, Category.id_comp f⟩,
      hEt_f, hy⟩

  have step2_site_adjunction : ∀ (K₀ M₀ : Type u) [Field K₀] [Field M₀] [Algebra K₀ M₀]
      (hEt₀ : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ M₀)))),
      let S₀ := AlgebraicGeometry.Spec (CommRingCat.of K₀)
      let S_M₀ := AlgebraicGeometry.Spec (CommRingCat.of M₀)
      let π₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ M₀))
      let J₀ := S₀.smallEtaleTopology
      let J_M₀ := S_M₀.smallEtaleTopology
      let F₀ := weilAltCdFieldEtaleMap hEt₀
      let B₀ := weilAltCdSitePullback π₀
      ∃ (hContF : F₀.IsContinuous J_M₀ J₀)
        (hContB : B₀.IsContinuous J₀ J_M₀)
        (adj_site : F₀ ⊣ B₀)
        (adj_sh :
          @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            F₀ AddCommGrpCat.{u} _ J_M₀ J₀ hContF ⊣
          @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            B₀ AddCommGrpCat.{u} _ J₀ J_M₀ hContB),
        (∀ (ℱ : CategoryTheory.Sheaf J₀ AddCommGrpCat.{u}) (U : S₀.Etale),
          (adj_sh.unit.app ℱ).hom.app (Opposite.op U) =
            ℱ.obj.map (Opposite.op (adj_site.counit.app U))) ∧
        (∀ (𝒢 : CategoryTheory.Sheaf J_M₀ AddCommGrpCat.{u}) (V : S_M₀.Etale),
          (adj_sh.counit.app 𝒢).hom.app (Opposite.op V) =
            𝒢.obj.map (Opposite.op (adj_site.unit.app V))) ∧
        CategoryTheory.Limits.PreservesFiniteLimits
          (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            F₀ AddCommGrpCat.{u} _ J_M₀ J₀ hContF) ∧
        CategoryTheory.Limits.PreservesFiniteColimits
          (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            F₀ AddCommGrpCat.{u} _ J_M₀ J₀ hContF) := by
    intro K₀ M₀ _ _ _ hEt₀ S₀ S_M₀ π₀ J₀ J_M₀ F₀ B₀
    have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition
        (@AlgebraicGeometry.Etale.{u}) :=
      ⟨fun _ _ hf hg => by have := hf; have := hg; infer_instance⟩
    have _ : CategoryTheory.MorphismProperty.HasOfPostcompProperty
        (@AlgebraicGeometry.Etale.{u}) (@AlgebraicGeometry.Etale.{u}) :=
      ⟨fun {Y Z W} f g hg hfg => by
        have _ : AlgebraicGeometry.Etale g := hg
        exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale.{u})
          (W' := @AlgebraicGeometry.LocallyOfFiniteType.{u} ⊓
            @AlgebraicGeometry.FormallyUnramified.{u})
          f g ⟨inferInstance, inferInstance⟩ hfg⟩
    have _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale.{u}) π₀ :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale.{u}) π₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let map_M : S_M₀.Etale ⥤ S₀.Etale :=
      CategoryTheory.MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale.{u}) ⊤ hEt₀
    let adj₀ : map_M ⊣ B₀ := CategoryTheory.MorphismProperty.Over.mapPullbackAdj
      (@AlgebraicGeometry.Etale.{u}) ⊤ π₀ hEt₀ trivial
    let e_F : map_M ≅ F₀ :=
      CategoryTheory.NatIso.ofComponents
        (fun V => CategoryTheory.MorphismProperty.Over.isoMk (CategoryTheory.Iso.refl V.left)
          (Category.id_comp (V.hom ≫ π₀)))
        (fun {_ _} g => CategoryTheory.MorphismProperty.Over.Hom.ext
          ((Category.comp_id g.left).trans (Category.id_comp g.left).symm))
    let adj_site : F₀ ⊣ B₀ := adj₀.ofNatIsoLeft e_F
    have hContB : B₀.IsContinuous J₀ J_M₀ := by
      have _ : B₀.IsRightAdjoint := ⟨⟨F₀, ⟨adj_site⟩⟩⟩
      have hCompatB : CategoryTheory.CompatiblePreserving J_M₀ B₀ :=
        CategoryTheory.compatiblePreservingOfFlat J_M₀ B₀
      have hCovB : CategoryTheory.CoverPreserving J₀ J_M₀ B₀ :=
        CategoryTheory.CoverPreserving.mk (fun {U} {R} hR => by
          change R ∈ S₀.smallEtaleTopology U at hR
          change CategoryTheory.Sieve.functorPushforward B₀ R ∈
            S_M₀.smallEtaleTopology (B₀.obj U)
          rw [step2_mem_etale_iff S₀ U] at hR
          rw [step2_mem_etale_iff S_M₀ (B₀.obj U)]
          intro z
          let _ : AlgebraicGeometry.Etale U.hom := U.prop
          let fst_U := CategoryTheory.Limits.pullback.fst U.hom π₀
          let snd_U := CategoryTheory.Limits.pullback.snd U.hom π₀
          obtain ⟨Y, f, y, hfR, hEt_f, hfy⟩ := hR (fst_U.base z)
          let _ : AlgebraicGeometry.Etale Y.hom := Y.prop
          let _ : AlgebraicGeometry.Etale f.left := hEt_f
          let pr₁ := CategoryTheory.Limits.pullback.fst fst_U f.left
          let pr₂ := CategoryTheory.Limits.pullback.snd fst_U f.left
          have hEt_Z : AlgebraicGeometry.Etale (pr₁ ≫ snd_U) := by
            have _ : AlgebraicGeometry.Etale snd_U := (B₀.obj U).prop
            exact inferInstance
          let Z : S_M₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (pr₁ ≫ snd_U) hEt_Z
          let g_U : Z ⟶ B₀.obj U := CategoryTheory.MorphismProperty.Over.homMk pr₁ rfl
          obtain ⟨w₀, hw₁, _⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hfy.symm
          have hLiftEq : pr₂ ≫ Y.hom = (pr₁ ≫ snd_U) ≫ π₀ :=
            (congrArg (pr₂ ≫ ·) (CategoryTheory.MorphismProperty.Over.w f).symm).trans
              ((Category.assoc pr₂ f.left U.hom).symm.trans
                ((congrArg (· ≫ U.hom)
                  (CategoryTheory.Limits.pullback.condition (f := fst_U) (g := f.left)).symm).trans
                  ((Category.assoc pr₁ fst_U U.hom).trans
                    ((congrArg (pr₁ ≫ ·)
                      (CategoryTheory.Limits.pullback.condition (f := U.hom) (g := π₀))).trans
                      (Category.assoc pr₁ snd_U π₀).symm))))
          let g_Y_left := CategoryTheory.Limits.pullback.lift pr₂ (pr₁ ≫ snd_U) hLiftEq
          let g_Y : Z ⟶ B₀.obj Y :=
            CategoryTheory.MorphismProperty.Over.homMk g_Y_left
              (CategoryTheory.Limits.pullback.lift_snd pr₂ (pr₁ ≫ snd_U) hLiftEq)
          have hFactor : g_Y ≫ B₀.map f = g_U := by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            let Bf_left : CategoryTheory.Limits.pullback Y.hom π₀ ⟶
                CategoryTheory.Limits.pullback U.hom π₀ := (B₀.map f).left
            change g_Y_left ≫ Bf_left = pr₁
            apply CategoryTheory.Limits.pullback.hom_ext
            · have hMapFst : Bf_left ≫ fst_U =
                  CategoryTheory.Limits.pullback.fst Y.hom π₀ ≫ f.left :=
                CategoryTheory.Limits.pullback.lift_fst _ _ _
              exact (Category.assoc g_Y_left Bf_left fst_U).trans
                ((congrArg (g_Y_left ≫ ·) hMapFst).trans
                  ((Category.assoc g_Y_left _ f.left).symm.trans
                    ((congrArg (· ≫ f.left)
                      (CategoryTheory.Limits.pullback.lift_fst pr₂ (pr₁ ≫ snd_U) hLiftEq)).trans
                      (CategoryTheory.Limits.pullback.condition (f := fst_U) (g := f.left)).symm)))
            · have hMapSnd : Bf_left ≫ snd_U =
                  CategoryTheory.Limits.pullback.snd Y.hom π₀ :=
                CategoryTheory.MorphismProperty.Over.w (B₀.map f)
              exact (Category.assoc g_Y_left Bf_left snd_U).trans
                ((congrArg (g_Y_left ≫ ·) hMapSnd).trans
                  (CategoryTheory.Limits.pullback.lift_snd pr₂ (pr₁ ≫ snd_U) hLiftEq))
          have hgU_mem : (CategoryTheory.Sieve.functorPushforward B₀ R).arrows g_U := by
            rw [← hFactor]
            exact (CategoryTheory.Sieve.functorPushforward B₀ R).downward_closed
              (CategoryTheory.Sieve.image_mem_functorPushforward B₀ R hfR) g_Y
          have hEt_gU : AlgebraicGeometry.Etale g_U.left := by
            change AlgebraicGeometry.Etale pr₁
            exact inferInstance
          exact ⟨Z, g_U, w₀, hgU_mem, hEt_gU, hw₁⟩)
      exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompatB hCovB
    have hCompatF : CategoryTheory.CompatiblePreserving J₀ F₀ :=
      CategoryTheory.CompatiblePreserving.mk (fun 𝒢 {Z} {T} {x} hx {Y₁ Y₂ X} f₁ f₂ {g₁ g₂}
          hg₁ hg₂ hfg => by
        have h_left : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
          congrArg (fun m => m.left) hfg
        have h_hom : f₁.left ≫ Y₁.hom = f₂.left ≫ Y₂.hom :=
          calc
            f₁.left ≫ Y₁.hom = f₁.left ≫ (g₁.left ≫ Z.hom) :=
              congrArg (f₁.left ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₁).symm
            _ = (f₁.left ≫ g₁.left) ≫ Z.hom := (Category.assoc _ _ _).symm
            _ = (f₂.left ≫ g₂.left) ≫ Z.hom := by rw [h_left]
            _ = f₂.left ≫ (g₂.left ≫ Z.hom) := Category.assoc _ _ _
            _ = f₂.left ≫ Y₂.hom :=
              congrArg (f₂.left ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₂)
        let χ : X.left ⟶ S_M₀ := f₁.left ≫ Y₁.hom
        have h_χπ : χ ≫ π₀ = X.hom :=
          (Category.assoc f₁.left Y₁.hom π₀).trans (CategoryTheory.MorphismProperty.Over.w f₁)
        have hEt_χ : AlgebraicGeometry.Etale χ :=
          CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale.{u})
            (W' := @AlgebraicGeometry.Etale.{u}) χ π₀ hEt₀ (h_χπ.symm ▸ X.prop)
        let W : S_M₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ χ hEt_χ
        let p₁ : W ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk f₁.left rfl
        let p₂ : W ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk f₂.left h_hom.symm
        have hp : p₁ ≫ g₁ = p₂ ≫ g₂ := CategoryTheory.MorphismProperty.Over.Hom.ext h_left
        have hcompat := hx p₁ p₂ hg₁ hg₂ hp
        let u : X ⟶ F₀.obj W :=
          CategoryTheory.MorphismProperty.Over.homMk (𝟙 X.left)
            ((Category.id_comp (χ ≫ π₀)).trans h_χπ)
        have hu₁ : u ≫ F₀.map p₁ = f₁ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext (Category.id_comp f₁.left)
        have hu₂ : u ≫ F₀.map p₂ = f₂ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext (Category.id_comp f₂.left)
        have hmap := congrArg (CategoryTheory.ConcreteCategory.hom (𝒢.obj.map u.op)) hcompat
        simpa [← CategoryTheory.ConcreteCategory.comp_apply, ← 𝒢.obj.map_comp, ← op_comp,
          hu₁, hu₂] using hmap)
    have hCovF : CategoryTheory.CoverPreserving J_M₀ J₀ F₀ :=
      CategoryTheory.CoverPreserving.mk (fun {V} {R} hR => by
        change R ∈ S_M₀.smallEtaleTopology V at hR
        change CategoryTheory.Sieve.functorPushforward F₀ R ∈ S₀.smallEtaleTopology (F₀.obj V)
        rw [step2_mem_etale_iff S_M₀ V] at hR
        rw [step2_mem_etale_iff S₀ (F₀.obj V)]
        intro x
        obtain ⟨Y, f, y, hfR, hEt_f, hfy⟩ := hR x
        exact ⟨F₀.obj Y, F₀.map f, y,
          CategoryTheory.Sieve.image_mem_functorPushforward F₀ R hfR, hEt_f, hfy⟩)
    have hContF : F₀.IsContinuous J_M₀ J₀ :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving hCompatF hCovF
    let F_M_star :=
      @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        F₀ AddCommGrpCat.{u} _ J_M₀ J₀ hContF
    let B_M_push :=
      @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        B₀ AddCommGrpCat.{u} _ J₀ J_M₀ hContB
    let adj_sh : F_M_star ⊣ B_M_push :=
      CategoryTheory.Adjunction.mkOfUnitCounit
        { unit :=
            { app := fun ℱ =>
                { hom :=
                    { app := fun U_op => ℱ.obj.map (Opposite.op (adj_site.counit.app U_op.unop))
                      naturality := fun U₁ U₂ g => by
                        change ℱ.obj.map (Opposite.op g.unop) ≫
                            ℱ.obj.map (Opposite.op (adj_site.counit.app U₂.unop)) =
                          ℱ.obj.map (Opposite.op (adj_site.counit.app U₁.unop)) ≫
                            ℱ.obj.map (Opposite.op (F₀.map (B₀.map g.unop)))
                        rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]
                        exact congrArg (fun k => ℱ.obj.map (Opposite.op k))
                          (adj_site.counit.naturality g.unop).symm } }
              naturality := fun ℱ_a ℱ_b φ => by
                apply CategoryTheory.Sheaf.hom_ext
                refine CategoryTheory.NatTrans.ext (funext fun U_op => ?_)
                exact (φ.hom.naturality (Opposite.op (adj_site.counit.app U_op.unop))).symm }
          counit :=
            { app := fun 𝒢 =>
                { hom :=
                    { app := fun V_op => 𝒢.obj.map (Opposite.op (adj_site.unit.app V_op.unop))
                      naturality := fun V₁ V₂ g => by
                        change 𝒢.obj.map (Opposite.op (B₀.map (F₀.map g.unop))) ≫
                            𝒢.obj.map (Opposite.op (adj_site.unit.app V₂.unop)) =
                          𝒢.obj.map (Opposite.op (adj_site.unit.app V₁.unop)) ≫
                            𝒢.obj.map (Opposite.op g.unop)
                        rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp]
                        exact congrArg (fun k => 𝒢.obj.map (Opposite.op k))
                          (adj_site.unit.naturality g.unop).symm } }
              naturality := fun 𝒢_a 𝒢_b ψ => by
                apply CategoryTheory.Sheaf.hom_ext
                refine CategoryTheory.NatTrans.ext (funext fun V_op => ?_)
                exact (ψ.hom.naturality (Opposite.op (adj_site.unit.app V_op.unop))).symm }
          left_triangle := by
            refine CategoryTheory.NatTrans.ext (funext fun ℱ =>
              CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun V_op => ?_)))
            change ℱ.obj.map (Opposite.op (adj_site.counit.app (F₀.obj V_op.unop))) ≫
              ℱ.obj.map (Opposite.op (F₀.map (adj_site.unit.app V_op.unop))) = 𝟙 _
            rw [← ℱ.obj.map_comp]
            change ℱ.obj.map (Opposite.op
              (F₀.map (adj_site.unit.app V_op.unop) ≫
                adj_site.counit.app (F₀.obj V_op.unop))) = 𝟙 _
            rw [adj_site.left_triangle_components V_op.unop]
            exact ℱ.obj.map_id (Opposite.op (F₀.obj V_op.unop))
          right_triangle := by
            refine CategoryTheory.NatTrans.ext (funext fun 𝒢 =>
              CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun U_op => ?_)))
            change 𝒢.obj.map (Opposite.op (B₀.map (adj_site.counit.app U_op.unop))) ≫
              𝒢.obj.map (Opposite.op (adj_site.unit.app (B₀.obj U_op.unop))) = 𝟙 _
            rw [← 𝒢.obj.map_comp]
            change 𝒢.obj.map (Opposite.op
              (adj_site.unit.app (B₀.obj U_op.unop) ≫
                B₀.map (adj_site.counit.app U_op.unop))) = 𝟙 _
            rw [adj_site.right_triangle_components U_op.unop]
            exact 𝒢.obj.map_id (Opposite.op (B₀.obj U_op.unop)) }
    have hColim : CategoryTheory.Limits.PreservesFiniteColimits F_M_star := by
      have _ := adj_sh.leftAdjoint_preservesColimits
      exact inferInstance
    have hLim : CategoryTheory.Limits.PreservesFiniteLimits F_M_star := by
      let S2P₀ := CategoryTheory.sheafToPresheaf J₀ AddCommGrpCat.{u}
      let S2P_M₀ := CategoryTheory.sheafToPresheaf J_M₀ AddCommGrpCat.{u}
      let W_F := (CategoryTheory.Functor.whiskeringLeft
        (S_M₀.Etale)ᵒᵖ (S₀.Etale)ᵒᵖ AddCommGrpCat.{u}).obj F₀.op
      have hCompLim : CategoryTheory.Limits.PreservesFiniteLimits (F_M_star.comp S2P_M₀) := by
        change CategoryTheory.Limits.PreservesFiniteLimits (S2P₀.comp W_F)
        exact @CategoryTheory.Limits.comp_preservesFiniteLimits _ _ _ _ _ _
          S2P₀ W_F inferInstance inferInstance
      exact @CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _
        F_M_star S2P_M₀ hCompLim inferInstance
    exact ⟨hContF, hContB, adj_site, adj_sh, fun _ _ => rfl, fun _ _ => rfl, hLim, hColim⟩

  have step3_discrete_vec_sheaf : ∀ (M₀ : Type u) [Field M₀] (ℓ₀ n : ℕ),
      CategoryTheory.Presheaf.IsSheaf
        (AlgebraicGeometry.Spec (CommRingCat.of M₀)).smallEtaleTopology
        (weilAltCdDiscreteVecPresheaf (AlgebraicGeometry.Spec (CommRingCat.of M₀)) ℓ₀ n) := by
    intro M₀ _ ℓ₀ n
    let S_M₀ := AlgebraicGeometry.Spec (CommRingCat.of M₀)
    have _ : CategoryTheory.MorphismProperty.HasOfPostcompProperty
        (@AlgebraicGeometry.Etale.{u}) (@AlgebraicGeometry.Etale.{u}) :=
      ⟨fun {Y Z W} f g hg hfg => by
        have _ : AlgebraicGeometry.Etale g := hg
        exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale.{u})
          (W' := @AlgebraicGeometry.LocallyOfFiniteType.{u} ⊓
            @AlgebraicGeometry.FormallyUnramified.{u})
          f g ⟨inferInstance, inferInstance⟩ hfg⟩
    intro E V R hR x hx
    have hR' := (step2_mem_etale_iff S_M₀ V R).mp hR
    choose W_p g_p q_p hg_p hEt_gp hbase_p using hR'
    let s_hom : E ⟶ (weilAltCdDiscreteVecPresheaf S_M₀ ℓ₀ n).obj (Opposite.op V) :=
      AddCommGrpCat.ofHom
        { toFun := fun e p => (x (g_p p) (hg_p p)).hom e (q_p p)
          map_zero' := by
            apply funext; intro p; apply funext; intro j
            exact congrFun (congrFun ((x (g_p p) (hg_p p)).hom.map_zero) (q_p p)) j
          map_add' := fun e₁ e₂ => by
            apply funext; intro p; apply funext; intro j
            exact congrFun (congrFun ((x (g_p p) (hg_p p)).hom.map_add e₁ e₂) (q_p p)) j }
    refine ⟨s_hom, fun {W} g hg => ?_, fun s' hs' => ?_⟩
    · apply AddCommGrpCat.hom_ext
      ext e
      apply funext; intro w; apply funext; intro j
      let p : ↥V.left := g.left.base w
      have hEt_g : AlgebraicGeometry.Etale g.left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale.{u})
          (W' := @AlgebraicGeometry.Etale.{u}) g.left V.hom V.prop
          ((CategoryTheory.MorphismProperty.Over.w g).symm ▸ W.prop)
      have _ : AlgebraicGeometry.Etale (g_p p).left := hEt_gp p
      let pr₁ := CategoryTheory.Limits.pullback.fst g.left (g_p p).left
      let pr₂ := CategoryTheory.Limits.pullback.snd g.left (g_p p).left
      have hEt_Z : AlgebraicGeometry.Etale (pr₁ ≫ W.hom) := by
        have _ : AlgebraicGeometry.Etale W.hom := W.prop
        exact inferInstance
      let Z : S_M₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (pr₁ ≫ W.hom) hEt_Z
      let h₁ : Z ⟶ W := CategoryTheory.MorphismProperty.Over.homMk pr₁ rfl
      let h₂ : Z ⟶ W_p p := CategoryTheory.MorphismProperty.Over.homMk pr₂
        (calc
          pr₂ ≫ (W_p p).hom = pr₂ ≫ ((g_p p).left ≫ V.hom) :=
            congrArg (pr₂ ≫ ·) (CategoryTheory.MorphismProperty.Over.w (g_p p)).symm
          _ = (pr₂ ≫ (g_p p).left) ≫ V.hom := (Category.assoc _ _ _).symm
          _ = (pr₁ ≫ g.left) ≫ V.hom := by rw [CategoryTheory.Limits.pullback.condition]
          _ = pr₁ ≫ (g.left ≫ V.hom) := Category.assoc _ _ _
          _ = pr₁ ≫ W.hom := congrArg (pr₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w g))
      have hcomm : h₁ ≫ g = h₂ ≫ g_p p :=
        CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
      obtain ⟨z, hz₁, hz₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w (q_p p) (hbase_p p).symm
      have hcomp_eq := hx h₁ h₂ hg (hg_p p) hcomm
      have heval := congrFun (congrFun (congrArg (fun φ => φ.hom e) hcomp_eq) z) j
      change (x (g_p p) (hg_p p)).hom e (q_p p) j = (x g hg).hom e w j
      dsimp [weilAltCdDiscreteVecPresheaf] at heval
      change (x g hg).hom e (pr₁.base z) j = (x (g_p p) (hg_p p)).hom e (pr₂.base z) j at heval
      rw [hz₁, hz₂] at heval
      exact heval.symm
    · apply AddCommGrpCat.hom_ext
      ext e
      apply funext; intro p; apply funext; intro j
      have hsp := hs' (g_p p) (hg_p p)
      have heval : s'.hom e ((g_p p).left.base (q_p p)) j =
          (x (g_p p) (hg_p p)).hom e (q_p p) j :=
        congrFun (congrFun (congrArg (fun φ => φ.hom e) hsp) (q_p p)) j
      rw [hbase_p p] at heval
      exact heval

  have step3_shear_align : ∀ (M₀ : Type u) [Field M₀] (ℓ₀ : ℕ) [Fact (Nat.Prime ℓ₀)]
      (r₀ : ℕ) (v₀ : Fin (r₀ + 1) → ZMod ℓ₀), v₀ ≠ 0 →
      let S_M₀ := AlgebraicGeometry.Spec (CommRingCat.of M₀)
      ∃ Θ : weilAltCdDiscreteVecPresheaf S_M₀ ℓ₀ (r₀ + 1) ≅
          weilAltCdDiscreteVecPresheaf S_M₀ ℓ₀ (r₀ + 1),
        ∀ (V : S_M₀.Etale) (a : ↥V.left → ZMod ℓ₀) (x : ↥V.left),
          (Θ.hom.app (Opposite.op V)).hom (fun y => (a y) • v₀) x = Fin.cons (a x) 0 := by
    intro M₀ _ ℓ₀ _ r₀ v₀ hv₀ S_M₀
    obtain ⟨k₀, hk₀⟩ := Function.ne_iff.mp hv₀
    let τ := Equiv.swap (0 : Fin (r₀ + 1)) k₀
    let v₁ : Fin (r₀ + 1) → ZMod ℓ₀ := fun i => v₀ (τ i)
    have hv₁_0 : v₁ 0 ≠ 0 := by
      dsimp [v₁, τ]
      rwa [Equiv.swap_apply_left]
    let Φ_fun : (Fin (r₀ + 1) → ZMod ℓ₀) → (Fin (r₀ + 1) → ZMod ℓ₀) :=
      fun u i =>
        (Fin.cons (u 0 * v₁ 0) (fun j => u (Fin.succ j) + u 0 * v₁ (Fin.succ j)) :
          Fin (r₀ + 1) → ZMod ℓ₀) (τ i)
    let Ψ_fun : (Fin (r₀ + 1) → ZMod ℓ₀) → (Fin (r₀ + 1) → ZMod ℓ₀) :=
      fun w =>
        Fin.cons (w (τ 0) * (v₁ 0)⁻¹)
          (fun j => w (τ (Fin.succ j)) - (w (τ 0) * (v₁ 0)⁻¹) * v₁ (Fin.succ j))
    have hΨΦ : ∀ u, Ψ_fun (Φ_fun u) = u := by
      intro u
      ext i
      have hττ : ∀ idx, Φ_fun u (τ idx) =
          (Fin.cons (u 0 * v₁ 0) (fun j => u (Fin.succ j) + u 0 * v₁ (Fin.succ j)) :
            Fin (r₀ + 1) → ZMod ℓ₀) idx := by
        intro idx
        dsimp [Φ_fun, τ]
        rw [Equiv.swap_apply_self]
      refine Fin.cases ?_ ?_ i
      · dsimp [Ψ_fun]
        simp only [Fin.cons_zero]
        rw [hττ 0]
        simp only [Fin.cons_zero]
        rw [mul_assoc, mul_inv_cancel₀ hv₁_0, mul_one]
      · intro j
        dsimp [Ψ_fun]
        simp only [Fin.cons_succ]
        rw [hττ 0, hττ (Fin.succ j)]
        simp only [Fin.cons_zero, Fin.cons_succ]
        rw [mul_assoc (u 0) (v₁ 0), mul_inv_cancel₀ hv₁_0, mul_one, add_sub_cancel_right]
    have hΦΨ : ∀ w, Φ_fun (Ψ_fun w) = w := by
      intro w
      ext i
      dsimp [Φ_fun]
      have h_inner : ∀ idx,
          (Fin.cons (Ψ_fun w 0 * v₁ 0)
            (fun j => Ψ_fun w (Fin.succ j) + Ψ_fun w 0 * v₁ (Fin.succ j)) :
              Fin (r₀ + 1) → ZMod ℓ₀) idx = w (τ idx) := by
        intro idx
        refine Fin.cases ?_ ?_ idx
        · dsimp [Ψ_fun]
          simp only [Fin.cons_zero]
          rw [mul_assoc, inv_mul_cancel₀ hv₁_0, mul_one]
        · intro j
          dsimp [Ψ_fun]
          simp only [Fin.cons_zero, Fin.cons_succ]
          exact sub_add_cancel _ _
      rw [h_inner (τ i)]
      dsimp [τ]
      rw [Equiv.swap_apply_self]
    have hΦ_cons : ∀ c : ZMod ℓ₀, Φ_fun (Fin.cons c 0) = c • v₀ := by
      intro c
      ext i
      dsimp [Φ_fun]
      simp only [Fin.cons_zero, Fin.cons_succ, Pi.zero_apply, zero_add]
      have h_inner : ∀ idx,
          (Fin.cons (c * v₁ 0) (fun j => c * v₁ (Fin.succ j)) :
            Fin (r₀ + 1) → ZMod ℓ₀) idx = c * v₁ idx := by
        intro idx
        refine Fin.cases ?_ ?_ idx <;> simp
      rw [h_inner (τ i)]
      dsimp [v₁, τ]
      rw [Equiv.swap_apply_self]
    have hΨ_smul : ∀ c : ZMod ℓ₀, Ψ_fun (c • v₀) = Fin.cons c 0 := by
      intro c
      rw [← hΦ_cons c, hΨΦ]
    refine ⟨{
      hom :=
        { app := fun _ => AddCommGrpCat.ofHom
            { toFun := fun f x => Ψ_fun (f x)
              map_zero' := by
                ext x i
                dsimp [Ψ_fun]
                refine Fin.cases ?_ ?_ i <;> simp
              map_add' := fun f₁ f₂ => by
                ext x i
                dsimp [Ψ_fun]
                refine Fin.cases ?_ ?_ i
                · simp [add_mul]
                · intro j
                  simp
                  ring }
          naturality := fun _ _ _ => rfl }
      inv :=
        { app := fun _ => AddCommGrpCat.ofHom
            { toFun := fun f x => Φ_fun (f x)
              map_zero' := by
                ext x i
                dsimp [Φ_fun]
                generalize τ i = idx
                refine Fin.cases ?_ ?_ idx <;> simp
              map_add' := fun f₁ f₂ => by
                ext x i
                dsimp [Φ_fun]
                generalize τ i = idx
                refine Fin.cases ?_ ?_ idx
                · simp [add_mul]
                · intro j
                  simp
                  ring }
          naturality := fun _ _ _ => rfl }
      hom_inv_id := by
        apply CategoryTheory.NatTrans.ext; ext V_op f
        exact funext fun x => funext fun i => congrFun (hΦΨ (f x)) i
      inv_hom_id := by
        apply CategoryTheory.NatTrans.ext; ext V_op f
        exact funext fun x => funext fun i => congrFun (hΨΦ (f x)) i },
      fun V a x => hΨ_smul (a x)⟩

  have step4_galois_fixed_section : ∀ (K₀ : Type u) [Field K₀]
      (ℓ₀ : ℕ) [Fact (Nat.Prime ℓ₀)]
      (M₀ : Type u) [Field M₀] [Algebra K₀ M₀] [FiniteDimensional K₀ M₀] [IsGalois K₀ M₀]
      (hP₀ : IsPGroup ℓ₀ (M₀ ≃ₐ[K₀] M₀))
      (hEt₀ : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ M₀))))
      (r₀ : ℕ)
      (ℱ : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of K₀)).smallEtaleTopology AddCommGrpCat.{u}),
      Nonempty ((CategoryTheory.Functor.comp (weilAltCdFieldEtaleMap hEt₀).op ℱ.obj) ≅
        weilAltCdDiscreteVecPresheaf (AlgebraicGeometry.Spec (CommRingCat.of M₀)) ℓ₀ (r₀ + 1)) →
      let S₀ := AlgebraicGeometry.Spec (CommRingCat.of K₀)
      let S_M₀ := AlgebraicGeometry.Spec (CommRingCat.of M₀)
      let T₀ := weilCupPDTraceTerminalObj S₀
      let T_M₀ := weilCupPDTraceTerminalObj S_M₀
      let F₀ := weilAltCdFieldEtaleMap hEt₀
      let u_M₀ : F₀.obj T_M₀ ⟶ T₀ :=
        CategoryTheory.MorphismProperty.Over.homMk (F₀.obj T_M₀).hom
          (Category.comp_id (F₀.obj T_M₀).hom)
      ∃ s₀ : ↥(ℱ.obj.obj (Opposite.op T₀)), (ℱ.obj.map (Opposite.op u_M₀)).hom s₀ ≠ 0 := by
    intro K₀ _ ℓ₀ _ M₀ _ _ _ _ hP₀ hEt₀ r₀ ℱ hSplit S₀ S_M₀ T₀ T_M₀ F₀ u_M₀
    have hPrime₀ : Nat.Prime ℓ₀ := Fact.out
    have _ : CategoryTheory.MorphismProperty.HasOfPostcompProperty
        (@AlgebraicGeometry.Etale.{u}) (@AlgebraicGeometry.Etale.{u}) :=
      ⟨fun {Y Z W} f g hg hfg => by
        have _ : AlgebraicGeometry.Etale g := hg
        exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale.{u})
          (W' := @AlgebraicGeometry.LocallyOfFiniteType.{u} ⊓
            @AlgebraicGeometry.FormallyUnramified.{u})
          f g ⟨inferInstance, inferInstance⟩ hfg⟩
    let π₀ : S_M₀ ⟶ S₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ M₀))
    let J₀ := S₀.smallEtaleTopology
    let G₁ := (M₀ ≃ₐ[K₀] M₀)
    let W₁ := ↥(ℱ.obj.obj (Opposite.op (F₀.obj T_M₀)))
    let m_gal : G₁ → (F₀.obj T_M₀ ⟶ F₀.obj T_M₀) := fun σ =>
      CategoryTheory.MorphismProperty.Over.homMk
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom))
        (by
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) ≫
              (𝟙 S_M₀ ≫ π₀) = 𝟙 S_M₀ ≫ π₀
          rw [Category.id_comp, ← AlgebraicGeometry.Spec.map_comp]
          exact congrArg AlgebraicGeometry.Spec.map
            (CommRingCat.hom_ext σ.toAlgHom.comp_algebraMap))
    have hm_gal_one : m_gal 1 = 𝟙 (F₀.obj T_M₀) :=
      CategoryTheory.MorphismProperty.Over.Hom.ext (AlgebraicGeometry.Spec.map_id _)
    have hm_gal_mul : ∀ σ₁ σ₂ : G₁, m_gal (σ₁ * σ₂) = m_gal σ₁ ≫ m_gal σ₂ := fun σ₁ σ₂ =>
      CategoryTheory.MorphismProperty.Over.Hom.ext
        ((congrArg AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom_comp σ₂.toRingHom σ₁.toRingHom)).trans
          (AlgebraicGeometry.Spec.map_comp _ _))
    let _ : MulAction G₁ W₁ :=
      { smul := fun σ w => (ℱ.obj.map (Opposite.op (m_gal σ))).hom w
        one_smul := fun w => by
          change (ℱ.obj.map (Opposite.op (m_gal 1))).hom w = w
          rw [hm_gal_one]
          exact congrArg (fun φ => φ.hom w) (ℱ.obj.map_id (Opposite.op (F₀.obj T_M₀)))
        mul_smul := fun σ₁ σ₂ w => by
          change (ℱ.obj.map (Opposite.op (m_gal (σ₁ * σ₂)))).hom w =
            (ℱ.obj.map (Opposite.op (m_gal σ₁))).hom
              ((ℱ.obj.map (Opposite.op (m_gal σ₂))).hom w)
          rw [hm_gal_mul]
          exact congrArg (fun φ => φ.hom w)
            (ℱ.obj.map_comp (Opposite.op (m_gal σ₂)) (Opposite.op (m_gal σ₁))) }
    have _ : Subsingleton ↥S_M₀ := step1_spec_subsingleton M₀
    let pt_M : ↥S_M₀ := Classical.arbitrary ↥S_M₀
    let _ : Unique ↥S_M₀ :=
      { default := pt_M
        uniq := fun x => Subsingleton.elim x pt_M }
    let e := Classical.choice hSplit
    let e_W : W₁ ≃ (Fin (r₀ + 1) → ZMod ℓ₀) :=
      (e.app (Opposite.op T_M₀)).addCommGroupIsoToAddEquiv.toEquiv.trans
        (Equiv.funUnique ↥S_M₀ (Fin (r₀ + 1) → ZMod ℓ₀))
    have _ : Finite W₁ := Finite.of_equiv _ e_W.symm
    have _ : NeZero ℓ₀ := ⟨hPrime₀.ne_zero⟩
    have hCardW : Nat.card W₁ = ℓ₀ ^ (r₀ + 1) := by
      rw [Nat.card_congr e_W, Nat.card_fun, Nat.card_zmod, Nat.card_fin]
    have hMod := hP₀.card_modEq_card_fixedPoints W₁
    rw [hCardW] at hMod
    have hdvd_pow : ℓ₀ ∣ ℓ₀ ^ (r₀ + 1) := dvd_pow_self ℓ₀ (Nat.succ_ne_zero r₀)
    have hdvd_fix : ℓ₀ ∣ Nat.card ↥(MulAction.fixedPoints G₁ W₁) :=
      (Nat.ModEq.dvd_iff hMod (dvd_refl ℓ₀)).mp hdvd_pow
    have hZeroFix : (0 : W₁) ∈ MulAction.fixedPoints G₁ W₁ :=
      fun σ => (ℱ.obj.map (Opposite.op (m_gal σ))).hom.map_zero
    have _ : Nonempty ↥(MulAction.fixedPoints G₁ W₁) := ⟨⟨0, hZeroFix⟩⟩
    have hPosFix : 0 < Nat.card ↥(MulAction.fixedPoints G₁ W₁) := Nat.card_pos
    have hGe2 : 1 < Nat.card ↥(MulAction.fixedPoints G₁ W₁) :=
      lt_of_lt_of_le hPrime₀.one_lt (Nat.le_of_dvd hPosFix hdvd_fix)
    have _ : Nontrivial ↥(MulAction.fixedPoints G₁ W₁) :=
      Finite.one_lt_card_iff_nontrivial.mp hGe2
    obtain ⟨⟨w₀, hw₀_fix⟩, hw₀_ne0⟩ := exists_ne (⟨0, hZeroFix⟩ : ↥(MulAction.fixedPoints G₁ W₁))
    have hw₀_ne : w₀ ≠ 0 := fun h0 => hw₀_ne0 (Subtype.ext h0)
    have hSurj_π₀ : AlgebraicGeometry.Surjective π₀ := by
      have _ : Subsingleton ↥S₀ := step1_spec_subsingleton K₀
      exact ⟨fun x => ⟨pt_M, Subsingleton.elim _ _⟩⟩
    have _ : AlgebraicGeometry.Surjective u_M₀.left := by
      have hu_eq : u_M₀.left = π₀ := Category.id_comp π₀
      rw [hu_eq]
      exact hSurj_π₀
    have hMem_uM := step2_singleton_mem u_M₀
    have hℱ_type : CategoryTheory.Presieve.IsSheaf J₀
        (ℱ.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type J₀ _).mp
        (CategoryTheory.GrothendieckTopology.HasSheafCompose.isSheaf ℱ.obj ℱ.property)
    have hNormalFactor : ∀ (E : Type u) [Field E] [Algebra K₀ E]
        (r₁ r₂ : CommRingCat.of M₀ ⟶ CommRingCat.of E),
        CommRingCat.ofHom (algebraMap K₀ M₀) ≫ r₁ = CommRingCat.ofHom (algebraMap K₀ E) →
        CommRingCat.ofHom (algebraMap K₀ M₀) ≫ r₂ = CommRingCat.ofHom (algebraMap K₀ E) →
        ∃ σ : G₁, CommRingCat.ofHom σ.toRingHom ≫ r₁ = r₂ := by
      intro E _ _ r₁ r₂ hr₁_alg hr₂_alg
      let φ₁ : M₀ →ₐ[K₀] E :=
        { r₁.hom with commutes' := fun k => congrArg (fun f => f.hom k) hr₁_alg }
      let φ₂ : M₀ →ₐ[K₀] E :=
        { r₂.hom with commutes' := fun k => congrArg (fun f => f.hom k) hr₂_alg }
      let L₁ : IntermediateField K₀ E := φ₁.fieldRange
      let L₂ : IntermediateField K₀ E := φ₂.fieldRange
      let e₁ : M₀ ≃ₐ[K₀] ↥L₁ :=
        AlgEquiv.ofBijective
          { toFun := fun m => ⟨φ₁ m, ⟨m, rfl⟩⟩
            map_one' := Subtype.ext φ₁.map_one
            map_mul' := fun a b => Subtype.ext (φ₁.map_mul a b)
            map_zero' := Subtype.ext φ₁.map_zero
            map_add' := fun a b => Subtype.ext (φ₁.map_add a b)
            commutes' := fun k => Subtype.ext (φ₁.commutes k) }
          ⟨fun a b hab => φ₁.injective (congrArg Subtype.val hab),
           fun ⟨y, m, hm⟩ => ⟨m, Subtype.ext hm⟩⟩
      let e₂ : M₀ ≃ₐ[K₀] ↥L₂ :=
        AlgEquiv.ofBijective
          { toFun := fun m => ⟨φ₂ m, ⟨m, rfl⟩⟩
            map_one' := Subtype.ext φ₂.map_one
            map_mul' := fun a b => Subtype.ext (φ₂.map_mul a b)
            map_zero' := Subtype.ext φ₂.map_zero
            map_add' := fun a b => Subtype.ext (φ₂.map_add a b)
            commutes' := fun k => Subtype.ext (φ₂.commutes k) }
          ⟨fun a b hab => φ₂.injective (congrArg Subtype.val hab),
           fun ⟨y, m, hm⟩ => ⟨m, Subtype.ext hm⟩⟩
      have _ : Normal K₀ ↥L₁ := (AlgEquiv.transfer_normal e₁).mp inferInstance
      have hCompRange : (φ₂.comp e₁.symm.toAlgHom).fieldRange = L₁ :=
        AlgHom.fieldRange_of_normal (φ₂.comp e₁.symm.toAlgHom)
      have hEqL : L₂ = L₁ := by
        rw [← hCompRange]
        ext y
        simp only [AlgHom.mem_fieldRange, AlgHom.comp_apply]
        exact ⟨fun ⟨m, hm⟩ => ⟨e₁ m, by
            change φ₂ (e₁.symm (e₁ m)) = y
            rw [e₁.symm_apply_apply]
            exact hm⟩,
          fun ⟨x, hx⟩ => ⟨e₁.symm x, hx⟩⟩
      let σ : G₁ := (e₂.trans (IntermediateField.equivOfEq hEqL)).trans e₁.symm
      refine ⟨σ, CommRingCat.hom_ext (RingHom.ext fun m => ?_)⟩
      have h_app : e₁ (σ m) = (IntermediateField.equivOfEq hEqL) (e₂ m) :=
        e₁.apply_symm_apply _
      exact congrArg Subtype.val h_app
    have hEq_pairs : ∀ {Z : S₀.Etale} (g₁ g₂ : Z ⟶ F₀.obj T_M₀),
        g₁ ≫ u_M₀ = g₂ ≫ u_M₀ →
        (ℱ.obj.map g₁.op).hom w₀ = (ℱ.obj.map g₂.op).hom w₀ := by
      intro Z g₁ g₂ _
      have hCharts := (step1_etale_field_local K₀ Z).2
      choose E_z hField_z hAlg_z W_z h_z e_Wz he_Wz_hom hmem_z using hCharts
      let R_Z : CategoryTheory.Presieve Z := CategoryTheory.Presieve.ofArrows W_z h_z
      have hMem_Z : CategoryTheory.Sieve.generate R_Z ∈ J₀ Z := by
        change CategoryTheory.Sieve.generate R_Z ∈ S₀.smallEtaleTopology Z
        rw [step2_mem_etale_iff S₀ Z]
        intro z
        obtain ⟨y, hy⟩ := hmem_z z
        have hEt_hz : AlgebraicGeometry.Etale (h_z z).left :=
          CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale.{u})
            (W' := @AlgebraicGeometry.Etale.{u}) (h_z z).left Z.hom Z.prop
            ((CategoryTheory.MorphismProperty.Over.w (h_z z)).symm ▸ (W_z z).prop)
        exact ⟨W_z z, h_z z, y, CategoryTheory.Sieve.ofArrows_mk W_z h_z z, hEt_hz, hy⟩
      refine (hℱ_type.isSheafFor R_Z hMem_Z).isSeparatedFor.ext (fun W q hq => ?_)
      cases hq with
      | mk z =>
        let q₁ : W_z z ⟶ F₀.obj T_M₀ := h_z z ≫ g₁
        let q₂ : W_z z ⟶ F₀.obj T_M₀ := h_z z ≫ g₂
        let q₁_left : (W_z z).left ⟶ S_M₀ := q₁.left
        let q₂_left : (W_z z).left ⟶ S_M₀ := q₂.left
        let R_Ez : CommRingCat.{u} := @CommRingCat.of (E_z z) (hField_z z).toCommRing
        let alg_Ez : CommRingCat.of K₀ ⟶ R_Ez :=
          @CommRingCat.ofHom _ _ _ (hField_z z).toCommRing
            (@algebraMap K₀ (E_z z) _ (hField_z z).toSemiring (hAlg_z z))
        let q₁_spec : AlgebraicGeometry.Spec R_Ez ⟶ S_M₀ := (e_Wz z).hom ≫ q₁_left
        let q₂_spec : AlgebraicGeometry.Spec R_Ez ⟶ S_M₀ := (e_Wz z).hom ≫ q₂_left
        let r₁ : CommRingCat.of M₀ ⟶ R_Ez :=
          (AlgebraicGeometry.Spec.fullyFaithful.preimage q₁_spec).unop
        let r₂ : CommRingCat.of M₀ ⟶ R_Ez :=
          (AlgebraicGeometry.Spec.fullyFaithful.preimage q₂_spec).unop
        have hr₁_spec : AlgebraicGeometry.Spec.map r₁ = q₁_spec :=
          AlgebraicGeometry.Spec.fullyFaithful.map_preimage q₁_spec
        have hr₂_spec : AlgebraicGeometry.Spec.map r₂ = q₂_spec :=
          AlgebraicGeometry.Spec.fullyFaithful.map_preimage q₂_spec
        have hq₁_hom : q₁_spec ≫ π₀ = AlgebraicGeometry.Spec.map alg_Ez := by
          have hw₁ : q₁_left ≫ π₀ = (W_z z).hom := by
            have hw := CategoryTheory.MorphismProperty.Over.w q₁
            change q₁_left ≫ (𝟙 S_M₀ ≫ π₀) = (W_z z).hom at hw
            rwa [Category.id_comp] at hw
          exact (Category.assoc (e_Wz z).hom q₁_left π₀).trans
            ((congrArg ((e_Wz z).hom ≫ ·) hw₁).trans (he_Wz_hom z))
        have hq₂_hom : q₂_spec ≫ π₀ = AlgebraicGeometry.Spec.map alg_Ez := by
          have hw₂ : q₂_left ≫ π₀ = (W_z z).hom := by
            have hw := CategoryTheory.MorphismProperty.Over.w q₂
            change q₂_left ≫ (𝟙 S_M₀ ≫ π₀) = (W_z z).hom at hw
            rwa [Category.id_comp] at hw
          exact (Category.assoc (e_Wz z).hom q₂_left π₀).trans
            ((congrArg ((e_Wz z).hom ≫ ·) hw₂).trans (he_Wz_hom z))
        have hr₁_alg : CommRingCat.ofHom (algebraMap K₀ M₀) ≫ r₁ = alg_Ez :=
          AlgebraicGeometry.Spec.map_injective
            ((AlgebraicGeometry.Spec.map_comp _ _).trans
              ((congrArg (· ≫ π₀) hr₁_spec).trans hq₁_hom))
        have hr₂_alg : CommRingCat.ofHom (algebraMap K₀ M₀) ≫ r₂ = alg_Ez :=
          AlgebraicGeometry.Spec.map_injective
            ((AlgebraicGeometry.Spec.map_comp _ _).trans
              ((congrArg (· ≫ π₀) hr₂_spec).trans hq₂_hom))
        obtain ⟨σ, hφ_σ⟩ := @hNormalFactor (E_z z) (hField_z z) (hAlg_z z) r₁ r₂ hr₁_alg hr₂_alg
        have hq_σ : q₂ = q₁ ≫ m_gal σ := by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          change q₂_left = q₁_left ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom)
          apply (cancel_epi (e_Wz z).hom).mp
          calc
            (e_Wz z).hom ≫ q₂_left = AlgebraicGeometry.Spec.map r₂ := hr₂_spec.symm
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom ≫ r₁) := by rw [← hφ_σ]
            _ = AlgebraicGeometry.Spec.map r₁ ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) :=
              AlgebraicGeometry.Spec.map_comp _ _
            _ = ((e_Wz z).hom ≫ q₁_left) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) := by rw [hr₁_spec]
            _ = (e_Wz z).hom ≫
                  (q₁_left ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom)) :=
              Category.assoc _ _ _
        change (ℱ.obj.map g₁.op ≫ ℱ.obj.map (h_z z).op).hom w₀ =
          (ℱ.obj.map g₂.op ≫ ℱ.obj.map (h_z z).op).hom w₀
        rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]
        change (ℱ.obj.map (Opposite.op q₁)).hom w₀ = (ℱ.obj.map (Opposite.op q₂)).hom w₀
        have hstep_σ : (ℱ.obj.map (Opposite.op (q₁ ≫ m_gal σ))).hom w₀ =
            (ℱ.obj.map (Opposite.op q₁)).hom ((ℱ.obj.map (Opposite.op (m_gal σ))).hom w₀) :=
          congrArg (fun τ => τ.hom w₀) (ℱ.obj.map_comp (Opposite.op (m_gal σ)) (Opposite.op q₁))
        have hfix_σ : (ℱ.obj.map (Opposite.op (m_gal σ))).hom w₀ = w₀ := hw₀_fix σ
        rw [hq_σ, hstep_σ, hfix_σ]
    obtain ⟨s₀, hs₀, _⟩ := (CategoryTheory.Presieve.isSheafFor_singleton.mp
      (hℱ_type.isSheafFor (CategoryTheory.Presieve.singleton u_M₀) hMem_uM)) w₀ hEq_pairs
    exact ⟨s₀, fun hzero => hw₀_ne (hs₀.symm.trans hzero)⟩

  have hPrime : Nat.Prime ℓ := Fact.out
  let S₁ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of K₁)
  let S_M : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of M)
  let π_M : S_M ⟶ S₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₁ M))
  let J₁ := S₁.smallEtaleTopology
  let J_M := S_M.smallEtaleTopology
  let F_M := weilAltCdFieldEtaleMap hEtM
  let B_M := weilAltCdSitePullback π_M

  obtain ⟨hContF, hContB, adj_site, adj_sh, hUnit_sh, hCounit_sh, hLimF, hColimF⟩ :=
    step2_site_adjunction K₁ M hEtM
  let F_M_star :=
    @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      F_M AddCommGrpCat.{u} _ J_M J₁ hContF
  let B_M_push :=
    @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      B_M AddCommGrpCat.{u} _ J₁ J_M hContB
  have _ : CategoryTheory.Limits.PreservesFiniteLimits F_M_star := hLimF
  have _ : CategoryTheory.Limits.PreservesFiniteColimits F_M_star := hColimF
  have _ : F_M_star.Additive :=
    CategoryTheory.Functor.additive_of_preserves_binary_products F_M_star

  have hSurj_πM : AlgebraicGeometry.Surjective π_M := by
    have _ : Subsingleton ↥S₁ := step1_spec_subsingleton K₁
    let pt_M : ↥S_M := Classical.arbitrary ↥S_M
    exact ⟨fun x => ⟨pt_M, Subsingleton.elim _ _⟩⟩

  have hInjPull : ∀ (𝒢 : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}) (U : S₁.Etale),
      let snd_U := CategoryTheory.Limits.pullback.snd U.hom π_M
      let fst_U := CategoryTheory.Limits.pullback.fst U.hom π_M
      let _ : AlgebraicGeometry.Etale U.hom := U.prop
      let _ : AlgebraicGeometry.Etale π_M := hEtM
      let V_U : S_M.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ snd_U inferInstance
      let p_U : F_M.obj V_U ⟶ U :=
        CategoryTheory.MorphismProperty.Over.homMk fst_U
          (CategoryTheory.Limits.pullback.condition (f := U.hom) (g := π_M))
      Function.Injective (𝒢.obj.map (Opposite.op p_U)).hom := by
    intro 𝒢 U snd_U fst_U _ _ V_U p_U a₁ a₂ heq
    have _ : AlgebraicGeometry.Surjective p_U.left := by
      change AlgebraicGeometry.Surjective fst_U
      exact inferInstance
    have hMem := step2_singleton_mem p_U
    have hShType : CategoryTheory.Presieve.IsSheaf J₁
        (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type J₁ _).mp
        (CategoryTheory.GrothendieckTopology.HasSheafCompose.isSheaf 𝒢.obj 𝒢.property)
    have hFor := (CategoryTheory.Presieve.isSheafFor_singleton.mp
      (hShType.isSheafFor (CategoryTheory.Presieve.singleton p_U) hMem))
      ((𝒢.obj.map (Opposite.op p_U)).hom a₁)
      (fun {Z} q₁ q₂ hq => by
        change ((𝒢.obj.map p_U.op ≫ 𝒢.obj.map q₁.op).hom) a₁ =
          ((𝒢.obj.map p_U.op ≫ 𝒢.obj.map q₂.op).hom) a₁
        rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp, ← op_comp, ← op_comp, hq])
    exact (hFor.unique rfl heq.symm)

  have hDiscM : ∀ V : S_M.Etale, DiscreteTopology ↥V.left :=
    fun V => (step1_etale_field_local M V).1
  let PShf : ℕ → CategoryTheory.Sheaf J_M AddCommGrpCat.{u} :=
    fun n => ⟨weilAltCdDiscreteVecPresheaf S_M ℓ n, step3_discrete_vec_sheaf M ℓ n⟩

  let A_ℓ : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let P_const₁ : CategoryTheory.Functor (S₁.Etale)ᵒᵖ AddCommGrpCat.{u} :=
    (CategoryTheory.Functor.const (S₁.Etale)ᵒᵖ).obj A_ℓ
  let 𝒞₁ : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u} := weilEtaleTorsionSheaf S₁ ℓ
  let adj_shf₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
  let η_shf₁ : P_const₁ ⟶ 𝒞₁.obj := adj_shf₁.unit.app P_const₁

  let γ_pre : P_const₁ ⟶ (B_M_push.obj (PShf 1)).obj :=
    { app := fun U_op => AddCommGrpCat.ofHom
        { toFun := fun z _ _ => z.down
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      naturality := fun _ _ _ => rfl }
  let γ : 𝒞₁ ⟶ B_M_push.obj (PShf 1) :=
    (adj_shf₁.homEquiv P_const₁ (B_M_push.obj (PShf 1))).symm γ_pre
  have hγ_unit : η_shf₁ ≫ γ.hom = γ_pre :=
    (adj_shf₁.homEquiv P_const₁ (B_M_push.obj (PShf 1))).apply_symm_apply γ_pre
  let β : F_M_star.obj 𝒞₁ ⟶ PShf 1 := (adj_sh.homEquiv 𝒞₁ (PShf 1)).symm γ
  have hβ_app : ∀ (V : S_M.Etale) (z : ULift.{u} (ZMod ℓ)),
      (β.hom.app (Opposite.op V)).hom ((η_shf₁.app (Opposite.op (F_M.obj V))).hom z) =
        fun _ _ => z.down := by
    intro V z
    have hβ_def : β = F_M_star.map γ ≫ adj_sh.counit.app (PShf 1) :=
      @CategoryTheory.Adjunction.homEquiv_counit _ _ _ _ _ _ adj_sh _ _ γ
    have hγ_V := congrArg (fun τ => (τ.app (Opposite.op (F_M.obj V))).hom z) hγ_unit
    rw [hβ_def]
    change ((adj_sh.counit.app (PShf 1)).hom.app (Opposite.op V)).hom
      ((γ.hom.app (Opposite.op (F_M.obj V))).hom ((η_shf₁.app (Opposite.op (F_M.obj V))).hom z)) = _
    rw [hCounit_sh (PShf 1) V, show (γ.hom.app (Opposite.op (F_M.obj V))).hom
        ((η_shf₁.app (Opposite.op (F_M.obj V))).hom z) =
        (γ_pre.app (Opposite.op (F_M.obj V))).hom z from hγ_V]
    rfl

  have h𝒞₁_type : CategoryTheory.Presieve.IsSheaf J₁
      (𝒞₁.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
    (CategoryTheory.isSheaf_iff_isSheaf_of_type J₁ _).mp
      (CategoryTheory.GrothendieckTopology.HasSheafCompose.isSheaf 𝒞₁.obj 𝒞₁.property)

  have hDiscCover : ∀ V : S_M.Etale,
      let j_pt : ∀ x : ↥V.left,
          weilCupPDTraceOpenSubobj S_M V ⟨{x}, @isOpen_discrete _ _ (hDiscM V) {x}⟩ ⟶ V :=
        fun x => weilCupPDTraceOpenSubobjToTop S_M V ⟨{x}, @isOpen_discrete _ _ (hDiscM V) {x}⟩
      CategoryTheory.Sieve.ofArrows
        (fun x : ↥V.left => F_M.obj (weilCupPDTraceOpenSubobj S_M V
          ⟨{x}, @isOpen_discrete _ _ (hDiscM V) {x}⟩))
        (fun x : ↥V.left => F_M.map (j_pt x)) ∈ J₁ (F_M.obj V) := by
    intro V j_pt
    change CategoryTheory.Sieve.ofArrows _ _ ∈ S₁.smallEtaleTopology (F_M.obj V)
    rw [step2_mem_etale_iff S₁ (F_M.obj V)]
    intro x
    let O_x : V.left.Opens := ⟨{x}, @isOpen_discrete _ _ (hDiscM V) {x}⟩
    let V_x := weilCupPDTraceOpenSubobj S_M V O_x
    have hEt_jx : AlgebraicGeometry.Etale (F_M.map (j_pt x)).left := by
      change AlgebraicGeometry.Etale O_x.ι
      exact inferInstance
    exact ⟨F_M.obj V_x, F_M.map (j_pt x), ⟨x, rfl⟩,
      CategoryTheory.Sieve.ofArrows_mk _ _ x, hEt_jx, rfl⟩

  have hEmptySubsingleton : ∀ (𝒢 : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}) (Z : S₁.Etale),
      IsEmpty ↥Z.left → Subsingleton ↥(𝒢.obj.obj (Opposite.op Z)) := by
    intro 𝒢 Z hEmp
    have hBotMem : (⊥ : CategoryTheory.Sieve Z) ∈ J₁ Z := by
      change (⊥ : CategoryTheory.Sieve Z) ∈ S₁.smallEtaleTopology Z
      rw [step2_mem_etale_iff S₁ Z]
      intro z
      exact IsEmpty.elim hEmp z
    have hShType : CategoryTheory.Presieve.IsSheaf J₁
        (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type J₁ _).mp
        (CategoryTheory.GrothendieckTopology.HasSheafCompose.isSheaf 𝒢.obj 𝒢.property)
    have hSep := (hShType.isSheafFor (⊥ : CategoryTheory.Sieve Z).arrows
      (by simpa using hBotMem)).isSeparatedFor
    exact ⟨fun a b => hSep.ext (fun _ _ hg => False.elim hg)⟩

  have hGlue_β_inv : ∀ (V : S_M.Etale) (f : ↥((PShf 1).obj.obj (Opposite.op V))),
      ∃! y : ↥(𝒞₁.obj.obj (Opposite.op (F_M.obj V))),
        ∀ x : ↥V.left,
          let O_x : V.left.Opens := ⟨{x}, @isOpen_discrete _ _ (hDiscM V) {x}⟩
          let j_x := weilCupPDTraceOpenSubobjToTop S_M V O_x
          (𝒞₁.obj.map (Opposite.op (F_M.map j_x))).hom y =
            (η_shf₁.app (Opposite.op (F_M.obj (weilCupPDTraceOpenSubobj S_M V O_x)))).hom
              (ULift.up (f x 0)) := by
    intro V f
    let O_pt : ↥V.left → V.left.Opens := fun x => ⟨{x}, @isOpen_discrete _ _ (hDiscM V) {x}⟩
    let V_pt : ↥V.left → S_M.Etale := fun x => weilCupPDTraceOpenSubobj S_M V (O_pt x)
    let j_pt : ∀ x : ↥V.left, V_pt x ⟶ V := fun x => weilCupPDTraceOpenSubobjToTop S_M V (O_pt x)
    let R_pre : CategoryTheory.Presieve (F_M.obj V) :=
      CategoryTheory.Presieve.ofArrows (fun x => F_M.obj (V_pt x)) (fun x => F_M.map (j_pt x))
    have hMem : CategoryTheory.Sieve.generate R_pre ∈ J₁ (F_M.obj V) := hDiscCover V
    have hFor := h𝒞₁_type.isSheafFor R_pre hMem
    have hArrowEx : ∀ {W : S₁.Etale} {g : W ⟶ F_M.obj V}, R_pre g →
        ∃ x₀ : ↥V.left, W = F_M.obj (V_pt x₀) ∧ HEq g (F_M.map (j_pt x₀)) := by
      intro W g hg
      cases hg with
      | mk x₀ => exact ⟨x₀, rfl, HEq.rfl⟩
    let fam : CategoryTheory.Presieve.FamilyOfElements
        (𝒞₁.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) R_pre :=
      fun W g hg =>
        let x₀ := Classical.choose (hArrowEx hg)
        (η_shf₁.app (Opposite.op W)).hom (ULift.up (f x₀ 0))
    have hFamVal : ∀ x : ↥V.left,
        fam (F_M.map (j_pt x)) (CategoryTheory.Presieve.ofArrows.mk x) =
          (η_shf₁.app (Opposite.op (F_M.obj (V_pt x)))).hom (ULift.up (f x 0)) := by
      intro x
      dsimp [fam]
      set x₀ := Classical.choose (hArrowEx (CategoryTheory.Presieve.ofArrows.mk x))
      obtain ⟨hW, hHeq⟩ := Classical.choose_spec
        (hArrowEx (CategoryTheory.Presieve.ofArrows.mk x))
      have hx_eq : x₀ = x := by
        have hEqHom : ∀ {W₁ W₂ : S₁.Etale} (hW' : W₁ = W₂)
            (g₁ : W₁ ⟶ F_M.obj V) (g₂ : W₂ ⟶ F_M.obj V),
            HEq g₁ g₂ → Set.range g₁.left.base = Set.range g₂.left.base := by
          rintro W₁ _ rfl g₁ g₂ hg_eq
          cases eq_of_heq hg_eq
          rfl
        have hRange := hEqHom hW (F_M.map (j_pt x)) (F_M.map (j_pt x₀)) hHeq
        have hx_in : x ∈ Set.range (F_M.map (j_pt x)).left.base := ⟨⟨x, rfl⟩, rfl⟩
        rw [hRange] at hx_in
