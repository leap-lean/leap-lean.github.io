theorem weil_polyP1_coord_compactification_and_properness (k : Type u) [Field k] :
    ∃ (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
        (weilProjectiveSpaceOver k 1).left)
      (ι_aff : ∀ δ : ℕ,
        Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left),
      WeilIsPolyP1PinnedCoordCompactification k ι_P1 ι_aff :=
by
  classical
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k
  letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let P1_over := weilProjectiveSpaceOver k 1
  let P1 := P1_over.left
  let A1 := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
  let Sk := AlgebraicGeometry.Spec (CommRingCat.of k)

  
  let φ₀ : k →+* ↥(𝒜 0) := algebraMap k ↥(𝒜 0)
  have hφ₀_bij : Function.Bijective φ₀ := by
    refine ⟨?_, ?_⟩
    · intro c₁ c₂ hc
      apply MvPolynomial.C_injective (σ := Fin (1 + 1)) (R := k)
      exact congrArg Subtype.val hc
    · intro y
      have hy : (y : MvPolynomial (Fin (1 + 1)) k) ∈
          (1 : Submodule k (MvPolynomial (Fin (1 + 1)) k)) := by
        simpa only [𝒜, MvPolynomial.homogeneousSubmodule_zero] using y.2
      rw [Submodule.mem_one] at hy
      obtain ⟨c, hc⟩ := hy
      exact ⟨c, Subtype.ext hc⟩
  let e₀_zero : k ≃+* ↥(𝒜 0) := RingEquiv.ofBijective φ₀ hφ₀_bij
  have : CategoryTheory.IsIso (CommRingCat.ofHom φ₀) :=
    ⟨⟨CommRingCat.ofHom e₀_zero.symm.toRingHom,
      CommRingCat.hom_ext (RingHom.ext fun c => e₀_zero.symm_apply_apply c),
      CommRingCat.hom_ext (RingHom.ext fun y => e₀_zero.apply_symm_apply y)⟩⟩
  have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) :=
    inferInstance
  have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k) :=
    IsScalarTower.of_algebraMap_eq (R := k) (S := ↥(𝒜 0))
      (A := MvPolynomial (Fin (1 + 1)) k) fun _ => rfl
  have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k) :=
    Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k)
  have hProp_P1 : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom := by
    dsimp [weilProjectiveSpaceOver]
    infer_instance

  
  have hX_mem : ∀ i : Fin (1 + 1), (MvPolynomial.X i : MvPolynomial (Fin (1 + 1)) k) ∈ 𝒜 1 :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k i)

  have hCoordEquiv : ∀ (i j : Fin (1 + 1)), i ≠ j →
      ∃ (e : Polynomial k ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i)),
        e.toRingHom.comp Polynomial.C =
          (HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X i))).comp φ₀ ∧
        e Polynomial.X =
          HomogeneousLocalization.Away.isLocalizationElem (hX_mem i) (hX_mem j) ∧
        ∀ (m : ℕ) (F : MvPolynomial (Fin (1 + 1)) k) (hF : F ∈ 𝒜 (m • 1)),
          e.symm (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF) =
            MvPolynomial.aeval
              (fun l : Fin (1 + 1) => if l = i then (1 : Polynomial k) else Polynomial.X) F := by
    intro i j hij
    let Xi : MvPolynomial (Fin (1 + 1)) k := MvPolynomial.X i
    let Xj : MvPolynomial (Fin (1 + 1)) k := MvPolynomial.X j
    let Ri := HomogeneousLocalization.Away 𝒜 Xi
    let κ_i : k →+* Ri :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers Xi)).comp φ₀
    let t_i : Ri := HomogeneousLocalization.Away.isLocalizationElem (hX_mem i) (hX_mem j)
    let ψ_i : Polynomial k →+* Ri := Polynomial.eval₂RingHom κ_i t_i
    let ev_i_alg : MvPolynomial (Fin (1 + 1)) k →ₐ[k] Polynomial k :=
      MvPolynomial.aeval (fun l : Fin (1 + 1) => if l = i then (1 : Polynomial k) else Polynomial.X)
    let ev_i : MvPolynomial (Fin (1 + 1)) k →+* Polynomial k := ev_i_alg.toRingHom
    have hev_Xi_eq : ev_i Xi = 1 := by
      change ev_i_alg (MvPolynomial.X i) = 1
      dsimp [ev_i_alg]
      rw [MvPolynomial.aeval_X]
      simp
    have hev_Xi : IsUnit (ev_i Xi) := by
      rw [hev_Xi_eq]
      exact isUnit_one
    let ev_i_loc : Localization.Away Xi →+* Polynomial k :=
      IsLocalization.Away.lift Xi hev_Xi
    let ι_loc : MvPolynomial (Fin (1 + 1)) k →+* Localization.Away Xi :=
      algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away Xi)
    let val_hom : Ri →+* Localization.Away Xi := algebraMap Ri (Localization.Away Xi)
    let φ_i : Ri →+* Polynomial k := ev_i_loc.comp val_hom
    have h_val_apply : ∀ z : Ri, val_hom z = z.val :=
      fun z => HomogeneousLocalization.algebraMap_apply z
    have h_val_zero : ∀ a : ↥(𝒜 0),
        (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers Xi) a).val =
          ι_loc (a : MvPolynomial (Fin (1 + 1)) k) := by
      intro a
      change Localization.mk (a : MvPolynomial (Fin (1 + 1)) k) 1 =
        ι_loc (a : MvPolynomial (Fin (1 + 1)) k)
      exact Localization.mk_one_eq_algebraMap (a : MvPolynomial (Fin (1 + 1)) k)
    have h_mk_eval : ∀ (m : ℕ) (F : MvPolynomial (Fin (1 + 1)) k) (hF : F ∈ 𝒜 (m • 1)),
        φ_i (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF) = ev_i F := by
      intro m F hF
      have hz_val : (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF).val *
          ι_loc (Xi ^ m) = ι_loc F := by
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk', mul_comm]
        exact IsLocalization.mk'_spec' (M := Submonoid.powers Xi)
          (Localization.Away Xi) F ⟨Xi ^ m, ⟨m, rfl⟩⟩
      have h_mul := congrArg ev_i_loc hz_val
      rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq,
        map_pow, hev_Xi_eq, one_pow, mul_one] at h_mul
      change ev_i_loc (val_hom (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF)) = ev_i F
      rw [h_val_apply]
      exact h_mul
    have h_ti_eq_mk : t_i = HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) 1 (Xj ^ 1)
        (by simpa using hX_mem j) := rfl
    have h_left : φ_i.comp ψ_i = RingHom.id (Polynomial k) := by
      apply Polynomial.ringHom_ext
      · intro c
        change φ_i (Polynomial.eval₂ κ_i t_i (Polynomial.C c)) = Polynomial.C c
        rw [Polynomial.eval₂_C]
        change ev_i_loc (val_hom (κ_i c)) = Polynomial.C c
        rw [h_val_apply]
        change ev_i_loc ((HomogeneousLocalization.fromZeroRingHom 𝒜
          (Submonoid.powers Xi) (φ₀ c)).val) = Polynomial.C c
        rw [h_val_zero]
        change ev_i_loc (ι_loc (algebraMap k (MvPolynomial (Fin (1 + 1)) k) c)) = Polynomial.C c
        rw [IsLocalization.Away.lift_eq]
        exact ev_i_alg.commutes c
      · change φ_i (Polynomial.eval₂ κ_i t_i Polynomial.X) = Polynomial.X
        rw [Polynomial.eval₂_X, h_ti_eq_mk, h_mk_eval]
        change ev_i_alg (Xj ^ 1) = Polynomial.X
        rw [pow_one]
        dsimp [ev_i_alg, Xj]
        rw [MvPolynomial.aeval_X]
        simp [hij.symm]
    have h_right : ∀ z : Ri, ψ_i (φ_i z) = z := by
      intro z
      obtain ⟨m, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX_mem i) z
      rw [h_mk_eval m F hF, HomogeneousLocalization.ext_iff_val]
      let θ_i : MvPolynomial (Fin (1 + 1)) k →+* Localization.Away Xi :=
        val_hom.comp (ψ_i.comp ev_i)
      have hθ_C : ∀ c : k, θ_i (MvPolynomial.C c) = ι_loc (MvPolynomial.C c) := by
        intro c
        change val_hom (ψ_i (ev_i_alg (MvPolynomial.C c))) = ι_loc (MvPolynomial.C c)
        rw [MvPolynomial.aeval_C]
        change val_hom (Polynomial.eval₂ κ_i t_i (Polynomial.C c)) = ι_loc (MvPolynomial.C c)
        rw [Polynomial.eval₂_C, h_val_apply]
        exact h_val_zero (φ₀ c)
      have hθ_X : ∀ l : Fin (1 + 1),
          θ_i (MvPolynomial.X l) * ι_loc Xi = ι_loc (MvPolynomial.X l) := by
        intro l
        by_cases hli : l = i
        · subst hli
          change val_hom (ψ_i (ev_i_alg (MvPolynomial.X l))) * ι_loc (MvPolynomial.X l) = _
          have hev_l : ev_i_alg (MvPolynomial.X l) = 1 := by
            dsimp [ev_i_alg]
            rw [MvPolynomial.aeval_X]
            simp
          rw [hev_l, map_one, map_one, one_mul]
        · have hlj : l = j := by
            fin_cases i <;> fin_cases j <;> fin_cases l <;> simp_all
          subst hlj
          change val_hom (ψ_i (ev_i_alg (MvPolynomial.X l))) * ι_loc Xi = ι_loc (MvPolynomial.X l)
          have hev_l : ev_i_alg (MvPolynomial.X l) = Polynomial.X := by
            dsimp [ev_i_alg]
            rw [MvPolynomial.aeval_X]
            simp [hli]
          rw [hev_l]
          change val_hom (Polynomial.eval₂ κ_i t_i Polynomial.X) * ι_loc Xi =
            ι_loc (MvPolynomial.X l)
          rw [Polynomial.eval₂_X, h_val_apply, h_ti_eq_mk,
            HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk', mul_comm]
          have hspec := IsLocalization.mk'_spec' (M := Submonoid.powers Xi)
            (Localization.Away Xi) (MvPolynomial.X l ^ 1) ⟨Xi ^ 1, ⟨1, rfl⟩⟩
          simpa only [pow_one] using hspec
      have hθ_X_pow : ∀ (l : Fin (1 + 1)) (e : ℕ),
          θ_i (MvPolynomial.X l ^ e) * ι_loc Xi ^ e = ι_loc (MvPolynomial.X l ^ e) := by
        intro l e
        rw [map_pow, map_pow, ← mul_pow, hθ_X l]
      have hF_hom : F.IsHomogeneous m := by
        have hF' : F ∈ 𝒜 m := by simpa using hF
        exact (MvPolynomial.mem_homogeneousSubmodule m F).mp hF'
      have hθ_F : θ_i F * ι_loc (Xi ^ m) = ι_loc F := by
        conv_lhs => rw [MvPolynomial.as_sum F]
        conv_rhs => rw [MvPolynomial.as_sum F]
        rw [map_sum, Finset.sum_mul, map_sum]
        apply Finset.sum_congr rfl
        intro s hs
        have hs_deg : s 0 + s 1 = m := by
          have hw := hF_hom (MvPolynomial.mem_support_iff.mp hs)
          simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using hw
        rw [MvPolynomial.monomial_eq, Finsupp.prod_pow, Fin.prod_univ_two]
        generalize F.coeff s = cs
        simp only [map_mul, map_pow]
        calc
          (θ_i (MvPolynomial.C cs) *
              (θ_i (MvPolynomial.X 0) ^ s 0 * θ_i (MvPolynomial.X 1) ^ s 1)) *
              ι_loc Xi ^ m
            = θ_i (MvPolynomial.C cs) *
                ((θ_i (MvPolynomial.X 0) ^ s 0 * ι_loc Xi ^ s 0) *
                 (θ_i (MvPolynomial.X 1) ^ s 1 * ι_loc Xi ^ s 1)) := by
                rw [← hs_deg, pow_add]; ring
          _ = ι_loc (MvPolynomial.C cs) *
                (ι_loc (MvPolynomial.X 0) ^ s 0 * ι_loc (MvPolynomial.X 1) ^ s 1) := by
                rw [hθ_C]
                have h0 := hθ_X_pow 0 (s 0)
                have h1 := hθ_X_pow 1 (s 1)
                simp only [map_pow] at h0 h1
                rw [h0, h1]
      have hz_val : (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF).val *
          ι_loc (Xi ^ m) = ι_loc F := by
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk', mul_comm]
        exact IsLocalization.mk'_spec' (M := Submonoid.powers Xi)
          (Localization.Away Xi) F ⟨Xi ^ m, ⟨m, rfl⟩⟩
      have hUnit_pow : IsUnit (ι_loc (Xi ^ m)) :=
        IsLocalization.map_units (M := Submonoid.powers Xi)
          (Localization.Away Xi) ⟨Xi ^ m, ⟨m, rfl⟩⟩
      have h_eq_val : θ_i F = (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF).val :=
        hUnit_pow.mul_right_cancel (hθ_F.trans hz_val.symm)
      change (ψ_i (ev_i F)).val = (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF).val
      rw [← h_val_apply]
      exact h_eq_val
    let e_i : Polynomial k ≃+* Ri :=
      RingEquiv.ofRingHom ψ_i φ_i (RingHom.ext h_right) h_left
    refine ⟨e_i, ?_, ?_, ?_⟩
    · apply RingHom.ext
      intro c
      change Polynomial.eval₂ κ_i t_i (Polynomial.C c) = κ_i c
      exact Polynomial.eval₂_C _ _
    · change Polynomial.eval₂ κ_i t_i Polynomial.X = t_i
      exact Polynomial.eval₂_X _ _
    · intro m F hF
      exact h_mk_eval m F hF

  have h10 : (1 : Fin (1 + 1)) ≠ 0 := by decide
  have h01 : (0 : Fin (1 + 1)) ≠ 1 := by decide
  obtain ⟨e₁, he₁_C, he₁_X, he₁_symm⟩ := hCoordEquiv 1 0 h10
  obtain ⟨e₀, he₀_C, he₀_X, he₀_symm⟩ := hCoordEquiv 0 1 h01

  
  let away₁ := AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) (hX_mem 1) zero_lt_one
  let away₀ := AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hX_mem 0) zero_lt_one
  let spec_e₁ : A1 ⟶ AlgebraicGeometry.Spec
      (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1))) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom)
  let spec_e₀ : A1 ⟶ AlgebraicGeometry.Spec
      (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0))) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom)
  let ι_P1 : A1 ⟶ P1 := spec_e₁ ≫ away₁
  let ι_inf : A1 ⟶ P1 := spec_e₀ ≫ away₀

  have : CategoryTheory.IsIso (CommRingCat.ofHom e₁.symm.toRingHom) :=
    ⟨⟨CommRingCat.ofHom e₁.toRingHom,
      CommRingCat.hom_ext (RingHom.ext fun x => e₁.apply_symm_apply x),
      CommRingCat.hom_ext (RingHom.ext fun x => e₁.symm_apply_apply x)⟩⟩
  have : CategoryTheory.IsIso (CommRingCat.ofHom e₀.symm.toRingHom) :=
    ⟨⟨CommRingCat.ofHom e₀.toRingHom,
      CommRingCat.hom_ext (RingHom.ext fun x => e₀.apply_symm_apply x),
      CommRingCat.hom_ext (RingHom.ext fun x => e₀.symm_apply_apply x)⟩⟩
  have : CategoryTheory.IsIso spec_e₁ := inferInstance
  have : CategoryTheory.IsIso spec_e₀ := inferInstance
  have hOpen_P1 : AlgebraicGeometry.IsOpenImmersion ι_P1 := by
    change AlgebraicGeometry.IsOpenImmersion
      (spec_e₁ ≫ AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) (hX_mem 1) zero_lt_one)
    infer_instance
  have hOpen_inf : AlgebraicGeometry.IsOpenImmersion ι_inf := by
    change AlgebraicGeometry.IsOpenImmersion
      (spec_e₀ ≫ AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hX_mem 0) zero_lt_one)
    infer_instance
  have : AlgebraicGeometry.IsOpenImmersion ι_P1 := hOpen_P1
  have : AlgebraicGeometry.IsOpenImmersion ι_inf := hOpen_inf

  have hHom_P1 : ι_P1 ≫ P1_over.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
    change (spec_e₁ ≫ away₁) ≫
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
    rw [CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc away₁ (AlgebraicGeometry.Proj.toSpecZero 𝒜),
      AlgebraicGeometry.Proj.awayι_toSpecZero]
    dsimp only [spec_e₁]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    apply congrArg AlgebraicGeometry.Spec.map
    apply congrArg CommRingCat.ofHom
    apply RingHom.ext
    intro c
    have hc := congrArg (fun f : k →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1) =>
      e₁.symm (f c)) he₁_C
    simpa [φ₀] using hc.symm

  have hHom_inf : ι_inf ≫ P1_over.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
    change (spec_e₀ ≫ away₀) ≫
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
    rw [CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc away₀ (AlgebraicGeometry.Proj.toSpecZero 𝒜),
      AlgebraicGeometry.Proj.awayι_toSpecZero]
    dsimp only [spec_e₀]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    apply congrArg AlgebraicGeometry.Spec.map
    apply congrArg CommRingCat.ofHom
    apply RingHom.ext
    intro c
    have hc := congrArg (fun f : k →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0) =>
      e₀.symm (f c)) he₀_C
    simpa [φ₀] using hc.symm

  have hRange_P1 : Set.range ι_P1.base =
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1) : Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
    have hSurj : Function.Surjective spec_e₁.base :=
      (TopCat.epi_iff_surjective spec_e₁.base).mp inferInstance
    have h_eq1 : Set.range ι_P1.base = Set.range away₁.base := by
      ext x
      refine ⟨fun ⟨y, hy⟩ => ⟨spec_e₁.base y, hy⟩, fun ⟨z, hz⟩ => ?_⟩
      obtain ⟨y, rfl⟩ := hSurj z
      exact ⟨y, hz⟩
    exact h_eq1.trans (congrArg SetLike.coe
      (AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (MvPolynomial.X 1) (hX_mem 1) zero_lt_one))

  have hRange_inf : Set.range ι_inf.base =
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) : Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
    have hSurj : Function.Surjective spec_e₀.base :=
      (TopCat.epi_iff_surjective spec_e₀.base).mp inferInstance
    have h_eq1 : Set.range ι_inf.base = Set.range away₀.base := by
      ext x
      refine ⟨fun ⟨y, hy⟩ => ⟨spec_e₀.base y, hy⟩, fun ⟨z, hz⟩ => ?_⟩
      obtain ⟨y, rfl⟩ := hSurj z
      exact ⟨y, hz⟩
    exact h_eq1.trans (congrArg SetLike.coe
      (AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (MvPolynomial.X 0) (hX_mem 0) zero_lt_one))

  have hCover_P1 : Set.range ι_P1.base ∪ Set.range ι_inf.base = Set.univ := by
    ext p
    simp only [Set.mem_union, Set.mem_univ, iff_true]
    rw [hRange_P1, hRange_inf]
    by_contra hp
    rw [not_or] at hp
    rcases hp with ⟨hp1, hp0⟩
    have hX1_in : (MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) k) ∈ p.asHomogeneousIdeal := by
      by_contra hnot
      exact hp1 ((AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X 1) p).mpr hnot)
    have hX0_in : (MvPolynomial.X 0 : MvPolynomial (Fin (1 + 1)) k) ∈ p.asHomogeneousIdeal := by
      by_contra hnot
      exact hp0 ((AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X 0) p).mpr hnot)
    apply p.not_irrelevant_le
    intro F hF_irr
    let J : _root_.Ideal (MvPolynomial (Fin (1 + 1)) k) :=
      _root_.Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1}
    have hJ_le_p : J ≤ p.asHomogeneousIdeal.toIdeal := by
      rw [_root_.Ideal.span_le]
      rintro g (rfl | rfl)
      · exact hX0_in
      · exact hX1_in
    have hJ_le_irr : J ≤ (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
      rw [_root_.Ideal.span_le]
      rintro g (rfl | rfl)
      · exact HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 zero_lt_one (hX_mem 0)
      · exact HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 zero_lt_one (hX_mem 1)
    let ev00 : MvPolynomial (Fin (1 + 1)) k →ₐ[k] k := MvPolynomial.aeval 0
    have hF_mod_J : ∀ G : MvPolynomial (Fin (1 + 1)) k,
        G - MvPolynomial.C (ev00 G) ∈ J := by
      intro G
      induction G using MvPolynomial.induction_on with
      | C c =>
        have hc : ev00 (MvPolynomial.C c) = c := MvPolynomial.aeval_C 0 c
        rw [hc, sub_self]
        exact J.zero_mem
      | add g₁ g₂ hg₁ hg₂ =>
        have h_add : (g₁ + g₂) - MvPolynomial.C (ev00 (g₁ + g₂)) =
            (g₁ - MvPolynomial.C (ev00 g₁)) + (g₂ - MvPolynomial.C (ev00 g₂)) := by
          rw [map_add, MvPolynomial.C_add]; ring
        rw [h_add]
        exact J.add_mem hg₁ hg₂
      | mul_X g l _ =>
        have hl : ev00 (g * MvPolynomial.X l) = 0 := by
          change MvPolynomial.aeval 0 (g * MvPolynomial.X l) = 0
          rw [map_mul, MvPolynomial.aeval_X, Pi.zero_apply, mul_zero]
        rw [hl, map_zero, sub_zero]
        have hXl_J : (MvPolynomial.X l : MvPolynomial (Fin (1 + 1)) k) ∈ J := by
          apply _root_.Ideal.subset_span
          fin_cases l <;> simp
        exact J.mul_mem_left g hXl_J
    have hC_irr : MvPolynomial.C (ev00 F) ∈ HomogeneousIdeal.irrelevant 𝒜 := by
      have hsub : F - (F - MvPolynomial.C (ev00 F)) = MvPolynomial.C (ev00 F) := by ring
      rw [← HomogeneousIdeal.mem_iff, ← hsub]
      exact (HomogeneousIdeal.irrelevant 𝒜).toIdeal.sub_mem hF_irr (hJ_le_irr (hF_mod_J F))
    have hC_mem0 : (MvPolynomial.C (ev00 F) : MvPolynomial (Fin (1 + 1)) k) ∈ 𝒜 0 :=
      (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr (MvPolynomial.isHomogeneous_C _ _)
    have hC_eq0 : (MvPolynomial.C (ev00 F) : MvPolynomial (Fin (1 + 1)) k) = 0 := by
      have hproj := (HomogeneousIdeal.mem_irrelevant_iff 𝒜 _).mp hC_irr
      simpa [GradedRing.proj_apply, DirectSum.decompose_of_mem_same 𝒜 hC_mem0] using hproj
    have hF_in_J : F ∈ J := by
      have h_mem := hF_mod_J F
      rwa [hC_eq0, sub_zero] at h_mem
    exact hJ_le_p hF_in_J

  have hPre_inf_P1 : ι_inf.base ⁻¹' (Set.range ι_P1.base) =
      (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) : Set (PrimeSpectrum (Polynomial k))) := by
    ext q
    change ι_inf.base q ∈ Set.range ι_P1.base ↔
      Polynomial.X ∉ (q : PrimeSpectrum (Polynomial k)).asIdeal
    rw [hRange_P1]
    have h_away_pre := SetLike.ext_iff.mp
      (AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX_mem 0) zero_lt_one (hX_mem 1) zero_lt_one)
      (spec_e₀.base q)
    change away₀.base (spec_e₀.base q) ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1) ↔ _ at h_away_pre
    rw [← he₀_X] at h_away_pre
    exact h_away_pre.trans (not_congr (by
      change e₀.symm (e₀ Polynomial.X) ∈ (q : PrimeSpectrum (Polynomial k)).asIdeal ↔ _
      rw [e₀.symm_apply_apply]))

  have hPre_P1_inf : ι_P1.base ⁻¹' (Set.range ι_inf.base) =
      (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) : Set (PrimeSpectrum (Polynomial k))) := by
    ext q
    change ι_P1.base q ∈ Set.range ι_inf.base ↔
      Polynomial.X ∉ (q : PrimeSpectrum (Polynomial k)).asIdeal
    rw [hRange_inf]
    have h_away_pre := SetLike.ext_iff.mp
      (AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX_mem 1) zero_lt_one (hX_mem 0) zero_lt_one)
      (spec_e₁.base q)
    change away₁.base (spec_e₁.base q) ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) ↔ _ at h_away_pre
    rw [← he₁_X] at h_away_pre
    exact h_away_pre.trans (not_congr (by
      change e₁.symm (e₁ Polynomial.X) ∈ (q : PrimeSpectrum (Polynomial k)).asIdeal ↔ _
      rw [e₁.symm_apply_apply]))

  
  let R_loc := Localization.Away (Polynomial.X : Polynomial k)
  let ι_R : Polynomial k →+* R_loc := algebraMap (Polynomial k) R_loc
  let x_inv : R_loc := IsLocalization.Away.invSelf (S := R_loc) (Polynomial.X : Polynomial k)
  have hx_mul_inv : ι_R Polynomial.X * x_inv = 1 :=
    IsLocalization.Away.mul_invSelf (S := R_loc) (Polynomial.X : Polynomial k)
  have hx_inv_mul : x_inv * ι_R Polynomial.X = 1 := by rw [mul_comm, hx_mul_inv]
  have hx_inv_unit : IsUnit x_inv := ⟨⟨x_inv, ι_R Polynomial.X, hx_inv_mul, hx_mul_inv⟩, rfl⟩
  have hX_loc_unit : IsUnit (ι_R Polynomial.X) :=
    ⟨⟨ι_R Polynomial.X, x_inv, hx_mul_inv, hx_inv_mul⟩, rfl⟩
  let τ_pre : Polynomial k →+* R_loc := Polynomial.eval₂RingHom (ι_R.comp Polynomial.C) x_inv
  have hτ_pre_X : IsUnit (τ_pre Polynomial.X) := by
    change IsUnit (Polynomial.eval₂ (ι_R.comp Polynomial.C) x_inv Polynomial.X)
    rw [Polynomial.eval₂_X]
    exact hx_inv_unit
  let τ_inv : R_loc →+* R_loc :=
    IsLocalization.Away.lift (Polynomial.X : Polynomial k) hτ_pre_X
  have hτ_lift_eq : ∀ p : Polynomial k, τ_inv (ι_R p) = τ_pre p :=
    fun p => IsLocalization.Away.lift_eq (Polynomial.X : Polynomial k) hτ_pre_X p
  have hτ_C : ∀ c : k, τ_inv (ι_R (Polynomial.C c)) = ι_R (Polynomial.C c) := by
    intro c
    rw [hτ_lift_eq]
    change Polynomial.eval₂ (ι_R.comp Polynomial.C) x_inv (Polynomial.C c) = ι_R (Polynomial.C c)
    exact Polynomial.eval₂_C _ _
  have hτ_X : τ_inv (ι_R Polynomial.X) = x_inv := by
    rw [hτ_lift_eq]
    change Polynomial.eval₂ (ι_R.comp Polynomial.C) x_inv Polynomial.X = x_inv
    exact Polynomial.eval₂_X _ _

  have hGlue_charts :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫ ι_P1 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫ ι_inf := by
    let M : MvPolynomial (Fin (1 + 1)) k := MvPolynomial.X 1 * MvPolynomial.X 0
    have hM_mem : M ∈ 𝒜 (1 + 1) := SetLike.mul_mem_graded (hX_mem 1) (hX_mem 0)
    have hx₁ : M = MvPolynomial.X 1 * MvPolynomial.X 0 := rfl
    have hx₀ : M = MvPolynomial.X 0 * MvPolynomial.X 1 := mul_comm _ _
    let ρ₁ := HomogeneousLocalization.awayMap 𝒜 (hX_mem 0) hx₁
    let ρ₀ := HomogeneousLocalization.awayMap 𝒜 (hX_mem 1) hx₀
    let ev_M1_alg : MvPolynomial (Fin (1 + 1)) k →ₐ[k] R_loc :=
      MvPolynomial.aeval (fun l : Fin (1 + 1) => if l = 1 then (1 : R_loc) else ι_R Polynomial.X)
    let ev_M0_alg : MvPolynomial (Fin (1 + 1)) k →ₐ[k] R_loc :=
      MvPolynomial.aeval (fun l : Fin (1 + 1) => if l = 0 then (1 : R_loc) else ι_R Polynomial.X)
    have hM1_ev : ev_M1_alg M = ι_R Polynomial.X := by
      dsimp [M, ev_M1_alg]
      rw [map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      simp [h01]
    have hM0_ev : ev_M0_alg M = ι_R Polynomial.X := by
      dsimp [M, ev_M0_alg]
      rw [map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      simp [h10]
    have hUnit_M1 : IsUnit (ev_M1_alg.toRingHom M) := by
      change IsUnit (ev_M1_alg M)
      rw [hM1_ev]
      exact hX_loc_unit
    have hUnit_M0 : IsUnit (ev_M0_alg.toRingHom M) := by
      change IsUnit (ev_M0_alg M)
      rw [hM0_ev]
      exact hX_loc_unit
    let L_M1 : Localization.Away M →+* R_loc :=
      IsLocalization.Away.lift M hUnit_M1
    let L_M0 : Localization.Away M →+* R_loc :=
      IsLocalization.Away.lift M hUnit_M0
    let val_M : HomogeneousLocalization.Away 𝒜 M →+* Localization.Away M :=
      algebraMap (HomogeneousLocalization.Away 𝒜 M) (Localization.Away M)
    let f₁_inv : HomogeneousLocalization.Away 𝒜 M →+* R_loc := L_M1.comp val_M
    let f₀_inv : HomogeneousLocalization.Away 𝒜 M →+* R_loc := L_M0.comp val_M
    have hf₁_mk : ∀ (m : ℕ) (F : MvPolynomial (Fin (1 + 1)) k) (hF : F ∈ 𝒜 (m • (1 + 1))),
        f₁_inv (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF) * (ι_R Polynomial.X) ^ m =
          ev_M1_alg F := by
      intro m F hF
      have hw_val : (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF).val *
          algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away M) (M ^ m) =
          algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away M) F := by
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk', mul_comm]
        exact IsLocalization.mk'_spec' (M := Submonoid.powers M)
          (Localization.Away M) F ⟨M ^ m, ⟨m, rfl⟩⟩
      have h_app := congrArg L_M1 hw_val
      have hL_eq : ∀ G : MvPolynomial (Fin (1 + 1)) k,
          L_M1 (algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away M) G) = ev_M1_alg G :=
        fun G => IsLocalization.Away.lift_eq M hUnit_M1 G
      rw [map_mul, hL_eq, hL_eq, map_pow, hM1_ev] at h_app
      change L_M1 (val_M (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF)) *
        (ι_R Polynomial.X) ^ m = ev_M1_alg F
      rw [HomogeneousLocalization.algebraMap_apply]
      exact h_app
    have hf₀_mk : ∀ (m : ℕ) (F : MvPolynomial (Fin (1 + 1)) k) (hF : F ∈ 𝒜 (m • (1 + 1))),
        f₀_inv (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF) * (ι_R Polynomial.X) ^ m =
          ev_M0_alg F := by
      intro m F hF
      have hw_val : (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF).val *
          algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away M) (M ^ m) =
          algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away M) F := by
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk', mul_comm]
        exact IsLocalization.mk'_spec' (M := Submonoid.powers M)
          (Localization.Away M) F ⟨M ^ m, ⟨m, rfl⟩⟩
      have h_app := congrArg L_M0 hw_val
      have hL_eq : ∀ G : MvPolynomial (Fin (1 + 1)) k,
          L_M0 (algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away M) G) = ev_M0_alg G :=
        fun G => IsLocalization.Away.lift_eq M hUnit_M0 G
      rw [map_mul, hL_eq, hL_eq, map_pow, hM0_ev] at h_app
      change L_M0 (val_M (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF)) *
        (ι_R Polynomial.X) ^ m = ev_M0_alg F
      rw [HomogeneousLocalization.algebraMap_apply]
      exact h_app
    have hUnit_Xpow : ∀ m : ℕ, IsUnit ((ι_R Polynomial.X) ^ m) :=
      fun m => hX_loc_unit.pow m
    have h_ev1_hom : ι_R.comp (MvPolynomial.aeval
        (fun l : Fin (1 + 1) => if l = 1 then (1 : Polynomial k) else Polynomial.X)).toRingHom =
        ev_M1_alg.toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change ι_R (MvPolynomial.aeval _ (MvPolynomial.C c)) = ev_M1_alg (MvPolynomial.C c)
        rw [MvPolynomial.aeval_C]
        dsimp [ev_M1_alg]
        rw [MvPolynomial.aeval_C]
        rfl
      · intro l
        change ι_R (MvPolynomial.aeval _ (MvPolynomial.X l)) = ev_M1_alg (MvPolynomial.X l)
        dsimp [ev_M1_alg]
        rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X]
        split_ifs <;> simp
    have h_rel1 : f₁_inv.comp ρ₁ = ι_R.comp e₁.symm.toRingHom := by
      apply RingHom.ext
      intro z
      obtain ⟨m, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX_mem 1) z
      apply (hUnit_Xpow m).mul_right_cancel
      simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
        RingHom.coe_coe]
      rw [HomogeneousLocalization.awayMap_mk, hf₁_mk, he₁_symm m F hF]
      have h_ev_eq : ι_R ((MvPolynomial.aeval
          (fun l : Fin (1 + 1) => if l = 1 then (1 : Polynomial k) else Polynomial.X)) F) =
          ev_M1_alg F :=
        DFunLike.congr_fun h_ev1_hom F
      rw [h_ev_eq, map_mul, map_pow]
      have hX0_ev : ev_M1_alg (MvPolynomial.X 0) = ι_R Polynomial.X := by
        dsimp [ev_M1_alg]
        rw [MvPolynomial.aeval_X]
        simp [h01]
      rw [hX0_ev]
    have h_ev0_hom : ι_R.comp (MvPolynomial.aeval
        (fun l : Fin (1 + 1) => if l = 0 then (1 : Polynomial k) else Polynomial.X)).toRingHom =
        ev_M0_alg.toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change ι_R (MvPolynomial.aeval _ (MvPolynomial.C c)) = ev_M0_alg (MvPolynomial.C c)
        rw [MvPolynomial.aeval_C]
        dsimp [ev_M0_alg]
        rw [MvPolynomial.aeval_C]
        rfl
      · intro l
        change ι_R (MvPolynomial.aeval _ (MvPolynomial.X l)) = ev_M0_alg (MvPolynomial.X l)
        dsimp [ev_M0_alg]
        rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X]
        split_ifs <;> simp
    have h_rel0 : f₀_inv.comp ρ₀ = ι_R.comp e₀.symm.toRingHom := by
      apply RingHom.ext
      intro z
      obtain ⟨m, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX_mem 0) z
      apply (hUnit_Xpow m).mul_right_cancel
      simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
        RingHom.coe_coe]
      rw [HomogeneousLocalization.awayMap_mk, hf₀_mk, he₀_symm m F hF]
      have h_ev_eq : ι_R ((MvPolynomial.aeval
          (fun l : Fin (1 + 1) => if l = 0 then (1 : Polynomial k) else Polynomial.X)) F) =
          ev_M0_alg F :=
        DFunLike.congr_fun h_ev0_hom F
      rw [h_ev_eq, map_mul, map_pow]
      have hX1_ev : ev_M0_alg (MvPolynomial.X 1) = ι_R Polynomial.X := by
        dsimp [ev_M0_alg]
        rw [MvPolynomial.aeval_X]
        simp [h10]
      rw [hX1_ev]
    have h_rel_tau : f₁_inv = τ_inv.comp f₀_inv := by
      apply RingHom.ext
      intro w
      obtain ⟨m, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hM_mem w
      apply (hUnit_Xpow m).mul_right_cancel
      simp only [RingHom.coe_comp, Function.comp_apply]
      rw [hf₁_mk m F hF]
      have h_tau0 := congrArg τ_inv (hf₀_mk m F hF)
      rw [map_mul, map_pow, hτ_X] at h_tau0
      have h_mul2 := congrArg (· * (ι_R Polynomial.X) ^ (2 * m)) h_tau0
      have h_cancel_lhs : (τ_inv (f₀_inv (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF)) *
          x_inv ^ m) * (ι_R Polynomial.X) ^ (2 * m) =
          τ_inv (f₀_inv (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF)) *
            (ι_R Polynomial.X) ^ m := by
        have h2m : 2 * m = m + m := Nat.two_mul m
        rw [h2m, pow_add, ← mul_assoc, mul_assoc _ (x_inv ^ m) _, ← mul_pow, hx_inv_mul,
          one_pow, mul_one]
      rw [h_cancel_lhs] at h_mul2
      rw [h_mul2]
      have hF_hom : F.IsHomogeneous (2 * m) := by
        have hF' : F ∈ 𝒜 (2 * m) := by
          have hm2 : m • (1 + 1) = 2 * m := by simp; ring
          exact hm2 ▸ hF
        exact (MvPolynomial.mem_homogeneousSubmodule (2 * m) F).mp hF'
      conv_lhs => rw [MvPolynomial.as_sum F]
      conv_rhs => rw [MvPolynomial.as_sum F]
      rw [map_sum, map_sum, map_sum, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro s hs
      have hs_deg : s 0 + s 1 = 2 * m := by
        have hw := hF_hom (MvPolynomial.mem_support_iff.mp hs)
        simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using hw
      rw [MvPolynomial.monomial_eq, Finsupp.prod_pow, Fin.prod_univ_two]
      generalize F.coeff s = cs
      dsimp only [ev_M1_alg, ev_M0_alg]
      simp only [map_mul, map_pow, MvPolynomial.aeval_C, MvPolynomial.aeval_X]
      have hC_eq : algebraMap k R_loc cs = ι_R (Polynomial.C cs) := rfl
      have h01' : ¬ ((0 : Fin (1 + 1)) = 1) := h01
      have h10' : ¬ ((1 : Fin (1 + 1)) = 0) := h10
      simp only [h01', h10', ↓reduceIte, hC_eq, hτ_C, hτ_X, map_one, one_pow,
        mul_one, one_mul, ← hs_deg, pow_add]
      calc
        ι_R (Polynomial.C cs) * (ι_R Polynomial.X) ^ s 0 =
          ι_R (Polynomial.C cs) * (ι_R Polynomial.X) ^ s 0 *
            (x_inv * ι_R Polynomial.X) ^ s 1 := by rw [hx_inv_mul, one_pow, mul_one]
        _ = (ι_R (Polynomial.C cs) * x_inv ^ s 1) *
            ((ι_R Polynomial.X) ^ s 0 * (ι_R Polynomial.X) ^ s 1) := by rw [mul_pow]; ring
    have h_away_M1 := AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX_mem 1) zero_lt_one (hX_mem 0) hx₁
    have h_away_M0 := AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX_mem 0) zero_lt_one (hX_mem 1) hx₀
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom) ≫ away₁) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom) ≫ away₀)
    rw [← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R)),
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← h_rel1,
      CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
    dsimp only [away₁]
    rw [h_away_M1, h_rel_tau, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
      CategoryTheory.Category.assoc]
    congr 1
    dsimp only [away₀]
    rw [← h_away_M0, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, h_rel0, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
      CategoryTheory.Category.assoc]

  
  have hCovers_bool : ∀ x : ↥P1, ∃ (b : ULift.{u} Bool) (y : ↥A1),
      (if b.down then ι_P1 else ι_inf) y = x := by
    intro x
    have hx : x ∈ Set.range ι_P1.base ∪ Set.range ι_inf.base := by
      rw [hCover_P1]; trivial
    rcases hx with ⟨y, hy⟩ | ⟨y, hy⟩
    · exact ⟨ULift.up true, y, hy⟩
    · exact ⟨ULift.up false, y, hy⟩
  have hOpen_bool : ∀ b : ULift.{u} Bool,
      AlgebraicGeometry.IsOpenImmersion (if b.down then ι_P1 else ι_inf) := by
    intro b
    cases b.down <;> simp [hOpen_P1, hOpen_inf]
  let 𝒰 : P1.OpenCover :=
    AlgebraicGeometry.Scheme.Cover.mkOfCovers (P := @AlgebraicGeometry.IsOpenImmersion)
      (ULift.{u} Bool) (fun _ => A1) (fun b => if b.down then ι_P1 else ι_inf)
      hCovers_bool hOpen_bool

  have : AlgebraicGeometry.IsReduced P1 := by
    have : ∀ i : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X i) := fun _ => by
      change AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      infer_instance
    exact AlgebraicGeometry.IsReduced.of_openCover P1 𝒰

  have : IrreducibleSpace ↥P1 := by
    let q_bot : PrimeSpectrum (Polynomial k) := ⊥
    have hq_basic : q_bot ∈ PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) := by
      change Polynomial.X ∉ q_bot.asIdeal
      rw [PrimeSpectrum.asIdeal_bot, _root_.Ideal.mem_bot]
      exact Polynomial.X_ne_zero
    let y₁ : ↥P1 := ι_P1.base q_bot
    have hy₁_P1 : y₁ ∈ Set.range ι_P1.base := ⟨q_bot, rfl⟩
    have hy₁_inf : y₁ ∈ Set.range ι_inf.base := by
      have hq_pre : q_bot ∈ ι_P1.base ⁻¹' (Set.range ι_inf.base) := by
        rw [hPre_P1_inf]; exact hq_basic
      exact hq_pre
    have : IrreducibleSpace ↥A1 := by
      change IrreducibleSpace (PrimeSpectrum (Polynomial k))
      infer_instance
    have hPre_R1 : IsPreirreducible (Set.range ι_P1.base) := by
      rw [← Set.image_univ]
      exact (PreirreducibleSpace.isPreirreducible_univ (X := ↥A1)).image
        ι_P1.base ι_P1.continuous.continuousOn
    have hPre_R0 : IsPreirreducible (Set.range ι_inf.base) := by
      rw [← Set.image_univ]
      exact (PreirreducibleSpace.isPreirreducible_univ (X := ↥A1)).image
        ι_inf.base ι_inf.continuous.continuousOn
    have hOpen_R1 : IsOpen (Set.range ι_P1.base) :=
      AlgebraicGeometry.IsOpenImmersion.isOpen_range ι_P1
    have hMeet_R1 : ∀ w : Set ↥P1, IsOpen w → (Set.univ ∩ w).Nonempty →
        (Set.range ι_P1.base ∩ w).Nonempty := by
      rintro w hw ⟨z, _, hzw⟩
      have hz : z ∈ Set.range ι_P1.base ∪ Set.range ι_inf.base := by
        rw [hCover_P1]; trivial
      rcases hz with hz1 | hz0
      · exact ⟨z, hz1, hzw⟩
      · obtain ⟨z', _, hz'_w, hz'_1⟩ :=
          hPre_R0 w (Set.range ι_P1.base) hw hOpen_R1 ⟨z, hz0, hzw⟩ ⟨y₁, hy₁_inf, hy₁_P1⟩
        exact ⟨z', hz'_1, hz'_w⟩
    have hPreSpace : PreirreducibleSpace ↥P1 := by
      rw [preirreducibleSpace_iff]
      intro u v hu hv hu_ne hv_ne
      obtain ⟨z'', _, hz''_uv⟩ :=
        hPre_R1 u v hu hv (hMeet_R1 u hu hu_ne) (hMeet_R1 v hv hv_ne)
      exact ⟨z'', trivial, hz''_uv⟩
    exact { toPreirreducibleSpace := hPreSpace, toNonempty := ⟨y₁⟩ }

  have hInt_P1 : AlgebraicGeometry.IsIntegral P1 :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced P1

  have hProj_P1 : IsProjectiveOverField k P1_over :=
    ⟨1, 𝟙 P1_over, by change AlgebraicGeometry.IsClosedImmersion (𝟙 P1); infer_instance⟩

  have hSm_P1 : AlgebraicGeometry.SmoothOfRelativeDimension 1 P1_over.hom := by
    have : Algebra.IsStandardSmoothOfRelativeDimension (Nat.card (Fin 1)) k
        (MvPolynomial (Fin 1) k) :=
      Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial k (Fin 1)
    have hSm_poly_alg : Algebra.IsStandardSmoothOfRelativeDimension 1 k (Polynomial k) := by
      have h := Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv
        (Nat.card (Fin 1)) (MvPolynomial.uniqueAlgEquiv k (Fin 1))
      simpa using h
    have hSm_ring : RingHom.IsStandardSmoothOfRelativeDimension 1
        (Polynomial.C : k →+* Polynomial k) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1
        (R := k) (S := Polynomial k)).mpr hSm_poly_alg
    have hSm_loc : RingHom.Locally (@RingHom.IsStandardSmoothOfRelativeDimension 1)
        (Polynomial.C : k →+* Polynomial k) :=
      RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
        (Polynomial.C : k →+* Polynomial k) hSm_ring
    have hSm_A1 : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)).mpr hSm_loc
    have : AlgebraicGeometry.IsZariskiLocalAtSource
        (@AlgebraicGeometry.SmoothOfRelativeDimension 1) :=
      AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)
        (Q := fun {R S : Type u} [CommRing R] [CommRing S] =>
          RingHom.Locally (@RingHom.IsStandardSmoothOfRelativeDimension 1))
    apply AlgebraicGeometry.IsZariskiLocalAtSource.of_openCover
      (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1) 𝒰
    intro b
    change AlgebraicGeometry.SmoothOfRelativeDimension 1
      ((if b.down then ι_P1 else ι_inf) ≫ P1_over.hom)
    cases b.down <;> simp [hHom_P1, hHom_inf, hSm_A1]

  
  let ev₀ : Polynomial k →+* k := Polynomial.evalRingHom 0
  let s_inf : Sk ⟶ P1 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫ ι_inf

  have hs_inf_hom : s_inf ≫ P1_over.hom = 𝟙 Sk := by
    dsimp [s_inf]
    rw [CategoryTheory.Category.assoc, hHom_inf, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    have h_id : ev₀.comp Polynomial.C = RingHom.id k := by
      apply RingHom.ext
      intro c
      change Polynomial.eval 0 (Polynomial.C c) = c
      exact Polynomial.eval_C
    rw [h_id, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]

  have hDisj_inf : Disjoint (Set.range ι_P1.base) (Set.range s_inf.base) := by
    rw [Set.disjoint_left]
    rintro y hy_P1 ⟨pt, rfl⟩
    have h_pre : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀)).base pt ∈
        ι_inf.base ⁻¹' (Set.range ι_P1.base) := hy_P1
    rw [hPre_inf_P1] at h_pre
    change Polynomial.X ∉ (PrimeSpectrum.comap ev₀ (pt : PrimeSpectrum k)).asIdeal at h_pre
    apply h_pre
    change ev₀ Polynomial.X ∈ (pt : PrimeSpectrum k).asIdeal
    have hevX : ev₀ Polynomial.X = 0 := Polynomial.eval_X
    rw [hevX]
    exact (pt : PrimeSpectrum k).asIdeal.zero_mem

  have hExhaust_inf : Set.range ι_P1.base ∪ Set.range s_inf.base = Set.univ := by
    ext y
    simp only [Set.mem_union, Set.mem_univ, iff_true]
    by_cases hy : y ∈ Set.range ι_P1.base
    · exact Or.inl hy
    · right
      have hy_cov : y ∈ Set.range ι_P1.base ∪ Set.range ι_inf.base := by
        rw [hCover_P1]; trivial
      rcases hy_cov with hy1 | ⟨q, rfl⟩
      · exact False.elim (hy hy1)
      · have hq_not : (q : PrimeSpectrum (Polynomial k)) ∉
            (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) :
              Set (PrimeSpectrum (Polynomial k))) := by
          rw [← hPre_inf_P1]; exact hy
        have hX_q : Polynomial.X ∈ (q : PrimeSpectrum (Polynomial k)).asIdeal := by
          by_contra hnot; exact hq_not hnot
        have hSurj_ev₀ : Function.Surjective ev₀ :=
          fun c => ⟨Polynomial.C c, Polynomial.eval_C⟩
        have hMax_ker : (RingHom.ker ev₀).IsMaximal :=
          RingHom.ker_isMaximal_of_surjective ev₀ hSurj_ev₀
        have hKer_le : RingHom.ker ev₀ ≤ (q : PrimeSpectrum (Polynomial k)).asIdeal := by
          intro f hf
          rw [RingHom.mem_ker] at hf
          have hroot : f.IsRoot 0 := hf
          obtain ⟨g, hg⟩ := Polynomial.dvd_iff_isRoot.mpr hroot
          rw [Polynomial.C_0, sub_zero] at hg
          rw [hg]
          exact (q : PrimeSpectrum (Polynomial k)).asIdeal.mul_mem_right g hX_q
        have hKer_eq : RingHom.ker ev₀ = (q : PrimeSpectrum (Polynomial k)).asIdeal :=
          hMax_ker.eq_of_le (q : PrimeSpectrum (Polynomial k)).isPrime.ne_top hKer_le
        let pt₀ : PrimeSpectrum k := ⊥
        have hq_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀)).base pt₀ = q := by
          apply PrimeSpectrum.ext
          change _root_.Ideal.comap ev₀ pt₀.asIdeal = (q : PrimeSpectrum (Polynomial k)).asIdeal
          rw [PrimeSpectrum.asIdeal_bot, ← RingHom.ker_eq_comap_bot, hKer_eq]
        exact ⟨pt₀, congrArg ι_inf.base hq_eq⟩

  let α_neg_alg : Polynomial k →ₐ[k] Polynomial k :=
    Polynomial.aeval (R := k) (-Polynomial.X : Polynomial k)
  let α_neg : Polynomial k →+* Polynomial k := α_neg_alg.toRingHom
  let n_aff : A1 ⟶ A1 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_neg)
  have hα_inv : α_neg.comp α_neg = RingHom.id (Polynomial k) := by
    apply Polynomial.ringHom_ext
    · intro c; simp [α_neg, α_neg_alg, Polynomial.aeval_C]
    · simp [α_neg, α_neg_alg, Polynomial.aeval_X]
  have hn_inv : n_aff ≫ n_aff = 𝟙 A1 := by
    dsimp [n_aff]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hα_inv,
      CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
  have hn_C : n_aff ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
    dsimp [n_aff]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact congrArg AlgebraicGeometry.Spec.map
      (congrArg CommRingCat.ofHom (RingHom.ext fun c => α_neg_alg.commutes c))

  let j_loc : AlgebraicGeometry.Spec (CommRingCat.of R_loc) ⟶ A1 :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R)
  have : AlgebraicGeometry.IsOpenImmersion j_loc := by
    dsimp [j_loc, ι_R, R_loc]; infer_instance
  have hUnit_negX : IsUnit ((ι_R.comp α_neg) Polynomial.X) := by
    have h_neg : (ι_R.comp α_neg) Polynomial.X = - ι_R Polynomial.X := by
      simp [α_neg, α_neg_alg, Polynomial.aeval_X]
    rw [h_neg]
    exact ⟨⟨- ι_R Polynomial.X, - x_inv,
      by rw [neg_mul_neg, hx_mul_inv], by rw [neg_mul_neg, hx_inv_mul]⟩, rfl⟩
  let α_neg_loc : R_loc →+* R_loc :=
    IsLocalization.Away.lift (Polynomial.X : Polynomial k) hUnit_negX
  have hα_loc_lift : ∀ p : Polynomial k, α_neg_loc (ι_R p) = ι_R (α_neg p) :=
    fun p => IsLocalization.Away.lift_eq (Polynomial.X : Polynomial k) hUnit_negX p
  have hj_comm_naff : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_neg_loc) ≫ j_loc =
      j_loc ≫ n_aff := by
    dsimp [j_loc, n_aff]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    exact congrArg AlgebraicGeometry.Spec.map
      (congrArg CommRingCat.ofHom (RingHom.ext fun p => hα_loc_lift p))

  have hτ_comm_α : τ_inv.comp α_neg_loc = α_neg_loc.comp τ_inv := by
    apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial k))
    apply Polynomial.ringHom_ext
    · intro c
      simp only [RingHom.coe_comp, Function.comp_apply]
      have hc : α_neg (Polynomial.C c) = Polynomial.C c := α_neg_alg.commutes c
      rw [hα_loc_lift, hc, hτ_C, hα_loc_lift, hc]
    · simp only [RingHom.coe_comp, Function.comp_apply]
      have hX_neg : α_neg Polynomial.X = -Polynomial.X := by
        simp [α_neg, α_neg_alg, Polynomial.aeval_X]
      rw [hα_loc_lift, hX_neg, map_neg, map_neg, hτ_X]
      have h_prod := congrArg α_neg_loc hx_inv_mul
      rw [map_mul, map_one, hα_loc_lift, hX_neg, map_neg] at h_prod
      calc
        -x_inv = (α_neg_loc x_inv * -ι_R Polynomial.X) * -x_inv := by rw [h_prod, one_mul]
        _ = α_neg_loc x_inv * ((-ι_R Polynomial.X) * -x_inv) := by ring
        _ = α_neg_loc x_inv := by rw [neg_mul_neg, hx_mul_inv, mul_one]

  let g_br : ∀ x : 𝒰.I₀, 𝒰.X x ⟶ P1 := fun b => n_aff ≫ 𝒰.f b
  have hOffDiag : CategoryTheory.Limits.pullback.fst ι_P1 ι_inf ≫ (n_aff ≫ ι_P1) =
      CategoryTheory.Limits.pullback.snd ι_P1 ι_inf ≫ (n_aff ≫ ι_inf) := by
    let p₁ := CategoryTheory.Limits.pullback.fst ι_P1 ι_inf
    let p₀ := CategoryTheory.Limits.pullback.snd ι_P1 ι_inf
    have hRange_p₁ : Set.range ⇑p₁ ⊆ Set.range ⇑j_loc := by
      rintro _ ⟨z, rfl⟩
      have hz_mem : p₁ z ∈ ι_P1.base ⁻¹' (Set.range ι_inf.base) := by
        change ι_P1.base (p₁.base z) ∈ Set.range ι_inf.base
        have hcond := congrArg (fun h => h.base z)
          (CategoryTheory.Limits.pullback.condition (f := ι_P1) (g := ι_inf))
        exact ⟨p₀.base z, hcond.symm⟩
      rw [hPre_P1_inf] at hz_mem
      have h_loc_range : Set.range ⇑j_loc =
          (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) : Set (PrimeSpectrum (Polynomial k))) :=
        PrimeSpectrum.localization_away_comap_range R_loc (Polynomial.X : Polynomial k)
      rw [h_loc_range]
      exact hz_mem
    let ℓ := AlgebraicGeometry.IsOpenImmersion.lift j_loc p₁ hRange_p₁
    have hℓ_p₁ : ℓ ≫ j_loc = p₁ := AlgebraicGeometry.IsOpenImmersion.lift_fac j_loc p₁ hRange_p₁
    have hGlue_jloc : j_loc ≫ ι_P1 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv) ≫ j_loc ≫ ι_inf := hGlue_charts
    have hℓ_p₀ : ℓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv) ≫ j_loc = p₀ := by
      apply (cancel_mono ι_inf).mp
      calc
        (ℓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv) ≫ j_loc) ≫ ι_inf
          = ℓ ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv) ≫ j_loc ≫ ι_inf) := by
              simp only [CategoryTheory.Category.assoc]
        _ = ℓ ≫ (j_loc ≫ ι_P1) := by rw [← hGlue_jloc]
        _ = (ℓ ≫ j_loc) ≫ ι_P1 := (CategoryTheory.Category.assoc _ _ _).symm
        _ = p₁ ≫ ι_P1 := by rw [hℓ_p₁]
        _ = p₀ ≫ ι_inf := CategoryTheory.Limits.pullback.condition
    have h_comm_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_neg_loc) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_neg_loc) := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← hτ_comm_α,
        CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    change p₁ ≫ (n_aff ≫ ι_P1) = p₀ ≫ (n_aff ≫ ι_inf)
    calc
      p₁ ≫ (n_aff ≫ ι_P1)
        = (ℓ ≫ j_loc) ≫ n_aff ≫ ι_P1 := by rw [hℓ_p₁]
      _ = ℓ ≫ (j_loc ≫ n_aff) ≫ ι_P1 := by simp only [CategoryTheory.Category.assoc]
      _ = ℓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_neg_loc) ≫ (j_loc ≫ ι_P1) := by
            rw [← hj_comm_naff]; simp only [CategoryTheory.Category.assoc]
      _ = ℓ ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_neg_loc) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv)) ≫ j_loc ≫ ι_inf := by
            rw [hGlue_jloc]; simp only [CategoryTheory.Category.assoc]
      _ = ℓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_neg_loc) ≫ j_loc) ≫ ι_inf := by
            rw [h_comm_spec]; simp only [CategoryTheory.Category.assoc]
      _ = (ℓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv) ≫ j_loc) ≫ n_aff ≫ ι_inf := by
            rw [hj_comm_naff]; simp only [CategoryTheory.Category.assoc]
      _ = p₀ ≫ (n_aff ≫ ι_inf) := by rw [hℓ_p₀]

  have hGlue_ν : ∀ x y : 𝒰.I₀,
      CategoryTheory.Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ g_br x =
        CategoryTheory.Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ g_br y := by
    rintro ⟨bx⟩ ⟨by_⟩
    cases bx <;> cases by_
    · change CategoryTheory.Limits.pullback.fst ι_inf ι_inf ≫ (n_aff ≫ ι_inf) =
        CategoryTheory.Limits.pullback.snd ι_inf ι_inf ≫ (n_aff ≫ ι_inf)
      have h_eq : CategoryTheory.Limits.pullback.fst ι_inf ι_inf =
          CategoryTheory.Limits.pullback.snd ι_inf ι_inf :=
        (cancel_mono ι_inf).mp CategoryTheory.Limits.pullback.condition
      rw [h_eq]
    · change CategoryTheory.Limits.pullback.fst ι_inf ι_P1 ≫ (n_aff ≫ ι_inf) =
        CategoryTheory.Limits.pullback.snd ι_inf ι_P1 ≫ (n_aff ≫ ι_P1)
      apply (CategoryTheory.Iso.cancel_iso_hom_left
        (CategoryTheory.Limits.pullbackSymmetry ι_P1 ι_inf) _ _).mp
      rw [CategoryTheory.Limits.pullbackSymmetry_hom_comp_fst_assoc,
        CategoryTheory.Limits.pullbackSymmetry_hom_comp_snd_assoc]
      exact hOffDiag.symm
    · exact hOffDiag
    · change CategoryTheory.Limits.pullback.fst ι_P1 ι_P1 ≫ (n_aff ≫ ι_P1) =
        CategoryTheory.Limits.pullback.snd ι_P1 ι_P1 ≫ (n_aff ≫ ι_P1)
      have h_eq : CategoryTheory.Limits.pullback.fst ι_P1 ι_P1 =
          CategoryTheory.Limits.pullback.snd ι_P1 ι_P1 :=
        (cancel_mono ι_P1).mp CategoryTheory.Limits.pullback.condition
      rw [h_eq]

  let ν : P1 ⟶ P1 := AlgebraicGeometry.Scheme.Cover.glueMorphisms 𝒰 g_br hGlue_ν
  have hν_P1 : ι_P1 ≫ ν = n_aff ≫ ι_P1 := 𝒰.ι_glueMorphisms g_br hGlue_ν ⟨true⟩
  have hν_inf : ι_inf ≫ ν = n_aff ≫ ι_inf := 𝒰.ι_glueMorphisms g_br hGlue_ν ⟨false⟩
  have hν_inv : ν ≫ ν = 𝟙 P1 := by
    apply 𝒰.hom_ext
    rintro ⟨b⟩
    cases b
    · change ι_inf ≫ (ν ≫ ν) = ι_inf ≫ 𝟙 P1
      rw [← CategoryTheory.Category.assoc, hν_inf, CategoryTheory.Category.assoc, hν_inf,
        ← CategoryTheory.Category.assoc, hn_inv, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.comp_id]
    · change ι_P1 ≫ (ν ≫ ν) = ι_P1 ≫ 𝟙 P1
      rw [← CategoryTheory.Category.assoc, hν_P1, CategoryTheory.Category.assoc, hν_P1,
        ← CategoryTheory.Category.assoc, hn_inv, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.comp_id]
  let ν_neg : CategoryTheory.Iso P1 P1 :=
    { hom := ν, inv := ν, hom_inv_id := hν_inv, inv_hom_id := hν_inv }
  have hν_over : ν_neg.hom ≫ P1_over.hom = P1_over.hom := by
    apply 𝒰.hom_ext
    rintro ⟨b⟩
    cases b
    · change ι_inf ≫ (ν ≫ P1_over.hom) = ι_inf ≫ P1_over.hom
      rw [← CategoryTheory.Category.assoc, hν_inf, CategoryTheory.Category.assoc, hHom_inf, hn_C]
    · change ι_P1 ≫ (ν ≫ P1_over.hom) = ι_P1 ≫ P1_over.hom
      rw [← CategoryTheory.Category.assoc, hν_P1, CategoryTheory.Category.assoc, hHom_P1, hn_C]
  have hν_sinf : s_inf ≫ ν_neg.hom = s_inf := by
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫ ι_inf) ≫ ν =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫ ι_inf
    rw [CategoryTheory.Category.assoc, hν_inf, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    refine congrArg (· ≫ ι_inf) (congrArg AlgebraicGeometry.Spec.map
      (congrArg CommRingCat.ofHom ?_))
    apply Polynomial.ringHom_ext
    · intro c
      simp only [RingHom.coe_comp, Function.comp_apply]
      have hc : α_neg (Polynomial.C c) = Polynomial.C c := α_neg_alg.commutes c
      rw [hc]
    · simp only [RingHom.coe_comp, Function.comp_apply]
      have hX_neg : α_neg Polynomial.X = -Polynomial.X := by
        simp [α_neg, α_neg_alg, Polynomial.aeval_X]
      rw [hX_neg, map_neg]
      have hevX : ev₀ Polynomial.X = 0 := Polynomial.eval_X
      rw [hevX, neg_zero]

  
  let affPkg : ∀ δ : ℕ,
      { f : (weilAffineSpaceOver k δ).left ⟶ (weilPolyP1Over k δ).left //
        f ≫ (weilPolyP1Over k δ).hom = (weilAffineSpaceOver k δ).hom } :=
    Nat.rec
      ⟨(weilAffineSpaceOver k 0).hom, CategoryTheory.Category.comp_id _⟩
      (fun δ prev =>
        let π_head : (weilAffineSpaceOver k (δ + 1)).left ⟶ (weilAffineSpaceOver k δ).left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (MvPolynomial.rename Fin.castSucc :
              MvPolynomial (Fin δ) k →ₐ[k] MvPolynomial (Fin (δ + 1)) k).toRingHom)
        let π_last : (weilAffineSpaceOver k (δ + 1)).left ⟶ A1 :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Polynomial.aeval (R := k)
              (MvPolynomial.X (Fin.last δ) : MvPolynomial (Fin (δ + 1)) k)).toRingHom)
        have h_head_hom : (π_head ≫ prev.1) ≫ (weilPolyP1Over k δ).hom =
            (weilAffineSpaceOver k (δ + 1)).hom := by
          rw [CategoryTheory.Category.assoc, prev.2]
          dsimp [π_head, weilAffineSpaceOver]
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          exact congrArg AlgebraicGeometry.Spec.map (congrArg CommRingCat.ofHom
            (RingHom.ext fun c => (MvPolynomial.rename Fin.castSucc :
              MvPolynomial (Fin δ) k →ₐ[k] MvPolynomial (Fin (δ + 1)) k).commutes c))
        have h_last_hom : (π_last ≫ ι_P1) ≫ P1_over.hom =
            (weilAffineSpaceOver k (δ + 1)).hom := by
          rw [CategoryTheory.Category.assoc, hHom_P1]
          dsimp [π_last, weilAffineSpaceOver]
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          exact congrArg AlgebraicGeometry.Spec.map (congrArg CommRingCat.ofHom
            (RingHom.ext fun c => (Polynomial.aeval (R := k)
              (MvPolynomial.X (Fin.last δ) : MvPolynomial (Fin (δ + 1)) k)).commutes c))
        ⟨CategoryTheory.Limits.pullback.lift (π_head ≫ prev.1) (π_last ≫ ι_P1)
          (h_head_hom.trans h_last_hom.symm),
         by
           change CategoryTheory.Limits.pullback.lift _ _ _ ≫
             (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom P1_over.hom ≫
               (weilPolyP1Over k δ).hom) = _
           rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
           exact h_head_hom⟩)

  let ι_aff : ∀ δ : ℕ, (weilAffineSpaceOver k δ).left ⟶ (weilPolyP1Over k δ).left :=
    fun δ => (affPkg δ).1

  have hProp_Pd : ∀ δ : ℕ, AlgebraicGeometry.IsProper (weilPolyP1Over k δ).hom := by
    intro δ
    induction δ with
    | zero =>
      dsimp [weilPolyP1Over]
      infer_instance
    | succ δ ih =>
      dsimp [weilPolyP1Over]
      infer_instance

  have hOpen_aff : ∀ δ : ℕ, AlgebraicGeometry.IsOpenImmersion (ι_aff δ) := by
    intro δ
    induction δ with
    | zero =>
      let e_emp := MvPolynomial.isEmptyAlgEquiv k (Fin 0)
      have : CategoryTheory.IsIso
          (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin 0) k)) :=
        ⟨⟨CommRingCat.ofHom e_emp.toRingHom,
          CommRingCat.hom_ext (RingHom.ext fun c => e_emp.commutes c),
          CommRingCat.hom_ext (MvPolynomial.ringHom_ext
            (fun c => congrArg MvPolynomial.C (e_emp.commutes c))
            (fun i => Fin.elim0 i))⟩⟩
      have : CategoryTheory.IsIso
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin 0) k))) :=
        inferInstance
      change AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin 0) k)))
      infer_instance
    | succ δ ih =>
      have : AlgebraicGeometry.IsOpenImmersion (ι_aff δ) := ih
      let snoc_fn : Fin (δ + 1) →
          TensorProduct k (MvPolynomial (Fin δ) k) (Polynomial k) :=
        Fin.snoc (α := fun _ => TensorProduct k (MvPolynomial (Fin δ) k) (Polynomial k))
          (fun i : Fin δ => TensorProduct.tmul k (MvPolynomial.X i) (1 : Polynomial k))
          (TensorProduct.tmul k (1 : MvPolynomial (Fin δ) k) Polynomial.X)
      let Φ_sp : MvPolynomial (Fin (δ + 1)) k →ₐ[k]
          TensorProduct k (MvPolynomial (Fin δ) k) (Polynomial k) :=
        MvPolynomial.aeval snoc_fn
      let Ψ_sp : TensorProduct k (MvPolynomial (Fin δ) k) (Polynomial k) →ₐ[k]
          MvPolynomial (Fin (δ + 1)) k :=
        Algebra.TensorProduct.lift (R := k) (S := k)
          (MvPolynomial.rename Fin.castSucc)
          (Polynomial.aeval (MvPolynomial.X (Fin.last δ)))
          (fun _ _ => Commute.all _ _)
      have hΨΦ : Ψ_sp.comp Φ_sp = AlgHom.id k (MvPolynomial (Fin (δ + 1)) k) := by
        apply MvPolynomial.algHom_ext
        intro j
        simp only [AlgHom.coe_comp, Function.comp_apply, AlgHom.id_apply, Φ_sp,
          MvPolynomial.aeval_X]
        refine Fin.lastCases ?_ (fun i => ?_) j
        · dsimp only [snoc_fn, Ψ_sp]
          rw [Fin.snoc_last, Algebra.TensorProduct.lift_tmul, map_one, one_mul,
            Polynomial.aeval_X]
        · dsimp only [snoc_fn, Ψ_sp]
          rw [Fin.snoc_castSucc, Algebra.TensorProduct.lift_tmul, map_one, mul_one,
            MvPolynomial.rename_X]
      have hΦΨ : Φ_sp.comp Ψ_sp =
          AlgHom.id k (TensorProduct k (MvPolynomial (Fin δ) k) (Polynomial k)) := by
        apply Algebra.TensorProduct.ext
        · apply MvPolynomial.algHom_ext
          intro i
          simp only [AlgHom.coe_comp, Function.comp_apply, AlgHom.id_apply,
            Algebra.TensorProduct.includeLeft_apply]
          dsimp only [Ψ_sp, Φ_sp, snoc_fn]
          rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one, MvPolynomial.rename_X,
            MvPolynomial.aeval_X, Fin.snoc_castSucc]
        · apply Polynomial.algHom_ext
          simp only [AlgHom.restrictScalars_apply, AlgHom.coe_comp, Function.comp_apply,
            AlgHom.id_apply, Algebra.TensorProduct.includeRight_apply]
          dsimp only [Ψ_sp, Φ_sp, snoc_fn]
          rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul, Polynomial.aeval_X,
            MvPolynomial.aeval_X, Fin.snoc_last]
      let e_sp : MvPolynomial (Fin (δ + 1)) k ≃ₐ[k]
          TensorProduct k (MvPolynomial (Fin δ) k) (Polynomial k) :=
        AlgEquiv.ofAlgHom Φ_sp Ψ_sp hΦΨ hΨΦ
      have : CategoryTheory.IsIso (CommRingCat.ofHom e_sp.symm.toRingHom) :=
        ⟨⟨CommRingCat.ofHom e_sp.toRingHom,
          CommRingCat.hom_ext (RingHom.ext fun x => e_sp.apply_symm_apply x),
          CommRingCat.hom_ext (RingHom.ext fun x => e_sp.symm_apply_apply x)⟩⟩
      have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_sp.symm.toRingHom)) :=
        inferInstance
      let f_Sδ : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin δ) k)) ⟶ Sk :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (MvPolynomial (Fin δ) k)))
      let f_T1 : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ Sk :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (Polynomial k)))
      let q_iso : (weilAffineSpaceOver k (δ + 1)).left ⟶
          CategoryTheory.Limits.pullback f_Sδ f_T1 :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_sp.symm.toRingHom) ≫
          (AlgebraicGeometry.pullbackSpecIso k (MvPolynomial (Fin δ) k) (Polynomial k)).inv
      have : CategoryTheory.IsIso q_iso := by
        change CategoryTheory.IsIso
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_sp.symm.toRingHom) ≫
            (AlgebraicGeometry.pullbackSpecIso k (MvPolynomial (Fin δ) k) (Polynomial k)).inv)
        infer_instance
      have : AlgebraicGeometry.IsOpenImmersion q_iso := inferInstance
      have he₁_pb : f_Sδ ≫ 𝟙 Sk = ι_aff δ ≫ (weilPolyP1Over k δ).hom := by
        rw [CategoryTheory.Category.comp_id, (affPkg δ).2]
        rfl
      have he₂_pb : f_T1 ≫ 𝟙 Sk = ι_P1 ≫ P1_over.hom := by
        rw [CategoryTheory.Category.comp_id, hHom_P1]
      let p_map := CategoryTheory.Limits.pullback.map f_Sδ f_T1
        (weilPolyP1Over k δ).hom P1_over.hom (ι_aff δ) ι_P1 (𝟙 Sk) he₁_pb he₂_pb
      have : AlgebraicGeometry.IsOpenImmersion p_map :=
        @AlgebraicGeometry.Scheme.pullback_map_isOpenImmersion _ _ _ _ _ _
          f_Sδ f_T1 (weilPolyP1Over k δ).hom P1_over.hom (ι_aff δ) ι_P1 (𝟙 Sk) he₁_pb he₂_pb
          ih hOpen_P1 inferInstance
      let π_head_spec :
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (δ + 1)) k)) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin δ) k)) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (MvPolynomial.rename Fin.castSucc :
            MvPolynomial (Fin δ) k →ₐ[k] MvPolynomial (Fin (δ + 1)) k).toRingHom)
      let π_last_spec :
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (δ + 1)) k)) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Polynomial.aeval (R := k)
            (MvPolynomial.X (Fin.last δ) : MvPolynomial (Fin (δ + 1)) k)).toRingHom)
      have h_q_fst :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_sp.symm.toRingHom) ≫
            (AlgebraicGeometry.pullbackSpecIso k (MvPolynomial (Fin δ) k) (Polynomial k)).inv) ≫
            CategoryTheory.Limits.pullback.fst f_Sδ f_T1 =
          π_head_spec := by
        dsimp only [f_Sδ, f_T1, π_head_spec]
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_fst,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        refine congrArg AlgebraicGeometry.Spec.map
          (congrArg CommRingCat.ofHom (RingHom.ext fun p => ?_))
        change Ψ_sp (TensorProduct.tmul k p 1) = (MvPolynomial.rename Fin.castSucc) p
        dsimp only [Ψ_sp]
        rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
      have h_q_snd :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_sp.symm.toRingHom) ≫
            (AlgebraicGeometry.pullbackSpecIso k (MvPolynomial (Fin δ) k) (Polynomial k)).inv) ≫
            CategoryTheory.Limits.pullback.snd f_Sδ f_T1 =
          π_last_spec := by
        dsimp only [f_Sδ, f_T1, π_last_spec]
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_snd,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        refine congrArg AlgebraicGeometry.Spec.map
          (congrArg CommRingCat.ofHom (RingHom.ext fun p => ?_))
        change Ψ_sp (TensorProduct.tmul k 1 p) =
          (Polynomial.aeval (MvPolynomial.X (Fin.last δ))) p
        dsimp only [Ψ_sp]
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      have h_eq_comp : ι_aff (δ + 1) = q_iso ≫ p_map := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · have h_lhs :
              ι_aff (δ + 1) ≫
                CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom P1_over.hom =
              (π_head_spec : (weilAffineSpaceOver k (δ + 1)).left ⟶
                (weilAffineSpaceOver k δ).left) ≫ ι_aff δ :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have h_rhs1 :
              (q_iso ≫ p_map) ≫
                CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom P1_over.hom =
              q_iso ≫
                (p_map ≫ CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom P1_over.hom) :=
            CategoryTheory.Category.assoc _ _ _
          have h_rhs2 :
              p_map ≫ CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom P1_over.hom =
              CategoryTheory.Limits.pullback.fst f_Sδ f_T1 ≫ ι_aff δ :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have h_rhs3 :
              q_iso ≫ (CategoryTheory.Limits.pullback.fst f_Sδ f_T1 ≫ ι_aff δ) =
              (q_iso ≫ CategoryTheory.Limits.pullback.fst f_Sδ f_T1) ≫ ι_aff δ :=
            (CategoryTheory.Category.assoc _ _ _).symm
          have h_rhs4 :
              (q_iso ≫ CategoryTheory.Limits.pullback.fst f_Sδ f_T1) ≫ ι_aff δ =
              (π_head_spec : (weilAffineSpaceOver k (δ + 1)).left ⟶
                (weilAffineSpaceOver k δ).left) ≫ ι_aff δ :=
            congrArg (fun g : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (δ + 1)) k)) ⟶
                AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin δ) k)) =>
              g ≫ (ι_aff δ : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin δ) k)) ⟶
                (weilPolyP1Over k δ).left)) h_q_fst
          exact h_lhs.trans (h_rhs4.symm.trans (h_rhs3.symm.trans
            ((congrArg (q_iso ≫ ·) h_rhs2).symm.trans h_rhs1.symm)))
        · have h_lhs :
              ι_aff (δ + 1) ≫
                CategoryTheory.Limits.pullback.snd (weilPolyP1Over k δ).hom P1_over.hom =
              (π_last_spec : (weilAffineSpaceOver k (δ + 1)).left ⟶ A1) ≫ ι_P1 :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have h_rhs1 :
              (q_iso ≫ p_map) ≫
                CategoryTheory.Limits.pullback.snd (weilPolyP1Over k δ).hom P1_over.hom =
              q_iso ≫
                (p_map ≫ CategoryTheory.Limits.pullback.snd (weilPolyP1Over k δ).hom P1_over.hom) :=
            CategoryTheory.Category.assoc _ _ _
          have h_rhs2 :
              p_map ≫ CategoryTheory.Limits.pullback.snd (weilPolyP1Over k δ).hom P1_over.hom =
              CategoryTheory.Limits.pullback.snd f_Sδ f_T1 ≫ ι_P1 :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have h_rhs3 :
              q_iso ≫ (CategoryTheory.Limits.pullback.snd f_Sδ f_T1 ≫ ι_P1) =
              (q_iso ≫ CategoryTheory.Limits.pullback.snd f_Sδ f_T1) ≫ ι_P1 :=
            (CategoryTheory.Category.assoc _ _ _).symm
          have h_rhs4 :
              (q_iso ≫ CategoryTheory.Limits.pullback.snd f_Sδ f_T1) ≫ ι_P1 =
              (π_last_spec : (weilAffineSpaceOver k (δ + 1)).left ⟶ A1) ≫ ι_P1 :=
            congrArg (fun g : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (δ + 1)) k)) ⟶
                AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) =>
              g ≫ ι_P1) h_q_snd
          exact h_lhs.trans (h_rhs4.symm.trans (h_rhs3.symm.trans
            ((congrArg (q_iso ≫ ·) h_rhs2).symm.trans h_rhs1.symm)))
      rw [h_eq_comp]
      exact AlgebraicGeometry.IsOpenImmersion.comp q_iso p_map

  
  refine ⟨ι_P1, ι_aff, hProp_P1, hInt_P1, hProj_P1, hSm_P1, hOpen_P1, hHom_P1,
    ⟨s_inf, ν_neg, hs_inf_hom, hDisj_inf, hExhaust_inf, hν_over, hν_P1.symm, hν_sinf⟩,
    rfl, fun δ => ⟨hProp_Pd δ, hOpen_aff δ, (affPkg δ).2,
      CategoryTheory.Limits.pullback.lift_fst _ _ _,
      CategoryTheory.Limits.pullback.lift_snd _ _ _⟩⟩

theorem weil_polyP1_proper_smooth_integral (k : Type u) [Field k] (δ : ℕ) :
    AlgebraicGeometry.IsProper (weilPolyP1Over k δ).hom ∧
    AlgebraicGeometry.IsIntegral (weilPolyP1Over k δ).left ∧
    AlgebraicGeometry.SmoothOfRelativeDimension δ (weilPolyP1Over k δ).hom :=
by
  classical
  have hPillarA :
      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom ∧
      ∃ (ι₀ ι₁ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
          (weilProjectiveSpaceOver k 1).left)
        (s₁ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
          (weilProjectiveSpaceOver k 1).left),
        AlgebraicGeometry.IsOpenImmersion ι₀ ∧
        AlgebraicGeometry.IsOpenImmersion ι₁ ∧
        CategoryTheory.CategoryStruct.comp ι₀ (weilProjectiveSpaceOver k 1).hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) ∧
        CategoryTheory.CategoryStruct.comp ι₁ (weilProjectiveSpaceOver k 1).hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) ∧
        Set.range ι₀.base ∪ Set.range ι₁.base = Set.univ ∧
        CategoryTheory.CategoryStruct.comp s₁ (weilProjectiveSpaceOver k 1).hom =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
        Set.range s₁.base ⊆ Set.range ι₀.base ∧
        Set.range s₁.base ⊆ Set.range ι₁.base := by
    let A := MvPolynomial (Fin 2) k
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let φ₀ : k →+* ↥(𝒜 0) := algebraMap k ↥(𝒜 0)
    have hφ₀_coe : ∀ c : k, ((φ₀ c : ↥(𝒜 0)) : A) = MvPolynomial.C c := by
      intro c
      rw [SetLike.GradeZero.coe_algebraMap 𝒜 c, MvPolynomial.algebraMap_eq]
    haveI : IsScalarTower k ↥(𝒜 0) A :=
      IsScalarTower.of_algebraMap_eq (R := k) (S := ↥(𝒜 0)) (A := A) fun c =>
        (SetLike.GradeZero.algebraMap_apply 𝒜 (φ₀ c)).trans (SetLike.GradeZero.coe_algebraMap 𝒜 c)
    have hφ₀_bij : Function.Bijective φ₀ := by
      refine ⟨?_, ?_⟩
      · intro c₁ c₂ hc
        have hval : ((φ₀ c₁ : ↥(𝒜 0)) : A) = ((φ₀ c₂ : ↥(𝒜 0)) : A) := congrArg Subtype.val hc
        rw [hφ₀_coe, hφ₀_coe] at hval
        exact MvPolynomial.C_injective (Fin 2) k hval
      · intro y
        have hy : (y : A) ∈ (1 : Submodule k A) := by
          simpa [𝒜, MvPolynomial.homogeneousSubmodule_zero] using y.2
        obtain ⟨c, hc⟩ := Submodule.mem_one.mp hy
        refine ⟨c, Subtype.ext ?_⟩
        rw [hφ₀_coe, ← MvPolynomial.algebraMap_eq]
        exact hc
    let e_zero : k ≃+* ↥(𝒜 0) := RingEquiv.ofBijective φ₀ hφ₀_bij
    let f_zero : CommRingCat.of k ⟶ CommRingCat.of ↥(𝒜 0) := CommRingCat.ofHom φ₀
    let g_zero : CommRingCat.of ↥(𝒜 0) ⟶ CommRingCat.of k :=
      CommRingCat.ofHom e_zero.symm.toRingHom
    haveI hIso_fzero : CategoryTheory.IsIso f_zero :=
      ⟨⟨g_zero,
        CommRingCat.hom_ext (RingHom.ext fun x => e_zero.symm_apply_apply x),
        CommRingCat.hom_ext (RingHom.ext fun y => e_zero.apply_symm_apply y)⟩⟩
    haveI hIso_Spec_zero : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map f_zero) := inferInstance
    haveI : Algebra.FiniteType ↥(𝒜 0) A :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) A
    have hProp_P1 : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom := by
      change AlgebraicGeometry.IsProper
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫ AlgebraicGeometry.Spec.map f_zero)
      infer_instance
    let X_v : Fin 2 → A := fun m => MvPolynomial.X m
    have hX_hom : ∀ m : Fin 2, X_v m ∈ 𝒜 1 := fun m => MvPolynomial.isHomogeneous_X k m
    have hChart : ∀ (i j : Fin 2), i ≠ j → (∀ m : Fin 2, m = i ∨ m = j) →
        ∃ e : Polynomial k ≃+* HomogeneousLocalization.Away 𝒜 (X_v i),
          e.symm.toRingHom.comp
            ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (X_v i))).comp φ₀) =
            Polynomial.C ∧
          (∀ hXi : X_v i ∈ 𝒜 1, ∀ hXj : X_v j ∈ 𝒜 1,
            e.symm (HomogeneousLocalization.Away.isLocalizationElem hXi hXj) = Polynomial.X) := by
      intro i j hij hcov_ij
      let R_i := HomogeneousLocalization.Away 𝒜 (X_v i)
      let L_i := Localization.Away (X_v i)
      let ι_loc : A →+* L_i := algebraMap A L_i
      let c_i : k →+* R_i :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (X_v i))).comp φ₀
      have hXj_1 : X_v j ∈ 𝒜 (1 • 1) := by simpa using hX_hom j
      let t_i : R_i := HomogeneousLocalization.Away.mk 𝒜 (hX_hom i) 1 (X_v j) hXj_1
      let ψ_i : Polynomial k →+* R_i := Polynomial.eval₂RingHom c_i t_i
      let ev_i : A →+* Polynomial k :=
        (MvPolynomial.aeval (fun m : Fin 2 =>
          if m = i then (1 : Polynomial k) else Polynomial.X)).toRingHom
      have hev_Xi : ev_i (X_v i) = 1 := by
        change MvPolynomial.aeval _ (MvPolynomial.X i) = 1
        rw [MvPolynomial.aeval_X, if_pos rfl]
      have hev_Xj : ev_i (X_v j) = Polynomial.X := by
        change MvPolynomial.aeval _ (MvPolynomial.X j) = Polynomial.X
        rw [MvPolynomial.aeval_X, if_neg hij.symm]
      have hpow_unit : ∀ y : Submonoid.powers (X_v i), IsUnit (ev_i y.1) := by
        rintro ⟨_, n, rfl⟩
        rw [map_pow, hev_Xi, one_pow]
        exact isUnit_one
      let ev_loc : L_i →+* Polynomial k := IsLocalization.lift (S := L_i) hpow_unit
      have hev_loc_eq : ∀ F : A, ev_loc (ι_loc F) = ev_i F :=
        fun F => IsLocalization.lift_eq (S := L_i) hpow_unit F
      let val_hom : R_i →+* L_i := algebraMap R_i L_i
      let φ_i : R_i →+* Polynomial k := ev_loc.comp val_hom
      let u_i : L_i := IsLocalization.Away.invSelf (S := L_i) (X_v i)
      have hu_mul : ι_loc (X_v i) * u_i = 1 := IsLocalization.Away.mul_invSelf (X_v i)
      have hev_u : ev_loc u_i = 1 := by
        have h1 : ev_loc (ι_loc (X_v i) * u_i) = ev_loc 1 := congrArg ev_loc hu_mul
        rw [map_mul, hev_loc_eq, hev_Xi, one_mul, map_one] at h1
        exact h1
      have hval_mk : ∀ (n : ℕ) (F : A) (hF : F ∈ 𝒜 (n • 1)),
          val_hom (HomogeneousLocalization.Away.mk 𝒜 (hX_hom i) n F hF) =
            ι_loc F * u_i ^ n := by
        intro n F hF
        let s_pow : Submonoid.powers (X_v i) := ⟨X_v i ^ n, ⟨n, rfl⟩⟩
        change (HomogeneousLocalization.Away.mk 𝒜 (hX_hom i) n F hF).val = ι_loc F * u_i ^ n
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
        change IsLocalization.mk' L_i F s_pow = ι_loc F * u_i ^ n
        have hpow_inv : ι_loc (X_v i ^ n) * u_i ^ n = 1 := by
          rw [map_pow, ← mul_pow, hu_mul, one_pow]
        have hspec : ι_loc (X_v i ^ n) * IsLocalization.mk' L_i F s_pow = ι_loc F :=
          IsLocalization.mk'_spec' L_i F s_pow
        calc
          IsLocalization.mk' L_i F s_pow
            = IsLocalization.mk' L_i F s_pow * (ι_loc (X_v i ^ n) * u_i ^ n) := by
                rw [hpow_inv, mul_one]
          _ = (ι_loc (X_v i ^ n) * IsLocalization.mk' L_i F s_pow) * u_i ^ n := by
                ring
          _ = ι_loc F * u_i ^ n := by rw [hspec]
      have ht_val : val_hom t_i = ι_loc (X_v j) * u_i := by
        simpa [t_i, pow_one] using hval_mk 1 (X_v j) hXj_1
      have hval_c : ∀ c : k, val_hom (c_i c) = ι_loc (MvPolynomial.C c) := by
        intro c
        change (algebraMap R_i L_i)
          ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (X_v i))) (φ₀ c)) = _
        rw [← HomogeneousLocalization.algebraMap_eq,
          ← IsScalarTower.algebraMap_apply ↥(𝒜 0) R_i L_i]
        exact congrArg ι_loc (hφ₀_coe c)
      have hψ_C : ∀ c : k, ψ_i (Polynomial.C c) = c_i c :=
        fun c => by simp [ψ_i]
      have hψ_X : ψ_i Polynomial.X = t_i := by simp [ψ_i]
      have hev_C : ∀ c : k, ev_i (MvPolynomial.C c) = Polynomial.C c := by
        intro c
        change MvPolynomial.aeval _ (MvPolynomial.C c) = Polynomial.C c
        rw [MvPolynomial.aeval_C, Polynomial.algebraMap_eq]
      have hLeft : φ_i.comp ψ_i = RingHom.id (Polynomial k) := by
        apply Polynomial.ringHom_ext
        · intro c
          change φ_i (ψ_i (Polynomial.C c)) = Polynomial.C c
          rw [hψ_C]
          change ev_loc (val_hom (c_i c)) = Polynomial.C c
          rw [hval_c, hev_loc_eq, hev_C]
        · change φ_i (ψ_i Polynomial.X) = Polynomial.X
          rw [hψ_X]
          change ev_loc (val_hom t_i) = Polynomial.X
          rw [ht_val, map_mul, hev_loc_eq, hev_Xj, hev_u, mul_one]
      have hRight : ψ_i.comp φ_i = RingHom.id R_i := by
        refine RingHom.ext fun z => ?_
        rw [HomogeneousLocalization.ext_iff_val]
        obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX_hom i) z
        have hφ_mk : φ_i (HomogeneousLocalization.Away.mk 𝒜 (hX_hom i) n F hF) = ev_i F := by
          change ev_loc (val_hom (HomogeneousLocalization.Away.mk 𝒜 (hX_hom i) n F hF)) = ev_i F
          rw [hval_mk, map_mul, map_pow, hev_loc_eq, hev_u, one_pow, mul_one]
        simp only [RingHom.comp_apply, RingHom.id_apply, hφ_mk]
        let θ_i : A →+* L_i := val_hom.comp (ψ_i.comp ev_i)
        change θ_i F = val_hom (HomogeneousLocalization.Away.mk 𝒜 (hX_hom i) n F hF)
        rw [hval_mk]
        have hθ_C : ∀ c : k, θ_i (MvPolynomial.C c) = ι_loc (MvPolynomial.C c) := by
          intro c
          change val_hom (ψ_i (ev_i (MvPolynomial.C c))) = ι_loc (MvPolynomial.C c)
          rw [hev_C, hψ_C, hval_c]
        have hθ_X : ∀ m : Fin 2, θ_i (MvPolynomial.X m) = ι_loc (MvPolynomial.X m) * u_i := by
          intro m
          rcases hcov_ij m with hmi | hmj
          · subst m
            change val_hom (ψ_i (ev_i (X_v i))) = ι_loc (X_v i) * u_i
            rw [hev_Xi, map_one, map_one, hu_mul]
          · subst m
            change val_hom (ψ_i (ev_i (X_v j))) = ι_loc (X_v j) * u_i
            rw [hev_Xj, hψ_X, ht_val]
        have hF_hom : F.IsHomogeneous n := by
          have hF' : F ∈ 𝒜 n := by simpa using hF
          exact hF'
        rw [F.as_sum, map_sum, map_sum, Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro s hs
        have hs_deg : (∑ m : Fin 2, s m) = n := by
          have hw := hF_hom (MvPolynomial.mem_support_iff.mp hs)
          simpa [Finsupp.weight_apply, Finsupp.linearCombination_apply, Finsupp.sum_fintype] using hw
        rw [MvPolynomial.monomial_eq, map_mul, map_mul, hθ_C, Finsupp.prod_pow,
          map_prod, map_prod]
        simp only [map_pow, hθ_X, mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum,
          hs_deg, mul_assoc]
      let e_i : Polynomial k ≃+* R_i :=
        RingEquiv.ofRingHom ψ_i φ_i hRight hLeft
      refine ⟨e_i, ?_, ?_⟩
      · refine RingHom.ext fun c => ?_
        change e_i.symm (c_i c) = Polynomial.C c
        have he_C : e_i (Polynomial.C c) = c_i c := hψ_C c
        rw [← he_C, e_i.symm_apply_apply]
      · intro hXi hXj
        have helem : HomogeneousLocalization.Away.isLocalizationElem hXi hXj = t_i := by
          rw [HomogeneousLocalization.ext_iff_val]
          dsimp only [HomogeneousLocalization.Away.isLocalizationElem, t_i]
          rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, pow_one]
        rw [helem]
        have he_X : e_i Polynomial.X = t_i := hψ_X
        rw [← he_X, e_i.symm_apply_apply]
    have hfin2_01 : ∀ m : Fin 2, m = 0 ∨ m = 1 := by decide
    have hfin2_10 : ∀ m : Fin 2, m = 1 ∨ m = 0 := by decide
    obtain ⟨e₀, he₀_C, he₀_X⟩ := hChart 0 1 (by decide) hfin2_01
    obtain ⟨e₁, he₁_C, _⟩ := hChart 1 0 (by decide) hfin2_10
    let ι₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
        (weilProjectiveSpaceOver k 1).left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 (X_v 0) (hX_hom 0) zero_lt_one
    let ι₁ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
        (weilProjectiveSpaceOver k 1).left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 (X_v 1) (hX_hom 1) zero_lt_one
    haveI hIso_hom0 : CategoryTheory.IsIso (CommRingCat.ofHom e₀.symm.toRingHom) :=
      ⟨⟨CommRingCat.ofHom e₀.toRingHom,
        CommRingCat.hom_ext (RingHom.ext fun x => e₀.apply_symm_apply x),
        CommRingCat.hom_ext (RingHom.ext fun x => e₀.symm_apply_apply x)⟩⟩
    haveI hIso_hom1 : CategoryTheory.IsIso (CommRingCat.ofHom e₁.symm.toRingHom) :=
      ⟨⟨CommRingCat.ofHom e₁.toRingHom,
        CommRingCat.hom_ext (RingHom.ext fun x => e₁.apply_symm_apply x),
        CommRingCat.hom_ext (RingHom.ext fun x => e₁.symm_apply_apply x)⟩⟩
    haveI hIso_e0 : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom)) := inferInstance
    haveI hIso_e1 : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom)) := inferInstance
    have hOpen₀ : AlgebraicGeometry.IsOpenImmersion ι₀ :=
      @AlgebraicGeometry.IsOpenImmersion.comp _ _ _
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom))
        (AlgebraicGeometry.Proj.awayι 𝒜 (X_v 0) (hX_hom 0) zero_lt_one)
        inferInstance inferInstance
    have hOpen₁ : AlgebraicGeometry.IsOpenImmersion ι₁ :=
      @AlgebraicGeometry.IsOpenImmersion.comp _ _ _
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom))
        (AlgebraicGeometry.Proj.awayι 𝒜 (X_v 1) (hX_hom 1) zero_lt_one)
        inferInstance inferInstance
    have hHom₀ : ι₀ ≫ (weilProjectiveSpaceOver k 1).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 (X_v 0) (hX_hom 0) zero_lt_one) ≫
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫ AlgebraicGeometry.Spec.map f_zero) = _
      rw [CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Proj.awayι 𝒜 (X_v 0) (hX_hom 0) zero_lt_one),
        AlgebraicGeometry.Proj.awayι_toSpecZero,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
