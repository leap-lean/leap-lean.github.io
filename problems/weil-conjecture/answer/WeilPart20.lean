        (CategoryTheory.MorphismProperty.Over.pullbackComp h₁L h₁)

    have hw_tower : wPullSec E₀.subtype (ι₁L.comp ψ₁) hψ_0L ≫ e_comp.hom.app W_M₀ =
        wPullSec E₁.subtype ι₁L hι₁L ≫ B₁L.map (wPullSec (Subfield.inclusion hle) ψ₁ hψ₁) := by
      let w_0L := wPullSec E₀.subtype (ι₁L.comp ψ₁) hψ_0L
      let w_1L := wPullSec E₁.subtype ι₁L hι₁L
      let w_01 := wPullSec (Subfield.inclusion hle) ψ₁ hψ₁
      let fst_L := CategoryTheory.Limits.pullback.fst W_M₀.hom hL
      let snd_L := CategoryTheory.Limits.pullback.snd W_M₀.hom hL
      let fst_11 := CategoryTheory.Limits.pullback.fst W_M₀.hom (h₁L ≫ h₁)
      let snd_11 := CategoryTheory.Limits.pullback.snd W_M₀.hom (h₁L ≫ h₁)
      let fst_1 := CategoryTheory.Limits.pullback.fst W_M₀.hom h₁
      let snd_1 := CategoryTheory.Limits.pullback.snd W_M₀.hom h₁
      let fst_1L := CategoryTheory.Limits.pullback.fst snd_1 h₁L
      let snd_1L := CategoryTheory.Limits.pullback.snd snd_1 h₁L
      let c₁ := (CategoryTheory.Limits.pullback.congrHom
        (rfl : W_M₀.hom = W_M₀.hom) hh_comp.symm).hom
      let c₂ := (CategoryTheory.Limits.pullback.congrHom
        (rfl : W_M₀.hom = W_M₀.hom) (rfl : h₁L ≫ h₁ = h₁L ≫ h₁)).hom
      let p_inv := (CategoryTheory.Limits.pullbackLeftPullbackSndIso W_M₀.hom h₁ h₁L).inv
      have hc₁_fst : c₁ ≫ fst_11 = fst_L :=
        (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans (CategoryTheory.Category.comp_id _)
      have hc₁_snd : c₁ ≫ snd_11 = snd_L :=
        (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans (CategoryTheory.Category.comp_id _)
      have hc₂_fst : c₂ ≫ fst_11 = fst_11 :=
        (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans (CategoryTheory.Category.comp_id _)
      have hc₂_snd : c₂ ≫ snd_11 = snd_11 :=
        (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans (CategoryTheory.Category.comp_id _)
      have hp_fst_fst : p_inv ≫ (fst_1L ≫ fst_1) = fst_11 :=
        CategoryTheory.Limits.pullbackLeftPullbackSndIso_inv_fst W_M₀.hom h₁ h₁L
      have hp_fst_snd : p_inv ≫ (fst_1L ≫ snd_1) = snd_11 ≫ h₁L :=
        CategoryTheory.Limits.pullbackLeftPullbackSndIso_inv_fst_snd W_M₀.hom h₁ h₁L
      have hp_snd : p_inv ≫ snd_1L = snd_11 :=
        CategoryTheory.Limits.pullbackLeftPullbackSndIso_inv_snd_snd W_M₀.hom h₁ h₁L
      have he_fst_fst : (e_comp.hom.app W_M₀).left ≫ (fst_1L ≫ fst_1) = fst_L :=
        calc (c₁ ≫ (c₂ ≫ p_inv)) ≫ (fst_1L ≫ fst_1)
          _ = c₁ ≫ (c₂ ≫ (p_inv ≫ (fst_1L ≫ fst_1))) :=
              (CategoryTheory.Category.assoc _ _ _).trans
                (congrArg (c₁ ≫ ·) (CategoryTheory.Category.assoc _ _ _))
          _ = c₁ ≫ (c₂ ≫ fst_11) := congrArg (c₁ ≫ ·) (congrArg (c₂ ≫ ·) hp_fst_fst)
          _ = c₁ ≫ fst_11 := congrArg (c₁ ≫ ·) hc₂_fst
          _ = fst_L := hc₁_fst
      have he_fst_snd : (e_comp.hom.app W_M₀).left ≫ (fst_1L ≫ snd_1) = snd_L ≫ h₁L :=
        calc (c₁ ≫ (c₂ ≫ p_inv)) ≫ (fst_1L ≫ snd_1)
          _ = c₁ ≫ (c₂ ≫ (p_inv ≫ (fst_1L ≫ snd_1))) :=
              (CategoryTheory.Category.assoc _ _ _).trans
                (congrArg (c₁ ≫ ·) (CategoryTheory.Category.assoc _ _ _))
          _ = c₁ ≫ (c₂ ≫ (snd_11 ≫ h₁L)) := congrArg (c₁ ≫ ·) (congrArg (c₂ ≫ ·) hp_fst_snd)
          _ = c₁ ≫ ((c₂ ≫ snd_11) ≫ h₁L) :=
              congrArg (c₁ ≫ ·) (CategoryTheory.Category.assoc _ _ _).symm
          _ = c₁ ≫ (snd_11 ≫ h₁L) := congrArg (c₁ ≫ ·) (congrArg (· ≫ h₁L) hc₂_snd)
          _ = (c₁ ≫ snd_11) ≫ h₁L := (CategoryTheory.Category.assoc _ _ _).symm
          _ = snd_L ≫ h₁L := congrArg (· ≫ h₁L) hc₁_snd
      have he_snd : (e_comp.hom.app W_M₀).left ≫ snd_1L = snd_L :=
        calc (c₁ ≫ (c₂ ≫ p_inv)) ≫ snd_1L
          _ = c₁ ≫ (c₂ ≫ (p_inv ≫ snd_1L)) :=
              (CategoryTheory.Category.assoc _ _ _).trans
                (congrArg (c₁ ≫ ·) (CategoryTheory.Category.assoc _ _ _))
          _ = c₁ ≫ (c₂ ≫ snd_11) := congrArg (c₁ ≫ ·) (congrArg (c₂ ≫ ·) hp_snd)
          _ = c₁ ≫ snd_11 := congrArg (c₁ ≫ ·) hc₂_snd
          _ = snd_L := hc₁_snd
      have hw0L_fst : w_0L.left ≫ fst_L =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι₁L.comp ψ₁)) :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hw0L_snd : w_0L.left ≫ snd_L = V_NL.hom :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hw1L_fst : w_1L.left ≫ CategoryTheory.Limits.pullback.fst V_N₁.hom h₁L =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁L) :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hw1L_snd : w_1L.left ≫ CategoryTheory.Limits.pullback.snd V_N₁.hom h₁L = V_NL.hom :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hw01_fst : w_01.left ≫ fst_1 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hw01_snd : w_01.left ≫ snd_1 = V_N₁.hom :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hB01_fst : (B₁L.map w_01).left ≫ fst_1L =
          CategoryTheory.Limits.pullback.fst V_N₁.hom h₁L ≫ w_01.left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hB01_snd : (B₁L.map w_01).left ≫ snd_1L =
          CategoryTheory.Limits.pullback.snd V_N₁.hom h₁L :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have h_ι_base : V_NL.hom ≫ h₁L =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁L) ≫ V_N₁.hom := by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L N_L)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom E₁.subtype) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁L) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥E₁ N₁))
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hι₁L]
      refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
      apply CategoryTheory.Limits.pullback.hom_ext
      · apply CategoryTheory.Limits.pullback.hom_ext
        · exact ((CategoryTheory.Category.assoc _ _ _).trans
              (CategoryTheory.Category.assoc _ _ _)).trans
            ((congrArg (w_0L.left ≫ ·) he_fst_fst).trans
              (hw0L_fst.trans
                (((congrArg AlgebraicGeometry.Spec.map (CommRingCat.ofHom_comp ψ₁ ι₁L)).trans
                  (AlgebraicGeometry.Spec.map_comp _ _)).trans
                  (((congrArg (· ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁))
                      hw1L_fst.symm).trans
                    (congrArg ((w_1L.left ≫ CategoryTheory.Limits.pullback.fst V_N₁.hom h₁L) ≫ ·)
                      hw01_fst.symm)).trans
                    (((CategoryTheory.Category.assoc _ _ _).symm.trans
                      (congrArg (· ≫ fst_1) (CategoryTheory.Category.assoc _ _ _))).trans
                      ((congrArg (fun u => (w_1L.left ≫ u) ≫ fst_1) hB01_fst.symm).trans
                        (congrArg (· ≫ fst_1) (CategoryTheory.Category.assoc _ _ _).symm)))))))
        · exact ((CategoryTheory.Category.assoc _ _ _).trans
              (CategoryTheory.Category.assoc _ _ _)).trans
            ((congrArg (w_0L.left ≫ ·) he_fst_snd).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ h₁L) hw0L_snd).trans
                  (h_ι_base.trans
                    (((congrArg (· ≫ V_N₁.hom) hw1L_fst.symm).trans
                      (congrArg ((w_1L.left ≫ CategoryTheory.Limits.pullback.fst V_N₁.hom h₁L) ≫ ·)
                        hw01_snd.symm)).trans
                      (((CategoryTheory.Category.assoc _ _ _).symm.trans
                        (congrArg (· ≫ snd_1) (CategoryTheory.Category.assoc _ _ _))).trans
                        ((congrArg (fun u => (w_1L.left ≫ u) ≫ snd_1) hB01_fst.symm).trans
                          (congrArg (· ≫ snd_1) (CategoryTheory.Category.assoc _ _ _).symm))))))))
      · exact calc (w_0L.left ≫ (e_comp.hom.app W_M₀).left) ≫ snd_1L
          _ = w_0L.left ≫ ((e_comp.hom.app W_M₀).left ≫ snd_1L) :=
              CategoryTheory.Category.assoc _ _ _
          _ = w_0L.left ≫ snd_L := congrArg (w_0L.left ≫ ·) he_snd
          _ = V_NL.hom := hw0L_snd
          _ = w_1L.left ≫ CategoryTheory.Limits.pullback.snd V_N₁.hom h₁L := hw1L_snd.symm
          _ = w_1L.left ≫ ((B₁L.map w_01).left ≫ snd_1L) :=
