    exact ⟨hAdd_pb, hAdd_pf, hLim_pb, hColim_pb⟩

  
  have hClopenHelper : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom X Y)
      [AlgebraicGeometry.IsProper π]
      (U_X : X.Etale) (U_Y : Y.Etale)
      (e : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget X).obj U_X).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y).obj U_Y).left)
      (_hcomm : CategoryTheory.CategoryStruct.comp
          ((AlgebraicGeometry.Scheme.Etale.forget X).obj U_X).hom π =
        CategoryTheory.CategoryStruct.comp e.hom
          ((AlgebraicGeometry.Scheme.Etale.forget Y).obj U_Y).hom)
      (σ : Quiver.Hom U_X ((weilEtaleSitePullback π).obj U_Y)),
      let Fgt_X := AlgebraicGeometry.Scheme.Etale.forget X
      let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget Y
      let B_π := weilEtaleSitePullback π
      let p_fst : Quiver.Hom ((Fgt_X.obj (B_π.obj U_Y)).left) ((Fgt_Y.obj U_Y).left) :=
        CategoryTheory.Limits.pullback.fst ((Fgt_Y.obj U_Y).hom) π
      let f_σ := (Fgt_X.map σ).left
      CategoryTheory.CategoryStruct.comp f_σ p_fst = e.hom →
      AlgebraicGeometry.IsOpenImmersion f_σ ∧
      IsClosed (Set.range f_σ.base) ∧
      CategoryTheory.Mono σ ∧
      ∃ (U_compl : X.Etale) (ι₂ : Quiver.Hom U_compl (B_π.obj U_Y)),
        AlgebraicGeometry.IsOpenImmersion ((Fgt_X.map ι₂).left) ∧
        Set.range ((Fgt_X.map ι₂).left).base = (Set.range f_σ.base)ᶜ ∧
        Disjoint (Set.range ((Fgt_X.map ι₂).left).base) (Set.range f_σ.base) ∧
        CategoryTheory.Sieve.ofArrows (fun b : Bool => cond b U_X U_compl)
          (fun b : Bool => match b with | true => σ | false => ι₂) ∈
          X.smallEtaleTopology (B_π.obj U_Y) ∧
        (∀ (V : X.Etale) (w : Quiver.Hom V (B_π.obj U_Y)),
          Disjoint (Set.range ((Fgt_X.map w).left).base) (Set.range f_σ.base) →
          ∃ u₂ : Quiver.Hom V U_compl, CategoryTheory.CategoryStruct.comp u₂ ι₂ = w) := by
    intro X Y π _ U_X U_Y e _hcomm σ Fgt_X Fgt_Y B_π p_fst f_σ hf_fst
    let P_sch := (Fgt_X.obj (B_π.obj U_Y)).left
    let p_snd : P_sch ⟶ X := (Fgt_X.obj (B_π.obj U_Y)).hom
    have hf_snd : f_σ ≫ p_snd = (Fgt_X.obj U_X).hom :=
      CategoryTheory.MorphismProperty.Over.w σ
    have hEt_fσ : AlgebraicGeometry.Etale f_σ :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        f_σ p_snd (B_π.obj U_Y).prop (by rw [hf_snd]; exact U_X.prop)
    let r_σ : P_sch ⟶ (Fgt_X.obj U_X).left := p_fst ≫ e.inv
    have h_retract : f_σ ≫ r_σ = 𝟙 _ := by
      dsimp [r_σ]
      rw [← CategoryTheory.Category.assoc, hf_fst, CategoryTheory.Iso.hom_inv_id]
    haveI : CategoryTheory.Mono f_σ := CategoryTheory.SplitMono.mono ⟨r_σ, h_retract⟩
    have hOpen_fσ : AlgebraicGeometry.IsOpenImmersion f_σ :=
      AlgebraicGeometry.IsOpenImmersion.of_flat_of_mono f_σ
    haveI : AlgebraicGeometry.IsSeparated p_fst :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsSeparated)
        (CategoryTheory.IsPullback.of_hasPullback ((Fgt_Y.obj U_Y).hom) π).flip
        (AlgebraicGeometry.IsProper.toIsSeparated (f := π))
    haveI : AlgebraicGeometry.IsSeparated r_σ := inferInstance
    haveI : AlgebraicGeometry.IsClosedImmersion (f_σ ≫ r_σ) := by
      rw [h_retract]
      infer_instance
    have hClosed_imm : AlgebraicGeometry.IsClosedImmersion f_σ :=
      AlgebraicGeometry.IsClosedImmersion.of_comp f_σ r_σ
    have hClosed_range : IsClosed (Set.range f_σ.base) :=
      (AlgebraicGeometry.IsClosedImmersion.iff_isPreimmersion.mp hClosed_imm).2
    have hMono_σ : CategoryTheory.Mono σ :=
      ⟨fun {Z_et} g₁ g₂ hg => by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        have hg_left : (Fgt_X.map g₁).left ≫ f_σ = (Fgt_X.map g₂).left ≫ f_σ :=
          congrArg (fun m => (Fgt_X.map m).left) hg
        exact (cancel_mono f_σ).mp hg_left⟩
    let O₂ : P_sch.Opens := ⟨(Set.range f_σ.base)ᶜ, hClosed_range.isOpen_compl⟩
    haveI : AlgebraicGeometry.Etale p_snd := (B_π.obj U_Y).prop
    haveI : AlgebraicGeometry.Etale (O₂.ι ≫ p_snd) := inferInstance
    let U_compl : X.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (O₂.ι ≫ p_snd) inferInstance
    let ι₂ : Quiver.Hom U_compl (B_π.obj U_Y) :=
      CategoryTheory.MorphismProperty.Over.homMk O₂.ι rfl trivial
    have hOpen_ι₂_mor : AlgebraicGeometry.IsOpenImmersion ((Fgt_X.map ι₂).left) := by
      change AlgebraicGeometry.IsOpenImmersion O₂.ι
      infer_instance
    have hRange_ι₂ : Set.range ((Fgt_X.map ι₂).left).base = (Set.range f_σ.base)ᶜ := by
      change Set.range O₂.ι.base = (Set.range f_σ.base)ᶜ
      exact AlgebraicGeometry.Scheme.Opens.range_ι O₂
    have hDisj_ι₂ : Disjoint (Set.range ((Fgt_X.map ι₂).left).base) (Set.range f_σ.base) := by
      rw [hRange_ι₂, Set.disjoint_left]
      exact fun _ hx hx' => hx hx'
    let X_cov : Bool → X.Etale := fun b => cond b U_X U_compl
    let f_cov : ∀ b : Bool, X_cov b ⟶ B_π.obj U_Y :=
      fun b => match b with | true => σ | false => ι₂
    have hCov_mem : CategoryTheory.Sieve.ofArrows X_cov f_cov ∈
        X.smallEtaleTopology (B_π.obj U_Y) := by
      rw [hMemTop X (B_π.obj U_Y)]
      intro p
      by_cases hp : p ∈ Set.range f_σ.base
      · obtain ⟨x_u, hxu⟩ := hp
        exact ⟨X_cov true, f_cov true, x_u,
          CategoryTheory.Sieve.ofArrows_mk X_cov f_cov true, hEt_fσ, hxu⟩
      · have hp_O₂ : p ∈ O₂ := hp
        exact ⟨X_cov false, f_cov false, ⟨p, hp_O₂⟩,
          CategoryTheory.Sieve.ofArrows_mk X_cov f_cov false, inferInstance, rfl⟩
    refine ⟨hOpen_fσ, hClosed_range, hMono_σ, U_compl, ι₂, hOpen_ι₂_mor,
      hRange_ι₂, hDisj_ι₂, hCov_mem, ?_⟩
    intro V w hw_disj
    have hsub : Set.range ((Fgt_X.map w).left).base ⊆ Set.range O₂.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι O₂]
      exact fun _ hx h_in => Set.disjoint_left.mp hw_disj hx h_in
    let u₂_left : V.left ⟶ O₂.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift O₂.ι ((Fgt_X.map w).left) hsub
    have hu₂_fac : u₂_left ≫ O₂.ι = (Fgt_X.map w).left :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac O₂.ι ((Fgt_X.map w).left) hsub
    have hu₂_hom : u₂_left ≫ U_compl.hom = V.hom := by
      change u₂_left ≫ (O₂.ι ≫ p_snd) = (Fgt_X.obj V).hom
      rw [← CategoryTheory.Category.assoc, hu₂_fac]
      exact (Fgt_X.map w).w
    let u₂ : Quiver.Hom V U_compl :=
      CategoryTheory.MorphismProperty.Over.homMk u₂_left hu₂_hom trivial
    exact ⟨u₂, CategoryTheory.MorphismProperty.Over.Hom.ext hu₂_fac⟩

  
