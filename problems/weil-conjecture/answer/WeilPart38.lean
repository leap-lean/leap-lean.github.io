              rw [IsLocallyConstant.iff_isOpen_fiber]
              intro a
              rw [isOpen_iff_forall_mem_open]
              intro z hz
              let ch := hcov z
              let Y_z := ch.choose
              let u_z := ch.choose_spec.choose
              let y_z := ch.choose_spec.choose_spec.choose
              let hu_z := ch.choose_spec.choose_spec.choose_spec.1
              let hEt_z := ch.choose_spec.choose_spec.choose_spec.2.1
              let hy_z := ch.choose_spec.choose_spec.choose_spec.2.2
              let w_z : S₀.arrows.category := ⟨CategoryTheory.Over.mk u_z, hu_z⟩
              let f_z : LocallyConstant ↥Y_z.left ↥A := eval_c c w_z m
              have _ : AlgebraicGeometry.Etale u_z.left := hEt_z
