  let t_mor : (S ≃ₐ[R] S) → (V ⟶ V) :=
    fun σ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom)
  have ht_s : ∀ σ : S ≃ₐ[R] S, t_mor σ ≫ s_mor σ = 𝟙 V := by
    intro σ
    dsimp only [t_mor, s_mor]
    rw [← AlgebraicGeometry.Spec.map_comp]
    have h1 : CommRingCat.ofHom σ.symm.toRingHom ≫ CommRingCat.ofHom σ.toRingHom =
        𝟙 (CommRingCat.of S) :=
      CommRingCat.hom_ext (RingHom.ext σ.apply_symm_apply)
    rw [h1, AlgebraicGeometry.Spec.map_id]
  have hs_t : ∀ σ : S ≃ₐ[R] S, s_mor σ ≫ t_mor σ = 𝟙 V := by
    intro σ
    dsimp only [t_mor, s_mor]
    rw [← AlgebraicGeometry.Spec.map_comp]
    have h1 : CommRingCat.ofHom σ.toRingHom ≫ CommRingCat.ofHom σ.symm.toRingHom =
        𝟙 (CommRingCat.of S) :=
      CommRingCat.hom_ext (RingHom.ext σ.symm_apply_apply)
    rw [h1, AlgebraicGeometry.Spec.map_id]
  have ht_one : t_mor 1 = 𝟙 V := by
    dsimp only [t_mor]
    have h1 : CommRingCat.ofHom (1 : S ≃ₐ[R] S).toRingHom = 𝟙 (CommRingCat.of S) :=
      CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
    rw [h1, AlgebraicGeometry.Spec.map_id]
  have ht_et : ∀ σ : S ≃ₐ[R] S, AlgebraicGeometry.Etale (t_mor σ) := by
    intro σ
    have : CategoryTheory.IsIso (t_mor σ) := ⟨⟨s_mor σ, ht_s σ, hs_t σ⟩⟩
    exact inferInstance
  have ht_π : ∀ σ : S ≃ₐ[R] S, t_mor σ ≫ (𝟙 V ≫ π) = 𝟙 V ≫ π := by
    intro σ
    rw [CategoryTheory.Category.id_comp]
    dsimp only [t_mor, π]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    have hcomm : CommRingCat.ofHom (algebraMap R S) ≫ CommRingCat.ofHom σ.toRingHom =
        CommRingCat.ofHom (algebraMap R S) :=
      CommRingCat.hom_ext (RingHom.ext σ.commutes)
    rw [hcomm]

  let u_deck : (S ≃ₐ[R] S) → (V_tilde ⟶ V_tilde) :=
    fun σ =>
      (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful U).preimage
        (CategoryTheory.Over.homMk (t_mor σ) (ht_π σ))
  have hu_deck_left : ∀ σ : S ≃ₐ[R] S, (FgtU.map (u_deck σ)).left = t_mor σ :=
    fun σ => congrArg CategoryTheory.Over.Hom.left
      ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful U).map_preimage _)

  let ε_mor : (S ≃ₐ[R] S) → (V ⟶ CategoryTheory.Limits.pullback (𝟙 V ≫ π) π) :=
    fun σ => t_mor σ ≫ δ_V σ
  have hε_snd : ∀ σ : S ≃ₐ[R] S,
      ε_mor σ ≫ CategoryTheory.Limits.pullback.snd (𝟙 V ≫ π) π = 𝟙 V := by
    intro σ
    dsimp only [ε_mor]
    rw [CategoryTheory.Category.assoc, (hδV_props σ).2.1, CategoryTheory.Category.id_comp, ht_s σ]
  have hε_fst : ∀ σ : S ≃ₐ[R] S,
      ε_mor σ ≫ CategoryTheory.Limits.pullback.fst (𝟙 V ≫ π) π = t_mor σ := by
    intro σ
    dsimp only [ε_mor]
    rw [CategoryTheory.Category.assoc, (hδV_props σ).1, CategoryTheory.Category.comp_id]
  have hε_one : ε_mor 1 = δ_V 1 :=
    (congrArg (· ≫ δ_V 1) ht_one).trans (CategoryTheory.Category.id_comp (δ_V 1))
  let ε_et : (S ≃ₐ[R] S) → (T_V ⟶ B_π.obj V_tilde) :=
    fun σ =>
      (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful V).preimage
        (CategoryTheory.Over.homMk (ε_mor σ) (hε_snd σ))
  have hε_et_left : ∀ σ : S ≃ₐ[R] S, (FgtV.map (ε_et σ)).left = ε_mor σ :=
    fun σ => congrArg CategoryTheory.Over.Hom.left
      ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful V).map_preimage _)

  let η_Vtilde : ℰ.obj.obj (Opposite.op V_tilde) ⟶
      (L_π.obj ℰ).obj.obj (Opposite.op (B_π.obj V_tilde)) :=
    (adj_π.unit.app ℰ).hom.app (Opposite.op V_tilde)
  let γ₀ : A ⟶ (L_π.obj ℰ).obj.obj (Opposite.op T_V) :=
    secHom ≫ η_Vtilde ≫ (L_π.obj ℰ).obj.map (Opposite.op (ε_et 1))
  let β : C_V ⟶ L_π.obj ℰ := (adj_const.homEquiv A (L_π.obj ℰ)).symm γ₀
  have hβ_unit : adj_const.unit.app A ≫ β.hom.app (Opposite.op T_V) = γ₀ :=
    (adj_const.homEquiv_unit A (L_π.obj ℰ) β).symm.trans
      ((adj_const.homEquiv A (L_π.obj ℰ)).apply_symm_apply γ₀)

  have hUnit_eval : secHom ≫ α_tilde.hom.app (Opposite.op V_tilde) ≫
      C_V.obj.map (Opposite.op (ε_et 1)) = adj_const.unit.app A := by
    apply AddCommGrpCat.ext
    intro a
    have h1 := hθ_nat (ε_et 1) (lcUp _ (sec_fun a).1)
    have hcomap : (lcUp _ (sec_fun a).1).comap
        ((AlgebraicGeometry.Scheme.Etale.forget V).map (ε_et 1)).left.base.hom =
        LocallyConstant.const _ a := by
      apply LocallyConstant.ext
      intro y
      have hy_pt : ((AlgebraicGeometry.Scheme.Etale.forget V).map (ε_et 1)).left.base y =
          (δ_V 1).base y :=
        congrArg (fun m : V ⟶ CategoryTheory.Limits.pullback (𝟙 V ≫ π) π => m.base y)
          ((hε_et_left 1).trans hε_one)
      change ULift.up ((sec_fun a).1
        (((AlgebraicGeometry.Scheme.Etale.forget V).map (ε_et 1)).left.base y)) = a
      rw [hy_pt, hsec_sheet a 1 y, map_one ρ, Units.val_one, Matrix.one_mulVec]
      rfl
    exact h1.trans ((congrArg (θ_V T_V) hcomap).trans (hθ_unit a))

  have hβα : β ≫ α = 𝟙 C_V := by
    apply (adj_const.homEquiv A C_V).injective
    apply AddCommGrpCat.ext
    intro a
    have h1 := congrArg (fun m => m.hom a) (adj_const.homEquiv_unit A C_V (β ≫ α))
    have h2 := congrArg (fun m => m.hom a) (adj_const.homEquiv_unit A C_V (𝟙 C_V))
    have hβ_a : (β.hom.app (Opposite.op T_V)).hom ((adj_const.unit.app A).hom a) = γ₀.hom a :=
      congrArg (fun m => m.hom a) hβ_unit
    have hnat_a : (α.hom.app (Opposite.op T_V)).hom
        (((L_π.obj ℰ).obj.map (Opposite.op (ε_et 1))).hom (η_Vtilde.hom (secHom.hom a))) =
        (C_V.obj.map (Opposite.op (ε_et 1))).hom
          ((α.hom.app (Opposite.op (B_π.obj V_tilde))).hom (η_Vtilde.hom (secHom.hom a))) :=
      congrArg (fun m => m.hom (η_Vtilde.hom (secHom.hom a)))
        (α.hom.naturality (Opposite.op (ε_et 1)))
    have hα_a : (α.hom.app (Opposite.op (B_π.obj V_tilde))).hom (η_Vtilde.hom (secHom.hom a)) =
        (α_tilde.hom.app (Opposite.op V_tilde)).hom (secHom.hom a) :=
      congrArg (fun k : ℰ ⟶ P_π.obj C_V => (k.hom.app (Opposite.op V_tilde)).hom (secHom.hom a))
        hα_unit
    have hunit_a : (C_V.obj.map (Opposite.op (ε_et 1))).hom
        ((α_tilde.hom.app (Opposite.op V_tilde)).hom (secHom.hom a)) =
        (adj_const.unit.app A).hom a :=
      congrArg (fun m => m.hom a) hUnit_eval
    exact h1.trans
      ((congrArg (α.hom.app (Opposite.op T_V)).hom hβ_a).trans
        (hnat_a.trans
          ((congrArg (C_V.obj.map (Opposite.op (ε_et 1))).hom hα_a).trans
            (hunit_a.trans h2.symm))))

  have hδ_ucan : ∀ σ : S ≃ₐ[R] S, δ_V 1 ≫ u_can (u_deck σ) = ε_mor σ := by
    intro σ
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc (δ_V 1) (u_can (u_deck σ)) _).trans
        ((congrArg (δ_V 1 ≫ ·) (hu_can_fst (u_deck σ))).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ _) (hδV_props 1).1).trans
              ((CategoryTheory.Category.id_comp _).trans
                ((hu_deck_left σ).trans (hε_fst σ).symm)))))
    · exact (CategoryTheory.Category.assoc (δ_V 1) (u_can (u_deck σ)) _).trans
        ((congrArg (δ_V 1 ≫ ·) (hu_can_snd (u_deck σ))).trans
          ((congrArg (· ≫ _) hε_one.symm).trans
            ((hε_snd 1).trans (hε_snd σ).symm)))

  have hε_deck : ∀ σ : S ≃ₐ[R] S, ε_et 1 ≫ B_π.map (u_deck σ) = ε_et σ := by
    intro σ
    apply (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful V).map_injective
    apply CategoryTheory.Over.OverMorphism.ext
    exact (congrArg CategoryTheory.Over.Hom.left
      (FgtV.map_comp (ε_et 1) (B_π.map (u_deck σ)))).trans
      ((congrArg₂ CategoryTheory.CategoryStruct.comp
        ((hε_et_left 1).trans hε_one) (hB_map_left (u_deck σ))).trans
        ((hδ_ucan σ).trans (hε_et_left σ).symm))

  have hDeck_cov : CategoryTheory.Sieve.ofArrows (fun _ : S ≃ₐ[R] S => T_V)
      (fun σ => ε_et 1 ≫ B_π.map (u_deck σ)) ∈ V.smallEtaleTopology (B_π.obj V_tilde) := by
    rw [hMem_V (B_π.obj V_tilde)]
    intro z
    have hz_univ : z ∈ (⋃ σ : S ≃ₐ[R] S, Set.range (δ_V σ).base) := by
      rw [hδV_cov]; exact Set.mem_univ z
    obtain ⟨σ, x, rfl⟩ := Set.mem_iUnion.mp hz_univ
    refine ⟨T_V, ε_et 1 ≫ B_π.map (u_deck σ), (s_mor σ).base x,
      CategoryTheory.Sieve.ofArrows_mk _ _ σ, ?_, ?_⟩
    · change AlgebraicGeometry.Etale (FgtV.map (ε_et 1 ≫ B_π.map (u_deck σ))).left
      rw [hε_deck σ, hε_et_left σ]
      exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        (t_mor σ) (δ_V σ) (ht_et σ) (hδV_props σ).2.2.1
    · have hmor : (FgtV.map (ε_et 1 ≫ B_π.map (u_deck σ))).left = t_mor σ ≫ δ_V σ := by
        rw [hε_deck σ, hε_et_left σ]
      have hpt : ((AlgebraicGeometry.Scheme.Etale.forget V).map
          (ε_et 1 ≫ B_π.map (u_deck σ))).left.base ((s_mor σ).base x) =
          (t_mor σ ≫ δ_V σ).base ((s_mor σ).base x) :=
        congrArg (fun m : V ⟶ CategoryTheory.Limits.pullback (𝟙 V ≫ π) π =>
          m.base ((s_mor σ).base x)) hmor
      have hst_pt : (t_mor σ ≫ δ_V σ).base ((s_mor σ).base x) = (δ_V σ).base x :=
        (AlgebraicGeometry.Scheme.Hom.comp_apply (t_mor σ) (δ_V σ) ((s_mor σ).base x)).trans
          ((congrArg (δ_V σ).base
            (AlgebraicGeometry.Scheme.Hom.comp_apply (s_mor σ) (t_mor σ) x).symm).trans
            (congrArg (fun m : V ⟶ V => (δ_V σ).base (m.base x)) (hs_t σ)))
      exact hpt.trans hst_pt

  let φ_deck : (S ≃ₐ[R] S) → (A ⟶ A) :=
    fun σ => AddCommGrpCat.ofHom
      { toFun := fun a => ULift.up (((ρ σ).val).mulVec a.down)
        map_zero' := congrArg ULift.up (Matrix.mulVec_zero _)
        map_add' := fun a₁ a₂ => congrArg ULift.up (Matrix.mulVec_add _ a₁.down a₂.down) }
  have hDeck_inter : ∀ σ : S ≃ₐ[R] S,
      secHom ≫ ℰ.obj.map (Opposite.op (u_deck σ)) = φ_deck σ ≫ secHom := by
    intro σ
    apply AddCommGrpCat.ext
    intro a
    apply Subtype.ext
    apply hUniq_V _ _ ((ℰ.obj.map (Opposite.op (u_deck σ))).hom (sec_fun a)).2
      (sec_fun ((φ_deck σ).hom a)).2
    apply LocallyConstant.ext
    intro y
    change (sec_fun a).1 ((u_can (u_deck σ)).base ((δ_V 1).base y)) =
      (sec_fun ((φ_deck σ).hom a)).1 ((δ_V 1).base y)
    have hpt : (u_can (u_deck σ)).base ((δ_V 1).base y) = (δ_V σ).base ((t_mor σ).base y) := by
      have h1 := hε_deck σ
      have h2 := congrArg (fun k => (FgtV.map k).left) h1
      rw [FgtV.map_comp] at h2
      change (FgtV.map (ε_et 1)).left ≫ (FgtV.map (B_π.map (u_deck σ))).left =
        (FgtV.map (ε_et σ)).left at h2
      rw [hε_et_left 1, hε_one, hB_map_left (u_deck σ), hε_et_left σ] at h2
      have h3 := congrArg (fun k : V ⟶ CategoryTheory.Limits.pullback (𝟙 V ≫ π) π => k.base y) h2
      have hL_pt : (δ_V 1 ≫ u_can (u_deck σ)).base y =
          (u_can (u_deck σ)).base ((δ_V 1).base y) :=
        AlgebraicGeometry.Scheme.Hom.comp_apply (δ_V 1) (u_can (u_deck σ)) y
      have hR_pt : (ε_mor σ).base y = (δ_V σ).base ((t_mor σ).base y) :=
        AlgebraicGeometry.Scheme.Hom.comp_apply (t_mor σ) (δ_V σ) y
      exact hL_pt.symm.trans (h3.trans hR_pt)
    rw [hpt, hsec_sheet a σ ((t_mor σ).base y), hsec_sheet ((φ_deck σ).hom a) 1 y,
      map_one ρ, Units.val_one, Matrix.one_mulVec]
    rfl

  let Φ_LHS : ℰ ⟶ P_π.obj (L_π.obj ℰ) := α_tilde ≫ P_π.map β
  let Φ_RHS : ℰ ⟶ P_π.obj (L_π.obj ℰ) := adj_π.unit.app ℰ

  have hUniv_Vtilde : secHom ≫ Φ_LHS.hom.app (Opposite.op V_tilde) =
      secHom ≫ Φ_RHS.hom.app (Opposite.op V_tilde) := by
    change (secHom ≫ Φ_LHS.hom.app (Opposite.op V_tilde) :
        A ⟶ (L_π.obj ℰ).obj.obj (Opposite.op (B_π.obj V_tilde))) =
      secHom ≫ Φ_RHS.hom.app (Opposite.op V_tilde)
    apply (L_π.obj ℰ).property.hom_ext_ofArrows
      (fun σ : S ≃ₐ[R] S => ε_et 1 ≫ B_π.map (u_deck σ)) hDeck_cov
    intro σ
    apply AddCommGrpCat.ext
    intro a
    have hL1 : ((L_π.obj ℰ).obj.map (Opposite.op (ε_et 1 ≫ B_π.map (u_deck σ)))).hom
        ((β.hom.app (Opposite.op (B_π.obj V_tilde))).hom
          ((α_tilde.hom.app (Opposite.op V_tilde)).hom (secHom.hom a))) =
        (β.hom.app (Opposite.op T_V)).hom
          ((C_V.obj.map (Opposite.op (ε_et 1 ≫ B_π.map (u_deck σ)))).hom
            ((α_tilde.hom.app (Opposite.op V_tilde)).hom (secHom.hom a))) :=
      congrArg (fun m => m.hom ((α_tilde.hom.app (Opposite.op V_tilde)).hom (secHom.hom a)))
        (β.hom.naturality (Opposite.op (ε_et 1 ≫ B_π.map (u_deck σ)))).symm
    have hL2 : (C_V.obj.map (Opposite.op (ε_et 1 ≫ B_π.map (u_deck σ)))).hom
        ((α_tilde.hom.app (Opposite.op V_tilde)).hom (secHom.hom a)) =
        (C_V.obj.map (Opposite.op (ε_et 1))).hom
          ((C_V.obj.map (Opposite.op (B_π.map (u_deck σ)))).hom
            ((α_tilde.hom.app (Opposite.op V_tilde)).hom (secHom.hom a))) :=
      congrArg (fun m => m.hom ((α_tilde.hom.app (Opposite.op V_tilde)).hom (secHom.hom a)))
        (C_V.obj.map_comp (Opposite.op (B_π.map (u_deck σ))) (Opposite.op (ε_et 1)))
    have hL3 : (C_V.obj.map (Opposite.op (B_π.map (u_deck σ)))).hom
        ((α_tilde.hom.app (Opposite.op V_tilde)).hom (secHom.hom a)) =
        (α_tilde.hom.app (Opposite.op V_tilde)).hom
          ((ℰ.obj.map (Opposite.op (u_deck σ))).hom (secHom.hom a)) :=
      congrArg (fun m => m.hom (secHom.hom a))
        (α_tilde.hom.naturality (Opposite.op (u_deck σ))).symm
    have hL4 : (ℰ.obj.map (Opposite.op (u_deck σ))).hom (secHom.hom a) =
        secHom.hom ((φ_deck σ).hom a) :=
      congrArg (fun m => m.hom a) (hDeck_inter σ)
    have hL5 : (C_V.obj.map (Opposite.op (ε_et 1))).hom
        ((α_tilde.hom.app (Opposite.op V_tilde)).hom (secHom.hom ((φ_deck σ).hom a))) =
        (adj_const.unit.app A).hom ((φ_deck σ).hom a) :=
      congrArg (fun m => m.hom ((φ_deck σ).hom a)) hUnit_eval
    have hL6 : (β.hom.app (Opposite.op T_V)).hom
        ((adj_const.unit.app A).hom ((φ_deck σ).hom a)) =
        γ₀.hom ((φ_deck σ).hom a) :=
      congrArg (fun m => m.hom ((φ_deck σ).hom a)) hβ_unit
    have hL_pt : ((L_π.obj ℰ).obj.map (Opposite.op (ε_et 1 ≫ B_π.map (u_deck σ)))).hom
        ((Φ_LHS.hom.app (Opposite.op V_tilde)).hom (secHom.hom a)) =
        γ₀.hom ((φ_deck σ).hom a) :=
      hL1.trans
        ((congrArg (β.hom.app (Opposite.op T_V)).hom
          (hL2.trans
            ((congrArg (C_V.obj.map (Opposite.op (ε_et 1))).hom
              (hL3.trans (congrArg (α_tilde.hom.app (Opposite.op V_tilde)).hom hL4))).trans
              hL5))).trans hL6)
    have hR1 : ((L_π.obj ℰ).obj.map (Opposite.op (ε_et 1 ≫ B_π.map (u_deck σ)))).hom
        (η_Vtilde.hom (secHom.hom a)) =
        ((L_π.obj ℰ).obj.map (Opposite.op (ε_et 1))).hom
          (((L_π.obj ℰ).obj.map (Opposite.op (B_π.map (u_deck σ)))).hom
            (η_Vtilde.hom (secHom.hom a))) :=
      congrArg (fun m => m.hom (η_Vtilde.hom (secHom.hom a)))
        ((L_π.obj ℰ).obj.map_comp (Opposite.op (B_π.map (u_deck σ))) (Opposite.op (ε_et 1)))
    have hR2 : ((L_π.obj ℰ).obj.map (Opposite.op (B_π.map (u_deck σ)))).hom
        (η_Vtilde.hom (secHom.hom a)) =
        η_Vtilde.hom ((ℰ.obj.map (Opposite.op (u_deck σ))).hom (secHom.hom a)) :=
      congrArg (fun m => m.hom (secHom.hom a))
        (Φ_RHS.hom.naturality (Opposite.op (u_deck σ))).symm
    have hR_pt : ((L_π.obj ℰ).obj.map (Opposite.op (ε_et 1 ≫ B_π.map (u_deck σ)))).hom
        ((Φ_RHS.hom.app (Opposite.op V_tilde)).hom (secHom.hom a)) =
        γ₀.hom ((φ_deck σ).hom a) :=
      hR1.trans
        (congrArg ((L_π.obj ℰ).obj.map (Opposite.op (ε_et 1))).hom
          (hR2.trans (congrArg η_Vtilde.hom hL4)))
    exact hL_pt.trans hR_pt.symm

  let zHom : ∀ {M : AddCommGrpCat.{u}} (_ : ↥M), AddCommGrpCat.of (ULift.{u} ℤ) ⟶ M :=
    fun {M} m => AddCommGrpCat.ofHom
      { toFun := fun z => z.down • m
        map_zero' := zero_zsmul m
        map_add' := fun z₁ z₂ => add_zsmul m z₁.down z₂.down }

  have hΦ_eq : Φ_LHS = Φ_RHS := by
    apply CategoryTheory.Sheaf.hom_ext
    ext W_op : 2
    let W := W_op.unop
    have hW_op : W_op = Opposite.op W := rfl
    rw [hW_op]
    apply AddCommGrpCat.ext
    intro s
    let h_W := (FgtU.obj W).hom
    let W_V := CategoryTheory.Limits.pullback h_W π
    let fst_W := CategoryTheory.Limits.pullback.fst h_W π
    let snd_W := CategoryTheory.Limits.pullback.snd h_W π
    have hpb_W := CategoryTheory.IsPullback.of_hasPullback h_W π
    have hfst_et : AlgebraicGeometry.Etale fst_W :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_W.flip hπ_et
    have hfst_surj : AlgebraicGeometry.Surjective fst_W :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_W.flip hπ_surj
    have hsnd_et : AlgebraicGeometry.Etale snd_W :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_W W.prop
    have hsnd_π_et : AlgebraicGeometry.Etale (snd_W ≫ π) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) snd_W π hsnd_et hπ_et
    let W_V_tilde : U.Etale := AlgebraicGeometry.Scheme.Etale.mk (snd_W ≫ π)
    let p_W : W_V_tilde ⟶ W :=
      (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful U).preimage
        (CategoryTheory.Over.homMk fst_W CategoryTheory.Limits.pullback.condition)
    have hp_W_left : (FgtU.map p_W).left = fst_W :=
      congrArg CategoryTheory.Over.Hom.left
        ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful U).map_preimage _)
    let s₁ : ↥(E_sub W_V_tilde) := (ℰ.obj.map (Opposite.op p_W)).hom s
    obtain ⟨δ_W, hδW_props, _, _, _⟩ := hSheetPkg W_V snd_W
    let g_s : LocallyConstant ↥W_V (Fin N → Λ) := s₁.1.comap (δ_W 1).base.hom
    let U_a : ↥A → W_V.Opens :=
      fun a => ⟨g_s ⁻¹' {a.down}, g_s.isLocallyConstant {a.down}⟩
    let g_a : ∀ a : ↥A, (U_a a).toScheme ⟶ V := fun a => (U_a a).ι ≫ snd_W
    have hg_a_π_et : ∀ a : ↥A, AlgebraicGeometry.Etale (g_a a ≫ π) :=
      fun a => CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        (g_a a) π (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          (U_a a).ι snd_W inferInstance hsnd_et) hπ_et
    let Y_W : ↥A → U.Etale := fun a =>
      have : AlgebraicGeometry.Etale (g_a a ≫ π) := hg_a_π_et a
      AlgebraicGeometry.Scheme.Etale.mk (g_a a ≫ π)
    let j_a : ∀ a : ↥A, Y_W a ⟶ W_V_tilde :=
      fun a =>
        (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful U).preimage
          (CategoryTheory.Over.homMk (U_a a).ι
            (CategoryTheory.Category.assoc (U_a a).ι snd_W π))
    have hj_a_left : ∀ a : ↥A, (FgtU.map (j_a a)).left = (U_a a).ι :=
      fun a => congrArg CategoryTheory.Over.Hom.left
        ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful U).map_preimage _)
    let k_W : ∀ a : ↥A, Y_W a ⟶ W := fun a => j_a a ≫ p_W
    let q_W : ∀ a : ↥A, Y_W a ⟶ V_tilde :=
      fun a =>
        (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful U).preimage
          (CategoryTheory.Over.homMk (g_a a)
            (by change g_a a ≫ (𝟙 V ≫ π) = g_a a ≫ π; rw [CategoryTheory.Category.id_comp]))
    have hq_W_left : ∀ a : ↥A, (FgtU.map (q_W a)).left = g_a a :=
      fun a => congrArg CategoryTheory.Over.Hom.left
        ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful U).map_preimage _)

    have hCov_W : CategoryTheory.Sieve.ofArrows Y_W k_W ∈ U.smallEtaleTopology W := by
      rw [hMem_U W]
      intro x
      obtain ⟨z, rfl⟩ := fst_W.surjective x
      let a : ↥A := ULift.up (g_s z)
      let y_pt : ↥(U_a a).toScheme := ⟨z, rfl⟩
      refine ⟨Y_W a, k_W a, y_pt, CategoryTheory.Sieve.ofArrows_mk Y_W k_W a,
        hu_et (k_W a), ?_⟩
      have hk_left : (FgtU.map (k_W a)).left = (U_a a).ι ≫ fst_W :=
        (congrArg CategoryTheory.Over.Hom.left (FgtU.map_comp (j_a a) p_W)).trans
          (congrArg₂ CategoryTheory.CategoryStruct.comp (hj_a_left a) hp_W_left)
      have hpt := congrArg (fun m : (U_a a).toScheme ⟶ (FgtU.obj W).left => m.base y_pt) hk_left
      exact hpt.trans (AlgebraicGeometry.Scheme.Hom.comp_apply (U_a a).ι fst_W y_pt)

    have hSec_eq : ∀ a : ↥A,
        (ℰ.obj.map (Opposite.op (k_W a))).hom s =
          (ℰ.obj.map (Opposite.op (q_W a))).hom (secHom.hom a) := by
      intro a
      have hk_map : ℰ.obj.map (Opposite.op (k_W a)) =
          ℰ.obj.map (Opposite.op p_W) ≫ ℰ.obj.map (Opposite.op (j_a a)) :=
        ℰ.obj.map_comp (Opposite.op p_W) (Opposite.op (j_a a))
      refine (congrArg (fun m => m.hom s) hk_map).trans ?_
      change (ℰ.obj.map (Opposite.op (j_a a))).hom s₁ =
        (ℰ.obj.map (Opposite.op (q_W a))).hom (sec_fun a)
      obtain ⟨δ_Ua, hδUa_props, _, hUniq_Ua, _⟩ := hSheetPkg (U_a a).toScheme (g_a a)
      apply Subtype.ext
      apply hUniq_Ua _ _ ((ℰ.obj.map (Opposite.op (j_a a))).hom s₁).2
        ((ℰ.obj.map (Opposite.op (q_W a))).hom (sec_fun a)).2
      apply LocallyConstant.ext
      intro y
      have hs_one : s_mor 1 = 𝟙 V := by
        dsimp only [s_mor]
        have h1 : CommRingCat.ofHom (1 : S ≃ₐ[R] S).symm.toRingHom = 𝟙 (CommRingCat.of S) :=
          CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
        rw [h1, AlgebraicGeometry.Spec.map_id]
      have hj_comm : δ_Ua 1 ≫ u_can (j_a a) = (U_a a).ι ≫ δ_W 1 := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc (δ_Ua 1) (u_can (j_a a)) _).trans
            ((congrArg (δ_Ua 1 ≫ ·) (hu_can_fst (j_a a))).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ _) (hδUa_props 1).1).trans
                  ((CategoryTheory.Category.id_comp _).trans
                    ((hj_a_left a).trans
                      ((CategoryTheory.Category.comp_id (U_a a).ι).symm.trans
                        ((congrArg ((U_a a).ι ≫ ·) (hδW_props 1).1.symm).trans
                          (CategoryTheory.Category.assoc _ _ _).symm)))))))
        · exact (CategoryTheory.Category.assoc (δ_Ua 1) (u_can (j_a a)) _).trans
            ((congrArg (δ_Ua 1 ≫ ·) (hu_can_snd (j_a a))).trans
              ((hδUa_props 1).2.1.trans
                ((congrArg (g_a a ≫ ·) hs_one).trans
                  ((CategoryTheory.Category.comp_id (g_a a)).trans
                    ((CategoryTheory.Category.comp_id ((U_a a).ι ≫ snd_W)).symm.trans
                      ((congrArg (((U_a a).ι ≫ snd_W) ≫ ·) hs_one.symm).trans
                        ((CategoryTheory.Category.assoc (U_a a).ι snd_W (s_mor 1)).trans
                          ((congrArg ((U_a a).ι ≫ ·) (hδW_props 1).2.1.symm).trans
                            (CategoryTheory.Category.assoc _ _ _).symm))))))))
      have hq_comm : δ_Ua 1 ≫ u_can (q_W a) = g_a a ≫ δ_V 1 := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc (δ_Ua 1) (u_can (q_W a)) _).trans
            ((congrArg (δ_Ua 1 ≫ ·) (hu_can_fst (q_W a))).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ _) (hδUa_props 1).1).trans
                  ((CategoryTheory.Category.id_comp _).trans
                    ((hq_W_left a).trans
                      ((CategoryTheory.Category.comp_id (g_a a)).symm.trans
                        ((congrArg (g_a a ≫ ·) (hδV_props 1).1.symm).trans
                          (CategoryTheory.Category.assoc _ _ _).symm)))))))
        · exact (CategoryTheory.Category.assoc (δ_Ua 1) (u_can (q_W a)) _).trans
            ((congrArg (δ_Ua 1 ≫ ·) (hu_can_snd (q_W a))).trans
              ((hδUa_props 1).2.1.trans
                ((congrArg (g_a a ≫ ·) hs_one).trans
                  ((CategoryTheory.Category.comp_id (g_a a)).trans
                    ((congrArg (g_a a ≫ ·) (hε_snd 1).symm).trans
                      ((congrArg (fun m => g_a a ≫ m ≫ _) hε_one).trans
                        (CategoryTheory.Category.assoc _ _ _).symm))))))
      have hL_pt : s₁.1 ((u_can (j_a a)).base ((δ_Ua 1).base y)) = a.down := by
        have h1 : (u_can (j_a a)).base ((δ_Ua 1).base y) =
            (δ_W 1).base ((U_a a).ι.base y) :=
          (AlgebraicGeometry.Scheme.Hom.comp_apply (δ_Ua 1) (u_can (j_a a)) y).symm.trans
            ((congrArg (fun m => m.base y) hj_comm).trans
              (AlgebraicGeometry.Scheme.Hom.comp_apply (U_a a).ι (δ_W 1) y))
        rw [h1]
        exact y.2
      have hR_pt : (sec_fun a).1 ((u_can (q_W a)).base ((δ_Ua 1).base y)) = a.down := by
        have h1 : (u_can (q_W a)).base ((δ_Ua 1).base y) =
            (δ_V 1).base ((g_a a).base y) :=
          (AlgebraicGeometry.Scheme.Hom.comp_apply (δ_Ua 1) (u_can (q_W a)) y).symm.trans
            ((congrArg (fun m => m.base y) hq_comm).trans
              (AlgebraicGeometry.Scheme.Hom.comp_apply (g_a a) (δ_V 1) y))
        rw [h1, hsec_sheet a 1 ((g_a a).base y), map_one ρ, Units.val_one, Matrix.one_mulVec]
      exact hL_pt.trans hR_pt.symm

    let 𝒢 := P_π.obj (L_π.obj ℰ)
    have hz_eq : zHom ((Φ_LHS.hom.app (Opposite.op W)).hom s) =
        zHom ((Φ_RHS.hom.app (Opposite.op W)).hom s) := by
      apply 𝒢.property.hom_ext_ofArrows k_W hCov_W
      intro a
      apply AddCommGrpCat.ext
      intro z
      change (𝒢.obj.map (Opposite.op (k_W a))).hom
          (z.down • (Φ_LHS.hom.app (Opposite.op W)).hom s) =
        (𝒢.obj.map (Opposite.op (k_W a))).hom
          (z.down • (Φ_RHS.hom.app (Opposite.op W)).hom s)
      rw [map_zsmul, map_zsmul]
      congr 1
      have hnat_L := congrArg (fun m => m.hom s) (Φ_LHS.hom.naturality (Opposite.op (k_W a)))
      have hnat_R := congrArg (fun m => m.hom s) (Φ_RHS.hom.naturality (Opposite.op (k_W a)))
      change (Φ_LHS.hom.app (Opposite.op (Y_W a))).hom
          ((ℰ.obj.map (Opposite.op (k_W a))).hom s) =
        (𝒢.obj.map (Opposite.op (k_W a))).hom ((Φ_LHS.hom.app (Opposite.op W)).hom s) at hnat_L
      change (Φ_RHS.hom.app (Opposite.op (Y_W a))).hom
          ((ℰ.obj.map (Opposite.op (k_W a))).hom s) =
        (𝒢.obj.map (Opposite.op (k_W a))).hom ((Φ_RHS.hom.app (Opposite.op W)).hom s) at hnat_R
      rw [← hnat_L, ← hnat_R, hSec_eq a]
      have hq_L := congrArg (fun m => m.hom (secHom.hom a))
        (Φ_LHS.hom.naturality (Opposite.op (q_W a)))
      have hq_R := congrArg (fun m => m.hom (secHom.hom a))
        (Φ_RHS.hom.naturality (Opposite.op (q_W a)))
      change (Φ_LHS.hom.app (Opposite.op (Y_W a))).hom
          ((ℰ.obj.map (Opposite.op (q_W a))).hom (secHom.hom a)) =
        (𝒢.obj.map (Opposite.op (q_W a))).hom
          ((Φ_LHS.hom.app (Opposite.op V_tilde)).hom (secHom.hom a)) at hq_L
      change (Φ_RHS.hom.app (Opposite.op (Y_W a))).hom
          ((ℰ.obj.map (Opposite.op (q_W a))).hom (secHom.hom a)) =
        (𝒢.obj.map (Opposite.op (q_W a))).hom
          ((Φ_RHS.hom.app (Opposite.op V_tilde)).hom (secHom.hom a)) at hq_R
      rw [hq_L, hq_R]
      congr 1
      exact congrArg (fun m => m.hom a) hUniv_Vtilde
    have h1 := congrArg (fun m => m.hom (ULift.up (1 : ℤ))) hz_eq
    simpa only [zHom, AddCommGrpCat.hom_ofHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk,
      one_zsmul] using h1

  have hαβ : α ≫ β = 𝟙 (L_π.obj ℰ) := by
    apply (adj_π.homEquiv ℰ (L_π.obj ℰ)).injective
    have hL_eq : adj_π.homEquiv ℰ (L_π.obj ℰ) (α ≫ β) = Φ_LHS := by
      rw [adj_π.homEquiv_unit, P_π.map_comp, ← CategoryTheory.Category.assoc, hα_unit]
    have hR_eq : adj_π.homEquiv ℰ (L_π.obj ℰ) (𝟙 (L_π.obj ℰ)) = Φ_RHS := by
      rw [adj_π.homEquiv_unit, P_π.map_id]
      exact CategoryTheory.Category.comp_id _
    exact hL_eq.trans (hΦ_eq.trans hR_eq.symm)

  refine ⟨ℰ, triv, ⟨hCont_π, hAdj_π, ⟨CategoryTheory.Iso.mk α β hαβ hβα⟩⟩, hFunc, hInjRange⟩

theorem weil_mid_dev_closed_etale_module_ext_odd_skew_comm (S : AlgebraicGeometry.Scheme.{u}) (m_mod m c : ℕ)
    (hm_mod : 1 ≤ m_mod) (hc : (2 * m + 1) + (2 * m + 1) = c)
    (a b : weilEtaleModuleH S m_mod (2 * m + 1)) :
    CategoryTheory.Abelian.Ext.comp b a hc = -CategoryTheory.Abelian.Ext.comp a b hc :=
by
  have hPart1 : ∀ (C : ℕ → Type u) [∀ n, AddCommGroup (C n)]
      (one : ∀ n : ℕ, C n)
      (mul : ∀ n : ℕ, C n →+ C n →+ C n)
      (mapMono : ∀ {r s : ℕ} (θ : Fin (r + 1) → Fin (s + 1)), StrictMono θ → (C r →+ C s)),
      (∀ (n : ℕ) (x y : C n), mul n x y = mul n y x) →
      (∀ (n : ℕ) (x : C n), mul n (one n) x = x) →
      (∀ (r : ℕ) (h : StrictMono (id : Fin (r + 1) → Fin (r + 1))) (x : C r),
        mapMono id h x = x) →
      (∀ {a b c : ℕ} (θ₁ : Fin (a + 1) → Fin (b + 1))
        (θ₂ : Fin (b + 1) → Fin (c + 1)) (h₁ : StrictMono θ₁) (h₂ : StrictMono θ₂)
        (h₁₂ : StrictMono (θ₂ ∘ θ₁)) (x : C a),
        mapMono (θ₂ ∘ θ₁) h₁₂ x = mapMono θ₂ h₂ (mapMono θ₁ h₁ x)) →
      (∀ {r s : ℕ} (θ : Fin (r + 1) → Fin (s + 1)) (h : StrictMono θ),
        mapMono θ h (one r) = one s) →
      (∀ {r s : ℕ} (θ : Fin (r + 1) → Fin (s + 1)) (h : StrictMono θ) (x y : C r),
        mapMono θ h (mul r x y) = mul s (mapMono θ h x) (mapMono θ h y)) →
      let diffC : ∀ n : ℕ, C n →+ C (n + 1) := fun n =>
        ∑ i : Fin (n + 2), ((-1 : ℤ) ^ i.1) • mapMono i.succAbove (Fin.strictMono_succAbove i)
      let frontFace (q k : ℕ) : Fin (k + 1) → Fin (q + k + 1) := fun i => ⟨i.1, by omega⟩
      let backFace (q k : ℕ) : Fin (q + 1) → Fin (q + k + 1) := fun j => ⟨k + j.1, by omega⟩
      let hfront_sm : ∀ q k : ℕ, StrictMono (frontFace q k) := fun _ _ _ _ h => h
      let hback_sm : ∀ q k : ℕ, StrictMono (backFace q k) :=
        fun _ k _ _ h => Nat.add_lt_add_left h k
      let rightCupC (q k : ℕ) (u : C q) (w : C k) : C (q + k) :=
        mul (q + k)
          (mapMono (frontFace q k) (hfront_sm q k) w)
          (mapMono (backFace q k) (hback_sm q k) u)
      (∀ (q : ℕ) (u : C q), rightCupC q 0 u (one 0) = u) ∧
      (∀ (q k : ℕ) (u : C q), diffC q u = 0 → ∀ w : C k,
        diffC (q + k) (rightCupC q k u w) = rightCupC q (k + 1) u (diffC k w)) ∧
      (∀ (m₀ : ℕ) (u v : C (2 * m₀ + 1)),
        diffC (2 * m₀ + 1) u = 0 → diffC (2 * m₀ + 1) v = 0 →
        ∃ h : C ((2 * m₀ + 1) + 2 * m₀),
          rightCupC (2 * m₀ + 1) (2 * m₀ + 1) u v +
            rightCupC (2 * m₀ + 1) (2 * m₀ + 1) v u =
            diffC ((2 * m₀ + 1) + 2 * m₀) h) := by
    intro C _ one mul mapMono hmul_comm hone_mul hmap_id hmap_comp hmap_one hmap_mul
      diffC frontFace backFace hfront_sm hback_sm rightCupC
    have hdiff_apply : ∀ (n : ℕ) (x : C n),
        diffC n x =
          ∑ i : Fin (n + 2),
            ((-1 : ℤ) ^ i.1) • mapMono i.succAbove (Fin.strictMono_succAbove i) x := by
      intro n x
      dsimp only [diffC]
      have haux : ∀ (s : Finset (Fin (n + 2))) (φ : Fin (n + 2) → C n →+ C (n + 1)),
          (∑ i ∈ s, φ i) x = ∑ i ∈ s, φ i x := by
        intro s φ
        induction s using Finset.induction_on with
        | empty => rfl
        | @insert a s ha ih =>
          rw [Finset.sum_insert ha, Finset.sum_insert ha, AddMonoidHom.add_apply, ih]
      rw [haux]
      rfl
    have hval_succAbove : ∀ {n : ℕ} (i : Fin (n + 1)) (x : Fin n),
        (i.succAbove x).1 = if x.1 < i.1 then x.1 else x.1 + 1 := by
      intro n i x
      unfold Fin.succAbove
      by_cases h : x.castSucc < i
      · have h' : x.1 < i.1 := h
        simp [h, h']
      · have h' : ¬ (x.1 < i.1) := h
        simp [h, h']
    have hmap_congr : ∀ {r s : ℕ} (θ₁ θ₂ : Fin (r + 1) → Fin (s + 1))
        (h₁ : StrictMono θ₁) (h₂ : StrictMono θ₂)
        (heq : ∀ i : Fin (r + 1), (θ₁ i).1 = (θ₂ i).1) (x : C r),
        mapMono θ₁ h₁ x = mapMono θ₂ h₂ x := by
      intro r s θ₁ θ₂ h₁ h₂ heq x
      have hθ : θ₁ = θ₂ := funext fun i => Fin.ext (heq i)
      subst hθ
      rfl
    have hmap_comp_eq : ∀ {a b c : ℕ} (θ₁ : Fin (a + 1) → Fin (b + 1))
        (θ₂ : Fin (b + 1) → Fin (c + 1)) (θ₃ : Fin (a + 1) → Fin (c + 1))
        (h₁ : StrictMono θ₁) (h₂ : StrictMono θ₂) (h₃ : StrictMono θ₃)
        (heq : ∀ i : Fin (a + 1), (θ₂ (θ₁ i)).1 = (θ₃ i).1) (x : C a),
        mapMono θ₂ h₂ (mapMono θ₁ h₁ x) = mapMono θ₃ h₃ x := by
      intro a b c θ₁ θ₂ θ₃ h₁ h₂ h₃ heq x
      rw [← hmap_comp θ₁ θ₂ h₁ h₂ (h₂.comp h₁) x]
      exact hmap_congr (θ₂ ∘ θ₁) θ₃ (h₂.comp h₁) h₃ heq x
    have hsum_fin_eq_split : ∀ {n_deg N : ℕ} (f : Fin N → C n_deg) (a b : ℕ) (h : a + b = N),
        (∑ r : Fin N, f r) =
          (∑ i : Fin a, f ⟨i.1, by omega⟩) + (∑ j : Fin b, f ⟨a + j.1, by omega⟩) := by
      intro n_deg N f a b
      induction b generalizing N with
      | zero =>
        intro h
        subst h
        simp only [Nat.add_zero, Finset.univ_eq_empty, Finset.sum_empty, add_zero]
      | succ b ih =>
        intro h
        have h' : (a + b) + 1 = N := by omega
        subst h'
        rw [Fin.sum_univ_castSucc, ih (fun r => f r.castSucc) rfl,
          Fin.sum_univ_castSucc (n := b), add_assoc]
        rfl
    have hmul_sum_left : ∀ {I : Type} (n : ℕ) (s : Finset I) (f : I → C n) (y : C n),
        mul n (∑ i ∈ s, f i) y = ∑ i ∈ s, mul n (f i) y := by
      intro I n s f y
      exact map_sum ((mul n).flip y) f s
    have hmul_sum_right : ∀ {I : Type} (n : ℕ) (x : C n) (s : Finset I) (f : I → C n),
        mul n x (∑ i ∈ s, f i) = ∑ i ∈ s, mul n x (f i) := by
      intro I n x s f
      exact map_sum (mul n x) f s
    have hmul_zsmul_left : ∀ (n : ℕ) (c : ℤ) (x y : C n),
        mul n (c • x) y = c • mul n x y := by
      intro n c x y
      exact map_zsmul ((mul n).flip y) c x
    have hmul_zsmul_right : ∀ (n : ℕ) (c : ℤ) (x y : C n),
        mul n x (c • y) = c • mul n x y := by
      intro n c x y
      exact map_zsmul (mul n x) c y
    refine ⟨?_, ?_, ?_⟩
    · intro q u
      dsimp only [rightCupC]
      rw [hmap_one,
        hmap_congr (backFace q 0) id _ strictMono_id (fun j => Nat.zero_add j.1) u,
        hmap_id]
      exact hone_mul q u
    · intro q k u hu w
      let α_f : Fin (k + 1) → Fin (q + k + 2) := fun i => ⟨i.1, by omega⟩
      let β_b : Fin (q + 2) → Fin (q + k + 2) := fun j => ⟨k + j.1, by omega⟩
      have hα_sm : StrictMono α_f := fun _ _ h => h
      have hβ_sm : StrictMono β_b := fun _ _ h => Nat.add_lt_add_left h k
      have hzero_u : ((-1 : ℤ) ^ k) •
          mul (q + k + 1) (mapMono α_f hα_sm w) (mapMono β_b hβ_sm (diffC q u)) = 0 := by
        rw [hu, map_zero, map_zero, smul_zero]
      rw [← add_zero (rightCupC q (k + 1) u (diffC k w)), ← hzero_u]
      dsimp only [rightCupC]
      have hRHS1 :
          mul (q + (k + 1))
            (mapMono (frontFace q (k + 1)) (hfront_sm q (k + 1)) (diffC k w))
            (mapMono (backFace q (k + 1)) (hback_sm q (k + 1)) u) =
          (∑ s : Fin (k + 1),
            ((-1 : ℤ) ^ (s.castSucc).1) •
              mul (q + (k + 1))
                (mapMono (frontFace q (k + 1)) (hfront_sm q (k + 1))
                  (mapMono (s.castSucc).succAbove (Fin.strictMono_succAbove _) w))
                (mapMono (backFace q (k + 1)) (hback_sm q (k + 1)) u)) +
          ((-1 : ℤ) ^ (Fin.last (k + 1)).1) •
            mul (q + (k + 1))
              (mapMono (frontFace q (k + 1)) (hfront_sm q (k + 1))
                (mapMono (Fin.last (k + 1)).succAbove (Fin.strictMono_succAbove _) w))
              (mapMono (backFace q (k + 1)) (hback_sm q (k + 1)) u) := by
        rw [hdiff_apply k w, map_sum, hmul_sum_left]
        have hcongr :
            (∑ s : Fin (k + 2),
              mul (q + (k + 1))
                (mapMono (frontFace q (k + 1)) (hfront_sm q (k + 1))
                  (((-1 : ℤ) ^ s.1) • mapMono s.succAbove (Fin.strictMono_succAbove s) w))
                (mapMono (backFace q (k + 1)) (hback_sm q (k + 1)) u)) =
            ∑ s : Fin (k + 2),
              ((-1 : ℤ) ^ s.1) •
                mul (q + (k + 1))
                  (mapMono (frontFace q (k + 1)) (hfront_sm q (k + 1))
                    (mapMono s.succAbove (Fin.strictMono_succAbove s) w))
                  (mapMono (backFace q (k + 1)) (hback_sm q (k + 1)) u) := by
          refine Finset.sum_congr rfl fun s _ => ?_
          rw [map_zsmul, hmul_zsmul_left]
        rw [hcongr, Fin.sum_univ_castSucc (n := k + 1)]
      have hRHS2 :
          ((-1 : ℤ) ^ k) •
            mul (q + k + 1) (mapMono α_f hα_sm w) (mapMono β_b hβ_sm (diffC q u)) =
          ((-1 : ℤ) ^ (k + (0 : Fin (q + 2)).1)) •
            mul (q + k + 1)
              (mapMono α_f hα_sm w)
              (mapMono β_b hβ_sm
                (mapMono (0 : Fin (q + 2)).succAbove (Fin.strictMono_succAbove _) u)) +
          ∑ p : Fin (q + 1),
            ((-1 : ℤ) ^ (k + (p.succ).1)) •
              mul (q + k + 1)
                (mapMono α_f hα_sm w)
