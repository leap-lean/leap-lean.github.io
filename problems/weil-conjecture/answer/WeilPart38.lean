    clear * - R₀ hCR_R₀ hNoeth_R₀ U e_U
    intro V w hw y
    have _ := hw
    obtain ⟨U_aff, hAff, hy, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
    let B : Type u := ↑(V.presheaf.obj (Opposite.op U_aff))
    let z : ↥(AlgebraicGeometry.Spec (CommRingCat.of B)) := hAff.isoSpec.hom.base ⟨y, hy⟩
    let g_spec : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
