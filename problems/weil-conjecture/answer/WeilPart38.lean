  have hSpanL_sub : ∀ w₀ : ↥(weilEtaleIntegralSystem S_u ℓ n),
      ∃ c : Fin N → PadicInt ℓ,
        ∀ s : ℕ, (ℓ ^ e) • w₀.1 s =
          ∑ i : Fin N, (PadicInt.toZModPow s (c i)).val • (u_sub i).1 s :=
    hSpanL_all n (le_refl n)
  have hSpanL : ∀ (w : ∀ s : ℕ, weilEtaleTorsionH S_u (ℓ ^ s) n),
