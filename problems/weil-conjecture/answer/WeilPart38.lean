        let g_lc : LocallyConstant ↥E.left ↥A := g_sec
        let a : ↥A := g_lc z
        let O_a : E.left.Opens := ⟨g_lc ⁻¹' {a}, g_lc.isLocallyConstant {a}⟩
        have hY_et : AlgebraicGeometry.Etale (O_a.ι ≫ E.hom) :=
          MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) O_a.ι E.hom inferInstance E.prop
        let Y_a : V.Etale := MorphismProperty.Over.mk ⊤ (O_a.ι ≫ E.hom) hY_et
        let u_a : Y_a ⟶ E := MorphismProperty.Over.homMk O_a.ι rfl trivial
        exact ⟨Y_a, u_a, ⟨z, rfl⟩, ⟨a, LocallyConstant.ext fun y => y.2.symm⟩, inferInstance, rfl⟩
      have hW_θ : V.smallEtaleTopology.W θ_A :=
        (V.smallEtaleTopology.W_iff_isLocallyBijective θ_A).mpr ⟨hLocInj, hLocSurj⟩
      have hIso_map :
          IsIso ((CategoryTheory.presheafToSheaf V.smallEtaleTopology AddCommGrpCat.{u}).map θ_A) :=
        (V.smallEtaleTopology.W_iff θ_A).mp hW_θ
      let ℒ_A : Sheaf V.smallEtaleTopology AddCommGrpCat.{u} := ⟨P_A, hSheaf⟩
      let adj_sh := CategoryTheory.sheafificationAdjunction V.smallEtaleTopology AddCommGrpCat.{u}
      let P_const := (Functor.const (Opposite V.Etale)).obj A
      let Υ_hom :
          (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A ⟶ ℒ_A :=
        (adj_sh.homEquiv P_const ℒ_A).symm θ_A
      have hΥ_eq : Υ_hom =
          (CategoryTheory.presheafToSheaf V.smallEtaleTopology AddCommGrpCat.{u}).map θ_A ≫
            adj_sh.counit.app ℒ_A :=
        Adjunction.homEquiv_counit adj_sh P_const ℒ_A θ_A
      have _ : IsIso Υ_hom := by
        rw [hΥ_eq]
        exact @IsIso.comp_isIso _ _ _ _ _ _ _ hIso_map inferInstance
      let Υ : (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A ≅ ℒ_A :=
        asIso Υ_hom
      have h_unit_Υ : adj_sh.unit.app P_const ≫ Υ.hom.hom = θ_A := by
        have h1 := (adj_sh.homEquiv P_const ℒ_A).apply_symm_apply θ_A
        rwa [Adjunction.homEquiv_unit] at h1
      let T_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
      let Γ_V := (CategoryTheory.sheafSections V.smallEtaleTopology AddCommGrpCat.{u}).obj
        (Opposite.op T_V)
      let adj_V := CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u} (hTerm V)
      have h_adjV_comp : adj_V.unit.app A ≫ Γ_V.map Υ.hom = θ_A.app (Opposite.op T_V) := by
        have heval := congrArg (fun η => η.app (Opposite.op T_V)) h_unit_Υ
        dsimp [adj_V, CategoryTheory.constantSheafAdj]
        rw [Adjunction.comp_unit_app]
        have hpresheaf_unit :
            (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} (hTerm V)).unit.app A = 𝟙 A :=
          rfl
        rw [hpresheaf_unit, Category.id_comp]
        exact heval
      refine ⟨hSheaf, Υ, ?_, ?_⟩
      · intro a
        exact congrArg (fun φ => φ.hom a) h_adjV_comp
      · intro hNe hPre
        have h_bij : Function.Bijective ⇑(θ_A.app (Opposite.op T_V)).hom := by
          refine ⟨fun a₁ a₂ ha => ?_, fun g_sec => ?_⟩
          · let v₀ : ↥T_V.left := Classical.arbitrary ↥V
            exact congrArg (fun fn : LocallyConstant ↥T_V.left ↥A => fn v₀) ha
          · have _ : PreconnectedSpace ↥T_V.left := hPre
            have _ : Nonempty ↥A := ⟨0⟩
            obtain ⟨a, rfl⟩ := LocallyConstant.exists_eq_const g_sec
            exact ⟨a, rfl⟩
        have hIso_θ : IsIso (θ_A.app (Opposite.op T_V)) :=
          (ConcreteCategory.isIso_iff_bijective (θ_A.app (Opposite.op T_V))).mpr h_bij
        rw [← h_adjV_comp] at hIso_θ
        have hIso_unit : IsIso (adj_V.unit.app A) :=
          @IsIso.of_isIso_comp_right _ _ _ _ _
            (adj_V.unit.app A) (Γ_V.map Υ.hom) inferInstance hIso_θ
        have htri := adj_V.left_triangle_components A
        let C_V := CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}
        have _ : IsIso (C_V.map (adj_V.unit.app A)) :=
          (C_V.mapIso (@asIso _ _ _ _ (adj_V.unit.app A) hIso_unit)).isIso_hom
        have hIso_id : IsIso (C_V.map (adj_V.unit.app A) ≫ adj_V.counit.app (C_V.obj A)) := by
          rw [htri]
          exact IsIso.id _
        have hIso_counit : IsIso (adj_V.counit.app (C_V.obj A)) :=
          @IsIso.of_isIso_comp_left _ _ _ _ _
            (C_V.map (adj_V.unit.app A)) (adj_V.counit.app (C_V.obj A)) inferInstance hIso_id
        exact ⟨hIso_unit, hIso_counit⟩
    refine ⟨resEtale, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro V X w hw
      let _ := hOpenCont hw
      obtain ⟨adj_w⟩ := hResAdj hw (hContB w)
      have _ : (resEtale hw).IsLeftAdjoint := adj_w.isLeftAdjoint
      have hAdd : (resEtale hw).Additive :=
        { map_add := fun {_ _ _ _} => Sheaf.hom_ext (NatTrans.ext (funext fun _ => rfl)) }
      have hLim : Limits.PreservesFiniteLimits (resEtale hw) := by
        refine Limits.PreservesFiniteLimits.mk fun K _ _ => ?_
        have _ : Limits.PreservesLimitsOfShape K
            (resEtale hw ⋙ sheafToPresheaf V.smallEtaleTopology AddCommGrpCat.{u}) := by
          change Limits.PreservesLimitsOfShape K
            (sheafToPresheaf X.smallEtaleTopology AddCommGrpCat.{u} ⋙
              (Functor.whiskeringLeft _ _ _).obj (siteMap hw).op)
          infer_instance
        exact Limits.preservesLimitsOfShape_of_reflects_of_preserves
          (resEtale hw) (sheafToPresheaf V.smallEtaleTopology AddCommGrpCat.{u})
      exact ⟨hAdd, hLim, inferInstance⟩
    · intro V₂ V₁ X v w hv hw hvw
      let iso_M : siteMap hvw ≅ siteMap hv ⋙ siteMap hw :=
        NatIso.ofComponents
          (fun Y => MorphismProperty.Over.isoMk (Iso.refl Y.left)
            ((Category.id_comp _).trans (Category.assoc Y.hom v w)))
          (fun {_ _} u => MorphismProperty.Comma.Hom.ext
            ((Category.comp_id u.left).trans (Category.id_comp u.left).symm)
            (Subsingleton.elim _ _))
      let _ := hOpenCont hv; let _ := hOpenCont hw; let _ := hOpenCont hvw
      let _ := Functor.isContinuous_comp (siteMap hv) (siteMap hw)
        V₂.smallEtaleTopology V₁.smallEtaleTopology X.smallEtaleTopology
      exact ⟨Functor.sheafPushforwardContinuousIso iso_M AddCommGrpCat.{u}
          V₂.smallEtaleTopology X.smallEtaleTopology ≪≫
        (Functor.sheafPushforwardContinuousComp (siteMap hv) (siteMap hw) AddCommGrpCat.{u}
          V₂.smallEtaleTopology V₁.smallEtaleTopology X.smallEtaleTopology).symm⟩
    · intro V X w hw ℱ 𝒢
      refine ⟨fun ⟨hc_w, hr_w, ⟨e_pb⟩⟩ => ?_, fun ⟨e_res⟩ => ?_⟩
      · obtain ⟨adj_res⟩ := hResAdj hw hc_w
        let _ := hc_w; let _ := hr_w
        let adj_pb := (sitePb w).sheafAdjunctionContinuous AddCommGrpCat.{u}
          X.smallEtaleTopology V.smallEtaleTopology
        exact ⟨(adj_res.leftAdjointUniq adj_pb).app ℱ ≪≫ e_pb⟩
      · have hc_w := hContB w
        obtain ⟨adj_w⟩ := hResAdj hw hc_w
        let _ := hc_w
        have hr_w : ((sitePb w).sheafPushforwardContinuous AddCommGrpCat.{u}
            X.smallEtaleTopology V.smallEtaleTopology).IsRightAdjoint :=
          adj_w.isRightAdjoint
        let _ := hr_w
        let adj_pb := (sitePb w).sheafAdjunctionContinuous AddCommGrpCat.{u}
          X.smallEtaleTopology V.smallEtaleTopology
        exact ⟨hc_w, hr_w, ⟨(adj_pb.leftAdjointUniq adj_w).app ℱ ≪≫ e_res⟩⟩
    · intro V' V w hw A
      obtain ⟨hSh_V, Υ_V, _, _⟩ := hLocConstModel V A
      obtain ⟨hSh_V', Υ_V', _, _⟩ := hLocConstModel V' A
      let e_def : (resEtale hw).obj ⟨locConstPresheaf V A, hSh_V⟩ ≅
          ⟨locConstPresheaf V' A, hSh_V'⟩ :=
        { hom := { hom := 𝟙 _ }
          inv := { hom := 𝟙 _ }
          hom_inv_id := Sheaf.hom_ext (Category.id_comp _)
          inv_hom_id := Sheaf.hom_ext (Category.id_comp _) }
      exact ⟨(resEtale hw).mapIso Υ_V ≪≫ e_def ≪≫ Υ_V'.symm⟩
    · intro V _ _ A
      exact (hLocConstModel V A).choose_spec.choose_spec.2
    · intro P W₂ hPre E_lift u_lift j' hv ℰ_P A₃ g_P hLiftA
      rw [AddCommGrpCat.epi_iff_surjective]
      obtain ⟨_, Υ_P, hΥ_const, _⟩ := hLocConstModel P A₃
      let T_P : P.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 P)
      let T₂ : W₂.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 W₂)
      let E_v : P.Etale := (siteMap hv).obj T₂
      let m_j' : E_v ⟶ E_lift :=
        MorphismProperty.Over.homMk j' (Category.id_comp (j' ≫ E_lift.hom)).symm trivial
      intro t₂
      let f_lc : LocallyConstant ↥E_v.left ↥A₃ := (Υ_P.hom.hom.app (Opposite.op E_v)).hom t₂
      have _ : PreconnectedSpace ↥E_v.left := hPre
      have _ : Nonempty ↥A₃ := ⟨0⟩
      obtain ⟨a, ha_const⟩ := LocallyConstant.exists_eq_const f_lc
      obtain ⟨s_lift, hs_lift⟩ := hLiftA a
      let s₂ : ↥(((resEtale hv).obj ℰ_P).obj.obj (Opposite.op T₂)) :=
        (ℰ_P.obj.map m_j'.op).hom s_lift
      refine ⟨s₂, ?_⟩
      let C_P := CategoryTheory.constantSheaf P.smallEtaleTopology AddCommGrpCat.{u}
      let t₀ := ((CategoryTheory.constantSheafAdj P.smallEtaleTopology AddCommGrpCat.{u}
        (hTerm P)).unit.app A₃).hom a
      have hnat_j' := congrArg (fun φ => φ.hom s_lift) (g_P.hom.naturality m_j'.op)
      change (g_P.hom.app (Opposite.op E_v)).hom s₂ =
        ((C_P.obj A₃).obj.map m_j'.op).hom ((g_P.hom.app (Opposite.op E_lift)).hom s_lift) at hnat_j'
      have hg_s₂ : (g_P.hom.app (Opposite.op E_v)).hom s₂ =
          ((C_P.obj A₃).obj.map (m_j' ≫ u_lift).op).hom t₀ := by
        rw [hnat_j', hs_lift]
        change ((C_P.obj A₃).obj.map m_j'.op).hom (((C_P.obj A₃).obj.map u_lift.op).hom t₀) = _
        rw [op_comp, (C_P.obj A₃).obj.map_comp]; rfl
      apply (ConcreteCategory.bijective_of_isIso (Υ_P.hom.hom.app (Opposite.op E_v))).1
      have hnat_Υ := congrArg (fun φ => φ.hom t₀) (Υ_P.hom.hom.naturality (m_j' ≫ u_lift).op)
      change (Υ_P.hom.hom.app (Opposite.op E_v)).hom
          (((C_P.obj A₃).obj.map (m_j' ≫ u_lift).op).hom t₀) =
        LocallyConstant.comap (m_j' ≫ u_lift).left.base.hom
          ((Υ_P.hom.hom.app (Opposite.op T_P)).hom t₀) at hnat_Υ
      change (Υ_P.hom.hom.app (Opposite.op E_v)).hom ((g_P.hom.app (Opposite.op E_v)).hom s₂) = f_lc
      rw [hg_s₂, hnat_Υ, hΥ_const a]
      change LocallyConstant.comap _ (LocallyConstant.const _ a) = f_lc
      rw [ha_const]; ext; rfl

  obtain ⟨resEtale, hResExact, hResComp, hResPbIff, hResConst, hConnIso, hResEpi⟩ :=
    hSlicePkg

  
  have hKerCokAtX :
      ∀ {ℱ₁ ℱ₂ : Sheaf U.smallEtaleTopology AddCommGrpCat.{u}} (ψ₀ : ℱ₁ ⟶ ℱ₂),
        (∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U) (A₀ : AddCommGrpCat.{u}),
          AlgebraicGeometry.Etale w ∧ x ∈ Set.range w.base ∧ Finite ↥A₀ ∧
          WeilIsEtaleSheafPullback w ℱ₁
            ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)) →
        (∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U) (A₀ : AddCommGrpCat.{u}),
          AlgebraicGeometry.Etale w ∧ x ∈ Set.range w.base ∧ Finite ↥A₀ ∧
          WeilIsEtaleSheafPullback w ℱ₂
            ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)) →
        (∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U) (A₀ : AddCommGrpCat.{u}),
          AlgebraicGeometry.Etale w ∧ x ∈ Set.range w.base ∧ Finite ↥A₀ ∧
          WeilIsEtaleSheafPullback w (Limits.kernel ψ₀)
            ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)) ∧
        (∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U) (A₀ : AddCommGrpCat.{u}),
          AlgebraicGeometry.Etale w ∧ x ∈ Set.range w.base ∧ Finite ↥A₀ ∧
          WeilIsEtaleSheafPullback w (Limits.cokernel ψ₀)
            ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)) := by
    clear * - U x hEtComp hShrink hTerm resEtale hResExact hResComp hResPbIff hResConst hConnIso
    intro ℱ₁ ℱ₂ ψ₀ ⟨W₁, w₁, A₁, hw₁, ⟨y₁, hy₁⟩, hFin₁, hPb₁⟩
      ⟨W₂, w₂, A₂, hw₂, ⟨y₂, hy₂⟩, hFin₂, hPb₂⟩
    have _ := hw₁; have _ := hw₂
    obtain ⟨e₁_W₁⟩ := (hResPbIff hw₁).1 hPb₁
    obtain ⟨e₂_W₂⟩ := (hResPbIff hw₂).1 hPb₂
    let P := Limits.pullback w₁ w₂
    let fst : P ⟶ W₁ := Limits.pullback.fst w₁ w₂
    let snd : P ⟶ W₂ := Limits.pullback.snd w₁ w₂
    obtain ⟨p, hp_fst, _⟩ :=
      Scheme.Pullback.exists_preimage_pullback y₁ y₂ (hy₁.trans hy₂.symm)
    obtain ⟨W₀, j₀, y₀, hj₀_open, hj₀_pt, hConn₀⟩ :=
      hShrink P (fst ≫ w₁) inferInstance p
    have _ := hj₀_open; have _ := hConn₀
    let v₁ : W₀ ⟶ W₁ := j₀ ≫ fst
    let v₂ : W₀ ⟶ W₂ := j₀ ≫ snd
    have hv₁ : AlgebraicGeometry.Etale v₁ := inferInstance
    have hv₂ : AlgebraicGeometry.Etale v₂ := inferInstance
    let w₀ : W₀ ⟶ U := v₁ ≫ w₁
    have hw₀ : AlgebraicGeometry.Etale w₀ := inferInstance
    have hw₀_eq : v₂ ≫ w₂ = w₀ := by
      dsimp [v₁, v₂, w₀]
      rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc]
    have hw₀_pt : w₀.base y₀ = x := by
      change w₁.base (fst.base (j₀.base y₀)) = x
      rw [hj₀_pt, hp_fst, hy₁]
    let C₀ := CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}
    obtain ⟨e_comp₁⟩ := hResComp hv₁ hw₁ hw₀
    obtain ⟨e_c₁⟩ := hResConst hv₁ A₁
    have hw₀' : AlgebraicGeometry.Etale (v₂ ≫ w₂) := hw₀_eq.symm ▸ hw₀
    obtain ⟨e_comp₂⟩ := hResComp hv₂ hw₂ hw₀'
    obtain ⟨e_c₂⟩ := hResConst hv₂ A₂
    have hResEq : ∀ {g₁ g₂ : W₀ ⟶ U} (_ : g₁ = g₂) (hg₁ : AlgebraicGeometry.Etale g₁)
        (hg₂ : AlgebraicGeometry.Etale g₂),
        (resEtale hg₂).obj ℱ₂ ≅ (resEtale hg₁).obj ℱ₂ := by
      rintro g₁ _ rfl _ _; exact Iso.refl _
    let e₁ : (resEtale hw₀).obj ℱ₁ ≅ C₀.obj A₁ :=
      e_comp₁.app ℱ₁ ≪≫ (resEtale hv₁).mapIso e₁_W₁ ≪≫ e_c₁
    let e₂ : (resEtale hw₀).obj ℱ₂ ≅ C₀.obj A₂ :=
      hResEq hw₀_eq hw₀' hw₀ ≪≫ e_comp₂.app ℱ₂ ≪≫ (resEtale hv₂).mapIso e₂_W₂ ≪≫ e_c₂
    have hHasCokSh : ∀ (Y : AlgebraicGeometry.Scheme.{u})
        {G₁ G₂ : Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}} (m : G₁ ⟶ G₂),
        Limits.HasCokernel m := by
      clear * -; intro _ _ _ _; infer_instance
    have hHasCokAb : ∀ {B₁ B₂ : AddCommGrpCat.{u}} (m : B₁ ⟶ B₂),
        Limits.HasCokernel m := by
      clear * -; intro _ _ _; infer_instance
    obtain ⟨hAdd_R, hLim_R, hColim_R⟩ := hResExact hw₀
    have _ := hAdd_R; have _ := hLim_R; have _ := hColim_R
    let T₀ : W₀.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 W₀)
    let Γ₀ := (CategoryTheory.sheafSections W₀.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₀)
    let adj₀ := CategoryTheory.constantSheafAdj W₀.smallEtaleTopology AddCommGrpCat.{u} (hTerm W₀)
    obtain ⟨hIso_u₂, _⟩ := hConnIso W₀ A₂
    have _ := hIso_u₂
    let ψ : C₀.obj A₁ ⟶ C₀.obj A₂ := e₁.inv ≫ (resEtale hw₀).map ψ₀ ≫ e₂.hom
    let α : A₁ ⟶ A₂ := adj₀.unit.app A₁ ≫ Γ₀.map ψ ≫ (asIso (adj₀.unit.app A₂)).inv
