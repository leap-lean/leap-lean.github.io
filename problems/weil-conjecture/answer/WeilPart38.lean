      hAff_Pmk c_Pmk t_Pmk hCoord_Pmk
      hAff_PmR0 c_PmR0 t_PmR0 θ_PmR0 hCoord_PmR0 hθ_PmR0
      Φ_Pm_R0 hBC_Pm_R0 Z_Q ι_Q hPres_Q
