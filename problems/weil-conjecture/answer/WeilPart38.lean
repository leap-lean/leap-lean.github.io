          rw [hmul_g]
          exact Polynomial.mul_self_modByMonic hg_mon
        rw [Polynomial.dvd_iff_isRoot, Polynomial.IsRoot.def, hCol_eq]
        change (Polynomial.evalRingHom x₁) (((H * B_lift) %ₘ G).coeff a.1) = 0
        rw [← Polynomial.coeff_map, hMod_ev, Polynomial.coeff_zero]
      let v : Fin pb.dim → Polynomial E :=
        fun k => if k.1 < s then Polynomial.X - Polynomial.C x₁ else 1
      have hv_dvd : ∀ a k : Fin pb.dim, ∃ q : Polynomial E, (M_mat H * T_C) a k = v k * q := by
        intro a k
        dsimp [v]
        split_ifs with hk
        · exact hCol_dvd a k hk
        · exact ⟨(M_mat H * T_C) a k, (one_mul _).symm⟩
      let C_quot : Matrix (Fin pb.dim) (Fin pb.dim) (Polynomial E) :=
        Matrix.of fun a k => Classical.choose (hv_dvd a k)
      have hMTC_eq : M_mat H * T_C = Matrix.of (fun a k => v k * C_quot a k) :=
        Matrix.ext fun a k => Classical.choose_spec (hv_dvd a k)
      have hv_prod : (∏ k : Fin pb.dim, v k) = (Polynomial.X - Polynomial.C x₁) ^ s := by
        dsimp [v]
        rw [Finset.prod_ite, Finset.prod_const, Finset.prod_const_one, mul_one]
        let U_lt : Finset (Fin pb.dim) := Finset.univ.filter fun k : Fin pb.dim => k.1 < s
        let emb : Fin s → Fin pb.dim := fun j => ⟨j.1, j.2.trans_le (hs_le.trans hpb_dim.symm.le)⟩
        have hemb_inj : Function.Injective emb := by
          intro i j hij
          have hval : (emb i).1 = (emb j).1 := congrArg Fin.val hij
          exact Fin.ext hval
        have hU_img : U_lt = Finset.univ.image emb := by
          ext k
          simp only [U_lt, Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_image]
          constructor
          · intro hk
            exact ⟨⟨k.1, hk⟩, Fin.ext rfl⟩
          · rintro ⟨j, rfl⟩
            exact j.2
        have hcard_U : U_lt.card = s := by
          rw [hU_img, Finset.card_image_of_injective _ hemb_inj, Finset.card_fin]
        change (Polynomial.X - Polynomial.C x₁) ^ U_lt.card = _
        rw [hcard_U]
      have hdet_row : (M_mat H * T_C).det =
          (Polynomial.X - Polynomial.C x₁) ^ s * C_quot.det := by
        rw [hMTC_eq, Matrix.det_mul_row, hv_prod]
      have hN_eq_prod : N_poly H =
          (Polynomial.X - Polynomial.C x₁) ^ s *
            (C_quot.det * Polynomial.C ((T₀.det)⁻¹)) := by
        have h1 : N_poly H * Polynomial.C (T₀.det) =
            (Polynomial.X - Polynomial.C x₁) ^ s * C_quot.det :=
          hdet_TC.symm.trans hdet_row
        have h2 := congrArg (· * Polynomial.C ((T₀.det)⁻¹)) h1
        rw [mul_assoc (N_poly H), ← Polynomial.C_mul, mul_inv_cancel₀ hT₀_det,
          Polynomial.C_1, mul_one, mul_assoc] at h2
        exact h2
      exact ⟨C_quot.det * Polynomial.C ((T₀.det)⁻¹), hN_eq_prod⟩

theorem weil_plane_curve_hensel_filtration_package (E : Type u) [Field E] (D₁ : ℕ) (hD₁ : 2 ≤ D₁)
    (G : Polynomial (Polynomial E))
    (hMon : G.Monic)
    (hDeg : G.natDegree = D₁)
    (hTri : ∀ (i j : ℕ), D₁ < i + j → (G.coeff i).coeff j = 0)
    (hG0 : (G.map (Polynomial.evalRingHom 0)).eval 0 = 0)
    (hSmooth0 : ((Polynomial.derivative G).map (Polynomial.evalRingHom 0)).eval 0 ≠ 0) :
    let N_poly : Polynomial (Polynomial E) → Polynomial E :=
      fun H => (Algebra.leftMulMatrix (AdjoinRoot.powerBasis' hMon).basis (AdjoinRoot.mk G H)).det
    let g₁ : ℕ := (D₁ - 1) * (D₁ - 2) / 2
    ∃ (W : ℕ → Submodule E (AdjoinRoot G)) (Φ : AdjoinRoot G →ₐ[E] PowerSeries E),
      ((1 : AdjoinRoot G) ∈ W 0) ∧
      (∀ (m₁ m₂ : ℕ) {u v : AdjoinRoot G}, u ∈ W m₁ → v ∈ W m₂ → u * v ∈ W (m₁ + m₂)) ∧
      (∀ (M : ℕ), D₁ - 1 ≤ M → M + 1 ≤ Module.finrank E (W M) + g₁) ∧
      (∀ (M : ℕ) (u : AdjoinRoot G),
        u ∈ W M →
        (∀ (i j : ℕ), M < i + j → (((AdjoinRoot.modByMonicHom hMon u).coeff i).coeff j = 0)) ∧
        ((Polynomial.X : Polynomial E) ^ ((D₁ - 1) * M) ∣
          N_poly (AdjoinRoot.modByMonicHom hMon u)) ∧
        ((∀ k ≤ M, PowerSeries.coeff k (Φ u) = 0) →
          (Polynomial.X : Polynomial E) ^ (D₁ * M + 1) ∣
            N_poly (AdjoinRoot.modByMonicHom hMon u))) :=
by
  classical
  intro N_poly g₁

  
  
  
  have h_part1 : ∃ (η : ℕ → Polynomial E) (U : ℕ → Polynomial (Polynomial E)),
      (∀ M : ℕ, (η M).eval 0 = 0) ∧
      (∀ M : ℕ, (Polynomial.X : Polynomial E) ^ M ∣ G.eval (η M)) ∧
      (∀ {M N : ℕ}, M ≤ N → (Polynomial.X : Polynomial E) ^ M ∣ (η N - η M)) ∧
      (∀ M : ℕ, (U M).Monic) ∧
      (∀ M : ℕ, (U M).natDegree = D₁ - 1) ∧
      (∀ M : ℕ, G = (Polynomial.X - Polynomial.C (η M)) * U M + Polynomial.C (G.eval (η M))) ∧
      (∀ M : ℕ, ((U M).map (Polynomial.evalRingHom 0)).eval 0 =
        ((Polynomial.derivative G).map (Polynomial.evalRingHom 0)).eval 0) ∧
      (∀ {M N : ℕ}, M ≤ N → Polynomial.C ((Polynomial.X : Polynomial E) ^ M) ∣ (U N - U M)) := by
    let ev₀ : Polynomial E →+* E := Polynomial.evalRingHom 0
    let u₀ : E := ((Polynomial.derivative G).map ev₀).eval 0
    have hu₀ : u₀ ≠ 0 := hSmooth0

    have hPowTaylor : ∀ {R : Type u} [CommRing R] (a δ : R) (n : ℕ),
        δ ^ 2 ∣ ((a + δ) ^ n - a ^ n - (n : R) * a ^ (n - 1) * δ) := by
      intro R _ a δ n
      induction n with
      | zero =>
        simp
      | succ n ih =>
        rcases n with _ | k
        · refine ⟨0, ?_⟩
          simp
        · rcases ih with ⟨q, hq⟩
          rw [Nat.add_sub_cancel] at hq
          have hpow : (a + δ) ^ (k + 1) =
              a ^ (k + 1) + ((k + 1 : ℕ) : R) * a ^ k * δ + δ ^ 2 * q := by
            linear_combination hq
          refine ⟨((k + 1 : ℕ) : R) * a ^ k + q * (a + δ), ?_⟩
          have hsub_idx : k + 2 - 1 = k + 1 := by omega
          calc (a + δ) ^ (k + 2) - a ^ (k + 2) - ((k + 2 : ℕ) : R) * a ^ (k + 2 - 1) * δ
              = (a + δ) ^ (k + 1) * (a + δ) - a ^ (k + 1) * a -
                  ((k + 2 : ℕ) : R) * a ^ (k + 1) * δ := by
                  rw [pow_succ (a + δ) (k + 1), pow_succ a (k + 1), hsub_idx]
            _ = (a ^ (k + 1) + ((k + 1 : ℕ) : R) * a ^ k * δ + δ ^ 2 * q) * (a + δ) -
                  a ^ (k + 1) * a - ((k + 2 : ℕ) : R) * a ^ (k + 1) * δ := by rw [hpow]
            _ = δ ^ 2 * (((k + 1 : ℕ) : R) * a ^ k + q * (a + δ)) := by
                  push_cast
                  rw [pow_succ a k]
                  ring

    have hPolyTaylor : ∀ {R : Type u} [CommRing R] (P : Polynomial R) (a δ : R),
        δ ^ 2 ∣ (P.eval (a + δ) - P.eval a - (Polynomial.derivative P).eval a * δ) := by
      intro R _ P a δ
      refine Polynomial.induction_on' P ?_ ?_
      · intro p q hp hq
        have heq : (p + q).eval (a + δ) - (p + q).eval a -
            (Polynomial.derivative (p + q)).eval a * δ =
            (p.eval (a + δ) - p.eval a - (Polynomial.derivative p).eval a * δ) +
            (q.eval (a + δ) - q.eval a - (Polynomial.derivative q).eval a * δ) := by
          simp only [Polynomial.eval_add, Polynomial.derivative_add]
          ring
        rw [heq]
        exact dvd_add hp hq
      · intro n c
        rw [← Polynomial.C_mul_X_pow_eq_monomial]
        have hder : (Polynomial.derivative (Polynomial.C c * Polynomial.X ^ n)).eval a =
            c * (n : R) * a ^ (n - 1) := by
          rcases n with _ | k
          · simp
          · rw [Polynomial.derivative_C_mul, Polynomial.derivative_X_pow, Polynomial.eval_mul,
              Polynomial.eval_C, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow,
              Polynomial.eval_X, Nat.add_sub_cancel]
            push_cast
            ring
        simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
        rw [hder]
        have hlin : c * (a + δ) ^ n - c * a ^ n - c * (n : R) * a ^ (n - 1) * δ =
            c * ((a + δ) ^ n - a ^ n - (n : R) * a ^ (n - 1) * δ) := by ring
        rw [hlin]
        exact dvd_mul_of_dvd_right (hPowTaylor a δ n) c

    have hEvalOrigin : ∀ (P : Polynomial (Polynomial E)) (q : Polynomial E),
        (P.eval q).eval 0 = (P.map ev₀).eval (q.eval 0) := by
      intro P q
      change ev₀ (P.eval₂ (RingHom.id (Polynomial E)) q) = (P.map ev₀).eval (ev₀ q)
      rw [Polynomial.hom_eval₂, RingHom.comp_id, ← Polynomial.eval_map]

    let η : ℕ → Polynomial E := fun M =>
      Nat.rec 0 (fun m η_m =>
        η_m + Polynomial.C (-u₀⁻¹ * (G.eval η_m).coeff m) * Polynomial.X ^ m) M

    have hη_succ : ∀ m : ℕ,
        η (m + 1) = η m + Polynomial.C (-u₀⁻¹ * (G.eval (η m)).coeff m) * Polynomial.X ^ m :=
      fun _ => rfl

    have hη_main : ∀ M : ℕ, (η M).eval 0 = 0 ∧ (Polynomial.X : Polynomial E) ^ M ∣ G.eval (η M) := by
      intro M
      induction M with
      | zero =>
        change (0 : Polynomial E).eval 0 = 0 ∧ (Polynomial.X : Polynomial E) ^ 0 ∣ G.eval 0
        rw [Polynomial.eval_zero, pow_zero]
        exact ⟨rfl, one_dvd _⟩
      | succ m ih =>
        obtain ⟨hη0_m, hdvd_m⟩ := ih
        rcases m with _ | k
        · have hc0 : (G.eval 0).coeff 0 = 0 := by
            rw [Polynomial.coeff_zero_eq_eval_zero, hEvalOrigin G 0, Polynomial.eval_zero]
            exact hG0
          have hη1 : η (0 + 1) = 0 := by
            rw [hη_succ 0]
            change 0 + Polynomial.C (-u₀⁻¹ * (G.eval 0).coeff 0) * Polynomial.X ^ 0 = 0
            rw [hc0, mul_zero, map_zero, zero_mul, add_zero]
          rw [hη1, Nat.zero_add, pow_one, Polynomial.eval_zero]
          exact ⟨rfl, Polynomial.X_dvd_iff.mpr hc0⟩
        · set m' := k + 1
          let c_m : E := -u₀⁻¹ * (G.eval (η m')).coeff m'
          let δ_m : Polynomial E := Polynomial.C c_m * Polynomial.X ^ m'
          have hstep : η (m' + 1) = η m' + δ_m := rfl
          have hδ0 : δ_m.eval 0 = 0 := by
            dsimp [δ_m]
            rw [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X,
              zero_pow (by omega), mul_zero]
          refine ⟨?_, ?_⟩
          · rw [hstep, Polynomial.eval_add, hη0_m, hδ0, add_zero]
          · rcases hPolyTaylor G (η m') δ_m with ⟨Q_T, hQT⟩
            have hexp : G.eval (η (m' + 1)) =
                G.eval (η m') + (Polynomial.derivative G).eval (η m') * δ_m + δ_m ^ 2 * Q_T := by
              rw [hstep]
              linear_combination hQT
            rw [Polynomial.X_pow_dvd_iff]
            intro j hj
            have hsq_dvd : (Polynomial.X : Polynomial E) ^ (2 * m') ∣ δ_m ^ 2 * Q_T := by
              refine ⟨Polynomial.C c_m ^ 2 * Q_T, ?_⟩
              dsimp [δ_m]
              ring
            have hsq_zero : (δ_m ^ 2 * Q_T).coeff j = 0 :=
              (Polynomial.X_pow_dvd_iff.mp hsq_dvd) j (by omega)
            rw [hexp, Polynomial.coeff_add, Polynomial.coeff_add, hsq_zero, add_zero]
            rcases lt_or_eq_of_le (Nat.lt_succ_iff.mp hj) with hj_lt | rfl
            · have h1 : (G.eval (η m')).coeff j = 0 :=
                (Polynomial.X_pow_dvd_iff.mp hdvd_m) j hj_lt
              have hlin_dvd : (Polynomial.X : Polynomial E) ^ m' ∣
                  (Polynomial.derivative G).eval (η m') * δ_m := by
                refine ⟨(Polynomial.derivative G).eval (η m') * Polynomial.C c_m, ?_⟩
                dsimp [δ_m]
                ring
              have h2 : ((Polynomial.derivative G).eval (η m') * δ_m).coeff j = 0 :=
                (Polynomial.X_pow_dvd_iff.mp hlin_dvd) j hj_lt
              rw [h1, h2, add_zero]
            · have hlin_coeff : ((Polynomial.derivative G).eval (η m') * δ_m).coeff m' =
                  c_m * u₀ := by
                have hcomm : (Polynomial.derivative G).eval (η m') * δ_m =
                    (Polynomial.C c_m * (Polynomial.derivative G).eval (η m')) *
                      Polynomial.X ^ m' := by
                  dsimp [δ_m]
                  ring
                have hshift : ((Polynomial.C c_m * (Polynomial.derivative G).eval (η m')) *
                    Polynomial.X ^ m').coeff (0 + m') =
                    (Polynomial.C c_m * (Polynomial.derivative G).eval (η m')).coeff 0 :=
                  Polynomial.coeff_mul_X_pow _ m' 0
                rw [zero_add] at hshift
                rw [hcomm, hshift, Polynomial.coeff_C_mul, Polynomial.coeff_zero_eq_eval_zero,
                  hEvalOrigin (Polynomial.derivative G) (η m'), hη0_m]
              rw [hlin_coeff]
              dsimp [c_m]
              have hcancel : (-u₀⁻¹ * (G.eval (η m')).coeff m') * u₀ =
                  -(G.eval (η m')).coeff m' := by
                calc (-u₀⁻¹ * (G.eval (η m')).coeff m') * u₀
                    = -(G.eval (η m')).coeff m' * (u₀⁻¹ * u₀) := by ring
                  _ = -(G.eval (η m')).coeff m' := by rw [inv_mul_cancel₀ hu₀, mul_one]
              rw [hcancel, add_neg_cancel]

    have hη0 : ∀ M : ℕ, (η M).eval 0 = 0 := fun M => (hη_main M).1
    have hG_eval : ∀ M : ℕ, (Polynomial.X : Polynomial E) ^ M ∣ G.eval (η M) :=
      fun M => (hη_main M).2

    have hη_cong : ∀ {M N : ℕ}, M ≤ N → (Polynomial.X : Polynomial E) ^ M ∣ (η N - η M) := by
      intro M N hMN
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hMN
      clear hMN
      induction d with
      | zero =>
        rw [Nat.add_zero, sub_self]
        exact dvd_zero _
      | succ d ih =>
        have hdiff : η (M + (d + 1)) - η M =
            (η (M + d) - η M) +
              Polynomial.C (-u₀⁻¹ * (G.eval (η (M + d))).coeff (M + d)) *
                Polynomial.X ^ (M + d) := by
          rw [← Nat.add_assoc, hη_succ (M + d)]
          ring
        rw [hdiff]
        refine dvd_add ih ?_
        rw [mul_comm]
        exact dvd_mul_of_dvd_left (pow_dvd_pow Polynomial.X (Nat.le_add_right M d)) _

    let L : ℕ → Polynomial (Polynomial E) := fun M => Polynomial.X - Polynomial.C (η M)
    let U : ℕ → Polynomial (Polynomial E) := fun M => G /ₘ (L M)

    have hLM_mon : ∀ M : ℕ, (L M).Monic := fun M => Polynomial.monic_X_sub_C (η M)
    have hLM_deg : ∀ M : ℕ, (L M).natDegree = 1 := fun M => Polynomial.natDegree_X_sub_C (η M)
    have hLM_deg_le : ∀ M : ℕ, (L M).degree ≤ G.degree := by
      intro M
      rw [Polynomial.degree_eq_natDegree (hLM_mon M).ne_zero,
        Polynomial.degree_eq_natDegree hMon.ne_zero, hLM_deg M, hDeg]
      exact_mod_cast (by omega : 1 ≤ D₁)

    have hU_deg : ∀ M : ℕ, (U M).natDegree = D₁ - 1 := by
      intro M
      dsimp [U]
      rw [Polynomial.natDegree_divByMonic G (hLM_mon M), hDeg, hLM_deg M]

    have hU_mon : ∀ M : ℕ, (U M).Monic := by
      intro M
      dsimp [U]
      rw [Polynomial.Monic, Polynomial.leadingCoeff_divByMonic_of_monic (hLM_mon M) (hLM_deg_le M),
        hMon.leadingCoeff]

    have hG_div : ∀ M : ℕ, G = L M * U M + Polynomial.C (G.eval (η M)) := by
      intro M
      have h1 := Polynomial.modByMonic_add_div G (L M)
      have h2 : G %ₘ L M = Polynomial.C (G.eval (η M)) :=
        Polynomial.modByMonic_X_sub_C_eq_C_eval G (η M)
      dsimp [U]
      rw [h2] at h1
      linear_combination -h1

    have hU0 : ∀ M : ℕ, ((U M).map ev₀).eval 0 = u₀ := by
      intro M
      have hder := congrArg Polynomial.derivative (hG_div M)
      have hderL : Polynomial.derivative (L M) = 1 := by
        dsimp [L]
        rw [Polynomial.derivative_sub, Polynomial.derivative_X, Polynomial.derivative_C, sub_zero]
      rw [Polynomial.derivative_add, Polynomial.derivative_mul, hderL, one_mul,
        Polynomial.derivative_C, add_zero] at hder
      have hev := congrArg (fun P : Polynomial (Polynomial E) => (P.map ev₀).eval 0) hder
      have hL0 : ((L M).map ev₀).eval 0 = 0 := by
        dsimp [L]
        rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, Polynomial.eval_sub,
          Polynomial.eval_X, Polynomial.eval_C]
        change 0 - (η M).eval 0 = 0
        rw [hη0 M, sub_zero]
      simpa only [Polynomial.map_add, Polynomial.map_mul, Polynomial.eval_add,
        Polynomial.eval_mul, hL0, zero_mul, add_zero] using hev.symm

    have hU_cong : ∀ {M N : ℕ}, M ≤ N →
        Polynomial.C ((Polynomial.X : Polynomial E) ^ M) ∣ (U N - U M) := by
      intro M N hMN
      rcases hη_cong hMN with ⟨q₁, hq₁⟩
      rcases hG_eval M with ⟨q₂, hq₂⟩
      rcases dvd_trans (pow_dvd_pow Polynomial.X hMN) (hG_eval N) with ⟨q₃, hq₃⟩
      have hLM_eq : L M = L N + Polynomial.C (Polynomial.X ^ M * q₁) := by
        dsimp [L]
        rw [← hq₁, map_sub]
        ring
      let H_diff : Polynomial (Polynomial E) := Polynomial.C q₁ * U M + Polynomial.C (q₂ - q₃)
      have hprod_eq : L N * (U N - U M) = Polynomial.C (Polynomial.X ^ M) * H_diff := by
        have hN := hG_div N
        have hM := hG_div M
        rw [hq₃, map_mul] at hN
        rw [hq₂, hLM_eq, map_mul, map_mul] at hM
        dsimp [H_diff]
        rw [map_sub]
        linear_combination hM - hN
      set Q_H := H_diff /ₘ L N
      have hH_div : H_diff = Polynomial.C (H_diff.eval (η N)) + L N * Q_H := by
        have h1 : H_diff %ₘ L N + L N * Q_H = H_diff := Polynomial.modByMonic_add_div H_diff (L N)
        have h2 : H_diff %ₘ L N = Polynomial.C (H_diff.eval (η N)) :=
          Polynomial.modByMonic_X_sub_C_eq_C_eval H_diff (η N)
        rw [h2] at h1
        exact h1.symm
      let D_poly : Polynomial (Polynomial E) :=
        U N - U M - Polynomial.C (Polynomial.X ^ M) * Q_H
      have hD_prod : L N * D_poly = Polynomial.C (Polynomial.X ^ M * H_diff.eval (η N)) := by
        dsimp [D_poly]
        rw [map_mul]
        calc L N * (U N - U M - Polynomial.C (Polynomial.X ^ M) * Q_H)
            = L N * (U N - U M) - Polynomial.C (Polynomial.X ^ M) * (L N * Q_H) := by ring
          _ = Polynomial.C (Polynomial.X ^ M) * H_diff -
                Polynomial.C (Polynomial.X ^ M) * (L N * Q_H) := by rw [hprod_eq]
          _ = Polynomial.C (Polynomial.X ^ M) * (H_diff - L N * Q_H) := by ring
          _ = Polynomial.C (Polynomial.X ^ M) * Polynomial.C (H_diff.eval (η N)) := by
                have hsub : H_diff - L N * Q_H = Polynomial.C (H_diff.eval (η N)) := by
                  linear_combination hH_div
                rw [hsub]
      have hLN_eval : (L N).eval (η N) = 0 := by
        dsimp [L]
        rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self]
      have hRem0 : Polynomial.X ^ M * H_diff.eval (η N) = 0 := by
        have hev := congrArg (Polynomial.eval (η N)) hD_prod
        rwa [Polynomial.eval_mul, hLN_eval, zero_mul, Polynomial.eval_C, eq_comm] at hev
      have hD_mul_zero : L N * D_poly = 0 := by
        rw [hD_prod, hRem0, map_zero]
      have hD_zero : D_poly = 0 := by
        by_contra hD_ne
        let d := D_poly.natDegree
        have hc_zero : (L N * D_poly).coeff (d + 1) = 0 := by
          rw [hD_mul_zero, Polynomial.coeff_zero]
        have hc_exp : (L N * D_poly).coeff (d + 1) = D_poly.coeff d := by
          dsimp [L] at *
          rw [sub_mul, Polynomial.coeff_sub, mul_comm Polynomial.X D_poly, Polynomial.coeff_mul_X,
            Polynomial.coeff_C_mul,
            Polynomial.coeff_eq_zero_of_natDegree_lt (Nat.lt_succ_self d), mul_zero, sub_zero]
        rw [hc_exp] at hc_zero
        exact (Polynomial.leadingCoeff_ne_zero.mpr hD_ne) hc_zero
      refine ⟨Q_H, ?_⟩
      dsimp [D_poly] at hD_zero
      exact sub_eq_zero.mp hD_zero

    exact ⟨η, U, hη0, hG_eval, hη_cong, hU_mon, hU_deg, hG_div, hU0, hU_cong⟩

  obtain ⟨η, U, hη0, hG_eval, hη_cong, hU_mon, hU_deg, hG_div, hU0, hU_cong⟩ := h_part1

  
  
  
  have h_part2 : ∃ (Φ : AdjoinRoot G →ₐ[E] PowerSeries E),
      ∀ (P : Polynomial (Polynomial E)) (N k : ℕ),
        k < N → PowerSeries.coeff k (Φ (AdjoinRoot.mk G P)) = (P.eval (η N)).coeff k := by
    let ι : Polynomial E →ₐ[E] PowerSeries E := Polynomial.coeToPowerSeries.algHom E
    have hι_coeff : ∀ (p : Polynomial E) (k : ℕ), PowerSeries.coeff k (ι p) = p.coeff k :=
      fun p k => Polynomial.coeff_coe p k

    let η_inf : PowerSeries E := PowerSeries.mk (fun k => (η (k + 1)).coeff k)
    let EqUpTo : ℕ → PowerSeries E → PowerSeries E → Prop :=
      fun N φ ψ => ∀ k < N, PowerSeries.coeff k φ = PowerSeries.coeff k ψ

    have hEq_η : ∀ N : ℕ, EqUpTo N η_inf (ι (η N)) := by
      intro N k hk
      rw [PowerSeries.coeff_mk, hι_coeff]
      have hdvd : (Polynomial.X : Polynomial E) ^ (k + 1) ∣ (η N - η (k + 1)) := hη_cong hk
      have hsub0 : (η N - η (k + 1)).coeff k = 0 :=
        (Polynomial.X_pow_dvd_iff.mp hdvd) k (Nat.lt_succ_self k)
      rw [Polynomial.coeff_sub] at hsub0
      exact (sub_eq_zero.mp hsub0).symm

    have hEq_add : ∀ {N : ℕ} {φ₁ φ₂ ψ₁ ψ₂ : PowerSeries E},
        EqUpTo N φ₁ ψ₁ → EqUpTo N φ₂ ψ₂ → EqUpTo N (φ₁ + φ₂) (ψ₁ + ψ₂) := by
      intro N φ₁ φ₂ ψ₁ ψ₂ h1 h2 k hk
      rw [map_add, map_add, h1 k hk, h2 k hk]

    have hEq_mul : ∀ {N : ℕ} {φ₁ φ₂ ψ₁ ψ₂ : PowerSeries E},
        EqUpTo N φ₁ ψ₁ → EqUpTo N φ₂ ψ₂ → EqUpTo N (φ₁ * φ₂) (ψ₁ * ψ₂) := by
      intro N φ₁ φ₂ ψ₁ ψ₂ h1 h2 k hk
      rw [PowerSeries.coeff_mul, PowerSeries.coeff_mul]
      refine Finset.sum_congr rfl fun p hp => ?_
      have hp_sum : p.1 + p.2 = k := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
      rw [h1 p.1 (by omega), h2 p.2 (by omega)]

    have hEq_pow : ∀ {N : ℕ} {φ ψ : PowerSeries E},
        EqUpTo N φ ψ → ∀ n : ℕ, EqUpTo N (φ ^ n) (ψ ^ n) := by
      intro N φ ψ h n
      induction n with
      | zero =>
        intro k _
        rw [pow_zero, pow_zero]
      | succ n ih =>
        rw [pow_succ, pow_succ]
        exact hEq_mul ih h

    let Ψ₀ : Polynomial (Polynomial E) →+* PowerSeries E :=
      Polynomial.eval₂RingHom ι.toRingHom η_inf

    have hΨ₀_eq : ∀ (P : Polynomial (Polynomial E)) (N : ℕ),
        EqUpTo N (Ψ₀ P) (ι (P.eval (η N))) := by
      intro P N
      have hhom : ι (P.eval (η N)) = Polynomial.eval₂RingHom ι.toRingHom (ι (η N)) P := by
        change ι.toRingHom (P.eval₂ (RingHom.id (Polynomial E)) (η N)) =
          P.eval₂ ι.toRingHom (ι.toRingHom (η N))
        rw [Polynomial.hom_eval₂, RingHom.comp_id]
      rw [hhom]
      refine Polynomial.induction_on' P ?_ ?_
      · intro p q hp hq
        change EqUpTo N (Ψ₀ (p + q)) (Polynomial.eval₂RingHom ι.toRingHom (ι (η N)) (p + q))
        rw [map_add, map_add]
        exact hEq_add hp hq
      · intro n p
        change EqUpTo N (Polynomial.eval₂ ι.toRingHom η_inf (Polynomial.monomial n p))
          (Polynomial.eval₂ ι.toRingHom (ι (η N)) (Polynomial.monomial n p))
        rw [Polynomial.eval₂_monomial, Polynomial.eval₂_monomial]
        exact hEq_mul (fun _ _ => rfl) (hEq_pow (hEq_η N) n)

    have hΨ₀_G : Polynomial.eval₂ (↑ι) η_inf G = 0 := by
      apply PowerSeries.ext
      intro k
      rw [map_zero]
      have hcoeff : PowerSeries.coeff k (Ψ₀ G) = (G.eval (η (k + 1))).coeff k := by
        rw [hΨ₀_eq G (k + 1) k (Nat.lt_succ_self k), hι_coeff]
      change PowerSeries.coeff k (Ψ₀ G) = 0
      rw [hcoeff]
      exact (Polynomial.X_pow_dvd_iff.mp (hG_eval (k + 1))) k (Nat.lt_succ_self k)

    let Φ : AdjoinRoot G →ₐ[E] PowerSeries E := AdjoinRoot.liftAlgHom G ι η_inf hΨ₀_G
    refine ⟨Φ, fun P N k hk => ?_⟩
    rw [AdjoinRoot.liftAlgHom_mk]
    change PowerSeries.coeff k (Ψ₀ P) = (P.eval (η N)).coeff k
    rw [hΨ₀_eq P N k hk, hι_coeff]

  obtain ⟨Φ, hΦ_coeff⟩ := h_part2

  
  
  
  have h_part3 : ∃ (W : ℕ → Submodule E (AdjoinRoot G)),
      ((1 : AdjoinRoot G) ∈ W 0) ∧
      (∀ (m₁ m₂ : ℕ) {u v : AdjoinRoot G}, u ∈ W m₁ → v ∈ W m₂ → u * v ∈ W (m₁ + m₂)) ∧
      (∀ (M : ℕ), D₁ - 1 ≤ M → M + 1 ≤ Module.finrank E (W M) + g₁) ∧
      (∀ (M : ℕ) (u : AdjoinRoot G),
        u ∈ W M →
        (∀ (i j : ℕ), M < i + j → (((AdjoinRoot.modByMonicHom hMon u).coeff i).coeff j = 0)) ∧
        Polynomial.C ((Polynomial.X : Polynomial E) ^ M) ∣
          ((AdjoinRoot.modByMonicHom hMon u) %ₘ U (M + 1))) := by
    have hG_ne_one : G ≠ 1 := by
      intro h1
      have hd := congrArg Polynomial.natDegree h1
      rw [hDeg, Polynomial.natDegree_one] at hd
      omega

    have hU_ne_one : ∀ M : ℕ, U M ≠ 1 := by
      intro M h1
      have hd := congrArg Polynomial.natDegree h1
      rw [hU_deg M, Polynomial.natDegree_one] at hd
      omega

    have hCoeff_one_ne0 : ∀ {R : Type u} [Semiring R] {k : ℕ},
        k ≠ 0 → (1 : Polynomial R).coeff k = 0 := by
      intro R _ k hk
      rw [← Polynomial.C_1, Polynomial.coeff_C]
      simp [hk]

    let coeff1 : ℕ → Polynomial (Polynomial E) →ₗ[E] Polynomial E :=
      fun i => (Polynomial.lcoeff (Polynomial E) i).restrictScalars E
    let coeff2 : ℕ → ℕ → Polynomial (Polynomial E) →ₗ[E] E :=
      fun i j => (Polynomial.lcoeff E j).comp (coeff1 i)

    have hcoeff1_apply : ∀ (i : ℕ) (P : Polynomial (Polynomial E)), coeff1 i P = P.coeff i :=
      fun _ _ => rfl
    have hcoeff2_apply : ∀ (i j : ℕ) (P : Polynomial (Polynomial E)),
        coeff2 i j P = (P.coeff i).coeff j :=
      fun _ _ _ => rfl

    let HasWtdDeg : ℕ → Polynomial (Polynomial E) → Prop :=
      fun M P => ∀ i j : ℕ, M < i + j → (P.coeff i).coeff j = 0

    have hWtd_zero : ∀ M : ℕ, HasWtdDeg M 0 := fun _ _ _ _ => by simp

    have hWtd_add : ∀ {M : ℕ} {P Q : Polynomial (Polynomial E)},
        HasWtdDeg M P → HasWtdDeg M Q → HasWtdDeg M (P + Q) := by
      intro M P Q hP hQ i j hij
      rw [← hcoeff2_apply, map_add, hcoeff2_apply, hcoeff2_apply, hP i j hij, hQ i j hij, add_zero]

    have hWtd_neg : ∀ {M : ℕ} {P : Polynomial (Polynomial E)},
        HasWtdDeg M P → HasWtdDeg M (-P) := by
      intro M P hP i j hij
      rw [← hcoeff2_apply, map_neg, hcoeff2_apply, hP i j hij, neg_zero]

    have hWtd_sub : ∀ {M : ℕ} {P Q : Polynomial (Polynomial E)},
        HasWtdDeg M P → HasWtdDeg M Q → HasWtdDeg M (P - Q) := by
      intro M P Q hP hQ
      rw [sub_eq_add_neg]
      exact hWtd_add hP (hWtd_neg hQ)

    have hWtd_smul : ∀ {M : ℕ} (c : E) {P : Polynomial (Polynomial E)},
        HasWtdDeg M P → HasWtdDeg M (c • P) := by
      intro M c P hP i j hij
      rw [← hcoeff2_apply, map_smul, hcoeff2_apply, hP i j hij, smul_zero]

    have hWtd_sum : ∀ {α : Type} (s : Finset α) (M : ℕ) (f : α → Polynomial (Polynomial E)),
        (∀ x ∈ s, HasWtdDeg M (f x)) → HasWtdDeg M (∑ x ∈ s, f x) := by
      intro α s M f hf
      induction s using Finset.cons_induction with
      | empty =>
        rw [Finset.sum_empty]
        exact hWtd_zero M
      | cons a s ha ih =>
        rw [Finset.sum_cons]
        exact hWtd_add (hf a (Finset.mem_cons_self a s))
          (ih (fun x hx => hf x (Finset.mem_cons.mpr (Or.inr hx))))

    have hWtd_mul : ∀ {m₁ m₂ : ℕ} {P₁ P₂ : Polynomial (Polynomial E)},
        HasWtdDeg m₁ P₁ → HasWtdDeg m₂ P₂ → HasWtdDeg (m₁ + m₂) (P₁ * P₂) := by
      intro m₁ m₂ P₁ P₂ h₁ h₂ i j hij
      rw [Polynomial.coeff_mul, Polynomial.finsetSum_coeff]
      refine Finset.sum_eq_zero fun p hp => ?_
      have hp_eq : p.1 + p.2 = i := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
      rw [Polynomial.coeff_mul]
      refine Finset.sum_eq_zero fun q hq => ?_
      have hq_eq : q.1 + q.2 = j := Finset.HasAntidiagonal.mem_antidiagonal.mp hq
      by_cases hleft : m₁ < p.1 + q.1
      · rw [h₁ p.1 q.1 hleft, zero_mul]
      · have hright : m₂ < p.2 + q.2 := by omega
        rw [h₂ p.2 q.2 hright, mul_zero]

    have hMod_self_of_coeff_zero : ∀ {B P : Polynomial (Polynomial E)},
        B.Monic → (∀ i : ℕ, B.natDegree ≤ i → P.coeff i = 0) → P %ₘ B = P := by
      intro B P hB hP
      by_cases hP0 : P = 0
      · rw [hP0, Polynomial.zero_modByMonic]
      · apply (Polynomial.modByMonic_eq_self_iff hB).mpr
        rw [Polynomial.degree_eq_natDegree hP0, Polynomial.degree_eq_natDegree hB.ne_zero]
        have hlt : P.natDegree < B.natDegree := by
          by_contra hge
          have hlc : P.coeff P.natDegree = 0 := hP P.natDegree (le_of_not_gt hge)
          exact (Polynomial.leadingCoeff_ne_zero.mpr hP0) hlc
        exact_mod_cast hlt

    have hPoly_eq_sum_lt : ∀ (d : ℕ) (P : Polynomial (Polynomial E)),
        (∀ i : ℕ, d ≤ i → P.coeff i = 0) →
        P = ∑ i ∈ Finset.range d, Polynomial.monomial i (P.coeff i) := by
      intro d P hP
      ext i j
      rw [Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_monomial]
      by_cases hi : i < d
      · rw [Finset.sum_eq_single i]
        · simp
        · intro b _ hbi; simp [hbi]
        · intro hnot; exact absurd (Finset.mem_range.mpr hi) hnot
      · rw [hP i (le_of_not_gt hi), Finset.sum_eq_zero]
        intro b hb
        have hbi : b ≠ i := by
          have hbd := Finset.mem_range.mp hb
          omega
        simp [hbi]

    let G_low : Polynomial (Polynomial E) :=
      ∑ a ∈ Finset.range D₁, Polynomial.monomial a (G.coeff a)

    have hG_eq_low : G = G_low + Polynomial.X ^ D₁ := by
      ext i j
      rw [Polynomial.coeff_add]
      dsimp [G_low]
      rw [Polynomial.finsetSum_coeff, Polynomial.coeff_X_pow]
      simp only [Polynomial.coeff_monomial]
      rcases lt_trichotomy i D₁ with hlt | rfl | hgt
      · have hne : ¬ (i = D₁) := by omega
        simp only [hne, ↓reduceIte, add_zero]
        rw [Finset.sum_eq_single i]
        · simp
        · intro b _ hbi; simp [hbi]
        · intro hnot; exact absurd (Finset.mem_range.mpr hlt) hnot
      · simp only [↓reduceIte]
        have hsum0 : (∑ x ∈ Finset.range i, if x = i then G.coeff x else 0) = 0 := by
          refine Finset.sum_eq_zero fun b hb => ?_
          have hbi : b ≠ i := ne_of_lt (Finset.mem_range.mp hb)
          simp [hbi]
        rw [hsum0, zero_add]
        have hlc : G.coeff i = 1 := by
          have h := hMon.leadingCoeff
          rwa [Polynomial.leadingCoeff, hDeg] at h
        rw [hlc]
      · have hne : ¬ (i = D₁) := by omega
        simp only [hne, ↓reduceIte, add_zero]
        have h0 : G.coeff i = 0 :=
          Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [hDeg]; exact hgt)
        rw [h0, Finset.sum_eq_zero]
        intro b hb
        have hbi : b ≠ i := by
          have hbd := Finset.mem_range.mp hb
          omega
        simp [hbi]

    have hGlow_coeff_ge : ∀ i : ℕ, D₁ ≤ i → G_low.coeff i = 0 := by
      intro i hi
      dsimp [G_low]
      rw [Polynomial.finsetSum_coeff]
      refine Finset.sum_eq_zero fun a ha => ?_
      have hai : a ≠ i := by
        have had := Finset.mem_range.mp ha
        omega
      simp [Polynomial.coeff_monomial, hai]

    have hGlow_wtd : HasWtdDeg D₁ G_low := by
      intro i j hij
      by_cases hi : i < D₁
      · dsimp [G_low]
        rw [Polynomial.finsetSum_coeff, Finset.sum_eq_single i]
        · rw [Polynomial.coeff_monomial_same]
          exact hTri i j hij
        · intro b _ hbi; simp [Polynomial.coeff_monomial, hbi]
        · intro hnot; exact absurd (Finset.mem_range.mpr hi) hnot
      · rw [hGlow_coeff_ge i (le_of_not_gt hi), Polynomial.coeff_zero]

    have hYD₁_mod : (Polynomial.X ^ D₁ : Polynomial (Polynomial E)) %ₘ G = -G_low := by
      have hsplit : (Polynomial.X ^ D₁ : Polynomial (Polynomial E)) = -G_low + G * 1 := by
        rw [hG_eq_low]
        ring
      have hlow_mod : (-G_low) %ₘ G = -G_low := by
        refine hMod_self_of_coeff_zero hMon (fun i hi => ?_)
        rw [hDeg] at hi
        rw [Polynomial.coeff_neg, hGlow_coeff_ge i hi, neg_zero]
      rw [hsplit, Polynomial.add_modByMonic,
        (Polynomial.modByMonic_eq_zero_iff_dvd hMon).mpr ⟨1, rfl⟩, add_zero, hlow_mod]

    have hSum_modByMonic : ∀ {α : Type} (s : Finset α) (B : Polynomial (Polynomial E))
        (f : α → Polynomial (Polynomial E)),
        (∑ x ∈ s, f x) %ₘ B = ∑ x ∈ s, (f x %ₘ B) := by
      intro α s B f
      induction s using Finset.cons_induction with
      | empty =>
        rw [Finset.sum_empty, Finset.sum_empty, Polynomial.zero_modByMonic]
      | cons a s ha ih =>
        rw [Finset.sum_cons, Finset.sum_cons, Polynomial.add_modByMonic, ih]

    have hC_mul_modByMonic : ∀ (B : Polynomial (Polynomial E)) (p : Polynomial E)
        (P : Polynomial (Polynomial E)),
        (Polynomial.C p * P) %ₘ B = Polynomial.C p * (P %ₘ B) := by
      intro B p P
      rw [← Polynomial.smul_eq_C_mul, Polynomial.smul_modByMonic, Polynomial.smul_eq_C_mul]

    have hWtd_Ypow_mod : ∀ k : ℕ,
        HasWtdDeg k (((Polynomial.X : Polynomial (Polynomial E)) ^ k) %ₘ G) := by
      intro k
      induction k with
      | zero =>
        have h0 : ((Polynomial.X : Polynomial (Polynomial E)) ^ 0) %ₘ G = 1 := by
          rw [pow_zero]
          refine hMod_self_of_coeff_zero hMon (fun i hi => ?_)
          rw [hDeg] at hi
          exact hCoeff_one_ne0 (by omega)
        rw [h0]
        intro i j hij
        rcases Nat.eq_zero_or_pos i with rfl | hi_pos
        · rw [Polynomial.coeff_one_zero]
          exact hCoeff_one_ne0 (by omega)
        · rw [hCoeff_one_ne0 (by omega), Polynomial.coeff_zero]
      | succ k ih =>
        by_cases hk : k + 1 < D₁
        · have hself : ((Polynomial.X : Polynomial (Polynomial E)) ^ (k + 1)) %ₘ G =
              Polynomial.X ^ (k + 1) := by
            refine hMod_self_of_coeff_zero hMon (fun i hi => ?_)
            rw [hDeg] at hi
            rw [Polynomial.coeff_X_pow]
            have hne : ¬ (i = k + 1) := by omega
            simp [hne]
          rw [hself]
          intro i j hij
          rw [Polynomial.coeff_X_pow]
          split_ifs with heq
          · subst heq
            exact hCoeff_one_ne0 (by omega)
          · exact Polynomial.coeff_zero j
        · have hk_ge : D₁ - 1 ≤ k := by omega
          set R_k := ((Polynomial.X : Polynomial (Polynomial E)) ^ k) %ₘ G
          have hRk_deg : R_k.natDegree < D₁ := by
            rw [← hDeg]
            exact Polynomial.natDegree_modByMonic_lt _ hMon hG_ne_one
          have hRk_coeff_ge : ∀ i : ℕ, D₁ ≤ i → R_k.coeff i = 0 :=
            fun i hi => Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_lt_of_le hRk_deg hi)
          have hStep_mod : ((Polynomial.X : Polynomial (Polynomial E)) ^ (k + 1)) %ₘ G =
              (Polynomial.X * R_k) %ₘ G := by
            set Q_k := ((Polynomial.X : Polynomial (Polynomial E)) ^ k) /ₘ G
            have hdiv : R_k + G * Q_k = Polynomial.X ^ k :=
              Polynomial.modByMonic_add_div _ G
            have hmul : (Polynomial.X : Polynomial (Polynomial E)) ^ (k + 1) =
                Polynomial.X * R_k + G * (Polynomial.X * Q_k) := by
              rw [pow_succ']
              linear_combination (Polynomial.X : Polynomial (Polynomial E)) * hdiv.symm
            rw [hmul, Polynomial.add_modByMonic,
              (Polynomial.modByMonic_eq_zero_iff_dvd hMon).mpr ⟨_, rfl⟩, add_zero]
          have hD₁_split : D₁ = (D₁ - 1) + 1 := (Nat.sub_add_cancel (by omega)).symm
          have hRk_sum : R_k =
              (∑ r ∈ Finset.range (D₁ - 1), Polynomial.monomial r (R_k.coeff r)) +
                Polynomial.monomial (D₁ - 1) (R_k.coeff (D₁ - 1)) := by
            have h1 := hPoly_eq_sum_lt D₁ R_k hRk_coeff_ge
            conv_lhs => rw [h1, hD₁_split, Finset.sum_range_succ]
          let A_k : Polynomial (Polynomial E) :=
            ∑ r ∈ Finset.range (D₁ - 1), Polynomial.monomial (r + 1) (R_k.coeff r)
          have hYRk : Polynomial.X * R_k =
              A_k + Polynomial.C (R_k.coeff (D₁ - 1)) * Polynomial.X ^ D₁ := by
            conv_lhs => rw [hRk_sum]
            rw [mul_add, Finset.mul_sum]
            refine congrArg₂ (· + ·) ?_ ?_
            · refine Finset.sum_congr rfl fun r _ => ?_
              rw [← Polynomial.C_mul_X_pow_eq_monomial, ← Polynomial.C_mul_X_pow_eq_monomial,
                pow_succ]
              ring
            · have hpowD₁ : (Polynomial.X : Polynomial (Polynomial E)) ^ D₁ =
                  Polynomial.X * Polynomial.X ^ (D₁ - 1) := by
                conv_lhs => rw [hD₁_split]
                rw [pow_succ']
              rw [← Polynomial.C_mul_X_pow_eq_monomial, hpowD₁]
              ring
          have hAk_mod : A_k %ₘ G = A_k := by
            refine hMod_self_of_coeff_zero hMon (fun i hi => ?_)
            rw [hDeg] at hi
            dsimp [A_k]
            rw [Polynomial.finsetSum_coeff]
            refine Finset.sum_eq_zero fun r hr => ?_
            have hri : r + 1 ≠ i := by
              have hrd := Finset.mem_range.mp hr
              omega
            simp [Polynomial.coeff_monomial, hri]
          have hNext_eq : ((Polynomial.X : Polynomial (Polynomial E)) ^ (k + 1)) %ₘ G =
              A_k - Polynomial.C (R_k.coeff (D₁ - 1)) * G_low := by
            rw [hStep_mod, hYRk, Polynomial.add_modByMonic, hAk_mod, hC_mul_modByMonic, hYD₁_mod]
            ring
          rw [hNext_eq]
          refine hWtd_sub ?_ ?_
          · refine hWtd_sum (Finset.range (D₁ - 1)) (k + 1) _ (fun r _ i j hij => ?_)
            rw [Polynomial.coeff_monomial]
            split_ifs with hri
            · subst hri
              exact ih r j (by omega)
            · exact Polynomial.coeff_zero j
          · have hC_wtd : HasWtdDeg (k + 1 - D₁) (Polynomial.C (R_k.coeff (D₁ - 1))) := by
              intro i j hij
              rcases Nat.eq_zero_or_pos i with rfl | hi_pos
              · rw [Polynomial.coeff_C_zero]
                exact ih (D₁ - 1) j (by omega)
              · rw [Polynomial.coeff_C_of_ne_zero (by omega), Polynomial.coeff_zero]
            have hsum_deg : (k + 1 - D₁) + D₁ = k + 1 := Nat.sub_add_cancel (by omega)
            rw [← hsum_deg]
            exact hWtd_mul hC_wtd hGlow_wtd

    have hWtd_modByMonic : ∀ {M : ℕ} {P : Polynomial (Polynomial E)},
        HasWtdDeg M P → HasWtdDeg M (P %ₘ G) := by
      intro M P hP
      have hP_sum : P = ∑ k ∈ Finset.range (P.natDegree + 1),
          Polynomial.C (P.coeff k) * Polynomial.X ^ k := by
        have h1 := hPoly_eq_sum_lt (P.natDegree + 1) P
          (fun i hi => Polynomial.coeff_eq_zero_of_natDegree_lt hi)
        conv_lhs => rw [h1]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [Polynomial.C_mul_X_pow_eq_monomial]
      have hmod_sum : P %ₘ G = ∑ k ∈ Finset.range (P.natDegree + 1),
          Polynomial.C (P.coeff k) * (((Polynomial.X : Polynomial (Polynomial E)) ^ k) %ₘ G) := by
        conv_lhs => rw [hP_sum]
        rw [hSum_modByMonic]
        refine Finset.sum_congr rfl fun k _ => hC_mul_modByMonic G (P.coeff k) (Polynomial.X ^ k)
      rw [hmod_sum]
      refine hWtd_sum (Finset.range (P.natDegree + 1)) M _ (fun k _ => ?_)
      by_cases hk : k ≤ M
      · have hC_wtd : HasWtdDeg (M - k) (Polynomial.C (P.coeff k)) := by
          intro i j hij
          rcases Nat.eq_zero_or_pos i with rfl | hi_pos
          · rw [Polynomial.coeff_C_zero]
            exact hP k j (by omega)
          · rw [Polynomial.coeff_C_of_ne_zero (by omega), Polynomial.coeff_zero]
        have hsum_eq : (M - k) + k = M := Nat.sub_add_cancel hk
        rw [← hsum_eq]
        exact hWtd_mul hC_wtd (hWtd_Ypow_mod k)
      · have hc0 : P.coeff k = 0 := by
          ext j
          rw [Polynomial.coeff_zero]
          exact hP k j (by omega)
        rw [hc0, map_zero, zero_mul]
        exact hWtd_zero M

    let V_M : ℕ → Submodule E (Polynomial (Polynomial E)) := fun M =>
      { carrier := { F | (∀ i : ℕ, D₁ ≤ i → F.coeff i = 0) ∧ HasWtdDeg M F }
        zero_mem' := ⟨fun _ _ => Polynomial.coeff_zero _, hWtd_zero M⟩
        add_mem' := fun {F₁ F₂} h₁ h₂ =>
          ⟨fun i hi => by rw [Polynomial.coeff_add, h₁.1 i hi, h₂.1 i hi, add_zero],
           hWtd_add h₁.2 h₂.2⟩
        smul_mem' := fun c {F} h =>
          ⟨fun i hi => by rw [← hcoeff1_apply, map_smul, hcoeff1_apply, h.1 i hi, smul_zero],
           hWtd_smul c h.2⟩ }

    let modU_E : ∀ M : ℕ, Polynomial (Polynomial E) →ₗ[E] Polynomial (Polynomial E) :=
      fun M =>
        { toFun := fun P => P %ₘ U M
          map_add' := fun P Q => Polynomial.add_modByMonic P Q
          map_smul' := fun c P => by
            dsimp only [RingHom.id_apply]
            rw [← IsScalarTower.algebraMap_smul (Polynomial E) c P,
              Polynomial.smul_modByMonic,
              IsScalarTower.algebraMap_smul (Polynomial E) c (P %ₘ U M)] }

    have hmodU_apply : ∀ (M : ℕ) (P : Polynomial (Polynomial E)),
        modU_E M P = P %ₘ U M := fun _ _ => rfl

    let Λ_M : ∀ M : ℕ, V_M M →ₗ[E] (Fin (D₁ - 1) × Fin M → E) :=
      fun M => LinearMap.pi (fun p =>
        (coeff2 p.1.1 p.2.1).comp ((modU_E M).comp (V_M M).subtype))

    let mkE : Polynomial (Polynomial E) →ₗ[E] AdjoinRoot G :=
      { toFun := AdjoinRoot.mk G
        map_add' := map_add (AdjoinRoot.mk G)
        map_smul' := fun c P => by
          dsimp only [RingHom.id_apply]
          rw [← IsScalarTower.algebraMap_smul (Polynomial E) c P,
            Polynomial.smul_eq_C_mul, map_mul]
          have hC : AdjoinRoot.mk G (Polynomial.C (algebraMap E (Polynomial E) c)) =
              algebraMap (Polynomial E) (AdjoinRoot G) (algebraMap E (Polynomial E) c) := rfl
          rw [hC, ← Algebra.smul_def,
            IsScalarTower.algebraMap_smul (Polynomial E) c (AdjoinRoot.mk G P)] }

    let repE : AdjoinRoot G →ₗ[E] Polynomial (Polynomial E) :=
      (AdjoinRoot.modByMonicHom hMon).restrictScalars E

    have hrep_spec : ∀ u : AdjoinRoot G,
        (∀ i : ℕ, D₁ ≤ i → (repE u).coeff i = 0) ∧ AdjoinRoot.mk G (repE u) = u := by
      intro u
      obtain ⟨P, rfl⟩ := AdjoinRoot.mk_surjective u
      have hrep_mk : repE (AdjoinRoot.mk G P) = P %ₘ G :=
        AdjoinRoot.modByMonicHom_mk hMon P
      rw [hrep_mk]
      refine ⟨fun i hi => ?_, ?_⟩
      · have hlt : (P %ₘ G).natDegree < D₁ := by
          rw [← hDeg]
          exact Polynomial.natDegree_modByMonic_lt P hMon hG_ne_one
        exact Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_lt_of_le hlt hi)
      · conv_rhs => rw [← Polynomial.modByMonic_add_div P G]
        rw [map_add, map_mul, AdjoinRoot.mk_self, zero_mul, add_zero]

    let mkV_M : ∀ M : ℕ, V_M M →ₗ[E] AdjoinRoot G :=
      fun M => mkE.comp (V_M M).subtype

    have hrep_mkV : ∀ (M : ℕ) (F : V_M M), repE (mkV_M M F) = F.1 := by
      intro M F
      change AdjoinRoot.modByMonicHom hMon (AdjoinRoot.mk G F.1) = F.1
      rw [AdjoinRoot.modByMonicHom_mk hMon F.1]
      refine hMod_self_of_coeff_zero hMon (fun i hi => ?_)
      rw [hDeg] at hi
      exact F.2.1 i hi

    have hmkV_inj : ∀ M : ℕ, Function.Injective (mkV_M M) := by
      intro M F₁ F₂ heq
      apply Subtype.ext
      have h := congrArg repE heq
      rwa [hrep_mkV M F₁, hrep_mkV M F₂] at h

    let mkKer_M : ∀ M : ℕ, LinearMap.ker (Λ_M M) →ₗ[E] AdjoinRoot G :=
      fun M => (mkV_M M).comp (LinearMap.ker (Λ_M M)).subtype

    let W : ℕ → Submodule E (AdjoinRoot G) :=
      fun M => LinearMap.range (mkKer_M M)

    have hKer_iff_dvd : ∀ (M : ℕ) (F : V_M M),
        F ∈ LinearMap.ker (Λ_M M) ↔
          Polynomial.C ((Polynomial.X : Polynomial E) ^ M) ∣ (F.1 %ₘ U M) := by
      intro M F
      rw [LinearMap.mem_ker]
      have hrem_deg : (F.1 %ₘ U M).natDegree < D₁ - 1 := by
        rw [← hU_deg M]
        exact Polynomial.natDegree_modByMonic_lt F.1 (hU_mon M) (hU_ne_one M)
      have hrem_ge : ∀ i : ℕ, D₁ - 1 ≤ i → (F.1 %ₘ U M).coeff i = 0 :=
        fun i hi => Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_lt_of_le hrem_deg hi)
      constructor
      · intro hker
        have hdvd_coeff : ∀ i : ℕ, (Polynomial.X : Polynomial E) ^ M ∣ (F.1 %ₘ U M).coeff i := by
          intro i
          by_cases hi : i < D₁ - 1
          · rw [Polynomial.X_pow_dvd_iff]
            intro j hj
            have hp := congrFun hker (⟨i, hi⟩, ⟨j, hj⟩)
            simpa [Λ_M, hmodU_apply, hcoeff2_apply] using hp
          · rw [hrem_ge i (le_of_not_gt hi)]
            exact dvd_zero _
        let q_fn : ℕ → Polynomial E := fun i => Classical.choose (hdvd_coeff i)
        have hq_fn : ∀ i : ℕ, (F.1 %ₘ U M).coeff i = Polynomial.X ^ M * q_fn i :=
          fun i => Classical.choose_spec (hdvd_coeff i)
        refine ⟨∑ i ∈ Finset.range (D₁ - 1), Polynomial.monomial i (q_fn i), ?_⟩
        ext i j
        rw [Polynomial.coeff_C_mul, Polynomial.finsetSum_coeff]
        simp only [Polynomial.coeff_monomial]
        by_cases hi : i < D₁ - 1
        · rw [Finset.sum_eq_single i]
          · simp [hq_fn i]
          · intro b _ hbi; simp [hbi]
          · intro hnot; exact absurd (Finset.mem_range.mpr hi) hnot
        · rw [hrem_ge i (le_of_not_gt hi), Finset.sum_eq_zero, mul_zero]
          intro b hb
          have hbi : b ≠ i := by
            have hbd := Finset.mem_range.mp hb
            omega
          simp [hbi]
      · rintro ⟨H, hH⟩
        funext p
        have hc : (F.1 %ₘ U M).coeff p.1.1 = Polynomial.X ^ M * H.coeff p.1.1 := by
          rw [hH, Polynomial.coeff_C_mul]
        have hj0 : ((F.1 %ₘ U M).coeff p.1.1).coeff p.2.1 = 0 :=
          (Polynomial.X_pow_dvd_iff.mp ⟨H.coeff p.1.1, hc⟩) p.2.1 p.2.2
        simpa [Λ_M, hmodU_apply, hcoeff2_apply] using hj0

    have hMem_W_iff : ∀ (M : ℕ) (u : AdjoinRoot G),
        u ∈ W M ↔
          HasWtdDeg M (repE u) ∧
          Polynomial.C ((Polynomial.X : Polynomial E) ^ M) ∣ ((repE u) %ₘ U M) := by
      intro M u
      dsimp [W, mkKer_M]
      rw [LinearMap.mem_range]
      constructor
      · rintro ⟨⟨F, hF_ker⟩, rfl⟩
        change HasWtdDeg M (repE (mkV_M M F)) ∧
          Polynomial.C ((Polynomial.X : Polynomial E) ^ M) ∣ ((repE (mkV_M M F)) %ₘ U M)
        rw [hrep_mkV M F]
        exact ⟨F.2.2, (hKer_iff_dvd M F).mp hF_ker⟩
      · rintro ⟨hWtd, hdvd⟩
        obtain ⟨hdeg_ge, hmk⟩ := hrep_spec u
        let F : V_M M := ⟨repE u, hdeg_ge, hWtd⟩
        refine ⟨⟨F, (hKer_iff_dvd M F).mpr hdvd⟩, ?_⟩
        exact hmk

    have hLevelRaise : ∀ {M N : ℕ} (P : Polynomial (Polynomial E)),
        M ≤ N →
        Polynomial.C ((Polynomial.X : Polynomial E) ^ M) ∣ (P %ₘ U M) →
        Polynomial.C ((Polynomial.X : Polynomial E) ^ M) ∣ (P %ₘ U N) := by
      intro M N P hMN hdvd
      rcases hdvd with ⟨R_M, hRM⟩
      rcases hU_cong hMN with ⟨Δ, hΔ⟩
      set Q_M := P /ₘ U M
      have hdiv : P %ₘ U M + U M * Q_M = P := Polynomial.modByMonic_add_div P (U M)
      have hP_sub : P = P %ₘ U M + U M * Q_M := hdiv.symm
      have hUM_eq : U M = U N - Polynomial.C (Polynomial.X ^ M) * Δ := by
        linear_combination -hΔ
      have hP_eq : P = U N * Q_M +
          Polynomial.C ((Polynomial.X : Polynomial E) ^ M) * (R_M - Δ * Q_M) := by
        calc P = P %ₘ U M + U M * Q_M := hP_sub
          _ = Polynomial.C (Polynomial.X ^ M) * R_M +
                (U N - Polynomial.C (Polynomial.X ^ M) * Δ) * Q_M := by rw [hRM, hUM_eq]
          _ = U N * Q_M + Polynomial.C (Polynomial.X ^ M) * (R_M - Δ * Q_M) := by ring
      have hmodN : P %ₘ U N =
          Polynomial.C ((Polynomial.X : Polynomial E) ^ M) * ((R_M - Δ * Q_M) %ₘ U N) := by
        conv_lhs => rw [hP_eq]
        rw [Polynomial.add_modByMonic,
          (Polynomial.modByMonic_eq_zero_iff_dvd (hU_mon N)).mpr ⟨Q_M, rfl⟩, zero_add,
          hC_mul_modByMonic]
      exact ⟨(R_M - Δ * Q_M) %ₘ U N, hmodN⟩

    have hW0 : (1 : AdjoinRoot G) ∈ W 0 := by
      rw [hMem_W_iff]
      have hrep1 : repE 1 = 1 := by
        change AdjoinRoot.modByMonicHom hMon (AdjoinRoot.mk G 1) = 1
        rw [AdjoinRoot.modByMonicHom_mk hMon 1]
        refine hMod_self_of_coeff_zero hMon (fun i hi => ?_)
        rw [hDeg] at hi
        exact hCoeff_one_ne0 (by omega)
      rw [hrep1, pow_zero, map_one]
      refine ⟨?_, one_dvd _⟩
      intro i j hij
      rcases Nat.eq_zero_or_pos i with rfl | hi_pos
      · rw [Polynomial.coeff_one_zero]
        exact hCoeff_one_ne0 (by omega)
      · rw [hCoeff_one_ne0 (by omega), Polynomial.coeff_zero]

    have hWmul : ∀ (m₁ m₂ : ℕ) {u v : AdjoinRoot G},
        u ∈ W m₁ → v ∈ W m₂ → u * v ∈ W (m₁ + m₂) := by
      intro m₁ m₂ u v hu hv
      obtain ⟨hWtd₁, hdvd₁⟩ := (hMem_W_iff m₁ u).mp hu
      obtain ⟨hWtd₂, hdvd₂⟩ := (hMem_W_iff m₂ v).mp hv
      set N := m₁ + m₂
      set F₁ := repE u
      set F₂ := repE v
      have hrep_uv : repE (u * v) = (F₁ * F₂) %ₘ G := by
        conv_lhs => rw [← (hrep_spec u).2, ← (hrep_spec v).2, ← map_mul]
        exact AdjoinRoot.modByMonicHom_mk hMon (F₁ * F₂)
      rw [hMem_W_iff, hrep_uv]
      refine ⟨hWtd_modByMonic (hWtd_mul hWtd₁ hWtd₂), ?_⟩
      rcases hLevelRaise F₁ (Nat.le_add_right m₁ m₂) hdvd₁ with ⟨H₁, hH₁⟩
      rcases hLevelRaise F₂ (Nat.le_add_left m₂ m₁) hdvd₂ with ⟨H₂, hH₂⟩
      set Q₁ := F₁ /ₘ U N
      set Q₂ := F₂ /ₘ U N
      have hF₁_eq : F₁ = U N * Q₁ + Polynomial.C ((Polynomial.X : Polynomial E) ^ m₁) * H₁ := by
        have hdiv : F₁ %ₘ U N + U N * Q₁ = F₁ := Polynomial.modByMonic_add_div F₁ (U N)
        rw [hH₁] at hdiv
        linear_combination -hdiv
      have hF₂_eq : F₂ = U N * Q₂ + Polynomial.C ((Polynomial.X : Polynomial E) ^ m₂) * H₂ := by
        have hdiv : F₂ %ₘ U N + U N * Q₂ = F₂ := Polynomial.modByMonic_add_div F₂ (U N)
        rw [hH₂] at hdiv
        linear_combination -hdiv
      rcases hG_eval N with ⟨e_N, he_N⟩
      let L_N : Polynomial (Polynomial E) := Polynomial.X - Polynomial.C (η N)
      have hG_UN : G = U N * L_N +
          Polynomial.C ((Polynomial.X : Polynomial E) ^ N) * Polynomial.C e_N := by
        have h := hG_div N
        rw [he_N, map_mul] at h
        dsimp [L_N]
        linear_combination h
      set Q_G := (F₁ * F₂) /ₘ G
      have hRem_sub : (F₁ * F₂) %ₘ G = F₁ * F₂ - G * Q_G :=
        eq_sub_of_add_eq (Polynomial.modByMonic_add_div (F₁ * F₂) G)
      have hprod12 : F₁ * F₂ =
          U N * (Q₁ * (U N * Q₂ + Polynomial.C ((Polynomial.X : Polynomial E) ^ m₂) * H₂) +
            Polynomial.C ((Polynomial.X : Polynomial E) ^ m₁) * H₁ * Q₂) +
          Polynomial.C ((Polynomial.X : Polynomial E) ^ N) * (H₁ * H₂) := by
        calc F₁ * F₂
            = (U N * Q₁ + Polynomial.C ((Polynomial.X : Polynomial E) ^ m₁) * H₁) *
                (U N * Q₂ + Polynomial.C ((Polynomial.X : Polynomial E) ^ m₂) * H₂) := by
                rw [← hF₁_eq, ← hF₂_eq]
          _ = U N * (Q₁ * (U N * Q₂ + Polynomial.C ((Polynomial.X : Polynomial E) ^ m₂) * H₂) +
                Polynomial.C ((Polynomial.X : Polynomial E) ^ m₁) * H₁ * Q₂) +
              (Polynomial.C ((Polynomial.X : Polynomial E) ^ m₁) *
                Polynomial.C ((Polynomial.X : Polynomial E) ^ m₂)) * (H₁ * H₂) := by ring
          _ = U N * (Q₁ * (U N * Q₂ + Polynomial.C ((Polynomial.X : Polynomial E) ^ m₂) * H₂) +
                Polynomial.C ((Polynomial.X : Polynomial E) ^ m₁) * H₁ * Q₂) +
              Polynomial.C ((Polynomial.X : Polynomial E) ^ N) * (H₁ * H₂) := by
                rw [← map_mul, ← pow_add]
      let S₁₂ := Q₁ * (U N * Q₂ + Polynomial.C ((Polynomial.X : Polynomial E) ^ m₂) * H₂) +
        Polynomial.C ((Polynomial.X : Polynomial E) ^ m₁) * H₁ * Q₂ - L_N * Q_G
      let R₁₂ := H₁ * H₂ - Polynomial.C e_N * Q_G
      have hRemG_eq : (F₁ * F₂) %ₘ G =
          U N * S₁₂ + Polynomial.C ((Polynomial.X : Polynomial E) ^ N) * R₁₂ := by
        rw [hRem_sub, hprod12, hG_UN]
        dsimp [S₁₂, R₁₂]
        ring
      rw [hRemG_eq, Polynomial.add_modByMonic,
        (Polynomial.modByMonic_eq_zero_iff_dvd (hU_mon N)).mpr ⟨S₁₂, rfl⟩, zero_add,
        hC_mul_modByMonic]
      exact ⟨R₁₂ %ₘ U N, rfl⟩

    let T_M : ℕ → Finset (Σ _ : ℕ, ℕ) :=
      fun M => (Finset.range D₁).sigma (fun i => Finset.range (M + 1 - i))

    have hMem_TM : ∀ (M i j : ℕ),
        (⟨i, j⟩ : Σ _ : ℕ, ℕ) ∈ T_M M ↔ i < D₁ ∧ i + j ≤ M := by
      intro M i j
      dsimp [T_M]
      rw [Finset.mem_sigma, Finset.mem_range, Finset.mem_range]
      dsimp only
      omega

    let evalTM : ∀ M : ℕ, V_M M →ₗ[E] (↥(T_M M) → E) :=
      fun M => LinearMap.pi (fun p => (coeff2 p.1.1 p.1.2).comp (V_M M).subtype)

    have hevalTM_bij : ∀ M : ℕ, Function.Bijective (evalTM M) := by
      intro M
      refine ⟨?_, ?_⟩
      · intro F₁ F₂ heq
        apply Subtype.ext
        ext i j
        by_cases hmem : (⟨i, j⟩ : Σ _ : ℕ, ℕ) ∈ T_M M
        · exact congrFun heq ⟨⟨i, j⟩, hmem⟩
        · rw [hMem_TM] at hmem
          have h1 : (F₁.1.coeff i).coeff j = 0 := by
            by_cases hi : i < D₁
            · exact F₁.2.2 i j (by omega)
            · rw [F₁.2.1 i (le_of_not_gt hi), Polynomial.coeff_zero]
          have h2 : (F₂.1.coeff i).coeff j = 0 := by
            by_cases hi : i < D₁
            · exact F₂.2.2 i j (by omega)
            · rw [F₂.2.1 i (le_of_not_gt hi), Polynomial.coeff_zero]
          rw [h1, h2]
      · intro f
        let P : Polynomial (Polynomial E) :=
          ∑ p ∈ (T_M M).attach, Polynomial.monomial p.1.1 (Polynomial.monomial p.1.2 (f p))
        have hP_coeff : ∀ (i j : ℕ),
            (P.coeff i).coeff j =
              if h : (⟨i, j⟩ : Σ _ : ℕ, ℕ) ∈ T_M M then f ⟨⟨i, j⟩, h⟩ else 0 := by
          intro i j
          dsimp [P]
          rw [Polynomial.finsetSum_coeff, Polynomial.finsetSum_coeff]
          by_cases h : (⟨i, j⟩ : Σ _ : ℕ, ℕ) ∈ T_M M
          · simp only [h, ↓reduceDIte]
            rw [Finset.sum_eq_single ⟨⟨i, j⟩, h⟩]
            · simp
            · intro b _ hb
              have hne : b.1 ≠ ⟨i, j⟩ := Subtype.coe_ne_coe.mpr hb
              by_cases h1 : b.1.1 = i
              · have h2 : b.1.2 ≠ j := by
                  intro h2eq
                  apply hne
                  cases b with
                  | mk bval hbmem =>
                    cases bval
                    dsimp at h1 h2eq
                    subst h1 h2eq
                    rfl
                simp [Polynomial.coeff_monomial, h1, h2]
              · simp [Polynomial.coeff_monomial, h1]
            · intro hnot
              exact absurd (Finset.mem_attach _ _) hnot
          · simp only [h, ↓reduceDIte]
            refine Finset.sum_eq_zero fun b _ => ?_
            by_cases h1 : b.1.1 = i
            · have h2 : b.1.2 ≠ j := by
                intro h2eq
                apply h
                have hbeq : (⟨i, j⟩ : Σ _ : ℕ, ℕ) = b.1 := by
                  cases b with
                  | mk bval hbmem =>
                    cases bval
                    dsimp at h1 h2eq
                    subst h1 h2eq
                    rfl
                rw [hbeq]
                exact b.2
              simp [Polynomial.coeff_monomial, h1, h2]
            · simp [Polynomial.coeff_monomial, h1]
        have hP_mem : P ∈ V_M M := by
          refine ⟨fun i hi => ?_, fun i j hij => ?_⟩
          · ext j
            rw [Polynomial.coeff_zero, hP_coeff i j]
            have hnot : ¬ ((⟨i, j⟩ : Σ _ : ℕ, ℕ) ∈ T_M M) := by
              rw [hMem_TM]
              omega
            simp [hnot]
          · rw [hP_coeff i j]
            have hnot : ¬ ((⟨i, j⟩ : Σ _ : ℕ, ℕ) ∈ T_M M) := by
              rw [hMem_TM]
              omega
            simp [hnot]
        refine ⟨⟨P, hP_mem⟩, ?_⟩
        funext ⟨⟨i, j⟩, hp⟩
        change (P.coeff i).coeff j = f ⟨⟨i, j⟩, hp⟩
        rw [hP_coeff i j]
        simp only [hp, ↓reduceDIte]

    have hSumArith : ∀ (d M : ℕ), d + 1 ≤ M →
        (∑ i ∈ Finset.range (d + 2), (M + 1 - i)) + ((d + 1) * d) / 2 =
          (d + 1) * M + (M + 1) := by
      intro d
      induction d with
      | zero =>
        intro M hM
        rw [Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_zero]
        omega
      | succ d ih =>
        intro M hM
        have hdiv : ((d + 2) * (d + 1)) / 2 = ((d + 1) * d) / 2 + (d + 1) := by
          have hmul : (d + 2) * (d + 1) = (d + 1) * d + 2 * (d + 1) := by ring
          rw [hmul, Nat.add_mul_div_left _ _ (by decide : 0 < 2)]
        rw [show d + 1 + 2 = (d + 2) + 1 by omega, Finset.sum_range_succ, hdiv]
        have ihM := ih M (by omega)
        have hmulM : (d + 1 + 1) * M = (d + 1) * M + M := Nat.succ_mul (d + 1) M
        omega

    have hWrr : ∀ (M : ℕ), D₁ - 1 ≤ M → M + 1 ≤ Module.finrank E (W M) + g₁ := by
      intro M hM
      let e_V : V_M M ≃ₗ[E] (↥(T_M M) → E) :=
        LinearEquiv.ofBijective (evalTM M) (hevalTM_bij M)
      have : FiniteDimensional E (V_M M) := Module.Finite.equiv e_V.symm
      have hfin_VM : Module.finrank E (V_M M) = ∑ i ∈ Finset.range D₁, (M + 1 - i) := by
        rw [e_V.finrank_eq, Module.finrank_fintype_fun_eq_card, Fintype.card_coe]
        dsimp [T_M]
        rw [Finset.card_sigma]
        refine Finset.sum_congr rfl fun i _ => Finset.card_range _
      have hrn := LinearMap.finrank_range_add_finrank_ker
        (K := E) (V := ↥(V_M M)) (V₂ := Fin (D₁ - 1) × Fin M → E) (Λ_M M)
      have hrange_le : Module.finrank E (LinearMap.range (Λ_M M)) ≤ (D₁ - 1) * M := by
        calc Module.finrank E (LinearMap.range (Λ_M M))
            ≤ Module.finrank E (Fin (D₁ - 1) × Fin M → E) :=
              Submodule.finrank_le (LinearMap.range (Λ_M M))
          _ = Fintype.card (Fin (D₁ - 1) × Fin M) := Module.finrank_fintype_fun_eq_card E
          _ = (D₁ - 1) * M := by rw [Fintype.card_prod, Fintype.card_fin, Fintype.card_fin]
      have hfin_W : Module.finrank E (W M) = Module.finrank E (LinearMap.ker (Λ_M M)) := by
        dsimp [W]
        exact LinearMap.finrank_range_of_inj ((hmkV_inj M).comp Subtype.val_injective)
      obtain ⟨d, rfl⟩ : ∃ d : ℕ, D₁ = d + 2 := ⟨D₁ - 2, (Nat.sub_add_cancel hD₁).symm⟩
      have harith : Module.finrank E (V_M M) + g₁ = (d + 1) * M + (M + 1) := by
        rw [hfin_VM]
        change (∑ i ∈ Finset.range (d + 2), (M + 1 - i)) + ((d + 1) * d) / 2 =
          (d + 1) * M + (M + 1)
        exact hSumArith d M (by omega)
      have hrange_le' : Module.finrank E (LinearMap.range (Λ_M M)) ≤ (d + 1) * M := hrange_le
      omega

    refine ⟨W, hW0, hWmul, hWrr, fun M u hu => ?_⟩
    obtain ⟨hWtd, hdvd⟩ := (hMem_W_iff M u).mp hu
    exact ⟨hWtd, hLevelRaise (repE u) (Nat.le_succ M) hdvd⟩

  obtain ⟨W, hW0, hWmul, hWrr, hWmem⟩ := h_part3

  
  
  
  have h_part4 : ∀ (M : ℕ) (F : Polynomial (Polynomial E)),
      Polynomial.C ((Polynomial.X : Polynomial E) ^ M) ∣ (F %ₘ U (M + 1)) →
      ((Polynomial.X : Polynomial E) ^ ((D₁ - 1) * M) ∣ N_poly F) ∧
      (((Polynomial.X : Polynomial E) ^ (M + 1) ∣ F.eval (η (M + 1))) →
        (Polynomial.X : Polynomial E) ^ (D₁ * M + 1) ∣ N_poly F) := by
    intro M F hF_Usucc
    let ev₀ : Polynomial E →+* E := Polynomial.evalRingHom 0
    let u₀ : E := ((Polynomial.derivative G).map ev₀).eval 0
    have hu₀ : u₀ ≠ 0 := hSmooth0
    have hG_ne_one : G ≠ 1 := by
      intro h1
      have hd := congrArg Polynomial.natDegree h1
      rw [hDeg, Polynomial.natDegree_one] at hd
      omega

    have hPoly_eq_sum_lt : ∀ (d : ℕ) (P : Polynomial (Polynomial E)),
        (∀ i : ℕ, d ≤ i → P.coeff i = 0) →
        P = ∑ i ∈ Finset.range d, Polynomial.monomial i (P.coeff i) := by
      intro d P hP
      ext i j
      rw [Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_monomial]
      by_cases hi : i < d
      · rw [Finset.sum_eq_single i]
        · simp
        · intro b _ hbi; simp [hbi]
        · intro hnot; exact absurd (Finset.mem_range.mpr hi) hnot
      · rw [hP i (le_of_not_gt hi), Finset.sum_eq_zero]
        intro b hb
        have hbi : b ≠ i := by
          have hbd := Finset.mem_range.mp hb
          omega
        simp [hbi]

    have hSum_modByMonic : ∀ {α : Type} (s : Finset α) (B : Polynomial (Polynomial E))
        (f : α → Polynomial (Polynomial E)),
        (∑ x ∈ s, f x) %ₘ B = ∑ x ∈ s, (f x %ₘ B) := by
      intro α s B f
      induction s using Finset.cons_induction with
      | empty =>
        rw [Finset.sum_empty, Finset.sum_empty, Polynomial.zero_modByMonic]
      | cons a s ha ih =>
        rw [Finset.sum_cons, Finset.sum_cons, Polynomial.add_modByMonic, ih]

    have hC_mul_modByMonic : ∀ (B : Polynomial (Polynomial E)) (p : Polynomial E)
        (P : Polynomial (Polynomial E)),
        (Polynomial.C p * P) %ₘ B = Polynomial.C p * (P %ₘ B) := by
      intro B p P
      rw [← Polynomial.smul_eq_C_mul, Polynomial.smul_modByMonic, Polynomial.smul_eq_C_mul]

    let pb := AdjoinRoot.powerBasis' hMon
    have hpb_dim : pb.dim = D₁ := (AdjoinRoot.powerBasis'_dim hMon).trans hDeg
    have hpb_basis : ∀ b : Fin pb.dim,
        pb.basis b = AdjoinRoot.mk G ((Polynomial.X : Polynomial (Polynomial E)) ^ b.1) := by
      intro b
      rw [PowerBasis.coe_basis, AdjoinRoot.powerBasis'_gen hMon, map_pow, AdjoinRoot.mk_X]

    have hpb_repr : ∀ (P : Polynomial (Polynomial E)) (a : Fin pb.dim),
        pb.basis.repr (AdjoinRoot.mk G P) a = (P %ₘ G).coeff a.1 := by
      intro P a
      have hdeg_lt : (P %ₘ G).natDegree < pb.dim := by
        rw [hpb_dim, ← hDeg]
        exact Polynomial.natDegree_modByMonic_lt P hMon hG_ne_one
      have hsum_rem : P %ₘ G =
          ∑ b : Fin pb.dim, Polynomial.C ((P %ₘ G).coeff b.1) * Polynomial.X ^ b.1 := by
        have h1 := hPoly_eq_sum_lt pb.dim (P %ₘ G)
          (fun i hi => Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_lt_of_le hdeg_lt hi))
        conv_lhs => rw [h1, ← Fin.sum_univ_eq_sum_range]
        refine Finset.sum_congr rfl fun b _ => ?_
        rw [Polynomial.C_mul_X_pow_eq_monomial]
      have hmk_rem : AdjoinRoot.mk G P = AdjoinRoot.mk G (P %ₘ G) := by
        conv_lhs => rw [← Polynomial.modByMonic_add_div P G]
        rw [map_add, map_mul, AdjoinRoot.mk_self, zero_mul, add_zero]
      have hmk_sum : AdjoinRoot.mk G P =
          ∑ b : Fin pb.dim, ((P %ₘ G).coeff b.1) • pb.basis b := by
        rw [hmk_rem]
        conv_lhs => rw [hsum_rem]
        rw [map_sum]
        refine Finset.sum_congr rfl fun b _ => ?_
        rw [hpb_basis b, map_mul, Algebra.smul_def]
        rfl
      rw [hmk_sum]
      exact congrFun (Module.Basis.repr_sum_self pb.basis (fun b => (P %ₘ G).coeff b.1)) a

    set η_s := η (M + 1)
    set U_s := U (M + 1)
    let L_s : Polynomial (Polynomial E) := Polynomial.X - Polynomial.C η_s
    let M_F : Matrix (Fin pb.dim) (Fin pb.dim) (Polynomial E) :=
      Algebra.leftMulMatrix pb.basis (AdjoinRoot.mk G F)
    have hMF_det : M_F.det = N_poly F := rfl

    have hMF_entry : ∀ a b : Fin pb.dim,
        M_F a b = ((F * Polynomial.X ^ b.1) %ₘ G).coeff a.1 := by
      intro a b
      dsimp [M_F]
      rw [Algebra.leftMulMatrix_apply, LinearMap.toMatrix_apply]
      change pb.basis.repr (AdjoinRoot.mk G F * pb.basis b) a = _
      rw [hpb_basis b, ← map_mul, hpb_repr (F * Polynomial.X ^ b.1) a]

    let B_col : Fin pb.dim → Polynomial (Polynomial E) :=
      fun k => if k.1 = 0 then U_s else L_s * Polynomial.X ^ (k.1 - 1)
    let T_mat : Matrix (Fin pb.dim) (Fin pb.dim) (Polynomial E) :=
      fun b k => (B_col k).coeff b.1

    have hBcol_coeff_ge : ∀ (k : Fin pb.dim) (i : ℕ), pb.dim ≤ i → (B_col k).coeff i = 0 := by
      intro k i hi
      dsimp [B_col]
      split_ifs with hk0
      · apply Polynomial.coeff_eq_zero_of_natDegree_lt
        rw [hU_deg (M + 1), hpb_dim] at *
        omega
      · have hk_lt : k.1 < pb.dim := k.2
        have hB_exp : L_s * Polynomial.X ^ (k.1 - 1) =
            Polynomial.X ^ k.1 - Polynomial.C η_s * Polynomial.X ^ (k.1 - 1) := by
          dsimp [L_s]
          rw [sub_mul, ← pow_succ', Nat.sub_add_cancel (by omega)]
        rw [hB_exp, Polynomial.coeff_sub, Polynomial.C_mul_X_pow_eq_monomial,
          Polynomial.coeff_X_pow, Polynomial.coeff_monomial]
        have h1 : ¬ (i = k.1) := by omega
        have h2 : ¬ (k.1 - 1 = i) := by omega
        simp [h1, h2]

    have hBcol_sum : ∀ k : Fin pb.dim,
        B_col k = ∑ b : Fin pb.dim, Polynomial.C (T_mat b k) * Polynomial.X ^ b.1 := by
      intro k
      have h1 := hPoly_eq_sum_lt pb.dim (B_col k) (hBcol_coeff_ge k)
      conv_lhs => rw [h1, ← Fin.sum_univ_eq_sum_range]
      refine Finset.sum_congr rfl fun b _ => ?_
      dsimp [T_mat]
      rw [Polynomial.C_mul_X_pow_eq_monomial]

    have hMFT_entry : ∀ a k : Fin pb.dim,
        (M_F * T_mat) a k = ((F * B_col k) %ₘ G).coeff a.1 := by
      intro a k
      rw [Matrix.mul_apply]
      have hsum_mod : (F * B_col k) %ₘ G =
          ∑ b : Fin pb.dim, Polynomial.C (T_mat b k) * ((F * Polynomial.X ^ b.1) %ₘ G) := by
        conv_lhs => rw [hBcol_sum k, Finset.mul_sum]
        rw [hSum_modByMonic]
        refine Finset.sum_congr rfl fun b _ => ?_
        have hcomm : F * (Polynomial.C (T_mat b k) * Polynomial.X ^ b.1) =
            Polynomial.C (T_mat b k) * (F * Polynomial.X ^ b.1) := by ring
        rw [hcomm, hC_mul_modByMonic]
      rw [hsum_mod, Polynomial.finsetSum_coeff]
      refine Finset.sum_congr rfl fun b _ => ?_
      rw [hMF_entry a b, Polynomial.coeff_C_mul, mul_comm]

    let T₀ : Matrix (Fin pb.dim) (Fin pb.dim) E := ev₀.mapMatrix T_mat
    have hT₀_col_ne0 : ∀ (a k : Fin pb.dim), k.1 ≠ 0 →
        T₀ a k = if a.1 = k.1 then 1 else 0 := by
      intro a k hk0
      change ((B_col k).coeff a.1).eval 0 = if a.1 = k.1 then 1 else 0
      dsimp [B_col]
      simp only [hk0, ↓reduceIte]
      have hB_exp : L_s * Polynomial.X ^ (k.1 - 1) =
          Polynomial.X ^ k.1 - Polynomial.monomial (k.1 - 1) η_s := by
        dsimp [L_s]
        rw [sub_mul, ← pow_succ', Nat.sub_add_cancel (by omega),
          Polynomial.C_mul_X_pow_eq_monomial]
      rw [hB_exp, Polynomial.coeff_sub, Polynomial.eval_sub]
      have hmon0 : ((Polynomial.monomial (k.1 - 1) η_s).coeff a.1).eval 0 = 0 := by
        rw [Polynomial.coeff_monomial]
        split_ifs
        · exact hη0 (M + 1)
        · exact Polynomial.eval_zero
      rw [hmon0, sub_zero, Polynomial.coeff_X_pow]
      split_ifs <;> simp

    have hT₀_lowTri : T₀.IsLowerTriangular := by
      intro a k hak
      have hk0 : k.1 ≠ 0 := by
        change a.1 < k.1 at hak
        omega
      have hne : a.1 ≠ k.1 := ne_of_lt hak
      rw [hT₀_col_ne0 a k hk0]
      simp only [hne, ↓reduceIte]

    let k₀ : Fin pb.dim := ⟨0, by rw [hpb_dim]; omega⟩
    have hT₀_det : T₀.det = u₀ := by
      rw [Matrix.det_of_isLowerTriangular T₀ hT₀_lowTri, Finset.prod_eq_single k₀]
      · change ((B_col k₀).coeff 0).eval 0 = u₀
        dsimp [B_col, k₀]
        change ev₀ (U_s.coeff 0) = u₀
        rw [← Polynomial.coeff_map, Polynomial.coeff_zero_eq_eval_zero]
        exact hU0 (M + 1)
      · intro k _ hk_ne
        have hk0 : k.1 ≠ 0 := fun h0 => hk_ne (Fin.ext h0)
        rw [hT₀_col_ne0 k k hk0]
        simp only [↓reduceIte]
      · intro hnot
        exact absurd (Finset.mem_univ k₀) hnot

    have hT_det_eval0 : (T_mat.det).eval 0 = u₀ := by
      change ev₀ T_mat.det = u₀
      rw [RingHom.map_det ev₀ T_mat]
      exact hT₀_det

    have hCoprime_X_T : ∀ K : ℕ, IsCoprime ((Polynomial.X : Polynomial E) ^ K) T_mat.det := by
      intro K
      have hbase : IsCoprime (Polynomial.X : Polynomial E) T_mat.det := by
        have hdvd_sub : (Polynomial.X : Polynomial E) ∣ (T_mat.det - Polynomial.C u₀) := by
          rw [Polynomial.X_dvd_iff, Polynomial.coeff_sub, Polynomial.coeff_zero_eq_eval_zero,
            Polynomial.coeff_C_zero, hT_det_eval0, sub_self]
        rcases hdvd_sub with ⟨Q_det, hQ_det⟩
        refine ⟨-Polynomial.C u₀⁻¹ * Q_det, Polynomial.C u₀⁻¹, ?_⟩
        have hT_eq : T_mat.det = Polynomial.C u₀ + Polynomial.X * Q_det := by
          linear_combination hQ_det
        calc (-Polynomial.C u₀⁻¹ * Q_det) * Polynomial.X + Polynomial.C u₀⁻¹ * T_mat.det
            = (-Polynomial.C u₀⁻¹ * Q_det) * Polynomial.X +
                Polynomial.C u₀⁻¹ * (Polynomial.C u₀ + Polynomial.X * Q_det) := by rw [hT_eq]
          _ = Polynomial.C u₀⁻¹ * Polynomial.C u₀ := by ring
          _ = Polynomial.C (u₀⁻¹ * u₀) := (map_mul Polynomial.C u₀⁻¹ u₀).symm
          _ = 1 := by rw [inv_mul_cancel₀ hu₀, map_one]
      exact hbase.pow_left

    rcases hG_eval (M + 1) with ⟨e_s, he_s⟩
    have hCol_ne0_dvd : ∀ (a k : Fin pb.dim), k.1 ≠ 0 →
        (Polynomial.X : Polynomial E) ^ M ∣ (M_F * T_mat) a k := by
      intro a k hk0
      rcases hF_Usucc with ⟨R_F, hR_F⟩
      set Q_U := F /ₘ U_s
      have hF_divU : F = U_s * Q_U + Polynomial.C ((Polynomial.X : Polynomial E) ^ M) * R_F := by
        have hdiv : F %ₘ U_s + U_s * Q_U = F := Polynomial.modByMonic_add_div F U_s
        rw [hR_F] at hdiv
        linear_combination -hdiv
      have hUsLs : U_s * L_s =
          G - Polynomial.C ((Polynomial.X : Polynomial E) ^ M) *
            Polynomial.C (Polynomial.X * e_s) := by
        have h := hG_div (M + 1)
        have hexp : G.eval η_s = Polynomial.X ^ M * (Polynomial.X * e_s) := by
          rw [he_s]
          ring
        dsimp [U_s, L_s, η_s] at *
        rw [hexp, map_mul] at h
        linear_combination -h
      have hFB_eq : F * B_col k =
          G * (Q_U * Polynomial.X ^ (k.1 - 1)) +
            Polynomial.C ((Polynomial.X : Polynomial E) ^ M) *
              (R_F * B_col k -
                Polynomial.C (Polynomial.X * e_s) * Q_U * Polynomial.X ^ (k.1 - 1)) := by
        have hBk : B_col k = L_s * Polynomial.X ^ (k.1 - 1) := by
          dsimp [B_col]
          simp only [hk0, ↓reduceIte]
        rw [hF_divU, hBk]
        linear_combination (Q_U * Polynomial.X ^ (k.1 - 1)) * hUsLs
      rw [hMFT_entry a k, hFB_eq, Polynomial.add_modByMonic,
        (Polynomial.modByMonic_eq_zero_iff_dvd hMon).mpr ⟨_, rfl⟩, zero_add,
        hC_mul_modByMonic, Polynomial.coeff_C_mul]
      exact ⟨_, rfl⟩

    have hCard_erase_k₀ : ((Finset.univ : Finset (Fin pb.dim)).erase k₀).card = D₁ - 1 := by
      rw [Finset.card_erase_of_mem (Finset.mem_univ k₀), Finset.card_univ, Fintype.card_fin,
        hpb_dim]

    have hdvd_base : (Polynomial.X : Polynomial E) ^ ((D₁ - 1) * M) ∣ N_poly F := by
      let d₁ : Fin pb.dim → Polynomial E :=
        fun k => if k.1 = 0 then 1 else Polynomial.X ^ M
      have hd₁_dvd : ∀ a k : Fin pb.dim, d₁ k ∣ (M_F * T_mat) a k := by
        intro a k
        dsimp [d₁]
        split_ifs with hk0
        · exact one_dvd _
        · exact hCol_ne0_dvd a k hk0
      let A₁ : Matrix (Fin pb.dim) (Fin pb.dim) (Polynomial E) :=
        fun a k => Classical.choose (hd₁_dvd a k)
      have hMFT_diag₁ : M_F * T_mat = A₁ * Matrix.diagonal d₁ := by
        apply Matrix.ext
        intro a k
        rw [Matrix.mul_diagonal]
        have hspec := Classical.choose_spec (hd₁_dvd a k)
        change (M_F * T_mat) a k = A₁ a k * d₁ k
        rw [mul_comm]
        exact hspec
      have hprod_d₁ : (∏ k : Fin pb.dim, d₁ k) = Polynomial.X ^ ((D₁ - 1) * M) := by
        rw [← Finset.mul_prod_erase Finset.univ d₁ (Finset.mem_univ k₀)]
        have hd₁_k₀ : d₁ k₀ = 1 := rfl
        have hprod_rest : (∏ k ∈ Finset.univ.erase k₀, d₁ k) =
            ∏ _k ∈ Finset.univ.erase k₀, (Polynomial.X : Polynomial E) ^ M := by
          refine Finset.prod_congr rfl fun k hk => ?_
          have hk_ne : k ≠ k₀ := (Finset.mem_erase.mp hk).1
          have hk0 : k.1 ≠ 0 := fun h0 => hk_ne (Fin.ext h0)
          dsimp [d₁]
          simp only [hk0, ↓reduceIte]
        rw [hd₁_k₀, one_mul, hprod_rest, Finset.prod_const, hCard_erase_k₀, ← pow_mul,
          mul_comm M (D₁ - 1)]
      have hdet_dvd : (Polynomial.X : Polynomial E) ^ ((D₁ - 1) * M) ∣ N_poly F * T_mat.det := by
        refine ⟨A₁.det, ?_⟩
        have hdet := congrArg Matrix.det hMFT_diag₁
        rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_diagonal, hMF_det, hprod_d₁] at hdet
        rw [mul_comm ((Polynomial.X : Polynomial E) ^ ((D₁ - 1) * M)) A₁.det]
        exact hdet
      exact (hCoprime_X_T ((D₁ - 1) * M)).dvd_of_dvd_mul_right hdet_dvd

    refine ⟨hdvd_base, fun hFeval_dvd => ?_⟩
    rcases hFeval_dvd with ⟨f_s, hf_s⟩
    have hCol0_dvd : ∀ (a k : Fin pb.dim), k.1 = 0 →
        (Polynomial.X : Polynomial E) ^ (M + 1) ∣ (M_F * T_mat) a k := by
      intro a k hk0
      set Q_L := F /ₘ L_s
      have hF_divL : F = L_s * Q_L +
          Polynomial.C ((Polynomial.X : Polynomial E) ^ (M + 1)) * Polynomial.C f_s := by
        have h1 : F %ₘ L_s + L_s * Q_L = F := Polynomial.modByMonic_add_div F L_s
        have h2 : F %ₘ L_s = Polynomial.C (F.eval η_s) :=
          Polynomial.modByMonic_X_sub_C_eq_C_eval F η_s
        rw [h2, hf_s, map_mul] at h1
        linear_combination -h1
      have hLsUs : L_s * U_s =
          G - Polynomial.C ((Polynomial.X : Polynomial E) ^ (M + 1)) * Polynomial.C e_s := by
        have h := hG_div (M + 1)
        dsimp [U_s, L_s, η_s] at *
        rw [he_s, map_mul] at h
        linear_combination -h
      have hFB0 : F * B_col k =
          G * Q_L +
            Polynomial.C ((Polynomial.X : Polynomial E) ^ (M + 1)) *
              (Polynomial.C f_s * U_s - Polynomial.C e_s * Q_L) := by
        have hBk : B_col k = U_s := by
          dsimp [B_col]
          simp only [hk0, ↓reduceIte]
        rw [hF_divL, hBk]
        linear_combination Q_L * hLsUs
      rw [hMFT_entry a k, hFB0, Polynomial.add_modByMonic,
        (Polynomial.modByMonic_eq_zero_iff_dvd hMon).mpr ⟨_, rfl⟩, zero_add,
        hC_mul_modByMonic, Polynomial.coeff_C_mul]
      exact ⟨_, rfl⟩

    let d₂ : Fin pb.dim → Polynomial E :=
      fun k => if k.1 = 0 then Polynomial.X ^ (M + 1) else Polynomial.X ^ M
    have hd₂_dvd : ∀ a k : Fin pb.dim, d₂ k ∣ (M_F * T_mat) a k := by
      intro a k
      dsimp [d₂]
      split_ifs with hk0
      · exact hCol0_dvd a k hk0
      · exact hCol_ne0_dvd a k hk0
    let A₂ : Matrix (Fin pb.dim) (Fin pb.dim) (Polynomial E) :=
      fun a k => Classical.choose (hd₂_dvd a k)
    have hMFT_diag₂ : M_F * T_mat = A₂ * Matrix.diagonal d₂ := by
      apply Matrix.ext
      intro a k
      rw [Matrix.mul_diagonal]
      have hspec := Classical.choose_spec (hd₂_dvd a k)
      change (M_F * T_mat) a k = A₂ a k * d₂ k
      rw [mul_comm]
      exact hspec
    have hprod_d₂ : (∏ k : Fin pb.dim, d₂ k) = Polynomial.X ^ (D₁ * M + 1) := by
      rw [← Finset.mul_prod_erase Finset.univ d₂ (Finset.mem_univ k₀)]
      have hd₂_k₀ : d₂ k₀ = Polynomial.X ^ (M + 1) := rfl
      have hprod_rest : (∏ k ∈ Finset.univ.erase k₀, d₂ k) =
          ∏ _k ∈ Finset.univ.erase k₀, (Polynomial.X : Polynomial E) ^ M := by
        refine Finset.prod_congr rfl fun k hk => ?_
        have hk_ne : k ≠ k₀ := (Finset.mem_erase.mp hk).1
        have hk0 : k.1 ≠ 0 := fun h0 => hk_ne (Fin.ext h0)
        dsimp [d₂]
        simp only [hk0, ↓reduceIte]
      have hexp_eq : (M + 1) + M * (D₁ - 1) = D₁ * M + 1 := by
        have h1 : 1 + (D₁ - 1) = D₁ := by omega
        calc (M + 1) + M * (D₁ - 1) = (1 + (D₁ - 1)) * M + 1 := by ring
          _ = D₁ * M + 1 := by rw [h1]
      rw [hd₂_k₀, hprod_rest, Finset.prod_const, hCard_erase_k₀, ← pow_mul, ← pow_add, hexp_eq]
    have hdet_dvd₂ : (Polynomial.X : Polynomial E) ^ (D₁ * M + 1) ∣ N_poly F * T_mat.det := by
      refine ⟨A₂.det, ?_⟩
      have hdet := congrArg Matrix.det hMFT_diag₂
      rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_diagonal, hMF_det, hprod_d₂] at hdet
      rw [mul_comm ((Polynomial.X : Polynomial E) ^ (D₁ * M + 1)) A₂.det]
      exact hdet
    exact (hCoprime_X_T (D₁ * M + 1)).dvd_of_dvd_mul_right hdet_dvd₂

  
  
  
  refine ⟨W, Φ, hW0, hWmul, hWrr, ?_⟩
  intro M u hu
  obtain ⟨hWtd_u, hF_Usucc⟩ := hWmem M u hu
  set F := AdjoinRoot.modByMonicHom hMon u
  have hmk_F : AdjoinRoot.mk G F = u := by
    obtain ⟨P, rfl⟩ := AdjoinRoot.mk_surjective u
    have hF_eq : F = P %ₘ G := AdjoinRoot.modByMonicHom_mk hMon P
    rw [hF_eq]
    conv_rhs => rw [← Polynomial.modByMonic_add_div P G]
    rw [map_add, map_mul, AdjoinRoot.mk_self, zero_mul, add_zero]
  obtain ⟨hdvd_base, hdvd_jump⟩ := h_part4 M F hF_Usucc
  refine ⟨hWtd_u, hdvd_base, fun hΦ_van => hdvd_jump ?_⟩
  rw [Polynomial.X_pow_dvd_iff]
  intro k hk
  rw [← hΦ_coeff F (M + 1) k hk, hmk_F]
  exact hΦ_van k (Nat.lt_succ_iff.mp hk)

theorem weil_filtered_algebra_frobenius_auxiliary_vanishing (E : Type u) [Finite E] [Field E]
    (p : ℕ) [Fact (Nat.Prime p)] [CharP E p]
    (A : Type u) [CommRing A] [Algebra E A]
    (W : ℕ → Submodule E A)
    (Φ : A →ₐ[E] PowerSeries E)
    (h1 : (1 : A) ∈ W 0)
    (hmul : ∀ (m₁ m₂ : ℕ) {u v : A}, u ∈ W m₁ → v ∈ W m₂ → u * v ∈ W (m₁ + m₂))
    (hinj : ∀ (m : ℕ) {u : A}, u ∈ W m → (∀ k ≤ m, PowerSeries.coeff k (Φ u) = 0) → u = 0)
    (a b M₁ M₂ : ℕ)
    (hab : p ^ a * p ^ b = Nat.card E)
    (hM₁_lt : M₁ < p ^ a)
    (hd₁_pos : 1 ≤ Module.finrank E (W M₁))
    (hDim_gt : Module.finrank E (W (p ^ b * M₁ + M₂)) <
      Module.finrank E (W M₁) * Module.finrank E (W M₂)) :
    ∃ w_aux : A,
      w_aux ∈ W (M₁ + p ^ a * M₂) ∧
      w_aux ≠ 0 ∧
      ∀ ψ : A →+* E, ψ w_aux = 0 :=
by
  classical
  let _ := hd₁_pos
  have hpow : ∀ (e m : ℕ) {z : A}, z ∈ W m → z ^ e ∈ W (e * m) := by
    intro e
    induction e with
    | zero =>
      intro m z _
      rw [pow_zero, Nat.zero_mul]
      exact h1
    | succ k ih =>
      intro m z hz
      rw [pow_succ, Nat.succ_mul]
      exact hmul (k * m) m (ih m hz) hz
  have hFinDim : ∀ m : ℕ, FiniteDimensional E (W m) := by
    intro m
    let τ : W m →ₗ[E] (Fin (m + 1) → E) :=
      LinearMap.pi fun j : Fin (m + 1) =>
        (PowerSeries.coeff j.1).comp (Φ.toLinearMap.comp (W m).subtype)
    have hτ_inj : Function.Injective τ := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro w hw
      apply Subtype.ext
      refine hinj m w.2 (fun k hk => ?_)
      have hk_lt : k < m + 1 := Nat.lt_succ_of_le hk
      exact congrFun hw ⟨k, hk_lt⟩
    exact FiniteDimensional.of_injective τ hτ_inj
  have _ : ∀ m : ℕ, FiniteDimensional E (W m) := hFinDim
  have hord_fin : ∀ (m : ℕ) (w : W m), w ≠ 0 →
      ∃ k : Fin (m + 1), (Φ w.1).order = (k.1 : ℕ∞) := by
    intro m w hw_ne
    have hw1_ne : w.1 ≠ 0 := fun h0 => hw_ne (Subtype.ext h0)
    have hex_nz : ∃ k ≤ m, PowerSeries.coeff k (Φ w.1) ≠ 0 := by
      by_contra hall
      exact hw1_ne (hinj m w.2 (fun k hk => by_contra fun hnz => hall ⟨k, hk, hnz⟩))
    obtain ⟨k₀, hk₀_le, hk₀_nz⟩ := hex_nz
    let J_w : Finset ℕ :=
      (Finset.range (m + 1)).filter (fun k => PowerSeries.coeff k (Φ w.1) ≠ 0)
    have hJ_ne : J_w.Nonempty :=
      ⟨k₀, Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (Nat.lt_succ_of_le hk₀_le), hk₀_nz⟩⟩
    let n_w : ℕ := J_w.min' hJ_ne
    obtain ⟨hn_range, hn_nz⟩ := Finset.mem_filter.mp (Finset.min'_mem J_w hJ_ne)
    have hn_lt : n_w < m + 1 := Finset.mem_range.mp hn_range
    refine ⟨⟨n_w, hn_lt⟩, PowerSeries.order_eq_nat.mpr ⟨hn_nz, fun j hj => ?_⟩⟩
    by_contra hj_nz
    have hj_mem : j ∈ J_w :=
      Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (lt_trans hj hn_lt), hj_nz⟩
    exact not_le_of_gt hj (Finset.min'_le J_w j hj_mem)
  let I : Finset (Fin (M₁ + 1)) :=
    Finset.univ.filter (fun k : Fin (M₁ + 1) => ∃ w : W M₁, (Φ w.1).order = (k.1 : ℕ∞))
  let b_vec : ↥I → W M₁ := fun i => Classical.choose (Finset.mem_filter.mp i.2).2
  have hb_ord : ∀ i : ↥I, (Φ (b_vec i).1).order = (i.1.1 : ℕ∞) :=
    fun i => Classical.choose_spec (Finset.mem_filter.mp i.2).2
  have hb_nz : ∀ i : ↥I, PowerSeries.coeff i.1.1 (Φ (b_vec i).1) ≠ 0 :=
    fun i => (PowerSeries.order_eq_nat.mp (hb_ord i)).1
  have hb_lt : ∀ (i : ↥I) (j : ℕ), j < i.1.1 → PowerSeries.coeff j (Φ (b_vec i).1) = 0 :=
    fun i => (PowerSeries.order_eq_nat.mp (hb_ord i)).2
  have h_li : LinearIndependent E b_vec := by
    rw [Fintype.linearIndependent_iff]
    intro g hsum i₀
    by_contra hi₀_nz
    let S_g : Finset ↥I := Finset.univ.filter (fun i : ↥I => g i ≠ 0)
    have hSg_ne : S_g.Nonempty := ⟨i₀, Finset.mem_filter.mpr ⟨Finset.mem_univ i₀, hi₀_nz⟩⟩
    let i_min : ↥I := S_g.min' hSg_ne
    have hg_min : g i_min ≠ 0 := (Finset.mem_filter.mp (Finset.min'_mem S_g hSg_ne)).2
    have hval : (∑ i : ↥I, g i • b_vec i).1 = 0 := congrArg Subtype.val hsum
    rw [Submodule.coe_sum] at hval
    have hcoeff : PowerSeries.coeff i_min.1.1 (Φ (∑ i : ↥I, (g i • b_vec i).1)) = 0 := by
      rw [hval, map_zero, map_zero]
    rw [map_sum, map_sum] at hcoeff
    have hsingle : ∑ i : ↥I, PowerSeries.coeff i_min.1.1 (Φ (g i • b_vec i).1) =
        g i_min * PowerSeries.coeff i_min.1.1 (Φ (b_vec i_min).1) := by
      rw [Finset.sum_eq_single i_min]
      · rw [SetLike.val_smul, map_smul, map_smul, smul_eq_mul]
      · intro i _ hne
        rw [SetLike.val_smul, map_smul, map_smul, smul_eq_mul]
        by_cases hgi : g i = 0
        · rw [hgi, zero_mul]
        · have hi_mem : i ∈ S_g := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hgi⟩
          have hle : i_min ≤ i := Finset.min'_le S_g i hi_mem
          have hlt : i_min < i := lt_of_le_of_ne hle hne.symm
          have hlt_nat : i_min.1.1 < i.1.1 := hlt
          rw [hb_lt i i_min.1.1 hlt_nat, mul_zero]
      · intro hnot
        exact absurd (Finset.mem_univ i_min) hnot
    rw [hsingle] at hcoeff
    exact mul_ne_zero hg_min (hb_nz i_min) hcoeff
  have h_span : ⊤ ≤ Submodule.span E (Set.range b_vec) := by
    let S_span : Submodule E (W M₁) := Submodule.span E (Set.range b_vec)
    intro w₀ _
    by_contra hw₀_not
    have hw₀_ne : w₀ ≠ 0 := fun h0 => hw₀_not (h0 ▸ S_span.zero_mem)
    obtain ⟨k₀, hk₀_ord⟩ := hord_fin M₁ w₀ hw₀_ne
    let K_bad : Finset (Fin (M₁ + 1)) :=
      Finset.univ.filter (fun k : Fin (M₁ + 1) =>
        ∃ w : W M₁, w ∉ S_span ∧ (Φ w.1).order = (k.1 : ℕ∞))
    have hK_ne : K_bad.Nonempty :=
      ⟨k₀, Finset.mem_filter.mpr ⟨Finset.mem_univ k₀, ⟨w₀, hw₀_not, hk₀_ord⟩⟩⟩
    let k_max : Fin (M₁ + 1) := K_bad.max' hK_ne
    obtain ⟨w_star, hw_star_not, hw_star_ord⟩ :=
      (Finset.mem_filter.mp (Finset.max'_mem K_bad hK_ne)).2
    have hk_max_I : k_max ∈ I :=
      Finset.mem_filter.mpr ⟨Finset.mem_univ k_max, ⟨w_star, hw_star_ord⟩⟩
    let i_star : ↥I := ⟨k_max, hk_max_I⟩
    let c : E :=
      PowerSeries.coeff k_max.1 (Φ w_star.1) *
        (PowerSeries.coeff k_max.1 (Φ (b_vec i_star).1))⁻¹
    let w' : W M₁ := w_star - c • b_vec i_star
    have hbi_mem : b_vec i_star ∈ S_span := Submodule.subset_span ⟨i_star, rfl⟩
    have hcbi_mem : c • b_vec i_star ∈ S_span := S_span.smul_mem c hbi_mem
    have hw'_not : w' ∉ S_span := by
      intro hw'_in
      have hw_in : w_star ∈ S_span := by
        have heq : w_star = w' + c • b_vec i_star := (sub_add_cancel w_star (c • b_vec i_star)).symm
        rw [heq]
        exact S_span.add_mem hw'_in hcbi_mem
      exact hw_star_not hw_in
    have hw'_ne : w' ≠ 0 := fun h0 => hw'_not (h0 ▸ S_span.zero_mem)
    obtain ⟨k', hk'_ord⟩ := hord_fin M₁ w' hw'_ne
    have hk'_mem : k' ∈ K_bad :=
      Finset.mem_filter.mpr ⟨Finset.mem_univ k', ⟨w', hw'_not, hk'_ord⟩⟩
    have hk'_le : k' ≤ k_max := Finset.le_max' K_bad k' hk'_mem
    have hk'_nz : PowerSeries.coeff k'.1 (Φ w'.1) ≠ 0 :=
      (PowerSeries.order_eq_nat.mp hk'_ord).1
    have hk'_zero : PowerSeries.coeff k'.1 (Φ w'.1) = 0 := by
      have hw'_val : w'.1 = w_star.1 - c • (b_vec i_star).1 := rfl
      rw [hw'_val, map_sub, map_smul, map_sub, map_smul, smul_eq_mul]
      rcases lt_or_eq_of_le (show k'.1 ≤ k_max.1 from hk'_le) with hlt | heq
      · have h1 : PowerSeries.coeff k'.1 (Φ w_star.1) = 0 :=
          (PowerSeries.order_eq_nat.mp hw_star_ord).2 k'.1 hlt
        have h2 : PowerSeries.coeff k'.1 (Φ (b_vec i_star).1) = 0 :=
          hb_lt i_star k'.1 hlt
        rw [h1, h2, mul_zero, sub_zero]
      · rw [heq]
        dsimp [c]
        have hbi_nz : PowerSeries.coeff k_max.1 (Φ (b_vec i_star).1) ≠ 0 := hb_nz i_star
        rw [inv_mul_cancel_right₀ hbi_nz, sub_self]
    exact hk'_nz hk'_zero
  let B₁ : Module.Basis ↥I E (W M₁) := Module.Basis.mk h_li h_span
  have hcard_I : Module.finrank E (W M₁) = Fintype.card ↥I :=
    Module.finrank_eq_card_basis B₁
  have hterm_rel : ∀ (v : ↥I → W M₂) (i : ↥I),
      ((b_vec i).1) ^ (p ^ b) * (v i).1 ∈ W (p ^ b * M₁ + M₂) :=
    fun v i => hmul (p ^ b * M₁) M₂ (hpow (p ^ b) M₁ (b_vec i).2) (v i).2
  let L_rel : (↥I → W M₂) →ₗ[E] W (p ^ b * M₁ + M₂) :=
    { toFun := fun v =>
        ⟨∑ i : ↥I, ((b_vec i).1) ^ (p ^ b) * (v i).1,
          (W (p ^ b * M₁ + M₂)).sum_mem (fun i _ => hterm_rel v i)⟩
      map_add' := fun v₁ v₂ => by
        apply Subtype.ext
        simp only [Submodule.coe_add, Pi.add_apply, mul_add, Finset.sum_add_distrib]
      map_smul' := fun c v => by
        apply Subtype.ext
        simp only [RingHom.id_apply, SetLike.val_smul, Pi.smul_apply, mul_smul_comm,
          Finset.smul_sum] }
  have hL_not_inj : ¬ Function.Injective L_rel := by
    intro hinj_L
    have hle := LinearMap.finrank_le_finrank_of_injective hinj_L
    have hdom : Module.finrank E (↥I → W M₂) =
        Module.finrank E (W M₁) * Module.finrank E (W M₂) := by
      rw [Module.finrank_pi_fintype E]
      simp only [Finset.sum_const, Finset.card_univ, smul_eq_mul, ← hcard_I]
    omega
  have hex_ker : ∃ v : ↥I → W M₂, L_rel v = 0 ∧ v ≠ 0 := by
    by_contra hall
    apply hL_not_inj
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro v hv
    by_contra hv_ne
    exact hall ⟨v, LinearMap.mem_ker.mp hv, hv_ne⟩
  obtain ⟨v, hv_L, hv_ne⟩ := hex_ker
  have hv_rel : ∑ i : ↥I, ((b_vec i).1) ^ (p ^ b) * (v i).1 = 0 :=
    congrArg Subtype.val hv_L
  let w_aux : A := ∑ i : ↥I, (b_vec i).1 * ((v i).1) ^ (p ^ a)
  have hw_mem : w_aux ∈ W (M₁ + p ^ a * M₂) :=
    (W (M₁ + p ^ a * M₂)).sum_mem fun i _ =>
      hmul M₁ (p ^ a * M₂) (b_vec i).2 (hpow (p ^ a) M₂ (v i).2)
  have hw_ne : w_aux ≠ 0 := by
    have hex_v : ∃ i : ↥I, (v i).1 ≠ 0 := by
      by_contra hall
      apply hv_ne
      funext i
      exact Subtype.ext (by_contra fun hi => hall ⟨i, hi⟩)
    obtain ⟨i₀, hi₀_nz⟩ := hex_v
    let S_nz : Finset ↥I := Finset.univ.filter (fun i : ↥I => (v i).1 ≠ 0)
    have hSnz_ne : S_nz.Nonempty :=
      ⟨i₀, Finset.mem_filter.mpr ⟨Finset.mem_univ i₀, hi₀_nz⟩⟩
    have hpa_ne : p ^ a ≠ 0 := by omega
    have hex_kv : ∀ i : ↥I, ∃ k : ℕ, (v i).1 ≠ 0 → (Φ (v i).1).order = (k : ℕ∞) := by
      intro i
      by_cases hi : (v i).1 = 0
      · exact ⟨0, fun hnz => absurd hi hnz⟩
      · obtain ⟨k, hk⟩ := hord_fin M₂ (v i) (fun h0 => hi (congrArg Subtype.val h0))
        exact ⟨k.1, fun _ => hk⟩
    let k_v : ↥I → ℕ := fun i => Classical.choose (hex_kv i)
    have hk_v_ord : ∀ (i : ↥I), (v i).1 ≠ 0 → (Φ (v i).1).order = (k_v i : ℕ∞) :=
      fun i => Classical.choose_spec (hex_kv i)
    let e_ord : ↥I → ℕ := fun i => i.1.1 + p ^ a * k_v i
    let θ : ↥I → PowerSeries E := fun i => Φ (b_vec i).1 * (Φ (v i).1) ^ (p ^ a)
    have hθ_ord : ∀ (i : ↥I) (hi : (v i).1 ≠ 0), (θ i).order = (e_ord i : ℕ∞) := by
      intro i hi
      dsimp [θ, e_ord]
      rw [PowerSeries.order_mul, PowerSeries.order_pow, hb_ord i, hk_v_ord i hi,
        nsmul_eq_mul, ← Nat.cast_mul, ← Nat.cast_add]
    have he_mod : ∀ i : ↥I, e_ord i % p ^ a = i.1.1 := by
      intro i
      dsimp [e_ord]
      rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt]
      have hi_le : i.1.1 ≤ M₁ := Nat.lt_succ_iff.mp i.1.2
      omega
    have he_inj : Function.Injective e_ord := by
      intro i₁ i₂ heq
      apply Subtype.ext
      apply Fin.ext
      calc i₁.1.1 = e_ord i₁ % p ^ a := (he_mod i₁).symm
        _ = e_ord i₂ % p ^ a := by rw [heq]
        _ = i₂.1.1 := he_mod i₂
    let e_min : ℕ := (S_nz.image e_ord).min' (hSnz_ne.image e_ord)
    have he_min_mem : e_min ∈ S_nz.image e_ord :=
      Finset.min'_mem (S_nz.image e_ord) (hSnz_ne.image e_ord)
    obtain ⟨i_star, hi_star_mem, hi_star_eq⟩ := Finset.mem_image.mp he_min_mem
    have hi_star_nz : (v i_star).1 ≠ 0 := (Finset.mem_filter.mp hi_star_mem).2
    have hcoeff_sum : PowerSeries.coeff e_min (Φ w_aux) =
        PowerSeries.coeff e_min (θ i_star) := by
      dsimp [w_aux]
      rw [map_sum, map_sum, Finset.sum_eq_single i_star]
      · dsimp [θ]
        rw [map_mul, map_pow]
      · intro i _ hne
        rw [map_mul, map_pow]
        change PowerSeries.coeff e_min (θ i) = 0
        by_cases hi : (v i).1 = 0
        · dsimp [θ]
          rw [hi, map_zero, zero_pow hpa_ne, mul_zero, map_zero]
        · have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩
          have he_le : e_min ≤ e_ord i :=
            Finset.min'_le (S_nz.image e_ord) (e_ord i) (Finset.mem_image_of_mem e_ord hi_mem)
          have he_ne : e_min ≠ e_ord i := by
            intro heq
            exact hne (he_inj (heq.symm.trans hi_star_eq.symm))
          have he_lt : e_min < e_ord i := lt_of_le_of_ne he_le he_ne
          exact (PowerSeries.order_eq_nat.mp (hθ_ord i hi)).2 e_min he_lt
      · intro hnot
        exact absurd (Finset.mem_univ i_star) hnot
    have hθ_star_nz : PowerSeries.coeff e_min (θ i_star) ≠ 0 := by
      have hord_star : (θ i_star).order = (e_min : ℕ∞) := by
        rw [hθ_ord i_star hi_star_nz, hi_star_eq]
      exact (PowerSeries.order_eq_nat.mp hord_star).1
    intro hw0
    rw [hw0, map_zero, map_zero] at hcoeff_sum
    exact hθ_star_nz hcoeff_sum.symm
  have hw_van : ∀ ψ : A →+* E, ψ w_aux = 0 := by
    intro ψ
    let _ : Fintype E := Fintype.ofFinite E
    have hcard_E : Fintype.card E = Nat.card E := Nat.card_eq_fintype_card.symm
    have hpow_zero : (ψ w_aux) ^ (p ^ b) = 0 := by
      rw [show w_aux = ∑ i : ↥I, (b_vec i).1 * ((v i).1) ^ (p ^ a) from rfl,
        map_sum, sum_pow_char_pow]
      have hcongr : ∑ i : ↥I, (ψ ((b_vec i).1 * ((v i).1) ^ (p ^ a))) ^ (p ^ b) =
          ∑ i : ↥I, ψ (((b_vec i).1) ^ (p ^ b) * (v i).1) := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_mul, map_pow, mul_pow, ← pow_mul, hab, ← hcard_E, FiniteField.pow_card,
          map_mul, map_pow]
      rw [hcongr, ← map_sum, hv_rel, map_zero]
    exact eq_zero_of_pow_eq_zero hpow_zero
  exact ⟨w_aux, hw_mem, hw_ne, hw_van⟩

theorem weil_plane_curve_hensel_bombieri_upper_bound (F : Type u) [Finite F] [Field F] (D : ℕ) (hD : 1 ≤ D) :
    ∃ C_B : ℕ,
      ∀ (E : Type u) [Finite E] [Field E] [CharP E (ringChar F)]
        (G : Polynomial (Polynomial E)),
        G.Monic →
        1 ≤ G.natDegree →
        G.natDegree ≤ D →
        (∀ r ≤ G.natDegree, (G.coeff r).natDegree ≤ D) →
        Irreducible G →
        Polynomial.derivative G ≠ 0 →
        Nat.card { pt : E × E //
          (G.map (Polynomial.evalRingHom pt.1)).eval pt.2 = 0 ∧
          ((Polynomial.derivative G).map (Polynomial.evalRingHom pt.1)).eval pt.2 ≠ 0 } ≤
          Nat.card E + C_B * (Nat.sqrt (Nat.card E) + 1) :=
by
  classical
  let _ : Fintype F := Fintype.ofFinite F
  let p : ℕ := ringChar F
  have hp_prime : Nat.Prime p := CharP.char_is_prime F p
  have _ : Fact (Nat.Prime p) := ⟨hp_prime⟩
  have hp_ge2 : 2 ≤ p := hp_prime.two_le
  let D_max : ℕ := 2 * D
  let g_max : ℕ := (D_max - 1) * (D_max - 2) / 2
  let A₀ : ℕ := 2 * (g_max + D_max + 3)
  let C_B : ℕ := D * p * A₀ ^ 2 + D_max ^ 3 + 2 * g_max * p + g_max + 2 * D_max + 4
  refine ⟨C_B, ?_⟩
  intro E hFinE hFieldE hCharE G hMon hd1 hdD hdeg_T hIrr _hDeriv
  let _ : Fintype E := Fintype.ofFinite E
  have _ : CharP E p := hCharE
  set Q : ℕ := Nat.card E
  have hQ_fintype : Fintype.card E = Q := Nat.card_eq_fintype_card.symm
  let S_fin : Finset (E × E) :=
    Finset.univ.filter fun pt =>
      (G.map (Polynomial.evalRingHom pt.1)).eval pt.2 = 0 ∧
      ((Polynomial.derivative G).map (Polynomial.evalRingHom pt.1)).eval pt.2 ≠ 0
  have hcard_sm : Nat.card { pt : E × E //
      (G.map (Polynomial.evalRingHom pt.1)).eval pt.2 = 0 ∧
      ((Polynomial.derivative G).map (Polynomial.evalRingHom pt.1)).eval pt.2 ≠ 0 } = S_fin.card := by
    have heq : { pt : E × E //
        (G.map (Polynomial.evalRingHom pt.1)).eval pt.2 = 0 ∧
        ((Polynomial.derivative G).map (Polynomial.evalRingHom pt.1)).eval pt.2 ≠ 0 } ≃ ↥S_fin :=
      Equiv.subtypeEquivRight (fun pt => by simp [S_fin])
    rw [Nat.card_congr heq, Nat.card_eq_fintype_card, Fintype.card_coe]
  rw [hcard_sm]
  have hFiberBound : ∀ (P : Polynomial (Polynomial E)) (hP_mon : P.Monic)
      (T_set : Finset E) (Z_set : Finset (E × E)),
      (∀ q ∈ Z_set, q.1 ∈ T_set ∧ (P.map (Polynomial.evalRingHom q.1)).eval q.2 = 0) →
      Z_set.card ≤ T_set.card * P.natDegree := by
    intro P hP_mon T_set Z_set hZ
    let fib : E → Finset (E × E) := fun x =>
      (((P.map (Polynomial.evalRingHom x)).roots).toFinset).image (fun y => (x, y))
    have hsub : Z_set ⊆ T_set.biUnion fib := by
      intro q hq
      obtain ⟨hq1, hq2⟩ := hZ q hq
      rw [Finset.mem_biUnion]
      refine ⟨q.1, hq1, Finset.mem_image.mpr ⟨q.2, ?_, Prod.mk.eta⟩⟩
      have hmap_mon : (P.map (Polynomial.evalRingHom q.1)).Monic := hP_mon.map _
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hmap_mon.ne_zero]
      exact hq2
    calc Z_set.card ≤ (T_set.biUnion fib).card := Finset.card_le_card hsub
      _ ≤ ∑ x ∈ T_set, (fib x).card := Finset.card_biUnion_le
      _ ≤ ∑ _x ∈ T_set, P.natDegree := by
          refine Finset.sum_le_sum fun x _ => ?_
          have hmap_mon : (P.map (Polynomial.evalRingHom x)).Monic := hP_mon.map _
          have hmap_deg : (P.map (Polynomial.evalRingHom x)).natDegree = P.natDegree :=
            hP_mon.natDegree_map _
          calc (fib x).card ≤ (((P.map (Polynomial.evalRingHom x)).roots).toFinset).card :=
                Finset.card_image_le
            _ ≤ ((P.map (Polynomial.evalRingHom x)).roots).card := Multiset.toFinset_card_le _
            _ ≤ (P.map (Polynomial.evalRingHom x)).natDegree := Polynomial.card_roots' _
            _ = P.natDegree := hmap_deg
      _ = T_set.card * P.natDegree := by simp [Finset.sum_const, smul_eq_mul]
  have hS_triv : S_fin.card ≤ Q * G.natDegree := by
    have h1 := hFiberBound G hMon Finset.univ S_fin
      (fun pt hpt => ⟨Finset.mem_univ pt.1, (Finset.mem_filter.mp hpt).2.1⟩)
    rwa [Finset.card_univ, hQ_fintype] at h1
  rcases eq_or_lt_of_le hd1 with hdeg_eq1 | hd2
  · rw [← hdeg_eq1, mul_one] at hS_triv
    exact hS_triv.trans (Nat.le_add_right Q _)
  · by_cases hS_nonempty : S_fin.Nonempty
    · obtain ⟨⟨t₀, y₀⟩, hpt₀⟩ := hS_nonempty
      obtain ⟨hZero₀, hSmooth₀⟩ := (Finset.mem_filter.mp hpt₀).2
      obtain ⟨m_pos, _, hm_card⟩ := FiniteField.card E p
      set m : ℕ := (m_pos : ℕ)
      have hm_ge1 : 1 ≤ m := m_pos.pos
      have hQ_pow : Q = p ^ m := by
        rw [← hQ_fintype]
        exact hm_card
      let a : ℕ := m / 2
      let b : ℕ := m - a
      have hab_sum : a + b = m := Nat.add_sub_of_le (Nat.div_le_self m 2)
      have hab_card : p ^ a * p ^ b = Q := by
        rw [← pow_add, hab_sum, hQ_pow]
      have hpa_le_sqrt : p ^ a ≤ Nat.sqrt Q := by
        apply Nat.le_sqrt.mpr
        calc p ^ a * p ^ a = p ^ (a + a) := (pow_add p a a).symm
          _ ≤ p ^ m := Nat.pow_le_pow_right (by omega) (by dsimp [a]; omega)
          _ = Q := hQ_pow.symm
      have hpb_le_sqrt : p ^ b ≤ p * (Nat.sqrt Q + 1) := by
        have h2b : b + b ≤ m + 1 := by dsimp [b, a]; omega
        have hsq_lt : Q < (Nat.sqrt Q + 1) * (Nat.sqrt Q + 1) := Nat.lt_succ_sqrt Q
        have hmul_le : (p ^ b) * (p ^ b) ≤ (p * (Nat.sqrt Q + 1)) * (p * (Nat.sqrt Q + 1)) := by
          calc p ^ b * p ^ b = p ^ (b + b) := (pow_add p b b).symm
            _ ≤ p ^ (m + 1) := Nat.pow_le_pow_right (by omega) h2b
            _ = p * Q := by rw [pow_succ', hQ_pow]
            _ ≤ (p * p) * ((Nat.sqrt Q + 1) * (Nat.sqrt Q + 1)) := by
                refine Nat.mul_le_mul ?_ hsq_lt.le
                calc p = p * 1 := (mul_one p).symm
                  _ ≤ p * p := Nat.mul_le_mul_left p (by omega)
            _ = (p * (Nat.sqrt Q + 1)) * (p * (Nat.sqrt Q + 1)) := by ring
        exact Nat.mul_self_le_mul_self_iff.mp hmul_le
      by_cases hSmall : p ^ a < A₀
      · have hb_le_a1 : b ≤ a + 1 := by dsimp [b, a]; omega
        have hpb_le : p ^ b ≤ p * A₀ := by
          calc p ^ b ≤ p ^ (a + 1) := Nat.pow_le_pow_right (by omega) hb_le_a1
            _ = p * p ^ a := pow_succ' p a
            _ ≤ p * A₀ := Nat.mul_le_mul_left p hSmall.le
        have hQ_le : Q ≤ p * A₀ ^ 2 := by
          calc Q = p ^ a * p ^ b := hab_card.symm
            _ ≤ A₀ * (p * A₀) := Nat.mul_le_mul hSmall.le hpb_le
            _ = p * A₀ ^ 2 := by ring
        have hS_le_CB : S_fin.card ≤ C_B * (Nat.sqrt Q + 1) := by
          calc S_fin.card ≤ Q * G.natDegree := hS_triv
            _ ≤ (p * A₀ ^ 2) * D := Nat.mul_le_mul hQ_le hdD
            _ = (D * p * A₀ ^ 2) * 1 := by ring
            _ ≤ C_B * (Nat.sqrt Q + 1) := by
                refine Nat.mul_le_mul ?_ (Nat.le_add_left 1 (Nat.sqrt Q))
                dsimp [C_B]
                omega
        exact hS_le_CB.trans (Nat.le_add_left _ Q)
      · have hLarge : A₀ ≤ p ^ a := le_of_not_gt hSmall
        have hpb_ge1 : 1 ≤ p ^ b := Nat.one_le_pow b p (by omega)
        have hCard_ge : 2 * D + 2 ≤ Q := by
          calc 2 * D + 2 ≤ A₀ := by dsimp [A₀, D_max]; omega
            _ ≤ p ^ a := hLarge
            _ = p ^ a * 1 := (mul_one _).symm
            _ ≤ p ^ a * p ^ b := Nat.mul_le_mul_left _ hpb_ge1
            _ = Q := hab_card
        obtain ⟨D₁, G_tilde, e_pt, hD₁_lo, hD₁_hi, hMon_tilde, hDeg_tilde, hTri_tilde,
          hIrr_tilde, hG0_tilde, hSmooth0_tilde, hEquiv_tilde⟩ :=
          weil_plane_curve_origin_shear_monic_normalization E D G hMon hd2 hdD hdeg_T hIrr
            hCard_ge t₀ y₀ hZero₀ hSmooth₀
        let Z_tilde : Finset (E × E) :=
          Finset.univ.filter fun q => (G_tilde.map (Polynomial.evalRingHom q.1)).eval q.2 = 0
        have hS_le_Z : S_fin.card ≤ Z_tilde.card := by
          have hsub_img : S_fin.image e_pt ⊆ Z_tilde := by
            intro q hq
            obtain ⟨pt, hpt, rfl⟩ := Finset.mem_image.mp hq
            rw [Finset.mem_filter]
            exact ⟨Finset.mem_univ _, (hEquiv_tilde pt).mp (Finset.mem_filter.mp hpt).2.1⟩
          calc S_fin.card = (S_fin.image e_pt).card := (Finset.card_image_of_injective S_fin e_pt.injective).symm
            _ ≤ Z_tilde.card := Finset.card_le_card hsub_img
        let N_poly : Polynomial (Polynomial E) → Polynomial E :=
          fun H => (Algebra.leftMulMatrix (AdjoinRoot.powerBasis' hMon_tilde).basis
            (AdjoinRoot.mk G_tilde H)).det
        obtain ⟨hN_ne, hN_deg, hN_eval, hN_mult⟩ :=
          weil_plane_curve_triangular_leftMul_norm_bounds E D₁ hD₁_lo G_tilde hMon_tilde
            hDeg_tilde hTri_tilde hIrr_tilde
        obtain ⟨W, Φ, hW0, hWmul, hWrr, hWnorm⟩ :=
          weil_plane_curve_hensel_filtration_package E D₁ hD₁_lo G_tilde hMon_tilde
            hDeg_tilde hTri_tilde hG0_tilde hSmooth0_tilde
        let rep := AdjoinRoot.modByMonicHom hMon_tilde
        have hG_tilde_ne_one : G_tilde ≠ 1 := by
          intro h1
          have hd := congrArg Polynomial.natDegree h1
          rw [hDeg_tilde, Polynomial.natDegree_one] at hd
          omega
        have hrep_spec : ∀ u : AdjoinRoot G_tilde,
            (rep u).natDegree < D₁ ∧ AdjoinRoot.mk G_tilde (rep u) = u := by
          intro u
          obtain ⟨P, rfl⟩ := AdjoinRoot.mk_surjective u
          have hrep_eq : rep (AdjoinRoot.mk G_tilde P) = P %ₘ G_tilde :=
            AdjoinRoot.modByMonicHom_mk hMon_tilde P
          rw [hrep_eq]
          refine ⟨?_, ?_⟩
          · rw [← hDeg_tilde]
            exact Polynomial.natDegree_modByMonic_lt P hMon_tilde hG_tilde_ne_one
          · conv_rhs => rw [← Polynomial.modByMonic_add_div P G_tilde]
            rw [map_add, map_mul, AdjoinRoot.mk_self, zero_mul, add_zero]
        have hinj : ∀ (m' : ℕ) {u : AdjoinRoot G_tilde},
            u ∈ W m' → (∀ k ≤ m', PowerSeries.coeff k (Φ u) = 0) → u = 0 := by
          intro m' u hu hcoeff
          obtain ⟨hdeg_u, hmk_u⟩ := hrep_spec u
          obtain ⟨hTri_u, _, hdvd_plus⟩ := hWnorm m' u hu
          have hdvd_u : (Polynomial.X : Polynomial E) ^ (D₁ * m' + 1) ∣ N_poly (rep u) :=
            hdvd_plus hcoeff
          have hN_le : (N_poly (rep u)).natDegree ≤ D₁ * m' := hN_deg m' (rep u) hdeg_u hTri_u
          have hN_zero : N_poly (rep u) = 0 := by
            by_contra hN_nz
            have hle := Polynomial.natDegree_le_of_dvd hdvd_u hN_nz
            rw [Polynomial.natDegree_X_pow] at hle
            omega
          have hrep_zero : rep u = 0 := by
            by_contra hrep_nz
            exact hN_ne (rep u) hrep_nz hdeg_u hN_zero
          rw [← hmk_u, hrep_zero, map_zero]
        have hfinrank_le : ∀ m' : ℕ, Module.finrank E (W m') ≤ m' + 1 := by
          intro m'
          let τ : W m' →ₗ[E] (Fin (m' + 1) → E) :=
            LinearMap.pi fun k : Fin (m' + 1) =>
              (PowerSeries.coeff k.1).comp (Φ.toLinearMap.comp (W m').subtype)
          have hτ_inj : Function.Injective τ := by
            rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
            intro u hu_ker
            apply Subtype.ext
            refine hinj m' u.2 (fun k hk => ?_)
            have hk_lt : k < m' + 1 := by omega
            exact congrFun hu_ker ⟨k, hk_lt⟩
          have hle := LinearMap.finrank_le_finrank_of_injective hτ_inj
          rwa [Module.finrank_fin_fun E] at hle
        let g₁ : ℕ := (D₁ - 1) * (D₁ - 2) / 2
        have hg₁_le : g₁ ≤ g_max := by
          dsimp [g₁, g_max, D_max]
          exact Nat.div_le_div_right (Nat.mul_le_mul (by omega) (by omega))
        let M₁ : ℕ := p ^ a - 1
        let L₁ : ℕ := M₁ - g₁
        let q₂ : ℕ := (p ^ b * M₁) / L₁ + 1
        let M₂ : ℕ := q₂ + g_max + D_max + 2
        have hM₁_lt : M₁ < p ^ a := by
          dsimp [M₁, A₀] at *
          omega
        have hM₁_ge_D₁ : D₁ - 1 ≤ M₁ := by
          dsimp [M₁, A₀, D_max] at *
          omega
        have hM₂_ge_D₁ : D₁ - 1 ≤ M₂ := by
          have h1 : D₁ - 1 ≤ D_max := by dsimp [D_max]; omega
          exact h1.trans ((Nat.le_add_left D_max (q₂ + g_max)).trans (Nat.le_add_right _ 2))
        have hL₁_pos : 0 < L₁ := by
          dsimp [L₁, M₁, A₀, D_max] at *
          omega
        have hL₁_ge_g₁ : g₁ + 1 ≤ L₁ := by
          dsimp [L₁, M₁, A₀, D_max] at *
          omega
        have hpa_le_2L₁ : p ^ a ≤ 2 * L₁ := by
          dsimp [L₁, M₁, A₀, D_max] at *
          omega
        have hd₁_rr : M₁ + 1 ≤ Module.finrank E (W M₁) + g₁ := hWrr M₁ hM₁_ge_D₁
        have hd₂_rr : M₂ + 1 ≤ Module.finrank E (W M₂) + g₁ := hWrr M₂ hM₂_ge_D₁
        set d₁ : ℕ := Module.finrank E (W M₁)
        set d₂ : ℕ := Module.finrank E (W M₂)
        have hd₁_ge : L₁ + 1 ≤ d₁ := by
          dsimp [L₁] at *
          omega
        have hd₁_pos : 1 ≤ d₁ := by omega
        have hd₂_ge_q₂ : q₂ + 1 ≤ d₂ := by
          dsimp [M₂] at hd₂_rr
          omega
        have hdiv_lt : p ^ b * M₁ < L₁ * q₂ := by
          dsimp [q₂]
          have hmod := Nat.div_add_mod (p ^ b * M₁) L₁
          have hlt := Nat.mod_lt (p ^ b * M₁) hL₁_pos
          calc p ^ b * M₁ = L₁ * ((p ^ b * M₁) / L₁) + (p ^ b * M₁) % L₁ := hmod.symm
            _ < L₁ * ((p ^ b * M₁) / L₁) + L₁ := Nat.add_lt_add_left hlt _
            _ = L₁ * ((p ^ b * M₁) / L₁ + 1) := (Nat.mul_add_one L₁ _).symm
        have hDim_gt : Module.finrank E (W (p ^ b * M₁ + M₂)) < d₁ * d₂ := by
          have h3 : Module.finrank E (W (p ^ b * M₁ + M₂)) ≤ p ^ b * M₁ + M₂ + 1 :=
            hfinrank_le (p ^ b * M₁ + M₂)
          have hprod_ge : (L₁ + 1) * d₂ ≤ d₁ * d₂ := Nat.mul_le_mul_right d₂ hd₁_ge
          have hL₁_d₂ : L₁ * (q₂ + 1) ≤ L₁ * d₂ := Nat.mul_le_mul_left L₁ hd₂_ge_q₂
          calc Module.finrank E (W (p ^ b * M₁ + M₂))
              ≤ p ^ b * M₁ + M₂ + 1 := h3
            _ < L₁ * q₂ + (d₂ + g₁ + 1) := by omega
            _ ≤ L₁ * q₂ + L₁ + d₂ := by omega
            _ = L₁ * (q₂ + 1) + d₂ := by ring
            _ ≤ L₁ * d₂ + d₂ := Nat.add_le_add_right hL₁_d₂ d₂
            _ = (L₁ + 1) * d₂ := by ring
            _ ≤ d₁ * d₂ := hprod_ge
        obtain ⟨w_aux, hw_mem, hw_ne, hw_van⟩ :=
          weil_filtered_algebra_frobenius_auxiliary_vanishing E p (AdjoinRoot G_tilde)
            W Φ hW0 hWmul hinj a b M₁ M₂ hab_card hM₁_lt hd₁_pos hDim_gt
        set M_tot : ℕ := M₁ + p ^ a * M₂
        let F_aux : Polynomial (Polynomial E) := rep w_aux
        obtain ⟨hF_deg, hF_mk⟩ := hrep_spec w_aux
        have hF_ne : F_aux ≠ 0 := by
          intro h0
          apply hw_ne
          rw [← hF_mk]
          exact (congrArg (AdjoinRoot.mk G_tilde) h0).trans (map_zero _)
        have hF_eval_zero : ∀ q ∈ Z_tilde,
            (F_aux.map (Polynomial.evalRingHom q.1)).eval q.2 = 0 := by
          intro q hq
          have hG_q : (G_tilde.map (Polynomial.evalRingHom q.1)).eval q.2 = 0 :=
            (Finset.mem_filter.mp hq).2
          have hG_eval2 : Polynomial.eval₂ (Polynomial.evalRingHom q.1) q.2 G_tilde = 0 := by
            rwa [← Polynomial.eval_map]
          let ψ : AdjoinRoot G_tilde →+* E :=
            AdjoinRoot.lift (Polynomial.evalRingHom q.1) q.2 hG_eval2
          have hψ_w : ψ w_aux = 0 := hw_van ψ
          rw [Polynomial.eval_map]
          calc Polynomial.eval₂ (Polynomial.evalRingHom q.1) q.2 F_aux
              = ψ (AdjoinRoot.mk G_tilde F_aux) := (AdjoinRoot.lift_mk hG_eval2 F_aux).symm
            _ = ψ w_aux := congrArg ψ hF_mk
            _ = 0 := hψ_w
        let Z_A : Finset (E × E) := Z_tilde.filter fun q => q.1 = 0
        let Z_B : Finset (E × E) := Z_tilde.filter fun q =>
          q.1 ≠ 0 ∧ ((Polynomial.derivative G_tilde).map (Polynomial.evalRingHom q.1)).eval q.2 = 0
        let Z_C : Finset (E × E) := Z_tilde.filter fun q =>
          q.1 ≠ 0 ∧ ((Polynomial.derivative G_tilde).map (Polynomial.evalRingHom q.1)).eval q.2 ≠ 0
        have hZ_part : Z_tilde ⊆ Z_A ∪ (Z_B ∪ Z_C) := by
          intro q hq
          by_cases hq1 : q.1 = 0
          · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨hq, hq1⟩)
          · apply Finset.mem_union_right
            by_cases hder : ((Polynomial.derivative G_tilde).map (Polynomial.evalRingHom q.1)).eval q.2 = 0
            · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨hq, hq1, hder⟩)
            · exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨hq, hq1, hder⟩)
        have hZA_le : Z_A.card ≤ D₁ := by
          have h1 := hFiberBound G_tilde hMon_tilde ({0} : Finset E) Z_A (fun q hq => by
            obtain ⟨hqZ, hq0⟩ := Finset.mem_filter.mp hq
            exact ⟨Finset.mem_singleton.mpr hq0, (Finset.mem_filter.mp hqZ).2⟩)
          rwa [Finset.card_singleton, one_mul, hDeg_tilde] at h1
        have hZB_le : Z_B.card ≤ D₁ ^ 2 * (D₁ - 1) := by
          let G' : Polynomial (Polynomial E) := Polynomial.derivative G_tilde
          have hG'_ne : G' ≠ 0 := by
            intro h0
            apply hSmooth0_tilde
            change ((G'.map (Polynomial.evalRingHom 0)).eval 0) = 0
            rw [h0, Polynomial.map_zero, Polynomial.eval_zero]
          have hG'_deg : G'.natDegree < D₁ := by
            rw [← hDeg_tilde]
            exact Polynomial.natDegree_derivative_lt (by rw [hDeg_tilde]; omega)
          have hG'_tri : ∀ (i j : ℕ), D₁ - 1 < i + j → (G'.coeff i).coeff j = 0 := by
            intro i j hij
            have hij' : D₁ < (i + 1) + j := by omega
            have hc0 : (G_tilde.coeff (i + 1)).coeff j = 0 := hTri_tilde (i + 1) j hij'
            dsimp [G']
            rw [Polynomial.coeff_derivative, ← Nat.cast_add_one, mul_comm, ← nsmul_eq_mul]
            change Polynomial.lcoeff E j ((i + 1) • G_tilde.coeff (i + 1)) = 0
            rw [map_nsmul, Polynomial.lcoeff_apply, hc0, nsmul_zero]
          have hNG'_ne : N_poly G' ≠ 0 := hN_ne G' hG'_ne hG'_deg
          have hNG'_deg : (N_poly G').natDegree ≤ D₁ * (D₁ - 1) :=
            hN_deg (D₁ - 1) G' hG'_deg hG'_tri
          let R_B : Finset E := ((N_poly G').roots).toFinset
          have hZB_fib := hFiberBound G_tilde hMon_tilde R_B Z_B (fun q hq => by
            obtain ⟨hqZ, _, hder0⟩ := Finset.mem_filter.mp hq
            have hGz : (G_tilde.map (Polynomial.evalRingHom q.1)).eval q.2 = 0 :=
              (Finset.mem_filter.mp hqZ).2
            have hNeval : (N_poly G').eval q.1 = 0 := hN_eval G' q.1 q.2 hGz hder0
            refine ⟨?_, hGz⟩
            rw [Multiset.mem_toFinset, Polynomial.mem_roots hNG'_ne]
            exact hNeval)
          have hRB_card : R_B.card ≤ D₁ * (D₁ - 1) := by
            calc R_B.card ≤ ((N_poly G').roots).card := Multiset.toFinset_card_le _
              _ ≤ (N_poly G').natDegree := Polynomial.card_roots' _
              _ ≤ D₁ * (D₁ - 1) := hNG'_deg
          rw [hDeg_tilde] at hZB_fib
          calc Z_B.card ≤ R_B.card * D₁ := hZB_fib
            _ ≤ (D₁ * (D₁ - 1)) * D₁ := Nat.mul_le_mul_right D₁ hRB_card
            _ = D₁ ^ 2 * (D₁ - 1) := by ring
        have hZC_le : Z_C.card ≤ M_tot := by
          obtain ⟨hF_tri, hF_dvd_X, _⟩ := hWnorm M_tot w_aux hw_mem
          have hNF_ne : N_poly F_aux ≠ 0 := hN_ne F_aux hF_ne hF_deg
          have hNF_deg : (N_poly F_aux).natDegree ≤ D₁ * M_tot :=
            hN_deg M_tot F_aux hF_deg hF_tri
          rcases hF_dvd_X with ⟨H_quot, hNF_eq₀⟩
          have hNF_eq : N_poly F_aux = Polynomial.X ^ ((D₁ - 1) * M_tot) * H_quot := hNF_eq₀
          have hXpow_ne : (Polynomial.X : Polynomial E) ^ ((D₁ - 1) * M_tot) ≠ 0 :=
            pow_ne_zero _ Polynomial.X_ne_zero
          have hHq_ne : H_quot ≠ 0 := by
            intro h0
            rw [h0, mul_zero] at hNF_eq
            exact hNF_ne hNF_eq
          have hHq_deg : H_quot.natDegree ≤ M_tot := by
            have hdeg_mul : (N_poly F_aux).natDegree =
                (D₁ - 1) * M_tot + H_quot.natDegree := by
              rw [hNF_eq, Polynomial.natDegree_mul hXpow_ne hHq_ne, Polynomial.natDegree_X_pow]
            have hsum_eq : (D₁ - 1) * M_tot + M_tot = D₁ * M_tot := by
              calc (D₁ - 1) * M_tot + M_tot = ((D₁ - 1) + 1) * M_tot := by ring
                _ = D₁ * M_tot := by rw [Nat.sub_add_cancel (by omega)]
            omega
          let U_nz : Finset E := (Finset.univ : Finset E).erase 0
          let S_fib : E → Finset E := fun x₁ => Finset.univ.filter fun y => (x₁, y) ∈ Z_C
          have hdvd_each : ∀ x₁ ∈ U_nz,
              (Polynomial.X - Polynomial.C x₁) ^ (S_fib x₁).card ∣ H_quot := by
            intro x₁ hx₁
            have hx₁_ne : x₁ ≠ 0 := (Finset.mem_erase.mp hx₁).1
            have hdvd_NF : (Polynomial.X - Polynomial.C x₁) ^ (S_fib x₁).card ∣ N_poly F_aux := by
              refine hN_mult F_aux x₁ (S_fib x₁) (fun y hy => ?_)
              have hmemC : (x₁, y) ∈ Z_C := (Finset.mem_filter.mp hy).2
              obtain ⟨hmemZ, _, hsm⟩ := Finset.mem_filter.mp hmemC
              exact ⟨(Finset.mem_filter.mp hmemZ).2, hsm, hF_eval_zero (x₁, y) hmemZ⟩
            rw [hNF_eq, mul_comm] at hdvd_NF
            have hcop_base : IsCoprime (Polynomial.X - Polynomial.C x₁)
                (Polynomial.X : Polynomial E) := by
              refine ⟨-Polynomial.C x₁⁻¹, Polynomial.C x₁⁻¹, ?_⟩
              calc -Polynomial.C x₁⁻¹ * (Polynomial.X - Polynomial.C x₁) +
                    Polynomial.C x₁⁻¹ * Polynomial.X
                  = Polynomial.C x₁⁻¹ * Polynomial.C x₁ := by ring
                _ = Polynomial.C (x₁⁻¹ * x₁) := (map_mul Polynomial.C x₁⁻¹ x₁).symm
                _ = 1 := by rw [inv_mul_cancel₀ hx₁_ne, Polynomial.C_1]
            exact (hcop_base.pow).dvd_of_dvd_mul_right hdvd_NF
          have hcop_pair : (U_nz : Set E).Pairwise fun x₁ x₂ =>
              IsCoprime ((Polynomial.X - Polynomial.C x₁) ^ (S_fib x₁).card)
                ((Polynomial.X - Polynomial.C x₂) ^ (S_fib x₂).card) := by
            intro x₁ _ x₂ _ hne
            have hsub_ne : x₂ - x₁ ≠ 0 := sub_ne_zero.mpr hne.symm
            have hbase : IsCoprime (Polynomial.X - Polynomial.C x₁)
                (Polynomial.X - Polynomial.C x₂) := by
              refine ⟨Polynomial.C (x₂ - x₁)⁻¹, -Polynomial.C (x₂ - x₁)⁻¹, ?_⟩
              calc Polynomial.C (x₂ - x₁)⁻¹ * (Polynomial.X - Polynomial.C x₁) +
                    (-Polynomial.C (x₂ - x₁)⁻¹) * (Polynomial.X - Polynomial.C x₂)
                  = Polynomial.C (x₂ - x₁)⁻¹ * (Polynomial.C x₂ - Polynomial.C x₁) := by ring
                _ = Polynomial.C ((x₂ - x₁)⁻¹ * (x₂ - x₁)) := by
                    rw [← map_sub, ← Polynomial.C_mul]
                _ = 1 := by rw [inv_mul_cancel₀ hsub_ne, Polynomial.C_1]
            exact hbase.pow
          have hprod_dvd : (∏ x₁ ∈ U_nz,
              (Polynomial.X - Polynomial.C x₁) ^ (S_fib x₁).card) ∣ H_quot :=
            Finset.prod_dvd_of_coprime hcop_pair hdvd_each
          have hprod_deg : (∏ x₁ ∈ U_nz,
              (Polynomial.X - Polynomial.C x₁) ^ (S_fib x₁).card).natDegree =
              ∑ x₁ ∈ U_nz, (S_fib x₁).card := by
            rw [Polynomial.natDegree_prod_of_monic U_nz _
              (fun x₁ _ => (Polynomial.monic_X_sub_C x₁).pow _)]
            refine Finset.sum_congr rfl fun x₁ _ => ?_
            rw [(Polynomial.monic_X_sub_C x₁).natDegree_pow, Polynomial.natDegree_X_sub_C, mul_one]
          have hsum_le_M : ∑ x₁ ∈ U_nz, (S_fib x₁).card ≤ M_tot := by
            rw [← hprod_deg]
            exact (Polynomial.natDegree_le_of_dvd hprod_dvd hHq_ne).trans hHq_deg
          have hZC_eq : Z_C = U_nz.biUnion (fun x₁ => (S_fib x₁).image (fun y => (x₁, y))) := by
            ext q
            rw [Finset.mem_biUnion]
            constructor
            · intro hq
              have hq1_ne : q.1 ≠ 0 := (Finset.mem_filter.mp hq).2.1
              refine ⟨q.1, Finset.mem_erase.mpr ⟨hq1_ne, Finset.mem_univ _⟩, ?_⟩
              exact Finset.mem_image.mpr ⟨q.2, Finset.mem_filter.mpr ⟨Finset.mem_univ _, by simpa using hq⟩, Prod.mk.eta⟩
            · rintro ⟨x₁, _, hy⟩
              obtain ⟨y, hy_mem, rfl⟩ := Finset.mem_image.mp hy
              exact (Finset.mem_filter.mp hy_mem).2
          have hZC_card_le_sum : Z_C.card ≤ ∑ x₁ ∈ U_nz, (S_fib x₁).card := by
            rw [hZC_eq]
            exact Finset.card_biUnion_le.trans
              (Finset.sum_le_sum fun x₁ _ => Finset.card_image_le)
          exact hZC_card_le_sum.trans hsum_le_M
        have hZ_le_sum : Z_tilde.card ≤ D₁ + D₁ ^ 2 * (D₁ - 1) + M_tot := by
          calc Z_tilde.card ≤ (Z_A ∪ (Z_B ∪ Z_C)).card := Finset.card_le_card hZ_part
            _ ≤ Z_A.card + (Z_B ∪ Z_C).card := Finset.card_union_le _ _
            _ ≤ Z_A.card + (Z_B.card + Z_C.card) :=
                Nat.add_le_add_left (Finset.card_union_le _ _) _
            _ ≤ D₁ + (D₁ ^ 2 * (D₁ - 1) + M_tot) :=
                Nat.add_le_add hZA_le (Nat.add_le_add hZB_le hZC_le)
            _ = D₁ + D₁ ^ 2 * (D₁ - 1) + M_tot := (Nat.add_assoc _ _ _).symm
        have hM₁_split : M₁ = g₁ + L₁ := by
          dsimp [L₁, M₁, A₀, D_max] at *
          omega
        have hq₂_eq : q₂ = (p ^ b * g₁) / L₁ + p ^ b + 1 := by
          dsimp [q₂]
          have hnum : p ^ b * M₁ = p ^ b * g₁ + L₁ * p ^ b := by
            rw [hM₁_split]
            ring
          rw [hnum, Nat.add_mul_div_left (p ^ b * g₁) (p ^ b) hL₁_pos]
        have hterm_frac : p ^ a * ((p ^ b * g₁) / L₁) ≤ (2 * g_max * p) * (Nat.sqrt Q + 1) := by
          calc p ^ a * ((p ^ b * g₁) / L₁)
              ≤ (2 * L₁) * ((p ^ b * g₁) / L₁) := Nat.mul_le_mul_right _ hpa_le_2L₁
            _ = 2 * (L₁ * ((p ^ b * g₁) / L₁)) := by ring
            _ ≤ 2 * (p ^ b * g₁) := Nat.mul_le_mul_left 2 (Nat.mul_div_le (p ^ b * g₁) L₁)
            _ ≤ 2 * (p ^ b * g_max) :=
                Nat.mul_le_mul_left 2 (Nat.mul_le_mul_left (p ^ b) hg₁_le)
            _ = (2 * g_max) * p ^ b := by ring
            _ ≤ (2 * g_max) * (p * (Nat.sqrt Q + 1)) :=
                Nat.mul_le_mul_left (2 * g_max) hpb_le_sqrt
            _ = (2 * g_max * p) * (Nat.sqrt Q + 1) := by ring
        have hpa_le_s1 : p ^ a ≤ Nat.sqrt Q + 1 :=
          hpa_le_sqrt.trans (Nat.le_succ _)
        have hM₁_le_pa : M₁ ≤ p ^ a := Nat.sub_le (p ^ a) 1
        have hterm_lin : M₁ + p ^ a * (g_max + D_max + 3) ≤
            (g_max + D_max + 4) * (Nat.sqrt Q + 1) := by
          calc M₁ + p ^ a * (g_max + D_max + 3)
              ≤ p ^ a + p ^ a * (g_max + D_max + 3) := Nat.add_le_add_right hM₁_le_pa _
            _ = (g_max + D_max + 4) * p ^ a := by ring
            _ ≤ (g_max + D_max + 4) * (Nat.sqrt Q + 1) :=
                Nat.mul_le_mul_left _ hpa_le_s1
        have hD₁_part : D₁ + D₁ ^ 2 * (D₁ - 1) ≤ (D_max ^ 3 + D_max) * (Nat.sqrt Q + 1) := by
          have h1 : D₁ ^ 2 * (D₁ - 1) ≤ D_max ^ 3 := by
            calc D₁ ^ 2 * (D₁ - 1) ≤ D_max ^ 2 * D_max :=
                  Nat.mul_le_mul (Nat.pow_le_pow_left hD₁_hi 2) ((Nat.sub_le D₁ 1).trans hD₁_hi)
              _ = D_max ^ 3 := by ring
          calc D₁ + D₁ ^ 2 * (D₁ - 1)
              ≤ D_max + D_max ^ 3 := Nat.add_le_add hD₁_hi h1
            _ = (D_max ^ 3 + D_max) * 1 := by ring
            _ ≤ (D_max ^ 3 + D_max) * (Nat.sqrt Q + 1) :=
                Nat.mul_le_mul_left _ (Nat.le_add_left 1 (Nat.sqrt Q))
        have hMtot_expand : M_tot = Q + p ^ a * ((p ^ b * g₁) / L₁) +
            (M₁ + p ^ a * (g_max + D_max + 3)) := by
          dsimp [M_tot, M₂]
          rw [hq₂_eq, ← hab_card]
          ring
        calc S_fin.card ≤ Z_tilde.card := hS_le_Z
          _ ≤ D₁ + D₁ ^ 2 * (D₁ - 1) + M_tot := hZ_le_sum
          _ = Q + ((D₁ + D₁ ^ 2 * (D₁ - 1)) + p ^ a * ((p ^ b * g₁) / L₁) +
                (M₁ + p ^ a * (g_max + D_max + 3))) := by
              rw [hMtot_expand]
              ring
          _ ≤ Q + ((D_max ^ 3 + D_max) * (Nat.sqrt Q + 1) +
                (2 * g_max * p) * (Nat.sqrt Q + 1) +
                (g_max + D_max + 4) * (Nat.sqrt Q + 1)) := by
              refine Nat.add_le_add_left ?_ Q
              exact Nat.add_le_add (Nat.add_le_add hD₁_part hterm_frac) hterm_lin
          _ = Q + (D_max ^ 3 + 2 * g_max * p + g_max + 2 * D_max + 4) * (Nat.sqrt Q + 1) := by
              ring
          _ ≤ Q + C_B * (Nat.sqrt Q + 1) := by
              refine Nat.add_le_add_left (Nat.mul_le_mul_right _ ?_) Q
              dsimp [C_B]
              omega
    · rw [Finset.not_nonempty_iff_eq_empty.mp hS_nonempty, Finset.card_empty]
      exact Nat.zero_le _

theorem weil_bivariate_monic_trace_discriminant_conductor (D_T : ℕ) (hDT : 1 ≤ D_T)
    (E : Type u) [Field E]
    (G : Polynomial (Polynomial E))
    (hMon : G.Monic)
    (hDegPos : 1 ≤ G.natDegree)
    (hCoeffDeg : ∀ r ≤ G.natDegree, (G.coeff r).natDegree ≤ D_T)
    (hIrr : Irreducible G)
    (hDeriv : Polynomial.derivative G ≠ 0) :
    ∃ δ_G : Polynomial E,
      δ_G ≠ 0 ∧
      δ_G.natDegree ≤ 3 * G.natDegree ^ 2 * D_T ∧
      (∀ (K : Type u) [Field K] [Algebra E K] (x₀ y₀ : K),
        Polynomial.aeval x₀ δ_G ≠ 0 →
        (G.map (Polynomial.aeval x₀).toRingHom).eval y₀ = 0 →
        ((Polynomial.derivative G).map (Polynomial.aeval x₀).toRingHom).eval y₀ ≠ 0) ∧
      (∀ (K : Type u) [Field K] [IsAlgClosed K] [Algebra E K] (x₀ : K),
        Polynomial.aeval x₀ δ_G ≠ 0 →
        ((G.map (Polynomial.aeval x₀).toRingHom).roots).Nodup ∧
          ((G.map (Polynomial.aeval x₀).toRingHom).roots).card = G.natDegree) ∧
      (∀ (K_ext : Type u) [Field K_ext] [Algebra E K_ext]
         (Δ₀ : Polynomial K_ext)
         (M : Type u) [Field M] [Algebra (Polynomial K_ext) M] [Algebra (RatFunc K_ext) M]
         [IsScalarTower (Polynomial K_ext) (RatFunc K_ext) M]
         [FiniteDimensional (RatFunc K_ext) M],
        Module.finrank (RatFunc K_ext) M = G.natDegree →
        ∀ (w : M),
          (G.map ((algebraMap (Polynomial K_ext) M).comp
            (Polynomial.mapRingHom (algebraMap E K_ext)))).eval w = 0 →
          IntermediateField.adjoin (RatFunc K_ext) ({w} : Set M) = ⊤ →
          ∀ (u : M) (m : ℕ),
            IsIntegral (Polynomial K_ext) (((algebraMap (Polynomial K_ext) M Δ₀) ^ m) * u) →
            ∃ r : Fin G.natDegree → Polynomial K_ext,
              (((algebraMap (Polynomial K_ext) M Δ₀) ^ m) *
                (algebraMap (Polynomial K_ext) M (δ_G.map (algebraMap E K_ext)))) * u =
              ∑ j : Fin G.natDegree, (algebraMap (Polynomial K_ext) M (r j)) * w ^ (j : ℕ)) :=
by
  classical
  have _ := hDegPos
  set N := G.natDegree
  let compMat {R : Type u} [CommRing R] (f : Polynomial R) : Matrix (Fin N) (Fin N) R :=
    Matrix.of fun r c =>
      if (c : ℕ) + 1 < N then
        if (r : ℕ) = (c : ℕ) + 1 then 1 else 0
      else
        -f.coeff (r : ℕ)
  let compTraceMat {R : Type u} [CommRing R] (f : Polynomial R) : Matrix (Fin N) (Fin N) R :=
    Matrix.of fun i j => Matrix.trace ((compMat f) ^ ((i : ℕ) + (j : ℕ)))
  let δ_G : Polynomial E := (compTraceMat G).det

  have hMapComp : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (f : Polynomial R),
      φ.mapMatrix (compMat f) = compMat (f.map φ) := by
    intro R S _ _ φ f
    ext r c
    simp only [compMat, RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
    split_ifs with hc hrc
    · exact map_one φ
    · exact map_zero φ
    · rw [map_neg, Polynomial.coeff_map]

  have hMapTrace : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (f : Polynomial R),
      φ.mapMatrix (compTraceMat f) = compTraceMat (f.map φ) := by
    intro R S _ _ φ f
    ext i j
    simp only [compTraceMat, RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply,
      Matrix.trace, Matrix.diag, map_sum]
    have hpow : φ.mapMatrix ((compMat f) ^ ((i : ℕ) + (j : ℕ))) =
        (compMat (f.map φ)) ^ ((i : ℕ) + (j : ℕ)) := by
      rw [map_pow, hMapComp]
    refine Finset.sum_congr rfl fun s _ => ?_
    exact congrFun (congrFun hpow s) s

  have hMapDet : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (f : Polynomial R),
      φ (compTraceMat f).det = (compTraceMat (f.map φ)).det := by
    intro R S _ _ φ f
    rw [RingHom.map_det, hMapTrace]

  have hBridge : ∀ {R A : Type u} [CommRing R] [CommRing A] [Algebra R A]
      (f : Polynomial R) (hf_mon : f.Monic) (hf_deg : f.natDegree = N)
      (w : A) (hw : Polynomial.aeval w f = 0)
      (b : Module.Basis (Fin N) R A) (hb : ∀ k : Fin N, b k = w ^ (k : ℕ)),
      Algebra.traceMatrix R b = compTraceMat f := by
    intro R A _ _ _ f hf_mon hf_deg w hw b hb
    have hLeftMul : Algebra.leftMulMatrix b w = compMat f := by
      ext r c
      rw [Algebra.leftMulMatrix_eq_repr_mul, hb c, ← pow_succ']
      dsimp only [compMat, Matrix.of_apply]
      by_cases hc : (c : ℕ) + 1 < N
      · simp only [hc, ↓reduceIte]
        let c' : Fin N := ⟨(c : ℕ) + 1, hc⟩
        have hwc : w ^ ((c : ℕ) + 1) = b c' := (hb c').symm
        rw [hwc, b.repr_self, Finsupp.single_apply]
        by_cases hrc : c' = r
        · have hval : (r : ℕ) = (c : ℕ) + 1 := by
            have := congrArg Fin.val hrc
            exact this.symm
          simp only [hrc, hval, ↓reduceIte]
        · have hval : (r : ℕ) ≠ (c : ℕ) + 1 := by
            intro heq
            apply hrc
            exact Fin.ext heq.symm
          simp only [hrc, hval, ↓reduceIte]
      · simp only [hc, ↓reduceIte]
        have hc_eq : (c : ℕ) + 1 = N := by omega
        rw [hc_eq]
        have hf_sum := Polynomial.as_sum_range' f (N + 1) (by omega)
        have hcoeffN : f.coeff N = 1 := by
          rw [← hf_deg]
          exact hf_mon.leadingCoeff
        have haeval_zero : (∑ k : Fin N, (f.coeff (k : ℕ)) • b k) + w ^ N = 0 := by
          have h0 := hw
          conv_lhs at h0 => rw [hf_sum, Finset.sum_range_succ]
          rw [map_add, map_sum, Polynomial.aeval_monomial, hcoeffN, map_one, one_mul,
            ← Fin.sum_univ_eq_sum_range] at h0
          convert h0 using 2
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [Polynomial.aeval_monomial, hb k, Algebra.smul_def]
        have hwN : w ^ N = ∑ k : Fin N, (-f.coeff (k : ℕ)) • b k := by
          have hneg := eq_neg_of_add_eq_zero_right haeval_zero
          rw [hneg, ← Finset.sum_neg_distrib]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [neg_smul]
        rw [hwN, map_sum, Finsupp.finsetSum_apply]
        have hsingle : ∀ k : Fin N, (b.repr ((-f.coeff (k : ℕ)) • b k)) r =
            if k = r then -f.coeff (k : ℕ) else 0 := by
          intro k
          rw [map_smul, b.repr_self, Finsupp.smul_apply, Finsupp.single_apply, smul_eq_mul]
          split_ifs <;> ring
        simp_rw [hsingle]
        rw [Finset.sum_ite_eq' Finset.univ r]
        simp
    ext i j
    rw [Algebra.traceMatrix_apply, Algebra.traceForm_apply, hb i, hb j, ← pow_add,
      Algebra.trace_eq_matrix_trace b, map_pow, hLeftMul]
    rfl

  have hδ_ne : δ_G ≠ 0 := by
    let ι_E : Polynomial E →+* RatFunc E := algebraMap (Polynomial E) (RatFunc E)
    have hι_inj : Function.Injective ι_E := IsFractionRing.injective (Polynomial E) (RatFunc E)
    let G_rat : Polynomial (RatFunc E) := G.map ι_E
    have hMon_rat : G_rat.Monic := hMon.map ι_E
    have hDeg_rat : G_rat.natDegree = N := hMon.natDegree_map ι_E
    have hIrr_rat : Irreducible G_rat :=
      (Polynomial.Monic.irreducible_iff_irreducible_map_fraction_map hMon).mp hIrr
    have hDer_rat : Polynomial.derivative G_rat ≠ 0 := by
      rw [Polynomial.derivative_map]
      intro h0
      apply hDeriv
      exact Polynomial.map_injective ι_E hι_inj (by simpa using h0)
    have hSep_rat : G_rat.Separable :=
      (Polynomial.separable_iff_derivative_ne_zero hIrr_rat).mpr hDer_rat
    have : Fact (Irreducible G_rat) := ⟨hIrr_rat⟩
    let L_rat := AdjoinRoot G_rat
    let pb : PowerBasis (RatFunc E) L_rat := AdjoinRoot.powerBasis' hMon_rat
    have hpb_dim : pb.dim = N := (AdjoinRoot.powerBasis'_dim hMon_rat).trans hDeg_rat
    let α : L_rat := AdjoinRoot.root G_rat
    have haeval_α : Polynomial.aeval α G_rat = 0 := by
      rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
    have hmin_α : minpoly (RatFunc E) α = G_rat :=
      (minpoly.eq_of_irreducible_of_monic hIrr_rat haeval_α hMon_rat).symm
    have hSep_α : IsSeparable (RatFunc E) α := by
      rw [IsSeparable, hmin_α]
      exact hSep_rat
    let K_top : IntermediateField (RatFunc E) L_rat :=
      IntermediateField.adjoin (RatFunc E) ({α} : Set L_rat)
    have hK_top : K_top = ⊤ := by
      rw [eq_top_iff]
      intro x _
      induction x using AdjoinRoot.induction_on with
      | ih p =>
        exact (IntermediateField.mem_adjoin_simple_iff (RatFunc E) _).mpr
          ⟨p, 1, by rw [map_one, div_one]; exact (AdjoinRoot.aeval_eq p).symm⟩
    have hSep_Ktop : Algebra.IsSeparable (RatFunc E) ↥K_top := by
      rw [IntermediateField.isSeparable_adjoin_iff_isSeparable]
      intro x hx
      rw [Set.mem_singleton_iff.mp hx]
      exact hSep_α
    let e_Ktop : L_rat ≃ₐ[RatFunc E] ↥K_top :=
      ((IntermediateField.equivOfEq hK_top).trans IntermediateField.topEquiv).symm
    have : Algebra.IsSeparable (RatFunc E) L_rat :=
      @Algebra.IsSeparable.of_algHom (RatFunc E) _ L_rat ↥K_top _ _ _ _ hSep_Ktop e_Ktop.toAlgHom
    let e_idx : Fin pb.dim ≃ Fin N := finCongr hpb_dim
    let b_rat : Module.Basis (Fin N) (RatFunc E) L_rat := pb.basis.reindex e_idx
    have hb_rat : ∀ k : Fin N, b_rat k = α ^ (k : ℕ) := by
      intro k
      rw [Module.Basis.reindex_apply, PowerBasis.basis_eq_pow, AdjoinRoot.powerBasis'_gen]
      rfl
    have hTr_eq : compTraceMat G_rat =
        Matrix.reindex e_idx e_idx (Algebra.traceMatrix (RatFunc E) pb.basis) := by
      rw [← hBridge G_rat hMon_rat hDeg_rat α haeval_α b_rat hb_rat, Algebra.traceMatrix_reindex]
    have hdet_rat_ne : (compTraceMat G_rat).det ≠ 0 := by
      rw [hTr_eq, Matrix.det_reindex_self]
      exact det_traceMatrix_ne_zero' pb
    intro hδ0
    apply hdet_rat_ne
    rw [← hMapDet ι_E G]
    change ι_E δ_G = 0
    rw [hδ0, map_zero]

  have hδ_deg : δ_G.natDegree ≤ 3 * N ^ 2 * D_T := by
    let C := compMat G
    let T := compTraceMat G
    have hC_deg : ∀ r c : Fin N, (C r c).natDegree ≤ D_T := by
      intro r c
      dsimp only [C, compMat, Matrix.of_apply]
      split_ifs with hc hrc
      · rw [Polynomial.natDegree_one]; omega
      · rw [Polynomial.natDegree_zero]; omega
      · rw [Polynomial.natDegree_neg]
        exact hCoeffDeg (r : ℕ) (Nat.le_of_lt r.isLt)
    have hCk_deg : ∀ (k : ℕ) (r c : Fin N), ((C ^ k) r c).natDegree ≤ k * D_T := by
      intro k
      induction k with
      | zero =>
        intro r c
        rw [pow_zero, Matrix.one_apply]
        split_ifs
        · simp
        · simp
      | succ k ih =>
        intro r c
        rw [pow_succ, Matrix.mul_apply]
        refine Polynomial.natDegree_sum_le_of_forall_le _ _ fun s _ => ?_
        calc ((C ^ k) r s * C s c).natDegree
            ≤ ((C ^ k) r s).natDegree + (C s c).natDegree := Polynomial.natDegree_mul_le
          _ ≤ k * D_T + D_T := Nat.add_le_add (ih r s) (hC_deg s c)
          _ = (k + 1) * D_T := by ring
    have hT_deg : ∀ i j : Fin N, (T i j).natDegree ≤ 3 * N * D_T := by
      intro i j
      dsimp only [T, compTraceMat, Matrix.of_apply, Matrix.trace, Matrix.diag]
      have hij : ((i : ℕ) + (j : ℕ)) * D_T ≤ 3 * N * D_T := by
        have : (i : ℕ) + (j : ℕ) ≤ 3 * N := by omega
        exact Nat.mul_le_mul_right D_T this
      exact (Polynomial.natDegree_sum_le_of_forall_le _ _ fun s _ => hCk_deg _ s s).trans hij
    change T.det.natDegree ≤ 3 * N ^ 2 * D_T
    rw [Matrix.det_apply]
    refine Polynomial.natDegree_sum_le_of_forall_le _ _ fun σ _ => ?_
    have hsign : (Equiv.Perm.sign σ • ∏ i : Fin N, T (σ i) i).natDegree =
        (∏ i : Fin N, T (σ i) i).natDegree := by
      rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h1 | hm1
      · rw [h1, one_smul]
      · rw [hm1, Units.neg_smul, one_smul, Polynomial.natDegree_neg]
    rw [hsign]
    calc (∏ i : Fin N, T (σ i) i).natDegree
        ≤ ∑ i : Fin N, (T (σ i) i).natDegree := Polynomial.natDegree_prod_le _ _
      _ ≤ ∑ _i : Fin N, (3 * N * D_T) := Finset.sum_le_sum fun i _ => hT_deg (σ i) i
      _ = N * (3 * N * D_T) := by
            rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
      _ = 3 * N ^ 2 * D_T := by ring

  have hSmooth : ∀ (K : Type u) [Field K] [Algebra E K] (x₀ y₀ : K),
      Polynomial.aeval x₀ δ_G ≠ 0 →
      (G.map (Polynomial.aeval x₀).toRingHom).eval y₀ = 0 →
      ((Polynomial.derivative G).map (Polynomial.aeval x₀).toRingHom).eval y₀ ≠ 0 := by
    intro K _ _ x₀ y₀ hδ_x₀ hy₀ hder₀
    set ev : Polynomial E →+* K := (Polynomial.aeval x₀).toRingHom
    set g : Polynomial K := G.map ev
    have hg_mon : g.Monic := hMon.map ev
    have hg_deg : g.natDegree = N := hMon.natDegree_map ev
    have hdet_g : (compTraceMat g).det ≠ 0 := by
      rw [← hMapDet ev G]
      exact hδ_x₀
    have hg_der₀ : (Polynomial.derivative g).eval y₀ = 0 := by
      rw [Polynomial.derivative_map]
      exact hder₀
    obtain ⟨q₁, hq₁⟩ := Polynomial.dvd_iff_isRoot.mpr hy₀
    have hq₁_root : q₁.IsRoot y₀ := by
      have hd := congrArg (fun p => p.eval y₀) (congrArg Polynomial.derivative hq₁)
      rw [hg_der₀, Polynomial.derivative_mul, Polynomial.derivative_sub,
        Polynomial.derivative_X, Polynomial.derivative_C, sub_zero, one_mul,
        Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_sub,
        Polynomial.eval_X, Polynomial.eval_C, sub_self, zero_mul, add_zero] at hd
      exact hd.symm
    obtain ⟨q₀, hq₀⟩ := Polynomial.dvd_iff_isRoot.mpr hq₁_root
    let h : Polynomial K := (Polynomial.X - Polynomial.C y₀) * q₀
    have hg_eq_h : g = (Polynomial.X - Polynomial.C y₀) * h := by
      dsimp only [h]
      rw [hq₁, hq₀]
    have hh_ne : h ≠ 0 := by
      intro hh0
      rw [hh0, mul_zero] at hg_eq_h
      exact hg_mon.ne_zero hg_eq_h
    have hh_deg_lt : h.natDegree < g.natDegree := by
      rw [hg_eq_h, Polynomial.natDegree_mul (Polynomial.X_sub_C_ne_zero y₀) hh_ne,
        Polynomial.natDegree_X_sub_C]
      omega
    have hnot_dvd : ¬ (g ∣ h) := by
      intro hdvd
      have hle := Polynomial.natDegree_le_of_dvd hdvd hh_ne
      omega
    let A_g := AdjoinRoot g
    let z : A_g := AdjoinRoot.mk g h
    have hz_ne : z ≠ 0 := mt (AdjoinRoot.mk_eq_zero).mp hnot_dvd
    have hz_sq : z ^ 2 = 0 := by
      dsimp only [z]
      rw [← map_pow]
      have hh_sq : h ^ 2 = g * q₀ := by
        rw [hg_eq_h]
        dsimp only [h]
        ring
      rw [hh_sq, map_mul, AdjoinRoot.mk_self, zero_mul]
    let pb_g : PowerBasis K A_g := AdjoinRoot.powerBasis' hg_mon
    have hdim_g : pb_g.dim = N := (AdjoinRoot.powerBasis'_dim hg_mon).trans hg_deg
    let e_g : Fin pb_g.dim ≃ Fin N := finCongr hdim_g
    let b_g : Module.Basis (Fin N) K A_g := pb_g.basis.reindex e_g
    have hb_g : ∀ k : Fin N, b_g k = (AdjoinRoot.root g) ^ (k : ℕ) := by
      intro k
      rw [Module.Basis.reindex_apply, PowerBasis.basis_eq_pow, AdjoinRoot.powerBasis'_gen]
      rfl
    have haeval_g : Polynomial.aeval (AdjoinRoot.root g) g = 0 := by
      rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
    have hTr_g : Algebra.traceMatrix K b_g = compTraceMat g :=
      hBridge g hg_mon hg_deg (AdjoinRoot.root g) haeval_g b_g hb_g
    let v : Fin N → K := fun j => (b_g.repr z) j
    have hv_ne : v ≠ 0 := by
      intro hv0
      apply hz_ne
      rw [← b_g.sum_repr z]
      refine Finset.sum_eq_zero fun j _ => ?_
      have hj : v j = 0 := congrFun hv0 j
      change v j • b_g j = 0
      rw [hj, zero_smul]
    have hv_mulVec : (Algebra.traceMatrix K b_g).mulVec v = 0 := by
      ext i
      rw [Pi.zero_apply, Matrix.mulVec, dotProduct]
      have htr_nil : Algebra.trace K A_g (b_g i * z) = 0 := by
        have hsq0 : (b_g i * z) ^ 2 = 0 := by rw [mul_pow, hz_sq, mul_zero]
        have hnil : IsNilpotent (Algebra.lmul K A_g (b_g i * z)) :=
          ⟨2, by rw [← map_pow, hsq0, map_zero]⟩
        exact isNilpotent_iff_eq_zero.mp (LinearMap.isNilpotent_trace_of_isNilpotent hnil)
      have hsum_z : b_g i * z = ∑ j : Fin N, v j • (b_g i * b_g j) := by
        conv_lhs => rw [← b_g.sum_repr z]
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        exact mul_smul_comm (v j) (b_g i) (b_g j)
      rw [hsum_z, map_sum] at htr_nil
      rw [← htr_nil]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Algebra.traceMatrix_apply, Algebra.traceForm_apply, map_smul, smul_eq_mul, mul_comm]
    have hdet0 : (Algebra.traceMatrix K b_g).det = 0 :=
      Matrix.exists_mulVec_eq_zero_iff.mp ⟨v, hv_ne, hv_mulVec⟩
    rw [hTr_g] at hdet0
    exact hdet_g hdet0

  have hGeom : ∀ (K : Type u) [Field K] [IsAlgClosed K] [Algebra E K] (x₀ : K),
      Polynomial.aeval x₀ δ_G ≠ 0 →
      ((G.map (Polynomial.aeval x₀).toRingHom).roots).Nodup ∧
        ((G.map (Polynomial.aeval x₀).toRingHom).roots).card = N := by
    intro K _ _ _ x₀ hδ_x₀
    set ev : Polynomial E →+* K := (Polynomial.aeval x₀).toRingHom
    set g : Polynomial K := G.map ev
    have hg_mon : g.Monic := hMon.map ev
    have hg_deg : g.natDegree = N := hMon.natDegree_map ev
    have hcard : g.roots.card = N := by
      rw [← (IsAlgClosed.splits g).natDegree_eq_card_roots, hg_deg]
    refine ⟨?_, hcard⟩
    rw [Multiset.nodup_iff_count_le_one]
    intro y₀
    rw [Polynomial.count_roots]
    by_contra hlt
    have hge2 : 2 ≤ Polynomial.rootMultiplicity y₀ g := by omega
    have hdvd2 : (Polynomial.X - Polynomial.C y₀) ^ 2 ∣ g :=
      dvd_trans (pow_dvd_pow _ hge2) (Polynomial.pow_rootMultiplicity_dvd g y₀)
    rcases hdvd2 with ⟨q₀, hq₀⟩
    have hy₀_eval : g.eval y₀ = 0 := by
      rw [hq₀, sq, Polynomial.eval_mul, Polynomial.eval_mul, Polynomial.eval_sub,
        Polynomial.eval_X, Polynomial.eval_C, sub_self, zero_mul, zero_mul]
    have hy₀_der : ((Polynomial.derivative G).map ev).eval y₀ = 0 := by
      rw [← Polynomial.derivative_map]
      change (Polynomial.derivative g).eval y₀ = 0
      rw [hq₀, sq, mul_assoc, Polynomial.derivative_mul,
        Polynomial.derivative_sub, Polynomial.derivative_X, Polynomial.derivative_C,
        sub_zero, one_mul, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_mul,
        Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self,
        zero_mul, zero_mul, add_zero]
    exact hSmooth K x₀ y₀ hδ_x₀ hy₀_eval hy₀_der

  have hCond : ∀ (K_ext : Type u) [Field K_ext] [Algebra E K_ext]
       (Δ₀ : Polynomial K_ext)
       (M : Type u) [Field M] [Algebra (Polynomial K_ext) M] [Algebra (RatFunc K_ext) M]
       [IsScalarTower (Polynomial K_ext) (RatFunc K_ext) M]
       [FiniteDimensional (RatFunc K_ext) M],
      Module.finrank (RatFunc K_ext) M = N →
      ∀ (w : M),
        (G.map ((algebraMap (Polynomial K_ext) M).comp
          (Polynomial.mapRingHom (algebraMap E K_ext)))).eval w = 0 →
        IntermediateField.adjoin (RatFunc K_ext) ({w} : Set M) = ⊤ →
        ∀ (u : M) (m : ℕ),
          IsIntegral (Polynomial K_ext) (((algebraMap (Polynomial K_ext) M Δ₀) ^ m) * u) →
          ∃ r : Fin N → Polynomial K_ext,
            (((algebraMap (Polynomial K_ext) M Δ₀) ^ m) *
              (algebraMap (Polynomial K_ext) M (δ_G.map (algebraMap E K_ext)))) * u =
            ∑ j : Fin N, (algebraMap (Polynomial K_ext) M (r j)) * w ^ (j : ℕ) := by
    intro K_ext _ _ Δ₀ M _ _ _ _ _ hRank w hw_root hw_prim u m hu_int
    let A := Polynomial K_ext
    let F_frac := RatFunc K_ext
    let φ : Polynomial E →+* A := Polynomial.mapRingHom (algebraMap E K_ext)
    let ι : A →+* F_frac := algebraMap A F_frac
    let P : Polynomial A := G.map φ
    have hP_mon : P.Monic := hMon.map φ
    have hP_deg : P.natDegree = N := hMon.natDegree_map φ
    have haeval_A : Polynomial.aeval w P = 0 := by
      rw [Polynomial.aeval_def, ← Polynomial.eval_map]
      dsimp only [P]
      rw [Polynomial.map_map]
      exact hw_root
    have hw_int_A : IsIntegral A w := ⟨P, hP_mon, haeval_A⟩
    let P_frac : Polynomial F_frac := P.map ι
    have hP_frac_mon : P_frac.Monic := hP_mon.map ι
    have hP_frac_deg : P_frac.natDegree = N := (hP_mon.natDegree_map ι).trans hP_deg
    have haeval_frac : Polynomial.aeval w P_frac = 0 := by
      rw [Polynomial.aeval_def, ← Polynomial.eval_map]
      dsimp only [P_frac]
      rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq A F_frac M, Polynomial.eval_map,
        ← Polynomial.aeval_def]
      exact haeval_A
    have hw_int_frac : IsIntegral F_frac w := ⟨P_frac, hP_frac_mon, haeval_frac⟩
    let K_w : IntermediateField F_frac M := IntermediateField.adjoin F_frac ({w} : Set M)
    let e_top : ↥K_w ≃ₐ[F_frac] M :=
      (IntermediateField.equivOfEq hw_prim).trans IntermediateField.topEquiv
    have hmin_deg : (minpoly F_frac w).natDegree = N := by
      rw [← IntermediateField.adjoin.finrank hw_int_frac,
        LinearEquiv.finrank_eq e_top.toLinearEquiv, hRank]
    have hP_min : P_frac = minpoly F_frac w :=
      Polynomial.eq_of_monic_of_dvd_of_natDegree_le
        (minpoly.monic hw_int_frac) hP_frac_mon (minpoly.dvd F_frac w haeval_frac)
        (by rw [hP_frac_deg, hmin_deg])
    let pb₀ : PowerBasis F_frac ↥K_w := IntermediateField.adjoin.powerBasis hw_int_frac
    have hpb₀_dim : pb₀.dim = N :=
      (IntermediateField.adjoin.powerBasis_dim hw_int_frac).trans hmin_deg
    let e_idx : Fin pb₀.dim ≃ Fin N := finCongr hpb₀_dim
    let b_w : Module.Basis (Fin N) F_frac M :=
      (pb₀.basis.map e_top.toLinearEquiv).reindex e_idx
    have he_top_apply : ∀ x : ↥K_w, e_top x = (x : M) := fun _ => rfl
    have hb_w : ∀ k : Fin N, b_w k = w ^ (k : ℕ) := by
      intro k
      rw [Module.Basis.reindex_apply, Module.Basis.map_apply, PowerBasis.basis_eq_pow]
      change e_top (pb₀.gen ^ ((e_idx.symm k) : ℕ)) = w ^ (k : ℕ)
      rw [map_pow, he_top_apply, IntermediateField.adjoin.powerBasis_gen]
      rfl
    let T_A : Matrix (Fin N) (Fin N) A := compTraceMat P
    let T_frac : Matrix (Fin N) (Fin N) F_frac := ι.mapMatrix T_A
    have hT_frac_eq : Algebra.traceMatrix F_frac b_w = T_frac := by
      dsimp only [T_frac, T_A]
      rw [hMapTrace ι P]
      exact hBridge P_frac hP_frac_mon hP_frac_deg w haeval_frac b_w hb_w
    let z : M := ((algebraMap A M Δ₀) ^ m) * u
    let a : Fin N → F_frac := fun j => (b_w.repr z) j
    have hTr_int : ∀ i : Fin N, ∃ t : A, ι t = (T_frac.mulVec a) i := by
      intro i
      have hmulVec_i : (T_frac.mulVec a) i = Algebra.trace F_frac M (b_w i * z) := by
        rw [← hT_frac_eq, Matrix.mulVec, dotProduct]
        have hz_sum : b_w i * z = ∑ j : Fin N, a j • (b_w i * b_w j) := by
          conv_lhs => rw [← b_w.sum_repr z]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          exact mul_smul_comm (a j) (b_w i) (b_w j)
        rw [hz_sum, map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [Algebra.traceMatrix_apply, Algebra.traceForm_apply, map_smul, smul_eq_mul, mul_comm]
      rw [hmulVec_i]
      have hbw_int : IsIntegral A (b_w i) := by
        rw [hb_w i]
        exact hw_int_A.pow (i : ℕ)
      have hprod_int : IsIntegral A (b_w i * z) := hbw_int.mul hu_int
      have htr_int : IsIntegral A (Algebra.trace F_frac M (b_w i * z)) :=
        Algebra.isIntegral_trace hprod_int
      exact IsIntegrallyClosed.isIntegral_iff.mp htr_int
    let t_tilde : Fin N → A := fun i => Classical.choose (hTr_int i)
    have ht_tilde : ι ∘ t_tilde = T_frac.mulVec a := by
      ext i
      exact Classical.choose_spec (hTr_int i)
    let r : Fin N → A := T_A.adjugate.mulVec t_tilde
    have hr_map : ∀ j : Fin N, ι (r j) = ι T_A.det * a j := by
      have hvec : ι ∘ r = ι T_A.det • a := by
        have h1 : ι ∘ r = T_frac.adjugate.mulVec (ι ∘ t_tilde) := by
          ext j
          simp only [Function.comp_apply, r, Matrix.mulVec, dotProduct, map_sum, map_mul]
          have hadj := RingHom.map_adjugate ι T_A
          refine Finset.sum_congr rfl fun i _ => ?_
          have hentry : ι (T_A.adjugate j i) = T_frac.adjugate j i :=
            congrFun (congrFun hadj j) i
          rw [hentry]
        rw [h1, ht_tilde, Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.smul_mulVec,
          Matrix.one_mulVec]
        have hdet_eq : T_frac.det = ι T_A.det := (RingHom.map_det ι T_A).symm
        rw [hdet_eq]
      intro j
      exact congrFun hvec j
    have hTA_det : T_A.det = δ_G.map (algebraMap E K_ext) := by
      dsimp only [T_A, δ_G]
      rw [← hMapDet φ G, Polynomial.coe_mapRingHom]
    refine ⟨r, ?_⟩
    have hz_sum : z = ∑ j : Fin N, algebraMap F_frac M (a j) * w ^ (j : ℕ) := by
      conv_lhs => rw [← b_w.sum_repr z]
      refine Finset.sum_congr rfl fun j _ => ?_
      change a j • b_w j = algebraMap F_frac M (a j) * w ^ (j : ℕ)
      rw [hb_w j, Algebra.smul_def]
    have hrhs : ∑ j : Fin N, algebraMap A M (r j) * w ^ (j : ℕ) =
        algebraMap A M T_A.det * z := by
      rw [hz_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      have halg : algebraMap A M (r j) = algebraMap A M T_A.det * algebraMap F_frac M (a j) := by
        rw [IsScalarTower.algebraMap_apply A F_frac M (r j), hr_map j, map_mul,
          ← IsScalarTower.algebraMap_apply A F_frac M T_A.det]
      rw [halg, mul_assoc]
    rw [hrhs, hTA_det]
    dsimp only [z]
    ring

  exact ⟨δ_G, hδ_ne, hδ_deg, hSmooth, hGeom, hCond⟩

theorem weil_etale_curve_cover_constant_field_and_uniform_basis (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (B L : Type u) [CommRing B] [IsDomain B] [Field L]
    [Algebra F B] [Algebra (Polynomial F) B]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [Algebra F L] [Algebra (Polynomial F) L] [Algebra (RatFunc F) L]
    [Algebra B L]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L]
    [IsScalarTower F (Polynomial F) B]
    [IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [IsScalarTower F (RatFunc F) L]
    [IsScalarTower (Polynomial F) (RatFunc F) L]
    [IsScalarTower (Polynomial F) B L]
    [IsScalarTower
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B L]
    [Module.Finite
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [Algebra.Etale
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [IsFractionRing B L]
    [IsIntegralClosure B
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L]
    [FiniteDimensional (RatFunc F) L] [IsGalois (RatFunc F) L] :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∃ (F_B : IntermediateField F L) (_ : Finite ↥F_B) (N_geom D_T : ℕ)
      (e_B : Fin N_geom → B) (h₀ : Polynomial ↥F_B)
      (N_mat : (B ≃ₐ[R₀] B) → Fin N_geom → Matrix (Fin N_geom) (Fin N_geom) (Polynomial ↥F_B)),
      let ψ_FB : Polynomial ↥F_B →+* L :=
        Polynomial.eval₂RingHom (algebraMap ↥F_B L) (algebraMap (Polynomial F) L Polynomial.X)
      (1 ≤ N_geom ∧ 1 ≤ D_T ∧ h₀ ≠ 0 ∧ Function.Injective ψ_FB) ∧
      ((∀ x : L, x ∈ F_B ↔ IsIntegral F x) ∧
        (∀ z : ↥F_B, ∃ b : B, algebraMap B L b = z.1 ∧ IsIntegral F b) ∧
