  have hFunc : ∀ {W₁ W₂ : U.Etale} (u : Quiver.Hom W₁ W₂),
      let h₁ := (FgtU.obj W₁).hom
      let h₂ := (FgtU.obj W₂).hom
      let W₁_V := CategoryTheory.Limits.pullback h₁ π
      let W₂_V := CategoryTheory.Limits.pullback h₂ π
