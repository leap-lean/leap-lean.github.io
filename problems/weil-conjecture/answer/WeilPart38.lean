        Finset.sum_congr rfl fun j _ => by rw [he_B_ψ j, map_mul, mul_assoc]
      rw [hcongr, hp]
    exact (mul_eq_zero.mp (hv_indep _ hp' i)).resolve_right hy_FB_ne
  have he_span : ∀ x : L, ∃ (q₀ : Polynomial ↥F_B) (p : Fin N_geom → Polynomial ↥F_B),
      q₀ ≠ 0 ∧ ψ_FB q₀ * x = ∑ i : Fin N_geom, ψ_FB (p i) * algebraMap B L (e_B i) := by
    intro x
    obtain ⟨q₁, p₁, hq₁_ne, hq₁_eq⟩ := hv_span x
    refine ⟨y_FB * q₁, p₁, mul_ne_zero hy_FB_ne hq₁_ne, ?_⟩
    rw [map_mul, mul_assoc, hq₁_eq, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [he_B_ψ i]
    ring
  let I₃ := (B ≃ₐ[R₀] B) × Fin N_geom × Fin N_geom
  let _ : Fintype (B ≃ₐ[R₀] B) := Fintype.ofFinite (B ≃ₐ[R₀] B)
  let x_prod : I₃ → L := fun t => algebraMap B L (t.1 (e_B t.2.1)) * algebraMap B L (e_B t.2.2)
  let q_den : I₃ → Polynomial ↥F_B := fun t => Classical.choose (he_span (x_prod t))
  let P_num : I₃ → Fin N_geom → Polynomial ↥F_B :=
    fun t => Classical.choose (Classical.choose_spec (he_span (x_prod t)))
  have hq_den_ne : ∀ t : I₃, q_den t ≠ 0 :=
    fun t => (Classical.choose_spec (Classical.choose_spec (he_span (x_prod t)))).1
  have hP_num_eq : ∀ t : I₃,
      ψ_FB (q_den t) * x_prod t =
        ∑ k : Fin N_geom, ψ_FB (P_num t k) * algebraMap B L (e_B k) :=
    fun t => (Classical.choose_spec (Classical.choose_spec (he_span (x_prod t)))).2
  let h₀ : Polynomial ↥F_B := ∏ t : I₃, q_den t
  have hh₀_ne : h₀ ≠ 0 := Finset.prod_ne_zero_iff.mpr fun t _ => hq_den_ne t
  let N_mat : (B ≃ₐ[R₀] B) → Fin N_geom → Matrix (Fin N_geom) (Fin N_geom) (Polynomial ↥F_B) :=
    fun γ i => Matrix.of fun k j =>
      (∏ s ∈ Finset.univ.erase (γ, i, j), q_den s) * P_num (γ, i, j) k
  let D_T : ℕ := 1 + (Finset.univ : Finset (I₃ × Fin N_geom)).sup fun u =>
    N_geom * max h₀.natDegree (N_mat u.1.1 u.1.2.1 u.2 u.1.2.2).natDegree
  have hDT_pos : 1 ≤ D_T := Nat.le_add_right 1 _
  refine ⟨F_B, hFin_FB, N_geom, D_T, e_B, h₀, N_mat, ?_⟩
  refine ⟨⟨hN_pos, hDT_pos, hh₀_ne, hψ_inj⟩,
    ⟨fun _ => mem_algebraicClosure_iff',
      fun z => hLift_B z.1 (mem_algebraicClosure_iff'.mp z.2),
      hIrr_FB⟩,
    ⟨hFin_AutB, hCard_AutB_pos, hCard_Geom⟩,
    ⟨he_B_int, he_indep, he_span⟩,
    ⟨?_, ?_⟩⟩
  · intro γ i j
    let t : I₃ := (γ, i, j)
    let R_t : Polynomial ↥F_B := ∏ s ∈ Finset.univ.erase t, q_den s
    have hh₀_split : h₀ = q_den t * R_t :=
      (Finset.mul_prod_erase Finset.univ q_den (Finset.mem_univ t)).symm
    calc ψ_FB h₀ * (algebraMap B L (γ (e_B i)) * algebraMap B L (e_B j))
        = ψ_FB (q_den t * R_t) * x_prod t := by rw [hh₀_split]
      _ = ψ_FB R_t * (ψ_FB (q_den t) * x_prod t) := by rw [map_mul]; ring
      _ = ψ_FB R_t * ∑ k : Fin N_geom, ψ_FB (P_num t k) * algebraMap B L (e_B k) := by
          rw [hP_num_eq t]
      _ = ∑ k : Fin N_geom, ψ_FB (N_mat γ i k j) * algebraMap B L (e_B k) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun k _ => ?_
          simp only [N_mat, Matrix.of_apply, map_mul]
          ring
  · intro γ i k j
    let f_deg : I₃ × Fin N_geom → ℕ := fun u =>
      N_geom * max h₀.natDegree (N_mat u.1.1 u.1.2.1 u.2 u.1.2.2).natDegree
    have hle : f_deg ((γ, i, j), k) ≤ (Finset.univ : Finset (I₃ × Fin N_geom)).sup f_deg :=
      Finset.le_sup (Finset.mem_univ (((γ, i, j) : I₃), k))
    exact le_trans hle (Nat.le_add_left _ 1)

theorem weil_finite_field_algClosure_tower_and_primitivity (F : Type u) [Finite F] [Field F]
    (F₀ : Type u) [Finite F₀] [Field F₀] [Algebra F F₀]
    (d R_Γ : ℕ) (hd : 2 ≤ d) (hR : 1 ≤ R_Γ)
    (hF₀_pow : ∀ z : F₀, z ^ (Nat.card F ^ (d * R_Γ)) = z) :
    ∃ (E_sub E'_sub : IntermediateField F (AlgebraicClosure F))
      (_ : Finite ↥E_sub) (_ : Finite ↥E'_sub)
      (hLE : E_sub ≤ E'_sub)
      (ι_F₀E' : F₀ →ₐ[F] ↥E'_sub)
      (Φ_d : ↥E'_sub ≃ₐ[F] ↥E'_sub),
      (CharP ↥E_sub (ringChar F) ∧
        Nat.card ↥E_sub = Nat.card F ^ d ∧
        Nat.card ↥E'_sub = Nat.card F ^ (d * R_Γ)) ∧
      ((∀ z : AlgebraicClosure F, z ∈ E_sub ↔ z ^ (Nat.card F ^ d) = z) ∧
        (∀ z : AlgebraicClosure F, z ∈ E'_sub ↔ z ^ (Nat.card F ^ (d * R_Γ)) = z)) ∧
      ((∀ z : ↥E'_sub, Φ_d z = z ^ (Nat.card F ^ d)) ∧
        (∀ z : ↥E'_sub, Φ_d z = z ↔ z ∈ Set.range (IntermediateField.inclusion hLE))) ∧
      (Φ_d ^ R_Γ = 1 ∧
        (∀ m₁ m₂ : Fin R_Γ, Φ_d ^ (m₁ : ℕ) = Φ_d ^ (m₂ : ℕ) → m₁ = m₂)) ∧
      (let _ : Algebra ↥E_sub ↥E'_sub := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
       FiniteDimensional ↥E_sub ↥E'_sub ∧ Module.finrank ↥E_sub ↥E'_sub = R_Γ) ∧
      (∀ K₀ : IntermediateField F ↥E_sub,
        ∃ e₀ : ℕ, (Nat.card ↥K₀) ^ e₀ = Nat.card F ^ d) ∧
      (∀ (S_aff : Finset F) (x₀ : ↥E_sub),
        (∀ s ∈ S_aff, x₀ ≠ algebraMap F ↥E_sub s) →
        (∀ k : ℕ, 1 ≤ k → 2 * k ≤ d → x₀ ^ (Nat.card F ^ k) ≠ x₀) →
        IsGoodAffineCurveClosedPointPoly S_aff d (minpoly F x₀)) :=
by
  classical
  let F_bar := AlgebraicClosure F
  set q := Nat.card F
  set p := ringChar F
  have hq : 2 ≤ q := Finite.one_lt_card
  let _ : Fintype F := Fintype.ofFinite F
  have hcard_F : Fintype.card F = q := Nat.card_eq_fintype_card.symm
  let φ_F : F_bar ≃ₐ[F] F_bar := FiniteField.frobeniusAlgEquivOfAlgebraic F F_bar
  have hφ_apply : ∀ z : F_bar, φ_F z = z ^ q := by
    intro z
    change FiniteField.frobeniusAlgEquivOfAlgebraic F F_bar z = z ^ q
    rw [FiniteField.frobeniusAlgEquivOfAlgebraic_apply, hcard_F]
  have hφ_pow : ∀ (n : ℕ) (z : F_bar), (φ_F ^ n) z = z ^ (q ^ n) := by
    intro n
    induction n with
    | zero =>
      intro z
      rw [pow_zero, pow_zero, pow_one]
      rfl
    | succ n ih =>
      intro z
      rw [pow_succ', AlgEquiv.mul_apply, hφ_apply, ih, ← pow_mul, ← pow_succ]
  let E_of : ℕ → IntermediateField F F_bar :=
    fun n => IntermediateField.fixedField (Subgroup.zpowers (φ_F ^ n))
  have hE_mem : ∀ (n : ℕ) (z : F_bar), z ∈ E_of n ↔ z ^ (q ^ n) = z := by
    intro n z
    dsimp [E_of]
    rw [IntermediateField.mem_fixedField_iff]
    constructor
    · intro hz
      have h1 : (φ_F ^ n) • z = z := hz (φ_F ^ n) (Subgroup.mem_zpowers (φ_F ^ n))
      change (φ_F ^ n) z = z at h1
      rwa [hφ_pow n z] at h1
    · intro hz g hg
      have hstab : φ_F ^ n ∈ MulAction.stabilizer (F_bar ≃ₐ[F] F_bar) z := by
        rw [MulAction.mem_stabilizer_iff]
        change (φ_F ^ n) z = z
        rw [hφ_pow n z, hz]
      have hle : Subgroup.zpowers (φ_F ^ n) ≤ MulAction.stabilizer (F_bar ≃ₐ[F] F_bar) z :=
        Subgroup.zpowers_le.mpr hstab
      exact MulAction.mem_stabilizer_iff.mp (hle hg)
  have hp_prime : Nat.Prime p := CharP.char_is_prime F p
  have _ : Fact (Nat.Prime p) := ⟨hp_prime⟩
  have hchar_Fbar : CharP F_bar p :=
    (RingHom.charP_iff_charP (algebraMap F F_bar) p).mp inferInstance
  let _ : CharP F_bar p := hchar_Fbar
  have hE_card : ∀ (n : ℕ), 1 ≤ n → Finite ↥(E_of n) ∧ Nat.card ↥(E_of n) = q ^ n := by
    intro n hn
    set N := q ^ n
    have hN_gt1 : 1 < N := Nat.one_lt_pow (by omega) hq
    let P_N : Polynomial F_bar := Polynomial.X ^ N - Polynomial.X
    have hP_deg : P_N.natDegree = N := by
      dsimp [P_N]
      rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt, Polynomial.natDegree_X_pow]
      rw [Polynomial.natDegree_X, Polynomial.natDegree_X_pow]
      exact hN_gt1
    have hP_ne : P_N ≠ 0 := by
      intro h0
      rw [h0, Polynomial.natDegree_zero] at hP_deg
      omega
    have hN_cast_zero : (N : F_bar) = 0 := by
      obtain ⟨a, _, ha⟩ := FiniteField.card F p
      have hq_eq : q = p ^ (a : ℕ) := by
        rw [← hcard_F, ha]
      have hN_eq : N = p ^ ((a : ℕ) * n) := by
        dsimp [N]
        rw [hq_eq, ← pow_mul]
      have han_ne : (a : ℕ) * n ≠ 0 := Nat.mul_ne_zero (PNat.ne_zero a) (by omega)
      have hdvd : p ∣ N := by
        rw [hN_eq]
        exact dvd_pow_self p han_ne
      exact (CharP.cast_eq_zero_iff F_bar p N).mpr hdvd
    have hP_deriv : Polynomial.derivative P_N = -1 := by
      dsimp [P_N]
      rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_X,
        hN_cast_zero, map_zero, zero_mul, zero_sub]
    have hP_sep : P_N.Separable :=
      ⟨0, -1, by rw [hP_deriv]; ring⟩
    have hP_nodup : P_N.roots.Nodup := Polynomial.nodup_roots hP_sep
    have hP_roots_card : (P_N.roots.toFinset).card = N := by
      rw [Multiset.toFinset_card_of_nodup hP_nodup, IsAlgClosed.card_roots_eq_natDegree, hP_deg]
    have hmem_roots : ∀ z : F_bar, z ∈ P_N.roots.toFinset ↔ z ∈ E_of n := by
      intro z
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_ne, Polynomial.IsRoot.def]
      dsimp [P_N]
      rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, sub_eq_zero, hE_mem n z]
    let e_N : ↥(E_of n) ≃ ↥(P_N.roots.toFinset) :=
      { toFun := fun x => ⟨x.1, (hmem_roots x.1).mpr x.2⟩
        invFun := fun y => ⟨y.1, (hmem_roots y.1).mp y.2⟩
        left_inv := fun _ => Subtype.ext rfl
        right_inv := fun _ => Subtype.ext rfl }
    have hFin_n : Finite ↥(E_of n) := Finite.of_equiv ↥(P_N.roots.toFinset) e_N.symm
    have hCard_n : Nat.card ↥(E_of n) = N := by
      rw [Nat.card_congr e_N, Nat.card_eq_fintype_card, Fintype.card_coe, hP_roots_card]
    exact ⟨hFin_n, hCard_n⟩
  let E_sub : IntermediateField F F_bar := E_of d
  let E'_sub : IntermediateField F F_bar := E_of (d * R_Γ)
  obtain ⟨hFinE, hcard_E⟩ := hE_card d (by omega)
  obtain ⟨hFinE', hcard_E'⟩ := hE_card (d * R_Γ) (Nat.mul_pos (by omega) (by omega))
  let _ : Finite ↥E_sub := hFinE
  let _ : Finite ↥E'_sub := hFinE'
  have hCharE : CharP ↥E_sub p :=
    (RingHom.charP_iff_charP (algebraMap F ↥E_sub) p).mp inferInstance
  have hLE : E_sub ≤ E'_sub := by
    intro z hz
    have hz_d : z ^ (q ^ d) = z := (hE_mem d z).mp hz
    have hz_iter : ∀ r : ℕ, z ^ ((q ^ d) ^ r) = z := by
      intro r
      induction r with
      | zero => rw [pow_zero, pow_one]
      | succ r ih => rw [pow_succ, pow_mul, ih, hz_d]
    have hz_dR : z ^ (q ^ (d * R_Γ)) = z := by
      rw [pow_mul]
      exact hz_iter R_Γ
    exact (hE_mem (d * R_Γ) z).mpr hz_dR
  let j₀ : F₀ →ₐ[F] F_bar := IsAlgClosed.lift
  have hj₀_mem : ∀ z : F₀, j₀ z ∈ E'_sub := by
    intro z
    apply (hE_mem (d * R_Γ) (j₀ z)).mpr
    rw [← map_pow, hF₀_pow z]
  let ι_F₀E' : F₀ →ₐ[F] ↥E'_sub := j₀.codRestrict E'_sub.toSubalgebra hj₀_mem
  let g : F_bar ≃ₐ[F] F_bar := φ_F ^ d
  have hg_mem : ∀ z : ↥E'_sub, g z.1 ∈ E'_sub := by
    intro z
    have hz : z.1 ^ (q ^ (d * R_Γ)) = z.1 := (hE_mem (d * R_Γ) z.1).mp z.2
    apply (hE_mem (d * R_Γ) (g z.1)).mpr
    change ((φ_F ^ d) z.1) ^ (q ^ (d * R_Γ)) = (φ_F ^ d) z.1
    rw [hφ_pow d z.1, ← pow_mul, mul_comm, pow_mul, hz]
  have hginv_mem : ∀ z : ↥E'_sub, g.symm z.1 ∈ E'_sub := by
    intro z
    have hz : z.1 ^ (q ^ (d * R_Γ)) = z.1 := (hE_mem (d * R_Γ) z.1).mp z.2
    apply (hE_mem (d * R_Γ) (g.symm z.1)).mpr
    apply g.injective
    rw [map_pow, g.apply_symm_apply, hz]
  let Φ_fwd : ↥E'_sub →ₐ[F] ↥E'_sub :=
    (g.toAlgHom.comp E'_sub.val).codRestrict E'_sub.toSubalgebra hg_mem
  let Φ_inv : ↥E'_sub →ₐ[F] ↥E'_sub :=
    (g.symm.toAlgHom.comp E'_sub.val).codRestrict E'_sub.toSubalgebra hginv_mem
  have hΦ_lr : Φ_fwd.comp Φ_inv = AlgHom.id F ↥E'_sub := by
    ext z
    exact g.apply_symm_apply z.1
  have hΦ_rl : Φ_inv.comp Φ_fwd = AlgHom.id F ↥E'_sub := by
    ext z
    exact g.symm_apply_apply z.1
  let Φ_d : ↥E'_sub ≃ₐ[F] ↥E'_sub := AlgEquiv.ofAlgHom Φ_fwd Φ_inv hΦ_lr hΦ_rl
  have hΦ_val : ∀ z : ↥E'_sub, (Φ_d z).1 = z.1 ^ (q ^ d) := by
    intro z
    change g z.1 = z.1 ^ (q ^ d)
    exact hφ_pow d z.1
  have hΦ_apply : ∀ z : ↥E'_sub, Φ_d z = z ^ (q ^ d) := by
    intro z
    apply Subtype.ext
    rw [hΦ_val z, SubmonoidClass.coe_pow]
  have hΦ_fix : ∀ z : ↥E'_sub, Φ_d z = z ↔ z ∈ Set.range (IntermediateField.inclusion hLE) := by
    intro z
    have h1 : Φ_d z = z ↔ z.1 ∈ E_sub := by
      rw [Subtype.ext_iff, hΦ_val z, hE_mem d z.1]
    have h2 : z ∈ Set.range (IntermediateField.inclusion hLE) ↔ z.1 ∈ E_sub := by
      constructor
      · rintro ⟨x, rfl⟩
        exact x.2
      · intro hz
        exact ⟨⟨z.1, hz⟩, rfl⟩
    exact h1.trans h2.symm
  have hΦ_iter : ∀ (m : ℕ) (z : ↥E'_sub), ((Φ_d ^ m) z).1 = z.1 ^ (q ^ (d * m)) := by
    intro m
    induction m with
    | zero =>
      intro z
      rw [Nat.mul_zero, pow_zero, pow_zero, pow_one]
      rfl
    | succ m ih =>
      intro z
      rw [pow_succ', AlgEquiv.mul_apply, hΦ_val, ih, ← pow_mul, ← pow_add, ← Nat.mul_succ]
  have hΦ_pow_R : Φ_d ^ R_Γ = 1 := by
    ext z
    change ((Φ_d ^ R_Γ) z).1 = z.1
    rw [hΦ_iter R_Γ z]
    exact (hE_mem (d * R_Γ) z.1).mp z.2
  have hΦ_not_one : ∀ k : ℕ, 1 ≤ k → k < R_Γ → Φ_d ^ k ≠ 1 := by
    intro k hk1 hk_lt hk_eq
    have hmem_k : ∀ z : ↥E'_sub, z.1 ∈ E_of (d * k) := by
      intro z
      apply (hE_mem (d * k) z.1).mpr
      rw [← hΦ_iter k z, hk_eq]
      rfl
    let ι_k : ↥E'_sub → ↥(E_of (d * k)) := fun z => ⟨z.1, hmem_k z⟩
    have hι_inj : Function.Injective ι_k := by
      intro x y hxy
      exact Subtype.ext (Subtype.mk.inj hxy)
    obtain ⟨hFin_dk, hcard_dk⟩ := hE_card (d * k) (Nat.mul_pos (by omega) hk1)
    let _ : Finite ↥(E_of (d * k)) := hFin_dk
    have hcard_le : Nat.card ↥E'_sub ≤ Nat.card ↥(E_of (d * k)) :=
      Nat.card_le_card_of_injective ι_k hι_inj
    rw [hcard_E', hcard_dk] at hcard_le
    have hlt_exp : d * k < d * R_Γ := Nat.mul_lt_mul_of_pos_left hk_lt (by omega)
    have hlt_pow : q ^ (d * k) < q ^ (d * R_Γ) := Nat.pow_lt_pow_right hq hlt_exp
    omega
  have hΦ_inj : ∀ m₁ m₂ : Fin R_Γ, Φ_d ^ (m₁ : ℕ) = Φ_d ^ (m₂ : ℕ) → m₁ = m₂ := by
    intro m₁ m₂ hm
    rcases lt_trichotomy (m₁ : ℕ) (m₂ : ℕ) with hlt | heq | hgt
    · exfalso
      let k := (m₂ : ℕ) - (m₁ : ℕ)
      have hk1 : 1 ≤ k := by omega
      have hk_lt : k < R_Γ := by
        have := m₂.isLt
        omega
      have hadd : (m₁ : ℕ) + k = (m₂ : ℕ) := by omega
      have hk_one : Φ_d ^ k = 1 := by
        calc Φ_d ^ k
            = (Φ_d ^ (m₁ : ℕ))⁻¹ * (Φ_d ^ (m₁ : ℕ) * Φ_d ^ k) := (inv_mul_cancel_left _ _).symm
          _ = (Φ_d ^ (m₁ : ℕ))⁻¹ * Φ_d ^ ((m₁ : ℕ) + k) := by rw [← pow_add]
          _ = (Φ_d ^ (m₁ : ℕ))⁻¹ * Φ_d ^ (m₂ : ℕ) := by rw [hadd]
          _ = (Φ_d ^ (m₁ : ℕ))⁻¹ * Φ_d ^ (m₁ : ℕ) := by rw [hm]
          _ = 1 := inv_mul_cancel _
      exact hΦ_not_one k hk1 hk_lt hk_one
    · exact Fin.ext heq
    · exfalso
      let k := (m₁ : ℕ) - (m₂ : ℕ)
      have hk1 : 1 ≤ k := by omega
      have hk_lt : k < R_Γ := by
        have := m₁.isLt
        omega
      have hadd : (m₂ : ℕ) + k = (m₁ : ℕ) := by omega
      have hk_one : Φ_d ^ k = 1 := by
        calc Φ_d ^ k
            = (Φ_d ^ (m₂ : ℕ))⁻¹ * (Φ_d ^ (m₂ : ℕ) * Φ_d ^ k) := (inv_mul_cancel_left _ _).symm
          _ = (Φ_d ^ (m₂ : ℕ))⁻¹ * Φ_d ^ ((m₂ : ℕ) + k) := by rw [← pow_add]
          _ = (Φ_d ^ (m₂ : ℕ))⁻¹ * Φ_d ^ (m₁ : ℕ) := by rw [hadd]
          _ = (Φ_d ^ (m₂ : ℕ))⁻¹ * Φ_d ^ (m₂ : ℕ) := by rw [hm]
          _ = 1 := inv_mul_cancel _
      exact hΦ_not_one k hk1 hk_lt hk_one
  have hClause5 :
      let _ : Algebra ↥E_sub ↥E'_sub := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
      FiniteDimensional ↥E_sub ↥E'_sub ∧ Module.finrank ↥E_sub ↥E'_sub = R_Γ := by
    let _ : Algebra ↥E_sub ↥E'_sub := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
    refine ⟨inferInstance, ?_⟩
    have hpow_eq : (q ^ d) ^ (Module.finrank ↥E_sub ↥E'_sub) = (q ^ d) ^ R_Γ := by
      calc (q ^ d) ^ (Module.finrank ↥E_sub ↥E'_sub)
          = (Nat.card ↥E_sub) ^ (Module.finrank ↥E_sub ↥E'_sub) := by rw [hcard_E]
        _ = Nat.card ↥E'_sub := (Module.natCard_eq_pow_finrank (K := ↥E_sub) (V := ↥E'_sub)).symm
        _ = q ^ (d * R_Γ) := hcard_E'
        _ = (q ^ d) ^ R_Γ := pow_mul q d R_Γ
    have hqd_ge2 : 2 ≤ q ^ d := le_trans hq (Nat.le_self_pow (by omega) q)
    exact Nat.pow_right_injective hqd_ge2 hpow_eq
  have hClause6 : ∀ K₀ : IntermediateField F ↥E_sub,
      ∃ e₀ : ℕ, (Nat.card ↥K₀) ^ e₀ = q ^ d := by
    intro K₀
    refine ⟨Module.finrank ↥K₀ ↥E_sub, ?_⟩
    rw [← Module.natCard_eq_pow_finrank (K := ↥K₀) (V := ↥E_sub), hcard_E]
  have hClause7 : ∀ (S_aff : Finset F) (x₀ : ↥E_sub),
      (∀ s ∈ S_aff, x₀ ≠ algebraMap F ↥E_sub s) →
      (∀ k : ℕ, 1 ≤ k → 2 * k ≤ d → x₀ ^ (q ^ k) ≠ x₀) →
      IsGoodAffineCurveClosedPointPoly S_aff d (minpoly F x₀) := by
    intro S_aff x₀ _hx₀_avoid hx₀_prim
    let P := minpoly F x₀
    have hx₀_int : IsIntegral F x₀ := IsIntegral.of_finite F x₀
    have hP_mon : P.Monic := minpoly.monic hx₀_int
    have hP_irr : Irreducible P := minpoly.irreducible hx₀_int
    have hfinrank_E : Module.finrank F ↥E_sub = d := by
      have hpow_E : q ^ (Module.finrank F ↥E_sub) = q ^ d := by
        calc q ^ (Module.finrank F ↥E_sub)
            = (Nat.card F) ^ (Module.finrank F ↥E_sub) := rfl
          _ = Nat.card ↥E_sub := (Module.natCard_eq_pow_finrank (K := F) (V := ↥E_sub)).symm
          _ = q ^ d := hcard_E
      exact Nat.pow_right_injective hq hpow_E
    let K₀ : IntermediateField F ↥E_sub := IntermediateField.adjoin F ({x₀} : Set ↥E_sub)
    set k := Module.finrank F ↥K₀
    set e := Module.finrank ↥K₀ ↥E_sub
    have hk_deg : k = P.natDegree := IntermediateField.adjoin.finrank hx₀_int
    have hke : k * e = d := by
      rw [← hfinrank_E]
      exact Module.finrank_mul_finrank F ↥K₀ ↥E_sub
    have hk_pos : 1 ≤ k := Module.finrank_pos
    have he_pos : 1 ≤ e := Module.finrank_pos
    have he_eq1 : e = 1 := by
      by_contra he_ne1
      have he_ge2 : 2 ≤ e := by omega
      have h2k_le : 2 * k ≤ d := by
        calc 2 * k ≤ e * k := Nat.mul_le_mul_right k he_ge2
          _ = k * e := mul_comm e k
          _ = d := hke
      let y₀ : ↥K₀ := ⟨x₀, IntermediateField.mem_adjoin_simple_self F x₀⟩
      let _ : Fintype ↥K₀ := Fintype.ofFinite ↥K₀
      have hcard_K₀ : Fintype.card ↥K₀ = q ^ k := by
        rw [← Nat.card_eq_fintype_card, Module.natCard_eq_pow_finrank (K := F) (V := ↥K₀)]
      have hy₀_pow : y₀ ^ (q ^ k) = y₀ := by
        rw [← hcard_K₀]
        exact FiniteField.pow_card y₀
      have hx₀_pow : x₀ ^ (q ^ k) = x₀ := by
        have hcoe := congrArg Subtype.val hy₀_pow
        rwa [SubmonoidClass.coe_pow] at hcoe
      exact hx₀_prim k hk_pos h2k_le hx₀_pow
    have hP_deg : P.natDegree = d := by
      rw [← hk_deg, ← hke, he_eq1, mul_one]
    have hP_avoid : ∀ s ∈ S_aff, ¬ P.IsRoot s := by
      intro s _hs hroot
      have hdvd1 : Polynomial.X - Polynomial.C s ∣ P := Polynomial.dvd_iff_isRoot.mpr hroot
      have hdvd2 : P ∣ Polynomial.X - Polynomial.C s :=
        (Polynomial.irreducible_X_sub_C s).dvd_symm hP_irr hdvd1
      have hassoc : Associated (Polynomial.X - Polynomial.C s) P :=
        associated_of_dvd_dvd hdvd1 hdvd2
      have hdeg1 : (Polynomial.X - Polynomial.C s).natDegree = P.natDegree :=
        Polynomial.natDegree_eq_of_degree_eq (Polynomial.degree_eq_degree_of_associated hassoc)
      rw [Polynomial.natDegree_X_sub_C, hP_deg] at hdeg1
      omega
    exact ⟨hP_mon, hP_irr, hP_deg, hP_avoid⟩
  exact ⟨E_sub, E'_sub, hFinE, hFinE', hLE, ι_F₀E', Φ_d,
    ⟨hCharE, hcard_E, hcard_E'⟩,
    ⟨hE_mem d, hE_mem (d * R_Γ)⟩,
    ⟨hΦ_apply, hΦ_fix⟩,
    ⟨hΦ_pow_R, hΦ_inj⟩,
    hClause5, hClause6, hClause7⟩

theorem weil_speiser_cyclic_invariant_primitive_bivariate_model (E E' : Type u) [Field E] [Finite E] [Field E'] [Finite E']
    [Algebra E E'] [FiniteDimensional E E']
    (R_Γ N_geom D_T B₀ : ℕ)
    (hR : 1 ≤ R_Γ) (hN : 1 ≤ N_geom) (hDT : 1 ≤ D_T)
    (hNB₀ : N_geom * B₀ ≤ D_T)
    (hN_sq : N_geom ^ 2 < Nat.card E)
    (hfinrank_EE' : Module.finrank E E' = R_Γ)
    (Φ_d : E' ≃ₐ[E] E')
    (hΦ_pow : Φ_d ^ R_Γ = 1)
    (hΦ_inj : ∀ m₁ m₂ : Fin R_Γ, Φ_d ^ (m₁ : ℕ) = Φ_d ^ (m₂ : ℕ) → m₁ = m₂)
    (hΦ_fix : ∀ z : E', Φ_d z = z ↔ z ∈ Set.range (algebraMap E E'))
    (M : Type u) [Field M]
    [Algebra (Polynomial E) M] [Algebra (RatFunc E) M]
    [IsScalarTower (Polynomial E) (RatFunc E) M]
    [Algebra (Polynomial E') M] [Algebra (RatFunc E') M]
    [IsScalarTower (Polynomial E') (RatFunc E') M]
    [Algebra (RatFunc E) (RatFunc E')]
    [IsScalarTower (RatFunc E) (RatFunc E') M]
    [FiniteDimensional (RatFunc E) M] [Algebra.IsSeparable (RatFunc E) M]
    [FiniteDimensional (RatFunc E') M]
    (hPolyCompat : ∀ P : Polynomial E,
      algebraMap (Polynomial E') M (P.map (algebraMap E E')) = algebraMap (Polynomial E) M P)
    (hRatCompat : ∀ P : Polynomial E,
      algebraMap (RatFunc E) (RatFunc E') (algebraMap (Polynomial E) (RatFunc E) P) =
        algebraMap (Polynomial E') (RatFunc E') (P.map (algebraMap E E')))
    (e_M : Module.Basis (Fin N_geom) (RatFunc E') M)
    (B_sub : Subring M)
    (hPoly_sub : Set.range (algebraMap (Polynomial E') M) ⊆ (B_sub : Set M))
    (he_sub : ∀ i : Fin N_geom, e_M i ∈ B_sub)
    (η_tilde : M ≃ₐ[RatFunc E] M)
    (hη_pow : η_tilde ^ R_Γ = 1)
    (hη_poly : ∀ P : Polynomial E',
      η_tilde (algebraMap (Polynomial E') M P) =
        algebraMap (Polynomial E') M (P.map Φ_d.toRingHom))
    (hη_Bsub : ∀ u ∈ B_sub, η_tilde u ∈ B_sub)
    (h₀' : Polynomial E')
    (M_tab : Fin R_Γ → Fin N_geom → Fin N_geom → Fin N_geom → Polynomial E')
    (hh₀'_ne : h₀' ≠ 0)
    (hh₀'_deg : h₀'.natDegree ≤ B₀)
    (hM_deg : ∀ m i k j, (M_tab m i k j).natDegree ≤ B₀)
    (hInt_orb : ∀ (m : Fin R_Γ) (i : Fin N_geom),
      IsIntegral (Polynomial E') ((η_tilde ^ (m : ℕ)) (e_M i)))
    (hMul_tab : ∀ (m : Fin R_Γ) (i j : Fin N_geom),
      (algebraMap (Polynomial E') M h₀') * ((η_tilde ^ (m : ℕ)) (e_M i) * e_M j) =
        ∑ k : Fin N_geom, (algebraMap (Polynomial E') M (M_tab m i k j)) * e_M k) :
    ∃ (w : M) (G : Polynomial (Polynomial E)),
      (w ∈ B_sub ∧ η_tilde w = w) ∧
      (G.Monic ∧
        G.natDegree = N_geom ∧
        (∀ r ≤ G.natDegree, (G.coeff r).natDegree ≤ D_T) ∧
        Irreducible G ∧
        Polynomial.derivative G ≠ 0) ∧
      (G.map (algebraMap (Polynomial E) M)).eval w = 0 ∧
      IntermediateField.adjoin (RatFunc E') ({w} : Set M) = ⊤ :=
by
  classical
  let ι_E' : E' →+* M := (algebraMap (Polynomial E') M).comp Polynomial.C
  let κ_E' : E' →+* RatFunc E' := (algebraMap (Polynomial E') (RatFunc E')).comp Polynomial.C
  have hκ_smul : ∀ (z : E') (x : M), (κ_E' z) • x = ι_E' z * x := by
    intro z x
    rw [Algebra.smul_def]
    change algebraMap (RatFunc E') M (algebraMap (Polynomial E') (RatFunc E') (Polynomial.C z)) * x =
      algebraMap (Polynomial E') M (Polynomial.C z) * x
    rw [← IsScalarTower.algebraMap_apply (Polynomial E') (RatFunc E') M]
  have hι_E'_inj : Function.Injective ι_E' := ι_E'.injective
  have hη_ι : ∀ z : E', η_tilde (ι_E' z) = ι_E' (Φ_d z) := by
    intro z
    dsimp [ι_E']
    rw [hη_poly, Polynomial.map_C]
    rfl
  have hη_pow_ι : ∀ (n : ℕ) (z : E'), (η_tilde ^ n) (ι_E' z) = ι_E' ((Φ_d ^ n) z) := by
    intro n
    induction n with
    | zero =>
      intro z
      simp
    | succ n ih =>
      intro z
      rw [pow_succ', pow_succ', AlgEquiv.mul_apply, AlgEquiv.mul_apply, ih, hη_ι]

  
  let β : Module.Basis (Fin R_Γ) E E' := Module.finBasisOfFinrankEq E E' hfinrank_EE'
  let W : Matrix (Fin R_Γ) (Fin R_Γ) E' := fun m α => (Φ_d ^ (m : ℕ)) (β α)
  let χ : Fin R_Γ → (E'ˣ →* E') := fun m =>
    (Φ_d ^ (m : ℕ)).toRingHom.toMonoidHom.comp (Units.coeHom E')
  have hχ_inj : Function.Injective χ := by
    intro m₁ m₂ hm
    apply hΦ_inj m₁ m₂
    ext z
    by_cases hz : z = 0
    · subst hz
      simp
    · exact congrArg (fun f : E'ˣ →* E' => f (Units.mk0 z hz)) hm
  have hχ_li : LinearIndependent E' (fun m : Fin R_Γ => (χ m : E'ˣ → E')) :=
    (linearIndependent_monoidHom E'ˣ E').comp χ hχ_inj
  have hW_det_ne : W.det ≠ 0 := by
    intro hdet0
    obtain ⟨c, hc_ne, hc_vec⟩ := Matrix.exists_vecMul_eq_zero_iff.mpr hdet0
    have hc_sum_z : ∀ z : E', ∑ m : Fin R_Γ, c m * (Φ_d ^ (m : ℕ)) z = 0 := by
      intro z
      have hz_repr : z = ∑ α : Fin R_Γ, algebraMap E E' (β.repr z α) * β α := by
        conv_lhs => rw [← β.sum_repr z]
        simp_rw [Algebra.smul_def]
      have hΦz : ∀ m : Fin R_Γ,
          (Φ_d ^ (m : ℕ)) z = ∑ α : Fin R_Γ, algebraMap E E' (β.repr z α) * W m α := by
        intro m
        conv_lhs => rw [hz_repr]
        rw [map_sum]
        refine Finset.sum_congr rfl fun α _ => ?_
        rw [map_mul, AlgEquiv.commutes]
      simp_rw [hΦz, Finset.mul_sum]
      rw [Finset.sum_comm]
      have hcol : ∀ α : Fin R_Γ,
          ∑ m : Fin R_Γ, c m * (algebraMap E E' (β.repr z α) * W m α) =
            algebraMap E E' (β.repr z α) * (∑ m : Fin R_Γ, c m * W m α) := by
        intro α
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun m _ => by ring
      simp_rw [hcol]
      refine Finset.sum_eq_zero fun α _ => ?_
      have h0 : ∑ m : Fin R_Γ, c m * W m α = 0 := congrFun hc_vec α
      rw [h0, mul_zero]
    have hc_fun : ∑ m : Fin R_Γ, c m • (χ m : E'ˣ → E') = 0 := by
      ext u
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
      exact hc_sum_z (u : E')
    have hc_all0 := Fintype.linearIndependent_iff.mp hχ_li c hc_fun
    exact hc_ne (funext hc_all0)
  have hW_mul_inv : W * W⁻¹ = 1 :=
    Matrix.mul_nonsing_inv W (isUnit_iff_ne_zero.mpr hW_det_ne)

  
  let v : Fin N_geom × Fin R_Γ → M := fun p =>
    ∑ m : Fin R_Γ, ι_E' (W m p.2) * ((η_tilde ^ (m : ℕ)) (e_M p.1))
  have hη_pow_Bsub : ∀ (n : ℕ) (i : Fin N_geom), (η_tilde ^ n) (e_M i) ∈ B_sub := by
    intro n
    induction n with
    | zero =>
      intro i
      simpa using he_sub i
    | succ n ih =>
      intro i
      rw [pow_succ', AlgEquiv.mul_apply]
      exact hη_Bsub _ (ih i)
  have hι_Bsub : ∀ z : E', ι_E' z ∈ B_sub := fun z => hPoly_sub ⟨Polynomial.C z, rfl⟩
  have hv_Bsub : ∀ p, v p ∈ B_sub := fun p =>
    B_sub.sum_mem fun m _ => B_sub.mul_mem (hι_Bsub _) (hη_pow_Bsub _ _)
  let σ_cyc : Fin R_Γ ≃ Fin R_Γ :=
    { toFun := fun m => if h : (m : ℕ) + 1 < R_Γ then ⟨(m : ℕ) + 1, h⟩ else ⟨0, hR⟩
      invFun := fun m => if (m : ℕ) = 0 then ⟨R_Γ - 1, by omega⟩ else ⟨(m : ℕ) - 1, by omega⟩
      left_inv := fun m => by
        dsimp
        split_ifs with h1 h2 h2 <;> apply Fin.ext <;> dsimp at h2 ⊢ <;> omega
      right_inv := fun m => by
        dsimp
        split_ifs with h1 h2 h2 <;> apply Fin.ext <;> dsimp at h2 ⊢ <;> omega }
  have hv_inv : ∀ p, η_tilde (v p) = v p := by
    intro p
    dsimp [v]
    rw [map_sum]
    have h_step : ∀ m : Fin R_Γ,
        η_tilde (ι_E' (W m p.2) * ((η_tilde ^ (m : ℕ)) (e_M p.1))) =
          ι_E' (W (σ_cyc m) p.2) * ((η_tilde ^ (σ_cyc m : ℕ)) (e_M p.1)) := by
      intro m
      rw [map_mul, hη_ι]
      have hW_step : Φ_d (W m p.2) = (Φ_d ^ ((m : ℕ) + 1)) (β p.2) := by
        dsimp [W]
        rw [pow_succ', AlgEquiv.mul_apply]
      have hη_step : η_tilde ((η_tilde ^ (m : ℕ)) (e_M p.1)) =
          (η_tilde ^ ((m : ℕ) + 1)) (e_M p.1) := by
        rw [pow_succ', AlgEquiv.mul_apply]
      rw [hW_step, hη_step]
      by_cases hm : (m : ℕ) + 1 < R_Γ
      · have hσ : (σ_cyc m : ℕ) = (m : ℕ) + 1 := by simp [σ_cyc, hm]
        dsimp [W]
        rw [hσ]
      · have hm_eq : (m : ℕ) + 1 = R_Γ := by omega
        have hσ : (σ_cyc m : ℕ) = 0 := by simp [σ_cyc, hm]
        dsimp [W]
        rw [hm_eq, hσ, hΦ_pow, hη_pow, pow_zero, pow_zero]
    simp_rw [h_step]
    exact Equiv.sum_comp σ_cyc (fun m => ι_E' (W m p.2) * ((η_tilde ^ (m : ℕ)) (e_M p.1)))
  have hv_span : Submodule.span (RatFunc E') (Set.range v) = ⊤ := by
    let m₀ : Fin R_Γ := ⟨0, hR⟩
    have he_mem : ∀ i : Fin N_geom, e_M i ∈ Submodule.span (RatFunc E') (Set.range v) := by
      intro i
      have h_comb : ∑ α : Fin R_Γ, (κ_E' (W⁻¹ α m₀)) • v (i, α) = e_M i := by
        dsimp [v]
        simp_rw [Finset.smul_sum, hκ_smul]
        rw [Finset.sum_comm]
        have h_inner : ∀ m : Fin R_Γ,
            ∑ α : Fin R_Γ, ι_E' (W⁻¹ α m₀) * (ι_E' (W m α) * ((η_tilde ^ (m : ℕ)) (e_M i))) =
              ι_E' ((W * W⁻¹) m m₀) * ((η_tilde ^ (m : ℕ)) (e_M i)) := by
          intro m
          rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
          refine Finset.sum_congr rfl fun α _ => ?_
          rw [map_mul]
          ring
        simp_rw [h_inner, hW_mul_inv]
        rw [Finset.sum_eq_single m₀]
        · simp [m₀]
        · intro m _ hm
          rw [Matrix.one_apply_ne hm, map_zero, zero_mul]
        · intro hm₀
          exact absurd (Finset.mem_univ m₀) hm₀
      rw [← h_comb]
      exact Submodule.sum_mem _ fun α _ =>
        Submodule.smul_mem _ _ (Submodule.subset_span ⟨(i, α), rfl⟩)
    apply top_unique
    rw [← e_M.span_eq, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    exact he_mem i
  obtain ⟨f_raw, hf_mem, hf_span, hf_li⟩ :=
    Submodule.exists_fun_fin_finrank_span_eq (RatFunc E') (Set.range v)
  have h_finrank_span :
      Module.finrank (RatFunc E') ↥(Submodule.span (RatFunc E') (Set.range v)) = N_geom := by
    rw [hv_span]
    exact (LinearEquiv.finrank_eq Submodule.topEquiv).trans
      ((Module.finrank_eq_card_basis e_M).trans (Fintype.card_fin N_geom))
  let e_fin : Fin N_geom ≃
      Fin (Module.finrank (RatFunc E') ↥(Submodule.span (RatFunc E') (Set.range v))) :=
    finCongr h_finrank_span.symm
  let u_vec : Fin N_geom → M := f_raw ∘ e_fin
  have hu_li : LinearIndependent (RatFunc E') u_vec := hf_li.comp e_fin e_fin.injective
  have hu_range : Set.range u_vec = Set.range f_raw := by
    ext x
    simp [u_vec, e_fin.surjective.exists]
  have hu_span : Submodule.span (RatFunc E') (Set.range u_vec) = ⊤ := by
    rw [hu_range, hf_span, hv_span]
  let u : Module.Basis (Fin N_geom) (RatFunc E') M := Module.Basis.mk hu_li hu_span.ge
  have hu_coe : ∀ k : Fin N_geom, u k = u_vec k := fun k => by simp [u]
  let p_idx : Fin N_geom → Fin N_geom × Fin R_Γ := fun k => Classical.choose (hf_mem (e_fin k))
  have hp_idx : ∀ k : Fin N_geom, v (p_idx k) = u k := fun k => by
    rw [hu_coe]
    exact Classical.choose_spec (hf_mem (e_fin k))
  have hu_Bsub : ∀ k : Fin N_geom, u k ∈ B_sub := fun k => by
    rw [← hp_idx k]
    exact hv_Bsub _
  have hu_inv : ∀ k : Fin N_geom, η_tilde (u k) = u k := fun k => by
    rw [← hp_idx k]
    exact hv_inv _
  let u_orb : Fin N_geom → Fin R_Γ → Fin N_geom → E' := fun k m i =>
    if i = (p_idx k).1 then W m (p_idx k).2 else 0
  have hu_orb : ∀ k : Fin N_geom,
      u k = ∑ m : Fin R_Γ, ∑ i : Fin N_geom, ι_E' (u_orb k m i) * ((η_tilde ^ (m : ℕ)) (e_M i)) := by
    intro k
    rw [← hp_idx k]
    dsimp [v, u_orb]
    refine Finset.sum_congr rfl fun m _ => ?_
    symm
    rw [Finset.sum_eq_single (p_idx k).1]
    · simp
    · intro i _ hi
      simp [hi]
    · intro hmem
      exact absurd (Finset.mem_univ _) hmem

  
  let H : Subgroup (M ≃ₐ[RatFunc E] M) := Subgroup.zpowers η_tilde
  let E_fix : IntermediateField (RatFunc E) M := IntermediateField.fixedField H
  have hEfix_iff : ∀ x : M, x ∈ E_fix ↔ η_tilde x = x := by
    intro x
    rw [IntermediateField.mem_fixedField_iff]
    constructor
    · intro hx
      exact hx η_tilde (Subgroup.mem_zpowers η_tilde)
    · intro hx g hg
      obtain ⟨z, rfl⟩ := Subgroup.mem_zpowers_iff.mp hg
      have h_npow : ∀ n : ℕ, (η_tilde ^ n) x = x := by
        intro n
        induction n with
        | zero => simp
        | succ n ih => rw [pow_succ', AlgEquiv.mul_apply, ih, hx]
      have hx_inv : (η_tilde⁻¹) x = x := by
        change η_tilde.symm x = x
        conv_lhs => rw [← hx]
        exact η_tilde.symm_apply_apply x
      have h_inv_npow : ∀ n : ℕ, ((η_tilde⁻¹) ^ n) x = x := by
        intro n
        induction n with
        | zero => simp
        | succ n ih => rw [pow_succ', AlgEquiv.mul_apply, ih, hx_inv]
      cases z with
      | ofNat n =>
        rw [Int.ofNat_eq_natCast, zpow_natCast]
        exact h_npow n
      | negSucc n =>
        rw [zpow_negSucc, ← inv_pow]
        exact h_inv_npow (n + 1)
  let φ_H : Fin R_Γ → ↥H := fun m =>
    ⟨η_tilde ^ (m : ℕ), H.pow_mem (Subgroup.mem_zpowers η_tilde) (m : ℕ)⟩
  have hφ_H_inj : Function.Injective φ_H := by
    intro m₁ m₂ hm
    apply hΦ_inj m₁ m₂
    ext z
    apply hι_E'_inj
    rw [← hη_pow_ι, ← hη_pow_ι]
    exact congrArg (fun g : ↥H => g.1 (ι_E' z)) hm
  have hφ_H_surj : Function.Surjective φ_H := by
    rintro ⟨g, hg⟩
    obtain ⟨z, rfl⟩ := Subgroup.mem_zpowers_iff.mp hg
    let R_Z : ℤ := (R_Γ : ℤ)
    have hRZ_pos : 0 < R_Z := by omega
    let r_Z : ℤ := z % R_Z
    have hr_nonneg : 0 ≤ r_Z := Int.emod_nonneg z hRZ_pos.ne'
    have hr_lt : r_Z < R_Z := Int.emod_lt_of_pos z hRZ_pos
    let r : ℕ := r_Z.toNat
    have hr_fin : r < R_Γ := by omega
    have hr_cast : (r : ℤ) = r_Z := Int.toNat_of_nonneg hr_nonneg
    refine ⟨⟨r, hr_fin⟩, Subtype.ext ?_⟩
    dsimp [φ_H]
    have hz_eq : z = R_Z * (z / R_Z) + (r : ℤ) := by
      rw [hr_cast]
      linarith [EuclideanDomain.div_add_mod' z R_Z]
    conv_rhs => rw [hz_eq]
    rw [zpow_add, zpow_mul, zpow_natCast, zpow_natCast, hη_pow, one_zpow, one_mul]
  have hH_card : Nat.card ↥H = R_Γ :=
    (Nat.card_congr (Equiv.ofBijective φ_H ⟨hφ_H_inj, hφ_H_surj⟩)).symm.trans (Nat.card_fin R_Γ)
  have h_artin : Module.finrank ↥E_fix M = R_Γ :=
    (IntermediateField.finrank_fixedField_eq_card H).trans hH_card
  have _ : FiniteDimensional (RatFunc E) (RatFunc E') :=
    FiniteDimensional.left (RatFunc E) (RatFunc E') M
  have h_rf_le : Module.finrank (RatFunc E) (RatFunc E') ≤ R_Γ := by
    let β_RF : Fin R_Γ → RatFunc E' := fun α => κ_E' (β α)
    let S_RF : Submodule (RatFunc E) (RatFunc E') := Submodule.span (RatFunc E) (Set.range β_RF)
    have hPoly_SRF : ∀ P : Polynomial E',
        algebraMap (Polynomial E') (RatFunc E') P ∈ S_RF := by
      intro P
      refine Polynomial.induction_on' P ?_ ?_
      · intro p q hp hq
        rw [map_add]
        exact S_RF.add_mem hp hq
      · intro n a
        have ha_repr : a = ∑ α : Fin R_Γ, algebraMap E E' (β.repr a α) * β α := by
          conv_lhs => rw [← β.sum_repr a]
          simp_rw [Algebra.smul_def]
        have hmon_eq : Polynomial.monomial n a =
            ∑ α : Fin R_Γ, ((Polynomial.monomial n (β.repr a α)).map (algebraMap E E')) *
              Polynomial.C (β α) := by
          rw [← Polynomial.C_mul_X_pow_eq_monomial]
          conv_lhs => rw [ha_repr]
          rw [map_sum, Finset.sum_mul]
          refine Finset.sum_congr rfl fun α _ => ?_
          rw [Polynomial.map_monomial, ← Polynomial.C_mul_X_pow_eq_monomial, map_mul]
          ring
        rw [hmon_eq, map_sum]
        refine S_RF.sum_mem fun α _ => ?_
        rw [map_mul, ← hRatCompat (Polynomial.monomial n (β.repr a α)), ← Algebra.smul_def]
        exact S_RF.smul_mem _ (Submodule.subset_span ⟨α, rfl⟩)
    have hmul_SRF : ∀ {x y : RatFunc E'}, x ∈ S_RF → y ∈ S_RF → x * y ∈ S_RF := by
      intro x y hx hy
      induction hx using Submodule.span_induction with
      | mem u hu =>
        rcases hu with ⟨α₁, rfl⟩
        induction hy using Submodule.span_induction with
        | mem w hw =>
          rcases hw with ⟨α₂, rfl⟩
          change κ_E' (β α₁) * κ_E' (β α₂) ∈ S_RF
          rw [← map_mul]
          exact hPoly_SRF (Polynomial.C (β α₁ * β α₂))
        | zero => simp
        | add w₁ w₂ _ _ ih₁ ih₂ =>
          rw [mul_add]
          exact S_RF.add_mem ih₁ ih₂
        | smul c w _ ih =>
          rw [mul_smul_comm]
          exact S_RF.smul_mem c ih
      | zero => simp
      | add u₁ u₂ _ _ ih₁ ih₂ =>
        rw [add_mul]
        exact S_RF.add_mem ih₁ ih₂
      | smul c u _ ih =>
        rw [smul_mul_assoc]
        exact S_RF.smul_mem c ih
    have h1_SRF : (1 : RatFunc E') ∈ S_RF := by
      rw [← map_one (algebraMap (Polynomial E') (RatFunc E'))]
      exact hPoly_SRF 1
    have hinv_SRF : ∀ {q : RatFunc E'}, q ∈ S_RF → q ≠ 0 → q⁻¹ ∈ S_RF := by
      intro q hq hq0
      let L_q : ↥S_RF →ₗ[RatFunc E] ↥S_RF :=
        { toFun := fun y => ⟨q * y.1, hmul_SRF hq y.2⟩
          map_add' := fun y₁ y₂ => Subtype.ext (mul_add q y₁.1 y₂.1)
          map_smul' := fun c y => Subtype.ext (mul_smul_comm c q y.1) }
      have hLq_inj : Function.Injective L_q := by
        intro y₁ y₂ hy
        apply Subtype.ext
        exact mul_left_cancel₀ hq0 (congrArg Subtype.val hy)
      have hLq_surj : Function.Surjective L_q := LinearMap.injective_iff_surjective.mp hLq_inj
      obtain ⟨y, hy⟩ := hLq_surj ⟨1, h1_SRF⟩
      have hqy : q * y.1 = 1 := congrArg Subtype.val hy
      have hinv_eq : q⁻¹ = y.1 := inv_eq_of_mul_eq_one_right hqy
      rw [hinv_eq]
      exact y.2
    have hSRF_top : S_RF = ⊤ := by
      ext f
      simp only [Submodule.mem_top, iff_true]
      obtain ⟨a, b, hb_mem, hab⟩ := IsFractionRing.div_surjective (A := Polynomial E') f
      have hb_ne : b ≠ 0 := nonZeroDivisors.ne_zero hb_mem
      have hιb_ne : algebraMap (Polynomial E') (RatFunc E') b ≠ 0 :=
        (map_ne_zero_iff _ (IsFractionRing.injective (Polynomial E') (RatFunc E'))).mpr hb_ne
      rw [← hab, div_eq_mul_inv]
      exact hmul_SRF (hPoly_SRF a) (hinv_SRF (hPoly_SRF b) hιb_ne)
    exact (finrank_le_of_span_eq_top hSRF_top).trans (Fintype.card_fin R_Γ).le
  have _ : FiniteDimensional (RatFunc E) ↥E_fix :=
    FiniteDimensional.left (RatFunc E) ↥E_fix M
  have _ : FiniteDimensional ↥E_fix M :=
    FiniteDimensional.right (RatFunc E) ↥E_fix M
  have h_dim_le : Module.finrank (RatFunc E) ↥E_fix ≤ N_geom := by
    have h1 := Module.finrank_mul_finrank (RatFunc E) ↥E_fix M
    have h2 := Module.finrank_mul_finrank (RatFunc E) (RatFunc E') M
    have h3 : Module.finrank (RatFunc E') M = N_geom :=
      (Module.finrank_eq_card_basis e_M).trans (Fintype.card_fin N_geom)
    rw [h_artin] at h1
    rw [h3] at h2
    have hmul_le : Module.finrank (RatFunc E) ↥E_fix * R_Γ ≤ R_Γ * N_geom := by
      rw [h1, ← h2]
      exact Nat.mul_le_mul_right N_geom h_rf_le
    nlinarith
  let u_fix : Fin N_geom → ↥E_fix := fun k => ⟨u k, (hEfix_iff (u k)).mpr (hu_inv k)⟩
  have hu_fix_li : LinearIndependent (RatFunc E) u_fix := by
    rw [Fintype.linearIndependent_iff]
    intro g hg
    have hg_M : ∑ k : Fin N_geom, (algebraMap (RatFunc E) (RatFunc E') (g k)) • u k = 0 := by
      have hg_val : (∑ k : Fin N_geom, g k • u_fix k).1 = 0 := congrArg Subtype.val hg
      rw [AddSubmonoidClass.coe_finsetSum] at hg_val
      convert hg_val using 1
      refine Finset.sum_congr rfl fun k _ => ?_
      exact IsScalarTower.algebraMap_smul (RatFunc E') (g k) (u k)
    intro k
    have hgk := Fintype.linearIndependent_iff.mp u.linearIndependent _ hg_M k
    exact (algebraMap (RatFunc E) (RatFunc E')).injective (by simpa using hgk)
  have h_dim_ge : N_geom ≤ Module.finrank (RatFunc E) ↥E_fix := by
    simpa using hu_fix_li.fintype_card_le_finrank
  have h_dim_eq : Module.finrank (RatFunc E) ↥E_fix = N_geom := le_antisymm h_dim_le h_dim_ge
  have _ : Nonempty (Fin N_geom) := ⟨⟨0, hN⟩⟩
  let b_fix : Module.Basis (Fin N_geom) (RatFunc E) ↥E_fix :=
    basisOfLinearIndependentOfCardEqFinrank hu_fix_li
      ((Fintype.card_fin N_geom).trans h_dim_eq.symm)
  have hb_fix_coe : ∀ k : Fin N_geom, (b_fix k).1 = u k := fun k => by
    have hk := congrFun (coe_basisOfLinearIndependentOfCardEqFinrank hu_fix_li
      ((Fintype.card_fin N_geom).trans h_dim_eq.symm)) k
    exact congrArg Subtype.val hk

  
  have _ : Algebra.IsSeparable (RatFunc E) ↥E_fix :=
    Algebra.isSeparable_tower_bot_of_isSeparable (RatFunc E) ↥E_fix M
  let Ω_K := AlgebraicClosure (RatFunc E)
  let Emb := (↥E_fix →ₐ[RatFunc E] Ω_K)
  have hEmb_card : Fintype.card Emb = N_geom :=
    (AlgHom.card (RatFunc E) ↥E_fix Ω_K).trans h_dim_eq
  let _ : Fintype E := Fintype.ofFinite E
  let q_E : ℕ := Fintype.card E
  have hqE_eq : q_E = Nat.card E := Nat.card_eq_fintype_card.symm
  have hN_sq_q : N_geom ^ 2 < q_E := by rwa [hqE_eq]
  let j_E : E →+* RatFunc E := (algebraMap (Polynomial E) (RatFunc E)).comp Polynomial.C
  let ι_EΩ : E →+* Ω_K := (algebraMap (RatFunc E) Ω_K).comp j_E
  have hι_EΩ_inj : Function.Injective ι_EΩ := ι_EΩ.injective
  let P_neq := { p : Emb × Emb // p.1 ≠ p.2 }
  have hP_card : Fintype.card P_neq ≤ N_geom ^ 2 := by
    calc Fintype.card P_neq ≤ Fintype.card (Emb × Emb) := Fintype.card_subtype_le _
      _ = Fintype.card Emb * Fintype.card Emb := Fintype.card_prod Emb Emb
      _ = N_geom ^ 2 := by rw [hEmb_card, sq]
  have h_exists_diff : ∀ p : P_neq,
      ∃ k : Fin N_geom, p.1.1 (b_fix k) - p.1.2 (b_fix k) ≠ 0 := by
    intro p
    by_contra hall
    have hall' : ∀ k : Fin N_geom, p.1.1 (b_fix k) - p.1.2 (b_fix k) = 0 :=
      fun k => Classical.not_not.mp fun h => hall ⟨k, h⟩
    apply p.2
    ext x
    conv_lhs => rw [← b_fix.sum_repr x]
    conv_rhs => rw [← b_fix.sum_repr x]
    rw [map_sum, map_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [map_smul, map_smul, sub_eq_zero.mp (hall' k)]
  let Bad : P_neq → Finset (Fin N_geom → E) := fun p =>
    Finset.univ.filter fun c =>
      ∑ k : Fin N_geom, ι_EΩ (c k) * (p.1.1 (b_fix k) - p.1.2 (b_fix k)) = 0
  have hBad_card : ∀ p : P_neq, (Bad p).card ≤ q_E ^ (N_geom - 1) := by
    intro p
    let k_p : Fin N_geom := Classical.choose (h_exists_diff p)
    have hk_p : p.1.1 (b_fix k_p) - p.1.2 (b_fix k_p) ≠ 0 :=
      Classical.choose_spec (h_exists_diff p)
    let π_p : ↥(Bad p) → (↥(Finset.univ.erase k_p) → E) := fun c j => c.1 j.1
    have hπ_inj : Function.Injective π_p := by
      intro c₁ c₂ hπ
      have h_other : ∀ k ∈ Finset.univ.erase k_p, c₁.1 k = c₂.1 k :=
        fun k hk => congrFun hπ ⟨k, hk⟩
      have hc₁ := (Finset.mem_filter.mp c₁.2).2
      have hc₂ := (Finset.mem_filter.mp c₂.2).2
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ k_p)] at hc₁ hc₂
      have h_rest_eq :
          ∑ k ∈ Finset.univ.erase k_p, ι_EΩ (c₁.1 k) * (p.1.1 (b_fix k) - p.1.2 (b_fix k)) =
          ∑ k ∈ Finset.univ.erase k_p, ι_EΩ (c₂.1 k) * (p.1.1 (b_fix k) - p.1.2 (b_fix k)) :=
        Finset.sum_congr rfl fun k hk => by rw [h_other k hk]
      rw [h_rest_eq] at hc₁
      have h_sub : (ι_EΩ (c₁.1 k_p) - ι_EΩ (c₂.1 k_p)) *
          (p.1.1 (b_fix k_p) - p.1.2 (b_fix k_p)) = 0 := by
        linear_combination hc₁ - hc₂
      have h_eq_kp : c₁.1 k_p = c₂.1 k_p :=
        hι_EΩ_inj (sub_eq_zero.mp ((mul_eq_zero.mp h_sub).resolve_right hk_p))
      apply Subtype.ext
      ext k
      by_cases hk : k = k_p
      · rwa [hk]
      · exact h_other k (Finset.mem_erase.mpr ⟨hk, Finset.mem_univ k⟩)
    have hcard_erase : Fintype.card ↥(Finset.univ.erase k_p) = N_geom - 1 := by
      rw [Fintype.card_coe, Finset.card_erase_of_mem (Finset.mem_univ k_p),
        Finset.card_univ, Fintype.card_fin]
    calc (Bad p).card = Fintype.card ↥(Bad p) := (Fintype.card_coe (Bad p)).symm
      _ ≤ Fintype.card (↥(Finset.univ.erase k_p) → E) := Fintype.card_le_of_injective π_p hπ_inj
      _ = q_E ^ Fintype.card ↥(Finset.univ.erase k_p) := Fintype.card_fun
      _ = q_E ^ (N_geom - 1) := by rw [hcard_erase]
  let BadAll : Finset (Fin N_geom → E) := Finset.univ.biUnion Bad
  have h_exists_c : ∃ c : Fin N_geom → E, c ∉ BadAll := by
    have hqE_pos : 0 < q_E := by
      have : 1 ≤ N_geom ^ 2 := Nat.one_le_pow 2 N_geom hN
      omega
    have hpow_pos : 0 < q_E ^ (N_geom - 1) := Nat.pow_pos hqE_pos
    have hcard_lt : BadAll.card < (Finset.univ : Finset (Fin N_geom → E)).card := by
      calc BadAll.card ≤ ∑ p ∈ (Finset.univ : Finset P_neq), (Bad p).card :=
            Finset.card_biUnion_le
        _ ≤ ∑ _p ∈ (Finset.univ : Finset P_neq), q_E ^ (N_geom - 1) :=
            Finset.sum_le_sum fun p _ => hBad_card p
        _ = Fintype.card P_neq * q_E ^ (N_geom - 1) := by
            rw [Finset.sum_const, Finset.card_univ, smul_eq_mul]
        _ ≤ N_geom ^ 2 * q_E ^ (N_geom - 1) := Nat.mul_le_mul_right _ hP_card
        _ < q_E * q_E ^ (N_geom - 1) := Nat.mul_lt_mul_of_pos_right hN_sq_q hpow_pos
        _ = q_E ^ N_geom := by
            rw [← pow_succ', Nat.sub_add_cancel hN]
        _ = (Finset.univ : Finset (Fin N_geom → E)).card := by
            rw [Finset.card_univ, Fintype.card_fun, Fintype.card_fin]
    by_contra hall
    have hall' : ∀ c : Fin N_geom → E, c ∈ BadAll :=
      fun c => Classical.not_not.mp fun hc => hall ⟨c, hc⟩
    have heq : BadAll = Finset.univ := Finset.eq_univ_of_forall hall'
    rw [heq] at hcard_lt
    exact lt_irrefl _ hcard_lt
  obtain ⟨c, hc_good⟩ := h_exists_c
  let w_fix : ↥E_fix := ∑ k : Fin N_geom, (j_E (c k)) • b_fix k
  let w : M := w_fix.1
  have hw_sep_emb : Function.Injective (fun σ : Emb => σ w_fix) := by
    intro σ₁ σ₂ hσ
    by_contra hne
    have hp_mem : c ∈ Bad ⟨(σ₁, σ₂), hne⟩ := by
      rw [Finset.mem_filter]
      refine ⟨Finset.mem_univ c, ?_⟩
      have hdiff : σ₁ w_fix - σ₂ w_fix = 0 := sub_eq_zero.mpr hσ
      dsimp [w_fix] at hdiff
      rw [map_sum, map_sum, ← Finset.sum_sub_distrib] at hdiff
      convert hdiff using 1
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [map_smul, map_smul, Algebra.smul_def, Algebra.smul_def, ← mul_sub]
      rfl
    exact hc_good (Finset.mem_biUnion.mpr ⟨⟨(σ₁, σ₂), hne⟩, Finset.mem_univ _, hp_mem⟩)
  have hw_fix_int : _root_.IsIntegral (RatFunc E) w_fix := Algebra.IsIntegral.isIntegral w_fix
  have hw_fix_deg : (minpoly (RatFunc E) w_fix).natDegree = N_geom := by
    let p_w := minpoly (RatFunc E) w_fix
    let p_wΩ := p_w.map (algebraMap (RatFunc E) Ω_K)
    have hp_wΩ_mon : p_wΩ.Monic := (minpoly.monic hw_fix_int).map _
    have h_img_sub : Finset.image (fun σ : Emb => σ w_fix) Finset.univ ⊆ p_wΩ.roots.toFinset := by
      intro α hα
      obtain ⟨σ, _, rfl⟩ := Finset.mem_image.mp hα
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hp_wΩ_mon.ne_zero, Polynomial.IsRoot.def,
        Polynomial.eval_map, ← Polynomial.aeval_def, Polynomial.aeval_algHom_apply σ w_fix p_w,
        minpoly.aeval, map_zero]
    have h_ge : N_geom ≤ p_w.natDegree := by
      calc N_geom = Fintype.card Emb := hEmb_card.symm
        _ = (Finset.univ : Finset Emb).card := Finset.card_univ.symm
        _ = (Finset.image (fun σ : Emb => σ w_fix) Finset.univ).card :=
            (Finset.card_image_of_injective _ hw_sep_emb).symm
        _ ≤ p_wΩ.roots.toFinset.card := Finset.card_le_card h_img_sub
        _ ≤ Multiset.card p_wΩ.roots := Multiset.toFinset_card_le _
        _ ≤ p_wΩ.natDegree := Polynomial.card_roots' p_wΩ
        _ = p_w.natDegree := (minpoly.monic hw_fix_int).natDegree_map _
    let K_w := IntermediateField.adjoin (RatFunc E) ({w_fix} : Set ↥E_fix)
    have h_mul := Module.finrank_mul_finrank (RatFunc E) ↥K_w ↥E_fix
    rw [IntermediateField.adjoin.finrank hw_fix_int, h_dim_eq] at h_mul
    have h_pos : 0 < Module.finrank ↥K_w ↥E_fix := Module.finrank_pos
    have h_le : p_w.natDegree ≤ N_geom := by
      change (minpoly (RatFunc E) w_fix).natDegree ≤ N_geom
      nlinarith
    exact le_antisymm h_le h_ge
  have hKw_top : IntermediateField.adjoin (RatFunc E) ({w_fix} : Set ↥E_fix) = ⊤ := by
    let K_w := IntermediateField.adjoin (RatFunc E) ({w_fix} : Set ↥E_fix)
    have h_mul := Module.finrank_mul_finrank (RatFunc E) ↥K_w ↥E_fix
    rw [IntermediateField.adjoin.finrank hw_fix_int, hw_fix_deg, h_dim_eq] at h_mul
    have h_one : Module.finrank ↥K_w ↥E_fix = 1 := by nlinarith
    exact IntermediateField.finrank_eq_one_iff_eq_top.mp h_one
  have hw_gen : IntermediateField.adjoin (RatFunc E') ({w} : Set M) = ⊤ := by
    let L_w := IntermediateField.adjoin (RatFunc E') ({w} : Set M)
    let K'_sub : IntermediateField (RatFunc E) ↥E_fix :=
      (L_w.restrictScalars (RatFunc E)).comap E_fix.val
    have hw_mem_K' : w_fix ∈ K'_sub := by
      change w ∈ L_w
      exact IntermediateField.subset_adjoin (RatFunc E') ({w} : Set M) (Set.mem_singleton w)
    have h_top_le : (⊤ : IntermediateField (RatFunc E) ↥E_fix) ≤ K'_sub := by
      rw [← hKw_top, IntermediateField.adjoin_le_iff]
      rintro _ rfl
      exact hw_mem_K'
    have hu_mem_Lw : ∀ k : Fin N_geom, u k ∈ L_w := by
      intro k
      rw [← hb_fix_coe k]
      exact h_top_le IntermediateField.mem_top
    have h_submod_top : (⊤ : Submodule (RatFunc E') M) ≤ L_w.toSubalgebra.toSubmodule := by
      rw [← u.span_eq, Submodule.span_le]
      rintro _ ⟨k, rfl⟩
      exact hu_mem_Lw k
    ext x
    simp only [IntermediateField.mem_top, iff_true]
    exact h_submod_top Submodule.mem_top

  
  have hw_eta : η_tilde w = w := (hEfix_iff w).mp w_fix.2
  have hw_sum_u : w = ∑ k : Fin N_geom, ι_E' (algebraMap E E' (c k)) * u k := by
    dsimp [w, w_fix]
    rw [AddSubmonoidClass.coe_finsetSum]
    refine Finset.sum_congr rfl fun k _ => ?_
    change (j_E (c k)) • (b_fix k).1 = ι_E' (algebraMap E E' (c k)) * u k
    rw [hb_fix_coe k, Algebra.smul_def]
    congr 1
    change algebraMap (RatFunc E) M (algebraMap (Polynomial E) (RatFunc E) (Polynomial.C (c k))) =
      algebraMap (Polynomial E') M (Polynomial.C (algebraMap E E' (c k)))
    rw [← IsScalarTower.algebraMap_apply (Polynomial E) (RatFunc E) M,
      ← hPolyCompat (Polynomial.C (c k)), Polynomial.map_C]
  have hw_Bsub : w ∈ B_sub := by
    rw [hw_sum_u]
    exact B_sub.sum_mem fun k _ => B_sub.mul_mem (hι_Bsub _) (hu_Bsub k)
  have hw_int_PE' : _root_.IsIntegral (Polynomial E') w := by
    rw [hw_sum_u]
    refine _root_.IsIntegral.sum _ fun k _ => _root_.IsIntegral.mul isIntegral_algebraMap ?_
    rw [hu_orb k]
    refine _root_.IsIntegral.sum _ fun m _ =>
      _root_.IsIntegral.sum _ fun i _ => _root_.IsIntegral.mul isIntegral_algebraMap (hInt_orb m i)
  have hw_deg_raw : (minpoly (RatFunc E) w).natDegree = N_geom := by
    have hmin_eq : minpoly (RatFunc E) w = minpoly (RatFunc E) w_fix :=
      minpoly.algHom_eq E_fix.val Subtype.val_injective w_fix
    rw [hmin_eq, hw_fix_deg]
  have hw_orb_sum_raw : w = ∑ m : Fin R_Γ, ∑ i : Fin N_geom,
      ι_E' (∑ idx : Fin N_geom, algebraMap E E' (c idx) * u_orb idx m i) *
        ((η_tilde ^ (m : ℕ)) (e_M i)) := by
    rw [hw_sum_u]
    simp_rw [hu_orb, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun idx _ => ?_
    rw [map_mul, mul_assoc]
  
  obtain ⟨w_op, a_coeff, hw_Bsub_op, hw_eta_op, hw_int_PE'_op, hw_deg_op, hw_gen_op, hw_orb_op⟩ :
      ∃ (w_op : M) (a_coeff : Fin R_Γ → Fin N_geom → E'),
        w_op ∈ B_sub ∧
        η_tilde w_op = w_op ∧
        _root_.IsIntegral (Polynomial E') w_op ∧
        (minpoly (RatFunc E) w_op).natDegree = N_geom ∧
        IntermediateField.adjoin (RatFunc E') ({w_op} : Set M) = ⊤ ∧
        w_op = ∑ m : Fin R_Γ, ∑ i : Fin N_geom,
          ι_E' (a_coeff m i) * ((η_tilde ^ (m : ℕ)) (e_M i)) :=
    ⟨w, fun m i => ∑ idx : Fin N_geom, algebraMap E E' (c idx) * u_orb idx m i,
      hw_Bsub, hw_eta, hw_int_PE', hw_deg_raw, hw_gen, hw_orb_sum_raw⟩
  have hw_int_PE : _root_.IsIntegral (Polynomial E) w_op := by
    let _ : Algebra (Polynomial E) (Polynomial E') :=
      (Polynomial.mapRingHom (algebraMap E E')).toAlgebra
    have _ : IsScalarTower (Polynomial E) (Polynomial E') M :=
      IsScalarTower.of_algebraMap_eq fun P => (hPolyCompat P).symm
    have _ : Algebra.IsIntegral (Polynomial E) (Polynomial E') := by
      refine ⟨fun P => ?_⟩
      refine Polynomial.induction_on' P ?_ ?_
      · intro p q hp hq
        exact hp.add hq
      · intro n a
        rw [← Polynomial.C_mul_X_pow_eq_monomial]
        have hX_int : _root_.IsIntegral (Polynomial E) (Polynomial.X : Polynomial E') := by
          have hX_eq : (Polynomial.X : Polynomial E') =
              algebraMap (Polynomial E) (Polynomial E') Polynomial.X := by
            change Polynomial.X = Polynomial.X.map (algebraMap E E')
            exact (Polynomial.map_X (algebraMap E E')).symm
          rw [hX_eq]
          exact isIntegral_algebraMap
        have hCa_int : _root_.IsIntegral (Polynomial E) (Polynomial.C a) := by
          have ha_int : _root_.IsIntegral E a := Algebra.IsIntegral.isIntegral a
          let q_a : Polynomial E := minpoly E a
          let Q_a : Polynomial (Polynomial E) := q_a.map Polynomial.C
          refine ⟨Q_a, (minpoly.monic ha_int).map Polynomial.C, ?_⟩
          rw [Polynomial.eval₂_map]
