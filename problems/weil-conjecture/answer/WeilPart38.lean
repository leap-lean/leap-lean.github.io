  have hTransportLC :
      ∀ {A B C S_E S_Eloc : AlgebraicGeometry.Scheme.{u}} {M : Type u}
        (j_m : A ⟶ C) (w_m : B ⟶ C) (m_loc : S_Eloc ⟶ S_E)
        (e_W : S_E ≅ B) (e_WU : S_Eloc ≅ CategoryTheory.Limits.pullback j_m w_m),
        e_WU.hom ≫ CategoryTheory.Limits.pullback.snd j_m w_m = m_loc ≫ e_W.hom →
        ∀ (g : LocallyConstant ↥(CategoryTheory.Limits.pullback w_m j_m) M),
          (∃ f₀ : LocallyConstant ↥S_E M,
            ∀ u : ↥S_Eloc,
              g ((e_WU.hom ≫ (CategoryTheory.Limits.pullbackSymmetry j_m w_m).hom).base u) =
                f₀ (m_loc.base u)) →
          ∃ f : LocallyConstant ↥B M,
            ∀ z : ↥(CategoryTheory.Limits.pullback w_m j_m),
              g z = f ((CategoryTheory.Limits.pullback.fst w_m j_m).base z) := by
    intro A B C S_E S_Eloc M j_m w_m m_loc e_W e_WU he_comm g ⟨f₀, hf₀⟩
    let sym := CategoryTheory.Limits.pullbackSymmetry j_m w_m
    let f : LocallyConstant ↥B M :=
      ⟨f₀ ∘ e_W.inv.base, f₀.isLocallyConstant.comp_continuous e_W.inv.continuous⟩
    refine ⟨f, fun z => ?_⟩
    let u : ↥S_Eloc := (sym.inv ≫ e_WU.inv).base z
    have hu_in : (e_WU.hom ≫ sym.hom).base u = z := by
      have hid : (sym.inv ≫ e_WU.inv) ≫ (e_WU.hom ≫ sym.hom) = 𝟙 _ := by
        rw [Category.assoc, ← Category.assoc e_WU.inv, e_WU.inv_hom_id,
          Category.id_comp, sym.inv_hom_id]
      exact congrArg (fun m => m.base z) hid
    have hm_eq :
        (sym.inv ≫ e_WU.inv) ≫ m_loc =
          CategoryTheory.Limits.pullback.fst w_m j_m ≫ e_W.inv := by
      have hm1 : m_loc = e_WU.hom ≫ CategoryTheory.Limits.pullback.snd j_m w_m ≫ e_W.inv :=
        (Category.comp_id m_loc).symm.trans
          ((congrArg (m_loc ≫ ·) e_W.hom_inv_id.symm).trans
            ((Category.assoc m_loc e_W.hom e_W.inv).symm.trans
              ((congrArg (· ≫ e_W.inv) he_comm.symm).trans
                (Category.assoc e_WU.hom _ e_W.inv))))
      rw [hm1, Category.assoc sym.inv e_WU.inv,
        ← Category.assoc e_WU.inv e_WU.hom, e_WU.inv_hom_id, Category.id_comp,
        ← Category.assoc, CategoryTheory.Limits.pullbackSymmetry_inv_comp_snd]
    have hbase : m_loc.base u = e_W.inv.base ((CategoryTheory.Limits.pullback.fst w_m j_m).base z) :=
      congrArg (fun m => m.base z) hm_eq
    calc g z = g ((e_WU.hom ≫ sym.hom).base u) := congrArg g hu_in.symm
      _ = f₀ (m_loc.base u) := hf₀ u
      _ = f ((CategoryTheory.Limits.pullback.fst w_m j_m).base z) := congrArg f₀ hbase

  
  have hBaseChangeCoverAbstract :
      ∀ {U₁ Y₁ U₂ Y₂ W₁ W₂ : AlgebraicGeometry.Scheme.{u}}
        (j₁ : U₁ ⟶ Y₁) (w₁ : W₁ ⟶ Y₁)
        (j₂ : U₂ ⟶ Y₂) (w₂ : W₂ ⟶ Y₂)
        (π_W : W₁ ⟶ W₂)
        (π_WU : CategoryTheory.Limits.pullback j₁ w₁ ⟶ CategoryTheory.Limits.pullback j₂ w₂)
        (b : ℕ)
        (ξ₁ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j₁ w₁) ℓ b)
        (ξ₂ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j₂ w₂) ℓ b),
        π_WU ≫ CategoryTheory.Limits.pullback.snd j₂ w₂ =
          CategoryTheory.Limits.pullback.snd j₁ w₁ ≫ π_W →
        (∀ p_π : weilEtaleTorsionH (CategoryTheory.Limits.pullback j₂ w₂) ℓ b →+
              weilEtaleTorsionH (CategoryTheory.Limits.pullback j₁ w₁) ℓ b,
          WeilIsTorsionEtalePullback π_WU ℓ b p_π → p_π ξ₂ = ξ₁) →
        ∀ (I : Type u) (V : I → AlgebraicGeometry.Scheme.{u})
          (v : ∀ a, V a ⟶ W₂) (_ : ∀ a, AlgebraicGeometry.Etale (v a)),
          (⋃ a, Set.range (v a).base) = Set.univ →
          (∀ (a : I)
            (q_a : weilEtaleTorsionH (CategoryTheory.Limits.pullback j₂ w₂) ℓ b →+
              weilEtaleTorsionH
                (CategoryTheory.Limits.pullback
                  (CategoryTheory.Limits.pullback.snd j₂ w₂) (v a)) ℓ b),
            WeilIsTorsionEtalePullback
              (CategoryTheory.Limits.pullback.fst
                (CategoryTheory.Limits.pullback.snd j₂ w₂) (v a)) ℓ b q_a →
            q_a ξ₂ = 0) →
          ∃ (I' : Type u) (V_W : I' → AlgebraicGeometry.Scheme.{u})
            (u : ∀ a, V_W a ⟶ W₁) (_ : ∀ a, AlgebraicGeometry.Etale (u a)),
            (⋃ a, Set.range (u a).base) = Set.univ ∧
            ∀ (a : I')
              (p_a : weilEtaleTorsionH (CategoryTheory.Limits.pullback j₁ w₁) ℓ b →+
                weilEtaleTorsionH
                  (CategoryTheory.Limits.pullback
                    (CategoryTheory.Limits.pullback.snd j₁ w₁) (u a)) ℓ b),
              WeilIsTorsionEtalePullback
                (CategoryTheory.Limits.pullback.fst
                  (CategoryTheory.Limits.pullback.snd j₁ w₁) (u a)) ℓ b p_a →
              p_a ξ₁ = 0 := by
    intro U₁ Y₁ U₂ Y₂ W₁ W₂ j₁ w₁ j₂ w₂ π_W π_WU b ξ₁ ξ₂ hSq hξ I V v hEt_v hCov_v hKill_v
    let V_W : I → AlgebraicGeometry.Scheme.{u} :=
      fun a => CategoryTheory.Limits.pullback (v a) π_W
    let u : ∀ a : I, V_W a ⟶ W₁ :=
      fun a => CategoryTheory.Limits.pullback.snd (v a) π_W
    have hEt_u : ∀ a : I, AlgebraicGeometry.Etale (u a) := fun a =>
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback (v a) π_W) (hEt_v a)
    refine ⟨I, V_W, u, hEt_u, ?_, ?_⟩
    · ext y
      simp only [Set.mem_iUnion, Set.mem_range, Set.mem_univ, iff_true]
      have hy_in : π_W.base y ∈ ⋃ a : I, Set.range (v a).base := by
        rw [hCov_v]; trivial
      obtain ⟨a, x', hx'⟩ := Set.mem_iUnion.mp hy_in
      obtain ⟨z, -, hz_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x' y hx'
      exact ⟨a, z, hz_snd⟩
    · intro a p_a hp_a
      let fst_a := CategoryTheory.Limits.pullback.fst
        (CategoryTheory.Limits.pullback.snd j₁ w₁) (u a)
      let snd_a := CategoryTheory.Limits.pullback.snd
        (CategoryTheory.Limits.pullback.snd j₁ w₁) (u a)
      let fst_va := CategoryTheory.Limits.pullback.fst
        (CategoryTheory.Limits.pullback.snd j₂ w₂) (v a)
      have hτ_cond :
          (fst_a ≫ π_WU) ≫ CategoryTheory.Limits.pullback.snd j₂ w₂ =
            (snd_a ≫ CategoryTheory.Limits.pullback.fst (v a) π_W) ≫ v a :=
        (Category.assoc fst_a π_WU _).trans
          ((congrArg (fst_a ≫ ·) hSq).trans
            ((Category.assoc fst_a _ π_W).symm.trans
              ((congrArg (· ≫ π_W)
                  (CategoryTheory.Limits.pullback.condition
                    (f := CategoryTheory.Limits.pullback.snd j₁ w₁) (g := u a))).trans
                ((Category.assoc snd_a (u a) π_W).trans
                  ((congrArg (snd_a ≫ ·)
                      (CategoryTheory.Limits.pullback.condition (f := v a) (g := π_W)).symm).trans
                    (Category.assoc snd_a _ (v a)).symm)))))
      let τ_a : CategoryTheory.Limits.pullback
          (CategoryTheory.Limits.pullback.snd j₁ w₁) (u a) ⟶
          CategoryTheory.Limits.pullback
            (CategoryTheory.Limits.pullback.snd j₂ w₂) (v a) :=
        CategoryTheory.Limits.pullback.lift
          (fst_a ≫ π_WU)
          (snd_a ≫ CategoryTheory.Limits.pullback.fst (v a) π_W) hτ_cond
      have hτ_comm : τ_a ≫ fst_va = fst_a ≫ π_WU :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      obtain ⟨p_π, hp_π⟩ := hPullEx π_WU ℓ b
      obtain ⟨q_a, hq_a⟩ := hPullEx fst_va ℓ b
      obtain ⟨p_τ, hp_τ⟩ := hPullEx τ_a ℓ b
      obtain ⟨p_tot, hp_tot⟩ := hPullEx (fst_a ≫ π_WU) ℓ b
      have hp_tot1 : p_tot = p_a.comp p_π :=
        hPullComp fst_a π_WU ℓ b p_a p_π p_tot hp_a hp_π hp_tot
      have hp_tot' : WeilIsTorsionEtalePullback (τ_a ≫ fst_va) ℓ b p_tot := by
        rwa [hτ_comm]
      have hp_tot2 : p_tot = p_τ.comp q_a :=
        hPullComp τ_a fst_va ℓ b p_τ q_a p_tot hp_τ hq_a hp_tot'
      rw [← hξ p_π hp_π]
      change (p_a.comp p_π) ξ₂ = 0
      rw [← hp_tot1, hp_tot2]
      change p_τ (q_a ξ₂) = 0
      rw [hKill_v a q_a hq_a]
      exact map_zero p_τ

  
  have hStageSqAbstract :
      ∀ {PB_inf W_s PB_st : AlgebraicGeometry.Scheme.{u}}
        {C_E C_Eloc R_E R_Eloc : CommRingCat.{u}}
        (snd_inf : PB_inf ⟶ W_s) (snd_st : PB_st ⟶ AlgebraicGeometry.Spec R_E)
        (ι_inf : C_E ⟶ C_Eloc) (ι_E : R_E ⟶ C_E) (ι_Eloc : R_Eloc ⟶ C_Eloc)
        (ι_st : R_E ⟶ R_Eloc)
        (e_W : AlgebraicGeometry.Spec C_E ≅ W_s)
        (e_WU : AlgebraicGeometry.Spec C_Eloc ≅ PB_inf)
        (ϕ_st : AlgebraicGeometry.Spec R_Eloc ≅ PB_st),
        ι_E ≫ ι_inf = ι_st ≫ ι_Eloc →
        e_WU.hom ≫ snd_inf = AlgebraicGeometry.Spec.map ι_inf ≫ e_W.hom →
        ϕ_st.hom ≫ snd_st = AlgebraicGeometry.Spec.map ι_st →
        (e_WU.inv ≫ AlgebraicGeometry.Spec.map ι_Eloc ≫ ϕ_st.hom) ≫ snd_st =
          snd_inf ≫ (e_W.inv ≫ AlgebraicGeometry.Spec.map ι_E) := by
    intro PB_inf W_s PB_st C_E C_Eloc R_E R_Eloc snd_inf snd_st ι_inf ι_E ι_Eloc ι_st
      e_W e_WU ϕ_st hι_eq he_comm hϕ_st
    have he_inv :
        e_WU.inv ≫ AlgebraicGeometry.Spec.map ι_inf = snd_inf ≫ e_W.inv := by
      have hm1 : AlgebraicGeometry.Spec.map ι_inf = e_WU.hom ≫ snd_inf ≫ e_W.inv :=
        (Category.comp_id _).symm.trans
          ((congrArg (_ ≫ ·) e_W.hom_inv_id.symm).trans
            ((Category.assoc _ e_W.hom e_W.inv).symm.trans
              ((congrArg (· ≫ e_W.inv) he_comm.symm).trans
                (Category.assoc e_WU.hom snd_inf e_W.inv))))
      rw [hm1, ← Category.assoc e_WU.inv e_WU.hom, e_WU.inv_hom_id, Category.id_comp]
    calc (e_WU.inv ≫ AlgebraicGeometry.Spec.map ι_Eloc ≫ ϕ_st.hom) ≫ snd_st
        = e_WU.inv ≫ AlgebraicGeometry.Spec.map ι_Eloc ≫ (ϕ_st.hom ≫ snd_st) := by
            simp only [Category.assoc]
      _ = e_WU.inv ≫ (AlgebraicGeometry.Spec.map ι_Eloc ≫ AlgebraicGeometry.Spec.map ι_st) := by
            rw [hϕ_st]
      _ = e_WU.inv ≫ AlgebraicGeometry.Spec.map (ι_st ≫ ι_Eloc) := by
            rw [← AlgebraicGeometry.Spec.map_comp]
      _ = e_WU.inv ≫ AlgebraicGeometry.Spec.map (ι_E ≫ ι_inf) := by
            rw [← hι_eq]
      _ = (e_WU.inv ≫ AlgebraicGeometry.Spec.map ι_inf) ≫ AlgebraicGeometry.Spec.map ι_E := by
            rw [AlgebraicGeometry.Spec.map_comp, Category.assoc]
      _ = snd_inf ≫ (e_W.inv ≫ AlgebraicGeometry.Spec.map ι_E) := by
            rw [he_inv, Category.assoc]

  have hRecoverAbstract :
      ∀ {PB_inf S_inf S_j PB_j : AlgebraicGeometry.Scheme.{u}} (b : ℕ)
        (e_WU : S_inf ≅ PB_inf) (m_ι : S_inf ⟶ S_j) (ϕ_j : S_j ≅ PB_j)
        (ξ_inf : weilEtaleTorsionH PB_inf ℓ b)
        (ξ'_inf : weilEtaleTorsionH S_inf ℓ b)
        (ξ'_j : weilEtaleTorsionH S_j ℓ b)
        (ξ_j : weilEtaleTorsionH PB_j ℓ b)
        (p_eWU : weilEtaleTorsionH PB_inf ℓ b →+ weilEtaleTorsionH S_inf ℓ b)
        (p_ϕ_inv : weilEtaleTorsionH S_j ℓ b →+ weilEtaleTorsionH PB_j ℓ b),
        WeilIsTorsionEtalePullback e_WU.hom ℓ b p_eWU →
        p_eWU ξ_inf = ξ'_inf →
        WeilIsTorsionEtalePullback ϕ_j.inv ℓ b p_ϕ_inv →
        p_ϕ_inv ξ'_j = ξ_j →
        (∀ p_ι : weilEtaleTorsionH S_j ℓ b →+ weilEtaleTorsionH S_inf ℓ b,
          WeilIsTorsionEtalePullback m_ι ℓ b p_ι → p_ι ξ'_j = ξ'_inf) →
        ∀ (p_star : weilEtaleTorsionH PB_j ℓ b →+ weilEtaleTorsionH PB_inf ℓ b),
          WeilIsTorsionEtalePullback (e_WU.inv ≫ m_ι ≫ ϕ_j.hom) ℓ b p_star →
          p_star ξ_j = ξ_inf := by
    intro PB_inf S_inf S_j PB_j b e_WU m_ι ϕ_j ξ_inf ξ'_inf ξ'_j ξ_j
      p_eWU p_ϕ_inv hp_eWU hξ'_inf hp_ϕ_inv hξ_j hξ'_j p_star hp_star
    obtain ⟨p_eWU_inv, hp_eWU_inv⟩ := hPullEx e_WU.inv ℓ b
    obtain ⟨p_ιj, hp_ιj⟩ := hPullEx m_ι ℓ b
    obtain ⟨p_ϕj_hom, hp_ϕj_hom⟩ := hPullEx ϕ_j.hom ℓ b
    obtain ⟨p_mid, hp_mid⟩ := hPullEx (m_ι ≫ ϕ_j.hom) ℓ b
    have hp_mid_eq : p_mid = p_ιj.comp p_ϕj_hom :=
      hPullComp _ _ ℓ b p_ιj p_ϕj_hom p_mid hp_ιj hp_ϕj_hom hp_mid
    have hp_star_eq : p_star = p_eWU_inv.comp p_mid :=
      hPullComp e_WU.inv _ ℓ b p_eWU_inv p_mid p_star hp_eWU_inv hp_mid hp_star
    obtain ⟨p_id_ϕ, hp_id_ϕ⟩ := hPullEx (CategoryTheory.CategoryStruct.id S_j) ℓ b
    have hp_id_ϕ_eq : p_id_ϕ = AddMonoidHom.id _ := hPullId ℓ b p_id_ϕ hp_id_ϕ
    have hp_ϕ_comp : WeilIsTorsionEtalePullback (ϕ_j.hom ≫ ϕ_j.inv) ℓ b p_id_ϕ := by
      rwa [ϕ_j.hom_inv_id]
    have hϕ_inv_hom : p_ϕj_hom ξ_j = ξ'_j := by
      rw [← hξ_j]
      have hcomp := hPullComp ϕ_j.hom ϕ_j.inv ℓ b p_ϕj_hom p_ϕ_inv p_id_ϕ
        hp_ϕj_hom hp_ϕ_inv hp_ϕ_comp
      have h1 := congrArg (fun f => f ξ'_j) hcomp
      rw [hp_id_ϕ_eq] at h1
      exact h1.symm
    obtain ⟨p_id_WU, hp_id_WU⟩ := hPullEx (CategoryTheory.CategoryStruct.id PB_inf) ℓ b
    have hp_id_WU_eq : p_id_WU = AddMonoidHom.id _ := hPullId ℓ b p_id_WU hp_id_WU
    have hp_WU_comp : WeilIsTorsionEtalePullback (e_WU.inv ≫ e_WU.hom) ℓ b p_id_WU := by
      rwa [e_WU.inv_hom_id]
    have heWU_inv_hom : p_eWU_inv ξ'_inf = ξ_inf := by
      rw [← hξ'_inf]
      have hcomp := hPullComp e_WU.inv e_WU.hom ℓ b p_eWU_inv p_eWU p_id_WU
        hp_eWU_inv hp_eWU hp_WU_comp
      have h1 := congrArg (fun f => f ξ_inf) hcomp
      rw [hp_id_WU_eq] at h1
      exact h1.symm
    rw [hp_star_eq, hp_mid_eq]
    change p_eWU_inv (p_ιj (p_ϕj_hom ξ_j)) = ξ_inf
    rw [hϕ_inv_hom, hξ'_j p_ιj hp_ιj, heWU_inv_hom]

  have hKummerRecoverAbstract :
      ∀ {PB_inf PB_j PB_1 : AlgebraicGeometry.Scheme.{u}}
        {R_j R_1 C_Eloc : CommRingCat.{u}}
        (e_inv : PB_inf ⟶ AlgebraicGeometry.Spec C_Eloc)
        (m_θ : R_j ⟶ R_1) (ι_j : R_j ⟶ C_Eloc) (ι_1 : R_1 ⟶ C_Eloc)
        (heq_ι : m_θ ≫ ι_1 = ι_j)
        (ϕ_j : AlgebraicGeometry.Spec R_j ≅ PB_j)
        (ϕ₁ : AlgebraicGeometry.Spec R_1 ≅ PB_1)
        (ξ_inf : weilEtaleTorsionH PB_inf ℓ 1)
        (ξ_j : weilEtaleTorsionH PB_j ℓ 1)
        (p_WU : weilEtaleTorsionH PB_j ℓ 1 →+ weilEtaleTorsionH PB_1 ℓ 1),
        WeilIsTorsionEtalePullback
          (ϕ₁.inv ≫ AlgebraicGeometry.Spec.map m_θ ≫ ϕ_j.hom) ℓ 1 p_WU →
        (∀ p_star : weilEtaleTorsionH PB_j ℓ 1 →+ weilEtaleTorsionH PB_inf ℓ 1,
          WeilIsTorsionEtalePullback
            (e_inv ≫ AlgebraicGeometry.Spec.map ι_j ≫ ϕ_j.hom) ℓ 1 p_star →
          p_star ξ_j = ξ_inf) →
        ∀ p_star₁ : weilEtaleTorsionH PB_1 ℓ 1 →+ weilEtaleTorsionH PB_inf ℓ 1,
          WeilIsTorsionEtalePullback
            (e_inv ≫ AlgebraicGeometry.Spec.map ι_1 ≫ ϕ₁.hom) ℓ 1 p_star₁ →
          p_star₁ (p_WU ξ_j) = ξ_inf := by
    intro PB_inf PB_j PB_1 R_j R_1 C_Eloc e_inv m_θ ι_j ι_1 heq_ι
      ϕ_j ϕ₁ ξ_inf ξ_j p_WU hp_WU hRec p_star₁ hp_star₁
    let π_WU := ϕ₁.inv ≫ AlgebraicGeometry.Spec.map m_θ ≫ ϕ_j.hom
    let f₁ := e_inv ≫ AlgebraicGeometry.Spec.map ι_1 ≫ ϕ₁.hom
    have hMor_eq : f₁ ≫ π_WU = e_inv ≫ AlgebraicGeometry.Spec.map ι_j ≫ ϕ_j.hom := by
      dsimp [f₁, π_WU]
      calc (e_inv ≫ AlgebraicGeometry.Spec.map ι_1 ≫ ϕ₁.hom) ≫
            (ϕ₁.inv ≫ AlgebraicGeometry.Spec.map m_θ ≫ ϕ_j.hom)
          = e_inv ≫ AlgebraicGeometry.Spec.map ι_1 ≫ (ϕ₁.hom ≫ ϕ₁.inv) ≫
              AlgebraicGeometry.Spec.map m_θ ≫ ϕ_j.hom := by
              simp only [Category.assoc]
        _ = e_inv ≫ (AlgebraicGeometry.Spec.map ι_1 ≫ AlgebraicGeometry.Spec.map m_θ) ≫
              ϕ_j.hom := by
              rw [ϕ₁.hom_inv_id, Category.id_comp, Category.assoc]
        _ = e_inv ≫ AlgebraicGeometry.Spec.map (m_θ ≫ ι_1) ≫ ϕ_j.hom := by
              rw [← AlgebraicGeometry.Spec.map_comp]
        _ = e_inv ≫ AlgebraicGeometry.Spec.map ι_j ≫ ϕ_j.hom := by
              rw [heq_ι]
    obtain ⟨p_tot, hp_tot⟩ := hPullEx (f₁ ≫ π_WU) ℓ 1
    have hp_tot_eq : p_tot = p_star₁.comp p_WU :=
      hPullComp f₁ π_WU ℓ 1 p_star₁ p_WU p_tot hp_star₁ hp_WU hp_tot
    have hp_tot_j : WeilIsTorsionEtalePullback
        (e_inv ≫ AlgebraicGeometry.Spec.map ι_j ≫ ϕ_j.hom) ℓ 1 p_tot := by
      rwa [← hMor_eq]
    change (p_star₁.comp p_WU) ξ_j = ξ_inf
    rw [← hp_tot_eq]
    exact hRec p_tot hp_tot_j

  
