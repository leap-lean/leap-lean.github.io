        { unit :=
            { app := fun F => { hom := adj_pre.unit.app F.obj }
              naturality := fun {_ _} α => Sheaf.hom_ext (adj_pre.unit.naturality α.hom) }
          counit :=
            { app := fun H => { hom := adj_pre.counit.app H.obj }
              naturality := fun {_ _} β => Sheaf.hom_ext (adj_pre.counit.naturality β.hom) }
          left_triangle := NatTrans.ext (funext fun F =>
            Sheaf.hom_ext (congrArg (fun η => η.app F.obj) adj_pre.left_triangle))
          right_triangle := NatTrans.ext (funext fun H =>
            Sheaf.hom_ext (congrArg (fun η => η.app H.obj) adj_pre.right_triangle)) }⟩
    let locConstPresheaf : ∀ (V : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u}),
        Functor (Opposite V.Etale) AddCommGrpCat.{u} :=
      fun V A =>
        { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥E.unop.left ↥A)
          map := fun m => AddCommGrpCat.ofHom
            (LocallyConstant.comapAddMonoidHom (Z := ↥A) m.unop.left.base.hom)
          map_id := fun _ => AddCommGrpCat.ext fun _ => by ext; rfl
          map_comp := fun _ _ => AddCommGrpCat.ext fun _ => by ext; rfl }
    have hLocConstModel : ∀ (V : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u}),
        ∃ (hSheaf : Presheaf.IsSheaf V.smallEtaleTopology (locConstPresheaf V A))
          (Υ : (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A ≅
            ⟨locConstPresheaf V A, hSheaf⟩),
          (∀ (a : ↥A),
            let T_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
            (Υ.hom.hom.app (Opposite.op T_V)).hom
              (((CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u}
                (hTerm V)).unit.app A).hom a) =
              LocallyConstant.const ↥T_V.left a) ∧
          (∀ [Nonempty ↥V] [PreconnectedSpace ↥V],
            IsIso ((CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u}
              (hTerm V)).unit.app A) ∧
            IsIso ((CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u}
              (hTerm V)).counit.app
              ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A))) := by
      intro V A
      let P_A := locConstPresheaf V A
      let θ_A : (Functor.const (Opposite V.Etale)).obj A ⟶ P_A :=
        { app := fun E =>
            AddCommGrpCat.ofHom (LocallyConstant.constAddMonoidHom (X := ↥E.unop.left) (Y := ↥A))
          naturality := fun _ _ _ => AddCommGrpCat.ext fun _ => by ext; rfl }
      have hSheaf : Presheaf.IsSheaf V.smallEtaleTopology P_A := by
        clear * - hEtComp hEtPb hEtBC hMemEt hMorEt V A P_A
        rw [Presheaf.isSheaf_iff_isLimit]
        intro E S₀ hS₀
        have hcov := (hMemEt E S₀).mp hS₀
        let eval_c : ∀ (c : Limits.Cone (S₀.arrows.diagram.op ⋙ P_A))
            (w : S₀.arrows.category) (_ : ↥c.pt), LocallyConstant ↥w.obj.left.left ↥A :=
          fun c w m => (c.π.app (Opposite.op w)).hom m
        have h_ov : ∀ (c : Limits.Cone (S₀.arrows.diagram.op ⋙ P_A))
            (w₁ w₂ : S₀.arrows.category) (m : ↥c.pt)
            (z₁ : ↥w₁.obj.left.left) (z₂ : ↥w₂.obj.left.left),
            w₁.obj.hom.left.base z₁ = w₂.obj.hom.left.base z₂ →
            eval_c c w₁ m z₁ = eval_c c w₂ m z₂ := by
          intro c w₁ w₂ m z₁ z₂ hz_eq
          let u₁ : w₁.obj.left ⟶ E := w₁.obj.hom
          let u₂ : w₂.obj.left ⟶ E := w₂.obj.hom
          have hu₂_et : AlgebraicGeometry.Etale u₂.left := hMorEt u₂
          let Z_sch := Limits.pullback u₁.left u₂.left
          let p₁ : Z_sch ⟶ w₁.obj.left.left := Limits.pullback.fst u₁.left u₂.left
          let p₂ : Z_sch ⟶ w₂.obj.left.left := Limits.pullback.snd u₁.left u₂.left
          have hp₁_et : AlgebraicGeometry.Etale p₁ :=
            MorphismProperty.IsStableUnderBaseChange.of_isPullback
              (IsPullback.of_hasPullback u₁.left u₂.left).flip hu₂_et
          have hZ_et : AlgebraicGeometry.Etale (p₁ ≫ w₁.obj.left.hom) :=
            MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) p₁ w₁.obj.left.hom hp₁_et
              w₁.obj.left.prop
          let Z_et : V.Etale := MorphismProperty.Over.mk ⊤ (p₁ ≫ w₁.obj.left.hom) hZ_et
          let q₁ : Z_et ⟶ w₁.obj.left := MorphismProperty.Over.homMk p₁ rfl trivial
          have hq₂_w : p₂ ≫ w₂.obj.left.hom = Z_et.hom :=
            (congrArg (p₂ ≫ ·) (MorphismProperty.Over.w u₂).symm).trans
              ((Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ E.hom) Limits.pullback.condition.symm).trans
                  ((Category.assoc _ _ _).trans (congrArg (p₁ ≫ ·) (MorphismProperty.Over.w u₁)))))
          let q₂ : Z_et ⟶ w₂.obj.left := MorphismProperty.Over.homMk p₂ hq₂_w trivial
          have hq_comm : q₁ ≫ u₁ = q₂ ≫ u₂ := by
            apply (AlgebraicGeometry.Scheme.Etale.forget V).map_injective
            apply CategoryTheory.Over.OverMorphism.ext
            exact Limits.pullback.condition
          let w₁₂ : S₀.arrows.category :=
            ⟨CategoryTheory.Over.mk (q₁ ≫ u₁), S₀.downward_closed w₁.property q₁⟩
          let mor₁ : w₁₂ ⟶ w₁ := ObjectProperty.homMk (CategoryTheory.Over.homMk q₁ rfl)
          let mor₂ : w₁₂ ⟶ w₂ := ObjectProperty.homMk (CategoryTheory.Over.homMk q₂ hq_comm.symm)
          obtain ⟨z, hz₁, hz₂⟩ := Scheme.Pullback.exists_preimage_pullback z₁ z₂ hz_eq
          have hev₁ : eval_c c w₁ m (p₁.base z) = eval_c c w₁₂ m z :=
            congrArg (fun φ => (φ.hom m : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₁.op)
