        u_V ≫ CategoryTheory.Limits.pullback.fst h₂ π =
          CategoryTheory.Limits.pullback.fst h₁ π ≫ (FgtU.map u).left →
        u_V ≫ CategoryTheory.Limits.pullback.snd h₂ π =
          CategoryTheory.Limits.pullback.snd h₁ π →
        ∀ (s : ↑(ℰ.obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_V),
          triv W₁ ((ℰ.obj.map (Opposite.op u)) s) y₁ = triv W₂ s (u_V.base y₁) := by
    intro W₁ W₂ u h₁ h₂ W₁_V W₂_V u_V hfst hsnd s y₁
    have hu_eq : u_V = u_can u := hu_can_eq u u_V hfst hsnd
    rw [hu_eq]
    rfl

