      change (k₀.comp (Abelian.Ext.mk₀ SC_M.g) (Nat.add_zero 0)).comp hSE_M.extClass rfl = 0
      rw [Abelian.Ext.comp_assoc_of_second_deg_zero k₀ (Abelian.Ext.mk₀ SC_M.g) hSE_M.extClass rfl,
        ShortComplex.ShortExact.comp_extClass hSE_M, Abelian.Ext.comp_zero]
    refine ⟨hInj_1, ?_, ?_⟩
    · intro hSE_push
      have _ : Epi (P_push.map v) := hSE_push.epi_g
      have _ : Epi (p_M ≫ α_Q) := by rw [hpα]; infer_instance
      have _ : Epi α_Q := epi_of_epi p_M α_Q
      have _ : IsIso α_Q := isIso_of_mono_of_epi α_Q
      have hBij_WQ0 : Function.Bijective (θ W Q α_Q 0) := (hDeg0 W Q α_Q).2 inferInstance
      have hSurj_1 : Function.Surjective (θ G F α 1) := by
        intro y_Ω
        obtain ⟨q₀, rfl⟩ := hδΩ_surj 0 y_Ω
        obtain ⟨w₀, rfl⟩ := hBij_WQ0.2 q₀
        exact ⟨w₀.comp hSE_M.extClass rfl, hConnCompat 0 w₀⟩
      refine ⟨⟨hInj_1, hSurj_1⟩, fun s hs => ?_⟩
      let post_αQ : Abelian.Ext Z_M W s ≃+ Abelian.Ext Z_M (P_push.obj Q) s :=
        { toFun := (Abelian.Ext.mk₀ α_Q).postcomp Z_M (Nat.add_zero s)
          invFun := (Abelian.Ext.mk₀ (inv α_Q)).postcomp Z_M (Nat.add_zero s)
          left_inv := fun w => by
            change (w.comp (Abelian.Ext.mk₀ α_Q) (Nat.add_zero s)).comp
              (Abelian.Ext.mk₀ (inv α_Q)) (Nat.add_zero s) = w
            rw [Abelian.Ext.comp_assoc_of_third_deg_zero w _ _ (Nat.add_zero s),
