                mapMono (⟨j.1 + 1 + t.1, by omega⟩ : Fin (N + 2)).succAbove
                  (Fin.strictMono_succAbove _)
                  (mapMono (ρ_ins j) (hρ_ins_sm j) u) := by
              symm
              apply hmap_comp_eq
              intro x
              simp only [μ_mid, ρ_ins, hval_succAbove]
              split_ifs <;> omega
            have hv_eq :
                mapMono (τ_til j) (hτ_til_sm j)
                  (mapMono ((t.castSucc).succ).succAbove (Fin.strictMono_succAbove _) v) =
                mapMono (⟨j.1 + 1 + t.1, by omega⟩ : Fin (N + 2)).succAbove
                  (Fin.strictMono_succAbove _)
                  (mapMono (τ_win j) (hτ_win_sm j) v) := by
              rw [hmap_comp_eq _ _
                ((⟨j.1 + 1 + t.1, by omega⟩ : Fin (N + 2)).succAbove ∘ τ_win j)
                _ _ ((Fin.strictMono_succAbove _).comp (hτ_win_sm j)), hmap_comp]
              intro l
              simp only [Function.comp_apply, τ_til, τ_win, hval_succAbove,
                Fin.val_succ, Fin.val_castSucc]
              split_ifs <;> omega
            rw [hu_eq, hv_eq]
          rw [hr0, hrlast, hrmid]
          abel
        calc
          (∑ j : Fin p,
            ((-1 : ℤ) ^ j.1) •
              mul (N + 1)
                (mapMono (μ_mid j) (hμ_mid_sm j) u)
                (mapMono (τ_til j) (hτ_til_sm j) (diffC p v))) =
            ∑ j : Fin p,
              (((-1 : ℤ) ^ j.1) •
                mul (N + 1)
                  (mapMono (μ_mid j) (hμ_mid_sm j) u)
                  (mapMono (τ_hat j.succ) (hτ_hat_sm j.succ) v) +
              (∑ t : Fin p, d_term j ⟨j.1 + 1 + t.1, by omega⟩) +
              ((-1 : ℤ) ^ j.1) •
                mul (N + 1)
                  (mapMono (μ_mid j) (hμ_mid_sm j) u)
                  (mapMono (τ_hat j.castSucc) (hτ_hat_sm j.castSucc) v)) :=
            Finset.sum_congr rfl fun j _ => hinner j
          _ = _ := by
            simp only [Finset.sum_add_distrib]
      have hcomb_d :
          (∑ j : Fin p, ∑ t : Fin (j.1 + 1), d_term j ⟨t.1, by omega⟩) +
          (∑ j : Fin p, ∑ t : Fin p, d_term j ⟨j.1 + 1 + t.1, by omega⟩) +
          (∑ j : Fin p, ∑ t : Fin (p - j.1), d_term j ⟨j.1 + 1 + p + t.1, by omega⟩) =
          diffC N S_hom := by
        rw [hdiff_S, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun j _ => ?_
        have hj : j.1 < p := j.2
        symm
        rw [hsum_fin_eq_split (d_term j) (j.1 + 1 + p) (p - j.1) (by omega),
          hsum_fin_eq_split _ (j.1 + 1) p (by omega)]
      have hcanc1 :
          (∑ j : Fin p,
            ((-1 : ℤ) ^ (j.1 + 1)) •
              mul (N + 1)
                (mapMono (μ_mid j) (hμ_mid_sm j) u)
                (mapMono (τ_hat j.succ) (hτ_hat_sm j.succ) v)) +
          (∑ j : Fin p,
            ((-1 : ℤ) ^ j.1) •
              mul (N + 1)
                (mapMono (μ_mid j) (hμ_mid_sm j) u)
                (mapMono (τ_hat j.succ) (hτ_hat_sm j.succ) v)) = 0 := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [pow_succ, mul_neg, mul_one, neg_zsmul]
        exact neg_add_cancel _
      have hcanc2 :
          (∑ j : Fin p,
            ((-1 : ℤ) ^ (j.1 + 1)) •
              mul (N + 1)
                (mapMono (μ_mid j) (hμ_mid_sm j) u)
                (mapMono (τ_hat j.castSucc) (hτ_hat_sm j.castSucc) v)) +
          (∑ j : Fin p,
            ((-1 : ℤ) ^ j.1) •
              mul (N + 1)
                (mapMono (μ_mid j) (hμ_mid_sm j) u)
                (mapMono (τ_hat j.castSucc) (hτ_hat_sm j.castSucc) v)) = 0 := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [pow_succ, mul_neg, mul_one, neg_zsmul]
        exact neg_add_cancel _
      have htot : diffC N S_hom + (rightCupC p p u v + rightCupC p p v u) = 0 := by
        have hZ1' :
            (∑ j : Fin p, ∑ t : Fin (j.1 + 1), d_term j ⟨t.1, by omega⟩) +
            (rightCupC p p u v +
              ∑ j : Fin p,
                ((-1 : ℤ) ^ (j.1 + 1)) •
                  mul (N + 1)
                    (mapMono (μ_mid j) (hμ_mid_sm j) u)
                    (mapMono (τ_hat j.succ) (hτ_hat_sm j.succ) v)) +
            ((∑ j : Fin p,
              ((-1 : ℤ) ^ (j.1 + 1)) •
                mul (N + 1)
                  (mapMono (μ_mid j) (hμ_mid_sm j) u)
                  (mapMono (τ_hat j.castSucc) (hτ_hat_sm j.castSucc) v)) +
              rightCupC p p v u) +
            (∑ j : Fin p, ∑ t : Fin (p - j.1), d_term j ⟨j.1 + 1 + p + t.1, by omega⟩) = 0 := by
          rw [← hZ₁_low, ← hZ₁_mid0, ← hZ₁_mid1, ← hZ₁_high]
          have hsum4 :
              (∑ j' : Fin (p + 1), ∑ t : Fin j'.1, term₁ j' ⟨t.1, by omega⟩) +
              (∑ j' : Fin (p + 1), term₁ j' ⟨j'.1, by omega⟩) +
              (∑ j' : Fin (p + 1), term₁ j' ⟨j'.1 + 1, by omega⟩) +
              (∑ j' : Fin (p + 1), ∑ t : Fin (p - j'.1), term₁ j' ⟨j'.1 + 2 + t.1, by omega⟩) =
              ∑ j' : Fin (p + 1), ∑ k : Fin (p + 2), term₁ j' k := by
            simp only [← Finset.sum_add_distrib]
            exact Finset.sum_congr rfl fun j' _ => (hZ₁_split_inner j').symm
