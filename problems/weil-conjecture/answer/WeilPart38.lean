  · intro X S S' X' f g f' g' hgf _ _ _ _ _ _ _
    obtain ⟨hMor, hConn⟩ := weil_outer_bc_pcc_conn_and_mate_naturality.2 f g f' g' hgf
    exact ⟨fun F q => weil_outer_bc_pcc_push_existence f g f' g' hgf F q, hMor, hConn⟩

