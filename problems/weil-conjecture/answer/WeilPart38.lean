        let f_y : Z_y ⟶ E := γ_a ≫ ι_O
        have hf_et : AlgebraicGeometry.Etale f_y.left :=
          CategoryTheory.MorphismProperty.comp_mem etProp (u a) O_x.ι (hEt_u a) inferInstance
        have hf_pt : f_y.left.base y = x := by
          change O_x.ι.base ((u a).base y) = x
          rw [hy]; rfl
        refine ⟨Z_y, f_y, y, ?_, hf_et, hf_pt⟩
        change (Q.map (γ_a ≫ ι_O).op) s = 0
        rw [op_comp, Q.map_comp]
        change (Q.map γ_a.op) s_W = 0
        apply (Θ (B_j.obj Z_y)).injective
        rw [map_zero]
        let g_γ : B_j.obj Z_y ⟶ B_j.obj W₀ := B_j.map γ_a
        let g_γ_left : CategoryTheory.Limits.pullback w_Zy j ⟶
            CategoryTheory.Limits.pullback w j :=
          ((AlgebraicGeometry.Scheme.Etale.forget U).map g_γ).left
        obtain ⟨p_gγ, hp_gγ⟩ := hPullEx g_γ_left ℓ b
        have hnat := hΘ g_γ p_gγ hp_gγ s_W
        change Θ (B_j.obj Z_y) ((Q.map γ_a.op) s_W) = p_gγ ξ_sym at hnat
        rw [hnat]
        let fst_Z := CategoryTheory.Limits.pullback.fst w_Zy j
        let snd_Z := CategoryTheory.Limits.pullback.snd w_Zy j
        let pb_jw_x : CategoryTheory.Limits.pullback w_Zy j ⟶
            CategoryTheory.Limits.pullback j w :=
          CategoryTheory.Limits.pullback.lift snd_Z (fst_Z ≫ u a)
            ((CategoryTheory.Limits.pullback.condition (f := w_Zy) (g := j)).symm.trans
              (Category.assoc fst_Z (u a) w).symm)
        let μ_a : CategoryTheory.Limits.pullback w_Zy j ⟶
            CategoryTheory.Limits.pullback
              (CategoryTheory.Limits.pullback.snd j w) (u a) :=
          CategoryTheory.Limits.pullback.lift pb_jw_x fst_Z
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        let fst_ua := CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.snd j w) (u a)
        have hgγ_fst : g_γ_left ≫ CategoryTheory.Limits.pullback.fst w j = fst_Z ≫ u a :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hgγ_snd : g_γ_left ≫ CategoryTheory.Limits.pullback.snd w j = snd_Z :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hμ_comm : (μ_a ≫ fst_ua) ≫ sym_jw = g_γ_left := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · calc ((μ_a ≫ fst_ua) ≫ sym_jw) ≫ CategoryTheory.Limits.pullback.fst w j
                = μ_a ≫ fst_ua ≫ (sym_jw ≫ CategoryTheory.Limits.pullback.fst w j) := by
                    simp only [Category.assoc]
              _ = (μ_a ≫ fst_ua) ≫ CategoryTheory.Limits.pullback.snd j w := by
                    rw [CategoryTheory.Limits.pullbackSymmetry_hom_comp_fst, Category.assoc]
              _ = pb_jw_x ≫ CategoryTheory.Limits.pullback.snd j w := by
                    rw [CategoryTheory.Limits.pullback.lift_fst]
              _ = fst_Z ≫ u a := CategoryTheory.Limits.pullback.lift_snd _ _ _
              _ = g_γ_left ≫ CategoryTheory.Limits.pullback.fst w j := hgγ_fst.symm
          · calc ((μ_a ≫ fst_ua) ≫ sym_jw) ≫ CategoryTheory.Limits.pullback.snd w j
                = μ_a ≫ fst_ua ≫ (sym_jw ≫ CategoryTheory.Limits.pullback.snd w j) := by
                    simp only [Category.assoc]
              _ = (μ_a ≫ fst_ua) ≫ CategoryTheory.Limits.pullback.fst j w := by
                    rw [CategoryTheory.Limits.pullbackSymmetry_hom_comp_snd, Category.assoc]
              _ = pb_jw_x ≫ CategoryTheory.Limits.pullback.fst j w := by
                    rw [CategoryTheory.Limits.pullback.lift_fst]
              _ = snd_Z := CategoryTheory.Limits.pullback.lift_fst _ _ _
              _ = g_γ_left ≫ CategoryTheory.Limits.pullback.snd w j := hgγ_snd.symm
        obtain ⟨p_fst_ua, hp_fst_ua⟩ := hPullEx fst_ua ℓ b
        obtain ⟨p_μ, hp_μ⟩ := hPullEx μ_a ℓ b
        obtain ⟨p_μfst, hp_μfst⟩ := hPullEx (μ_a ≫ fst_ua) ℓ b
        have hp_μfst_eq : p_μfst = p_μ.comp p_fst_ua :=
          hPullComp μ_a fst_ua ℓ b p_μ p_fst_ua p_μfst hp_μ hp_fst_ua hp_μfst
        have hp_gγ' : WeilIsTorsionEtalePullback ((μ_a ≫ fst_ua) ≫ sym_jw) ℓ b p_gγ := by
          rwa [hμ_comm]
        have hp_gγ_eq : p_gγ = p_μfst.comp p_sym :=
          hPullComp (μ_a ≫ fst_ua) sym_jw ℓ b p_μfst p_sym p_gγ hp_μfst hp_sym hp_gγ'
        rw [hp_gγ_eq, hp_μfst_eq]
