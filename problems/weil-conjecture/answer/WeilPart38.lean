          ((CategoryTheory.constantSheaf U.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero 0)) →
      Function.Surjective ((φ.hom.app (Opposite.op T_U)).hom)) :=
by
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let upHom : ℤ →+ ULift.{u} ℤ :=
    { toFun := ULift.up
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let ev_Aℤ : ∀ (M : AddCommGrpCat.{u}), (Aℤ ⟶ M) ≃ ↑M := fun M =>
    { toFun := fun ψ => ψ.hom (ULift.up (1 : ℤ))
      invFun := fun m => AddCommGrpCat.ofHom
        { toFun := fun z => z.down • m
          map_zero' := zero_zsmul m
          map_add' := fun x y => add_zsmul m x.down y.down }
      left_inv := fun ψ => AddCommGrpCat.ext fun z => by
        change z.down • ψ.hom (ULift.up (1 : ℤ)) = ψ.hom z
        have h1 := map_zsmul (ψ.hom.comp upHom) z.down (1 : ℤ)
        simp only [AddMonoidHom.comp_apply, upHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk,
          smul_eq_mul, mul_one] at h1
        exact h1.symm
      right_inv := fun m => one_zsmul m }

  have hTermToPresheafBij : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (T : Z.Etale)
      (hT : CategoryTheory.Limits.IsTerminal T)
      (ℱ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      Function.Bijective (weilPolyP1CohomologyTermToPresheaf Z T hT ℱ q) := by
    intro Z T hT ℱ q
    let J := Z.smallEtaleTopology
    let Fℤ_Z := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
    let R_Z := weilPolyP1CohomologyRepSheaf Z T
    let adj_c := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
    let ρ_Z := weilPolyP1CohomologyRepToConst Z T hT
    let E_rep := fun G : CategoryTheory.Sheaf J AddCommGrpCat.{u} =>
      weilPolyP1CohomologyRepHomEquiv Z T G
    let E_const : ∀ G : CategoryTheory.Sheaf J AddCommGrpCat.{u},
        (Fℤ_Z ⟶ G) ≃ ↑(G.obj.obj (Opposite.op T)) := fun G =>
      (adj_c.homEquiv Aℤ G).trans (ev_Aℤ (G.obj.obj (Opposite.op T)))
    have hRepNat : ∀ {G₁ G₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (u : R_Z ⟶ G₁) (h : G₁ ⟶ G₂),
        E_rep G₂ (u ≫ h) = (h.hom.app (Opposite.op T)).hom (E_rep G₁ u) := by
      intro G₁ G₂ u h
      dsimp [E_rep, weilPolyP1CohomologyRepHomEquiv]
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
        CategoryTheory.Adjunction.homEquiv_naturality_right,
        CategoryTheory.yonedaEquiv_comp]
      rfl
    have hComp : ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (φ : Fℤ_Z ⟶ G),
        E_rep G (ρ_Z ≫ φ) = E_const G φ := by
      intro G φ
      rw [hRepNat ρ_Z φ]
      have hρ : E_rep Fℤ_Z ρ_Z = (adj_c.unit.app Aℤ).hom (ULift.up (1 : ℤ)) :=
        (E_rep Fℤ_Z).apply_symm_apply _
      rw [hρ]
      dsimp [E_const, ev_Aℤ]
      rw [CategoryTheory.Adjunction.homEquiv_unit]
      rfl
    let σ_Z : Fℤ_Z ⟶ R_Z := (E_const R_Z).symm (E_rep R_Z (𝟙 R_Z))
    have hρσ : ρ_Z ≫ σ_Z = 𝟙 R_Z := by
      apply (E_rep R_Z).injective
      rw [hComp R_Z σ_Z]
      exact (E_const R_Z).apply_symm_apply _
    have hσρ : σ_Z ≫ ρ_Z = 𝟙 Fℤ_Z := by
      apply (E_const Fℤ_Z).injective
      rw [← hComp Fℤ_Z (σ_Z ≫ ρ_Z), ← CategoryTheory.Category.assoc, hρσ,
        CategoryTheory.Category.id_comp, ← CategoryTheory.Category.comp_id ρ_Z,
        hComp Fℤ_Z (𝟙 Fℤ_Z)]
    let fwd := weilPolyP1CohomologyTermToPresheaf Z T hT ℱ q
    let bwd := (CategoryTheory.Abelian.Ext.mk₀ σ_Z).precomp ℱ (Nat.zero_add q)
    have hLeft : Function.LeftInverse bwd fwd := by
      intro x
      change (CategoryTheory.Abelian.Ext.mk₀ σ_Z).comp
        ((CategoryTheory.Abelian.Ext.mk₀ ρ_Z).comp x (Nat.zero_add q)) (Nat.zero_add q) = x
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, hσρ,
        CategoryTheory.Abelian.Ext.mk₀_id_comp]
    have hRight : Function.RightInverse bwd fwd := by
      intro y
      let y' : CategoryTheory.Abelian.Ext R_Z ℱ q := y
      change (CategoryTheory.Abelian.Ext.mk₀ ρ_Z).comp
        ((CategoryTheory.Abelian.Ext.mk₀ σ_Z).comp y' (Nat.zero_add q)) (Nat.zero_add q) = y'
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, hρσ,
        CategoryTheory.Abelian.Ext.mk₀_id_comp]
    exact ⟨hLeft.injective, hRight.surjective⟩

  have hSiteUnitBij : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
      {𝒟 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒟]
      (J_C : CategoryTheory.GrothendieckTopology 𝒞)
      (J_D : CategoryTheory.GrothendieckTopology 𝒟)
      [CategoryTheory.HasSheafify J_C AddCommGrpCat.{u}]
      [CategoryTheory.HasSheafify J_D AddCommGrpCat.{u}]
      [CategoryTheory.HasExt.{u} (CategoryTheory.Sheaf J_D AddCommGrpCat.{u})]
      (B : CategoryTheory.Functor 𝒞 𝒟) [B.IsContinuous J_C J_D]
      (W_C : Opposite 𝒞)
      (𝒢 : CategoryTheory.Sheaf J_D AddCommGrpCat.{u}),
      Function.Bijective
        ((((CategoryTheory.sheafificationAdjunction J_C AddCommGrpCat.{u}).unit.app
            (CategoryTheory.Functor.comp B.op
              (CategoryTheory.Sheaf.cohomologyPresheaf 𝒢 0))).app W_C).hom) := by
    clear * -
    intro 𝒞 _ 𝒟 _ J_C J_D _ _ _ B _ W_C 𝒢
    let Sh_D := CategoryTheory.presheafToSheaf J_D AddCommGrpCat.{u}
    let U_D := CategoryTheory.sheafToPresheaf J_D AddCommGrpCat.{u}
    let Sh_C := CategoryTheory.presheafToSheaf J_C AddCommGrpCat.{u}
    let U_C := CategoryTheory.sheafToPresheaf J_C AddCommGrpCat.{u}
    let adj_sh_D := CategoryTheory.sheafificationAdjunction J_D AddCommGrpCat.{u}
    let adj_sh_C := CategoryTheory.sheafificationAdjunction J_C AddCommGrpCat.{u}
    let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite 𝒟)
      (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
    let Fgt_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite 𝒟)
      AddCommGrpCat.{u} (Type u)).obj (CategoryTheory.forget AddCommGrpCat.{u})
    let adj_free := CategoryTheory.Adjunction.whiskerRight (Opposite 𝒟) AddCommGrpCat.adj
    let L_tot := Free_PSh ⋙ Sh_D
    let R_tot := U_D ⋙ Fgt_PSh
    let adj_tot : L_tot ⊣ R_tot := adj_free.comp adj_sh_D
    let Z_fun : 𝒟 ⥤ CategoryTheory.Sheaf J_D AddCommGrpCat.{u} :=
      CategoryTheory.yoneda ⋙ L_tot
    let Z_obj : Opposite 𝒟 → CategoryTheory.Sheaf J_D AddCommGrpCat.{u} :=
      fun W => Opposite.unop (Z_fun.op.obj W)
    let e_raw : ∀ (W : Opposite 𝒟),
        CategoryTheory.Abelian.Ext (Z_obj W) 𝒢 0 ≃ ↑((U_D.obj 𝒢).obj W) := fun W =>
      CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans
        ((adj_tot.homEquiv (CategoryTheory.yoneda.obj (Opposite.unop W)) 𝒢).trans
          CategoryTheory.yonedaEquiv)
    have he_raw_eval : ∀ (W : Opposite 𝒟) (u : Z_obj W ⟶ 𝒢),
        CategoryTheory.yonedaEquiv
          (adj_tot.homEquiv (CategoryTheory.yoneda.obj (Opposite.unop W)) 𝒢 u) =
          (u.hom.app W).hom
            (CategoryTheory.yonedaEquiv
              (adj_tot.unit.app (CategoryTheory.yoneda.obj (Opposite.unop W)))) := by
      intro W u
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.yonedaEquiv_comp]
      rfl
    let e_add : ∀ (W : Opposite 𝒟),
        ↑((𝒢.cohomologyPresheaf 0).obj W) ≃+ ↑((U_D.obj 𝒢).obj W) := fun W =>
      AddEquiv.mk' (e_raw W) fun α₁ α₂ => by
        let α₁' : CategoryTheory.Abelian.Ext (Z_obj W) 𝒢 0 := α₁
        let α₂' : CategoryTheory.Abelian.Ext (Z_obj W) 𝒢 0 := α₂
        change e_raw W (α₁' + α₂') = e_raw W α₁' + e_raw W α₂'
        dsimp [e_raw]
        rw [map_add, he_raw_eval W, he_raw_eval W, he_raw_eval W]
        have hhom : (CategoryTheory.Abelian.Ext.addEquiv₀ α₁' +
            CategoryTheory.Abelian.Ext.addEquiv₀ α₂').hom =
            (CategoryTheory.Abelian.Ext.addEquiv₀ α₁').hom +
              (CategoryTheory.Abelian.Ext.addEquiv₀ α₂').hom :=
          U_D.map_add
        rw [hhom]
        rfl
    let θ_𝒢 : 𝒢.cohomologyPresheaf 0 ≅ U_D.obj 𝒢 :=
      CategoryTheory.NatIso.ofComponents
        (fun W =>
          { hom := AddCommGrpCat.ofHom (e_add W).toAddMonoidHom
            inv := AddCommGrpCat.ofHom (e_add W).symm.toAddMonoidHom
            hom_inv_id := AddCommGrpCat.ext fun x => (e_add W).symm_apply_apply x
            inv_hom_id := AddCommGrpCat.ext fun y => (e_add W).apply_symm_apply y })
        (fun {W₁ W₂} ω => by
          have hmap : (𝒢.cohomologyPresheaf 0).map ω =
              ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app 𝒢 := rfl
          rw [hmap, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) 𝒢]
          apply AddCommGrpCat.ext
          intro α
          let u : Z_obj W₁ ⟶ 𝒢 := CategoryTheory.Abelian.Ext.addEquiv₀ α
          have hα : α = CategoryTheory.Abelian.Ext.mk₀ u :=
            (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
          change e_raw W₂
              ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp α (Nat.zero_add 0)) =
            ((U_D.obj 𝒢).map ω).hom (e_raw W₁ α)
          rw [hα, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
          dsimp [e_raw]
          rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
            ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
            AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
          have hZ : Z_fun.map ω.unop = L_tot.map (CategoryTheory.yoneda.map ω.unop) := rfl
          rw [hZ, CategoryTheory.Adjunction.homEquiv_naturality_left,
            ← CategoryTheory.yonedaEquiv_naturality']
          rfl)
    let pf_B := B.sheafPushforwardContinuous AddCommGrpCat.{u} J_C J_D
    let W_B := (CategoryTheory.Functor.whiskeringLeft (Opposite 𝒞) (Opposite 𝒟)
      AddCommGrpCat.{u}).obj B.op
    let P₀ := CategoryTheory.Functor.comp B.op (CategoryTheory.Sheaf.cohomologyPresheaf 𝒢 0)
    let ℋ := pf_B.obj 𝒢
    let Φ₀ : P₀ ≅ U_C.obj ℋ := W_B.mapIso θ_𝒢
    let ε_ℋ : Sh_C.obj (U_C.obj ℋ) ≅ ℋ :=
      CategoryTheory.asIso (adj_sh_C.counit.app ℋ)
    have htri : adj_sh_C.unit.app (U_C.obj ℋ) ≫ (U_C.mapIso ε_ℋ).hom = 𝟙 (U_C.obj ℋ) :=
      adj_sh_C.right_triangle_components ℋ
    have hUnitH : adj_sh_C.unit.app (U_C.obj ℋ) = (U_C.mapIso ε_ℋ).inv :=
      (cancel_mono (U_C.mapIso ε_ℋ).hom).mp
        (htri.trans (U_C.mapIso ε_ℋ).inv_hom_id.symm)
    let Ψ₀ : U_C.obj (Sh_C.obj P₀) ≅ U_C.obj (Sh_C.obj (U_C.obj ℋ)) :=
      U_C.mapIso (Sh_C.mapIso Φ₀)
    let η_iso : P₀ ≅ U_C.obj (Sh_C.obj P₀) :=
      Φ₀ ≪≫ (U_C.mapIso ε_ℋ).symm ≪≫ Ψ₀.symm
    have hnat : Φ₀.hom ≫ adj_sh_C.unit.app (U_C.obj ℋ) = adj_sh_C.unit.app P₀ ≫ Ψ₀.hom :=
      adj_sh_C.unit.naturality Φ₀.hom
    have hUnitP : adj_sh_C.unit.app P₀ = η_iso.hom :=
      (cancel_mono Ψ₀.hom).mp <| by
        have h1 : adj_sh_C.unit.app P₀ ≫ Ψ₀.hom = Φ₀.hom ≫ (U_C.mapIso ε_ℋ).inv :=
          hnat.symm.trans (congrArg (Φ₀.hom ≫ ·) hUnitH)
        have h2 : η_iso.hom ≫ Ψ₀.hom = Φ₀.hom ≫ (U_C.mapIso ε_ℋ).inv := by
          change (Φ₀.hom ≫ (U_C.mapIso ε_ℋ).inv ≫ Ψ₀.inv) ≫ Ψ₀.hom = _
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            Ψ₀.inv_hom_id, CategoryTheory.Category.comp_id]
        exact h1.trans h2.symm
    let α_WC := η_iso.app W_C
    have hApp : (adj_sh_C.unit.app P₀).app W_C = α_WC.hom :=
      congrArg (fun τ : P₀ ⟶ U_C.obj (Sh_C.obj P₀) => τ.app W_C) hUnitP
    rw [hApp]
    have hL : Function.LeftInverse α_WC.inv.hom α_WC.hom.hom := fun x =>
      congrArg (fun φ : P₀.obj W_C ⟶ P₀.obj W_C => φ.hom x) α_WC.hom_inv_id
    have hR : Function.RightInverse α_WC.inv.hom α_WC.hom.hom := fun y =>
      congrArg (fun φ : (U_C.obj (Sh_C.obj P₀)).obj W_C ⟶
        (U_C.obj (Sh_C.obj P₀)).obj W_C => φ.hom y) α_WC.inv_hom_id
    exact ⟨hL.injective, hR.surjective⟩

  refine ⟨?_, ?_⟩
  · intro V U g _hCont T_U hT_V 𝒢
    have hBij₁ : Function.Bijective
        (weilPolyP1CohomologyTermToPresheaf V ((weilEtaleSitePullback g).obj T_U) hT_V 𝒢 0) :=
      hTermToPresheafBij V ((weilEtaleSitePullback g).obj T_U) hT_V 𝒢 0
    have hBij₂ : Function.Bijective
        ((((CategoryTheory.sheafificationAdjunction U.smallEtaleTopology AddCommGrpCat.{u}).unit.app
            (CategoryTheory.Functor.comp (weilEtaleSitePullback g).op
              (CategoryTheory.Sheaf.cohomologyPresheaf 𝒢 0))).app (Opposite.op T_U)).hom) :=
      hSiteUnitBij U.smallEtaleTopology V.smallEtaleTopology (weilEtaleSitePullback g)
        (Opposite.op T_U) 𝒢
    exact hBij₂.comp hBij₁
  · intro U T_U _hT_U 𝒢₁ 𝒢₂ φ hSurj y
    let J_U := U.smallEtaleTopology
    let Fℤ_U := (CategoryTheory.constantSheaf J_U AddCommGrpCat.{u}).obj Aℤ
    let adj_cU := CategoryTheory.constantSheafAdj J_U AddCommGrpCat.{u} _hT_U
    let e_sec : ∀ (𝒢 : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}),
        𝒢.H 0 ≃ ↑(𝒢.obj.obj (Opposite.op T_U)) := fun 𝒢 =>
      CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans
        ((adj_cU.homEquiv Aℤ 𝒢).trans (ev_Aℤ (𝒢.obj.obj (Opposite.op T_U))))
    obtain ⟨α₁, hα₁⟩ := hSurj ((e_sec 𝒢₂).symm y)
    refine ⟨e_sec 𝒢₁ α₁, ?_⟩
    have hNat : e_sec 𝒢₂
        (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_U (Nat.add_zero 0)) α₁) =
        (φ.hom.app (Opposite.op T_U)).hom (e_sec 𝒢₁ α₁) := by
      let f_α : Fℤ_U ⟶ 𝒢₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
      have hα₁_eq : α₁ = CategoryTheory.Abelian.Ext.mk₀ f_α :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α₁).symm
      change e_sec 𝒢₂ (α₁.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)) =
        (φ.hom.app (Opposite.op T_U)).hom (e_sec 𝒢₁ α₁)
      rw [hα₁_eq, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      dsimp [e_sec, ev_Aℤ]
      rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
        ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
        AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply,
        CategoryTheory.Adjunction.homEquiv_naturality_right]
      rfl
    rw [← hNat, hα₁, (e_sec 𝒢₂).apply_symm_apply]

theorem weil_outer_tr_fib_higherDirectImage_ses_connecting_and_edge_comm {V U : AlgebraicGeometry.Scheme.{u}} (g : V ⟶ U)
    (T_U : U.Etale)
    (hT_V : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback g).obj T_U))
    (SC : CategoryTheory.ShortComplex
      (CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u}))
    (hSE : SC.ShortExact) [CategoryTheory.Injective SC.X₂] :
    ∃ (u₀ : weilEtaleHigherDirectImage g 0 SC.X₁ ⟶ weilEtaleHigherDirectImage g 0 SC.X₂)
      (v₀ : weilEtaleHigherDirectImage g 0 SC.X₂ ⟶ weilEtaleHigherDirectImage g 0 SC.X₃)
      (huv₀ : u₀ ≫ v₀ = 0)
      (δ : ∀ q : ℕ, weilEtaleHigherDirectImage g q SC.X₃ ⟶
        weilEtaleHigherDirectImage g (q + 1) SC.X₁)
      (hvδ₀ : v₀ ≫ δ 0 = 0),
      (CategoryTheory.Mono u₀ ∧ CategoryTheory.Epi (δ 0) ∧
        (CategoryTheory.ShortComplex.mk u₀ v₀ huv₀).Exact ∧
        (CategoryTheory.ShortComplex.mk v₀ (δ 0) hvδ₀).Exact) ∧
      (∀ q : ℕ, 1 ≤ q → CategoryTheory.IsIso (δ q)) ∧
      (∀ (m : ℕ) (s : SC.X₃.H m),
        (((δ m).hom.app (Opposite.op T_U)).hom)
          (weilOuterTrFibEdgeHom g T_U hT_V SC.X₃ m s) =
        weilOuterTrFibEdgeHom g T_U hT_V SC.X₁ (m + 1) (s.comp hSE.extClass rfl)) :=
by
  let J_V := V.smallEtaleTopology
  let J_U := U.smallEtaleTopology
  let B_g : CategoryTheory.Functor U.Etale V.Etale := weilEtaleSitePullback g
  let Sh_V := CategoryTheory.presheafToSheaf J_V AddCommGrpCat.{u}
  let Sh_U := CategoryTheory.presheafToSheaf J_U AddCommGrpCat.{u}
  let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite V.Etale)
    (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
  let Z_fun : CategoryTheory.Functor V.Etale (CategoryTheory.Sheaf J_V AddCommGrpCat.{u}) :=
    CategoryTheory.yoneda ⋙ (Free_PSh ⋙ Sh_V)
  let Z_obj : Opposite V.Etale → CategoryTheory.Sheaf J_V AddCommGrpCat.{u} :=
    fun W => Opposite.unop (Z_fun.op.obj W)
  let F_pre : ℕ → CategoryTheory.Functor
      (CategoryTheory.Sheaf J_V AddCommGrpCat.{u})
      (CategoryTheory.Functor (Opposite V.Etale) AddCommGrpCat.{u}) :=
    fun q => CategoryTheory.Sheaf.cohomologyPresheafFunctor J_V q
  let W_B := (CategoryTheory.Functor.whiskeringLeft (Opposite U.Etale) (Opposite V.Etale)
    AddCommGrpCat.{u}).obj B_g.op
  let E_U := W_B.comp Sh_U
  let scOfExact : ∀ {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}},
      K.Exact → CategoryTheory.ShortComplex AddCommGrpCat.{u} := fun {K} _ => K

  have hPresheafExact :
      ∀ (K : CategoryTheory.ShortComplex
          (CategoryTheory.Functor (Opposite V.Etale) AddCommGrpCat.{u})),
        (∀ W : Opposite V.Etale,
          (K.map ((CategoryTheory.evaluation (Opposite V.Etale) AddCommGrpCat.{u}).obj W)).Exact) →
        K.Exact := by
    intro K hW
    rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology,
      CategoryTheory.Functor.isZero_iff]
    intro W
    let evW := (CategoryTheory.evaluation (Opposite V.Etale) AddCommGrpCat.{u}).obj W
    have hZ : CategoryTheory.Limits.IsZero (K.map evW).leftHomology :=
      (CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology (K.map evW)).mp (hW W)
    exact CategoryTheory.Limits.IsZero.of_iso hZ (K.mapLeftHomologyIso evW).symm

  haveI : CategoryTheory.Mono SC.f := hSE.mono_f
  let u_pre := (F_pre 0).map SC.f
  let v_pre := (F_pre 0).map SC.g
  have hMono_u_app : ∀ W : Opposite V.Etale, CategoryTheory.Mono (u_pre.app W) := by
    intro W
    rw [AddCommGrpCat.mono_iff_injective]
    intro α₁ α₂ hα
    let g₁ : Z_obj W ⟶ SC.X₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
    let g₂ : Z_obj W ⟶ SC.X₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α₂
    have hα₁ : α₁ = CategoryTheory.Abelian.Ext.mk₀ g₁ :=
      (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α₁).symm
    have hα₂ : α₂ = CategoryTheory.Abelian.Ext.mk₀ g₂ :=
      (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α₂).symm
    have hmk : CategoryTheory.Abelian.Ext.mk₀ (g₁ ≫ SC.f) =
