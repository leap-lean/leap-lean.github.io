  induction n generalizing ℱ with
  | zero =>
    exact (hEdge0_bij g T_U hT_V ℱ).surjective
  | succ m ih =>
    let ℐ : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u} :=
      CategoryTheory.Injective.under ℱ
    let u_inj : ℱ ⟶ ℐ := CategoryTheory.Injective.ι ℱ
    let 𝒬 : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u} :=
      CategoryTheory.Limits.cokernel u_inj
    let v_cok : ℐ ⟶ 𝒬 := CategoryTheory.Limits.cokernel.π u_inj
    let SC := CategoryTheory.ShortComplex.mk u_inj v_cok
      (CategoryTheory.Limits.cokernel.condition u_inj)
