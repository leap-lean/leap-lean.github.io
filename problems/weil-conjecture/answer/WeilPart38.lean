        obtain ⟨hc_ga, hr_ga, hLim_ga, hAdd_ga, _⟩ := hSiteAdj g_a
        let _ := hc_ga; let _ := hr_ga; let _ := hLim_ga; let _ := hAdd_ga
        let P_ga := B_ga.sheafPullback AddCommGrpCat.{u}
