      have hsum_eq : (∑ b : Fin pb.dim, (M + b.1 - (σ b).1)) = D₁ * M := by
        have hcomp : (∑ b : Fin pb.dim, (σ b).1) = ∑ b : Fin pb.dim, b.1 :=
          Equiv.sum_comp σ (fun x : Fin pb.dim => x.1)
        have hadd : (∑ b : Fin pb.dim, (M + b.1 - (σ b).1)) + (∑ b : Fin pb.dim, b.1) =
            pb.dim * M + (∑ b : Fin pb.dim, b.1) := by
          calc (∑ b : Fin pb.dim, (M + b.1 - (σ b).1)) + (∑ b : Fin pb.dim, b.1)
