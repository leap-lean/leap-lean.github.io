theorem weil_sing_dev_locConst_proj_split_quadric_low_deg_specialization (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ) (hm : 1 ≤ m)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (M_max : Ideal ↥(integralClosure (Polynomial k)
      (AlgebraicClosure (FractionRing (Polynomial k)))))
    [M_max.IsMaximal]
    (hM : M_max.comap (algebraMap (Polynomial k)
      ↥(integralClosure (Polynomial k) (AlgebraicClosure (FractionRing (Polynomial k))))) =
      Ideal.span {Polynomial.X})
    (hDom : IsDomain (Localization.AtPrime M_max))
    [HenselianLocalRing (Localization.AtPrime M_max)]
    [IsAlgClosed (IsLocalRing.ResidueField (Localization.AtPrime M_max))]
    (j_Rbar : AlgebraicGeometry.Spec
      (CommRingCat.of (AlgebraicClosure (FractionRing (Polynomial k)))) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.AtPrime M_max)))
    [AlgebraicGeometry.IsOpenImmersion j_Rbar]
    (hj_eq : j_Rbar ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.AtPrime M_max))) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap (Polynomial k) (AlgebraicClosure (FractionRing (Polynomial k))))))
    (hj_range : Set.range j_Rbar.base =
      (PrimeSpectrum.basicOpen
        (algebraMap (Polynomial k) (Localization.AtPrime M_max) Polynomial.X)).1)
    (hClosed : (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.AtPrime M_max)))).base
        (IsLocalRing.closedPoint (Localization.AtPrime M_max)) =
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k)))).base (⊥ : PrimeSpectrum k)) :
    let P := Polynomial k
    let R_bar := Localization.AtPrime M_max
    let p_A1 : AlgebraicGeometry.Spec (CommRingCat.of P) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of P) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0))
    let g_Rbar : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of P) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P R_bar))
    let Q_aff_P := weilOdpModelSpec m (CommRingCat.of P) Polynomial.X
    let π_aff_P : Q_aff_P ⟶ AlgebraicGeometry.Spec (CommRingCat.of P) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))
    ∃ (Q_proj : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (π_Q : Q_proj ⟶ CategoryTheory.Over.mk p_A1)
      (ι_W : Q_aff_P ⟶ Q_proj.left)
      (o₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Q_aff_P),
      AlgebraicGeometry.IsProper π_Q.left ∧
      AlgebraicGeometry.Flat π_Q.left ∧
      AlgebraicGeometry.Flat π_aff_P ∧
      AlgebraicGeometry.IsOpenImmersion ι_W ∧
      ι_W ≫ π_Q.left = π_aff_P ∧
      o₀ ≫ π_aff_P = s₀ ∧
      (∀ idx : Fin (m + 1) × Fin 2,
        Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (o₀.base (⊥ : PrimeSpectrum k)).asIdeal) ∧
      Ideal.Quotient.mk _ (MvPolynomial.C Polynomial.X) ∈
        (o₀.base (⊥ : PrimeSpectrum k)).asIdeal ∧
      (∀ y : ↥Q_proj.left,
        y ≠ (o₀ ≫ ι_W).base (⊥ : PrimeSpectrum k) →
        ∃ (O : Q_proj.left.Opens)
          (e_O : O.toScheme ≅
            CategoryTheory.Limits.pullback (weilAffineSpaceOver k (2 * m + 1)).hom p_A1),
          y ∈ O ∧
          e_O.hom ≫ CategoryTheory.Limits.pullback.snd
            (weilAffineSpaceOver k (2 * m + 1)).hom p_A1 = O.ι ≫ π_Q.left) ∧
      (let Q_R := CategoryTheory.Limits.pullback π_Q.left g_Rbar
       let Q_Ω := CategoryTheory.Limits.pullback j_Rbar
         (CategoryTheory.Limits.pullback.snd π_Q.left g_Rbar)
       let j_Q : Q_Ω ⟶ Q_R :=
         CategoryTheory.Limits.pullback.snd j_Rbar
           (CategoryTheory.Limits.pullback.snd π_Q.left g_Rbar)
       Subsingleton (weilEtaleTorsionH Q_R ℓ 1) ∧
       ∀ (r : ℕ), r ≤ 2 * m + 1 →
         ∀ (ψ_r : weilEtaleTorsionH Q_R ℓ r →+ weilEtaleTorsionH Q_Ω ℓ r),
           WeilIsTorsionEtalePullback j_Q ℓ r ψ_r →
           Function.Bijective ψ_r) :=
by
  classical
  dsimp only
  have _ := hm
  have _ := hPBC
  have _ := hM
  have _ := hDom
  have _ := hj_eq
  have _ := hj_range
