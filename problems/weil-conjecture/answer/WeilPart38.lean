        change (ℱ.obj.map (M_w.map f₁_V).op ≫ ℱ.obj.map e_Z.op) (z g₁ hg₁) =
          (ℱ.obj.map (M_w.map f₂_V).op ≫ ℱ.obj.map e_Z.op) (z g₂ hg₂) at hmap
        rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp] at hmap
        have hm₁ : ℱ.obj.map ((M_w.map f₁_V).op ≫ e_Z.op) = ℱ.obj.map f₁.op :=
          congrArg (fun m => ℱ.obj.map m.op) he₁
        have hm₂ : ℱ.obj.map ((M_w.map f₂_V).op ≫ e_Z.op) = ℱ.obj.map f₂.op :=
          congrArg (fun m => ℱ.obj.map m.op) he₂
        rwa [hm₁, hm₂] at hmap
      have hCov : CoverPreserving V.smallEtaleTopology X.smallEtaleTopology M_w := by
        refine ⟨fun {Y₀} {R} hR => (hMemEt (M_w.obj Y₀) _).mpr fun z => ?_⟩
        obtain ⟨Y, u, y, huR, huEt, hy⟩ := (hMemEt Y₀ R).mp hR z
        exact ⟨M_w.obj Y, M_w.map u, y,
          ⟨Y, u, 𝟙 (M_w.obj Y), huR, (Category.id_comp _).symm⟩, huEt, hy⟩
      exact Functor.isContinuous_of_coverPreserving hCompat hCov
