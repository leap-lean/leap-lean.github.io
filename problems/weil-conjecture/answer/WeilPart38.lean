      exact ⟨hSh, { hom := α, inv := β, hom_inv_id := hαβ, inv_hom_id := hβα }, hα_const⟩
    obtain ⟨hSh_Y, Φ_Y, hΦ_Y⟩ := hLocConstIso Y T_Y hT_Y
    obtain ⟨hSh_YΩ, Φ_YΩ, hΦ_YΩ⟩ := hLocConstIso Y_Ω T_YΩ hT_YΩ
    let S_Y : Sheaf Y.smallEtaleTopology AddCommGrpCat.{u} := ⟨P_lc Y, hSh_Y⟩
    let S_YΩ : Sheaf Y_Ω.smallEtaleTopology AddCommGrpCat.{u} := ⟨P_lc Y_Ω, hSh_YΩ⟩
    let res_lc : S_Y ⟶ pf_jY.obj S_YΩ :=
      ObjectProperty.homMk
        { app := fun U => AddCommGrpCat.ofHom
            { toFun := fun f =>
                ⟨f ∘ (Limits.pullback.fst U.unop.hom j_Y).base,
                  f.isLocallyConstant.comp_continuous (Limits.pullback.fst U.unop.hom j_Y).continuous⟩
