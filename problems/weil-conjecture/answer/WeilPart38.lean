    let f'_ov : X'_ov ⟶ S'_ov := Over.homMk f_XR rfl
    let g'_ov : X'_ov ⟶ Z_bar := Over.homMk fst_XR (by
      change fst_XR ≫ Z_bar.hom = f_XR ≫ g_ch ≫ D_bar.hom
      rw [← f_bar.w, ← Category.assoc, Limits.pullback.condition, Category.assoc])
    intro r ℛ_r G_R hPb_GR T_R hT U_Ω
    have hPb_pbc : WeilIsEtaleSheafPullback g_ch ℛ_r
        (weilEtaleHigherDirectImage f_XR r (weilEtaleTorsionSheaf X_R ℓ)) :=
      hPBC Z_bar D_bar S'_ov X'_ov f_bar g_ov f'_ov g'_ov inferInstance
        (IsPullback.of_hasPullback f_bar.left g_ch)
        (weilEtaleTorsionSheaf Z_bar.left ℓ) (weilEtaleTorsionSheaf X_R ℓ)
        (hFM_tor Z_bar.left) (hPbConst fst_XR AM) r
    rcases hPb_GR with ⟨hc₁, hr₁, ⟨iso₁⟩⟩
    rcases hPb_pbc with ⟨hc₂, hr₂, ⟨iso₂⟩⟩
    have hhc : hc₁ = hc₂ := Subsingleton.elim _ _; subst hhc
    have hhr : hr₁ = hr₂ := Subsingleton.elim _ _; subst hhr
    let e_GR : weilEtaleHigherDirectImage f_XR r (weilEtaleTorsionSheaf X_R ℓ) ≅ G_R :=
      iso₂.symm ≪≫ iso₁
    let u_op := Opposite.op (hT.from U_Ω)
    have hnat_e : e_GR.hom.hom.app (Opposite.op T_R) ≫ G_R.obj.map u_op =
        (weilEtaleHigherDirectImage f_XR r (weilEtaleTorsionSheaf X_R ℓ)).obj.map u_op ≫
          e_GR.hom.hom.app (Opposite.op U_Ω) :=
      (e_GR.hom.hom.naturality u_op).symm
    have hid_TR : e_GR.inv.hom.app (Opposite.op T_R) ≫ e_GR.hom.hom.app (Opposite.op T_R) = 𝟙 _ :=
      congrArg (fun m => m.hom.app (Opposite.op T_R)) e_GR.inv_hom_id
    have hmap_eq : G_R.obj.map u_op =
        e_GR.inv.hom.app (Opposite.op T_R) ≫
          (weilEtaleHigherDirectImage f_XR r (weilEtaleTorsionSheaf X_R ℓ)).obj.map u_op ≫
          e_GR.hom.hom.app (Opposite.op U_Ω) :=
      (Category.id_comp _).symm.trans
        ((congrArg (· ≫ G_R.obj.map u_op) hid_TR.symm).trans
          ((Category.assoc _ _ _).trans (congrArg (e_GR.inv.hom.app (Opposite.op T_R) ≫ ·) hnat_e)))
    have hbij_inv : Function.Bijective (e_GR.inv.hom.app (Opposite.op T_R)) :=
      (ConcreteCategory.isIso_iff_bijective (e_GR.inv.hom.app (Opposite.op T_R))).mp inferInstance
    have hbij_hom : Function.Bijective (e_GR.hom.hom.app (Opposite.op U_Ω)) :=
      (ConcreteCategory.isIso_iff_bijective (e_GR.hom.hom.app (Opposite.op U_Ω))).mp inferInstance
    obtain ⟨hCosp_bij, hCosp_inj⟩ :=
      hCospBridge_raw hDom_R j_Rbar hEt_j hj_eq hj_range f_XR f_XΩ j_X hPb_X r (θ_X r) (hθ_X_pb r) T_R hT
    refine ⟨fun hr_le => ?_, fun hr_le1 => ?_⟩
    · have hbij_mid := hCosp_bij (hBij_X_low r hr_le)
      refine ⟨fun x₁ x₂ hx => ?_, fun y => ?_⟩
      · have hx₁ := congrArg (fun m => m.hom x₁) hmap_eq
        have hx₂ := congrArg (fun m => m.hom x₂) hmap_eq
        exact hbij_inv.1 (hbij_mid.1 (hbij_hom.1 (hx₁.symm.trans (hx.trans hx₂))))
      · obtain ⟨y₁, hy₁⟩ := hbij_hom.2 y
        obtain ⟨y₂, hy₂⟩ := hbij_mid.2 y₁
        obtain ⟨x, hx⟩ := hbij_inv.2 y₂
        refine ⟨x, (congrArg (fun m => m.hom x) hmap_eq).trans ?_⟩
        exact (congrArg (e_GR.hom.hom.app (Opposite.op U_Ω)).hom
          ((congrArg ((weilEtaleHigherDirectImage f_XR r (weilEtaleTorsionSheaf X_R ℓ)).obj.map u_op).hom hx).trans
            hy₂)).trans hy₁
    · have hθ_inj : Function.Injective (θ_X r) := by
        rcases lt_or_eq_of_le hr_le1 with hlt | rfl
        · exact (hBij_X_low r (Nat.le_of_lt_succ hlt)).1
        · exact hInj_X_mid
      intro x₁ x₂ hx
      have hx₁ := congrArg (fun m => m.hom x₁) hmap_eq
      have hx₂ := congrArg (fun m => m.hom x₂) hmap_eq
      exact hbij_inv.1 (hCosp_inj hθ_inj (hbij_hom.1 (hx₁.symm.trans (hx.trans hx₂))))

  
  obtain ⟨hCriterion1, hCriterion2⟩ :=
    weil_sing_dev_locConst_curve_etale_triv_and_const_kernel_of_cosp k ℓ hℓ_k D_bar e_P
      R_bar hDom_R g_Rbar j_Rbar hEt_j hj_eq hClosed hLift hCharts
  refine ⟨hCriterion1 _ (hConstruct q) (fun ι_chart _ hι_hom G_R hPb_GR T_R hT =>
      (hChartCosp ι_chart hι_hom q G_R hPb_GR T_R hT).1 hq),
    hCriterion2 _ (fun ι_chart _ hι_hom G'_R hPb_GR T_R hT =>
      (hChartCosp ι_chart hι_hom (q + 1) G'_R hPb_GR T_R hT).2 (Nat.add_le_add_right hq 1))⟩

theorem weil_outer_tr_fib_algClosed_spec_edge_and_const_eval_bijective (k : Type u) [Field k] [IsAlgClosed k] :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    (∀ (Z₀ : AlgebraicGeometry.Scheme.{u}) (π₀ : Z₀ ⟶ S_k)
        (T_k : S_k.Etale) (_hT_k : CategoryTheory.Limits.IsTerminal T_k)
        (hT_Z₀ : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback π₀).obj T_k))
        (𝒢 : CategoryTheory.Sheaf Z₀.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      Function.Bijective (weilOuterTrFibEdgeHom π₀ T_k hT_Z₀ 𝒢 q)) ∧
    (∀ (U : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥U] [PreconnectedSpace ↥U]
        (y : S_k ⟶ U)
        [_hc_y : (weilEtaleSitePullback y).IsContinuous U.smallEtaleTopology S_k.smallEtaleTopology]
        [_hr_y : ((weilEtaleSitePullback y).sheafPushforwardContinuous AddCommGrpCat.{u}
          U.smallEtaleTopology S_k.smallEtaleTopology).IsRightAdjoint]
        (T_U : U.Etale) (_hT_U : CategoryTheory.Limits.IsTerminal T_U)
        (_hT_By : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback y).obj T_U))
        (A : AddCommGrpCat.{u}),
      Function.Bijective
        (((((weilEtaleSitePullback y).sheafAdjunctionContinuous AddCommGrpCat.{u}
          U.smallEtaleTopology S_k.smallEtaleTopology).unit.app
          ((CategoryTheory.constantSheaf U.smallEtaleTopology AddCommGrpCat.{u}).obj
            A)).hom.app (Opposite.op T_U)).hom)) :=
by
  intro S_k
  
  have hTermStd : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S)) := by
    intro S
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => CategoryTheory.MorphismProperty.Over.homMk W.hom
        (CategoryTheory.Category.comp_id W.hom) trivial) ?_
    intro W m
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    have hw : m.left ≫ 𝟙 S = W.hom := CategoryTheory.MorphismProperty.Over.w m
    exact (CategoryTheory.Category.comp_id m.left).symm.trans hw

  
  have hMemEtale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (E : S.Etale)
      (R : CategoryTheory.Sieve E),
      R ∈ S.smallEtaleTopology E ↔
        ∀ x : ↥E.left, ∃ (Y : S.Etale) (f : Y ⟶ E) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left y = x := by
    intro S E R
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have heq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S (le_refl P_et)
    have hiff :=
      AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := S) E R
    exact (iff_of_eq (congrArg (fun J => R ∈ J E) heq)).trans hiff

  
  
  have hSpecSheafifyBij : ∀ (T_k : S_k.Etale) (hT_k : CategoryTheory.Limits.IsTerminal T_k)
      (P : CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u}),
      Function.Bijective
        ((((CategoryTheory.sheafificationAdjunction S_k.smallEtaleTopology
          AddCommGrpCat.{u}).unit.app P).app (Opposite.op T_k)).hom) := by
    intro T_k hT_k P
    have hSplit : ∀ {V : AlgebraicGeometry.Scheme.{u}} (q : V ⟶ S_k),
        AlgebraicGeometry.Etale q → Function.Surjective ⇑q →
        ∃ s : S_k ⟶ V, s ≫ q = 𝟙 S_k := by
      intro V q hqEt hqSurj
      let P_pt := AlgebraicGeometry.Scheme.geometricFiber k
      let R_q : CategoryTheory.Sieve S_k :=
        CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q)
      have h_pre : CategoryTheory.Presieve.singleton q ∈
          (AlgebraicGeometry.Scheme.precoverage (@AlgebraicGeometry.Etale)).coverings S_k :=
        (AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff (@AlgebraicGeometry.Etale) q).mpr
          ⟨hqSurj, hqEt⟩
      have hR_mem : R_q ∈ AlgebraicGeometry.Scheme.etaleTopology S_k :=
        CategoryTheory.Precoverage.generate_mem_toGrothendieck h_pre
      obtain ⟨Y, f, hfR, y₀, hy₀⟩ := P_pt.jointly_surjective R_q hR_mem (𝟙 S_k)
      rcases hfR with ⟨Z, g, h, hh_sing, rfl⟩
      cases hh_sing
      exact ⟨y₀ ≫ g, hy₀⟩
    let T_std_k : S_k.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 S_k)
    have hTop_std : ∀ R₀ ∈ S_k.smallEtaleTopology T_std_k, R₀ = ⊤ := by
      intro R₀ hR₀
      let pt_k : ↥S_k := default
      obtain ⟨W, u, w₀, huR, huEt, -⟩ := (hMemEtale S_k T_std_k R₀).mp hR₀ pt_k
      have huSurj : Function.Surjective ⇑u.left :=
        fun x => ⟨w₀, @Subsingleton.elim ↥S_k inferInstance _ x⟩
      obtain ⟨s, hs⟩ := hSplit u.left huEt huSurj
      have hu_hom : u.left = W.hom := by
        have hw : u.left ≫ 𝟙 S_k = W.hom := CategoryTheory.MorphismProperty.Over.w u
        exact (CategoryTheory.Category.comp_id u.left).symm.trans hw
      let s_et : T_std_k ⟶ W :=
        CategoryTheory.MorphismProperty.Over.homMk s (by rw [← hu_hom]; exact hs) trivial
      have hsu : s_et ≫ u = 𝟙 T_std_k := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact hs
      have hid : R₀.arrows (𝟙 T_std_k) := by
        rw [← hsu]
        exact R₀.downward_closed huR s_et
      exact (CategoryTheory.Sieve.id_mem_iff_eq_top).mp hid
    let e_k : T_k ≅ T_std_k :=
      CategoryTheory.Limits.IsTerminal.uniqueUpToIso hT_k (hTermStd S_k)
    have hTop_Tk : ∀ R ∈ S_k.smallEtaleTopology T_k, R = ⊤ := by
      intro R hR
      have hpb : R.pullback e_k.inv ∈ S_k.smallEtaleTopology T_std_k :=
        S_k.smallEtaleTopology.pullback_stable e_k.inv hR
      have hpb_top : R.pullback e_k.inv = ⊤ := hTop_std _ hpb
      have he_inv : R.arrows e_k.inv := by
        have h1 : (R.pullback e_k.inv).arrows (𝟙 T_std_k) := by rw [hpb_top]; trivial
        simpa using h1
      have hid : R.arrows (𝟙 T_k) := by
        rw [← e_k.hom_inv_id]
        exact R.downward_closed he_inv e_k.hom
      exact (CategoryTheory.Sieve.id_mem_iff_eq_top).mp hid
    let J_k := S_k.smallEtaleTopology
    let adj_sh := CategoryTheory.sheafificationAdjunction J_k AddCommGrpCat.{u}
    let η := adj_sh.unit.app P
    have hW : J_k.W η := J_k.W_adj_unit_app adj_sh P
    obtain ⟨hLocInj, hLocSurj⟩ := (J_k.W_iff_isLocallyBijective η).mp hW
    let _ : CategoryTheory.Presheaf.IsLocallyInjective J_k η := hLocInj
    let _ : CategoryTheory.Presheaf.IsLocallySurjective J_k η := hLocSurj
    refine ⟨?_, ?_⟩
    · intro x₁ x₂ hx
      have hmem : CategoryTheory.Presheaf.equalizerSieve x₁ x₂ ∈ J_k T_k :=
        CategoryTheory.Presheaf.IsLocallyInjective.equalizerSieve_mem
          (J := J_k) (φ := η) (X := Opposite.op T_k) x₁ x₂ hx
      have htop : CategoryTheory.Presheaf.equalizerSieve x₁ x₂ = ⊤ := hTop_Tk _ hmem
      have hid : (CategoryTheory.Presheaf.equalizerSieve x₁ x₂).arrows (𝟙 T_k) := by
        rw [htop]; trivial
      change (CategoryTheory.ConcreteCategory.hom (P.map (𝟙 T_k).op)) x₁ =
        (CategoryTheory.ConcreteCategory.hom (P.map (𝟙 T_k).op)) x₂ at hid
      rw [CategoryTheory.op_id, CategoryTheory.Functor.map_id] at hid
      exact hid
    · intro s
      have hmem : CategoryTheory.Presheaf.imageSieve η s ∈ J_k T_k :=
        CategoryTheory.Presheaf.imageSieve_mem J_k η (U := Opposite.op T_k) s
      have htop : CategoryTheory.Presheaf.imageSieve η s = ⊤ := hTop_Tk _ hmem
      have hid : (CategoryTheory.Presheaf.imageSieve η s).arrows (𝟙 T_k) := by
        rw [htop]; trivial
      rw [CategoryTheory.Presheaf.imageSieve_apply] at hid
      obtain ⟨t, ht⟩ := hid
      rw [CategoryTheory.op_id, CategoryTheory.Functor.map_id] at ht
      exact ⟨t, ht⟩

  
  
  have hCohTermBij : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (T : Z.Etale)
      (hT : CategoryTheory.Limits.IsTerminal T)
      (𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      Function.Bijective (weilPolyP1CohomologyTermToPresheaf Z T hT 𝒢 q) := by
    intro Z T hT 𝒢 q
    let J := Z.smallEtaleTopology
    let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let C_Z := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let adj_c := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
    let R_T := weilPolyP1CohomologyRepSheaf Z T
    let α : R_T ⟶ C_Z.obj Aℤ := weilPolyP1CohomologyRepToConst Z T hT
    have hNatEquiv : ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u})
        (φ : C_Z.obj Aℤ ⟶ G),
        weilPolyP1CohomologyRepHomEquiv Z T G (α ≫ φ) =
          ((adj_c.homEquiv Aℤ G) φ).hom (ULift.up (1 : ℤ)) := by
      intro G φ
      let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
      let adj_fr := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
      let F_yon := CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj T) AddCommGrpCat.free
      have h1 : (adj_sh.homEquiv F_yon G) (α ≫ φ) =
          (adj_sh.homEquiv F_yon (C_Z.obj Aℤ)) α ≫ φ.hom :=
        adj_sh.homEquiv_naturality_right α φ
      have h2 := adj_fr.homEquiv_naturality_right
        ((adj_sh.homEquiv F_yon (C_Z.obj Aℤ)) α) φ.hom
      have h3 : weilPolyP1CohomologyRepHomEquiv Z T G (α ≫ φ) =
          (φ.hom.app (Opposite.op T)).hom
            (weilPolyP1CohomologyRepHomEquiv Z T (C_Z.obj Aℤ) α) := by
        dsimp only [weilPolyP1CohomologyRepHomEquiv, Equiv.trans_apply]
        rw [h1, h2, CategoryTheory.yonedaEquiv_apply, CategoryTheory.yonedaEquiv_apply]
        rfl
      have h4 : weilPolyP1CohomologyRepHomEquiv Z T (C_Z.obj Aℤ) α =
          (adj_c.unit.app Aℤ) (ULift.up (1 : ℤ)) :=
        (weilPolyP1CohomologyRepHomEquiv Z T (C_Z.obj Aℤ)).apply_symm_apply _
      have h5 : (adj_c.homEquiv Aℤ G) φ =
          adj_c.unit.app Aℤ ≫ φ.hom.app (Opposite.op T) :=
        adj_c.homEquiv_unit Aℤ G φ
      rw [h3, h4, h5]
      rfl
    let evℤ : ∀ (M : AddCommGrpCat.{u}), (Aℤ ⟶ M) ≃ ↥M := fun M =>
      { toFun := fun f => f.hom (ULift.up (1 : ℤ))
        invFun := fun m => AddCommGrpCat.ofHom
          { toFun := fun z => z.down • m
            map_zero' := zero_zsmul m
            map_add' := fun a b => add_zsmul m a.down b.down }
        left_inv := fun f => by
          ext ⟨z⟩
          change z • f.hom (ULift.up (1 : ℤ)) = f.hom (ULift.up z)
          have hz : (ULift.up z : ULift.{u} ℤ) = z • ULift.up (1 : ℤ) := by
            ext
            exact (mul_one z).symm
          rw [hz, map_zsmul]
        right_inv := fun m => one_zsmul m }
    have hPreBij : ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        Function.Bijective (fun φ : C_Z.obj Aℤ ⟶ G => α ≫ φ) := by
      intro G
      let E₁ := weilPolyP1CohomologyRepHomEquiv Z T G
      let E₂ := (adj_c.homEquiv Aℤ G).trans (evℤ (G.obj.obj (Opposite.op T)))
      have hEq : (fun φ : C_Z.obj Aℤ ⟶ G => α ≫ φ) = ⇑(E₂.trans E₁.symm) := by
        funext φ
        apply E₁.injective
        simpa [E₁, E₂, evℤ] using hNatEquiv G φ
      rw [hEq]
      exact (E₂.trans E₁.symm).bijective
    obtain ⟨β, hαβ⟩ := (hPreBij R_T).2 (𝟙 R_T)
    dsimp only at hαβ
    have hβα : β ≫ α = 𝟙 (C_Z.obj Aℤ) := by
      apply (hPreBij (C_Z.obj Aℤ)).1
      change α ≫ (β ≫ α) = α ≫ 𝟙 (C_Z.obj Aℤ)
      rw [← CategoryTheory.Category.assoc, hαβ, CategoryTheory.Category.id_comp,
          CategoryTheory.Category.comp_id]
    have hl : ∀ x : CategoryTheory.Abelian.Ext (C_Z.obj Aℤ) 𝒢 q,
        (CategoryTheory.Abelian.Ext.mk₀ β).comp
          ((CategoryTheory.Abelian.Ext.mk₀ α).comp x (Nat.zero_add q)) (Nat.zero_add q) = x := by
      intro x
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, hβα,
          CategoryTheory.Abelian.Ext.mk₀_id_comp]
    have hr : ∀ y : CategoryTheory.Abelian.Ext R_T 𝒢 q,
        (CategoryTheory.Abelian.Ext.mk₀ α).comp
          ((CategoryTheory.Abelian.Ext.mk₀ β).comp y (Nat.zero_add q)) (Nat.zero_add q) = y := by
      intro y
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, hαβ,
          CategoryTheory.Abelian.Ext.mk₀_id_comp]
    refine ⟨?_, ?_⟩
    · intro x₁ x₂ hx
      have hgx : (CategoryTheory.Abelian.Ext.mk₀ β).comp
          (weilPolyP1CohomologyTermToPresheaf Z T hT 𝒢 q x₁) (Nat.zero_add q) =
          (CategoryTheory.Abelian.Ext.mk₀ β).comp
            (weilPolyP1CohomologyTermToPresheaf Z T hT 𝒢 q x₂) (Nat.zero_add q) :=
        congrArg (fun z => (CategoryTheory.Abelian.Ext.mk₀ β).comp z (Nat.zero_add q)) hx
      exact (hl x₁).symm.trans (hgx.trans (hl x₂))
    · intro y
      exact ⟨(CategoryTheory.Abelian.Ext.mk₀ β).comp y (Nat.zero_add q), hr y⟩

  
  
  have hPreconnConstUnitBij : ∀ (V : AlgebraicGeometry.Scheme.{u})
      [Nonempty ↥V] [PreconnectedSpace ↥V]
      (T_V : V.Etale) (hT_V : CategoryTheory.Limits.IsTerminal T_V)
      (A : AddCommGrpCat.{u}),
      Function.Bijective
        (((CategoryTheory.constantSheafAdj V.smallEtaleTopology
          AddCommGrpCat.{u} hT_V).unit.app A).hom) := by
    intro V _ _ T_V hT_V A
    have hArrowEtale : ∀ {Y₁ Y₂ : V.Etale} (u : Y₁ ⟶ Y₂),
        AlgebraicGeometry.Etale u.left := by
      intro Y₁ Y₂ u
      have hw : u.left ≫ Y₂.hom = Y₁.hom := CategoryTheory.MorphismProperty.Over.w u
      have hcomp : AlgebraicGeometry.Etale (u.left ≫ Y₂.hom) := by
        rw [hw]
        exact Y₁.prop
      exact CategoryTheory.MorphismProperty.of_postcomp
        (@AlgebraicGeometry.Etale) u.left Y₂.hom Y₂.prop hcomp
    let P_A : CategoryTheory.Functor (Opposite V.Etale) AddCommGrpCat.{u} :=
      { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥E.unop.left ↥A)
        map := fun f => AddCommGrpCat.ofHom
          (LocallyConstant.comapAddMonoidHom (Z := ↥A) f.unop.left.base.hom)
        map_id := fun E => by
          ext g x
          rfl
        map_comp := fun f₁ f₂ => by
          ext g x
          rfl }
    let P_const : CategoryTheory.Functor (Opposite V.Etale) AddCommGrpCat.{u} :=
      (CategoryTheory.Functor.const (Opposite V.Etale)).obj A
    let θ_A : P_const ⟶ P_A :=
      { app := fun E => AddCommGrpCat.ofHom
          (LocallyConstant.constAddMonoidHom (X := ↥E.unop.left) (Y := ↥A))
        naturality := fun E₁ E₂ f => by
          ext a x
          rfl }
    have hSheaf : CategoryTheory.Presheaf.IsSheaf V.smallEtaleTopology P_A := by
      rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
      intro E S hS
      let cov := fun x : ↥E.left => (hMemEtale V E S).mp hS x
