            (CategoryTheory.ShortComplex.mk d₀
              (weilEtaleHigherDirectImageMap g₀ 0 SC_X.f) hd₀f).Exact :=
          (CategoryTheory.ShortComplex.exact_iff_mono _ rfl).mpr inferInstance
        obtain ⟨δ₀, _, h0_mid, h0_left, _, hEx_mid, hEx_left, _⟩ :=
          hPushCalc.2.2.2.1 hSE_X 0
        exact weil_mid_dev_raw_locConst_noetherian_five_term_exact_ext
          R₀ U₀.toScheme e_U
          C_zero
          (weilEtaleHigherDirectImage g₀ 0 SC_X.X₁)
          (weilEtaleHigherDirectImage g₀ 0 SC_X.X₂)
          (weilEtaleHigherDirectImage g₀ 0 SC_X.X₃)
          (weilEtaleHigherDirectImage g₀ 1 SC_X.X₁)
          d₀
          (weilEtaleHigherDirectImageMap g₀ 0 SC_X.f)
          (weilEtaleHigherDirectImageMap g₀ 0 SC_X.g)
          δ₀
          hd₀f h0_mid h0_left hEx₀ hEx_mid hEx_left y
          hLC_zero (h_mod_ell 0 y) (ih 0 y) (h_mod_ell 1 y)
      · obtain ⟨δ_prev, _, _, _, h0_right, _, _, hEx_right⟩ :=
          hPushCalc.2.2.2.1 hSE_X q'
        obtain ⟨δ_curr, _, h0_mid, h0_left, _, hEx_mid, hEx_left, _⟩ :=
          hPushCalc.2.2.2.1 hSE_X (q' + 1)
        exact weil_mid_dev_raw_locConst_noetherian_five_term_exact_ext
          R₀ U₀.toScheme e_U
          (weilEtaleHigherDirectImage g₀ q' SC_X.X₃)
          (weilEtaleHigherDirectImage g₀ (q' + 1) SC_X.X₁)
          (weilEtaleHigherDirectImage g₀ (q' + 1) SC_X.X₂)
          (weilEtaleHigherDirectImage g₀ (q' + 1) SC_X.X₃)
          (weilEtaleHigherDirectImage g₀ (q' + 2) SC_X.X₁)
          δ_prev
          (weilEtaleHigherDirectImageMap g₀ (q' + 1) SC_X.f)
          (weilEtaleHigherDirectImageMap g₀ (q' + 1) SC_X.g)
          δ_curr
          h0_right h0_mid h0_left hEx_right hEx_mid hEx_left y
          (ih q' y) (h_mod_ell (q' + 1) y) (ih (q' + 1) y) (h_mod_ell (q' + 2) y)
  exact h_all r q x

theorem weil_commAlg_traceMatrix_det_isUnit_etale_and_dedekind_galois (A K : Type u)
    [CommRing A] [IsDomain A] [IsPrincipalIdealRing A] [IsDedekindDomain A]
    [Field K] [Algebra A K] [IsFractionRing A K] :
    (∀ (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
        [FiniteDimensional K L] [IsGalois K L],
      ∃ δ_L : A, δ_L ≠ 0 ∧
        ∀ (g : A), g ≠ 0 → δ_L ∣ g →
          ∀ (φ_g : Localization.Away g →+* K),
            φ_g.comp (algebraMap A (Localization.Away g)) = algebraMap A K →
            letI : Algebra (Localization.Away g) L :=
              ((algebraMap K L).comp φ_g).toAlgebra
            Module.Finite (Localization.Away g) ↥(integralClosure (Localization.Away g) L) ∧
            Algebra.Etale (Localization.Away g) ↥(integralClosure (Localization.Away g) L)) ∧
    ((∀ p : Ideal A, p.IsMaximal → p ≠ ⊥) →
      (∀ (p : Ideal A) [p.IsMaximal], Finite (A ⧸ p)) →
      ∀ (E : Type u) [Field E] [Algebra K E] [Algebra A E] [IsScalarTower A K E]
        [FiniteDimensional K E] [IsGalois K E],
        (∀ (p : Ideal A) [p.IsMaximal] (P : Ideal ↥(integralClosure A E)) [P.IsPrime],
          Ideal.comap (algebraMap A ↥(integralClosure A E)) P = p →
          Algebra.IsUnramifiedAt A P) →
        Module.Finite A ↥(integralClosure A E) ∧
        Algebra.Etale A ↥(integralClosure A E)) :=
by
  have hEtaleOfTraceDet : ∀ (R S : Type u) [CommRing R] [IsNoetherianRing R]
      [CommRing S] [Algebra R S] (m : ℕ) (b : Module.Basis (Fin m) R S),
      IsUnit (Algebra.traceMatrix R ⇑b).det → Algebra.Etale R S := by
    intro R S _ _ _ _ m b hDet
    let T : Matrix (Fin m) (Fin m) R := Algebra.traceMatrix R ⇑b
    let U : Matrix (Fin m) (Fin m) R := T⁻¹
    have hTU : T * U = 1 := Matrix.mul_nonsing_inv T hDet
    have hUT : U * T = 1 := Matrix.nonsing_inv_mul T hDet
    let b_star : Fin m → S := fun i => ∑ j : Fin m, U i j • b j
    have hT_apply : ∀ i j : Fin m, T i j = Algebra.trace R S (b i * b j) := by
      intro i j
      simp [T, Algebra.traceMatrix_apply, Algebra.traceForm_apply]
    have hT_symm : ∀ i j : Fin m, T i j = T j i := by
      intro i j
      simp only [hT_apply, mul_comm]
    have hTraceDual : ∀ k i : Fin m,
        Algebra.trace R S (b k * b_star i) = (1 : Matrix (Fin m) (Fin m) R) i k := by
      intro k i
      have hmul : b k * b_star i = ∑ j : Fin m, U i j • (b k * b j) := by
        simp only [b_star, Finset.mul_sum, mul_smul_comm]
      rw [hmul, map_sum]
      have hsum : (∑ j : Fin m, Algebra.trace R S (U i j • (b k * b j))) =
          ∑ j : Fin m, U i j * T j k := by
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [LinearMap.map_smul, smul_eq_mul, ← hT_apply k j, hT_symm k j]
      rw [hsum, ← Matrix.mul_apply, hUT]
    have hDualBasis : ∀ k : Fin m,
        ∑ r : Fin m, Algebra.trace R S (b k * b r) • b_star r = b k := by
      intro k
      calc
        ∑ r : Fin m, Algebra.trace R S (b k * b r) • b_star r
          = ∑ r : Fin m, T k r • (∑ j : Fin m, U r j • b j) := by
            refine Finset.sum_congr rfl fun r _ => ?_
            rw [← hT_apply k r]
        _ = ∑ r : Fin m, ∑ j : Fin m, (T k r * U r j) • b j := by
            refine Finset.sum_congr rfl fun r _ => ?_
            rw [Finset.smul_sum]
            exact Finset.sum_congr rfl fun j _ => smul_smul (T k r) (U r j) (b j)
        _ = ∑ j : Fin m, (∑ r : Fin m, T k r * U r j) • b j := by
            rw [Finset.sum_comm]
            exact Finset.sum_congr rfl fun j _ => Finset.sum_smul.symm
        _ = ∑ j : Fin m, (1 : Matrix (Fin m) (Fin m) R) k j • b j := by
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [← Matrix.mul_apply, hTU]
        _ = b k := by
            simp [Matrix.one_apply]
    have hDualExp : ∀ z : S, ∑ r : Fin m, Algebra.trace R S (z * b r) • b_star r = z := by
      intro z
      conv_lhs => rw [← b.sum_repr z]
      have h1 : ∀ r : Fin m,
          Algebra.trace R S ((∑ k : Fin m, (b.repr z k) • b k) * b r) • b_star r =
          ∑ k : Fin m, (b.repr z k) • (Algebra.trace R S (b k * b r) • b_star r) := by
        intro r
        rw [Finset.sum_mul]
        have h2 : ∑ k : Fin m, ((b.repr z k) • b k) * b r =
            ∑ k : Fin m, (b.repr z k) • (b k * b r) :=
          Finset.sum_congr rfl fun k _ => smul_mul_assoc (b.repr z k) (b k) (b r)
        rw [h2, map_sum, Finset.sum_smul]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [LinearMap.map_smul, smul_eq_mul, mul_smul]
      simp_rw [h1]
      rw [Finset.sum_comm]
      calc
        ∑ k : Fin m, ∑ r : Fin m, (b.repr z k) • (Algebra.trace R S (b k * b r) • b_star r)
          = ∑ k : Fin m, (b.repr z k) • (∑ r : Fin m, Algebra.trace R S (b k * b r) • b_star r) :=
            Finset.sum_congr rfl fun k _ => Finset.smul_sum.symm
        _ = ∑ k : Fin m, (b.repr z k) • b k := by simp_rw [hDualBasis]
        _ = z := b.sum_repr z
    let M : S → Matrix (Fin m) (Fin m) R := Algebra.leftMulMatrix b
    have hM_entry : ∀ (x : S) (k i : Fin m), M x k i = b.repr (x * b i) k := by
      intro x k i
      simp [M, Algebra.leftMulMatrix_apply, LinearMap.toMatrix_apply]
    have hM_mul : ∀ (x : S) (i : Fin m), x * b i = ∑ k : Fin m, M x k i • b k := by
      intro x i
      simp_rw [hM_entry]
      exact (b.sum_repr (x * b i)).symm
    have hTraceMulDual : ∀ (x : S) (k r : Fin m),
        Algebra.trace R S ((x * b_star k) * b r) = M x k r := by
      intro x k r
      have hcalc : (x * b_star k) * b r = ∑ s : Fin m, M x s r • (b s * b_star k) := by
        calc
          (x * b_star k) * b r = (x * b r) * b_star k := by ring
          _ = (∑ s : Fin m, M x s r • b s) * b_star k := by rw [hM_mul]
          _ = ∑ s : Fin m, M x s r • (b s * b_star k) := by
              rw [Finset.sum_mul]
              exact Finset.sum_congr rfl fun s _ => smul_mul_assoc _ _ _
      rw [hcalc, map_sum]
      have hsum : (∑ s : Fin m, Algebra.trace R S (M x s r • (b s * b_star k))) =
          ∑ s : Fin m, M x s r * (1 : Matrix (Fin m) (Fin m) R) k s := by
        refine Finset.sum_congr rfl fun s _ => ?_
        rw [LinearMap.map_smul, smul_eq_mul, hTraceDual s k]
      rw [hsum]
      simp [Matrix.one_apply]
    have hDualMul : ∀ (x : S) (k : Fin m), x * b_star k = ∑ i : Fin m, M x k i • b_star i := by
      intro x k
      calc
        x * b_star k = ∑ i : Fin m, Algebra.trace R S ((x * b_star k) * b i) • b_star i :=
          (hDualExp (x * b_star k)).symm
        _ = ∑ i : Fin m, M x k i • b_star i := by simp_rw [hTraceMulDual]
    have hPartUnity : ∑ i : Fin m, b i * b_star i = 1 := by
      have hTrEq : ∀ r : Fin m,
          Algebra.trace R S ((∑ i : Fin m, b i * b_star i) * b r) =
          Algebra.trace R S (1 * b r) := by
        intro r
        rw [one_mul, Algebra.trace_eq_matrix_trace b (b r)]
        simp only [Matrix.trace, Matrix.diag_apply]
        rw [Finset.sum_mul, map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        have hcomm : (b i * b_star i) * b r = (b r * b_star i) * b i := by ring
        rw [hcomm, hTraceMulDual (b r) i i]
      calc
        ∑ i : Fin m, b i * b_star i
          = ∑ r : Fin m, Algebra.trace R S ((∑ i : Fin m, b i * b_star i) * b r) • b_star r :=
            (hDualExp _).symm
        _ = ∑ r : Fin m, Algebra.trace R S (1 * b r) • b_star r := by simp_rw [hTrEq]
        _ = 1 := hDualExp 1
    have hUnram : Algebra.FormallyUnramified R S := by
      let D := KaehlerDifferential.D R S
      have hDx : ∀ x : S, D x = 0 := by
        intro x
        have hWay1 : ∑ i : Fin m, b_star i • D (x * b i) =
            (∑ i : Fin m, (x * b_star i) • D (b i)) + D x := by
          have hterm : ∀ i : Fin m,
              b_star i • D (x * b i) = (x * b_star i) • D (b i) + (b i * b_star i) • D x := by
            intro i
            rw [D.leibniz x (b i), smul_add, smul_smul, smul_smul, mul_comm (b_star i) x,
              mul_comm (b_star i) (b i)]
          simp_rw [hterm]
          rw [Finset.sum_add_distrib, ← Finset.sum_smul, hPartUnity, one_smul]
        have hWay2 : ∑ i : Fin m, b_star i • D (x * b i) =
            ∑ k : Fin m, (x * b_star k) • D (b k) := by
          have hterm2 : ∀ i : Fin m,
              b_star i • D (x * b i) = ∑ k : Fin m, (M x k i • b_star i) • D (b k) := by
            intro i
            rw [hM_mul x i, map_sum, Finset.smul_sum]
            refine Finset.sum_congr rfl fun k _ => ?_
            rw [D.map_smul, ← IsScalarTower.algebraMap_smul S (M x k i) (D (b k)), smul_smul,
              mul_comm (b_star i), ← Algebra.smul_def]
          simp_rw [hterm2]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [← Finset.sum_smul, hDualMul x k]
        have heq := congrArg (fun ω => -(∑ i : Fin m, (x * b_star i) • D (b i)) + ω)
          (hWay1.symm.trans hWay2)
        rwa [neg_add_cancel_left, neg_add_cancel] at heq
      have hSpanBot : Submodule.span S (Set.range ⇑D) ≤ ⊥ := by
        rw [Submodule.span_le]
        rintro _ ⟨x, rfl⟩
        simp [hDx x]
      rw [KaehlerDifferential.span_range_derivation R S] at hSpanBot
      have hSub : Subsingleton Ω[S⁄R] := subsingleton_of_forall_eq 0 fun ω => by
        have hmem : ω ∈ (⊥ : Submodule S Ω[S⁄R]) := hSpanBot Submodule.mem_top
        rwa [Submodule.mem_bot] at hmem
      exact Algebra.FormallyUnramified.mk hSub
    have hSmooth : Algebra.FormallySmooth R S := by
      let P := MvPolynomial (Fin m) R
      let f : P →ₐ[R] S := MvPolynomial.aeval b
      let I : Ideal P := RingHom.ker f.toRingHom
      let Q := P ⧸ (I ^ 2)
      let q : P →ₐ[R] Q := Ideal.Quotient.mkₐ R (I ^ 2)
      let π : Q →ₐ[R] S := f.kerSquareLift
      have hKerSq : ∀ u v : Q, π u = 0 → π v = 0 → u * v = 0 := by
        intro u v hu hv
        obtain ⟨p₁, rfl⟩ := Ideal.Quotient.mk_surjective u
        obtain ⟨p₂, rfl⟩ := Ideal.Quotient.mk_surjective v
        have hp₁ : p₁ ∈ I := RingHom.mem_ker.mpr ((AlgHom.kerSquareLift_mk f p₁).symm.trans hu)
        have hp₂ : p₂ ∈ I := RingHom.mem_ker.mpr ((AlgHom.kerSquareLift_mk f p₂).symm.trans hv)
        have hp₁₂ : p₁ * p₂ ∈ I ^ 2 := by
          rw [sq]
          exact Ideal.mul_mem_mul hp₁ hp₂
        rw [← map_mul]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hp₁₂
      let ψ : S →ₗ[R] Q := b.constr R (fun i => q (MvPolynomial.X i))
      have hψ_basis : ∀ i : Fin m, ψ (b i) = q (MvPolynomial.X i) :=
        fun i => b.constr_basis R _ i
      have hπ_ψ_lin : π.toLinearMap.comp ψ = LinearMap.id := by
        refine b.ext fun i => ?_
        simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, LinearMap.id_apply, hψ_basis]
        change f.kerSquareLift (Ideal.Quotient.mk (I ^ 2) (MvPolynomial.X i)) = b i
        rw [AlgHom.kerSquareLift_mk, MvPolynomial.aeval_X]
      have hπ_ψ : ∀ x : S, π (ψ x) = x := fun x =>
        congrArg (fun g : S →ₗ[R] S => g x) hπ_ψ_lin
      let Δ : S → S → Q := fun x y => ψ (x * y) - ψ x * ψ y
      have hπ_Δ : ∀ x y : S, π (Δ x y) = 0 := by
        intro x y
        simp only [Δ, map_sub, map_mul, hπ_ψ, sub_self]
      have hπ_one : π (1 - ψ 1) = 0 := by
        rw [map_sub, map_one, hπ_ψ, sub_self]
      have hAbsorbMul : ∀ (u : Q) (y₁ y₂ : S), π u = 0 → u * ψ (y₁ * y₂) = u * ψ y₁ * ψ y₂ := by
        intro u y₁ y₂ hu
        have h0 : u * Δ y₁ y₂ = 0 := hKerSq u (Δ y₁ y₂) hu (hπ_Δ y₁ y₂)
        dsimp only [Δ] at h0
        rw [mul_sub, ← mul_assoc] at h0
        exact sub_eq_zero.mp h0
