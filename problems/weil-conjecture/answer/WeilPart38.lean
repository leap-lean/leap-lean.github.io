        have hq_basic : j_loc.base q_A ∈ (PrimeSpectrum.basicOpen f_loc : Set (PrimeSpectrum R'_k)) := by
          rw [← PrimeSpectrum.localization_away_comap_range A f_loc]
          exact ⟨q_A, rfl⟩
        exact hfloc_sub hq_basic
      let α : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of P) :=
        AlgebraicGeometry.IsOpenImmersion.lift ι_chart (j_loc ≫ e_Bk) hRange_jloc
      have hα_fac : α ≫ ι_chart = j_loc ≫ e_Bk :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac ι_chart (j_loc ≫ e_Bk) hRange_jloc
      have hEt_α_comp : AlgebraicGeometry.Etale (α ≫ ι_chart) := by
        rw [hα_fac]; infer_instance
      have hEt_α : AlgebraicGeometry.Etale α :=
        CategoryTheory.MorphismProperty.of_postcomp (W' := @AlgebraicGeometry.Etale)
          (@AlgebraicGeometry.Etale) α ι_chart inferInstance hEt_α_comp
      let φ₁ : P →+* A := (AlgebraicGeometry.Spec.preimage α).hom
      have hSpec_φ₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) = α :=
        AlgebraicGeometry.Spec.map_preimage α
      have hEt_Spec_φ₁ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁)) := by
        rw [hSpec_φ₁]; exact hEt_α
      have hφ₁_et : φ₁.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_Spec_φ₁
      have h_comp_k : φ₁.comp Polynomial.C = (algebraMap R'_k A).comp (ψ_Bk.comp Polynomial.C) := by
        have hspec_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₁.comp Polynomial.C)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              ((algebraMap R'_k A).comp (ψ_Bk.comp Polynomial.C))) := by
          rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hSpec_φ₁,
            CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
          change α ≫ p_A1 = j_loc ≫ _
          rw [← hι_hom, ← Category.assoc, hα_fac, Category.assoc, he_Bk_hom]
        exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hspec_eq)
      let ε_A : A →+* k := IsLocalization.Away.lift f_loc (IsUnit.mk0 (ε_k f_loc) hε_floc)
      have hε_A : ε_A.comp (algebraMap R'_k A) = ε_k := by
        ext r; exact IsLocalization.Away.lift_eq f_loc (IsUnit.mk0 (ε_k f_loc) hε_floc) r
      have hε₁ : ε_A.comp φ₁ = Polynomial.evalRingHom 0 := by
        have hpt_chart : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ε_A.comp φ₁)) ≫ ι_chart).base
            (⊥ : PrimeSpectrum k) = (s₀ ≫ ι_chart).base (⊥ : PrimeSpectrum k) := by
          rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, Category.assoc,
            hSpec_φ₁, hα_fac, ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp, hε_A, hεk_eBk, hz_fbar]
        have hpt_A1 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ε_A.comp φ₁))).base
            (⊥ : PrimeSpectrum k) = s₀.base (⊥ : PrimeSpectrum k) :=
          ι_chart.isOpenEmbedding.injective hpt_chart
        have hX0 : ε_A (φ₁ Polynomial.X) = 0 := by
          have hmem : Polynomial.X ∈ (s₀.base (⊥ : PrimeSpectrum k)).asIdeal := by
            change Polynomial.eval 0 Polynomial.X = 0; simp
          rw [← hpt_A1] at hmem
          exact hmem
        apply Polynomial.ringHom_ext'
        · rw [RingHom.comp_assoc, h_comp_k, ← RingHom.comp_assoc, hε_A,
            ← RingHom.comp_assoc, hεk_ψBk]
        · simpa using hX0
      obtain ⟨U_Q, π_UA, j_tot, hOpen_jtot, Ψ_odp, hEt_Ψ, hMem_jtot,
        hLeft_tri, hRight_tri, hIdeal_Ψ⟩ :=
        h_pillar4 k m R'_k f_loc ψ_Bk hEt_ψBk ε_k hε_floc hεk_ψBk φ₁ hφ₁_et
          ε_A hε_A hε₁
      let _ : AlgebraicGeometry.IsOpenImmersion j_tot := hOpen_jtot
      let _ : AlgebraicGeometry.Etale j_tot := inferInstance
      let _ : AlgebraicGeometry.Etale Ψ_odp := hEt_Ψ
      have hvk_in_jtot : q_k.base v_k ∈ Set.range j_tot.base := by
        apply hMem_jtot (q_k.base v_k)
        have h_eq : π_Rk.base (q_k.base v_k) = u₀_k := hqk_πRk_vk
        rw [h_eq]
        intro r hr; exact hr
      have hvk_pre : v_k ∈ (q_k ⁻¹ᵁ j_tot.opensRange : V'_k.Opens) := hvk_in_jtot
      obtain ⟨W_aff, hAff_W, hv_W, hW_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := v_k) (U := q_k ⁻¹ᵁ j_tot.opensRange) hvk_pre
      let V' : AlgebraicGeometry.Scheme.{u} := W_aff.toScheme
      have hIsAff_V' : AlgebraicGeometry.IsAffine V' := hAff_W
      let v₀ : ↥V' := ⟨v_k, hv_W⟩
      let e_Y : V' ⟶ Z_bar.left := W_aff.ι ≫ e_Yk
      have hEt_eY : AlgebraicGeometry.Etale e_Y := by dsimp [e_Y]; infer_instance
      have he_Y_v₀ : e_Y.base v₀ = z := by
        change e_Yk.base v_k = z; exact hvk_z
      have hRange_W : Set.range (W_aff.ι ≫ q_k).base ⊆ Set.range j_tot.base := by
        rintro _ ⟨w_pt, rfl⟩
        exact hW_sub w_pt.2
      let q_lift : V' ⟶ U_Q :=
        AlgebraicGeometry.IsOpenImmersion.lift j_tot (W_aff.ι ≫ q_k) hRange_W
      have hqlift_fac : q_lift ≫ j_tot = W_aff.ι ≫ q_k :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac j_tot (W_aff.ι ≫ q_k) hRange_W
      have hEt_qlift_comp : AlgebraicGeometry.Etale (q_lift ≫ j_tot) := by
        rw [hqlift_fac]; infer_instance
      have _ : AlgebraicGeometry.Etale q_lift :=
        CategoryTheory.MorphismProperty.of_postcomp (W' := @AlgebraicGeometry.Etale)
          (@AlgebraicGeometry.Etale) q_lift j_tot inferInstance hEt_qlift_comp
      let q_odp : V' ⟶ weilOdpModelSpec m (CommRingCat.of P) Polynomial.X := q_lift ≫ Ψ_odp
      have hEt_qodp : AlgebraicGeometry.Etale q_odp := by dsimp [q_odp]; infer_instance
      have hj_qlift_v₀ : j_tot.base (q_lift.base v₀) = q_k.base v_k := by
        change (q_lift ≫ j_tot).base v₀ = q_k.base v_k
        rw [hqlift_fac]; rfl
      obtain ⟨hX_odp, hC_odp⟩ := hIdeal_Ψ (q_lift.base v₀)
        (fun idx => by rw [hj_qlift_v₀]; exact hvk_X idx)
        (by rw [hj_qlift_v₀]; exact hvk_Ch)
      refine ⟨V', hIsAff_V', v₀, e_Y, hEt_eY, he_Y_v₀,
        Or.inr ⟨q_odp, hEt_qodp, hX_odp, hC_odp, ?_⟩⟩
      calc e_Y ≫ f_bar.left
          = W_aff.ι ≫ (e_Yk ≫ f_bar.left) := Category.assoc _ _ _
        _ = (W_aff.ι ≫ q_k) ≫ π_Rk ≫ e_Bk := by rw [hcomm_k, Category.assoc]
        _ = q_lift ≫ (j_tot ≫ π_Rk) ≫ e_Bk := by rw [← hqlift_fac, Category.assoc, Category.assoc]
        _ = q_lift ≫ π_UA ≫ (j_loc ≫ e_Bk) := by rw [hLeft_tri, Category.assoc]
        _ = q_lift ≫ (π_UA ≫ α) ≫ ι_chart := by rw [← hα_fac, Category.assoc]
        _ = q_odp ≫ π_aff_P ≫ ι_chart := by
            dsimp [q_odp]
            rw [← hSpec_φ₁, ← hRight_tri]
            simp only [Category.assoc]
            rfl
    · obtain ⟨V_F, hz₀_VF, hSm_VF⟩ :=
        hSm_outside z₀ (by rw [hf₀_z₀, hb₀_s]; exact ⟨(⊥ : PrimeSpectrum F), rfl⟩) hz₀_xs
      exact hCloseSmooth V_F hz₀_VF hSm_VF

theorem weil_sing_dev_aff_acyclic_jRbar_away_and_stage_descent (k : Type u) [Field k] (d ℓ : ℕ) (hℓ_pos : 1 ≤ ℓ)
    (M_max : Ideal ↥(integralClosure (Polynomial k)
      (AlgebraicClosure (FractionRing (Polynomial k)))))
    [M_max.IsMaximal]
    (hM : M_max.comap (algebraMap (Polynomial k)
      ↥(integralClosure (Polynomial k) (AlgebraicClosure (FractionRing (Polynomial k))))) =
      Ideal.span {Polynomial.X})
    (hDom : IsDomain (Localization.AtPrime M_max))
    (j_Rbar : AlgebraicGeometry.Spec
      (CommRingCat.of (AlgebraicClosure (FractionRing (Polynomial k)))) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.AtPrime M_max)))
    [AlgebraicGeometry.IsOpenImmersion j_Rbar]
    (hj_eq : j_Rbar ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.AtPrime M_max))) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap (Polynomial k) (AlgebraicClosure (FractionRing (Polynomial k))))))
    (hj_range : Set.range j_Rbar.base =
      (PrimeSpectrum.basicOpen
        (algebraMap (Polynomial k) (Localization.AtPrime M_max) Polynomial.X)).1)
    (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
    (D : ℐ ⥤ CommRingCat.{u})
    (α : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of (Polynomial k)) ⟶ D)
    (c : CategoryTheory.Limits.Cocone D) (hc : CategoryTheory.Limits.IsColimit c)
    (e_pt : c.pt ≅ CommRingCat.of (Localization.AtPrime M_max))
    (hCocone_eq : ∀ i : ℐ,
      (α.app i) ≫ (c.ι.app i) ≫ e_pt.hom =
        CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.AtPrime M_max)))
    (hStage : ∀ i : ℐ,
      ∃ (ϖ : ↑(D.obj i)) (u : (↑(D.obj i))ˣ) (e : ℕ)
        (ψ_i : Polynomial k →+* ↑(D.obj i)),
        1 ≤ e ∧
        ((c.ι.app i) ≫ e_pt.hom).hom ϖ ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime M_max) ∧
        (α.app i).hom Polynomial.X = ↑u * ϖ ^ e ∧
        ψ_i.comp Polynomial.C = (α.app i).hom.comp Polynomial.C ∧
        ψ_i Polynomial.X = ϖ ∧
        ψ_i.Etale ∧
        ∃ (i₁ : ℐ) (θ : i ⟶ i₁) (β : ↑(D.obj i₁))
          (ψ₁ : Polynomial k →+* ↑(D.obj i₁)),
          (D.map θ).hom ϖ = β ^ ℓ ∧
          ψ₁.comp Polynomial.C = (α.app i₁).hom.comp Polynomial.C ∧
          ψ₁ Polynomial.X = β ∧
          ψ₁.Etale) :
    let P := Polynomial k
    let R_bar := Localization.AtPrime M_max
    let S_d := weilAffineSpaceOver k d
    let A1_k := AlgebraicGeometry.Spec (CommRingCat.of P)
    let Gm_k := AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (Polynomial.X : P)))
    let j_Gm : Gm_k ⟶ A1_k := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap P (Localization.Away (Polynomial.X : P))))
    let κ_A1 : A1_k ⟶ A1_k := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Polynomial.aeval ((Polynomial.X : P) ^ ℓ)).toRingHom))
    let p_A1 : A1_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* P))
    let Y_d := CategoryTheory.Limits.pullback S_d.hom p_A1
    let U_d := CategoryTheory.Limits.pullback j_Gm
      (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
    let j_d : U_d ⟶ Y_d :=
      CategoryTheory.Limits.pullback.snd j_Gm
        (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
    let g_k_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap P R_bar).comp Polynomial.C))
    let A_R := CategoryTheory.Limits.pullback S_d.hom g_k_R
    let A_Ω := CategoryTheory.Limits.pullback j_Rbar
      (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
    let j_Ad : A_Ω ⟶ A_R :=
      CategoryTheory.Limits.pullback.snd j_Rbar
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
    ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
      (w : W ⟶ A_R) [AlgebraicGeometry.Etale w],
      ∃ (𝒥 : Type u) (_ : CategoryTheory.SmallCategory 𝒥) (_ : CategoryTheory.IsFiltered 𝒥)
        (E_diag E_loc : 𝒥 ⥤ CommRingCat.{u})
        (ι_loc : E_diag ⟶ E_loc)
        (c_E : CategoryTheory.Limits.Cocone E_diag) (_ : CategoryTheory.Limits.IsColimit c_E)
        (c_Eloc : CategoryTheory.Limits.Cocone E_loc) (_ : CategoryTheory.Limits.IsColimit c_Eloc)
        (ι_inf : c_E.pt ⟶ c_Eloc.pt)
        (e_W : AlgebraicGeometry.Spec c_E.pt ≅ W)
        (e_WU : AlgebraicGeometry.Spec c_Eloc.pt ≅ CategoryTheory.Limits.pullback j_Ad w),
        (∀ j : 𝒥, c_E.ι.app j ≫ ι_inf = ι_loc.app j ≫ c_Eloc.ι.app j) ∧
        e_WU.hom ≫ CategoryTheory.Limits.pullback.snd j_Ad w =
          AlgebraicGeometry.Spec.map ι_inf ≫ e_W.hom ∧
        ∀ j : 𝒥,
          ∃ (w_j : AlgebraicGeometry.Spec (E_diag.obj j) ⟶ Y_d)
            (_ : AlgebraicGeometry.Etale w_j)
            (ϕ_j : AlgebraicGeometry.Spec (E_loc.obj j) ≅
              CategoryTheory.Limits.pullback j_d w_j),
            ϕ_j.hom ≫ CategoryTheory.Limits.pullback.snd j_d w_j =
              AlgebraicGeometry.Spec.map (ι_loc.app j) ∧
            ∃ (j₁ : 𝒥) (θ_U : j ⟶ j₁)
              (w₁ : AlgebraicGeometry.Spec (E_diag.obj j₁) ⟶ Y_d)
              (_ : AlgebraicGeometry.Etale w₁)
              (ϕ₁ : AlgebraicGeometry.Spec (E_loc.obj j₁) ≅
                CategoryTheory.Limits.pullback j_d w₁),
              ϕ₁.hom ≫ CategoryTheory.Limits.pullback.snd j_d w₁ =
                AlgebraicGeometry.Spec.map (ι_loc.app j₁) ∧
              let π_W : AlgebraicGeometry.Spec (E_diag.obj j₁) ⟶
                  AlgebraicGeometry.Spec (E_diag.obj j) :=
                AlgebraicGeometry.Spec.map (E_diag.map θ_U)
              let π_WU : CategoryTheory.Limits.pullback j_d w₁ ⟶
                  CategoryTheory.Limits.pullback j_d w_j :=
                ϕ₁.inv ≫ AlgebraicGeometry.Spec.map (E_loc.map θ_U) ≫ ϕ_j.hom
              π_W ≫ w_j ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
                w₁ ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 ∧
              π_W ≫ w_j ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
                w₁ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 ≫ κ_A1 ∧
              π_WU ≫ CategoryTheory.Limits.pullback.snd j_d w_j =
                CategoryTheory.Limits.pullback.snd j_d w₁ ≫ π_W :=
by
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  have hOpenImmersionAway : ∀ (R S : Type u) [CommRing R] [CommRing S] (t : R)
      (j : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      [AlgebraicGeometry.IsOpenImmersion j],
      Set.range j.base = (PrimeSpectrum.basicOpen t).1 →
      let ψ : R →+* S := (AlgebraicGeometry.Spec.preimage j).hom
      @IsLocalization.Away R _ t S _ ψ.toAlgebra ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) = j := by
    intro R S _ _ t j _ hj_rng ψ
    let R_away := Localization.Away t
    let φ_can : R →+* R_away := algebraMap R R_away
    let j_can : AlgebraicGeometry.Spec (CommRingCat.of R_away) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_can)
    have h_coe_can : (⇑j_can : ↥(AlgebraicGeometry.Spec (CommRingCat.of R_away)) →
        ↥(AlgebraicGeometry.Spec (CommRingCat.of R))) = PrimeSpectrum.comap φ_can := by
      funext x
      exact AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom φ_can) x
    have hrange_can : Set.range ⇑j_can = (PrimeSpectrum.basicOpen t).1 := by
      rw [h_coe_can]
      exact PrimeSpectrum.localization_away_comap_range R_away t
    have hrange : Set.range ⇑j = Set.range ⇑j_can :=
      hj_rng.trans hrange_can.symm
    let e_U : AlgebraicGeometry.Spec (CommRingCat.of S) ≅
        AlgebraicGeometry.Spec (CommRingCat.of R_away) :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq j j_can hrange
    have he_fac : e_U.hom ≫ j_can = j :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac j j_can hrange
    let e_ring : CommRingCat.of R_away ≅ CommRingCat.of S :=
      { hom := AlgebraicGeometry.Spec.preimage e_U.hom
        inv := AlgebraicGeometry.Spec.preimage e_U.inv
        hom_inv_id := (AlgebraicGeometry.Spec.preimage_comp e_U.inv e_U.hom).symm.trans
          ((congrArg AlgebraicGeometry.Spec.preimage e_U.inv_hom_id).trans
            AlgebraicGeometry.Spec.preimage_id)
        inv_hom_id := (AlgebraicGeometry.Spec.preimage_comp e_U.hom e_U.inv).symm.trans
          ((congrArg AlgebraicGeometry.Spec.preimage e_U.hom_inv_id).trans
            AlgebraicGeometry.Spec.preimage_id) }
    let τ : R_away ≃+* S := e_ring.commRingCatIsoToRingEquiv
    have h_pre_eq : AlgebraicGeometry.Spec.preimage j =
        CommRingCat.ofHom φ_can ≫ e_ring.hom := by
      rw [← he_fac, AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map]
    have hψ_eq : ψ = τ.toRingHom.comp φ_can := by
      have h1 := congrArg CommRingCat.Hom.hom h_pre_eq
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at h1
      exact h1.trans (congrArg (fun f : R_away →+* S => f.comp φ_can)
        (CategoryTheory.Iso.commRingCatIsoToRingEquiv_toRingHom e_ring).symm)
    refine ⟨?_, ?_⟩
    · let _ : Algebra R S := ψ.toAlgebra
      have hcomm : ∀ r : R, τ (algebraMap R R_away r) = algebraMap R S r := by
        intro r
        change τ.toRingHom (φ_can r) = ψ r
        rw [hψ_eq]
        rfl
      let τ_alg : R_away ≃ₐ[R] S := AlgEquiv.ofRingEquiv (f := τ) hcomm
      exact @IsLocalization.isLocalization_of_algEquiv R _ (Submonoid.powers t)
        R_away _ _ S _ ψ.toAlgebra _ τ_alg
    · change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (AlgebraicGeometry.Spec.preimage j).hom) = j
      rw [CommRingCat.ofHom_hom, AlgebraicGeometry.Spec.map_preimage]

  have hα_nat_apply : ∀ {i i' : ℐ} (θ : i ⟶ i') (p : Polynomial k),
      (D.map θ).hom ((α.app i).hom p) = (α.app i').hom p := by
    intro i i' θ p
    have h := (Category.id_comp (α.app i')).symm.trans (α.naturality θ)
    exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h) p).symm

  have hEtalePresDescent :
      ∀ (B_diag : ℐ ⥤ CommRingCat.{u})
        (c_B : CategoryTheory.Limits.Cocone B_diag)
        (_ : CategoryTheory.Limits.IsColimit c_B)
        (E_inf : CommRingCat.{u}) (f_E : c_B.pt ⟶ E_inf),
        f_E.hom.Etale →
        ∃ (i₀ : ℐ) (n : ℕ) (J₀ : Ideal (MvPolynomial (Fin n) ↑(B_diag.obj i₀)))
          (g₀ : CommRingCat.of (MvPolynomial (Fin n) ↑(B_diag.obj i₀) ⧸ J₀) ⟶ E_inf),
          (CommRingCat.ofHom ((Ideal.Quotient.mk J₀).comp MvPolynomial.C) :
            B_diag.obj i₀ ⟶ CommRingCat.of (MvPolynomial (Fin n) ↑(B_diag.obj i₀) ⧸ J₀)).hom.Etale ∧
          CategoryTheory.IsPushout (c_B.ι.app i₀)
            (CommRingCat.ofHom ((Ideal.Quotient.mk J₀).comp MvPolynomial.C)) f_E g₀ := by
    classical
    intro B_diag c_B hc_B E_inf f_E hf_E
    let F_fgt := CategoryTheory.forget CommRingCat.{u}
    let hc_type : CategoryTheory.Limits.IsColimit (F_fgt.mapCocone c_B) :=
      CategoryTheory.Limits.isColimitOfPreserves F_fgt hc_B
    have hNonemptyℐ : Nonempty ℐ := CategoryTheory.IsFiltered.nonempty
    have hLiftSet₀ : ∀ {α₀ : Type} (S : Finset α₀) (x : α₀ → ↑c_B.pt),
        ∃ (i : ℐ) (y : α₀ → ↑(B_diag.obj i)),
          ∀ a ∈ S, (CommRingCat.Hom.hom (c_B.ι.app i)) (y a) = x a := by
      intro α₀ S x
      induction S using Finset.induction_on with
      | empty =>
        obtain ⟨i₀⟩ := hNonemptyℐ
        exact ⟨i₀, fun _ => 0, fun _ h => False.elim (Finset.notMem_empty _ h)⟩
      | insert a₀ S' ha₀ ih =>
        obtain ⟨i₁, y₁, hy₁⟩ := ih
        obtain ⟨i₂, z, hz⟩ :=
          CategoryTheory.Limits.Types.jointly_surjective (B_diag ⋙ F_fgt) hc_type (x a₀)
        have hz' : (CommRingCat.Hom.hom (c_B.ι.app i₂)) z = x a₀ := hz
        let i₃ := CategoryTheory.IsFiltered.max i₁ i₂
        let u₁ : i₁ ⟶ i₃ := CategoryTheory.IsFiltered.leftToMax i₁ i₂
        let u₂ : i₂ ⟶ i₃ := CategoryTheory.IsFiltered.rightToMax i₁ i₂
        refine ⟨i₃, fun a => if a = a₀ then (CommRingCat.Hom.hom (B_diag.map u₂)) z
            else (CommRingCat.Hom.hom (B_diag.map u₁)) (y₁ a), ?_⟩
        intro a ha
        rcases Finset.mem_insert.mp ha with rfl | haS'
        · simp only [↓reduceIte]
          have hw₂ := congrArg (fun fn => (CommRingCat.Hom.hom fn) z) (c_B.w u₂)
          exact hw₂.trans hz'
        · have hne : a ≠ a₀ := fun h => ha₀ (h ▸ haS')
          simp only [hne, ↓reduceIte]
          have hw₁ := congrArg (fun fn => (CommRingCat.Hom.hom fn) (y₁ a)) (c_B.w u₁)
          exact hw₁.trans (hy₁ a haS')
    have hZeroSet₀ : ∀ {α₀ : Type} (S : Finset α₀) (i₁ : ℐ) (y : α₀ → ↑(B_diag.obj i₁)),
        (∀ a ∈ S, (CommRingCat.Hom.hom (c_B.ι.app i₁)) (y a) = 0) →
        ∃ (i₀ : ℐ) (θ : i₁ ⟶ i₀), ∀ a ∈ S, (CommRingCat.Hom.hom (B_diag.map θ)) (y a) = 0 := by
      intro α₀ S i₁ y hy
      induction S using Finset.induction_on with
      | empty =>
        exact ⟨i₁, 𝟙 i₁, fun _ h => False.elim (Finset.notMem_empty _ h)⟩
      | insert a₀ S' _ ih =>
        obtain ⟨i₂, θ₁, hθ₁⟩ := ih (fun a ha => hy a (Finset.mem_insert_of_mem ha))
        have h_eq₀ : (CategoryTheory.ConcreteCategory.hom ((F_fgt.mapCocone c_B).ι.app i₂))
            ((CommRingCat.Hom.hom (B_diag.map θ₁)) (y a₀)) =
          (CategoryTheory.ConcreteCategory.hom ((F_fgt.mapCocone c_B).ι.app i₂)) (0 : ↑(B_diag.obj i₂)) := by
          change (CommRingCat.Hom.hom (c_B.ι.app i₂)) ((CommRingCat.Hom.hom (B_diag.map θ₁)) (y a₀)) =
            (CommRingCat.Hom.hom (c_B.ι.app i₂)) 0
          rw [map_zero]
          have hw := congrArg (fun fn => (CommRingCat.Hom.hom fn) (y a₀)) (c_B.w θ₁)
          exact hw.trans (hy a₀ (Finset.mem_insert_self a₀ S'))
        obtain ⟨i₀, θ₂, hθ₂⟩ :=
          (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff' hc_type _ _).mp h_eq₀
        have hθ₂' : (CommRingCat.Hom.hom (B_diag.map θ₂)) ((CommRingCat.Hom.hom (B_diag.map θ₁)) (y a₀)) = 0 := by
          have h₁ : (CommRingCat.Hom.hom (B_diag.map θ₂)) ((CommRingCat.Hom.hom (B_diag.map θ₁)) (y a₀)) =
              (CommRingCat.Hom.hom (B_diag.map θ₂)) 0 := hθ₂
          rwa [map_zero] at h₁
        refine ⟨i₀, θ₁ ≫ θ₂, ?_⟩
        intro a ha
        rw [Functor.map_comp, CommRingCat.hom_comp, RingHom.comp_apply]
        rcases Finset.mem_insert.mp ha with rfl | haS'
        · exact hθ₂'
        · rw [hθ₁ a haS', map_zero]
    have hLiftPoly : ∀ {n : ℕ} (p : MvPolynomial (Fin n) ↑c_B.pt),
        ∃ (i : ℐ) (p_lift : MvPolynomial (Fin n) ↑(B_diag.obj i)),
          MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i)) p_lift = p := by
      intro n p
      obtain ⟨i, y, hy⟩ := hLiftSet₀ p.support (fun m => p.coeff m)
      refine ⟨i, ∑ m ∈ p.support, MvPolynomial.monomial m (y m), ?_⟩
      ext m
      rw [MvPolynomial.coeff_map, MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_monomial]
      by_cases hm : m ∈ p.support
      · rw [Finset.sum_eq_single m
          (fun x _ hxm => by simp only [hxm, ↓reduceIte])
          (fun h => absurd hm h)]
        simp only [↓reduceIte]
        exact hy m hm
      · have hsum0 : (∑ x ∈ p.support, if x = m then y x else 0) = 0 := by
          refine Finset.sum_eq_zero fun x hx => ?_
          have hxm : x ≠ m := fun h => hm (h ▸ hx)
          simp only [hxm, ↓reduceIte]
        rw [hsum0, map_zero, MvPolynomial.notMem_support_iff.mp hm]
    have hLiftPolyFam : ∀ {n r : ℕ} (F : Fin r → MvPolynomial (Fin n) ↑c_B.pt),
        ∃ (i : ℐ) (F_lift : Fin r → MvPolynomial (Fin n) ↑(B_diag.obj i)),
          ∀ s : Fin r, MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i)) (F_lift s) = F s := by
      intro n r F
      suffices ∀ (T : Finset (Fin r)),
          ∃ (i : ℐ) (F_lift : Fin r → MvPolynomial (Fin n) ↑(B_diag.obj i)),
            ∀ s ∈ T, MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i)) (F_lift s) = F s by
        obtain ⟨i, F_lift, hF⟩ := this Finset.univ
        exact ⟨i, F_lift, fun s => hF s (Finset.mem_univ s)⟩
      intro T
      induction T using Finset.induction_on with
      | empty =>
        obtain ⟨i₀⟩ := hNonemptyℐ
        exact ⟨i₀, fun _ => 0, fun _ h => False.elim (Finset.notMem_empty _ h)⟩
      | insert s₀ T' hs₀ ih =>
        obtain ⟨i₁, F₁, hF₁⟩ := ih
        obtain ⟨i₂, p₂, hp₂⟩ := hLiftPoly (F s₀)
        let i₃ := CategoryTheory.IsFiltered.max i₁ i₂
        let u₁ : i₁ ⟶ i₃ := CategoryTheory.IsFiltered.leftToMax i₁ i₂
        let u₂ : i₂ ⟶ i₃ := CategoryTheory.IsFiltered.rightToMax i₁ i₂
        refine ⟨i₃, fun s => if s = s₀ then MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map u₂)) p₂
            else MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map u₁)) (F₁ s), ?_⟩
        intro s hs
        rcases Finset.mem_insert.mp hs with rfl | hsT'
        · simp only [↓reduceIte, MvPolynomial.map_map]
          have hw₂ : (CommRingCat.Hom.hom (c_B.ι.app i₃)).comp (CommRingCat.Hom.hom (B_diag.map u₂)) =
              CommRingCat.Hom.hom (c_B.ι.app i₂) := by
            rw [← CommRingCat.hom_comp, c_B.w u₂]
          rw [hw₂, hp₂]
        · have hne : s ≠ s₀ := fun h => hs₀ (h ▸ hsT')
          simp only [hne, ↓reduceIte, MvPolynomial.map_map]
          have hw₁ : (CommRingCat.Hom.hom (c_B.ι.app i₃)).comp (CommRingCat.Hom.hom (B_diag.map u₁)) =
              CommRingCat.Hom.hom (c_B.ι.app i₁) := by
            rw [← CommRingCat.hom_comp, c_B.w u₁]
          rw [hw₁, hF₁ s hsT']
    let _ : Algebra ↑c_B.pt ↑E_inf := (CommRingCat.Hom.hom f_E).toAlgebra
    have halg_fE : algebraMap (↑c_B.pt) (↑E_inf) = CommRingCat.Hom.hom f_E := rfl
    have hEt_inf : Algebra.Etale (↑c_B.pt) (↑E_inf) := by
      rw [← RingHom.etale_algebraMap, halg_fE]
      exact hf_E
    have hStd_inf : Algebra.IsStandardSmoothOfRelativeDimension 0 (↑c_B.pt) (↑E_inf) :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hEt_inf
    obtain ⟨ι_v, σ_v, hFin_σ, hFin_ι, P_pres, hdim⟩ := hStd_inf.out
    let n : ℕ := Nat.card ι_v
    let r : ℕ := Nat.card σ_v
    let e_ι : Fin n ≃ ι_v := (Finite.equivFin ι_v).symm
    let e_σ : Fin r ≃ σ_v := (Finite.equivFin σ_v).symm
    let P₀ : Algebra.SubmersivePresentation (↑c_B.pt) (↑E_inf) (Fin n) (Fin r) :=
      P_pres.reindex e_ι e_σ
    have hdim₀ : P₀.dimension = 0 := by
      rw [← hdim]
      exact P_pres.toPresentation.dimension_reindex e_ι e_σ
    let R_inf : Fin r → MvPolynomial (Fin n) ↑c_B.pt := P₀.relation
    let g_inf : Fin r → MvPolynomial (Fin n) ↑c_B.pt := P₀.jacobianRelations
    let h_inf : MvPolynomial (Fin n) ↑c_B.pt := P₀.σ ↑(P₀.jacobian_isUnit.unit⁻¹)
    have hBezout_inf : ∑ s : Fin r, g_inf s * R_inf s = P₀.jacobiMatrix.det * h_inf - 1 :=
      P₀.jacobianRelations_spec
    obtain ⟨i_R, R_lift_R, hR_lift_R⟩ := hLiftPolyFam R_inf
    obtain ⟨i_g, g_lift_g, hg_lift_g⟩ := hLiftPolyFam g_inf
    obtain ⟨i_h, h_lift_h, hh_lift_h⟩ := hLiftPoly h_inf
    let i_Rg := CategoryTheory.IsFiltered.max i_R i_g
    let u_R : i_R ⟶ i_Rg := CategoryTheory.IsFiltered.leftToMax i_R i_g
    let u_g : i_g ⟶ i_Rg := CategoryTheory.IsFiltered.rightToMax i_R i_g
    let i₁ := CategoryTheory.IsFiltered.max i_Rg i_h
    let u_Rg : i_Rg ⟶ i₁ := CategoryTheory.IsFiltered.leftToMax i_Rg i_h
    let u_h : i_h ⟶ i₁ := CategoryTheory.IsFiltered.rightToMax i_Rg i_h
    let R_tilde : Fin r → MvPolynomial (Fin n) ↑(B_diag.obj i₁) :=
      fun s => MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map (u_R ≫ u_Rg))) (R_lift_R s)
    let g_tilde : Fin r → MvPolynomial (Fin n) ↑(B_diag.obj i₁) :=
      fun s => MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map (u_g ≫ u_Rg))) (g_lift_g s)
    let h_tilde : MvPolynomial (Fin n) ↑(B_diag.obj i₁) :=
      MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map u_h)) h_lift_h
    have hR_tilde : ∀ s : Fin r,
        MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₁)) (R_tilde s) = R_inf s := by
      intro s
      dsimp [R_tilde]
      rw [MvPolynomial.map_map, ← CommRingCat.hom_comp, c_B.w (u_R ≫ u_Rg), hR_lift_R s]
    have hg_tilde : ∀ s : Fin r,
        MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₁)) (g_tilde s) = g_inf s := by
      intro s
      dsimp [g_tilde]
      rw [MvPolynomial.map_map, ← CommRingCat.hom_comp, c_B.w (u_g ≫ u_Rg), hg_lift_g s]
    have hh_tilde :
        MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₁)) h_tilde = h_inf := by
      dsimp [h_tilde]
      rw [MvPolynomial.map_map, ← CommRingCat.hom_comp, c_B.w u_h, hh_lift_h]
    let J_mat₁ : Matrix (Fin r) (Fin r) (MvPolynomial (Fin n) ↑(B_diag.obj i₁)) :=
      fun s₁ s₂ => MvPolynomial.pderiv (P₀.map s₁) (R_tilde s₂)
    have hJ_mat₁_map :
