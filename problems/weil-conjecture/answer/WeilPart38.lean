by
  classical
  let _ := hθ_bij
  let V : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of S)
  let π : V ⟶ U :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S)) ≫ e_U.hom
  let A : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin N → Λ))
  let C_V : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u} :=
    (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A
  let FgtU := AlgebraicGeometry.Scheme.Etale.forget U
  let FgtV := AlgebraicGeometry.Scheme.Etale.forget V
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  
  let s_mor : (S ≃ₐ[R] S) → (V ⟶ V) :=
    fun σ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)
  have hs_π : ∀ σ : S ≃ₐ[R] S, s_mor σ ≫ π = π := by
    intro σ
    dsimp only [s_mor, π]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    have hcomm : CommRingCat.ofHom (algebraMap R S) ≫ CommRingCat.ofHom σ.symm.toRingHom =
        CommRingCat.ofHom (algebraMap R S) :=
      CommRingCat.hom_ext (RingHom.ext σ.symm.commutes)
    rw [hcomm]
  let m_can : ∀ {X : AlgebraicGeometry.Scheme.{u}} (h : X ⟶ U) (σ : S ≃ₐ[R] S),
      CategoryTheory.Limits.pullback h π ⟶ CategoryTheory.Limits.pullback h π :=
    fun {X} h σ =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst h π)
        (CategoryTheory.Limits.pullback.snd h π ≫ s_mor σ)
        (by rw [CategoryTheory.Category.assoc, hs_π σ, CategoryTheory.Limits.pullback.condition])
  have hm_can_eq : ∀ {X : AlgebraicGeometry.Scheme.{u}} (h : X ⟶ U) (σ : S ≃ₐ[R] S)
      (m : CategoryTheory.Limits.pullback h π ⟶ CategoryTheory.Limits.pullback h π),
      m ≫ CategoryTheory.Limits.pullback.fst h π = CategoryTheory.Limits.pullback.fst h π →
      m ≫ CategoryTheory.Limits.pullback.snd h π =
        CategoryTheory.Limits.pullback.snd h π ≫ s_mor σ →
      m = m_can h σ := by
    intro X h σ m hfst hsnd
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [hfst, CategoryTheory.Limits.pullback.lift_fst]
    · rw [hsnd, CategoryTheory.Limits.pullback.lift_snd]

  let u_can : ∀ {W₁ W₂ : U.Etale} (u : W₁ ⟶ W₂),
      CategoryTheory.Limits.pullback (FgtU.obj W₁).hom π ⟶
        CategoryTheory.Limits.pullback (FgtU.obj W₂).hom π :=
    fun {W₁ W₂} u =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (FgtU.obj W₁).hom π ≫ (FgtU.map u).left)
        (CategoryTheory.Limits.pullback.snd (FgtU.obj W₁).hom π)
        (by rw [CategoryTheory.Category.assoc, (FgtU.map u).w,
              CategoryTheory.Limits.pullback.condition])
  have hu_can_fst : ∀ {W₁ W₂ : U.Etale} (u : W₁ ⟶ W₂),
      u_can u ≫ CategoryTheory.Limits.pullback.fst (FgtU.obj W₂).hom π =
        CategoryTheory.Limits.pullback.fst (FgtU.obj W₁).hom π ≫ (FgtU.map u).left :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hu_can_snd : ∀ {W₁ W₂ : U.Etale} (u : W₁ ⟶ W₂),
      u_can u ≫ CategoryTheory.Limits.pullback.snd (FgtU.obj W₂).hom π =
        CategoryTheory.Limits.pullback.snd (FgtU.obj W₁).hom π :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hu_can_eq : ∀ {W₁ W₂ : U.Etale} (u : W₁ ⟶ W₂)
      (u_V : CategoryTheory.Limits.pullback (FgtU.obj W₁).hom π ⟶
        CategoryTheory.Limits.pullback (FgtU.obj W₂).hom π),
      u_V ≫ CategoryTheory.Limits.pullback.fst (FgtU.obj W₂).hom π =
        CategoryTheory.Limits.pullback.fst (FgtU.obj W₁).hom π ≫ (FgtU.map u).left →
      u_V ≫ CategoryTheory.Limits.pullback.snd (FgtU.obj W₂).hom π =
        CategoryTheory.Limits.pullback.snd (FgtU.obj W₁).hom π →
      u_V = u_can u := by
    intro W₁ W₂ u u_V hfst hsnd
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [hfst, CategoryTheory.Limits.pullback.lift_fst]
    · rw [hsnd, CategoryTheory.Limits.pullback.lift_snd]
  have hu_can_id : ∀ W : U.Etale, u_can (𝟙 W) = 𝟙 _ := by
    intro W
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
      have hid : (FgtU.map (𝟙 W)).left = 𝟙 _ := by rw [FgtU.map_id]; rfl
      rw [hid, CategoryTheory.Category.comp_id]
    · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
  have hu_can_comp : ∀ {W₁ W₂ W₃ : U.Etale} (u₁ : W₁ ⟶ W₂) (u₂ : W₂ ⟶ W₃),
      u_can (u₁ ≫ u₂) = u_can u₁ ≫ u_can u₂ := by
    intro W₁ W₂ W₃ u₁ u₂
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc]
      have hcomp : (FgtU.map (u₁ ≫ u₂)).left = (FgtU.map u₁).left ≫ (FgtU.map u₂).left := by
        rw [FgtU.map_comp]; rfl
      rw [hcomp]
    · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]
  have hm_u_comm : ∀ {W₁ W₂ : U.Etale} (u : W₁ ⟶ W₂) (σ : S ≃ₐ[R] S),
