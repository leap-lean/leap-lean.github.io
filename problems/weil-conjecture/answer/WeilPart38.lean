      have hEx_R1 : SC_R1.Exact := by
        rw [ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero]
        have hEx_v := (ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero
