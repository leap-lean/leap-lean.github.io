theorem weil_outer_tr_fib_abelian_four_term_cd1_shift {𝒞 : Type u₁} [CategoryTheory.Category.{v₁, u₁} 𝒞] [CategoryTheory.Abelian 𝒞]
    [CategoryTheory.HasExt.{w} 𝒞]
    {A J B C : 𝒞}
    (f₀ : A ⟶ J) (g₀ : J ⟶ B) (d₀ : B ⟶ C)
    [CategoryTheory.Mono f₀] [CategoryTheory.Epi d₀] [CategoryTheory.Injective J]
    (hfg : f₀ ≫ g₀ = 0) (hgd : g₀ ≫ d₀ = 0)
    (hEx₁ : (CategoryTheory.ShortComplex.mk f₀ g₀ hfg).Exact)
    (hEx₂ : (CategoryTheory.ShortComplex.mk g₀ d₀ hgd).Exact)
    (X₀ : 𝒞) :
    (Subsingleton (CategoryTheory.Abelian.Ext X₀ A 2) →
      Function.Surjective ((CategoryTheory.Abelian.Ext.mk₀ d₀).postcomp X₀ (Nat.add_zero 0))) ∧
    (∀ (t : ℕ), 1 < t →
      Subsingleton (CategoryTheory.Abelian.Ext X₀ A (t + 1)) →
      Subsingleton (CategoryTheory.Abelian.Ext X₀ C t) →
      Subsingleton (CategoryTheory.Abelian.Ext X₀ B t)) :=
by
  let M : 𝒞 := CategoryTheory.Limits.cokernel f₀
  let π_M : J ⟶ M := CategoryTheory.Limits.cokernel.π f₀
  let S_A := CategoryTheory.ShortComplex.mk f₀ π_M (CategoryTheory.Limits.cokernel.condition f₀)
  have hSE_A : S_A.ShortExact :=
    CategoryTheory.ShortComplex.ShortExact.mk'
      (CategoryTheory.ShortComplex.exact_cokernel f₀) inferInstance inferInstance
  let i_M : M ⟶ B := CategoryTheory.Limits.cokernel.desc f₀ g₀ hfg
  have hMono_iM : CategoryTheory.Mono i_M :=
    (CategoryTheory.ShortComplex.exact_iff_mono_cokernel_desc
      (CategoryTheory.ShortComplex.mk f₀ g₀ hfg)).mp hEx₁
  have hid : i_M ≫ d₀ = 0 := by
    apply (CategoryTheory.cancel_epi π_M).mp
    rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.π_desc, hgd,
      CategoryTheory.Limits.comp_zero]
  let S₂ := CategoryTheory.ShortComplex.mk g₀ d₀ hgd
  let S_B := CategoryTheory.ShortComplex.mk i_M d₀ hid
  let Φ : S₂ ⟶ S_B :=
    { τ₁ := π_M
      τ₂ := CategoryTheory.CategoryStruct.id B
      τ₃ := CategoryTheory.CategoryStruct.id C
      comm₁₂ := (CategoryTheory.Limits.cokernel.π_desc f₀ g₀ hfg).trans
        (CategoryTheory.Category.comp_id g₀).symm
      comm₂₃ := (CategoryTheory.Category.id_comp d₀).trans
        (CategoryTheory.Category.comp_id d₀).symm }
  have : CategoryTheory.Epi Φ.τ₁ := by dsimp [Φ]; infer_instance
  have : CategoryTheory.IsIso Φ.τ₂ := by dsimp [Φ]; infer_instance
  have : CategoryTheory.Mono Φ.τ₃ := by dsimp [Φ]; infer_instance
  have hEx_B : S_B.Exact :=
    (CategoryTheory.ShortComplex.exact_iff_of_epi_of_isIso_of_mono Φ).mp hEx₂
  have hSE_B : S_B.ShortExact :=
    CategoryTheory.ShortComplex.ShortExact.mk' hEx_B hMono_iM inferInstance
  have hSubM : ∀ (k : ℕ),
      Subsingleton (CategoryTheory.Abelian.Ext X₀ A (k + 2)) →
      Subsingleton (CategoryTheory.Abelian.Ext X₀ M (k + 1)) := by
    intro k hSubA
    refine subsingleton_of_forall_eq 0 fun x => ?_
    have hx0 : x.comp hSE_A.extClass (rfl : (k + 1) + 1 = k + 2) = 0 :=
      @Subsingleton.elim _ hSubA _ 0
    obtain ⟨y, hy⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ X₀ hSE_A x
        (rfl : (k + 1) + 1 = k + 2) hx0
    have hy0 : y = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective y
    rw [← hy, hy0, CategoryTheory.Abelian.Ext.zero_comp]
  refine ⟨?_, ?_⟩
  · intro hSubA2 c
    have hSubM1 : Subsingleton (CategoryTheory.Abelian.Ext X₀ M 1) := hSubM 0 hSubA2
    have hc0 : c.comp hSE_B.extClass (Nat.zero_add 1) = 0 :=
      @Subsingleton.elim _ hSubM1 _ 0
    exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ X₀ hSE_B c (Nat.zero_add 1) hc0
  · intro t ht hSubAt1 hSubCt
    obtain ⟨k, rfl⟩ : ∃ k : ℕ, t = k + 1 := ⟨t - 1, (Nat.sub_add_cancel (by omega)).symm⟩
    have hSubMt : Subsingleton (CategoryTheory.Abelian.Ext X₀ M (k + 1)) := hSubM k hSubAt1
    refine subsingleton_of_forall_eq 0 fun b => ?_
    have hb0 : b.comp (CategoryTheory.Abelian.Ext.mk₀ d₀) (Nat.add_zero (k + 1)) = 0 :=
      @Subsingleton.elim _ hSubCt _ 0
    obtain ⟨x₁, hx₁⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ X₀ hSE_B b hb0
    have hx₁0 : x₁ = 0 := @Subsingleton.elim _ hSubMt _ 0
    rw [← hx₁, hx₁0, CategoryTheory.Abelian.Ext.zero_comp]

theorem weil_outer_tr_fib_leray_syzygy_edge_surjective {V U : AlgebraicGeometry.Scheme.{u}} (g : V ⟶ U)
    [_hCont : (weilEtaleSitePullback g).IsContinuous U.smallEtaleTopology V.smallEtaleTopology]
    [_hAdj : ((weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
      U.smallEtaleTopology V.smallEtaleTopology).IsRightAdjoint]
    [_hLim : CategoryTheory.Limits.PreservesFiniteLimits
      ((weilEtaleSitePullback g).sheafPullback AddCommGrpCat.{u}
        U.smallEtaleTopology V.smallEtaleTopology)]
    (T_U : U.Etale) (_hT_U : CategoryTheory.Limits.IsTerminal T_U)
    (hT_V : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback g).obj T_U))
    (n : ℕ)
    (ℱ : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u})
    (hcd1 : ∀ q < n, ∀ t : ℕ, 1 < t → Subsingleton ((weilEtaleHigherDirectImage g q ℱ).H t)) :
    Function.Surjective (weilOuterTrFibEdgeHom g T_U hT_V ℱ n) :=
by
  have hSubIso : ∀ {X₁ X₂ : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}}
      (e : X₁ ≅ X₂) (t : ℕ), Subsingleton (X₂.H t) → Subsingleton (X₁.H t) := by
    intro X₁ X₂ e t hSub
    refine subsingleton_of_forall_eq 0 fun x => ?_
    have hx : x.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero t) = 0 :=
      @Subsingleton.elim _ hSub _ 0
    calc
      x = x.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 X₁)) (Nat.add_zero t) :=
            (CategoryTheory.Abelian.Ext.comp_mk₀_id x).symm
      _ = x.comp (CategoryTheory.Abelian.Ext.mk₀ (e.hom ≫ e.inv)) (Nat.add_zero t) := by
            rw [e.hom_inv_id]
