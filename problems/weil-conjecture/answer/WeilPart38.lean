      intro ℋ hZ_η₀ K _ _ y hy_gen
      have hPb_η₀ : WeilIsEtaleSheafPullback η₀ ℋ (P_η₀.obj ℋ) :=
        ⟨hc_η₀, hr_η₀, ⟨CategoryTheory.Iso.refl _⟩⟩
      obtain ⟨H_y, hPb_Hy, _, _⟩ := hPbEx y ℋ
      obtain ⟨K₃, hFld₃, hAlg₃, p₁, p₂, hp12⟩ :=
