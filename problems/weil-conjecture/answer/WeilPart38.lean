        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hα'
    have hg_comp : g₁ ≫ SC.f = g₂ ≫ SC.f := by
      have hEq := congrArg CategoryTheory.Abelian.Ext.addEquiv₀ hmk
      rwa [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
        ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
        AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply] at hEq
    have hg_eq : g₁ = g₂ := (CategoryTheory.cancel_mono SC.f).mp hg_comp
    rw [hα₁, hα₂, hg_eq]
