    have hη_res : η_Y ≫ pf_jY.map Φ_YΩ.hom = Φ_Y.hom ≫ res_lc := by
      apply (adj_Y.homEquiv A (pf_jY.obj S_YΩ)).injective
      have hlhs : adj_Y.homEquiv A (pf_jY.obj S_YΩ) (η_Y ≫ pf_jY.map Φ_YΩ.hom) =
