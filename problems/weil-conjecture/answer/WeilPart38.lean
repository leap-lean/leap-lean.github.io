  have hMorEt : ∀ {X : AlgebraicGeometry.Scheme.{u}} {Y₁ Y₂ : X.Etale} (u : Y₁ ⟶ Y₂),
      AlgebraicGeometry.Etale u.left := by
    clear * -
    intro X Y₁ Y₂ u
    have hw : u.left ≫ Y₂.hom = Y₁.hom := MorphismProperty.Over.w u
    have _ : AlgebraicGeometry.Etale (u.left ≫ Y₂.hom) := hw.symm ▸ Y₁.prop
    have _ : AlgebraicGeometry.Etale Y₂.hom := Y₂.prop
    exact AlgebraicGeometry.Etale.of_comp u.left Y₂.hom

  
  have hSlicePkg :
      ∃ (resEtale : ∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X},
          AlgebraicGeometry.Etale w →
          Functor (Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
            (Sheaf V.smallEtaleTopology AddCommGrpCat.{u})),
        (∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X} (hw : AlgebraicGeometry.Etale w),
          (resEtale hw).Additive ∧
          Limits.PreservesFiniteLimits (resEtale hw) ∧
          Limits.PreservesFiniteColimits (resEtale hw)) ∧
        (∀ {V₂ V₁ X : AlgebraicGeometry.Scheme.{u}} {v : V₂ ⟶ V₁} {w : V₁ ⟶ X}
            (hv : AlgebraicGeometry.Etale v) (hw : AlgebraicGeometry.Etale w)
            (hvw : AlgebraicGeometry.Etale (v ≫ w)),
          Nonempty (resEtale hvw ≅ resEtale hw ⋙ resEtale hv)) ∧
        (∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X} (hw : AlgebraicGeometry.Etale w)
            {ℱ : Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
            {𝒢 : Sheaf V.smallEtaleTopology AddCommGrpCat.{u}},
          (WeilIsEtaleSheafPullback w ℱ 𝒢 → Nonempty ((resEtale hw).obj ℱ ≅ 𝒢)) ∧
          (Nonempty ((resEtale hw).obj ℱ ≅ 𝒢) → WeilIsEtaleSheafPullback w ℱ 𝒢)) ∧
        (∀ {V' V : AlgebraicGeometry.Scheme.{u}} {w : V' ⟶ V}
            (hw : AlgebraicGeometry.Etale w) (A : AddCommGrpCat.{u}),
          Nonempty ((resEtale hw).obj
            ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A) ≅
            (CategoryTheory.constantSheaf V'.smallEtaleTopology AddCommGrpCat.{u}).obj A)) ∧
        (∀ (V : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥V] [PreconnectedSpace ↥V]
            (A : AddCommGrpCat.{u}),
          IsIso ((CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u}
            (hTerm V)).unit.app A) ∧
          IsIso ((CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u}
            (hTerm V)).counit.app
            ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A))) ∧
        (∀ {P W₂ : AlgebraicGeometry.Scheme.{u}} [PreconnectedSpace ↥W₂]
            {E_lift : P.Etale} (u_lift : E_lift ⟶ AlgebraicGeometry.Scheme.Etale.mk (𝟙 P))
            (j' : W₂ ⟶ E_lift.left) (hv : AlgebraicGeometry.Etale (j' ≫ E_lift.hom))
            {ℰ_P : Sheaf P.smallEtaleTopology AddCommGrpCat.{u}} {A₃ : AddCommGrpCat.{u}}
            (g_P : ℰ_P ⟶ (CategoryTheory.constantSheaf P.smallEtaleTopology AddCommGrpCat.{u}).obj A₃),
          (∀ a : ↥A₃, ∃ s : ↥(ℰ_P.obj.obj (Opposite.op E_lift)),
            (g_P.hom.app (Opposite.op E_lift)).hom s =
              (((CategoryTheory.constantSheaf P.smallEtaleTopology AddCommGrpCat.{u}).obj A₃).obj.map
                u_lift.op).hom
                (((CategoryTheory.constantSheafAdj P.smallEtaleTopology AddCommGrpCat.{u}
                  (hTerm P)).unit.app A₃).hom a)) →
          Epi (((CategoryTheory.sheafSections W₂.smallEtaleTopology AddCommGrpCat.{u}).obj
            (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk (𝟙 W₂)))).map
            ((resEtale hv).map g_P))) := by
    clear * - hEtComp hEtPb hEtBC hTerm hMemEt hMorEt
    let siteMap : ∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X}
        (_ : AlgebraicGeometry.Etale w), Functor V.Etale X.Etale :=
      fun hw => MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤ hw
    let sitePb : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
        Functor Y₂.Etale Y₁.Etale :=
      fun h =>
        letI : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h := hEtPb h
        letI : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h := hEtBC h
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    have hContB : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
        (sitePb h).IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology := by
      clear * - hEtComp hEtPb hEtBC sitePb hMemEt hMorEt
      intro Y₁ Y₂ h
      let _ : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h := hEtPb h
      let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h := hEtBC h
      let B_h : Functor Y₂.Etale Y₁.Etale := sitePb h
      have _ : Limits.PreservesFiniteLimits B_h :=
        MorphismProperty.Over.instPreservesFiniteLimitsTopPullback (@AlgebraicGeometry.Etale) h
      have _ : RepresentablyFlat B_h := flat_of_preservesFiniteLimits B_h
      have hCompat : CompatiblePreserving Y₁.smallEtaleTopology B_h :=
        compatiblePreservingOfFlat Y₁.smallEtaleTopology B_h
      have hCov : CoverPreserving Y₂.smallEtaleTopology Y₁.smallEtaleTopology B_h := by
        refine ⟨fun {E} {R} hR => (hMemEt (B_h.obj E) _).mpr fun y => ?_⟩
        obtain ⟨V, u, v_pt, huR, _, hv_pt⟩ :=
          (hMemEt E R).mp hR ((Limits.pullback.fst E.hom h).base y)
