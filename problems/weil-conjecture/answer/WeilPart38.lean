      apply (adj_sh.homEquiv Q F_sh).injective
      have h1 : adj_sh.homEquiv Q F_sh (𝟙 F_sh) = 0 := by
        rw [Adjunction.homEquiv_unit]
        change η_Q ≫ (CategoryTheory.sheafToPresheaf J_Y AddCommGrpCat.{u}).map (𝟙 F_sh) = 0
        rw [hη_zero, CategoryTheory.Limits.zero_comp]
