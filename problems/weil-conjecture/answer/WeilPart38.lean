    · intro R1 δ₀ hcomp hEpi_δ₀ hEx_δ₀ hSurj_1 hInj_2
      have _ : Epi δ₀ := hEpi_δ₀
      have hα_δ₀ : α_Q ≫ δ₀ = 0 := by
        rw [← cancel_epi p_M, ← Category.assoc, hpα, hcomp, Limits.comp_zero]
