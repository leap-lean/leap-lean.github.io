        (((Abelian.Ext.mk₀ ι_Z).comp (Abelian.Ext.mapExactFunctor P_pull w)
          (Nat.zero_add r)).comp (Abelian.Ext.mk₀ αQ_t) (Nat.add_zero r)).comp hSE.extClass rfl
      have hnat' : (hSE_M.map_of_exact P_pull).extClass.comp (Abelian.Ext.mk₀ α_t) (Nat.add_zero 1) =
          (Abelian.Ext.mk₀ αQ_t).comp hSE.extClass (Nat.zero_add 1) := hExtNat
      rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ι_Z) _ _ (Nat.zero_add (r + 1)) (Nat.add_zero (r + 1)) (by omega),
        Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor P_pull w)
          (hSE_M.map_of_exact P_pull).extClass (Abelian.Ext.mk₀ α_t) rfl (Nat.add_zero 1) rfl,
        hnat',
        ← Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor P_pull w)
          (Abelian.Ext.mk₀ αQ_t) hSE.extClass (Nat.add_zero r) (Nat.zero_add 1) rfl,
        ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ι_Z) _ hSE.extClass (Nat.zero_add r) rfl (by omega),
        ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ι_Z) _ _ (Nat.zero_add r) (Nat.add_zero r) (by omega)]
    have hδM_surj : ∀ r : ℕ, Function.Surjective (fun w : Abelian.Ext Z_M W r => w.comp hSE_M.extClass rfl) := by
      intro r y
      have hy0 : y.comp (Abelian.Ext.mk₀ SC_M.f) (Nat.add_zero (r + 1)) = 0 :=
        (hI_M (r + 1) (Nat.le_add_left 1 r)).elim _ _
      exact Abelian.Ext.covariant_sequence_exact₁ Z_M hSE_M y hy0 rfl
    have hδΩ_surj : ∀ r : ℕ, Function.Surjective (fun q : Abelian.Ext Z_Ω Q r => q.comp hSE.extClass rfl) := by
      intro r y
      have hy0 : y.comp (Abelian.Ext.mk₀ SC_Ω.f) (Nat.add_zero (r + 1)) = 0 :=
        (hI_Ω (r + 1) (Nat.le_add_left 1 r)).elim _ _
      exact Abelian.Ext.covariant_sequence_exact₁ Z_Ω hSE y hy0 rfl
    have hδM_inj : ∀ s : ℕ, 1 ≤ s →
        Function.Injective (fun w : Abelian.Ext Z_M W s => w.comp hSE_M.extClass rfl) := by
      intro s hs
      let f_δ : Abelian.Ext Z_M W s →+ Abelian.Ext Z_M G (s + 1) := hSE_M.extClass.postcomp Z_M rfl
      change Function.Injective f_δ; rw [injective_iff_map_eq_zero]; intro w hw0
      obtain ⟨k_s, rfl⟩ := Abelian.Ext.covariant_sequence_exact₃ Z_M hSE_M w rfl hw0
      rw [(hI_M s hs).elim k_s 0, Abelian.Ext.zero_comp]
    have hδΩ_inj : ∀ s : ℕ, 1 ≤ s →
        Function.Injective (fun q : Abelian.Ext Z_Ω Q s => q.comp hSE.extClass rfl) := by
      intro s hs
      let f_δ : Abelian.Ext Z_Ω Q s →+ Abelian.Ext Z_Ω F (s + 1) := hSE.extClass.postcomp Z_Ω rfl
      change Function.Injective f_δ; rw [injective_iff_map_eq_zero]; intro q hq0
      obtain ⟨i_s, rfl⟩ := Abelian.Ext.covariant_sequence_exact₃ Z_Ω hSE q rfl hq0
      rw [(hI_Ω s hs).elim i_s 0, Abelian.Ext.zero_comp]
    have hBij_KI0 : Function.Bijective (θ K I (𝟙 K) 0) := (hDeg0 K I (𝟙 K)).2 inferInstance
    have hInj_WQ0 : Function.Injective (θ W Q α_Q 0) := (hDeg0 W Q α_Q).1 inferInstance
    have hInj_1 : Function.Injective (θ G F α 1) := by
      rw [injective_iff_map_eq_zero]; intro y hy0
