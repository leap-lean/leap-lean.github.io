        e_kerΨ_k1.symm.toEquiv.subsingleton
      let T_R := termObj S_R
      let hT_R := isTermObj S_R
      have hInj_Ψ_TR : Function.Injective (Ψ_R.hom.app (Opposite.op T_R)) :=
        hKerH0_inj T_R hT_R Ψ_R hSub_kerΨ
      let u_op := Opposite.op (hT_R.from U_Ω)
      have hBij_CR : Function.Bijective
          (((CategoryTheory.constantSheaf S_R.smallEtaleTopology AddCommGrpCat.{u}).obj M₀).obj.map
            u_op) :=
        (hSpecR_site T_R hT_R).1 M₀
      have hBij_GR : Function.Bijective (G_R.obj.map u_op) :=
        hBij_cosp ι'_a hι'_hom G_R hPb_GR_G T_R hT_R
      have hInj_Ψ_UΩ : Function.Injective (Ψ_R.hom.app (Opposite.op U_Ω)) := by
        intro y₁ y₂ hy
        obtain ⟨x₁, rfl⟩ := hBij_CR.2 y₁
        obtain ⟨x₂, rfl⟩ := hBij_CR.2 y₂
        have hnat1 := congrArg (fun m => m x₁) (Ψ_R.hom.naturality u_op)
        have hnat2 := congrArg (fun m => m x₂) (Ψ_R.hom.naturality u_op)
        change Ψ_R.hom.app (Opposite.op U_Ω)
            ((((CategoryTheory.constantSheaf S_R.smallEtaleTopology AddCommGrpCat.{u}).obj M₀).obj.map
              u_op) x₁) =
          (G_R.obj.map u_op) (Ψ_R.hom.app (Opposite.op T_R) x₁) at hnat1
        change Ψ_R.hom.app (Opposite.op U_Ω)
            ((((CategoryTheory.constantSheaf S_R.smallEtaleTopology AddCommGrpCat.{u}).obj M₀).obj.map
              u_op) x₂) =
          (G_R.obj.map u_op) (Ψ_R.hom.app (Opposite.op T_R) x₂) at hnat2
        rw [hnat1, hnat2] at hy
        exact congrArg _ (hInj_Ψ_TR (hBij_GR.1 hy))

      have hKer_ηW : ∀ (H_η : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback (j_Rbar ≫ g_W) (CategoryTheory.Limits.kernel Φ) H_η →
          CategoryTheory.Limits.IsZero H_η := by
