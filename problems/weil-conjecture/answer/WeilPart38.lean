  let adj_g := (weilEtaleSitePullback g).sheafAdjunctionContinuous AddCommGrpCat.{u}
    U.smallEtaleTopology V.smallEtaleTopology
  let Fℤ_U := (CategoryTheory.constantSheaf U.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
