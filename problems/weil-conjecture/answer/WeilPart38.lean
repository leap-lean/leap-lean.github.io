        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
      let Pm := weilProjectiveSpaceOver k m
      let f_Pi := CategoryTheory.Limits.pullback.fst p_A1 Pm.hom
      ∀ (Q_proj₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (π_Q₀ : Q_proj₀ ⟶ CategoryTheory.Over.mk p_A1)
        (_ : AlgebraicGeometry.IsProper π_Q₀.left)
        (_ : AlgebraicGeometry.IsProper Pm.hom)
        (ι_Pi₀ : CategoryTheory.Limits.pullback p_A1 Pm.hom ⟶ Q_proj₀.left)
        (_ : ι_Pi₀ ≫ π_Q₀.left = f_Pi)
        (hGeom₀ :
          ∀ (K : Type u) [Field K] [IsAlgClosed K]
            (s_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ U_line),
            (∀ r_odd : ℕ, r_odd % 2 = 1 →
              Subsingleton (weilEtaleTorsionH (CategoryTheory.Limits.pullback π_Q₀.left s_K) ℓ r_odd)) ∧
            ∀ (i : ℕ), i ≤ 2 * m →
              ∀ (h_Pi_K : CategoryTheory.Limits.pullback f_Pi s_K ⟶
                  CategoryTheory.Limits.pullback π_Q₀.left s_K),
                h_Pi_K ≫ CategoryTheory.Limits.pullback.fst π_Q₀.left s_K =
