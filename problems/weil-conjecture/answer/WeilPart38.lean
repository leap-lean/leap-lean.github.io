      (Nat.card_congr e_H0.symm.toEquiv).trans_le
        (hCard_le.trans_eq (Nat.card_congr e_CK.symm))
    have hSurj_ψ : Function.Surjective (ψ_z.hom.app (Opposite.op T_K)) :=
      (Function.Injective.bijective_of_nat_card_le hInj_ψ hle_sec).2
    have hEpi_ψ : Epi ψ_z := hEpi_K ψ_z hSurj_ψ
    have hZ_cok_ψ : Limits.IsZero (Limits.cokernel ψ_z) :=
      @Limits.isZero_cokernel_of_epi _ _ _ _ _ _ hEpi_ψ _
    exact ⟨Limits.cokernel ψ_z, hPb_cok, hZ_cok_ψ⟩

  have _ : Epi Φ := (Preadditive.epi_iff_isZero_cokernel Φ).mpr hZ_cokΦ
  exact isIso_of_mono_of_epi Φ

theorem weil_cosp_curve_polyLine_points_and_etale_domain_lift (k : Type u) [Field k] [IsAlgClosed k] :
    let P := Polynomial k
    let U₀ := AlgebraicGeometry.Spec (CommRingCat.of P)
    let p_A1 : U₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
    let s_pt := fun (a : k) =>
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a))
    let Ω := AlgebraicClosure (FractionRing P)
    let η : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ U₀ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P Ω))
    ((∀ a : k, ∃ τ_a : U₀ ⟶ U₀,
        CategoryTheory.IsIso τ_a ∧ τ_a ≫ p_A1 = p_A1 ∧ s_pt 0 ≫ τ_a = s_pt a) ∧
      (∀ pt : ↥U₀, pt = (⊥ : PrimeSpectrum P) ∨ ∃ a : k, pt = (s_pt a).base (⊥ : PrimeSpectrum k)) ∧
      (∀ (K : Type u) [Field K] [IsAlgClosed K]
          (z_P : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ U₀),
        z_P.base (⊥ : PrimeSpectrum K) = (⊥ : PrimeSpectrum P) ∨
        ∃ (a : k) (π_Kk : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of k)),
          z_P = π_Kk ≫ s_pt a)) ∧
    ((∀ (K : Type u) [Field K] [IsAlgClosed K] {V X : AlgebraicGeometry.Scheme.{u}}
          (e : V ⟶ X) [AlgebraicGeometry.Etale e]
          (y : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ X),
        y.base (⊥ : PrimeSpectrum K) ∈ Set.range e.base →
        ∃ y_tilde : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ V, y_tilde ≫ e = y) ∧
      (∀ {X : AlgebraicGeometry.Scheme.{u}}
          (K₁ K₂ : Type u) [Field K₁] [IsAlgClosed K₁] [Field K₂] [IsAlgClosed K₂]
          (y₁ : AlgebraicGeometry.Spec (CommRingCat.of K₁) ⟶ X)
          (y₂ : AlgebraicGeometry.Spec (CommRingCat.of K₂) ⟶ X),
        y₁.base (⊥ : PrimeSpectrum K₁) = y₂.base (⊥ : PrimeSpectrum K₂) →
        ∃ (K₃ : Type u) (_ : Field K₃) (_ : IsAlgClosed K₃)
          (p₁ : AlgebraicGeometry.Spec (CommRingCat.of K₃) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of K₁))
          (p₂ : AlgebraicGeometry.Spec (CommRingCat.of K₃) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of K₂)),
          p₁ ≫ y₁ = p₂ ≫ y₂)) ∧
    (∀ (R_bar : Type u) [CommRing R_bar] [IsLocalRing R_bar]
        (g_Rbar : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ U₀),
      g_Rbar.base (IsLocalRing.closedPoint R_bar) = (s_pt 0).base (⊥ : PrimeSpectrum k) →
      let u_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R_bar))
      (∃ π_k1k : AlgebraicGeometry.Spec (CommRingCat.of (IsLocalRing.ResidueField R_bar)) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of k),
        u_R ≫ g_Rbar = π_k1k ≫ s_pt 0 ∧
        ∀ (W₀ : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W₀]
          (w₀ : W₀ ⟶ U₀) (s_W : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W₀)
          (g_W : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ W₀),
          s_W ≫ w₀ = s_pt 0 →
          g_W ≫ w₀ = g_Rbar →
          g_W.base (IsLocalRing.closedPoint R_bar) = s_W.base (⊥ : PrimeSpectrum k) →
          u_R ≫ g_W = π_k1k ≫ s_W) ∧
      (∀ (W₀ : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W₀]
          [AlgebraicGeometry.IsIntegral W₀]
          (w₀ : W₀ ⟶ U₀) [AlgebraicGeometry.Etale w₀]
          (g_W : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ W₀)
          (j_Rbar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of R_bar)),
        g_W ≫ w₀ = g_Rbar →
        j_Rbar ≫ g_Rbar = η →
        DenseRange (j_Rbar ≫ g_W).base)) :=
by
  intro P U₀ p_A1 s_pt Ω η
  have hPtDichot : ∀ pt : ↥U₀,
      pt = (⊥ : PrimeSpectrum P) ∨ ∃ a : k, pt = (s_pt a).base (⊥ : PrimeSpectrum k) := by
    intro pt
    by_cases hbot : pt = (⊥ : PrimeSpectrum P)
    · exact Or.inl hbot
    · right
      have hI_ne : pt.asIdeal ≠ ⊥ := fun h => hbot (PrimeSpectrum.ext h)
      have hMax : pt.asIdeal.IsMaximal :=
        @IsPrime.to_maximal_ideal P _ _ _ pt.asIdeal pt.isPrime hI_ne
      let g : P := Submodule.IsPrincipal.generator pt.asIdeal
      have hspan : Ideal.span {g} = pt.asIdeal :=
        Submodule.IsPrincipal.span_singleton_generator pt.asIdeal
      have hg_not_unit : ¬ IsUnit g := by
        intro hu
        apply pt.isPrime.ne_top
        rw [← hspan, Ideal.span_singleton_eq_top]
        exact hu
      have hg_deg : g.degree ≠ 0 := by
        rwa [Polynomial.isUnit_iff_degree_eq_zero] at hg_not_unit
      obtain ⟨a, ha⟩ := IsAlgClosed.exists_root g hg_deg
      refine ⟨a, ?_⟩
      have hg_mem : g ∈ RingHom.ker (Polynomial.evalRingHom a) := ha
      have hle : pt.asIdeal ≤ RingHom.ker (Polynomial.evalRingHom a) := by
        rw [← hspan, Ideal.span_singleton_le_iff_mem]
        exact hg_mem
      have hker_ne_top : RingHom.ker (Polynomial.evalRingHom a) ≠ ⊤ := by
        rw [Ideal.ne_top_iff_one]
        change (Polynomial.evalRingHom a) 1 ≠ 0
        rw [map_one]
        exact one_ne_zero
      have hI_eq : pt.asIdeal = RingHom.ker (Polynomial.evalRingHom a) :=
        hMax.eq_of_le hker_ne_top hle
      exact PrimeSpectrum.ext hI_eq
  refine ⟨⟨?_, hPtDichot, ?_⟩, ⟨?_, ?_⟩, ?_⟩
  · 
    intro a
    let φ_a : P →+* P := (Polynomial.aeval (Polynomial.X + Polynomial.C a)).toRingHom
    let ψ_a : P →+* P := (Polynomial.aeval (Polynomial.X - Polynomial.C a)).toRingHom
    let τ_a : U₀ ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_a)
    let τ_inv : U₀ ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_a)
    have hφψ : φ_a.comp ψ_a = RingHom.id P := by
      apply Polynomial.ringHom_ext'
      · ext c
        simp [P, φ_a, ψ_a]
      · simp [P, φ_a, ψ_a]
    have hψφ : ψ_a.comp φ_a = RingHom.id P := by
      apply Polynomial.ringHom_ext'
      · ext c
        simp [P, φ_a, ψ_a]
      · simp [P, φ_a, ψ_a]
    have hIso : CategoryTheory.IsIso τ_a :=
      ⟨⟨τ_inv,
        by
          dsimp [τ_a, τ_inv]
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hφψ]
          exact AlgebraicGeometry.Spec.map_id _,
        by
          dsimp [τ_a, τ_inv]
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψφ]
          exact AlgebraicGeometry.Spec.map_id _⟩⟩
    have hp_eq : τ_a ≫ p_A1 = p_A1 := by
      dsimp [τ_a, p_A1]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      ext c
      simp [P, φ_a]
    have hs_eq : s_pt 0 ≫ τ_a = s_pt a := by
      dsimp [τ_a, s_pt]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      apply Polynomial.ringHom_ext'
      · ext c
        simp [P, φ_a]
      · simp [P, φ_a]
    exact ⟨τ_a, hIso, hp_eq, hs_eq⟩
  · 
    intro K _ _ z_P
    rcases hPtDichot (z_P.base (⊥ : PrimeSpectrum K)) with hgen | ⟨a, ha⟩
    · exact Or.inl hgen
    · right
      let φ_z := AlgebraicGeometry.Spec.preimage z_P
      have hmap_z : AlgebraicGeometry.Spec.map φ_z = z_P :=
        AlgebraicGeometry.Spec.map_preimage z_P
      let f_z : P →+* K := φ_z.hom
      have hker_eq : Ideal.comap f_z (⊥ : Ideal K) =
          Ideal.comap (Polynomial.evalRingHom a) (⊥ : Ideal k) := by
        have hz_eq : (AlgebraicGeometry.Spec.map φ_z).base (⊥ : PrimeSpectrum K) =
            (s_pt a).base (⊥ : PrimeSpectrum k) := by
          rw [hmap_z]
          exact ha
        exact congrArg PrimeSpectrum.asIdeal hz_eq
      have hmem_rhs : Polynomial.X - Polynomial.C a ∈
          Ideal.comap (Polynomial.evalRingHom a) (⊥ : Ideal k) := by
        change (Polynomial.evalRingHom a) (Polynomial.X - Polynomial.C a) = 0
        simp
      rw [← hker_eq] at hmem_rhs
      have hfz_sub : f_z (Polynomial.X - Polynomial.C a) = 0 := hmem_rhs
      have hfz_X : f_z Polynomial.X = f_z (Polynomial.C a) := by
        rw [map_sub] at hfz_sub
        exact sub_eq_zero.mp hfz_sub
      let σ : k →+* K := f_z.comp Polynomial.C
      let π_Kk := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ)
      refine ⟨a, π_Kk, ?_⟩
      have hfz_fac : σ.comp (Polynomial.evalRingHom a) = f_z := by
        apply Polynomial.ringHom_ext'
        · ext c
          simp [P, σ]
        · simp [P, σ, hfz_X]
      dsimp [π_Kk, s_pt]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hfz_fac]
      have hφ_eq : CommRingCat.ofHom f_z = φ_z := CommRingCat.hom_ext rfl
      rw [hφ_eq, hmap_z]
  · 
    intro K _ _ V X e _ y hy
    rcases hy with ⟨v₀, hv₀⟩
    let P_y := CategoryTheory.Limits.pullback e y
    let fst : P_y ⟶ V := CategoryTheory.Limits.pullback.fst e y
    let snd : P_y ⟶ AlgebraicGeometry.Spec (CommRingCat.of K) :=
      CategoryTheory.Limits.pullback.snd e y
    have hEt_snd : AlgebraicGeometry.Etale snd := by
      dsimp [snd]
      infer_instance
    let _ : AlgebraicGeometry.Etale snd := hEt_snd
    obtain ⟨p₀, _, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
        (f := e) (g := y) v₀ (⊥ : PrimeSpectrum K) hv₀
    obtain ⟨W, hAff, hp₀, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := P_y) (x := p₀) (U := ⊤) trivial
    let B_cat : CommRingCat.{u} := P_y.presheaf.obj (Opposite.op W)
    let B : Type u := ↥B_cat
    let g_B : AlgebraicGeometry.Spec B_cat ⟶ AlgebraicGeometry.Spec (CommRingCat.of K) :=
      hAff.isoSpec.inv ≫ W.ι ≫ snd
    have hEt_gB : AlgebraicGeometry.Etale g_B := by
      dsimp [g_B]
      infer_instance
    let φ_B : CommRingCat.of K ⟶ B_cat := AlgebraicGeometry.Spec.preimage g_B
    have hmap_φB : AlgebraicGeometry.Spec.map φ_B = g_B :=
      AlgebraicGeometry.Spec.map_preimage g_B
    have hEt_φB : φ_B.hom.Etale := by
      rw [← hmap_φB] at hEt_gB
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale) (φ := φ_B)).mp hEt_gB
    let _ : Algebra K B := φ_B.hom.toAlgebra
    have hAlgEt : Algebra.Etale K B := RingHom.etale_algebraMap.mp hEt_φB
    let _ : Algebra.Etale K B := hAlgEt
    let q₀ : PrimeSpectrum B := hAff.isoSpec.hom.base ⟨p₀, hp₀⟩
    have hNontriv_B : Nontrivial B := by
      refine ⟨⟨1, 0, fun h10 => q₀.isPrime.ne_top ?_⟩⟩
      rw [Ideal.eq_top_iff_one, h10]
      exact q₀.asIdeal.zero_mem
    let _ : Nontrivial B := hNontriv_B
    obtain ⟨𝔪, h𝔪⟩ := Ideal.exists_maximal B
    let _ : 𝔪.IsMaximal := h𝔪
    let _ : Field (B ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    have hBij : Function.Bijective (algebraMap K (B ⧸ 𝔪)) :=
      Algebra.FormallyUnramified.bijective_of_isAlgClosed_of_isLocalRing K (B ⧸ 𝔪)
    let e_quot : K ≃+* (B ⧸ 𝔪) := RingEquiv.ofBijective (algebraMap K (B ⧸ 𝔪)) hBij
    let χ : B →+* K := e_quot.symm.toRingHom.comp (Ideal.Quotient.mk 𝔪)
    let χ_cat : B_cat ⟶ CommRingCat.of K := CommRingCat.ofHom χ
    have hχ_sec : φ_B ≫ χ_cat = 𝟙 (CommRingCat.of K) := by
      ext c
      change e_quot.symm (Ideal.Quotient.mk 𝔪 (algebraMap K B c)) = c
      have htower : Ideal.Quotient.mk 𝔪 (algebraMap K B c) = algebraMap K (B ⧸ 𝔪) c := rfl
      rw [htower]
      exact e_quot.symm_apply_apply c
    have hgB_sec : AlgebraicGeometry.Spec.map χ_cat ≫ g_B =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) := by
      rw [← hmap_φB, ← AlgebraicGeometry.Spec.map_comp, hχ_sec, AlgebraicGeometry.Spec.map_id]
    refine ⟨AlgebraicGeometry.Spec.map χ_cat ≫ hAff.isoSpec.inv ≫ W.ι ≫ fst, ?_⟩
    calc
      (AlgebraicGeometry.Spec.map χ_cat ≫ hAff.isoSpec.inv ≫ W.ι ≫ fst) ≫ e
          = AlgebraicGeometry.Spec.map χ_cat ≫ hAff.isoSpec.inv ≫ W.ι ≫ (fst ≫ e) := by
            simp only [CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map χ_cat ≫ hAff.isoSpec.inv ≫ W.ι ≫ (snd ≫ y) := by
            rw [CategoryTheory.Limits.pullback.condition]
      _ = (AlgebraicGeometry.Spec.map χ_cat ≫ g_B) ≫ y := by
            dsimp [g_B]
            simp only [CategoryTheory.Category.assoc]
      _ = y := by
            rw [hgB_sec, CategoryTheory.Category.id_comp]
  · 
    intro X K₁ K₂ _ _ _ _ y₁ y₂ hy_eq
    let P₁₂ := CategoryTheory.Limits.pullback y₁ y₂
    obtain ⟨q₀, _, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
        (f := y₁) (g := y₂) (⊥ : PrimeSpectrum K₁) (⊥ : PrimeSpectrum K₂) hy_eq
    let K₃ : Type u := AlgebraicClosure ↥(P₁₂.residueField q₀)
    let z₃ : AlgebraicGeometry.Spec (CommRingCat.of K₃) ⟶ P₁₂ :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥(P₁₂.residueField q₀) K₃)) ≫
        P₁₂.fromSpecResidueField q₀
    refine ⟨K₃, inferInstance, inferInstance,
      z₃ ≫ CategoryTheory.Limits.pullback.fst y₁ y₂,
      z₃ ≫ CategoryTheory.Limits.pullback.snd y₁ y₂, ?_⟩
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
      ← CategoryTheory.Category.assoc]
  · 
    intro R_bar _ _ g_Rbar hClosed u_R
    let k₁ := IsLocalRing.ResidueField R_bar
    let res : R_bar →+* k₁ := IsLocalRing.residue R_bar
    let γ_cat := AlgebraicGeometry.Spec.preimage g_Rbar
    have hmap_γ : AlgebraicGeometry.Spec.map γ_cat = g_Rbar :=
      AlgebraicGeometry.Spec.map_preimage g_Rbar
    let γ : P →+* R_bar := γ_cat.hom
    have hres_γX : res (γ Polynomial.X) = 0 := by
      have hcl_eq : (AlgebraicGeometry.Spec.map γ_cat).base (IsLocalRing.closedPoint R_bar) =
          (s_pt 0).base (⊥ : PrimeSpectrum k) := by
        rw [hmap_γ]
        exact hClosed
      have has : Ideal.comap γ (IsLocalRing.maximalIdeal R_bar) =
          Ideal.comap (Polynomial.evalRingHom (0 : k)) (⊥ : Ideal k) :=
        congrArg PrimeSpectrum.asIdeal hcl_eq
      have hX_mem : Polynomial.X ∈ Ideal.comap (Polynomial.evalRingHom (0 : k)) (⊥ : Ideal k) := by
        change (Polynomial.evalRingHom (0 : k)) Polynomial.X = 0
        simp
      rw [← has] at hX_mem
      have hγX_max : γ Polynomial.X ∈ IsLocalRing.maximalIdeal R_bar := hX_mem
      rwa [← IsLocalRing.ker_residue] at hγX_max
    let σ₁ : k →+* k₁ := (res.comp γ).comp Polynomial.C
    let π_k1k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ₁)
    refine ⟨⟨π_k1k, ?_, ?_⟩, ?_⟩
    · 
      have hhom_eq : γ_cat ≫ CommRingCat.ofHom res =
          CommRingCat.ofHom (Polynomial.evalRingHom (0 : k)) ≫ CommRingCat.ofHom σ₁ := by
        apply CommRingCat.hom_ext
        apply Polynomial.ringHom_ext'
        · ext c
          simp [P, σ₁, γ]
        · change res (γ Polynomial.X) = σ₁ ((Polynomial.evalRingHom 0) Polynomial.X)
          simp [P, hres_γX]
      dsimp [u_R, π_k1k, s_pt]
      rw [← hmap_γ, ← AlgebraicGeometry.Spec.map_comp, hhom_eq, AlgebraicGeometry.Spec.map_comp]
    · 
      intro W₀ _ w₀ s_W g_W hs_w hg_w hg_cl
      let e_W := W₀.isoSpec
      let B_cat : CommRingCat.{u} := W₀.presheaf.obj (Opposite.op ⊤)
      let B₀ : Type u := ↥B_cat
      let w' : AlgebraicGeometry.Spec B_cat ⟶ U₀ := e_W.inv ≫ w₀
      let s' : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ AlgebraicGeometry.Spec B_cat :=
        s_W ≫ e_W.hom
      let g' : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ AlgebraicGeometry.Spec B_cat :=
        g_W ≫ e_W.hom
      let α_cat := AlgebraicGeometry.Spec.preimage w'
      let σ_cat := AlgebraicGeometry.Spec.preimage s'
      let γ_W_cat := AlgebraicGeometry.Spec.preimage g'
      have hmap_α : AlgebraicGeometry.Spec.map α_cat = w' :=
        AlgebraicGeometry.Spec.map_preimage w'
      have hmap_σ : AlgebraicGeometry.Spec.map σ_cat = s' :=
        AlgebraicGeometry.Spec.map_preimage s'
      have hmap_γW : AlgebraicGeometry.Spec.map γ_W_cat = g' :=
        AlgebraicGeometry.Spec.map_preimage g'
      let α : P →+* B₀ := α_cat.hom
      let σ_W : B₀ →+* k := σ_cat.hom
      let γ_W : B₀ →+* R_bar := γ_W_cat.hom
      have hσα : α_cat ≫ σ_cat = CommRingCat.ofHom (Polynomial.evalRingHom (0 : k)) := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, hmap_σ, hmap_α]
        dsimp [s', w']
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e_W.hom,
          e_W.hom_inv_id, CategoryTheory.Category.id_comp, hs_w]
      have hγWα : α_cat ≫ γ_W_cat = γ_cat := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, hmap_γW, hmap_α, hmap_γ]
        dsimp [g', w']
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e_W.hom,
          e_W.hom_inv_id, CategoryTheory.Category.id_comp, hg_w]
      have hker_W : Ideal.comap γ_W (IsLocalRing.maximalIdeal R_bar) =
          Ideal.comap σ_W (⊥ : Ideal k) := by
        have hpt_eq : (AlgebraicGeometry.Spec.map γ_W_cat).base (IsLocalRing.closedPoint R_bar) =
            (AlgebraicGeometry.Spec.map σ_cat).base (⊥ : PrimeSpectrum k) := by
          rw [hmap_γW, hmap_σ]
          dsimp [g', s']
          change e_W.hom.base (g_W.base (IsLocalRing.closedPoint R_bar)) =
            e_W.hom.base (s_W.base (⊥ : PrimeSpectrum k))
          rw [hg_cl]
        exact congrArg PrimeSpectrum.asIdeal hpt_eq
      have hhom_W : γ_W_cat ≫ CommRingCat.ofHom res = σ_cat ≫ CommRingCat.ofHom σ₁ := by
        ext b
        change res (γ_W b) = σ₁ (σ_W b)
        let x : B₀ := b - α (Polynomial.C (σ_W b))
        have hx_σ : x ∈ Ideal.comap σ_W (⊥ : Ideal k) := by
          change σ_W (b - α (Polynomial.C (σ_W b))) = 0
          rw [map_sub]
          have h1 : σ_W (α (Polynomial.C (σ_W b))) = σ_W b := by
            change ((α_cat ≫ σ_cat).hom) (Polynomial.C (σ_W b)) = σ_W b
            rw [hσα]
            exact Polynomial.eval_C
          rw [h1, sub_self]
        rw [← hker_W] at hx_σ
        have hx_res : res (γ_W x) = 0 := by
          have hx_max : γ_W x ∈ IsLocalRing.maximalIdeal R_bar := hx_σ
          rwa [← IsLocalRing.ker_residue] at hx_max
        dsimp [x] at hx_res
        rw [map_sub, map_sub] at hx_res
        have hsub_eq := sub_eq_zero.mp hx_res
        rw [hsub_eq]
        have h2 : γ_W (α (Polynomial.C (σ_W b))) = γ (Polynomial.C (σ_W b)) := by
          change ((α_cat ≫ γ_W_cat).hom) (Polynomial.C (σ_W b)) = γ (Polynomial.C (σ_W b))
          rw [hγWα]
        rw [h2]
        rfl
      have hg'_eq : u_R ≫ g' = π_k1k ≫ s' := by
        dsimp [u_R, π_k1k]
        rw [← hmap_γW, ← hmap_σ, ← AlgebraicGeometry.Spec.map_comp, hhom_W,
          AlgebraicGeometry.Spec.map_comp]
      calc
        u_R ≫ g_W = u_R ≫ g' ≫ e_W.inv := by
          dsimp [g']
          rw [CategoryTheory.Category.assoc, e_W.hom_inv_id, CategoryTheory.Category.comp_id]
        _ = (u_R ≫ g') ≫ e_W.inv := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (π_k1k ≫ s') ≫ e_W.inv := by rw [hg'_eq]
        _ = π_k1k ≫ s_W := by
          dsimp [s']
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, e_W.hom_inv_id,
            CategoryTheory.Category.comp_id]
    · 
      intro W₀ _ _ w₀ _ g_W j_Rbar hg_w hj_g
      let η_W : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W₀ := j_Rbar ≫ g_W
      have hη_W : η_W ≫ w₀ = η := by
        dsimp [η_W]
        rw [CategoryTheory.Category.assoc, hg_w, hj_g]
      let e_W := W₀.isoSpec
      let B_cat : CommRingCat.{u} := W₀.presheaf.obj (Opposite.op ⊤)
      let B₀ : Type u := ↥B_cat
      let w' : AlgebraicGeometry.Spec B_cat ⟶ U₀ := e_W.inv ≫ w₀
      let η' : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec B_cat :=
        η_W ≫ e_W.hom
      have hEt_w' : AlgebraicGeometry.Etale w' := by
        dsimp [w']
        infer_instance
      have hη'_w' : η' ≫ w' = η := by
        dsimp [η', w']
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e_W.hom,
          e_W.hom_inv_id, CategoryTheory.Category.id_comp, hη_W]
      let α_cat := AlgebraicGeometry.Spec.preimage w'
      let ψ_cat := AlgebraicGeometry.Spec.preimage η'
      have hmap_α : AlgebraicGeometry.Spec.map α_cat = w' :=
        AlgebraicGeometry.Spec.map_preimage w'
      have hmap_ψ : AlgebraicGeometry.Spec.map ψ_cat = η' :=
        AlgebraicGeometry.Spec.map_preimage η'
      let α₀ : P →+* B₀ := α_cat.hom
      let ψ_Ω : B₀ →+* Ω := ψ_cat.hom
      have hψα : α_cat ≫ ψ_cat = CommRingCat.ofHom (algebraMap P Ω) := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, hmap_ψ, hmap_α, hη'_w']
      have hEt_α₀ : α₀.Etale := by
        rw [← hmap_α] at hEt_w'
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.Etale) (φ := α_cat)).mp hEt_w'
      let _ : Algebra P B₀ := α₀.toAlgebra
      have hAlgEt_B₀ : Algebra.Etale P B₀ := RingHom.etale_algebraMap.mp hEt_α₀
      let _ : Algebra.Etale P B₀ := hAlgEt_B₀
      let K_P := FractionRing P
      have hInj_PΩ : Function.Injective (algebraMap P Ω) := by
        rw [IsScalarTower.algebraMap_eq P K_P Ω]
        exact (algebraMap K_P Ω).injective.comp (IsFractionRing.injective P K_P)
      have hψ_alg_comm : ∀ p : P, ψ_Ω (algebraMap P B₀ p) = algebraMap P Ω p := by
        intro p
        change ((α_cat ≫ ψ_cat).hom) p = algebraMap P Ω p
        rw [hψα]
        rfl
      let S_P := Algebra.algebraMapSubmonoid B₀ (nonZeroDivisors P)
      have hS_le : S_P ≤ nonZeroDivisors B₀ := by
        rintro b ⟨p, hp_nzd, rfl⟩
        have hp_ne : p ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hp_nzd
        refine mem_nonZeroDivisors_iff_ne_zero.mpr (fun hb0 => hp_ne ?_)
        apply hInj_PΩ
        rw [← hψ_alg_comm p, hb0, map_zero, map_zero]
      let T_right := TensorProduct P B₀ K_P
      have _ : IsLocalization S_P T_right := IsLocalization.tensor K_P (nonZeroDivisors P)
      have hDom_Tr : IsDomain T_right :=
        IsLocalization.isDomain_of_le_nonZeroDivisors T_right hS_le
      let _ : IsDomain T_right := hDom_Tr
      have hInj_Tr : Function.Injective (algebraMap B₀ T_right) :=
        IsLocalization.injective T_right hS_le
      let B_K := TensorProduct P K_P B₀
      let e_comm : B_K ≃ₐ[P] T_right := Algebra.TensorProduct.comm P K_P B₀
      have hDom_BK : IsDomain B_K :=
        Function.Injective.isDomain e_comm.toRingHom e_comm.injective
      let _ : IsDomain B_K := hDom_BK
      have hInj_incR : Function.Injective (Algebra.TensorProduct.includeRight : B₀ →ₐ[P] B_K) := by
        intro b₁ b₂ hb
        apply hInj_Tr
        exact congrArg e_comm hb
      obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hModSep⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K_P B_K).mp inferInstance
      let _ : Finite I := hFinI
      let _ : ∀ i, Field (Ai i) := hFieldAi
      let _ : ∀ i, Algebra K_P (Ai i) := hAlgAi
      have _ : ∀ i, Module.Finite K_P (Ai i) := fun i => (hModSep i).1
      have _ : Module.Finite K_P B_K := Module.Finite.equiv e_prod.symm.toLinearEquiv
      have _ : Algebra.IsIntegral K_P B_K := Algebra.IsIntegral.of_finite K_P B_K
      have hIsField_BK : IsField B_K :=
        (Algebra.IsIntegral.isField_iff_isField (algebraMap K_P B_K).injective).mp
          (Field.toIsField K_P)
      let _ : Field B_K := hIsField_BK.toField
      let ψ_alg : B₀ →ₐ[P] Ω :=
        { ψ_Ω with commutes' := hψ_alg_comm }
      let ψ_K : B_K →ₐ[P] Ω :=
        Algebra.TensorProduct.lift (IsScalarTower.toAlgHom P K_P Ω) ψ_alg
          (fun _ _ => Commute.all _ _)
      have hInj_ψK : Function.Injective ψ_K := ψ_K.toRingHom.injective
      have hInj_ψΩ : Function.Injective ψ_Ω := by
        intro b₁ b₂ hb
        apply hInj_incR
        apply hInj_ψK
        change ψ_K ((1 : K_P) ⊗ₜ[P] b₁) = ψ_K ((1 : K_P) ⊗ₜ[P] b₂)
        rw [Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul, map_one, one_mul,
          one_mul]
        exact hb
      have hη'_bot : (η'.base (⊥ : PrimeSpectrum Ω) : PrimeSpectrum B₀) =
          (⊥ : PrimeSpectrum B₀) := by
        rw [← hmap_ψ]
        apply PrimeSpectrum.ext
        change Ideal.comap ψ_Ω (⊥ : Ideal Ω) = ⊥
        rw [eq_bot_iff]
        intro b hb
        have hψb : ψ_Ω b = 0 := hb
        have hb0 : b = 0 := hInj_ψΩ (hψb.trans (map_zero ψ_Ω).symm)
        rw [hb0]
        exact Submodule.zero_mem ⊥
      intro x
      have hbot_spec : @Specializes (PrimeSpectrum B₀) _ (⊥ : PrimeSpectrum B₀) (e_W.hom.base x) :=
        (PrimeSpectrum.le_iff_specializes (⊥ : PrimeSpectrum B₀) (e_W.hom.base x)).mp bot_le
      have hspec_B : @Specializes ↥(AlgebraicGeometry.Spec B_cat) _
          (η'.base (⊥ : PrimeSpectrum Ω)) (e_W.hom.base x) := by
        have h1 : (η'.base (⊥ : PrimeSpectrum Ω) : ↥(AlgebraicGeometry.Spec B_cat)) =
            (⊥ : PrimeSpectrum B₀) := hη'_bot
        rw [h1]
        exact hbot_spec
      have hspec_W : e_W.inv.base (η'.base (⊥ : PrimeSpectrum Ω)) ⤳
          e_W.inv.base (e_W.hom.base x) :=
        hspec_B.map (AlgebraicGeometry.Scheme.Hom.continuous e_W.inv)
      have hlhs : e_W.inv.base (η'.base (⊥ : PrimeSpectrum Ω)) =
          η_W.base (⊥ : PrimeSpectrum Ω) := by
        dsimp [η']
        change ((η_W ≫ e_W.hom) ≫ e_W.inv).base (⊥ : PrimeSpectrum Ω) =
          η_W.base (⊥ : PrimeSpectrum Ω)
        rw [CategoryTheory.Category.assoc, e_W.hom_inv_id, CategoryTheory.Category.comp_id]
      have hrhs : e_W.inv.base (e_W.hom.base x) = x := by
        change (e_W.hom ≫ e_W.inv).base x = x
        rw [e_W.hom_inv_id]
        rfl
      rw [hlhs, hrhs, specializes_iff_mem_closure] at hspec_W
      have hmem_range : η_W.base (⊥ : PrimeSpectrum Ω) ∈ Set.range η_W.base :=
        ⟨(⊥ : PrimeSpectrum Ω), rfl⟩
      exact closure_mono (Set.singleton_subset_iff.mpr hmem_range) hspec_W

theorem weil_sing_dev_locConst_curve_etale_triv_and_const_kernel_of_cosp (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (D_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (e_P : D_bar ≅ weilProjectiveSpaceOver k 1)
    (R_bar : Type u) [CommRing R_bar] (hDom : IsDomain R_bar)
    [HenselianLocalRing R_bar] [IsAlgClosed (IsLocalRing.ResidueField R_bar)]
    (g_Rbar : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
    (j_Rbar : AlgebraicGeometry.Spec
      (CommRingCat.of (AlgebraicClosure (FractionRing (Polynomial k)))) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R_bar))
    [AlgebraicGeometry.IsOpenImmersion j_Rbar]
    (hEt_j : AlgebraicGeometry.Etale j_Rbar)
    (hj_eq : j_Rbar ≫ g_Rbar = AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom
        (algebraMap (Polynomial k) (AlgebraicClosure (FractionRing (Polynomial k))))))
    (hClosed : g_Rbar.base (IsLocalRing.closedPoint R_bar) =
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k)))).base (⊥ : PrimeSpectrum k))
    (hLift : ∀ (W : AlgebraicGeometry.Scheme.{u})
        (w : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
        [AlgebraicGeometry.Etale w]
        (s_W : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W),
      s_W ≫ w = AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k))) →
      ∃ g_W : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ W,
        g_W ≫ w = g_Rbar ∧
        g_W.base (IsLocalRing.closedPoint R_bar) = s_W.base (⊥ : PrimeSpectrum k))
    (hCharts : ∀ x : ↥D_bar.left,
      ∃ (ι_chart : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ D_bar.left)
        (_ : AlgebraicGeometry.IsOpenImmersion ι_chart),
        ι_chart ≫ D_bar.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
        x ∈ Set.range ι_chart.base) :
    let P := Polynomial k
    let p_A1 : AlgebraicGeometry.Spec (CommRingCat.of P) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
    (∀ (G : CategoryTheory.Sheaf D_bar.left.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsConstructibleModPrimeSheaf ℓ D_bar.left G →
      (∀ (ι_chart : AlgebraicGeometry.Spec (CommRingCat.of P) ⟶ D_bar.left)
          [AlgebraicGeometry.IsOpenImmersion ι_chart],
        ι_chart ≫ D_bar.hom = p_A1 →
        ∀ (G_R : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of R_bar)).smallEtaleTopology
            AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback (g_Rbar ≫ ι_chart) G G_R →
          ∀ (T_R : (AlgebraicGeometry.Spec (CommRingCat.of R_bar)).Etale)
            (hT : CategoryTheory.Limits.IsTerminal T_R),
            Function.Bijective
              (G_R.obj.map
                (Opposite.op (hT.from (CategoryTheory.MorphismProperty.Over.mk ⊤ j_Rbar hEt_j))))) →
      ∃ (A₀ : AddCommGrpCat.{u}) (_ : Finite ↥A₀),
        ∀ x : ↥D_bar.left,
          ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ D_bar.left),
            AlgebraicGeometry.Etale w ∧
            x ∈ Set.range w.base ∧
            WeilIsEtaleSheafPullback w G
              ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)) ∧
    (∀ (G' : CategoryTheory.Sheaf D_bar.left.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (ι_chart : AlgebraicGeometry.Spec (CommRingCat.of P) ⟶ D_bar.left)
          [AlgebraicGeometry.IsOpenImmersion ι_chart],
        ι_chart ≫ D_bar.hom = p_A1 →
        ∀ (G'_R : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of R_bar)).smallEtaleTopology
            AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback (g_Rbar ≫ ι_chart) G' G'_R →
          ∀ (T_R : (AlgebraicGeometry.Spec (CommRingCat.of R_bar)).Etale)
            (hT : CategoryTheory.Limits.IsTerminal T_R),
            Function.Injective
              (G'_R.obj.map
                (Opposite.op (hT.from (CategoryTheory.MorphismProperty.Over.mk ⊤ j_Rbar hEt_j))))) →
      ∀ (B : AddCommGrpCat.{u}) [Finite ↥B]
        (φ : (CategoryTheory.constantSheaf D_bar.left.smallEtaleTopology AddCommGrpCat.{u}).obj B ⟶
          G'),
        ∃ (B₀ : AddCommGrpCat.{u}) (_ : Finite ↥B₀),
          Nonempty ((CategoryTheory.constantSheaf D_bar.left.smallEtaleTopology
            AddCommGrpCat.{u}).obj B₀ ≅ CategoryTheory.Limits.kernel φ)) :=
by
  classical
  let P := Polynomial k
  let U₀ := AlgebraicGeometry.Spec (CommRingCat.of P)
  let p_A1 : U₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
  let s_pt : k → (AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U₀) := fun a =>
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a))
  let Ω := AlgebraicClosure (FractionRing P)
  let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  let S_R := AlgebraicGeometry.Spec (CommRingCat.of R_bar)
  let η : S_Ω ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P Ω))
  let U_Ω : S_R.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ j_Rbar hEt_j
  let k₁ := IsLocalRing.ResidueField R_bar
  let u_R : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ S_R :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R_bar))

  let termObj : ∀ X : AlgebraicGeometry.Scheme.{u}, X.Etale :=
    fun X => AlgebraicGeometry.Scheme.Etale.mk (𝟙 X)
  let isTermObj : ∀ X : AlgebraicGeometry.Scheme.{u}, CategoryTheory.Limits.IsTerminal (termObj X) :=
    fun X => CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun E => CategoryTheory.MorphismProperty.Over.homMk E.hom (CategoryTheory.Category.comp_id E.hom))
      (fun E m => (AlgebraicGeometry.Scheme.Etale.forget X).map_injective
        (CategoryTheory.Over.OverMorphism.ext
          ((CategoryTheory.Category.comp_id m.left).symm.trans m.w)))

  have isTermPullback : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_h : X₂.Etale ⥤ X₁.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
      Nonempty (CategoryTheory.Limits.IsTerminal (B_h.obj (termObj X₂))) := by
    intro X₁ X₂ h
    let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    intro B_h
    let snd_inv : X₁ ⟶ CategoryTheory.Limits.pullback (𝟙 X₂) h :=
      CategoryTheory.Limits.pullback.lift h (𝟙 X₁)
        (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    have hsnd_inv₁ : snd_inv ≫ CategoryTheory.Limits.pullback.snd (𝟙 X₂) h = 𝟙 X₁ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hsnd_inv₂ : CategoryTheory.Limits.pullback.snd (𝟙 X₂) h ≫ snd_inv = 𝟙 _ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Limits.pullback.condition,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    exact ⟨CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun E => CategoryTheory.MorphismProperty.Over.homMk (E.hom ≫ snd_inv)
        ((CategoryTheory.Category.assoc E.hom snd_inv _).trans
          ((congrArg (E.hom ≫ ·) hsnd_inv₁).trans (CategoryTheory.Category.comp_id E.hom))))
      (fun E m => (AlgebraicGeometry.Scheme.Etale.forget X₁).map_injective
        (CategoryTheory.Over.OverMorphism.ext (by
          have hw : m.left ≫ CategoryTheory.Limits.pullback.snd (𝟙 X₂) h = E.hom :=
            (CategoryTheory.Category.id_comp _).symm.trans
              (m.w.trans (CategoryTheory.Category.comp_id _))
          exact (CategoryTheory.Category.comp_id m.left).symm.trans
            ((congrArg (m.left ≫ ·) hsnd_inv₂.symm).trans
              ((CategoryTheory.Category.assoc m.left _ snd_inv).symm.trans
                (congrArg (· ≫ snd_inv) hw))))))⟩

  
  have hInt_P1 : AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k 1).left :=
    (weil_projectiveSpace_integral_krullDim_and_dim_zero_iso k 1).1
  let e_D : D_bar.left ≅ (weilProjectiveSpaceOver k 1).left :=
    (CategoryTheory.Over.forget _).mapIso e_P
  have _ : AlgebraicGeometry.IsReduced D_bar.left :=
    AlgebraicGeometry.isReduced_of_isOpenImmersion e_D.hom
  have _ : IrreducibleSpace ↥(weilProjectiveSpaceOver k 1).left :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral (weilProjectiveSpaceOver k 1).left
  have hSurj_eD : Function.Surjective e_D.inv.base := fun x =>
    ⟨e_D.hom.base x, by
      change (e_D.hom ≫ e_D.inv).base x = x
      rw [e_D.hom_inv_id]
      rfl⟩
  let _ : IrreducibleSpace ↥D_bar.left :=
    { isPreirreducible_univ := by
        rw [← Set.image_univ_of_surjective hSurj_eD]
        exact (IrreducibleSpace.isIrreducible_univ
          ↥(weilProjectiveSpaceOver k 1).left).isPreirreducible.image _
          e_D.inv.base.hom.continuous.continuousOn
      toNonempty := Nonempty.map e_D.inv.base inferInstance }
  have _ : AlgebraicGeometry.IsIntegral D_bar.left :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced D_bar.left

  have hChartGen : ∀ (ι_chart : U₀ ⟶ D_bar.left) [AlgebraicGeometry.IsOpenImmersion ι_chart],
      ι_chart.base (⊥ : PrimeSpectrum P) = genericPoint ↥D_bar.left := by
    intro ι_chart _
    rw [← AlgebraicGeometry.genericPoint_eq_bot_of_affine (CommRingCat.of P)]
    exact AlgebraicGeometry.genericPoint_eq_of_isOpenImmersion ι_chart

  have hGenInOpen : ∀ (U_lc : D_bar.left.Opens), Nonempty ↥U_lc →
      genericPoint ↥D_bar.left ∈ U_lc := by
    intro U_lc ⟨u₀, hu₀⟩
    have hcl : u₀ ∈ closure ({genericPoint ↥D_bar.left} : Set ↥D_bar.left) := by
      rw [(genericPoint_spec ↥D_bar.left).def]
      trivial
    obtain ⟨z, hzU, hzeq⟩ := mem_closure_iff.mp hcl U_lc.1 U_lc.2 hu₀
    rwa [Set.mem_singleton_iff.mp hzeq] at hzU

  have hEta_bot : η.base (⊥ : PrimeSpectrum Ω) = (⊥ : PrimeSpectrum P) := by
    apply PrimeSpectrum.ext
    change Ideal.comap (algebraMap P Ω) ⊥ = ⊥
    rw [← RingHom.ker_eq_comap_bot, RingHom.ker_eq_bot_iff_eq_zero]
    intro p hp
    have hcomp : algebraMap P Ω p = algebraMap (FractionRing P) Ω (algebraMap P (FractionRing P) p) :=
      IsScalarTower.algebraMap_apply P (FractionRing P) Ω p
    rw [hcomp] at hp
    have hp1 : algebraMap P (FractionRing P) p = 0 :=
      (RingHom.injective (algebraMap (FractionRing P) Ω)) (hp.trans (map_zero _).symm)
    exact IsFractionRing.injective P (FractionRing P) (hp1.trans (map_zero _).symm)

  have hClosedPt_uR : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k₁)),
      u_R.base pt = IsLocalRing.closedPoint R_bar := by
    intro pt
    rw [Subsingleton.elim pt (⊥ : PrimeSpectrum k₁)]
    apply PrimeSpectrum.ext
    change Ideal.comap (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R_bar)) ⊥ =
      IsLocalRing.maximalIdeal R_bar
    rw [← RingHom.ker_eq_comap_bot, Ideal.mk_ker]

  have addEquivOfIso : ∀ {M N : AddCommGrpCat.{u}} (e : M ≅ N), ↥M ≃+ ↥N := fun e =>
    { toFun := e.hom
      invFun := e.inv
      left_inv := fun m => by change (e.hom ≫ e.inv) m = m; rw [e.hom_inv_id]; rfl
      right_inv := fun n => by change (e.inv ≫ e.hom) n = n; rw [e.inv_hom_id]; rfl
      map_add' := map_add e.hom.hom }

  
