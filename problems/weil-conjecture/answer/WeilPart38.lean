        rw [add_zero] at hsum_all
        calc
          diffC N S_hom + (rightCupC p p u v + rightCupC p p v u) =
            ((∑ j : Fin p, ∑ t : Fin (j.1 + 1), d_term j ⟨t.1, by omega⟩) +
              (∑ j : Fin p, ∑ t : Fin p, d_term j ⟨j.1 + 1 + t.1, by omega⟩) +
              (∑ j : Fin p, ∑ t : Fin (p - j.1), d_term j ⟨j.1 + 1 + p + t.1, by omega⟩)) +
            (rightCupC p p u v + rightCupC p p v u) +
            ((∑ j : Fin p,
                ((-1 : ℤ) ^ (j.1 + 1)) •
                  mul (N + 1)
                    (mapMono (μ_mid j) (hμ_mid_sm j) u)
                    (mapMono (τ_hat j.succ) (hτ_hat_sm j.succ) v)) +
              (∑ j : Fin p,
                ((-1 : ℤ) ^ j.1) •
                  mul (N + 1)
                    (mapMono (μ_mid j) (hμ_mid_sm j) u)
                    (mapMono (τ_hat j.succ) (hτ_hat_sm j.succ) v))) +
            ((∑ j : Fin p,
                ((-1 : ℤ) ^ (j.1 + 1)) •
                  mul (N + 1)
                    (mapMono (μ_mid j) (hμ_mid_sm j) u)
                    (mapMono (τ_hat j.castSucc) (hτ_hat_sm j.castSucc) v)) +
              (∑ j : Fin p,
                ((-1 : ℤ) ^ j.1) •
                  mul (N + 1)
                    (mapMono (μ_mid j) (hμ_mid_sm j) u)
                    (mapMono (τ_hat j.castSucc) (hτ_hat_sm j.castSucc) v))) := by
            rw [hcomb_d, hcanc1, hcanc2, add_zero, add_zero]
          _ = _ := by abel
          _ = 0 := hsum_all
      exact eq_neg_of_add_eq_zero_right htot

  have hPart2 : ∀ {𝒜 : Type (u + 1)} [Category.{u + 1, u + 1} 𝒜]
      [Abelian 𝒜] [HasExt.{u} 𝒜]
      (one : 𝒜) (A : ℕ → 𝒜) (ε : one ⟶ A 0) (d : ∀ n : ℕ, A n ⟶ A (n + 1)),
      Mono ε →
      (∃ h₀ : ε ≫ d 0 = 0, (ShortComplex.mk ε (d 0) h₀).Exact) →
      (∀ n : ℕ, ∃ hn : d n ≫ d (n + 1) = 0, (ShortComplex.mk (d n) (d (n + 1)) hn).Exact) →
      (∀ (n k : ℕ), 1 ≤ k → Subsingleton (Abelian.Ext.{u} one (A n) k)) →
      ∀ (m c : ℕ) (hc : (2 * m + 1) + (2 * m + 1) = c)
        (R_lad : ∀ u : one ⟶ A (2 * m + 1), u ≫ d (2 * m + 1) = 0 →
          ∀ k : ℕ, A k ⟶ A ((2 * m + 1) + k)),
        (∀ (u : one ⟶ A (2 * m + 1)) (hu : u ≫ d (2 * m + 1) = 0),
          ε ≫ R_lad u hu 0 = u) →
        (∀ (u : one ⟶ A (2 * m + 1)) (hu : u ≫ d (2 * m + 1) = 0) (k : ℕ),
          d k ≫ R_lad u hu (k + 1) = R_lad u hu k ≫ d ((2 * m + 1) + k)) →
        (∀ (u : one ⟶ A (2 * m + 1)) (hu : u ≫ d (2 * m + 1) = 0)
           (v : one ⟶ A (2 * m + 1)) (hv : v ≫ d (2 * m + 1) = 0),
          ∃ h_cob : one ⟶ A ((2 * m + 1) + 2 * m),
            v ≫ R_lad u hu (2 * m + 1) + u ≫ R_lad v hv (2 * m + 1) =
              h_cob ≫ d ((2 * m + 1) + 2 * m)) →
        ∀ (a b : Abelian.Ext.{u} one one (2 * m + 1)),
          Abelian.Ext.comp b a hc = -Abelian.Ext.comp a b hc := by
    intro 𝒜 _ _ _ one A ε d hMono hEx₀ hEx hAcyc m c hc R_lad hR_lad_0 hR_lad_comm hR_lad_anti a b
    subst hc
    let Z : ℕ → 𝒜 := fun k =>
      match k with
      | 0 => one
      | k' + 1 => Limits.kernel (d (k' + 1))
    let ι : ∀ k : ℕ, Z k ⟶ A k := fun k =>
      match k with
      | 0 => ε
      | k' + 1 => Limits.kernel.ι (d (k' + 1))
    have hMono_ι : ∀ k : ℕ, Mono (ι k) := by
      intro k
      cases k with
      | zero => exact hMono
      | succ k' => dsimp [ι]; infer_instance
    let π : ∀ k : ℕ, A k ⟶ Z (k + 1) := fun k =>
      Limits.kernel.lift (d (k + 1)) (d k) (hEx k).1
    have hπι : ∀ k : ℕ, π k ≫ ι (k + 1) = d k := fun k =>
      Limits.kernel.lift_ι (d (k + 1)) (d k) (hEx k).1
    have hιd : ∀ k : ℕ, ι k ≫ d k = 0 := by
      intro k
      cases k with
      | zero => exact hEx₀.1
      | succ k' => exact Limits.kernel.condition (d (k' + 1))
    have hιπ : ∀ k : ℕ, ι k ≫ π k = 0 := by
      intro k
      have : Mono (ι (k + 1)) := hMono_ι (k + 1)
      apply (cancel_mono (ι (k + 1))).mp
      rw [Limits.zero_comp, Category.assoc, hπι k, hιd k]
    have hEpi_π : ∀ k : ℕ, Epi (π k) := fun k => ((hEx k).2).epi_kernelLift
    have hS : ∀ k : ℕ, (ShortComplex.mk (ι k) (π k) (hιπ k)).ShortExact := by
      intro k
      have : Mono (ι k) := hMono_ι k
      have : Epi (π k) := hEpi_π k
      have hIsKer : Limits.IsLimit (Limits.KernelFork.ofι (ι k) (hιπ k)) := by
        cases k with
        | zero =>
          have : Mono ε := hMono
          let u₀ : one ⟶ Limits.kernel (d 0) := Limits.kernel.lift (d 0) ε hEx₀.1
          have hu₀_ι : u₀ ≫ Limits.kernel.ι (d 0) = ε := Limits.kernel.lift_ι _ _ _
          have : Mono u₀ := by
            have : Mono (u₀ ≫ Limits.kernel.ι (d 0)) := by rw [hu₀_ι]; exact hMono
            exact mono_of_mono u₀ (Limits.kernel.ι (d 0))
          have : Epi u₀ := hEx₀.2.epi_kernelLift
          have : IsIso u₀ := isIso_of_mono_of_epi u₀
          refine Limits.KernelFork.IsLimit.ofι _ _
            (fun {W} w hw =>
              Limits.kernel.lift (d 0) w
                (by rw [← hπι 0, ← Category.assoc, hw, Limits.zero_comp]) ≫ inv u₀)
            (fun {W} w hw => by
              dsimp [Z, ι]
              rw [Category.assoc, ← hu₀_ι, IsIso.inv_hom_id_assoc, Limits.kernel.lift_ι])
            (fun {W} w hw m_hom hm => by
              dsimp [Z, ι] at hm ⊢
              apply (cancel_mono ε).mp
              rw [hm, Category.assoc, ← hu₀_ι, IsIso.inv_hom_id_assoc, Limits.kernel.lift_ι])
        | succ k' =>
          refine Limits.KernelFork.IsLimit.ofι _ _
            (fun {W} w hw =>
              Limits.kernel.lift (d (k' + 1)) w
                (by rw [← hπι (k' + 1), ← Category.assoc, hw, Limits.zero_comp]))
            (fun {W} w hw => Limits.kernel.lift_ι _ _ _)
            (fun {W} w hw m_hom hm => by
              apply (cancel_mono (ι (k' + 1))).mp
              exact hm.trans (Limits.kernel.lift_ι _ _ _).symm)
      exact
        { exact := ShortComplex.exact_of_f_is_kernel _ hIsKer
          mono_f := hMono_ι k
          epi_g := hEpi_π k }
    let mkΩ : ∀ {Z' A' : ℕ → 𝒜} {ι' : ∀ k, Z' k ⟶ A' k} {π' : ∀ k, A' k ⟶ Z' (k + 1)}
        {h0' : ∀ k, ι' k ≫ π' k = 0},
        (∀ k, (ShortComplex.mk (ι' k) (π' k) (h0' k)).ShortExact) →
        ∀ n : ℕ, Abelian.Ext.{u} (Z' n) (Z' 0) n :=
      fun {Z' _ _ _ _} hS' n =>
        Nat.rec (motive := fun k => Abelian.Ext.{u} (Z' k) (Z' 0) k)
          (Abelian.Ext.mk₀ (𝟙 (Z' 0)))
          (fun k prev => (hS' k).extClass.comp prev (Nat.one_add k))
          n
    have hΩ_shift1 : ∀ {Z' A' : ℕ → 𝒜} {ι' : ∀ k, Z' k ⟶ A' k} {π' : ∀ k, A' k ⟶ Z' (k + 1)}
        {h0' : ∀ k, ι' k ≫ π' k = 0}
        (hS' : ∀ k, (ShortComplex.mk (ι' k) (π' k) (h0' k)).ShortExact) (n : ℕ),
        (mkΩ (fun k => hS' (k + 1)) n).comp (hS' 0).extClass (Nat.add_one n) =
          mkΩ hS' (n + 1) := by
      intro Z' A' ι' π' h0' hS' n
      induction n with
      | zero =>
        dsimp [mkΩ]
        rw [Abelian.Ext.mk₀_id_comp, Abelian.Ext.comp_mk₀_id]
      | succ n ih =>
        dsimp [mkΩ]
        rw [Abelian.Ext.comp_assoc (hS' (n + 1)).extClass
          (mkΩ (fun k => hS' (k + 1)) n) (hS' 0).extClass
          (Nat.one_add n) (Nat.add_one n) (Nat.one_add (n + 1)), ih]
    have hSurj : ∀ (q : ℕ) {Z' A' : ℕ → 𝒜} {ι' : ∀ k, Z' k ⟶ A' k} {π' : ∀ k, A' k ⟶ Z' (k + 1)}
        {h0' : ∀ k, ι' k ≫ π' k = 0}
        (hS' : ∀ k, (ShortComplex.mk (ι' k) (π' k) (h0' k)).ShortExact),
        (∀ (n k : ℕ), 1 ≤ k → Subsingleton (Abelian.Ext.{u} one (A' n) k)) →
        ∀ e : Abelian.Ext.{u} one (Z' 0) q,
          ∃ α : one ⟶ Z' q,
            (Abelian.Ext.mk₀ α).comp (mkΩ hS' q) (Nat.zero_add q) = e := by
      intro q
      induction q with
      | zero =>
        intro Z' A' ι' π' h0' hS' _ e
        refine ⟨Abelian.Ext.addEquiv₀ e, ?_⟩
        dsimp [mkΩ]
        rw [Abelian.Ext.comp_mk₀_id]
        exact Abelian.Ext.addEquiv₀.symm_apply_apply e
      | succ q ih =>
        intro Z' A' ι' π' h0' hS' hAcyc' e
        have : Subsingleton (Abelian.Ext.{u} one (A' 0) (q + 1)) :=
          hAcyc' 0 (q + 1) (by omega)
        have he0 : e.comp (Abelian.Ext.mk₀ (ι' 0)) (Nat.add_zero (q + 1)) = 0 :=
          Subsingleton.elim _ 0
        obtain ⟨x₃, hx₃⟩ :=
