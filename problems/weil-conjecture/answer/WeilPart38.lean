            rw [← hj_bar_fst]
            change pr_D.base (j_bar.base z) = j_aff.base p
            rw [hjz, hp_eq]
          have hz_Wk : z ∈ W_k := by
            change Δ_k ∉ z.asIdeal
            change Δ_aff ∉ ((AlgebraicGeometry.Spec.map inl_poly).base z).asIdeal
            rw [hp_z]
            exact (hProd_not_mem S_aff p.asIdeal p.isPrime).mpr hp
          exact ⟨⟨z, hz_Wk⟩, hjz⟩
      let e_Uk : W_k.toScheme ≅ U_bar.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (W_k.ι ≫ j_bar) U_bar.ι hRange_eq
      let _ : CategoryTheory.IsIso e_Uk.inv := inferInstance
      let U_bar_ov : CategoryTheory.Over
          (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))) :=
        CategoryTheory.Over.mk (U_bar.ι ≫ D_bar.hom)
      let _ : AlgebraicGeometry.IsAffine U_bar_ov.left :=
        AlgebraicGeometry.IsAffine.of_isIso e_Uk.inv
      let _ : AlgebraicGeometry.LocallyOfFiniteType U_bar_ov.hom := by
        change AlgebraicGeometry.LocallyOfFiniteType (U_bar.ι ≫ D_bar.hom)
        infer_instance
      have hDim_Ubar : topologicalKrullDim U_bar_ov.left ≤ (1 : WithBot ℕ∞) := by
        let hHomeo := TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso e_Uk.symm)
        have heq_dim : topologicalKrullDim U_bar_ov.left = topologicalKrullDim ↥W_k.toScheme :=
          IsHomeomorph.topologicalKrullDim_eq hHomeo hHomeo.isHomeomorph
        have hsub_dim : topologicalKrullDim ↥W_k.toScheme ≤
            topologicalKrullDim (PrimeSpectrum (Polynomial (AlgebraicClosure F))) :=
          topologicalKrullDim_subspace_le
            (PrimeSpectrum (Polynomial (AlgebraicClosure F))) W_k.1
        have hSpec_dim :
            topologicalKrullDim (PrimeSpectrum (Polynomial (AlgebraicClosure F))) =
              ringKrullDim (Polynomial (AlgebraicClosure F)) :=
          PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim (Polynomial (AlgebraicClosure F))
        have hPoly_dim : ringKrullDim (Polynomial (AlgebraicClosure F)) ≤ (1 : WithBot ℕ∞) := by
          calc ringKrullDim (Polynomial (AlgebraicClosure F))
              ≤ 2 * ringKrullDim (AlgebraicClosure F) + 1 := Polynomial.ringKrullDim_le
            _ = 2 * 0 + 1 := by rw [ringKrullDim_eq_zero_of_field]
            _ = 1 := by norm_num
        rw [heq_dim]
        exact hsub_dim.trans (hSpec_dim.trans_le hPoly_dim)
      have hH_aff : ∀ q : ℕ, 1 < q → Subsingleton (weilEtaleTorsionH U_bar.toScheme ℓ q) :=
        fun q hq =>
          weil_affine_etale_cohomological_dimension (AlgebraicClosure F) 1 ℓ q
            hPrime_ℓ.one_le (IsUnit.mk0 _ hℓ_k) U_bar_ov hDim_Ubar hq

      
      have hFrobPowProj : ∀ (K₀ : Type u) [Finite K₀] [Field K₀]
          (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₀))) (n : ℕ),
          let ψ_K := (@FiniteField.frobeniusAlgEquivOfAlgebraic K₀ _ (Fintype.ofFinite K₀)
            (AlgebraicClosure K₀) _ _ _).symm
          let f₂_K := AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap K₀ (AlgebraicClosure K₀)))
          let fst_W : weilGeomScheme K₀ W ⟶ W.left := CategoryTheory.Limits.pullback.fst W.hom f₂_K
          let snd_W : weilGeomScheme K₀ W ⟶
              AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure K₀)) :=
            (weilBaseChangeOver K₀ (AlgebraicClosure K₀) W).hom
          weilSchemeEndPow (weilGeomFrobHom K₀ W) n ≫ fst_W = fst_W ∧
          weilSchemeEndPow (weilGeomFrobHom K₀ W) n ≫ snd_W =
            snd_W ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_K ^ n).toRingHom) := by
        intro K₀ _ _ W n ψ_K f₂_K fst_W snd_W
        have h1_fst : weilGeomFrobHom K₀ W ≫ fst_W = fst_W :=
          (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
            (CategoryTheory.Category.comp_id _)
        have h1_snd : weilGeomFrobHom K₀ W ≫ snd_W =
            snd_W ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_K.toRingHom) :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        induction n with
        | zero =>
          refine ⟨CategoryTheory.Category.id_comp fst_W, ?_⟩
          change 𝟙 _ ≫ snd_W =
            snd_W ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (1 : _ ≃ₐ[K₀] _).toRingHom)
          have hid :
              CommRingCat.ofHom (1 : AlgebraicClosure K₀ ≃ₐ[K₀] AlgebraicClosure K₀).toRingHom =
                𝟙 (CommRingCat.of (AlgebraicClosure K₀)) :=
            CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
          rw [CategoryTheory.Category.id_comp, hid, AlgebraicGeometry.Spec.map_id,
            CategoryTheory.Category.comp_id]
        | succ n ih =>
          obtain ⟨ih_fst, ih_snd⟩ := ih
          refine ⟨?_, ?_⟩
          · change (weilGeomFrobHom K₀ W ≫ weilSchemeEndPow (weilGeomFrobHom K₀ W) n) ≫ fst_W =
              fst_W
            rw [CategoryTheory.Category.assoc, ih_fst, h1_fst]
          · change (weilGeomFrobHom K₀ W ≫ weilSchemeEndPow (weilGeomFrobHom K₀ W) n) ≫ snd_W = _
            rw [CategoryTheory.Category.assoc, ih_snd, ← CategoryTheory.Category.assoc, h1_snd,
              CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
            have hhom : CommRingCat.ofHom (ψ_K ^ n).toRingHom ≫ CommRingCat.ofHom ψ_K.toRingHom =
                CommRingCat.ofHom (ψ_K ^ (n + 1)).toRingHom :=
              CommRingCat.hom_ext (RingHom.ext fun x => by
                change ψ_K ((ψ_K ^ n) x) = (ψ_K ^ (n + 1)) x
                rw [pow_succ']
                rfl)
            rw [hhom]

      let _ : Fintype F := Fintype.ofFinite F
      let _ : Fintype F_P := Fintype.ofFinite F_P
      let κ₀ : AlgebraicClosure F_P ≃ₐ[F] AlgebraicClosure F :=
        IsAlgClosure.equiv F (AlgebraicClosure F_P) (AlgebraicClosure F)
      let φ_F := @FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
        (AlgebraicClosure F) _ _ _
      let ψ_F := φ_F.symm
      let φ_FP := @FiniteField.frobeniusAlgEquivOfAlgebraic F_P _ (Fintype.ofFinite F_P)
        (AlgebraicClosure F_P) _ _ _
      let ψ_FP := φ_FP.symm
      have hφ_F_pow : ∀ (n : ℕ) (z : AlgebraicClosure F), (φ_F ^ n) z = z ^ (Nat.card F ^ n) := by
        intro n
        induction n with
        | zero =>
          intro z
          simp
        | succ n ih =>
          intro z
          rw [pow_succ', AlgEquiv.mul_apply, ih z,
            FiniteField.frobeniusAlgEquivOfAlgebraic_apply, ← Nat.card_eq_fintype_card,
            ← pow_mul, ← pow_succ]
      have hφ_FP_apply : ∀ y : AlgebraicClosure F_P, φ_FP y = y ^ (Nat.card F ^ d) := by
        intro y
        rw [FiniteField.frobeniusAlgEquivOfAlgebraic_apply, ← Nat.card_eq_fintype_card, hcard_FP]
      have hφ_ψ_F : ∀ (n : ℕ) (z : AlgebraicClosure F), (φ_F ^ n) ((ψ_F ^ n) z) = z := by
        intro n
        induction n with
        | zero => intro z; simp
        | succ n ih =>
          intro z
          rw [pow_succ', pow_succ, AlgEquiv.mul_apply, AlgEquiv.mul_apply, ih (ψ_F z)]
          exact φ_F.apply_symm_apply z
      have hκ_frob : ∀ z : AlgebraicClosure F, κ₀.symm ((ψ_F ^ d) z) = ψ_FP (κ₀.symm z) := by
        intro z
        apply φ_FP.injective
        apply κ₀.injective
        rw [φ_FP.apply_symm_apply, κ₀.apply_symm_apply, hφ_FP_apply, map_pow,
          κ₀.apply_symm_apply, ← hφ_F_pow d ((ψ_F ^ d) z), hφ_ψ_F d z]
      let ι_FP_k : F_P →+* AlgebraicClosure F :=
        κ₀.toRingHom.comp (algebraMap F_P (AlgebraicClosure F_P))
      have hι_FP_F : ι_FP_k.comp (algebraMap F F_P) = algebraMap F (AlgebraicClosure F) :=
        RingHom.ext fun a => by
          change κ₀ (algebraMap F_P (AlgebraicClosure F_P) (algebraMap F F_P a)) =
            algebraMap F (AlgebraicClosure F) a
          rw [← IsScalarTower.algebraMap_apply F F_P (AlgebraicClosure F_P)]
          exact κ₀.commutes a

      have hu₀_Dbar_comm : (g_k ≫ u₀) ≫ D₀.hom =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))) ≫ g_k := by
        rw [CategoryTheory.Category.assoc, hu₀_sec, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp]
      let u₀_Dbar : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)) ⟶ D_bar.left :=
        CategoryTheory.Limits.pullback.lift (g_k ≫ u₀) (𝟙 _) hu₀_Dbar_comm
      have hu₀_Dbar_fst : u₀_Dbar ≫ pr_D = g_k ≫ u₀ :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hu₀_Dbar_snd : u₀_Dbar ≫ D_bar.hom = 𝟙 _ :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hu₀_Dbar_range : Set.range u₀_Dbar.base ⊆ Set.range U_bar.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨pt, rfl⟩
        change (u₀_Dbar ≫ pr_D).base pt ∈ U₀
        rw [hu₀_Dbar_fst]
        exact hu₀_mem ⟨g_k.base pt, rfl⟩
      let u_bar : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)) ⟶
          U_bar.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift U_bar.ι u₀_Dbar hu₀_Dbar_range
      have hu_bar_ι : u_bar ≫ U_bar.ι = u₀_Dbar :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_bar.ι u₀_Dbar hu₀_Dbar_range
      have hU_ne : Nonempty ↥U_bar.toScheme := Nonempty.map u_bar.base inferInstance

      have hx_P_hom : x_P ≫ D₀.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F F_P)) := by
        dsimp [x_P]
        rw [CategoryTheory.Category.assoc, hj_hom, ← AlgebraicGeometry.Spec.map_comp]
        rfl
      let s_FP_k : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of F_P) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_FP_k)
      have hxP_Dbar_comm : (s_FP_k ≫ x_P) ≫ D₀.hom =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))) ≫ g_k := by
        rw [CategoryTheory.Category.assoc, hx_P_hom, ← AlgebraicGeometry.Spec.map_comp,
          CategoryTheory.Category.id_comp]
        have hcomp_ring : CommRingCat.ofHom (algebraMap F F_P) ≫ CommRingCat.ofHom ι_FP_k =
            CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)) :=
          (CommRingCat.ofHom_comp _ _).symm.trans (congrArg CommRingCat.ofHom hι_FP_F)
        rw [hcomp_ring]
      let xP_Dbar : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)) ⟶ D_bar.left :=
        CategoryTheory.Limits.pullback.lift (s_FP_k ≫ x_P) (𝟙 _) hxP_Dbar_comm
      have hxP_Dbar_fst : xP_Dbar ≫ pr_D = s_FP_k ≫ x_P :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hxP_Dbar_snd : xP_Dbar ≫ D_bar.hom = 𝟙 _ :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hxP_Dbar_range : Set.range xP_Dbar.base ⊆ Set.range U_bar.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨pt, rfl⟩
        change (xP_Dbar ≫ pr_D).base pt ∈ U₀
        rw [hxP_Dbar_fst]
        have hmem_U0 : x_P.base (s_FP_k.base pt) ∈ Set.range U₀.ι.base :=
          hx_range ⟨s_FP_k.base pt, rfl⟩
        rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at hmem_U0
      let x_bar : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)) ⟶
          U_bar.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift U_bar.ι xP_Dbar hxP_Dbar_range
      have hx_bar_ι : x_bar ≫ U_bar.ι = xP_Dbar :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_bar.ι xP_Dbar hxP_Dbar_range

      let F_Ztilde_d : Z_bar.left ⟶ Z_bar.left :=
        weilSchemeEndPow (weilGeomFrobHom F Z_tilde) d
      have hf_bar_fst' : f_bar.left ≫ pr_D = pr_Z ≫ f₀.left := hf_bar_fst
      obtain ⟨hFZ_fst_raw, hFZ_snd_raw⟩ := hFrobPowProj F Z_tilde d
      have hFZ_fst : F_Ztilde_d ≫ pr_Z = pr_Z := hFZ_fst_raw
      have hFZ_snd : F_Ztilde_d ≫ Z_bar.hom =
          Z_bar.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_F ^ d).toRingHom) :=
        hFZ_snd_raw
      have hFZ_Vbar_range : Set.range (V_bar.ι ≫ F_Ztilde_d).base ⊆ Set.range V_bar.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨v, rfl⟩
        have hv : (f_bar.left ≫ pr_D).base v.1 ∈ U₀ := v.2
        change (F_Ztilde_d ≫ f_bar.left ≫ pr_D).base v.1 ∈ U₀
        have hcomp_eq : F_Ztilde_d ≫ f_bar.left ≫ pr_D = f_bar.left ≫ pr_D := by
          rw [hf_bar_fst', ← CategoryTheory.Category.assoc, hFZ_fst]
        rw [hcomp_eq]
        exact hv
      let Φ_V_d : V_bar.toScheme ⟶ V_bar.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift V_bar.ι (V_bar.ι ≫ F_Ztilde_d) hFZ_Vbar_range
      have hΦ_V_ι : Φ_V_d ≫ V_bar.ι = V_bar.ι ≫ F_Ztilde_d :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac V_bar.ι (V_bar.ι ≫ F_Ztilde_d) hFZ_Vbar_range

      let Zu_k : CategoryTheory.Over
          (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))) :=
        weilBaseChangeOver F (AlgebraicClosure F) Z_u₀
      let fst_Zuk : Zu_k.left ⟶ Z_u₀.left := CategoryTheory.Limits.pullback.fst Z_u₀.hom g_k
      have hpb_Zuk : CategoryTheory.IsPullback fst_Zuk Zu_k.hom Z_u₀.hom g_k :=
        CategoryTheory.IsPullback.of_hasPullback Z_u₀.hom g_k
      let _ : AlgebraicGeometry.IsProper Zu_k.hom :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Zuk inferInstance
      have hι_u_comm : (fst_Zuk ≫ ι_Zu₀) ≫ f₀.left = (Zu_k.hom ≫ u₀_Dbar) ≫ pr_D := by
        rw [CategoryTheory.Category.assoc, hPb_Zu₀.w, ← CategoryTheory.Category.assoc, hpb_Zuk.w,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hu₀_Dbar_fst]
      let ι_u_Zbar : Zu_k.left ⟶ Z_bar.left :=
        hPb_fbar.lift (fst_Zuk ≫ ι_Zu₀) (Zu_k.hom ≫ u₀_Dbar) hι_u_comm
      have hι_u_fst : ι_u_Zbar ≫ pr_Z = fst_Zuk ≫ ι_Zu₀ := hPb_fbar.lift_fst _ _ _
      have hι_u_fbar : ι_u_Zbar ≫ f_bar.left = Zu_k.hom ≫ u₀_Dbar := hPb_fbar.lift_snd _ _ _
      have hι_u_snd : ι_u_Zbar ≫ Z_bar.hom = Zu_k.hom := by
        have hf_snd : f_bar.left ≫ D_bar.hom = Z_bar.hom := CategoryTheory.Over.w f_bar
        rw [← hf_snd, ← CategoryTheory.Category.assoc, hι_u_fbar, CategoryTheory.Category.assoc,
          hu₀_Dbar_snd, CategoryTheory.Category.comp_id]
      have hpb_Zuk_outer : CategoryTheory.IsPullback (ι_u_Zbar ≫ pr_Z) Zu_k.hom f₀.left
          (u₀_Dbar ≫ pr_D) := by
        rw [hι_u_fst, hu₀_Dbar_fst]
        exact hpb_Zuk.paste_horiz hPb_Zu₀
      have hPb_u_Zbar : CategoryTheory.IsPullback ι_u_Zbar Zu_k.hom f_bar.left
          (u_bar ≫ U_bar.ι) := by
        rw [hu_bar_ι]
        exact CategoryTheory.IsPullback.of_right hpb_Zuk_outer hι_u_fbar hPb_fbar
      have hι_u_range : Set.range ι_u_Zbar.base ⊆ Set.range V_bar.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨z, rfl⟩
        change (ι_u_Zbar ≫ f_bar.left).base z ∈ U_bar
        rw [hι_u_fbar, ← hu_bar_ι]
        exact (u_bar.base (Zu_k.hom.base z)).2
      let ι_u : Zu_k.left ⟶ V_bar.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift V_bar.ι ι_u_Zbar hι_u_range
      have hι_u_ι : ι_u ≫ V_bar.ι = ι_u_Zbar :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac V_bar.ι ι_u_Zbar hι_u_range
      let F_Zu_d : Zu_k.left ⟶ Zu_k.left := weilSchemeEndPow (weilGeomFrobHom F Z_u₀) d
      obtain ⟨hFZu_fst_raw, hFZu_snd_raw⟩ := hFrobPowProj F Z_u₀ d
      have hFZu_fst : F_Zu_d ≫ fst_Zuk = fst_Zuk := hFZu_fst_raw
      have hFZu_snd : F_Zu_d ≫ Zu_k.hom =
          Zu_k.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_F ^ d).toRingHom) :=
        hFZu_snd_raw
      have hFrob_u : F_Zu_d ≫ ι_u = ι_u ≫ Φ_V_d := by
        rw [← cancel_mono V_bar.ι, CategoryTheory.Category.assoc, hι_u_ι,
          CategoryTheory.Category.assoc, hΦ_V_ι, ← CategoryTheory.Category.assoc, hι_u_ι]
        apply hPb_Zbar.hom_ext
        · rw [CategoryTheory.Category.assoc, hι_u_fst, ← CategoryTheory.Category.assoc, hFZu_fst,
            CategoryTheory.Category.assoc, hFZ_fst, hι_u_fst]
        · rw [CategoryTheory.Category.assoc, hι_u_snd, hFZu_snd,
            CategoryTheory.Category.assoc, hFZ_snd, ← CategoryTheory.Category.assoc, hι_u_snd]

      let ZP_bar := weilBaseChangeOver F_P (AlgebraicClosure F_P) Z_P
      let f₂_FP := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap F_P (AlgebraicClosure F_P)))
      let fst_ZPbar : ZP_bar.left ⟶ Z_P.left := CategoryTheory.Limits.pullback.fst Z_P.hom f₂_FP
      have hpb_ZPbar : CategoryTheory.IsPullback fst_ZPbar ZP_bar.hom Z_P.hom f₂_FP :=
        CategoryTheory.IsPullback.of_hasPullback Z_P.hom f₂_FP
      let e_k_FP : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F_P)) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)) :=
        { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ₀.symm.toRingHom)
          inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ₀.toRingHom)
          hom_inv_id := by
            rw [← AlgebraicGeometry.Spec.map_comp]
            have h1 : CommRingCat.ofHom κ₀.toRingHom ≫ CommRingCat.ofHom κ₀.symm.toRingHom =
                𝟙 _ :=
              CommRingCat.hom_ext (RingHom.ext fun y => κ₀.symm_apply_apply y)
            rw [h1, AlgebraicGeometry.Spec.map_id]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Spec.map_comp]
            have h1 : CommRingCat.ofHom κ₀.symm.toRingHom ≫ CommRingCat.ofHom κ₀.toRingHom =
                𝟙 _ :=
              CommRingCat.hom_ext (RingHom.ext fun z => κ₀.apply_symm_apply z)
            rw [h1, AlgebraicGeometry.Spec.map_id] }
      let ZP_k : CategoryTheory.Over
          (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))) :=
        CategoryTheory.Over.mk (ZP_bar.hom ≫ e_k_FP.hom)
      have he_s_FP : e_k_FP.hom ≫ s_FP_k = f₂_FP := by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ₀.symm.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_FP_k) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F_P (AlgebraicClosure F_P)))
        rw [← AlgebraicGeometry.Spec.map_comp]
        have h1 : CommRingCat.ofHom ι_FP_k ≫ CommRingCat.ofHom κ₀.symm.toRingHom =
            CommRingCat.ofHom (algebraMap F_P (AlgebraicClosure F_P)) :=
          CommRingCat.hom_ext (RingHom.ext fun c => κ₀.symm_apply_apply (algebraMap F_P _ c))
        rw [h1]
      let _ : CategoryTheory.IsIso e_k_FP.inv :=
        ⟨⟨e_k_FP.hom, e_k_FP.inv_hom_id, e_k_FP.hom_inv_id⟩⟩
      have hpb_ZPk_iso : CategoryTheory.IsPullback (𝟙 ZP_bar.left) ZP_k.hom ZP_bar.hom
          e_k_FP.inv :=
        CategoryTheory.IsPullback.of_horiz_isIso ⟨by
          change 𝟙 ZP_bar.left ≫ ZP_bar.hom = (ZP_bar.hom ≫ e_k_FP.hom) ≫ e_k_FP.inv
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, e_k_FP.hom_inv_id,
            CategoryTheory.Category.comp_id]⟩
      have hpb_ZPk : CategoryTheory.IsPullback fst_ZPbar ZP_k.hom Z_P.hom s_FP_k := by
        have hp := hpb_ZPk_iso.paste_horiz hpb_ZPbar
        have hbot : e_k_FP.inv ≫ f₂_FP = s_FP_k := by
          rw [← he_s_FP, ← CategoryTheory.Category.assoc, e_k_FP.inv_hom_id,
            CategoryTheory.Category.id_comp]
        rwa [CategoryTheory.Category.id_comp, hbot] at hp
      let _ : AlgebraicGeometry.IsProper ZP_k.hom :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_ZPk inferInstance
      have hι_P_comm : (fst_ZPbar ≫ fst_ZP) ≫ f₀.left = (ZP_k.hom ≫ xP_Dbar) ≫ pr_D := by
        rw [CategoryTheory.Category.assoc, hpb_ZP.w, ← CategoryTheory.Category.assoc, hpb_ZPk.w,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hxP_Dbar_fst]
      let ι_P_Zbar : ZP_k.left ⟶ Z_bar.left :=
        hPb_fbar.lift (fst_ZPbar ≫ fst_ZP) (ZP_k.hom ≫ xP_Dbar) hι_P_comm
      have hι_P_fst : ι_P_Zbar ≫ pr_Z = fst_ZPbar ≫ fst_ZP := hPb_fbar.lift_fst _ _ _
      have hι_P_fbar : ι_P_Zbar ≫ f_bar.left = ZP_k.hom ≫ xP_Dbar := hPb_fbar.lift_snd _ _ _
      have hι_P_snd : ι_P_Zbar ≫ Z_bar.hom = ZP_k.hom := by
        have hf_snd : f_bar.left ≫ D_bar.hom = Z_bar.hom := CategoryTheory.Over.w f_bar
        rw [← hf_snd, ← CategoryTheory.Category.assoc, hι_P_fbar, CategoryTheory.Category.assoc,
          hxP_Dbar_snd, CategoryTheory.Category.comp_id]
      have hpb_ZPk_outer : CategoryTheory.IsPullback (ι_P_Zbar ≫ pr_Z) ZP_k.hom f₀.left
          (xP_Dbar ≫ pr_D) := by
        rw [hι_P_fst, hxP_Dbar_fst]
        exact hpb_ZPk.paste_horiz hpb_ZP
      have hPb_P_Zbar : CategoryTheory.IsPullback ι_P_Zbar ZP_k.hom f_bar.left
          (x_bar ≫ U_bar.ι) := by
        rw [hx_bar_ι]
        exact CategoryTheory.IsPullback.of_right hpb_ZPk_outer hι_P_fbar hPb_fbar
      have hι_P_range : Set.range ι_P_Zbar.base ⊆ Set.range V_bar.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨z, rfl⟩
        change (ι_P_Zbar ≫ f_bar.left).base z ∈ U_bar
        rw [hι_P_fbar, ← hx_bar_ι]
        exact (x_bar.base (ZP_k.hom.base z)).2
      let ι_P : ZP_k.left ⟶ V_bar.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift V_bar.ι ι_P_Zbar hι_P_range
      have hι_P_ι : ι_P ≫ V_bar.ι = ι_P_Zbar :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac V_bar.ι ι_P_Zbar hι_P_range
      let F_ZP : ZP_k.left ⟶ ZP_k.left := weilGeomFrobHom F_P Z_P
      obtain ⟨hFZP_fst_raw, hFZP_snd_raw⟩ := hFrobPowProj F_P Z_P 1
      have hFZP1 : weilSchemeEndPow (weilGeomFrobHom F_P Z_P) 1 = F_ZP :=
        CategoryTheory.Category.comp_id _
      have hFZP_fst : F_ZP ≫ fst_ZPbar = fst_ZPbar := by
        change _ ≫ _ = _ at hFZP_fst_raw
        rwa [hFZP1] at hFZP_fst_raw
      have hFZP_snd : F_ZP ≫ ZP_bar.hom =
          ZP_bar.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_FP.toRingHom) := by
        change _ ≫ _ = _ ≫ _ at hFZP_snd_raw
        rwa [hFZP1, pow_one] at hFZP_snd_raw
      have hFrob_P : F_ZP ≫ ι_P = ι_P ≫ Φ_V_d := by
        rw [← cancel_mono V_bar.ι, CategoryTheory.Category.assoc, hι_P_ι,
          CategoryTheory.Category.assoc, hΦ_V_ι, ← CategoryTheory.Category.assoc, hι_P_ι]
        apply hPb_Zbar.hom_ext
        · rw [CategoryTheory.Category.assoc, hι_P_fst, ← CategoryTheory.Category.assoc F_ZP,
            hFZP_fst, CategoryTheory.Category.assoc ι_P_Zbar, hFZ_fst, hι_P_fst]
        · rw [CategoryTheory.Category.assoc, hι_P_snd]
          change F_ZP ≫ ZP_bar.hom ≫ e_k_FP.hom = (ι_P_Zbar ≫ F_Ztilde_d) ≫ Z_bar.hom
          rw [← CategoryTheory.Category.assoc, hFZP_snd, CategoryTheory.Category.assoc,
            CategoryTheory.Category.assoc ι_P_Zbar, hFZ_snd,
            ← CategoryTheory.Category.assoc ι_P_Zbar, hι_P_snd]
          change ZP_bar.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_FP.toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ₀.symm.toRingHom) =
            (ZP_bar.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ₀.symm.toRingHom)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_F ^ d).toRingHom)
          rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
            ← AlgebraicGeometry.Spec.map_comp]
          have hring_eq : CommRingCat.ofHom κ₀.symm.toRingHom ≫ CommRingCat.ofHom ψ_FP.toRingHom =
              CommRingCat.ofHom (ψ_F ^ d).toRingHom ≫ CommRingCat.ofHom κ₀.symm.toRingHom :=
            CommRingCat.hom_ext (RingHom.ext fun z => (hκ_frob z).symm)
          rw [hring_eq]

      
      have hPBC : WeilProperModPrimeBaseChangeHolds (AlgebraicClosure F) ℓ :=
        weil_etale_proper_base_change_mod_prime (AlgebraicClosure F) ℓ hℓ_k
      have hP1 : WeilP1ConstructiblePushforwardHolds (AlgebraicClosure F) ℓ :=
        weil_etale_p1_constructible_pushforward (AlgebraicClosure F) ℓ hℓ_k
          (fun k₀ _ _ C _ hIntC hProjC hℓ₀ =>
            weil_etale_smooth_proj_curve_mod_prime_cohomology k₀ C hIntC hProjC ℓ hℓ₀) hPBC
      have hF_Zbar : WeilIsConstructibleModPrimeSheaf ℓ Z_bar.left
          (weilEtaleTorsionSheaf Z_bar.left ℓ) :=
        (weil_etale_constructible_mod_prime_extraction_over_algClosed
          (AlgebraicClosure F) Z_bar ℓ 0).1
      have hConstruct : ∀ q : ℕ, WeilIsConstructibleModPrimeSheaf ℓ D_bar.left
          (weilEtaleHigherDirectImage f_bar.left q (weilEtaleTorsionSheaf Z_bar.left ℓ)) :=
        fun q => weil_etale_proper_constructible_pushforward (AlgebraicClosure F) ℓ hℓ_k
          hPBC hP1 Z_bar D_bar f_bar inferInstance (weilEtaleTorsionSheaf Z_bar.left ℓ) hF_Zbar q
      have hLocConst : ∀ q ≤ j,
          ∃ (A₀ : AddCommGrpCat.{u}) (_ : Finite ↥A₀),
            ∀ x : ↥D_bar.left,
              ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ D_bar.left),
                AlgebraicGeometry.Etale w ∧
                x ∈ Set.range w.base ∧
                WeilIsEtaleSheafPullback w
                  (weilEtaleHigherDirectImage f_bar.left q (weilEtaleTorsionSheaf Z_bar.left ℓ))
                  ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀) :=
        fun q hq => (weil_sing_dev_outer_tr_mod_prime_low_deg_locConst F m hm Z_tilde hProj_Ztilde
          f₀ hFibIrred u₀ hu₀_sec j_aff s_inf S_aff U₀ h1d ℓ hℓ f_bar hPb_fbar e_P hPBC
          hConstruct q (hq.trans hj_le)).1
      have hKerConst : ∀ q ≤ j,
          ∀ (B : AddCommGrpCat.{u}) [Finite ↥B]
            (φ : ((CategoryTheory.constantSheaf D_bar.left.smallEtaleTopology
              AddCommGrpCat.{u}).obj B) ⟶
              weilEtaleHigherDirectImage f_bar.left (q + 1) (weilEtaleTorsionSheaf Z_bar.left ℓ)),
            ∃ (B₀ : AddCommGrpCat.{u}) (_ : Finite ↥B₀),
              Nonempty (((CategoryTheory.constantSheaf D_bar.left.smallEtaleTopology
                AddCommGrpCat.{u}).obj B₀) ≅ CategoryTheory.Limits.kernel φ) :=
        fun q hq B _ φ => (weil_sing_dev_outer_tr_mod_prime_low_deg_locConst F m hm Z_tilde
          hProj_Ztilde f₀ hFibIrred u₀ hu₀_sec j_aff s_inf S_aff U₀ h1d ℓ hℓ f_bar hPb_fbar
          e_P hPBC hConstruct q (hq.trans hj_le)).2 B φ

      obtain ⟨hPullEx, hPullId, hPullComp, hPullTrans, hPullFrob⟩ :=
        weil_etale_torsion_pullback_functoriality
      let p₁ : ∀ r : ℕ, weilEtaleTorsionH V_bar.toScheme (ℓ ^ r) j →+
          weilEtaleTorsionH Zu_k.left (ℓ ^ r) j :=
        fun r => Classical.choose (hPullEx ι_u (ℓ ^ r) j)
      have hp₁ : ∀ r : ℕ, WeilIsTorsionEtalePullback ι_u (ℓ ^ r) j (p₁ r) :=
        fun r => Classical.choose_spec (hPullEx ι_u (ℓ ^ r) j)
      let p₂ : ∀ r : ℕ, weilEtaleTorsionH V_bar.toScheme (ℓ ^ r) j →+
          weilEtaleTorsionH ZP_k.left (ℓ ^ r) j :=
        fun r => Classical.choose (hPullEx ι_P (ℓ ^ r) j)
      have hp₂ : ∀ r : ℕ, WeilIsTorsionEtalePullback ι_P (ℓ ^ r) j (p₂ r) :=
        fun r => Classical.choose_spec (hPullEx ι_P (ℓ ^ r) j)
      let p_Φ : ∀ r : ℕ, weilEtaleTorsionH V_bar.toScheme (ℓ ^ r) j →+
          weilEtaleTorsionH V_bar.toScheme (ℓ ^ r) j :=
        fun r => Classical.choose (hPullEx Φ_V_d (ℓ ^ r) j)
      have hp_Φ : ∀ r : ℕ, WeilIsTorsionEtalePullback Φ_V_d (ℓ ^ r) j (p_Φ r) :=
        fun r => Classical.choose_spec (hPullEx Φ_V_d (ℓ ^ r) j)

      have hy₁ : (u_bar ≫ U_bar.ι) ≫ D_bar.hom = 𝟙 _ := by rw [hu_bar_ι, hu₀_Dbar_snd]
      have hy₂ : (x_bar ≫ U_bar.ι) ≫ D_bar.hom = 𝟙 _ := by rw [hx_bar_ι, hxP_Dbar_snd]
      have hPb₁ : CategoryTheory.IsPullback (ι_u ≫ V_bar.ι) Zu_k.hom f_bar.left
          (u_bar ≫ U_bar.ι) := by
        rw [hι_u_ι]
        exact hPb_u_Zbar
      have hPb₂ : CategoryTheory.IsPullback (ι_P ≫ V_bar.ι) ZP_k.hom f_bar.left
          (x_bar ≫ U_bar.ι) := by
        rw [hι_P_ι]
        exact hPb_P_Zbar
      have hEquiv_r : ∀ r : ℕ,
          Function.Surjective (p₁ r) ∧ Function.Surjective (p₂ r) ∧
          ∀ w : weilEtaleTorsionH V_bar.toScheme (ℓ ^ r) j,
            (p₁ r w = 0 ↔ p₂ r w = 0) :=
        fun r => weil_sing_dev_outer_tr_prime_power_fiber_pullback_equiv (AlgebraicClosure F) ℓ
          hℓ_k Z_bar D_bar f_bar hPBC hSimpConn hH1_D j hLocConst hKerConst U_bar hU_ne hH_aff
          u_bar x_bar hy₁ hy₂ Zu_k ZP_k ι_u ι_P hPb₁ hPb₂ r (p₁ r) (p₂ r) (hp₁ r) (hp₂ r)

      have hEq_iff : ∀ (r : ℕ) (w w' : weilEtaleTorsionH V_bar.toScheme (ℓ ^ r) j),
          p₁ r w = p₁ r w' ↔ p₂ r w = p₂ r w' := by
        intro r w w'
        rw [← sub_eq_zero, ← map_sub, (hEquiv_r r).2.2 (w - w'), map_sub, sub_eq_zero]
      let e_tors : ∀ r : ℕ,
          weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ r) j ≃+
            weilEtaleTorsionH (weilGeomScheme F_P Z_P) (ℓ ^ r) j := fun r =>
        { toFun := fun u => p₂ r (Function.surjInv (hEquiv_r r).1 u)
          invFun := fun v => p₁ r (Function.surjInv (hEquiv_r r).2.1 v)
          left_inv := fun u => by
            set w := Function.surjInv (hEquiv_r r).1 u
            have hw : p₁ r w = u := Function.surjInv_eq (hEquiv_r r).1 u
            have hw₂ : p₂ r (Function.surjInv (hEquiv_r r).2.1 (p₂ r w)) = p₂ r w :=
              Function.surjInv_eq (hEquiv_r r).2.1 (p₂ r w)
            exact ((hEq_iff r _ w).mpr hw₂).trans hw
          right_inv := fun v => by
            set w := Function.surjInv (hEquiv_r r).2.1 v
            have hw : p₂ r w = v := Function.surjInv_eq (hEquiv_r r).2.1 v
            have hw₁ : p₁ r (Function.surjInv (hEquiv_r r).1 (p₁ r w)) = p₁ r w :=
              Function.surjInv_eq (hEquiv_r r).1 (p₁ r w)
            exact ((hEq_iff r _ w).mp hw₁).trans hw
          map_add' := fun u₁ u₂ => by
            set w₁ := Function.surjInv (hEquiv_r r).1 u₁
            set w₂ := Function.surjInv (hEquiv_r r).1 u₂
            have hw₁ : p₁ r w₁ = u₁ := Function.surjInv_eq (hEquiv_r r).1 u₁
            have hw₂ : p₁ r w₂ = u₂ := Function.surjInv_eq (hEquiv_r r).1 u₂
            have hsum : p₁ r (Function.surjInv (hEquiv_r r).1 (u₁ + u₂)) = p₁ r (w₁ + w₂) := by
              rw [Function.surjInv_eq (hEquiv_r r).1 (u₁ + u₂), map_add, hw₁, hw₂]
            rw [(hEq_iff r _ (w₁ + w₂)).mp hsum, map_add] }
      have he_tors_p : ∀ (r : ℕ) (w : weilEtaleTorsionH V_bar.toScheme (ℓ ^ r) j),
          e_tors r (p₁ r w) = p₂ r w := by
        intro r w
        change p₂ r (Function.surjInv (hEquiv_r r).1 (p₁ r w)) = p₂ r w
        exact (hEq_iff r _ w).mp (Function.surjInv_eq (hEquiv_r r).1 (p₁ r w))

      have he_tors_trans : ∀ (r : ℕ)
          (u : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) j),
          weilEtaleTorsionTransition (weilGeomScheme F_P Z_P) ℓ r j (e_tors (r + 1) u) =
            e_tors r (weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ r j u) := by
        intro r u
        obtain ⟨w, rfl⟩ := (hEquiv_r (r + 1)).1 u
        have htr₁ : weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ r j (p₁ (r + 1) w) =
            p₁ r (weilEtaleTorsionTransition V_bar.toScheme ℓ r j w) :=
          DFunLike.congr_fun
            (hPullTrans ι_u ℓ r j (p₁ (r + 1)) (p₁ r) (hp₁ (r + 1)) (hp₁ r)) w
        have htr₂ : weilEtaleTorsionTransition (weilGeomScheme F_P Z_P) ℓ r j (p₂ (r + 1) w) =
            p₂ r (weilEtaleTorsionTransition V_bar.toScheme ℓ r j w) :=
          DFunLike.congr_fun
            (hPullTrans ι_P ℓ r j (p₂ (r + 1)) (p₂ r) (hp₂ (r + 1)) (hp₂ r)) w
        rw [he_tors_p (r + 1) w, htr₂, ← he_tors_p r _, htr₁]

      have he_tors_frob : ∀ (r : ℕ)
          (u : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ r) j),
          e_tors r ((⇑(M_uj.frobTorsion r))^[d] u) =
            M_Pj.frobTorsion r (e_tors r u) := by
        intro r u
        obtain ⟨p_gu, hp_gu⟩ := hPullEx (weilGeomFrobHom F Z_u₀) (ℓ ^ r) j
        have hf_gu : M_uj.frobTorsion r = p_gu :=
          hPullFrob F Z_u₀ (ℓ ^ r) j (M_uj.frobTorsion r) p_gu (M_uj.hfrobTorsion r) hp_gu
        have hp_frob_u : WeilIsTorsionEtalePullback (weilGeomFrobHom F Z_u₀) (ℓ ^ r) j
            (M_uj.frobTorsion r) := hf_gu ▸ hp_gu
        have hPowPull : ∀ n : ℕ,
            ∃ p_n : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ r) j →+
                weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ r) j,
              WeilIsTorsionEtalePullback (weilSchemeEndPow (weilGeomFrobHom F Z_u₀) n) (ℓ ^ r) j
                p_n ∧
              ∀ x, p_n x = (⇑(M_uj.frobTorsion r))^[n] x := by
          intro n
          induction n with
          | zero =>
            obtain ⟨p₀, hp₀⟩ :=
              hPullEx (CategoryTheory.CategoryStruct.id (weilGeomScheme F Z_u₀)) (ℓ ^ r) j
            have hp₀_id := hPullId (ℓ ^ r) j p₀ hp₀
            refine ⟨p₀, hp₀, fun x => ?_⟩
            rw [hp₀_id]
            rfl
          | succ n ih =>
            obtain ⟨p_n, hp_n, hp_n_eq⟩ := ih
            obtain ⟨p_succ, hp_succ⟩ := hPullEx
              (CategoryTheory.CategoryStruct.comp (weilGeomFrobHom F Z_u₀)
                (weilSchemeEndPow (weilGeomFrobHom F Z_u₀) n)) (ℓ ^ r) j
            have hcomp := hPullComp (weilGeomFrobHom F Z_u₀)
              (weilSchemeEndPow (weilGeomFrobHom F Z_u₀) n) (ℓ ^ r) j
              (M_uj.frobTorsion r) p_n p_succ hp_frob_u hp_n hp_succ
            refine ⟨p_succ, hp_succ, fun x => ?_⟩
            rw [hcomp, AddMonoidHom.comp_apply, hp_n_eq x, Function.iterate_succ_apply']
        obtain ⟨p_ud, hp_ud, hp_ud_eq⟩ := hPowPull d
        obtain ⟨p_comm_u, hp_comm_u⟩ := hPullEx (F_Zu_d ≫ ι_u) (ℓ ^ r) j
        have hp_comm_u' : WeilIsTorsionEtalePullback (ι_u ≫ Φ_V_d) (ℓ ^ r) j p_comm_u :=
          hFrob_u ▸ hp_comm_u
        have hcomp_u1 := hPullComp F_Zu_d ι_u (ℓ ^ r) j p_ud (p₁ r) p_comm_u hp_ud (hp₁ r) hp_comm_u
        have hcomp_u2 := hPullComp ι_u Φ_V_d (ℓ ^ r) j (p₁ r) (p_Φ r) p_comm_u
          (hp₁ r) (hp_Φ r) hp_comm_u'
        have hu_inter : p_ud.comp (p₁ r) = (p₁ r).comp (p_Φ r) := hcomp_u1.symm.trans hcomp_u2

        obtain ⟨p_gP, hp_gP⟩ := hPullEx (weilGeomFrobHom F_P Z_P) (ℓ ^ r) j
        have hf_gP : M_Pj.frobTorsion r = p_gP :=
          hPullFrob F_P Z_P (ℓ ^ r) j (M_Pj.frobTorsion r) p_gP (M_Pj.hfrobTorsion r) hp_gP
        have hp_frob_P : WeilIsTorsionEtalePullback F_ZP (ℓ ^ r) j (M_Pj.frobTorsion r) :=
          hf_gP ▸ hp_gP
        obtain ⟨p_comm_P, hp_comm_P⟩ := hPullEx (F_ZP ≫ ι_P) (ℓ ^ r) j
        have hp_comm_P' : WeilIsTorsionEtalePullback (ι_P ≫ Φ_V_d) (ℓ ^ r) j p_comm_P :=
          hFrob_P ▸ hp_comm_P
        have hcomp_P1 := hPullComp F_ZP ι_P (ℓ ^ r) j (M_Pj.frobTorsion r) (p₂ r) p_comm_P
          hp_frob_P (hp₂ r) hp_comm_P
        have hcomp_P2 := hPullComp ι_P Φ_V_d (ℓ ^ r) j (p₂ r) (p_Φ r) p_comm_P
          (hp₂ r) (hp_Φ r) hp_comm_P'
        have hP_inter : (M_Pj.frobTorsion r).comp (p₂ r) = (p₂ r).comp (p_Φ r) :=
          hcomp_P1.symm.trans hcomp_P2

        obtain ⟨w, rfl⟩ := (hEquiv_r r).1 u
        have hw_u := DFunLike.congr_fun hu_inter w
        have hw_P := DFunLike.congr_fun hP_inter w
        simp only [AddMonoidHom.comp_apply] at hw_u hw_P
        rw [← hp_ud_eq (p₁ r w), hw_u, he_tors_p r (p_Φ r w), ← hw_P, he_tors_p r w]

      have hfrobT_u_trans : ∀ (r : ℕ)
          (u : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) j),
          weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ r j
            (M_uj.frobTorsion (r + 1) u) =
            M_uj.frobTorsion r
              (weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ r j u) :=
        fun r u => (weil_etale_module_ext_comparison.2.2 F Z_u₀).2.1 ℓ r j
          (M_uj.frobTorsion (r + 1)) (M_uj.frobTorsion r)
          (M_uj.hfrobTorsion (r + 1)) (M_uj.hfrobTorsion r) u

      exact hAbstractEquiv ℓ d
        (fun r => weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ r) j)
        (fun r => weilEtaleTorsionH (weilGeomScheme F_P Z_P) (ℓ ^ r) j)
        (fun r => weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ r j)
        (fun r => weilEtaleTorsionTransition (weilGeomScheme F_P Z_P) ℓ r j)
        (weilEtaleIntegralSystem (weilGeomScheme F Z_u₀) ℓ j)
        (weilEtaleIntegralSystem (weilGeomScheme F_P Z_P) ℓ j)
        (hMemIntegral (weilGeomScheme F Z_u₀) ℓ j)
        (hMemIntegral (weilGeomScheme F_P Z_P) ℓ j)
        (hTorsionZMod (weilGeomScheme F Z_u₀) ℓ j).2
        M_uj.frobTorsion M_Pj.frobTorsion hfrobT_u_trans
        M_uj.V M_Pj.V M_uj.frob M_Pj.frob M_uj.equiv M_Pj.equiv
        M_uj.hsmul M_Pj.hsmul M_uj.hfrob M_Pj.hfrob
        e_tors he_tors_trans he_tors_frob

  
  by_cases hi_low : i ≤ 2 * m
  · obtain ⟨e_i, he_i⟩ := hLowEquiv i hi_low M_Zu_i M_ZP_i
    have hconj : e_i.conj (M_Zu_i.frob ^ d) = M_ZP_i.frob := by
      ext v
      change e_i ((M_Zu_i.frob ^ d) (e_i.symm v)) = M_ZP_i.frob v
      rw [he_i, e_i.apply_symm_apply]
    have hconj_pow : ∀ s : ℕ, e_i.conj ((M_Zu_i.frob ^ d) ^ s) = M_ZP_i.frob ^ s := by
      intro s
      induction s with
      | zero =>
        ext v
        simp [LinearEquiv.conj_apply]
      | succ s ih =>
        rw [pow_succ', pow_succ', Module.End.mul_eq_comp, Module.End.mul_eq_comp,
          LinearEquiv.conj_comp, hconj, ih]
    rw [← hconj_pow k]
    exact LinearMap.trace_conj' ((M_Zu_i.frob ^ d) ^ k) e_i
  · have hi_high : 2 * m + 2 ≤ i := by omega
    set j := 2 * (2 * m + 1) - i
    have hj_le : j ≤ 2 * m := by omega
    have ⟨M_Zu_j⟩ := weil_etale_model_of_torsion_finite F Z_u₀ ℓ j
      (fun r => weil_etale_proper_torsion_finiteness F Z_u₀ (2 * m + 1) ℓ hℓ j r)
    have ⟨M_ZP_j⟩ := weil_etale_model_of_torsion_finite F_P Z_P ℓ j
      (fun r => weil_etale_proper_torsion_finiteness F_P Z_P (2 * m + 1) ℓ hℓ_P j r)
    obtain ⟨e_j, he_j⟩ := hLowEquiv j hj_le M_Zu_j M_ZP_j
    obtain ⟨B_u, hBu_bij, hBu_pair⟩ :=
      weil_etale_poincare_duality_pairing F Z_u₀ (2 * m + 1) ℓ hℓ i hi_le M_Zu_i M_Zu_j
    obtain ⟨B_P, hBP_bij, hBP_pair⟩ :=
      weil_etale_poincare_duality_pairing F_P Z_P (2 * m + 1) ℓ hℓ_P i hi_le M_ZP_i M_ZP_j
    have hq_F : 1 < Nat.card F := Finite.one_lt_card
    have hq_FP : 1 < Nat.card F_P := Finite.one_lt_card
    let c_u : Padic ℓ := (Nat.card F : Padic ℓ) ^ (2 * m + 1)
    let c_P : Padic ℓ := (Nat.card F_P : Padic ℓ) ^ (2 * m + 1)
    have hcu_ne : c_u ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.mpr (by omega))
    have hcP_ne : c_P ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.mpr (by omega))
    obtain ⟨Ψ_u, hΨu_eq, hTr_u⟩ :=
      hDualTrace (Padic ℓ) M_Zu_i.V M_Zu_j.V M_Zu_i.frob M_Zu_j.frob c_u hcu_ne B_u hBu_bij hBu_pair
    obtain ⟨Ψ_P, hΨP_eq, hTr_P⟩ :=
      hDualTrace (Padic ℓ) M_ZP_i.V M_ZP_j.V M_ZP_i.frob M_ZP_j.frob c_P hcP_ne B_P hBP_bij hBP_pair
    let g_u : M_Zu_j.V →ₗ[Padic ℓ] M_Zu_j.V := Ψ_u.symm.toLinearMap
    let g_P : M_ZP_j.V →ₗ[Padic ℓ] M_ZP_j.V := Ψ_P.symm.toLinearMap
    have hfu_gu : ∀ (n : ℕ) (v : M_Zu_j.V), (M_Zu_j.frob ^ n) ((g_u ^ n) v) = v := by
      intro n
      induction n with
      | zero =>
        intro v
        rfl
      | succ n ih =>
        intro v
        rw [pow_succ', pow_succ, Module.End.mul_apply, Module.End.mul_apply, ih (g_u v),
          ← hΨu_eq]
        exact Ψ_u.apply_symm_apply v
    have he_inv : ∀ v : M_Zu_j.V, e_j ((g_u ^ d) v) = g_P (e_j v) := by
      intro v
      apply Ψ_P.injective
      change Ψ_P.toLinearMap (e_j ((g_u ^ d) v)) = Ψ_P (Ψ_P.symm (e_j v))
      rw [hΨP_eq, ← he_j, hfu_gu d v, Ψ_P.apply_symm_apply]
    have hconj_inv : e_j.conj (g_u ^ d) = g_P := by
      ext w
      change e_j ((g_u ^ d) (e_j.symm w)) = g_P w
      rw [he_inv, e_j.apply_symm_apply]
    have hconj_inv_pow : ∀ s : ℕ, e_j.conj ((g_u ^ d) ^ s) = g_P ^ s := by
      intro s
      induction s with
      | zero =>
        ext w
        simp [LinearEquiv.conj_apply]
      | succ s ih =>
        rw [pow_succ', pow_succ', Module.End.mul_eq_comp, Module.End.mul_eq_comp,
          LinearEquiv.conj_comp, hconj_inv, ih]
    have htr_inv : LinearMap.trace (Padic ℓ) M_ZP_j.V (g_P ^ k) =
        LinearMap.trace (Padic ℓ) M_Zu_j.V (g_u ^ (d * k)) := by
      rw [← hconj_inv_pow k, LinearMap.trace_conj', ← pow_mul]
    have hc_pow : c_P ^ k = c_u ^ (d * k) := by
      dsimp [c_P, c_u]
      rw [hcard_FP]
      push_cast
      ring
    rw [hTr_P k, ← pow_mul M_Zu_i.frob d k, hTr_u (d * k), hc_pow, htr_inv]

theorem weil_p1_constant_field_galois_intermediate_setup (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∀ (B_r L_r : Type u) [CommRing B_r] [IsDomain B_r] [Field L_r]
      [Algebra F B_r] [Algebra (Polynomial F) B_r] [Algebra R₀ B_r]
      [Algebra F L_r] [Algebra (Polynomial F) L_r] [Algebra (RatFunc F) L_r]
      [Algebra B_r L_r] [Algebra R₀ L_r]
      [IsScalarTower F (Polynomial F) B_r] [IsScalarTower (Polynomial F) R₀ B_r]
      [IsScalarTower F (RatFunc F) L_r] [IsScalarTower (Polynomial F) (RatFunc F) L_r]
      [IsScalarTower (Polynomial F) B_r L_r] [IsScalarTower R₀ B_r L_r]
      [IsFractionRing B_r L_r] [IsIntegralClosure B_r R₀ L_r]
      [FiniteDimensional (RatFunc F) L_r] [IsGalois (RatFunc F) L_r]
      (N_B : Subgroup (B_r ≃ₐ[R₀] B_r)),
      (∀ σ ∈ N_B, ∀ x : B_r, IsIntegral F x → σ x = x) →
      (∀ τ : B_r ≃ₐ[R₀] B_r, (∀ x : B_r, IsIntegral F x → τ x = x) →
        ∀ σ ∈ N_B, τ * σ * τ⁻¹ ∈ N_B) →
      ∃ (k E : Type u) (_ : Finite k) (_ : Field k) (_ : Field E)
        (_ : Algebra F k) (_ : Algebra k L_r) (_ : Algebra F E) (_ : Algebra k E)
        (_ : Algebra (Polynomial k) E) (_ : Algebra (RatFunc k) E)
        (_ : Algebra (Polynomial k) L_r) (_ : Algebra (RatFunc k) L_r)
        (_ : Algebra E L_r)
        (_ : IsScalarTower F k E) (_ : IsScalarTower F k L_r)
        (_ : IsScalarTower k (Polynomial k) E) (_ : IsScalarTower k (RatFunc k) E)
        (_ : IsScalarTower (Polynomial k) (RatFunc k) E)
        (_ : IsScalarTower k (Polynomial k) L_r) (_ : IsScalarTower k (RatFunc k) L_r)
        (_ : IsScalarTower (Polynomial k) (RatFunc k) L_r)
        (_ : IsScalarTower k E L_r) (_ : IsScalarTower (Polynomial k) E L_r)
        (_ : IsScalarTower (RatFunc k) E L_r)
        (_ : FiniteDimensional (RatFunc k) L_r) (_ : IsGalois (RatFunc k) L_r)
        (_ : FiniteDimensional (RatFunc k) E) (_ : IsGalois (RatFunc k) E),
        algebraMap (RatFunc k) L_r RatFunc.X = algebraMap (RatFunc F) L_r RatFunc.X ∧
        (∀ c : k, IsIntegral F (algebraMap k L_r c)) ∧
        (∀ x : E, IsIntegral k x → x ∈ Set.range (algebraMap k E)) ∧
        (Module.finrank (RatFunc k) E = 1 →
          ∀ σ_B : B_r ≃ₐ[R₀] B_r, (∀ x : B_r, IsIntegral F x → σ_B x = x) → σ_B ∈ N_B) ∧
        (∀ σ_K : L_r ≃ₐ[RatFunc k] L_r,
          ∃ (σ_L : L_r ≃ₐ[RatFunc F] L_r) (σ_B : B_r ≃ₐ[R₀] B_r),
            (∀ y : L_r, σ_L y = σ_K y) ∧
            (∀ x : L_r, IsIntegral F x → σ_L x = x) ∧
            (∀ b : B_r, σ_L (algebraMap B_r L_r b) = algebraMap B_r L_r (σ_B b)) ∧
            (σ_B ∈ N_B → ∀ x : E, σ_K (algebraMap E L_r x) = algebraMap E L_r x)) :=
by
  intro R₀ B_r L_r _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ N_B hNB_geom hNB_norm
  classical
  let Δ_aff : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s)
  have hΔ_monic : Δ_aff.Monic :=
    Polynomial.monic_prod_of_monic S_aff _ (fun s _ => Polynomial.monic_X_sub_C s)
  have hΔ_ne : Δ_aff ≠ 0 := hΔ_monic.ne_zero
  have hΔ_nzd : Δ_aff ∈ nonZeroDivisors (Polynomial F) := mem_nonZeroDivisors_of_ne_zero hΔ_ne
  have hM_le : Submonoid.powers Δ_aff ≤ nonZeroDivisors (Polynomial F) :=
    Submonoid.powers_le.mpr hΔ_nzd
  let _ : IsDomain R₀ := IsLocalization.isDomain_localization hM_le
  have hΔ_rf_ne : algebraMap (Polynomial F) (RatFunc F) Δ_aff ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective (Polynomial F) (RatFunc F))).mpr hΔ_ne
  have hΔ_unit : IsUnit (algebraMap (Polynomial F) (RatFunc F) Δ_aff) := IsUnit.mk0 _ hΔ_rf_ne
  let j_R₀ : R₀ →+* RatFunc F := IsLocalization.Away.lift Δ_aff hΔ_unit
  let _ : Algebra R₀ (RatFunc F) := j_R₀.toAlgebra
  have hj_R₀_eq : ∀ p : Polynomial F,
      algebraMap R₀ (RatFunc F) (algebraMap (Polynomial F) R₀ p) =
        algebraMap (Polynomial F) (RatFunc F) p :=
    fun p => IsLocalization.Away.lift_eq Δ_aff hΔ_unit p
  let _ : IsScalarTower (Polynomial F) R₀ (RatFunc F) :=
    IsScalarTower.of_algebraMap_eq fun p => (hj_R₀_eq p).symm
  let _ : IsFractionRing R₀ (RatFunc F) :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization
      (Submonoid.powers Δ_aff) R₀ (RatFunc F)
  let _ : IsScalarTower R₀ (RatFunc F) L_r := by
    apply IsScalarTower.of_algebraMap_eq'
    apply IsLocalization.ringHom_ext (Submonoid.powers Δ_aff)
    refine RingHom.ext fun p => ?_
    simp only [RingHom.comp_apply, hj_R₀_eq,
      ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r,
      IsScalarTower.algebraMap_apply R₀ B_r L_r,
      ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B_r,
      ← IsScalarTower.algebraMap_apply (Polynomial F) B_r L_r]
  let _ : IsScalarTower F (Polynomial F) L_r := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply F (RatFunc F) L_r,
      IsScalarTower.algebraMap_apply F (Polynomial F) (RatFunc F),
      ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r]
  let _ : IsScalarTower F B_r L_r := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply F (Polynomial F) L_r,
      IsScalarTower.algebraMap_apply (Polynomial F) B_r L_r,
      ← IsScalarTower.algebraMap_apply F (Polynomial F) B_r]
  let _ : IsScalarTower F R₀ L_r := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply F (Polynomial F) L_r,
      IsScalarTower.algebraMap_apply (Polynomial F) B_r L_r,
      IsScalarTower.algebraMap_apply (Polynomial F) R₀ B_r,
      ← IsScalarTower.algebraMap_apply R₀ B_r L_r,
      ← IsScalarTower.algebraMap_apply F (Polynomial F) R₀]
  let _ : Algebra.IsAlgebraic (RatFunc F) L_r := Algebra.IsAlgebraic.of_finite (RatFunc F) L_r
  let res_B : (L_r ≃ₐ[RatFunc F] L_r) ≃* (B_r ≃ₐ[R₀] B_r) :=
    galRestrict R₀ (RatFunc F) L_r B_r
  have hres_B_apply : ∀ (σ_L : L_r ≃ₐ[RatFunc F] L_r) (b : B_r),
      algebraMap B_r L_r (res_B σ_L b) = σ_L (algebraMap B_r L_r b) :=
    fun σ_L b => algebraMap_galRestrict_apply R₀ σ_L b
  have hFixedEquiv : ∀ σ_L : L_r ≃ₐ[RatFunc F] L_r,
      (∀ x : L_r, _root_.IsIntegral F x → σ_L x = x) ↔
        (∀ b : B_r, _root_.IsIntegral F b → res_B σ_L b = b) := by
    intro σ_L
    constructor
    · intro hL b hb
      have hb_L : _root_.IsIntegral F (algebraMap B_r L_r b) :=
        hb.map (IsScalarTower.toAlgHom F B_r L_r)
      apply IsFractionRing.injective B_r L_r
      rw [hres_B_apply, hL _ hb_L]
    · intro hB x hx
      have hx_R₀ : _root_.IsIntegral R₀ x := _root_.IsIntegral.tower_top hx
      obtain ⟨b, rfl⟩ := (IsIntegralClosure.isIntegral_iff (A := B_r)).mp hx_R₀
      have hb_F : _root_.IsIntegral F b :=
        (isIntegral_algHom_iff (IsScalarTower.toAlgHom F B_r L_r)
          (IsFractionRing.injective B_r L_r)).mp hx
      rw [← hres_B_apply, hB b hb_F]
  let F_const : IntermediateField F L_r := algebraicClosure F L_r
  let k : Type u := ↥F_const
  let _ : IsIntegralClosure k F L_r := algebraicClosure.isIntegralClosure F L_r
  let _ : Algebra.IsIntegral F k := IsIntegralClosure.isIntegral_algebra F L_r
  have hk_int : ∀ c : k, _root_.IsIntegral F (algebraMap k L_r c) :=
    fun c => (IsIntegralClosure.isIntegral_iff (A := k)).mpr ⟨c, rfl⟩
  let x₀ : L_r := algebraMap (RatFunc F) L_r RatFunc.X
  let φ₀ : Polynomial k →ₐ[k] L_r := Polynomial.aeval x₀
  have hφ₀_inj : Function.Injective φ₀ := by
    rw [injective_iff_map_eq_zero]
    intro Q hQ0
    by_contra hQ_ne
    have hx₀_alg : IsAlgebraic k x₀ := ⟨Q, hQ_ne, hQ0⟩
    have hx₀_int_k : _root_.IsIntegral k x₀ := isAlgebraic_iff_isIntegral.mp hx₀_alg
    have hx₀_int_F : _root_.IsIntegral F x₀ := isIntegral_trans x₀ hx₀_int_k
    have hX_int_F : _root_.IsIntegral F (RatFunc.X : RatFunc F) :=
      (isIntegral_algHom_iff (IsScalarTower.toAlgHom F (RatFunc F) L_r)
        (algebraMap (RatFunc F) L_r).injective).mp hx₀_int_F
    obtain ⟨P, hP_ne, hP_eval⟩ := isAlgebraic_iff_isIntegral.mpr hX_int_F
    rw [← RatFunc.algebraMap_X, Polynomial.aeval_algebraMap_apply,
      Polynomial.aeval_X_left_apply] at hP_eval
    exact hP_ne (IsFractionRing.injective (Polynomial F) (RatFunc F)
      (hP_eval.trans (map_zero _).symm))
  have h_aeval_F : ∀ f : Polynomial F, Polynomial.aeval x₀ f = algebraMap (Polynomial F) L_r f := by
    intro f
    have heq : (Polynomial.aeval x₀ : Polynomial F →ₐ[F] L_r) =
        IsScalarTower.toAlgHom F (Polynomial F) L_r := by
      apply Polynomial.algHom_ext
      simp only [Polynomial.aeval_X, IsScalarTower.toAlgHom_apply, x₀, ← RatFunc.algebraMap_X,
        IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r]
    exact AlgHom.congr_fun heq f
  let ι := Module.Basis.ofVectorSpaceIndex F k
  let b_k : Module.Basis ι F k := Module.Basis.ofVectorSpace F k
  have hb_lin : LinearIndependent (RatFunc F) (fun i : ι => algebraMap k L_r (b_k i)) := by
    rw [linearIndependent_iff']
    intro s g hsum i₀ hi₀
    obtain ⟨d, hd⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors (Polynomial F)) s g
    let p : ι → Polynomial F := fun i =>
      if hi : i ∈ s then Classical.choose (hd i hi) else 0
    have hp : ∀ i (hi : i ∈ s),
        algebraMap (Polynomial F) (RatFunc F) (p i) =
          algebraMap (Polynomial F) (RatFunc F) (d : Polynomial F) * g i := by
      intro i hi
      simp only [p, hi, ↓reduceDIte]
      exact (Classical.choose_spec (hd i hi)).trans (Algebra.smul_def (d : Polynomial F) (g i))
    let Q : Polynomial k := ∑ i ∈ s, (p i).map (algebraMap F k) * Polynomial.C (b_k i)
    have hφ₀_Q : φ₀ Q = 0 := by
      dsimp only [Q, φ₀]
      rw [map_sum]
      have hterm : ∀ i ∈ s,
          Polynomial.aeval x₀ ((p i).map (algebraMap F k) * Polynomial.C (b_k i)) =
            algebraMap (Polynomial F) L_r (d : Polynomial F) *
              (g i • algebraMap k L_r (b_k i)) := by
        intro i hi
        rw [map_mul, Polynomial.aeval_map_algebraMap k x₀ (p i), h_aeval_F (p i),
          Polynomial.aeval_C, IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r (p i),
          hp i hi, map_mul, ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r,
          Algebra.smul_def, mul_assoc]
      rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum, hsum, mul_zero]
    have hQ_zero : Q = 0 := hφ₀_inj (hφ₀_Q.trans (map_zero φ₀).symm)
    have hp_zero : p i₀ = 0 := by
      ext n
      rw [Polynomial.coeff_zero]
      have hcoeff : Q.coeff n = ∑ i ∈ s, ((p i).coeff n) • b_k i := by
        dsimp only [Q]
        rw [Polynomial.finsetSum_coeff]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Polynomial.coeff_mul_C, Polynomial.coeff_map, ← Algebra.smul_def]
      rw [hQ_zero, Polynomial.coeff_zero] at hcoeff
      exact linearIndependent_iff'.mp b_k.linearIndependent s
        (fun i => (p i).coeff n) hcoeff.symm i₀ hi₀
    have hd_ne : (d : Polynomial F) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp d.2
    have hd_rf_ne : algebraMap (Polynomial F) (RatFunc F) (d : Polynomial F) ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective (Polynomial F) (RatFunc F))).mpr hd_ne
    have hmul0 := hp i₀ hi₀
    rw [hp_zero, map_zero] at hmul0
    exact (mul_eq_zero.mp hmul0.symm).resolve_left hd_rf_ne
  let _ : Finite ι := hb_lin.finite
  let _ : Module.Finite F k := Module.Finite.of_basis b_k
  let _ : Finite k := Module.finite_of_finite F
  let ι_K : RatFunc k →ₐ[k] L_r := IsFractionRing.liftAlgHom (K := RatFunc k) hφ₀_inj
  let _ : Algebra (Polynomial k) L_r := φ₀.toRingHom.toAlgebra
  let _ : Algebra (RatFunc k) L_r := ι_K.toRingHom.toAlgebra
  let _ : IsScalarTower k (Polynomial k) L_r :=
    IsScalarTower.of_algebraMap_eq fun c => (φ₀.commutes c).symm
  let _ : IsScalarTower k (RatFunc k) L_r :=
    IsScalarTower.of_algebraMap_eq fun c => (ι_K.commutes c).symm
  let _ : IsScalarTower (Polynomial k) (RatFunc k) L_r :=
    IsScalarTower.of_algebraMap_eq fun p =>
      ((IsFractionRing.liftAlgHom_apply (K := RatFunc k) hφ₀_inj
        (algebraMap (Polynomial k) (RatFunc k) p)).trans
        (IsFractionRing.lift_algebraMap hφ₀_inj p)).symm
  have hX_eq : algebraMap (RatFunc k) L_r RatFunc.X = algebraMap (RatFunc F) L_r RatFunc.X := by
    rw [← RatFunc.algebraMap_X, ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_r]
    exact Polynomial.aeval_X x₀
  let ψ_FK : Polynomial F →+* RatFunc k :=
    (algebraMap (Polynomial k) (RatFunc k)).comp (Polynomial.mapRingHom (algebraMap F k))
  have hψ_inj : Function.Injective ψ_FK :=
    (IsFractionRing.injective (Polynomial k) (RatFunc k)).comp
      (Polynomial.map_injective _ (algebraMap F k).injective)
  let j_FK : RatFunc F →+* RatFunc k := IsFractionRing.lift hψ_inj
  let _ : Algebra (RatFunc F) (RatFunc k) := j_FK.toAlgebra
  let _ : IsScalarTower (RatFunc F) (RatFunc k) L_r := by
    apply IsScalarTower.of_algebraMap_eq'
    apply IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial F))
    apply Polynomial.ringHom_ext'
    · ext c
      symm
      change algebraMap (RatFunc k) L_r
          (j_FK (algebraMap (Polynomial F) (RatFunc F) (Polynomial.C c))) =
        algebraMap (RatFunc F) L_r (algebraMap (Polynomial F) (RatFunc F) (Polynomial.C c))
      rw [IsFractionRing.lift_algebraMap hψ_inj]
      dsimp only [ψ_FK]
      rw [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
        ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_r,
        ← Polynomial.algebraMap_eq,
        ← IsScalarTower.algebraMap_apply k (Polynomial k) L_r,
        ← IsScalarTower.algebraMap_apply F k L_r,
        ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r,
        ← Polynomial.algebraMap_eq,
        ← IsScalarTower.algebraMap_apply F (Polynomial F) L_r]
    · symm
      change algebraMap (RatFunc k) L_r
          (j_FK (algebraMap (Polynomial F) (RatFunc F) Polynomial.X)) =
        algebraMap (RatFunc F) L_r (algebraMap (Polynomial F) (RatFunc F) Polynomial.X)
      rw [IsFractionRing.lift_algebraMap hψ_inj]
      dsimp only [ψ_FK]
      rw [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
        RatFunc.algebraMap_X, RatFunc.algebraMap_X, hX_eq]
  let _ : FiniteDimensional (RatFunc k) L_r :=
    Module.Finite.of_restrictScalars_finite (RatFunc F) (RatFunc k) L_r
  let _ : IsGalois (RatFunc k) L_r :=
    IsGalois.tower_top_of_isGalois (RatFunc F) (RatFunc k) L_r
  let Ψ_L : (L_r ≃ₐ[RatFunc k] L_r) →* (L_r ≃ₐ[RatFunc F] L_r) :=
    AlgEquiv.restrictScalarsHom (RatFunc F)
  let Ψ_B : (L_r ≃ₐ[RatFunc k] L_r) →* (B_r ≃ₐ[R₀] B_r) :=
    res_B.toMonoidHom.comp Ψ_L
  have hΨL_int : ∀ (σ_K : L_r ≃ₐ[RatFunc k] L_r) (x : L_r),
      _root_.IsIntegral F x → Ψ_L σ_K x = x := by
    intro σ_K x hx
    obtain ⟨c, rfl⟩ := (IsIntegralClosure.isIntegral_iff (A := k)).mp hx
    rw [IsScalarTower.algebraMap_apply k (RatFunc k) L_r c]
    exact σ_K.commutes (algebraMap k (RatFunc k) c)
  have hΨB_geom : ∀ (σ_K : L_r ≃ₐ[RatFunc k] L_r) (b : B_r),
      _root_.IsIntegral F b → Ψ_B σ_K b = b :=
    fun σ_K => (hFixedEquiv (Ψ_L σ_K)).mp (hΨL_int σ_K)
  have hΨB_surj_geom : ∀ σ_B : B_r ≃ₐ[R₀] B_r,
      (∀ b : B_r, _root_.IsIntegral F b → σ_B b = b) →
      ∃ σ_K : L_r ≃ₐ[RatFunc k] L_r, Ψ_B σ_K = σ_B := by
    intro σ_B hσ_B
    let σ_L : L_r ≃ₐ[RatFunc F] L_r := res_B.symm σ_B
    have hres_σL : res_B σ_L = σ_B := res_B.apply_symm_apply σ_B
    have hσL_int : ∀ x : L_r, _root_.IsIntegral F x → σ_L x = x :=
      (hFixedEquiv σ_L).mpr (by rw [hres_σL]; exact hσ_B)
    have hcomm_hom : (σ_L.toRingEquiv : L_r →+* L_r).comp (algebraMap (RatFunc k) L_r) =
        algebraMap (RatFunc k) L_r := by
      apply IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial k))
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, RingHom.coe_coe,
          ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_r,
          ← Polynomial.algebraMap_eq,
          ← IsScalarTower.algebraMap_apply k (Polynomial k) L_r]
        exact hσL_int (algebraMap k L_r c) (hk_int c)
      · simp only [RingHom.comp_apply, RingHom.coe_coe, RatFunc.algebraMap_X, hX_eq]
        exact σ_L.commutes RatFunc.X
    have hcomm_K : ∀ r : RatFunc k,
        σ_L.toRingEquiv (algebraMap (RatFunc k) L_r r) = algebraMap (RatFunc k) L_r r :=
      fun r => RingHom.congr_fun hcomm_hom r
    let σ_K : L_r ≃ₐ[RatFunc k] L_r := AlgEquiv.ofRingEquiv (f := σ_L.toRingEquiv) hcomm_K
    have hΨL_eq : Ψ_L σ_K = σ_L := by
      ext y
      exact AlgEquiv.ofRingEquiv_apply hcomm_K y
    refine ⟨σ_K, ?_⟩
    change res_B (Ψ_L σ_K) = σ_B
    rw [hΨL_eq, hres_σL]
  let N_K : Subgroup (L_r ≃ₐ[RatFunc k] L_r) := N_B.comap Ψ_B
  let _ : N_K.Normal := by
    refine ⟨fun σ_K hσ_K τ_K => ?_⟩
    rw [Subgroup.mem_comap, map_mul, map_mul, map_inv]
    exact hNB_norm (Ψ_B τ_K) (hΨB_geom τ_K) (Ψ_B σ_K) hσ_K
  let E_int : IntermediateField (RatFunc k) L_r := IntermediateField.fixedField N_K
  let E : Type u := ↥E_int
  let _ : IsGalois (RatFunc k) E := IsGalois.of_fixedField_normal_subgroup N_K
  let _ : Algebra F E := ((algebraMap k E).comp (algebraMap F k)).toAlgebra
  let _ : IsScalarTower F k E := IsScalarTower.of_algebraMap_eq' rfl
  let _ : IsScalarTower k (Polynomial k) E := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply k (RatFunc k) E,
      IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k),
      ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) E]
  let _ : IsScalarTower k E L_r := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply k (RatFunc k) L_r,
      IsScalarTower.algebraMap_apply (RatFunc k) E L_r,
      ← IsScalarTower.algebraMap_apply k (RatFunc k) E]
  let _ : IsScalarTower (Polynomial k) E L_r := by
    refine IsScalarTower.of_algebraMap_eq fun p => ?_
    rw [IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_r,
      IsScalarTower.algebraMap_apply (RatFunc k) E L_r,
      ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) E]
  refine ⟨k, E,
    inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance,
    hX_eq, hk_int, ?_, ?_, ?_⟩
  · intro x hx
    have hx_L_k : _root_.IsIntegral k (algebraMap E L_r x) :=
      hx.map (IsScalarTower.toAlgHom k E L_r)
    have hx_L_F : _root_.IsIntegral F (algebraMap E L_r x) :=
      isIntegral_trans _ hx_L_k
    obtain ⟨c, hc⟩ := (IsIntegralClosure.isIntegral_iff (A := k)).mp hx_L_F
    refine ⟨c, (algebraMap E L_r).injective ?_⟩
    rw [← IsScalarTower.algebraMap_apply k E L_r, hc]
  · intro hfr1 σ_B hσ_B
    have hfr_eq : Module.finrank E L_r = Module.finrank (RatFunc k) L_r := by
      have hmul := Module.finrank_mul_finrank (RatFunc k) E L_r
      rwa [hfr1, one_mul] at hmul
    have hcard_eq : Nat.card ↥N_K = Nat.card (L_r ≃ₐ[RatFunc k] L_r) := by
      rw [← IntermediateField.finrank_fixedField_eq_card N_K, hfr_eq,
        IsGalois.card_aut_eq_finrank (RatFunc k) L_r]
    have hNK_top : N_K = ⊤ := Subgroup.eq_top_of_card_eq N_K hcard_eq
    obtain ⟨σ_K, rfl⟩ := hΨB_surj_geom σ_B hσ_B
    have hmem : σ_K ∈ N_K := by
      rw [hNK_top]
      exact Subgroup.mem_top σ_K
    exact hmem
  · intro σ_K
    refine ⟨Ψ_L σ_K, Ψ_B σ_K, fun _ => rfl, hΨL_int σ_K,
      fun b => (hres_B_apply (Ψ_L σ_K) b).symm, ?_⟩
    intro hNB x
    have hmem : σ_K ∈ N_K := hNB
    exact (IntermediateField.mem_fixedField_iff N_K x.1).mp x.2 σ_K hmem

theorem weil_dedekind_galois_inertia_trivial_implies_unramified (A K E L : Type u)
    [CommRing A] [IsDedekindDomain A] [Field K] [Field E] [Field L]
    [Algebra A K] [IsFractionRing A K]
    [Algebra K E] [Algebra K L] [Algebra E L] [Algebra A E] [Algebra A L]
    [IsScalarTower A K E] [IsScalarTower A K L] [IsScalarTower K E L] [IsScalarTower A E L]
    [FiniteDimensional K L] [IsGalois K L] [IsGalois K E]
    (p : Ideal A) (hp_ne : p ≠ ⊥) [p.IsMaximal] [Finite (A ⧸ p)] :
    (∀ Q : Ideal ↥(integralClosure A L), Q.IsPrime →
      Ideal.comap (algebraMap A ↥(integralClosure A L)) Q = p →
      ∀ σ : L ≃ₐ[K] L,
        (∀ y : ↥(integralClosure A L),
          σ (y : L) - (y : L) ∈ Subtype.val '' (Q : Set ↥(integralClosure A L))) →
        ∀ x : E, σ (algebraMap E L x) = algebraMap E L x) →
    ∀ (P : Ideal ↥(integralClosure A E)) [P.IsPrime],
      Ideal.comap (algebraMap A ↥(integralClosure A E)) P = p →
      Algebra.IsUnramifiedAt A P :=
by
  intro hInert P _ hP_comap
  let _ := hp_ne
  have _ : FiniteDimensional K E := FiniteDimensional.left K E L
  have _ : FiniteDimensional E L := FiniteDimensional.right K E L
  have _ : IsGalois E L := IsGalois.tower_top_of_isGalois K E L
  let B := ↥(integralClosure A E)
  let C := ↥(integralClosure A L)
  have _ : IsDedekindDomain B := integralClosure.isDedekindDomain A K E
  have _ : IsDedekindDomain C := integralClosure.isDedekindDomain A K L
  have _ : IsFractionRing B E := integralClosure.isFractionRing_of_finite_extension K E
  have _ : IsFractionRing C L := integralClosure.isFractionRing_of_finite_extension K L
  have _ : Module.Finite A B := IsIntegralClosure.finite A K E B
  have _ : Module.Finite A C := IsIntegralClosure.finite A K L C
  have _ : Algebra.FiniteType A B := Module.Finite.finiteType B
  have _ : Algebra.EssFiniteType A B := Algebra.EssFiniteType.of_finiteType A B
  let _ : Algebra B L :=
    { algebraMap := (algebraMap E L).comp (algebraMap B E)
      commutes' := fun _ _ => mul_comm _ _
      smul_def' := fun b x => Algebra.smul_def (b : E) x }
  have _ : IsScalarTower B E L := ⟨fun b e x => mul_smul (b : E) e x⟩
  let j_BC : B →+* C :=
    { toFun := fun b => ⟨algebraMap E L (b : E), IsIntegral.map (IsScalarTower.toAlgHom A E L) b.2⟩
      map_one' := Subtype.ext (map_one (algebraMap E L))
      map_mul' := fun x y => Subtype.ext (map_mul (algebraMap E L) x.1 y.1)
      map_zero' := Subtype.ext (map_zero (algebraMap E L))
      map_add' := fun x y => Subtype.ext (map_add (algebraMap E L) x.1 y.1) }
  let _ : Algebra B C := j_BC.toAlgebra
  have _ : IsScalarTower A B C := ⟨fun a b c => Subtype.ext <| by
    change algebraMap E L (a • (b : E)) * (c : L) = a • (algebraMap E L (b : E) * (c : L))
    rw [Algebra.smul_def, Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply A E L,
      mul_assoc]⟩
  have _ : IsScalarTower B C L := ⟨fun b c x => by
    change ((j_BC b * c : C) : L) • x = (b : E) • ((c : L) • x)
    rw [smul_eq_mul, smul_eq_mul, MulMemClass.coe_mul, Algebra.smul_def]
    exact mul_assoc (algebraMap E L (b : E)) (c : L) x⟩
  have _ : Module.Finite B C := Module.Finite.of_restrictScalars_finite A B C
  have _ : Algebra.IsIntegral B C := Algebra.IsIntegral.tower_top A
  have _ : FaithfulSMul A B := FaithfulSMul.of_field_isFractionRing A B K E
  have _ : FaithfulSMul A C := FaithfulSMul.of_field_isFractionRing A C K L
  have _ : FaithfulSMul B C := FaithfulSMul.of_field_isFractionRing B C E L
  have _ : IsGaloisGroup (E ≃ₐ[K] E) A B := IsGaloisGroup.of_isFractionRing (E ≃ₐ[K] E) A B K E
  have _ : IsGaloisGroup (L ≃ₐ[K] L) A C := IsGaloisGroup.of_isFractionRing (L ≃ₐ[K] L) A C K L
  have _ : SMulCommClass (L ≃ₐ[E] L) A L :=
    ⟨fun τ a x => by
      rw [Algebra.smul_def, Algebra.smul_def, AlgEquiv.smul_def, AlgEquiv.smul_def,
        map_mul, IsScalarTower.algebraMap_apply A E L, AlgEquiv.commutes]⟩
  have _ : IsGaloisGroup (L ≃ₐ[E] L) B C := IsGaloisGroup.of_isFractionRing (L ≃ₐ[E] L) B C E L
  have hSepFinite : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
      [Module.Finite R S] [Algebra.IsIntegral R S] (m : Ideal R) [m.IsMaximal] [Finite (R ⧸ m)],
      Algebra.HasSeparableResidueFieldsAt R S m := by
    intro R S _ _ _ _ _ m _ _
    refine Algebra.HasSeparableResidueFieldsAt.mk (A := R) (B := S) (p := m) (fun q hq hlies => ?_)
    have hm_under : (Ideal.under R q).IsMaximal := by
      rw [← Ideal.over_def q m]
      infer_instance
    have _ : q.IsMaximal := Ideal.IsIntegral.isMaximal_of_isMaximal_under (R := R) q hm_under
    let _ := Localization.AtPrime.algebraOfLiesOver m q
    exact (inferInstance : Algebra.IsSeparable m.ResidueField q.ResidueField)
  have _ : Algebra.HasSeparableResidueFieldsAt A B p := hSepFinite A B p
  have _ : Algebra.HasSeparableResidueFieldsAt A C p := hSepFinite A C p
  have hP_under : Ideal.under A P = p := hP_comap
  have _ : P.LiesOver p := (Ideal.liesOver_iff P p).mpr hP_under.symm
  have _ : P.IsMaximal :=
    Ideal.IsIntegral.isMaximal_of_isMaximal_under (R := A) P (hP_under.symm ▸ inferInstance)
  have _ : Finite (B ⧸ P) := Module.finite_of_finite (A ⧸ p)
  have _ : Algebra.HasSeparableResidueFieldsAt B C P := hSepFinite B C P
  have _ : Nonempty ↑(P.primesOver C) := Ideal.nonempty_primesOver (S := C) P
  obtain ⟨Q, hQ_prime, hQ_over_P⟩ := Classical.arbitrary ↑(P.primesOver C)
  have _ : Q.IsPrime := hQ_prime
  have _ : Q.LiesOver P := hQ_over_P
  have _ : Q.LiesOver p := Ideal.LiesOver.trans Q P p
  have hQ_comap : Ideal.comap (algebraMap A C) Q = p := (Ideal.over_def Q p).symm
  let φ : ↥(Ideal.inertia (L ≃ₐ[E] L) Q) → ↥(Ideal.inertia (L ≃ₐ[K] L) Q) :=
    fun ⟨τ, hτ⟩ => ⟨τ.restrictScalars K, AddSubgroup.mem_inertia.mpr fun y => by
      have hsmul : τ.restrictScalars K • y = τ • y := Subtype.ext rfl
      rw [hsmul]
      exact AddSubgroup.mem_inertia.mp hτ y⟩
  have hφ_bij : Function.Bijective φ := by
    refine ⟨?_, ?_⟩
    · rintro ⟨τ₁, hτ₁⟩ ⟨τ₂, hτ₂⟩ h_eq
      apply Subtype.ext
      apply AlgEquiv.ext
      intro z
      exact AlgEquiv.congr_fun (congrArg Subtype.val h_eq) z
    · rintro ⟨σ, hσ⟩
      have hσ_mod : ∀ y : C, σ (y : L) - (y : L) ∈ Subtype.val '' (Q : Set C) := by
        intro y
        refine ⟨σ • y - y, AddSubgroup.mem_inertia.mp hσ y, ?_⟩
        rfl
      have hσ_E : ∀ x : E, σ (algebraMap E L x) = algebraMap E L x :=
        hInert Q hQ_prime hQ_comap σ hσ_mod
      let τ : L ≃ₐ[E] L := AlgEquiv.ofRingEquiv (f := σ.toRingEquiv) hσ_E
      have hτ_mem : τ ∈ Ideal.inertia (L ≃ₐ[E] L) Q := by
        refine AddSubgroup.mem_inertia.mpr fun y => ?_
        have hsmul : τ • y = σ • y := Subtype.ext rfl
        rw [hsmul]
        exact AddSubgroup.mem_inertia.mp hσ y
      refine ⟨⟨τ, hτ_mem⟩, Subtype.ext (AlgEquiv.ext fun z => rfl)⟩
  have h_card : Nat.card ↥(Ideal.inertia (L ≃ₐ[E] L) Q) = Nat.card ↥(Ideal.inertia (L ≃ₐ[K] L) Q) :=
    Nat.card_congr (Equiv.ofBijective φ hφ_bij)
  have h_card_AC : Nat.card ↥(Ideal.inertia (L ≃ₐ[K] L) Q) = p.ramificationIdxIn C :=
    Ideal.card_inertia_eq_ramificationIdxIn p Q
  have h_card_BC : Nat.card ↥(Ideal.inertia (L ≃ₐ[E] L) Q) = P.ramificationIdxIn C :=
    Ideal.card_inertia_eq_ramificationIdxIn P Q
  have h_ram_eq : P.ramificationIdxIn C = p.ramificationIdxIn C :=
    h_card_BC.symm.trans (h_card.trans h_card_AC)
  have h_mul : p.ramificationIdxIn B * P.ramificationIdxIn C = p.ramificationIdxIn C :=
    Ideal.ramificationIdxIn_mul_ramificationIdxIn (p := p) P (E ≃ₐ[K] E) C (L ≃ₐ[K] L) (L ≃ₐ[E] L)
  have h_ne : P.ramificationIdxIn C ≠ 0 :=
    Ideal.ramificationIdxIn_ne_zero (A := B) (B := C) (L ≃ₐ[E] L) (p := P)
  have h_ram_B : p.ramificationIdxIn B = 1 := by
    apply mul_right_cancel₀ h_ne
    rw [h_mul, ← h_ram_eq, one_mul]
  have h_ram_P : P.ramificationIdx A = 1 := by
    rw [← Ideal.ramificationIdxIn_eq_ramificationIdx p P (E ≃ₐ[K] E)]
    exact h_ram_B
  have _ : Algebra.HasSeparableResidueFieldsAt A B (Ideal.under A P) :=
    hP_under.symm ▸ (inferInstance : Algebra.HasSeparableResidueFieldsAt A B p)
  exact Ideal.ramificationIdx_eq_one_iff.mp h_ram_P

theorem weil_p1_etale_away_and_puncture_unramified_transfer (F k E B_r L_r : Type u)
    [Finite F] [Field F] [Finite k] [Field k] [Field E]
    [CommRing B_r] [IsDomain B_r] [Field L_r]
    (S_aff : Finset F) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∀ [Algebra F k] [Algebra k L_r] [Algebra k E]
      [Algebra (Polynomial k) E] [Algebra (RatFunc k) E]
      [Algebra (Polynomial k) L_r] [Algebra (RatFunc k) L_r] [Algebra E L_r]
      [Algebra F B_r] [Algebra (Polynomial F) B_r] [Algebra R₀ B_r]
      [Algebra F L_r] [Algebra (Polynomial F) L_r] [Algebra (RatFunc F) L_r]
      [Algebra B_r L_r] [Algebra R₀ L_r]
      [IsScalarTower F k L_r]
      [IsScalarTower k (Polynomial k) E] [IsScalarTower k (RatFunc k) E]
      [IsScalarTower (Polynomial k) (RatFunc k) E]
      [IsScalarTower k (Polynomial k) L_r] [IsScalarTower k (RatFunc k) L_r]
      [IsScalarTower (Polynomial k) (RatFunc k) L_r]
      [IsScalarTower k E L_r] [IsScalarTower (Polynomial k) E L_r]
      [IsScalarTower (RatFunc k) E L_r]
      [IsScalarTower F (Polynomial F) B_r] [IsScalarTower (Polynomial F) R₀ B_r]
      [IsScalarTower F (RatFunc F) L_r] [IsScalarTower (Polynomial F) (RatFunc F) L_r]
      [IsScalarTower (Polynomial F) B_r L_r] [IsScalarTower R₀ B_r L_r]
      [Module.Finite R₀ B_r] [Algebra.Etale R₀ B_r]
      [IsFractionRing B_r L_r] [IsIntegralClosure B_r R₀ L_r]
      [FiniteDimensional (RatFunc k) L_r] [IsGalois (RatFunc k) L_r]
      [FiniteDimensional (RatFunc k) E] [IsGalois (RatFunc k) E],
      algebraMap (RatFunc k) L_r RatFunc.X = algebraMap (RatFunc F) L_r RatFunc.X →
      (∀ c : k, IsIntegral F (algebraMap k L_r c)) →
      let C₀ := integralClosure (Polynomial F) L_r
      let C₀_k := integralClosure (Polynomial k) L_r
      let A_inf := Algebra.adjoin F ({algebraMap (RatFunc F) L_r (RatFunc.X)⁻¹} : Set L_r)
      let t_inf : ↥A_inf :=
        ⟨algebraMap (RatFunc F) L_r (RatFunc.X)⁻¹, Algebra.self_mem_adjoin_singleton F _⟩
      let C_inf := integralClosure ↥A_inf L_r
      (∀ a' : k,
        let p_a : Ideal (Polynomial k) := Ideal.span {Polynomial.X - Polynomial.C a'}
        p_a ≠ ⊥ ∧ p_a.IsMaximal ∧ Finite (Polynomial k ⧸ p_a)) ∧
      (∀ (P : Ideal ↥(integralClosure (Polynomial k) E)) [P.IsPrime],
        P ≠ ⊥ →
        (∃ a ∈ S_aff,
          Ideal.comap (algebraMap (Polynomial k) ↥(integralClosure (Polynomial k) E)) P =
            Ideal.span {Polynomial.X - Polynomial.C (algebraMap F k a)}) ∨
        Algebra.IsUnramifiedAt (Polynomial k) P) ∧
      (∀ a ∈ S_aff, ∀ Q_k : Ideal ↥C₀_k, Q_k.IsPrime →
        Ideal.comap (algebraMap (Polynomial k) ↥C₀_k) Q_k =
          Ideal.span {Polynomial.X - Polynomial.C (algebraMap F k a)} →
        ∃ Q : Ideal ↥C₀, Q.IsPrime ∧
          Ideal.comap (algebraMap (Polynomial F) ↥C₀) Q =
            Ideal.span {Polynomial.X - Polynomial.C a} ∧
          ∀ f : L_r → L_r,
            (∀ y : ↥C₀_k, f (y : L_r) - (y : L_r) ∈ Subtype.val '' (Q_k : Set ↥C₀_k)) →
            (∀ y : ↥C₀, f (y : L_r) - (y : L_r) ∈ Subtype.val '' (Q : Set ↥C₀))) ∧
      (∃ (A_inf_k : Type u) (_ : CommRing A_inf_k) (_ : IsDedekindDomain A_inf_k)
          (_ : Algebra k A_inf_k) (_ : Algebra A_inf_k (RatFunc k))
          (_ : IsFractionRing A_inf_k (RatFunc k))
          (_ : Algebra A_inf_k E) (_ : Algebra A_inf_k L_r)
          (_ : IsScalarTower k A_inf_k (RatFunc k))
          (_ : IsScalarTower A_inf_k (RatFunc k) E)
          (_ : IsScalarTower A_inf_k (RatFunc k) L_r)
          (_ : IsScalarTower A_inf_k E L_r)
          (e_inf : Polynomial k ≃ₐ[k] A_inf_k)
          (t_K : A_inf_k),
        e_inf Polynomial.X = t_K ∧
        algebraMap A_inf_k (RatFunc k) t_K = (RatFunc.X : RatFunc k)⁻¹ ∧
        (Ideal.span {t_K} : Ideal A_inf_k) ≠ ⊥ ∧
        (Ideal.span {t_K} : Ideal A_inf_k).IsMaximal ∧
        Finite (A_inf_k ⧸ (Ideal.span {t_K} : Ideal A_inf_k)) ∧
        ∀ Q_inf_k : Ideal ↥(integralClosure A_inf_k L_r), Q_inf_k.IsPrime →
          Ideal.comap (algebraMap A_inf_k ↥(integralClosure A_inf_k L_r)) Q_inf_k =
            Ideal.span {t_K} →
          ∃ Q_inf : Ideal ↥C_inf, Q_inf.IsPrime ∧
            Ideal.comap (algebraMap ↥A_inf ↥C_inf) Q_inf = Ideal.span {t_inf} ∧
            ∀ f : L_r → L_r,
              (∀ y : ↥(integralClosure A_inf_k L_r),
                f (y : L_r) - (y : L_r) ∈
                  Subtype.val '' (Q_inf_k : Set ↥(integralClosure A_inf_k L_r))) →
              (∀ y : ↥C_inf, f (y : L_r) - (y : L_r) ∈ Subtype.val '' (Q_inf : Set ↥C_inf))) :=
by
  intro R₀ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
    hX_eq hk_int C₀ C₀_k A_inf t_inf C_inf
  classical

  
  have hLinQuot : ∀ (K : Type u) [Field K] (c : K),
      let p_c : Ideal (Polynomial K) := Ideal.span {Polynomial.X - Polynomial.C c}
      p_c ≠ ⊥ ∧ p_c.IsMaximal ∧ Nonempty ((Polynomial K ⧸ p_c) ≃+* K) := by
    intro K _ c p_c
    have hp_ne : p_c ≠ ⊥ :=
      Ideal.span_singleton_eq_bot.not.mpr (Polynomial.monic_X_sub_C c).ne_zero
    have hsurj : Function.Surjective (Polynomial.evalRingHom c : Polynomial K →+* K) :=
      fun y => ⟨Polynomial.C y, Polynomial.eval_C⟩
    let e_c : (Polynomial K ⧸ p_c) ≃+* K :=
      (Ideal.quotEquivOfEq (Polynomial.ker_evalRingHom c).symm).trans
        (RingHom.quotientKerEquivOfSurjective hsurj)
    have hMax : p_c.IsMaximal :=
      (Ideal.Quotient.maximal_ideal_iff_isField_quotient p_c).mpr
        (MulEquiv.isField (Field.toIsField K) e_c.toMulEquiv)
    exact ⟨hp_ne, hMax, ⟨e_c⟩⟩

  have hOut1 : ∀ a' : k,
      let p_a : Ideal (Polynomial k) := Ideal.span {Polynomial.X - Polynomial.C a'}
      p_a ≠ ⊥ ∧ p_a.IsMaximal ∧ Finite (Polynomial k ⧸ p_a) := by
    intro a' p_a
    obtain ⟨hne, hmax, ⟨e_a⟩⟩ := hLinQuot k a'
    exact ⟨hne, hmax, Finite.of_equiv k e_a.symm.toEquiv⟩

  
  have hTinfCollapse : ∀ (p : Ideal ↥A_inf), t_inf ∈ p → p ≠ ⊤ → p = Ideal.span {t_inf} := by
    intro p ht hp_ne
    refine le_antisymm ?_ (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ht))
    intro x hx
    set u₀ : L_r := algebraMap (RatFunc F) L_r (RatFunc.X)⁻¹
    have hx_mem : x.1 ∈ (Polynomial.aeval u₀ : Polynomial F →ₐ[F] L_r).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval F u₀]
      exact x.2
    rcases hx_mem with ⟨P, hP⟩
    have hx_eq : x = Polynomial.aeval t_inf P := by
      apply Subtype.ext
      have h1 : A_inf.val (Polynomial.aeval t_inf P) = Polynomial.aeval (A_inf.val t_inf) P :=
        (Polynomial.aeval_algHom_apply A_inf.val t_inf P).symm
      change x.1 = A_inf.val (Polynomial.aeval t_inf P)
      rw [h1]
      exact hP.symm
    have hdiv : Polynomial.aeval t_inf P =
        t_inf * Polynomial.aeval t_inf P.divX + algebraMap F ↥A_inf (P.coeff 0) := by
      conv_lhs => rw [← Polynomial.X_mul_divX_add P]
      rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
    rw [hx_eq] at hx
    set q₀ : ↥A_inf := Polynomial.aeval t_inf P.divX
    have hc_mem : algebraMap F ↥A_inf (P.coeff 0) ∈ p := by
      have hsub := p.sub_mem hx (p.mul_mem_right q₀ ht)
      rw [hdiv, add_sub_cancel_left] at hsub
      exact hsub
    have hc0 : P.coeff 0 = 0 := by
      by_contra hc_ne
      have hu : IsUnit (algebraMap F ↥A_inf (P.coeff 0)) :=
        (IsUnit.mk0 (P.coeff 0) hc_ne).map (algebraMap F ↥A_inf)
      exact hp_ne (Ideal.eq_top_of_isUnit_mem p hc_mem hu)
    rw [hx_eq, hdiv, hc0, map_zero, add_zero]
    exact Ideal.mem_span_singleton.mpr ⟨q₀, rfl⟩

  
  have hIntSub : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A L_r] [Algebra B L_r],
      (∀ b : B, IsIntegral A (algebraMap B L_r b)) →
      ∀ x : L_r, IsIntegral B x → IsIntegral A x := by
    intro A B _ _ _ _ hBA x hx
    let g : B →+* ↥(integralClosure A L_r) :=
      { toFun := fun b => ⟨algebraMap B L_r b, hBA b⟩
        map_one' := Subtype.ext (map_one _)
        map_mul' := fun a b => Subtype.ext (map_mul _ a b)
        map_zero' := Subtype.ext (map_zero _)
        map_add' := fun a b => Subtype.ext (map_add _ a b) }
    let _ : Algebra B ↥(integralClosure A L_r) := g.toAlgebra
    have _ : IsScalarTower B ↥(integralClosure A L_r) L_r :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have hx' : IsIntegral ↥(integralClosure A L_r) x :=
      IsIntegral.tower_top (R := B) (A := ↥(integralClosure A L_r)) hx
    exact isIntegral_trans (R := A) (A := ↥(integralClosure A L_r)) x hx'

  have hBridge : ∀ (A₀ A₁ : Type u) [CommRing A₀] [CommRing A₁] [Algebra A₀ L_r] [Algebra A₁ L_r],
      (∀ r₀ : A₀, IsIntegral A₁ (algebraMap A₀ L_r r₀)) →
      (∀ r₁ : A₁, IsIntegral A₀ (algebraMap A₁ L_r r₁)) →
      ∀ (Q₁ : Ideal ↥(integralClosure A₁ L_r)), Q₁.IsPrime →
        ∃ Q₀ : Ideal ↥(integralClosure A₀ L_r), Q₀.IsPrime ∧
          (∀ r₀ : A₀,
            r₀ ∈ Ideal.comap (algebraMap A₀ ↥(integralClosure A₀ L_r)) Q₀ ↔
              algebraMap A₀ L_r r₀ ∈ Subtype.val '' (Q₁ : Set ↥(integralClosure A₁ L_r))) ∧
          Subtype.val '' (Q₀ : Set ↥(integralClosure A₀ L_r)) =
            Subtype.val '' (Q₁ : Set ↥(integralClosure A₁ L_r)) := by
    intro A₀ A₁ _ _ _ _ h01 h10 Q₁ hQ₁
    have _ : Q₁.IsPrime := hQ₁
    have h_iff : ∀ x : L_r, x ∈ integralClosure A₀ L_r ↔ x ∈ integralClosure A₁ L_r :=
      fun x => ⟨hIntSub A₁ A₀ h01 x, hIntSub A₀ A₁ h10 x⟩
    let θ : ↥(integralClosure A₀ L_r) ≃+* ↥(integralClosure A₁ L_r) :=
      { toFun := fun y => ⟨y.1, (h_iff y.1).mp y.2⟩
        invFun := fun z => ⟨z.1, (h_iff z.1).mpr z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl }
    let Q₀ : Ideal ↥(integralClosure A₀ L_r) := Ideal.comap θ.toRingHom Q₁
    have hQ₀_prime : Q₀.IsPrime := Ideal.IsPrime.comap θ.toRingHom
    have h_img : Subtype.val '' (Q₀ : Set ↥(integralClosure A₀ L_r)) =
        Subtype.val '' (Q₁ : Set ↥(integralClosure A₁ L_r)) := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact ⟨θ y, hy, rfl⟩
      · rintro ⟨z, hz, rfl⟩
        refine ⟨θ.symm z, ?_, rfl⟩
        change θ (θ.symm z) ∈ Q₁
        simpa using hz
    refine ⟨Q₀, hQ₀_prime, ?_, h_img⟩
    intro r₀
    rw [← h_img]
    let u₀ : ↥(integralClosure A₀ L_r) := algebraMap A₀ ↥(integralClosure A₀ L_r) r₀
    have hu_val : (u₀ : L_r) = algebraMap A₀ L_r r₀ := rfl
    rw [← hu_val]
    constructor
    · intro hr₀
      exact ⟨u₀, hr₀, rfl⟩
    · rintro ⟨w, hw, hw_eq⟩
      have hwu : w = u₀ := Subtype.ext hw_eq
      change u₀ ∈ Q₀
      rwa [← hwu]

  
  have hST_F_PF_L : IsScalarTower F (Polynomial F) L_r := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    calc
      algebraMap F L_r c
          = algebraMap (RatFunc F) L_r (algebraMap F (RatFunc F) c) :=
            IsScalarTower.algebraMap_apply F (RatFunc F) L_r c
      _ = algebraMap (RatFunc F) L_r (algebraMap (Polynomial F) (RatFunc F)
            (algebraMap F (Polynomial F) c)) := by
            rw [← IsScalarTower.algebraMap_apply F (Polynomial F) (RatFunc F) c]
      _ = algebraMap (Polynomial F) L_r (algebraMap F (Polynomial F) c) := by
            rw [← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r]

  let φ_Fk : Polynomial F →+* Polynomial k := Polynomial.mapRingHom (algebraMap F k)
  have hφ_Fk_comp : (algebraMap (Polynomial k) L_r).comp φ_Fk = algebraMap (Polynomial F) L_r := by
    have _ : IsScalarTower F (Polynomial F) L_r := hST_F_PF_L
    apply Polynomial.ringHom_ext'
    · ext c
      dsimp [φ_Fk]
      simp only [Polynomial.map_C]
      change algebraMap (Polynomial k) L_r (algebraMap k (Polynomial k) (algebraMap F k c)) =
        algebraMap (Polynomial F) L_r (algebraMap F (Polynomial F) c)
      rw [← IsScalarTower.algebraMap_apply k (Polynomial k) L_r,
        ← IsScalarTower.algebraMap_apply F k L_r,
        ← IsScalarTower.algebraMap_apply F (Polynomial F) L_r]
    · dsimp [φ_Fk]
      simp only [Polynomial.map_X]
      rw [IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_r,
        RatFunc.algebraMap_X, hX_eq, ← RatFunc.algebraMap_X,
        ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r]

  have hφ_Fk : ∀ p : Polynomial F,
      algebraMap (Polynomial k) L_r (φ_Fk p) = algebraMap (Polynomial F) L_r p :=
    fun p => RingHom.congr_fun hφ_Fk_comp p

  have h01_aff : ∀ p : Polynomial F, IsIntegral (Polynomial k) (algebraMap (Polynomial F) L_r p) := by
    intro p
    rw [← hφ_Fk p]
    exact isIntegral_algebraMap

  have h10_aff : ∀ q : Polynomial k, IsIntegral (Polynomial F) (algebraMap (Polynomial k) L_r q) := by
    have _ : IsScalarTower F (Polynomial F) L_r := hST_F_PF_L
    intro q
    change algebraMap (Polynomial k) L_r q ∈ C₀
    refine Polynomial.induction_on' q ?_ ?_
    · intro p₁ p₂ hp₁ hp₂
      rw [map_add]
      exact C₀.add_mem hp₁ hp₂
    · intro n c
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
      have hc : algebraMap (Polynomial k) L_r (Polynomial.C c) ∈ C₀ := by
        change algebraMap (Polynomial k) L_r (algebraMap k (Polynomial k) c) ∈ C₀
        rw [← IsScalarTower.algebraMap_apply k (Polynomial k) L_r]
        exact IsIntegral.tower_top (R := F) (A := Polynomial F) (hk_int c)
      have hX : algebraMap (Polynomial k) L_r Polynomial.X ∈ C₀ := by
        have hX0 : φ_Fk Polynomial.X = Polynomial.X := Polynomial.map_X _
        rw [← hX0, hφ_Fk Polynomial.X]
        exact C₀.algebraMap_mem Polynomial.X
      exact C₀.mul_mem hc (C₀.pow_mem hX n)

  
  have hOut2 : ∀ (P : Ideal ↥(integralClosure (Polynomial k) E)) [P.IsPrime],
      P ≠ ⊥ →
      (∃ a ∈ S_aff,
        Ideal.comap (algebraMap (Polynomial k) ↥(integralClosure (Polynomial k) E)) P =
          Ideal.span {Polynomial.X - Polynomial.C (algebraMap F k a)}) ∨
      Algebra.IsUnramifiedAt (Polynomial k) P := by
    intro P hP_prime _hP_ne
    let Δ_aff : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)
    let E₀ := integralClosure (Polynomial k) E
    let C_R := integralClosure R₀ L_r
    let p_k : Ideal (Polynomial k) := Ideal.comap (algebraMap (Polynomial k) ↥E₀) P
    have hp_k_prime : p_k.IsPrime := Ideal.IsPrime.comap (algebraMap (Polynomial k) ↥E₀)
    by_cases hΔ_mem : φ_Fk Δ_aff ∈ p_k
    · left
      have hΔ_prod : φ_Fk Δ_aff =
          ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C (algebraMap F k s) : Polynomial k) := by
        dsimp only [Δ_aff]
        rw [map_prod]
        refine Finset.prod_congr rfl fun s _ => ?_
        simp [φ_Fk]
      rw [hΔ_prod] at hΔ_mem
      obtain ⟨a, ha, ha_mem⟩ := (@Ideal.IsPrime.prod_mem_iff _ _ _ S_aff _ p_k hp_k_prime).mp hΔ_mem
      obtain ⟨_, hmax_a, _⟩ := hLinQuot k (algebraMap F k a)
      have hle : Ideal.span {Polynomial.X - Polynomial.C (algebraMap F k a)} ≤ p_k :=
        Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ha_mem)
      exact ⟨a, ha, (hmax_a.eq_of_le hp_k_prime.ne_top hle).symm⟩
    · right
      have hST_PF_R0_L : IsScalarTower (Polynomial F) R₀ L_r := by
        refine IsScalarTower.of_algebraMap_eq fun p => ?_
        calc
          algebraMap (Polynomial F) L_r p
              = algebraMap B_r L_r (algebraMap (Polynomial F) B_r p) :=
                IsScalarTower.algebraMap_apply (Polynomial F) B_r L_r p
          _ = algebraMap B_r L_r (algebraMap R₀ B_r (algebraMap (Polynomial F) R₀ p)) := by
                rw [IsScalarTower.algebraMap_apply (Polynomial F) R₀ B_r p]
          _ = algebraMap R₀ L_r (algebraMap (Polynomial F) R₀ p) := by
                rw [← IsScalarTower.algebraMap_apply R₀ B_r L_r]
      have _ : IsScalarTower (Polynomial F) R₀ L_r := hST_PF_R0_L

      let g_k : Polynomial k →+* ↥C₀ :=
        { toFun := fun q => ⟨algebraMap (Polynomial k) L_r q, h10_aff q⟩
          map_one' := Subtype.ext (map_one _)
          map_mul' := fun a b => Subtype.ext (map_mul _ a b)
          map_zero' := Subtype.ext (map_zero _)
          map_add' := fun a b => Subtype.ext (map_add _ a b) }

      have hE₀_to_C₀ : ∀ y : ↥E₀, IsIntegral (Polynomial F) (algebraMap E L_r y.1) := by
        intro y
        have hy_Pk : IsIntegral (Polynomial k) (algebraMap E L_r y.1) :=
          y.2.map (IsScalarTower.toAlgHom (Polynomial k) E L_r)
        exact hIntSub (Polynomial F) (Polynomial k) h10_aff _ hy_Pk

      let ι_EC : ↥E₀ →+* ↥C₀ :=
        { toFun := fun y => ⟨algebraMap E L_r y.1, hE₀_to_C₀ y⟩
          map_one' := by apply Subtype.ext; simp
          map_mul' := fun a b => by apply Subtype.ext; simp
          map_zero' := by apply Subtype.ext; simp
          map_add' := fun a b => by apply Subtype.ext; simp }

      have hι_EC_inj : Function.Injective ι_EC := by
        intro x y hxy
        apply Subtype.ext
        exact (algebraMap E L_r).injective (congrArg Subtype.val hxy)

      let ι_CR : ↥C₀ →+* ↥C_R :=
        { toFun := fun w => ⟨w.1, IsIntegral.tower_top (R := Polynomial F) (A := R₀) w.2⟩
          map_one' := rfl
          map_mul' := fun _ _ => rfl
          map_zero' := rfl
          map_add' := fun _ _ => rfl }

      have hι_CR_inj : Function.Injective ι_CR := by
        intro x y hxy
        apply Subtype.ext
        exact congrArg (Subtype.val : ↥C_R → L_r) hxy

      let ι_ER : ↥E₀ →+* ↥C_R := ι_CR.comp ι_EC
      have hι_ER_inj : Function.Injective ι_ER := hι_CR_inj.comp hι_EC_inj

      
      have hΔ_mon : Δ_aff.Monic :=
        Polynomial.monic_prod_of_monic S_aff _ (fun s _ => Polynomial.monic_X_sub_C s)
      have hPF_L_inj : Function.Injective (algebraMap (Polynomial F) L_r) := by
        have hcomp : algebraMap (Polynomial F) L_r =
            (algebraMap (RatFunc F) L_r).comp (algebraMap (Polynomial F) (RatFunc F)) :=
          RingHom.ext (IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r)
        rw [hcomp]
        exact (algebraMap (RatFunc F) L_r).injective.comp
          (IsFractionRing.injective (Polynomial F) (RatFunc F))
      have hu_Δ_ne : algebraMap (Polynomial F) L_r Δ_aff ≠ 0 :=
        fun h0 => hΔ_mon.ne_zero (hPF_L_inj (h0.trans (map_zero _).symm))

      let δ₀ : ↥C₀ := algebraMap (Polynomial F) ↥C₀ Δ_aff
      have hLoc_CR : @IsLocalization.Away ↥C₀ _ δ₀ ↥C_R _ ι_CR.toAlgebra := by
        let _ : Algebra L_r L_r := Algebra.id L_r
        have _ : IsScalarTower (Polynomial F) L_r L_r := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
        let _ : Algebra ↥C₀ ↥C_R := ι_CR.toAlgebra
        have _ : IsScalarTower ↥C₀ ↥C_R L_r := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
        have _ : IsScalarTower (Polynomial F) ↥C₀ ↥C_R :=
          IsScalarTower.of_algebraMap_eq (fun _ => Subtype.ext rfl)
        let _ : IsLocalization.Away (algebraMap (Polynomial F) L_r Δ_aff) L_r :=
          { map_units := fun ⟨_, n, rfl⟩ => (IsUnit.mk0 _ hu_Δ_ne).pow n
            surj := fun z => ⟨⟨z, 1⟩, by simp⟩
            exists_of_eq := fun h => ⟨1, by simpa using h⟩ }
        exact IsLocalization.Away.integralClosure (S := L_r) (Rf := R₀) (Sf := L_r) Δ_aff

      
      have hUnram_PF_CR : Algebra.Unramified (Polynomial F) ↥C_R := by
        have _ : Algebra.Unramified (Polynomial F) R₀ :=
          Algebra.Unramified.of_isLocalization_Away Δ_aff
        have _ : Algebra.Unramified R₀ B_r := inferInstance
        have _ : Algebra.Unramified (Polynomial F) B_r :=
          Algebra.Unramified.comp (Polynomial F) R₀ B_r
        let e_R₀ : B_r ≃ₐ[R₀] ↥C_R := IsIntegralClosure.equiv R₀ B_r L_r ↥C_R
        let e_PF : B_r ≃ₐ[Polynomial F] ↥C_R := e_R₀.restrictScalars (Polynomial F)
        exact Algebra.Unramified.of_equiv e_PF

      
      have hExistsQ₀ : ∃ Q₀ : Ideal ↥C₀, Q₀.IsPrime ∧ Ideal.comap ι_EC Q₀ = P := by
        let _ : Algebra ↥E₀ ↥C₀ := ι_EC.toAlgebra
        let _ : Algebra (Polynomial k) ↥C₀ := g_k.toAlgebra
        have _ : IsScalarTower (Polynomial k) ↥E₀ ↥C₀ := by
          refine IsScalarTower.of_algebraMap_eq fun q => Subtype.ext ?_
          change algebraMap (Polynomial k) L_r q =
            algebraMap E L_r (algebraMap (Polynomial k) E q)
          exact IsScalarTower.algebraMap_apply (Polynomial k) E L_r q
        have _ : Algebra.IsIntegral ↥E₀ ↥C₀ := ⟨fun w => by
          have hw_Pk_L : IsIntegral (Polynomial k) w.1 :=
            hIntSub (Polynomial k) (Polynomial F) h01_aff w.1 w.2
          let val_Pk : ↥C₀ →ₐ[Polynomial k] L_r :=
            { toRingHom := C₀.val.toRingHom
              commutes' := fun _ => rfl }
          have hw_Pk : IsIntegral (Polynomial k) w :=
            (isIntegral_algHom_iff val_Pk Subtype.val_injective).mp hw_Pk_L
          exact IsIntegral.tower_top (R := Polynomial k) (A := ↥E₀) hw_Pk⟩
        have hker : RingHom.ker (algebraMap ↥E₀ ↥C₀) ≤ P := by
          intro x hx
          have hx0 : x = 0 := hι_EC_inj (hx.trans (map_zero ι_EC).symm)
          rw [hx0]
          exact P.zero_mem
        exact Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain P hker
      obtain ⟨Q₀, hQ₀_prime, hQ₀_under⟩ := hExistsQ₀

      
      have hδ₀_not_mem : δ₀ ∉ Q₀ := by
        intro hmem
        have hδ_eq : ι_EC (algebraMap (Polynomial k) ↥E₀ (φ_Fk Δ_aff)) = δ₀ := by
          apply Subtype.ext
          change algebraMap E L_r (algebraMap (Polynomial k) E (φ_Fk Δ_aff)) =
            algebraMap (Polynomial F) L_r Δ_aff
          rw [← IsScalarTower.algebraMap_apply (Polynomial k) E L_r, hφ_Fk]
        rw [← hδ_eq] at hmem
        have hP_mem : algebraMap (Polynomial k) ↥E₀ (φ_Fk Δ_aff) ∈ P := by
          rw [← hQ₀_under]
          exact hmem
        exact hΔ_mem hP_mem

      have hdisj : Disjoint (Submonoid.powers δ₀ : Set ↥C₀) (Q₀ : Set ↥C₀) := by
        rw [Set.disjoint_left]
        rintro _ ⟨n, rfl⟩ hn
        exact hδ₀_not_mem (hQ₀_prime.mem_of_pow_mem n hn)

      
      let Q_R : Ideal ↥C_R := Ideal.map ι_CR Q₀
      have hQR_prime : Q_R.IsPrime := by
        let _ : Algebra ↥C₀ ↥C_R := ι_CR.toAlgebra
        let _ : IsLocalization.Away δ₀ ↥C_R := hLoc_CR
        exact IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers δ₀) ↥C_R Q₀
          hQ₀_prime hdisj
      have hQR_comap_C₀ : Ideal.comap ι_CR Q_R = Q₀ := by
        let _ : Algebra ↥C₀ ↥C_R := ι_CR.toAlgebra
        let _ : IsLocalization.Away δ₀ ↥C_R := hLoc_CR
        exact IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers δ₀) ↥C_R
          hQ₀_prime hdisj
      have hQR_comap_E₀ : Ideal.comap ι_ER Q_R = P := by
        dsimp [ι_ER]
        rw [← Ideal.comap_comap, hQR_comap_C₀, hQ₀_under]

      
      have _ : Algebra.Unramified (Polynomial F) ↥C_R := hUnram_PF_CR
      let _ : Algebra (Polynomial F) (Polynomial k) := φ_Fk.toAlgebra
      let _ : Algebra (Polynomial k) ↥C_R := (ι_CR.comp g_k).toAlgebra
      let _ : Algebra ↥E₀ ↥C_R := ι_ER.toAlgebra
      have _ : IsScalarTower (Polynomial F) (Polynomial k) ↥C_R := by
        refine IsScalarTower.of_algebraMap_eq fun p => Subtype.ext ?_
        change algebraMap (Polynomial F) L_r p = algebraMap (Polynomial k) L_r (φ_Fk p)
        exact (hφ_Fk p).symm
      have _ : IsScalarTower (Polynomial k) ↥E₀ ↥C_R := by
        refine IsScalarTower.of_algebraMap_eq fun q => Subtype.ext ?_
        change algebraMap (Polynomial k) L_r q =
          algebraMap E L_r (algebraMap (Polynomial k) E q)
        exact IsScalarTower.algebraMap_apply (Polynomial k) E L_r q
      have _ : Q_R.IsPrime := hQR_prime
      have _ : Algebra.IsUnramifiedAt (Polynomial F) Q_R := inferInstance
      have _ : Algebra.IsUnramifiedAt (Polynomial k) Q_R :=
        Algebra.IsUnramifiedAt.of_restrictScalars (Polynomial F) Q_R
      have _ : Algebra.EssFiniteType (Polynomial F) ↥C_R :=
        Algebra.EssFiniteType.of_finiteType (Polynomial F) ↥C_R
      have _ : Algebra.EssFiniteType (Polynomial k) ↥C_R :=
        Algebra.EssFiniteType.of_comp (Polynomial F) (Polynomial k) ↥C_R
      have _ : Algebra.IsSeparable (RatFunc k) E := IsGalois.to_isSeparable
      have _ : IsDedekindDomain ↥E₀ :=
        integralClosure.isDedekindDomain (Polynomial k) (RatFunc k) E
      have _ : IsNoetherian (Polynomial k) ↥E₀ :=
        IsIntegralClosure.isNoetherian (Polynomial k) (RatFunc k) E ↥E₀
      have _ : Algebra.EssFiniteType (Polynomial k) ↥E₀ :=
        Algebra.EssFiniteType.of_finiteType (Polynomial k) ↥E₀
      have _ : NoZeroSMulDivisors ↥E₀ ↥C_R :=
        ⟨fun {c x} h => by
          rw [Algebra.smul_def] at h
          exact (mul_eq_zero.mp h).imp_left (fun hc => hι_ER_inj (hc.trans (map_zero ι_ER).symm))⟩
      have _ : Q_R.LiesOver P := ⟨hQR_comap_E₀.symm⟩
      exact Algebra.IsUnramifiedAt.of_liesOver (Polynomial k) P Q_R

  
  have hOut3 : ∀ a ∈ S_aff, ∀ Q_k : Ideal ↥C₀_k, Q_k.IsPrime →
      Ideal.comap (algebraMap (Polynomial k) ↥C₀_k) Q_k =
        Ideal.span {Polynomial.X - Polynomial.C (algebraMap F k a)} →
      ∃ Q : Ideal ↥C₀, Q.IsPrime ∧
        Ideal.comap (algebraMap (Polynomial F) ↥C₀) Q =
          Ideal.span {Polynomial.X - Polynomial.C a} ∧
        ∀ f : L_r → L_r,
          (∀ y : ↥C₀_k, f (y : L_r) - (y : L_r) ∈ Subtype.val '' (Q_k : Set ↥C₀_k)) →
          (∀ y : ↥C₀, f (y : L_r) - (y : L_r) ∈ Subtype.val '' (Q : Set ↥C₀)) := by
    intro a _ha Q_k hQk_prime hQk_comap
    obtain ⟨Q, hQ_prime, hQ_mem, hQ_img⟩ :=
      hBridge (Polynomial F) (Polynomial k) h01_aff h10_aff Q_k hQk_prime
    refine ⟨Q, hQ_prime, ?_, ?_⟩
    · have _ : Q.IsPrime := hQ_prime
      set p_F : Ideal (Polynomial F) := Ideal.comap (algebraMap (Polynomial F) ↥C₀) Q
      have hp_F_prime : p_F.IsPrime := Ideal.IsPrime.comap (algebraMap (Polynomial F) ↥C₀)
      have hlin_mem_k :
          Polynomial.X - Polynomial.C (algebraMap F k a) ∈
            Ideal.comap (algebraMap (Polynomial k) ↥C₀_k) Q_k := by
        rw [hQk_comap]
        exact Ideal.mem_span_singleton_self _
      have hlin_mem_F : Polynomial.X - Polynomial.C a ∈ p_F := by
        rw [hQ_mem]
        let u_k : ↥C₀_k :=
          algebraMap (Polynomial k) ↥C₀_k (Polynomial.X - Polynomial.C (algebraMap F k a))
        refine ⟨u_k, hlin_mem_k, ?_⟩
        change algebraMap (Polynomial k) L_r (Polynomial.X - Polynomial.C (algebraMap F k a)) =
          algebraMap (Polynomial F) L_r (Polynomial.X - Polynomial.C a)
        have hmap_lin :
            φ_Fk (Polynomial.X - Polynomial.C a) =
              Polynomial.X - Polynomial.C (algebraMap F k a) := by
          simp [φ_Fk]
        rw [← hmap_lin, hφ_Fk]
      obtain ⟨_, hmax_F, _⟩ := hLinQuot F a
      exact (hmax_F.eq_of_le hp_F_prime.ne_top
        (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hlin_mem_F))).symm
    · intro f hf y
      rw [hQ_img]
      let y_k : ↥C₀_k := ⟨y.1, hIntSub (Polynomial k) (Polynomial F) h01_aff y.1 y.2⟩
      exact hf y_k

  
  have hPkg : ∃ (A_inf_k : Type u) (_ : CommRing A_inf_k) (_ : IsDedekindDomain A_inf_k)
      (_ : Algebra k A_inf_k) (_ : Algebra A_inf_k (RatFunc k))
      (_ : IsFractionRing A_inf_k (RatFunc k))
      (_ : IsScalarTower k A_inf_k (RatFunc k))
      (e_inf : Polynomial k ≃ₐ[k] A_inf_k)
      (t_K : A_inf_k),
    e_inf Polynomial.X = t_K ∧
    algebraMap A_inf_k (RatFunc k) t_K = (RatFunc.X : RatFunc k)⁻¹ ∧
    (Ideal.span {t_K} : Ideal A_inf_k) ≠ ⊥ ∧
    (Ideal.span {t_K} : Ideal A_inf_k).IsMaximal ∧
    Finite (A_inf_k ⧸ (Ideal.span {t_K} : Ideal A_inf_k)) := by
    let A₀ : Type u := (Polynomial k) ⧸ (⊥ : Ideal (Polynomial k))
    let e_inf : Polynomial k ≃ₐ[k] A₀ := (AlgEquiv.quotientBot k (Polynomial k)).symm
    let _ : IsDomain A₀ := Function.Injective.isDomain e_inf.symm.toRingHom e_inf.symm.injective
    let _ : IsPrincipalIdealRing A₀ :=
      IsPrincipalIdealRing.of_surjective e_inf.toRingHom e_inf.surjective
    let _ : IsDedekindDomain A₀ := IsPrincipalIdealRing.isDedekindDomain A₀
    let t_K : A₀ := e_inf Polynomial.X

    let X_K : RatFunc k := RatFunc.X
    have hXK_ne : X_K ≠ 0 := RatFunc.X_ne_zero
    let φ_inv : Polynomial k →ₐ[k] RatFunc k := Polynomial.aeval X_K⁻¹
    let ψ_K : A₀ →ₐ[k] RatFunc k := φ_inv.comp e_inf.symm.toAlgHom
    let _ : Algebra A₀ (RatFunc k) := ψ_K.toRingHom.toAlgebra
    have _ : IsScalarTower k A₀ (RatFunc k) :=
      IsScalarTower.of_algebraMap_eq (fun c => (ψ_K.commutes c).symm)
    have ht_K_map : algebraMap A₀ (RatFunc k) t_K = X_K⁻¹ := by
      change φ_inv (e_inf.symm (e_inf Polynomial.X)) = X_K⁻¹
      rw [e_inf.symm_apply_apply, Polynomial.aeval_X]

    let revAt : ℕ → Polynomial k → Polynomial k := fun d p =>
      ∑ i ∈ Finset.range (d + 1), Polynomial.monomial (d - i) (p.coeff i)

    have hrev_coeff : ∀ (d : ℕ) (p : Polynomial k) (m : ℕ),
        (revAt d p).coeff m = if m ≤ d then p.coeff (d - m) else 0 := by
      intro d p m
      dsimp [revAt]
      rw [Polynomial.finsetSum_coeff]
      simp_rw [Polynomial.coeff_monomial]
      split_ifs with hmd
      · rw [Finset.sum_eq_single (d - m)]
        · have hsub : d - (d - m) = m := by omega
          simp [hsub]
        · intro j hj hne
          rw [Finset.mem_range] at hj
          have hsub_ne : d - j ≠ m := by omega
          simp [hsub_ne]
        · intro hnotmem
          exfalso
          exact hnotmem (Finset.mem_range.mpr (by omega))
      · refine Finset.sum_eq_zero fun j hj => ?_
        rw [Finset.mem_range] at hj
        have hsub_ne : d - j ≠ m := by omega
        simp [hsub_ne]

    have hrev_deg : ∀ (d : ℕ) (p : Polynomial k), (revAt d p).natDegree ≤ d := by
      intro d p
      rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro N hN
      rw [hrev_coeff]
      have hnot : ¬ N ≤ d := by omega
      simp [hnot]

    have hrev_invol : ∀ (d : ℕ) (p : Polynomial k),
        p.natDegree ≤ d → revAt d (revAt d p) = p := by
      intro d p hp
      ext m
      rw [hrev_coeff]
      split_ifs with hmd
      · rw [hrev_coeff]
        have hdm : d - m ≤ d := by omega
        have hsub : d - (d - m) = m := by omega
        simp [hdm, hsub]
      · symm
        exact Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)

    have hrev_zero : ∀ d : ℕ, revAt d 0 = 0 := by
      intro d
      ext m
      rw [hrev_coeff]
      simp

    have hrev_eval : ∀ (d : ℕ) (p : Polynomial k),
        p.natDegree ≤ d →
        X_K ^ d * φ_inv p = algebraMap (Polynomial k) (RatFunc k) (revAt d p) := by
      intro d p hp
      have hp_sum := Polynomial.as_sum_range' p (d + 1) (Nat.lt_succ_of_le hp)
      conv_lhs => rw [hp_sum]
      dsimp [revAt]
      rw [map_sum, Finset.mul_sum, map_sum]
      refine Finset.sum_congr rfl fun i hi => ?_
      rw [Finset.mem_range] at hi
      rw [← Polynomial.C_mul_X_pow_eq_monomial, ← Polynomial.C_mul_X_pow_eq_monomial]
      simp only [φ_inv, map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
      have hC_map : algebraMap (Polynomial k) (RatFunc k) (Polynomial.C (p.coeff i)) =
          algebraMap k (RatFunc k) (p.coeff i) := by
        change algebraMap (Polynomial k) (RatFunc k)
          (algebraMap k (Polynomial k) (p.coeff i)) = _
        rw [← IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k)]
      have hX_map : algebraMap (Polynomial k) (RatFunc k) Polynomial.X = X_K :=
        RatFunc.algebraMap_X
      rw [hC_map, hX_map]
      have hpow_split : X_K ^ d * (X_K⁻¹) ^ i = X_K ^ (d - i) := by
        have hd_eq : d = (d - i) + i := by omega
        conv_lhs => rw [hd_eq, pow_add]
        rw [mul_assoc, ← mul_pow, mul_inv_cancel₀ hXK_ne, one_pow, mul_one]
      calc
        X_K ^ d * (algebraMap k (RatFunc k) (p.coeff i) * (X_K⁻¹) ^ i)
            = algebraMap k (RatFunc k) (p.coeff i) * (X_K ^ d * (X_K⁻¹) ^ i) := by ring
        _ = algebraMap k (RatFunc k) (p.coeff i) * X_K ^ (d - i) := by rw [hpow_split]

    have hφ_inv_inj : Function.Injective φ_inv := by
      intro p₁ p₂ hp
      set p := p₁ - p₂
      have hp0 : φ_inv p = 0 := by simp [p, map_sub, hp]
      have hev := hrev_eval p.natDegree p le_rfl
      rw [hp0, mul_zero] at hev
      have hrev0 : revAt p.natDegree p = 0 :=
        IsFractionRing.injective (Polynomial k) (RatFunc k) ((map_zero _).trans hev).symm
      have hp_eq0 : p = 0 := by
        rw [← hrev_invol p.natDegree p le_rfl, hrev0, hrev_zero]
      exact sub_eq_zero.mp hp_eq0

    have hψ_K_inj : Function.Injective ψ_K := hφ_inv_inj.comp e_inf.symm.injective

    let _ : IsFractionRing A₀ (RatFunc k) :=
      { map_units := fun ⟨s, hs⟩ =>
          IsUnit.mk0 _ (fun h0 =>
            (mem_nonZeroDivisors_iff_ne_zero.mp hs)
              (hψ_K_inj (h0.trans (map_zero ψ_K).symm)))
        surj := fun z => by
          obtain ⟨f, g, hg_nzd, hfg⟩ := IsFractionRing.div_surjective (Polynomial k) z
          have hg_ne : g ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hg_nzd
          let d := max f.natDegree g.natDegree
          let f' := revAt d f
          let g' := revAt d g
          have hf_inv : revAt d f' = f := hrev_invol d f (le_max_left _ _)
          have hg_inv : revAt d g' = g := hrev_invol d g (le_max_right _ _)
          have hg'_ne : g' ≠ 0 := by
            intro h0
            rw [h0, hrev_zero] at hg_inv
            exact hg_ne hg_inv.symm
          have hG_ne : e_inf g' ≠ 0 :=
            fun h0 => hg'_ne (e_inf.injective (h0.trans (map_zero e_inf).symm))
          let G' : nonZeroDivisors A₀ := ⟨e_inf g', mem_nonZeroDivisors_iff_ne_zero.mpr hG_ne⟩
          let F' : A₀ := e_inf f'
          have hF_ev : X_K ^ d * ψ_K F' = algebraMap (Polynomial k) (RatFunc k) f := by
            change X_K ^ d * φ_inv (e_inf.symm (e_inf f')) = _
            rw [e_inf.symm_apply_apply, hrev_eval d f' (hrev_deg d f), hf_inv]
          have hG_ev : X_K ^ d * ψ_K G'.1 = algebraMap (Polynomial k) (RatFunc k) g := by
            change X_K ^ d * φ_inv (e_inf.symm (e_inf g')) = _
            rw [e_inf.symm_apply_apply, hrev_eval d g' (hrev_deg d g), hg_inv]
          have hιg_ne : algebraMap (Polynomial k) (RatFunc k) g ≠ 0 :=
            fun h0 => hg_ne (IsFractionRing.injective (Polynomial k) (RatFunc k)
              (h0.trans (map_zero _).symm))
          refine ⟨⟨F', G'⟩, ?_⟩
          change z * ψ_K G'.1 = ψ_K F'
          apply mul_left_cancel₀ (pow_ne_zero d hXK_ne)
          calc
            X_K ^ d * (z * ψ_K G'.1)
                = z * (X_K ^ d * ψ_K G'.1) := by ring
            _ = z * algebraMap (Polynomial k) (RatFunc k) g := by rw [hG_ev]
            _ = algebraMap (Polynomial k) (RatFunc k) f := by
                  rw [← hfg, div_mul_cancel₀ _ hιg_ne]
            _ = X_K ^ d * ψ_K F' := hF_ev.symm
        exists_of_eq := fun h => ⟨1, by simpa using hψ_K_inj h⟩ }

    have hp_tK_ne : (Ideal.span {t_K} : Ideal A₀) ≠ ⊥ := by
      refine Ideal.span_singleton_eq_bot.not.mpr ?_
      intro ht0
      exact Polynomial.X_ne_zero (e_inf.injective (ht0.trans (map_zero e_inf).symm))

    let ev_inf : A₀ →+* k := (Polynomial.evalRingHom 0).comp e_inf.symm.toRingHom
    have hev_surj : Function.Surjective ev_inf :=
      fun c => ⟨e_inf (Polynomial.C c), by simp [ev_inf]⟩
    have hev_ker : RingHom.ker ev_inf = Ideal.span {t_K} := by
      ext x
      change e_inf.symm x ∈ RingHom.ker (Polynomial.evalRingHom (0 : k)) ↔
        x ∈ Ideal.span {t_K}
      rw [Polynomial.ker_evalRingHom, Polynomial.C_0, sub_zero,
        Ideal.mem_span_singleton, Ideal.mem_span_singleton]
      constructor
      · rintro ⟨q, hq⟩
        refine ⟨e_inf q, ?_⟩
        apply e_inf.symm.injective
        rw [hq, map_mul, e_inf.symm_apply_apply]
        rfl
      · rintro ⟨y, rfl⟩
        exact ⟨e_inf.symm y, by simp [t_K]⟩
    let q_inf_equiv : (A₀ ⧸ Ideal.span {t_K}) ≃+* k :=
      (Ideal.quotEquivOfEq hev_ker.symm).trans (RingHom.quotientKerEquivOfSurjective hev_surj)
    have hp_tK_max : (Ideal.span {t_K} : Ideal A₀).IsMaximal :=
      (Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mpr
        (MulEquiv.isField (Field.toIsField k) q_inf_equiv.toMulEquiv)
    have hp_tK_fin : Finite (A₀ ⧸ Ideal.span {t_K}) :=
      Finite.of_equiv k q_inf_equiv.symm.toEquiv

    exact ⟨A₀, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      inferInstance, e_inf, t_K, rfl, ht_K_map, hp_tK_ne, hp_tK_max, hp_tK_fin⟩

  
  have hOut4 : ∃ (A_inf_k : Type u) (_ : CommRing A_inf_k) (_ : IsDedekindDomain A_inf_k)
      (_ : Algebra k A_inf_k) (_ : Algebra A_inf_k (RatFunc k))
      (_ : IsFractionRing A_inf_k (RatFunc k))
      (_ : Algebra A_inf_k E) (_ : Algebra A_inf_k L_r)
      (_ : IsScalarTower k A_inf_k (RatFunc k))
      (_ : IsScalarTower A_inf_k (RatFunc k) E)
      (_ : IsScalarTower A_inf_k (RatFunc k) L_r)
      (_ : IsScalarTower A_inf_k E L_r)
      (e_inf : Polynomial k ≃ₐ[k] A_inf_k)
      (t_K : A_inf_k),
    e_inf Polynomial.X = t_K ∧
    algebraMap A_inf_k (RatFunc k) t_K = (RatFunc.X : RatFunc k)⁻¹ ∧
    (Ideal.span {t_K} : Ideal A_inf_k) ≠ ⊥ ∧
    (Ideal.span {t_K} : Ideal A_inf_k).IsMaximal ∧
    Finite (A_inf_k ⧸ (Ideal.span {t_K} : Ideal A_inf_k)) ∧
    ∀ Q_inf_k : Ideal ↥(integralClosure A_inf_k L_r), Q_inf_k.IsPrime →
      Ideal.comap (algebraMap A_inf_k ↥(integralClosure A_inf_k L_r)) Q_inf_k =
        Ideal.span {t_K} →
      ∃ Q_inf : Ideal ↥C_inf, Q_inf.IsPrime ∧
        Ideal.comap (algebraMap ↥A_inf ↥C_inf) Q_inf = Ideal.span {t_inf} ∧
        ∀ f : L_r → L_r,
          (∀ y : ↥(integralClosure A_inf_k L_r),
            f (y : L_r) - (y : L_r) ∈
              Subtype.val '' (Q_inf_k : Set ↥(integralClosure A_inf_k L_r))) →
          (∀ y : ↥C_inf, f (y : L_r) - (y : L_r) ∈ Subtype.val '' (Q_inf : Set ↥C_inf)) := by
    obtain ⟨A_inf_k, hCR, hDD, hAk, hARk, hFrac, hST_k_Rk,
      e_inf, t_K, he_X, ht_K_map, hp_tK_ne, hp_tK_max, hp_tK_fin⟩ := hPkg
    let _ : CommRing A_inf_k := hCR
    let _ : IsDedekindDomain A_inf_k := hDD
    let _ : Algebra k A_inf_k := hAk
    let _ : Algebra A_inf_k (RatFunc k) := hARk
    let _ : IsFractionRing A_inf_k (RatFunc k) := hFrac
    have _ : IsScalarTower k A_inf_k (RatFunc k) := hST_k_Rk
    let _ : Algebra A_inf_k E :=
      ((algebraMap (RatFunc k) E).comp (algebraMap A_inf_k (RatFunc k))).toAlgebra
    let _ : Algebra A_inf_k L_r :=
      ((algebraMap (RatFunc k) L_r).comp (algebraMap A_inf_k (RatFunc k))).toAlgebra
    have _ : IsScalarTower A_inf_k (RatFunc k) E := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have _ : IsScalarTower A_inf_k (RatFunc k) L_r := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have _ : IsScalarTower A_inf_k E L_r :=
      IsScalarTower.of_algebraMap_eq fun x =>
        IsScalarTower.algebraMap_apply (RatFunc k) E L_r (algebraMap A_inf_k (RatFunc k) x)

    set u₀ : L_r := algebraMap (RatFunc F) L_r (RatFunc.X)⁻¹
    have hu₀_eq_tK : algebraMap A_inf_k L_r t_K = u₀ := by
      calc
        algebraMap A_inf_k L_r t_K
            = algebraMap (RatFunc k) L_r (algebraMap A_inf_k (RatFunc k) t_K) := rfl
        _ = algebraMap (RatFunc k) L_r (RatFunc.X : RatFunc k)⁻¹ := by rw [ht_K_map]
        _ = (algebraMap (RatFunc k) L_r RatFunc.X)⁻¹ := map_inv₀ _ _
        _ = (algebraMap (RatFunc F) L_r RatFunc.X)⁻¹ := by rw [hX_eq]
        _ = u₀ := (map_inv₀ _ _).symm

    have hST_k_Ainf_L : IsScalarTower k A_inf_k L_r := by
      refine IsScalarTower.of_algebraMap_eq fun c => ?_
      calc
        algebraMap k L_r c
            = algebraMap (RatFunc k) L_r (algebraMap k (RatFunc k) c) :=
              IsScalarTower.algebraMap_apply k (RatFunc k) L_r c
        _ = algebraMap (RatFunc k) L_r (algebraMap A_inf_k (RatFunc k) (algebraMap k A_inf_k c)) := by
              rw [← IsScalarTower.algebraMap_apply k A_inf_k (RatFunc k) c]
        _ = algebraMap A_inf_k L_r (algebraMap k A_inf_k c) := rfl

    have h01_inf : ∀ z : ↥A_inf, IsIntegral A_inf_k (algebraMap ↥A_inf L_r z) := by
      have _ : IsScalarTower k A_inf_k L_r := hST_k_Ainf_L
      intro z
      have hz_range : z.1 ∈ (Polynomial.aeval u₀ : Polynomial F →ₐ[F] L_r).range := by
        rw [← Algebra.adjoin_singleton_eq_range_aeval F u₀]
        exact z.2
      rcases hz_range with ⟨P, hP⟩
      have hP' : Polynomial.aeval u₀ P = z.1 := hP
      change z.1 ∈ integralClosure A_inf_k L_r
      rw [← hP']
      refine Polynomial.induction_on' P ?_ ?_
      · intro p₁ p₂ hp₁ hp₂
        rw [map_add]
        exact (integralClosure A_inf_k L_r).add_mem hp₁ hp₂
      · intro n c
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow,
          Polynomial.aeval_C, Polynomial.aeval_X]
        have hc : algebraMap F L_r c ∈ integralClosure A_inf_k L_r := by
          rw [IsScalarTower.algebraMap_apply F k L_r c,
            IsScalarTower.algebraMap_apply k A_inf_k L_r (algebraMap F k c)]
          exact (integralClosure A_inf_k L_r).algebraMap_mem _
        have hu : u₀ ∈ integralClosure A_inf_k L_r := by
          rw [← hu₀_eq_tK]
          exact (integralClosure A_inf_k L_r).algebraMap_mem t_K
        exact (integralClosure A_inf_k L_r).mul_mem hc
          ((integralClosure A_inf_k L_r).pow_mem hu n)

    have h10_inf : ∀ w : A_inf_k, IsIntegral ↥A_inf (algebraMap A_inf_k L_r w) := by
      have _ : IsScalarTower k A_inf_k L_r := hST_k_Ainf_L
      intro w
      let α₁ : Polynomial k →ₐ[k] L_r :=
        (IsScalarTower.toAlgHom k A_inf_k L_r).comp e_inf.toAlgHom
      have hα₁_eq : α₁ = Polynomial.aeval u₀ := by
        apply Polynomial.algHom_ext
        change algebraMap A_inf_k L_r (e_inf Polynomial.X) = Polynomial.aeval u₀ Polynomial.X
        rw [he_X, Polynomial.aeval_X]
        exact hu₀_eq_tK
      have hw_eq : algebraMap A_inf_k L_r w = Polynomial.aeval u₀ (e_inf.symm w) := by
        have h1 : α₁ (e_inf.symm w) = algebraMap A_inf_k L_r w := by
          change algebraMap A_inf_k L_r (e_inf (e_inf.symm w)) = _
          rw [e_inf.apply_symm_apply]
        rw [← h1, hα₁_eq]
      change algebraMap A_inf_k L_r w ∈ C_inf
      rw [hw_eq]
      refine Polynomial.induction_on' (e_inf.symm w) ?_ ?_
      · intro p₁ p₂ hp₁ hp₂
        rw [map_add]
        exact C_inf.add_mem hp₁ hp₂
      · intro n c
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow,
          Polynomial.aeval_C, Polynomial.aeval_X]
        have hc : algebraMap k L_r c ∈ C_inf :=
          IsIntegral.tower_top (R := F) (A := ↥A_inf) (hk_int c)
        have hu : u₀ ∈ C_inf := C_inf.algebraMap_mem t_inf
        exact C_inf.mul_mem hc (C_inf.pow_mem hu n)

    refine ⟨A_inf_k, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      e_inf, t_K, he_X, ht_K_map, hp_tK_ne, hp_tK_max, hp_tK_fin, ?_⟩
    intro Q_inf_k hQinf_k_prime hQinf_k_comap
    obtain ⟨Q_inf, hQinf_prime, hQinf_mem, hQinf_img⟩ :=
      hBridge ↥A_inf A_inf_k h01_inf h10_inf Q_inf_k hQinf_k_prime
    refine ⟨Q_inf, hQinf_prime, ?_, ?_⟩
    · have _ : Q_inf.IsPrime := hQinf_prime
      set p_inf : Ideal ↥A_inf := Ideal.comap (algebraMap ↥A_inf ↥C_inf) Q_inf
      have hp_inf_prime : p_inf.IsPrime := Ideal.IsPrime.comap (algebraMap ↥A_inf ↥C_inf)
      have htK_mem :
          t_K ∈ Ideal.comap (algebraMap A_inf_k ↥(integralClosure A_inf_k L_r)) Q_inf_k := by
        rw [hQinf_k_comap]
        exact Ideal.mem_span_singleton_self t_K
      have ht_inf_mem : t_inf ∈ p_inf := by
        rw [hQinf_mem]
        let v_k : ↥(integralClosure A_inf_k L_r) :=
          algebraMap A_inf_k ↥(integralClosure A_inf_k L_r) t_K
        exact ⟨v_k, htK_mem, hu₀_eq_tK⟩
      exact hTinfCollapse p_inf ht_inf_mem hp_inf_prime.ne_top
    · intro f hf y
      rw [hQinf_img]
      let y_k : ↥(integralClosure A_inf_k L_r) :=
        ⟨y.1, hIntSub A_inf_k ↥A_inf h01_inf y.1 y.2⟩
      exact hf y_k

  exact ⟨hOut1, hOut2, hOut3, hOut4⟩

theorem weil_ratfunc_everywhere_unramified_finrank_eq_one (k E A_inf_k : Type u)
    [Field k] [Field E] [CommRing A_inf_k] [IsDedekindDomain A_inf_k]
    [Algebra k E] [Algebra (Polynomial k) E] [Algebra (RatFunc k) E]
    [Algebra k A_inf_k] [Algebra A_inf_k (RatFunc k)] [IsFractionRing A_inf_k (RatFunc k)]
    [Algebra A_inf_k E]
    [IsScalarTower k (Polynomial k) E] [IsScalarTower k (RatFunc k) E]
    [IsScalarTower (Polynomial k) (RatFunc k) E]
    [IsScalarTower k A_inf_k (RatFunc k)] [IsScalarTower A_inf_k (RatFunc k) E]
    [FiniteDimensional (RatFunc k) E] [Algebra.IsSeparable (RatFunc k) E]
    (e_inf : Polynomial k ≃ₐ[k] A_inf_k) (t_K : A_inf_k) :
    e_inf Polynomial.X = t_K →
    algebraMap A_inf_k (RatFunc k) t_K = (RatFunc.X : RatFunc k)⁻¹ →
    (∀ x : E, IsIntegral k x → x ∈ Set.range (algebraMap k E)) →
    (∀ (P : Ideal ↥(integralClosure (Polynomial k) E)) [P.IsPrime],
      P ≠ ⊥ → Algebra.IsUnramifiedAt (Polynomial k) P) →
    (∀ (P_inf : Ideal ↥(integralClosure A_inf_k E)) [P_inf.IsPrime],
      Ideal.comap (algebraMap A_inf_k ↥(integralClosure A_inf_k E)) P_inf = Ideal.span {t_K} →
      Algebra.IsUnramifiedAt A_inf_k P_inf) →
    Module.finrank (RatFunc k) E = 1 :=
by
  intro he_X ht_K hk_closed hUnram_aff hUnram_inf
  classical
  let X_K : RatFunc k := RatFunc.X
  let π_K : RatFunc k := X_K⁻¹
  let m_T : Ideal A_inf_k := Ideal.span {t_K}
  let E₀ := integralClosure (Polynomial k) E
  let E_inf := integralClosure A_inf_k E
  have : IsScalarTower k A_inf_k E := IsScalarTower.of_algebraMap_eq fun c => by
    rw [IsScalarTower.algebraMap_apply A_inf_k (RatFunc k) E,
      ← IsScalarTower.algebraMap_apply k A_inf_k (RatFunc k),
      ← IsScalarTower.algebraMap_apply k (RatFunc k) E]
  have hKE_inj : Function.Injective (algebraMap (RatFunc k) E) :=
    RingHom.injective (algebraMap (RatFunc k) E)
  have hX_K_ne : X_K ≠ 0 := RatFunc.X_ne_zero
  have hπ_K_ne : π_K ≠ 0 := inv_ne_zero hX_K_ne
  have hXπ : X_K * π_K = 1 := mul_inv_cancel₀ hX_K_ne
  have hπX : π_K * X_K = 1 := inv_mul_cancel₀ hX_K_ne
  have hX_alg : algebraMap (Polynomial k) (RatFunc k) Polynomial.X = X_K := RatFunc.algebraMap_X
  have hae_X : ∀ P : Polynomial k,
      algebraMap (Polynomial k) (RatFunc k) P = Polynomial.aeval X_K P := by
    have hHom : IsScalarTower.toAlgHom k (Polynomial k) (RatFunc k) = Polynomial.aeval X_K := by
      apply Polynomial.algHom_ext
      rw [IsScalarTower.toAlgHom_apply, hX_alg, Polynomial.aeval_X]
    exact fun P => AlgHom.congr_fun hHom P
  have hae_π : ∀ P : Polynomial k,
      algebraMap A_inf_k (RatFunc k) (e_inf P) = Polynomial.aeval π_K P := by
    have hHom : (IsScalarTower.toAlgHom k A_inf_k (RatFunc k)).comp e_inf.toAlgHom =
        Polynomial.aeval π_K := by
      apply Polynomial.algHom_ext
      rw [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply, Polynomial.aeval_X]
      change algebraMap A_inf_k (RatFunc k) (e_inf Polynomial.X) = π_K
      rw [he_X, ht_K]
    exact fun P => AlgHom.congr_fun hHom P

  
  have he_symm_t : e_inf.symm t_K = Polynomial.X := by
    rw [← he_X, e_inf.symm_apply_apply]
  have hm_T_iff : ∀ a : A_inf_k, a ∈ m_T ↔ (e_inf.symm a).coeff 0 = 0 := by
    intro a
    rw [Ideal.mem_span_singleton]
    constructor
    · rintro ⟨b, rfl⟩
      rw [map_mul, he_symm_t, Polynomial.coeff_X_mul_zero]
    · intro h0
      have hroot : Polynomial.IsRoot (e_inf.symm a) 0 := by
        rw [Polynomial.IsRoot.def, ← Polynomial.coeff_zero_eq_eval_zero, h0]
      have hdvd : Polynomial.X ∣ e_inf.symm a := by
        simpa only [map_zero, sub_zero] using Polynomial.dvd_iff_isRoot.mpr hroot
      rcases hdvd with ⟨q, hq⟩
      refine ⟨e_inf q, ?_⟩
      calc a = e_inf (e_inf.symm a) := (e_inf.apply_symm_apply a).symm
        _ = e_inf (Polynomial.X * q) := by rw [hq]
        _ = t_K * e_inf q := by rw [map_mul, he_X]
  have hm_max : m_T.IsMaximal := by
    let ε : A_inf_k →+* k := (Polynomial.evalRingHom (0 : k)).comp e_inf.symm.toRingHom
    have hε_surj : Function.Surjective ε := fun c => by
      refine ⟨algebraMap k A_inf_k c, ?_⟩
      change Polynomial.eval 0 (e_inf.symm (algebraMap k A_inf_k c)) = c
      rw [e_inf.symm.commutes c, Polynomial.algebraMap_eq, Polynomial.eval_C]
    have hker : RingHom.ker ε = m_T := by
      ext a
      rw [RingHom.mem_ker, hm_T_iff]
      change Polynomial.eval 0 (e_inf.symm a) = 0 ↔ _
      rw [Polynomial.coeff_zero_eq_eval_zero]
    rw [← hker]
    exact RingHom.ker_isMaximal_of_surjective ε hε_surj
  have : m_T.IsMaximal := hm_max
  have : m_T.IsPrime := hm_max.isPrime
  have h1_not_mT : (1 : A_inf_k) ∉ m_T :=
    fun h1 => hm_max.ne_top ((Ideal.eq_top_iff_one m_T).mpr h1)
  have hs_ne_K : ∀ s : A_inf_k, s ∉ m_T → algebraMap A_inf_k (RatFunc k) s ≠ 0 := by
    intro s hs h0
    apply hs
    have hs0 : s = 0 := IsFractionRing.injective A_inf_k (RatFunc k) (h0.trans (map_zero _).symm)
    rw [hs0]
    exact m_T.zero_mem
  have hs_ne_E : ∀ s : A_inf_k, s ∉ m_T → algebraMap A_inf_k E s ≠ 0 := by
    intro s hs h0
    rw [IsScalarTower.algebraMap_apply A_inf_k (RatFunc k) E] at h0
    exact hs_ne_K s hs (hKE_inj (h0.trans (map_zero _).symm))

  
  have hPolyFactor : ∀ (n : ℕ) (P : Polynomial k),
      P.natDegree ≤ n → P ≠ 0 →
      ∃ (m : ℕ) (Q : Polynomial k), Q.coeff 0 ≠ 0 ∧ P = Polynomial.X ^ m * Q := by
    intro n
    induction n with
    | zero =>
      intro P hdeg hne
      have hdeg0 : P.natDegree = 0 := Nat.eq_zero_of_le_zero hdeg
      refine ⟨0, P, ?_, by simp⟩
      intro h0
      apply hne
      rw [Polynomial.eq_C_of_natDegree_eq_zero hdeg0, h0, map_zero]
    | succ n ih =>
      intro P hdeg hne
      by_cases h0 : P.coeff 0 = 0
      · have hroot : Polynomial.IsRoot P 0 := by
          rw [Polynomial.IsRoot.def, ← Polynomial.coeff_zero_eq_eval_zero, h0]
        have hdvd : Polynomial.X ∣ P := by
          simpa only [map_zero, sub_zero] using Polynomial.dvd_iff_isRoot.mpr hroot
        rcases hdvd with ⟨P₁, rfl⟩
        have hP₁_ne : P₁ ≠ 0 := right_ne_zero_of_mul hne
        have hdeg₁ : P₁.natDegree ≤ n := by
          rw [Polynomial.natDegree_X_mul hP₁_ne] at hdeg
          omega
        obtain ⟨m₁, Q, hQ0, hP₁_eq⟩ := ih P₁ hdeg₁ hP₁_ne
        refine ⟨m₁ + 1, Q, hQ0, ?_⟩
        rw [hP₁_eq, pow_succ', mul_assoc]
      · exact ⟨0, P, h0, by simp⟩
  have hFactor : ∀ b : A_inf_k, b ≠ 0 → ∃ (m : ℕ) (s : A_inf_k), s ∉ m_T ∧ b = t_K ^ m * s := by
    intro b hb
    have hP_ne : e_inf.symm b ≠ 0 :=
      fun h0 => hb (by rw [← e_inf.apply_symm_apply b, h0, map_zero])
    obtain ⟨m, Q, hQ0, hQ_eq⟩ := hPolyFactor (e_inf.symm b).natDegree (e_inf.symm b) le_rfl hP_ne
    refine ⟨m, e_inf Q, ?_, ?_⟩
    · rw [hm_T_iff, e_inf.symm_apply_apply]
      exact hQ0
    · calc b = e_inf (e_inf.symm b) := (e_inf.apply_symm_apply b).symm
        _ = e_inf (Polynomial.X ^ m * Q) := by rw [hQ_eq]
        _ = t_K ^ m * e_inf Q := by rw [map_mul, map_pow, he_X]

  
  let R_set : Set (RatFunc k) :=
    { x : RatFunc k | ∃ a s : A_inf_k, s ∉ m_T ∧
        x = (algebraMap A_inf_k (RatFunc k) s)⁻¹ * algebraMap A_inf_k (RatFunc k) a }
  let R_deg : Set (RatFunc k) :=
    { x : RatFunc k | ∃ f g : Polynomial k, g ≠ 0 ∧ f.natDegree ≤ g.natDegree ∧
        x = (algebraMap (Polynomial k) (RatFunc k) g)⁻¹ * algebraMap (Polynomial k) (RatFunc k) f }
  let rev : ℕ → Polynomial k → Polynomial k := fun N P =>
    ∑ i ∈ Finset.range (N + 1), Polynomial.monomial (N - i) (P.coeff i)
  have hrev_coeff_le : ∀ (N : ℕ) (P : Polynomial k) (j : ℕ),
      j ≤ N → (rev N P).coeff j = P.coeff (N - j) := by
    intro N P j hj
    simp only [rev, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial]
    rw [Finset.sum_eq_single (N - j)]
    · have hsub : N - (N - j) = j := by omega
      simp [hsub]
    · intro b hb hne
      rw [Finset.mem_range] at hb
      have hsub : N - b ≠ j := by omega
      simp [hsub]
    · intro hnotmem
      exfalso
      apply hnotmem
      rw [Finset.mem_range]
      omega
  have hrev_coeff_gt : ∀ (N : ℕ) (P : Polynomial k) (j : ℕ),
      N < j → (rev N P).coeff j = 0 := by
    intro N P j hj
    simp only [rev, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial]
    refine Finset.sum_eq_zero fun i _ => ?_
    have hsub : N - i ≠ j := by omega
    simp [hsub]
  have hrev_deg : ∀ (N : ℕ) (P : Polynomial k), (rev N P).natDegree ≤ N := fun N P =>
    Polynomial.natDegree_le_iff_coeff_eq_zero.mpr (fun j hj => hrev_coeff_gt N P j hj)
  have hrev_inv : ∀ (N : ℕ) (P : Polynomial k), P.natDegree ≤ N → rev N (rev N P) = P := by
    intro N P hP
    ext j
    by_cases hj : j ≤ N
    · rw [hrev_coeff_le N _ j hj, hrev_coeff_le N P (N - j) (by omega)]
      congr 1
      omega
    · rw [hrev_coeff_gt N _ j (by omega), Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
  have hrev_eval : ∀ (N : ℕ) (P : Polynomial k),
      P.natDegree ≤ N →
      X_K ^ N * Polynomial.aeval π_K P = algebraMap (Polynomial k) (RatFunc k) (rev N P) := by
    intro N P hP
    conv_lhs => rw [Polynomial.as_sum_range' P (N + 1) (Nat.lt_succ_of_le hP)]
    rw [map_sum, Finset.mul_sum]
    dsimp only [rev]
    rw [map_sum]
    refine Finset.sum_congr rfl fun i hi => ?_
    have hi_le : i ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    rw [Polynomial.aeval_monomial, hae_X, Polynomial.aeval_monomial]
    have hN : N = (N - i) + i := by omega
    calc X_K ^ N * (algebraMap k (RatFunc k) (P.coeff i) * π_K ^ i)
        = algebraMap k (RatFunc k) (P.coeff i) * (X_K ^ ((N - i) + i) * π_K ^ i) := by
            conv_lhs => rw [hN]
            ring
      _ = algebraMap k (RatFunc k) (P.coeff i) * (X_K ^ (N - i) * (X_K * π_K) ^ i) := by
            rw [pow_add, mul_assoc, ← mul_pow]
      _ = algebraMap k (RatFunc k) (P.coeff i) * X_K ^ (N - i) := by
            rw [hXπ, one_pow, mul_one]
  have hR_eq : R_set = R_deg := by
    ext x
    constructor
    · rintro ⟨a, s, hs, rfl⟩
      let P := e_inf.symm a
      let Q := e_inf.symm s
      let N := max P.natDegree Q.natDegree
      have hP_le : P.natDegree ≤ N := le_max_left _ _
      have hQ_le : Q.natDegree ≤ N := le_max_right _ _
      let f := rev N P
      let g := rev N Q
      have hQ0 : Q.coeff 0 ≠ 0 := fun h0 => hs ((hm_T_iff s).mpr h0)
      have hgN : g.coeff N ≠ 0 := by
        rw [hrev_coeff_le N Q N le_rfl, Nat.sub_self]
        exact hQ0
      have hg_ne : g ≠ 0 := fun h0 => hgN (by rw [h0, Polynomial.coeff_zero])
      have hg_deg : g.natDegree = N :=
        le_antisymm (hrev_deg N Q) (Polynomial.le_natDegree_of_ne_zero hgN)
      have hf_le_g : f.natDegree ≤ g.natDegree := hg_deg ▸ hrev_deg N P
      have ha_eq : X_K ^ N * algebraMap A_inf_k (RatFunc k) a =
          algebraMap (Polynomial k) (RatFunc k) f := by
        calc X_K ^ N * algebraMap A_inf_k (RatFunc k) a
            = X_K ^ N * algebraMap A_inf_k (RatFunc k) (e_inf P) := by rw [e_inf.apply_symm_apply]
          _ = X_K ^ N * Polynomial.aeval π_K P := by rw [hae_π]
          _ = algebraMap (Polynomial k) (RatFunc k) f := hrev_eval N P hP_le
      have hs_eq : X_K ^ N * algebraMap A_inf_k (RatFunc k) s =
          algebraMap (Polynomial k) (RatFunc k) g := by
        calc X_K ^ N * algebraMap A_inf_k (RatFunc k) s
            = X_K ^ N * algebraMap A_inf_k (RatFunc k) (e_inf Q) := by rw [e_inf.apply_symm_apply]
          _ = X_K ^ N * Polynomial.aeval π_K Q := by rw [hae_π]
          _ = algebraMap (Polynomial k) (RatFunc k) g := hrev_eval N Q hQ_le
      refine ⟨f, g, hg_ne, hf_le_g, ?_⟩
      have hXN_ne : X_K ^ N ≠ 0 := pow_ne_zero N hX_K_ne
      rw [← hs_eq, ← ha_eq, mul_inv_rev, mul_assoc, inv_mul_cancel_left₀ hXN_ne]
    · rintro ⟨f, g, hg_ne, hfg, rfl⟩
      let N := g.natDegree
      let P := rev N f
      let Q := rev N g
      let a := e_inf P
      let s := e_inf Q
      have hs : s ∉ m_T := by
        rw [hm_T_iff, e_inf.symm_apply_apply, hrev_coeff_le N g 0 (Nat.zero_le N), Nat.sub_zero]
        exact Polynomial.leadingCoeff_ne_zero.mpr hg_ne
      have hf_eq : X_K ^ N * algebraMap A_inf_k (RatFunc k) a =
          algebraMap (Polynomial k) (RatFunc k) f := by
        rw [hae_π, hrev_eval N P (hrev_deg N f), hrev_inv N f hfg]
      have hg_eq : X_K ^ N * algebraMap A_inf_k (RatFunc k) s =
          algebraMap (Polynomial k) (RatFunc k) g := by
        rw [hae_π, hrev_eval N Q (hrev_deg N g), hrev_inv N g le_rfl]
      refine ⟨a, s, hs, ?_⟩
      have hXN_ne : X_K ^ N ≠ 0 := pow_ne_zero N hX_K_ne
      rw [← hg_eq, ← hf_eq, mul_inv_rev, mul_assoc, inv_mul_cancel_left₀ hXN_ne]

  
  have hPoly_inj : Function.Injective (algebraMap (Polynomial k) (RatFunc k)) :=
    IsFractionRing.injective (Polynomial k) (RatFunc k)
  have hPoly_ne : ∀ {g : Polynomial k}, g ≠ 0 → algebraMap (Polynomial k) (RatFunc k) g ≠ 0 :=
    fun hg h0 => hg (hPoly_inj (h0.trans (map_zero _).symm))
  have h0_Rdeg : (0 : RatFunc k) ∈ R_deg := ⟨0, 1, one_ne_zero, by simp, by simp⟩
  have h1_Rdeg : (1 : RatFunc k) ∈ R_deg := ⟨1, 1, one_ne_zero, le_rfl, by simp⟩
  have hadd_Rdeg : ∀ {u₁ u₂ : RatFunc k}, u₁ ∈ R_deg → u₂ ∈ R_deg → u₁ + u₂ ∈ R_deg := by
    rintro _ _ ⟨f₁, g₁, hg₁, hf₁, rfl⟩ ⟨f₂, g₂, hg₂, hf₂, rfl⟩
    have hg12 : g₁ * g₂ ≠ 0 := mul_ne_zero hg₁ hg₂
    have hdeg_g12 : (g₁ * g₂).natDegree = g₁.natDegree + g₂.natDegree :=
      Polynomial.natDegree_mul hg₁ hg₂
    have hdeg_num : (f₁ * g₂ + f₂ * g₁).natDegree ≤ (g₁ * g₂).natDegree := by
      rw [hdeg_g12]
      refine (Polynomial.natDegree_add_le _ _).trans (max_le ?_ ?_)
      · exact Polynomial.natDegree_mul_le.trans (Nat.add_le_add_right hf₁ _)
      · exact Polynomial.natDegree_mul_le.trans (by omega)
    refine ⟨f₁ * g₂ + f₂ * g₁, g₁ * g₂, hg12, hdeg_num, ?_⟩
    have hg₁K := hPoly_ne hg₁
    have hg₂K := hPoly_ne hg₂
    simp only [map_add, map_mul]
    field_simp [hg₁K, hg₂K]
  have hsmul_Rdeg : ∀ (c : k) {u : RatFunc k}, u ∈ R_deg → c • u ∈ R_deg := by
    rintro c _ ⟨f, g, hg, hf, rfl⟩
    refine ⟨Polynomial.C c * f, g, hg, (Polynomial.natDegree_C_mul_le c f).trans hf, ?_⟩
    rw [Algebra.smul_def, map_mul, ← Polynomial.algebraMap_eq,
      ← IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k)]
    ring
  have hsub_Rdeg : ∀ {u₁ u₂ : RatFunc k}, u₁ ∈ R_deg → u₂ ∈ R_deg → u₁ - u₂ ∈ R_deg := by
    intro u₁ u₂ hu₁ hu₂
    rw [sub_eq_add_neg]
    have hneg : -u₂ ∈ R_deg := by
      simpa only [neg_one_smul] using hsmul_Rdeg (-1 : k) hu₂
    exact hadd_Rdeg hu₁ hneg
  have hπ_pow_Rdeg : ∀ (m : ℕ) {u : RatFunc k}, u ∈ R_deg → π_K ^ m * u ∈ R_deg := by
    rintro m _ ⟨f, g, hg, hf, rfl⟩
    have hXm_ne : (Polynomial.X ^ m : Polynomial k) ≠ 0 := pow_ne_zero m Polynomial.X_ne_zero
    have hXmg_ne : Polynomial.X ^ m * g ≠ 0 := mul_ne_zero hXm_ne hg
    have hdeg : f.natDegree ≤ (Polynomial.X ^ m * g).natDegree := by
      rw [Polynomial.natDegree_mul hXm_ne hg, Polynomial.natDegree_X_pow]
      omega
    refine ⟨f, Polynomial.X ^ m * g, hXmg_ne, hdeg, ?_⟩
    rw [map_mul, map_pow, hX_alg, mul_inv_rev, ← inv_pow]
    ring
  have hPolyCap : ∀ p : Polynomial k,
      algebraMap (Polynomial k) (RatFunc k) p ∈ R_deg → p ∈ Set.range Polynomial.C := by
    rintro p ⟨f, g, hg, hfg, hp⟩
    have hgK := hPoly_ne hg
    have hmul : algebraMap (Polynomial k) (RatFunc k) (p * g) =
        algebraMap (Polynomial k) (RatFunc k) f := by
      rw [map_mul, hp]
      field_simp [hgK]
    have hpg : p * g = f := hPoly_inj hmul
    by_cases hp0 : p = 0
    · exact ⟨0, by rw [hp0, map_zero]⟩
    · have hdeg : p.natDegree + g.natDegree = f.natDegree := by
        rw [← Polynomial.natDegree_mul hp0 hg, hpg]
      have hp_deg0 : p.natDegree = 0 := by omega
      exact ⟨p.coeff 0, (Polynomial.eq_C_of_natDegree_eq_zero hp_deg0).symm⟩
  have hX_not_Rset : X_K ∉ R_set := by
    rw [hR_eq, ← hX_alg]
    intro hmem
    rcases hPolyCap Polynomial.X hmem with ⟨c, hc⟩
    have hdeg := congrArg Polynomial.natDegree hc
    rw [Polynomial.natDegree_C, Polynomial.natDegree_X] at hdeg
    exact zero_ne_one hdeg

  
  have hSplit0 : ∀ h : RatFunc k, ∃ (q : Polynomial k) (w : RatFunc k),
      w ∈ R_deg ∧ h = algebraMap (Polynomial k) (RatFunc k) q + π_K * w := by
    intro h
    let f := h.num
    let g := h.denom
    have hg_mon : g.Monic := RatFunc.monic_denom h
    have hg_ne : g ≠ 0 := hg_mon.ne_zero
    have hgK : algebraMap (Polynomial k) (RatFunc k) g ≠ 0 := hPoly_ne hg_ne
    let q := f /ₘ g
    let r := f %ₘ g
    have hdiv : r + g * q = f := Polynomial.modByMonic_add_div f g
    have hXr_deg : (Polynomial.X * r).natDegree ≤ g.natDegree := by
      by_cases hr0 : r = 0
      · simp [hr0]
      · have hg_ne_one : g ≠ 1 := by
          intro hg1
          apply hr0
          dsimp [r]
          rw [hg1, Polynomial.modByMonic_one]
        have hr_lt : r.natDegree < g.natDegree :=
          Polynomial.natDegree_modByMonic_lt f hg_mon hg_ne_one
        rw [Polynomial.natDegree_X_mul hr0]
        omega
    refine ⟨q,
      (algebraMap (Polynomial k) (RatFunc k) g)⁻¹ *
        algebraMap (Polynomial k) (RatFunc k) (Polynomial.X * r),
      ⟨Polynomial.X * r, g, hg_ne, hXr_deg, rfl⟩, ?_⟩
    have hnum_den : h =
        algebraMap (Polynomial k) (RatFunc k) f / algebraMap (Polynomial k) (RatFunc k) g :=
      (RatFunc.num_div_denom h).symm
    rw [hnum_den, ← hdiv, map_add, map_mul, map_mul, hX_alg]
    dsimp [π_K]
    field_simp [hgK, hX_K_ne]
    ring
  have hPeel : ∀ {w : RatFunc k}, w ∈ R_deg → ∃ (b : k) (w' : RatFunc k),
      w' ∈ R_deg ∧ w = algebraMap k (RatFunc k) b + π_K * w' := by
    rintro _ ⟨f, g, hg_ne, hfg, rfl⟩
    let n := g.natDegree
    have hlc_ne : g.coeff n ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hg_ne
    let b : k := f.coeff n * (g.coeff n)⁻¹
    let f' : Polynomial k := f - Polynomial.C b * g
    have hXf'_deg : (Polynomial.X * f').natDegree ≤ n := by
      rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro m hm
      obtain ⟨t, rfl⟩ : ∃ t : ℕ, m = t + 1 := ⟨m - 1, (Nat.sub_add_cancel (by omega)).symm⟩
      have ht_ge : n ≤ t := by omega
      rw [Polynomial.coeff_X_mul, Polynomial.coeff_sub, Polynomial.coeff_C_mul]
      rcases eq_or_lt_of_le ht_ge with rfl | hgt
      · dsimp [b]
        rw [inv_mul_cancel_right₀ hlc_ne, sub_self]
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (hfg.trans_lt hgt),
          Polynomial.coeff_eq_zero_of_natDegree_lt hgt, mul_zero, sub_zero]
    refine ⟨b,
      (algebraMap (Polynomial k) (RatFunc k) g)⁻¹ *
        algebraMap (Polynomial k) (RatFunc k) (Polynomial.X * f'),
      ⟨Polynomial.X * f', g, hg_ne, hXf'_deg, rfl⟩, ?_⟩
    have hgK := hPoly_ne hg_ne
    have hXf'_map : algebraMap (Polynomial k) (RatFunc k) (Polynomial.X * f') =
        X_K * (algebraMap (Polynomial k) (RatFunc k) f -
          algebraMap k (RatFunc k) b * algebraMap (Polynomial k) (RatFunc k) g) := by
      dsimp only [f']
      rw [map_mul, hX_alg, map_sub, map_mul, ← Polynomial.algebraMap_eq,
        ← IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k)]
    rw [hXf'_map]
    dsimp only [π_K]
    field_simp [hgK, hX_K_ne]
    ring
  have hTrunc : ∀ (M₀ : ℕ) (h : RatFunc k),
      ∃ (q : Polynomial k) (b : Fin M₀ → k) (w : RatFunc k),
        w ∈ R_deg ∧
        h = algebraMap (Polynomial k) (RatFunc k) q +
          (∑ j : Fin M₀, algebraMap k (RatFunc k) (b j) * π_K ^ ((j : ℕ) + 1)) +
          π_K ^ (M₀ + 1) * w := by
    intro M₀
    induction M₀ with
    | zero =>
      intro h
      obtain ⟨q, w, hw, h_eq⟩ := hSplit0 h
      exact ⟨q, Fin.elim0, w, hw, by simpa using h_eq⟩
    | succ M₀ ih =>
      intro h
      obtain ⟨q, b₀, w, hw, h_eq⟩ := ih h
      obtain ⟨b_last, w', hw', hw_eq⟩ := hPeel hw
      refine ⟨q, Fin.snoc b₀ b_last, w', hw', ?_⟩
      rw [Fin.sum_univ_castSucc]
      simp only [Fin.snoc_castSucc, Fin.val_castSucc, Fin.snoc_last, Fin.val_last]
      rw [h_eq, hw_eq]
      ring

  let IsDecomp1 : RatFunc k → Polynomial k → k → RatFunc k → Prop := fun h q c u =>
    u ∈ R_deg ∧
      h = algebraMap (Polynomial k) (RatFunc k) q + c • π_K + π_K ^ 2 * u
  have hDecomp1_exists :
      ∀ h : RatFunc k, ∃ (c : k) (q : Polynomial k) (u : RatFunc k), IsDecomp1 h q c u := by
    intro h
    obtain ⟨q, w, hw, h_eq⟩ := hSplit0 h
    obtain ⟨c, u, hu, hw_eq⟩ := hPeel hw
    refine ⟨c, q, u, hu, ?_⟩
    rw [Algebra.smul_def, h_eq, hw_eq]
    ring
  have hDecomp1_unique : ∀ {h : RatFunc k} {q₁ q₂ : Polynomial k} {c₁ c₂ : k} {u₁ u₂ : RatFunc k},
      IsDecomp1 h q₁ c₁ u₁ → IsDecomp1 h q₂ c₂ u₂ → c₁ = c₂ := by
    rintro h q₁ q₂ c₁ c₂ u₁ u₂ ⟨hu₁, h₁⟩ ⟨hu₂, h₂⟩
    rw [Algebra.smul_def] at h₁ h₂
    have heq : algebraMap (Polynomial k) (RatFunc k) q₁ +
          algebraMap k (RatFunc k) c₁ * π_K + π_K ^ 2 * u₁ =
        algebraMap (Polynomial k) (RatFunc k) q₂ +
          algebraMap k (RatFunc k) c₂ * π_K + π_K ^ 2 * u₂ := h₁.symm.trans h₂
    let P : Polynomial k := Polynomial.X * (q₁ - q₂) + Polynomial.C (c₁ - c₂)
    have hP_map : algebraMap (Polynomial k) (RatFunc k) P = π_K * (u₂ - u₁) := by
      have hmapP : algebraMap (Polynomial k) (RatFunc k) P =
          X_K * (algebraMap (Polynomial k) (RatFunc k) q₁ -
              algebraMap (Polynomial k) (RatFunc k) q₂) +
            (algebraMap k (RatFunc k) c₁ - algebraMap k (RatFunc k) c₂) := by
        dsimp only [P]
        rw [map_add, map_mul, map_sub, hX_alg, ← Polynomial.algebraMap_eq,
          ← IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k), map_sub]
      rw [hmapP]
      calc X_K * (algebraMap (Polynomial k) (RatFunc k) q₁ -
              algebraMap (Polynomial k) (RatFunc k) q₂) +
            (algebraMap k (RatFunc k) c₁ - algebraMap k (RatFunc k) c₂)
          = X_K * ((algebraMap (Polynomial k) (RatFunc k) q₁ + algebraMap k (RatFunc k) c₁ * π_K) -
              (algebraMap (Polynomial k) (RatFunc k) q₂ + algebraMap k (RatFunc k) c₂ * π_K)) +
              (algebraMap k (RatFunc k) c₁ - algebraMap k (RatFunc k) c₂) * (1 - X_K * π_K) := by
                ring
        _ = X_K * (π_K ^ 2 * u₂ - π_K ^ 2 * u₁) := by
              rw [hXπ, sub_self, mul_zero, add_zero]
              congr 1
              linear_combination heq
        _ = (X_K * π_K) * (π_K * (u₂ - u₁)) := by ring
        _ = π_K * (u₂ - u₁) := by rw [hXπ, one_mul]
    rcases hsub_Rdeg hu₂ hu₁ with ⟨f, g, hg_ne, hfg, hu_eq⟩
    have hgK := hPoly_ne hg_ne
    have hXg_ne : Polynomial.X * g ≠ 0 := mul_ne_zero Polynomial.X_ne_zero hg_ne
    have hmulK : algebraMap (Polynomial k) (RatFunc k) (P * (Polynomial.X * g)) =
        algebraMap (Polynomial k) (RatFunc k) f := by
      rw [map_mul, map_mul, hX_alg, hP_map, hu_eq]
      dsimp only [π_K]
      field_simp [hgK, hX_K_ne]
    have hmul : P * (Polynomial.X * g) = f := hPoly_inj hmulK
    have hP0 : P = 0 := by
      by_contra hP_ne
      have hdeg := congrArg Polynomial.natDegree hmul
      rw [Polynomial.natDegree_mul hP_ne hXg_ne,
        Polynomial.natDegree_mul Polynomial.X_ne_zero hg_ne, Polynomial.natDegree_X] at hdeg
      omega
    have hc0 : P.coeff 0 = 0 := by rw [hP0, Polynomial.coeff_zero]
    dsimp only [P] at hc0
    rw [Polynomial.coeff_add, Polynomial.coeff_X_mul_zero, zero_add, Polynomial.coeff_C_zero] at hc0
    exact sub_eq_zero.mp hc0

  let c_fn : RatFunc k → k := fun h => Classical.choose (hDecomp1_exists h)
  have hc_fn_spec : ∀ h : RatFunc k, ∃ (q : Polynomial k) (u : RatFunc k),
      IsDecomp1 h q (c_fn h) u :=
    fun h => Classical.choose_spec (hDecomp1_exists h)
  have hc_fn_add : ∀ h₁ h₂ : RatFunc k, c_fn (h₁ + h₂) = c_fn h₁ + c_fn h₂ := by
    intro h₁ h₂
    obtain ⟨q₁, u₁, hd₁⟩ := hc_fn_spec h₁
    obtain ⟨q₂, u₂, hd₂⟩ := hc_fn_spec h₂
    obtain ⟨q₃, u₃, hd₃⟩ := hc_fn_spec (h₁ + h₂)
    have hd_sum : IsDecomp1 (h₁ + h₂) (q₁ + q₂) (c_fn h₁ + c_fn h₂) (u₁ + u₂) := by
      refine ⟨hadd_Rdeg hd₁.1 hd₂.1, ?_⟩
      conv_lhs => rw [hd₁.2, hd₂.2]
      rw [map_add, add_smul, mul_add]
      abel
    exact hDecomp1_unique hd₃ hd_sum
  have hc_fn_smul : ∀ (a : k) (h : RatFunc k), c_fn (a • h) = a * c_fn h := by
    intro a h
    obtain ⟨q₁, u₁, hd₁⟩ := hc_fn_spec h
    obtain ⟨q₂, u₂, hd₂⟩ := hc_fn_spec (a • h)
    have hd_smul : IsDecomp1 (a • h) (Polynomial.C a * q₁) (a * c_fn h) (a • u₁) := by
      refine ⟨hsmul_Rdeg a hd₁.1, ?_⟩
      have hCq : algebraMap (Polynomial k) (RatFunc k) (Polynomial.C a * q₁) =
          a • algebraMap (Polynomial k) (RatFunc k) q₁ := by
        rw [map_mul, ← Polynomial.algebraMap_eq,
          ← IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k), Algebra.smul_def]
      conv_lhs => rw [hd₁.2]
      rw [smul_add, smul_add, hCq, mul_smul, mul_smul_comm]
    exact hDecomp1_unique hd₂ hd_smul
  let c_res : RatFunc k →ₗ[k] k :=
    { toFun := c_fn
      map_add' := hc_fn_add
      map_smul' := fun a h => by simp only [RingHom.id_apply, smul_eq_mul, hc_fn_smul] }
  have hc_of_decomp : ∀ {h : RatFunc k} {q : Polynomial k} {c : k} {u : RatFunc k},
      IsDecomp1 h q c u → c_res h = c := by
    intro h q c u hd
    obtain ⟨q₀, u₀, hd₀⟩ := Classical.choose_spec (hDecomp1_exists h)
    exact hDecomp1_unique hd₀ hd
  have hc_poly : ∀ p : Polynomial k, c_res (algebraMap (Polynomial k) (RatFunc k) p) = 0 :=
    fun p => hc_of_decomp (q := p) (c := 0) (u := 0) ⟨h0_Rdeg, by simp⟩
  have hc_rem : ∀ {u : RatFunc k}, u ∈ R_deg → c_res (π_K ^ 2 * u) = 0 :=
    fun {u} hu => hc_of_decomp (q := 0) (c := 0) (u := u) ⟨hu, by simp⟩
  have hc_pi : c_res π_K = 1 :=
    hc_of_decomp (q := 0) (c := 1) (u := 0) ⟨h0_Rdeg, by simp⟩
  have hc_X_pow_pi_pow :
      ∀ (a b : ℕ), c_res (X_K ^ a * π_K ^ (b + 1)) = if a = b then 1 else 0 := by
    intro a b
    rcases lt_trichotomy a b with hab | rfl | hba
    · simp only [hab.ne, ↓reduceIte]
      have hb_eq : b + 1 = a + 2 + (b - 1 - a) := by omega
      have hmul : X_K ^ a * π_K ^ (b + 1) = π_K ^ 2 * (π_K ^ (b - 1 - a) * 1) := by
        rw [hb_eq, pow_add, pow_add, mul_one]
        calc X_K ^ a * (π_K ^ a * π_K ^ 2 * π_K ^ (b - 1 - a))
            = (X_K ^ a * π_K ^ a) * (π_K ^ 2 * π_K ^ (b - 1 - a)) := by ring
          _ = (X_K * π_K) ^ a * (π_K ^ 2 * π_K ^ (b - 1 - a)) := by rw [← mul_pow]
          _ = π_K ^ 2 * π_K ^ (b - 1 - a) := by rw [hXπ, one_pow, one_mul]
      rw [hmul, hc_rem (hπ_pow_Rdeg (b - 1 - a) h1_Rdeg)]
    · simp only [↓reduceIte]
      rw [pow_succ, ← mul_assoc, ← mul_pow, hXπ, one_pow, one_mul, hc_pi]
    · simp only [hba.ne', ↓reduceIte]
      have ha_eq : a = (a - (b + 1)) + (b + 1) := by omega
      have hmul : X_K ^ a * π_K ^ (b + 1) =
          algebraMap (Polynomial k) (RatFunc k) (Polynomial.X ^ (a - (b + 1))) := by
        rw [map_pow, hX_alg]
        conv_lhs => rw [ha_eq, pow_add, mul_assoc, ← mul_pow, hXπ, one_pow, mul_one]
      rw [hmul, hc_poly]

  have hCritA : ∀ h : RatFunc k, (∀ n : ℕ, c_res (X_K ^ n * h) = 0) →
      h ∈ Set.range (algebraMap (Polynomial k) (RatFunc k)) := by
    intro h hvan
    let g₀ := h.denom
    let n₀ := g₀.natDegree
    obtain ⟨q, b, w, hw, h_eq⟩ := hTrunc n₀ h
    have hb_zero : ∀ j : Fin n₀, b j = 0 := by
      intro j
      have hj := hvan (j : ℕ)
      rw [h_eq, mul_add, mul_add, map_add, map_add] at hj
      have hterm1 : c_res (X_K ^ (j : ℕ) * algebraMap (Polynomial k) (RatFunc k) q) = 0 := by
        rw [← hX_alg, ← map_pow, ← map_mul, hc_poly]
      have hterm3 : c_res (X_K ^ (j : ℕ) * (π_K ^ (n₀ + 1) * w)) = 0 := by
        have hn₀_eq : n₀ + 1 = (j : ℕ) + 2 + (n₀ - 1 - (j : ℕ)) := by omega
        have hmul : X_K ^ (j : ℕ) * (π_K ^ (n₀ + 1) * w) =
            π_K ^ 2 * (π_K ^ (n₀ - 1 - (j : ℕ)) * w) := by
          rw [hn₀_eq, pow_add, pow_add]
          calc X_K ^ (j : ℕ) * (π_K ^ (j : ℕ) * π_K ^ 2 * π_K ^ (n₀ - 1 - (j : ℕ)) * w)
              = (X_K ^ (j : ℕ) * π_K ^ (j : ℕ)) * (π_K ^ 2 * (π_K ^ (n₀ - 1 - (j : ℕ)) * w)) := by
                  ring
            _ = (X_K * π_K) ^ (j : ℕ) * (π_K ^ 2 * (π_K ^ (n₀ - 1 - (j : ℕ)) * w)) := by
                  rw [← mul_pow]
            _ = π_K ^ 2 * (π_K ^ (n₀ - 1 - (j : ℕ)) * w) := by rw [hXπ, one_pow, one_mul]
        rw [hmul, hc_rem (hπ_pow_Rdeg _ hw)]
      have hterm2 :
          c_res (X_K ^ (j : ℕ) *
              ∑ i : Fin n₀, algebraMap k (RatFunc k) (b i) * π_K ^ ((i : ℕ) + 1)) = b j := by
        rw [Finset.mul_sum, map_sum, Finset.sum_eq_single j]
        · have hsc : X_K ^ (j : ℕ) * (algebraMap k (RatFunc k) (b j) * π_K ^ ((j : ℕ) + 1)) =
              b j • (X_K ^ (j : ℕ) * π_K ^ ((j : ℕ) + 1)) := by
            rw [Algebra.smul_def]; ring
          rw [hsc, map_smul, hc_X_pow_pi_pow]
          simp
        · intro i _ hij
          have hne_val : (j : ℕ) ≠ (i : ℕ) := fun hval => hij (Fin.ext hval.symm)
          have hsc : X_K ^ (j : ℕ) * (algebraMap k (RatFunc k) (b i) * π_K ^ ((i : ℕ) + 1)) =
              b i • (X_K ^ (j : ℕ) * π_K ^ ((i : ℕ) + 1)) := by
            rw [Algebra.smul_def]; ring
          rw [hsc, map_smul, hc_X_pow_pi_pow]
          simp [hne_val]
        · intro hnot; exact absurd (Finset.mem_univ j) hnot
      rw [hterm1, hterm2, hterm3, zero_add, add_zero] at hj
      exact hj
    have hsum_zero :
        (∑ j : Fin n₀, algebraMap k (RatFunc k) (b j) * π_K ^ ((j : ℕ) + 1)) = 0 := by
      refine Finset.sum_eq_zero fun j _ => ?_
      rw [hb_zero j, map_zero, zero_mul]
    rw [hsum_zero, add_zero] at h_eq
    rcases hw with ⟨f_w, g_w, hgw_ne, hfg_w, rfl⟩
    let f₀ := h.num
    have hg₀_ne : g₀ ≠ 0 := (RatFunc.monic_denom h).ne_zero
    have hg₀K := hPoly_ne hg₀_ne
    have hgwK := hPoly_ne hgw_ne
    let r₀ : Polynomial k := f₀ - q * g₀
    have hnum_den : h =
        algebraMap (Polynomial k) (RatFunc k) f₀ / algebraMap (Polynomial k) (RatFunc k) g₀ :=
      (RatFunc.num_div_denom h).symm
    have hr₀_K : algebraMap (Polynomial k) (RatFunc k) (Polynomial.X ^ (n₀ + 1) * r₀ * g_w) =
        algebraMap (Polynomial k) (RatFunc k) (f_w * g₀) := by
      have hsub_eq : h - algebraMap (Polynomial k) (RatFunc k) q =
          π_K ^ (n₀ + 1) *
            ((algebraMap (Polynomial k) (RatFunc k) g_w)⁻¹ *
              algebraMap (Polynomial k) (RatFunc k) f_w) :=
        sub_eq_of_eq_add' h_eq
      have hsub_g₀ : algebraMap (Polynomial k) (RatFunc k) r₀ =
          (h - algebraMap (Polynomial k) (RatFunc k) q) *
            algebraMap (Polynomial k) (RatFunc k) g₀ := by
        dsimp only [r₀]
        rw [map_sub, map_mul, hnum_den, sub_mul, div_mul_cancel₀ _ hg₀K]
      have hXπ_pow : X_K ^ (n₀ + 1) * π_K ^ (n₀ + 1) = 1 := by
        rw [← mul_pow, hXπ, one_pow]
      rw [map_mul, map_mul, map_pow, hX_alg, hsub_g₀, hsub_eq, map_mul]
      calc X_K ^ (n₀ + 1) *
              (π_K ^ (n₀ + 1) *
                  ((algebraMap (Polynomial k) (RatFunc k) g_w)⁻¹ *
                    algebraMap (Polynomial k) (RatFunc k) f_w) *
                algebraMap (Polynomial k) (RatFunc k) g₀) *
              algebraMap (Polynomial k) (RatFunc k) g_w
          = (X_K ^ (n₀ + 1) * π_K ^ (n₀ + 1)) *
              (algebraMap (Polynomial k) (RatFunc k) g_w *
                ((algebraMap (Polynomial k) (RatFunc k) g_w)⁻¹ *
                  algebraMap (Polynomial k) (RatFunc k) f_w)) *
              algebraMap (Polynomial k) (RatFunc k) g₀ := by ring
        _ = algebraMap (Polynomial k) (RatFunc k) f_w *
              algebraMap (Polynomial k) (RatFunc k) g₀ := by
              rw [hXπ_pow, one_mul, mul_inv_cancel_left₀ hgwK]
    have hr₀_poly : Polynomial.X ^ (n₀ + 1) * r₀ * g_w = f_w * g₀ := hPoly_inj hr₀_K
    have hr₀_zero : r₀ = 0 := by
      by_contra hr₀_ne
      have hXn_ne : (Polynomial.X ^ (n₀ + 1) : Polynomial k) ≠ 0 :=
        pow_ne_zero (n₀ + 1) Polynomial.X_ne_zero
      have hlhs_ne : Polynomial.X ^ (n₀ + 1) * r₀ * g_w ≠ 0 :=
        mul_ne_zero (mul_ne_zero hXn_ne hr₀_ne) hgw_ne
      have hfw_ne : f_w ≠ 0 := left_ne_zero_of_mul (hr₀_poly ▸ hlhs_ne)
      have hdeg := congrArg Polynomial.natDegree hr₀_poly
      rw [Polynomial.natDegree_mul (mul_ne_zero hXn_ne hr₀_ne) hgw_ne,
        Polynomial.natDegree_mul hXn_ne hr₀_ne, Polynomial.natDegree_X_pow,
        Polynomial.natDegree_mul hfw_ne hg₀_ne] at hdeg
      change (n₀ + 1) + r₀.natDegree + g_w.natDegree = f_w.natDegree + n₀ at hdeg
      omega
    refine ⟨q, ?_⟩
    rw [hnum_den, sub_eq_zero.mp hr₀_zero, map_mul, mul_div_cancel_right₀ _ hg₀K]

  have hCritB : ∀ h : RatFunc k, (∀ n : ℕ, c_res (π_K ^ (n + 1) * h) = 0) →
      ∃ w ∈ R_deg, h = π_K * w := by
    intro h hvan
    obtain ⟨q, w, hw, h_eq⟩ := hSplit0 h
    have hq_coeff : ∀ n : ℕ, q.coeff n = 0 := by
      intro n
      by_cases hn : n ≤ q.natDegree
      · have hvn := hvan n
        rw [h_eq, mul_add, map_add] at hvn
        have hrem : c_res (π_K ^ (n + 1) * (π_K * w)) = 0 := by
          have hmul : π_K ^ (n + 1) * (π_K * w) = π_K ^ 2 * (π_K ^ n * w) := by ring
          rw [hmul, hc_rem (hπ_pow_Rdeg n hw)]
        rw [hrem, add_zero] at hvn
        conv_lhs at hvn =>
          rw [Polynomial.as_sum_range' q (q.natDegree + 1) (Nat.lt_succ_self _), map_sum,
            Finset.mul_sum, map_sum]
        rw [Finset.sum_eq_single n] at hvn
        · rw [hae_X, Polynomial.aeval_monomial] at hvn
          have hsc : π_K ^ (n + 1) * (algebraMap k (RatFunc k) (q.coeff n) * X_K ^ n) =
              q.coeff n • (X_K ^ n * π_K ^ (n + 1)) := by
            rw [Algebra.smul_def]; ring
          rw [hsc, map_smul, hc_X_pow_pi_pow] at hvn
          simpa using hvn
        · intro m _ hmn
          rw [hae_X, Polynomial.aeval_monomial]
          have hsc : π_K ^ (n + 1) * (algebraMap k (RatFunc k) (q.coeff m) * X_K ^ m) =
              q.coeff m • (X_K ^ m * π_K ^ (n + 1)) := by
            rw [Algebra.smul_def]; ring
          rw [hsc, map_smul, hc_X_pow_pi_pow]
          simp [hmn]
        · intro hnot
          exfalso
          exact hnot (Finset.mem_range.mpr (Nat.lt_succ_of_le hn))
      · exact Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
    have hq0 : q = 0 := by
      ext n
      rw [hq_coeff n, Polynomial.coeff_zero]
    rw [hq0, map_zero, zero_add] at h_eq
    exact ⟨w, hw, h_eq⟩

  
  have hSubmonoidDual : ∀ (A : Type u) [CommRing A] [IsDedekindDomain A]
      [Algebra A (RatFunc k)] [IsFractionRing A (RatFunc k)]
      [Algebra A E] [IsScalarTower A (RatFunc k) E]
      (S : Submonoid A),
      (0 : A) ∉ S →
      (∀ (P : Ideal ↥(integralClosure A E)) [P.IsPrime],
        P ≠ ⊥ →
        Disjoint (S : Set A) (Ideal.comap (algebraMap A ↥(integralClosure A E)) P : Set A) →
        Algebra.IsUnramifiedAt A P) →
      ∀ z : E,
        (∃ s ∈ S, ∃ u : ↥(integralClosure A E), z = (algebraMap A E s)⁻¹ * (u : E)) ↔
        (∀ v : ↥(integralClosure A E),
          ∃ s' ∈ S, ∃ a : A,
            Algebra.trace (RatFunc k) E (z * (v : E)) =
              (algebraMap A (RatFunc k) s')⁻¹ * algebraMap A (RatFunc k) a) := by
    intro A _ _ _ _ _ _ S h0_not_S hUnram z
    have hAE_inj : Function.Injective (algebraMap A E) := by
      rw [IsScalarTower.algebraMap_eq A (RatFunc k) E]
      exact hKE_inj.comp (IsFractionRing.injective A (RatFunc k))
    have hAB_inj : Function.Injective (algebraMap A ↥(integralClosure A E)) :=
      fun _ _ hxy => hAE_inj (congrArg Subtype.val hxy)
    have : Module.IsTorsionFree A ↥(integralClosure A E) :=
      Module.isTorsionFree_iff_algebraMap_injective.mpr hAB_inj
    have : Algebra.IsAlgebraic (RatFunc k) E := Algebra.IsAlgebraic.of_finite (RatFunc k) E
    have : Algebra.IsAlgebraic A (RatFunc k) :=
      IsLocalization.isAlgebraic (RatFunc k) (nonZeroDivisors A)
    have : Algebra.IsAlgebraic A E := Algebra.IsAlgebraic.trans A (RatFunc k) E
    have : IsFractionRing ↥(integralClosure A E) E :=
      integralClosure.isFractionRing_of_algebraic fun _ hx =>
        hAE_inj (hx.trans (map_zero _).symm)
    have : IsDedekindDomain ↥(integralClosure A E) :=
      IsIntegralClosure.isDedekindDomain A (RatFunc k) E ↥(integralClosure A E)
    have : Module.Finite A ↥(integralClosure A E) :=
      IsIntegralClosure.finite A (RatFunc k) E ↥(integralClosure A E)
    let _ : Algebra (FractionRing A) (FractionRing ↥(integralClosure A E)) :=
      FractionRing.liftAlgebra A (FractionRing ↥(integralClosure A E))
    have : Algebra.IsSeparable (FractionRing A) (FractionRing ↥(integralClosure A E)) := by
      let eA : FractionRing A ≃ₐ[A] RatFunc k := FractionRing.algEquiv A (RatFunc k)
      let eB : FractionRing ↥(integralClosure A E) ≃ₐ[↥(integralClosure A E)] E :=
        FractionRing.algEquiv ↥(integralClosure A E) E
      have hcomm :
          (algebraMap (FractionRing A) (FractionRing ↥(integralClosure A E))).comp
              eA.symm.toRingHom =
            eB.symm.toRingHom.comp (algebraMap (RatFunc k) E) := by
        apply IsLocalization.ringHom_ext (nonZeroDivisors A)
        ext a
        change algebraMap (FractionRing A) (FractionRing ↥(integralClosure A E))
            (eA.symm (algebraMap A (RatFunc k) a)) =
          eB.symm (algebraMap (RatFunc k) E (algebraMap A (RatFunc k) a))
        rw [eA.symm.commutes a,
          ← IsScalarTower.algebraMap_apply A (FractionRing A)
            (FractionRing ↥(integralClosure A E)),
          ← IsScalarTower.algebraMap_apply A (RatFunc k) E,
          IsScalarTower.algebraMap_apply A ↥(integralClosure A E) E,
          eB.symm.commutes (algebraMap A ↥(integralClosure A E) a),
          ← IsScalarTower.algebraMap_apply A ↥(integralClosure A E)
            (FractionRing ↥(integralClosure A E))]
      exact Algebra.IsSeparable.of_equiv_equiv eA.symm.toRingEquiv eB.symm.toRingEquiv hcomm
    let D_dual :=
      FractionalIdeal.dual A (RatFunc k)
        (1 : FractionalIdeal (nonZeroDivisors ↥(integralClosure A E)) E)
    have h1_ne : (1 : FractionalIdeal (nonZeroDivisors ↥(integralClosure A E)) E) ≠ 0 :=
      one_ne_zero
    have hD_ne : D_dual ≠ 0 :=
      mt (FractionalIdeal.dual_eq_zero_iff (A := A) (K := RatFunc k)).mp h1_ne
    have hDiff_coe :
        (↑(differentIdeal A ↥(integralClosure A E)) :
            FractionalIdeal (nonZeroDivisors ↥(integralClosure A E)) E) = D_dual⁻¹ :=
      coeIdeal_differentIdeal A (RatFunc k) E ↥(integralClosure A E)
    have hDiff_ne : differentIdeal A ↥(integralClosure A E) ≠ ⊥ := by
      intro hbot
      apply inv_ne_zero hD_ne
      rw [← hDiff_coe]
      exact (FractionalIdeal.coeIdeal_eq_zero).mpr hbot
    let Z : Multiset (Ideal ↥(integralClosure A E)) :=
      UniqueFactorizationMonoid.factors (differentIdeal A ↥(integralClosure A E))
    have hZ_prod : Z.prod = differentIdeal A ↥(integralClosure A E) := by
      rcases UniqueFactorizationMonoid.factors_prod hDiff_ne with ⟨u, hu⟩
      rw [← hu, Ideal.isUnit_iff.mp u.isUnit, ← Ideal.one_eq_top, mul_one]
    have hZ_mem : ∀ P ∈ Z, ∃ s ∈ S, algebraMap A ↥(integralClosure A E) s ∈ P := by
      intro P hPZ
      have hP_irr : Irreducible P := UniqueFactorizationMonoid.irreducible_of_factor P hPZ
      have hP_prime : Prime P := UniqueFactorizationMonoid.irreducible_iff_prime.mp hP_irr
      have : P.IsPrime := Ideal.isPrime_of_prime hP_prime
      have hP_ne : P ≠ ⊥ := hP_prime.ne_zero
      have hP_dvd : P ∣ differentIdeal A ↥(integralClosure A E) :=
        UniqueFactorizationMonoid.dvd_of_mem_factors hPZ
      have hP_ram : ¬ Algebra.IsUnramifiedAt A P :=
        fun hunr => (not_dvd_differentIdeal_iff (A := A) (P := P)).mpr hunr hP_dvd
      have hNotDisj :
          ¬ Disjoint (S : Set A)
            (Ideal.comap (algebraMap A ↥(integralClosure A E)) P : Set A) :=
        fun hdisj => hP_ram (hUnram P hP_ne hdisj)
      rcases Set.not_disjoint_iff.mp hNotDisj with ⟨s, hsS, hsP⟩
      exact ⟨s, hsS, hsP⟩
    have hMultisetProd : ∀ M : Multiset (Ideal ↥(integralClosure A E)),
        (∀ P ∈ M, ∃ s ∈ S, algebraMap A ↥(integralClosure A E) s ∈ P) →
        ∃ s₀ ∈ S, algebraMap A ↥(integralClosure A E) s₀ ∈ M.prod := by
      intro M
      induction M using Multiset.induction_on with
      | empty =>
        intro _
        exact ⟨1, S.one_mem, by simp⟩
      | cons P M' ih =>
        intro hM
        obtain ⟨s₁, hs₁, hmem₁⟩ := hM P (Multiset.mem_cons_self P M')
        obtain ⟨s₂, hs₂, hmem₂⟩ := ih (fun Q hQ => hM Q (Multiset.mem_cons_of_mem hQ))
        refine ⟨s₁ * s₂, S.mul_mem hs₁ hs₂, ?_⟩
        rw [Multiset.prod_cons, map_mul]
        exact Ideal.mul_mem_mul hmem₁ hmem₂
    obtain ⟨s₀, hs₀_S, hs₀_diff⟩ := hMultisetProd Z hZ_mem
    rw [hZ_prod] at hs₀_diff
    have hs_ne_AK : ∀ {s : A}, s ∈ S → algebraMap A (RatFunc k) s ≠ 0 := by
      intro s hs h0
      apply h0_not_S
      have hs0 : s = 0 := IsFractionRing.injective A (RatFunc k) (h0.trans (map_zero _).symm)
      exact hs0 ▸ hs
    have hs_ne_AE : ∀ {s : A}, s ∈ S → algebraMap A E s ≠ 0 := by
      intro s hs h0
      rw [IsScalarTower.algebraMap_apply A (RatFunc k) E] at h0
      exact hs_ne_AK hs (hKE_inj (h0.trans (map_zero _).symm))
    constructor
    · rintro ⟨s, hsS, u, rfl⟩ v
      have hmul_smul : (algebraMap A E s)⁻¹ * (u : E) * (v : E) =
          (algebraMap A (RatFunc k) s)⁻¹ • ((u * v : ↥(integralClosure A E)) : E) := by
        rw [Algebra.smul_def, map_inv₀, ← IsScalarTower.algebraMap_apply A (RatFunc k) E,
          Subalgebra.coe_mul, mul_assoc]
      have htr_int :
          IsIntegral A (Algebra.trace (RatFunc k) E ((u * v : ↥(integralClosure A E)) : E)) :=
        Algebra.isIntegral_trace (u * v).2
      obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp htr_int
      refine ⟨s, hsS, a, ?_⟩
      rw [hmul_smul, map_smul, smul_eq_mul, ha]
    · intro htr
      obtain ⟨G, hG_span⟩ := Module.Finite.fg_top (R := A) (M := ↥(integralClosure A E))
      let f_s : ↥(integralClosure A E) → A := fun b => Classical.choose (htr b)
      have hf_s_mem : ∀ b : ↥(integralClosure A E), f_s b ∈ S :=
        fun b => (Classical.choose_spec (htr b)).1
      let f_a : ↥(integralClosure A E) → A :=
        fun b => Classical.choose (Classical.choose_spec (htr b)).2
      have hf_eq : ∀ b : ↥(integralClosure A E),
          Algebra.trace (RatFunc k) E (z * (b : E)) =
            (algebraMap A (RatFunc k) (f_s b))⁻¹ * algebraMap A (RatFunc k) (f_a b) :=
        fun b => Classical.choose_spec (Classical.choose_spec (htr b)).2
      let s₁ : A := ∏ g ∈ G, f_s g
      have hs₁_S : s₁ ∈ S := S.prod_mem (fun g _ => hf_s_mem g)
      have hspan_mem : ∀ v ∈ (⊤ : Submodule A ↥(integralClosure A E)),
          Algebra.trace (RatFunc k) E ((algebraMap A E s₁ * z) * (v : E)) ∈
            (algebraMap A (RatFunc k)).range := by
        rw [← hG_span]
        intro v hv
        induction hv using Submodule.span_induction with
        | mem g hg =>
          have hs₁_split : s₁ = f_s g * ∏ h ∈ G.erase g, f_s h :=
            (Finset.mul_prod_erase G f_s hg).symm
          have hsmul_eq : (algebraMap A E s₁ * z) * (g : E) =
              algebraMap A (RatFunc k) s₁ • (z * (g : E)) := by
            rw [Algebra.smul_def, ← IsScalarTower.algebraMap_apply A (RatFunc k) E, mul_assoc]
          rw [hsmul_eq, map_smul, smul_eq_mul, hf_eq g, hs₁_split, map_mul]
          have hfs_ne := hs_ne_AK (hf_s_mem g)
          refine ⟨f_a g * ∏ h ∈ G.erase g, f_s h, ?_⟩
          rw [map_mul]
          field_simp [hfs_ne]
        | zero =>
          simp only [ZeroMemClass.coe_zero, mul_zero, map_zero]
          exact ⟨0, map_zero _⟩
        | add x y _ _ ihx ihy =>
          rw [Subalgebra.coe_add, mul_add, map_add]
          exact (algebraMap A (RatFunc k)).range.add_mem ihx ihy
        | smul a x _ ihx =>
          have hcoe_smul :
              ((a • x : ↥(integralClosure A E)) : E) =
                algebraMap A (RatFunc k) a • (x : E) := by
            change a • (x : E) = _
            rw [Algebra.smul_def, Algebra.smul_def,
              IsScalarTower.algebraMap_apply A (RatFunc k) E]
          rw [hcoe_smul, mul_smul_comm, map_smul, smul_eq_mul]
          rcases ihx with ⟨b, hb⟩
          exact ⟨a * b, by rw [map_mul, hb]⟩
      have hs₁z_dual : algebraMap A E s₁ * z ∈ D_dual := by
        rw [FractionalIdeal.mem_dual h1_ne]
        intro x hx
        rw [FractionalIdeal.mem_one_iff] at hx
        rcases hx with ⟨v, rfl⟩
        exact hspan_mem v Submodule.mem_top
      have hs₀_mem_inv : algebraMap A E s₀ ∈ D_dual⁻¹ := by
        rw [← hDiff_coe, IsScalarTower.algebraMap_apply A ↥(integralClosure A E) E]
        exact (FractionalIdeal.mem_coeIdeal (nonZeroDivisors ↥(integralClosure A E))).mpr
          ⟨algebraMap A ↥(integralClosure A E) s₀, hs₀_diff, rfl⟩
      have hprod_one : algebraMap A E (s₀ * s₁) * z ∈
          (1 : FractionalIdeal (nonZeroDivisors ↥(integralClosure A E)) E) := by
        have hmul_mem := FractionalIdeal.mul_mem_mul hs₀_mem_inv hs₁z_dual
        rw [inv_mul_cancel₀ hD_ne] at hmul_mem
        simpa only [map_mul, mul_assoc] using hmul_mem
      rw [FractionalIdeal.mem_one_iff] at hprod_one
      rcases hprod_one with ⟨u, hu⟩
      have hs₀₁_S : s₀ * s₁ ∈ S := S.mul_mem hs₀_S hs₁_S
      refine ⟨s₀ * s₁, hs₀₁_S, u, ?_⟩
      have hu_coe : (u : E) = algebraMap A E (s₀ * s₁) * z := hu
      rw [hu_coe, inv_mul_cancel_left₀ (hs_ne_AE hs₀₁_S)]

  have hDual_0 : ∀ z : E, z ∈ E₀ ↔
      ∀ v : ↥E₀, Algebra.trace (RatFunc k) E (z * (v : E)) ∈
        Set.range (algebraMap (Polynomial k) (RatFunc k)) := by
    intro z
    have h0_bot : (0 : Polynomial k) ∉ (⊥ : Submonoid (Polynomial k)) := by
      rw [Submonoid.mem_bot]
      exact zero_ne_one
    have hiff := hSubmonoidDual (Polynomial k) ⊥ h0_bot
      (fun P _ hP_ne _ => hUnram_aff P hP_ne) z
    constructor
    · intro hz v
      obtain ⟨s', hs', a, htr⟩ := hiff.mp ⟨1, Submonoid.one_mem ⊥, ⟨z, hz⟩, by simp⟩ v
      rw [Submonoid.mem_bot.mp hs', map_one, inv_one, one_mul] at htr
      exact ⟨a, htr.symm⟩
    · intro htr
      obtain ⟨s, hs, u, hz⟩ := hiff.mpr fun v => by
        rcases htr v with ⟨a, ha⟩
        exact ⟨1, Submonoid.one_mem ⊥, a, by rw [← ha, map_one, inv_one, one_mul]⟩
      rw [Submonoid.mem_bot.mp hs, map_one, inv_one, one_mul] at hz
      rw [hz]
      exact u.2

  let E_tilde : Set E :=
    { y : E | ∃ s : A_inf_k, s ∉ m_T ∧ ∃ u : ↥E_inf, y = (algebraMap A_inf_k E s)⁻¹ * (u : E) }
  have hDual_inf : ∀ z : E, z ∈ E_tilde ↔
      ∀ v : ↥E_inf, Algebra.trace (RatFunc k) E (z * (v : E)) ∈ R_set := by
    intro z
    have h0_compl : (0 : A_inf_k) ∉ m_T.primeCompl := fun h0 => h0 m_T.zero_mem
    have hUnram_compl : ∀ (P_inf : Ideal ↥E_inf) [P_inf.IsPrime],
        P_inf ≠ ⊥ →
        Disjoint (m_T.primeCompl : Set A_inf_k)
          (Ideal.comap (algebraMap A_inf_k ↥E_inf) P_inf : Set A_inf_k) →
        Algebra.IsUnramifiedAt A_inf_k P_inf := by
      intro P_inf _ hP_ne hDisj
      let q : Ideal A_inf_k := Ideal.comap (algebraMap A_inf_k ↥E_inf) P_inf
      have hq_le : q ≤ m_T := by
        intro x hx
        by_contra hx_not
        exact Set.disjoint_left.mp hDisj hx_not hx
      have hq_ne : q ≠ ⊥ := Ideal.IsIntegral.under_ne_bot A_inf_k hP_ne
      have hq_max : q.IsMaximal := Ring.DimensionLEOne.maximalOfPrime hq_ne inferInstance
      exact hUnram_inf P_inf (hq_max.eq_of_le hm_max.ne_top hq_le)
    have hiff := hSubmonoidDual A_inf_k m_T.primeCompl h0_compl hUnram_compl z
    refine hiff.trans ⟨fun h v => ?_, fun h v => ?_⟩
    · obtain ⟨s', hs', a, htr⟩ := h v
      exact ⟨a, s', hs', htr⟩
    · obtain ⟨a, s', hs', htr⟩ := h v
      exact ⟨s', hs', a, htr⟩

  
  have h0_Etilde : (0 : E) ∈ E_tilde := ⟨1, h1_not_mT, 0, by simp⟩
  have hR_to_Etilde : ∀ {x : RatFunc k}, x ∈ R_set → algebraMap (RatFunc k) E x ∈ E_tilde := by
    rintro _ ⟨a, s, hs, rfl⟩
    refine ⟨s, hs, algebraMap A_inf_k ↥E_inf a, ?_⟩
    rw [map_mul, map_inv₀, ← IsScalarTower.algebraMap_apply A_inf_k (RatFunc k) E,
      ← IsScalarTower.algebraMap_apply A_inf_k (RatFunc k) E]
    rfl
  have hπ_Rset : π_K ∈ R_set :=
    ⟨t_K, 1, h1_not_mT, by rw [map_one, inv_one, one_mul, ht_K]⟩
  have hπ_Etilde : algebraMap (RatFunc k) E π_K ∈ E_tilde := hR_to_Etilde hπ_Rset
  have hmul_Etilde : ∀ {y₁ y₂ : E}, y₁ ∈ E_tilde → y₂ ∈ E_tilde → y₁ * y₂ ∈ E_tilde := by
    rintro _ _ ⟨s₁, hs₁, u₁, rfl⟩ ⟨s₂, hs₂, u₂, rfl⟩
    refine ⟨s₁ * s₂, fun hmem => (hm_max.isPrime.mem_or_mem hmem).elim hs₁ hs₂, u₁ * u₂, ?_⟩
    rw [map_mul, Subalgebra.coe_mul, mul_inv_rev]
    ring
  have hπ_pow_Etilde : ∀ (m : ℕ) {y : E}, y ∈ E_tilde →
      algebraMap (RatFunc k) E (π_K ^ m) * y ∈ E_tilde := by
    intro m
    induction m with
    | zero =>
      intro y hy
      simpa using hy
    | succ m ih =>
      intro y hy
      rw [pow_succ', map_mul, mul_assoc]
      exact hmul_Etilde hπ_Etilde (ih hy)
  have hadd_Etilde : ∀ {y₁ y₂ : E}, y₁ ∈ E_tilde → y₂ ∈ E_tilde → y₁ + y₂ ∈ E_tilde := by
    rintro _ _ ⟨s₁, hs₁, u₁, rfl⟩ ⟨s₂, hs₂, u₂, rfl⟩
    refine ⟨s₁ * s₂, fun hmem => (hm_max.isPrime.mem_or_mem hmem).elim hs₁ hs₂,
      s₂ • u₁ + s₁ • u₂, ?_⟩
    have hs₁E := hs_ne_E s₁ hs₁
    have hs₂E := hs_ne_E s₂ hs₂
    have hcoe : ((s₂ • u₁ + s₁ • u₂ : ↥E_inf) : E) =
        algebraMap A_inf_k E s₂ * (u₁ : E) + algebraMap A_inf_k E s₁ * (u₂ : E) := by
      rw [Subalgebra.coe_add]
      change s₂ • (u₁ : E) + s₁ • (u₂ : E) = _
      rw [Algebra.smul_def, Algebra.smul_def]
    rw [map_mul, hcoe]
    field_simp [hs₁E, hs₂E]
  have hsmul_k_Etilde : ∀ (c : k) {y : E}, y ∈ E_tilde → c • y ∈ E_tilde := by
    rintro c _ ⟨s, hs, u, rfl⟩
    refine ⟨s, hs, (algebraMap k A_inf_k c) • u, ?_⟩
    have hcoe : (((algebraMap k A_inf_k c) • u : ↥E_inf) : E) = algebraMap k E c * (u : E) := by
      change (algebraMap k A_inf_k c) • (u : E) = _
      rw [Algebra.smul_def, IsScalarTower.algebraMap_apply k A_inf_k E]
    rw [hcoe, Algebra.smul_def]
    ring
  have hsub_Etilde : ∀ {y₁ y₂ : E}, y₁ ∈ E_tilde → y₂ ∈ E_tilde → y₁ - y₂ ∈ E_tilde := by
    intro y₁ y₂ hy₁ hy₂
    rw [sub_eq_add_neg]
    have hneg : -y₂ ∈ E_tilde := by
      simpa only [neg_one_smul] using hsmul_k_Etilde (-1 : k) hy₂
    exact hadd_Etilde hy₁ hneg

  have hCap_k : ∀ {y : E}, y ∈ E₀ → y ∈ E_tilde → y ∈ Set.range (algebraMap k E) := by
    intro y hy₀ ⟨s, hs, u, hy_eq⟩
    have hy₀_int : IsIntegral (Polynomial k) y := hy₀
    have hu_int : IsIntegral A_inf_k (u : E) := u.2
    let s_K : RatFunc k := algebraMap A_inf_k (RatFunc k) s
    have hs_K : s_K ≠ 0 := hs_ne_K s hs
    have hu_smul : s_K • y = (u : E) := by
      rw [Algebra.smul_def, ← IsScalarTower.algebraMap_apply A_inf_k (RatFunc k) E, hy_eq,
        mul_inv_cancel_left₀ (hs_ne_E s hs)]
    have hmin_y : minpoly (RatFunc k) y =
        (minpoly (Polynomial k) y).map (algebraMap (Polynomial k) (RatFunc k)) :=
      minpoly.isIntegrallyClosed_eq_field_fractions' (RatFunc k) hy₀_int
    have hmin_u : minpoly (RatFunc k) (u : E) =
        (minpoly A_inf_k (u : E)).map (algebraMap A_inf_k (RatFunc k)) :=
      minpoly.isIntegrallyClosed_eq_field_fractions' (RatFunc k) hu_int
    have hy_intK : IsIntegral (RatFunc k) y := Algebra.IsIntegral.isIntegral y
    have hmin_smul : minpoly (RatFunc k) (s_K • y) = (minpoly (RatFunc k) y).scaleRoots s_K :=
      IsIntegrallyClosed.minpoly_smul hs_K hy_intK
    let P₀ := minpoly (Polynomial k) y
    let P_inf := minpoly A_inf_k (u : E)
    let m := (minpoly (RatFunc k) y).natDegree
    have hP₀_deg : P₀.natDegree = m := by
      dsimp only [m]
      rw [hmin_y, Polynomial.natDegree_map_eq_of_injective hPoly_inj]
    have hP₀_coeff : ∀ j : ℕ, P₀.coeff j ∈ Set.range Polynomial.C := by
      intro j
      by_cases hj : j ≤ m
      · have hscale_j : ((minpoly (RatFunc k) y).scaleRoots s_K).coeff j =
            (minpoly (RatFunc k) y).coeff j * s_K ^ (m - j) :=
          Polynomial.coeff_scaleRoots (minpoly (RatFunc k) y) s_K j
        have h_lhs : ((minpoly (RatFunc k) y).scaleRoots s_K).coeff j =
            algebraMap A_inf_k (RatFunc k) (P_inf.coeff j) := by
          rw [← hmin_smul, hu_smul, hmin_u, Polynomial.coeff_map]
        have h_rhs : ((minpoly (RatFunc k) y).scaleRoots s_K).coeff j =
            algebraMap (Polynomial k) (RatFunc k) (P₀.coeff j) *
              algebraMap A_inf_k (RatFunc k) (s ^ (m - j)) := by
          rw [hscale_j, hmin_y, Polynomial.coeff_map, map_pow]
        have hpow_not : s ^ (m - j) ∉ m_T :=
          fun hmem => hs (hm_max.isPrime.mem_of_pow_mem (m - j) hmem)
        have hpow_ne : algebraMap A_inf_k (RatFunc k) (s ^ (m - j)) ≠ 0 := hs_ne_K _ hpow_not
        have hmem_Rset : algebraMap (Polynomial k) (RatFunc k) (P₀.coeff j) ∈ R_set := by
          refine ⟨P_inf.coeff j, s ^ (m - j), hpow_not, ?_⟩
          have heq := h_lhs.symm.trans h_rhs
          field_simp [hpow_ne] at heq ⊢
          linear_combination heq.symm
        rw [hR_eq] at hmem_Rset
        exact hPolyCap (P₀.coeff j) hmem_Rset
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
        exact ⟨0, map_zero _⟩
    let Q : Polynomial k :=
      ∑ j ∈ Finset.range (m + 1), Polynomial.monomial j ((P₀.coeff j).coeff 0)
    have hQ_map : Q.map (algebraMap k (Polynomial k)) = P₀ := by
      apply Polynomial.ext
      intro j
      rw [Polynomial.coeff_map]
      rcases hP₀_coeff j with ⟨c, hc⟩
      have hc0 : (P₀.coeff j).coeff 0 = c := by rw [← hc, Polynomial.coeff_C_zero]
      by_cases hj : j ≤ m
      · have hQj : Q.coeff j = (P₀.coeff j).coeff 0 := by
          simp only [Q, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial]
          rw [Finset.sum_eq_single j]
          · simp
          · intro b _ hbj; simp [hbj]
          · intro hnot; exact absurd (Finset.mem_range.mpr (Nat.lt_succ_of_le hj)) hnot
        rw [hQj, hc0, Polynomial.algebraMap_eq, hc]
      · have hQj : Q.coeff j = 0 := by
          simp only [Q, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial]
          refine Finset.sum_eq_zero fun b hb => ?_
          have hbj : b ≠ j := by rw [Finset.mem_range] at hb; omega
          simp [hbj]
        rw [hQj, map_zero, Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
    have hQ_mon : Q.Monic :=
      Polynomial.monic_of_injective Polynomial.C_injective
        (by rw [← Polynomial.algebraMap_eq, hQ_map]; exact minpoly.monic hy₀_int)
    have hQ_eval : Polynomial.aeval y Q = 0 := by
      rw [← Polynomial.aeval_map_algebraMap (Polynomial k) y Q, hQ_map]
      exact minpoly.aeval (Polynomial k) y
    exact hk_closed y ⟨Q, hQ_mon, hQ_eval⟩

  have hDisj_zero : ∀ z : E, z ∈ E₀ → algebraMap (RatFunc k) E X_K * z ∈ E_tilde → z = 0 := by
    intro z hz₀ hXz
    have hz_tilde : z ∈ E_tilde := by
      have hz_eq : z = algebraMap (RatFunc k) E π_K * (algebraMap (RatFunc k) E X_K * z) := by
        rw [← mul_assoc, ← map_mul, hπX, map_one, one_mul]
      rw [hz_eq]
      exact hmul_Etilde hπ_Etilde hXz
    rcases hCap_k hz₀ hz_tilde with ⟨c, rfl⟩
    by_cases hc : c = 0
    · rw [hc, map_zero]
    · exfalso
      have hX_tilde : algebraMap (RatFunc k) E X_K ∈ E_tilde := by
        have hX_eq : algebraMap (RatFunc k) E X_K =
            c⁻¹ • (algebraMap (RatFunc k) E X_K * algebraMap k E c) := by
          rw [Algebra.smul_def]
          calc algebraMap (RatFunc k) E X_K
              = algebraMap k E (c⁻¹ * c) * algebraMap (RatFunc k) E X_K := by
                  rw [inv_mul_cancel₀ hc, map_one, one_mul]
            _ = algebraMap k E c⁻¹ * (algebraMap (RatFunc k) E X_K * algebraMap k E c) := by
                  rw [map_mul]; ring
        rw [hX_eq]
        exact hsmul_k_Etilde c⁻¹ hXz
      rcases hX_tilde with ⟨s, hs, u, hX_eq⟩
      have hu_eq :
          (IsScalarTower.toAlgHom A_inf_k (RatFunc k) E)
            (algebraMap A_inf_k (RatFunc k) s * X_K) = (u : E) := by
        rw [IsScalarTower.toAlgHom_apply, map_mul,
          ← IsScalarTower.algebraMap_apply A_inf_k (RatFunc k) E, hX_eq,
          mul_inv_cancel_left₀ (hs_ne_E s hs)]
      have hsX_int : IsIntegral A_inf_k (algebraMap A_inf_k (RatFunc k) s * X_K) := by
        refine (isIntegral_algHom_iff (IsScalarTower.toAlgHom A_inf_k (RatFunc k) E) hKE_inj).mp ?_
        rw [hu_eq]
        exact u.2
      obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hsX_int
      apply hX_not_Rset
      refine ⟨a, s, hs, ?_⟩
      have hsK := hs_ne_K s hs
      field_simp [hsK]
      linear_combination ha.symm

  
  let d := Module.finrank (RatFunc k) E
  let b₀ : Module.Basis (Fin d) (RatFunc k) E := Module.finBasis (RatFunc k) E
  have hClear0 : ∀ x : E, ∃ g : Polynomial k, g ≠ 0 ∧
      algebraMap (Polynomial k) E g * x ∈ E₀ := by
    intro x
    have : IsLocalization (Algebra.algebraMapSubmonoid ↥E₀ (nonZeroDivisors (Polynomial k))) E :=
      IsIntegralClosure.isLocalization (Polynomial k) (RatFunc k) E ↥E₀
    obtain ⟨⟨y, s⟩, hys⟩ := IsLocalization.surj
      (Algebra.algebraMapSubmonoid ↥E₀ (nonZeroDivisors (Polynomial k))) x
    rcases s.2 with ⟨g, hg_nzd, hg_eq⟩
    have hg_ne : g ≠ 0 := nonZeroDivisors.ne_zero hg_nzd
    refine ⟨g, hg_ne, ?_⟩
    have hmul : algebraMap (Polynomial k) E g * x = (y : E) := by
      have h1 : (s.1 : E) = algebraMap (Polynomial k) E g := by
        rw [← hg_eq]
        rfl
      have hys_val : x * (s.1 : E) = (y : E) := hys
      rw [← hys_val, h1, mul_comm]
    rw [hmul]
    exact y.2
  have hClearInf : ∀ x : E, ∃ m : ℕ, algebraMap (RatFunc k) E (π_K ^ m) * x ∈ E_tilde := by
    intro x
    have : IsLocalization (Algebra.algebraMapSubmonoid ↥E_inf (nonZeroDivisors A_inf_k)) E :=
      IsIntegralClosure.isLocalization A_inf_k (RatFunc k) E ↥E_inf
    obtain ⟨⟨w, s⟩, hws⟩ := IsLocalization.surj
      (Algebra.algebraMapSubmonoid ↥E_inf (nonZeroDivisors A_inf_k)) x
    rcases s.2 with ⟨β, hβ_nzd, hβ_eq⟩
    have hβ_ne : β ≠ 0 := nonZeroDivisors.ne_zero hβ_nzd
    obtain ⟨m, s₀, hs₀, hβ_fac⟩ := hFactor β hβ_ne
    refine ⟨m, s₀, hs₀, w, ?_⟩
    have hws_val : (w : E) = algebraMap A_inf_k E β * x := by
      have h1 : (s.1 : E) = algebraMap A_inf_k E β := by
        rw [← hβ_eq]
        rfl
      have h2 : x * (s.1 : E) = (w : E) := hws
      rw [← h2, h1, mul_comm]
    have ht_E : algebraMap A_inf_k E t_K = algebraMap (RatFunc k) E π_K := by
      rw [IsScalarTower.algebraMap_apply A_inf_k (RatFunc k) E, ht_K]
    rw [hws_val, hβ_fac, map_mul, (algebraMap A_inf_k E).map_pow, ht_E,
      (algebraMap (RatFunc k) E).map_pow]
    have hs₀E := hs_ne_E s₀ hs₀
    field_simp [hs₀E]
  let g_vec : Fin d → Polynomial k := fun i => Classical.choose (hClear0 (b₀ i))
  have hg_vec_ne : ∀ i : Fin d, g_vec i ≠ 0 :=
    fun i => (Classical.choose_spec (hClear0 (b₀ i))).1
  let u_vec : Fin d → (RatFunc k)ˣ :=
    fun i => Units.mk0 (algebraMap (Polynomial k) (RatFunc k) (g_vec i)) (hPoly_ne (hg_vec_ne i))
  let b_E : Module.Basis (Fin d) (RatFunc k) E := b₀.unitsSMul u_vec
  have hb_E0 : ∀ i : Fin d, b_E i ∈ E₀ := by
    intro i
    dsimp only [b_E]
    rw [Module.Basis.unitsSMul_apply, Units.smul_def, Algebra.smul_def]
    change algebraMap (RatFunc k) E (algebraMap (Polynomial k) (RatFunc k) (g_vec i)) * b₀ i ∈ E₀
    rw [← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) E]
    exact (Classical.choose_spec (hClear0 (b₀ i))).2
  let m_vec : Fin d → ℕ := fun i => Classical.choose (hClearInf (b_E i))
  let M₀ : ℕ := Finset.univ.sup m_vec
  have hb_pole : ∀ i : Fin d, algebraMap (RatFunc k) E (π_K ^ M₀) * b_E i ∈ E_tilde := by
    intro i
    have hm_le : m_vec i ≤ M₀ := Finset.le_sup (Finset.mem_univ i)
    have hsplit : M₀ = (M₀ - m_vec i) + m_vec i := (Nat.sub_add_cancel hm_le).symm
    rw [hsplit, pow_add, map_mul, mul_assoc]
    exact hπ_pow_Etilde (M₀ - m_vec i) (Classical.choose_spec (hClearInf (b_E i)))

  
  let W_aff : Submodule k E := E₀.toSubmodule.restrictScalars k
  let W_inf : Submodule k E :=
    { carrier := { x : E | ∃ w ∈ E_tilde, x = algebraMap (RatFunc k) E π_K * w }
      zero_mem' := ⟨0, h0_Etilde, by simp⟩
      add_mem' := by
        rintro _ _ ⟨w₁, hw₁, rfl⟩ ⟨w₂, hw₂, rfl⟩
        exact ⟨w₁ + w₂, hadd_Etilde hw₁ hw₂, (mul_add _ _ _).symm⟩
      smul_mem' := by
        rintro c _ ⟨w, hw, rfl⟩
        refine ⟨c • w, hsmul_k_Etilde c hw, ?_⟩
        rw [Algebra.smul_def, Algebra.smul_def]
        ring }
  let W : Submodule k E := W_aff ⊔ W_inf
  have hW_top : ∀ y : E, y ∈ W := by
    intro y
    by_contra hy_not
    have hyQ_ne : W.mkQ y ≠ 0 := by
      intro h0
      exact hy_not ((Submodule.Quotient.mk_eq_zero W).mp h0)
    let b_Q := Module.Basis.ofVectorSpace k (E ⧸ W)
    have hrepr_ne : b_Q.repr (W.mkQ y) ≠ 0 :=
      fun h0 => hyQ_ne (b_Q.repr.injective (h0.trans (map_zero _).symm))
    have hex_idx : ∃ idx, b_Q.repr (W.mkQ y) idx ≠ 0 := by
      by_contra hall
      push Not at hall
      apply hrepr_ne
      ext idx
      exact hall idx
    obtain ⟨idx, hidx⟩ := hex_idx
    let ℓ : E →ₗ[k] k := (b_Q.coord idx).comp W.mkQ
    have hℓ_W : ∀ w ∈ W, ℓ w = 0 := by
      intro w hw
      have hw0 : W.mkQ w = 0 := (Submodule.mkQ_apply W w).trans
        ((Submodule.Quotient.mk_eq_zero W).mpr hw)
      change b_Q.coord idx (W.mkQ w) = 0
      rw [hw0, map_zero]
    have hℓ_y : ℓ y ≠ 0 := hidx
    let z_poly : Fin d → Polynomial k := fun i =>
      ∑ t ∈ Finset.range M₀,
        Polynomial.C (ℓ (algebraMap (RatFunc k) E (π_K ^ (t + 1)) * b_E i)) * Polynomial.X ^ t
    let z : E := ∑ i : Fin d, algebraMap (Polynomial k) E (z_poly i) * b_E.traceDual i
    have hPair_basis : ∀ (i : Fin d) (h : RatFunc k),
        c_res (algebraMap (Polynomial k) (RatFunc k) (z_poly i) * h) =
          ℓ (algebraMap (RatFunc k) E h * b_E i) := by
      intro i h
      obtain ⟨q, β, w_h, hw_h, hh_eq⟩ := hTrunc M₀ h
      rw [hh_eq, mul_add, mul_add, map_add c_res, map_add c_res,
        (algebraMap (RatFunc k) E).map_add, (algebraMap (RatFunc k) E).map_add,
        add_mul, add_mul, map_add ℓ, map_add ℓ]
      have hPieceA_lhs :
          c_res (algebraMap (Polynomial k) (RatFunc k) (z_poly i) *
              algebraMap (Polynomial k) (RatFunc k) q) = 0 := by
        rw [← map_mul, hc_poly]
      have hPieceA_rhs :
          ℓ (algebraMap (RatFunc k) E (algebraMap (Polynomial k) (RatFunc k) q) * b_E i) = 0 := by
        rw [← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) E]
        apply hℓ_W
        exact Submodule.mem_sup_left (E₀.mul_mem (E₀.algebraMap_mem q) (hb_E0 i))
      have hPieceB_lhs :
          c_res (algebraMap (Polynomial k) (RatFunc k) (z_poly i) * (π_K ^ (M₀ + 1) * w_h)) = 0 := by
        dsimp only [z_poly]
        rw [map_sum (algebraMap (Polynomial k) (RatFunc k)), Finset.sum_mul, map_sum c_res]
        refine Finset.sum_eq_zero fun t ht => ?_
        have ht_lt : t < M₀ := Finset.mem_range.mp ht
        set c_t := ℓ (algebraMap (RatFunc k) E (π_K ^ (t + 1)) * b_E i)
        have hterm_map :
            algebraMap (Polynomial k) (RatFunc k) (Polynomial.C c_t * Polynomial.X ^ t) =
              algebraMap k (RatFunc k) c_t * X_K ^ t := by
          rw [map_mul, map_pow, hX_alg, ← Polynomial.algebraMap_eq,
            ← IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k)]
        rw [hterm_map]
        have hM_eq : M₀ + 1 = t + 2 + (M₀ - 1 - t) := by omega
        have hpow_simp : X_K ^ t * (π_K ^ (M₀ + 1) * w_h) =
            π_K ^ 2 * (π_K ^ (M₀ - 1 - t) * w_h) := by
          rw [hM_eq, pow_add, pow_add]
          calc X_K ^ t * (π_K ^ t * π_K ^ 2 * π_K ^ (M₀ - 1 - t) * w_h)
              = (X_K ^ t * π_K ^ t) * (π_K ^ 2 * (π_K ^ (M₀ - 1 - t) * w_h)) := by ring
            _ = (X_K * π_K) ^ t * (π_K ^ 2 * (π_K ^ (M₀ - 1 - t) * w_h)) := by rw [← mul_pow]
            _ = π_K ^ 2 * (π_K ^ (M₀ - 1 - t) * w_h) := by rw [hXπ, one_pow, one_mul]
        have hsc : algebraMap k (RatFunc k) c_t * X_K ^ t * (π_K ^ (M₀ + 1) * w_h) =
            c_t • (X_K ^ t * (π_K ^ (M₀ + 1) * w_h)) := by
          rw [Algebra.smul_def]; ring
        rw [hsc, map_smul, hpow_simp, hc_rem (hπ_pow_Rdeg _ hw_h), smul_zero]
      have hPieceB_rhs : ℓ (algebraMap (RatFunc k) E (π_K ^ (M₀ + 1) * w_h) * b_E i) = 0 := by
        apply hℓ_W
        apply Submodule.mem_sup_right
        have hwh_Rset : w_h ∈ R_set := hR_eq.symm ▸ hw_h
        refine ⟨algebraMap (RatFunc k) E w_h * (algebraMap (RatFunc k) E (π_K ^ M₀) * b_E i),
          hmul_Etilde (hR_to_Etilde hwh_Rset) (hb_pole i), ?_⟩
        rw [pow_succ', map_mul, map_mul]
        ring
      have hPieceC :
          c_res (algebraMap (Polynomial k) (RatFunc k) (z_poly i) *
              ∑ j : Fin M₀, algebraMap k (RatFunc k) (β j) * π_K ^ ((j : ℕ) + 1)) =
            ℓ (algebraMap (RatFunc k) E
                (∑ j : Fin M₀, algebraMap k (RatFunc k) (β j) * π_K ^ ((j : ℕ) + 1)) * b_E i) := by
        rw [Finset.mul_sum, map_sum c_res, map_sum (algebraMap (RatFunc k) E),
          Finset.sum_mul, map_sum ℓ]
        refine Finset.sum_congr rfl fun j _ => ?_
        have hsc_lhs : algebraMap (Polynomial k) (RatFunc k) (z_poly i) *
              (algebraMap k (RatFunc k) (β j) * π_K ^ ((j : ℕ) + 1)) =
            β j • (algebraMap (Polynomial k) (RatFunc k) (z_poly i) * π_K ^ ((j : ℕ) + 1)) := by
          rw [Algebra.smul_def]; ring
        have hsc_rhs : algebraMap (RatFunc k) E
              (algebraMap k (RatFunc k) (β j) * π_K ^ ((j : ℕ) + 1)) * b_E i =
            β j • (algebraMap (RatFunc k) E (π_K ^ ((j : ℕ) + 1)) * b_E i) := by
          rw [map_mul, ← IsScalarTower.algebraMap_apply k (RatFunc k) E, Algebra.smul_def,
            mul_assoc]
        rw [hsc_lhs, hsc_rhs, map_smul, map_smul]
        congr 1
        dsimp only [z_poly]
        rw [map_sum (algebraMap (Polynomial k) (RatFunc k)), Finset.sum_mul, map_sum c_res,
          Finset.sum_eq_single (j : ℕ)]
        · set c_j := ℓ (algebraMap (RatFunc k) E (π_K ^ ((j : ℕ) + 1)) * b_E i)
          have hterm_map :
              algebraMap (Polynomial k) (RatFunc k)
                  (Polynomial.C c_j * Polynomial.X ^ (j : ℕ)) =
                algebraMap k (RatFunc k) c_j * X_K ^ (j : ℕ) := by
            rw [map_mul, map_pow, hX_alg, ← Polynomial.algebraMap_eq,
              ← IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k)]
          rw [hterm_map]
          have hsc : algebraMap k (RatFunc k) c_j * X_K ^ (j : ℕ) * π_K ^ ((j : ℕ) + 1) =
              c_j • (X_K ^ (j : ℕ) * π_K ^ ((j : ℕ) + 1)) := by
            rw [Algebra.smul_def]; ring
          rw [hsc, map_smul, hc_X_pow_pi_pow]
          simp
        · intro t _ htj
          set c_t := ℓ (algebraMap (RatFunc k) E (π_K ^ (t + 1)) * b_E i)
          have hterm_map :
              algebraMap (Polynomial k) (RatFunc k) (Polynomial.C c_t * Polynomial.X ^ t) =
                algebraMap k (RatFunc k) c_t * X_K ^ t := by
            rw [map_mul, map_pow, hX_alg, ← Polynomial.algebraMap_eq,
              ← IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k)]
          rw [hterm_map]
          have hsc : algebraMap k (RatFunc k) c_t * X_K ^ t * π_K ^ ((j : ℕ) + 1) =
              c_t • (X_K ^ t * π_K ^ ((j : ℕ) + 1)) := by
            rw [Algebra.smul_def]; ring
          rw [hsc, map_smul, hc_X_pow_pi_pow]
          simp [htj]
        · intro hnot
          exact absurd (Finset.mem_range.mpr j.2) hnot
      rw [hPieceA_lhs, hPieceA_rhs, hPieceB_lhs, hPieceB_rhs, hPieceC]
    have hPair_all : ∀ x : E, c_res (Algebra.trace (RatFunc k) E (z * x)) = ℓ x := by
      intro x
      conv_lhs => rw [← b_E.sum_repr x]
      conv_rhs => rw [← b_E.sum_repr x]
      have htr_eq : Algebra.trace (RatFunc k) E (z * ∑ j : Fin d, b_E.repr x j • b_E j) =
          ∑ i : Fin d, algebraMap (Polynomial k) (RatFunc k) (z_poly i) * b_E.repr x i := by
        dsimp [z]
        rw [Finset.mul_sum, map_sum]
        have hinner : ∀ j : Fin d,
            Algebra.trace (RatFunc k) E
              ((∑ i : Fin d, algebraMap (Polynomial k) E (z_poly i) * b_E.traceDual i) *
                (b_E.repr x j • b_E j)) =
              algebraMap (Polynomial k) (RatFunc k) (z_poly j) * b_E.repr x j := by
          intro j
          rw [Finset.sum_mul, map_sum, Finset.sum_eq_single j]
          · have hsm : (algebraMap (Polynomial k) E (z_poly j) * b_E.traceDual j) *
                (b_E.repr x j • b_E j) =
              (algebraMap (Polynomial k) (RatFunc k) (z_poly j) * b_E.repr x j) •
                (b_E j * b_E.traceDual j) := by
              rw [Algebra.smul_def, Algebra.smul_def, map_mul,
                ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) E]
              ring
            rw [hsm, map_smul, b_E.trace_mul_traceDual j j]
            simp
          · intro i _ hij
            have hsm : (algebraMap (Polynomial k) E (z_poly i) * b_E.traceDual i) *
                (b_E.repr x j • b_E j) =
              (algebraMap (Polynomial k) (RatFunc k) (z_poly i) * b_E.repr x j) •
                (b_E j * b_E.traceDual i) := by
              rw [Algebra.smul_def, Algebra.smul_def, map_mul,
                ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) E]
              ring
            rw [hsm, map_smul, b_E.trace_mul_traceDual j i]
            simp [hij.symm]
          · intro hnot; exact absurd (Finset.mem_univ j) hnot
        refine Finset.sum_congr rfl fun j _ => hinner j
      rw [htr_eq, map_sum, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [hPair_basis i (b_E.repr x i), Algebra.smul_def]
    have hz_E0 : z ∈ E₀ := by
      rw [hDual_0]
      intro v
      apply hCritA
      intro n
      have hsm : X_K ^ n * Algebra.trace (RatFunc k) E (z * (v : E)) =
          Algebra.trace (RatFunc k) E (z * (algebraMap (RatFunc k) E (X_K ^ n) * (v : E))) := by
        have h1 : z * (algebraMap (RatFunc k) E (X_K ^ n) * (v : E)) =
            (X_K ^ n) • (z * (v : E)) := by
          rw [Algebra.smul_def]; ring
        rw [h1, map_smul, smul_eq_mul]
      rw [hsm, hPair_all]
      apply hℓ_W
      apply Submodule.mem_sup_left
      have hXn : algebraMap (RatFunc k) E (X_K ^ n) =
          algebraMap (Polynomial k) E (Polynomial.X ^ n) := by
        rw [← hX_alg, ← map_pow, ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) E]
      rw [hXn]
      exact E₀.mul_mem (E₀.algebraMap_mem _) v.2
    have hXz_tilde : algebraMap (RatFunc k) E X_K * z ∈ E_tilde := by
      rw [hDual_inf]
      intro v
      have hvan_inf : ∀ n : ℕ,
          c_res (π_K ^ (n + 1) * Algebra.trace (RatFunc k) E (z * (v : E))) = 0 := by
        intro n
        have hsm : π_K ^ (n + 1) * Algebra.trace (RatFunc k) E (z * (v : E)) =
            Algebra.trace (RatFunc k) E
              (z * (algebraMap (RatFunc k) E (π_K ^ (n + 1)) * (v : E))) := by
          have h1 : z * (algebraMap (RatFunc k) E (π_K ^ (n + 1)) * (v : E)) =
              (π_K ^ (n + 1)) • (z * (v : E)) := by
            rw [Algebra.smul_def]; ring
          rw [h1, map_smul, smul_eq_mul]
        rw [hsm, hPair_all]
        apply hℓ_W
        apply Submodule.mem_sup_right
        have hv_tilde : (v : E) ∈ E_tilde := ⟨1, h1_not_mT, v, by simp⟩
        refine ⟨algebraMap (RatFunc k) E (π_K ^ n) * (v : E), hπ_pow_Etilde n hv_tilde, ?_⟩
        rw [pow_succ', map_mul, mul_assoc]
      obtain ⟨w_v, hw_v, htr_eq⟩ := hCritB _ hvan_inf
      have htr_X : Algebra.trace (RatFunc k) E ((algebraMap (RatFunc k) E X_K * z) * (v : E)) =
          w_v := by
        have hsm : (algebraMap (RatFunc k) E X_K * z) * (v : E) = X_K • (z * (v : E)) := by
          rw [Algebra.smul_def]; ring
        rw [hsm, map_smul, smul_eq_mul, htr_eq, ← mul_assoc, hXπ, one_mul]
      rw [htr_X, hR_eq]
      exact hw_v
    have hz0 : z = 0 := hDisj_zero z hz_E0 hXz_tilde
    have hℓ_y0 : ℓ y = 0 := by
      rw [← hPair_all y, hz0, zero_mul, map_zero, map_zero]
    exact hℓ_y hℓ_y0

  
  have hPeelE : ∀ {w : E}, w ∈ E_tilde →
      ∃ (c : k) (w' : E), w' ∈ E_tilde ∧
        w = algebraMap k E c + algebraMap (RatFunc k) E π_K * w' := by
    intro w hw
    have hw_W : w ∈ W := hW_top w
    rcases Submodule.mem_sup.mp hw_W with ⟨y₀, hy₀, y_inf, ⟨v, hv, rfl⟩, hy_sum⟩
    have hy₀_eq : y₀ = w - algebraMap (RatFunc k) E π_K * v := eq_sub_of_add_eq hy_sum
    have hy₀_tilde : y₀ ∈ E_tilde := by
      rw [hy₀_eq]
      exact hsub_Etilde hw (hmul_Etilde hπ_Etilde hv)
    rcases hCap_k hy₀ hy₀_tilde with ⟨c, hc⟩
    exact ⟨c, v, hv, by rw [← hy_sum, hc]⟩
  have hExpandE : ∀ (n : ℕ) {w : E}, w ∈ E_tilde →
      ∃ (f₀ : RatFunc k) (v : E), v ∈ E_tilde ∧
        w = algebraMap (RatFunc k) E f₀ + algebraMap (RatFunc k) E (π_K ^ n) * v := by
    intro n
    induction n with
    | zero =>
      intro w hw
      exact ⟨0, w, hw, by simp⟩
    | succ n ih =>
      intro w hw
      obtain ⟨f₀, v, hv, hw_eq⟩ := ih hw
      obtain ⟨c, v', hv', hv_eq⟩ := hPeelE hv
      refine ⟨f₀ + algebraMap k (RatFunc k) c * π_K ^ n, v', hv', ?_⟩
      rw [hw_eq, hv_eq, map_add, map_mul, ← IsScalarTower.algebraMap_apply k (RatFunc k) E,
        pow_succ, map_mul]
      ring
  have hSurjKE : Function.Surjective (algebraMap (RatFunc k) E) := by
    intro x
    obtain ⟨g, hg_ne, hg_E0⟩ := hClear0 x
    obtain ⟨m, hu_tilde⟩ := hClearInf x
    let u : E := algebraMap (RatFunc k) E (π_K ^ m) * x
    let H : Polynomial k := Polynomial.X ^ m * g
    let M : ℕ := H.natDegree
    let y₀ : E := algebraMap (Polynomial k) E g * x
    have hy₀_E0 : y₀ ∈ E₀ := hg_E0
    have hHu_eq : algebraMap (Polynomial k) E H * u = y₀ := by
      dsimp only [H, u, y₀]
      rw [IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) E,
        IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) E,
        map_mul, map_pow, hX_alg, map_mul]
      have hXπ_m : algebraMap (RatFunc k) E (X_K ^ m) * algebraMap (RatFunc k) E (π_K ^ m) = 1 := by
        rw [← map_mul, ← mul_pow, hXπ, one_pow, map_one]
      calc (algebraMap (RatFunc k) E (X_K ^ m) *
              algebraMap (RatFunc k) E (algebraMap (Polynomial k) (RatFunc k) g)) *
            (algebraMap (RatFunc k) E (π_K ^ m) * x)
          = (algebraMap (RatFunc k) E (X_K ^ m) * algebraMap (RatFunc k) E (π_K ^ m)) *
              (algebraMap (RatFunc k) E (algebraMap (Polynomial k) (RatFunc k) g) * x) := by ring
        _ = algebraMap (RatFunc k) E (algebraMap (Polynomial k) (RatFunc k) g) * x := by
              rw [hXπ_m, one_mul]
    obtain ⟨f₀, v, hv_tilde, hu_exp⟩ := hExpandE (M + 1) hu_tilde
    obtain ⟨Q, r₁, hr₁_deg, hHf₀_eq⟩ :=
      hSplit0 (algebraMap (Polynomial k) (RatFunc k) H * f₀)
    have hXM_ne : (Polynomial.X ^ M : Polynomial k) ≠ 0 := pow_ne_zero M Polynomial.X_ne_zero
    let r₂ : RatFunc k :=
      (algebraMap (Polynomial k) (RatFunc k) (Polynomial.X ^ M))⁻¹ *
        algebraMap (Polynomial k) (RatFunc k) H
    have hr₂_deg : r₂ ∈ R_deg := by
      refine ⟨H, Polynomial.X ^ M, hXM_ne, ?_, rfl⟩
      rw [Polynomial.natDegree_X_pow]
    have hH_pi_eq :
        algebraMap (Polynomial k) (RatFunc k) H * π_K ^ (M + 1) = π_K * r₂ := by
      dsimp only [r₂]
      rw [map_pow, hX_alg, pow_succ', ← inv_pow]
      ring
    let w_tot : E := algebraMap (RatFunc k) E r₁ + algebraMap (RatFunc k) E r₂ * v
    have hw_tot_tilde : w_tot ∈ E_tilde := by
      refine hadd_Etilde (hR_to_Etilde (hR_eq.symm ▸ hr₁_deg)) ?_
      exact hmul_Etilde (hR_to_Etilde (hR_eq.symm ▸ hr₂_deg)) hv_tilde
    have hy₀_sub_Q : y₀ - algebraMap (Polynomial k) E Q =
        algebraMap (RatFunc k) E π_K * w_tot := by
      have hHu_calc : y₀ = algebraMap (Polynomial k) E Q +
          algebraMap (RatFunc k) E π_K * w_tot := by
        rw [← hHu_eq]
        dsimp only [u]
        rw [hu_exp, mul_add]
        have h1 : algebraMap (Polynomial k) E H * algebraMap (RatFunc k) E f₀ =
            algebraMap (Polynomial k) E Q +
              algebraMap (RatFunc k) E π_K * algebraMap (RatFunc k) E r₁ := by
          rw [IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) E H, ← map_mul,
            hHf₀_eq, map_add, map_mul,
            ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) E Q]
        have h2 : algebraMap (Polynomial k) E H *
              (algebraMap (RatFunc k) E (π_K ^ (M + 1)) * v) =
            algebraMap (RatFunc k) E π_K * (algebraMap (RatFunc k) E r₂ * v) := by
          rw [← mul_assoc, IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) E H,
            ← map_mul, hH_pi_eq, map_mul, mul_assoc]
        rw [h1, h2]
        dsimp only [w_tot]
        ring
      exact sub_eq_of_eq_add' hHu_calc
    have hdiff_E0 : y₀ - algebraMap (Polynomial k) E Q ∈ E₀ :=
      E₀.sub_mem hy₀_E0 (E₀.algebraMap_mem Q)
    have hX_diff :
        algebraMap (RatFunc k) E X_K * (y₀ - algebraMap (Polynomial k) E Q) ∈ E_tilde := by
      rw [hy₀_sub_Q, ← mul_assoc, ← map_mul, hXπ, map_one, one_mul]
      exact hw_tot_tilde
    have hy₀_eq_Q : y₀ = algebraMap (Polynomial k) E Q :=
      sub_eq_zero.mp (hDisj_zero _ hdiff_E0 hX_diff)
    have hgK_ne := hPoly_ne hg_ne
    refine ⟨(algebraMap (Polynomial k) (RatFunc k) g)⁻¹ *
        algebraMap (Polynomial k) (RatFunc k) Q, ?_⟩
    have hgx : algebraMap (RatFunc k) E (algebraMap (Polynomial k) (RatFunc k) g) * x =
        algebraMap (RatFunc k) E (algebraMap (Polynomial k) (RatFunc k) Q) := by
      rwa [← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) E,
        ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) E]
    rw [map_mul, map_inv₀]
    have hgE_ne : algebraMap (RatFunc k) E (algebraMap (Polynomial k) (RatFunc k) g) ≠ 0 :=
      fun h0 => hgK_ne (hKE_inj (h0.trans (map_zero _).symm))
    field_simp [hgE_ne]
    exact hgx.symm
  let e_KE : RatFunc k ≃ₗ[RatFunc k] E :=
    LinearEquiv.ofBijective (Algebra.linearMap (RatFunc k) E) ⟨hKE_inj, hSurjKE⟩
  rw [← e_KE.finrank_eq, Module.finrank_self]

theorem weil_sing_dev_p1_unramified_galois_inertia_density (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (ℓ M r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F) (hM : 1 ≤ M)
    (G_geom H : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
    (hH_le : H ≤ G_geom)
    (hH_norm : ∀ g ∈ G_geom, ∀ h ∈ H, g * h * g⁻¹ ∈ H) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∀ (B_r L_r : Type u) [CommRing B_r] [IsDomain B_r] [Field L_r]
      [Algebra F B_r] [Algebra (Polynomial F) B_r] [Algebra R₀ B_r]
      [Algebra F L_r] [Algebra (Polynomial F) L_r] [Algebra (RatFunc F) L_r]
      [Algebra B_r L_r] [Algebra R₀ L_r]
      [IsScalarTower F (Polynomial F) B_r] [IsScalarTower (Polynomial F) R₀ B_r]
      [IsScalarTower F (RatFunc F) L_r] [IsScalarTower (Polynomial F) (RatFunc F) L_r]
      [IsScalarTower (Polynomial F) B_r L_r] [IsScalarTower R₀ B_r L_r]
      [Module.Finite R₀ B_r] [Algebra.Etale R₀ B_r]
      [IsFractionRing B_r L_r] [IsIntegralClosure B_r R₀ L_r]
      [FiniteDimensional (RatFunc F) L_r] [IsGalois (RatFunc F) L_r]
      (ρ_r : (B_r ≃ₐ[R₀] B_r) →* (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ),
      Function.Injective ρ_r →
      (∀ g ∈ G_geom,
        ∃ σ : B_r ≃ₐ[R₀] B_r,
          (∀ x : B_r, IsIntegral F x → σ x = x) ∧
          (ρ_r σ).val = (g.val).map (PadicInt.toZModPow (r + 1))) →
      (∀ σ : B_r ≃ₐ[R₀] B_r,
        (∀ x : B_r, IsIntegral F x → σ x = x) →
        ∃ g ∈ G_geom, (ρ_r σ).val = (g.val).map (PadicInt.toZModPow (r + 1))) →
      (let C₀ := integralClosure (Polynomial F) L_r
       let A_inf := Algebra.adjoin F ({algebraMap (RatFunc F) L_r (RatFunc.X)⁻¹} : Set L_r)
       let t_inf : ↥A_inf :=
         ⟨algebraMap (RatFunc F) L_r (RatFunc.X)⁻¹, Algebra.self_mem_adjoin_singleton F _⟩
       let C_inf := integralClosure ↥A_inf L_r
       (∀ a ∈ S_aff,
         ∀ Q : Ideal ↥C₀, Q.IsPrime →
           Ideal.comap (algebraMap (Polynomial F) ↥C₀) Q =
             Ideal.span {Polynomial.X - Polynomial.C a} →
           ∀ (σ_L : L_r ≃ₐ[RatFunc F] L_r) (σ_B : B_r ≃ₐ[R₀] B_r),
             (∀ x : L_r, IsIntegral F x → σ_L x = x) →
             (∀ b : B_r, σ_L (algebraMap B_r L_r b) = algebraMap B_r L_r (σ_B b)) →
             (∀ y : ↥C₀, σ_L (y : L_r) - (y : L_r) ∈ Subtype.val '' (Q : Set ↥C₀)) →
             ∃ h ∈ H, (ρ_r σ_B).val = (h.val).map (PadicInt.toZModPow (r + 1))) ∧
       (∀ Q_inf : Ideal ↥C_inf, Q_inf.IsPrime →
         Ideal.comap (algebraMap ↥A_inf ↥C_inf) Q_inf = Ideal.span {t_inf} →
         ∀ (σ_L : L_r ≃ₐ[RatFunc F] L_r) (σ_B : B_r ≃ₐ[R₀] B_r),
           (∀ x : L_r, IsIntegral F x → σ_L x = x) →
           (∀ b : B_r, σ_L (algebraMap B_r L_r b) = algebraMap B_r L_r (σ_B b)) →
           (∀ y : ↥C_inf, σ_L (y : L_r) - (y : L_r) ∈ Subtype.val '' (Q_inf : Set ↥C_inf)) →
           ∃ h ∈ H, (ρ_r σ_B).val = (h.val).map (PadicInt.toZModPow (r + 1)))) →
      ∀ g ∈ G_geom,
        ∃ h ∈ H,
          (h.val).map (PadicInt.toZModPow (r + 1)) = (g.val).map (PadicInt.toZModPow (r + 1)) :=
by
  intro R₀ B_r L_r _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ρ_r _ hG_surj hG_mem hInert g hg
  let π_r : PadicInt ℓ →+* ZMod (ℓ ^ (r + 1)) := PadicInt.toZModPow (r + 1)
  let Φ_r : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ →*
      (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ :=
    Units.map (RingHom.mapMatrix π_r).toMonoidHom
  have hΦ_val : ∀ u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ, (Φ_r u).val = (u.val).map π_r :=
    fun _ => rfl
  let Γ_geom_B : Subgroup (B_r ≃ₐ[R₀] B_r) :=
    { carrier := { σ | ∀ x : B_r, IsIntegral F x → σ x = x }
      one_mem' := fun _ _ => rfl
      mul_mem' := by
        intro σ₁ σ₂ hσ₁ hσ₂ x hx
        change σ₁ (σ₂ x) = x
        rw [hσ₂ x hx, hσ₁ x hx]
      inv_mem' := by
        intro σ hσ x hx
        have h1 : σ⁻¹ (σ x) = x := σ.symm_apply_apply x
        rwa [hσ x hx] at h1 }
  let N_B : Subgroup (B_r ≃ₐ[R₀] B_r) := Γ_geom_B ⊓ ((H.map Φ_r).comap ρ_r)
  have hNB_geom : ∀ σ ∈ N_B, ∀ x : B_r, IsIntegral F x → σ x = x := fun _ hσ => hσ.1
  have hNB_norm : ∀ τ : B_r ≃ₐ[R₀] B_r, (∀ x : B_r, IsIntegral F x → τ x = x) →
      ∀ σ ∈ N_B, τ * σ * τ⁻¹ ∈ N_B := by
    intro τ hτ σ ⟨hσ_geom, hσ_H⟩
    refine ⟨Γ_geom_B.mul_mem (Γ_geom_B.mul_mem hτ hσ_geom) (Γ_geom_B.inv_mem hτ), ?_⟩
    obtain ⟨g_τ, hg_τ, hg_τ_eq⟩ := hG_mem τ hτ
    have hρ_τ : ρ_r τ = Φ_r g_τ := Units.ext hg_τ_eq
    rcases Subgroup.mem_map.mp hσ_H with ⟨h₀, hh₀, hh₀_eq⟩
    change ρ_r (τ * σ * τ⁻¹) ∈ H.map Φ_r
    rw [map_mul, map_mul, map_inv, hρ_τ, ← hh₀_eq, ← map_inv, ← map_mul, ← map_mul]
    exact Subgroup.mem_map_of_mem Φ_r (hH_norm g_τ hg_τ h₀ hh₀)
  have hF_B_L : IsScalarTower F B_r L_r := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    calc
      algebraMap F L_r c
          = algebraMap (RatFunc F) L_r (algebraMap F (RatFunc F) c) :=
            IsScalarTower.algebraMap_apply F (RatFunc F) L_r c
      _ = algebraMap (RatFunc F) L_r (algebraMap (Polynomial F) (RatFunc F)
            (algebraMap F (Polynomial F) c)) := by
            rw [← IsScalarTower.algebraMap_apply F (Polynomial F) (RatFunc F)]
      _ = algebraMap (Polynomial F) L_r (algebraMap F (Polynomial F) c) := by
            rw [← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r]
      _ = algebraMap B_r L_r (algebraMap (Polynomial F) B_r (algebraMap F (Polynomial F) c)) := by
            rw [IsScalarTower.algebraMap_apply (Polynomial F) B_r L_r]
      _ = algebraMap B_r L_r (algebraMap F B_r c) := by
            rw [← IsScalarTower.algebraMap_apply F (Polynomial F) B_r]
  have hB_geom_of_L : ∀ (σ_L : L_r ≃ₐ[RatFunc F] L_r) (σ_B : B_r ≃ₐ[R₀] B_r),
      (∀ x : L_r, IsIntegral F x → σ_L x = x) →
      (∀ b : B_r, σ_L (algebraMap B_r L_r b) = algebraMap B_r L_r (σ_B b)) →
      σ_B ∈ Γ_geom_B := by
    intro σ_L σ_B hσ_L hσ_LB x hx
    have hx_L : IsIntegral F (algebraMap B_r L_r x) :=
      hx.map (IsScalarTower.toAlgHom F B_r L_r)
    have h1 : algebraMap B_r L_r (σ_B x) = algebraMap B_r L_r x := by
      rw [← hσ_LB x, hσ_L _ hx_L]
    exact IsFractionRing.injective B_r L_r h1
  obtain ⟨k, E, hFin_k, hFld_k, hFld_E, hAFk, hAkL, hAFE, hAkE, hAPkE, hARkE,
    hAPkL, hARkL, hAEL, hST_FkE, hST_FkL, hST_kPkE, hST_kRkE, hST_PkRkE,
    hST_kPkL, hST_kRkL, hST_PkRkL, hST_kEL, hST_PkEL, hST_RkEL,
    hFD_RkL, hGal_RkL, hFD_RkE, hGal_RkE,
    hX_eq, hk_int, hk_closed, hFinrank1, hLiftGal⟩ :=
    weil_p1_constant_field_galois_intermediate_setup F S_aff B_r L_r N_B hNB_geom hNB_norm
  letI : Finite k := hFin_k
  letI : Field k := hFld_k
  letI : Field E := hFld_E
  letI : Algebra F k := hAFk
  letI : Algebra k L_r := hAkL
  letI : Algebra F E := hAFE
  letI : Algebra k E := hAkE
  letI : Algebra (Polynomial k) E := hAPkE
  letI : Algebra (RatFunc k) E := hARkE
  letI : Algebra (Polynomial k) L_r := hAPkL
  letI : Algebra (RatFunc k) L_r := hARkL
  letI : Algebra E L_r := hAEL
  letI : IsScalarTower F k E := hST_FkE
  letI : IsScalarTower F k L_r := hST_FkL
  letI : IsScalarTower k (Polynomial k) E := hST_kPkE
  letI : IsScalarTower k (RatFunc k) E := hST_kRkE
  letI : IsScalarTower (Polynomial k) (RatFunc k) E := hST_PkRkE
  letI : IsScalarTower k (Polynomial k) L_r := hST_kPkL
  letI : IsScalarTower k (RatFunc k) L_r := hST_kRkL
  letI : IsScalarTower (Polynomial k) (RatFunc k) L_r := hST_PkRkL
  letI : IsScalarTower k E L_r := hST_kEL
  letI : IsScalarTower (Polynomial k) E L_r := hST_PkEL
  letI : IsScalarTower (RatFunc k) E L_r := hST_RkEL
  letI : FiniteDimensional (RatFunc k) L_r := hFD_RkL
  letI : IsGalois (RatFunc k) L_r := hGal_RkL
  letI : FiniteDimensional (RatFunc k) E := hFD_RkE
  letI : IsGalois (RatFunc k) E := hGal_RkE
  obtain ⟨hLinMax, hEtAway, hAffBridge,
    ⟨A_inf_k, hCR_inf, hDD_inf, hAk_inf, hAinf_Rk, hFrac_inf, hAinf_E, hAinf_L,
      hST_k_inf_Rk, hST_inf_Rk_E, hST_inf_Rk_L, hST_inf_E_L,
      e_inf, t_K, he_X, ht_K, hp_inf_ne, hp_inf_max, hp_inf_fin, hInfBridge⟩⟩ :=
    weil_p1_etale_away_and_puncture_unramified_transfer F k E B_r L_r S_aff hX_eq hk_int
  letI : CommRing A_inf_k := hCR_inf
  letI : IsDedekindDomain A_inf_k := hDD_inf
  letI : Algebra k A_inf_k := hAk_inf
  letI : Algebra A_inf_k (RatFunc k) := hAinf_Rk
  letI : IsFractionRing A_inf_k (RatFunc k) := hFrac_inf
  letI : Algebra A_inf_k E := hAinf_E
  letI : Algebra A_inf_k L_r := hAinf_L
  letI : IsScalarTower k A_inf_k (RatFunc k) := hST_k_inf_Rk
  letI : IsScalarTower A_inf_k (RatFunc k) E := hST_inf_Rk_E
  letI : IsScalarTower A_inf_k (RatFunc k) L_r := hST_inf_Rk_L
  letI : IsScalarTower A_inf_k E L_r := hST_inf_E_L
  obtain ⟨hInert_aff, hInert_inf⟩ := hInert
  have hUnram_aff : ∀ (P : Ideal ↥(integralClosure (Polynomial k) E)) [P.IsPrime],
      P ≠ ⊥ → Algebra.IsUnramifiedAt (Polynomial k) P := by
    intro P hP_prime hP_ne
    rcases hEtAway P hP_ne with ⟨a, ha, hP_comap⟩ | hUnram
    · obtain ⟨hp_ne, hp_max, hp_fin⟩ := hLinMax (algebraMap F k a)
      let p_a : Ideal (Polynomial k) :=
        Ideal.span {Polynomial.X - Polynomial.C (algebraMap F k a)}
      letI : p_a.IsMaximal := hp_max
      letI : Finite (Polynomial k ⧸ p_a) := hp_fin
      refine weil_dedekind_galois_inertia_trivial_implies_unramified
        (Polynomial k) (RatFunc k) E L_r p_a hp_ne ?_ P hP_comap
      intro Q_k hQ_k hQk_comap σ_K hσ_K
      obtain ⟨Q, hQ_prime, hQ_comap, hQ_tr⟩ := hAffBridge a ha Q_k hQ_k hQk_comap
      obtain ⟨σ_L, σ_B, hσ_LK, hσ_L_int, hσ_LB, hσ_NB⟩ := hLiftGal σ_K
      have hσ_L_inert := hQ_tr (⇑σ_L) (fun y => by rw [hσ_LK]; exact hσ_K y)
      obtain ⟨h₀, hh₀, hh₀_eq⟩ :=
        hInert_aff a ha Q hQ_prime hQ_comap σ_L σ_B hσ_L_int hσ_LB hσ_L_inert
      have hσB_mem : σ_B ∈ N_B :=
        ⟨hB_geom_of_L σ_L σ_B hσ_L_int hσ_LB,
          Subgroup.mem_comap.mpr ⟨h₀, hh₀, Units.ext hh₀_eq.symm⟩⟩
      exact hσ_NB hσB_mem
    · exact hUnram
  have hUnram_inf : ∀ (P_inf : Ideal ↥(integralClosure A_inf_k E)) [P_inf.IsPrime],
      Ideal.comap (algebraMap A_inf_k ↥(integralClosure A_inf_k E)) P_inf = Ideal.span {t_K} →
      Algebra.IsUnramifiedAt A_inf_k P_inf := by
    intro P_inf hP_prime hP_comap
    let p_inf : Ideal A_inf_k := Ideal.span {t_K}
    letI : p_inf.IsMaximal := hp_inf_max
    letI : Finite (A_inf_k ⧸ p_inf) := hp_inf_fin
    refine weil_dedekind_galois_inertia_trivial_implies_unramified
      A_inf_k (RatFunc k) E L_r p_inf hp_inf_ne ?_ P_inf hP_comap
    intro Q_inf_k hQ_inf_k hQ_inf_k_comap σ_K hσ_K
    obtain ⟨Q_inf, hQ_inf_prime, hQ_inf_comap, hQ_inf_tr⟩ :=
      hInfBridge Q_inf_k hQ_inf_k hQ_inf_k_comap
    obtain ⟨σ_L, σ_B, hσ_LK, hσ_L_int, hσ_LB, hσ_NB⟩ := hLiftGal σ_K
    have hσ_L_inert := hQ_inf_tr (⇑σ_L) (fun y => by rw [hσ_LK]; exact hσ_K y)
    obtain ⟨h₀, hh₀, hh₀_eq⟩ :=
      hInert_inf Q_inf hQ_inf_prime hQ_inf_comap σ_L σ_B hσ_L_int hσ_LB hσ_L_inert
    have hσB_mem : σ_B ∈ N_B :=
      ⟨hB_geom_of_L σ_L σ_B hσ_L_int hσ_LB,
        Subgroup.mem_comap.mpr ⟨h₀, hh₀, Units.ext hh₀_eq.symm⟩⟩
    exact hσ_NB hσB_mem
  have hfr1 : Module.finrank (RatFunc k) E = 1 :=
    weil_ratfunc_everywhere_unramified_finrank_eq_one k E A_inf_k e_inf t_K
      he_X ht_K hk_closed hUnram_aff hUnram_inf
  obtain ⟨σ, hσ_geom, hσ_eq⟩ := hG_surj g hg
  have hσ_NB : σ ∈ N_B := hFinrank1 hfr1 σ hσ_geom
  rcases Subgroup.mem_map.mp hσ_NB.2 with ⟨h, hh, hh_eq⟩
  refine ⟨h, hh, ?_⟩
  rw [← hΦ_val h, congrArg Units.val hh_eq, hσ_eq]

theorem weil_etale_galois_domain_idempotents_and_aut_lift : (∀ (R S K L : Type u) [CommRing R] [IsDomain R] [CommRing S] [IsDomain S]
        [Algebra R S] [Module.Finite R S] [Algebra.Etale R S]
        [Field K] [Field L] [Algebra R K] [IsFractionRing R K]
        [Algebra S L] [IsFractionRing S L] [Algebra K L] [Algebra R L]
        [IsScalarTower R K L] [IsScalarTower R S L]
        [IsIntegralClosure S R L] [FiniteDimensional K L] [IsGalois K L],
      let μ : (S ≃ₐ[R] S) → TensorProduct R S S →ₐ[S] S :=
        fun σ => Algebra.TensorProduct.lift (AlgHom.id S S) σ.symm.toAlgHom (fun _ _ => mul_comm _ _)
      Function.Injective (algebraMap R S) ∧
      ∃ (m : ℕ) (equiv_Γ : Fin m ≃ (S ≃ₐ[R] S)) (e : Fin m → TensorProduct R S S),
        (∀ i : Fin m, e i * e i = e i) ∧
        (∀ i j : Fin m, i ≠ j → e i * e j = 0) ∧
        (∑ i : Fin m, e i) = 1 ∧
        (∀ i j : Fin m, μ (equiv_Γ j) (e i) = if i = j then 1 else 0) ∧
        (∀ (i : Fin m) (z : TensorProduct R S S),
          z * e i = TensorProduct.tmul R (μ (equiv_Γ i) z) 1 * e i)) ∧
    (∀ (F : Type u) [Field F] (S_aff : Finset F),
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      IsDomain R₀ ∧
      ∃ instAlg : Algebra R₀ (RatFunc F),
        letI : Algebra R₀ (RatFunc F) := instAlg
        IsFractionRing R₀ (RatFunc F) ∧
        ∀ (B₁ L₁ : Type u) [CommRing B₁] [Field L₁]
          [Algebra (Polynomial F) B₁] [Algebra R₀ B₁] [IsScalarTower (Polynomial F) R₀ B₁]
          [Algebra (Polynomial F) L₁] [Algebra (RatFunc F) L₁] [Algebra B₁ L₁] [Algebra R₀ L₁]
          [IsScalarTower (Polynomial F) (RatFunc F) L₁]
          [IsScalarTower (Polynomial F) B₁ L₁] [IsScalarTower R₀ B₁ L₁],
          IsScalarTower R₀ (RatFunc F) L₁) ∧
    (∀ (R K B₁ L₁ B₂ L₂ : Type u) [CommRing R] [IsDomain R] [Field K]
        [Algebra R K] [IsFractionRing R K]
        [CommRing B₁] [IsDomain B₁] [Field L₁] [Algebra R B₁]
        [Module.Finite R B₁] [Algebra.Etale R B₁]
        [Algebra B₁ L₁] [IsFractionRing B₁ L₁] [Algebra K L₁] [Algebra R L₁]
        [IsScalarTower R K L₁] [IsScalarTower R B₁ L₁]
        [IsIntegralClosure B₁ R L₁] [FiniteDimensional K L₁] [IsGalois K L₁]
        [CommRing B₂] [IsDomain B₂] [Field L₂] [Algebra R B₂]
        [Module.Finite R B₂] [Algebra.Etale R B₂]
        [Algebra B₂ L₂] [IsFractionRing B₂ L₂] [Algebra K L₂] [Algebra R L₂]
        [IsScalarTower R K L₂] [IsScalarTower R B₂ L₂]
        [IsIntegralClosure B₂ R L₂] [FiniteDimensional K L₂] [IsGalois K L₂]
        (ι_B : B₁ →ₐ[R] B₂),
      Function.Injective ι_B →
      (∀ σ : B₁ ≃ₐ[R] B₁, ∃ τ : B₂ ≃ₐ[R] B₂, ∀ b : B₁, τ (ι_B b) = ι_B (σ b)) ∧
      (letI : Algebra B₁ B₂ := ι_B.toRingHom.toAlgebra
       letI : Algebra B₁ L₂ := ((algebraMap B₂ L₂).comp ι_B.toRingHom).toAlgebra
       IsScalarTower B₁ B₂ L₂ ∧
       Module.Finite B₁ B₂ ∧
       Algebra.Etale B₁ B₂ ∧
       IsIntegralClosure B₂ B₁ L₂ ∧
       ∃ instL : Algebra L₁ L₂,
         letI : Algebra L₁ L₂ := instL
         IsScalarTower B₁ L₁ L₂ ∧
         FiniteDimensional L₁ L₂ ∧
         IsGalois L₁ L₂)) :=
by
  refine ⟨?_, ?_, ?_⟩
  · 
    intro R S K L _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ μ
    have hInjRS : Function.Injective (algebraMap R S) := by
      intro r₁ r₂ hr
      have hL : algebraMap S L (algebraMap R S r₁) = algebraMap S L (algebraMap R S r₂) :=
        congrArg (algebraMap S L) hr
      rw [← IsScalarTower.algebraMap_apply R S L, ← IsScalarTower.algebraMap_apply R S L,
        IsScalarTower.algebraMap_apply R K L, IsScalarTower.algebraMap_apply R K L] at hL
      exact IsFractionRing.injective R K ((algebraMap K L).injective hL)
    let toGal : (S ≃ₐ[R] S) → (L ≃ₐ[K] L) :=
      fun σ => IsFractionRing.fieldEquivOfAlgEquiv K L L σ
    have h_toGal : ∀ (σ : S ≃ₐ[R] S) (s : S),
        toGal σ (algebraMap S L s) = algebraMap S L (σ s) :=
      fun σ s => IsFractionRing.fieldEquivOfAlgEquiv_algebraMap K L L σ s
    let e_IC : S ≃ₐ[R] ↥(integralClosure R L) :=
      IsIntegralClosure.equiv R S L ↥(integralClosure R L)
    let fromGal : (L ≃ₐ[K] L) → (S ≃ₐ[R] S) :=
      fun ψ => (e_IC.trans (AlgEquiv.mapIntegralClosure (ψ.restrictScalars R))).trans e_IC.symm
    have h_fromGal : ∀ (ψ : L ≃ₐ[K] L) (s : S),
        algebraMap S L (fromGal ψ s) = ψ (algebraMap S L s) := by
      intro ψ s
      have h1 := IsIntegralClosure.algebraMap_equiv R S L ↥(integralClosure R L) (fromGal ψ s)
      have h2 := IsIntegralClosure.algebraMap_equiv R S L ↥(integralClosure R L) s
      change (↑(e_IC (fromGal ψ s)) : L) = algebraMap S L (fromGal ψ s) at h1
      change (↑(e_IC s) : L) = algebraMap S L s at h2
      rw [← h1, ← h2]
      dsimp [fromGal]
      rw [e_IC.apply_symm_apply]
      exact AlgEquiv.coe_mapIntegralClosure (ψ.restrictScalars R) (e_IC s)
    let equiv_aut : (S ≃ₐ[R] S) ≃ (L ≃ₐ[K] L) :=
      { toFun := toGal
        invFun := fromGal
        left_inv := fun σ => by
          ext s
          apply IsFractionRing.injective S L
          rw [h_fromGal, h_toGal]
        right_inv := fun ψ => by
          have hring : (toGal (fromGal ψ)).toRingHom = ψ.toRingHom := by
            apply IsLocalization.ringHom_ext (nonZeroDivisors S)
            ext s
            exact (h_toGal (fromGal ψ) s).trans (h_fromGal ψ s)
          ext x
          exact congrFun (congrArg DFunLike.coe hring) x }
    let _ : Fintype (L ≃ₐ[K] L) := AlgEquiv.fintype K L
    let m : ℕ := Fintype.card (L ≃ₐ[K] L)
    have hm_finrank : m = Module.finrank K L :=
      Nat.card_eq_fintype_card.symm.trans (IsGalois.card_aut_eq_finrank K L)
    let equiv_Γ : Fin m ≃ (S ≃ₐ[R] S) :=
      (Fintype.equivFin (L ≃ₐ[K] L)).symm.trans equiv_aut.symm
    have hμ_tmul : ∀ (σ : S ≃ₐ[R] S) (s₁ s₂ : S),
        μ σ (TensorProduct.tmul R s₁ s₂) = s₁ * σ.symm s₂ := by
      intro σ s₁ s₂
      exact Algebra.TensorProduct.lift_tmul (AlgHom.id S S) σ.symm.toAlgHom
        (fun _ _ => mul_comm _ _) s₁ s₂
    have hμ_sec : ∀ (σ : S ≃ₐ[R] S) (s : S),
        μ σ (TensorProduct.tmul R s 1) = s := by
      intro σ s
      rw [hμ_tmul, map_one, mul_one]
    have hKerIdem : ∀ σ : S ≃ₐ[R] S,
        ∃ f : TensorProduct R S S,
          IsIdempotentElem f ∧
          RingHom.ker (μ σ).toRingHom = Ideal.span ({f} : Set (TensorProduct R S S)) := by
      intro σ
      have hμ_surj : Function.Surjective (μ σ) := fun s => ⟨TensorProduct.tmul R s 1, hμ_sec σ s⟩
      have hFG : (RingHom.ker (μ σ).toRingHom).FG :=
        Algebra.FinitePresentation.ker_fG_of_surjective (μ σ) hμ_surj
      have hIdemI : IsIdempotentElem (RingHom.ker (μ σ).toRingHom) := by
        let _ : Algebra (TensorProduct R S S) S := (μ σ).toRingHom.toAlgebra
        have _ : IsScalarTower S (TensorProduct R S S) S :=
          IsScalarTower.of_algebraMap_eq fun s => ((μ σ).commutes s).symm
        have _ : Algebra.Etale (TensorProduct R S S) S :=
          Algebra.Etale.of_restrictScalars S (TensorProduct R S S) S
        exact (Algebra.FormallyEtale.iff_of_surjective
          (R := TensorProduct R S S) (S := S) hμ_surj).mp inferInstance
      exact (Ideal.isIdempotentElem_iff_of_fg _ hFG).mp hIdemI
    let f : Fin m → TensorProduct R S S := fun i => Classical.choose (hKerIdem (equiv_Γ i))
    have hf_spec : ∀ i : Fin m,
        IsIdempotentElem (f i) ∧
        RingHom.ker (μ (equiv_Γ i)).toRingHom = Ideal.span ({f i} : Set (TensorProduct R S S)) :=
      fun i => Classical.choose_spec (hKerIdem (equiv_Γ i))
    let e : Fin m → TensorProduct R S S := fun i => 1 - f i
    have hf_idem : ∀ i : Fin m, f i * f i = f i := fun i => (hf_spec i).1.eq
    have he_idem : ∀ i : Fin m, e i * e i = e i := by
      intro i
      dsimp [e]
      calc (1 - f i) * (1 - f i)
          = 1 - f i - f i + f i * f i := by ring
        _ = 1 - f i - f i + f i := by rw [hf_idem i]
        _ = 1 - f i := by ring
    have hfe_zero : ∀ i : Fin m, f i * e i = 0 := by
      intro i
      dsimp [e]
      rw [mul_sub, mul_one, hf_idem i, sub_self]
    have hμ_diag : ∀ i : Fin m, μ (equiv_Γ i) (e i) = 1 := by
      intro i
      have hf_ker : f i ∈ RingHom.ker (μ (equiv_Γ i)).toRingHom := by
        rw [(hf_spec i).2]
        exact Ideal.mem_span_singleton_self (f i)
      change (μ (equiv_Γ i)) (f i) = 0 at hf_ker
      dsimp [e]
      rw [map_sub, map_one, hf_ker, sub_zero]
    have h_absorb : ∀ (i : Fin m) (z : TensorProduct R S S),
        z * e i = TensorProduct.tmul R (μ (equiv_Γ i) z) 1 * e i := by
      intro i z
      have hw_ker : z - TensorProduct.tmul R (μ (equiv_Γ i) z) 1 ∈
          RingHom.ker (μ (equiv_Γ i)).toRingHom := by
        change μ (equiv_Γ i) (z - TensorProduct.tmul R (μ (equiv_Γ i) z) 1) = 0
        rw [map_sub, hμ_sec (equiv_Γ i) (μ (equiv_Γ i) z), sub_self]
      rw [(hf_spec i).2, Ideal.mem_span_singleton] at hw_ker
      rcases hw_ker with ⟨c, hc⟩
      have hsub_zero : (z - TensorProduct.tmul R (μ (equiv_Γ i) z) 1) * e i = 0 := by
        rw [hc]
        calc (f i * c) * e i = c * (f i * e i) := by ring
          _ = c * 0 := by rw [hfe_zero i]
          _ = 0 := mul_zero c
      rw [sub_mul] at hsub_zero
      exact sub_eq_zero.mp hsub_zero
    have hμ_kronecker : ∀ i j : Fin m, μ (equiv_Γ j) (e i) = if i = j then 1 else 0 := by
      intro i j
      by_cases hij : i = j
      · subst hij
        simp only [↓reduceIte, hμ_diag i]
      · simp only [hij, ↓reduceIte]
        have hex_s : ∃ s : S, (equiv_Γ i).symm s ≠ (equiv_Γ j).symm s := by
          by_contra h_all
          apply hij
          apply equiv_Γ.injective
          ext t
          have ht_eq : (equiv_Γ i).symm (equiv_Γ i t) = (equiv_Γ j).symm (equiv_Γ i t) := by
            by_contra hne
            exact h_all ⟨equiv_Γ i t, hne⟩
          have ht := congrArg (equiv_Γ j) ht_eq
          rw [(equiv_Γ i).symm_apply_apply, (equiv_Γ j).apply_symm_apply] at ht
          exact ht.symm
        rcases hex_s with ⟨s, hs_ne⟩
        have habs_s := h_absorb i (TensorProduct.tmul R 1 s)
        rw [hμ_tmul (equiv_Γ i) 1 s, one_mul] at habs_s
        have hmap_j := congrArg (μ (equiv_Γ j)) habs_s
        rw [map_mul, map_mul, hμ_tmul (equiv_Γ j) 1 s, one_mul,
          hμ_sec (equiv_Γ j) ((equiv_Γ i).symm s)] at hmap_j
        have hmul_zero : ((equiv_Γ j).symm s - (equiv_Γ i).symm s) * μ (equiv_Γ j) (e i) = 0 := by
          rw [sub_mul, hmap_j, sub_self]
        rcases mul_eq_zero.mp hmul_zero with hdiff | heval
        · exact False.elim (hs_ne (sub_eq_zero.mp hdiff).symm)
        · exact heval
    have he_orth : ∀ i j : Fin m, i ≠ j → e i * e j = 0 := by
      intro i j hij
      have hker_ij : e i ∈ RingHom.ker (μ (equiv_Γ j)).toRingHom := by
        change μ (equiv_Γ j) (e i) = 0
        rw [hμ_kronecker i j]
        simp only [hij, ↓reduceIte]
      rw [(hf_spec j).2, Ideal.mem_span_singleton] at hker_ij
      rcases hker_ij with ⟨c, hc⟩
      rw [hc]
      calc (f j * c) * e j = c * (f j * e j) := by ring
        _ = c * 0 := by rw [hfe_zero j]
        _ = 0 := mul_zero c
    
    have _ : Algebra.Smooth R S := inferInstance
    have _ : Module.Flat R S := Algebra.Smooth.flat R S
    have _ : Module.Flat R K := IsLocalization.flat K (nonZeroDivisors R)
    have _ : Module.Flat R L := Module.Flat.trans R K L
    let j_SL : S →ₐ[R] L := IsScalarTower.toAlgHom R S L
    have hj_SL_inj : Function.Injective j_SL := IsFractionRing.injective S L
    let ι₁ : TensorProduct R S S →ₐ[R] TensorProduct R L L :=
      Algebra.TensorProduct.map j_SL j_SL
    have hι₁_eq : ι₁.toLinearMap = TensorProduct.map j_SL.toLinearMap j_SL.toLinearMap := by
      apply TensorProduct.ext'
      intro s₁ s₂
      rfl
    have hι₁_inj : Function.Injective ι₁ := by
      change Function.Injective ι₁.toLinearMap
      rw [hι₁_eq]
      exact TensorProduct.map_injective_of_flat_flat
        j_SL.toLinearMap j_SL.toLinearMap hj_SL_inj hj_SL_inj
    let φ_RL_KL : TensorProduct R L L →ₐ[L] TensorProduct K L L :=
      Algebra.TensorProduct.lift
        (Algebra.TensorProduct.includeLeft (R := K) (S := L) (A := L) (B := L))
        ((Algebra.TensorProduct.includeRight (R := K) (A := L) (B := L)).restrictScalars R)
        (fun _ _ => mul_comm _ _)
    have hφ_tmul : ∀ x y : L,
        φ_RL_KL (TensorProduct.tmul R x y) = TensorProduct.tmul K x y := by
      intro x y
      have h := Algebra.TensorProduct.lift_tmul
        (Algebra.TensorProduct.includeLeft (R := K) (S := L) (A := L) (B := L))
        ((Algebra.TensorProduct.includeRight (R := K) (A := L) (B := L)).restrictScalars R)
        (fun _ _ => mul_comm _ _) x y
      change φ_RL_KL (TensorProduct.tmul R x y) =
        TensorProduct.tmul K x (1 : L) * TensorProduct.tmul K (1 : L) y at h
      rw [h, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    have hφ_inj : Function.Injective φ_RL_KL := by
      let u₁ : K →+* TensorProduct R L L :=
        (Algebra.TensorProduct.includeLeftRingHom (R := R) (A := L) (B := L)).comp (algebraMap K L)
      let u₂ : K →+* TensorProduct R L L :=
        (Algebra.TensorProduct.includeRight (R := R) (A := L) (B := L)).toRingHom.comp (algebraMap K L)
      have hu_eq : u₁ = u₂ := by
        apply IsLocalization.ringHom_ext (nonZeroDivisors R)
        ext r
        dsimp [u₁, u₂]
        rw [← IsScalarTower.algebraMap_apply R K L]
        change TensorProduct.tmul R (algebraMap R L r) 1 = TensorProduct.tmul R 1 (algebraMap R L r)
        have h1 : algebraMap R L r = r • (1 : L) := Algebra.algebraMap_eq_smul_one r
        rw [h1, TensorProduct.smul_tmul]
      have hk_comm : ∀ k : K,
          TensorProduct.tmul R (algebraMap K L k) (1 : L) =
            TensorProduct.tmul R (1 : L) (algebraMap K L k) :=
        fun k => congrFun (congrArg DFunLike.coe hu_eq) k
      let g_K : L →ₐ[K] TensorProduct R L L :=
        { (Algebra.TensorProduct.includeRight (R := R) (A := L) (B := L)).toRingHom with
          commutes' := fun k => by
            change TensorProduct.tmul R (1 : L) (algebraMap K L k) =
              algebraMap K (TensorProduct R L L) k
            rw [IsScalarTower.algebraMap_apply K L (TensorProduct R L L)]
            exact (hk_comm k).symm }
      let ψ_KL_RL : TensorProduct K L L →ₐ[L] TensorProduct R L L :=
        Algebra.TensorProduct.lift
          (Algebra.TensorProduct.includeLeft (R := R) (S := L) (A := L) (B := L))
          g_K
          (fun _ _ => mul_comm _ _)
      have h_comp : ((ψ_KL_RL.comp φ_RL_KL).restrictScalars R).toLinearMap = LinearMap.id := by
        apply TensorProduct.ext'
        intro x y
        change ψ_KL_RL (φ_RL_KL (TensorProduct.tmul R x y)) = TensorProduct.tmul R x y
        rw [hφ_tmul]
        have h := Algebra.TensorProduct.lift_tmul
          (Algebra.TensorProduct.includeLeft (R := R) (S := L) (A := L) (B := L))
          g_K (fun _ _ => mul_comm _ _) x y
        change ψ_KL_RL (TensorProduct.tmul K x y) =
          TensorProduct.tmul R x (1 : L) * TensorProduct.tmul R (1 : L) y at h
        rw [h, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      have h_left_inv : Function.LeftInverse ψ_KL_RL φ_RL_KL :=
        fun w => congrFun (congrArg DFunLike.coe h_comp) w
      exact h_left_inv.injective
    let ι_tot : TensorProduct R S S →+* TensorProduct K L L :=
      φ_RL_KL.toRingHom.comp ι₁.toRingHom
    have hι_tot_inj : Function.Injective ι_tot := hφ_inj.comp hι₁_inj
    have hι_tot_tmul : ∀ s₁ s₂ : S,
        ι_tot (TensorProduct.tmul R s₁ s₂) =
          TensorProduct.tmul K (algebraMap S L s₁) (algebraMap S L s₂) := by
      intro s₁ s₂
      change φ_RL_KL (ι₁ (TensorProduct.tmul R s₁ s₂)) = _
