        ring
      rw [h_alg, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      by_cases hkr : k = r
      · subst hkr
        simp
      · simp [hkr, Ne.symm hkr]
    simp_rw [h_term]
    rw [Finset.sum_eq_single r]
    · simp only [↓reduceIte]
      have hGK'_coeff : G_K'.coeff r = ι (G_E'.coeff r) := Polynomial.coeff_map ι r
      rw [hGK'_coeff]
      have hpow_split : h₀_K ^ N_geom = h₀_K ^ (N_geom - r) * h₀_K ^ r := by
        rw [← pow_add, Nat.sub_add_cancel hr]
      rw [hpow_split]
      have hcancel : h₀_K ^ r * (h₀_K⁻¹) ^ r = 1 := by
        rw [← mul_pow, mul_inv_cancel₀ hh₀K_ne, one_pow]
      calc h₀_K ^ (N_geom - r) * ι (G_E'.coeff r)
          = h₀_K ^ (N_geom - r) * ι (G_E'.coeff r) * (h₀_K ^ r * (h₀_K⁻¹) ^ r) := by
              rw [hcancel, mul_one]
        _ = (h₀_K ^ (N_geom - r) * h₀_K ^ r) * (ι (G_E'.coeff r) * (h₀_K⁻¹) ^ r) := by ring
    · intro k _ hkr
      simp [hkr]
    · intro hr_not_mem
      exact absurd (Finset.mem_range.mpr (by omega)) hr_not_mem
  have hG_coeff_deg : ∀ r ≤ G.natDegree, (G.coeff r).natDegree ≤ D_T := by
    intro r hr
    rw [hG_deg] at hr
    have hGE'_r_le : (G_E'.coeff r).natDegree ≤ N_geom * B₀ := by
      by_cases h0 : G_E'.coeff r = 0
      · simp [h0]
      · have hh_pow_ne : h₀' ^ (N_geom - r) ≠ 0 := pow_ne_zero _ hh₀'_ne
        have hmul_deg := Polynomial.natDegree_mul hh_pow_ne h0
        have hbound : (h₀' ^ (N_geom - r) * G_E'.coeff r).natDegree ≤ N_geom * B₀ := by
          rw [h_coeff_id r hr]
          exact hCD_charpoly r
        omega
    have hcoeff_eq : G_E'.coeff r = (G.coeff r).map (algebraMap E E') :=
      Polynomial.coeff_map (Polynomial.mapRingHom (algebraMap E E')) r
    have hdeg_eq : (G_E'.coeff r).natDegree = (G.coeff r).natDegree := by
      rw [hcoeff_eq]
      exact Polynomial.natDegree_map_eq_of_injective (algebraMap E E').injective (G.coeff r)
    omega

  exact ⟨w_op, G, ⟨hw_Bsub_op, hw_eta_op⟩, ⟨hG_mon, hG_deg, hG_coeff_deg, hG_irr, hG_deriv⟩,
    hG_eval, hw_gen_op⟩

theorem weil_etale_adjoinRoot_baseChange_and_speiser_twists (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (B L : Type u) [CommRing B] [IsDomain B] [Field L]
    [Algebra F B] [Algebra (Polynomial F) B]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [Algebra F L] [Algebra (Polynomial F) L] [Algebra (RatFunc F) L]
    [Algebra B L]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L]
    [IsScalarTower F (Polynomial F) B]
    [IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [IsScalarTower F (RatFunc F) L]
    [IsScalarTower (Polynomial F) (RatFunc F) L]
    [IsScalarTower (Polynomial F) B L]
    [IsScalarTower
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B L]
    [Module.Finite
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [Algebra.Etale
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [IsFractionRing B L]
    [IsIntegralClosure B
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L]
    [FiniteDimensional (RatFunc F) L] [IsGalois (RatFunc F) L]
    (F_B : IntermediateField F L) [Finite ↥F_B]
    (N_geom D_T : ℕ)
    (e_B : Fin N_geom → B)
    (h₀ : Polynomial ↥F_B)
    (N_mat : (B ≃ₐ[Localization.Away
        (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B) →
      Fin N_geom → Matrix (Fin N_geom) (Fin N_geom) (Polynomial ↥F_B))
    (hConstBasis :
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      let ψ_FB : Polynomial ↥F_B →+* L :=
        Polynomial.eval₂RingHom (algebraMap ↥F_B L) (algebraMap (Polynomial F) L Polynomial.X)
      (1 ≤ N_geom ∧ 1 ≤ D_T ∧ h₀ ≠ 0 ∧ Function.Injective ψ_FB) ∧
      ((∀ x : L, x ∈ F_B ↔ IsIntegral F x) ∧
        (∀ z : ↥F_B, ∃ b : B, algebraMap B L b = z.1 ∧ IsIntegral F b) ∧
        (∀ (E' : Type u) [Field E'] [Finite E'] [Algebra ↥F_B E'] (θ : E'),
          Irreducible ((minpoly ↥F_B θ).map (algebraMap ↥F_B L)))) ∧
      (Finite (B ≃ₐ[R₀] B) ∧ 1 ≤ Nat.card (B ≃ₐ[R₀] B) ∧
        Nat.card { γ : B ≃ₐ[R₀] B // ∀ x : B, IsIntegral F x → γ x = x } = N_geom) ∧
      ((∀ i : Fin N_geom, IsIntegral (Polynomial F) (e_B i)) ∧
        (∀ p : Fin N_geom → Polynomial ↥F_B,
          ∑ i : Fin N_geom, ψ_FB (p i) * algebraMap B L (e_B i) = 0 →
            ∀ i : Fin N_geom, p i = 0) ∧
        (∀ x : L, ∃ (q₀ : Polynomial ↥F_B) (p : Fin N_geom → Polynomial ↥F_B),
          q₀ ≠ 0 ∧ ψ_FB q₀ * x = ∑ i : Fin N_geom, ψ_FB (p i) * algebraMap B L (e_B i))) ∧
      ((∀ (γ : B ≃ₐ[R₀] B) (i j : Fin N_geom),
          ψ_FB h₀ * (algebraMap B L (γ (e_B i)) * algebraMap B L (e_B j)) =
            ∑ k : Fin N_geom, ψ_FB (N_mat γ i k j) * algebraMap B L (e_B k)) ∧
        (∀ (γ : B ≃ₐ[R₀] B) (i k j : Fin N_geom),
          N_geom * max h₀.natDegree (N_mat γ i k j).natDegree ≤ D_T)))
    (d : ℕ)
    (E E' : Type u) [Field E] [Finite E] [Field E'] [Finite E']
    [Algebra F E] [Algebra F E'] [Algebra E E'] [IsScalarTower F E E']
    [Algebra ↥F_B E'] [IsScalarTower F ↥F_B E']
    [FiniteDimensional E E']
    (Φ_d : E' ≃ₐ[E] E')
    (hΦ_apply : ∀ z : E', Φ_d z = z ^ (Nat.card F ^ d))
    (hΦ_pow : Φ_d ^ (Nat.card (B ≃ₐ[Localization.Away
        (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B)) = 1)
    (hfinrank_EE' : Module.finrank E E' = Nat.card (B ≃ₐ[Localization.Away
        (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B)) :
    let Δ := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)
    let R₀ := Localization.Away Δ
    let R_Γ := Nat.card (B ≃ₐ[R₀] B)
    let Ω_d := { η : B ≃ₐ[R₀] B // ∀ x : B, IsIntegral F x → η x = x ^ (Nat.card F ^ d) }
    ∃ (M_d : Type u) (_ : Field M_d)
      (_ : Algebra (Polynomial E) M_d) (_ : Algebra (RatFunc E) M_d)
      (_ : IsScalarTower (Polynomial E) (RatFunc E) M_d)
      (_ : Algebra (Polynomial E') M_d) (_ : Algebra (RatFunc E') M_d)
      (_ : IsScalarTower (Polynomial E') (RatFunc E') M_d)
      (_ : Algebra (RatFunc E) (RatFunc E'))
      (_ : IsScalarTower (RatFunc E) (RatFunc E') M_d)
      (_ : FiniteDimensional (RatFunc E) M_d)
      (_ : Algebra.IsSeparable (RatFunc E) M_d)
      (_ : FiniteDimensional (RatFunc E') M_d)
      (e_M : Module.Basis (Fin N_geom) (RatFunc E') M_d)
      (j_B : B →+* M_d)
      (B_sub : Subring M_d)
      (twist : Ω_d → (M_d ≃ₐ[RatFunc E] M_d))
      (B₀ : ℕ)
      (h₀' : Polynomial E')
      (M_tab : Ω_d → Fin R_Γ → Fin N_geom → Fin N_geom → Fin N_geom → Polynomial E'),
      ((∀ P : Polynomial E,
          algebraMap (Polynomial E') M_d (P.map (algebraMap E E')) =
            algebraMap (Polynomial E) M_d P) ∧
        (∀ P : Polynomial E,
          algebraMap (RatFunc E) (RatFunc E') (algebraMap (Polynomial E) (RatFunc E) P) =
            algebraMap (Polynomial E') (RatFunc E') (P.map (algebraMap E E'))) ∧
        (∀ P : Polynomial F,
          j_B (algebraMap (Polynomial F) B P) =
            algebraMap (Polynomial E) M_d (P.map (algebraMap F E)))) ∧
      (Module.finrank (RatFunc E') M_d = N_geom ∧
        Set.range j_B ⊆ (B_sub : Set M_d) ∧
        Set.range (algebraMap (Polynomial E') M_d) ⊆ (B_sub : Set M_d) ∧
        (∀ i : Fin N_geom, e_M i ∈ B_sub) ∧
        Subring.closure (Set.range j_B ∪
          Set.range ((algebraMap (Polynomial E') M_d).comp Polynomial.C)) = B_sub ∧
        (∀ u ∈ B_sub, ∃ m : ℕ,
          IsIntegral (Polynomial E')
            (((algebraMap (Polynomial E') M_d (Δ.map (algebraMap F E'))) ^ m) * u))) ∧
      (∀ η : Ω_d,
        (twist η) ^ R_Γ = 1 ∧
        (∀ b : B, (twist η) (j_B b) = j_B (η.1 b)) ∧
        (∀ P : Polynomial E',
          (twist η) (algebraMap (Polynomial E') M_d P) =
            algebraMap (Polynomial E') M_d (P.map Φ_d.toRingHom)) ∧
        (∀ u ∈ B_sub, (twist η) u ∈ B_sub)) ∧
      (N_geom * B₀ ≤ D_T ∧
        h₀' ≠ 0 ∧
        h₀'.natDegree ≤ B₀ ∧
        (∀ η (m : Fin R_Γ) i k j, (M_tab η m i k j).natDegree ≤ B₀) ∧
        (∀ η (m : Fin R_Γ) i, IsIntegral (Polynomial E') (((twist η) ^ (m : ℕ)) (e_M i))) ∧
        (∀ η (m : Fin R_Γ) i j,
          (algebraMap (Polynomial E') M_d h₀') * (((twist η) ^ (m : ℕ)) (e_M i) * e_M j) =
            ∑ k : Fin N_geom, (algebraMap (Polynomial E') M_d (M_tab η m i k j)) * e_M k)) :=
by
  classical
  let Δ : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)
  let R₀ := Localization.Away Δ
  let R_Γ := Nat.card (B ≃ₐ[R₀] B)
  let Ω_d := { η : B ≃ₐ[R₀] B // ∀ x : B, IsIntegral F x → η x = x ^ (Nat.card F ^ d) }
  let ψ_FB : Polynomial ↥F_B →+* L :=
    Polynomial.eval₂RingHom (algebraMap ↥F_B L) (algebraMap (Polynomial F) L Polynomial.X)
  rcases hConstBasis with
    ⟨⟨hN_pos, _hDT_pos, hh₀_ne, hψ_FB_inj⟩,
     ⟨_hFB_char, hFB_lift, hIrr_FB⟩,
     ⟨hFinAut, hR_pos, _hcard_HB⟩,
     ⟨he_int, he_indep, he_span⟩,
     ⟨hN_mul, hN_deg⟩⟩
  obtain ⟨θ₀, hθ₀_top⟩ := Field.exists_primitive_element ↥F_B E'
  have hθ₀_int : IsIntegral ↥F_B θ₀ := Algebra.IsIntegral.isIntegral θ₀
  let pb_θ : PowerBasis ↥F_B E' :=
    (IntermediateField.adjoin.powerBasis hθ₀_int).map
      ((IntermediateField.equivOfEq hθ₀_top).trans IntermediateField.topEquiv)
  let f_θ : Polynomial ↥F_B := minpoly ↥F_B pb_θ.gen
  have hf_θ_mon : f_θ.Monic := minpoly.monic (Algebra.IsIntegral.isIntegral pb_θ.gen)
  let f_θL : Polynomial L := f_θ.map (algebraMap ↥F_B L)
  have hf_θL_irr : Irreducible f_θL := hIrr_FB E' pb_θ.gen
  haveI : Fact (Irreducible f_θL) := ⟨hf_θL_irr⟩
  have hf_θL_mon : f_θL.Monic := hf_θ_mon.map (algebraMap ↥F_B L)
  let M_d : Type u := AdjoinRoot f_θL
  let i_L : L →+* M_d := AdjoinRoot.of f_θL
  let r : M_d := AdjoinRoot.root f_θL
  let j_B : B →+* M_d := i_L.comp (algebraMap B L)
  let pb_Md : PowerBasis L M_d := AdjoinRoot.powerBasis' hf_θL_mon
  have hpb_Md_gen : pb_Md.gen = r := AdjoinRoot.powerBasis'_gen hf_θL_mon
  have hdim_eq : pb_Md.dim = pb_θ.dim := by
    have h1 : pb_Md.dim = f_θL.natDegree := AdjoinRoot.powerBasis'_dim hf_θL_mon
    have h2 : f_θL.natDegree = f_θ.natDegree := hf_θ_mon.natDegree_map (algebraMap ↥F_B L)
    have h3 : f_θ.natDegree = pb_θ.dim := pb_θ.natDegree_minpoly
    exact h1.trans (h2.trans h3)
  have hi_E'_pkg : ∃ i_E' : E' →+* M_d,
      i_E' pb_θ.gen = r ∧
      ∀ z : ↥F_B, i_E' (algebraMap ↥F_B E' z) = i_L (algebraMap ↥F_B L z) := by
    letI : Algebra ↥F_B M_d := (i_L.comp (algebraMap ↥F_B L)).toAlgebra
    have hev : Polynomial.aeval r (minpoly ↥F_B pb_θ.gen) = 0 := by
      rw [Polynomial.aeval_def]
      change Polynomial.eval₂ (i_L.comp (algebraMap ↥F_B L)) r f_θ = 0
      rw [← Polynomial.eval₂_map]
      exact AdjoinRoot.eval₂_root f_θL
    let φ : E' →ₐ[↥F_B] M_d := pb_θ.lift r hev
    exact ⟨φ.toRingHom, pb_θ.lift_gen r hev, fun z => φ.commutes z⟩
  obtain ⟨i_E', hi_E'_gen, hi_E'_FB⟩ := hi_E'_pkg

  let X_L : L := algebraMap (Polynomial F) L Polynomial.X
  let ψ_E' : Polynomial E' →+* M_d := Polynomial.eval₂RingHom i_E' (i_L X_L)
  let ψ_E : Polynomial E →+* M_d := ψ_E'.comp (Polynomial.mapRingHom (algebraMap E E'))
  letI : Algebra (Polynomial E') M_d := ψ_E'.toAlgebra
  letI : Algebra (Polynomial E) M_d := ψ_E.toAlgebra
  have hPolyCompat : ∀ P : Polynomial E,
      algebraMap (Polynomial E') M_d (P.map (algebraMap E E')) = algebraMap (Polynomial E) M_d P :=
    fun _ => rfl
  have hψ_FB_align : ∀ Q : Polynomial ↥F_B,
      ψ_E' (Q.map (algebraMap ↥F_B E')) = i_L (ψ_FB Q) := by
    intro Q
    change Polynomial.eval₂ i_E' (i_L X_L) (Q.map (algebraMap ↥F_B E')) =
      i_L (Polynomial.eval₂ (algebraMap ↥F_B L) X_L Q)
    rw [Polynomial.eval₂_map]
    have hcomp_FB : i_E'.comp (algebraMap ↥F_B E') = i_L.comp (algebraMap ↥F_B L) :=
      RingHom.ext hi_E'_FB
    rw [hcomp_FB]
    exact (Polynomial.hom_eval₂ Q (algebraMap ↥F_B L) i_L X_L).symm
  have hi_E'_F : ∀ c : F, i_E' (algebraMap F E' c) = i_L (algebraMap F L c) := by
    intro c
    rw [IsScalarTower.algebraMap_apply F ↥F_B E' c, hi_E'_FB,
      ← IsScalarTower.algebraMap_apply F ↥F_B L c]
  have hPolyF_L_hom :
      i_L.comp (algebraMap (Polynomial F) L) = ψ_E.comp (Polynomial.mapRingHom (algebraMap F E)) := by
    apply Polynomial.ringHom_ext
    · intro c
      simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C]
      have hcL : algebraMap (Polynomial F) L (Polynomial.C c) = algebraMap F L c := by
        change algebraMap (Polynomial F) L (algebraMap F (Polynomial F) c) = algebraMap F L c
        rw [IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L,
          ← IsScalarTower.algebraMap_apply F (Polynomial F) (RatFunc F),
          ← IsScalarTower.algebraMap_apply F (RatFunc F) L]
      have hcR : ψ_E (Polynomial.C (algebraMap F E c)) = i_E' (algebraMap F E' c) := by
        change Polynomial.eval₂ i_E' (i_L X_L)
          ((Polynomial.C (algebraMap F E c)).map (algebraMap E E')) = _
        rw [Polynomial.map_C, Polynomial.eval₂_C, ← IsScalarTower.algebraMap_apply F E E' c]
      rw [hcL, hcR, hi_E'_F c]
    · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X]
      change i_L X_L =
        Polynomial.eval₂ i_E' (i_L X_L) ((Polynomial.X : Polynomial E).map (algebraMap E E'))
      rw [Polynomial.map_X, Polynomial.eval₂_X]
  have hj_B_poly : ∀ P : Polynomial F,
      j_B (algebraMap (Polynomial F) B P) =
        algebraMap (Polynomial E) M_d (P.map (algebraMap F E)) := by
    intro P
    calc j_B (algebraMap (Polynomial F) B P)
        = i_L (algebraMap B L (algebraMap (Polynomial F) B P)) := rfl
      _ = i_L (algebraMap (Polynomial F) L P) := by
            rw [← IsScalarTower.algebraMap_apply (Polynomial F) B L P]
      _ = (i_L.comp (algebraMap (Polynomial F) L)) P := rfl
      _ = (ψ_E.comp (Polynomial.mapRingHom (algebraMap F E))) P := by rw [hPolyF_L_hom]
      _ = algebraMap (Polynomial E) M_d (P.map (algebraMap F E)) := rfl
  have hj_B_poly' : ∀ P : Polynomial F,
      j_B (algebraMap (Polynomial F) B P) =
        algebraMap (Polynomial E') M_d (P.map (algebraMap F E')) := by
    intro P
    rw [hj_B_poly P, ← hPolyCompat, Polynomial.map_map, ← IsScalarTower.algebraMap_eq F E E']

  have hr_linIndep : ∀ c : Fin pb_θ.dim → L,
      ∑ a : Fin pb_θ.dim, i_L (c a) * r ^ (a : ℕ) = 0 → ∀ a : Fin pb_θ.dim, c a = 0 := by
    intro c hc a
    have hsum_Md : ∑ j : Fin pb_Md.dim, (c (finCongr hdim_eq j)) • pb_Md.basis j = 0 := by
      have hreidx := (Equiv.sum_comp (finCongr hdim_eq)
        (fun a : Fin pb_θ.dim => i_L (c a) * r ^ (a : ℕ))).symm
      rw [hc] at hreidx
      rw [hreidx]
      refine Finset.sum_congr rfl fun j _ => ?_
      have hcast : ((finCongr hdim_eq j : Fin pb_θ.dim) : ℕ) = (j : ℕ) := rfl
      rw [pb_Md.basis_eq_pow, hpb_Md_gen, hcast, Algebra.smul_def]
      rfl
    have hj := Fintype.linearIndependent_iff.mp pb_Md.basis.linearIndependent
      (fun j => c (finCongr hdim_eq j)) hsum_Md ((finCongr hdim_eq).symm a)
    simpa using hj
  let decomp (P : Polynomial E') (a : Fin pb_θ.dim) : Polynomial ↥F_B :=
    ∑ n ∈ Finset.range (P.natDegree + 1),
      Polynomial.monomial n (pb_θ.basis.repr (P.coeff n) a)
  have hdecomp_eq : ∀ P : Polynomial E',
      P = ∑ a : Fin pb_θ.dim,
        (decomp P a).map (algebraMap ↥F_B E') * Polynomial.C (pb_θ.gen ^ (a : ℕ)) := by
    intro P
    apply Polynomial.ext
    intro k
    rw [Polynomial.finsetSum_coeff]
    simp only [Polynomial.coeff_mul_C, Polynomial.coeff_map]
    by_cases hk : k ≤ P.natDegree
    · have hk_mem : k ∈ Finset.range (P.natDegree + 1) := Finset.mem_range.mpr (by omega)
      have hcoeff_a : ∀ a : Fin pb_θ.dim,
          (decomp P a).coeff k = pb_θ.basis.repr (P.coeff k) a := by
        intro a
        dsimp only [decomp]
        rw [Polynomial.finsetSum_coeff, Finset.sum_eq_single k]
        · simp [Polynomial.coeff_monomial]
        · intro b _ hbk
          simp [Polynomial.coeff_monomial, hbk]
        · intro hnot
          exact absurd hk_mem hnot
      have hsum_repr := (pb_θ.basis.sum_repr (P.coeff k)).symm
      conv_lhs => rw [hsum_repr]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [hcoeff_a a, pb_θ.basis_eq_pow, Algebra.smul_def]
    · have hk_gt : P.natDegree < k := Nat.lt_of_not_ge hk
      rw [Polynomial.coeff_eq_zero_of_natDegree_lt hk_gt]
      symm
      refine Finset.sum_eq_zero fun a _ => ?_
      have hcoeff0 : (decomp P a).coeff k = 0 := by
        dsimp only [decomp]
        rw [Polynomial.finsetSum_coeff]
        refine Finset.sum_eq_zero fun b hb => ?_
        have hbk : b ≠ k := by
          have hb_lt := Finset.mem_range.mp hb
          omega
        simp [Polynomial.coeff_monomial, hbk]
      rw [hcoeff0, map_zero, zero_mul]
  have hdecomp_ψ : ∀ P : Polynomial E',
      ψ_E' P = ∑ a : Fin pb_θ.dim, i_L (ψ_FB (decomp P a)) * r ^ (a : ℕ) := by
    intro P
    conv_lhs => rw [hdecomp_eq P]
    rw [map_sum]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [map_mul, hψ_FB_align (decomp P a)]
    have hC : ψ_E' (Polynomial.C (pb_θ.gen ^ (a : ℕ))) = r ^ (a : ℕ) := by
      change Polynomial.eval₂ i_E' (i_L X_L) (Polynomial.C (pb_θ.gen ^ (a : ℕ))) = r ^ (a : ℕ)
      rw [Polynomial.eval₂_C, map_pow, hi_E'_gen]
    rw [hC]
  have hψ_E'_inj : Function.Injective ψ_E' := by
    rw [injective_iff_map_eq_zero]
    intro P hP0
    rw [hdecomp_ψ P] at hP0
    have ha0 := hr_linIndep (fun a => ψ_FB (decomp P a)) hP0
    have hda0 : ∀ a : Fin pb_θ.dim, decomp P a = 0 := by
      intro a
      exact hψ_FB_inj ((ha0 a).trans (map_zero ψ_FB).symm)
    rw [hdecomp_eq P]
    refine Finset.sum_eq_zero fun a _ => ?_
    rw [hda0 a, Polynomial.map_zero, zero_mul]

  let ψ_RatE' : RatFunc E' →+* M_d := IsFractionRing.lift (K := RatFunc E') hψ_E'_inj
  letI : Algebra (RatFunc E') M_d := ψ_RatE'.toAlgebra
  have hψ_RatE'_eq : ∀ P : Polynomial E',
      ψ_RatE' (algebraMap (Polynomial E') (RatFunc E') P) = ψ_E' P :=
    fun P => IsFractionRing.lift_algebraMap (K := RatFunc E') hψ_E'_inj P
  haveI : IsScalarTower (Polynomial E') (RatFunc E') M_d :=
    IsScalarTower.of_algebraMap_eq fun P => (hψ_RatE'_eq P).symm
  let α₀ : Polynomial E →+* RatFunc E' :=
    (algebraMap (Polynomial E') (RatFunc E')).comp (Polynomial.mapRingHom (algebraMap E E'))
  have hα₀_inj : Function.Injective α₀ :=
    (IsFractionRing.injective (Polynomial E') (RatFunc E')).comp
      (Polynomial.map_injective _ (algebraMap E E').injective)
  let ι_Rat : RatFunc E →+* RatFunc E' := IsFractionRing.lift (K := RatFunc E) hα₀_inj
  letI : Algebra (RatFunc E) (RatFunc E') := ι_Rat.toAlgebra
  have hRatCompat : ∀ P : Polynomial E,
      algebraMap (RatFunc E) (RatFunc E') (algebraMap (Polynomial E) (RatFunc E) P) =
        algebraMap (Polynomial E') (RatFunc E') (P.map (algebraMap E E')) :=
    fun P => IsFractionRing.lift_algebraMap (K := RatFunc E) hα₀_inj P
  letI : Algebra (RatFunc E) M_d := (ψ_RatE'.comp ι_Rat).toAlgebra
  haveI : IsScalarTower (RatFunc E) (RatFunc E') M_d :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : IsScalarTower (Polynomial E) (RatFunc E) M_d :=
    IsScalarTower.of_algebraMap_eq fun P => by
      change ψ_E P = ψ_RatE' (ι_Rat (algebraMap (Polynomial E) (RatFunc E) P))
      rw [IsFractionRing.lift_algebraMap (K := RatFunc E) hα₀_inj P]
      exact (hψ_RatE'_eq (P.map (algebraMap E E'))).symm

  let w_M : Fin N_geom → M_d := fun i => j_B (e_B i)
  have hw_li_poly : LinearIndependent (Polynomial E') w_M := by
    rw [Fintype.linearIndependent_iff]
    intro P hP0
    have hsum0 : ∑ a : Fin pb_θ.dim,
        i_L (∑ i : Fin N_geom, ψ_FB (decomp (P i) a) * algebraMap B L (e_B i)) * r ^ (a : ℕ) = 0 := by
      have h1 : ∑ i : Fin N_geom, ψ_E' (P i) * i_L (algebraMap B L (e_B i)) = 0 := by
        rw [← hP0]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Algebra.smul_def]
        rfl
      have h2 : (∑ i : Fin N_geom, ψ_E' (P i) * i_L (algebraMap B L (e_B i))) =
          ∑ a : Fin pb_θ.dim,
            i_L (∑ i : Fin N_geom, ψ_FB (decomp (P i) a) * algebraMap B L (e_B i)) * r ^ (a : ℕ) := by
        calc ∑ i : Fin N_geom, ψ_E' (P i) * i_L (algebraMap B L (e_B i))
            = ∑ i : Fin N_geom,
                (∑ a : Fin pb_θ.dim, i_L (ψ_FB (decomp (P i) a)) * r ^ (a : ℕ)) *
                  i_L (algebraMap B L (e_B i)) := by
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [hdecomp_ψ (P i)]
          _ = ∑ i : Fin N_geom, ∑ a : Fin pb_θ.dim,
                (i_L (ψ_FB (decomp (P i) a) * algebraMap B L (e_B i)) * r ^ (a : ℕ)) := by
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [Finset.sum_mul]
              refine Finset.sum_congr rfl fun a _ => ?_
              rw [map_mul]
              ring
          _ = ∑ a : Fin pb_θ.dim, ∑ i : Fin N_geom,
                (i_L (ψ_FB (decomp (P i) a) * algebraMap B L (e_B i)) * r ^ (a : ℕ)) :=
              Finset.sum_comm
          _ = ∑ a : Fin pb_θ.dim,
                i_L (∑ i : Fin N_geom, ψ_FB (decomp (P i) a) * algebraMap B L (e_B i)) * r ^ (a : ℕ) := by
              refine Finset.sum_congr rfl fun a _ => ?_
              rw [map_sum, Finset.sum_mul]
      rwa [← h2]
    have ha0 := hr_linIndep
      (fun a => ∑ i : Fin N_geom, ψ_FB (decomp (P i) a) * algebraMap B L (e_B i)) hsum0
    have hd0 : ∀ (a : Fin pb_θ.dim) (i : Fin N_geom), decomp (P i) a = 0 :=
      fun a => he_indep (fun i => decomp (P i) a) (ha0 a)
    intro i
    rw [hdecomp_eq (P i)]
    refine Finset.sum_eq_zero fun a _ => ?_
    rw [hd0 a i, Polynomial.map_zero, zero_mul]
  have hw_li : LinearIndependent (RatFunc E') w_M :=
    (LinearIndependent.iff_fractionRing (Polynomial E') (RatFunc E')).mp hw_li_poly
  have hw_sp : ⊤ ≤ Submodule.span (RatFunc E') (Set.range w_M) := by
    let W := Submodule.span (RatFunc E') (Set.range w_M)
    have hiL_mem : ∀ x : L, i_L x ∈ W := by
      intro x
      obtain ⟨q₀, p, hq₀_ne, hqp_eq⟩ := he_span x
      let Q₀ : RatFunc E' := algebraMap (Polynomial E') (RatFunc E') (q₀.map (algebraMap ↥F_B E'))
      let P_rat : Fin N_geom → RatFunc E' :=
        fun i => algebraMap (Polynomial E') (RatFunc E') ((p i).map (algebraMap ↥F_B E'))
      have hq₀_map_ne : q₀.map (algebraMap ↥F_B E') ≠ 0 := by
        intro h0
        exact hq₀_ne (Polynomial.map_injective _ (algebraMap ↥F_B E').injective
          (by rw [h0, Polynomial.map_zero]))
      have hQ₀_ne : Q₀ ≠ 0 :=
        (map_ne_zero_iff (algebraMap (Polynomial E') (RatFunc E'))
          (IsFractionRing.injective (Polynomial E') (RatFunc E'))).mpr hq₀_map_ne
      have hψQ₀_ne : ψ_RatE' Q₀ ≠ 0 := (map_ne_zero_iff ψ_RatE' ψ_RatE'.injective).mpr hQ₀_ne
      have hmul_eq : ψ_RatE' Q₀ * i_L x = ∑ i : Fin N_geom, ψ_RatE' (P_rat i) * w_M i := by
        have h1 := congrArg i_L hqp_eq
        rw [map_mul, map_sum] at h1
        have hlhs : ψ_RatE' Q₀ = i_L (ψ_FB q₀) := by
          dsimp only [Q₀]
          rw [hψ_RatE'_eq, hψ_FB_align]
        rw [hlhs, h1]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_mul]
        have hrhs : ψ_RatE' (P_rat i) = i_L (ψ_FB (p i)) := by
          dsimp only [P_rat]
          rw [hψ_RatE'_eq, hψ_FB_align]
        rw [hrhs]
        rfl
      have hx_eq : i_L x = ∑ i : Fin N_geom, (Q₀⁻¹ * P_rat i) • w_M i := by
        apply mul_left_cancel₀ hψQ₀_ne
        rw [hmul_eq, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Algebra.smul_def]
        change ψ_RatE' (P_rat i) * w_M i = ψ_RatE' Q₀ * (ψ_RatE' (Q₀⁻¹ * P_rat i) * w_M i)
        rw [map_mul, map_inv₀, ← mul_assoc, ← mul_assoc, mul_inv_cancel₀ hψQ₀_ne, one_mul]
      rw [hx_eq]
      exact Submodule.sum_mem W fun i _ =>
        Submodule.smul_mem W (Q₀⁻¹ * P_rat i) (Submodule.subset_span ⟨i, rfl⟩)
    intro y _
    rw [← pb_Md.basis.sum_repr y]
    refine Submodule.sum_mem W fun j _ => ?_
    let s_j : RatFunc E' :=
      algebraMap (Polynomial E') (RatFunc E') (Polynomial.C (pb_θ.gen ^ (j : ℕ)))
    have hterm : (pb_Md.basis.repr y j) • pb_Md.basis j = s_j • i_L (pb_Md.basis.repr y j) := by
      rw [pb_Md.basis_eq_pow, hpb_Md_gen, Algebra.smul_def, Algebra.smul_def]
      change i_L (pb_Md.basis.repr y j) * r ^ (j : ℕ) = ψ_RatE' s_j * i_L (pb_Md.basis.repr y j)
      dsimp only [s_j]
      rw [hψ_RatE'_eq]
      have hC : ψ_E' (Polynomial.C (pb_θ.gen ^ (j : ℕ))) = r ^ (j : ℕ) := by
        change Polynomial.eval₂ i_E' (i_L X_L) (Polynomial.C (pb_θ.gen ^ (j : ℕ))) = r ^ (j : ℕ)
        rw [Polynomial.eval₂_C, map_pow, hi_E'_gen]
      rw [hC, mul_comm]
    rw [hterm]
    exact Submodule.smul_mem W s_j (hiL_mem (pb_Md.basis.repr y j))
  let e_M : Module.Basis (Fin N_geom) (RatFunc E') M_d := Module.Basis.mk hw_li hw_sp
  have he_M_apply : ∀ i : Fin N_geom, e_M i = j_B (e_B i) := by
    intro i
    rw [Module.Basis.coe_mk]
  haveI : FiniteDimensional (RatFunc E') M_d := Module.Finite.of_basis e_M
  have hfinrank_Md : Module.finrank (RatFunc E') M_d = N_geom := by
    rw [Module.finrank_eq_card_basis e_M, Fintype.card_fin]

  haveI : FiniteDimensional (RatFunc E) M_d := by
    let β := Module.finBasis E E'
    let β' : Fin (Module.finrank E E') → RatFunc E' :=
      fun α => algebraMap (Polynomial E') (RatFunc E') (Polynomial.C (β α))
    let V_β : Submodule (RatFunc E) (RatFunc E') := Submodule.span (RatFunc E) (Set.range β')
    have hV_fg : V_β.FG := Submodule.fg_span (Set.finite_range β')
    haveI : FiniteDimensional (RatFunc E) ↥V_β := (Submodule.fg_iff_finiteDimensional V_β).mp hV_fg
    have hPoly_mem : ∀ P : Polynomial E', algebraMap (Polynomial E') (RatFunc E') P ∈ V_β := by
      intro P
      let P_c (α : Fin (Module.finrank E E')) : Polynomial E :=
        ∑ n ∈ Finset.range (P.natDegree + 1),
          Polynomial.monomial n (β.repr (P.coeff n) α)
      have hP_eq : P = ∑ α : Fin (Module.finrank E E'),
          (P_c α).map (algebraMap E E') * Polynomial.C (β α) := by
        apply Polynomial.ext
        intro k
        rw [Polynomial.finsetSum_coeff]
        simp only [Polynomial.coeff_mul_C, Polynomial.coeff_map]
        by_cases hk : k ≤ P.natDegree
        · have hk_mem : k ∈ Finset.range (P.natDegree + 1) := Finset.mem_range.mpr (by omega)
          have hcoeff_α : ∀ α, (P_c α).coeff k = β.repr (P.coeff k) α := by
            intro α
            dsimp only [P_c]
            rw [Polynomial.finsetSum_coeff, Finset.sum_eq_single k]
            · simp [Polynomial.coeff_monomial]
            · intro b _ hbk; simp [Polynomial.coeff_monomial, hbk]
            · intro hnot; exact absurd hk_mem hnot
          conv_lhs => rw [(β.sum_repr (P.coeff k)).symm]
          refine Finset.sum_congr rfl fun α _ => ?_
          rw [hcoeff_α α, Algebra.smul_def]
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (Nat.lt_of_not_ge hk)]
          symm
          refine Finset.sum_eq_zero fun α _ => ?_
          have hcoeff0 : (P_c α).coeff k = 0 := by
            dsimp only [P_c]
            rw [Polynomial.finsetSum_coeff]
            refine Finset.sum_eq_zero fun b hb => ?_
            have hbk : b ≠ k := by have := Finset.mem_range.mp hb; omega
            simp [Polynomial.coeff_monomial, hbk]
          rw [hcoeff0, map_zero, zero_mul]
      rw [hP_eq, map_sum]
      refine Submodule.sum_mem V_β fun α _ => ?_
      rw [map_mul, ← hRatCompat (P_c α), ← Algebra.smul_def]
      exact Submodule.smul_mem V_β _ (Submodule.subset_span ⟨α, rfl⟩)
    have h1_mem : (1 : RatFunc E') ∈ V_β := by
      rw [← map_one (algebraMap (Polynomial E') (RatFunc E'))]
      exact hPoly_mem 1
    have hmul_mem : ∀ {u v : RatFunc E'}, u ∈ V_β → v ∈ V_β → u * v ∈ V_β := by
      intro u v hu hv
      obtain ⟨cu, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun (RatFunc E)).mp hu
      obtain ⟨cv, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun (RatFunc E)).mp hv
      rw [Finset.sum_mul]
      refine Submodule.sum_mem V_β fun α₁ _ => ?_
      rw [Finset.mul_sum]
      refine Submodule.sum_mem V_β fun α₂ _ => ?_
      have hprod : (cu α₁ • β' α₁) * (cv α₂ • β' α₂) =
          (cu α₁ * cv α₂) •
            algebraMap (Polynomial E') (RatFunc E') (Polynomial.C (β α₁ * β α₂)) := by
        dsimp only [β']
        rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def, map_mul, Polynomial.C_mul,
          map_mul]
        ring
      rw [hprod]
      exact Submodule.smul_mem V_β _ (hPoly_mem _)
    have hinv_mem : ∀ {u : RatFunc E'}, u ∈ V_β → u ≠ 0 → u⁻¹ ∈ V_β := by
      intro u hu hu_ne
      let L_u : ↥V_β →ₗ[RatFunc E] ↥V_β :=
        { toFun := fun x => ⟨u * x.1, hmul_mem hu x.2⟩
          map_add' := fun x y => Subtype.ext (mul_add u x.1 y.1)
          map_smul' := fun c x => Subtype.ext (by
            change u * (c • x.1) = c • (u * x.1)
            rw [Algebra.smul_def, Algebra.smul_def]
            ring) }
      have hL_inj : Function.Injective L_u := by
        intro x y hxy
        exact Subtype.ext (mul_left_cancel₀ hu_ne (congrArg Subtype.val hxy))
      obtain ⟨v, hv⟩ := LinearMap.surjective_of_injective hL_inj ⟨1, h1_mem⟩
      have huv : u * v.1 = 1 := congrArg Subtype.val hv
      have hinv_eq : u⁻¹ = v.1 := by
        calc u⁻¹ = u⁻¹ * (u * v.1) := by rw [huv, mul_one]
          _ = (u⁻¹ * u) * v.1 := by ring
          _ = v.1 := by rw [inv_mul_cancel₀ hu_ne, one_mul]
      rw [hinv_eq]
      exact v.2
    have hV_top : V_β = ⊤ := by
      rw [eq_top_iff]
      intro f _
      obtain ⟨⟨P, s⟩, hfs⟩ := IsLocalization.surj (nonZeroDivisors (Polynomial E')) f
      have hs_ne : (s : Polynomial E') ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have hs_rat_ne : algebraMap (Polynomial E') (RatFunc E') s.1 ≠ 0 :=
        (map_ne_zero_iff (algebraMap (Polynomial E') (RatFunc E'))
          (IsFractionRing.injective (Polynomial E') (RatFunc E'))).mpr hs_ne
      have hf_eq : f = algebraMap (Polynomial E') (RatFunc E') P *
          (algebraMap (Polynomial E') (RatFunc E') s.1)⁻¹ := by
        calc f = (f * algebraMap (Polynomial E') (RatFunc E') s.1) *
              (algebraMap (Polynomial E') (RatFunc E') s.1)⁻¹ := by
                rw [mul_assoc, mul_inv_cancel₀ hs_rat_ne, mul_one]
          _ = algebraMap (Polynomial E') (RatFunc E') P *
              (algebraMap (Polynomial E') (RatFunc E') s.1)⁻¹ := by rw [hfs]
      rw [hf_eq]
      exact hmul_mem (hPoly_mem P) (hinv_mem (hPoly_mem s.1) hs_rat_ne)
    have hTop_fg : (⊤ : Submodule (RatFunc E) (RatFunc E')).FG := hV_top ▸ hV_fg
    haveI : Module.Finite (RatFunc E) (RatFunc E') := Module.finite_def.mpr hTop_fg
    exact Module.Finite.trans (RatFunc E') M_d

  haveI : Algebra.IsSeparable (RatFunc E) M_d := by
    let S_sep : IntermediateField (RatFunc E) M_d := separableClosure (RatFunc E) M_d
    have hr_sep : r ∈ S_sep := by
      rw [mem_separableClosure_iff]
      let g_θ : Polynomial E := minpoly E pb_θ.gen
      have hg_sep : g_θ.Separable := Algebra.IsSeparable.isSeparable E pb_θ.gen
      let c_ERat : E →+* RatFunc E := (algebraMap (Polynomial E) (RatFunc E)).comp Polynomial.C
      let g_Rat : Polynomial (RatFunc E) := g_θ.map c_ERat
      have hg_Rat_sep : g_Rat.Separable := hg_sep.map
      have hg_ev : Polynomial.aeval r g_Rat = 0 := by
        rw [Polynomial.aeval_def]
        dsimp only [g_Rat]
        rw [Polynomial.eval₂_map]
        have hcomp_c : (algebraMap (RatFunc E) M_d).comp c_ERat =
            i_E'.comp (algebraMap E E') := by
          ext x
          dsimp only [RingHom.comp_apply, c_ERat]
          rw [← IsScalarTower.algebraMap_apply (Polynomial E) (RatFunc E) M_d]
          change Polynomial.eval₂ i_E' (i_L X_L) ((Polynomial.C x).map (algebraMap E E')) =
            i_E' (algebraMap E E' x)
          rw [Polynomial.map_C, Polynomial.eval₂_C]
        rw [hcomp_c, ← hi_E'_gen, ← Polynomial.hom_eval₂ g_θ (algebraMap E E') i_E' pb_θ.gen]
        have haev : Polynomial.eval₂ (algebraMap E E') pb_θ.gen g_θ = 0 := minpoly.aeval E pb_θ.gen
        rw [haev, map_zero]
      exact hg_Rat_sep.of_dvd (minpoly.dvd (RatFunc E) r hg_ev)
    let β_FE : Polynomial F →+* RatFunc E :=
      (algebraMap (Polynomial E) (RatFunc E)).comp (Polynomial.mapRingHom (algebraMap F E))
    have hβ_FE_inj : Function.Injective β_FE :=
      (IsFractionRing.injective (Polynomial E) (RatFunc E)).comp
        (Polynomial.map_injective _ (algebraMap F E).injective)
    let κ_FE : RatFunc F →+* RatFunc E := IsFractionRing.lift (K := RatFunc F) hβ_FE_inj
    have hκ_comp : (algebraMap (RatFunc E) M_d).comp κ_FE =
        i_L.comp (algebraMap (RatFunc F) L) := by
      apply IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial F))
      apply RingHom.ext
      intro P
      simp only [RingHom.comp_apply]
      rw [IsFractionRing.lift_algebraMap (K := RatFunc F) hβ_FE_inj P]
      dsimp only [β_FE, RingHom.comp_apply, Polynomial.coe_mapRingHom]
      rw [← IsScalarTower.algebraMap_apply (Polynomial E) (RatFunc E) M_d,
        ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L P]
      exact (RingHom.congr_fun hPolyF_L_hom P).symm
    have hiL_sep : ∀ x : L, i_L x ∈ S_sep := by
      intro x
      rw [mem_separableClosure_iff]
      let p_x : Polynomial (RatFunc F) := minpoly (RatFunc F) x
      have hp_sep : p_x.Separable := Algebra.IsSeparable.isSeparable (RatFunc F) x
      let p_Rat : Polynomial (RatFunc E) := p_x.map κ_FE
      have hp_Rat_sep : p_Rat.Separable := hp_sep.map
      have hp_ev : Polynomial.aeval (i_L x) p_Rat = 0 := by
        rw [Polynomial.aeval_def]
        dsimp only [p_Rat]
        rw [Polynomial.eval₂_map, hκ_comp,
          ← Polynomial.hom_eval₂ p_x (algebraMap (RatFunc F) L) i_L x]
        have haev : Polynomial.eval₂ (algebraMap (RatFunc F) L) x p_x = 0 :=
          minpoly.aeval (RatFunc F) x
        rw [haev, map_zero]
      exact hp_Rat_sep.of_dvd (minpoly.dvd (RatFunc E) (i_L x) hp_ev)
    rw [Algebra.isSeparable_def]
    intro y
    rw [← mem_separableClosure_iff, ← pb_Md.basis.sum_repr y]
    refine S_sep.toSubring.sum_mem fun j _ => ?_
    rw [pb_Md.basis_eq_pow, hpb_Md_gen, Algebra.smul_def]
    exact S_sep.toSubring.mul_mem (hiL_sep (pb_Md.basis.repr y j))
      (S_sep.toSubring.pow_mem hr_sep (j : ℕ))

  let B_sub : Subring M_d :=
    Subring.closure (Set.range j_B ∪ Set.range ((algebraMap (Polynomial E') M_d).comp Polynomial.C))
  have hj_B_sub : Set.range j_B ⊆ (B_sub : Set M_d) :=
    Set.subset_union_left.trans Subring.subset_closure
  have hC_sub : Set.range ((algebraMap (Polynomial E') M_d).comp Polynomial.C) ⊆ (B_sub : Set M_d) :=
    Set.subset_union_right.trans Subring.subset_closure
  have hX_sub : algebraMap (Polynomial E') M_d Polynomial.X ∈ B_sub := by
    have hX : algebraMap (Polynomial E') M_d Polynomial.X =
        j_B (algebraMap (Polynomial F) B Polynomial.X) := by
      rw [hj_B_poly' Polynomial.X, Polynomial.map_X]
    rw [hX]
    exact hj_B_sub ⟨algebraMap (Polynomial F) B Polynomial.X, rfl⟩
  have hPoly_sub_all : ∀ P : Polynomial E', algebraMap (Polynomial E') M_d P ∈ B_sub := by
    intro P
    refine Polynomial.induction_on P ?_ ?_ ?_
    · intro a
      exact hC_sub ⟨a, rfl⟩
    · intro p q hp hq
      rw [map_add]
      exact B_sub.add_mem hp hq
    · intro n a hna
      rw [pow_succ, ← mul_assoc, map_mul]
      exact B_sub.mul_mem hna hX_sub
  have hPoly_sub : Set.range (algebraMap (Polynomial E') M_d) ⊆ (B_sub : Set M_d) := by
    rintro _ ⟨P, rfl⟩
    exact hPoly_sub_all P
  have he_sub : ∀ i : Fin N_geom, e_M i ∈ B_sub := by
    intro i
    rw [he_M_apply i]
    exact hj_B_sub ⟨e_B i, rfl⟩
  have hcomp_jB_poly :
      (algebraMap (Polynomial E') M_d).comp (Polynomial.mapRingHom (algebraMap F E')) =
        j_B.comp (algebraMap (Polynomial F) B) :=
    RingHom.ext fun P => (hj_B_poly' P).symm
  have hInt_jB : ∀ b : B, IsIntegral (Polynomial F) b → IsIntegral (Polynomial E') (j_B b) :=
    fun _ hb => IsIntegral.map_of_comp_eq
      (Polynomial.mapRingHom (algebraMap F E')) j_B hcomp_jB_poly hb
  have hInt_γ : ∀ (γ : B ≃ₐ[R₀] B) (b : B),
      IsIntegral (Polynomial F) b → IsIntegral (Polynomial E') (j_B (γ b)) := by
    intro γ b hb
    let γ_PF : B →ₐ[Polynomial F] B := γ.toAlgHom.restrictScalars (Polynomial F)
    exact hInt_jB (γ b) (IsIntegral.map γ_PF hb)
  have hBsub_int : ∀ u ∈ B_sub, ∃ m : ℕ,
      IsIntegral (Polynomial E')
        (((algebraMap (Polynomial E') M_d (Δ.map (algebraMap F E'))) ^ m) * u) := by
    let δ_Δ : M_d := algebraMap (Polynomial E') M_d (Δ.map (algebraMap F E'))
    have hδ_pow_int : ∀ k : ℕ, IsIntegral (Polynomial E') (δ_Δ ^ k) := by
      intro k
      rw [← map_pow]
      exact isIntegral_algebraMap
    let S_int : Subring M_d :=
      { carrier := { u : M_d | ∃ m : ℕ, IsIntegral (Polynomial E') (δ_Δ ^ m * u) }
        mul_mem' := by
          rintro u₁ u₂ ⟨m₁, h₁⟩ ⟨m₂, h₂⟩
          refine ⟨m₁ + m₂, ?_⟩
          have hmul : δ_Δ ^ (m₁ + m₂) * (u₁ * u₂) = (δ_Δ ^ m₁ * u₁) * (δ_Δ ^ m₂ * u₂) := by ring
          rw [hmul]
          exact h₁.mul h₂
        one_mem' := ⟨0, by rw [pow_zero, one_mul]; exact isIntegral_one⟩
        add_mem' := by
          rintro u₁ u₂ ⟨m₁, h₁⟩ ⟨m₂, h₂⟩
          refine ⟨m₁ + m₂, ?_⟩
          have hadd : δ_Δ ^ (m₁ + m₂) * (u₁ + u₂) =
              δ_Δ ^ m₂ * (δ_Δ ^ m₁ * u₁) + δ_Δ ^ m₁ * (δ_Δ ^ m₂ * u₂) := by ring
          rw [hadd]
          exact ((hδ_pow_int m₂).mul h₁).add ((hδ_pow_int m₁).mul h₂)
        zero_mem' := ⟨0, by rw [mul_zero]; exact isIntegral_zero⟩
        neg_mem' := by
          rintro u₁ ⟨m₁, h₁⟩
          refine ⟨m₁, ?_⟩
          have hneg : δ_Δ ^ m₁ * (-u₁) = -(δ_Δ ^ m₁ * u₁) := by ring
          rw [hneg]
          exact h₁.neg }
    have hle : B_sub ≤ S_int := by
      apply Subring.closure_le.mpr
      rintro u (⟨b, rfl⟩ | ⟨c, rfl⟩)
      · have hb_R₀ : IsIntegral R₀ b := Algebra.IsIntegral.isIntegral b
        obtain ⟨s, hs_int⟩ :=
          IsIntegral.exists_multiple_integral_of_isLocalization (Submonoid.powers Δ) b hb_R₀
        obtain ⟨m, hm⟩ := (Submonoid.mem_powers_iff s.1 Δ).mp s.2
        have hsmul : s • b = algebraMap (Polynomial F) B (Δ ^ m) * b := by
          change (s.1 : Polynomial F) • b = _
          rw [← hm, Algebra.smul_def]
        rw [hsmul] at hs_int
        have hj_int := hInt_jB _ hs_int
        have hj_eq : j_B (algebraMap (Polynomial F) B (Δ ^ m) * b) = δ_Δ ^ m * j_B b := by
          rw [map_mul, map_pow, map_pow, hj_B_poly' Δ]
        rw [hj_eq] at hj_int
        exact ⟨m, hj_int⟩
      · refine ⟨0, ?_⟩
        rw [pow_zero, one_mul]
        exact isIntegral_algebraMap
    intro u hu
    exact hle hu

  let liftL (γ : B ≃ₐ[R₀] B) : L ≃+* L := IsFractionRing.ringEquivOfRingEquiv γ.toRingEquiv
  have hliftL_B : ∀ (γ : B ≃ₐ[R₀] B) (b : B),
      liftL γ (algebraMap B L b) = algebraMap B L (γ b) :=
    fun γ b => IsFractionRing.ringEquivOfRingEquiv_algebraMap γ.toRingEquiv b
  have hliftL_X : ∀ γ : B ≃ₐ[R₀] B, liftL γ X_L = X_L := by
    intro γ
    have hX_eq : X_L =
        algebraMap B L (algebraMap R₀ B (algebraMap (Polynomial F) R₀ Polynomial.X)) := by
      dsimp only [X_L]
      rw [← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B,
        ← IsScalarTower.algebraMap_apply (Polynomial F) B L]
    rw [hX_eq, hliftL_B γ, γ.commutes]
  have hliftL_one_hom : (liftL 1).toRingHom = RingHom.id L := by
    apply IsLocalization.ringHom_ext (nonZeroDivisors B)
    ext b
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingHom.id_apply]
    exact hliftL_B 1 b
  have hliftL_one : ∀ x : L, liftL 1 x = x :=
    fun x => RingHom.congr_fun hliftL_one_hom x
  have hliftL_mul_hom : ∀ γ₁ γ₂ : B ≃ₐ[R₀] B,
      (liftL (γ₁ * γ₂)).toRingHom = (liftL γ₁).toRingHom.comp (liftL γ₂).toRingHom := by
    intro γ₁ γ₂
    apply IsLocalization.ringHom_ext (nonZeroDivisors B)
    ext b
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
    rw [hliftL_B, hliftL_B, hliftL_B, AlgEquiv.mul_apply]
  have hliftL_mul : ∀ (γ₁ γ₂ : B ≃ₐ[R₀] B) (x : L),
      liftL (γ₁ * γ₂) x = liftL γ₁ (liftL γ₂ x) :=
    fun γ₁ γ₂ x => RingHom.congr_fun (hliftL_mul_hom γ₁ γ₂) x
  have hTwist_exists : ∀ η : Ω_d, ∃ η_tilde : M_d ≃ₐ[RatFunc E] M_d,
      η_tilde ^ R_Γ = 1 ∧
      (∀ b : B, η_tilde (j_B b) = j_B (η.1 b)) ∧
      (∀ P : Polynomial E',
        η_tilde (algebraMap (Polynomial E') M_d P) =
          algebraMap (Polynomial E') M_d (P.map Φ_d.toRingHom)) ∧
      (∀ u ∈ B_sub, η_tilde u ∈ B_sub) := by
    intro η
    have hFB_η : ∀ z : ↥F_B,
        i_L (liftL η.1 (algebraMap ↥F_B L z)) = i_E' (Φ_d (algebraMap ↥F_B E' z)) := by
      intro z
      obtain ⟨b, hb_eq, hb_int⟩ := hFB_lift z
      have hz_eq : algebraMap ↥F_B L z = algebraMap B L b := hb_eq.symm
      rw [hz_eq, hliftL_B η.1 b, η.2 b hb_int, map_pow, ← hz_eq, map_pow, ← hi_E'_FB z,
        ← map_pow, ← hΦ_apply]
    have hroot_η :
        Polynomial.eval₂ (i_L.comp (liftL η.1).toRingHom) (i_E' (Φ_d pb_θ.gen)) f_θL = 0 := by
      dsimp only [f_θL]
      rw [Polynomial.eval₂_map]
      have hcomp_η : (i_L.comp (liftL η.1).toRingHom).comp (algebraMap ↥F_B L) =
          (i_E'.comp Φ_d.toRingHom).comp (algebraMap ↥F_B E') :=
        RingHom.ext hFB_η
      rw [hcomp_η]
      have hhom := Polynomial.hom_eval₂ f_θ (algebraMap ↥F_B E')
        (i_E'.comp Φ_d.toRingHom) pb_θ.gen
      change Polynomial.eval₂ ((i_E'.comp Φ_d.toRingHom).comp (algebraMap ↥F_B E'))
        ((i_E'.comp Φ_d.toRingHom) pb_θ.gen) f_θ = 0
      rw [← hhom]
      have haev : Polynomial.eval₂ (algebraMap ↥F_B E') pb_θ.gen f_θ = 0 :=
        minpoly.aeval ↥F_B pb_θ.gen
      rw [haev, map_zero]
    let τ_η : M_d →+* M_d :=
      AdjoinRoot.lift (i_L.comp (liftL η.1).toRingHom) (i_E' (Φ_d pb_θ.gen)) hroot_η
    have hτ_L : ∀ x : L, τ_η (i_L x) = i_L (liftL η.1 x) :=
      fun _ => AdjoinRoot.lift_of hroot_η
    have hτ_jB : ∀ b : B, τ_η (j_B b) = j_B (η.1 b) := by
      intro b
      change τ_η (i_L (algebraMap B L b)) = i_L (algebraMap B L (η.1 b))
      rw [hτ_L, hliftL_B]
    have hτ_r : τ_η r = i_E' (Φ_d pb_θ.gen) := AdjoinRoot.lift_root hroot_η
    have hτ_E' : ∀ z : E', τ_η (i_E' z) = i_E' (Φ_d z) := by
      intro z
      conv_lhs => rw [← pb_θ.basis.sum_repr z]
      conv_rhs => rw [← pb_θ.basis.sum_repr z]
      simp only [map_sum]
      refine Finset.sum_congr rfl fun a _ => ?_
      simp only [pb_θ.basis_eq_pow, Algebra.smul_def, map_mul, map_pow,
        hi_E'_FB, hτ_L, hFB_η, hi_E'_gen, hτ_r]
    have hτ_polyE' : ∀ P : Polynomial E',
        τ_η (algebraMap (Polynomial E') M_d P) =
          algebraMap (Polynomial E') M_d (P.map Φ_d.toRingHom) := by
      intro P
      change τ_η (Polynomial.eval₂ i_E' (i_L X_L) P) =
        Polynomial.eval₂ i_E' (i_L X_L) (P.map Φ_d.toRingHom)
      rw [Polynomial.hom_eval₂ P i_E' τ_η (i_L X_L), Polynomial.eval₂_map]
      have hcomp_E' : τ_η.comp i_E' = i_E'.comp Φ_d.toRingHom := RingHom.ext hτ_E'
      rw [hcomp_E', hτ_L X_L, hliftL_X η.1]
    have hτ_polyE : ∀ P : Polynomial E,
        τ_η (algebraMap (Polynomial E) M_d P) = algebraMap (Polynomial E) M_d P := by
      intro P
      rw [← hPolyCompat P, hτ_polyE', Polynomial.map_map]
      have hΦ_E : Φ_d.toRingHom.comp (algebraMap E E') = algebraMap E E' :=
        RingHom.ext Φ_d.commutes
      rw [hΦ_E]
    have hτ_RatE_hom : τ_η.comp (algebraMap (RatFunc E) M_d) = algebraMap (RatFunc E) M_d := by
      apply IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial E))
      apply RingHom.ext
      intro P
      simp only [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply (Polynomial E) (RatFunc E) M_d]
      exact hτ_polyE P
    have hτ_RatE : ∀ f : RatFunc E,
        τ_η (algebraMap (RatFunc E) M_d f) = algebraMap (RatFunc E) M_d f :=
      fun f => RingHom.congr_fun hτ_RatE_hom f
    let τ_pow : ℕ → (M_d →+* M_d) :=
      fun m => Nat.rec (RingHom.id M_d) (fun _ ih => τ_η.comp ih) m
    have hτ_pow_zero : τ_pow 0 = RingHom.id M_d := rfl
    have hτ_pow_succ : ∀ m : ℕ, τ_pow (m + 1) = τ_η.comp (τ_pow m) := fun _ => rfl
    have hτ_pow_comm : ∀ m : ℕ, (τ_pow m).comp τ_η = τ_pow (m + 1) := by
      intro m
      induction m with
      | zero => exact RingHom.id_comp τ_η
      | succ m ih =>
        rw [hτ_pow_succ, RingHom.comp_assoc, ih]
    have hτ_pow_L : ∀ (m : ℕ) (x : L), τ_pow m (i_L x) = i_L (liftL (η.1 ^ m) x) := by
      intro m
      induction m with
      | zero =>
        intro x
        rw [hτ_pow_zero, RingHom.id_apply, pow_zero, hliftL_one]
      | succ m ih =>
        intro x
        rw [hτ_pow_succ, RingHom.comp_apply, ih x, hτ_L, pow_succ', hliftL_mul]
    have hτ_pow_r : ∀ m : ℕ, τ_pow m r = i_E' ((Φ_d ^ m) pb_θ.gen) := by
      intro m
      induction m with
      | zero =>
        rw [hτ_pow_zero, RingHom.id_apply, pow_zero, AlgEquiv.one_apply, hi_E'_gen]
      | succ m ih =>
        rw [hτ_pow_succ, RingHom.comp_apply, ih, hτ_E', pow_succ', AlgEquiv.mul_apply]
    have hτ_pow_R : τ_pow R_Γ = RingHom.id M_d := by
      haveI : Finite (B ≃ₐ[R₀] B) := hFinAut
      have hη_R : η.1 ^ R_Γ = 1 := pow_card_eq_one'
      apply AdjoinRoot.ringHom_ext
      · ext x
        change τ_pow R_Γ (i_L x) = i_L x
        rw [hτ_pow_L, hη_R, hliftL_one]
      · change τ_pow R_Γ r = r
        rw [hτ_pow_r, hΦ_pow, AlgEquiv.one_apply, hi_E'_gen]
    let τ_inv : M_d →+* M_d := τ_pow (R_Γ - 1)
    have hR_sub : (R_Γ - 1) + 1 = R_Γ := Nat.sub_add_cancel hR_pos
    have hcomp_left : τ_η.comp τ_inv = RingHom.id M_d := by
      change τ_pow ((R_Γ - 1) + 1) = RingHom.id M_d
      rw [hR_sub, hτ_pow_R]
    have hcomp_right : τ_inv.comp τ_η = RingHom.id M_d := by
      dsimp only [τ_inv]
      rw [hτ_pow_comm (R_Γ - 1), hR_sub, hτ_pow_R]
    let e_ring : M_d ≃+* M_d :=
      { toFun := τ_η
        invFun := τ_inv
        left_inv := fun y => RingHom.congr_fun hcomp_right y
        right_inv := fun y => RingHom.congr_fun hcomp_left y
        map_mul' := τ_η.map_mul'
        map_add' := τ_η.map_add' }
    let η_tilde : M_d ≃ₐ[RatFunc E] M_d := AlgEquiv.ofRingEquiv (f := e_ring) hτ_RatE
    have hη_tilde_apply : ∀ y : M_d, η_tilde y = τ_η y := fun _ => rfl
    have hη_tilde_pow : ∀ (m : ℕ) (y : M_d), (η_tilde ^ m) y = τ_pow m y := by
      intro m
      induction m with
      | zero => intro _; rfl
      | succ m ih =>
        intro y
        rw [pow_succ', AlgEquiv.mul_apply, ih y, hη_tilde_apply]
        rfl
    have hη_pow_one : η_tilde ^ R_Γ = 1 := by
      ext y
      rw [hη_tilde_pow R_Γ y, hτ_pow_R]
      rfl
    have hη_Bsub : ∀ u ∈ B_sub, η_tilde u ∈ B_sub := by
      have hle : B_sub ≤ B_sub.comap η_tilde.toRingHom := by
        apply Subring.closure_le.mpr
        rintro u (⟨b, rfl⟩ | ⟨c, rfl⟩)
        · change η_tilde (j_B b) ∈ B_sub
          rw [hη_tilde_apply, hτ_jB]
          exact hj_B_sub ⟨η.1 b, rfl⟩
        · change η_tilde (algebraMap (Polynomial E') M_d (Polynomial.C c)) ∈ B_sub
          rw [hη_tilde_apply, hτ_polyE']
          exact hPoly_sub_all _
      intro u hu
      exact hle hu
    exact ⟨η_tilde, hη_pow_one, hτ_jB, hτ_polyE', hη_Bsub⟩
  let twist : Ω_d → (M_d ≃ₐ[RatFunc E] M_d) := fun η => Classical.choose (hTwist_exists η)
  have hTwist_spec := fun η => Classical.choose_spec (hTwist_exists η)

  haveI : Finite (B ≃ₐ[R₀] B) := hFinAut
  letI : Fintype (B ≃ₐ[R₀] B) := Fintype.ofFinite (B ≃ₐ[R₀] B)
  let f_deg : ((B ≃ₐ[R₀] B) × Fin N_geom × Fin N_geom × Fin N_geom) → ℕ :=
    fun q => max h₀.natDegree (N_mat q.1 q.2.1 q.2.2.1 q.2.2.2).natDegree
  let B₀ : ℕ := Finset.univ.sup f_deg
  let h₀' : Polynomial E' := h₀.map (algebraMap ↥F_B E')
  let M_tab : Ω_d → Fin R_Γ → Fin N_geom → Fin N_geom → Fin N_geom → Polynomial E' :=
    fun η m i k j => (N_mat (η.1 ^ (m : ℕ)) i k j).map (algebraMap ↥F_B E')
  have hNB₀ : N_geom * B₀ ≤ D_T := by
    have hB₀_div : B₀ ≤ D_T / N_geom := by
      refine Finset.sup_le fun q _ => ?_
      rw [Nat.le_div_iff_mul_le hN_pos, mul_comm]
      exact hN_deg q.1 q.2.1 q.2.2.1 q.2.2.2
    exact (Nat.mul_le_mul_left N_geom hB₀_div).trans (Nat.mul_div_le D_T N_geom)
  have hh₀'_ne : h₀' ≠ 0 := by
    intro h0
    dsimp only [h₀'] at h0
    exact hh₀_ne (Polynomial.map_injective _ (algebraMap ↥F_B E').injective
      (by rw [h0, Polynomial.map_zero]))
  have hh₀'_deg : h₀'.natDegree ≤ B₀ := by
    let i₀ : Fin N_geom := ⟨0, hN_pos⟩
    let q₀ : (B ≃ₐ[R₀] B) × Fin N_geom × Fin N_geom × Fin N_geom := (1, i₀, i₀, i₀)
    exact Polynomial.natDegree_map_le.trans
      ((le_max_left _ _).trans (Finset.le_sup (f := f_deg) (Finset.mem_univ q₀)))
  have hM_deg : ∀ η (m : Fin R_Γ) i k j, (M_tab η m i k j).natDegree ≤ B₀ := by
    intro η m i k j
    let q : (B ≃ₐ[R₀] B) × Fin N_geom × Fin N_geom × Fin N_geom := (η.1 ^ (m : ℕ), i, k, j)
    exact Polynomial.natDegree_map_le.trans
      ((le_max_right _ _).trans (Finset.le_sup (f := f_deg) (Finset.mem_univ q)))
  have htwist_pow_jB : ∀ (η : Ω_d) (n : ℕ) (b : B),
      ((twist η) ^ n) (j_B b) = j_B ((η.1 ^ n) b) := by
    intro η n
    induction n with
    | zero => intro _; rfl
    | succ n ih =>
      intro b
      rw [pow_succ', pow_succ', AlgEquiv.mul_apply, AlgEquiv.mul_apply, ih b,
        (hTwist_spec η).2.1]
  have hInt_orb : ∀ η (m : Fin R_Γ) i,
      IsIntegral (Polynomial E') (((twist η) ^ (m : ℕ)) (e_M i)) := by
    intro η m i
    rw [he_M_apply i, htwist_pow_jB η (m : ℕ) (e_B i)]
    exact hInt_γ (η.1 ^ (m : ℕ)) (e_B i) (he_int i)
  have hMul_tab : ∀ η (m : Fin R_Γ) i j,
      (algebraMap (Polynomial E') M_d h₀') * (((twist η) ^ (m : ℕ)) (e_M i) * e_M j) =
        ∑ k : Fin N_geom, (algebraMap (Polynomial E') M_d (M_tab η m i k j)) * e_M k := by
    intro η m i j
    rw [he_M_apply i, he_M_apply j, htwist_pow_jB η (m : ℕ) (e_B i)]
    have hh₀_eq : algebraMap (Polynomial E') M_d h₀' = i_L (ψ_FB h₀) := hψ_FB_align h₀
    rw [hh₀_eq]
    have hid := congrArg i_L (hN_mul (η.1 ^ (m : ℕ)) i j)
    rw [map_mul, map_mul, map_sum] at hid
    change i_L (ψ_FB h₀) *
        (i_L (algebraMap B L ((η.1 ^ (m : ℕ)) (e_B i))) * i_L (algebraMap B L (e_B j))) =
      ∑ k : Fin N_geom, (algebraMap (Polynomial E') M_d (M_tab η m i k j)) * e_M k
    rw [hid]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [map_mul, he_M_apply k]
    have hM_eq : algebraMap (Polynomial E') M_d (M_tab η m i k j) =
        i_L (ψ_FB (N_mat (η.1 ^ (m : ℕ)) i k j)) :=
      hψ_FB_align (N_mat (η.1 ^ (m : ℕ)) i k j)
    rw [hM_eq]
    rfl
  exact ⟨M_d, inferInstance,
    inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance,
    e_M, j_B, B_sub, twist, B₀, h₀', M_tab,
    ⟨hPolyCompat, hRatCompat, hj_B_poly⟩,
    ⟨hfinrank_Md, hj_B_sub, hPoly_sub, he_sub, rfl, hBsub_int⟩,
    hTwist_spec,
    ⟨hNB₀, hh₀'_ne, hh₀'_deg, hM_deg, hInt_orb, hMul_tab⟩⟩

theorem weil_speiser_conductor_eval_and_frob_fiber_partition (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (B L : Type u) [CommRing B] [IsDomain B] [Field L]
    [Algebra F B] [Algebra (Polynomial F) B]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [Algebra F L] [Algebra (Polynomial F) L] [Algebra (RatFunc F) L]
    [Algebra B L]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L]
    [IsScalarTower F (Polynomial F) B]
    [IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [IsScalarTower F (RatFunc F) L]
    [IsScalarTower (Polynomial F) (RatFunc F) L]
    [IsScalarTower (Polynomial F) B L]
    [IsScalarTower
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B L]
    [Module.Finite
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [IsFractionRing B L]
    [IsIntegralClosure B
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L]
    [FiniteDimensional (RatFunc F) L] [IsGalois (RatFunc F) L]
    (hFinAut : Finite (B ≃ₐ[Localization.Away
      (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B))
    (d N_geom : ℕ) (hd : 2 ≤ d) (hN : 1 ≤ N_geom)
    (σ₀ : B ≃ₐ[Localization.Away
        (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B)
    (hσ₀ : ∀ x : B, IsIntegral F x → σ₀.symm x = x ^ (Nat.card F ^ d))
    (e_Ω : Fin N_geom ≃ { η : B ≃ₐ[Localization.Away
        (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B //
      ∀ x : B, IsIntegral F x → η x = x ^ (Nat.card F ^ d) })
    (E_sub E'_sub : IntermediateField F (AlgebraicClosure F))
    [Finite ↥E_sub] [Finite ↥E'_sub]
    (hLE : E_sub ≤ E'_sub)
    (Φ_d : ↥E'_sub ≃ₐ[F] ↥E'_sub)
    (hE_mem : ∀ z : AlgebraicClosure F, z ∈ E_sub ↔ z ^ (Nat.card F ^ d) = z)
    (hΦ_apply : ∀ z : ↥E'_sub, Φ_d z = z ^ (Nat.card F ^ d))
    (hSub_pow : ∀ K₀ : IntermediateField F ↥E_sub,
      ∃ e₀ : ℕ, (Nat.card ↥K₀) ^ e₀ = Nat.card F ^ d)
    (hGood_minpoly : ∀ x₀ : ↥E_sub,
      (∀ s ∈ S_aff, x₀ ≠ algebraMap F ↥E_sub s) →
      (∀ k : ℕ, 1 ≤ k → 2 * k ≤ d → x₀ ^ (Nat.card F ^ k) ≠ x₀) →
      IsGoodAffineCurveClosedPointPoly S_aff d (minpoly F x₀))
    (M_d : Type u) [Field M_d]
    [Algebra (Polynomial ↥E_sub) M_d] [Algebra (Polynomial ↥E'_sub) M_d]
    [Algebra (RatFunc ↥E'_sub) M_d]
    [IsScalarTower (Polynomial ↥E'_sub) (RatFunc ↥E'_sub) M_d]
    [FiniteDimensional (RatFunc ↥E'_sub) M_d]
    (hfinrank_Md : Module.finrank (RatFunc ↥E'_sub) M_d = N_geom)
    (j_B : B →+* M_d)
    (B_sub : Subring M_d)
    (twist : { η : B ≃ₐ[Localization.Away
        (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B //
      ∀ x : B, IsIntegral F x → η x = x ^ (Nat.card F ^ d) } → (M_d →+* M_d))
    (w_fam : { η : B ≃ₐ[Localization.Away
        (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B //
      ∀ x : B, IsIntegral F x → η x = x ^ (Nat.card F ^ d) } → M_d)
    (G_fam : { η : B ≃ₐ[Localization.Away
        (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B //
      ∀ x : B, IsIntegral F x → η x = x ^ (Nat.card F ^ d) } → Polynomial (Polynomial ↥E_sub))
    (δ_fam : { η : B ≃ₐ[Localization.Away
        (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B //
      ∀ x : B, IsIntegral F x → η x = x ^ (Nat.card F ^ d) } → Polynomial ↥E_sub)
    (hCompat :
      (∀ P : Polynomial ↥E_sub,
        algebraMap (Polynomial ↥E'_sub) M_d
            (P.map (IntermediateField.inclusion hLE).toRingHom) =
          algebraMap (Polynomial ↥E_sub) M_d P) ∧
      (∀ P : Polynomial F,
        j_B (algebraMap (Polynomial F) B P) =
          algebraMap (Polynomial ↥E_sub) M_d (P.map (algebraMap F ↥E_sub))))
    (hBsub_gen :
      Set.range j_B ⊆ (B_sub : Set M_d) ∧
      Set.range (algebraMap (Polynomial ↥E'_sub) M_d) ⊆ (B_sub : Set M_d) ∧
      Subring.closure (Set.range j_B ∪
        Set.range ((algebraMap (Polynomial ↥E'_sub) M_d).comp Polynomial.C)) = B_sub)
    (hTwist : ∀ η,
      (∀ b : B, twist η (j_B b) = j_B (η.1 b)) ∧
      (∀ P : Polynomial ↥E'_sub,
        twist η (algebraMap (Polynomial ↥E'_sub) M_d P) =
          algebraMap (Polynomial ↥E'_sub) M_d (P.map Φ_d.toRingHom)) ∧
      (∀ u ∈ B_sub, twist η u ∈ B_sub))
    (hModel : ∀ η,
      w_fam η ∈ B_sub ∧
      twist η (w_fam η) = w_fam η ∧
      (G_fam η).Monic ∧
      (G_fam η).natDegree = N_geom ∧
      ((G_fam η).map (algebraMap (Polynomial ↥E_sub) M_d)).eval (w_fam η) = 0 ∧
      IntermediateField.adjoin (RatFunc ↥E'_sub) ({w_fam η} : Set M_d) = ⊤)
    (hSmooth : ∀ (η) (x₀ y₀ : ↥E_sub),
      (δ_fam η).eval x₀ ≠ 0 →
      ((G_fam η).map (Polynomial.evalRingHom x₀)).eval y₀ = 0 →
      ((Polynomial.derivative (G_fam η)).map (Polynomial.evalRingHom x₀)).eval y₀ ≠ 0)
    (hRoots :
      let ψ₀ : { η : B ≃ₐ[Localization.Away
          (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B //
        ∀ x : B, IsIntegral F x → η x = x ^ (Nat.card F ^ d) } := ⟨σ₀.symm, hσ₀⟩
      ∀ x₀ : ↥E_sub,
        (δ_fam ψ₀).eval x₀ ≠ 0 →
        (((G_fam ψ₀).map (Polynomial.aeval (x₀.1 : AlgebraicClosure F)).toRingHom).roots).Nodup ∧
          (((G_fam ψ₀).map (Polynomial.aeval (x₀.1 : AlgebraicClosure F)).toRingHom).roots).card =
            N_geom)
    (hCond :
      let Δ := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)
      ∀ (η) (u : M_d), u ∈ B_sub →
        ∃ (m : ℕ) (r : Fin N_geom → Polynomial ↥E'_sub),
          (((algebraMap (Polynomial ↥E'_sub) M_d (Δ.map (algebraMap F ↥E'_sub))) ^ m) *
            (algebraMap (Polynomial ↥E'_sub) M_d
              ((δ_fam η).map (IntermediateField.inclusion hLE).toRingHom))) * u =
            ∑ j : Fin N_geom,
              (algebraMap (Polynomial ↥E'_sub) M_d (r j)) * (w_fam η) ^ (j : ℕ)) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    let Ω_d := { η : B ≃ₐ[R₀] B // ∀ x : B, IsIntegral F x → η x = x ^ (Nat.card F ^ d) }
    let ψ₀ : Ω_d := ⟨σ₀.symm, hσ₀⟩
    (∀ x₀ : ↥E_sub,
      (∀ s ∈ S_aff, x₀ ≠ algebraMap F ↥E_sub s) →
      (∀ η : Ω_d, (δ_fam η).eval x₀ ≠ 0) →
      N_geom ≤ ∑ i : Fin N_geom,
        Nat.card { y₀ : ↥E_sub //
          ((G_fam (e_Ω i)).map (Polynomial.evalRingHom x₀)).eval y₀ = 0 ∧
          ((Polynomial.derivative (G_fam (e_Ω i))).map (Polynomial.evalRingHom x₀)).eval y₀ ≠ 0 }) ∧
    (∀ x₀ y₀ : ↥E_sub,
      (∀ s ∈ S_aff, x₀ ≠ algebraMap F ↥E_sub s) →
      (δ_fam ψ₀).eval x₀ ≠ 0 →
      (∀ k : ℕ, 1 ≤ k → 2 * k ≤ d → x₀ ^ (Nat.card F ^ k) ≠ x₀) →
      ((G_fam ψ₀).map (Polynomial.evalRingHom x₀)).eval y₀ = 0 →
      ∃ (P : Polynomial F) (Q₀ : Ideal B),
        IsGoodAffineCurveClosedPointPoly S_aff d P ∧
        Q₀.IsMaximal ∧
        Ideal.comap (algebraMap (Polynomial F) B) Q₀ = Ideal.span {P} ∧
        ∀ b : B, σ₀.symm b - b ^ (Nat.card F ^ d) ∈ Q₀) :=
by
  classical
  intro R₀ Ω_d ψ₀
  let Δ : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)
  let N : ℕ := Nat.card F ^ d
  let R' := Polynomial ↥E'_sub
  let K' := RatFunc ↥E'_sub
  letI : CommRing R' := inferInstance
  letI : Field K' := inferInstance
  let ι_EE' : ↥E_sub →+* ↥E'_sub := (IntermediateField.inclusion hLE).toRingHom
  let Δ_R' : R' := Δ.map (algebraMap F ↥E'_sub)
  letI : Fintype F := Fintype.ofFinite F
  let frob₁ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F :=
    FiniteField.frobeniusAlgEquivOfAlgebraic F (AlgebraicClosure F)
  have hfrob₁_apply : ∀ z : AlgebraicClosure F, frob₁ z = z ^ Nat.card F := by
    intro z
    change (FiniteField.frobeniusAlgEquivOfAlgebraic F (AlgebraicClosure F)) z = z ^ Nat.card F
    rw [FiniteField.coe_frobeniusAlgEquivOfAlgebraic, ← Nat.card_eq_fintype_card]
  have hfrob₁_pow : ∀ (m : ℕ) (z : AlgebraicClosure F),
      (frob₁ ^ m) z = z ^ (Nat.card F ^ m) := by
    intro m
    induction m with
    | zero =>
      intro z
      simp
    | succ m ih =>
      intro z
      rw [pow_succ', AlgEquiv.mul_apply, ih z, hfrob₁_apply, ← pow_mul, ← pow_succ]
  let Frob_N : AlgebraicClosure F →+* AlgebraicClosure F := (frob₁ ^ d).toRingHom
  have hFrob_N_apply : ∀ z : AlgebraicClosure F, Frob_N z = z ^ N :=
    fun z => hfrob₁_pow d z
  let ev₀ : ↥E_sub → (R' →+* AlgebraicClosure F) :=
    fun x₀ => Polynomial.eval₂RingHom E'_sub.val.toRingHom x₀.1
  have hev₀_map_EE' : ∀ (x₀ : ↥E_sub) (P : Polynomial ↥E_sub),
      ev₀ x₀ (P.map ι_EE') = (P.eval x₀).1 := by
    intro x₀ P
    change Polynomial.eval₂ E'_sub.val.toRingHom x₀.1 (P.map ι_EE') =
      E_sub.val.toRingHom (P.eval x₀)
    rw [← Polynomial.eval_map, Polynomial.map_map]
    have hcomp : E'_sub.val.toRingHom.comp ι_EE' = E_sub.val.toRingHom :=
      RingHom.ext fun _ => rfl
    rw [hcomp]
    exact Polynomial.eval_map_apply E_sub.val.toRingHom x₀
  have hev₀_Δ_ne : ∀ x₀ : ↥E_sub,
      (∀ s ∈ S_aff, x₀ ≠ algebraMap F ↥E_sub s) →
      ev₀ x₀ Δ_R' ≠ 0 := by
    intro x₀ hx₀_S
    have hΔ_R'_eq : Δ_R' = (Δ.map (algebraMap F ↥E_sub)).map ι_EE' := by
      dsimp [Δ_R', ι_EE']
      rw [Polynomial.map_map]
      congr 1
    have hΔ_eval_ne : (Δ.map (algebraMap F ↥E_sub)).eval x₀ ≠ 0 := by
      rw [Polynomial.eval_map, ← Polynomial.aeval_def]
      change Polynomial.aeval x₀ (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s)) ≠ 0
      rw [map_prod, Finset.prod_ne_zero_iff]
      intro s hs
      rw [map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
      exact sub_ne_zero.mpr (hx₀_S s hs)
    rw [hΔ_R'_eq, hev₀_map_EE' x₀]
    intro h
    exact hΔ_eval_ne (Subtype.ext h)
  have hev₀_δ_ne : ∀ (x₀ : ↥E_sub) (δ : Polynomial ↥E_sub),
      δ.eval x₀ ≠ 0 → ev₀ x₀ (δ.map ι_EE') ≠ 0 := by
    intro x₀ δ hδ
    rw [hev₀_map_EE' x₀]
    intro h
    exact hδ (Subtype.ext h)
  have hev₀_Phi_d : ∀ (x₀ : ↥E_sub) (P : R'),
      ev₀ x₀ (P.map Φ_d.toRingHom) = Frob_N (ev₀ x₀ P) := by
    intro x₀ P
    have hEq : (ev₀ x₀).comp (Polynomial.mapRingHom Φ_d.toRingHom) = Frob_N.comp (ev₀ x₀) := by
      apply Polynomial.ringHom_ext
      · intro c
        change Polynomial.eval₂ E'_sub.val.toRingHom x₀.1
            (Polynomial.map Φ_d.toRingHom (Polynomial.C c)) =
          Frob_N (Polynomial.eval₂ E'_sub.val.toRingHom x₀.1 (Polynomial.C c))
        rw [Polynomial.map_C, Polynomial.eval₂_C, Polynomial.eval₂_C, hFrob_N_apply]
        change E'_sub.val (Φ_d c) = (E'_sub.val c) ^ N
        rw [hΦ_apply c]
        exact map_pow E'_sub.val c N
      · change Polynomial.eval₂ E'_sub.val.toRingHom x₀.1
            (Polynomial.map Φ_d.toRingHom Polynomial.X) =
          Frob_N (Polynomial.eval₂ E'_sub.val.toRingHom x₀.1 Polynomial.X)
        rw [Polynomial.map_X, Polynomial.eval₂_X, hFrob_N_apply]
        exact ((hE_mem x₀.1).mp x₀.2).symm
    exact RingHom.congr_fun hEq P

  let w₀ : M_d := w_fam ψ₀
  let G₀ : Polynomial (Polynomial ↥E_sub) := G_fam ψ₀
  let δ₀ : Polynomial ↥E_sub := δ_fam ψ₀
  let G₀' : Polynomial R' := G₀.map (Polynomial.mapRingHom ι_EE')
  let s₀ : R' := Δ_R' * (δ₀.map ι_EE')
  let Φ_M : Polynomial R' →+* M_d := Polynomial.eval₂RingHom (algebraMap R' M_d) w₀
  have hΦ_M_eq : ∀ H : Polynomial R', Φ_M H = (H.map (algebraMap R' M_d)).eval w₀ := by
    intro H
    exact (Polynomial.eval_map (p := H) (algebraMap R' M_d) w₀).symm
  have hG₀'_mon : G₀'.Monic := (hModel ψ₀).2.2.1.map (Polynomial.mapRingHom ι_EE')
  have hG₀'_deg : G₀'.natDegree = N_geom :=
    ((hModel ψ₀).2.2.1.natDegree_map (Polynomial.mapRingHom ι_EE')).trans (hModel ψ₀).2.2.2.1
  have hΦ_M_G₀' : Φ_M G₀' = 0 := by
    rw [hΦ_M_eq]
    dsimp [G₀']
    rw [Polynomial.map_map]
    have hcomp : (algebraMap R' M_d).comp (Polynomial.mapRingHom ι_EE') =
        algebraMap (Polynomial ↥E_sub) M_d :=
      RingHom.ext fun P => hCompat.1 P
    rw [hcomp]
    exact (hModel ψ₀).2.2.2.2.1
  have hΦ_M_aeval : ∀ H : Polynomial R',
      Polynomial.aeval w₀ (H.map (algebraMap R' K')) = Φ_M H := by
    intro H
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, Polynomial.map_map,
      ← IsScalarTower.algebraMap_eq R' K' M_d, ← hΦ_M_eq]
  have hKer_dvd : ∀ H : Polynomial R', Φ_M H = 0 → G₀' ∣ H := by
    have hw₀_int : IsIntegral K' w₀ := Algebra.IsIntegral.isIntegral w₀
    let μ : Polynomial K' := minpoly K' w₀
    have hμ_mon : μ.Monic := minpoly.monic hw₀_int
    have hμ_deg : μ.natDegree = N_geom := by
      have h1 : Module.finrank K' ↥(IntermediateField.adjoin K' ({w₀} : Set M_d)) = μ.natDegree :=
        IntermediateField.adjoin.finrank hw₀_int
      rw [← h1, (hModel ψ₀).2.2.2.2.2, IntermediateField.finrank_top', hfinrank_Md]
    let G_K' : Polynomial K' := G₀'.map (algebraMap R' K')
    have hG_K'_mon : G_K'.Monic := hG₀'_mon.map (algebraMap R' K')
    have hG_K'_deg : G_K'.natDegree = N_geom :=
      (hG₀'_mon.natDegree_map (algebraMap R' K')).trans hG₀'_deg
    have hG_K'_aeval : Polynomial.aeval w₀ G_K' = 0 := by
      dsimp [G_K']
      rw [hΦ_M_aeval, hΦ_M_G₀']
    obtain ⟨Q, hQ⟩ := minpoly.dvd K' w₀ hG_K'_aeval
    have hG_K'_ne : G_K' ≠ 0 := hG_K'_mon.ne_zero
    have hμ_ne : μ ≠ 0 := hμ_mon.ne_zero
    have hQ_ne : Q ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hQ
      exact hG_K'_ne hQ
    have hdeg_mul : G_K'.natDegree = μ.natDegree + Q.natDegree := by
      rw [hQ]
      exact Polynomial.natDegree_mul hμ_ne hQ_ne
    have hQ_deg : Q.natDegree = 0 := by
      rw [hG_K'_deg, hμ_deg] at hdeg_mul
      omega
    obtain ⟨c, hc⟩ := Polynomial.natDegree_eq_zero.mp hQ_deg
    have hc_eq_one : c = 1 := by
      have hlc : G_K'.leadingCoeff = μ.leadingCoeff * Q.leadingCoeff := by
        rw [hQ]
        exact Polynomial.leadingCoeff_mul μ Q
      rw [hG_K'_mon.leadingCoeff, hμ_mon.leadingCoeff, one_mul, ← hc,
        Polynomial.leadingCoeff_C] at hlc
      exact hlc.symm
    have hG_eq_μ : G_K' = μ := by
      rw [hQ, ← hc, hc_eq_one, Polynomial.C_1, mul_one]
    intro H hH
    have hH_aeval : Polynomial.aeval w₀ (H.map (algebraMap R' K')) = 0 := by
      rw [hΦ_M_aeval, hH]
    have hμ_dvd : G_K' ∣ H.map (algebraMap R' K') := by
      rw [hG_eq_μ]
      exact minpoly.dvd K' w₀ hH_aeval
    exact (Polynomial.map_dvd_map (algebraMap R' K')
      (IsFractionRing.injective R' K') hG₀'_mon).mp hμ_dvd
  have hCond_s₀ : ∀ u ∈ B_sub, ∃ p : ℕ × Polynomial R',
      (algebraMap R' M_d s₀) ^ p.1 * u = Φ_M p.2 := by
    intro u hu
    obtain ⟨m, r, hr⟩ := hCond ψ₀ u hu
    refine ⟨(m + 1,
      Polynomial.C (Δ_R' * (δ₀.map ι_EE') ^ m) *
        ∑ j : Fin N_geom, Polynomial.C (r j) * Polynomial.X ^ (j : ℕ)), ?_⟩
    dsimp only
    have hlhs : (algebraMap R' M_d s₀) ^ (m + 1) * u =
        algebraMap R' M_d (Δ_R' * (δ₀.map ι_EE') ^ m) *
          (((algebraMap R' M_d Δ_R') ^ m * algebraMap R' M_d (δ₀.map ι_EE')) * u) := by
      dsimp [s₀]
      rw [map_mul, map_mul, map_pow]
      ring
    have hrhs : Φ_M (Polynomial.C (Δ_R' * (δ₀.map ι_EE') ^ m) *
        ∑ j : Fin N_geom, Polynomial.C (r j) * Polynomial.X ^ (j : ℕ)) =
        algebraMap R' M_d (Δ_R' * (δ₀.map ι_EE') ^ m) *
          ∑ j : Fin N_geom, algebraMap R' M_d (r j) * w₀ ^ (j : ℕ) := by
      calc
        Φ_M (Polynomial.C (Δ_R' * (δ₀.map ι_EE') ^ m) *
            ∑ j : Fin N_geom, Polynomial.C (r j) * Polynomial.X ^ (j : ℕ))
          = Φ_M (Polynomial.C (Δ_R' * (δ₀.map ι_EE') ^ m)) *
              ∑ j : Fin N_geom, Φ_M (Polynomial.C (r j) * Polynomial.X ^ (j : ℕ)) := by
            rw [map_mul, map_sum]
        _ = algebraMap R' M_d (Δ_R' * (δ₀.map ι_EE') ^ m) *
              ∑ j : Fin N_geom, algebraMap R' M_d (r j) * w₀ ^ (j : ℕ) := by
            congr 1
            · exact Polynomial.eval₂_C _ _
            · apply Finset.sum_congr rfl
              intro j _
              rw [map_mul, map_pow]
              exact congrArg₂ (· * ·) (Polynomial.eval₂_C _ _)
                (congrArg (· ^ (j : ℕ)) (Polynomial.eval₂_X _ _))
    rw [hlhs, hr, hrhs]
  have hexists_eval : ∀ (x₀ : ↥E_sub) (y_bar : AlgebraicClosure F),
      (∀ s ∈ S_aff, x₀ ≠ algebraMap F ↥E_sub s) →
      δ₀.eval x₀ ≠ 0 →
      ((G₀.map (Polynomial.aeval (x₀.1 : AlgebraicClosure F)).toRingHom).eval y_bar) = 0 →
      ∃ φ : ↥B_sub →+* AlgebraicClosure F,
        (∀ (P : R') (hP : algebraMap R' M_d P ∈ B_sub),
          φ ⟨algebraMap R' M_d P, hP⟩ = ev₀ x₀ P) ∧
        φ ⟨w₀, (hModel ψ₀).1⟩ = y_bar ∧
        ∀ P : Polynomial F,
          φ ⟨j_B (algebraMap (Polynomial F) B P),
            hBsub_gen.1 ⟨algebraMap (Polynomial F) B P, rfl⟩⟩ =
            (Polynomial.aeval x₀ P : ↥E_sub).1 := by
    intro x₀ y_bar hx₀_S hx₀_δ0 hy_bar
    let ev_x : R' →+* AlgebraicClosure F := ev₀ x₀
    let σ_s₀ : AlgebraicClosure F := ev_x s₀
    have hσ_s₀_ne : σ_s₀ ≠ 0 := by
      dsimp [σ_s₀, s₀]
      rw [map_mul]
      exact mul_ne_zero (hev₀_Δ_ne x₀ hx₀_S) (hev₀_δ_ne x₀ δ₀ hx₀_δ0)
    let ev_XY : Polynomial R' →+* AlgebraicClosure F := Polynomial.eval₂RingHom ev_x y_bar
    have hev_XY_G₀' : ev_XY G₀' = 0 := by
      change Polynomial.eval₂ ev_x y_bar (G₀.map (Polynomial.mapRingHom ι_EE')) = 0
      rw [← Polynomial.eval_map, Polynomial.map_map]
      have hcomp : ev_x.comp (Polynomial.mapRingHom ι_EE') =
          (Polynomial.aeval (x₀.1 : AlgebraicClosure F)).toRingHom := by
        apply RingHom.ext
        intro P
        change ev₀ x₀ (P.map ι_EE') = Polynomial.aeval (x₀.1 : AlgebraicClosure F) P
        rw [hev₀_map_EE' x₀ P, Polynomial.aeval_def]
        exact Polynomial.hom_eval₂ P (RingHom.id ↥E_sub)
          (algebraMap ↥E_sub (AlgebraicClosure F)) x₀
      rw [hcomp]
      exact hy_bar
    have hev_XY_of_ker : ∀ H : Polynomial R', Φ_M H = 0 → ev_XY H = 0 := by
      intro H hH
      obtain ⟨Q, hQ⟩ := hKer_dvd H hH
      rw [hQ, map_mul, hev_XY_G₀', zero_mul]
    have hRep_indep : ∀ (u : M_d) (n₁ n₂ : ℕ) (H₁ H₂ : Polynomial R'),
        (algebraMap R' M_d s₀) ^ n₁ * u = Φ_M H₁ →
        (algebraMap R' M_d s₀) ^ n₂ * u = Φ_M H₂ →
        ev_XY H₁ / σ_s₀ ^ n₁ = ev_XY H₂ / σ_s₀ ^ n₂ := by
      intro u n₁ n₂ H₁ H₂ h₁ h₂
      have hker : Φ_M (Polynomial.C (s₀ ^ n₂) * H₁ - Polynomial.C (s₀ ^ n₁) * H₂) = 0 := by
        rw [map_sub, Φ_M.map_mul, Φ_M.map_mul]
        have hc₁ : Φ_M (Polynomial.C (s₀ ^ n₁)) = (algebraMap R' M_d s₀) ^ n₁ := by
          rw [← map_pow]
          exact Polynomial.eval₂_C _ _
        have hc₂ : Φ_M (Polynomial.C (s₀ ^ n₂)) = (algebraMap R' M_d s₀) ^ n₂ := by
          rw [← map_pow]
          exact Polynomial.eval₂_C _ _
        rw [hc₁, hc₂, ← h₁, ← h₂]
        ring
      have hev0 := hev_XY_of_ker _ hker
      rw [map_sub, ev_XY.map_mul, ev_XY.map_mul] at hev0
      have hevc₁ : ev_XY (Polynomial.C (s₀ ^ n₁)) = σ_s₀ ^ n₁ := by
        dsimp [σ_s₀]
        rw [← map_pow]
        exact Polynomial.eval₂_C _ _
      have hevc₂ : ev_XY (Polynomial.C (s₀ ^ n₂)) = σ_s₀ ^ n₂ := by
        dsimp [σ_s₀]
        rw [← map_pow]
        exact Polynomial.eval₂_C _ _
      rw [hevc₁, hevc₂, sub_eq_zero] at hev0
      rw [div_eq_div_iff (pow_ne_zero n₁ hσ_s₀_ne) (pow_ne_zero n₂ hσ_s₀_ne),
        mul_comm (ev_XY H₁), hev0, mul_comm]
    let φ_fun : ↥B_sub → AlgebraicClosure F := fun x =>
      let p := Classical.choose (hCond_s₀ x.1 x.2)
      ev_XY p.2 / σ_s₀ ^ p.1
    have hφ_rep : ∀ (x : ↥B_sub) (n : ℕ) (H : Polynomial R'),
        (algebraMap R' M_d s₀) ^ n * x.1 = Φ_M H →
        φ_fun x = ev_XY H / σ_s₀ ^ n := by
      intro x n H hH
      exact hRep_indep x.1 _ n _ H (Classical.choose_spec (hCond_s₀ x.1 x.2)) hH
    let φ : ↥B_sub →+* AlgebraicClosure F :=
      { toFun := φ_fun
        map_one' := by
          have h1 : (algebraMap R' M_d s₀) ^ 0 * (1 : ↥B_sub).1 = Φ_M 1 := by
            simp
          rw [hφ_rep 1 0 1 h1, map_one, pow_zero, div_one]
        map_mul' := fun x y => by
          let p₁ := Classical.choose (hCond_s₀ x.1 x.2)
          have hp₁ : (algebraMap R' M_d s₀) ^ p₁.1 * x.1 = Φ_M p₁.2 :=
            Classical.choose_spec (hCond_s₀ x.1 x.2)
          let p₂ := Classical.choose (hCond_s₀ y.1 y.2)
          have hp₂ : (algebraMap R' M_d s₀) ^ p₂.1 * y.1 = Φ_M p₂.2 :=
            Classical.choose_spec (hCond_s₀ y.1 y.2)
          have hxy : (algebraMap R' M_d s₀) ^ (p₁.1 + p₂.1) * (x * y).1 =
              Φ_M (p₁.2 * p₂.2) := by
            change (algebraMap R' M_d s₀) ^ (p₁.1 + p₂.1) * (x.1 * y.1) = Φ_M (p₁.2 * p₂.2)
            rw [Φ_M.map_mul, ← hp₁, ← hp₂, pow_add]
            ring
          rw [hφ_rep (x * y) (p₁.1 + p₂.1) (p₁.2 * p₂.2) hxy,
            hφ_rep x p₁.1 p₁.2 hp₁, hφ_rep y p₂.1 p₂.2 hp₂,
            ev_XY.map_mul, pow_add, div_mul_div_comm]
        map_zero' := by
          have h0 : (algebraMap R' M_d s₀) ^ 0 * (0 : ↥B_sub).1 = Φ_M 0 := by
            simp
          rw [hφ_rep 0 0 0 h0, map_zero, pow_zero, zero_div]
        map_add' := fun x y => by
          let p₁ := Classical.choose (hCond_s₀ x.1 x.2)
          have hp₁ : (algebraMap R' M_d s₀) ^ p₁.1 * x.1 = Φ_M p₁.2 :=
            Classical.choose_spec (hCond_s₀ x.1 x.2)
          let p₂ := Classical.choose (hCond_s₀ y.1 y.2)
          have hp₂ : (algebraMap R' M_d s₀) ^ p₂.1 * y.1 = Φ_M p₂.2 :=
            Classical.choose_spec (hCond_s₀ y.1 y.2)
          let H_add : Polynomial R' :=
            Polynomial.C (s₀ ^ p₂.1) * p₁.2 + Polynomial.C (s₀ ^ p₁.1) * p₂.2
          have hxy : (algebraMap R' M_d s₀) ^ (p₁.1 + p₂.1) * (x + y).1 = Φ_M H_add := by
            change (algebraMap R' M_d s₀) ^ (p₁.1 + p₂.1) * (x.1 + y.1) = Φ_M H_add
            dsimp [H_add]
            rw [Φ_M.map_add, Φ_M.map_mul, Φ_M.map_mul]
            have hc₁ : Φ_M (Polynomial.C (s₀ ^ p₁.1)) = (algebraMap R' M_d s₀) ^ p₁.1 := by
              rw [← map_pow]
              exact Polynomial.eval₂_C _ _
            have hc₂ : Φ_M (Polynomial.C (s₀ ^ p₂.1)) = (algebraMap R' M_d s₀) ^ p₂.1 := by
              rw [← map_pow]
              exact Polynomial.eval₂_C _ _
            rw [hc₁, hc₂, ← hp₁, ← hp₂, pow_add]
            ring
          rw [hφ_rep (x + y) (p₁.1 + p₂.1) H_add hxy,
            hφ_rep x p₁.1 p₁.2 hp₁, hφ_rep y p₂.1 p₂.2 hp₂]
          dsimp [H_add]
          rw [ev_XY.map_add, ev_XY.map_mul, ev_XY.map_mul]
          have hevc₁ : ev_XY (Polynomial.C (s₀ ^ p₁.1)) = σ_s₀ ^ p₁.1 := by
            dsimp [σ_s₀]
            rw [← map_pow]
            exact Polynomial.eval₂_C _ _
          have hevc₂ : ev_XY (Polynomial.C (s₀ ^ p₂.1)) = σ_s₀ ^ p₂.1 := by
            dsimp [σ_s₀]
            rw [← map_pow]
            exact Polynomial.eval₂_C _ _
          rw [hevc₁, hevc₂,
            div_add_div _ _ (pow_ne_zero p₁.1 hσ_s₀_ne) (pow_ne_zero p₂.1 hσ_s₀_ne), pow_add]
          exact congrArg (· / (σ_s₀ ^ p₁.1 * σ_s₀ ^ p₂.1)) (by ring) }
    refine ⟨φ, ?_, ?_, ?_⟩
    · intro P hP
      have hP_rep : (algebraMap R' M_d s₀) ^ 0 *
          (⟨algebraMap R' M_d P, hP⟩ : ↥B_sub).1 = Φ_M (Polynomial.C P) := by
        change (algebraMap R' M_d s₀) ^ 0 * algebraMap R' M_d P = Φ_M (Polynomial.C P)
        rw [pow_zero, one_mul]
        exact (Polynomial.eval₂_C _ _).symm
      change φ_fun ⟨algebraMap R' M_d P, hP⟩ = ev₀ x₀ P
      rw [hφ_rep ⟨algebraMap R' M_d P, hP⟩ 0 (Polynomial.C P) hP_rep, pow_zero, div_one]
      exact Polynomial.eval₂_C _ _
    · have hw_rep : (algebraMap R' M_d s₀) ^ 0 *
          (⟨w₀, (hModel ψ₀).1⟩ : ↥B_sub).1 = Φ_M Polynomial.X := by
        change (algebraMap R' M_d s₀) ^ 0 * w₀ = Φ_M Polynomial.X
        rw [pow_zero, one_mul]
        exact (Polynomial.eval₂_X _ _).symm
      change φ_fun ⟨w₀, (hModel ψ₀).1⟩ = y_bar
      rw [hφ_rep ⟨w₀, (hModel ψ₀).1⟩ 0 Polynomial.X hw_rep, pow_zero, div_one]
      exact Polynomial.eval₂_X _ _
    · intro P
      let P_E' : R' := (P.map (algebraMap F ↥E_sub)).map ι_EE'
      have hsub_eq : (⟨j_B (algebraMap (Polynomial F) B P),
          hBsub_gen.1 ⟨algebraMap (Polynomial F) B P, rfl⟩⟩ : ↥B_sub) =
          ⟨algebraMap R' M_d P_E', hBsub_gen.2.1 ⟨P_E', rfl⟩⟩ := by
        apply Subtype.ext
        dsimp [P_E']
        rw [hCompat.2 P, ← hCompat.1 (P.map (algebraMap F ↥E_sub))]
      have hPE'_rep : (algebraMap R' M_d s₀) ^ 0 *
          (⟨algebraMap R' M_d P_E', hBsub_gen.2.1 ⟨P_E', rfl⟩⟩ : ↥B_sub).1 =
          Φ_M (Polynomial.C P_E') := by
        change (algebraMap R' M_d s₀) ^ 0 * algebraMap R' M_d P_E' = Φ_M (Polynomial.C P_E')
        rw [pow_zero, one_mul]
        exact (Polynomial.eval₂_C _ _).symm
      rw [hsub_eq]
      change φ_fun ⟨algebraMap R' M_d P_E', hBsub_gen.2.1 ⟨P_E', rfl⟩⟩ =
        (Polynomial.aeval x₀ P : ↥E_sub).1
      rw [hφ_rep _ 0 (Polynomial.C P_E') hPE'_rep, pow_zero, div_one]
      have hev_C : ev_XY (Polynomial.C P_E') = ev₀ x₀ P_E' := Polynomial.eval₂_C _ _
      rw [hev_C]
      dsimp [P_E']
      rw [hev₀_map_EE' x₀, Polynomial.eval_map, ← Polynomial.aeval_def]

  haveI : IsScalarTower F R₀ B :=
    IsScalarTower.of_algebraMap_eq fun c => by
      rw [IsScalarTower.algebraMap_apply F (Polynomial F) R₀ c,
        ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B,
        ← IsScalarTower.algebraMap_apply F (Polynomial F) B]
  have hΔ_mon : Δ.Monic :=
    Polynomial.monic_prod_of_monic S_aff (fun s => Polynomial.X - Polynomial.C s)
      (fun s _ => Polynomial.monic_X_sub_C s)
  have hΔ_ne : Δ ≠ 0 := hΔ_mon.ne_zero
  have hpowers_le : Submonoid.powers Δ ≤ nonZeroDivisors (Polynomial F) :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hΔ_ne
  have hΔ_rat_ne : algebraMap (Polynomial F) (RatFunc F) Δ ≠ 0 :=
    (map_ne_zero_iff (algebraMap (Polynomial F) (RatFunc F))
      (IsFractionRing.injective (Polynomial F) (RatFunc F))).mpr hΔ_ne
  have hΔ_rat_unit : IsUnit (algebraMap (Polynomial F) (RatFunc F) Δ) :=
    IsUnit.mk0 _ hΔ_rat_ne
  letI : Algebra R₀ (RatFunc F) :=
    (IsLocalization.Away.lift Δ (S := R₀) hΔ_rat_unit).toAlgebra
  haveI : IsScalarTower (Polynomial F) R₀ (RatFunc F) :=
    IsScalarTower.of_algebraMap_eq fun P =>
      (IsLocalization.Away.lift_eq Δ (S := R₀) hΔ_rat_unit P).symm
  haveI : IsScalarTower R₀ (RatFunc F) L := by
    apply IsScalarTower.of_algebraMap_eq'
    apply IsLocalization.ringHom_ext (Submonoid.powers Δ)
    apply RingHom.ext
    intro P
    simp only [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (RatFunc F),
      ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L]
    rw [IsScalarTower.algebraMap_apply R₀ B L,
      ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B,
      ← IsScalarTower.algebraMap_apply (Polynomial F) B L]
  haveI : IsFractionRing R₀ (RatFunc F) :=
    IsFractionRing.isFractionRing_of_isLocalization (Submonoid.powers Δ) R₀ (RatFunc F) hpowers_le
  haveI : IsIntegrallyClosed R₀ :=
    isIntegrallyClosed_of_isLocalization R₀ (Submonoid.powers Δ) hpowers_le
  haveI : Finite (B ≃ₐ[R₀] B) := hFinAut
  haveI : Algebra.IsInvariant R₀ B (B ≃ₐ[R₀] B) :=
    Algebra.isInvariant_of_isGalois' R₀ (RatFunc F) L B

  have hGaloisLift : ∀ (x₀ : ↥E_sub) (φ_B : B →+* AlgebraicClosure F),
      (∀ s ∈ S_aff, x₀ ≠ algebraMap F ↥E_sub s) →
      (∀ P : Polynomial F, φ_B (algebraMap (Polynomial F) B P) = (Polynomial.aeval x₀ P : ↥E_sub).1) →
      let Q := RingHom.ker φ_B
      Q.IsMaximal ∧
      Ideal.comap (algebraMap (Polynomial F) B) Q = Ideal.span {minpoly F x₀} ∧
      ∃ η : Ω_d, ∀ b : B, φ_B (η.1 b) = (φ_B b) ^ N := by
    intro x₀ φ_B hx₀_S hφ_poly Q
    have hComap : Ideal.comap (algebraMap (Polynomial F) B) Q = Ideal.span {minpoly F x₀} := by
      ext f
      rw [Ideal.mem_comap, RingHom.mem_ker, hφ_poly f, Ideal.mem_span_singleton, minpoly.dvd_iff]
      exact ⟨fun h => Subtype.ext h, fun h => congrArg Subtype.val h⟩
    have hΔ_x₀_ne : (Polynomial.aeval x₀).toRingHom Δ ≠ 0 := by
      change Polynomial.aeval x₀ (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s)) ≠ 0
      rw [map_prod, Finset.prod_ne_zero_iff]
      intro s hs
      rw [map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
      exact sub_ne_zero.mpr (hx₀_S s hs)
    have hΔ_x₀_unit : IsUnit ((Polynomial.aeval x₀).toRingHom Δ) :=
      IsUnit.mk0 _ hΔ_x₀_ne
    let ev_R₀_ring : R₀ →+* ↥E_sub :=
      IsLocalization.Away.lift Δ (S := R₀) hΔ_x₀_unit
    have hev_R₀_eq : ∀ P : Polynomial F,
        ev_R₀_ring (algebraMap (Polynomial F) R₀ P) = Polynomial.aeval x₀ P :=
      fun P => IsLocalization.Away.lift_eq Δ (S := R₀) hΔ_x₀_unit P
    let ev_R₀ : R₀ →ₐ[F] ↥E_sub :=
      { ev_R₀_ring with
        commutes' := fun c => by
          change ev_R₀_ring (algebraMap F R₀ c) = algebraMap F ↥E_sub c
          rw [IsScalarTower.algebraMap_apply F (Polynomial F) R₀ c, hev_R₀_eq]
          exact (Polynomial.aeval x₀).commutes c }
    have hφ_R₀ : ∀ r : R₀, φ_B (algebraMap R₀ B r) = (ev_R₀ r).1 := by
      have hEq : φ_B.comp (algebraMap R₀ B) = E_sub.val.toRingHom.comp ev_R₀_ring := by
        apply IsLocalization.ringHom_ext (Submonoid.powers Δ)
        apply RingHom.ext
        intro P
        simp only [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B]
        rw [hφ_poly P, hev_R₀_eq]
        rfl
      intro r
      exact RingHom.congr_fun hEq r
    obtain ⟨s_gen, hs_gen⟩ := Module.Finite.fg_top (R := R₀) (M := B)
    let Ψ : (↥s_gen → ↥E_sub) → AlgebraicClosure F :=
      fun f => ∑ g ∈ s_gen.attach, (f g).1 * φ_B g.1
    have hRange_sub : (φ_B.range : Set (AlgebraicClosure F)) ⊆ Set.range Ψ := by
      rintro y ⟨b, rfl⟩
      have hb_mem : b ∈ Submodule.span R₀ (s_gen : Set B) := by
        rw [hs_gen]
        trivial
      obtain ⟨c, _, hc⟩ := Submodule.mem_span_finset.mp hb_mem
      refine ⟨fun g => ev_R₀ (c g.1), ?_⟩
      dsimp [Ψ]
      have hb_sum : φ_B b = ∑ g ∈ s_gen, (ev_R₀ (c g)).1 * φ_B g := by
        rw [← hc, map_sum]
        apply Finset.sum_congr rfl
        intro g _
        rw [Algebra.smul_def, map_mul, hφ_R₀]
      rw [hb_sum, ← Finset.sum_attach s_gen (fun g => (ev_R₀ (c g)).1 * φ_B g)]
    have hFin_range_set : Set.Finite (φ_B.range : Set (AlgebraicClosure F)) :=
      (Set.finite_range Ψ).subset hRange_sub
    haveI : Finite ↥φ_B.range := hFin_range_set.to_subtype
    haveI : Finite (B ⧸ Q) :=
      Finite.of_equiv ↥φ_B.range (RingHom.quotientKerEquivRange φ_B).symm.toEquiv
    haveI : Q.IsPrime := RingHom.ker_isPrime φ_B
    haveI : IsDomain (B ⧸ Q) := Ideal.Quotient.isDomain Q
    have hQ_max : Q.IsMaximal :=
      Ideal.Quotient.maximal_of_isField Q (Finite.isField_of_domain (B ⧸ Q))
    have hunder_eq : Ideal.under R₀ Q = RingHom.ker ev_R₀.toRingHom := by
      ext r
      rw [Ideal.under_def, Ideal.mem_comap, RingHom.mem_ker, RingHom.mem_ker, hφ_R₀ r]
      exact ⟨fun h => Subtype.ext h, fun h => congrArg Subtype.val h⟩
    let S_alg : Subalgebra F ↥E_sub := ev_R₀.range
    have hField_S : IsField ↥S_alg := Finite.isField_of_domain ↥S_alg
    have hinv_S : ∀ x ∈ S_alg, x⁻¹ ∈ S_alg := by
      intro x hx
      by_cases hx0 : x = 0
      · rw [hx0, inv_zero]
        exact S_alg.zero_mem
      · have hx_sub_ne : (⟨x, hx⟩ : ↥S_alg) ≠ 0 := fun h => hx0 (congrArg Subtype.val h)
        obtain ⟨y, hy⟩ := hField_S.mul_inv_cancel hx_sub_ne
        have hxy : x * y.1 = 1 := congrArg Subtype.val hy
        have hinv_eq : x⁻¹ = y.1 := inv_eq_of_mul_eq_one_right hxy
        rw [hinv_eq]
        exact y.2
    let K₀ : IntermediateField F ↥E_sub := S_alg.toIntermediateField hinv_S
    obtain ⟨e₀, he₀⟩ := hSub_pow K₀
    let q₀ : ℕ := Nat.card (R₀ ⧸ Ideal.under R₀ Q)
    have hq₀_eq : q₀ = Nat.card ↥K₀ := by
      dsimp [q₀]
      rw [hunder_eq, Nat.card_congr (RingHom.quotientKerEquivRange ev_R₀.toRingHom).toEquiv]
      apply Nat.card_congr
      refine Equiv.subtypeEquivRight fun x => ?_
      have hmem1 : x ∈ ev_R₀.toRingHom.range ↔ x ∈ S_alg := Iff.rfl
      have hmem2 : x ∈ K₀.toSubalgebra ↔ x ∈ S_alg := by
        rw [toSubalgebra_toIntermediateField]
      rw [hmem1, ← hmem2, IntermediateField.mem_toSubalgebra]
    have hq₀_pow : q₀ ^ e₀ = N := by
      rw [hq₀_eq]
      exact he₀
    obtain ⟨τ, hτ⟩ := IsArithFrobAt.exists_of_isInvariant R₀ (B ≃ₐ[R₀] B) Q
    have hτ_apply : ∀ b : B, φ_B (τ b) = (φ_B b) ^ q₀ := by
      intro b
      have hmk : Ideal.Quotient.mk Q (τ b) = Ideal.Quotient.mk Q (b ^ q₀) := by
        rw [map_pow]
        exact AlgHom.IsArithFrobAt.mk_apply hτ b
      have hsub : τ b - b ^ q₀ ∈ Q := Ideal.Quotient.eq.mp hmk
      have hker : φ_B (τ b - b ^ q₀) = 0 := hsub
      rw [map_sub, map_pow, sub_eq_zero] at hker
      exact hker
    have hτ_pow : ∀ (m : ℕ) (b : B), φ_B ((τ ^ m) b) = (φ_B b) ^ (q₀ ^ m) := by
      intro m
      induction m with
      | zero =>
        intro b
        simp
      | succ m ih =>
        intro b
        rw [pow_succ', AlgEquiv.mul_apply, hτ_apply, ih b, ← pow_mul, ← pow_succ]
    let η_raw : B ≃ₐ[R₀] B := τ ^ e₀
    have hη_φ : ∀ b : B, φ_B (η_raw b) = (φ_B b) ^ N := by
      intro b
      rw [hτ_pow e₀ b, hq₀_pow]
    have hη_int : ∀ x : B, IsIntegral F x → η_raw x = x ^ N := by
      intro x hx
      let η_F : B →ₐ[F] B :=
        { η_raw.toRingHom with
          commutes' := fun c => by
            change η_raw (algebraMap F B c) = algebraMap F B c
            rw [IsScalarTower.algebraMap_apply F R₀ B c]
            exact η_raw.commutes (algebraMap F R₀ c) }
      have hx_η : IsIntegral F (η_raw x) := IsIntegral.map η_F hx
      have hx_pow : IsIntegral F (x ^ N) := hx.pow N
      let z : B := η_raw x - x ^ N
      have hz_int : IsIntegral F z := hx_η.sub hx_pow
      have hz_φ : φ_B z = 0 := by
        dsimp [z]
        rw [map_sub, hη_φ x, map_pow, sub_self]
      suffices hz0 : z = 0 by
        exact sub_eq_zero.mp hz0
      by_contra hz_ne
      let p : Polynomial F := minpoly F z
      have hp_mon : p.Monic := minpoly.monic hz_int
      have hp_ne : p ≠ 0 := hp_mon.ne_zero
      have hp0_ne : p.coeff 0 ≠ 0 := by
        intro hp0
        obtain ⟨q, hq⟩ := Polynomial.X_dvd_iff.mpr hp0
        have hq_ne : q ≠ 0 := by
          intro hq0
          rw [hq0, mul_zero] at hq
          exact hp_ne hq
        have hp_eval : Polynomial.aeval z p = 0 := minpoly.aeval F z
        rw [hq, map_mul, Polynomial.aeval_X, mul_eq_zero] at hp_eval
        have hq_eval : Polynomial.aeval z q = 0 := hp_eval.resolve_left hz_ne
        have hp_dvd_q : p ∣ q := minpoly.dvd F z hq_eval
        have hdeg_le : p.natDegree ≤ q.natDegree := Polynomial.natDegree_le_of_dvd hp_dvd_q hq_ne
        have hdeg_eq : p.natDegree = (Polynomial.X : Polynomial F).natDegree + q.natDegree := by
          rw [hq]
          exact Polynomial.natDegree_mul Polynomial.X_ne_zero hq_ne
        rw [Polynomial.natDegree_X] at hdeg_eq
        omega
      have hp_decomp : p.divX * Polynomial.X + Polynomial.C (p.coeff 0) = p :=
        Polynomial.divX_mul_X_add p
      have hp_eval : Polynomial.aeval z p = 0 := minpoly.aeval F z
      rw [← hp_decomp, map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at hp_eval
      have hφ_eval : φ_B (Polynomial.aeval z p.divX * z + algebraMap F B (p.coeff 0)) = 0 := by
        rw [hp_eval, φ_B.map_zero]
      rw [φ_B.map_add, φ_B.map_mul, hz_φ, mul_zero, zero_add] at hφ_eval
      have hinj : Function.Injective (φ_B.comp (algebraMap F B)) := RingHom.injective _
      exact hp0_ne (hinj (hφ_eval.trans (φ_B.comp (algebraMap F B)).map_zero.symm))
    exact ⟨hQ_max, hComap, ⟨⟨η_raw, hη_int⟩, hη_φ⟩⟩

  have hCondUnique : ∀ (η : Ω_d) (ev' : R' →+* AlgebraicClosure F)
      (ψ₁ ψ₂ : ↥B_sub →+* AlgebraicClosure F),
      ev' Δ_R' ≠ 0 →
      ev' ((δ_fam η).map ι_EE') ≠ 0 →
      (∀ (P : R') (hP : algebraMap R' M_d P ∈ B_sub),
        ψ₁ ⟨algebraMap R' M_d P, hP⟩ = ev' P ∧ ψ₂ ⟨algebraMap R' M_d P, hP⟩ = ev' P) →
      ψ₁ ⟨w_fam η, (hModel η).1⟩ = ψ₂ ⟨w_fam η, (hModel η).1⟩ →
      ψ₁ = ψ₂ := by
    intro η ev' ψ₁ ψ₂ hΔ_ev' hδ_ev' hR'_eq hw_eq
    ext u
    obtain ⟨m, r, hr⟩ := hCond η u.1 u.2
    let δ_R' : R' := (δ_fam η).map ι_EE'
    let Δ_sub : ↥B_sub := ⟨algebraMap R' M_d Δ_R', hBsub_gen.2.1 ⟨Δ_R', rfl⟩⟩
    let δ_sub : ↥B_sub := ⟨algebraMap R' M_d δ_R', hBsub_gen.2.1 ⟨δ_R', rfl⟩⟩
    let w_sub : ↥B_sub := ⟨w_fam η, (hModel η).1⟩
    let r_sub : Fin N_geom → ↥B_sub :=
      fun j => ⟨algebraMap R' M_d (r j), hBsub_gen.2.1 ⟨r j, rfl⟩⟩
    have hr_sub : (Δ_sub ^ m * δ_sub) * u = ∑ j : Fin N_geom, r_sub j * w_sub ^ (j : ℕ) := by
      apply B_sub.subtype_injective
      rw [map_mul, map_mul, map_pow, map_sum]
      simp only [map_mul, map_pow]
      exact hr
    have h₁ := congrArg ψ₁ hr_sub
    have h₂ := congrArg ψ₂ hr_sub
    simp only [map_mul, map_pow, map_sum] at h₁ h₂
    rw [(hR'_eq Δ_R' _).1, (hR'_eq δ_R' _).1] at h₁
    rw [(hR'_eq Δ_R' _).2, (hR'_eq δ_R' _).2] at h₂
    have hrhs_eq : (∑ j : Fin N_geom, ψ₁ (r_sub j) * ψ₁ w_sub ^ (j : ℕ)) =
        ∑ j : Fin N_geom, ψ₂ (r_sub j) * ψ₂ w_sub ^ (j : ℕ) := by
      apply Finset.sum_congr rfl
      intro j _
      rw [(hR'_eq (r j) _).1, (hR'_eq (r j) _).2, hw_eq]
    have hmul_eq : (ev' Δ_R' ^ m * ev' δ_R') * ψ₁ u = (ev' Δ_R' ^ m * ev' δ_R') * ψ₂ u := by
      rw [h₁, hrhs_eq, ← h₂]
    exact mul_left_cancel₀ (mul_ne_zero (pow_ne_zero m hΔ_ev') hδ_ev') hmul_eq

  have hForwardRoot : ∀ (x₀ : ↥E_sub) (η : Ω_d) (φ : ↥B_sub →+* AlgebraicClosure F),
      (∀ (P : R') (hP : algebraMap R' M_d P ∈ B_sub),
        φ ⟨algebraMap R' M_d P, hP⟩ = ev₀ x₀ P) →
      (∀ b : B,
        φ ⟨j_B (η.1 b), hBsub_gen.1 ⟨η.1 b, rfl⟩⟩ =
          (φ ⟨j_B b, hBsub_gen.1 ⟨b, rfl⟩⟩) ^ N) →
      ∃ y₀ : ↥E_sub,
        y₀.1 = φ ⟨w_fam η, (hModel η).1⟩ ∧
        ((G_fam η).map (Polynomial.evalRingHom x₀)).eval y₀ = 0 := by
    intro x₀ η φ hφ_R' hφ_B_frob
    let t_sub : ↥B_sub →+* ↥B_sub :=
      (twist η).restrict B_sub B_sub (hTwist η).2.2
    let ψ₁ : ↥B_sub →+* AlgebraicClosure F := φ.comp t_sub
    let ψ₂ : ↥B_sub →+* AlgebraicClosure F := Frob_N.comp φ
    let S_eq : Subring M_d := (RingHom.eqLocus ψ₁ ψ₂).map B_sub.subtype
    have hB_le_Seq : B_sub ≤ S_eq := by
      rw [← hBsub_gen.2.2, Subring.closure_le]
      rintro u (⟨b, rfl⟩ | ⟨c, rfl⟩)
      · let u_sub : ↥B_sub := ⟨j_B b, hBsub_gen.1 ⟨b, rfl⟩⟩
        refine ⟨u_sub, ?_, rfl⟩
        change φ (t_sub u_sub) = Frob_N (φ u_sub)
        have htsub : t_sub u_sub = ⟨j_B (η.1 b), hBsub_gen.1 ⟨η.1 b, rfl⟩⟩ := by
          apply Subtype.ext
          exact (hTwist η).1 b
        rw [htsub, hφ_B_frob b, hFrob_N_apply]
      · let u_sub : ↥B_sub :=
          ⟨algebraMap R' M_d (Polynomial.C c), hBsub_gen.2.1 ⟨Polynomial.C c, rfl⟩⟩
        refine ⟨u_sub, ?_, rfl⟩
        change φ (t_sub u_sub) = Frob_N (φ u_sub)
        have htsub : t_sub u_sub =
            ⟨algebraMap R' M_d ((Polynomial.C c).map Φ_d.toRingHom),
              hBsub_gen.2.1 ⟨(Polynomial.C c).map Φ_d.toRingHom, rfl⟩⟩ := by
          apply Subtype.ext
          exact (hTwist η).2.1 (Polynomial.C c)
        rw [htsub, hφ_R', hφ_R', hev₀_Phi_d x₀ (Polynomial.C c)]
    let w_sub : ↥B_sub := ⟨w_fam η, (hModel η).1⟩
    obtain ⟨v_sub, hv_eq, hv_val⟩ := hB_le_Seq (hModel η).1
    have hvw : v_sub = w_sub := Subtype.ext hv_val
    rw [hvw] at hv_eq
    have htw : t_sub w_sub = w_sub := by
      apply Subtype.ext
      exact (hModel η).2.1
    have hw_frob : (φ w_sub) ^ N = φ w_sub := by
      have h1 : ψ₁ w_sub = ψ₂ w_sub := hv_eq
      change φ (t_sub w_sub) = Frob_N (φ w_sub) at h1
      rw [htw, hFrob_N_apply] at h1
      exact h1.symm
    let y₀ : ↥E_sub := ⟨φ w_sub, (hE_mem (φ w_sub)).mpr hw_frob⟩
    refine ⟨y₀, rfl, ?_⟩
    have hPE_mem : ∀ P : Polynomial ↥E_sub, algebraMap (Polynomial ↥E_sub) M_d P ∈ B_sub := by
      intro P
      rw [← hCompat.1 P]
      exact hBsub_gen.2.1 ⟨P.map ι_EE', rfl⟩
    let ι_PE : Polynomial ↥E_sub →+* ↥B_sub :=
      (algebraMap (Polynomial ↥E_sub) M_d).codRestrict B_sub hPE_mem
    have hG_sub : ((G_fam η).map ι_PE).eval w_sub = 0 := by
      apply B_sub.subtype_injective
      rw [map_zero, ← Polynomial.eval_map_apply B_sub.subtype w_sub, Polynomial.map_map]
      have hcomp : B_sub.subtype.comp ι_PE = algebraMap (Polynomial ↥E_sub) M_d :=
        RingHom.ext fun _ => rfl
      rw [hcomp]
      exact (hModel η).2.2.2.2.1
    have hG_φ := congrArg φ hG_sub
    rw [map_zero, ← Polynomial.eval_map_apply φ w_sub, Polynomial.map_map] at hG_φ
    have hcomp_φ : φ.comp ι_PE = E_sub.val.toRingHom.comp (Polynomial.evalRingHom x₀) := by
      apply RingHom.ext
      intro P
      simp only [RingHom.comp_apply]
      have hι_eq : ι_PE P = ⟨algebraMap R' M_d (P.map ι_EE'), hBsub_gen.2.1 ⟨P.map ι_EE', rfl⟩⟩ := by
        apply Subtype.ext
        exact (hCompat.1 P).symm
      rw [hι_eq, hφ_R', hev₀_map_EE' x₀ P]
      rfl
    rw [hcomp_φ] at hG_φ
    change (((G_fam η).map (E_sub.val.toRingHom.comp (Polynomial.evalRingHom x₀))).eval
      (E_sub.val.toRingHom y₀)) = 0 at hG_φ
    rw [← Polynomial.map_map, Polynomial.eval_map_apply] at hG_φ
    exact Subtype.ext hG_φ

  refine ⟨?_, ?_⟩
  · intro x₀ hx₀_S hx₀_δ
    let g_bar : Polynomial (AlgebraicClosure F) :=
      (G_fam ψ₀).map (Polynomial.aeval (x₀.1 : AlgebraicClosure F)).toRingHom
    obtain ⟨hNodup, hCard_roots⟩ := hRoots x₀ (hx₀_δ ψ₀)
    let S_roots : Finset (AlgebraicClosure F) := g_bar.roots.toFinset
    have hS_card : S_roots.card = N_geom :=
      (Multiset.toFinset_card_of_nodup hNodup).trans hCard_roots
    have hr_eval : ∀ r : ↥S_roots, g_bar.eval r.1 = 0 := by
      intro r
      exact Polynomial.isRoot_of_mem_roots (Multiset.mem_toFinset.mp r.2)
    have hr_spec : ∀ r : ↥S_roots,
        ∃ φ : ↥B_sub →+* AlgebraicClosure F,
          (∀ (P : R') (hP : algebraMap R' M_d P ∈ B_sub),
            φ ⟨algebraMap R' M_d P, hP⟩ = ev₀ x₀ P) ∧
          φ ⟨w₀, (hModel ψ₀).1⟩ = r.1 ∧
          ∀ P : Polynomial F,
            φ ⟨j_B (algebraMap (Polynomial F) B P),
              hBsub_gen.1 ⟨algebraMap (Polynomial F) B P, rfl⟩⟩ =
              (Polynomial.aeval x₀ P : ↥E_sub).1 :=
      fun r => hexists_eval x₀ r.1 hx₀_S (hx₀_δ ψ₀) (hr_eval r)
    let φ_r : ↥S_roots → (↥B_sub →+* AlgebraicClosure F) :=
      fun r => Classical.choose (hr_spec r)
    have hφ_r : ∀ r : ↥S_roots,
        (∀ (P : R') (hP : algebraMap R' M_d P ∈ B_sub),
          φ_r r ⟨algebraMap R' M_d P, hP⟩ = ev₀ x₀ P) ∧
        φ_r r ⟨w₀, (hModel ψ₀).1⟩ = r.1 ∧
        ∀ P : Polynomial F,
          φ_r r ⟨j_B (algebraMap (Polynomial F) B P),
            hBsub_gen.1 ⟨algebraMap (Polynomial F) B P, rfl⟩⟩ =
            (Polynomial.aeval x₀ P : ↥E_sub).1 :=
      fun r => Classical.choose_spec (hr_spec r)
    let j_B_sub : B →+* ↥B_sub :=
      j_B.codRestrict B_sub fun b => hBsub_gen.1 ⟨b, rfl⟩
    let φ_Br : ↥S_roots → (B →+* AlgebraicClosure F) :=
      fun r => (φ_r r).comp j_B_sub
    have hη_ex : ∀ r : ↥S_roots, ∃ η : Ω_d, ∀ b : B, φ_Br r (η.1 b) = (φ_Br r b) ^ N :=
      fun r => (hGaloisLift x₀ (φ_Br r) hx₀_S (hφ_r r).2.2).2.2
    let η_r : ↥S_roots → Ω_d := fun r => Classical.choose (hη_ex r)
    have hη_r : ∀ (r : ↥S_roots) (b : B), φ_Br r ((η_r r).1 b) = (φ_Br r b) ^ N :=
      fun r => Classical.choose_spec (hη_ex r)
    have hy_ex : ∀ r : ↥S_roots,
        ∃ y₀ : ↥E_sub,
          y₀.1 = φ_r r ⟨w_fam (η_r r), (hModel (η_r r)).1⟩ ∧
          ((G_fam (η_r r)).map (Polynomial.evalRingHom x₀)).eval y₀ = 0 :=
      fun r => hForwardRoot x₀ (η_r r) (φ_r r) (hφ_r r).1 (hη_r r)
    let y_r : ↥S_roots → ↥E_sub := fun r => Classical.choose (hy_ex r)
    have hy_r : ∀ r : ↥S_roots,
        (y_r r).1 = φ_r r ⟨w_fam (η_r r), (hModel (η_r r)).1⟩ ∧
        ((G_fam (η_r r)).map (Polynomial.evalRingHom x₀)).eval (y_r r) = 0 :=
      fun r => Classical.choose_spec (hy_ex r)
    let SmFib : Ω_d → Type u := fun η =>
      { y₀ : ↥E_sub //
        ((G_fam η).map (Polynomial.evalRingHom x₀)).eval y₀ = 0 ∧
        ((Polynomial.derivative (G_fam η)).map (Polynomial.evalRingHom x₀)).eval y₀ ≠ 0 }
    let ι_fib : ↥S_roots → Σ i : Fin N_geom, SmFib (e_Ω i) := fun r =>
      ⟨e_Ω.symm (η_r r), ⟨y_r r, by
        rw [e_Ω.apply_symm_apply]
        exact ⟨(hy_r r).2, hSmooth (η_r r) x₀ (y_r r) (hx₀_δ (η_r r)) (hy_r r).2⟩⟩⟩
    have hι_inj : Function.Injective ι_fib := by
      intro r₁ r₂ h_eq
      have h_idx : e_Ω.symm (η_r r₁) = e_Ω.symm (η_r r₂) := congrArg Sigma.fst h_eq
      have h_η : η_r r₁ = η_r r₂ := e_Ω.symm.injective h_idx
      have h_y : y_r r₁ = y_r r₂ :=
        congrArg (fun p : (Σ i : Fin N_geom, SmFib (e_Ω i)) => p.2.1) h_eq
      let η := η_r r₁
      have hw_eq : φ_r r₁ ⟨w_fam η, (hModel η).1⟩ = φ_r r₂ ⟨w_fam η, (hModel η).1⟩ := by
        have h1 : (y_r r₁).1 = φ_r r₁ ⟨w_fam η, (hModel η).1⟩ := (hy_r r₁).1
        have h2 : (y_r r₂).1 = φ_r r₂ ⟨w_fam (η_r r₂), (hModel (η_r r₂)).1⟩ := (hy_r r₂).1
        have hsub : (⟨w_fam (η_r r₂), (hModel (η_r r₂)).1⟩ : ↥B_sub) =
            ⟨w_fam η, (hModel η).1⟩ := by
          apply Subtype.ext
          dsimp [η]
          rw [h_η]
        rw [hsub] at h2
        rw [← h1, ← h2, h_y]
      have hφ_eq : φ_r r₁ = φ_r r₂ :=
        hCondUnique η (ev₀ x₀) (φ_r r₁) (φ_r r₂)
          (hev₀_Δ_ne x₀ hx₀_S)
          (hev₀_δ_ne x₀ (δ_fam η) (hx₀_δ η))
          (fun P hP => ⟨(hφ_r r₁).1 P hP, (hφ_r r₂).1 P hP⟩)
          hw_eq
      apply Subtype.ext
      rw [← (hφ_r r₁).2.1, ← (hφ_r r₂).2.1, hφ_eq]
    letI : ∀ i : Fin N_geom, Fintype (SmFib (e_Ω i)) :=
      fun i => Fintype.ofFinite (SmFib (e_Ω i))
    have hcard_le : Fintype.card ↥S_roots ≤ Fintype.card (Σ i : Fin N_geom, SmFib (e_Ω i)) :=
      Fintype.card_le_of_injective ι_fib hι_inj
    rw [Fintype.card_coe, hS_card, Fintype.card_sigma] at hcard_le
    refine hcard_le.trans_eq ?_
    apply Finset.sum_congr rfl
    intro i _
    exact (Nat.card_eq_fintype_card (α := SmFib (e_Ω i))).symm
  · intro x₀ y₀ hx₀_S hx₀_δ0 hx₀_prim hy₀_eval
    let P : Polynomial F := minpoly F x₀
    have hP_good : IsGoodAffineCurveClosedPointPoly S_aff d P :=
      hGood_minpoly x₀ hx₀_S hx₀_prim
    have hy₀_bar : ((G₀.map (Polynomial.aeval (x₀.1 : AlgebraicClosure F)).toRingHom).eval y₀.1) = 0 := by
      have haeval_eq : (Polynomial.aeval (x₀.1 : AlgebraicClosure F)).toRingHom =
          E_sub.val.toRingHom.comp (Polynomial.evalRingHom x₀) := by
        apply RingHom.ext
        intro Q
        simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, RingHom.comp_apply,
          Polynomial.coe_evalRingHom, Polynomial.aeval_def]
        exact (Polynomial.hom_eval₂ Q (RingHom.id ↥E_sub)
          (algebraMap ↥E_sub (AlgebraicClosure F)) x₀).symm
      rw [haeval_eq, ← Polynomial.map_map]
      change (((G₀.map (Polynomial.evalRingHom x₀)).map E_sub.val.toRingHom).eval
        (E_sub.val.toRingHom y₀)) = 0
      rw [Polynomial.eval_map_apply]
      dsimp [G₀]
      rw [hy₀_eval]
      rfl
    obtain ⟨φ, hφ_R', hφ_w₀, hφ_poly⟩ := hexists_eval x₀ y₀.1 hx₀_S hx₀_δ0 hy₀_bar
    let j_B_sub : B →+* ↥B_sub :=
      j_B.codRestrict B_sub fun b => hBsub_gen.1 ⟨b, rfl⟩
    let φ_B : B →+* AlgebraicClosure F := φ.comp j_B_sub
    let Q₀ : Ideal B := RingHom.ker φ_B
    obtain ⟨hQ₀_max, hQ₀_comap, _⟩ := hGaloisLift x₀ φ_B hx₀_S hφ_poly
    let t_sub : ↥B_sub →+* ↥B_sub :=
      (twist ψ₀).restrict B_sub B_sub (hTwist ψ₀).2.2
    let ψ₁ : ↥B_sub →+* AlgebraicClosure F := φ.comp t_sub
    let ψ₂ : ↥B_sub →+* AlgebraicClosure F := Frob_N.comp φ
    let ev' : R' →+* AlgebraicClosure F := Frob_N.comp (ev₀ x₀)
    have hev'_Δ : ev' Δ_R' ≠ 0 := by
      change Frob_N (ev₀ x₀ Δ_R') ≠ 0
      rw [hFrob_N_apply]
      exact pow_ne_zero N (hev₀_Δ_ne x₀ hx₀_S)
    have hev'_δ : ev' (δ₀.map ι_EE') ≠ 0 := by
      change Frob_N (ev₀ x₀ (δ₀.map ι_EE')) ≠ 0
      rw [hFrob_N_apply]
      exact pow_ne_zero N (hev₀_δ_ne x₀ δ₀ hx₀_δ0)
    have hR'_ψ : ∀ (Q : R') (hQ : algebraMap R' M_d Q ∈ B_sub),
        ψ₁ ⟨algebraMap R' M_d Q, hQ⟩ = ev' Q ∧ ψ₂ ⟨algebraMap R' M_d Q, hQ⟩ = ev' Q := by
      intro Q hQ
      refine ⟨?_, ?_⟩
      · change φ (t_sub ⟨algebraMap R' M_d Q, hQ⟩) = Frob_N (ev₀ x₀ Q)
        have htsub : t_sub ⟨algebraMap R' M_d Q, hQ⟩ =
            ⟨algebraMap R' M_d (Q.map Φ_d.toRingHom),
              hBsub_gen.2.1 ⟨Q.map Φ_d.toRingHom, rfl⟩⟩ := by
          apply Subtype.ext
          exact (hTwist ψ₀).2.1 Q
        rw [htsub, hφ_R', hev₀_Phi_d x₀ Q]
      · change Frob_N (φ ⟨algebraMap R' M_d Q, hQ⟩) = Frob_N (ev₀ x₀ Q)
        rw [hφ_R']
    have hw_ψ : ψ₁ ⟨w₀, (hModel ψ₀).1⟩ = ψ₂ ⟨w₀, (hModel ψ₀).1⟩ := by
      change φ (t_sub ⟨w₀, (hModel ψ₀).1⟩) = Frob_N (φ ⟨w₀, (hModel ψ₀).1⟩)
      have htsub : t_sub ⟨w₀, (hModel ψ₀).1⟩ = ⟨w₀, (hModel ψ₀).1⟩ := by
        apply Subtype.ext
        exact (hModel ψ₀).2.1
      rw [htsub, hφ_w₀, hFrob_N_apply, (hE_mem y₀.1).mp y₀.2]
    have hψ_eq : ψ₁ = ψ₂ := hCondUnique ψ₀ ev' ψ₁ ψ₂ hev'_Δ hev'_δ hR'_ψ hw_ψ
    refine ⟨P, Q₀, hP_good, hQ₀_max, hQ₀_comap, fun b => ?_⟩
    rw [RingHom.mem_ker, map_sub, map_pow, sub_eq_zero]
    have hb_eq := RingHom.congr_fun hψ_eq ⟨j_B b, hBsub_gen.1 ⟨b, rfl⟩⟩
    change φ (t_sub ⟨j_B b, hBsub_gen.1 ⟨b, rfl⟩⟩) =
      Frob_N (φ ⟨j_B b, hBsub_gen.1 ⟨b, rfl⟩⟩) at hb_eq
    have htsub_b : t_sub ⟨j_B b, hBsub_gen.1 ⟨b, rfl⟩⟩ =
        ⟨j_B (σ₀.symm b), hBsub_gen.1 ⟨σ₀.symm b, rfl⟩⟩ := by
      apply Subtype.ext
      exact (hTwist ψ₀).1 b
    rw [htsub_b, hFrob_N_apply] at hb_eq
    exact hb_eq

theorem weil_etale_speiser_twist_curve_partition (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (B L : Type u) [CommRing B] [IsDomain B] [Field L]
    [Algebra F B] [Algebra (Polynomial F) B]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [Algebra F L] [Algebra (Polynomial F) L] [Algebra (RatFunc F) L]
    [Algebra B L]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L]
    [IsScalarTower F (Polynomial F) B]
    [IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [IsScalarTower F (RatFunc F) L]
    [IsScalarTower (Polynomial F) (RatFunc F) L]
    [IsScalarTower (Polynomial F) B L]
    [IsScalarTower
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B L]
    [Module.Finite
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [Algebra.Etale
