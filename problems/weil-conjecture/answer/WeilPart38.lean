        exact ((hSlice_bridge G_R).2 Ψ_R).1 hInj_Ψ_UΩ H_η hPb_j

      have hCard_W₀ : ∀ (K : Type u) [Field K] [IsAlgClosed K]
          (z : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ W₀)
          (H_z : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback z G_W H_z →
          Finite (H_z.H 0) ∧ Nat.card (H_z.H 0) ≤ Nat.card ↥M₀ := by
        intro K _ _ z H_z hPb_z
        have hPb_zG : WeilIsEtaleSheafPullback ((z ≫ w₀) ≫ ι'_a) G H_z := by
          rw [CategoryTheory.Category.assoc]
          exact (hPbComp z (w₀ ≫ ι'_a) G G_W H_z).1 hPb_GW_G hPb_z
        obtain ⟨hFin_z, hEq_z⟩ := hAllChartCard ι'_a hι'_hom (z ≫ w₀) H_z hPb_zG
        refine ⟨hFin_z, ?_⟩
        rw [hEq_z, hCard_M₀, hCard_H₀]

      have _ : CategoryTheory.IsIso Φ :=
        weil_cosp_curve_dense_generic_ker_zero_and_card_le_iso
          W₀ Ω (j_Rbar ≫ g_W) hDense_ηW M₀ G_W Φ hKer_ηW hCard_W₀

      
      have hCard_M₀_A₀ : Nat.card ↥M₀ = Nat.card ↥A₀ := hCard_M₀.trans hCard_H₀
      have hPrime : Nat.Prime ℓ := Fact.out
      obtain ⟨e_MA⟩ : Nonempty (M₀ ≅ A₀) := by
        rcases Nat.exists_eq_succ_of_ne_zero hPrime.ne_zero with ⟨ℓ', rfl⟩
        let _ : Module (ZMod (ℓ' + 1)) ↥M₀ :=
          AddCommGroup.zmodModule fun m => congrArg (fun f : M₀ ⟶ M₀ => f m) hTors_M₀
        let _ : Module (ZMod (ℓ' + 1)) ↥A₀ :=
          AddCommGroup.zmodModule fun m => congrArg (fun f : A₀ ⟶ A₀ => f m) hTors_A₀
        have _ : Module.Finite (ZMod (ℓ' + 1)) ↥M₀ := Module.Finite.of_finite
        have _ : Module.Finite (ZMod (ℓ' + 1)) ↥A₀ := Module.Finite.of_finite
        have hcM : Nat.card ↥M₀ =
            Nat.card (ZMod (ℓ' + 1)) ^ Module.finrank (ZMod (ℓ' + 1)) ↥M₀ :=
          Module.natCard_eq_pow_finrank
        have hcA : Nat.card ↥A₀ =
            Nat.card (ZMod (ℓ' + 1)) ^ Module.finrank (ZMod (ℓ' + 1)) ↥A₀ :=
