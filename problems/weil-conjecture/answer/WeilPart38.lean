      have : AlgebraicGeometry.Etale (u_can (f_z z)) := hu_can_et (f_z z)
      exact (u_can (f_z z)).isOpenMap _ (((x (f_z z) (hf_z z)).hom m).1.isLocallyConstant S_set)
    have hf_m_equiv : ∀ (m : ↥M), ⟨f_m m, hf_m_lc m⟩ ∈ E_sub W := by
      intro m σ z
