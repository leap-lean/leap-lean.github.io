      let h_W := (FgtU.obj W).hom
      let W_V := CategoryTheory.Limits.pullback h_W π
      Function.Injective (triv W) ∧
      Set.range (triv W) =
        { f | ∀ (σ : S ≃ₐ[R] S) (m_σ : Quiver.Hom W_V W_V),
          m_σ ≫ CategoryTheory.Limits.pullback.fst h_W π =
            CategoryTheory.Limits.pullback.fst h_W π →
          m_σ ≫ CategoryTheory.Limits.pullback.snd h_W π =
            CategoryTheory.Limits.pullback.snd h_W π ≫ s_mor σ →
          ∀ y : ↥W_V, f (m_σ.base y) = ((ρ σ).val).mulVec (f y) } := by
    intro W h_W W_V
    refine ⟨Subtype.val_injective, ?_⟩
    ext f
    change f ∈ Set.range (Subtype.val : ↥(E_sub W) → _) ↔
      ∀ (σ : S ≃ₐ[R] S) (m_σ : Quiver.Hom W_V W_V),
        m_σ ≫ CategoryTheory.Limits.pullback.fst h_W π =
          CategoryTheory.Limits.pullback.fst h_W π →
        m_σ ≫ CategoryTheory.Limits.pullback.snd h_W π =
          CategoryTheory.Limits.pullback.snd h_W π ≫ s_mor σ →
        ∀ y : ↥W_V, f (m_σ.base y) = ((ρ σ).val).mulVec (f y)
