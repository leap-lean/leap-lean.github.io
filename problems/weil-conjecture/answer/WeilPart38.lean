              _ = A₂.2.1 := Limits.pullback.lift_snd _ _ _
          refine ⟨Opposite.op A₃, Opposite.op ⟨u₁, hc₁⟩, Opposite.op ⟨u₂, hc₂⟩, ?_⟩
          change U_aff.map u₁ ≫ w₁' = U_aff.map u₂ ≫ w₂'
          rw [hu₁_map, hu₂_map, Category.assoc, Category.assoc, hp_comm]
        let T_S₀ : S.Etale := MorphismProperty.Over.mk ⊤ (𝟙 S) inferInstance
        let γ_T : GeomLifts x T_S₀ := ⟨geomHom x, Category.comp_id _⟩
        have hFiltered : CategoryTheory.IsFiltered PtAffNhdᵒᵖ :=
          { cocone_objs := by
              intro i₁ i₂
              let w₁ : U_aff.obj i₁.unop.1 ⟶ T_S₀ :=
                MorphismProperty.Over.homMk (Fgt.obj (U_aff.obj i₁.unop.1)).hom
                  (Category.comp_id _) trivial
              let w₂ : U_aff.obj i₂.unop.1 ⟶ T_S₀ :=
                MorphismProperty.Over.homMk (Fgt.obj (U_aff.obj i₂.unop.1)).hom
                  (Category.comp_id _) trivial
              obtain ⟨k, f₁, f₂, -⟩ := hRefine T_S₀ γ_T i₁ i₂ w₁ w₂
                (Subtype.ext i₁.unop.2.2) (Subtype.ext i₂.unop.2.2)
              exact ⟨k, f₁, f₂, trivial⟩
            cocone_maps := by
              intro i₂ i₁ f₁ f₂
              let A₁ := i₁.unop
              let A₂ := i₂.unop
              let u₁ : A₁ ⟶ A₂ := f₁.unop
              let u₂ : A₁ ⟶ A₂ := f₂.unop
              let Y₁ := (Fgt.obj (U_aff.obj A₁.1)).left
              let Y₂ := (Fgt.obj (U_aff.obj A₂.1)).left
              let h₁ : Y₁ ⟶ S := (Fgt.obj (U_aff.obj A₁.1)).hom
              let h₂ : Y₂ ⟶ S := (Fgt.obj (U_aff.obj A₂.1)).hom
              have : AlgebraicGeometry.Etale h₁ := (U_aff.obj A₁.1).prop
              have : AlgebraicGeometry.Etale h₂ := (U_aff.obj A₂.1).prop
              let ubar₁ : Y₁ ⟶ Y₂ := (Fgt.map (U_aff.map u₁.1)).left
              let ubar₂ : Y₁ ⟶ Y₂ := (Fgt.map (U_aff.map u₂.1)).left
              have hubar : ubar₁ ≫ h₂ = ubar₂ ≫ h₂ := by
                have e₁ : ubar₁ ≫ h₂ = h₁ := (Fgt.map (U_aff.map u₁.1)).w
                have e₂ : ubar₂ ≫ h₂ = h₁ := (Fgt.map (U_aff.map u₂.1)).w
                rw [e₁, e₂]
              let Δ : Y₂ ⟶ Limits.pullback h₂ h₂ := Limits.pullback.diagonal h₂
              have : AlgebraicGeometry.IsOpenImmersion Δ :=
                AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal h₂
              let pair_u : Y₁ ⟶ Limits.pullback h₂ h₂ :=
                Limits.pullback.lift ubar₁ ubar₂ hubar
              let E_sch := Limits.pullback Δ pair_u
              let j_E : E_sch ⟶ Y₁ := Limits.pullback.snd Δ pair_u
              have : AlgebraicGeometry.IsOpenImmersion j_E :=
                MorphismProperty.IsStableUnderBaseChange.of_isPullback
                  (IsPullback.of_hasPullback Δ pair_u) inferInstance
              have : AlgebraicGeometry.Etale j_E := inferInstance
              let E_et : S.Etale := MorphismProperty.Over.mk ⊤ (j_E ≫ h₁) inferInstance
              let j_et : E_et ⟶ U_aff.obj A₁.1 := MorphismProperty.Over.homMk j_E rfl trivial
              have hj_eq : j_E ≫ ubar₁ = j_E ≫ ubar₂ := by
                have hpb := Limits.pullback.condition (f := Δ) (g := pair_u)
                have hp₁ : pair_u ≫ Limits.pullback.fst h₂ h₂ = ubar₁ :=
                  Limits.pullback.lift_fst ubar₁ ubar₂ hubar
                have hp₂ : pair_u ≫ Limits.pullback.snd h₂ h₂ = ubar₂ :=
                  Limits.pullback.lift_snd ubar₁ ubar₂ hubar
                have hΔ₁ : Δ ≫ Limits.pullback.fst h₂ h₂ = 𝟙 Y₂ := Limits.pullback.diagonal_fst h₂
                have hΔ₂ : Δ ≫ Limits.pullback.snd h₂ h₂ = 𝟙 Y₂ := Limits.pullback.diagonal_snd h₂
                calc
                  j_E ≫ ubar₁ = (j_E ≫ pair_u) ≫ Limits.pullback.fst h₂ h₂ := by
                    rw [Category.assoc, hp₁]
                  _ = Limits.pullback.fst Δ pair_u ≫ (Δ ≫ Limits.pullback.fst h₂ h₂) := by
                    rw [← hpb, Category.assoc]
                  _ = Limits.pullback.fst Δ pair_u := by rw [hΔ₁, Category.comp_id]
                  _ = Limits.pullback.fst Δ pair_u ≫ (Δ ≫ Limits.pullback.snd h₂ h₂) := by
                    rw [hΔ₂, Category.comp_id]
                  _ = (j_E ≫ pair_u) ≫ Limits.pullback.snd h₂ h₂ := by
                    rw [← Category.assoc, hpb]
                  _ = j_E ≫ ubar₂ := by rw [Category.assoc, hp₂]
              have hδ_diag : A₂.2.1 ≫ Δ = A₁.2.1 ≫ pair_u := by
                apply Limits.pullback.hom_ext
                · simp only [Δ, pair_u, Category.assoc, Limits.pullback.diagonal_fst,
                    Limits.pullback.lift_fst, Category.comp_id]
                  exact (congrArg Subtype.val u₁.2).symm
                · simp only [Δ, pair_u, Category.assoc, Limits.pullback.diagonal_snd,
                    Limits.pullback.lift_snd, Category.comp_id]
                  exact (congrArg Subtype.val u₂.2).symm
              let γ_E_hom : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E_sch :=
                Limits.pullback.lift A₂.2.1 A₁.2.1 hδ_diag
              let γ_E : GeomLifts x E_et :=
                ⟨γ_E_hom, by
                  change γ_E_hom ≫ (j_E ≫ h₁) = geomHom x
                  rw [← Category.assoc, Limits.pullback.lift_snd]
                  exact A₁.2.2⟩
              obtain ⟨A₀, w_E, hw_E⟩ := hShrink E_et γ_E
              let v₀ : A₀.1 ⟶ A₁.1 := hFF_Uaff.preimage (w_E ≫ j_et)
              have hv₀_map : U_aff.map v₀ = w_E ≫ j_et := hFF_Uaff.map_preimage _
              have hv₀_compat : liftMap x (U_aff.map v₀) A₀.2 = A₁.2 := by
                rw [hv₀_map]
                apply Subtype.ext
                have hcomp_left : (Fgt.map (w_E ≫ j_et)).left =
                    (Fgt.map w_E).left ≫ (Fgt.map j_et).left :=
                  congrArg CategoryTheory.CommaMorphism.left (Fgt.map_comp w_E j_et)
                have h1 : A₀.2.1 ≫ (Fgt.map w_E).left = γ_E_hom := congrArg Subtype.val hw_E
                calc
                  A₀.2.1 ≫ (Fgt.map (w_E ≫ j_et)).left =
                      (A₀.2.1 ≫ (Fgt.map w_E).left) ≫ (Fgt.map j_et).left := by
                    rw [hcomp_left, Category.assoc]
                  _ = γ_E_hom ≫ j_E := by rw [h1]; rfl
                  _ = A₁.2.1 := Limits.pullback.lift_snd _ _ _
              let g_op : i₁ ⟶ Opposite.op A₀ := Opposite.op ⟨v₀, hv₀_compat⟩
              refine ⟨Opposite.op A₀, g_op, ?_⟩
              apply Quiver.Hom.unop_inj
              apply Subtype.ext
              change v₀ ≫ u₁.1 = v₀ ≫ u₂.1
              apply U_aff.map_injective
              rw [U_aff.map_comp, U_aff.map_comp, hv₀_map]
              apply MorphismProperty.Comma.Hom.ext
              · have hleft₁ : (Fgt.map ((w_E ≫ j_et) ≫ U_aff.map u₁.1)).left =
                    (Fgt.map w_E).left ≫ (j_E ≫ ubar₁) := by
                  have e1 := congrArg CategoryTheory.CommaMorphism.left
                    (Fgt.map_comp (w_E ≫ j_et) (U_aff.map u₁.1))
                  have e2 := congrArg CategoryTheory.CommaMorphism.left (Fgt.map_comp w_E j_et)
                  exact e1.trans ((congrArg (· ≫ ubar₁) e2).trans (Category.assoc _ _ _))
                have hleft₂ : (Fgt.map ((w_E ≫ j_et) ≫ U_aff.map u₂.1)).left =
                    (Fgt.map w_E).left ≫ (j_E ≫ ubar₂) := by
                  have e1 := congrArg CategoryTheory.CommaMorphism.left
                    (Fgt.map_comp (w_E ≫ j_et) (U_aff.map u₂.1))
                  have e2 := congrArg CategoryTheory.CommaMorphism.left (Fgt.map_comp w_E j_et)
                  exact e1.trans ((congrArg (· ≫ ubar₂) e2).trans (Category.assoc _ _ _))
                exact hleft₁.trans ((congrArg ((Fgt.map w_E).left ≫ ·) hj_eq).trans hleft₂.symm)
              · exact Subsingleton.elim _ _
            nonempty := by
              obtain ⟨A₀, -, -⟩ := hShrink T_S₀ γ_T
              exact ⟨Opposite.op A₀⟩ }
        exact ⟨PtAffNhdᵒᵖ, inferInstance, W_diag, fun i => i.unop.2,
          hFiltered, fun f => f.unop.2,
          fun U γ => by
            obtain ⟨A, w, hw⟩ := hShrink U γ
            exact ⟨Opposite.op A, w, hw⟩,
          hRefine⟩

    obtain ⟨hTypeSheaf, hCoverSieve, hNhds⟩ := hGeomPkg
    choose ℐ instCat_ℐ hNhds₁ using hNhds
    letI : ∀ x : ↥S, CategoryTheory.SmallCategory (ℐ x) := instCat_ℐ
    choose W liftOf hFilt hLiftCompat hShrink hRefine using hNhds₁
    have : ∀ x : ↥S, CategoryTheory.IsFiltered (ℐ x) := hFilt

    have hAbShortExactOfDesc : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒜]
        [CategoryTheory.Abelian 𝒜] {X Y Z : 𝒜} (f : X ⟶ Y) (g : Y ⟶ Z) (h0 : f ≫ g = 0),
        CategoryTheory.Mono f → CategoryTheory.Epi g →
        (∀ {D : 𝒜} (u : Y ⟶ D), f ≫ u = 0 → ∃ v : Z ⟶ D, g ≫ v = u) →
        (CategoryTheory.ShortComplex.mk f g h0).ShortExact := by
      intro 𝒜 _ _ X Y Z f g h0 hf hg hdesc
      have : CategoryTheory.Mono f := hf
      have : CategoryTheory.Epi g := hg
      have hIsCoker : Limits.IsColimit (Limits.CokernelCofork.ofπ g h0) :=
        Limits.CokernelCofork.IsColimit.ofπ _ _
          (fun {D} u hu => Classical.choose (hdesc u hu))
          (fun {D} u hu => Classical.choose_spec (hdesc u hu))
          (fun {D} u hu m_hom hm_eq =>
            (cancel_epi g).mp (hm_eq.trans (Classical.choose_spec (hdesc u hu)).symm))
      exact
        { exact := ShortComplex.exact_of_g_is_cokernel (ShortComplex.mk f g h0) hIsCoker
          mono_f := hf
          epi_g := hg }

    have hAbExactOfHomotopy : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒜]
        [CategoryTheory.Abelian 𝒜] {X Y Z : 𝒜} (f : X ⟶ Y) (g : Y ⟶ Z) (hfg : f ≫ g = 0),
        (Limits.kernel.ι g ≫ Limits.cokernel.π f = 0) →
        (ShortComplex.mk f g hfg).Exact := by
      intro 𝒜 _ _ X Y Z f g hfg h0
      exact (ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero
        (ShortComplex.mk f g hfg)).mpr h0

    let skySinglePresheaf : ∀ (x : ↥S) (N : ModR), (S.Etale)ᵒᵖ ⥤ ModR := fun x N =>
      { obj := fun opU => ModuleCat.of R (GeomLifts x opU.unop → ↑N)
        map := fun f => ModuleCat.ofHom
          { toFun := fun s γ => s (liftMap x f.unop γ)
            map_add' := fun _ _ => rfl
            map_smul' := fun _ _ => rfl }
        map_id := fun _ => ModuleCat.hom_ext (LinearMap.ext fun s => funext fun γ =>
          congrArg s (Subtype.ext (Category.comp_id γ.1)))
        map_comp := fun _ _ => ModuleCat.hom_ext (LinearMap.ext fun s => funext fun γ =>
          congrArg s (Subtype.ext (Category.assoc γ.1 _ _).symm)) }

    let skyProdPresheaf : (↥S → ModR) → ((S.Etale)ᵒᵖ ⥤ ModR) := fun M =>
      { obj := fun opU => ModuleCat.of R (∀ x : ↥S, GeomLifts x opU.unop → ↑(M x))
        map := fun f => ModuleCat.ofHom
          { toFun := fun s x γ => s x (liftMap x f.unop γ)
            map_add' := fun _ _ => rfl
            map_smul' := fun _ _ => rfl }
        map_id := fun _ => ModuleCat.hom_ext (LinearMap.ext fun s => funext fun x => funext fun γ =>
          congrArg (s x) (Subtype.ext (Category.comp_id γ.1)))
        map_comp := fun _ _ => ModuleCat.hom_ext (LinearMap.ext fun s => funext fun x => funext fun γ =>
          congrArg (s x) (Subtype.ext (Category.assoc γ.1 _ _).symm)) }

    have hSingleIsSheaf : ∀ (x : ↥S) (N : ModR),
        CategoryTheory.Presheaf.IsSheaf J (skySinglePresheaf x N) := by
      intro x N E
      let iso : (skySinglePresheaf x N ⋙ coyoneda.obj (Opposite.op E)) ≅
          skyTypePresheaf x (E ⟶ N) :=
        NatIso.ofComponents
          (fun opU =>
            { hom := TypeCat.ofHom fun (φ : E ⟶ (skySinglePresheaf x N).obj opU) γ =>
                ModuleCat.ofHom
                  { toFun := fun e => φ.hom e γ
                    map_add' := fun e₁ e₂ => congrFun (φ.hom.map_add e₁ e₂) γ
                    map_smul' := fun r e => congrFun (φ.hom.map_smul r e) γ }
              inv := TypeCat.ofHom fun (ψ : GeomLifts x opU.unop → (E ⟶ N)) =>
                ModuleCat.ofHom
                  { toFun := fun e γ => (ψ γ).hom e
                    map_add' := fun e₁ e₂ => funext fun γ => (ψ γ).hom.map_add e₁ e₂
                    map_smul' := fun r e => funext fun γ => (ψ γ).hom.map_smul r e }
              hom_inv_id := by ext φ; rfl
              inv_hom_id := by ext ψ; rfl })
          (fun _ => by ext φ; rfl)
      exact Presieve.isSheaf_iso J iso.symm (hTypeSheaf x (E ⟶ N))

    have hProdIsSheaf : ∀ (M : ↥S → ModR),
        CategoryTheory.Presheaf.IsSheaf J (skyProdPresheaf M) := by
      intro M E
      let P_prod : (S.Etale)ᵒᵖ ⥤ Type u :=
        { obj := fun opU => ∀ x : ↥S, GeomLifts x opU.unop → (E ⟶ M x)
          map := fun f => TypeCat.ofHom fun s x γ => s x (liftMap x f.unop γ)
          map_id := fun _ => congrArg TypeCat.ofHom (funext fun s => funext fun x => funext fun γ =>
            congrArg (s x) (Subtype.ext (Category.comp_id γ.1)))
          map_comp := fun _ _ => congrArg TypeCat.ofHom (funext fun s => funext fun x => funext fun γ =>
            congrArg (s x) (Subtype.ext (Category.assoc γ.1 _ _).symm)) }
      have hPprod_sheaf : Presieve.IsSheaf J P_prod := by
        intro U R_sieve hR ξ hξ
        have h_coord : ∀ x : ↥S,
            Presieve.FamilyOfElements.Compatible
              (P := skyTypePresheaf x (E ⟶ M x))
              (fun V f hf => ξ f hf x) := by
          intro x Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
          exact congrFun (hξ g₁ g₂ hf₁ hf₂ hcomm) x
        let s_amalg : ∀ x : ↥S, GeomLifts x U → (E ⟶ M x) :=
          fun x => Classical.choose (hTypeSheaf x (E ⟶ M x) R_sieve hR _ (h_coord x))
        have hs_spec : ∀ x : ↥S,
            Presieve.FamilyOfElements.IsAmalgamation
              (P := skyTypePresheaf x (E ⟶ M x))
              (fun V f hf => ξ f hf x) (s_amalg x) ∧
            ∀ y, Presieve.FamilyOfElements.IsAmalgamation
              (P := skyTypePresheaf x (E ⟶ M x))
              (fun V f hf => ξ f hf x) y → y = s_amalg x :=
          fun x => Classical.choose_spec (hTypeSheaf x (E ⟶ M x) R_sieve hR _ (h_coord x))
        refine ⟨s_amalg, ?_, ?_⟩
        · intro V f hf; funext x; exact (hs_spec x).1 f hf
        · intro s' hs'; funext x; exact (hs_spec x).2 (s' x) (fun V f hf => congrFun (hs' f hf) x)
      let iso : (skyProdPresheaf M ⋙ coyoneda.obj (Opposite.op E)) ≅ P_prod :=
        NatIso.ofComponents
          (fun opU =>
            { hom := TypeCat.ofHom fun (φ : E ⟶ (skyProdPresheaf M).obj opU) x γ =>
                ModuleCat.ofHom
                  { toFun := fun e => φ.hom e x γ
                    map_add' := fun e₁ e₂ => congrFun (congrFun (φ.hom.map_add e₁ e₂) x) γ
                    map_smul' := fun r e => congrFun (congrFun (φ.hom.map_smul r e) x) γ }
              inv := TypeCat.ofHom fun ψ =>
                ModuleCat.ofHom
                  { toFun := fun e x γ => (ψ x γ).hom e
                    map_add' := fun e₁ e₂ => funext fun x => funext fun γ => (ψ x γ).hom.map_add e₁ e₂
                    map_smul' := fun r e => funext fun x => funext fun γ => (ψ x γ).hom.map_smul r e }
              hom_inv_id := by ext φ; rfl
              inv_hom_id := by ext ψ; rfl })
          (fun _ => by ext φ; rfl)
      exact Presieve.isSheaf_iso J iso.symm hPprod_sheaf

    let Sky : (↥S → ModR) → 𝒞 := fun M => ⟨skyProdPresheaf M, hProdIsSheaf M⟩
    let skyMap : ∀ {M₁ M₂ : ↥S → ModR}, (∀ x : ↥S, M₁ x ⟶ M₂ x) → (Sky M₁ ⟶ Sky M₂) :=
      fun α =>
        { hom :=
            { app := fun _ => ModuleCat.ofHom
                { toFun := fun s x γ => (α x).hom (s x γ)
                  map_add' := fun s₁ s₂ => funext fun x => funext fun γ =>
                    (α x).hom.map_add (s₁ x γ) (s₂ x γ)
                  map_smul' := fun r s => funext fun x => funext fun γ =>
                    (α x).hom.map_smul r (s x γ) }
              naturality := fun _ _ _ => ModuleCat.hom_ext (LinearMap.ext fun _ => rfl) } }

    let g_push : ↥S → ModR ⥤ 𝒞 := fun x =>
      { obj := fun N => ⟨skySinglePresheaf x N, hSingleIsSheaf x N⟩
        map := fun α =>
          { hom :=
              { app := fun _ => ModuleCat.ofHom
                  { toFun := fun s γ => α.hom (s γ)
                    map_add' := fun s₁ s₂ => funext fun γ => α.hom.map_add (s₁ γ) (s₂ γ)
                    map_smul' := fun r s => funext fun γ => α.hom.map_smul r (s γ) }
                naturality := fun _ _ _ => ModuleCat.hom_ext (LinearMap.ext fun _ => rfl) } }
        map_id := fun _ => Sheaf.hom_ext (NatTrans.ext (funext fun _ =>
          ModuleCat.hom_ext (LinearMap.ext fun _ => rfl)))
        map_comp := fun _ _ => Sheaf.hom_ext (NatTrans.ext (funext fun _ =>
          ModuleCat.hom_ext (LinearMap.ext fun _ => rfl))) }

    let Stalk : ↥S → 𝒞 ⥤ ModR := fun x =>
      sheafToPresheaf J ModR ⋙
        (Functor.whiskeringLeft (ℐ x) (S.Etale)ᵒᵖ ModR).obj (W x) ⋙
        Limits.colim

    let germ : ∀ (x : ↥S) (F : 𝒞) (U : S.Etale),
        GeomLifts x U → (F.obj.obj (Opposite.op U) ⟶ (Stalk x).obj F) :=
      fun x F U γ =>
        let i₀ := Classical.choose (hShrink x U γ)
        let w₀ := Classical.choose (Classical.choose_spec (hShrink x U γ))
        F.obj.map w₀.op ≫ Limits.colimit.ι (W x ⋙ F.obj) i₀

    have hgerm_eq : ∀ (x : ↥S) (F : 𝒞) (U : S.Etale) (γ : GeomLifts x U)
        (i : ℐ x) (w : (W x |>.obj i).unop ⟶ U),
        liftMap x w (liftOf x i) = γ →
        germ x F U γ = F.obj.map w.op ≫ Limits.colimit.ι (W x ⋙ F.obj) i := by
      intro x F U γ i w hw
      let i₀ := Classical.choose (hShrink x U γ)
      let spec₀ := Classical.choose_spec (hShrink x U γ)
      let w₀ := Classical.choose spec₀
      have hw₀ : liftMap x w₀ (liftOf x i₀) = γ := Classical.choose_spec spec₀
      obtain ⟨k, f₁, f₂, hcomm⟩ := hRefine x U γ i₀ i w₀ w hw₀ hw
      let D_x := W x ⋙ F.obj
      have hι₁ : Limits.colimit.ι D_x i₀ = D_x.map f₁ ≫ Limits.colimit.ι D_x k :=
        (Limits.colimit.w D_x f₁).symm
      have hι₂ : Limits.colimit.ι D_x i = D_x.map f₂ ≫ Limits.colimit.ι D_x k :=
        (Limits.colimit.w D_x f₂).symm
      change F.obj.map w₀.op ≫ Limits.colimit.ι D_x i₀ = F.obj.map w.op ≫ Limits.colimit.ι D_x i
      rw [hι₁, hι₂, ← Category.assoc, ← Category.assoc]
      congr 1
      change F.obj.map w₀.op ≫ F.obj.map ((W x).map f₁) =
        F.obj.map w.op ≫ F.obj.map ((W x).map f₂)
      rw [← F.obj.map_comp, ← F.obj.map_comp]
      exact congrArg F.obj.map (congrArg Quiver.Hom.op hcomm)

    have hgerm_map : ∀ (x : ↥S) (F : 𝒞) {U₁ U₂ : S.Etale} (u : U₁ ⟶ U₂) (γ : GeomLifts x U₁),
        F.obj.map u.op ≫ germ x F U₁ γ = germ x F U₂ (liftMap x u γ) := by
      intro x F U₁ U₂ u γ
      obtain ⟨i, w, hw⟩ := hShrink x U₁ γ
      have hw_u : liftMap x (w ≫ u) (liftOf x i) = liftMap x u γ := by
        rw [← hw]
        apply Subtype.ext
        have hcomp := congrArg CategoryTheory.CommaMorphism.left (Fgt.map_comp w u)
        exact (congrArg ((liftOf x i).1 ≫ ·) hcomp).trans (Category.assoc _ _ _).symm
      rw [hgerm_eq x F U₁ γ i w hw, hgerm_eq x F U₂ (liftMap x u γ) i (w ≫ u) hw_u,
        op_comp, F.obj.map_comp, Category.assoc]

    have hgerm_diag : ∀ (x : ↥S) (F : 𝒞) (i : ℐ x),
        germ x F ((W x).obj i).unop (liftOf x i) = Limits.colimit.ι (W x ⋙ F.obj) i := by
      intro x F i
      let U_i : S.Etale := ((W x).obj i).unop
      have hid : liftMap x (𝟙 U_i) (liftOf x i) = liftOf x i := by
        apply Subtype.ext
        have hmap_id := congrArg CategoryTheory.CommaMorphism.left (Fgt.map_id U_i)
        exact (congrArg ((liftOf x i).1 ≫ ·) hmap_id).trans (Category.comp_id _)
      rw [hgerm_eq x F U_i (liftOf x i) i (𝟙 U_i) hid, op_id, F.obj.map_id, Category.id_comp]

    have hgerm_nat : ∀ (x : ↥S) {F₁ F₂ : 𝒞} (φ : F₁ ⟶ F₂) (U : S.Etale) (γ : GeomLifts x U),
        germ x F₁ U γ ≫ (Stalk x).map φ = φ.hom.app (Opposite.op U) ≫ germ x F₂ U γ := by
      intro x F₁ F₂ φ U γ
      obtain ⟨i, w, hw⟩ := hShrink x U γ
      rw [hgerm_eq x F₁ U γ i w hw, hgerm_eq x F₂ U γ i w hw]
      change (F₁.obj.map w.op ≫ Limits.colimit.ι (W x ⋙ F₁.obj) i) ≫
          Limits.colimMap (Functor.whiskerLeft (W x) φ.hom) = _
      rw [Category.assoc, Limits.ι_colimMap]
      change F₁.obj.map w.op ≫ (φ.hom.app ((W x).obj i) ≫ Limits.colimit.ι (W x ⋙ F₂.obj) i) = _
      rw [← Category.assoc, φ.hom.naturality w.op, Category.assoc]

    let coconeOf : ∀ (x : ↥S) {F : 𝒞} {N : ModR},
        (F ⟶ (g_push x).obj N) → Limits.Cocone (W x ⋙ F.obj) :=
      fun x {F N} β =>
        { pt := N
          ι :=
            { app := fun i => ModuleCat.ofHom
                { toFun := fun s => (β.hom.app ((W x).obj i)).hom s (liftOf x i)
                  map_add' := fun s₁ s₂ =>
                    congrFun ((β.hom.app _).hom.map_add s₁ s₂) (liftOf x i)
                  map_smul' := fun r s =>
                    congrFun ((β.hom.app _).hom.map_smul r s) (liftOf x i) }
              naturality := fun {i j} f => by
                apply ModuleCat.hom_ext
                ext s
                have hnat : ((β.hom.app ((W x).obj j)).hom
                    ((F.obj.map ((W x).map f)).hom s)) (liftOf x j) =
                  ((β.hom.app ((W x).obj i)).hom s)
                    (liftMap x ((W x).map f).unop (liftOf x j)) :=
                  congrArg (fun h => h.hom s (liftOf x j))
                    (β.hom.naturality ((W x).map f))
                change ((β.hom.app ((W x).obj j)).hom
                    ((F.obj.map ((W x).map f)).hom s)) (liftOf x j) =
                  ((β.hom.app ((W x).obj i)).hom s) (liftOf x i)
                rw [hnat, hLiftCompat x f] } }

    let stalkHomEquiv : ∀ (x : ↥S) (F : 𝒞) (N : ModR),
        ((Stalk x).obj F ⟶ N) ≃ (F ⟶ (g_push x).obj N) :=
      fun x F N =>
        { toFun := fun α =>
            { hom :=
                { app := fun opU => ModuleCat.ofHom
                    { toFun := fun s γ => α.hom ((germ x F opU.unop γ).hom s)
                      map_add' := fun _ _ => funext fun _ => by simp only [map_add]; rfl
                      map_smul' := fun _ _ => funext fun _ => by simp only [map_smul]; rfl }
                  naturality := fun {opU opV} f => by
                    apply ModuleCat.hom_ext
                    apply LinearMap.ext; intro s
                    funext γ
                    have hm := congrArg (fun h => h.hom s) (hgerm_map x F f.unop γ)
                    exact congrArg α.hom hm } }
          invFun := fun β => Limits.colimit.desc (W x ⋙ F.obj) (coconeOf x β)
          left_inv := fun α => by
            apply Limits.colimit.hom_ext
            intro i
            dsimp only
            rw [Limits.colimit.ι_desc]
            apply ModuleCat.hom_ext
            apply LinearMap.ext; intro s
            exact congrArg α.hom (congrArg (fun h => h.hom s) (hgerm_diag x F i))
          right_inv := fun β => by
            apply Sheaf.hom_ext
            ext opU : 2
            apply ModuleCat.hom_ext
            apply LinearMap.ext; intro s
            funext γ
            obtain ⟨i, w, hw⟩ := hShrink x opU.unop γ
            change (Limits.colimit.desc (W x ⋙ F.obj) (coconeOf x β)).hom
                ((germ x F opU.unop γ).hom s) = (β.hom.app opU).hom s γ
            rw [hgerm_eq x F opU.unop γ i w hw]
            change (Limits.colimit.ι (W x ⋙ F.obj) i ≫
                Limits.colimit.desc (W x ⋙ F.obj) (coconeOf x β)).hom ((F.obj.map w.op).hom s) =
              (β.hom.app opU).hom s γ
            rw [Limits.colimit.ι_desc]
            have hnat : ((β.hom.app ((W x).obj i)).hom ((F.obj.map w.op).hom s)) (liftOf x i) =
                (β.hom.app opU).hom s (liftMap x w (liftOf x i)) :=
              congrArg (fun h => h.hom s (liftOf x i)) (β.hom.naturality w.op)
            change ((β.hom.app ((W x).obj i)).hom ((F.obj.map w.op).hom s)) (liftOf x i) =
              (β.hom.app opU).hom s γ
            rw [hnat, hw] }

    let adj_x : ∀ x : ↥S, Stalk x ⊣ g_push x := fun x =>
      Adjunction.mkOfHomEquiv
        { homEquiv := fun F N => stalkHomEquiv x F N
          homEquiv_naturality_left_symm := fun {F₁ F₂ N} φ β => by
            apply Limits.colimit.hom_ext
            intro i
            change Limits.colimit.ι (W x ⋙ F₁.obj) i ≫
                Limits.colimit.desc (W x ⋙ F₁.obj) (coconeOf x (φ ≫ β)) =
              (Limits.colimit.ι (W x ⋙ F₁.obj) i ≫
                Limits.colimMap (Functor.whiskerLeft (W x) φ.hom)) ≫
                Limits.colimit.desc (W x ⋙ F₂.obj) (coconeOf x β)
            rw [Limits.ι_colimMap, Category.assoc, Limits.colimit.ι_desc, Limits.colimit.ι_desc]
            rfl
          homEquiv_naturality_right := fun _ _ => by
            apply Sheaf.hom_ext; ext : 2; apply ModuleCat.hom_ext
            apply LinearMap.ext; intro _; funext _; rfl }

    have hStalkExact : ∀ x : ↥S,
        (Stalk x).Additive ∧ Limits.PreservesFiniteLimits (Stalk x) := by
      intro x
      have hAdd : (Stalk x).Additive :=
        ⟨fun {F₁ F₂} {φ₁ φ₂} => by
          apply (stalkHomEquiv x F₁ ((Stalk x).obj F₂)).injective
          apply Sheaf.hom_ext
          ext opU : 2
          apply ModuleCat.hom_ext
          apply LinearMap.ext; intro s
          funext γ
          have hn₁ : ((Stalk x).map φ₁).hom ((germ x F₁ opU.unop γ).hom s) =
              (germ x F₂ opU.unop γ).hom ((φ₁.hom.app opU).hom s) :=
            congrArg (fun h => h.hom s) (hgerm_nat x φ₁ opU.unop γ)
          have hn₂ : ((Stalk x).map φ₂).hom ((germ x F₁ opU.unop γ).hom s) =
              (germ x F₂ opU.unop γ).hom ((φ₂.hom.app opU).hom s) :=
            congrArg (fun h => h.hom s) (hgerm_nat x φ₂ opU.unop γ)
          have hn₁₂ : ((Stalk x).map (φ₁ + φ₂)).hom ((germ x F₁ opU.unop γ).hom s) =
              (germ x F₂ opU.unop γ).hom (((φ₁ + φ₂).hom.app opU).hom s) :=
            congrArg (fun h => h.hom s) (hgerm_nat x (φ₁ + φ₂) opU.unop γ)
          change ((Stalk x).map (φ₁ + φ₂)).hom ((germ x F₁ opU.unop γ).hom s) =
            ((Stalk x).map φ₁).hom ((germ x F₁ opU.unop γ).hom s) +
              ((Stalk x).map φ₂).hom ((germ x F₁ opU.unop γ).hom s)
          rw [hn₁₂, hn₁, hn₂]
          exact map_add (germ x F₂ opU.unop γ).hom _ _⟩
      let F₁ := sheafToPresheaf J ModR
      let F₂ := (Functor.whiskeringLeft (ℐ x) (S.Etale)ᵒᵖ ModR).obj (W x)
      let F₃ : (ℐ x ⥤ ModR) ⥤ ModR := Limits.colim
      have : Limits.PreservesLimitsOfSize.{0, 0} F₁ :=
        (sheafificationAdjunction J ModR).rightAdjoint_preservesLimits
      have : Limits.PreservesFiniteLimits F₁ := ⟨fun _ _ _ => inferInstance⟩
      have : Limits.PreservesFiniteLimits F₃ :=
        ⟨fun _ _ _ => Limits.filtered_colim_preservesFiniteLimits⟩
      have hLim : Limits.PreservesFiniteLimits (Stalk x) := by
        change Limits.PreservesFiniteLimits (F₁ ⋙ F₂ ⋙ F₃)
        exact inferInstance
      exact ⟨hAdd, hLim⟩

    let T : 𝒞 ⥤ 𝒞 :=
      { obj := fun F => Sky (fun x => (Stalk x).obj F)
        map := fun φ => skyMap (fun x => (Stalk x).map φ)
        map_id := fun F => by
          apply Sheaf.hom_ext; ext opU : 2; apply ModuleCat.hom_ext
          apply LinearMap.ext; intro s; funext x γ
          change ((Stalk x).map (𝟙 F)).hom (s x γ) = s x γ
          rw [(Stalk x).map_id]; rfl
        map_comp := fun φ ψ => by
          apply Sheaf.hom_ext; ext opU : 2; apply ModuleCat.hom_ext
          apply LinearMap.ext; intro s; funext x γ
          change ((Stalk x).map (φ ≫ ψ)).hom (s x γ) =
            ((Stalk x).map ψ).hom (((Stalk x).map φ).hom (s x γ))
          rw [(Stalk x).map_comp]; rfl }

    have : T.Additive :=
      ⟨fun {F₁ F₂} {φ₁ φ₂} => by
        apply Sheaf.hom_ext; ext opU : 2; apply ModuleCat.hom_ext
        apply LinearMap.ext; intro s; funext x γ
        have : (Stalk x).Additive := (hStalkExact x).1
        change ((Stalk x).map (φ₁ + φ₂)).hom (s x γ) =
          ((Stalk x).map φ₁).hom (s x γ) + ((Stalk x).map φ₂).hom (s x γ)
        rw [(Stalk x).map_add]; rfl⟩

    let η_app : ∀ F : 𝒞, F ⟶ T.obj F := fun F =>
      { hom :=
          { app := fun opU => ModuleCat.ofHom
              { toFun := fun s x γ => (germ x F opU.unop γ).hom s
                map_add' := fun _ _ => funext fun _ => funext fun _ => by
                  simp only [map_add]; rfl
                map_smul' := fun _ _ => funext fun _ => funext fun _ => by
                  simp only [map_smul]; rfl }
            naturality := fun {opU opV} f => by
              apply ModuleCat.hom_ext; apply LinearMap.ext; intro s; funext x γ
              exact congrArg (fun h => h.hom s) (hgerm_map x F f.unop γ) } }
    have hη_nat : ∀ {F₁ F₂ : 𝒞} (φ : F₁ ⟶ F₂), φ ≫ η_app F₂ = η_app F₁ ≫ T.map φ := by
      intro F₁ F₂ φ
      apply Sheaf.hom_ext; ext opU : 2; apply ModuleCat.hom_ext
      apply LinearMap.ext; intro s; funext x γ
      exact (congrArg (fun h => h.hom s) (hgerm_nat x φ opU.unop γ)).symm

    have hStalkZero : ∀ {F₁ F₂ : 𝒞} (φ : F₁ ⟶ F₂),
        (∀ x : ↥S, (Stalk x).map φ = 0) → φ = 0 := by
      intro F₁ F₂ φ hzero
      apply Sheaf.hom_ext
      ext opU : 2
      apply ModuleCat.hom_ext
      ext s
      let U := opU.unop
      let t : ↑(F₂.obj.obj (Opposite.op U)) := (φ.hom.app (Opposite.op U)).hom s
      change t = 0
      have ht_germ : ∀ (x : ↥S) (γ : GeomLifts x U), (germ x F₂ U γ).hom t = 0 := by
        intro x γ
        have hn := congrArg (fun h => h.hom s) (hgerm_nat x φ U γ)
        change (φ.hom.app (Opposite.op U) ≫ germ x F₂ U γ).hom s = 0
        rw [← hn, hzero x, Limits.comp_zero]
        rfl
      let R_s : CategoryTheory.Sieve U :=
        { arrows := fun _ h => (F₂.obj.map h.op).hom t = 0
          downward_closed := fun {V W_u h} hh g => by
            rw [op_comp, F₂.obj.map_comp]
            change (F₂.obj.map g.op).hom ((F₂.obj.map h.op).hom t) = 0
            rw [hh, map_zero] }
      have hRs_mem : R_s ∈ J U := by
        apply hCoverSieve U R_s
        intro x γ
        obtain ⟨i₀, w₀, hw₀⟩ := hShrink x U γ
        let D_x := W x ⋙ F₂.obj
        have hι0 : (Limits.colimit.ι D_x i₀).hom ((F₂.obj.map w₀.op).hom t) =
            (Limits.colimit.ι D_x i₀).hom (0 : ↑(D_x.obj i₀)) := by
          rw [map_zero]
          have hg := congrArg (fun h => h.hom t) (hgerm_eq x F₂ U γ i₀ w₀ hw₀)
          exact hg.symm.trans (ht_germ x γ)
        obtain ⟨k₁, f_a, f_b, hab⟩ :=
          (Limits.Concrete.isColimit_rep_eq_iff_exists D_x
            (Limits.colimit.isColimit D_x)
            ((F₂.obj.map w₀.op).hom t) (0 : ↑(D_x.obj i₀))).mp hι0
        let h_arr : ((W x).obj k₁).unop ⟶ U := ((W x).map f_a).unop ≫ w₀
        have hh_lift : liftMap x h_arr (liftOf x k₁) = γ := by
          have hcomp_map : liftMap x h_arr (liftOf x k₁) =
              liftMap x w₀ (liftMap x ((W x).map f_a).unop (liftOf x k₁)) := by
            apply Subtype.ext
            have hmc := congrArg CategoryTheory.CommaMorphism.left
              (Fgt.map_comp ((W x).map f_a).unop w₀)
            exact (congrArg ((liftOf x k₁).1 ≫ ·) hmc).trans (Category.assoc _ _ _).symm
          rw [hcomp_map, hLiftCompat x f_a, hw₀]
        have hh_zero : R_s.arrows h_arr := by
          change (F₂.obj.map h_arr.op).hom t = 0
          rw [show h_arr.op = w₀.op ≫ (W x).map f_a from rfl, F₂.obj.map_comp]
          have hb0 : (ConcreteCategory.hom (D_x.map f_b)) (0 : ↑(D_x.obj i₀)) = 0 := map_zero _
          exact hab.trans hb0
        exact ⟨_, h_arr, liftOf x k₁, hh_lift, hh_zero⟩
      let φ_t : ModuleCat.of R R ⟶ F₂.obj.obj (Opposite.op U) :=
        ModuleCat.ofHom (LinearMap.toSpanSingleton R _ t)
      let φ_zero : ModuleCat.of R R ⟶ F₂.obj.obj (Opposite.op U) := 0
      let zero_fam : Presieve.FamilyOfElements
          (F₂.obj ⋙ coyoneda.obj (Opposite.op (ModuleCat.of R R))) R_s.arrows :=
        fun V _ _ => (0 : ModuleCat.of R R ⟶ F₂.obj.obj (Opposite.op V))
      have hsep : φ_t = φ_zero :=
        (F₂.property (ModuleCat.of R R) R_s hRs_mem).isSeparatedFor zero_fam φ_t φ_zero
          (fun V h hh => by
            apply ModuleCat.hom_ext; apply LinearMap.ext; intro r
            change (F₂.obj.map h.op).hom (r • t) = 0
            rw [map_smul, hh, smul_zero])
          (fun V h _ => by
            apply ModuleCat.hom_ext; apply LinearMap.ext; intro r
            change (F₂.obj.map h.op).hom 0 = 0
            exact map_zero _)
      have h1 := congrArg (fun h => h.hom (1 : R)) hsep
      simpa [φ_t, φ_zero] using h1

    have hSkyShortExact : ∀ (M₁ M₂ M₃ : ↥S → ModR)
        (α : ∀ x : ↥S, M₁ x ⟶ M₂ x) (β : ∀ x : ↥S, M₂ x ⟶ M₃ x),
        (∀ x : ↥S, ∃ hx : α x ≫ β x = 0,
          (ShortComplex.mk (α x) (β x) hx).ShortExact) →
        ∃ h0 : skyMap α ≫ skyMap β = 0,
          (ShortComplex.mk (skyMap α) (skyMap β) h0).ShortExact := by
      intro M₁ M₂ M₃ α β hEx_pt
      have h0 : skyMap α ≫ skyMap β = 0 := by
        apply Sheaf.hom_ext; ext opU : 2; apply ModuleCat.hom_ext
        apply LinearMap.ext; intro s; funext x γ
        obtain ⟨hx, -⟩ := hEx_pt x
        exact congrArg (fun h => h.hom (s x γ)) hx
      have hMono_α : Mono (skyMap α) := by
        refine ⟨fun {Z_sh} z₁ z₂ hz => ?_⟩
        apply Sheaf.hom_ext; ext opU : 2; apply ModuleCat.hom_ext
        apply LinearMap.ext; intro w; funext x γ
        obtain ⟨_, hSx⟩ := hEx_pt x
        have : Mono (α x) := hSx.mono_f
        have hinj : Function.Injective (α x).hom := (ModuleCat.mono_iff_injective (α x)).mp this
        exact hinj (congrArg (fun h => (h.hom.app opU).hom w x γ) hz)
      have hSurj_β : ∀ x : ↥S, Function.Surjective (β x).hom := by
        intro x
        obtain ⟨_, hSx⟩ := hEx_pt x
        exact (ModuleCat.epi_iff_surjective (β x)).mp hSx.epi_g
      have hKer_β : ∀ (x : ↥S) (b : ↑(M₂ x)), (β x).hom b = 0 →
          ∃ a : ↑(M₁ x), (α x).hom a = b := by
        intro x b hb
        obtain ⟨hx, hSx⟩ := hEx_pt x
        let b_hom : ModuleCat.of R R ⟶ M₂ x := ModuleCat.ofHom (LinearMap.toSpanSingleton R _ b)
        have hb0 : b_hom ≫ β x = 0 := by
          apply ModuleCat.hom_ext; apply LinearMap.ext; intro r
          change (β x).hom (r • b) = 0
          rw [map_smul, hb, smul_zero]
        let a_hom : ModuleCat.of R R ⟶ M₁ x :=
          hSx.fIsKernel.lift (Limits.KernelFork.ofι b_hom hb0)
        have ha : a_hom ≫ α x = b_hom :=
          hSx.fIsKernel.fac (Limits.KernelFork.ofι b_hom hb0) Limits.WalkingParallelPair.zero
        exact ⟨a_hom.hom 1, by
          have h1 := congrArg (fun h => h.hom (1 : R)) ha
          simpa [b_hom] using h1⟩
      have hEpi_β : Epi (skyMap β) := by
        refine ⟨fun {D_sh} u₁ u₂ hu => ?_⟩
        apply Sheaf.hom_ext; ext opU : 2; apply ModuleCat.hom_ext; apply LinearMap.ext; intro t
        let b_sec : ∀ x : ↥S, GeomLifts x opU.unop → ↑(M₂ x) :=
          fun x γ => Classical.choose (hSurj_β x (t x γ))
        have hb_sec : ((skyMap β).hom.app opU).hom b_sec = t :=
          funext fun x => funext fun γ => Classical.choose_spec (hSurj_β x (t x γ))
        rw [← hb_sec]
        exact congrArg (fun h => (h.hom.app opU).hom b_sec) hu
      refine ⟨h0, hAbShortExactOfDesc (skyMap α) (skyMap β) h0 hMono_α hEpi_β ?_⟩
      intro D_sh u hu
      have hu_val : ∀ (opU : (S.Etale)ᵒᵖ) (b₁ b₂ : ↑((Sky M₂).obj.obj opU)),
          ((skyMap β).hom.app opU).hom b₁ = ((skyMap β).hom.app opU).hom b₂ →
          (u.hom.app opU).hom b₁ = (u.hom.app opU).hom b₂ := by
        intro opU b₁ b₂ hbeq
        have hdiff : ∀ (x : ↥S) (γ : GeomLifts x opU.unop),
            (β x).hom ((b₁ - b₂) x γ) = 0 := by
          intro x γ
          have hxy := congrFun (congrFun hbeq x) γ
          change (β x).hom (b₁ x γ - b₂ x γ) = 0
          rw [map_sub, sub_eq_zero]
          exact hxy
        let a_sec : ↑((Sky M₁).obj.obj opU) :=
          fun x γ => Classical.choose (hKer_β x ((b₁ - b₂) x γ) (hdiff x γ))
        have ha_sec : ((skyMap α).hom.app opU).hom a_sec = b₁ - b₂ :=
          funext fun x => funext fun γ =>
            Classical.choose_spec (hKer_β x ((b₁ - b₂) x γ) (hdiff x γ))
        have hu0 : (u.hom.app opU).hom (b₁ - b₂) = 0 := by
          rw [← ha_sec]
          exact congrArg (fun h => (h.hom.app opU).hom a_sec) hu
        rwa [map_sub, sub_eq_zero] at hu0
      let liftSec : ∀ (opU : (S.Etale)ᵒᵖ), ↑((Sky M₃).obj.obj opU) → ↑((Sky M₂).obj.obj opU) :=
        fun opU t x γ => Classical.choose (hSurj_β x (t x γ))
      have hliftSec : ∀ (opU : (S.Etale)ᵒᵖ) (t : ↑((Sky M₃).obj.obj opU)),
          ((skyMap β).hom.app opU).hom (liftSec opU t) = t :=
        fun opU t => funext fun x => funext fun γ => Classical.choose_spec (hSurj_β x (t x γ))
      let v : Sky M₃ ⟶ D_sh :=
        { hom :=
            { app := fun opU => ModuleCat.ofHom
                { toFun := fun t => (u.hom.app opU).hom (liftSec opU t)
                  map_add' := fun t₁ t₂ => by
                    rw [← map_add (u.hom.app opU).hom]
                    apply hu_val opU
                    rw [hliftSec, map_add, hliftSec, hliftSec]
                  map_smul' := fun r t => by
                    dsimp only [RingHom.id_apply]
                    rw [← map_smul (u.hom.app opU).hom]
                    apply hu_val opU
                    rw [hliftSec, map_smul, hliftSec] }
              naturality := fun {opU opV} f => by
                apply ModuleCat.hom_ext; apply LinearMap.ext; intro t
                have hnat_u : (u.hom.app opV).hom (((Sky M₂).obj.map f).hom (liftSec opU t)) =
                    (D_sh.obj.map f).hom ((u.hom.app opU).hom (liftSec opU t)) :=
                  congrArg (fun h => h.hom (liftSec opU t)) (u.hom.naturality f)
                change (u.hom.app opV).hom (liftSec opV (((Sky M₃).obj.map f).hom t)) =
                  (D_sh.obj.map f).hom ((u.hom.app opU).hom (liftSec opU t))
                rw [← hnat_u]
                apply hu_val opV
                rw [hliftSec]
                funext x γ
                exact (congrFun (congrFun (hliftSec opU t) x) (liftMap x f.unop γ)).symm } }
      refine ⟨v, ?_⟩
      apply Sheaf.hom_ext; ext opU : 2; apply ModuleCat.hom_ext; apply LinearMap.ext; intro b
      exact hu_val opU (liftSec opU (((skyMap β).hom.app opU).hom b)) b (hliftSec opU _)

    have hInjSky : ∀ (I : ↥S → ModR), (∀ x : ↥S, Injective (I x)) → Injective (Sky I) := by
      intro I hI
      have hInj_single : ∀ x : ↥S, Injective ((g_push x).obj (I x)) := by
        intro x
        have : Injective (I x) := hI x
        have : Limits.PreservesFiniteLimits (Stalk x) := (hStalkExact x).2
        have : (Stalk x).PreservesMonomorphisms := inferInstance
        refine ⟨fun {X_sh Y_sh} α f_m hf_m => ?_⟩
        have : Mono f_m := hf_m
        have : Mono ((Stalk x).map f_m) := (Stalk x).map_mono f_m
        let α' := ((adj_x x).homEquiv X_sh (I x)).symm α
        let β' := Injective.factorThru α' ((Stalk x).map f_m)
        refine ⟨(adj_x x).homEquiv Y_sh (I x) β', ?_⟩
        rw [← Adjunction.homEquiv_naturality_left, Injective.comp_factorThru, Equiv.apply_symm_apply]
      refine ⟨fun {X_sh Y_sh} α f_m hf_mono => ?_⟩
      have : Mono f_m := hf_mono
      let pr : ∀ x : ↥S, Sky I ⟶ (g_push x).obj (I x) := fun x =>
        { hom :=
            { app := fun _ => ModuleCat.ofHom
                { toFun := fun s => s x
                  map_add' := fun _ _ => rfl
                  map_smul' := fun _ _ => rfl }
              naturality := fun _ _ _ => rfl } }
      let β_coord : ∀ x : ↥S, Y_sh ⟶ (g_push x).obj (I x) := fun x =>
        letI : Injective ((g_push x).obj (I x)) := hInj_single x
        Injective.factorThru (α ≫ pr x) f_m
      have hβ_fac : ∀ x : ↥S, f_m ≫ β_coord x = α ≫ pr x := fun x => by
        have : Injective ((g_push x).obj (I x)) := hInj_single x
        exact Injective.comp_factorThru (α ≫ pr x) f_m
      let β : Y_sh ⟶ Sky I :=
        { hom :=
            { app := fun opU => ModuleCat.ofHom
                { toFun := fun y x γ => ((β_coord x).hom.app opU).hom y γ
                  map_add' := fun y₁ y₂ => funext fun x => funext fun γ =>
                    congrFun (((β_coord x).hom.app opU).hom.map_add y₁ y₂) γ
                  map_smul' := fun r y => funext fun x => funext fun γ =>
                    congrFun (((β_coord x).hom.app opU).hom.map_smul r y) γ }
              naturality := fun {opU opV} f_u => by
                apply ModuleCat.hom_ext; apply LinearMap.ext; intro y; funext x γ
                exact congrArg (fun h => h.hom y γ) ((β_coord x).hom.naturality f_u) } }
      refine ⟨β, ?_⟩
      apply Sheaf.hom_ext; ext opU : 2; apply ModuleCat.hom_ext
      apply LinearMap.ext; intro z; funext x γ
      exact congrArg (fun h => (h.hom.app opU).hom z γ) (hβ_fac x)

    let T_S₀ : S.Etale := MorphismProperty.Over.mk ⊤ (𝟙 S) inferInstance
    let hT_S₀ : Limits.IsTerminal T_S₀ :=
      Limits.IsTerminal.ofUniqueHom
        (fun W_et => MorphismProperty.Over.homMk W_et.hom (Category.comp_id W_et.hom) trivial)
        (fun W_et m_w => MorphismProperty.Comma.Hom.ext
          ((Category.comp_id m_w.left).symm.trans (MorphismProperty.Over.w m_w))
          (Subsingleton.elim _ _))
    let adj_c₀ := CategoryTheory.constantSheafAdj J ModR hT_S₀

    have hSkyAcyc : ∀ (n : ℕ) (M : ↥S → ModR)
        (e : Abelian.Ext.{u} oneR (Sky M) (n + 1)), e = 0 := by
      intro n
      induction n with
      | zero =>
        intro M e
        let I : ↥S → ModR := fun x => Injective.under (M x)
        let ι_I : ∀ x : ↥S, M x ⟶ I x := fun x => Injective.ι (M x)
        let N_q : ↥S → ModR := fun x => Limits.cokernel (ι_I x)
        let π_I : ∀ x : ↥S, I x ⟶ N_q x := fun x => Limits.cokernel.π (ι_I x)
        have : Injective (Sky I) := hInjSky I (fun _ => inferInstance)
        have hEx_pt : ∀ x : ↥S, ∃ hx : ι_I x ≫ π_I x = 0,
            (ShortComplex.mk (ι_I x) (π_I x) hx).ShortExact :=
          fun x => ⟨Limits.cokernel.condition (ι_I x),
            { exact := ShortComplex.exact_cokernel (ι_I x), mono_f := inferInstance, epi_g := inferInstance }⟩
        obtain ⟨h0_sky, hS_sky⟩ := hSkyShortExact M I N_q ι_I π_I hEx_pt
        let S_ex := ShortComplex.mk (skyMap ι_I) (skyMap π_I) h0_sky
        have he_f0 : e.comp (Abelian.Ext.mk₀ S_ex.f) (Nat.add_zero 1) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ oneR hS_sky e he_f0 rfl
        let u₃ : oneR ⟶ Sky N_q := Abelian.Ext.addEquiv₀ x₃
        let φ₃ : ModuleCat.of R R ⟶ (Sky N_q).obj.obj (Opposite.op T_S₀) :=
          adj_c₀.homEquiv (ModuleCat.of R R) (Sky N_q) u₃
        have hπ_surj : ∀ x : ↥S, Function.Surjective (π_I x).hom :=
          fun x => (ModuleCat.epi_iff_surjective (π_I x)).mp inferInstance
        let v_lift : ∀ x : ↥S, GeomLifts x T_S₀ → ↑(I x) :=
          fun x γ => Classical.choose (hπ_surj x (φ₃.hom 1 x γ))
        have hv_lift : ∀ (x : ↥S) (γ : GeomLifts x T_S₀),
            (π_I x).hom (v_lift x γ) = φ₃.hom 1 x γ :=
          fun x γ => Classical.choose_spec (hπ_surj x (φ₃.hom 1 x γ))
        let φ₂ : ModuleCat.of R R ⟶ (Sky I).obj.obj (Opposite.op T_S₀) :=
          ModuleCat.ofHom (LinearMap.toSpanSingleton R _ v_lift)
        have hφ₂_π : φ₂ ≫ S_ex.g.hom.app (Opposite.op T_S₀) = φ₃ := by
          apply ModuleCat.hom_ext; apply LinearMap.ext; intro r; funext x γ
          have hLHS : ((φ₂ ≫ S_ex.g.hom.app (Opposite.op T_S₀)).hom r) x γ =
              (π_I x).hom (r • v_lift x γ) := rfl
          have hRHS : (φ₃.hom r) x γ = (φ₃.hom (r • (1 : R))) x γ := by
            rw [smul_eq_mul, mul_one]
          rw [hLHS, hRHS, map_smul, hv_lift, φ₃.hom.map_smul]; rfl
        let u₂ : oneR ⟶ Sky I := (adj_c₀.homEquiv (ModuleCat.of R R) (Sky I)).symm φ₂
        have hu₂_g : u₂ ≫ S_ex.g = u₃ := by
          apply (adj_c₀.homEquiv (ModuleCat.of R R) (Sky N_q)).injective
          rw [Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply]
          exact hφ₂_π
        let x₂ : Abelian.Ext.{u} oneR (Sky I) 0 := Abelian.Ext.mk₀ u₂
        have hx₂_g : x₂.comp (Abelian.Ext.mk₀ S_ex.g) (Nat.add_zero 0) = x₃ := by
          apply Abelian.Ext.addEquiv₀.injective
          dsimp [x₂]
          rw [Abelian.Ext.mk₀_comp_mk₀, hu₂_g]
          simp [u₃]
        rw [← hx₃, ← hx₂_g,
          Abelian.Ext.comp_assoc x₂ (Abelian.Ext.mk₀ S_ex.g) hS_sky.extClass
            (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
          hS_sky.comp_extClass]
        simp
      | succ m' ih =>
        intro M e
        let I : ↥S → ModR := fun x => Injective.under (M x)
        let ι_I : ∀ x : ↥S, M x ⟶ I x := fun x => Injective.ι (M x)
        let N_q : ↥S → ModR := fun x => Limits.cokernel (ι_I x)
        let π_I : ∀ x : ↥S, I x ⟶ N_q x := fun x => Limits.cokernel.π (ι_I x)
        have : Injective (Sky I) := hInjSky I (fun _ => inferInstance)
        have hEx_pt : ∀ x : ↥S, ∃ hx : ι_I x ≫ π_I x = 0,
            (ShortComplex.mk (ι_I x) (π_I x) hx).ShortExact :=
          fun x => ⟨Limits.cokernel.condition (ι_I x),
            { exact := ShortComplex.exact_cokernel (ι_I x), mono_f := inferInstance, epi_g := inferInstance }⟩
        obtain ⟨h0_sky, hS_sky⟩ := hSkyShortExact M I N_q ι_I π_I hEx_pt
        let S_ex := ShortComplex.mk (skyMap ι_I) (skyMap π_I) h0_sky
        have he_f0 : e.comp (Abelian.Ext.mk₀ S_ex.f) (Nat.add_zero (m' + 2)) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ oneR hS_sky e he_f0 rfl
        rw [← hx₃, ih N_q x₃]
        simp

    let B : ℕ → 𝒞 := fun k => Nat.rec oneR (fun _ prev => T.obj prev) k
    let A : ℕ → 𝒞 := fun n => B (n + 1)
    let ε : oneR ⟶ A 0 := η_app oneR
    have helim0_sm : ∀ n : ℕ, StrictMono (Fin.elim0 : Fin 0 → Fin n) := fun _ i => Fin.elim0 i

    let mapBMono : ∀ (s r : ℕ) (θ : Fin r → Fin s), StrictMono θ → (B r ⟶ B s) :=
      Nat.rec
        (motive := fun s => ∀ (r : ℕ) (θ : Fin r → Fin s), StrictMono θ → (B r ⟶ B s))
        (fun r θ _ =>
          Nat.casesOn (motive := fun r => (Fin r → Fin 0) → (B r ⟶ B 0)) r
            (fun _ => 𝟙 (B 0))
            (fun _ θ' => Fin.elim0 (θ' 0))
            θ)
        (fun s' prev r θ hθ =>
          Nat.casesOn
            (motive := fun r => ∀ (θ : Fin r → Fin (s' + 1)), StrictMono θ → (B r ⟶ B (s' + 1))) r
            (fun _ _ => prev 0 Fin.elim0 (helim0_sm s') ≫ η_app (B s'))
            (fun r' θ₁ hθ₁ =>
              if _ : (θ₁ 0).1 = 0 then
                T.map (prev r'
                  (fun i => ⟨(θ₁ i.succ).1 - 1, by
                    have hlt : (θ₁ 0).1 < (θ₁ i.succ).1 := hθ₁ (Fin.succ_pos i)
                    have hi := (θ₁ i.succ).2
                    omega⟩)
                  (fun i j hij => by
                    change (θ₁ i.succ).1 - 1 < (θ₁ j.succ).1 - 1
                    have hlt0 : (θ₁ 0).1 < (θ₁ i.succ).1 := hθ₁ (Fin.succ_pos i)
                    have hlt1 : (θ₁ i.succ).1 < (θ₁ j.succ).1 := hθ₁ (Fin.succ_lt_succ_iff.mpr hij)
                    omega))
              else
                prev (r' + 1)
                  (fun i => ⟨(θ₁ i).1 - 1, by
                    have hle : (θ₁ 0).1 ≤ (θ₁ i).1 := hθ₁.monotone (Fin.zero_le i)
                    have hi := (θ₁ i).2
                    omega⟩)
                  (fun i j hij => by
                    change (θ₁ i).1 - 1 < (θ₁ j).1 - 1
                    have hle : (θ₁ 0).1 ≤ (θ₁ i).1 := hθ₁.monotone (Fin.zero_le i)
                    have hlt1 : (θ₁ i).1 < (θ₁ j).1 := hθ₁ hij
                    omega) ≫ η_app (B s'))
            θ hθ)

    have hmapB_congr : ∀ {s r : ℕ} (θ₁ θ₂ : Fin r → Fin s)
        (h₁ : StrictMono θ₁) (h₂ : StrictMono θ₂),
        (∀ i : Fin r, (θ₁ i).1 = (θ₂ i).1) →
        mapBMono s r θ₁ h₁ = mapBMono s r θ₂ h₂ := by
      intro s r θ₁ θ₂ h₁ h₂ heq
      have hθ : θ₁ = θ₂ := funext fun i => Fin.ext (heq i)
      subst hθ
      rfl

    have hmapB_succ_eq0 : ∀ {s' r' : ℕ} (θ : Fin (r' + 1) → Fin (s' + 1)) (hθ : StrictMono θ)
        (θ' : Fin r' → Fin s') (hθ' : StrictMono θ'),
        (θ 0).1 = 0 →
        (∀ i : Fin r', (θ i.succ).1 = (θ' i).1 + 1) →
        mapBMono (s' + 1) (r' + 1) θ hθ = T.map (mapBMono s' r' θ' hθ') := by
      intro s' r' θ hθ θ' hθ' h0 hpeel
      change (if _ : (θ 0).1 = 0 then T.map (mapBMono s' r' _ _) else _) =
        T.map (mapBMono s' r' θ' hθ')
      rw [dif_pos h0]
      congr 1
      apply hmapB_congr
      intro i
      dsimp only
      rw [hpeel i]
      omega

    have hmapB_succ_ne0 : ∀ {s' r' : ℕ} (θ : Fin (r' + 1) → Fin (s' + 1)) (hθ : StrictMono θ)
        (θ'' : Fin (r' + 1) → Fin s') (hθ'' : StrictMono θ''),
        (θ 0).1 ≠ 0 →
        (∀ i : Fin (r' + 1), (θ i).1 = (θ'' i).1 + 1) →
        mapBMono (s' + 1) (r' + 1) θ hθ = mapBMono s' (r' + 1) θ'' hθ'' ≫ η_app (B s') := by
      intro s' r' θ hθ θ'' hθ'' hne hpeel
      change (if _ : (θ 0).1 = 0 then _ else mapBMono s' (r' + 1) _ _ ≫ η_app (B s')) = _
      rw [dif_neg hne]
      congr 1
      apply hmapB_congr
      intro i
      dsimp only
      rw [hpeel i]
      omega

    have hmapB_id : ∀ (s : ℕ) (h : StrictMono (id : Fin s → Fin s)),
        mapBMono s s id h = 𝟙 (B s) := by
      intro s
      induction s with
      | zero => intro _; rfl
      | succ s' ih =>
        intro h
        rw [hmapB_succ_eq0 id h id strictMono_id rfl (fun _ => rfl), ih strictMono_id, T.map_id]

    have hmapB_comp : ∀ (c a b : ℕ) (θ₁ : Fin a → Fin b) (θ₂ : Fin b → Fin c)
        (h₁ : StrictMono θ₁) (h₂ : StrictMono θ₂) (h₁₂ : StrictMono (θ₂ ∘ θ₁)),
        mapBMono c a (θ₂ ∘ θ₁) h₁₂ = mapBMono b a θ₁ h₁ ≫ mapBMono c b θ₂ h₂ := by
      intro c
      induction c with
      | zero =>
        intro a b θ₁ θ₂ _ _ _
        cases b with
        | zero =>
          cases a with
          | zero =>
            change 𝟙 (B 0) = 𝟙 (B 0) ≫ 𝟙 (B 0)
            rw [Category.id_comp]
          | succ a' => exact Fin.elim0 (θ₁ 0)
        | succ b' => exact Fin.elim0 (θ₂ 0)
      | succ c' ih =>
        intro a b θ₁ θ₂ h₁ h₂ h₁₂
        cases b with
        | zero =>
          cases a with
          | zero =>
            change mapBMono c' 0 Fin.elim0 (helim0_sm c') ≫ η_app (B c') =
              𝟙 (B 0) ≫ mapBMono (c' + 1) 0 θ₂ h₂
            rw [Category.id_comp]
            rfl
          | succ a' => exact Fin.elim0 (θ₁ 0)
        | succ b' =>
          by_cases hθ₂0 : (θ₂ 0).1 = 0
          · let θ₂' : Fin b' → Fin c' := fun j => ⟨(θ₂ j.succ).1 - 1, by
              have hlt : (θ₂ 0).1 < (θ₂ j.succ).1 := h₂ (Fin.succ_pos j)
              have hj := (θ₂ j.succ).2
              omega⟩
            have hθ₂'_sm : StrictMono θ₂' := by
              intro i j hij
              change (θ₂ i.succ).1 - 1 < (θ₂ j.succ).1 - 1
              have hlt0 : (θ₂ 0).1 < (θ₂ i.succ).1 := h₂ (Fin.succ_pos i)
              have hlt1 : (θ₂ i.succ).1 < (θ₂ j.succ).1 := h₂ (Fin.succ_lt_succ_iff.mpr hij)
              omega
            have hpeel₂ : ∀ j : Fin b', (θ₂ j.succ).1 = (θ₂' j).1 + 1 := by
              intro j
              have hlt : (θ₂ 0).1 < (θ₂ j.succ).1 := h₂ (Fin.succ_pos j)
              dsimp [θ₂']; omega
            rw [hmapB_succ_eq0 θ₂ h₂ θ₂' hθ₂'_sm hθ₂0 hpeel₂]
            cases a with
            | zero =>
              change mapBMono c' 0 Fin.elim0 (helim0_sm c') ≫ η_app (B c') =
                (mapBMono b' 0 Fin.elim0 (helim0_sm b') ≫ η_app (B b')) ≫
                  T.map (mapBMono c' b' θ₂' hθ₂'_sm)
              rw [Category.assoc, ← hη_nat (mapBMono c' b' θ₂' hθ₂'_sm),
                ← Category.assoc,
                ← ih 0 b' Fin.elim0 θ₂' (helim0_sm b') hθ₂'_sm (hθ₂'_sm.comp (helim0_sm b'))]
              congr 1
              exact hmapB_congr _ _ _ _ (fun i => Fin.elim0 i)
            | succ a' =>
              by_cases hθ₁0 : (θ₁ 0).1 = 0
              · let θ₁' : Fin a' → Fin b' := fun i => ⟨(θ₁ i.succ).1 - 1, by
                  have hlt : (θ₁ 0).1 < (θ₁ i.succ).1 := h₁ (Fin.succ_pos i)
                  have hi := (θ₁ i.succ).2
                  omega⟩
                have hθ₁'_sm : StrictMono θ₁' := by
                  intro i j hij
                  change (θ₁ i.succ).1 - 1 < (θ₁ j.succ).1 - 1
                  have hlt0 : (θ₁ 0).1 < (θ₁ i.succ).1 := h₁ (Fin.succ_pos i)
                  have hlt1 : (θ₁ i.succ).1 < (θ₁ j.succ).1 := h₁ (Fin.succ_lt_succ_iff.mpr hij)
                  omega
                have hpeel₁ : ∀ i : Fin a', (θ₁ i.succ).1 = (θ₁' i).1 + 1 := by
                  intro i
                  have hlt : (θ₁ 0).1 < (θ₁ i.succ).1 := h₁ (Fin.succ_pos i)
                  dsimp [θ₁']; omega
                have h12_0 : ((θ₂ ∘ θ₁) 0).1 = 0 := by
                  have h0eq : θ₁ 0 = 0 := Fin.ext hθ₁0
                  change (θ₂ (θ₁ 0)).1 = 0
                  rw [h0eq]; exact hθ₂0
                have hpeel₁₂ : ∀ i : Fin a', ((θ₂ ∘ θ₁) i.succ).1 = ((θ₂' ∘ θ₁') i).1 + 1 := by
                  intro i
                  have hisucc : θ₁ i.succ = (θ₁' i).succ := Fin.ext (hpeel₁ i)
                  change (θ₂ (θ₁ i.succ)).1 = (θ₂' (θ₁' i)).1 + 1
                  rw [hisucc]
                  exact hpeel₂ (θ₁' i)
                rw [hmapB_succ_eq0 θ₁ h₁ θ₁' hθ₁'_sm hθ₁0 hpeel₁,
                  hmapB_succ_eq0 (θ₂ ∘ θ₁) h₁₂ (θ₂' ∘ θ₁') (hθ₂'_sm.comp hθ₁'_sm) h12_0 hpeel₁₂,
                  ih a' b' θ₁' θ₂' hθ₁'_sm hθ₂'_sm (hθ₂'_sm.comp hθ₁'_sm),
                  T.map_comp]
              · let θ₁'' : Fin (a' + 1) → Fin b' := fun i => ⟨(θ₁ i).1 - 1, by
                  have hle : (θ₁ 0).1 ≤ (θ₁ i).1 := h₁.monotone (Fin.zero_le i)
                  have hi := (θ₁ i).2
                  omega⟩
                have hθ₁''_sm : StrictMono θ₁'' := by
                  intro i j hij
                  change (θ₁ i).1 - 1 < (θ₁ j).1 - 1
                  have hle : (θ₁ 0).1 ≤ (θ₁ i).1 := h₁.monotone (Fin.zero_le i)
                  have hlt1 : (θ₁ i).1 < (θ₁ j).1 := h₁ hij
                  omega
                have hpeel₁ : ∀ i : Fin (a' + 1), (θ₁ i).1 = (θ₁'' i).1 + 1 := by
                  intro i
                  have hle : (θ₁ 0).1 ≤ (θ₁ i).1 := h₁.monotone (Fin.zero_le i)
                  dsimp [θ₁'']; omega
                have h12_ne0 : ((θ₂ ∘ θ₁) 0).1 ≠ 0 := by
                  have hpos : (0 : Fin (b' + 1)) < θ₁ 0 := by
                    change 0 < (θ₁ 0).1; omega
                  have hlt : (θ₂ 0).1 < (θ₂ (θ₁ 0)).1 := h₂ hpos
                  change (θ₂ (θ₁ 0)).1 ≠ 0
                  omega
                have hpeel₁₂ : ∀ i : Fin (a' + 1),
                    ((θ₂ ∘ θ₁) i).1 = ((θ₂' ∘ θ₁'') i).1 + 1 := by
                  intro i
                  have hi_eq : θ₁ i = (θ₁'' i).succ := Fin.ext (hpeel₁ i)
                  change (θ₂ (θ₁ i)).1 = (θ₂' (θ₁'' i)).1 + 1
                  rw [hi_eq]
                  exact hpeel₂ (θ₁'' i)
                rw [hmapB_succ_ne0 θ₁ h₁ θ₁'' hθ₁''_sm hθ₁0 hpeel₁,
                  hmapB_succ_ne0 (θ₂ ∘ θ₁) h₁₂ (θ₂' ∘ θ₁'') (hθ₂'_sm.comp hθ₁''_sm) h12_ne0 hpeel₁₂,
                  Category.assoc,
                  ← hη_nat (mapBMono c' b' θ₂' hθ₂'_sm),
                  ← Category.assoc,
                  ih (a' + 1) b' θ₁'' θ₂' hθ₁''_sm hθ₂'_sm (hθ₂'_sm.comp hθ₁''_sm)]
          · let θ₂'' : Fin (b' + 1) → Fin c' := fun j => ⟨(θ₂ j).1 - 1, by
              have hle : (θ₂ 0).1 ≤ (θ₂ j).1 := h₂.monotone (Fin.zero_le j)
              have hj := (θ₂ j).2
              omega⟩
            have hθ₂''_sm : StrictMono θ₂'' := by
              intro i j hij
              change (θ₂ i).1 - 1 < (θ₂ j).1 - 1
              have hle : (θ₂ 0).1 ≤ (θ₂ i).1 := h₂.monotone (Fin.zero_le i)
              have hlt1 : (θ₂ i).1 < (θ₂ j).1 := h₂ hij
              omega
            have hpeel₂ : ∀ j : Fin (b' + 1), (θ₂ j).1 = (θ₂'' j).1 + 1 := by
              intro j
              have hle : (θ₂ 0).1 ≤ (θ₂ j).1 := h₂.monotone (Fin.zero_le j)
              dsimp [θ₂'']; omega
            rw [hmapB_succ_ne0 θ₂ h₂ θ₂'' hθ₂''_sm hθ₂0 hpeel₂]
            cases a with
            | zero =>
              change mapBMono c' 0 Fin.elim0 (helim0_sm c') ≫ η_app (B c') =
                mapBMono (b' + 1) 0 θ₁ h₁ ≫ (mapBMono c' (b' + 1) θ₂'' hθ₂''_sm ≫ η_app (B c'))
              rw [← Category.assoc,
                ← ih 0 (b' + 1) θ₁ θ₂'' h₁ hθ₂''_sm (hθ₂''_sm.comp h₁)]
              congr 1
              exact hmapB_congr _ _ _ _ (fun i => Fin.elim0 i)
            | succ a' =>
              have h12_ne0 : ((θ₂ ∘ θ₁) 0).1 ≠ 0 := by
                have hle : (θ₂ 0).1 ≤ (θ₂ (θ₁ 0)).1 := h₂.monotone (Fin.zero_le _)
                change (θ₂ (θ₁ 0)).1 ≠ 0
                omega
              have hpeel₁₂ : ∀ i : Fin (a' + 1),
                  ((θ₂ ∘ θ₁) i).1 = ((θ₂'' ∘ θ₁) i).1 + 1 := fun i => hpeel₂ (θ₁ i)
              rw [hmapB_succ_ne0 (θ₂ ∘ θ₁) h₁₂ (θ₂'' ∘ θ₁) (hθ₂''_sm.comp h₁) h12_ne0 hpeel₁₂,
                ih (a' + 1) (b' + 1) θ₁ θ₂'' h₁ hθ₂''_sm (hθ₂''_sm.comp h₁),
                Category.assoc]

    let mapSheafMono : ∀ {r s : ℕ} (θ : Fin (r + 1) → Fin (s + 1)), StrictMono θ → (A r ⟶ A s) :=
      fun {r s} θ hθ => mapBMono (s + 1) (r + 1) θ hθ

    let d_mor : ∀ n : ℕ, A n ⟶ A (n + 1) := fun n =>
      ∑ i : Fin (n + 2), ((-1 : ℤ) ^ i.1) • mapSheafMono i.succAbove (Fin.strictMono_succAbove i)

    have hval_succAbove : ∀ {n : ℕ} (i : Fin (n + 1)) (x : Fin n),
        (i.succAbove x).1 = if x.1 < i.1 then x.1 else x.1 + 1 := by
      intro n i x
      unfold Fin.succAbove
      by_cases h : x.castSucc < i
      · have h' : x.1 < i.1 := h
        simp [h, h']
      · have h' : ¬ (x.1 < i.1) := h
        simp [h, h']

    let ηA : ∀ n : ℕ, A n ⟶ A (n + 1) := fun n => η_app (A n)
    let Td_ε : A 0 ⟶ A 1 := T.map ε
    let Td : ∀ n : ℕ, A (n + 1) ⟶ A (n + 2) := fun n => T.map (d_mor n)

    have hcoface0 : ∀ n : ℕ,
        mapSheafMono (0 : Fin (n + 2)).succAbove (Fin.strictMono_succAbove 0) = ηA n := by
      intro n
      have hne : ((0 : Fin (n + 2)).succAbove 0).1 ≠ 0 := by
        rw [hval_succAbove]; simp
      have hpeel : ∀ k : Fin (n + 1), ((0 : Fin (n + 2)).succAbove k).1 = (id k).1 + 1 := by
        intro k
        rw [hval_succAbove]
        simp
      change mapBMono ((n + 1) + 1) (n + 1) (0 : Fin (n + 2)).succAbove
          (Fin.strictMono_succAbove 0) = η_app (B (n + 1))
      rw [hmapB_succ_ne0 (0 : Fin (n + 2)).succAbove (Fin.strictMono_succAbove 0)
        id strictMono_id hne hpeel, hmapB_id (n + 1) strictMono_id,
        Category.id_comp]

    have hcoface_succ : ∀ (n : ℕ) (j : Fin (n + 1)),
        mapSheafMono (j.succ).succAbove (Fin.strictMono_succAbove j.succ) =
          T.map (mapBMono (n + 1) n j.succAbove (Fin.strictMono_succAbove j)) := by
      intro n j
      have h0 : ((j.succ).succAbove 0).1 = 0 := by
        rw [hval_succAbove, Fin.val_succ, Fin.val_zero]
        simp
      have hpeel : ∀ k : Fin n, ((j.succ).succAbove k.succ).1 = (j.succAbove k).1 + 1 := by
        intro k
        rw [hval_succAbove, hval_succAbove, Fin.val_succ, Fin.val_succ]
        split_ifs <;> omega
      exact hmapB_succ_eq0 (j.succ).succAbove (Fin.strictMono_succAbove j.succ)
        j.succAbove (Fin.strictMono_succAbove j) h0 hpeel

    have hd0_eq : d_mor 0 = ηA 0 - Td_ε := by
      dsimp only [d_mor]
      rw [Fin.sum_univ_succ, Fin.sum_univ_one, hcoface0 0, hcoface_succ 0 0]
      have h10 : mapBMono (0 + 1) 0 (0 : Fin 1).succAbove (Fin.strictMono_succAbove 0) = ε :=
        Category.id_comp _
      rw [h10, Fin.val_zero, pow_zero, one_smul, Fin.val_succ, Fin.val_zero]
      change ηA 0 + (-1 : ℤ) • Td_ε = ηA 0 - Td_ε
      rw [neg_one_smul, ← sub_eq_add_neg]

    have hd_succ : ∀ n : ℕ, d_mor (n + 1) = ηA (n + 1) - Td n := by
      intro n
      dsimp only [d_mor]
      rw [Fin.sum_univ_succ, hcoface0 (n + 1), Fin.val_zero, pow_zero, one_smul]
      have hsum_neg :
          (∑ j : Fin (n + 2),
            ((-1 : ℤ) ^ (j.succ).1) •
              mapSheafMono (j.succ).succAbove (Fin.strictMono_succAbove j.succ)) =
          -Td n := by
        have hTd_sum : Td n =
            ∑ j : Fin (n + 2),
              T.map (((-1 : ℤ) ^ j.1) • mapSheafMono j.succAbove (Fin.strictMono_succAbove j)) := by
          change T.map (d_mor n) = _
          dsimp only [d_mor]
          exact T.map_sum _ _
        rw [hTd_sum, ← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl fun j _ => ?_
        have h1 : ((-1 : ℤ) ^ (j.succ).1) •
              mapSheafMono (j.succ).succAbove (Fin.strictMono_succAbove j.succ) =
            -(((-1 : ℤ) ^ j.1) •
              mapSheafMono (j.succ).succAbove (Fin.strictMono_succAbove j.succ)) := by
          rw [Fin.val_succ, pow_succ, mul_neg, mul_one, neg_zsmul]
        have h2 : ((-1 : ℤ) ^ j.1) •
              mapSheafMono (j.succ).succAbove (Fin.strictMono_succAbove j.succ) =
            T.map (((-1 : ℤ) ^ j.1) • mapSheafMono j.succAbove (Fin.strictMono_succAbove j)) := by
          refine (congrArg (((-1 : ℤ) ^ j.1) • ·) (hcoface_succ (n + 1) j)).trans ?_
          exact (Functor.map_zsmul T).symm
        exact h1.trans (congrArg Neg.neg h2)
      rw [hsum_neg, ← sub_eq_add_neg]

    let stalkCounit : ∀ (x : ↥S) (M : ↥S → ModR), (Stalk x).obj (Sky M) ⟶ M x :=
      fun x M =>
        Limits.colimit.desc (W x ⋙ (Sky M).obj)
          { pt := M x
            ι :=
              { app := fun i => ModuleCat.ofHom
                  { toFun := fun s => s x (liftOf x i)
                    map_add' := fun _ _ => rfl
                    map_smul' := fun _ _ => rfl }
                naturality := fun {i j} f => by
                  apply ModuleCat.hom_ext; apply LinearMap.ext; intro s
                  change s x (liftMap x ((W x).map f).unop (liftOf x j)) = s x (liftOf x i)
                  rw [hLiftCompat x f] } }

    have hcounit_η₀ : ∀ (x : ↥S) (X : 𝒞),
        (Stalk x).map (η_app X) ≫ stalkCounit x (fun y => (Stalk y).obj X) =
          𝟙 ((Stalk x).obj X) := by
      intro x X
      apply Limits.colimit.hom_ext
      intro i
      change (Limits.colimit.ι (W x ⋙ X.obj) i ≫
          Limits.colimMap (Functor.whiskerLeft (W x) (η_app X).hom)) ≫
          stalkCounit x _ = Limits.colimit.ι (W x ⋙ X.obj) i ≫ 𝟙 _
      rw [Limits.ι_colimMap, Category.assoc, Limits.colimit.ι_desc, Category.comp_id]
      apply ModuleCat.hom_ext; apply LinearMap.ext; intro z
      change (germ x X ((W x).obj i).unop (liftOf x i)).hom z =
        (Limits.colimit.ι (W x ⋙ X.obj) i).hom z
      rw [hgerm_diag x X i]

    have hcounit_Tmap : ∀ (x : ↥S) {X Y : 𝒞} (φ : X ⟶ Y),
        (Stalk x).map (T.map φ) ≫ stalkCounit x (fun y => (Stalk y).obj Y) =
          stalkCounit x (fun y => (Stalk y).obj X) ≫ (Stalk x).map φ := by
      intro x X Y φ
      apply Limits.colimit.hom_ext
      intro i
      change (Limits.colimit.ι (W x ⋙ (T.obj X).obj) i ≫
          Limits.colimMap (Functor.whiskerLeft (W x) (T.map φ).hom)) ≫
          stalkCounit x _ =
        (Limits.colimit.ι (W x ⋙ (T.obj X).obj) i ≫ stalkCounit x _) ≫ (Stalk x).map φ
      rw [Limits.ι_colimMap, Category.assoc, Limits.colimit.ι_desc, Limits.colimit.ι_desc]
      rfl

    have hMono_ε : Mono ε := by
      refine ⟨fun {Z_sh} z₁ z₂ hz => ?_⟩
      suffices hsub : z₁ - z₂ = 0 from sub_eq_zero.mp hsub
      apply hStalkZero
      intro x
      have : (Stalk x).Additive := (hStalkExact x).1
      have hz0 : (z₁ - z₂) ≫ ε = 0 := by rw [Preadditive.sub_comp, hz, sub_self]
      calc
        (Stalk x).map (z₁ - z₂) =
            (Stalk x).map (z₁ - z₂) ≫
              ((Stalk x).map ε ≫ stalkCounit x (fun y => (Stalk y).obj oneR)) := by
          rw [hcounit_η₀ x oneR, Category.comp_id]
        _ = (Stalk x).map ((z₁ - z₂) ≫ ε) ≫ stalkCounit x _ := by
          rw [← Category.assoc, ← (Stalk x).map_comp]
        _ = 0 := by rw [hz0, Functor.map_zero, Limits.zero_comp]

    have hε_ηA : ε ≫ ηA 0 = ε ≫ Td_ε := hη_nat ε
    have hd_ηA : ∀ n : ℕ, d_mor n ≫ ηA (n + 1) = ηA n ≫ Td n := fun n => hη_nat (d_mor n)

    have hε_d0 : ε ≫ d_mor 0 = 0 := by
      rw [hd0_eq, Preadditive.comp_sub, hε_ηA, sub_self]

    have hd_sq : ∀ n : ℕ, d_mor n ≫ d_mor (n + 1) = 0 := by
      intro n
      induction n with
      | zero =>
        have hTd_ε_0 : Td_ε ≫ Td 0 = 0 := by
          change T.map ε ≫ T.map (d_mor 0) = 0
          rw [← T.map_comp, hε_d0, Functor.map_zero]
        rw [hd_succ 0, Preadditive.comp_sub, hd_ηA 0, hd0_eq,
          Preadditive.sub_comp, hTd_ε_0, sub_zero, sub_self]
      | succ n ih =>
        have hTd_succ : Td n ≫ Td (n + 1) = 0 := by
          change T.map (d_mor n) ≫ T.map (d_mor (n + 1)) = 0
          rw [← T.map_comp, ih, Functor.map_zero]
        rw [hd_succ (n + 1), Preadditive.comp_sub, hd_ηA (n + 1), hd_succ n,
          Preadditive.sub_comp, hTd_succ, sub_zero, sub_self]

    have hExactFromStalkHom : ∀ {X Y Z : 𝒞} (f : X ⟶ Y) (g : Y ⟶ Z) (hfg : f ≫ g = 0),
        (∀ x : ↥S,
          ∃ (s_x : (Stalk x).obj Y ⟶ (Stalk x).obj X)
            (t_x : (Stalk x).obj Z ⟶ (Stalk x).obj Y),
            s_x ≫ (Stalk x).map f + (Stalk x).map g ≫ t_x = 𝟙 ((Stalk x).obj Y)) →
        (ShortComplex.mk f g hfg).Exact := by
      intro X Y Z f g hfg hHom
      apply hAbExactOfHomotopy f g hfg
      apply hStalkZero
      intro x
      have : (Stalk x).Additive := (hStalkExact x).1
      obtain ⟨s_x, t_x, hst⟩ := hHom x
      have hk0 : (Stalk x).map (Limits.kernel.ι g) ≫ (Stalk x).map g = 0 := by
        rw [← (Stalk x).map_comp, Limits.kernel.condition, Functor.map_zero]
      have hp0 : (Stalk x).map f ≫ (Stalk x).map (Limits.cokernel.π f) = 0 := by
        rw [← (Stalk x).map_comp, Limits.cokernel.condition, Functor.map_zero]
      calc
        (Stalk x).map (Limits.kernel.ι g ≫ Limits.cokernel.π f) =
            (Stalk x).map (Limits.kernel.ι g) ≫ 𝟙 ((Stalk x).obj Y) ≫
              (Stalk x).map (Limits.cokernel.π f) := by
          rw [Category.id_comp, (Stalk x).map_comp]
        _ = (Stalk x).map (Limits.kernel.ι g) ≫
              (s_x ≫ (Stalk x).map f + (Stalk x).map g ≫ t_x) ≫
              (Stalk x).map (Limits.cokernel.π f) := by rw [hst]
        _ = ((Stalk x).map (Limits.kernel.ι g) ≫ s_x) ≫
              ((Stalk x).map f ≫ (Stalk x).map (Limits.cokernel.π f)) +
            ((Stalk x).map (Limits.kernel.ι g) ≫ (Stalk x).map g) ≫
              (t_x ≫ (Stalk x).map (Limits.cokernel.π f)) := by
          simp only [Preadditive.add_comp, Preadditive.comp_add, Category.assoc]
        _ = 0 := by rw [hp0, hk0, Limits.comp_zero, Limits.zero_comp, add_zero]

    have hEx0_A : (ShortComplex.mk ε (d_mor 0) hε_d0).Exact := by
      apply hExactFromStalkHom ε (d_mor 0) hε_d0
      intro x
      have : (Stalk x).Additive := (hStalkExact x).1
      refine ⟨stalkCounit x (fun y => (Stalk y).obj oneR),
        stalkCounit x (fun y => (Stalk y).obj (A 0)), ?_⟩
      have hc1 : (Stalk x).map (ηA 0) ≫ stalkCounit x (fun y => (Stalk y).obj (A 0)) =
          𝟙 ((Stalk x).obj (A 0)) := hcounit_η₀ x (A 0)
      have hc2 : (Stalk x).map Td_ε ≫ stalkCounit x (fun y => (Stalk y).obj (A 0)) =
          stalkCounit x (fun y => (Stalk y).obj oneR) ≫ (Stalk x).map ε := hcounit_Tmap x ε
      rw [hd0_eq, Functor.map_sub, Preadditive.sub_comp, hc1, hc2]
      abel

    have hEx_A : ∀ n : ℕ, (ShortComplex.mk (d_mor n) (d_mor (n + 1)) (hd_sq n)).Exact := by
      intro n
      apply hExactFromStalkHom (d_mor n) (d_mor (n + 1)) (hd_sq n)
      intro x
      have : (Stalk x).Additive := (hStalkExact x).1
      refine ⟨stalkCounit x (fun y => (Stalk y).obj (A n)),
        stalkCounit x (fun y => (Stalk y).obj (A (n + 1))), ?_⟩
      have hc1 : (Stalk x).map (ηA (n + 1)) ≫ stalkCounit x (fun y => (Stalk y).obj (A (n + 1))) =
          𝟙 ((Stalk x).obj (A (n + 1))) := hcounit_η₀ x (A (n + 1))
      have hc2 : (Stalk x).map (Td n) ≫ stalkCounit x (fun y => (Stalk y).obj (A (n + 1))) =
          stalkCounit x (fun y => (Stalk y).obj (A n)) ≫ (Stalk x).map (d_mor n) :=
        hcounit_Tmap x (d_mor n)
      rw [hd_succ n, Functor.map_sub, Preadditive.sub_comp, hc1, hc2]
      abel

    have hFilteredColimAlg :
        ∀ {ℐ₀ : Type u} [CategoryTheory.SmallCategory ℐ₀] [CategoryTheory.IsFiltered ℐ₀]
          (D : ℐ₀ ⥤ ModR)
          (oneD : ∀ i : ℐ₀, ↑(D.obj i))
          (mulD : ∀ i : ℐ₀, ↑(D.obj i) →ₗ[R] ↑(D.obj i) →ₗ[R] ↑(D.obj i)),
          (∀ (i : ℐ₀) (a b c : ↑(D.obj i)), mulD i (mulD i a b) c = mulD i a (mulD i b c)) →
          (∀ (i : ℐ₀) (a b : ↑(D.obj i)), mulD i a b = mulD i b a) →
          (∀ (i : ℐ₀) (a : ↑(D.obj i)), mulD i (oneD i) a = a) →
          (∀ {i j : ℐ₀} (f : i ⟶ j), (D.map f).hom (oneD i) = oneD j) →
          (∀ {i j : ℐ₀} (f : i ⟶ j) (a b : ↑(D.obj i)),
            (D.map f).hom (mulD i a b) = mulD j ((D.map f).hom a) ((D.map f).hom b)) →
          ∃ (oneC : ↑(Limits.colimit D))
            (mulC : ↑(Limits.colimit D) →ₗ[R] ↑(Limits.colimit D) →ₗ[R] ↑(Limits.colimit D)),
            (∀ i : ℐ₀, (Limits.colimit.ι D i).hom (oneD i) = oneC) ∧
            (∀ (i : ℐ₀) (a b : ↑(D.obj i)),
              (Limits.colimit.ι D i).hom (mulD i a b) =
                mulC ((Limits.colimit.ι D i).hom a) ((Limits.colimit.ι D i).hom b)) ∧
            (∀ x y z : ↑(Limits.colimit D), mulC (mulC x y) z = mulC x (mulC y z)) ∧
            (∀ x y : ↑(Limits.colimit D), mulC x y = mulC y x) ∧
            (∀ x : ↑(Limits.colimit D), mulC oneC x = x) := by
      intro ℐ₀ _ _ D oneD mulD h_assoc h_comm h_one h_map_one h_map_mul
      let hc := Limits.colimit.isColimit D
      have hCommon2 : ∀ x y : ↑(Limits.colimit D),
          ∃ (k : ℐ₀) (a b : ↑(D.obj k)),
            (Limits.colimit.ι D k).hom a = x ∧ (Limits.colimit.ι D k).hom b = y := by
        intro x y
        obtain ⟨i₁, a₁, ha₁⟩ := Limits.Concrete.colimit_exists_rep D x
        obtain ⟨i₂, b₂, hb₂⟩ := Limits.Concrete.colimit_exists_rep D y
        let k := IsFiltered.max i₁ i₂
        let f₁ : i₁ ⟶ k := IsFiltered.leftToMax i₁ i₂
        let f₂ : i₂ ⟶ k := IsFiltered.rightToMax i₁ i₂
        refine ⟨k, (D.map f₁).hom a₁, (D.map f₂).hom b₂, ?_, ?_⟩
        · have hw := congrArg (fun h => h.hom a₁) (Limits.colimit.w D f₁)
          exact hw.trans ha₁
        · have hw := congrArg (fun h => h.hom b₂) (Limits.colimit.w D f₂)
          exact hw.trans hb₂
      have hCommon3 : ∀ x y z : ↑(Limits.colimit D),
          ∃ (k : ℐ₀) (a b c : ↑(D.obj k)),
            (Limits.colimit.ι D k).hom a = x ∧
            (Limits.colimit.ι D k).hom b = y ∧
            (Limits.colimit.ι D k).hom c = z := by
        intro x y z
        obtain ⟨k₁, a₁, b₁, ha₁, hb₁⟩ := hCommon2 x y
        obtain ⟨i₃, c₃, hc₃⟩ := Limits.Concrete.colimit_exists_rep D z
        let k := IsFiltered.max k₁ i₃
        let f₁ : k₁ ⟶ k := IsFiltered.leftToMax k₁ i₃
        let f₃ : i₃ ⟶ k := IsFiltered.rightToMax k₁ i₃
        refine ⟨k, (D.map f₁).hom a₁, (D.map f₁).hom b₁, (D.map f₃).hom c₃, ?_, ?_, ?_⟩
        · exact (congrArg (fun h => h.hom a₁) (Limits.colimit.w D f₁)).trans ha₁
        · exact (congrArg (fun h => h.hom b₁) (Limits.colimit.w D f₁)).trans hb₁
        · exact (congrArg (fun h => h.hom c₃) (Limits.colimit.w D f₃)).trans hc₃
      have hIndep : ∀ (i₁ i₂ : ℐ₀) (a₁ b₁ : ↑(D.obj i₁)) (a₂ b₂ : ↑(D.obj i₂)),
          (Limits.colimit.ι D i₁).hom a₁ = (Limits.colimit.ι D i₂).hom a₂ →
          (Limits.colimit.ι D i₁).hom b₁ = (Limits.colimit.ι D i₂).hom b₂ →
          (Limits.colimit.ι D i₁).hom (mulD i₁ a₁ b₁) =
            (Limits.colimit.ι D i₂).hom (mulD i₂ a₂ b₂) := by
        intro i₁ i₂ a₁ b₁ a₂ b₂ ha hb
        obtain ⟨k_a, fa₁, fa₂, hfa⟩ :=
          (Limits.Concrete.isColimit_rep_eq_iff_exists D hc a₁ a₂).mp ha
        obtain ⟨k_b, fb₁, fb₂, hfb⟩ :=
          (Limits.Concrete.isColimit_rep_eq_iff_exists D hc b₁ b₂).mp hb
        let k₀ := IsFiltered.max k_a k_b
        let ga : k_a ⟶ k₀ := IsFiltered.leftToMax k_a k_b
        let gb : k_b ⟶ k₀ := IsFiltered.rightToMax k_a k_b
        let h₁ := IsFiltered.coeqHom (fa₁ ≫ ga) (fb₁ ≫ gb)
        have hh₁ : (fa₁ ≫ ga) ≫ h₁ = (fb₁ ≫ gb) ≫ h₁ :=
          IsFiltered.coeq_condition (fa₁ ≫ ga) (fb₁ ≫ gb)
        let h₂ := IsFiltered.coeqHom ((fa₂ ≫ ga) ≫ h₁) ((fb₂ ≫ gb) ≫ h₁)
        have hh₂ : ((fa₂ ≫ ga) ≫ h₁) ≫ h₂ = ((fb₂ ≫ gb) ≫ h₁) ≫ h₂ :=
          IsFiltered.coeq_condition ((fa₂ ≫ ga) ≫ h₁) ((fb₂ ≫ gb) ≫ h₁)
        let v₁ := ((fa₁ ≫ ga) ≫ h₁) ≫ h₂
        let v₂ := ((fa₂ ≫ ga) ≫ h₁) ≫ h₂
        have ha_eq : (D.map v₁).hom a₁ = (D.map v₂).hom a₂ := by
          have hfa' : (D.map fa₁).hom a₁ = (D.map fa₂).hom a₂ := hfa
          calc
            (D.map v₁).hom a₁ = (D.map (ga ≫ h₁ ≫ h₂)).hom ((D.map fa₁).hom a₁) := by
              dsimp [v₁]; simp only [Category.assoc, Functor.map_comp]; rfl
            _ = (D.map (ga ≫ h₁ ≫ h₂)).hom ((D.map fa₂).hom a₂) := by rw [hfa']
            _ = (D.map v₂).hom a₂ := by
              dsimp [v₂]; simp only [Category.assoc, Functor.map_comp]; rfl
        have hb_eq : (D.map v₁).hom b₁ = (D.map v₂).hom b₂ := by
          have hfb' : (D.map fb₁).hom b₁ = (D.map fb₂).hom b₂ := hfb
          have hv₁_b : v₁ = ((fb₁ ≫ gb) ≫ h₁) ≫ h₂ := by dsimp [v₁]; rw [hh₁]
          have hv₂_b : v₂ = ((fb₂ ≫ gb) ≫ h₁) ≫ h₂ := by dsimp [v₂]; rw [hh₂]
          calc
            (D.map v₁).hom b₁ = (D.map (gb ≫ h₁ ≫ h₂)).hom ((D.map fb₁).hom b₁) := by
              rw [hv₁_b]; simp only [Category.assoc, Functor.map_comp]; rfl
            _ = (D.map (gb ≫ h₁ ≫ h₂)).hom ((D.map fb₂).hom b₂) := by rw [hfb']
            _ = (D.map v₂).hom b₂ := by
              rw [hv₂_b]; simp only [Category.assoc, Functor.map_comp]; rfl
        calc
          (Limits.colimit.ι D i₁).hom (mulD i₁ a₁ b₁) =
              (Limits.colimit.ι D _).hom ((D.map v₁).hom (mulD i₁ a₁ b₁)) :=
            (congrArg (fun h => h.hom (mulD i₁ a₁ b₁)) (Limits.colimit.w D v₁)).symm
          _ = (Limits.colimit.ι D _).hom (mulD _ ((D.map v₁).hom a₁) ((D.map v₁).hom b₁)) := by
            rw [h_map_mul v₁ a₁ b₁]
          _ = (Limits.colimit.ι D _).hom (mulD _ ((D.map v₂).hom a₂) ((D.map v₂).hom b₂)) := by
            rw [ha_eq, hb_eq]
          _ = (Limits.colimit.ι D _).hom ((D.map v₂).hom (mulD i₂ a₂ b₂)) := by
            rw [← h_map_mul v₂ a₂ b₂]
          _ = (Limits.colimit.ι D i₂).hom (mulD i₂ a₂ b₂) :=
            congrArg (fun h => h.hom (mulD i₂ a₂ b₂)) (Limits.colimit.w D v₂)
      let mulRaw : ↑(Limits.colimit D) → ↑(Limits.colimit D) → ↑(Limits.colimit D) :=
        fun x y =>
          let k := Classical.choose (hCommon2 x y)
          let spec₁ := Classical.choose_spec (hCommon2 x y)
          let a := Classical.choose spec₁
          let spec₂ := Classical.choose_spec spec₁
          let b := Classical.choose spec₂
          (Limits.colimit.ι D k).hom (mulD k a b)
      have hmulRaw_eq : ∀ (k : ℐ₀) (a b : ↑(D.obj k)),
          mulRaw ((Limits.colimit.ι D k).hom a) ((Limits.colimit.ι D k).hom b) =
            (Limits.colimit.ι D k).hom (mulD k a b) := by
        intro k a b
        let x := (Limits.colimit.ι D k).hom a
        let y := (Limits.colimit.ι D k).hom b
        let k₀ := Classical.choose (hCommon2 x y)
        let spec₁ := Classical.choose_spec (hCommon2 x y)
        let a₀ := Classical.choose spec₁
        let spec₂ := Classical.choose_spec spec₁
        let b₀ := Classical.choose spec₂
        have hab₀ := Classical.choose_spec spec₂
        exact hIndep k₀ k a₀ b₀ a b hab₀.1 hab₀.2
      let i₀ : ℐ₀ := IsFiltered.nonempty.some
      let oneC : ↑(Limits.colimit D) := (Limits.colimit.ι D i₀).hom (oneD i₀)
      have honeC_eq : ∀ i : ℐ₀, (Limits.colimit.ι D i).hom (oneD i) = oneC := by
        intro i
        let m := IsFiltered.max i i₀
        let fi : i ⟶ m := IsFiltered.leftToMax i i₀
        let f0 : i₀ ⟶ m := IsFiltered.rightToMax i i₀
        calc
          (Limits.colimit.ι D i).hom (oneD i) =
              (Limits.colimit.ι D m).hom ((D.map fi).hom (oneD i)) :=
            (congrArg (fun h => h.hom (oneD i)) (Limits.colimit.w D fi)).symm
          _ = (Limits.colimit.ι D m).hom (oneD m) := by rw [h_map_one fi]
          _ = (Limits.colimit.ι D m).hom ((D.map f0).hom (oneD i₀)) := by rw [← h_map_one f0]
          _ = oneC := congrArg (fun h => h.hom (oneD i₀)) (Limits.colimit.w D f0)
      have hraw_comm : ∀ x y, mulRaw x y = mulRaw y x := by
        intro x y
        obtain ⟨k, a, b, rfl, rfl⟩ := hCommon2 x y
        rw [hmulRaw_eq, hmulRaw_eq, h_comm]
      have hraw_add_right : ∀ x y₁ y₂, mulRaw x (y₁ + y₂) = mulRaw x y₁ + mulRaw x y₂ := by
        intro x y₁ y₂
        obtain ⟨k, a, b₁, b₂, rfl, rfl, rfl⟩ := hCommon3 x y₁ y₂
        rw [← map_add (Limits.colimit.ι D k).hom b₁ b₂, hmulRaw_eq, hmulRaw_eq, hmulRaw_eq,
          map_add (mulD k a), map_add (Limits.colimit.ι D k).hom]
      have hraw_smul_right : ∀ (r : R) x y, mulRaw x (r • y) = r • mulRaw x y := by
        intro r x y
        obtain ⟨k, a, b, rfl, rfl⟩ := hCommon2 x y
        rw [← map_smul (Limits.colimit.ι D k).hom r b, hmulRaw_eq, hmulRaw_eq,
          LinearMap.map_smul (mulD k a), map_smul (Limits.colimit.ι D k).hom]
      let mulC : ↑(Limits.colimit D) →ₗ[R] ↑(Limits.colimit D) →ₗ[R] ↑(Limits.colimit D) :=
        { toFun := fun x =>
            { toFun := fun y => mulRaw x y
              map_add' := fun y₁ y₂ => hraw_add_right x y₁ y₂
              map_smul' := fun r y => hraw_smul_right r x y }
          map_add' := fun x₁ x₂ => by
            apply LinearMap.ext; intro y
            change mulRaw (x₁ + x₂) y = mulRaw x₁ y + mulRaw x₂ y
            rw [hraw_comm (x₁ + x₂) y, hraw_add_right y x₁ x₂, hraw_comm y x₁, hraw_comm y x₂]
          map_smul' := fun r x => by
            apply LinearMap.ext; intro y
            change mulRaw (r • x) y = r • mulRaw x y
            rw [hraw_comm (r • x) y, hraw_smul_right r y x, hraw_comm y x] }
      refine ⟨oneC, mulC, honeC_eq, fun i a b => (hmulRaw_eq i a b).symm, ?_, hraw_comm, ?_⟩
      · intro x y z
        obtain ⟨k, a, b, c, rfl, rfl, rfl⟩ := hCommon3 x y z
        change mulRaw (mulRaw _ _) _ = mulRaw _ (mulRaw _ _)
        rw [hmulRaw_eq, hmulRaw_eq, hmulRaw_eq, hmulRaw_eq, h_assoc]
      · intro x
        obtain ⟨k, a, rfl⟩ := Limits.Concrete.colimit_exists_rep D x
        rw [← honeC_eq k]
        change mulRaw _ _ = _
        rw [hmulRaw_eq, h_one]

    let e₀ : ↑(oneR.obj.obj (Opposite.op T_S₀)) :=
      (adj_c₀.unit.app (ModuleCat.of R R)).hom (1 : R)
    let γ₀ : ∀ x : ↥S, GeomLifts x T_S₀ := fun x => ⟨geomHom x, Category.comp_id _⟩
    have hγ₀_uniq : ∀ (x : ↥S) (γ : GeomLifts x T_S₀), γ = γ₀ x :=
      fun x γ => Subtype.ext ((Category.comp_id γ.1).symm.trans γ.2)
    let oneStalk₀ : ∀ x : ↥S, ↑((Stalk x).obj oneR) :=
      fun x => (germ x oneR T_S₀ (γ₀ x)).hom e₀
    let c_hom₀ : ∀ x : ↥S,
        ModuleCat.of R R ⟶ ((g_push x).obj (ModuleCat.of R R)).obj.obj (Opposite.op T_S₀) :=
      fun _ => ModuleCat.ofHom
        { toFun := fun r _ => r
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
    let β_base₀ : ∀ x : ↥S, oneR ⟶ (g_push x).obj (ModuleCat.of R R) :=
      fun x => (adj_c₀.homEquiv (ModuleCat.of R R) ((g_push x).obj (ModuleCat.of R R))).symm (c_hom₀ x)
    let fromStalk₀ : ∀ x : ↥S, (Stalk x).obj oneR ⟶ ModuleCat.of R R :=
      fun x => Limits.colimit.desc (W x ⋙ oneR.obj) (coconeOf x (β_base₀ x))

    have hfromStalk₀_one : ∀ x : ↥S, (fromStalk₀ x).hom (oneStalk₀ x) = (1 : R) := by
      intro x
      have hβ_unit : adj_c₀.unit.app (ModuleCat.of R R) ≫
          (β_base₀ x).hom.app (Opposite.op T_S₀) = c_hom₀ x :=
        (Adjunction.homEquiv_unit adj_c₀ (ModuleCat.of R R)
          ((g_push x).obj (ModuleCat.of R R)) (β_base₀ x)).symm.trans
          ((adj_c₀.homEquiv (ModuleCat.of R R)
            ((g_push x).obj (ModuleCat.of R R))).apply_symm_apply (c_hom₀ x))
      have hβ_e0 : ((β_base₀ x).hom.app (Opposite.op T_S₀)).hom e₀ (γ₀ x) = (1 : R) :=
        congrFun (congrArg (fun h => h.hom (1 : R)) hβ_unit) (γ₀ x)
      obtain ⟨i, w, hw⟩ := hShrink x T_S₀ (γ₀ x)
      dsimp only [fromStalk₀, oneStalk₀]
      rw [hgerm_eq x oneR T_S₀ (γ₀ x) i w hw]
      change (Limits.colimit.ι (W x ⋙ oneR.obj) i ≫
          Limits.colimit.desc (W x ⋙ oneR.obj) (coconeOf x (β_base₀ x))).hom
          ((oneR.obj.map w.op).hom e₀) = 1
      rw [Limits.colimit.ι_desc]
      have hnat : (((β_base₀ x).hom.app ((W x).obj i)).hom ((oneR.obj.map w.op).hom e₀))
          (liftOf x i) =
        (((β_base₀ x).hom.app (Opposite.op T_S₀)).hom e₀) (liftMap x w (liftOf x i)) :=
        congrArg (fun h => h.hom e₀ (liftOf x i)) ((β_base₀ x).hom.naturality w.op)
      change (((β_base₀ x).hom.app ((W x).obj i)).hom ((oneR.obj.map w.op).hom e₀))
          (liftOf x i) = 1
      rw [hnat, hw, hβ_e0]

    have hStalk₀_ext : ∀ (x : ↥S) {M : ModR} (α₁ α₂ : (Stalk x).obj oneR ⟶ M),
        α₁.hom (oneStalk₀ x) = α₂.hom (oneStalk₀ x) → α₁ = α₂ := by
      intro x M α₁ α₂ h1
      apply (stalkHomEquiv x oneR M).injective
      apply (adj_c₀.homEquiv (ModuleCat.of R R) ((g_push x).obj M)).injective
      rw [Adjunction.homEquiv_unit, Adjunction.homEquiv_unit]
      apply ModuleCat.hom_ext
      apply LinearMap.ext_ring
      funext γ
      rw [hγ₀_uniq x γ]
      exact h1

    have hStalk₀_smul_eq : ∀ (x : ↥S) (z : ↑((Stalk x).obj oneR)),
        ((fromStalk₀ x).hom z) • oneStalk₀ x = z := by
      intro x z
      let toStalk₀ : ModuleCat.of R R ⟶ (Stalk x).obj oneR :=
        ModuleCat.ofHom (LinearMap.toSpanSingleton R _ (oneStalk₀ x))
      have hcomp_id : fromStalk₀ x ≫ toStalk₀ = 𝟙 ((Stalk x).obj oneR) := by
        apply hStalk₀_ext x
        change ((fromStalk₀ x).hom (oneStalk₀ x)) • oneStalk₀ x = oneStalk₀ x
        rw [hfromStalk₀_one x, one_smul]
      exact congrArg (fun h => h.hom z) hcomp_id

    let mulStalk₀ : ∀ x : ↥S,
        ↑((Stalk x).obj oneR) →ₗ[R] ↑((Stalk x).obj oneR) →ₗ[R] ↑((Stalk x).obj oneR) :=
      fun x =>
        { toFun := fun u =>
            { toFun := fun v => ((fromStalk₀ x).hom u * (fromStalk₀ x).hom v) • oneStalk₀ x
              map_add' := fun v₁ v₂ => by
                rw [map_add, mul_add, add_smul]
              map_smul' := fun r v => by
                dsimp only [RingHom.id_apply]
                rw [map_smul, smul_eq_mul, mul_left_comm, ← mul_smul] }
          map_add' := fun u₁ u₂ => by
            apply LinearMap.ext; intro v
            change ((fromStalk₀ x).hom (u₁ + u₂) * (fromStalk₀ x).hom v) • oneStalk₀ x = _
            rw [map_add, add_mul, add_smul]
            rfl
          map_smul' := fun r u => by
            apply LinearMap.ext; intro v
            change ((fromStalk₀ x).hom (r • u) * (fromStalk₀ x).hom v) • oneStalk₀ x = _
            rw [map_smul, smul_eq_mul, mul_assoc, mul_smul]
            rfl }

    have hmulStalk₀_from : ∀ (x : ↥S) (u v : ↑((Stalk x).obj oneR)),
        (fromStalk₀ x).hom (mulStalk₀ x u v) = (fromStalk₀ x).hom u * (fromStalk₀ x).hom v := by
      intro x u v
      change (fromStalk₀ x).hom (((fromStalk₀ x).hom u * (fromStalk₀ x).hom v) • oneStalk₀ x) = _
      rw [map_smul, hfromStalk₀_one x, smul_eq_mul, mul_one]

    let IsSheafAlg : ∀ (F : 𝒞),
        (∀ U : S.Etale, ↑(F.obj.obj (Opposite.op U))) →
        (∀ U : S.Etale, ↑(F.obj.obj (Opposite.op U)) →ₗ[R]
          ↑(F.obj.obj (Opposite.op U)) →ₗ[R] ↑(F.obj.obj (Opposite.op U))) → Prop :=
      fun F oneF mulF =>
        (∀ (U : S.Etale) (a b c : ↑(F.obj.obj (Opposite.op U))),
          mulF U (mulF U a b) c = mulF U a (mulF U b c)) ∧
        (∀ (U : S.Etale) (a b : ↑(F.obj.obj (Opposite.op U))),
          mulF U a b = mulF U b a) ∧
        (∀ (U : S.Etale) (a : ↑(F.obj.obj (Opposite.op U))),
          mulF U (oneF U) a = a) ∧
        (∀ {U₁ U₂ : S.Etale} (u : U₁ ⟶ U₂),
          (F.obj.map u.op).hom (oneF U₂) = oneF U₁ ∧
          ∀ (a b : ↑(F.obj.obj (Opposite.op U₂))),
            (F.obj.map u.op).hom (mulF U₂ a b) =
              mulF U₁ ((F.obj.map u.op).hom a) ((F.obj.map u.op).hom b))

    let SheafAlgPkg : 𝒞 → Type (u + 1) := fun F =>
      Σ (oneF : ∀ U : S.Etale, ↑(F.obj.obj (Opposite.op U)))
        (mulF : ∀ U : S.Etale, ↑(F.obj.obj (Opposite.op U)) →ₗ[R]
          ↑(F.obj.obj (Opposite.op U)) →ₗ[R] ↑(F.obj.obj (Opposite.op U))),
        PLift (IsSheafAlg F oneF mulF)

    let mkSkyAlg : ∀ (M : ↥S → ModR)
        (oneM : ∀ x : ↥S, ↑(M x))
        (mulM : ∀ x : ↥S, ↑(M x) →ₗ[R] ↑(M x) →ₗ[R] ↑(M x)),
        (∀ x a b c, mulM x (mulM x a b) c = mulM x a (mulM x b c)) →
        (∀ x a b, mulM x a b = mulM x b a) →
        (∀ x a, mulM x (oneM x) a = a) →
        SheafAlgPkg (Sky M) :=
      fun M oneM mulM h_assoc h_comm h_one =>
        ⟨fun _ x _ => oneM x,
         fun U =>
          { toFun := fun s₁ =>
              { toFun := fun s₂ x γ => mulM x (s₁ x γ) (s₂ x γ)
                map_add' := fun s₂ s₂' => funext fun x => funext fun γ =>
                  map_add (mulM x (s₁ x γ)) (s₂ x γ) (s₂' x γ)
                map_smul' := fun r s₂ => funext fun x => funext fun γ =>
                  LinearMap.map_smul (mulM x (s₁ x γ)) r (s₂ x γ) }
            map_add' := fun s₁ s₁' => LinearMap.ext fun s₂ => funext fun x => funext fun γ => by
              change mulM x (s₁ x γ + s₁' x γ) (s₂ x γ) = _
              rw [map_add]; rfl
            map_smul' := fun r s₁ => LinearMap.ext fun s₂ => funext fun x => funext fun γ => by
              change mulM x (r • s₁ x γ) (s₂ x γ) = _
              rw [LinearMap.map_smul]; rfl },
         PLift.up
          ⟨fun _ _ _ _ => funext fun x => funext fun γ => h_assoc x _ _ _,
           fun _ _ _ => funext fun x => funext fun γ => h_comm x _ _,
           fun _ _ => funext fun x => funext fun γ => h_one x _,
           fun _ => ⟨rfl, fun _ _ => rfl⟩⟩⟩

    let algA0 : SheafAlgPkg (A 0) :=
      mkSkyAlg (fun x => (Stalk x).obj oneR) oneStalk₀ mulStalk₀
        (fun x a b c => by
          change ((fromStalk₀ x).hom (mulStalk₀ x a b) * (fromStalk₀ x).hom c) • oneStalk₀ x =
            ((fromStalk₀ x).hom a * (fromStalk₀ x).hom (mulStalk₀ x b c)) • oneStalk₀ x
          rw [hmulStalk₀_from, hmulStalk₀_from, mul_assoc])
        (fun x a b => by
          change ((fromStalk₀ x).hom a * (fromStalk₀ x).hom b) • oneStalk₀ x =
            ((fromStalk₀ x).hom b * (fromStalk₀ x).hom a) • oneStalk₀ x
          rw [mul_comm])
        (fun x a => by
          change ((fromStalk₀ x).hom (oneStalk₀ x) * (fromStalk₀ x).hom a) • oneStalk₀ x = a
          rw [hfromStalk₀_one x, one_mul, hStalk₀_smul_eq x a])

    have hStalkAlgEx : ∀ {F : 𝒞} (P : SheafAlgPkg F) (x : ↥S),
        ∃ (oneSt : ↑((Stalk x).obj F))
          (mulSt : ↑((Stalk x).obj F) →ₗ[R] ↑((Stalk x).obj F) →ₗ[R] ↑((Stalk x).obj F)),
          (∀ i : ℐ x,
            (Limits.colimit.ι (W x ⋙ F.obj) i).hom (P.1 ((W x).obj i).unop) = oneSt) ∧
          (∀ (i : ℐ x) (a b : ↑(F.obj.obj ((W x).obj i))),
            (Limits.colimit.ι (W x ⋙ F.obj) i).hom (P.2.1 ((W x).obj i).unop a b) =
              mulSt ((Limits.colimit.ι (W x ⋙ F.obj) i).hom a)
                ((Limits.colimit.ι (W x ⋙ F.obj) i).hom b)) ∧
          (∀ a b c, mulSt (mulSt a b) c = mulSt a (mulSt b c)) ∧
          (∀ a b, mulSt a b = mulSt b a) ∧
          (∀ a, mulSt oneSt a = a) := by
      intro F P x
      obtain ⟨h_assoc, h_comm, h_one, h_res⟩ := P.2.2.down
      exact hFilteredColimAlg (W x ⋙ F.obj)
        (fun i => P.1 ((W x).obj i).unop)
        (fun i => P.2.1 ((W x).obj i).unop)
        (fun i => h_assoc ((W x).obj i).unop)
        (fun i => h_comm ((W x).obj i).unop)
        (fun i => h_one ((W x).obj i).unop)
        (fun {i j} f => (h_res ((W x).map f).unop).1)
        (fun {i j} f a b => (h_res ((W x).map f).unop).2 a b)

    let nextSheafAlg : ∀ {F : 𝒞}, SheafAlgPkg F → SheafAlgPkg (T.obj F) :=
      fun {F} P =>
        let oneSt : ∀ x : ↥S, ↑((Stalk x).obj F) :=
          fun x => Classical.choose (hStalkAlgEx P x)
        let mulSt : ∀ x : ↥S,
            ↑((Stalk x).obj F) →ₗ[R] ↑((Stalk x).obj F) →ₗ[R] ↑((Stalk x).obj F) :=
          fun x => Classical.choose (Classical.choose_spec (hStalkAlgEx P x))
        have hSpec : ∀ x : ↥S,
            (∀ a b c, mulSt x (mulSt x a b) c = mulSt x a (mulSt x b c)) ∧
            (∀ a b, mulSt x a b = mulSt x b a) ∧
            (∀ a, mulSt x (oneSt x) a = a) :=
          fun x =>
            let sp := Classical.choose_spec (Classical.choose_spec (hStalkAlgEx P x))
            ⟨sp.2.2.1, sp.2.2.2.1, sp.2.2.2.2⟩
        mkSkyAlg (fun x => (Stalk x).obj F) oneSt mulSt
          (fun x => (hSpec x).1) (fun x => (hSpec x).2.1) (fun x => (hSpec x).2.2)

    let algA : ∀ n : ℕ, SheafAlgPkg (A n) :=
      Nat.rec (motive := fun n => SheafAlgPkg (A n)) algA0 (fun _ prev => nextSheafAlg prev)

    let oneSec : ∀ (n : ℕ) (U : S.Etale), ↑((A n).obj.obj (Opposite.op U)) :=
      fun n => (algA n).1
    let mulSec : ∀ (n : ℕ) (U : S.Etale),
        ↑((A n).obj.obj (Opposite.op U)) →ₗ[R]
          ↑((A n).obj.obj (Opposite.op U)) →ₗ[R]
          ↑((A n).obj.obj (Opposite.op U)) :=
      fun n => (algA n).2.1

    let IsAlgSheafHom : ∀ {F₁ F₂ : 𝒞}, SheafAlgPkg F₁ → SheafAlgPkg F₂ → (F₁ ⟶ F₂) → Prop :=
      fun {F₁ F₂} P₁ P₂ φ =>
        ∀ U : S.Etale,
          (φ.hom.app (Opposite.op U)).hom (P₁.1 U) = P₂.1 U ∧
          ∀ (a b : ↑(F₁.obj.obj (Opposite.op U))),
            (φ.hom.app (Opposite.op U)).hom (P₁.2.1 U a b) =
              P₂.2.1 U ((φ.hom.app (Opposite.op U)).hom a) ((φ.hom.app (Opposite.op U)).hom b)

    have hη₀_alg : ∀ {F : 𝒞} (P : SheafAlgPkg F),
        IsAlgSheafHom P (nextSheafAlg P) (η_app F) := by
      intro F P U
      obtain ⟨_, _, _, h_res⟩ := P.2.2.down
      let oneSt : ∀ x : ↥S, ↑((Stalk x).obj F) := fun x => Classical.choose (hStalkAlgEx P x)
      let mulSt : ∀ x : ↥S,
          ↑((Stalk x).obj F) →ₗ[R] ↑((Stalk x).obj F) →ₗ[R] ↑((Stalk x).obj F) :=
        fun x => Classical.choose (Classical.choose_spec (hStalkAlgEx P x))
      have hSpec : ∀ x : ↥S,
          (∀ i : ℐ x,
            (Limits.colimit.ι (W x ⋙ F.obj) i).hom (P.1 ((W x).obj i).unop) = oneSt x) ∧
          (∀ (i : ℐ x) (a b : ↑(F.obj.obj ((W x).obj i))),
            (Limits.colimit.ι (W x ⋙ F.obj) i).hom (P.2.1 ((W x).obj i).unop a b) =
              mulSt x ((Limits.colimit.ι (W x ⋙ F.obj) i).hom a)
                ((Limits.colimit.ι (W x ⋙ F.obj) i).hom b)) :=
        fun x =>
          let sp := Classical.choose_spec (Classical.choose_spec (hStalkAlgEx P x))
          ⟨sp.1, sp.2.1⟩
      refine ⟨?_, ?_⟩
      · funext x γ
        obtain ⟨i, w, hw⟩ := hShrink x U γ
        change (germ x F U γ).hom (P.1 U) = oneSt x
        rw [hgerm_eq x F U γ i w hw]
        change (Limits.colimit.ι (W x ⋙ F.obj) i).hom ((F.obj.map w.op).hom (P.1 U)) = oneSt x
        rw [(h_res w).1]
        exact (hSpec x).1 i
      · intro a b
        funext x γ
        obtain ⟨i, w, hw⟩ := hShrink x U γ
        change (germ x F U γ).hom (P.2.1 U a b) =
          mulSt x ((germ x F U γ).hom a) ((germ x F U γ).hom b)
        rw [hgerm_eq x F U γ i w hw]
        change (Limits.colimit.ι (W x ⋙ F.obj) i).hom ((F.obj.map w.op).hom (P.2.1 U a b)) =
          mulSt x ((Limits.colimit.ι (W x ⋙ F.obj) i).hom ((F.obj.map w.op).hom a))
            ((Limits.colimit.ι (W x ⋙ F.obj) i).hom ((F.obj.map w.op).hom b))
        rw [(h_res w).2 a b]
        exact (hSpec x).2 i ((F.obj.map w.op).hom a) ((F.obj.map w.op).hom b)

    have hTmap_alg : ∀ {F₁ F₂ : 𝒞} (P₁ : SheafAlgPkg F₁) (P₂ : SheafAlgPkg F₂) (φ : F₁ ⟶ F₂),
        IsAlgSheafHom P₁ P₂ φ → IsAlgSheafHom (nextSheafAlg P₁) (nextSheafAlg P₂) (T.map φ) := by
      intro F₁ F₂ P₁ P₂ φ hφ U
      let oneSt₁ : ∀ x : ↥S, ↑((Stalk x).obj F₁) := fun x => Classical.choose (hStalkAlgEx P₁ x)
      let mulSt₁ : ∀ x : ↥S,
          ↑((Stalk x).obj F₁) →ₗ[R] ↑((Stalk x).obj F₁) →ₗ[R] ↑((Stalk x).obj F₁) :=
        fun x => Classical.choose (Classical.choose_spec (hStalkAlgEx P₁ x))
      let oneSt₂ : ∀ x : ↥S, ↑((Stalk x).obj F₂) := fun x => Classical.choose (hStalkAlgEx P₂ x)
      let mulSt₂ : ∀ x : ↥S,
          ↑((Stalk x).obj F₂) →ₗ[R] ↑((Stalk x).obj F₂) →ₗ[R] ↑((Stalk x).obj F₂) :=
        fun x => Classical.choose (Classical.choose_spec (hStalkAlgEx P₂ x))
      have hSpec₁ : ∀ x : ↥S,
          (∀ i : ℐ x,
            (Limits.colimit.ι (W x ⋙ F₁.obj) i).hom (P₁.1 ((W x).obj i).unop) = oneSt₁ x) ∧
          (∀ (i : ℐ x) (a b : ↑(F₁.obj.obj ((W x).obj i))),
            (Limits.colimit.ι (W x ⋙ F₁.obj) i).hom (P₁.2.1 ((W x).obj i).unop a b) =
              mulSt₁ x ((Limits.colimit.ι (W x ⋙ F₁.obj) i).hom a)
                ((Limits.colimit.ι (W x ⋙ F₁.obj) i).hom b)) :=
        fun x =>
          let sp := Classical.choose_spec (Classical.choose_spec (hStalkAlgEx P₁ x))
