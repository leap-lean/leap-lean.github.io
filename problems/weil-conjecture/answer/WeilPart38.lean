    | succ r => exact hy r

  refine ⟨N, e_V, J_V, F_V_u, 3 * e, α_lat, β_lat, matOfAut,
    ⟨hJV_skew, hJV_det⟩, ⟨hFVu_frob, hFVu_sim⟩, hβα_lat, hαβ_trans,
    hMat_props, hMat_inter, ?_, ?_, ?_⟩
  · intro γ hγ hγ_eq
    apply Units.ext
    rw [hAut_val γ hγ, hFVu_val]
    exact hMatOfEnd_ext (fun r => (γ r).val) (fun r => M_Zu_mid.frobTorsion (r + 1))
      hγ hfrob_compat hγ_eq
  · intro γ hγ hCup
    have hCup_pair : ∀ (r : ℕ) (x y : weilEtaleTorsionH S_u (ℓ ^ (r + 1)) n),
        pair (r + 1) ((γ r).val x) ((γ r).val y) =
          PadicInt.toZModPow (r + 1) (1 : PadicInt ℓ) * pair (r + 1) x y := by
      intro r x y
      rw [map_one, one_mul]
      have hc := hCup r (θ_mid (r + 1)) (θ_top (r + 1)) (hθ_mid (r + 1)) (hθ_top (r + 1))
        ((e_mid (r + 1)).symm x) ((e_mid (r + 1)).symm y)
        ((e_mid (r + 1)).symm ((γ r).val x)) ((e_mid (r + 1)).symm ((γ r).val y))
        (by
          rw [← he_mid_apply, (e_mid (r + 1)).apply_symm_apply, ← he_mid_apply,
            (e_mid (r + 1)).apply_symm_apply])
        (by
          rw [← he_mid_apply, (e_mid (r + 1)).apply_symm_apply, ← he_mid_apply,
            (e_mid (r + 1)).apply_symm_apply])
      exact congrArg (tr (r + 1)) hc
    have hSim1 := (hSim_unit 1 (fun r => (γ r).val) hγ (matOfAut γ hγ).val
      (by rw [hAut_val γ hγ]; exact hMatOfEnd_spec (fun r => (γ r).val) hγ) hCup_pair).1
    rwa [map_one, one_smul] at hSim1
  · intro F' _ _ Z' M' γ hγ ψ hψ_trans hψ_frob k _hk
    let S' := weilGeomScheme F' Z'
    have hTors' : ∀ (s : ℕ) (w : weilEtaleTorsionH S' (ℓ ^ s) n), (ℓ ^ s) • w = 0 :=
      fun s w => (weil_etale_two_param_bockstein_exact_system S' ℓ).1 n s w
    have hMem_S' : ∀ w : ∀ s : ℕ, weilEtaleTorsionH S' (ℓ ^ s) n,
        w ∈ weilEtaleIntegralSystem S' ℓ n ↔
          ∀ s : ℕ, weilEtaleTorsionTransition S' ℓ s n (w (s + 1)) = w s :=
      hKerMem (fun s => weilEtaleTorsionH S' (ℓ ^ s) n)
        (fun s => weilEtaleTorsionTransition S' ℓ s n)
    have hfrob'_M' : ∀ (x' y' : ↥(weilEtaleIntegralSystem S' ℓ n)),
        (∀ r : ℕ, y'.1 (r + 1) = M'.frobTorsion (r + 1) (x'.1 (r + 1))) →
          M'.frob (M'.equiv (TensorProduct.tmul ℤ (1 : ℚ) x')) =
            M'.equiv (TensorProduct.tmul ℤ (1 : ℚ) y') := by
      intro x' y' hy'
      apply M'.hfrob x' y'
      intro s
      cases s with
      | zero =>
        have hx0 : 1 • y'.1 0 = 0 := hTors' 0 (y'.1 0)
        have hy0 : 1 • M'.frobTorsion 0 (x'.1 0) = 0 :=
          hTors' 0 (M'.frobTorsion 0 (x'.1 0))
        rw [one_nsmul] at hx0 hy0
        exact hx0.trans hy0.symm
      | succ r => exact hy' r
    exact hTrace_transport
      (fun s => weilEtaleTorsionH S' (ℓ ^ s) n)
      (fun s => weilEtaleTorsionTransition S' ℓ s n)
      hTors' (weilEtaleIntegralSystem S' ℓ n) hMem_S'
      M'.V M'.frob (fun r => M'.frobTorsion (r + 1)) M'.equiv M'.hsmul hfrob'_M'
      (fun r => (γ r).val) hγ (matOfAut γ hγ).val
      (by rw [hAut_val γ hγ]; exact hMatOfEnd_spec (fun r => (γ r).val) hγ)
      ψ hψ_trans hψ_frob k

theorem weil_plane_curve_origin_shear_monic_normalization (E : Type u) [Finite E] [Field E] (D : ℕ)
    (G : Polynomial (Polynomial E))
    (hMon : G.Monic)
    (hd_lo : 2 ≤ G.natDegree)
    (hd_hi : G.natDegree ≤ D)
    (hdeg_X : ∀ r ≤ G.natDegree, (G.coeff r).natDegree ≤ D)
    (hIrr : Irreducible G)
    (hCard : 2 * D + 2 ≤ Nat.card E)
    (t₀ y₀ : E)
    (hZero : (G.map (Polynomial.evalRingHom t₀)).eval y₀ = 0)
    (hSmooth : ((Polynomial.derivative G).map (Polynomial.evalRingHom t₀)).eval y₀ ≠ 0) :
    ∃ (D₁ : ℕ) (G_tilde : Polynomial (Polynomial E)) (e_pt : (E × E) ≃ (E × E)),
      2 ≤ D₁ ∧
      D₁ ≤ 2 * D ∧
      G_tilde.Monic ∧
      G_tilde.natDegree = D₁ ∧
      (∀ (i j : ℕ), D₁ < i + j → (G_tilde.coeff i).coeff j = 0) ∧
      Irreducible G_tilde ∧
      (G_tilde.map (Polynomial.evalRingHom 0)).eval 0 = 0 ∧
      ((Polynomial.derivative G_tilde).map (Polynomial.evalRingHom 0)).eval 0 ≠ 0 ∧
      (∀ pt : E × E,
        (G.map (Polynomial.evalRingHom pt.1)).eval pt.2 = 0 ↔
          (G_tilde.map (Polynomial.evalRingHom (e_pt pt).1)).eval (e_pt pt).2 = 0) :=
by
  classical
  have hD_ge2 : 2 ≤ D := le_trans hd_lo hd_hi
  have hdeg_X_all : ∀ r : ℕ, (G.coeff r).natDegree ≤ D := by
    intro r
    by_cases hr : r ≤ G.natDegree
    · exact hdeg_X r hr
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_not_ge hr), Polynomial.natDegree_zero]
      exact Nat.zero_le D

  let evPt : E → E → (Polynomial (Polynomial E) →+* E) :=
    fun x y => Polynomial.eval₂RingHom (Polynomial.evalRingHom x) y
  have hevPt : ∀ (x y : E) (P : Polynomial (Polynomial E)),
      (P.map (Polynomial.evalRingHom x)).eval y = evPt x y P := by
    intro x y P
    exact Polynomial.eval_map (Polynomial.evalRingHom x) y
  have hDeriv00 : ∀ P : Polynomial (Polynomial E),
      ((Polynomial.derivative P).map (Polynomial.evalRingHom 0)).eval 0 =
        (P.coeff 1).coeff 0 := by
    intro P
    rw [← Polynomial.coeff_zero_eq_eval_zero, Polynomial.coeff_map,
      Polynomial.coe_evalRingHom, ← Polynomial.coeff_zero_eq_eval_zero,
      Polynomial.coeff_derivative]
    simp

  have hExt2 : ∀ {R : Type u} [CommSemiring R]
      {f₁ f₂ : Polynomial (Polynomial E) →+* R},
      (∀ a : E, f₁ (Polynomial.C (Polynomial.C a)) = f₂ (Polynomial.C (Polynomial.C a))) →
      f₁ (Polynomial.C Polynomial.X) = f₂ (Polynomial.C Polynomial.X) →
      f₁ Polynomial.X = f₂ Polynomial.X →
      f₁ = f₂ := by
    intro R _ f₁ f₂ hCC hCX hX
    apply Polynomial.ringHom_ext'
    · apply Polynomial.ringHom_ext'
      · ext a
        exact hCC a
      · exact hCX
    · exact hX

  let e_T : Polynomial E ≃+* Polynomial E := (Polynomial.taylorEquiv t₀).toRingEquiv
  have he_T : ∀ q : Polynomial E, e_T q = q.comp (Polynomial.X + Polynomial.C t₀) := by
    intro q
    show (Polynomial.taylor t₀) q = _
    exact Polynomial.taylor_apply t₀ q
  let E_T : Polynomial (Polynomial E) ≃+* Polynomial (Polynomial E) := Polynomial.mapEquiv e_T
  have hE_T : ∀ P : Polynomial (Polynomial E), E_T P = P.map e_T.toRingHom :=
    fun P => Polynomial.mapEquiv_apply e_T P
  let E_Y : Polynomial (Polynomial E) ≃+* Polynomial (Polynomial E) :=
    (Polynomial.taylorEquiv (Polynomial.C y₀)).toRingEquiv
  have hE_Y : ∀ P : Polynomial (Polynomial E),
      E_Y P = P.comp (Polynomial.X + Polynomial.C (Polynomial.C y₀)) := by
    intro P
    show (Polynomial.taylor (Polynomial.C y₀)) P = _
    exact Polynomial.taylor_apply (Polynomial.C y₀) P

  let G_X : Polynomial (Polynomial E) := E_T G
  let G₁ : Polynomial (Polynomial E) := E_Y G_X

  have hIrr₁ : Irreducible G₁ :=
    (MulEquiv.irreducible_iff E_Y.toMulEquiv).mpr
      ((MulEquiv.irreducible_iff E_T.toMulEquiv).mpr hIrr)
  have hMon_X : G_X.Monic := by
    rw [show G_X = G.map e_T.toRingHom from hE_T G]
    exact hMon.map e_T.toRingHom
  have hDeg_X : G_X.natDegree = G.natDegree := by
    rw [show G_X = G.map e_T.toRingHom from hE_T G]
    exact hMon.natDegree_map e_T.toRingHom
  have hMon₁ : G₁.Monic := by
    rw [show G₁ = G_X.comp (Polynomial.X + Polynomial.C (Polynomial.C y₀)) from hE_Y G_X]
    exact hMon_X.comp_X_add_C (Polynomial.C y₀)
  have hDeg₁ : G₁.natDegree = G.natDegree := by
    rw [show G₁ = G_X.comp (Polynomial.X + Polynomial.C (Polynomial.C y₀)) from hE_Y G_X,
      Polynomial.natDegree_comp, Polynomial.natDegree_X_add_C, mul_one, hDeg_X]

  have hev_shift : ∀ (x₁ y₁ : E) (P : Polynomial (Polynomial E)),
      evPt x₁ y₁ (E_Y (E_T P)) = evPt (x₁ + t₀) (y₁ + y₀) P := by
    intro x₁ y₁ P
    rw [← hevPt, ← hevPt, hE_Y, hE_T, Polynomial.map_comp, Polynomial.eval_comp]
    have hmap_shift :
        ((Polynomial.X + Polynomial.C (Polynomial.C y₀)).map (Polynomial.evalRingHom x₁)).eval y₁ =
          y₁ + y₀ := by simp
    have hhom_shift :
        (Polynomial.evalRingHom x₁).comp e_T.toRingHom = Polynomial.evalRingHom (x₁ + t₀) := by
      apply RingHom.ext
      intro q
      change (e_T q).eval x₁ = q.eval (x₁ + t₀)
      rw [he_T, Polynomial.eval_comp]
      simp
    rw [hmap_shift, Polynomial.map_map, hhom_shift]

  have hZero₁ : evPt 0 0 G₁ = 0 := by
    change evPt 0 0 (E_Y (E_T G)) = 0
    rw [hev_shift 0 0 G, zero_add, zero_add, ← hevPt]
    exact hZero

  have hDeriv_G₁ : Polynomial.derivative G₁ = E_Y (E_T (Polynomial.derivative G)) := by
    change Polynomial.derivative (E_Y (E_T G)) = E_Y (E_T (Polynomial.derivative G))
    rw [hE_Y, hE_Y, hE_T, hE_T, Polynomial.derivative_comp, Polynomial.derivative_map]
    simp

  have ha10_ne : (G₁.coeff 1).coeff 0 ≠ 0 := by
    rw [← hDeriv00 G₁, hDeriv_G₁, hevPt, hev_shift 0 0 (Polynomial.derivative G),
      zero_add, zero_add, ← hevPt]
    exact hSmooth

  have hGX_deg : ∀ r : ℕ, (G_X.coeff r).natDegree ≤ D := by
    intro r
    have hc : G_X.coeff r = (G.coeff r).comp (Polynomial.X + Polynomial.C t₀) := by
      rw [show G_X = G.map e_T.toRingHom from hE_T G, Polynomial.coeff_map]
      exact he_T (G.coeff r)
    rw [hc]
    calc ((G.coeff r).comp (Polynomial.X + Polynomial.C t₀)).natDegree
        ≤ (G.coeff r).natDegree * (Polynomial.X + Polynomial.C t₀).natDegree :=
          Polynomial.natDegree_comp_le
      _ = (G.coeff r).natDegree := by rw [Polynomial.natDegree_X_add_C, mul_one]
      _ ≤ D := hdeg_X_all r

  have hBox₁ : ∀ i j : ℕ, (D < i ∨ D < j) → (G₁.coeff i).coeff j = 0 := by
    intro i j hij
    rcases hij with hi | hj
    · have h0 : G₁.coeff i = 0 :=
        Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [hDeg₁]; omega)
      rw [h0, Polynomial.coeff_zero]
    · let ιC : Polynomial E →+* Polynomial (Polynomial E) := Polynomial.mapRingHom Polynomial.C
      have hY_shift : Polynomial.X + Polynomial.C (Polynomial.C y₀) =
          ιC (Polynomial.X + Polynomial.C y₀) := by
        simp [ιC]
      have hG₁_sum : G₁ = ∑ r ∈ G_X.support,
          Polynomial.C (G_X.coeff r) * (ιC ((Polynomial.X + Polynomial.C y₀) ^ r)) := by
        rw [show G₁ = G_X.comp (Polynomial.X + Polynomial.C (Polynomial.C y₀)) from hE_Y G_X,
          hY_shift]
        change G_X.eval₂ Polynomial.C (ιC (Polynomial.X + Polynomial.C y₀)) = _
        rw [Polynomial.eval₂_eq_sum, Polynomial.sum_def]
        refine Finset.sum_congr rfl fun r _ => ?_
        rw [map_pow]
      rw [hG₁_sum, Polynomial.finsetSum_coeff, Polynomial.finsetSum_coeff]
      refine Finset.sum_eq_zero fun r _ => ?_
      have hι_coeff : (ιC ((Polynomial.X + Polynomial.C y₀) ^ r)).coeff i =
          Polynomial.C (((Polynomial.X + Polynomial.C y₀) ^ r).coeff i) := by
        change (((Polynomial.X + Polynomial.C y₀) ^ r).map Polynomial.C).coeff i = _
        exact Polynomial.coeff_map Polynomial.C i
      rw [Polynomial.coeff_C_mul, hι_coeff, Polynomial.coeff_mul_C]
      have hcj : (G_X.coeff r).coeff j = 0 :=
        Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt (hGX_deg r) hj)
      rw [hcj, zero_mul]

  set d_Y : ℕ := G.natDegree
  let B_box : Finset (ℕ × ℕ) := Finset.range (D + 1) ×ˢ Finset.range (D + 1)
  let S_supp : Finset (ℕ × ℕ) :=
    B_box.filter (fun p => (G₁.coeff p.1).coeff p.2 ≠ 0)

  have hdY_mem : (d_Y, 0) ∈ S_supp := by
    rw [Finset.mem_filter, Finset.mem_product, Finset.mem_range, Finset.mem_range]
    refine ⟨⟨by omega, by omega⟩, ?_⟩
    have hlc : G₁.coeff d_Y = 1 := by
      have hm : G₁.leadingCoeff = 1 := hMon₁.leadingCoeff
      rwa [Polynomial.leadingCoeff, hDeg₁] at hm
    rw [hlc, Polynomial.coeff_one_zero]
    exact one_ne_zero

  have hS_ne : S_supp.Nonempty := ⟨(d_Y, 0), hdY_mem⟩
  let D₁ : ℕ := S_supp.sup (fun p => p.1 + p.2)

  have hD₁_lo : 2 ≤ D₁ := by
    have hle : d_Y + 0 ≤ D₁ := Finset.le_sup (f := fun p : ℕ × ℕ => p.1 + p.2) hdY_mem
    omega

  have hD₁_hi : D₁ ≤ 2 * D := by
    refine Finset.sup_le fun p hp => ?_
    have hp_box : p ∈ B_box := (Finset.mem_filter.mp hp).1
    rw [Finset.mem_product, Finset.mem_range, Finset.mem_range] at hp_box
    omega

  obtain ⟨⟨i_star, j_star⟩, hp_star_mem, hp_star_deg⟩ :=
    Finset.exists_mem_eq_sup S_supp hS_ne (fun p => p.1 + p.2)
  have hp_star_box : (i_star, j_star) ∈ B_box := (Finset.mem_filter.mp hp_star_mem).1
  have hp_star_nz : (G₁.coeff i_star).coeff j_star ≠ 0 := (Finset.mem_filter.mp hp_star_mem).2
  have hp_star_sum : i_star + j_star = D₁ := hp_star_deg.symm

  let mono₂ : ℕ → ℕ → E → Polynomial (Polynomial E) :=
    fun i j a => Polynomial.monomial i (Polynomial.monomial j a)

  have hG₁_mono_sum : G₁ = ∑ p ∈ B_box, mono₂ p.1 p.2 ((G₁.coeff p.1).coeff p.2) := by
    ext r s
    rw [Polynomial.finsetSum_coeff, Polynomial.finsetSum_coeff]
    by_cases hrs : (r, s) ∈ B_box
    · rw [Finset.sum_eq_single (r, s)]
      · simp [mono₂]
      · intro p _ hp_ne
        simp only [mono₂, Polynomial.coeff_monomial]
        by_cases hpr : p.1 = r
        · simp only [hpr, ↓reduceIte, Polynomial.coeff_monomial]
          have hps : p.2 ≠ s := fun hps => hp_ne (Prod.ext hpr hps)
          simp [hps]
        · simp [hpr]
      · intro hnot
        exact absurd hrs hnot
    · have hout : D < r ∨ D < s := by
        rw [Finset.mem_product, Finset.mem_range, Finset.mem_range] at hrs
        omega
      rw [hBox₁ r s hout]
      symm
      refine Finset.sum_eq_zero fun p hp => ?_
      have hp_ne : p ≠ (r, s) := fun heq => hrs (heq ▸ hp)
      simp only [mono₂, Polynomial.coeff_monomial]
      by_cases hpr : p.1 = r
      · simp only [hpr, ↓reduceIte, Polynomial.coeff_monomial]
        have hps : p.2 ≠ s := fun hps => hp_ne (Prod.ext hpr hps)
        simp [hps]
      · simp [hpr]

  let L_c : E → Polynomial (Polynomial E) :=
    fun c => Polynomial.C (Polynomial.C c) * Polynomial.X + Polynomial.C Polynomial.X
  let ψ_c : E → (Polynomial E →+* Polynomial (Polynomial E)) :=
    fun c => Polynomial.eval₂RingHom (Polynomial.C.comp Polynomial.C) (L_c c)
  let φ_c : E → (Polynomial (Polynomial E) →+* Polynomial (Polynomial E)) :=
    fun c => Polynomial.eval₂RingHom (ψ_c c) Polynomial.X

  have hφ_zero : φ_c 0 = RingHom.id _ := by
    apply hExt2
    · intro a; simp [φ_c, ψ_c, L_c]
    · simp [φ_c, ψ_c, L_c]
    · simp [φ_c, ψ_c, L_c]

  have hφ_comp : ∀ c c' : E, (φ_c c).comp (φ_c c') = φ_c (c + c') := by
    intro c c'
    apply hExt2
    · intro a; simp [φ_c, ψ_c, L_c]
    · simp [φ_c, ψ_c, L_c]
      ring
    · simp [φ_c, ψ_c, L_c]

  let σ_c : E → (Polynomial (Polynomial E) ≃+* Polynomial (Polynomial E)) :=
    fun c =>
      { toFun := φ_c c
        invFun := φ_c (-c)
        left_inv := fun P => by
          have h := RingHom.congr_fun (hφ_comp (-c) c) P
          simpa [neg_add_cancel, hφ_zero] using h
        right_inv := fun P => by
          have h := RingHom.congr_fun (hφ_comp c (-c)) P
          simpa [add_neg_cancel, hφ_zero] using h
        map_mul' := (φ_c c).map_mul
        map_add' := (φ_c c).map_add }

  have hev_shear : ∀ (c x y : E) (P : Polynomial (Polynomial E)),
      evPt x y (σ_c c P) = evPt (x + c * y) y P := by
    intro c x y P
    have h_hom : (evPt x y).comp (φ_c c) = evPt (x + c * y) y := by
      apply hExt2
      · intro a; simp [evPt, φ_c, ψ_c, L_c]
      · simp [evPt, φ_c, ψ_c, L_c]
        ring
      · simp [evPt, φ_c, ψ_c, L_c]
    exact RingHom.congr_fun h_hom P

  let HasTotDegLe : ℕ → Polynomial (Polynomial E) → Prop :=
    fun M P => ∀ r s : ℕ, M < r + s → (P.coeff r).coeff s = 0

  have hTD_one : HasTotDegLe 0 1 := by
    intro r s hrs
    by_cases hr : r = 0
    · subst hr
      have hs : s ≠ 0 := by omega
      simp [Polynomial.coeff_one, hs]
    · simp [Polynomial.coeff_one, hr]

  have hTD_add : ∀ {M : ℕ} {P Q : Polynomial (Polynomial E)},
      HasTotDegLe M P → HasTotDegLe M Q → HasTotDegLe M (P + Q) := by
    intro M P Q hP hQ r s hrs
    simp [hP r s hrs, hQ r s hrs]

  have hTD_smul : ∀ {M : ℕ} (a : E) {P : Polynomial (Polynomial E)},
      HasTotDegLe M P → HasTotDegLe M (Polynomial.C (Polynomial.C a) * P) := by
    intro M a P hP r s hrs
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_C_mul, hP r s hrs, mul_zero]

  have hTD_mul_Y : ∀ {M : ℕ} {P : Polynomial (Polynomial E)},
      HasTotDegLe M P → HasTotDegLe (M + 1) (P * Polynomial.X) := by
    intro M P hP r s hrs
    cases r with
    | zero => simp
    | succ r' =>
      rw [Polynomial.coeff_mul_X]
      exact hP r' s (by omega)

  have hTD_mul_X : ∀ {M : ℕ} {P : Polynomial (Polynomial E)},
      HasTotDegLe M P → HasTotDegLe (M + 1) (P * Polynomial.C Polynomial.X) := by
    intro M P hP r s hrs
    rw [Polynomial.coeff_mul_C]
    cases s with
    | zero => simp
    | succ s' =>
      rw [Polynomial.coeff_mul_X]
      exact hP r s' (by omega)

  have hTD_Lc_pow : ∀ (c : E) (j : ℕ), HasTotDegLe j (L_c c ^ j) := by
    intro c j
    induction j with
    | zero => simpa using hTD_one
    | succ j ih =>
      have hexp : L_c c ^ (j + 1) =
          Polynomial.C (Polynomial.C c) * (L_c c ^ j * Polynomial.X) +
            L_c c ^ j * Polynomial.C Polynomial.X := by
        dsimp [L_c]
        ring
      rw [hexp]
      exact hTD_add (hTD_smul c (hTD_mul_Y ih)) (hTD_mul_X ih)

  have hTD_Lc_Y_pow : ∀ (c : E) (j i : ℕ),
      HasTotDegLe (i + j) (L_c c ^ j * Polynomial.X ^ i) := by
    intro c j i
    induction i with
    | zero => simpa using hTD_Lc_pow c j
    | succ i ih =>
      have hexp : L_c c ^ j * Polynomial.X ^ (i + 1) =
          (L_c c ^ j * Polynomial.X ^ i) * Polynomial.X := by ring
      have hadd : i + 1 + j = (i + j) + 1 := by omega
      rw [hexp, hadd]
      exact hTD_mul_Y ih

  have hmono₂_eq : ∀ (i j : ℕ) (a : E),
      mono₂ i j a = Polynomial.C (Polynomial.C a) * (Polynomial.C Polynomial.X) ^ j * Polynomial.X ^ i := by
    intro i j a
    dsimp [mono₂]
    rw [← Polynomial.C_mul_X_pow_eq_monomial, ← Polynomial.C_mul_X_pow_eq_monomial,
      map_mul, map_pow]

  have hφ_mono₂ : ∀ (c : E) (i j : ℕ) (a : E),
      φ_c c (mono₂ i j a) = Polynomial.C (Polynomial.C a) * L_c c ^ j * Polynomial.X ^ i := by
    intro c i j a
    rw [hmono₂_eq, map_mul, map_mul, map_pow, map_pow]
    simp [φ_c, ψ_c]

  have hTD_shear_G₁ : ∀ c : E, HasTotDegLe D₁ (σ_c c G₁) := by
    intro c r s hrs
    change (((φ_c c G₁).coeff r).coeff s) = 0
    rw [hG₁_mono_sum, map_sum, Polynomial.finsetSum_coeff, Polynomial.finsetSum_coeff]
    refine Finset.sum_eq_zero fun p hp => ?_
    set a_p : E := (G₁.coeff p.1).coeff p.2
    by_cases hap : a_p = 0
    · simp [a_p, hap, mono₂]
    · have hp_supp : p ∈ S_supp := Finset.mem_filter.mpr ⟨hp, hap⟩
      have hp_deg : p.1 + p.2 ≤ D₁ :=
        Finset.le_sup (f := fun q : ℕ × ℕ => q.1 + q.2) hp_supp
      have hterm : HasTotDegLe (p.1 + p.2) (φ_c c (mono₂ p.1 p.2 a_p)) := by
        rw [hφ_mono₂, mul_assoc]
        exact hTD_smul a_p (hTD_Lc_Y_pow c p.2 p.1)
      exact hterm r s (by omega)

  let π₀ : Polynomial (Polynomial E) →+* Polynomial E :=
    Polynomial.mapRingHom (Polynomial.evalRingHom 0)
  let θ_c : E → (Polynomial (Polynomial E) →+* Polynomial E) :=
    fun c => π₀.comp (φ_c c)

  have hθ_mono₂ : ∀ (c : E) (i j : ℕ) (a : E),
      θ_c c (mono₂ i j a) = Polynomial.monomial (i + j) (a * c ^ j) := by
    intro c i j a
    dsimp [θ_c]
    rw [hφ_mono₂]
    have hπ_Lc : π₀ (L_c c) = Polynomial.C c * Polynomial.X := by
      simp [π₀, L_c]
    simp only [map_mul, map_pow, hπ_Lc]
    have hπ_CC : π₀ (Polynomial.C (Polynomial.C a)) = Polynomial.C a := by simp [π₀]
    have hπ_X : π₀ Polynomial.X = Polynomial.X := by simp [π₀]
    rw [hπ_CC, hπ_X, mul_pow, ← map_pow, ← Polynomial.C_mul_X_pow_eq_monomial]
    calc Polynomial.C a * (Polynomial.C (c ^ j) * Polynomial.X ^ j) * Polynomial.X ^ i
        = (Polynomial.C a * Polynomial.C (c ^ j)) * (Polynomial.X ^ i * Polynomial.X ^ j) := by ring
      _ = Polynomial.C (a * c ^ j) * Polynomial.X ^ (i + j) := by
          rw [← Polynomial.C_mul, ← pow_add]

  have hshear_coeff0 : ∀ (c : E) (r : ℕ),
      (((σ_c c G₁).coeff r).coeff 0) =
        ∑ p ∈ B_box.filter (fun p => p.1 + p.2 = r),
          ((G₁.coeff p.1).coeff p.2) * c ^ p.2 := by
    intro c r
    have hlhs : (((σ_c c G₁).coeff r).coeff 0) = (θ_c c G₁).coeff r := by
      dsimp [θ_c, π₀, σ_c]
      rw [Polynomial.coeff_map, Polynomial.coe_evalRingHom,
        Polynomial.coeff_zero_eq_eval_zero]
    have hθ_G₁ : θ_c c G₁ =
        ∑ p ∈ B_box, Polynomial.monomial (p.1 + p.2) (((G₁.coeff p.1).coeff p.2) * c ^ p.2) := by
      conv_lhs => rw [hG₁_mono_sum]
      rw [map_sum]
      refine Finset.sum_congr rfl fun p _ => ?_
      exact hθ_mono₂ c p.1 p.2 ((G₁.coeff p.1).coeff p.2)
    rw [hlhs, hθ_G₁, Polynomial.finsetSum_coeff]
    simp only [Polynomial.coeff_monomial]
    rw [← Finset.sum_filter]

  let B_top : Finset (ℕ × ℕ) := B_box.filter (fun p => p.1 + p.2 = D₁)
  let h_poly : Polynomial E :=
    ∑ p ∈ B_top, Polynomial.monomial p.2 ((G₁.coeff p.1).coeff p.2)

  have hh_eval : ∀ c : E, h_poly.eval c = (((σ_c c G₁).coeff D₁).coeff 0) := by
    intro c
    dsimp [h_poly]
    rw [Polynomial.eval_finsetSum, hshear_coeff0 c D₁]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [Polynomial.eval_monomial]

  have hshear_top_coeff : ∀ c : E,
      (σ_c c G₁).coeff D₁ = Polynomial.C (h_poly.eval c) := by
    intro c
    ext s
    cases s with
    | zero =>
      rw [Polynomial.coeff_C_zero, hh_eval c]
    | succ s' =>
      rw [Polynomial.coeff_C_succ]
      exact hTD_shear_G₁ c D₁ (s' + 1) (by omega)

  have hh_ne : h_poly ≠ 0 := by
    intro h0
    have hc_star : h_poly.coeff j_star = (G₁.coeff i_star).coeff j_star := by
      dsimp [h_poly]
      rw [Polynomial.finsetSum_coeff]
      have hmem_top : (i_star, j_star) ∈ B_top :=
        Finset.mem_filter.mpr ⟨hp_star_box, hp_star_sum⟩
      rw [Finset.sum_eq_single (i_star, j_star)]
      · simp
      · intro p hp hp_ne
        rw [Polynomial.coeff_monomial]
        have hp_sum : p.1 + p.2 = D₁ := (Finset.mem_filter.mp hp).2
        have hp2_ne : p.2 ≠ j_star := by
          intro heq2
          apply hp_ne
          ext
          · omega
          · exact heq2
        simp [hp2_ne]
      · intro hnot
        exact absurd hmem_top hnot
    rw [h0, Polynomial.coeff_zero] at hc_star
    exact hp_star_nz hc_star.symm

  have hh_deg : h_poly.natDegree ≤ D₁ := by
    rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
    intro N hN
    dsimp [h_poly]
    rw [Polynomial.finsetSum_coeff]
    refine Finset.sum_eq_zero fun p hp => ?_
    have hp_sum : p.1 + p.2 = D₁ := (Finset.mem_filter.mp hp).2
    have hp2_ne : p.2 ≠ N := by omega
    simp [Polynomial.coeff_monomial, hp2_ne]

  let a10 : E := (G₁.coeff 1).coeff 0
  let a01 : E := (G₁.coeff 0).coeff 1
  let L_poly : Polynomial E := Polynomial.C a10 + Polynomial.C a01 * Polynomial.X

  have hL_eval : ∀ c : E, L_poly.eval c = (((σ_c c G₁).coeff 1).coeff 0) := by
    intro c
    have hB1 : B_box.filter (fun p => p.1 + p.2 = 1) = {(1, 0), (0, 1)} := by
      ext ⟨i, j⟩
      simp only [B_box, Finset.mem_filter, Finset.mem_product, Finset.mem_range,
        Finset.mem_insert, Finset.mem_singleton, Prod.mk.injEq]
      omega
    rw [hshear_coeff0 c 1, hB1, Finset.sum_pair (by decide)]
    dsimp [L_poly, a10, a01]
    simp [pow_zero, pow_one]

  have hL_ne : L_poly ≠ 0 := by
    intro h0
    have hc0 : L_poly.coeff 0 = a10 := by
      dsimp [L_poly]
      simp
    rw [h0, Polynomial.coeff_zero] at hc0
    exact ha10_ne hc0.symm

  have hL_deg : L_poly.natDegree ≤ 1 := by
    rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
    intro N hN
    dsimp [L_poly]
    rw [Polynomial.coeff_add, Polynomial.coeff_C, Polynomial.coeff_C_mul, Polynomial.coeff_X]
    have hN0 : N ≠ 0 := by omega
    have hN1 : 1 ≠ N := by omega
    simp [hN0, hN1]

  let P_bad : Polynomial E := h_poly * L_poly
  have hP_bad_ne : P_bad ≠ 0 := mul_ne_zero hh_ne hL_ne
  have hP_bad_deg : P_bad.natDegree ≤ 2 * D + 1 := by
    calc P_bad.natDegree ≤ h_poly.natDegree + L_poly.natDegree := Polynomial.natDegree_mul_le
      _ ≤ D₁ + 1 := Nat.add_le_add hh_deg hL_deg
      _ ≤ 2 * D + 1 := Nat.add_le_add_right hD₁_hi 1

  let _ : Fintype E := Fintype.ofFinite E
  have hcard_roots_lt : ((P_bad.roots).toFinset).card < (Finset.univ : Finset E).card := by
    calc ((P_bad.roots).toFinset).card
        ≤ (P_bad.roots).card := Multiset.toFinset_card_le _
      _ ≤ P_bad.natDegree := Polynomial.card_roots' P_bad
      _ ≤ 2 * D + 1 := hP_bad_deg
      _ < 2 * D + 2 := by omega
      _ ≤ Nat.card E := hCard
      _ = Fintype.card E := Nat.card_eq_fintype_card
      _ = (Finset.univ : Finset E).card := Finset.card_univ.symm

  obtain ⟨c, hc_not_mem⟩ : ∃ c : E, c ∉ (P_bad.roots).toFinset := by
    by_contra hall
    have heq : (P_bad.roots).toFinset = Finset.univ :=
      Finset.eq_univ_iff_forall.mpr (fun x => Classical.not_not.mp (fun hx => hall ⟨x, hx⟩))
    rw [heq] at hcard_roots_lt
    exact lt_irrefl _ hcard_roots_lt

  have hP_bad_eval : P_bad.eval c ≠ 0 := by
    intro h0
    apply hc_not_mem
    rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_bad_ne]
    exact h0

  have hmul_eval : h_poly.eval c * L_poly.eval c ≠ 0 := by
    rwa [Polynomial.eval_mul] at hP_bad_eval
  have h_top : h_poly.eval c ≠ 0 := left_ne_zero_of_mul hmul_eval
  have h_sm : L_poly.eval c ≠ 0 := right_ne_zero_of_mul hmul_eval

  let u : E := h_poly.eval c
  have hu_ne : u ≠ 0 := h_top
  have hu_inv_ne : u⁻¹ ≠ 0 := inv_ne_zero hu_ne

  let G_tilde : Polynomial (Polynomial E) :=
    Polynomial.C (Polynomial.C u⁻¹) * (σ_c c G₁)

  let e_pt : (E × E) ≃ (E × E) :=
    { toFun := fun pt => (pt.1 - t₀ - c * (pt.2 - y₀), pt.2 - y₀)
      invFun := fun q => (q.1 + c * q.2 + t₀, q.2 + y₀)
      left_inv := fun ⟨t, y⟩ => by ext <;> dsimp <;> ring
      right_inv := fun ⟨x, y⟩ => by ext <;> dsimp <;> ring }

  have hTri_tilde : ∀ i j : ℕ, D₁ < i + j → (G_tilde.coeff i).coeff j = 0 := by
    intro i j hij
    dsimp [G_tilde]
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_C_mul, hTD_shear_G₁ c i j hij, mul_zero]

  have hG_tilde_top : G_tilde.coeff D₁ = 1 := by
    dsimp [G_tilde]
    rw [Polynomial.coeff_C_mul, hshear_top_coeff c, ← Polynomial.C_mul,
      inv_mul_cancel₀ hu_ne, Polynomial.C_1]

  have hG_tilde_deg_le : G_tilde.natDegree ≤ D₁ := by
    rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
    intro N hN
    ext j
    rw [Polynomial.coeff_zero]
    exact hTri_tilde N j (by omega)

  have hDeg_tilde : G_tilde.natDegree = D₁ :=
    Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hG_tilde_deg_le
      (by rw [hG_tilde_top]; exact one_ne_zero)

  have hMon_tilde : G_tilde.Monic := by
    rw [Polynomial.Monic, Polynomial.leadingCoeff, hDeg_tilde, hG_tilde_top]

  have hIrr_tilde : Irreducible G_tilde := by
    have hIrr_shear : Irreducible (σ_c c G₁) :=
      (MulEquiv.irreducible_iff (σ_c c).toMulEquiv).mpr hIrr₁
    let v_u : (Polynomial (Polynomial E))ˣ :=
      { val := Polynomial.C (Polynomial.C u⁻¹)
        inv := Polynomial.C (Polynomial.C u)
        val_inv := by
          rw [← Polynomial.C_mul, ← Polynomial.C_mul, inv_mul_cancel₀ hu_ne,
            Polynomial.C_1, Polynomial.C_1]
        inv_val := by
          rw [← Polynomial.C_mul, ← Polynomial.C_mul, mul_inv_cancel₀ hu_ne,
            Polynomial.C_1, Polynomial.C_1] }
    have hassoc : Associated (σ_c c G₁) G_tilde := ⟨v_u, mul_comm _ _⟩
    exact hassoc.irreducible hIrr_shear

  have hZero_tilde : (G_tilde.map (Polynomial.evalRingHom 0)).eval 0 = 0 := by
    rw [hevPt 0 0 G_tilde]
    dsimp [G_tilde]
    rw [map_mul, hev_shear c 0 0 G₁, mul_zero, add_zero, hZero₁, mul_zero]

  have hSmooth_tilde : ((Polynomial.derivative G_tilde).map (Polynomial.evalRingHom 0)).eval 0 ≠ 0 := by
    rw [hDeriv00 G_tilde]
    dsimp [G_tilde]
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_C_mul, ← hL_eval c]
    exact mul_ne_zero hu_inv_ne h_sm

  have hEquiv_tilde : ∀ pt : E × E,
      (G.map (Polynomial.evalRingHom pt.1)).eval pt.2 = 0 ↔
        (G_tilde.map (Polynomial.evalRingHom (e_pt pt).1)).eval (e_pt pt).2 = 0 := by
    intro ⟨t, y⟩
    rw [hevPt, hevPt]
    have hev_rel : evPt (e_pt (t, y)).1 (e_pt (t, y)).2 G_tilde =
        u⁻¹ * evPt t y G := by
      dsimp [G_tilde]
      rw [map_mul, hev_shear c (e_pt (t, y)).1 (e_pt (t, y)).2 G₁]
      change evPt _ _ (Polynomial.C (Polynomial.C u⁻¹)) *
          evPt ((e_pt (t, y)).1 + c * (e_pt (t, y)).2) (e_pt (t, y)).2 (E_Y (E_T G)) = _
      rw [hev_shift]
      have hcc : evPt (e_pt (t, y)).1 (e_pt (t, y)).2 (Polynomial.C (Polynomial.C u⁻¹)) = u⁻¹ := by
        simp [evPt]
      have hx_eq : (e_pt (t, y)).1 + c * (e_pt (t, y)).2 + t₀ = t := by
        dsimp [e_pt]
        ring
      have hy_eq : (e_pt (t, y)).2 + y₀ = y := by
        dsimp [e_pt]
        ring
      rw [hcc, hx_eq, hy_eq]
    rw [hev_rel]
    exact ⟨fun h0 => by rw [h0, mul_zero],
      fun h0 => (mul_eq_zero.mp h0).resolve_left hu_inv_ne⟩

  exact ⟨D₁, G_tilde, e_pt, hD₁_lo, hD₁_hi, hMon_tilde, hDeg_tilde, hTri_tilde,
    hIrr_tilde, hZero_tilde, hSmooth_tilde, hEquiv_tilde⟩

theorem weil_plane_curve_triangular_leftMul_norm_bounds (E : Type u) [Field E] (D₁ : ℕ) (hD₁ : 2 ≤ D₁)
    (G : Polynomial (Polynomial E))
    (hMon : G.Monic)
    (hDeg : G.natDegree = D₁)
    (hTri : ∀ (i j : ℕ), D₁ < i + j → (G.coeff i).coeff j = 0)
    (hIrr : Irreducible G) :
    let N_poly : Polynomial (Polynomial E) → Polynomial E :=
      fun H => (Algebra.leftMulMatrix (AdjoinRoot.powerBasis' hMon).basis (AdjoinRoot.mk G H)).det
    (∀ H : Polynomial (Polynomial E), H ≠ 0 → H.natDegree < D₁ → N_poly H ≠ 0) ∧
    (∀ (M : ℕ) (H : Polynomial (Polynomial E)),
      H.natDegree < D₁ →
      (∀ (i j : ℕ), M < i + j → (H.coeff i).coeff j = 0) →
      (N_poly H).natDegree ≤ D₁ * M) ∧
    (∀ (H : Polynomial (Polynomial E)) (x₁ y₁ : E),
      (G.map (Polynomial.evalRingHom x₁)).eval y₁ = 0 →
      (H.map (Polynomial.evalRingHom x₁)).eval y₁ = 0 →
      (N_poly H).eval x₁ = 0) ∧
    (∀ (H : Polynomial (Polynomial E)) (x₁ : E) (S : Finset E),
      (∀ y ∈ S,
        (G.map (Polynomial.evalRingHom x₁)).eval y = 0 ∧
        ((Polynomial.derivative G).map (Polynomial.evalRingHom x₁)).eval y ≠ 0 ∧
        (H.map (Polynomial.evalRingHom x₁)).eval y = 0) →
      (Polynomial.X - Polynomial.C x₁) ^ S.card ∣ N_poly H) :=
by
  classical
  intro N_poly
  let pb : PowerBasis (Polynomial E) (AdjoinRoot G) := AdjoinRoot.powerBasis' hMon
  let M_mat : Polynomial (Polynomial E) → Matrix (Fin pb.dim) (Fin pb.dim) (Polynomial E) :=
    fun H => Algebra.leftMulMatrix pb.basis (AdjoinRoot.mk G H)
  have hN_eq : ∀ H : Polynomial (Polynomial E), N_poly H = (M_mat H).det := fun _ => rfl
  have hpb_dim : pb.dim = D₁ := (AdjoinRoot.powerBasis'_dim hMon).trans hDeg
  have hdim_pos : 0 < pb.dim := by omega
  have hG_ne_zero : G ≠ 0 := hMon.ne_zero
  have hG_ne_one : G ≠ 1 := by
    intro h1
    have hd := congrArg Polynomial.natDegree h1
    rw [hDeg, Polynomial.natDegree_one] at hd
    omega
  have hMod_deg_D₁ : ∀ P : Polynomial (Polynomial E), (P %ₘ G).natDegree < D₁ := by
    intro P
    rw [← hDeg]
    exact Polynomial.natDegree_modByMonic_lt P hMon hG_ne_one
  have hMod_deg_dim : ∀ P : Polynomial (Polynomial E), (P %ₘ G).natDegree < pb.dim := by
    intro P
    rw [hpb_dim]
    exact hMod_deg_D₁ P
  have hDeg_lt_of_coeff : ∀ Q : Polynomial (Polynomial E),
      (∀ i : ℕ, D₁ ≤ i → Q.coeff i = 0) → Q.natDegree < D₁ := by
    intro Q hQ
    have hle : Q.natDegree ≤ D₁ - 1 := by
      refine Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun N hN => ?_
      exact hQ N (by omega)
    omega
  have hMod_self : ∀ Q : Polynomial (Polynomial E), Q.natDegree < D₁ → Q %ₘ G = Q := by
    intro Q hQ
    by_cases hQ0 : Q = 0
    · rw [hQ0, Polynomial.zero_modByMonic]
    · rw [Polynomial.modByMonic_eq_self_iff hMon,
        Polynomial.degree_eq_natDegree hQ0,
        Polynomial.degree_eq_natDegree hG_ne_zero, hDeg]
      exact WithBot.coe_lt_coe.mpr hQ
  have hSum_fin : ∀ Q : Polynomial (Polynomial E), Q.natDegree < pb.dim →
      Q = ∑ a : Fin pb.dim, Polynomial.C (Q.coeff a.1) * Polynomial.X ^ a.1 := by
    intro Q hQ
    conv_lhs => rw [Polynomial.as_sum_range' Q pb.dim hQ]
    rw [← Fin.sum_univ_eq_sum_range]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [Polynomial.C_mul_X_pow_eq_monomial]
  have hMk_mod : ∀ P : Polynomial (Polynomial E),
      AdjoinRoot.mk G P = AdjoinRoot.mk G (P %ₘ G) := by
    intro P
    conv_lhs => rw [← Polynomial.modByMonic_add_div P G]
    rw [map_add, map_mul, AdjoinRoot.mk_self, zero_mul, add_zero]
  have hBasis_mk : ∀ b : Fin pb.dim,
      pb.basis b = AdjoinRoot.mk G (Polynomial.X ^ b.1) := by
    intro b
    rw [pb.basis_eq_pow b, AdjoinRoot.powerBasis'_gen hMon, ← AdjoinRoot.mk_X, map_pow]
  have hRepr_lt : ∀ Q : Polynomial (Polynomial E), Q.natDegree < pb.dim →
      ⇑(pb.basis.repr (AdjoinRoot.mk G Q)) = fun a : Fin pb.dim => Q.coeff a.1 := by
    intro Q hQ
    have hmk_sum : AdjoinRoot.mk G Q = ∑ a : Fin pb.dim, (Q.coeff a.1) • pb.basis a := by
      conv_lhs => rw [hSum_fin Q hQ]
      rw [map_sum]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [map_mul, AdjoinRoot.mk_C, ← AdjoinRoot.algebraMap_eq, ← Algebra.smul_def, hBasis_mk a]
    rw [hmk_sum, Module.Basis.repr_sum_self]
  have hRepr_any : ∀ (P : Polynomial (Polynomial E)) (a : Fin pb.dim),
      (pb.basis.repr (AdjoinRoot.mk G P)) a = (P %ₘ G).coeff a.1 := by
    intro P a
    rw [hMk_mod P]
    exact congrFun (hRepr_lt (P %ₘ G) (hMod_deg_dim P)) a
  have hM_entry : ∀ (H : Polynomial (Polynomial E)) (a b : Fin pb.dim),
      M_mat H a b = ((H * Polynomial.X ^ b.1) %ₘ G).coeff a.1 := by
    intro H a b
    dsimp [M_mat]
    rw [Algebra.leftMulMatrix_eq_repr_mul, hBasis_mk b, ← map_mul]
    exact hRepr_any (H * Polynomial.X ^ b.1) a
  have hM_mulVec : ∀ (H B : Polynomial (Polynomial E)), B.natDegree < pb.dim →
      ∀ a : Fin pb.dim,
        ((M_mat H).mulVec (fun b : Fin pb.dim => B.coeff b.1)) a =
          ((H * B) %ₘ G).coeff a.1 := by
    intro H B hB a
    have hreprB : (fun b : Fin pb.dim => B.coeff b.1) = ⇑(pb.basis.repr (AdjoinRoot.mk G B)) :=
      (hRepr_lt B hB).symm
    rw [hreprB]
    dsimp [M_mat]
    have hmv := congrFun
      (Algebra.leftMulMatrix_mulVec_repr pb.basis (AdjoinRoot.mk G H) (AdjoinRoot.mk G B)) a
    rw [hmv, ← map_mul]
    exact hRepr_any (H * B) a

  refine ⟨?_, ?_, ?_, ?_⟩

  
  · intro H hH_ne hH_deg
    have hPrime : Prime G := UniqueFactorizationMonoid.irreducible_iff_prime.mp hIrr
    have : IsDomain (AdjoinRoot G) := AdjoinRoot.isDomain_of_prime hPrime
    have hmk_ne : AdjoinRoot.mk G H ≠ 0 := by
      intro hmk0
      have hdvd : G ∣ H := AdjoinRoot.mk_eq_zero.mp hmk0
      have hle := Polynomial.natDegree_le_of_dvd hdvd hH_ne
      omega
    rw [hN_eq H]
    intro hdet0
    obtain ⟨v, hv_ne, hv_mul⟩ := (Matrix.exists_mulVec_eq_zero_iff (M := M_mat H)).mpr hdet0
    let z : AdjoinRoot G := pb.basis.equivFun.symm v
    have hz_ne : z ≠ 0 := by
      intro hz0
      apply hv_ne
      have hv0 : pb.basis.equivFun z = v := pb.basis.equivFun.apply_symm_apply v
      rw [hz0, map_zero] at hv0
      exact hv0.symm
    have hrepr_z : ⇑(pb.basis.repr z) = v := by
      change pb.basis.equivFun z = v
      exact pb.basis.equivFun.apply_symm_apply v
    have hprod_repr : ⇑(pb.basis.repr (AdjoinRoot.mk G H * z)) = 0 := by
      have hmv := Algebra.leftMulMatrix_mulVec_repr pb.basis (AdjoinRoot.mk G H) z
      change (M_mat H).mulVec ⇑(pb.basis.repr z) = ⇑(pb.basis.repr (AdjoinRoot.mk G H * z)) at hmv
      rw [← hmv, hrepr_z]
      exact hv_mul
    have hprod_zero : AdjoinRoot.mk G H * z = 0 := by
      apply pb.basis.repr.injective
      rw [map_zero]
      exact Finsupp.ext fun a => congrFun hprod_repr a
    exact mul_ne_zero hmk_ne hz_ne hprod_zero

  
  · intro M H hH_deg hH_tri
    let IsTriLe : ℕ → Polynomial (Polynomial E) → Prop :=
      fun K P => ∀ i j : ℕ, K < i + j → (P.coeff i).coeff j = 0
    let G_low : Polynomial (Polynomial E) := Polynomial.X ^ D₁ - G
    have hGlow_high : ∀ i : ℕ, D₁ ≤ i → G_low.coeff i = 0 := by
      intro i hi
      dsimp [G_low]
      rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow]
      rcases eq_or_lt_of_le hi with rfl | hlt
      · simp only [↓reduceIte]
        have hlc : G.coeff D₁ = 1 := by
          have h := hMon.leadingCoeff
          rwa [Polynomial.leadingCoeff, hDeg] at h
        rw [hlc, sub_self]
      · have hne : ¬ (i = D₁) := by omega
        simp only [hne, ↓reduceIte]
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [hDeg]; exact hlt), sub_zero]
    have hGlow_tri : IsTriLe D₁ G_low := by
      intro i j hij
      by_cases hi : D₁ ≤ i
      · rw [hGlow_high i hi, Polynomial.coeff_zero]
      · have hne : ¬ (i = D₁) := by omega
        dsimp [G_low]
        rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow]
        simp only [hne, ↓reduceIte, zero_sub, Polynomial.coeff_neg, hTri i j hij, neg_zero]
    have hR_tri : ∀ k : ℕ, IsTriLe k (((Polynomial.X : Polynomial (Polynomial E)) ^ k) %ₘ G) := by
      intro k
      induction k with
      | zero =>
        rw [pow_zero]
        have h1_deg : (1 : Polynomial (Polynomial E)).natDegree < D₁ := by
          rw [Polynomial.natDegree_one]
          omega
        rw [hMod_self 1 h1_deg]
        intro i j hij
        by_cases hi0 : i = 0
        · subst hi0
          have hj_ne : j ≠ 0 := by omega
          rw [Polynomial.coeff_one_zero, Polynomial.coeff_one]
          simp [hj_ne]
        · have hc : (1 : Polynomial (Polynomial E)).coeff i = 0 := by
            rw [Polynomial.coeff_one]
            simp [hi0]
          rw [hc, Polynomial.coeff_zero]
      | succ k ih =>
        set R_k := ((Polynomial.X : Polynomial (Polynomial E)) ^ k) %ₘ G
        have hRk_deg : R_k.natDegree < D₁ := hMod_deg_D₁ _
        have hD₁_split : D₁ = (D₁ - 1) + 1 := by omega
        have hRk_exp : R_k =
            (∑ m ∈ Finset.range (D₁ - 1),
              Polynomial.C (R_k.coeff m) * Polynomial.X ^ m) +
            Polynomial.C (R_k.coeff (D₁ - 1)) * Polynomial.X ^ (D₁ - 1) := by
          conv_lhs => rw [Polynomial.as_sum_range' R_k D₁ hRk_deg, hD₁_split, Finset.sum_range_succ]
          congr 1
          · refine Finset.sum_congr rfl fun m _ => ?_
            rw [Polynomial.C_mul_X_pow_eq_monomial]
          · rw [Polynomial.C_mul_X_pow_eq_monomial]
        let P_rem : Polynomial (Polynomial E) :=
          (∑ m ∈ Finset.range (D₁ - 1),
            Polynomial.C (R_k.coeff m) * Polynomial.X ^ (m + 1)) +
          Polynomial.C (R_k.coeff (D₁ - 1)) * G_low
        have hXRk_eq : Polynomial.X * R_k =
            P_rem + Polynomial.C (R_k.coeff (D₁ - 1)) * G := by
          conv_lhs => rw [hRk_exp]
          rw [mul_add, Finset.mul_sum]
          have hsum_eq :
              (∑ m ∈ Finset.range (D₁ - 1),
                Polynomial.X * (Polynomial.C (R_k.coeff m) * Polynomial.X ^ m)) =
              ∑ m ∈ Finset.range (D₁ - 1),
                Polynomial.C (R_k.coeff m) * Polynomial.X ^ (m + 1) := by
            refine Finset.sum_congr rfl fun m _ => ?_
            rw [pow_succ]
            ring
          have htop_eq :
              Polynomial.X * (Polynomial.C (R_k.coeff (D₁ - 1)) * Polynomial.X ^ (D₁ - 1)) =
              Polynomial.C (R_k.coeff (D₁ - 1)) * G_low +
                Polynomial.C (R_k.coeff (D₁ - 1)) * G := by
            have hpow : (Polynomial.X : Polynomial (Polynomial E)) ^ (D₁ - 1) * Polynomial.X =
                Polynomial.X ^ D₁ := by
              rw [← pow_succ, ← hD₁_split]
            dsimp [G_low]
            calc Polynomial.X * (Polynomial.C (R_k.coeff (D₁ - 1)) * Polynomial.X ^ (D₁ - 1))
                = Polynomial.C (R_k.coeff (D₁ - 1)) *
                    (Polynomial.X ^ (D₁ - 1) * Polynomial.X) := by ring
              _ = Polynomial.C (R_k.coeff (D₁ - 1)) * Polynomial.X ^ D₁ := by rw [hpow]
              _ = Polynomial.C (R_k.coeff (D₁ - 1)) * (Polynomial.X ^ D₁ - G) +
                    Polynomial.C (R_k.coeff (D₁ - 1)) * G := by ring
          rw [hsum_eq, htop_eq]
          dsimp [P_rem]
          ring
        have hPrem_high : ∀ i : ℕ, D₁ ≤ i → P_rem.coeff i = 0 := by
          intro i hi
          dsimp [P_rem]
          rw [Polynomial.coeff_add, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul,
            hGlow_high i hi, mul_zero, add_zero]
          refine Finset.sum_eq_zero fun m hm => ?_
          have hm_lt : m < D₁ - 1 := Finset.mem_range.mp hm
          have hne : m + 1 ≠ i := by omega
          rw [Polynomial.C_mul_X_pow_eq_monomial, Polynomial.coeff_monomial]
          simp [hne]
        have hPrem_mod : P_rem %ₘ G = P_rem :=
          hMod_self P_rem (hDeg_lt_of_coeff P_rem hPrem_high)
        have hRk1_eq : (((Polynomial.X : Polynomial (Polynomial E)) ^ (k + 1)) %ₘ G) = P_rem := by
          have hmk_eq : AdjoinRoot.mk G ((Polynomial.X : Polynomial (Polynomial E)) ^ (k + 1)) =
              AdjoinRoot.mk G P_rem := by
            rw [pow_succ', map_mul, hMk_mod (Polynomial.X ^ k), ← map_mul, hXRk_eq,
              map_add, map_mul, AdjoinRoot.mk_self, mul_zero, add_zero]
          have hhom := congrArg (AdjoinRoot.modByMonicHom hMon) hmk_eq
          rwa [AdjoinRoot.modByMonicHom_mk, AdjoinRoot.modByMonicHom_mk, hPrem_mod] at hhom
        rw [hRk1_eq]
        intro i j hij
        dsimp [P_rem]
        rw [Polynomial.coeff_add, Polynomial.coeff_add, Polynomial.finsetSum_coeff,
          Polynomial.finsetSum_coeff]
        have hsum0 : (∑ m ∈ Finset.range (D₁ - 1),
            ((Polynomial.C (R_k.coeff m) * Polynomial.X ^ (m + 1)).coeff i).coeff j) = 0 := by
          refine Finset.sum_eq_zero fun m _ => ?_
          rw [Polynomial.C_mul_X_pow_eq_monomial, Polynomial.coeff_monomial]
          by_cases hmi : m + 1 = i
          · subst hmi
            simp only [↓reduceIte]
