        intro w
        have h := hNat W (P_push.obj Q) Q Q α_Q (𝟙 _) α_Q (𝟙 Q)
          (by rw [Category.comp_id, P_push.map_id, Category.comp_id]) s w
        simpa [post_αQ, Abelian.Ext.comp_mk₀_id] using h
