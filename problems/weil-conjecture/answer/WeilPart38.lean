    ((weil_etale_pullback_exact_and_pseudofunctor ℓ).2.2.1 U_bar.ι pr_D ℛ₀ ℛ_bar 𝒢_Ubar).1
      hPull_prD hOpen_k
  rw [hU_comm] at hPull_comp
  have hPull_pk : WeilIsEtaleSheafPullback p_k 𝒢_q 𝒢_Ubar :=
    ((weil_etale_pullback_exact_and_pseudofunctor ℓ).2.2.1 p_k U₀.ι ℛ₀ 𝒢_q 𝒢_Ubar).2
      hOpen_F hPull_comp
  obtain ⟨𝒢_bar, hPull_eWU, _, _⟩ :=
    (weil_etale_pullback_exact_and_pseudofunctor ℓ).1 e_WU.hom 𝒢_Ubar
  have hPull_prW : WeilIsEtaleSheafPullback pr_W 𝒢_q 𝒢_bar := by
    have h1 := ((weil_etale_pullback_exact_and_pseudofunctor ℓ).2.2.1
      e_WU.hom p_k 𝒢_q 𝒢_Ubar 𝒢_bar).1 hPull_pk hPull_eWU
    rwa [he_WU] at h1
  refine ⟨𝒢_bar, hPull_prW, fun x_bar => ?_⟩
  obtain ⟨V, v_U, A₀, hv_et, ⟨y_V, hy_V⟩, hFin_A₀, hPull_vU⟩ :=
    hLC_Ubar (e_WU.hom.base x_bar)
  have : AlgebraicGeometry.Etale v_U := hv_et
  let v : V ⟶ W_bar := v_U ≫ e_WU.inv
  have hv_fac : v ≫ e_WU.hom = v_U := by
    change (v_U ≫ e_WU.inv) ≫ e_WU.hom = v_U
    rw [CategoryTheory.Category.assoc, e_WU.inv_hom_id, CategoryTheory.Category.comp_id]
  refine ⟨V, v, A₀, inferInstance, ⟨y_V, ?_⟩, hFin_A₀, ?_⟩
  · change e_WU.inv.base (v_U.base y_V) = x_bar
    rw [hy_V]
    change (e_WU.hom ≫ e_WU.inv).base x_bar = x_bar
    rw [e_WU.hom_inv_id]
    rfl
  · rw [← hv_fac] at hPull_vU
    exact ((weil_etale_pullback_exact_and_pseudofunctor ℓ).2.2.1
      v e_WU.hom 𝒢_Ubar 𝒢_bar _).2 hPull_eWU hPull_vU

theorem weil_mid_dev_raw_locConst_proetale_algClosure_descent (F : Type u) [Finite F] [Field F]
    (W₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.LocallyOfFiniteType W₀.hom]
    (𝒜 : CategoryTheory.Sheaf W₀.left.smallEtaleTopology AddCommGrpCat.{u})
    (𝒜_bar : CategoryTheory.Sheaf (weilGeomScheme F W₀).smallEtaleTopology AddCommGrpCat.{u})
    (hPull : WeilIsEtaleSheafPullback
      (CategoryTheory.Limits.pullback.fst W₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      𝒜 𝒜_bar)
    (hLC_bar : ∀ x_bar : ↥(weilGeomScheme F W₀),
      ∃ (V : AlgebraicGeometry.Scheme.{u}) (v : V ⟶ weilGeomScheme F W₀) (A₀ : AddCommGrpCat.{u}),
        AlgebraicGeometry.Etale v ∧
        x_bar ∈ Set.range v.base ∧
        Finite ↥A₀ ∧
        WeilIsEtaleSheafPullback v 𝒜_bar
          ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A₀))
    (x : ↥W₀.left) :
    ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ W₀.left) (A₀ : AddCommGrpCat.{u}),
      AlgebraicGeometry.Etale w ∧
      x ∈ Set.range w.base ∧
      Finite ↥A₀ ∧
      WeilIsEtaleSheafPullback w 𝒜
        ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀) :=
by
  classical
  have : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have : CategoryTheory.MorphismProperty.IsMultiplicative (@AlgebraicGeometry.Etale.{u}) :=
    AlgebraicGeometry.Etale.instIsMultiplicativeScheme.{u}
  obtain ⟨hc_all, hr_all, hSite⟩ := weil_etale_site_pullback_rightAdjoint_and_exact_package.{u}
  let pf_of : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}}, Quiver.Hom W₁ W₂ →
      CategoryTheory.Functor (CategoryTheory.Sheaf W₁.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Sheaf W₂.smallEtaleTopology AddCommGrpCat.{u}) :=
    fun {W₁ W₂} h =>
      letI := @hc_all W₁ W₂ h
      (weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
        W₂.smallEtaleTopology W₁.smallEtaleTopology
  let pb_of : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}}, Quiver.Hom W₁ W₂ →
      CategoryTheory.Functor (CategoryTheory.Sheaf W₂.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Sheaf W₁.smallEtaleTopology AddCommGrpCat.{u}) :=
    fun {W₁ W₂} h =>
      letI := @hc_all W₁ W₂ h
      letI := @hr_all W₁ W₂ h
      (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
        W₂.smallEtaleTopology W₁.smallEtaleTopology
  let adj_of : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂),
      CategoryTheory.Adjunction (pb_of h) (pf_of h) :=
    fun {W₁ W₂} h =>
      letI := @hc_all W₁ W₂ h
      letI := @hr_all W₁ W₂ h
      (weilEtaleSitePullback h).sheafAdjunctionContinuous AddCommGrpCat.{u}
        W₂.smallEtaleTopology W₁.smallEtaleTopology
  let T_of : ∀ (Y : AlgebraicGeometry.Scheme.{u}), Y.Etale :=
    fun Y => CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.id Y)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id Y))
  let k := AlgebraicClosure F
  let f_ext := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
  let W_bar := weilGeomScheme F W₀
  let pr_W : Quiver.Hom W_bar W₀.left := CategoryTheory.Limits.pullback.fst W₀.hom f_ext
  let snd_W : Quiver.Hom W_bar (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Limits.pullback.snd W₀.hom f_ext
  let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget W_bar
  let hCont_W := @hc_all W_bar W₀.left pr_W
  let hAdj_W := @hr_all W_bar W₀.left pr_W
  let L_prW := pb_of pr_W
  let adj_prW := adj_of pr_W

  
  have hSurj_fext : AlgebraicGeometry.Surjective f_ext :=
    AlgebraicGeometry.Surjective.mk (fun _ => ⟨default, Subsingleton.elim _ _⟩)
  have hSurj_prW : AlgebraicGeometry.Surjective pr_W :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback W₀.hom f_ext).flip hSurj_fext
  obtain ⟨x_bar, hx_bar⟩ := hSurj_prW.1 x
  obtain ⟨V, v, A₀, hv_et, ⟨y_V, hy_V⟩, hFin_A₀, hPull_v⟩ := hLC_bar x_bar
  let V_bar : W_bar.Etale := @AlgebraicGeometry.Scheme.Etale.mk W_bar V v hv_et
  obtain ⟨_, ⟨hSecInj, hSecSurj⟩, hAffBasis⟩ :=
    (weil_algClosure_bc_proetale_sections_and_bc0_iso F).1 W₀ hCont_W hAdj_W
  obtain ⟨ι, U_fam, u_fam, hCov_V, hBasis_V⟩ := hAffBasis V_bar
  obtain ⟨Y_cov, f_cov, y_Y, hf_cov_mem, _, hy_Y⟩ :=
    (weil_etale_constant_sheaf_locallyConstant_equiv_and_pullback_adj.1
      W_bar V_bar (CategoryTheory.Sieve.ofArrows U_fam u_fam)).mp hCov_V y_V
  obtain ⟨i_cov, h_Y, rfl⟩ :=
    (CategoryTheory.Sieve.mem_ofArrows_iff U_fam u_fam f_cov).mp hf_cov_mem
  let Z_bar : W_bar.Etale := U_fam i_cov
  let Z_bar_sch : AlgebraicGeometry.Scheme.{u} := (Fgt_W.obj Z_bar).left
  let z_bar : Quiver.Hom Z_bar_sch W_bar := (Fgt_W.obj Z_bar).hom
  have hz_bar_et : AlgebraicGeometry.Etale z_bar := Z_bar.prop
  let u_i : Quiver.Hom Z_bar_sch V := (Fgt_W.map (u_fam i_cov)).left
  let h_Y_left : Quiver.Hom (Fgt_W.obj Y_cov).left Z_bar_sch := (Fgt_W.map h_Y).left
  let y_bar : ↥Z_bar_sch := h_Y_left.base y_Y
  have hui_v : u_i ≫ v = z_bar := CategoryTheory.Over.w (Fgt_W.map (u_fam i_cov))
  have hy_bar_V : u_i.base y_bar = y_V := by
    have hcomp : ((Fgt_W.map (h_Y ≫ u_fam i_cov)).left).base y_Y = u_i.base y_bar :=
      AlgebraicGeometry.Scheme.Hom.comp_apply h_Y_left u_i y_Y
    exact hcomp.symm.trans hy_Y
  have hz_bar_pt : z_bar.base y_bar = x_bar := by
    have h1 : z_bar.base y_bar = v.base (u_i.base y_bar) :=
      (congrArg (fun m : Z_bar_sch ⟶ W_bar => m.base y_bar) hui_v.symm).trans
        (AlgebraicGeometry.Scheme.Hom.comp_apply u_i v y_bar)
    exact h1.trans ((congrArg v.base hy_bar_V).trans hy_V)
  obtain ⟨E₀, hFin_E₀, hFld_E₀, hAlgF_E₀, hAlgE₀_k, hST_FE₀k,
    Z₀, hAff_Z₀, z₀_W, hz₀_et, p_Z₀, hz₀_hom, hp_Z₀, hp_Z₀_W⟩ := hBasis_V i_cov

  have hPullPkg := weil_etale_pullback_exact_and_pseudofunctor.{u} 2
  obtain ⟨hc_pr', hr_pr', ⟨e_pr'⟩⟩ := hPull
  obtain rfl : hc_pr' = hCont_W := Subsingleton.elim _ _
  obtain rfl : hr_pr' = hAdj_W := Subsingleton.elim _ _
  let C_V := CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}
  let C_Zbar := CategoryTheory.constantSheaf Z_bar_sch.smallEtaleTopology AddCommGrpCat.{u}
  have hPull_v_L : WeilIsEtaleSheafPullback v (L_prW.obj 𝒜) (C_V.obj A₀) :=
    hPullPkg.2.1 v 𝒜_bar (L_prW.obj 𝒜) (C_V.obj A₀) (C_V.obj A₀)
      hPull_v ⟨e_pr'.symm⟩ ⟨CategoryTheory.Iso.refl _⟩
  have hPull_ui : WeilIsEtaleSheafPullback u_i (C_V.obj A₀) (C_Zbar.obj A₀) :=
    hPullPkg.2.2.2.1 u_i A₀
  have hPull_zbar : WeilIsEtaleSheafPullback z_bar (L_prW.obj 𝒜) (C_Zbar.obj A₀) :=
    hui_v ▸ (hPullPkg.2.2.1 u_i v (L_prW.obj 𝒜) (C_V.obj A₀) (C_Zbar.obj A₀)).1
      hPull_v_L hPull_ui
  obtain ⟨hc_zb', hr_zb', ⟨e_zb'⟩⟩ := hPull_zbar
  obtain rfl : hc_zb' = @hc_all Z_bar_sch W_bar z_bar := Subsingleton.elim _ _
  obtain rfl : hr_zb' = @hr_all Z_bar_sch W_bar z_bar := Subsingleton.elim _ _
  let Ψ_bar : C_Zbar.obj A₀ ≅ (pb_of z_bar).obj (L_prW.obj 𝒜) := e_zb'.symm

  let T_Zbar : Z_bar_sch.Etale := T_of Z_bar_sch
  obtain ⟨hT_Zbar, _, _, _, _⟩ :=
    weil_etale_constant_sheaf_locallyConstant_equiv_and_pullback_adj.2.2 Z_bar_sch A₀
  let adj_const_Zbar :=
    CategoryTheory.constantSheafAdj Z_bar_sch.smallEtaleTopology AddCommGrpCat.{u} hT_Zbar
  let z_bar_hom : Quiver.Hom Z_bar_sch W_bar := Z_bar.hom
  let δ_zbar : Quiver.Hom T_Zbar ((weilEtaleSitePullback z_bar).obj Z_bar) :=
    CategoryTheory.MorphismProperty.Over.homMk
      (CategoryTheory.Limits.pullback.lift
        (CategoryTheory.CategoryStruct.id Z_bar_sch)
        (CategoryTheory.CategoryStruct.id Z_bar_sch)
        (show CategoryTheory.CategoryStruct.id Z_bar_sch ≫ z_bar_hom =
            CategoryTheory.CategoryStruct.id Z_bar_sch ≫ z_bar from rfl))
      (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
  let θ_zbar : (L_prW.obj 𝒜).obj.obj (Opposite.op Z_bar) ⟶
      ((pb_of z_bar).obj (L_prW.obj 𝒜)).obj.obj (Opposite.op T_Zbar) :=
    CategoryTheory.CategoryStruct.comp
      (((adj_of z_bar).unit.app (L_prW.obj 𝒜)).hom.app (Opposite.op Z_bar))
      (((pb_of z_bar).obj (L_prW.obj 𝒜)).obj.map (Opposite.op δ_zbar))
  have hBij_θzbar : Function.Bijective θ_zbar :=
    (weil_etale_nonmonic_extension_by_zero_and_slice_injective.{u}
      (@hc_all) (@hr_all) z_bar hz_bar_et).1 (L_prW.obj 𝒜)
  have : CategoryTheory.IsIso θ_zbar :=
    (CategoryTheory.ConcreteCategory.isIso_iff_bijective θ_zbar).mpr hBij_θzbar
  let c_bar : A₀ ⟶ (L_prW.obj 𝒜).obj.obj (Opposite.op Z_bar) :=
    (adj_const_Zbar.unit.app A₀ ≫ Ψ_bar.hom.hom.app (Opposite.op T_Zbar)) ≫
      CategoryTheory.inv θ_zbar
  have hc_bar_θ :
      c_bar ≫ θ_zbar =
        adj_const_Zbar.unit.app A₀ ≫ Ψ_bar.hom.hom.app (Opposite.op T_Zbar) := by
    dsimp [c_bar]
    rw [CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
      CategoryTheory.Category.comp_id]

  
  have hListDesc : ∀ (L : List ↥A₀),
      ∃ (E_L : Type u) (_ : Finite E_L) (_ : Field E_L)
        (_ : Algebra F E_L) (_ : Algebra E_L k) (_ : IsScalarTower F E_L k)
        (Z_L : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E_L)))
        (_ : AlgebraicGeometry.IsAffine Z_L.left)
        (w_L : Z_L.left ⟶ W₀.left) (hw_L : AlgebraicGeometry.Etale w_L)
        (p_L : Z_bar_sch ⟶ Z_L.left)
        (hp_L_W : p_L ≫ w_L = z_bar ≫ pr_W),
        w_L ≫ W₀.hom =
          Z_L.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E_L)) ∧
        CategoryTheory.IsPullback p_L (z_bar ≫ snd_W) Z_L.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E_L k))) ∧
        let W_L_et : W₀.left.Etale := @AlgebraicGeometry.Scheme.Etale.mk W₀.left Z_L.left w_L hw_L
        let σ_L : Quiver.Hom Z_bar ((weilEtaleSitePullback pr_W).obj W_L_et) :=
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.Limits.pullback.lift p_L z_bar hp_L_W)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        ∀ b ∈ L, ∃ s_b : ↑(𝒜.obj.obj (Opposite.op W_L_et)),
          ((L_prW.obj 𝒜).obj.map (Opposite.op σ_L)).hom
            (((adj_prW.unit.app 𝒜).hom.app (Opposite.op W_L_et)).hom s_b) = c_bar.hom b := by
    intro L
    induction L with
    | nil =>
      refine ⟨E₀, hFin_E₀, hFld_E₀, hAlgF_E₀, hAlgE₀_k, hST_FE₀k,
        Z₀, hAff_Z₀, z₀_W, hz₀_et, p_Z₀, hp_Z₀_W, hz₀_hom, hp_Z₀, ?_⟩
      intro _ _ b hb
      cases hb
    | cons a tl ih =>
      obtain ⟨E_tl, hFin_tl, hFld_tl, hAlgF_tl, hAlg_tl_k, hST_F_tl_k,
        Z_tl, hAff_tl, w_tl, hw_tl, p_tl, hp_tl_W, hw_tl_hom, hp_tl_pb, hSec_tl⟩ := ih
      letI : Finite E_tl := hFin_tl
      letI : Field E_tl := hFld_tl
      letI : Algebra F E_tl := hAlgF_tl
      letI : Algebra E_tl k := hAlg_tl_k
      letI : IsScalarTower F E_tl k := hST_F_tl_k
      letI : AlgebraicGeometry.IsAffine Z_tl.left := hAff_tl
      letI : AlgebraicGeometry.Etale w_tl := hw_tl
      haveI : CompactSpace ↥Z_tl.left :=
        AlgebraicGeometry.Scheme.compactSpace_of_isAffine Z_tl.left
      obtain ⟨E₁, hFin₁, hFld₁, hAlgF₁, hAlg_tl₁, hAlg₁k,
        hST_F_tl₁, hST_tl₁k, hST_F₁k,
        hw₁_et, p_Z₁, hp_Z₁_W, hp_fst, hp_snd, s₁, hs₁⟩ :=
        @hSecSurj E_tl hFin_tl hFld_tl hAlgF_tl hAlg_tl_k hST_F_tl_k
          Z_tl _ w_tl hw_tl hw_tl_hom Z_bar p_tl hp_tl_pb hp_tl_W 𝒜 (c_bar.hom a)
      letI : Finite E₁ := hFin₁
      letI : Field E₁ := hFld₁
      letI : Algebra F E₁ := hAlgF₁
      letI : Algebra E_tl E₁ := hAlg_tl₁
      letI : Algebra E₁ k := hAlg₁k
      letI : IsScalarTower F E_tl E₁ := hST_F_tl₁
      letI : IsScalarTower E_tl E₁ k := hST_tl₁k
      letI : IsScalarTower F E₁ k := hST_F₁k
      let g_01 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E_tl E₁))
      let Z₁_left := CategoryTheory.Limits.pullback Z_tl.hom g_01
      let fst_01 := CategoryTheory.Limits.pullback.fst Z_tl.hom g_01
      let snd_01 := CategoryTheory.Limits.pullback.snd Z_tl.hom g_01
      let Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E₁)) :=
        CategoryTheory.Over.mk snd_01
      let w₁ : Z₁.left ⟶ W₀.left := fst_01 ≫ w_tl
      have hAff₁ : AlgebraicGeometry.IsAffine Z₁.left :=
        @AlgebraicGeometry.Scheme.Pullback.isAffine_of_isAffine_isAffine_isAffine
          _ _ _ Z_tl.hom g_01 hAff_tl inferInstance inferInstance
      have hg_F_1 : g_01 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E_tl)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E₁)) := by
        rw [← AlgebraicGeometry.Spec.map_comp]
        exact congrArg AlgebraicGeometry.Spec.map
          (CommRingCat.hom_ext (RingHom.ext fun r =>
            (IsScalarTower.algebraMap_apply F E_tl E₁ r).symm))
      have hw₁_hom : w₁ ≫ W₀.hom =
          Z₁.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E₁)) := by
        change (fst_01 ≫ w_tl) ≫ W₀.hom = snd_01 ≫ _
        rw [CategoryTheory.Category.assoc, hw_tl_hom, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc, hg_F_1]
      have hg_tl_k : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₁ k)) ≫ g_01 =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E_tl k)) := by
        rw [← AlgebraicGeometry.Spec.map_comp]
        exact congrArg AlgebraicGeometry.Spec.map
          (CommRingCat.hom_ext (RingHom.ext fun r =>
            (IsScalarTower.algebraMap_apply E_tl E₁ k r).symm))
      have hp_outer : CategoryTheory.IsPullback (p_Z₁ ≫ fst_01) (z_bar ≫ snd_W) Z_tl.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₁ k)) ≫ g_01) := by
        rw [hp_fst, hg_tl_k]
        exact hp_tl_pb
      have hp_Z₁_pb : CategoryTheory.IsPullback p_Z₁ (z_bar ≫ snd_W) Z₁.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₁ k))) :=
        CategoryTheory.IsPullback.of_right hp_outer hp_snd
          (CategoryTheory.IsPullback.of_hasPullback Z_tl.hom g_01)
      refine ⟨E₁, hFin₁, hFld₁, hAlgF₁, hAlg₁k, hST_F₁k,
        Z₁, hAff₁, w₁, hw₁_et, p_Z₁, hp_Z₁_W, hw₁_hom, hp_Z₁_pb, ?_⟩
      let W_tl_et : W₀.left.Etale := @AlgebraicGeometry.Scheme.Etale.mk W₀.left Z_tl.left w_tl hw_tl
      let W₁_et : W₀.left.Etale := @AlgebraicGeometry.Scheme.Etale.mk W₀.left Z₁.left w₁ hw₁_et
      let σ_tl : Quiver.Hom Z_bar ((weilEtaleSitePullback pr_W).obj W_tl_et) :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift p_tl z_bar hp_tl_W)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      let σ₁ : Quiver.Hom Z_bar ((weilEtaleSitePullback pr_W).obj W₁_et) :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift p_Z₁ z_bar hp_Z₁_W)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      let q_step : Quiver.Hom W₁_et W_tl_et :=
        CategoryTheory.MorphismProperty.Over.homMk fst_01 rfl
      have hσ_step :
