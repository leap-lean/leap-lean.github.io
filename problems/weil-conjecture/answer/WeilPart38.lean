          rw [hcomp, ← Polynomial.hom_eval₂ q_a (algebraMap E E') Polynomial.C a,
            ← Polynomial.aeval_def, minpoly.aeval E a, map_zero]
        exact hCa_int.mul (hX_int.pow n)
    exact isIntegral_trans w_op hw_int_PE'_op
  obtain ⟨G, hG_mon, hG_deg, hG_irr, hG_deriv, hG_eval⟩ :
      ∃ G : Polynomial (Polynomial E),
