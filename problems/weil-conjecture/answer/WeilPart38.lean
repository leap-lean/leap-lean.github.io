        (fun pt => Subsingleton.elim _ _) F₂ F₁ hPb
    refine ⟨⟨e_H0⟩, ⟨fun hZ₂ => ?_, fun hZ₁ => ?_⟩⟩
    · have _ : Subsingleton (F₂.H 0) := CategoryTheory.Sheaf.subsingleton_H_of_isZero hZ₂ 0
      have _ : Subsingleton (F₁.H 0) := e_H0.toEquiv.subsingleton
      exact (hSpecK_site K₁).2.1 F₁ inferInstance
    · have _ : Subsingleton (F₁.H 0) := CategoryTheory.Sheaf.subsingleton_H_of_isZero hZ₁ 0
      have _ : Subsingleton (F₂.H 0) := e_H0.symm.toEquiv.subsingleton
      exact (hSpecK_site K₂).2.1 F₂ inferInstance

  have hKerH0_inj : ∀ {X : AlgebraicGeometry.Scheme.{u}}
      (T_X : X.Etale) (hT_X : CategoryTheory.Limits.IsTerminal T_X)
      {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}} (ψ : F₁ ⟶ F₂),
      Subsingleton ((CategoryTheory.Limits.kernel ψ).H 0) →
      Function.Injective (ψ.hom.app (Opposite.op T_X)) := by
    intro X T_X hT_X F₁ F₂ ψ hSub x₁ x₂ hx
    have hSub_sec : Subsingleton ↥((CategoryTheory.Limits.kernel ψ).obj.obj (Opposite.op T_X)) :=
      (CategoryTheory.Sheaf.H.equiv₀ (CategoryTheory.Limits.kernel ψ) hT_X).symm.toEquiv.subsingleton
    rw [← sub_eq_zero]
    set x := x₁ - x₂
    have hx0 : ψ.hom.app (Opposite.op T_X) x = 0 := by
      dsimp [x]; rw [map_sub, hx, sub_self]
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let adj_X := CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u} hT_X
    let g : Aℤ ⟶ F₁.obj.obj (Opposite.op T_X) :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • x
          map_zero' := by simp
          map_add' := fun a b => add_zsmul x a.down b.down }
    have hg_ψ : g ≫ ψ.hom.app (Opposite.op T_X) = 0 := by
      ext ⟨z⟩
      change ψ.hom.app (Opposite.op T_X) (z • x) = 0
      rw [map_zsmul, hx0, zsmul_zero]
    let g_sh : (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ ⟶ F₁ :=
      (adj_X.homEquiv Aℤ F₁).symm g
    have hg_app : adj_X.unit.app Aℤ ≫ g_sh.hom.app (Opposite.op T_X) = g :=
      (adj_X.homEquiv Aℤ F₁).apply_symm_apply g
    have hg_sh_ψ : g_sh ≫ ψ = 0 := by
      apply (adj_X.homEquiv Aℤ F₂).injective
      have h1 : adj_X.homEquiv Aℤ F₂ (g_sh ≫ ψ) =
          adj_X.unit.app Aℤ ≫ g_sh.hom.app (Opposite.op T_X) ≫ ψ.hom.app (Opposite.op T_X) := rfl
      have h2 : adj_X.homEquiv Aℤ F₂ 0 =
          adj_X.unit.app Aℤ ≫ (0 : _ ⟶ F₂).hom.app (Opposite.op T_X) := rfl
      rw [h1, h2, ← CategoryTheory.Category.assoc, hg_app, hg_ψ]
      ext ⟨z⟩; rfl
    let l_sh := CategoryTheory.Limits.kernel.lift ψ g_sh hg_sh_ψ
    have hl_zero : l_sh.hom.app (Opposite.op T_X) = 0 := by
      ext z; exact Subsingleton.elim _ _
    have hg_zero : g = 0 := by
      rw [← hg_app]
      have hfac : g_sh.hom.app (Opposite.op T_X) =
          l_sh.hom.app (Opposite.op T_X) ≫
            (CategoryTheory.Limits.kernel.ι ψ).hom.app (Opposite.op T_X) :=
        congrArg (fun m => m.hom.app (Opposite.op T_X))
          (CategoryTheory.Limits.kernel.lift_ι ψ g_sh hg_sh_ψ).symm
      rw [hfac, hl_zero, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
    have hx1 : g (ULift.up 1) = 0 := congrArg (fun m : Aℤ ⟶ _ => m (ULift.up 1)) hg_zero
    change (1 : ℤ) • x = 0 at hx1
    rwa [one_zsmul] at hx1

