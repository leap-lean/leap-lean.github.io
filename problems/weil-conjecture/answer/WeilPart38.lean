        obtain ⟨z₀, hz₀_fst, _⟩ := Scheme.Pullback.exists_preimage_pullback y v_pt hv_pt.symm
        refine ⟨B_h.obj V, B_h.map u, e_pb.inv.base z₀,
          ⟨V, u, 𝟙 (B_h.obj V), huR, (Category.id_comp _).symm⟩, hMorEt (B_h.map u), ?_⟩
        have hcomp : e_pb.inv ≫ (B_h.map u).left =
            Limits.pullback.fst (Limits.pullback.fst E.hom h) u.left :=
          (Iso.inv_comp_eq e_pb).mpr hpb_top.isoPullback_hom_fst.symm
        exact (Scheme.Hom.comp_apply e_pb.inv ((B_h.map u).left) z₀).symm.trans
          ((congrArg (fun m : _ ⟶ (B_h.obj E).left => m.base z₀) hcomp).trans hz₀_fst)
      exact Functor.isContinuous_of_coverPreserving hCompat hCov
    have hOpenCont : ∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X}
        (hw : AlgebraicGeometry.Etale w),
        (siteMap hw).IsContinuous V.smallEtaleTopology X.smallEtaleTopology := by
      clear * - hEtComp siteMap hMemEt hMorEt
      intro V X w hw
      let M_w : Functor V.Etale X.Etale := siteMap hw
      have hCompat : CompatiblePreserving X.smallEtaleTopology M_w := by
        refine CompatiblePreserving.mk ?_
        intro ℱ Y T z hz Y₁ Y₂ Z₀ f₁ f₂ g₁ g₂ hg₁ hg₂ hcomm
        have hcomm_left : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
          congrArg (fun m => ((AlgebraicGeometry.Scheme.Etale.forget X).map m).left) hcomm
        have hf₁_et : AlgebraicGeometry.Etale f₁.left := hMorEt f₁
        have hZV_et : AlgebraicGeometry.Etale (f₁.left ≫ Y₁.hom) :=
          MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) f₁.left Y₁.hom hf₁_et Y₁.prop
        let Z_V : V.Etale := MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) hZV_et
        let f₁_V : Z_V ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
        have hw₂ : f₂.left ≫ Y₂.hom = Z_V.hom :=
          (congrArg (f₂.left ≫ ·) (MorphismProperty.Over.w g₂).symm).trans
            ((Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ Y.hom) hcomm_left.symm).trans
                ((Category.assoc _ _ _).trans
                  (congrArg (f₁.left ≫ ·) (MorphismProperty.Over.w g₁)))))
        let f₂_V : Z_V ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left hw₂ trivial
        have hfV_comm : f₁_V ≫ g₁ = f₂_V ≫ g₂ := by
          apply (AlgebraicGeometry.Scheme.Etale.forget V).map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact hcomm_left
        have hz_eq := hz f₁_V f₂_V hg₁ hg₂ hfV_comm
        have heZ_w : 𝟙 Z₀.left ≫ (M_w.obj Z_V).hom = Z₀.hom :=
          (Category.id_comp _).trans
            ((Category.assoc f₁.left Y₁.hom w).trans (MorphismProperty.Over.w f₁))
        let e_Z : Z₀ ⟶ M_w.obj Z_V := MorphismProperty.Over.homMk (𝟙 Z₀.left) heZ_w trivial
        have he₁ : e_Z ≫ M_w.map f₁_V = f₁ := by
          apply (AlgebraicGeometry.Scheme.Etale.forget X).map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact Category.id_comp f₁.left
        have he₂ : e_Z ≫ M_w.map f₂_V = f₂ := by
          apply (AlgebraicGeometry.Scheme.Etale.forget X).map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact Category.id_comp f₂.left
