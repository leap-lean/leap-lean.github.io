            ext y; simp only [Set.mem_singleton_iff, Set.mem_preimage]
            exact ⟨fun h => h ▸ rfl, fun h => by
              have h2 := congrArg iso_EC.inv.base h
              change (iso_EC.hom ≫ iso_EC.inv).base y = (iso_EC.hom ≫ iso_EC.inv).base z at h2
              rwa [iso_EC.hom_inv_id] at h2⟩
          rw [hpre]; exact (hClosed_pt _).preimage iso_EC.hom.continuous
        let S_other : Set ↥E_C := ({z₀} : Set ↥E_C)ᶜ
        have hClosed_S_other : IsClosed S_other := by
          have hFin_S : S_other.Finite := Set.toFinite S_other
          have hU : S_other = ⋃ z ∈ S_other, ({z} : Set ↥E_C) := by ext y; simp [S_other]
          rw [hU]; exact hFin_S.isClosed_biUnion (fun z _ => hClosed_EC_pt z)
        let Z_other : Set (PrimeSpectrum C) := fst_C.base '' S_other
        have hClosed_Z_other : IsClosed Z_other :=
          fst_C.isClosedEmbedding.isClosedMap S_other hClosed_S_other
        have hpw_not : p_w ∉ Z_other := by
          rintro ⟨z', hz'_ne, hz'_eq⟩
          exact hz'_ne (fst_C.isClosedEmbedding.injective (hz'_eq.trans hz₀_fst.symm))
        obtain ⟨O_bas, ⟨g, rfl⟩, hpw_g, hg_sub⟩ :=
          PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open
            hpw_not hClosed_Z_other.isOpen_compl
        let W_g := Spec (CommRingCat.of (Localization.Away g))
        let j_g : W_g ⟶ Spec R_V := Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away g)))
        have _ : IsOpenImmersion j_g := IsOpenImmersion.of_isLocalization g
        have _ : Etale j_g := inferInstance
        have hj_g_range : Set.range j_g.base = (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum C)) :=
          PrimeSpectrum.localization_away_comap_range (Localization.Away g) g
        obtain ⟨w_g, hw_g⟩ : p_w ∈ Set.range j_g.base := by rwa [hj_g_range]
        let W' : Y.Etale := MorphismProperty.Over.mk ⊤ (j_g ≫ j_V ≫ W.hom) inferInstance
        let f_W' : W' ⟶ W := MorphismProperty.Over.homMk (j_g ≫ j_V) rfl
        refine ⟨W', f_W', inferInstance,
          ⟨w_g, by change j_V.base (j_g.base w_g) = w₀; rw [hw_g, hj_V_pt]⟩, Or.inr ?_⟩
        let P' := (B_i₀.obj W').left
        let fst' : P' ⟶ W_g := Limits.pullback.fst W'.hom i₀
        let snd' : P' ⟶ S_k₁ := (B_i₀.obj W').hom
        have hpb' : IsPullback fst' snd' (j_g ≫ j_V ≫ W.hom) i₀ :=
          IsPullback.of_hasPullback W'.hom i₀
        have _ : IsClosedImmersion fst' :=
          MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb'.flip inferInstance
        have _ : IsAffine P' := isAffine_of_isAffineHom fst'
        have _ : Etale snd' := (B_i₀.obj W').prop
        have hcomm_wg : W'.hom.base w_g = i₀.base pt_k := by
          change W.hom.base (j_V.base (j_g.base w_g)) = i₀.base pt_k
          rw [hw_g, hj_V_pt, hpt_k]
        obtain ⟨p₀', -, -⟩ :=
          Scheme.Pullback.exists_preimage_pullback (f := W'.hom) (g := i₀) w_g pt_k hcomm_wg
        let lift_EC : P' ⟶ E_C :=
          Limits.pullback.lift (fst' ≫ j_g) snd' (by rw [Category.assoc]; exact hpb'.w)
        have hpb_lift_out : IsPullback fst' (lift_EC ≫ snd_C) (j_g ≫ j_V ≫ W.hom) i₀ := by
          have hsnd_eq : lift_EC ≫ snd_C = snd' := Limits.pullback.lift_snd _ _ _
          rw [hsnd_eq]; exact hpb'
        have hpb_lift : IsPullback fst' lift_EC j_g fst_C :=
          IsPullback.of_bot hpb_lift_out (Limits.pullback.lift_fst _ _ _).symm hpb_C
        have _ : IsOpenImmersion lift_EC :=
          MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_lift inferInstance
        have hSub_P' : Subsingleton ↥P' := ⟨fun x₁ x₂ => by
          apply lift_EC.isOpenEmbedding.injective
          have hx_eq : ∀ x : ↥P', lift_EC.base x = z₀ := by
            intro x; by_contra hx_ne
            have hmem_Z : fst_C.base (lift_EC.base x) ∈ Z_other := ⟨lift_EC.base x, hx_ne, rfl⟩
            have hfst_eq : fst_C.base (lift_EC.base x) = j_g.base (fst'.base x) := by
              change (lift_EC ≫ fst_C).base x = (fst' ≫ j_g).base x
              rw [Limits.pullback.lift_fst]
            rw [hfst_eq] at hmem_Z
            have hmem_g : j_g.base (fst'.base x) ∈
                (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum C)) := by
              rw [← hj_g_range]; exact ⟨fst'.base x, rfl⟩
            exact (hg_sub hmem_g) hmem_Z
          rw [hx_eq x₁, hx_eq x₂]⟩
        obtain ⟨inv_snd, h_hom_inv, h_inv_hom⟩ := (hEtaleUniqueIso P' snd' ⟨p₀'⟩ hSub_P').out
        exact ⟨{ hom := MorphismProperty.Over.homMk snd' (Category.comp_id _)
                 inv := MorphismProperty.Over.homMk inv_snd h_inv_hom
                 hom_inv_id := (Scheme.Etale.forget S_k₁).map_injective
                   (Over.OverMorphism.ext h_hom_inv)
                 inv_hom_id := (Scheme.Etale.forget S_k₁).map_injective
                   (Over.OverMorphism.ext h_inv_hom) }⟩
      · have hClosed_range : IsClosed (Set.range i₀.base) := i₀.isClosedEmbedding.isClosed_range
        let U_out : W.left.Opens :=
          ⟨W.hom.base ⁻¹' (Set.range i₀.base)ᶜ, hClosed_range.isOpen_compl.preimage W.hom.continuous⟩
        let W' : Y.Etale := MorphismProperty.Over.mk ⊤ (U_out.ι ≫ W.hom) inferInstance
        let f_W' : W' ⟶ W := MorphismProperty.Over.homMk U_out.ι rfl
        refine ⟨W', f_W', inferInstance, ⟨⟨w₀, hw_mem⟩, rfl⟩, Or.inl ⟨fun z => ?_⟩⟩
        let fst_out := Limits.pullback.fst W'.hom i₀
        let snd_out := Limits.pullback.snd W'.hom i₀
        have hcond : W'.hom.base (fst_out.base z) = i₀.base (snd_out.base z) := by
          change (fst_out ≫ W'.hom).base z = (snd_out ≫ i₀).base z
          rw [Limits.pullback.condition]
        exact (fst_out.base z).2 ⟨snd_out.base z, hcond.symm⟩
    have hMemEtale : ∀ (W : Y.Etale) (R : Sieve W),
        R ∈ Y.smallEtaleTopology W ↔
          ∀ (x : ↥W.left), ∃ (Z : Y.Etale) (f : Z ⟶ W) (z : ↥Z.left),
            R.arrows f ∧ Etale f.left ∧ f.left.base z = x := by
      intro W R
      have heq := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        Y (le_refl (@Etale : MorphismProperty Scheme.{u}))
      have hiff := @Scheme.mem_toGrothendieck_smallPretopology
        (@Etale : MorphismProperty Scheme.{u}) (@Etale : MorphismProperty Scheme.{u}) Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition
        inferInstance inferInstance inferInstance inferInstance W R
      exact (iff_of_eq (congrArg (fun J : GrothendieckTopology Y.Etale => R ∈ J W) heq)).trans hiff
    let T_Y : Y.Etale := MorphismProperty.Over.mk ⊤ (𝟙 Y) inferInstance
    have hT_Y : Limits.IsTerminal T_Y :=
      Limits.IsTerminal.ofUniqueHom
        (fun E => MorphismProperty.Over.homMk E.hom (Category.comp_id E.hom))
        (fun E m => (Scheme.Etale.forget Y).map_injective
          (Over.OverMorphism.ext ((Category.comp_id m.left).symm.trans m.w)))
    have hSub_TY : Subsingleton ↥(S.obj.obj (Opposite.op T_Y)) :=
      (Sheaf.H.equiv₀ S hT_Y).symm.toEquiv.subsingleton
    have hAllSub : ∀ W : Y.Etale, Subsingleton ↥(S.obj.obj (Opposite.op W)) := by
      intro W; refine ⟨fun s₁ s₂ => ?_⟩
      rw [← sub_eq_zero]; set s := s₁ - s₂
      let R_zero : Sieve W :=
        { arrows := fun {W'} f => (S.obj.map f.op) s = 0
          downward_closed := fun {W' W''} f hf g => by
            change (S.obj.map (g ≫ f).op) s = 0
            rw [op_comp, S.obj.map_comp]
            change (S.obj.map g.op) ((S.obj.map f.op) s) = 0
            rw [hf, map_zero] }
      have hR_mem : R_zero ∈ Y.smallEtaleTopology W := by
        rw [hMemEtale]; intro w₀
        obtain ⟨W', f, hf_et, ⟨w'₀, hw'₀⟩, hCases⟩ := hShrink W w₀
        refine ⟨W', f, w'₀, ?_, hf_et, hw'₀⟩
        change (S.obj.map f.op) s = 0
        rcases hCases with hEmpty | hNonempty
        · have hDisj : Disjoint (Set.range W'.hom.base) (Set.range i₀.base) := by
            rw [Set.disjoint_left]
            rintro _ ⟨x', rfl⟩ ⟨pt_k, hpt⟩
            obtain ⟨p₀, -, -⟩ :=
              Scheme.Pullback.exists_preimage_pullback (f := W'.hom) (g := i₀) x' pt_k hpt.symm
            exact hEmpty.false p₀
          exact (hVanishOut W' hDisj).elim _ 0
        · let iso_W' : B_i₀.obj W' ≅ T_k₁ := Classical.choice hNonempty
          let s' := (S.obj.map f.op) s
          have _ : Etale W'.hom := W'.prop
          have hClosed_i₀ : IsClosed (Set.range i₀.base) := i₀.isClosedEmbedding.isClosed_range
          have hAgreeW' : ∀ {Z : Y.Etale} (g₁ g₂ : Z ⟶ W'),
              (S.obj.map g₁.op) s' = (S.obj.map g₂.op) s' := by
            intro Z g₁ g₂
            have _ : Etale Z.hom := Z.prop
            let d_Z : Z.left ⟶ Limits.pullback W'.hom W'.hom :=
              Limits.pullback.lift g₁.left g₂.left
                ((MorphismProperty.Over.w g₁).trans (MorphismProperty.Over.w g₂).symm)
            let Δ_W' : W'.left ⟶ Limits.pullback W'.hom W'.hom := Limits.pullback.diagonal W'.hom
            have _ : IsOpenImmersion Δ_W' := inferInstance
            let U_diag : Z.left.Opens := (TopologicalSpace.Opens.map d_Z.base).obj Δ_W'.opensRange
            let U_Z_out : Z.left.Opens :=
              ⟨Z.hom.base ⁻¹' (Set.range i₀.base)ᶜ, hClosed_i₀.isOpen_compl.preimage Z.hom.continuous⟩
            let R_Z : Sieve Z :=
              { arrows := fun {Z'} k => (S.obj.map k.op) ((S.obj.map g₁.op) s') =
                  (S.obj.map k.op) ((S.obj.map g₂.op) s')
                downward_closed := fun {Z₁ Z₂} k hk l => by
                  change (S.obj.map (l ≫ k).op) _ = (S.obj.map (l ≫ k).op) _
                  rw [op_comp, S.obj.map_comp]
                  exact congrArg (S.obj.map l.op) hk }
            have hRZ_mem : R_Z ∈ Y.smallEtaleTopology Z := by
              rw [hMemEtale]; intro z
              by_cases hz_mem : Z.hom.base z ∈ Set.range i₀.base
              · obtain ⟨pt_k, hpt_k⟩ := hz_mem
                let e_z := Z.left.fromSpecResidueField z
                have he_z_pt : e_z.base (⊥ : PrimeSpectrum ↥(Z.left.residueField z)) = z := by
                  simpa using Z.left.fromSpecResidueField_apply z
                    (⊥ : PrimeSpectrum ↥(Z.left.residueField z))
                have hRange_i₀ : Set.range (e_z ≫ Z.hom).base ⊆ Set.range i₀.base := by
                  rintro _ ⟨pt, rfl⟩
                  rw [Subsingleton.elim pt (⊥ : PrimeSpectrum ↥(Z.left.residueField z))]
                  exact ⟨pt_k, hpt_k.symm ▸ congrArg Z.hom.base he_z_pt.symm⟩
                obtain ⟨β_z, hβ_z⟩ := hLiftFieldClosed
                  (fun x hx => isUnit_iff_ne_zero.mpr hx) i₀ (e_z ≫ Z.hom) hRange_i₀
                let l₁ : Spec (Z.left.residueField z) ⟶ Limits.pullback W'.hom i₀ :=
                  Limits.pullback.lift (e_z ≫ g₁.left) β_z
                    (by rw [Category.assoc, MorphismProperty.Over.w g₁, hβ_z])
                let l₂ : Spec (Z.left.residueField z) ⟶ Limits.pullback W'.hom i₀ :=
                  Limits.pullback.lift (e_z ≫ g₂.left) β_z
                    (by rw [Category.assoc, MorphismProperty.Over.w g₂, hβ_z])
                let iso_W'_left := ((Scheme.Etale.forget S_k₁).comp (Over.forget _)).mapIso iso_W'
                have hhom_snd : iso_W'_left.hom = Limits.pullback.snd W'.hom i₀ := by
                  have hw := MorphismProperty.Over.w iso_W'.hom
                  change iso_W'_left.hom ≫ 𝟙 _ = Limits.pullback.snd W'.hom i₀ at hw
                  rwa [Category.comp_id] at hw
                have _ : IsIso (Limits.pullback.snd W'.hom i₀) :=
                  ⟨⟨iso_W'_left.inv,
                    hhom_snd ▸ iso_W'_left.hom_inv_id,
                    hhom_snd ▸ iso_W'_left.inv_hom_id⟩⟩
                have hl_eq : l₁ = l₂ := by
                  rw [← cancel_mono (Limits.pullback.snd W'.hom i₀)]
                  exact (Limits.pullback.lift_snd _ _ _).trans (Limits.pullback.lift_snd _ _ _).symm
                have heg_eq : e_z ≫ g₁.left = e_z ≫ g₂.left := by
                  have h := congrArg (· ≫ Limits.pullback.fst W'.hom i₀) hl_eq
                  exact (Limits.pullback.lift_fst _ _ _).symm.trans
                    (h.trans (Limits.pullback.lift_fst _ _ _))
                have hz_diag : z ∈ U_diag := by
                  change d_Z.base z ∈ Set.range Δ_W'.base
                  refine ⟨g₁.left.base z, ?_⟩
                  have hd_eq : e_z ≫ d_Z = (e_z ≫ g₁.left) ≫ Δ_W' := by
                    apply Limits.pullback.hom_ext
                    · rw [Category.assoc, Limits.pullback.lift_fst, Category.assoc,
                        Limits.pullback.diagonal_fst, Category.comp_id]
                    · rw [Category.assoc, Limits.pullback.lift_snd, Category.assoc,
                        Limits.pullback.diagonal_snd, Category.comp_id, heg_eq]
                  have hpt := congrArg
                    (fun m => m.base (⊥ : PrimeSpectrum ↥(Z.left.residueField z))) hd_eq
                  change d_Z.base (e_z.base _) = Δ_W'.base (g₁.left.base (e_z.base _)) at hpt
                  rw [he_z_pt] at hpt; exact hpt.symm
                let Z_d : Y.Etale := MorphismProperty.Over.mk ⊤ (U_diag.ι ≫ Z.hom) inferInstance
                let k_d : Z_d ⟶ Z := MorphismProperty.Over.homMk U_diag.ι rfl
                refine ⟨Z_d, k_d, ⟨z, hz_diag⟩, ?_, inferInstance, rfl⟩
                have hRange_diag : Set.range (U_diag.ι ≫ d_Z).base ⊆ Set.range Δ_W'.base := by
                  rintro _ ⟨⟨y, hy⟩, rfl⟩; exact hy
                let lift_Δ := IsOpenImmersion.lift Δ_W' (U_diag.ι ≫ d_Z) hRange_diag
                have hlift_Δ : lift_Δ ≫ Δ_W' = U_diag.ι ≫ d_Z :=
                  IsOpenImmersion.lift_fac Δ_W' _ hRange_diag
                have hkd_eq : k_d ≫ g₁ = k_d ≫ g₂ := by
                  apply (Scheme.Etale.forget Y).map_injective; apply Over.OverMorphism.ext
                  change U_diag.ι ≫ g₁.left = U_diag.ι ≫ g₂.left
                  have h₁ := congrArg (· ≫ Limits.pullback.fst W'.hom W'.hom) hlift_Δ
                  have h₂ := congrArg (· ≫ Limits.pullback.snd W'.hom W'.hom) hlift_Δ
                  rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id,
                    Category.assoc, Limits.pullback.lift_fst] at h₁
                  rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
                    Category.assoc, Limits.pullback.lift_snd] at h₂
                  exact h₁.symm.trans h₂
                change (S.obj.map k_d.op) ((S.obj.map g₁.op) s') =
                  (S.obj.map k_d.op) ((S.obj.map g₂.op) s')
                have hc1 : (S.obj.map k_d.op) ((S.obj.map g₁.op) s') =
                    (S.obj.map (k_d ≫ g₁).op) s' := by rw [op_comp, S.obj.map_comp]; rfl
                have hc2 : (S.obj.map k_d.op) ((S.obj.map g₂.op) s') =
                    (S.obj.map (k_d ≫ g₂).op) s' := by rw [op_comp, S.obj.map_comp]; rfl
                rw [hc1, hc2, hkd_eq]
              · let Z_o : Y.Etale := MorphismProperty.Over.mk ⊤ (U_Z_out.ι ≫ Z.hom) inferInstance
                let k_o : Z_o ⟶ Z := MorphismProperty.Over.homMk U_Z_out.ι rfl
                refine ⟨Z_o, k_o, ⟨z, hz_mem⟩, ?_, inferInstance, rfl⟩
                have hDisj_Zo : Disjoint (Set.range Z_o.hom.base) (Set.range i₀.base) := by
