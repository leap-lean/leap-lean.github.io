  let P := Polynomial k
  let R_cat := CommRingCat.of P
  let N := 2 * m + 2
  let U_line := AlgebraicGeometry.Spec R_cat
  let p_A1 : U_line ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
