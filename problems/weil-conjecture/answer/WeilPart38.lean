            have hkz := congrArg (fun φ => (φ.hom m : LocallyConstant _ ↥A) y_z)
              (hk (Opposite.op w_z))
            change gm (u_z.left.base y_z) = eval_c c w_z m y_z at hkz
            rwa [hy_z] at hkz }⟩
      have hLocInj : Presheaf.IsLocallyInjective V.smallEtaleTopology θ_A := by
        refine Presheaf.IsLocallyInjective.mk ?_
        intro E a₁ a₂ ha
        by_cases hEmp : IsEmpty ↥E.unop.left
