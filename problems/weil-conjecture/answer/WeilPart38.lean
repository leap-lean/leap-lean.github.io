        exact ⟨AddEquiv.toAddCommGrpIso (LinearEquiv.ofFinrankEq ↥M₀ ↥A₀ hrk).toAddEquiv⟩

      let C_W₀ := CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}
      let iso_GW_CA : G_W ≅ C_W₀.obj A₀ := (CategoryTheory.asIso Φ).symm ≪≫ C_W₀.mapIso e_MA
      have hPb_final : WeilIsEtaleSheafPullback (w₀ ≫ ι'_a) G (C_W₀.obj A₀) :=
        hPbIso (w₀ ≫ ι'_a) G G G_W (C_W₀.obj A₀) hPb_GW_G ⟨CategoryTheory.Iso.refl G⟩ ⟨iso_GW_CA⟩
      have hx_range : x ∈ Set.range (w₀ ≫ ι'_a).base := by
        refine ⟨s_W.base (⊥ : PrimeSpectrum k), ?_⟩
        calc (w₀ ≫ ι'_a).base (s_W.base (⊥ : PrimeSpectrum k))
            = (s_W ≫ w₀ ≫ ι'_a).base (⊥ : PrimeSpectrum k) := rfl
          _ = ((s_W ≫ w₀) ≫ τ_a ≫ ι_chart).base (⊥ : PrimeSpectrum k) := rfl
          _ = ((s_pt 0 ≫ τ_a) ≫ ι_chart).base (⊥ : PrimeSpectrum k) := by
              rw [hs_W, CategoryTheory.Category.assoc]
          _ = ι_chart.base ((s_pt a).base (⊥ : PrimeSpectrum k)) := by rw [hs0_τ]; rfl
          _ = x := hpt_x
      exact ⟨W₀, w₀ ≫ ι'_a, inferInstance, hx_range, hPb_final⟩

  · 
    
    
    intro G' hInj_cosp B _ φ
    let C_D := CategoryTheory.constantSheaf D_bar.left.smallEtaleTopology AddCommGrpCat.{u}
    let T_D := termObj D_bar.left
    let hT_D := isTermObj D_bar.left
    let adj_D := CategoryTheory.constantSheafAdj D_bar.left.smallEtaleTopology AddCommGrpCat.{u} hT_D

    
    obtain ⟨x_init⟩ := (inferInstance : Nonempty ↥D_bar.left)
    obtain ⟨ι₀, hOpen_ι₀, _, _⟩ := hCharts x_init
    let _ : AlgebraicGeometry.IsOpenImmersion ι₀ := hOpen_ι₀
    let η₀ : S_Ω ⟶ D_bar.left := η ≫ ι₀
    have hη₀_gen : η₀.base (⊥ : PrimeSpectrum Ω) = genericPoint ↥D_bar.left := by
      change ι₀.base (η.base (⊥ : PrimeSpectrum Ω)) = genericPoint ↥D_bar.left
