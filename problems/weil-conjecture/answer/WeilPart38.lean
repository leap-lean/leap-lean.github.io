  have hFlat_aff : AlgebraicGeometry.Flat π_aff_P := by
    let A_cat := CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) R_cat ⧸ I_cone0)
    let B_cat := CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) k)
    have hIso_Bk : ∃ (ρ : P →+* MvPolynomial (Fin (m + 1) × Fin 2) k)
        (ψ_cat : B_cat ⟶ A_cat),
        Function.Injective ρ ∧
        CategoryTheory.IsIso ψ_cat ∧
        CommRingCat.ofHom ((Ideal.Quotient.mk I_cone0).comp MvPolynomial.C) =
          CommRingCat.ofHom ρ ≫ ψ_cat := by
      let Q_hom : MvPolynomial (Fin (m + 1) × Fin 2) k :=
        ∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)
      let ρ : P →+* MvPolynomial (Fin (m + 1) × Fin 2) k :=
        (Polynomial.aeval Q_hom).toRingHom
      have hρ_C : ∀ c : k, ρ (Polynomial.C c) = MvPolynomial.C c :=
        fun c => Polynomial.aeval_C Q_hom c
      have hρ_X : ρ Polynomial.X = Q_hom := Polynomial.aeval_X Q_hom
      let Ξ_tilde : MvPolynomial (Fin (m + 1) × Fin 2) R_cat →+*
          MvPolynomial (Fin (m + 1) × Fin 2) k :=
        MvPolynomial.eval₂Hom ρ MvPolynomial.X
      have hΞ_ker : ∀ p ∈ I_cone0, Ξ_tilde p = 0 := by
        intro p hp
        have hle : I_cone0 ≤ RingHom.ker Ξ_tilde := by
          rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
          change Ξ_tilde ((∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
            MvPolynomial.C (Polynomial.X : R_cat)) = 0
          rw [map_sub, map_sum, MvPolynomial.eval₂Hom_C, hρ_X]
          have hsum : (∑ x : Fin (m + 1), Ξ_tilde (MvPolynomial.X (x, 0) * MvPolynomial.X (x, 1))) = Q_hom := by
            dsimp only [Ξ_tilde, Q_hom]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
          rw [hsum, sub_self]
        exact hle hp
      let Ξ_hom : ↑A_cat →+* MvPolynomial (Fin (m + 1) × Fin 2) k :=
        Ideal.Quotient.lift I_cone0 Ξ_tilde hΞ_ker
      let φ_aff : P →+* ↑A_cat :=
        (CommRingCat.ofHom ((Ideal.Quotient.mk I_cone0).comp MvPolynomial.C)).hom
      let Ψ_hom : MvPolynomial (Fin (m + 1) × Fin 2) k →+* ↑A_cat :=
        MvPolynomial.eval₂Hom (φ_aff.comp Polynomial.C)
          (fun idx => Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx))
      have hΞΨ : Ξ_hom.comp Ψ_hom = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext
        · intro c
          change Ξ_hom (Ψ_hom (MvPolynomial.C c)) = MvPolynomial.C c
          dsimp only [Ψ_hom, Ξ_hom]
          rw [MvPolynomial.eval₂Hom_C]
          change Ξ_tilde (MvPolynomial.C (Polynomial.C c)) = MvPolynomial.C c
          rw [MvPolynomial.eval₂Hom_C, hρ_C]
        · intro idx
          change Ξ_hom (Ψ_hom (MvPolynomial.X idx)) = MvPolynomial.X idx
          dsimp only [Ψ_hom, Ξ_hom]
          rw [MvPolynomial.eval₂Hom_X']
          exact MvPolynomial.eval₂Hom_X' ρ MvPolynomial.X idx
      have hfac : φ_aff = Ψ_hom.comp ρ := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          change φ_aff (Polynomial.C c) = Ψ_hom (ρ (Polynomial.C c))
          rw [hρ_C]
          dsimp only [Ψ_hom]
          rw [MvPolynomial.eval₂Hom_C]
          rfl
        · change Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.X : R_cat)) = Ψ_hom (ρ Polynomial.X)
          rw [hρ_X]
          dsimp only [Q_hom]
          rw [map_sum]
          have hsum : (∑ x : Fin (m + 1), Ψ_hom (MvPolynomial.X (x, 0) * MvPolynomial.X (x, 1))) =
              ∑ x : Fin (m + 1), (Ideal.Quotient.mk I_cone0 (MvPolynomial.X (x, 0) * MvPolynomial.X (x, 1)) : ↑A_cat) := by
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [map_mul, map_mul]
            dsimp only [Ψ_hom]
            rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
          rw [hsum, ← map_sum]
          have hrel : (Ideal.Quotient.mk I_cone0
              ((∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
                MvPolynomial.C (Polynomial.X : R_cat)) : ↑A_cat) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          rw [map_sub, sub_eq_zero] at hrel
          exact hrel.symm
      have hΨΞ : Ψ_hom.comp Ξ_hom = RingHom.id _ := by
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro f
          change Ψ_hom (Ξ_tilde (MvPolynomial.C f)) = φ_aff f
          rw [MvPolynomial.eval₂Hom_C, hfac]
          rfl
        · intro idx
          change Ψ_hom (Ξ_tilde (MvPolynomial.X idx)) = Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx)
          rw [MvPolynomial.eval₂Hom_X']
          dsimp only [Ψ_hom]
          rw [MvPolynomial.eval₂Hom_X']
      have hIso_ψ : CategoryTheory.IsIso (CommRingCat.ofHom Ψ_hom : B_cat ⟶ A_cat) :=
        ⟨⟨CommRingCat.ofHom Ξ_hom, CommRingCat.hom_ext hΞΨ, CommRingCat.hom_ext hΨΞ⟩⟩
      let idx00 : Fin (m + 1) × Fin 2 := (⟨0, Nat.succ_pos m⟩, 0)
      let idx01 : Fin (m + 1) × Fin 2 := (⟨0, Nat.succ_pos m⟩, 1)
      let ev0 : MvPolynomial (Fin (m + 1) × Fin 2) k →+* P :=
        MvPolynomial.eval₂Hom Polynomial.C (fun idx =>
          if idx = idx00 then Polynomial.X else if idx = idx01 then 1 else 0)
      have hev0_ρ : ev0.comp ρ = RingHom.id P := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          change ev0 (ρ (Polynomial.C c)) = Polynomial.C c
          rw [hρ_C]
          dsimp only [ev0]
          rw [MvPolynomial.eval₂Hom_C]
        · change ev0 (ρ Polynomial.X) = Polynomial.X
          rw [hρ_X]
          dsimp only [Q_hom]
          rw [map_sum]
          let j0 : Fin (m + 1) := ⟨0, Nat.succ_pos m⟩
          rw [Finset.sum_eq_single j0]
          · rw [map_mul]
            dsimp only [ev0]
            rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
            have h1 : (j0, (0 : Fin 2)) = idx00 := rfl
            have h2 : idx01 ≠ idx00 := fun h =>
              Fin.zero_ne_one (congrArg Prod.snd h).symm
            have h3 : (j0, (1 : Fin 2)) = idx01 := rfl
            simp only [h1, h3, h2, ↓reduceIte, mul_one]
          · intro j _ hj_ne
            rw [map_mul]
            dsimp only [ev0]
            rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
            have hne0 : (j, (0 : Fin 2)) ≠ idx00 := fun h => hj_ne (congrArg Prod.fst h)
            have hne1 : (j, (0 : Fin 2)) ≠ idx01 := fun h => Fin.zero_ne_one (congrArg Prod.snd h)
            simp only [hne0, hne1, ↓reduceIte, zero_mul]
          · intro hj0
            exact False.elim (hj0 (Finset.mem_univ j0))
      have hρ_inj : Function.Injective ρ := by
        intro f g hfg
        have h1 := congrArg ev0 hfg
        have hf : ev0 (ρ f) = f := RingHom.congr_fun hev0_ρ f
        have hg : ev0 (ρ g) = g := RingHom.congr_fun hev0_ρ g
        exact hf.symm.trans (h1.trans hg)
      exact ⟨ρ, CommRingCat.ofHom Ψ_hom, hρ_inj, hIso_ψ, CommRingCat.hom_ext hfac⟩
    obtain ⟨ρ, ψ_cat, hρ_inj, hIso_ψ, hfac⟩ := hIso_Bk
    have : CategoryTheory.IsIso ψ_cat := hIso_ψ
    have hρ_flat : ρ.Flat := by
      let _ : Algebra P (MvPolynomial (Fin (m + 1) × Fin 2) k) := ρ.toAlgebra
      have hTF : Module.IsTorsionFree P (MvPolynomial (Fin (m + 1) × Fin 2) k) :=
        Module.isTorsionFree_iff_algebraMap_injective.mpr hρ_inj
      have hModFlat : Module.Flat P (MvPolynomial (Fin (m + 1) × Fin 2) k) :=
        @Module.Flat.instOfIsDedekindDomainOfIsTorsionFree
          P (MvPolynomial (Fin (m + 1) × Fin 2) k) _ _ _ inferInstance hTF
      exact RingHom.flat_algebraMap_iff.mpr hModFlat
    have hFlat_ρ : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mpr hρ_flat
    have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map ψ_cat) := inferInstance
    dsimp only [π_aff_P]
    rw [hfac, AlgebraicGeometry.Spec.map_comp]
    exact @AlgebraicGeometry.Flat.comp _ _ _
      (AlgebraicGeometry.Spec.map ψ_cat) (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ))
      inferInstance hFlat_ρ

  have hFlat_aff_pb : AlgebraicGeometry.Flat
      (CategoryTheory.Limits.pullback.snd (weilAffineSpaceOver k (2 * m + 1)).hom p_A1) := by
    have hFlat_k : AlgebraicGeometry.Flat (weilAffineSpaceOver k (2 * m + 1)).hom := by
      change AlgebraicGeometry.Flat
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin (2 * m + 1)) k)))
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mpr
      change (algebraMap k (MvPolynomial (Fin (2 * m + 1)) k)).Flat
      exact RingHom.flat_algebraMap_iff.mpr inferInstance
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback
        (weilAffineSpaceOver k (2 * m + 1)).hom p_A1) hFlat_k

  have hAffPullback :
      ∃ e_aff : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (2 * m + 1)) P)) ≅
          CategoryTheory.Limits.pullback (weilAffineSpaceOver k (2 * m + 1)).hom p_A1,
        e_aff.hom ≫ CategoryTheory.Limits.pullback.snd
          (weilAffineSpaceOver k (2 * m + 1)).hom p_A1 =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.C : P →+* MvPolynomial (Fin (2 * m + 1)) P)) := by
    let d_rel := 2 * m + 1
    let f_mv : CommRingCat.of k ⟶ CommRingCat.of (MvPolynomial (Fin d_rel) k) :=
      CommRingCat.ofHom MvPolynomial.C
    let f_P : CommRingCat.of k ⟶ CommRingCat.of P :=
      CommRingCat.ofHom Polynomial.C
    let inl_mv : CommRingCat.of (MvPolynomial (Fin d_rel) k) ⟶
        CommRingCat.of (MvPolynomial (Fin d_rel) P) :=
      CommRingCat.ofHom (MvPolynomial.map Polynomial.C)
    let inr_mv : CommRingCat.of P ⟶ CommRingCat.of (MvPolynomial (Fin d_rel) P) :=
      CommRingCat.ofHom MvPolynomial.C
    have hcomm_mv : f_mv ≫ inl_mv = f_P ≫ inr_mv := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      exact MvPolynomial.map_C Polynomial.C a
    have hColim_mv : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk inl_mv inr_mv hcomm_mv) := by
      refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_mv
        (fun s => CommRingCat.ofHom
          (MvPolynomial.eval₂Hom s.inr.hom (fun i => s.inl.hom (MvPolynomial.X i))))
        ?_ ?_ ?_
      · intro s
        apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext
        · intro a
          change MvPolynomial.eval₂Hom s.inr.hom _
              (MvPolynomial.map Polynomial.C (MvPolynomial.C a)) =
            s.inl.hom (MvPolynomial.C a)
          rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
          exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom s.condition) a).symm
        · intro i
          change MvPolynomial.eval₂Hom s.inr.hom _
              (MvPolynomial.map Polynomial.C (MvPolynomial.X i)) =
            s.inl.hom (MvPolynomial.X i)
          rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
      · intro s
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro b
        exact MvPolynomial.eval₂Hom_C s.inr.hom (fun i => s.inl.hom (MvPolynomial.X i)) b
      · intro s m_hom hm_l hm_r
        apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext
        · intro b
          change m_hom.hom (MvPolynomial.C b) =
            MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.C b)
          rw [MvPolynomial.eval₂Hom_C]
          exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_r) b
        · intro i
          change m_hom.hom (MvPolynomial.X i) =
            MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.X i)
          rw [MvPolynomial.eval₂Hom_X']
          have hXi := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_l) (MvPolynomial.X i)
          change m_hom.hom (MvPolynomial.map Polynomial.C (MvPolynomial.X i)) =
            s.inl.hom (MvPolynomial.X i) at hXi
          rwa [MvPolynomial.map_X] at hXi
    have hPush_mv : CategoryTheory.IsPushout f_mv f_P inl_mv inr_mv :=
      CategoryTheory.IsPushout.of_isColimit hColim_mv
    have hpb_mv : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map inl_mv) (AlgebraicGeometry.Spec.map inr_mv)
        (weilAffineSpaceOver k d_rel).hom p_A1 :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout f_mv f_P inl_mv inr_mv hPush_mv
    exact ⟨hpb_mv.isoPullback, hpb_mv.isoPullback_hom_snd⟩
  obtain ⟨e_aff_P, he_aff_P_snd⟩ := hAffPullback

  
  
  
  have hval_succAbove : ∀ {n : ℕ} (p : Fin (n + 1)) (x : Fin n),
      (p.succAbove x).1 = if x.1 < p.1 then x.1 else x.1 + 1 := by
    intro n p x
    by_cases hlt : x.1 < p.1
    · have hlt' : x.castSucc < p := hlt
      rw [Fin.succAbove_of_castSucc_lt p x hlt', if_pos hlt]
      rfl
    · have hle' : p ≤ x.castSucc := Nat.le_of_not_lt hlt
      rw [Fin.succAbove_of_le_castSucc p x hle', if_neg hlt]
      rfl
  have hrange_fin1 : ∀ {α : Type u} (x : α), Set.range (fun _ : Fin 1 => x) = {x} := by
    intro α x
    ext y
    simp

  have hS2_vertex :
      let A_w := ↑((weilProjectiveSpaceOver P N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen P N w_idx)))
      let I_w : Ideal A_w := Ideal.span (Set.range (g_Q0 w_idx))
      ∃ Θ_w : ↑(CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) R_cat ⧸ I_cone0)) ≃+* (A_w ⧸ I_w),
        Θ_w.toRingHom.comp ((Ideal.Quotient.mk I_cone0).comp MvPolynomial.C) =
          (Ideal.Quotient.mk I_w).comp (c_R0 w_idx) ∧
        (∀ j : Fin (m + 1),
          Θ_w (Ideal.Quotient.mk I_cone0 (MvPolynomial.X (j, 0))) =
            Ideal.Quotient.mk I_w (t_R0 w_idx (u_idx j))) ∧
        (∀ j : Fin (m + 1),
          Θ_w (Ideal.Quotient.mk I_cone0 (MvPolynomial.X (j, 1))) =
            Ideal.Quotient.mk I_w (t_R0 w_idx (v_idx j))) := by
    intro A_w I_w
    have hτw : t_R0 w_idx w_idx = 1 := hCoord_R0.2.2.2.2.1 w_idx
    obtain ⟨hθC, hθX⟩ := hθ_R0 w_idx
    let e_idx : Fin (m + 1) × Fin 2 ≃ Fin N :=
      { toFun := fun jb => ⟨2 * jb.1.1 + jb.2.1, by have := jb.1.2; have := jb.2.2; omega⟩
        invFun := fun i => (⟨i.1 / 2, by have := i.2; omega⟩, ⟨i.1 % 2, by omega⟩)
        left_inv := fun ⟨j, b⟩ => by
          ext <;> dsimp <;> have := j.2 <;> have := b.2 <;> omega
        right_inv := fun i => by
          ext; dsimp; have := i.2; omega }
    let Θ_tilde : MvPolynomial (Fin (m + 1) × Fin 2) R_cat ≃+* A_w :=
      (MvPolynomial.renameEquiv R_cat e_idx).toRingEquiv.trans (θ_R0 w_idx)
    have hΘ_C : ∀ r : R_cat, Θ_tilde (MvPolynomial.C r) = c_R0 w_idx r := by
      intro r
      change θ_R0 w_idx ((MvPolynomial.rename e_idx) (MvPolynomial.C r)) = c_R0 w_idx r
      rw [MvPolynomial.rename_C]
      exact RingHom.congr_fun hθC r
    have hΘ_X0 : ∀ j : Fin (m + 1), Θ_tilde (MvPolynomial.X (j, 0)) = t_R0 w_idx (u_idx j) := by
      intro j
      change θ_R0 w_idx ((MvPolynomial.rename e_idx) (MvPolynomial.X (j, 0))) =
        t_R0 w_idx (u_idx j)
      rw [MvPolynomial.rename_X, hθX]
      congr 1; ext; rw [hval_succAbove]
      have : (e_idx (j, 0)).1 < w_idx.1 := by change 2 * j.1 + 0 < 2 * m + 2; omega
      rw [if_pos this]; change 2 * j.1 + 0 = 2 * j.1; omega
    have hΘ_X1 : ∀ j : Fin (m + 1), Θ_tilde (MvPolynomial.X (j, 1)) = t_R0 w_idx (v_idx j) := by
      intro j
      change θ_R0 w_idx ((MvPolynomial.rename e_idx) (MvPolynomial.X (j, 1))) =
        t_R0 w_idx (v_idx j)
      rw [MvPolynomial.rename_X, hθX]
      congr 1; ext; rw [hval_succAbove]
      have : (e_idx (j, 1)).1 < w_idx.1 := by change 2 * j.1 + 1 < 2 * m + 2; omega
      rw [if_pos this]; rfl
    have hMap : Ideal.map Θ_tilde.toRingHom I_cone0 = I_w := by
      dsimp only [I_cone0, I_w, g_Q0]
      rw [hrange_fin1, Ideal.map_span, Set.image_singleton]
      congr 2
      change Θ_tilde ((∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
        MvPolynomial.C (Polynomial.X : R_cat)) = _
      rw [map_sub, map_sum, hΘ_C, hτw, one_pow, mul_one]
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, hΘ_X0, hΘ_X1]
    let Θ_w : ↑(CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) R_cat ⧸ I_cone0)) ≃+* (A_w ⧸ I_w) :=
      Ideal.quotientEquiv I_cone0 I_w Θ_tilde (by ext x; simp [← hMap])
    refine ⟨Θ_w, ?_, ?_, ?_⟩
    · apply RingHom.ext; intro r; simp [Θ_w, hΘ_C]
    · intro j; simp [Θ_w, hΘ_X0]
    · intro j; simp [Θ_w, hΘ_X1]

  have hS2_smooth : ∀ (a₀ : Fin (N + 1)), a₀ ≠ w_idx →
      let A_a₀ := ↑((weilProjectiveSpaceOver P N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen P N a₀)))
      let I_a₀ : Ideal A_a₀ := Ideal.span (Set.range (g_Q0 a₀))
      ∃ Φ_a₀ : MvPolynomial (Fin (2 * m + 1)) P ≃+* (A_a₀ ⧸ I_a₀),
        Φ_a₀.toRingHom.comp MvPolynomial.C = (Ideal.Quotient.mk I_a₀).comp (c_R0 a₀) := by
    intro a₀ ha₀ A_a₀ I_a₀
    have hτa₀ : t_R0 a₀ a₀ = 1 := hCoord_R0.2.2.2.2.1 a₀
    obtain ⟨hθC, hθX⟩ := hθ_R0 a₀
    have ha₀_lt : a₀.1 < 2 * m + 2 := by
      have hlt : a₀.1 < 2 * m + 2 + 1 := a₀.2
      have hne : a₀.1 ≠ 2 * m + 2 := fun h => ha₀ (Fin.ext h)
      omega
    let r : Fin (m + 1) := ⟨a₀.1 / 2, by omega⟩
    have hr_val : r.1 = a₀.1 / 2 := rfl
    let i_star : Fin N := ⟨2 * r.1, by change 2 * r.1 < 2 * m + 2; omega⟩
    let emb : MvPolynomial (Fin (2 * m + 1)) P →ₐ[P] MvPolynomial (Fin N) P :=
      MvPolynomial.rename i_star.succAbove
    let term_r : Fin (m + 1) → MvPolynomial (Fin (2 * m + 1)) P := fun j =>
      if hj_lt : j.1 < r.1 then
        MvPolynomial.X ⟨2 * j.1, by omega⟩ * MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩
      else if hj_gt : r.1 < j.1 then
        MvPolynomial.X ⟨2 * j.1 - 2, by omega⟩ * MvPolynomial.X ⟨2 * j.1 - 1, by omega⟩
      else 0
    let μ_w : Fin (2 * m + 1) := ⟨2 * m, by omega⟩
    let P_r : MvPolynomial (Fin (2 * m + 1)) P :=
      MvPolynomial.C (Polynomial.X : P) * (MvPolynomial.X μ_w) ^ 2 -
        ∑ j : Fin (m + 1), term_r j
    have h_θC : ∀ x : P, θ_R0 a₀ (MvPolynomial.C x) = c_R0 a₀ x := RingHom.congr_fun hθC
    have h_partner : t_R0 a₀ (u_idx r) * t_R0 a₀ (v_idx r) = θ_R0 a₀ (MvPolynomial.X i_star) := by
      rcases (by omega : a₀.1 = 2 * r.1 ∨ a₀.1 = 2 * r.1 + 1) with heven | hodd
      · have ha₀_eq : a₀ = u_idx r := Fin.ext heven
        have hsucc : a₀.succAbove i_star = v_idx r := by
          ext; rw [hval_succAbove]; dsimp [i_star, v_idx]; split_ifs <;> omega
        rw [← ha₀_eq, hτa₀, one_mul, ← hsucc, hθX]
      · have ha₀_eq : a₀ = v_idx r := Fin.ext hodd
        have hsucc : a₀.succAbove i_star = u_idx r := by
          ext; rw [hval_succAbove]; dsimp [i_star, u_idx]; split_ifs <;> omega
        rw [← ha₀_eq, hτa₀, mul_one, ← hsucc, hθX]
    have h_term : ∀ j : Fin (m + 1), j ≠ r →
        θ_R0 a₀ (emb (term_r j)) = t_R0 a₀ (u_idx j) * t_R0 a₀ (v_idx j) := by
      intro j hj_ne
      have hj_val_ne : j.1 ≠ r.1 := fun h => hj_ne (Fin.ext h)
      rcases lt_or_gt_of_ne hj_val_ne with hj_lt | hj_gt
      · dsimp only [term_r]
        rw [dif_pos hj_lt, map_mul, map_mul]
        dsimp only [emb]
        rw [MvPolynomial.rename_X, MvPolynomial.rename_X, hθX, hθX]
        congr 1
        · congr 1; ext; rw [hval_succAbove, hval_succAbove]; dsimp [i_star, u_idx]; split_ifs <;> omega
        · congr 1; ext; rw [hval_succAbove, hval_succAbove]; dsimp [i_star, v_idx]; split_ifs <;> omega
      · dsimp only [term_r]
        have hnot_lt : ¬ j.1 < r.1 := by omega
        rw [dif_neg hnot_lt, dif_pos hj_gt, map_mul, map_mul]
        dsimp only [emb]
        rw [MvPolynomial.rename_X, MvPolynomial.rename_X, hθX, hθX]
        congr 1
        · congr 1; ext; rw [hval_succAbove, hval_succAbove]; dsimp [i_star, u_idx]; split_ifs <;> omega
        · congr 1; ext; rw [hval_succAbove, hval_succAbove]; dsimp [i_star, v_idx]; split_ifs <;> omega
    have h_w : θ_R0 a₀ (emb (MvPolynomial.X μ_w)) = t_R0 a₀ w_idx := by
      dsimp only [emb]
      rw [MvPolynomial.rename_X, hθX]
      congr 1; ext; rw [hval_succAbove, hval_succAbove]; dsimp [i_star, μ_w, w_idx, N]
      split_ifs <;> omega
    have h_embC : emb (MvPolynomial.C (Polynomial.X : P)) = MvPolynomial.C Polynomial.X :=
      MvPolynomial.rename_C _ _
    have h_gen : θ_R0 a₀ (MvPolynomial.X i_star - emb P_r) =
        (∑ j : Fin (m + 1), t_R0 a₀ (u_idx j) * t_R0 a₀ (v_idx j)) -
          c_R0 a₀ Polynomial.X * (t_R0 a₀ w_idx) ^ 2 := by
      dsimp only [P_r]
      rw [map_sub, map_sub, map_sub, map_mul, h_embC, map_mul, h_θC,
        map_pow, map_pow, h_w, map_sum, map_sum]
      have hterm_r0 : term_r r = 0 := by dsimp [term_r]; simp
      have hsum1 : (∑ j : Fin (m + 1), t_R0 a₀ (u_idx j) * t_R0 a₀ (v_idx j)) =
          t_R0 a₀ (u_idx r) * t_R0 a₀ (v_idx r) +
            ∑ j ∈ Finset.univ.erase r, t_R0 a₀ (u_idx j) * t_R0 a₀ (v_idx j) :=
        (Finset.add_sum_erase Finset.univ _ (Finset.mem_univ r)).symm
      have hsum2 : (∑ j : Fin (m + 1), θ_R0 a₀ (emb (term_r j))) =
          θ_R0 a₀ (emb (term_r r)) +
            ∑ j ∈ Finset.univ.erase r, θ_R0 a₀ (emb (term_r j)) :=
        (Finset.add_sum_erase Finset.univ _ (Finset.mem_univ r)).symm
      rw [hterm_r0, map_zero, map_zero, zero_add] at hsum2
      have hsum_eq : (∑ j ∈ Finset.univ.erase r, θ_R0 a₀ (emb (term_r j))) =
          ∑ j ∈ Finset.univ.erase r, t_R0 a₀ (u_idx j) * t_R0 a₀ (v_idx j) := by
        refine Finset.sum_congr rfl fun j hj => ?_
        exact h_term j (Finset.ne_of_mem_erase hj)
      rw [hsum1, hsum2, hsum_eq, h_partner]
      ring
    let J_r : Ideal (MvPolynomial (Fin N) P) := Ideal.span {MvPolynomial.X i_star - emb P_r}
    have hMap_J : Ideal.map (θ_R0 a₀).toRingHom J_r = I_a₀ := by
      dsimp only [J_r, I_a₀, g_Q0]
      rw [hrange_fin1, Ideal.map_span, Set.image_singleton]
      congr 2
    let φ_r : MvPolynomial (Fin (2 * m + 1)) P →ₐ[P] (MvPolynomial (Fin N) P ⧸ J_r) :=
      (Ideal.Quotient.mkₐ P J_r).comp emb
    let ψ0_r : MvPolynomial (Fin N) P →ₐ[P] MvPolynomial (Fin (2 * m + 1)) P :=
      MvPolynomial.aeval fun i : Fin N =>
        if h : i = i_star then P_r
        else MvPolynomial.X (Classical.choose (Fin.exists_succAbove_eq h))
    have hψ0_emb : ψ0_r.comp emb = AlgHom.id P (MvPolynomial (Fin (2 * m + 1)) P) := by
      apply MvPolynomial.algHom_ext
      intro μ
      simp only [AlgHom.coe_comp, Function.comp_apply, AlgHom.id_apply, emb,
        MvPolynomial.rename_X, ψ0_r, MvPolynomial.aeval_X]
      have hne : i_star.succAbove μ ≠ i_star := Fin.succAbove_ne i_star μ
      rw [dif_neg hne]
      congr 1
      exact Fin.succAbove_right_injective (Classical.choose_spec (Fin.exists_succAbove_eq hne))
    have hψ0_ker : ∀ p ∈ J_r, ψ0_r p = 0 := by
      intro p hp
      have hle : J_r ≤ RingHom.ker ψ0_r.toRingHom := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        change ψ0_r (MvPolynomial.X i_star - emb P_r) = 0
        rw [map_sub]
        have h1 : ψ0_r (MvPolynomial.X i_star) = P_r := by simp [ψ0_r]
        have h2 : ψ0_r (emb P_r) = P_r := AlgHom.congr_fun hψ0_emb P_r
        rw [h1, h2, sub_self]
      exact hle hp
    let ψ_r : (MvPolynomial (Fin N) P ⧸ J_r) →ₐ[P] MvPolynomial (Fin (2 * m + 1)) P :=
      Ideal.Quotient.liftₐ J_r ψ0_r hψ0_ker
    have hψφ : ψ_r.comp φ_r = AlgHom.id P (MvPolynomial (Fin (2 * m + 1)) P) := by
      apply MvPolynomial.algHom_ext
      intro μ
      change ψ0_r (emb (MvPolynomial.X μ)) = MvPolynomial.X μ
      exact AlgHom.congr_fun hψ0_emb (MvPolynomial.X μ)
    have hφψ : φ_r.comp ψ_r = AlgHom.id P (MvPolynomial (Fin N) P ⧸ J_r) := by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro i
      simp only [AlgHom.coe_comp, Function.comp_apply, Ideal.Quotient.mkₐ_eq_mk, AlgHom.id_apply]
      change φ_r (ψ0_r (MvPolynomial.X i)) = Ideal.Quotient.mk J_r (MvPolynomial.X i)
      dsimp only [ψ0_r]
      rw [MvPolynomial.aeval_X]
      by_cases hi : i = i_star
      · rw [hi, dif_pos rfl]
        change Ideal.Quotient.mk J_r (emb P_r) = Ideal.Quotient.mk J_r (MvPolynomial.X i_star)
        symm
        rw [Ideal.Quotient.eq]
        exact Ideal.subset_span rfl
      · rw [dif_neg hi]
        change Ideal.Quotient.mk J_r (emb (MvPolynomial.X _)) = _
        dsimp only [emb]
        rw [MvPolynomial.rename_X, Classical.choose_spec (Fin.exists_succAbove_eq hi)]
    let E_r : MvPolynomial (Fin (2 * m + 1)) P ≃ₐ[P] (MvPolynomial (Fin N) P ⧸ J_r) :=
      AlgEquiv.ofAlgHom φ_r ψ_r hφψ hψφ
    let Q_r : (MvPolynomial (Fin N) P ⧸ J_r) ≃+* (A_a₀ ⧸ I_a₀) :=
      Ideal.quotientEquiv J_r I_a₀ (θ_R0 a₀) (by ext x; simp [← hMap_J])
    refine ⟨E_r.toRingEquiv.trans Q_r, ?_⟩
    apply RingHom.ext
    intro x
    change Q_r (φ_r (MvPolynomial.C x)) = Ideal.Quotient.mk I_a₀ (c_R0 a₀ x)
    have hφC : φ_r (MvPolynomial.C x) = Ideal.Quotient.mk J_r (MvPolynomial.C x) := by
      dsimp [φ_r, emb]; rw [MvPolynomial.rename_C]
    rw [hφC]
    simp [Q_r, h_θC]

  have hS2_origin :
      ∃ ε₀ : ↑(CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) R_cat ⧸ I_cone0)) →+* k,
        ε₀.comp ((Ideal.Quotient.mk I_cone0).comp MvPolynomial.C) =
          Polynomial.evalRingHom 0 ∧
        (∀ idx : Fin (m + 1) × Fin 2,
          ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx)) = 0) ∧
        ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.X : R_cat))) = 0 ∧
        (∀ q : PrimeSpectrum ↑(CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) R_cat ⧸ I_cone0)),
          (∀ idx : Fin (m + 1) × Fin 2,
            Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx) ∈ q.asIdeal) →
          q.asIdeal = RingHom.ker ε₀) := by
    have heval0_X : (Polynomial.evalRingHom (0 : k)) Polynomial.X = 0 := Polynomial.eval_X
    have heval0_C : ∀ a : k, (Polynomial.evalRingHom (0 : k)) (Polynomial.C a) = a :=
      fun _ => Polynomial.eval_C
    let ε_tilde : MvPolynomial (Fin (m + 1) × Fin 2) R_cat →+* k :=
      MvPolynomial.eval₂Hom (Polynomial.evalRingHom (0 : k)) (fun _ => (0 : k))
    have hε_ker : ∀ p ∈ I_cone0, ε_tilde p = 0 := by
      intro p hp
      have hle : I_cone0 ≤ RingHom.ker ε_tilde := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        change ε_tilde ((∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
          MvPolynomial.C (Polynomial.X : R_cat)) = 0
        simp [ε_tilde, heval0_X]
      exact hle hp
    let ε₀ : ↑(CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) R_cat ⧸ I_cone0)) →+* k :=
      Ideal.Quotient.lift I_cone0 ε_tilde hε_ker
    refine ⟨ε₀, ?_, ?_, ?_, ?_⟩
    · apply RingHom.ext; intro f; simp [ε₀, ε_tilde]
    · intro idx; simp [ε₀, ε_tilde]
    · change ε_tilde (MvPolynomial.C (Polynomial.X : R_cat)) = 0
      simp [ε_tilde, heval0_X]
    · intro q hqX
      let Q_cone0 := ↑(CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) R_cat ⧸ I_cone0))
      let ι_k : k →+* Q_cone0 :=
        ((Ideal.Quotient.mk I_cone0).comp MvPolynomial.C).comp Polynomial.C
      have hε_ι : ∀ a : k, ε₀ (ι_k a) = a := by
        intro a
        change ε_tilde (MvPolynomial.C (Polynomial.C a)) = a
        simp [ε_tilde, heval0_C]
      have hCX_mem : Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.X : R_cat)) ∈ q.asIdeal := by
        have hrel : (Ideal.Quotient.mk I_cone0
            ((∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
              MvPolynomial.C (Polynomial.X : R_cat)) : Q_cone0) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [map_sub, sub_eq_zero] at hrel
        rw [← hrel, map_sum]
        refine Ideal.sum_mem q.asIdeal fun j _ => ?_
        rw [map_mul]
        exact Ideal.mul_mem_right _ q.asIdeal (hqX (j, 0))
      let S : Subring Q_cone0 :=
        { carrier := {u : Q_cone0 | u - ι_k (ε₀ u) ∈ q.asIdeal}
          zero_mem' := by simp
          one_mem' := by simp
          add_mem' := by
            intro u v hu hv
            change (u + v) - ι_k (ε₀ (u + v)) ∈ q.asIdeal
            rw [map_add, map_add]
            have : (u + v) - (ι_k (ε₀ u) + ι_k (ε₀ v)) =
                (u - ι_k (ε₀ u)) + (v - ι_k (ε₀ v)) := by ring
            rw [this]
            exact q.asIdeal.add_mem hu hv
          neg_mem' := by
            intro u hu
            change -u - ι_k (ε₀ (-u)) ∈ q.asIdeal
            rw [map_neg, map_neg]
            have : -u - -ι_k (ε₀ u) = -(u - ι_k (ε₀ u)) := by ring
            rw [this]
            exact q.asIdeal.neg_mem hu
          mul_mem' := by
            intro u v hu hv
            change u * v - ι_k (ε₀ (u * v)) ∈ q.asIdeal
            rw [map_mul, map_mul]
            have : u * v - ι_k (ε₀ u) * ι_k (ε₀ v) =
                (u - ι_k (ε₀ u)) * v + ι_k (ε₀ u) * (v - ι_k (ε₀ v)) := by ring
            rw [this]
            exact q.asIdeal.add_mem (q.asIdeal.mul_mem_right v hu)
              (q.asIdeal.mul_mem_left _ hv) }
      have hC_a_S : ∀ a : k, Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.C a)) ∈ S := by
        intro a
        change Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.C a)) -
          ι_k (ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.C a)))) ∈ q.asIdeal
        have : ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.C a))) = a := hε_ι a
        rw [this]; change ι_k a - ι_k a ∈ q.asIdeal; rw [sub_self]; exact q.asIdeal.zero_mem
      have hX_S : Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.X : R_cat)) ∈ S := by
        change Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.X : R_cat)) -
          ι_k (ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.X : R_cat)))) ∈ q.asIdeal
        have : ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.X : R_cat))) = 0 := by
          change ε_tilde (MvPolynomial.C (Polynomial.X : R_cat)) = 0
          simp [ε_tilde, heval0_X]
        rw [this, map_zero, sub_zero]; exact hCX_mem
      have hPoly_S : ∀ f : P, Ideal.Quotient.mk I_cone0 (MvPolynomial.C (f : R_cat)) ∈ S := by
        intro f
        refine Polynomial.induction_on f (fun a => hC_a_S a) ?_ ?_
        · intro f₁ f₂ hf₁ hf₂; rw [map_add, map_add]; exact S.add_mem hf₁ hf₂
        · intro n a _; rw [map_mul, map_mul, map_pow, map_pow]
          exact S.mul_mem (hC_a_S a) (S.pow_mem hX_S (n + 1))
      have hAll_S : ∀ u : Q_cone0, u - ι_k (ε₀ u) ∈ q.asIdeal := by
        intro u
        refine Quotient.inductionOn' u fun F => ?_
        exact MvPolynomial.induction_on
          (motive := fun P_mv => Ideal.Quotient.mk I_cone0 P_mv ∈ S) F
          (fun f => hPoly_S f)
          (fun f₁ f₂ hf₁ hf₂ => by rw [map_add]; exact S.add_mem hf₁ hf₂)
          (fun f₁ idx hf₁ => by
            rw [map_mul]
            refine S.mul_mem hf₁ ?_
            change Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx) -
              ι_k (ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx))) ∈ q.asIdeal
            have : ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx)) = 0 := by
              simp [ε₀, ε_tilde]
            rw [this, map_zero, sub_zero]; exact hqX idx)
      ext u
      rw [RingHom.mem_ker]
      constructor
      · intro huP
        by_contra hne
        have hdiff := hAll_S u
        have hι_mem : ι_k (ε₀ u) ∈ q.asIdeal := by
          have : ι_k (ε₀ u) = u - (u - ι_k (ε₀ u)) := by ring
          rw [this]; exact q.asIdeal.sub_mem huP hdiff
        have hone_mem : (1 : Q_cone0) ∈ q.asIdeal := by
          have h1 : ι_k ((ε₀ u)⁻¹) * ι_k (ε₀ u) = 1 := by
            rw [← map_mul, inv_mul_cancel₀ hne, map_one]
          rw [← h1]; exact q.asIdeal.mul_mem_left _ hι_mem
        exact q.isPrime.ne_top ((Ideal.eq_top_iff_one q.asIdeal).mpr hone_mem)
      · intro hu0
        have hdiff := hAll_S u
        rwa [hu0, map_zero, sub_zero] at hdiff

  
  have hChartBridge : ∀ {P_NR : AlgebraicGeometry.Scheme.{u}}
      (p_NR : P_NR ⟶ U_line)
      (D_N : Fin (N + 1) → P_NR.Opens)
      (hAff_NR : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D_N a))
      (c_NR : ∀ a : Fin (N + 1), P →+* ↑(P_NR.presheaf.obj (Opposite.op (D_N a))))
      (t_NR : ∀ a : Fin (N + 1), Fin (N + 1) → ↑(P_NR.presheaf.obj (Opposite.op (D_N a))))
      (hSup_NR : (⨆ a : Fin (N + 1), D_N a) = ⊤)
      (hc_hom_NR : ∀ a : Fin (N + 1),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_NR a)) = (hAff_NR a).fromSpec ≫ p_NR)
      (hBasic_NR : ∀ a a' : Fin (N + 1), P_NR.basicOpen (t_NR a a') = D_N a ⊓ D_N a')
      (ι_Z : Z_Q ⟶ P_NR)
      {I_Z : ∀ a : Fin (N + 1), Ideal ↑(P_NR.presheaf.obj (Opposite.op (D_N a)))}
      (hPres_Z : ∀ a : Fin (N + 1),
        let O_a : Z_Q.Opens := (TopologicalSpace.Opens.map ι_Z.base).obj (D_N a)
        ∃ e_a : O_a.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of
            (↑(P_NR.presheaf.obj (Opposite.op (D_N a))) ⧸ I_Z a)),
          O_a.ι ≫ ι_Z =
            e_a.hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I_Z a))) ≫
              (hAff_NR a).fromSpec),
      (∀ (a₀ : Fin (N + 1))
         (Φ : MvPolynomial (Fin (2 * m + 1)) P ≃+*
           (↑(P_NR.presheaf.obj (Opposite.op (D_N a₀))) ⧸ I_Z a₀)),
        Φ.toRingHom.comp MvPolynomial.C = (Ideal.Quotient.mk (I_Z a₀)).comp (c_NR a₀) →
        let O_a₀ : Z_Q.Opens := (TopologicalSpace.Opens.map ι_Z.base).obj (D_N a₀)
        ∃ e_O : O_a₀.toScheme ≅
            CategoryTheory.Limits.pullback (weilAffineSpaceOver k (2 * m + 1)).hom p_A1,
          e_O.hom ≫ CategoryTheory.Limits.pullback.snd
            (weilAffineSpaceOver k (2 * m + 1)).hom p_A1 = O_a₀.ι ≫ (ι_Z ≫ p_NR)) ∧
      (∀ (a_w : Fin (N + 1)) (B : CommRingCat.{u}) (ρ_B : P →+* B)
         (Θ : ↑B ≃+* (↑(P_NR.presheaf.obj (Opposite.op (D_N a_w))) ⧸ I_Z a_w)),
        Θ.toRingHom.comp ρ_B = (Ideal.Quotient.mk (I_Z a_w)).comp (c_NR a_w) →
        let O_w : Z_Q.Opens := (TopologicalSpace.Opens.map ι_Z.base).obj (D_N a_w)
        ∃ (e_B : AlgebraicGeometry.Spec B ≅ O_w.toScheme),
          (e_B.hom ≫ O_w.ι) ≫ (ι_Z ≫ p_NR) = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_B) ∧
          ∀ z : Z_Q,
            (∀ a : Fin (N + 1), a ≠ a_w →
              z ∉ (TopologicalSpace.Opens.map ι_Z.base).obj (D_N a)) →
            ∃ q : AlgebraicGeometry.Spec B,
              (e_B.hom ≫ O_w.ι).base q = z ∧
              ∀ a : Fin (N + 1), a ≠ a_w →
                Θ.symm (Ideal.Quotient.mk (I_Z a_w) (t_NR a_w a)) ∈ q.asIdeal) := by
    intro P_NR p_NR D_N hAff_NR c_NR t_NR hSup_NR hc_hom_NR hBasic_NR ι_Z I_Z hPres_Z
    refine ⟨?_, ?_⟩
    · intro a₀ Φ hΦ O_a₀
      obtain ⟨e_a₀, he_a₀⟩ := hPres_Z a₀
      let e_Φ : AlgebraicGeometry.Spec (CommRingCat.of
          (↑(P_NR.presheaf.obj (Opposite.op (D_N a₀))) ⧸ I_Z a₀)) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (2 * m + 1)) P)) :=
        { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ.toRingHom)
          inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ.symm.toRingHom)
          hom_inv_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            have hid : Φ.toRingHom.comp Φ.symm.toRingHom = RingHom.id _ :=
              RingHom.ext Φ.apply_symm_apply
            rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            have hid : Φ.symm.toRingHom.comp Φ.toRingHom = RingHom.id _ :=
              RingHom.ext Φ.symm_apply_apply
            rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
      refine ⟨e_a₀ ≪≫ e_Φ ≪≫ e_aff_P, ?_⟩
      change (e_a₀.hom ≫ e_Φ.hom ≫ e_aff_P.hom) ≫
          CategoryTheory.Limits.pullback.snd (weilAffineSpaceOver k (2 * m + 1)).hom p_A1 =
        O_a₀.ι ≫ (ι_Z ≫ p_NR)
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, he_aff_P_snd]
      dsimp only [e_Φ]
      rw [← CategoryTheory.Category.assoc O_a₀.ι, he_a₀, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, ← hc_hom_NR a₀,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hΦ,
        CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    · intro a_w B ρ_B Θ hΘ O_w
      obtain ⟨e_w, he_w⟩ := hPres_Z a_w
      let e_Θ : AlgebraicGeometry.Spec B ≅
          AlgebraicGeometry.Spec (CommRingCat.of
            (↑(P_NR.presheaf.obj (Opposite.op (D_N a_w))) ⧸ I_Z a_w)) :=
        { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.symm.toRingHom)
          inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom)
          hom_inv_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            have hid : Θ.symm.toRingHom.comp Θ.toRingHom = RingHom.id _ :=
              RingHom.ext Θ.symm_apply_apply
            rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            have hid : Θ.toRingHom.comp Θ.symm.toRingHom = RingHom.id _ :=
              RingHom.ext Θ.apply_symm_apply
            rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
      let e_B : AlgebraicGeometry.Spec B ≅ O_w.toScheme := e_Θ ≪≫ e_w.symm
      let ι_aff : AlgebraicGeometry.Spec B ⟶ Z_Q := e_B.hom ≫ O_w.ι
      refine ⟨e_B, ?_, ?_⟩
      · have hιZ_w : e_B.hom ≫ O_w.ι ≫ ι_Z =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.symm.toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I_Z a_w))) ≫
              (hAff_NR a_w).fromSpec := by
          dsimp only [e_B, e_Θ, O_w, CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom]
          rw [he_w, CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
        calc
          (e_B.hom ≫ O_w.ι) ≫ (ι_Z ≫ p_NR)
              = (e_B.hom ≫ O_w.ι ≫ ι_Z) ≫ p_NR := by
                simp only [CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.symm.toRingHom) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I_Z a_w))) ≫
                ((hAff_NR a_w).fromSpec ≫ p_NR) := by
                rw [hιZ_w]; simp only [CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (Θ.symm.toRingHom.comp ((Ideal.Quotient.mk (I_Z a_w)).comp (c_NR a_w)))) := by
                rw [← hc_hom_NR a_w, ← AlgebraicGeometry.Spec.map_comp,
                  ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
                  ← CommRingCat.ofHom_comp]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_B) := by
                congr 2; apply RingHom.ext; intro r
                change Θ.symm (Ideal.Quotient.mk (I_Z a_w) (c_NR a_w r)) = ρ_B r
                have hr := RingHom.congr_fun hΘ r
                change Θ (ρ_B r) = Ideal.Quotient.mk (I_Z a_w) (c_NR a_w r) at hr
                rw [← hr, Θ.symm_apply_apply]
      · intro z hz_avoid
        have hz_Ow : z ∈ O_w := by
          have htop : ι_Z.base z ∈ (⊤ : P_NR.Opens) := trivial
          rw [← hSup_NR, TopologicalSpace.Opens.mem_iSup] at htop
          obtain ⟨a, ha⟩ := htop
          by_cases haw : a = a_w
          · subst haw; exact ha
          · exact False.elim (hz_avoid a haw ha)
        have hz_range : z ∈ Set.range O_w.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]; exact hz_Ow
        obtain ⟨z_w, hzw⟩ := hz_range
        let q : AlgebraicGeometry.Spec B := e_B.inv.base z_w
        have hq_z : (e_B.hom ≫ O_w.ι).base q = z := by
          change (e_B.inv ≫ e_B.hom ≫ O_w.ι).base z_w = z
          rw [CategoryTheory.Iso.inv_hom_id_assoc]
          exact hzw
        refine ⟨q, hq_z, fun a ha_ne => ?_⟩
        let α : ↑(P_NR.presheaf.obj (Opposite.op (D_N a_w))) →+* ↑B :=
          Θ.symm.toRingHom.comp (Ideal.Quotient.mk (I_Z a_w))
        let P_spec : AlgebraicGeometry.Spec (CommRingCat.of
            ↑(P_NR.presheaf.obj (Opposite.op (D_N a_w)))) :=
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).base q
        have hιZ_eq : (e_B.hom ≫ O_w.ι) ≫ ι_Z =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ≫ (hAff_NR a_w).fromSpec := by
          dsimp only [e_B, e_Θ, α, O_w, CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom]
          rw [CategoryTheory.Category.assoc, he_w, CategoryTheory.Category.assoc,
            CategoryTheory.Iso.inv_hom_id_assoc, ← CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hfrom_P : (hAff_NR a_w).fromSpec.base P_spec = ι_Z.base z := by
          change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ≫ (hAff_NR a_w).fromSpec).base q = _
          rw [← hιZ_eq]; change ι_Z.base ((e_B.hom ≫ O_w.ι).base q) = ι_Z.base z; rw [hq_z]
        have hnot_basic : (hAff_NR a_w).fromSpec.base P_spec ∉ P_NR.basicOpen (t_NR a_w a) := by
          rw [hfrom_P, hBasic_NR a_w a]
          intro hmem; exact hz_avoid a ha_ne hmem.2
        have hnot_pbasic : P_spec ∉ PrimeSpectrum.basicOpen (t_NR a_w a) := by
          rw [← (hAff_NR a_w).fromSpec_preimage_basicOpen (t_NR a_w a)]
          exact hnot_basic
        exact not_not.mp (mt (PrimeSpectrum.mem_basicOpen (t_NR a_w a) P_spec).mpr hnot_pbasic)

  obtain ⟨hChartIso0, hVertexImm0⟩ :=
    @hChartBridge (weilProjectiveSpaceOver P N).left (weilProjectiveSpaceOver P N).hom
      (weilProjBasicOpen P N) hAff_R0 c_R0 t_R0
      hCoord_R0.2.1 hCoord_R0.2.2.1 hCoord_R0.2.2.2.2.2.2.2.1 ι_Q
      (fun a => Ideal.span (Set.range (g_Q0 a))) hPres_Q

  obtain ⟨Θ_w, hΘ_w_C, hΘ_w_X0, hΘ_w_X1⟩ := hS2_vertex
  obtain ⟨e_W_iso, hι_W_hom, hAvoid⟩ :=
    hVertexImm0 w_idx (CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) R_cat ⧸ I_cone0))
      ((Ideal.Quotient.mk I_cone0).comp MvPolynomial.C) Θ_w hΘ_w_C
  let O_cov : Fin (N + 1) → Z_Q.Opens :=
    fun a => (TopologicalSpace.Opens.map ι_Q.base).obj (weilProjBasicOpen P N a)
  let ι_W : Q_aff_P ⟶ Q_proj.left := e_W_iso.hom ≫ (O_cov w_idx).ι
  have hOpen_W : AlgebraicGeometry.IsOpenImmersion ι_W := by
    dsimp only [ι_W]; infer_instance

  obtain ⟨ε₀, hε₀_C, hε₀_X, hε₀_CX, hε₀_uniq⟩ := hS2_origin
  let o₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Q_aff_P :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε₀)

  have ho₀_π : o₀ ≫ π_aff_P = s₀ := by
    dsimp only [o₀, π_aff_P, s₀]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hε₀_C]
  have ho₀_X : ∀ idx : Fin (m + 1) × Fin 2,
      Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx) ∈ (o₀.base (⊥ : PrimeSpectrum k)).asIdeal := by
    intro idx
    change ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx)) ∈ (⊥ : PrimeSpectrum k).asIdeal
    rw [hε₀_X idx]
    exact (⊥ : PrimeSpectrum k).asIdeal.zero_mem
  have ho₀_CX : Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.X : R_cat)) ∈
      (o₀.base (⊥ : PrimeSpectrum k)).asIdeal := by
    change ε₀ (Ideal.Quotient.mk I_cone0 (MvPolynomial.C (Polynomial.X : R_cat))) ∈
      (⊥ : PrimeSpectrum k).asIdeal
    rw [hε₀_CX]
    exact (⊥ : PrimeSpectrum k).asIdeal.zero_mem

  have hSmoothCharts : ∀ y : ↥Q_proj.left,
      y ≠ (o₀ ≫ ι_W).base (⊥ : PrimeSpectrum k) →
      ∃ (O : Q_proj.left.Opens)
        (e_O : O.toScheme ≅
          CategoryTheory.Limits.pullback (weilAffineSpaceOver k (2 * m + 1)).hom p_A1),
        y ∈ O ∧
        e_O.hom ≫ CategoryTheory.Limits.pullback.snd
          (weilAffineSpaceOver k (2 * m + 1)).hom p_A1 = O.ι ≫ π_Q.left := by
    intro y hy_ne
    have hex_a₀ : ∃ a₀ : Fin (N + 1), a₀ ≠ w_idx ∧ y ∈ O_cov a₀ := by
      by_contra hnone
      have hAll : ∀ a : Fin (N + 1), a ≠ w_idx → y ∉ O_cov a :=
        fun a ha hmem => hnone ⟨a, ha, hmem⟩
      obtain ⟨q, hq_y, hq_mem⟩ := hAvoid y hAll
      have hq_X : ∀ idx : Fin (m + 1) × Fin 2,
          Ideal.Quotient.mk I_cone0 (MvPolynomial.X idx) ∈ q.asIdeal := by
        rintro ⟨j, b⟩
        rcases (by have := b.2; omega : b.1 = 0 ∨ b.1 = 1) with hb0 | hb1
        · have hb : b = 0 := Fin.ext hb0
          subst hb
          have hne_u : u_idx j ≠ w_idx := by
            intro h; have := congrArg Fin.val h; dsimp [u_idx, w_idx, N] at this; omega
          have hm_u := hq_mem (u_idx j) hne_u
          rw [← hΘ_w_X0 j, Θ_w.symm_apply_apply] at hm_u
          exact hm_u
        · have hb : b = 1 := Fin.ext hb1
          subst hb
          have hne_v : v_idx j ≠ w_idx := by
            intro h; have := congrArg Fin.val h; dsimp [v_idx, w_idx, N] at this; omega
          have hm_v := hq_mem (v_idx j) hne_v
          rw [← hΘ_w_X1 j, Θ_w.symm_apply_apply] at hm_v
          exact hm_v
      have hq_ker : q.asIdeal = RingHom.ker ε₀ := hε₀_uniq q hq_X
      have hq_eq : q = o₀.base (⊥ : PrimeSpectrum k) := by
        apply PrimeSpectrum.ext
        rw [hq_ker]
        rfl
      apply hy_ne
      change y = ι_W.base (o₀.base (⊥ : PrimeSpectrum k))
      rw [← hq_eq]
      exact hq_y.symm
    obtain ⟨a₀, ha₀_ne, hy_Oa₀⟩ := hex_a₀
    obtain ⟨Φ_a₀, hΦ_a₀⟩ := hS2_smooth a₀ ha₀_ne
    obtain ⟨e_O, he_O⟩ := hChartIso0 a₀ Φ_a₀ hΦ_a₀
    exact ⟨O_cov a₀, e_O, hy_Oa₀, he_O⟩

  have hFlat_Q : AlgebraicGeometry.Flat π_Q.left := by
    have : AlgebraicGeometry.IsZariskiLocalAtSource @AlgebraicGeometry.Flat :=
      @AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
        @AlgebraicGeometry.Flat _ AlgebraicGeometry.Flat.instHasRingHomPropertyFlat
    have hSup_O : (⨆ a : Fin (N + 1), O_cov a) = ⊤ := by
      rw [eq_top_iff]
      intro y _
      have htop : ι_Q.base y ∈ (⊤ : (weilProjectiveSpaceOver P N).left.Opens) := trivial
      rw [← hCoord_R0.2.1, TopologicalSpace.Opens.mem_iSup] at htop
      obtain ⟨a, ha⟩ := htop
      exact le_iSup O_cov a ha
    refine AlgebraicGeometry.IsZariskiLocalAtSource.of_iSup_eq_top
      (P := @AlgebraicGeometry.Flat) O_cov hSup_O fun a => ?_
    by_cases ha : a = w_idx
    · subst ha
      have hcomp_w : (O_cov w_idx).ι ≫ π_Q.left = e_W_iso.inv ≫ π_aff_P := by
        dsimp only [π_aff_P]
        rw [← hι_W_hom]
        change (O_cov w_idx).ι ≫ π_Q.left = e_W_iso.inv ≫ (e_W_iso.hom ≫ (O_cov w_idx).ι) ≫ π_Q.left
        rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
      rw [hcomp_w]
      exact @AlgebraicGeometry.Flat.comp _ _ _ e_W_iso.inv π_aff_P inferInstance hFlat_aff
    · obtain ⟨Φ_a, hΦ_a⟩ := hS2_smooth a ha
      obtain ⟨e_O, he_O⟩ := hChartIso0 a Φ_a hΦ_a
      change AlgebraicGeometry.Flat ((O_cov a).ι ≫ (ι_Q ≫ (weilProjectiveSpaceOver P N).hom))
      rw [← he_O]
      exact @AlgebraicGeometry.Flat.comp _ _ _ e_O.hom _ inferInstance hFlat_aff_pb

  
  
  
  obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  have hIsoPullBij : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (e : S₁ ≅ S₂) (r_deg : ℕ)
      (p_e : weilEtaleTorsionH S₂ ℓ r_deg →+ weilEtaleTorsionH S₁ ℓ r_deg),
      WeilIsTorsionEtalePullback e.hom ℓ r_deg p_e → Function.Bijective p_e := by
    intro S₁ S₂ e r_deg p_e hp_e
    obtain ⟨p_inv, hp_inv⟩ := hPullEx e.inv ℓ r_deg
    obtain ⟨p_id1, hp_id1⟩ := hPullEx (𝟙 S₁) ℓ r_deg
    obtain ⟨p_id2, hp_id2⟩ := hPullEx (𝟙 S₂) ℓ r_deg
    have hid1 : p_id1 = AddMonoidHom.id _ := hPullId ℓ r_deg p_id1 hp_id1
    have hid2 : p_id2 = AddMonoidHom.id _ := hPullId ℓ r_deg p_id2 hp_id2
    have hc1 : WeilIsTorsionEtalePullback (e.hom ≫ e.inv) ℓ r_deg p_id1 := by
      rwa [e.hom_inv_id]
    have hc2 : WeilIsTorsionEtalePullback (e.inv ≫ e.hom) ℓ r_deg p_id2 := by
      rwa [e.inv_hom_id]
    have h1 : p_e.comp p_inv = AddMonoidHom.id _ :=
      (hPullComp e.hom e.inv ℓ r_deg p_e p_inv p_id1 hp_e hp_inv hc1).symm.trans hid1
    have h2 : p_inv.comp p_e = AddMonoidHom.id _ :=
      (hPullComp e.inv e.hom ℓ r_deg p_inv p_e p_id2 hp_inv hp_e hc2).symm.trans hid2
    exact Function.bijective_iff_has_inverse.mpr
      ⟨p_inv, fun x => DFunLike.congr_fun h2 x, fun y => DFunLike.congr_fun h1 y⟩

  let f_Pi := CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom

  have hGeomFiberCohom :
      ∀ (K : Type u) [Field K] [IsAlgClosed K]
        (s_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ U_line),
        (∀ r_odd : ℕ, r_odd % 2 = 1 →
          Subsingleton (weilEtaleTorsionH (CategoryTheory.Limits.pullback π_Q.left s_K) ℓ r_odd)) ∧
        ∀ (i : ℕ), i ≤ 2 * m →
          ∀ (h_Pi_K : CategoryTheory.Limits.pullback f_Pi s_K ⟶
              CategoryTheory.Limits.pullback π_Q.left s_K),
            h_Pi_K ≫ CategoryTheory.Limits.pullback.fst π_Q.left s_K =
              CategoryTheory.Limits.pullback.fst f_Pi s_K ≫ ι_Pi →
            h_Pi_K ≫ CategoryTheory.Limits.pullback.snd π_Q.left s_K =
              CategoryTheory.Limits.pullback.snd f_Pi s_K →
            ∀ (p_i : weilEtaleTorsionH (CategoryTheory.Limits.pullback π_Q.left s_K) ℓ i →+
                weilEtaleTorsionH (CategoryTheory.Limits.pullback f_Pi s_K) ℓ i),
              WeilIsTorsionEtalePullback h_Pi_K ℓ i p_i →
              Function.Bijective p_i := by
    clear! R_cat e_aff_P hS2_smooth hval_succAbove hrange_fin1 hFlat_aff_pb s₀ O_cov
    intro K _ _ s_K
    let φ_s : P →+* K := (AlgebraicGeometry.Spec.preimage s_K).hom
    have hSpec_φs : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_s) = s_K :=
      AlgebraicGeometry.Spec.map_preimage s_K
    let ι_kK : k →+* K := φ_s.comp Polynomial.C
    have hℓ_K : (ℓ : K) ≠ 0 := by
      intro h0
      apply hℓ
      apply RingHom.injective ι_kK
      rw [map_natCast, h0, map_zero]
    have hℓ_charK : ℓ ≠ ringChar K := by
      rintro rfl
      exact hℓ_K ringChar.Nat.cast_ringChar

    have hPBC_K : WeilProperModPrimeBaseChangeHolds K ℓ :=
      weil_etale_proper_base_change_mod_prime K ℓ hℓ_K
    have hP1_K : WeilP1ConstructiblePushforwardHolds K ℓ :=
      weil_etale_p1_constructible_pushforward K ℓ hℓ_K
        (fun k₀ _ _ C _ hIntC hProjC hℓ₀ =>
          weil_etale_smooth_proj_curve_mod_prime_cohomology k₀ C hIntC hProjC ℓ hℓ₀)
        hPBC_K

    let S_K_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
      CategoryTheory.Over.mk (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)))
    have : AlgebraicGeometry.LocallyOfFiniteType S_K_ov.hom := by
      change AlgebraicGeometry.LocallyOfFiniteType (𝟙 _)
      infer_instance
    have : AlgebraicGeometry.QuasiCompact S_K_ov.hom := by
      change AlgebraicGeometry.QuasiCompact (𝟙 _)
      infer_instance
    have : AlgebraicGeometry.IsSeparated S_K_ov.hom := by
      change AlgebraicGeometry.IsSeparated (𝟙 _)
      infer_instance

    have hFinProper : ∀ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
        [AlgebraicGeometry.IsProper W.hom] (r_deg : ℕ),
        Finite (weilEtaleTorsionH W.left ℓ r_deg) := by
      intro W _ r_deg
      let f_W : W ⟶ S_K_ov :=
        CategoryTheory.Over.homMk W.hom (CategoryTheory.Category.comp_id W.hom)
      have hConstW : WeilIsConstructibleModPrimeSheaf ℓ W.left (weilEtaleTorsionSheaf W.left ℓ) :=
        (weil_etale_constructible_mod_prime_extraction_over_algClosed K W ℓ 0).1
      have hPushW : WeilIsConstructibleModPrimeSheaf ℓ
          (AlgebraicGeometry.Spec (CommRingCat.of K))
          (weilEtaleHigherDirectImage W.hom r_deg (weilEtaleTorsionSheaf W.left ℓ)) :=
        weil_etale_proper_constructible_pushforward K ℓ hℓ_K hPBC_K hP1_K W S_K_ov f_W
          (inferInstance : AlgebraicGeometry.IsProper W.hom)
          (weilEtaleTorsionSheaf W.left ℓ) hConstW r_deg
      exact (weil_etale_constructible_mod_prime_extraction_over_algClosed K W ℓ r_deg).2 hPushW

    have hDimSpecK :
        topologicalKrullDim (AlgebraicGeometry.Spec (CommRingCat.of K)) ≤
          (0 : WithBot ℕ∞) := by
      have : Subsingleton (TopologicalSpace.IrreducibleCloseds
          (AlgebraicGeometry.Spec (CommRingCat.of K))) := by
        refine ⟨fun A B => ?_⟩
        ext x
        obtain ⟨a, ha⟩ := A.isIrreducible.nonempty
        obtain ⟨b, hb⟩ := B.isIrreducible.nonempty
        exact ⟨fun _ => Subsingleton.elim x b ▸ hb, fun _ => Subsingleton.elim x a ▸ ha⟩
      have : Nonempty (TopologicalSpace.IrreducibleCloseds
          (AlgebraicGeometry.Spec (CommRingCat.of K))) :=
        ⟨⟨Set.univ,
          ⟨⟨(⊥ : PrimeSpectrum K), trivial⟩,
            fun u v _ _ ⟨x_u, _, hxu⟩ ⟨x_v, _, hyv⟩ =>
              ⟨(⊥ : PrimeSpectrum K), trivial,
                by rwa [Subsingleton.elim (⊥ : PrimeSpectrum K) x_u],
                by rwa [Subsingleton.elim (⊥ : PrimeSpectrum K) x_v]⟩⟩,
          isClosed_univ⟩⟩
      change Order.krullDim (TopologicalSpace.IrreducibleCloseds
          (AlgebraicGeometry.Spec (CommRingCat.of K))) ≤ 0
      rw [Order.krullDim_eq_zero]

    obtain ⟨ι_P1, ι_aff, _, _, _, _, hOpen_P1, hι_P1_hom,
        ⟨s_inf, _, hs_inf_hom, hDisj_inf, hCov_inf, _⟩, _, hPoly_all⟩ :=
      weil_polyP1_coord_compactification_and_properness K
    have : AlgebraicGeometry.IsOpenImmersion ι_P1 := hOpen_P1
    let U_aff_et : ∀ d : ℕ, (weilPolyP1Over K d).left.Etale :=
      fun d => CategoryTheory.MorphismProperty.Over.mk ⊤ (ι_aff d)
        (by have := (hPoly_all d).2.1; infer_instance)

    have hPolyP1LocalVanish : ∀ (d r_deg : ℕ),
        r_deg ≠ 2 * d →
        Subsingleton (weilEtaleLocalTorsionH (weilPolyP1Over K d).left ℓ (U_aff_et d) r_deg) := by
      intro d
      induction d with
      | zero =>
        intro r_deg hr_ne
        have hr_pos : 1 ≤ r_deg := by omega
        let Z₀ := weilPolyP1Over K 0
        have : AlgebraicGeometry.LocallyOfFiniteType Z₀.hom := by
          change AlgebraicGeometry.LocallyOfFiniteType (𝟙 _)
          infer_instance
        have : AlgebraicGeometry.QuasiCompact Z₀.hom := by
          change AlgebraicGeometry.QuasiCompact (𝟙 _)
          infer_instance
        exact weil_etale_dim_zero_algClosed_cohomology_subsingleton K Z₀ hDimSpecK
          (weilEtaleLocalTorsionSheaf Z₀.left ℓ (U_aff_et 0)) r_deg hr_pos
      | succ δ ih =>
        intro r_deg hr_ne
        have : AlgebraicGeometry.IsAffine
            ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over K δ).left).obj
              (U_aff_et δ)).left := by
          change AlgebraicGeometry.IsAffine (AlgebraicGeometry.Spec _)
          infer_instance
        let P_δ := weilPolyP1Over K δ
        let P_1 := weilProjectiveSpaceOver K 1
        let π_δ := CategoryTheory.Limits.pullback.fst P_δ.hom P_1.hom
        let ρ_δ := CategoryTheory.Limits.pullback.snd P_δ.hom P_1.hom
        let f_Sδ : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin δ) K)) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of K) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin δ) K)))
        let f_T1 : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial K)) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of K) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))
        let pr_head : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (δ + 1)) K)) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin δ) K)) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (MvPolynomial.rename Fin.castSucc :
              MvPolynomial (Fin δ) K →ₐ[K] MvPolynomial (Fin (δ + 1)) K).toRingHom)
        let t_U : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (δ + 1)) K)) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of (Polynomial K)) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Polynomial.aeval (R := K)
              (MvPolynomial.X (Fin.last δ) : MvPolynomial (Fin (δ + 1)) K)).toRingHom)
        let snoc_fn : Fin (δ + 1) →
            TensorProduct K (MvPolynomial (Fin δ) K) (Polynomial K) :=
          Fin.snoc (α := fun _ => TensorProduct K (MvPolynomial (Fin δ) K) (Polynomial K))
            (fun i : Fin δ => TensorProduct.tmul K (MvPolynomial.X i) (1 : Polynomial K))
            (TensorProduct.tmul K (1 : MvPolynomial (Fin δ) K) Polynomial.X)
        let Φ_sp : MvPolynomial (Fin (δ + 1)) K →ₐ[K]
            TensorProduct K (MvPolynomial (Fin δ) K) (Polynomial K) :=
          MvPolynomial.aeval snoc_fn
        let Ψ_sp : TensorProduct K (MvPolynomial (Fin δ) K) (Polynomial K) →ₐ[K]
            MvPolynomial (Fin (δ + 1)) K :=
          Algebra.TensorProduct.lift (R := K) (S := K)
            (MvPolynomial.rename Fin.castSucc)
            (Polynomial.aeval (MvPolynomial.X (Fin.last δ)))
            (fun _ _ => Commute.all _ _)
        have hΨΦ : Ψ_sp.comp Φ_sp = AlgHom.id K (MvPolynomial (Fin (δ + 1)) K) := by
          apply MvPolynomial.algHom_ext
          intro j
          simp only [AlgHom.coe_comp, Function.comp_apply, AlgHom.id_apply, Φ_sp,
            MvPolynomial.aeval_X]
          refine Fin.lastCases ?_ (fun i => ?_) j
          · dsimp only [snoc_fn, Ψ_sp]
            rw [Fin.snoc_last, Algebra.TensorProduct.lift_tmul, map_one, one_mul, Polynomial.aeval_X]
          · dsimp only [snoc_fn, Ψ_sp]
            rw [Fin.snoc_castSucc, Algebra.TensorProduct.lift_tmul, map_one, mul_one,
              MvPolynomial.rename_X]
        have hΦΨ : Φ_sp.comp Ψ_sp =
            AlgHom.id K (TensorProduct K (MvPolynomial (Fin δ) K) (Polynomial K)) := by
          apply Algebra.TensorProduct.ext
          · apply MvPolynomial.algHom_ext
            intro i
            simp only [AlgHom.coe_comp, Function.comp_apply, AlgHom.id_apply,
              Algebra.TensorProduct.includeLeft_apply]
            dsimp only [Ψ_sp, Φ_sp, snoc_fn]
            rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one, MvPolynomial.rename_X,
              MvPolynomial.aeval_X, Fin.snoc_castSucc]
          · apply Polynomial.algHom_ext
            simp only [AlgHom.restrictScalars_apply, AlgHom.coe_comp, Function.comp_apply,
              AlgHom.id_apply, Algebra.TensorProduct.includeRight_apply]
            dsimp only [Ψ_sp, Φ_sp, snoc_fn]
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul, Polynomial.aeval_X,
              MvPolynomial.aeval_X, Fin.snoc_last]
        let e_sp : MvPolynomial (Fin (δ + 1)) K ≃ₐ[K]
            TensorProduct K (MvPolynomial (Fin δ) K) (Polynomial K) :=
          AlgEquiv.ofAlgHom Φ_sp Ψ_sp hΦΨ hΨΦ
        have : CategoryTheory.IsIso (CommRingCat.ofHom e_sp.symm.toRingHom) :=
          ⟨⟨CommRingCat.ofHom e_sp.toRingHom,
            CommRingCat.hom_ext (RingHom.ext fun x => e_sp.apply_symm_apply x),
            CommRingCat.hom_ext (RingHom.ext fun x => e_sp.symm_apply_apply x)⟩⟩
        have : CategoryTheory.IsIso
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_sp.symm.toRingHom)) :=
          inferInstance
        let q_iso : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (δ + 1)) K)) ⟶
            CategoryTheory.Limits.pullback f_Sδ f_T1 :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_sp.symm.toRingHom) ≫
            (AlgebraicGeometry.pullbackSpecIso K (MvPolynomial (Fin δ) K) (Polynomial K)).inv
        have : CategoryTheory.IsIso q_iso := by
          change CategoryTheory.IsIso
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_sp.symm.toRingHom) ≫
              (AlgebraicGeometry.pullbackSpecIso K (MvPolynomial (Fin δ) K) (Polynomial K)).inv)
          infer_instance
        have h_q_fst : q_iso ≫ CategoryTheory.Limits.pullback.fst f_Sδ f_T1 = pr_head := by
          dsimp only [q_iso, f_Sδ, f_T1, pr_head]
          rw [CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_fst,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          refine congrArg AlgebraicGeometry.Spec.map
            (congrArg CommRingCat.ofHom (RingHom.ext fun p => ?_))
          change Ψ_sp (TensorProduct.tmul K p 1) = (MvPolynomial.rename Fin.castSucc) p
          dsimp only [Ψ_sp]
          rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
        have h_q_snd : q_iso ≫ CategoryTheory.Limits.pullback.snd f_Sδ f_T1 = t_U := by
          dsimp only [q_iso, f_Sδ, f_T1, t_U]
          rw [CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_snd,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          refine congrArg AlgebraicGeometry.Spec.map
            (congrArg CommRingCat.ofHom (RingHom.ext fun p => ?_))
          change Ψ_sp (TensorProduct.tmul K 1 p) =
            (Polynomial.aeval (MvPolynomial.X (Fin.last δ))) p
          dsimp only [Ψ_sp]
          rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        have hp_q : CategoryTheory.IsPullback q_iso pr_head
            (CategoryTheory.Limits.pullback.fst f_Sδ f_T1) (𝟙 _) :=
          CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [h_q_fst, CategoryTheory.Category.comp_id]⟩
        have hp_aff0 :=
          hp_q.paste_horiz (CategoryTheory.IsPullback.of_hasPullback f_Sδ f_T1).flip
        rw [h_q_snd, CategoryTheory.Category.id_comp] at hp_aff0
        let Y_V := (weilEtaleSitePullback π_δ).obj (U_aff_et δ)
        let u_rel : (weilAffineSpaceOver K (δ + 1)).left ⟶ Y_V.left :=
          CategoryTheory.Limits.pullback.lift pr_head (ι_aff (δ + 1))
            (hPoly_all δ).2.2.2.1.symm
        have hu_rel_fst : u_rel ≫ CategoryTheory.Limits.pullback.fst (ι_aff δ) π_δ = pr_head :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hu_rel_snd : u_rel ≫ Y_V.hom = ι_aff (δ + 1) :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hp_bot : CategoryTheory.IsPullback
            (Y_V.hom ≫ ρ_δ) (CategoryTheory.Limits.pullback.fst (ι_aff δ) π_δ)
            P_1.hom (ι_aff δ ≫ P_δ.hom) :=
          ((CategoryTheory.IsPullback.of_hasPullback (ι_aff δ) π_δ).paste_vert
            (CategoryTheory.IsPullback.of_hasPullback P_δ.hom P_1.hom)).flip
        have hCastPb : ∀ {X Y₁ Y₂ Z : AlgebraicGeometry.Scheme.{u}}
            {a : X ⟶ Y₁} {b b' : X ⟶ Y₂} {c c' : Y₁ ⟶ Z} {d d' : Y₂ ⟶ Z},
            b = b' → c = c' → d = d' →
            CategoryTheory.IsPullback a b' c' d' →
            CategoryTheory.IsPullback a b c d := by
