        (hinv_comp.trans CategoryTheory.Limits.comp_zero.symm)

    let 𝒬_θ := CategoryTheory.Limits.cokernel (CategoryTheory.Limits.kernel.ι θ)

    have hCokKerZeroOfMapZero : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
        (P_Y : CategoryTheory.Sheaf D_bar.left.smallEtaleTopology AddCommGrpCat.{u} ⥤
          CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        [CategoryTheory.Limits.PreservesFiniteLimits P_Y]
        [CategoryTheory.Limits.PreservesColimits P_Y],
