          algebraMap (Polynomial E') M h₀' * (w_op * e_M j)
        rw [← IsScalarTower.algebraMap_apply (Polynomial E') (RatFunc E') M, mul_assoc]
      rw [lhs_eq, hMul_w j]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [Algebra.smul_def]
      change algebraMap (Polynomial E') M (A_poly r j) * e_M r =
        algebraMap (RatFunc E') M (algebraMap (Polynomial E') (RatFunc E') (A_poly r j)) * e_M r
      rw [← IsScalarTower.algebraMap_apply (Polynomial E') (RatFunc E') M]
    rw [hmul_eq, map_sum]
    simp_rw [map_smul, Module.Basis.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
      Finsupp.finsetSum_apply]
    rw [Finset.sum_eq_single k]
    · simp
    · intro r _ hr
      rw [Finsupp.single_eq_of_ne hr.symm]
    · intro hk
      exact absurd (Finset.mem_univ k) hk
  have hB_charpoly : B_mat.charpoly = G_E'.map ι := by
    have hw_int_K' : _root_.IsIntegral (RatFunc E') w_op := Algebra.IsIntegral.isIntegral w_op
    let e_top : ↥(IntermediateField.adjoin (RatFunc E') ({w_op} : Set M)) ≃ₐ[RatFunc E'] M :=
