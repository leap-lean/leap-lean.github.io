    obtain ⟨hc_η₀, hr_η₀, hLim_η₀, hAdd_η₀, _⟩ := hSiteAdj η₀
    let _ := hc_η₀; let _ := hr_η₀; let _ := hLim_η₀; let _ := hAdd_η₀
