            exact S.isSeparated Z R_Z hRZ_mem _ _ (fun _ _ hk => hk)
          let R_TY : Sieve T_Y :=
            { arrows := fun {Z} _ =>
                (∃ _ : Z ⟶ W', True) ∨ Disjoint (Set.range Z.hom.base) (Set.range i₀.base)
              downward_closed := fun {Z₁ Z₂} _ hu k => by
                rcases hu with ⟨g, -⟩ | hDisj
                · exact Or.inl ⟨k ≫ g, trivial⟩
                · right; refine hDisj.mono_left ?_
                  rintro _ ⟨z₂, rfl⟩
                  exact ⟨k.left.base z₂, by
                    change (k.left ≫ Z₁.hom).base z₂ = Z₂.hom.base z₂
                    rw [MorphismProperty.Over.w k]⟩ }
          have hCov_TY : R_TY ∈ Y.smallEtaleTopology T_Y := by
            rw [hMemEtale]; intro y
            by_cases hy : y ∈ Set.range i₀.base
            · obtain ⟨pt_k, rfl⟩ := hy
              let iso_W'_left := ((Scheme.Etale.forget S_k₁).comp (Over.forget _)).mapIso iso_W'
              have hhom_snd : iso_W'_left.hom = Limits.pullback.snd W'.hom i₀ := by
                have hw := MorphismProperty.Over.w iso_W'.hom
                change iso_W'_left.hom ≫ 𝟙 _ = Limits.pullback.snd W'.hom i₀ at hw
                rwa [Category.comp_id] at hw
              let inv_snd : S_k₁ ⟶ Limits.pullback W'.hom i₀ := iso_W'_left.inv
              have hinv_snd : inv_snd ≫ Limits.pullback.snd W'.hom i₀ = 𝟙 _ :=
                hhom_snd ▸ iso_W'_left.inv_hom_id
              let p_k : ↥(Limits.pullback W'.hom i₀) := inv_snd.base pt_k
              have hp_snd : (Limits.pullback.snd W'.hom i₀).base p_k = pt_k := by
                change (inv_snd ≫ Limits.pullback.snd W'.hom i₀).base pt_k = pt_k
                rw [hinv_snd]; rfl
              let w'_pt := (Limits.pullback.fst W'.hom i₀).base p_k
              let u_W' : W' ⟶ T_Y := MorphismProperty.Over.homMk W'.hom (Category.comp_id W'.hom)
              have hw'_y : u_W'.left.base w'_pt = i₀.base pt_k := by
                change (Limits.pullback.fst W'.hom i₀ ≫ W'.hom).base p_k = i₀.base pt_k
                rw [Limits.pullback.condition]
                change i₀.base ((Limits.pullback.snd W'.hom i₀).base p_k) = i₀.base pt_k
                rw [hp_snd]
              exact ⟨W', u_W', w'_pt, Or.inl ⟨𝟙 W', trivial⟩, W'.prop, hw'_y⟩
            · let U_out : Y.Opens := ⟨(Set.range i₀.base)ᶜ, hClosed_i₀.isOpen_compl⟩
              let E_out : Y.Etale := MorphismProperty.Over.mk ⊤ U_out.ι inferInstance
              let u_out : E_out ⟶ T_Y := MorphismProperty.Over.homMk U_out.ι (Category.comp_id _)
              have hDisj_out : Disjoint (Set.range E_out.hom.base) (Set.range i₀.base) := by
                rw [Set.disjoint_left]; rintro _ ⟨⟨z, hz⟩, rfl⟩ hz_i₀; exact hz hz_i₀
              exact ⟨E_out, u_out, ⟨y, hy⟩, Or.inr hDisj_out, E_out.prop, rfl⟩
          let val_Z : ∀ {Z : Y.Etale} (u : Z ⟶ T_Y), R_TY.arrows u →
              ↥(S.obj.obj (Opposite.op Z)) :=
            fun {Z} _ _ => if h : ∃ _ : Z ⟶ W', True then (S.obj.map (Classical.choose h).op) s' else 0
          have hval_W' : ∀ {Z : Y.Etale} (u : Z ⟶ T_Y) (hu : R_TY.arrows u) (g : Z ⟶ W'),
              val_Z u hu = (S.obj.map g.op) s' := by
            intro Z u hu g
            dsimp [val_Z]
            split_ifs with hex
            · exact hAgreeW' (Classical.choose hex) g
            · exact False.elim (hex ⟨g, trivial⟩)
          let Eℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
          let x_fam : ∀ ⦃Z : Y.Etale⦄ (u : Z ⟶ T_Y), R_TY.arrows u →
              (Eℤ ⟶ S.obj.obj (Opposite.op Z)) := fun Z u hu =>
            AddCommGrpCat.ofHom
              { toFun := fun z => z.down • val_Z u hu
                map_zero' := zero_zsmul _
                map_add' := fun z₁ z₂ => add_zsmul _ z₁.down z₂.down }
          obtain ⟨amalg, hamalg, -⟩ := S.property Eℤ R_TY hCov_TY x_fam (by
            intro Y₁ Y₂ Z_ov g₁ g₂ f₁ f₂ h₁ h₂ _
            apply AddCommGrpCat.ext; rintro ⟨z⟩
            change (S.obj.map g₁.op) (z • val_Z f₁ h₁) = (S.obj.map g₂.op) (z • val_Z f₂ h₂)
            rw [map_zsmul, map_zsmul]; congr 1
            have h₁' := h₁; have h₂' := h₂
            rcases h₁' with ⟨q₁, -⟩ | hDisj₁
            · rcases h₂' with ⟨q₂, -⟩ | hDisj₂
              · rw [hval_W' f₁ h₁ q₁, hval_W' f₂ h₂ q₂]
                have hc1 : (S.obj.map g₁.op) ((S.obj.map q₁.op) s') =
                    (S.obj.map (g₁ ≫ q₁).op) s' := by rw [op_comp, S.obj.map_comp]; rfl
                have hc2 : (S.obj.map g₂.op) ((S.obj.map q₂.op) s') =
                    (S.obj.map (g₂ ≫ q₂).op) s' := by rw [op_comp, S.obj.map_comp]; rfl
                rw [hc1, hc2]; exact hAgreeW' (g₁ ≫ q₁) (g₂ ≫ q₂)
              · have hDisjZ : Disjoint (Set.range Z_ov.hom.base) (Set.range i₀.base) := by
                  refine hDisj₂.mono_left ?_; rintro _ ⟨z₀, rfl⟩
                  exact ⟨g₂.left.base z₀, by
                    change (g₂.left ≫ Y₂.hom).base z₀ = Z_ov.hom.base z₀
                    rw [MorphismProperty.Over.w g₂]⟩
                exact (hVanishOut Z_ov hDisjZ).elim _ _
            · have hDisjZ : Disjoint (Set.range Z_ov.hom.base) (Set.range i₀.base) := by
                refine hDisj₁.mono_left ?_; rintro _ ⟨z₀, rfl⟩
                exact ⟨g₁.left.base z₀, by
                  change (g₁.left ≫ Y₁.hom).base z₀ = Z_ov.hom.base z₀
                  rw [MorphismProperty.Over.w g₁]⟩
              exact (hVanishOut Z_ov hDisjZ).elim _ _)
          let u_W' : W' ⟶ T_Y := MorphismProperty.Over.homMk W'.hom (Category.comp_id W'.hom)
          have hu_mem : R_TY.arrows u_W' := Or.inl ⟨𝟙 W', trivial⟩
          let amalg_hom : Eℤ ⟶ S.obj.obj (Opposite.op T_Y) := amalg
          have h_eval := congrArg (fun m : Eℤ ⟶ S.obj.obj (Opposite.op W') => m.hom (ULift.up 1))
            (hamalg u_W' hu_mem)
          change (S.obj.map u_W'.op) (amalg_hom.hom (ULift.up 1)) =
            (1 : ℤ) • val_Z u_W' hu_mem at h_eval
          rw [one_zsmul, hval_W' u_W' hu_mem (𝟙 W'), op_id, S.obj.map_id,
            hSub_TY.elim (amalg_hom.hom (ULift.up 1)) 0, map_zero] at h_eval
          exact h_eval.symm
      exact S.isSeparated W R_zero hR_mem s 0 (fun _ _ hf => by rw [map_zero]; exact hf)
    rw [Limits.IsZero.iff_id_eq_zero]
    apply Sheaf.hom_ext; ext W x
    exact (hAllSub W.unop).elim _ _

  
  have hEtaleSliceZeroEval :
      ∀ {W Y : Scheme.{u}} (w : W ⟶ Y) (hw : Etale w)
