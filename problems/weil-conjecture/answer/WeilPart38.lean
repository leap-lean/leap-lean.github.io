            congrArg (fun φ => (φ.hom m : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₂.op)
          rw [← hz₁, ← hz₂, hev₁, hev₂]
        refine ⟨{
          lift := fun c =>
            let g_fn : ↥c.pt → ↥E.left → ↥A := fun m z =>
              let ch := hcov z
              let u_z := ch.choose_spec.choose
              let y_z := ch.choose_spec.choose_spec.choose
              let hu_z := ch.choose_spec.choose_spec.choose_spec.1
              eval_c c ⟨CategoryTheory.Over.mk u_z, hu_z⟩ m y_z
            have hg_eq : ∀ (m : ↥c.pt) (w : S₀.arrows.category) (y : ↥w.obj.left.left),
