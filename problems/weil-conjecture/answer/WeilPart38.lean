      (CategoryTheory.MorphismProperty.of_isIso P_Et e_U.hom)
  have hSurj_π₀ : AlgebraicGeometry.Surjective π₀ := by
    rw [AlgebraicGeometry.surjective_iff]
    intro P
    have hker : RingHom.ker (algebraMap R S) ≤ P.asIdeal := by
      intro r hr
      have hr0 : r = 0 := hInj ((RingHom.mem_ker.mp hr).trans (map_zero (algebraMap R S)).symm)
      rw [hr0]
      exact P.asIdeal.zero_mem
    have : P.asIdeal.IsPrime := P.isPrime
    obtain ⟨Q, hQ, hUnder⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain (S := S) P.asIdeal hker
    exact ⟨⟨Q, hQ⟩, PrimeSpectrum.ext hUnder⟩
  have hSurj_π : AlgebraicGeometry.Surjective π :=
    CategoryTheory.MorphismProperty.IsStableUnderComposition.comp_mem
      (P := P_Surj) π₀ e_U.hom hSurj_π₀
      (CategoryTheory.MorphismProperty.of_isIso P_Surj e_U.hom)
  have hDeck_π : ∀ σ : S ≃ₐ[R] S, d_V σ ≫ π = π := by
    intro σ
    dsimp only [π, d_V]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    have hcomm : CommRingCat.ofHom (algebraMap R S) ≫ CommRingCat.ofHom σ.symm.toRingHom =
        CommRingCat.ofHom (algebraMap R S) :=
      CommRingCat.hom_ext (RingHom.ext fun r => σ.symm.commutes r)
    rw [hcomm]
  have hDeck_mul : ∀ σ τ : S ≃ₐ[R] S, d_V σ ≫ d_V τ = d_V (τ * σ) := by
    intro σ τ
    dsimp only [d_V]
    rw [← AlgebraicGeometry.Spec.map_comp]
    rfl
  let A := TensorProduct R S S
  let T : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of A)
  let p₁ : T ⟶ V :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)
  let p₂ : T ⟶ V :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom)
  have hComm₀ : p₁ ≫ π₀ = p₂ ≫ π₀ := by
    have hf₁ : (AlgebraicGeometry.pullbackSpecIso R S S).inv ≫
        CategoryTheory.Limits.pullback.fst π₀ π₀ = p₁ :=
      AlgebraicGeometry.pullbackSpecIso_inv_fst R S S
    have hf₂ : (AlgebraicGeometry.pullbackSpecIso R S S).inv ≫
        CategoryTheory.Limits.pullback.snd π₀ π₀ = p₂ :=
      AlgebraicGeometry.pullbackSpecIso_inv_snd R S S
    rw [← hf₁, ← hf₂, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition]
  have hPb_T₀ : CategoryTheory.IsPullback p₁ p₂ π₀ π₀ :=
    CategoryTheory.IsPullback.of_iso_pullback ⟨hComm₀⟩
      (AlgebraicGeometry.pullbackSpecIso R S S).symm
      (AlgebraicGeometry.pullbackSpecIso_inv_fst R S S)
      (AlgebraicGeometry.pullbackSpecIso_inv_snd R S S)
  have hPb_iso : CategoryTheory.IsPullback (𝟙 V) π₀ π e_U.hom :=
    CategoryTheory.IsPullback.of_horiz_isIso ⟨CategoryTheory.Category.id_comp π⟩
  have hPb_T : CategoryTheory.IsPullback p₁ p₂ π π := by
    have h := hPb_T₀.paste_horiz hPb_iso
    rwa [CategoryTheory.Category.comp_id] at h
  let μ : (S ≃ₐ[R] S) → (A →ₐ[S] S) :=
    fun σ => Algebra.TensorProduct.lift (AlgHom.id S S) σ.symm.toAlgHom (fun _ _ => Commute.all _ _)
  let Δ : Fin m → (V ⟶ T) :=
    fun i => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (μ (equiv_Γ i)).toRingHom)
  have hΔ_p₁ : ∀ i : Fin m, Δ i ≫ p₁ = 𝟙 V := by
    intro i
    dsimp only [Δ, p₁]
    rw [← AlgebraicGeometry.Spec.map_comp]
    have hid : CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫
        CommRingCat.ofHom (μ (equiv_Γ i)).toRingHom = 𝟙 (CommRingCat.of S) := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro s
      change μ (equiv_Γ i) (Algebra.TensorProduct.includeLeftRingHom s) = s
      dsimp only [μ]
      rw [Algebra.TensorProduct.includeLeftRingHom_apply, Algebra.TensorProduct.lift_tmul]
      simp
    rw [hid, AlgebraicGeometry.Spec.map_id]
  have hΔ_p₂ : ∀ i : Fin m, Δ i ≫ p₂ = d_V (equiv_Γ i) := by
    intro i
    dsimp only [Δ, p₂, d_V]
    rw [← AlgebraicGeometry.Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro s
    change μ (equiv_Γ i) (Algebra.TensorProduct.includeRight s) = (equiv_Γ i).symm s
    dsimp only [μ]
    rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.lift_tmul]
    simp
  let D_open : Fin m → Set ↥T := fun i => (PrimeSpectrum.basicOpen (e i)).1
  have hRange_Δ : ∀ i : Fin m, Set.range (Δ i).base = D_open i := by
    intro i
    ext P
    constructor
    · rintro ⟨q, rfl⟩
      apply (PrimeSpectrum.mem_basicOpen (e i) _).mpr
      intro he
      have hmem : μ (equiv_Γ i) (e i) ∈ q.asIdeal := he
      have hev : μ (equiv_Γ i) (e i) = 1 := by
        simpa only [↓reduceIte] using hEval i i
      rw [hev] at hmem
      exact q.isPrime.ne_top (q.asIdeal.eq_top_iff_one.mpr hmem)
    · intro hP
      have he : e i ∉ (P : PrimeSpectrum A).asIdeal :=
        (PrimeSpectrum.mem_basicOpen (e i) P).mp hP
      let q : PrimeSpectrum S :=
        PrimeSpectrum.comap Algebra.TensorProduct.includeLeftRingHom P
      refine ⟨q, PrimeSpectrum.ext (Ideal.ext fun z => ?_)⟩
      change TensorProduct.tmul R (μ (equiv_Γ i) z) 1 ∈ (P : PrimeSpectrum A).asIdeal ↔
        z ∈ (P : PrimeSpectrum A).asIdeal
      constructor
      · intro h1
        have hmul : TensorProduct.tmul R (μ (equiv_Γ i) z) 1 * e i ∈ (P : PrimeSpectrum A).asIdeal :=
          Ideal.mul_mem_right (e i) (P : PrimeSpectrum A).asIdeal h1
        rw [← hAbsorb i z] at hmul
        exact ((P : PrimeSpectrum A).isPrime.mem_or_mem hmul).resolve_right he
      · intro hz
        have hmul : z * e i ∈ (P : PrimeSpectrum A).asIdeal :=
          Ideal.mul_mem_right (e i) (P : PrimeSpectrum A).asIdeal hz
        rw [hAbsorb i z] at hmul
        exact ((P : PrimeSpectrum A).isPrime.mem_or_mem hmul).resolve_right he
  have hDisj_D : ∀ i j : Fin m, i ≠ j → Disjoint (D_open i) (D_open j) := by
    intro i j hij
    rw [Set.disjoint_left]
    intro P hi hj
    have hi' : e i ∉ P.asIdeal := (PrimeSpectrum.mem_basicOpen (e i) P).mp hi
    have hj' : e j ∉ P.asIdeal := (PrimeSpectrum.mem_basicOpen (e j) P).mp hj
    have h0 : e i * e j ∈ P.asIdeal := by
      rw [hOrth i j hij]
      exact P.asIdeal.zero_mem
    rcases P.isPrime.mem_or_mem h0 with h | h
    · exact hi' h
    · exact hj' h
  have hCov_D : (⋃ i : Fin m, D_open i) = Set.univ := by
    rw [Set.eq_univ_iff_forall]
    intro P
    by_contra hNot
    have hAll : ∀ i : Fin m, e i ∈ P.asIdeal := by
      intro i
      by_contra hi
      exact hNot (Set.mem_iUnion.mpr ⟨i, (PrimeSpectrum.mem_basicOpen (e i) P).mpr hi⟩)
    have h1 : (1 : A) ∈ P.asIdeal := by
      rw [← hSum]
      exact Submodule.sum_mem P.asIdeal fun i _ => hAll i
    exact P.isPrime.ne_top (P.asIdeal.eq_top_iff_one.mpr h1)
  have hSheets : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V),
      let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ π) π
      ∃ δ : (S ≃ₐ[R] S) → (Y ⟶ Y_V),
        (∀ σ : S ≃ₐ[R] S,
          δ σ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π = 𝟙 Y ∧
          δ σ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π =
            g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ∧
          AlgebraicGeometry.Etale (δ σ) ∧
          IsOpen (Set.range (δ σ).base)) ∧
        (∀ σ₁ σ₂ : S ≃ₐ[R] S, σ₁ ≠ σ₂ →
          Disjoint (Set.range (δ σ₁).base) (Set.range (δ σ₂).base)) ∧
        (⋃ σ : S ≃ₐ[R] S, Set.range (δ σ).base) = Set.univ ∧
        (∀ (σ τ : S ≃ₐ[R] S) (m_τ : Y_V ⟶ Y_V),
          m_τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π =
            CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π →
          m_τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π =
            CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
          δ σ ≫ m_τ = δ (τ * σ)) := by
    intro Y g_Y Y_V
    let fst_YV := CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π
    let snd_YV := CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π
    have hδ_cond : ∀ σ : S ≃ₐ[R] S, 𝟙 Y ≫ (g_Y ≫ π) = (g_Y ≫ d_V σ) ≫ π := fun σ => by
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hDeck_π σ]
    let δ : (S ≃ₐ[R] S) → (Y ⟶ Y_V) :=
      fun σ => CategoryTheory.Limits.pullback.lift (𝟙 Y) (g_Y ≫ d_V σ) (hδ_cond σ)
    have hδ_fst : ∀ σ : S ≃ₐ[R] S, δ σ ≫ fst_YV = 𝟙 Y :=
      fun σ => CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hδ_snd : ∀ σ : S ≃ₐ[R] S, δ σ ≫ snd_YV = g_Y ≫ d_V σ :=
      fun σ => CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hEt_fstYV : AlgebraicGeometry.Etale fst_YV :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := P_Et) (CategoryTheory.IsPullback.of_hasPullback (g_Y ≫ π) π).flip hEt_π
    have hEt_δ : ∀ σ : S ≃ₐ[R] S, AlgebraicGeometry.Etale (δ σ) := by
      intro σ
      apply CategoryTheory.MorphismProperty.of_postcomp P_Et
        (δ σ) fst_YV hEt_fstYV
      rw [hδ_fst σ]
      exact CategoryTheory.MorphismProperty.id_mem P_Et Y
    have hq_cond : (fst_YV ≫ g_Y) ≫ π = snd_YV ≫ π := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
    let q_Y : Y_V ⟶ T := hPb_T.lift (fst_YV ≫ g_Y) snd_YV hq_cond
    have hq_p₁ : q_Y ≫ p₁ = fst_YV ≫ g_Y := hPb_T.lift_fst _ _ _
    have hq_p₂ : q_Y ≫ p₂ = snd_YV := hPb_T.lift_snd _ _ _
    have hPb_outer_bot : CategoryTheory.IsPullback (q_Y ≫ p₂) fst_YV π (g_Y ≫ π) := by
      rw [hq_p₂]
      exact (CategoryTheory.IsPullback.of_hasPullback (g_Y ≫ π) π).flip
    have hPb_bot : CategoryTheory.IsPullback q_Y fst_YV p₁ g_Y :=
      CategoryTheory.IsPullback.of_right hPb_outer_bot hq_p₁ hPb_T.flip
    have hComm_top : ∀ i : Fin m, g_Y ≫ Δ i = δ (equiv_Γ i) ≫ q_Y := by
      intro i
      apply hPb_T.hom_ext
      · rw [CategoryTheory.Category.assoc, hΔ_p₁ i, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.assoc, hq_p₁, ← CategoryTheory.Category.assoc,
          hδ_fst (equiv_Γ i), CategoryTheory.Category.id_comp]
      · rw [CategoryTheory.Category.assoc, hΔ_p₂ i, CategoryTheory.Category.assoc,
          hq_p₂, hδ_snd (equiv_Γ i)]
    have hPb_top : ∀ i : Fin m, CategoryTheory.IsPullback g_Y (δ (equiv_Γ i)) (Δ i) q_Y := by
      intro i
      have hVert : CategoryTheory.IsPullback g_Y (δ (equiv_Γ i) ≫ fst_YV) (Δ i ≫ p₁) g_Y := by
        rw [hδ_fst (equiv_Γ i), hΔ_p₁ i]
        exact CategoryTheory.IsPullback.of_vert_isIso
          ⟨(CategoryTheory.Category.comp_id g_Y).trans (CategoryTheory.Category.id_comp g_Y).symm⟩
      exact CategoryTheory.IsPullback.of_bot hVert (hComm_top i) hPb_bot
    have hRange_δ : ∀ i : Fin m,
        Set.range (δ (equiv_Γ i)).base = q_Y.base ⁻¹' D_open i := by
      intro i
      rw [← hRange_Δ i]
      ext z
      constructor
      · rintro ⟨y, rfl⟩
        exact ⟨g_Y.base y, congrArg (fun k : Y ⟶ T => k.base y) (hComm_top i)⟩
      · rintro ⟨v, hv⟩
        obtain ⟨y, _, hyz⟩ :=
          AlgebraicGeometry.Scheme.exists_preimage_of_isPullback (hPb_top i) v z hv
        exact ⟨y, hyz⟩
    refine ⟨δ, ?_, ?_, ?_, ?_⟩
    · intro σ
      refine ⟨hδ_fst σ, hδ_snd σ, hEt_δ σ, ?_⟩
      let i := equiv_Γ.symm σ
      have hσ : equiv_Γ i = σ := equiv_Γ.apply_symm_apply σ
      rw [← hσ, hRange_δ i]
      exact (PrimeSpectrum.basicOpen (e i)).2.preimage q_Y.continuous
    · intro σ₁ σ₂ hne
      let i := equiv_Γ.symm σ₁
      let j := equiv_Γ.symm σ₂
      have hij : i ≠ j := equiv_Γ.symm.injective.ne hne
      rw [← equiv_Γ.apply_symm_apply σ₁, ← equiv_Γ.apply_symm_apply σ₂,
        hRange_δ i, hRange_δ j]
      exact (hDisj_D i j hij).preimage q_Y.base
    · rw [Set.eq_univ_iff_forall]
      intro z
      have hz : q_Y.base z ∈ (⋃ i : Fin m, D_open i) := by
        rw [hCov_D]
        exact Set.mem_univ _
      obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hz
      have hz_i : z ∈ Set.range (δ (equiv_Γ i)).base := by
        rw [hRange_δ i]
        exact hi
      exact Set.mem_iUnion.mpr ⟨equiv_Γ i, hz_i⟩
    · intro σ τ m_τ hm_fst hm_snd
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hm_fst, hδ_fst σ, hδ_fst (τ * σ)]
      · rw [CategoryTheory.Category.assoc, hm_snd, ← CategoryTheory.Category.assoc,
          hδ_snd σ, CategoryTheory.Category.assoc, hDeck_mul σ τ, hδ_snd (τ * σ)]
  refine ⟨⟨hEt_π, hSurj_π⟩, ?_, hSheets⟩
  intro W h_W W_V
  let fst_W := CategoryTheory.Limits.pullback.fst h_W π
  let snd_W := CategoryTheory.Limits.pullback.snd h_W π
  have hPb_W_flip : CategoryTheory.IsPullback snd_W fst_W π h_W :=
    (CategoryTheory.IsPullback.of_hasPullback h_W π).flip
  have hEt_fstW : AlgebraicGeometry.Etale fst_W :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := P_Et) hPb_W_flip hEt_π
  have hSurj_fstW : AlgebraicGeometry.Surjective fst_W :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := P_Surj) hPb_W_flip hSurj_π
  refine ⟨⟨hEt_fstW, hSurj_fstW⟩, ?_, ?_⟩
  · intro σ
    have hm_cond : fst_W ≫ h_W = (snd_W ≫ d_V σ) ≫ π := by
      rw [CategoryTheory.Category.assoc, hDeck_π σ, CategoryTheory.Limits.pullback.condition]
    let m_can : W_V ⟶ W_V := CategoryTheory.Limits.pullback.lift fst_W (snd_W ≫ d_V σ) hm_cond
    refine ⟨m_can,
      ⟨CategoryTheory.Limits.pullback.lift_fst _ _ _,
       CategoryTheory.Limits.pullback.lift_snd _ _ _⟩, ?_⟩
    rintro m' ⟨hm'_fst, hm'_snd⟩
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact hm'_fst.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
    · exact hm'_snd.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
  · intro y₁ y₂ hy
    obtain ⟨δ_W, hδ_W_props, _, hδ_W_cov, _⟩ := hSheets W_V snd_W
    let Z := CategoryTheory.Limits.pullback (snd_W ≫ π) π
    let fst_Z : Z ⟶ W_V := CategoryTheory.Limits.pullback.fst (snd_W ≫ π) π
    let snd_Z : Z ⟶ V := CategoryTheory.Limits.pullback.snd (snd_W ≫ π) π
    have hr_cond : (fst_Z ≫ fst_W) ≫ h_W = snd_Z ≫ π := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Limits.pullback.condition]
    let r₂ : Z ⟶ W_V := CategoryTheory.Limits.pullback.lift (fst_Z ≫ fst_W) snd_Z hr_cond
    have hr_fst : r₂ ≫ fst_W = fst_Z ≫ fst_W := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hr_snd : r₂ ≫ snd_W = snd_Z := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPb_Z_outer : CategoryTheory.IsPullback (r₂ ≫ snd_W) fst_Z π (fst_W ≫ h_W) := by
      rw [hr_snd, CategoryTheory.Limits.pullback.condition]
      exact (CategoryTheory.IsPullback.of_hasPullback (snd_W ≫ π) π).flip
    have hPb_Z : CategoryTheory.IsPullback r₂ fst_Z fst_W fst_W :=
      CategoryTheory.IsPullback.of_right hPb_Z_outer hr_fst hPb_W_flip
    obtain ⟨z, hz₂, hz₁⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_Z y₂ y₁ hy.symm
    have hz_mem : z ∈ ⋃ σ : S ≃ₐ[R] S, Set.range (δ_W σ).base := by
      rw [hδ_W_cov]
      exact Set.mem_univ z
    obtain ⟨σ, y', hy'⟩ := Set.mem_iUnion.mp hz_mem
    have hy'_eq : y' = y₁ := by
      calc y' = (𝟙 W_V : W_V ⟶ W_V).base y' := rfl
        _ = (δ_W σ ≫ fst_Z).base y' :=
            congrArg (fun k : W_V ⟶ W_V => k.base y') (hδ_W_props σ).1.symm
        _ = fst_Z.base ((δ_W σ).base y') := rfl
        _ = fst_Z.base z := by rw [hy']
        _ = y₁ := hz₁
    rw [hy'_eq] at hy'
    let m_σ : W_V ⟶ W_V := δ_W σ ≫ r₂
    refine ⟨σ, m_σ, ?_, ?_, ?_⟩
    · dsimp only [m_σ]
      rw [CategoryTheory.Category.assoc, hr_fst, ← CategoryTheory.Category.assoc,
        (hδ_W_props σ).1, CategoryTheory.Category.id_comp]
    · dsimp only [m_σ]
      rw [CategoryTheory.Category.assoc, hr_snd, (hδ_W_props σ).2.1]
    · change r₂.base ((δ_W σ).base y₁) = y₂
      rw [hy', hz₂]

theorem weil_etale_galois_rep_sheaf_and_pullback_iso (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    (U : AlgebraicGeometry.Scheme.{u})
    (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R)) U)
    (hπ_et : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S)) ≫ e_U.hom))
    (hπ_surj : AlgebraicGeometry.Surjective
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S)) ≫ e_U.hom))
    (hSheets :
      let V := AlgebraicGeometry.Spec (CommRingCat.of S)
      let π : V ⟶ U :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S)) ≫ e_U.hom
      ∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V),
        let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ π) π
        ∃ δ : (S ≃ₐ[R] S) → (Y ⟶ Y_V),
          (∀ σ : S ≃ₐ[R] S,
            δ σ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π = 𝟙 Y ∧
            δ σ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π =
              g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ∧
            AlgebraicGeometry.Etale (δ σ) ∧
            IsOpen (Set.range (δ σ).base)) ∧
          (∀ σ₁ σ₂ : S ≃ₐ[R] S, σ₁ ≠ σ₂ →
            Disjoint (Set.range (δ σ₁).base) (Set.range (δ σ₂).base)) ∧
          (⋃ σ : S ≃ₐ[R] S, Set.range (δ σ).base) = Set.univ ∧
          (∀ (σ τ : S ≃ₐ[R] S) (m_τ : Y_V ⟶ Y_V),
            m_τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π =
              CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π →
            m_τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π =
              CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
            δ σ ≫ m_τ = δ (τ * σ)))
    (hMem_U : ∀ (W : U.Etale) (R_sieve : CategoryTheory.Sieve W),
      R_sieve ∈ U.smallEtaleTopology W ↔
        ∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget U).obj W).left,
          ∃ (Y : U.Etale) (f : Y ⟶ W)
            (y : ↥((AlgebraicGeometry.Scheme.Etale.forget U).obj Y).left),
            R_sieve.arrows f ∧
            AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget U).map f).left ∧
            ((AlgebraicGeometry.Scheme.Etale.forget U).map f).left.base y = x)
    (hMem_V :
      let V := AlgebraicGeometry.Spec (CommRingCat.of S)
      ∀ (W : V.Etale) (R_sieve : CategoryTheory.Sieve W),
        R_sieve ∈ V.smallEtaleTopology W ↔
          ∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj W).left,
            ∃ (Y : V.Etale) (f : Y ⟶ W)
              (y : ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj Y).left),
              R_sieve.arrows f ∧
              AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget V).map f).left ∧
              ((AlgebraicGeometry.Scheme.Etale.forget V).map f).left.base y = x)
    (hCont_π :
      let V := AlgebraicGeometry.Spec (CommRingCat.of S)
      let π : V ⟶ U :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S)) ≫ e_U.hom
      (weilEtaleSitePullback π).IsContinuous U.smallEtaleTopology V.smallEtaleTopology)
    (hAdj_π :
      let V := AlgebraicGeometry.Spec (CommRingCat.of S)
      let π : V ⟶ U :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S)) ≫ e_U.hom
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback π) AddCommGrpCat.{u} _
        U.smallEtaleTopology V.smallEtaleTopology hCont_π).IsRightAdjoint)
    (N : ℕ) (Λ : Type) [CommRing Λ]
    (ρ : (S ≃ₐ[R] S) →* (Matrix (Fin N) (Fin N) Λ)ˣ)
    (hT_V : CategoryTheory.Limits.IsTerminal
      (AlgebraicGeometry.Scheme.Etale.mk (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of S)))))
    (θ_V :
      let V := AlgebraicGeometry.Spec (CommRingCat.of S)
      let A : AddCommGrpCat.{u} :=
        AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin N → Λ))
      let C_V := (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A
      ∀ Y : V.Etale,
        LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj Y).left ↥A →+
          ↑(C_V.obj.obj (Opposite.op Y)))
    (hθ_bij : ∀ Y : (AlgebraicGeometry.Spec (CommRingCat.of S)).Etale,
      Function.Bijective (θ_V Y))
    (hθ_nat :
      let V := AlgebraicGeometry.Spec (CommRingCat.of S)
      let A : AddCommGrpCat.{u} :=
        AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin N → Λ))
      let C_V := (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A
      ∀ {Y₁ Y₂ : V.Etale} (f : Y₁ ⟶ Y₂)
        (g : LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj Y₂).left ↥A),
        (C_V.obj.map (Opposite.op f)).hom (θ_V Y₂ g) =
          θ_V Y₁ (g.comap ((AlgebraicGeometry.Scheme.Etale.forget V).map f).left.base.hom))
    (hθ_unit :
      let V := AlgebraicGeometry.Spec (CommRingCat.of S)
      let A : AddCommGrpCat.{u} :=
        AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin N → Λ))
      let T_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
      ∀ a : ↥A,
        θ_V T_V (LocallyConstant.const _ a) =
          ((CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u}
            hT_V).unit.app A).hom a) :
    let V := AlgebraicGeometry.Spec (CommRingCat.of S)
    let π : V ⟶ U :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S)) ≫ e_U.hom
    let A : AddCommGrpCat.{u} :=
      AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin N → Λ))
    let C_V := (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A
    ∃ (ℰ : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u})
      (triv : ∀ W : U.Etale,
        let W_V := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom π
        ↑(ℰ.obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_V (Fin N → Λ)),
      WeilIsEtaleSheafPullback π ℰ C_V ∧
      (∀ {W₁ W₂ : U.Etale} (u : Quiver.Hom W₁ W₂),
        let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W₁).hom
        let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W₂).hom
        let W₁_V := CategoryTheory.Limits.pullback h₁ π
        let W₂_V := CategoryTheory.Limits.pullback h₂ π
        ∀ (u_V : Quiver.Hom W₁_V W₂_V),
          CategoryTheory.CategoryStruct.comp u_V (CategoryTheory.Limits.pullback.fst h₂ π) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst h₁ π)
              ((AlgebraicGeometry.Scheme.Etale.forget U).map u).left →
          CategoryTheory.CategoryStruct.comp u_V (CategoryTheory.Limits.pullback.snd h₂ π) =
            CategoryTheory.Limits.pullback.snd h₁ π →
          ∀ (s : ↑(ℰ.obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_V),
            triv W₁ ((ℰ.obj.map (Opposite.op u)) s) y₁ =
              triv W₂ s (u_V.base y₁)) ∧
      (∀ W : U.Etale,
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom
        let W_V := CategoryTheory.Limits.pullback h_W π
        Function.Injective (triv W) ∧
        Set.range (triv W) =
          { f | ∀ (σ : S ≃ₐ[R] S) (m_σ : Quiver.Hom W_V W_V),
            CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W π) =
              CategoryTheory.Limits.pullback.fst h_W π →
            CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W π) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W π)
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
