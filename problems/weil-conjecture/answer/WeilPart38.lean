        (IsLocalization.Away.lift_eq g (S := R₀) hg_unit p).symm
    have hFracR₀ : IsFractionRing R₀ (RatFunc F) :=
      IsFractionRing.isFractionRing_of_isDomain_of_isLocalization
        (Submonoid.powers g) R₀ (RatFunc F)
    refine ⟨hFracR₀, ?_⟩
    intro B₁ L₁ _ _ _ _ _ _ _ _ _ _ _ _
    apply IsScalarTower.of_algebraMap_eq'
    apply IsLocalization.ringHom_ext (Submonoid.powers g)
    apply RingHom.ext
    intro p
    simp only [RingHom.comp_apply]
    rw [IsScalarTower.algebraMap_apply R₀ B₁ L₁,
      ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B₁,
      ← IsScalarTower.algebraMap_apply (Polynomial F) B₁ L₁,
      ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (RatFunc F),
      ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L₁]
  · 
    intro R K B₁ L₁ B₂ L₂ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ι_B hInj
    let _ : Algebra B₁ B₂ := ι_B.toRingHom.toAlgebra
    let _ : Algebra B₁ L₂ := ((algebraMap B₂ L₂).comp ι_B.toRingHom).toAlgebra
    have hST_B1B2L2 : IsScalarTower B₁ B₂ L₂ :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hST_RB1B2 : IsScalarTower R B₁ B₂ :=
      IsScalarTower.of_algebraMap_eq fun r => (ι_B.commutes r).symm
    have hST_RB1L2 : IsScalarTower R B₁ L₂ :=
      IsScalarTower.of_algebraMap_eq fun r => by
        change (algebraMap R L₂) r = (algebraMap B₂ L₂) (ι_B (algebraMap R B₁ r))
        rw [ι_B.commutes r, ← IsScalarTower.algebraMap_apply R B₂ L₂]
    have hFin_B1B2 : Module.Finite B₁ B₂ :=
      Module.Finite.of_restrictScalars_finite R B₁ B₂
    have hEt_B1B2 : Algebra.Etale B₁ B₂ :=
      Algebra.Etale.of_restrictScalars R B₁ B₂
    have _ : Algebra.IsIntegral R B₁ := Algebra.IsIntegral.of_finite R B₁
    have hIC_B2B1L2 : IsIntegralClosure B₂ B₁ L₂ :=
      IsIntegralClosure.tower_top (R := R)
    have hg_inj : Function.Injective (algebraMap B₁ L₂) :=
      (IsFractionRing.injective B₂ L₂).comp hInj
    let f_L : L₁ →+* L₂ := IsFractionRing.lift (K := L₁) hg_inj
    have hf_L_eval : ∀ b : B₁, f_L (algebraMap B₁ L₁ b) = algebraMap B₁ L₂ b :=
      fun b => IsFractionRing.lift_algebraMap hg_inj b
    have hf_L_K : f_L.comp (algebraMap K L₁) = algebraMap K L₂ := by
      apply IsLocalization.ringHom_ext (nonZeroDivisors R)
      ext r
      simp only [RingHom.comp_apply]
      rw [← IsScalarTower.algebraMap_apply R K L₁,
        IsScalarTower.algebraMap_apply R B₁ L₁,
        hf_L_eval,
        ← IsScalarTower.algebraMap_apply R B₁ L₂,
        IsScalarTower.algebraMap_apply R K L₂]
    let instL : Algebra L₁ L₂ := f_L.toAlgebra
    let _ : Algebra L₁ L₂ := instL
    have hST_KL1L2 : IsScalarTower K L₁ L₂ :=
      IsScalarTower.of_algebraMap_eq fun k =>
        (congrFun (congrArg DFunLike.coe hf_L_K) k).symm
    have hST_B1L1L2 : IsScalarTower B₁ L₁ L₂ :=
      IsScalarTower.of_algebraMap_eq fun b => (hf_L_eval b).symm
    have hFD_L1L2 : FiniteDimensional L₁ L₂ :=
      Module.Finite.of_restrictScalars_finite K L₁ L₂
    have hGal_L1L2 : IsGalois L₁ L₂ :=
      IsGalois.tower_top_of_isGalois K L₁ L₂
    refine ⟨?_, hST_B1B2L2, hFin_B1B2, hEt_B1B2, hIC_B2B1L2,
      instL, hST_B1L1L2, hFD_L1L2, hGal_L1L2⟩
    intro σ
    let σ_L : L₁ ≃ₐ[K] L₁ := IsFractionRing.fieldEquivOfAlgEquiv K L₁ L₁ σ
    let τ_L : L₂ ≃ₐ[K] L₂ := σ_L.liftNormal L₂
    let e_IC2 : B₂ ≃ₐ[R] ↥(integralClosure R L₂) :=
      IsIntegralClosure.equiv R B₂ L₂ ↥(integralClosure R L₂)
    let τ : B₂ ≃ₐ[R] B₂ :=
      (e_IC2.trans (AlgEquiv.mapIntegralClosure (τ_L.restrictScalars R))).trans e_IC2.symm
    have hτ_eval : ∀ y : B₂, algebraMap B₂ L₂ (τ y) = τ_L (algebraMap B₂ L₂ y) := by
      intro y
      have h1 := IsIntegralClosure.algebraMap_equiv R B₂ L₂ ↥(integralClosure R L₂) (τ y)
      have h2 := IsIntegralClosure.algebraMap_equiv R B₂ L₂ ↥(integralClosure R L₂) y
      change (↑(e_IC2 (τ y)) : L₂) = algebraMap B₂ L₂ (τ y) at h1
      change (↑(e_IC2 y) : L₂) = algebraMap B₂ L₂ y at h2
      rw [← h1, ← h2]
      dsimp [τ]
      rw [e_IC2.apply_symm_apply]
      exact AlgEquiv.coe_mapIntegralClosure (τ_L.restrictScalars R) (e_IC2 y)
    refine ⟨τ, fun b => ?_⟩
    apply IsFractionRing.injective B₂ L₂
    rw [hτ_eval (ι_B b)]
    change τ_L (algebraMap B₁ L₂ b) = algebraMap B₁ L₂ (σ b)
    rw [IsScalarTower.algebraMap_apply B₁ L₁ L₂ b,
      AlgEquiv.liftNormal_commutes σ_L L₂ (algebraMap B₁ L₁ b),
      IsFractionRing.fieldEquivOfAlgEquiv_algebraMap K L₁ L₁ σ b,
