              (weilPolyP1CohomologyRepHomEquiv Y U_Y F_Y ψ))) := by
    intro W_top Y g_top hc_gt hr_gt F_Y U_Y U_W u ψ pb_gt adj_gt
    let R_Y := weilPolyP1CohomologyRepSheaf Y U_Y
    let pf_gt := (weilEtaleSitePullback g_top).sheafPushforwardContinuous AddCommGrpCat.{u}
      Y.smallEtaleTopology W_top.smallEtaleTopology
    let ι_Y : ↑(R_Y.obj.obj (Opposite.op U_Y)) :=
      weilPolyP1CohomologyRepHomEquiv Y U_Y R_Y (𝟙 R_Y)
    let s_pull : ↑((pb_gt.obj R_Y).obj.obj (Opposite.op ((weilEtaleSitePullback g_top).obj U_Y))) :=
      ((adj_gt.unit.app R_Y).hom.app (Opposite.op U_Y)).hom ι_Y
    rw [hRepNatRight W_top U_W (weilPolyP1CohomologyRepPullHom g_top U_Y U_W u) (pb_gt.map ψ)]
    dsimp only [weilPolyP1CohomologyRepPullHom]
    rw [Equiv.apply_symm_apply]
    have hNat_u := congrArg (fun m => m.hom s_pull)
      ((pb_gt.map ψ).hom.naturality (Opposite.op u))
    change (((pb_gt.map ψ).hom.app (Opposite.op U_W)).hom
        (((pb_gt.obj R_Y).obj.map (Opposite.op u)).hom s_pull)) =
      ((pb_gt.obj F_Y).obj.map (Opposite.op u)).hom
        (((pb_gt.map ψ).hom.app (Opposite.op ((weilEtaleSitePullback g_top).obj U_Y))).hom s_pull) at hNat_u
    rw [hNat_u]
    congr 1
    have hUnitNat := congrArg (fun m : R_Y ⟶ pf_gt.obj (pb_gt.obj F_Y) =>
      (m.hom.app (Opposite.op U_Y)).hom ι_Y) (adj_gt.unit.naturality ψ).symm
    change (((adj_gt.unit.app R_Y ≫ pf_gt.map (pb_gt.map ψ)).hom.app (Opposite.op U_Y)).hom ι_Y) =
      (((ψ ≫ adj_gt.unit.app F_Y).hom.app (Opposite.op U_Y)).hom ι_Y) at hUnitNat
    have hIdΨ : (ψ.hom.app (Opposite.op U_Y)).hom ι_Y =
        weilPolyP1CohomologyRepHomEquiv Y U_Y F_Y ψ := by
      have h1 := hRepNatRight Y U_Y (𝟙 R_Y) ψ
      rwa [CategoryTheory.Category.id_comp] at h1
    exact hUnitNat.trans (congrArg (((adj_gt.unit.app F_Y).hom.app (Opposite.op U_Y)).hom) hIdΨ)
  
  
  have hPushIsoEval :
      ∀ {F₁ F₂ : CategoryTheory.Functor S.Etale X'.Etale}
        (e : F₁ ≅ F₂)
        [F₁.IsContinuous S.smallEtaleTopology X'.smallEtaleTopology]
        [F₂.IsContinuous S.smallEtaleTopology X'.smallEtaleTopology]
        (G' : CategoryTheory.Sheaf X'.smallEtaleTopology AddCommGrpCat.{u}) (W : S.Etale),
        ((CategoryTheory.Functor.sheafPushforwardContinuousIso e
            AddCommGrpCat.{u} S.smallEtaleTopology X'.smallEtaleTopology).hom.app G').hom.app
          (Opposite.op W) =
          G'.obj.map (e.inv.app W).op := by
    intro F₁ F₂ e _ _ G' W
    rfl
  
  obtain ⟨e_S, he_S⟩ := hDegZeroHDI f F
  obtain ⟨e_S', he_S'⟩ := hDegZeroHDI f' (pb_g'.obj F)
  refine ⟨e_S, e_S', ?_⟩
  let pf_g := (weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
    S.smallEtaleTopology S'.smallEtaleTopology
  let P_X := CategoryTheory.Functor.comp (weilEtaleSitePullback f).op
    (CategoryTheory.Sheaf.cohomologyPresheaf F 0)
  let adj_sh_S := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
  have hMateCancel :
      ∀ (α : pf_f.obj F ⟶ pf_g.obj (pf_f'.obj (pb_g'.obj F))),
        (∀ (W : S.Etale) (s : ↑(P_X.obj (Opposite.op W))),
          (α.hom.app (Opposite.op W)).hom
              ((e_S.hom.hom.app (Opposite.op W)).hom
                (((adj_sh_S.unit.app P_X).app (Opposite.op W)).hom s)) =
            (e_S'.hom.hom.app (Opposite.op ((weilEtaleSitePullback g).obj W))).hom
              ((β₀.hom.app (Opposite.op W)).hom
                (((adj_sh_S.unit.app P_X).app (Opposite.op W)).hom s))) →
        pb_g.map e_S.hom ≫ (adj_g.homEquiv (pf_f.obj F) (pf_f'.obj (pb_g'.obj F))).symm α =
          (adj_g.homEquiv _ _).symm β₀ ≫ e_S'.hom := by
    intro α hPt
    rw [← adj_g.homEquiv_naturality_left_symm e_S.hom α,
      ← adj_g.homEquiv_naturality_right_symm β₀ e_S'.hom]
    congr 1
    apply (adj_sh_S.homEquiv P_X (pf_g.obj (pf_f'.obj (pb_g'.obj F)))).injective
    change adj_sh_S.unit.app P_X ≫ (e_S.hom ≫ α).hom =
      adj_sh_S.unit.app P_X ≫ (β₀ ≫ pf_g.map e_S'.hom).hom
    refine CategoryTheory.NatTrans.ext (funext fun X_op => AddCommGrpCat.ext fun s => ?_)
    rcases X_op with ⟨W⟩
    exact hPt W s
  apply hMateCancel (pf_f.map (adj_g'.unit.app F) ≫ e_pf.hom.app (pb_g'.obj F))
  intro W s
  set ψ := CategoryTheory.Abelian.Ext.addEquiv₀ s
  
  have hLHS :
      (((pf_f.map (adj_g'.unit.app F) ≫ e_pf.hom.app (pb_g'.obj F)).hom.app
          (Opposite.op W)).hom
        ((e_S.hom.hom.app (Opposite.op W)).hom
          (((adj_sh_S.unit.app P_X).app (Opposite.op W)).hom s))) =
        (((pb_g'.obj F).obj.map (Opposite.op (e_fun.inv.app W))).hom
          (((adj_g'.unit.app F).hom.app (Opposite.op ((weilEtaleSitePullback f).obj W))).hom
            (weilPolyP1CohomologyRepHomEquiv X ((weilEtaleSitePullback f).obj W) F ψ))) := by
    change ((e_pf.hom.app (pb_g'.obj F)).hom.app (Opposite.op W)).hom
        (((adj_g'.unit.app F).hom.app (Opposite.op ((weilEtaleSitePullback f).obj W))).hom
          ((e_S.hom.hom.app (Opposite.op W)).hom
            (((adj_sh_S.unit.app P_X).app (Opposite.op W)).hom s))) = _
    dsimp only [e_pf]
    rw [he_S W s, hPushIsoEval e_fun (pb_g'.obj F) W]
    rfl
  
  have hRHS :
      ((e_S'.hom.hom.app (Opposite.op ((weilEtaleSitePullback g).obj W))).hom
        ((β₀.hom.app (Opposite.op W)).hom
          (((adj_sh_S.unit.app P_X).app (Opposite.op W)).hom s))) =
        weilPolyP1CohomologyRepHomEquiv X'
          ((weilEtaleSitePullback f').obj ((weilEtaleSitePullback g).obj W))
          (pb_g'.obj F)
          (weilPolyP1CohomologyRepPullHom g'
              ((weilEtaleSitePullback f).obj W)
              ((weilEtaleSitePullback f').obj ((weilEtaleSitePullback g).obj W))
              (e_fun.inv.app W) ≫
            pb_g'.map ψ) := by
    have hβW := congrArg (fun m => m.hom s) (hβ₀ W)
    change ((β₀.hom.app (Opposite.op W)).hom
        (((adj_sh_S.unit.app P_X).app (Opposite.op W)).hom s)) =
      (weilOuterBCApp f g f' g' hgf F 0 W).hom s at hβW
    rw [hβW]
    dsimp only [weilOuterBCApp, e_fun]
    let ρ_W := weilPolyP1CohomologyRepPullHom g'
      ((weilEtaleSitePullback f).obj W)
      ((weilEtaleSitePullback f').obj ((weilEtaleSitePullback g).obj W))
      ((weilOuterBCFunIso f g f' g' hgf).inv.app W)
    let s' := (((CategoryTheory.Abelian.Ext.mk₀ ρ_W).precomp (pb_g'.obj F) (Nat.zero_add 0)).comp
      (pb_g'.mapExtAddHom
        (weilPolyP1CohomologyRepSheaf X ((weilEtaleSitePullback f).obj W)) F 0)) s
    change (e_S'.hom.hom.app (Opposite.op ((weilEtaleSitePullback g).obj W))).hom
        ((((CategoryTheory.sheafificationAdjunction S'.smallEtaleTopology AddCommGrpCat.{u}).unit.app
            (CategoryTheory.Functor.comp (weilEtaleSitePullback f').op
              (CategoryTheory.Sheaf.cohomologyPresheaf (pb_g'.obj F) 0))).app
          (Opposite.op ((weilEtaleSitePullback g).obj W))).hom s') = _
    rw [he_S' ((weilEtaleSitePullback g).obj W) s']
    congr 1
    have hs_eq : s = CategoryTheory.Abelian.Ext.mk₀ ψ :=
      (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply s).symm
    have hs'_eq : s' = CategoryTheory.Abelian.Ext.mk₀ (ρ_W ≫ pb_g'.map ψ) := by
      dsimp only [s']
      rw [hs_eq, AddMonoidHom.comp_apply, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ ρ_W (pb_g'.map ψ)
    rw [hs'_eq, ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
  exact hLHS.trans
    ((hRepPullEval g' F ((weilEtaleSitePullback f).obj W)
        ((weilEtaleSitePullback f').obj ((weilEtaleSitePullback g).obj W))
        (e_fun.inv.app W) ψ).symm.trans
      hRHS.symm)

theorem weil_outer_bc_const_pullback_and_bockstein_ses : (∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      (∃ T₁ : Y₁.Etale, Nonempty (CategoryTheory.Limits.IsTerminal T₁)) ∧
      (∀ (T₂ : Y₂.Etale), CategoryTheory.Limits.IsTerminal T₂ →
        Nonempty (CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback h).obj T₂)))) ∧
    (∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂)
        [_hc_h : (weilEtaleSitePullback h).IsContinuous
          Y₂.smallEtaleTopology Y₁.smallEtaleTopology]
        [_hr_h : ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
          Y₂.smallEtaleTopology Y₁.smallEtaleTopology).IsRightAdjoint],
      let pb_h := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology
      let C₁ := CategoryTheory.constantSheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}
      let C₂ := CategoryTheory.constantSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}
      (∀ {T₁ : Y₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
          {T₂ : Y₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
          (A : AddCommGrpCat.{u}),
        CategoryTheory.IsIso (weilEtaleConstPullbackHom h hT₁ hT₂ A)) ∧
      (∀ {T₁ T₁' : Y₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
          (hT₁' : CategoryTheory.Limits.IsTerminal T₁')
          {T₂ T₂' : Y₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
          (hT₂' : CategoryTheory.Limits.IsTerminal T₂')
          (A : AddCommGrpCat.{u}),
        weilEtaleConstPullbackHom h hT₁ hT₂ A =
          weilEtaleConstPullbackHom h hT₁' hT₂' A) ∧
      (∀ {T₁ : Y₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
          {T₂ : Y₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
          {A₁ A₂ : AddCommGrpCat.{u}} (ψ : A₁ ⟶ A₂),
        pb_h.map (C₂.map ψ) ≫ weilEtaleConstPullbackHom h hT₁ hT₂ A₂ =
          weilEtaleConstPullbackHom h hT₁ hT₂ A₁ ≫ C₁.map ψ)) ∧
    (∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S) (q m : ℕ),
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf X 1)) ∧
      m • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf X m) = 0) ∧
    (∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (s : ℕ),
      let AM := fun n : ℕ => AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
      ∃ (μ_s : AM ℓ ⟶ AM (ℓ ^ (s + 1))) (π_s : AM (ℓ ^ (s + 1)) ⟶ AM (ℓ ^ s))
        (h0_s : μ_s ≫ π_s = 0),
        (CategoryTheory.ShortComplex.mk μ_s π_s h0_s).ShortExact) :=
by
  
  have hPillar1 : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      (∃ T₁ : Y₁.Etale, Nonempty (CategoryTheory.Limits.IsTerminal T₁)) ∧
      (∀ (T₂ : Y₂.Etale), CategoryTheory.Limits.IsTerminal T₂ →
        Nonempty (CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback h).obj T₂))) := by
    let T_std : ∀ (Y : AlgebraicGeometry.Scheme.{u}), Y.Etale :=
      fun Y => AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id Y)
    have hT_std : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
        CategoryTheory.Limits.IsTerminal (T_std Y) := by
      intro Y
      refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun E => CategoryTheory.MorphismProperty.Over.homMk E.hom
          (CategoryTheory.Category.comp_id E.hom)) ?_
      intro E m
      apply CategoryTheory.MorphismProperty.Comma.Hom.ext
      · change m.left = E.hom
        exact (CategoryTheory.Category.comp_id m.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w m)
      · exact Subsingleton.elim _ _
    intro Y₁ Y₂ h
    refine ⟨⟨T_std Y₁, ⟨hT_std Y₁⟩⟩, fun T₂ hT₂ => ?_⟩
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let e₂ : T₂ ≅ T_std Y₂ :=
      CategoryTheory.Limits.IsTerminal.uniqueUpToIso hT₂ (hT_std Y₂)
    let g_hom : T₂.left ⟶ Y₂ := e₂.hom.left
    let g_inv : Y₂ ⟶ T₂.left := e₂.inv.left
    have hg_eq : g_hom = T₂.hom :=
      (CategoryTheory.Category.comp_id g_hom).symm.trans
        (CategoryTheory.MorphismProperty.Over.w e₂.hom)
    have hid₁ : T₂.hom ≫ g_inv = 𝟙 T₂.left := by
      rw [← hg_eq]
      exact congrArg (fun m => m.left) e₂.hom_inv_id
    have hid₂ : g_inv ≫ T₂.hom = 𝟙 Y₂ := by
      rw [← hg_eq]
      exact congrArg (fun m => m.left) e₂.inv_hom_id
    let σ_inv : Y₁ ⟶ CategoryTheory.Limits.pullback T₂.hom h :=
      CategoryTheory.Limits.pullback.lift (h ≫ g_inv) (𝟙 Y₁) (by
        rw [CategoryTheory.Category.assoc, hid₂, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp])
    let φ_iso₀ : CategoryTheory.Limits.pullback T₂.hom h ≅ Y₁ :=
      { hom := CategoryTheory.Limits.pullback.snd T₂.hom h
        inv := σ_inv
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · dsimp [σ_inv]
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition,
              CategoryTheory.Category.assoc, hid₁, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
          · dsimp [σ_inv]
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        inv_hom_id := CategoryTheory.Limits.pullback.lift_snd _ _ _ }
    let φ_iso : ((weilEtaleSitePullback h).obj T₂).left ≅ Y₁ := φ_iso₀
    let iso₁ : (weilEtaleSitePullback h).obj T₂ ≅ T_std Y₁ :=
      CategoryTheory.MorphismProperty.Over.isoMk φ_iso
        (CategoryTheory.Category.comp_id ((weilEtaleSitePullback h).obj T₂).hom)
    exact ⟨CategoryTheory.Limits.IsTerminal.ofIso (hT_std Y₁) iso₁.symm⟩

  
  have hUnitCoh : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      {T T' : Y.Etale} (hT : CategoryTheory.Limits.IsTerminal T)
      (hT' : CategoryTheory.Limits.IsTerminal T') (A : AddCommGrpCat.{u}),
      let J := Y.smallEtaleTopology
      let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
      (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT').unit.app A ≫
        (C.obj A).obj.map (hT'.from T).op =
      (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT).unit.app A := by
    intro Y T T' hT hT' A J C
    let K : AddCommGrpCat.{u} ⥤ (Opposite Y.Etale ⥤ AddCommGrpCat.{u}) :=
      CategoryTheory.Functor.const (Opposite Y.Etale)
    let η_sh := (CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit
    have h_u : ∀ {W : Y.Etale} (hW : CategoryTheory.Limits.IsTerminal W),
        (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hW).unit.app A =
          (η_sh.app (K.obj A)).app (Opposite.op W) := by
      intro W hW
      dsimp [CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
      rfl
    rw [h_u hT', h_u hT]
    have hnat := (η_sh.app (K.obj A)).naturality (hT'.from T).op
    dsimp [K] at hnat
    rw [CategoryTheory.Category.id_comp] at hnat
    exact hnat.symm

  have hHomEquivCoh : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      {T T' : Y.Etale} (hT : CategoryTheory.Limits.IsTerminal T)
      (hT' : CategoryTheory.Limits.IsTerminal T') (A : AddCommGrpCat.{u})
      (G : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
      (φ : (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj A ⟶ G),
      ((CategoryTheory.constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT').homEquiv
          A G φ) ≫
        G.obj.map (hT'.from T).op =
      (CategoryTheory.constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT).homEquiv
        A G φ := by
    intro Y T T' hT hT' A G φ
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
    change (_ ≫ φ.hom.app (Opposite.op T')) ≫ G.obj.map (hT'.from T).op =
      _ ≫ φ.hom.app (Opposite.op T)
    rw [CategoryTheory.Category.assoc, ← φ.hom.naturality (hT'.from T).op,
      ← CategoryTheory.Category.assoc, hUnitCoh hT hT' A]

  have hPillar2 : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂)
      [_hc_h : (weilEtaleSitePullback h).IsContinuous
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology]
      [_hr_h : ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology).IsRightAdjoint],
      let pb_h := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology
      let C₁ := CategoryTheory.constantSheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}
      let C₂ := CategoryTheory.constantSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}
      (∀ {T₁ : Y₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
          {T₂ : Y₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
          (A : AddCommGrpCat.{u}),
        CategoryTheory.IsIso (weilEtaleConstPullbackHom h hT₁ hT₂ A)) ∧
      (∀ {T₁ T₁' : Y₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
          (hT₁' : CategoryTheory.Limits.IsTerminal T₁')
          {T₂ T₂' : Y₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
          (hT₂' : CategoryTheory.Limits.IsTerminal T₂')
          (A : AddCommGrpCat.{u}),
        weilEtaleConstPullbackHom h hT₁ hT₂ A =
          weilEtaleConstPullbackHom h hT₁' hT₂' A) ∧
      (∀ {T₁ : Y₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
          {T₂ : Y₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
          {A₁ A₂ : AddCommGrpCat.{u}} (ψ : A₁ ⟶ A₂),
        pb_h.map (C₂.map ψ) ≫ weilEtaleConstPullbackHom h hT₁ hT₂ A₂ =
          weilEtaleConstPullbackHom h hT₁ hT₂ A₁ ≫ C₁.map ψ) := by
    intro Y₁ Y₂ h _hc_h _hr_h pb_h C₁ C₂
    let B := weilEtaleSitePullback h
    let J₁ := Y₁.smallEtaleTopology
    let J₂ := Y₂.smallEtaleTopology
    let pf_h := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let adj_h := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    have hIsoAndNat : ∀ {T₁ : Y₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        {T₂ : Y₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
        (∀ A : AddCommGrpCat.{u},
          CategoryTheory.IsIso (weilEtaleConstPullbackHom h hT₁ hT₂ A)) ∧
        (∀ {A₁ A₂ : AddCommGrpCat.{u}} (ψ : A₁ ⟶ A₂),
          pb_h.map (C₂.map ψ) ≫ weilEtaleConstPullbackHom h hT₁ hT₂ A₂ =
            weilEtaleConstPullbackHom h hT₁ hT₂ A₁ ≫ C₁.map ψ) := by
      intro T₁ hT₁ T₂ hT₂
      obtain ⟨hT_B⟩ := (hPillar1 h).2 T₂ hT₂
      let e_τ : B.obj T₂ ≅ T₁ :=
        CategoryTheory.Limits.IsTerminal.uniqueUpToIso hT_B hT₁
      let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
      have hτ_eq : e_τ.hom = τ := hT₁.hom_ext _ _
      let Γ₁ := (CategoryTheory.sheafSections J₁ AddCommGrpCat.{u}).obj (Opposite.op T₁)
      let Γ₂ := (CategoryTheory.sheafSections J₂ AddCommGrpCat.{u}).obj (Opposite.op T₂)
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      let e_Γ : Γ₁ ≅ pf_h ⋙ Γ₂ :=
        { hom :=
            { app := fun G => G.obj.map τ.op
              naturality := fun _ _ φ => (φ.hom.naturality τ.op).symm }
          inv :=
            { app := fun G => G.obj.map e_τ.inv.op
              naturality := fun _ _ φ => (φ.hom.naturality e_τ.inv.op).symm }
          hom_inv_id := by
            ext G : 2
            change G.obj.map τ.op ≫ G.obj.map e_τ.inv.op = 𝟙 _
            rw [← G.obj.map_comp, ← op_comp, ← hτ_eq, e_τ.inv_hom_id, op_id, G.obj.map_id]
          inv_hom_id := by
            ext G : 2
            change G.obj.map e_τ.inv.op ≫ G.obj.map τ.op = 𝟙 _
            rw [← G.obj.map_comp, ← op_comp, ← hτ_eq, e_τ.hom_inv_id, op_id, G.obj.map_id] }
      let adj_comp : C₂ ⋙ pb_h ⊣ pf_h ⋙ Γ₂ := adj₂.comp adj_h
      let adj₁' : C₁ ⊣ pf_h ⋙ Γ₂ := adj₁.ofNatIsoRight e_Γ
      let iso_L : C₂ ⋙ pb_h ≅ C₁ := adj_comp.leftAdjointUniq adj₁'
      have heq : ∀ A : AddCommGrpCat.{u},
          weilEtaleConstPullbackHom h hT₁ hT₂ A = iso_L.hom.app A := by
        intro A
        apply (adj_comp.homEquiv A (C₁.obj A)).injective
        have hR : (adj_comp.homEquiv A (C₁.obj A)) (iso_L.hom.app A) =
            adj₁.unit.app A ≫ (C₁.obj A).obj.map τ.op := by
          rw [CategoryTheory.Adjunction.homEquiv_unit]
          exact CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app adj_comp adj₁' A
        have hL : (adj_comp.homEquiv A (C₁.obj A)) (weilEtaleConstPullbackHom h hT₁ hT₂ A) =
            adj₁.unit.app A ≫ (C₁.obj A).obj.map τ.op := by
          change (adj₂.homEquiv A (pf_h.obj (C₁.obj A)))
              ((adj_h.homEquiv (C₂.obj A) (C₁.obj A))
                (weilEtaleConstPullbackHom h hT₁ hT₂ A)) = _
          dsimp [weilEtaleConstPullbackHom]
          rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
          rfl
        exact hL.trans hR.symm
      refine ⟨fun A => ?_, fun {A₁ A₂} ψ => ?_⟩
      · rw [heq A]
        exact (iso_L.app A).isIso_hom
      · rw [heq A₂, heq A₁]
        exact iso_L.hom.naturality ψ
    refine ⟨fun {_} hT₁ {_} hT₂ A => (hIsoAndNat hT₁ hT₂).1 A, ?_,
      fun {_} hT₁ {_} hT₂ {_ _} ψ => (hIsoAndNat hT₁ hT₂).2 ψ⟩
    intro T₁ T₁' hT₁ hT₁' T₂ T₂' hT₂ hT₂' A
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₁' := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁'
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let adj₂' := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂'
    let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
    let τ' : B.obj T₂' ⟶ T₁' := hT₁'.from (B.obj T₂')
    let u₁ : T₁ ⟶ T₁' := hT₁'.from T₁
    let u₂ : T₂ ⟶ T₂' := hT₂'.from T₂
    apply (adj_h.homEquiv (C₂.obj A) (C₁.obj A)).injective
    apply (adj₂.homEquiv A (pf_h.obj (C₁.obj A))).injective
    have hLHS : (adj₂.homEquiv A (pf_h.obj (C₁.obj A)))
        ((adj_h.homEquiv (C₂.obj A) (C₁.obj A))
          (weilEtaleConstPullbackHom h hT₁ hT₂ A)) =
        adj₁.unit.app A ≫ (C₁.obj A).obj.map τ.op := by
      dsimp [weilEtaleConstPullbackHom]
      rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
      rfl
    have hRHS : (adj₂.homEquiv A (pf_h.obj (C₁.obj A)))
        ((adj_h.homEquiv (C₂.obj A) (C₁.obj A))
          (weilEtaleConstPullbackHom h hT₁' hT₂' A)) =
        adj₁.unit.app A ≫ (C₁.obj A).obj.map τ.op := by
      rw [← hHomEquivCoh hT₂ hT₂' A (pf_h.obj (C₁.obj A))]
      have h_inner : (adj₂'.homEquiv A (pf_h.obj (C₁.obj A)))
          ((adj_h.homEquiv (C₂.obj A) (C₁.obj A))
            (weilEtaleConstPullbackHom h hT₁' hT₂' A)) =
          adj₁'.unit.app A ≫ (C₁.obj A).obj.map τ'.op := by
        dsimp [weilEtaleConstPullbackHom]
        rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        rfl
      rw [h_inner]
      change (adj₁'.unit.app A ≫ (C₁.obj A).obj.map τ'.op) ≫
          (C₁.obj A).obj.map (B.map u₂).op = _
      have hcomm_T : B.map u₂ ≫ τ' = τ ≫ u₁ := hT₁'.hom_ext _ _
      rw [CategoryTheory.Category.assoc, ← (C₁.obj A).obj.map_comp, ← op_comp,
        hcomm_T, op_comp, (C₁.obj A).obj.map_comp, ← CategoryTheory.Category.assoc]
      exact congrArg (· ≫ (C₁.obj A).obj.map τ.op) (hUnitCoh hT₁ hT₁' A)
    exact hLHS.trans hRHS.symm

  
  have hPillar3 : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S) (q m : ℕ),
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf X 1)) ∧
      m • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf X m) = 0 := by
    intro X S f q m
    let AM : ℕ → AddCommGrpCat.{u} :=
      fun n => AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    have hAM_ann : ∀ n : ℕ, n • CategoryTheory.CategoryStruct.id (AM n) = 0 := by
      intro n
      apply AddCommGrpCat.ext
      intro x
      apply ULift.ext
      change (n • x).down = 0
      change n • x.down = 0
      rw [nsmul_eq_mul, CharP.cast_eq_zero (ZMod n) n, zero_mul]
    let C_X := CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}
    have : C_X.Additive := by
      dsimp [C_X, CategoryTheory.constantSheaf]
      infer_instance
    have hSheaf_ann : ∀ n : ℕ,
        n • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf X n) = 0 := by
      intro n
      change n • CategoryTheory.CategoryStruct.id (C_X.obj (AM n)) = 0
      rw [← C_X.map_id, ← C_X.map_nsmul, hAM_ann n, C_X.map_zero]
    refine ⟨?_, hSheaf_ann m⟩
    have hF₁_zero : CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf X 1) = 0 := by
      have h1 := hSheaf_ann 1
      rwa [one_smul] at h1
    have hExtZero : ∀ {A_sh : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        (z : CategoryTheory.Abelian.Ext A_sh (weilEtaleTorsionSheaf X 1) q),
        z = 0 := by
      intro A_sh z
      have hz := (CategoryTheory.Abelian.Ext.comp_mk₀_id z).symm
      rw [hF₁_zero, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero] at hz
      exact hz
    have hCohZero : ∀ (U : Opposite X.Etale),
        CategoryTheory.Limits.IsZero (((weilEtaleTorsionSheaf X 1).cohomologyPresheaf q).obj U) := by
      intro U
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply AddCommGrpCat.ext
      intro z
      exact hExtZero z
    dsimp [weilEtaleHigherDirectImage]
    apply (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map_isZero
    rw [CategoryTheory.Functor.isZero_iff]
    intro W
    exact hCohZero (Opposite.op ((weilEtaleSitePullback f).obj W.unop))

  
  have hPillar4 : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (s : ℕ),
      let AM := fun n : ℕ => AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
      ∃ (μ_s : AM ℓ ⟶ AM (ℓ ^ (s + 1))) (π_s : AM (ℓ ^ (s + 1)) ⟶ AM (ℓ ^ s))
        (h0_s : μ_s ≫ π_s = 0),
        (CategoryTheory.ShortComplex.mk μ_s π_s h0_s).ShortExact := by
    intro ℓ hFact s AM
    have hPrime : Nat.Prime ℓ := hFact.out
    have : NeZero ℓ := ⟨hPrime.ne_zero⟩
    have : NeZero (ℓ ^ s) := ⟨pow_ne_zero s hPrime.ne_zero⟩
    have : NeZero (ℓ ^ (s + 1)) := ⟨pow_ne_zero (s + 1) hPrime.ne_zero⟩
    have hPowPos : 0 < ℓ ^ s := pow_pos hPrime.pos s
    let μ₀ : ZMod ℓ →+ ZMod (ℓ ^ (s + 1)) :=
      { toFun := fun x => ((x.val * ℓ ^ s : ℕ) : ZMod (ℓ ^ (s + 1)))
        map_zero' := by simp
        map_add' := fun a b => by
          have hdiv := Nat.div_add_mod (a.val + b.val) ℓ
          rw [← ZMod.val_add a b] at hdiv
          have hmul : (a + b).val * ℓ ^ s + ((a.val + b.val) / ℓ) * ℓ ^ (s + 1) =
              a.val * ℓ ^ s + b.val * ℓ ^ s := by
            calc
              (a + b).val * ℓ ^ s + ((a.val + b.val) / ℓ) * ℓ ^ (s + 1)
                  = (ℓ * ((a.val + b.val) / ℓ) + (a + b).val) * ℓ ^ s := by ring
              _ = (a.val + b.val) * ℓ ^ s := by rw [hdiv]
              _ = a.val * ℓ ^ s + b.val * ℓ ^ s := by ring
          have hcast := congrArg (Nat.cast : ℕ → ZMod (ℓ ^ (s + 1))) hmul
          rw [Nat.cast_add, Nat.cast_add, Nat.cast_mul ((a.val + b.val) / ℓ),
            CharP.cast_eq_zero (ZMod (ℓ ^ (s + 1))) (ℓ ^ (s + 1)), mul_zero, add_zero] at hcast
          exact hcast }
    let π₀ : ZMod (ℓ ^ (s + 1)) →+ ZMod (ℓ ^ s) :=
      (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ s)) (ZMod (ℓ ^ s))).toAddMonoidHom
    have hcomp0 : ∀ x : ZMod ℓ, π₀ (μ₀ x) = 0 := by
      intro x
      change ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ s)) (ZMod (ℓ ^ s))
        ((x.val * ℓ ^ s : ℕ) : ZMod (ℓ ^ (s + 1))) = 0
      rw [map_natCast, Nat.cast_mul, CharP.cast_eq_zero (ZMod (ℓ ^ s)) (ℓ ^ s), mul_zero]
    have hinj0 : Function.Injective μ₀ := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      have hval := congrArg ZMod.val hx
      rw [ZMod.val_zero] at hval
      change ((x.val * ℓ ^ s : ℕ) : ZMod (ℓ ^ (s + 1))).val = 0 at hval
      rw [ZMod.val_natCast] at hval
      have hlt : x.val * ℓ ^ s < ℓ ^ (s + 1) := by
        calc
          x.val * ℓ ^ s < ℓ * ℓ ^ s := Nat.mul_lt_mul_of_pos_right (ZMod.val_lt x) hPowPos
          _ = ℓ ^ (s + 1) := by ring
      rw [Nat.mod_eq_of_lt hlt] at hval
      have hxval : x.val = 0 := by
        rcases mul_eq_zero.mp hval with h0 | h0
        · exact h0
        · omega
      rw [← ZMod.natCast_zmod_val x, hxval, Nat.cast_zero]
    have hsurj0 : Function.Surjective π₀ :=
      ZMod.castHom_surjective (pow_dvd_pow ℓ (Nat.le_succ s))
    have hexact0 : ∀ y : ZMod (ℓ ^ (s + 1)), π₀ y = 0 → ∃ x : ZMod ℓ, μ₀ x = y := by
      intro y hy
      have hy_cast : ((y.val : ℕ) : ZMod (ℓ ^ s)) = 0 := by
        have hy' : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ s)) (ZMod (ℓ ^ s))
            ((y.val : ℕ) : ZMod (ℓ ^ (s + 1))) = 0 := by
          rwa [ZMod.natCast_zmod_val y]
        rwa [map_natCast] at hy'
      have hmod : y.val % (ℓ ^ s) = 0 := by
        have hv := congrArg ZMod.val hy_cast
        rwa [ZMod.val_natCast, ZMod.val_zero] at hv
      let k : ℕ := y.val / (ℓ ^ s)
      have hk_mul : k * ℓ ^ s = y.val := by
        have hdiv := Nat.div_add_mod y.val (ℓ ^ s)
        rw [hmod, add_zero] at hdiv
        calc
          k * ℓ ^ s = ℓ ^ s * k := Nat.mul_comm _ _
          _ = y.val := hdiv
      have hk_lt : k < ℓ := by
        have hy_lt : k * ℓ ^ s < ℓ * ℓ ^ s := by
          rw [hk_mul]
          calc
            y.val < ℓ ^ (s + 1) := ZMod.val_lt y
            _ = ℓ * ℓ ^ s := by ring
        exact Nat.lt_of_mul_lt_mul_right hy_lt
      refine ⟨(k : ZMod ℓ), ?_⟩
      change (((k : ZMod ℓ).val * ℓ ^ s : ℕ) : ZMod (ℓ ^ (s + 1))) = y
      rw [ZMod.val_natCast, Nat.mod_eq_of_lt hk_lt, hk_mul, ZMod.natCast_zmod_val y]
    let μ_s : AM ℓ ⟶ AM (ℓ ^ (s + 1)) :=
      AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom μ₀)
    let π_s : AM (ℓ ^ (s + 1)) ⟶ AM (ℓ ^ s) :=
      AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom π₀)
    have h0_s : μ_s ≫ π_s = 0 := by
      apply AddCommGrpCat.ext
      intro u_el
      apply ULift.ext
      exact hcomp0 u_el.down
    have hMono_s : CategoryTheory.Mono μ_s := by
      rw [AddCommGrpCat.mono_iff_injective]
      intro u₁ u₂ hu
      apply ULift.ext
      exact hinj0 (congrArg ULift.down hu)
    have hEpi_s : CategoryTheory.Epi π_s := by
      rw [AddCommGrpCat.epi_iff_surjective]
      intro v
      obtain ⟨y, hy⟩ := hsurj0 v.down
      exact ⟨ULift.up y, ULift.ext _ _ hy⟩
    have hEx_s : (CategoryTheory.ShortComplex.mk μ_s π_s h0_s).Exact := by
      rw [CategoryTheory.ShortComplex.ab_exact_iff]
      intro u_el hu_el
      obtain ⟨x, hx⟩ := hexact0 u_el.down (congrArg ULift.down hu_el)
      exact ⟨ULift.up x, ULift.ext _ _ hx⟩
    exact ⟨μ_s, π_s, h0_s, CategoryTheory.ShortComplex.ShortExact.mk' hEx_s hMono_s hEpi_s⟩

  exact ⟨hPillar1, hPillar2, hPillar3, hPillar4⟩

theorem weil_outer_bc_edge_pullback_triangle {X S S' X' : AlgebraicGeometry.Scheme.{u}}
    (f : X ⟶ S) (g : S' ⟶ S) (f' : X' ⟶ S') (g' : X' ⟶ X)
    (hgf : g' ≫ f = f' ≫ g)
    [hc_g : (weilEtaleSitePullback g).IsContinuous S.smallEtaleTopology S'.smallEtaleTopology]
    [hr_g : ((weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology S'.smallEtaleTopology).IsRightAdjoint]
    [hc_g' : (weilEtaleSitePullback g').IsContinuous X.smallEtaleTopology X'.smallEtaleTopology]
    [hr_g' : ((weilEtaleSitePullback g').sheafPushforwardContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology X'.smallEtaleTopology).IsRightAdjoint]
    [hAdd_g' : ((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
      X.smallEtaleTopology X'.smallEtaleTopology).Additive]
    [hLim_g' : CategoryTheory.Limits.PreservesFiniteLimits
      ((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
        X.smallEtaleTopology X'.smallEtaleTopology)]
    [hColim_g' : CategoryTheory.Limits.PreservesFiniteColimits
      ((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
        X.smallEtaleTopology X'.smallEtaleTopology)]
    (m q : ℕ)
    (T_S : S.Etale) (T_S' : S'.Etale) (hT_S' : CategoryTheory.Limits.IsTerminal T_S')
    (hT_Bg : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback g).obj T_S))
    (hT_X : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback f).obj T_S))
    (hT_X' : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback f').obj T_S'))
    {β : weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf X m) ⟶
      ((weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
        S.smallEtaleTopology S'.smallEtaleTopology).obj
          (weilEtaleHigherDirectImage f' q
            (((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
              X.smallEtaleTopology X'.smallEtaleTopology).obj
                (weilEtaleTorsionSheaf X m)))}
    (hβ : WeilIsOuterBCPush f g f' g' hgf (weilEtaleTorsionSheaf X m) q β)
    (ιℤ : ((CategoryTheory.constantSheaf X'.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))) ⟶
      (((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
        X.smallEtaleTopology X'.smallEtaleTopology).obj
        ((CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)))))
    (hπ_ι : weilEtaleConstPullbackHom g' hT_X' hT_X (AddCommGrpCat.of (ULift.{u} ℤ)) ≫ ιℤ = 𝟙 _) :
    let pb_g := (weilEtaleSitePullback g).sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology S'.smallEtaleTopology
    let adj_g := (weilEtaleSitePullback g).sheafAdjunctionContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology S'.smallEtaleTopology
    let pb_g' := (weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
      X.smallEtaleTopology X'.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let Fℤ_X' := (CategoryTheory.constantSheaf X'.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let π_M := weilEtaleConstPullbackHom g' hT_X' hT_X AM
    let R_Sm := weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf X m)
    let R_S'm := weilEtaleHigherDirectImage f' q (weilEtaleTorsionSheaf X' m)
    let bc_hom : pb_g.obj R_Sm ⟶ R_S'm := (adj_g.homEquiv _ _).symm β ≫
      weilEtaleHigherDirectImageMap f' q π_M
    let e_TS' := CategoryTheory.Limits.IsTerminal.uniqueUpToIso hT_Bg hT_S'
    ∀ w : weilEtaleTorsionH X m q,
      let p_can : weilEtaleTorsionH X' m q :=
        (CategoryTheory.Abelian.Ext.mk₀ π_M).postcomp Fℤ_X' (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
            (pb_g'.mapExtAddHom Fℤ_X (weilEtaleTorsionSheaf X m) q w) (Nat.zero_add q))
      ((R_S'm.obj.map e_TS'.inv.op).hom
        ((bc_hom.hom.app (Opposite.op ((weilEtaleSitePullback g).obj T_S))).hom
          (((adj_g.unit.app R_Sm).hom.app (Opposite.op T_S)).hom
            (weilOuterTrFibEdgeHom f T_S hT_X (weilEtaleTorsionSheaf X m) q w)))) =
        weilOuterTrFibEdgeHom f' T_S' hT_X' (weilEtaleTorsionSheaf X' m) q p_can :=
by
  intro pb_g adj_g pb_g' AM Fℤ_X Fℤ_X' π_M R_Sm R_S'm bc_hom e_TS' w p_can
  let R_fun : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Functor Z.Etale
        (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) :=
    fun Z => CategoryTheory.yoneda ⋙
      ((CategoryTheory.Functor.whiskeringRight (Opposite Z.Etale) (Type u)
        AddCommGrpCat.{u}).obj AddCommGrpCat.free ⋙
        CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u})

  
  have hRepEquivEq : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (φ : weilPolyP1CohomologyRepSheaf Z V ⟶ G),
      weilPolyP1CohomologyRepHomEquiv Z V G φ =
        CategoryTheory.yonedaEquiv
          (((AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).comp
            (CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology
              AddCommGrpCat.{u})).homEquiv (CategoryTheory.yoneda.obj V) G φ) := by
    intro Z V G φ
    let adj_free := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
    let adj_sh := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    have hcomp := congrFun (congrFun (adj_free.comp_homEquiv adj_sh)
      (CategoryTheory.yoneda.obj V)) G
    exact congrArg CategoryTheory.yonedaEquiv (Equiv.congr_fun hcomp.symm φ)

  have hRepRight : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : weilPolyP1CohomologyRepSheaf Z V ⟶ G₁) (α : G₁ ⟶ G₂),
      weilPolyP1CohomologyRepHomEquiv Z V G₂ (φ ≫ α) =
        (α.hom.app (Opposite.op V)).hom (weilPolyP1CohomologyRepHomEquiv Z V G₁ φ) := by
    intro Z V G₁ G₂ φ α
    let adj_tot := (AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).comp
      (CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u})
    rw [hRepEquivEq Z V G₂ (φ ≫ α), hRepEquivEq Z V G₁ φ,
      adj_tot.homEquiv_naturality_right φ α, CategoryTheory.yonedaEquiv_comp]
    rfl

  have hRepApp : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      {G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (α : weilPolyP1CohomologyRepSheaf Z V ⟶ G),
      weilPolyP1CohomologyRepHomEquiv Z V G α =
        (α.hom.app (Opposite.op V)).hom
          (weilPolyP1CohomologyRepHomEquiv Z V (weilPolyP1CohomologyRepSheaf Z V) (𝟙 _)) := by
    intro Z V G α
    simpa only [CategoryTheory.Category.id_comp] using hRepRight Z V (𝟙 _) α

  have hRepLeft : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {V₁ V₂ : Z.Etale} (u : V₁ ⟶ V₂)
      {G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : (R_fun Z).obj V₂ ⟶ G),
      weilPolyP1CohomologyRepHomEquiv Z V₁ G ((R_fun Z).map u ≫ φ) =
        (G.obj.map u.op).hom (weilPolyP1CohomologyRepHomEquiv Z V₂ G φ) := by
    intro Z V₁ V₂ u G φ
    let adj_tot := (AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).comp
      (CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u})
    let L_Z := (CategoryTheory.Functor.whiskeringRight (Opposite Z.Etale) (Type u)
        AddCommGrpCat.{u}).obj AddCommGrpCat.free ⋙
      CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}
    change weilPolyP1CohomologyRepHomEquiv Z V₁ G
      (L_Z.map (CategoryTheory.yoneda.map u) ≫ φ) = _
    rw [hRepEquivEq Z V₁ G _, hRepEquivEq Z V₂ G φ,
      adj_tot.homEquiv_naturality_left (CategoryTheory.yoneda.map u) φ,
      ← CategoryTheory.yonedaEquiv_naturality]
    rfl

  
  have hRepToConstComm :
      ∀ {T_X : X.Etale} (hT_X₀ : CategoryTheory.Limits.IsTerminal T_X)
        {T_X' : X'.Etale} (hT_X'₀ : CategoryTheory.Limits.IsTerminal T_X')
        (U_mid : X'.Etale) (v' : T_X' ⟶ U_mid)
        (u_mid : U_mid ⟶ (weilEtaleSitePullback g').obj T_X),
        (R_fun X').map v' ≫
          weilPolyP1CohomologyRepPullHom g' T_X U_mid u_mid ≫
          pb_g'.map (weilPolyP1CohomologyRepToConst X T_X hT_X₀) ≫
          weilEtaleConstPullbackHom g' hT_X'₀ hT_X₀ (AddCommGrpCat.of (ULift.{u} ℤ)) =
        weilPolyP1CohomologyRepToConst X' T_X' hT_X'₀ := by
    intro T_X hT_X₀ T_X' hT_X'₀ U_mid v' u_mid
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let R_TX := weilPolyP1CohomologyRepSheaf X T_X
    let r_X := weilPolyP1CohomologyRepToConst X T_X hT_X₀
    let r_X' := weilPolyP1CohomologyRepToConst X' T_X' hT_X'₀
    let ρ := weilPolyP1CohomologyRepPullHom g' T_X U_mid u_mid
    let π_ℤ := weilEtaleConstPullbackHom g' hT_X'₀ hT_X₀ Aℤ
    let ψ_tail := pb_g'.map r_X ≫ π_ℤ
    let pf_g' := (weilEtaleSitePullback g').sheafPushforwardContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology X'.smallEtaleTopology
    let adj_g' := (weilEtaleSitePullback g').sheafAdjunctionContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology X'.smallEtaleTopology
    let adj_X := CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u} hT_X₀
    let adj_X' := CategoryTheory.constantSheafAdj X'.smallEtaleTopology AddCommGrpCat.{u} hT_X'₀
    let ι_TX := weilPolyP1CohomologyRepHomEquiv X T_X R_TX (𝟙 R_TX)
    let s_pull := ((adj_g'.unit.app R_TX).hom.app (Opposite.op T_X)).hom ι_TX
    let τ : (weilEtaleSitePullback g').obj T_X ⟶ T_X' :=
      hT_X'₀.from ((weilEtaleSitePullback g').obj T_X)
    apply (weilPolyP1CohomologyRepHomEquiv X' T_X' Fℤ_X').injective
    have hRHS : weilPolyP1CohomologyRepHomEquiv X' T_X' Fℤ_X' r_X' =
        (adj_X'.unit.app Aℤ).hom (ULift.up (1 : ℤ)) :=
      Equiv.apply_symm_apply _ _
    have hr_X_app : (r_X.hom.app (Opposite.op T_X)).hom ι_TX =
        (adj_X.unit.app Aℤ).hom (ULift.up (1 : ℤ)) :=
      (hRepApp X T_X r_X).symm.trans (Equiv.apply_symm_apply _ _)
    have hρ_app : weilPolyP1CohomologyRepHomEquiv X' U_mid (pb_g'.obj R_TX) ρ =
        ((pb_g'.obj R_TX).obj.map u_mid.op).hom s_pull :=
      Equiv.apply_symm_apply _ _
    have hNat_u : (ψ_tail.hom.app (Opposite.op U_mid)).hom
          (((pb_g'.obj R_TX).obj.map u_mid.op).hom s_pull) =
        (Fℤ_X'.obj.map u_mid.op).hom
          ((ψ_tail.hom.app (Opposite.op ((weilEtaleSitePullback g').obj T_X))).hom s_pull) :=
      congrArg (fun m => m.hom s_pull) (ψ_tail.hom.naturality u_mid.op)
    have hNat_unit : ((pb_g'.map r_X).hom.app
          (Opposite.op ((weilEtaleSitePullback g').obj T_X))).hom s_pull =
        ((adj_g'.unit.app Fℤ_X).hom.app (Opposite.op T_X)).hom
          ((adj_X.unit.app Aℤ).hom (ULift.up (1 : ℤ))) := by
      have h1 := congrArg
        (fun φ : R_TX ⟶ pf_g'.obj (pb_g'.obj Fℤ_X) => (φ.hom.app (Opposite.op T_X)).hom ι_TX)
        (adj_g'.unit.naturality r_X).symm
      exact h1.trans (congrArg _ hr_X_app)
    have hπ1 : adj_g'.unit.app Fℤ_X ≫ pf_g'.map π_ℤ =
        (adj_X.homEquiv Aℤ (pf_g'.obj Fℤ_X')).symm
          (adj_X'.unit.app Aℤ ≫ Fℤ_X'.obj.map τ.op) :=
      (adj_g'.homEquiv_unit Fℤ_X Fℤ_X' π_ℤ).symm.trans (Equiv.apply_symm_apply _ _)
    have hπ2 : adj_X.unit.app Aℤ ≫
          (adj_g'.unit.app Fℤ_X ≫ pf_g'.map π_ℤ).hom.app (Opposite.op T_X) =
        adj_X'.unit.app Aℤ ≫ Fℤ_X'.obj.map τ.op :=
      (adj_X.homEquiv_unit Aℤ (pf_g'.obj Fℤ_X')
        (adj_g'.unit.app Fℤ_X ≫ pf_g'.map π_ℤ)).symm.trans
        ((congrArg (adj_X.homEquiv Aℤ (pf_g'.obj Fℤ_X')) hπ1).trans
          (Equiv.apply_symm_apply _ _))
    have hπ_eval : (π_ℤ.hom.app (Opposite.op ((weilEtaleSitePullback g').obj T_X))).hom
          (((adj_g'.unit.app Fℤ_X).hom.app (Opposite.op T_X)).hom
            ((adj_X.unit.app Aℤ).hom (ULift.up (1 : ℤ)))) =
        (Fℤ_X'.obj.map τ.op).hom ((adj_X'.unit.app Aℤ).hom (ULift.up (1 : ℤ))) :=
      congrArg (fun m => m.hom (ULift.up (1 : ℤ))) hπ2
    have hψ_eval : (ψ_tail.hom.app
          (Opposite.op ((weilEtaleSitePullback g').obj T_X))).hom s_pull =
        (Fℤ_X'.obj.map τ.op).hom ((adj_X'.unit.app Aℤ).hom (ULift.up (1 : ℤ))) := by
      change (π_ℤ.hom.app (Opposite.op ((weilEtaleSitePullback g').obj T_X))).hom
        (((pb_g'.map r_X).hom.app (Opposite.op ((weilEtaleSitePullback g').obj T_X))).hom s_pull) = _
      rw [hNat_unit, hπ_eval]
    have hTermId : (v' ≫ u_mid) ≫ τ = 𝟙 T_X' := hT_X'₀.hom_ext _ _
    change weilPolyP1CohomologyRepHomEquiv X' T_X' Fℤ_X'
      ((R_fun X').map v' ≫ (ρ ≫ ψ_tail)) =
      weilPolyP1CohomologyRepHomEquiv X' T_X' Fℤ_X' r_X'
    rw [hRepLeft X' v' (ρ ≫ ψ_tail), hRepRight X' U_mid ρ ψ_tail, hρ_app, hNat_u, hψ_eval, hRHS]
    change (Fℤ_X'.obj.map τ.op ≫ Fℤ_X'.obj.map u_mid.op ≫ Fℤ_X'.obj.map v'.op).hom
      ((adj_X'.unit.app Aℤ).hom (ULift.up (1 : ℤ))) = _
    rw [← Fℤ_X'.obj.map_comp, ← Fℤ_X'.obj.map_comp, ← op_comp, ← op_comp,
      hTermId, op_id, Fℤ_X'.obj.map_id]
    rfl

  
  have hExtPrePost : ∀ {A₀ A₁ A₂ B₀ B₁ : CategoryTheory.Sheaf X'.smallEtaleTopology AddCommGrpCat.{u}}
      (a : A₀ ⟶ A₁) (b : A₁ ⟶ A₂)
      (z : CategoryTheory.Abelian.Ext A₂ B₀ q) (c : B₀ ⟶ B₁),
      (CategoryTheory.Abelian.Ext.mk₀ a).comp
        (((CategoryTheory.Abelian.Ext.mk₀ b).comp z (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ c) (Nat.add_zero q))
        (Nat.zero_add q) =
      ((CategoryTheory.Abelian.Ext.mk₀ (a ≫ b)).comp z (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ c) (Nat.add_zero q) := by
    intro A₀ A₁ A₂ B₀ B₁ a b z c
    rw [← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
          (CategoryTheory.Abelian.Ext.mk₀ a)
          ((CategoryTheory.Abelian.Ext.mk₀ b).comp z (Nat.zero_add q))
          (CategoryTheory.Abelian.Ext.mk₀ c) (Nat.zero_add q),
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
          (CategoryTheory.Abelian.Ext.mk₀ a)
          (CategoryTheory.Abelian.Ext.mk₀ b) z,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]

  
  let B_f := weilEtaleSitePullback f
  let B_g := weilEtaleSitePullback g
  let B_f' := weilEtaleSitePullback f'
  let pf_g := B_g.sheafPushforwardContinuous AddCommGrpCat.{u}
    S.smallEtaleTopology S'.smallEtaleTopology
  let F_X := weilEtaleTorsionSheaf X m
  let F_X' := weilEtaleTorsionSheaf X' m
  let R_pull := weilEtaleHigherDirectImage f' q (pb_g'.obj F_X)
  let P_X := B_f.op ⋙ F_X.cohomologyPresheaf q
  let P'_pull := B_f'.op ⋙ (pb_g'.obj F_X).cohomologyPresheaf q
  let P'_X' := B_f'.op ⋙ F_X'.cohomologyPresheaf q
  let η_S := (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit
  let η_S' := (CategoryTheory.sheafificationAdjunction S'.smallEtaleTopology AddCommGrpCat.{u}).unit
  let r_X := weilPolyP1CohomologyRepToConst X (B_f.obj T_S) hT_X
  let r_X' := weilPolyP1CohomologyRepToConst X' (B_f'.obj T_S') hT_X'
  let s₀ : ↑((F_X.cohomologyPresheaf q).obj (Opposite.op (B_f.obj T_S))) :=
    weilPolyP1CohomologyTermToPresheaf X (B_f.obj T_S) hT_X F_X q w
  set u_mid : B_f'.obj (B_g.obj T_S) ⟶ (weilEtaleSitePullback g').obj (B_f.obj T_S) :=
    (weilOuterBCFunIso f g f' g' hgf).inv.app T_S
  let ρ_TS := weilPolyP1CohomologyRepPullHom g' (B_f.obj T_S) (B_f'.obj (B_g.obj T_S)) u_mid
  let s₁ : CategoryTheory.Abelian.Ext
      (weilPolyP1CohomologyRepSheaf X' (B_f'.obj (B_g.obj T_S))) (pb_g'.obj F_X) q :=
    (CategoryTheory.Abelian.Ext.mk₀ ρ_TS).comp
      (pb_g'.mapExtAddHom (weilPolyP1CohomologyRepSheaf X (B_f.obj T_S)) F_X q s₀)
      (Nat.zero_add q)
  let v' : B_f'.obj T_S' ⟶ B_f'.obj (B_g.obj T_S) := B_f'.map e_TS'.inv

  
  have hAdjG : adj_g.unit.app R_Sm ≫ pf_g.map bc_hom =
      β ≫ pf_g.map (weilEtaleHigherDirectImageMap f' q π_M) := by
    rw [← adj_g.homEquiv_unit R_Sm R_S'm bc_hom]
    dsimp only [bc_hom]
    rw [adj_g.homEquiv_naturality_right, Equiv.apply_symm_apply]

  have hStep1 : (bc_hom.hom.app (Opposite.op (B_g.obj T_S))).hom
        (((adj_g.unit.app R_Sm).hom.app (Opposite.op T_S)).hom
          (weilOuterTrFibEdgeHom f T_S hT_X F_X q w)) =
      ((weilEtaleHigherDirectImageMap f' q π_M).hom.app (Opposite.op (B_g.obj T_S))).hom
        ((β.hom.app (Opposite.op T_S)).hom
          (((η_S.app P_X).app (Opposite.op T_S)).hom s₀)) :=
    congrArg
      (fun φ : R_Sm ⟶ pf_g.obj R_S'm =>
        (φ.hom.app (Opposite.op T_S)).hom (((η_S.app P_X).app (Opposite.op T_S)).hom s₀))
      hAdjG

  
  have hStep2 : (β.hom.app (Opposite.op T_S)).hom
        (((η_S.app P_X).app (Opposite.op T_S)).hom s₀) =
      ((η_S'.app P'_pull).app (Opposite.op (B_g.obj T_S))).hom s₁ :=
    congrArg (fun m => m.hom s₀) (hβ T_S)

  
  let Φ_π : P'_pull ⟶ P'_X' :=
    CategoryTheory.Functor.whiskerLeft B_f'.op
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X'.smallEtaleTopology q).map π_M)
  have hStep3 : ((weilEtaleHigherDirectImageMap f' q π_M).hom.app (Opposite.op (B_g.obj T_S))).hom
        (((η_S'.app P'_pull).app (Opposite.op (B_g.obj T_S))).hom s₁) =
      ((η_S'.app P'_X').app (Opposite.op (B_g.obj T_S))).hom
        (s₁.comp (CategoryTheory.Abelian.Ext.mk₀ π_M) (Nat.add_zero q)) := by
    have hNat := congrArg
      (fun ψ : P'_pull ⟶ R_S'm.obj => (ψ.app (Opposite.op (B_g.obj T_S))).hom s₁)
      (η_S'.naturality Φ_π).symm
    have hMap : (Φ_π.app (Opposite.op (B_g.obj T_S))) =
        (CategoryTheory.Abelian.extFunctorObj
          (weilPolyP1CohomologyRepSheaf X' (B_f'.obj (B_g.obj T_S))) q).map π_M := rfl
    have hEval : (Φ_π.app (Opposite.op (B_g.obj T_S))).hom s₁ =
        s₁.comp (CategoryTheory.Abelian.Ext.mk₀ π_M) (Nat.add_zero q) := by
      rw [hMap, CategoryTheory.Abelian.extFunctorObj_map]
      rfl
    exact hNat.trans
      (congrArg (((η_S'.app P'_X').app (Opposite.op (B_g.obj T_S))).hom) hEval)

  
  let s₂ : CategoryTheory.Abelian.Ext
      (weilPolyP1CohomologyRepSheaf X' (B_f'.obj (B_g.obj T_S))) F_X' q :=
    s₁.comp (CategoryTheory.Abelian.Ext.mk₀ π_M) (Nat.add_zero q)
  have hStep4 : (R_S'm.obj.map e_TS'.inv.op).hom
        (((η_S'.app P'_X').app (Opposite.op (B_g.obj T_S))).hom s₂) =
      ((η_S'.app P'_X').app (Opposite.op T_S')).hom
        ((CategoryTheory.Abelian.Ext.mk₀ ((R_fun X').map v')).comp s₂ (Nat.zero_add q)) := by
    have hNat := congrArg
      (fun m => m.hom s₂)
      ((η_S'.app P'_X').naturality e_TS'.inv.op).symm
    have hMap : P'_X'.map e_TS'.inv.op =
        ((CategoryTheory.Abelian.extFunctor q).map ((R_fun X').op.map v'.op)).app F_X' := rfl
    have hEval : (P'_X'.map e_TS'.inv.op).hom s₂ =
        (CategoryTheory.Abelian.Ext.mk₀ ((R_fun X').map v')).comp s₂ (Nat.zero_add q) := by
      rw [hMap, CategoryTheory.Abelian.extFunctor_map_app q ((R_fun X').op.map v'.op) F_X']
      rfl
    exact hNat.trans
      (congrArg (((η_S'.app P'_X').app (Opposite.op T_S')).hom) hEval)

  
  have hDeg0_π : ((R_fun X').map v' ≫ ρ_TS ≫ pb_g'.map r_X) ≫
        weilEtaleConstPullbackHom g' hT_X' hT_X (AddCommGrpCat.of (ULift.{u} ℤ)) =
      r_X' := by
    simpa only [CategoryTheory.Category.assoc] using
      hRepToConstComm hT_X hT_X' (B_f'.obj (B_g.obj T_S)) v' u_mid
  have hDeg0 : (R_fun X').map v' ≫ ρ_TS ≫ pb_g'.map r_X = r_X' ≫ ιℤ := by
    calc
      (R_fun X').map v' ≫ ρ_TS ≫ pb_g'.map r_X
          = ((R_fun X').map v' ≫ ρ_TS ≫ pb_g'.map r_X) ≫
              (weilEtaleConstPullbackHom g' hT_X' hT_X (AddCommGrpCat.of (ULift.{u} ℤ)) ≫ ιℤ) := by
            rw [hπ_ι, CategoryTheory.Category.comp_id]
      _ = (((R_fun X').map v' ≫ ρ_TS ≫ pb_g'.map r_X) ≫
            weilEtaleConstPullbackHom g' hT_X' hT_X (AddCommGrpCat.of (ULift.{u} ℤ))) ≫ ιℤ := by
            simp only [CategoryTheory.Category.assoc]
      _ = r_X' ≫ ιℤ := by
            rw [hDeg0_π]

  have hMapExt_s₀ : pb_g'.mapExtAddHom (weilPolyP1CohomologyRepSheaf X (B_f.obj T_S)) F_X q s₀ =
      (CategoryTheory.Abelian.Ext.mk₀ (pb_g'.map r_X)).comp
        (pb_g'.mapExtAddHom Fℤ_X F_X q w) (Nat.zero_add q) := by
    change pb_g'.mapExtAddHom (weilPolyP1CohomologyRepSheaf X (B_f.obj T_S)) F_X q
      ((CategoryTheory.Abelian.Ext.mk₀ r_X).comp w (Nat.zero_add q)) = _
    rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]

  have hs₁_eq : s₁ =
      (CategoryTheory.Abelian.Ext.mk₀ (ρ_TS ≫ pb_g'.map r_X)).comp
        (pb_g'.mapExtAddHom Fℤ_X F_X q w) (Nat.zero_add q) := by
    dsimp only [s₁]
    rw [hMapExt_s₀, ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
      (CategoryTheory.Abelian.Ext.mk₀ ρ_TS)
      (CategoryTheory.Abelian.Ext.mk₀ (pb_g'.map r_X)) _,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]

  have hExtEq :
      (CategoryTheory.Abelian.Ext.mk₀ ((R_fun X').map v')).comp s₂ (Nat.zero_add q) =
      weilPolyP1CohomologyTermToPresheaf X' (B_f'.obj T_S') hT_X' F_X' q p_can := by
    dsimp only [s₂]
    rw [hs₁_eq, hExtPrePost ((R_fun X').map v') (ρ_TS ≫ pb_g'.map r_X) _ π_M, hDeg0]
    exact (hExtPrePost r_X' ιℤ (pb_g'.mapExtAddHom Fℤ_X F_X q w) π_M).symm

  rw [hStep1, hStep2, hStep3]
  exact hStep4.trans (congrArg (((η_S'.app P'_X').app (Opposite.op T_S')).hom) hExtEq)

theorem weil_outer_tr_fib_prime_power_beck_chevalley_and_edge_pullback (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {X S S' X' : AlgebraicGeometry.Scheme.{u}}
    (f : X ⟶ S) (g : S' ⟶ S) (f' : X' ⟶ S') (g' : X' ⟶ X)
    [_hc_g : (weilEtaleSitePullback g).IsContinuous S.smallEtaleTopology S'.smallEtaleTopology]
    [_hr_g : ((weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology S'.smallEtaleTopology).IsRightAdjoint]
    (hpb : CategoryTheory.IsPullback g' f' f g)
    (hPBC_f : WeilCanonicalModPrimePBC ℓ f)
    (r q : ℕ) :
    let pb_g := (weilEtaleSitePullback g).sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology S'.smallEtaleTopology
    let adj_g := (weilEtaleSitePullback g).sheafAdjunctionContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology S'.smallEtaleTopology
    let R_S := weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf X (ℓ ^ r))
    let R_S' := weilEtaleHigherDirectImage f' q (weilEtaleTorsionSheaf X' (ℓ ^ r))
    ∃ bcIso : pb_g.obj R_S ≅ R_S',
      ∀ (T_S : S.Etale) (_hT_S : CategoryTheory.Limits.IsTerminal T_S)
        (T_S' : S'.Etale) (hT_S' : CategoryTheory.Limits.IsTerminal T_S')
        (hT_Bg : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback g).obj T_S))
        (hT_X : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback f).obj T_S))
