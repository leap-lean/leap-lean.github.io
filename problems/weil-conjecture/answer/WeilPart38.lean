        p_map.hom (η_eval.hom ((adj_U.unit.app A).hom a)) = (adj_k.unit.app A).hom a := by
      intro a
      exact congrArg (fun m : A ⟶ (pf_y.obj (C_k.obj A)).obj.obj (Opposite.op T_U) => m.hom a) hFac
    refine ⟨?_, ?_⟩
    · intro x₁ x₂ hx
      obtain ⟨a₁, rfl⟩ := hu_U_bij.2 x₁
      obtain ⟨a₂, rfl⟩ := hu_U_bij.2 x₂
      have hk_eq : (adj_k.unit.app A).hom a₁ = (adj_k.unit.app A).hom a₂ := by
        rw [← hFac_elem a₁, ← hFac_elem a₂, hx]
      rw [hu_k_bij.1 hk_eq]
    · intro z
      obtain ⟨a, ha⟩ := hu_k_bij.2 (p_map.hom z)
      refine ⟨(adj_U.unit.app A).hom a, ?_⟩
      apply hp_bij.1
      rw [hFac_elem a, ha]

theorem weil_outer_tr_fib_bockstein_global_const_on_base (Z D : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥D] [PreconnectedSpace ↥D]
    (f : Z ⟶ D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (T_D : D.Etale) (hT_D : CategoryTheory.Limits.IsTerminal T_D)
    (hSimpConn : ∀ (𝒢 : CategoryTheory.Sheaf D.smallEtaleTopology AddCommGrpCat.{u})
        (A₀ : AddCommGrpCat.{u}) [Finite ↥A₀],
      (∀ x : ↥D,
        ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ D),
          AlgebraicGeometry.Etale w ∧
          x ∈ Set.range w.base ∧
          WeilIsEtaleSheafPullback w 𝒢
            ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)) →
      Finite ↥(𝒢.obj.obj (Opposite.op T_D)) ∧
      CategoryTheory.IsIso
        ((CategoryTheory.constantSheafAdj D.smallEtaleTopology AddCommGrpCat.{u} hT_D).counit.app 𝒢))
    (hH1_const : ∀ (C₀ : AddCommGrpCat.{u}) [Finite ↥C₀],
      ℓ • CategoryTheory.CategoryStruct.id C₀ = 0 →
      Subsingleton (((CategoryTheory.constantSheaf D.smallEtaleTopology AddCommGrpCat.{u}).obj C₀).H 1))
    (j_deg : ℕ)
    (hLocConst : ∀ q ≤ j_deg,
      ∃ (A₀ : AddCommGrpCat.{u}) (_ : Finite ↥A₀),
        ∀ x : ↥D,
          ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ D),
            AlgebraicGeometry.Etale w ∧
            x ∈ Set.range w.base ∧
            WeilIsEtaleSheafPullback w
              (weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf Z ℓ))
              ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀))
    (hKerConst : ∀ q ≤ j_deg,
      ∀ (B : AddCommGrpCat.{u}) [Finite ↥B]
        (φ : ((CategoryTheory.constantSheaf D.smallEtaleTopology AddCommGrpCat.{u}).obj B) ⟶
          weilEtaleHigherDirectImage f (q + 1) (weilEtaleTorsionSheaf Z ℓ)),
        ∃ (B₀ : AddCommGrpCat.{u}) (_ : Finite ↥B₀),
          Nonempty (((CategoryTheory.constantSheaf D.smallEtaleTopology AddCommGrpCat.{u}).obj B₀) ≅
            CategoryTheory.Limits.kernel φ))
    (r q : ℕ) (hq : q ≤ j_deg) :
    let R_qr := weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf Z (ℓ ^ r))
    let A_qr := R_qr.obj.obj (Opposite.op T_D)
    Finite ↥A_qr ∧
    (ℓ ^ r) • CategoryTheory.CategoryStruct.id A_qr = 0 ∧
    CategoryTheory.IsIso
      ((CategoryTheory.constantSheafAdj D.smallEtaleTopology AddCommGrpCat.{u} hT_D).counit.app R_qr) :=
by
  classical
  intro R_qr A_qr
  let J_D := D.smallEtaleTopology
  let J_Z := Z.smallEtaleTopology
  let C_D := CategoryTheory.constantSheaf J_D AddCommGrpCat.{u}
  let Γ_D := (CategoryTheory.sheafSections J_D AddCommGrpCat.{u}).obj (Opposite.op T_D)
  let adj_D := CategoryTheory.constantSheafAdj J_D AddCommGrpCat.{u} hT_D
  let R : ℕ → ℕ → CategoryTheory.Sheaf J_D AddCommGrpCat.{u} :=
    fun p m => weilEtaleHigherDirectImage f p (weilEtaleTorsionSheaf Z m)
  let A : ℕ → ℕ → AddCommGrpCat.{u} :=
    fun p m => (R p m).obj.obj (Opposite.op T_D)

  have : C_D.Additive := by dsimp [C_D, CategoryTheory.constantSheaf]; infer_instance
  have : CategoryTheory.Limits.PreservesFiniteLimits C_D := by
    dsimp [C_D, CategoryTheory.constantSheaf]; infer_instance
  have : CategoryTheory.Limits.PreservesFiniteColimits C_D := by
    dsimp [C_D, CategoryTheory.constantSheaf]; infer_instance
  have : Γ_D.Additive :=
    (inferInstance : (CategoryTheory.sheafToPresheaf J_D AddCommGrpCat.{u} ⋙
      (CategoryTheory.evaluation (Opposite D.Etale) AddCommGrpCat.{u}).obj
        (Opposite.op T_D)).Additive)
  have : CategoryTheory.Limits.PreservesFiniteLimits Γ_D :=
    (inferInstance : CategoryTheory.Limits.PreservesFiniteLimits
      (CategoryTheory.sheafToPresheaf J_D AddCommGrpCat.{u} ⋙
        (CategoryTheory.evaluation (Opposite D.Etale) AddCommGrpCat.{u}).obj
          (Opposite.op T_D)))
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  
  let T_0 : D.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id D)
  have hT_0 : CategoryTheory.Limits.IsTerminal T_0 := by
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom) trivial) ?_
    intro U m
    apply (AlgebraicGeometry.Scheme.Etale.forget D).map_injective
    apply CategoryTheory.Over.OverMorphism.ext
    exact (CategoryTheory.Category.comp_id m.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w m)
  let e_T : T_D ≅ T_0 := CategoryTheory.Limits.IsTerminal.uniqueUpToIso hT_D hT_0
  let F_sch : D.Etale ⥤ AlgebraicGeometry.Scheme.{u} :=
    AlgebraicGeometry.Scheme.Etale.forget D ⋙ CategoryTheory.Over.forget D
  let e_sch : T_D.left ≅ D := F_sch.mapIso e_T

  have h_mem_etale : ∀ (W : D.Etale) (S : CategoryTheory.Sieve W),
      S ∈ D.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : D.Etale) (u : Y ⟶ W) (y : ↥Y.left),
          S.arrows u ∧ AlgebraicGeometry.Etale u.left ∧ u.left.base y = x := by
    intro W S
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      D (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) D
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W S
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology D.Etale => S ∈ J W) heq)).trans hiff

  have h_mor_etale : ∀ {Y₁ Y₂ : D.Etale} (u : Y₁ ⟶ Y₂), AlgebraicGeometry.Etale u.left := by
    intro Y₁ Y₂ u
    have hw : u.left ≫ Y₂.hom = Y₁.hom := CategoryTheory.MorphismProperty.Over.w u
    have hcomp : AlgebraicGeometry.Etale (u.left ≫ Y₂.hom) := hw.symm ▸ Y₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      u.left Y₂.hom Y₂.prop hcomp

  have hUnitIso : ∀ M : AddCommGrpCat.{u}, CategoryTheory.IsIso (adj_D.unit.app M) := by
    intro M
    let P_M : CategoryTheory.Functor (Opposite D.Etale) AddCommGrpCat.{u} :=
      { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥E.unop.left ↥M)
        map := fun {E₁ E₂} u =>
          AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom (Z := ↥M) u.unop.left.base.hom)
        map_id := fun _ => by apply AddCommGrpCat.ext; intro g; ext x; rfl
        map_comp := fun _ _ => by apply AddCommGrpCat.ext; intro h; ext x; rfl }
    let θ_M : (CategoryTheory.Functor.const (Opposite D.Etale)).obj M ⟶ P_M :=
      { app := fun E =>
          AddCommGrpCat.ofHom (LocallyConstant.constAddMonoidHom (X := ↥E.unop.left) (Y := ↥M))
        naturality := fun _ _ _ => by apply AddCommGrpCat.ext; intro a; ext x; rfl }
    have hP_sheaf : CategoryTheory.Presheaf.IsSheaf J_D P_M := by
      rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
      intro E S hS
      have hcov := (h_mem_etale E S).mp hS
      let eval_c : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_M))
          (w : S.arrows.category) (_ : ↥c.pt), LocallyConstant ↥w.obj.left.left ↥M :=
        fun c w m => (c.π.app (Opposite.op w)).hom m
      have h_ov : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_M))
          (w₁ w₂ : S.arrows.category) (m : ↥c.pt)
          (y₁ : ↥w₁.obj.left.left) (y₂ : ↥w₂.obj.left.left),
          w₁.obj.hom.left.base y₁ = w₂.obj.hom.left.base y₂ →
          eval_c c w₁ m y₁ = eval_c c w₂ m y₂ := by
        intro c w₁ w₂ m y₁ y₂ hy_eq
        let u₁ : w₁.obj.left ⟶ E := w₁.obj.hom
        let u₂ : w₂.obj.left ⟶ E := w₂.obj.hom
        have hu₂_et : AlgebraicGeometry.Etale u₂.left := h_mor_etale u₂
        let Z_sch := CategoryTheory.Limits.pullback u₁.left u₂.left
        let p₁ : Z_sch ⟶ w₁.obj.left.left := CategoryTheory.Limits.pullback.fst u₁.left u₂.left
        let p₂ : Z_sch ⟶ w₂.obj.left.left := CategoryTheory.Limits.pullback.snd u₁.left u₂.left
        have hp₁_et : AlgebraicGeometry.Etale p₁ :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback u₁.left u₂.left).flip hu₂_et
        have hZ_et : AlgebraicGeometry.Etale (p₁ ≫ w₁.obj.left.hom) :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            p₁ w₁.obj.left.hom hp₁_et w₁.obj.left.prop
        let Z_et : D.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ w₁.obj.left.hom) hZ_et
        let q₁ : Z_et ⟶ w₁.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
        have hq₂_w : p₂ ≫ w₂.obj.left.hom = Z_et.hom :=
          (congrArg (p₂ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₂).symm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ E.hom) CategoryTheory.Limits.pullback.condition.symm).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (p₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₁)))))
        let q₂ : Z_et ⟶ w₂.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₂ hq₂_w trivial
        have hq_comm : q₁ ≫ u₁ = q₂ ≫ u₂ := by
          apply (AlgebraicGeometry.Scheme.Etale.forget D).map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact CategoryTheory.Limits.pullback.condition
        let w₁₂ : S.arrows.category :=
          ⟨CategoryTheory.Over.mk (q₁ ≫ u₁), S.downward_closed w₁.property q₁⟩
        let mor₁ : w₁₂ ⟶ w₁ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₁ rfl)
        let mor₂ : w₁₂ ⟶ w₂ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₂ hq_comm.symm)
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy_eq
        have hev₁ : eval_c c w₁ m (p₁.base z) = eval_c c w₁₂ m z :=
          congrArg (fun φ => (φ.hom m : LocallyConstant ↥Z_sch ↥M) z) (c.w mor₁.op)
        have hev₂ : eval_c c w₂ m (p₂.base z) = eval_c c w₁₂ m z :=
          congrArg (fun φ => (φ.hom m : LocallyConstant ↥Z_sch ↥M) z) (c.w mor₂.op)
        rw [← hz₁, ← hz₂, hev₁, hev₂]
      refine ⟨{
        lift := fun c =>
          let g_fn : ↥c.pt → ↥E.left → ↥M := fun m x =>
            let ch := hcov x
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            eval_c c w_x m y_x
          have hg_eq : ∀ (m : ↥c.pt) (w : S.arrows.category) (y : ↥w.obj.left.left),
              g_fn m (w.obj.hom.left.base y) = eval_c c w m y := by
            intro m w y
            let x := w.obj.hom.left.base y
            let ch := hcov x
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            exact h_ov c w_x w m y_x y hy_x
          have hg_lc : ∀ m : ↥c.pt, IsLocallyConstant (g_fn m) := by
            intro m
            rw [IsLocallyConstant.iff_isOpen_fiber]
            intro a
            rw [isOpen_iff_forall_mem_open]
            intro x hx
            let ch := hcov x
            let Y_x := ch.choose
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let hEt_x := ch.choose_spec.choose_spec.choose_spec.2.1
            let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            let f_x : LocallyConstant ↥Y_x.left ↥M := eval_c c w_x m
            let O : Set ↥Y_x.left := f_x ⁻¹' {a}
            have hO_open : IsOpen O := f_x.isLocallyConstant {a}
            have : AlgebraicGeometry.Etale u_x.left := hEt_x
            have hu_open : IsOpen (u_x.left.base '' O) := u_x.left.isOpenMap O hO_open
            refine ⟨u_x.left.base '' O, ?_, hu_open, ⟨y_x, ?_, hy_x⟩⟩
            · rintro _ ⟨y', hy', rfl⟩
              change g_fn m (w_x.obj.hom.left.base y') = a
              rw [hg_eq m w_x y']
              exact hy'
            · change f_x y_x = a
              have hfx : f_x y_x = g_fn m x := rfl
              rw [hfx]
              exact hx
          AddCommGrpCat.ofHom
            { toFun := fun m => ⟨g_fn m, hg_lc m⟩
              map_zero' := by
                apply LocallyConstant.ext; intro x
                let ch := hcov x
                let u_x := ch.choose_spec.choose
                let y_x := ch.choose_spec.choose_spec.choose
                let hu_x := ch.choose_spec.choose_spec.choose_spec.1
                let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
                exact congrArg (fun fn : LocallyConstant ↥w_x.obj.left.left ↥M => fn y_x)
                  (map_zero (c.π.app (Opposite.op w_x)).hom)
              map_add' := fun m₁ m₂ => by
                apply LocallyConstant.ext; intro x
                let ch := hcov x
                let u_x := ch.choose_spec.choose
                let y_x := ch.choose_spec.choose_spec.choose
                let hu_x := ch.choose_spec.choose_spec.choose_spec.1
                let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
                exact congrArg (fun fn : LocallyConstant ↥w_x.obj.left.left ↥M => fn y_x)
                  (map_add (c.π.app (Opposite.op w_x)).hom m₁ m₂) }
        fac := fun c j => by
          apply AddCommGrpCat.ext; intro m
          change _ = eval_c c j.unop m
          ext y
          let x := j.unop.obj.hom.left.base y
          let ch := hcov x
          let u_x := ch.choose_spec.choose
          let y_x := ch.choose_spec.choose_spec.choose
          let hu_x := ch.choose_spec.choose_spec.choose_spec.1
          let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
          let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
          exact h_ov c w_x j.unop m y_x y hy_x
        uniq := fun c k hk => by
          apply AddCommGrpCat.ext; intro m
          let km : LocallyConstant ↥E.left ↥M := k.hom m
          change km = _
          apply LocallyConstant.ext; intro x
          let ch := hcov x
          let u_x := ch.choose_spec.choose
          let y_x := ch.choose_spec.choose_spec.choose
          let hu_x := ch.choose_spec.choose_spec.choose_spec.1
          let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
          let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
          have hkx := congrArg
            (fun φ => (φ.hom m : LocallyConstant ↥w_x.obj.left.left ↥M) y_x)
            (hk (Opposite.op w_x))
          change km (u_x.left.base y_x) = eval_c c w_x m y_x at hkx
          rwa [hy_x] at hkx }⟩
    have hLocInj : CategoryTheory.Presheaf.IsLocallyInjective J_D θ_M := by
      refine CategoryTheory.Presheaf.IsLocallyInjective.mk ?_
      intro E a₁ a₂ ha
      by_cases hEmp : IsEmpty ↥E.unop.left
      · have hbot : ⊥ ∈ J_D E.unop := by
          let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme :=
            @AlgebraicGeometry.Etale
          let E' : P.Over ⊤ D := E.unop
          change (⊥ : CategoryTheory.Sieve E') ∈
            ((CategoryTheory.MorphismProperty.Over.forget P ⊤ D).restrictedTopology
              (AlgebraicGeometry.Scheme.overGrothendieckTopology P D)) E'
          rw [CategoryTheory.Functor.mem_restrictedTopology_iff]
          exact (CategoryTheory.GrothendieckTopology.mem_over_iff _ _).mpr
            (CategoryTheory.GrothendieckTopology.superset_covering _ bot_le
              (AlgebraicGeometry.Scheme.bot_mem_grothendieckTopology E.unop.left))
        exact J_D.superset_covering bot_le hbot
      · obtain ⟨x₀⟩ := not_isEmpty_iff.mp hEmp
        have ha_eq : a₁ = a₂ := congrArg (fun fn : LocallyConstant ↥E.unop.left ↥M => fn x₀) ha
        subst ha_eq
        have htop : CategoryTheory.Presheaf.equalizerSieve
            (F := (CategoryTheory.Functor.const (Opposite D.Etale)).obj M)
            (X := E) a₁ a₁ = ⊤ :=
          CategoryTheory.Sieve.id_mem_iff_eq_top.mp rfl
        rw [htop]
        exact J_D.top_mem E.unop
    have hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective J_D θ_M := by
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk ?_
      intro E g
      refine (h_mem_etale E (CategoryTheory.Presheaf.imageSieve θ_M g)).mpr ?_
      intro x
      let g_lc : LocallyConstant ↥E.left ↥M := g
      let a : ↥M := g_lc x
      let O_a : E.left.Opens := ⟨g_lc ⁻¹' {a}, g_lc.isLocallyConstant {a}⟩
      have hY_et : AlgebraicGeometry.Etale (O_a.ι ≫ E.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          O_a.ι E.hom inferInstance E.prop
      let Y_a : D.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_a.ι ≫ E.hom) hY_et
      let u_a : Y_a ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_a.ι rfl trivial
      refine ⟨Y_a, u_a, ⟨x, rfl⟩, ⟨a, ?_⟩, inferInstance, rfl⟩
      ext y
      exact y.2.symm
    have hW_θ : J_D.W θ_M := (J_D.W_iff_isLocallyBijective θ_M).mpr ⟨hLocInj, hLocSurj⟩
    have hIso_map : CategoryTheory.IsIso
        ((CategoryTheory.presheafToSheaf J_D AddCommGrpCat.{u}).map θ_M) :=
      (J_D.W_iff θ_M).mp hW_θ
    let ℒ_M : CategoryTheory.Sheaf J_D AddCommGrpCat.{u} := ⟨P_M, hP_sheaf⟩
    let adj_sh := CategoryTheory.sheafificationAdjunction J_D AddCommGrpCat.{u}
    let P_const := (CategoryTheory.Functor.const (Opposite D.Etale)).obj M
    let Υ_M : C_D.obj M ⟶ ℒ_M := (adj_sh.homEquiv P_const ℒ_M).symm θ_M
    have hΥ_eq : Υ_M =
        (CategoryTheory.presheafToSheaf J_D AddCommGrpCat.{u}).map θ_M ≫ adj_sh.counit.app ℒ_M :=
      CategoryTheory.Adjunction.homEquiv_counit adj_sh P_const ℒ_M θ_M
    have hIso_counit : CategoryTheory.IsIso (adj_sh.counit.app ℒ_M) := inferInstance
    have : CategoryTheory.IsIso Υ_M := by
      rw [hΥ_eq]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_map hIso_counit
    have : CategoryTheory.IsIso (Γ_D.map Υ_M) := inferInstance
    have h_unit_Υ : adj_sh.unit.app P_const ≫ Υ_M.hom = θ_M := by
      have h1 := (adj_sh.homEquiv P_const ℒ_M).apply_symm_apply θ_M
      rwa [CategoryTheory.Adjunction.homEquiv_unit] at h1
    have h_adjD_comp : adj_D.unit.app M ≫ Γ_D.map Υ_M = θ_M.app (Opposite.op T_D) := by
      have heval := congrArg (fun η => η.app (Opposite.op T_D)) h_unit_Υ
      dsimp [adj_D, CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app]
      have hpresheaf_unit :
          (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_D).unit.app M = 𝟙 M := rfl
      rw [hpresheaf_unit, CategoryTheory.Category.id_comp]
      exact heval
    have h_bij : Function.Bijective ⇑(θ_M.app (Opposite.op T_D)).hom := by
      refine ⟨?_, ?_⟩
      · intro a₁ a₂ ha
        let d₀ : ↥D := Classical.arbitrary ↥D
        let t₀ : ↥T_D.left := e_sch.inv.base d₀
        exact congrArg (fun g : LocallyConstant ↥T_D.left ↥M => g t₀) ha
      · intro g
        let g_D : LocallyConstant ↥D ↥M := g.comap e_sch.inv.base.hom
        have : Nonempty ↥M := ⟨0⟩
        obtain ⟨m, hm⟩ := LocallyConstant.exists_eq_const g_D
        refine ⟨m, ?_⟩
        apply LocallyConstant.ext
        intro y
        have hm_y := congrArg (fun fn : LocallyConstant ↥D ↥M => fn (e_sch.hom.base y)) hm
        have hy_id : e_sch.inv.base (e_sch.hom.base y) = y := by
          have hid := congrArg (fun φ : T_D.left ⟶ T_D.left => φ.base y) e_sch.hom_inv_id
          rwa [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Function.comp_apply,
            AlgebraicGeometry.Scheme.Hom.id_base, TopCat.coe_id, id_eq] at hid
        exact hm_y.symm.trans (congrArg g hy_id)
    have hIso_θ : CategoryTheory.IsIso (θ_M.app (Opposite.op T_D)) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective (θ_M.app (Opposite.op T_D))).mpr h_bij
    rw [← h_adjD_comp] at hIso_θ
    exact @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _
      (adj_D.unit.app M) (Γ_D.map Υ_M) _ hIso_θ

  have hPromote : ∀ (𝒢 : CategoryTheory.Sheaf J_D AddCommGrpCat.{u})
      (B₀ : AddCommGrpCat.{u}) [Finite ↥B₀],
      Nonempty (C_D.obj B₀ ≅ 𝒢) →
      Finite ↥(𝒢.obj.obj (Opposite.op T_D)) ∧ CategoryTheory.IsIso (adj_D.counit.app 𝒢) := by
    intro 𝒢 B₀ _ ⟨e⟩
    have : CategoryTheory.IsIso (adj_D.unit.app B₀) := hUnitIso B₀
    let e_sec : B₀ ≅ Γ_D.obj 𝒢 := (CategoryTheory.asIso (adj_D.unit.app B₀)).trans (Γ_D.mapIso e)
    have hSurj_sec : Function.Surjective e_sec.hom.hom :=
      (AddCommGrpCat.epi_iff_surjective e_sec.hom).mp inferInstance
    have hFin_G : Finite ↥(Γ_D.obj 𝒢) := Finite.of_surjective e_sec.hom.hom hSurj_sec
    have htri : C_D.map (adj_D.unit.app B₀) ≫ adj_D.counit.app (C_D.obj B₀) = 𝟙 (C_D.obj B₀) :=
      adj_D.left_triangle_components B₀
    have hIso_id : CategoryTheory.IsIso (𝟙 (C_D.obj B₀)) := inferInstance
    rw [← htri] at hIso_id
    have : CategoryTheory.IsIso (adj_D.counit.app (C_D.obj B₀)) :=
      @CategoryTheory.IsIso.of_isIso_comp_left _ _ _ _ _
        (C_D.map (adj_D.unit.app B₀)) (adj_D.counit.app (C_D.obj B₀)) _ hIso_id
    have hnat : C_D.map (Γ_D.map e.hom) ≫ adj_D.counit.app 𝒢 =
        adj_D.counit.app (C_D.obj B₀) ≫ e.hom :=
      adj_D.counit.naturality e.hom
    have hIso_rhs : CategoryTheory.IsIso (adj_D.counit.app (C_D.obj B₀) ≫ e.hom) :=
      CategoryTheory.IsIso.comp_isIso
    rw [← hnat] at hIso_rhs
    have hIso_G : CategoryTheory.IsIso (adj_D.counit.app 𝒢) :=
      @CategoryTheory.IsIso.of_isIso_comp_left _ _ _ _ _
        (C_D.map (Γ_D.map e.hom)) (adj_D.counit.app 𝒢) _ hIso_rhs
    exact ⟨hFin_G, hIso_G⟩

  have hCokConst : ∀ (A₁ A₂ : AddCommGrpCat.{u}) (ψ : C_D.obj A₁ ⟶ C_D.obj A₂),
      ∃ α₀ : A₁ ⟶ A₂,
        Nonempty (C_D.obj (CategoryTheory.Limits.cokernel α₀) ≅ CategoryTheory.Limits.cokernel ψ) := by
    intro A₁ A₂ ψ
    have : CategoryTheory.IsIso (adj_D.unit.app A₁) := hUnitIso A₁
    have : CategoryTheory.IsIso (adj_D.unit.app A₂) := hUnitIso A₂
    let u₁ : A₁ ≅ Γ_D.obj (C_D.obj A₁) := CategoryTheory.asIso (adj_D.unit.app A₁)
    let u₂ : A₂ ≅ Γ_D.obj (C_D.obj A₂) := CategoryTheory.asIso (adj_D.unit.app A₂)
    let α₀ : A₁ ⟶ A₂ := u₁.hom ≫ Γ_D.map ψ ≫ u₂.inv
    have hmap_α₀ : C_D.map α₀ = ψ := by
      apply (adj_D.homEquiv A₁ (C_D.obj A₂)).injective
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
      have hnat_u : adj_D.unit.app A₁ ≫ Γ_D.map (C_D.map α₀) = α₀ ≫ adj_D.unit.app A₂ :=
        (adj_D.unit.naturality α₀).symm
      change adj_D.unit.app A₁ ≫ Γ_D.map (C_D.map α₀) = adj_D.unit.app A₁ ≫ Γ_D.map ψ
      rw [hnat_u]
      dsimp [α₀, u₁, u₂]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.comp_id]
    let e_pres : C_D.obj (CategoryTheory.Limits.cokernel α₀) ≅
        CategoryTheory.Limits.cokernel (C_D.map α₀) :=
      CategoryTheory.Limits.PreservesCokernel.iso C_D α₀
    let e_congr : CategoryTheory.Limits.cokernel (C_D.map α₀) ≅ CategoryTheory.Limits.cokernel ψ :=
      CategoryTheory.Limits.cokernel.mapIso (C_D.map α₀) ψ
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (by simp [hmap_α₀])
    exact ⟨α₀, ⟨e_pres.trans e_congr⟩⟩

  have hSubIso : ∀ {X₁ X₂ : CategoryTheory.Sheaf J_D AddCommGrpCat.{u}} (_ : X₁ ≅ X₂),
      Subsingleton (X₂.H 1) → Subsingleton (X₁.H 1) := by
    intro X₁ X₂ e hSub
    refine subsingleton_of_forall_eq 0 ?_
    intro x
    have hx0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero 1) = 0 :=
      @Subsingleton.elim (X₂.H 1) hSub _ 0
    calc
      x = x.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 X₁)) (Nat.add_zero 1) :=
          (CategoryTheory.Abelian.Ext.comp_mk₀_id x).symm
      _ = x.comp (CategoryTheory.Abelian.Ext.mk₀ (e.hom ≫ e.inv)) (Nat.add_zero 1) := by
          rw [e.hom_inv_id]
      _ = x.comp ((CategoryTheory.Abelian.Ext.mk₀ e.hom).comp
            (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero 0)) (Nat.add_zero 1) := by
          rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      _ = (x.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero 1)).comp
            (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero 1) :=
          (CategoryTheory.Abelian.Ext.comp_assoc x _ _
            (Nat.add_zero 1) (Nat.add_zero 0) (Nat.add_zero 1)).symm
      _ = 0 := by rw [hx0, CategoryTheory.Abelian.Ext.zero_comp]

  
  let B_f := weilEtaleSitePullback f
  let W_D : ((Opposite Z.Etale) ⥤ AddCommGrpCat.{u}) ⥤
      ((Opposite D.Etale) ⥤ AddCommGrpCat.{u}) :=
    (CategoryTheory.Functor.whiskeringLeft (Opposite D.Etale) (Opposite Z.Etale)
      AddCommGrpCat.{u}).obj B_f.op
  let Sh_D := CategoryTheory.presheafToSheaf J_D AddCommGrpCat.{u}
  let E_D := W_D.comp Sh_D
  let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite Z.Etale)
    (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
  let Sh_Z := CategoryTheory.presheafToSheaf J_Z AddCommGrpCat.{u}
  let L_tot := Free_PSh ⋙ Sh_Z
  let Z_fun : Z.Etale ⥤ CategoryTheory.Sheaf J_Z AddCommGrpCat.{u} :=
    CategoryTheory.yoneda ⋙ L_tot
  let Z_obj : Opposite Z.Etale → CategoryTheory.Sheaf J_Z AddCommGrpCat.{u} :=
    fun W => Opposite.unop (Z_fun.op.obj W)

  have hMono_R0 : ∀ {F₁ F₂ : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u}}
      (u : F₁ ⟶ F₂) [CategoryTheory.Mono u],
      CategoryTheory.Mono (weilEtaleHigherDirectImageMap f 0 u) := by
    intro F₁ F₂ u _
    let φ_pre := (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z 0).map u
    have : ∀ (W : Opposite Z.Etale), CategoryTheory.Mono (φ_pre.app W) := by
      intro W
      rw [AddCommGrpCat.mono_iff_injective]
      intro α₁ α₂ hα
      have happ : φ_pre.app W = AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ u).postcomp (Z_obj W) (Nat.add_zero 0)) :=
        CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) 0 u
      rw [happ] at hα
      let g₁ : Z_obj W ⟶ F₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
      let g₂ : Z_obj W ⟶ F₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α₂
      have hα₁ : α₁ = CategoryTheory.Abelian.Ext.mk₀ g₁ :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α₁).symm
      have hα₂ : α₂ = CategoryTheory.Abelian.Ext.mk₀ g₂ :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α₂).symm
      change (α₁.comp (CategoryTheory.Abelian.Ext.mk₀ u) (Nat.add_zero 0)) =
          (α₂.comp (CategoryTheory.Abelian.Ext.mk₀ u) (Nat.add_zero 0)) at hα
      rw [hα₁, hα₂, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hα
      have hgu : g₁ ≫ u = g₂ ≫ u := by
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
          ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply] at hα
        exact CategoryTheory.Abelian.Ext.addEquiv₀.symm.injective hα
      have hg_eq : g₁ = g₂ := (CategoryTheory.cancel_mono u).mp hgu
      rw [hα₁, hα₂, hg_eq]
    have : CategoryTheory.Mono φ_pre := CategoryTheory.NatTrans.mono_of_mono_app φ_pre
    have : CategoryTheory.Mono (W_D.map φ_pre) := W_D.map_mono φ_pre
    exact Sh_D.map_mono (W_D.map φ_pre)

  have hPresheafExact : ∀ (K : CategoryTheory.ShortComplex
      (CategoryTheory.Functor (Opposite Z.Etale) AddCommGrpCat.{u})),
      (∀ (W : Opposite Z.Etale),
        (K.map ((CategoryTheory.evaluation (Opposite Z.Etale) AddCommGrpCat.{u}).obj W)).Exact) →
      K.Exact := by
    intro K hW
    rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology,
      CategoryTheory.Functor.isZero_iff]
    intro W
    let evW := (CategoryTheory.evaluation (Opposite Z.Etale) AddCommGrpCat.{u}).obj W
    have hZW : CategoryTheory.Limits.IsZero (K.map evW).leftHomology :=
      (CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology (K.map evW)).mp (hW W)
    exact hZW.of_iso (K.mapLeftHomologyIso evW).symm

  let δ_pre : ∀ {SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_Z AddCommGrpCat.{u})},
      SC.ShortExact → ∀ (p : ℕ),
        SC.X₃.cohomologyPresheaf p ⟶ SC.X₁.cohomologyPresheaf (p + 1) :=
    fun {SC} hSE p =>
      { app := fun W => AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl)
        naturality := by
          intro W₁ W₂ ω
          have hL : (SC.X₃.cohomologyPresheaf p).map ω =
              ((CategoryTheory.Abelian.extFunctor p).map (Z_fun.op.map ω)).app SC.X₃ := rfl
          have hR : (SC.X₁.cohomologyPresheaf (p + 1)).map ω =
              ((CategoryTheory.Abelian.extFunctor (p + 1)).map (Z_fun.op.map ω)).app SC.X₁ := rfl
          rw [hL, hR,
            CategoryTheory.Abelian.extFunctor_map_app p (Z_fun.op.map ω) SC.X₃,
            CategoryTheory.Abelian.extFunctor_map_app (p + 1) (Z_fun.op.map ω) SC.X₁]
          ext α
          exact CategoryTheory.Abelian.Ext.comp_assoc
            (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop) α hSE.extClass
            (Nat.zero_add p) rfl (by omega) }

  let δ_conn : ∀ {SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_Z AddCommGrpCat.{u})},
      SC.ShortExact → ∀ (p : ℕ),
        weilEtaleHigherDirectImage f p SC.X₃ ⟶ weilEtaleHigherDirectImage f (p + 1) SC.X₁ :=
    fun {SC} hSE p => E_D.map (δ_pre hSE p)

  have hLES : ∀ {SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_Z AddCommGrpCat.{u})}
      (hSE : SC.ShortExact) (p : ℕ),
      ∃ (h0_mid : weilEtaleHigherDirectImageMap f p SC.f ≫
            weilEtaleHigherDirectImageMap f p SC.g = 0)
        (h0_left : weilEtaleHigherDirectImageMap f p SC.g ≫ δ_conn hSE p = 0)
        (h0_right : δ_conn hSE p ≫ weilEtaleHigherDirectImageMap f (p + 1) SC.f = 0),
        (CategoryTheory.ShortComplex.mk
          (weilEtaleHigherDirectImageMap f p SC.f)
          (weilEtaleHigherDirectImageMap f p SC.g) h0_mid).Exact ∧
        (CategoryTheory.ShortComplex.mk
          (weilEtaleHigherDirectImageMap f p SC.g) (δ_conn hSE p) h0_left).Exact ∧
        (CategoryTheory.ShortComplex.mk
          (δ_conn hSE p) (weilEtaleHigherDirectImageMap f (p + 1) SC.f) h0_right).Exact := by
    intro SC hSE p
    have hf0_app : ∀ (W : Opposite Z.Etale),
        (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z p).map SC.f).app W) =
          AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero p)) :=
      fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) p SC.f
    have hg_app : ∀ (W : Opposite Z.Etale),
        (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z p).map SC.g).app W) =
          AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero p)) :=
      fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) p SC.g
    have hf_app : ∀ (W : Opposite Z.Etale),
        (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z (p + 1)).map SC.f).app W) =
          AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero (p + 1))) :=
      fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) (p + 1) SC.f
    have hcomp_mid_pre :
        (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z p).map SC.f ≫
          (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z p).map SC.g = 0 := by
      ext W x
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' (Z_obj W) hSE p
      have hz := (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
      rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero,
        hf0_app W, hg_app W]
      exact congrArg (fun φ => φ x) hz
    have hcomp₁_pre :
        (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z p).map SC.g ≫ δ_pre hSE p = 0 := by
      ext W x
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE p (p + 1) rfl
      have hz := (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
      rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hg_app W]
      exact congrArg (fun φ => φ x) hz
    have hcomp₂_pre :
        δ_pre hSE p ≫ (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z (p + 1)).map SC.f = 0 := by
      ext W x
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE p (p + 1) rfl
      have hz := (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
      rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hf_app W]
      exact congrArg (fun φ => φ x) hz
    let M_pre := CategoryTheory.ShortComplex.mk
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z p).map SC.f)
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z p).map SC.g) hcomp_mid_pre
    let A_pre := CategoryTheory.ShortComplex.mk
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z p).map SC.g) (δ_pre hSE p) hcomp₁_pre
    let B_pre := CategoryTheory.ShortComplex.mk
      (δ_pre hSE p) ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z (p + 1)).map SC.f) hcomp₂_pre
    have hM_pre_ex : M_pre.Exact := by
      apply hPresheafExact M_pre
      intro W
      let evW := (CategoryTheory.evaluation (Opposite Z.Etale) AddCommGrpCat.{u}).obj W
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' (Z_obj W) hSE p
      let eW : M_pre.map evW ≅ _ :=
        CategoryTheory.ShortComplex.isoMk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (by dsimp [M_pre, evW]; rw [hf0_app W]; ext x; rfl)
          (by dsimp [M_pre, evW]; rw [hg_app W]; ext x; rfl)
      exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
    have hA_pre_ex : A_pre.Exact := by
      apply hPresheafExact A_pre
      intro W
      let evW := (CategoryTheory.evaluation (Opposite Z.Etale) AddCommGrpCat.{u}).obj W
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE p (p + 1) rfl
      let eW : A_pre.map evW ≅ _ :=
        CategoryTheory.ShortComplex.isoMk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (by dsimp [A_pre, evW]; rw [hg_app W]; ext x; rfl)
          (by dsimp [A_pre, evW, δ_pre]; ext x; rfl)
      exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
    have hB_pre_ex : B_pre.Exact := by
      apply hPresheafExact B_pre
      intro W
      let evW := (CategoryTheory.evaluation (Opposite Z.Etale) AddCommGrpCat.{u}).obj W
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE p (p + 1) rfl
      let eW : B_pre.map evW ≅ _ :=
        CategoryTheory.ShortComplex.isoMk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (by dsimp [B_pre, evW, δ_pre]; ext x; rfl)
          (by dsimp [B_pre, evW]; rw [hf_app W]; ext x; rfl)
      exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
    have h0_mid : weilEtaleHigherDirectImageMap f p SC.f ≫
        weilEtaleHigherDirectImageMap f p SC.g = 0 := by
      change E_D.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z p).map SC.f) ≫
        E_D.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z p).map SC.g) = 0
      rw [← E_D.map_comp, hcomp_mid_pre, E_D.map_zero]
    have h0_left : weilEtaleHigherDirectImageMap f p SC.g ≫ δ_conn hSE p = 0 := by
      change E_D.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z p).map SC.g) ≫
        E_D.map (δ_pre hSE p) = 0
      rw [← E_D.map_comp, hcomp₁_pre, E_D.map_zero]
    have h0_right : δ_conn hSE p ≫ weilEtaleHigherDirectImageMap f (p + 1) SC.f = 0 := by
      change E_D.map (δ_pre hSE p) ≫
        E_D.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z (p + 1)).map SC.f) = 0
      rw [← E_D.map_comp, hcomp₂_pre, E_D.map_zero]
    exact ⟨h0_mid, h0_left, h0_right,
      (hM_pre_ex.map W_D).map Sh_D, (hA_pre_ex.map W_D).map Sh_D, (hB_pre_ex.map W_D).map Sh_D⟩

  have hTorsAnn : ∀ (m p : ℕ),
      m • CategoryTheory.CategoryStruct.id (R p m) = 0 ∧
      m • CategoryTheory.CategoryStruct.id (A p m) = 0 := by
    intro m p
    let C_Z := CategoryTheory.constantSheaf J_Z AddCommGrpCat.{u}
    have : C_Z.Additive := by dsimp [C_Z, CategoryTheory.constantSheaf]; infer_instance
    let AM_m := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    have hAM : m • CategoryTheory.CategoryStruct.id AM_m = 0 := by
      apply AddCommGrpCat.ext
      rintro ⟨x⟩
      change ULift.up (m • x) = ULift.up 0
      simp
    have hFM : m • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Z m) = 0 := by
      change m • CategoryTheory.CategoryStruct.id (C_Z.obj AM_m) = 0
      rw [← C_Z.map_id, ← C_Z.map_nsmul, hAM, C_Z.map_zero]
    let F_coh := CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z p
    have happ_nsmul : ∀ (k : ℕ)
        (η : F_coh.obj (weilEtaleTorsionSheaf Z m) ⟶ F_coh.obj (weilEtaleTorsionSheaf Z m))
        (W : Opposite Z.Etale),
        (k • η).app W = k • (η.app W) := by
      intro k η W
      induction k with
      | zero => simp
      | succ k ih => rw [succ_nsmul, succ_nsmul, CategoryTheory.NatTrans.app_add, ih]
    have hP : m • CategoryTheory.CategoryStruct.id (F_coh.obj (weilEtaleTorsionSheaf Z m)) = 0 := by
      apply CategoryTheory.NatTrans.ext
      funext W
      rw [happ_nsmul, CategoryTheory.NatTrans.app_zero]
      change m • CategoryTheory.CategoryStruct.id
        ((CategoryTheory.Abelian.extFunctorObj (Z_obj W) p).obj (weilEtaleTorsionSheaf Z m)) = 0
      rw [← (CategoryTheory.Abelian.extFunctorObj (Z_obj W) p).map_id,
        ← (CategoryTheory.Abelian.extFunctorObj (Z_obj W) p).map_nsmul,
        hFM, (CategoryTheory.Abelian.extFunctorObj (Z_obj W) p).map_zero]
    have hW_D : m • CategoryTheory.CategoryStruct.id
        (W_D.obj (F_coh.obj (weilEtaleTorsionSheaf Z m))) = 0 := by
      rw [← W_D.map_id, ← W_D.map_nsmul, hP, W_D.map_zero]
    have hR : m • CategoryTheory.CategoryStruct.id (R p m) = 0 := by
      change m • CategoryTheory.CategoryStruct.id
        (Sh_D.obj (W_D.obj (F_coh.obj (weilEtaleTorsionSheaf Z m)))) = 0
      rw [← Sh_D.map_id, ← Sh_D.map_nsmul, hW_D, Sh_D.map_zero]
    have hA : m • CategoryTheory.CategoryStruct.id (A p m) = 0 := by
      change m • CategoryTheory.CategoryStruct.id (Γ_D.obj (R p m)) = 0
      rw [← Γ_D.map_id, ← Γ_D.map_nsmul, hR, Γ_D.map_zero]
    exact ⟨hR, hA⟩

  
  let AM : ℕ → AddCommGrpCat.{u} :=
    fun m => AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  have hBockZMod : ∀ s : ℕ,
      ∃ (u_s : AM ℓ ⟶ AM (ℓ ^ (s + 1))) (v_s : AM (ℓ ^ (s + 1)) ⟶ AM (ℓ ^ s))
        (huv_s : u_s ≫ v_s = 0),
        (CategoryTheory.ShortComplex.mk u_s v_s huv_s).ShortExact := by
    intro s
    have hPrime : Nat.Prime ℓ := Fact.out
    have hℓ_pos : 0 < ℓ := hPrime.pos
    have hpow_pos : 0 < ℓ ^ s := pow_pos hℓ_pos s
    have hpow1_pos : 0 < ℓ ^ (s + 1) := pow_pos hℓ_pos (s + 1)
    have : NeZero ℓ := ⟨hPrime.ne_zero⟩
    have : NeZero (ℓ ^ s) := ⟨hpow_pos.ne'⟩
    have : NeZero (ℓ ^ (s + 1)) := ⟨hpow1_pos.ne'⟩
    let μ₀ : ZMod ℓ →+ ZMod (ℓ ^ (s + 1)) :=
      { toFun := fun x => ((x.val * ℓ ^ s : ℕ) : ZMod (ℓ ^ (s + 1)))
        map_zero' := by simp
        map_add' := fun x y => by
          have hdiv : ℓ * ((x.val + y.val) / ℓ) + (x + y).val = x.val + y.val := by
            rw [ZMod.val_add]
            exact Nat.div_add_mod (x.val + y.val) ℓ
          have hmul : ℓ ^ (s + 1) * ((x.val + y.val) / ℓ) + (x + y).val * ℓ ^ s =
              x.val * ℓ ^ s + y.val * ℓ ^ s := by
            calc
              ℓ ^ (s + 1) * ((x.val + y.val) / ℓ) + (x + y).val * ℓ ^ s
                  = (ℓ * ((x.val + y.val) / ℓ) + (x + y).val) * ℓ ^ s := by rw [pow_succ]; ring
              _ = (x.val + y.val) * ℓ ^ s := by rw [hdiv]
              _ = x.val * ℓ ^ s + y.val * ℓ ^ s := by ring
          have hcast := congrArg (fun n : ℕ => (n : ZMod (ℓ ^ (s + 1)))) hmul
          simp only [Nat.cast_add] at hcast
          rw [Nat.cast_mul (ℓ ^ (s + 1)), ZMod.natCast_self, zero_mul, zero_add] at hcast
          exact hcast }
    let π₀ : ZMod (ℓ ^ (s + 1)) →+ ZMod (ℓ ^ s) :=
      (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ s)) (ZMod (ℓ ^ s))).toAddMonoidHom
    let u_s : AM ℓ ⟶ AM (ℓ ^ (s + 1)) :=
      AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom μ₀)
    let v_s : AM (ℓ ^ (s + 1)) ⟶ AM (ℓ ^ s) :=
      AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom π₀)
    have huv_s : u_s ≫ v_s = 0 := by
      apply AddCommGrpCat.ext
      rintro ⟨x⟩
      apply congrArg ULift.up
      change ZMod.cast (((ZMod.val x * ℓ ^ s : ℕ) : ZMod (ℓ ^ (s + 1)))) = (0 : ZMod (ℓ ^ s))
      rw [ZMod.cast_natCast (pow_dvd_pow ℓ (Nat.le_succ s)), Nat.cast_mul, ZMod.natCast_self,
        mul_zero]
    have hMono_u : CategoryTheory.Mono u_s := by
      rw [AddCommGrpCat.mono_iff_injective]
      intro a₁ a₂ h
      have hsub : u_s.hom (a₁ - a₂) = 0 := by rw [map_sub, h, sub_self]
      let x : ZMod ℓ := (a₁ - a₂).down
      have hx0 : μ₀ x = 0 := congrArg ULift.down hsub
      have hlt : x.val * ℓ ^ s < ℓ ^ (s + 1) := by
        rw [pow_succ']
        exact Nat.mul_lt_mul_of_pos_right (ZMod.val_lt x) hpow_pos
      have hval0 : x.val * ℓ ^ s = 0 := by
        have hv := congrArg ZMod.val hx0
        dsimp [μ₀] at hv
        rwa [ZMod.val_natCast_of_lt hlt, ZMod.val_zero] at hv
      have hxv : x.val = 0 := (mul_eq_zero.mp hval0).resolve_right hpow_pos.ne'
      have hx : x = 0 := (ZMod.val_eq_zero x).mp hxv
      exact sub_eq_zero.mp (ULift.ext _ _ hx)
    have hEpi_v : CategoryTheory.Epi v_s := by
      rw [AddCommGrpCat.epi_iff_surjective]
      rintro ⟨y⟩
      obtain ⟨z, hz⟩ := ZMod.castHom_surjective (pow_dvd_pow ℓ (Nat.le_succ s)) y
      exact ⟨⟨z⟩, congrArg ULift.up hz⟩
    have hEx : (CategoryTheory.ShortComplex.mk u_s v_s huv_s).Exact := by
      rw [CategoryTheory.ShortComplex.ab_exact_iff_ker_le_range]
      rintro ⟨y⟩ hy
      have hπy : π₀ y = 0 := congrArg ULift.down hy
      have hy_cast : ((y.val : ℕ) : ZMod (ℓ ^ (s + 1))) = y := ZMod.natCast_zmod_val y
      have hπ_nat : ((y.val : ℕ) : ZMod (ℓ ^ s)) = 0 := by
        rw [← hy_cast] at hπy
        dsimp [π₀] at hπy
        simpa [ZMod.cast_natCast (pow_dvd_pow ℓ (Nat.le_succ s))] using hπy
      obtain ⟨k₀, hk₀⟩ := (ZMod.natCast_eq_zero_iff y.val (ℓ ^ s)).mp hπ_nat
      have hk_lt : k₀ < ℓ := by
        have hy_lt : y.val < ℓ ^ s * ℓ := by rw [← pow_succ]; exact ZMod.val_lt y
        rw [hk₀] at hy_lt
        exact lt_of_mul_lt_mul_left hy_lt (Nat.zero_le _)
      let x : ZMod ℓ := (k₀ : ZMod ℓ)
      have hxv : x.val = k₀ := ZMod.val_natCast_of_lt hk_lt
      refine ⟨ULift.up x, congrArg ULift.up ?_⟩
      change ((x.val * ℓ ^ s : ℕ) : ZMod (ℓ ^ (s + 1))) = y
      rw [hxv, mul_comm, ← hk₀, hy_cast]
    exact ⟨u_s, v_s, huv_s, CategoryTheory.ShortComplex.ShortExact.mk' hEx hMono_u hEpi_v⟩

  
  have hSplit4 : ∀ {X₁ X₂ X₃ Y₁ : CategoryTheory.Sheaf J_D AddCommGrpCat.{u}}
      (f_m : X₁ ⟶ X₂) [CategoryTheory.Mono f_m] (g_m : X₂ ⟶ X₃) (δ_m : X₃ ⟶ Y₁)
      (hfg : f_m ≫ g_m = 0) (hgδ : g_m ≫ δ_m = 0),
      (CategoryTheory.ShortComplex.mk f_m g_m hfg).Exact →
      (CategoryTheory.ShortComplex.mk g_m δ_m hgδ).Exact →
      ∃ (β : X₂ ⟶ CategoryTheory.Limits.kernel δ_m) (h0 : f_m ≫ β = 0),
        (CategoryTheory.ShortComplex.mk f_m β h0).ShortExact := by
    intro X₁ X₂ X₃ Y₁ f_m hMono_f g_m δ_m hfg hgδ hEx_mid hEx_right
    let ι_K := CategoryTheory.Limits.kernel.ι δ_m
    let β : X₂ ⟶ CategoryTheory.Limits.kernel δ_m := CategoryTheory.Limits.kernel.lift δ_m g_m hgδ
    have h0 : f_m ≫ β = 0 := by
      rw [← CategoryTheory.cancel_mono ι_K, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.kernel.lift_ι, hfg, CategoryTheory.Limits.zero_comp]
    have hEpi_β : CategoryTheory.Epi β := hEx_right.epi_kernelLift
    have hEx : (CategoryTheory.ShortComplex.mk f_m β h0).Exact := by
      rw [CategoryTheory.ShortComplex.exact_iff_mono_cokernel_desc]
      change CategoryTheory.Mono (CategoryTheory.Limits.cokernel.desc f_m β h0)
      have hdesc_eq : CategoryTheory.Limits.cokernel.desc f_m β h0 ≫ ι_K =
          CategoryTheory.Limits.cokernel.desc f_m g_m hfg := by
        rw [← CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π f_m),
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.π_desc,
          CategoryTheory.Limits.kernel.lift_ι, CategoryTheory.Limits.cokernel.π_desc]
      have : CategoryTheory.Mono (CategoryTheory.Limits.cokernel.desc f_m g_m hfg) :=
        hEx_mid.mono_cokernelDesc
      have : CategoryTheory.Mono (CategoryTheory.Limits.cokernel.desc f_m β h0 ≫ ι_K) := by
        rwa [hdesc_eq]
      exact CategoryTheory.mono_of_mono (CategoryTheory.Limits.cokernel.desc f_m β h0) ι_K
    exact ⟨β, h0, CategoryTheory.ShortComplex.ShortExact.mk' hEx hMono_f hEpi_β⟩

  have hSplit5 : ∀ {Z₃ X₁ X₂ X₃ Y₁ : CategoryTheory.Sheaf J_D AddCommGrpCat.{u}}
      (d_m : Z₃ ⟶ X₁) (f_m : X₁ ⟶ X₂) (g_m : X₂ ⟶ X₃) (δ_m : X₃ ⟶ Y₁)
      (hdf : d_m ≫ f_m = 0) (hfg : f_m ≫ g_m = 0) (hgδ : g_m ≫ δ_m = 0),
      (CategoryTheory.ShortComplex.mk d_m f_m hdf).Exact →
      (CategoryTheory.ShortComplex.mk f_m g_m hfg).Exact →
      (CategoryTheory.ShortComplex.mk g_m δ_m hgδ).Exact →
      ∃ (α : CategoryTheory.Limits.cokernel d_m ⟶ X₂)
        (β : X₂ ⟶ CategoryTheory.Limits.kernel δ_m) (h0 : α ≫ β = 0),
        (CategoryTheory.ShortComplex.mk α β h0).ShortExact := by
    intro Z₃ X₁ X₂ X₃ Y₁ d_m f_m g_m δ_m hdf hfg hgδ hEx_left hEx_mid hEx_right
    let π_C := CategoryTheory.Limits.cokernel.π d_m
    let α : CategoryTheory.Limits.cokernel d_m ⟶ X₂ := CategoryTheory.Limits.cokernel.desc d_m f_m hdf
    let ι_K := CategoryTheory.Limits.kernel.ι δ_m
    let β : X₂ ⟶ CategoryTheory.Limits.kernel δ_m := CategoryTheory.Limits.kernel.lift δ_m g_m hgδ
    have h0 : α ≫ β = 0 := by
      have h1 : π_C ≫ (α ≫ β) ≫ ι_K = 0 := by
        rw [CategoryTheory.Category.assoc α β ι_K, CategoryTheory.Limits.kernel.lift_ι,
          ← CategoryTheory.Category.assoc π_C α g_m, CategoryTheory.Limits.cokernel.π_desc, hfg]
      have h2 : (α ≫ β) ≫ ι_K = 0 := by
        rw [← CategoryTheory.cancel_epi π_C, h1, CategoryTheory.Limits.comp_zero]
      rw [← CategoryTheory.cancel_mono ι_K, h2, CategoryTheory.Limits.zero_comp]
    have hMono_α : CategoryTheory.Mono α := hEx_left.mono_cokernelDesc
    have hEpi_β : CategoryTheory.Epi β := hEx_right.epi_kernelLift
    have hEx : (CategoryTheory.ShortComplex.mk α β h0).Exact := by
      rw [CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift]
      let k_αβ : CategoryTheory.Limits.cokernel d_m ⟶ CategoryTheory.Limits.kernel β :=
        CategoryTheory.Limits.kernel.lift β α h0
      change CategoryTheory.Epi k_αβ
      let k_fg : X₁ ⟶ CategoryTheory.Limits.kernel g_m :=
        CategoryTheory.Limits.kernel.lift g_m f_m hfg
      have : CategoryTheory.Epi k_fg := hEx_mid.epi_kernelLift
      let e₁ : CategoryTheory.Limits.kernel g_m ⟶ CategoryTheory.Limits.kernel β :=
        CategoryTheory.Limits.kernel.lift β (CategoryTheory.Limits.kernel.ι g_m) (by
          rw [← CategoryTheory.cancel_mono ι_K, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.kernel.lift_ι, CategoryTheory.Limits.kernel.condition,
            CategoryTheory.Limits.zero_comp])
      let e₂ : CategoryTheory.Limits.kernel β ⟶ CategoryTheory.Limits.kernel g_m :=
        CategoryTheory.Limits.kernel.lift g_m (CategoryTheory.Limits.kernel.ι β) (by
          have hβι : β ≫ ι_K = g_m := CategoryTheory.Limits.kernel.lift_ι δ_m g_m hgδ
          rw [← hβι, ← CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.condition,
            CategoryTheory.Limits.zero_comp])
      have he₂₁ : e₂ ≫ e₁ = 𝟙 _ := by
        rw [← CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι β),
          CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι,
          CategoryTheory.Limits.kernel.lift_ι, CategoryTheory.Category.id_comp]
      have : CategoryTheory.Epi (e₂ ≫ e₁) := by rw [he₂₁]; infer_instance
      have : CategoryTheory.Epi e₁ := CategoryTheory.epi_of_epi e₂ e₁
      have hcomm_k : π_C ≫ k_αβ = k_fg ≫ e₁ := by
        rw [← CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι β),
          CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι,
          CategoryTheory.Limits.cokernel.π_desc, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.kernel.lift_ι, CategoryTheory.Limits.kernel.lift_ι]
      have : CategoryTheory.Epi (π_C ≫ k_αβ) := by
        rw [hcomm_k]
        exact CategoryTheory.epi_comp k_fg e₁
      exact CategoryTheory.epi_of_epi π_C k_αβ
    exact ⟨α, β, h0, CategoryTheory.ShortComplex.ShortExact.mk' hEx hMono_α hEpi_β⟩

  
  have hCrux : ∀ {SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_D AddCommGrpCat.{u})},
      SC.ShortExact →
      Subsingleton (SC.X₁.H 1) →
      Finite ↥(SC.X₁.obj.obj (Opposite.op T_D)) →
      CategoryTheory.IsIso (adj_D.counit.app SC.X₁) →
      Finite ↥(SC.X₃.obj.obj (Opposite.op T_D)) →
      CategoryTheory.IsIso (adj_D.counit.app SC.X₃) →
      Finite ↥(SC.X₂.obj.obj (Opposite.op T_D)) ∧ CategoryTheory.IsIso (adj_D.counit.app SC.X₂) := by
    intro SC hSE hH1 hFin₁_in hIso₁ hFin₃_in hIso₃
    let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ : CategoryTheory.Sheaf J_D AddCommGrpCat.{u} := C_D.obj Aℤ
    have : CategoryTheory.Mono SC.f := hSE.mono_f
    have hMono_Γ : CategoryTheory.Mono (Γ_D.map SC.f) := Γ_D.map_mono SC.f
    have hEx_Γ : (SC.map Γ_D).Exact :=
      hSE.exact.map_of_mono_of_preservesKernel Γ_D hSE.mono_f inferInstance
    have hEpi_Γ : CategoryTheory.Epi (Γ_D.map SC.g) := by
      rw [AddCommGrpCat.epi_iff_surjective]
      intro s
      let s_hom : Aℤ ⟶ Γ_D.obj SC.X₃ :=
        AddCommGrpCat.ofHom
          { toFun := fun z => z.down • s
            map_zero' := zero_zsmul s
            map_add' := fun a b => add_zsmul s a.down b.down }
      let u_s : Fℤ ⟶ SC.X₃ := (adj_D.homEquiv Aℤ SC.X₃).symm s_hom
      let ξ_s : CategoryTheory.Abelian.Ext Fℤ SC.X₃ 0 := CategoryTheory.Abelian.Ext.mk₀ u_s
      have hξ0 : ξ_s.comp hSE.extClass (Nat.zero_add 1) = 0 :=
        @Subsingleton.elim (SC.X₁.H 1) hH1 _ 0
      obtain ⟨η, hη⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ hSE ξ_s (Nat.zero_add 1) hξ0
      let u_e : Fℤ ⟶ SC.X₂ := CategoryTheory.Abelian.Ext.addEquiv₀ η
      have hη_eq : η = CategoryTheory.Abelian.Ext.mk₀ u_e :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply η).symm
      rw [hη_eq, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hη
      have hue_comp : u_e ≫ SC.g = u_s := by
        change CategoryTheory.Abelian.Ext.mk₀ (u_e ≫ SC.g) =
          CategoryTheory.Abelian.Ext.mk₀ u_s at hη
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
          ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply] at hη
        exact CategoryTheory.Abelian.Ext.addEquiv₀.symm.injective hη
      have hnat_hom : (adj_D.homEquiv Aℤ SC.X₂ u_e) ≫ Γ_D.map SC.g = s_hom := by
        rw [← CategoryTheory.Adjunction.homEquiv_naturality_right adj_D u_e SC.g,
          hue_comp, Equiv.apply_symm_apply]
      refine ⟨(adj_D.homEquiv Aℤ SC.X₂ u_e).hom (ULift.up 1), ?_⟩
      have hev := congrArg (fun φ : Aℤ ⟶ Γ_D.obj SC.X₃ => φ.hom (ULift.up 1)) hnat_hom
      simpa [s_hom] using hev
    have hSE_Γ : (SC.map Γ_D).ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' hEx_Γ hMono_Γ hEpi_Γ
    have : Finite ↥(Γ_D.obj SC.X₁) := hFin₁_in
    have : Finite ↥(Γ_D.obj SC.X₃) := hFin₃_in
    have hFin₂ : Finite ↥(Γ_D.obj SC.X₂) := by
      let H : AddSubgroup ↥(Γ_D.obj SC.X₂) := (Γ_D.map SC.g).hom.ker
      have hrange : (Γ_D.map SC.f).hom.range = H := hEx_Γ.ab_range_eq_ker
      have hFin_range : Finite ↥(Γ_D.map SC.f).hom.range :=
        Finite.of_surjective _ (Γ_D.map SC.f).hom.rangeRestrict_surjective
      have hFin_H : Finite ↥H := hrange ▸ hFin_range
      have hFin_Q : Finite (↥(Γ_D.obj SC.X₂) ⧸ H) :=
        Finite.of_injective _ (QuotientAddGroup.kerLift_injective (Γ_D.map SC.g).hom)
      exact (finite_iff_addSubgroup_quotient H).mpr ⟨hFin_H, hFin_Q⟩
    have hSE_top : ((SC.map Γ_D).map C_D).ShortExact := hSE_Γ.map_of_exact C_D
    let Φ : (SC.map Γ_D).map C_D ⟶ SC :=
      { τ₁ := adj_D.counit.app SC.X₁
        τ₂ := adj_D.counit.app SC.X₂
        τ₃ := adj_D.counit.app SC.X₃
        comm₁₂ := (adj_D.counit.naturality SC.f).symm
        comm₂₃ := (adj_D.counit.naturality SC.g).symm }
    have : CategoryTheory.IsIso Φ.τ₁ := hIso₁
    have : CategoryTheory.IsIso Φ.τ₃ := hIso₃
    have : CategoryTheory.Mono Φ.τ₂ :=
      CategoryTheory.ShortComplex.mono_of_mono_of_mono_of_mono Φ
        hSE_top.exact hSE.mono_f inferInstance inferInstance
    have : CategoryTheory.Epi Φ.τ₂ :=
      CategoryTheory.ShortComplex.epi_of_epi_of_epi_of_epi Φ
        hSE.exact hSE_top.epi_g inferInstance inferInstance
    exact ⟨hFin₂, CategoryTheory.isIso_of_mono_of_epi Φ.τ₂⟩

  
  have hBase0 : ∀ p : ℕ,
      Finite ↥(A p 1) ∧
      (1 : ℕ) • CategoryTheory.CategoryStruct.id (A p 1) = 0 ∧
      CategoryTheory.IsIso (adj_D.counit.app (R p 1)) := by
    intro p
    obtain ⟨hR1, hA1⟩ := hTorsAnn 1 p
    have hidR : CategoryTheory.CategoryStruct.id (R p 1) = 0 := by simpa using hR1
    have hidA : CategoryTheory.CategoryStruct.id (A p 1) = 0 := by simpa using hA1
    have hZR : CategoryTheory.Limits.IsZero (R p 1) :=
      (CategoryTheory.Limits.IsZero.iff_id_eq_zero (R p 1)).mpr hidR
    have hZA : CategoryTheory.Limits.IsZero (A p 1) :=
      (CategoryTheory.Limits.IsZero.iff_id_eq_zero (A p 1)).mpr hidA
    have hSubA : Subsingleton ↥(A p 1) := by
      refine subsingleton_of_forall_eq 0 ?_
      intro a
      exact congrArg (fun φ : A p 1 ⟶ A p 1 => φ.hom a) hidA
    have hFinA : Finite ↥(A p 1) := @Finite.of_subsingleton _ hSubA
    have hZC : CategoryTheory.Limits.IsZero (C_D.obj (A p 1)) := C_D.map_isZero hZA
    have hIso0 : CategoryTheory.IsIso (adj_D.counit.app (R p 1)) :=
      ⟨⟨0, hZC.eq_of_src _ _, hZR.eq_of_src _ _⟩⟩
    exact ⟨hFinA, hA1, hIso0⟩

  have hBase1 : ∀ p : ℕ, p ≤ j_deg →
      Finite ↥(A p ℓ) ∧
      ℓ • CategoryTheory.CategoryStruct.id (A p ℓ) = 0 ∧
      CategoryTheory.IsIso (adj_D.counit.app (R p ℓ)) := by
    intro p hp
    obtain ⟨A₀, hFin₀, hCov⟩ := hLocConst p hp
    have : Finite ↥A₀ := hFin₀
    obtain ⟨hFin1, hIso1⟩ := hSimpConn (R p ℓ) A₀ hCov
    exact ⟨hFin1, (hTorsAnn ℓ p).2, hIso1⟩

  let C_Z := CategoryTheory.constantSheaf J_Z AddCommGrpCat.{u}
  have : C_Z.Additive := by dsimp [C_Z, CategoryTheory.constantSheaf]; infer_instance
  have : CategoryTheory.Limits.PreservesFiniteLimits C_Z := by
    dsimp [C_Z, CategoryTheory.constantSheaf]; infer_instance
  have : CategoryTheory.Limits.PreservesFiniteColimits C_Z := by
    dsimp [C_Z, CategoryTheory.constantSheaf]; infer_instance

  have hInd : ∀ (n p : ℕ), p ≤ j_deg →
      Finite ↥(A p (ℓ ^ n)) ∧
      (ℓ ^ n) • CategoryTheory.CategoryStruct.id (A p (ℓ ^ n)) = 0 ∧
      CategoryTheory.IsIso (adj_D.counit.app (R p (ℓ ^ n))) := by
    intro n
    induction n with
    | zero =>
      intro p _
      rw [pow_zero]
      exact hBase0 p
    | succ s ih =>
      intro p hp
      obtain ⟨u_s, v_s, huv_s, hSE_AM⟩ := hBockZMod s
      let SC_Z := (CategoryTheory.ShortComplex.mk u_s v_s huv_s).map C_Z
      have hSE_Z : SC_Z.ShortExact := hSE_AM.map_of_exact C_Z
      let δ : ∀ k : ℕ, R k (ℓ ^ s) ⟶ R (k + 1) ℓ := fun k => δ_conn hSE_Z k
      let 𝒦_p := CategoryTheory.Limits.kernel (δ p)
      obtain ⟨hFin_ps, _, hIso_ps⟩ := ih p hp
      have : Finite ↥(A p (ℓ ^ s)) := hFin_ps
      let e_ps : C_D.obj (A p (ℓ ^ s)) ≅ R p (ℓ ^ s) :=
        @CategoryTheory.asIso _ _ _ _ (adj_D.counit.app (R p (ℓ ^ s))) hIso_ps
      obtain ⟨B₀, hFin_B₀, ⟨e_B₀⟩⟩ := hKerConst p hp (A p (ℓ ^ s)) (e_ps.hom ≫ δ p)
      have : Finite ↥B₀ := hFin_B₀
      let e_ker : CategoryTheory.Limits.kernel (e_ps.hom ≫ δ p) ≅ 𝒦_p :=
        CategoryTheory.Limits.kernel.mapIso (e_ps.hom ≫ δ p) (δ p) e_ps
          (CategoryTheory.Iso.refl _) (by simp)
      obtain ⟨hFin_Kp, hIso_Kp⟩ := hPromote 𝒦_p B₀ ⟨e_B₀.trans e_ker⟩
      cases p with
      | zero =>
        have : CategoryTheory.Mono SC_Z.f := hSE_Z.mono_f
        have : CategoryTheory.Mono (weilEtaleHigherDirectImageMap f 0 SC_Z.f) :=
          hMono_R0 SC_Z.f
        obtain ⟨h0_mid, h0_left, _, hEx_mid, hEx_left, _⟩ := hLES hSE_Z 0
        obtain ⟨β₀, h0_β₀, hSE_D⟩ := hSplit4
          (weilEtaleHigherDirectImageMap f 0 SC_Z.f)
          (weilEtaleHigherDirectImageMap f 0 SC_Z.g)
          (δ 0) h0_mid h0_left hEx_mid hEx_left
        obtain ⟨hFin_01, hAnn_01, hIso_01⟩ := hBase1 0 (Nat.zero_le j_deg)
        have : Finite ↥(A 0 ℓ) := hFin_01
        let e_01 : C_D.obj (A 0 ℓ) ≅ R 0 ℓ :=
          @CategoryTheory.asIso _ _ _ _ (adj_D.counit.app (R 0 ℓ)) hIso_01
        have hH1_R0 : Subsingleton ((R 0 ℓ).H 1) :=
          hSubIso e_01.symm (hH1_const (A 0 ℓ) hAnn_01)
        obtain ⟨hFin_res, hIso_res⟩ := hCrux hSE_D hH1_R0 hFin_01 hIso_01 hFin_Kp hIso_Kp
        exact ⟨hFin_res, (hTorsAnn (ℓ ^ (s + 1)) 0).2, hIso_res⟩
      | succ q' =>
        have hq' : q' ≤ j_deg := Nat.le_of_succ_le hp
        obtain ⟨_, _, h0_right_prev, _, _, hEx_right_prev⟩ := hLES hSE_Z q'
        obtain ⟨h0_mid, h0_left, _, hEx_mid, hEx_left, _⟩ := hLES hSE_Z (q' + 1)
        obtain ⟨α_p, β_p, h0_αβ, hSE_D⟩ := hSplit5
          (δ q')
          (weilEtaleHigherDirectImageMap f (q' + 1) SC_Z.f)
          (weilEtaleHigherDirectImageMap f (q' + 1) SC_Z.g)
          (δ (q' + 1))
          h0_right_prev h0_mid h0_left hEx_right_prev hEx_mid hEx_left
        let 𝒞_p := CategoryTheory.Limits.cokernel (δ q')
        obtain ⟨_, _, hIso_src⟩ := ih q' hq'
        obtain ⟨hFin_tgt, hAnn_tgt, hIso_tgt⟩ := hBase1 (q' + 1) hp
        have : Finite ↥(A (q' + 1) ℓ) := hFin_tgt
        let e_src : C_D.obj (A q' (ℓ ^ s)) ≅ R q' (ℓ ^ s) :=
          @CategoryTheory.asIso _ _ _ _ (adj_D.counit.app (R q' (ℓ ^ s))) hIso_src
        let e_tgt : C_D.obj (A (q' + 1) ℓ) ≅ R (q' + 1) ℓ :=
          @CategoryTheory.asIso _ _ _ _ (adj_D.counit.app (R (q' + 1) ℓ)) hIso_tgt
        let ψ : C_D.obj (A q' (ℓ ^ s)) ⟶ C_D.obj (A (q' + 1) ℓ) :=
          e_src.hom ≫ δ q' ≫ e_tgt.inv
        obtain ⟨α₀, ⟨e_cok₁⟩⟩ := hCokConst (A q' (ℓ ^ s)) (A (q' + 1) ℓ) ψ
        let C₀ := CategoryTheory.Limits.cokernel α₀
        let e_cok₂ : CategoryTheory.Limits.cokernel ψ ≅ 𝒞_p :=
          CategoryTheory.Limits.cokernel.mapIso ψ (δ q') e_src e_tgt (by
            dsimp [ψ]
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              e_tgt.inv_hom_id, CategoryTheory.Category.comp_id])
        let e_C : C_D.obj C₀ ≅ 𝒞_p := e_cok₁.trans e_cok₂
        let π_α₀ := CategoryTheory.Limits.cokernel.π α₀
        have hSurj_π : Function.Surjective π_α₀.hom :=
          (AddCommGrpCat.epi_iff_surjective π_α₀).mp inferInstance
        have : Finite ↥C₀ := Finite.of_surjective π_α₀.hom hSurj_π
        have hAnn_C₀ : ℓ • CategoryTheory.CategoryStruct.id C₀ = 0 := by
          rw [← CategoryTheory.cancel_epi π_α₀, CategoryTheory.Limits.comp_zero,
            CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
            ← CategoryTheory.Category.id_comp π_α₀, ← CategoryTheory.Preadditive.nsmul_comp,
            hAnn_tgt, CategoryTheory.Limits.zero_comp]
        obtain ⟨hFin_Cp, hIso_Cp⟩ := hPromote 𝒞_p C₀ ⟨e_C⟩
        have hH1_Cp : Subsingleton (𝒞_p.H 1) :=
          hSubIso e_C.symm (hH1_const C₀ hAnn_C₀)
        obtain ⟨hFin_res, hIso_res⟩ := hCrux hSE_D hH1_Cp hFin_Cp hIso_Cp hFin_Kp hIso_Kp
        exact ⟨hFin_res, (hTorsAnn (ℓ ^ (s + 1)) (q' + 1)).2, hIso_res⟩

  exact hInd r q hq

theorem weil_outer_bc_pcc_hdi_mono_and_conn_les {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S) :
    (∀ {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        (u : F₁ ⟶ F₂) [CategoryTheory.Mono u],
      CategoryTheory.Mono (weilEtaleHigherDirectImageMap f 0 u)) ∧
    (∀ {SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})}
        (hSE : SC.ShortExact) (q : ℕ),
      ∃ δ, WeilIsOuterConnHom f hSE q δ ∧
        ∃ (h0_mid : weilEtaleHigherDirectImageMap f q SC.f ≫
              weilEtaleHigherDirectImageMap f q SC.g = 0)
          (h0_left : weilEtaleHigherDirectImageMap f q SC.g ≫ δ = 0)
          (h0_right : δ ≫ weilEtaleHigherDirectImageMap f (q + 1) SC.f = 0),
          (CategoryTheory.ShortComplex.mk
            (weilEtaleHigherDirectImageMap f q SC.f)
            (weilEtaleHigherDirectImageMap f q SC.g) h0_mid).Exact ∧
          (CategoryTheory.ShortComplex.mk
            (weilEtaleHigherDirectImageMap f q SC.g) δ h0_left).Exact ∧
          (CategoryTheory.ShortComplex.mk
            δ (weilEtaleHigherDirectImageMap f (q + 1) SC.f) h0_right).Exact) :=
by
  have scZero : ∀ {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}},
      K.Exact → K.f ≫ K.g = 0 :=
    fun _ => CategoryTheory.ShortComplex.zero _
  let repFun : CategoryTheory.Functor X.Etale
      (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) :=
    CategoryTheory.yoneda ⋙
      (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale) (Type u) AddCommGrpCat.{u}).obj
        AddCommGrpCat.free ⋙
      CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}
  have hCohomFunApp : ∀ (p : ℕ)
      {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : F₁ ⟶ F₂) (W : (X.Etale)ᵒᵖ),
      (((CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology p).map φ).app W) =
        AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp
            (weilPolyP1CohomologyRepSheaf X W.unop) (Nat.add_zero p)) := by
    intro p F₁ F₂ φ W
    exact CategoryTheory.Abelian.extFunctorObj_map
      (weilPolyP1CohomologyRepSheaf X W.unop) p φ
  have hPShExact : ∀ (K : CategoryTheory.ShortComplex
      (CategoryTheory.Functor (X.Etale)ᵒᵖ AddCommGrpCat.{u})),
      (∀ W : (X.Etale)ᵒᵖ,
        (K.map ((CategoryTheory.evaluation (X.Etale)ᵒᵖ AddCommGrpCat.{u}).obj W)).Exact) →
      K.Exact := by
    intro K hpt
    rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology,
      CategoryTheory.Functor.isZero_iff]
    intro W
    let evW := (CategoryTheory.evaluation (X.Etale)ᵒᵖ AddCommGrpCat.{u}).obj W
    have hZ : CategoryTheory.Limits.IsZero (K.map evW).leftHomology :=
      (CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology (K.map evW)).mp (hpt W)
    exact hZ.of_iso (K.mapLeftHomologyIso evW).symm
  let B_f := weilEtaleSitePullback f
  let W_S := (CategoryTheory.Functor.whiskeringLeft
    (S.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u}).obj B_f.op
  let Sh_S := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
  let E_S := W_S ⋙ Sh_S
  refine ⟨?_, ?_⟩
  · intro F₁ F₂ u _
    let φ_pre := (CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology 0).map u
    have hMonoApp : ∀ W : (X.Etale)ᵒᵖ, CategoryTheory.Mono (φ_pre.app W) := by
      intro W
      rw [AddCommGrpCat.mono_iff_injective]
      intro α₁ α₂ hα
      have hEqApp : φ_pre.app W =
          AddCommGrpCat.ofHom ((CategoryTheory.Abelian.Ext.mk₀ u).postcomp
            (weilPolyP1CohomologyRepSheaf X W.unop) (Nat.add_zero 0)) :=
        hCohomFunApp 0 u W
      rw [hEqApp] at hα
      change ((CategoryTheory.Abelian.Ext.mk₀ u).postcomp
          (weilPolyP1CohomologyRepSheaf X W.unop) (Nat.add_zero 0)) α₁ =
        ((CategoryTheory.Abelian.Ext.mk₀ u).postcomp
          (weilPolyP1CohomologyRepSheaf X W.unop) (Nat.add_zero 0)) α₂ at hα
      let g₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
      let g₂ := CategoryTheory.Abelian.Ext.addEquiv₀ α₂
      have hα₁ : α₁ = CategoryTheory.Abelian.Ext.mk₀ g₁ :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α₁).symm
      have hα₂ : α₂ = CategoryTheory.Abelian.Ext.mk₀ g₂ :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α₂).symm
      rw [hα₁, hα₂] at hα ⊢
      change (CategoryTheory.Abelian.Ext.mk₀ g₁).comp
          (CategoryTheory.Abelian.Ext.mk₀ u) (Nat.add_zero 0) =
        (CategoryTheory.Abelian.Ext.mk₀ g₂).comp
          (CategoryTheory.Abelian.Ext.mk₀ u) (Nat.add_zero 0) at hα
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hα
      have hgu : g₁ ≫ u = g₂ ≫ u := by
        have h1 := congrArg CategoryTheory.Abelian.Ext.addEquiv₀ hα
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply (g₁ ≫ u),
          ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply (g₂ ≫ u),
          AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply] at h1
        exact h1
      rw [(CategoryTheory.cancel_mono u).mp hgu]
    have hMonoPre : CategoryTheory.Mono φ_pre :=
      CategoryTheory.NatTrans.mono_of_mono_app φ_pre
    exact Sh_S.map_mono (W_S.map φ_pre)
  · intro SC hSE q
    let δ_pre : SC.X₃.cohomologyPresheaf q ⟶ SC.X₁.cohomologyPresheaf (q + 1) :=
      { app := fun W => AddCommGrpCat.ofHom
          (hSE.extClass.postcomp (weilPolyP1CohomologyRepSheaf X W.unop) rfl)
        naturality := fun {W₁ W₂} ω => by
          have hL : (SC.X₃.cohomologyPresheaf q).map ω =
              ((CategoryTheory.Abelian.extFunctor q).map (repFun.op.map ω)).app SC.X₃ := rfl
          have hR : (SC.X₁.cohomologyPresheaf (q + 1)).map ω =
              ((CategoryTheory.Abelian.extFunctor (q + 1)).map (repFun.op.map ω)).app SC.X₁ := rfl
          rw [hL, hR,
            CategoryTheory.Abelian.extFunctor_map_app q (repFun.op.map ω) SC.X₃,
            CategoryTheory.Abelian.extFunctor_map_app (q + 1) (repFun.op.map ω) SC.X₁]
          exact AddCommGrpCat.ext fun α =>
            CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ (repFun.op.map ω).unop) α hSE.extClass
              (Nat.zero_add q) rfl (Nat.zero_add (q + 1)) }
    let δ : weilEtaleHigherDirectImage f q SC.X₃ ⟶ weilEtaleHigherDirectImage f (q + 1) SC.X₁ :=
      E_S.map δ_pre
    have hδ : WeilIsOuterConnHom f hSE q δ := by
      intro W
      let η_S := (CategoryTheory.sheafificationAdjunction
        S.smallEtaleTopology AddCommGrpCat.{u}).unit
      exact (congrArg (fun τ => τ.app (Opposite.op W))
        (η_S.naturality (W_S.map δ_pre))).symm
    let f_q := (CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q).map SC.f
    let g_q := (CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q).map SC.g
    let f_q1 :=
      (CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology (q + 1)).map SC.f
    have hMidPt : ∀ W : (X.Etale)ᵒᵖ, f_q.app W ≫ g_q.app W = 0 := by
      intro W
      rw [hCohomFunApp q SC.f W, hCohomFunApp q SC.g W]
      exact scZero (CategoryTheory.Abelian.Ext.covariant_sequence_exact₂'
        (weilPolyP1CohomologyRepSheaf X W.unop) hSE q)
    have hLeftPt : ∀ W : (X.Etale)ᵒᵖ, g_q.app W ≫ δ_pre.app W = 0 := by
      intro W
      rw [hCohomFunApp q SC.g W]
      exact scZero (CategoryTheory.Abelian.Ext.covariant_sequence_exact₃'
        (weilPolyP1CohomologyRepSheaf X W.unop) hSE q (q + 1) rfl)
    have hRightPt : ∀ W : (X.Etale)ᵒᵖ, δ_pre.app W ≫ f_q1.app W = 0 := by
      intro W
      rw [hCohomFunApp (q + 1) SC.f W]
      exact scZero (CategoryTheory.Abelian.Ext.covariant_sequence_exact₁'
        (weilPolyP1CohomologyRepSheaf X W.unop) hSE q (q + 1) rfl)
    have h0_mid_pre : f_q ≫ g_q = 0 := by ext W : 2; exact hMidPt W
    have h0_left_pre : g_q ≫ δ_pre = 0 := by ext W : 2; exact hLeftPt W
    have h0_right_pre : δ_pre ≫ f_q1 = 0 := by ext W : 2; exact hRightPt W
    let M_pre := CategoryTheory.ShortComplex.mk f_q g_q h0_mid_pre
    let A_pre := CategoryTheory.ShortComplex.mk g_q δ_pre h0_left_pre
    let B_pre := CategoryTheory.ShortComplex.mk δ_pre f_q1 h0_right_pre
    have hM_pre_ex : M_pre.Exact := by
      apply hPShExact M_pre
      intro W
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂'
        (weilPolyP1CohomologyRepSheaf X W.unop) hSE q
      refine (CategoryTheory.ShortComplex.exact_iff_of_iso
        (CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_)).mpr hex
      · exact (CategoryTheory.Category.id_comp (f_q.app W)).trans
          ((hCohomFunApp q SC.f W).trans (CategoryTheory.Category.comp_id _).symm)
      · exact (CategoryTheory.Category.id_comp (g_q.app W)).trans
          ((hCohomFunApp q SC.g W).trans (CategoryTheory.Category.comp_id _).symm)
    have hA_pre_ex : A_pre.Exact := by
      apply hPShExact A_pre
      intro W
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃'
        (weilPolyP1CohomologyRepSheaf X W.unop) hSE q (q + 1) rfl
      refine (CategoryTheory.ShortComplex.exact_iff_of_iso
        (CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_)).mpr hex
      · exact (CategoryTheory.Category.id_comp (g_q.app W)).trans
          ((hCohomFunApp q SC.g W).trans (CategoryTheory.Category.comp_id _).symm)
      · exact (CategoryTheory.Category.id_comp (δ_pre.app W)).trans
          (CategoryTheory.Category.comp_id (δ_pre.app W)).symm
    have hB_pre_ex : B_pre.Exact := by
      apply hPShExact B_pre
      intro W
      have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁'
        (weilPolyP1CohomologyRepSheaf X W.unop) hSE q (q + 1) rfl
      refine (CategoryTheory.ShortComplex.exact_iff_of_iso
        (CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_)).mpr hex
      · exact (CategoryTheory.Category.id_comp (δ_pre.app W)).trans
          (CategoryTheory.Category.comp_id (δ_pre.app W)).symm
      · exact (CategoryTheory.Category.id_comp (f_q1.app W)).trans
          ((hCohomFunApp (q + 1) SC.f W).trans (CategoryTheory.Category.comp_id _).symm)
    have h0_mid : weilEtaleHigherDirectImageMap f q SC.f ≫
        weilEtaleHigherDirectImageMap f q SC.g = 0 := by
      change E_S.map f_q ≫ E_S.map g_q = 0
      rw [← E_S.map_comp, h0_mid_pre, E_S.map_zero]
    have h0_left : weilEtaleHigherDirectImageMap f q SC.g ≫ δ = 0 := by
      change E_S.map g_q ≫ E_S.map δ_pre = 0
      rw [← E_S.map_comp, h0_left_pre, E_S.map_zero]
    have h0_right : δ ≫ weilEtaleHigherDirectImageMap f (q + 1) SC.f = 0 := by
      change E_S.map δ_pre ≫ E_S.map f_q1 = 0
      rw [← E_S.map_comp, h0_right_pre, E_S.map_zero]
    refine ⟨δ, hδ, h0_mid, h0_left, h0_right,
      (hM_pre_ex.map W_S).map Sh_S,
      (hA_pre_ex.map W_S).map Sh_S,
      (hB_pre_ex.map W_S).map Sh_S⟩

theorem weil_outer_bc_pcc_push_existence {X S S' X' : AlgebraicGeometry.Scheme.{u}}
    (f : X ⟶ S) (g : S' ⟶ S) (f' : X' ⟶ S') (g' : X' ⟶ X)
    (hgf : g' ≫ f = f' ≫ g)
    [_hc_g : (weilEtaleSitePullback g).IsContinuous
      S.smallEtaleTopology S'.smallEtaleTopology]
    [_hc_g' : (weilEtaleSitePullback g').IsContinuous
      X.smallEtaleTopology X'.smallEtaleTopology]
    [_hr_g' : ((weilEtaleSitePullback g').sheafPushforwardContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology X'.smallEtaleTopology).IsRightAdjoint]
    [_hAdd_g' : ((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
      X.smallEtaleTopology X'.smallEtaleTopology).Additive]
    [_hLim_g' : CategoryTheory.Limits.PreservesFiniteLimits
      ((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
        X.smallEtaleTopology X'.smallEtaleTopology)]
    [_hColim_g' : CategoryTheory.Limits.PreservesFiniteColimits
      ((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
        X.smallEtaleTopology X'.smallEtaleTopology)]
    (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ) :
    ∃ β, WeilIsOuterBCPush f g f' g' hgf F q β :=
by
  let R_fun : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Functor Z.Etale
        (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) :=
    fun Z => CategoryTheory.yoneda ⋙
      ((CategoryTheory.Functor.whiskeringRight (Opposite Z.Etale) (Type u)
        AddCommGrpCat.{u}).obj AddCommGrpCat.free ⋙
        CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u})

  have hRepEquivEq : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (φ : weilPolyP1CohomologyRepSheaf Z V ⟶ G),
      weilPolyP1CohomologyRepHomEquiv Z V G φ =
        CategoryTheory.yonedaEquiv
          (((AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).comp
            (CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology
              AddCommGrpCat.{u})).homEquiv (CategoryTheory.yoneda.obj V) G φ) := by
    intro Z V G φ
    let adj_free := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
    let adj_sh := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    have hcomp := congrFun (congrFun (adj_free.comp_homEquiv adj_sh)
      (CategoryTheory.yoneda.obj V)) G
    exact congrArg CategoryTheory.yonedaEquiv (Equiv.congr_fun hcomp.symm φ)

  have hRepRight : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : weilPolyP1CohomologyRepSheaf Z V ⟶ G₁) (α : G₁ ⟶ G₂),
      weilPolyP1CohomologyRepHomEquiv Z V G₂ (φ ≫ α) =
        (α.hom.app (Opposite.op V)).hom (weilPolyP1CohomologyRepHomEquiv Z V G₁ φ) := by
    intro Z V G₁ G₂ φ α
    let adj_tot := (AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).comp
      (CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u})
    rw [hRepEquivEq Z V G₂ (φ ≫ α), hRepEquivEq Z V G₁ φ,
      adj_tot.homEquiv_naturality_right φ α, CategoryTheory.yonedaEquiv_comp]
    rfl

  have hRepLeft : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {V₁ V₂ : Z.Etale} (u : V₁ ⟶ V₂)
      {G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : (R_fun Z).obj V₂ ⟶ G),
      weilPolyP1CohomologyRepHomEquiv Z V₁ G ((R_fun Z).map u ≫ φ) =
        (G.obj.map u.op).hom (weilPolyP1CohomologyRepHomEquiv Z V₂ G φ) := by
    intro Z V₁ V₂ u G φ
    let adj_tot := (AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).comp
      (CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u})
    let L_Z := (CategoryTheory.Functor.whiskeringRight (Opposite Z.Etale) (Type u)
        AddCommGrpCat.{u}).obj AddCommGrpCat.free ⋙
      CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}
    change weilPolyP1CohomologyRepHomEquiv Z V₁ G
      (L_Z.map (CategoryTheory.yoneda.map u) ≫ φ) = _
    rw [hRepEquivEq Z V₁ G _, hRepEquivEq Z V₂ G φ,
      adj_tot.homEquiv_naturality_left (CategoryTheory.yoneda.map u) φ,
      ← CategoryTheory.yonedaEquiv_naturality]
    rfl

  let B_g' := weilEtaleSitePullback g'
  let pf_g' := B_g'.sheafPushforwardContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology X'.smallEtaleTopology
  let pb_g' := B_g'.sheafPullback AddCommGrpCat.{u}
    X.smallEtaleTopology X'.smallEtaleTopology
  let adj_g' := B_g'.sheafAdjunctionContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology X'.smallEtaleTopology

  
  have hRepPullNat : ∀ {U₁ U₂ : X.Etale} {U₁' U₂' : X'.Etale}
      (v_X : U₁ ⟶ U₂) (v_X' : U₁' ⟶ U₂')
      (α₁ : U₁' ⟶ B_g'.obj U₁)
      (α₂ : U₂' ⟶ B_g'.obj U₂),
      v_X' ≫ α₂ = α₁ ≫ B_g'.map v_X →
      (R_fun X').map v_X' ≫ weilPolyP1CohomologyRepPullHom g' U₂ U₂' α₂ =
        weilPolyP1CohomologyRepPullHom g' U₁ U₁' α₁ ≫ pb_g'.map ((R_fun X).map v_X) := by
    intro U₁ U₂ U₁' U₂' v_X v_X' α₁ α₂ hsq
    let M₁ := (R_fun X).obj U₁
    let M₂ := (R_fun X).obj U₂
    let ι₁ := weilPolyP1CohomologyRepHomEquiv X U₁ M₁ (𝟙 M₁)
    let ι₂ := weilPolyP1CohomologyRepHomEquiv X U₂ M₂ (𝟙 M₂)
    let ρ₁ := weilPolyP1CohomologyRepPullHom g' U₁ U₁' α₁
    let ρ₂ := weilPolyP1CohomologyRepPullHom g' U₂ U₂' α₂
    let s_pull₁ : ↑((pb_g'.obj M₁).obj.obj (Opposite.op (B_g'.obj U₁))) :=
      ((adj_g'.unit.app M₁).hom.app (Opposite.op U₁)).hom ι₁
    let s_pull₂ : ↑((pb_g'.obj M₂).obj.obj (Opposite.op (B_g'.obj U₂))) :=
      ((adj_g'.unit.app M₂).hom.app (Opposite.op U₂)).hom ι₂
    have hGen : (M₂.obj.map v_X.op).hom ι₂ =
        (((R_fun X).map v_X).hom.app (Opposite.op U₁)).hom ι₁ := by
      have hL : weilPolyP1CohomologyRepHomEquiv X U₁ M₂ ((R_fun X).map v_X) =
          (M₂.obj.map v_X.op).hom ι₂ :=
        (congrArg (weilPolyP1CohomologyRepHomEquiv X U₁ M₂)
          (CategoryTheory.Category.comp_id ((R_fun X).map v_X)).symm).trans
          (hRepLeft X v_X (𝟙 M₂))
      have hR : weilPolyP1CohomologyRepHomEquiv X U₁ M₂ ((R_fun X).map v_X) =
          (((R_fun X).map v_X).hom.app (Opposite.op U₁)).hom ι₁ :=
        (congrArg (weilPolyP1CohomologyRepHomEquiv X U₁ M₂)
          (CategoryTheory.Category.id_comp ((R_fun X).map v_X)).symm).trans
          (hRepRight X U₁ (𝟙 M₁) ((R_fun X).map v_X))
      exact hL.symm.trans hR
    apply (weilPolyP1CohomologyRepHomEquiv X' U₁' (pb_g'.obj M₂)).injective
    have hρ₁ : weilPolyP1CohomologyRepHomEquiv X' U₁' (pb_g'.obj M₁) ρ₁ =
        ((pb_g'.obj M₁).obj.map α₁.op).hom s_pull₁ := by
      dsimp only [ρ₁, weilPolyP1CohomologyRepPullHom]
      exact Equiv.apply_symm_apply _ _
    have hρ₂ : weilPolyP1CohomologyRepHomEquiv X' U₂' (pb_g'.obj M₂) ρ₂ =
        ((pb_g'.obj M₂).obj.map α₂.op).hom s_pull₂ := by
      dsimp only [ρ₂, weilPolyP1CohomologyRepPullHom]
      exact Equiv.apply_symm_apply _ _
    have hLHS1 : weilPolyP1CohomologyRepHomEquiv X' U₁' (pb_g'.obj M₂)
          ((R_fun X').map v_X' ≫ ρ₂) =
        ((pb_g'.obj M₂).obj.map α₁.op).hom
          (((pb_g'.obj M₂).obj.map (B_g'.map v_X).op).hom s_pull₂) := by
      have h0 : weilPolyP1CohomologyRepHomEquiv X' U₁' (pb_g'.obj M₂)
            ((R_fun X').map v_X' ≫ ρ₂) =
          ((pb_g'.obj M₂).obj.map α₂.op ≫ (pb_g'.obj M₂).obj.map v_X'.op).hom s_pull₂ :=
        (hRepLeft X' v_X' ρ₂).trans (congrArg ((pb_g'.obj M₂).obj.map v_X'.op).hom hρ₂)
      have h1 : (pb_g'.obj M₂).obj.map α₂.op ≫ (pb_g'.obj M₂).obj.map v_X'.op =
          (pb_g'.obj M₂).obj.map (B_g'.map v_X).op ≫ (pb_g'.obj M₂).obj.map α₁.op := by
        rw [← (pb_g'.obj M₂).obj.map_comp, ← (pb_g'.obj M₂).obj.map_comp,
          ← op_comp, ← op_comp, hsq]
      exact h0.trans (congrArg (fun m => m.hom s_pull₂) h1)
    have hUnit1 : ((pb_g'.obj M₂).obj.map (B_g'.map v_X).op).hom s_pull₂ =
        ((adj_g'.unit.app M₂).hom.app (Opposite.op U₁)).hom
          ((M₂.obj.map v_X.op).hom ι₂) :=
      congrArg (fun m => m.hom ι₂) ((adj_g'.unit.app M₂).hom.naturality v_X.op).symm
    have hUnit2 : ((adj_g'.unit.app M₂).hom.app (Opposite.op U₁)).hom
          ((((R_fun X).map v_X).hom.app (Opposite.op U₁)).hom ι₁) =
        ((pb_g'.map ((R_fun X).map v_X)).hom.app (Opposite.op (B_g'.obj U₁))).hom s_pull₁ :=
      congrArg (fun φ : M₁ ⟶ pf_g'.obj (pb_g'.obj M₂) =>
        (φ.hom.app (Opposite.op U₁)).hom ι₁)
        (adj_g'.unit.naturality ((R_fun X).map v_X))
    have hNatα₁ : ((pb_g'.obj M₂).obj.map α₁.op).hom
          (((pb_g'.map ((R_fun X).map v_X)).hom.app (Opposite.op (B_g'.obj U₁))).hom s_pull₁) =
        ((pb_g'.map ((R_fun X).map v_X)).hom.app (Opposite.op U₁')).hom
          (((pb_g'.obj M₁).obj.map α₁.op).hom s_pull₁) :=
      congrArg (fun m => m.hom s_pull₁)
        ((pb_g'.map ((R_fun X).map v_X)).hom.naturality α₁.op).symm
    have hRHS1 : weilPolyP1CohomologyRepHomEquiv X' U₁' (pb_g'.obj M₂)
          (ρ₁ ≫ pb_g'.map ((R_fun X).map v_X)) =
        ((pb_g'.map ((R_fun X).map v_X)).hom.app (Opposite.op U₁')).hom
          (((pb_g'.obj M₁).obj.map α₁.op).hom s_pull₁) :=
      (hRepRight X' U₁' ρ₁ (pb_g'.map ((R_fun X).map v_X))).trans
        (congrArg ((pb_g'.map ((R_fun X).map v_X)).hom.app (Opposite.op U₁')).hom hρ₁)
    exact hLHS1.trans
      ((congrArg ((pb_g'.obj M₂).obj.map α₁.op).hom
          (hUnit1.trans
            ((congrArg ((adj_g'.unit.app M₂).hom.app (Opposite.op U₁)).hom hGen).trans
              hUnit2))).trans
        (hNatα₁.trans hRHS1.symm))

  
  have hExtPrecompComm : ∀ {𝒜 ℬ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒜] [CategoryTheory.Abelian 𝒜]
      [CategoryTheory.HasExt.{u} 𝒜]
      [CategoryTheory.Category.{u + 1, u + 1} ℬ] [CategoryTheory.Abelian ℬ]
      [CategoryTheory.HasExt.{u} ℬ]
      (E : CategoryTheory.Functor 𝒜 ℬ)
      [E.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits E]
      [CategoryTheory.Limits.PreservesFiniteColimits E]
      {R₁ R₂ F₀ : 𝒜} {R₁' R₂' : ℬ}
      (φ_A : R₁ ⟶ R₂) (φ_B : R₁' ⟶ R₂')
      (ρ₁ : R₁' ⟶ E.obj R₁) (ρ₂ : R₂' ⟶ E.obj R₂),
      φ_B ≫ ρ₂ = ρ₁ ≫ E.map φ_A →
      ∀ (s : CategoryTheory.Abelian.Ext.{u} R₂ F₀ q),
        ((CategoryTheory.Abelian.Ext.mk₀ ρ₁).precomp (E.obj F₀) (Nat.zero_add q))
          (E.mapExtAddHom R₁ F₀ q
            ((CategoryTheory.Abelian.Ext.mk₀ φ_A).comp s (Nat.zero_add q))) =
        (CategoryTheory.Abelian.Ext.mk₀ φ_B).comp
          (((CategoryTheory.Abelian.Ext.mk₀ ρ₂).precomp (E.obj F₀) (Nat.zero_add q))
            (E.mapExtAddHom R₂ F₀ q s))
          (Nat.zero_add q) := by
    intro 𝒜 ℬ _ _ _ _ _ _ E _ _ _ R₁ R₂ F₀ R₁' R₂' φ_A φ_B ρ₁ ρ₂ hcomm s
    change (CategoryTheory.Abelian.Ext.mk₀ ρ₁).comp
        (E.mapExtAddHom R₁ F₀ q ((CategoryTheory.Abelian.Ext.mk₀ φ_A).comp s (Nat.zero_add q)))
        (Nat.zero_add q) =
      (CategoryTheory.Abelian.Ext.mk₀ φ_B).comp
        ((CategoryTheory.Abelian.Ext.mk₀ ρ₂).comp
          (E.mapExtAddHom R₂ F₀ q s) (Nat.zero_add q))
        (Nat.zero_add q)
    rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ρ₁)
        (CategoryTheory.Abelian.Ext.mk₀ (E.map φ_A)) _,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ φ_B)
        (CategoryTheory.Abelian.Ext.mk₀ ρ₂) _,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      hcomm]

  
  have hSheafifyTranspose : ∀ {C₁ C₂ : Type (u + 1)}
      [CategoryTheory.Category.{u, u + 1} C₁]
      [CategoryTheory.Category.{u, u + 1} C₂]
      (J₁ : CategoryTheory.GrothendieckTopology C₁)
      (J₂ : CategoryTheory.GrothendieckTopology C₂)
      [CategoryTheory.HasWeakSheafify J₁ AddCommGrpCat.{u}]
      [CategoryTheory.HasWeakSheafify J₂ AddCommGrpCat.{u}]
      (B : CategoryTheory.Functor C₁ C₂)
      [B.IsContinuous J₁ J₂]
      (P₁ : CategoryTheory.Functor C₁ᵒᵖ AddCommGrpCat.{u})
      (P₂ : CategoryTheory.Functor C₂ᵒᵖ AddCommGrpCat.{u})
      (μ : ∀ W : C₁, P₁.obj (Opposite.op W) ⟶ P₂.obj (Opposite.op (B.obj W))),
      (∀ {W₁ W₂ : C₁} (u : W₁ ⟶ W₂),
        P₁.map u.op ≫ μ W₁ = μ W₂ ≫ P₂.map (B.map u).op) →
      let L₁ := CategoryTheory.presheafToSheaf J₁ AddCommGrpCat.{u}
      let L₂ := CategoryTheory.presheafToSheaf J₂ AddCommGrpCat.{u}
      let η₁ := (CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}).unit
      let η₂ := (CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).unit
      let pf_B := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₁ J₂
      ∃ β : L₁.obj P₁ ⟶ pf_B.obj (L₂.obj P₂),
        ∀ W : C₁,
          (η₁.app P₁).app (Opposite.op W) ≫ β.hom.app (Opposite.op W) =
            μ W ≫ (η₂.app P₂).app (Opposite.op (B.obj W)) := by
    intro C₁ C₂ _ _ J₁ J₂ _ _ B _ P₁ P₂ μ hμ L₁ L₂ η₁ η₂ pf_B
    let adj₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
    let β_pre : P₁ ⟶ (pf_B.obj (L₂.obj P₂)).obj :=
      { app := fun X_op => μ X_op.unop ≫ (η₂.app P₂).app (Opposite.op (B.obj X_op.unop))
        naturality := fun {X₁ X₂} f_op => by
          rcases X₁ with ⟨W₂⟩
          rcases X₂ with ⟨W₁⟩
          let u : W₁ ⟶ W₂ := f_op.unop
          have hNat₂ : P₂.map (B.map u).op ≫ (η₂.app P₂).app (Opposite.op (B.obj W₁)) =
              (η₂.app P₂).app (Opposite.op (B.obj W₂)) ≫ (L₂.obj P₂).obj.map (B.map u).op :=
            (η₂.app P₂).naturality (B.map u).op
          change P₁.map u.op ≫ (μ W₁ ≫ (η₂.app P₂).app (Opposite.op (B.obj W₁))) =
            (μ W₂ ≫ (η₂.app P₂).app (Opposite.op (B.obj W₂))) ≫
              (L₂.obj P₂).obj.map (B.map u).op
          rw [← CategoryTheory.Category.assoc, hμ u, CategoryTheory.Category.assoc,
            hNat₂, ← CategoryTheory.Category.assoc] }
    let β : L₁.obj P₁ ⟶ pf_B.obj (L₂.obj P₂) :=
      (adj₁.homEquiv P₁ (pf_B.obj (L₂.obj P₂))).symm β_pre
    have hUnit : η₁.app P₁ ≫ β.hom = β_pre :=
      (adj₁.homEquiv_unit P₁ (pf_B.obj (L₂.obj P₂)) β).symm.trans
        (Equiv.apply_symm_apply _ _)
    exact ⟨β, fun W => congrArg (fun τ => τ.app (Opposite.op W)) hUnit⟩

  
  let B_f := weilEtaleSitePullback f
  let B_g := weilEtaleSitePullback g
  let B_f' := weilEtaleSitePullback f'
  let P₁ := CategoryTheory.Functor.comp B_f.op (CategoryTheory.Sheaf.cohomologyPresheaf F q)
  let P₂ := CategoryTheory.Functor.comp B_f'.op
    (CategoryTheory.Sheaf.cohomologyPresheaf (pb_g'.obj F) q)
  set e_fun := weilOuterBCFunIso f g f' g' hgf
  let ρ_W : ∀ W : S.Etale,
      weilPolyP1CohomologyRepSheaf X' (B_f'.obj (B_g.obj W)) ⟶
        pb_g'.obj (weilPolyP1CohomologyRepSheaf X (B_f.obj W)) :=
    fun W => weilPolyP1CohomologyRepPullHom g' (B_f.obj W) (B_f'.obj (B_g.obj W))
      (e_fun.inv.app W)
  let μ : ∀ W : S.Etale, P₁.obj (Opposite.op W) ⟶ P₂.obj (Opposite.op (B_g.obj W)) :=
    fun W => AddCommGrpCat.ofHom
      (((CategoryTheory.Abelian.Ext.mk₀ (ρ_W W)).precomp (pb_g'.obj F) (Nat.zero_add q)).comp
        (pb_g'.mapExtAddHom (weilPolyP1CohomologyRepSheaf X (B_f.obj W)) F q))
  have hμ : ∀ {W₁ W₂ : S.Etale} (u : W₁ ⟶ W₂),
      P₁.map u.op ≫ μ W₁ = μ W₂ ≫ P₂.map (B_g.map u).op := by
    intro W₁ W₂ u
    have hsq : B_f'.map (B_g.map u) ≫ e_fun.inv.app W₂ =
        e_fun.inv.app W₁ ≫ B_g'.map (B_f.map u) :=
      e_fun.inv.naturality u
    have hρ : (R_fun X').map (B_f'.map (B_g.map u)) ≫ ρ_W W₂ =
        ρ_W W₁ ≫ pb_g'.map ((R_fun X).map (B_f.map u)) :=
      hRepPullNat (B_f.map u) (B_f'.map (B_g.map u))
        (e_fun.inv.app W₁) (e_fun.inv.app W₂) hsq
    apply AddCommGrpCat.ext
    intro s
    have hP₁_map : P₁.map u.op =
        ((CategoryTheory.Abelian.extFunctor q).map
          ((R_fun X).op.map (B_f.map u).op)).app F := rfl
    have hP₂_map : P₂.map (B_g.map u).op =
        ((CategoryTheory.Abelian.extFunctor q).map
          ((R_fun X').op.map (B_f'.map (B_g.map u)).op)).app (pb_g'.obj F) := rfl
    have hP₁_eval : (P₁.map u.op).hom s =
        (CategoryTheory.Abelian.Ext.mk₀ ((R_fun X).map (B_f.map u))).comp s (Nat.zero_add q) := by
      rw [hP₁_map, CategoryTheory.Abelian.extFunctor_map_app q ((R_fun X).op.map (B_f.map u).op) F]
      rfl
    let t := ((CategoryTheory.Abelian.Ext.mk₀ (ρ_W W₂)).precomp (pb_g'.obj F) (Nat.zero_add q))
      (pb_g'.mapExtAddHom (weilPolyP1CohomologyRepSheaf X (B_f.obj W₂)) F q s)
    have hP₂_eval : (P₂.map (B_g.map u).op).hom t =
        (CategoryTheory.Abelian.Ext.mk₀ ((R_fun X').map (B_f'.map (B_g.map u)))).comp t
          (Nat.zero_add q) := by
      rw [hP₂_map, CategoryTheory.Abelian.extFunctor_map_app q
        ((R_fun X').op.map (B_f'.map (B_g.map u)).op) (pb_g'.obj F)]
      rfl
    let s₁ := (CategoryTheory.Abelian.Ext.mk₀ ((R_fun X).map (B_f.map u))).comp s (Nat.zero_add q)
    have hLHS_μ : (P₁.map u.op ≫ μ W₁).hom s =
        ((CategoryTheory.Abelian.Ext.mk₀ (ρ_W W₁)).precomp (pb_g'.obj F) (Nat.zero_add q))
          (pb_g'.mapExtAddHom (weilPolyP1CohomologyRepSheaf X (B_f.obj W₁)) F q s₁) := by
      have h1 : (P₁.map u.op ≫ μ W₁).hom s = (μ W₁).hom s₁ :=
        congrArg (μ W₁).hom hP₁_eval
      have h2 : (μ W₁).hom s₁ =
          ((CategoryTheory.Abelian.Ext.mk₀ (ρ_W W₁)).precomp (pb_g'.obj F) (Nat.zero_add q))
            (pb_g'.mapExtAddHom (weilPolyP1CohomologyRepSheaf X (B_f.obj W₁)) F q s₁) :=
        AddMonoidHom.comp_apply _ _ s₁
      exact h1.trans h2
    have hRHS_μ : (μ W₂ ≫ P₂.map (B_g.map u).op).hom s =
        (CategoryTheory.Abelian.Ext.mk₀ ((R_fun X').map (B_f'.map (B_g.map u)))).comp t
          (Nat.zero_add q) := by
      have h1 : (μ W₂).hom s = t := AddMonoidHom.comp_apply _ _ s
      exact (congrArg (P₂.map (B_g.map u).op).hom h1).trans hP₂_eval
    exact hLHS_μ.trans
      ((hExtPrecompComm pb_g' ((R_fun X).map (B_f.map u))
          ((R_fun X').map (B_f'.map (B_g.map u))) (ρ_W W₁) (ρ_W W₂) hρ s).trans
        hRHS_μ.symm)
  obtain ⟨β, hβ⟩ := hSheafifyTranspose S.smallEtaleTopology S'.smallEtaleTopology B_g P₁ P₂ μ hμ
  exact ⟨β, fun W => hβ W⟩

theorem weil_outer_bc_pcc_conn_and_mate_naturality : (∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S)
        {SC₁ SC₂ : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})}
        (hSE₁ : SC₁.ShortExact) (hSE₂ : SC₂.ShortExact) (Φ : SC₁ ⟶ SC₂) (q : ℕ)
        {δ₁ δ₂},
