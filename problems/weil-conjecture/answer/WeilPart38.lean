                  refine Finset.sum_congr rfl fun b _ => Nat.sub_add_cancel (h_le b)
            _ = (∑ _b : Fin pb.dim, M) + (∑ b : Fin pb.dim, b.1) := Finset.sum_add_distrib
            _ = pb.dim * M + (∑ b : Fin pb.dim, b.1) := by
                  simp [Finset.sum_const, smul_eq_mul]
        calc (∑ b : Fin pb.dim, (M + b.1 - (σ b).1))
            = pb.dim * M := by omega
          _ = D₁ * M := by rw [hpb_dim]
      exact hprod_le.trans hsum_eq.le

  
  · intro H x₁ y₁ hG_z hH_z
