        obtain ⟨⟨e_k1_k⟩, _⟩ := hFieldPullH0 π_k1k H_s0 G_k1 hPb_πk1
        have hPb_Hz_comp : WeilIsEtaleSheafPullback (π_Kk ≫ (s_pt 0 ≫ ι'_a)) G H_z := by
          have heq : π_Kk ≫ s_pt a ≫ ι_chart = π_Kk ≫ s_pt 0 ≫ ι'_a := by
