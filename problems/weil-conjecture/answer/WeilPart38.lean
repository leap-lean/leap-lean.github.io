        hTermH0Surj U T_U _hT_U (δ 0) hSurj_post
      have hSurj_Q0 : Function.Surjective (weilOuterTrFibEdgeHom g T_U hT_V 𝒬 0) :=
        ih 𝒬 (fun q hq => False.elim (Nat.not_lt_zero q hq))
      intro z
      obtain ⟨y, hy⟩ := hSurj_δ0 z
      obtain ⟨s, hs⟩ := hSurj_Q0 y
      refine ⟨s.comp hSE.extClass rfl, ?_⟩
      rw [← hCommEdge 0 s, hs, hy]
    | succ k =>
      have hcd1_Q : ∀ q < k + 1, ∀ t : ℕ, 1 < t →
          Subsingleton ((weilEtaleHigherDirectImage g q 𝒬).H t) := by
        intro q hq t ht
        cases q with
        | zero =>
          have hSubA : Subsingleton ((weilEtaleHigherDirectImage g 0 ℱ).H (t + 1)) :=
            hcd1 0 (Nat.zero_lt_succ _) (t + 1) (by omega)
          have hSubC : Subsingleton ((weilEtaleHigherDirectImage g 1 ℱ).H t) :=
            hcd1 1 (Nat.succ_lt_succ (Nat.zero_lt_succ k)) t ht
          exact (weil_outer_tr_fib_abelian_four_term_cd1_shift u₀ v₀ (δ 0) huv₀ hvδ₀
            hEx_uv₀ hEx_vδ₀ Fℤ_U).2 t ht hSubA hSubC
        | succ q' =>
          let e_q : weilEtaleHigherDirectImage g (q' + 1) 𝒬 ≅
              weilEtaleHigherDirectImage g (q' + 2) ℱ :=
            @CategoryTheory.asIso _ _ _ _ (δ (q' + 1)) (hIso_δ (q' + 1) (Nat.succ_pos q'))
          exact hSubIso e_q t (hcd1 (q' + 2) (Nat.succ_lt_succ hq) t ht)
      have hSurj_Qm : Function.Surjective (weilOuterTrFibEdgeHom g T_U hT_V 𝒬 (k + 1)) :=
        ih 𝒬 hcd1_Q
      let e_m : weilEtaleHigherDirectImage g (k + 1) 𝒬 ≅
          weilEtaleHigherDirectImage g (k + 2) ℱ :=
        @CategoryTheory.asIso _ _ _ _ (δ (k + 1)) (hIso_δ (k + 1) (Nat.succ_pos k))
      intro z
      let y := (e_m.inv.hom.app (Opposite.op T_U)).hom z
      have hy : (((δ (k + 1)).hom.app (Opposite.op T_U)).hom) y = z :=
        congrArg (fun φ : _ ⟶ _ => (φ.hom.app (Opposite.op T_U)).hom z) e_m.inv_hom_id
      obtain ⟨s, hs⟩ := hSurj_Qm y
      refine ⟨s.comp hSE.extClass rfl, ?_⟩
      rw [← hCommEdge (k + 1) s, hs, hy]

theorem weil_sing_dev_outer_tr_prime_power_fiber_pullback_equiv (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ_k : (ℓ : k) ≠ 0)
    (Z_bar D_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.IsProper D_bar.hom]
    [IrreducibleSpace ↥D_bar.left]
    (f_bar : Z_bar ⟶ D_bar)
    [AlgebraicGeometry.IsProper f_bar.left]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hSimpConn : ∀ (𝒢 : CategoryTheory.Sheaf D_bar.left.smallEtaleTopology AddCommGrpCat.{u})
       (A₀ : AddCommGrpCat.{u}) [Finite ↥A₀],
      (∀ x : ↥D_bar.left,
        ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ D_bar.left),
          AlgebraicGeometry.Etale w ∧
          x ∈ Set.range w.base ∧
          WeilIsEtaleSheafPullback w 𝒢
            ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)) →
      ∀ (T : D_bar.left.Etale) (hT : CategoryTheory.Limits.IsTerminal T),
        Finite ↥(𝒢.obj.obj (Opposite.op T)) ∧
        CategoryTheory.IsIso
          ((CategoryTheory.constantSheafAdj D_bar.left.smallEtaleTopology
            AddCommGrpCat.{u} hT).counit.app 𝒢))
    (hH1_D : Subsingleton (weilEtaleTorsionH D_bar.left ℓ 1))
    (j_deg : ℕ)
    (hLocConst : ∀ q ≤ j_deg,
      ∃ (A₀ : AddCommGrpCat.{u}) (_ : Finite ↥A₀),
        ∀ x : ↥D_bar.left,
          ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ D_bar.left),
            AlgebraicGeometry.Etale w ∧
            x ∈ Set.range w.base ∧
            WeilIsEtaleSheafPullback w
              (weilEtaleHigherDirectImage f_bar.left q (weilEtaleTorsionSheaf Z_bar.left ℓ))
              ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀))
    (hKerConst : ∀ q ≤ j_deg,
      ∀ (B : AddCommGrpCat.{u}) [Finite ↥B]
        (φ : ((CategoryTheory.constantSheaf D_bar.left.smallEtaleTopology AddCommGrpCat.{u}).obj B) ⟶
          weilEtaleHigherDirectImage f_bar.left (q + 1) (weilEtaleTorsionSheaf Z_bar.left ℓ)),
        ∃ (B₀ : AddCommGrpCat.{u}) (_ : Finite ↥B₀),
          Nonempty (((CategoryTheory.constantSheaf D_bar.left.smallEtaleTopology
            AddCommGrpCat.{u}).obj B₀) ≅ CategoryTheory.Limits.kernel φ))
    (U_bar : D_bar.left.Opens)
    (hU_ne : Nonempty ↥U_bar.toScheme)
    (hH_aff : ∀ q : ℕ, 1 < q → Subsingleton (weilEtaleTorsionH U_bar.toScheme ℓ q))
    (y₁ y₂ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U_bar.toScheme)
    (hy₁ : (y₁ ≫ U_bar.ι) ≫ D_bar.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hy₂ : (y₂ ≫ U_bar.ι) ≫ D_bar.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z₁ Z₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Z₁.hom]
    [AlgebraicGeometry.IsProper Z₂.hom]
    (ι₁ : Z₁.left ⟶ (f_bar.left ⁻¹ᵁ U_bar).toScheme)
    (ι₂ : Z₂.left ⟶ (f_bar.left ⁻¹ᵁ U_bar).toScheme)
    (hPb₁ : CategoryTheory.IsPullback (ι₁ ≫ (f_bar.left ⁻¹ᵁ U_bar).ι)
      Z₁.hom f_bar.left (y₁ ≫ U_bar.ι))
    (hPb₂ : CategoryTheory.IsPullback (ι₂ ≫ (f_bar.left ⁻¹ᵁ U_bar).ι)
      Z₂.hom f_bar.left (y₂ ≫ U_bar.ι))
    (r : ℕ)
    (p₁ : weilEtaleTorsionH (f_bar.left ⁻¹ᵁ U_bar).toScheme
      (ℓ ^ r) j_deg →+ weilEtaleTorsionH Z₁.left (ℓ ^ r) j_deg)
    (p₂ : weilEtaleTorsionH (f_bar.left ⁻¹ᵁ U_bar).toScheme
      (ℓ ^ r) j_deg →+ weilEtaleTorsionH Z₂.left (ℓ ^ r) j_deg)
    (hp₁ : WeilIsTorsionEtalePullback ι₁ (ℓ ^ r) j_deg p₁)
    (hp₂ : WeilIsTorsionEtalePullback ι₂ (ℓ ^ r) j_deg p₂) :
    Function.Surjective p₁ ∧ Function.Surjective p₂ ∧
    ∀ w : weilEtaleTorsionH (f_bar.left ⁻¹ᵁ U_bar).toScheme
      (ℓ ^ r) j_deg, (p₁ w = 0 ↔ p₂ w = 0) :=
by
  let _ := hPBC
  let _ := hy₁
  let _ := hy₂
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let D := D_bar.left
  let Z := Z_bar.left
  let f := f_bar.left
  let U := U_bar.toScheme
  let V_open := f ⁻¹ᵁ U_bar
  let V := V_open.toScheme
  let g : V ⟶ U := f ∣_ U_bar

  
  
  
  have _ : Nonempty ↥D := IrreducibleSpace.toNonempty
  have _ : PreconnectedSpace ↥D := inferInstance
  have hU_preirred : PreirreducibleSpace ↥U :=
    ⟨PreirreducibleSpace.isPreirreducible_univ.preimage U_bar.ι.isOpenEmbedding⟩
  have _ : PreconnectedSpace ↥U := @PreirreducibleSpace.preconnectedSpace _ _ hU_preirred
  have _ : Nonempty ↥U := hU_ne

  have hPb_res : CategoryTheory.IsPullback V_open.ι g f U_bar.ι :=
    (AlgebraicGeometry.isPullback_morphismRestrict f U_bar).flip
  have _ : AlgebraicGeometry.IsProper g :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hPb_res (inferInstance : AlgebraicGeometry.IsProper f)

  have hComm₁ : ι₁ ≫ g = Z₁.hom ≫ y₁ := by
    rw [← CategoryTheory.cancel_mono U_bar.ι, CategoryTheory.Category.assoc,
      AlgebraicGeometry.morphismRestrict_ι, ← CategoryTheory.Category.assoc,
      hPb₁.w, CategoryTheory.Category.assoc]
  have hPb₁_U : CategoryTheory.IsPullback ι₁ Z₁.hom g y₁ :=
    CategoryTheory.IsPullback.of_right hPb₁ hComm₁ hPb_res

  have hComm₂ : ι₂ ≫ g = Z₂.hom ≫ y₂ := by
    rw [← CategoryTheory.cancel_mono U_bar.ι, CategoryTheory.Category.assoc,
      AlgebraicGeometry.morphismRestrict_ι, ← CategoryTheory.Category.assoc,
      hPb₂.w, CategoryTheory.Category.assoc]
  have hPb₂_U : CategoryTheory.IsPullback ι₂ Z₂.hom g y₂ :=
    CategoryTheory.IsPullback.of_right hPb₂ hComm₂ hPb_res

  
  
  
  obtain ⟨_, hCompPBC, hCancelPBC, hAffineLocPBC, hArrowIsoPBC⟩ :=
    weil_pbc_canonical_calculus_and_extraction.{u} ℓ
  obtain ⟨hIsoP0, hVieta⟩ := weil_vieta_binary_form_cover_projSpace k
  have hLFT_Proj : ∀ (N : ℕ),
      AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
    intro N
    dsimp [weilProjectiveSpaceOver]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hSurj₀ : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro p
      have hp1 : p.1 ∈ (1 : Submodule k (MvPolynomial (Fin (N + 1)) k)) := by
        rw [← MvPolynomial.homogeneousSubmodule_zero]
        exact p.2
      obtain ⟨c, hc⟩ := Submodule.mem_one.mp hp1
      exact ⟨c, Subtype.ext hc⟩
    have hFT₀ : (algebraMap k ↥(𝒜 0)).FiniteType :=
      RingHom.FiniteType.of_surjective _ hSurj₀
    have _ : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hFT₀
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      @IsScalarTower.of_algebraMap_eq k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) _ _ _ _ _ _
        (fun _ => rfl)
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have _ : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      inferInstance
    exact inferInstance
  have hProjSpacePBC : ∀ (N : ℕ)
      (B : CategoryTheory.Over S_k)
      [AlgebraicGeometry.LocallyOfFiniteType B.hom],
      WeilCanonicalModPrimePBC ℓ
        (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k N).hom) := by
    intro N
    induction N with
    | zero =>
      intro B _
      have : CategoryTheory.IsIso (weilProjectiveSpaceOver k 0).hom := hIsoP0
      let p₀ := CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 0).hom
      have : CategoryTheory.IsIso p₀ := inferInstance
      have : AlgebraicGeometry.IsFinite p₀ := inferInstance
      exact weil_pbc_finite_morphism ℓ p₀
    | succ m ih =>
      intro B _
      let P_m := weilProjectiveSpaceOver k m
      let P_1 := weilProjectiveSpaceOver k 1
      let P_succ := weilProjectiveSpaceOver k (m + 1)
      let p_mB := CategoryTheory.Limits.pullback.fst B.hom P_m.hom
      have : AlgebraicGeometry.LocallyOfFiniteType P_m.hom := hLFT_Proj m
      have : AlgebraicGeometry.LocallyOfFiniteType p_mB := inferInstance
      let B_m : CategoryTheory.Over S_k := CategoryTheory.Over.mk (p_mB ≫ B.hom)
      have : AlgebraicGeometry.LocallyOfFiniteType B_m.hom := by
        dsimp [B_m]; infer_instance
      let p_1Bm := CategoryTheory.Limits.pullback.fst B_m.hom P_1.hom
      have hPBC_1Bm : WeilCanonicalModPrimePBC ℓ p_1Bm := by
        apply hAffineLocPBC
        intro U_aff hU_aff
        let B_U : CategoryTheory.Over S_k := CategoryTheory.Over.mk (U_aff.ι ≫ B_m.hom)
        have : AlgebraicGeometry.IsAffine B_U.left := hU_aff
        have : AlgebraicGeometry.LocallyOfFiniteType B_U.hom := by
          dsimp [B_U]; infer_instance
        have hBU : WeilCanonicalModPrimePBC ℓ
            (CategoryTheory.Limits.pullback.fst B_U.hom P_1.hom) :=
          weil_pbc_projLine_over_affine_finiteType k ℓ hℓ_k B_U
        have hpb_u : CategoryTheory.IsPullback
            (p_1Bm ∣_ U_aff)
            ((p_1Bm ⁻¹ᵁ U_aff).ι ≫ CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom)
            B_U.hom P_1.hom :=
          (AlgebraicGeometry.isPullback_morphismRestrict p_1Bm U_aff).paste_vert
            (CategoryTheory.IsPullback.of_hasPullback B_m.hom P_1.hom)
        refine hArrowIsoPBC (p_1Bm ∣_ U_aff)
          (CategoryTheory.Limits.pullback.fst B_U.hom P_1.hom)
          hpb_u.isoPullback (CategoryTheory.Iso.refl _) ?_ hBU
        rw [hpb_u.isoPullback_hom_fst, CategoryTheory.Iso.refl_hom,
          CategoryTheory.Category.comp_id]
      have hPBC_mB : WeilCanonicalModPrimePBC ℓ p_mB := ih B
      have hPBC_tower : WeilCanonicalModPrimePBC ℓ (p_1Bm ≫ p_mB) :=
        hCompPBC p_1Bm p_mB hPBC_1Bm hPBC_mB
      obtain ⟨μ, hFin_μ, hSurj_μ, hw_μ⟩ := hVieta m
      let P_m1_hom := CategoryTheory.Limits.pullback.fst P_m.hom P_1.hom ≫ P_m.hom
      let μ_B : CategoryTheory.Limits.pullback B.hom P_m1_hom ⟶
          CategoryTheory.Limits.pullback B.hom P_succ.hom :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst B.hom P_m1_hom)
          (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom ≫ μ)
          (by rw [CategoryTheory.Category.assoc, hw_μ,
                CategoryTheory.Limits.pullback.condition])
      have hμ_fst : μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom =
          CategoryTheory.Limits.pullback.fst B.hom P_m1_hom :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hμ_snd : μ_B ≫ CategoryTheory.Limits.pullback.snd B.hom P_succ.hom =
          CategoryTheory.Limits.pullback.snd B.hom P_m1_hom ≫ μ :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hpb_μB : CategoryTheory.IsPullback
          μ_B
          (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom)
          (CategoryTheory.Limits.pullback.snd B.hom P_succ.hom)
          μ := by
        refine CategoryTheory.IsPullback.of_right ?_ hμ_snd
          (CategoryTheory.IsPullback.of_hasPullback B.hom P_succ.hom)
        rw [hμ_fst]
        have h_outer : CategoryTheory.IsPullback
            (CategoryTheory.Limits.pullback.fst B.hom P_m1_hom)
            (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom)
            B.hom (μ ≫ P_succ.hom) := by
          rw [hw_μ]
          exact CategoryTheory.IsPullback.of_hasPullback B.hom P_m1_hom
        exact h_outer
      have : AlgebraicGeometry.IsFinite μ_B :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_μB.flip hFin_μ
      have hSurj_μB : AlgebraicGeometry.Surjective μ_B :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_μB.flip hSurj_μ
      have hPBC_μB : WeilCanonicalModPrimePBC ℓ μ_B :=
        weil_pbc_finite_morphism ℓ μ_B
      let α_ass : CategoryTheory.Limits.pullback B_m.hom P_1.hom ⟶
          CategoryTheory.Limits.pullback P_m.hom P_1.hom :=
        CategoryTheory.Limits.pullback.lift
          (p_1Bm ≫ CategoryTheory.Limits.pullback.snd B.hom P_m.hom)
          (CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom)
          (by
            rw [CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition]
            exact CategoryTheory.Limits.pullback.condition)
      have hpb_left : CategoryTheory.IsPullback
          p_1Bm α_ass
          (CategoryTheory.Limits.pullback.snd B.hom P_m.hom)
          (CategoryTheory.Limits.pullback.fst P_m.hom P_1.hom) := by
        refine CategoryTheory.IsPullback.of_bot ?_
          (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
          (CategoryTheory.IsPullback.of_hasPullback P_m.hom P_1.hom)
        rw [CategoryTheory.Limits.pullback.lift_snd]
        have h_eq : CategoryTheory.Limits.pullback.snd B.hom P_m.hom ≫ P_m.hom = B_m.hom :=
          (CategoryTheory.Limits.pullback.condition (f := B.hom) (g := P_m.hom)).symm
        rw [h_eq]
        exact CategoryTheory.IsPullback.of_hasPullback B_m.hom P_1.hom
      have hpb_assoc : CategoryTheory.IsPullback
          (p_1Bm ≫ p_mB) α_ass B.hom P_m1_hom :=
        hpb_left.paste_horiz (CategoryTheory.IsPullback.of_hasPullback B.hom P_m.hom)
      have hPBC_comp_μB : WeilCanonicalModPrimePBC ℓ
          (μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom) := by
        refine hArrowIsoPBC
          (μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom)
          (p_1Bm ≫ p_mB)
          hpb_assoc.isoPullback.symm (CategoryTheory.Iso.refl B.left) ?_ hPBC_tower
        rw [CategoryTheory.Iso.symm_hom, hpb_assoc.isoPullback_inv_fst, hμ_fst,
          CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id]
      exact hCancelPBC μ_B (CategoryTheory.Limits.pullback.fst B.hom P_succ.hom)
        hSurj_μB hPBC_μB hPBC_comp_μB
  have hCanonOfProper : ∀ (X₀ S₀ : CategoryTheory.Over S_k)
      [AlgebraicGeometry.LocallyOfFiniteType S₀.hom]
      (f₀ : X₀ ⟶ S₀) [hf₀ : AlgebraicGeometry.IsProper f₀.left],
      WeilCanonicalModPrimePBC ℓ f₀.left := by
    intro X₀ S₀ _ f₀ hf₀
    apply hAffineLocPBC
    intro U_aff hU_aff
    let S_U : CategoryTheory.Over S_k := CategoryTheory.Over.mk (U_aff.ι ≫ S₀.hom)
    let X_U : CategoryTheory.Over S_k :=
      CategoryTheory.Over.mk ((f₀.left ⁻¹ᵁ U_aff).ι ≫ X₀.hom)
    let f_U : X_U ⟶ S_U :=
      CategoryTheory.Over.homMk (f₀.left ∣_ U_aff) (by
        dsimp [X_U, S_U]
        rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          CategoryTheory.Category.assoc, CategoryTheory.Over.w f₀])
    have : AlgebraicGeometry.IsAffine S_U.left := hU_aff
    have : AlgebraicGeometry.LocallyOfFiniteType S_U.hom := by
      dsimp [S_U]; infer_instance
    have : AlgebraicGeometry.IsProper f_U.left := by
      dsimp [f_U]
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (AlgebraicGeometry.isPullback_morphismRestrict f₀.left U_aff).flip hf₀
    have : AlgebraicGeometry.LocallyOfFiniteType f_U.left := inferInstance
    have : AlgebraicGeometry.LocallyOfFiniteType X_U.hom := by
      have hw : f_U.left ≫ S_U.hom = X_U.hom := CategoryTheory.Over.w f_U
      rw [← hw]; infer_instance
    obtain ⟨N, _, ι_X, ι_S, hFin_X, hFin_S, hSurj_π, hComm⟩ :=
      weil_relative_chow_projective_factorization k X_U S_U f_U
    have : AlgebraicGeometry.IsFinite ι_X := hFin_X
    have : AlgebraicGeometry.IsFinite ι_S := hFin_S
    let p_NX := CategoryTheory.Limits.pullback.fst X_U.hom (weilProjectiveSpaceOver k N).hom
    let p_NS := CategoryTheory.Limits.pullback.fst S_U.hom (weilProjectiveSpaceOver k N).hom
    let π := ι_X ≫ p_NX
    have hPBC_π : WeilCanonicalModPrimePBC ℓ π :=
      hCompPBC ι_X p_NX (weil_pbc_finite_morphism ℓ ι_X) (hProjSpacePBC N X_U)
    have hPBC_ιS : WeilCanonicalModPrimePBC ℓ (ι_S ≫ p_NS) :=
      hCompPBC ι_S p_NS (weil_pbc_finite_morphism ℓ ι_S) (hProjSpacePBC N S_U)
    have hPBC_πf : WeilCanonicalModPrimePBC ℓ (π ≫ f_U.left) := by
      dsimp [π]
      rwa [hComm]
    exact hCancelPBC π f_U.left hSurj_π hPBC_π hPBC_πf

  have hCanonPBC_f : WeilCanonicalModPrimePBC ℓ f :=
    hCanonOfProper Z_bar D_bar f_bar
  let U_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (U_bar.ι ≫ D_bar.hom)
  let V_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (V_open.ι ≫ Z_bar.hom)
  let g_ov : V_ov ⟶ U_ov :=
    CategoryTheory.Over.homMk g (by
      dsimp [V_ov, U_ov, g, V_open]
      rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        CategoryTheory.Category.assoc, CategoryTheory.Over.w f_bar])
  have _ : AlgebraicGeometry.LocallyOfFiniteType U_ov.hom := by
    dsimp [U_ov]; infer_instance
  have _ : AlgebraicGeometry.IsProper g_ov.left := by
    change AlgebraicGeometry.IsProper g; infer_instance
  have hCanonPBC_g : WeilCanonicalModPrimePBC ℓ g :=
    hCanonOfProper V_ov U_ov g_ov

  
  
  
  obtain ⟨hSiteExact, -, -, -, -, -⟩ :=
    weil_etale_site_pullback_exact_and_mod_prime_resolution.{u} ℓ
  let _ : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      (weilEtaleSitePullback h).IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology :=
    fun h => (hSiteExact h).choose
  let _ : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology).IsRightAdjoint :=
    fun h => (hSiteExact h).choose_spec.choose
  let _ : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      CategoryTheory.Limits.PreservesFiniteLimits
        ((weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
          Y₂.smallEtaleTopology Y₁.smallEtaleTopology) :=
    fun h => (hSiteExact h).choose_spec.choose_spec.1

  let T_std : ∀ (Y : AlgebraicGeometry.Scheme.{u}), Y.Etale :=
    fun Y => AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id Y)
  let hT_std : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal (T_std Y) := fun Y =>
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun E => CategoryTheory.MorphismProperty.Over.homMk E.hom
        (CategoryTheory.Category.comp_id E.hom))
      (fun E m => CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id m.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w m))
        (Subsingleton.elim _ _))
  let hT_pull : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂) (T₂ : Y₂.Etale),
      CategoryTheory.Limits.IsTerminal T₂ →
      CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback h).obj T₂) :=
    fun {Y₁ Y₂} h T₂ hT₂ =>
      let e₂ : T₂ ≅ T_std Y₂ := CategoryTheory.Limits.IsTerminal.uniqueUpToIso hT₂ (hT_std Y₂)
      let g_hom : T₂.left ⟶ Y₂ := e₂.hom.left
      let g_inv : Y₂ ⟶ T₂.left := e₂.inv.left
      have hg_eq : g_hom = T₂.hom :=
        (CategoryTheory.Category.comp_id g_hom).symm.trans
          (CategoryTheory.MorphismProperty.Over.w e₂.hom)
      have h_id₁ : CategoryTheory.CategoryStruct.comp T₂.hom g_inv =
          CategoryTheory.CategoryStruct.id T₂.left :=
        (congrArg (fun k => CategoryTheory.CategoryStruct.comp k g_inv) hg_eq.symm).trans
          (congrArg (fun m : T₂ ⟶ T₂ => m.left) e₂.hom_inv_id)
      have h_id₂ : CategoryTheory.CategoryStruct.comp g_inv T₂.hom =
          CategoryTheory.CategoryStruct.id Y₂ :=
        (congrArg (CategoryTheory.CategoryStruct.comp g_inv) hg_eq.symm).trans
          (congrArg (fun m : T_std Y₂ ⟶ T_std Y₂ => m.left) e₂.inv_hom_id)
      let σ_inv : Y₁ ⟶ CategoryTheory.Limits.pullback T₂.hom h :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.CategoryStruct.comp h g_inv)
          (CategoryTheory.CategoryStruct.id Y₁)
          (by rw [CategoryTheory.Category.assoc, h_id₂,
                  CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      have h_pb_id₁ : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.snd T₂.hom h) σ_inv =
          CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.pullback T₂.hom h) := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc,
              ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
              h_id₁]
          exact CategoryTheory.Category.comp_id _
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let BT := (weilEtaleSitePullback h).obj T₂
      let φ_iso : BT.left ≅ Y₁ :=
        { hom := CategoryTheory.Limits.pullback.snd T₂.hom h
          inv := σ_inv
          hom_inv_id := h_pb_id₁
          inv_hom_id := CategoryTheory.Limits.pullback.lift_snd _ _ _ }
      let iso₁ : BT ≅ T_std Y₁ :=
        CategoryTheory.MorphismProperty.Over.isoMk φ_iso
          (CategoryTheory.Category.comp_id BT.hom)
      CategoryTheory.Limits.IsTerminal.ofIso (hT_std Y₁) iso₁.symm

  have hConstPbIso : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂)
      {T₁ : Y₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      {T₂ : Y₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (A : AddCommGrpCat.{u}),
      CategoryTheory.IsIso (weilEtaleConstPullbackHom h hT₁ hT₂ A) := by
    intro Y₁ Y₂ h T₁ hT₁ T₂ hT₂ A
    let B := weilEtaleSitePullback h
    let J₁ := Y₁.smallEtaleTopology
    let J₂ := Y₂.smallEtaleTopology
    let pf := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let pb := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
    let adj_h := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
    let Γ₁ := (CategoryTheory.sheafSections J₁ AddCommGrpCat.{u}).obj (Opposite.op T₁)
    let Γ₂ := (CategoryTheory.sheafSections J₂ AddCommGrpCat.{u}).obj (Opposite.op T₂)
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let hT_B : CategoryTheory.Limits.IsTerminal (B.obj T₂) := hT_pull h T₂ hT₂
    let e_τ : B.obj T₂ ≅ T₁ := CategoryTheory.Limits.IsTerminal.uniqueUpToIso hT_B hT₁
    let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
    have hτ_eq : e_τ.hom = τ := hT₁.hom_ext _ _
    let e_Γ : Γ₁ ≅ pf ⋙ Γ₂ :=
      { hom :=
          { app := fun G => G.obj.map τ.op
            naturality := fun _ _ φ => (φ.hom.naturality τ.op).symm }
        inv :=
          { app := fun G => G.obj.map e_τ.inv.op
            naturality := fun _ _ φ => (φ.hom.naturality e_τ.inv.op).symm }
        hom_inv_id := by
          ext G : 2
          change G.obj.map τ.op ≫ G.obj.map e_τ.inv.op = 𝟙 _
          rw [← G.obj.map_comp, ← op_comp, ← hτ_eq, e_τ.inv_hom_id, op_id, G.obj.map_id]
        inv_hom_id := by
          ext G : 2
          change G.obj.map e_τ.inv.op ≫ G.obj.map τ.op = 𝟙 _
          rw [← G.obj.map_comp, ← op_comp, ← hτ_eq, e_τ.hom_inv_id, op_id, G.obj.map_id] }
    let adj_comp : C₂ ⋙ pb ⊣ pf ⋙ Γ₂ := adj₂.comp adj_h
    let adj₁' : C₁ ⊣ pf ⋙ Γ₂ := adj₁.ofNatIsoRight e_Γ
    let iso_L : C₂ ⋙ pb ≅ C₁ := adj_comp.leftAdjointUniq adj₁'
    have heq : weilEtaleConstPullbackHom h hT₁ hT₂ A = iso_L.hom.app A := by
      apply (adj_comp.homEquiv A (C₁.obj A)).injective
      rw [CategoryTheory.Adjunction.homEquiv_leftAdjointUniq_hom_app]
      change (adj₂.homEquiv A (pf.obj (C₁.obj A)))
          ((adj_h.homEquiv (C₂.obj A) (C₁.obj A))
            ((adj_h.homEquiv (C₂.obj A) (C₁.obj A)).symm
              ((adj₂.homEquiv A (pf.obj (C₁.obj A))).symm
                (adj₁.unit.app A ≫ (C₁.obj A).obj.map τ.op)))) =
        adj₁'.unit.app A
      rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
      dsimp [adj₁', e_Γ, CategoryTheory.Adjunction.ofNatIsoRight]
    rw [heq]
    infer_instance

  
  
  
  have hSubIso : ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (t : ℕ)
      {X₁ X₂ : CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}}
      (e : X₁ ≅ X₂), Subsingleton (X₂.H t) → Subsingleton (X₁.H t) := by
    intro S₀ t X₁ X₂ e hSub
    refine subsingleton_of_forall_eq 0 fun x => ?_
    have hx : x.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero t) = 0 :=
      @Subsingleton.elim _ hSub _ 0
    calc
      x = x.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id X₁))
            (Nat.add_zero t) := (CategoryTheory.Abelian.Ext.comp_mk₀_id x).symm
      _ = x.comp (CategoryTheory.Abelian.Ext.mk₀ (e.hom ≫ e.inv)) (Nat.add_zero t) := by
            rw [e.hom_inv_id]
      _ = x.comp ((CategoryTheory.Abelian.Ext.mk₀ e.hom).comp
            (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero 0)) (Nat.add_zero t) := by
            rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      _ = (x.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero t)).comp
            (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero t) :=
          (CategoryTheory.Abelian.Ext.comp_assoc x _ _
            (Nat.add_zero t) (Nat.add_zero 0) (Nat.add_zero t)).symm
      _ = 0 := by rw [hx, CategoryTheory.Abelian.Ext.zero_comp]

  have hConstJH : ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (t : ℕ),
      Subsingleton (weilEtaleTorsionH S₀ ℓ t) →
      ∀ (s : ℕ) (A : AddCommGrpCat.{u}) [Finite ↥A],
        (ℓ ^ s) • CategoryTheory.CategoryStruct.id A = 0 →
        Subsingleton
          (((CategoryTheory.constantSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}).obj A).H t) := by
    intro S₀ t hHt
    let C_S := CategoryTheory.constantSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}
    have : CategoryTheory.Limits.PreservesFiniteLimits C_S := by
      dsimp [C_S, CategoryTheory.constantSheaf]; infer_instance
    have : CategoryTheory.Limits.PreservesFiniteColimits C_S := by
      dsimp [C_S, CategoryTheory.constantSheaf]; infer_instance
    have : C_S.Additive := by
      dsimp [C_S, CategoryTheory.constantSheaf]; infer_instance
    let Fℤ_S := C_S.obj (AddCommGrpCat.of (ULift.{u} ℤ))
    have hSubSE : ∀ {SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u})} (hSC : SC.ShortExact),
        Subsingleton (SC.X₁.H t) → Subsingleton (SC.X₃.H t) → Subsingleton (SC.X₂.H t) := by
      intro SC hSC h₁ h₃
      refine subsingleton_of_forall_eq 0 fun x₂ => ?_
      have hx₃ : x₂.comp (CategoryTheory.Abelian.Ext.mk₀ SC.g) (Nat.add_zero t) = 0 :=
        @Subsingleton.elim _ h₃ _ 0
      obtain ⟨x₁, hx₁⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_S hSC x₂ hx₃
      have hx₁0 : x₁ = 0 := @Subsingleton.elim _ h₁ _ 0
      rw [← hx₁, hx₁0, CategoryTheory.Abelian.Ext.zero_comp]
    let AM_ℓ : AddCommGrpCat.{u} :=
      AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    let E_vec : ℕ → AddCommGrpCat.{u} :=
      fun d => AddCommGrpCat.of (Fin d → ULift.{u} (ZMod ℓ))
    have hVec : ∀ d : ℕ, Subsingleton ((C_S.obj (E_vec d)).H t) := by
      intro d
      induction d with
      | zero =>
        have hZeroE : CategoryTheory.Limits.IsZero (E_vec 0) :=
          (CategoryTheory.Limits.IsZero.iff_id_eq_zero (E_vec 0)).mpr
            (AddCommGrpCat.ext fun f => funext fun j => Fin.elim0 j)
        exact CategoryTheory.Sheaf.subsingleton_H_of_isZero (C_S.map_isZero hZeroE) t
      | succ d ih =>
        let fst_d : E_vec (d + 1) ⟶ AM_ℓ := AddCommGrpCat.ofHom
          { toFun := fun g_v => g_v 0
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
        let snd_d : E_vec (d + 1) ⟶ E_vec d := AddCommGrpCat.ofHom
          { toFun := fun g_v i => g_v i.succ
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
        let inl_d : AM_ℓ ⟶ E_vec (d + 1) := AddCommGrpCat.ofHom
          { toFun := fun a => Fin.cases a (fun _ => 0)
            map_zero' := funext fun j => by cases j using Fin.cases <;> rfl
            map_add' := fun x y => funext fun j => by cases j using Fin.cases <;> simp }
        let inr_d : E_vec d ⟶ E_vec (d + 1) := AddCommGrpCat.ofHom
          { toFun := fun f_v => Fin.cases 0 f_v
            map_zero' := funext fun j => by cases j using Fin.cases <;> rfl
            map_add' := fun x y => funext fun j => by cases j using Fin.cases <;> simp }
        have hId : fst_d ≫ inl_d + snd_d ≫ inr_d = 𝟙 (E_vec (d + 1)) :=
          AddCommGrpCat.ext fun g_v => funext fun j => by
            change Fin.cases (g_v 0) (fun _ => 0) j +
              Fin.cases 0 (fun i => g_v i.succ) j = g_v j
            cases j using Fin.cases <;> simp
        have hId_sh : C_S.map fst_d ≫ C_S.map inl_d + C_S.map snd_d ≫ C_S.map inr_d =
            𝟙 (C_S.obj (E_vec (d + 1))) := by
          rw [← C_S.map_comp, ← C_S.map_comp, ← C_S.map_add, hId, C_S.map_id]
        refine subsingleton_of_forall_eq 0 fun z => ?_
        have hz₁ : z.comp (CategoryTheory.Abelian.Ext.mk₀ (C_S.map fst_d)) (Nat.add_zero t) = 0 :=
          @Subsingleton.elim (weilEtaleTorsionH S₀ ℓ t) hHt _ 0
        have hz₂ : z.comp (CategoryTheory.Abelian.Ext.mk₀ (C_S.map snd_d)) (Nat.add_zero t) = 0 :=
          @Subsingleton.elim _ ih _ 0
        have h₁ :
            z.comp (CategoryTheory.Abelian.Ext.mk₀ (C_S.map fst_d ≫ C_S.map inl_d))
              (Nat.add_zero t) = 0 := by
          rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            ← CategoryTheory.Abelian.Ext.comp_assoc z _ _
              (Nat.add_zero t) (Nat.add_zero 0) (Nat.add_zero t),
            hz₁, CategoryTheory.Abelian.Ext.zero_comp]
        have h₂ :
            z.comp (CategoryTheory.Abelian.Ext.mk₀ (C_S.map snd_d ≫ C_S.map inr_d))
              (Nat.add_zero t) = 0 := by
          rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            ← CategoryTheory.Abelian.Ext.comp_assoc z _ _
              (Nat.add_zero t) (Nat.add_zero 0) (Nat.add_zero t),
            hz₂, CategoryTheory.Abelian.Ext.zero_comp]
        calc
          z = z.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 (C_S.obj (E_vec (d + 1)))))
                (Nat.add_zero t) := (CategoryTheory.Abelian.Ext.comp_mk₀_id z).symm
          _ = z.comp (CategoryTheory.Abelian.Ext.mk₀
                (C_S.map fst_d ≫ C_S.map inl_d + C_S.map snd_d ≫ C_S.map inr_d))
                (Nat.add_zero t) := by rw [hId_sh]
          _ = z.comp
                (CategoryTheory.Abelian.Ext.mk₀ (C_S.map fst_d ≫ C_S.map inl_d) +
                 CategoryTheory.Abelian.Ext.mk₀ (C_S.map snd_d ≫ C_S.map inr_d))
                (Nat.add_zero t) := by
                rw [CategoryTheory.Abelian.Ext.mk₀_add]
          _ = z.comp (CategoryTheory.Abelian.Ext.mk₀ (C_S.map fst_d ≫ C_S.map inl_d))
                (Nat.add_zero t) +
              z.comp (CategoryTheory.Abelian.Ext.mk₀ (C_S.map snd_d ≫ C_S.map inr_d))
                (Nat.add_zero t) := CategoryTheory.Abelian.Ext.comp_add _ _ _ _
          _ = 0 := by rw [h₁, h₂, add_zero]
    have hPrime : ∀ (B : AddCommGrpCat.{u}) [Finite ↥B],
        ℓ • CategoryTheory.CategoryStruct.id B = 0 →
        Subsingleton ((C_S.obj B).H t) := by
      intro B _ hB
      have hB_el : ∀ x : ↥B, ℓ • x = 0 := fun x => by
        simpa using congrArg (fun m : B ⟶ B => m.hom x) hB
      let _ : Module (ZMod ℓ) ↥B := AddCommGroup.zmodModule hB_el
      let ι_B := Module.Basis.ofVectorSpaceIndex (ZMod ℓ) ↥B
      let b₀ : Module.Basis ι_B (ZMod ℓ) ↥B := Module.Basis.ofVectorSpace (ZMod ℓ) ↥B
      let _ : Finite ι_B := inferInstance
      let e_idx := Finite.equivFin ι_B
      let d := Nat.card ι_B
      let b : Module.Basis (Fin d) (ZMod ℓ) ↥B := b₀.reindex e_idx
      let e₁ : ↥B ≃+ (Fin d → ZMod ℓ) :=
        b.repr.toAddEquiv.trans
          (Finsupp.linearEquivFunOnFinite (ZMod ℓ) (ZMod ℓ) (Fin d)).toAddEquiv
      let e₂ : (Fin d → ZMod ℓ) ≃+ (Fin d → ULift.{u} (ZMod ℓ)) :=
        { toFun := fun f_v i => ULift.up (f_v i)
          invFun := fun g_v i => (g_v i).down
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl
          map_add' := fun _ _ => rfl }
      let e := e₁.trans e₂
      let isoB : B ≅ E_vec d :=
        { hom := AddCommGrpCat.ofHom e.toAddMonoidHom
          inv := AddCommGrpCat.ofHom e.symm.toAddMonoidHom
          hom_inv_id := AddCommGrpCat.ext fun x => e.symm_apply_apply x
          inv_hom_id := AddCommGrpCat.ext fun y => e.apply_symm_apply y }
      exact hSubIso S₀ t (C_S.mapIso isoB) (hVec d)
    intro s
    induction s with
    | zero =>
      intro A _ hA
      have hZeroA : CategoryTheory.Limits.IsZero A :=
        (CategoryTheory.Limits.IsZero.iff_id_eq_zero A).mpr
          (by simpa only [pow_zero, one_smul] using hA)
      exact CategoryTheory.Sheaf.subsingleton_H_of_isZero (C_S.map_isZero hZeroA) t
    | succ s ih =>
      intro A _ hA
      let μ_ℓ : ↥A →+ ↥A :=
        { toFun := fun a => ℓ • a
          map_zero' := smul_zero ℓ
          map_add' := fun x y => smul_add ℓ x y }
      let K : AddCommGrpCat.{u} := AddCommGrpCat.of ↥μ_ℓ.ker
      let I : AddCommGrpCat.{u} := AddCommGrpCat.of ↥μ_ℓ.range
      let i_K : K ⟶ A := AddCommGrpCat.ofHom μ_ℓ.ker.subtype
      let p_I : A ⟶ I := AddCommGrpCat.ofHom μ_ℓ.rangeRestrict
      have hcomp0 : i_K ≫ p_I = 0 :=
        AddCommGrpCat.ext fun x => Subtype.ext x.2
      have hMono_i : CategoryTheory.Mono i_K := by
        rw [AddCommGrpCat.mono_iff_injective]
        exact Subtype.val_injective
      have hEpi_p : CategoryTheory.Epi p_I := by
        rw [AddCommGrpCat.epi_iff_surjective]
        exact μ_ℓ.rangeRestrict_surjective
      have hk : CategoryTheory.Limits.IsLimit
          (CategoryTheory.Limits.KernelFork.ofι i_K hcomp0) :=
        CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
          (fun {W} s_f hs => AddCommGrpCat.ofHom
            { toFun := fun w => ⟨s_f.hom w, congrArg (fun m : W ⟶ I => (m.hom w).1) hs⟩
              map_zero' := Subtype.ext (map_zero s_f.hom)
              map_add' := fun x y => Subtype.ext (map_add s_f.hom x y) })
          (fun _ _ => AddCommGrpCat.ext fun _ => rfl)
          (fun {_} _ _ m hm => AddCommGrpCat.ext fun w =>
            Subtype.ext (congrArg (fun m' : _ ⟶ A => m'.hom w) hm))
      have hSE_A : (CategoryTheory.ShortComplex.mk i_K p_I hcomp0).ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hk) hMono_i hEpi_p
      have hSE_sh : ((CategoryTheory.ShortComplex.mk i_K p_I hcomp0).map C_S).ShortExact :=
        hSE_A.map_of_exact C_S
      have hK_ann : ℓ • CategoryTheory.CategoryStruct.id K = 0 :=
        AddCommGrpCat.ext fun x => Subtype.ext x.2
      have hI_ann : (ℓ ^ s) • CategoryTheory.CategoryStruct.id I = 0 :=
        AddCommGrpCat.ext fun y => Subtype.ext (by
          rcases y with ⟨_, a, rfl⟩
          change (ℓ ^ s) • (ℓ • a) = 0
          rw [← mul_smul, ← pow_succ]
          simpa using congrArg (fun m : A ⟶ A => m.hom a) hA)
      exact hSubSE hSE_sh (hPrime K hK_ann) (ih I hI_ann)

  
  
  
  let T_D : D.Etale := T_std D
  let hT_D : CategoryTheory.Limits.IsTerminal T_D := hT_std D
  let T_U : U.Etale := T_std U
  let hT_U : CategoryTheory.Limits.IsTerminal T_U := hT_std U
  let T_k : S_k.Etale := T_std S_k
  let hT_k : CategoryTheory.Limits.IsTerminal T_k := hT_std S_k
  let hT_V : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback g).obj T_U) :=
    hT_pull g T_U hT_U
  let hT_Z₁ : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback Z₁.hom).obj T_k) :=
    hT_pull Z₁.hom T_k hT_k
  let hT_Z₂ : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback Z₂.hom).obj T_k) :=
    hT_pull Z₂.hom T_k hT_k

  have hH1_const_D : ∀ (C₀ : AddCommGrpCat.{u}) [Finite ↥C₀],
      ℓ • CategoryTheory.CategoryStruct.id C₀ = 0 →
      Subsingleton
        (((CategoryTheory.constantSheaf D.smallEtaleTopology AddCommGrpCat.{u}).obj C₀).H 1) :=
    fun C₀ _ hC₀ => hConstJH D 1 hH1_D 1 C₀ (by simpa only [pow_one] using hC₀)

  have hConst_D : ∀ (q : ℕ) (_hq : q ≤ j_deg),
      let R_qr := weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf Z (ℓ ^ r))
      let A_qr := R_qr.obj.obj (Opposite.op T_D)
      Finite ↥A_qr ∧
      (ℓ ^ r) • CategoryTheory.CategoryStruct.id A_qr = 0 ∧
      CategoryTheory.IsIso
        ((CategoryTheory.constantSheafAdj D.smallEtaleTopology AddCommGrpCat.{u}
          hT_D).counit.app R_qr) :=
    fun q hq => weil_outer_tr_fib_bockstein_global_const_on_base
      Z D f ℓ T_D hT_D
      (fun 𝒢 A₀ _ hCov => hSimpConn 𝒢 A₀ hCov T_D hT_D)
      hH1_const_D j_deg hLocConst hKerConst r q hq

  let C_U := CategoryTheory.constantSheaf U.smallEtaleTopology AddCommGrpCat.{u}
  let pb_U := (weilEtaleSitePullback U_bar.ι).sheafPullback AddCommGrpCat.{u}
    D.smallEtaleTopology U.smallEtaleTopology
  let R_D := fun q : ℕ => weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf Z (ℓ ^ r))
  let A_D := fun q : ℕ => (R_D q).obj.obj (Opposite.op T_D)
  let 𝒢_U := fun q : ℕ => weilEtaleHigherDirectImage g q (weilEtaleTorsionSheaf V (ℓ ^ r))

  have hIso_U : ∀ (q : ℕ), q ≤ j_deg →
      Nonempty (C_U.obj (A_D q) ≅ 𝒢_U q) := by
    intro q hq
    obtain ⟨_, _, hIso_counit⟩ := hConst_D q hq
    let e_D_q : ((CategoryTheory.constantSheaf D.smallEtaleTopology AddCommGrpCat.{u}).obj
        (A_D q)) ≅ R_D q :=
      @CategoryTheory.asIso _ _ _ _
        ((CategoryTheory.constantSheafAdj D.smallEtaleTopology AddCommGrpCat.{u}
          hT_D).counit.app (R_D q))
        hIso_counit
    have hIso_π : CategoryTheory.IsIso
        (weilEtaleConstPullbackHom U_bar.ι hT_U hT_D (A_D q)) :=
      hConstPbIso U_bar.ι hT_U hT_D (A_D q)
    let e_π : pb_U.obj ((CategoryTheory.constantSheaf D.smallEtaleTopology AddCommGrpCat.{u}).obj
        (A_D q)) ≅ C_U.obj (A_D q) :=
      @CategoryTheory.asIso _ _ _ _
        (weilEtaleConstPullbackHom U_bar.ι hT_U hT_D (A_D q)) hIso_π
    obtain ⟨bcIso_U, -⟩ :=
      weil_outer_tr_fib_prime_power_beck_chevalley_and_edge_pullback
        ℓ f U_bar.ι g V_open.ι hPb_res hCanonPBC_f r q
    exact ⟨e_π.symm.trans ((pb_U.mapIso e_D_q).trans bcIso_U)⟩

  have hcd1_U : ∀ q < j_deg, ∀ t : ℕ, 1 < t → Subsingleton ((𝒢_U q).H t) := by
    intro q hq_lt t ht
    have hq_le : q ≤ j_deg := Nat.le_of_lt hq_lt
    obtain ⟨hFin_q, hAnn_q, _⟩ := hConst_D q hq_le
    let _ : Finite ↥(A_D q) := hFin_q
    obtain ⟨e_Uq⟩ := hIso_U q hq_le
    have hSub_const : Subsingleton ((C_U.obj (A_D q)).H t) :=
      hConstJH U t (hH_aff t ht) r (A_D q) hAnn_q
    exact hSubIso U t e_Uq.symm hSub_const

  let edge_g := weilOuterTrFibEdgeHom g T_U hT_V (weilEtaleTorsionSheaf V (ℓ ^ r)) j_deg
  have hEdge_surj : Function.Surjective edge_g :=
    weil_outer_tr_fib_leray_syzygy_edge_surjective
      g T_U hT_U hT_V j_deg (weilEtaleTorsionSheaf V (ℓ ^ r)) hcd1_U

  
  
  
  obtain ⟨hSpecEdgeBij, hConstEvalBij⟩ :=
    weil_outer_tr_fib_algClosed_spec_edge_and_const_eval_bijective.{u} k
  let A_star := A_D j_deg
  let 𝒢_star := 𝒢_U j_deg
  let e_U_star : C_U.obj A_star ≅ 𝒢_star := Classical.choice (hIso_U j_deg (le_refl j_deg))

  have hIsoBij : ∀ {X Y : AddCommGrpCat.{u}} (α : X ≅ Y), Function.Bijective α.hom.hom := by
    intro X Y α
    refine ⟨fun x₁ x₂ h => ?_, fun y => ⟨α.inv.hom y, ?_⟩⟩
    · have h' := congrArg α.inv.hom h
      have h1 := congrArg (fun m : X ⟶ X => m.hom x₁) α.hom_inv_id
      have h2 := congrArg (fun m : X ⟶ X => m.hom x₂) α.hom_inv_id
      exact h1.symm.trans (h'.trans h2)
    · exact congrArg (fun m : Y ⟶ Y => m.hom y) α.inv_hom_id

  have hBuildFibEval : ∀ (y : S_k ⟶ U)
      (Z_a : CategoryTheory.Over S_k)
      (ι_a : Z_a.left ⟶ V)
      (hPb_a_U : CategoryTheory.IsPullback ι_a Z_a.hom g y)
      (hT_Za : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback Z_a.hom).obj T_k))
      (p_a : weilEtaleTorsionH V (ℓ ^ r) j_deg →+ weilEtaleTorsionH Z_a.left (ℓ ^ r) j_deg)
      (hp_a : WeilIsTorsionEtalePullback ι_a (ℓ ^ r) j_deg p_a),
      ∃ ev_a : ↥(𝒢_star.obj.obj (Opposite.op T_U)) →+ weilEtaleTorsionH Z_a.left (ℓ ^ r) j_deg,
        Function.Bijective ev_a ∧ ∀ w : weilEtaleTorsionH V (ℓ ^ r) j_deg, ev_a (edge_g w) = p_a w := by
    intro y Z_a ι_a hPb_a_U hT_Za p_a hp_a
    let B_y := weilEtaleSitePullback y
    let pf_y := B_y.sheafPushforwardContinuous AddCommGrpCat.{u}
      U.smallEtaleTopology S_k.smallEtaleTopology
    let pb_y := B_y.sheafPullback AddCommGrpCat.{u}
      U.smallEtaleTopology S_k.smallEtaleTopology
    let adj_y := B_y.sheafAdjunctionContinuous AddCommGrpCat.{u}
      U.smallEtaleTopology S_k.smallEtaleTopology
    let hT_By : CategoryTheory.Limits.IsTerminal (B_y.obj T_U) := hT_pull y T_U hT_U
    let e_Tk : B_y.obj T_U ≅ T_k := CategoryTheory.Limits.IsTerminal.uniqueUpToIso hT_By hT_k
    let H_a := weilEtaleHigherDirectImage Z_a.hom j_deg (weilEtaleTorsionSheaf Z_a.left (ℓ ^ r))
    obtain ⟨bcIso_a, hTri_a⟩ :=
      weil_outer_tr_fib_prime_power_beck_chevalley_and_edge_pullback
        ℓ g y Z_a.hom ι_a hPb_a_U hCanonPBC_g r j_deg
    have hTri := hTri_a T_U hT_U T_k hT_k hT_By hT_V hT_Za p_a hp_a
    have hUnitConst_bij : Function.Bijective
        (((adj_y.unit.app (C_U.obj A_star)).hom.app (Opposite.op T_U)).hom) :=
      hConstEvalBij U y T_U hT_U hT_By A_star
    let α_in : (C_U.obj A_star).obj.obj (Opposite.op T_U) ≅ 𝒢_star.obj.obj (Opposite.op T_U) :=
      ((CategoryTheory.sheafSections U.smallEtaleTopology AddCommGrpCat.{u}).obj
        (Opposite.op T_U)).mapIso e_U_star
    let α_out : (pf_y.obj (pb_y.obj (C_U.obj A_star))).obj.obj (Opposite.op T_U) ≅
        (pf_y.obj (pb_y.obj 𝒢_star)).obj.obj (Opposite.op T_U) :=
      ((CategoryTheory.sheafSections U.smallEtaleTopology AddCommGrpCat.{u}).obj
        (Opposite.op T_U)).mapIso (pf_y.mapIso (pb_y.mapIso e_U_star))
    have hNat := congrArg
      (fun φ : C_U.obj A_star ⟶ pf_y.obj (pb_y.obj 𝒢_star) => φ.hom.app (Opposite.op T_U))
      (adj_y.unit.naturality e_U_star.hom)
    change α_in.hom ≫ (adj_y.unit.app 𝒢_star).hom.app (Opposite.op T_U) =
      (adj_y.unit.app (C_U.obj A_star)).hom.app (Opposite.op T_U) ≫ α_out.hom at hNat
    have hUnitG_eq : (adj_y.unit.app 𝒢_star).hom.app (Opposite.op T_U) =
        α_in.inv ≫ (adj_y.unit.app (C_U.obj A_star)).hom.app (Opposite.op T_U) ≫ α_out.hom := by
      rw [← hNat, ← CategoryTheory.Category.assoc, α_in.inv_hom_id,
          CategoryTheory.Category.id_comp]
    have hUnitG_bij :
        Function.Bijective (((adj_y.unit.app 𝒢_star).hom.app (Opposite.op T_U)).hom) := by
      have hcomp_coe :
          ⇑(((adj_y.unit.app 𝒢_star).hom.app (Opposite.op T_U)).hom) =
            ⇑α_out.hom.hom ∘
              ⇑(((adj_y.unit.app (C_U.obj A_star)).hom.app (Opposite.op T_U)).hom) ∘
              ⇑α_in.inv.hom := by
        funext s
        exact congrArg (fun m : 𝒢_star.obj.obj (Opposite.op T_U) ⟶
          (pf_y.obj (pb_y.obj 𝒢_star)).obj.obj (Opposite.op T_U) => m.hom s) hUnitG_eq
      rw [hcomp_coe]
      exact (hIsoBij α_out).comp (hUnitConst_bij.comp (hIsoBij α_in.symm))
    let α_bc : (pb_y.obj 𝒢_star).obj.obj (Opposite.op (B_y.obj T_U)) ≅
        H_a.obj.obj (Opposite.op (B_y.obj T_U)) :=
      ((CategoryTheory.sheafSections S_k.smallEtaleTopology AddCommGrpCat.{u}).obj
        (Opposite.op (B_y.obj T_U))).mapIso bcIso_a
    let α_map : H_a.obj.obj (Opposite.op (B_y.obj T_U)) ≅ H_a.obj.obj (Opposite.op T_k) :=
      H_a.obj.mapIso e_Tk.op.symm
    let β_a : ↥(𝒢_star.obj.obj (Opposite.op T_U)) →+ ↥(H_a.obj.obj (Opposite.op T_k)) :=
      α_map.hom.hom.comp (α_bc.hom.hom.comp
        (((adj_y.unit.app 𝒢_star).hom.app (Opposite.op T_U)).hom))
    have hβ_bij : Function.Bijective β_a :=
      (hIsoBij α_map).comp ((hIsoBij α_bc).comp hUnitG_bij)
    let edge_a := weilOuterTrFibEdgeHom Z_a.hom T_k hT_Za
      (weilEtaleTorsionSheaf Z_a.left (ℓ ^ r)) j_deg
    have hEdge_a_bij : Function.Bijective edge_a :=
      hSpecEdgeBij Z_a.left Z_a.hom T_k hT_k hT_Za
        (weilEtaleTorsionSheaf Z_a.left (ℓ ^ r)) j_deg
    let e_edge_a : weilEtaleTorsionH Z_a.left (ℓ ^ r) j_deg ≃+
        ↥(H_a.obj.obj (Opposite.op T_k)) :=
      AddEquiv.ofBijective edge_a hEdge_a_bij
    let ev_a : ↥(𝒢_star.obj.obj (Opposite.op T_U)) →+
        weilEtaleTorsionH Z_a.left (ℓ ^ r) j_deg :=
      e_edge_a.symm.toAddMonoidHom.comp β_a
    have hev_bij : Function.Bijective ev_a := e_edge_a.symm.bijective.comp hβ_bij
    refine ⟨ev_a, hev_bij, fun w => ?_⟩
    apply e_edge_a.injective
    change e_edge_a (e_edge_a.symm (β_a (edge_g w))) = edge_a (p_a w)
    rw [e_edge_a.apply_symm_apply]
    exact hTri w

  obtain ⟨ev₁, hev₁_bij, hev₁_eq⟩ := hBuildFibEval y₁ Z₁ ι₁ hPb₁_U hT_Z₁ p₁ hp₁
  obtain ⟨ev₂, hev₂_bij, hev₂_eq⟩ := hBuildFibEval y₂ Z₂ ι₂ hPb₂_U hT_Z₂ p₂ hp₂

  have hp₁_surj : Function.Surjective p₁ := by
    intro z₁
    obtain ⟨s, hs⟩ := hev₁_bij.2 z₁
    obtain ⟨w, rfl⟩ := hEdge_surj s
    exact ⟨w, (hev₁_eq w).symm.trans hs⟩
  have hp₂_surj : Function.Surjective p₂ := by
    intro z₂
    obtain ⟨s, hs⟩ := hev₂_bij.2 z₂
    obtain ⟨w, rfl⟩ := hEdge_surj s
    exact ⟨w, (hev₂_eq w).symm.trans hs⟩

  refine ⟨hp₁_surj, hp₂_surj, fun w => ?_⟩
  rw [← hev₁_eq w, ← hev₂_eq w]
  constructor
  · intro h1
    have hs0 : edge_g w = 0 := hev₁_bij.1 (h1.trans (map_zero ev₁).symm)
    rw [hs0, map_zero]
  · intro h2
    have hs0 : edge_g w = 0 := hev₂_bij.1 (h2.trans (map_zero ev₂).symm)
    rw [hs0, map_zero]

theorem weil_sing_dev_outer_smooth_closed_point_traces (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom]
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom]
    (hProj_Ztilde : IsProjectiveOverField F Z_tilde)
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.Flat f₀.left]
    [AlgebraicGeometry.IsProper f₀.left]
    [AlgebraicGeometry.Surjective f₀.left]
    (hFibIrred : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver F 1).left),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback f₀.left s))
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_u₀.hom]
    [AlgebraicGeometry.IsProper Z_u₀.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_u₀.hom]
    (hProj_Zu₀ : IsProjectiveOverField F Z_u₀)
    (ι_Zu₀ : Z_u₀.left ⟶ Z_tilde.left)
    (hPb_Zu₀ : CategoryTheory.IsPullback ι_Zu₀ Z_u₀.hom f₀.left u₀)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (h1d : WeilSingDevIs1dPencilOdpDatum F m Z_tilde f₀ u₀ j_aff s_inf S_aff U₀)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (i : ℕ) (hi_le : i ≤ 2 * (2 * m + 1)) (hi_ne : i ≠ 2 * m + 1)
    (M_Zu_i : WeilEllAdicCohomologyModel F Z_u₀ ℓ i)
    (d : ℕ) (P_poly : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly)
    (hd : 1 ≤ d) :
    let _ : Fact (Irreducible P_poly) := ⟨hP.2.1⟩
    ∀ (hFin_P : Finite (AdjoinRoot P_poly)),
      let _ : Finite (AdjoinRoot P_poly) := hFin_P
      ∀ (M_ZP_i : WeilEllAdicCohomologyModel (AdjoinRoot P_poly)
          (weilTransvTriClosedPointFiber F f₀ j_aff P_poly) ℓ i)
        (k : ℕ),
        1 ≤ k →
        LinearMap.trace (Padic ℓ) M_ZP_i.V (M_ZP_i.frob ^ k) =
          LinearMap.trace (Padic ℓ) M_Zu_i.V ((M_Zu_i.frob ^ d) ^ k) :=
by
  classical
  
  
  have hTorsionZMod : ∀ (S₀ : AlgebraicGeometry.Scheme.{u})
      (ℓ₀ : ℕ) [Fact (Nat.Prime ℓ₀)] (i₀ : ℕ),
      (∀ (r : ℕ) (u : weilEtaleTorsionH S₀ (ℓ₀ ^ r) i₀), (ℓ₀ ^ r) • u = 0) ∧
      (∀ (z : PadicInt ℓ₀) (x : ↥(weilEtaleIntegralSystem S₀ ℓ₀ i₀)),
        (fun r => (PadicInt.toZModPow r z).val • x.1 r) ∈ weilEtaleIntegralSystem S₀ ℓ₀ i₀) := by
    clear * -
    intro S₀ ℓ₀ _ i₀
    have hAnn : ∀ (m₀ : ℕ) (u : weilEtaleTorsionH S₀ m₀ i₀), m₀ • u = 0 := by
      intro m₀ u
      let J := S₀.smallEtaleTopology
      let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
      let Fℤ := C.obj (AddCommGrpCat.of (ULift.{u} ℤ))
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
      let FM := weilEtaleTorsionSheaf S₀ m₀
      have hm_AM : m₀ • (CategoryTheory.CategoryStruct.id AM) = 0 := by
        ext ⟨x⟩
        change ULift.up (m₀ • x) = ULift.up 0
        simp
      have _ : C.Additive := inferInstance
      have hm_FM : m₀ • (CategoryTheory.CategoryStruct.id FM) = 0 := by
        rw [← C.map_id, ← C.map_nsmul, hm_AM, C.map_zero]
      have hmk0_nsmul : ∀ (k₀ : ℕ) (f : FM ⟶ FM),
          CategoryTheory.Abelian.Ext.mk₀ (k₀ • f) = k₀ • CategoryTheory.Abelian.Ext.mk₀ f := by
        intro k₀ f
        induction k₀ with
        | zero => simp [CategoryTheory.Abelian.Ext.mk₀_zero]
        | succ k₀ ih =>
          rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add, ih]
      calc m₀ • u
          = m₀ • (u.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id FM))
              (Nat.add_zero i₀)) := by
              rw [CategoryTheory.Abelian.Ext.comp_mk₀_id]
        _ = u.comp (m₀ • CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id FM))
              (Nat.add_zero i₀) :=
              (map_nsmul (u.precomp FM (Nat.add_zero i₀)) m₀ _).symm
        _ = u.comp (CategoryTheory.Abelian.Ext.mk₀ (m₀ • CategoryTheory.CategoryStruct.id FM))
              (Nat.add_zero i₀) := by
              rw [hmk0_nsmul]
        _ = 0 := by
              rw [hm_FM, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
    refine ⟨fun r u => hAnn (ℓ₀ ^ r) u, fun z x => ?_⟩
    dsimp only [weilEtaleIntegralSystem]
    rw [AddMonoidHom.mem_ker]
    ext r
    simp only [AddMonoidHom.pi_apply, AddMonoidHom.sub_apply, AddMonoidHom.comp_apply,
      Pi.evalAddMonoidHom_apply, Pi.zero_apply, sub_eq_zero]
    have hx_r : weilEtaleTorsionTransition S₀ ℓ₀ r i₀ (x.1 (r + 1)) = x.1 r := by
      have hx_mem := x.2
      dsimp only [weilEtaleIntegralSystem] at hx_mem
      rw [AddMonoidHom.mem_ker] at hx_mem
      have hr := congrFun hx_mem r
      simpa only [AddMonoidHom.pi_apply, AddMonoidHom.sub_apply, AddMonoidHom.comp_apply,
        Pi.evalAddMonoidHom_apply, Pi.zero_apply, sub_eq_zero] using hr
    rw [map_nsmul, hx_r]
    have hPrime : Nat.Prime ℓ₀ := Fact.out
    have _ : NeZero (ℓ₀ ^ r) := ⟨pow_ne_zero r hPrime.ne_zero⟩
    have _ : NeZero (ℓ₀ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hPrime.ne_zero⟩
    have hcast : ZMod.castHom (pow_dvd_pow ℓ₀ (Nat.le_succ r)) (ZMod (ℓ₀ ^ r))
        (PadicInt.toZModPow (r + 1) z) = PadicInt.toZModPow r z := by
      have hc := @PadicInt.zmod_cast_comp_toZModPow ℓ₀ _ r (r + 1) (Nat.le_succ r)
      exact RingHom.congr_fun hc z
    have hmod : (PadicInt.toZModPow (r + 1) z).val % (ℓ₀ ^ r) = (PadicInt.toZModPow r z).val := by
      have hnat : PadicInt.toZModPow (r + 1) z =
          ((PadicInt.toZModPow (r + 1) z).val : ZMod (ℓ₀ ^ (r + 1))) :=
        (ZMod.natCast_zmod_val _).symm
      have hcast' := hcast
      conv_lhs at hcast' => rw [hnat]
      rw [map_natCast] at hcast'
      have hval := congrArg ZMod.val hcast'
      rwa [ZMod.val_natCast] at hval
    have hdiv := Nat.div_add_mod ((PadicInt.toZModPow (r + 1) z).val) (ℓ₀ ^ r)
    conv_lhs => rw [← hdiv, hmod]
    rw [add_nsmul, mul_comm, mul_nsmul', hAnn (ℓ₀ ^ r) (x.1 r), smul_zero, zero_add]

  have hMemIntegral : ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (ℓ₀ i₀ : ℕ)
      (g : ∀ r : ℕ, weilEtaleTorsionH S₀ (ℓ₀ ^ r) i₀),
      g ∈ weilEtaleIntegralSystem S₀ ℓ₀ i₀ ↔
        ∀ r : ℕ, weilEtaleTorsionTransition S₀ ℓ₀ r i₀ (g (r + 1)) = g r := by
    clear * -
    intro S₀ ℓ₀ i₀ g
    dsimp only [weilEtaleIntegralSystem]
    rw [AddMonoidHom.mem_ker]
    refine ⟨fun h r => ?_, fun h => ?_⟩
    · have hr := congrFun h r
      simpa only [AddMonoidHom.pi_apply, AddMonoidHom.sub_apply, AddMonoidHom.comp_apply,
        Pi.evalAddMonoidHom_apply, Pi.zero_apply, sub_eq_zero] using hr
    · ext r
      simpa only [AddMonoidHom.pi_apply, AddMonoidHom.sub_apply, AddMonoidHom.comp_apply,
        Pi.evalAddMonoidHom_apply, Pi.zero_apply, sub_eq_zero] using h r

  have hAbstractEquiv : ∀ (ℓ₀ : ℕ) [Fact (Nat.Prime ℓ₀)] (d₀ : ℕ)
      (H_X H_Y : ℕ → Type u)
      [∀ r, AddCommGroup (H_X r)] [∀ r, AddCommGroup (H_Y r)]
      (trans_X : ∀ r, H_X (r + 1) →+ H_X r)
      (trans_Y : ∀ r, H_Y (r + 1) →+ H_Y r)
      (L_X : AddSubgroup (∀ r, H_X r))
      (L_Y : AddSubgroup (∀ r, H_Y r))
      (hLX : ∀ g : (∀ r, H_X r), g ∈ L_X ↔ ∀ r, trans_X r (g (r + 1)) = g r)
      (hLY : ∀ g : (∀ r, H_Y r), g ∈ L_Y ↔ ∀ r, trans_Y r (g (r + 1)) = g r)
      (hZMod_X : ∀ (z : PadicInt ℓ₀) (x : ↥L_X),
        (fun r => (PadicInt.toZModPow r z).val • x.1 r) ∈ L_X)
      (frobT_X : ∀ r, H_X r →+ H_X r)
      (frobT_Y : ∀ r, H_Y r →+ H_Y r)
      (hfrobT_X_trans : ∀ (r : ℕ) (u : H_X (r + 1)),
        trans_X r (frobT_X (r + 1) u) = frobT_X r (trans_X r u))
      (V_X V_Y : Type u)
      [AddCommGroup V_X] [Module (Padic ℓ₀) V_X]
      [AddCommGroup V_Y] [Module (Padic ℓ₀) V_Y]
      (frob_X : V_X →ₗ[Padic ℓ₀] V_X)
      (frob_Y : V_Y →ₗ[Padic ℓ₀] V_Y)
      (equiv_X : TensorProduct ℤ ℚ ↥L_X ≃+ V_X)
      (equiv_Y : TensorProduct ℤ ℚ ↥L_Y ≃+ V_Y)
      (hsmul_X : ∀ (z : PadicInt ℓ₀) (x y : ↥L_X),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
          equiv_X (TensorProduct.tmul ℤ (1 : ℚ) y) =
            (z : Padic ℓ₀) • equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x))
      (hsmul_Y : ∀ (z : PadicInt ℓ₀) (x y : ↥L_Y),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
          equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) y) =
            (z : Padic ℓ₀) • equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) x))
      (hfrob_X : ∀ (x y : ↥L_X),
        (∀ r : ℕ, y.1 r = frobT_X r (x.1 r)) →
          frob_X (equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x)) =
            equiv_X (TensorProduct.tmul ℤ (1 : ℚ) y))
      (hfrob_Y : ∀ (x y : ↥L_Y),
        (∀ r : ℕ, y.1 r = frobT_Y r (x.1 r)) →
          frob_Y (equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) x)) =
            equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) y))
      (e_tors : ∀ r : ℕ, H_X r ≃+ H_Y r)
      (he_trans : ∀ (r : ℕ) (u : H_X (r + 1)),
        trans_Y r (e_tors (r + 1) u) = e_tors r (trans_X r u))
      (he_frob : ∀ (r : ℕ) (u : H_X r),
        e_tors r ((⇑(frobT_X r))^[d₀] u) = frobT_Y r (e_tors r u)),
      ∃ e : V_X ≃ₗ[Padic ℓ₀] V_Y,
        ∀ v : V_X, e ((frob_X ^ d₀) v) = frob_Y (e v) := by
    clear * -
    intro ℓ₀ _ d₀ H_X H_Y _ _ trans_X trans_Y L_X L_Y hLX hLY hZMod_X frobT_X frobT_Y
      hfrobT_X_trans V_X V_Y _ _ _ _ frob_X frob_Y equiv_X equiv_Y hsmul_X hsmul_Y
      hfrob_X hfrob_Y e_tors he_trans he_frob
    have he_symm_trans : ∀ (r : ℕ) (v : H_Y (r + 1)),
        trans_X r ((e_tors (r + 1)).symm v) = (e_tors r).symm (trans_Y r v) := by
      intro r v
      apply (e_tors r).injective
      rw [(e_tors r).apply_symm_apply, ← he_trans, (e_tors (r + 1)).apply_symm_apply]
    let e_L : ↥L_X ≃+ ↥L_Y :=
      { toFun := fun x => ⟨fun r => e_tors r (x.1 r),
          (hLY _).mpr fun r => by rw [he_trans, (hLX x.1).mp x.2 r]⟩
        invFun := fun y => ⟨fun r => (e_tors r).symm (y.1 r),
          (hLX _).mpr fun r => by rw [he_symm_trans, (hLY y.1).mp y.2 r]⟩
        left_inv := fun x => Subtype.ext (funext fun r => (e_tors r).symm_apply_apply _)
        right_inv := fun y => Subtype.ext (funext fun r => (e_tors r).apply_symm_apply _)
        map_add' := fun x₁ x₂ => Subtype.ext (funext fun r => map_add (e_tors r) _ _) }
    let e_Q : TensorProduct ℤ ℚ ↥L_X ≃ₗ[ℤ] TensorProduct ℤ ℚ ↥L_Y :=
      TensorProduct.congr (LinearEquiv.refl ℤ ℚ) e_L.toIntLinearEquiv
    let f₀_add : V_X ≃+ V_Y := (equiv_X.symm.trans e_Q.toAddEquiv).trans equiv_Y
    have hf₀_pure : ∀ (q : ℚ) (x : ↥L_X),
        f₀_add (equiv_X (TensorProduct.tmul ℤ q x)) = equiv_Y (TensorProduct.tmul ℤ q (e_L x)) := by
      intro q x
      simp [f₀_add, e_Q]
    have hequiv_X_rat : ∀ (q : ℚ) (t : TensorProduct ℤ ℚ ↥L_X),
        equiv_X (q • t) = (q : Padic ℓ₀) • equiv_X t :=
      fun q t => map_ratCast_smul equiv_X.toAddMonoidHom ℚ (Padic ℓ₀) q t
    have hequiv_Y_rat : ∀ (q : ℚ) (t : TensorProduct ℤ ℚ ↥L_Y),
        equiv_Y (q • t) = (q : Padic ℓ₀) • equiv_Y t :=
      fun q t => map_ratCast_smul equiv_Y.toAddMonoidHom ℚ (Padic ℓ₀) q t
    have hf₀_rat : ∀ (q : ℚ) (v : V_X),
        f₀_add ((q : Padic ℓ₀) • v) = (q : Padic ℓ₀) • f₀_add v :=
      fun q v => map_ratCast_smul f₀_add.toAddMonoidHom (Padic ℓ₀) (Padic ℓ₀) q v
    have hf₀_padicInt : ∀ (z : PadicInt ℓ₀) (v : V_X),
        f₀_add ((z : Padic ℓ₀) • v) = (z : Padic ℓ₀) • f₀_add v := by
      intro z v
      obtain ⟨t, rfl⟩ := equiv_X.surjective v
      induction t using TensorProduct.inductionOn with
      | tmul q x =>
        have hqt : TensorProduct.tmul ℤ q x = q • TensorProduct.tmul ℤ (1 : ℚ) x := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        have hqt_Y : TensorProduct.tmul ℤ q (e_L x) = q • TensorProduct.tmul ℤ (1 : ℚ) (e_L x) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        let x_z : ↥L_X := ⟨fun r => (PadicInt.toZModPow r z).val • x.1 r, hZMod_X z x⟩
        have hx_z_X : equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x_z) =
            (z : Padic ℓ₀) • equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x) :=
          hsmul_X z x x_z (fun _ => rfl)
        have hx_z_Y : equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) (e_L x_z)) =
            (z : Padic ℓ₀) • equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) (e_L x)) :=
          hsmul_Y z (e_L x) (e_L x_z) (fun r => map_nsmul (e_tors r) _ _)
        rw [hqt, hequiv_X_rat, smul_comm (z : Padic ℓ₀) (q : Padic ℓ₀), hf₀_rat, ← hx_z_X,
          hf₀_pure, hx_z_Y, ← smul_comm (z : Padic ℓ₀) (q : Padic ℓ₀), ← hequiv_Y_rat, ← hqt_Y,
          ← hf₀_pure]
        rw [hqt, hequiv_X_rat]
      | add t₁ t₂ ih₁ ih₂ =>
        rw [map_add, smul_add, map_add, ih₁, ih₂, map_add, smul_add]
    have hf₀_smul : ∀ (c : Padic ℓ₀) (v : V_X), f₀_add (c • v) = c • f₀_add v := by
      intro c v
      have hPrime : Nat.Prime ℓ₀ := Fact.out
      have hℓ_gt1 : (1 : ℝ) < (ℓ₀ : ℝ) := by exact_mod_cast hPrime.one_lt
      obtain ⟨k₀, hk₀⟩ := pow_unbounded_of_one_lt ‖c‖ hℓ_gt1
      have hnorm_le : ‖((ℓ₀ : Padic ℓ₀) ^ k₀) * c‖ ≤ 1 := by
        rw [norm_mul, norm_pow, Padic.norm_p]
        by_cases hc0 : c = 0
        · simp [hc0]
        · have hpos : (0 : ℝ) < (ℓ₀ : ℝ) ^ k₀ := by positivity
          rw [inv_pow, inv_mul_le_iff₀ hpos, mul_one]
          exact hk₀.le
      let z₀ : PadicInt ℓ₀ := ⟨((ℓ₀ : Padic ℓ₀) ^ k₀) * c, hnorm_le⟩
      let q_inv : ℚ := ((ℓ₀ ^ k₀ : ℕ) : ℚ)⁻¹
      have hc_eq : c = (q_inv : Padic ℓ₀) * (z₀ : Padic ℓ₀) := by
        have hz₀_coe : (z₀ : Padic ℓ₀) = ((ℓ₀ : Padic ℓ₀) ^ k₀) * c := rfl
        rw [hz₀_coe]
        dsimp [q_inv]
        push_cast
        rw [← mul_assoc, inv_mul_cancel₀ (pow_ne_zero k₀ (Nat.cast_ne_zero.mpr hPrime.ne_zero)),
          one_mul]
      rw [hc_eq, mul_smul, hf₀_rat q_inv, hf₀_padicInt z₀, ← mul_smul]
    let e : V_X ≃ₗ[Padic ℓ₀] V_Y := { f₀_add with map_smul' := hf₀_smul }
    refine ⟨e, fun v => ?_⟩
    have hIter : ∀ (n : ℕ) (x : ↥L_X),
        ∃ x_n : ↥L_X,
          (∀ r : ℕ, x_n.1 r = (⇑(frobT_X r))^[n] (x.1 r)) ∧
          (frob_X ^ n) (equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x)) =
            equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x_n) := by
      intro n x
      induction n with
      | zero =>
        exact ⟨x, fun _ => rfl, by simp⟩
      | succ n ih =>
        obtain ⟨x_n, hx_n_eq, hx_n_frob⟩ := ih
        let x_succ : ↥L_X :=
          ⟨fun r => frobT_X r (x_n.1 r),
           (hLX _).mpr fun r => by rw [hfrobT_X_trans, (hLX x_n.1).mp x_n.2 r]⟩
        refine ⟨x_succ, fun r => ?_, ?_⟩
        · change frobT_X r (x_n.1 r) = (⇑(frobT_X r))^[n + 1] (x.1 r)
          rw [hx_n_eq r, Function.iterate_succ_apply']
        · rw [pow_succ', Module.End.mul_apply, hx_n_frob]
          exact hfrob_X x_n x_succ (fun _ => rfl)
    obtain ⟨t, rfl⟩ := equiv_X.surjective v
    induction t using TensorProduct.inductionOn with
    | tmul q x =>
      obtain ⟨x_d, hx_d_eq, hx_d_frob⟩ := hIter d₀ x
      have hqt : TensorProduct.tmul ℤ q x = q • TensorProduct.tmul ℤ (1 : ℚ) x := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      have hy_frob : frob_Y (equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) (e_L x))) =
          equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) (e_L x_d)) := by
        apply hfrob_Y (e_L x) (e_L x_d)
        intro r
        change e_tors r (x_d.1 r) = frobT_Y r (e_tors r (x.1 r))
        rw [hx_d_eq r, he_frob r (x.1 r)]
      change f₀_add ((frob_X ^ d₀) (equiv_X (TensorProduct.tmul ℤ q x))) =
        frob_Y (f₀_add (equiv_X (TensorProduct.tmul ℤ q x)))
      rw [hqt, hequiv_X_rat, map_smul, hf₀_smul, hx_d_frob, hf₀_pure, ← hy_frob, ← map_smul,
        ← hf₀_pure, ← hf₀_smul]
    | add t₁ t₂ ih₁ ih₂ =>
      rw [map_add, map_add, map_add, ih₁, ih₂, map_add, map_add]

  have hDegZeroEquiv : ∀ (K₀ : Type) [Field K₀]
      (V₁ V₂ : Type u)
      [AddCommGroup V₁] [Module K₀ V₁] [Module.Finite K₀ V₁]
      [AddCommGroup V₂] [Module K₀ V₂] [Module.Finite K₀ V₂]
      (Φ₁ : V₁ →ₗ[K₀] V₁) (Φ₂ : V₂ →ₗ[K₀] V₂),
      (Φ₁.charpoly).aroots (AlgebraicClosure K₀) = {1} →
      (Φ₂.charpoly).aroots (AlgebraicClosure K₀) = {1} →
      ∀ (d₀ : ℕ), ∃ e : V₁ ≃ₗ[K₀] V₂, ∀ v : V₁, e ((Φ₁ ^ d₀) v) = Φ₂ (e v) := by
    clear * -
    intro K₀ _ V₁ V₂ _ _ _ _ _ _ Φ₁ Φ₂ h1 h2 d₀
    let L := AlgebraicClosure K₀
    have hOne : ∀ (W : Type u) [AddCommGroup W] [Module K₀ W] [Module.Finite K₀ W]
        (Φ : W →ₗ[K₀] W),
        (Φ.charpoly).aroots L = {1} →
        Module.finrank K₀ W = 1 ∧ Φ = LinearMap.id := by
      intro W _ _ _ Φ hroots
      set p := Φ.charpoly
      have hp_mon : p.Monic := LinearMap.charpoly_monic Φ
      set p_L := p.map (algebraMap K₀ L)
      have hpL_mon : p_L.Monic := hp_mon.map (algebraMap K₀ L)
      have hsp : p_L.Splits := IsAlgClosed.splits p_L
      have hpL_roots : p_L.roots = {1} := by
        rwa [Polynomial.aroots_def] at hroots
      have hdeg_pL : p_L.natDegree = 1 := by
        rw [Polynomial.Splits.natDegree_eq_card_roots hsp, hpL_roots, Multiset.card_singleton]
      have hdeg_p : p.natDegree = 1 := by
        rwa [hp_mon.natDegree_map] at hdeg_pL
      have hfin : Module.finrank K₀ W = 1 := by
        rw [← LinearMap.charpoly_natDegree Φ]
        exact hdeg_p
      have hpL_eq : p_L = Polynomial.X - 1 := by
        have h1_mem : (1 : L) ∈ p_L.roots := by
          rw [hpL_roots]
          exact Multiset.mem_singleton_self 1
        have h1_root : p_L.IsRoot 1 := (Polynomial.mem_roots hpL_mon.ne_zero).mp h1_mem
        rcases Polynomial.dvd_iff_isRoot.mpr h1_root with ⟨q_L, hq_L⟩
        rw [Polynomial.C_1] at hq_L
        have hq_ne : q_L ≠ 0 := right_ne_zero_of_mul (hq_L ▸ hpL_mon.ne_zero)
        have hX1_mon : (Polynomial.X - 1 : Polynomial L).Monic := Polynomial.monic_X_sub_C 1
        have hdeg_sum : p_L.natDegree =
            (Polynomial.X - 1 : Polynomial L).natDegree + q_L.natDegree := by
          rw [hq_L, Polynomial.natDegree_mul hX1_mon.ne_zero hq_ne]
        have hdeg_X1 : (Polynomial.X - 1 : Polynomial L).natDegree = 1 :=
          Polynomial.natDegree_X_sub_C 1
        have hdeg_q0 : q_L.natDegree = 0 := by omega
        have hlc_eq : p_L.leadingCoeff =
            (Polynomial.X - 1 : Polynomial L).leadingCoeff * q_L.leadingCoeff := by
          rw [hq_L, Polynomial.leadingCoeff_mul]
        rw [hpL_mon.leadingCoeff, hX1_mon.leadingCoeff, one_mul] at hlc_eq
        have hq_eq1 : q_L = 1 := by
          rw [Polynomial.eq_C_of_natDegree_eq_zero hdeg_q0]
          have hc0 : q_L.coeff 0 = 1 := by
            rw [hlc_eq, Polynomial.leadingCoeff, hdeg_q0]
          rw [hc0, map_one]
        rw [hq_L, hq_eq1, mul_one]
      have hp_eq : p = Polynomial.X - 1 := by
        apply Polynomial.map_injective (algebraMap K₀ L) (RingHom.injective _)
        simpa only [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_one] using hpL_eq
      have hCH := LinearMap.aeval_self_charpoly Φ
      change Polynomial.aeval Φ p = 0 at hCH
      rw [hp_eq, map_sub, Polynomial.aeval_X, map_one, sub_eq_zero] at hCH
      exact ⟨hfin, hCH⟩
    obtain ⟨hfin₁, hΦ₁⟩ := hOne V₁ Φ₁ h1
    obtain ⟨hfin₂, hΦ₂⟩ := hOne V₂ Φ₂ h2
    let e : V₁ ≃ₗ[K₀] V₂ := LinearEquiv.ofFinrankEq V₁ V₂ (hfin₁.trans hfin₂.symm)
    refine ⟨e, fun v => ?_⟩
    rw [hΦ₁, hΦ₂]
    have hid_pow : (LinearMap.id : V₁ →ₗ[K₀] V₁) ^ d₀ = LinearMap.id := one_pow d₀
    rw [hid_pow]
    rfl

  have hDualTrace : ∀ (K₀ : Type) [Field K₀]
      (V_i V_j : Type u)
      [AddCommGroup V_i] [Module K₀ V_i] [Module.Finite K₀ V_i]
      [AddCommGroup V_j] [Module K₀ V_j] [Module.Finite K₀ V_j]
      (Φ_i : V_i →ₗ[K₀] V_i) (Φ_j : V_j →ₗ[K₀] V_j)
      (c : K₀) (_ : c ≠ 0)
      (B : V_i →ₗ[K₀] V_j →ₗ[K₀] K₀) (_ : Function.Bijective B),
      (∀ (x : V_i) (y : V_j), B (Φ_i x) (Φ_j y) = c * B x y) →
      ∃ Ψ : V_j ≃ₗ[K₀] V_j,
        Ψ.toLinearMap = Φ_j ∧
        ∀ s : ℕ,
          LinearMap.trace K₀ V_i (Φ_i ^ s) =
            (c ^ s) * LinearMap.trace K₀ V_j ((Ψ.symm.toLinearMap) ^ s) := by
    clear * -
    intro K₀ _ V_i V_j _ _ _ _ _ _ Φ_i Φ_j c hc B hB hPair
    let e_B : V_i ≃ₗ[K₀] Module.Dual K₀ V_j := LinearEquiv.ofBijective B hB
    have hInj_j : Function.Injective Φ_j := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro y hy
      have hy0 : Φ_j y = 0 := LinearMap.mem_ker.mp hy
      let b_j := Module.finBasis K₀ V_j
      apply b_j.repr.injective
      rw [map_zero]
      ext idx
      obtain ⟨x_pre, hx_pre⟩ := hB.2 (b_j.coord idx)
      have h0 := hPair x_pre y
      rw [hy0, map_zero] at h0
      have hBxy : B x_pre y = 0 := (mul_eq_zero.mp h0.symm).resolve_left hc
      rw [hx_pre] at hBxy
      simpa [Module.Basis.coord_apply] using hBxy
    have hBij_j : Function.Bijective Φ_j :=
      ⟨hInj_j, LinearMap.injective_iff_surjective.mp hInj_j⟩
    let Ψ : V_j ≃ₗ[K₀] V_j := LinearEquiv.ofBijective Φ_j hBij_j
    let g_inv : V_j →ₗ[K₀] V_j := Ψ.symm.toLinearMap
    have hConj : e_B.conj Φ_i = c • Module.Dual.transpose g_inv := by
      ext f y
      change B (Φ_i (e_B.symm f)) y = c * f (g_inv y)
      have hy_eq : y = Φ_j (g_inv y) := (Ψ.apply_symm_apply y).symm
      conv_lhs => rw [hy_eq]
      rw [hPair (e_B.symm f) (g_inv y)]
      have heB : B (e_B.symm f) = f := e_B.apply_symm_apply f
      rw [heB]
    have hTranspose_pow : ∀ s : ℕ,
        (Module.Dual.transpose g_inv) ^ s = Module.Dual.transpose (g_inv ^ s) := by
      intro s
      induction s with
      | zero =>
        ext f y
        rfl
      | succ s ih =>
        rw [pow_succ', ih]
        ext f y
        rw [Module.End.mul_apply, Module.Dual.transpose_apply, Module.Dual.transpose_apply,
          Module.Dual.transpose_apply, LinearMap.comp_apply, LinearMap.comp_apply,
          ← Module.End.mul_apply, ← pow_succ]
        rfl
    refine ⟨Ψ, rfl, fun s => ?_⟩
    have hConj_pow : e_B.conj (Φ_i ^ s) = (c ^ s) • Module.Dual.transpose (g_inv ^ s) := by
      have h1 : e_B.conj (Φ_i ^ s) = (e_B.conj Φ_i) ^ s := by
        induction s with
        | zero =>
          ext f y
          simp [LinearEquiv.conj_apply]
        | succ s ih =>
          rw [pow_succ', pow_succ', Module.End.mul_eq_comp, Module.End.mul_eq_comp,
            LinearEquiv.conj_comp, ih]
      rw [h1, hConj, smul_pow, hTranspose_pow]
    calc LinearMap.trace K₀ V_i (Φ_i ^ s)
        = LinearMap.trace K₀ (Module.Dual K₀ V_j) (e_B.conj (Φ_i ^ s)) :=
          (LinearMap.trace_conj' (Φ_i ^ s) e_B).symm
