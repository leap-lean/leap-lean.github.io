    have hnot_dvd_int : ¬ ((ℓ : ℤ) ∣ (Nat.card F : ℤ)) := by rwa [Int.ofNat_dvd]
    have hnorm_not_lt : ¬ (‖((Nat.card F : ℤ) : PadicInt ℓ)‖ < 1) := by
