    rw [hTx, e_Ψ.symm_apply_apply]
  obtain ⟨e_V, he_V_act⟩ := hCore H π hTors L_sub hMemL u hIndep hSpanL V equiv hsmul
  refine ⟨e_V, he_V_act, ?_⟩
  intro H' _ π' _hTors' L_sub' _hMemL' V' _ _ T_V' f' equiv' hsmul' hfrob' f hf A hA ψ hψ_trans hψ_inter k
  let B : Matrix (Fin N) (Fin N) K := A.map ι
  have hZero : ∀ w : H 0, w = 0 := by
    intro w
    have h0 := hTors 0 w
    rwa [pow_zero, one_nsmul] at h0
  have hZero' : ∀ w' : H' 0, w' = 0 := by
    intro w'
    have h0 := _hTors' 0 w'
    rwa [pow_zero, one_nsmul] at h0
  let ψ₀ : H 0 ≃+ H' 0 :=
    { toFun := fun _ => 0
      invFun := fun _ => 0
      left_inv := fun w => (hZero w).symm
      right_inv := fun w' => (hZero' w').symm
      map_add' := fun _ _ => (add_zero 0).symm }
  let ψ_full : ∀ s : ℕ, H s ≃+ H' s := fun s =>
    match s with
    | 0 => ψ₀
    | r + 1 => ψ r
  have hψ_full_trans : ∀ (s : ℕ) (v : H (s + 1)),
      π' s (ψ_full (s + 1) v) = ψ_full s (π s v) := by
    intro s v
    cases s with
    | zero => exact (hZero' _).trans (hZero' _).symm
    | succ r => exact hψ_trans r v
  have hψ_symm_trans : ∀ (s : ℕ) (v' : H' (s + 1)),
      π s ((ψ_full (s + 1)).symm v') = (ψ_full s).symm (π' s v') := by
    intro s v'
    apply (ψ_full s).injective
    rw [← hψ_full_trans s, (ψ_full (s + 1)).apply_symm_apply, (ψ_full s).apply_symm_apply]
  let u' : Fin N → ↥L_sub' := fun i =>
    ⟨fun s => ψ_full s ((u i).1 s), (_hMemL' _).mpr fun s => by
      rw [hψ_full_trans s, (hMemL (u i).1).mp (u i).2 s]⟩
  have hIndep' : ∀ (s : ℕ) (c : Fin N → ZMod (ℓ ^ s)),
      ∑ i : Fin N, (c i).val • (u' i).1 s = 0 → c = 0 := by
    intro s c hc
    apply hIndep s c
    apply (ψ_full s).injective
    rw [map_zero, map_sum]
