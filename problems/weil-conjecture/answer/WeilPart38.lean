  have hQuadOv : ∀ (R : Type u) [CommRing R]
      (hAff : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
      (c_R : ∀ a : Fin (N + 1),
        R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen R N a))))
      (t_R : ∀ a : Fin (N + 1), Fin (N + 1) →
        ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen R N a)))),
      IsCommRingProjCoordSystem R N hAff c_R t_R →
      ∀ (t_val : R) (a a' : Fin (N + 1)) (_ : Fin 1),
        ((weilProjectiveSpaceOver R N).left.presheaf.map
          (CategoryTheory.homOfLE inf_le_right).op).hom
            ((∑ j : Fin (m + 1), t_R a' (u_idx j) * t_R a' (v_idx j)) -
              c_R a' t_val * (t_R a' w_idx) ^ 2) *
        (((weilProjectiveSpaceOver R N).left.presheaf.map
          (CategoryTheory.homOfLE inf_le_left).op).hom (t_R a a')) ^ 2 =
        ((weilProjectiveSpaceOver R N).left.presheaf.map
          (CategoryTheory.homOfLE inf_le_left).op).hom
            ((∑ j : Fin (m + 1), t_R a (u_idx j) * t_R a (v_idx j)) -
              c_R a t_val * (t_R a w_idx) ^ 2) := by
    intro R _ hAff c_R t_R hCoord t_val a a' _
    rcases hCoord with ⟨_, _, _, _, _, _, _, _, hC_ov, hT_ov⟩
    set resL := ((weilProjectiveSpaceOver R N).left.presheaf.map
      (CategoryTheory.homOfLE inf_le_left).op).hom
    set resR := ((weilProjectiveSpaceOver R N).left.presheaf.map
      (CategoryTheory.homOfLE inf_le_right).op).hom
    rw [map_sub, map_sum, map_mul, map_pow, map_sub, map_sum, map_mul, map_pow,
      sub_mul, Finset.sum_mul]
    congr 1
    · refine Finset.sum_congr rfl fun j _ => ?_
      calc
        resR (t_R a' (u_idx j) * t_R a' (v_idx j)) * resL (t_R a a') ^ 2 =
            (resR (t_R a' (u_idx j)) * resL (t_R a a')) *
              (resR (t_R a' (v_idx j)) * resL (t_R a a')) := by
          rw [map_mul]; ring
        _ = resL (t_R a (u_idx j)) * resL (t_R a (v_idx j)) := by
          rw [hT_ov a a' (u_idx j), hT_ov a a' (v_idx j)]
        _ = resL (t_R a (u_idx j) * t_R a (v_idx j)) := (map_mul _ _ _).symm
    · calc
        resR (c_R a' t_val) * resR (t_R a' w_idx) ^ 2 * resL (t_R a a') ^ 2 =
            resR (c_R a' t_val) * (resR (t_R a' w_idx) * resL (t_R a a')) ^ 2 := by ring
        _ = resL (c_R a t_val) * resL (t_R a w_idx) ^ 2 := by
          rw [hC_ov a a' t_val, hT_ov a a' w_idx]

  obtain ⟨hAtlas, hProjBC, hSubEx, hSubIncl, hSubBC⟩ :=
    weil_proj_quadric_paving_commRing_proj_atlas.{u}
  obtain ⟨hAff_R0, c_R0, t_R0, θ_R0, hCoord_R0, hθ_R0⟩ := hAtlas P N
  obtain ⟨hAff_Pmk, c_Pmk, t_Pmk, _, hCoord_Pmk, _⟩ := hAtlas k m
  obtain ⟨hAff_PmR0, c_PmR0, t_PmR0, θ_PmR0, hCoord_PmR0, hθ_PmR0⟩ := hAtlas P m
  obtain ⟨Φ_Pm_R0, hBC_Pm_R0⟩ :=
    hProjBC k P Polynomial.C m hAff_Pmk c_Pmk t_Pmk hAff_PmR0 c_PmR0 t_PmR0
      hCoord_Pmk hCoord_PmR0

  let g_Q0 : ∀ a : Fin (N + 1), Fin 1 →
