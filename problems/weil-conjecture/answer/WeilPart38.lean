by
  classical
  let _ := hProj_Ztilde
  let _ := heU_eq
  let D₀ := weilProjectiveSpaceOver F 1
  let Δ_aff : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s)
  let R₀ := Localization.Away Δ_aff
  let X₀ : AlgebraicGeometry.Scheme.{u} := (f₀.left ⁻¹ᵁ U₀).toScheme
  let g₀ : X₀ ⟶ U₀.toScheme := f₀.left ∣_ U₀
  have _ : IsNoetherianRing R₀ :=
    IsLocalization.isNoetherianRing (Submonoid.powers Δ_aff) R₀ inferInstance
  have _ : AlgebraicGeometry.IsProper D₀.hom :=
    (weil_smooth_pencil_projLine_geom_and_simply_connected F ℓ hℓ).1.2.1
  let W₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)) :=
    CategoryTheory.Over.mk (U₀.ι ≫ D₀.hom)
  have _ : AlgebraicGeometry.LocallyOfFiniteType W₀.hom := by
    change AlgebraicGeometry.LocallyOfFiniteType (U₀.ι ≫ D₀.hom)
    infer_instance
  let LocConstAt := fun (y : ↥U₀.toScheme)
      (ℱ : CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u}) =>
    ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U₀.toScheme) (A₀ : AddCommGrpCat.{u}),
      AlgebraicGeometry.Etale w ∧
      y ∈ Set.range w.base ∧
      Finite ↥A₀ ∧
      WeilIsEtaleSheafPullback w ℱ
        ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)
  have h_mod_ell : ∀ (q₀ : ℕ) (y : ↥U₀.toScheme),
      LocConstAt y (weilEtaleHigherDirectImage g₀ q₀ (weilEtaleTorsionSheaf X₀ ℓ)) := by
    intro q₀ y
    obtain ⟨𝒢_bar, hPull, hLC_bar⟩ :=
      weil_mid_dev_raw_locConst_geom_open_mod_prime_and_pullback
        F d_rel Z_tilde f₀ j_aff hj_open hj_hom S_aff U₀ hU₀_eq hSm_U₀ ℓ hℓ q₀
    exact weil_mid_dev_raw_locConst_proetale_algClosure_descent
      F W₀ (weilEtaleHigherDirectImage g₀ q₀ (weilEtaleTorsionSheaf X₀ ℓ))
      𝒢_bar hPull hLC_bar y
  have h_all : ∀ (r₀ q₀ : ℕ) (y : ↥U₀.toScheme),
      LocConstAt y (weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q₀ r₀) := by
    intro r₀
    induction r₀ with
    | zero =>
      intro q₀ y
      unfold weilMidDevOpenHigherDirectImage
      rw [zero_add, pow_one]
      exact h_mod_ell q₀ y
    | succ r₀ ih =>
      obtain ⟨μ, π, h0_AM, hSE_AM⟩ :=
        weil_outer_bc_const_pullback_and_bockstein_ses.2.2.2 ℓ (r₀ + 1)
      obtain ⟨T_X₀, ⟨hT_X₀⟩⟩ :=
        (weil_outer_bc_const_pullback_and_bockstein_ses.1 (𝟙 X₀)).1
      let C_X := CategoryTheory.constantSheaf X₀.smallEtaleTopology AddCommGrpCat.{u}
      let adj_X₀ := CategoryTheory.constantSheafAdj X₀.smallEtaleTopology AddCommGrpCat.{u} hT_X₀
      have _ : C_X.IsLeftAdjoint := adj_X₀.isLeftAdjoint
      have _ : C_X.Additive := by
        dsimp [C_X]; unfold CategoryTheory.constantSheaf; infer_instance
      have _ : CategoryTheory.Limits.PreservesFiniteColimits C_X := inferInstance
      have _ : CategoryTheory.Limits.PreservesFiniteLimits C_X := by
        dsimp [C_X, CategoryTheory.constantSheaf]; infer_instance
      let SC_AM := CategoryTheory.ShortComplex.mk μ π h0_AM
      let SC_X := SC_AM.map C_X
      have hSE_X : SC_X.ShortExact := hSE_AM.map_of_exact C_X
      have hPushCalc := weil_outer_bc_push_and_conn_calculus.1 g₀
      intro q₀ y
      rcases q₀ with _ | q'
      · let A_zero : AddCommGrpCat.{u} := AddCommGrpCat.of PUnit.{u + 1}
        let C_zero :=
          (CategoryTheory.constantSheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u}).obj
