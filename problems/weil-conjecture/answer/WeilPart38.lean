    let e_Ki₀ : K ≃+* L i₀ := RingEquiv.ofBijective (algebraMap K (L i₀)) ⟨RingHom.injective _, hSurj_i₀⟩
    let ε_B : R_U ⟶ CommRingCat.of K :=
