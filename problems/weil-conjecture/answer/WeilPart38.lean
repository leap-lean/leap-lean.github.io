      ((congrArg (fun m => adj_const_W.homEquiv A₀ (P_pZ.obj H) m ≫ H.obj.map (Opposite.op α_pZ.hom))
        hRHS_1).trans
        ((congrArg (· ≫ H.obj.map (Opposite.op α_pZ.hom)) hRHS_2).trans hRHS_3)).trans hBridge
    exact hL_tot.trans hR_tot.symm
  haveI : CategoryTheory.IsIso (L_pZ.map Φ) := by
    rw [hMapΦ_eq]
    infer_instance

  letI : L_pZ.Additive := (hSite.1 p_Z).1
  letI : CategoryTheory.Limits.PreservesFiniteLimits L_pZ := (hSite.1 p_Z).2.1
  letI : CategoryTheory.Limits.PreservesFiniteColimits L_pZ := (hSite.1 p_Z).2.2.1
  have hZero_pull_ker : CategoryTheory.Limits.IsZero (L_pZ.obj (CategoryTheory.Limits.kernel Φ)) := by
    let e_ker : L_pZ.obj (CategoryTheory.Limits.kernel Φ) ≅
        CategoryTheory.Limits.kernel (L_pZ.map Φ) :=
      CategoryTheory.Limits.PreservesKernel.iso L_pZ Φ
    refine CategoryTheory.Limits.IsZero.of_iso ?_ e_ker
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero,
      ← cancel_mono (CategoryTheory.Limits.kernel.ι (L_pZ.map Φ)),
      CategoryTheory.Category.id_comp, CategoryTheory.Limits.zero_comp,
      ← cancel_mono (L_pZ.map Φ), CategoryTheory.Limits.kernel.condition,
      CategoryTheory.Limits.zero_comp]
  have hZero_pull_coker :
      CategoryTheory.Limits.IsZero (L_pZ.obj (CategoryTheory.Limits.cokernel Φ)) := by
    let e_coker : L_pZ.obj (CategoryTheory.Limits.cokernel Φ) ≅
        CategoryTheory.Limits.cokernel (L_pZ.map Φ) :=
      CategoryTheory.Limits.PreservesCokernel.iso L_pZ Φ
    refine CategoryTheory.Limits.IsZero.of_iso ?_ e_coker
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero,
      ← cancel_epi (CategoryTheory.Limits.cokernel.π (L_pZ.map Φ)),
      CategoryTheory.Category.comp_id, CategoryTheory.Limits.comp_zero,
      ← cancel_epi (L_pZ.map Φ), CategoryTheory.Limits.cokernel.condition,
      CategoryTheory.Limits.comp_zero]

  
  haveI : Algebra.IsAlgebraic F k := AlgebraicClosure.isAlgebraic F
  haveI : Algebra.IsAlgebraic E k := Algebra.IsAlgebraic.tower_top (K := F) E
  have hZero_desc : ∀ (ℋ : CategoryTheory.Sheaf W_sch.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.Limits.IsZero (L_pZ.obj ℋ) →
      CategoryTheory.Limits.IsZero ℋ := by
    intro ℋ hZero_Q
    refine weil_etale_geometric_point_stalk_conservativity W_sch ℋ (fun Ω _ _ x_Ω => ?_)
    let φ_E : CommRingCat.of E ⟶ CommRingCat.of Ω :=
      AlgebraicGeometry.Spec.preimage (x_Ω ≫ Z.hom)
    letI : Algebra E Ω := φ_E.hom.toAlgebra
    have hφ_eq : CommRingCat.ofHom (algebraMap E Ω) = φ_E :=
      CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
    let ψ : k →ₐ[E] Ω := IsAlgClosed.lift (M := Ω) (R := E) (S := k)
    let s_k : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom)
    have hcomm_Ω :
        x_Ω ≫ Z.hom =
          s_k ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E k)) := by
      have h_ring :
          CommRingCat.ofHom (algebraMap E k) ≫ CommRingCat.ofHom ψ.toRingHom = φ_E :=
        hφ_eq ▸ CommRingCat.hom_ext (RingHom.ext ψ.commutes)
      exact (AlgebraicGeometry.Spec.map_preimage (x_Ω ≫ Z.hom)).symm.trans
        ((congrArg AlgebraicGeometry.Spec.map h_ring.symm).trans
          (AlgebraicGeometry.Spec.map_comp _ _))
    let x_bar_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z_bar_sch :=
      hp_Z_pb.lift x_Ω s_k hcomm_Ω
    have hx_bar_Ω : x_bar_Ω ≫ p_Z = x_Ω := hp_Z_pb.lift_fst x_Ω s_k hcomm_Ω
    obtain ⟨G₀, hPull_xbar, -, hZero_imp⟩ := hPullPkg.1 x_bar_Ω (L_pZ.obj ℋ)
    have hPull_pZ_ℋ : WeilIsEtaleSheafPullback p_Z ℋ (L_pZ.obj ℋ) :=
      ⟨@hc_all Z_bar_sch W_sch p_Z, @hr_all Z_bar_sch W_sch p_Z, ⟨CategoryTheory.Iso.refl _⟩⟩
    have hPull_xΩ : WeilIsEtaleSheafPullback x_Ω ℋ G₀ :=
      hx_bar_Ω ▸ (hPullPkg.2.2.1 x_bar_Ω p_Z ℋ (L_pZ.obj ℋ) G₀).1 hPull_pZ_ℋ hPull_xbar
    exact ⟨G₀, hPull_xΩ, hZero_imp hZero_Q⟩

  have hZero_ker : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel Φ) :=
    hZero_desc (CategoryTheory.Limits.kernel Φ) hZero_pull_ker
  have hZero_coker : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel Φ) :=
    hZero_desc (CategoryTheory.Limits.cokernel Φ) hZero_pull_coker
  haveI : CategoryTheory.Mono Φ := CategoryTheory.Preadditive.mono_of_isZero_kernel Φ hZero_ker
  haveI : CategoryTheory.Epi Φ := CategoryTheory.Preadditive.epi_of_isZero_cokernel Φ hZero_coker
  haveI : CategoryTheory.IsIso Φ := CategoryTheory.isIso_of_mono_of_epi Φ

  have hx_range : x ∈ Set.range w.base := by
    refine ⟨p_Z.base y_bar, ?_⟩
    have h1 : w.base (p_Z.base y_bar) = pr_W.base (z_bar.base y_bar) :=
      (AlgebraicGeometry.Scheme.Hom.comp_apply p_Z w y_bar).symm.trans
        ((congrArg (fun m : Z_bar_sch ⟶ W₀.left => m.base y_bar) hp_Z_W).trans
          (AlgebraicGeometry.Scheme.Hom.comp_apply z_bar pr_W y_bar))
    exact h1.trans ((congrArg pr_W.base hz_bar_pt).trans hx_bar)
  exact ⟨W_sch, w, A₀, hw_et, hx_range, hFin_A₀,
    ⟨@hc_all W_sch W₀.left w, @hr_all W_sch W₀.left w, ⟨(CategoryTheory.asIso Φ).symm⟩⟩⟩

theorem weil_mid_dev_raw_locConst_noetherian_five_term_exact_ext (R₀ : Type u) [CommRing R₀] [IsNoetherianRing R₀]
    (U : AlgebraicGeometry.Scheme.{u})
    (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U)
    (𝒳₀ 𝒳₁ 𝒳₂ 𝒳₃ 𝒳₄ : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u})
    (d₀ : 𝒳₀ ⟶ 𝒳₁) (f : 𝒳₁ ⟶ 𝒳₂) (g : 𝒳₂ ⟶ 𝒳₃) (d₃ : 𝒳₃ ⟶ 𝒳₄)
    (h₀₁ : d₀ ≫ f = 0) (h₁₂ : f ≫ g = 0) (h₂₃ : g ≫ d₃ = 0)
    (hEx₁ : (CategoryTheory.ShortComplex.mk d₀ f h₀₁).Exact)
    (hEx₂ : (CategoryTheory.ShortComplex.mk f g h₁₂).Exact)
    (hEx₃ : (CategoryTheory.ShortComplex.mk g d₃ h₂₃).Exact)
    (x : ↥U)
    (hLC₀ : ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U) (A₀ : AddCommGrpCat.{u}),
      AlgebraicGeometry.Etale w ∧
      x ∈ Set.range w.base ∧
      Finite ↥A₀ ∧
      WeilIsEtaleSheafPullback w 𝒳₀
        ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀))
    (hLC₁ : ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U) (A₀ : AddCommGrpCat.{u}),
      AlgebraicGeometry.Etale w ∧
      x ∈ Set.range w.base ∧
      Finite ↥A₀ ∧
      WeilIsEtaleSheafPullback w 𝒳₁
        ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀))
    (hLC₃ : ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U) (A₀ : AddCommGrpCat.{u}),
      AlgebraicGeometry.Etale w ∧
      x ∈ Set.range w.base ∧
      Finite ↥A₀ ∧
      WeilIsEtaleSheafPullback w 𝒳₃
        ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀))
    (hLC₄ : ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U) (A₀ : AddCommGrpCat.{u}),
      AlgebraicGeometry.Etale w ∧
      x ∈ Set.range w.base ∧
      Finite ↥A₀ ∧
      WeilIsEtaleSheafPullback w 𝒳₄
        ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)) :
    ∃ (W₂ : AlgebraicGeometry.Scheme.{u}) (w₂ : W₂ ⟶ U) (A₂ : AddCommGrpCat.{u}),
      AlgebraicGeometry.Etale w₂ ∧
      x ∈ Set.range w₂.base ∧
      Finite ↥A₂ ∧
      WeilIsEtaleSheafPullback w₂ 𝒳₂
        ((CategoryTheory.constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}).obj A₂) :=
by
  classical
  let hCR_R₀ := ‹CommRing R₀›
  have hNoeth_R₀ := ‹IsNoetherianRing R₀›

  
  have hShrink : ∀ (V : AlgebraicGeometry.Scheme.{u}) (w : V ⟶ U),
      AlgebraicGeometry.Etale w →
      ∀ y : ↥V, ∃ (W₀ : AlgebraicGeometry.Scheme.{u}) (j₀ : W₀ ⟶ V) (y₀ : ↥W₀),
