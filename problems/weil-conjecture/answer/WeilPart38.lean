        inv_s ≫ Limits.pullback.snd t₀ f_R = 𝟙 X_R ∧
        Limits.pullback.snd t₀ f_R ≫ inv_s = 𝟙 (Limits.pullback t₀ f_R) := by
      intro B₀ t₀ α₀ hα₁ hα₂ inv_s
      refine ⟨Limits.pullback.lift_snd _ _ _, ?_⟩
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
          ← Limits.pullback.condition, Category.assoc, hα₂, Category.comp_id, Category.id_comp]
      · rw [Category.assoc, Limits.pullback.lift_snd, Category.comp_id, Category.id_comp]
    let snd_TR : ((Scheme.Etale.forget X_R).obj W₂).left ⟶ X_R := Limits.pullback.snd T_R.hom f_R
    let inv_snd_TR : X_R ⟶ ((Scheme.Etale.forget X_R).obj W₂).left :=
      Limits.pullback.lift (f_R ≫ α_TR) (𝟙 X_R)
        ((Category.assoc f_R α_TR T_R.hom).trans
          ((congrArg (f_R ≫ ·) hα_hom).trans
            ((Category.comp_id f_R).trans (Category.id_comp f_R).symm)))
    obtain ⟨h_inv_snd1, h_snd_inv1⟩ := hPbIsoRight T_R.hom α_TR hα_hom hhom_α
    let e_XΩ : X_Ω ≅ ((Scheme.Etale.forget X_R).obj W₁).left := hPb_X.flip.isoPullback
    have hj_X_fac : e_XΩ.hom ≫ ((Scheme.Etale.forget X_R).map g_et).left ≫ snd_TR = j_X :=
      (congrArg (e_XΩ.hom ≫ ·) (Limits.pullback.lift_snd _ _ _)).trans
        hPb_X.flip.isoPullback_hom_snd
    obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality
    obtain ⟨p_snd, hp_snd⟩ := hPullEx snd_TR ℓ r
    obtain ⟨p_snd_inv, hp_snd_inv⟩ := hPullEx inv_snd_TR ℓ r
    obtain ⟨p_id_XR, hp_id_XR⟩ := hPullEx (𝟙 X_R) ℓ r
    obtain ⟨p_id_W₂, hp_id_W₂⟩ := hPullEx (𝟙 ((Scheme.Etale.forget X_R).obj W₂).left) ℓ r
    have hp_snd_left : p_snd_inv.comp p_snd = AddMonoidHom.id _ :=
      (hPullComp inv_snd_TR snd_TR ℓ r p_snd_inv p_snd p_id_XR hp_snd_inv hp_snd
        (Eq.mp (congrArg (fun m => WeilIsTorsionEtalePullback m ℓ r p_id_XR) h_inv_snd1.symm)
          hp_id_XR)).symm.trans (hPullId ℓ r p_id_XR hp_id_XR)
    have hp_snd_right : p_snd.comp p_snd_inv = AddMonoidHom.id _ :=
      (hPullComp snd_TR inv_snd_TR ℓ r p_snd p_snd_inv p_id_W₂ hp_snd hp_snd_inv
        (Eq.mp (congrArg (fun m => WeilIsTorsionEtalePullback m ℓ r p_id_W₂) h_snd_inv1.symm)
          hp_id_W₂)).symm.trans (hPullId ℓ r p_id_W₂ hp_id_W₂)
    let eqv_snd : weilEtaleTorsionH X_R ℓ r ≃+
        weilEtaleTorsionH ((Scheme.Etale.forget X_R).obj W₂).left ℓ r :=
      { toFun := p_snd
        invFun := p_snd_inv
        left_inv := fun x => DFunLike.congr_fun hp_snd_left x
        right_inv := fun y => DFunLike.congr_fun hp_snd_right y
        map_add' := map_add p_snd }
    obtain ⟨p_e, hp_e⟩ := hPullEx e_XΩ.hom ℓ r
    obtain ⟨p_e_inv, hp_e_inv⟩ := hPullEx e_XΩ.inv ℓ r
    obtain ⟨p_id_XΩ, hp_id_XΩ⟩ := hPullEx (𝟙 X_Ω) ℓ r
    obtain ⟨p_id_W₁, hp_id_W₁⟩ := hPullEx (𝟙 ((Scheme.Etale.forget X_R).obj W₁).left) ℓ r
    have hp_e_left : p_e.comp p_e_inv = AddMonoidHom.id _ :=
      (hPullComp e_XΩ.hom e_XΩ.inv ℓ r p_e p_e_inv p_id_XΩ hp_e hp_e_inv
        (Eq.mp (congrArg (fun m => WeilIsTorsionEtalePullback m ℓ r p_id_XΩ) e_XΩ.hom_inv_id.symm)
          hp_id_XΩ)).symm.trans (hPullId ℓ r p_id_XΩ hp_id_XΩ)
    have hp_e_right : p_e_inv.comp p_e = AddMonoidHom.id _ :=
      (hPullComp e_XΩ.inv e_XΩ.hom ℓ r p_e_inv p_e p_id_W₁ hp_e_inv hp_e
        (Eq.mp (congrArg (fun m => WeilIsTorsionEtalePullback m ℓ r p_id_W₁) e_XΩ.inv_hom_id.symm)
          hp_id_W₁)).symm.trans (hPullId ℓ r p_id_W₁ hp_id_W₁)
    let eqv_e : weilEtaleTorsionH ((Scheme.Etale.forget X_R).obj W₁).left ℓ r ≃+
        weilEtaleTorsionH X_Ω ℓ r :=
      { toFun := p_e
        invFun := p_e_inv
        left_inv := fun x => DFunLike.congr_fun hp_e_right x
        right_inv := fun y => DFunLike.congr_fun hp_e_left y
        map_add' := map_add p_e }
    obtain ⟨p_g, hp_g⟩ := hPullEx ((Scheme.Etale.forget X_R).map g_et).left ℓ r
    obtain ⟨p_gsnd, hp_gsnd⟩ :=
      hPullEx (((Scheme.Etale.forget X_R).map g_et).left ≫ snd_TR) ℓ r
    have h_gsnd_eq : p_gsnd = p_g.comp p_snd :=
      hPullComp _ snd_TR ℓ r p_g p_snd p_gsnd hp_g hp_snd hp_gsnd
    have hψ_fac : ψ_r = p_e.comp (p_g.comp p_snd) := by
      have hp_jX' : WeilIsTorsionEtalePullback
          (e_XΩ.hom ≫ (((Scheme.Etale.forget X_R).map g_et).left ≫ snd_TR)) ℓ r ψ_r :=
        Eq.mp (congrArg (fun m => WeilIsTorsionEtalePullback m ℓ r ψ_r) hj_X_fac.symm) hψ_r
      exact (hPullComp e_XΩ.hom _ ℓ r p_e p_gsnd ψ_r hp_e hp_gsnd hp_jX').trans
        (congrArg p_e.comp h_gsnd_eq)
    obtain ⟨Θ, hΘ_nat⟩ := weil_alt_cd_etale_slice_torsionH_and_pi_vanishing.1 X_R ℓ r
    have hQ_conj : ∀ z : ↥(P_pre.obj (Opposite.op T_R)),
        (P_pre.map (Opposite.op u_mor)).hom z =
          (Θ W₁).symm (p_g (Θ W₂ z)) := fun z =>
      (Θ W₁).injective ((hΘ_nat g_et p_g hp_g z).trans ((Θ W₁).apply_symm_apply _).symm)
    have hp_g_eq : ∀ y : weilEtaleTorsionH ((Scheme.Etale.forget X_R).obj W₂).left ℓ r,
        p_g y = eqv_e.symm (ψ_r (eqv_snd.symm y)) := fun y =>
      (eqv_e.symm_apply_apply (p_g y)).symm.trans
        ((congrArg (fun z => eqv_e.symm (p_e (p_g z))) (eqv_snd.apply_symm_apply y).symm).trans
          (congrArg eqv_e.symm (DFunLike.congr_fun hψ_fac (eqv_snd.symm y)).symm))
    have hfn_HDI : (⇑(ConcreteCategory.hom (HDI.obj.map (Opposite.op u_mor))) : _ → _) =
        (⇑(ConcreteCategory.hom (η_sh.app (Opposite.op U_Ω))) ∘
          ⇑(ConcreteCategory.hom (P_pre.map (Opposite.op u_mor)))) ∘
          ⇑(ConcreteCategory.hom (inv (η_sh.app (Opposite.op T_R)))) :=
      funext fun x => congrArg (fun m => (ConcreteCategory.hom m) x) hmap_eq
    constructor
    · intro hBij_ψ
      have hfn_pg : (⇑p_g : _ → _) = ⇑eqv_e.symm ∘ ⇑ψ_r ∘ ⇑eqv_snd.symm := funext hp_g_eq
      have hBij_pg : Function.Bijective p_g :=
        Eq.mp (congrArg Function.Bijective hfn_pg.symm)
          (eqv_e.symm.bijective.comp (hBij_ψ.comp eqv_snd.symm.bijective))
      have hfn_P : (⇑(P_pre.map (Opposite.op u_mor)) : _ → _) =
          ⇑(Θ W₁).symm ∘ ⇑p_g ∘ ⇑(Θ W₂) := funext hQ_conj
      have hBij_P : Function.Bijective (P_pre.map (Opposite.op u_mor)) :=
        Eq.mp (congrArg Function.Bijective hfn_P.symm)
          ((Θ W₁).symm.bijective.comp (hBij_pg.comp (Θ W₂).bijective))
      exact Eq.mp (congrArg Function.Bijective hfn_HDI.symm)
        ((hbij_UΩ.comp hBij_P).comp hbij_TR)
    · intro hInj_ψ
      have hfn_pg : (⇑p_g : _ → _) = ⇑eqv_e.symm ∘ ⇑ψ_r ∘ ⇑eqv_snd.symm := funext hp_g_eq
      have hInj_pg : Function.Injective p_g :=
        Eq.mp (congrArg Function.Injective hfn_pg.symm)
          (eqv_e.symm.injective.comp (hInj_ψ.comp eqv_snd.symm.injective))
      have hfn_P : (⇑(P_pre.map (Opposite.op u_mor)) : _ → _) =
          ⇑(Θ W₁).symm ∘ ⇑p_g ∘ ⇑(Θ W₂) := funext hQ_conj
      have hInj_P : Function.Injective (P_pre.map (Opposite.op u_mor)) :=
        Eq.mp (congrArg Function.Injective hfn_P.symm)
          ((Θ W₁).symm.injective.comp (hInj_pg.comp (Θ W₂).injective))
      exact Eq.mp (congrArg Function.Injective hfn_HDI.symm)
        ((hbij_UΩ.1.comp hInj_P).comp hbij_TR.1)

theorem weil_sing_dev_locConst_pencil_geom_smooth_or_odp_roofs (F : Type u) [Field F] (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom]
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.Flat f₀.left]
    [AlgebraicGeometry.IsProper f₀.left]
    [AlgebraicGeometry.Surjective f₀.left]
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (h1d : WeilSingDevIs1dPencilOdpDatum F m Z_tilde f₀ u₀ j_aff s_inf S_aff U₀)
    (f_bar : weilBaseChangeOver F (AlgebraicClosure F) Z_tilde ⟶
      weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1))
    [AlgebraicGeometry.IsProper f_bar.left]
    [AlgebraicGeometry.Flat f_bar.left]
    [AlgebraicGeometry.Surjective f_bar.left]
    (hPb_fbar : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst Z_tilde.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      f_bar.left f₀.left
      (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (e_P : weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1) ≅
      weilProjectiveSpaceOver (AlgebraicClosure F) 1) :
    let k := AlgebraicClosure F
    let P := Polynomial k
    let D_bar := weilBaseChangeOver F k (weilProjectiveSpaceOver F 1)
    let Z_bar := weilBaseChangeOver F k Z_tilde
    let p_A1 : AlgebraicGeometry.Spec (CommRingCat.of P) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of P) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0))
    let π_aff_P : weilOdpModelSpec m (CommRingCat.of P) Polynomial.X ⟶
        AlgebraicGeometry.Spec (CommRingCat.of P) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))
    (∀ x : ↥D_bar.left,
      ∃ (ι_chart : AlgebraicGeometry.Spec (CommRingCat.of P) ⟶ D_bar.left)
        (_ : AlgebraicGeometry.IsOpenImmersion ι_chart),
        ι_chart ≫ D_bar.hom = p_A1 ∧ x ∈ Set.range ι_chart.base) ∧
    (∀ (ι_chart : AlgebraicGeometry.Spec (CommRingCat.of P) ⟶ D_bar.left)
        [AlgebraicGeometry.IsOpenImmersion ι_chart],
      ι_chart ≫ D_bar.hom = p_A1 →
      ∀ (z : ↥Z_bar.left),
        f_bar.left.base z = (s₀ ≫ ι_chart).base (⊥ : PrimeSpectrum k) →
        ∃ (V' : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsAffine V')
          (v₀ : ↥V') (e_Y : V' ⟶ Z_bar.left),
          AlgebraicGeometry.Etale e_Y ∧
          e_Y.base v₀ = z ∧
          ((∃ q_sm : V' ⟶ CategoryTheory.Limits.pullback
                (weilAffineSpaceOver k (2 * m + 1)).hom p_A1,
              AlgebraicGeometry.Etale q_sm ∧
              e_Y ≫ f_bar.left =
                q_sm ≫ CategoryTheory.Limits.pullback.snd
                  (weilAffineSpaceOver k (2 * m + 1)).hom p_A1 ≫ ι_chart) ∨
            (∃ q_odp : V' ⟶ weilOdpModelSpec m (CommRingCat.of P) Polynomial.X,
              AlgebraicGeometry.Etale q_odp ∧
              (∀ idx : Fin (m + 1) × Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q_odp.base v₀).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.C Polynomial.X) ∈ (q_odp.base v₀).asIdeal ∧
              e_Y ≫ f_bar.left = q_odp ≫ π_aff_P ≫ ι_chart))) :=
by
  have h_keep : True := trivial
  have h_pillar1 : ∀ (k₀ : Type u) [Field k₀]
      (D_bar₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
      (e_P₀ : D_bar₀ ≅ weilProjectiveSpaceOver k₀ 1)
      (x : ↥D_bar₀.left),
      let P := Polynomial k₀
      let p_A1 : AlgebraicGeometry.Spec (CommRingCat.of P) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of k₀) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
      ∃ (ι_chart : AlgebraicGeometry.Spec (CommRingCat.of P) ⟶ D_bar₀.left)
        (_ : AlgebraicGeometry.IsOpenImmersion ι_chart),
        ι_chart ≫ D_bar₀.hom = p_A1 ∧ x ∈ Set.range ι_chart.base := by
    clear * - h_keep; clear h_keep
    intro k _ D_bar e_P x
    classical
    intro P p_A1
    let Q := MvPolynomial (Fin 2) k
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let x₀ : ProjectiveSpectrum 𝒜 := e_P.hom.left.base x
    have hex_i₀ : ∃ i₀ : Fin 2, (MvPolynomial.X i₀ : Q) ∉ x₀.asHomogeneousIdeal := by
      by_contra! hAll
      apply x₀.not_irrelevant_le
      intro q hq
      have hproj0 : GradedRing.proj 𝒜 0 q = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 q).mp hq
      have h0 : (((DirectSum.decompose 𝒜) q 0 : ↥(𝒜 0)) : Q) = 0 := by
        rwa [GradedRing.proj_apply] at hproj0
      have hcoeff0 : q.coeff 0 = 0 := by
        conv_lhs => rw [← DirectSum.sum_support_decompose 𝒜 q]
        rw [MvPolynomial.coeff_sum]
        apply Finset.sum_eq_zero
        intro n _
        by_cases hn : n = 0
        · subst hn; simp [h0]
        · let qn : ↥(𝒜 n) := (DirectSum.decompose 𝒜) q n
          have hqn : MvPolynomial.IsHomogeneous qn.1 n :=
            (MvPolynomial.mem_homogeneousSubmodule n qn.1).mp qn.2
          by_contra hne
          have hdeg := hqn hne
          rw [map_zero] at hdeg
          exact hn hdeg.symm
      have hq_span : q ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin 2))) := by
        rw [MvPolynomial.mem_ideal_span_X_image]
        intro d hd
        have hd_ne : d ≠ 0 := by
          intro hd0; subst hd0
          exact (MvPolynomial.mem_support_iff.mp hd) hcoeff0
        have hex_j : ∃ j : Fin 2, d j ≠ 0 := by
          by_contra! hall0
          apply hd_ne; ext j; exact hall0 j
        obtain ⟨j, hj⟩ := hex_j
        exact ⟨j, Set.mem_univ j, hj⟩
      have hspan_le : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin 2))) ≤
          x₀.asHomogeneousIdeal.toIdeal := by
        rw [Ideal.span_le]
        rintro _ ⟨j, _, rfl⟩
        exact hAll j
      exact hspan_le hq_span
    obtain ⟨i₀, hi₀⟩ := hex_i₀
    let i₁ : Fin 2 := if i₀ = 0 then 1 else 0
    have hi₁_ne : i₁ ≠ i₀ := by
      fin_cases i₀ <;> decide
    have hfin2_cases : ∀ j : Fin 2, j = i₀ ∨ j = i₁ := by
      intro j; fin_cases i₀ <;> fin_cases j <;> decide
    let X₀ : Q := MvPolynomial.X i₀
    have hX_mem : ∀ r : Fin 2, (MvPolynomial.X r : Q) ∈ 𝒜 1 := fun r =>
      (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X r)).mpr
        (MvPolynomial.isHomogeneous_X k r)
    have hdeg : X₀ ∈ 𝒜 1 := hX_mem i₀
    let H₀ := HomogeneousLocalization.Away 𝒜 X₀
    let M₀ : Submonoid Q := Submonoid.powers X₀
    have hpow_mem : ∀ n : ℕ, X₀ ^ n ∈ M₀ := fun n => pow_mem (Submonoid.mem_powers X₀) n
    let ι_k : k →+* H₀ :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 M₀).comp (algebraMap k ↥(𝒜 0))
    have hι_val : ∀ c : k, (ι_k c).val = Localization.mk (MvPolynomial.C c) (1 : M₀) := by
      intro c
      change (HomogeneousLocalization.mk _).val = Localization.mk (MvPolynomial.C c) (1 : M₀)
      rw [HomogeneousLocalization.val_mk]
      rfl
    let t_coord : H₀ :=
      HomogeneousLocalization.mk
        { deg := 1
          num := ⟨MvPolynomial.X i₁, hX_mem i₁⟩
          den := ⟨X₀, hdeg⟩
          den_mem := Submonoid.mem_powers X₀ }
    let α_pol : P →+* H₀ := Polynomial.eval₂RingHom ι_k t_coord
    let dehom : Q →+* P :=
      MvPolynomial.eval₂Hom Polynomial.C (fun j : Fin 2 => if j = i₀ then 1 else Polynomial.X)
    have hdehom_X₀ : dehom X₀ = 1 := by
      dsimp [dehom, X₀]
      rw [MvPolynomial.eval₂Hom_X']
      simp
    have hdehom_mem : ∀ y : M₀, dehom y.1 = 1 := by
      rintro ⟨_, n, rfl⟩
      simp [map_pow, hdehom_X₀]
    have hUnit : ∀ y : M₀, IsUnit (dehom y.1) := by
      intro y; rw [hdehom_mem y]; exact isUnit_one
    let β_loc : Localization M₀ →+* P := IsLocalization.lift hUnit
    have hβ_loc_mk : ∀ (q : Q) (y : M₀), β_loc (Localization.mk q y) = dehom q := by
      intro q y
      rw [Localization.mk_eq_mk']
      exact (IsLocalization.lift_mk'_spec hUnit q (dehom q) y).mpr (by rw [hdehom_mem y, one_mul])
    let valHom : H₀ →+* Localization M₀ :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := fun a b => HomogeneousLocalization.val_mul a b
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := fun a b => HomogeneousLocalization.val_add a b }
    let β_pol : H₀ →+* P := β_loc.comp valHom
    have h_left : ∀ p : P, β_pol (α_pol p) = p := by
      have hcomp : β_pol.comp α_pol = RingHom.id P := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext; intro c
          change β_loc (α_pol (Polynomial.C c)).val = Polynomial.C c
          dsimp [α_pol]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hι_val c, hβ_loc_mk]
          dsimp [dehom]
          rw [MvPolynomial.eval₂Hom_C]
        · change β_loc (α_pol Polynomial.X).val = Polynomial.X
          dsimp [α_pol]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          dsimp [t_coord]
          rw [hβ_loc_mk]
          dsimp [dehom]
          rw [MvPolynomial.eval₂Hom_X']
          simp [hi₁_ne]
      exact fun p => RingHom.congr_fun hcomp p
    let φ : Q →+* Localization M₀ := valHom.comp (α_pol.comp dehom)
    have hφ_C : ∀ c : k, φ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) (1 : M₀) := by
      intro c
      change (α_pol (dehom (MvPolynomial.C c))).val = Localization.mk (MvPolynomial.C c) (1 : M₀)
      dsimp [dehom, α_pol]
      rw [MvPolynomial.eval₂Hom_C, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      exact hι_val c
    have hφ_X : ∀ j : Fin 2,
        φ (MvPolynomial.X j) =
          Localization.mk (MvPolynomial.X j) (⟨X₀, Submonoid.mem_powers X₀⟩ : M₀) := by
      intro j
      change (α_pol (dehom (MvPolynomial.X j))).val =
        Localization.mk (MvPolynomial.X j) (⟨X₀, Submonoid.mem_powers X₀⟩ : M₀)
      rcases hfin2_cases j with rfl | rfl
      · dsimp [dehom]
