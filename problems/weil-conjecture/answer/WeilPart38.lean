  have hSpanL' : ∀ w₀' : ↥L_sub',
      ∃ c : Fin N → R,
        ∀ s : ℕ, (ℓ ^ e) • w₀'.1 s = ∑ i : Fin N, (PadicInt.toZModPow s (c i)).val • (u' i).1 s := by
    intro w₀'
    let w₀ : ↥L_sub :=
      ⟨fun s => (ψ_full s).symm (w₀'.1 s), (hMemL _).mpr fun s => by
        rw [hψ_symm_trans s, (_hMemL' w₀'.1).mp w₀'.2 s]⟩
    obtain ⟨c, hc⟩ := hSpanL w₀
    refine ⟨c, fun s => ?_⟩
    have hs := congrArg (ψ_full s) (hc s)
    simpa only [w₀, u', map_nsmul, (ψ_full s).apply_symm_apply, map_sum] using hs
  have hf' : ∀ (r : ℕ) (v' : H' (r + 2)), π' (r + 1) (f' (r + 1) v') = f' r (π' (r + 1) v') := by
    intro r v'
    let v := (ψ (r + 1)).symm v'
    have hv : v' = ψ (r + 1) v := ((ψ (r + 1)).apply_symm_apply v').symm
    rw [hv, ← hψ_inter (r + 1) v, hψ_trans r (f (r + 1) v), hf r v, hψ_inter r (π (r + 1) v),
      ← hψ_trans r v]
  have hA' : ∀ (j : Fin N) (r : ℕ),
      (ℓ ^ e) • f' r ((u' j).1 (r + 1)) =
        (ℓ ^ e) • ∑ i : Fin N,
          (PadicInt.toZModPow (r + 1) (A i j)).val • (u' i).1 (r + 1) := by
    intro j r
    have hr := congrArg (ψ r) (hA j r)
    simpa only [u', ψ_full, map_nsmul, hψ_inter r, map_sum] using hr
  obtain ⟨e_V', he_V'_act⟩ :=
    hCore H' π' _hTors' L_sub' _hMemL' u' hIndep' hSpanL' V' equiv' hsmul'
  have hTV'_mat : ∀ x' : V', e_V' (T_V' x') = B.mulVec (e_V' x') :=
    he_V'_act T_V' f' hf' A hA' hfrob'
  have he_conj : e_V'.conj T_V' = Matrix.toLin' B := by
    apply LinearMap.ext
    intro v
    simpa only [LinearEquiv.conj_apply, LinearMap.comp_apply, LinearEquiv.coe_coe,
      e_V'.apply_symm_apply, Matrix.toLin'_apply] using hTV'_mat (e_V'.symm v)
  have hConjPow : ∀ m : ℕ, e_V'.conj (T_V' ^ m) = (e_V'.conj T_V') ^ m := by
    intro m
    induction m with
    | zero =>
      apply LinearMap.ext
      intro v
      simp [LinearEquiv.conj_apply]
    | succ m ih =>
      rw [pow_succ', pow_succ', ← ih, Module.End.mul_eq_comp, Module.End.mul_eq_comp]
      apply LinearMap.ext
      intro v
      simp [LinearEquiv.conj_apply]
  rw [← LinearMap.trace_conj' (T_V' ^ k) e_V', hConjPow k, he_conj, ← Matrix.toLin'_pow B k,
    Matrix.trace_toLin'_eq]

theorem weil_mid_dev_closed_fiber_lattice_skew_pairing_and_trace (F : Type u) [Finite F] [Field F] (m : ℕ)
    (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_u₀.hom]
    [AlgebraicGeometry.IsProper Z_u₀.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_u₀.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (M_Zu_mid : WeilEllAdicCohomologyModel F Z_u₀ ℓ (2 * m + 1))
    (hFin : ∀ (i r : ℕ), Finite (weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ r) i))
    (tr : ∀ r : ℕ,
      weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ r) (2 * (2 * m + 1)) →+ ZMod (ℓ ^ r))
    (hTr_compat : ∀ (r : ℕ)
      (w : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * (2 * m + 1))),
      ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (tr (r + 1) w) =
        tr r (weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ r (2 * (2 * m + 1)) w))
    (hTr_nondeg : ∀ (r : ℕ)
      (θ_top : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ r) (2 * (2 * m + 1)) →+
        weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ r) (2 * (2 * m + 1))),
      WeilIsModuleToTorsionComparison (weilGeomScheme F Z_u₀) (ℓ ^ r) (2 * (2 * m + 1)) θ_top →
      ∀ a : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ r) (2 * m + 1),
        (∀ b : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ r) (2 * m + 1),
          tr r (θ_top (CategoryTheory.Abelian.Ext.comp a b (Nat.two_mul (2 * m + 1)).symm)) = 0) →
        a = 0)
    (hTop_frob : ∀ (r : ℕ)
      (f_top : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ r) (2 * (2 * m + 1)) →+
        weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ r) (2 * (2 * m + 1))),
      WeilIsTorsionGeomFrobAction F Z_u₀ (ℓ ^ r) (2 * (2 * m + 1)) f_top →
      ∀ w, f_top w = (Nat.card F ^ (2 * m + 1)) • w)
    (hModComp :
      (∀ (k_deg s : ℕ),
        ∃ θ : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ s) k_deg →+
            weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ s) k_deg,
          WeilIsModuleToTorsionComparison (weilGeomScheme F Z_u₀) (ℓ ^ s) k_deg θ ∧
          Function.Bijective θ) ∧
      (∀ (s : ℕ)
        (θ_m1 : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ (s + 1)) (2 * m + 1) →+
          weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (s + 1)) (2 * m + 1))
        (θ_m0 : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * m + 1) →+
          weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * m + 1))
        (θ_t1 : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ (s + 1)) (2 * (2 * m + 1)) →+
          weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (s + 1)) (2 * (2 * m + 1)))
        (θ_t0 : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * (2 * m + 1)) →+
          weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * (2 * m + 1))),
        WeilIsModuleToTorsionComparison (weilGeomScheme F Z_u₀) (ℓ ^ (s + 1)) (2 * m + 1) θ_m1 →
        WeilIsModuleToTorsionComparison (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * m + 1) θ_m0 →
        WeilIsModuleToTorsionComparison (weilGeomScheme F Z_u₀) (ℓ ^ (s + 1))
          (2 * (2 * m + 1)) θ_t1 →
        WeilIsModuleToTorsionComparison (weilGeomScheme F Z_u₀) (ℓ ^ s)
          (2 * (2 * m + 1)) θ_t0 →
        ∀ (a b : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ (s + 1)) (2 * m + 1))
          (a₀ b₀ : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * m + 1)),
          weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ s (2 * m + 1) (θ_m1 a) = θ_m0 a₀ →
          weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ s (2 * m + 1) (θ_m1 b) = θ_m0 b₀ →
          weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ s (2 * (2 * m + 1))
            (θ_t1 (CategoryTheory.Abelian.Ext.comp a b (Nat.two_mul (2 * m + 1)).symm)) =
            θ_t0 (CategoryTheory.Abelian.Ext.comp a₀ b₀ (Nat.two_mul (2 * m + 1)).symm)) ∧
      (∀ s : ℕ,
        ∃ f_top : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * (2 * m + 1)) →+
            weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * (2 * m + 1)),
          WeilIsTorsionGeomFrobAction F Z_u₀ (ℓ ^ s) (2 * (2 * m + 1)) f_top) ∧
      (∀ (s k_deg : ℕ)
        (f₁ : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (s + 1)) k_deg →+
          weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (s + 1)) k_deg)
        (f₀ : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ s) k_deg →+
          weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ s) k_deg),
        WeilIsTorsionGeomFrobAction F Z_u₀ (ℓ ^ (s + 1)) k_deg f₁ →
        WeilIsTorsionGeomFrobAction F Z_u₀ (ℓ ^ s) k_deg f₀ →
        ∀ u, weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ s k_deg (f₁ u) =
          f₀ (weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ s k_deg u)) ∧
      (∀ (s : ℕ)
        (f_m : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * m + 1) →+
          weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * m + 1))
        (f_t : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * (2 * m + 1)) →+
          weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * (2 * m + 1)))
        (θ_m : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * m + 1) →+
          weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * m + 1))
        (θ_t : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * (2 * m + 1)) →+
          weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * (2 * m + 1))),
        WeilIsTorsionGeomFrobAction F Z_u₀ (ℓ ^ s) (2 * m + 1) f_m →
        WeilIsTorsionGeomFrobAction F Z_u₀ (ℓ ^ s) (2 * (2 * m + 1)) f_t →
        WeilIsModuleToTorsionComparison (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * m + 1) θ_m →
        WeilIsModuleToTorsionComparison (weilGeomScheme F Z_u₀) (ℓ ^ s)
          (2 * (2 * m + 1)) θ_t →
        ∀ (a b a' b' : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ s) (2 * m + 1)),
          f_m (θ_m a) = θ_m a' →
          f_m (θ_m b) = θ_m b' →
          f_t (θ_t (CategoryTheory.Abelian.Ext.comp a b (Nat.two_mul (2 * m + 1)).symm)) =
            θ_t (CategoryTheory.Abelian.Ext.comp a' b' (Nat.two_mul (2 * m + 1)).symm)))
    (hOddSkew : ∀ (r : ℕ)
      (a b : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1)),
      CategoryTheory.Abelian.Ext.comp b a (Nat.two_mul (2 * m + 1)).symm =
        -CategoryTheory.Abelian.Ext.comp a b (Nat.two_mul (2 * m + 1)).symm) :
    ∃ (N : ℕ)
      (e_V : M_Zu_mid.V ≃ₗ[Padic ℓ] (Fin N → Padic ℓ))
      (J_V : Matrix (Fin N) (Fin N) (Padic ℓ))
      (F_V_u : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
      (c_iso : ℕ)
      (α_lat : ∀ r : ℕ, (Fin N → ZMod (ℓ ^ (r + 1))) →+
        weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1))
      (β_lat : ∀ r : ℕ,
        weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1) →+
          (Fin N → ZMod (ℓ ^ (r + 1))))
      (matOfAut : ∀ (γ : ∀ r : ℕ,
          (AddMonoid.End (weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1)))ˣ),
        (∀ (r : ℕ) (v : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 2)) (2 * m + 1)),
          weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ (r + 1) (2 * m + 1)
            ((γ (r + 1)).val v) =
          (γ r).val
            (weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ (r + 1) (2 * m + 1) v)) →
        (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ),
      (J_V.transpose = -J_V ∧ J_V.det ≠ 0) ∧
      ((∀ x : M_Zu_mid.V,
        e_V (M_Zu_mid.frob x) =
          ((F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec (e_V x)) ∧
        (((F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J_V *
          ((F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) =
            ((Nat.card F : Padic ℓ) ^ (2 * m + 1)) • J_V)) ∧
      (∀ r : ℕ,
        (β_lat r).comp (α_lat r) = (ℓ ^ c_iso) • AddMonoidHom.id _ ∧
        (α_lat r).comp (β_lat r) = (ℓ ^ c_iso) • AddMonoidHom.id _) ∧
      ((∀ (r : ℕ) (v : Fin N → ZMod (ℓ ^ (r + 2))),
        weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ (r + 1) (2 * m + 1)
          (α_lat (r + 1) v) =
        α_lat r (fun i =>
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1))) (v i))) ∧
        (∀ (r : ℕ) (w : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 2)) (2 * m + 1))
          (i : Fin N),
          β_lat r (weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ (r + 1) (2 * m + 1) w) i =
            ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
              (β_lat (r + 1) w i))) ∧
      ((∀ h1, matOfAut 1 h1 = 1) ∧
        (∀ γ₁ γ₂ h₁ h₂ h₁₂, matOfAut (γ₁ * γ₂) h₁₂ = matOfAut γ₁ h₁ * matOfAut γ₂ h₂) ∧
        (∀ γ₁ γ₂ h₁ h₂ (r : ℕ), γ₁ r = γ₂ r →
          ((matOfAut γ₁ h₁).val).map (PadicInt.toZModPow (r + 1)) =
            ((matOfAut γ₂ h₂).val).map (PadicInt.toZModPow (r + 1)))) ∧
      (∀ γ hγ (r : ℕ),
        let M_r := ((matOfAut γ hγ).val).map (PadicInt.toZModPow (r + 1))
        (∀ v, α_lat r (M_r.mulVec v) = (γ r).val (α_lat r v)) ∧
        (∀ w, β_lat r ((γ r).val w) = M_r.mulVec (β_lat r w))) ∧
      (∀ γ hγ,
        (∀ (r : ℕ) v, (γ r).val v = M_Zu_mid.frobTorsion (r + 1) v) →
        matOfAut γ hγ = F_V_u) ∧
      (∀ γ hγ,
        (∀ (r : ℕ)
          (θ_mid : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1) →+
            weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1))
          (θ_top : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * (2 * m + 1)) →+
            weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * (2 * m + 1))),
          WeilIsModuleToTorsionComparison (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1) θ_mid →
          WeilIsModuleToTorsionComparison (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1))
            (2 * (2 * m + 1)) θ_top →
          ∀ (a b a' b' : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1)),
            (γ r).val (θ_mid a) = θ_mid a' →
            (γ r).val (θ_mid b) = θ_mid b' →
            θ_top (CategoryTheory.Abelian.Ext.comp a' b' (Nat.two_mul (2 * m + 1)).symm) =
              θ_top (CategoryTheory.Abelian.Ext.comp a b (Nat.two_mul (2 * m + 1)).symm)) →
        (((matOfAut γ hγ).val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J_V *
          (((matOfAut γ hγ).val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = J_V) ∧
      (∀ (F' : Type u) [Finite F'] [Field F']
        (Z' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F')))
        (M' : WeilEllAdicCohomologyModel F' Z' ℓ (2 * m + 1))
        (γ) (hγ)
        (ψ : ∀ r : ℕ,
          weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1) ≃+
            weilEtaleTorsionH (weilGeomScheme F' Z') (ℓ ^ (r + 1)) (2 * m + 1)),
        (∀ r v,
          weilEtaleTorsionTransition (weilGeomScheme F' Z') ℓ (r + 1) (2 * m + 1) (ψ (r + 1) v) =
            ψ r (weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ (r + 1) (2 * m + 1) v)) →
        (∀ r v, ψ r ((γ r).val v) = M'.frobTorsion (r + 1) (ψ r v)) →
        ∀ k : ℕ, 1 ≤ k →
          LinearMap.trace (Padic ℓ) M'.V (M'.frob ^ k) =
            Matrix.trace ((((matOfAut γ hγ).val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ k)) :=
by
  classical
  have hPrime_ℓ : Nat.Prime ℓ := Fact.out

  have hKerMem : ∀ (H₀ : ℕ → Type u) [∀ s : ℕ, AddCommGroup (H₀ s)]
      (π₀ : ∀ s : ℕ, H₀ (s + 1) →+ H₀ s) (w : ∀ s : ℕ, H₀ s),
      w ∈ AddMonoidHom.ker (AddMonoidHom.pi fun s =>
        (π₀ s).comp (Pi.evalAddMonoidHom H₀ (s + 1)) - Pi.evalAddMonoidHom H₀ s) ↔
        ∀ s : ℕ, π₀ s (w (s + 1)) = w s := by
    intro H₀ _ π₀ w
    rw [AddMonoidHom.mem_ker, funext_iff]
    simp [sub_eq_zero]

  have hAbsKerKill : ∀ (H₀ : ℕ → Type u) [∀ s : ℕ, AddCommGroup (H₀ s)]
      (τ₀ : ∀ s : ℕ, H₀ (s + 1) →+ H₀ s)
      (π_b : ∀ a b : ℕ, b ≤ a → H₀ a →+ H₀ b)
      (ι_b : ∀ r s : ℕ, H₀ s →+ H₀ (r + s)),
      (∀ (s : ℕ) (w : H₀ s), (ℓ ^ s) • w = 0) →
      (∀ (a : ℕ) (x : H₀ a), π_b a a (le_refl a) x = x) →
      (∀ (r : ℕ) (x : H₀ (r + 1)), π_b (r + 1) r (Nat.le_succ r) x = τ₀ r x) →
      (∀ (a b c : ℕ) (hba : b ≤ a) (hcb : c ≤ b) (x : H₀ a),
        π_b b c hcb (π_b a b hba x) = π_b a c (le_trans hcb hba) x) →
      (∀ (r s : ℕ) (x : H₀ (r + s)),
        π_b (r + s) r (Nat.le_add_right r s) x = 0 → ∃ u : H₀ s, ι_b r s u = x) →
      ∀ (e r : ℕ) (w : ∀ s : ℕ, H₀ s),
        (∀ s : ℕ, τ₀ s (w (s + 1)) = w s) →
        w (r + 1) = 0 → (ℓ ^ e) • w ((r + 1) + e) = 0 := by
    intro H₀ _ τ₀ π_b ι_b hT₀ hSelf hStep hComp hEx e r w hw hw0
    have hProj : ∀ k : ℕ,
        π_b ((r + 1) + k) (r + 1) (Nat.le_add_right (r + 1) k) (w ((r + 1) + k)) =
          w (r + 1) := by
      intro k
      induction k with
      | zero => exact hSelf (r + 1) (w (r + 1))
      | succ k ih =>
        have h1 := hComp ((r + 1) + k + 1) ((r + 1) + k) (r + 1)
          (Nat.le_succ ((r + 1) + k)) (Nat.le_add_right (r + 1) k) (w ((r + 1) + k + 1))
        rw [hStep ((r + 1) + k) (w ((r + 1) + k + 1)), hw ((r + 1) + k), ih] at h1
        exact h1.symm
    have h0 : π_b ((r + 1) + e) (r + 1) (Nat.le_add_right (r + 1) e) (w ((r + 1) + e)) = 0 :=
      (hProj e).trans hw0
    obtain ⟨u₀, hu₀⟩ := hEx (r + 1) e (w ((r + 1) + e)) h0
    rw [← hu₀, ← map_nsmul, hT₀ e u₀, map_zero]

  
  rcases hModComp with ⟨hMod_ex, hMod_trans, hFrob_top_ex, hFrob_trans, hFrob_cup⟩
  let S_u := weilGeomScheme F Z_u₀
  let n := 2 * m + 1

  obtain ⟨hTors_all, π_bock, ι_bock, _, hπ_self, hπ_step, hπ_comp, hExact_mid, _⟩ :=
    weil_etale_two_param_bockstein_exact_system S_u ℓ
  have hTors_u : ∀ (s : ℕ) (w : weilEtaleTorsionH S_u (ℓ ^ s) n), (ℓ ^ s) • w = 0 :=
    fun s w => hTors_all n s w

  obtain ⟨e, b_fn, v_sys, hIndep_all, hSpanH_all, hSpanL_all⟩ :=
    weil_etale_bockstein_dvr_free_basis_system S_u ℓ n hFin
  let N := b_fn n
  let u_sub : Fin N → ↥(weilEtaleIntegralSystem S_u ℓ n) := v_sys n
  let u : Fin N → ∀ s : ℕ, weilEtaleTorsionH S_u (ℓ ^ s) n := fun i => (u_sub i).1
  have hMem_Su : ∀ w : ∀ s : ℕ, weilEtaleTorsionH S_u (ℓ ^ s) n,
      w ∈ weilEtaleIntegralSystem S_u ℓ n ↔
        ∀ s : ℕ, weilEtaleTorsionTransition S_u ℓ s n (w (s + 1)) = w s :=
    hKerMem (fun s => weilEtaleTorsionH S_u (ℓ ^ s) n)
      (fun s => weilEtaleTorsionTransition S_u ℓ s n)
  have hu : ∀ (i : Fin N) (s : ℕ), weilEtaleTorsionTransition S_u ℓ s n (u i (s + 1)) = u i s :=
    fun i s => (hMem_Su (u_sub i).1).mp (u_sub i).2 s
  have hIndep : ∀ (s : ℕ) (c : Fin N → ZMod (ℓ ^ s)),
