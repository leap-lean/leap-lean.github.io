theorem weil_outer_bc_push_and_conn_calculus : (∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S),
      (∀ (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        weilEtaleHigherDirectImageMap f q (𝟙 F) = 𝟙 _) ∧
      (∀ {F₁ F₂ F₃ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : F₁ ⟶ F₂) (ψ : F₂ ⟶ F₃) (q : ℕ),
        weilEtaleHigherDirectImageMap f q (φ ≫ ψ) =
          weilEtaleHigherDirectImageMap f q φ ≫ weilEtaleHigherDirectImageMap f q ψ) ∧
      (∀ {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
          (u : F₁ ⟶ F₂) [CategoryTheory.Mono u],
        CategoryTheory.Mono (weilEtaleHigherDirectImageMap f 0 u)) ∧
      (∀ {SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})}
          (hSE : SC.ShortExact) (q : ℕ),
        ∃ δ, WeilIsOuterConnHom f hSE q δ ∧
          ∃ (h0_mid : weilEtaleHigherDirectImageMap f q SC.f ≫
                weilEtaleHigherDirectImageMap f q SC.g = 0)
            (h0_left : weilEtaleHigherDirectImageMap f q SC.g ≫ δ = 0)
            (h0_right : δ ≫ weilEtaleHigherDirectImageMap f (q + 1) SC.f = 0),
            (CategoryTheory.ShortComplex.mk
              (weilEtaleHigherDirectImageMap f q SC.f)
              (weilEtaleHigherDirectImageMap f q SC.g) h0_mid).Exact ∧
            (CategoryTheory.ShortComplex.mk
              (weilEtaleHigherDirectImageMap f q SC.g) δ h0_left).Exact ∧
            (CategoryTheory.ShortComplex.mk
              δ (weilEtaleHigherDirectImageMap f (q + 1) SC.f) h0_right).Exact) ∧
      (∀ {SC₁ SC₂ : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})}
          (hSE₁ : SC₁.ShortExact) (hSE₂ : SC₂.ShortExact) (Φ : SC₁ ⟶ SC₂) (q : ℕ)
          {δ₁ δ₂},
        WeilIsOuterConnHom f hSE₁ q δ₁ →
        WeilIsOuterConnHom f hSE₂ q δ₂ →
        weilEtaleHigherDirectImageMap f q Φ.τ₃ ≫ δ₂ =
          δ₁ ≫ weilEtaleHigherDirectImageMap f (q + 1) Φ.τ₁)) ∧
    (∀ {X S S' X' : AlgebraicGeometry.Scheme.{u}}
        (f : X ⟶ S) (g : S' ⟶ S) (f' : X' ⟶ S') (g' : X' ⟶ X)
        (hgf : g' ≫ f = f' ≫ g)
        [hc_g : (weilEtaleSitePullback g).IsContinuous
          S.smallEtaleTopology S'.smallEtaleTopology]
        [hr_g : ((weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
          S.smallEtaleTopology S'.smallEtaleTopology).IsRightAdjoint]
        [hc_g' : (weilEtaleSitePullback g').IsContinuous
          X.smallEtaleTopology X'.smallEtaleTopology]
        [hr_g' : ((weilEtaleSitePullback g').sheafPushforwardContinuous AddCommGrpCat.{u}
          X.smallEtaleTopology X'.smallEtaleTopology).IsRightAdjoint]
        [hAdd_g' : ((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
          X.smallEtaleTopology X'.smallEtaleTopology).Additive]
        [hLim_g' : CategoryTheory.Limits.PreservesFiniteLimits
          ((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
            X.smallEtaleTopology X'.smallEtaleTopology)]
        [hColim_g' : CategoryTheory.Limits.PreservesFiniteColimits
          ((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
            X.smallEtaleTopology X'.smallEtaleTopology)],
      let pb_g := (weilEtaleSitePullback g).sheafPullback AddCommGrpCat.{u}
        S.smallEtaleTopology S'.smallEtaleTopology
      let adj_g := (weilEtaleSitePullback g).sheafAdjunctionContinuous AddCommGrpCat.{u}
        S.smallEtaleTopology S'.smallEtaleTopology
      let pb_g' := (weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
        X.smallEtaleTopology X'.smallEtaleTopology
      (∀ (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        ∃ β, WeilIsOuterBCPush f g f' g' hgf F q β) ∧
      (∀ {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : F₁ ⟶ F₂) (q : ℕ) {β₁ β₂},
        WeilIsOuterBCPush f g f' g' hgf F₁ q β₁ →
        WeilIsOuterBCPush f g f' g' hgf F₂ q β₂ →
        pb_g.map (weilEtaleHigherDirectImageMap f q φ) ≫ (adj_g.homEquiv _ _).symm β₂ =
          (adj_g.homEquiv _ _).symm β₁ ≫
            weilEtaleHigherDirectImageMap f' q (pb_g'.map φ)) ∧
      (∀ {SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})}
          (hSE : SC.ShortExact) (q : ℕ) {δ_S δ_S' β₃ β₁},
        WeilIsOuterConnHom f hSE q δ_S →
        WeilIsOuterConnHom f' (hSE.map_of_exact pb_g') q δ_S' →
        WeilIsOuterBCPush f g f' g' hgf SC.X₃ q β₃ →
        WeilIsOuterBCPush f g f' g' hgf SC.X₁ (q + 1) β₁ →
        pb_g.map δ_S ≫ (adj_g.homEquiv _ _).symm β₁ =
          (adj_g.homEquiv _ _).symm β₃ ≫ δ_S')) :=
by
  refine ⟨?_, ?_⟩
  · intro X S f
    let HDI : ℕ → CategoryTheory.Functor
        (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
      fun q => CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q ⋙
        (CategoryTheory.Functor.whiskeringLeft
          (S.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (weilEtaleSitePullback f).op ⋙
        CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    obtain ⟨hMono, hLES⟩ := weil_outer_bc_pcc_hdi_mono_and_conn_les f
    exact ⟨fun F q => (HDI q).map_id F,
