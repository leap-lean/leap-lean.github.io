theorem weil_scheme_galois_torsor_clopen_sheets (R S : Type u) [CommRing R] [IsDomain R] [CommRing S] [IsDomain S]
    [Algebra R S] [Module.Finite R S] [Algebra.Etale R S]
    (hInj : Function.Injective (algebraMap R S))
    (m : ℕ) (equiv_Γ : Fin m ≃ (S ≃ₐ[R] S)) (e : Fin m → TensorProduct R S S)
    (hIdemp : ∀ i : Fin m, e i * e i = e i)
    (hOrth : ∀ i j : Fin m, i ≠ j → e i * e j = 0)
    (hSum : (∑ i : Fin m, e i) = 1)
    (hEval : ∀ i j : Fin m,
      Algebra.TensorProduct.lift (AlgHom.id S S) (equiv_Γ j).symm.toAlgHom
        (fun _ _ => mul_comm _ _) (e i) = if i = j then 1 else 0)
    (hAbsorb : ∀ (i : Fin m) (z : TensorProduct R S S),
      z * e i = TensorProduct.tmul R
        (Algebra.TensorProduct.lift (AlgHom.id S S) (equiv_Γ i).symm.toAlgHom
          (fun _ _ => mul_comm _ _) z) 1 * e i)
    (U : AlgebraicGeometry.Scheme.{u})
    (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R)) U) :
    let V := AlgebraicGeometry.Spec (CommRingCat.of S)
    let π : V ⟶ U :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S)) ≫ e_U.hom
    (AlgebraicGeometry.Etale π ∧ AlgebraicGeometry.Surjective π) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (h_W : W ⟶ U),
      let W_V := CategoryTheory.Limits.pullback h_W π
      (AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.fst h_W π) ∧
        AlgebraicGeometry.Surjective (CategoryTheory.Limits.pullback.fst h_W π)) ∧
      (∀ σ : S ≃ₐ[R] S,
        ∃! m_σ : W_V ⟶ W_V,
          m_σ ≫ CategoryTheory.Limits.pullback.fst h_W π =
            CategoryTheory.Limits.pullback.fst h_W π ∧
          m_σ ≫ CategoryTheory.Limits.pullback.snd h_W π =
            CategoryTheory.Limits.pullback.snd h_W π ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) ∧
      (∀ y₁ y₂ : ↥W_V,
        (CategoryTheory.Limits.pullback.fst h_W π).base y₁ =
          (CategoryTheory.Limits.pullback.fst h_W π).base y₂ →
        ∃ (σ : S ≃ₐ[R] S) (m_σ : W_V ⟶ W_V),
          m_σ ≫ CategoryTheory.Limits.pullback.fst h_W π =
            CategoryTheory.Limits.pullback.fst h_W π ∧
          m_σ ≫ CategoryTheory.Limits.pullback.snd h_W π =
            CategoryTheory.Limits.pullback.snd h_W π ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ∧
          m_σ.base y₁ = y₂)) ∧
    (∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V),
      let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ π) π
      ∃ δ : (S ≃ₐ[R] S) → (Y ⟶ Y_V),
        (∀ σ : S ≃ₐ[R] S,
          δ σ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π = 𝟙 Y ∧
          δ σ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π =
            g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ∧
          AlgebraicGeometry.Etale (δ σ) ∧
          IsOpen (Set.range (δ σ).base)) ∧
        (∀ σ₁ σ₂ : S ≃ₐ[R] S, σ₁ ≠ σ₂ →
          Disjoint (Set.range (δ σ₁).base) (Set.range (δ σ₂).base)) ∧
        (⋃ σ : S ≃ₐ[R] S, Set.range (δ σ).base) = Set.univ ∧
        (∀ (σ τ : S ≃ₐ[R] S) (m_τ : Y_V ⟶ Y_V),
          m_τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π =
            CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π →
          m_τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π =
            CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
          δ σ ≫ m_τ = δ (τ * σ))) :=
by
  intro V π
  let _ := hIdemp
  let P_Et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale.{u}
  let P_Surj : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Surjective.{u}
  let π₀ : V ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S))
  let d_V : (S ≃ₐ[R] S) → (V ⟶ V) :=
    fun σ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)
  have hEt_π₀ : AlgebraicGeometry.Etale π₀ :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_Et) (Q := @RingHom.Etale)).mpr
