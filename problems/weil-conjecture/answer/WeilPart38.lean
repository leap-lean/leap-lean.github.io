                  Function.Bijective p_i)
        (R_bar₀ Ω₀ : Type u) [CommRing R_bar₀] [HenselianLocalRing R_bar₀]
        [IsAlgClosed (IsLocalRing.ResidueField R_bar₀)]
        [Field Ω₀] [IsAlgClosed Ω₀]
        (g_R₀ : AlgebraicGeometry.Spec (CommRingCat.of R_bar₀) ⟶ U_line)
        (j_R₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R_bar₀)),
        let Q_R := CategoryTheory.Limits.pullback π_Q₀.left g_R₀
        let Q_Ω := CategoryTheory.Limits.pullback j_R₀
          (CategoryTheory.Limits.pullback.snd π_Q₀.left g_R₀)
        let j_Q : Q_Ω ⟶ Q_R :=
          CategoryTheory.Limits.pullback.snd j_R₀
            (CategoryTheory.Limits.pullback.snd π_Q₀.left g_R₀)
        Subsingleton (weilEtaleTorsionH Q_R ℓ 1) ∧
        ∀ (r : ℕ), r ≤ 2 * m + 1 →
          ∀ (ψ_r : weilEtaleTorsionH Q_R ℓ r →+ weilEtaleTorsionH Q_Ω ℓ r),
            WeilIsTorsionEtalePullback j_Q ℓ r ψ_r →
            Function.Bijective ψ_r := by
    clear! M_max hPBC hm
    intro P U_line p_A1 Pm f_Pi Q_proj₀ π_Q₀ hProp_Q₀ hProp_Pm ι_Pi₀ hPi_hom₀ hGeom₀
      R_bar₀ Ω₀ _ _ _ _ _ g_R₀ j_R₀ Q_R Q_Ω j_Q
    obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
    let HasBijPull : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}}, (X₁ ⟶ X₂) → ℕ → Prop :=
      fun {X₁ X₂} h i =>
        ∀ (p : weilEtaleTorsionH X₂ ℓ i →+ weilEtaleTorsionH X₁ ℓ i),
          WeilIsTorsionEtalePullback h ℓ i p → Function.Bijective p
    have hBij_iso : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (e : X₁ ≅ X₂) (i : ℕ),
        HasBijPull e.hom i := by
      intro X₁ X₂ e i p hp
      obtain ⟨q, hq⟩ := hPullEx e.inv ℓ i
      obtain ⟨pid₁, hpid₁⟩ := hPullEx (𝟙 X₁) ℓ i
      obtain ⟨pid₂, hpid₂⟩ := hPullEx (𝟙 X₂) ℓ i
      have hcomp₁ : pid₁ = p.comp q :=
        hPullComp e.hom e.inv ℓ i p q pid₁ hp hq (by rwa [e.hom_inv_id])
      have hcomp₂ : pid₂ = q.comp p :=
        hPullComp e.inv e.hom ℓ i q p pid₂ hq hp (by rwa [e.inv_hom_id])
      rw [hPullId ℓ i pid₁ hpid₁] at hcomp₁
      rw [hPullId ℓ i pid₂ hpid₂] at hcomp₂
      exact Function.bijective_iff_has_inverse.mpr
        ⟨q, fun x => DFunLike.congr_fun hcomp₂.symm x, fun y => DFunLike.congr_fun hcomp₁.symm y⟩
    have hBij_comp : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}}
        (h₁ : X₁ ⟶ X₂) (h₂ : X₂ ⟶ X₃) (i : ℕ),
        HasBijPull h₁ i → HasBijPull h₂ i → HasBijPull (h₁ ≫ h₂) i := by
      intro X₁ X₂ X₃ h₁ h₂ i hb₁ hb₂ p₁₂ hp₁₂
      obtain ⟨p₁, hp₁⟩ := hPullEx h₁ ℓ i
      obtain ⟨p₂, hp₂⟩ := hPullEx h₂ ℓ i
