    have hmul_eq : (h₀_K • w_op) * e_M j = ∑ r : Fin N_geom, (ι (A_poly r j)) • e_M r := by
      have lhs_eq : (h₀_K • w_op) * e_M j = (algebraMap (Polynomial E') M h₀') * (w_op * e_M j) := by
        rw [Algebra.smul_def]
