    have hDomR₀ : IsDomain R₀ :=
      IsLocalization.isDomain_localization hle_nzd
    have hg_rf_ne : algebraMap (Polynomial F) (RatFunc F) g ≠ 0 := by
      intro h0
      apply hg_ne
      exact IsFractionRing.injective (Polynomial F) (RatFunc F)
        (h0.trans (map_zero (algebraMap (Polynomial F) (RatFunc F))).symm)
    have hg_unit : IsUnit (algebraMap (Polynomial F) (RatFunc F) g) :=
      IsUnit.mk0 _ hg_rf_ne
    let f_R₀ : R₀ →+* RatFunc F := IsLocalization.Away.lift g (S := R₀) hg_unit
    let instAlg : Algebra R₀ (RatFunc F) := f_R₀.toAlgebra
    refine ⟨hDomR₀, instAlg, ?_⟩
    let _ : Algebra R₀ (RatFunc F) := instAlg
    have hST_PRF : IsScalarTower (Polynomial F) R₀ (RatFunc F) :=
