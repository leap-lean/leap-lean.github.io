        have hdesc_v : Limits.cokernel.π (P_push.map v) ≫ desc_v = Limits.cokernel.π α_Q :=
          Limits.cokernel.π_desc _ _ _
        rw [← hdesc_v, ← Category.assoc]
        change (Limits.kernel.ι (ShortComplex.mk (P_push.map v) δ₀ hcomp).g ≫
          Limits.cokernel.π (ShortComplex.mk (P_push.map v) δ₀ hcomp).f) ≫ desc_v = 0
        rw [hEx_v, Limits.zero_comp]
      have hSE_R1 : SC_R1.ShortExact := ShortComplex.ShortExact.mk' hEx_R1 inferInstance inferInstance
      have hBij_Q0 : Function.Bijective (θ (P_push.obj Q) Q (𝟙 _) 0) :=
        (hDeg0 (P_push.obj Q) Q (𝟙 _)).2 inferInstance
      have hSurj_αQ0 : Function.Surjective
          ((Abelian.Ext.mk₀ α_Q).postcomp Z_M (Nat.add_zero 0)) := by
        intro z₀
        let q₀ := θ (P_push.obj Q) Q (𝟙 _) 0 z₀
        obtain ⟨y₁, hy₁⟩ := hSurj_1 (q₀.comp hSE.extClass rfl)
        obtain ⟨w₀, rfl⟩ := hδM_surj 0 y₁
        rw [hConnCompat 0 w₀] at hy₁
        have hdiff0 : (q₀ - θ W Q α_Q 0 w₀).comp hSE.extClass rfl = 0 := by
          have hsub : (q₀ - θ W Q α_Q 0 w₀).comp hSE.extClass rfl =
              q₀.comp hSE.extClass rfl - (θ W Q α_Q 0 w₀).comp hSE.extClass rfl :=
            map_sub (hSE.extClass.postcomp Z_Ω rfl) q₀ (θ W Q α_Q 0 w₀)
          rw [hsub, hy₁, sub_self]
        obtain ⟨i₀, hi₀⟩ := Abelian.Ext.covariant_sequence_exact₃ Z_Ω hSE _ rfl hdiff0
        obtain ⟨k₀, rfl⟩ := hBij_KI0.2 i₀
        have hnat_p : θ W Q α_Q 0 (((Abelian.Ext.mk₀ p_M).postcomp Z_M (Nat.add_zero 0)) k₀) =
            ((Abelian.Ext.mk₀ v).postcomp Z_Ω (Nat.add_zero 0)) (θ K I (𝟙 K) 0 k₀) :=
          hNat K W I Q (𝟙 K) α_Q p_M v (by rw [hpα, Category.id_comp]) 0 k₀
        let w' := w₀ + ((Abelian.Ext.mk₀ p_M).postcomp Z_M (Nat.add_zero 0)) k₀
        have hi₀' : ((Abelian.Ext.mk₀ v).postcomp Z_Ω (Nat.add_zero 0)) (θ K I (𝟙 K) 0 k₀) =
            q₀ - θ W Q α_Q 0 w₀ := hi₀
        have hθ_w' : θ W Q α_Q 0 w' = q₀ := by
          change θ W Q α_Q 0 (w₀ + ((Abelian.Ext.mk₀ p_M).postcomp Z_M (Nat.add_zero 0)) k₀) = q₀
          rw [map_add, hnat_p, hi₀', add_sub_cancel]
