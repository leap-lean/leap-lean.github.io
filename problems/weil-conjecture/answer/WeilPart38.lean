      have heq := hPullComp h₁ h₂ ℓ i p₁ p₂ p₁₂ hp₁ hp₂ hp₁₂
      have hbij₁ := hb₁ p₁ hp₁
      have hbij₁₂ := hb₁₂ p₁₂ hp₁₂
