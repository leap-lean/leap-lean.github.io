              (((P_ga.map ι_𝓚).hom.app (Opposite.op T'_R)) x₁) at hnat1
          change ((P_ga.map ι_𝓚).hom.app (Opposite.op U_Ω)) (((P_ga.obj 𝓚).obj.map u_op) x₂) =
            ((P_ga.obj (C_D.obj B)).obj.map u_op)
              (((P_ga.map ι_𝓚).hom.app (Opposite.op T'_R)) x₂) at hnat2
          rw [← hnat1, ← hnat2, hx]

        have hSurj_ᾶ_TR : Function.Surjective ((P_ga.map ᾶ).hom.app (Opposite.op T'_R)) := by
          intro x_R
          obtain ⟨w_Ω, hw_Ω⟩ := hSurj_ᾶ_UΩ (((P_ga.obj 𝓚).obj.map u_op) x_R)
          obtain ⟨c_R, rfl⟩ := (hBij_res_const B₀).2 w_Ω
          refine ⟨c_R, hInj_res_K ?_⟩
          have hnat := congrArg (fun m => m c_R) ((P_ga.map ᾶ).hom.naturality u_op)
          change ((P_ga.map ᾶ).hom.app (Opposite.op U_Ω))
              (((P_ga.obj (C_D.obj B₀)).obj.map u_op) c_R) =
            ((P_ga.obj 𝓚).obj.map u_op) (((P_ga.map ᾶ).hom.app (Opposite.op T'_R)) c_R) at hnat
          exact hnat.symm.trans hw_Ω

        let π_cok := CategoryTheory.Limits.cokernel.π (P_ga.map ᾶ)
        have hSurj_π_TR : Function.Surjective (π_cok.hom.app (Opposite.op T'_R)) :=
          (hSpecR_site T'_R hT'_R).2 π_cok
        have hSub_cok_sec :
            Subsingleton ↥((CategoryTheory.Limits.cokernel (P_ga.map ᾶ)).obj.obj
              (Opposite.op T'_R)) := by
          refine ⟨fun q₁ q₂ => ?_⟩
          have hq0 : ∀ q : ↥((CategoryTheory.Limits.cokernel (P_ga.map ᾶ)).obj.obj
              (Opposite.op T'_R)), q = 0 := by
            intro q
            obtain ⟨x_R, rfl⟩ := hSurj_π_TR q
            obtain ⟨c_R, rfl⟩ := hSurj_ᾶ_TR x_R
            change ((P_ga.map ᾶ ≫ π_cok).hom.app (Opposite.op T'_R)) c_R = 0
            rw [CategoryTheory.Limits.cokernel.condition]; rfl
          rw [hq0 q₁, hq0 q₂]

        let iso_cok_ᾶ := CategoryTheory.Limits.PreservesCokernel.iso P_ga ᾶ
        let e_sec_ᾶ : ↥((P_ga.obj 𝒞_ᾶ).obj.obj (Opposite.op T'_R)) ≃+
            ↥((CategoryTheory.Limits.cokernel (P_ga.map ᾶ)).obj.obj (Opposite.op T'_R)) :=
          addEquivOfIso
            (((CategoryTheory.evaluation _ _).obj (Opposite.op T'_R)).mapIso
              ((CategoryTheory.sheafToPresheaf _ _).mapIso iso_cok_ᾶ))
        have _ : Subsingleton ((P_ga.obj 𝒞_ᾶ).H 0) :=
          ((CategoryTheory.Sheaf.H.equiv₀ (P_ga.obj 𝒞_ᾶ) hT'_R).trans e_sec_ᾶ).toEquiv.subsingleton

        have hPb_ga_𝒞 : WeilIsEtaleSheafPullback g_a 𝒞_ᾶ (P_ga.obj 𝒞_ᾶ) :=
          ⟨hc_ga, hr_ga, ⟨CategoryTheory.Iso.refl _⟩⟩
        obtain ⟨C_k1, hPb_Ck1, _, _⟩ := hPbEx u_R (P_ga.obj 𝒞_ᾶ)
        obtain ⟨e_R_Ck1⟩ :=
          (weil_strictly_henselian_spec_etale_eval_and_pullback R_bar).2 k₁ u_R
            hClosedPt_uR (P_ga.obj 𝒞_ᾶ) C_k1 hPb_Ck1
        have _ : Subsingleton (C_k1.H 0) := e_R_Ck1.toEquiv.subsingleton
        have hZ_Ck1 : CategoryTheory.Limits.IsZero C_k1 := (hSpecK_site k₁).2.1 C_k1 inferInstance
        obtain ⟨C_s0, hPb_Cs0, _, _⟩ := hPbEx (s_pt 0 ≫ ι'_a) 𝒞_ᾶ
        have hPb_k1_comp : WeilIsEtaleSheafPullback (π_k1k ≫ (s_pt 0 ≫ ι'_a)) 𝒞_ᾶ C_k1 := by
          have h1 := (hPbComp u_R g_a 𝒞_ᾶ (P_ga.obj 𝒞_ᾶ) C_k1).1 hPb_ga_𝒞 hPb_Ck1
          have heq : u_R ≫ g_a = π_k1k ≫ s_pt 0 ≫ ι'_a := by
            dsimp [g_a]; rw [← CategoryTheory.Category.assoc, huR_gRbar, CategoryTheory.Category.assoc]
          rwa [heq] at h1
        have hPb_πk1 : WeilIsEtaleSheafPullback π_k1k C_s0 C_k1 :=
          (hPbComp π_k1k (s_pt 0 ≫ ι'_a) 𝒞_ᾶ C_s0 C_k1).2 hPb_Cs0 hPb_k1_comp
        have hZ_Cs0 : CategoryTheory.Limits.IsZero C_s0 :=
          (hFieldPullH0 π_k1k C_s0 C_k1 hPb_πk1).2.mpr hZ_Ck1
        obtain ⟨C_y, hPb_Cy, _, hZ_Cy_fn⟩ := hPbEx π_Kk C_s0
        have hy_eq : y = π_Kk ≫ (s_pt 0 ≫ ι'_a) := by
          rw [← hz_y]; dsimp [ι'_a]
          rw [← CategoryTheory.Category.assoc (s_pt 0), hs0_τ, CategoryTheory.Category.assoc]
        refine ⟨C_y, ?_, hZ_Cy_fn hZ_Cs0⟩
        rw [hy_eq]
        exact (hPbComp π_Kk (s_pt 0 ≫ ι'_a) 𝒞_ᾶ C_s0 C_y).1 hPb_Cs0 hPb_Cy

    have _ : CategoryTheory.Epi ᾶ :=
      (CategoryTheory.Preadditive.epi_iff_isZero_cokernel ᾶ).mpr hZ_𝒞
    have _ : CategoryTheory.IsIso ᾶ := CategoryTheory.isIso_of_mono_of_epi ᾶ
    exact ⟨B₀, hFin_B₀, ⟨CategoryTheory.asIso ᾶ⟩⟩

theorem weil_sing_dev_outer_tr_mod_prime_low_deg_locConst (F : Type u) [Field F]
    (m : ℕ) (hm : 1 ≤ m)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom]
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom]
    (hProj_Ztilde : IsProjectiveOverField F Z_tilde)
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.Flat f₀.left]
    [AlgebraicGeometry.IsProper f₀.left]
    [AlgebraicGeometry.Surjective f₀.left]
    (hFibIrred : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver F 1).left),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback f₀.left s))
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (h1d : WeilSingDevIs1dPencilOdpDatum F m Z_tilde f₀ u₀ j_aff s_inf S_aff U₀)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (f_bar : weilBaseChangeOver F (AlgebraicClosure F) Z_tilde ⟶
      weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1))
    [AlgebraicGeometry.IsProper f_bar.left]
    [AlgebraicGeometry.Flat f_bar.left]
    [AlgebraicGeometry.Surjective f_bar.left]
    (hPb_fbar : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst Z_tilde.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      f_bar.left f₀.left
      (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (e_P : weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1) ≅
      weilProjectiveSpaceOver (AlgebraicClosure F) 1)
    (hPBC : WeilProperModPrimeBaseChangeHolds (AlgebraicClosure F) ℓ)
    (hConstruct : ∀ q : ℕ,
      WeilIsConstructibleModPrimeSheaf ℓ
        (weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1)).left
        (weilEtaleHigherDirectImage f_bar.left q
          (weilEtaleTorsionSheaf
            (weilBaseChangeOver F (AlgebraicClosure F) Z_tilde).left ℓ)))
    (q : ℕ) (hq : q ≤ 2 * m) :
    (∃ (A₀ : AddCommGrpCat.{u}) (_ : Finite ↥A₀),
      ∀ x : ↥(weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1)).left,
        ∃ (W : AlgebraicGeometry.Scheme.{u})
          (w : W ⟶
            (weilBaseChangeOver F (AlgebraicClosure F) (weilProjectiveSpaceOver F 1)).left),
          AlgebraicGeometry.Etale w ∧
          x ∈ Set.range w.base ∧
          WeilIsEtaleSheafPullback w
            (weilEtaleHigherDirectImage f_bar.left q
              (weilEtaleTorsionSheaf
                (weilBaseChangeOver F (AlgebraicClosure F) Z_tilde).left ℓ))
            ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)) ∧
    (∀ (B : AddCommGrpCat.{u}) [Finite ↥B]
      (φ : ((CategoryTheory.constantSheaf
          (weilBaseChangeOver F (AlgebraicClosure F)
            (weilProjectiveSpaceOver F 1)).left.smallEtaleTopology
          AddCommGrpCat.{u}).obj B) ⟶
        weilEtaleHigherDirectImage f_bar.left (q + 1)
          (weilEtaleTorsionSheaf
            (weilBaseChangeOver F (AlgebraicClosure F) Z_tilde).left ℓ)),
      ∃ (B₀ : AddCommGrpCat.{u}) (_ : Finite ↥B₀),
        Nonempty (((CategoryTheory.constantSheaf
          (weilBaseChangeOver F (AlgebraicClosure F)
            (weilProjectiveSpaceOver F 1)).left.smallEtaleTopology
          AddCommGrpCat.{u}).obj B₀) ≅ CategoryTheory.Limits.kernel φ)) :=
by
  classical
  
  have hValRingDichotomy :
      let k := AlgebraicClosure F
      let P := Polynomial k
      let Ω := AlgebraicClosure (FractionRing P)
      let B_bar := integralClosure P Ω
      (ℓ : k) ≠ 0 ∧
      ∃ (M_max : Ideal ↥B_bar) (_ : M_max.IsMaximal),
        M_max.comap (algebraMap P ↥B_bar) = Ideal.span {Polynomial.X} ∧
        (∀ (_ : IsDomain (Localization.AtPrime M_max))
          (j_Rbar : Spec (CommRingCat.of Ω) ⟶ Spec (CommRingCat.of (Localization.AtPrime M_max))),
          Set.range j_Rbar.base =
            (PrimeSpectrum.basicOpen
              (algebraMap P (Localization.AtPrime M_max) Polynomial.X)).1 →
          ∀ p : ↥(Spec (CommRingCat.of (Localization.AtPrime M_max))),
            p ∈ Set.range j_Rbar.base ∨ p = IsLocalRing.closedPoint (Localization.AtPrime M_max)) := by
    clear * - hℓ
    intro k P Ω B_bar
    have hPrime : Nat.Prime ℓ := Fact.out
    have hℓ_k : (ℓ : k) ≠ 0 := by
      intro h0
      rw [← map_natCast (algebraMap F k) ℓ] at h0
      have h0_F : (ℓ : F) = 0 :=
        (RingHom.injective (algebraMap F k)) (h0.trans (map_zero _).symm)
      have hdvd : ringChar F ∣ ℓ := (ringChar.spec F ℓ).mp h0_F
      rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | hself
      · have hdvd1 : ringChar F ∣ 1 := by rw [h1]
        have h1_0 : ((1 : ℕ) : F) = 0 := (ringChar.spec F 1).mpr hdvd1
        rw [Nat.cast_one] at h1_0
        exact one_ne_zero h1_0
      · exact hℓ hself.symm
    refine ⟨hℓ_k, ?_⟩
    have hSurj_ev : Function.Surjective (Polynomial.evalRingHom (0 : k)) := fun c =>
      ⟨Polynomial.C c, Polynomial.eval_C⟩
    have _ : (Ideal.span ({Polynomial.X} : Set P)).IsMaximal := by
      have hX0 : (Polynomial.X - Polynomial.C (0 : k) : P) = Polynomial.X := by simp
      rw [← hX0, ← Polynomial.ker_evalRingHom (0 : k)]
      exact RingHom.ker_isMaximal_of_surjective _ hSurj_ev
    have hinj_PΩ : Function.Injective (algebraMap P Ω) :=
      (IsScalarTower.algebraMap_eq P (FractionRing P) Ω) ▸
        ((RingHom.injective (algebraMap (FractionRing P) Ω)).comp
          (IsFractionRing.injective P (FractionRing P)))
    have hinj_PB : Function.Injective (algebraMap P ↥B_bar) := fun _ _ hab =>
      hinj_PΩ (congrArg Subtype.val hab)
    have hker_le : RingHom.ker (algebraMap P ↥B_bar) ≤ Ideal.span {Polynomial.X} := by
      intro a ha
      rw [RingHom.mem_ker] at ha
      rw [hinj_PB (ha.trans (map_zero _).symm)]
      exact Ideal.zero_mem _
    have _ : Algebra.IsIntegral P ↥B_bar := inferInstance
    obtain ⟨M_max, hMax_M, hComap_M⟩ :=
      Ideal.exists_ideal_over_maximal_of_isIntegral (S := ↥B_bar)
        (Ideal.span ({Polynomial.X} : Set P)) hker_le
    refine ⟨M_max, hMax_M, hComap_M, ?_⟩
    intro _ j_Rbar hj_range p
    let R_bar := Localization.AtPrime M_max
    have _ : p.asIdeal.IsPrime := p.isPrime
    let q_B : Ideal ↥B_bar := p.asIdeal.comap (algebraMap ↥B_bar R_bar)
    have _ : q_B.IsPrime := Ideal.IsPrime.comap _
    have hq_le_M : q_B ≤ M_max := by
      intro x hx
      by_contra hxM
      have hunit : IsUnit (algebraMap ↥B_bar R_bar x) :=
        IsLocalization.map_units R_bar (⟨x, hxM⟩ : M_max.primeCompl)
      exact p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem p.asIdeal hx hunit)
    by_cases hq_bot : q_B = ⊥
    · left
      rw [hj_range]
      change algebraMap P R_bar Polynomial.X ∉ p.asIdeal
      intro hX_mem
      have hXB_mem : algebraMap P ↥B_bar Polynomial.X ∈ q_B := by
        change algebraMap ↥B_bar R_bar (algebraMap P ↥B_bar Polynomial.X) ∈ p.asIdeal
        rwa [← IsScalarTower.algebraMap_apply P ↥B_bar R_bar]
      rw [hq_bot, Ideal.mem_bot] at hXB_mem
      exact Polynomial.X_ne_zero (hinj_PB (hXB_mem.trans (map_zero _).symm))
    · right
      have _ : IsDomain ↥B_bar := inferInstance
      have hqP_ne : q_B.under P ≠ ⊥ := Ideal.IsIntegral.under_ne_bot P hq_bot
      have hqP_max : (q_B.under P).IsMaximal := IsPrime.to_maximal_ideal hqP_ne
      have hq_max : q_B.IsMaximal := Ideal.IsIntegral.isMaximal_of_isMaximal_under q_B hqP_max
      have hq_eq : q_B = M_max := hq_max.eq_of_le hMax_M.ne_top hq_le_M
      apply PrimeSpectrum.ext
      symm
      apply (IsLocalRing.maximalIdeal.isMaximal R_bar).eq_of_le p.isPrime.ne_top
      intro r hr
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj M_max.primeCompl r
      have hbs' : r * algebraMap ↥B_bar R_bar s = algebraMap ↥B_bar R_bar b := hbs
      have hs_unit : IsUnit (algebraMap ↥B_bar R_bar s) := IsLocalization.map_units R_bar s
      have hb_not_unit : ¬ IsUnit (algebraMap ↥B_bar R_bar b) := by
        intro hbu
        have hru : IsUnit r := by
          obtain ⟨u_s, hu_s⟩ := hs_unit; obtain ⟨u_b, hu_b⟩ := hbu
          refine ⟨u_b * u_s⁻¹, ?_⟩
          apply mul_right_cancel₀ u_s.ne_zero
          calc (u_b * u_s⁻¹ : R_barˣ) * (u_s : R_barˣ)
              = (u_b : R_bar) := by simp
            _ = r * (u_s : R_bar) := by rw [hu_b, hu_s, hbs']
        exact (IsLocalRing.mem_maximalIdeal r).mp hr hru
      have hb_M : b ∈ M_max := by
        by_contra hbM
        exact hb_not_unit (IsLocalization.map_units R_bar (⟨b, hbM⟩ : M_max.primeCompl))
      have hb_p : algebraMap ↥B_bar R_bar b ∈ p.asIdeal := by change b ∈ q_B; rwa [hq_eq]
      obtain ⟨u_s, hu_s⟩ := hs_unit
      have hr_eq : r = algebraMap ↥B_bar R_bar b * (↑u_s⁻¹ : R_bar) := by
        apply mul_right_cancel₀ u_s.ne_zero
        calc r * (u_s : R_bar) = algebraMap ↥B_bar R_bar b := by rw [hu_s, hbs']
          _ = algebraMap ↥B_bar R_bar b * (↑u_s⁻¹ : R_bar) * (u_s : R_bar) := by simp
      rw [hr_eq]; exact p.asIdeal.mul_mem_right _ hb_p

  
  have hLiftFieldClosed :
      ∀ {R_K : CommRingCat.{u}} [Nontrivial ↥R_K],
        (∀ x : ↥R_K, x ≠ 0 → IsUnit x) →
        ∀ {X Z : Scheme.{u}} (f : X ⟶ Z) [IsClosedImmersion f]
          (g : Spec R_K ⟶ Z),
          Set.range g.base ⊆ Set.range f.base →
          ∃ β : Spec R_K ⟶ X, β ≫ f = g := by
    clear * -
    intro R_K _ hField X Z f _ g hRange
    let P := Limits.pullback g f
    let fst_P : P ⟶ Spec R_K := Limits.pullback.fst g f
    let snd_P : P ⟶ X := Limits.pullback.snd g f
    have hpb : IsPullback fst_P snd_P g f := IsPullback.of_hasPullback g f
    have _ : IsClosedImmersion fst_P :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip inferInstance
    have _ : IsAffine P := isAffine_of_isAffineHom fst_P
    obtain ⟨pt₀⟩ : Nonempty ↥(Spec R_K) := PrimeSpectrum.nonempty_iff_nontrivial.mpr inferInstance
    obtain ⟨x₀, hx₀⟩ := hRange ⟨pt₀, rfl⟩
    obtain ⟨p₀, -, -⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := g) (g := f) pt₀ x₀ hx₀.symm
    let iso_P : P ≅ Spec (P.presheaf.obj (Opposite.op ⊤)) := P.isoSpec
    let R_P : CommRingCat.{u} := P.presheaf.obj (Opposite.op ⊤)
    have _ : Nontrivial ↥R_P := PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨iso_P.hom.base p₀⟩
    let φ : R_K ⟶ R_P := Spec.preimage (iso_P.inv ≫ fst_P)
    have hSpec_φ : Spec.map φ = iso_P.inv ≫ fst_P := Spec.map_preimage _
    have _ : IsClosedImmersion (Spec.map φ) := by rw [hSpec_φ]; infer_instance
    have hSurj_app : Function.Surjective ((Spec.map φ).app ⊤).hom :=
      (isClosedImmersion_iff_isAffineHom.mp inferInstance).2 ⊤ (isAffineOpen_top (Spec R_K))
    have hSurj_φ : Function.Surjective φ.hom := by
      intro b
      let b_top := (Scheme.ΓSpecIso R_P).inv.hom b
      obtain ⟨a_top, ha_top⟩ := hSurj_app b_top
      let a := (Scheme.ΓSpecIso R_K).hom.hom a_top
      refine ⟨a, ?_⟩
      have hcomm := Scheme.ΓSpecIso_naturality φ
      have h1 := congrArg (fun m : (Spec R_K).presheaf.obj (Opposite.op ⊤) ⟶ R_P => m.hom a_top) hcomm
      change (Scheme.ΓSpecIso R_P).hom.hom (((Spec.map φ).app ⊤).hom a_top) = φ.hom a at h1
      rw [ha_top] at h1
      have hb : (Scheme.ΓSpecIso R_P).hom.hom b_top = b := by
        change ((Scheme.ΓSpecIso R_P).inv ≫ (Scheme.ΓSpecIso R_P).hom).hom b = b
        rw [(Scheme.ΓSpecIso R_P).inv_hom_id]; rfl
      rw [hb] at h1; exact h1.symm
    have hInj_φ : Function.Injective φ.hom := by
      intro a₁ a₂ ha; by_contra hne
      have hu : IsUnit (φ.hom (a₁ - a₂)) := (hField (a₁ - a₂) (sub_ne_zero.mpr hne)).map φ.hom
      rw [map_sub, ha, sub_self] at hu; exact not_isUnit_zero hu
    let e_ring : R_K ≅ R_P := (RingEquiv.ofBijective φ.hom ⟨hInj_φ, hSurj_φ⟩).toCommRingCatIso
    have hφ_eq : φ = e_ring.hom := rfl
    have _ : IsIso (Spec.map φ) := by rw [hφ_eq]; infer_instance
    have hfst_eq : fst_P = iso_P.hom ≫ Spec.map φ := by
      rw [hSpec_φ, ← Category.assoc, iso_P.hom_inv_id, Category.id_comp]
    have _ : IsIso fst_P := by rw [hfst_eq]; infer_instance
    exact ⟨inv fst_P ≫ snd_P, by
      rw [Category.assoc, ← hpb.w, ← Category.assoc, IsIso.inv_hom_id, Category.id_comp]⟩

  have hOriginUniqueQR :
      ∀ (k₀ : Type u) [Field k₀]
        (R₀ : Type u) [CommRing R₀] [IsLocalRing R₀] [Algebra (Polynomial k₀) R₀]
        (Q_proj : Over (Spec (CommRingCat.of k₀)))
        (π_Q : Q_proj ⟶ Over.mk (Spec.map (CommRingCat.ofHom (Polynomial.C : k₀ →+* Polynomial k₀))))
        [IsProper π_Q.left]
        (o_proj : Spec (CommRingCat.of k₀) ⟶ Q_proj.left),
        o_proj ≫ π_Q.left = Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k₀))) →
        (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k₀) R₀))).base
            (IsLocalRing.closedPoint R₀) =
          (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k₀)))).base
            (⊥ : PrimeSpectrum k₀) →
        let g_Rbar : Spec (CommRingCat.of R₀) ⟶ Spec (CommRingCat.of (Polynomial k₀)) :=
          Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k₀) R₀))
        let S_k₁ := Spec (CommRingCat.of (IsLocalRing.ResidueField R₀))
        let Q_R := Limits.pullback π_Q.left g_Rbar
