      have hPb_comp : WeilIsEtaleSheafPullback (p₁ ≫ y) ℋ H_3 := by
        rw [hp12]
        exact (hPbComp p₂ η₀ ℋ (P_η₀.obj ℋ) H_3).1 hPb_η₀ hPb_H3_2
