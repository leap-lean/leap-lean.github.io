                        mapMono ((t.castSucc).succ).succAbove (Fin.strictMono_succAbove _) v))) =
              ∑ t : Fin p, d_term j ⟨j.1 + 1 + t.1, by omega⟩ := by
            refine Finset.sum_congr rfl fun t _ => ?_
            dsimp only [d_term]
            rw [map_zsmul, hmul_zsmul_right, smul_smul, ← pow_add, hmap_mul]
            have hsgn : (-1 : ℤ) ^ (j.1 + ((t.castSucc).succ).1) = (-1 : ℤ) ^ (j.1 + 1 + t.1) := by
              have hexp : j.1 + ((t.castSucc).succ).1 = j.1 + 1 + t.1 := by
                simp [Fin.val_succ, Fin.val_castSucc]; omega
              rw [hexp]
            rw [hsgn]
            congr 1
            have hu_eq :
