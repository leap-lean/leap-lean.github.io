        rw [hG_rat, Polynomial.derivative_map, h0, Polynomial.map_zero]
      rw [Polynomial.Separable, hder_rat, isCoprime_zero_right] at hsep
      have hdeg0 := Polynomial.natDegree_eq_zero_of_isUnit hsep
      omega
    exact ⟨G₀, hG_mon, hG_deg, hG_irr, hG_deriv, hG_eval⟩

  
  obtain ⟨A_poly, hA_deg, hMul_w⟩ :
      ∃ A_poly : Matrix (Fin N_geom) (Fin N_geom) (Polynomial E'),
        (∀ k j : Fin N_geom, (A_poly k j).natDegree ≤ B₀) ∧
        (∀ j : Fin N_geom,
          (algebraMap (Polynomial E') M h₀') * (w_op * e_M j) =
            ∑ k : Fin N_geom, (algebraMap (Polynomial E') M (A_poly k j)) * e_M k) := by
    let A₀ : Matrix (Fin N_geom) (Fin N_geom) (Polynomial E') := fun k j =>
      ∑ m : Fin R_Γ, ∑ i : Fin N_geom, Polynomial.C (a_coeff m i) * M_tab m i k j
    refine ⟨A₀, ?_, ?_⟩
    · intro k j
      dsimp [A₀]
      refine (Polynomial.natDegree_sum_le _ _).trans (Finset.sup_le fun m _ => ?_)
      refine (Polynomial.natDegree_sum_le _ _).trans (Finset.sup_le fun i _ => ?_)
      exact (Polynomial.natDegree_C_mul_le _ _).trans (hM_deg m i k j)
    · intro j
      have hw_lhs : (algebraMap (Polynomial E') M h₀') * (w_op * e_M j) =
          ∑ m : Fin R_Γ, ∑ i : Fin N_geom,
            ι_E' (a_coeff m i) *
              ((algebraMap (Polynomial E') M h₀') * ((η_tilde ^ (m : ℕ)) (e_M i) * e_M j)) := by
        conv_lhs => rw [hw_orb_op]
        rw [Finset.sum_mul, Finset.mul_sum]
        refine Finset.sum_congr rfl fun m _ => ?_
        rw [Finset.sum_mul, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => by ring
      rw [hw_lhs]
      simp_rw [hMul_tab, Finset.mul_sum]
      conv_lhs =>
        arg 2
        ext m
        rw [Finset.sum_comm]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun k _ => ?_
      dsimp [A₀]
      rw [map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul]
      change algebraMap (Polynomial E') M (Polynomial.C (a_coeff m i)) *
          (algebraMap (Polynomial E') M (M_tab m i k j) * e_M k) =
        (algebraMap (Polynomial E') M (Polynomial.C (a_coeff m i)) *
          algebraMap (Polynomial E') M (M_tab m i k j)) * e_M k
      ring
  have hCD_charpoly : ∀ r : ℕ, (A_poly.charpoly.coeff r).natDegree ≤ N_geom * B₀ := by
    have hCD_zero : ∀ (B : ℕ) (r : ℕ), ((0 : Polynomial (Polynomial E')).coeff r).natDegree ≤ B :=
      fun _ _ => by simp
    have hCD_one : ∀ r : ℕ, ((1 : Polynomial (Polynomial E')).coeff r).natDegree ≤ 0 := by
      intro r
      rcases eq_or_ne r 0 with rfl | hr
      · simp
      · simp [Polynomial.coeff_one, hr]
    have hCD_neg : ∀ {B : ℕ} {P : Polynomial (Polynomial E')},
        (∀ r : ℕ, (P.coeff r).natDegree ≤ B) → ∀ r : ℕ, ((-P).coeff r).natDegree ≤ B := by
      intro B P hP r
      rw [Polynomial.coeff_neg, Polynomial.natDegree_neg]
      exact hP r
    have hCD_add : ∀ {B : ℕ} {P Q : Polynomial (Polynomial E')},
        (∀ r : ℕ, (P.coeff r).natDegree ≤ B) →
        (∀ r : ℕ, (Q.coeff r).natDegree ≤ B) →
        ∀ r : ℕ, ((P + Q).coeff r).natDegree ≤ B := by
      intro B P Q hP hQ r
      rw [Polynomial.coeff_add]
      exact (Polynomial.natDegree_add_le _ _).trans (max_le (hP r) (hQ r))
    have hCD_sum : ∀ {α : Type} (s : Finset α) (f : α → Polynomial (Polynomial E')) (B : ℕ),
        (∀ x ∈ s, ∀ r : ℕ, ((f x).coeff r).natDegree ≤ B) →
        ∀ r : ℕ, ((∑ x ∈ s, f x).coeff r).natDegree ≤ B := by
      intro α s f B hf
      induction s using Finset.induction_on with
      | empty =>
        simp
      | insert a s ha ih =>
        rw [Finset.sum_insert ha]
        exact hCD_add (hf a (Finset.mem_insert_self a s))
          (ih fun x hx => hf x (Finset.mem_insert_of_mem hx))
    have hCD_mul : ∀ {B₁ B₂ : ℕ} {P Q : Polynomial (Polynomial E')},
        (∀ r : ℕ, (P.coeff r).natDegree ≤ B₁) →
        (∀ r : ℕ, (Q.coeff r).natDegree ≤ B₂) →
        ∀ r : ℕ, ((P * Q).coeff r).natDegree ≤ B₁ + B₂ := by
      intro B₁ B₂ P Q hP hQ r
      rw [Polynomial.coeff_mul]
      refine (Polynomial.natDegree_sum_le _ _).trans (Finset.sup_le fun p _ => ?_)
      exact Polynomial.natDegree_mul_le.trans (Nat.add_le_add (hP p.1) (hQ p.2))
    have hCD_prod : ∀ {α : Type} (s : Finset α) (f : α → Polynomial (Polynomial E')),
        (∀ x ∈ s, ∀ r : ℕ, ((f x).coeff r).natDegree ≤ B₀) →
        ∀ r : ℕ, ((∏ x ∈ s, f x).coeff r).natDegree ≤ s.card * B₀ := by
      intro α s f hf
      induction s using Finset.induction_on with
      | empty =>
        simpa using hCD_one
      | insert a s ha ih =>
        rw [Finset.prod_insert ha, Finset.card_insert_of_notMem ha, Nat.succ_mul, Nat.add_comm]
        exact hCD_mul (hf a (Finset.mem_insert_self a s))
          (ih fun x hx => hf x (Finset.mem_insert_of_mem hx))
    have hCD_charmat : ∀ (i j : Fin N_geom) (r : ℕ),
        ((A_poly.charmatrix i j).coeff r).natDegree ≤ B₀ := by
      intro i j
      rw [Matrix.charmatrix_apply, sub_eq_add_neg]
      refine hCD_add ?_ (hCD_neg ?_)
      · by_cases hij : i = j
        · subst hij
          rw [Matrix.diagonal_apply_eq]
          intro r
          rw [Polynomial.coeff_X]
          split_ifs <;> simp
        · rw [Matrix.diagonal_apply_ne _ hij]
          exact hCD_zero B₀
      · intro r
        rcases eq_or_ne r 0 with rfl | hr
        · rw [Polynomial.coeff_C_zero]
          exact hA_deg i j
        · rw [Polynomial.coeff_C_of_ne_zero hr]
          simp
    change ∀ r : ℕ, (A_poly.charmatrix.det.coeff r).natDegree ≤ N_geom * B₀
    rw [Matrix.det_apply]
    refine hCD_sum (Finset.univ : Finset (Equiv.Perm (Fin N_geom)))
      (fun σ : Equiv.Perm (Fin N_geom) =>
        Equiv.Perm.sign σ • ∏ i : Fin N_geom, A_poly.charmatrix (σ i) i)
      (N_geom * B₀) fun σ _ => ?_
    have hprod : ∀ r : ℕ,
        ((∏ i : Fin N_geom, A_poly.charmatrix (σ i) i).coeff r).natDegree ≤ N_geom * B₀ := by
      have hp := hCD_prod (Finset.univ : Finset (Fin N_geom))
        (fun i => A_poly.charmatrix (σ i) i) (fun i _ => hCD_charmat (σ i) i)
      simpa using hp
    rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with hs | hs
    · rw [hs, one_smul]
      exact hprod
    · rw [hs, Units.neg_smul, one_smul]
      exact hCD_neg hprod

  
  let G_E' : Polynomial (Polynomial E') := G.map (Polynomial.mapRingHom (algebraMap E E'))
  have hGE'_mon : G_E'.Monic := hG_mon.map _
  have hGE'_deg : G_E'.natDegree = N_geom := (hG_mon.natDegree_map _).trans hG_deg
