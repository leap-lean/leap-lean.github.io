    let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousIso e_B AddCommGrpCat.{u} J₀ J₁
    let m_raw := (adj₂.homEquiv F₀ (pf_h.obj (pb₁.obj F₀))).symm
      (adj₁.unit.app F₀ ≫ e_pf.hom.app (pb₁.obj F₀))
    let β := (adj_h.homEquiv (pb₂.obj F₀) (pb₁.obj F₀)).symm m_raw
    apply (adj_h.homEquiv (pb₂.obj F₀) F₁).injective
    apply (adj₂.homEquiv F₀ (pf_h.obj F₁)).injective
    apply (adj_sh₀.homEquiv P₀ (pf₂.obj (pf_h.obj F₁))).injective
    have hLHS_1 : (adj_h.homEquiv (pb₂.obj F₀) F₁) (pb_h.map c₂ ≫ c_h) = c₂ ≫ u_h :=
      (CategoryTheory.Adjunction.homEquiv_naturality_left adj_h c₂ c_h).trans
        (CategoryTheory.whisker_eq c₂ ((adj_h.homEquiv F₂ F₁).apply_symm_apply u_h))
    have hLHS_2 : (adj₂.homEquiv F₀ (pf_h.obj F₁)) (c₂ ≫ u_h) = u₂ ≫ pf₂.map u_h :=
      (CategoryTheory.Adjunction.homEquiv_naturality_right adj₂ c₂ u_h).trans
        (CategoryTheory.eq_whisker ((adj₂.homEquiv F₀ F₂).apply_symm_apply u₂) (pf₂.map u_h))
    have hRHS_1 : (adj_h.homEquiv (pb₂.obj F₀) F₁) (β ≫ c₁) = m_raw ≫ pf_h.map c₁ :=
      (CategoryTheory.Adjunction.homEquiv_naturality_right adj_h β c₁).trans
        (CategoryTheory.eq_whisker ((adj_h.homEquiv _ _).apply_symm_apply m_raw) (pf_h.map c₁))
    have hRHS_2 : (adj₂.homEquiv F₀ (pf_h.obj F₁)) (m_raw ≫ pf_h.map c₁) =
        u₁ ≫ e_pf.hom.app F₁ := by
      have k1 : (adj₂.homEquiv F₀ (pf_h.obj F₁)) (m_raw ≫ pf_h.map c₁) =
          (adj₁.unit.app F₀ ≫ e_pf.hom.app (pb₁.obj F₀)) ≫ pf₂.map (pf_h.map c₁) :=
        (CategoryTheory.Adjunction.homEquiv_naturality_right adj₂ m_raw (pf_h.map c₁)).trans
          (CategoryTheory.eq_whisker ((adj₂.homEquiv _ _).apply_symm_apply _) _)
      have k2 : e_pf.hom.app (pb₁.obj F₀) ≫ pf₂.map (pf_h.map c₁) =
          pf₁.map c₁ ≫ e_pf.hom.app F₁ :=
        (e_pf.hom.naturality c₁).symm
      have k3 : adj₁.unit.app F₀ ≫ pf₁.map c₁ = u₁ :=
        (CategoryTheory.Adjunction.homEquiv_unit adj₁ F₀ F₁ c₁).symm.trans
          ((adj₁.homEquiv F₀ F₁).apply_symm_apply u₁)
      exact k1.trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((CategoryTheory.whisker_eq _ k2).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              (CategoryTheory.eq_whisker k3 _))))
    have hL_tot : (adj_sh₀.homEquiv P₀ (pf₂.obj (pf_h.obj F₁)))
        ((adj₂.homEquiv F₀ (pf_h.obj F₁)) ((adj_h.homEquiv (pb₂.obj F₀) F₁) (pb_h.map c₂ ≫ c_h))) =
        η_sh₀ ≫ (CategoryTheory.sheafToPresheaf J₀ AddCommGrpCat.{u}).map (u₂ ≫ pf₂.map u_h) :=
      (congrArg (adj_sh₀.homEquiv P₀ (pf₂.obj (pf_h.obj F₁)))
        ((congrArg (adj₂.homEquiv F₀ (pf_h.obj F₁)) hLHS_1).trans hLHS_2)).trans
        (CategoryTheory.Adjunction.homEquiv_unit adj_sh₀ P₀ (pf₂.obj (pf_h.obj F₁)) (u₂ ≫ pf₂.map u_h))
    have hR_tot : (adj_sh₀.homEquiv P₀ (pf₂.obj (pf_h.obj F₁)))
        ((adj₂.homEquiv F₀ (pf_h.obj F₁)) ((adj_h.homEquiv (pb₂.obj F₀) F₁) (β ≫ c₁))) =
        η_sh₀ ≫ (CategoryTheory.sheafToPresheaf J₀ AddCommGrpCat.{u}).map (u₁ ≫ e_pf.hom.app F₁) :=
      (congrArg (adj_sh₀.homEquiv P₀ (pf₂.obj (pf_h.obj F₁)))
        ((congrArg (adj₂.homEquiv F₀ (pf_h.obj F₁)) hRHS_1).trans hRHS_2)).trans
        (CategoryTheory.Adjunction.homEquiv_unit adj_sh₀ P₀ (pf₂.obj (pf_h.obj F₁)) (u₁ ≫ e_pf.hom.app F₁))
    have h_u₁ : η_sh₀ ≫ (CategoryTheory.sheafToPresheaf J₀ AddCommGrpCat.{u}).map u₁ =
        CategoryTheory.Functor.whiskerLeft B₁.op η_sh₁ :=
      (CategoryTheory.Adjunction.homEquiv_unit adj_sh₀ P₀ (pf₁.obj F₁) u₁).symm.trans
        ((adj_sh₀.homEquiv P₀ (pf₁.obj F₁)).apply_symm_apply _)
    have h_u₂ : η_sh₀ ≫ (CategoryTheory.sheafToPresheaf J₀ AddCommGrpCat.{u}).map u₂ =
        CategoryTheory.Functor.whiskerLeft B₂.op η_sh₂ :=
      (CategoryTheory.Adjunction.homEquiv_unit adj_sh₀ P₀ (pf₂.obj F₂) u₂).symm.trans
        ((adj_sh₀.homEquiv P₀ (pf₂.obj F₂)).apply_symm_apply _)
    have h_uh : η_sh₂ ≫ (CategoryTheory.sheafToPresheaf J₂ AddCommGrpCat.{u}).map u_h =
        CategoryTheory.Functor.whiskerLeft B_h.op η_sh₁ :=
      (CategoryTheory.Adjunction.homEquiv_unit adj_sh₂ P₂ (pf_h.obj F₁) u_h).symm.trans
        ((adj_sh₂.homEquiv P₂ (pf_h.obj F₁)).apply_symm_apply _)
    refine hL_tot.trans ((?_ : _ = _).trans hR_tot.symm)
    ext ⟨U⟩ : 2
    have cL : (η_sh₀ ≫ (CategoryTheory.sheafToPresheaf J₀ AddCommGrpCat.{u}).map (u₂ ≫ pf₂.map u_h)).app
        (Opposite.op U) =
        (η_sh₀.app (Opposite.op U) ≫ u₂.hom.app (Opposite.op U)) ≫
          u_h.hom.app (Opposite.op (B₂.obj U)) :=
      (CategoryTheory.Category.assoc _ _ _).symm
    have cL1 : η_sh₀.app (Opposite.op U) ≫ u₂.hom.app (Opposite.op U) =
        η_sh₂.app (Opposite.op (B₂.obj U)) :=
      congrArg (fun γ => γ.app (Opposite.op U)) h_u₂
    have cL2 : η_sh₂.app (Opposite.op (B₂.obj U)) ≫ u_h.hom.app (Opposite.op (B₂.obj U)) =
        η_sh₁.app (Opposite.op (B_h.obj (B₂.obj U))) :=
      congrArg (fun γ => γ.app (Opposite.op (B₂.obj U))) h_uh
    have cR : (η_sh₀ ≫ (CategoryTheory.sheafToPresheaf J₀ AddCommGrpCat.{u}).map (u₁ ≫ e_pf.hom.app F₁)).app
        (Opposite.op U) =
        (η_sh₀.app (Opposite.op U) ≫ u₁.hom.app (Opposite.op U)) ≫
          F₁.obj.map (e_B.inv.app U).op :=
      (CategoryTheory.Category.assoc _ _ _).symm
    have cR1 : η_sh₀.app (Opposite.op U) ≫ u₁.hom.app (Opposite.op U) =
        η_sh₁.app (Opposite.op (B₁.obj U)) :=
      congrArg (fun γ => γ.app (Opposite.op U)) h_u₁
    have cR2 : η_sh₁.app (Opposite.op (B₁.obj U)) ≫ F₁.obj.map (e_B.inv.app U).op =
        η_sh₁.app (Opposite.op (B_h.obj (B₂.obj U))) :=
      (η_sh₁.naturality (e_B.inv.app U).op).symm.trans (CategoryTheory.Category.id_comp _)
    exact cL.trans ((CategoryTheory.eq_whisker cL1 _).trans
      (cL2.trans (cR2.symm.trans ((CategoryTheory.eq_whisker cR1.symm _).trans cR.symm))))

  have hAbsExtPostIso : ∀ {D : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} D] [CategoryTheory.Abelian D]
      [CategoryTheory.HasExt.{u} D]
      (X G₁ G₂ : D) (c_G : G₁ ⟶ G₂) [CategoryTheory.IsIso c_G],
      ∃ Φ : CategoryTheory.Abelian.Ext.{u} X G₁ q ≃+ CategoryTheory.Abelian.Ext.{u} X G₂ q,
        ∀ x : CategoryTheory.Abelian.Ext.{u} X G₁ q,
          Φ x = (CategoryTheory.Abelian.Ext.mk₀.{u} c_G).postcomp X (Nat.add_zero q) x := by
    intro D _ _ _ X G₁ G₂ c_G _
    let f_fwd := (CategoryTheory.Abelian.Ext.mk₀.{u} c_G).postcomp X (Nat.add_zero q)
    let f_bwd := (CategoryTheory.Abelian.Ext.mk₀.{u} (CategoryTheory.inv c_G)).postcomp X (Nat.add_zero q)
    refine ⟨{ toFun := f_fwd
              invFun := f_bwd
              left_inv := fun x => ?_
              right_inv := fun y => ?_
              map_add' := f_fwd.map_add }, fun _ => rfl⟩
    · change (x.comp (CategoryTheory.Abelian.Ext.mk₀.{u} c_G) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀.{u} (CategoryTheory.inv c_G)) (Nat.add_zero q) = x
      rw [CategoryTheory.Abelian.Ext.comp_assoc x _ _ (Nat.add_zero q) (Nat.add_zero 0)
            (by omega),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.hom_inv_id]
      exact CategoryTheory.Abelian.Ext.comp_mk₀_id x
    · change (y.comp (CategoryTheory.Abelian.Ext.mk₀.{u} (CategoryTheory.inv c_G)) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀.{u} c_G) (Nat.add_zero q) = y
      rw [CategoryTheory.Abelian.Ext.comp_assoc y _ _ (Nat.add_zero q) (Nat.add_zero 0)
            (by omega),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.inv_hom_id]
      exact CategoryTheory.Abelian.Ext.comp_mk₀_id y

  have hAbsExtIntertwine : ∀ {C D : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C] [CategoryTheory.Abelian C]
      [CategoryTheory.Category.{u + 1, u + 1} D] [CategoryTheory.Abelian D]
      [hExtC : CategoryTheory.HasExt.{u} C] [hExtD : CategoryTheory.HasExt.{u} D]
      (F : CategoryTheory.Functor C D) [F.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      {X₂ G₂ M₂ : C} {X₁ G₁ M₁ : D}
      (ιℤ : X₁ ⟶ F.obj X₂)
      (β : F.obj G₂ ⟶ G₁)
      (c₂ : G₂ ⟶ M₂) (c₁ : G₁ ⟶ M₁) (c_h : F.obj M₂ ⟶ M₁)
      (hcoc : F.map c₂ ≫ c_h = β ≫ c₁)
      (x₂ : CategoryTheory.Abelian.Ext.{u} X₂ G₂ q),
      (CategoryTheory.Abelian.Ext.mk₀.{u} c_h).postcomp X₁ (Nat.add_zero q)
        ((CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ).comp
          ((@CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ M₂ q)
            ((CategoryTheory.Abelian.Ext.mk₀.{u} c₂).postcomp X₂ (Nat.add_zero q) x₂))
          (Nat.zero_add q)) =
      (CategoryTheory.Abelian.Ext.mk₀.{u} c₁).postcomp X₁ (Nat.add_zero q)
        ((CategoryTheory.Abelian.Ext.mk₀.{u} β).postcomp X₁ (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ).precomp (F.obj G₂) (Nat.zero_add q)
            ((@CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ G₂ q) x₂))) := by
    intro C D _ _ _ _ hExtC hExtD F _ _ _ X₂ G₂ M₂ X₁ G₁ M₁ ιℤ β c₂ c₁ c_h hcoc x₂
    let mapG := @CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ G₂ q
    let mapM := @CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ M₂ q
    have hmap : mapM (x₂.comp (CategoryTheory.Abelian.Ext.mk₀.{u} c₂) (Nat.add_zero q)) =
        (mapG x₂).comp (CategoryTheory.Abelian.Ext.mk₀.{u} (F.map c₂)) (Nat.add_zero q) :=
      (@CategoryTheory.Functor.mapExtAddHom_apply.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ M₂ q _).trans
        ((@CategoryTheory.Abelian.Ext.mapExactFunctor_comp.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD
          X₂ G₂ M₂ q 0 x₂ (CategoryTheory.Abelian.Ext.mk₀.{u} c₂) q (Nat.add_zero q)).trans
          (congrArg₂
            (fun (a : CategoryTheory.Abelian.Ext.{u} (F.obj X₂) (F.obj G₂) q)
                 (b : CategoryTheory.Abelian.Ext.{u} (F.obj G₂) (F.obj M₂) 0) =>
              a.comp b (Nat.add_zero q))
            (@CategoryTheory.Functor.mapExtAddHom_apply.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ G₂ q x₂).symm
            (@CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD G₂ M₂ c₂)))
    let w : CategoryTheory.Abelian.Ext.{u} (F.obj X₂) (F.obj G₂) q := mapG x₂
    change ((CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ).comp
          (mapM (x₂.comp (CategoryTheory.Abelian.Ext.mk₀.{u} c₂) (Nat.add_zero q)))
          (Nat.zero_add q)).comp (CategoryTheory.Abelian.Ext.mk₀.{u} c_h) (Nat.add_zero q) =
        (((CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ).comp w (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀.{u} β) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀.{u} c₁) (Nat.add_zero q)
    rw [hmap]
    have h1 : (CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ).comp
        (w.comp (CategoryTheory.Abelian.Ext.mk₀.{u} (F.map c₂)) (Nat.add_zero q)) (Nat.zero_add q) =
        ((CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ).comp w (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀.{u} (F.map c₂)) (Nat.add_zero q) :=
      (CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ) w
        (CategoryTheory.Abelian.Ext.mk₀.{u} (F.map c₂))
        (Nat.zero_add q) (Nat.add_zero q) (by omega)).symm
    rw [h1]
    set u := (CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ).comp w (Nat.zero_add q)
    rw [CategoryTheory.Abelian.Ext.comp_assoc u _ _ (Nat.add_zero q) (Nat.add_zero 0) (by omega),
        CategoryTheory.Abelian.Ext.comp_assoc u _ _ (Nat.add_zero q) (Nat.add_zero 0) (by omega),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hcoc]

  have hTermPullIso : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      CategoryTheory.IsIso
        ((weilEtaleIdTerminalIsTerminal.{u} Y₁).from
          ((weilEtaleSitePullback h).obj (weilEtaleIdTerminal.{u} Y₂))) := by
    intro Y₁ Y₂ h
    let T₁ := weilEtaleIdTerminal.{u} Y₁
    let hT₁ := weilEtaleIdTerminalIsTerminal.{u} Y₁
    let T₂ := weilEtaleIdTerminal.{u} Y₂
    let BT₂ := (weilEtaleSitePullback h).obj T₂
    have hBT₂_hom : BT₂.hom = CategoryTheory.Limits.pullback.snd (𝟙 Y₂) h := rfl
    have hIso_snd : CategoryTheory.IsIso (CategoryTheory.Limits.pullback.snd (𝟙 Y₂) h) :=
      CategoryTheory.Limits.pullback_snd_iso_of_left_iso (𝟙 Y₂) h
    let inv_snd := @CategoryTheory.inv _ _ _ _ (CategoryTheory.Limits.pullback.snd (𝟙 Y₂) h) hIso_snd
    let τ_inv : T₁ ⟶ BT₂ :=
      CategoryTheory.MorphismProperty.Over.homMk inv_snd
        (by
          change inv_snd ≫ CategoryTheory.Limits.pullback.snd (𝟙 Y₂) h = 𝟙 Y₁
          exact @CategoryTheory.IsIso.inv_hom_id _ _ _ _ _ hIso_snd)
        trivial
    refine ⟨⟨τ_inv, ?_, hT₁.hom_ext _ _⟩⟩
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · change (hT₁.from BT₂).left ≫ inv_snd = 𝟙 BT₂.left
      have hfrom_left : (hT₁.from BT₂).left = BT₂.hom :=
        (CategoryTheory.Category.comp_id _).symm.trans
          (CategoryTheory.MorphismProperty.Over.w (hT₁.from BT₂))
      exact (congrArg (· ≫ inv_snd) (hfrom_left.trans hBT₂_hom)).trans
        (@CategoryTheory.IsIso.hom_inv_id _ _ _ _ _ hIso_snd)
    · exact Subsingleton.elim _ _

  let B₀ : CommRingCat.{u} := CommRingCat.of (ULift.{u} ℤ)
  let Z₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec B₀
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let G₀ : CategoryTheory.Sheaf Z₀.smallEtaleTopology AddCommGrpCat.{u} :=
    weilEtaleTorsionSheaf Z₀ ℓ
  let toRing : ∀ R : CommRingCat.{u}, B₀ ⟶ R :=
    fun R => CommRingCat.ofHom ((Int.castRingHom ↑R).comp ULift.ringEquiv.toRingHom)
  have htoRing_comp : ∀ {R₁ R₂ : CommRingCat.{u}} (g : R₁ ⟶ R₂), toRing R₁ ≫ g = toRing R₂ := by
    intro R₁ R₂ g; apply CommRingCat.hom_ext; ext ⟨n⟩; exact map_intCast g.hom n

  let α_ℤ : (CategoryTheory.Functor.const 𝒥).obj B₀ ⟶ B :=
    { app := fun j => toRing (B.obj j)
      naturality := fun j j' φ => by
        dsimp; rw [Category.id_comp]; exact (htoRing_comp (B.map φ)).symm }
  let f_inf : B₀ ⟶ c.pt := toRing c.pt
  have hα_inf : ∀ j : 𝒥, α_ℤ.app j ≫ c.ι.app j = f_inf := fun j => htoRing_comp (c.ι.app j)

  have hBridgeSys : ∃ (Φ : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (π : Y ⟶ Z₀),
        (((weilEtaleSitePullback π).sheafPullback AddCommGrpCat.{u}
          Z₀.smallEtaleTopology Y.smallEtaleTopology).obj G₀).H q ≃+
        weilEtaleTorsionH Y ℓ q),
      ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
        (π₁ : Y₁ ⟶ Z₀) (π₂ : Y₂ ⟶ Z₀) (h : Y₁ ⟶ Y₂) (h_eq : h ≫ π₂ = π₁)
        (x₂ : (((weilEtaleSitePullback π₂).sheafPullback AddCommGrpCat.{u}
          Z₀.smallEtaleTopology Y₂.smallEtaleTopology).obj G₀).H q)
        (x₁ : (((weilEtaleSitePullback π₁).sheafPullback AddCommGrpCat.{u}
          Z₀.smallEtaleTopology Y₁.smallEtaleTopology).obj G₀).H q)
        (p_h : weilEtaleTorsionH Y₂ ℓ q →+ weilEtaleTorsionH Y₁ ℓ q),
        WeilIsTorsionEtalePullback h ℓ q p_h →
        (WeilEtaleTrianglePullbackMapsTo π₁ π₂ h h_eq G₀ q x₂ x₁ ↔
          p_h (Φ π₂ x₂) = Φ π₁ x₁) := by
    let cM_of : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
        ((weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
          Y₂.smallEtaleTopology Y₁.smallEtaleTopology).obj (weilEtaleTorsionSheaf Y₂ ℓ) ⟶
        weilEtaleTorsionSheaf Y₁ ℓ :=
      fun {Y₁ Y₂} h =>
        let B_h := weilEtaleSitePullback h
        let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y₂.smallEtaleTopology Y₁.smallEtaleTopology
        let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
          Y₂.smallEtaleTopology Y₁.smallEtaleTopology
        let P₁ := (CategoryTheory.Functor.const (Opposite Y₁.Etale)).obj AM
        let P₂ := (CategoryTheory.Functor.const (Opposite Y₂.Etale)).obj AM
        (adj_h.homEquiv (weilEtaleTorsionSheaf Y₂ ℓ) (weilEtaleTorsionSheaf Y₁ ℓ)).symm
          (((CategoryTheory.sheafificationAdjunction Y₂.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
            P₂ (pf_h.obj (weilEtaleTorsionSheaf Y₁ ℓ))).symm
            (CategoryTheory.Functor.whiskerLeft B_h.op
              ((CategoryTheory.sheafificationAdjunction Y₁.smallEtaleTopology AddCommGrpCat.{u}).unit.app P₁)))
    have hcM_iso : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
        CategoryTheory.IsIso (cM_of h) := fun {Y₁ Y₂} h =>
      (hAbsConstEqIso _ _ (weilEtaleSitePullback h)
        (weilEtaleIdTerminal Y₁) (weilEtaleIdTerminalIsTerminal Y₁)
        (weilEtaleIdTerminal Y₂) (weilEtaleIdTerminalIsTerminal Y₂) AM).2 (hTermPullIso h)
    have hΦ_ex : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (π : Y ⟶ Z₀),
        ∃ Φ : (((weilEtaleSitePullback π).sheafPullback AddCommGrpCat.{u}
            Z₀.smallEtaleTopology Y.smallEtaleTopology).obj G₀).H q ≃+
          weilEtaleTorsionH Y ℓ q,
          ∀ x, Φ x = (CategoryTheory.Abelian.Ext.mk₀.{u} (cM_of π)).postcomp
