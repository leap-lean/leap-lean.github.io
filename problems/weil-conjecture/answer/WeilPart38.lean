              have hlt1 : (θ i.succ).1 < (θ j.succ).1 := hθ (Fin.succ_lt_succ_iff.mpr hij)
              omega
            have hpeel : ∀ i : Fin (r' + 1), (θ i.succ).1 = (θ' i).1 + 1 := by
              intro i
              have hlt : (θ 0).1 < (θ i.succ).1 := hθ (Fin.succ_pos i)
