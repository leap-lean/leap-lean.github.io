      rw [← hG_mon.natDegree_map (algebraMap (Polynomial E) (RatFunc E)), ← hG_rat, hw_deg_op]
    have hG_irr : Irreducible G₀ := by
      have hw_int_RE : _root_.IsIntegral (RatFunc E) w_op := Algebra.IsIntegral.isIntegral w_op
      have hirr_rat : Irreducible (G₀.map (algebraMap (Polynomial E) (RatFunc E))) := by
        rw [← hG_rat]
        exact minpoly.irreducible hw_int_RE
      exact (hG_mon.irreducible_iff_irreducible_map_fraction_map (K := RatFunc E)).mpr hirr_rat
    have hG_deriv : Polynomial.derivative G₀ ≠ 0 := by
      intro h0
      have hsep : (minpoly (RatFunc E) w_op).Separable :=
        Algebra.IsSeparable.isSeparable (RatFunc E) w_op
