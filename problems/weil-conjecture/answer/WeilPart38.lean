import WeilPart37
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_sing_dev_locConst_val_ring_and_etale_hdi_baseChange (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (M_max : Ideal ↥(integralClosure (Polynomial k)
      (AlgebraicClosure (FractionRing (Polynomial k)))))
    [M_max.IsMaximal]
    (hM : M_max.comap (algebraMap (Polynomial k)
      ↥(integralClosure (Polynomial k) (AlgebraicClosure (FractionRing (Polynomial k))))) =
      Ideal.span {Polynomial.X}) :
    letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let P := Polynomial k
    let Ω := AlgebraicClosure (FractionRing P)
    let R_bar := Localization.AtPrime M_max
    let t_bar : R_bar := algebraMap P R_bar Polynomial.X
    let AM : AddCommGrpCat.{u} :=
      AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of P) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0))
    let η : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of P) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P Ω))
    let g_Rbar : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of P) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P R_bar))
    let propIsoEta := fun {M M_Ω : AlgebraicGeometry.Scheme.{u}} (j_M : M_Ω ⟶ M) =>
      let B_j : CategoryTheory.Functor M.Etale M_Ω.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ j_M
      ∀ [_hc : B_j.IsContinuous M.smallEtaleTopology M_Ω.smallEtaleTopology]
        (T_M : M.Etale) (hT_M : CategoryTheory.Limits.IsTerminal T_M)
        (T_Ω : M_Ω.Etale) (hT_Ω : CategoryTheory.Limits.IsTerminal T_Ω),
        let pf_j := B_j.sheafPushforwardContinuous AddCommGrpCat.{u}
          M.smallEtaleTopology M_Ω.smallEtaleTopology
        let adj_M := CategoryTheory.constantSheafAdj M.smallEtaleTopology AddCommGrpCat.{u} hT_M
        let adj_Ω := CategoryTheory.constantSheafAdj M_Ω.smallEtaleTopology AddCommGrpCat.{u} hT_Ω
        CategoryTheory.IsIso
          ((adj_M.homEquiv AM (pf_j.obj (weilEtaleTorsionSheaf M_Ω ℓ))).symm
            (adj_Ω.unit.app AM ≫
              (weilEtaleTorsionSheaf M_Ω ℓ).obj.map (hT_Ω.from (B_j.obj T_M)).op))
    (IsDomain R_bar ∧
      HenselianLocalRing R_bar ∧
      IsAlgClosed (IsLocalRing.ResidueField R_bar) ∧
      ∃ j_Rbar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R_bar),
        AlgebraicGeometry.IsOpenImmersion j_Rbar ∧
        j_Rbar ≫ g_Rbar = η ∧
        Set.range j_Rbar.base = (PrimeSpectrum.basicOpen t_bar).1 ∧
        g_Rbar.base (IsLocalRing.closedPoint R_bar) = s₀.base (⊥ : PrimeSpectrum k)) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u})
        (w : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of P))
        [AlgebraicGeometry.Etale w]
        (s_W : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W),
      s_W ≫ w = s₀ →
      ∃ g_W : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ W,
        g_W ≫ w = g_Rbar ∧
        g_W.base (IsLocalRing.closedPoint R_bar) = s_W.base (⊥ : PrimeSpectrum k)) ∧
    ((∀ {Y W U U' : AlgebraicGeometry.Scheme.{u}}
        (w : W ⟶ Y) [AlgebraicGeometry.Etale w]
        (j : U ⟶ Y) (j' : U' ⟶ W) (w' : U' ⟶ U),
      CategoryTheory.IsPullback w' j' j w →
      ∀ (b : ℕ),
        WeilIsEtaleSheafPullback w
          (weilEtaleHigherDirectImage j b (weilEtaleTorsionSheaf U ℓ))
          (weilEtaleHigherDirectImage j' b (weilEtaleTorsionSheaf U' ℓ))) ∧
     (∀ (Y : AlgebraicGeometry.Scheme.{u}) (b : ℕ),
        1 ≤ b →
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage (𝟙 Y) b (weilEtaleTorsionSheaf Y ℓ)))) ∧
    (∀ (_hDom : IsDomain R_bar) [HenselianLocalRing R_bar]
        [IsAlgClosed (IsLocalRing.ResidueField R_bar)]
        (j_Rbar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R_bar))
        [AlgebraicGeometry.IsOpenImmersion j_Rbar],
      j_Rbar ≫ g_Rbar = η →
      Set.range j_Rbar.base = (PrimeSpectrum.basicOpen t_bar).1 →
      (∀ {M M_Ω : AlgebraicGeometry.Scheme.{u}}
          (f_M : M ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_bar))
          [AlgebraicGeometry.Flat f_M]
          (f_MΩ : M_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
          (j_M : M_Ω ⟶ M),
        CategoryTheory.IsPullback j_M f_MΩ f_M j_Rbar →
        (∀ x : ↥M, f_M.base x = IsLocalRing.closedPoint R_bar →
          ∃ (V : AlgebraicGeometry.Scheme.{u}) (v₀ : ↥V) (e : V ⟶ M)
            (M' M'_Ω : AlgebraicGeometry.Scheme.{u})
            (f_M' : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_bar))
            (f_M'Ω : M'_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
            (j_M' : M'_Ω ⟶ M') (q : V ⟶ M'),
            AlgebraicGeometry.Etale e ∧
            e.base v₀ = x ∧
            AlgebraicGeometry.Flat f_M' ∧
            CategoryTheory.IsPullback j_M' f_M'Ω f_M' j_Rbar ∧
            propIsoEta j_M' ∧
            AlgebraicGeometry.Etale q ∧
            e ≫ f_M = q ≫ f_M') →
        propIsoEta j_M) ∧
      (∀ {M M_Ω : AlgebraicGeometry.Scheme.{u}}
          (f_M : M ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_bar))
          [AlgebraicGeometry.Flat f_M]
          (f_MΩ : M_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
          (j_M : M_Ω ⟶ M)
          (i₀ : AlgebraicGeometry.Spec
            (CommRingCat.of (IsLocalRing.ResidueField R_bar)) ⟶ M)
          [AlgebraicGeometry.IsClosedImmersion i₀],
        CategoryTheory.IsPullback j_M f_MΩ f_M j_Rbar →
        (∀ x : ↥M, x ∉ Set.range i₀.base →
          f_M.base x = IsLocalRing.closedPoint R_bar →
          ∃ (O : M.Opens) (M' M'_Ω : AlgebraicGeometry.Scheme.{u})
            (f_M' : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_bar))
            (f_M'Ω : M'_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
            (j_M' : M'_Ω ⟶ M') (u : O.toScheme ⟶ M'),
            x ∈ O ∧
            AlgebraicGeometry.Flat f_M' ∧
            CategoryTheory.IsPullback j_M' f_M'Ω f_M' j_Rbar ∧
            propIsoEta j_M' ∧
            AlgebraicGeometry.Etale u ∧
            u ≫ f_M' = O.ι ≫ f_M) →
        Subsingleton (weilEtaleTorsionH M ℓ 1) →
        (∀ ψ₀ : weilEtaleTorsionH M ℓ 0 →+ weilEtaleTorsionH M_Ω ℓ 0,
          WeilIsTorsionEtalePullback j_M ℓ 0 ψ₀ → Function.Bijective ψ₀) →
        propIsoEta j_M) ∧
      (∀ {M : AlgebraicGeometry.Scheme.{u}}
          (i₀ : AlgebraicGeometry.Spec
            (CommRingCat.of (IsLocalRing.ResidueField R_bar)) ⟶ M)
          [AlgebraicGeometry.IsClosedImmersion i₀]
          (S : CategoryTheory.Sheaf M.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ (K : Type u) [Field K] [IsAlgClosed K]
            (z_bar : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ M),
          z_bar.base (⊥ : PrimeSpectrum K) ∉ Set.range i₀.base →
          ∃ G₀ : CategoryTheory.Sheaf
              (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u},
            WeilIsEtaleSheafPullback z_bar S G₀ ∧ CategoryTheory.Limits.IsZero G₀) →
        Subsingleton (S.H 0) →
        CategoryTheory.Limits.IsZero S)) ∧
    (∀ (_hDom : IsDomain R_bar) [HenselianLocalRing R_bar]
        [IsAlgClosed (IsLocalRing.ResidueField R_bar)]
        (j_Rbar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R_bar))
        [AlgebraicGeometry.IsOpenImmersion j_Rbar]
        (hEt_j : AlgebraicGeometry.Etale j_Rbar),
      j_Rbar ≫ g_Rbar = η →
      Set.range j_Rbar.base = (PrimeSpectrum.basicOpen t_bar).1 →
      ∀ {X_R X_Ω : AlgebraicGeometry.Scheme.{u}}
        (f_R : X_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_bar))
        (f_Ω : X_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        (j_X : X_Ω ⟶ X_R),
        CategoryTheory.IsPullback j_X f_Ω f_R j_Rbar →
        ∀ (r : ℕ) (ψ_r : weilEtaleTorsionH X_R ℓ r →+ weilEtaleTorsionH X_Ω ℓ r),
          WeilIsTorsionEtalePullback j_X ℓ r ψ_r →
          ∀ (T_R : (AlgebraicGeometry.Spec (CommRingCat.of R_bar)).Etale)
            (hT : CategoryTheory.Limits.IsTerminal T_R),
            let U_Ω : (AlgebraicGeometry.Spec (CommRingCat.of R_bar)).Etale :=
              CategoryTheory.MorphismProperty.Over.mk ⊤ j_Rbar hEt_j
            (Function.Bijective ψ_r →
              Function.Bijective
                ((weilEtaleHigherDirectImage f_R r (weilEtaleTorsionSheaf X_R ℓ)).obj.map
                  (Opposite.op (hT.from U_Ω)))) ∧
            (Function.Injective ψ_r →
              Function.Injective
                ((weilEtaleHigherDirectImage f_R r (weilEtaleTorsionSheaf X_R ℓ)).obj.map
                  (Opposite.op (hT.from U_Ω))))) :=
by
  classical
  
  
  have hValRingAndDichot :
      let P := Polynomial k
      let Ω := AlgebraicClosure (FractionRing P)
      let R_bar := Localization.AtPrime M_max
      let t_bar : R_bar := algebraMap P R_bar Polynomial.X
      let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of P) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0))
      let η : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of P) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P Ω))
      let g_Rbar : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of P) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P R_bar))
      (IsDomain R_bar ∧
        HenselianLocalRing R_bar ∧
        IsAlgClosed (IsLocalRing.ResidueField R_bar) ∧
        ∃ j_Rbar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of R_bar),
          AlgebraicGeometry.IsOpenImmersion j_Rbar ∧
          j_Rbar ≫ g_Rbar = η ∧
          Set.range j_Rbar.base = (PrimeSpectrum.basicOpen t_bar).1 ∧
          g_Rbar.base (IsLocalRing.closedPoint R_bar) = s₀.base (⊥ : PrimeSpectrum k)) ∧
      t_bar ≠ 0 ∧
      ((IsLocalRing.residue R_bar).comp (algebraMap P R_bar) =
        (((IsLocalRing.residue R_bar).comp (algebraMap P R_bar)).comp Polynomial.C).comp
          (Polynomial.evalRingHom 0)) ∧
      (∀ p : ↥(AlgebraicGeometry.Spec (CommRingCat.of R_bar)),
        p ∈ (PrimeSpectrum.basicOpen t_bar).1 ∨ p = IsLocalRing.closedPoint R_bar) := by
    clear * - hM
    intro P Ω R_bar t_bar s₀ η g_Rbar
    let K₀ := FractionRing P
    let B_bar := integralClosure P Ω
    have hinj_P_K0 : Function.Injective (algebraMap P K₀) := IsFractionRing.injective P K₀
    have hinj_K0_Ω : Function.Injective (algebraMap K₀ Ω) := RingHom.injective (algebraMap K₀ Ω)
    have hinj_P_Ω : Function.Injective (algebraMap P Ω) := by
      rw [IsScalarTower.algebraMap_eq P K₀ Ω]
      exact hinj_K0_Ω.comp hinj_P_K0
    have hinj_P_B : Function.Injective (algebraMap P ↥B_bar) := fun _ _ hpq =>
      hinj_P_Ω (congrArg Subtype.val hpq)
    let ev0 : P →+* k := Polynomial.evalRingHom 0
    have hm0_ker : RingHom.ker ev0 = Ideal.span ({Polynomial.X} : Set P) := by
      ext p
      rw [RingHom.mem_ker, Ideal.mem_span_singleton]
      change Polynomial.eval 0 p = 0 ↔ Polynomial.X ∣ p
      rw [← Polynomial.IsRoot.def, ← Polynomial.dvd_iff_isRoot, map_zero, sub_zero]
    have _ : Algebra.IsIntegral P ↥B_bar := inferInstance
    have hDom_R : IsDomain R_bar :=
      IsLocalization.isDomain_of_le_nonZeroDivisors R_bar M_max.primeCompl_le_nonZeroDivisors
    let _ : IsDomain R_bar := hDom_R
    have hB_units : ∀ y : ↥M_max.primeCompl, IsUnit (B_bar.val y.1) := by
      intro y
      apply Ne.isUnit
      intro h0
      have hy0 : y.1 = 0 := Subtype.ext h0
      exact y.2 (by rw [hy0]; exact M_max.zero_mem)
    let φ_R_Ω : R_bar →+* Ω :=
      IsLocalization.lift (M := M_max.primeCompl) (g := B_bar.val) hB_units
    have hφ_B : ∀ b : ↥B_bar, φ_R_Ω (algebraMap ↥B_bar R_bar b) = b.1 :=
      IsLocalization.lift_eq hB_units
    have hφ_comp : φ_R_Ω.comp (algebraMap P R_bar) = algebraMap P Ω := by
      apply RingHom.ext; intro p
      change φ_R_Ω (algebraMap P R_bar p) = algebraMap P Ω p
      rw [IsScalarTower.algebraMap_apply P ↥B_bar R_bar p, hφ_B]; rfl
    have hφ_inj : Function.Injective φ_R_Ω := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨⟨b, s⟩, hsx⟩ := IsLocalization.surj M_max.primeCompl x
      have hb0_val : b.1 = 0 := by
        have h1 := congrArg φ_R_Ω hsx
        rw [map_mul, hx, zero_mul, hφ_B] at h1
        exact h1.symm
      have hb0 : b = 0 := Subtype.ext hb0_val
      rw [hb0, map_zero] at hsx
      exact (IsLocalization.map_units R_bar s).mul_left_eq_zero.mp hsx
    have ht_max : t_bar ∈ IsLocalRing.maximalIdeal R_bar := by
      change algebraMap P R_bar Polynomial.X ∈ IsLocalRing.maximalIdeal R_bar
      rw [IsScalarTower.algebraMap_apply P ↥B_bar R_bar Polynomial.X,
        IsLocalization.AtPrime.to_map_mem_maximal_iff R_bar M_max]
      change Polynomial.X ∈ M_max.comap (algebraMap P ↥B_bar)
      rw [hM]
      exact Ideal.mem_span_singleton_self Polynomial.X
    have ht_ne : t_bar ≠ 0 := by
      intro h0
      have h1 : φ_R_Ω t_bar = 0 := by rw [h0, map_zero]
      have h2 : φ_R_Ω t_bar = algebraMap P Ω Polynomial.X :=
        RingHom.congr_fun hφ_comp Polynomial.X
      rw [h2] at h1
      exact Polynomial.X_ne_zero (hinj_P_Ω (h1.trans (map_zero _).symm))
    have hRes : (IsLocalRing.residue R_bar).comp (algebraMap P R_bar) =
        (((IsLocalRing.residue R_bar).comp (algebraMap P R_bar)).comp Polynomial.C).comp
          (Polynomial.evalRingHom 0) := by
      apply Polynomial.ringHom_ext'
      · ext c; simp
      · change IsLocalRing.residue R_bar t_bar =
          (IsLocalRing.residue R_bar)
            (algebraMap P R_bar (Polynomial.C ((Polynomial.evalRingHom 0) Polynomial.X)))
        have hevX : (Polynomial.evalRingHom (0 : k)) Polynomial.X = 0 := Polynomial.eval_X
        rw [hevX, map_zero, map_zero]
        exact (Ideal.Quotient.eq_zero_iff_mem).mpr ht_max
    have hSumDegLt : ∀ {R₀ : Type u} [CommRing R₀] (m : ℕ) (f_c : Fin m → R₀),
        (∑ i : Fin m, Polynomial.C (f_c i) * Polynomial.X ^ i.1).degree < (m : WithBot ℕ) := by
      intro R₀ _ m f_c
      exact Finset.sum_induction _ (fun q_p : Polynomial R₀ => q_p.degree < (m : WithBot ℕ))
        (fun a b ha hb => (Polynomial.degree_add_le a b).trans_lt (max_lt ha hb))
        (WithBot.bot_lt_coe m)
        (fun i _ => (Polynomial.degree_C_mul_X_pow_le i.1 (f_c i)).trans_lt
          (WithBot.coe_lt_coe.mpr i.2))
    have hMonicSplits : ∀ (F : Polynomial R_bar), F.Monic →
        ∃ M_R : Multiset R_bar,
          M_R.card = F.natDegree ∧
          F = (M_R.map (fun r => Polynomial.X - Polynomial.C r)).prod := by
      intro F hF
      let n := F.natDegree
      let pair : Fin n → ↥B_bar × ↥M_max.primeCompl :=
        fun i => Classical.choose (IsLocalization.surj M_max.primeCompl (F.coeff i.1))
      have hpair : ∀ i : Fin n,
          F.coeff i.1 * algebraMap ↥B_bar R_bar (pair i).2.1 =
            algebraMap ↥B_bar R_bar (pair i).1 :=
        fun i => Classical.choose_spec (IsLocalization.surj M_max.primeCompl (F.coeff i.1))
      let s : ↥M_max.primeCompl := ∏ i : Fin n, (pair i).2
      let t_rest : Fin n → ↥B_bar :=
        fun i => (∏ j ∈ Finset.univ.erase i, (pair j).2).1
      have hs_fac : ∀ i : Fin n, s.1 = (pair i).2.1 * t_rest i := by
        intro i
        have h1 : (pair i).2 * (∏ j ∈ Finset.univ.erase i, (pair j).2) = s :=
          Finset.mul_prod_erase Finset.univ (fun j => (pair j).2) (Finset.mem_univ i)
        exact congrArg Subtype.val h1.symm
      let c_coeff : Fin n → ↥B_bar :=
        fun i => (pair i).1 * t_rest i * s.1 ^ (n - 1 - i.1)
      have hc_eq : ∀ i : Fin n,
          F.coeff i.1 * (algebraMap ↥B_bar R_bar s.1) ^ (n - i.1) =
            algebraMap ↥B_bar R_bar (c_coeff i) := by
        intro i
        have hsub : n - i.1 = 1 + (n - 1 - i.1) := by omega
        rw [hsub, pow_add, pow_one, ← mul_assoc]
        conv_lhs => rw [hs_fac i]
        rw [map_mul, ← mul_assoc, hpair i]
        dsimp [c_coeff]
        rw [hs_fac i]
        simp only [map_mul, map_pow]
      let q_low : Polynomial ↥B_bar :=
        ∑ i : Fin n, Polynomial.C (c_coeff i) * Polynomial.X ^ i.1
      let G : Polynomial ↥B_bar := Polynomial.X ^ n + q_low
      have hG_monic : G.Monic := Polynomial.monic_X_pow_add (hSumDegLt n c_coeff)
      have hF_sum : F = Polynomial.X ^ n +
          ∑ i : Fin n, Polynomial.C (F.coeff i.1) * Polynomial.X ^ i.1 := by
        conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow F]
        rw [Finset.sum_range_succ, add_comm]
        have hlc : F.coeff n = 1 := hF.coeff_natDegree
        dsimp [n] at hlc ⊢
        rw [hlc, map_one, one_mul,
          ← Fin.sum_univ_eq_sum_range (fun m => Polynomial.C (F.coeff m) * Polynomial.X ^ m) n]
      let F_Ω : Polynomial Ω := F.map φ_R_Ω
      have hFΩ_monic : F_Ω.Monic := hF.map φ_R_Ω
      obtain ⟨M_Ω, hM_Ω0⟩ := (Polynomial.splits_iff_exists_multiset).mp (IsAlgClosed.splits F_Ω)
      rw [hFΩ_monic.leadingCoeff, map_one, one_mul] at hM_Ω0
      have hMΩ_card : M_Ω.card = n := by
        have hd := congrArg Polynomial.natDegree hM_Ω0
        rw [Polynomial.natDegree_multiset_prod_X_sub_C_eq_card] at hd
        dsimp [F_Ω, n] at hd ⊢
        rw [hF.natDegree_map φ_R_Ω] at hd
        exact hd.symm
      have hRootInt : ∀ α ∈ M_Ω, s.1.1 * α ∈ B_bar := by
        intro α hα
        have hev0 : Polynomial.eval α F_Ω = 0 := by
          rw [hM_Ω0, Polynomial.eval_multiset_prod, Multiset.map_map]
          apply Multiset.prod_eq_zero
          rw [Multiset.mem_map]
          exact ⟨α, hα, by simp⟩
        have hevF : α ^ n + ∑ i : Fin n, φ_R_Ω (F.coeff i.1) * α ^ i.1 = 0 := by
          have hmapF : F_Ω = Polynomial.X ^ n +
              ∑ i : Fin n, Polynomial.C (φ_R_Ω (F.coeff i.1)) * Polynomial.X ^ i.1 := by
            dsimp [F_Ω]
            conv_lhs => rw [hF_sum]
            simp [Polynomial.map_sum]
          rw [hmapF] at hev0
          simpa [Polynomial.eval_finsetSum] using hev0
        have hG_eval : Polynomial.aeval (s.1.1 * α) G = 0 := by
          dsimp [G, q_low]
          rw [map_add, map_pow, Polynomial.aeval_X, map_sum]
          have hterm : ∀ i : Fin n,
              (Polynomial.aeval (s.1.1 * α)) (Polynomial.C (c_coeff i) * Polynomial.X ^ i.1) =
                (s.1.1) ^ n * (φ_R_Ω (F.coeff i.1) * α ^ i.1) := by
            intro i
            rw [map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
            have hci : (algebraMap ↥B_bar Ω) (c_coeff i) =
                φ_R_Ω (F.coeff i.1) * (s.1.1) ^ (n - i.1) := by
              change (c_coeff i).1 = _
              rw [← hφ_B (c_coeff i), ← hc_eq i, map_mul, map_pow, hφ_B]
            rw [hci]
            have hpow : (s.1.1) ^ (n - i.1) * (s.1.1 * α) ^ i.1 =
                (s.1.1) ^ n * α ^ i.1 := by
              rw [mul_pow, ← mul_assoc, ← pow_add, Nat.sub_add_cancel (le_of_lt i.2)]
            calc
              φ_R_Ω (F.coeff i.1) * (s.1.1) ^ (n - i.1) * (s.1.1 * α) ^ i.1 =
                  φ_R_Ω (F.coeff i.1) * ((s.1.1) ^ (n - i.1) * (s.1.1 * α) ^ i.1) := by ring
              _ = φ_R_Ω (F.coeff i.1) * ((s.1.1) ^ n * α ^ i.1) := by rw [hpow]
              _ = (s.1.1) ^ n * (φ_R_Ω (F.coeff i.1) * α ^ i.1) := by ring
          simp_rw [hterm, ← Finset.mul_sum, mul_pow]
          calc
            (s.1.1) ^ n * α ^ n + (s.1.1) ^ n * ∑ i : Fin n, φ_R_Ω (F.coeff i.1) * α ^ i.1 =
                (s.1.1) ^ n * (α ^ n + ∑ i : Fin n, φ_R_Ω (F.coeff i.1) * α ^ i.1) := by ring
            _ = 0 := by rw [hevF, mul_zero]
        have hIntB : IsIntegral ↥B_bar (s.1.1 * α) := ⟨G, hG_monic, hG_eval⟩
        exact isIntegral_trans (R := P) (A := ↥B_bar) (B := Ω) (s.1.1 * α) hIntB
      let liftRoot : Ω → R_bar := fun α =>
        if hα : α ∈ M_Ω then IsLocalization.mk' R_bar ⟨s.1.1 * α, hRootInt α hα⟩ s else 0
      have hlift_val : ∀ α ∈ M_Ω, φ_R_Ω (liftRoot α) = α := by
        intro α hα
        have hd : liftRoot α = IsLocalization.mk' R_bar ⟨s.1.1 * α, hRootInt α hα⟩ s := by
          simp [liftRoot, hα]
        have hs_ne : s.1.1 ≠ 0 := (hB_units s).ne_zero
        apply mul_left_cancel₀ hs_ne
        calc
          s.1.1 * φ_R_Ω (liftRoot α) =
              φ_R_Ω (algebraMap ↥B_bar R_bar s.1 * liftRoot α) := by rw [map_mul, hφ_B]
          _ = φ_R_Ω (algebraMap ↥B_bar R_bar ⟨s.1.1 * α, hRootInt α hα⟩) := by
              rw [hd, mul_comm, IsLocalization.mk'_spec]
          _ = s.1.1 * α := hφ_B _
      let M_R : Multiset R_bar := M_Ω.map liftRoot
      refine ⟨M_R, ?_, ?_⟩
      · dsimp [M_R]; rw [Multiset.card_map, hMΩ_card]
      · apply Polynomial.map_injective φ_R_Ω hφ_inj
        change F_Ω = ((M_R.map (fun r => Polynomial.X - Polynomial.C r)).prod).map φ_R_Ω
        rw [hM_Ω0, Polynomial.map_multiset_prod]
        dsimp [M_R]
        rw [Multiset.map_map, Multiset.map_map]
        congr 1
        refine Multiset.map_congr rfl fun α hα => ?_
        simp [hlift_val α hα]
    have hAlgClosedRes : IsAlgClosed (IsLocalRing.ResidueField R_bar) := by
      apply IsAlgClosed.of_exists_root
      intro p hp_mon hp_irr
      let n := p.natDegree
      have hn_pos : 1 ≤ n := Irreducible.natDegree_pos hp_irr
      let lift_c : Fin n → R_bar :=
        fun i => Classical.choose (IsLocalRing.residue_surjective (p.coeff i.1))
      have hlift_c : ∀ i : Fin n, IsLocalRing.residue R_bar (lift_c i) = p.coeff i.1 :=
        fun i => Classical.choose_spec (IsLocalRing.residue_surjective (p.coeff i.1))
      let q_low : Polynomial R_bar :=
        ∑ i : Fin n, Polynomial.C (lift_c i) * Polynomial.X ^ i.1
      let F : Polynomial R_bar := Polynomial.X ^ n + q_low
      have hF_mon : F.Monic := Polynomial.monic_X_pow_add (hSumDegLt n lift_c)
      have hF_deg : F.natDegree = n := by
        dsimp [F]
        apply Polynomial.natDegree_eq_of_degree_eq_some
        rw [Polynomial.degree_add_eq_left_of_degree_lt]
        · exact Polynomial.degree_X_pow n
        · rw [Polynomial.degree_X_pow]; exact hSumDegLt n lift_c
      have hF_map : F.map (IsLocalRing.residue R_bar) = p := by
        conv_rhs => rw [Polynomial.as_sum_range_C_mul_X_pow p]
        rw [Finset.sum_range_succ, add_comm]
        have hlc : p.coeff n = 1 := hp_mon.coeff_natDegree
        dsimp [n] at hlc ⊢
        rw [hlc, map_one, one_mul,
          ← Fin.sum_univ_eq_sum_range (fun m => Polynomial.C (p.coeff m) * Polynomial.X ^ m) n]
        dsimp [F, q_low]
        simp [Polynomial.map_sum, hlift_c]
        rfl
      obtain ⟨M_R, hMR_card, hF_prod⟩ := hMonicSplits F hF_mon
      have hMR_ne : M_R ≠ 0 := by
        intro h0; rw [h0, Multiset.card_zero, hF_deg] at hMR_card; omega
      obtain ⟨r₀, hr₀⟩ := Multiset.exists_mem_of_ne_zero hMR_ne
      have hFr₀ : Polynomial.eval r₀ F = 0 := by
        rw [hF_prod, Polynomial.eval_multiset_prod, Multiset.map_map]
        apply Multiset.prod_eq_zero
        rw [Multiset.mem_map]; exact ⟨r₀, hr₀, by simp⟩
      refine ⟨IsLocalRing.residue R_bar r₀, ?_⟩
      rw [← hF_map, Polynomial.eval_map, Polynomial.eval₂_at_apply, hFr₀, map_zero]
    have hHensel : HenselianLocalRing R_bar := by
      apply HenselianLocalRing.mk
      intro f hf_mon a₀ ha₀ _
      obtain ⟨M_R, _, hf_prod⟩ := hMonicSplits f hf_mon
      have hprod_mem : (M_R.map (fun r => a₀ - r)).prod ∈ IsLocalRing.maximalIdeal R_bar := by
        have hev : Polynomial.eval a₀ f = (M_R.map (fun r => a₀ - r)).prod := by
          rw [hf_prod, Polynomial.eval_multiset_prod, Multiset.map_map]
          congr 1; ext r; simp
        rwa [← hev]
      have hPrimeMax : (IsLocalRing.maximalIdeal R_bar).IsPrime := inferInstance
      obtain ⟨d, hd_mem, hd_max⟩ :=
        (hPrimeMax.multiset_prod_mem_iff_exists_mem _).mp hprod_mem
      obtain ⟨r, hr_mem, rfl⟩ := Multiset.mem_map.mp hd_mem
      refine ⟨r, ?_, ?_⟩
      · rw [Polynomial.IsRoot.def, hf_prod, Polynomial.eval_multiset_prod, Multiset.map_map]
        apply Multiset.prod_eq_zero
        rw [Multiset.mem_map]; exact ⟨r, hr_mem, by simp⟩
      · have hneg : r - a₀ = -(a₀ - r) := by ring
        rw [hneg]
        exact (IsLocalRing.maximalIdeal R_bar).neg_mem hd_max
    have hFactorX : ∀ (d : ℕ) (g : P), g.natDegree ≤ d → g ≠ 0 →
        ∃ (r : ℕ) (h : P), g = Polynomial.X ^ r * h ∧ Polynomial.eval 0 h ≠ 0 := by
      intro d
      induction d with
      | zero =>
        intro g hdeg hg_ne
        refine ⟨0, g, by simp, ?_⟩
        rw [Polynomial.eq_C_of_natDegree_eq_zero (Nat.eq_zero_of_le_zero hdeg)] at hg_ne ⊢
        rw [Polynomial.eval_C]
        intro hc0; exact hg_ne (by rw [hc0, map_zero])
      | succ d ih =>
        intro g hdeg hg_ne
        by_cases hg0 : Polynomial.eval 0 g = 0
        · have hdvd : Polynomial.X ∣ g := by
            have h1 : Polynomial.X - Polynomial.C 0 ∣ g := Polynomial.dvd_iff_isRoot.mpr hg0
            simpa using h1
          rcases hdvd with ⟨g₁, rfl⟩
          have hg₁_ne : g₁ ≠ 0 := right_ne_zero_of_mul hg_ne
          have hdeg_mul : (Polynomial.X * g₁).natDegree = 1 + g₁.natDegree := by
            rw [Polynomial.natDegree_mul Polynomial.X_ne_zero hg₁_ne, Polynomial.natDegree_X]
          obtain ⟨r₁, h, rfl, hh0⟩ := ih g₁ (by omega) hg₁_ne
          exact ⟨r₁ + 1, h, by rw [pow_succ', mul_assoc], hh0⟩
        · exact ⟨0, g, by simp, hg0⟩
    have hLocAway : @IsLocalization.Away R_bar _ t_bar Ω _ φ_R_Ω.toAlgebra := by
      let _ : Algebra R_bar Ω := φ_R_Ω.toAlgebra
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · rintro ⟨_, n, rfl⟩
        apply Ne.isUnit
        change φ_R_Ω (t_bar ^ n) ≠ 0
        rw [map_pow]
        refine pow_ne_zero n fun h0 => ht_ne (hφ_inj (h0.trans (map_zero _).symm))
      · intro z
        have hz_int : IsIntegral K₀ z := Algebra.IsIntegral.isIntegral z
        let Q : Polynomial K₀ := minpoly K₀ z
        have hQ_mon : Q.Monic := minpoly.monic hz_int
        let m := Q.natDegree
        let pairK : Fin m → P × ↥(nonZeroDivisors P) :=
          fun i => Classical.choose (IsLocalization.surj (nonZeroDivisors P) (Q.coeff i.1))
        have hpairK : ∀ i : Fin m,
            Q.coeff i.1 * algebraMap P K₀ (pairK i).2.1 = algebraMap P K₀ (pairK i).1 :=
          fun i => Classical.choose_spec (IsLocalization.surj (nonZeroDivisors P) (Q.coeff i.1))
        let g_sub : ↥(nonZeroDivisors P) := ∏ i : Fin m, (pairK i).2
        let g : P := g_sub.1
        have hg_ne : g ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp g_sub.2
        let restK : Fin m → P := fun i => (∏ j ∈ Finset.univ.erase i, (pairK j).2).1
        have hg_fac : ∀ i : Fin m, g = (pairK i).2.1 * restK i := by
          intro i
          have h1 : (pairK i).2 * (∏ j ∈ Finset.univ.erase i, (pairK j).2) = g_sub :=
            Finset.mul_prod_erase Finset.univ (fun j => (pairK j).2) (Finset.mem_univ i)
          exact congrArg Subtype.val h1.symm
        let a_P : Fin m → P := fun i => (pairK i).1 * restK i * g ^ (m - 1 - i.1)
        have ha_eq : ∀ i : Fin m,
            Q.coeff i.1 * (algebraMap P K₀ g) ^ (m - i.1) = algebraMap P K₀ (a_P i) := by
          intro i
          have hsub : m - i.1 = 1 + (m - 1 - i.1) := by omega
          rw [hsub, pow_add, pow_one, ← mul_assoc]
          conv_lhs => rw [hg_fac i]
          rw [map_mul, ← mul_assoc, hpairK i]
          dsimp [a_P]; rw [hg_fac i]; simp only [map_mul, map_pow]
        let G_P : Polynomial P :=
          Polynomial.X ^ m + ∑ i : Fin m, Polynomial.C (a_P i) * Polynomial.X ^ i.1
        have hGP_mon : G_P.Monic := Polynomial.monic_X_pow_add (hSumDegLt m a_P)
        have hQ_sum : Q = Polynomial.X ^ m +
            ∑ i : Fin m, Polynomial.C (Q.coeff i.1) * Polynomial.X ^ i.1 := by
          conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow Q]
          rw [Finset.sum_range_succ, add_comm]
          have hlc : Q.coeff m = 1 := hQ_mon.coeff_natDegree
          dsimp [m] at hlc ⊢
          rw [hlc, map_one, one_mul,
            ← Fin.sum_univ_eq_sum_range (fun j => Polynomial.C (Q.coeff j) * Polynomial.X ^ j) m]
        have hQz : z ^ m + ∑ i : Fin m, algebraMap K₀ Ω (Q.coeff i.1) * z ^ i.1 = 0 := by
          have h0 : Polynomial.aeval z Q = 0 := minpoly.aeval K₀ z
          conv_lhs at h0 => rw [hQ_sum]
          simpa [map_sum] using h0
        let w : Ω := algebraMap P Ω g * z
        have hw_mem : w ∈ B_bar := by
          refine ⟨G_P, hGP_mon, ?_⟩
          rw [← Polynomial.aeval_def]; dsimp [G_P]
          rw [map_add, map_pow, Polynomial.aeval_X, map_sum]
          have hterm : ∀ i : Fin m,
              (Polynomial.aeval w) (Polynomial.C (a_P i) * Polynomial.X ^ i.1) =
                (algebraMap P Ω g) ^ m * (algebraMap K₀ Ω (Q.coeff i.1) * z ^ i.1) := by
            intro i
            rw [map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
            have hai : algebraMap P Ω (a_P i) =
                algebraMap K₀ Ω (Q.coeff i.1) * (algebraMap P Ω g) ^ (m - i.1) := by
              rw [IsScalarTower.algebraMap_apply P K₀ Ω (a_P i), ← ha_eq i, map_mul, map_pow,
                ← IsScalarTower.algebraMap_apply P K₀ Ω g]
            rw [hai]; dsimp [w]
            have hpow : (algebraMap P Ω g) ^ (m - i.1) * (algebraMap P Ω g * z) ^ i.1 =
                (algebraMap P Ω g) ^ m * z ^ i.1 := by
              rw [mul_pow, ← mul_assoc, ← pow_add, Nat.sub_add_cancel (le_of_lt i.2)]
            calc
              algebraMap K₀ Ω (Q.coeff i.1) * (algebraMap P Ω g) ^ (m - i.1) *
                  (algebraMap P Ω g * z) ^ i.1 =
                algebraMap K₀ Ω (Q.coeff i.1) *
                  ((algebraMap P Ω g) ^ (m - i.1) * (algebraMap P Ω g * z) ^ i.1) := by ring
              _ = algebraMap K₀ Ω (Q.coeff i.1) * ((algebraMap P Ω g) ^ m * z ^ i.1) := by rw [hpow]
              _ = (algebraMap P Ω g) ^ m * (algebraMap K₀ Ω (Q.coeff i.1) * z ^ i.1) := by ring
          simp_rw [hterm, ← Finset.mul_sum]; dsimp [w]; rw [mul_pow]
          calc
            (algebraMap P Ω g) ^ m * z ^ m +
                (algebraMap P Ω g) ^ m * ∑ i : Fin m, algebraMap K₀ Ω (Q.coeff i.1) * z ^ i.1 =
              (algebraMap P Ω g) ^ m *
                (z ^ m + ∑ i : Fin m, algebraMap K₀ Ω (Q.coeff i.1) * z ^ i.1) := by ring
            _ = 0 := by rw [hQz, mul_zero]
        obtain ⟨r, h, hg_eq, hh0⟩ := hFactorX g.natDegree g (le_refl _) hg_ne
        have hh_not_M : algebraMap P ↥B_bar h ∉ M_max := by
          intro hhM
          have hh_comap : h ∈ M_max.comap (algebraMap P ↥B_bar) := hhM
          rw [hM, ← hm0_ker, RingHom.mem_ker] at hh_comap
          exact hh0 hh_comap
        let s_h : ↥M_max.primeCompl := ⟨algebraMap P ↥B_bar h, hh_not_M⟩
        let x_R : R_bar := IsLocalization.mk' R_bar ⟨w, hw_mem⟩ s_h
        refine ⟨(x_R, ⟨t_bar ^ r, r, rfl⟩), ?_⟩
        change z * φ_R_Ω (t_bar ^ r) = φ_R_Ω x_R
        have hh_Ω_ne : algebraMap P Ω h ≠ 0 := by
          intro h0
          have hh_zero : h = 0 := hinj_P_Ω (h0.trans (map_zero _).symm)
          rw [hh_zero, Polynomial.eval_zero] at hh0; exact hh0 rfl
        apply mul_right_cancel₀ hh_Ω_ne
        have hxR_mul : φ_R_Ω x_R * algebraMap P Ω h = w := by
          have h1 : x_R * algebraMap ↥B_bar R_bar s_h.1 = algebraMap ↥B_bar R_bar ⟨w, hw_mem⟩ :=
            IsLocalization.mk'_spec R_bar ⟨w, hw_mem⟩ s_h
          have h2 := congrArg φ_R_Ω h1
          rwa [map_mul, hφ_B, hφ_B] at h2
        have ht_Ω : φ_R_Ω (t_bar ^ r) = (algebraMap P Ω Polynomial.X) ^ r := by
          rw [map_pow]; congr 1; exact RingHom.congr_fun hφ_comp Polynomial.X
        rw [hxR_mul, ht_Ω]; dsimp [w]; rw [hg_eq, map_mul, map_pow]; ring
      · intro x y hxy
        exact ⟨⟨1, 0, pow_zero t_bar⟩, by simp [hφ_inj hxy]⟩
    let j_Rbar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
    have hj_open : AlgebraicGeometry.IsOpenImmersion j_Rbar := by
      let _ : Algebra R_bar Ω := φ_R_Ω.toAlgebra
      have _ : IsLocalization.Away t_bar Ω := hLocAway
      exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization t_bar
    have hj_eq : j_Rbar ≫ g_Rbar = η := by
      dsimp [j_Rbar, g_Rbar, η]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hφ_comp]
    have hj_range : Set.range j_Rbar.base = (PrimeSpectrum.basicOpen t_bar).1 := by
      let _ : Algebra R_bar Ω := φ_R_Ω.toAlgebra
      have _ : IsLocalization.Away t_bar Ω := hLocAway
      exact PrimeSpectrum.localization_away_comap_range Ω t_bar
    have hClosed : g_Rbar.base (IsLocalRing.closedPoint R_bar) = s₀.base (⊥ : PrimeSpectrum k) := by
      apply PrimeSpectrum.ext
      change Ideal.comap (algebraMap P R_bar) (IsLocalRing.maximalIdeal R_bar) =
        Ideal.comap ev0 ⊥
      have hunder_B : Ideal.comap (algebraMap ↥B_bar R_bar) (IsLocalRing.maximalIdeal R_bar) = M_max :=
        IsLocalization.AtPrime.under_maximalIdeal R_bar M_max
      rw [IsScalarTower.algebraMap_eq P ↥B_bar R_bar, ← Ideal.comap_comap, hunder_B, hM, ← hm0_ker]
      rfl
    have hDichot : ∀ p : ↥(AlgebraicGeometry.Spec (CommRingCat.of R_bar)),
        p ∈ (PrimeSpectrum.basicOpen t_bar).1 ∨ p = IsLocalRing.closedPoint R_bar := by
      intro p
      have _ : p.asIdeal.IsPrime := p.isPrime
      let q_B : Ideal ↥B_bar := p.asIdeal.comap (algebraMap ↥B_bar R_bar)
      have _ : q_B.IsPrime := Ideal.IsPrime.comap _
      have hq_le_M : q_B ≤ M_max := by
        intro x hx
        by_contra hxM
        have hunit : IsUnit (algebraMap ↥B_bar R_bar x) :=
          IsLocalization.map_units R_bar (⟨x, hxM⟩ : M_max.primeCompl)
        exact p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem p.asIdeal hx hunit)
      by_cases hq_bot : q_B = ⊥
      · left
        change t_bar ∉ p.asIdeal
        intro hX_mem
        have hXB_mem : algebraMap P ↥B_bar Polynomial.X ∈ q_B := by
          change algebraMap ↥B_bar R_bar (algebraMap P ↥B_bar Polynomial.X) ∈ p.asIdeal
          rwa [← IsScalarTower.algebraMap_apply P ↥B_bar R_bar]
        rw [hq_bot, Ideal.mem_bot] at hXB_mem
        exact Polynomial.X_ne_zero (hinj_P_B (hXB_mem.trans (map_zero _).symm))
      · right
        have _ : IsDomain ↥B_bar := inferInstance
        have hqP_ne : q_B.under P ≠ ⊥ := Ideal.IsIntegral.under_ne_bot P hq_bot
        have hqP_max : (q_B.under P).IsMaximal := IsPrime.to_maximal_ideal hqP_ne
        have hq_max : q_B.IsMaximal := Ideal.IsIntegral.isMaximal_of_isMaximal_under q_B hqP_max
        have hMax_M : M_max.IsMaximal := inferInstance
        have hq_eq : q_B = M_max := hq_max.eq_of_le hMax_M.ne_top hq_le_M
        apply PrimeSpectrum.ext; symm
        apply (IsLocalRing.maximalIdeal.isMaximal R_bar).eq_of_le p.isPrime.ne_top
        intro r hr
        obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj M_max.primeCompl r
        have hbs' : r * algebraMap ↥B_bar R_bar s = algebraMap ↥B_bar R_bar b := hbs
        have hs_unit : IsUnit (algebraMap ↥B_bar R_bar s) := IsLocalization.map_units R_bar s
        have hb_not_unit : ¬ IsUnit (algebraMap ↥B_bar R_bar b) := by
          intro hbu
          have hru : IsUnit r := by
            obtain ⟨u_s, hu_s⟩ := hs_unit; obtain ⟨u_b, hu_b⟩ := hbu
            refine ⟨u_b * u_s⁻¹, ?_⟩
            apply mul_right_cancel₀ u_s.ne_zero
            calc (u_b * u_s⁻¹ : R_barˣ) * (u_s : R_barˣ) = (u_b : R_bar) := by simp
              _ = r * (u_s : R_bar) := by rw [hu_b, hu_s, hbs']
          exact (IsLocalRing.mem_maximalIdeal r).mp hr hru
        have hb_M : b ∈ M_max := by
          by_contra hbM
          exact hb_not_unit (IsLocalization.map_units R_bar (⟨b, hbM⟩ : M_max.primeCompl))
        have hb_p : algebraMap ↥B_bar R_bar b ∈ p.asIdeal := by change b ∈ q_B; rwa [hq_eq]
        obtain ⟨u_s, hu_s⟩ := hs_unit
        have hr_eq : r = algebraMap ↥B_bar R_bar b * (↑u_s⁻¹ : R_bar) := by
          apply mul_right_cancel₀ u_s.ne_zero
          calc r * (u_s : R_bar) = algebraMap ↥B_bar R_bar b := by rw [hu_s, hbs']
            _ = algebraMap ↥B_bar R_bar b * (↑u_s⁻¹ : R_bar) * (u_s : R_bar) := by simp
        rw [hr_eq]; exact p.asIdeal.mul_mem_right _ hb_p
    exact ⟨⟨hDom_R, hHensel, hAlgClosedRes, j_Rbar, hj_open, hj_eq, hj_range, hClosed⟩,
      ht_ne, hRes, hDichot⟩

  
  
  have hStrictHenselAndTopSieve :
      (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsAlgClosed (IsLocalRing.ResidueField A)]
          (Z : AlgebraicGeometry.Scheme.{u})
          (e : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of A)) [AlgebraicGeometry.Etale e]
          (z₀ : ↥Z),
        e.base z₀ = IsLocalRing.closedPoint A →
        ∃ σ : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Z,
          σ ≫ e = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of A)) ∧
          σ.base (IsLocalRing.closedPoint A) = z₀) ∧
      (∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale),
        (∀ R ∈ S.smallEtaleTopology W, R = ⊤) →
        ∀ (P_sh_in : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}),
          CategoryTheory.IsIso
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
              AddCommGrpCat.{u}).unit.app P_sh_in).app (Opposite.op W))) := by
    clear * -
    constructor
    · intro A _ _ _ Z e _ z₀ hz₀
      obtain ⟨U_Z, hAffU, hzU, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z₀) (U := (⊤ : Z.Opens)) trivial
      let R_B : CommRingCat.{u} := Z.presheaf.obj (Opposite.op U_Z)
      let B : Type u := ↑R_B
      let p₀ : PrimeSpectrum B := hAffU.isoSpec.hom.base ⟨z₀, hzU⟩
      let j_U : Spec R_B ⟶ Z := hAffU.isoSpec.inv ≫ U_Z.ι
      have hj_U_pt : j_U.base p₀ = z₀ := by
        dsimp [j_U, p₀]
        have h1 : hAffU.isoSpec.inv.base (hAffU.isoSpec.hom.base ⟨z₀, hzU⟩) = ⟨z₀, hzU⟩ := by
          change (hAffU.isoSpec.hom ≫ hAffU.isoSpec.inv).base ⟨z₀, hzU⟩ = ⟨z₀, hzU⟩
          rw [hAffU.isoSpec.hom_inv_id]; rfl
        change U_Z.ι.base (hAffU.isoSpec.inv.base (hAffU.isoSpec.hom.base ⟨z₀, hzU⟩)) = z₀
        rw [h1]; rfl
      have _ : IsOpenImmersion j_U := by dsimp [j_U]; infer_instance
      have _ : Etale j_U := inferInstance
      let φ_AB : CommRingCat.of A ⟶ R_B := Spec.preimage (j_U ≫ e)
      have hSpec_φ : Spec.map φ_AB = j_U ≫ e := Spec.map_preimage (j_U ≫ e)
      have hEt_Spec : Etale (Spec.map φ_AB) := by rw [hSpec_φ]; infer_instance
      have hEt_hom : φ_AB.hom.Etale := (HasRingHomProperty.Spec_iff (P := @Etale)).mp hEt_Spec
      let _ : Algebra A B := φ_AB.hom.toAlgebra
      have _ : Algebra.Etale A B := RingHom.etale_algebraMap.mp hEt_hom
      have _ : p₀.asIdeal.IsPrime := p₀.isPrime
      have hp₀_A : p₀.asIdeal.comap (algebraMap A B) = IsLocalRing.maximalIdeal A := by
        have hpt : (Spec.map φ_AB).base p₀ = IsLocalRing.closedPoint A := by
          rw [hSpec_φ]
          change e.base (j_U.base p₀) = IsLocalRing.closedPoint A
          rw [hj_U_pt, hz₀]
        exact congrArg PrimeSpectrum.asIdeal hpt
      obtain ⟨f, hf_not_p₀, hStdEt⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := A) p₀.asIdeal
      let B_f := Localization.Away f
      let _ : Algebra.IsStandardEtale A B_f := hStdEt
      have hp₀_basic : p₀ ∈ (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum B)) := hf_not_p₀
      rw [← PrimeSpectrum.localization_away_comap_range B_f f] at hp₀_basic
      obtain ⟨q₀, hq₀_comap⟩ := hp₀_basic
      have _ : q₀.asIdeal.IsPrime := q₀.isPrime
      have hq₀_B : q₀.asIdeal.comap (algebraMap B B_f) = p₀.asIdeal :=
        congrArg PrimeSpectrum.asIdeal hq₀_comap
      have hq₀_A : q₀.asIdeal.comap (algebraMap A B_f) = IsLocalRing.maximalIdeal A := by
        rw [IsScalarTower.algebraMap_eq A B B_f, ← Ideal.comap_comap, hq₀_B, hp₀_A]
      obtain ⟨pres⟩ := Algebra.IsStandardEtale.nonempty_standardEtalePresentation (R := A) (S := B_f)
      let P_pair : StandardEtalePair A := pres.P
      let x_gen : B_f := pres.x
      have hx_map : P_pair.HasMap x_gen := pres.hasMap
      let equiv_B : B_f ≃ₐ[A] P_pair.Ring := pres.equivRing
      have hequiv_X : equiv_B.symm P_pair.X = x_gen := StandardEtalePair.lift_X P_pair x_gen hx_map
      let D₀ := B_f ⧸ q₀.asIdeal
      have _ : IsDomain D₀ := Ideal.Quotient.isDomain q₀.asIdeal
      let mk_q₀ : B_f →+* D₀ := Ideal.Quotient.mk q₀.asIdeal
      let κ_A := IsLocalRing.ResidueField A
      have hker_A_D₀ : ∀ a ∈ IsLocalRing.maximalIdeal A, (mk_q₀.comp (algebraMap A B_f)) a = 0 := by
        intro a ha
        rw [← hq₀_A, Ideal.mem_comap] at ha
        exact (Ideal.Quotient.eq_zero_iff_mem).mpr ha
      let ι_κ : κ_A →+* D₀ :=
        Ideal.Quotient.lift (IsLocalRing.maximalIdeal A) (mk_q₀.comp (algebraMap A B_f)) hker_A_D₀
      have hι_res : ι_κ.comp (IsLocalRing.residue A) = mk_q₀.comp (algebraMap A B_f) :=
        RingHom.ext fun _ => rfl
      have hι_inj : Function.Injective ι_κ := RingHom.injective ι_κ
      let p_κ : Polynomial κ_A := P_pair.f.map (IsLocalRing.residue A)
      have hpκ_mon : p_κ.Monic := P_pair.monic_f.map (IsLocalRing.residue A)
      obtain ⟨M_κ, hM_κ⟩ := (Polynomial.splits_iff_exists_multiset).mp (IsAlgClosed.splits p_κ)
      rw [hpκ_mon.leadingCoeff, map_one, one_mul] at hM_κ
      have hx_f0 : Polynomial.aeval x_gen P_pair.f = 0 := hx_map.1
      have hprod_D₀ : (M_κ.map (fun c => mk_q₀ x_gen - ι_κ c)).prod = 0 := by
        have hmap_D₀ : P_pair.f.map (mk_q₀.comp (algebraMap A B_f)) =
            (M_κ.map (fun c => Polynomial.X - Polynomial.C (ι_κ c))).prod := by
          calc P_pair.f.map (mk_q₀.comp (algebraMap A B_f))
              = P_pair.f.map (ι_κ.comp (IsLocalRing.residue A)) := by rw [hι_res]
            _ = p_κ.map ι_κ := (Polynomial.map_map _ _ _).symm
            _ = ((M_κ.map (fun c => Polynomial.X - Polynomial.C c)).prod).map ι_κ := by rw [hM_κ]
            _ = (M_κ.map (fun c => Polynomial.X - Polynomial.C (ι_κ c))).prod := by
                rw [Polynomial.map_multiset_prod, Multiset.map_map]
                congr 1; ext c; simp
        have hev0 : Polynomial.eval (mk_q₀ x_gen) (P_pair.f.map (mk_q₀.comp (algebraMap A B_f))) = 0 := by
          rw [Polynomial.eval_map, ← Polynomial.hom_eval₂, ← Polynomial.aeval_def, hx_f0, map_zero]
        rw [hmap_D₀, Polynomial.eval_multiset_prod, Multiset.map_map] at hev0
        simpa using hev0
      have h0_mem : (0 : D₀) ∈ M_κ.map (fun c => mk_q₀ x_gen - ι_κ c) := by
        have haux : ∀ (L : Multiset D₀), L.prod = 0 → (0 : D₀) ∈ L := by
          intro L
          induction L using Multiset.induction_on with
          | empty => simp
          | cons a s ih =>
            rw [Multiset.prod_cons, mul_eq_zero, Multiset.mem_cons]
            rintro (rfl | hs)
            · exact Or.inl rfl
            · exact Or.inr (ih hs)
        exact haux _ hprod_D₀
      obtain ⟨c₀, _, hc₀_eq⟩ := Multiset.mem_map.mp h0_mem
      have hx_bar_eq : mk_q₀ x_gen = ι_κ c₀ := sub_eq_zero.mp hc₀_eq
      obtain ⟨a₀, ha₀_res⟩ := IsLocalRing.residue_surjective c₀
      have hx_a₀_D₀ : mk_q₀ x_gen = mk_q₀ (algebraMap A B_f a₀) := by
        rw [hx_bar_eq, ← ha₀_res]; rfl
      have hEval_mod : ∀ Q : Polynomial A,
          mk_q₀ (algebraMap A B_f (Polynomial.eval a₀ Q)) = mk_q₀ (Polynomial.aeval x_gen Q) := by
        intro Q
        calc mk_q₀ (algebraMap A B_f (Polynomial.eval a₀ Q))
            = (mk_q₀.comp (algebraMap A B_f)) (Polynomial.eval₂ (RingHom.id A) a₀ Q) := rfl
          _ = Polynomial.eval₂ (mk_q₀.comp (algebraMap A B_f)) (mk_q₀ (algebraMap A B_f a₀)) Q := by
                rw [Polynomial.hom_eval₂, RingHom.comp_id]; rfl
          _ = Polynomial.eval₂ (mk_q₀.comp (algebraMap A B_f)) (mk_q₀ x_gen) Q := by rw [hx_a₀_D₀]
          _ = mk_q₀ (Polynomial.aeval x_gen Q) :=
                (Polynomial.hom_eval₂ Q (algebraMap A B_f) mk_q₀ x_gen).symm
      have hMemMax_iff : ∀ u : A, u ∈ IsLocalRing.maximalIdeal A ↔ mk_q₀ (algebraMap A B_f u) = 0 := by
        intro u
        rw [← hq₀_A, Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem]
      have hf_a₀ : Polynomial.eval a₀ P_pair.f ∈ IsLocalRing.maximalIdeal A := by
        rw [hMemMax_iff, hEval_mod, hx_f0, map_zero]
      have hdf_a₀ : IsUnit (Polynomial.eval a₀ (Polynomial.derivative P_pair.f)) := by
        rw [← IsLocalRing.notMem_maximalIdeal, hMemMax_iff, hEval_mod]
        exact ((StandardEtalePair.HasMap.isUnit_derivative_f P_pair hx_map).map mk_q₀).ne_zero
      obtain ⟨r, hr_root, hr_diff⟩ :=
        HenselianLocalRing.is_henselian P_pair.f P_pair.monic_f a₀ hf_a₀ hdf_a₀
      have hr_res : IsLocalRing.residue A r = c₀ := by
        rw [← ha₀_res, ← sub_eq_zero, ← map_sub]
        exact (IsLocalRing.residue_eq_zero_iff _).mpr hr_diff
      have hg_r : IsUnit (Polynomial.aeval r P_pair.g) := by
        change IsUnit (Polynomial.eval r P_pair.g)
        rw [← IsLocalRing.notMem_maximalIdeal]
        intro hmem
        have hres0 : IsLocalRing.residue A (Polynomial.eval a₀ P_pair.g) = 0 := by
          have h1 : IsLocalRing.residue A (Polynomial.eval r P_pair.g) = 0 :=
            (IsLocalRing.residue_eq_zero_iff _).mpr hmem
          have h2 : ∀ t : A, IsLocalRing.residue A (Polynomial.eval t P_pair.g) =
              Polynomial.eval₂ (IsLocalRing.residue A) (IsLocalRing.residue A t) P_pair.g :=
            fun t => Polynomial.hom_eval₂ P_pair.g (RingHom.id A) (IsLocalRing.residue A) t
          rw [h2 a₀, ha₀_res, ← hr_res, ← h2 r, h1]
        have ha₀_max : Polynomial.eval a₀ P_pair.g ∈ IsLocalRing.maximalIdeal A :=
          (IsLocalRing.residue_eq_zero_iff _).mp hres0
        rw [hMemMax_iff, hEval_mod] at ha₀_max
        exact (hx_map.2.map mk_q₀).ne_zero ha₀_max
      have hr_map : P_pair.HasMap r := ⟨hr_root, hg_r⟩
      let ψ_f : B_f →ₐ[A] A := (P_pair.lift r hr_map).comp equiv_B
      let _ : Algebra A D₀ := (mk_q₀.comp (algebraMap A B_f)).toAlgebra
      let mk_alg : B_f →ₐ[A] D₀ := { toRingHom := mk_q₀, commutes' := fun _ => rfl }
      let π_AD₀ : A →ₐ[A] D₀ :=
        { toRingHom := ι_κ.comp (IsLocalRing.residue A)
          commutes' := fun a => by change (ι_κ.comp (IsLocalRing.residue A)) a = _; rw [hι_res]; rfl }
      have hAlg_eq : mk_alg.comp equiv_B.symm.toAlgHom = π_AD₀.comp (P_pair.lift r hr_map) := by
        apply P_pair.homEquiv.injective
        apply Subtype.ext
        rw [StandardEtalePair.homEquiv_apply_coe, StandardEtalePair.homEquiv_apply_coe]
        change mk_q₀ (equiv_B.symm P_pair.X) =
          ι_κ (IsLocalRing.residue A ((P_pair.lift r hr_map) P_pair.X))
        rw [hequiv_X, StandardEtalePair.lift_X, hx_bar_eq, hr_res]
      have hψ_mod : ∀ y : B_f, mk_q₀ y = ι_κ (IsLocalRing.residue A (ψ_f y)) := by
        intro y
        have h1 := AlgHom.congr_fun hAlg_eq (equiv_B y)
        change mk_q₀ (equiv_B.symm (equiv_B y)) = ι_κ (IsLocalRing.residue A (ψ_f y)) at h1
        rwa [equiv_B.symm_apply_apply] at h1
      let ψ_B : R_B ⟶ CommRingCat.of A :=
        CommRingCat.ofHom (ψ_f.toRingHom.comp (algebraMap B B_f))
      have hφ_ψ : φ_AB ≫ ψ_B = 𝟙 (CommRingCat.of A) := by
        apply CommRingCat.hom_ext; ext a
        change ψ_f (algebraMap B B_f (algebraMap A B a)) = a
        rw [← IsScalarTower.algebraMap_apply A B B_f, ψ_f.commutes]; rfl
      have hψ_pt : (Spec.map ψ_B).base (IsLocalRing.closedPoint A) = p₀ := by
        apply PrimeSpectrum.ext
        change Ideal.comap (ψ_f.toRingHom.comp (algebraMap B B_f)) (IsLocalRing.maximalIdeal A) =
          p₀.asIdeal
        rw [← hq₀_B]; ext b
        change ψ_f (algebraMap B B_f b) ∈ IsLocalRing.maximalIdeal A ↔ algebraMap B B_f b ∈ q₀.asIdeal
        rw [← IsLocalRing.residue_eq_zero_iff, ← map_eq_zero_iff ι_κ hι_inj, ← hψ_mod]
        exact Ideal.Quotient.eq_zero_iff_mem
      refine ⟨Spec.map ψ_B ≫ j_U, ?_, ?_⟩
      · rw [Category.assoc, ← hSpec_φ, ← Spec.map_comp, hφ_ψ, Spec.map_id]
      · change j_U.base ((Spec.map ψ_B).base (IsLocalRing.closedPoint A)) = z₀
        rw [hψ_pt, hj_U_pt]
    · intro S W hTop P
      let J := S.smallEtaleTopology
      let F_D : AddCommGrpCat.{u} → ((Opposite S.Etale) ⥤ AddCommGrpCat.{u}) := fun D =>
        { obj := fun U => AddCommGrpCat.of ((W ⟶ U.unop) → ↥D)
          map := fun {U₁ U₂} g => AddCommGrpCat.ofHom
            { toFun := fun φ τ => φ (τ ≫ g.unop)
              map_zero' := rfl
              map_add' := fun _ _ => rfl }
          map_id := fun _ => AddCommGrpCat.ext fun φ => funext fun τ => congrArg φ (Category.comp_id τ)
          map_comp := fun f g => AddCommGrpCat.ext fun φ => funext fun τ =>
            congrArg φ (Category.assoc τ g.unop f.unop).symm }
      have hSh_FD : ∀ D : AddCommGrpCat.{u}, Presheaf.IsSheaf J (F_D D) := by
        intro D B V R hR x_fam hx_comp
        have hArrow : ∀ τ : W ⟶ V, R.arrows τ := by
          intro τ
          have hpb_top : R.pullback τ = ⊤ := hTop _ (J.pullback_stable τ hR)
          have hid_mem : (R.pullback τ).arrows (𝟙 W) := by rw [hpb_top]; trivial
          simpa [Category.id_comp] using hid_mem
        let amalg : B ⟶ (F_D D).obj (Opposite.op V) :=
          AddCommGrpCat.ofHom
            { toFun := fun b τ => ((x_fam τ (hArrow τ)).hom b) (𝟙 W)
              map_zero' := funext fun τ => by
                change ((x_fam τ (hArrow τ)).hom 0) (𝟙 W) = 0
                rw [map_zero]; rfl
              map_add' := fun b₁ b₂ => funext fun τ => by
                change ((x_fam τ (hArrow τ)).hom (b₁ + b₂)) (𝟙 W) = _
                rw [map_add]; rfl }
        refine ⟨amalg, fun Y f hf => ?_, fun m hm => ?_⟩
        · apply AddCommGrpCat.ext; intro b; funext τ
          have hc := hx_comp (𝟙 W) τ (hArrow (τ ≫ f)) hf (Category.id_comp (τ ≫ f))
          have hc_ev := congrArg (fun k : B ⟶ (F_D D).obj (Opposite.op W) => (k.hom b) (𝟙 W)) hc
          change ((x_fam (τ ≫ f) (hArrow (τ ≫ f))).hom b) (𝟙 W ≫ 𝟙 W) =
            ((x_fam f hf).hom b) (𝟙 W ≫ τ) at hc_ev
          rw [Category.id_comp, Category.id_comp] at hc_ev
          exact hc_ev
        · apply AddCommGrpCat.ext; intro b; funext τ
          have hm_τ := congrArg (fun k : B ⟶ (F_D D).obj (Opposite.op W) => (k.hom b) (𝟙 W))
            (hm τ (hArrow τ))
          change (m.hom b) (𝟙 W ≫ τ) = ((x_fam τ (hArrow τ)).hom b) (𝟙 W) at hm_τ
          rwa [Category.id_comp] at hm_τ
      let adj_sh := sheafificationAdjunction J AddCommGrpCat.{u}
      let P_sh : Sheaf J AddCommGrpCat.{u} := (presheafToSheaf J AddCommGrpCat.{u}).obj P
      let η_P : P ⟶ P_sh.obj := adj_sh.unit.app P
      let Back : ∀ (D : AddCommGrpCat.{u}), (P.obj (Opposite.op W) ⟶ D) → (P ⟶ F_D D) :=
        fun D h =>
          { app := fun U => AddCommGrpCat.ofHom
              { toFun := fun q τ => h.hom ((P.map τ.op).hom q)
                map_zero' := funext fun _ => by simp
                map_add' := fun _ _ => funext fun _ => by simp }
            naturality := fun {_ _} g => AddCommGrpCat.ext fun q => funext fun τ => by
              change h.hom ((P.map τ.op).hom ((P.map g).hom q)) =
                h.hom ((P.map (τ ≫ g.unop).op).hom q)
              rw [op_comp, P.map_comp]; rfl }
      let D₀ := P.obj (Opposite.op W)
      let S₀ : Sheaf J AddCommGrpCat.{u} := ⟨F_D D₀, hSh_FD D₀⟩
      let β_id : P_sh ⟶ S₀ := (adj_sh.homEquiv P S₀).symm (Back D₀ (𝟙 D₀))
      have hβ_unit : η_P ≫ β_id.hom = Back D₀ (𝟙 D₀) :=
        (adj_sh.homEquiv P S₀).apply_symm_apply (Back D₀ (𝟙 D₀))
      let ev_id : (F_D D₀).obj (Opposite.op W) ⟶ D₀ :=
        AddCommGrpCat.ofHom { toFun := fun φ => φ (𝟙 W), map_zero' := rfl, map_add' := fun _ _ => rfl }
      let r_W : P_sh.obj.obj (Opposite.op W) ⟶ D₀ := β_id.hom.app (Opposite.op W) ≫ ev_id
      have h_hom_inv : η_P.app (Opposite.op W) ≫ r_W = 𝟙 D₀ := by
        apply AddCommGrpCat.ext; intro q
        have h1 := congrArg (fun α : P ⟶ F_D D₀ => (α.app (Opposite.op W)).hom q (𝟙 W)) hβ_unit
        change r_W.hom ((η_P.app (Opposite.op W)).hom q) = ((P.map (𝟙 W).op).hom q) at h1
        rwa [op_id, P.map_id] at h1
      let D₁ := P_sh.obj.obj (Opposite.op W)
      let S₁ : Sheaf J AddCommGrpCat.{u} := ⟨F_D D₁, hSh_FD D₁⟩
      let γ₁ : P_sh ⟶ S₁ :=
        ObjectProperty.homMk
          { app := fun U => AddCommGrpCat.ofHom
              { toFun := fun s τ => (P_sh.obj.map τ.op).hom s
                map_zero' := funext fun _ => by simp
                map_add' := fun _ _ => funext fun _ => by simp }
            naturality := fun {_ _} g => AddCommGrpCat.ext fun s => funext fun τ => by
              change (P_sh.obj.map τ.op).hom ((P_sh.obj.map g).hom s) =
                (P_sh.obj.map (τ ≫ g.unop).op).hom s
              rw [op_comp, P_sh.obj.map_comp]; rfl }
      let post_η : S₀ ⟶ S₁ :=
        ObjectProperty.homMk
          { app := fun _ => AddCommGrpCat.ofHom
              { toFun := fun φ τ => (η_P.app (Opposite.op W)).hom (φ τ)
                map_zero' := funext fun _ => map_zero _
                map_add' := fun φ₁ φ₂ => funext fun τ => map_add _ (φ₁ τ) (φ₂ τ) }
            naturality := fun {_ _} _ => rfl }
      let γ₂ : P_sh ⟶ S₁ := β_id ≫ post_η
      have hγ_eq : γ₁ = γ₂ := by
        apply (adj_sh.homEquiv P S₁).injective
        change η_P ≫ γ₁.hom = η_P ≫ (β_id.hom ≫ post_η.hom)
        rw [← Category.assoc, hβ_unit]
        apply NatTrans.ext; ext U : 1; apply AddCommGrpCat.ext; intro q; funext τ
        exact (congrArg (fun m => m.hom q) (η_P.naturality τ.op)).symm
      have h_inv_hom : r_W ≫ η_P.app (Opposite.op W) = 𝟙 D₁ := by
        apply AddCommGrpCat.ext; intro s
        have h1 := congrArg (fun γ : P_sh ⟶ S₁ => (γ.hom.app (Opposite.op W)).hom s (𝟙 W)) hγ_eq
        change (P_sh.obj.map (𝟙 W).op).hom s = (η_P.app (Opposite.op W)).hom (r_W.hom s) at h1
        rw [op_id, P_sh.obj.map_id] at h1
        exact h1.symm
      exact ⟨⟨r_W, h_hom_inv, h_inv_hom⟩⟩

  
  
  have hFlatLocConstEngine :
      ∀ (R₀ Ω₀ : Type u) [CommRing R₀] (_hDom₀ : IsDomain R₀) [Field Ω₀]
        (j₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R₀))
        [AlgebraicGeometry.IsOpenImmersion j₀]
        (_hBot_mem : (⊥ : PrimeSpectrum R₀) ∈ Set.range j₀.base)
        (A : AddCommGrpCat.{u})
        (_hCont_all : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
          letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
            CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
          letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
              (@AlgebraicGeometry.Etale) h :=
            CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
              (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
          let B_h : Y₂.Etale ⥤ Y₁.Etale :=
            CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
          B_h.IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology),
        letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
