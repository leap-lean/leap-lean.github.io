          rw [heq]
          change ι'_a.base (η.base (⊥ : PrimeSpectrum Ω)) = genericPoint ↥D_bar.left
          rw [hEta_bot, hChartGen ι'_a]
        obtain ⟨C_η, hPb_Cη, hZ_Cη⟩ := hGenZeroTransfer 𝒬_θ hZ_𝒬_η₀ (j_Rbar ≫ g_a) hj_ga_gen
        let k_R := CategoryTheory.Limits.kernel.ι (P_ga.map θ)
        let iso_ker_ga := CategoryTheory.Limits.PreservesKernel.iso P_ga θ
        let iso_cok_ga :=
          CategoryTheory.Limits.PreservesCokernel.iso P_ga (CategoryTheory.Limits.kernel.ι θ)
        have hk_R_fac : iso_ker_ga.inv ≫ P_ga.map (CategoryTheory.Limits.kernel.ι θ) = k_R :=
          CategoryTheory.Limits.PreservesKernel.iso_inv_ι P_ga θ
        have hk_R_fac' : P_ga.map (CategoryTheory.Limits.kernel.ι θ) = iso_ker_ga.hom ≫ k_R := by
          rw [← hk_R_fac, ← CategoryTheory.Category.assoc, iso_ker_ga.hom_inv_id,
            CategoryTheory.Category.id_comp]
        let cok_hom : CategoryTheory.Limits.cokernel (P_ga.map (CategoryTheory.Limits.kernel.ι θ)) ⟶
            CategoryTheory.Limits.cokernel k_R :=
          CategoryTheory.Limits.cokernel.desc _ (CategoryTheory.Limits.cokernel.π k_R)
            (by
