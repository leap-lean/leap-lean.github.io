    have hBij_cancel_left : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}}
        (h₁ : X₁ ⟶ X₂) (h₂ : X₂ ⟶ X₃) (i : ℕ),
        HasBijPull h₁ i → HasBijPull (h₁ ≫ h₂) i → HasBijPull h₂ i := by
      intro X₁ X₂ X₃ h₁ h₂ i hb₁ hb₁₂ p₂ hp₂
