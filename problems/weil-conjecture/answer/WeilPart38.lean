            (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology
            AddCommGrpCat.{u}).obj A₀) := by
        rw [← hz_tilde]
        exact (hPbComp z_tilde w_lc _ _ _).1 hPb_wlc (hPbConst z_tilde A₀)
      rcases hPb_Hz with ⟨hc₁, hr₁, ⟨iso₁⟩⟩
      rcases hPb_constK with ⟨hc₂, hr₂, ⟨iso₂⟩⟩
