            hPiK_compat e_PmR0.hom hPb_PmR0.isoPullback_hom_fst hPb_PmR0.isoPullback_hom_snd
          calc
            (j_Pi_K ≫ e_QK.hom) ≫ CategoryTheory.Limits.pullback.fst π_Q.left s_K ≫ ι_Q =
                j_Pi_K ≫ (e_QK.hom ≫ CategoryTheory.Limits.pullback.fst π_Q.left s_K) ≫ ι_Q := by
              simp only [CategoryTheory.Category.assoc]
            _ = j_Pi_K ≫ ψ_Qt ≫ ι_Q := by
              rw [hPb_Qt_fib.isoPullback_hom_fst]
            _ = (j_Pi_K ≫ ι_Qt) ≫ Φ_N := by
              simp only [hPb_Qt.w, CategoryTheory.Category.assoc]
            _ = ι_Pi_amb_K ≫ Φ_N := by
              rw [hBot_jPi]
            _ = (Φ_m ≫ e_PmR0.hom) ≫ ι_Pi ≫ ι_Q := by
              simp only [hPi_amb_eq, CategoryTheory.Category.assoc]
            _ = (e_PiK.hom ≫ CategoryTheory.Limits.pullback.fst f_Pi s_K) ≫ ι_Pi ≫ ι_Q := by
              rw [hPb_PiK.isoPullback_hom_fst]
            _ = e_PiK.hom ≫ (CategoryTheory.Limits.pullback.fst f_Pi s_K ≫ ι_Pi) ≫ ι_Q := by
              simp only [CategoryTheory.Category.assoc]
            _ = (e_PiK.hom ≫ h_Pi_K) ≫ CategoryTheory.Limits.pullback.fst π_Q.left s_K ≫ ι_Q := by
              rw [← hh_fst]
              simp only [CategoryTheory.Category.assoc]
        · calc
            (j_Pi_K ≫ e_QK.hom) ≫ CategoryTheory.Limits.pullback.snd π_Q.left s_K =
                j_Pi_K ≫ (e_QK.hom ≫ CategoryTheory.Limits.pullback.snd π_Q.left s_K) :=
              CategoryTheory.Category.assoc _ _ _
            _ = (j_Pi_K ≫ ι_Qt) ≫ (weilProjectiveSpaceOver K N).hom := by
              dsimp only [e_QK]
              simp only [hPb_Qt_fib.isoPullback_hom_snd, CategoryTheory.Category.assoc]
            _ = ι_Pi_amb_K ≫ (weilProjectiveSpaceOver K N).hom := by
              rw [hBot_jPi]
            _ = (weilProjectiveSpaceOver K m).hom := hPiK_hom
            _ = e_PiK.hom ≫ CategoryTheory.Limits.pullback.snd f_Pi s_K :=
              hPb_PiK.isoPullback_hom_snd.symm
            _ = (e_PiK.hom ≫ h_Pi_K) ≫ CategoryTheory.Limits.pullback.snd π_Q.left s_K := by
              rw [CategoryTheory.Category.assoc, hh_snd]

      obtain ⟨p_eQK, hp_eQK⟩ := hPullEx e_QK.hom ℓ i
      have hBij_eQK : Function.Bijective p_eQK := hIsoPullBij e_QK i p_eQK hp_eQK
      obtain ⟨p_ePiK_inv, hp_ePiK_inv⟩ := hPullEx e_PiK.inv ℓ i
      have hBij_ePiK_inv : Function.Bijective p_ePiK_inv :=
        hIsoPullBij e_PiK.symm i p_ePiK_inv hp_ePiK_inv
      obtain ⟨p_comp, hp_comp⟩ := hPullEx (j_Pi_K ≫ e_QK.hom) ℓ i
      have hp_comp_lhs : p_comp = p_jPi.comp p_eQK :=
        hPullComp j_Pi_K e_QK.hom ℓ i p_jPi p_eQK p_comp hp_jPi hp_eQK hp_comp
      have hBij_comp : Function.Bijective p_comp := by
        rw [hp_comp_lhs]
        exact hBij_jPi.comp hBij_eQK
      obtain ⟨p_ePiK, hp_ePiK⟩ := hPullEx e_PiK.hom ℓ i
      have hp_comp_rhs_pb : WeilIsTorsionEtalePullback (e_PiK.hom ≫ h_Pi_K) ℓ i p_comp := by
        rwa [← hComm_fib]
      have hp_comp_rhs : p_comp = p_ePiK.comp p_i :=
        hPullComp e_PiK.hom h_Pi_K ℓ i p_ePiK p_i p_comp hp_ePiK hp_i hp_comp_rhs_pb
      obtain ⟨p_id_Pi, hp_id_Pi⟩ := hPullEx
        (𝟙 (CategoryTheory.Limits.pullback f_Pi s_K)) ℓ i
      have hid_Pi : p_id_Pi = AddMonoidHom.id _ := hPullId ℓ i p_id_Pi hp_id_Pi
      have hp_inv_hom_pb : WeilIsTorsionEtalePullback (e_PiK.inv ≫ e_PiK.hom) ℓ i p_id_Pi := by
        rwa [e_PiK.inv_hom_id]
      have hp_inv_hom : p_ePiK_inv.comp p_ePiK = AddMonoidHom.id _ :=
        (hPullComp e_PiK.inv e_PiK.hom ℓ i p_ePiK_inv p_ePiK p_id_Pi
          hp_ePiK_inv hp_ePiK hp_inv_hom_pb).symm.trans hid_Pi
      have hp_i_eq : p_i = p_ePiK_inv.comp p_comp := by
        rw [hp_comp_rhs, ← AddMonoidHom.comp_assoc, hp_inv_hom, AddMonoidHom.id_comp]
      rw [hp_i_eq]
      exact hBij_ePiK_inv.comp hBij_comp

  exact ⟨Q_proj, π_Q, ι_W, o₀, ι_Pi, hCoord_Pmk.1, hProp_Q, hFlat_Q, hFlat_aff, hOpen_W,
    hι_W_hom, ho₀_π, ho₀_X, ho₀_CX, hSmoothCharts, hPi_hom, hGeomFiberCohom⟩

theorem weil_cosp_curve_henselian_open_const_and_etale_slice_bridge (R_bar : Type u) [CommRing R_bar] (hDom : IsDomain R_bar)
    [HenselianLocalRing R_bar] [IsAlgClosed (IsLocalRing.ResidueField R_bar)]
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (j_Rbar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R_bar))
    [AlgebraicGeometry.IsOpenImmersion j_Rbar]
    (hEt_j : AlgebraicGeometry.Etale j_Rbar) :
    let S_R := AlgebraicGeometry.Spec (CommRingCat.of R_bar)
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let U_Ω : S_R.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ j_Rbar hEt_j
    (∀ (K : Type u) [Field K] [IsAlgClosed K],
      let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
      (∀ (A : AddCommGrpCat.{u}),
        Nonempty ((((CategoryTheory.constantSheaf S_K.smallEtaleTopology AddCommGrpCat.{u}).obj A).H 0) ≃+ ↥A) ∧
        ∀ (T_K : S_K.Etale) (hT_K : CategoryTheory.Limits.IsTerminal T_K),
          Function.Bijective
            ((CategoryTheory.constantSheafAdj S_K.smallEtaleTopology AddCommGrpCat.{u} hT_K).unit.app A)) ∧
      (∀ (ℱ : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u}),
        Subsingleton (ℱ.H 0) → CategoryTheory.Limits.IsZero ℱ) ∧
      (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u}}
          (ψ : ℱ₁ ⟶ ℱ₂) (T_K : S_K.Etale) (hT_K : CategoryTheory.Limits.IsTerminal T_K),
        Function.Surjective (ψ.hom.app (Opposite.op T_K)) → CategoryTheory.Epi ψ)) ∧
    (∀ (T_R : S_R.Etale) (hT_R : CategoryTheory.Limits.IsTerminal T_R),
      (∀ (A : AddCommGrpCat.{u}),
        Function.Bijective
          (((CategoryTheory.constantSheaf S_R.smallEtaleTopology AddCommGrpCat.{u}).obj A).obj.map
            (Opposite.op (hT_R.from U_Ω)))) ∧
      (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf S_R.smallEtaleTopology AddCommGrpCat.{u}}
          (π : ℱ₁ ⟶ ℱ₂) [CategoryTheory.Epi π],
        Function.Surjective (π.hom.app (Opposite.op T_R)))) ∧
    (∀ (G_R : CategoryTheory.Sheaf S_R.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (G_Ω : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback j_Rbar G_R G_Ω →
        Nonempty (G_Ω.H 0 ≃+ ↥(G_R.obj.obj (Opposite.op U_Ω)))) ∧
      (∀ {F_R : CategoryTheory.Sheaf S_R.smallEtaleTopology AddCommGrpCat.{u}}
          (ψ : F_R ⟶ G_R),
        (Function.Injective (ψ.hom.app (Opposite.op U_Ω)) →
          ∀ (H_η : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}),
            WeilIsEtaleSheafPullback j_Rbar (CategoryTheory.Limits.kernel ψ) H_η →
            CategoryTheory.Limits.IsZero H_η) ∧
        (∀ (C_η : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback j_Rbar (CategoryTheory.Limits.cokernel ψ) C_η →
          CategoryTheory.Limits.IsZero C_η →
          Function.Surjective (ψ.hom.app (Opposite.op U_Ω))))) :=
by
  classical
  intro S_R S_Ω U_Ω

  
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
  let _ : P_et.IsMultiplicative :=
    inferInstanceAs (CategoryTheory.MorphismProperty.IsMultiplicative (@AlgebraicGeometry.Etale))
  let _ : P_et.IsStableUnderComposition := ‹P_et.IsMultiplicative›.toIsStableUnderComposition
  let _ : P_et.IsStableUnderBaseChange :=
    inferInstanceAs (CategoryTheory.MorphismProperty.IsStableUnderBaseChange (@AlgebraicGeometry.Etale))
  let _ : P_et.HasOfPostcompProperty P_et :=
    inferInstanceAs (CategoryTheory.MorphismProperty.HasOfPostcompProperty
      (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale))

  
  let termObj : ∀ X : AlgebraicGeometry.Scheme.{u}, X.Etale :=
    fun X => AlgebraicGeometry.Scheme.Etale.mk (𝟙 X)
  let isTermObj : ∀ X : AlgebraicGeometry.Scheme.{u}, CategoryTheory.Limits.IsTerminal (termObj X) :=
    fun X => CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun E => CategoryTheory.MorphismProperty.Over.homMk E.hom (CategoryTheory.Category.comp_id E.hom))
      (fun E m => (AlgebraicGeometry.Scheme.Etale.forget X).map_injective
        (CategoryTheory.Over.OverMorphism.ext
          ((CategoryTheory.Category.comp_id m.left).symm.trans m.w)))

  have addEquivOfIso : ∀ {M N : AddCommGrpCat.{u}} (e : M ≅ N), ↥M ≃+ ↥N := fun e =>
    { toFun := e.hom
      invFun := e.inv
      left_inv := fun m => by change (e.hom ≫ e.inv) m = m; rw [e.hom_inv_id]; rfl
      right_inv := fun n => by change (e.inv ≫ e.hom) n = n; rw [e.inv_hom_id]; rfl
      map_add' := map_add e.hom.hom }

  have etaleOfPostcomp : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z),
      AlgebraicGeometry.Etale g → AlgebraicGeometry.Etale (f ≫ g) → AlgebraicGeometry.Etale f :=
    fun f g hg hcomp => CategoryTheory.MorphismProperty.of_postcomp P_et (W' := P_et) f g hg hcomp

  have etaleOfHom : ∀ {X : AlgebraicGeometry.Scheme.{u}} {Y E : X.Etale} (f : Y ⟶ E),
      AlgebraicGeometry.Etale f.left := by
    intro X Y E f
    let f_l : Y.left ⟶ E.left := f.left
    have hw : f_l ≫ E.hom = Y.hom := CategoryTheory.MorphismProperty.Over.w f
    have hcomp : AlgebraicGeometry.Etale (f_l ≫ E.hom) := hw.symm ▸ Y.prop
    exact etaleOfPostcomp f_l E.hom E.prop hcomp

  have openMapOfHom : ∀ {X : AlgebraicGeometry.Scheme.{u}} {Y E : X.Etale} (f : Y ⟶ E),
      IsOpenMap f.left.base := by
    intro X Y E f
    let f_l : Y.left ⟶ E.left := f.left
    let _ : AlgebraicGeometry.Etale f_l := etaleOfHom f
    have _ : AlgebraicGeometry.UniversallyOpen f_l := AlgebraicGeometry.UniversallyOpen.of_flat f_l
    exact f_l.isOpenMap

  have memEtaleTop_iff : ∀ {X : AlgebraicGeometry.Scheme.{u}} {E : X.Etale} (S : CategoryTheory.Sieve E),
      S ∈ X.smallEtaleTopology E ↔
        ∀ x : ↥E.left, ∃ (Y : X.Etale) (f : Y ⟶ E),
          S.arrows f ∧ ∃ y : ↥Y.left, f.left.base y = x := by
    intro X E S
    have hEq : X.smallEtaleTopology = (X.smallPretopology P_et P_et).toGrothendieck :=
      X.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) le_rfl
    have hMem : S ∈ (X.smallPretopology P_et P_et).toGrothendieck E ↔
        ∀ (x : ↥E.left), ∃ Y f y, S.arrows f ∧ P_et f.left ∧ f.left.base y = x :=
      AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) E S
    refine (iff_of_eq (congrArg (fun J : CategoryTheory.GrothendieckTopology X.Etale => S ∈ J E) hEq)).trans
      (hMem.trans ⟨fun h x => ?_, fun h x => ?_⟩)
    · obtain ⟨Y, f, y, hfS, _, hy⟩ := h x
      exact ⟨Y, f, hfS, y, hy⟩
    · obtain ⟨Y, f, hfS, y, hy⟩ := h x
      exact ⟨Y, f, y, hfS, etaleOfHom f, hy⟩

  
  
  
  have hPillar1 : ∀ (X : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥X] [PreconnectedSpace ↥X]
      (A : AddCommGrpCat.{u}) (T_X : X.Etale) (hT_X : CategoryTheory.Limits.IsTerminal T_X),
      Function.Bijective
        ((CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u} hT_X).unit.app A) ∧
      ∀ (U : X.Etale) [Nonempty ↥U.left] [PreconnectedSpace ↥U.left],
        Function.Bijective
          (((CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj A).obj.map
            (Opposite.op (hT_X.from U))) := by
    intro X _ _ A T_X hT_X
    let J := X.smallEtaleTopology
    let e_T : termObj X ≅ T_X := CategoryTheory.Limits.IsTerminal.uniqueUpToIso (isTermObj X) hT_X
    let e_sch : X ≅ T_X.left :=
      ((AlgebraicGeometry.Scheme.Etale.forget X) ⋙ CategoryTheory.Over.forget X).mapIso e_T
    have hSurj_e : Function.Surjective e_sch.hom.base := fun y =>
      ⟨e_sch.inv.base y, by change (e_sch.inv ≫ e_sch.hom).base y = y; rw [e_sch.inv_hom_id]; rfl⟩
    let _ : Nonempty ↥T_X.left := Nonempty.map e_sch.hom.base inferInstance
    let _ : PreconnectedSpace ↥T_X.left :=
      { isPreconnected_univ := by
          rw [← Set.image_univ_of_surjective hSurj_e]
          exact isPreconnected_univ.image _ e_sch.hom.base.hom.continuous.continuousOn }

    let Q_A : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
      { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥(Opposite.unop E).left ↥A)
        map := fun f => AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom f.unop.left.base.hom)
        map_id := fun _ => by ext s x; rfl
        map_comp := fun _ _ => by ext s x; rfl }

    have hSheaf_Q : CategoryTheory.Presheaf.IsSheaf J Q_A := by
      intro M E S hS x hx
      have hCov := (memEtaleTop_iff S).mp hS
      have hFib : ∀ {Y₁ Y₂ : X.Etale} (f₁ : Y₁ ⟶ E) (hf₁ : S.arrows f₁) (y₁ : ↥Y₁.left)
          (f₂ : Y₂ ⟶ E) (hf₂ : S.arrows f₂) (y₂ : ↥Y₂.left),
          f₁.left.base y₁ = f₂.left.base y₂ →
          ∀ m : ↥M,
            ((AddCommGrpCat.Hom.hom (x f₁ hf₁)) m) y₁ =
              ((AddCommGrpCat.Hom.hom (x f₂ hf₂)) m) y₂ := by
        intro Y₁ Y₂ f₁ hf₁ y₁ f₂ hf₂ y₂ hy m
        let f₁_l : Y₁.left ⟶ E.left := f₁.left
        let f₂_l : Y₂.left ⟶ E.left := f₂.left
        let _ : AlgebraicGeometry.Etale f₁_l := etaleOfHom f₁
        let _ : AlgebraicGeometry.Etale f₂_l := etaleOfHom f₂
        let _ : AlgebraicGeometry.Etale Y₁.hom := Y₁.prop
        let P_pb := CategoryTheory.Limits.pullback f₁_l f₂_l
        let fst_pb : P_pb ⟶ Y₁.left := CategoryTheory.Limits.pullback.fst f₁_l f₂_l
        let snd_pb : P_pb ⟶ Y₂.left := CategoryTheory.Limits.pullback.snd f₁_l f₂_l
        let W_pb : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (fst_pb ≫ Y₁.hom)
        let g₁ : W_pb ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk fst_pb rfl
        have hw₂ : snd_pb ≫ Y₂.hom = fst_pb ≫ Y₁.hom := by
          rw [← CategoryTheory.MorphismProperty.Over.w f₂,
            ← CategoryTheory.Limits.pullback.condition_assoc,
            CategoryTheory.MorphismProperty.Over.w f₁]
        let g₂ : W_pb ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk snd_pb hw₂
        have hcomm : g₁ ≫ f₁ = g₂ ≫ f₂ :=
          (AlgebraicGeometry.Scheme.Etale.forget X).map_injective
            (CategoryTheory.Over.OverMorphism.ext CategoryTheory.Limits.pullback.condition)
        obtain ⟨z, hz₁, hz₂⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy
        have hcomp := hx g₁ g₂ hf₁ hf₂ hcomm
        have hm := congrArg
          (fun (φ : M ⟶ Q_A.obj (Opposite.op W_pb)) => ((AddCommGrpCat.Hom.hom φ) m) z) hcomp
        change ((AddCommGrpCat.Hom.hom (x f₁ hf₁)) m) (fst_pb.base z) =
          ((AddCommGrpCat.Hom.hom (x f₂ hf₂)) m) (snd_pb.base z) at hm
        rwa [hz₁, hz₂] at hm

      let Y_c : ↥E.left → X.Etale := fun pt => (hCov pt).choose
      let f_c : ∀ pt : ↥E.left, Y_c pt ⟶ E := fun pt => (hCov pt).choose_spec.choose
      have hf_c : ∀ pt : ↥E.left, S.arrows (f_c pt) :=
        fun pt => (hCov pt).choose_spec.choose_spec.1
      let y_c : ∀ pt : ↥E.left, ↥(Y_c pt).left :=
        fun pt => (hCov pt).choose_spec.choose_spec.2.choose
      have hy_c : ∀ pt : ↥E.left, (f_c pt).left.base (y_c pt) = pt :=
        fun pt => (hCov pt).choose_spec.choose_spec.2.choose_spec

      let val_fn : ↥M → ↥E.left → ↥A :=
        fun m pt => ((AddCommGrpCat.Hom.hom (x (f_c pt) (hf_c pt))) m) (y_c pt)
      have hLocConst : ∀ m : ↥M, IsLocallyConstant (val_fn m) := by
        intro m
        rw [IsLocallyConstant.iff_exists_open]
        intro pt
        let s_pt : LocallyConstant ↥(Y_c pt).left ↥A :=
          (AddCommGrpCat.Hom.hom (x (f_c pt) (hf_c pt))) m
        let V' : Set ↥(Y_c pt).left := { y | s_pt y = s_pt (y_c pt) }
        have hOpen_V' : IsOpen V' := s_pt.isLocallyConstant.isOpen_fiber (s_pt (y_c pt))
        refine ⟨(f_c pt).left.base '' V', openMapOfHom (f_c pt) V' hOpen_V',
          ⟨y_c pt, rfl, hy_c pt⟩, ?_⟩
        rintro _ ⟨y', hy'V, rfl⟩
        have h1 : val_fn m ((f_c pt).left.base y') = s_pt y' :=
          hFib _ (hf_c _) (y_c _) (f_c pt) (hf_c pt) y' (hy_c _) m
        exact h1.trans hy'V

      let t : M ⟶ Q_A.obj (Opposite.op E) :=
        AddCommGrpCat.ofHom
          { toFun := fun m => ⟨val_fn m, hLocConst m⟩
            map_zero' := by
              ext pt
              change ((AddCommGrpCat.Hom.hom (x (f_c pt) (hf_c pt))) 0) (y_c pt) = 0
              rw [map_zero]; rfl
            map_add' := fun m₁ m₂ => by
              ext pt
              change ((AddCommGrpCat.Hom.hom (x (f_c pt) (hf_c pt))) (m₁ + m₂)) (y_c pt) =
                ((AddCommGrpCat.Hom.hom (x (f_c pt) (hf_c pt))) m₁) (y_c pt) +
                  ((AddCommGrpCat.Hom.hom (x (f_c pt) (hf_c pt))) m₂) (y_c pt)
              rw [map_add]; rfl }
      refine ⟨t, ?_, ?_⟩
      · intro Y f hf
        apply AddCommGrpCat.ext
        intro m
        ext y
        exact hFib (f_c (f.left.base y)) (hf_c _) (y_c _) f hf y (hy_c _) m
      · intro t' ht'
        apply AddCommGrpCat.ext
        intro m
        ext pt
        have h_eq := ht' (f_c pt) (hf_c pt)
        have hm := congrArg
          (fun (φ : M ⟶ Q_A.obj (Opposite.op (Y_c pt))) => ((AddCommGrpCat.Hom.hom φ) m) (y_c pt))
          h_eq
        change ((AddCommGrpCat.Hom.hom t') m) ((f_c pt).left.base (y_c pt)) = val_fn m pt at hm
        rwa [hy_c pt] at hm

    let P_A : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := (CategoryTheory.Functor.const (X.Etale)ᵒᵖ).obj A
    let θ_A : P_A ⟶ Q_A :=
      { app := fun E => AddCommGrpCat.ofHom LocallyConstant.constAddMonoidHom
        naturality := fun _ _ _ => by ext a x; rfl }

    have hLocInj : CategoryTheory.Presheaf.IsLocallyInjective J θ_A := by
      refine CategoryTheory.Presheaf.IsLocallyInjective.mk ?_
      intro E a₁ a₂ hEq
      rw [memEtaleTop_iff]
      intro pt
      have ha : a₁ = a₂ := congrArg (fun (s : LocallyConstant ↥E.unop.left ↥A) => s pt) hEq
      refine ⟨E.unop, 𝟙 E.unop, ?_, pt, rfl⟩
      change P_A.map (Opposite.op (𝟙 E.unop)) a₁ = P_A.map (Opposite.op (𝟙 E.unop)) a₂
      rw [ha]

    have hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective J θ_A := by
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk ?_
      intro E s
      rw [memEtaleTop_iff]
      intro pt
      let s₀ : LocallyConstant ↥E.left ↥A := s
      let O_pt : E.left.Opens := ⟨{ y | s₀ y = s₀ pt }, s₀.isLocallyConstant.isOpen_fiber (s₀ pt)⟩
      let _ : AlgebraicGeometry.Etale E.hom := E.prop
      let W_pt : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (O_pt.ι ≫ E.hom)
      let u_pt : W_pt ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_pt.ι rfl
      refine ⟨W_pt, u_pt, ?_, ⟨pt, rfl⟩, rfl⟩
      refine ⟨s₀ pt, ?_⟩
      ext ⟨y, hy⟩
      exact hy.symm

    have hW_θ : J.W θ_A :=
      (CategoryTheory.GrothendieckTopology.W_iff_isLocallyBijective J θ_A).mpr ⟨hLocInj, hLocSurj⟩
    have hIso_map : CategoryTheory.IsIso ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map θ_A) :=
      (CategoryTheory.GrothendieckTopology.W_iff J θ_A).mp hW_θ

    let Q_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨Q_A, hSheaf_Q⟩
    let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let _ : (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).Full :=
      (CategoryTheory.fullyFaithfulSheafToPresheaf J AddCommGrpCat.{u}).full
    let _ : (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).Faithful :=
      (CategoryTheory.fullyFaithfulSheafToPresheaf J AddCommGrpCat.{u}).faithful
    let φ_A : (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj A ⟶ Q_sh :=
      (adj_sh.homEquiv P_A Q_sh).symm θ_A
    have hφ_def : φ_A = (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map θ_A ≫
        adj_sh.counit.app Q_sh :=
      adj_sh.homEquiv_counit P_A Q_sh θ_A
    have hIso_counit : CategoryTheory.IsIso (adj_sh.counit.app Q_sh) := inferInstance
    let _ : CategoryTheory.IsIso φ_A :=
      hφ_def.symm ▸ @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_map hIso_counit
    have hη_φ : adj_sh.unit.app P_A ≫ φ_A.hom = θ_A :=
      (adj_sh.homEquiv P_A Q_sh).apply_symm_apply θ_A

    have hConstBij : ∀ (Y : Type u) [TopologicalSpace Y] [Nonempty Y] [PreconnectedSpace Y],
        Function.Bijective (LocallyConstant.const Y : ↥A → LocallyConstant Y ↥A) := by
      intro Y _ _ _
      let _ : Nonempty ↥A := ⟨0⟩
      refine ⟨fun a₁ a₂ h => ?_, fun s => ?_⟩
      · obtain ⟨y₀⟩ := ‹Nonempty Y›
        exact congrArg (fun f : LocallyConstant Y ↥A => f y₀) h
      · obtain ⟨y, hy⟩ := LocallyConstant.exists_eq_const s
        exact ⟨y, hy.symm⟩

    have hθ_TX : Function.Bijective (θ_A.app (Opposite.op T_X)) := hConstBij ↥T_X.left
    have hφ_bij : ∀ W : X.Etale, Function.Bijective (φ_A.hom.app (Opposite.op W)) := fun W => by
      let _ : CategoryTheory.IsIso (φ_A.hom.app (Opposite.op W)) :=
        ((CategoryTheory.evaluation _ _).obj (Opposite.op W)).map_isIso
          ((CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map φ_A)
      exact (CategoryTheory.ConcreteCategory.isIso_iff_bijective _).mp inferInstance

    have hUnitEq : (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_X).unit.app A =
        (adj_sh.unit.app P_A).app (Opposite.op T_X) := by
      have h1 : (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_X).unit.app A =
          (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_X).unit.app A ≫
            (adj_sh.unit.app P_A).app (Opposite.op T_X) :=
        CategoryTheory.Adjunction.comp_unit_app _ _ A
      have h2 : (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_X).unit.app A = 𝟙 A :=
        CategoryTheory.constantPresheafAdj_unit_app AddCommGrpCat.{u} hT_X A
      exact h1.trans ((congrArg (· ≫ (adj_sh.unit.app P_A).app (Opposite.op T_X)) h2).trans
        (CategoryTheory.Category.id_comp _))

    have hUnitComp : ((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_X).unit.app A) ≫
        φ_A.hom.app (Opposite.op T_X) = θ_A.app (Opposite.op T_X) :=
      (congrArg (· ≫ φ_A.hom.app (Opposite.op T_X)) hUnitEq).trans
        (congrArg (fun α => α.app (Opposite.op T_X)) hη_φ)

    have hBijUnit : Function.Bijective
        ((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_X).unit.app A) := by
      have hcomp_bij : Function.Bijective
          (((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_X).unit.app A) ≫
            φ_A.hom.app (Opposite.op T_X)) := hUnitComp.symm ▸ hθ_TX
      exact (Function.Bijective.of_comp_iff' (hφ_bij T_X) _).mp hcomp_bij

    refine ⟨hBijUnit, fun U _ _ => ?_⟩
    let u := hT_X.from U
    have hθ_U : Function.Bijective (θ_A.app (Opposite.op U)) := hConstBij ↥U.left
    have hθ_fac : θ_A.app (Opposite.op T_X) ≫ Q_A.map (Opposite.op u) = θ_A.app (Opposite.op U) := by
      ext a x; rfl
    have hBij_Qmap : Function.Bijective (Q_A.map (Opposite.op u)) := by
      have hcomp : Function.Bijective (θ_A.app (Opposite.op T_X) ≫ Q_A.map (Opposite.op u)) :=
        hθ_fac.symm ▸ hθ_U
      exact (Function.Bijective.of_comp_iff (Q_A.map (Opposite.op u)) hθ_TX).mp hcomp
    have hNat : ((CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj A).obj.map (Opposite.op u) ≫
        φ_A.hom.app (Opposite.op U) =
        φ_A.hom.app (Opposite.op T_X) ≫ Q_A.map (Opposite.op u) :=
      φ_A.hom.naturality (Opposite.op u)
    have hRHS_bij : Function.Bijective (φ_A.hom.app (Opposite.op T_X) ≫ Q_A.map (Opposite.op u)) :=
      hBij_Qmap.comp (hφ_bij T_X)
    have hLHS_bij : Function.Bijective
        (((CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj A).obj.map (Opposite.op u) ≫
          φ_A.hom.app (Opposite.op U)) := hNat.symm ▸ hRHS_bij
    exact (Function.Bijective.of_comp_iff' (hφ_bij U) _).mp hLHS_bij

  
  
  
  have hHensLift : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsAlgClosed (IsLocalRing.ResidueField A)]
      (Z : AlgebraicGeometry.Scheme.{u})
      (p : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of A)) [AlgebraicGeometry.Etale p]
      (z₀ : ↥Z),
      p.base z₀ = IsLocalRing.closedPoint A →
      ∃ σ : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Z,
        σ ≫ p = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of A)) ∧
        Specializes z₀ (σ.base (IsLocalRing.closedPoint A)) := by
    intro A _ _ _ Z p _ z₀ hz₀
    let S_A := AlgebraicGeometry.Spec (CommRingCat.of A)
    obtain ⟨U_Z, hAff, hz₀_U, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z₀) (U := (⊤ : Z.Opens)) trivial
    let R_B : CommRingCat.{u} := Z.presheaf.obj (Opposite.op U_Z)
    let B : Type u := ↥R_B
    let ι_aff : AlgebraicGeometry.Spec R_B ⟶ Z := hAff.fromSpec
    let _ : AlgebraicGeometry.IsOpenImmersion ι_aff := inferInstance
    have hRange_aff : Set.range ι_aff.base = (U_Z : Set ↥Z) := hAff.range_fromSpec
    have hz₀_range : z₀ ∈ Set.range ι_aff.base := by rw [hRange_aff]; exact hz₀_U
    obtain ⟨q₀, hq₀_z⟩ := hz₀_range

    have hEt_comp : AlgebraicGeometry.Etale (ι_aff ≫ p) := inferInstance
    let φ_AB : CommRingCat.of A ⟶ R_B := AlgebraicGeometry.Spec.preimage (ι_aff ≫ p)
    have hSpec_φ : AlgebraicGeometry.Spec.map φ_AB = ι_aff ≫ p :=
      AlgebraicGeometry.Spec.map_preimage (ι_aff ≫ p)
    let α : A →+* B := φ_AB.hom
    have hEt_α : α.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (by rw [hSpec_φ]; exact hEt_comp)
    let _ : Algebra A B := α.toAlgebra
    let _ : Algebra.Etale A B := RingHom.Etale.toAlgebra hEt_α
    let _ : q₀.asIdeal.IsPrime := q₀.isPrime

    have hq₀_over : Ideal.comap α q₀.asIdeal = IsLocalRing.maximalIdeal A := by
      have hbase : (AlgebraicGeometry.Spec.map φ_AB).base q₀ = IsLocalRing.closedPoint A := by
        rw [hSpec_φ]
        change p.base (ι_aff.base q₀) = IsLocalRing.closedPoint A
        rw [hq₀_z, hz₀]
      exact congrArg PrimeSpectrum.asIdeal hbase

    obtain ⟨g, hg_not_mem, hStd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := A) q₀.asIdeal
    let B_g := Localization.Away g
    let _ : Algebra.IsStandardEtale A B_g := hStd
    obtain ⟨⟨P, x, hx, hbij_lift⟩⟩ :=
      Algebra.IsStandardEtale.nonempty_standardEtalePresentation (R := A) (S := B_g)
    let e_std : P.Ring ≃ₐ[A] B_g := AlgEquiv.ofBijective (P.lift x hx) hbij_lift

    have hDisj : Disjoint (Submonoid.powers g : Set B) (q₀.asIdeal : Set B) := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hmem
      exact hg_not_mem (q₀.isPrime.mem_of_pow_mem n hmem)
    let Q_g : Ideal B_g := Ideal.map (algebraMap B B_g) q₀.asIdeal
    have hPrime_Qg : Q_g.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers g) B_g q₀.asIdeal q₀.isPrime hDisj
    obtain ⟨M₀, hM₀_max, hQg_le_M₀⟩ := Ideal.exists_le_maximal Q_g hPrime_Qg.ne_top
    let _ : M₀.IsMaximal := hM₀_max

    have hq₀_le_M₀ : q₀.asIdeal ≤ Ideal.comap (algebraMap B B_g) M₀ :=
      (Ideal.le_comap_map (f := algebraMap B B_g) (I := q₀.asIdeal)).trans
        (Ideal.comap_mono hQg_le_M₀)
    have hAlg_eq : algebraMap A B_g = (algebraMap B B_g).comp α := rfl
    have hm_le_comap : IsLocalRing.maximalIdeal A ≤ Ideal.comap (algebraMap A B_g) M₀ := by
      rw [← hq₀_over, hAlg_eq, ← Ideal.comap_comap]
      exact Ideal.comap_mono hq₀_le_M₀
    have hcomap_ne_top : Ideal.comap (algebraMap A B_g) M₀ ≠ ⊤ :=
      Ideal.comap_ne_top (algebraMap A B_g) hM₀_max.ne_top
    have hcomap_eq_m : Ideal.comap (algebraMap A B_g) M₀ = IsLocalRing.maximalIdeal A :=
      le_antisymm (IsLocalRing.le_maximalIdeal hcomap_ne_top) hm_le_comap

    let L₀ := B_g ⧸ M₀
    let _ : Field L₀ := Ideal.Quotient.field M₀
    let π_M : B_g →ₐ[A] L₀ := Ideal.Quotient.mkₐ A M₀
    have hker_AL₀ : ∀ a ∈ IsLocalRing.maximalIdeal A, algebraMap A L₀ a = 0 := by
      intro a ha
      rw [← hcomap_eq_m] at ha
      change Ideal.Quotient.mk M₀ (algebraMap A B_g a) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr ha
    let ι_k : IsLocalRing.ResidueField A →+* L₀ :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal A) (algebraMap A L₀) hker_AL₀
    have hι_res : ι_k.comp (IsLocalRing.residue A) = algebraMap A L₀ :=
      RingHom.ext fun _ => rfl

    have hx_L : P.HasMap (π_M x) := hx.map π_M
    have hfx_zero : Polynomial.aeval (π_M x) P.f = 0 := hx_L.1
    have hgx_unit : IsUnit (Polynomial.aeval (π_M x) P.g) := hx_L.2
    have hdfx_unit : IsUnit (Polynomial.aeval (π_M x) (Polynomial.derivative P.f)) :=
      hx_L.isUnit_derivative_f

    let f_k : Polynomial (IsLocalRing.ResidueField A) :=
      Polynomial.map (IsLocalRing.residue A) P.f
    have hf_k_monic : f_k.Monic := P.monic_f.map (IsLocalRing.residue A)
    have hf_k_prod : f_k = (Multiset.map (fun r => Polynomial.X - Polynomial.C r) f_k.roots).prod :=
      (IsAlgClosed.splits f_k).eq_prod_roots_of_monic hf_k_monic
    have heval_fk : Polynomial.eval₂ ι_k (π_M x) f_k = 0 := by
      dsimp [f_k]
      rw [Polynomial.eval₂_map, hι_res]
      exact hfx_zero
    rw [hf_k_prod, Polynomial.eval₂_multiset_prod] at heval_fk
    obtain ⟨p_lin, hp_mem, hp_eval⟩ := Multiset.mem_map.mp (Multiset.prod_eq_zero_iff.mp heval_fk)
    obtain ⟨r₀, _, rfl⟩ := Multiset.mem_map.mp hp_mem
    have hπx_eq : π_M x = ι_k r₀ := by
      have hsub : π_M x - ι_k r₀ = 0 := by
        simpa only [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C] using hp_eval
      exact sub_eq_zero.mp hsub

    obtain ⟨a₀, ha₀_res⟩ := Ideal.Quotient.mk_surjective r₀
    have hEvalBridge : ∀ (q : Polynomial A) (c : A),
        IsLocalRing.residue A c = r₀ →
        ι_k (IsLocalRing.residue A (q.eval c)) = Polynomial.aeval (π_M x) q := by
      intro q c hc
      change ι_k ((IsLocalRing.residue A) (Polynomial.eval₂ (RingHom.id A) c q)) =
        Polynomial.eval₂ (algebraMap A L₀) (π_M x) q
      rw [Polynomial.hom_eval₂, RingHom.comp_id, Polynomial.hom_eval₂, hc, hι_res, hπx_eq]

    have hfa₀_mem : P.f.eval a₀ ∈ IsLocalRing.maximalIdeal A := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      apply ι_k.injective
      rw [map_zero, hEvalBridge P.f a₀ ha₀_res, hfx_zero]
    have hdfa₀_unit : IsUnit ((Polynomial.derivative P.f).eval a₀) := by
      rw [← IsLocalRing.notMem_maximalIdeal, ← IsLocalRing.residue_eq_zero_iff]
      intro h0
      have h1 := hEvalBridge (Polynomial.derivative P.f) a₀ ha₀_res
      rw [h0, map_zero] at h1
      exact hdfx_unit.ne_zero h1.symm

    obtain ⟨a, ha_root, ha_diff⟩ :=
      HenselianLocalRing.is_henselian P.f P.monic_f a₀ hfa₀_mem hdfa₀_unit
    have ha_res : IsLocalRing.residue A a = r₀ := by
      have h0 : IsLocalRing.residue A (a - a₀) = 0 :=
        (IsLocalRing.residue_eq_zero_iff (a - a₀)).mpr ha_diff
      rw [map_sub, sub_eq_zero] at h0
      exact h0.trans ha₀_res
    have hga_unit : IsUnit (P.g.eval a) := by
      rw [← IsLocalRing.notMem_maximalIdeal, ← IsLocalRing.residue_eq_zero_iff]
      intro h0
      have h1 := hEvalBridge P.g a ha_res
      rw [h0, map_zero] at h1
      exact hgx_unit.ne_zero h1.symm
    have ha_hasMap : P.HasMap a := by
      refine ⟨?_, ?_⟩
      · simpa only [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.eval₂_id] using
          ha_root.eq_zero
      · simpa only [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.eval₂_id] using
          hga_unit

    let ψ_g : B_g →ₐ[A] A := (P.lift a ha_hasMap).comp e_std.symm.toAlgHom
    let ψ_B : B →ₐ[A] A := ψ_g.comp (IsScalarTower.toAlgHom A B B_g)
    have hHom_eq : π_M.comp e_std.toAlgHom = (Algebra.ofId A L₀).comp (P.lift a ha_hasMap) := by
      apply StandardEtalePair.hom_ext
      have hL : (π_M.comp e_std.toAlgHom) P.X = π_M x :=
        congrArg π_M (P.lift_X x hx)
      have hR : ((Algebra.ofId A L₀).comp (P.lift a ha_hasMap)) P.X = algebraMap A L₀ a :=
        congrArg (algebraMap A L₀) (P.lift_X a ha_hasMap)
      rw [hL, hR, ← hι_res, RingHom.comp_apply, ha_res, hπx_eq]

    have hψg_π : ∀ u : B_g, algebraMap A L₀ (ψ_g u) = π_M u := by
      intro u
      have hu : e_std.toAlgHom (e_std.symm u) = u := e_std.apply_symm_apply u
      have happ := congrArg (fun (Φ : P.Ring →ₐ[A] L₀) => Φ (e_std.symm u)) hHom_eq
      change π_M (e_std.toAlgHom (e_std.symm u)) = algebraMap A L₀ (ψ_g u) at happ
      rw [hu] at happ
      exact happ.symm

    let σ_aff : S_A ⟶ AlgebraicGeometry.Spec R_B :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B.toRingHom)
    let q_cl : PrimeSpectrum B := σ_aff.base (IsLocalRing.closedPoint A)
    have hq₀_le_σ : q₀.asIdeal ≤ q_cl.asIdeal := by
      intro b hb
      have hb_M₀ : algebraMap B B_g b ∈ M₀ := hq₀_le_M₀ hb
      have hπ_zero : π_M (algebraMap B B_g b) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hb_M₀
      have hL_zero : algebraMap A L₀ (ψ_B b) = 0 := (hψg_π (algebraMap B B_g b)).trans hπ_zero
      have hres_zero : IsLocalRing.residue A (ψ_B b) = 0 := by
        apply ι_k.injective
        rw [map_zero, ← RingHom.comp_apply, hι_res, hL_zero]
      exact (IsLocalRing.residue_eq_zero_iff (ψ_B b)).mp hres_zero

    have hsp_aff : Specializes q₀ (σ_aff.base (IsLocalRing.closedPoint A)) :=
      (PrimeSpectrum.le_iff_specializes (q₀ : PrimeSpectrum B) q_cl).mp hq₀_le_σ
    let σ : S_A ⟶ Z := σ_aff ≫ ι_aff
    have hσ_sec : σ ≫ p = 𝟙 S_A := by
      dsimp [σ, σ_aff]
      rw [CategoryTheory.Category.assoc, ← hSpec_φ, ← AlgebraicGeometry.Spec.map_comp]
      have hcomp_id : φ_AB ≫ CommRingCat.ofHom ψ_B.toRingHom = 𝟙 (CommRingCat.of A) :=
        CommRingCat.hom_ext (RingHom.ext fun c => ψ_B.commutes c)
      exact (congrArg AlgebraicGeometry.Spec.map hcomp_id).trans (AlgebraicGeometry.Spec.map_id _)
    have hsp_Z : Specializes z₀ (σ.base (IsLocalRing.closedPoint A)) := by
      rw [← hq₀_z]
      exact hsp_aff.map ι_aff.base.hom.continuous
    exact ⟨σ, hσ_sec, hsp_Z⟩

  have hAlgLift : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (Z : AlgebraicGeometry.Scheme.{u})
      (p : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)) [AlgebraicGeometry.Etale p]
      (z₀ : ↥Z),
      ∃ σ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ Z,
        σ ≫ p = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) ∧
        σ.base (⊥ : PrimeSpectrum K) = z₀ := by
    intro K _ _ Z p hEt_p z₀
    let _ : HenselianLocalRing K := Field.henselian K
    let e_resK : K ≃+* IsLocalRing.ResidueField K :=
      RingEquiv.ofBijective (IsLocalRing.residue K)
        ⟨RingHom.injective _, Ideal.Quotient.mk_surjective⟩
    let _ : IsAlgClosed (IsLocalRing.ResidueField K) := by
      refine IsAlgClosed.of_exists_root _ fun q _ hq_irred => ?_
      let q₀ : Polynomial K := Polynomial.map e_resK.symm.toRingHom q
      have hq₀_deg : q₀.degree ≠ 0 := by
        rw [Polynomial.degree_map_eq_of_injective e_resK.symm.injective]
        exact ne_of_gt hq_irred.degree_pos
      obtain ⟨r, hr⟩ := IsAlgClosed.exists_root q₀ hq₀_deg
      refine ⟨e_resK r, ?_⟩
      have hmap : Polynomial.map e_resK.toRingHom q₀ = q := by
        rw [Polynomial.map_map]
        have hid : e_resK.toRingHom.comp e_resK.symm.toRingHom = RingHom.id _ :=
          RingHom.ext e_resK.apply_symm_apply
        rw [hid, Polynomial.map_id]
      change Polynomial.eval (e_resK.toRingHom r) q = 0
      rw [← hmap, Polynomial.eval_map, Polynomial.eval₂_hom, hr.eq_zero, map_zero]
    obtain ⟨σ, hσ_sec, hsp⟩ := hHensLift K Z p z₀ (Subsingleton.elim _ _)
    let _ : AlgebraicGeometry.Etale σ :=
      etaleOfPostcomp σ p hEt_p (hσ_sec.symm ▸ inferInstance)
    have _ : AlgebraicGeometry.UniversallyOpen σ := AlgebraicGeometry.UniversallyOpen.of_flat σ
    have hOpen_range : IsOpen (Set.range σ.base) := σ.isOpenMap.isOpen_range
    obtain ⟨pt, hpt⟩ := hsp.mem_open hOpen_range ⟨IsLocalRing.closedPoint K, rfl⟩
    rw [Subsingleton.elim pt (⊥ : PrimeSpectrum K)] at hpt
    exact ⟨σ, hσ_sec, hpt⟩

  
  
  
  have hEpiSurjOfClosedLift : ∀ (S : AlgebraicGeometry.Scheme.{u}) (x₀ : ↥S),
      (∀ (Z : AlgebraicGeometry.Scheme.{u}) (p : Z ⟶ S) [AlgebraicGeometry.Etale p] (z₀ : ↥Z),
        p.base z₀ = x₀ → ∃ σ : S ⟶ Z, σ ≫ p = 𝟙 S) →
      ∀ (T_S : S.Etale) (_hT_S : CategoryTheory.Limits.IsTerminal T_S)
        {ℱ₁ ℱ₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (π : ℱ₁ ⟶ ℱ₂) [CategoryTheory.Epi π],
        Function.Surjective (π.hom.app (Opposite.op T_S)) := by
    intro S x₀ hLift T_S hT_S ℱ₁ ℱ₂ π _ y
    let T₀ := termObj S
    let hT₀ := isTermObj S
    let e_T : T₀ ≅ T_S := CategoryTheory.Limits.IsTerminal.uniqueUpToIso hT₀ hT_S
    have hIdMem : ∀ R : CategoryTheory.Sieve T_S,
        R ∈ S.smallEtaleTopology T_S → R.arrows (𝟙 T_S) := by
      intro R hR
      let R₀ : CategoryTheory.Sieve T₀ := R.pullback e_T.hom
      have hR₀ : R₀ ∈ S.smallEtaleTopology T₀ :=
        S.smallEtaleTopology.pullback_stable e_T.hom hR
      obtain ⟨W, f, hf_R₀, z₀, hz₀⟩ := (memEtaleTop_iff R₀).mp hR₀ x₀
      let _ : AlgebraicGeometry.Etale W.hom := W.prop
      let f_l : W.left ⟶ S := f.left
      have hw : f_l ≫ 𝟙 S = W.hom := CategoryTheory.MorphismProperty.Over.w f
      have hf_eq : f_l = W.hom := (CategoryTheory.Category.comp_id f_l).symm.trans hw
      have hz₀_W : W.hom.base z₀ = x₀ := (congrArg (fun m : W.left ⟶ S => m.base z₀) hf_eq.symm).trans hz₀
      obtain ⟨σ, hσ_sec⟩ := hLift W.left W.hom z₀ hz₀_W
      let σ_et : T₀ ⟶ W := CategoryTheory.MorphismProperty.Over.homMk σ hσ_sec
      have hfac_id : σ_et ≫ f = 𝟙 T₀ := hT₀.hom_ext _ _
      have hid_R₀ : R₀.arrows (𝟙 T₀) := hfac_id ▸ R₀.downward_closed hf_R₀ σ_et
      have he_R : R.arrows e_T.hom := by
        change R.arrows (𝟙 T₀ ≫ e_T.hom) at hid_R₀
        rwa [CategoryTheory.Category.id_comp] at hid_R₀
      have hinv_e : R.arrows (e_T.inv ≫ e_T.hom) := R.downward_closed he_R e_T.inv
      rwa [e_T.inv_hom_id] at hinv_e
    let _ : CategoryTheory.Sheaf.IsLocallySurjective π :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} π).mpr inferInstance
    have hImgMem : CategoryTheory.Presheaf.imageSieve π.hom y ∈ S.smallEtaleTopology T_S :=
      CategoryTheory.Presheaf.imageSieve_mem S.smallEtaleTopology π.hom y
    obtain ⟨x, hx⟩ := hIdMem _ hImgMem
    refine ⟨x, hx.trans ?_⟩
    change (ℱ₂.obj.map (𝟙 (Opposite.op T_S))) y = y
    rw [ℱ₂.obj.map_id]; rfl

  have hAlgSiteProps : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      (∀ (Z : AlgebraicGeometry.Scheme.{u}) (p : Z ⟶ S) [AlgebraicGeometry.Etale p] (z₀ : ↥Z),
        ∃ (σ : S ⟶ Z) (pt : ↥S), σ ≫ p = 𝟙 S ∧ σ.base pt = z₀) →
      (∀ (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
        Subsingleton (ℱ.H 0) → CategoryTheory.Limits.IsZero ℱ) ∧
      (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
          (ψ : ℱ₁ ⟶ ℱ₂) (T_S : S.Etale) (_hT_S : CategoryTheory.Limits.IsTerminal T_S),
        Function.Surjective (ψ.hom.app (Opposite.op T_S)) → CategoryTheory.Epi ψ) := by
    intro S hPtLift
    let T₀ := termObj S
    let hT₀ := isTermObj S
    have hSecSieveMem : ∀ (T_S : S.Etale) (hT_S : CategoryTheory.Limits.IsTerminal T_S)
        (U : S.Etale),
        CategoryTheory.Sieve.ofArrows (fun (_ : T_S ⟶ U) => T_S) (fun g => g) ∈
          S.smallEtaleTopology U := by
      intro T_S hT_S U
      let e_T : T₀ ≅ T_S := CategoryTheory.Limits.IsTerminal.uniqueUpToIso hT₀ hT_S
      rw [memEtaleTop_iff]
      intro z₀
      let _ : AlgebraicGeometry.Etale U.hom := U.prop
      obtain ⟨σ, pt, hσ_sec, hσ_pt⟩ := hPtLift U.left U.hom z₀
      let σ₀ : T₀ ⟶ U := CategoryTheory.MorphismProperty.Over.homMk σ hσ_sec
      let g : T_S ⟶ U := e_T.inv ≫ σ₀
      let e_hom_l : S ⟶ T_S.left := e_T.hom.left
      let e_inv_l : T_S.left ⟶ S := e_T.inv.left
      let g_l : T_S.left ⟶ U.left := g.left
      refine ⟨T_S, g, CategoryTheory.Sieve.ofArrows_mk _ _ g, e_hom_l.base pt, ?_⟩
      have he_id : e_hom_l ≫ e_inv_l = 𝟙 S :=
        congrArg CategoryTheory.CommaMorphism.left
          (congrArg (AlgebraicGeometry.Scheme.Etale.forget S).map e_T.hom_inv_id)
      have hg_def : g_l = e_inv_l ≫ σ := rfl
      have hg_left : e_hom_l ≫ g_l = σ := by
        rw [hg_def, ← CategoryTheory.Category.assoc, he_id, CategoryTheory.Category.id_comp]
      exact (congrArg (fun m : S ⟶ U.left => m.base pt) hg_left).trans hσ_pt

    refine ⟨fun ℱ hSub => ?_, fun {ℱ₁ ℱ₂} ψ T_S hT_S hSurj => ?_⟩
    · have _ : Subsingleton ↥(ℱ.obj.obj (Opposite.op T₀)) :=
        (CategoryTheory.Sheaf.H.equiv₀ ℱ hT₀).symm.toEquiv.subsingleton
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply CategoryTheory.Sheaf.hom_ext
      ext U s
      let Eℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let R_U := CategoryTheory.Sieve.ofArrows (fun (_ : T₀ ⟶ U.unop) => T₀) (fun g => g)
      have hCov_U : R_U ∈ S.smallEtaleTopology U.unop := hSecSieveMem T₀ hT₀ U.unop
      let s_hom : Eℤ ⟶ ℱ.obj.obj U :=
        AddCommGrpCat.ofHom
          { toFun := fun n => n.down • s
            map_zero' := zero_zsmul s
            map_add' := fun a b => add_zsmul s a.down b.down }
      have hSep := (ℱ.property Eℤ).isSeparated R_U hCov_U
      have hs_zero : s_hom = (0 : Eℤ ⟶ ℱ.obj.obj U) := by
        apply hSep.ext
        intro W h hh
        rcases hh with ⟨_, u, _, ⟨g⟩, rfl⟩
        change s_hom ≫ ℱ.obj.map (u ≫ g).op = 0 ≫ ℱ.obj.map (u ≫ g).op
        have hmap_ug : ℱ.obj.map (u ≫ g).op = ℱ.obj.map g.op ≫ ℱ.obj.map u.op :=
          (congrArg ℱ.obj.map (CategoryTheory.op_comp (f := u) (g := g))).trans
            (ℱ.obj.map_comp g.op u.op)
        have h_mid : s_hom ≫ ℱ.obj.map g.op = 0 := by
          ext ⟨n⟩; exact Subsingleton.elim _ _
        exact (congrArg (s_hom ≫ ·) hmap_ug).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ ℱ.obj.map u.op) h_mid).trans
              (CategoryTheory.Limits.zero_comp.trans CategoryTheory.Limits.zero_comp.symm)))
      have h1 := congrArg (fun (φ : Eℤ ⟶ ℱ.obj.obj U) => φ (ULift.up 1)) hs_zero
      change (1 : ℤ) • s = 0 at h1
      rw [one_zsmul] at h1
      exact h1
    · rw [← CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} ψ]
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk ?_
      intro U y
      let R_U := CategoryTheory.Sieve.ofArrows (fun (_ : T_S ⟶ U) => T_S) (fun g => g)
      refine S.smallEtaleTopology.superset_covering ?_ (hSecSieveMem T_S hT_S U)
      intro W h hh
      rcases hh with ⟨_, u, _, ⟨g⟩, rfl⟩
      obtain ⟨x₀, hx₀⟩ := hSurj (ℱ₂.obj.map g.op y)
      refine ⟨ℱ₁.obj.map u.op x₀, ?_⟩
      have hnat := congrArg (fun φ => φ x₀) (ψ.hom.naturality u.op)
      change ψ.hom.app (Opposite.op W) (ℱ₁.obj.map u.op x₀) =
        ℱ₂.obj.map u.op (ψ.hom.app (Opposite.op T_S) x₀) at hnat
      have hmap_ug : ℱ₂.obj.map (u ≫ g).op y = ℱ₂.obj.map u.op (ℱ₂.obj.map g.op y) :=
        congrArg (fun m => m y)
          ((congrArg ℱ₂.obj.map (CategoryTheory.op_comp (f := u) (g := g))).trans
            (ℱ₂.obj.map_comp g.op u.op))
      exact hnat.trans ((congrArg (ℱ₂.obj.map u.op) hx₀).trans hmap_ug.symm)

  
  
  
  let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong P_et j_Rbar :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P_et j_Rbar :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  let M_j : S_Ω.Etale ⥤ S_R.Etale :=
    CategoryTheory.MorphismProperty.Over.map (P := P_et) ⊤ hEt_j
  let B_j : S_R.Etale ⥤ S_Ω.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback P_et ⊤ j_Rbar
  let adj_ov : M_j ⊣ B_j :=
    CategoryTheory.MorphismProperty.Over.mapPullbackAdj P_et ⊤ j_Rbar hEt_j trivial

  have hCompat_Mj : CategoryTheory.CompatiblePreserving S_R.smallEtaleTopology M_j := by
    refine CategoryTheory.CompatiblePreserving.mk ?_
    intro ℱ Z T x hx Y₁ Y₂ W f₁ f₂ g₁ g₂ hg₁ hg₂ hcomm
    let f₁_l : W.left ⟶ Y₁.left := f₁.left
    let f₂_l : W.left ⟶ Y₂.left := f₂.left
    let g₁_l : Y₁.left ⟶ Z.left := g₁.left
    let g₂_l : Y₂.left ⟶ Z.left := g₂.left
    let _ : AlgebraicGeometry.Etale Y₁.hom := Y₁.prop
    let _ : AlgebraicGeometry.Etale j_Rbar := hEt_j
    have hf₁_w : f₁_l ≫ (Y₁.hom ≫ j_Rbar) = W.hom := CategoryTheory.MorphismProperty.Over.w f₁
    let _ : AlgebraicGeometry.Etale f₁_l :=
      etaleOfPostcomp f₁_l (Y₁.hom ≫ j_Rbar) inferInstance (hf₁_w.symm ▸ W.prop)
    let w₀ : W.left ⟶ S_Ω := f₁_l ≫ Y₁.hom
    let _ : AlgebraicGeometry.Etale w₀ := inferInstance
    let W₀ : S_Ω.Etale := AlgebraicGeometry.Scheme.Etale.mk w₀
    let f1_lift : W₀ ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk f₁_l rfl
    have hf₁₂_left : f₁_l ≫ g₁_l = f₂_l ≫ g₂_l :=
      congrArg CategoryTheory.CommaMorphism.left
        (congrArg (AlgebraicGeometry.Scheme.Etale.forget S_R).map hcomm)
    have hw₂ : f₂_l ≫ Y₂.hom = w₀ := by
      have hg₁_w : g₁_l ≫ Z.hom = Y₁.hom := CategoryTheory.MorphismProperty.Over.w g₁
      have hg₂_w : g₂_l ≫ Z.hom = Y₂.hom := CategoryTheory.MorphismProperty.Over.w g₂
      dsimp [w₀]
      rw [← hg₂_w, ← CategoryTheory.Category.assoc, ← hf₁₂_left,
        CategoryTheory.Category.assoc, hg₁_w]
    let f2_lift : W₀ ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk f₂_l hw₂
    have hcomm₀ : f1_lift ≫ g₁ = f2_lift ≫ g₂ :=
      (AlgebraicGeometry.Scheme.Etale.forget S_Ω).map_injective
        (CategoryTheory.Over.OverMorphism.ext hf₁₂_left)
    have hx_eq := hx f1_lift f2_lift hg₁ hg₂ hcomm₀
    have hu_w : 𝟙 W.left ≫ (w₀ ≫ j_Rbar) = W.hom := by
      rw [CategoryTheory.Category.id_comp]
      dsimp [w₀]
      rw [CategoryTheory.Category.assoc]
      exact hf₁_w
    let u_W : W ⟶ M_j.obj W₀ := CategoryTheory.MorphismProperty.Over.homMk (𝟙 W.left) hu_w
    have hu₁ : u_W ≫ M_j.map f1_lift = f₁ :=
      (AlgebraicGeometry.Scheme.Etale.forget S_R).map_injective
        (CategoryTheory.Over.OverMorphism.ext (CategoryTheory.Category.id_comp f₁_l))
    have hu₂ : u_W ≫ M_j.map f2_lift = f₂ :=
      (AlgebraicGeometry.Scheme.Etale.forget S_R).map_injective
        (CategoryTheory.Over.OverMorphism.ext (CategoryTheory.Category.id_comp f₂_l))
    have hmap_eq := congrArg (ℱ.obj.map u_W.op) hx_eq
    have hL_fac : ℱ.obj.map f₁.op = ℱ.obj.map (M_j.map f1_lift).op ≫ ℱ.obj.map u_W.op :=
      (congrArg ℱ.obj.map (congrArg Quiver.Hom.op hu₁.symm)).trans
        ((congrArg ℱ.obj.map (CategoryTheory.op_comp (f := u_W) (g := M_j.map f1_lift))).trans
          (ℱ.obj.map_comp (M_j.map f1_lift).op u_W.op))
    have hR_fac : ℱ.obj.map f₂.op = ℱ.obj.map (M_j.map f2_lift).op ≫ ℱ.obj.map u_W.op :=
      (congrArg ℱ.obj.map (congrArg Quiver.Hom.op hu₂.symm)).trans
        ((congrArg ℱ.obj.map (CategoryTheory.op_comp (f := u_W) (g := M_j.map f2_lift))).trans
          (ℱ.obj.map_comp (M_j.map f2_lift).op u_W.op))
    exact (congrArg (fun m => m (x g₁ hg₁)) hL_fac).trans
      (hmap_eq.trans (congrArg (fun m => m (x g₂ hg₂)) hR_fac).symm)

  have hCover_Mj : CategoryTheory.CoverPreserving S_Ω.smallEtaleTopology S_R.smallEtaleTopology M_j := by
    refine CategoryTheory.CoverPreserving.mk ?_
    intro V R hR
    rw [memEtaleTop_iff]
    intro pt
    obtain ⟨Y, g, hg_R, y, hy⟩ := (memEtaleTop_iff R).mp hR pt
    refine ⟨M_j.obj Y, M_j.map g, ?_, y, hy⟩
    exact ⟨Y, g, 𝟙 (M_j.obj Y), hg_R, (CategoryTheory.Category.id_comp _).symm⟩

  let _ : M_j.IsContinuous S_Ω.smallEtaleTopology S_R.smallEtaleTopology :=
    CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat_Mj hCover_Mj
  let R_j := M_j.sheafPushforwardContinuous AddCommGrpCat.{u}
    S_Ω.smallEtaleTopology S_R.smallEtaleTopology

  let T_idΩ : S_Ω.Etale := termObj S_Ω
  let hT_idΩ : CategoryTheory.Limits.IsTerminal T_idΩ := isTermObj S_Ω
  let ι₀ : M_j.obj T_idΩ ≅ U_Ω :=
    CategoryTheory.MorphismProperty.Over.isoMk (CategoryTheory.Iso.refl S_Ω)
      ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.id_comp j_Rbar))

  have hAdjSlice : ∀ (hc_B : B_j.IsContinuous S_R.smallEtaleTopology S_Ω.smallEtaleTopology),
      letI := hc_B
      R_j ⊣ B_j.sheafPushforwardContinuous AddCommGrpCat.{u}
        S_R.smallEtaleTopology S_Ω.smallEtaleTopology := by
    intro hc_B
    let _ := hc_B
    exact CategoryTheory.Adjunction.mkOfUnitCounit
      { unit :=
          { app := fun ℱ =>
              { hom :=
                  { app := fun W => ℱ.obj.map (adj_ov.counit.app W.unop).op
                    naturality := fun {W₁ W₂} u => by
                      have hnat : u ≫ (adj_ov.counit.app W₂.unop).op =
                          (adj_ov.counit.app W₁.unop).op ≫ (M_j.map (B_j.map u.unop)).op := by
                        have h0 := congrArg Quiver.Hom.op (adj_ov.counit.naturality u.unop)
                        exact (CategoryTheory.op_comp (f := adj_ov.counit.app W₂.unop)
                          (g := u.unop)).symm.trans
                          (h0.symm.trans
                            (CategoryTheory.op_comp (f := M_j.map (B_j.map u.unop))
                              (g := adj_ov.counit.app W₁.unop)))
                      exact (ℱ.obj.map_comp u (adj_ov.counit.app W₂.unop).op).symm.trans
                        ((congrArg ℱ.obj.map hnat).trans
                          (ℱ.obj.map_comp (adj_ov.counit.app W₁.unop).op
                            (M_j.map (B_j.map u.unop)).op)) } }
            naturality := fun {ℱ₁ ℱ₂} α => by
              apply CategoryTheory.Sheaf.hom_ext
              ext W x
              exact congrArg (fun m => m x)
                (α.hom.naturality (adj_ov.counit.app W.unop).op).symm }
        counit :=
          { app := fun 𝒢 =>
              { hom :=
                  { app := fun V => 𝒢.obj.map (adj_ov.unit.app V.unop).op
                    naturality := fun {V₁ V₂} v => by
                      have hnat : (B_j.map (M_j.map v.unop)).op ≫ (adj_ov.unit.app V₂.unop).op =
                          (adj_ov.unit.app V₁.unop).op ≫ v := by
                        have h0 := congrArg Quiver.Hom.op (adj_ov.unit.naturality v.unop)
                        exact (CategoryTheory.op_comp (f := adj_ov.unit.app V₂.unop)
                          (g := B_j.map (M_j.map v.unop))).symm.trans
                          (h0.symm.trans (CategoryTheory.op_comp (f := v.unop)
                            (g := adj_ov.unit.app V₁.unop)))
                      exact (𝒢.obj.map_comp (B_j.map (M_j.map v.unop)).op
                        (adj_ov.unit.app V₂.unop).op).symm.trans
                        ((congrArg 𝒢.obj.map hnat).trans
                          (𝒢.obj.map_comp (adj_ov.unit.app V₁.unop).op v)) } }
            naturality := fun {𝒢₁ 𝒢₂} β => by
              apply CategoryTheory.Sheaf.hom_ext
              ext V x
              exact congrArg (fun m => m x)
                (β.hom.naturality (adj_ov.unit.app V.unop).op).symm }
        left_triangle := by
          ext ℱ V x
          have htri : (adj_ov.counit.app (M_j.obj V.unop)).op ≫
              (M_j.map (adj_ov.unit.app V.unop)).op = 𝟙 (Opposite.op (M_j.obj V.unop)) :=
            (CategoryTheory.op_comp (f := M_j.map (adj_ov.unit.app V.unop))
              (g := adj_ov.counit.app (M_j.obj V.unop))).symm.trans
              ((congrArg Quiver.Hom.op (adj_ov.left_triangle_components V.unop)).trans
                (CategoryTheory.op_id (X := M_j.obj V.unop)))
          have hmap := (ℱ.obj.map_comp (adj_ov.counit.app (M_j.obj V.unop)).op
            (M_j.map (adj_ov.unit.app V.unop)).op).symm.trans
            ((congrArg ℱ.obj.map htri).trans (ℱ.obj.map_id _))
          exact congrArg (fun m => m x) hmap
        right_triangle := by
          ext 𝒢 W x
          have htri : (B_j.map (adj_ov.counit.app W.unop)).op ≫
              (adj_ov.unit.app (B_j.obj W.unop)).op = 𝟙 (Opposite.op (B_j.obj W.unop)) :=
            (CategoryTheory.op_comp (f := adj_ov.unit.app (B_j.obj W.unop))
              (g := B_j.map (adj_ov.counit.app W.unop))).symm.trans
              ((congrArg Quiver.Hom.op (adj_ov.right_triangle_components W.unop)).trans
                (CategoryTheory.op_id (X := B_j.obj W.unop)))
          have hmap := (𝒢.obj.map_comp (B_j.map (adj_ov.counit.app W.unop)).op
            (adj_ov.unit.app (B_j.obj W.unop)).op).symm.trans
            ((congrArg 𝒢.obj.map htri).trans (𝒢.obj.map_id _))
          exact congrArg (fun m => m x) hmap }

  have hSliceEval : ∀ (G_R : CategoryTheory.Sheaf S_R.smallEtaleTopology AddCommGrpCat.{u})
      (G_Ω : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback j_Rbar G_R G_Ω →
      Nonempty (G_Ω.H 0 ≃+ ↥(G_R.obj.obj (Opposite.op U_Ω))) := by
    intro G_R G_Ω ⟨hc_B, hr_B, ⟨iso_G⟩⟩
    let _ := hc_B
    let _ := hr_B
    let adj_sh := hAdjSlice hc_B
    let e_slice := CategoryTheory.Adjunction.leftAdjointUniq
      (B_j.sheafAdjunctionContinuous AddCommGrpCat.{u} S_R.smallEtaleTopology S_Ω.smallEtaleTopology)
      adj_sh
    let e_sh : G_Ω ≅ R_j.obj G_R := iso_G.symm ≪≫ e_slice.app G_R
    let e_sec : G_Ω.obj.obj (Opposite.op T_idΩ) ≅ G_R.obj.obj (Opposite.op U_Ω) :=
      (((CategoryTheory.evaluation _ _).obj (Opposite.op T_idΩ)).mapIso
        ((CategoryTheory.sheafToPresheaf _ _).mapIso e_sh)) ≪≫
        G_R.obj.mapIso ι₀.symm.op
    exact ⟨(CategoryTheory.Sheaf.H.equiv₀ G_Ω hT_idΩ).trans (addEquivOfIso e_sec)⟩

  
  
  
  have hSpecK_all : ∀ (K : Type u) [Field K] [IsAlgClosed K],
      let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
      (∀ (A : AddCommGrpCat.{u}),
        Nonempty ((((CategoryTheory.constantSheaf S_K.smallEtaleTopology AddCommGrpCat.{u}).obj A).H 0) ≃+ ↥A) ∧
        ∀ (T_K : S_K.Etale) (hT_K : CategoryTheory.Limits.IsTerminal T_K),
          Function.Bijective
            ((CategoryTheory.constantSheafAdj S_K.smallEtaleTopology AddCommGrpCat.{u} hT_K).unit.app A)) ∧
      (∀ (ℱ : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u}),
        Subsingleton (ℱ.H 0) → CategoryTheory.Limits.IsZero ℱ) ∧
      (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u}}
          (ψ : ℱ₁ ⟶ ℱ₂) (T_K : S_K.Etale) (_hT_K : CategoryTheory.Limits.IsTerminal T_K),
        Function.Surjective (ψ.hom.app (Opposite.op T_K)) → CategoryTheory.Epi ψ) := by
    intro K _ _ S_K
    have hProps := hAlgSiteProps S_K fun Z p _ z₀ => by
      obtain ⟨σ, hσ_sec, hσ_pt⟩ := hAlgLift K Z p z₀
      exact ⟨σ, (⊥ : PrimeSpectrum K), hσ_sec, hσ_pt⟩
    refine ⟨fun A => ⟨?_, fun T_K hT_K => (hPillar1 S_K A T_K hT_K).1⟩, hProps.1, hProps.2⟩
    let T₀_K := termObj S_K
    let hT₀_K := isTermObj S_K
    have hBij₀ := (hPillar1 S_K A T₀_K hT₀_K).1
    let e_unit : ↥A ≃+ ↥(((CategoryTheory.constantSheaf S_K.smallEtaleTopology AddCommGrpCat.{u}).obj A).obj.obj
        (Opposite.op T₀_K)) :=
      AddEquiv.ofBijective
        (AddCommGrpCat.Hom.hom
          ((CategoryTheory.constantSheafAdj S_K.smallEtaleTopology AddCommGrpCat.{u} hT₀_K).unit.app A))
        hBij₀
    exact ⟨(CategoryTheory.Sheaf.H.equiv₀ _ hT₀_K).trans e_unit.symm⟩

  refine ⟨hSpecK_all, ?_, ?_⟩
  · 
    intro T_R hT_R
    refine ⟨fun A => ?_, fun {ℱ₁ ℱ₂} π _ => ?_⟩
    · let _ : IsDomain R_bar := hDom
      let _ : Nonempty ↥U_Ω.left := inferInstanceAs (Nonempty ↥S_Ω)
      let _ : PreconnectedSpace ↥U_Ω.left := inferInstanceAs (PreconnectedSpace ↥S_Ω)
      exact (hPillar1 S_R A T_R hT_R).2 U_Ω
    · exact hEpiSurjOfClosedLift S_R (IsLocalRing.closedPoint R_bar)
        (fun Z p _ z₀ hz₀ => ⟨(hHensLift R_bar Z p z₀ hz₀).choose,
          (hHensLift R_bar Z p z₀ hz₀).choose_spec.1⟩)
        T_R hT_R π
  · 
    have hEpiSurj_Ω : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}}
        (π : ℱ₁ ⟶ ℱ₂) [CategoryTheory.Epi π],
        Function.Surjective (π.hom.app (Opposite.op T_idΩ)) := by
      intro ℱ₁ ℱ₂ π _
      exact hEpiSurjOfClosedLift S_Ω (⊥ : PrimeSpectrum Ω)
        (fun Z p _ z₀ _ => ⟨(hAlgLift Ω Z p z₀).choose, (hAlgLift Ω Z p z₀).choose_spec.1⟩)
        T_idΩ hT_idΩ π
    intro G_R
    refine ⟨fun G_Ω hPb => hSliceEval G_R G_Ω hPb, fun {F_R} ψ => ⟨?_, ?_⟩⟩
    · intro hInj H_η hPb_ker
      obtain ⟨e_ker⟩ := hSliceEval (CategoryTheory.Limits.kernel ψ) H_η hPb_ker
      let ι_k := CategoryTheory.Limits.kernel.ι ψ
      let _ : CategoryTheory.Limits.PreservesLimits
          (CategoryTheory.sheafToPresheaf S_R.smallEtaleTopology AddCommGrpCat.{u}) :=
        (CategoryTheory.sheafificationAdjunction S_R.smallEtaleTopology
          AddCommGrpCat.{u}).rightAdjoint_preservesLimits
      let _ : CategoryTheory.Mono
          ((CategoryTheory.sheafToPresheaf S_R.smallEtaleTopology AddCommGrpCat.{u}).map ι_k) :=
        (CategoryTheory.sheafToPresheaf S_R.smallEtaleTopology AddCommGrpCat.{u}).map_mono ι_k
      let _ : CategoryTheory.Mono
          (((CategoryTheory.evaluation _ _).obj (Opposite.op U_Ω)).map ι_k.hom) :=
        ((CategoryTheory.evaluation _ _).obj (Opposite.op U_Ω)).map_mono _
      have hInj_ι : Function.Injective (ι_k.hom.app (Opposite.op U_Ω)) :=
        (AddCommGrpCat.mono_iff_injective (ι_k.hom.app (Opposite.op U_Ω))).mp inferInstance
      have _ : Subsingleton ↥((CategoryTheory.Limits.kernel ψ).obj.obj (Opposite.op U_Ω)) := by
        refine ⟨fun x₁ x₂ => hInj_ι (hInj ?_)⟩
        have hc₁ : (ι_k.hom.app (Opposite.op U_Ω) ≫ ψ.hom.app (Opposite.op U_Ω)) x₁ = 0 := by
          change ((ι_k ≫ ψ).hom.app (Opposite.op U_Ω)) x₁ = 0
          rw [CategoryTheory.Limits.kernel.condition]; rfl
        have hc₂ : (ι_k.hom.app (Opposite.op U_Ω) ≫ ψ.hom.app (Opposite.op U_Ω)) x₂ = 0 := by
          change ((ι_k ≫ ψ).hom.app (Opposite.op U_Ω)) x₂ = 0
          rw [CategoryTheory.Limits.kernel.condition]; rfl
        exact hc₁.trans hc₂.symm
      have _ : Subsingleton (H_η.H 0) := e_ker.toEquiv.subsingleton
      exact (hSpecK_all Ω).2.1 H_η inferInstance
    · intro C_η ⟨hc_B, hr_B, ⟨iso_C⟩⟩ hZero_C
      let _ := hc_B
      let _ := hr_B
      let adj_sh := hAdjSlice hc_B
      let _ : R_j.IsLeftAdjoint := adj_sh.isLeftAdjoint
      let _ : R_j.PreservesZeroMorphisms :=
        CategoryTheory.Functor.preservesZeroMorphisms_of_isLeftAdjoint R_j
      let _ : CategoryTheory.Limits.PreservesColimits R_j :=
        adj_sh.leftAdjoint_preservesColimits
      let e_slice := CategoryTheory.Adjunction.leftAdjointUniq
        (B_j.sheafAdjunctionContinuous AddCommGrpCat.{u} S_R.smallEtaleTopology S_Ω.smallEtaleTopology)
        adj_sh
      let e_cok : C_η ≅ CategoryTheory.Limits.cokernel (R_j.map ψ) :=
        iso_C.symm ≪≫ e_slice.app (CategoryTheory.Limits.cokernel ψ) ≪≫
          CategoryTheory.Limits.PreservesCokernel.iso R_j ψ
      have hZero_cok : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel (R_j.map ψ)) :=
        hZero_C.of_iso e_cok.symm
      let _ : CategoryTheory.Epi (R_j.map ψ) :=
        (CategoryTheory.Preadditive.epi_iff_isZero_cokernel (R_j.map ψ)).mpr hZero_cok
      have hSurj_Tid : Function.Surjective ((R_j.map ψ).hom.app (Opposite.op T_idΩ)) :=
        hEpiSurj_Ω (R_j.map ψ)
      have hBij_F : Function.Bijective (F_R.obj.map ι₀.hom.op) := by
        let _ : CategoryTheory.IsIso (F_R.obj.map ι₀.hom.op) :=
          F_R.obj.map_isIso ι₀.op.hom
        exact (CategoryTheory.ConcreteCategory.isIso_iff_bijective _).mp inferInstance
      have hNat : F_R.obj.map ι₀.hom.op ≫ (R_j.map ψ).hom.app (Opposite.op T_idΩ) =
          ψ.hom.app (Opposite.op U_Ω) ≫ G_R.obj.map ι₀.hom.op :=
        ψ.hom.naturality ι₀.hom.op
      intro y
      obtain ⟨z, hz⟩ := hSurj_Tid (G_R.obj.map ι₀.hom.op y)
      obtain ⟨x, rfl⟩ := hBij_F.2 z
      refine ⟨x, ?_⟩
      have hx_eq : G_R.obj.map ι₀.hom.op (ψ.hom.app (Opposite.op U_Ω) x) =
          G_R.obj.map ι₀.hom.op y := by
        have h1 := congrArg (fun m => m x) hNat.symm
        exact h1.trans hz
      have hG_inv_id : G_R.obj.map ι₀.hom.op ≫ G_R.obj.map ι₀.inv.op = 𝟙 _ :=
        (G_R.obj.map_comp ι₀.hom.op ι₀.inv.op).symm.trans
          ((congrArg G_R.obj.map
            ((CategoryTheory.op_comp (f := ι₀.inv) (g := ι₀.hom)).symm.trans
              ((congrArg Quiver.Hom.op ι₀.inv_hom_id).trans
                (CategoryTheory.op_id (X := M_j.obj T_idΩ))))).trans
            (G_R.obj.map_id _))
      have hinv := congrArg (G_R.obj.map ι₀.inv.op) hx_eq
      exact (congrArg (fun m => m (ψ.hom.app (Opposite.op U_Ω) x)) hG_inv_id).symm.trans
        (hinv.trans (congrArg (fun m => m y) hG_inv_id))

theorem weil_cosp_curve_pointed_etale_torsion_basis_lift (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G₀ : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))).smallEtaleTopology
      AddCommGrpCat.{u})
    (hTors : ℓ • CategoryTheory.CategoryStruct.id G₀ = 0)
    (H₀ : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology AddCommGrpCat.{u})
    (hPb₀ : WeilIsEtaleSheafPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k)))) G₀ H₀)
    (hFin₀ : Finite (H₀.H 0)) :
    let U₀ := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U₀ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k)))
    ∃ (M₀ : AddCommGrpCat.{u}) (_ : Finite ↥M₀)
      (W₀ : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsAffine W₀)
      (_ : AlgebraicGeometry.IsIntegral W₀)
      (w₀ : W₀ ⟶ U₀) (_ : AlgebraicGeometry.Etale w₀)
      (s_W : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W₀)
      (G_W : CategoryTheory.Sheaf W₀.smallEtaleTopology AddCommGrpCat.{u})
      (Φ : (CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}).obj M₀ ⟶ G_W),
      (ℓ • CategoryTheory.CategoryStruct.id M₀ = 0 ∧ Nat.card ↥M₀ = Nat.card (H₀.H 0)) ∧
      s_W ≫ w₀ = s₀ ∧
      WeilIsEtaleSheafPullback w₀ G₀ G_W ∧
      ∀ (K_s : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback s_W (CategoryTheory.Limits.kernel Φ) K_s →
        CategoryTheory.Limits.IsZero K_s :=
by
  classical
  intro U₀ s₀

  
  have hShrink : ∀ (W_prod : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W_prod]
      (w_prod : W_prod ⟶ U₀) [AlgebraicGeometry.Etale w_prod]
      (s_prod : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W_prod),
      s_prod ≫ w_prod = s₀ →
      ∃ (W₀ : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsAffine W₀)
        (_ : AlgebraicGeometry.IsIntegral W₀)
        (j₀ : W₀ ⟶ W_prod) (_ : AlgebraicGeometry.Etale j₀)
        (s_W : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W₀),
        s_W ≫ j₀ = s_prod := by
    dsimp only [U₀, s₀]
    clear G₀ hTors H₀ hPb₀ hFin₀ U₀ s₀
    intro W_prod _ w_prod _ s_prod hs_prod
    let P := Polynomial k
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let U_P := AlgebraicGeometry.Spec (CommRingCat.of P)
    let e_spec : W_prod ≅ AlgebraicGeometry.Spec (W_prod.presheaf.obj (Opposite.op ⊤)) :=
      W_prod.isoSpec
    let B_cat : CommRingCat.{u} := W_prod.presheaf.obj (Opposite.op ⊤)
    let B : Type u := ↥B_cat
    let w_B : AlgebraicGeometry.Spec B_cat ⟶ U_P := e_spec.inv ≫ w_prod
    have hw_B_et : AlgebraicGeometry.Etale w_B := by dsimp [w_B]; infer_instance
    let s_B : S_k ⟶ AlgebraicGeometry.Spec B_cat := s_prod ≫ e_spec.hom
    have hs_B : s_B ≫ w_B =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k))) := by
      dsimp [s_B, w_B]
      rw [Category.assoc, ← Category.assoc e_spec.hom, e_spec.hom_inv_id, Category.id_comp, hs_prod]
    let φ_PB : CommRingCat.of P ⟶ B_cat := AlgebraicGeometry.Spec.preimage w_B
    have hφ_map : AlgebraicGeometry.Spec.map φ_PB = w_B := AlgebraicGeometry.Spec.map_preimage w_B
    let χ_Bk : B_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage s_B
    have hχ_map : AlgebraicGeometry.Spec.map χ_Bk = s_B := AlgebraicGeometry.Spec.map_preimage s_B
    have hcomp_ev : χ_Bk.hom.comp φ_PB.hom = Polynomial.evalRingHom (0 : k) := by
      have hmap : AlgebraicGeometry.Spec.map (φ_PB ≫ χ_Bk) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k))) := by
        rw [AlgebraicGeometry.Spec.map_comp, hφ_map, hχ_map, hs_B]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hmap)

    letI : Algebra P B := φ_PB.hom.toAlgebra
    have hAlgEt_PB : Algebra.Etale P B := by
      rw [← RingHom.etale_algebraMap]
      change φ_PB.hom.Etale
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (hφ_map.symm ▸ hw_B_et)
    haveI : Algebra.Etale P B := hAlgEt_PB
    haveI : IsNoetherianRing P := Polynomial.isNoetherianRing
    haveI : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing P B

    let p₀ : Ideal B := RingHom.ker χ_Bk.hom
    have hSurj_χ : Function.Surjective χ_Bk.hom := by
      intro c
      refine ⟨φ_PB.hom (Polynomial.C c), ?_⟩
      change (χ_Bk.hom.comp φ_PB.hom) (Polynomial.C c) = c
      rw [hcomp_ev]
      exact Polynomial.eval_C
    have hp₀_max : p₀.IsMaximal := RingHom.ker_isMaximal_of_surjective χ_Bk.hom hSurj_χ
    have : p₀.IsPrime := hp₀_max.isPrime

    let ev₀_P : P →+* k := Polynomial.evalRingHom (0 : k)
    let m₀ : Ideal P := RingHom.ker ev₀_P
    have hSurj_ev₀ : Function.Surjective ev₀_P := fun c => ⟨Polynomial.C c, Polynomial.eval_C⟩
    have hm₀_max : m₀.IsMaximal := RingHom.ker_isMaximal_of_surjective ev₀_P hSurj_ev₀
    have : m₀.IsPrime := hm₀_max.isPrime
    have hp₀_comap : p₀.comap (algebraMap P B) = m₀ := by
      ext q
      simp only [Ideal.mem_comap, p₀, m₀, RingHom.mem_ker]
      change (χ_Bk.hom.comp φ_PB.hom) q = 0 ↔ ev₀_P q = 0
      rw [hcomp_ev]

    have hPolyFactor : ∀ (d : ℕ) (g : P), g.natDegree ≤ d → g ≠ 0 →
        ∃ (N : ℕ) (g₀ : P), g₀ ∉ m₀ ∧ g = Polynomial.X ^ N * g₀ := by
      intro d
      induction d with
      | zero =>
        intro g hdeg hg0
        refine ⟨0, g, ?_, (one_mul g).symm⟩
        have hgC : g = Polynomial.C (g.coeff 0) := Polynomial.eq_C_of_natDegree_le_zero hdeg
        intro hmem
        have hc0 : g.coeff 0 = 0 := by
          have h1 : Polynomial.eval 0 g = 0 := hmem
          rwa [hgC, Polynomial.eval_C] at h1
        exact hg0 (hgC.trans (by rw [hc0, map_zero]))
      | succ d ih =>
        intro g hdeg hg0
        by_cases hmem : g ∈ m₀
        · have hdvd : Polynomial.X ∣ g := by
            have hroot : g.IsRoot 0 := hmem
            simpa using (Polynomial.dvd_iff_isRoot (p := g) (a := (0 : k))).mpr hroot
          rcases hdvd with ⟨g₁, rfl⟩
          have hg₁_ne : g₁ ≠ 0 := right_ne_zero_of_mul hg0
          have hdeg₁ : g₁.natDegree ≤ d := by
            have hmul := Polynomial.natDegree_mul Polynomial.X_ne_zero hg₁_ne
            rw [Polynomial.natDegree_X] at hmul
            omega
          obtain ⟨N, g₀, hg₀_mem, rfl⟩ := ih g₁ hdeg₁ hg₁_ne
          exact ⟨N + 1, g₀, hg₀_mem, by ring⟩
        · exact ⟨0, g, hmem, (one_mul g).symm⟩

    let V := Localization.AtPrime m₀
    have hm₀_nzd : m₀.primeCompl ≤ nonZeroDivisors P :=
      fun s hs => mem_nonZeroDivisors_of_ne_zero (fun h0 => hs (h0 ▸ m₀.zero_mem))
    haveI : IsDomain V := IsLocalization.isDomain_localization hm₀_nzd
    let ϖ : V := algebraMap P V Polynomial.X
    have hϖ_ne : ϖ ≠ 0 := by
      intro h0
      have hinj : Function.Injective (algebraMap P V) :=
        IsLocalization.injective V hm₀_nzd
      exact Polynomial.X_ne_zero (hinj (h0.trans (map_zero _).symm))
    have hev₀_units : ∀ y : m₀.primeCompl, IsUnit (ev₀_P y.1) := by
      intro ⟨y, hy⟩
      exact Ne.isUnit (fun h0 => hy h0)
    let ev_V : V →+* k := IsLocalization.lift (M := m₀.primeCompl) hev₀_units
    have hev_V_surj : Function.Surjective ev_V := by
      intro c
      refine ⟨algebraMap P V (Polynomial.C c), ?_⟩
      rw [IsLocalization.lift_eq]
      exact Polynomial.eval_C
    have hker_ev_V : RingHom.ker ev_V = Ideal.span {ϖ} := by
      apply le_antisymm
      · intro v hv
        obtain ⟨⟨p, s⟩, hps⟩ := IsLocalization.surj m₀.primeCompl v
        have hps' : v * algebraMap P V s.1 = algebraMap P V p := hps
        have hp0 : ev₀_P p = 0 := by
          have h1 := congrArg ev_V hps'
          rw [map_mul, RingHom.mem_ker.mp hv, zero_mul, IsLocalization.lift_eq] at h1
          exact h1.symm
        have hdvd : Polynomial.X ∣ p := by
          have hroot : p.IsRoot 0 := hp0
          simpa using (Polynomial.dvd_iff_isRoot (p := p) (a := (0 : k))).mpr hroot
        rcases hdvd with ⟨p₁, rfl⟩
        obtain ⟨u_s, hu_s⟩ := IsLocalization.map_units V s
        have hv_eq : v = ϖ * (algebraMap P V p₁ * (↑u_s⁻¹ : V)) := by
          apply mul_right_cancel₀ u_s.ne_zero
          calc
            v * (u_s : V) = algebraMap P V (Polynomial.X * p₁) := by rw [hu_s, hps']
            _ = ϖ * algebraMap P V p₁ := map_mul (algebraMap P V) Polynomial.X p₁
            _ = ϖ * (algebraMap P V p₁ * (↑u_s⁻¹ : V)) * (u_s : V) := by
              rw [mul_assoc, mul_assoc, Units.inv_mul, mul_one]
        rw [hv_eq]
        exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_singleton ϖ))
      · rw [Ideal.span_le]
        rintro _ ⟨rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker]
        dsimp [ϖ, ev_V]
        rw [IsLocalization.lift_eq]
        exact Polynomial.eval_X
    have hMaxϖ : (Ideal.span {ϖ}).IsMaximal :=
      hker_ev_V ▸ RingHom.ker_isMaximal_of_surjective ev_V hev_V_surj

    have hDomOfBV : ∀ (V₀ : Type u) [CommRing V₀]
        (ϖ₀ : V₀) (_hMax_ϖ₀ : (Ideal.span {ϖ₀}).IsMaximal)
        (K₀ : Type u) [Field K₀] [Algebra V₀ K₀]
        (_hInj_VK : Function.Injective (algebraMap V₀ K₀))
        (_hϖ₀_ne : algebraMap V₀ K₀ ϖ₀ ≠ 0)
        (_hClear : ∀ q : K₀,
          ∃ (n : ℕ) (v : V₀), (algebraMap V₀ K₀ ϖ₀) ^ n * q = algebraMap V₀ K₀ v)
        (B_V : Type u) [CommRing B_V] [Algebra V₀ B_V] [Algebra.Etale V₀ B_V]
        (b_to_BV : B →+* B_V) (bv_to_Bloc : B_V →+* Localization.AtPrime p₀),
        (∀ b : B, bv_to_Bloc (b_to_BV b) = algebraMap B (Localization.AtPrime p₀) b) →
        IsDomain (Localization.AtPrime p₀) := by
      intro V₀ _ ϖ₀ hMax_ϖ₀ K₀ _ _ hInj_VK hϖ_KP_ne hClear B_V _ _ _ b_to_BV bv_to_Bloc hcomp_loc
      haveI : (Ideal.span {ϖ₀}).IsMaximal := hMax_ϖ₀
      letI : Field (V₀ ⧸ Ideal.span {ϖ₀}) := Ideal.Quotient.field (Ideal.span {ϖ₀})
      haveI : Module.Flat V₀ B_V := Algebra.Smooth.flat V₀ B_V
      haveI : Algebra.Etale K₀ (TensorProduct V₀ K₀ B_V) := Algebra.Etale.baseChange V₀ B_V K₀
      let ι_K : B_V →ₐ[V₀] TensorProduct V₀ K₀ B_V := Algebra.TensorProduct.includeRight
      have hι_K_inj : Function.Injective ι_K := by
        have hlT := Module.Flat.lTensor_preserves_injective_linearMap (M := B_V)
          (Algebra.ofId V₀ K₀).toLinearMap hInj_VK
        intro x y hxy
        let symV := TensorProduct.comm V₀ B_V V₀
        let symK := TensorProduct.comm V₀ B_V K₀
        let lidV := TensorProduct.lid V₀ B_V
        have hcomm_x : symK (LinearMap.lTensor B_V
            (Algebra.ofId V₀ K₀).toLinearMap (symV.symm (lidV.symm x))) = ι_K x := by
          simp [symK, symV, lidV, ι_K]
        have hcomm_y : symK (LinearMap.lTensor B_V
            (Algebra.ofId V₀ K₀).toLinearMap (symV.symm (lidV.symm y))) = ι_K y := by
          simp [symK, symV, lidV, ι_K]
        apply lidV.symm.injective
        apply symV.symm.injective
        apply hlT
        apply symK.injective
        rw [hcomm_x, hcomm_y, hxy]

      have hSmulMul : ∀ (r : V₀) (z : TensorProduct V₀ K₀ B_V),
          r • z = ((algebraMap V₀ K₀ r) ⊗ₜ[V₀] (1 : B_V)) * z := by
        intro r z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul q c₀ =>
          rw [TensorProduct.smul_tmul', Algebra.TensorProduct.tmul_mul_tmul,
            Algebra.smul_def, one_mul]
        | add z₁ z₂ ih₁ ih₂ => rw [smul_add, mul_add, ih₁, ih₂]

      have hClearEK : ∀ z : TensorProduct V₀ K₀ B_V,
          ∃ (n : ℕ) (c : B_V), (ϖ₀ ^ n) • z = ι_K c := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => exact ⟨0, 0, by simp⟩
        | tmul q c₀ =>
          obtain ⟨n, v, hv⟩ := hClear q
          refine ⟨n, v • c₀, ?_⟩
          rw [TensorProduct.smul_tmul', Algebra.smul_def, map_pow, hv,
            ← mul_one ((algebraMap V₀ K₀) v), ← Algebra.smul_def, TensorProduct.smul_tmul]
          rfl
        | add z₁ z₂ ih₁ ih₂ =>
          obtain ⟨n₁, c₁, hc₁⟩ := ih₁
          obtain ⟨n₂, c₂, hc₂⟩ := ih₂
          refine ⟨n₁ + n₂, (ϖ₀ ^ n₂) • c₁ + (ϖ₀ ^ n₁) • c₂, ?_⟩
          have h1 : (ϖ₀ ^ (n₁ + n₂)) • z₁ = ι_K ((ϖ₀ ^ n₂) • c₁) := by
            rw [pow_add, mul_comm (ϖ₀ ^ n₁), mul_smul, hc₁, map_smul]
          have h2 : (ϖ₀ ^ (n₁ + n₂)) • z₂ = ι_K ((ϖ₀ ^ n₁) • c₂) := by
            rw [pow_add, mul_smul, hc₂, map_smul]
          rw [smul_add, h1, h2, map_add]

      haveI : Algebra.Etale (V₀ ⧸ Ideal.span {ϖ₀})
          (TensorProduct V₀ (V₀ ⧸ Ideal.span {ϖ₀}) B_V) :=
        Algebra.Etale.baseChange V₀ B_V (V₀ ⧸ Ideal.span {ϖ₀})
      have hModZeroOfSq : ∀ c : B_V,
          (∃ w : B_V, c * c = ϖ₀ • w) → ∃ c' : B_V, c = ϖ₀ • c' := by
        rintro c ⟨w, hc_sq⟩
        obtain ⟨I_m, _, L_m, hField_Lm, _, Θ_m, _⟩ :=
          (Algebra.Etale.iff_exists_algEquiv_prod (V₀ ⧸ Ideal.span {ϖ₀})
            (TensorProduct V₀ (V₀ ⧸ Ideal.span {ϖ₀}) B_V)).mp inferInstance
        letI : ∀ i, Field (L_m i) := hField_Lm
        let π_mod : B_V →ₐ[V₀] TensorProduct V₀ (V₀ ⧸ Ideal.span {ϖ₀}) B_V :=
          Algebra.TensorProduct.includeRight
        let eqv_q := TensorProduct.quotTensorEquivQuotSMul B_V (Ideal.span {ϖ₀})
        have heqv_π : ∀ x : B_V, eqv_q (π_mod x) =
            Submodule.Quotient.mk (p := Ideal.span {ϖ₀} • (⊤ : Submodule V₀ B_V)) x := by
          intro x
          change eqv_q ((Ideal.Quotient.mk (Ideal.span {ϖ₀}) 1) ⊗ₜ[V₀] x) = _
          rw [TensorProduct.quotTensorEquivQuotSMul_mk_tmul, one_smul]
        have hπ_sq : π_mod c * π_mod c = 0 := by
          rw [← map_mul]
          apply eqv_q.injective
          rw [map_zero, heqv_π (c * c), Submodule.Quotient.mk_eq_zero, hc_sq]
          exact Submodule.smul_mem_smul (Ideal.subset_span (Set.mem_singleton ϖ₀)) trivial
        have hΘ_sq : Θ_m (π_mod c) * Θ_m (π_mod c) = 0 := by
          rw [← map_mul, hπ_sq, map_zero]
        have hΘ_zero : Θ_m (π_mod c) = 0 := by
          ext i
          exact mul_self_eq_zero.mp (congrFun hΘ_sq i)
        have hπ_zero : π_mod c = 0 := Θ_m.injective (hΘ_zero.trans (map_zero Θ_m).symm)
        have hmem : c ∈ Ideal.span {ϖ₀} • (⊤ : Submodule V₀ B_V) := by
          rw [← Submodule.Quotient.mk_eq_zero, ← heqv_π c, hπ_zero, map_zero]
        let S_ϖ : Submodule V₀ B_V :=
          { carrier := { x : B_V | ∃ c' : B_V, x = ϖ₀ • c' }
            add_mem' := by rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩; exact ⟨a + b, (smul_add ϖ₀ a b).symm⟩
            zero_mem' := ⟨0, (smul_zero ϖ₀).symm⟩
            smul_mem' := by rintro r _ ⟨a, rfl⟩; exact ⟨r • a, smul_comm r ϖ₀ a⟩ }
        have hle_S : Ideal.span {ϖ₀} • (⊤ : Submodule V₀ B_V) ≤ S_ϖ := by
          refine Submodule.smul_le.mpr fun r hr b _ => ?_
          obtain ⟨v, rfl⟩ := Ideal.mem_span_singleton.mp hr
          exact ⟨v • b, mul_smul ϖ₀ v b⟩
        exact hle_S hmem

      have hIdempLift : ∀ (n : ℕ) (e : TensorProduct V₀ K₀ B_V),
          e * e = e →
          (∃ c : B_V, (ϖ₀ ^ n) • e = ι_K c) →
          ∃ c₀ : B_V, ι_K c₀ = e := by
        intro n
        induction n with
        | zero =>
          rintro e _ ⟨c, hc⟩
          rw [pow_zero, one_smul] at hc
          exact ⟨c, hc.symm⟩
        | succ n ih =>
          rintro e he ⟨c, hc⟩
          have hc_sq : c * c = (ϖ₀ ^ (n + 1)) • c := by
            apply hι_K_inj
            rw [map_mul, map_smul, ← hc, hSmulMul, hSmulMul]
            set u_pow : TensorProduct V₀ K₀ B_V :=
              (algebraMap V₀ K₀ (ϖ₀ ^ (n + 1))) ⊗ₜ[V₀] (1 : B_V)
            calc
              (u_pow * e) * (u_pow * e) = u_pow * (u_pow * (e * e)) := by ring
              _ = u_pow * (u_pow * e) := by rw [he]
          have hc_div : ∃ w : B_V, c * c = ϖ₀ • w :=
            ⟨(ϖ₀ ^ n) • c, by rw [hc_sq, pow_succ', mul_smul]⟩
          obtain ⟨c', rfl⟩ := hModZeroOfSq c hc_div
          apply ih e he
          refine ⟨c', ?_⟩
          let u_inv : TensorProduct V₀ K₀ B_V := ((algebraMap V₀ K₀ ϖ₀)⁻¹) ⊗ₜ[V₀] (1 : B_V)
          have hu_cancel : ∀ z : TensorProduct V₀ K₀ B_V, u_inv * (ϖ₀ • z) = z := by
            intro z
            rw [hSmulMul, ← mul_assoc]
            have h1 : u_inv * ((algebraMap V₀ K₀ ϖ₀) ⊗ₜ[V₀] (1 : B_V)) = 1 := by
              dsimp [u_inv]
              change (((algebraMap V₀ K₀ ϖ₀)⁻¹) * (algebraMap V₀ K₀ ϖ₀)) ⊗ₜ[V₀] ((1 : B_V) * 1) =
                1 ⊗ₜ[V₀] 1
              rw [inv_mul_cancel₀ hϖ_KP_ne, mul_one]
            rw [h1, one_mul]
          have hsmul_eq : ϖ₀ • ((ϖ₀ ^ n) • e) = ϖ₀ • (ι_K c') := by
            rw [← mul_smul, ← pow_succ', hc, map_smul]
          calc
            (ϖ₀ ^ n) • e = u_inv * (ϖ₀ • ((ϖ₀ ^ n) • e)) := (hu_cancel _).symm
            _ = u_inv * (ϖ₀ • (ι_K c')) := by rw [hsmul_eq]
            _ = ι_K c' := hu_cancel _

      obtain ⟨I_f, hFin_If, F_f, hField_Ff, hAlg_Ff, Θ_f, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K₀
          (TensorProduct V₀ K₀ B_V)).mp inferInstance
      haveI : Finite I_f := hFin_If
      letI : Fintype I_f := Fintype.ofFinite I_f
      letI : ∀ i, Field (F_f i) := hField_Ff
      letI : ∀ i, Algebra K₀ (F_f i) := hAlg_Ff
      have hex_lift_i : ∀ i : I_f, ∃ e_BV : B_V, ι_K e_BV = Θ_f.symm (Pi.single i 1) := by
        intro i
        obtain ⟨n, c, hc⟩ := hClearEK (Θ_f.symm (Pi.single i 1))
        refine hIdempLift n (Θ_f.symm (Pi.single i 1)) ?_ ⟨c, hc⟩
        rw [← map_mul]
        congr 1
        ext j
        by_cases hj : j = i
        · subst hj; simp
        · simp [Pi.single_eq_of_ne hj]
      choose e_BV he_BV using hex_lift_i
      have hsum_eBV : ∑ i : I_f, e_BV i = 1 := by
        apply hι_K_inj
        rw [map_sum, map_one]
        have h1 : (1 : ∀ i : I_f, F_f i) = ∑ i : I_f, Pi.single i 1 := by
          ext j; simp [Finset.sum_apply]
        calc
          ∑ i : I_f, ι_K (e_BV i) = ∑ i : I_f, Θ_f.symm (Pi.single i 1) := by
            refine Finset.sum_congr rfl fun i _ => he_BV i
          _ = Θ_f.symm (∑ i : I_f, Pi.single i 1) := (map_sum Θ_f.symm _ _).symm
          _ = Θ_f.symm 1 := by rw [← h1]
          _ = 1 := map_one Θ_f.symm

      have hex_i₀ : ∃ i₀ : I_f, IsUnit (bv_to_Bloc (e_BV i₀)) := by
        by_contra! hnot
        have hmem_max : ∀ i : I_f, bv_to_Bloc (e_BV i) ∈
            IsLocalRing.maximalIdeal (Localization.AtPrime p₀) :=
          fun i => (IsLocalRing.mem_maximalIdeal _).mpr (hnot i)
        have h1_mem : (1 : Localization.AtPrime p₀) ∈
            IsLocalRing.maximalIdeal (Localization.AtPrime p₀) := by
          rw [← map_one bv_to_Bloc, ← hsum_eBV, map_sum]
          exact Ideal.sum_mem _ fun i _ => hmem_max i
        exact (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime p₀)).ne_top
          ((Ideal.eq_top_iff_one _).mpr h1_mem)
      obtain ⟨i₀, hu_ei₀⟩ := hex_i₀

      let ψ_B : B →+* F_f i₀ :=
        (Pi.evalRingHom F_f i₀).comp (Θ_f.toRingHom.comp (ι_K.toRingHom.comp b_to_BV))
      have hψ_kill : ∀ b : B, ψ_B b = 0 → algebraMap B (Localization.AtPrime p₀) b = 0 := by
        intro b hb0
        have hprod_EK : ι_K (b_to_BV b * e_BV i₀) = 0 := by
          rw [map_mul, he_BV i₀]
          apply Θ_f.injective
          rw [map_mul, map_zero, AlgEquiv.apply_symm_apply]
          ext j
          by_cases hj : j = i₀
          · subst hj
            change ψ_B b * (Pi.single j (1 : F_f j)) j = 0
            rw [hb0, zero_mul]
          · simp [Pi.single_eq_of_ne hj]
        have hprod_BV : b_to_BV b * e_BV i₀ = 0 :=
          hι_K_inj (hprod_EK.trans (map_zero ι_K).symm)
        have hprod_loc : algebraMap B (Localization.AtPrime p₀) b * bv_to_Bloc (e_BV i₀) = 0 := by
          have h1 := congrArg bv_to_Bloc hprod_BV
          rw [map_mul, map_zero, hcomp_loc b] at h1
          exact h1
        obtain ⟨u_e, hu_e⟩ := hu_ei₀
        rw [← hu_e] at hprod_loc
        exact (Units.mul_left_eq_zero u_e).mp hprod_loc

      have hψ_units : ∀ y : p₀.primeCompl, IsUnit (ψ_B y.1) := by
        intro ⟨y, hy⟩
        refine Ne.isUnit (fun hy0 => ?_)
        have hloc0 : algebraMap B (Localization.AtPrime p₀) y = 0 := hψ_kill y hy0
        have hu_y : IsUnit (algebraMap B (Localization.AtPrime p₀) y) :=
          IsLocalization.map_units (Localization.AtPrime p₀) (⟨y, hy⟩ : p₀.primeCompl)
        exact not_isUnit_zero (hloc0 ▸ hu_y)

      let ψ_loc : Localization.AtPrime p₀ →+* F_f i₀ :=
        IsLocalization.lift (M := p₀.primeCompl) hψ_units
      have hψ_loc_inj : Function.Injective ψ_loc := by
        rw [injective_iff_map_eq_zero]
        intro z hz
        obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj p₀.primeCompl z
        have hbs' : z * algebraMap B (Localization.AtPrime p₀) s.1 =
            algebraMap B (Localization.AtPrime p₀) b := hbs
        have hb0 : ψ_B b = 0 := by
          have h1 := congrArg ψ_loc hbs'
          rw [map_mul, hz, zero_mul, IsLocalization.lift_eq] at h1
          exact h1.symm
        have hloc_b0 : algebraMap B (Localization.AtPrime p₀) b = 0 := hψ_kill b hb0
        rw [hloc_b0] at hbs'
        obtain ⟨u_s, hu_s⟩ := IsLocalization.map_units (Localization.AtPrime p₀) s
        rw [← hu_s] at hbs'
        exact (Units.mul_left_eq_zero u_s).mp hbs'
      exact Function.Injective.isDomain ψ_loc hψ_loc_inj

    let K_P := FractionRing P
    have hm₀_units_KP : ∀ y : m₀.primeCompl, IsUnit (algebraMap P K_P y.1) := by
      intro ⟨y, hy⟩
      have hy_ne : y ≠ 0 := fun h0 => hy (h0 ▸ m₀.zero_mem)
      exact Ne.isUnit (fun h0 =>
        hy_ne (IsFractionRing.injective P K_P (h0.trans (map_zero _).symm)))
    let v_to_KP : V →+* K_P := IsLocalization.lift (M := m₀.primeCompl) hm₀_units_KP
    have hv_to_KP_inj : Function.Injective v_to_KP := by
      rw [injective_iff_map_eq_zero]
      intro v hv0
      obtain ⟨⟨p, s⟩, hps⟩ := IsLocalization.surj m₀.primeCompl v
      have hps' : v * algebraMap P V s.1 = algebraMap P V p := hps
      have hp0_KP : algebraMap P K_P p = 0 := by
        have h1 := congrArg v_to_KP hps'
        rw [map_mul, hv0, zero_mul, IsLocalization.lift_eq] at h1
        exact h1.symm
      have hp0 : p = 0 := IsFractionRing.injective P K_P (hp0_KP.trans (map_zero _).symm)
      rw [hp0, map_zero] at hps'
      obtain ⟨u_s, hu_s⟩ := IsLocalization.map_units V s
      rw [← hu_s] at hps'
      exact (Units.mul_left_eq_zero u_s).mp hps'
    have hϖ_KP_ne : v_to_KP ϖ ≠ 0 :=
      fun h0 => hϖ_ne (hv_to_KP_inj (h0.trans (map_zero v_to_KP).symm))
    have hClearKP : ∀ q : K_P, ∃ (n : ℕ) (v : V), (v_to_KP ϖ) ^ n * q = v_to_KP v := by
      intro q
      obtain ⟨⟨p₁, s₁⟩, hqs⟩ := IsLocalization.surj (nonZeroDivisors P) q
      have hs₁_ne : (s₁ : P) ≠ 0 := nonZeroDivisors.ne_zero s₁.2
      obtain ⟨n, g₀, hg₀_not_mem, hs₁_eq⟩ := hPolyFactor (s₁ : P).natDegree s₁ (le_refl _) hs₁_ne
      obtain ⟨u_g₀, hu_g₀⟩ := IsLocalization.map_units V (⟨g₀, hg₀_not_mem⟩ : m₀.primeCompl)
      have hX_eq : v_to_KP ϖ = algebraMap P K_P Polynomial.X := by
        dsimp [ϖ, v_to_KP]
        exact IsLocalization.lift_eq hm₀_units_KP Polynomial.X
      have hg₀_eq : v_to_KP (u_g₀ : V) = algebraMap P K_P g₀ := by
        rw [hu_g₀]
        exact IsLocalization.lift_eq hm₀_units_KP g₀
      refine ⟨n, algebraMap P V p₁ * (↑u_g₀⁻¹ : V), ?_⟩
      calc
        (v_to_KP ϖ) ^ n * q
          = (v_to_KP ϖ) ^ n * q * (v_to_KP (u_g₀ : V) * v_to_KP (↑u_g₀⁻¹ : V)) := by
            rw [← map_mul, Units.mul_inv, map_one, mul_one]
        _ = (q * algebraMap P K_P s₁.1) * v_to_KP (↑u_g₀⁻¹ : V) := by
            rw [hX_eq, hg₀_eq, hs₁_eq, map_mul, map_pow]
            ring
        _ = v_to_KP (algebraMap P V p₁ * (↑u_g₀⁻¹ : V)) := by
            rw [hqs, map_mul]
            congr 1
            exact (IsLocalization.lift_eq hm₀_units_KP p₁).symm

    have hm₀_units_Bloc : ∀ y : m₀.primeCompl,
        IsUnit ((algebraMap B (Localization.AtPrime p₀)).comp (algebraMap P B) y.1) := by
      intro ⟨y, hy⟩
      have hy_p₀ : algebraMap P B y ∉ p₀ := fun hmem => hy (hp₀_comap ▸ hmem)
      exact IsLocalization.map_units (Localization.AtPrime p₀)
        (⟨algebraMap P B y, hy_p₀⟩ : p₀.primeCompl)
    let v_to_Bloc : V →+* Localization.AtPrime p₀ :=
      IsLocalization.lift (M := m₀.primeCompl) hm₀_units_Bloc
    let v_alg_Bloc : V →ₐ[P] Localization.AtPrime p₀ :=
      { v_to_Bloc with
        commutes' := fun p => by
          dsimp [v_to_Bloc]
          rw [IsLocalization.lift_eq]
          rfl }
    let bv_to_Bloc : TensorProduct P V B →ₐ[P] Localization.AtPrime p₀ :=
      Algebra.TensorProduct.lift v_alg_Bloc
        (IsScalarTower.toAlgHom P B (Localization.AtPrime p₀)) (fun _ _ => Commute.all _ _)
    let b_to_BV : B →+* TensorProduct P V B :=
      (Algebra.TensorProduct.includeRight (R := P) (A := V) (B := B)).toRingHom
    haveI : IsDomain (Localization.AtPrime p₀) :=
      @hDomOfBV V inferInstance ϖ hMaxϖ K_P inferInstance v_to_KP.toAlgebra
        hv_to_KP_inj hϖ_KP_ne hClearKP
        (TensorProduct P V B) inferInstance Algebra.TensorProduct.leftAlgebra
        (Algebra.Etale.baseChange P B V) b_to_BV bv_to_Bloc.toRingHom
        (fun b => by simp [bv_to_Bloc, b_to_BV])

    let K_ker : Ideal B := RingHom.ker (algebraMap B (Localization.AtPrime p₀))
    obtain ⟨S_gen, hS_gen⟩ := Ideal.fg_of_isNoetherianRing K_ker
    have hex_ann : ∀ b ∈ K_ker, ∃ s : p₀.primeCompl, s.1 * b = 0 := by
      intro b hb
      exact (IsLocalization.map_eq_zero_iff p₀.primeCompl (Localization.AtPrime p₀) b).mp hb
    let s_ann : B → B := fun b =>
      if hb : b ∈ K_ker then (Classical.choose (hex_ann b hb)).1 else 1
    have hs_ann_not_mem : ∀ b : B, s_ann b ∉ p₀ := by
      intro b
      dsimp [s_ann]
      split_ifs with hb
      · exact (Classical.choose (hex_ann b hb)).2
      · exact fun h1 => hp₀_max.ne_top ((Ideal.eq_top_iff_one p₀).mpr h1)
    have hs_ann_mul : ∀ b ∈ K_ker, s_ann b * b = 0 := by
      intro b hb
      dsimp [s_ann]
      simp only [hb, ↓reduceDIte]
      exact Classical.choose_spec (hex_ann b hb)
    let f₀ : B := ∏ b ∈ S_gen, s_ann b
    have hf₀_not_mem : f₀ ∉ p₀ := by
      intro hf_mem
      obtain ⟨b, _, hb_mem⟩ := hp₀_max.isPrime.prod_mem_iff.mp hf_mem
      exact hs_ann_not_mem b hb_mem
    have hf₀_ann : ∀ x ∈ K_ker, f₀ * x = 0 := by
      have hle : K_ker ≤ LinearMap.ker (LinearMap.mulLeft B f₀) := by
        rw [← hS_gen, Ideal.span_le]
        intro b hb
        have hb_ker : b ∈ K_ker := hS_gen ▸ Ideal.subset_span hb
        obtain ⟨q_prod, hq_prod⟩ := Finset.dvd_prod_of_mem s_ann hb
        change f₀ * b = 0
        calc
          f₀ * b = (s_ann b * q_prod) * b := by dsimp [f₀]; rw [hq_prod]
          _ = q_prod * (s_ann b * b) := by ring
          _ = 0 := by rw [hs_ann_mul b hb_ker, mul_zero]
      intro x hx
      exact hle hx

    have hf₀_unit_loc : IsUnit (algebraMap B (Localization.AtPrime p₀) f₀) :=
      IsLocalization.map_units (Localization.AtPrime p₀) (⟨f₀, hf₀_not_mem⟩ : p₀.primeCompl)
    let ι_away : Localization.Away f₀ →+* Localization.AtPrime p₀ :=
      IsLocalization.Away.lift f₀ hf₀_unit_loc
    have hι_away_inj : Function.Injective ι_away := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨n, a, hna⟩ := IsLocalization.Away.surj f₀ z
      have ha_ker : a ∈ K_ker := by
        rw [RingHom.mem_ker]
        have h1 := congrArg ι_away hna
        rw [map_mul, hz, zero_mul, IsLocalization.Away.lift_eq] at h1
        exact h1.symm
      have hfa0 : f₀ * a = 0 := hf₀_ann a ha_ker
      obtain ⟨u_f, hu_f⟩ := IsLocalization.Away.algebraMap_isUnit (S := Localization.Away f₀) f₀
      refine (Units.mul_left_eq_zero (u_f ^ (n + 1))).mp ?_
      calc
        z * ↑(u_f ^ (n + 1))
          = (z * algebraMap B (Localization.Away f₀) f₀ ^ n) *
              algebraMap B (Localization.Away f₀) f₀ := by
            rw [Units.val_pow_eq_pow_val, hu_f, pow_succ, ← mul_assoc]
        _ = algebraMap B (Localization.Away f₀) (f₀ * a) := by rw [hna, ← map_mul, mul_comm]
        _ = 0 := by rw [hfa0, map_zero]
    haveI : IsDomain (Localization.Away f₀) := Function.Injective.isDomain ι_away hι_away_inj

    let W₀ : AlgebraicGeometry.Scheme.{u} :=
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f₀))
    let j_loc : W₀ ⟶ AlgebraicGeometry.Spec B_cat :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away f₀)))
    let j₀ : W₀ ⟶ W_prod := j_loc ≫ e_spec.inv
    have hj₀_et : AlgebraicGeometry.Etale j₀ := by dsimp [j₀, j_loc]; infer_instance
    have hf₀_unit_k : IsUnit (χ_Bk.hom f₀) :=
      Ne.isUnit (fun h0 => hf₀_not_mem h0)
    let χ_A₀ : CommRingCat.of (Localization.Away f₀) ⟶ CommRingCat.of k :=
      CommRingCat.ofHom (IsLocalization.Away.lift f₀ hf₀_unit_k)
    have hχ_fac : CommRingCat.ofHom (algebraMap B (Localization.Away f₀)) ≫ χ_A₀ = χ_Bk := by
      apply CommRingCat.hom_ext
      ext b
      exact IsLocalization.Away.lift_eq f₀ hf₀_unit_k b
    let s_W : S_k ⟶ W₀ := AlgebraicGeometry.Spec.map χ_A₀
    refine ⟨W₀, inferInstance, inferInstance, j₀, hj₀_et, s_W, ?_⟩
    dsimp [s_W, j₀, j_loc]
    rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hχ_fac, hχ_map]
    dsimp [s_B]
    rw [Category.assoc, e_spec.hom_inv_id, Category.comp_id]

  
  haveI : AlgebraicGeometry.IsAffine U₀ :=
    inferInstanceAs
      (AlgebraicGeometry.IsAffine (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))))
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let J_k := S_k.smallEtaleTopology
  let pt_k : ↥S_k := (⊥ : PrimeSpectrum k)
  let termObj : ∀ Z : AlgebraicGeometry.Scheme.{u}, Z.Etale := fun Z =>
    CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 Z)
      (inferInstance : AlgebraicGeometry.Etale (𝟙 Z))
  let isTermObj : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Limits.IsTerminal (termObj Z) := fun Z =>
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => CategoryTheory.MorphismProperty.Over.homMk W.hom (Category.comp_id W.hom) trivial)
      (fun W m => CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((Category.comp_id m.left).symm.trans (CategoryTheory.MorphismProperty.Over.w m))
        (Subsingleton.elim _ _))
  let T_k : S_k.Etale := termObj S_k
  let hT_k : CategoryTheory.Limits.IsTerminal T_k := isTermObj S_k

  have hS2P_add : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).Additive := by
    clear * -
    intro S
    have : CategoryTheory.Limits.PreservesLimits
        (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
      (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
        AddCommGrpCat.{u}).rightAdjoint_preservesLimits
    have : CategoryTheory.Limits.PreservesBinaryBiproducts
        (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryProducts _
    exact CategoryTheory.Functor.additive_of_preservesBinaryBiproducts _

  
  let M₀ : AddCommGrpCat.{u} := H₀.obj.obj (Opposite.op T_k)
  let eH0_M₀ : H₀.H 0 ≃+ ↥M₀ := CategoryTheory.Sheaf.H.equiv₀ H₀ hT_k
  have hFin_M₀ : Finite ↥M₀ := Finite.of_equiv (H₀.H 0) eH0_M₀.toEquiv
  have hCard_M₀ : Nat.card ↥M₀ = Nat.card (H₀.H 0) := Nat.card_congr eH0_M₀.symm.toEquiv

  have hTors_M₀ : ℓ • CategoryTheory.CategoryStruct.id M₀ = 0 := by
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) s₀ :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) s₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_s₀ : CategoryTheory.Functor U₀.Etale S_k.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ s₀
    rcases hPb₀ with ⟨hc₀, hr₀, ⟨e₀⟩⟩
    let P_s₀ := B_s₀.sheafPullback AddCommGrpCat.{u} U₀.smallEtaleTopology J_k
    let adj_s₀ := B_s₀.sheafAdjunctionContinuous AddCommGrpCat.{u} U₀.smallEtaleTopology J_k
    have : CategoryTheory.Limits.PreservesColimits P_s₀ := adj_s₀.leftAdjoint_preservesColimits
    have : CategoryTheory.Limits.PreservesBinaryBiproducts P_s₀ :=
      CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts P_s₀
    have : P_s₀.Additive := CategoryTheory.Functor.additive_of_preservesBinaryBiproducts P_s₀
    have hTors_Ps₀ : ℓ • CategoryTheory.CategoryStruct.id (P_s₀.obj G₀) = 0 := by
      rw [← P_s₀.map_id, ← P_s₀.map_nsmul, hTors, P_s₀.map_zero]
    have hConj : ∀ n : ℕ, e₀.inv ≫ (n • CategoryTheory.CategoryStruct.id (P_s₀.obj G₀)) ≫ e₀.hom =
        n • CategoryTheory.CategoryStruct.id H₀ := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [succ_nsmul, succ_nsmul, Preadditive.add_comp, Preadditive.comp_add, ih,
          Category.id_comp, Iso.inv_hom_id]
    have hTors_H₀ : ℓ • CategoryTheory.CategoryStruct.id H₀ = 0 := by
      rw [← hConj ℓ, hTors_Ps₀, Limits.zero_comp, Limits.comp_zero]
    have : (CategoryTheory.sheafToPresheaf J_k AddCommGrpCat.{u}).Additive := hS2P_add S_k
    let ev_Tk := CategoryTheory.sheafToPresheaf J_k AddCommGrpCat.{u} ⋙
      (CategoryTheory.evaluation (S_k.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op T_k)
    change ℓ • ev_Tk.map (CategoryTheory.CategoryStruct.id H₀) = 0
    rw [← ev_Tk.map_nsmul, hTors_H₀, ev_Tk.map_zero]

  
  have hMemEtale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (X : S.Etale) (R : CategoryTheory.Sieve X),
      R ∈ S.smallEtaleTopology X ↔
        ∃ (J : Type u) (E : J → S.Etale) (f : ∀ j : J, E j ⟶ X),
          (∀ j : J, R.arrows (f j)) ∧
          (∀ x : ↥X.left, ∃ (j : J) (y : ↥(E j).left), (f j).left.base y = x) := by
    clear * -
    intro S X R
    letI : Category.{u, u + 1} (CategoryTheory.MorphismProperty.Over (@AlgebraicGeometry.Etale) ⊤ S) :=
      inferInstanceAs (Category S.Etale)
    unfold AlgebraicGeometry.Scheme.smallEtaleTopology
    unfold AlgebraicGeometry.Scheme.Etale at X R ⊢
    haveI : AlgebraicGeometry.Scheme.IsJointlySurjectivePreserving (@AlgebraicGeometry.Etale) :=
      AlgebraicGeometry.Scheme.isJointlySurjectivePreserving (@AlgebraicGeometry.Etale)
    haveI : AlgebraicGeometry.Scheme.JointlySurjective
        (AlgebraicGeometry.Scheme.precoverage (@AlgebraicGeometry.Etale)) :=
      AlgebraicGeometry.Scheme.instJointlySurjectivePrecoverage
    erw [AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology]
    constructor
    · rintro ⟨𝒰, hOver, hProp, hle⟩
      letI : AlgebraicGeometry.Scheme.Cover.Over S 𝒰 := hOver
      letI : X.left.Over S := ⟨X.hom⟩
      letI : ∀ j : 𝒰.I₀, (𝒰.X j).Over S := hOver.over
      letI : ∀ j : 𝒰.I₀, (𝒰.f j).IsOver S := hOver.isOver_map
      refine ⟨𝒰.I₀,
        fun j => (𝒰.X j).asOverProp S (hProp j),
        fun j => (𝒰.f j).asOverProp S (hX := hProp j) (hY := X.prop),
        fun j => @hle _ _ (CategoryTheory.Presieve.ofArrows.mk j), ?_⟩
      intro x
      obtain ⟨y, hy⟩ := 𝒰.covers x
      exact ⟨𝒰.idx x, y, hy⟩
    · rintro ⟨J, E, f, hfR, hcov⟩
      have hf_et : ∀ j : J, AlgebraicGeometry.Etale (f j).left := fun j =>
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          (f j).left X.hom X.prop
          ((CategoryTheory.MorphismProperty.Over.w (f j)).symm ▸ (E j).prop)
      letI : X.left.Over S := ⟨X.hom⟩
      let 𝒰 : AlgebraicGeometry.Scheme.Cover
          (AlgebraicGeometry.Scheme.precoverage (@AlgebraicGeometry.Etale)) X.left :=
        AlgebraicGeometry.Scheme.Cover.mkOfCovers J (fun j => (E j).left)
          (fun j => (f j).left) hcov hf_et
      letI : ∀ j : 𝒰.I₀, (𝒰.X j).Over S := fun j => ⟨(E j).hom⟩
      letI : ∀ j : 𝒰.I₀, (𝒰.f j).IsOver S :=
        fun j => ⟨CategoryTheory.MorphismProperty.Over.w (f j)⟩
      let hOver : AlgebraicGeometry.Scheme.Cover.Over S 𝒰 :=
        { «over» := inferInstance, isOver_map := inferInstance }
      letI : AlgebraicGeometry.Scheme.Cover.Over S 𝒰 := hOver
      have hProp : ∀ j : 𝒰.I₀, AlgebraicGeometry.Etale (𝒰.X j ↘ S) := fun j => (E j).prop
      refine ⟨𝒰, hOver, hProp, ?_⟩
      rintro W g ⟨j⟩
      let iso_hom : (𝒰.X j).asOverProp S (hProp j) ⟶ E j :=
        CategoryTheory.MorphismProperty.Over.homMk (𝟙 (E j).left) (Category.id_comp (E j).hom)
      have h_fac : iso_hom ≫ f j =
          (𝒰.f j).asOverProp S (hX := hProp j) (hY := X.prop) :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (Category.id_comp (f j).left) (Subsingleton.elim _ _)
      rw [← h_fac]
      exact R.downward_closed (hfR j) iso_hom

  have hEtaleSecPt : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (w : W ⟶ S_k) [AlgebraicGeometry.Etale w] (x : ↥W),
      ∃ σ : S_k ⟶ W, σ ≫ w = 𝟙 S_k ∧ σ.base pt_k = x := by
    intro W w _ x
    obtain ⟨V_aff, hAffV, hx_V, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := W) (x := x) (U := ⊤) trivial
    let R_V : CommRingCat.{u} := W.presheaf.obj (Opposite.op V_aff)
    let j_B : AlgebraicGeometry.Spec R_V ⟶ W := hAffV.fromSpec
    have hx_range : x ∈ Set.range ⇑j_B.base := by
      rw [hAffV.range_fromSpec]
      exact hx_V
    obtain ⟨p₀, hp₀⟩ := hx_range
    let q₀ : PrimeSpectrum ↥R_V := p₀
    have hw_spec : AlgebraicGeometry.Etale (j_B ≫ w) := by dsimp [j_B]; infer_instance
    let φ_hom : CommRingCat.of k ⟶ R_V := AlgebraicGeometry.Spec.preimage (j_B ≫ w)
    have hφ_map : AlgebraicGeometry.Spec.map φ_hom = j_B ≫ w :=
      AlgebraicGeometry.Spec.map_preimage (j_B ≫ w)
    letI : Algebra k ↥R_V := φ_hom.hom.toAlgebra
    haveI : Algebra.Etale k ↥R_V := by
      rw [← RingHom.etale_algebraMap]
      change φ_hom.hom.Etale
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (hφ_map.symm ▸ hw_spec)
    obtain ⟨I, hFinI, L, hFieldL, hAlgL, Θ, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod k ↥R_V).mp inferInstance
    letI : Finite I := hFinI
    letI : Fintype I := Fintype.ofFinite I
    letI : ∀ i, Field (L i) := hFieldL
    letI : ∀ i, Algebra k (L i) := hAlgL
    have hex_i₀ : ∃ i₀ : I, Θ.symm (Pi.single i₀ 1) ∉ q₀.asIdeal := by
      by_contra! hall
      have h1_prod : (1 : ∀ i : I, L i) = ∑ i : I, Pi.single i (1 : L i) := by
        ext j; simp [Finset.sum_apply]
      have h1_R : (1 : ↥R_V) = ∑ i : I, Θ.symm (Pi.single i 1) := by
        calc
          (1 : ↥R_V) = Θ.symm 1 := (map_one Θ.symm).symm
          _ = ∑ i : I, Θ.symm (Pi.single i 1) := by rw [h1_prod, map_sum]
      have h1_mem : (1 : ↥R_V) ∈ q₀.asIdeal := by
        rw [h1_R]
        exact Ideal.sum_mem q₀.asIdeal fun i _ => hall i
      exact q₀.isPrime.ne_top ((Ideal.eq_top_iff_one q₀.asIdeal).mpr h1_mem)
    obtain ⟨i₀, hi₀_not_mem⟩ := hex_i₀
    haveI : Algebra.IsSeparable k (L i₀) := (hFinSep i₀).2
    let e_L : k ≃+* L i₀ :=
      RingEquiv.ofBijective (algebraMap k (L i₀))
        ⟨RingHom.injective _, IsSepClosed.algebraMap_surjective k (L i₀)⟩
    let χ_ring : ↥R_V →+* k :=
      e_L.symm.toRingHom.comp ((Pi.evalRingHom L i₀).comp Θ.toRingHom)
    let χ : R_V ⟶ CommRingCat.of k := CommRingCat.ofHom χ_ring
    have hφχ : φ_hom ≫ χ = 𝟙 (CommRingCat.of k) := by
      apply CommRingCat.hom_ext
      ext c
      change e_L.symm ((Θ (algebraMap k ↥R_V c)) i₀) = c
      rw [Θ.commutes]
      exact e_L.symm_apply_apply c
    have hχ_surj : Function.Surjective χ_ring := fun c =>
      ⟨Θ.symm (Pi.single i₀ (e_L c)), by
        change e_L.symm ((Θ (Θ.symm (Pi.single i₀ (e_L c)))) i₀) = c
        rw [AlgEquiv.apply_symm_apply, Pi.single_eq_same, e_L.symm_apply_apply]⟩
    have hker_max : (RingHom.ker χ_ring).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective χ_ring hχ_surj
    have hker_le : RingHom.ker χ_ring ≤ q₀.asIdeal := by
      intro r hr
      rw [RingHom.mem_ker] at hr
      have hθr0 : (Θ r) i₀ = 0 :=
        e_L.symm.injective (hr.trans (map_zero e_L.symm).symm)
      have hmul0_prod : Θ r * Pi.single i₀ (1 : L i₀) = 0 := by
        ext j
        by_cases hj : j = i₀
        · subst hj; simp [hθr0]
        · simp [Pi.single_eq_of_ne hj]
      have hmul0 : r * Θ.symm (Pi.single i₀ 1) = 0 := by
        calc
          r * Θ.symm (Pi.single i₀ 1) = Θ.symm (Θ r * Pi.single i₀ 1) := by
            rw [map_mul, AlgEquiv.symm_apply_apply]
          _ = 0 := by rw [hmul0_prod, map_zero]
      have hmem_mul : r * Θ.symm (Pi.single i₀ 1) ∈ q₀.asIdeal := by
        rw [hmul0]
        exact q₀.asIdeal.zero_mem
      exact (q₀.isPrime.mem_or_mem hmem_mul).resolve_right hi₀_not_mem
    have hker_eq : RingHom.ker χ_ring = q₀.asIdeal :=
      hker_max.eq_of_le q₀.isPrime.ne_top hker_le
    have hcomap_pt : (AlgebraicGeometry.Spec.map χ).base pt_k = p₀ := by
      apply PrimeSpectrum.ext
      change Ideal.comap χ_ring ⊥ = q₀.asIdeal
      rw [← RingHom.ker_eq_comap_bot]
      exact hker_eq
    refine ⟨AlgebraicGeometry.Spec.map χ ≫ j_B, ?_, ?_⟩
    · rw [Category.assoc, ← hφ_map, ← AlgebraicGeometry.Spec.map_comp, hφχ,
        AlgebraicGeometry.Spec.map_id]
    · change j_B.base ((AlgebraicGeometry.Spec.map χ).base pt_k) = x
      rw [hcomap_pt, hp₀]

  have hTopSieve_Sk : ∀ (R : CategoryTheory.Sieve T_k), R ∈ J_k T_k → R = ⊤ := by
    intro R hR
    obtain ⟨J, E, f, hfR, hcov⟩ := (hMemEtale S_k T_k R).mp hR
    obtain ⟨j, y, -⟩ := hcov pt_k
    haveI : AlgebraicGeometry.Etale (E j).hom := (E j).prop
    obtain ⟨σ, hσ, -⟩ := hEtaleSecPt (E j).left (E j).hom y
    let s_et : T_k ⟶ E j := CategoryTheory.MorphismProperty.Over.homMk σ hσ
    have hcomp_id : s_et ≫ f j = 𝟙 T_k := hT_k.hom_ext _ _
    exact CategoryTheory.Sieve.id_mem_iff_eq_top.mp
      (hcomp_id ▸ R.downward_closed (hfR j) s_et)

  have hZero_Sk : ∀ (ℱ : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}),
      Subsingleton ↥(ℱ.obj.obj (Opposite.op T_k)) → CategoryTheory.Limits.IsZero ℱ := by
    intro ℱ hSub
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    have : (CategoryTheory.sheafToPresheaf J_k AddCommGrpCat.{u}).Additive := hS2P_add S_k
    apply CategoryTheory.Sheaf.hom_ext
    change (CategoryTheory.sheafToPresheaf J_k AddCommGrpCat.{u}).map (𝟙 ℱ) =
      (CategoryTheory.sheafToPresheaf J_k AddCommGrpCat.{u}).map (0 : ℱ ⟶ ℱ)
    rw [(CategoryTheory.sheafToPresheaf J_k AddCommGrpCat.{u}).map_id,
      (CategoryTheory.sheafToPresheaf J_k AddCommGrpCat.{u}).map_zero]
    apply CategoryTheory.NatTrans.ext
    funext V_op
    let V : S_k.Etale := V_op.unop
    haveI : AlgebraicGeometry.Etale V.hom := V.prop
    apply AddCommGrpCat.ext
    intro s
    change s = 0
    have hSec : ∀ x : ↥V.left, ∃ m_x : T_k ⟶ V, m_x.left.base pt_k = x := by
      intro x
      obtain ⟨σ, hσ, hpt⟩ := hEtaleSecPt V.left V.hom x
      exact ⟨CategoryTheory.MorphismProperty.Over.homMk σ hσ, hpt⟩
    choose m_sec hm_sec using hSec
    let S_V : CategoryTheory.Sieve V :=
      CategoryTheory.Sieve.ofArrows (fun _ : ↥V.left => T_k) m_sec
    have hSV_mem : S_V ∈ J_k V :=
      (hMemEtale S_k V S_V).mpr
        ⟨↥V.left, fun _ => T_k, m_sec, fun x => CategoryTheory.Sieve.ofArrows_mk _ _ x,
          fun x => ⟨x, pt_k, hm_sec x⟩⟩
    let Eℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let g₁ : Eℤ ⟶ ℱ.obj.obj (Opposite.op V) :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • s
          map_zero' := zero_zsmul s
          map_add' := fun a b => add_zsmul s a.down b.down }
    let g₂ : Eℤ ⟶ ℱ.obj.obj (Opposite.op V) := 0
    let fam : CategoryTheory.Presieve.FamilyOfElements
        (ℱ.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Eℤ)) S_V.arrows :=
      fun Y₁ _ _ => (0 : Eℤ ⟶ ℱ.obj.obj (Opposite.op Y₁))
    have hg₁ : fam.IsAmalgamation g₁ := by
      rintro Y₁ f ⟨W₀, h_mor, _, ⟨x⟩, rfl⟩
      dsimp [fam]
      ext ⟨z⟩
      change (ℱ.obj.map (h_mor ≫ m_sec x).op) (z • s) = 0
      rw [map_zsmul, op_comp, ℱ.obj.map_comp]
      have h0_Tk : (ℱ.obj.map (m_sec x).op) s = 0 := Subsingleton.elim _ _
      change z • (ℱ.obj.map h_mor.op) ((ℱ.obj.map (m_sec x).op) s) = 0
      rw [h0_Tk, map_zero, zsmul_zero]
    have hg₂ : fam.IsAmalgamation g₂ := by
      intro Y₁ f _
      dsimp [fam, g₂]
      exact Limits.zero_comp
    have hEq : g₁ = g₂ := (ℱ.property Eℤ S_V hSV_mem).isSeparatedFor fam g₁ g₂ hg₁ hg₂
    simpa [g₁, g₂] using congrArg (fun m : Eℤ ⟶ _ => m (ULift.up (1 : ℤ))) hEq

  let Idx : S_k.Etale → Type u := fun V => { τ : S_k ⟶ V.left // τ ≫ V.hom = 𝟙 S_k }
  let id_idx : Idx T_k := ⟨𝟙 S_k, Category.comp_id _⟩
  have hIdxTk : ∀ τ : Idx T_k, τ = id_idx := fun ⟨τ, hτ⟩ =>
    Subtype.ext ((Category.comp_id τ).symm.trans hτ)
  let m_idx : ∀ {V : S_k.Etale}, Idx V → (T_k ⟶ V) :=
    fun τ => CategoryTheory.MorphismProperty.Over.homMk τ.1 τ.2
  have hm_id : m_idx id_idx = 𝟙 T_k := hT_k.hom_ext _ _
  have hm_comp : ∀ {V₁ V₂ : S_k.Etale} (g : V₁ ⟶ V₂) (σ : Idx V₁),
      m_idx σ ≫ g = m_idx ⟨σ.1 ≫ g.left, by
        rw [Category.assoc, CategoryTheory.MorphismProperty.Over.w g, σ.2]⟩ :=
    fun _ _ => CategoryTheory.MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)
  let RK_obj : AddCommGrpCat.{u} → ((S_k.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}) := fun D =>
    { obj := fun V => AddCommGrpCat.of (Idx V.unop → ↥D)
      map := fun {V₂ V₁} g => AddCommGrpCat.ofHom
        { toFun := fun φ σ => φ ⟨σ.1 ≫ g.unop.left, by
            rw [Category.assoc, CategoryTheory.MorphismProperty.Over.w g.unop, σ.2]⟩
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      map_id := fun _ => AddCommGrpCat.ext fun φ => funext fun _ =>
        congrArg φ (Subtype.ext (Category.comp_id _))
      map_comp := fun _ _ => AddCommGrpCat.ext fun φ => funext fun _ =>
        congrArg φ (Subtype.ext (Category.assoc _ _ _).symm) }
  have hRK_sheaf : ∀ (D : AddCommGrpCat.{u}),
      CategoryTheory.Presheaf.IsSheaf J_k (RK_obj D) := by
    intro D E V S hS x hx
    have hm_mem : ∀ τ : Idx V, S.arrows (m_idx τ) := by
      intro τ
      have hp : S.pullback (m_idx τ) = ⊤ := hTopSieve_Sk _ (J_k.pullback_stable (m_idx τ) hS)
      have hid : (S.pullback (m_idx τ)).arrows (𝟙 T_k) := by rw [hp]; trivial
      simpa [CategoryTheory.Sieve.pullback_apply] using hid
    let x_hom : ∀ (τ : Idx V), E ⟶ AddCommGrpCat.of (Idx T_k → ↥D) :=
      fun τ => x (m_idx τ) (hm_mem τ)
    let amalg : E ⟶ (RK_obj D).obj (Opposite.op V) :=
      AddCommGrpCat.ofHom
        { toFun := fun e τ => ((x_hom τ).hom e) id_idx
          map_zero' := by ext τ; exact congrFun ((x_hom τ).hom.map_zero) id_idx
          map_add' := fun e₁ e₂ => by ext τ; exact congrFun ((x_hom τ).hom.map_add e₁ e₂) id_idx }
    refine ⟨amalg, ?_, ?_⟩
    · intro W f hf
      dsimp [CategoryTheory.coyoneda]
      apply AddCommGrpCat.ext
      intro e
      funext σ
      let fσ : Idx V := ⟨σ.1 ≫ f.left, by
        rw [Category.assoc, CategoryTheory.MorphismProperty.Over.w f, σ.2]⟩
      have hcomp_eq : 𝟙 T_k ≫ m_idx fσ = m_idx σ ≫ f := by
        rw [Category.id_comp, hm_comp f σ]
      have hx_raw := hx (𝟙 T_k) (m_idx σ) (hm_mem fσ) hf hcomp_eq
      dsimp [CategoryTheory.coyoneda] at hx_raw
      have hx_val := congrFun (congrArg (fun (m : E ⟶ (RK_obj D).obj (Opposite.op T_k)) =>
        m.hom e) hx_raw) id_idx
      dsimp [RK_obj, amalg, x_hom, fσ] at hx_val ⊢
      have h1 : (⟨𝟙 S_k ≫ 𝟙 S_k, (congrArg (· ≫ T_k.hom) (Category.id_comp _)).trans id_idx.2⟩ :
          Idx T_k) = id_idx := hIdxTk _
      have h2 : (⟨𝟙 S_k ≫ σ.1, (congrArg (· ≫ W.hom) (Category.id_comp σ.1)).trans σ.2⟩ :
          Idx W) = σ := Subtype.ext (Category.id_comp σ.1)
      erw [h1, h2] at hx_val
      exact hx_val
    · intro y hy
      apply AddCommGrpCat.ext
      intro e
      funext τ
      have hy_raw := hy (m_idx τ) (hm_mem τ)
      dsimp [CategoryTheory.coyoneda] at hy_raw
      have hy_val := congrFun (congrArg (fun (m : E ⟶ (RK_obj D).obj (Opposite.op T_k)) =>
        m.hom e) hy_raw) id_idx
      dsimp [RK_obj, amalg, x_hom] at hy_val ⊢
      have h2 : (⟨𝟙 S_k ≫ τ.1, (congrArg (· ≫ V.hom) (Category.id_comp τ.1)).trans τ.2⟩ :
          Idx V) = τ := Subtype.ext (Category.id_comp τ.1)
      erw [h2] at hy_val
      exact hy_val
  let RK : AddCommGrpCat.{u} → CategoryTheory.Sheaf J_k AddCommGrpCat.{u} :=
    fun D => ⟨RK_obj D, hRK_sheaf D⟩
  let ev_id : ∀ (D : AddCommGrpCat.{u}), (RK D).obj.obj (Opposite.op T_k) ⟶ D :=
    fun D => AddCommGrpCat.ofHom
      { toFun := fun φ => φ id_idx
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
  let RK_lift : ∀ {D : AddCommGrpCat.{u}}
      (H : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}),
      (H.obj.obj (Opposite.op T_k) ⟶ D) → (H ⟶ RK D) :=
    fun {D} H α =>
      ⟨{ app := fun V => AddCommGrpCat.ofHom
          { toFun := fun h τ => α ((H.obj.map (m_idx τ).op) h)
            map_zero' := by ext τ; simp
            map_add' := fun h₁ h₂ => by ext τ; simp }
         naturality := fun {V₂ V₁} g => by
          ext h σ
          dsimp [RK, RK_obj]
          rw [← hm_comp g.unop σ, op_comp, H.obj.map_comp]
          rfl }⟩
  have hRK_lift_eval : ∀ {D : AddCommGrpCat.{u}}
      (H : CategoryTheory.Sheaf J_k AddCommGrpCat.{u})
      (α : H.obj.obj (Opposite.op T_k) ⟶ D),
      (RK_lift H α).hom.app (Opposite.op T_k) ≫ ev_id D = α := by
    intro D H α
    ext h
    dsimp [RK_lift, ev_id]
    rw [hm_id, op_id, H.obj.map_id]
    rfl

  have hGermPres : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (u : S_k ⟶ Y)
      (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
      (H_u : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback u F H_u →
      ∃ (ev : ∀ (E : Y.Etale) (u_E : S_k ⟶ E.left),
          u_E ≫ E.hom = u → (F.obj.obj (Opposite.op E) ⟶ H_u.obj.obj (Opposite.op T_k))),
        (∀ (E₁ E₂ : Y.Etale) (g : E₁ ⟶ E₂)
            (u₁ : S_k ⟶ E₁.left) (u₂ : S_k ⟶ E₂.left)
            (hu₁ : u₁ ≫ E₁.hom = u) (hu₂ : u₂ ≫ E₂.hom = u),
          u₁ ≫ g.left = u₂ →
          F.obj.map g.op ≫ ev E₁ u₁ hu₁ = ev E₂ u₂ hu₂) ∧
        (∀ (x : ↥(H_u.obj.obj (Opposite.op T_k))),
          ∃ (E : Y.Etale) (_ : AlgebraicGeometry.IsAffine E.left)
            (u_E : S_k ⟶ E.left) (hu_E : u_E ≫ E.hom = u)
            (s : ↥(F.obj.obj (Opposite.op E))),
            (ev E u_E hu_E) s = x) := by
    intro Y u F H_u hPB
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) u :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) u :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_u : CategoryTheory.Functor Y.Etale S_k.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ u
    rcases hPB with ⟨hCont_u, hRA_u, ⟨e_u⟩⟩
    let P_push := B_u.sheafPushforwardContinuous AddCommGrpCat.{u} Y.smallEtaleTopology J_k
    let adj_B := B_u.sheafAdjunctionContinuous AddCommGrpCat.{u} Y.smallEtaleTopology J_k
    let N : AddCommGrpCat.{u} := H_u.obj.obj (Opposite.op T_k)
    let mkIdx : ∀ (E : Y.Etale) (u_E : S_k ⟶ E.left),
        u_E ≫ E.hom = u → Idx (B_u.obj E) :=
      fun E u_E hu_E =>
        ⟨CategoryTheory.Limits.pullback.lift u_E (𝟙 S_k)
          (hu_E.trans (Category.id_comp u).symm),
         CategoryTheory.Limits.pullback.lift_snd _ _ _⟩
    let ev₀ : ∀ (E : Y.Etale), Idx (B_u.obj E) → (F.obj.obj (Opposite.op E) ⟶ N) :=
      fun E τ =>
        (adj_B.unit.app F).hom.app (Opposite.op E) ≫
          e_u.hom.hom.app (Opposite.op (B_u.obj E)) ≫
          H_u.obj.map (m_idx τ).op
    let ev : ∀ (E : Y.Etale) (u_E : S_k ⟶ E.left),
        u_E ≫ E.hom = u → (F.obj.obj (Opposite.op E) ⟶ N) :=
      fun E u_E hu_E => ev₀ E (mkIdx E u_E hu_E)
    have hev₀_mor : ∀ (E₁ E₂ : Y.Etale) (g : E₁ ⟶ E₂)
        (τ₁ : Idx (B_u.obj E₁)) (τ₂ : Idx (B_u.obj E₂)),
        τ₁.1 ≫ (B_u.map g).left = τ₂.1 →
        F.obj.map g.op ≫ ev₀ E₁ τ₁ = ev₀ E₂ τ₂ := by
      intro E₁ E₂ g τ₁ τ₂ hτ_eq
      have hm_eq : m_idx τ₁ ≫ B_u.map g = m_idx τ₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hτ_eq (Subsingleton.elim _ _)
      have hnat₁ := (adj_B.unit.app F).hom.naturality g.op
      have hnat₂ := e_u.hom.hom.naturality (B_u.map g).op
      exact (Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ _) hnat₁).trans
          ((Category.assoc _ _ _).trans
            (congrArg (_ ≫ ·)
              ((Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ _) hnat₂).trans
                  ((Category.assoc _ _ _).trans
                    (congrArg (_ ≫ ·)
                      ((H_u.obj.map_comp _ _).symm.trans
                        (congrArg (fun k => H_u.obj.map k.op) hm_eq)))))))))
    have hBu_fst : ∀ {E₁ E₂ : Y.Etale} (g : E₁ ⟶ E₂),
        (B_u.map g).left ≫ CategoryTheory.Limits.pullback.fst E₂.hom u =
          CategoryTheory.Limits.pullback.fst E₁.hom u ≫ g.left := by
      intro E₁ E₂ g
      dsimp [B_u, CategoryTheory.MorphismProperty.Over.pullback]
      exact CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hCompat : ∀ (E₁ E₂ : Y.Etale) (g : E₁ ⟶ E₂)
        (u₁ : S_k ⟶ E₁.left) (u₂ : S_k ⟶ E₂.left)
        (hu₁ : u₁ ≫ E₁.hom = u) (hu₂ : u₂ ≫ E₂.hom = u),
        u₁ ≫ g.left = u₂ →
        F.obj.map g.op ≫ ev E₁ u₁ hu₁ = ev E₂ u₂ hu₂ := by
      intro E₁ E₂ g u₁ u₂ hu₁ hu₂ hug
      apply hev₀_mor E₁ E₂ g
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·) (hBu_fst g)).trans
            ((Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ g.left) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                (hug.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm))))
      · change (mkIdx E₁ u₁ hu₁).1 ≫ (B_u.map g).left ≫ (B_u.obj E₂).hom = _
        rw [CategoryTheory.MorphismProperty.Over.w (B_u.map g), (mkIdx E₁ u₁ hu₁).2]
        exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
    let Ψ_hom : ∀ {D : AddCommGrpCat.{u}}, (N ⟶ D) → (F ⟶ P_push.obj (RK D)) :=
      fun {D} α => adj_B.homEquiv F (RK D) (e_u.hom ≫ RK_lift H_u α)
    have hΨ_app : ∀ {D : AddCommGrpCat.{u}} (α : N ⟶ D) (E : Y.Etale)
        (s : ↥(F.obj.obj (Opposite.op E))) (τ : Idx (B_u.obj E)),
        (((Ψ_hom α).hom.app (Opposite.op E)) s) τ = α (ev₀ E τ s) := by
      intro D α E s τ
      have h_unit : Ψ_hom α = adj_B.unit.app F ≫ P_push.map (e_u.hom ≫ RK_lift H_u α) :=
        Adjunction.homEquiv_unit adj_B F (RK D) (e_u.hom ≫ RK_lift H_u α)
      rw [h_unit]
      rfl
    have hΨ_surj : ∀ {D : AddCommGrpCat.{u}} (Θ : F ⟶ P_push.obj (RK D)),
        ∃ α : N ⟶ D, Ψ_hom α = Θ := by
      intro D Θ
      let γ : H_u ⟶ RK D := e_u.inv ≫ (adj_B.homEquiv F (RK D)).symm Θ
      refine ⟨γ.hom.app (Opposite.op T_k) ≫ ev_id D, ?_⟩
      have hγ : RK_lift H_u (γ.hom.app (Opposite.op T_k) ≫ ev_id D) = γ := by
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext V_op
        apply AddCommGrpCat.ext
        intro h
        funext τ
        have hnat := congrArg (fun (m : H_u.obj.obj V_op ⟶ (RK D).obj.obj (Opposite.op T_k)) =>
          m.hom h) (γ.hom.naturality (m_idx τ).op)
        have hnat' := congrFun hnat id_idx
        dsimp [RK, RK_obj, RK_lift, ev_id] at hnat' ⊢
        have h2 : (⟨𝟙 S_k ≫ τ.1,
            (congrArg (· ≫ V_op.unop.hom) (Category.id_comp τ.1)).trans τ.2⟩ :
            Idx V_op.unop) = τ :=
          Subtype.ext (Category.id_comp τ.1)
        erw [h2] at hnat'
        exact hnat'
      dsimp [Ψ_hom]
      rw [hγ]
      dsimp [γ]
      rw [Iso.hom_inv_id_assoc]
      exact (adj_B.homEquiv F (RK D)).apply_symm_apply Θ
    have hΨ_inj : ∀ {D : AddCommGrpCat.{u}} {α₁ α₂ : N ⟶ D},
        Ψ_hom α₁ = Ψ_hom α₂ → α₁ = α₂ := by
      intro D α₁ α₂ hEq
      have h1 : e_u.hom ≫ RK_lift H_u α₁ = e_u.hom ≫ RK_lift H_u α₂ :=
        (adj_B.homEquiv F (RK D)).injective hEq
      have h2 : RK_lift H_u α₁ = RK_lift H_u α₂ := (cancel_epi e_u.hom).mp h1
      calc
        α₁ = (RK_lift H_u α₁).hom.app (Opposite.op T_k) ≫ ev_id D :=
          (hRK_lift_eval H_u α₁).symm
        _ = (RK_lift H_u α₂).hom.app (Opposite.op T_k) ≫ ev_id D := by rw [h2]
        _ = α₂ := hRK_lift_eval H_u α₂
    let M_Y : Type u := CategoryTheory.SmallModel.{u} Y.AffineEtale
    let e_Y := CategoryTheory.equivSmallModel.{u} Y.AffineEtale
    let ι_aff := AlgebraicGeometry.Scheme.AffineEtale.Spec Y
    let W_m : M_Y → Y.Etale := fun m => ι_aff.obj (e_Y.inverse.obj m)
    have hAff_Wm : ∀ m : M_Y, AlgebraicGeometry.IsAffine (W_m m).left := by
      intro m
      change AlgebraicGeometry.IsAffine
        (AlgebraicGeometry.Scheme.Spec.obj (e_Y.inverse.obj m).left)
      infer_instance
    let I_u : Type u := Σ (m : M_Y), { u_m : S_k ⟶ (W_m m).left // u_m ≫ (W_m m).hom = u }
    let PtdHom : I_u → I_u → Type u :=
      fun i₁ i₂ => { g : W_m i₁.1 ⟶ W_m i₂.1 // i₁.2.1 ≫ g.left = i₂.2.1 }
    let ptdId : ∀ (i : I_u), PtdHom i i := fun i => ⟨𝟙 (W_m i.1), Category.comp_id _⟩
    let ptdComp : ∀ {i₁ i₂ i₃ : I_u}, PtdHom i₁ i₂ → PtdHom i₂ i₃ → PtdHom i₁ i₃ :=
      fun g₁ g₂ => ⟨g₁.1 ≫ g₂.1, by
        change _ ≫ (g₁.1.left ≫ g₂.1.left) = _
        rw [← Category.assoc, g₁.2, g₂.2]⟩
    have hLiftSmall : ∀ (E : Y.Etale) (u_E : S_k ⟶ E.left),
        u_E ≫ E.hom = u →
        ∃ (i : I_u) (j : W_m i.1 ⟶ E), i.2.1 ≫ j.left = u_E := by
      intro E u_E hu_E
      obtain ⟨U_E, hAffU, hpt_U, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := u_E.base pt_k) (U := (⊤ : E.left.Opens)) trivial
      have hRange : Set.range u_E.base ⊆ Set.range U_E.ι.base := by
        rintro _ ⟨z, rfl⟩
        rw [Subsingleton.elim z pt_k]
        exact ⟨⟨u_E.base pt_k, hpt_U⟩, rfl⟩
      let u_UE : S_k ⟶ U_E.toScheme := AlgebraicGeometry.IsOpenImmersion.lift U_E.ι u_E hRange
      have hu_UE : u_UE ≫ U_E.ι = u_E :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_E.ι u_E hRange
      let R_E : CommRingCat.{u} := E.left.presheaf.obj (Opposite.op U_E)
      haveI : AlgebraicGeometry.Etale E.hom := E.prop
      let w_RE : AlgebraicGeometry.Spec R_E ⟶ Y := hAffU.isoSpec.inv ≫ U_E.ι ≫ E.hom
      have hw_RE : AlgebraicGeometry.Etale w_RE := by dsimp [w_RE]; infer_instance
      let X₀ : Y.AffineEtale :=
        CategoryTheory.MorphismProperty.CostructuredArrow.mk ⊤
          (F := AlgebraicGeometry.Scheme.Spec) (A := Opposite.op R_E) w_RE hw_RE
      let m : M_Y := e_Y.functor.obj X₀
      let φ_X₀ : ι_aff.obj X₀ ≅ W_m m := ι_aff.mapIso (e_Y.unitIso.app X₀)
      let j_X₀ : ι_aff.obj X₀ ⟶ E :=
        CategoryTheory.MorphismProperty.Over.homMk (hAffU.isoSpec.inv ≫ U_E.ι) rfl
      let u_X₀ : S_k ⟶ (ι_aff.obj X₀).left := u_UE ≫ hAffU.isoSpec.hom
      have hu_X₀ : u_X₀ ≫ j_X₀.left = u_E := by
        change (u_UE ≫ hAffU.isoSpec.hom) ≫ (hAffU.isoSpec.inv ≫ U_E.ι) = u_E
        rw [Category.assoc, hAffU.isoSpec.hom_inv_id_assoc, hu_UE]
      let u_m : S_k ⟶ (W_m m).left := u_X₀ ≫ φ_X₀.hom.left
      have hu_m : u_m ≫ (W_m m).hom = u := by
        dsimp [u_m]
        rw [Category.assoc, CategoryTheory.MorphismProperty.Over.w φ_X₀.hom]
        change u_X₀ ≫ j_X₀.left ≫ E.hom = u
        rw [← Category.assoc, hu_X₀, hu_E]
      refine ⟨⟨m, u_m, hu_m⟩, φ_X₀.inv ≫ j_X₀, ?_⟩
      change (u_X₀ ≫ φ_X₀.hom.left) ≫ (φ_X₀.inv.left ≫ j_X₀.left) = u_E
      have hinv : φ_X₀.hom.left ≫ φ_X₀.inv.left = 𝟙 (ι_aff.obj X₀).left :=
        congrArg (fun g : ι_aff.obj X₀ ⟶ ι_aff.obj X₀ => g.left) φ_X₀.hom_inv_id
      rw [Category.assoc, ← Category.assoc φ_X₀.hom.left, hinv, Category.id_comp, hu_X₀]
    obtain ⟨i₀, -⟩ := hLiftSmall (termObj Y) u (Category.comp_id u)
    have hCone₂ : ∀ (i₁ i₂ : I_u),
        ∃ (i₃ : I_u), Nonempty (PtdHom i₃ i₁) ∧ Nonempty (PtdHom i₃ i₂) := by
      intro i₁ i₂
      haveI : AlgebraicGeometry.Etale (W_m i₁.1).hom := (W_m i₁.1).prop
      haveI : AlgebraicGeometry.Etale (W_m i₂.1).hom := (W_m i₂.1).prop
      let fst := CategoryTheory.Limits.pullback.fst (W_m i₁.1).hom (W_m i₂.1).hom
      let snd := CategoryTheory.Limits.pullback.snd (W_m i₁.1).hom (W_m i₂.1).hom
      let E_pb : Y.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (fst ≫ (W_m i₁.1).hom) inferInstance
      let u_pb : S_k ⟶ E_pb.left :=
        CategoryTheory.Limits.pullback.lift i₁.2.1 i₂.2.1 (i₁.2.2.trans i₂.2.2.symm)
      have hu_pb : u_pb ≫ E_pb.hom = u := by
        change u_pb ≫ fst ≫ (W_m i₁.1).hom = u
        erw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst, i₁.2.2]
      obtain ⟨i₃, j, hj⟩ := hLiftSmall E_pb u_pb hu_pb
      let π₁ : E_pb ⟶ W_m i₁.1 := CategoryTheory.MorphismProperty.Over.homMk fst rfl
      let π₂ : E_pb ⟶ W_m i₂.1 := CategoryTheory.MorphismProperty.Over.homMk snd
        CategoryTheory.Limits.pullback.condition.symm
      refine ⟨i₃, ⟨⟨j ≫ π₁, ?_⟩⟩, ⟨⟨j ≫ π₂, ?_⟩⟩⟩
      · change i₃.2.1 ≫ (j.left ≫ fst) = i₁.2.1
        erw [← Category.assoc, hj, CategoryTheory.Limits.pullback.lift_fst]
      · change i₃.2.1 ≫ (j.left ≫ snd) = i₂.2.1
        erw [← Category.assoc, hj, CategoryTheory.Limits.pullback.lift_snd]
    have hEqz : ∀ {i₁ i₂ : I_u} (g₁ g₂ : PtdHom i₁ i₂),
        ∃ (i₃ : I_u) (h : PtdHom i₃ i₁), ptdComp h g₁ = ptdComp h g₂ := by
      intro i₁ i₂ g₁ g₂
      haveI : AlgebraicGeometry.Etale (W_m i₁.1).hom := (W_m i₁.1).prop
      haveI : AlgebraicGeometry.Etale (W_m i₂.1).hom := (W_m i₂.1).prop
      let Δ := CategoryTheory.Limits.pullback.diagonal (W_m i₂.1).hom
      haveI : AlgebraicGeometry.IsOpenImmersion Δ := inferInstance
      let γ := CategoryTheory.Limits.pullback.lift g₁.1.left g₂.1.left
        ((CategoryTheory.MorphismProperty.Over.w g₁.1).trans
          (CategoryTheory.MorphismProperty.Over.w g₂.1).symm)
      let p₁ := CategoryTheory.Limits.pullback.fst γ Δ
      let p₂ := CategoryTheory.Limits.pullback.snd γ Δ
      haveI : AlgebraicGeometry.Etale p₁ := inferInstance
      let E_eq : Y.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ (W_m i₁.1).hom) inferInstance
      have hu_eq_comm : i₁.2.1 ≫ γ = i₂.2.1 ≫ Δ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · dsimp [γ, Δ]
          erw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, g₁.2,
            Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst, Category.comp_id]
        · dsimp [γ, Δ]
          erw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, g₂.2,
            Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd, Category.comp_id]
      let u_eq : S_k ⟶ E_eq.left :=
        CategoryTheory.Limits.pullback.lift i₁.2.1 i₂.2.1 hu_eq_comm
      have hu_eq : u_eq ≫ E_eq.hom = u := by
        change u_eq ≫ p₁ ≫ (W_m i₁.1).hom = u
        erw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst, i₁.2.2]
      obtain ⟨i₃, j, hj⟩ := hLiftSmall E_eq u_eq hu_eq
      let π_eq : E_eq ⟶ W_m i₁.1 := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl
      have hp_eq : p₁ ≫ g₁.1.left = p₁ ≫ g₂.1.left := by
        have hc := CategoryTheory.Limits.pullback.condition (f := γ) (g := Δ)
        have hc₁ : p₁ ≫ g₁.1.left = p₂ := by
          have h := congrArg (· ≫ CategoryTheory.Limits.pullback.fst _ _) hc
          dsimp [p₁, p₂, γ, Δ] at h ⊢
          erw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst, Category.comp_id] at h
          exact h
        have hc₂ : p₁ ≫ g₂.1.left = p₂ := by
          have h := congrArg (· ≫ CategoryTheory.Limits.pullback.snd _ _) hc
          dsimp [p₁, p₂, γ, Δ] at h ⊢
          erw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd, Category.comp_id] at h
          exact h
        exact hc₁.trans hc₂.symm
      refine ⟨i₃, ⟨j ≫ π_eq, ?_⟩, ?_⟩
      · change i₃.2.1 ≫ (j.left ≫ p₁) = i₁.2.1
        erw [← Category.assoc, hj, CategoryTheory.Limits.pullback.lift_fst]
      · apply Subtype.ext
        apply CategoryTheory.MorphismProperty.Comma.Hom.ext
        · exact (Category.assoc j.left p₁ g₁.1.left).trans
            ((congrArg (j.left ≫ ·) hp_eq).trans (Category.assoc j.left p₁ g₂.1.left).symm)
        · exact Subsingleton.elim _ _
    let Carrier : Type u := Σ (i : I_u), ↥(F.obj.obj (Opposite.op (W_m i.1)))
    let Rel : Carrier → Carrier → Prop := fun a b =>
      ∃ (i₃ : I_u) (h₁ : PtdHom i₃ a.1) (h₂ : PtdHom i₃ b.1),
        (F.obj.map h₁.1.op) a.2 = (F.obj.map h₂.1.op) b.2
    let setoid_F : Setoid Carrier :=
      ⟨Rel,
        ⟨fun a => ⟨a.1, ptdId a.1, ptdId a.1, rfl⟩,
         by rintro x y ⟨i₃, h₁, h₂, heq⟩; exact ⟨i₃, h₂, h₁, heq.symm⟩,
         by
           rintro a b c ⟨ia, ha₁, ha₂, heqa⟩ ⟨ib, hb₂, hb₃, heqb⟩
           obtain ⟨ic, ⟨ka⟩, ⟨kb⟩⟩ := hCone₂ ia ib
           obtain ⟨id_u, e, he_eq⟩ := hEqz (ptdComp ka ha₂) (ptdComp kb hb₂)
           refine ⟨id_u, ptdComp e (ptdComp ka ha₁), ptdComp e (ptdComp kb hb₃), ?_⟩
           have he_mid : (ptdComp e (ptdComp ka ha₂)).1 = (ptdComp e (ptdComp kb hb₂)).1 :=
             congrArg Subtype.val he_eq
           calc
             (F.obj.map (ptdComp e (ptdComp ka ha₁)).1.op) a.2
               = (F.obj.map e.1.op) ((F.obj.map ka.1.op) ((F.obj.map ha₁.1.op) a.2)) := by
                   dsimp [ptdComp]; rw [F.obj.map_comp, F.obj.map_comp]; rfl
             _ = (F.obj.map e.1.op) ((F.obj.map ka.1.op) ((F.obj.map ha₂.1.op) b.2)) := by rw [heqa]
             _ = (F.obj.map (ptdComp e (ptdComp ka ha₂)).1.op) b.2 := by
                   dsimp [ptdComp]; rw [F.obj.map_comp, F.obj.map_comp]; rfl
             _ = (F.obj.map (ptdComp e (ptdComp kb hb₂)).1.op) b.2 := by rw [he_mid]
             _ = (F.obj.map e.1.op) ((F.obj.map kb.1.op) ((F.obj.map hb₂.1.op) b.2)) := by
                   dsimp [ptdComp]; rw [F.obj.map_comp, F.obj.map_comp]; rfl
             _ = (F.obj.map e.1.op) ((F.obj.map kb.1.op) ((F.obj.map hb₃.1.op) c.2)) := by rw [heqb]
             _ = (F.obj.map (ptdComp e (ptdComp kb hb₃)).1.op) c.2 := by
                   dsimp [ptdComp]; rw [F.obj.map_comp, F.obj.map_comp]; rfl⟩⟩
    let Q_F : Type u := Quotient setoid_F
    let addRaw : Carrier → Carrier → Q_F := fun a b =>
      let ic := Classical.choose (hCone₂ a.1 b.1)
      let ha : PtdHom ic a.1 := Classical.choice (Classical.choose_spec (hCone₂ a.1 b.1)).1
      let hb : PtdHom ic b.1 := Classical.choice (Classical.choose_spec (hCone₂ a.1 b.1)).2
      Quotient.mk setoid_F ⟨ic, (F.obj.map ha.1.op) a.2 + (F.obj.map hb.1.op) b.2⟩
    have hAddAny : ∀ (a b : Carrier) (ic : I_u) (ha : PtdHom ic a.1) (hb : PtdHom ic b.1),
        addRaw a b =
          Quotient.mk setoid_F ⟨ic, (F.obj.map ha.1.op) a.2 + (F.obj.map hb.1.op) b.2⟩ := by
      intro a b ic ha hb
      let ic₀ := Classical.choose (hCone₂ a.1 b.1)
      let ha₀ : PtdHom ic₀ a.1 := Classical.choice (Classical.choose_spec (hCone₂ a.1 b.1)).1
      let hb₀ : PtdHom ic₀ b.1 := Classical.choice (Classical.choose_spec (hCone₂ a.1 b.1)).2
      obtain ⟨im, ⟨k₀⟩, ⟨k₁⟩⟩ := hCone₂ ic₀ ic
      obtain ⟨id₁, e₁, he₁⟩ := hEqz (ptdComp k₀ ha₀) (ptdComp k₁ ha)
      obtain ⟨id₂, e₂, he₂⟩ := hEqz (ptdComp e₁ (ptdComp k₀ hb₀)) (ptdComp e₁ (ptdComp k₁ hb))
      apply Quotient.sound
      refine ⟨id₂, ptdComp e₂ (ptdComp e₁ k₀), ptdComp e₂ (ptdComp e₁ k₁), ?_⟩
      have h1 : (ptdComp e₂ (ptdComp e₁ (ptdComp k₀ ha₀))).1 =
          (ptdComp e₂ (ptdComp e₁ (ptdComp k₁ ha))).1 :=
        congrArg (fun p => (ptdComp e₂ p).1) he₁
      have h2 : (ptdComp e₂ (ptdComp e₁ (ptdComp k₀ hb₀))).1 =
          (ptdComp e₂ (ptdComp e₁ (ptdComp k₁ hb))).1 :=
        congrArg Subtype.val he₂
      rw [map_add, map_add]
      have ha_eq : (F.obj.map (ptdComp e₂ (ptdComp e₁ k₀)).1.op) ((F.obj.map ha₀.1.op) a.2) =
          (F.obj.map (ptdComp e₂ (ptdComp e₁ k₁)).1.op) ((F.obj.map ha.1.op) a.2) := by
        have h := congrArg (fun g => (F.obj.map g.op) a.2) h1
        dsimp [ptdComp] at h ⊢
        repeat rw [F.obj.map_comp] at h
        repeat rw [F.obj.map_comp]
        exact h
      have hb_eq : (F.obj.map (ptdComp e₂ (ptdComp e₁ k₀)).1.op) ((F.obj.map hb₀.1.op) b.2) =
          (F.obj.map (ptdComp e₂ (ptdComp e₁ k₁)).1.op) ((F.obj.map hb.1.op) b.2) := by
        have h := congrArg (fun g => (F.obj.map g.op) b.2) h2
        dsimp [ptdComp] at h ⊢
        repeat rw [F.obj.map_comp] at h
        repeat rw [F.obj.map_comp]
        exact h
      exact congrArg₂ (· + ·) ha_eq hb_eq
    have hAddResp : ∀ (a₁ a₂ b₁ b₂ : Carrier),
        setoid_F a₁ b₁ → setoid_F a₂ b₂ → addRaw a₁ a₂ = addRaw b₁ b₂ := by
      rintro a₁ a₂ b₁ b₂ ⟨ia, ha₁, hb₁, heq₁⟩ ⟨ib, ha₂, hb₂, heq₂⟩
      obtain ⟨ic, ⟨ka⟩, ⟨kb⟩⟩ := hCone₂ ia ib
      rw [hAddAny a₁ a₂ ic (ptdComp ka ha₁) (ptdComp kb ha₂),
          hAddAny b₁ b₂ ic (ptdComp ka hb₁) (ptdComp kb hb₂)]
      congr 2
      have h1 : (F.obj.map (ptdComp ka ha₁).1.op) a₁.2 =
          (F.obj.map (ptdComp ka hb₁).1.op) b₁.2 := by
        dsimp [ptdComp]; rw [F.obj.map_comp, F.obj.map_comp]
        exact congrArg (F.obj.map ka.1.op) heq₁
      have h2 : (F.obj.map (ptdComp kb ha₂).1.op) a₂.2 =
          (F.obj.map (ptdComp kb hb₂).1.op) b₂.2 := by
        dsimp [ptdComp]; rw [F.obj.map_comp, F.obj.map_comp]
        exact congrArg (F.obj.map kb.1.op) heq₂
      exact congrArg₂ (· + ·) h1 h2
    let zero_QF : Q_F := Quotient.mk setoid_F ⟨i₀, 0⟩
    have hZeroAny : ∀ i : I_u, Quotient.mk setoid_F ⟨i, 0⟩ = zero_QF := by
      intro i
      obtain ⟨ic, ⟨h₁⟩, ⟨h₂⟩⟩ := hCone₂ i i₀
      apply Quotient.sound
      exact ⟨ic, h₁, h₂, by rw [map_zero, map_zero]⟩
    let add_QF : Q_F → Q_F → Q_F := Quotient.lift₂ addRaw hAddResp
    let neg_QF : Q_F → Q_F :=
      Quotient.lift (fun a => Quotient.mk setoid_F ⟨a.1, -a.2⟩) (by
        rintro a b ⟨ic, ha, hb, heq⟩
        apply Quotient.sound
        exact ⟨ic, ha, hb, by rw [map_neg, map_neg, heq]⟩)
    have hEquivAt : ∀ (a : Carrier) (ic : I_u) (ha : PtdHom ic a.1),
        Quotient.mk setoid_F a = Quotient.mk setoid_F ⟨ic, (F.obj.map ha.1.op) a.2⟩ := by
      intro a ic ha
      apply Quotient.sound
      exact ⟨ic, ha, ptdId ic, by dsimp [ptdId]; rw [F.obj.map_id]; rfl⟩
    have hAddSame : ∀ (i : I_u) (s₁ s₂ : ↥(F.obj.obj (Opposite.op (W_m i.1)))),
        addRaw ⟨i, s₁⟩ ⟨i, s₂⟩ = Quotient.mk setoid_F ⟨i, s₁ + s₂⟩ := by
      intro i s₁ s₂
      rw [hAddAny ⟨i, s₁⟩ ⟨i, s₂⟩ i (ptdId i) (ptdId i)]
      dsimp [ptdId]; rw [F.obj.map_id]; rfl
    let _ : Zero Q_F := ⟨zero_QF⟩
    let _ : Add Q_F := ⟨add_QF⟩
    let _ : Neg Q_F := ⟨neg_QF⟩
    let _ : AddCommGroup Q_F :=
      { add := add_QF
        zero := zero_QF
        neg := neg_QF
        sub := fun x y => add_QF x (neg_QF y)
        sub_eq_add_neg := fun _ _ => rfl
        add_assoc := Quotient.ind fun a => Quotient.ind fun b => Quotient.ind fun c => by
          obtain ⟨iab, ⟨ha₀⟩, ⟨hb₀⟩⟩ := hCone₂ a.1 b.1
          obtain ⟨iabc, ⟨hab⟩, ⟨hc⟩⟩ := hCone₂ iab c.1
          rw [hEquivAt a iabc (ptdComp hab ha₀), hEquivAt b iabc (ptdComp hab hb₀),
              hEquivAt c iabc hc]
          change add_QF (addRaw _ _) _ = add_QF _ (addRaw _ _)
          rw [hAddSame, hAddSame]
          change addRaw _ _ = addRaw _ _
          rw [hAddSame, hAddSame, _root_.add_assoc]
        zero_add := Quotient.ind fun a => by
          rw [← hZeroAny a.1]
          change addRaw ⟨a.1, 0⟩ a = _
          rw [hAddSame, _root_.zero_add]
        add_zero := Quotient.ind fun a => by
          rw [← hZeroAny a.1]
          change addRaw a ⟨a.1, 0⟩ = _
          rw [hAddSame, _root_.add_zero]
        nsmul := nsmulRec
        nsmul_zero := fun _ => rfl
        nsmul_succ := fun _ _ => rfl
        zsmul := zsmulRec
        zsmul_zero' := fun _ => rfl
        zsmul_succ' := fun _ _ => rfl
        zsmul_neg' := fun _ _ => rfl
        neg_add_cancel := Quotient.ind fun a => by
          change addRaw ⟨a.1, -a.2⟩ a = zero_QF
          rw [hAddSame, _root_.neg_add_cancel, hZeroAny]
        add_comm := Quotient.ind fun a => Quotient.ind fun b => by
          obtain ⟨iab, ⟨ha⟩, ⟨hb⟩⟩ := hCone₂ a.1 b.1
          rw [hEquivAt a iab ha, hEquivAt b iab hb]
          change addRaw _ _ = addRaw _ _
          rw [hAddSame, hAddSame, _root_.add_comm] }
    let D_F : AddCommGrpCat.{u} := AddCommGrpCat.of Q_F
    let germHom : ∀ (i : I_u), F.obj.obj (Opposite.op (W_m i.1)) ⟶ D_F :=
      fun i => AddCommGrpCat.ofHom
        { toFun := fun s => Quotient.mk setoid_F ⟨i, s⟩
          map_zero' := hZeroAny i
          map_add' := fun s₁ s₂ => (hAddSame i s₁ s₂).symm }
    let Eqv_aff := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv Y AddCommGrpCat.{u}
    let G_target := P_push.obj (RK D_F)
    let idxToPt : ∀ {E : Y.Etale}, Idx (B_u.obj E) →
        { u_E : S_k ⟶ E.left // u_E ≫ E.hom = u } :=
      fun {E} τ =>
        ⟨τ.1 ≫ CategoryTheory.Limits.pullback.fst E.hom u, by
          erw [Category.assoc, CategoryTheory.Limits.pullback.condition]
          change (τ.1 ≫ (B_u.obj E).hom) ≫ u = u
          erw [τ.2, Category.id_comp]⟩
    have hIdxEqMk : ∀ {E : Y.Etale} (τ : Idx (B_u.obj E)),
        mkIdx E (idxToPt τ).1 (idxToPt τ).2 = τ := by
      intro E τ
      apply Subtype.ext
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      · erw [CategoryTheory.Limits.pullback.lift_snd]; exact τ.2.symm
    let θ_aff : (Eqv_aff.inverse.obj F).obj ⟶ (Eqv_aff.inverse.obj G_target).obj :=
      { app := fun X_op =>
          let X := X_op.unop
          let m : M_Y := e_Y.functor.obj X
          let φ_X : ι_aff.obj X ≅ W_m m := ι_aff.mapIso (e_Y.unitIso.app X)
          AddCommGrpCat.ofHom
            { toFun := fun s τ =>
                let u_X := idxToPt τ
                let u_m : S_k ⟶ (W_m m).left := u_X.1 ≫ φ_X.hom.left
                have hu_m : u_m ≫ (W_m m).hom = u := by
                  erw [Category.assoc, CategoryTheory.MorphismProperty.Over.w φ_X.hom]
                  exact u_X.2
                germHom ⟨m, u_m, hu_m⟩ ((F.obj.map φ_X.inv.op) s)
              map_zero' := by ext τ; dsimp; rw [map_zero, map_zero]
              map_add' := fun s₁ s₂ => by ext τ; dsimp; rw [map_add, map_add] }
        naturality := fun {X₂_op X₁_op} f_op => by
          let f : X₁_op.unop ⟶ X₂_op.unop := f_op.unop
          let X₁ := X₁_op.unop
          let X₂ := X₂_op.unop
          let m₁ : M_Y := e_Y.functor.obj X₁
          let m₂ : M_Y := e_Y.functor.obj X₂
          let φ₁ : ι_aff.obj X₁ ≅ W_m m₁ := ι_aff.mapIso (e_Y.unitIso.app X₁)
          let φ₂ : ι_aff.obj X₂ ≅ W_m m₂ := ι_aff.mapIso (e_Y.unitIso.app X₂)
          apply AddCommGrpCat.ext
          intro s
          funext τ
          let u₁ := idxToPt τ
          let τ₂ : Idx (B_u.obj (ι_aff.obj X₂)) :=
            ⟨τ.1 ≫ (B_u.map (ι_aff.map f)).left, by
              erw [Category.assoc,
                CategoryTheory.MorphismProperty.Over.w (B_u.map (ι_aff.map f)), τ.2]⟩
          let u₂ := idxToPt τ₂
          let i₁ : I_u := ⟨m₁, u₁.1 ≫ φ₁.hom.left, by
            erw [Category.assoc, CategoryTheory.MorphismProperty.Over.w φ₁.hom]; exact u₁.2⟩
          let i₂ : I_u := ⟨m₂, u₂.1 ≫ φ₂.hom.left, by
            erw [Category.assoc, CategoryTheory.MorphismProperty.Over.w φ₂.hom]; exact u₂.2⟩
          change germHom i₁ ((F.obj.map φ₁.inv.op) ((F.obj.map (ι_aff.map f).op) s)) =
            germHom i₂ ((F.obj.map φ₂.inv.op) s)
          have hu₁₂ : u₁.1 ≫ (ι_aff.map f).left = u₂.1 := by
            dsimp [u₁, u₂, τ₂, idxToPt]
            exact (Category.assoc _ _ _).trans
              ((congrArg (τ.1 ≫ ·) (hBu_fst (ι_aff.map f))).symm.trans
                (Category.assoc _ _ _).symm)
          let g_m : W_m m₁ ⟶ W_m m₂ := φ₁.inv ≫ ι_aff.map f ≫ φ₂.hom
          have hg_ptd : i₁.2.1 ≫ g_m.left = i₂.2.1 := by
            change (u₁.1 ≫ φ₁.hom.left) ≫ (φ₁.inv.left ≫ (ι_aff.map f).left ≫ φ₂.hom.left) =
              u₂.1 ≫ φ₂.hom.left
            have hinv : φ₁.hom.left ≫ φ₁.inv.left = 𝟙 (ι_aff.obj X₁).left :=
              congrArg (fun g : ι_aff.obj X₁ ⟶ ι_aff.obj X₁ => g.left) φ₁.hom_inv_id
            erw [Category.assoc, ← Category.assoc φ₁.hom.left, hinv, Category.id_comp,
              ← Category.assoc, hu₁₂]
          apply Quotient.sound
          refine ⟨i₁, ptdId i₁, ⟨g_m, hg_ptd⟩, ?_⟩
          dsimp [ptdId, g_m]
          rw [F.obj.map_id, F.obj.map_comp, F.obj.map_comp]
          have hinv₂ : φ₂.hom ≫ φ₂.inv = 𝟙 (ι_aff.obj X₂) := φ₂.hom_inv_id
          have hmap₂ : F.obj.map φ₂.inv.op ≫ F.obj.map φ₂.hom.op =
              𝟙 (F.obj.obj (Opposite.op (ι_aff.obj X₂))) :=
            (F.obj.map_comp _ _).symm.trans
              ((congrArg (fun g => F.obj.map g.op) hinv₂).trans (F.obj.map_id _))
          change ((F.obj.map (ι_aff.map f).op ≫ F.obj.map φ₁.inv.op) s) =
            ((F.obj.map φ₂.inv.op ≫ F.obj.map φ₂.hom.op) ≫
              F.obj.map (ι_aff.map f).op ≫ F.obj.map φ₁.inv.op) s
          rw [hmap₂, Category.id_comp] }
    let Θ_sh : F ⟶ G_target := Eqv_aff.inverse.preimage ⟨θ_aff⟩
    have hΘ_map : Eqv_aff.inverse.map Θ_sh = ⟨θ_aff⟩ := Eqv_aff.inverse.map_preimage ⟨θ_aff⟩
    obtain ⟨α_N, hα_N⟩ := hΨ_surj Θ_sh
    have hα_eval_aff : ∀ (X : Y.AffineEtale) (s : ↥(F.obj.obj (Opposite.op (ι_aff.obj X))))
        (τ : Idx (B_u.obj (ι_aff.obj X))),
        α_N (ev₀ (ι_aff.obj X) τ s) = (θ_aff.app (Opposite.op X) s) τ := by
      intro X s τ
      rw [← hΨ_app α_N (ι_aff.obj X) s τ, hα_N]
      have h_app := congrArg (fun m : Eqv_aff.inverse.obj F ⟶ Eqv_aff.inverse.obj G_target =>
        m.hom.app (Opposite.op X)) hΘ_map
      exact congrFun (congrArg (fun m => m s) h_app) τ
    let β_fn : Q_F → ↥N :=
      Quotient.lift (fun a => ev₀ (W_m a.1.1) (mkIdx (W_m a.1.1) a.1.2.1 a.1.2.2) a.2) (by
        rintro a b ⟨ic, ha, hb, heq⟩
        have hca : (F.obj.map ha.1.op ≫ ev₀ (W_m ic.1) (mkIdx (W_m ic.1) ic.2.1 ic.2.2)) a.2 =
            ev₀ (W_m a.1.1) (mkIdx (W_m a.1.1) a.1.2.1 a.1.2.2) a.2 := by
          rw [hev₀_mor (W_m ic.1) (W_m a.1.1) ha.1 _ _]
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact (Category.assoc _ _ _).trans
              ((congrArg (_ ≫ ·) (hBu_fst ha.1)).trans
                ((Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ ha.1.left) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                    (ha.2.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm))))
          · change _ ≫ (B_u.map ha.1).left ≫ (B_u.obj (W_m a.1.1)).hom = _
            erw [CategoryTheory.MorphismProperty.Over.w (B_u.map ha.1),
              (mkIdx (W_m ic.1) ic.2.1 ic.2.2).2]
            exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
        have hcb : (F.obj.map hb.1.op ≫ ev₀ (W_m ic.1) (mkIdx (W_m ic.1) ic.2.1 ic.2.2)) b.2 =
            ev₀ (W_m b.1.1) (mkIdx (W_m b.1.1) b.1.2.1 b.1.2.2) b.2 := by
          rw [hev₀_mor (W_m ic.1) (W_m b.1.1) hb.1 _ _]
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact (Category.assoc _ _ _).trans
              ((congrArg (_ ≫ ·) (hBu_fst hb.1)).trans
                ((Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ hb.1.left) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                    (hb.2.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm))))
          · change _ ≫ (B_u.map hb.1).left ≫ (B_u.obj (W_m b.1.1)).hom = _
            erw [CategoryTheory.MorphismProperty.Over.w (B_u.map hb.1),
              (mkIdx (W_m ic.1) ic.2.1 ic.2.2).2]
            exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
        change ev₀ (W_m ic.1) _ ((F.obj.map ha.1.op) a.2) = _ at hca
        change ev₀ (W_m ic.1) _ ((F.obj.map hb.1.op) b.2) = _ at hcb
        rw [← hca, ← hcb, heq])
    let β_N : D_F ⟶ N := AddCommGrpCat.ofHom
      { toFun := β_fn
        map_zero' := (ev₀ (W_m i₀.1) (mkIdx (W_m i₀.1) i₀.2.1 i₀.2.2)).hom.map_zero
        map_add' := Quotient.ind fun a => Quotient.ind fun b => by
          obtain ⟨iab, ⟨ha⟩, ⟨hb⟩⟩ := hCone₂ a.1 b.1
          rw [hEquivAt a iab ha, hEquivAt b iab hb]
          change β_fn (addRaw _ _) = β_fn (Quotient.mk setoid_F _) + β_fn (Quotient.mk setoid_F _)
          rw [hAddSame]
          exact (ev₀ (W_m iab.1) (mkIdx (W_m iab.1) iab.2.1 iab.2.2)).hom.map_add _ _ }
    have hαβ : α_N ≫ β_N = 𝟙 N := by
      apply hΨ_inj
      apply Eqv_aff.inverse.map_injective
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      refine funext (Opposite.rec fun X => ?_)
      change (Ψ_hom (α_N ≫ β_N)).hom.app (Opposite.op (ι_aff.obj X)) =
        (Ψ_hom (𝟙 N)).hom.app (Opposite.op (ι_aff.obj X))
      apply AddCommGrpCat.ext
      intro s
      funext τ
      rw [hΨ_app, hΨ_app]
      change β_N (α_N (ev₀ (ι_aff.obj X) τ s)) = ev₀ (ι_aff.obj X) τ s
      rw [hα_eval_aff X s τ]
      dsimp [θ_aff, β_N, β_fn, germHom]
      let m : M_Y := e_Y.functor.obj X
      let φ_X : ι_aff.obj X ≅ W_m m := ι_aff.mapIso (e_Y.unitIso.app X)
      let u_X := idxToPt τ
      let u_m : S_k ⟶ (W_m m).left := u_X.1 ≫ φ_X.hom.left
      have hu_m : u_m ≫ (W_m m).hom = u := by
        erw [Category.assoc, CategoryTheory.MorphismProperty.Over.w φ_X.hom]; exact u_X.2
      have htau_eq : (mkIdx (W_m m) u_m hu_m).1 ≫ (B_u.map φ_X.inv).left = τ.1 := by
        erw [← hIdxEqMk τ]
        apply CategoryTheory.Limits.pullback.hom_ext
        · have hinv : φ_X.hom.left ≫ φ_X.inv.left = 𝟙 (ι_aff.obj X).left :=
            congrArg (fun g : ι_aff.obj X ⟶ ι_aff.obj X => g.left) φ_X.hom_inv_id
          have h_u_inv : u_m ≫ φ_X.inv.left = u_X.1 := by
            change (u_X.1 ≫ φ_X.hom.left) ≫ φ_X.inv.left = u_X.1
            erw [Category.assoc, hinv, Category.comp_id]
          exact (Category.assoc _ _ _).trans
            ((congrArg (_ ≫ ·) (hBu_fst φ_X.inv)).trans
              ((Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ φ_X.inv.left) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  (h_u_inv.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm))))
        · change _ ≫ (B_u.map φ_X.inv).left ≫ (B_u.obj (ι_aff.obj X)).hom = _
          erw [CategoryTheory.MorphismProperty.Over.w (B_u.map φ_X.inv),
            (mkIdx (W_m m) u_m hu_m).2]
          exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
      exact congrArg (fun m_hom => m_hom s) (hev₀_mor (W_m m) (ι_aff.obj X) φ_X.inv _ τ htau_eq)
    refine ⟨ev, hCompat, ?_⟩
    intro x
    obtain ⟨⟨i, s⟩, hq_eq⟩ := Quotient.exists_rep (α_N x)
    refine ⟨W_m i.1, hAff_Wm i.1, i.2.1, i.2.2, s, ?_⟩
    change β_N (Quotient.mk setoid_F ⟨i, s⟩) = x
    rw [hq_eq]
    exact congrArg (fun m_hom => m_hom x) hαβ

  
  obtain ⟨ev₀, hCompat₀, hSurj₀⟩ := hGermPres U₀ s₀ G₀ H₀ hPb₀
  have hTors_G₀_sec : ∀ E : U₀.Etale,
      ℓ • CategoryTheory.CategoryStruct.id (G₀.obj.obj (Opposite.op E)) = 0 := by
    intro E
    letI : (CategoryTheory.sheafToPresheaf U₀.smallEtaleTopology AddCommGrpCat.{u}).Additive :=
      hS2P_add U₀
    let ev_E := CategoryTheory.sheafToPresheaf U₀.smallEtaleTopology AddCommGrpCat.{u} ⋙
      (CategoryTheory.evaluation (U₀.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op E)
    change ℓ • ev_E.map (CategoryTheory.CategoryStruct.id G₀) = 0
    rw [← ev_E.map_nsmul, hTors, ev_E.map_zero]

  have hAffProd : ∀ (n : ℕ) (E_f : Fin n → U₀.Etale)
      (_ : ∀ i, AlgebraicGeometry.IsAffine (E_f i).left)
      (u_f : ∀ i, S_k ⟶ (E_f i).left)
      (_ : ∀ i, u_f i ≫ (E_f i).hom = s₀),
      ∃ (P_n : U₀.Etale) (_ : AlgebraicGeometry.IsAffine P_n.left)
        (u_n : S_k ⟶ P_n.left) (hu_n : u_n ≫ P_n.hom = s₀)
        (π_n : ∀ i : Fin n, P_n ⟶ E_f i),
        ∀ i : Fin n, u_n ≫ (π_n i).left = u_f i := by
    intro n
    induction n with
    | zero =>
      intro E_f _ u_f _
      have hAff_T : AlgebraicGeometry.IsAffine (termObj U₀).left :=
        inferInstanceAs (AlgebraicGeometry.IsAffine U₀)
      exact ⟨termObj U₀, hAff_T, s₀, Category.comp_id s₀, fun i => Fin.elim0 i, fun i => Fin.elim0 i⟩
    | succ n ih =>
      intro E_f hAff_f u_f hu_f
      obtain ⟨P_n, hAff_Pn, u_n, hu_n, π_n, hπ_n⟩ :=
        ih (fun i => E_f i.castSucc) (fun i => hAff_f i.castSucc)
          (fun i => u_f i.castSucc) (fun i => hu_f i.castSucc)
      let E_last : U₀.Etale := E_f (Fin.last n)
      haveI : AlgebraicGeometry.IsAffine P_n.left := hAff_Pn
      haveI : AlgebraicGeometry.IsAffine E_last.left := hAff_f (Fin.last n)
      let f_Pn : P_n.left ⟶ U₀ := P_n.hom
      let f_El : E_last.left ⟶ U₀ := E_last.hom
      haveI : AlgebraicGeometry.Etale f_Pn := P_n.prop
      haveI : AlgebraicGeometry.Etale f_El := E_last.prop
      let fst := CategoryTheory.Limits.pullback.fst f_Pn f_El
      let snd := CategoryTheory.Limits.pullback.snd f_Pn f_El
      let P_succ : U₀.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (fst ≫ f_Pn) inferInstance
      have hAff_W : AlgebraicGeometry.IsAffine P_succ.left := by
        change AlgebraicGeometry.IsAffine (CategoryTheory.Limits.pullback f_Pn f_El)
        infer_instance
      let u_succ : S_k ⟶ P_succ.left :=
        CategoryTheory.Limits.pullback.lift u_n (u_f (Fin.last n))
          (hu_n.trans (hu_f (Fin.last n)).symm)
      have hu_succ : u_succ ≫ P_succ.hom = s₀ := by
        change u_succ ≫ fst ≫ P_n.hom = s₀
        erw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hu_n]
      let π_fst : P_succ ⟶ P_n := CategoryTheory.MorphismProperty.Over.homMk fst rfl
      let π_snd : P_succ ⟶ E_last := CategoryTheory.MorphismProperty.Over.homMk snd
        CategoryTheory.Limits.pullback.condition.symm
      refine ⟨P_succ, hAff_W, u_succ, hu_succ,
        Fin.lastCases π_snd (fun i => π_fst ≫ π_n i), ?_⟩
      intro i
      refine Fin.lastCases ?_ (fun j => ?_) i
      · simp only [Fin.lastCases_last]
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _
      · simp only [Fin.lastCases_castSucc]
        change u_succ ≫ (fst ≫ (π_n j).left) = u_f j.castSucc
        erw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hπ_n j]

  have hBasisLift : ∃ (E_prod : U₀.Etale) (_ : AlgebraicGeometry.IsAffine E_prod.left)
      (s_prod : S_k ⟶ E_prod.left) (hs_prod : s_prod ≫ E_prod.hom = s₀)
      (α_prod : M₀ ⟶ G₀.obj.obj (Opposite.op E_prod)),
      α_prod ≫ ev₀ E_prod s_prod hs_prod = CategoryTheory.CategoryStruct.id M₀ := by
    have hprime : Nat.Prime ℓ := Fact.out
    rcases Nat.exists_eq_succ_of_ne_zero hprime.ne_zero with ⟨ℓ', rfl⟩
    haveI : Finite ↥M₀ := hFin_M₀
    have hTorsM' : ∀ m : ↥M₀, (ℓ' + 1) • m = 0 := fun m => by
      have h1 := congrArg (fun f : M₀ ⟶ M₀ => f m) hTors_M₀
      simpa using h1
    letI : Module (ZMod (ℓ' + 1)) ↥M₀ := AddCommGroup.zmodModule hTorsM'
    haveI : Module.Finite (ZMod (ℓ' + 1)) ↥M₀ := Module.Finite.of_finite
    let r := Module.finrank (ZMod (ℓ' + 1)) ↥M₀
    let b : Module.Basis (Fin r) (ZMod (ℓ' + 1)) ↥M₀ := Module.finBasis (ZMod (ℓ' + 1)) ↥M₀
    choose E_b hAff_Eb s_b hs_b σ_b hσ_b using fun j : Fin r => hSurj₀ (b j)
    obtain ⟨E_prod, hAff_prod, s_prod, hs_prod, π_b, hπ_b⟩ :=
      hAffProd r E_b hAff_Eb s_b hs_b
    let σ_tilde : Fin r → ↥(G₀.obj.obj (Opposite.op E_prod)) :=
      fun j => (G₀.obj.map (π_b j).op) (σ_b j)
    have hσ_tilde : ∀ j : Fin r, (ev₀ E_prod s_prod hs_prod) (σ_tilde j) = b j := by
      intro j
      change (G₀.obj.map (π_b j).op ≫ ev₀ E_prod s_prod hs_prod) (σ_b j) = b j
      rw [hCompat₀ E_prod (E_b j) (π_b j) s_prod (s_b j) hs_prod (hs_b j) (hπ_b j), hσ_b j]
    have hTorsG' : ∀ x : ↥(G₀.obj.obj (Opposite.op E_prod)), (ℓ' + 1) • x = 0 := fun x => by
      have h1 := congrArg (fun f : G₀.obj.obj (Opposite.op E_prod) ⟶ _ => f x) (hTors_G₀_sec E_prod)
      simpa using h1
    letI : Module (ZMod (ℓ' + 1)) ↥(G₀.obj.obj (Opposite.op E_prod)) :=
      AddCommGroup.zmodModule hTorsG'
    let L_map : ↥M₀ →ₗ[ZMod (ℓ' + 1)] ↥(G₀.obj.obj (Opposite.op E_prod)) :=
      b.constr (ZMod (ℓ' + 1)) σ_tilde
    let α_prod : M₀ ⟶ G₀.obj.obj (Opposite.op E_prod) :=
      AddCommGrpCat.ofHom L_map.toAddMonoidHom
    refine ⟨E_prod, hAff_prod, s_prod, hs_prod, α_prod, ?_⟩
    have hLinEq : (α_prod ≫ ev₀ E_prod s_prod hs_prod).hom.toZModLinearMap (ℓ' + 1) =
        (CategoryTheory.CategoryStruct.id M₀).hom.toZModLinearMap (ℓ' + 1) := by
      apply b.ext
      intro j
      change (ev₀ E_prod s_prod hs_prod) (L_map (b j)) = b j
      rw [Module.Basis.constr_basis, hσ_tilde j]
    apply AddCommGrpCat.ext
    intro m
    exact congrArg (fun f : ↥M₀ →ₗ[ZMod (ℓ' + 1)] ↥M₀ => f m) hLinEq

  obtain ⟨E_prod, hAff_prod, s_prod, hs_prod, α_prod, hSplit_prod⟩ := hBasisLift

  
  haveI : AlgebraicGeometry.IsAffine E_prod.left := hAff_prod
  haveI : AlgebraicGeometry.Etale E_prod.hom := E_prod.prop
  obtain ⟨W₀, hAff_W₀, hInt_W₀, j₀, hEt_j₀, s_W, hs_W_j₀⟩ :=
    hShrink E_prod.left E_prod.hom s_prod hs_prod
  haveI : AlgebraicGeometry.Etale j₀ := hEt_j₀
  let w₀ : W₀ ⟶ U₀ := j₀ ≫ E_prod.hom
  have hw₀ : AlgebraicGeometry.Etale w₀ := by dsimp [w₀]; infer_instance
  have hs_W : s_W ≫ w₀ = s₀ := by
    dsimp [w₀]
    rw [← Category.assoc, hs_W_j₀, hs_prod]
  let E_W : U₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w₀ hw₀
  let g_j : E_W ⟶ E_prod := CategoryTheory.MorphismProperty.Over.homMk j₀ rfl
  let α₀ : M₀ ⟶ G₀.obj.obj (Opposite.op E_W) := α_prod ≫ G₀.obj.map g_j.op
  have hSplit₀ : α₀ ≫ ev₀ E_W s_W hs_W = CategoryTheory.CategoryStruct.id M₀ := by
    dsimp [α₀]
    rw [Category.assoc, hCompat₀ E_W E_prod g_j s_W s_prod hs_W hs_prod hs_W_j₀, hSplit_prod]

  
  letI := CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    (W := @AlgebraicGeometry.Etale)
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) w₀ :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
      (@AlgebraicGeometry.Etale) w₀ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let Map_w : CategoryTheory.Functor W₀.Etale U₀.Etale :=
    CategoryTheory.MorphismProperty.Over.map ⊤ hw₀
  let B_w : CategoryTheory.Functor U₀.Etale W₀.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ w₀
  let adj₀ : Map_w ⊣ B_w :=
    CategoryTheory.MorphismProperty.Over.mapPullbackAdj (@AlgebraicGeometry.Etale) ⊤ w₀ hw₀ trivial

  have hMap_cont : Map_w.IsContinuous W₀.smallEtaleTopology U₀.smallEtaleTopology := by
    have hCompat_w : CategoryTheory.CompatiblePreserving U₀.smallEtaleTopology Map_w := by
      refine ⟨fun ℱ {W} {T} {x} hx {Y₁ Y₂} {X} f₁ f₂ {g₁ g₂} hg₁ hg₂ hcomm => ?_⟩
      have hf₁_et : AlgebraicGeometry.Etale f₁.left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) f₁.left
          (Y₁.hom ≫ w₀) (Map_w.obj Y₁).prop
          ((CategoryTheory.MorphismProperty.Over.w f₁).symm ▸ X.prop)
      have hf₂_et : AlgebraicGeometry.Etale f₂.left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) f₂.left
          (Y₂.hom ≫ w₀) (Map_w.obj Y₂).prop
          ((CategoryTheory.MorphismProperty.Over.w f₂).symm ▸ X.prop)
      let X_W : W₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom)
        (CategoryTheory.MorphismProperty.comp_mem _ _ _ hf₁_et Y₁.prop)
      have hleft_eq : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun m : X ⟶ Map_w.obj W => m.left) hcomm
      have hhom_eq : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom :=
        (congrArg (f₂.left ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₂).symm).trans
          ((Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ W.hom) hleft_eq.symm).trans
              ((Category.assoc _ _ _).trans
                (congrArg (f₁.left ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₁)))))
      let f₁_W : X_W ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk f₁.left rfl
      let f₂_W : X_W ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk f₂.left hhom_eq
      have hcomm_W : f₁_W ≫ g₁ = f₂_W ≫ g₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hleft_eq (Subsingleton.elim _ _)
      have hx_eq := hx f₁_W f₂_W hg₁ hg₂ hcomm_W
      let e_inv : X ⟶ Map_w.obj X_W := CategoryTheory.MorphismProperty.Over.homMk (𝟙 X.left)
        ((Category.id_comp _).trans
          ((Category.assoc f₁.left Y₁.hom w₀).trans
            (CategoryTheory.MorphismProperty.Over.w f₁)))
      have he₁ : e_inv ≫ Map_w.map f₁_W = f₁ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext (Category.id_comp f₁.left)
          (Subsingleton.elim _ _)
      have he₂ : e_inv ≫ Map_w.map f₂_W = f₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext (Category.id_comp f₂.left)
          (Subsingleton.elim _ _)
      rw [← he₁, ← he₂]
      erw [ℱ.obj.map_comp, ℱ.obj.map_comp]
      exact congrArg (ℱ.obj.map e_inv.op) hx_eq
    have hCov_w : CategoryTheory.CoverPreserving
        W₀.smallEtaleTopology U₀.smallEtaleTopology Map_w := by
      refine ⟨fun {W} {S} hS => ?_⟩
      obtain ⟨J, E, f, hfS, hcov⟩ := (hMemEtale W₀ W S).mp hS
      exact (hMemEtale U₀ (Map_w.obj W) (CategoryTheory.Sieve.functorPushforward Map_w S)).mpr
        ⟨J, fun j => Map_w.obj (E j), fun j => Map_w.map (f j),
          fun j => CategoryTheory.Sieve.image_mem_functorPushforward Map_w S (hfS j), hcov⟩
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat_w hCov_w

  have hBw_cont : B_w.IsContinuous U₀.smallEtaleTopology W₀.smallEtaleTopology := by
    haveI : B_w.IsRightAdjoint := adj₀.isRightAdjoint
    have hCompat_Bw : CategoryTheory.CompatiblePreserving W₀.smallEtaleTopology B_w :=
      CategoryTheory.compatiblePreservingOfFlat W₀.smallEtaleTopology B_w
    have hCov_Bw : CategoryTheory.CoverPreserving
        U₀.smallEtaleTopology W₀.smallEtaleTopology B_w := by
      refine ⟨fun {X} {S} hS => ?_⟩
      obtain ⟨J, E, f, hfS, hcov⟩ := (hMemEtale U₀ X S).mp hS
      refine (hMemEtale W₀ (B_w.obj X) (CategoryTheory.Sieve.functorPushforward B_w S)).mpr
        ⟨J, fun j => B_w.obj (E j), fun j => B_w.map (f j),
          fun j => CategoryTheory.Sieve.image_mem_functorPushforward B_w S (hfS j), ?_⟩
      intro z
      let fst_X := CategoryTheory.Limits.pullback.fst X.hom w₀
      let snd_X := CategoryTheory.Limits.pullback.snd X.hom w₀
      obtain ⟨j, y, hy⟩ := hcov (fst_X.base z)
      let fst_Ej := CategoryTheory.Limits.pullback.fst (E j).hom w₀
      let snd_Ej := CategoryTheory.Limits.pullback.snd (E j).hom w₀
      have hpb_right : CategoryTheory.IsPullback snd_X fst_X w₀ X.hom :=
        (CategoryTheory.IsPullback.of_hasPullback X.hom w₀).flip
      have hcomm_left : (B_w.map (f j)).left ≫ fst_X = fst_Ej ≫ (f j).left := by
        dsimp [B_w, CategoryTheory.MorphismProperty.Over.pullback]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      have htop_comp : (B_w.map (f j)).left ≫ snd_X = snd_Ej :=
        CategoryTheory.MorphismProperty.Over.w (B_w.map (f j))
      have hbot_comp : (f j).left ≫ X.hom = (E j).hom :=
        CategoryTheory.MorphismProperty.Over.w (f j)
      have hpb_outer : CategoryTheory.IsPullback ((B_w.map (f j)).left ≫ snd_X) fst_Ej
          w₀ ((f j).left ≫ X.hom) := by
        erw [htop_comp, hbot_comp]
        exact (CategoryTheory.IsPullback.of_hasPullback (E j).hom w₀).flip
      have hpb_left : CategoryTheory.IsPullback (B_w.map (f j)).left fst_Ej fst_X (f j).left :=
        (CategoryTheory.IsPullback.paste_horiz_iff hpb_right hcomm_left).mp hpb_outer
      obtain ⟨q, hq_fst, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := fst_X) (g := (f j).left) z y hy.symm
      refine ⟨j, hpb_left.isoPullback.inv.base q, ?_⟩
      change (hpb_left.isoPullback.inv ≫ (B_w.map (f j)).left).base q = z
      rw [hpb_left.isoPullback_inv_fst]
      exact hq_fst
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat_Bw hCov_Bw

  letI : Map_w.IsContinuous W₀.smallEtaleTopology U₀.smallEtaleTopology := hMap_cont
  letI : B_w.IsContinuous U₀.smallEtaleTopology W₀.smallEtaleTopology := hBw_cont
  let jw_pull := Map_w.sheafPushforwardContinuous AddCommGrpCat.{u}
    W₀.smallEtaleTopology U₀.smallEtaleTopology
  let G_W : CategoryTheory.Sheaf W₀.smallEtaleTopology AddCommGrpCat.{u} := jw_pull.obj G₀
  let pf_w := B_w.sheafPushforwardContinuous AddCommGrpCat.{u}
    U₀.smallEtaleTopology W₀.smallEtaleTopology
  let adj_jw : jw_pull ⊣ pf_w :=
    CategoryTheory.Adjunction.mkOfUnitCounit
      { unit :=
          { app := fun ℱ =>
              ⟨{ app := fun E_op => ℱ.obj.map (adj₀.counit.app E_op.unop).op
                 naturality := fun {E₂ E₁} f => by
                   dsimp [jw_pull, pf_w, Functor.sheafPushforwardContinuous]
                   rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]
                   exact congrArg (fun g => ℱ.obj.map g.op)
                     (adj₀.counit.naturality f.unop).symm }⟩
            naturality := fun {ℱ₁ ℱ₂} φ => by
              ext E_op x
              exact congrArg (fun m => m x) (φ.hom.naturality (adj₀.counit.app E_op.unop).op).symm }
        counit :=
          { app := fun ℋ =>
              ⟨{ app := fun W_op => ℋ.obj.map (adj₀.unit.app W_op.unop).op
                 naturality := fun {W₂ W₁} f => by
                   dsimp [jw_pull, pf_w, Functor.sheafPushforwardContinuous]
                   rw [← ℋ.obj.map_comp, ← ℋ.obj.map_comp]
                   exact congrArg (fun g => ℋ.obj.map g.op)
                     (adj₀.unit.naturality f.unop).symm }⟩
            naturality := fun {ℋ₁ ℋ₂} ψ => by
              ext W_op x
              exact congrArg (fun m => m x) (ψ.hom.naturality (adj₀.unit.app W_op.unop).op).symm }
        left_triangle := by
          apply CategoryTheory.NatTrans.ext; funext ℱ
          apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext W_op
          exact (ℱ.obj.map_comp _ _).symm.trans
            ((congrArg (fun g => ℱ.obj.map g.op) (adj₀.left_triangle_components W_op.unop)).trans
              (ℱ.obj.map_id _))
        right_triangle := by
          apply CategoryTheory.NatTrans.ext; funext ℋ
          apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext E_op
          exact (ℋ.obj.map_comp _ _).symm.trans
            ((congrArg (fun g => ℋ.obj.map g.op) (adj₀.right_triangle_components E_op.unop)).trans
              (ℋ.obj.map_id _)) }
  have hr_w : pf_w.IsRightAdjoint := adj_jw.isRightAdjoint
  letI : pf_w.IsRightAdjoint := hr_w
  let adj_Bw := B_w.sheafAdjunctionContinuous AddCommGrpCat.{u}
    U₀.smallEtaleTopology W₀.smallEtaleTopology
  let e_PB_GW : (B_w.sheafPullback AddCommGrpCat.{u}
      U₀.smallEtaleTopology W₀.smallEtaleTopology).obj G₀ ≅ G_W :=
    (adj_Bw.leftAdjointUniq adj_jw).app G₀
  have hPb_GW : WeilIsEtaleSheafPullback w₀ G₀ G_W := ⟨hBw_cont, hr_w, ⟨e_PB_GW⟩⟩

  let C_W₀ := CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}
  let constM₀ : (W₀.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := (CategoryTheory.Functor.const _).obj M₀
  let toEW : ∀ (Y_v : W₀.Etale), Map_w.obj Y_v ⟶ E_W :=
    fun Y_v => CategoryTheory.MorphismProperty.Over.homMk Y_v.hom rfl
  let α_pre : constM₀ ⟶ G_W.obj :=
    { app := fun Y_op => α₀ ≫ G₀.obj.map (toEW Y_op.unop).op
      naturality := fun {Y₂ Y₁} f => by
        have h_eq : Map_w.map f.unop ≫ toEW Y₂.unop = toEW Y₁.unop :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext
            (CategoryTheory.MorphismProperty.Over.w f.unop) (Subsingleton.elim _ _)
        exact (Category.id_comp _).trans
          ((congrArg (fun g => α₀ ≫ G₀.obj.map g.op) h_eq.symm).trans
            ((congrArg (α₀ ≫ ·) (G₀.obj.map_comp _ _)).trans
              (Category.assoc _ _ _).symm)) }
  let adj_sh := CategoryTheory.sheafificationAdjunction W₀.smallEtaleTopology AddCommGrpCat.{u}
  let Φ : C_W₀.obj M₀ ⟶ G_W := (adj_sh.homEquiv constM₀ G_W).symm α_pre
  let η_sh : constM₀ ⟶ (C_W₀.obj M₀).obj :=
    CategoryTheory.toSheafify W₀.smallEtaleTopology constM₀
  have hηΦ : η_sh ≫ Φ.hom = α_pre :=
    (adj_sh.homEquiv constM₀ G_W).apply_symm_apply α_pre

  refine ⟨M₀, hFin_M₀, W₀, hAff_W₀, hInt_W₀, w₀, hw₀, s_W, G_W, Φ,
    ⟨hTors_M₀, hCard_M₀⟩, hs_W, hPb_GW, ?_⟩
  intro K_s hPb_Ks
  apply hZero_Sk K_s
  refine ⟨fun x₁ x₂ => ?_⟩
  obtain ⟨ev_Ks, hCompat_Ks, hSurj_Ks⟩ :=
    hGermPres W₀ s_W (CategoryTheory.Limits.kernel Φ) K_s hPb_Ks
  have hx0 : ∀ x : ↥(K_s.obj.obj (Opposite.op T_k)), x = 0 := by
    intro x
    obtain ⟨E, _, u_E, hu_E, κ, hκ_x⟩ := hSurj_Ks x
    let ι_ker := CategoryTheory.Limits.kernel.ι Φ
    let c : ↥((C_W₀.obj M₀).obj.obj (Opposite.op E)) := (ι_ker.hom.app (Opposite.op E)) κ
    have : CategoryTheory.Presheaf.IsLocallySurjective W₀.smallEtaleTopology
        (CategoryTheory.toSheafify W₀.smallEtaleTopology constM₀) := inferInstance
    have hImg_mem : CategoryTheory.Presheaf.imageSieve η_sh c ∈ W₀.smallEtaleTopology E :=
      CategoryTheory.Presheaf.imageSieve_mem W₀.smallEtaleTopology
        (CategoryTheory.toSheafify W₀.smallEtaleTopology constM₀) c
    obtain ⟨J_c, E_c, f_c, hf_img, hcov_c⟩ := (hMemEtale W₀ E _).mp hImg_mem
    obtain ⟨j, z₀, hz₀⟩ := hcov_c (u_E.base pt_k)
    let E' : W₀.Etale := E_c j
    let g_et : E' ⟶ E := f_c j
    haveI : AlgebraicGeometry.Etale E.hom := E.prop
    haveI : AlgebraicGeometry.Etale E'.hom := E'.prop
    have hg_et_left : AlgebraicGeometry.Etale g_et.left :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        g_et.left E.hom E.prop
        ((CategoryTheory.MorphismProperty.Over.w g_et).symm ▸ E'.prop)
    haveI : AlgebraicGeometry.Etale g_et.left := hg_et_left
    let P_lift := CategoryTheory.Limits.pullback g_et.left u_E
    let fst_lift := CategoryTheory.Limits.pullback.fst g_et.left u_E
    let snd_lift := CategoryTheory.Limits.pullback.snd g_et.left u_E
    haveI : AlgebraicGeometry.Etale snd_lift := inferInstance
    obtain ⟨q₀, -, -⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
        (f := g_et.left) (g := u_E) z₀ pt_k hz₀
    obtain ⟨σ_lift, hσ_lift, -⟩ := hEtaleSecPt P_lift snd_lift q₀
    let u' : S_k ⟶ E'.left := σ_lift ≫ fst_lift
    have hu'_g : u' ≫ g_et.left = u_E := by
      dsimp [u']
      rw [Category.assoc, CategoryTheory.Limits.pullback.condition, ← Category.assoc,
        hσ_lift, Category.id_comp]
    have hu'_W : u' ≫ E'.hom = s_W := by
      erw [← CategoryTheory.MorphismProperty.Over.w g_et, ← Category.assoc, hu'_g, hu_E]
    obtain ⟨m, hm_eq⟩ := hf_img j
    have hΦ_m0 : (Φ.hom.app (Opposite.op E')) ((η_sh.app (Opposite.op E')) m) = 0 := by
      rw [hm_eq]
      have hnat_Φ := congrArg (fun k_hom => k_hom c) (Φ.hom.naturality g_et.op)
      dsimp at hnat_Φ
      rw [hnat_Φ]
      have hker0 : (Φ.hom.app (Opposite.op E)) c = 0 := by
        change ((ι_ker ≫ Φ).hom.app (Opposite.op E)) κ = 0
        rw [CategoryTheory.Limits.kernel.condition]
        have : (CategoryTheory.sheafToPresheaf W₀.smallEtaleTopology AddCommGrpCat.{u}).Additive :=
          hS2P_add W₀
        change ((CategoryTheory.sheafToPresheaf W₀.smallEtaleTopology AddCommGrpCat.{u}).map
          (0 : _ ⟶ _)).app (Opposite.op E) κ = 0
        rw [(CategoryTheory.sheafToPresheaf W₀.smallEtaleTopology AddCommGrpCat.{u}).map_zero]
        rfl
      rw [hker0, map_zero]
    have hα_m0 : (G₀.obj.map (toEW E').op) (α₀ m) = 0 := by
      have h1 := congrArg (fun k_hom => k_hom m) (congrArg (fun nt => nt.app (Opposite.op E')) hηΦ)
      exact h1.symm.trans hΦ_m0
    have hu'_U₀ : u' ≫ (Map_w.obj E').hom = s₀ := by
      change u' ≫ (E'.hom ≫ w₀) = s₀
      rw [← Category.assoc, hu'_W, hs_W]
    have hu'_toEW : u' ≫ (toEW E').left = s_W := hu'_W
    have hm_zero : m = 0 := by
      calc
        m = (α₀ ≫ ev₀ E_W s_W hs_W) m :=
          (congrArg (fun k_hom => k_hom m) hSplit₀).symm
        _ = (ev₀ E_W s_W hs_W) (α₀ m) := rfl
        _ = (G₀.obj.map (toEW E').op ≫ ev₀ (Map_w.obj E') u' hu'_U₀) (α₀ m) := by
          rw [hCompat₀ (Map_w.obj E') E_W (toEW E') u' s_W hu'_U₀ hs_W hu'_toEW]
        _ = (ev₀ (Map_w.obj E') u' hu'_U₀) ((G₀.obj.map (toEW E').op) (α₀ m)) := rfl
        _ = (ev₀ (Map_w.obj E') u' hu'_U₀) 0 := by rw [hα_m0]
        _ = 0 := map_zero _
    have hc_res0 : ((C_W₀.obj M₀).obj.map g_et.op) c = 0 := by
      rw [← hm_eq, hm_zero, map_zero]
    haveI : CategoryTheory.Limits.PreservesLimits
        (CategoryTheory.sheafToPresheaf W₀.smallEtaleTopology AddCommGrpCat.{u}) :=
      adj_sh.rightAdjoint_preservesLimits
    haveI : CategoryTheory.Mono
        ((CategoryTheory.sheafToPresheaf W₀.smallEtaleTopology AddCommGrpCat.{u}).map ι_ker) :=
      (CategoryTheory.sheafToPresheaf W₀.smallEtaleTopology AddCommGrpCat.{u}).map_mono ι_ker
    haveI : CategoryTheory.Mono
        (((CategoryTheory.evaluation _ _).obj (Opposite.op E')).map ι_ker.hom) :=
      ((CategoryTheory.evaluation _ _).obj (Opposite.op E')).map_mono ι_ker.hom
    have hInj_ι : Function.Injective (ι_ker.hom.app (Opposite.op E')) :=
      (AddCommGrpCat.mono_iff_injective _).mp inferInstance
    have hκ_res0 : ((CategoryTheory.Limits.kernel Φ).obj.map g_et.op) κ = 0 := by
      apply hInj_ι
      rw [map_zero]
      have hnat_ι := congrArg (fun k_hom => k_hom κ) (ι_ker.hom.naturality g_et.op)
      change (ι_ker.hom.app (Opposite.op E'))
          (((CategoryTheory.Limits.kernel Φ).obj.map g_et.op) κ) =
        ((C_W₀.obj M₀).obj.map g_et.op) c at hnat_ι
      exact hnat_ι.trans hc_res0
    calc
      x = (ev_Ks E u_E hu_E) κ := hκ_x.symm
      _ = ((CategoryTheory.Limits.kernel Φ).obj.map g_et.op ≫ ev_Ks E' u' hu'_W) κ := by
        rw [hCompat_Ks E' E g_et u' u_E hu'_W hu_E hu'_g]
      _ = (ev_Ks E' u' hu'_W) (((CategoryTheory.Limits.kernel Φ).obj.map g_et.op) κ) := rfl
      _ = (ev_Ks E' u' hu'_W) 0 := by rw [hκ_res0]
      _ = 0 := map_zero _
  rw [hx0 x₁, hx0 x₂]

theorem weil_cosp_curve_dense_generic_ker_zero_and_card_le_iso (W₀ : AlgebraicGeometry.Scheme.{u})
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (η_W : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W₀)
    (hDense : DenseRange η_W.base)
    (M₀ : AddCommGrpCat.{u}) [Finite ↥M₀]
    (G_W : CategoryTheory.Sheaf W₀.smallEtaleTopology AddCommGrpCat.{u})
    (Φ : (CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}).obj M₀ ⟶ G_W)
    (hKerη : ∀ (H_η : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback η_W (CategoryTheory.Limits.kernel Φ) H_η →
      CategoryTheory.Limits.IsZero H_η)
    (hCard : ∀ (K : Type u) [Field K] [IsAlgClosed K]
        (z : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ W₀)
        (H_z : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback z G_W H_z →
      Finite (H_z.H 0) ∧ Nat.card (H_z.H 0) ≤ Nat.card ↥M₀) :
    CategoryTheory.IsIso Φ :=
by
  have hMemEtale : ∀ {S : Scheme.{u}} (X : S.Etale) (R : Sieve X),
      R ∈ S.smallEtaleTopology X ↔
        ∀ (x : ↥X.left), ∃ (Y : S.Etale) (f : Y ⟶ X) (y : ↥Y.left),
          R.arrows f ∧ Etale f.left ∧ f.left.base y = x := by
    clear * -
    intro S X R
    let P_et : MorphismProperty Scheme.{u} := @Etale
    have _ : P_et.IsStableUnderComposition :=
      ⟨fun f g hf hg => by
        have _ : Etale f := hf
        have _ : Etale g := hg
        infer_instance⟩
    have h1 : S.smallEtaleTopology = S.smallGrothendieckTopology P_et := rfl
    have h2 : S.smallGrothendieckTopology P_et =
        (Scheme.smallPretopology P_et P_et (S := S)).toGrothendieck :=
      S.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology (P := P_et) (le_refl P_et)
    exact (h1.trans h2).symm ▸
      Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) X R

  have hAlgClosedSite : ∀ (K : Type u) [Field K] [IsAlgClosed K],
      let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
      let T_K : S_K.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 S_K)
      Nonempty (CategoryTheory.Limits.IsTerminal T_K) ∧
      (∀ (U : S_K.Etale), Nonempty ↥U.left → Nonempty (T_K ⟶ U)) ∧
      (∀ (A : AddCommGrpCat.{u}),
        Function.Injective
          ((CategoryTheory.toSheafify S_K.smallEtaleTopology
            ((CategoryTheory.Functor.const S_K.Etaleᵒᵖ).obj A)).app (Opposite.op T_K)) ∧
        Nonempty (↥(((CategoryTheory.constantSheaf S_K.smallEtaleTopology
          AddCommGrpCat.{u}).obj A).obj.obj (Opposite.op T_K)) ≃ ↥A)) ∧
      (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u}}
          (ψ : ℱ₁ ⟶ ℱ₂),
        Function.Surjective (ψ.hom.app (Opposite.op T_K)) →
        CategoryTheory.Epi ψ) := by
    clear * - hMemEtale
    intro K _ _ S_K T_K
    have hT_K : Limits.IsTerminal T_K :=
      Limits.IsTerminal.ofUniqueHom
        (fun E => MorphismProperty.Over.homMk E.hom (Category.comp_id E.hom))
        (fun E m => (Scheme.Etale.forget S_K).map_injective (Over.OverMorphism.ext (by
          have hw : m.left ≫ 𝟙 S_K = E.hom := m.w
          exact (Category.comp_id m.left).symm.trans hw)))
    have hLiftPt : ∀ (U : S_K.Etale) (x : ↥U.left),
        ∃ f_x : T_K ⟶ U, f_x.left.base (⊥ : PrimeSpectrum K) = x := by
      intro U x
      obtain ⟨V_x, hAff, hx, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := x) (U := (⊤ : U.left.Opens)) trivial
      let R_U : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op V_x)
      let B : Type u := ↑R_U
      let e_spec : V_x.toScheme ≅ Spec R_U := hAff.isoSpec
      let j_V : Spec R_U ⟶ U.left := e_spec.inv ≫ V_x.ι
      have _ : IsOpenImmersion j_V := by dsimp [j_V]; infer_instance
      have _ : Etale j_V := inferInstance
      have _ : Etale U.hom := U.prop
      let φ_KB : CommRingCat.of K ⟶ R_U := Spec.preimage (j_V ≫ U.hom)
      have hSpec_φ : Spec.map φ_KB = j_V ≫ U.hom := Spec.map_preimage _
      have hEt_Spec : Etale (Spec.map φ_KB) := by rw [hSpec_φ]; infer_instance
      have hEt_hom : φ_KB.hom.Etale := (HasRingHomProperty.Spec_iff (P := @Etale)).mp hEt_Spec
      let _ : Algebra K B := φ_KB.hom.toAlgebra
      have _ : Algebra.Etale K B := RingHom.etale_algebraMap.mp hEt_hom
      obtain ⟨I, hFinI, L, hFieldL, hAlgL, Θ, hFinSep⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K B).mp inferInstance
      have _ : Finite I := hFinI
      let _ : DecidableEq I := Classical.decEq I
      let _ : Fintype I := Fintype.ofFinite I
      let _ : ∀ i, Field (L i) := hFieldL
      let _ : ∀ i, Algebra K (L i) := hAlgL
      let p₀ : PrimeSpectrum B := e_spec.hom.base ⟨x, hx⟩
      let q₀ : Ideal (∀ i : I, L i) := Ideal.comap Θ.symm.toRingHom p₀.asIdeal
      have hq₀_prime : q₀.IsPrime := Ideal.comap_isPrime Θ.symm.toRingHom p₀.asIdeal
      have hex_i₀ : ∃ i₀ : I, Pi.single i₀ (1 : L i₀) ∉ q₀ := by
        by_contra! hall
        have hsum : (∑ i : I, Pi.single i (1 : L i)) = (1 : ∀ i : I, L i) := by
          ext j
          simp [Finset.sum_apply]
        have h1_mem : (1 : ∀ i : I, L i) ∈ q₀ := by
          rw [← hsum]
          exact Ideal.sum_mem q₀ (fun i _ => hall i)
        exact hq₀_prime.ne_top ((Ideal.eq_top_iff_one q₀).mpr h1_mem)
      obtain ⟨i₀, hi₀_not_mem⟩ := hex_i₀
      have hq₀_iff : ∀ f : ∀ i : I, L i, f ∈ q₀ ↔ f i₀ = 0 := by
        intro f
        constructor
        · intro hf
          by_contra hne
          have hmul : Pi.single i₀ (f i₀)⁻¹ * f = Pi.single i₀ (1 : L i₀) := by
            ext j
            by_cases hj : j = i₀
            · subst hj; simp [inv_mul_cancel₀ hne]
            · simp [Pi.single_eq_of_ne hj]
          exact hi₀_not_mem (hmul ▸ q₀.mul_mem_left _ hf)
        · intro hf0
          have hmul : f * Pi.single i₀ (1 : L i₀) = 0 := by
            ext j
            by_cases hj : j = i₀
            · subst hj; simp [hf0]
            · simp [Pi.single_eq_of_ne hj]
          have hmem0 : f * Pi.single i₀ (1 : L i₀) ∈ q₀ := hmul.symm ▸ q₀.zero_mem
          exact (hq₀_prime.mem_or_mem hmem0).resolve_right hi₀_not_mem
      have _ : Module.Finite K (L i₀) := (hFinSep i₀).1
      have hSurj_i₀ : Function.Surjective (algebraMap K (L i₀)) := by
        intro y
        have hy_int : _root_.IsIntegral K y := Algebra.IsIntegral.isIntegral y
        let p_min := minpoly K y
        have hdeg : p_min.degree ≠ 0 :=
          ne_of_gt (Irreducible.degree_pos (minpoly.irreducible hy_int))
        obtain ⟨c, hc⟩ := IsAlgClosed.exists_root p_min hdeg
        obtain ⟨q_pol, hq_pol⟩ := Polynomial.dvd_iff_isRoot.mpr hc
        have hq_u : IsUnit q_pol :=
          ((minpoly.irreducible hy_int).isUnit_or_isUnit hq_pol).resolve_left
            (Polynomial.not_isUnit_X_sub_C c)
        have hq_m : q_pol.Monic :=
          Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C c)
            (hq_pol ▸ minpoly.monic hy_int)
        have hq1 : q_pol = 1 := by
          have hd : q_pol.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hq_u
          have hlc : q_pol.coeff 0 = 1 := by rw [← hd]; exact hq_m.leadingCoeff
          rw [Polynomial.eq_C_of_natDegree_eq_zero hd, hlc, map_one]
        have hm_eq : p_min = Polynomial.X - Polynomial.C c := by rw [hq_pol, hq1, mul_one]
        have haev : Polynomial.aeval y p_min = 0 := minpoly.aeval K y
        rw [hm_eq, map_sub, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero] at haev
        exact ⟨c, haev.symm⟩
      let e_Ki₀ : K ≃+* L i₀ :=
        RingEquiv.ofBijective (algebraMap K (L i₀)) ⟨RingHom.injective _, hSurj_i₀⟩
      let ε_B : R_U ⟶ CommRingCat.of K :=
        CommRingCat.ofHom (e_Ki₀.symm.toRingHom.comp ((Pi.evalRingHom L i₀).comp Θ.toRingHom))
      have hφ_ε : φ_KB ≫ ε_B = 𝟙 (CommRingCat.of K) := by
        apply CommRingCat.hom_ext; ext c
        change e_Ki₀.symm (Θ (algebraMap K B c) i₀) = c
        rw [Θ.commutes]; exact e_Ki₀.symm_apply_apply c
      let s_K : S_K ⟶ Spec R_U := Spec.map ε_B
      have hs_K_hom : (s_K ≫ j_V) ≫ U.hom = 𝟙 S_K := by
        rw [Category.assoc, ← hSpec_φ, ← Spec.map_comp, hφ_ε, Spec.map_id]
      have hs_K_pt : s_K.base (⊥ : PrimeSpectrum K) = p₀ := by
        apply PrimeSpectrum.ext
        ext b
        change ε_B.hom b ∈ (⊥ : Ideal K) ↔ b ∈ p₀.asIdeal
        rw [Ideal.mem_bot]
        change e_Ki₀.symm (Θ b i₀) = 0 ↔ b ∈ p₀.asIdeal
        rw [map_eq_zero_iff e_Ki₀.symm e_Ki₀.symm.injective, ← hq₀_iff (Θ b)]
        change Θ.symm (Θ b) ∈ p₀.asIdeal ↔ b ∈ p₀.asIdeal
        rw [Θ.symm_apply_apply]
      let f_x : T_K ⟶ U := MorphismProperty.Over.homMk (s_K ≫ j_V) hs_K_hom
      refine ⟨f_x, ?_⟩
      change V_x.ι.base (e_spec.inv.base (s_K.base (⊥ : PrimeSpectrum K))) = x
      rw [hs_K_pt]
      have he_inv : e_spec.inv.base p₀ = ⟨x, hx⟩ := by
        change (e_spec.hom ≫ e_spec.inv).base ⟨x, hx⟩ = ⟨x, hx⟩
        rw [e_spec.hom_inv_id]; rfl
      rw [he_inv]; rfl
    have hTopSieve : ∀ {R : Sieve T_K}, R ∈ S_K.smallEtaleTopology T_K → R.arrows (𝟙 T_K) := by
      intro R hR
      obtain ⟨Y, g, y, hg_R, _, _⟩ :=
        (hMemEtale T_K R).mp hR (⊥ : PrimeSpectrum K)
      obtain ⟨f_y, -⟩ := hLiftPt Y y
      have hfg : f_y ≫ g = 𝟙 T_K := hT_K.hom_ext _ _
      exact hfg ▸ R.downward_closed hg_R f_y
    refine ⟨⟨hT_K⟩, fun U ⟨x⟩ => ⟨(hLiftPt U x).choose⟩, fun A => ?_, fun {ℱ₁ ℱ₂} ψ hSurj => ?_⟩
    · let P_A := (Functor.const S_K.Etaleᵒᵖ).obj A
      let η_A := toSheafify S_K.smallEtaleTopology P_A
      have hInj : Function.Injective (η_A.app (Opposite.op T_K)) := by
        intro a₁ a₂ ha
        have hEqMem : Presheaf.equalizerSieve (F := P_A) (X := Opposite.op T_K) a₁ a₂ ∈
