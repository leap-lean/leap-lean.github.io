        change (r.comp hSE_R1.extClass rfl).comp (Abelian.Ext.mk₀ SC_R1.f) (Nat.add_zero 1) = 0
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero r hSE_R1.extClass _ rfl,
          ShortComplex.ShortExact.extClass_comp hSE_R1, Abelian.Ext.comp_zero]
      have hr_ext0 : r.comp hSE_R1.extClass rfl = 0 :=
        hInj_αQ1 (hαQ1_zero.trans (map_zero _).symm)
      obtain ⟨z₀, hz₀⟩ := Abelian.Ext.covariant_sequence_exact₃ Z_M hSE_R1 r rfl hr_ext0
      rw [← hz₀]; obtain ⟨w₀, hw₀⟩ := hSurj_αQ0 z₀; rw [← hw₀]
      change (w₀.comp (Abelian.Ext.mk₀ α_Q) (Nat.add_zero 0)).comp
        (Abelian.Ext.mk₀ δ₀) (Nat.add_zero 0) = 0
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero w₀ _ _ (Nat.add_zero 0),
        Abelian.Ext.mk₀_comp_mk₀, hα_δ₀, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  
  let termObj : ∀ X : Scheme.{u}, X.Etale := fun X => Scheme.Etale.mk (𝟙 X)
  let isTermObj : ∀ X : Scheme.{u}, Limits.IsTerminal (termObj X) := fun X =>
    Limits.IsTerminal.ofUniqueHom
      (fun E => MorphismProperty.Over.homMk E.hom (Category.comp_id E.hom))
      (fun E m => (Scheme.Etale.forget X).map_injective
        (Over.OverMorphism.ext ((Category.comp_id m.left).symm.trans m.w)))

  have hConstPullbackIso :
      ∀ {X₁ X₂ : Scheme.{u}} (h : X₁ ⟶ X₂) (A : AddCommGrpCat.{u}),
        letI : MorphismProperty.HasPullbacksAlong (@Etale) h :=
          MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
        letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) h :=
          MorphismProperty.IsStableUnderBaseChangeAlong.mk
            (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
        let B : X₂.Etale ⥤ X₁.Etale := MorphismProperty.Over.pullback (@Etale) ⊤ h
        let J₁ := X₁.smallEtaleTopology
        let J₂ := X₂.smallEtaleTopology
        ∀ [B.IsContinuous J₂ J₁]
          [(B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁).IsRightAdjoint],
          let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
          let P_pull := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
          let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
          let C₁ := constantSheaf J₁ AddCommGrpCat.{u}
          let C₂ := constantSheaf J₂ AddCommGrpCat.{u}
          let T₁ := termObj X₁
          let hT₁ := isTermObj X₁
          let T₂ := termObj X₂
          let hT₂ := isTermObj X₂
          let adj₁ := constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
          let adj₂ := constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
          let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
          let η_A : C₂.obj A ⟶ P_push.obj (C₁.obj A) :=
            (adj₂.homEquiv A (P_push.obj (C₁.obj A))).symm
              (adj₁.unit.app A ≫ (C₁.obj A).obj.map τ.op)
          let π_A : P_pull.obj (C₂.obj A) ⟶ C₁.obj A :=
            (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).symm η_A
          ∃ ι_A : C₁.obj A ⟶ P_pull.obj (C₂.obj A),
            ι_A ≫ π_A = 𝟙 (C₁.obj A) ∧ π_A ≫ ι_A = 𝟙 (P_pull.obj (C₂.obj A)) := by
    clear * -
    intro X₁ X₂ h A
    let : MorphismProperty.HasPullbacksAlong (@Etale) h :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale) h :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    intro B J₁ J₂ _ _ P_push P_pull adj_pull C₁ C₂ T₁ hT₁ T₂ hT₂ adj₁ adj₂ τ η_A π_A
    let snd_inv : X₁ ⟶ Limits.pullback (𝟙 X₂) h :=
      Limits.pullback.lift h (𝟙 X₁) (by rw [Category.comp_id, Category.id_comp])
    have hsnd_inv₁ : snd_inv ≫ Limits.pullback.snd (𝟙 X₂) h = 𝟙 X₁ :=
      Limits.pullback.lift_snd _ _ _
    have hsnd_inv₂ : Limits.pullback.snd (𝟙 X₂) h ≫ snd_inv = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Limits.pullback.condition,
          Category.comp_id, Category.id_comp]
      · rw [Category.assoc, Limits.pullback.lift_snd, Category.comp_id, Category.id_comp]
    let hBT₂ : Limits.IsTerminal (B.obj T₂) :=
      Limits.IsTerminal.ofUniqueHom
        (fun E => MorphismProperty.Over.homMk (E.hom ≫ snd_inv)
          ((Category.assoc E.hom snd_inv _).trans
            ((congrArg (E.hom ≫ ·) hsnd_inv₁).trans (Category.comp_id E.hom))))
        (fun E m => (Scheme.Etale.forget X₁).map_injective (Over.OverMorphism.ext (by
          have hw : m.left ≫ Limits.pullback.snd (𝟙 X₂) h = E.hom :=
            (Category.id_comp _).symm.trans (m.w.trans (Category.comp_id _))
          exact (Category.comp_id m.left).symm.trans
            ((congrArg (m.left ≫ ·) hsnd_inv₂.symm).trans
              ((Category.assoc m.left _ snd_inv).symm.trans (congrArg (· ≫ snd_inv) hw))))))
    let τ_inv : T₁ ⟶ B.obj T₂ := hBT₂.from T₁
    have hτ_id₁ : τ ≫ τ_inv = 𝟙 (B.obj T₂) := hBT₂.hom_ext _ _
    have hτ_id₂ : τ_inv ≫ τ = 𝟙 T₁ := hT₁.hom_ext _ _
    let G_pull : Sheaf J₁ AddCommGrpCat.{u} := P_pull.obj (C₂.obj A)
    let unit₁_A : A ⟶ (C₁.obj A).obj.obj (Opposite.op T₁) := adj₁.unit.app A
    let unit₂_A : A ⟶ (C₂.obj A).obj.obj (Opposite.op T₂) := adj₂.unit.app A
    let u_T₂ : (C₂.obj A).obj.obj (Opposite.op T₂) ⟶ G_pull.obj.obj (Opposite.op (B.obj T₂)) :=
      (adj_pull.unit.app (C₂.obj A)).hom.app (Opposite.op T₂)
    let η_T₂ : (C₂.obj A).obj.obj (Opposite.op T₂) ⟶ (C₁.obj A).obj.obj (Opposite.op (B.obj T₂)) :=
      η_A.hom.app (Opposite.op T₂)
    let ι_A : C₁.obj A ⟶ G_pull :=
