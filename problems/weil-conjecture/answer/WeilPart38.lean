          simp only [τ_hat, τ_win, hval_succAbove, Fin.val_castSucc]
          split_ifs <;> omega
        exact congrArg₂ (fun a b => mul (N + 1) a b) hu_eq hv_eq
      have hZ₂_exp : (∑ j : Fin p,
          ((-1 : ℤ) ^ j.1) •
            mul (N + 1)
              (mapMono (μ_mid j) (hμ_mid_sm j) u)
              (mapMono (τ_til j) (hτ_til_sm j) (diffC p v))) =
        (∑ j : Fin p,
          ((-1 : ℤ) ^ j.1) •
            mul (N + 1)
              (mapMono (μ_mid j) (hμ_mid_sm j) u)
              (mapMono (τ_hat j.succ) (hτ_hat_sm j.succ) v)) +
        (∑ j : Fin p, ∑ t : Fin p, d_term j ⟨j.1 + 1 + t.1, by omega⟩) +
        (∑ j : Fin p,
          ((-1 : ℤ) ^ j.1) •
            mul (N + 1)
              (mapMono (μ_mid j) (hμ_mid_sm j) u)
              (mapMono (τ_hat j.castSucc) (hτ_hat_sm j.castSucc) v)) := by
        have hinner : ∀ j : Fin p,
            ((-1 : ℤ) ^ j.1) •
              mul (N + 1)
                (mapMono (μ_mid j) (hμ_mid_sm j) u)
                (mapMono (τ_til j) (hτ_til_sm j) (diffC p v)) =
            ((-1 : ℤ) ^ j.1) •
              mul (N + 1)
                (mapMono (μ_mid j) (hμ_mid_sm j) u)
                (mapMono (τ_hat j.succ) (hτ_hat_sm j.succ) v) +
            (∑ t : Fin p, d_term j ⟨j.1 + 1 + t.1, by omega⟩) +
            ((-1 : ℤ) ^ j.1) •
              mul (N + 1)
                (mapMono (μ_mid j) (hμ_mid_sm j) u)
                (mapMono (τ_hat j.castSucc) (hτ_hat_sm j.castSucc) v) := by
          intro j
          rw [hdiff_apply p v, map_sum, hmul_sum_right, Finset.smul_sum,
            Fin.sum_univ_succ (n := p + 1), Fin.sum_univ_castSucc (n := p)]
          have hr0 :
              ((-1 : ℤ) ^ j.1) •
                mul (N + 1)
                  (mapMono (μ_mid j) (hμ_mid_sm j) u)
                  (mapMono (τ_til j) (hτ_til_sm j)
                    (((-1 : ℤ) ^ (0 : Fin (p + 2)).1) •
                      mapMono (0 : Fin (p + 2)).succAbove (Fin.strictMono_succAbove _) v)) =
              ((-1 : ℤ) ^ j.1) •
                mul (N + 1)
                  (mapMono (μ_mid j) (hμ_mid_sm j) u)
                  (mapMono (τ_hat j.succ) (hτ_hat_sm j.succ) v) := by
            have hsgn0 : (-1 : ℤ) ^ (0 : Fin (p + 2)).1 = 1 := rfl
            rw [hsgn0, one_smul]
            congr 2
            apply hmap_comp_eq
            intro l
            dsimp only [τ_til, τ_hat]
            rw [hval_succAbove]
            have h0 : ¬ (l.1 < (0 : Fin (p + 2)).1) := Nat.not_lt_zero l.1
            simp [h0, Fin.val_succ]
            omega
          have hrlast :
              ((-1 : ℤ) ^ j.1) •
                mul (N + 1)
                  (mapMono (μ_mid j) (hμ_mid_sm j) u)
                  (mapMono (τ_til j) (hτ_til_sm j)
                    (((-1 : ℤ) ^ ((Fin.last p).succ).1) •
                      mapMono ((Fin.last p).succ).succAbove (Fin.strictMono_succAbove _) v)) =
              ((-1 : ℤ) ^ j.1) •
                mul (N + 1)
                  (mapMono (μ_mid j) (hμ_mid_sm j) u)
                  (mapMono (τ_hat j.castSucc) (hτ_hat_sm j.castSucc) v) := by
            have hexp : (-1 : ℤ) ^ ((Fin.last p).succ).1 = 1 := by
              rw [Fin.val_succ, Fin.val_last]
              change (-1 : ℤ) ^ (2 * (m + 1)) = 1
              rw [pow_mul]
              norm_num
            rw [hexp, one_smul]
            congr 2
            apply hmap_comp_eq
            intro l
            simp only [τ_til, τ_hat, hval_succAbove, Fin.val_succ, Fin.val_last, Fin.val_castSucc]
            split_ifs <;> omega
          have hrmid :
              (∑ t : Fin p,
                ((-1 : ℤ) ^ j.1) •
                  mul (N + 1)
                    (mapMono (μ_mid j) (hμ_mid_sm j) u)
                    (mapMono (τ_til j) (hτ_til_sm j)
