    have hFin_B₀ : Finite ↥B₀ := Finite.of_injective ι_B₀ hInj_ιB₀
    let α : C_D.obj B₀ ⟶ C_D.obj B := C_D.map ι_B₀
    let θ : C_D.obj B₀ ⟶ G' := α ≫ φ

    
    have hGenZeroTransfer : ∀ (ℋ : CategoryTheory.Sheaf D_bar.left.smallEtaleTopology AddCommGrpCat.{u}),
        CategoryTheory.Limits.IsZero (P_η₀.obj ℋ) →
        ∀ {K : Type u} [Field K] [IsAlgClosed K]
          (y : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ D_bar.left),
          y.base (⊥ : PrimeSpectrum K) = genericPoint ↥D_bar.left →
          ∃ (H_y : CategoryTheory.Sheaf
