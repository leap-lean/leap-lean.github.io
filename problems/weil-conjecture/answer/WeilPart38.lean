      obtain ⟨z_tilde, hz_tilde⟩ := hLiftEtale_geom K w_lc (z_P ≫ ι_chart) hmem_wlc
      have hPb_constK : WeilIsEtaleSheafPullback (z_P ≫ ι_chart) G
