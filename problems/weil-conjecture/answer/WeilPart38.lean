          N_geom := by
    intro x₀ hδ_ne
    have haeval_ne : Polynomial.aeval (x₀.1 : AlgebraicClosure F) (δ_fam ψ₀) ≠ 0 := by
      have heq : Polynomial.aeval (x₀.1 : AlgebraicClosure F) (δ_fam ψ₀) =
          E_sub.subtype ((δ_fam ψ₀).eval x₀) := by
        rw [Polynomial.aeval_def]
        exact (Polynomial.hom_eval₂ (δ_fam ψ₀) (RingHom.id ↥E_sub)
          (algebraMap ↥E_sub (AlgebraicClosure F)) x₀).symm
      rw [heq]
      exact (map_ne_zero_iff E_sub.subtype E_sub.subtype_injective).mpr hδ_ne
    obtain ⟨hNodup, hCard⟩ := (hδ_spec ψ₀).2.2.2.1 (AlgebraicClosure F) x₀.1 haeval_ne
    exact ⟨hNodup, hCard.trans (hwG_spec ψ₀).2.1.2.1⟩
  have hCond : ∀ (η : Ω_d) (u : M_d), u ∈ B_sub →
      ∃ (m : ℕ) (r : Fin N_geom → Polynomial ↥E'_sub),
        (((algebraMap (Polynomial ↥E'_sub) M_d (Δ.map (algebraMap F ↥E'_sub))) ^ m) *
          (algebraMap (Polynomial ↥E'_sub) M_d
            ((δ_fam η).map (IntermediateField.inclusion hLE).toRingHom))) * u =
          ∑ j : Fin N_geom,
            (algebraMap (Polynomial ↥E'_sub) M_d (r j)) * (w_fam η) ^ (j : ℕ) := by
    intro η u hu
    obtain ⟨m, hm_int⟩ := hBsub_int u hu
    have hdeg_eq : (G_fam η).natDegree = N_geom := (hwG_spec η).2.1.2.1
    have hcomp_eq : (algebraMap (Polynomial ↥E'_sub) M_d).comp
        (Polynomial.mapRingHom (algebraMap ↥E_sub ↥E'_sub)) =
        algebraMap (Polynomial ↥E_sub) M_d :=
      RingHom.ext fun P => hPolyCompat P
    have heval_w : ((G_fam η).map ((algebraMap (Polynomial ↥E'_sub) M_d).comp
        (Polynomial.mapRingHom (algebraMap ↥E_sub ↥E'_sub)))).eval (w_fam η) = 0 := by
      rw [hcomp_eq]
      exact (hwG_spec η).2.2.1
    obtain ⟨r₀, hr₀⟩ := (hδ_spec η).2.2.2.2 ↥E'_sub (Δ.map (algebraMap F ↥E'_sub)) M_d
      (hfinrank_Md.trans hdeg_eq.symm) (w_fam η) heval_w (hwG_spec η).2.2.2 u m hm_int
    refine ⟨m, fun j => r₀ (Fin.cast hdeg_eq.symm j), ?_⟩
    have hsum_eq : ∑ j : Fin N_geom,
        (algebraMap (Polynomial ↥E'_sub) M_d (r₀ (Fin.cast hdeg_eq.symm j))) *
          (w_fam η) ^ (j : ℕ) =
      ∑ j : Fin (G_fam η).natDegree,
        (algebraMap (Polynomial ↥E'_sub) M_d (r₀ j)) * (w_fam η) ^ (j : ℕ) :=
      Fin.sum_congr'
        (fun j : Fin (G_fam η).natDegree =>
          (algebraMap (Polynomial ↥E'_sub) M_d (r₀ j)) * (w_fam η) ^ (j : ℕ))
        hdeg_eq.symm
    rw [hsum_eq]
    exact hr₀
  obtain ⟨hClause3, hClause4⟩ :=
    weil_speiser_conductor_eval_and_frob_fiber_partition F S_aff B L hFinAut d N_geom
      hd_ge2 hN_pos σ₀ hσ₀ e_Ω E_sub E'_sub hLE Φ_d hE_mem hΦ_apply hSub_pow
      (hGood_minpoly S_aff) M_d hfinrank_Md j_B B_sub (fun η => (twist η).toRingHom)
      w_fam G_fam δ_fam ⟨hPolyCompat, hj_B_poly⟩ ⟨hj_B_sub, hPoly_sub, hBsub_closure⟩
      (fun η => ⟨(hTwist_all η).2.1, (hTwist_all η).2.2.1, (hTwist_all η).2.2.2⟩)
      (fun η => ⟨(hwG_spec η).1.1, (hwG_spec η).1.2, (hwG_spec η).2.1.1,
        (hwG_spec η).2.1.2.1, (hwG_spec η).2.2.1, (hwG_spec η).2.2.2⟩)
      hSmooth hRoots hCond
  refine ⟨e_Ω, ↥E_sub, hFinE, inferInstance, inferInstance, hCharE, G_fam, δ_fam,
    hcard_E, fun η => ?_, hClause3, hClause4⟩
  obtain ⟨hMon, hDeg, hCoeff, hIrr, hDer⟩ := (hwG_spec η).2.1
  obtain ⟨hδ_ne, hδ_deg, _, _, _⟩ := hδ_spec η
  exact ⟨hMon, hDeg, hCoeff, hIrr, hDer, hδ_ne, hδ_deg.trans (by rw [hDeg])⟩

theorem weil_etale_curve_cover_chebotarev_frob_realization (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (B L : Type u) [CommRing B] [IsDomain B] [Field L]
    [Algebra F B] [Algebra (Polynomial F) B]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [Algebra F L] [Algebra (Polynomial F) L] [Algebra (RatFunc F) L]
    [Algebra B L]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L]
    [IsScalarTower F (Polynomial F) B]
    [IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [IsScalarTower F (RatFunc F) L]
    [IsScalarTower (Polynomial F) (RatFunc F) L]
    [IsScalarTower (Polynomial F) B L]
    [IsScalarTower
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B L]
    [Module.Finite
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [Algebra.Etale
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [IsFractionRing B L]
    [IsIntegralClosure B
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) L]
    [FiniteDimensional (RatFunc F) L] [IsGalois (RatFunc F) L]
    (hBombieri : ∀ D : ℕ, 1 ≤ D →
      ∃ C_B : ℕ,
        ∀ (E : Type u) [Finite E] [Field E] [CharP E (ringChar F)]
          (G : Polynomial (Polynomial E)),
          G.Monic →
          1 ≤ G.natDegree →
          G.natDegree ≤ D →
          (∀ r ≤ G.natDegree, (G.coeff r).natDegree ≤ D) →
          Irreducible G →
          Polynomial.derivative G ≠ 0 →
          Nat.card { pt : E × E //
            (G.map (Polynomial.evalRingHom pt.1)).eval pt.2 = 0 ∧
            ((Polynomial.derivative G).map (Polynomial.evalRingHom pt.1)).eval pt.2 ≠ 0 } ≤
            Nat.card E + C_B * (Nat.sqrt (Nat.card E) + 1)) :
    ∃ D₀ : ℕ,
      ∀ (d : ℕ), D₀ ≤ d →
        ∀ (σ₀ : B ≃ₐ[Localization.Away
            (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B),
          (∀ x : B, IsIntegral F x → σ₀.symm x = x ^ (Nat.card F ^ d)) →
          ∃ (P : Polynomial F),
            IsGoodAffineCurveClosedPointPoly S_aff d P ∧
            ∀ (Q : Ideal B)
              (σ : B ≃ₐ[Localization.Away
                (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B),
              Q.IsMaximal →
              Ideal.comap (algebraMap (Polynomial F) B) Q = Ideal.span {P} →
              (∀ b : B, σ.symm b - b ^ (Nat.card F ^ d) ∈ Q) →
              IsConj σ₀ σ :=
by
  classical
  have hq : 2 ≤ Nat.card F := Finite.one_lt_card
  obtain ⟨F_B, hFinFB, N_geom, D_T, e_B, h₀, N_mat, hConstBasis⟩ :=
    weil_etale_curve_cover_constant_field_and_uniform_basis F S_aff B L
  let _ : Finite ↥F_B := hFinFB
  have hN_pos : 1 ≤ N_geom := hConstBasis.1.1
  have hDT_pos : 1 ≤ D_T := hConstBasis.1.2.1
  let D_max : ℕ := max N_geom D_T
  have hDmax_pos : 1 ≤ D_max := le_trans hN_pos (le_max_left N_geom D_T)
  obtain ⟨C_B, hCB⟩ := hBombieri D_max hDmax_pos
  have hDiscCond := fun (E : Type u) [Field E] =>
    weil_bivariate_monic_trace_discriminant_conductor D_T hDT_pos E
  let C_bad : ℕ := S_aff.card + N_geom * (3 * N_geom ^ 2 * D_T)
  let K_asy : ℕ := 2 * N_geom + 2 * N_geom * C_B + 3 * N_geom * C_bad + 1
  let D₀ : ℕ := max (N_geom ^ 2 + 2) (2 * K_asy)
  refine ⟨D₀, fun d hd σ₀ hσ₀ => ?_⟩
  have hd_ge_Nsq2 : N_geom ^ 2 + 2 ≤ d := le_trans (le_max_left _ _) hd
  have hd_ge_2K : 2 * K_asy ≤ d := le_trans (le_max_right _ _) hd
  have hd_ge2 : 2 ≤ d := by omega
  have hN_sq_lt : N_geom ^ 2 < Nat.card F ^ d := by
    have h1 : N_geom ^ 2 < d := by omega
    have h2 : d < 2 ^ d := Nat.lt_two_pow_self
    have h3 : 2 ^ d ≤ Nat.card F ^ d := Nat.pow_le_pow_left hq d
    omega
  obtain ⟨e_Ω, E, hFinE, hFldE, hAlgE, hCharE, G_fam, δ_fam,
      hcard_E, hG_props, hFib_sum, hRealize⟩ :=
    weil_etale_speiser_twist_curve_partition F S_aff B L F_B N_geom D_T e_B h₀ N_mat
      hConstBasis hDiscCond d hd_ge2 hN_sq_lt σ₀ hσ₀
  let Δ : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s)
  let R₀ := Localization.Away Δ
  let Ω_d := { η : B ≃ₐ[R₀] B // ∀ x : B, IsIntegral F x → η x = x ^ (Nat.card F ^ d) }
  let ψ₀ : Ω_d := ⟨σ₀.symm, hσ₀⟩
  let _ : Finite E := hFinE
  let _ : Field E := hFldE
  let _ : Algebra F E := hAlgE
  let _ : CharP E (ringChar F) := hCharE
  let _ : Fintype E := Fintype.ofFinite E
  have hfintype_E : Fintype.card E = Nat.card F ^ d := Nat.card_eq_fintype_card.symm.trans hcard_E

  
  let q := Nat.card F
  let S := Nat.sqrt (q ^ d)
  have hS_sq : S * S ≤ q ^ d := Nat.sqrt_le (q ^ d)
  have hq_half_le_S : q ^ (d / 2) ≤ S := by
    apply Nat.le_sqrt.mpr
    rw [← pow_add]
    exact Nat.pow_le_pow_right (by omega : 1 ≤ q) (by omega : d / 2 + d / 2 ≤ d)
  have hS_pos : 1 ≤ S := by
    have h1 : 1 ≤ q ^ (d / 2) := Nat.one_le_pow (d / 2) q (by omega)
    omega
  have hK_le_S : K_asy ≤ S := by
    have h1 : K_asy ≤ d / 2 := by omega
    have h2 : d / 2 < 2 ^ (d / 2) := Nat.lt_two_pow_self
    have h3 : 2 ^ (d / 2) ≤ q ^ (d / 2) := Nat.pow_le_pow_left hq (d / 2)
    omega

  
  let SmPt (η : Ω_d) := { pt : E × E //
    ((G_fam η).map (Polynomial.evalRingHom pt.1)).eval pt.2 = 0 ∧
    ((Polynomial.derivative (G_fam η)).map (Polynomial.evalRingHom pt.1)).eval pt.2 ≠ 0 }
  let SmFib (η : Ω_d) (x₀ : E) := { y₀ : E //
    ((G_fam η).map (Polynomial.evalRingHom x₀)).eval y₀ = 0 ∧
    ((Polynomial.derivative (G_fam η)).map (Polynomial.evalRingHom x₀)).eval y₀ ≠ 0 }
  have hSm_decomp : ∀ η : Ω_d, Nat.card (SmPt η) = ∑ x₀ : E, Nat.card (SmFib η x₀) := by
    intro η
    let e_sig : SmPt η ≃ Σ x₀ : E, SmFib η x₀ :=
      { toFun := fun p => ⟨p.1.1, ⟨p.1.2, p.2⟩⟩
        invFun := fun q => ⟨(q.1, q.2.1), q.2.2⟩
        left_inv := fun _ => Subtype.ext (Prod.ext rfl rfl)
        right_inv := fun _ => Sigma.ext rfl (heq_of_eq (Subtype.ext rfl)) }
    rw [Nat.card_eq_fintype_card, Fintype.card_congr e_sig, Fintype.card_sigma]
    refine Finset.sum_congr rfl fun x₀ _ => ?_
    exact Nat.card_eq_fintype_card.symm

  
  let U_good : Finset E := Finset.univ.filter fun x₀ : E =>
    (∀ s ∈ S_aff, x₀ ≠ algebraMap F E s) ∧ (∀ η : Ω_d, (δ_fam η).eval x₀ ≠ 0)
  have hδ_roots_card : ∀ η : Ω_d, (((δ_fam η).roots).toFinset).card ≤ 3 * N_geom ^ 2 * D_T := by
    intro η
    calc (((δ_fam η).roots).toFinset).card
        ≤ ((δ_fam η).roots).card := Multiset.toFinset_card_le _
      _ ≤ (δ_fam η).natDegree := Polynomial.card_roots' (δ_fam η)
      _ ≤ 3 * N_geom ^ 2 * D_T := (hG_props η).2.2.2.2.2.2
  have hU_good_card : q ^ d ≤ U_good.card + C_bad := by
    let Bad₁ : Finset E := S_aff.image (algebraMap F E)
    let Bad₂ : Finset E := Finset.univ.biUnion fun i : Fin N_geom => ((δ_fam (e_Ω i)).roots).toFinset
    have hcov : (Finset.univ : Finset E) ⊆ U_good ∪ (Bad₁ ∪ Bad₂) := by
      intro x₀ _
      by_cases hx : (∀ s ∈ S_aff, x₀ ≠ algebraMap F E s) ∧ (∀ η : Ω_d, (δ_fam η).eval x₀ ≠ 0)
      · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨Finset.mem_univ x₀, hx⟩)
      · apply Finset.mem_union_right
        rw [not_and_or] at hx
        rcases hx with hnot1 | hnot2
        · push_neg at hnot1
          rcases hnot1 with ⟨s, hs, rfl⟩
          exact Finset.mem_union_left _ (Finset.mem_image_of_mem _ hs)
        · push_neg at hnot2
          rcases hnot2 with ⟨η, hη0⟩
          have hmem_roots : x₀ ∈ ((δ_fam (e_Ω (e_Ω.symm η))).roots).toFinset := by
            rw [e_Ω.apply_symm_apply]
            exact Multiset.mem_toFinset.mpr ((Polynomial.mem_roots (hG_props η).2.2.2.2.2.1).mpr hη0)
          exact Finset.mem_union_right _
            (Finset.mem_biUnion.mpr ⟨e_Ω.symm η, Finset.mem_univ _, hmem_roots⟩)
    have hBad₂_card : Bad₂.card ≤ N_geom * (3 * N_geom ^ 2 * D_T) := by
      calc Bad₂.card
          ≤ ∑ i : Fin N_geom, (((δ_fam (e_Ω i)).roots).toFinset).card := Finset.card_biUnion_le
        _ ≤ ∑ _i : Fin N_geom, (3 * N_geom ^ 2 * D_T) :=
              Finset.sum_le_sum fun i _ => hδ_roots_card (e_Ω i)
        _ = N_geom * (3 * N_geom ^ 2 * D_T) := by
              rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
    calc q ^ d = (Finset.univ : Finset E).card := by rw [Finset.card_univ, hfintype_E]
      _ ≤ (U_good ∪ (Bad₁ ∪ Bad₂)).card := Finset.card_le_card hcov
      _ ≤ U_good.card + (Bad₁ ∪ Bad₂).card := Finset.card_union_le _ _
      _ ≤ U_good.card + (Bad₁.card + Bad₂.card) := Nat.add_le_add_left (Finset.card_union_le _ _) _
      _ ≤ U_good.card + (S_aff.card + N_geom * (3 * N_geom ^ 2 * D_T)) :=
            Nat.add_le_add_left (Nat.add_le_add Finset.card_image_le hBad₂_card) _
      _ = U_good.card + C_bad := rfl

  
  have hSm_tot_lower : U_good.card * N_geom ≤ ∑ i : Fin N_geom, Nat.card (SmPt (e_Ω i)) := by
    calc U_good.card * N_geom
        = ∑ _x₀ ∈ U_good, N_geom := by rw [Finset.sum_const, smul_eq_mul]
      _ ≤ ∑ x₀ ∈ U_good, ∑ i : Fin N_geom, Nat.card (SmFib (e_Ω i) x₀) := by
            refine Finset.sum_le_sum fun x₀ hx₀ => ?_
            have hx := (Finset.mem_filter.mp hx₀).2
            exact hFib_sum x₀ hx.1 hx.2
      _ ≤ ∑ x₀ : E, ∑ i : Fin N_geom, Nat.card (SmFib (e_Ω i) x₀) :=
            Finset.sum_le_univ_sum_of_nonneg fun _ => Nat.zero_le _
      _ = ∑ i : Fin N_geom, ∑ x₀ : E, Nat.card (SmFib (e_Ω i) x₀) := Finset.sum_comm
      _ = ∑ i : Fin N_geom, Nat.card (SmPt (e_Ω i)) :=
            Finset.sum_congr rfl fun i _ => (hSm_decomp (e_Ω i)).symm
  have hBombieri_each : ∀ η : Ω_d, Nat.card (SmPt η) ≤ q ^ d + C_B * (S + 1) := by
    intro η
    obtain ⟨hMon_η, hDeg_η, hCoeff_η, hIrr_η, hDer_η, _, _⟩ := hG_props η
    have h1 : 1 ≤ (G_fam η).natDegree := by rw [hDeg_η]; exact hN_pos
    have h2 : (G_fam η).natDegree ≤ D_max := by rw [hDeg_η]; exact le_max_left N_geom D_T
    have h3 : ∀ r ≤ (G_fam η).natDegree, ((G_fam η).coeff r).natDegree ≤ D_max :=
      fun r hr => le_trans (hCoeff_η r hr) (le_max_right N_geom D_T)
    have hb := hCB E (G_fam η) hMon_η h1 h2 h3 hIrr_η hDer_η
    rwa [hcard_E] at hb
  have hSm_ψ₀_lower :
      q ^ d ≤ Nat.card (SmPt ψ₀) + N_geom * C_B * (S + 1) + N_geom * C_bad := by
    let i₀ : Fin N_geom := e_Ω.symm ψ₀
    have hi₀_eq : e_Ω i₀ = ψ₀ := e_Ω.apply_symm_apply ψ₀
    have herase := (Finset.add_sum_erase Finset.univ
      (fun i : Fin N_geom => Nat.card (SmPt (e_Ω i))) (Finset.mem_univ i₀)).symm
    rw [hi₀_eq] at herase
    have herase_card : (Finset.univ.erase i₀).card = N_geom - 1 := by
      rw [Finset.card_erase_of_mem (Finset.mem_univ i₀), Finset.card_univ, Fintype.card_fin]
    have herase_bound :
        ∑ i ∈ Finset.univ.erase i₀, Nat.card (SmPt (e_Ω i)) ≤
          (N_geom - 1) * (q ^ d + C_B * (S + 1)) := by
      calc ∑ i ∈ Finset.univ.erase i₀, Nat.card (SmPt (e_Ω i))
          ≤ ∑ _i ∈ Finset.univ.erase i₀, (q ^ d + C_B * (S + 1)) :=
              Finset.sum_le_sum fun i _ => hBombieri_each (e_Ω i)
        _ = (N_geom - 1) * (q ^ d + C_B * (S + 1)) := by
              rw [Finset.sum_const, herase_card, smul_eq_mul]
    have hmul_good : N_geom * q ^ d ≤ U_good.card * N_geom + N_geom * C_bad := by
      calc N_geom * q ^ d ≤ N_geom * (U_good.card + C_bad) :=
              Nat.mul_le_mul_left N_geom hU_good_card
        _ = U_good.card * N_geom + N_geom * C_bad := by ring
    have hsplit_N : q ^ d + (N_geom - 1) * q ^ d = N_geom * q ^ d := by
      have hN1 : 1 + (N_geom - 1) = N_geom := by omega
      calc q ^ d + (N_geom - 1) * q ^ d = (1 + (N_geom - 1)) * q ^ d := by ring
        _ = N_geom * q ^ d := by rw [hN1]
    have hle1 : (N_geom - 1) * (C_B * (S + 1)) ≤ N_geom * C_B * (S + 1) := by
      have : N_geom - 1 ≤ N_geom := Nat.sub_le N_geom 1
      calc (N_geom - 1) * (C_B * (S + 1))
          ≤ N_geom * (C_B * (S + 1)) := Nat.mul_le_mul_right _ this
        _ = N_geom * C_B * (S + 1) := by ring
    have htot : q ^ d + (N_geom - 1) * q ^ d ≤
        Nat.card (SmPt ψ₀) + (N_geom - 1) * q ^ d + N_geom * C_B * (S + 1) + N_geom * C_bad := by
      calc q ^ d + (N_geom - 1) * q ^ d
          = N_geom * q ^ d := hsplit_N
        _ ≤ U_good.card * N_geom + N_geom * C_bad := hmul_good
        _ ≤ (∑ i : Fin N_geom, Nat.card (SmPt (e_Ω i))) + N_geom * C_bad :=
              Nat.add_le_add_right hSm_tot_lower _
        _ = Nat.card (SmPt ψ₀) + (∑ i ∈ Finset.univ.erase i₀, Nat.card (SmPt (e_Ω i))) +
              N_geom * C_bad := by rw [herase, add_assoc]
        _ ≤ Nat.card (SmPt ψ₀) + (N_geom - 1) * (q ^ d + C_B * (S + 1)) + N_geom * C_bad :=
              Nat.add_le_add_right (Nat.add_le_add_left herase_bound _) _
        _ = Nat.card (SmPt ψ₀) + (N_geom - 1) * q ^ d +
              (N_geom - 1) * (C_B * (S + 1)) + N_geom * C_bad := by ring
        _ ≤ Nat.card (SmPt ψ₀) + (N_geom - 1) * q ^ d +
              N_geom * C_B * (S + 1) + N_geom * C_bad := by omega
    omega

  
  have hgeom_sum : ∀ m : ℕ, ∑ k ∈ Finset.range (m + 1), q ^ k ≤ 2 * q ^ m := by
    intro m
    induction m with
    | zero =>
      simp only [zero_add, Finset.range_one, Finset.sum_singleton, pow_zero, mul_one]
      omega
    | succ m ih =>
      rw [Finset.sum_range_succ]
      calc (∑ k ∈ Finset.range (m + 1), q ^ k) + q ^ (m + 1)
          ≤ 2 * q ^ m + q ^ (m + 1) := Nat.add_le_add_right ih _
        _ ≤ q * q ^ m + q ^ (m + 1) :=
              Nat.add_le_add_right (Nat.mul_le_mul_right (q ^ m) hq) _
        _ = 2 * q ^ (m + 1) := by rw [← pow_succ']; ring
  have hFib_upper : ∀ x₀ : E, Nat.card (SmFib ψ₀ x₀) ≤ N_geom := by
    intro x₀
    let g_x₀ : Polynomial E := (G_fam ψ₀).map (Polynomial.evalRingHom x₀)
    have hg_mon : g_x₀.Monic := (hG_props ψ₀).1.map (Polynomial.evalRingHom x₀)
    have hg_deg : g_x₀.natDegree = N_geom := by
      rw [(hG_props ψ₀).1.natDegree_map (Polynomial.evalRingHom x₀), (hG_props ψ₀).2.1]
    let f_inj : SmFib ψ₀ x₀ → ↥((g_x₀.roots).toFinset) := fun y =>
      ⟨y.1, Multiset.mem_toFinset.mpr ((Polynomial.mem_roots hg_mon.ne_zero).mpr y.2.1)⟩
    have hf_inj : Function.Injective f_inj :=
      fun _ _ hab => Subtype.ext (Subtype.mk.inj hab)
    calc Nat.card (SmFib ψ₀ x₀)
        = Fintype.card (SmFib ψ₀ x₀) := Nat.card_eq_fintype_card
      _ ≤ Fintype.card ↥((g_x₀.roots).toFinset) := Fintype.card_le_of_injective f_inj hf_inj
      _ = ((g_x₀.roots).toFinset).card := Fintype.card_coe _
      _ ≤ (g_x₀.roots).card := Multiset.toFinset_card_le _
      _ ≤ g_x₀.natDegree := Polynomial.card_roots' g_x₀
      _ = N_geom := hg_deg
  have hexists_good_pt : ∃ x₀ y₀ : E,
      (∀ s ∈ S_aff, x₀ ≠ algebraMap F E s) ∧
      (δ_fam ψ₀).eval x₀ ≠ 0 ∧
      (∀ k : ℕ, 1 ≤ k → 2 * k ≤ d → x₀ ^ (q ^ k) ≠ x₀) ∧
      ((G_fam ψ₀).map (Polynomial.evalRingHom x₀)).eval y₀ = 0 := by
    by_contra hnone
    push_neg at hnone
    let SubPoly (k : ℕ) : Polynomial E := Polynomial.X ^ (q ^ k) - Polynomial.X
    have hSubPoly_deg : ∀ k ∈ Finset.Icc 1 (d / 2), (SubPoly k).natDegree = q ^ k := by
      intro k hk
      have hk1 : 1 ≤ k := (Finset.mem_Icc.mp hk).1
      have hqk_gt1 : 1 < q ^ k := Nat.one_lt_pow (by omega) hq
      dsimp [SubPoly]
      rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt, Polynomial.natDegree_X_pow]
      rw [Polynomial.natDegree_X, Polynomial.natDegree_X_pow]
      exact hqk_gt1
    let X_sub : Finset E :=
      (Finset.Icc 1 (d / 2)).biUnion fun k => ((SubPoly k).roots).toFinset
    let X_bad : Finset E :=
      (S_aff.image (algebraMap F E) ∪ ((δ_fam ψ₀).roots).toFinset) ∪ X_sub
    have hX_sub_card : X_sub.card ≤ 2 * S := by
      calc X_sub.card
          ≤ ∑ k ∈ Finset.Icc 1 (d / 2), (((SubPoly k).roots).toFinset).card :=
              Finset.card_biUnion_le
        _ ≤ ∑ k ∈ Finset.Icc 1 (d / 2), q ^ k := by
              refine Finset.sum_le_sum fun k hk => ?_
              calc (((SubPoly k).roots).toFinset).card
                  ≤ ((SubPoly k).roots).card := Multiset.toFinset_card_le _
                _ ≤ (SubPoly k).natDegree := Polynomial.card_roots' _
                _ = q ^ k := hSubPoly_deg k hk
        _ ≤ ∑ k ∈ Finset.range (d / 2 + 1), q ^ k := by
              refine Finset.sum_le_sum_of_subset fun k hk => ?_
              have hk_le : k ≤ d / 2 := (Finset.mem_Icc.mp hk).2
              exact Finset.mem_range.mpr (by omega)
        _ ≤ 2 * q ^ (d / 2) := hgeom_sum (d / 2)
        _ ≤ 2 * S := Nat.mul_le_mul_left 2 hq_half_le_S
    have hX_bad_card : X_bad.card ≤ 2 * C_bad + 2 * S := by
      have h1 : S_aff.card ≤ C_bad := le_self_add
      have h2 : (((δ_fam ψ₀).roots).toFinset).card ≤ C_bad := by
        have hle := hδ_roots_card ψ₀
        have hmul : 3 * N_geom ^ 2 * D_T ≤ N_geom * (3 * N_geom ^ 2 * D_T) :=
          Nat.le_mul_of_pos_left _ hN_pos
        dsimp [C_bad]
        omega
      calc X_bad.card
          ≤ (S_aff.image (algebraMap F E) ∪ ((δ_fam ψ₀).roots).toFinset).card + X_sub.card :=
              Finset.card_union_le _ _
        _ ≤ S_aff.card + (((δ_fam ψ₀).roots).toFinset).card + X_sub.card := by
              have hu := Finset.card_union_le (S_aff.image (algebraMap F E))
                (((δ_fam ψ₀).roots).toFinset)
              have hi : (S_aff.image (algebraMap F E)).card ≤ S_aff.card := Finset.card_image_le
              omega
        _ ≤ C_bad + C_bad + 2 * S := by omega
        _ = 2 * C_bad + 2 * S := by ring
    have hFib_zero_off : ∀ x₀ : E, x₀ ∉ X_bad → Nat.card (SmFib ψ₀ x₀) = 0 := by
      intro x₀ hx₀_not
      apply Nat.card_eq_zero.mpr
      left
      refine ⟨fun ⟨y₀, hy₀_eval, _⟩ => ?_⟩
      have hs_ne : ∀ s ∈ S_aff, x₀ ≠ algebraMap F E s := by
        intro s hs rfl
        exact hx₀_not (Finset.mem_union_left _ (Finset.mem_union_left _
          (Finset.mem_image_of_mem _ hs)))
      have hδ_ne : (δ_fam ψ₀).eval x₀ ≠ 0 := by
        intro h0
        have hmem : x₀ ∈ ((δ_fam ψ₀).roots).toFinset :=
          Multiset.mem_toFinset.mpr ((Polynomial.mem_roots (hG_props ψ₀).2.2.2.2.2.1).mpr h0)
        exact hx₀_not (Finset.mem_union_left _ (Finset.mem_union_right _ hmem))
      have hk_ne : ∀ k : ℕ, 1 ≤ k → 2 * k ≤ d → x₀ ^ (q ^ k) ≠ x₀ := by
        intro k hk1 hk2 heq
        have hk_mem : k ∈ Finset.Icc 1 (d / 2) := Finset.mem_Icc.mpr ⟨hk1, by omega⟩
        have hqk_gt1 : 1 < q ^ k := Nat.one_lt_pow (by omega) hq
        have hSub_ne : SubPoly k ≠ 0 := by
          intro hz
          have hd0 := hSubPoly_deg k hk_mem
          rw [hz, Polynomial.natDegree_zero] at hd0
          omega
        have hroot : (SubPoly k).IsRoot x₀ := by
          simp only [SubPoly, Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow,
            Polynomial.eval_X, heq, sub_self]
        have hmem : x₀ ∈ ((SubPoly k).roots).toFinset :=
          Multiset.mem_toFinset.mpr ((Polynomial.mem_roots hSub_ne).mpr hroot)
        exact hx₀_not (Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨k, hk_mem, hmem⟩))
      exact hnone x₀ y₀ hs_ne hδ_ne hk_ne hy₀_eval
    have hSm_ψ₀_upper : Nat.card (SmPt ψ₀) ≤ 2 * N_geom * S + 2 * N_geom * C_bad := by
      rw [hSm_decomp ψ₀]
      calc ∑ x₀ : E, Nat.card (SmFib ψ₀ x₀)
          = ∑ x₀ ∈ X_bad, Nat.card (SmFib ψ₀ x₀) := by
              symm
              refine Finset.sum_subset (Finset.subset_univ X_bad) fun x₀ _ hx₀ => ?_
              exact hFib_zero_off x₀ hx₀
        _ ≤ ∑ _x₀ ∈ X_bad, N_geom := Finset.sum_le_sum fun x₀ _ => hFib_upper x₀
        _ = X_bad.card * N_geom := by rw [Finset.sum_const, smul_eq_mul]
        _ ≤ (2 * C_bad + 2 * S) * N_geom := Nat.mul_le_mul_right N_geom hX_bad_card
        _ = 2 * N_geom * S + 2 * N_geom * C_bad := by ring
    have hS_upper : S * S ≤ (2 * N_geom + 2 * N_geom * C_B + 3 * N_geom * C_bad) * S := by
      have hconst_le : N_geom * C_B + 3 * N_geom * C_bad ≤
          (N_geom * C_B + 3 * N_geom * C_bad) * S :=
        Nat.le_mul_of_pos_right _ hS_pos
      calc S * S ≤ q ^ d := hS_sq
        _ ≤ Nat.card (SmPt ψ₀) + N_geom * C_B * (S + 1) + N_geom * C_bad := hSm_ψ₀_lower
        _ ≤ (2 * N_geom * S + 2 * N_geom * C_bad) + N_geom * C_B * (S + 1) + N_geom * C_bad := by
              omega
        _ = (2 * N_geom + N_geom * C_B) * S + (N_geom * C_B + 3 * N_geom * C_bad) := by ring
        _ ≤ (2 * N_geom + N_geom * C_B) * S + (N_geom * C_B + 3 * N_geom * C_bad) * S :=
              Nat.add_le_add_left hconst_le _
        _ = (2 * N_geom + 2 * N_geom * C_B + 3 * N_geom * C_bad) * S := by ring
    have hS_lower : (2 * N_geom + 2 * N_geom * C_B + 3 * N_geom * C_bad) * S + S ≤ S * S := by
      have hmul := Nat.mul_le_mul_right S hK_le_S
      dsimp [K_asy] at hmul
      rwa [add_one_mul] at hmul
    omega

  
  obtain ⟨x₀, y₀, hx₀_S, hx₀_δ, hx₀_prim, hy₀_eval⟩ := hexists_good_pt
  obtain ⟨P, Q₀, hP, hQ₀_max, hQ₀_comap, hQ₀_frob⟩ :=
    hRealize x₀ y₀ hx₀_S hx₀_δ hx₀_prim hy₀_eval
  refine ⟨P, hP, fun Q σ hQ_max hQ_comap hQ_frob => ?_⟩
  have hMon : P.Monic := hP.1
  have hIrr : Irreducible P := hP.2.1
  have hAvoid : ∀ s ∈ S_aff, ¬ P.IsRoot s := hP.2.2.2
  set N := Nat.card F ^ d
  have hΔ_mon : Δ.Monic :=
    Polynomial.monic_prod_of_monic S_aff (fun s => Polynomial.X - Polynomial.C s)
      (fun s _ => Polynomial.monic_X_sub_C s)
  have hΔ_ne : Δ ≠ 0 := hΔ_mon.ne_zero
  have h_nzd : Submonoid.powers Δ ≤ nonZeroDivisors (Polynomial F) :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hΔ_ne)
  have hΔ_K_ne : algebraMap (Polynomial F) (RatFunc F) Δ ≠ 0 :=
    (map_ne_zero_iff (algebraMap (Polynomial F) (RatFunc F))
      (IsFractionRing.injective (Polynomial F) (RatFunc F))).mpr hΔ_ne
  have hΔ_K_unit : IsUnit (algebraMap (Polynomial F) (RatFunc F) Δ) := hΔ_K_ne.isUnit
  let _ : Algebra R₀ (RatFunc F) := (IsLocalization.Away.lift Δ hΔ_K_unit).toAlgebra
  have _ : IsScalarTower (Polynomial F) R₀ (RatFunc F) :=
    IsScalarTower.of_algebraMap_eq fun p => (IsLocalization.Away.lift_eq Δ hΔ_K_unit p).symm
  have _ : IsScalarTower R₀ (RatFunc F) L := by
    apply IsScalarTower.of_algebraMap_eq'
    apply IsLocalization.ringHom_ext (Submonoid.powers Δ)
    apply RingHom.ext
    intro p
    simp only [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (RatFunc F),
      ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L,
      IsScalarTower.algebraMap_apply R₀ B L,
      ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B,
      ← IsScalarTower.algebraMap_apply (Polynomial F) B L]
  have _ : IsDomain R₀ := IsLocalization.isDomain_localization h_nzd
  have _ : IsFractionRing R₀ (RatFunc F) :=
    IsFractionRing.isFractionRing_of_isLocalization (Submonoid.powers Δ) R₀ (RatFunc F) h_nzd
  have _ : IsDedekindDomain R₀ := IsLocalization.isDedekindDomain (Polynomial F) h_nzd R₀
  have hΔ_not_span : Δ ∉ Ideal.span ({P} : Set (Polynomial F)) := by
    intro hmem
    rw [Ideal.mem_span_singleton] at hmem
    have hPrimeP : Prime P := UniqueFactorizationMonoid.irreducible_iff_prime.mp hIrr
    obtain ⟨s, hs, hdvd⟩ :=
      (hPrimeP.dvd_finsetProd_iff (S := S_aff) (fun s => Polynomial.X - Polynomial.C s)).mp hmem
    have hdeg_le : P.natDegree ≤ (Polynomial.X - Polynomial.C s).natDegree :=
      Polynomial.natDegree_le_of_dvd hdvd (Polynomial.X_sub_C_ne_zero s)
    rw [Polynomial.natDegree_X_sub_C] at hdeg_le
    have hdeg_pos : 0 < P.natDegree := Irreducible.natDegree_pos hIrr
    have hdeg1 : P.natDegree = 1 := by omega
    rcases hdvd with ⟨u, hu⟩
    have hu_ne : u ≠ 0 := by
      intro rfl
      exact Polynomial.X_sub_C_ne_zero s (by rw [hu, mul_zero])
    have hu_deg : u.natDegree = 0 := by
      have hmul := Polynomial.natDegree_mul hMon.ne_zero hu_ne
      rw [← hu, Polynomial.natDegree_X_sub_C, hdeg1] at hmul
      omega
    have hu_eq : u = 1 := by
      rw [Polynomial.eq_C_of_natDegree_eq_zero hu_deg]
      have hlc : (Polynomial.X - Polynomial.C s).leadingCoeff = (P * u).leadingCoeff :=
        congrArg Polynomial.leadingCoeff hu
      rw [(Polynomial.monic_X_sub_C s).leadingCoeff, Polynomial.leadingCoeff_mul,
        hMon.leadingCoeff, one_mul, Polynomial.leadingCoeff, hu_deg] at hlc
      rw [← hlc, map_one]
    rw [hu_eq, mul_one] at hu
    apply hAvoid s hs
    rw [← hu, Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C,
      sub_self]
  have hΔ_not_Q₀ : algebraMap (Polynomial F) B Δ ∉ Q₀ := by
    intro hmem
    have : Δ ∈ Ideal.comap (algebraMap (Polynomial F) B) Q₀ := hmem
    rw [hQ₀_comap] at this
    exact hΔ_not_span this
  have hΔ_not_Q : algebraMap (Polynomial F) B Δ ∉ Q := by
    intro hmem
    have : Δ ∈ Ideal.comap (algebraMap (Polynomial F) B) Q := hmem
    rw [hQ_comap] at this
    exact hΔ_not_span this
  have hQ₀_prime : Q₀.IsPrime := hQ₀_max.isPrime
  have hQ_prime : Q.IsPrime := hQ_max.isPrime
  have hunder_eq : Ideal.under R₀ Q₀ = Ideal.under R₀ Q := by
    ext r
    obtain ⟨n, a, hr_eq⟩ := IsLocalization.Away.surj Δ r
    have hr_B : algebraMap R₀ B r * (algebraMap (Polynomial F) B Δ) ^ n =
        algebraMap (Polynomial F) B a := by
      calc algebraMap R₀ B r * (algebraMap (Polynomial F) B Δ) ^ n
          = algebraMap R₀ B r * (algebraMap R₀ B (algebraMap (Polynomial F) R₀ Δ)) ^ n := by
              rw [← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B]
        _ = algebraMap R₀ B (r * (algebraMap (Polynomial F) R₀ Δ) ^ n) := by
              rw [← map_pow, ← map_mul]
        _ = algebraMap R₀ B (algebraMap (Polynomial F) R₀ a) := by rw [hr_eq]
        _ = algebraMap (Polynomial F) B a :=
              (IsScalarTower.algebraMap_apply (Polynomial F) R₀ B a).symm
    have hpow_not_Q₀ : (algebraMap (Polynomial F) B Δ) ^ n ∉ Q₀ :=
      fun hp => hΔ_not_Q₀ (hQ₀_prime.mem_of_pow_mem n hp)
    have hpow_not_Q : (algebraMap (Polynomial F) B Δ) ^ n ∉ Q :=
      fun hp => hΔ_not_Q (hQ_prime.mem_of_pow_mem n hp)
    have h1 : algebraMap R₀ B r ∈ Q₀ ↔ algebraMap (Polynomial F) B a ∈ Q₀ := by
      rw [← hr_B, hQ₀_prime.mul_mem_iff_mem_or_mem]
      constructor
      · exact Or.inl
      · intro h
        exact h.resolve_right hpow_not_Q₀
    have h2 : algebraMap R₀ B r ∈ Q ↔ algebraMap (Polynomial F) B a ∈ Q := by
      rw [← hr_B, hQ_prime.mul_mem_iff_mem_or_mem]
      constructor
      · exact Or.inl
      · intro h
        exact h.resolve_right hpow_not_Q
    change algebraMap R₀ B r ∈ Q₀ ↔ algebraMap R₀ B r ∈ Q
    rw [h1, h2]
    change a ∈ Ideal.comap (algebraMap (Polynomial F) B) Q₀ ↔
      a ∈ Ideal.comap (algebraMap (Polynomial F) B) Q
    rw [hQ₀_comap, hQ_comap]
  let p_R₀ : Ideal R₀ := Ideal.under R₀ Q₀
  have hQ₀_over : Q₀ ∈ p_R₀.primesOver B := ⟨hQ₀_prime, ⟨rfl⟩⟩
  have hQ_over : Q ∈ p_R₀.primesOver B := ⟨hQ_prime, ⟨hunder_eq⟩⟩
  obtain ⟨γ_L, hγ_comap⟩ := Ideal.exists_comap_galRestrict_eq R₀ (RatFunc F) L B hQ₀_over hQ_over
  let τ : B ≃ₐ[R₀] B := galRestrict R₀ (RatFunc F) L B γ_L
  let σ₁ : B ≃ₐ[R₀] B := τ⁻¹ * σ₀ * τ
  have hConj₁ : IsConj σ₀ σ₁ := isConj_iff.mpr ⟨τ⁻¹, by simp [σ₁, mul_assoc]⟩
  have hσ₁_frob : ∀ b : B, σ₁.symm b - b ^ N ∈ Q := by
    intro b
    have hsymm : σ₁.symm b = τ.symm (σ₀.symm (τ b)) := by
      change (σ₁⁻¹) b = (τ⁻¹) (σ₀⁻¹ (τ b))
      have hinv : σ₁⁻¹ = τ⁻¹ * σ₀⁻¹ * τ := by
        dsimp [σ₁]
        rw [mul_inv_rev, mul_inv_rev, inv_inv, mul_assoc]
      rw [hinv, AlgEquiv.mul_apply, AlgEquiv.mul_apply]
    rw [← hγ_comap]
    change τ (σ₁.symm b - b ^ N) ∈ Q₀
    rw [map_sub, map_pow, hsymm, τ.apply_symm_apply]
    exact hQ₀_frob (τ b)
  let θ : B ≃ₐ[R₀] B := σ₁⁻¹ * σ
  have hθ_mem : ∀ x : B, θ x - x ∈ Q := by
    intro x
    have h1 := hσ₁_frob (σ x)
    have h2 := hQ_frob (σ x)
    have hsub := Q.sub_mem h1 h2
    have hcancel : (σ₁.symm (σ x) - (σ x) ^ N) - (σ.symm (σ x) - (σ x) ^ N) = θ x - x := by
      rw [σ.symm_apply_apply]
      change (θ x - (σ x) ^ N) - (x - (σ x) ^ N) = θ x - x
      ring
    rwa [hcancel] at hsub
  have _ : IsNoetherianRing R₀ := IsLocalization.isNoetherianRing (Submonoid.powers Δ) R₀ inferInstance
  have _ : Module.Finite R₀ (TensorProduct R₀ B B) := Module.Finite.tensorProduct R₀ B B
  have _ : IsNoetherianRing (TensorProduct R₀ B B) :=
    IsNoetherianRing.of_finite R₀ (TensorProduct R₀ B B)
  let I_Δ : Ideal (TensorProduct R₀ B B) := KaehlerDifferential.ideal R₀ B
  have hFG : (I_Δ : Submodule (TensorProduct R₀ B B) (TensorProduct R₀ B B)).FG :=
    IsNoetherian.noetherian I_Δ
  have hSub : Subsingleton Ω[B⁄R₀] :=
    Algebra.FormallyEtale.subsingleton_kaehlerDifferential (R := R₀) (A := B)
  have h_le : (I_Δ : Submodule (TensorProduct R₀ B B) (TensorProduct R₀ B B)) ≤
      I_Δ • (I_Δ : Submodule (TensorProduct R₀ B B) (TensorProduct R₀ B B)) := by
    intro z hz
    have hker : (⟨z, hz⟩ : ↥I_Δ) ∈ I_Δ.toCotangent.ker :=
      LinearMap.mem_ker.mpr (@Subsingleton.elim _ hSub _ _)
    have hsq : z ∈ I_Δ ^ 2 := (Ideal.mem_toCotangent_ker I_Δ).mp hker
    rwa [sq, ← Ideal.smul_eq_mul] at hsq
  obtain ⟨r_idem, hr_one, hr_ann⟩ :=
    Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul I_Δ I_Δ hFG h_le
  let μ : TensorProduct R₀ B B →ₐ[R₀] B :=
    Algebra.TensorProduct.lift (AlgHom.id R₀ B) θ.toAlgHom (fun _ _ => Commute.all _ _)
  have hI_le : I_Δ ≤ Ideal.comap μ.toRingHom Q := by
    dsimp only [I_Δ]
    rw [← KaehlerDifferential.span_range_eq_ideal R₀ B, Ideal.span_le]
    rintro _ ⟨s, rfl⟩
    change μ (1 ⊗ₜ[R₀] s - s ⊗ₜ[R₀] 1) ∈ Q
    dsimp only [μ]
    simp only [map_sub, Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, map_one, one_mul, mul_one]
    exact hθ_mem s
  have hμr_ne : μ r_idem ≠ 0 := by
    intro h0
    have hrmem : μ (r_idem - 1) ∈ Q := hI_le hr_one
    rw [map_sub, h0, map_one, zero_sub] at hrmem
    have h1mem : (1 : B) ∈ Q := by simpa using Q.neg_mem hrmem
    exact hQ_max.ne_top ((Ideal.eq_top_iff_one Q).mpr h1mem)
  have hθ_eq_one : θ = 1 := by
    ext s
    have hgen_mem : (1 ⊗ₜ[R₀] s - s ⊗ₜ[R₀] 1 : TensorProduct R₀ B B) ∈ I_Δ := by
      dsimp only [I_Δ]
      rw [← KaehlerDifferential.span_range_eq_ideal R₀ B]
      exact Ideal.subset_span ⟨s, rfl⟩
    have hmul0 : r_idem * (1 ⊗ₜ[R₀] s - s ⊗ₜ[R₀] 1) = 0 := hr_ann _ hgen_mem
    have hμ0 : μ (r_idem * (1 ⊗ₜ[R₀] s - s ⊗ₜ[R₀] 1)) = 0 := by rw [hmul0, map_zero]
    rw [map_mul, map_sub] at hμ0
    have hμ_gen : μ (1 ⊗ₜ[R₀] s) - μ (s ⊗ₜ[R₀] 1) = θ s - s := by
      dsimp only [μ]
      simp only [Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, map_one, one_mul, mul_one]
      rfl
    rw [hμ_gen] at hμ0
    have hsub0 : θ s - s = 0 := (mul_eq_zero.mp hμ0).resolve_left hμr_ne
    exact sub_eq_zero.mp hsub0
  have hσ_eq : σ = σ₁ := (inv_mul_eq_one.mp hθ_eq_one).symm
  rwa [hσ_eq]

theorem weil_mid_dev_raw_locConst_geom_open_mod_prime_and_pullback (F : Type u) [Finite F] [Field F]
    (d_rel : ℕ)
