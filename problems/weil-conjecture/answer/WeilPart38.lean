  have hCoverKillToHdiZero :
      ∀ {U Y : AlgebraicGeometry.Scheme.{u}} (j : U ⟶ Y) (b : ℕ),
        (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
          (w : W ⟶ Y) [AlgebraicGeometry.Etale w]
          (ξ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j w) ℓ b),
          ∃ (I : Type u) (V : I → AlgebraicGeometry.Scheme.{u})
            (u : ∀ a, V a ⟶ W) (_ : ∀ a, AlgebraicGeometry.Etale (u a)),
            (⋃ a, Set.range (u a).base) = Set.univ ∧
            ∀ (a : I)
              (p_a : weilEtaleTorsionH (CategoryTheory.Limits.pullback j w) ℓ b →+
                weilEtaleTorsionH
                  (CategoryTheory.Limits.pullback
                    (CategoryTheory.Limits.pullback.snd j w) (u a)) ℓ b),
              WeilIsTorsionEtalePullback
                (CategoryTheory.Limits.pullback.fst
                  (CategoryTheory.Limits.pullback.snd j w) (u a)) ℓ b p_a →
              p_a ξ = 0) →
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage j b (weilEtaleTorsionSheaf U ℓ)) := by
    intro U Y j b hKill
    let etProp : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    let _ : CategoryTheory.MorphismProperty.IsStableUnderComposition etProp :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong etProp j :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong etProp j :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_j : CategoryTheory.Functor Y.Etale U.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback etProp ⊤ j
    let F_U := weilEtaleTorsionSheaf U ℓ
    let P_U := F_U.cohomologyPresheaf b
    let Q : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := CategoryTheory.Functor.comp B_j.op P_U
    let J_Y := Y.smallEtaleTopology
    let F_sh : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
      (CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}).obj Q
    let adj_sh := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
    let η_Q : Q ⟶ F_sh.obj := adj_sh.unit.app Q
    obtain ⟨Θ, hΘ⟩ := weil_alt_cd_etale_slice_torsionH_and_pi_vanishing.1 U ℓ b
    have hη_zero : η_Q = 0 := by
      refine CategoryTheory.NatTrans.ext (funext fun E_op => AddCommGrpCat.ext fun s => ?_)
      let E : Y.Etale := E_op.unop
      let R_zero : CategoryTheory.Sieve E :=
        { arrows := fun {Z} f => (Q.map f.op) s = 0
          downward_closed := fun {Z₁ Z₂} f hf h => by
            rw [op_comp, Q.map_comp]
            change (Q.map h.op) ((Q.map f.op) s) = 0
            rw [hf]
            exact map_zero (Q.map h.op).hom }
      have hR_mem : R_zero ∈ J_Y E := by
        rw [hMemEtale]
        intro x
        obtain ⟨O_x, hAffO, hxO, -⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
            (x := x) (U := (⊤ : E.left.Opens)) trivial
        let W : AlgebraicGeometry.Scheme.{u} := O_x.toScheme
        have _ : AlgebraicGeometry.IsAffine W := hAffO
        let w : W ⟶ Y := O_x.ι ≫ E.hom
        have hw_et : AlgebraicGeometry.Etale w :=
          CategoryTheory.MorphismProperty.comp_mem etProp O_x.ι E.hom inferInstance E.prop
        have _ : AlgebraicGeometry.Etale w := hw_et
        let W₀ : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w hw_et
        let ι_O : W₀ ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_x.ι rfl
        let s_W : ↥(Q.obj (Opposite.op W₀)) := (Q.map ι_O.op) s
        let ξ_sym := Θ (B_j.obj W₀) s_W
        let sym_jw : CategoryTheory.Limits.pullback j w ⟶ CategoryTheory.Limits.pullback w j :=
          (CategoryTheory.Limits.pullbackSymmetry j w).hom
        obtain ⟨p_sym, hp_sym⟩ := hPullEx sym_jw ℓ b
        let ξ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j w) ℓ b := p_sym ξ_sym
        obtain ⟨I, V, u, hEt_u, hCov_u, hKill_u⟩ := hKill W w ξ
        let x_W : ↥W := ⟨x, hxO⟩
        have hx_in : x_W ∈ ⋃ a : I, Set.range (u a).base := by
          rw [hCov_u]; trivial
        obtain ⟨a, y, hy⟩ := Set.mem_iUnion.mp hx_in
        let w_Zy : V a ⟶ Y := u a ≫ w
        let Z_y : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w_Zy
