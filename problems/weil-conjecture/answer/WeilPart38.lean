    intro W₁ W₂ u σ
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Limits.pullback.lift_fst]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_snd]

  
  let E_sub : ∀ W : U.Etale,
      AddSubgroup (LocallyConstant ↥(CategoryTheory.Limits.pullback (FgtU.obj W).hom π)
        (Fin N → Λ)) :=
    fun W =>
      { carrier := { f | ∀ (σ : S ≃ₐ[R] S)
            (y : ↥(CategoryTheory.Limits.pullback (FgtU.obj W).hom π)),
            f ((m_can (FgtU.obj W).hom σ).base y) = ((ρ σ).val).mulVec (f y) }
        zero_mem' := by
          intro σ y
          simp only [LocallyConstant.coe_zero, Pi.zero_apply, Matrix.mulVec_zero]
        add_mem' := by
          intro f₁ f₂ hf₁ hf₂ σ y
          simp only [LocallyConstant.coe_add, Pi.add_apply, hf₁ σ y, hf₂ σ y, Matrix.mulVec_add]
        neg_mem' := by
          intro f hf σ y
          simp only [LocallyConstant.coe_neg, Pi.neg_apply, hf σ y, Matrix.mulVec_neg] }
  let res_hom : ∀ {W₁ W₂ : U.Etale} (u : W₁ ⟶ W₂), ↥(E_sub W₂) →+ ↥(E_sub W₁) :=
    fun {W₁ W₂} u =>
      { toFun := fun s =>
          ⟨s.1.comap (u_can u).base.hom, fun σ y => by
            change s.1 ((u_can u).base ((m_can (FgtU.obj W₁).hom σ).base y)) =
              ((ρ σ).val).mulVec (s.1 ((u_can u).base y))
            have hpt : (u_can u).base ((m_can (FgtU.obj W₁).hom σ).base y) =
                (m_can (FgtU.obj W₂).hom σ).base ((u_can u).base y) := by
              rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hm_u_comm u σ,
                AlgebraicGeometry.Scheme.Hom.comp_apply]
            rw [hpt]
            exact s.2 σ ((u_can u).base y)⟩
        map_zero' := Subtype.ext (LocallyConstant.ext fun _ => rfl)
        map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }
  let ℰ_pre : (U.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
    { obj := fun W_op => AddCommGrpCat.of ↥(E_sub W_op.unop)
      map := fun f_op => AddCommGrpCat.ofHom (res_hom f_op.unop)
      map_id := fun W_op => by
        apply AddCommGrpCat.ext
        intro s
        apply Subtype.ext
        apply LocallyConstant.ext
        intro y
        change s.1 ((u_can (𝟙 W_op.unop)).base y) = s.1 y
        rw [hu_can_id]
        rfl
      map_comp := fun f g => by
        apply AddCommGrpCat.ext
        intro s
        apply Subtype.ext
        apply LocallyConstant.ext
        intro y
        change s.1 ((u_can (g.unop ≫ f.unop)).base y) =
          s.1 ((u_can f.unop).base ((u_can g.unop).base y))
        rw [hu_can_comp, AlgebraicGeometry.Scheme.Hom.comp_apply] }

  have hu_et : ∀ {Y₁ Y₂ : U.Etale} (u : Y₁ ⟶ Y₂), AlgebraicGeometry.Etale (FgtU.map u).left := by
    intro Y₁ Y₂ u
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      (FgtU.map u).left (FgtU.obj Y₂).hom Y₂.prop (by rw [(FgtU.map u).w]; exact Y₁.prop)
  have hu_pb : ∀ {Y₁ Y₂ : U.Etale} (u : Y₁ ⟶ Y₂),
      CategoryTheory.IsPullback (u_can u)
        (CategoryTheory.Limits.pullback.fst (FgtU.obj Y₁).hom π)
        (CategoryTheory.Limits.pullback.fst (FgtU.obj Y₂).hom π)
        (FgtU.map u).left := by
    intro Y₁ Y₂ u
    have hOuter : CategoryTheory.IsPullback
        (u_can u ≫ CategoryTheory.Limits.pullback.snd (FgtU.obj Y₂).hom π)
        (CategoryTheory.Limits.pullback.fst (FgtU.obj Y₁).hom π)
        π ((FgtU.map u).left ≫ (FgtU.obj Y₂).hom) := by
      rw [CategoryTheory.Limits.pullback.lift_snd, (FgtU.map u).w]
      exact (CategoryTheory.IsPullback.of_hasPullback (FgtU.obj Y₁).hom π).flip
    exact CategoryTheory.IsPullback.of_right hOuter
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback (FgtU.obj Y₂).hom π).flip
  have hu_can_et : ∀ {Y₁ Y₂ : U.Etale} (u : Y₁ ⟶ Y₂), AlgebraicGeometry.Etale (u_can u) :=
    fun u => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (hu_pb u).flip (hu_et u)

  have hSheaf : CategoryTheory.Presheaf.IsSheaf U.smallEtaleTopology ℰ_pre := by
    intro M W R_sieve hR x hx
    let h_W := (FgtU.obj W).hom
    let W_V := CategoryTheory.Limits.pullback h_W π
    have hCov_WV : ∀ z : ↥W_V,
        ∃ (Y : U.Etale) (f : Y ⟶ W) (_ : R_sieve.arrows f)
          (w : ↥(CategoryTheory.Limits.pullback (FgtU.obj Y).hom π)),
          (u_can f).base w = z := by
      intro z
      obtain ⟨Y, f, y, hf_arr, _, hfy⟩ :=
        (hMem_U W R_sieve).mp hR ((CategoryTheory.Limits.pullback.fst h_W π).base z)
      obtain ⟨p, hp_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hfy.symm
      refine ⟨Y, f, hf_arr, ((hu_pb f).isoPullback.inv).base p, ?_⟩
      have hcomp := (hu_pb f).isoPullback_inv_fst
      have hpt := congrArg (fun k => k.base p) hcomp
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply] at hpt
      exact hpt.trans hp_fst
    have hOverlap : ∀ (m : ↥M) {Y₁ Y₂ : U.Etale} (f₁ : Y₁ ⟶ W) (f₂ : Y₂ ⟶ W)
        (hf₁ : R_sieve.arrows f₁) (hf₂ : R_sieve.arrows f₂)
        (w₁ : ↥(CategoryTheory.Limits.pullback (FgtU.obj Y₁).hom π))
        (w₂ : ↥(CategoryTheory.Limits.pullback (FgtU.obj Y₂).hom π)),
        (u_can f₁).base w₁ = (u_can f₂).base w₂ →
        ((x f₁ hf₁).hom m).1 w₁ = ((x f₂ hf₂).hom m).1 w₂ := by
      intro m Y₁ Y₂ f₁ f₂ hf₁ hf₂ w₁ w₂ hw_eq
      let u₁_left := (FgtU.map f₁).left
      let u₂_left := (FgtU.map f₂).left
      let P₁₂ := CategoryTheory.Limits.pullback u₁_left u₂_left
      let p₁ := CategoryTheory.Limits.pullback.fst u₁_left u₂_left
      let p₂ := CategoryTheory.Limits.pullback.snd u₁_left u₂_left
      have hp₁_et : AlgebraicGeometry.Etale p₁ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback u₁_left u₂_left).flip (hu_et f₂)
      have hp₁Y₁_et : AlgebraicGeometry.Etale (p₁ ≫ (FgtU.obj Y₁).hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          p₁ (FgtU.obj Y₁).hom hp₁_et Y₁.prop
      let Z₁₂ : U.Etale := AlgebraicGeometry.Scheme.Etale.mk (p₁ ≫ (FgtU.obj Y₁).hom)
      have hp₂_w : p₂ ≫ (FgtU.obj Y₂).hom = (FgtU.obj Z₁₂).hom := by
        change p₂ ≫ (FgtU.obj Y₂).hom = p₁ ≫ (FgtU.obj Y₁).hom
        rw [← (FgtU.map f₂).w, ← CategoryTheory.Category.assoc,
          ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
          (FgtU.map f₁).w]
      let p1_et : Z₁₂ ⟶ Y₁ :=
        (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful U).preimage
          (CategoryTheory.Over.homMk p₁ rfl)
      let p2_et : Z₁₂ ⟶ Y₂ :=
        (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful U).preimage
          (CategoryTheory.Over.homMk p₂ hp₂_w)
      have hp1_et_left : (FgtU.map p1_et).left = p₁ :=
        congrArg CategoryTheory.Over.Hom.left
          ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful U).map_preimage _)
      have hp2_et_left : (FgtU.map p2_et).left = p₂ :=
        congrArg CategoryTheory.Over.Hom.left
          ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful U).map_preimage _)
      have hp_comm : p1_et ≫ f₁ = p2_et ≫ f₂ := by
        apply (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful U).map_injective
        apply CategoryTheory.Over.OverMorphism.ext
        change (FgtU.map (p1_et ≫ f₁)).left = (FgtU.map (p2_et ≫ f₂)).left
        rw [FgtU.map_comp, FgtU.map_comp]
        change (FgtU.map p1_et).left ≫ u₁_left = (FgtU.map p2_et).left ≫ u₂_left
        rw [hp1_et_left, hp2_et_left]
        exact CategoryTheory.Limits.pullback.condition
      let Q := CategoryTheory.Limits.pullback (u_can f₁) (u_can f₂)
      let q₁ := CategoryTheory.Limits.pullback.fst (u_can f₁) (u_can f₂)
      let q₂ := CategoryTheory.Limits.pullback.snd (u_can f₁) (u_can f₂)
      obtain ⟨q, hq₁, hq₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w₁ w₂ hw_eq
      have hψ_U_cond : (q₁ ≫ CategoryTheory.Limits.pullback.fst (FgtU.obj Y₁).hom π) ≫ u₁_left =
          (q₂ ≫ CategoryTheory.Limits.pullback.fst (FgtU.obj Y₂).hom π) ≫ u₂_left := by
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          ← hu_can_fst f₁, ← hu_can_fst f₂,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition]
      let ψ_U : Q ⟶ P₁₂ :=
        CategoryTheory.Limits.pullback.lift
          (q₁ ≫ CategoryTheory.Limits.pullback.fst (FgtU.obj Y₁).hom π)
          (q₂ ≫ CategoryTheory.Limits.pullback.fst (FgtU.obj Y₂).hom π)
          hψ_U_cond
      have hψU_fst : ψ_U ≫ p₁ = q₁ ≫ CategoryTheory.Limits.pullback.fst (FgtU.obj Y₁).hom π :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hψU_snd : ψ_U ≫ p₂ = q₂ ≫ CategoryTheory.Limits.pullback.fst (FgtU.obj Y₂).hom π :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hψ_cond : ψ_U ≫ (FgtU.obj Z₁₂).hom =
          (q₁ ≫ CategoryTheory.Limits.pullback.snd (FgtU.obj Y₁).hom π) ≫ π := by
        change ψ_U ≫ (p₁ ≫ (FgtU.obj Y₁).hom) = _
        rw [← CategoryTheory.Category.assoc, hψU_fst,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
          CategoryTheory.Category.assoc]
      let ψ : Q ⟶ CategoryTheory.Limits.pullback (FgtU.obj Z₁₂).hom π :=
        CategoryTheory.Limits.pullback.lift ψ_U
          (q₁ ≫ CategoryTheory.Limits.pullback.snd (FgtU.obj Y₁).hom π) hψ_cond
      have hψ_fst : ψ ≫ CategoryTheory.Limits.pullback.fst (FgtU.obj Z₁₂).hom π = ψ_U :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hψ_snd : ψ ≫ CategoryTheory.Limits.pullback.snd (FgtU.obj Z₁₂).hom π =
          q₁ ≫ CategoryTheory.Limits.pullback.snd (FgtU.obj Y₁).hom π :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hψ_p₁ : ψ ≫ u_can p1_et = q₁ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, hu_can_fst p1_et,
            ← CategoryTheory.Category.assoc, hψ_fst, hp1_et_left]
          exact hψU_fst
        · rw [CategoryTheory.Category.assoc, hu_can_snd p1_et, hψ_snd]
      have hψ_p₂ : ψ ≫ u_can p2_et = q₂ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, hu_can_fst p2_et,
            ← CategoryTheory.Category.assoc, hψ_fst, hp2_et_left]
          exact hψU_snd
        · rw [CategoryTheory.Category.assoc, hu_can_snd p2_et, hψ_snd]
          calc q₁ ≫ CategoryTheory.Limits.pullback.snd (FgtU.obj Y₁).hom π
              = q₁ ≫ u_can f₁ ≫ CategoryTheory.Limits.pullback.snd h_W π := by
                  rw [hu_can_snd f₁]
            _ = (q₁ ≫ u_can f₁) ≫ CategoryTheory.Limits.pullback.snd h_W π :=
                  (CategoryTheory.Category.assoc _ _ _).symm
            _ = (q₂ ≫ u_can f₂) ≫ CategoryTheory.Limits.pullback.snd h_W π := by
                  rw [CategoryTheory.Limits.pullback.condition]
            _ = q₂ ≫ CategoryTheory.Limits.pullback.snd (FgtU.obj Y₂).hom π := by
                  rw [CategoryTheory.Category.assoc, hu_can_snd f₂]
      have hcompat :
          (x f₁ hf₁ ≫ ℰ_pre.map (Opposite.op p1_et) : M ⟶ ℰ_pre.obj (Opposite.op Z₁₂)) =
            x f₂ hf₂ ≫ ℰ_pre.map (Opposite.op p2_et) :=
        hx p1_et p2_et hf₁ hf₂ hp_comm
      have hval := congrArg (fun k : M ⟶ ℰ_pre.obj (Opposite.op Z₁₂) => (k.hom m).1 (ψ.base q))
        hcompat
      change ((x f₁ hf₁).hom m).1 ((u_can p1_et).base (ψ.base q)) =
        ((x f₂ hf₂).hom m).1 ((u_can p2_et).base (ψ.base q)) at hval
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, ← AlgebraicGeometry.Scheme.Hom.comp_apply,
        hψ_p₁, hψ_p₂, hq₁, hq₂] at hval
      exact hval
    let Y_z : ↥W_V → U.Etale := fun z => Classical.choose (hCov_WV z)
    let f_z : ∀ z : ↥W_V, Y_z z ⟶ W := fun z => Classical.choose (Classical.choose_spec (hCov_WV z))
    have hf_z : ∀ z : ↥W_V, R_sieve.arrows (f_z z) :=
      fun z => Classical.choose (Classical.choose_spec (Classical.choose_spec (hCov_WV z)))
    let w_z : ∀ z : ↥W_V, ↥(CategoryTheory.Limits.pullback (FgtU.obj (Y_z z)).hom π) :=
      fun z => Classical.choose
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCov_WV z))))
    have hw_z : ∀ z : ↥W_V, (u_can (f_z z)).base (w_z z) = z :=
      fun z => Classical.choose_spec
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCov_WV z))))
    let f_m : ↥M → ↥W_V → (Fin N → Λ) :=
      fun m z => ((x (f_z z) (hf_z z)).hom m).1 (w_z z)
    have hf_m_eval : ∀ (m : ↥M) {Y : U.Etale} (f : Y ⟶ W) (hf : R_sieve.arrows f)
        (w : ↥(CategoryTheory.Limits.pullback (FgtU.obj Y).hom π)),
        f_m m ((u_can f).base w) = ((x f hf).hom m).1 w := by
      intro m Y f hf w
      exact hOverlap m (f_z ((u_can f).base w)) f (hf_z _) hf (w_z _) w (hw_z _)
    have hf_m_lc : ∀ m : ↥M, IsLocallyConstant (f_m m) := by
      intro m S_set
      have hpre : f_m m ⁻¹' S_set =
          ⋃ z : ↥W_V, (u_can (f_z z)).base '' (((x (f_z z) (hf_z z)).hom m).1 ⁻¹' S_set) := by
        ext z₀
        simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_image]
