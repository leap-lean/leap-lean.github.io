        AlgebraicGeometry.Etale w →
        Functor (Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
          (Sheaf V.smallEtaleTopology AddCommGrpCat.{u}) :=
      fun {V X _} hw =>
