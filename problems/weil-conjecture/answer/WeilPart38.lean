  have hFieldHens : ∀ (K : Type u) [Field K] [IsAlgClosed K],
      HenselianLocalRing K ∧ IsAlgClosed (IsLocalRing.ResidueField K) := by
    intro K _ _
    refine ⟨Field.henselian K, ?_⟩
    let e_resK : K ≃+* IsLocalRing.ResidueField K :=
      RingEquiv.ofBijective (IsLocalRing.residue K)
        ⟨RingHom.injective _, Ideal.Quotient.mk_surjective⟩
    refine IsAlgClosed.of_exists_root _ fun p _ hp_irred => ?_
    let q_pol : Polynomial K := Polynomial.map e_resK.symm.toRingHom p
    have hq_deg : q_pol.degree ≠ 0 := by
      rw [Polynomial.degree_map_eq_of_injective e_resK.symm.injective]
      exact ne_of_gt hp_irred.degree_pos
    obtain ⟨r₀, hr₀⟩ := IsAlgClosed.exists_root q_pol hq_deg
    refine ⟨e_resK r₀, ?_⟩
    have hmap : Polynomial.map e_resK.toRingHom q_pol = p := by
      rw [Polynomial.map_map]
      have hid : e_resK.toRingHom.comp e_resK.symm.toRingHom = RingHom.id _ :=
        RingHom.ext e_resK.apply_symm_apply
      rw [hid, Polynomial.map_id]
    change Polynomial.eval (e_resK.toRingHom r₀) p = 0
    rw [← hmap, Polynomial.eval_map, Polynomial.eval₂_hom, hr₀.eq_zero, map_zero]

  have hFieldPullH0 : ∀ {K₁ K₂ : Type u} [Field K₁] [IsAlgClosed K₁] [Field K₂] [IsAlgClosed K₂]
      (π : AlgebraicGeometry.Spec (CommRingCat.of K₁) ⟶ AlgebraicGeometry.Spec (CommRingCat.of K₂))
      (F₂ : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of K₂)).smallEtaleTopology AddCommGrpCat.{u})
      (F₁ : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of K₁)).smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback π F₂ F₁ →
      Nonempty (F₁.H 0 ≃+ F₂.H 0) ∧
      (CategoryTheory.Limits.IsZero F₂ ↔ CategoryTheory.Limits.IsZero F₁) := by
    intro K₁ K₂ _ _ _ _ π F₂ F₁ hPb
    obtain ⟨hHens₂, hAlg₂⟩ := hFieldHens K₂
    let _ : HenselianLocalRing K₂ := hHens₂
