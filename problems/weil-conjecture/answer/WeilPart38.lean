      have hnat : α ≫ adj₀.unit.app A₂ = adj₀.unit.app A₁ ≫ Γ₀.map (C₀.map α) :=
        adj₀.unit.naturality α
      rw [← hnat]
      dsimp [α]
      rw [Category.assoc, Category.assoc, IsIso.inv_hom_id, Category.comp_id]
      rfl
    have _ := hHasCokSh U ψ₀
    have _ := hHasCokSh W₀ ((resEtale hw₀).map ψ₀)
    have _ := hHasCokSh W₀ (C₀.map α)
    have _ := hHasCokAb α
    have _ : C₀.IsLeftAdjoint := adj₀.isLeftAdjoint
    have _ : C₀.Additive := by
      dsimp [C₀]; unfold CategoryTheory.constantSheaf; infer_instance
    have _ : Limits.PreservesFiniteLimits C₀ := by
      dsimp [C₀, CategoryTheory.constantSheaf]; infer_instance
    have _ : Limits.PreservesFiniteColimits C₀ := inferInstance
    let e_ker : (resEtale hw₀).obj (Limits.kernel ψ₀) ≅ C₀.obj (Limits.kernel α) :=
      Limits.PreservesKernel.iso (resEtale hw₀) ψ₀ ≪≫
        Limits.kernel.mapIso ((resEtale hw₀).map ψ₀) (C₀.map α) e₁ e₂
          (by rw [hCα]; dsimp [ψ]; simp) ≪≫
        (Limits.PreservesKernel.iso C₀ α).symm
    let e_cok : (resEtale hw₀).obj (Limits.cokernel ψ₀) ≅ C₀.obj (Limits.cokernel α) :=
      Limits.PreservesCokernel.iso (resEtale hw₀) ψ₀ ≪≫
        Limits.cokernel.mapIso ((resEtale hw₀).map ψ₀) (C₀.map α) e₁ e₂
          (by rw [hCα]; dsimp [ψ]; simp) ≪≫
        (Limits.PreservesCokernel.iso C₀ α).symm
    have _ : Finite ↥A₁ := hFin₁
    have _ : Finite ↥A₂ := hFin₂
    have hFin_ker : Finite ↥(Limits.kernel α) :=
      Finite.of_injective _ ((AddCommGrpCat.mono_iff_injective (Limits.kernel.ι α)).mp inferInstance)
    have hFin_cok : Finite ↥(Limits.cokernel α) :=
      Finite.of_surjective _ ((AddCommGrpCat.epi_iff_surjective (Limits.cokernel.π α)).mp inferInstance)
    exact ⟨⟨W₀, w₀, Limits.kernel α, hw₀, ⟨y₀, hw₀_pt⟩, hFin_ker, (hResPbIff hw₀).2 ⟨e_ker⟩⟩,
      ⟨W₀, w₀, Limits.cokernel α, hw₀, ⟨y₀, hw₀_pt⟩, hFin_cok, (hResPbIff hw₀).2 ⟨e_cok⟩⟩⟩

  have hLC_coker := (hKerCokAtX d₀ hLC₀ hLC₁).2
  have hLC_ker := (hKerCokAtX d₃ hLC₃ hLC₄).1

  
  have hFactorSES :
      ∃ (SC : ShortComplex (Sheaf U.smallEtaleTopology AddCommGrpCat.{u})),
        SC.ShortExact ∧
        SC.X₁ = Limits.cokernel d₀ ∧
        SC.X₂ = 𝒳₂ ∧
        SC.X₃ = Limits.kernel d₃ := by
    clear * - U 𝒳₀ 𝒳₁ 𝒳₂ 𝒳₃ 𝒳₄ d₀ f g d₃ h₀₁ h₁₂ h₂₃ hEx₁ hEx₂ hEx₃
    let ι_C : Limits.cokernel d₀ ⟶ 𝒳₂ := Limits.cokernel.desc d₀ f h₀₁
    let p_K : 𝒳₂ ⟶ Limits.kernel d₃ := Limits.kernel.lift d₃ g h₂₃
    have _ : Mono ι_C := hEx₁.mono_cokernelDesc
    have _ : Epi p_K := hEx₃.epi_kernelLift
    have h_comp_zero : ι_C ≫ p_K = 0 := by
      apply (cancel_epi (Limits.cokernel.π d₀)).mp
      apply (cancel_mono (Limits.kernel.ι d₃)).mp
      rw [Limits.comp_zero, Limits.zero_comp, ← Category.assoc, Limits.cokernel.π_desc,
        Category.assoc, Limits.kernel.lift_ι, h₁₂]
    have hEx_mid : (ShortComplex.mk ι_C p_K h_comp_zero).Exact := by
      rw [ShortComplex.exact_iff_epi_kernel_lift]
      change Epi (Limits.kernel.lift p_K ι_C h_comp_zero)
      have hπ_ι : Limits.cokernel.π d₀ ≫ ι_C = f := Limits.cokernel.π_desc d₀ f h₀₁
      have hp_ι : p_K ≫ Limits.kernel.ι d₃ = g := Limits.kernel.lift_ι d₃ g h₂₃
      have _ : Epi (Limits.kernel.lift g f h₁₂) := hEx₂.epi_kernelLift
      let u : Limits.kernel p_K ⟶ Limits.kernel g :=
        Limits.kernel.lift g (Limits.kernel.ι p_K)
          (by rw [← hp_ι, ← Category.assoc, Limits.kernel.condition, Limits.zero_comp])
      have hker_pK : Limits.kernel.ι g ≫ p_K = 0 := by
        apply (cancel_mono (Limits.kernel.ι d₃)).mp
        rw [Category.assoc, hp_ι, Limits.kernel.condition, Limits.zero_comp]
      let v : Limits.kernel g ⟶ Limits.kernel p_K :=
        Limits.kernel.lift p_K (Limits.kernel.ι g) hker_pK
      have _ : IsIso v :=
        ⟨u, by apply Limits.equalizer.hom_ext; simp [u, v],
          by apply Limits.equalizer.hom_ext; simp [u, v]⟩
      have hfac : Limits.kernel.lift g f h₁₂ ≫ v =
          Limits.cokernel.π d₀ ≫ Limits.kernel.lift p_K ι_C h_comp_zero := by
        apply Limits.equalizer.hom_ext
        simp [v, hπ_ι]
      have hEpi_comp : Epi (Limits.cokernel.π d₀ ≫ Limits.kernel.lift p_K ι_C h_comp_zero) := by
        rw [← hfac]
        exact epi_comp _ _
      exact epi_of_epi (Limits.cokernel.π d₀) (Limits.kernel.lift p_K ι_C h_comp_zero)
    exact ⟨ShortComplex.mk ι_C p_K h_comp_zero, { exact := hEx_mid }, rfl, rfl, rfl⟩

  obtain ⟨SC, hSE, hSC_X₁, hSC_X₂, hSC_X₃⟩ := hFactorSES
  have hX₁ : ∃ (W₁ : AlgebraicGeometry.Scheme.{u}) (w₁ : W₁ ⟶ U) (A₁ : AddCommGrpCat.{u}),
      AlgebraicGeometry.Etale w₁ ∧ x ∈ Set.range w₁.base ∧ Finite ↥A₁ ∧
      WeilIsEtaleSheafPullback w₁ SC.X₁
        ((CategoryTheory.constantSheaf W₁.smallEtaleTopology AddCommGrpCat.{u}).obj A₁) :=
    hSC_X₁.symm ▸ hLC_coker
  have hX₃ : ∃ (W₃ : AlgebraicGeometry.Scheme.{u}) (w₃ : W₃ ⟶ U) (A₃ : AddCommGrpCat.{u}),
      AlgebraicGeometry.Etale w₃ ∧ x ∈ Set.range w₃.base ∧ Finite ↥A₃ ∧
      WeilIsEtaleSheafPullback w₃ SC.X₃
        ((CategoryTheory.constantSheaf W₃.smallEtaleTopology AddCommGrpCat.{u}).obj A₃) :=
    hSC_X₃.symm ▸ hLC_ker

  
  have hStepW₂ :
      ∃ (W₂ : AlgebraicGeometry.Scheme.{u}) (w₂ : W₂ ⟶ U) (hw₂ : AlgebraicGeometry.Etale w₂)
        (y₂ : ↥W₂) (_ : ConnectedSpace ↥W₂)
        (A₁ A₃ : AddCommGrpCat.{u})
        (ℰ₂ : Sheaf W₂.smallEtaleTopology AddCommGrpCat.{u})
        (f₂ : (CategoryTheory.constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}).obj A₁ ⟶ ℰ₂)
        (g₂ : ℰ₂ ⟶ (CategoryTheory.constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}).obj A₃)
        (hfg₂ : f₂ ≫ g₂ = 0),
        w₂.base y₂ = x ∧
        Finite ↥A₁ ∧ Finite ↥A₃ ∧
        (ShortComplex.mk f₂ g₂ hfg₂).ShortExact ∧
        Epi (((CategoryTheory.sheafSections W₂.smallEtaleTopology AddCommGrpCat.{u}).obj
          (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk (𝟙 W₂)))).map g₂) ∧
        Nonempty ((resEtale hw₂).obj SC.X₂ ≅ ℰ₂) := by
    clear * - hEtComp hTerm hMemEt hShrink SC hSE x hX₁ hX₃
      resEtale hResExact hResComp hResPbIff hResConst hResEpi
    obtain ⟨W₁, w₁, A₁, hw₁, ⟨y₁, hy₁⟩, hFin₁, hPb₁⟩ := hX₁
    obtain ⟨W₃, w₃, A₃, hw₃, ⟨y₃, hy₃⟩, hFin₃, hPb₃⟩ := hX₃
    have _ := hw₁; have _ := hw₃
    obtain ⟨e₁_W₁⟩ := (hResPbIff hw₁).1 hPb₁
    obtain ⟨e₃_W₃⟩ := (hResPbIff hw₃).1 hPb₃
    let P := Limits.pullback w₁ w₃
    let fst : P ⟶ W₁ := Limits.pullback.fst w₁ w₃
    let snd : P ⟶ W₃ := Limits.pullback.snd w₁ w₃
    have hfst : AlgebraicGeometry.Etale fst := inferInstance
    have hsnd : AlgebraicGeometry.Etale snd := inferInstance
    let w_P : P ⟶ U := fst ≫ w₁
    have hw_P : AlgebraicGeometry.Etale w_P := inferInstance
    have hw_P_eq : snd ≫ w₃ = w_P := Limits.pullback.condition.symm
    obtain ⟨p, hp_fst, _⟩ :=
      Scheme.Pullback.exists_preimage_pullback y₁ y₃ (hy₁.trans hy₃.symm)
    have hw_P_pt : w_P.base p = x := by
      change w₁.base (fst.base p) = x
      rw [hp_fst, hy₁]
    let C_P := CategoryTheory.constantSheaf P.smallEtaleTopology AddCommGrpCat.{u}
    obtain ⟨e_comp₁⟩ := hResComp hfst hw₁ hw_P
    obtain ⟨e_c₁⟩ := hResConst hfst A₁
    have hw_P' : AlgebraicGeometry.Etale (snd ≫ w₃) := hw_P_eq.symm ▸ hw_P
    obtain ⟨e_comp₃⟩ := hResComp hsnd hw₃ hw_P'
    obtain ⟨e_c₃⟩ := hResConst hsnd A₃
    have hResEq : ∀ {g₁ g₂ : P ⟶ U} (_ : g₁ = g₂) (hg₁ : AlgebraicGeometry.Etale g₁)
        (hg₂ : AlgebraicGeometry.Etale g₂),
        (resEtale hg₂).obj SC.X₃ ≅ (resEtale hg₁).obj SC.X₃ := by
      rintro g₁ _ rfl _ _; exact Iso.refl _
    obtain ⟨e₁_P⟩ : Nonempty ((resEtale hw_P).obj SC.X₁ ≅ C_P.obj A₁) :=
      ⟨e_comp₁.app SC.X₁ ≪≫ (resEtale hfst).mapIso e₁_W₁ ≪≫ e_c₁⟩
    obtain ⟨e₃_P⟩ : Nonempty ((resEtale hw_P).obj SC.X₃ ≅ C_P.obj A₃) :=
      ⟨hResEq hw_P_eq hw_P' hw_P ≪≫ e_comp₃.app SC.X₃ ≪≫ (resEtale hsnd).mapIso e₃_W₃ ≪≫ e_c₃⟩
    obtain ⟨hAdd_RP, hLim_RP, hColim_RP⟩ := hResExact hw_P
    have _ := hAdd_RP; have _ := hLim_RP; have _ := hColim_RP
    let SC_P_raw := SC.map (resEtale hw_P)
    have hSE_P_raw : SC_P_raw.ShortExact := hSE.map_of_exact (resEtale hw_P)
    let ℰ_P := SC_P_raw.X₂
    let f_P : C_P.obj A₁ ⟶ ℰ_P := e₁_P.inv ≫ SC_P_raw.f
    let g_P : ℰ_P ⟶ C_P.obj A₃ := SC_P_raw.g ≫ e₃_P.hom
    have hfg_P : f_P ≫ g_P = 0 := by
      dsimp [f_P, g_P]
      rw [Category.assoc, ← Category.assoc SC_P_raw.f, SC_P_raw.zero,
        Limits.zero_comp, Limits.comp_zero]
    let SC_P : ShortComplex (Sheaf P.smallEtaleTopology AddCommGrpCat.{u}) :=
      ShortComplex.mk f_P g_P hfg_P
    have hSE_P : SC_P.ShortExact :=
      ShortComplex.shortExact_of_iso
        (ShortComplex.isoMk e₁_P (Iso.refl ℰ_P) e₃_P
          ((e₁_P.hom_inv_id_assoc SC_P_raw.f).trans (Category.comp_id SC_P_raw.f).symm)
          (Category.id_comp (SC_P_raw.g ≫ e₃_P.hom)))
        hSE_P_raw
    have _ : Epi g_P := hSE_P.epi_g
    have _ : Presheaf.IsLocallySurjective P.smallEtaleTopology g_P.hom :=
      (Sheaf.isLocallySurjective_iff_epi' (A := AddCommGrpCat.{u}) g_P).mpr inferInstance
    let T_P : P.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 P)
    let adj_P := CategoryTheory.constantSheafAdj P.smallEtaleTopology AddCommGrpCat.{u} (hTerm P)
    have hPointedLift : ∀ (L : List ↥((C_P.obj A₃).obj.obj (Opposite.op T_P))),
        ∃ (E : P.Etale) (u : E ⟶ T_P) (y_E : ↥E.left),
          u.left.base y_E = p ∧
          ∀ t ∈ L, ∃ s : ↥(ℰ_P.obj.obj (Opposite.op E)),
            (g_P.hom.app (Opposite.op E)).hom s = ((C_P.obj A₃).obj.map u.op).hom t := by
      intro L
      induction L with
      | nil =>
        exact ⟨T_P, 𝟙 T_P, p, rfl, fun _ h => False.elim (List.not_mem_nil h)⟩
      | cons t₀ L' ih =>
        obtain ⟨E', u', y_E', hy_E', hLift'⟩ := ih
        let t'_0 : ↥((C_P.obj A₃).obj.obj (Opposite.op E')) :=
          ((C_P.obj A₃).obj.map u'.op).hom t₀
        have hS₀ : Presheaf.imageSieve g_P.hom t'_0 ∈ P.smallEtaleTopology E' :=
          Presheaf.imageSieve_mem P.smallEtaleTopology g_P.hom t'_0
        obtain ⟨E, u₀, y_E, hu₀, _, hy_u₀⟩ := (hMemEt E' _).mp hS₀ y_E'
        have hy_comp : (u₀ ≫ u').left.base y_E = p := by
          change u'.left.base (u₀.left.base y_E) = p
          rw [hy_u₀, hy_E']
        refine ⟨E, u₀ ≫ u', y_E, hy_comp, fun t ht => ?_⟩
        rcases List.mem_cons.mp ht with rfl | ht'
        · obtain ⟨s₀, hs₀⟩ := hu₀
          refine ⟨s₀, ?_⟩
          have hs₀' : (g_P.hom.app (Opposite.op E)).hom s₀ =
              ((C_P.obj A₃).obj.map u₀.op).hom t'_0 := hs₀
          rw [hs₀']
          change ((C_P.obj A₃).obj.map u₀.op).hom (((C_P.obj A₃).obj.map u'.op).hom t) =
            ((C_P.obj A₃).obj.map (u'.op ≫ u₀.op)).hom t
          rw [(C_P.obj A₃).obj.map_comp]; rfl
        · obtain ⟨s', hs'⟩ := hLift' t ht'
          refine ⟨(ℰ_P.obj.map u₀.op).hom s', ?_⟩
          have hnat := congrArg (fun φ => φ.hom s') (g_P.hom.naturality u₀.op)
          change (g_P.hom.app (Opposite.op E)).hom ((ℰ_P.obj.map u₀.op).hom s') =
            ((C_P.obj A₃).obj.map u₀.op).hom ((g_P.hom.app (Opposite.op E')).hom s') at hnat
          rw [hnat, hs']
          change ((C_P.obj A₃).obj.map u₀.op).hom (((C_P.obj A₃).obj.map u'.op).hom t) =
            ((C_P.obj A₃).obj.map (u'.op ≫ u₀.op)).hom t
          rw [(C_P.obj A₃).obj.map_comp]; rfl
    have _ : Finite ↥A₃ := hFin₃
    let _ : Fintype ↥A₃ := Fintype.ofFinite ↥A₃
    let L₃ : List ↥((C_P.obj A₃).obj.obj (Opposite.op T_P)) :=
      (Finset.univ : Finset ↥A₃).toList.map (adj_P.unit.app A₃).hom
    obtain ⟨E_lift, u_lift, y_lift, hy_lift, hLifts⟩ := hPointedLift L₃
    have hy_lift_hom : E_lift.hom.base y_lift = p := by
      have hw_u : u_lift.left ≫ T_P.hom = E_lift.hom := MorphismProperty.Over.w u_lift
      have hw_u' : u_lift.left = E_lift.hom := (Category.comp_id u_lift.left).symm.trans hw_u
      rwa [← hw_u']
    have _ : AlgebraicGeometry.Etale E_lift.hom := E_lift.prop
    obtain ⟨W₂, j', y₂, hj'_open, hj'_pt, hConn₂⟩ :=
      hShrink E_lift.left (E_lift.hom ≫ w_P) inferInstance y_lift
    have _ := hj'_open; have _ := hConn₂
    let v : W₂ ⟶ P := j' ≫ E_lift.hom
    have hv : AlgebraicGeometry.Etale v := inferInstance
    let w₂ : W₂ ⟶ U := v ≫ w_P
    have hw₂ : AlgebraicGeometry.Etale w₂ := inferInstance
    have hw₂_pt : w₂.base y₂ = x := by
      change w_P.base (E_lift.hom.base (j'.base y₂)) = x
      rw [hj'_pt, hy_lift_hom, hw_P_pt]
    obtain ⟨hAdd_Rv, hLim_Rv, hColim_Rv⟩ := hResExact hv
    have _ := hAdd_Rv; have _ := hLim_Rv; have _ := hColim_Rv
    let C₂ := CategoryTheory.constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}
    let T₂ : W₂.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 W₂)
    let Γ₂ := (CategoryTheory.sheafSections W₂.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₂)
    obtain ⟨e_cA₁⟩ := hResConst hv A₁
    obtain ⟨e_cA₃⟩ := hResConst hv A₃
    let SC₂_raw := SC_P.map (resEtale hv)
    have hSE₂_raw : SC₂_raw.ShortExact := hSE_P.map_of_exact (resEtale hv)
    let ℰ₂ := (resEtale hv).obj ℰ_P
    let f₂ : C₂.obj A₁ ⟶ ℰ₂ := e_cA₁.inv ≫ SC₂_raw.f
    let g₂_raw : ℰ₂ ⟶ (resEtale hv).obj (C_P.obj A₃) := SC₂_raw.g
    let g₂ : ℰ₂ ⟶ C₂.obj A₃ := g₂_raw ≫ e_cA₃.hom
    have hfg₂ : f₂ ≫ g₂ = 0 := by
      dsimp [f₂, g₂, g₂_raw]
      rw [Category.assoc, ← Category.assoc SC₂_raw.f, SC₂_raw.zero,
        Limits.zero_comp, Limits.comp_zero]
    have hSE₂ : (ShortComplex.mk f₂ g₂ hfg₂).ShortExact :=
      ShortComplex.shortExact_of_iso
        (ShortComplex.isoMk e_cA₁ (Iso.refl ℰ₂) e_cA₃
          ((e_cA₁.hom_inv_id_assoc SC₂_raw.f).trans (Category.comp_id SC₂_raw.f).symm)
          (Category.id_comp (SC₂_raw.g ≫ e_cA₃.hom)))
        hSE₂_raw
    have _ : Epi (Γ₂.map g₂_raw) :=
      hResEpi u_lift j' hv g_P fun a =>
        hLifts _ (List.mem_map_of_mem (Finset.mem_toList.mpr (Finset.mem_univ a)))
    have hEpi_Γg₂ : Epi (Γ₂.map g₂) := by
      dsimp [g₂]; rw [Γ₂.map_comp]; exact epi_comp _ _
    obtain ⟨e_comp_vw⟩ := hResComp hv hw_P hw₂
    exact ⟨W₂, w₂, hw₂, y₂, hConn₂, A₁, A₃, ℰ₂, f₂, g₂, hfg₂,
      hw₂_pt, hFin₁, hFin₃, hSE₂, hEpi_Γg₂, ⟨e_comp_vw.app SC.X₂⟩⟩

  obtain ⟨W₂, w₂, hw₂, y₂, hConn₂, A₁, A₃, ℰ₂, f₂, g₂, hfg₂,
    hw₂_pt, hFin₁, hFin₃, hSE₂, hEpi_Γg₂, ⟨e_res_X₂⟩⟩ := hStepW₂
  have _ := hConn₂
  have hStepFive :
      ∃ (A₂ : AddCommGrpCat.{u}),
        Finite ↥A₂ ∧
        Nonempty (ℰ₂ ≅
          (CategoryTheory.constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}).obj A₂) := by
    clear * - hTerm hConnIso W₂ hConn₂ A₁ A₃ ℰ₂ f₂ g₂ hfg₂ hFin₁ hFin₃ hSE₂ hEpi_Γg₂
    let C₂ := CategoryTheory.constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}
    let T₂ : W₂.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 W₂)
    let Γ₂ := (CategoryTheory.sheafSections W₂.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₂)
    let adj₂ := CategoryTheory.constantSheafAdj W₂.smallEtaleTopology AddCommGrpCat.{u} (hTerm W₂)
    let SC₂ := ShortComplex.mk f₂ g₂ hfg₂
    have _ : Γ₂.IsRightAdjoint := adj₂.isRightAdjoint
    have _ : Γ₂.Additive := { map_add := fun {_ _ _ _} => AddCommGrpCat.ext fun _ => rfl }
    have _ : Limits.PreservesFiniteLimits Γ₂ := inferInstance
    let SC_ab := SC₂.map Γ₂
    have hEx_ab : SC_ab.Exact :=
      hSE₂.exact.map_of_mono_of_preservesKernel Γ₂ hSE₂.mono_f inferInstance
    have _ : Mono SC₂.f := hSE₂.mono_f
    have _ : Mono SC_ab.f := Γ₂.map_mono SC₂.f
    have _ : Epi SC_ab.g := hEpi_Γg₂
    have hSE_ab : SC_ab.ShortExact := { exact := hEx_ab }
    obtain ⟨hIso_u₁, hIso_c₁⟩ := hConnIso W₂ A₁
    obtain ⟨hIso_u₃, hIso_c₃⟩ := hConnIso W₂ A₃
    have _ := hIso_u₁; have _ := hIso_c₁; have _ := hIso_u₃; have _ := hIso_c₃
    have _ : Finite ↥SC_ab.X₁ :=
      @Finite.of_surjective ↥A₁ ↥SC_ab.X₁ hFin₁ _
        (ConcreteCategory.bijective_of_isIso (adj₂.unit.app A₁)).2
    have _ : Finite ↥SC_ab.X₃ :=
      @Finite.of_surjective ↥A₃ ↥SC_ab.X₃ hFin₃ _
        (ConcreteCategory.bijective_of_isIso (adj₂.unit.app A₃)).2
    have hFin_A₂ : Finite ↥(Γ₂.obj ℰ₂) := by
      have hSurj_g : Function.Surjective SC_ab.g.hom :=
        (AddCommGrpCat.epi_iff_surjective SC_ab.g).mp inferInstance
      let sec : ↥SC_ab.X₃ → ↥SC_ab.X₂ := fun z => (hSurj_g z).choose
      have hsec : ∀ z, SC_ab.g.hom (sec z) = z := fun z => (hSurj_g z).choose_spec
      have hKer : ∀ m : ↥SC_ab.X₂, m - sec (SC_ab.g.hom m) ∈ SC_ab.f.hom.range := by
        intro m
        rw [ShortComplex.ab_exact_iff_range_eq_ker.mp hEx_ab]
        change SC_ab.g.hom (m - sec (SC_ab.g.hom m)) = 0
        rw [map_sub, hsec, sub_self]
      refine Finite.of_injective
        (fun m : ↥SC_ab.X₂ => ((hKer m).choose, SC_ab.g.hom m))
        (fun m₁ m₂ hm => ?_)
      have h1 : (hKer m₁).choose = (hKer m₂).choose := congrArg Prod.fst hm
      have h2 : SC_ab.g.hom m₁ = SC_ab.g.hom m₂ := congrArg Prod.snd hm
      have hf1 := (hKer m₁).choose_spec
      have hf2 := (hKer m₂).choose_spec
      rw [h1, h2] at hf1
      exact sub_left_inj.mp (hf1.symm.trans hf2)
    have hIso_counit_ℰ₂ : IsIso (adj₂.counit.app ℰ₂) := by
      have _ : C₂.IsLeftAdjoint := adj₂.isLeftAdjoint
      have _ : C₂.Additive := by
        dsimp [C₂]; unfold CategoryTheory.constantSheaf; infer_instance
      have _ : Limits.PreservesFiniteColimits C₂ := inferInstance
      have _ : Limits.PreservesFiniteLimits C₂ := by
        dsimp [C₂, CategoryTheory.constantSheaf]; infer_instance
      let SC_top := SC_ab.map C₂
      have hSE_top : SC_top.ShortExact := hSE_ab.map_of_exact C₂
      let φ_SC : SC_top ⟶ SC₂ :=
        { τ₁ := adj₂.counit.app (C₂.obj A₁)
          τ₂ := adj₂.counit.app ℰ₂
          τ₃ := adj₂.counit.app (C₂.obj A₃)
          comm₁₂ := (adj₂.counit.naturality f₂).symm
          comm₂₃ := (adj₂.counit.naturality g₂).symm }
      have _ : Mono φ_SC.τ₂ :=
        ShortComplex.mono_of_mono_of_mono_of_mono φ_SC hSE_top.exact hSE₂.mono_f
          inferInstance inferInstance
      have _ : Epi φ_SC.τ₂ :=
        ShortComplex.epi_of_epi_of_epi_of_epi φ_SC hSE₂.exact hSE_top.epi_g
          inferInstance inferInstance
      exact Balanced.isIso_of_mono_of_epi (adj₂.counit.app ℰ₂)
    exact ⟨Γ₂.obj ℰ₂, hFin_A₂, ⟨(@asIso _ _ _ _ (adj₂.counit.app ℰ₂) hIso_counit_ℰ₂).symm⟩⟩

  obtain ⟨A₂, hFin_A₂, ⟨e_ℰ₂⟩⟩ := hStepFive
  have hPb_SC_X₂ : WeilIsEtaleSheafPullback w₂ SC.X₂
      ((CategoryTheory.constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}).obj A₂) :=
    (hResPbIff hw₂).2 ⟨e_res_X₂ ≪≫ e_ℰ₂⟩
  exact ⟨W₂, w₂, A₂, hw₂, ⟨y₂, hw₂_pt⟩, hFin_A₂, hSC_X₂ ▸ hPb_SC_X₂⟩

theorem weil_mid_dev_raw_open_smooth_prime_power_locConst (F : Type u) [Finite F] [Field F]
    (d_rel : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    (hProj_Ztilde : IsProjectiveOverField F Z_tilde)
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.Flat f₀.left]
    [AlgebraicGeometry.IsProper f₀.left]
    [AlgebraicGeometry.Surjective f₀.left]
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (hSm_U₀ : AlgebraicGeometry.SmoothOfRelativeDimension d_rel (f₀.left ∣_ U₀))
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U₀.toScheme)
    (heU_eq : e_U.hom ≫ U₀.ι =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F)
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))))) ≫
        j_aff)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (q r : ℕ) (x : ↥U₀.toScheme) :
    ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U₀.toScheme) (A₀ : AddCommGrpCat.{u}),
