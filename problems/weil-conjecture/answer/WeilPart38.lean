    let C_Ω := CategoryTheory.constantSheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}
    let adj'_Ω := CategoryTheory.constantSheafAdj S_Ω.smallEtaleTopology AddCommGrpCat.{u} hT'_Ω
    let e_const_Ω : (C_D ⋙ P_η₀) ≅ C_Ω :=
