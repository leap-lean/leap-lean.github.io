        obtain ⟨i₁, a₁, ha₁⟩ := Limits.Concrete.colimit_exists_rep D₁ (s₁ x γ)
        obtain ⟨i₂, b₂, hb₂⟩ := Limits.Concrete.colimit_exists_rep D₁ (s₂ x γ)
        let k := IsFiltered.max i₁ i₂
        let a_k : ↑(D₁.obj k) := (D₁.map (IsFiltered.leftToMax i₁ i₂)).hom a₁
        let b_k : ↑(D₁.obj k) := (D₁.map (IsFiltered.rightToMax i₁ i₂)).hom b₂
