    intro H₀ _ π₀ hTors₀ L₀ hMemL₀ u₀ hIndep₀ hSpanL₀ V₀ _ _ equiv₀ hsmul₀
    have hZero₀ : ∀ w : H₀ 0, w = 0 := by
