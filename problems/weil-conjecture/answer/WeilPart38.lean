    let φ_Ω : C_Ω.obj B ⟶ P_η₀.obj G' := e_const_Ω.inv.app B ≫ P_η₀.map φ
    let f_B : B ⟶ (P_η₀.obj G').obj.obj (Opposite.op T'_Ω) :=
