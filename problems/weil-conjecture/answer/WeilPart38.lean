      · refine ⟨fun hInj_Q z₁ z₂ hz => ?_, fun hInj_G z₁ z₂ hz => ?_⟩
        · obtain ⟨w₁, rfl⟩ := e_M_s.surjective z₁
          obtain ⟨w₂, rfl⟩ := e_M_s.surjective z₂
