        (CategoryTheory.Limits.pullback.lift_snd _ _ _) y

  
  have hSheetPkg : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V),
      let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ π) π
      ∃ δ : (S ≃ₐ[R] S) → (Y ⟶ Y_V),
        (∀ σ : S ≃ₐ[R] S,
          δ σ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π = 𝟙 Y ∧
          δ σ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π = g_Y ≫ s_mor σ ∧
          AlgebraicGeometry.Etale (δ σ) ∧
          IsOpen (Set.range (δ σ).base)) ∧
        (⋃ σ : S ≃ₐ[R] S, Set.range (δ σ).base) = Set.univ ∧
        (∀ f₁ f₂ : LocallyConstant ↥Y_V (Fin N → Λ),
          (∀ σ y, f₁ ((m_can (g_Y ≫ π) σ).base y) = ((ρ σ).val).mulVec (f₁ y)) →
          (∀ σ y, f₂ ((m_can (g_Y ≫ π) σ).base y) = ((ρ σ).val).mulVec (f₂ y)) →
          f₁.comap (δ 1).base.hom = f₂.comap (δ 1).base.hom →
          f₁ = f₂) ∧
        (∀ g : LocallyConstant ↥Y (Fin N → Λ),
          ∃ f : LocallyConstant ↥Y_V (Fin N → Λ),
            (∀ σ y, f ((m_can (g_Y ≫ π) σ).base y) = ((ρ σ).val).mulVec (f y)) ∧
            ∀ (σ : S ≃ₐ[R] S) (y : ↥Y), f ((δ σ).base y) = ((ρ σ).val).mulVec (g y)) := by
    intro Y g_Y Y_V
    obtain ⟨δ, hδ_props, hδ_disj, hδ_cov, hδ_var⟩ := hSheets Y g_Y
    refine ⟨δ, hδ_props, hδ_cov, ?_, ?_⟩
    · intro f₁ f₂ hf₁ hf₂ hcomap
      apply LocallyConstant.ext
      intro z
      have hz_univ : z ∈ (⋃ σ : S ≃ₐ[R] S, Set.range (δ σ).base) := by
        rw [hδ_cov]; exact Set.mem_univ z
      obtain ⟨σ, y, rfl⟩ := Set.mem_iUnion.mp hz_univ
      have hvar : δ 1 ≫ m_can (g_Y ≫ π) σ = δ σ := by
        rw [hδ_var 1 σ (m_can (g_Y ≫ π) σ)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _), mul_one]
      have hpt : (m_can (g_Y ≫ π) σ).base ((δ 1).base y) = (δ σ).base y := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hvar]
      have hy_eq : f₁ ((δ 1).base y) = f₂ ((δ 1).base y) :=
        congrArg (fun k : LocallyConstant ↥Y (Fin N → Λ) => k y) hcomap
      rw [← hpt, hf₁ σ ((δ 1).base y), hf₂ σ ((δ 1).base y), hy_eq]
    · intro g
      have hex : ∀ z : ↥Y_V, ∃ σ : S ≃ₐ[R] S, z ∈ Set.range (δ σ).base := by
        intro z
        exact Set.mem_iUnion.mp (hδ_cov ▸ Set.mem_univ z)
      let σ_of : ↥Y_V → (S ≃ₐ[R] S) := fun z => Classical.choose (hex z)
      have hσ_of : ∀ z : ↥Y_V, z ∈ Set.range (δ (σ_of z)).base :=
        fun z => Classical.choose_spec (hex z)
      let f_fun : ↥Y_V → (Fin N → Λ) :=
        fun z => ((ρ (σ_of z)).val).mulVec
          (g ((CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π).base z))
      have hf_sheet : ∀ (σ : S ≃ₐ[R] S) (y : ↥Y),
          f_fun ((δ σ).base y) = ((ρ σ).val).mulVec (g y) := by
        intro σ y
        have hσ_eq : σ_of ((δ σ).base y) = σ := by
          by_contra hne
          exact Set.disjoint_left.mp (hδ_disj _ _ hne) (hσ_of ((δ σ).base y)) ⟨y, rfl⟩
        have hfst_y : (CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π).base ((δ σ).base y) = y := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, (hδ_props σ).1]
          rfl
        dsimp only [f_fun]
        rw [hσ_eq, hfst_y]
      have hf_lc : IsLocallyConstant f_fun := by
        intro S_set
        have hpre : f_fun ⁻¹' S_set =
            ⋃ σ : S ≃ₐ[R] S,
              (δ σ).base '' (g ⁻¹' (((ρ σ).val).mulVec ⁻¹' S_set)) := by
          ext z
          simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_image]
          constructor
          · intro hz
            obtain ⟨σ, y, rfl⟩ := hex z
            rw [hf_sheet σ y] at hz
            exact ⟨σ, y, hz, rfl⟩
          · rintro ⟨σ, y, hy, rfl⟩
            rwa [hf_sheet σ y]
        rw [hpre]
        refine isOpen_iUnion fun σ => ?_
        have : AlgebraicGeometry.Etale (δ σ) := (hδ_props σ).2.2.1
        exact (δ σ).isOpenMap _ (g.isLocallyConstant _)
      refine ⟨⟨f_fun, hf_lc⟩, ?_, hf_sheet⟩
      intro τ z
      obtain ⟨σ, y, rfl⟩ := hex z
      have hvar : δ σ ≫ m_can (g_Y ≫ π) τ = δ (τ * σ) :=
        hδ_var σ τ (m_can (g_Y ≫ π) τ)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      have hpt : (m_can (g_Y ≫ π) τ).base ((δ σ).base y) = (δ (τ * σ)).base y := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hvar]
      change f_fun ((m_can (g_Y ≫ π) τ).base ((δ σ).base y)) =
        ((ρ τ).val).mulVec (f_fun ((δ σ).base y))
      rw [hpt, hf_sheet (τ * σ) y, hf_sheet σ y, map_mul ρ τ σ, Units.val_mul,
        ← Matrix.mulVec_mulVec]

  
