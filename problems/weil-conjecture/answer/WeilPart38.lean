    obtain ⟨u₀, v₀, huv₀, δ, hvδ₀, ⟨hMono_u₀, hEpi_δ₀, hEx_uv₀, hEx_vδ₀⟩, hIso_δ, hCommEdge⟩ :=
      weil_outer_tr_fib_higherDirectImage_ses_connecting_and_edge_comm g T_U hT_V SC hSE
    cases m with
    | zero =>
      have hSub02 : Subsingleton ((weilEtaleHigherDirectImage g 0 ℱ).H 2) :=
        hcd1 0 Nat.zero_lt_one 2 (by decide)
      have hSurj_post :=
        (weil_outer_tr_fib_abelian_four_term_cd1_shift u₀ v₀ (δ 0) huv₀ hvδ₀ hEx_uv₀ hEx_vδ₀
