              { toFun := fun m => ⟨g_fn m, hg_lc m⟩
                map_zero' := LocallyConstant.ext fun z => by
                  let ch := hcov z
                  let w_z : S₀.arrows.category := ⟨CategoryTheory.Over.mk ch.choose_spec.choose,
