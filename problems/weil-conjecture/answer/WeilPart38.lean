    have hResAdj : ∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X}
        (hw : AlgebraicGeometry.Etale w)
        (hc_w : (sitePb w).IsContinuous X.smallEtaleTopology V.smallEtaleTopology),
        Nonempty (resEtale hw ⊣ @Functor.sheafPushforwardContinuous _ _ _ _
          (sitePb w) AddCommGrpCat.{u} _ X.smallEtaleTopology V.smallEtaleTopology hc_w) := by
      clear * - hEtComp hEtPb hEtBC siteMap sitePb hOpenCont resEtale
      intro V X w hw hc_w
      let _ : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) w := hEtPb w
      let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) w := hEtBC w
      let _ := hc_w
      let _ := hOpenCont hw
      let B_w : Functor X.Etale V.Etale := sitePb w
      let adj_site : siteMap hw ⊣ B_w :=
        MorphismProperty.Over.mapPullbackAdj (@AlgebraicGeometry.Etale) ⊤ w hw trivial
      let R_M := (Functor.whiskeringLeft V.Etaleᵒᵖ X.Etaleᵒᵖ AddCommGrpCat.{u}).obj (siteMap hw).op
      let R_B := (Functor.whiskeringLeft X.Etaleᵒᵖ V.Etaleᵒᵖ AddCommGrpCat.{u}).obj B_w.op
      let adj_pre : R_M ⊣ R_B := Adjunction.mkOfUnitCounit
        { unit :=
            { app := fun Q =>
                { app := fun opT => Q.map (adj_site.counit.app opT.unop).op
                  naturality := fun {_ _} u =>
                    (Q.map_comp _ _).symm.trans
                      ((congrArg Q.map (Opposite.unop_injective
                        (adj_site.counit.naturality u.unop).symm)).trans (Q.map_comp _ _)) }
              naturality := fun {_ _} α => NatTrans.ext (funext fun _ => (α.naturality _).symm) }
          counit :=
            { app := fun Q =>
                { app := fun opY => Q.map (adj_site.unit.app opY.unop).op
                  naturality := fun {_ _} u =>
                    (Q.map_comp _ _).symm.trans
                      ((congrArg Q.map (Opposite.unop_injective
                        (adj_site.unit.naturality u.unop).symm)).trans (Q.map_comp _ _)) }
              naturality := fun {_ _} β => NatTrans.ext (funext fun _ => (β.naturality _).symm) }
          left_triangle := NatTrans.ext (funext fun Q => NatTrans.ext (funext fun opY =>
            (Category.id_comp _).trans ((Q.map_comp _ _).symm.trans
              ((congrArg Q.map (Opposite.unop_injective
                (adj_site.left_triangle_components opY.unop))).trans (Q.map_id _)))))
          right_triangle := NatTrans.ext (funext fun Q => NatTrans.ext (funext fun opT =>
            (Category.id_comp _).trans ((Q.map_comp _ _).symm.trans
              ((congrArg Q.map (Opposite.unop_injective
                (adj_site.right_triangle_components opT.unop))).trans (Q.map_id _))))) }
