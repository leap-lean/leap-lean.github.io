    have hθ_η₀ : P_η₀.map θ = 0 := by
      have hcomp_Ω : C_Ω.map ι_B₀ ≫ φ_Ω = 0 := by
        apply (adj'_Ω.homEquiv B₀ (P_η₀.obj G')).injective
        have h1 : (adj'_Ω.homEquiv B₀ (P_η₀.obj G')) (C_Ω.map ι_B₀ ≫ φ_Ω) =
            adj'_Ω.unit.app B₀ ≫ (C_Ω.map ι_B₀).hom.app (Opposite.op T'_Ω) ≫
              φ_Ω.hom.app (Opposite.op T'_Ω) := rfl
        have h2 : (adj'_Ω.homEquiv B₀ (P_η₀.obj G')) 0 =
            adj'_Ω.unit.app B₀ ≫ (0 : C_Ω.obj B₀ ⟶ P_η₀.obj G').hom.app (Opposite.op T'_Ω) := rfl
        have hnat_u : adj'_Ω.unit.app B₀ ≫ (C_Ω.map ι_B₀).hom.app (Opposite.op T'_Ω) =
            ι_B₀ ≫ adj'_Ω.unit.app B :=
          (adj'_Ω.unit.naturality ι_B₀).symm
        rw [h1, h2, ← CategoryTheory.Category.assoc, hnat_u, CategoryTheory.Category.assoc]
        change ι_B₀ ≫ f_B = _
        rw [CategoryTheory.Limits.kernel.condition]
        ext x; rfl
      have hnat_inv : e_const_Ω.inv.app B₀ ≫ P_η₀.map (C_D.map ι_B₀) =
          C_Ω.map ι_B₀ ≫ e_const_Ω.inv.app B :=
        (e_const_Ω.inv.naturality ι_B₀).symm
      have hinv_comp : e_const_Ω.inv.app B₀ ≫ P_η₀.map θ = C_Ω.map ι_B₀ ≫ φ_Ω := by
        dsimp [θ, α, φ_Ω]
        rw [P_η₀.map_comp, ← CategoryTheory.Category.assoc, hnat_inv,
          CategoryTheory.Category.assoc]
      rw [hcomp_Ω] at hinv_comp
