            _ = ∑ i : Fin N, (ι (b : R) * c i) • ϕ₀ (u₀ i) := by simp only [hz]
            _ = ι (b : R) • Ψ c := by simp only [Ψ, LinearMap.coe_mk, AddHom.coe_mk, mul_smul, ← Finset.smul_sum]
