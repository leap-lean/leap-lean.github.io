      (hTors₀ : ∀ (s : ℕ) (w : H₀ s), (ℓ ^ s) • w = 0)
      (L₀ : AddSubgroup (∀ s : ℕ, H₀ s))
      (hMemL₀ : ∀ w : ∀ s : ℕ, H₀ s, w ∈ L₀ ↔ ∀ s : ℕ, π₀ s (w (s + 1)) = w s)
      (u₀ : Fin N → ↥L₀)
      (hIndep₀ : ∀ (s : ℕ) (c : Fin N → ZMod (ℓ ^ s)),
        ∑ i : Fin N, (c i).val • (u₀ i).1 s = 0 → c = 0)
      (hSpanL₀ : ∀ w₀ : ↥L₀,
