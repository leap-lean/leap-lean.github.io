    exact hPart1 (C_sec U) (fun n => oneSec n U) (mul_add U) (fun θ h => mapMono_add U θ h)
      (fun n x y => hmul_comm n U x y)
      (fun n x => hone_mul n U x)
      (fun r h x => by
        change ((mapSheafMono id h).hom.app (Opposite.op U)).hom x = x
        rw [hmap_id r h]; rfl)
      (fun θ₁ θ₂ h₁ h₂ h₁₂ x => by
        change ((mapSheafMono (θ₂ ∘ θ₁) h₁₂).hom.app (Opposite.op U)).hom x = _
        rw [hmap_comp θ₁ θ₂ h₁ h₂ h₁₂]; rfl)
      (fun θ h => (hmono_alg θ h U).1)
      (fun θ h x y => (hmono_alg θ h U).2 x y)
  let p := 2 * m + 1
  let frontFace (q k : ℕ) : Fin (k + 1) → Fin (q + k + 1) := fun i => ⟨i.1, by omega⟩
  let backFace (q k : ℕ) : Fin (q + 1) → Fin (q + k + 1) := fun j => ⟨k + j.1, by omega⟩
  have hfront_sm : ∀ q k : ℕ, StrictMono (frontFace q k) := fun _ _ _ _ h => h
  have hback_sm : ∀ q k : ℕ, StrictMono (backFace q k) :=
    fun _ k _ _ h => Nat.add_lt_add_left h k
  let uLoc : (oneR ⟶ A p) → ∀ U : S.Etale, C_sec U p :=
    fun u U => ((A p).obj.map (hT_S.from U).op).hom ((u.hom.app (Opposite.op T_S)).hom e₀)
  have huLoc_TS : ∀ u : oneR ⟶ A p, uLoc u T_S = (u.hom.app (Opposite.op T_S)).hom e₀ := by
    intro u
    have hid : hT_S.from T_S = 𝟙 T_S := hT_S.hom_ext _ _
    dsimp only [uLoc]
    rw [hid, op_id, (A p).obj.map_id]
    rfl
  have huLoc_res : ∀ (u : oneR ⟶ A p) {U₁ U₂ : S.Etale} (f : U₁ ⟶ U₂),
      ((A p).obj.map f.op).hom (uLoc u U₂) = uLoc u U₁ := by
    intro u U₁ U₂ f
    have hterm : f ≫ hT_S.from U₂ = hT_S.from U₁ := hT_S.hom_ext _ _
    dsimp only [uLoc]
    rw [← hterm, op_comp, (A p).obj.map_comp]
    rfl
  have huLoc_cocycle : ∀ (u : oneR ⟶ A p), u ≫ d p = 0 →
      ∀ U : S.Etale, ((d p).hom.app (Opposite.op U)).hom (uLoc u U) = 0 := by
    intro u hu U
    have hnat := congrArg (fun h => h.hom ((u.hom.app (Opposite.op T_S)).hom e₀))
      ((d p).hom.naturality (hT_S.from U).op)
    dsimp only [uLoc]
    change (((A p).obj.map (hT_S.from U).op ≫
        (d p).hom.app (Opposite.op U)).hom) ((u.hom.app (Opposite.op T_S)).hom e₀) = 0
    rw [hnat]
    have hu0 : ((u ≫ d p).hom.app (Opposite.op T_S)).hom e₀ = 0 := by
      rw [hu]; rfl
    change ((A (p + 1)).obj.map (hT_S.from U).op).hom
        (((u ≫ d p).hom.app (Opposite.op T_S)).hom e₀) = 0
    rw [hu0, map_zero]
  let R_lad : ∀ (u : oneR ⟶ A p), u ≫ d p = 0 → ∀ k : ℕ, A k ⟶ A (p + k) :=
    fun u _ k =>
      { hom :=
          { app := fun opU => ModuleCat.ofHom
              { toFun := fun w =>
                  mulSec (p + k) opU.unop
                    (((mapSheafMono (frontFace p k) (hfront_sm p k)).hom.app opU).hom w)
                    (((mapSheafMono (backFace p k) (hback_sm p k)).hom.app opU).hom
                      (uLoc u opU.unop))
                map_add' := fun w₁ w₂ => by
                  rw [map_add, LinearMap.map_add₂]
                map_smul' := fun r w => by
                  dsimp only [RingHom.id_apply]
                  rw [map_smul, LinearMap.map_smul₂] }
            naturality := fun {opU₂ opU₁} f => by
              apply ModuleCat.hom_ext; ext w
              let f_et : opU₁.unop ⟶ opU₂.unop := f.unop
              have hnf :
                  (((mapSheafMono (frontFace p k) (hfront_sm p k)).hom.app opU₁).hom
                    (((A k).obj.map f_et.op).hom w)) =
                  (((A (p + k)).obj.map f_et.op).hom
                    (((mapSheafMono (frontFace p k) (hfront_sm p k)).hom.app opU₂).hom w)) :=
                congrArg (fun h => h.hom w)
                  ((mapSheafMono (frontFace p k) (hfront_sm p k)).hom.naturality f_et.op)
              have hnb :
                  (((mapSheafMono (backFace p k) (hback_sm p k)).hom.app opU₁).hom
                    (((A p).obj.map f_et.op).hom (uLoc u opU₂.unop))) =
                  (((A (p + k)).obj.map f_et.op).hom
                    (((mapSheafMono (backFace p k) (hback_sm p k)).hom.app opU₂).hom
                      (uLoc u opU₂.unop))) :=
                congrArg (fun h => h.hom (uLoc u opU₂.unop))
                  ((mapSheafMono (backFace p k) (hback_sm p k)).hom.naturality f_et.op)
              change mulSec (p + k) opU₁.unop
                  (((mapSheafMono (frontFace p k) (hfront_sm p k)).hom.app opU₁).hom
                    (((A k).obj.map f_et.op).hom w))
                  (((mapSheafMono (backFace p k) (hback_sm p k)).hom.app opU₁).hom
                    (uLoc u opU₁.unop)) =
                ((A (p + k)).obj.map f_et.op).hom
                  (mulSec (p + k) opU₂.unop
                    (((mapSheafMono (frontFace p k) (hfront_sm p k)).hom.app opU₂).hom w)
                    (((mapSheafMono (backFace p k) (hback_sm p k)).hom.app opU₂).hom
                      (uLoc u opU₂.unop)))
              rw [hnf, ← huLoc_res u f_et, hnb, (hres_alg (p + k) f_et).2] } }
  exact hPart2 oneR A ε d hMono_ε hEx₀ hEx hAcyc m c hc R_lad
    (fun u hu => by
      apply honeR_hom_ext
      change ((R_lad u hu 0).hom.app (Opposite.op T_S)).hom
          ((ε.hom.app (Opposite.op T_S)).hom e₀) = (u.hom.app (Opposite.op T_S)).hom e₀
      rw [hε_unit, ← huLoc_TS u]
      exact (hSecPkg T_S).1 p (uLoc u T_S))
    (fun u hu k => by
      apply Sheaf.hom_ext; ext opU : 2; apply ModuleCat.hom_ext; ext w
      let U := opU.unop
      have hcoc := (hd_app_eq U p (uLoc u U)).symm.trans (huLoc_cocycle u hu U)
      have hleib := (hSecPkg U).2.1 p k (uLoc u U) hcoc w
      change ((R_lad u hu (k + 1)).hom.app (Opposite.op U)).hom
          (((d k).hom.app (Opposite.op U)).hom w) =
        ((d (p + k)).hom.app (Opposite.op U)).hom
          (((R_lad u hu k).hom.app (Opposite.op U)).hom w)
      rw [hd_app_eq U (p + k), hd_app_eq U k]
      exact hleib.symm)
    (fun u hu v hv => by
      have hcoc_u := (hd_app_eq T_S p (uLoc u T_S)).symm.trans (huLoc_cocycle u hu T_S)
      have hcoc_v := (hd_app_eq T_S p (uLoc v T_S)).symm.trans (huLoc_cocycle v hv T_S)
      obtain ⟨h_sec, hh_sec⟩ := (hSecPkg T_S).2.2 m (uLoc u T_S) (uLoc v T_S) hcoc_u hcoc_v
      refine ⟨mkHomFromOneR h_sec, ?_⟩
      apply honeR_hom_ext
      change ((R_lad u hu p).hom.app (Opposite.op T_S)).hom
          ((v.hom.app (Opposite.op T_S)).hom e₀) +
        ((R_lad v hv p).hom.app (Opposite.op T_S)).hom
          ((u.hom.app (Opposite.op T_S)).hom e₀) =
        ((d ((2 * m + 1) + 2 * m)).hom.app (Opposite.op T_S)).hom
          (((mkHomFromOneR h_sec).hom.app (Opposite.op T_S)).hom e₀)
      rw [hmkHom_eval h_sec, ← huLoc_TS v, ← huLoc_TS u, hd_app_eq T_S ((2 * m + 1) + 2 * m)]
      exact hh_sec)
    a b

theorem weil_mid_dev_closed_abstract_torsion_lattice_and_aut_matrix (ℓ e N : ℕ) [Fact (Nat.Prime ℓ)]
    (H : ℕ → Type u) [∀ s : ℕ, AddCommGroup (H s)]
    (π : ∀ s : ℕ, H (s + 1) →+ H s)
    (hTors : ∀ (s : ℕ) (w : H s), (ℓ ^ s) • w = 0)
    (u : Fin N → ∀ s : ℕ, H s)
    (hu : ∀ (i : Fin N) (s : ℕ), π s (u i (s + 1)) = u i s)
    (hIndep : ∀ (s : ℕ) (c : Fin N → ZMod (ℓ ^ s)),
      ∑ i : Fin N, (c i).val • u i s = 0 → c = 0)
    (hSpanH : ∀ (s : ℕ) (x : H s),
      ∃ c : Fin N → ZMod (ℓ ^ s), (ℓ ^ e) • x = ∑ i : Fin N, (c i).val • u i s)
    (hSpanL : ∀ (w : ∀ s : ℕ, H s),
      (∀ s : ℕ, π s (w (s + 1)) = w s) →
      ∃ c : Fin N → PadicInt ℓ,
        ∀ s : ℕ, (ℓ ^ e) • w s = ∑ i : Fin N, (PadicInt.toZModPow s (c i)).val • u i s)
    (hKerKill : ∀ (r : ℕ) (w : ∀ s : ℕ, H s),
      (∀ s : ℕ, π s (w (s + 1)) = w s) →
      w (r + 1) = 0 → (ℓ ^ e) • w ((r + 1) + e) = 0) :
    ∃ (α_lat : ∀ r : ℕ, (Fin N → ZMod (ℓ ^ (r + 1))) →+ H (r + 1))
      (β_lat : ∀ r : ℕ, H (r + 1) →+ (Fin N → ZMod (ℓ ^ (r + 1))))
      (matOfEnd : ∀ (f : ∀ r : ℕ, H (r + 1) →+ H (r + 1)),
        (∀ (r : ℕ) (v : H (r + 2)), π (r + 1) (f (r + 1) v) = f r (π (r + 1) v)) →
        Matrix (Fin N) (Fin N) (PadicInt ℓ))
      (matOfAut : ∀ (γ : ∀ r : ℕ, (AddMonoid.End (H (r + 1)))ˣ),
        (∀ (r : ℕ) (v : H (r + 2)),
          π (r + 1) ((γ (r + 1)).val v) = (γ r).val (π (r + 1) v)) →
        (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ),
      (∀ r : ℕ,
        (β_lat r).comp (α_lat r) = (ℓ ^ (3 * e)) • AddMonoidHom.id _ ∧
        (α_lat r).comp (β_lat r) = (ℓ ^ (3 * e)) • AddMonoidHom.id _) ∧
      ((∀ (r : ℕ) (v : Fin N → ZMod (ℓ ^ (r + 2))),
        π (r + 1) (α_lat (r + 1) v) =
          α_lat r (fun i =>
            ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1))) (v i))) ∧
        (∀ (r : ℕ) (w : H (r + 2)) (i : Fin N),
          β_lat r (π (r + 1) w) i =
            ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
              (β_lat (r + 1) w i))) ∧
      (∀ γ hγ, (matOfAut γ hγ).val = matOfEnd (fun r => (γ r).val) hγ) ∧
      (∀ f₁ f₂ hf₁ hf₂, (∀ r v, f₁ r v = f₂ r v) → matOfEnd f₁ hf₁ = matOfEnd f₂ hf₂) ∧
      (∀ f hf (j : Fin N) (r : ℕ),
        (ℓ ^ e) • f r (u j (r + 1)) =
          (ℓ ^ e) • ∑ i : Fin N,
            (PadicInt.toZModPow (r + 1) (matOfEnd f hf i j)).val • u i (r + 1)) ∧
      ((∀ h1, matOfAut 1 h1 = 1) ∧
        (∀ γ₁ γ₂ h₁ h₂ h₁₂, matOfAut (γ₁ * γ₂) h₁₂ = matOfAut γ₁ h₁ * matOfAut γ₂ h₂) ∧
        (∀ γ₁ γ₂ h₁ h₂ (r : ℕ), γ₁ r = γ₂ r →
          ((matOfAut γ₁ h₁).val).map (PadicInt.toZModPow (r + 1)) =
            ((matOfAut γ₂ h₂).val).map (PadicInt.toZModPow (r + 1)))) ∧
      (∀ γ hγ (r : ℕ),
        let M_r := ((matOfAut γ hγ).val).map (PadicInt.toZModPow (r + 1))
        (∀ v, α_lat r (M_r.mulVec v) = (γ r).val (α_lat r v)) ∧
        (∀ w, β_lat r ((γ r).val w) = M_r.mulVec (β_lat r w))) :=
by
  classical
  have hPrime_ℓ : Nat.Prime ℓ := Fact.out
  have hNeZero : ∀ s : ℕ, NeZero (ℓ ^ s) := fun s => ⟨pow_ne_zero s hPrime_ℓ.ne_zero⟩
  have hH0 : ∀ w : H 0, w = 0 := fun w => by
    have h := hTors 0 w
    rwa [pow_zero, one_nsmul] at h
  have hValNat : ∀ (s k : ℕ) (x : H s), ((k : ZMod (ℓ ^ s)).val) • x = k • x := by
    intro s k x
    rw [ZMod.val_natCast]
    conv_rhs => rw [← Nat.div_add_mod k (ℓ ^ s), add_nsmul, mul_nsmul, hTors s x,
      nsmul_zero, zero_add]
  have hValZero : ∀ (s : ℕ) (x : H s), (0 : ZMod (ℓ ^ s)).val • x = 0 := by
    intro s x
    rw [ZMod.val_zero, zero_nsmul]
  have hValOne : ∀ (s : ℕ) (x : H s), (1 : ZMod (ℓ ^ s)).val • x = x := by
    intro s x
    simpa using hValNat s 1 x
  have hValAdd : ∀ (s : ℕ) (a b : ZMod (ℓ ^ s)) (x : H s),
      (a + b).val • x = a.val • x + b.val • x := by
    intro s a b x
    have hab : a + b = ((a.val + b.val : ℕ) : ZMod (ℓ ^ s)) := by
      rw [Nat.cast_add, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
    rw [hab, hValNat, add_nsmul]
  have hValMul : ∀ (s : ℕ) (a b : ZMod (ℓ ^ s)) (x : H s),
      (a * b).val • x = a.val • (b.val • x) := by
    intro s a b x
    have hab : a * b = ((a.val * b.val : ℕ) : ZMod (ℓ ^ s)) := by
      rw [Nat.cast_mul, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
    rw [hab, hValNat, mul_nsmul']
  have hValNeg : ∀ (s : ℕ) (a : ZMod (ℓ ^ s)) (x : H s),
      (-a).val • x = -(a.val • x) := by
    intro s a x
    apply eq_neg_of_add_eq_zero_left
    rw [← hValAdd, neg_add_cancel, hValZero]
  have hValSub : ∀ (s : ℕ) (a b : ZMod (ℓ ^ s)) (x : H s),
      (a - b).val • x = a.val • x - b.val • x := by
    intro s a b x
    rw [sub_eq_add_neg, hValAdd, hValNeg, ← sub_eq_add_neg]
  have hValCast : ∀ (s₁ s₂ : ℕ) (h : s₁ ≤ s₂) (a : ZMod (ℓ ^ s₂)) (x : H s₁),
      (ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ s₁)) a).val • x = a.val • x := by
    intro s₁ s₂ h a x
    conv_lhs => rw [← ZMod.natCast_zmod_val a, map_natCast]
    exact hValNat s₁ a.val x
  let R := PadicInt ℓ
  have hℓR_ne : (ℓ : R) ≠ 0 := Nat.cast_ne_zero.mpr hPrime_ℓ.ne_zero
  have hℓPow_ne : ∀ k : ℕ, ((ℓ : R) ^ k) ≠ 0 := fun k => pow_ne_zero k hℓR_ne
  have hPowModSmul : ∀ (s k : ℕ) (d : R) (x : H s),
      (PadicInt.toZModPow s (((ℓ : R) ^ k) * d)).val • x =
        (ℓ ^ k) • ((PadicInt.toZModPow s d).val • x) := by
    intro s k d x
    rw [map_mul, hValMul]
    have hcast : PadicInt.toZModPow s ((ℓ : R) ^ k) = ((ℓ ^ k : ℕ) : ZMod (ℓ ^ s)) := by
      rw [map_pow, map_natCast, Nat.cast_pow]
    rw [hcast, hValNat]
  let IsCoord : (∀ s : ℕ, H s) → (Fin N → R) → Prop := fun w d =>
    ∀ s : ℕ, (ℓ ^ e) • w s =
      ∑ i : Fin N, (PadicInt.toZModPow s (((ℓ : R) ^ e) * d i)).val • u i s
  have hCoord_uniq : ∀ (w : ∀ s : ℕ, H s) (d₁ d₂ : Fin N → R),
      IsCoord w d₁ → IsCoord w d₂ → d₁ = d₂ := by
    intro w d₁ d₂ hd₁ hd₂
    funext i
    apply mul_left_cancel₀ (hℓPow_ne e)
    rw [← PadicInt.ext_of_toZModPow]
    intro s
    have hdiff : ∑ j : Fin N,
        (PadicInt.toZModPow s (((ℓ : R) ^ e) * d₁ j - ((ℓ : R) ^ e) * d₂ j)).val • u j s = 0 := by
      have heq := (hd₁ s).symm.trans (hd₂ s)
      have hsub : ∑ j : Fin N,
          ((PadicInt.toZModPow s (((ℓ : R) ^ e) * d₁ j)).val • u j s -
            (PadicInt.toZModPow s (((ℓ : R) ^ e) * d₂ j)).val • u j s) = 0 := by
        rw [Finset.sum_sub_distrib, heq, sub_self]
      refine (Finset.sum_congr rfl (fun j _ => ?_)).trans hsub
      rw [map_sub, hValSub]
    have hzero := congrFun (hIndep s _ hdiff) i
    simpa only [Pi.zero_apply, map_sub, sub_eq_zero] using hzero
  have hCoord_ex : ∀ (w : ∀ s : ℕ, H s),
      (∀ s : ℕ, π s (w (s + 1)) = w s) → ∃ d : Fin N → R, IsCoord w d := by
    intro w hw
    obtain ⟨c, hc⟩ := hSpanL w hw
    have hc_e : ∑ i : Fin N, (PadicInt.toZModPow e (c i)).val • u i e = 0 := by
      rw [← hc e, hTors e (w e)]
    have hc_ker : ∀ i : Fin N, ∃ d_i : R, c i = ((ℓ : R) ^ e) * d_i := by
      intro i
      have hi : PadicInt.toZModPow e (c i) = 0 := congrFun (hIndep e _ hc_e) i
      have hmem : c i ∈ RingHom.ker (PadicInt.toZModPow e) := hi
      rwa [PadicInt.ker_toZModPow e, Ideal.mem_span_singleton] at hmem
    choose d hd using hc_ker
    refine ⟨d, fun s => ?_⟩
    rw [hc s]
    exact Finset.sum_congr rfl fun i _ => by rw [hd i]
  let coord : ∀ (w : ∀ s : ℕ, H s), (∀ s : ℕ, π s (w (s + 1)) = w s) → (Fin N → R) :=
    fun w hw => Classical.choose (hCoord_ex w hw)
  have hCoord_spec : ∀ (w : ∀ s : ℕ, H s) (hw : ∀ s : ℕ, π s (w (s + 1)) = w s),
      IsCoord w (coord w hw) :=
    fun w hw => Classical.choose_spec (hCoord_ex w hw)
  have hCoord_basis : ∀ j : Fin N, coord (u j) (hu j) = Pi.single j 1 := by
    intro j
    apply hCoord_uniq (u j) _ _ (hCoord_spec (u j) (hu j))
    intro s
    rw [Fintype.sum_eq_single j]
    · simp only [Pi.single_eq_same, mul_one]
      rw [← mul_one ((ℓ : R) ^ e), hPowModSmul, map_one, hValOne]
    · intro i hij
      simp only [Pi.single_eq_of_ne hij, mul_zero, map_zero, hValZero]
  have hCoord_sub : ∀ (w₁ w₂ : ∀ s : ℕ, H s)
      (hw₁ : ∀ s : ℕ, π s (w₁ (s + 1)) = w₁ s)
      (hw₂ : ∀ s : ℕ, π s (w₂ (s + 1)) = w₂ s)
      (hw₁₂ : ∀ s : ℕ, π s ((w₁ - w₂) (s + 1)) = (w₁ - w₂) s),
      coord (w₁ - w₂) hw₁₂ = coord w₁ hw₁ - coord w₂ hw₂ := by
    intro w₁ w₂ hw₁ hw₂ hw₁₂
    apply hCoord_uniq (w₁ - w₂) _ _ (hCoord_spec (w₁ - w₂) hw₁₂)
    intro s
    simp only [Pi.sub_apply, nsmul_sub]
    rw [hCoord_spec w₁ hw₁ s, hCoord_spec w₂ hw₂ s, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [mul_sub, map_sub, hValSub]
  have hCoord_mod_zero : ∀ (r : ℕ) (w : ∀ s : ℕ, H s)
      (hw : ∀ s : ℕ, π s (w (s + 1)) = w s),
      w (r + 1) = 0 → ∀ i : Fin N, PadicInt.toZModPow (r + 1) (coord w hw i) = 0 := by
    intro r w hw hw0 i
    have hkill := hKerKill r w hw hw0
    have hsum0 : ∑ j : Fin N,
        (PadicInt.toZModPow ((r + 1) + e) (((ℓ : R) ^ e) * coord w hw j)).val •
          u j ((r + 1) + e) = 0 := by
      rw [← hCoord_spec w hw ((r + 1) + e), hkill]
    have hmod0 : PadicInt.toZModPow ((r + 1) + e) (((ℓ : R) ^ e) * coord w hw i) = 0 :=
      congrFun (hIndep ((r + 1) + e) _ hsum0) i
    have hmem : ((ℓ : R) ^ e) * coord w hw i ∈ RingHom.ker (PadicInt.toZModPow ((r + 1) + e)) :=
      hmod0
    rw [PadicInt.ker_toZModPow ((r + 1) + e), Ideal.mem_span_singleton] at hmem
    obtain ⟨q_i, hq_i⟩ := hmem
    have hdiv : coord w hw i = ((ℓ : R) ^ (r + 1)) * q_i := by
      apply mul_left_cancel₀ (hℓPow_ne e)
      rw [hq_i, pow_add, mul_comm ((ℓ : R) ^ (r + 1)), mul_assoc]
    have hker : coord w hw i ∈ RingHom.ker (PadicInt.toZModPow (r + 1)) := by
      rw [PadicInt.ker_toZModPow (r + 1), Ideal.mem_span_singleton]
      exact ⟨q_i, hdiv⟩
    exact hker

  let α₀ : ∀ r : ℕ, (Fin N → ZMod (ℓ ^ (r + 1))) →+ H (r + 1) := fun r =>
    { toFun := fun v => ∑ i : Fin N, (v i).val • u i (r + 1)
      map_zero' := by simp
      map_add' := fun v₁ v₂ => by
        simp only [Pi.add_apply, hValAdd, Finset.sum_add_distrib] }
  have hα₀_inj : ∀ r : ℕ, Function.Injective (α₀ r) := by
    intro r v₁ v₂ hv
    have hsub : α₀ r (v₁ - v₂) = 0 := by rw [map_sub, hv, sub_self]
    exact sub_eq_zero.mp (hIndep (r + 1) (v₁ - v₂) hsub)
  let β₀_fun : ∀ r : ℕ, H (r + 1) → (Fin N → ZMod (ℓ ^ (r + 1))) :=
    fun r w => Classical.choose (hSpanH (r + 1) w)
  have hβ₀_fun_spec : ∀ (r : ℕ) (w : H (r + 1)), α₀ r (β₀_fun r w) = (ℓ ^ e) • w :=
    fun r w => (Classical.choose_spec (hSpanH (r + 1) w)).symm
  let β₀ : ∀ r : ℕ, H (r + 1) →+ (Fin N → ZMod (ℓ ^ (r + 1))) := fun r =>
    { toFun := β₀_fun r
      map_zero' := hα₀_inj r (by rw [hβ₀_fun_spec r 0, nsmul_zero, map_zero])
      map_add' := fun w₁ w₂ => hα₀_inj r (by
        rw [hβ₀_fun_spec r (w₁ + w₂), nsmul_add, map_add, hβ₀_fun_spec r w₁, hβ₀_fun_spec r w₂]) }
  have hβ₀_spec : ∀ (r : ℕ) (w : H (r + 1)), α₀ r (β₀ r w) = (ℓ ^ e) • w := hβ₀_fun_spec
  have hβ₀_α₀ : ∀ (r : ℕ) (v : Fin N → ZMod (ℓ ^ (r + 1))), β₀ r (α₀ r v) = (ℓ ^ e) • v := by
    intro r v
    apply hα₀_inj r
    rw [hβ₀_spec r (α₀ r v), map_nsmul]
  have hα₀_trans : ∀ (r : ℕ) (v : Fin N → ZMod (ℓ ^ (r + 2))),
      π (r + 1) (α₀ (r + 1) v) =
        α₀ r (fun i =>
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1))) (v i)) := by
    intro r v
    change π (r + 1) (∑ i : Fin N, (v i).val • u i (r + 2)) = _
    rw [map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_nsmul, hu i (r + 1), ← hValCast (r + 1) (r + 2) (Nat.le_succ (r + 1)) (v i)]
  have hβ₀_trans : ∀ (r : ℕ) (w : H (r + 2)),
      β₀ r (π (r + 1) w) = fun i =>
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
          (β₀ (r + 1) w i) := by
    intro r w
    apply hα₀_inj r
    rw [hβ₀_spec r (π (r + 1) w), ← map_nsmul, ← hβ₀_spec (r + 1) w, hα₀_trans]
  let α_lat : ∀ r : ℕ, (Fin N → ZMod (ℓ ^ (r + 1))) →+ H (r + 1) :=
    fun r => (ℓ ^ e) • α₀ r
  let β_lat : ∀ r : ℕ, H (r + 1) →+ (Fin N → ZMod (ℓ ^ (r + 1))) :=
    fun r => (ℓ ^ e) • β₀ r
  have h3e_eq : e + (e + e) = 3 * e := by omega
  have hβα_lat : ∀ r : ℕ,
      (β_lat r).comp (α_lat r) = (ℓ ^ (3 * e)) • AddMonoidHom.id _ ∧
      (α_lat r).comp (β_lat r) = (ℓ ^ (3 * e)) • AddMonoidHom.id _ := by
    intro r
    constructor
    · apply AddMonoidHom.ext
      intro v
      change (ℓ ^ e) • β₀ r ((ℓ ^ e) • α₀ r v) = (ℓ ^ (3 * e)) • v
      rw [map_nsmul, hβ₀_α₀, ← mul_nsmul, ← mul_nsmul, ← pow_add, ← pow_add, h3e_eq]
    · apply AddMonoidHom.ext
      intro w
      change (ℓ ^ e) • α₀ r ((ℓ ^ e) • β₀ r w) = (ℓ ^ (3 * e)) • w
      rw [map_nsmul, hβ₀_spec, ← mul_nsmul, ← mul_nsmul, ← pow_add, ← pow_add, h3e_eq]
  have hαβ_trans :
      (∀ (r : ℕ) (v : Fin N → ZMod (ℓ ^ (r + 2))),
        π (r + 1) (α_lat (r + 1) v) =
          α_lat r (fun i =>
            ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1))) (v i))) ∧
      (∀ (r : ℕ) (w : H (r + 2)) (i : Fin N),
        β_lat r (π (r + 1) w) i =
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
            (β_lat (r + 1) w i)) := by
    constructor
    · intro r v
      change π (r + 1) ((ℓ ^ e) • α₀ (r + 1) v) = (ℓ ^ e) • α₀ r _
      rw [map_nsmul, hα₀_trans]
    · intro r w i
      change ((ℓ ^ e) • β₀ r (π (r + 1) w)) i =
        ZMod.castHom _ _ (((ℓ ^ e) • β₀ (r + 1) w) i)
      simp only [Pi.smul_apply, hβ₀_trans, map_nsmul]

  let liftSeq : (∀ r : ℕ, H (r + 1) →+ H (r + 1)) → (∀ s : ℕ, H s) → (∀ s : ℕ, H s) :=
    fun f w s => match s with
      | 0 => 0
      | r + 1 => f r (w (r + 1))
  have hLiftSeq_compat : ∀ (f : ∀ r : ℕ, H (r + 1) →+ H (r + 1)),
      (∀ (r : ℕ) (v : H (r + 2)), π (r + 1) (f (r + 1) v) = f r (π (r + 1) v)) →
      ∀ (w : ∀ s : ℕ, H s), (∀ s : ℕ, π s (w (s + 1)) = w s) →
      ∀ s : ℕ, π s (liftSeq f w (s + 1)) = liftSeq f w s := by
    intro f hf w hw s
    cases s with
    | zero => exact hH0 _
    | succ r =>
      change π (r + 1) (f (r + 1) (w (r + 2))) = f r (w (r + 1))
      rw [hf r (w (r + 2)), hw (r + 1)]
  let matOfEnd : ∀ (f : ∀ r : ℕ, H (r + 1) →+ H (r + 1)),
      (∀ (r : ℕ) (v : H (r + 2)), π (r + 1) (f (r + 1) v) = f r (π (r + 1) v)) →
      Matrix (Fin N) (Fin N) R :=
    fun f hf => Matrix.of fun i j =>
      coord (liftSeq f (u j)) (hLiftSeq_compat f hf (u j) (hu j)) i
  have hMatOfEnd_spec_all : ∀ f hf (j : Fin N) (s : ℕ),
      (ℓ ^ e) • liftSeq f (u j) s =
        (ℓ ^ e) • ∑ i : Fin N, (PadicInt.toZModPow s (matOfEnd f hf i j)).val • u i s := by
    intro f hf j s
    rw [hCoord_spec (liftSeq f (u j)) (hLiftSeq_compat f hf (u j) (hu j)) s, Finset.smul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    exact hPowModSmul s e (matOfEnd f hf i j) (u i s)
  have hMatOfEnd_spec : ∀ f hf (j : Fin N) (r : ℕ),
      (ℓ ^ e) • f r (u j (r + 1)) =
        (ℓ ^ e) • ∑ i : Fin N,
          (PadicInt.toZModPow (r + 1) (matOfEnd f hf i j)).val • u i (r + 1) :=
    fun f hf j r => hMatOfEnd_spec_all f hf j (r + 1)
  have hMatOfEnd_id : ∀ hid, matOfEnd (fun r => AddMonoidHom.id (H (r + 1))) hid = 1 := by
    intro hid
    ext i j
    have hseq : ∀ s : ℕ, liftSeq (fun r => AddMonoidHom.id (H (r + 1))) (u j) s = u j s := by
      intro s
      cases s with
      | zero => exact (hH0 (u j 0)).symm
      | succ r => rfl
    change coord (liftSeq (fun r => AddMonoidHom.id (H (r + 1))) (u j))
      (hLiftSeq_compat _ hid (u j) (hu j)) i = (1 : Matrix (Fin N) (Fin N) R) i j
    have heq : coord (liftSeq (fun r => AddMonoidHom.id (H (r + 1))) (u j))
        (hLiftSeq_compat _ hid (u j) (hu j)) = coord (u j) (hu j) :=
      hCoord_uniq (u j) _ _ (fun s => by
        rw [← hseq s]
        exact hCoord_spec (liftSeq (fun r => AddMonoidHom.id (H (r + 1))) (u j))
          (hLiftSeq_compat _ hid (u j) (hu j)) s)
        (hCoord_spec (u j) (hu j))
    rw [heq, hCoord_basis j, Matrix.one_apply, Pi.single_apply, eq_comm]
  have hMatOfEnd_comp : ∀ (f g : ∀ r : ℕ, H (r + 1) →+ H (r + 1)) hf hg hfg,
      matOfEnd (fun r => (f r).comp (g r)) hfg = matOfEnd f hf * matOfEnd g hg := by
    intro f g hf hg hfg
    ext i j
    apply mul_left_cancel₀ (hℓPow_ne (2 * e))
    rw [← PadicInt.ext_of_toZModPow]
    intro s
    have hFG_s : (ℓ ^ e) • ((ℓ ^ e) • liftSeq (fun r => (f r).comp (g r)) (u j) s) =
        ∑ a : Fin N,
          (PadicInt.toZModPow s (((ℓ : R) ^ (2 * e)) *
            matOfEnd (fun r => (f r).comp (g r)) hfg a j)).val • u a s := by
      rw [hCoord_spec (liftSeq (fun r => (f r).comp (g r)) (u j))
        (hLiftSeq_compat (fun r => (f r).comp (g r)) hfg (u j) (hu j)) s, Finset.smul_sum]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [← hPowModSmul s e, ← mul_assoc, ← pow_add, ← Nat.two_mul]
      rfl
    have hStep1 : (ℓ ^ e) • liftSeq (fun r => (f r).comp (g r)) (u j) s =
        (ℓ ^ e) • ∑ k : Fin N,
          (PadicInt.toZModPow s (matOfEnd g hg k j)).val • liftSeq f (u k) s := by
      cases s with
      | zero => exact (hH0 _).trans (hH0 _).symm
      | succ r =>
        change (ℓ ^ e) • f r (g r (u j (r + 1))) = _
        rw [← map_nsmul (f r), hMatOfEnd_spec g hg j r, map_nsmul (f r), map_sum]
        congr 1
        exact Finset.sum_congr rfl fun k _ => map_nsmul (f r) _ _
    have hProd_s : (ℓ ^ e) • ((ℓ ^ e) • liftSeq (fun r => (f r).comp (g r)) (u j) s) =
        ∑ a : Fin N,
          (PadicInt.toZModPow s (((ℓ : R) ^ (2 * e)) *
            (matOfEnd f hf * matOfEnd g hg) a j)).val • u a s := by
      rw [hStep1, Finset.smul_sum, Finset.smul_sum]
      have hInner : ∀ k : Fin N,
          (ℓ ^ e) • ((ℓ ^ e) • ((PadicInt.toZModPow s (matOfEnd g hg k j)).val • liftSeq f (u k) s)) =
          ∑ a : Fin N,
            (PadicInt.toZModPow s (((ℓ : R) ^ (2 * e)) *
              (matOfEnd f hf a k * matOfEnd g hg k j))).val • u a s := by
        intro k
        have hcomm : (ℓ ^ e) • ((ℓ ^ e) •
            ((PadicInt.toZModPow s (matOfEnd g hg k j)).val • liftSeq f (u k) s)) =
            (PadicInt.toZModPow s (matOfEnd g hg k j)).val •
              ((ℓ ^ e) • ((ℓ ^ e) • liftSeq f (u k) s)) := by
          rw [← mul_nsmul, ← mul_nsmul, ← mul_nsmul, ← mul_nsmul]
          congr 1
          ring
        rw [hcomm, hMatOfEnd_spec_all f hf k s, Finset.smul_sum, Finset.smul_sum, Finset.smul_sum]
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [← hPowModSmul s e (matOfEnd f hf a k), ← hPowModSmul s e, ← mul_assoc, ← pow_add,
          ← Nat.two_mul, ← hValMul, ← map_mul]
        congr 3
        ring
      rw [Finset.sum_congr rfl (fun k _ => hInner k), Finset.sum_comm]
      refine Finset.sum_congr rfl fun a _ => ?_
      have hSumVal : ∀ (S : Finset (Fin N)) (φ : Fin N → ZMod (ℓ ^ s)) (x : H s),
          (∑ k ∈ S, φ k).val • x = ∑ k ∈ S, (φ k).val • x := by
        intro S φ x
        induction S using Finset.induction_on with
        | empty => simp
        | @insert b S hb ih => rw [Finset.sum_insert hb, hValAdd, Finset.sum_insert hb, ih]
      rw [Matrix.mul_apply, Finset.mul_sum, map_sum]
      exact (hSumVal Finset.univ _ (u a s)).symm
    have hEqSum := hFG_s.symm.trans hProd_s
    have hSub0 : ∑ a : Fin N,
        (PadicInt.toZModPow s ((((ℓ : R) ^ (2 * e)) *
            matOfEnd (fun r => (f r).comp (g r)) hfg a j) -
          (((ℓ : R) ^ (2 * e)) * (matOfEnd f hf * matOfEnd g hg) a j))).val • u a s = 0 := by
      have h1 : ∑ a : Fin N,
          ((PadicInt.toZModPow s (((ℓ : R) ^ (2 * e)) *
              matOfEnd (fun r => (f r).comp (g r)) hfg a j)).val • u a s -
            (PadicInt.toZModPow s (((ℓ : R) ^ (2 * e)) *
              (matOfEnd f hf * matOfEnd g hg) a j)).val • u a s) = 0 := by
        rw [Finset.sum_sub_distrib, hEqSum, sub_self]
      refine (Finset.sum_congr rfl (fun a _ => ?_)).trans h1
      rw [map_sub, hValSub]
    have hi := congrFun (hIndep s _ hSub0) i
    simpa only [Pi.zero_apply, map_sub, sub_eq_zero] using hi

  have hAut_inv_compat : ∀ (γ : ∀ r : ℕ, (AddMonoid.End (H (r + 1)))ˣ),
      (∀ (r : ℕ) (v : H (r + 2)),
        π (r + 1) ((γ (r + 1)).val v) = (γ r).val (π (r + 1) v)) →
      ∀ (r : ℕ) (v : H (r + 2)),
        π (r + 1) (((γ (r + 1))⁻¹).val v) = ((γ r)⁻¹).val (π (r + 1) v) := by
    intro γ hγ r v
    have h1 : ((γ (r + 1)).val) (((γ (r + 1))⁻¹).val v) = v := by
      change ((γ (r + 1)).val * ((γ (r + 1))⁻¹).val) v = v
      rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
      rfl
    have h2 := congrArg (((γ r)⁻¹).val) (hγ r (((γ (r + 1))⁻¹).val v))
    rw [h1] at h2
    have h3 : ((γ r)⁻¹).val ((γ r).val (π (r + 1) (((γ (r + 1))⁻¹).val v))) =
        π (r + 1) (((γ (r + 1))⁻¹).val v) := by
      change (((γ r)⁻¹).val * (γ r).val) (π (r + 1) (((γ (r + 1))⁻¹).val v)) = _
      rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
      rfl
    exact h3.symm.trans h2.symm

  have hMatOfEnd_congr : ∀ (f₁ f₂ : ∀ r : ℕ, H (r + 1) →+ H (r + 1)) hf₁ hf₂,
      f₁ = f₂ → matOfEnd f₁ hf₁ = matOfEnd f₂ hf₂ := by
    rintro f₁ _ hf₁ _ rfl
    rfl

  let matOfAut : ∀ (γ : ∀ r : ℕ, (AddMonoid.End (H (r + 1)))ˣ),
      (∀ (r : ℕ) (v : H (r + 2)),
        π (r + 1) ((γ (r + 1)).val v) = (γ r).val (π (r + 1) v)) →
      (Matrix (Fin N) (Fin N) R)ˣ := fun γ hγ =>
    let f_γ : ∀ r : ℕ, H (r + 1) →+ H (r + 1) := fun r => (γ r).val
    let g_γ : ∀ r : ℕ, H (r + 1) →+ H (r + 1) := fun r => ((γ r)⁻¹).val
    { val := matOfEnd f_γ hγ
      inv := matOfEnd g_γ (hAut_inv_compat γ hγ)
      val_inv := by
        have hcomp : (fun r => (f_γ r).comp (g_γ r)) =
            (fun r => AddMonoidHom.id (H (r + 1))) := by
          funext r
          change (γ r).val * ((γ r)⁻¹).val = 1
          rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
        have hid : ∀ (r : ℕ) (v : H (r + 2)),
            π (r + 1) ((f_γ (r + 1)).comp (g_γ (r + 1)) v) =
              (f_γ r).comp (g_γ r) (π (r + 1) v) := by
          intro r v
          change π (r + 1) ((γ (r + 1)).val (((γ (r + 1))⁻¹).val v)) =
            (γ r).val (((γ r)⁻¹).val (π (r + 1) v))
          rw [hγ r (((γ (r + 1))⁻¹).val v), hAut_inv_compat γ hγ r v]
        have hid' : ∀ (r : ℕ) (v : H (r + 2)),
            π (r + 1) (AddMonoidHom.id (H (r + 2)) v) =
              AddMonoidHom.id (H (r + 1)) (π (r + 1) v) := fun _ _ => rfl
        rw [← hMatOfEnd_comp f_γ g_γ hγ (hAut_inv_compat γ hγ) hid,
          hMatOfEnd_congr _ _ hid hid' hcomp, hMatOfEnd_id hid']
      inv_val := by
        have hcomp : (fun r => (g_γ r).comp (f_γ r)) =
            (fun r => AddMonoidHom.id (H (r + 1))) := by
          funext r
          change ((γ r)⁻¹).val * (γ r).val = 1
          rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
        have hid : ∀ (r : ℕ) (v : H (r + 2)),
            π (r + 1) ((g_γ (r + 1)).comp (f_γ (r + 1)) v) =
              (g_γ r).comp (f_γ r) (π (r + 1) v) := by
          intro r v
          change π (r + 1) (((γ (r + 1))⁻¹).val ((γ (r + 1)).val v)) =
            ((γ r)⁻¹).val ((γ r).val (π (r + 1) v))
          rw [hAut_inv_compat γ hγ r ((γ (r + 1)).val v), hγ r v]
        have hid' : ∀ (r : ℕ) (v : H (r + 2)),
            π (r + 1) (AddMonoidHom.id (H (r + 2)) v) =
              AddMonoidHom.id (H (r + 1)) (π (r + 1) v) := fun _ _ => rfl
        rw [← hMatOfEnd_comp g_γ f_γ (hAut_inv_compat γ hγ) hγ hid,
          hMatOfEnd_congr _ _ hid hid' hcomp, hMatOfEnd_id hid'] }

  refine ⟨α_lat, β_lat, matOfEnd, matOfAut, hβα_lat, hαβ_trans,
    fun _ _ => rfl,
    fun f₁ f₂ hf₁ hf₂ h => hMatOfEnd_congr f₁ f₂ hf₁ hf₂ (funext fun r => AddMonoidHom.ext (h r)),
    hMatOfEnd_spec, ⟨?_, ?_, ?_⟩, ?_⟩
  · intro h1
    apply Units.ext
    exact hMatOfEnd_id h1
  · intro γ₁ γ₂ h₁ h₂ h₁₂
    apply Units.ext
    exact hMatOfEnd_comp (fun r => (γ₁ r).val) (fun r => (γ₂ r).val) h₁ h₂ h₁₂
  · intro γ₁ γ₂ h₁ h₂ r hγ_eq
    ext i j
    simp only [Matrix.map_apply]
    let w₁ := liftSeq (fun t => (γ₁ t).val) (u j)
    let w₂ := liftSeq (fun t => (γ₂ t).val) (u j)
    have hw₁ : ∀ s : ℕ, π s (w₁ (s + 1)) = w₁ s :=
      hLiftSeq_compat (fun t => (γ₁ t).val) h₁ (u j) (hu j)
    have hw₂ : ∀ s : ℕ, π s (w₂ (s + 1)) = w₂ s :=
      hLiftSeq_compat (fun t => (γ₂ t).val) h₂ (u j) (hu j)
    have hw₁₂ : ∀ s : ℕ, π s ((w₁ - w₂) (s + 1)) = (w₁ - w₂) s := by
      intro s; simp only [Pi.sub_apply, map_sub, hw₁ s, hw₂ s]
    have hat0 : (w₁ - w₂) (r + 1) = 0 := by
      change (γ₁ r).val (u j (r + 1)) - (γ₂ r).val (u j (r + 1)) = 0
      rw [hγ_eq, sub_self]
    have hzero := hCoord_mod_zero r (w₁ - w₂) hw₁₂ hat0 i
    rw [hCoord_sub w₁ w₂ hw₁ hw₂ hw₁₂, Pi.sub_apply, map_sub, sub_eq_zero] at hzero
    exact hzero
  · intro γ hγ r
    let M_r := ((matOfAut γ hγ).val).map (PadicInt.toZModPow (r + 1))
    have hα_inter : ∀ v : Fin N → ZMod (ℓ ^ (r + 1)),
        α_lat r (M_r.mulVec v) = (γ r).val (α_lat r v) := by
      intro v
      have hSumVal : ∀ (S : Finset (Fin N)) (φ : Fin N → ZMod (ℓ ^ (r + 1))) (x : H (r + 1)),
          (∑ k ∈ S, φ k).val • x = ∑ k ∈ S, (φ k).val • x := by
        intro S φ x
        induction S using Finset.induction_on with
        | empty => simp
        | @insert b S hb ih => rw [Finset.sum_insert hb, hValAdd, Finset.sum_insert hb, ih]
      change (ℓ ^ e) • ∑ i : Fin N, (∑ j : Fin N, M_r i j * v j).val • u i (r + 1) =
        (γ r).val ((ℓ ^ e) • ∑ j : Fin N, (v j).val • u j (r + 1))
      have hLHS : (ℓ ^ e) • ∑ i : Fin N, (∑ j : Fin N, M_r i j * v j).val • u i (r + 1) =
          ∑ j : Fin N, (v j).val • ((ℓ ^ e) • ∑ i : Fin N, (M_r i j).val • u i (r + 1)) := by
        rw [Finset.sum_congr rfl (fun i _ => hSumVal Finset.univ _ (u i (r + 1))),
          Finset.sum_comm, Finset.smul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [Finset.smul_sum, Finset.smul_sum, Finset.smul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [mul_comm (M_r i j) (v j), hValMul, ← mul_nsmul, ← mul_nsmul, ← mul_nsmul, ← mul_nsmul]
        congr 1
        ring
      rw [hLHS]
      have hRHS : (γ r).val ((ℓ ^ e) • ∑ j : Fin N, (v j).val • u j (r + 1)) =
          ∑ j : Fin N, (v j).val • ((ℓ ^ e) • (γ r).val (u j (r + 1))) := by
        rw [map_nsmul, map_sum, Finset.smul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_nsmul, ← mul_nsmul, ← mul_nsmul]
        congr 1
        ring
      rw [hRHS]
      refine Finset.sum_congr rfl fun j _ => ?_
      congr 1
      exact (hMatOfEnd_spec (fun t => (γ t).val) hγ j r).symm
    refine ⟨hα_inter, fun w => ?_⟩
    apply hα₀_inj r
    have hmul_nsmul : M_r.mulVec ((ℓ ^ e) • β₀ r w) = (ℓ ^ e) • M_r.mulVec (β₀ r w) :=
      map_nsmul M_r.mulVecLin (ℓ ^ e) (β₀ r w)
    calc α₀ r (β_lat r ((γ r).val w))
        = α₀ r ((ℓ ^ e) • β₀ r ((γ r).val w)) := rfl
      _ = (ℓ ^ e) • α₀ r (β₀ r ((γ r).val w)) := map_nsmul _ _ _
      _ = (ℓ ^ e) • ((ℓ ^ e) • (γ r).val w) := by rw [hβ₀_spec]
      _ = (γ r).val ((ℓ ^ e) • ((ℓ ^ e) • w)) := by rw [map_nsmul, map_nsmul]
      _ = (γ r).val ((ℓ ^ e) • α₀ r (β₀ r w)) := by rw [← hβ₀_spec r w]
      _ = (γ r).val (α_lat r (β₀ r w)) := rfl
      _ = α_lat r (M_r.mulVec (β₀ r w)) := (hα_inter (β₀ r w)).symm
      _ = (ℓ ^ e) • α₀ r (M_r.mulVec (β₀ r w)) := rfl
      _ = α₀ r ((ℓ ^ e) • M_r.mulVec (β₀ r w)) := (map_nsmul _ _ _).symm
      _ = α₀ r (M_r.mulVec (β_lat r w)) := by rw [← hmul_nsmul]; rfl

theorem weil_mid_dev_closed_abstract_skew_pairing_and_similitude_unit (ℓ e N : ℕ) [Fact (Nat.Prime ℓ)]
    (H : ℕ → Type u) [∀ s : ℕ, AddCommGroup (H s)]
    (π : ∀ s : ℕ, H (s + 1) →+ H s)
    (hTors : ∀ (s : ℕ) (w : H s), (ℓ ^ s) • w = 0)
    (u : Fin N → ∀ s : ℕ, H s)
    (hu : ∀ (i : Fin N) (s : ℕ), π s (u i (s + 1)) = u i s)
    (hIndep : ∀ (s : ℕ) (c : Fin N → ZMod (ℓ ^ s)),
      ∑ i : Fin N, (c i).val • u i s = 0 → c = 0)
    (hSpanH : ∀ (s : ℕ) (x : H s),
      ∃ c : Fin N → ZMod (ℓ ^ s), (ℓ ^ e) • x = ∑ i : Fin N, (c i).val • u i s)
    (pair : ∀ s : ℕ, H s →+ H s →+ ZMod (ℓ ^ s))
    (hPair_compat : ∀ (s : ℕ) (a b : H (s + 1)),
      ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ s)) (ZMod (ℓ ^ s)) (pair (s + 1) a b) =
        pair s (π s a) (π s b))
    (hPair_skew : ∀ (s : ℕ) (a b : H s), pair s b a = -pair s a b)
    (hPair_right : ∀ (s : ℕ) (b : H s), (∀ a : H s, pair s a b = 0) → b = 0) :
    ∃ J_V : Matrix (Fin N) (Fin N) (Padic ℓ),
      (J_V.transpose = -J_V ∧ J_V.det ≠ 0) ∧
      ∀ (c_mult : PadicInt ℓ)
        (f : ∀ r : ℕ, H (r + 1) →+ H (r + 1)),
        (∀ (r : ℕ) (v : H (r + 2)), π (r + 1) (f (r + 1) v) = f r (π (r + 1) v)) →
        ∀ A : Matrix (Fin N) (Fin N) (PadicInt ℓ),
          (∀ (j : Fin N) (r : ℕ),
            (ℓ ^ e) • f r (u j (r + 1)) =
              (ℓ ^ e) • ∑ i : Fin N,
                (PadicInt.toZModPow (r + 1) (A i j)).val • u i (r + 1)) →
          (∀ (r : ℕ) (a b : H (r + 1)),
            pair (r + 1) (f r a) (f r b) =
              PadicInt.toZModPow (r + 1) c_mult * pair (r + 1) a b) →
          ((A.map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J_V *
              (A.map (algebraMap (PadicInt ℓ) (Padic ℓ))) =
            (algebraMap (PadicInt ℓ) (Padic ℓ) c_mult) • J_V) ∧
          (IsUnit c_mult → IsUnit A) :=
by
  classical
  have hPrime_ℓ : Nat.Prime ℓ := Fact.out
  have _hNeZero : ∀ s : ℕ, NeZero (ℓ ^ s) := fun s => ⟨pow_ne_zero s hPrime_ℓ.ne_zero⟩
  let R := PadicInt ℓ
  let K := Padic ℓ
  let ι : R →+* K := algebraMap R K
  have hι_inj : Function.Injective ι := IsFractionRing.injective R K
  have hℓR_ne : (ℓ : R) ≠ 0 := Nat.cast_ne_zero.mpr hPrime_ℓ.ne_zero
  have hℓPow_ne : ∀ k : ℕ, ((ℓ : R) ^ k) ≠ 0 := fun k => pow_ne_zero k hℓR_ne

  have hValNat : ∀ (s k : ℕ) (x : H s), ((k : ZMod (ℓ ^ s)).val) • x = k • x := by
    intro s k x
    rw [ZMod.val_natCast]
    conv_rhs => rw [← Nat.div_add_mod k (ℓ ^ s)]
    rw [add_nsmul, mul_comm (ℓ ^ s) (k / (ℓ ^ s)), mul_nsmul', hTors s x, nsmul_zero, zero_add]

  have hValMul : ∀ (s : ℕ) (a b : ZMod (ℓ ^ s)) (x : H s),
      (a * b).val • x = a.val • (b.val • x) := by
    intro s a b x
    have hab : a * b = ((a.val * b.val : ℕ) : ZMod (ℓ ^ s)) := by
      rw [Nat.cast_mul, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
    rw [hab, hValNat, mul_nsmul']

  have hPowModSmul : ∀ (s k : ℕ) (d : R) (x : H s),
      (PadicInt.toZModPow s (((ℓ : R) ^ k) * d)).val • x =
        (ℓ ^ k) • ((PadicInt.toZModPow s d).val • x) := by
    intro s k d x
    rw [map_mul, hValMul]
    have hpow_cast : PadicInt.toZModPow s ((ℓ : R) ^ k) = ((ℓ ^ k : ℕ) : ZMod (ℓ ^ s)) := by
      rw [map_pow, map_natCast, Nat.cast_pow]
    rw [hpow_cast, hValNat]

  have hLiftSeq : ∀ (a : ∀ s : ℕ, ZMod (ℓ ^ s)),
      (∀ s : ℕ, ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ s)) (ZMod (ℓ ^ s)) (a (s + 1)) = a s) →
      ∃ z : R, ∀ s : ℕ, PadicInt.toZModPow s z = a s := by
    intro a ha_step
    have ha_le : ∀ (s₁ s₂ : ℕ) (h : s₁ ≤ s₂),
        ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ s₁)) (a s₂) = a s₁ := by
      intro s₁ s₂ h
      induction h with
      | refl =>
        rw [ZMod.castHom_self, RingHom.id_apply]
      | @step k hk ih =>
        have hcomp := ZMod.castHom_comp (pow_dvd_pow ℓ hk) (pow_dvd_pow ℓ (Nat.le_succ k))
        have hfun := RingHom.congr_fun hcomp (a (k + 1))
        rw [RingHom.comp_apply, ha_step k, ih] at hfun
        exact hfun.symm
    let f_ring : ∀ s : ℕ, Polynomial ℤ →+* ZMod (ℓ ^ s) :=
      fun s => (Polynomial.aeval (R := ℤ) (a s)).toRingHom
    have f_compat : ∀ (k₁ k₂ : ℕ) (hk : k₁ ≤ k₂),
        (ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁))).comp (f_ring k₂) = f_ring k₁ := by
      intro k₁ k₂ hk
      apply Polynomial.ringHom_ext'
      · exact RingHom.ext_int _ _
      · dsimp [f_ring]
        rw [Polynomial.aeval_X, Polynomial.aeval_X]
        exact ha_le k₁ k₂ hk
    refine ⟨PadicInt.lift f_compat Polynomial.X, fun s => ?_⟩
    have hspec := RingHom.congr_fun (PadicInt.lift_spec f_compat s) Polynomial.X
    simpa [f_ring] using hspec

  have hEntryEx : ∀ i j : Fin N,
      ∃ z : R, ∀ s : ℕ, PadicInt.toZModPow s z = pair s (u i s) (u j s) := by
    intro i j
    apply hLiftSeq (fun s => pair s (u i s) (u j s))
    intro s
    rw [hPair_compat s (u i (s + 1)) (u j (s + 1)), hu i s, hu j s]

  let J_R : Matrix (Fin N) (Fin N) R :=
    Matrix.of (fun i j => Classical.choose (hEntryEx i j))
  have hJR_spec : ∀ (i j : Fin N) (s : ℕ),
      PadicInt.toZModPow s (J_R i j) = pair s (u i s) (u j s) :=
    fun i j s => Classical.choose_spec (hEntryEx i j) s

  let J_V : Matrix (Fin N) (Fin N) K := J_R.map ι

  have hJR_skew : J_R.transpose = -J_R := by
    ext i j
    rw [Matrix.transpose_apply, Matrix.neg_apply]
    apply PadicInt.ext_of_toZModPow.mp
    intro s
    rw [map_neg, hJR_spec j i s, hJR_spec i j s, hPair_skew s (u i s) (u j s)]

  have hJV_skew : J_V.transpose = -J_V := by
    ext i j
    have hij : J_R j i = -J_R i j := by
      simpa [Matrix.transpose_apply, Matrix.neg_apply] using
        congrArg (fun M : Matrix (Fin N) (Fin N) R => M i j) hJR_skew
    simpa [J_V, Matrix.transpose_apply, Matrix.map_apply, Matrix.neg_apply] using
      congrArg ι hij

  have hJV_det : J_V.det ≠ 0 := by
    intro hdet0
    have hdetR : J_R.det = 0 := by
      apply hι_inj
      rw [map_zero, RingHom.map_det ι J_R]
      exact hdet0
    obtain ⟨z, hz_ne, hz_mul⟩ := (Matrix.exists_mulVec_eq_zero_iff (M := J_R)).mpr hdetR
    let y : ∀ s : ℕ, H s := fun s => ∑ j : Fin N, (PadicInt.toZModPow s (z j)).val • u j s
    have hPair_uy : ∀ (s : ℕ) (i : Fin N), pair s (u i s) (y s) = 0 := by
      intro s i
      dsimp [y]
      rw [map_sum]
      have hterm : ∀ j : Fin N,
          pair s (u i s) ((PadicInt.toZModPow s (z j)).val • u j s) =
            PadicInt.toZModPow s (J_R i j * z j) := by
        intro j
        rw [map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val, ← hJR_spec i j s, map_mul, mul_comm]
      simp_rw [hterm, ← map_sum]
      have hrow : (∑ j : Fin N, J_R i j * z j) = 0 := congrFun hz_mul i
      rw [hrow, map_zero]
    have hy_kill : ∀ s : ℕ, (ℓ ^ e) • y s = 0 := by
      intro s
      apply hPair_right s ((ℓ ^ e) • y s)
      intro a
      obtain ⟨c_a, hc_a⟩ := hSpanH s a
      have hmove : pair s a ((ℓ ^ e) • y s) = pair s ((ℓ ^ e) • a) (y s) := by
        rw [map_nsmul, (pair s).map_nsmul, AddMonoidHom.nsmul_apply]
      rw [hmove, hc_a, map_sum (pair s), AddMonoidHom.finsetSum_apply]
      apply Finset.sum_eq_zero
      intro i _
      rw [(pair s).map_nsmul, AddMonoidHom.nsmul_apply, hPair_uy s i, nsmul_zero]
    apply hz_ne
    funext j
    rw [Pi.zero_apply]
    apply PadicInt.ext_of_toZModPow.mp
    intro r
    rw [map_zero]
    have hsum_zero :
        ∑ i : Fin N, (PadicInt.toZModPow (e + r) (((ℓ : R) ^ e) * z i)).val • u i (e + r) = 0 := by
      have hk := hy_kill (e + r)
      dsimp [y] at hk
      rw [Finset.smul_sum] at hk
      simp_rw [← hPowModSmul (e + r) e _ (u _ (e + r))] at hk
      exact hk
    have hc0 : (fun i : Fin N => PadicInt.toZModPow (e + r) (((ℓ : R) ^ e) * z i)) = 0 :=
      hIndep (e + r) _ hsum_zero
    have hmod0 : PadicInt.toZModPow (e + r) (((ℓ : R) ^ e) * z j) = 0 := congrFun hc0 j
    have hker : ((ℓ : R) ^ e) * z j ∈ RingHom.ker (PadicInt.toZModPow (p := ℓ) (e + r)) :=
      RingHom.mem_ker.mpr hmod0
    rw [PadicInt.ker_toZModPow, Ideal.mem_span_singleton] at hker
    rcases hker with ⟨q, hq⟩
    have hq' : ((ℓ : R) ^ e) * z j = ((ℓ : R) ^ e) * (((ℓ : R) ^ r) * q) := by
      rw [hq, pow_add, mul_assoc]
    have hzj : z j = ((ℓ : R) ^ r) * q := mul_left_cancel₀ (hℓPow_ne e) hq'
    have hker_r : z j ∈ RingHom.ker (PadicInt.toZModPow (p := ℓ) r) := by
      rw [PadicInt.ker_toZModPow, Ideal.mem_span_singleton]
      exact ⟨q, hzj⟩
    exact RingHom.mem_ker.mp hker_r

  refine ⟨J_V, ⟨hJV_skew, hJV_det⟩, ?_⟩
  intro c_mult f _hf A hA_exp hPair_sim
  have hSim_R : A.transpose * J_R * A = c_mult • J_R := by
    ext i j
    apply mul_left_cancel₀ (hℓPow_ne (2 * e))
    apply PadicInt.ext_of_toZModPow.mp
    intro s
    cases s with
    | zero =>
      have : Subsingleton (ZMod (ℓ ^ 0)) := by rw [pow_zero]; infer_instance
      exact Subsingleton.elim _ _
    | succ r =>
      let P : ZMod (ℓ ^ (r + 1)) :=
        (ℓ ^ e) • ((ℓ ^ e) • pair (r + 1) (f r (u i (r + 1))) (f r (u j (r + 1))))
      have hP_lhs :
          P = PadicInt.toZModPow (r + 1) (((ℓ : R) ^ (2 * e)) * (A.transpose * J_R * A) i j) := by
        dsimp [P]
        have h1 : (ℓ ^ e) • ((ℓ ^ e) • pair (r + 1) (f r (u i (r + 1))) (f r (u j (r + 1)))) =
            pair (r + 1) ((ℓ ^ e) • f r (u i (r + 1))) ((ℓ ^ e) • f r (u j (r + 1))) := by
          rw [map_nsmul, (pair (r + 1)).map_nsmul, AddMonoidHom.nsmul_apply]
        rw [h1, hA_exp i r, hA_exp j r]
        rw [map_nsmul, (pair (r + 1)).map_nsmul, AddMonoidHom.nsmul_apply]
        rw [← mul_nsmul', ← pow_add, ← Nat.two_mul]
        have hinner :
            pair (r + 1)
              (∑ a : Fin N, (PadicInt.toZModPow (r + 1) (A a i)).val • u a (r + 1))
              (∑ b : Fin N, (PadicInt.toZModPow (r + 1) (A b j)).val • u b (r + 1)) =
            PadicInt.toZModPow (r + 1) ((A.transpose * J_R * A) i j) := by
          rw [map_sum (pair (r + 1)), AddMonoidHom.finsetSum_apply]
          have hrow_a : ∀ a : Fin N,
              (pair (r + 1) ((PadicInt.toZModPow (r + 1) (A a i)).val • u a (r + 1)))
                (∑ b : Fin N, (PadicInt.toZModPow (r + 1) (A b j)).val • u b (r + 1)) =
              ∑ b : Fin N,
                PadicInt.toZModPow (r + 1) (A a i * J_R a b * A b j) := by
            intro a
            rw [(pair (r + 1)).map_nsmul, AddMonoidHom.nsmul_apply, map_sum, Finset.smul_sum]
            refine Finset.sum_congr rfl fun b _ => ?_
            rw [map_nsmul, nsmul_eq_mul, nsmul_eq_mul, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val,
              ← hJR_spec a b (r + 1), map_mul, map_mul]
            ring
          simp_rw [hrow_a, ← map_sum]
          congr 1
          rw [Matrix.mul_apply, Finset.sum_comm]
          refine Finset.sum_congr rfl fun b _ => ?_
          rw [Matrix.mul_apply, Finset.sum_mul]
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [Matrix.transpose_apply]
        rw [hinner, nsmul_eq_mul, map_mul, map_pow, map_natCast, Nat.cast_pow]
      have hP_rhs :
          P = PadicInt.toZModPow (r + 1) (((ℓ : R) ^ (2 * e)) * (c_mult • J_R) i j) := by
        dsimp [P]
        rw [hPair_sim r (u i (r + 1)) (u j (r + 1)), ← hJR_spec i j (r + 1),
          ← mul_nsmul', ← pow_add, ← Nat.two_mul, nsmul_eq_mul,
          map_mul, map_mul, map_pow, map_natCast, Nat.cast_pow]
      exact hP_lhs.symm.trans hP_rhs

  have hSim_V :
      (A.map ι).transpose * J_V * (A.map ι) = (ι c_mult) • J_V := by
    have hmap := congrArg (RingHom.mapMatrix ι) hSim_R
    rw [map_mul, map_mul] at hmap
    ext i j
    have hij := congrArg (fun M : Matrix (Fin N) (Fin N) K => M i j) hmap
    simpa [J_V, RingHom.mapMatrix_apply, Matrix.transpose_map, Matrix.smul_apply,
      Matrix.map_apply, smul_eq_mul] using hij

  refine ⟨hSim_V, fun hc_unit => ?_⟩
  have hdet_V := congrArg Matrix.det hSim_V
  rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, Matrix.det_smul,
    Fintype.card_fin] at hdet_V
  have hdet_V' : ((A.map ι).det * (A.map ι).det) * J_V.det = ((ι c_mult) ^ N) * J_V.det := by
    calc
      ((A.map ι).det * (A.map ι).det) * J_V.det =
          (A.map ι).det * J_V.det * (A.map ι).det := by ring
      _ = ((ι c_mult) ^ N) * J_V.det := hdet_V
  have hdet_sq_K : (A.map ι).det * (A.map ι).det = (ι c_mult) ^ N :=
    mul_right_cancel₀ hJV_det hdet_V'
  have hdet_sq_R : A.det * A.det = c_mult ^ N := by
    apply hι_inj
    rw [map_mul, map_pow, RingHom.map_det ι A, RingHom.mapMatrix_apply]
    exact hdet_sq_K
  have hunit_sq : IsUnit (A.det * A.det) := by
    rw [hdet_sq_R]
    exact hc_unit.pow N
  exact (Matrix.isUnit_iff_isUnit_det A).mpr (isUnit_of_mul_isUnit_left hunit_sq)

theorem weil_mid_dev_closed_abstract_ratTensor_basis_and_trace (ℓ e N : ℕ) [Fact (Nat.Prime ℓ)]
    (H : ℕ → Type u) [∀ s : ℕ, AddCommGroup (H s)]
    (π : ∀ s : ℕ, H (s + 1) →+ H s)
    (hTors : ∀ (s : ℕ) (w : H s), (ℓ ^ s) • w = 0)
    (L_sub : AddSubgroup (∀ s : ℕ, H s))
    (hMemL : ∀ w : ∀ s : ℕ, H s, w ∈ L_sub ↔ ∀ s : ℕ, π s (w (s + 1)) = w s)
    (u : Fin N → ↥L_sub)
    (hIndep : ∀ (s : ℕ) (c : Fin N → ZMod (ℓ ^ s)),
      ∑ i : Fin N, (c i).val • (u i).1 s = 0 → c = 0)
    (hSpanL : ∀ w₀ : ↥L_sub,
      ∃ c : Fin N → PadicInt ℓ,
        ∀ s : ℕ, (ℓ ^ e) • w₀.1 s = ∑ i : Fin N, (PadicInt.toZModPow s (c i)).val • (u i).1 s)
    (V : Type u) [AddCommGroup V] [Module (Padic ℓ) V]
    (equiv : TensorProduct ℤ ℚ ↥L_sub ≃+ V)
    (hsmul : ∀ (z : PadicInt ℓ) (x y : ↥L_sub),
      (∀ s : ℕ, y.1 s = (PadicInt.toZModPow s z).val • x.1 s) →
        equiv (TensorProduct.tmul ℤ (1 : ℚ) y) =
          (z : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) :
    ∃ e_V : V ≃ₗ[Padic ℓ] (Fin N → Padic ℓ),
      (∀ (T_V : V →ₗ[Padic ℓ] V)
        (f : ∀ r : ℕ, H (r + 1) →+ H (r + 1)),
        (∀ (r : ℕ) (v : H (r + 2)), π (r + 1) (f (r + 1) v) = f r (π (r + 1) v)) →
        ∀ A : Matrix (Fin N) (Fin N) (PadicInt ℓ),
          (∀ (j : Fin N) (r : ℕ),
            (ℓ ^ e) • f r ((u j).1 (r + 1)) =
              (ℓ ^ e) • ∑ i : Fin N,
                (PadicInt.toZModPow (r + 1) (A i j)).val • (u i).1 (r + 1)) →
          (∀ (x y : ↥L_sub),
            (∀ r : ℕ, y.1 (r + 1) = f r (x.1 (r + 1))) →
              T_V (equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) =
                equiv (TensorProduct.tmul ℤ (1 : ℚ) y)) →
          ∀ x : V,
            e_V (T_V x) = (A.map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec (e_V x)) ∧
      (∀ (H' : ℕ → Type u) [∀ s : ℕ, AddCommGroup (H' s)]
        (π' : ∀ s : ℕ, H' (s + 1) →+ H' s)
        (_hTors' : ∀ (s : ℕ) (w : H' s), (ℓ ^ s) • w = 0)
        (L_sub' : AddSubgroup (∀ s : ℕ, H' s))
        (_hMemL' : ∀ w : ∀ s : ℕ, H' s, w ∈ L_sub' ↔ ∀ s : ℕ, π' s (w (s + 1)) = w s)
        (V' : Type u) [AddCommGroup V'] [Module (Padic ℓ) V']
        (T_V' : V' →ₗ[Padic ℓ] V')
        (f' : ∀ r : ℕ, H' (r + 1) →+ H' (r + 1))
        (equiv' : TensorProduct ℤ ℚ ↥L_sub' ≃+ V'),
        (∀ (z : PadicInt ℓ) (x' y' : ↥L_sub'),
          (∀ s : ℕ, y'.1 s = (PadicInt.toZModPow s z).val • x'.1 s) →
            equiv' (TensorProduct.tmul ℤ (1 : ℚ) y') =
              (z : Padic ℓ) • equiv' (TensorProduct.tmul ℤ (1 : ℚ) x')) →
        (∀ (x' y' : ↥L_sub'),
          (∀ r : ℕ, y'.1 (r + 1) = f' r (x'.1 (r + 1))) →
            T_V' (equiv' (TensorProduct.tmul ℤ (1 : ℚ) x')) =
              equiv' (TensorProduct.tmul ℤ (1 : ℚ) y')) →
        ∀ (f : ∀ r : ℕ, H (r + 1) →+ H (r + 1)),
          (∀ (r : ℕ) (v : H (r + 2)), π (r + 1) (f (r + 1) v) = f r (π (r + 1) v)) →
          ∀ (A : Matrix (Fin N) (Fin N) (PadicInt ℓ)),
            (∀ (j : Fin N) (r : ℕ),
              (ℓ ^ e) • f r ((u j).1 (r + 1)) =
                (ℓ ^ e) • ∑ i : Fin N,
                  (PadicInt.toZModPow (r + 1) (A i j)).val • (u i).1 (r + 1)) →
            ∀ (ψ : ∀ r : ℕ, H (r + 1) ≃+ H' (r + 1)),
              (∀ (r : ℕ) (v : H (r + 2)), π' (r + 1) (ψ (r + 1) v) = ψ r (π (r + 1) v)) →
