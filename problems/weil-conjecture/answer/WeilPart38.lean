  let A_u : Matrix (Fin N) (Fin N) (PadicInt ℓ) :=
    matOfEnd (fun r => M_Zu_mid.frobTorsion (r + 1)) hfrob_compat

  have hFrob_pair : ∀ (r : ℕ) (x y : weilEtaleTorsionH S_u (ℓ ^ (r + 1)) n),
