      exact ⟨H_y, hPb_Hy, (hFieldPullH0 p₁ H_y H_3 hPb_p1).2.mpr hZ_H3⟩

    
    have hLiftToChart : ∀ {K : Type u} [Field K] [IsAlgClosed K]
        (y : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ D_bar.left),
        ∃ (ι_chart : U₀ ⟶ D_bar.left) (_ : AlgebraicGeometry.IsOpenImmersion ι_chart)
          (z_P : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ U₀),
          ι_chart ≫ D_bar.hom = p_A1 ∧ z_P ≫ ι_chart = y := by
      intro K _ _ y
      obtain ⟨ι_chart, hOpen_ι, hι_hom, hx_range⟩ := hCharts (y.base (⊥ : PrimeSpectrum K))
      let _ : AlgebraicGeometry.IsOpenImmersion ι_chart := hOpen_ι
      have hRange_y : Set.range y.base ⊆ Set.range ι_chart.base := by
