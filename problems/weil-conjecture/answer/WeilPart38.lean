        @CategoryTheory.Limits.isZero_cokernel_of_epi _ _ _ _ _ _ hEpi_map _
      exact hZ_cok.of_iso
        (CategoryTheory.Limits.PreservesCokernel.iso P_Y (CategoryTheory.Limits.kernel.ι θ))

    have hZ_𝒬_η₀ : CategoryTheory.Limits.IsZero (P_η₀.obj 𝒬_θ) :=
      hCokKerZeroOfMapZero P_η₀ hθ_η₀

    have hZ_𝒬 : CategoryTheory.Limits.IsZero 𝒬_θ := by
      refine weil_etale_geometric_point_stalk_conservativity D_bar.left 𝒬_θ fun K _ _ y => ?_
      obtain ⟨ι_chart, hOpen_ι, z_P, hι_hom, hz_y⟩ := hLiftToChart y
      let _ : AlgebraicGeometry.IsOpenImmersion ι_chart := hOpen_ι
      rcases hDichot_geom K z_P with hz_gen | ⟨a, π_Kk, rfl⟩
      · apply hGenZeroTransfer 𝒬_θ hZ_𝒬_η₀ y
        rw [← hz_y]
        change ι_chart.base (z_P.base (⊥ : PrimeSpectrum K)) = genericPoint ↥D_bar.left
        rw [hz_gen, hChartGen ι_chart]
      · obtain ⟨τ_a, hIso_τ, hτ_p, hs0_τ⟩ := hTrans_A1 a
        let _ : CategoryTheory.IsIso τ_a := hIso_τ
        let ι'_a : U₀ ⟶ D_bar.left := τ_a ≫ ι_chart
        have _ : AlgebraicGeometry.IsOpenImmersion ι'_a := by dsimp [ι'_a]; infer_instance
        have hι'_hom : ι'_a ≫ D_bar.hom = p_A1 := by
          dsimp [ι'_a]; rw [CategoryTheory.Category.assoc, hι_hom, hτ_p]
        let g_a : S_R ⟶ D_bar.left := g_Rbar ≫ ι'_a
        let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g_a :=
          CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
        let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
