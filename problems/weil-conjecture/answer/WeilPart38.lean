    have hIso_app : ∀ V : (Y.Etale)ᵒᵖ, IsIso (res_lc.hom.app V) := fun V =>
      (ConcreteCategory.isIso_iff_bijective (res_lc.hom.app V)).mpr ⟨hResInj V.unop, hResSurj V.unop⟩
