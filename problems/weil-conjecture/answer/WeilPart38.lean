      rw [← P₀.ker_eq_ker_aeval_val, P₀.span_range_relation_eq_ker]
    have hR₀_map_inf : ∀ s : Fin r,
        MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₀)) (R₀ s) = R_inf s := by
      intro s
      dsimp [R₀]
      rw [MvPolynomial.map_map, ← CommRingCat.hom_comp, c_B.w θ, hR_tilde s]
    have hJ₀_le : J₀ ≤ RingHom.ker (φ_inf.comp (MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₀)))) := by
      rw [Ideal.span_le]
      intro x hx
      obtain ⟨s, rfl⟩ := hx
      rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, hR₀_map_inf s]
      exact RingHom.mem_ker.mp (hker_φ.symm ▸ Ideal.subset_span ⟨s, rfl⟩)
    have hJ₀_zero : ∀ a ∈ J₀,
        (φ_inf.comp (MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₀)))) a = 0 :=
      fun a ha => hJ₀_le ha
    let g₀_bar : Q₀ →+* ↑E_inf :=
      Ideal.Quotient.lift J₀ (φ_inf.comp (MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₀)))) hJ₀_zero
    let g₀ : CommRingCat.of Q₀ ⟶ E_inf := CommRingCat.ofHom g₀_bar
    have hw_push : c_B.ι.app i₀ ≫ f_E = f₀ ≫ g₀ := by
      apply CommRingCat.Hom.ext
      apply RingHom.ext
      intro b
      change (CommRingCat.Hom.hom f_E) ((CommRingCat.Hom.hom (c_B.ι.app i₀)) b) =
        g₀_bar (Ideal.Quotient.mk J₀ (MvPolynomial.C b))
      dsimp [g₀_bar]
      rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_C]
      dsimp [φ_inf]
      rw [MvPolynomial.aeval_C, halg_fE]
    let ψ_of : ∀ (s : CategoryTheory.Limits.PushoutCocone (c_B.ι.app i₀) f₀),
        MvPolynomial (Fin n) ↑c_B.pt →+* ↑s.pt :=
      fun s => MvPolynomial.eval₂Hom (CommRingCat.Hom.hom s.inl)
        (fun idx => (CommRingCat.Hom.hom s.inr) (Ideal.Quotient.mk J₀ (MvPolynomial.X idx)))
    have hψ_comp : ∀ (s : CategoryTheory.Limits.PushoutCocone (c_B.ι.app i₀) f₀),
        (ψ_of s).comp (MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₀))) =
          (CommRingCat.Hom.hom s.inr).comp (Ideal.Quotient.mk J₀) := by
      intro s
      apply MvPolynomial.ringHom_ext
      · intro b
        simp only [RingHom.comp_apply, MvPolynomial.map_C, ψ_of, MvPolynomial.eval₂Hom_C]
        exact congrArg (fun fn => (CommRingCat.Hom.hom fn) b) s.condition
      · intro idx
        simp only [RingHom.comp_apply, MvPolynomial.map_X, ψ_of, MvPolynomial.eval₂Hom_X']
    have hker_le_ψ : ∀ (s : CategoryTheory.Limits.PushoutCocone (c_B.ι.app i₀) f₀),
        RingHom.ker φ_inf ≤ RingHom.ker (ψ_of s) := by
      intro s
      rw [hker_φ, Ideal.span_le]
      intro x hx
      obtain ⟨t, rfl⟩ := hx
      rw [SetLike.mem_coe, RingHom.mem_ker, ← hR₀_map_inf t]
      have h1 := congrArg (fun h => h (R₀ t)) (hψ_comp s)
      simp only [RingHom.comp_apply] at h1
      have ht_mem : R₀ t ∈ J₀ := Ideal.subset_span ⟨t, rfl⟩
      rw [h1, Ideal.Quotient.eq_zero_iff_mem.mpr ht_mem, map_zero]
    let desc_hom : ∀ (s : CategoryTheory.Limits.PushoutCocone (c_B.ι.app i₀) f₀),
        ↑E_inf →+* ↑s.pt :=
      fun s => φ_inf.liftOfRightInverse P₀.σ' hφ_ri ⟨ψ_of s, hker_le_ψ s⟩
    let desc_fn : ∀ (s : CategoryTheory.Limits.PushoutCocone (c_B.ι.app i₀) f₀),
        E_inf ⟶ s.pt :=
      fun s => CommRingCat.ofHom (desc_hom s)
    refine ⟨i₀, n, J₀, g₀, hf₀_et, ?_⟩
    refine CategoryTheory.IsPushout.of_isColimit
      (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hw_push desc_fn ?_ ?_ ?_)
    · intro s
      apply CommRingCat.Hom.ext
      apply RingHom.ext
      intro a
      change desc_hom s ((CommRingCat.Hom.hom f_E) a) = (CommRingCat.Hom.hom s.inl) a
      have hfE_a : (CommRingCat.Hom.hom f_E) a = φ_inf (MvPolynomial.C a) := by
        dsimp [φ_inf]
        rw [MvPolynomial.aeval_C, halg_fE]
      rw [hfE_a]
      dsimp [desc_hom]
      rw [RingHom.liftOfRightInverse_comp_apply]
      exact MvPolynomial.eval₂Hom_C _ _ a
    · intro s
      apply CommRingCat.Hom.ext
      apply RingHom.ext
      intro q
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
      change desc_hom s (g₀_bar (Ideal.Quotient.mk J₀ p)) =
        (CommRingCat.Hom.hom s.inr) (Ideal.Quotient.mk J₀ p)
      have hg₀_p : g₀_bar (Ideal.Quotient.mk J₀ p) =
          φ_inf (MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₀)) p) := by
        dsimp [g₀_bar]
        rw [Ideal.Quotient.lift_mk, RingHom.comp_apply]
      rw [hg₀_p]
      dsimp [desc_hom]
      rw [RingHom.liftOfRightInverse_comp_apply]
      exact congrArg (fun h => h p) (hψ_comp s)
    · intro s m hm_inl hm_inr
      have hm_comp : (CommRingCat.Hom.hom m).comp φ_inf = ψ_of s := by
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply, ψ_of, MvPolynomial.eval₂Hom_C]
          dsimp [φ_inf]
          rw [MvPolynomial.aeval_C, halg_fE]
          exact congrArg (fun fn => (CommRingCat.Hom.hom fn) a) hm_inl
        · intro idx
          simp only [RingHom.comp_apply, ψ_of, MvPolynomial.eval₂Hom_X']
          have hXk : φ_inf (MvPolynomial.X idx) =
              g₀_bar (Ideal.Quotient.mk J₀ (MvPolynomial.X idx)) := by
            dsimp [g₀_bar]
            rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_X]
          rw [hXk]
          exact congrArg (fun fn => (CommRingCat.Hom.hom fn)
            (Ideal.Quotient.mk J₀ (MvPolynomial.X idx))) hm_inr
      apply CommRingCat.Hom.ext
      apply RingHom.ext
      intro e_el
      change (CommRingCat.Hom.hom m) e_el = desc_hom s e_el
      have he_el := hφ_ri e_el
      conv_lhs => rw [← he_el]
      conv_rhs => rw [← he_el]
      have hlhs : (CommRingCat.Hom.hom m) (φ_inf (P₀.σ' e_el)) = (ψ_of s) (P₀.σ' e_el) :=
        congrArg (fun h => h (P₀.σ' e_el)) hm_comp
      rw [hlhs]
      dsimp [desc_hom]
      rw [RingHom.liftOfRightInverse_comp_apply]

  have hPushMvPoly : ∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B),
      CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.map φ : MvPolynomial (Fin d) A →+* MvPolynomial (Fin d) B)))
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.C : B →+* MvPolynomial (Fin d) B)))
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.C : A →+* MvPolynomial (Fin d) A)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) := by
    intro A B _ _ φ
    let f_mv : CommRingCat.of A ⟶ CommRingCat.of (MvPolynomial (Fin d) A) :=
      CommRingCat.ofHom MvPolynomial.C
    let g_mv : CommRingCat.of A ⟶ CommRingCat.of B := CommRingCat.ofHom φ
    let inl_mv : CommRingCat.of (MvPolynomial (Fin d) A) ⟶
        CommRingCat.of (MvPolynomial (Fin d) B) :=
      CommRingCat.ofHom (MvPolynomial.map φ)
    let inr_mv : CommRingCat.of B ⟶ CommRingCat.of (MvPolynomial (Fin d) B) :=
      CommRingCat.ofHom MvPolynomial.C
    have hcomm : f_mv ≫ inl_mv = g_mv ≫ inr_mv := by
      apply CommRingCat.hom_ext; apply RingHom.ext; intro a; exact MvPolynomial.map_C φ a
    have hColim : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk inl_mv inr_mv hcomm) := by
      refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm
        (fun s => CommRingCat.ofHom
          (MvPolynomial.eval₂Hom s.inr.hom (fun m => s.inl.hom (MvPolynomial.X m))))
        ?_ ?_ ?_
      · intro s; apply CommRingCat.hom_ext; apply MvPolynomial.ringHom_ext
        · intro a
          change MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.map φ (MvPolynomial.C a)) =
            s.inl.hom (MvPolynomial.C a)
          rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
          exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom s.condition) a).symm
        · intro m
          change MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.map φ (MvPolynomial.X m)) =
            s.inl.hom (MvPolynomial.X m)
          rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
      · intro s; apply CommRingCat.hom_ext; apply RingHom.ext; intro b
        exact MvPolynomial.eval₂Hom_C s.inr.hom (fun m => s.inl.hom (MvPolynomial.X m)) b
      · intro s m hm_l hm_r; apply CommRingCat.hom_ext; apply MvPolynomial.ringHom_ext
        · intro b
          change m.hom (MvPolynomial.C b) = MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.C b)
          rw [MvPolynomial.eval₂Hom_C]
          exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_r) b
        · intro idx
          change m.hom (MvPolynomial.X idx) = MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.X idx)
          rw [MvPolynomial.eval₂Hom_X']
          have hX := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_l) (MvPolynomial.X idx)
          change m.hom (MvPolynomial.map φ (MvPolynomial.X idx)) = s.inl.hom (MvPolynomial.X idx) at hX
          rwa [MvPolynomial.map_X] at hX
    exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout f_mv g_mv inl_mv inr_mv
      (CategoryTheory.IsPushout.of_isColimit hColim)

  have hPushLocAway : ∀ {A B S_A S_B : Type u} [CommRing A] [CommRing B] [CommRing S_A] [CommRing S_B]
      [Algebra A S_A] [Algebra B S_B]
      (φ : A →+* B) (a : A) (b : B)
      [IsLocalization.Away a S_A] [IsLocalization.Away b S_B],
      (∀ {R : Type u} [CommRing R] (ρ : B →+* R), IsUnit (ρ (φ a)) ↔ IsUnit (ρ b)) →
      ∃ ψ : S_A →+* S_B,
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B S_B)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A S_A)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) := by
    intro A B S_A S_B _ _ _ _ _ _ φ a b _ _ hUnitIff
    let i_A : A →+* S_A := algebraMap A S_A
    let i_B : B →+* S_B := algebraMap B S_B
    have hu_B : IsUnit ((i_B.comp φ) a) :=
      (hUnitIff i_B).mpr (IsLocalization.Away.algebraMap_isUnit b)
    let ψ : S_A →+* S_B := IsLocalization.Away.lift a (g := i_B.comp φ) hu_B
    have hψ_comp : ψ.comp i_A = i_B.comp φ := by
      ext x; exact IsLocalization.Away.lift_eq a hu_B x
    let f_c : CommRingCat.of A ⟶ CommRingCat.of S_A := CommRingCat.ofHom i_A
    let g_c : CommRingCat.of A ⟶ CommRingCat.of B := CommRingCat.ofHom φ
    let inl_c : CommRingCat.of S_A ⟶ CommRingCat.of S_B := CommRingCat.ofHom ψ
    let inr_c : CommRingCat.of B ⟶ CommRingCat.of S_B := CommRingCat.ofHom i_B
    have hcomm : f_c ≫ inl_c = g_c ≫ inr_c := CommRingCat.hom_ext hψ_comp
    have hu_b_of : ∀ s : CategoryTheory.Limits.PushoutCocone f_c g_c, IsUnit (s.inr.hom b) := by
      intro s
      have hcond : s.inl.hom.comp i_A = s.inr.hom.comp φ := congrArg CommRingCat.Hom.hom s.condition
      have h1 : s.inl.hom (i_A a) = s.inr.hom (φ a) := DFunLike.congr_fun hcond a
      exact (hUnitIff s.inr.hom).mp (h1 ▸ (IsLocalization.Away.algebraMap_isUnit (S := S_A) a).map s.inl.hom)
    have hColim : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk inl_c inr_c hcomm) := by
      refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm
        (fun s => CommRingCat.ofHom (IsLocalization.Away.lift b (g := s.inr.hom) (hu_b_of s)))
        ?_ ?_ ?_
      · intro s
        apply CommRingCat.hom_ext
        apply IsLocalization.ringHom_ext (Submonoid.powers a)
        ext x
        have h1 : ψ (i_A x) = i_B (φ x) := DFunLike.congr_fun hψ_comp x
        change (IsLocalization.Away.lift b (hu_b_of s)) (ψ (i_A x)) = s.inl.hom (i_A x)
        rw [h1]
        exact (IsLocalization.Away.lift_eq b (hu_b_of s) (φ x)).trans
          (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom s.condition) x).symm
      · intro s
        apply CommRingCat.hom_ext; ext x
        exact IsLocalization.Away.lift_eq b (hu_b_of s) x
      · intro s m _ hm_r
        apply CommRingCat.hom_ext
        apply IsLocalization.ringHom_ext (Submonoid.powers b)
        ext x
        exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_r) x).trans
          (IsLocalization.Away.lift_eq b (hu_b_of s) x).symm
    exact ⟨ψ, AlgebraicGeometry.isPullback_SpecMap_of_isPushout f_c g_c inl_c inr_c
      (CategoryTheory.IsPushout.of_isColimit hColim)⟩

  have hLocFilteredColim : ∀ (𝒥 : Type u) [CategoryTheory.SmallCategory 𝒥] [CategoryTheory.IsFiltered 𝒥]
      (E_d : 𝒥 ⥤ CommRingCat.{u}) (c_d : CategoryTheory.Limits.Cocone E_d),
      CategoryTheory.Limits.IsColimit c_d →
      ∀ (x_lvl : ∀ j : 𝒥, ↑(E_d.obj j)) (x_pt : ↑c_d.pt),
        (∀ {j j' : 𝒥} (φ : j ⟶ j'), (E_d.map φ).hom (x_lvl j) = x_lvl j') →
        (∀ j : 𝒥, (c_d.ι.app j).hom (x_lvl j) = x_pt) →
        ∃ (E_l : 𝒥 ⥤ CommRingCat.{u})
          (ι_l : E_d ⟶ E_l)
          (c_l : CategoryTheory.Limits.Cocone E_l)
          (_ : CategoryTheory.Limits.IsColimit c_l)
          (ι_pt : c_d.pt ⟶ c_l.pt),
          (∀ j : 𝒥, c_d.ι.app j ≫ ι_pt = ι_l.app j ≫ c_l.ι.app j) ∧
          (∃ (hAlg_pt : Algebra ↑c_d.pt ↑c_l.pt) (_ : @IsLocalization.Away ↑c_d.pt _ x_pt ↑c_l.pt _ hAlg_pt),
            ι_pt = CommRingCat.ofHom (@algebraMap ↑c_d.pt ↑c_l.pt _ _ hAlg_pt)) ∧
          (∀ j : 𝒥, ∃ (hAlg_j : Algebra ↑(E_d.obj j) ↑(E_l.obj j))
            (_ : @IsLocalization.Away ↑(E_d.obj j) _ (x_lvl j) ↑(E_l.obj j) _ hAlg_j),
            ι_l.app j = CommRingCat.ofHom (@algebraMap ↑(E_d.obj j) ↑(E_l.obj j) _ _ hAlg_j)) := by
    intro 𝒥 _ _ E_d c_d hc_d x_lvl x_pt hx_map hx_pt
    have hMapEx : ∀ {j j' : 𝒥} (φ : j ⟶ j'),
        ∃ g : Localization.Away (x_lvl j) →+* Localization.Away (x_lvl j'),
          ∀ a : ↑(E_d.obj j),
            g (algebraMap ↑(E_d.obj j) (Localization.Away (x_lvl j)) a) =
              algebraMap ↑(E_d.obj j') (Localization.Away (x_lvl j')) ((E_d.map φ).hom a) := by
      intro j j' φ
      have hu : IsUnit (((algebraMap ↑(E_d.obj j') (Localization.Away (x_lvl j'))).comp (E_d.map φ).hom) (x_lvl j)) := by
        change IsUnit (algebraMap ↑(E_d.obj j') (Localization.Away (x_lvl j')) ((E_d.map φ).hom (x_lvl j)))
        rw [hx_map φ]
        exact IsLocalization.Away.algebraMap_isUnit (x_lvl j')
      exact ⟨IsLocalization.Away.lift (x_lvl j) hu, IsLocalization.Away.lift_eq (x_lvl j) hu⟩
    have hLegEx : ∀ (j : 𝒥),
        ∃ g : Localization.Away (x_lvl j) →+* Localization.Away x_pt,
          ∀ a : ↑(E_d.obj j),
            g (algebraMap ↑(E_d.obj j) (Localization.Away (x_lvl j)) a) =
              algebraMap ↑c_d.pt (Localization.Away x_pt) ((c_d.ι.app j).hom a) := by
      intro j
      have hu : IsUnit (((algebraMap ↑c_d.pt (Localization.Away x_pt)).comp (c_d.ι.app j).hom) (x_lvl j)) := by
        change IsUnit (algebraMap ↑c_d.pt (Localization.Away x_pt) ((c_d.ι.app j).hom (x_lvl j)))
        rw [hx_pt j]
        exact IsLocalization.Away.algebraMap_isUnit x_pt
      exact ⟨IsLocalization.Away.lift (x_lvl j) hu, IsLocalization.Away.lift_eq (x_lvl j) hu⟩
    let E_l : 𝒥 ⥤ CommRingCat.{u} :=
      { obj := fun j => CommRingCat.of (Localization.Away (x_lvl j))
        map := fun φ => CommRingCat.ofHom (hMapEx φ).choose
        map_id := fun j => by
          apply CommRingCat.hom_ext
          apply IsLocalization.ringHom_ext (Submonoid.powers (x_lvl j))
          ext x
          change (hMapEx (𝟙 j)).choose (algebraMap _ _ x) = algebraMap _ _ x
          rw [(hMapEx (𝟙 j)).choose_spec x, E_d.map_id]
          rfl
        map_comp := fun {j₁ j₂ j₃} φ₁ φ₂ => by
          apply CommRingCat.hom_ext
          apply IsLocalization.ringHom_ext (Submonoid.powers (x_lvl j₁))
          ext x
          change (hMapEx (φ₁ ≫ φ₂)).choose (algebraMap _ _ x) =
            (hMapEx φ₂).choose ((hMapEx φ₁).choose (algebraMap _ _ x))
          rw [(hMapEx (φ₁ ≫ φ₂)).choose_spec x, (hMapEx φ₁).choose_spec x,
            (hMapEx φ₂).choose_spec ((E_d.map φ₁).hom x), E_d.map_comp]
          rfl }
    let ι_l : E_d ⟶ E_l :=
      { app := fun j => CommRingCat.ofHom (algebraMap ↑(E_d.obj j) (Localization.Away (x_lvl j)))
        naturality := fun j j' φ => by
          apply CommRingCat.hom_ext; ext x
          exact ((hMapEx φ).choose_spec x).symm }
    let pt_l : CommRingCat.{u} := CommRingCat.of (Localization.Away x_pt)
    let ι_pt : c_d.pt ⟶ pt_l := CommRingCat.ofHom (algebraMap ↑c_d.pt (Localization.Away x_pt))
    let c_l : CategoryTheory.Limits.Cocone E_l :=
      { pt := pt_l
        ι :=
          { app := fun j => CommRingCat.ofHom (hLegEx j).choose
            naturality := fun j j' φ => by
              dsimp [E_l]; rw [Category.comp_id]
              apply CommRingCat.hom_ext
              apply IsLocalization.ringHom_ext (Submonoid.powers (x_lvl j))
              ext x
              change (hLegEx j').choose ((hMapEx φ).choose (algebraMap _ _ x)) =
                (hLegEx j).choose (algebraMap _ _ x)
              rw [(hMapEx φ).choose_spec x, (hLegEx j').choose_spec, (hLegEx j).choose_spec]
              exact congrArg (algebraMap ↑c_d.pt (Localization.Away x_pt))
                (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (c_d.w φ)) x) } }
    have hι_comm : ∀ j : 𝒥, c_d.ι.app j ≫ ι_pt = ι_l.app j ≫ c_l.ι.app j := by
      intro j; apply CommRingCat.hom_ext; ext x
      exact ((hLegEx j).choose_spec x).symm
    have hc_l : CategoryTheory.Limits.IsColimit c_l := by
      let j₀_arb : 𝒥 := Classical.choice CategoryTheory.IsFiltered.nonempty
      let toBaseCocone : ∀ s : CategoryTheory.Limits.Cocone E_l, CategoryTheory.Limits.Cocone E_d :=
        fun s =>
          { pt := s.pt
            ι :=
              { app := fun j => ι_l.app j ≫ s.ι.app j
                naturality := fun j j' φ => by
                  dsimp
                  rw [Category.comp_id, ← s.w φ, ← Category.assoc, ι_l.naturality φ, Category.assoc] } }
      have hDescEx : ∀ s : CategoryTheory.Limits.Cocone E_l,
          ∃ g : Localization.Away x_pt →+* ↑s.pt,
            ∀ a : ↑c_d.pt,
              g (algebraMap ↑c_d.pt (Localization.Away x_pt) a) = (hc_d.desc (toBaseCocone s)).hom a := by
        intro s
        let d₀ : c_d.pt ⟶ s.pt := hc_d.desc (toBaseCocone s)
        have hu_x : IsUnit (d₀.hom x_pt) := by
          have hfac0 : c_d.ι.app j₀_arb ≫ d₀ = ι_l.app j₀_arb ≫ s.ι.app j₀_arb :=
            hc_d.fac (toBaseCocone s) j₀_arb
          have hval := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hfac0) (x_lvl j₀_arb)
          change d₀.hom ((c_d.ι.app j₀_arb).hom (x_lvl j₀_arb)) =
            (s.ι.app j₀_arb).hom (algebraMap _ _ (x_lvl j₀_arb)) at hval
          rw [hx_pt j₀_arb] at hval; rw [hval]
          exact (IsLocalization.Away.algebraMap_isUnit (x_lvl j₀_arb)).map (s.ι.app j₀_arb).hom
        exact ⟨IsLocalization.Away.lift x_pt (g := d₀.hom) hu_x,
          IsLocalization.Away.lift_eq x_pt hu_x⟩
      refine
        { desc := fun s => CommRingCat.ofHom (hDescEx s).choose
          fac := fun s j => by
            apply CommRingCat.hom_ext
            apply IsLocalization.ringHom_ext (Submonoid.powers (x_lvl j))
            ext x
            change (hDescEx s).choose ((hLegEx j).choose (algebraMap ↑(E_d.obj j) (Localization.Away (x_lvl j)) x)) =
              (s.ι.app j).hom (algebraMap ↑(E_d.obj j) (Localization.Away (x_lvl j)) x)
            rw [(hLegEx j).choose_spec x, (hDescEx s).choose_spec]
            exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (hc_d.fac (toBaseCocone s) j)) x
          uniq := fun s m hm => by
            apply CommRingCat.hom_ext
            apply IsLocalization.ringHom_ext (Submonoid.powers x_pt)
            ext x
            change m.hom (algebraMap ↑c_d.pt (Localization.Away x_pt) x) =
              (hDescEx s).choose (algebraMap ↑c_d.pt (Localization.Away x_pt) x)
            rw [(hDescEx s).choose_spec x]
            have hm0 : ι_pt ≫ m = hc_d.desc (toBaseCocone s) := by
              apply hc_d.uniq (toBaseCocone s)
              intro j
              rw [← Category.assoc, hι_comm j, Category.assoc, hm j]
            exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm0) x }
    exact ⟨E_l, ι_l, c_l, hc_l, ι_pt, hι_comm,
      ⟨(inferInstance : Algebra ↑c_d.pt (Localization.Away x_pt)),
        (inferInstance : IsLocalization.Away x_pt (Localization.Away x_pt)), rfl⟩,
      fun j => ⟨(inferInstance : Algebra ↑(E_d.obj j) (Localization.Away (x_lvl j))),
        (inferInstance : IsLocalization.Away (x_lvl j) (Localization.Away (x_lvl j))), rfl⟩⟩

  have hUnderPushoutColim : ∀ (D_p : ℐ ⥤ CommRingCat.{u}) (c_p : CategoryTheory.Limits.Cocone D_p),
      CategoryTheory.Limits.IsColimit c_p →
      ∀ (E_inf : CommRingCat.{u}) (f_E : c_p.pt ⟶ E_inf), f_E.hom.Etale →
        ∃ (i₀ : ℐ)
          (E_d : CategoryTheory.Under i₀ ⥤ CommRingCat.{u})
          (f_st : ∀ j : CategoryTheory.Under i₀, D_p.obj j.right ⟶ E_d.obj j)
          (ι_E : E_d ⟶ (CategoryTheory.Functor.const (CategoryTheory.Under i₀)).obj E_inf)
          (_ : CategoryTheory.Limits.IsColimit ({ pt := E_inf, ι := ι_E } : CategoryTheory.Limits.Cocone E_d)),
          (∀ j : CategoryTheory.Under i₀, AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (f_st j))) ∧
          (∀ {j j' : CategoryTheory.Under i₀} (φ : j ⟶ j'),
            f_st j ≫ E_d.map φ = D_p.map φ.right ≫ f_st j') ∧
          (∀ j : CategoryTheory.Under i₀,
            f_st j ≫ ι_E.app j = c_p.ι.app j.right ≫ f_E) := by
    intro D_p c_p hc_p E_inf f_E hf_E_et
    obtain ⟨i₀, n₀, J₀, g₀, hf₀_et, hPush₀⟩ :=
      hEtalePresDescent D_p c_p hc_p E_inf f_E hf_E_et
    let E₀ : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin n₀) ↑(D_p.obj i₀) ⧸ J₀)
    let f₀ : D_p.obj i₀ ⟶ E₀ := CommRingCat.ofHom ((Ideal.Quotient.mk J₀).comp MvPolynomial.C)
    let 𝒥 := CategoryTheory.Under i₀
    let _ : CategoryTheory.IsFiltered 𝒥 := CategoryTheory.IsFiltered.under i₀
    have : (CategoryTheory.Under.forget i₀).Final := CategoryTheory.Under.final_forget i₀
    let E_d : 𝒥 ⥤ CommRingCat.{u} :=
      { obj := fun j => CategoryTheory.Limits.pushout (D_p.map j.hom) f₀
        map := fun {j j'} φ =>
          CategoryTheory.Limits.pushout.desc
            (D_p.map φ.right ≫ CategoryTheory.Limits.pushout.inl (D_p.map j'.hom) f₀)
            (CategoryTheory.Limits.pushout.inr (D_p.map j'.hom) f₀)
            (by rw [← Category.assoc, ← D_p.map_comp, CategoryTheory.Under.w φ]
                exact CategoryTheory.Limits.pushout.condition)
        map_id := fun j => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc, Category.comp_id,
              show (𝟙 j : j ⟶ j).right = 𝟙 j.right from rfl, D_p.map_id, Category.id_comp]
          · rw [CategoryTheory.Limits.pushout.inr_desc, Category.comp_id]
        map_comp := fun {j₁ j₂ j₃} φ₁ φ₂ => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc_assoc,
              Category.assoc (D_p.map φ₁.right), CategoryTheory.Limits.pushout.inl_desc,
              CategoryTheory.Limits.pushout.inl_desc,
              show (φ₁ ≫ φ₂).right = φ₁.right ≫ φ₂.right from rfl,
              D_p.map_comp, Category.assoc]
          · rw [CategoryTheory.Limits.pushout.inr_desc_assoc,
              CategoryTheory.Limits.pushout.inr_desc,
              CategoryTheory.Limits.pushout.inr_desc] }
    let f_st : ∀ j : 𝒥, D_p.obj j.right ⟶ E_d.obj j :=
      fun j => CategoryTheory.Limits.pushout.inl (D_p.map j.hom) f₀
    have hf_st_et : ∀ j : 𝒥, AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (f_st j)) := by
      intro j
      have hf₀_spec_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map f₀) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf₀_et
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (AlgebraicGeometry.isPullback_SpecMap_pushout (D_p.map j.hom) f₀).flip hf₀_spec_et
    let ι_E : E_d ⟶ (CategoryTheory.Functor.const 𝒥).obj E_inf :=
      { app := fun j =>
          CategoryTheory.Limits.pushout.desc (c_p.ι.app j.right ≫ f_E) g₀
            (by rw [← Category.assoc, c_p.w j.hom]; exact hPush₀.w)
        naturality := fun j j' φ => by
          dsimp [E_d]; rw [Category.comp_id]
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc_assoc,
              CategoryTheory.Limits.pushout.inl_desc,
              Category.assoc, CategoryTheory.Limits.pushout.inl_desc,
              ← Category.assoc, c_p.w φ.right]
          · rw [CategoryTheory.Limits.pushout.inr_desc_assoc,
              CategoryTheory.Limits.pushout.inr_desc,
              CategoryTheory.Limits.pushout.inr_desc] }
    let c_E : CategoryTheory.Limits.Cocone E_d := { pt := E_inf, ι := ι_E }
    have hc_E : CategoryTheory.Limits.IsColimit c_E := by
      let hc_whisk :=
        (CategoryTheory.Functor.Final.isColimitWhiskerEquiv (CategoryTheory.Under.forget i₀) c_p).symm hc_p
      let j_id : 𝒥 := CategoryTheory.Under.mk (𝟙 i₀)
      let toWhiskCocone : ∀ s : CategoryTheory.Limits.Cocone E_d,
          CategoryTheory.Limits.Cocone (CategoryTheory.Under.forget i₀ ⋙ D_p) :=
        fun s =>
          { pt := s.pt
            ι :=
              { app := fun j => f_st j ≫ s.ι.app j
                naturality := fun j j' φ => by
                  dsimp [f_st, E_d]
                  rw [Category.comp_id, ← s.w φ, ← Category.assoc (CategoryTheory.Limits.pushout.inl _ _),
                    CategoryTheory.Limits.pushout.inl_desc, Category.assoc] } }
      have hcond0_of : ∀ s : CategoryTheory.Limits.Cocone E_d,
          c_p.ι.app i₀ ≫ hc_whisk.desc (toWhiskCocone s) =
            f₀ ≫ (CategoryTheory.Limits.pushout.inr (D_p.map j_id.hom) f₀ ≫ s.ι.app j_id) := by
        intro s
        have h1 : c_p.ι.app j_id.right ≫ hc_whisk.desc (toWhiskCocone s) =
            f_st j_id ≫ s.ι.app j_id := hc_whisk.fac (toWhiskCocone s) j_id
        dsimp [j_id, f_st] at h1 ⊢
        have hcond_id : CategoryTheory.Limits.pushout.inl (D_p.map (𝟙 i₀)) f₀ =
            f₀ ≫ CategoryTheory.Limits.pushout.inr (D_p.map (𝟙 i₀)) f₀ := by
          calc
            CategoryTheory.Limits.pushout.inl (D_p.map (𝟙 i₀)) f₀
                = 𝟙 _ ≫ CategoryTheory.Limits.pushout.inl (D_p.map (𝟙 i₀)) f₀ :=
                (Category.id_comp _).symm
            _ = D_p.map (𝟙 i₀) ≫ CategoryTheory.Limits.pushout.inl (D_p.map (𝟙 i₀)) f₀ := by
                rw [D_p.map_id]
            _ = f₀ ≫ CategoryTheory.Limits.pushout.inr (D_p.map (𝟙 i₀)) f₀ :=
                CategoryTheory.Limits.pushout.condition
        rw [h1, hcond_id, Category.assoc]
      refine
        { desc := fun s =>
            hPush₀.desc (hc_whisk.desc (toWhiskCocone s))
              (CategoryTheory.Limits.pushout.inr (D_p.map j_id.hom) f₀ ≫ s.ι.app j_id)
              (hcond0_of s)
          fac := fun s j => by
            apply CategoryTheory.Limits.pushout.hom_ext
            · dsimp [c_E, ι_E]
              rw [CategoryTheory.Limits.pushout.inl_desc_assoc, Category.assoc, hPush₀.inl_desc]
              exact hc_whisk.fac (toWhiskCocone s) j
            · dsimp [c_E, ι_E]
              rw [CategoryTheory.Limits.pushout.inr_desc_assoc, hPush₀.inr_desc]
              let u_j : j_id ⟶ j := CategoryTheory.Under.homMk j.hom (Category.id_comp j.hom)
              have hw_u := s.w u_j
              dsimp [E_d] at hw_u ⊢
              rw [← hw_u, ← Category.assoc, CategoryTheory.Limits.pushout.inr_desc]
          uniq := fun s m hm => by
            apply hPush₀.hom_ext
            · rw [hPush₀.inl_desc]
              apply hc_whisk.uniq (toWhiskCocone s); intro j
              have h1 : c_p.ι.app j.right ≫ f_E = f_st j ≫ c_E.ι.app j :=
                (CategoryTheory.Limits.pushout.inl_desc _ _ _).symm
              change (c_p.ι.app j.right ≫ f_E) ≫ m = f_st j ≫ s.ι.app j
              rw [h1, Category.assoc, hm j]
            · rw [hPush₀.inr_desc]
              have h1 : g₀ = CategoryTheory.Limits.pushout.inr (D_p.map j_id.hom) f₀ ≫ c_E.ι.app j_id :=
                (CategoryTheory.Limits.pushout.inr_desc _ _ _).symm
              rw [h1, Category.assoc, hm j_id] }
    exact ⟨i₀, E_d, f_st, ι_E, hc_E, hf_st_et,
      fun _ => CategoryTheory.Limits.pushout.inl_desc _ _ _,
      fun _ => CategoryTheory.Limits.pushout.inl_desc _ _ _⟩

  have hUnitMulPow : ∀ {B : Type u} [CommRing B] (x ϖ : B) (u : Bˣ) (e : ℕ),
      1 ≤ e → x = ↑u * ϖ ^ e →
      ∀ {R : Type u} [CommRing R] (ρ : B →+* R), IsUnit (ρ ϖ) ↔ IsUnit (ρ x) := by
    intro B _ x ϖ u e he hx R _ ρ
    constructor
    · intro h; rw [hx, map_mul, map_pow]
      exact (Units.isUnit (Units.map ρ.toMonoidHom u)).mul (h.pow e)
    · rintro ⟨v, hv⟩
      obtain ⟨m, rfl⟩ : ∃ m : ℕ, e = m + 1 := ⟨e - 1, (Nat.sub_add_cancel he).symm⟩
      refine IsUnit.of_mul_eq_one (ρ ↑u * ρ ϖ ^ m * ↑v⁻¹) ?_
      have hmul : ρ ϖ * (ρ ↑u * ρ ϖ ^ m) = ρ x := by rw [hx, map_mul, map_pow, pow_succ']; ring
      rw [← mul_assoc, hmul, ← hv, Units.mul_inv]

  have hStageDescentGeneral :
      ∀ (R₀ Ω₀ : Type u) [CommRing R₀] [CommRing Ω₀]
        (p_R : Polynomial k →+* R₀)
        (t_bar : R₀) (_ : p_R Polynomial.X = t_bar)
        (φ_R_Ω : R₀ →+* Ω₀)
        (_ : @IsLocalization.Away R₀ _ t_bar Ω₀ _ φ_R_Ω.toAlgebra)
        (e_pt₀ : c.pt ≅ CommRingCat.of R₀)
        (_ : ∀ i : ℐ, (α.app i) ≫ (c.ι.app i) ≫ e_pt₀.hom = CommRingCat.ofHom p_R)
        (_ : ∀ i : ℐ,
          ∃ (ϖ : ↑(D.obj i)) (u : (↑(D.obj i))ˣ) (e : ℕ)
            (ψ_i : Polynomial k →+* ↑(D.obj i)),
            1 ≤ e ∧
            (α.app i).hom Polynomial.X = ↑u * ϖ ^ e ∧
            ψ_i.comp Polynomial.C = (α.app i).hom.comp Polynomial.C ∧
            ψ_i Polynomial.X = ϖ ∧
            ψ_i.Etale ∧
            ∃ (i₁ : ℐ) (θ : i ⟶ i₁) (β : ↑(D.obj i₁))
              (ψ₁ : Polynomial k →+* ↑(D.obj i₁)),
              (D.map θ).hom ϖ = β ^ ℓ ∧
              ψ₁.comp Polynomial.C = (α.app i₁).hom.comp Polynomial.C ∧
              ψ₁ Polynomial.X = β ∧
              ψ₁.Etale),
        let P := Polynomial k
        let S_d := weilAffineSpaceOver k d
        let A1_k := AlgebraicGeometry.Spec (CommRingCat.of P)
        let Gm_k := AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (Polynomial.X : P)))
        let j_Gm : Gm_k ⟶ A1_k := AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap P (Localization.Away (Polynomial.X : P))))
        let κ_A1 : A1_k ⟶ A1_k := AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Polynomial.aeval ((Polynomial.X : P) ^ ℓ)).toRingHom))
        let p_A1 : A1_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* P))
        let Y_d := CategoryTheory.Limits.pullback S_d.hom p_A1
        let U_d := CategoryTheory.Limits.pullback j_Gm
          (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
        let j_d : U_d ⟶ Y_d :=
          CategoryTheory.Limits.pullback.snd j_Gm
            (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
        let g_k_R : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of k) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p_R.comp Polynomial.C))
        let j_R : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
        let A_R := CategoryTheory.Limits.pullback S_d.hom g_k_R
        let A_Ω := CategoryTheory.Limits.pullback j_R
          (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
        let j_Ad : A_Ω ⟶ A_R :=
          CategoryTheory.Limits.pullback.snd j_R
            (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
        ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
          (w : W ⟶ A_R) [AlgebraicGeometry.Etale w],
          ∃ (𝒥 : Type u) (_ : CategoryTheory.SmallCategory 𝒥) (_ : CategoryTheory.IsFiltered 𝒥)
            (E_diag E_loc : 𝒥 ⥤ CommRingCat.{u})
            (ι_loc : E_diag ⟶ E_loc)
            (c_E : CategoryTheory.Limits.Cocone E_diag) (_ : CategoryTheory.Limits.IsColimit c_E)
            (c_Eloc : CategoryTheory.Limits.Cocone E_loc) (_ : CategoryTheory.Limits.IsColimit c_Eloc)
            (ι_inf : c_E.pt ⟶ c_Eloc.pt)
            (e_W : AlgebraicGeometry.Spec c_E.pt ≅ W)
            (e_WU : AlgebraicGeometry.Spec c_Eloc.pt ≅ CategoryTheory.Limits.pullback j_Ad w),
            (∀ j : 𝒥, c_E.ι.app j ≫ ι_inf = ι_loc.app j ≫ c_Eloc.ι.app j) ∧
            e_WU.hom ≫ CategoryTheory.Limits.pullback.snd j_Ad w =
              AlgebraicGeometry.Spec.map ι_inf ≫ e_W.hom ∧
            ∀ j : 𝒥,
              ∃ (w_j : AlgebraicGeometry.Spec (E_diag.obj j) ⟶ Y_d)
                (_ : AlgebraicGeometry.Etale w_j)
                (ϕ_j : AlgebraicGeometry.Spec (E_loc.obj j) ≅
                  CategoryTheory.Limits.pullback j_d w_j),
                ϕ_j.hom ≫ CategoryTheory.Limits.pullback.snd j_d w_j =
                  AlgebraicGeometry.Spec.map (ι_loc.app j) ∧
                ∃ (j₁ : 𝒥) (θ_U : j ⟶ j₁)
                  (w₁ : AlgebraicGeometry.Spec (E_diag.obj j₁) ⟶ Y_d)
                  (_ : AlgebraicGeometry.Etale w₁)
                  (ϕ₁ : AlgebraicGeometry.Spec (E_loc.obj j₁) ≅
                    CategoryTheory.Limits.pullback j_d w₁),
                  ϕ₁.hom ≫ CategoryTheory.Limits.pullback.snd j_d w₁ =
                    AlgebraicGeometry.Spec.map (ι_loc.app j₁) ∧
                  let π_W : AlgebraicGeometry.Spec (E_diag.obj j₁) ⟶
                      AlgebraicGeometry.Spec (E_diag.obj j) :=
                    AlgebraicGeometry.Spec.map (E_diag.map θ_U)
                  let π_WU : CategoryTheory.Limits.pullback j_d w₁ ⟶
                      CategoryTheory.Limits.pullback j_d w_j :=
                    ϕ₁.inv ≫ AlgebraicGeometry.Spec.map (E_loc.map θ_U) ≫ ϕ_j.hom
                  π_W ≫ w_j ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
                    w₁ ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 ∧
                  π_W ≫ w_j ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
                    w₁ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 ≫ κ_A1 ∧
                  π_WU ≫ CategoryTheory.Limits.pullback.snd j_d w_j =
                    CategoryTheory.Limits.pullback.snd j_d w₁ ≫ π_W := by
    intro R₀ Ω₀ _ _ p_R t_bar ht_eq φ_R_Ω hLoc_Ω e_pt₀ hCocone₀ hStage₀
    let D_poly : ℐ ⥤ CommRingCat.{u} :=
      { obj := fun i => CommRingCat.of (MvPolynomial (Fin d) ↑(D.obj i))
        map := fun θ => CommRingCat.ofHom (MvPolynomial.map (D.map θ).hom)
        map_id := fun i => by
          apply CommRingCat.hom_ext; apply RingHom.ext; intro p
          rw [D.map_id]; exact MvPolynomial.map_id p
        map_comp := fun θ₁ θ₂ => by
          apply CommRingCat.hom_ext; apply RingHom.ext; intro p
          rw [D.map_comp]
          exact (MvPolynomial.map_map (D.map θ₁).hom (D.map θ₂).hom p).symm }
    let C_inf : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin d) R₀)
    let c_poly : CategoryTheory.Limits.Cocone D_poly :=
      { pt := C_inf
        ι :=
          { app := fun i => CommRingCat.ofHom (MvPolynomial.map (c.ι.app i ≫ e_pt₀.hom).hom)
            naturality := fun i i' θ => by
              dsimp [D_poly]; rw [Category.comp_id]
              apply CommRingCat.hom_ext; apply RingHom.ext; intro p
              change MvPolynomial.map _ (MvPolynomial.map _ p) = MvPolynomial.map _ p
              rw [MvPolynomial.map_map]
              have hcw : D.map θ ≫ (c.ι.app i' ≫ e_pt₀.hom) = c.ι.app i ≫ e_pt₀.hom := by
                rw [← Category.assoc, c.w θ]
              exact congrFun (congrArg DFunLike.coe (congrArg MvPolynomial.map
                (congrArg CommRingCat.Hom.hom hcw))) p } }
    have hc_poly : CategoryTheory.Limits.IsColimit c_poly := by
      let i₀_arb : ℐ := Classical.choice CategoryTheory.IsFiltered.nonempty
      let c_map_i : ∀ i : ℐ, D.obj i ⟶ D_poly.obj i := fun i => CommRingCat.ofHom MvPolynomial.C
      have hc_map_nat : ∀ {i i' : ℐ} (θ : i ⟶ i'), D.map θ ≫ c_map_i i' = c_map_i i ≫ D_poly.map θ := by
        intro i i' θ; apply CommRingCat.hom_ext; apply RingHom.ext; intro a
        exact (MvPolynomial.map_C (D.map θ).hom a).symm
      let toDCocone : ∀ s : CategoryTheory.Limits.Cocone D_poly, CategoryTheory.Limits.Cocone D :=
        fun s =>
          { pt := s.pt
            ι :=
              { app := fun i => c_map_i i ≫ s.ι.app i
                naturality := fun i i' θ => by
                  dsimp
                  rw [Category.comp_id, ← Category.assoc, hc_map_nat θ, Category.assoc, s.w θ] } }
      refine
        { desc := fun s =>
            CommRingCat.ofHom
              (MvPolynomial.eval₂Hom (e_pt₀.inv ≫ hc.desc (toDCocone s)).hom
                (fun m => (s.ι.app i₀_arb).hom (MvPolynomial.X m)))
          fac := fun s i => by
            have hX_const : ∀ m : Fin d,
                (s.ι.app i).hom (MvPolynomial.X m) = (s.ι.app i₀_arb).hom (MvPolynomial.X m) := by
              intro m
              let f₁ := CategoryTheory.IsFiltered.leftToMax i i₀_arb
              let f₂ := CategoryTheory.IsFiltered.rightToMax i i₀_arb
              have h1 := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (s.w f₁)) (MvPolynomial.X m)
              have h2 := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (s.w f₂)) (MvPolynomial.X m)
              change (s.ι.app _).hom (MvPolynomial.map _ (MvPolynomial.X m)) = _ at h1 h2
              rw [MvPolynomial.map_X] at h1 h2
              exact h1.symm.trans h2
            apply CommRingCat.hom_ext; apply MvPolynomial.ringHom_ext
            · intro a
              change MvPolynomial.eval₂Hom _ _ (MvPolynomial.map _ (MvPolynomial.C a)) =
                (s.ι.app i).hom (MvPolynomial.C a)
              rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
              have hfac : (c.ι.app i ≫ e_pt₀.hom) ≫ (e_pt₀.inv ≫ hc.desc (toDCocone s)) =
                  c_map_i i ≫ s.ι.app i := by
                rw [Category.assoc, e_pt₀.hom_inv_id_assoc]; exact hc.fac (toDCocone s) i
              exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hfac) a
            · intro m
              change MvPolynomial.eval₂Hom _ _ (MvPolynomial.map _ (MvPolynomial.X m)) =
                (s.ι.app i).hom (MvPolynomial.X m)
              rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X', hX_const m]
          uniq := fun s g hg => by
            have hd_eq : CommRingCat.ofHom MvPolynomial.C ≫ g = e_pt₀.inv ≫ hc.desc (toDCocone s) := by
              rw [Iso.eq_inv_comp]; apply hc.uniq (toDCocone s); intro i
              dsimp [toDCocone]
              have hC_map : (c.ι.app i ≫ e_pt₀.hom) ≫ CommRingCat.ofHom MvPolynomial.C =
                  c_map_i i ≫ c_poly.ι.app i := by
                apply CommRingCat.hom_ext; apply RingHom.ext; intro a
                exact (MvPolynomial.map_C _ a).symm
              rw [← Category.assoc (c.ι.app i), ← Category.assoc (c.ι.app i ≫ e_pt₀.hom),
                hC_map, Category.assoc, hg i]
            apply CommRingCat.hom_ext; apply MvPolynomial.ringHom_ext
            · intro r
              change g.hom (MvPolynomial.C r) = MvPolynomial.eval₂Hom _ _ (MvPolynomial.C r)
              rw [MvPolynomial.eval₂Hom_C]
              exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hd_eq) r
            · intro m
              change g.hom (MvPolynomial.X m) = MvPolynomial.eval₂Hom _ _ (MvPolynomial.X m)
              rw [MvPolynomial.eval₂Hom_X']
              have h1 := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (hg i₀_arb)) (MvPolynomial.X m)
              change g.hom (MvPolynomial.map _ (MvPolynomial.X m)) = _ at h1
              rwa [MvPolynomial.map_X] at h1 }

    intro P S_d A1_k Gm_k j_Gm κ_A1 p_A1 Y_d U_d j_d g_k_R j_R A_R A_Ω j_Ad W _ w _
    have hpb_AR : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map (p_R.comp Polynomial.C))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.C : R₀ →+* MvPolynomial (Fin d) R₀)))
        S_d.hom g_k_R :=
      hPushMvPoly (p_R.comp Polynomial.C)
    let e_AR : AlgebraicGeometry.Spec C_inf ≅ A_R := hpb_AR.isoPullback
    have he_AR_snd : e_AR.hom ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) :=
      hpb_AR.isoPullback_hom_snd

    let E_inf : CommRingCat.{u} := W.presheaf.obj (Opposite.op ⊤)
    let e_W : AlgebraicGeometry.Spec E_inf ≅ W := W.isoSpec.symm
    let f_E : C_inf ⟶ E_inf := AlgebraicGeometry.Spec.preimage (e_W.hom ≫ w ≫ e_AR.inv)
    have hf_E_map : AlgebraicGeometry.Spec.map f_E = e_W.hom ≫ w ≫ e_AR.inv :=
      AlgebraicGeometry.Spec.map_preimage _
    have hf_E_et : f_E.hom.Etale := by
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      rw [hf_E_map]; infer_instance

    obtain ⟨i₀, E_diag, f_stage, ι_E, hc_E, hf_stage_et, hf_stage_nat, hf_stage_pt⟩ :=
      hUnderPushoutColim D_poly c_poly hc_poly E_inf f_E hf_E_et
    let c_E : CategoryTheory.Limits.Cocone E_diag := { pt := E_inf, ι := ι_E }
    let 𝒥 : Type u := CategoryTheory.Under i₀
    let _ : CategoryTheory.IsFiltered 𝒥 := CategoryTheory.IsFiltered.under i₀

    let X_E : ∀ j : 𝒥, ↑(E_diag.obj j) :=
      fun j => (f_stage j).hom (MvPolynomial.C ((α.app j.right).hom Polynomial.X))
    let t_E : ↑E_inf := f_E.hom (MvPolynomial.C t_bar)
    have hX_E_map : ∀ {j j' : 𝒥} (φ : j ⟶ j'), (E_diag.map φ).hom (X_E j) = X_E j' := by
      intro j j' φ
      have h2 := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (hf_stage_nat φ))
        (MvPolynomial.C ((α.app j.right).hom Polynomial.X))
      change (E_diag.map φ).hom (X_E j) =
        (f_stage j').hom (MvPolynomial.map (D.map φ.right).hom
          (MvPolynomial.C ((α.app j.right).hom Polynomial.X))) at h2
      rw [h2, MvPolynomial.map_C, hα_nat_apply φ.right Polynomial.X]
    have hX_E_inf : ∀ j : 𝒥, (c_E.ι.app j).hom (X_E j) = t_E := by
      intro j
      have h2 := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (hf_stage_pt j))
        (MvPolynomial.C ((α.app j.right).hom Polynomial.X))
      change (c_E.ι.app j).hom (X_E j) =
        f_E.hom (MvPolynomial.map (c.ι.app j.right ≫ e_pt₀.hom).hom
          (MvPolynomial.C ((α.app j.right).hom Polynomial.X))) at h2
      rw [h2, MvPolynomial.map_C]
      have h3 := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (hCocone₀ j.right)) Polynomial.X
      change (c.ι.app j.right ≫ e_pt₀.hom).hom ((α.app j.right).hom Polynomial.X) = p_R Polynomial.X at h3
      rw [h3, ht_eq]

    obtain ⟨E_loc, ι_loc, c_Eloc, hc_Eloc, ι_inf, hι_comm,
      ⟨hAlg_inf, hLoc_inf, hι_inf_eq⟩, hLoc_lvl_pkg⟩ :=
      hLocFilteredColim 𝒥 E_diag c_E hc_E X_E t_E hX_E_map hX_E_inf

    let φ_R_cE : R₀ →+* ↑E_inf := f_E.hom.comp MvPolynomial.C
    have hw_snd : e_W.hom ≫ w ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_cE) := by
      have heW_w : e_W.hom ≫ w = AlgebraicGeometry.Spec.map f_E ≫ e_AR.hom := by
        rw [hf_E_map, Category.assoc, Category.assoc, e_AR.inv_hom_id, Category.comp_id]
      rw [← Category.assoc, heW_w, Category.assoc, he_AR_snd, ← AlgebraicGeometry.Spec.map_comp]
      exact congrArg AlgebraicGeometry.Spec.map rfl
    have hw_snd_inv : w ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R =
        e_W.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_cE) := by
      rw [← hw_snd, ← Category.assoc, e_W.inv_hom_id, Category.id_comp]
    obtain ⟨ψ_inf, hpb_loc_inf₀⟩ := @hPushLocAway R₀ ↑c_E.pt Ω₀ ↑c_Eloc.pt _ _ _ _
      φ_R_Ω.toAlgebra hAlg_inf φ_R_cE t_bar t_E hLoc_Ω hLoc_inf (fun _ => Iff.rfl)
    have hpb_loc_inf : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_inf))
        (AlgebraicGeometry.Spec.map ι_inf)
        j_R
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_cE)) := by
      rw [hι_inf_eq]; exact hpb_loc_inf₀
    have hpb_jAd_pasted : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst j_Ad w ≫
          CategoryTheory.Limits.pullback.fst j_R (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R))
        (CategoryTheory.Limits.pullback.snd j_Ad w)
        j_R (w ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R) :=
      (CategoryTheory.IsPullback.of_hasPullback j_Ad w).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback j_R (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R))
    let e_WU : AlgebraicGeometry.Spec c_Eloc.pt ≅ CategoryTheory.Limits.pullback j_Ad w :=
      { hom := hpb_jAd_pasted.lift
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_inf))
          (AlgebraicGeometry.Spec.map ι_inf ≫ e_W.hom)
          (by rw [Category.assoc, hw_snd]; exact hpb_loc_inf.w)
        inv := hpb_loc_inf.lift
          (CategoryTheory.Limits.pullback.fst j_Ad w ≫
            CategoryTheory.Limits.pullback.fst j_R (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R))
          (CategoryTheory.Limits.pullback.snd j_Ad w ≫ e_W.inv)
          (by
            rw [Category.assoc (CategoryTheory.Limits.pullback.snd j_Ad w), ← hw_snd_inv,
                ← Category.assoc]
            exact hpb_jAd_pasted.w)
        hom_inv_id := by apply hpb_loc_inf.hom_ext <;> simp
        inv_hom_id := by apply hpb_jAd_pasted.hom_ext <;> simp }

    have hBuildChart : ∀ (j : 𝒥) (ϖ : ↑(D.obj j.right)) (u : (↑(D.obj j.right))ˣ) (e : ℕ)
        (ψ : Polynomial k →+* ↑(D.obj j.right)),
        1 ≤ e →
        (α.app j.right).hom Polynomial.X = ↑u * ϖ ^ e →
        ψ.comp Polynomial.C = (α.app j.right).hom.comp Polynomial.C →
        ψ Polynomial.X = ϖ →
        ψ.Etale →
        ∃ (w_j : AlgebraicGeometry.Spec (E_diag.obj j) ⟶ Y_d)
          (_ : AlgebraicGeometry.Etale w_j)
          (ϕ_j : AlgebraicGeometry.Spec (E_loc.obj j) ≅ CategoryTheory.Limits.pullback j_d w_j),
          w_j ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
            AlgebraicGeometry.Spec.map (f_stage j) ≫
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (MvPolynomial.map ((α.app j.right).hom.comp Polynomial.C))) :
                _ ⟶ S_d.left) ∧
          w_j ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (((f_stage j).hom.comp MvPolynomial.C).comp ψ)) ∧
          ϕ_j.hom ≫ CategoryTheory.Limits.pullback.snd j_d w_j =
            AlgebraicGeometry.Spec.map (ι_loc.app j) := by
      intro j ϖ u e ψ he hX hψC hψX hψEt
      let c_k : k →+* ↑(D.obj j.right) := (α.app j.right).hom.comp Polynomial.C
      let pr_Sd : AlgebraicGeometry.Spec (D_poly.obj j.right) ⟶ S_d.left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map c_k))
      have hpb_mv : CategoryTheory.IsPullback pr_Sd
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.C : ↑(D.obj j.right) →+* MvPolynomial (Fin d) ↑(D.obj j.right))))
          S_d.hom (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ p_A1) := by
        have hcomp_pA1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ p_A1 =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_k) := by
          dsimp [p_A1, c_k]
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψC]
          rfl
        rw [hcomp_pA1]; exact hPushMvPoly c_k
      let q_j : AlgebraicGeometry.Spec (D_poly.obj j.right) ⟶ Y_d :=
        CategoryTheory.Limits.pullback.lift pr_Sd
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ))
          (by rw [Category.assoc]; exact hpb_mv.w)
      have hq_fst : q_j ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 = pr_Sd :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hq_snd : q_j ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hpb_q_outer : CategoryTheory.IsPullback
          (q_j ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C))
          S_d.hom (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ p_A1) := by
        rw [hq_fst]; exact hpb_mv
      have hpb_q : CategoryTheory.IsPullback q_j
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C))
          (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) :=
        CategoryTheory.IsPullback.of_right hpb_q_outer hq_snd
          (CategoryTheory.IsPullback.of_hasPullback S_d.hom p_A1)
      have hq_et : AlgebraicGeometry.Etale q_j :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_q.flip
          ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψEt)
      let w_j : AlgebraicGeometry.Spec (E_diag.obj j) ⟶ Y_d :=
        AlgebraicGeometry.Spec.map (f_stage j) ≫ q_j
      have hw_j_et : AlgebraicGeometry.Etale w_j :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _ (hf_stage_et j) hq_et
      let toE : ↑(D.obj j.right) →+* ↑(E_diag.obj j) := (f_stage j).hom.comp MvPolynomial.C
      let γ_j : Polynomial k →+* ↑(E_diag.obj j) := toE.comp ψ
      have hw_fst : w_j ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
          AlgebraicGeometry.Spec.map (f_stage j) ≫ pr_Sd := by
        dsimp [w_j]; rw [Category.assoc, hq_fst]
      have hw_snd_j : w_j ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_j) := by
        dsimp [w_j, γ_j, toE]
        rw [Category.assoc, hq_snd, ← Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      have hXE_fac : X_E j = ↑(Units.map toE.toMonoidHom u) * (γ_j Polynomial.X) ^ e := by
        change toE ((α.app j.right).hom Polynomial.X) = ↑(Units.map toE.toMonoidHom u) * (toE (ψ Polynomial.X)) ^ e
        rw [hX, hψX, map_mul, map_pow]; rfl
      obtain ⟨hAlg_j, hLoc_j, hι_j_eq⟩ := hLoc_lvl_pkg j
      obtain ⟨ψ_loc, hpb_loc_j₀⟩ := @hPushLocAway (Polynomial k) ↑(E_diag.obj j)
        (Localization.Away (Polynomial.X : Polynomial k)) ↑(E_loc.obj j)
        _ _ _ _ inferInstance hAlg_j γ_j Polynomial.X (X_E j) inferInstance hLoc_j
        (fun ρ => hUnitMulPow (X_E j) (γ_j Polynomial.X) (Units.map toE.toMonoidHom u) e he hXE_fac ρ)
      have hpb_loc_j : CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_loc))
          (AlgebraicGeometry.Spec.map (ι_loc.app j))
          j_Gm
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_j)) := by
        rw [hι_j_eq]; exact hpb_loc_j₀
      have hpb_jd_pasted : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst j_d w_j ≫
            CategoryTheory.Limits.pullback.fst j_Gm (CategoryTheory.Limits.pullback.snd S_d.hom p_A1))
          (CategoryTheory.Limits.pullback.snd j_d w_j)
          j_Gm (w_j ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1) :=
        (CategoryTheory.IsPullback.of_hasPullback j_d w_j).paste_horiz
          (CategoryTheory.IsPullback.of_hasPullback j_Gm (CategoryTheory.Limits.pullback.snd S_d.hom p_A1))
      let ϕ_j : AlgebraicGeometry.Spec (E_loc.obj j) ≅ CategoryTheory.Limits.pullback j_d w_j :=
        { hom := hpb_jd_pasted.lift
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_loc))
            (AlgebraicGeometry.Spec.map (ι_loc.app j))
            (by rw [hw_snd_j]; exact hpb_loc_j.w)
          inv := hpb_loc_j.lift
            (CategoryTheory.Limits.pullback.fst j_d w_j ≫
              CategoryTheory.Limits.pullback.fst j_Gm (CategoryTheory.Limits.pullback.snd S_d.hom p_A1))
            (CategoryTheory.Limits.pullback.snd j_d w_j)
            (by rw [← hw_snd_j]; exact hpb_jd_pasted.w)
          hom_inv_id := by apply hpb_loc_j.hom_ext <;> simp
          inv_hom_id := by apply hpb_jd_pasted.hom_ext <;> simp }
      exact ⟨w_j, hw_j_et, ϕ_j, hw_fst, hw_snd_j, hpb_jd_pasted.lift_snd _ _ _⟩

    refine ⟨𝒥, inferInstance, inferInstance, E_diag, E_loc, ι_loc, c_E, hc_E, c_Eloc, hc_Eloc,
      ι_inf, e_W, e_WU, hι_comm, hpb_jAd_pasted.lift_snd _ _ _, fun j => ?_⟩
    obtain ⟨ϖ, u, e, ψ_i, he, hX_i, hψC_i, hψX_i, hψEt_i, i₁, θ, β, ψ₁, hβ, hψ₁C, hψ₁X, hψ₁Et⟩ :=
      hStage₀ j.right
    obtain ⟨w_j, hw_j, ϕ_j, hwj_fst, hwj_snd, hϕ_j_snd⟩ :=
      hBuildChart j ϖ u e ψ_i he hX_i hψC_i hψX_i hψEt_i
    let j₁ : 𝒥 := CategoryTheory.Under.mk (j.hom ≫ θ)
    let θ_U : j ⟶ j₁ := CategoryTheory.Under.homMk θ rfl
    let u₁ : (↑(D.obj i₁))ˣ := Units.map (D.map θ).hom.toMonoidHom u
    have he₁ : 1 ≤ ℓ * e := Nat.mul_pos hℓ_pos he
    have hX₁ : (α.app i₁).hom Polynomial.X = ↑u₁ * β ^ (ℓ * e) := by
      rw [← hα_nat_apply θ Polynomial.X, hX_i, map_mul, map_pow, hβ, ← pow_mul]
      rfl
    obtain ⟨w₁, hw₁, ϕ₁, hw₁_fst, hw₁_snd, hϕ₁_snd⟩ :=
      hBuildChart j₁ β u₁ (ℓ * e) ψ₁ he₁ hX₁ hψ₁C hψ₁X hψ₁Et
    refine ⟨w_j, hw_j, ϕ_j, hϕ_j_snd, j₁, θ_U, w₁, hw₁, ϕ₁, hϕ₁_snd, ?_, ?_, ?_⟩
    · change AlgebraicGeometry.Spec.map (E_diag.map θ_U) ≫
          (w_j ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1) =
        w₁ ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1
      rw [hwj_fst, hw₁_fst]
      have hcomp_st : AlgebraicGeometry.Spec.map (E_diag.map θ_U) ≫ AlgebraicGeometry.Spec.map (f_stage j) =
          AlgebraicGeometry.Spec.map (f_stage j₁) ≫ AlgebraicGeometry.Spec.map (D_poly.map θ) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp, hf_stage_nat θ_U]
        rfl
      refine (Category.assoc _ _ _).symm.trans ((CategoryTheory.eq_whisker hcomp_st _).trans
        ((Category.assoc _ _ _).trans (CategoryTheory.whisker_eq _ ?_)))
      change AlgebraicGeometry.Spec.map (D_poly.map θ) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.map ((α.app j.right).hom.comp Polynomial.C))) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.map ((α.app i₁).hom.comp Polynomial.C)))
      rw [← AlgebraicGeometry.Spec.map_comp]
      congr 1; apply CommRingCat.hom_ext; apply RingHom.ext; intro p
      change (MvPolynomial.map (D.map θ).hom)
          (MvPolynomial.map ((α.app j.right).hom.comp Polynomial.C) p) =
        MvPolynomial.map ((α.app i₁).hom.comp Polynomial.C) p
      rw [MvPolynomial.map_map]; congr 2; apply RingHom.ext; intro a
      exact hα_nat_apply θ (Polynomial.C a)
    · change AlgebraicGeometry.Spec.map (E_diag.map θ_U) ≫
          (w_j ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1) =
        (w₁ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1) ≫ κ_A1
      rw [hwj_snd, hw₁_snd, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1; apply CommRingCat.hom_ext; apply Polynomial.ringHom_ext'
      · ext a
        have hc1 := DFunLike.congr_fun hψC_i a
        have hc2 := DFunLike.congr_fun hψ₁C a
        change (f_stage j ≫ E_diag.map θ_U).hom (MvPolynomial.C (ψ_i (Polynomial.C a))) =
          (f_stage j₁).hom (MvPolynomial.C (ψ₁ ((Polynomial.aeval (Polynomial.X ^ ℓ)) (Polynomial.C a))))
        rw [Polynomial.aeval_C, hf_stage_nat θ_U]
        change (f_stage j₁).hom (MvPolynomial.map (D.map θ).hom (MvPolynomial.C (ψ_i (Polynomial.C a)))) = _
        rw [MvPolynomial.map_C]; congr 2
        change (D.map θ).hom ((ψ_i.comp Polynomial.C) a) = (ψ₁.comp Polynomial.C) a
        rw [hc1, hc2]; exact hα_nat_apply θ (Polynomial.C a)
      · change (f_stage j ≫ E_diag.map θ_U).hom (MvPolynomial.C (ψ_i Polynomial.X)) =
          (f_stage j₁).hom (MvPolynomial.C (ψ₁ ((Polynomial.aeval (Polynomial.X ^ ℓ)) Polynomial.X)))
        rw [hf_stage_nat θ_U, hψX_i, Polynomial.aeval_X, map_pow, hψ₁X]
        change (f_stage j₁).hom (MvPolynomial.map (D.map θ).hom (MvPolynomial.C ϖ)) =
          (f_stage j₁).hom (MvPolynomial.C (β ^ ℓ))
        rw [MvPolynomial.map_C, hβ]
    · have hloc_nat : AlgebraicGeometry.Spec.map (E_loc.map θ_U) ≫
          AlgebraicGeometry.Spec.map (ι_loc.app j) =
          AlgebraicGeometry.Spec.map (ι_loc.app j₁) ≫ AlgebraicGeometry.Spec.map (E_diag.map θ_U) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp, ι_loc.naturality θ_U]
      calc
        (ϕ₁.inv ≫ AlgebraicGeometry.Spec.map (E_loc.map θ_U) ≫ ϕ_j.hom) ≫
            CategoryTheory.Limits.pullback.snd j_d w_j
            = ϕ₁.inv ≫ (AlgebraicGeometry.Spec.map (E_loc.map θ_U) ≫
                AlgebraicGeometry.Spec.map (ι_loc.app j)) := by
            rw [Category.assoc, Category.assoc, hϕ_j_snd]
        _ = ϕ₁.inv ≫ (AlgebraicGeometry.Spec.map (ι_loc.app j₁) ≫
              AlgebraicGeometry.Spec.map (E_diag.map θ_U)) := by rw [hloc_nat]
        _ = ϕ₁.inv ≫ ϕ₁.hom ≫ CategoryTheory.Limits.pullback.snd j_d w₁ ≫
              AlgebraicGeometry.Spec.map (E_diag.map θ_U) := by
            rw [← hϕ₁_snd, Category.assoc ϕ₁.hom]
        _ = CategoryTheory.Limits.pullback.snd j_d w₁ ≫ AlgebraicGeometry.Spec.map (E_diag.map θ_U) := by
            rw [← Category.assoc ϕ₁.inv ϕ₁.hom, ϕ₁.inv_hom_id, Category.id_comp]

  let P := Polynomial k
  let Ω := AlgebraicClosure (FractionRing P)
  let R_bar := Localization.AtPrime M_max
  let t_bar : R_bar := algebraMap P R_bar Polynomial.X
  let ψ_R_Ω : R_bar →+* Ω := (AlgebraicGeometry.Spec.preimage j_Rbar).hom
