    let φ_KB : CommRingCat.of K ⟶ R_U := Spec.preimage (j_U ≫ snd_z)
    have hSpec_φ : Spec.map φ_KB = j_U ≫ snd_z := Spec.map_preimage _
    have hEt_Spec : Etale (Spec.map φ_KB) := by rw [hSpec_φ]; infer_instance
    have hEt_hom : φ_KB.hom.Etale := (HasRingHomProperty.Spec_iff (P := @Etale)).mp hEt_Spec
    let _ : Algebra K B := φ_KB.hom.toAlgebra
    have _ : Algebra.Etale K B := RingHom.etale_algebraMap.mp hEt_hom
    obtain ⟨I, hFinI, L, hFieldL, hAlgL, Θ, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K B).mp inferInstance
    have _ : Finite I := hFinI
    let _ : Fintype I := Fintype.ofFinite I
    let _ : ∀ i, Field (L i) := hFieldL
    let _ : ∀ i, Algebra K (L i) := hAlgL
    have hex_i : ∃ _ : I, True := by
      by_contra! hemp
      have _ : IsEmpty I := ⟨fun i => hemp i⟩
      have h10 : (1 : B) = 0 := Θ.injective (Subsingleton.elim _ _)
      exact one_ne_zero h10
    obtain ⟨i₀, -⟩ := hex_i
    have _ : Module.Finite K (L i₀) := (hFinSep i₀).1
    have hSurj_i₀ : Function.Surjective (algebraMap K (L i₀)) := by
      intro y
      have hy_int : _root_.IsIntegral K y := Algebra.IsIntegral.isIntegral y
      let p_min := minpoly K y
      have hdeg : p_min.degree ≠ 0 := ne_of_gt (Irreducible.degree_pos (minpoly.irreducible hy_int))
      obtain ⟨c, hc⟩ := IsAlgClosed.exists_root p_min hdeg
      obtain ⟨q_pol, hq_pol⟩ := Polynomial.dvd_iff_isRoot.mpr hc
      have hq_u : IsUnit q_pol :=
        ((minpoly.irreducible hy_int).isUnit_or_isUnit hq_pol).resolve_left
