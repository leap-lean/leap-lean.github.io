        ((AlgebraicGeometry.Scheme.Etale.forget U).map g_U).left
      obtain ⟨p_gU, hp_gU⟩ := hPullEx g_U_left ℓ b
      have hp_gU_zero : p_gU ξ_sym = 0 := by
