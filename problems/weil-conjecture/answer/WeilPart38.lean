      have hspan_ne : Ideal.span ({d} : Set A) ≠ ⊤ := by
        rwa [Ne, Ideal.span_singleton_eq_top]
      obtain ⟨p, hp_max, hle_p⟩ := Ideal.exists_le_maximal (Ideal.span ({d} : Set A)) hspan_ne
      have _ : p.IsMaximal := hp_max
      have hd_mem_p : d ∈ p := hle_p (Ideal.subset_span (Set.mem_singleton d))
      have _ : Finite (A ⧸ p) := @hFinRes p hp_max
      obtain ⟨⟨P, hP_prime, hP_over⟩⟩ := Ideal.nonempty_primesOver (S := B_E) p
      have _ : P.IsPrime := hP_prime
      have _ : P.LiesOver p := hP_over
      have hP_comap : Ideal.comap (algebraMap A B_E) P = p := (Ideal.over_def P p).symm
      have _ : P.IsMaximal :=
        Ideal.IsIntegral.isMaximal_of_isMaximal_under (R := A) P (by rwa [Ideal.under, hP_comap])
      have _ : Algebra.IsUnramifiedAt A P := hUnram p P hP_comap
      have _ : Algebra.FiniteType A B_E := Module.Finite.finiteType (R := A) B_E
      have _ : Algebra.EssFiniteType A B_E := Algebra.EssFiniteType.of_finiteType A B_E
      have _ : IsGaloisGroup (E ≃ₐ[K] E) A B_E :=
        IsGaloisGroup.of_isFractionRing (E ≃ₐ[K] E) A B_E K E
      have _ : Algebra.HasSeparableResidueFieldsAt A B_E p := hSepFinite A B_E p
      have hcard_inert : Nat.card ↥(Ideal.inertia (E ≃ₐ[K] E) P) = 1 := by
        rw [Ideal.card_inertia_eq_ramificationIdxIn p P,
          Ideal.ramificationIdxIn_eq_ramificationIdx p P (E ≃ₐ[K] E),
          Ideal.ramificationIdx_eq_one_of_isUnramifiedAt]
      let κ := B_E ⧸ P
      let _ : Field κ := Ideal.Quotient.field P
      let q_P : B_E →+* κ := Ideal.Quotient.mk P
      let χ : Fin m → (B_E →+* κ) := fun s => q_P.comp (τ s).toRingHom
      have hχ_apply : ∀ (s : Fin m) (y : B_E), χ s y = q_P (τ s y) := fun _ _ => rfl
      have hinj_χ : Function.Injective (fun s : Fin m => (χ s).toMonoidHom) := by
        intro s t hst
        let g₀ : E ≃ₐ[K] E := e_G s * (e_G t)⁻¹
        have hg₀_mem : g₀ ∈ Ideal.inertia (E ≃ₐ[K] E) P := by
          rw [AddSubgroup.mem_inertia]
          intro y
          have hsmul : g₀ • y = τ s ((τ t).symm y) := by
            apply Subtype.ext
            change g₀ (y : E) = ↑(τ s ((τ t).symm y))
            rw [AlgEquiv.coe_mapIntegralClosure]
            change (e_G s) ((e_G t).symm (y : E)) = (e_G s) ↑((τ t).symm y)
            congr 1
          have hq_eq : q_P (g₀ • y) = q_P y := by
            rw [hsmul]
            have happ := congrFun (congrArg DFunLike.coe hst) ((τ t).symm y)
            change q_P (τ s ((τ t).symm y)) = q_P (τ t ((τ t).symm y)) at happ
            rwa [AlgEquiv.apply_symm_apply] at happ
          apply Ideal.Quotient.eq_zero_iff_mem.mp
          change q_P (g₀ • y - y) = 0
          rw [map_sub, hq_eq, sub_self]
        have hSub : Subsingleton ↥(Ideal.inertia (E ≃ₐ[K] E) P) :=
          (Nat.card_eq_one_iff_unique.mp hcard_inert).1
        have hg₀_one : g₀ = 1 :=
          congrArg Subtype.val (hSub.elim ⟨g₀, hg₀_mem⟩ ⟨1, Subgroup.one_mem _⟩)
        exact e_G.injective (mul_inv_eq_one.mp hg₀_one)
      have hLinInd : LinearIndependent κ (fun s : Fin m => (χ s : B_E → κ)) :=
        (linearIndependent_monoidHom B_E κ).comp _ hinj_χ
      let M_bar : Matrix (Fin m) (Fin m) κ := q_P.mapMatrix M_G
      have hVecInj : Function.Injective (fun v : Fin m → κ => Matrix.vecMul v M_bar) := by
        intro v₁ v₂ hv
        let c : Fin m → κ := v₁ - v₂
        have hc_b : ∀ i : Fin m, ∑ s : Fin m, c s * χ s (b i) = 0 := by
          intro i
          have hvi := congrFun hv i
          simp only [Matrix.vecMul, dotProduct, M_bar, RingHom.mapMatrix_apply,
            Matrix.map_apply, M_G, Matrix.of_apply] at hvi
          have hsub : ∑ s : Fin m, (v₁ s - v₂ s) * q_P (τ s (b i)) =
              (∑ s : Fin m, v₁ s * q_P (τ s (b i))) -
              (∑ s : Fin m, v₂ s * q_P (τ s (b i))) := by
            rw [← Finset.sum_sub_distrib]
            exact Finset.sum_congr rfl fun s _ => sub_mul _ _ _
          dsimp only [c, Pi.sub_apply]
          simp_rw [hχ_apply]
          rw [hsub, hvi, sub_self]
        have hc_all : ∑ s : Fin m, c s • (χ s : B_E → κ) = 0 := by
          ext y
          simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
          have hy_χ : ∀ s : Fin m,
              χ s y = ∑ i : Fin m, q_P (algebraMap A B_E (b.repr y i)) * χ s (b i) := by
            intro s
            rw [hχ_apply]
            conv_lhs => rw [← b.sum_repr y]
            rw [map_sum, map_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [hχ_apply, Algebra.smul_def, map_mul, map_mul, (τ s).commutes]
          simp_rw [hy_χ, Finset.mul_sum]
          rw [Finset.sum_comm]
          calc
            ∑ i : Fin m, ∑ s : Fin m, c s * (q_P (algebraMap A B_E (b.repr y i)) * χ s (b i))
              = ∑ i : Fin m, q_P (algebraMap A B_E (b.repr y i)) * (∑ s : Fin m, c s * χ s (b i)) := by
                refine Finset.sum_congr rfl fun i _ => ?_
                rw [Finset.mul_sum]
                exact Finset.sum_congr rfl fun s _ => by ring
            _ = ∑ i : Fin m, q_P (algebraMap A B_E (b.repr y i)) * 0 := by simp_rw [hc_b]
            _ = 0 := by simp
        have hc0 := Fintype.linearIndependent_iff.mp hLinInd c hc_all
        funext s
        exact sub_eq_zero.mp (hc0 s)
      have hUnit_Mbar : IsUnit M_bar.det :=
        Matrix.isUnit_iff_isUnit_det M_bar |>.mp (Matrix.vecMul_injective_iff_isUnit.mp hVecInj)
      have hNeZero_sq : M_bar.det ^ 2 ≠ 0 := pow_ne_zero 2 hUnit_Mbar.ne_zero
      have hq_d_eq : q_P (algebraMap A B_E d) = M_bar.det ^ 2 := by
        rw [hd_sq, map_pow, RingHom.map_det]
      have hq_d_zero : q_P (algebraMap A B_E d) = 0 := by
        apply Ideal.Quotient.eq_zero_iff_mem.mpr
        rw [← Ideal.mem_comap, hP_comap]
        exact hd_mem_p
      exact hNeZero_sq (hq_d_eq.symm.trans hq_d_zero)
    exact ⟨Module.Finite.of_basis b, hEtaleOfTraceDet A B_E m b hd_unit⟩

theorem weil_dedekind_etale_local_domain_and_dvr_inertia_fix (A : Type u)
    [CommRing A] [IsDomain A] [IsDedekindDomain A] :
    (∀ (D : Type u) [CommRing D] [Algebra A D] [Algebra.Etale A D]
        (Q : Ideal D) [Q.IsPrime],
      ∃ s₀ : D, s₀ ∉ Q ∧
        IsDomain (Localization.Away s₀) ∧
        (Ideal.map (algebraMap D (Localization.Away s₀)) Q).IsPrime ∧
        Ideal.comap (algebraMap D (Localization.Away s₀))
          (Ideal.map (algebraMap D (Localization.Away s₀)) Q) = Q) ∧
    (∀ (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
        (p : Ideal A) [p.IsMaximal], p ≠ ⊥ →
      ∀ (C : Type u) [CommRing C] [IsDomain C] [Algebra A C] [Algebra.Etale A C]
        (Q_C : Ideal C) [Q_C.IsPrime],
        Ideal.comap (algebraMap A C) Q_C = p →
        ∀ (E₀ : IntermediateField K (AlgebraicClosure K))
          [FiniteDimensional K ↥E₀] [IsGalois K ↥E₀],
          ∃ (L₁ : IntermediateField K (AlgebraicClosure K))
            (_ : FiniteDimensional K ↥L₁) (_ : IsGalois K ↥L₁),
            E₀ ≤ L₁ ∧
            letI : Algebra A ↥L₁ :=
              ((algebraMap K ↥L₁).comp (algebraMap A K)).toAlgebra
            ∃ (φ_C : C →ₐ[A] ↥L₁),
              ∀ (Q₁ : Ideal ↥(integralClosure A ↥L₁)), Q₁.IsPrime →
                Ideal.comap (algebraMap A ↥(integralClosure A ↥L₁)) Q₁ = p →
                ∀ (σ : ↥L₁ ≃ₐ[K] ↥L₁),
                  (∀ y : ↥(integralClosure A ↥L₁),
                    σ (y : ↥L₁) - (y : ↥L₁) ∈
                      Subtype.val '' (Q₁ : Set ↥(integralClosure A ↥L₁))) →
                  ∃ γ : ↥L₁ ≃ₐ[K] ↥L₁,
                    ∀ c : C, (γ⁻¹ * σ * γ) (φ_C c) = φ_C c) :=
by
  
  have hPillar1 : ∀ (D : Type u) [CommRing D] [Algebra A D] [Algebra.Etale A D]
      (Q : Ideal D) [Q.IsPrime],
      (∃ s₀ : D, s₀ ∉ Q ∧
        IsDomain (Localization.Away s₀) ∧
        (Ideal.map (algebraMap D (Localization.Away s₀)) Q).IsPrime ∧
        Ideal.comap (algebraMap D (Localization.Away s₀))
          (Ideal.map (algebraMap D (Localization.Away s₀)) Q) = Q) ∧
      (Ideal.comap (algebraMap A D) Q ≠ ⊥ → IsIntegrallyClosed (Localization.AtPrime Q)) := by
    classical
    intro D _ _ _ Q _
    let p : Ideal A := Ideal.comap (algebraMap A D) Q
    have hp_prime : p.IsPrime := Ideal.comap_isPrime (algebraMap A D) Q
    let R := Localization.AtPrime p
    let S := Localization.AtPrime Q
    let instAlgRS : Algebra R S := (Localization.localRingHom p Q (algebraMap A D) rfl).toAlgebra
    have : IsLocalHom (algebraMap R S) := Localization.isLocalHom_localRingHom p Q (algebraMap A D) rfl
    have : IsScalarTower A R S := IsScalarTower.of_algebraMap_eq fun a =>
      (IsScalarTower.algebraMap_apply A D S a).trans
        (Localization.localRingHom_to_map p Q (algebraMap A D) rfl a).symm
    have : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing A D
    have : IsNoetherianRing S := IsLocalization.isNoetherianRing Q.primeCompl S inferInstance
    have : Algebra.FormallyUnramified D S := Algebra.FormallyUnramified.of_isLocalization Q.primeCompl
    have : Algebra.FormallyUnramified A S := Algebra.FormallyUnramified.comp A D S
    have : Algebra.FormallyUnramified R S := Algebra.FormallyUnramified.of_restrictScalars A R S
    have : Algebra.EssFiniteType A D := Algebra.EssFiniteType.of_finiteType A D
    have : Algebra.EssFiniteType D S := Algebra.EssFiniteType.of_isLocalization S Q.primeCompl
    have : Algebra.EssFiniteType A S := Algebra.EssFiniteType.comp A D S
    have : Algebra.EssFiniteType R S := Algebra.EssFiniteType.of_comp A R S
    have h_max : Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal S :=
      Algebra.FormallyUnramified.map_maximalIdeal
    have hDom_and_IC : IsDomain S ∧ (p ≠ ⊥ → IsIntegrallyClosed S) := by
      by_cases hp : p = ⊥
      · refine ⟨?_, fun hne => False.elim (hne hp)⟩
        have hmR : IsLocalRing.maximalIdeal R = ⊥ := by
          rw [← Localization.AtPrime.map_eq_maximalIdeal (I := p), eq_bot_iff,
            Ideal.map_le_iff_le_comap]
          intro a ha
          rw [hp, Ideal.mem_bot] at ha
          rw [ha]
          exact Submodule.zero_mem _
        have hmS : IsLocalRing.maximalIdeal S = ⊥ := by
          rw [← h_max, hmR, Ideal.map_bot]
        have hNZD : NoZeroDivisors S := ⟨fun {x y} hxy => by
          by_cases hx : x = 0
          · exact Or.inl hx
          · have hx_not : x ∉ IsLocalRing.maximalIdeal S := by
              rw [hmS, Ideal.mem_bot]; exact hx
            exact Or.inr ((IsLocalRing.notMem_maximalIdeal.mp hx_not).mul_right_eq_zero.mp hxy)⟩
        exact NoZeroDivisors.to_isDomain S
      · have hp_le_nzd : p.primeCompl ≤ nonZeroDivisors A := fun x hx =>
          mem_nonZeroDivisors_iff_ne_zero.mpr fun h0 => hx (h0 ▸ p.zero_mem)
        have : IsDomain R := IsLocalization.isDomain_localization hp_le_nzd
        have : IsDiscreteValuationRing R :=
          IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain A hp R
        let π : R := Submodule.IsPrincipal.generator (IsLocalRing.maximalIdeal R)
        have hπ_span : Ideal.span {π} = IsLocalRing.maximalIdeal R :=
          Submodule.IsPrincipal.span_singleton_generator (IsLocalRing.maximalIdeal R)
        have hAR_inj : Function.Injective (algebraMap A R) :=
          IsLocalization.injective R hp_le_nzd
        have hπ_ne : π ≠ 0 := by
          intro h0
          have hmR_bot : IsLocalRing.maximalIdeal R = ⊥ := by
            rw [← hπ_span, h0, Ideal.span_singleton_eq_bot]
          have hp_eq : p = Ideal.comap (algebraMap A R) (IsLocalRing.maximalIdeal R) :=
            (Localization.AtPrime.under_maximalIdeal (I := p)).symm
          apply hp
          rw [hp_eq, hmR_bot, eq_bot_iff]
          intro a ha
          exact hAR_inj ((Ideal.mem_bot.mp ha).trans (map_zero _).symm)
        let t : S := algebraMap R S π
        have hmS_span : IsLocalRing.maximalIdeal S = Ideal.span {t} := by
          rw [← h_max, ← hπ_span, Ideal.map_span, Set.image_singleton]
        obtain ⟨⟨a₀, u⟩, hπ_eq⟩ := IsLocalization.surj p.primeCompl π
        have hu_unitR : IsUnit (algebraMap A R u.1) := IsLocalization.map_units R u
        have ha₀_ne : a₀ ≠ 0 := by
          intro h0
          rw [h0, map_zero] at hπ_eq
          exact hπ_ne (hu_unitR.mul_left_eq_zero.mp hπ_eq)
        have ht_eq : t * algebraMap A S u.1 = algebraMap A S a₀ := by
          dsimp [t]
          rw [IsScalarTower.algebraMap_apply A R S u.1, IsScalarTower.algebraMap_apply A R S a₀,
            ← map_mul, hπ_eq]
        have : Module.Flat A D := Algebra.Smooth.flat A D
        have : Module.Flat D S := IsLocalization.flat S Q.primeCompl
        have : Module.Flat A S := Module.Flat.trans A D S
        have : Module.IsTorsionFree A S := inferInstance
        have ht_nzd : ∀ x : S, t * x = 0 → x = 0 := by
          intro x htx
          have hsmul : a₀ • x = 0 := by
            rw [Algebra.smul_def, ← ht_eq, mul_comm t, mul_assoc, htx, mul_zero]
          exact (smul_eq_zero.mp hsmul).resolve_left ha₀_ne
        have ht_pow_nzd : ∀ (n : ℕ) (x : S), t ^ n * x = 0 → x = 0 := by
          intro n
          induction n with
          | zero => intro x hx; simpa using hx
          | succ n ih =>
            intro x hx
            rw [pow_succ', mul_assoc] at hx
            exact ih x (ht_nzd _ hx)
        let mS := IsLocalRing.maximalIdeal S
        have hmS_ne_top : mS ≠ ⊤ := Ideal.IsPrime.ne_top inferInstance
        have hiInf : (⨅ n : ℕ, mS ^ n) = ⊥ :=
          Ideal.iInf_pow_eq_bot_of_isLocalRing mS hmS_ne_top
        have hmS_pow : ∀ n : ℕ, mS ^ n = Ideal.span {t ^ n} := by
          intro n
          dsimp [mS]
          rw [hmS_span, Ideal.span_singleton_pow]
        have hVal : ∀ x : S, x ≠ 0 → ∃ (m : ℕ) (v : S), IsUnit v ∧ x = t ^ m * v := by
          intro x hx
          have hnot_iInf : x ∉ ⨅ n : ℕ, mS ^ n := by
            rw [hiInf, Ideal.mem_bot]; exact hx
          have hex : ∃ n : ℕ, x ∉ mS ^ n := by
            by_contra h_all
            apply hnot_iInf
            rw [Ideal.mem_iInf]
            intro n
            by_contra hnot
            exact h_all ⟨n, hnot⟩
          let N := Nat.find hex
          have hN_spec : x ∉ mS ^ N := Nat.find_spec hex
          have hN_ne : N ≠ 0 := by
            intro h0
            apply hN_spec
            rw [h0, pow_zero, Ideal.one_eq_top]
            exact Submodule.mem_top
          let m := N - 1
          have hm_lt : m < N := Nat.sub_one_lt hN_ne
          have hxm : x ∈ mS ^ m := by
            by_contra hnot
            exact Nat.find_min hex hm_lt hnot
          rw [hmS_pow m, Ideal.mem_span_singleton] at hxm
          obtain ⟨v, hv⟩ := hxm
          refine ⟨m, v, ?_, hv⟩
          apply IsLocalRing.notMem_maximalIdeal.mp
          intro hv_mem
          rw [hmS_span, Ideal.mem_span_singleton] at hv_mem
          obtain ⟨w, rfl⟩ := hv_mem
          apply hN_spec
          have hN_eq : m + 1 = N := Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hN_ne)
          rw [← hN_eq, hmS_pow (m + 1), Ideal.mem_span_singleton]
          exact ⟨w, by rw [hv]; ring⟩
        have hNZD_S : NoZeroDivisors S := ⟨fun {a b} hab => by
          by_cases ha : a = 0
          · exact Or.inl ha
          · obtain ⟨m, v, hv_unit, rfl⟩ := hVal a ha
            rw [mul_assoc] at hab
            exact Or.inr (hv_unit.mul_right_eq_zero.mp (ht_pow_nzd m _ hab))⟩
        have hDomS : IsDomain S := NoZeroDivisors.to_isDomain S
        have hPIDS : IsPrincipalIdealRing S := by
          refine IsPrincipalIdealRing.mk fun I => ?_
          by_cases hI : I = ⊥
          · exact ⟨0, by rw [hI, Submodule.span_zero_singleton]⟩
          · obtain ⟨x₀, hx₀_mem, hx₀_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
            obtain ⟨m₁, v₁, hv₁_unit, rfl⟩ := hVal x₀ hx₀_ne
            obtain ⟨u₁, rfl⟩ := hv₁_unit
            have hex_pow : ∃ m : ℕ, t ^ m ∈ I :=
              ⟨m₁, by simpa [mul_assoc] using I.mul_mem_right (↑u₁⁻¹ : S) hx₀_mem⟩
            let m₀ := Nat.find hex_pow
            have hm₀_mem : t ^ m₀ ∈ I := Nat.find_spec hex_pow
            refine ⟨t ^ m₀, le_antisymm ?_ (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hm₀_mem))⟩
            intro y hy
            by_cases hy0 : y = 0
            · rw [hy0]; exact Submodule.zero_mem _
            · obtain ⟨k, w, hw_unit, rfl⟩ := hVal y hy0
              obtain ⟨uw, rfl⟩ := hw_unit
              have htk_mem : t ^ k ∈ I := by
                simpa [mul_assoc] using I.mul_mem_right (↑uw⁻¹ : S) hy
              have hm₀_le : m₀ ≤ k := Nat.find_min' hex_pow htk_mem
              exact Ideal.mem_span_singleton.mpr ⟨t ^ (k - m₀) * ↑uw, by
                rw [← mul_assoc, ← pow_add, Nat.add_sub_of_le hm₀_le]⟩
        exact ⟨hDomS, fun _ => inferInstance⟩
    have hDomS_main : IsDomain S := hDom_and_IC.1
    refine ⟨?_, hDom_and_IC.2⟩
    let I₀ : Ideal D := RingHom.ker (algebraMap D S)
    obtain ⟨G_set, hG_fin, hG_span⟩ := Submodule.fg_def.mp (IsNoetherian.noetherian I₀)
    obtain ⟨G, rfl⟩ := hG_fin.exists_finset_coe
    have hc_ex : ∀ g : D, g ∈ I₀ → ∃ c : Q.primeCompl, c.1 * g = 0 := by
      intro g hg
      have hg0 : algebraMap D S g = algebraMap D S 0 := by rw [map_zero]; exact hg
      obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists Q.primeCompl S).mp hg0
      exact ⟨c, by simpa using hc⟩
    let f : D → Q.primeCompl := fun g => if hg : g ∈ I₀ then Classical.choose (hc_ex g hg) else 1
    have hf_spec : ∀ g : D, g ∈ I₀ → (f g).1 * g = 0 := by
      intro g hg
      simp only [f, hg, ↓reduceDIte]
      exact Classical.choose_spec (hc_ex g hg)
    let u₀ : Q.primeCompl := ∏ g ∈ G, f g
    let s₀ : D := u₀.1
    have hs₀_not_Q : s₀ ∉ Q := u₀.2
    have hs₀_ann_G : ∀ g ∈ G, s₀ * g = 0 := by
      intro g hg
      have hg_I₀ : g ∈ I₀ := by
        rw [← hG_span]
        exact Ideal.subset_span hg
      have hfg : (f g).1 * g = 0 := hf_spec g hg_I₀
      have hs₀_coe : s₀ = ∏ x ∈ G, (f x).1 := Submonoid.coe_finsetProd Q.primeCompl f G
      obtain ⟨q, hq⟩ := Finset.dvd_prod_of_mem (fun x => (f x).1) hg
      rw [hs₀_coe, hq, mul_comm (f g).1 q, mul_assoc, hfg, mul_zero]
    let J_ann : Ideal D :=
      { carrier := { x : D | s₀ * x = 0 }
        add_mem' := fun {x y} hx hy => by
          change s₀ * (x + y) = 0
          change s₀ * x = 0 at hx
          change s₀ * y = 0 at hy
          rw [mul_add, hx, hy, add_zero]
        zero_mem' := mul_zero s₀
        smul_mem' := fun r {x} hx => by
          change s₀ * (r • x) = 0
          change s₀ * x = 0 at hx
          rw [smul_eq_mul, ← mul_assoc, mul_comm s₀ r, mul_assoc, hx, mul_zero] }
    have hI₀_ann : ∀ x ∈ I₀, s₀ * x = 0 := by
      have hle : I₀ ≤ J_ann := by
        rw [← hG_span, Ideal.span_le]
        intro g hg
        exact hs₀_ann_G g hg
      intro x hx
      exact hle hx
    let D' := Localization.Away s₀
    have hu₀_unit : IsUnit (algebraMap D S s₀) := IsLocalization.map_units S u₀
    let ψ : D' →+* S := IsLocalization.Away.lift s₀ hu₀_unit
    have hψ_inj : Function.Injective ψ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨d, ⟨_, ⟨n, rfl⟩⟩⟩, hzd⟩ := IsLocalization.surj (Submonoid.powers s₀) z
      have hd_S : algebraMap D S d = 0 := by
        have h1 := congrArg ψ hzd
        rw [map_mul, hz, zero_mul, IsLocalization.Away.lift_eq s₀ hu₀_unit d] at h1
        exact h1.symm
      have hs₀_d : s₀ * d = 0 := hI₀_ann d hd_S
      have h_eq0 : algebraMap D D' s₀ * (z * (algebraMap D D' s₀) ^ n) = 0 := by
        rw [← map_pow, hzd, ← map_mul, hs₀_d, map_zero]
      have hu_D' : IsUnit (algebraMap D D' s₀) := IsLocalization.Away.algebraMap_isUnit s₀
      have hz_pow : z * (algebraMap D D' s₀) ^ n = 0 := hu_D'.mul_right_eq_zero.mp h_eq0
      exact (hu_D'.pow n).mul_left_eq_zero.mp hz_pow
    have hDomD' : IsDomain D' := Function.Injective.isDomain ψ hψ_inj
    have hDisj : Disjoint (Submonoid.powers s₀ : Set D) (Q : Set D) := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hmem
      exact (u₀ ^ n).2 (by simpa [s₀] using hmem)
    exact ⟨s₀, hs₀_not_Q, hDomD',
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers s₀) D' Q inferInstance hDisj,
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers s₀) D' inferInstance hDisj⟩

  
  have hPillar2a : ∀ (K C : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
      [CommRing C] [IsDomain C] [Algebra A C] [Algebra.Etale A C]
      (E₀ : IntermediateField K (AlgebraicClosure K))
      [FiniteDimensional K ↥E₀] [IsGalois K ↥E₀],
      ∃ (instKM : Algebra K (FractionRing C)),
        letI : Algebra K (FractionRing C) := instKM
        IsScalarTower A K (FractionRing C) ∧
        FiniteDimensional K (FractionRing C) ∧
        Algebra.IsSeparable K (FractionRing C) ∧
        ∃ (L₁ : IntermediateField K (AlgebraicClosure K))
          (_ : FiniteDimensional K ↥L₁) (_ : IsGalois K ↥L₁),
          E₀ ≤ L₁ ∧ Nonempty (FractionRing C →ₐ[K] ↥L₁) := by
    classical
    intro K C _ _ _ _ _ _ _ E₀ _ _
    let M := FractionRing C
    have : Module.Flat A C := Algebra.Smooth.flat A C
    have : Module.IsTorsionFree A C := inferInstance
    have hAC_inj : Function.Injective (algebraMap A C) := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      have hsmul : a • (1 : C) = 0 := by rw [Algebra.smul_def, ha, zero_mul]
      exact (smul_eq_zero.mp hsmul).resolve_right one_ne_zero
    have hAM_inj : Function.Injective (algebraMap A M) := by
      rw [IsScalarTower.algebraMap_eq A C M]
      exact (IsFractionRing.injective C M).comp hAC_inj
    let instAlgKM : Algebra K M := (IsFractionRing.lift hAM_inj).toAlgebra
    have hTowerAKM : IsScalarTower A K M := IsScalarTower.of_algebraMap_eq fun a =>
      (IsFractionRing.lift_algebraMap hAM_inj a).symm
    let E_ten := TensorProduct A K C
    let Ψ_A : E_ten →ₐ[A] M :=
      Algebra.TensorProduct.lift (IsScalarTower.toAlgHom A K M) (IsScalarTower.toAlgHom A C M)
        (fun _ _ => mul_comm _ _)
    have hΨ_tmul : ∀ (k : K) (c : C),
        Ψ_A (TensorProduct.tmul A k c) = algebraMap K M k * algebraMap C M c := fun k c =>
      Algebra.TensorProduct.lift_tmul _ _ _ k c
    let Ψ_K : E_ten →ₐ[K] M :=
      { Ψ_A.toRingHom with
        commutes' := fun k => by
          change Ψ_A (TensorProduct.tmul A k 1) = algebraMap K M k
          rw [hΨ_tmul, map_one, mul_one] }
    have htmul_A : ∀ (a : A) (c : C),
        TensorProduct.tmul A (algebraMap A K a) c = TensorProduct.tmul A (1 : K) (a • c) := by
      intro a c
      have ha1 : algebraMap A K a = a • (1 : K) := by rw [Algebra.smul_def, mul_one]
      rw [ha1, TensorProduct.smul_tmul]
    have hClear : ∀ z : E_ten, ∃ (u : nonZeroDivisors A) (c : C),
        TensorProduct.tmul A (algebraMap A K u.1) 1 * z = TensorProduct.tmul A 1 c := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero =>
        exact ⟨1, 0, by rw [mul_zero, TensorProduct.tmul_zero]⟩
      | tmul k c₀ =>
        obtain ⟨⟨a, u⟩, hku⟩ := IsLocalization.surj (nonZeroDivisors A) k
        refine ⟨u, a • c₀, ?_⟩
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm (algebraMap A K u.1) k, hku,
          htmul_A]
      | add x y ihx ihy =>
        obtain ⟨u₁, c₁, hx⟩ := ihx
        obtain ⟨u₂, c₂, hy⟩ := ihy
        refine ⟨u₁ * u₂, u₂.1 • c₁ + u₁.1 • c₂, ?_⟩
        have hterm1 : TensorProduct.tmul A (algebraMap A K (u₁ * u₂).1) 1 * x =
            TensorProduct.tmul A 1 (u₂.1 • c₁) := by
          have h1 : TensorProduct.tmul A (algebraMap A K (u₁ * u₂).1) (1 : C) =
              TensorProduct.tmul A (algebraMap A K u₂.1) 1 *
                TensorProduct.tmul A (algebraMap A K u₁.1) 1 := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, ← map_mul, mul_comm u₂.1 u₁.1]
            rfl
          rw [h1, mul_assoc, hx, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, htmul_A]
        have hterm2 : TensorProduct.tmul A (algebraMap A K (u₁ * u₂).1) 1 * y =
            TensorProduct.tmul A 1 (u₁.1 • c₂) := by
          have h2 : TensorProduct.tmul A (algebraMap A K (u₁ * u₂).1) (1 : C) =
              TensorProduct.tmul A (algebraMap A K u₁.1) 1 *
                TensorProduct.tmul A (algebraMap A K u₂.1) 1 := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, ← map_mul]
            rfl
          rw [h2, mul_assoc, hy, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, htmul_A]
        rw [mul_add, hterm1, hterm2, TensorProduct.tmul_add]
    have hΨ_inj : Function.Injective Ψ_K := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨u, c, hzc⟩ := hClear z
      have hc0 : algebraMap C M c = 0 := by
        have h1 := congrArg Ψ_K hzc
        rw [map_mul, hz, mul_zero] at h1
        change 0 = Ψ_A (TensorProduct.tmul A 1 c) at h1
        rw [hΨ_tmul, map_one, one_mul] at h1
        exact h1.symm
      have hc_eq : c = 0 := IsFractionRing.injective C M (hc0.trans (map_zero _).symm)
      rw [hc_eq, TensorProduct.tmul_zero] at hzc
      have hu_ne : algebraMap A K u.1 ≠ 0 := by
        intro h0
        have hu0 : u.1 = 0 := IsFractionRing.injective A K (h0.trans (map_zero _).symm)
        exact nonZeroDivisors.ne_zero u.2 hu0
      have hinv := congrArg (fun w => TensorProduct.tmul A (algebraMap A K u.1)⁻¹ 1 * w) hzc
      rw [mul_zero, ← mul_assoc, Algebra.TensorProduct.tmul_mul_tmul,
        inv_mul_cancel₀ hu_ne, one_mul] at hinv
      change (1 : E_ten) * z = 0 at hinv
      rwa [one_mul] at hinv
    have hDom_Eten : IsDomain E_ten := Function.Injective.isDomain Ψ_K.toRingHom hΨ_inj
    have hFinSep_M : FiniteDimensional K M ∧ Algebra.IsSeparable K M := by
      obtain ⟨I, hFinI, M_i, hFieldMi, hAlgMi, Φ, hFinSepMi⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod.{u, u} K E_ten).mp inferInstance
      letI : ∀ i, Field (M_i i) := hFieldMi
      letI : ∀ i, Algebra K (M_i i) := hAlgMi
      have hOneNeZero : (1 : ∀ i : I, M_i i) ≠ 0 := fun h10 =>
        one_ne_zero (by rw [← map_one Φ.symm, h10, map_zero])
      obtain ⟨i₀, _⟩ := Function.ne_iff.mp hOneNeZero
      have hUnique : ∀ j : I, j = i₀ := by
        intro j
        by_contra hj
        let e₁ : ∀ i : I, M_i i := fun i => if i = i₀ then 1 else 0
        let e₂ : ∀ i : I, M_i i := fun i => if i = j then 1 else 0
        have hprod : e₁ * e₂ = 0 := by
          ext i
          change (if i = i₀ then (1 : M_i i) else 0) * (if i = j then 1 else 0) = 0
          by_cases hi : i = i₀
          · subst hi
            simp [Ne.symm hj]
          · simp [hi]
        have hprod_E : Φ.symm e₁ * Φ.symm e₂ = 0 := by
          rw [← map_mul, hprod, map_zero]
        rcases mul_eq_zero.mp hprod_E with h1 | h2
        · have he₁ : e₁ = 0 := Φ.symm.injective (h1.trans (map_zero Φ.symm).symm)
          have : (1 : M_i i₀) = 0 := by simpa [e₁] using congrFun he₁ i₀
          exact one_ne_zero this
        · have he₂ : e₂ = 0 := Φ.symm.injective (h2.trans (map_zero Φ.symm).symm)
          have : (1 : M_i j) = 0 := by simpa [e₂] using congrFun he₂ j
          exact one_ne_zero this
      let ev_i₀ : (∀ i : I, M_i i) ≃ₐ[K] M_i i₀ :=
        AlgEquiv.ofBijective (Pi.evalAlgHom K M_i i₀)
          ⟨fun x y hxy => funext fun j => by
             cases hUnique j
             exact hxy,
           fun m => ⟨fun j => if hj : j = i₀ then hj.symm ▸ m else False.elim (hj (hUnique j)),
             by change (if hj : i₀ = i₀ then hj.symm ▸ m else _) = m; simp⟩⟩
      let Θ₀ : M_i i₀ ≃ₐ[K] E_ten := ev_i₀.symm.trans Φ.symm
      let ξ : M_i i₀ →ₐ[K] M := Ψ_K.comp Θ₀.toAlgHom
      have hξ_surj : Function.Surjective ξ := by
        intro m
        obtain ⟨⟨c, s⟩, hms⟩ := IsLocalization.surj (nonZeroDivisors C) m
        let xc : M_i i₀ := Θ₀.symm (TensorProduct.tmul A 1 c)
        let xs : M_i i₀ := Θ₀.symm (TensorProduct.tmul A 1 s.1)
        have hξ_c : ξ xc = algebraMap C M c := by
          dsimp [ξ, xc]
          rw [Θ₀.apply_symm_apply]
          change Ψ_A (TensorProduct.tmul A 1 c) = _
          rw [hΨ_tmul, map_one, one_mul]
        have hξ_s : ξ xs = algebraMap C M s.1 := by
          dsimp [ξ, xs]
          rw [Θ₀.apply_symm_apply]
          change Ψ_A (TensorProduct.tmul A 1 s.1) = _
          rw [hΨ_tmul, map_one, one_mul]
        have hs_M_ne : algebraMap C M s.1 ≠ 0 := by
          intro h0
          exact nonZeroDivisors.ne_zero s.2
            (IsFractionRing.injective C M (h0.trans (map_zero _).symm))
        have hxs_ne : xs ≠ 0 := fun h0 => hs_M_ne (by rw [← hξ_s, h0, map_zero])
        refine ⟨xc * xs⁻¹, ?_⟩
        rw [map_mul, map_inv₀, hξ_c, hξ_s, ← hms, mul_assoc, mul_inv_cancel₀ hs_M_ne, mul_one]
      let Ξ : M_i i₀ ≃ₐ[K] M := AlgEquiv.ofBijective ξ ⟨ξ.toRingHom.injective, hξ_surj⟩
      obtain ⟨hFin_i₀, hSep_i₀⟩ := hFinSepMi i₀
      have _ : Module.Finite K (M_i i₀) := hFin_i₀
      have _ : Algebra.IsSeparable K (M_i i₀) := hSep_i₀
      exact ⟨Module.Finite.equiv Ξ.toLinearEquiv,
        Algebra.IsSeparable.of_equiv_equiv (RingEquiv.refl K) Ξ.toRingEquiv
          (RingHom.ext fun k => (Ξ.commutes k).symm)⟩
    have _ : FiniteDimensional K M := hFinSep_M.1
    have _ : Algebra.IsSeparable K M := hFinSep_M.2
    let ι_M : M →ₐ[K] AlgebraicClosure K := IsAlgClosed.lift
    obtain ⟨θ_prim, hθ_prim⟩ := Field.exists_primitive_element K M
    let g := minpoly K θ_prim
    have hg_monic : g.Monic := minpoly.monic (Algebra.IsIntegral.isIntegral θ_prim)
    have hg_ne : g ≠ 0 := hg_monic.ne_zero
    have hg_sep : g.Separable := Algebra.IsSeparable.isSeparable K θ_prim
    let L_M : IntermediateField K (AlgebraicClosure K) :=
      IntermediateField.adjoin K (g.rootSet (AlgebraicClosure K))
    have hg_splits : (Polynomial.map (algebraMap K (AlgebraicClosure K)) g).Splits :=
      IsAlgClosed.splits _
    have _ : Polynomial.IsSplittingField K ↥L_M g :=
      IntermediateField.adjoin_rootSet_isSplittingField hg_splits
    have _ : FiniteDimensional K ↥L_M := Polynomial.IsSplittingField.finiteDimensional ↥L_M g
    have _ : IsGalois K ↥L_M := IsGalois.of_separable_splitting_field hg_sep
    have hι_mem_LM : ∀ m : M, ι_M m ∈ L_M := by
      have haeval_θ : Polynomial.aeval (ι_M θ_prim) g = 0 := by
        rw [Polynomial.aeval_algHom_apply, minpoly.aeval K θ_prim, map_zero]
      have hθ_in_root : ι_M θ_prim ∈ g.rootSet (AlgebraicClosure K) :=
        (Polynomial.mem_rootSet_of_ne hg_ne).mpr haeval_θ
      have hθ_in_LM : ι_M θ_prim ∈ L_M :=
        IntermediateField.subset_adjoin K (g.rootSet (AlgebraicClosure K)) hθ_in_root
      have hle_comap : (⊤ : IntermediateField K M) ≤ L_M.comap ι_M := by
        rw [← hθ_prim, IntermediateField.adjoin_le_iff]
        rintro x rfl
        exact hθ_in_LM
      intro m
      exact hle_comap IntermediateField.mem_top
    let L₁ : IntermediateField K (AlgebraicClosure K) := E₀ ⊔ L_M
    exact ⟨instAlgKM, hTowerAKM, hFinSep_M.1, hFinSep_M.2,
      L₁, IntermediateField.finiteDimensional_sup E₀ L_M, inferInstance, le_sup_left,
      ⟨{ toFun := fun m => ⟨ι_M m, (le_sup_right : L_M ≤ L₁) (hι_mem_LM m)⟩
         map_one' := Subtype.ext (map_one ι_M)
         map_mul' := fun x y => Subtype.ext (map_mul ι_M x y)
         map_zero' := Subtype.ext (map_zero ι_M)
         map_add' := fun x y => Subtype.ext (map_add ι_M x y)
         commutes' := fun k => Subtype.ext (ι_M.commutes k) }⟩⟩

  
  have hPillar2b : ∀ (K C E₁ : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
      [CommRing C] [IsDomain C] [Algebra A C]
      [Algebra K (FractionRing C)] [IsScalarTower A K (FractionRing C)]
      [FiniteDimensional K (FractionRing C)] [Algebra.IsSeparable K (FractionRing C)]
      [Field E₁] [Algebra K E₁] [Algebra A E₁] [IsScalarTower A K E₁]
      (p : Ideal A), p ≠ ⊥ →
      ∀ (Q_C : Ideal C) [Q_C.IsPrime],
        Ideal.comap (algebraMap A C) Q_C = p →
        IsIntegrallyClosed (Localization.AtPrime Q_C) →
        (FractionRing C →ₐ[K] E₁) →
        ∃ (φ_C : C →ₐ[A] E₁) (Q₁_star : Ideal ↥(integralClosure A E₁)),
          Q₁_star.IsPrime ∧
          Ideal.comap (algebraMap A ↥(integralClosure A E₁)) Q₁_star = p ∧
          ∀ c : C, ∃ (a s : ↥(integralClosure A E₁)),
            s ∉ Q₁_star ∧ φ_C c * (s : E₁) = (a : E₁) := by
    classical
    intro K C E₁ _ _ _ _ _ _ _ _ _ _ _ _ _ _ p hp_ne Q_C _ hQC hIC ι_M1
    let M := FractionRing C
    have hAM_inj : Function.Injective (algebraMap A M) := by
      rw [IsScalarTower.algebraMap_eq A K M]
      exact (algebraMap K M).injective.comp (IsFractionRing.injective A K)
    have hι_M1_A : ∀ a : A, ι_M1 (algebraMap A M a) = algebraMap A E₁ a := fun a => by
      rw [IsScalarTower.algebraMap_apply A K M a, ι_M1.commutes,
        ← IsScalarTower.algebraMap_apply A K E₁ a]
    let φ_C : C →ₐ[A] E₁ :=
      { (ι_M1.toRingHom.comp (algebraMap C M)) with
        commutes' := fun a => by
          change ι_M1 (algebraMap C M (algebraMap A C a)) = algebraMap A E₁ a
          rw [← IsScalarTower.algebraMap_apply A C M a, hι_M1_A] }
    let V := Localization.AtPrime Q_C
    have hQC_le_nzd : Q_C.primeCompl ≤ nonZeroDivisors C := fun x hx =>
      mem_nonZeroDivisors_iff_ne_zero.mpr fun h0 => hx (h0 ▸ Q_C.zero_mem)
    have : IsDomain V := IsLocalization.isDomain_localization hQC_le_nzd
    have _ : IsIntegrallyClosed V := hIC
    let O_M := ↥(integralClosure A M)
    have : IsDedekindDomain O_M := integralClosure.isDedekindDomain A K M
    have : IsFractionRing O_M M := integralClosure.isFractionRing_of_finite_extension K M
    obtain ⟨κ_VM, hκ_VM_eq, hκ_VM_inj, j_OMV, hj_OMV_spec⟩ :
        ∃ (κ : V →+* M),
          (∀ c : C, κ (algebraMap C V c) = algebraMap C M c) ∧
          Function.Injective κ ∧
          ∃ (j : O_M →+* V), ∀ x : O_M, κ (j x) = (x : M) := by
      have hV_units : ∀ u : Q_C.primeCompl, IsUnit (algebraMap C M u.1) := fun u =>
        IsUnit.mk0 _ fun h0 =>
          nonZeroDivisors.ne_zero (hQC_le_nzd u.2)
            (IsFractionRing.injective C M (h0.trans (map_zero _).symm))
      let κ : V →+* M := IsLocalization.lift (g := algebraMap C M) hV_units
      have hκ_eq : ∀ c : C, κ (algebraMap C V c) = algebraMap C M c :=
        IsLocalization.lift_eq (g := algebraMap C M) hV_units
      let instVM : Algebra V M := κ.toAlgebra
      have : IsScalarTower C V M := IsScalarTower.of_algebraMap_eq fun c => (hκ_eq c).symm
      have : IsScalarTower A V M := IsScalarTower.of_algebraMap_eq fun a => by
        rw [IsScalarTower.algebraMap_apply A C V a, ← IsScalarTower.algebraMap_apply C V M,
          ← IsScalarTower.algebraMap_apply A C M]
      have : IsFractionRing V M :=
        IsFractionRing.isFractionRing_of_isDomain_of_isLocalization Q_C.primeCompl V M
      have hκ_inj : Function.Injective κ := IsFractionRing.injective V M
      have hj_ex : ∀ x : O_M, ∃ v : V, κ v = (x : M) := fun x =>
        IsIntegrallyClosed.isIntegral_iff.mp (IsIntegral.tower_top (A := V) x.2)
      refine ⟨κ, hκ_eq, hκ_inj, {
        toFun := fun x => Classical.choose (hj_ex x)
        map_one' := hκ_inj (by rw [Classical.choose_spec (hj_ex 1), map_one]; rfl)
        map_mul' := fun x y => hκ_inj (by
          rw [Classical.choose_spec (hj_ex (x * y)), map_mul,
            Classical.choose_spec (hj_ex x), Classical.choose_spec (hj_ex y)]; rfl)
        map_zero' := hκ_inj (by rw [Classical.choose_spec (hj_ex 0), map_zero]; rfl)
        map_add' := fun x y => hκ_inj (by
          rw [Classical.choose_spec (hj_ex (x + y)), map_add,
            Classical.choose_spec (hj_ex x), Classical.choose_spec (hj_ex y)]; rfl)
      }, fun x => Classical.choose_spec (hj_ex x)⟩
    have hj_OMV_A : ∀ a : A, j_OMV (algebraMap A O_M a) = algebraMap A V a := fun a =>
      hκ_VM_inj (by
        rw [hj_OMV_spec, IsScalarTower.algebraMap_apply A C V a, hκ_VM_eq,
          ← IsScalarTower.algebraMap_apply A C M]
        rfl)
    let mV := IsLocalRing.maximalIdeal V
    let P_M : Ideal O_M := Ideal.comap j_OMV mV
    have hPM_prime : P_M.IsPrime := Ideal.comap_isPrime j_OMV mV
    have hPM_over_p : Ideal.comap (algebraMap A O_M) P_M = p := by
      ext a
      change j_OMV (algebraMap A O_M a) ∈ mV ↔ a ∈ p
      rw [hj_OMV_A a, IsScalarTower.algebraMap_apply A C V a]
      have h_under : Ideal.comap (algebraMap C V) mV = Q_C :=
        Localization.AtPrime.under_maximalIdeal (I := Q_C)
      change algebraMap A C a ∈ Ideal.comap (algebraMap C V) mV ↔ a ∈ p
      rw [h_under, ← hQC]
      rfl
    have hPM_ne : P_M ≠ ⊥ := by
      intro hbot
      obtain ⟨a, ha_p, ha_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hp_ne
      have ha_PM : algebraMap A O_M a ∈ P_M := by
        rw [← hPM_over_p] at ha_p
        exact ha_p
      rw [hbot, Ideal.mem_bot] at ha_PM
      have ha_M : algebraMap A M a = 0 := congrArg Subtype.val ha_PM
      exact ha_ne (hAM_inj (ha_M.trans (map_zero _).symm))
    let W := Localization.AtPrime P_M
    have hPM_le_nzd : P_M.primeCompl ≤ nonZeroDivisors O_M := fun x hx =>
      mem_nonZeroDivisors_iff_ne_zero.mpr fun h0 => hx (h0 ▸ P_M.zero_mem)
    have : IsDomain W := IsLocalization.isDomain_localization hPM_le_nzd
    have : IsDiscreteValuationRing W :=
      IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain O_M hPM_ne W
    have : ValuationRing W := of_isDiscreteValuationRing W
    obtain ⟨κ_WM, hκ_WM_eq, θ_WV, hθ_WV_eq⟩ :
        ∃ (κ_W : W →+* M),
          (∀ x : O_M, κ_W (algebraMap O_M W x) = (x : M)) ∧
          ∃ (θ : W →+* V), ∀ x : O_M, θ (algebraMap O_M W x) = j_OMV x := by
      have hW_units_M : ∀ u : P_M.primeCompl, IsUnit ((integralClosure A M).val.toRingHom u.1) :=
        fun u => IsUnit.mk0 _ fun h0 =>
          nonZeroDivisors.ne_zero (hPM_le_nzd u.2) (Subtype.ext h0)
      have hW_units_V : ∀ u : P_M.primeCompl, IsUnit (j_OMV u.1) := fun u =>
        IsLocalRing.notMem_maximalIdeal.mp u.2
      exact ⟨IsLocalization.lift (g := (integralClosure A M).val.toRingHom) hW_units_M,
        IsLocalization.lift_eq (g := (integralClosure A M).val.toRingHom) hW_units_M,
        IsLocalization.lift (g := j_OMV) hW_units_V,
        IsLocalization.lift_eq (g := j_OMV) hW_units_V⟩
    have hθ_compat : κ_VM.comp θ_WV = κ_WM := by
      apply IsLocalization.ringHom_ext P_M.primeCompl
      ext x
      simp only [RingHom.comp_apply, hθ_WV_eq, hj_OMV_spec, hκ_WM_eq]
    have hθ_mW : ∀ w ∈ IsLocalRing.maximalIdeal W, θ_WV w ∈ mV := by
      have hmW_eq : IsLocalRing.maximalIdeal W = Ideal.map (algebraMap O_M W) P_M :=
        (Localization.AtPrime.map_eq_maximalIdeal (I := P_M)).symm
      have hmap_le : Ideal.map θ_WV (IsLocalRing.maximalIdeal W) ≤ mV := by
        rw [hmW_eq, Ideal.map_map]
        have hcomp : θ_WV.comp (algebraMap O_M W) = j_OMV := RingHom.ext hθ_WV_eq
        rw [hcomp]
        exact Ideal.map_comap_le
      intro w hw
      exact hmap_le (Ideal.mem_map_of_mem θ_WV hw)
    have hθ_surj : Function.Surjective θ_WV := by
      let instWM : Algebra W M := κ_WM.toAlgebra
      have : IsScalarTower O_M W M := IsScalarTower.of_algebraMap_eq fun x => (hκ_WM_eq x).symm
      have : IsFractionRing W M :=
        IsFractionRing.isFractionRing_of_isDomain_of_isLocalization P_M.primeCompl W M
      intro v
      let m : M := κ_VM v
      rcases ValuationRing.isInteger_or_isInteger W m with ⟨w, hw⟩ | ⟨w', hw'⟩
      · refine ⟨w, hκ_VM_inj ?_⟩
        have h1 := RingHom.congr_fun hθ_compat w
        exact h1.trans hw
      · by_cases hm0 : m = 0
        · refine ⟨0, hκ_VM_inj ?_⟩
          rw [map_zero θ_WV, map_zero κ_VM]
          exact hm0.symm
        · have hvw' : v * θ_WV w' = 1 := hκ_VM_inj (by
            rw [map_mul, map_one]
            have h1 := RingHom.congr_fun hθ_compat w'
            change m * (κ_VM.comp θ_WV) w' = 1
            rw [h1]
            change m * algebraMap W M w' = 1
            rw [hw', mul_inv_cancel₀ hm0])
          have hw'_not_mW : w' ∉ IsLocalRing.maximalIdeal W := by
            intro hmem
            have h1_mem : (1 : V) ∈ mV := by
              rw [← hvw']
              exact mV.mul_mem_left v (hθ_mW w' hmem)
            exact (Ideal.IsPrime.ne_top inferInstance) ((Ideal.eq_top_iff_one mV).mpr h1_mem)
          obtain ⟨uw, rfl⟩ := IsLocalRing.notMem_maximalIdeal.mp hw'_not_mW
          refine ⟨↑uw⁻¹, ?_⟩
          calc θ_WV ↑uw⁻¹
              = (v * θ_WV ↑uw) * θ_WV ↑uw⁻¹ := by rw [hvw', one_mul]
            _ = v * θ_WV (↑uw * ↑uw⁻¹) := by rw [mul_assoc, ← map_mul]
            _ = v := by rw [Units.mul_inv, map_one, mul_one]
    let B₁ := ↥(integralClosure A E₁)
    let f_M1 : M →+* E₁ := ι_M1.toRingHom
    have hMapInt : ∀ x : M, IsIntegral A x → IsIntegral A (f_M1 x) := by
      rintro x ⟨P, hP_mon, hP_ev⟩
      refine ⟨P, hP_mon, ?_⟩
      have hcomp : f_M1.comp (algebraMap A M) = algebraMap A E₁ :=
        RingHom.ext hι_M1_A
      rw [← hcomp, ← Polynomial.hom_eval₂, hP_ev, map_zero]
    let j_M1 : O_M →+* B₁ :=
      { toFun := fun x => ⟨f_M1 x.1, hMapInt x.1 x.2⟩
        map_one' := Subtype.ext (map_one f_M1)
        map_mul' := fun x y => Subtype.ext (map_mul f_M1 x.1 y.1)
        map_zero' := Subtype.ext (map_zero f_M1)
        map_add' := fun x y => Subtype.ext (map_add f_M1 x.1 y.1) }
    have hj_M1_inj : Function.Injective j_M1 := by
      intro x y hxy
      exact Subtype.ext (ι_M1.toRingHom.injective (congrArg Subtype.val hxy))
    obtain ⟨Q₁_star, hQ₁_star_prime, hQ₁_star_over_PM⟩ :
        ∃ Q : Ideal B₁, Q.IsPrime ∧ Ideal.comap j_M1 Q = P_M := by
      let instOMB₁ : Algebra O_M B₁ := j_M1.toAlgebra
      have : IsScalarTower A O_M B₁ := IsScalarTower.of_algebraMap_eq fun a =>
        Subtype.ext (hι_M1_A a).symm
      have : Algebra.IsIntegral A B₁ := ⟨fun y => Algebra.IsIntegral.isIntegral (R := A) y⟩
      have : Algebra.IsIntegral O_M B₁ := Algebra.IsIntegral.tower_top A
      have hker_le : RingHom.ker (algebraMap O_M B₁) ≤ P_M := by
        intro x hx
        have hx0 : x = 0 := hj_M1_inj (hx.trans (map_zero j_M1).symm)
        rw [hx0]
        exact P_M.zero_mem
      exact Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain P_M hker_le
    have hQ₁_star_comap : Ideal.comap (algebraMap A B₁) Q₁_star = p := by
      have hcomp : j_M1.comp (algebraMap A O_M) = algebraMap A B₁ :=
        RingHom.ext fun a => Subtype.ext (hι_M1_A a)
      rw [← hcomp, ← Ideal.comap_comap, hQ₁_star_over_PM, hPM_over_p]
    refine ⟨φ_C, Q₁_star, hQ₁_star_prime, hQ₁_star_comap, ?_⟩
    intro c
    obtain ⟨w_c, hw_c⟩ := hθ_surj (algebraMap C V c)
    obtain ⟨⟨a₀, s₀⟩, hws⟩ := IsLocalization.surj P_M.primeCompl w_c
    have hcM_eq : algebraMap C M c * (s₀.1 : M) = (a₀ : M) := by
      have h1 := congrArg κ_WM hws
      rw [map_mul, hκ_WM_eq s₀.1, hκ_WM_eq a₀, ← hθ_compat, RingHom.comp_apply, hw_c,
        hκ_VM_eq c] at h1
      exact h1
    refine ⟨j_M1 a₀, j_M1 s₀.1, ?_, ?_⟩
    · intro hs_mem
      have : s₀.1 ∈ Ideal.comap j_M1 Q₁_star := hs_mem
      rw [hQ₁_star_over_PM] at this
      exact s₀.2 this
    · change ι_M1 (algebraMap C M c) * ι_M1 (s₀.1 : M) = ι_M1 (a₀ : M)
      rw [← map_mul, hcM_eq]

  
  have hPillar3 : ∀ (C B L : Type u) [CommRing C] [Algebra A C] [Algebra.Etale A C]
      [CommRing B] [IsDomain B] [Algebra A B]
      [Field L] [Algebra A L]
      (j_BL : B →ₐ[A] L), Function.Injective j_BL →
      ∀ (Q : Ideal B) [Q.IsPrime]
        (φ₁ φ₂ : C →ₐ[A] L),
        (∀ c : C, ∃ (a₁ s₁ a₂ s₂ : B),
          s₁ ∉ Q ∧ s₂ ∉ Q ∧
          φ₁ c * j_BL s₁ = j_BL a₁ ∧
          φ₂ c * j_BL s₂ = j_BL a₂ ∧
          a₁ * s₂ - a₂ * s₁ ∈ Q) →
        ∀ c : C, φ₁ c = φ₂ c := by
    classical
    intro C B L _ _ _ _ _ _ _ _ j_BL hj_inj Q _ φ₁ φ₂ hCong
    let R_star := Localization.AtPrime Q
    have hQ_le_nzd : Q.primeCompl ≤ nonZeroDivisors B := fun x hx =>
      mem_nonZeroDivisors_iff_ne_zero.mpr fun h0 => hx (h0 ▸ Q.zero_mem)
    have : IsDomain R_star := IsLocalization.isDomain_localization hQ_le_nzd
    have h_units_L : ∀ u : Q.primeCompl, IsUnit (j_BL u.1) := fun u =>
      IsUnit.mk0 _ fun h0 =>
        nonZeroDivisors.ne_zero (hQ_le_nzd u.2)
          (hj_inj (h0.trans (map_zero j_BL).symm))
    let ι_R_ring : R_star →+* L := IsLocalization.lift (g := j_BL.toRingHom) h_units_L
    let ι_R : R_star →ₐ[A] L :=
      { ι_R_ring with
        commutes' := fun a => by
          change ι_R_ring (algebraMap B R_star (algebraMap A B a)) = algebraMap A L a
          rw [IsLocalization.lift_eq (g := j_BL.toRingHom) h_units_L]
          exact j_BL.commutes a }
    have hι_R_inj : Function.Injective ι_R := by
      rw [injective_iff_map_eq_zero]
      intro r hr
      obtain ⟨⟨b, u⟩, hru⟩ := IsLocalization.surj Q.primeCompl r
      have hb0 : j_BL b = 0 := by
        have h1 := congrArg ι_R hru
        rw [map_mul, hr, zero_mul] at h1
        change 0 = ι_R_ring (algebraMap B R_star b) at h1
        rw [IsLocalization.lift_eq (g := j_BL.toRingHom) h_units_L] at h1
        exact h1.symm
      have hb_eq : b = 0 := hj_inj (hb0.trans (map_zero j_BL).symm)
      rw [hb_eq, map_zero] at hru
      exact (IsLocalization.map_units R_star u).mul_left_eq_zero.mp hru
    have hLift_hom : ∀ (φ : C →ₐ[A] L),
        (∀ c : C, ∃ a s : B, s ∉ Q ∧ φ c * j_BL s = j_BL a) →
        ∃ α : C →ₐ[A] R_star, ∀ c : C, ι_R (α c) = φ c := by
      intro φ hφ
      let u_fn : C → Q.primeCompl := fun c =>
        ⟨_, (Classical.choose_spec (Classical.choose_spec (hφ c))).1⟩
      let fn : C → R_star := fun c =>
        algebraMap B R_star (Classical.choose (hφ c)) *
          ↑(IsLocalization.map_units R_star (u_fn c)).unit⁻¹
      have hfn : ∀ c : C, ι_R (fn c) = φ c := by
        intro c
        let a := Classical.choose (hφ c)
        let s : B := (u_fn c).1
        have h_eq : φ c * j_BL s = j_BL a :=
          (Classical.choose_spec (Classical.choose_spec (hφ c))).2
        let uR := (IsLocalization.map_units R_star (u_fn c)).unit
        have hjs_ne : j_BL s ≠ 0 := (h_units_L (u_fn c)).ne_zero
        apply mul_right_cancel₀ hjs_ne
        have h_inv_mul : ι_R (fn c) * j_BL s = j_BL a := by
          have hs_lift : j_BL s = ι_R (algebraMap B R_star s) :=
            (IsLocalization.lift_eq (g := j_BL.toRingHom) h_units_L s).symm
          have ha_lift : j_BL a = ι_R (algebraMap B R_star a) :=
            (IsLocalization.lift_eq (g := j_BL.toRingHom) h_units_L a).symm
          rw [hs_lift, ha_lift, ← map_mul]
          congr 1
          change algebraMap B R_star a * ↑uR⁻¹ * ↑uR = algebraMap B R_star a
          rw [mul_assoc, Units.inv_mul, mul_one]
        exact h_inv_mul.trans h_eq.symm
      refine ⟨{
        toFun := fn
        map_one' := hι_R_inj (by rw [hfn, map_one, map_one])
        map_mul' := fun x y => hι_R_inj (by rw [hfn, map_mul, map_mul, hfn, hfn])
        map_zero' := hι_R_inj (by rw [hfn, map_zero, map_zero])
        map_add' := fun x y => hι_R_inj (by rw [hfn, map_add, map_add, hfn, hfn])
        commutes' := fun a => hι_R_inj (by rw [hfn, ι_R.commutes, φ.commutes])
      }, hfn⟩
    obtain ⟨α₁, hα₁⟩ := hLift_hom φ₁ (fun c =>
      let ⟨a₁, s₁, _, _, hs₁, _, h1, _, _⟩ := hCong c; ⟨a₁, s₁, hs₁, h1⟩)
    obtain ⟨α₂, hα₂⟩ := hLift_hom φ₂ (fun c =>
      let ⟨_, _, a₂, s₂, _, hs₂, _, h2, _⟩ := hCong c; ⟨a₂, s₂, hs₂, h2⟩)
    let mR := IsLocalRing.maximalIdeal R_star
    have hα_mod : ∀ c : C, α₁ c - α₂ c ∈ mR := by
      intro c
      obtain ⟨a₁, s₁, a₂, s₂, hs₁, hs₂, h1, h2, hdiff⟩ := hCong c
      have hα₁_s : α₁ c * algebraMap B R_star s₁ = algebraMap B R_star a₁ := hι_R_inj (by
        rw [map_mul, hα₁]
        change φ₁ c * ι_R_ring (algebraMap B R_star s₁) = ι_R_ring (algebraMap B R_star a₁)
        rw [IsLocalization.lift_eq (g := j_BL.toRingHom) h_units_L,
          IsLocalization.lift_eq (g := j_BL.toRingHom) h_units_L]
        exact h1)
      have hα₂_s : α₂ c * algebraMap B R_star s₂ = algebraMap B R_star a₂ := hι_R_inj (by
        rw [map_mul, hα₂]
        change φ₂ c * ι_R_ring (algebraMap B R_star s₂) = ι_R_ring (algebraMap B R_star a₂)
        rw [IsLocalization.lift_eq (g := j_BL.toRingHom) h_units_L,
          IsLocalization.lift_eq (g := j_BL.toRingHom) h_units_L]
        exact h2)
      have h_cross : (α₁ c - α₂ c) * algebraMap B R_star (s₁ * s₂) =
          algebraMap B R_star (a₁ * s₂ - a₂ * s₁) := by
        rw [map_mul, map_sub, map_mul, map_mul]
        calc (α₁ c - α₂ c) * (algebraMap B R_star s₁ * algebraMap B R_star s₂)
            = (α₁ c * algebraMap B R_star s₁) * algebraMap B R_star s₂ -
              (α₂ c * algebraMap B R_star s₂) * algebraMap B R_star s₁ := by ring
          _ = algebraMap B R_star a₁ * algebraMap B R_star s₂ -
              algebraMap B R_star a₂ * algebraMap B R_star s₁ := by rw [hα₁_s, hα₂_s]
      have hmR_eq : Ideal.map (algebraMap B R_star) Q = mR :=
        Localization.AtPrime.map_eq_maximalIdeal (I := Q)
      have hrhs_mem : algebraMap B R_star (a₁ * s₂ - a₂ * s₁) ∈ mR := by
        rw [← hmR_eq]
        exact Ideal.mem_map_of_mem _ hdiff
      rw [← h_cross] at hrhs_mem
      have hs12_not : s₁ * s₂ ∈ Q.primeCompl := Q.primeCompl.mul_mem hs₁ hs₂
      obtain ⟨u12, hu12⟩ := IsLocalization.map_units R_star ⟨s₁ * s₂, hs12_not⟩
      have hmem_mul := mR.mul_mem_right (↑u12⁻¹ : R_star) hrhs_mem
      rwa [← hu12, mul_assoc, Units.mul_inv, mul_one] at hmem_mul
    let T := TensorProduct A C C
    let μ_A : T →ₐ[A] C :=
      Algebra.TensorProduct.lift (AlgHom.id A C) (AlgHom.id A C) (fun _ _ => mul_comm _ _)
    have hμ_tmul : ∀ x y : C, μ_A (TensorProduct.tmul A x y) = x * y := fun x y =>
      Algebra.TensorProduct.lift_tmul _ _ _ x y
    let μ_diag : T →ₐ[C] C :=
      { μ_A.toRingHom with
        commutes' := fun c => by
          change μ_A (TensorProduct.tmul A c 1) = c
          rw [hμ_tmul, mul_one] }
    have hμ_surj : Function.Surjective μ_diag := fun c =>
      ⟨TensorProduct.tmul A c 1, by change μ_A (TensorProduct.tmul A c 1) = c; rw [hμ_tmul, mul_one]⟩
    have hIdemp_ker : ∃ e_Δ : T, IsIdempotentElem e_Δ ∧
        RingHom.ker μ_diag.toRingHom = Ideal.span {e_Δ} := by
      let instTC : Algebra T C := μ_diag.toRingHom.toAlgebra
      have : IsScalarTower C T C := IsScalarTower.of_algebraMap_eq fun c =>
        (μ_diag.commutes c).symm
      have : Algebra.Etale T C := Algebra.Etale.of_restrictScalars C T C
      have hIdemp_I : IsIdempotentElem (RingHom.ker (algebraMap T C)) :=
        (Algebra.FormallyEtale.iff_of_surjective hμ_surj).mp inferInstance
      have hFG_I : (RingHom.ker μ_diag.toRingHom).FG :=
        Algebra.FinitePresentation.ker_fG_of_surjective μ_diag hμ_surj
      exact (Ideal.isIdempotentElem_iff_of_fg (RingHom.ker μ_diag.toRingHom) hFG_I).mp hIdemp_I
    obtain ⟨e_Δ, he_idemp, hker_span⟩ := hIdemp_ker
    let Φ : T →ₐ[A] R_star :=
      Algebra.TensorProduct.lift α₁ α₂ (fun _ _ => mul_comm _ _)
    have hΦ_tmul : ∀ x y : C, Φ (TensorProduct.tmul A x y) = α₁ x * α₂ y := fun x y =>
      Algebra.TensorProduct.lift_tmul _ _ _ x y
    have hq_eq : (Ideal.Quotient.mk mR).comp Φ.toRingHom =
        (Ideal.Quotient.mk mR).comp (α₁.toRingHom.comp μ_diag.toRingHom) := by
      apply RingHom.ext
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul x y =>
        change Ideal.Quotient.mk mR (Φ (TensorProduct.tmul A x y)) =
          Ideal.Quotient.mk mR (α₁ (μ_A (TensorProduct.tmul A x y)))
        rw [hΦ_tmul, hμ_tmul, map_mul α₁, map_mul, map_mul]
        congr 1
        exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem (α₂ y) (α₁ y)).mpr
          (by simpa [neg_sub] using mR.neg_mem (hα_mod y))
      | add x y ihx ihy =>
        simp only [RingHom.comp_apply, map_add] at *
        rw [ihx, ihy]
    have he_ker : μ_diag e_Δ = 0 := by
      change e_Δ ∈ RingHom.ker μ_diag.toRingHom
      rw [hker_span]
      exact Ideal.mem_span_singleton_self e_Δ
    have hΦe_mem : Φ e_Δ ∈ mR := by
      have h1 := RingHom.congr_fun hq_eq e_Δ
      change Ideal.Quotient.mk mR (Φ e_Δ) = Ideal.Quotient.mk mR (α₁ (μ_diag e_Δ)) at h1
      rw [he_ker, map_zero, map_zero] at h1
      exact Ideal.Quotient.eq_zero_iff_mem.mp h1
    have hΦe_idemp : IsIdempotentElem (Φ e_Δ) := by
      change Φ e_Δ * Φ e_Δ = Φ e_Δ
      rw [← map_mul, he_idemp]
    have hΦe_zero : Φ e_Δ = 0 := by
      rcases IsIdempotentElem.iff_eq_zero_or_one.mp hΦe_idemp with h0 | h1
      · exact h0
      · exfalso
        rw [h1] at hΦe_mem
        exact (Ideal.IsPrime.ne_top inferInstance) ((Ideal.eq_top_iff_one mR).mpr hΦe_mem)
    intro c
    have hzc_ker : TensorProduct.tmul A c 1 - TensorProduct.tmul A 1 c ∈
        RingHom.ker μ_diag.toRingHom := by
      change μ_A (TensorProduct.tmul A c 1 - TensorProduct.tmul A 1 c) = 0
      rw [map_sub, hμ_tmul, hμ_tmul, mul_one, one_mul, sub_self]
    rw [hker_span, Ideal.mem_span_singleton] at hzc_ker
    obtain ⟨w, hw⟩ := hzc_ker
    have hα_eq : α₁ c - α₂ c = 0 := by
      calc α₁ c - α₂ c
          = Φ (TensorProduct.tmul A c 1 - TensorProduct.tmul A 1 c) := by
              rw [map_sub, hΦ_tmul, hΦ_tmul, map_one, map_one, mul_one, one_mul]
        _ = Φ (e_Δ * w) := by rw [hw]
        _ = Φ e_Δ * Φ w := map_mul Φ e_Δ w
        _ = 0 := by rw [hΦe_zero, zero_mul]
    rw [← hα₁ c, ← hα₂ c, sub_eq_zero.mp hα_eq]

  
  have hPillar4a : ∀ (K C E₁ : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
      [CommRing C] [Algebra A C] [Algebra.Etale A C]
      [Field E₁] [Algebra K E₁] [Algebra A E₁] [IsScalarTower A K E₁]
      [FiniteDimensional K E₁] [IsGalois K E₁]
      (p : Ideal A) (φ_C : C →ₐ[A] E₁)
      (Q₁_star : Ideal ↥(integralClosure A E₁)),
      Q₁_star.IsPrime →
      Ideal.comap (algebraMap A ↥(integralClosure A E₁)) Q₁_star = p →
      (∀ c : C, ∃ (a s : ↥(integralClosure A E₁)),
        s ∉ Q₁_star ∧ φ_C c * (s : E₁) = (a : E₁)) →
      ∀ (Q₁ : Ideal ↥(integralClosure A E₁)), Q₁.IsPrime →
        Ideal.comap (algebraMap A ↥(integralClosure A E₁)) Q₁ = p →
        ∀ (σ : E₁ ≃ₐ[K] E₁),
          (∀ y : ↥(integralClosure A E₁),
            σ (y : E₁) - (y : E₁) ∈ Subtype.val '' (Q₁ : Set ↥(integralClosure A E₁))) →
          ∃ γ : E₁ ≃ₐ[K] E₁, ∀ c : C, (γ⁻¹ * σ * γ) (φ_C c) = φ_C c := by
    intro K C E₁ _ _ _ _ _ _ _ _ _ _ _ _ p φ_C Q₁_star hQ₁_star_prime hQ₁_star_comap hPole
      Q₁ hQ₁_prime hQ₁_comap σ hσ
    let B₁ := ↥(integralClosure A E₁)
    let G := E₁ ≃ₐ[K] E₁
    have _ : IsFractionRing B₁ E₁ := integralClosure.isFractionRing_of_finite_extension K E₁
    have _ : IsGaloisGroup G A B₁ := IsGaloisGroup.of_isFractionRing G A B₁ K E₁
    have _ : Q₁_star.IsPrime := hQ₁_star_prime
    have _ : Q₁.IsPrime := hQ₁_prime
    have _ : Q₁_star.LiesOver p := (Ideal.liesOver_iff Q₁_star p).mpr hQ₁_star_comap.symm
    have _ : Q₁.LiesOver p := (Ideal.liesOver_iff Q₁ p).mpr hQ₁_comap.symm
    obtain ⟨γ, hγ_Q⟩ := Ideal.exists_smul_eq_of_isGaloisGroup p Q₁_star Q₁ G
    let τ : G := γ⁻¹ * σ * γ
    have hτ_inert : ∀ y : B₁, τ • y - y ∈ Q₁_star := by
      intro y
      obtain ⟨w, hw_Q₁, hw_eq⟩ := hσ (γ • y)
      have hw_smul : w ∈ Q₁ := hw_Q₁
      rw [← hγ_Q, Ideal.mem_pointwise_smul_iff_inv_smul_mem] at hw_smul
      have h_eq_sub : τ • y - y = γ⁻¹ • w := by
        apply Subtype.ext
        change τ (y : E₁) - (y : E₁) = γ⁻¹ (w : E₁)
        rw [hw_eq]
        change (γ⁻¹ * σ * γ) (y : E₁) - (y : E₁) = γ⁻¹ (σ (γ (y : E₁)) - γ (y : E₁))
        rw [map_sub, AlgEquiv.mul_apply, AlgEquiv.mul_apply]
        have h_inv : γ⁻¹ (γ (y : E₁)) = (y : E₁) := by
          change (γ⁻¹ * γ) (y : E₁) = (y : E₁)
          rw [inv_mul_cancel, AlgEquiv.one_apply]
        rw [h_inv]
      rwa [h_eq_sub]
    let j_BL : B₁ →ₐ[A] E₁ := (integralClosure A E₁).val
    let φ₂ : C →ₐ[A] E₁ :=
      { (τ.toAlgHom.toRingHom.comp φ_C.toRingHom) with
        commutes' := fun a => by
          change τ (φ_C (algebraMap A C a)) = algebraMap A E₁ a
          rw [φ_C.commutes, IsScalarTower.algebraMap_apply A K E₁ a, τ.commutes] }
    have h_rig := hPillar3 C B₁ E₁ j_BL Subtype.val_injective Q₁_star φ_C φ₂ (fun c => by
      obtain ⟨a_c, s_c, hs_c, h_eq⟩ := hPole c
      have hs₂_not : τ • s_c ∉ Q₁_star := by
        intro hmem
        apply hs_c
        have hsub := Q₁_star.sub_mem hmem (hτ_inert s_c)
        rwa [sub_sub_cancel] at hsub
      have h2_eq : φ₂ c * j_BL (τ • s_c) = j_BL (τ • a_c) := by
        change τ (φ_C c) * τ (s_c : E₁) = τ (a_c : E₁)
        rw [← map_mul, h_eq]
      have hdiff_mem : a_c * (τ • s_c) - (τ • a_c) * s_c ∈ Q₁_star := by
        have h_ident : a_c * (τ • s_c) - (τ • a_c) * s_c =
            a_c * (τ • s_c - s_c) - (τ • a_c - a_c) * s_c := by ring
        rw [h_ident]
        exact Q₁_star.sub_mem (Q₁_star.mul_mem_left a_c (hτ_inert s_c))
          (Q₁_star.mul_mem_right s_c (hτ_inert a_c))
      exact ⟨a_c, s_c, τ • a_c, τ • s_c, hs_c, hs₂_not, h_eq, h2_eq, hdiff_mem⟩)
    exact ⟨γ, fun c => (h_rig c).symm⟩

  
  refine ⟨fun D _ _ _ Q _ => (hPillar1 D Q).1, ?_⟩
  intro K _ _ _ p _ hp_ne C _ _ _ _ Q_C _ hQC E₀ _ _
  have hIC_QC : IsIntegrallyClosed (Localization.AtPrime Q_C) :=
    (hPillar1 C Q_C).2 (hQC ▸ hp_ne)
  obtain ⟨instKM, hTowerAKM, hFD_M, hSep_M, L₁, hFD₁, hGal₁, hle, ⟨ι_M1⟩⟩ :=
    hPillar2a K C E₀
  let instAlgKM_top : Algebra K (FractionRing C) := instKM
  have _ : IsScalarTower A K (FractionRing C) := hTowerAKM
  have _ : FiniteDimensional K (FractionRing C) := hFD_M
  have _ : Algebra.IsSeparable K (FractionRing C) := hSep_M
  have _ : FiniteDimensional K ↥L₁ := hFD₁
  have _ : IsGalois K ↥L₁ := hGal₁
  refine ⟨L₁, hFD₁, hGal₁, hle, ?_⟩
  let instAlgAL₁_top : Algebra A ↥L₁ := ((algebraMap K ↥L₁).comp (algebraMap A K)).toAlgebra
  have : IsScalarTower A K ↥L₁ := IsScalarTower.of_algebraMap_eq fun _ => rfl
  obtain ⟨φ_C, Q₁_star, hQ₁_star_prime, hQ₁_star_comap, hPole⟩ :=
    hPillar2b K C ↥L₁ p hp_ne Q_C hQC hIC_QC ι_M1
  exact ⟨φ_C, hPillar4a K C ↥L₁ p φ_C Q₁_star hQ₁_star_prime hQ₁_star_comap hPole⟩

