    have hBezout₀ : ∑ s : Fin r, g₀_poly s * R₀ s = J_mat₀.det * h₀_poly - 1 := by
      have hsub : (∑ s : Fin r, g₀_poly s * R₀ s) - (J_mat₀.det * h₀_poly - 1) = 0 := by
        rw [← hΔ₀]
        dsimp [Δ₁, g₀_poly, R₀, h₀_poly]
