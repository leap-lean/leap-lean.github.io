      σ ∈ Γ_geom r → (τ_rep r σ).val ∈ H_mat_r r := by
    intro r σ hσ
    obtain ⟨h, hh, hval⟩ := hImH r σ hσ
    exact ⟨h, hh, hval.symm⟩
  have hH_to_Γ : ∀ (r : ℕ) (M_h : Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1)))),
      M_h ∈ H_mat_r r → ∃ σ ∈ Γ_geom r, (τ_rep r σ).val = M_h := by
