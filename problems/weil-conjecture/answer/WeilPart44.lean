      have hw_ne : w ≠ 0 := by
        intro hw0; rw [hw0, zero_pow hℓ_ne] at hw_pow; exact u.ne_zero hw_pow.symm
      let v : k_barˣ := Units.mk0 w hw_ne
      have hv_pow : v ^ ℓ = u := by
        ext; simpa [v, Units.val_pow_eq_pow_val] using hw_pow
      have hw_prim : IsPrimitiveRoot w (ℓ ^ (s + 2)) := by
        refine IsPrimitiveRoot.mk ?_ ?_
        · have hexp : ℓ ^ (s + 2) = ℓ * ℓ ^ (s + 1) := by ring
          rw [hexp, pow_mul, hw_pow]; exact hu.pow_eq_one
        · intro m_exp hm_exp
          have hexp2 : ℓ ^ (s + 2) = ℓ * ℓ ^ (s + 1) := by ring
          have hw_top : w ^ (ℓ ^ (s + 2)) = 1 := by
