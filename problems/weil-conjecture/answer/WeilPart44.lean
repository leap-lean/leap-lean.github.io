                CategoryTheory.Limits.pullback.snd h₁ ι_V →
              ∀ (s : ↑(ℱ₀.obj.obj (Opposite.op W₂)))
                (y₁ : ↥(CategoryTheory.Limits.pullback h₁ ι_V)),
                triv_F₀ W₁ ((ℱ₀.obj.map (Opposite.op u)).hom s) y₁ = triv_F₀ W₂ s (u_V.base y₁)) →
          (∀ W : S.Etale,
            let h_W := ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).hom
            let ι_V : Quiver.Hom V S := CategoryTheory.CategoryStruct.comp π U.ι
            let W_V := CategoryTheory.Limits.pullback h_W ι_V
            Function.Injective (triv_F₀ W) ∧
            Set.range (triv_F₀ W) =
              { f |
                (∃ W₀ : ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left.Opens,
                  ((TopologicalSpace.Opens.map h_W.base).obj U) ⊔ W₀ = ⊤ ∧
                  ∀ y : ↥W_V,
                    (CategoryTheory.Limits.pullback.fst h_W ι_V).base y ∈ W₀ → f y = 0) ∧
                (∀ (g : Γ) (m_g : Quiver.Hom W_V W_V),
                  CategoryTheory.CategoryStruct.comp m_g (CategoryTheory.Limits.pullback.fst h_W ι_V) =
                    CategoryTheory.Limits.pullback.fst h_W ι_V →
                  CategoryTheory.CategoryStruct.comp m_g (CategoryTheory.Limits.pullback.snd h_W ι_V) =
                    CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd h_W ι_V)
                      (act g) →
                  ∀ y : ↥W_V, f (m_g.base y) = M_act₀ g (f y)) }) →
          ∀ i : ℕ, Finite (ℱ₀.H i)),
      ∀ i : ℕ, Finite (CategoryTheory.Abelian.Ext.{u} (weilEtaleModuleUnit S m) 𝒥 i) := by
    clear h_s7_s8 hFinOfConst h_s9 hPair triv ι_ext ℳ 𝒥 τ_rep hGal act π V h_et_V hUnit hm M m U
    intro S U m M hm V π act τ_rep 𝒥 ℳ ι_ext triv hPair hAbFin
    have hasSheafCompose_of_adj : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u} C]
        (J₀ : CategoryTheory.GrothendieckTopology C) {A B : Type (u + 1)}
        [CategoryTheory.Category.{u} A] [CategoryTheory.Category.{u} B]
        {L : B ⥤ A} {F : A ⥤ B} (_ : L ⊣ F), J₀.HasSheafCompose F := by
      intro C _ J₀ A B _ _ L F adj
      refine { isSheaf := fun P hP E => ?_ }
      let isoE : (P ⋙ F) ⋙ CategoryTheory.coyoneda.obj (Opposite.op E) ≅
          P ⋙ CategoryTheory.coyoneda.obj (Opposite.op (L.obj E)) :=
        CategoryTheory.NatIso.ofComponents
          (fun W => (adj.homEquiv E (P.obj W)).symm.toIso)
          (fun {W₁ W₂} u => by
            ext g
            exact CategoryTheory.Adjunction.homEquiv_naturality_right_symm adj g (P.map u))
      exact CategoryTheory.Presieve.isSheaf_iso J₀ isoE.symm (hP (L.obj E))

    let sheafComposeAdjRight : ∀ {C : Type (u + 1)} [Category.{u} C]
        (J₀ : GrothendieckTopology C) {A B : Type (u + 1)} [Category.{u} A] [Category.{u} B]
        {F : A ⥤ B} {G : B ⥤ A} (adj : F ⊣ G) [J₀.HasSheafCompose F] [J₀.HasSheafCompose G],
        sheafCompose J₀ F ⊣ sheafCompose J₀ G := fun {C} _ J₀ {A B} _ _ {F G} adj _ _ =>
      let liftEquiv (P : Cᵒᵖ ⥤ A) (Q : Cᵒᵖ ⥤ B) : (P ⋙ F ⟶ Q) ≃ (P ⟶ Q ⋙ G) :=
        { toFun := fun φ =>
            { app := fun W => adj.homEquiv (P.obj W) (Q.obj W) (φ.app W)
              naturality := fun {W₁ W₂} u => by
                have hnat : F.map (P.map u) ≫ φ.app W₂ = φ.app W₁ ≫ Q.map u := φ.naturality u
                change P.map u ≫ adj.homEquiv (P.obj W₂) (Q.obj W₂) (φ.app W₂) =
                  adj.homEquiv (P.obj W₁) (Q.obj W₁) (φ.app W₁) ≫ G.map (Q.map u)
                rw [← Adjunction.homEquiv_naturality_right adj, ← hnat,
                  ← Adjunction.homEquiv_naturality_left adj] }
          invFun := fun ψ =>
            { app := fun W => (adj.homEquiv (P.obj W) (Q.obj W)).symm (ψ.app W)
              naturality := fun {W₁ W₂} u => by
                have hnat : P.map u ≫ ψ.app W₂ = ψ.app W₁ ≫ G.map (Q.map u) := ψ.naturality u
                change F.map (P.map u) ≫ (adj.homEquiv (P.obj W₂) (Q.obj W₂)).symm (ψ.app W₂) =
                  (adj.homEquiv (P.obj W₁) (Q.obj W₁)).symm (ψ.app W₁) ≫ Q.map u
                rw [← Adjunction.homEquiv_naturality_left_symm adj, hnat,
                  ← Adjunction.homEquiv_naturality_right_symm adj] }
          left_inv := fun φ => by ext W; exact (adj.homEquiv _ _).symm_apply_apply _
          right_inv := fun ψ => by ext W; exact (adj.homEquiv _ _).apply_symm_apply _ }
      Adjunction.mkOfHomEquiv
        { homEquiv := fun ℱ 𝒢 =>
            { toFun := fun φ => ⟨liftEquiv ℱ.obj 𝒢.obj φ.hom⟩
              invFun := fun ψ => ⟨(liftEquiv ℱ.obj 𝒢.obj).symm ψ.hom⟩
              left_inv := fun φ => by ext1; exact (liftEquiv ℱ.obj 𝒢.obj).symm_apply_apply φ.hom
              right_inv := fun ψ => by ext1; exact (liftEquiv ℱ.obj 𝒢.obj).apply_symm_apply ψ.hom }
          homEquiv_naturality_left_symm := fun {ℱ' ℱ 𝒢} h ψ => by
            ext W
            exact Adjunction.homEquiv_naturality_left_symm adj (h.hom.app W) (ψ.hom.app W)
          homEquiv_naturality_right := fun {ℱ 𝒢 𝒢'} φ k => by
            ext W
            exact Adjunction.homEquiv_naturality_right adj (φ.hom.app W) (k.hom.app W) }

    let sheafComposeAdjLeft : ∀ {C : Type (u + 1)} [Category.{u} C]
        (J₀ : GrothendieckTopology C) {A B : Type (u + 1)} [Category.{u} A] [Category.{u} B]
        {L : B ⥤ A} {F : A ⥤ B} (adj : L ⊣ F) [J₀.HasSheafCompose F] [HasWeakSheafify J₀ A],
        (sheafToPresheaf J₀ B ⋙
            { obj := fun P => P ⋙ L
              map := fun f => Functor.whiskerRight f L } ⋙
            presheafToSheaf J₀ A) ⊣
          sheafCompose J₀ F := fun {C} _ J₀ {A B} _ _ {L F} adj _ _ =>
      let liftTo (P : Cᵒᵖ ⥤ B) (Q : Cᵒᵖ ⥤ A) (φ : P ⋙ L ⟶ Q) : P ⟶ Q ⋙ F :=
        { app := fun W => adj.homEquiv (P.obj W) (Q.obj W) (φ.app W)
          naturality := fun {W₁ W₂} u => by
            have hnat : L.map (P.map u) ≫ φ.app W₂ = φ.app W₁ ≫ Q.map u := φ.naturality u
            change P.map u ≫ adj.homEquiv (P.obj W₂) (Q.obj W₂) (φ.app W₂) =
              adj.homEquiv (P.obj W₁) (Q.obj W₁) (φ.app W₁) ≫ F.map (Q.map u)
            rw [← Adjunction.homEquiv_naturality_right adj, ← hnat,
              ← Adjunction.homEquiv_naturality_left adj] }
      let liftInv (P : Cᵒᵖ ⥤ B) (Q : Cᵒᵖ ⥤ A) (ψ : P ⟶ Q ⋙ F) : P ⋙ L ⟶ Q :=
        { app := fun W => (adj.homEquiv (P.obj W) (Q.obj W)).symm (ψ.app W)
          naturality := fun {W₁ W₂} u => by
            have hnat : P.map u ≫ ψ.app W₂ = ψ.app W₁ ≫ F.map (Q.map u) := ψ.naturality u
            change L.map (P.map u) ≫ (adj.homEquiv (P.obj W₂) (Q.obj W₂)).symm (ψ.app W₂) =
              (adj.homEquiv (P.obj W₁) (Q.obj W₁)).symm (ψ.app W₁) ≫ Q.map u
            rw [← Adjunction.homEquiv_naturality_left_symm adj, hnat,
              ← Adjunction.homEquiv_naturality_right_symm adj] }
      Adjunction.mkOfHomEquiv
        { homEquiv := fun 𝒢 ℱ =>
            { toFun := fun φ =>
                ⟨liftTo 𝒢.obj ℱ.obj ((sheafificationAdjunction J₀ A).homEquiv (𝒢.obj ⋙ L) ℱ φ)⟩
              invFun := fun ψ =>
                ((sheafificationAdjunction J₀ A).homEquiv (𝒢.obj ⋙ L) ℱ).symm
                  (liftInv 𝒢.obj ℱ.obj ψ.hom)
              left_inv := fun φ => by
                have h : liftInv 𝒢.obj ℱ.obj
                    (liftTo 𝒢.obj ℱ.obj ((sheafificationAdjunction J₀ A).homEquiv (𝒢.obj ⋙ L) ℱ φ)) =
                    (sheafificationAdjunction J₀ A).homEquiv (𝒢.obj ⋙ L) ℱ φ := by
                  ext W
                  exact (adj.homEquiv _ _).symm_apply_apply _
                exact (congrArg ((sheafificationAdjunction J₀ A).homEquiv (𝒢.obj ⋙ L) ℱ).symm h).trans
                  (Equiv.symm_apply_apply _ φ)
              right_inv := fun ψ => by
                ext W
                have h := Equiv.apply_symm_apply
                  ((sheafificationAdjunction J₀ A).homEquiv (𝒢.obj ⋙ L) ℱ)
                  (liftInv 𝒢.obj ℱ.obj ψ.hom)
                have hW := congrArg (fun α => α.app W) h
                exact (congrArg (adj.homEquiv (𝒢.obj.obj W) (ℱ.obj.obj W)) hW).trans
                  ((adj.homEquiv _ _).apply_symm_apply (ψ.hom.app W)) }
          homEquiv_naturality_left_symm := fun {𝒢' 𝒢 ℱ} h ψ => by
            have h1 : liftInv 𝒢'.obj ℱ.obj ((h ≫ ψ).hom) =
                Functor.whiskerRight h.hom L ≫ liftInv 𝒢.obj ℱ.obj ψ.hom := by
              ext W
              exact Adjunction.homEquiv_naturality_left_symm adj (h.hom.app W) (ψ.hom.app W)
            exact (congrArg ((sheafificationAdjunction J₀ A).homEquiv (𝒢'.obj ⋙ L) ℱ).symm h1).trans
              (Adjunction.homEquiv_naturality_left_symm
                (sheafificationAdjunction J₀ A) (Functor.whiskerRight h.hom L)
                (liftInv 𝒢.obj ℱ.obj ψ.hom))
          homEquiv_naturality_right := fun {𝒢 ℱ ℱ'} φ k => by
            ext W
            have h1 := Adjunction.homEquiv_naturality_right (sheafificationAdjunction J₀ A) φ k
            have h1W := congrArg (fun α => α.app W) h1
            exact (congrArg (adj.homEquiv (𝒢.obj.obj W) (ℱ'.obj.obj W)) h1W).trans
              (Adjunction.homEquiv_naturality_right adj _ (k.hom.app W)) }

    have sheaf_eq_of_obj_eq : ∀ {C : Type (u + 1)} [Category.{u} C] {J₀ : GrothendieckTopology C}
        {A : Type (u + 1)} [Category.{u} A] {ℱ₁ ℱ₂ : Sheaf J₀ A},
        ℱ₁.obj = ℱ₂.obj → ℱ₁ = ℱ₂ := by
      intro C _ J₀ A _ ℱ₁ ℱ₂ h
      rcases ℱ₁ with ⟨o₁, p₁⟩
      rcases ℱ₂ with ⟨o₂, p₂⟩
      change o₁ = o₂ at h
      subst h
      rfl

    have ext_vanish_of_effaceable :
        ∀ {D : Type (u + 1)} [Category.{u + 1} D] [Abelian D] [HasExt.{u} D] [EnoughInjectives D]
          (T_pred : D → Prop),
          (∀ {K' P : D} (ι : K' ⟶ P) [Mono ι], T_pred P → T_pred K') →
          (∀ E : D, ∃ (P : D) (q : P ⟶ E), T_pred P ∧ Epi q) →
          ∀ (Y : D),
            (∀ (SC : ShortComplex D), SC.ShortExact → T_pred SC.X₃ →
              ∀ (g₀ : SC.X₁ ⟶ Y), ∃ h : SC.X₂ ⟶ Y, SC.f ≫ h = g₀) →
            ∀ (p : ℕ) {K : D}, T_pred K → ∀ (e : Abelian.Ext K Y (p + 1)), e = 0 := by
      intro D _ _ _ _ T_pred hSub hCover Y hExt
      let R_Y := InjectiveResolution.of Y
      have hPull : ∀ (q : ℕ) (K : D) (f : K ⟶ R_Y.cocomplex.X (q + 1))
          (_ : f ≫ R_Y.cocomplex.d (q + 1) (q + 2) = 0),
          ∃ (P : D) (π : P ⟶ K) (g : P ⟶ R_Y.cocomplex.X q),
            T_pred P ∧ Epi π ∧ g ≫ R_Y.cocomplex.d q (q + 1) = π ≫ f := by
        intro q K f hf
        let SC_q : ShortComplex D :=
          ShortComplex.mk (R_Y.cocomplex.d q (q + 1)) (R_Y.cocomplex.d (q + 1) (q + 2))
            (R_Y.cocomplex.d_comp_d q (q + 1) (q + 2))
        have hEx_q : SC_q.Exact := R_Y.exact_succ q
        have : Epi SC_q.toCycles := (ShortComplex.exact_iff_epi_toCycles SC_q).mp hEx_q
        let f_cyc : K ⟶ SC_q.cycles := SC_q.liftCycles f hf
        let E_pb := Limits.pullback SC_q.toCycles f_cyc
        let p_pb : E_pb ⟶ K := Limits.pullback.snd SC_q.toCycles f_cyc
        have : Epi p_pb := Abelian.epi_pullback_of_epi_f SC_q.toCycles f_cyc
        let g_pb : E_pb ⟶ R_Y.cocomplex.X q := Limits.pullback.fst SC_q.toCycles f_cyc
        obtain ⟨P, q_P, hTP, hEpi_q⟩ := hCover E_pb
        refine ⟨P, q_P ≫ p_pb, q_P ≫ g_pb, hTP, epi_comp q_P p_pb, ?_⟩
        change (q_P ≫ g_pb) ≫ SC_q.f = (q_P ≫ p_pb) ≫ f
        rw [← SC_q.toCycles_i, Category.assoc, ← Category.assoc g_pb, Limits.pullback.condition,
          Category.assoc, SC_q.liftCycles_i, Category.assoc]
      intro p
      induction p with
      | zero =>
        intro K hTK e
        obtain ⟨f, hf, rfl⟩ := R_Y.extMk_surjective e 2 rfl
        obtain ⟨P, π, g, hTP, hEpi_π, hg⟩ := hPull 0 K f hf
        let ι := Limits.kernel.ι π
        let S_π : ShortComplex D := ShortComplex.mk ι π (Limits.kernel.condition π)
        have hS_π : S_π.ShortExact := { exact := ShortComplex.exact_kernel π }
        have h_ig : (ι ≫ g) ≫ R_Y.cocomplex.d 0 1 = 0 := by
          rw [Category.assoc, hg, ← Category.assoc, Limits.kernel.condition, Limits.zero_comp]
        have : Mono (R_Y.ι.f 0) := inferInstance
        let ι₀ : Y ⟶ R_Y.cocomplex.X 0 := R_Y.ι.f 0
        let getZero {SC : ShortComplex D} (_ : SC.Exact) : SC.f ≫ SC.g = 0 := SC.zero
        have hι₀_d : ι₀ ≫ R_Y.cocomplex.d 0 1 = 0 := getZero R_Y.exact₀
        let g₀ : Limits.kernel π ⟶ Y :=
          (R_Y.exact₀).fIsKernel.lift (Limits.KernelFork.ofι (ι ≫ g) h_ig)
        have hg₀ : g₀ ≫ ι₀ = ι ≫ g :=
          (R_Y.exact₀).fIsKernel.fac (Limits.KernelFork.ofι (ι ≫ g) h_ig)
            Limits.WalkingParallelPair.zero
        obtain ⟨h, hh⟩ := hExt S_π hS_π hTK g₀
        have h_sub_ker : ι ≫ (g - h ≫ ι₀) = 0 := by
          rw [Preadditive.comp_sub, ← Category.assoc]
          change ι ≫ g - (S_π.f ≫ h) ≫ ι₀ = 0
          rw [hh, hg₀, sub_self]
        let s : K ⟶ R_Y.cocomplex.X 0 :=
          hS_π.exact.gIsCokernel.desc (Limits.CokernelCofork.ofπ (g - h ≫ ι₀) h_sub_ker)
        have hs : π ≫ s = g - h ≫ ι₀ :=
          hS_π.exact.gIsCokernel.fac (Limits.CokernelCofork.ofπ (g - h ≫ ι₀) h_sub_ker)
            Limits.WalkingParallelPair.one
        have hs_d : s ≫ R_Y.cocomplex.d 0 1 = f := by
          apply (cancel_epi π).mp
          rw [← Category.assoc, hs, Preadditive.sub_comp, hg, Category.assoc, hι₀_d,
            Limits.comp_zero, sub_zero]
        exact (R_Y.extMk_eq_zero_iff f 2 rfl hf 0 rfl).mpr ⟨s, hs_d⟩
      | succ p' ih =>
        intro K hTK e
        obtain ⟨f, hf, rfl⟩ := R_Y.extMk_surjective e (p' + 3) rfl
        obtain ⟨P, π, g, hTP, hEpi_π, hg⟩ := hPull (p' + 1) K f hf
        have h_pull_zero :
            (Abelian.Ext.mk₀ π).comp (R_Y.extMk f (p' + 3) rfl hf) (Nat.zero_add (p' + 2)) = 0 := by
          rw [R_Y.mk₀_comp_extMk]
          exact (R_Y.extMk_eq_zero_iff (π ≫ f) (p' + 3) rfl _ (p' + 1) rfl).mpr ⟨g, hg⟩
        let ι := Limits.kernel.ι π
        let S_π : ShortComplex D := ShortComplex.mk ι π (Limits.kernel.condition π)
        have hS_π : S_π.ShortExact := { exact := ShortComplex.exact_kernel π }
        obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS_π Y
          (R_Y.extMk f (p' + 3) rfl hf) h_pull_zero (Nat.add_comm 1 (p' + 1))
        rw [← hx₁, ih (hSub ι hTP) x₁, Abelian.Ext.comp_zero]

    have ext_comparison_bijective_of_acyclic :
        ∀ {A D : Type (u + 1)} [Category.{u + 1} A] [Abelian A] [HasExt.{u} A] [EnoughInjectives A]
          [Category.{u + 1} D] [Abelian D] [HasExt.{u} D]
          (U_ex : A ⥤ D) [U_ex.Additive] [Limits.PreservesFiniteLimits U_ex]
          [Limits.PreservesFiniteColimits U_ex]
          (X₀ : A) (Z₀ : D) (η : Z₀ ⟶ U_ex.obj X₀),
          (∀ ℱ : A, Function.Bijective (fun x : Abelian.Ext X₀ ℱ 0 =>
            (Abelian.Ext.mk₀ η).comp (Abelian.Ext.mapExactFunctor U_ex x) (Nat.zero_add 0))) →
          (∀ (ℐ : A) [Injective ℐ] (p : ℕ) (e : Abelian.Ext Z₀ (U_ex.obj ℐ) (p + 1)), e = 0) →
          ∀ (k : ℕ) (ℱ : A), Function.Bijective (fun x : Abelian.Ext X₀ ℱ k =>
            (Abelian.Ext.mk₀ η).comp (Abelian.Ext.mapExactFunctor U_ex x) (Nat.zero_add k)) := by
      intro A D _ _ _ _ _ _ _ U_ex _ _ _ X₀ Z₀ η hBase hAcyc
      let Θ (ℱ : A) (k : ℕ) : Abelian.Ext X₀ ℱ k →+ Abelian.Ext Z₀ (U_ex.obj ℱ) k :=
        ((Abelian.Ext.mk₀ η).precomp (U_ex.obj ℱ) (Nat.zero_add k)).comp (U_ex.mapExtAddHom X₀ ℱ k)
      change ∀ (k : ℕ) (ℱ : A), Function.Bijective (Θ ℱ k)
      intro k
      induction k with
      | zero => exact hBase
      | succ k ih =>
        intro ℱ
        let ℐ := Injective.under ℱ
        let i_ℱ : ℱ ⟶ ℐ := Injective.ι ℱ
        let Q := Limits.cokernel i_ℱ
        let p_ℱ : ℐ ⟶ Q := Limits.cokernel.π i_ℱ
        let S_ℱ : ShortComplex A := ShortComplex.mk i_ℱ p_ℱ (Limits.cokernel.condition i_ℱ)
        have hS_ℱ : S_ℱ.ShortExact := { exact := ShortComplex.exact_cokernel i_ℱ }
        have hUS_ℱ : (S_ℱ.map U_ex).ShortExact := hS_ℱ.map_of_exact U_ex
        have hΘ_p : ∀ y : Abelian.Ext X₀ ℐ k,
            Θ Q k (y.comp (Abelian.Ext.mk₀ S_ℱ.g) (Nat.add_zero k)) =
              (Θ ℐ k y).comp (Abelian.Ext.mk₀ (S_ℱ.map U_ex).g) (Nat.add_zero k) := by
          intro y
          change (Abelian.Ext.mk₀ η).comp
              (Abelian.Ext.mapExactFunctor U_ex (y.comp (Abelian.Ext.mk₀ S_ℱ.g) (Nat.add_zero k)))
              (Nat.zero_add k) =
            ((Abelian.Ext.mk₀ η).comp (Abelian.Ext.mapExactFunctor U_ex y) (Nat.zero_add k)).comp
              (Abelian.Ext.mk₀ (U_ex.map S_ℱ.g)) (Nat.add_zero k)
          rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
            Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ η) (Abelian.Ext.mapExactFunctor U_ex y)
              (Abelian.Ext.mk₀ (U_ex.map S_ℱ.g)) (Nat.zero_add k) (Nat.add_zero k) (Nat.zero_add k)]
        have hΘ_δ : ∀ z : Abelian.Ext X₀ Q k,
            Θ ℱ (k + 1) (z.comp hS_ℱ.extClass rfl) =
              (Θ Q k z).comp hUS_ℱ.extClass rfl := by
          intro z
          change (Abelian.Ext.mk₀ η).comp
              (Abelian.Ext.mapExactFunctor U_ex (z.comp hS_ℱ.extClass rfl))
              (Nat.zero_add (k + 1)) =
            ((Abelian.Ext.mk₀ η).comp (Abelian.Ext.mapExactFunctor U_ex z) (Nat.zero_add k)).comp
              hUS_ℱ.extClass rfl
          rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
            Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ η) (Abelian.Ext.mapExactFunctor U_ex z)
              hUS_ℱ.extClass (Nat.zero_add k) rfl (Nat.zero_add (k + 1))]
        refine ⟨?_, ?_⟩
        · rw [injective_iff_map_eq_zero]
          intro x hx
          have hx0 : x.comp (Abelian.Ext.mk₀ S_ℱ.f) (Nat.add_zero (k + 1)) = 0 := by
            have hIdim : HasInjectiveDimensionLT ℐ 1 := inferInstance
            exact (hasInjectiveDimensionLT_iff ℐ 1).mp hIdim (k + 1) (Nat.le_add_left 1 k) _
          obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X₀ hS_ℱ x hx0 rfl
          have hz0 : (Θ Q k z).comp hUS_ℱ.extClass rfl = 0 := by
            rw [← hΘ_δ z, hx]
          obtain ⟨y', hy'⟩ := Abelian.Ext.covariant_sequence_exact₃ Z₀ hUS_ℱ (Θ Q k z) rfl hz0
          obtain ⟨y, rfl⟩ := (ih ℐ).surjective y'
          have hz_eq : z = y.comp (Abelian.Ext.mk₀ S_ℱ.g) (Nat.add_zero k) :=
            (ih Q).injective ((hΘ_p y).trans hy').symm
          rw [hz_eq, Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ S_ℱ.g) hS_ℱ.extClass
            (Nat.add_zero k) (Nat.zero_add 1) rfl, hS_ℱ.comp_extClass, Abelian.Ext.comp_zero]
        · intro w
          have hw0 : w.comp (Abelian.Ext.mk₀ (S_ℱ.map U_ex).f) (Nat.add_zero (k + 1)) = 0 :=
            hAcyc ℐ k _
          obtain ⟨z', rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ Z₀ hUS_ℱ w hw0 rfl
          obtain ⟨z, rfl⟩ := (ih Q).surjective z'
          exact ⟨z.comp hS_ℱ.extClass rfl, hΘ_δ z⟩

    let R := ULift.{u, 0} (ZMod m)
    let J := S.smallEtaleTopology
    let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    let eZ : ModuleCat.{u, 0} ℤ ≌ AddCommGrpCat.{u} :=
      (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
    let adjModL : (eZ.inverse ⋙ ModuleCat.extendScalars (Int.castRingHom R)) ⊣ FgtMod :=
      eZ.symm.toAdjunction.comp (ModuleCat.extendRestrictScalarsAdj (Int.castRingHom R))
    let C_mod : AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R :=
      eZ.inverse ⋙ ModuleCat.coextendScalars (Int.castRingHom R)
    let adjModR : FgtMod ⊣ C_mod :=
      (ModuleCat.restrictCoextendScalarsAdj (Int.castRingHom R)).comp eZ.toAdjunction
    have hSC_fgt : J.HasSheafCompose FgtMod := hasSheafCompose_of_adj J adjModL
    have hSC_C : J.HasSheafCompose C_mod := hasSheafCompose_of_adj J adjModR
    let _ := hSC_fgt
    let _ := hSC_C
    let U_fgt : CategoryTheory.Sheaf J (ModuleCat.{u, u} R) ⥤
        CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
      CategoryTheory.sheafCompose J FgtMod
    have : U_fgt.Additive := { map_add := by intros; ext W x; rfl }
    have : U_fgt.IsLeftAdjoint := ⟨sheafCompose J C_mod, ⟨sheafComposeAdjRight J adjModR⟩⟩
    have : U_fgt.IsRightAdjoint := ⟨_, ⟨sheafComposeAdjLeft J adjModL⟩⟩
    have : Limits.PreservesFiniteLimits U_fgt := inferInstance
    have : Limits.PreservesFiniteColimits U_fgt := inferInstance
    have : IsGrothendieckAbelian.{u} (CategoryTheory.Sheaf J (ModuleCat.{u, u} R)) := inferInstance
    have : IsGrothendieckAbelian.{u} (CategoryTheory.Sheaf J AddCommGrpCat.{u}) := inferInstance
    have : HasExt.{u} (CategoryTheory.Sheaf J (ModuleCat.{u, u} R)) := inferInstance
    have : HasExt.{u} (CategoryTheory.Sheaf J AddCommGrpCat.{u}) := inferInstance
    have : EnoughInjectives (CategoryTheory.Sheaf J (ModuleCat.{u, u} R)) := inferInstance
    have : EnoughInjectives (CategoryTheory.Sheaf J AddCommGrpCat.{u}) := inferInstance

    let T_S : S.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : AlgebraicGeometry.Etale (𝟙 S))
    let hT_S : Limits.IsTerminal T_S :=
      let FgtFF := AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful S
      Limits.IsTerminal.ofUniqueHom
        (fun W => FgtFF.preimage
          (Over.mkIdTerminal.from ((AlgebraicGeometry.Scheme.Etale.forget S).obj W)))
        (fun W f => FgtFF.map_injective (Over.mkIdTerminal.hom_ext _ _))
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let R_mod := ModuleCat.of R R
    let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
    let oneR := weilEtaleModuleUnit S m
    let adjℤ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S
    let adjR := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) hT_S
    let ιℤ : Aℤ ⟶ FgtMod.obj R_mod :=
      (AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u} ℤ)) :
        Aℤ ⟶ AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ)) ≫
        (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (Int.castAddHom (ZMod m))) ≫
          AddCommGrpCat.ofHom (AddMonoidHom.id R))
    let u₀_unit : FgtMod.obj R_mod ⟶
        ((CategoryTheory.sheafSections J AddCommGrpCat.{u}).obj (Opposite.op T_S)).obj
          (U_fgt.obj oneR) :=
      FgtMod.map (adjR.unit.app R_mod)
    let ηℤ : Fℤ ⟶ U_fgt.obj oneR :=
      (adjℤ.homEquiv Aℤ (U_fgt.obj oneR)).symm (ιℤ ≫ u₀_unit)
    have h_ηℤ_eq : adjℤ.homEquiv Aℤ (U_fgt.obj oneR) ηℤ = ιℤ ≫ u₀_unit :=
      Equiv.apply_symm_apply _ _

    have hGenBij : ∀ (i : ℕ) (ℱ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)),
        Function.Bijective (fun x : Abelian.Ext oneR ℱ i =>
          (Abelian.Ext.mk₀ ηℤ).comp (Abelian.Ext.mapExactFunctor U_fgt x) (Nat.zero_add i)) := by
      have hBase : ∀ ℱ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R),
          Function.Bijective (fun x : Abelian.Ext oneR ℱ 0 =>
            (Abelian.Ext.mk₀ ηℤ).comp (Abelian.Ext.mapExactFunctor U_fgt x) (Nat.zero_add 0)) := by
        intro ℱ
        let A_sec : ModuleCat.{u, u} R := ℱ.obj.obj (Opposite.op T_S)
        let eR : (R_mod ⟶ A_sec) ≃ A_sec :=
          { toFun := fun ψ => ψ (1 : R)
            invFun := fun a => ModuleCat.ofHom (LinearMap.toSpanSingleton R A_sec a)
            left_inv := fun ψ => by
              apply ModuleCat.hom_ext
              apply LinearMap.ext
              intro r
              change r • ψ (1 : R) = ψ r
              rw [← map_smul, smul_eq_mul, mul_one]
            right_inv := fun a => one_smul R a }
        let eℤ : (Aℤ ⟶ FgtMod.obj A_sec) ≃ A_sec :=
          { toFun := fun g => g (ULift.up (1 : ℤ))
            invFun := fun a => AddCommGrpCat.ofHom
              { toFun := fun z => z.down • a
                map_zero' := zero_smul ℤ a
                map_add' := fun z₁ z₂ => add_smul z₁.down z₂.down a }
            left_inv := fun g => by
              ext ⟨z⟩
              change z • g (ULift.up (1 : ℤ)) = g (ULift.up z)
              rw [← map_zsmul]
              congr 1; ext; exact mul_one z
            right_inv := fun a => one_smul ℤ a }
        let eℤ' : (Aℤ ⟶ ((sheafSections J AddCommGrpCat.{u}).obj (Opposite.op T_S)).obj
            (U_fgt.obj ℱ)) ≃ A_sec := eℤ
        have h_hom_bij : Function.Bijective (fun φ : oneR ⟶ ℱ => ηℤ ≫ U_fgt.map φ) := by
          let eqDom : (oneR ⟶ ℱ) ≃ A_sec := (adjR.homEquiv R_mod ℱ).trans eR
          let eqCod : (Fℤ ⟶ U_fgt.obj ℱ) ≃ A_sec :=
            (adjℤ.homEquiv Aℤ (U_fgt.obj ℱ)).trans eℤ'
          have h_comm : ∀ φ : oneR ⟶ ℱ, eqCod (ηℤ ≫ U_fgt.map φ) = eqDom φ := by
            intro φ
            change eℤ' ((adjℤ.homEquiv Aℤ (U_fgt.obj ℱ)) (ηℤ ≫ U_fgt.map φ)) =
              eR ((adjR.homEquiv R_mod ℱ) φ)
            rw [Adjunction.homEquiv_naturality_right adjℤ ηℤ (U_fgt.map φ), h_ηℤ_eq]
            have h_adjR : adjR.homEquiv R_mod ℱ φ =
                adjR.unit.app R_mod ≫ φ.hom.app (Opposite.op T_S) :=
              Adjunction.homEquiv_unit adjR R_mod ℱ φ
            have h_rhs : ιℤ ≫ (FgtMod.map (adjR.unit.app R_mod) ≫
                FgtMod.map (φ.hom.app (Opposite.op T_S))) =
                ιℤ ≫ FgtMod.map (adjR.homEquiv R_mod ℱ φ) := by
              rw [← FgtMod.map_comp, h_adjR]
            have h_ev : eℤ' ((ιℤ ≫ u₀_unit) ≫
                ((sheafSections J AddCommGrpCat.{u}).obj (Opposite.op T_S)).map (U_fgt.map φ)) =
                eℤ (ιℤ ≫ FgtMod.map (adjR.homEquiv R_mod ℱ φ)) :=
              congrArg eℤ ((Category.assoc _ _ _).trans h_rhs)
            rw [h_ev]
            change (adjR.homEquiv R_mod ℱ φ) (ιℤ (ULift.up (1 : ℤ))) =
              (adjR.homEquiv R_mod ℱ φ) (1 : R)
            congr 1; ext; exact Int.cast_one
          have h_fn : (fun φ : oneR ⟶ ℱ => ηℤ ≫ U_fgt.map φ) = (eqCod.symm ∘ eqDom) := by
            funext φ
            exact eqCod.injective (by rw [Function.comp_apply, Equiv.apply_symm_apply, h_comm])
          rw [h_fn]
          exact eqCod.symm.bijective.comp eqDom.bijective
        let mk0Dom : (oneR ⟶ ℱ) ≃ Abelian.Ext oneR ℱ 0 :=
          Equiv.ofBijective Abelian.Ext.mk₀ (Abelian.Ext.mk₀_bijective oneR ℱ)
        let mk0Cod : (Fℤ ⟶ U_fgt.obj ℱ) ≃ Abelian.Ext Fℤ (U_fgt.obj ℱ) 0 :=
          Equiv.ofBijective Abelian.Ext.mk₀ (Abelian.Ext.mk₀_bijective Fℤ (U_fgt.obj ℱ))
        have h_ext0 : (fun x : Abelian.Ext oneR ℱ 0 =>
            (Abelian.Ext.mk₀ ηℤ).comp (Abelian.Ext.mapExactFunctor U_fgt x) (Nat.zero_add 0)) =
            (mk0Cod ∘ (fun φ => ηℤ ≫ U_fgt.map φ) ∘ mk0Dom.symm) := by
          funext x
          obtain ⟨φ, rfl⟩ := mk0Dom.surjective x
          have hsymm : mk0Dom.symm (mk0Dom φ) = φ := mk0Dom.symm_apply_apply φ
          dsimp only [Function.comp_apply]
          rw [hsymm]
          change (Abelian.Ext.mk₀ ηℤ).comp
              (Abelian.Ext.mapExactFunctor U_fgt (Abelian.Ext.mk₀ φ)) (Nat.zero_add 0) =
            Abelian.Ext.mk₀ (ηℤ ≫ U_fgt.map φ)
          rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀]
        rw [h_ext0]
        exact mk0Cod.bijective.comp (h_hom_bij.comp mk0Dom.symm.bijective)
      let isTF_cat {C : Type (u + 1)} [Category.{u + 1} C] [Preadditive C] (K : C) : Prop :=
        ∀ (n : ℕ), n ≠ 0 → Mono (n • 𝟙 K)
      have isTF_sub : ∀ {C : Type (u + 1)} [Category.{u + 1} C] [Preadditive C] {K' P : C}
          (ι : K' ⟶ P) [Mono ι], isTF_cat P → isTF_cat K' := by
        intro C _ _ K' P ι _ hP n hn
        have : Mono (n • 𝟙 P) := hP n hn
        have hcomm : (n • 𝟙 K') ≫ ι = ι ≫ (n • 𝟙 P) := by
          rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
        have : Mono ((n • 𝟙 K') ≫ ι) := by rw [hcomm]; exact mono_comp ι (n • 𝟙 P)
        exact mono_of_mono (n • 𝟙 K') ι
      have isTF_map : ∀ {A B : Type (u + 1)} [Category.{u + 1} A] [Preadditive A]
          [Category.{u + 1} B] [Preadditive B] (F : A ⥤ B) [F.Additive]
          [Limits.PreservesFiniteLimits F] {K : A}, isTF_cat K → isTF_cat (F.obj K) := by
        intro A B _ _ _ _ F _ _ K hK n hn
        have : Mono (n • 𝟙 K) := hK n hn
        have hmap : F.map (n • 𝟙 K) = n • 𝟙 (F.obj K) := by rw [F.map_nsmul, F.map_id]
        rw [← hmap]; exact F.map_mono (n • 𝟙 K)
      have hasColimOfGroth : ∀ (C : Type (u + 1)) [Category.{u + 1} C] [Abelian C]
          [IsGrothendieckAbelian.{u} C],
          Limits.HasColimitsOfSize.{0, u} C ∧ Limits.HasColimitsOfSize.{u, u} C ∧
            LocallySmall.{u} C :=
        fun C _ _ _ => ⟨Limits.hasColimitsOfSizeShrink C, Limits.hasColimitsOfSizeShrink C,
          inferInstance⟩
      let sigmaObjU {C : Type (u + 1)} [Category.{u + 1} C] [Limits.HasColimitsOfSize.{u, u} C]
          {ι : Type u} (X : ι → C) : C := Limits.sigmaObj X
      let sigmaDesc {C : Type (u + 1)} [Category.{u + 1} C] [Limits.HasColimitsOfSize.{u, u} C]
          {ι : Type u} {X : ι → C} {Z : C} (c : ∀ i, X i ⟶ Z) : sigmaObjU X ⟶ Z := Limits.Sigma.desc c
      let sigmaIota {C : Type (u + 1)} [Category.{u + 1} C] [Limits.HasColimitsOfSize.{u, u} C]
          {ι : Type u} (X : ι → C) (i : ι) : X i ⟶ sigmaObjU X := Limits.Sigma.ι X i
      have sigmaIotaDesc : ∀ {C : Type (u + 1)} [Category.{u + 1} C]
          [Limits.HasColimitsOfSize.{u, u} C] {ι : Type u} {X : ι → C} {Z : C}
          (c : ∀ i, X i ⟶ Z) (i : ι), sigmaIota X i ≫ sigmaDesc c = c i :=
        fun c i => Limits.Sigma.ι_comp_desc c i
      have isTF_sigma : ∀ {C : Type (u + 1)} [Category.{u + 1} C] [Abelian C]
          [IsGrothendieckAbelian.{u} C] [Limits.HasColimitsOfSize.{0, u} C]
          [Limits.HasColimitsOfSize.{u, u} C]
          {ι : Type u} (X : ι → C), (∀ i : ι, isTF_cat (X i)) → isTF_cat (sigmaObjU X) := by
        intro C _ _ _ _ _ ι X hX n hn
        have : AB4OfSize.{u} C := AB4OfSize_shrink C
        have : HasExactColimitsOfShape (Discrete ι) C := AB4OfSize.ofShape ι
        let D : Discrete ι ⥤ C := Discrete.functor X
        let φ : D ⟶ D := n • 𝟙 D
        have : ∀ j : Discrete ι, Mono (φ.app j) := fun ⟨i⟩ => hX i n hn
        have : Mono φ := NatTrans.mono_of_mono_app φ
        exact Limits.colim.map_mono' φ (Limits.colimit.isColimit D) (Limits.colimit.isColimit D)
          (n • 𝟙 (sigmaObjU X)) (fun ⟨i⟩ => by
            change sigmaIota X i ≫ (n • 𝟙 (sigmaObjU X)) = (n • 𝟙 (X i)) ≫ sigmaIota X i
            rw [Preadditive.comp_nsmul, Category.comp_id, Preadditive.nsmul_comp, Category.id_comp])
      have hMono_Aℤ : ∀ (n : ℕ), n ≠ 0 → Mono (n • 𝟙 Aℤ) := by
        intro n hn
        rw [AddCommGrpCat.mono_iff_injective]
        intro ⟨x⟩ ⟨y⟩ hxy
        have h' : (n : ℤ) * x = (n : ℤ) * y := by
          have hd := congrArg ULift.down hxy
          change n • x = n • y at hd
          rwa [nsmul_eq_mul, nsmul_eq_mul] at hd
        exact congrArg ULift.up (mul_left_cancel₀ (Nat.cast_ne_zero.mpr hn) h')
      have hTF_Fℤ : isTF_cat Fℤ := by
        intro n hn
        have : Mono (n • 𝟙 Aℤ) := hMono_Aℤ n hn
        let C_unf : AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
          (CategoryTheory.Functor.const (S.Etale)ᵒᵖ) ⋙
            CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}
        have : Limits.PreservesFiniteLimits C_unf := Limits.comp_preservesFiniteLimits _ _
        have hmap : C_unf.map (n • 𝟙 Aℤ) = n • 𝟙 Fℤ := by
          rw [C_unf.map_nsmul, C_unf.map_id]; rfl
        rw [← hmap]; exact C_unf.map_mono (n • 𝟙 Aℤ)
      have hCover : ∀ ℰ : CategoryTheory.Sheaf J AddCommGrpCat.{u},
          ∃ (P : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (q : P ⟶ ℰ),
            isTF_cat P ∧ Epi q := by
        let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology S
        have : IsGrothendieckAbelian.{u} (CategoryTheory.Sheaf J_aff AddCommGrpCat.{u}) :=
          inferInstance
        obtain ⟨hColim0_aff, hColimU_aff, _⟩ :=
          hasColimOfGroth (CategoryTheory.Sheaf J_aff AddCommGrpCat.{u})
        obtain ⟨hColim0_J, hColimU_J, hLocSmall_J⟩ :=
          hasColimOfGroth (CategoryTheory.Sheaf J AddCommGrpCat.{u})
        let _ := hColim0_aff; let _ := hColimU_aff
        let _ := hColim0_J; let _ := hColimU_J; let _ := hLocSmall_J
        have hMono_sigma_Aℤ : ∀ (ι : Type u) (n : ℕ), n ≠ 0 →
            Mono (n • 𝟙 (Limits.sigmaObj (fun _ : ι => Aℤ))) := by
          intro ι n hn
          have : AB4OfSize.{u} AddCommGrpCat.{u} := inferInstance
          have : HasExactColimitsOfShape (Discrete ι) AddCommGrpCat.{u} := AB4OfSize.ofShape ι
          let D : Discrete ι ⥤ AddCommGrpCat.{u} := Discrete.functor (fun _ : ι => Aℤ)
          let φ : D ⟶ D := n • 𝟙 D
          have : ∀ j : Discrete ι, Mono (φ.app j) := fun ⟨_⟩ => hMono_Aℤ n hn
          have : Mono φ := NatTrans.mono_of_mono_app φ
          exact Limits.colim.map_mono' φ (Limits.colimit.isColimit D) (Limits.colimit.isColimit D)
            (n • 𝟙 (Limits.sigmaObj (fun _ : ι => Aℤ))) (fun ⟨i⟩ => by
              change Limits.Sigma.ι (fun _ : ι => Aℤ) i ≫ (n • 𝟙 _) =
                (n • 𝟙 Aℤ) ≫ Limits.Sigma.ι (fun _ : ι => Aℤ) i
              rw [Preadditive.comp_nsmul, Category.comp_id, Preadditive.nsmul_comp, Category.id_comp])
        have hTF_free : ∀ W : S.AffineEtale,
            isTF_cat (CategoryTheory.Sheaf.freeYoneda J_aff W Aℤ) := by
          intro W
          apply isTF_map (CategoryTheory.presheafToSheaf J_aff AddCommGrpCat.{u})
          intro n hn
          have : ∀ V₀ : (S.AffineEtale)ᵒᵖ,
              Mono ((n • 𝟙 (CategoryTheory.Presheaf.freeYoneda W Aℤ)).app V₀) := by
            intro V₀
            change Mono (n • 𝟙 ((CategoryTheory.Presheaf.freeYoneda W Aℤ).obj V₀))
            exact hMono_sigma_Aℤ _ n hn
          exact NatTrans.mono_of_mono_app _
        let C₀ := SmallModel.{u} S.AffineEtale
        let eAff : S.AffineEtale ≌ C₀ := equivSmallModel S.AffineEtale
        let Y : C₀ → CategoryTheory.Sheaf J_aff AddCommGrpCat.{u} :=
          fun x => CategoryTheory.Sheaf.freeYoneda J_aff (eAff.inverse.obj x) Aℤ
        let G₀ : CategoryTheory.Sheaf J_aff AddCommGrpCat.{u} := sigmaObjU Y
        have hTF₀ : isTF_cat G₀ := isTF_sigma Y (fun x => hTF_free (eAff.inverse.obj x))
        have hSep₀ : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J_aff AddCommGrpCat.{u}}
            (f₁ f₂ : ℱ₁ ⟶ ℱ₂), (∀ h : G₀ ⟶ ℱ₁, h ≫ f₁ = h ≫ f₂) → f₁ = f₂ := by
          intro ℱ₁ ℱ₂ f₁ f₂ h_eq
          ext V₀ a
          let U₀ : S.AffineEtale := V₀.unop
          let x : C₀ := eAff.functor.obj U₀
          let isoU : U₀ ≅ eAff.inverse.obj x := eAff.unitIso.app U₀
          let a' : ℱ₁.obj.obj (Opposite.op (eAff.inverse.obj x)) :=
            ℱ₁.obj.map (Opposite.op isoU.inv) a
          let α₀ : Aℤ ⟶ ℱ₁.obj.obj (Opposite.op (eAff.inverse.obj x)) :=
            AddCommGrpCat.ofHom
              { toFun := fun z => z.down • a'
                map_zero' := zero_smul ℤ a'
                map_add' := fun z₁ z₂ => add_smul z₁.down z₂.down a' }
          let α : Y x ⟶ ℱ₁ := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm α₀
          let h_proj : G₀ ⟶ ℱ₁ :=
            sigmaDesc (X := Y) fun y => if hy : y = x then eqToHom (congrArg Y hy) ≫ α else 0
          have h_ι : sigmaIota Y x ≫ h_proj = α := by
            dsimp only [h_proj]
            rw [sigmaIotaDesc]
            split_ifs with h
            · exact Category.id_comp α
            · exact (h rfl).elim
          have hα_eq : α ≫ f₁ = α ≫ f₂ := by
            rw [← h_ι, Category.assoc, Category.assoc, h_eq h_proj]
          have h_ev : ∀ (g : ℱ₁ ⟶ ℱ₂),
              CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
                α₀ ≫ g.hom.app (Opposite.op (eAff.inverse.obj x)) := by
            intro g
            let adjSh := CategoryTheory.sheafificationAdjunction J_aff AddCommGrpCat.{u}
            let PF := CategoryTheory.Presheaf.freeYoneda (eAff.inverse.obj x) Aℤ
            let α' : (CategoryTheory.presheafToSheaf J_aff AddCommGrpCat.{u}).obj PF ⟶ ℱ₁ := α
            have h1 : adjSh.homEquiv PF ℱ₂ (α' ≫ g) =
                CategoryTheory.Presheaf.freeYonedaHomEquiv.symm α₀ ≫ g.hom := by
              rw [Adjunction.homEquiv_naturality_right adjSh α' g]
              change adjSh.homEquiv PF ℱ₁
                  ((adjSh.homEquiv PF ℱ₁).symm
                    (CategoryTheory.Presheaf.freeYonedaHomEquiv.symm α₀)) ≫
                  g.hom = _
              rw [Equiv.apply_symm_apply]
            change CategoryTheory.Presheaf.freeYonedaHomEquiv (adjSh.homEquiv PF ℱ₂ (α' ≫ g)) = _
            rw [h1, CategoryTheory.Presheaf.freeYonedaHomEquiv_symm_comp, Equiv.apply_symm_apply]
          have h_app_x := congrArg (fun k => k (ULift.up (1 : ℤ)))
            ((h_ev f₁).symm.trans
              (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv hα_eq |>.trans (h_ev f₂)))
          change f₁.hom.app (Opposite.op (eAff.inverse.obj x)) ((1 : ℤ) • a') =
            f₂.hom.app (Opposite.op (eAff.inverse.obj x)) ((1 : ℤ) • a') at h_app_x
          rw [one_smul ℤ] at h_app_x
          have ha_id : ℱ₁.obj.map (Opposite.op isoU.hom) a' = a := by
            dsimp [a']
            have hop : Opposite.op isoU.inv ≫ Opposite.op isoU.hom = 𝟙 V₀ := by
              change Opposite.op (isoU.hom ≫ isoU.inv) = Opposite.op (𝟙 U₀)
              rw [Iso.hom_inv_id]
            rw [← Functor.map_comp_apply, hop, Functor.map_id_apply]
          have hf1_eq : (ℱ₂.obj.map (Opposite.op isoU.hom))
              (f₁.hom.app (Opposite.op (eAff.inverse.obj x)) a') = f₁.hom.app V₀ a := by
            change (f₁.hom.app (Opposite.op (eAff.inverse.obj x)) ≫
              ℱ₂.obj.map (Opposite.op isoU.hom)) a' = f₁.hom.app V₀ a
            rw [← f₁.hom.naturality (Opposite.op isoU.hom)]
            change f₁.hom.app V₀ (ℱ₁.obj.map (Opposite.op isoU.hom) a') = f₁.hom.app V₀ a
            rw [ha_id]
          have hf2_eq : (ℱ₂.obj.map (Opposite.op isoU.hom))
              (f₂.hom.app (Opposite.op (eAff.inverse.obj x)) a') = f₂.hom.app V₀ a := by
            change (f₂.hom.app (Opposite.op (eAff.inverse.obj x)) ≫
              ℱ₂.obj.map (Opposite.op isoU.hom)) a' = f₂.hom.app V₀ a
            rw [← f₂.hom.naturality (Opposite.op isoU.hom)]
            change f₂.hom.app V₀ (ℱ₁.obj.map (Opposite.op isoU.hom) a') = f₂.hom.app V₀ a
            rw [ha_id]
          rw [← hf1_eq, ← hf2_eq, h_app_x]
        let E := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv S AddCommGrpCat.{u}
        have : E.functor.Additive := E.functor.additive_of_preserves_binary_products
        let G_tf := E.functor.obj G₀
        have hTF_tf : isTF_cat G_tf := isTF_map E.functor hTF₀
        have hSep_tf : ∀ {X₁ X₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
            (f₁ f₂ : X₁ ⟶ X₂), (∀ h : G_tf ⟶ X₁, h ≫ f₁ = h ≫ f₂) → f₁ = f₂ := by
          intro X₁ X₂ f₁ f₂ h_eq
          refine E.inverse.map_injective (hSep₀ _ _ fun k => ?_)
          have hk := h_eq (E.functor.map k ≫ E.counitIso.hom.app X₁)
          have hnat₁ := E.counitIso.hom.naturality f₁
          have hnat₂ := E.counitIso.hom.naturality f₂
          dsimp at hnat₁ hnat₂
          have hk' : E.functor.map (k ≫ E.inverse.map f₁) ≫ E.counitIso.hom.app X₂ =
              E.functor.map (k ≫ E.inverse.map f₂) ≫ E.counitIso.hom.app X₂ := by
            rw [Functor.map_comp, Functor.map_comp, Category.assoc, Category.assoc, hnat₁, hnat₂,
              ← Category.assoc, ← Category.assoc, hk]
          exact E.functor.map_injective ((cancel_mono (E.counitIso.hom.app X₂)).mp hk')
        intro ℰ
        have : Small.{u} (G_tf ⟶ ℰ) := LocallySmall.hom_small G_tf ℰ
        let Idx : Type u := Shrink.{u} (G_tf ⟶ ℰ)
        let P : CategoryTheory.Sheaf J AddCommGrpCat.{u} := sigmaObjU (fun _ : Idx => G_tf)
        let q : P ⟶ ℰ := sigmaDesc (X := fun _ : Idx => G_tf)
          (fun i : Idx => (equivShrink (G_tf ⟶ ℰ)).symm i)
        refine ⟨P, q, isTF_sigma (fun _ : Idx => G_tf) (fun _ => hTF_tf), ?_⟩
        refine ⟨fun {Z} f₁ f₂ hqf => hSep_tf f₁ f₂ fun h => ?_⟩
        have hi : sigmaIota (fun _ : Idx => G_tf) (equivShrink (G_tf ⟶ ℰ) h) ≫ q = h :=
          (sigmaIotaDesc (X := fun _ : Idx => G_tf)
            (fun i : Idx => (equivShrink (G_tf ⟶ ℰ)).symm i) (equivShrink (G_tf ⟶ ℰ) h)).trans
            (Equiv.symm_apply_apply _ h)
        rw [← hi, Category.assoc, Category.assoc, hqf]
      have hLiftModHom : ∀ {M₀ N₀ : ModuleCat.{u, u} R} (g : FgtMod.obj M₀ ⟶ FgtMod.obj N₀),
          ∃ f : M₀ ⟶ N₀, FgtMod.map f = g := by
        intro M₀ N₀ g
        refine ⟨ModuleCat.ofHom
          { toFun := g.hom.toFun
            map_add' := g.hom.map_add'
            map_smul' := fun r x => by
              obtain ⟨z, hz⟩ := ZMod.intCast_surjective r.down
              have hzr : (z : R) = r := by ext; exact hz
              simp only [RingHom.id_apply, ← hzr]
              rw [Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul]
              exact map_zsmul g.hom z x }, ?_⟩
        ext x; rfl
      have hFgtInj : ∀ {M₀ N₀ : ModuleCat.{u, u} R} {f₁ f₂ : M₀ ⟶ N₀},
          FgtMod.map f₁ = FgtMod.map f₂ → f₁ = f₂ := by
        intro M₀ N₀ f₁ f₂ h; ext x; exact congrArg (fun k => k x) h
      have hUFull : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)}
          (φ : U_fgt.obj ℱ₁ ⟶ U_fgt.obj ℱ₂),
          ∃ ψ : ℱ₁ ⟶ ℱ₂, U_fgt.map ψ = φ := by
        intro ℱ₁ ℱ₂ φ
        choose appL happL using fun W => hLiftModHom (φ.hom.app W)
        refine ⟨⟨{ app := appL
                   naturality := fun {W₁ W₂} u => by
                     apply hFgtInj
                     rw [FgtMod.map_comp, FgtMod.map_comp, happL W₁, happL W₂]
                     exact φ.hom.naturality u }⟩, ?_⟩
        ext W x; exact congrArg (fun k => k x) (happL W)
      have hUFaith : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)} {ψ₁ ψ₂ : ℱ₁ ⟶ ℱ₂},
          U_fgt.map ψ₁ = U_fgt.map ψ₂ → ψ₁ = ψ₂ := by
        intro ℱ₁ ℱ₂ ψ₁ ψ₂ h; ext W x; exact congrArg (fun k => k.hom.app W x) h
      have hLiftSheaf : ∀ (ℬ : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
          m • 𝟙 ℬ = 0 → ∃ ℬ_mod : CategoryTheory.Sheaf J (ModuleCat.{u, u} R),
            U_fgt.obj ℬ_mod = ℬ := by
        intro ℬ hm0_id
        let downHom : R →+* ZMod m :=
          { toFun := ULift.down
            map_one' := rfl
            map_mul' := fun _ _ => rfl
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
        let objMod (W : (S.Etale)ᵒᵖ) : ModuleCat.{u, u} R :=
          let hmW : ∀ x : ℬ.obj.obj W, m • x = 0 := fun x => by
            change ((m • 𝟙 ℬ).hom.app W) x = 0
            rw [hm0_id]; rfl
          letI : Module (ZMod m) (ℬ.obj.obj W) := AddCommGroup.zmodModule hmW
          letI : Module R (ℬ.obj.obj W) := Module.compHom (ℬ.obj.obj W) downHom
          ModuleCat.of R (ℬ.obj.obj W)
        choose mapMod hmapMod using fun {W₁ W₂ : (S.Etale)ᵒᵖ} (u : W₁ ⟶ W₂) =>
          hLiftModHom (M₀ := objMod W₁) (N₀ := objMod W₂) (ℬ.obj.map u)
        let P_mod : (S.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R :=
          { obj := objMod
            map := fun u => mapMod u
            map_id := fun W => hFgtInj (by rw [hmapMod, FgtMod.map_id]; exact ℬ.obj.map_id W)
            map_comp := fun u v => hFgtInj (by
              rw [hmapMod, FgtMod.map_comp, hmapMod, hmapMod]; exact ℬ.obj.map_comp u v) }
        have hP_comp : P_mod ⋙ FgtMod = ℬ.obj := by
          refine CategoryTheory.Functor.ext (fun _ => rfl) (fun _ _ u => ?_)
          dsimp; rw [Category.id_comp, Category.comp_id]; exact hmapMod u
        have hIsSheaf : Presheaf.IsSheaf J P_mod := by
          intro E
          let eqvW (W : (S.Etale)ᵒᵖ) : (E ⟶ objMod W) ≃ (FgtMod.obj E ⟶ ℬ.obj.obj W) :=
            { toFun := fun f => FgtMod.map f
              invFun := fun g => Classical.choose (hLiftModHom (M₀ := E) (N₀ := objMod W) g)
              left_inv := fun f => hFgtInj (Classical.choose_spec
                (hLiftModHom (M₀ := E) (N₀ := objMod W) (FgtMod.map f)))
              right_inv := fun g => Classical.choose_spec
                (hLiftModHom (M₀ := E) (N₀ := objMod W) g) }
          let isoE : P_mod ⋙ coyoneda.obj (Opposite.op E) ≅
              ℬ.obj ⋙ coyoneda.obj (Opposite.op (FgtMod.obj E)) :=
            NatIso.ofComponents (fun W => (eqvW W).toIso) (fun {W₁ W₂} u => by
              ext f
              change FgtMod.map (f ≫ mapMod u) = FgtMod.map f ≫ ℬ.obj.map u
              rw [FgtMod.map_comp, hmapMod])
          exact Presieve.isSheaf_iso J isoE.symm (ℬ.property (FgtMod.obj E))
        exact ⟨⟨P_mod, hIsSheaf⟩, sheaf_eq_of_obj_eq hP_comp⟩
      have hExtend : ∀ (ℐ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)) [Injective ℐ]
          (SC : ShortComplex (CategoryTheory.Sheaf J AddCommGrpCat.{u})),
          SC.ShortExact → isTF_cat SC.X₃ →
          ∀ (g₀ : SC.X₁ ⟶ U_fgt.obj ℐ), ∃ h : SC.X₂ ⟶ U_fgt.obj ℐ, SC.f ≫ h = g₀ := by
        intro ℐ _ SC hSC hTF_K g₀
        let upHom : ZMod m →+* R :=
          { toFun := ULift.up
            map_one' := rfl
            map_mul' := fun _ _ => rfl
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
        have hm_ℐ : m • 𝟙 (U_fgt.obj ℐ) = 0 := by
          ext W x
          let M_W : Type u := ℐ.obj.obj W
          let modZ : Module (ZMod m) M_W := Module.compHom M_W upHom
          exact @ZModModule.char_nsmul_eq_zero m M_W _ modZ x
        let K' := SC.X₁; let P := SC.X₂; let K := SC.X₃; let ι := SC.f; let π₀ := SC.g
        have : Mono ι := hSC.mono_f
        have : Epi π₀ := hSC.epi_g
        let K'_bar := Limits.cokernel (m • 𝟙 K')
        let P_bar := Limits.cokernel (m • 𝟙 P)
        let pK' := Limits.cokernel.π (m • 𝟙 K')
        let pP := Limits.cokernel.π (m • 𝟙 P)
        have hm_K' : m • 𝟙 K'_bar = 0 := by
          rw [← cancel_epi pK', Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero,
            ← Category.id_comp pK', ← Preadditive.nsmul_comp, Limits.cokernel.condition]
        have hm_P : m • 𝟙 P_bar = 0 := by
          rw [← cancel_epi pP, Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero,
            ← Category.id_comp pP, ← Preadditive.nsmul_comp, Limits.cokernel.condition]
        have h_cond_ι : (m • 𝟙 K') ≫ (ι ≫ pP) = 0 := by
          have hcomm : (m • 𝟙 K') ≫ ι = ι ≫ (m • 𝟙 P) := by
            rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
          rw [← Category.assoc, hcomm, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
        let ι_bar : K'_bar ⟶ P_bar := Limits.cokernel.desc (m • 𝟙 K') (ι ≫ pP) h_cond_ι
        have h_comm_ι : pK' ≫ ι_bar = ι ≫ pP := Limits.cokernel.π_desc _ _ _
        have : Mono ι_bar := by
          apply Abelian.Pseudoelement.mono_of_zero_of_map_zero
          intro a_bar ha_bar
          obtain ⟨a, rfl⟩ := Abelian.Pseudoelement.pseudo_surjective_of_epi pK' a_bar
          have h1 : Abelian.Pseudoelement.pseudoApply pP (Abelian.Pseudoelement.pseudoApply ι a) = 0 := by
            rw [← Abelian.Pseudoelement.comp_apply, ← h_comm_ι, Abelian.Pseudoelement.comp_apply]
            exact ha_bar
          obtain ⟨b, hb⟩ := Abelian.Pseudoelement.pseudo_exact_of_exact
            (ShortComplex.exact_cokernel (m • 𝟙 P)) _ h1
          by_cases hm0 : m = 0
          · subst hm0
            have hb0 : Abelian.Pseudoelement.pseudoApply ((0 : ℕ) • 𝟙 P) b = 0 := by
              rw [zero_smul]; exact Abelian.Pseudoelement.zero_apply P b
            rw [hb0] at hb
            have ha0 : a = 0 := Abelian.Pseudoelement.zero_of_map_zero ι
              (Abelian.Pseudoelement.pseudo_injective_of_mono ι) a hb.symm
            rw [ha0, Abelian.Pseudoelement.apply_zero]
          · have : Mono (m • 𝟙 K) := hTF_K m hm0
            have hcomm_π : (m • 𝟙 P) ≫ π₀ = π₀ ≫ (m • 𝟙 K) := by
              rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
            have hπb : Abelian.Pseudoelement.pseudoApply (m • 𝟙 K)
                (Abelian.Pseudoelement.pseudoApply π₀ b) = 0 := by
              rw [← Abelian.Pseudoelement.comp_apply, ← hcomm_π, Abelian.Pseudoelement.comp_apply, hb,
                ← Abelian.Pseudoelement.comp_apply]
              have hz : ι ≫ π₀ = 0 := SC.zero
              rw [hz]; exact Abelian.Pseudoelement.zero_apply K a
            have hb_ker : Abelian.Pseudoelement.pseudoApply π₀ b = 0 :=
              Abelian.Pseudoelement.zero_of_map_zero (m • 𝟙 K)
                (Abelian.Pseudoelement.pseudo_injective_of_mono (m • 𝟙 K)) _ hπb
            obtain ⟨c, rfl⟩ := Abelian.Pseudoelement.pseudo_exact_of_exact hSC.exact b hb_ker
            have hcomm_ι2 : (m • 𝟙 K') ≫ ι = ι ≫ (m • 𝟙 P) := by
              rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
            have hc_eq : Abelian.Pseudoelement.pseudoApply ι
                (Abelian.Pseudoelement.pseudoApply (m • 𝟙 K') c) =
                Abelian.Pseudoelement.pseudoApply ι a := by
              rw [← Abelian.Pseudoelement.comp_apply, hcomm_ι2, Abelian.Pseudoelement.comp_apply, hb]
            have ha_eq : a = Abelian.Pseudoelement.pseudoApply (m • 𝟙 K') c :=
              (Abelian.Pseudoelement.pseudo_injective_of_mono ι hc_eq).symm
            rw [ha_eq, ← Abelian.Pseudoelement.comp_apply, Limits.cokernel.condition]
            exact Abelian.Pseudoelement.zero_apply K'_bar c
        obtain ⟨K'_mod, hK'_mod⟩ := hLiftSheaf K'_bar hm_K'
        obtain ⟨P_mod, hP_mod⟩ := hLiftSheaf P_bar hm_P
        obtain ⟨ι_mod, hι_mod⟩ := hUFull (eqToHom hK'_mod ≫ ι_bar ≫ eqToHom hP_mod.symm)
        have : Mono ι_mod := by
          refine ⟨fun {Z} f₁ f₂ hf => hUFaith ?_⟩
          have : Mono (U_fgt.map ι_mod) := by
            rw [hι_mod]; exact mono_comp (eqToHom hK'_mod) (ι_bar ≫ eqToHom hP_mod.symm)
          rw [← cancel_mono (U_fgt.map ι_mod), ← U_fgt.map_comp, ← U_fgt.map_comp, hf]
        have hg₀_cond : (m • 𝟙 K') ≫ g₀ = 0 := by
          have hcomm : (m • 𝟙 K') ≫ g₀ = g₀ ≫ (m • 𝟙 (U_fgt.obj ℐ)) := by
            rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
          rw [hcomm, hm_ℐ, Limits.comp_zero]
        let g₀_bar : K'_bar ⟶ U_fgt.obj ℐ := Limits.cokernel.desc (m • 𝟙 K') g₀ hg₀_cond
        obtain ⟨g₀_mod, hg₀_mod⟩ := hUFull (eqToHom hK'_mod ≫ g₀_bar)
        let h_mod : P_mod ⟶ ℐ := Injective.factorThru g₀_mod ι_mod
        have hh_mod : ι_mod ≫ h_mod = g₀_mod := Injective.comp_factorThru g₀_mod ι_mod
        refine ⟨pP ≫ eqToHom hP_mod.symm ≫ U_fgt.map h_mod, ?_⟩
        have h_mid : ι_bar ≫ eqToHom hP_mod.symm ≫ U_fgt.map h_mod = g₀_bar := by
          have h_eq1 : (eqToHom hK'_mod ≫ ι_bar ≫ eqToHom hP_mod.symm) ≫ U_fgt.map h_mod =
              eqToHom hK'_mod ≫ g₀_bar := by
            rw [← hι_mod, ← U_fgt.map_comp, hh_mod, hg₀_mod]
          have h_eq2 := congrArg (fun k => eqToHom hK'_mod.symm ≫ k) h_eq1
          simpa only [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp] using h_eq2
        calc
          SC.f ≫ (pP ≫ eqToHom hP_mod.symm ≫ U_fgt.map h_mod)
            = (ι ≫ pP) ≫ eqToHom hP_mod.symm ≫ U_fgt.map h_mod := (Category.assoc _ _ _).symm
          _ = (pK' ≫ ι_bar) ≫ eqToHom hP_mod.symm ≫ U_fgt.map h_mod := by rw [h_comm_ι]
          _ = pK' ≫ (ι_bar ≫ eqToHom hP_mod.symm ≫ U_fgt.map h_mod) := Category.assoc _ _ _
          _ = pK' ≫ g₀_bar := by rw [h_mid]
          _ = g₀ := Limits.cokernel.π_desc _ _ _
      exact ext_comparison_bijective_of_acyclic U_fgt oneR Fℤ ηℤ hBase
        (fun ℐ _ p e => ext_vanish_of_effaceable isTF_cat isTF_sub hCover (U_fgt.obj ℐ)
          (hExtend ℐ) p hTF_Fℤ e)

    let ℱ_ab : CategoryTheory.Sheaf J AddCommGrpCat.{u} := U_fgt.obj 𝒥
    have : NeZero m := ⟨by omega⟩
    let A₀ : Type := Fin M → ZMod m
    have hTors₀ : ∀ v : A₀, m • v = 0 := fun v => by
      ext j
      change m • (v j) = 0
      rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    let M_act₀ : Γ → (A₀ →+ A₀) := fun g => (Matrix.mulVecLin (τ_rep g).val).toAddMonoidHom
    have hM_one₀ : ∀ v : A₀, M_act₀ 1 v = v := fun v => by
      change Matrix.mulVec (τ_rep 1).val v = v
      rw [map_one, Units.val_one, Matrix.one_mulVec]
    have hM_mul₀ : ∀ (g₁ g₂ : Γ) (v : A₀), M_act₀ (g₁ * g₂) v = M_act₀ g₁ (M_act₀ g₂ v) :=
      fun g₁ g₂ v => by
        change Matrix.mulVec (τ_rep (g₁ * g₂)).val v =
          Matrix.mulVec (τ_rep g₁).val (Matrix.mulVec (τ_rep g₂).val v)
        rw [map_mul, Units.val_mul, Matrix.mulVec_mulVec]
    let triv_J : ∀ W : S.Etale,
        let ι_V : Quiver.Hom V S := CategoryTheory.CategoryStruct.comp π U.ι
        let W_V := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).hom ι_V
        ↑(ℱ_ab.obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_V A₀ :=
      fun W => (triv W).comp (ι_ext.hom.app (Opposite.op W)).hom.toAddMonoidHom
    have hNat_J : ∀ {W₁ W₂ : S.Etale} (u : Quiver.Hom W₁ W₂),
        let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).hom
        let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).hom
        let ι_V : Quiver.Hom V S := CategoryTheory.CategoryStruct.comp π U.ι
        ∀ (u_V : Quiver.Hom (CategoryTheory.Limits.pullback h₁ ι_V)
            (CategoryTheory.Limits.pullback h₂ ι_V)),
          CategoryTheory.CategoryStruct.comp u_V (CategoryTheory.Limits.pullback.fst h₂ ι_V) =
            CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst h₁ ι_V)
              ((AlgebraicGeometry.Scheme.Etale.forget S).map u).left →
          CategoryTheory.CategoryStruct.comp u_V (CategoryTheory.Limits.pullback.snd h₂ ι_V) =
            CategoryTheory.Limits.pullback.snd h₁ ι_V →
          ∀ (s : ↑(ℱ_ab.obj.obj (Opposite.op W₂)))
            (y₁ : ↥(CategoryTheory.Limits.pullback h₁ ι_V)),
            triv_J W₁ ((ℱ_ab.obj.map (Opposite.op u)).hom s) y₁ = triv_J W₂ s (u_V.base y₁) := by
      intro W₁ W₂ u h₁ h₂ ι_V u_V hu_fst hu_snd s y₁
      have hnat_ι := ConcreteCategory.congr_hom (ι_ext.hom.naturality (Opposite.op u)) s
      have hnat_ι' : (ι_ext.hom.app (Opposite.op W₁)).hom ((𝒥.obj.map (Opposite.op u)).hom s) =
          (ℳ.obj.map (Opposite.op u)).hom ((ι_ext.hom.app (Opposite.op W₂)).hom s) := hnat_ι
      change triv W₁ ((ι_ext.hom.app (Opposite.op W₁)).hom ((𝒥.obj.map (Opposite.op u)).hom s)) y₁ =
        triv W₂ ((ι_ext.hom.app (Opposite.op W₂)).hom s) (u_V.base y₁)
      rw [hnat_ι']
