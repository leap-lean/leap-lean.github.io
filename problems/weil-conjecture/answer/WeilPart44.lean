      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (hσ_fst W 1).trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      · exact (hσ_snd W 1).trans
          (((congrArg (snd₁ W ≫ ·) hAct1).trans (CategoryTheory.Category.comp_id _)).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm)
    have hcounit_eq : ((adj.counit.app ℋ).hom.app (Opposite.op W)).hom s = ε_fun ℋ W s := rfl
    exact (congrArg (ℋ.obj.map (Opposite.op (p_W W))).hom hcounit_eq).trans
      ((hε_p ℋ W s).trans
        (Finset.sum_congr rfl fun i _ =>
          congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom ((s.1 i).1 i)) hσ1_eq))

  let _ := hM
  let R := ULift.{u, 0} (ZMod m)
  let J_top := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J_top (ModuleCat.{u, u} R)
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  let ι_V : Quiver.Hom L.V S := CategoryTheory.CategoryStruct.comp L.π U.ι
  let hι_et : AlgebraicGeometry.Etale ι_V := h_et_V L.π L.hGal.2.1
  let obj_WV : S.Etale → S.Etale := fun W =>
    let h_W : Quiver.Hom (Fgt.obj W).left S := (Fgt.obj W).hom
    letI : AlgebraicGeometry.Etale h_W := W.prop
    letI : AlgebraicGeometry.Etale ι_V := hι_et
    CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst h_W ι_V) h_W)
      inferInstance
  obtain ⟨ev_lc, h_res, h_unit, h_ref⟩ := hUnitLC S m
  obtain ⟨T_sh, R_sh, hAdd, hLim, hColim, adj, triv_T, triv_R,
    hT_range, hT_res, hT_map, hR_range, hR_res, hCounit_diag⟩ :=
    hTorsorAdjPkg S U m M (@h_et_V) L.Γ L.V L.π L.act L.hGal L.τ_rep L.τ_dual L.h_dual
  obtain ⟨e_one, he_one⟩ :=
    (hSheafPairIsos S U m M hm (@h_et_V) L.Γ L.V L.π L.hGal.2.1 L.act L.τ_rep
      L.𝒥 L.ℳ L.ι_ext L.triv L.hPair ev_lc (@h_res)).1
      (T_sh.obj oneR) (triv_T oneR) (hT_range oneR) (hT_res oneR)
  obtain ⟨e_dual, he_dual⟩ :=
    (hSheafPairIsos S U m M hm (@h_et_V) L.Γ L.V L.π L.hGal.2.1 L.act L.τ_dual
      L.𝒥_dual L.ℳ_dual L.ι_dual L.triv_dual L.hPair_dual ev_lc (@h_res)).2
      (R_sh.obj oneR) (triv_R oneR) (hR_range oneR) (hR_res oneR)
  let ε_tr : Quiver.Hom (T_sh.obj L.ℳ_dual) oneR :=
    CategoryTheory.CategoryStruct.comp (T_sh.map e_dual.hom) (adj.counit.app oneR)
  have : T_sh.Additive := hAdd
  have : CategoryTheory.Limits.PreservesFiniteLimits T_sh := hLim
  have : CategoryTheory.Limits.PreservesFiniteColimits T_sh := hColim
  let Ψ : CategoryTheory.Abelian.Ext.{u} oneR L.ℳ_dual 1 →+
      CategoryTheory.Abelian.Ext.{u} L.𝒥 oneR 1 :=
    AddMonoidHom.mk'
      (fun w => (CategoryTheory.Abelian.Ext.mk₀ e_one.hom).comp
        (((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ T_sh hAdd hLim hColim _ _
          oneR L.ℳ_dual 1) w).comp (CategoryTheory.Abelian.Ext.mk₀ ε_tr) (Nat.add_zero 1))
        (Nat.zero_add 1))
      (fun w₁ w₂ => by
        rw [map_add, CategoryTheory.Abelian.Ext.add_comp, CategoryTheory.Abelian.Ext.comp_add])
  have hOne_map_comp : ∀ {U₁ U₂ U₃ : S.Etale} (a : Quiver.Hom U₁ U₂) (b : Quiver.Hom U₂ U₃)
      (s : ↑(oneR.obj.obj (Opposite.op U₃))),
      (oneR.obj.map (Opposite.op (CategoryTheory.CategoryStruct.comp a b))).hom s =
