      refine ⟨?_, ?_⟩
      · rw [hγ_val, hdual_val]
        have h1 := congrArg (RingHom.mapMatrix π_mod) hJ_g
        simpa only [map_mul (RingHom.mapMatrix π_mod), RingHom.mapMatrix_apply] using h1
      · rw [hγ_val, hdual_val]
        have h2 := congrArg (RingHom.mapMatrix π_mod) hG2
        simpa only [map_mul (RingHom.mapMatrix π_mod), RingHom.mapMatrix_apply] using h2

