      rw [hmap_mul, hmap_mul, hmap_transpose, hJint_map, Matrix.mul_smul, Matrix.smul_mul,
        hG_sp g hg]
    have hFu_int : (F_u.val).transpose * J_int * F_u.val =
        ((Nat.card F : PadicInt ℓ) ^ n) • J_int := by
      apply hMat_inj
      rw [hmap_mul, hmap_mul, hmap_transpose, hJint_map, Matrix.mul_smul, Matrix.smul_mul, hFu_sim]
      ext a b
      simp only [Matrix.map_apply, Matrix.smul_apply, smul_eq_mul, map_mul, map_pow, map_natCast]
      change (ℓ : Padic ℓ) ^ c₁ * ((Nat.card F : Padic ℓ) ^ n * J a b) =
        (Nat.card F : Padic ℓ) ^ n * ((ℓ : Padic ℓ) ^ c₁ * J a b)
      ring
    have hd : J_int.det ≠ 0 := by
      intro hd0
      have hdet_map : ι_padic J_int.det = (J_int.map ι_padic).det :=
        RingHom.map_det ι_padic J_int
      rw [hd0, map_zero, hJint_map, Matrix.det_smul, Fintype.card_fin] at hdet_map
      have hpow_ne : ((ℓ : Padic ℓ) ^ c₁) ^ M ≠ 0 :=
        pow_ne_zero M (pow_ne_zero c₁ (Nat.cast_ne_zero.mpr hℓ_ne))
      exact hJ_det ((mul_eq_zero.mp hdet_map.symm).resolve_left hpow_ne)
    let c₂ : ℕ := J_int.det.valuation
    let u_det : (PadicInt ℓ)ˣ := PadicInt.unitCoeff hd
    have hu_spec : J_int.det = (u_det : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ c₂ :=
      PadicInt.unitCoeff_spec hd
    let J_adj : Matrix (Fin M) (Fin M) (PadicInt ℓ) :=
      ((u_det⁻¹ : (PadicInt ℓ)ˣ) : PadicInt ℓ) • J_int.adjugate
    have hJ_mul_adj : J_int * J_adj =
        ((ℓ : PadicInt ℓ) ^ c₂) • (1 : Matrix (Fin M) (Fin M) (PadicInt ℓ)) := by
      dsimp [J_adj]
      rw [Matrix.mul_smul, Matrix.mul_adjugate, hu_spec, smul_smul, ← mul_assoc,
        Units.inv_mul, one_mul]
    have hJ_adj_mul : J_adj * J_int =
        ((ℓ : PadicInt ℓ) ^ c₂) • (1 : Matrix (Fin M) (Fin M) (PadicInt ℓ)) := by
      dsimp [J_adj]
      rw [Matrix.smul_mul, Matrix.adjugate_mul, hu_spec, smul_smul, ← mul_assoc,
        Units.inv_mul, one_mul]
    have hℓc₂_ne : ((ℓ : PadicInt ℓ) ^ c₂) ≠ 0 :=
      pow_ne_zero c₂ (Nat.cast_ne_zero.mpr hℓ_ne)
    have hG_adj : ∀ g ∈ G_geom, J_adj * ((g⁻¹).val).transpose = g.val * J_adj := by
      intro g hg
      have hsp := hG_int g hg
      have hinv_tr : ((g⁻¹).val).transpose * (g.val).transpose = 1 := by
        rw [← Matrix.transpose_mul, Units.mul_inv, Matrix.transpose_one]
      have hJg : J_int * g.val = ((g⁻¹).val).transpose * J_int := by
        calc
          J_int * g.val = 1 * (J_int * g.val) := (Matrix.one_mul _).symm
          _ = (((g⁻¹).val).transpose * (g.val).transpose) * (J_int * g.val) := by rw [hinv_tr]
          _ = ((g⁻¹).val).transpose * ((g.val).transpose * J_int * g.val) := by
            simp only [Matrix.mul_assoc]
          _ = ((g⁻¹).val).transpose * J_int := by rw [hsp]
      have hscale : ((ℓ : PadicInt ℓ) ^ c₂) • (J_adj * ((g⁻¹).val).transpose) =
