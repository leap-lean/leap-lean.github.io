              rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, ← hm_u_comm (f_z z) σ,
                AlgebraicGeometry.Scheme.Hom.comp_apply]
            rw [hpt, hf_m_eval m (f_z z) (hf_z z)]
            exact ((x (f_z z) (hf_z z)).hom m).2.2 σ (w_z z)
        let t_hom : M_grp ⟶ 𝒥_pre.obj (Opposite.op W) :=
          AddCommGrpCat.ofHom
            { toFun := fun m => ⟨⟨f_m m, hf_m_lc m⟩, hf_m_mem m⟩
              map_zero' := by
                apply Subtype.ext
                apply LocallyConstant.ext
                intro z
                change ((x (f_z z) (hf_z z)).hom 0).1 (w_z z) = 0
                rw [map_zero]
                rfl
              map_add' := fun m₁ m₂ => by
                apply Subtype.ext
                apply LocallyConstant.ext
                intro z
                change ((x (f_z z) (hf_z z)).hom (m₁ + m₂)).1 (w_z z) =
                  f_m m₁ z + f_m m₂ z
                rw [map_add]
                rfl }
        refine ⟨t_hom, ?_, ?_⟩
        · intro Y f hf
          apply AddCommGrpCat.ext
          intro m
          apply Subtype.ext
          apply LocallyConstant.ext
          intro w
          exact hf_m_eval m f hf w
        · intro y_hom hy
          apply AddCommGrpCat.ext
          intro m
          apply Subtype.ext
          apply LocallyConstant.ext
          intro z
          have hy_z := hy (f_z z) (hf_z z)
          have hval := congrArg
            (fun k : M_grp ⟶ 𝒥_pre.obj (Opposite.op (Y_z z)) => (k.hom m).1 (w_z z)) hy_z
          change (y_hom.hom m).1 ((u_can (f_z z)).base (w_z z)) = f_m m z at hval
          rwa [hw_z z] at hval
      let 𝒥₀ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} := ⟨𝒥_pre, hSheaf⟩
      let triv_! : ∀ W : S.Etale,
          ↑(𝒥₀.obj.obj (Opposite.op W)) →+
            LocallyConstant ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom ι) A :=
        fun W => (S_! W).subtype
      refine ⟨𝒥₀, triv_!, ?_, ?_⟩
      · intro W₁ W₂ u h₁ h₂ W₁_V W₂_V u_V hfst hsnd s y₁
        have hu_eq : u_V = u_can u := hu_can_eq u u_V hfst hsnd
        rw [hu_eq]
        rfl
      · intro W h_W W_V
        refine ⟨Subtype.val_injective, ?_⟩
        ext f
        change f ∈ Set.range (Subtype.val : ↥(S_! W) → _) ↔ _
        rw [Subtype.range_coe_subtype]
        constructor
        · rintro ⟨hcol, heq⟩
          refine ⟨hcol, fun σ m_σ hfst hsnd y => ?_⟩
          rw [hm_can_eq h_W σ m_σ hfst hsnd]
          exact heq σ y
        · rintro ⟨hcol, heq⟩
          refine ⟨hcol, fun σ y => ?_⟩
          exact heq σ (m_can h_W σ)
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) y
    · intro ℱ₁ ℱ₂ ℱ₃ f g h0 hf_inj h_ker hg_surj
      let J := S.smallEtaleTopology
      have hMono : CategoryTheory.Mono f := by
        refine ⟨fun {𝒢} α₁ α₂ hα => ?_⟩
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext W_op
        let W : S.Etale := Opposite.unop W_op
        change α₁.hom.app (Opposite.op W) = α₂.hom.app (Opposite.op W)
        apply AddCommGrpCat.ext
        intro z
        apply hf_inj W
        exact congrArg (fun k : 𝒢 ⟶ ℱ₂ => (k.hom.app (Opposite.op W)) z) hα
      have hLocSurj : CategoryTheory.Sheaf.IsLocallySurjective g := by
        refine CategoryTheory.Presheaf.IsLocallySurjective.mk fun {W} s₃ => ?_
        rw [hMem W _]
        intro x
        obtain ⟨U_et, u, y, s₂, hu_et, hy, hs₂⟩ := hg_surj W s₃ x
        refine ⟨U_et, u, y, ?_, hu_et, hy⟩
        rw [CategoryTheory.Presheaf.imageSieve_apply]
        exact ⟨s₂, hs₂⟩
      have hEpi : CategoryTheory.Epi g := by
        have := hLocSurj
        exact CategoryTheory.Sheaf.epi_of_isLocallySurjective g
      have hExact : (CategoryTheory.ShortComplex.mk f g h0).Exact := by
        rw [CategoryTheory.ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero]
        change CategoryTheory.Limits.kernel.ι g ≫ CategoryTheory.Limits.cokernel.π f = 0
        let 𝒞 := CategoryTheory.Limits.cokernel f
        let π_f : ℱ₂ ⟶ 𝒞 := CategoryTheory.Limits.cokernel.π f
        let ι_g : CategoryTheory.Limits.kernel g ⟶ ℱ₂ := CategoryTheory.Limits.kernel.ι g
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext W_op
        let W : S.Etale := Opposite.unop W_op
        change (ι_g ≫ π_f).hom.app (Opposite.op W) =
          (0 : CategoryTheory.Limits.kernel g ⟶ 𝒞).hom.app (Opposite.op W)
        apply AddCommGrpCat.ext
        intro z
