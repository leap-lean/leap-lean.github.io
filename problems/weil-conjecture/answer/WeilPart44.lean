        vecOf (φ.comp M_mat.mulVecLin) = (M_mat.transpose).mulVec (vecOf φ) := by
      intro φ M_mat
      ext i
      have hcol : M_mat.mulVecLin (Pi.single i (1 : Padic ℓ)) =
