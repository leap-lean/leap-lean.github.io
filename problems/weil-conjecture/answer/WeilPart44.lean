            ((AlgebraicGeometry.Scheme.Etale.forget S).map t_y).left.base.hom =
          LocallyConstant.const _ b :=
        fun _ => LocallyConstant.ext fun _ => rfl
      have hs1 : θ_S r Y_y
          (u_out.comap ((AlgebraicGeometry.Scheme.Etale.forget S).map j_y).left.base.hom) =
          ((weilEtaleTorsionSheaf S (ℓ ^ (r + 1))).obj.map (Opposite.op j_y)).hom
            ((π_tors.hom.app (Opposite.op Y)).hom (θ_S (r + 1) Y g)) :=
        (hθ_nat r j_y u_out).symm.trans
          (congrArg (((weilEtaleTorsionSheaf S (ℓ ^ (r + 1))).obj.map (Opposite.op j_y)).hom)
            hu_out)
      have hs2 : ((weilEtaleTorsionSheaf S (ℓ ^ (r + 1))).obj.map (Opposite.op j_y)).hom
            ((π_tors.hom.app (Opposite.op Y)).hom (θ_S (r + 1) Y g)) =
