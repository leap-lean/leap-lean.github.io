      (∀ (r : ℕ) (lam₁ lam₂ : ↥(invTorsSubgroup r)) (z : H_coh r),
        lam₂.1 = (((A_u.val).map (PadicInt.toZModPow (r + 1))).transpose).mulVec lam₁.1 →
        pair r lam₁ (frob_coh r z) = (q_card : ZMod (ℓ ^ (r + 1))) * pair r lam₂ z) →
      ∃ B_coinv : ↥(WeilSymplecticLinInvDual ℓ N H_geom) →ₗ[Padic ℓ] V →ₗ[Padic ℓ] Padic ℓ,
        Function.Bijective B_coinv ∧
        ∀ (ψ ψ' : ↥(WeilSymplecticLinInvDual ℓ N H_geom)) (z : V),
          ψ'.1 = ψ.1.comp (((A_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin) →
          B_coinv ψ (frob_V z) = (q_card : Padic ℓ) * B_coinv ψ' z := by
    clear S_aff j_aff hj_open hj_hom s_inf hsinf_sec hsinf_compl U₀ hU₀_eq u₀ hu₀_sec hu₀_mem
      hℓ hN hAu_norm A_mat 𝒥₀ τ_𝒥 hZExt M_c2 hInjR hCog
    intro q_card H_coh _ T_coh hSurj_T frob_coh hFrobTrans V _ _ _ frob_V sysSubgroup hsys equiv
      hsmul hfrob pair hCompat hLeft hRight hFrob
    have hPrime : Nat.Prime ℓ := Fact.out
    have halg_coe : ∀ z : PadicInt ℓ, algebraMap (PadicInt ℓ) (Padic ℓ) z = (z : Padic ℓ) :=
      fun _ => rfl
    have hcoe_inj : Function.Injective (algebraMap (PadicInt ℓ) (Padic ℓ)) := Subtype.val_injective
    have hℓ_K_ne : (ℓ : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hPrime.ne_zero
    have hSubZ0 : Subsingleton (ZMod (ℓ ^ 0)) := by rw [pow_zero]; infer_instance
    have hTors_coh : ∀ (r : ℕ) (u : H_coh r), (ℓ ^ (r + 1)) • u = 0 := by
      intro r u
      apply hRight r ((ℓ ^ (r + 1)) • u)
      intro lam
      rw [map_nsmul, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    have hcoh_rem : ∀ (r n : ℕ) (u : H_coh r), n • u = (n % (ℓ ^ (r + 1))) • u := by
      intro r n u
      conv_lhs => rw [← Nat.div_add_mod n (ℓ ^ (r + 1))]
      rw [add_nsmul, mul_comm (ℓ ^ (r + 1)) _, mul_smul, hTors_coh r u, smul_zero, zero_add]
    have hNeZeroPow : ∀ r : ℕ, NeZero (ℓ ^ (r + 1)) :=
      fun r => ⟨pow_ne_zero (r + 1) hPrime.ne_zero⟩
    let I_int : Submodule (PadicInt ℓ) (Fin N → PadicInt ℓ) :=
      { carrier := { w : Fin N → PadicInt ℓ | ∀ h ∈ H_geom, ((h.val).transpose).mulVec w = w }
        add_mem' := fun {w₁ w₂} hw₁ hw₂ h hh => by
          rw [Matrix.mulVec_add, hw₁ h hh, hw₂ h hh]
        zero_mem' := fun _ _ => Matrix.mulVec_zero _
        smul_mem' := fun c {w} hw h hh => by
          rw [Matrix.mulVec_smul, hw h hh] }
    let redInv : ∀ r : ℕ, ↥I_int → ↥(invTorsSubgroup r) := fun r w =>
      ⟨fun i => PadicInt.toZModPow (r + 1) (w.1 i), by
        intro h hh
        ext i
        have hwi := congrFun (w.2 h hh) i
        simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply, Matrix.map_apply] at hwi ⊢
        simpa only [map_sum, map_mul] using congrArg (PadicInt.toZModPow (r + 1)) hwi⟩
    let seqOf : ↥I_int → ↥sysSubgroup → ∀ m : ℕ, ZMod (ℓ ^ m) := fun w x m =>
      match m with
      | 0 => 0
      | r + 1 => pair r (redInv r w) (x.1 r)
    have hseq_step : ∀ (w : ↥I_int) (x : ↥sysSubgroup) (k : ℕ),
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) (seqOf w x (k + 1)) =
          seqOf w x k := by
      intro w x k
      cases k with
      | zero => exact @Subsingleton.elim _ hSubZ0 _ _
      | succ r =>
        have hcast_red : ∀ i : Fin N, (redInv r w).1 i =
            ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
              ((redInv (r + 1) w).1 i) := by
          intro i
          exact (PadicInt.cast_toZModPow (r + 1) (r + 2) (Nat.le_succ (r + 1)) (w.1 i)).symm
        exact (hCompat r (redInv (r + 1) w) (redInv r w) (x.1 (r + 1)) hcast_red).trans
          (congrArg (pair r (redInv r w)) ((hsys x.1).mp x.2 r))
    have hseq_le : ∀ (w : ↥I_int) (x : ↥sysSubgroup) (k₁ k₂ : ℕ) (hk : k₁ ≤ k₂),
        ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁)) (seqOf w x k₂) = seqOf w x k₁ := by
      intro w x k₁ k₂ hk
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hk
      induction d with
      | zero =>
        change ZMod.castHom (pow_dvd_pow ℓ (le_refl k₁)) (ZMod (ℓ ^ k₁)) (seqOf w x k₁) = _
        rw [ZMod.castHom_self, RingHom.id_apply]
      | succ d ih =>
        have h1 : k₁ ≤ k₁ + d := Nat.le_add_right k₁ d
        have h2 : k₁ + d ≤ k₁ + d + 1 := Nat.le_succ (k₁ + d)
        have hcomp : ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁)) =
            (ZMod.castHom (pow_dvd_pow ℓ h1) (ZMod (ℓ ^ k₁))).comp
              (ZMod.castHom (pow_dvd_pow ℓ h2) (ZMod (ℓ ^ (k₁ + d)))) := by
          ext a; simp
        rw [hcomp, RingHom.comp_apply]
        exact (congrArg (ZMod.castHom (pow_dvd_pow ℓ h1) (ZMod (ℓ ^ k₁)))
          (hseq_step w x (k₁ + d))).trans (ih h1)
    let homSeq : ↥I_int → ↥sysSubgroup → ∀ m : ℕ, Polynomial ℤ →+* ZMod (ℓ ^ m) :=
      fun w x m => Polynomial.eval₂RingHom (Int.castRingHom (ZMod (ℓ ^ m))) (seqOf w x m)
    have hhom_compat : ∀ (w : ↥I_int) (x : ↥sysSubgroup) (k₁ k₂ : ℕ) (hk : k₁ ≤ k₂),
        (ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁))).comp (homSeq w x k₂) =
          homSeq w x k₁ := by
      intro w x k₁ k₂ hk
      apply Polynomial.ringHom_ext'
      · ext n; simp [homSeq]
      · simp [homSeq, hseq_le w x k₁ k₂ hk]
    let β : ↥I_int → ↥sysSubgroup → PadicInt ℓ :=
      fun w x => PadicInt.lift (hhom_compat w x) Polynomial.X
    have hβ_spec : ∀ (w : ↥I_int) (x : ↥sysSubgroup) (r : ℕ),
        PadicInt.toZModPow (r + 1) (β w x) = pair r (redInv r w) (x.1 r) := by
      intro w x r
      have h1 := RingHom.congr_fun (PadicInt.lift_spec (hhom_compat w x) (r + 1)) Polynomial.X
      simpa [β, homSeq, seqOf] using h1
    have hβ_add_left : ∀ (w₁ w₂ : ↥I_int) (x : ↥sysSubgroup),
        β (w₁ + w₂) x = β w₁ x + β w₂ x := by
      intro w₁ w₂ x
      apply PadicInt.ext_of_toZModPow.mp
      intro k
      cases k with
      | zero => exact @Subsingleton.elim _ hSubZ0 _ _
      | succ r =>
        have hred : redInv r (w₁ + w₂) = redInv r w₁ + redInv r w₂ := by
          apply Subtype.ext; ext i; exact map_add (PadicInt.toZModPow (r + 1)) (w₁.1 i) (w₂.1 i)
        rw [map_add, hβ_spec, hβ_spec, hβ_spec, hred, map_add, AddMonoidHom.add_apply]
    have hβ_add_right : ∀ (w : ↥I_int) (x₁ x₂ : ↥sysSubgroup),
        β w (x₁ + x₂) = β w x₁ + β w x₂ := by
      intro w x₁ x₂
      apply PadicInt.ext_of_toZModPow.mp
      intro k
      cases k with
      | zero => exact @Subsingleton.elim _ hSubZ0 _ _
      | succ r =>
        rw [map_add, hβ_spec, hβ_spec, hβ_spec]
        exact map_add (pair r (redInv r w)) (x₁.1 r) (x₂.1 r)
    have hβ_smul_left : ∀ (c : PadicInt ℓ) (w : ↥I_int) (x : ↥sysSubgroup),
        β (c • w) x = c * β w x := by
      intro c w x
      apply PadicInt.ext_of_toZModPow.mp
      intro k
      cases k with
      | zero => exact @Subsingleton.elim _ hSubZ0 _ _
      | succ r =>
        let _ := hNeZeroPow r
        have hred : redInv r (c • w) = (PadicInt.toZModPow (r + 1) c).val • redInv r w := by
          apply Subtype.ext; ext i
          change PadicInt.toZModPow (r + 1) (c * w.1 i) =
            (PadicInt.toZModPow (r + 1) c).val • PadicInt.toZModPow (r + 1) (w.1 i)
          rw [map_mul, nsmul_eq_mul, ZMod.natCast_zmod_val]
        rw [map_mul, hβ_spec, hβ_spec, hred, map_nsmul, AddMonoidHom.nsmul_apply,
          nsmul_eq_mul, ZMod.natCast_zmod_val]
    have hβ_smul_sys : ∀ (c : PadicInt ℓ) (w : ↥I_int) (x y : ↥sysSubgroup),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) c).val • x.1 r) →
        β w y = c * β w x := by
      intro c w x y hxy
      apply PadicInt.ext_of_toZModPow.mp
      intro k
      cases k with
      | zero => exact @Subsingleton.elim _ hSubZ0 _ _
      | succ r =>
        let _ := hNeZeroPow r
        rw [map_mul, hβ_spec, hβ_spec, hxy r, map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val]
    let β_Z_hom : ↥I_int → (ℚ →ₗ[ℤ] ↥sysSubgroup →ₗ[ℤ] Padic ℓ) := fun w =>
      LinearMap.mk₂ ℤ (fun q x => (q : Padic ℓ) * algebraMap (PadicInt ℓ) (Padic ℓ) (β w x))
        (fun q₁ q₂ x => by push_cast; ring)
        (fun n q x => by simp [zsmul_eq_mul, mul_assoc])
        (fun q x₁ x₂ => by rw [hβ_add_right, map_add, mul_add])
        (fun n q x => by
          have hβ_zsmul : β w (n • x) = n • β w x :=
            map_zsmul (AddMonoidHom.mk' (β w) (hβ_add_right w)) n x
          rw [hβ_zsmul, map_zsmul]
          simp [zsmul_eq_mul, mul_left_comm])
    let β_tp : ↥I_int → (TensorProduct ℤ ℚ ↥sysSubgroup →ₗ[ℤ] Padic ℓ) :=
      fun w => TensorProduct.lift (β_Z_hom w)
    let B_add : ↥I_int → (V →+ Padic ℓ) := fun w =>
      (β_tp w).toAddMonoidHom.comp equiv.symm.toAddMonoidHom
    have hB_add_tmul : ∀ (w : ↥I_int) (x : ↥sysSubgroup),
        B_add w (equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) =
          algebraMap (PadicInt ℓ) (Padic ℓ) (β w x) := by
      intro w x
      change TensorProduct.lift (β_Z_hom w) (equiv.symm (equiv (TensorProduct.tmul ℤ (1 : ℚ) x))) = _
      rw [equiv.symm_apply_apply, TensorProduct.lift.tmul]
      change ((1 : ℚ) : Padic ℓ) * algebraMap (PadicInt ℓ) (Padic ℓ) (β w x) = _
      rw [Rat.cast_one, one_mul]
    have hClearTP : ∀ t : TensorProduct ℤ ℚ ↥sysSubgroup,
        ∃ m : ℕ, 1 ≤ m ∧ ∃ x : ↥sysSubgroup, m • t = TensorProduct.tmul ℤ (1 : ℚ) x := by
      intro t
      refine TensorProduct.inductionOn t ?_ ?_
      · intro q x
        refine ⟨q.den, Nat.one_le_iff_ne_zero.mpr q.den_nz, q.num • x, ?_⟩
        calc q.den • (TensorProduct.tmul ℤ q x)
            = (q.den : ℤ) • (TensorProduct.tmul ℤ q x) := (natCast_zsmul _ _).symm
          _ = TensorProduct.tmul ℤ ((q.den : ℤ) • q) x := (TensorProduct.smul_tmul' _ _ _).symm
          _ = TensorProduct.tmul ℤ (q.num : ℚ) x := by
              have hq : ((q.den : ℤ) : ℚ) * q = (q.num : ℚ) := by
                rw [mul_comm]; exact Rat.mul_den_eq_num q
              simpa only [zsmul_eq_mul] using congrArg (fun r => TensorProduct.tmul ℤ r x) hq
          _ = TensorProduct.tmul ℤ (q.num • (1 : ℚ)) x := by simp [zsmul_eq_mul]
          _ = TensorProduct.tmul ℤ (1 : ℚ) (q.num • x) := TensorProduct.smul_tmul q.num (1 : ℚ) x
      · rintro t₁ t₂ ⟨m₁, hm₁, x₁, hx₁⟩ ⟨m₂, hm₂, x₂, hx₂⟩
        refine ⟨m₁ * m₂, Nat.mul_pos hm₁ hm₂, m₂ • x₁ + m₁ • x₂, ?_⟩
        have h1 : m₂ • TensorProduct.tmul ℤ (1 : ℚ) x₁ = TensorProduct.tmul ℤ (1 : ℚ) (m₂ • x₁) :=
          (map_nsmul (TensorProduct.mk ℤ ℚ ↥sysSubgroup 1) m₂ x₁).symm
        have h2 : m₁ • TensorProduct.tmul ℤ (1 : ℚ) x₂ = TensorProduct.tmul ℤ (1 : ℚ) (m₁ • x₂) :=
          (map_nsmul (TensorProduct.mk ℤ ℚ ↥sysSubgroup 1) m₁ x₂).symm
        rw [nsmul_add, mul_comm m₁ m₂, mul_smul, hx₁, mul_comm m₂ m₁, mul_smul, hx₂,
          h1, h2, ← TensorProduct.tmul_add]
    have hSysSmul : ∀ (z₀ : PadicInt ℓ) (x : ↥sysSubgroup),
        (fun r => (PadicInt.toZModPow (r + 1) z₀).val • x.1 r) ∈ sysSubgroup := by
      intro z₀ x
      rw [hsys]
      intro r
      let _ := hNeZeroPow r
      let _ := hNeZeroPow (r + 1)
      rw [map_nsmul, (hsys x.1).mp x.2 r, hcoh_rem r]
      have hcast := PadicInt.cast_toZModPow (r + 1) (r + 2) (Nat.le_succ (r + 1)) z₀
      rw [ZMod.cast_eq_val] at hcast
      have hv := congrArg ZMod.val hcast
      rw [ZMod.val_natCast] at hv
      rw [hv]
    have hLiftVec : ∀ u : Fin N → Padic ℓ,
        ∃ (k : ℕ) (w : Fin N → PadicInt ℓ),
          ∀ i : Fin N, algebraMap (PadicInt ℓ) (Padic ℓ) (w i) = ((ℓ : Padic ℓ) ^ k) * u i := by
      intro u
      let B : ℝ := ∑ j : Fin N, ‖u j‖
      have hℓ_gt1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hPrime.one_lt
      obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt (max B 1) hℓ_gt1
      have hle1 : ∀ i : Fin N, ‖((ℓ : Padic ℓ) ^ k) * u i‖ ≤ 1 := by
        intro i
        have hui : ‖u i‖ ≤ (ℓ : ℝ) ^ k := by
          have h1 : ‖u i‖ ≤ B :=
            Finset.single_le_sum (fun j _ => norm_nonneg (u j)) (Finset.mem_univ i)
          have h2 : B ≤ max B 1 := le_max_left B 1
          linarith
        rw [norm_mul, norm_pow, Padic.norm_p, inv_pow]
        have hpos : (0 : ℝ) < (ℓ : ℝ) ^ k := by positivity
        exact (inv_mul_le_iff₀ hpos).mpr (by linarith)
      exact ⟨k, fun i => ⟨((ℓ : Padic ℓ) ^ k) * u i, hle1 i⟩, fun _ => rfl⟩
    have hLiftScalar : ∀ c : Padic ℓ,
        ∃ (k : ℕ) (z₀ : PadicInt ℓ),
          ((ℓ : Padic ℓ) ^ k) * c = algebraMap (PadicInt ℓ) (Padic ℓ) z₀ := by
      intro c
      let B : ℝ := max ‖c‖ 1
      have hℓ_gt1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hPrime.one_lt
      obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt B hℓ_gt1
      have hle1 : ‖((ℓ : Padic ℓ) ^ k) * c‖ ≤ 1 := by
        have hc_le : ‖c‖ ≤ (ℓ : ℝ) ^ k := le_trans (le_max_left ‖c‖ 1) hk.le
        rw [norm_mul, norm_pow, Padic.norm_p, inv_pow]
        have hpos : (0 : ℝ) < (ℓ : ℝ) ^ k := by positivity
        exact (inv_mul_le_iff₀ hpos).mpr (by linarith)
      exact ⟨k, ⟨((ℓ : Padic ℓ) ^ k) * c, hle1⟩, rfl⟩
    have hB_smul_R : ∀ (w : ↥I_int) (z₀ : PadicInt ℓ) (v : V),
        B_add w ((z₀ : Padic ℓ) • v) = (z₀ : Padic ℓ) * B_add w v := by
      intro w z₀ v
      obtain ⟨m, hm, x, hx⟩ := hClearTP (equiv.symm v)
      have hm_v : m • v = equiv (TensorProduct.tmul ℤ (1 : ℚ) x) := by
        calc m • v = equiv (equiv.symm (m • v)) := (equiv.apply_symm_apply _).symm
          _ = equiv (m • equiv.symm v) := by rw [map_nsmul]
          _ = equiv (TensorProduct.tmul ℤ (1 : ℚ) x) := by rw [hx]
      let y : ↥sysSubgroup := ⟨_, hSysSmul z₀ x⟩
      have hy : equiv (TensorProduct.tmul ℤ (1 : ℚ) y) =
          (z₀ : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x) :=
        hsmul z₀ x y (fun _ => rfl)
      have hm_ne : (m : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      apply mul_left_cancel₀ hm_ne
      calc (m : Padic ℓ) * B_add w ((z₀ : Padic ℓ) • v)
          = m • B_add w ((z₀ : Padic ℓ) • v) := (nsmul_eq_mul m _).symm
        _ = B_add w (m • ((z₀ : Padic ℓ) • v)) := (map_nsmul (B_add w) m _).symm
        _ = B_add w ((z₀ : Padic ℓ) • (m • v)) := by rw [smul_comm]
        _ = B_add w (equiv (TensorProduct.tmul ℤ (1 : ℚ) y)) := by rw [hm_v, hy]
        _ = algebraMap (PadicInt ℓ) (Padic ℓ) (β w y) := hB_add_tmul w y
        _ = algebraMap (PadicInt ℓ) (Padic ℓ) (z₀ * β w x) := by
            rw [hβ_smul_sys z₀ w x y (fun _ => rfl)]
        _ = (z₀ : Padic ℓ) * B_add w (m • v) := by
            rw [map_mul, halg_coe, hm_v, hB_add_tmul w x]
        _ = (z₀ : Padic ℓ) * ((m : Padic ℓ) * B_add w v) := by rw [map_nsmul, nsmul_eq_mul]
        _ = (m : Padic ℓ) * ((z₀ : Padic ℓ) * B_add w v) := by ring
    let B_int : ↥I_int → (V →ₗ[Padic ℓ] Padic ℓ) := fun w =>
      { toFun := B_add w
        map_add' := (B_add w).map_add
        map_smul' := fun c v => by
          obtain ⟨k, z₀, hcz⟩ := hLiftScalar c
          have hpow_ne : ((ℓ : Padic ℓ) ^ k) ≠ 0 := pow_ne_zero k hℓ_K_ne
          apply mul_left_cancel₀ hpow_ne
          have h1 : ((ℓ : Padic ℓ) ^ k) • (c • v) = (z₀ : Padic ℓ) • v := by
            rw [← mul_smul, hcz, halg_coe]
          have hℓk_R : ((ℓ : Padic ℓ) ^ k) = (((ℓ : PadicInt ℓ) ^ k : PadicInt ℓ) : Padic ℓ) := rfl
          calc ((ℓ : Padic ℓ) ^ k) * B_add w (c • v)
              = B_add w (((ℓ : Padic ℓ) ^ k) • (c • v)) := by
                  rw [hℓk_R, ← hB_smul_R w ((ℓ : PadicInt ℓ) ^ k) (c • v)]
            _ = B_add w ((z₀ : Padic ℓ) • v) := by rw [h1]
            _ = (z₀ : Padic ℓ) * B_add w v := hB_smul_R w z₀ v
            _ = ((ℓ : Padic ℓ) ^ k) * (c • B_add w v) := by
                  rw [← halg_coe, ← hcz, smul_eq_mul, mul_assoc] }
    have hB_int_tmul : ∀ (w : ↥I_int) (x : ↥sysSubgroup),
        B_int w (equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) =
          algebraMap (PadicInt ℓ) (Padic ℓ) (β w x) := hB_add_tmul
    have hB_int_add : ∀ w₁ w₂ : ↥I_int, B_int (w₁ + w₂) = B_int w₁ + B_int w₂ := by
      intro w₁ w₂
      ext v
      obtain ⟨m, hm, x, hx⟩ := hClearTP (equiv.symm v)
      have hm_v : m • v = equiv (TensorProduct.tmul ℤ (1 : ℚ) x) := by
        rw [← equiv.apply_symm_apply (m • v), map_nsmul, hx]
      have hm_ne : (m : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      apply mul_left_cancel₀ hm_ne
      calc (m : Padic ℓ) * B_int (w₁ + w₂) v
          = B_int (w₁ + w₂) (m • v) := by rw [map_nsmul, nsmul_eq_mul]
        _ = algebraMap (PadicInt ℓ) (Padic ℓ) (β (w₁ + w₂) x) := by
            rw [hm_v]; exact hB_int_tmul (w₁ + w₂) x
        _ = algebraMap (PadicInt ℓ) (Padic ℓ) (β w₁ x) +
              algebraMap (PadicInt ℓ) (Padic ℓ) (β w₂ x) := by rw [hβ_add_left, map_add]
        _ = B_int w₁ (m • v) + B_int w₂ (m • v) := by
            rw [hm_v, hB_int_tmul w₁ x, hB_int_tmul w₂ x]
        _ = (m : Padic ℓ) * (B_int w₁ v + B_int w₂ v) := by
            rw [map_nsmul, map_nsmul, nsmul_eq_mul, nsmul_eq_mul, mul_add]
    have hB_int_smul : ∀ (c : PadicInt ℓ) (w : ↥I_int),
        B_int (c • w) = algebraMap (PadicInt ℓ) (Padic ℓ) c • B_int w := by
