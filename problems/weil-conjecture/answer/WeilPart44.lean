          intro p₁ p₂ hd₁ hd₂ hγ
          apply Subtype.ext
          apply sub_eq_zero.mp
          apply hCone.2.2.2 (p₁.1 - p₂.1)
          · rw [map_sub, (hP₀_mem p₁.1).mp p₁.2, (hP₀_mem p₂.1).mp p₂.2]
