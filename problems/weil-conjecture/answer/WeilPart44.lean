        change algebraMap (PadicInt ℓ) (Padic ℓ) (((ℓ : PadicInt ℓ) ^ k₂) * w₁.1 i) =
          algebraMap (PadicInt ℓ) (Padic ℓ) (((ℓ : PadicInt ℓ) ^ k₁) * w₂.1 i)
        rw [map_mul, map_mul, map_pow, map_pow, halg_ℓ, hw₁ i, hw₂ i]
