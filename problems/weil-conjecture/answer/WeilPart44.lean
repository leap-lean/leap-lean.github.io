        = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R0_bar B_bar)) ≫
            ((e_Ubar.hom ≫ U_bar.ι) ≫ pr_D) := by
          simp only [CategoryTheory.Category.assoc]
