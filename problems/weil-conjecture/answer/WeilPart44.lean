          · change d₀ ((MonoidAlgebra.single σ (1 : Λ) : R) • Φ0_tilde (p₀_raw x).1) = 0
            have hc : d₀ (Φ0_tilde (p₀_raw x).1) = Φ₁ (d₀ (p₀_raw x).1) :=
