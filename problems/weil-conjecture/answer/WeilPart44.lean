    let t₂ : C₂ →ₗ[Λ_s] I₁ := k_M2 - ψ₁.comp s₂ + s₂.comp f₂
    let Δ₂ : C₂ →ₗ[Λ_s] C'₂ := f'₂.comp β₂ - β₂.comp f₂
    have h_k2_cond : ∀ j : Fin r_2,
        δI₁ (- t₂ (b_C2 j)) + γ_F₂ (Δ₂ (b_C2 j)) = 0 := by
      intro j
      let x := b_C2 j
      have h_γ_Δ : γ_F₂ (Δ₂ x) = δI₁ (t₂ x) := by
        change γ_F₂ (f'₂ (β₂ x) - β₂ (f₂ x)) = δI₁ (k_M2 x - ψ₁ (s₂ x) + s₂ (f₂ x))
        have h1 : γ_F₂ (f'₂ (β₂ x)) = ψ₂ (γ_F₂ (β₂ x)) := (LinearMap.congr_fun hγF_φ₂ (β₂ x)).symm
        have h2_raw : δI₁ (s₂ x) + γ_F₂ (β₂ x) = α₂ x := LinearMap.congr_fun h_α₂_β₂ x
        have h2 : γ_F₂ (β₂ x) = α₂ x - δI₁ (s₂ x) := sub_eq_zero.mp (by rw [← h2_raw]; abel)
        have h3_raw : δI₁ (s₂ (f₂ x)) + γ_F₂ (β₂ (f₂ x)) = α₂ (f₂ x) :=
          LinearMap.congr_fun h_α₂_β₂ (f₂ x)
        have h3 : γ_F₂ (β₂ (f₂ x)) = α₂ (f₂ x) - δI₁ (s₂ (f₂ x)) :=
          sub_eq_zero.mp (by rw [← h3_raw]; abel)
        have h4 : ψ₂ (δI₁ (s₂ x)) = δI₁ (ψ₁ (s₂ x)) := (LinearMap.congr_fun hψ₁_comm (s₂ x)).symm
        have h5_raw : ψ₂ (α₂ x) - α₂ (f₂ x) = δI₁ (k_M2 x) := LinearMap.congr_fun h_α_htpy2 x
        have h5 : ψ₂ (α₂ x) = α₂ (f₂ x) + δI₁ (k_M2 x) := by
          rw [eq_add_of_sub_eq h5_raw]; abel
        rw [map_sub, h1, h2, h3, map_sub ψ₂, h5, h4, map_add δI₁, map_sub δI₁]
        abel
      rw [map_neg, h_γ_Δ, neg_add_cancel]
    choose t1_neg_vec k2_neg_vec h_k2_lift using fun j : Fin r_2 => hCone_F1 _ _ (h_k2_cond j)
    let t₁ : C₂ →ₗ[Λ_s] I₀ := - b_C2.constr Λ_s t1_neg_vec
    let k₂ : C₂ →ₗ[Λ_s] C'₁ := - b_C2.constr Λ_s k2_neg_vec
    have h_β_htpy2 : dF₁.comp k₂ = f'₂.comp β₂ - β₂.comp f₂ := by
      apply b_C2.ext; intro j
      simp only [LinearMap.comp_apply, LinearMap.neg_apply, k₂, Module.Basis.constr_basis, map_neg]
      exact (h_k2_lift j).2
    have h_t1_rel : δI₀.comp t₁ + γ_F₁.comp k₂ = t₂ := by
      apply b_C2.ext; intro j
      simp only [LinearMap.add_apply, LinearMap.comp_apply, LinearMap.neg_apply,
        t₁, k₂, Module.Basis.constr_basis, map_neg]
      have hj := (h_k2_lift j).1
      have hsum : -δI₀ (t1_neg_vec j) + -γ_F₁ (k2_neg_vec j) =
          -(δI₀ (t1_neg_vec j) + γ_F₁ (k2_neg_vec j)) := by abel
      rw [hsum, hj, neg_neg]
    let u₁_map : C₁ →ₗ[Λ_s] I₀ := k_M1 - ψ₀.comp s₁ + s₁.comp f₁ + t₁.comp dC₁
    let Δ₁ : C₁ →ₗ[Λ_s] C'₁ := f'₁.comp β₁ - β₁.comp f₁ - k₂.comp dC₁
    have h_k1_cond1 : ∀ j : Fin r_1,
        δI₀ (- u₁_map (b_C1 j)) + γ_F₁ (Δ₁ (b_C1 j)) = 0 := by
      intro j
      let x := b_C1 j
      have h_γ_Δ1 : γ_F₁ (Δ₁ x) = δI₀ (u₁_map x) := by
        change γ_F₁ (f'₁ (β₁ x) - β₁ (f₁ x) - k₂ (dC₁ x)) =
          δI₀ (k_M1 x - ψ₀ (s₁ x) + s₁ (f₁ x) + t₁ (dC₁ x))
        have h1 : γ_F₁ (f'₁ (β₁ x)) = ψ₁ (γ_F₁ (β₁ x)) := (LinearMap.congr_fun hγF_φ₁ (β₁ x)).symm
        have h2_raw : δI₀ (s₁ x) + γ_F₁ (β₁ x) = α₁ x - s₂ (dC₁ x) :=
          LinearMap.congr_fun h_α₁_β₁ x
        have h2 : γ_F₁ (β₁ x) = α₁ x - s₂ (dC₁ x) - δI₀ (s₁ x) :=
          sub_eq_zero.mp (by rw [← h2_raw]; abel)
        have h3_raw : δI₀ (s₁ (f₁ x)) + γ_F₁ (β₁ (f₁ x)) = α₁ (f₁ x) - s₂ (dC₁ (f₁ x)) :=
          LinearMap.congr_fun h_α₁_β₁ (f₁ x)
        have h3 : γ_F₁ (β₁ (f₁ x)) = α₁ (f₁ x) - s₂ (dC₁ (f₁ x)) - δI₀ (s₁ (f₁ x)) :=
          sub_eq_zero.mp (by rw [← h3_raw]; abel)
        have h4 : ψ₁ (δI₀ (s₁ x)) = δI₀ (ψ₀ (s₁ x)) := (LinearMap.congr_fun hψ₀_comm (s₁ x)).symm
        have h5_raw : ψ₁ (α₁ x) - α₁ (f₁ x) = δI₀ (k_M1 x) + k_M2 (dC₁ x) :=
          LinearMap.congr_fun h_α_htpy1 x
        have h5 : ψ₁ (α₁ x) = α₁ (f₁ x) + δI₀ (k_M1 x) + k_M2 (dC₁ x) := by
          rw [eq_add_of_sub_eq h5_raw]; abel
        have h6 : dC₁ (f₁ x) = f₂ (dC₁ x) := LinearMap.congr_fun h_dC₁_f₁ x
        have h7 : γ_F₁ (k₂ (dC₁ x)) =
            k_M2 (dC₁ x) - ψ₁ (s₂ (dC₁ x)) + s₂ (f₂ (dC₁ x)) - δI₀ (t₁ (dC₁ x)) :=
          sub_eq_zero.mp (by
            have ht : δI₀ (t₁ (dC₁ x)) + γ_F₁ (k₂ (dC₁ x)) =
                k_M2 (dC₁ x) - ψ₁ (s₂ (dC₁ x)) + s₂ (f₂ (dC₁ x)) :=
              LinearMap.congr_fun h_t1_rel (dC₁ x)
            rw [← ht]; abel)
        rw [map_sub, map_sub, h1, h2, h3, h6, h7, map_sub ψ₁, map_sub ψ₁, h5, h4,
          map_add δI₀, map_add δI₀, map_sub δI₀]
        abel
      rw [map_neg, h_γ_Δ1, neg_add_cancel]
    have h_k1_cond2 : ∀ j : Fin r_1, dF₁ (Δ₁ (b_C1 j)) = 0 := by
      intro j
      let x := b_C1 j
      change dF₁ (f'₁ (β₁ x) - β₁ (f₁ x) - k₂ (dC₁ x)) = 0
      have h1 : dF₁ (f'₁ (β₁ x)) = f'₂ (dF₁ (β₁ x)) := LinearMap.congr_fun h_dF₁_f'₁ (β₁ x)
      have h2 : dF₁ (β₁ x) = β₂ (dC₁ x) := LinearMap.congr_fun h_dF₁_β₁ x
      have h3 : dF₁ (β₁ (f₁ x)) = β₂ (dC₁ (f₁ x)) := LinearMap.congr_fun h_dF₁_β₁ (f₁ x)
      have h4 : dC₁ (f₁ x) = f₂ (dC₁ x) := LinearMap.congr_fun h_dC₁_f₁ x
      have h5 : dF₁ (k₂ (dC₁ x)) = f'₂ (β₂ (dC₁ x)) - β₂ (f₂ (dC₁ x)) :=
        LinearMap.congr_fun h_β_htpy2 (dC₁ x)
      rw [map_sub, map_sub, h1, h2, h3, h4, h5]; abel
    choose k1_neg_vec h_k1_lift using fun j : Fin r_1 => hCone_F0 _ _ (h_k1_cond1 j) (h_k1_cond2 j)
    let k₁ : C₁ →ₗ[Λ_s] C'₀ := - b_C1.constr Λ_s k1_neg_vec
    have h_β_htpy1 : f'₁.comp β₁ - β₁.comp f₁ = dF₀.comp k₁ + k₂.comp dC₁ := by
      apply b_C1.ext; intro j
      simp only [LinearMap.sub_apply, LinearMap.add_apply, LinearMap.comp_apply,
        LinearMap.neg_apply, k₁, Module.Basis.constr_basis, map_neg]
      have hj : - dF₀ (k1_neg_vec j) = Δ₁ (b_C1 j) := (h_k1_lift j).2
      change f'₁ (β₁ _) - β₁ (f₁ _) = - dF₀ (k1_neg_vec j) + k₂ (dC₁ _)
      rw [hj]
      change _ = (f'₁ (β₁ _) - β₁ (f₁ _) - k₂ (dC₁ _)) + k₂ (dC₁ _)
      abel
    have h_k1_γ : γ_F₀.comp k₁ = u₁_map := by
      apply b_C1.ext; intro j
      simp only [LinearMap.comp_apply, LinearMap.neg_apply, k₁, Module.Basis.constr_basis, map_neg]
      exact neg_inj.mp (by rw [neg_neg]; exact (h_k1_lift j).1)
    have h_β_htpy0 : f'₀.comp β₀ - β₀.comp f₀ = k₁.comp dC₀ := by
      apply LinearMap.ext; intro p
      apply sub_eq_zero.mp
      apply hH0_F_inj
      · change dF₀ (f'₀ (β₀ p) - β₀ (f₀ p) - k₁ (dC₀ p)) = 0
        have h1 : dF₀ (f'₀ (β₀ p)) = f'₁ (dF₀ (β₀ p)) := LinearMap.congr_fun h_dF₀_f'₀ (β₀ p)
        have h2 : dF₀ (β₀ p) = β₁ (dC₀ p) := LinearMap.congr_fun h_dF₀_β₀ p
        have h3 : dF₀ (β₀ (f₀ p)) = β₁ (dC₀ (f₀ p)) := LinearMap.congr_fun h_dF₀_β₀ (f₀ p)
        have h4 : dC₀ (f₀ p) = f₁ (dC₀ p) := LinearMap.congr_fun h_dC₀_f₀ p
        have h5 : f'₁ (β₁ (dC₀ p)) - β₁ (f₁ (dC₀ p)) = dF₀ (k₁ (dC₀ p)) + k₂ (dC₁ (dC₀ p)) :=
          LinearMap.congr_fun h_β_htpy1 (dC₀ p)
        have h6 : dC₁ (dC₀ p) = 0 := LinearMap.congr_fun h_dC₁_dC₀ p
        rw [h6, map_zero, add_zero] at h5
        rw [map_sub, map_sub, h1, h2, h3, h4, sub_eq_zero]
        exact h5
      · change γ_F₀ (f'₀ (β₀ p) - β₀ (f₀ p) - k₁ (dC₀ p)) = 0
        have h1 : γ_F₀ (f'₀ (β₀ p)) = ψ₀ (γ_F₀ (β₀ p)) := (LinearMap.congr_fun hγF_φ₀ (β₀ p)).symm
        have h2 : γ_F₀ (β₀ p) = α₀ p - s₁ (dC₀ p) := LinearMap.congr_fun h_α₀_β₀ p
        have h3 : γ_F₀ (β₀ (f₀ p)) = α₀ (f₀ p) - s₁ (dC₀ (f₀ p)) :=
          LinearMap.congr_fun h_α₀_β₀ (f₀ p)
        have h4 : dC₀ (f₀ p) = f₁ (dC₀ p) := LinearMap.congr_fun h_dC₀_f₀ p
        have h5_raw : ψ₀ (α₀ p) - α₀ (f₀ p) = k_M1 (dC₀ p) := LinearMap.congr_fun h_α_htpy0 p
        have h5 : ψ₀ (α₀ p) = α₀ (f₀ p) + k_M1 (dC₀ p) := sub_eq_zero.mp (by rw [← h5_raw]; abel)
        have h6 : γ_F₀ (k₁ (dC₀ p)) =
            k_M1 (dC₀ p) - ψ₀ (s₁ (dC₀ p)) + s₁ (f₁ (dC₀ p)) + t₁ (dC₁ (dC₀ p)) :=
          LinearMap.congr_fun h_k1_γ (dC₀ p)
        have h7 : dC₁ (dC₀ p) = 0 := LinearMap.congr_fun h_dC₁_dC₀ p
        rw [h7, map_zero, add_zero] at h6
        rw [map_sub, map_sub, h1, h2, h3, h4, h6, map_sub ψ₀, h5]
        abel
    let A₀ := ↥C₀_sub
    let A₁ := C'₀ × C₁
    let A₂ := C'₁ × C₂
    let A₃ := C'₂
    let E₀ : A₀ →ₗ[Λ_s] A₁ := LinearMap.prod β₀ (- dC₀)
    let E₁ : A₁ →ₗ[Λ_s] A₂ :=
      LinearMap.prod
        (dF₀.comp (LinearMap.fst Λ_s C'₀ C₁) + β₁.comp (LinearMap.snd Λ_s C'₀ C₁))
        (- dC₁.comp (LinearMap.snd Λ_s C'₀ C₁))
    let E₂ : A₂ →ₗ[Λ_s] A₃ :=
      dF₁.comp (LinearMap.fst Λ_s C'₁ C₂) + β₂.comp (LinearMap.snd Λ_s C'₁ C₂)
    have hE₂_E₁ : ∀ a₁ : A₁, E₂ (E₁ a₁) = 0 := by
      rintro ⟨c'₀, c₁⟩
      change dF₁ (dF₀ c'₀ + β₁ c₁) + β₂ (- dC₁ c₁) = 0
      have h1 : dF₁ (dF₀ c'₀) = 0 := LinearMap.congr_fun h_dF₁_dF₀ c'₀
      have h2 : dF₁ (β₁ c₁) = β₂ (dC₁ c₁) := LinearMap.congr_fun h_dF₁_β₁ c₁
      rw [map_add, h1, zero_add, h2, map_neg, add_neg_cancel]
    have hE₁_E₀ : ∀ a₀ : A₀, E₁ (E₀ a₀) = 0 := by
      intro a₀
      refine Prod.ext ?_ ?_
      · change dF₀ (β₀ a₀) + β₁ (- dC₀ a₀) = 0
        have h1 : dF₀ (β₀ a₀) = β₁ (dC₀ a₀) := LinearMap.congr_fun h_dF₀_β₀ a₀
        rw [h1, map_neg, add_neg_cancel]
      · change - dC₁ (- dC₀ a₀) = 0
        have h1 : dC₁ (dC₀ a₀) = 0 := LinearMap.congr_fun h_dC₁_dC₀ a₀
        rw [map_neg, h1, neg_zero, neg_zero]
    have hE₀_inj : Function.Injective E₀ := by
      intro a₀ b₀ h
      apply sub_eq_zero.mp
      have h0 : E₀ (a₀ - b₀) = 0 := by rw [map_sub, h, sub_self]
      have hβ0 : β₀ (a₀ - b₀) = 0 := congrArg Prod.fst h0
      have hdC0 : dC₀ (a₀ - b₀) = 0 := neg_eq_zero.mp (congrArg Prod.snd h0)
      have hα0 : α₀ (a₀ - b₀) = 0 := by
        have h1 : γ_F₀ (β₀ (a₀ - b₀)) = α₀ (a₀ - b₀) - s₁ (dC₀ (a₀ - b₀)) :=
          LinearMap.congr_fun h_α₀_β₀ (a₀ - b₀)
        rw [hβ0, map_zero, hdC0, map_zero, sub_zero] at h1
        exact h1.symm
      exact hCone_α0_inj (a₀ - b₀) hα0 hdC0
    have hE₂_surj : Function.Surjective E₂ := by
      intro c'₂
      obtain ⟨y₁, c₂, h1⟩ := hCone_α2 (γ_F₂ c'₂)
      have h2 : δI₁ (s₂ c₂) + γ_F₂ (β₂ c₂) = α₂ c₂ := LinearMap.congr_fun h_α₂_β₂ c₂
      have h_im : c'₂ - β₂ c₂ ∈ LinearMap.range dF₁ :=
        hH2_F_inj (c'₂ - β₂ c₂) ⟨y₁ + s₂ c₂, by rw [map_sub, map_add, ← h1, ← h2]; abel⟩
      rcases h_im with ⟨c'₁, hc'₁⟩
      exact ⟨(c'₁, c₂), by change dF₁ c'₁ + β₂ c₂ = c'₂; rw [hc'₁]; abel⟩
    have hE₂_ker : ∀ a₂ : A₂, E₂ a₂ = 0 → ∃ a₁ : A₁, E₁ a₁ = a₂ := by
      rintro ⟨c'₁, c₂⟩ h0
      have h0' : dF₁ c'₁ + β₂ c₂ = 0 := h0
      have h_α2_c2 : δI₁ (γ_F₁ c'₁ - s₂ c₂) + α₂ c₂ = 0 := by
        have h1 : δI₁ (γ_F₁ c'₁) = γ_F₂ (dF₁ c'₁) := LinearMap.congr_fun hγF_d₁ c'₁
        have h2_raw : δI₁ (s₂ c₂) + γ_F₂ (β₂ c₂) = α₂ c₂ := LinearMap.congr_fun h_α₂_β₂ c₂
        have h2 : α₂ c₂ = δI₁ (s₂ c₂) + γ_F₂ (β₂ c₂) := h2_raw.symm
        have h3 : γ_F₂ (dF₁ c'₁) = - γ_F₂ (β₂ c₂) :=
          eq_neg_of_add_eq_zero_left (by rw [← map_add, h0', map_zero])
        rw [map_sub, h2, h1, h3]; abel
      obtain ⟨y₀, u₁, hu₁_α, hu₁_d⟩ := hCone_α1 _ c₂ h_α2_c2
      have h_d1_diff : dF₁ (c'₁ - β₁ u₁) = 0 := by
        have h1 : dF₁ (β₁ u₁) = β₂ (dC₁ u₁) := LinearMap.congr_fun h_dF₁_β₁ u₁
        have h2 : dC₁ u₁ = - c₂ := neg_eq_iff_eq_neg.mp hu₁_d
        rw [map_sub, h1, h2, map_neg, sub_neg_eq_add, h0']
      have h_im : c'₁ - β₁ u₁ ∈ LinearMap.range dF₀ := by
        apply hH1_F_inj _ h_d1_diff
        refine ⟨y₀ + s₁ u₁, ?_⟩
        have h1 : δI₀ (s₁ u₁) + γ_F₁ (β₁ u₁) = α₁ u₁ - s₂ (dC₁ u₁) :=
          LinearMap.congr_fun h_α₁_β₁ u₁
        have h2 : dC₁ u₁ = - c₂ := neg_eq_iff_eq_neg.mp hu₁_d
        rw [h2, map_neg, sub_neg_eq_add] at h1
        have h1' : α₁ u₁ + s₂ c₂ = δI₀ (s₁ u₁) + γ_F₁ (β₁ u₁) := h1.symm
        have hγc : γ_F₁ c'₁ = δI₀ y₀ + α₁ u₁ + s₂ c₂ := eq_add_of_sub_eq hu₁_α.symm
        rw [map_sub, map_add, hγc, add_assoc (δI₀ y₀), h1']; abel
      rcases h_im with ⟨c'₀, hc'₀⟩
      exact ⟨(c'₀, u₁), Prod.ext (by change dF₀ c'₀ + β₁ u₁ = c'₁; rw [hc'₀]; abel) hu₁_d⟩
    have hE₁_ker : ∀ a₁ : A₁, E₁ a₁ = 0 → ∃ a₀ : A₀, E₀ a₀ = a₁ := by
      rintro ⟨c'₀, c₁⟩ h0
      have h1 : dF₀ c'₀ + β₁ c₁ = 0 := congrArg Prod.fst h0
      have h2 : dC₁ c₁ = 0 := neg_eq_zero.mp (congrArg Prod.snd h0)
      have h_α1_c1 : δI₀ (γ_F₀ c'₀ - s₁ c₁) + α₁ c₁ = 0 := by
        have hc : δI₀ (γ_F₀ c'₀) = γ_F₁ (dF₀ c'₀) := LinearMap.congr_fun hγF_d₀ c'₀
        have hs : δI₀ (s₁ c₁) + γ_F₁ (β₁ c₁) = α₁ c₁ - s₂ (dC₁ c₁) := LinearMap.congr_fun h_α₁_β₁ c₁
        rw [h2, map_zero, sub_zero] at hs
        have hd : γ_F₁ (dF₀ c'₀) = - γ_F₁ (β₁ c₁) :=
          eq_neg_of_add_eq_zero_left (by rw [← map_add, h1, map_zero])
        rw [map_sub, hc, hd, ← hs]; abel
      obtain ⟨a₀, ha₀_α, ha₀_d⟩ := hCone_α0 _ c₁ h_α1_c1 h2
      have hc'₀_eq : β₀ a₀ = c'₀ := by
        symm; apply sub_eq_zero.mp
        apply hH0_F_inj
        · have hd : dF₀ (β₀ a₀) = β₁ (dC₀ a₀) := LinearMap.congr_fun h_dF₀_β₀ a₀
          have ha : dC₀ a₀ = - c₁ := neg_eq_iff_eq_neg.mp ha₀_d
          rw [map_sub, hd, ha, map_neg, sub_neg_eq_add, h1]
        · have hγ : γ_F₀ (β₀ a₀) = α₀ a₀ - s₁ (dC₀ a₀) := LinearMap.congr_fun h_α₀_β₀ a₀
          have ha : dC₀ a₀ = - c₁ := neg_eq_iff_eq_neg.mp ha₀_d
          rw [map_sub, hγ, ha, map_neg, sub_neg_eq_add, ha₀_α]; abel
      exact ⟨a₀, Prod.ext hc'₀_eq ha₀_d⟩
    let Θ₀ : A₀ →ₗ[Λ_s] A₀ := f₀
    let Θ₁ : A₁ →ₗ[Λ_s] A₁ :=
      (f'₀.prodMap f₁) + (LinearMap.inl Λ_s C'₀ C₁).comp (k₁.comp (LinearMap.snd Λ_s C'₀ C₁))
    let Θ₂ : A₂ →ₗ[Λ_s] A₂ :=
      (f'₁.prodMap f₂) + (LinearMap.inl Λ_s C'₁ C₂).comp (k₂.comp (LinearMap.snd Λ_s C'₁ C₂))
    let Θ₃ : A₃ →ₗ[Λ_s] A₃ := f'₂
    have hΘ_comm0 : E₀.comp Θ₀ = Θ₁.comp E₀ := by
      apply LinearMap.ext; intro a₀
      refine Prod.ext ?_ ?_
