  let η_raw : ∀ r : ℕ,
      { lam : Fin N → ZMod (ℓ ^ (r + 1)) // ∀ h ∈ H_mat_r r, (h.transpose).mulVec lam = lam } →
        Quiver.Hom (𝒥₀ r) (R_pr.obj (weilEtaleTorsionSheaf S (ℓ ^ (r + 1)))) :=
