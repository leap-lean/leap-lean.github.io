    have h0_push : ((T_sh.mapExtAddHom oneR (R_sh.obj oneR) 1) 0).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app oneR)) (Nat.add_zero 1) = 0 := by
      rw [map_zero, CategoryTheory.Abelian.Ext.zero_comp]
    have hw_R0 : w_R = 0 := hInj_adj (hw_R_push.trans h0_push.symm)
    have h_end := congrArg
      (fun z => z.comp (CategoryTheory.Abelian.Ext.mk₀ e_dual.inv) (Nat.add_zero 1)) hw_R0
