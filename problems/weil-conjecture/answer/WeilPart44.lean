    have hpb₁ : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom ι_V)
        (CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom ι_V)
        (Fgt.obj W₁).hom ι_V :=
