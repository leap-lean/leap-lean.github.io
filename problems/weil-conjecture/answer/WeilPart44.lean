    exact ⟨m_ι, hm_fst, hm_snd, hSurj_m.surj⟩

  have hCatMate : ∀ {𝒞 𝒟 : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
      (L : CategoryTheory.Functor 𝒟 𝒞)
      {X₀ Y₀ : 𝒟} {Z₀ W₀ : 𝒞}
