            have hexp1 : ℓ ^ (s + 1) = ℓ * ℓ ^ s := by ring
            rw [hexp1, pow_mul, hw_pow] at hw_prev
            have hdvd_bad : ℓ ^ (s + 1) ∣ ℓ ^ s := (hu.pow_eq_one_iff_dvd (ℓ ^ s)).mp hw_prev
            have hle_bad : ℓ ^ (s + 1) ≤ ℓ ^ s := Nat.le_of_dvd (pow_pos hℓ_pos s) hdvd_bad
            have hlt_good : ℓ ^ s < ℓ ^ (s + 1) :=
