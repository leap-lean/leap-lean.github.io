      exact CategoryTheory.mono_of_mono (n • 𝟙 K') ι
    have hLiftModHom : ∀ {M N : ModuleCat.{u, u} R} (g : FgtMod.obj M ⟶ FgtMod.obj N),
        ∃ g_mod : M ⟶ N, FgtMod.map g_mod = g := by
      intro M N g
      refine ⟨ModuleCat.ofHom
        { toFun := g.hom
          map_add' := g.hom.map_add
          map_smul' := fun r x => by
            obtain ⟨z, hz⟩ := ZMod.intCast_surjective r.down
            have hzr : (z : R) = r := by ext; exact hz
            simp only [RingHom.id_apply, ← hzr]
            rw [Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul]
            exact map_zsmul g.hom z x }, ?_⟩
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      rfl
    have hModHomInj : ∀ {M N : ModuleCat.{u, u} R} {g₁ g₂ : M ⟶ N},
        FgtMod.map g₁ = FgtMod.map g₂ → g₁ = g₂ := by
      intro M N g₁ g₂ h
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      exact congrArg (fun k => k.hom x) h
    have hUFull : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)}
        (φ : U.obj ℱ₁ ⟶ U.obj ℱ₂), ∃ ψ : ℱ₁ ⟶ ℱ₂, U.map ψ = φ := by
      intro ℱ₁ ℱ₂ φ
      let app_mod : ∀ W : (S.Etale)ᵒᵖ, ℱ₁.obj.obj W ⟶ ℱ₂.obj.obj W :=
