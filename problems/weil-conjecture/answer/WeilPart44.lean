    let w_R : CategoryTheory.Abelian.Ext.{u} oneR (R_sh.obj oneR) 1 :=
      w.comp (CategoryTheory.Abelian.Ext.mk₀ e_dual.hom) (Nat.add_zero 1)
    have hw_R_push : ((T_sh.mapExtAddHom oneR (R_sh.obj oneR) 1) w_R).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app oneR)) (Nat.add_zero 1) = 0 := by
      change (CategoryTheory.Abelian.Ext.mapExactFunctor T_sh w_R).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app oneR)) (Nat.add_zero 1) = 0
      dsimp [w_R]
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _
          (Nat.add_zero 1) (Nat.zero_add 0) (Nat.add_zero 1),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
