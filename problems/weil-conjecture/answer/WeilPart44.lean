  have mkInjSES : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u + 1} C]
      [CategoryTheory.Abelian C] [CategoryTheory.EnoughInjectives C] (X : C),
      ∃ (I Q : C) (i : X ⟶ I) (p : I ⟶ Q) (h0 : i ≫ p = 0),
        CategoryTheory.Injective I ∧
        (CategoryTheory.ShortComplex.mk i p h0).ShortExact := by
    intro C _ _ _ X
    let I := CategoryTheory.Injective.under X
    let i : X ⟶ I := CategoryTheory.Injective.ι X
    let Q := CategoryTheory.Limits.cokernel i
    let p : I ⟶ Q := CategoryTheory.Limits.cokernel.π i
