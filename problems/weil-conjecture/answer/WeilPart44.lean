    have hFin_P0 : Module.Finite Λ ↥P₀_sub :=
      Module.Finite.of_surjective e₀_Λ.rangeRestrict e₀_Λ.surjective_rangeRestrict
    have hProj_P0 : Module.Projective Λ ↥P₀_sub :=
      Module.Projective.of_split P₀_sub.subtype e₀_Λ.rangeRestrict hP₀_split
    have hFlat_P0 : Module.Flat Λ ↥P₀_sub := Module.Flat.of_projective
    have hFree_P0 : Module.Free Λ ↥P₀_sub := Module.free_of_flat_of_isLocalRing
    let e₀'_Λ : (Fin m₀ → R) →ₗ[Λ] (Fin m₀ → R) := LinearMap.id - e₀_Λ
    let K₀_sub : Submodule Λ (Fin m₀ → R) := LinearMap.range e₀'_Λ
