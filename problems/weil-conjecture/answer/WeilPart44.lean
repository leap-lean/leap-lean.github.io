            (CategoryTheory.Limits.pullback.snd h_X (ι_V (r + 1))) (p_ι r) →
        m_ι = m_ι_can r h_X := by
      intro r X h_X m_ι hfst hsnd
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [hfst, CategoryTheory.Limits.pullback.lift_fst]
      · rw [hsnd, CategoryTheory.Limits.pullback.lift_snd]
    have hPb_m : ∀ (r : ℕ) {X : AlgebraicGeometry.Scheme.{u}} (h_X : Quiver.Hom X S),
        CategoryTheory.IsPullback (m_ι_can r h_X)
          (CategoryTheory.Limits.pullback.snd h_X (ι_V (r + 1)))
          (CategoryTheory.Limits.pullback.snd h_X (ι_V r)) (p_ι r) := by
      intro r X h_X
      have hOuter : CategoryTheory.IsPullback
          (m_ι_can r h_X ≫ CategoryTheory.Limits.pullback.fst h_X (ι_V r))
          (CategoryTheory.Limits.pullback.snd h_X (ι_V (r + 1)))
          h_X (p_ι r ≫ ι_V r) := by
        rw [CategoryTheory.Limits.pullback.lift_fst, hp_ι_V r]
        exact CategoryTheory.IsPullback.of_hasPullback h_X (ι_V (r + 1))
      exact CategoryTheory.IsPullback.of_right hOuter
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback h_X (ι_V r))
    have hm_ι_et : ∀ (r : ℕ) {X : AlgebraicGeometry.Scheme.{u}} (h_X : Quiver.Hom X S),
        AlgebraicGeometry.Etale (m_ι_can r h_X) :=
      fun r {_} h_X =>
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (hPb_m r h_X).flip (hp_ι_et r).1
    have hm_ι_surj : ∀ (r : ℕ) {X : AlgebraicGeometry.Scheme.{u}} (h_X : Quiver.Hom X S),
        Function.Surjective (m_ι_can r h_X).base :=
      fun r {_} h_X =>
        (CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (hPb_m r h_X).flip (hp_ι_et r).2).1

    have hLC_descent : ∀ {X Y : Type u} {α : Type} [TopologicalSpace X] [TopologicalSpace Y]
        (q : X → Y) (hq_surj : Function.Surjective q) (hq_open : IsOpenMap q)
        (g : LocallyConstant X α),
        (∀ x₁ x₂ : X, q x₁ = q x₂ → g x₁ = g x₂) →
        ∃ g_dn : LocallyConstant Y α, ∀ x : X, g_dn (q x) = g x := by
      intro X Y α _ _ q hq_surj hq_open g hconst
      let f_dn : Y → α := fun y => g (Classical.choose (hq_surj y))
      have hf_eq : ∀ x : X, f_dn (q x) = g x := fun x =>
        hconst _ x (Classical.choose_spec (hq_surj (q x)))
      have hf_lc : IsLocallyConstant f_dn := by
        rw [IsLocallyConstant.iff_isOpen_fiber]
        intro a
        have hpre : f_dn ⁻¹' {a} = q '' (g ⁻¹' {a}) := by
          ext y
          constructor
          · intro hy
            obtain ⟨x, rfl⟩ := hq_surj y
            exact ⟨x, by simpa only [Set.mem_preimage, hf_eq x] using hy, rfl⟩
          · rintro ⟨x, hx, rfl⟩
            simpa only [Set.mem_preimage, hf_eq x] using hx
        rw [hpre]
        exact hq_open _ (g.isLocallyConstant {a})
      exact ⟨⟨f_dn, hf_lc⟩, hf_eq⟩

    have hInvTrMap : ∀ {R₁ R₂ : Type} [CommRing R₁] [CommRing R₂] (φ : R₁ →+* R₂)
        (u : (Matrix (Fin M) (Fin M) R₁)ˣ) (v : (Matrix (Fin M) (Fin M) R₂)ˣ),
        (u.val).map φ = v.val →
        (((u⁻¹).val).transpose).map φ = ((v⁻¹).val).transpose := by
      intro R₁ R₂ _ _ φ u v huv
      let φM : Matrix (Fin M) (Fin M) R₁ →* Matrix (Fin M) (Fin M) R₂ :=
        (RingHom.mapMatrix φ).toMonoidHom
      have hu_eq : Units.map φM u = v := by
        ext i j
        exact congrFun (congrFun huv i) j
      have hinv : Units.map φM u⁻¹ = v⁻¹ := by
        rw [map_inv, hu_eq]
      have hval : ((u⁻¹).val).map φ = (v⁻¹).val := congrArg Units.val hinv
      ext i j
      exact congrFun (congrFun hval j) i

    have h_resΓ_dual : ∀ (r : ℕ) (γ_up : Γ (r + 1)),
        ∃ γ : Γ r,
          CategoryTheory.CategoryStruct.comp (p_ι r) (act r γ) =
            CategoryTheory.CategoryStruct.comp (act (r + 1) γ_up) (p_ι r) ∧
          ((τ_dual (r + 1) γ_up).val).map
            (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) =
            (τ_dual r γ).val := by
      intro r γ_up
      obtain ⟨γ, hcomm, hmat⟩ := h_resΓ r γ_up
      refine ⟨γ, hcomm, ?_⟩
      rw [h_dual (r + 1) γ_up, h_dual r γ]
      exact hInvTrMap _ (τ_rep (r + 1) γ_up) (τ_rep r γ) hmat

    have h_relTrans_dual : ∀ (r : ℕ) (W : AlgebraicGeometry.Scheme.{u}) (h_W : Quiver.Hom W S)
        (y₁ y₂ : ↥(CategoryTheory.Limits.pullback h_W (ι_V (r + 1)))),
        (m_ι_can r h_W).base y₁ = (m_ι_can r h_W).base y₂ →
        ∃ (γ_up : Γ (r + 1))
          (m_γup : Quiver.Hom (CategoryTheory.Limits.pullback h_W (ι_V (r + 1)))
            (CategoryTheory.Limits.pullback h_W (ι_V (r + 1)))),
          CategoryTheory.CategoryStruct.comp m_γup
            (CategoryTheory.Limits.pullback.fst h_W (ι_V (r + 1))) =
            CategoryTheory.Limits.pullback.fst h_W (ι_V (r + 1)) ∧
          CategoryTheory.CategoryStruct.comp m_γup
            (CategoryTheory.Limits.pullback.snd h_W (ι_V (r + 1))) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.snd h_W (ι_V (r + 1))) (act (r + 1) γ_up) ∧
          ((τ_dual (r + 1) γ_up).val).map
            (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) = 1 ∧
          m_γup.base y₁ = y₂ := by
      intro r W h_W y₁ y₂ hy
      obtain ⟨γ_up, m_γup, hfst, hsnd, hmat1, hbase⟩ := h_relTrans r W h_W (m_ι_can r h_W)
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) y₁ y₂ hy
      refine ⟨γ_up, m_γup, hfst, hsnd, ?_, hbase⟩
      rw [h_dual (r + 1) γ_up]
      have h1 := hInvTrMap (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1))))
        (τ_rep (r + 1) γ_up) 1 hmat1
      simpa only [inv_one, Units.val_one, Matrix.transpose_one] using h1

    have hMkLevelStep : ∀ (τ_sys : ∀ r : ℕ, Γ r →* (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ)
        (𝒥_sys ℳ_sys : ∀ r : ℕ,
          CategoryTheory.Sheaf S.smallEtaleTopology
            (ModuleCat.{u, u} (ULift.{u, 0} (ZMod (ℓ ^ (r + 1))))))
        (ι_sys : ∀ r : ℕ, Quiver.Hom (𝒥_sys r) (ℳ_sys r))
        (triv_sys : ∀ (r : ℕ) (W : S.Etale),
          ↑((ℳ_sys r).obj.obj (Opposite.op W)) →+
            LocallyConstant
              ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_V r))
              (Fin M → ZMod (ℓ ^ (r + 1))))
        (_hP_sys : ∀ r : ℕ,
          WeilCurveMidExtIsSheafPair S U (ℓ ^ (r + 1)) M (Γ r) (V r) (π r) (act r)
            (τ_sys r) (𝒥_sys r) (ℳ_sys r) (ι_sys r) (triv_sys r))
        (_hRes_sys : ∀ (r : ℕ) (γ_up : Γ (r + 1)),
          ∃ γ : Γ r,
            CategoryTheory.CategoryStruct.comp (p_ι r) (act r γ) =
              CategoryTheory.CategoryStruct.comp (act (r + 1) γ_up) (p_ι r) ∧
            ((τ_sys (r + 1) γ_up).val).map
              (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) =
              (τ_sys r γ).val)
        (_hRel_sys : ∀ (r : ℕ) (W : AlgebraicGeometry.Scheme.{u}) (h_W : Quiver.Hom W S)
          (y₁ y₂ : ↥(CategoryTheory.Limits.pullback h_W (ι_V (r + 1)))),
          (m_ι_can r h_W).base y₁ = (m_ι_can r h_W).base y₂ →
          ∃ (γ_up : Γ (r + 1))
            (m_γup : Quiver.Hom (CategoryTheory.Limits.pullback h_W (ι_V (r + 1)))
              (CategoryTheory.Limits.pullback h_W (ι_V (r + 1)))),
            CategoryTheory.CategoryStruct.comp m_γup
              (CategoryTheory.Limits.pullback.fst h_W (ι_V (r + 1))) =
              CategoryTheory.Limits.pullback.fst h_W (ι_V (r + 1)) ∧
            CategoryTheory.CategoryStruct.comp m_γup
              (CategoryTheory.Limits.pullback.snd h_W (ι_V (r + 1))) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W (ι_V (r + 1))) (act (r + 1) γ_up) ∧
            ((τ_sys (r + 1) γ_up).val).map
              (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) = 1 ∧
            m_γup.base y₁ = y₂)
        (r : ℕ),
        ∃ τ_ab : Quiver.Hom
            ((U_mod (ℓ ^ (r + 1 + 1))).obj (ℳ_sys (r + 1)))
            ((U_mod (ℓ ^ (r + 1))).obj (ℳ_sys r)),
          ∀ (W : S.Etale)
            (s_up : ↑(((U_mod (ℓ ^ (r + 1 + 1))).obj (ℳ_sys (r + 1))).obj.obj (Opposite.op W)))
            (y_up : ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_V (r + 1)))) (i : Fin M),
            triv_sys r W ((τ_ab.hom.app (Opposite.op W)).hom s_up)
              ((m_ι_can r (Fgt.obj W).hom).base y_up) i =
              ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
                (triv_sys (r + 1) W s_up y_up i) := by
      intro τ_sys 𝒥_sys ℳ_sys ι_sys triv_sys hP_sys hRes_sys hRel_sys r
      let cast_r := ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
      have hDesc_W : ∀ (W : S.Etale)
          (s_up : ↑((ℳ_sys (r + 1)).obj.obj (Opposite.op W))),
          let h_W := (Fgt.obj W).hom
          ∃ f_dn : LocallyConstant ↥(CategoryTheory.Limits.pullback h_W (ι_V r))
              (Fin M → ZMod (ℓ ^ (r + 1))),
            f_dn ∈ Set.range (triv_sys r W) ∧
            ∀ (y_up : ↥(CategoryTheory.Limits.pullback h_W (ι_V (r + 1)))) (i : Fin M),
              f_dn ((m_ι_can r h_W).base y_up) i = cast_r (triv_sys (r + 1) W s_up y_up i) := by
        intro W s_up h_W
        let f_up := triv_sys (r + 1) W s_up
        let g_up : LocallyConstant ↥(CategoryTheory.Limits.pullback h_W (ι_V (r + 1)))
            (Fin M → ZMod (ℓ ^ (r + 1))) :=
          f_up.map (fun v i => cast_r (v i))
        have hf_up_mem : f_up ∈ Set.range (triv_sys (r + 1) W) := ⟨s_up, rfl⟩
        rw [((hP_sys (r + 1)).2 W).2.2.1] at hf_up_mem
        have hconst : ∀ y₁ y₂ : ↥(CategoryTheory.Limits.pullback h_W (ι_V (r + 1))),
            (m_ι_can r h_W).base y₁ = (m_ι_can r h_W).base y₂ → g_up y₁ = g_up y₂ := by
          intro y₁ y₂ hy
          obtain ⟨γ_up, m_γup, hfst, hsnd, hmat1, hbase⟩ := hRel_sys r (Fgt.obj W).left h_W y₁ y₂ hy
          ext i
          change cast_r (f_up y₁ i) = cast_r (f_up y₂ i)
          rw [← hbase, hf_up_mem γ_up m_γup hfst hsnd y₁]
          have hi := RingHom.map_mulVec cast_r (τ_sys (r + 1) γ_up).val (f_up y₁) i
          rw [hi, hmat1, Matrix.one_mulVec]
          rfl
        have : AlgebraicGeometry.Etale (m_ι_can r h_W) := hm_ι_et r h_W
        obtain ⟨f_dn, hf_dn_eq⟩ := hLC_descent (m_ι_can r h_W).base (hm_ι_surj r h_W)
          (AlgebraicGeometry.Scheme.Hom.isOpenMap (m_ι_can r h_W)) g_up hconst
        refine ⟨f_dn, ?_, fun y_up i => congrFun (hf_dn_eq y_up) i⟩
        rw [((hP_sys r).2 W).2.2.1]
        intro γ m_γ hm_γ_fst hm_γ_snd y
        obtain ⟨y_up, hy_up⟩ := hm_ι_surj r h_W y
        obtain ⟨z₀, hz₀⟩ := hm_ι_surj r h_W (m_γ.base y)
        let P := CategoryTheory.Limits.pullback (m_ι_can r h_W ≫ m_γ) (m_ι_can r h_W)
        let p₁ := CategoryTheory.Limits.pullback.fst (m_ι_can r h_W ≫ m_γ) (m_ι_can r h_W)
        let p₂ := CategoryTheory.Limits.pullback.snd (m_ι_can r h_W ≫ m_γ) (m_ι_can r h_W)
        have hpt_eq : (m_ι_can r h_W ≫ m_γ).base y_up = (m_ι_can r h_W).base z₀ := by
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hy_up, hz₀]
        obtain ⟨pt, hpt₁, hpt₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y_up z₀ hpt_eq
        let fst_up := CategoryTheory.Limits.pullback.fst h_W (ι_V (r + 1))
        let snd_up := CategoryTheory.Limits.pullback.snd h_W (ι_V (r + 1))
        let fst_dn := CategoryTheory.Limits.pullback.fst h_W (ι_V r)
        let snd_dn := CategoryTheory.Limits.pullback.snd h_W (ι_V r)
        have hp_fst : p₁ ≫ fst_up = p₂ ≫ fst_up := by
          calc p₁ ≫ fst_up
              = p₁ ≫ (m_ι_can r h_W ≫ fst_dn) := by rw [CategoryTheory.Limits.pullback.lift_fst]
            _ = p₁ ≫ (m_ι_can r h_W ≫ (m_γ ≫ fst_dn)) := by rw [hm_γ_fst]
            _ = (p₁ ≫ (m_ι_can r h_W ≫ m_γ)) ≫ fst_dn := by simp only [CategoryTheory.Category.assoc]
            _ = (p₂ ≫ m_ι_can r h_W) ≫ fst_dn := by rw [CategoryTheory.Limits.pullback.condition]
            _ = p₂ ≫ fst_up := by
                rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
        have hp_π : (p₁ ≫ snd_up) ≫ π (r + 1) = (p₂ ≫ snd_up) ≫ π (r + 1) := by
          apply (cancel_mono U.ι).mp
          calc ((p₁ ≫ snd_up) ≫ π (r + 1)) ≫ U.ι
              = p₁ ≫ (snd_up ≫ ι_V (r + 1)) := by simp only [ι_V, CategoryTheory.Category.assoc]
            _ = (p₁ ≫ fst_up) ≫ h_W := by
                rw [← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
            _ = (p₂ ≫ fst_up) ≫ h_W := by rw [hp_fst]
            _ = p₂ ≫ (snd_up ≫ ι_V (r + 1)) := by
                rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
            _ = ((p₂ ≫ snd_up) ≫ π (r + 1)) ≫ U.ι := by
                simp only [ι_V, CategoryTheory.Category.assoc]
        let q_P : P ⟶ CategoryTheory.Limits.pullback (π (r + 1)) (π (r + 1)) :=
          CategoryTheory.Limits.pullback.lift (p₁ ≫ snd_up) (p₂ ≫ snd_up) hp_π
        have hmem_univ : q_P.base pt ∈ ⋃ g : Γ (r + 1), Set.range (δ_gal (r + 1) g).base := by
          rw [hδ_univ (r + 1)]
          trivial
        obtain ⟨γ_up, hγ_up_mem⟩ := Set.mem_iUnion.mp hmem_univ
        have hopen_δ : IsOpen (Set.range (δ_gal (r + 1) γ_up).base) := by
          have : AlgebraicGeometry.IsOpenImmersion (δ_gal (r + 1) γ_up) := hδ_open (r + 1) γ_up
          exact (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding (δ_gal (r + 1) γ_up)).isOpen_range
        let O : P.Opens :=
          ⟨q_P.base ⁻¹' Set.range (δ_gal (r + 1) γ_up).base,
            hopen_δ.preimage (AlgebraicGeometry.Scheme.Hom.continuous q_P)⟩
        have hpt_O_mem : pt ∈ Set.range O.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          exact hγ_up_mem
        obtain ⟨pt_O, hpt_O⟩ := hpt_O_mem
        have hO_range : Set.range (O.ι ≫ q_P).base ⊆ Set.range (δ_gal (r + 1) γ_up).base := by
          rintro _ ⟨w, rfl⟩
          have hw : O.ι.base w ∈ (O : Set ↥P) := by
            rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
            exact ⟨w, rfl⟩
          exact hw
        have : AlgebraicGeometry.IsOpenImmersion (δ_gal (r + 1) γ_up) := hδ_open (r + 1) γ_up
        let lam_O : O.toScheme ⟶ V (r + 1) :=
          AlgebraicGeometry.IsOpenImmersion.lift (δ_gal (r + 1) γ_up) (O.ι ≫ q_P) hO_range
        have hlam_fac : lam_O ≫ δ_gal (r + 1) γ_up = O.ι ≫ q_P :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac (δ_gal (r + 1) γ_up) (O.ι ≫ q_P) hO_range
        have hlam_fst : lam_O = O.ι ≫ p₁ ≫ snd_up := by
          have h1 := congrArg (· ≫ CategoryTheory.Limits.pullback.fst (π (r + 1)) (π (r + 1))) hlam_fac
          simpa only [δ_gal, q_P, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id] using h1
        have hstar : O.ι ≫ p₂ ≫ snd_up = (O.ι ≫ p₁ ≫ snd_up) ≫ act (r + 1) γ_up := by
          have h2 := congrArg (· ≫ CategoryTheory.Limits.pullback.snd (π (r + 1)) (π (r + 1))) hlam_fac
          simp only [δ_gal, q_P, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_snd] at h2
          rw [hlam_fst] at h2
          simpa only [CategoryTheory.Category.assoc] using h2.symm
        let m_γup : CategoryTheory.Limits.pullback h_W (ι_V (r + 1)) ⟶
            CategoryTheory.Limits.pullback h_W (ι_V (r + 1)) :=
          CategoryTheory.Limits.pullback.lift fst_up (snd_up ≫ act (r + 1) γ_up)
            (by rw [CategoryTheory.Category.assoc, h_over_ι (r + 1) γ_up,
                  CategoryTheory.Limits.pullback.condition])
        have hO_m : O.ι ≫ p₂ = O.ι ≫ p₁ ≫ m_γup := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hp_fst]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd, hstar]
            simp only [CategoryTheory.Category.assoc]
        have hz₀_eq : z₀ = m_γup.base y_up := by
          have h1 := congrArg (fun k => k.base pt_O) hO_m
          simp only [AlgebraicGeometry.Scheme.Hom.comp_apply, hpt_O] at h1
          rw [← hpt₂, ← hpt₁]
          exact h1
        obtain ⟨γ', hγ'_comm, hγ'_mat⟩ := hRes_sys r γ_up
        let ξ : O.toScheme ⟶ V r := O.ι ≫ p₁ ≫ m_ι_can r h_W ≫ snd_dn
        have hξ_act : ξ ≫ act r γ = ξ ≫ act r γ' := by
          have hm_γ_snd' : m_γ ≫ snd_dn = snd_dn ≫ act r γ := hm_γ_snd
          have hm_can_snd' : m_ι_can r h_W ≫ snd_dn = snd_up ≫ p_ι r :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hp_cond : p₁ ≫ (m_ι_can r h_W ≫ m_γ) = p₂ ≫ m_ι_can r h_W :=
            CategoryTheory.Limits.pullback.condition
          calc ξ ≫ act r γ
              = O.ι ≫ p₁ ≫ m_ι_can r h_W ≫ (snd_dn ≫ act r γ) := by
                  simp only [ξ, CategoryTheory.Category.assoc]
            _ = O.ι ≫ (p₁ ≫ (m_ι_can r h_W ≫ m_γ)) ≫ snd_dn := by
                  rw [← hm_γ_snd']; simp only [CategoryTheory.Category.assoc]
            _ = O.ι ≫ p₂ ≫ (m_ι_can r h_W ≫ snd_dn) := by
                  rw [hp_cond]; simp only [CategoryTheory.Category.assoc]
            _ = (O.ι ≫ p₂ ≫ snd_up) ≫ p_ι r := by
                  rw [hm_can_snd']; simp only [CategoryTheory.Category.assoc]
            _ = (O.ι ≫ p₁ ≫ snd_up) ≫ (act (r + 1) γ_up ≫ p_ι r) := by
                  rw [hstar, CategoryTheory.Category.assoc]
            _ = O.ι ≫ p₁ ≫ (snd_up ≫ p_ι r) ≫ act r γ' := by
                  rw [← hγ'_comm]; simp only [CategoryTheory.Category.assoc]
            _ = ξ ≫ act r γ' := by
                  rw [← hm_can_snd']; simp only [ξ, CategoryTheory.Category.assoc]
        have hξ_δ : ξ ≫ δ_gal r γ = ξ ≫ δ_gal r γ' := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · simp only [δ_gal, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id]
          · simp only [δ_gal, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, hξ_act]
        have hγ_eq : γ = γ' := by
          by_contra hne
          have hpt_δ := congrArg (fun k => k.base pt_O) hξ_δ
          simp only [AlgebraicGeometry.Scheme.Hom.comp_apply] at hpt_δ
          exact Set.disjoint_left.mp (hδ_disj r hne) ⟨ξ.base pt_O, rfl⟩ ⟨ξ.base pt_O, hpt_δ.symm⟩
        rw [← hz₀, hf_dn_eq z₀, ← hy_up, hf_dn_eq y_up, hz₀_eq]
        ext i
        change cast_r (f_up (m_γup.base y_up) i) = (((τ_sys r γ).val).mulVec (g_up y_up)) i
        rw [hf_up_mem γ_up m_γup (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _) y_up]
        have hi := RingHom.map_mulVec cast_r (τ_sys (r + 1) γ_up).val (f_up y_up) i
        rw [hi, hγ'_mat, hγ_eq]
        rfl

      let app_fn : ∀ W : S.Etale,
          ↑((ℳ_sys (r + 1)).obj.obj (Opposite.op W)) → ↑((ℳ_sys r).obj.obj (Opposite.op W)) :=
        fun W s_up => Classical.choose (Classical.choose_spec (hDesc_W W s_up)).1
      have happ_spec : ∀ (W : S.Etale) (s_up) (y_up) (i : Fin M),
          triv_sys r W (app_fn W s_up) ((m_ι_can r (Fgt.obj W).hom).base y_up) i =
            cast_r (triv_sys (r + 1) W s_up y_up i) := by
        intro W s_up y_up i
        have h1 := Classical.choose_spec (Classical.choose_spec (hDesc_W W s_up)).1
        have h2 := (Classical.choose_spec (hDesc_W W s_up)).2 y_up i
        rwa [h1]
      let app_add : ∀ W : S.Etale,
          ↑((ℳ_sys (r + 1)).obj.obj (Opposite.op W)) →+ ↑((ℳ_sys r).obj.obj (Opposite.op W)) :=
        fun W => AddMonoidHom.mk' (app_fn W) (fun s₁ s₂ => by
          apply ((hP_sys r).2 W).1
          rw [map_add]
          ext y i
          obtain ⟨y_up, rfl⟩ := hm_ι_surj r (Fgt.obj W).hom y
          change triv_sys r W (app_fn W (s₁ + s₂)) ((m_ι_can r (Fgt.obj W).hom).base y_up) i =
            triv_sys r W (app_fn W s₁) ((m_ι_can r (Fgt.obj W).hom).base y_up) i +
              triv_sys r W (app_fn W s₂) ((m_ι_can r (Fgt.obj W).hom).base y_up) i
          rw [happ_spec, happ_spec, happ_spec, map_add]
          change cast_r ((triv_sys (r + 1) W s₁ y_up + triv_sys (r + 1) W s₂ y_up) i) = _
          rw [Pi.add_apply, map_add])
      let η : ((U_mod (ℓ ^ (r + 1 + 1))).obj (ℳ_sys (r + 1))).obj ⟶
          ((U_mod (ℓ ^ (r + 1))).obj (ℳ_sys r)).obj :=
        { app := fun W_op => AddCommGrpCat.ofHom (app_add W_op.unop)
          naturality := fun {W₂_op W₁_op} u_op => by
            rcases W₂_op with ⟨W₂⟩
            rcases W₁_op with ⟨W₁⟩
            rcases u_op with ⟨u⟩
            apply AddCommGrpCat.ext
            intro s_up
            apply ((hP_sys r).2 W₁).1
            ext y₁ i
            obtain ⟨y₁_up, rfl⟩ := hm_ι_surj r (Fgt.obj W₁).hom y₁
            let u_dn : CategoryTheory.Limits.pullback (Fgt.obj W₁).hom (ι_V r) ⟶
                CategoryTheory.Limits.pullback (Fgt.obj W₂).hom (ι_V r) :=
              CategoryTheory.Limits.pullback.lift
                (CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom (ι_V r) ≫ (Fgt.map u).left)
                (CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom (ι_V r))
                (by rw [CategoryTheory.Category.assoc, (Fgt.map u).w,
                      CategoryTheory.Limits.pullback.condition])
            let u_up : CategoryTheory.Limits.pullback (Fgt.obj W₁).hom (ι_V (r + 1)) ⟶
                CategoryTheory.Limits.pullback (Fgt.obj W₂).hom (ι_V (r + 1)) :=
              CategoryTheory.Limits.pullback.lift
                (CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom (ι_V (r + 1)) ≫ (Fgt.map u).left)
                (CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom (ι_V (r + 1)))
                (by rw [CategoryTheory.Category.assoc, (Fgt.map u).w,
                      CategoryTheory.Limits.pullback.condition])
            have hsq : m_ι_can r (Fgt.obj W₁).hom ≫ u_dn = u_up ≫ m_ι_can r (Fgt.obj W₂).hom := by
              apply CategoryTheory.Limits.pullback.hom_ext
              · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                  ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                  CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                  CategoryTheory.Limits.pullback.lift_fst]
              · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                  CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_snd]
            have hbase : u_dn.base ((m_ι_can r (Fgt.obj W₁).hom).base y₁_up) =
                (m_ι_can r (Fgt.obj W₂).hom).base (u_up.base y₁_up) :=
              congrArg (fun k => k.base y₁_up) hsq
            let s_up_m : ↑((ℳ_sys (r + 1)).obj.obj (Opposite.op W₂)) := s_up
            change triv_sys r W₁ (app_fn W₁ (((ℳ_sys (r + 1)).obj.map (Opposite.op u)).hom s_up_m))
                ((m_ι_can r (Fgt.obj W₁).hom).base y₁_up) i =
              triv_sys r W₁ (((ℳ_sys r).obj.map (Opposite.op u)).hom (app_fn W₂ s_up_m))
                ((m_ι_can r (Fgt.obj W₁).hom).base y₁_up) i
            rw [happ_spec W₁,
              (hP_sys (r + 1)).1 u u_up (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                (CategoryTheory.Limits.pullback.lift_snd _ _ _) s_up_m y₁_up,
              (hP_sys r).1 u u_dn (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                (CategoryTheory.Limits.pullback.lift_snd _ _ _) (app_fn W₂ s_up_m) _,
              hbase, happ_spec W₂] }
      exact ⟨CategoryTheory.ObjectProperty.homMk η, happ_spec⟩

    choose τ_ℳ_ab hτ_ℳ_spec using
      hMkLevelStep τ_rep 𝒥 ℳ ι_ext triv hPair h_resΓ (fun r W h_W y₁ y₂ hy =>
        h_relTrans r W h_W (m_ι_can r h_W) (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) y₁ y₂ hy)
    choose τ_ℳ_dual_ab hτ_ℳ_dual_spec using
      hMkLevelStep τ_dual 𝒥_dual ℳ_dual ι_dual triv_dual hPair_dual h_resΓ_dual h_relTrans_dual

    let triv_J : ∀ (r : ℕ) (W : S.Etale),
        ↑((𝒥_ab r).obj.obj (Opposite.op W)) →+
          LocallyConstant ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_V r))
            (Fin M → ZMod (ℓ ^ (r + 1))) :=
      fun r W => (triv r W).comp (((ι_ext r).hom.app (Opposite.op W)).hom.toAddMonoidHom)
    have htriv_J_inj : ∀ (r : ℕ) (W : S.Etale), Function.Injective (triv_J r W) :=
      fun r W => ((hPair r).2 W).1.comp ((hPair r).2 W).2.1
    have htriv_J_range : ∀ (r : ℕ) (W : S.Etale),
        let h_W := (Fgt.obj W).hom
        let W_V := CategoryTheory.Limits.pullback h_W (ι_V r)
        Set.range (triv_J r W) =
          { f |
            (∃ W₀ : (Fgt.obj W).left.Opens,
              ((TopologicalSpace.Opens.map h_W.base).obj U) ⊔ W₀ = ⊤ ∧
              ∀ y : ↥W_V, (CategoryTheory.Limits.pullback.fst h_W (ι_V r)).base y ∈ W₀ → f y = 0) ∧
            (∀ (g : Γ r) (m_g : Quiver.Hom W_V W_V),
              CategoryTheory.CategoryStruct.comp m_g (CategoryTheory.Limits.pullback.fst h_W (ι_V r)) =
                CategoryTheory.Limits.pullback.fst h_W (ι_V r) →
              CategoryTheory.CategoryStruct.comp m_g (CategoryTheory.Limits.pullback.snd h_W (ι_V r)) =
                CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd h_W (ι_V r))
                  (act r g) →
              ∀ y : ↥W_V, f (m_g.base y) = ((τ_rep r g).val).mulVec (f y)) } :=
      fun r W => ((hPair r).2 W).2.2.2
    have htriv_J_nat : ∀ (r : ℕ) {W₁ W₂ : S.Etale} (u : Quiver.Hom W₁ W₂)
        (u_V : Quiver.Hom (CategoryTheory.Limits.pullback (Fgt.obj W₁).hom (ι_V r))
          (CategoryTheory.Limits.pullback (Fgt.obj W₂).hom (ι_V r))),
        CategoryTheory.CategoryStruct.comp u_V
          (CategoryTheory.Limits.pullback.fst (Fgt.obj W₂).hom (ι_V r)) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom (ι_V r)) (Fgt.map u).left →
        CategoryTheory.CategoryStruct.comp u_V
          (CategoryTheory.Limits.pullback.snd (Fgt.obj W₂).hom (ι_V r)) =
          CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom (ι_V r) →
        ∀ (s : ↑((𝒥_ab r).obj.obj (Opposite.op W₂))) (y₁),
          triv_J r W₁ (((𝒥_ab r).obj.map (Opposite.op u)).hom s) y₁ =
            triv_J r W₂ s (u_V.base y₁) := by
      intro r W₁ W₂ u u_V hfst hsnd s y₁
      have hnat := congrArg (fun φ => φ.hom s) ((ι_ext r).hom.naturality (Opposite.op u))
      change ((ι_ext r).hom.app (Opposite.op W₁)).hom (((𝒥_ab r).obj.map (Opposite.op u)).hom s) =
        ((ℳ r).obj.map (Opposite.op u)).hom (((ι_ext r).hom.app (Opposite.op W₂)).hom s) at hnat
      change triv r W₁ (((ι_ext r).hom.app (Opposite.op W₁)).hom
          (((𝒥_ab r).obj.map (Opposite.op u)).hom s)) y₁ =
        triv r W₂ (((ι_ext r).hom.app (Opposite.op W₂)).hom s) (u_V.base y₁)
      rw [hnat]
      exact (hPair r).1 u u_V hfst hsnd _ y₁

    have hSheafHomExt_J : ∀ {r₁ r₂ : ℕ} (φ₁ φ₂ : Quiver.Hom (𝒥_ab r₁) (𝒥_ab r₂)),
        (∀ (W : S.Etale) (s : ↑((𝒥_ab r₁).obj.obj (Opposite.op W))) (y) (i : Fin M),
          triv_J r₂ W ((φ₁.hom.app (Opposite.op W)).hom s) y i =
            triv_J r₂ W ((φ₂.hom.app (Opposite.op W)).hom s) y i) →
        φ₁ = φ₂ := by
      intro r₁ r₂ φ₁ φ₂ h
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext W_op
      rcases W_op with ⟨W⟩
      apply AddCommGrpCat.ext
      intro s
      apply htriv_J_inj r₂ W
      ext y i
      exact h W s y i

    have hτ_J_pkg : ∀ r : ℕ,
        ∃ φ : Quiver.Hom (𝒥_ab (r + 1)) (𝒥_ab r),
          CategoryTheory.CategoryStruct.comp φ ((U_mod (ℓ ^ (r + 1))).map (ι_ext r)) =
            CategoryTheory.CategoryStruct.comp
              ((U_mod (ℓ ^ (r + 1 + 1))).map (ι_ext (r + 1))) (τ_ℳ_ab r) ∧
          ∀ (W : S.Etale) (s_up : ↑((𝒥_ab (r + 1)).obj.obj (Opposite.op W)))
            (y_up : ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_V (r + 1)))) (i : Fin M),
            triv_J r W ((φ.hom.app (Opposite.op W)).hom s_up)
              ((m_ι_can r (Fgt.obj W).hom).base y_up) i =
              ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
                (triv_J (r + 1) W s_up y_up i) := by
      intro r
      have hInRange : ∀ (W : S.Etale) (s_up : ↑((𝒥_ab (r + 1)).obj.obj (Opposite.op W))),
          triv r W (((τ_ℳ_ab r).hom.app (Opposite.op W)).hom
            (((ι_ext (r + 1)).hom.app (Opposite.op W)).hom s_up)) ∈
            Set.range (triv_J r W) := by
        intro W s_up
        let h_W := (Fgt.obj W).hom
        let s_M := ((ι_ext (r + 1)).hom.app (Opposite.op W)).hom s_up
        let t_M := ((τ_ℳ_ab r).hom.app (Opposite.op W)).hom s_M
        have hs_mem : triv_J (r + 1) W s_up ∈
            Set.range ((triv (r + 1) W).comp
              (((ι_ext (r + 1)).hom.app (Opposite.op W)).hom.toAddMonoidHom)) := ⟨s_up, rfl⟩
        rw [((hPair (r + 1)).2 W).2.2.2] at hs_mem
        obtain ⟨⟨W₀, hW₀_top, hW₀_van⟩, _⟩ := hs_mem
        have ht_mem : triv r W t_M ∈ Set.range (triv r W) := ⟨t_M, rfl⟩
        rw [((hPair r).2 W).2.2.1] at ht_mem
        change triv r W t_M ∈ Set.range ((triv r W).comp ((ι_ext r).hom.app (Opposite.op W)).hom.toAddMonoidHom)
        rw [((hPair r).2 W).2.2.2]
        refine ⟨⟨W₀, hW₀_top, ?_⟩, ht_mem⟩
        intro y hy
        obtain ⟨y_up, rfl⟩ := hm_ι_surj r h_W y
        have hy_up : (CategoryTheory.Limits.pullback.fst h_W (ι_V (r + 1))).base y_up ∈ W₀ := by
          have h1 := congrArg (fun k => k.base y_up) (hm_ι_fst r h_W)
          rw [← h1, AlgebraicGeometry.Scheme.Hom.comp_apply]
          exact hy
        ext i
        rw [hτ_ℳ_spec r W s_M y_up i]
        change ZMod.castHom _ _ (triv_J (r + 1) W s_up y_up i) = 0
        rw [hW₀_van y_up hy_up, Pi.zero_apply, map_zero]
      let φ_fn : ∀ W : S.Etale,
          ↑((𝒥 (r + 1)).obj.obj (Opposite.op W)) → ↑((𝒥 r).obj.obj (Opposite.op W)) :=
        fun W s_up => Classical.choose (hInRange W s_up)
      have hφ_eq : ∀ (W : S.Etale) (s_up : ↑((𝒥 (r + 1)).obj.obj (Opposite.op W))),
          ((ι_ext r).hom.app (Opposite.op W)).hom (φ_fn W s_up) =
            ((τ_ℳ_ab r).hom.app (Opposite.op W)).hom
              (((ι_ext (r + 1)).hom.app (Opposite.op W)).hom s_up) := by
        intro W s_up
        apply ((hPair r).2 W).1
        exact Classical.choose_spec (hInRange W s_up)
      let φ_add : ∀ W : S.Etale,
          ↑((𝒥_ab (r + 1)).obj.obj (Opposite.op W)) →+ ↑((𝒥_ab r).obj.obj (Opposite.op W)) :=
        fun W => AddMonoidHom.mk' (φ_fn W) (fun (s₁ s₂ : ↑((𝒥 (r + 1)).obj.obj (Opposite.op W))) => by
          apply ((hPair r).2 W).2.1
          change ((ι_ext r).hom.app (Opposite.op W)).hom (φ_fn W (s₁ + s₂)) =
            ((ι_ext r).hom.app (Opposite.op W)).hom (φ_fn W s₁ + φ_fn W s₂)
          rw [map_add, hφ_eq, hφ_eq, hφ_eq]
          have h1 : (((ι_ext (r + 1)).hom.app (Opposite.op W)).hom (s₁ + s₂) :
              ↑(((U_mod (ℓ ^ (r + 1 + 1))).obj (ℳ (r + 1))).obj.obj (Opposite.op W))) =
            (((ι_ext (r + 1)).hom.app (Opposite.op W)).hom s₁ :
              ↑(((U_mod (ℓ ^ (r + 1 + 1))).obj (ℳ (r + 1))).obj.obj (Opposite.op W))) +
            (((ι_ext (r + 1)).hom.app (Opposite.op W)).hom s₂ :
              ↑(((U_mod (ℓ ^ (r + 1 + 1))).obj (ℳ (r + 1))).obj.obj (Opposite.op W))) :=
            map_add ((ι_ext (r + 1)).hom.app (Opposite.op W)).hom s₁ s₂
          exact (congrArg ((τ_ℳ_ab r).hom.app (Opposite.op W)).hom h1).trans
            (map_add ((τ_ℳ_ab r).hom.app (Opposite.op W)).hom _ _))
      let η_J : (𝒥_ab (r + 1)).obj ⟶ (𝒥_ab r).obj :=
        { app := fun W_op => AddCommGrpCat.ofHom (φ_add W_op.unop)
          naturality := fun {W₂_op W₁_op} u_op => by
            rcases W₂_op with ⟨W₂⟩
            rcases W₁_op with ⟨W₁⟩
            rcases u_op with ⟨u⟩
            apply AddCommGrpCat.ext
            intro s_up
            apply ((hPair r).2 W₁).2.1
            have h1 := hφ_eq W₁ (((𝒥_ab (r + 1)).obj.map (Opposite.op u)).hom s_up)
            have hnat_ι_up := congrArg (fun ψ => ψ.hom s_up)
              ((ι_ext (r + 1)).hom.naturality (Opposite.op u))
            have hnat_τ := congrArg (fun ψ => ψ.hom (((ι_ext (r + 1)).hom.app (Opposite.op W₂)).hom s_up))
              ((τ_ℳ_ab r).hom.naturality (Opposite.op u))
            have hnat_ι_dn := congrArg (fun ψ => ψ.hom (φ_fn W₂ s_up))
              ((ι_ext r).hom.naturality (Opposite.op u))
            change ((ι_ext r).hom.app (Opposite.op W₁)).hom
                (φ_fn W₁ (((𝒥_ab (r + 1)).obj.map (Opposite.op u)).hom s_up)) =
              ((ι_ext r).hom.app (Opposite.op W₁)).hom
                (((𝒥_ab r).obj.map (Opposite.op u)).hom (φ_fn W₂ s_up))
            rw [h1]
            exact (congrArg (((τ_ℳ_ab r).hom.app (Opposite.op W₁)).hom) hnat_ι_up).trans
              (hnat_τ.trans ((congrArg (((ℳ r).obj.map (Opposite.op u)).hom) (hφ_eq W₂ s_up).symm).trans
                hnat_ι_dn.symm)) }
      let φ : Quiver.Hom (𝒥_ab (r + 1)) (𝒥_ab r) := CategoryTheory.ObjectProperty.homMk η_J
      refine ⟨φ, ?_, ?_⟩
      · apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext W_op
        rcases W_op with ⟨W⟩
        apply AddCommGrpCat.ext
        intro s_up
        exact hφ_eq W s_up
      · intro W s_up y_up i
        change triv r W (((ι_ext r).hom.app (Opposite.op W)).hom (φ_fn W s_up))
            ((m_ι_can r (Fgt.obj W).hom).base y_up) i = _
        rw [hφ_eq W s_up]
        exact hτ_ℳ_spec r W (((ι_ext (r + 1)).hom.app (Opposite.op W)).hom s_up) y_up i

    choose τ_𝒥_ab_step hτ_𝒥_comm hτ_𝒥_spec using hτ_J_pkg

    let p_le : ∀ {a b : ℕ}, a ≤ b → Quiver.Hom (V b) (V a) := fun {a b} h =>
      @Nat.leRec a (fun c _ => Quiver.Hom (V c) (V a))
        (CategoryTheory.CategoryStruct.id (V a))
        (fun c _ prev => CategoryTheory.CategoryStruct.comp (p_ι c) prev) b h
    have hp_le_refl : ∀ a : ℕ, p_le (le_refl a) = CategoryTheory.CategoryStruct.id (V a) :=
      fun _ => Nat.leRec_self _ _
    have hp_le_step : ∀ {a b : ℕ} (h : a ≤ b),
        p_le (Nat.le_succ_of_le h) = CategoryTheory.CategoryStruct.comp (p_ι b) (p_le h) :=
      fun h => Nat.leRec_succ _ _ h
    have hp_le_ι : ∀ {a b : ℕ} (h : a ≤ b),
        CategoryTheory.CategoryStruct.comp (p_le h) (ι_V a) = ι_V b := by
      intro a b h
      induction h with
      | refl => rw [hp_le_refl, CategoryTheory.Category.id_comp]
      | @step b h ih => rw [hp_le_step h, CategoryTheory.Category.assoc, ih, hp_ι_V b]

    let τ_𝒥_ab_le : ∀ {a b : ℕ}, a ≤ b → Quiver.Hom (𝒥_ab b) (𝒥_ab a) := fun {a b} h =>
      @Nat.leRec a (fun c _ => Quiver.Hom (𝒥_ab c) (𝒥_ab a))
        (CategoryTheory.CategoryStruct.id (𝒥_ab a))
        (fun c _ prev => CategoryTheory.CategoryStruct.comp (τ_𝒥_ab_step c) prev) b h
    have hτ_le_refl : ∀ a : ℕ, τ_𝒥_ab_le (le_refl a) = CategoryTheory.CategoryStruct.id (𝒥_ab a) :=
      fun _ => Nat.leRec_self _ _
    have hτ_le_step : ∀ {a b : ℕ} (h : a ≤ b),
        τ_𝒥_ab_le (Nat.le_succ_of_le h) =
          CategoryTheory.CategoryStruct.comp (τ_𝒥_ab_step b) (τ_𝒥_ab_le h) :=
      fun h => Nat.leRec_succ _ _ h
    have hτ_le_succ : ∀ r : ℕ, τ_𝒥_ab_le (Nat.le_succ r) = τ_𝒥_ab_step r := by
      intro r
      change τ_𝒥_ab_le (Nat.le_succ_of_le (le_refl r)) = τ_𝒥_ab_step r
      rw [hτ_le_step (le_refl r), hτ_le_refl r, CategoryTheory.Category.comp_id]
    have hτ_le_trans : ∀ {a b c : ℕ} (hab : a ≤ b) (hbc : b ≤ c),
        τ_𝒥_ab_le (le_trans hab hbc) =
          CategoryTheory.CategoryStruct.comp (τ_𝒥_ab_le hbc) (τ_𝒥_ab_le hab) := by
      intro a b c hab hbc
      induction hbc with
      | refl =>
        rw [hτ_le_refl, CategoryTheory.Category.id_comp]
      | @step c hbc ih =>
        have hpr : le_trans hab (Nat.le_succ_of_le hbc) = Nat.le_succ_of_le (le_trans hab hbc) :=
          rfl
        rw [hpr, hτ_le_step (le_trans hab hbc), hτ_le_step hbc, ih, CategoryTheory.Category.assoc]

    let m_le : ∀ {X : AlgebraicGeometry.Scheme.{u}} (h_X : Quiver.Hom X S) {a b : ℕ} (h : a ≤ b),
        Quiver.Hom (CategoryTheory.Limits.pullback h_X (ι_V b))
          (CategoryTheory.Limits.pullback h_X (ι_V a)) :=
      fun {_} h_X {a b} h =>
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst h_X (ι_V b))
          (CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Limits.pullback.snd h_X (ι_V b)) (p_le h))
          (by rw [CategoryTheory.Category.assoc, hp_le_ι h, CategoryTheory.Limits.pullback.condition])
    have hm_le_fst : ∀ {X : AlgebraicGeometry.Scheme.{u}} (h_X : Quiver.Hom X S)
        {a b : ℕ} (h : a ≤ b),
        m_le h_X h ≫ CategoryTheory.Limits.pullback.fst h_X (ι_V a) =
          CategoryTheory.Limits.pullback.fst h_X (ι_V b) :=
      fun {_} _ {_ _} _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hm_le_refl : ∀ {X : AlgebraicGeometry.Scheme.{u}} (h_X : Quiver.Hom X S) (a : ℕ),
        m_le h_X (le_refl a) = CategoryTheory.CategoryStruct.id _ := by
      intro X h_X a
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
      · rw [CategoryTheory.Limits.pullback.lift_snd, hp_le_refl,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    have hm_le_step : ∀ {X : AlgebraicGeometry.Scheme.{u}} (h_X : Quiver.Hom X S)
        {a b : ℕ} (h : a ≤ b),
        m_le h_X (Nat.le_succ_of_le h) =
          CategoryTheory.CategoryStruct.comp (m_ι_can b h_X) (m_le h_X h) := by
      intro X h_X a b h
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
      · rw [CategoryTheory.Limits.pullback.lift_snd, hp_le_step h,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc (m_ι_can b h_X), CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc]
    have hm_le_surj : ∀ {X : AlgebraicGeometry.Scheme.{u}} (h_X : Quiver.Hom X S)
        {a b : ℕ} (h : a ≤ b),
        Function.Surjective (m_le h_X h).base := by
      intro X h_X a b h
      induction h with
      | refl =>
        rw [hm_le_refl]
        exact fun y => ⟨y, rfl⟩
      | @step b h ih =>
        rw [hm_le_step h_X h]
        exact ih.comp (hm_ι_surj b h_X)

    have h_resΓ_le : ∀ {a b : ℕ} (h : a ≤ b) (γ_b : Γ b),
        ∃ γ_a : Γ a,
          CategoryTheory.CategoryStruct.comp (p_le h) (act a γ_a) =
            CategoryTheory.CategoryStruct.comp (act b γ_b) (p_le h) ∧
          ((τ_rep b γ_b).val).map
            (ZMod.castHom (pow_dvd_pow ℓ (Nat.add_le_add_right h 1)) (ZMod (ℓ ^ (a + 1)))) =
            (τ_rep a γ_a).val := by
      intro a b h
      induction h with
      | refl =>
        intro γ_a
        refine ⟨γ_a, ?_, ?_⟩
        · rw [hp_le_refl, CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
        · ext i j
          simp only [Matrix.map_apply, ZMod.castHom_self, RingHom.id_apply]
      | @step b h ih =>
        intro γ_up
        obtain ⟨γ_b, hcomm_b, hmat_b⟩ := h_resΓ b γ_up
        obtain ⟨γ_a, hcomm_a, hmat_a⟩ := ih γ_b
        refine ⟨γ_a, ?_, ?_⟩
        · rw [hp_le_step h, CategoryTheory.Category.assoc, hcomm_a,
            ← CategoryTheory.Category.assoc, hcomm_b, CategoryTheory.Category.assoc]
        · ext i j
          have hcomp := ZMod.castHom_comp
            (pow_dvd_pow ℓ (Nat.add_le_add_right h 1))
            (pow_dvd_pow ℓ (Nat.le_succ (b + 1)))
          have h1 : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (b + 1))) (ZMod (ℓ ^ (b + 1)))
              (((τ_rep (b + 1) γ_up).val) i j) = ((τ_rep b γ_b).val) i j :=
            congrFun (congrFun hmat_b i) j
          have h2 : ZMod.castHom (pow_dvd_pow ℓ (Nat.add_le_add_right h 1)) (ZMod (ℓ ^ (a + 1)))
              (((τ_rep b γ_b).val) i j) = ((τ_rep a γ_a).val) i j :=
            congrFun (congrFun hmat_a i) j
          simp only [Matrix.map_apply]
          rw [← h2, ← h1, ← RingHom.comp_apply, hcomp]

    have hτ_le_spec : ∀ {a b : ℕ} (h : a ≤ b) (W : S.Etale)
        (s_b : ↑((𝒥_ab b).obj.obj (Opposite.op W)))
        (y_b : ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_V b))) (i : Fin M),
        triv_J a W (((τ_𝒥_ab_le h).hom.app (Opposite.op W)).hom s_b)
          ((m_le (Fgt.obj W).hom h).base y_b) i =
          ZMod.castHom (pow_dvd_pow ℓ (Nat.add_le_add_right h 1)) (ZMod (ℓ ^ (a + 1)))
            (triv_J b W s_b y_b i) := by
      intro a b h
      induction h with
      | refl =>
        intro W s_a y_a i
        rw [hτ_le_refl, hm_le_refl, ZMod.castHom_self, RingHom.id_apply]
        rfl
      | @step b h ih =>
        intro W s_up y_up i
        rw [hτ_le_step h, hm_le_step (Fgt.obj W).hom h]
        change triv_J a W (((τ_𝒥_ab_le h).hom.app (Opposite.op W)).hom
            (((τ_𝒥_ab_step b).hom.app (Opposite.op W)).hom s_up))
            ((m_le (Fgt.obj W).hom h).base ((m_ι_can b (Fgt.obj W).hom).base y_up)) i = _
        rw [ih W (((τ_𝒥_ab_step b).hom.app (Opposite.op W)).hom s_up)
              ((m_ι_can b (Fgt.obj W).hom).base y_up) i,
            hτ_𝒥_spec b W s_up y_up i, ← RingHom.comp_apply, ZMod.castHom_comp]

    have hPowEq : ∀ (a b c : ℕ), a + b + 1 = c → ℓ ^ (c + 1) = ℓ ^ (b + 1) * ℓ ^ (a + 1) := by
      intro a b c hc
      rw [← pow_add]
      exact congrArg (ℓ ^ ·) (by omega)
    have hModEq : ∀ (a b c : ℕ) (hc : a + b + 1 = c) (n : ℕ),
        ((ℓ ^ (b + 1) * (n % ℓ ^ (a + 1)) : ℕ) : ZMod (ℓ ^ (c + 1))) =
          ((ℓ ^ (b + 1) * n : ℕ) : ZMod (ℓ ^ (c + 1))) := by
      intro a b c hc n
      have hdiv := Nat.div_add_mod n (ℓ ^ (a + 1))
      conv_rhs =>
        rw [← hdiv, Nat.mul_add, ← mul_assoc, ← hPowEq a b c hc,
          Nat.cast_add, Nat.cast_mul, ZMod.natCast_self, zero_mul, zero_add]
    let emb_zmod : ∀ (a b c : ℕ), a + b + 1 = c → ZMod (ℓ ^ (a + 1)) →+ ZMod (ℓ ^ (c + 1)) :=
      fun a b c hc =>
        AddMonoidHom.mk' (fun w => ((ℓ ^ (b + 1) * w.val : ℕ) : ZMod (ℓ ^ (c + 1))))
          (fun w₁ w₂ => by
            rw [ZMod.val_add, hModEq a b c hc (w₁.val + w₂.val), Nat.mul_add, Nat.cast_add])
    have hemb_apply : ∀ (a b c : ℕ) (hc : a + b + 1 = c) (w : ZMod (ℓ ^ (a + 1))),
        emb_zmod a b c hc w = ((ℓ ^ (b + 1) * w.val : ℕ) : ZMod (ℓ ^ (c + 1))) :=
      fun _ _ _ _ _ => rfl
    have hemb_inj : ∀ (a b c : ℕ) (hc : a + b + 1 = c), Function.Injective (emb_zmod a b c hc) := by
      intro a b c hc w₁ w₂ hw
      have hpos : 0 < ℓ ^ (b + 1) := pow_pos hPrime.pos (b + 1)
      have hlt₁ : ℓ ^ (b + 1) * w₁.val < ℓ ^ (c + 1) := by
        rw [hPowEq a b c hc]
        exact Nat.mul_lt_mul_of_pos_left (ZMod.val_lt w₁) hpos
      have hlt₂ : ℓ ^ (b + 1) * w₂.val < ℓ ^ (c + 1) := by
        rw [hPowEq a b c hc]
        exact Nat.mul_lt_mul_of_pos_left (ZMod.val_lt w₂) hpos
      rw [hemb_apply a b c hc, hemb_apply a b c hc] at hw
      have hval := congrArg ZMod.val hw
      rw [ZMod.val_natCast_of_lt hlt₁, ZMod.val_natCast_of_lt hlt₂] at hval
      exact ZMod.val_injective _ (Nat.mul_left_cancel hpos hval)
    have hemb_ker : ∀ (a b c : ℕ) (hc : a + b + 1 = c) (h : ℓ ^ (b + 1) ∣ ℓ ^ (c + 1))
        (z : ZMod (ℓ ^ (c + 1))),
        ZMod.castHom h (ZMod (ℓ ^ (b + 1))) z = 0 ↔
          ∃ w : ZMod (ℓ ^ (a + 1)), emb_zmod a b c hc w = z := by
      intro a b c hc h z
      constructor
      · intro hz
        have hz0 : ((z.val : ℕ) : ZMod (ℓ ^ (b + 1))) = 0 := by
          conv at hz => lhs; rw [← ZMod.natCast_zmod_val z]
          rwa [map_natCast] at hz
        obtain ⟨q, hq⟩ := (ZMod.natCast_eq_zero_iff z.val (ℓ ^ (b + 1))).mp hz0
        have hpos : 0 < ℓ ^ (b + 1) := pow_pos hPrime.pos (b + 1)
        have hq_lt : q < ℓ ^ (a + 1) := by
          have hz_lt : z.val < ℓ ^ (b + 1) * ℓ ^ (a + 1) := hPowEq a b c hc ▸ ZMod.val_lt z
          rw [hq] at hz_lt
          exact (Nat.mul_lt_mul_left hpos).mp hz_lt
        refine ⟨(q : ZMod (ℓ ^ (a + 1))), ?_⟩
        rw [hemb_apply a b c hc, ZMod.val_natCast_of_lt hq_lt, ← hq, ZMod.natCast_zmod_val]
      · rintro ⟨w, rfl⟩
        rw [hemb_apply a b c hc, map_natCast, Nat.cast_mul, ZMod.natCast_self, zero_mul]
    have hemb_mulVec : ∀ (a b c : ℕ) (hc : a + b + 1 = c) (h : ℓ ^ (a + 1) ∣ ℓ ^ (c + 1))
        (M_up : Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (c + 1))))
        (M_dn : Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (a + 1)))),
        M_up.map (ZMod.castHom h (ZMod (ℓ ^ (a + 1)))) = M_dn →
        ∀ v : Fin M → ZMod (ℓ ^ (a + 1)),
          M_up.mulVec (fun i => emb_zmod a b c hc (v i)) =
            fun i => emb_zmod a b c hc ((M_dn.mulVec v) i) := by
      intro a b c hc h M_up M_dn hM v
      subst hM
      ext i
      have h_entry : ∀ j : Fin M,
          M_up i j * emb_zmod a b c hc (v j) =
            emb_zmod a b c hc (ZMod.castHom h (ZMod (ℓ ^ (a + 1))) (M_up i j) * v j) := by
        intro j
        set x_ij : ZMod (ℓ ^ (c + 1)) := M_up i j
        have hij : ZMod.castHom h (ZMod (ℓ ^ (a + 1))) x_ij =
            (x_ij.val : ZMod (ℓ ^ (a + 1))) := by
          conv_lhs => rw [← ZMod.natCast_zmod_val x_ij]
          rw [map_natCast]
        rw [hemb_apply a b c hc, hemb_apply a b c hc, hij, ZMod.val_mul, ZMod.val_natCast,
          Nat.mod_mul_mod, hModEq a b c hc (x_ij.val * (v j).val), ← mul_assoc,
          mul_comm (ℓ ^ (b + 1)) x_ij.val, mul_assoc,
          Nat.cast_mul x_ij.val, ZMod.natCast_zmod_val]
      simp only [Matrix.mulVec, dotProduct, map_sum, Matrix.map_apply]
      exact Finset.sum_congr rfl fun j _ => h_entry j

    have hι_bock_pkg : ∀ (a b c : ℕ) (hc : a + b + 1 = c),
        ∃ φ : Quiver.Hom (𝒥_ab a) (𝒥_ab c),
          ∀ (hac : a ≤ c) (W : S.Etale) (s_a : ↑((𝒥_ab a).obj.obj (Opposite.op W)))
            (y : ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom (ι_V c))) (i : Fin M),
            triv_J c W ((φ.hom.app (Opposite.op W)).hom s_a) y i =
              emb_zmod a b c hc (triv_J a W s_a ((m_le (Fgt.obj W).hom hac).base y) i) := by
      intro a b c hc
      have hac₀ : a ≤ c := by omega
      have hRange_W : ∀ (W : S.Etale) (s_a : ↑((𝒥_ab a).obj.obj (Opposite.op W))),
          ((triv_J a W s_a).comap (m_le (Fgt.obj W).hom hac₀).base.hom).map
            (fun v i => emb_zmod a b c hc (v i)) ∈ Set.range (triv_J c W) := by
        intro W s_a
        let h_W := (Fgt.obj W).hom
        have hs_mem : triv_J a W s_a ∈ Set.range (triv_J a W) := ⟨s_a, rfl⟩
        rw [htriv_J_range a W] at hs_mem
        obtain ⟨⟨W₀, hW₀_top, hW₀_van⟩, hs_eqv⟩ := hs_mem
        rw [htriv_J_range c W]
        refine ⟨⟨W₀, hW₀_top, ?_⟩, ?_⟩
        · intro y hy
          have hy_a : (CategoryTheory.Limits.pullback.fst h_W (ι_V a)).base
              ((m_le h_W hac₀).base y) ∈ W₀ := by
            have h1 := congrArg (fun k => k.base y) (hm_le_fst h_W hac₀)
            rw [← h1, AlgebraicGeometry.Scheme.Hom.comp_apply] at hy
            exact hy
          ext i
          change emb_zmod a b c hc (triv_J a W s_a ((m_le h_W hac₀).base y) i) = 0
          rw [hW₀_van _ hy_a, Pi.zero_apply, map_zero]
        · intro γ_c m_γc hfst hsnd y
          obtain ⟨γ_a, hcomm_a, hmat_a⟩ := h_resΓ_le hac₀ γ_c
          let m_γa : CategoryTheory.Limits.pullback h_W (ι_V a) ⟶
              CategoryTheory.Limits.pullback h_W (ι_V a) :=
            CategoryTheory.Limits.pullback.lift
              (CategoryTheory.Limits.pullback.fst h_W (ι_V a))
              (CategoryTheory.Limits.pullback.snd h_W (ι_V a) ≫ act a γ_a)
              (by rw [CategoryTheory.Category.assoc, h_over_ι a γ_a,
                    CategoryTheory.Limits.pullback.condition])
          have hsq : m_γc ≫ m_le h_W hac₀ = m_le h_W hac₀ ≫ m_γa := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hfst,
                CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                CategoryTheory.Limits.pullback.lift_fst]
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                ← CategoryTheory.Category.assoc, hsnd, CategoryTheory.Category.assoc, ← hcomm_a,
                CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                ← CategoryTheory.Category.assoc (m_le h_W hac₀),
                CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc]
          have hbase : (m_le h_W hac₀).base (m_γc.base y) = m_γa.base ((m_le h_W hac₀).base y) :=
            congrArg (fun k => k.base y) hsq
          change (fun i => emb_zmod a b c hc (triv_J a W s_a ((m_le h_W hac₀).base (m_γc.base y)) i)) =
            ((τ_rep c γ_c).val).mulVec
              (fun i => emb_zmod a b c hc (triv_J a W s_a ((m_le h_W hac₀).base y) i))
          rw [hbase, hs_eqv γ_a m_γa (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _) ((m_le h_W hac₀).base y)]
          exact (hemb_mulVec a b c hc (pow_dvd_pow ℓ (Nat.add_le_add_right hac₀ 1))
            (τ_rep c γ_c).val (τ_rep a γ_a).val hmat_a _).symm
      let φ_fn : ∀ W : S.Etale,
          ↑((𝒥_ab a).obj.obj (Opposite.op W)) → ↑((𝒥_ab c).obj.obj (Opposite.op W)) :=
        fun W s_a => Classical.choose (hRange_W W s_a)
      have hφ_spec : ∀ (W : S.Etale) (s_a : ↑((𝒥_ab a).obj.obj (Opposite.op W))),
          triv_J c W (φ_fn W s_a) =
            ((triv_J a W s_a).comap (m_le (Fgt.obj W).hom hac₀).base.hom).map
              (fun v i => emb_zmod a b c hc (v i)) :=
        fun W s_a => Classical.choose_spec (hRange_W W s_a)
      let φ_add : ∀ W : S.Etale,
          ↑((𝒥_ab a).obj.obj (Opposite.op W)) →+ ↑((𝒥_ab c).obj.obj (Opposite.op W)) :=
        fun W => AddMonoidHom.mk' (φ_fn W) (fun s₁ s₂ => by
          apply htriv_J_inj c W
          rw [map_add, hφ_spec, hφ_spec, hφ_spec]
          ext y i
          change emb_zmod a b c hc (triv_J a W (s₁ + s₂) _ i) =
            emb_zmod a b c hc (triv_J a W s₁ _ i) + emb_zmod a b c hc (triv_J a W s₂ _ i)
          rw [map_add, LocallyConstant.add_apply, Pi.add_apply, map_add])
      let η : (𝒥_ab a).obj ⟶ (𝒥_ab c).obj :=
        { app := fun W_op => AddCommGrpCat.ofHom (φ_add W_op.unop)
          naturality := fun {W₂_op W₁_op} u_op => by
            rcases W₂_op with ⟨W₂⟩
            rcases W₁_op with ⟨W₁⟩
            rcases u_op with ⟨u⟩
            apply AddCommGrpCat.ext
            intro s_a
            apply htriv_J_inj c W₁
            ext y₁ i
            let u_Vc : CategoryTheory.Limits.pullback (Fgt.obj W₁).hom (ι_V c) ⟶
                CategoryTheory.Limits.pullback (Fgt.obj W₂).hom (ι_V c) :=
              CategoryTheory.Limits.pullback.lift
                (CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom (ι_V c) ≫ (Fgt.map u).left)
                (CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom (ι_V c))
                (by rw [CategoryTheory.Category.assoc, (Fgt.map u).w,
                      CategoryTheory.Limits.pullback.condition])
            let u_Va : CategoryTheory.Limits.pullback (Fgt.obj W₁).hom (ι_V a) ⟶
                CategoryTheory.Limits.pullback (Fgt.obj W₂).hom (ι_V a) :=
              CategoryTheory.Limits.pullback.lift
                (CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom (ι_V a) ≫ (Fgt.map u).left)
                (CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom (ι_V a))
                (by rw [CategoryTheory.Category.assoc, (Fgt.map u).w,
                      CategoryTheory.Limits.pullback.condition])
            have hsq : m_le (Fgt.obj W₁).hom hac₀ ≫ u_Va = u_Vc ≫ m_le (Fgt.obj W₂).hom hac₀ := by
              apply CategoryTheory.Limits.pullback.hom_ext
              · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                  ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                  CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                  CategoryTheory.Limits.pullback.lift_fst]
              · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                  CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_snd]
            have hbase : u_Va.base ((m_le (Fgt.obj W₁).hom hac₀).base y₁) =
                (m_le (Fgt.obj W₂).hom hac₀).base (u_Vc.base y₁) :=
              congrArg (fun k => k.base y₁) hsq
            change triv_J c W₁ (φ_fn W₁ (((𝒥_ab a).obj.map (Opposite.op u)).hom s_a)) y₁ i =
              triv_J c W₁ (((𝒥_ab c).obj.map (Opposite.op u)).hom (φ_fn W₂ s_a)) y₁ i
            rw [hφ_spec W₁,
              htriv_J_nat c u u_Vc (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                (CategoryTheory.Limits.pullback.lift_snd _ _ _) (φ_fn W₂ s_a) y₁,
              hφ_spec W₂]
            change emb_zmod a b c hc
                (triv_J a W₁ (((𝒥_ab a).obj.map (Opposite.op u)).hom s_a)
                  ((m_le (Fgt.obj W₁).hom hac₀).base y₁) i) =
              emb_zmod a b c hc
                (triv_J a W₂ s_a ((m_le (Fgt.obj W₂).hom hac₀).base (u_Vc.base y₁)) i)
            rw [htriv_J_nat a u u_Va (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                  (CategoryTheory.Limits.pullback.lift_snd _ _ _) s_a _, hbase] }
      refine ⟨CategoryTheory.ObjectProperty.homMk η, fun hac W s_a y i => ?_⟩
      have hh : hac = hac₀ := rfl
      subst hh
      exact congrFun (congrArg DFunLike.coe (hφ_spec W s_a) |> fun h => congrFun h y) i

    choose ι_bock_sh hι_bock_spec using hι_bock_pkg

    have hDiagPkg : ∀ (k : ℕ) (U_et : S.Etale) (g_U : Quiver.Hom (Fgt.obj U_et).left (V k))
        (_hg_U : CategoryTheory.CategoryStruct.comp g_U (ι_V k) = (Fgt.obj U_et).hom),
        ∃ δ₁ : Quiver.Hom (Fgt.obj U_et).left
            (CategoryTheory.Limits.pullback (Fgt.obj U_et).hom (ι_V k)),
          CategoryTheory.CategoryStruct.comp δ₁
            (CategoryTheory.Limits.pullback.fst (Fgt.obj U_et).hom (ι_V k)) =
            CategoryTheory.CategoryStruct.id (Fgt.obj U_et).left ∧
          CategoryTheory.CategoryStruct.comp δ₁
            (CategoryTheory.Limits.pullback.snd (Fgt.obj U_et).hom (ι_V k)) = g_U ∧
          (∀ h₀ : LocallyConstant ↥(Fgt.obj U_et).left (Fin M → ZMod (ℓ ^ (k + 1))),
            ∃ s_U : ↑((𝒥_ab k).obj.obj (Opposite.op U_et)),
              ∀ q : ↥(Fgt.obj U_et).left, triv_J k U_et s_U (δ₁.base q) = h₀ q) ∧
          (∀ s₁ s₂ : ↑((𝒥_ab k).obj.obj (Opposite.op U_et)),
            (∀ q : ↥(Fgt.obj U_et).left,
              triv_J k U_et s₁ (δ₁.base q) = triv_J k U_et s₂ (δ₁.base q)) →
            s₁ = s₂) := by
      intro k U_et g_U hg_U
      let Y := (Fgt.obj U_et).left
      let h_Y := (Fgt.obj U_et).hom
      let Y_V := CategoryTheory.Limits.pullback h_Y (ι_V k)
      let r₁ := CategoryTheory.Limits.pullback.fst h_Y (ι_V k)
      let r₂ := CategoryTheory.Limits.pullback.snd h_Y (ι_V k)
      let δ_Y : Γ k → Quiver.Hom Y Y_V := fun σ =>
        CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id Y)
          (g_U ≫ act k σ)
          (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
                h_over_ι k σ, hg_U])
      have hδY_r₁ : ∀ σ : Γ k, δ_Y σ ≫ r₁ = CategoryTheory.CategoryStruct.id Y :=
        fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hδY_r₂ : ∀ σ : Γ k, δ_Y σ ≫ r₂ = g_U ≫ act k σ :=
        fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hr_π : (r₁ ≫ g_U) ≫ π k = r₂ ≫ π k := by
        apply (cancel_mono U.ι).mp
        calc ((r₁ ≫ g_U) ≫ π k) ≫ U.ι
            = r₁ ≫ (g_U ≫ ι_V k) := by simp only [ι_V, CategoryTheory.Category.assoc]
          _ = r₁ ≫ h_Y := by rw [hg_U]
          _ = r₂ ≫ ι_V k := CategoryTheory.Limits.pullback.condition
          _ = (r₂ ≫ π k) ≫ U.ι := by simp only [ι_V, CategoryTheory.Category.assoc]
      let Φ_Y : Y_V ⟶ CategoryTheory.Limits.pullback (π k) (π k) :=
        CategoryTheory.Limits.pullback.lift (r₁ ≫ g_U) r₂ hr_π
      have hcomm_δ : ∀ σ : Γ k, δ_Y σ ≫ Φ_Y = g_U ≫ δ_gal k σ := by
        intro σ
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            ← CategoryTheory.Category.assoc, hδY_r₁ σ, CategoryTheory.Category.id_comp,
            CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.comp_id]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd, hδY_r₂ σ,
            CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
      have hPb_δ : ∀ σ : Γ k, CategoryTheory.IsPullback (δ_Y σ) g_U Φ_Y (δ_gal k σ) := by
        intro σ
        exact CategoryTheory.IsPullback.of_isLimit
          (CategoryTheory.Limits.PullbackCone.IsLimit.mk (hcomm_δ σ)
            (fun s => s.fst ≫ r₁)
            (fun s => by
              have hs_fst : s.fst ≫ r₁ ≫ g_U = s.snd := by
                have h1 := congrArg (· ≫ CategoryTheory.Limits.pullback.fst (π k) (π k)) s.condition
                simpa only [Φ_Y, δ_gal, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id] using h1
              apply CategoryTheory.Limits.pullback.hom_ext
              · change ((s.fst ≫ r₁) ≫ δ_Y σ) ≫ r₁ = s.fst ≫ r₁
                rw [CategoryTheory.Category.assoc, hδY_r₁ σ, CategoryTheory.Category.comp_id]
              · have h2 := congrArg (· ≫ CategoryTheory.Limits.pullback.snd (π k) (π k)) s.condition
                simp only [Φ_Y, δ_gal, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_snd] at h2
                change ((s.fst ≫ r₁) ≫ δ_Y σ) ≫ r₂ = s.fst ≫ r₂
                rw [CategoryTheory.Category.assoc, hδY_r₂ σ,
                  ← CategoryTheory.Category.assoc (s.fst ≫ r₁),
                  CategoryTheory.Category.assoc s.fst r₁ g_U, hs_fst, h2])
            (fun s => by
              have h1 := congrArg (· ≫ CategoryTheory.Limits.pullback.fst (π k) (π k)) s.condition
              simpa only [Φ_Y, δ_gal, CategoryTheory.Category.assoc,
                CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id] using h1)
            (fun s m hm₁ _ => by
              have h : (m ≫ δ_Y σ) ≫ r₁ = s.fst ≫ r₁ := congrArg (· ≫ r₁) hm₁
              rwa [CategoryTheory.Category.assoc, hδY_r₁ σ, CategoryTheory.Category.comp_id] at h))
      have hRange_δ : ∀ σ : Γ k,
          Set.range (δ_Y σ).base = Φ_Y.base ⁻¹' Set.range (δ_gal k σ).base := by
        intro σ
        ext z
        constructor
        · rintro ⟨y, rfl⟩
          change (δ_Y σ ≫ Φ_Y).base y ∈ Set.range (δ_gal k σ).base
          rw [hcomm_δ σ]
          exact ⟨g_U.base y, rfl⟩
        · rintro ⟨v, hv⟩
          obtain ⟨q, hq_fst, _⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z v hv.symm
          refine ⟨((hPb_δ σ).isoPullback.inv).base q, ?_⟩
          have h1 := congrArg (fun f => f.base q) (hPb_δ σ).isoPullback_inv_fst
          exact h1.trans hq_fst
      have hOpen_δ : ∀ σ : Γ k, IsOpen (Set.range (δ_Y σ).base) := by
        intro σ
        rw [hRange_δ σ]
        have : AlgebraicGeometry.IsOpenImmersion (δ_gal k σ) := hδ_open k σ
        exact (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding (δ_gal k σ)).isOpen_range.preimage
          (AlgebraicGeometry.Scheme.Hom.continuous Φ_Y)
      have hDisj_δ : ∀ σ₁ σ₂ : Γ k, σ₁ ≠ σ₂ →
          Disjoint (Set.range (δ_Y σ₁).base) (Set.range (δ_Y σ₂).base) := by
        intro σ₁ σ₂ hne
        rw [hRange_δ σ₁, hRange_δ σ₂]
        exact (hδ_disj k hne).preimage Φ_Y.base
      have hCover_δ : ∀ z : ↥Y_V, ∃ σ : Γ k, z ∈ Set.range (δ_Y σ).base := by
        intro z
        have hz : Φ_Y.base z ∈ ⋃ σ : Γ k, Set.range (δ_gal k σ).base := by
          rw [hδ_univ k]
          trivial
        obtain ⟨σ, hσ⟩ := Set.mem_iUnion.mp hz
        exact ⟨σ, (hRange_δ σ).symm ▸ hσ⟩
      have hAct_δ : ∀ (σ τ : Γ k) (m_τ : Quiver.Hom Y_V Y_V),
          m_τ ≫ r₁ = r₁ → m_τ ≫ r₂ = r₂ ≫ act k τ →
          δ_Y σ ≫ m_τ = δ_Y (τ * σ) := by
        intro σ τ m_τ hm_fst hm_snd
        apply CategoryTheory.Limits.pullback.hom_ext
        · change (δ_Y σ ≫ m_τ) ≫ r₁ = δ_Y (τ * σ) ≫ r₁
          rw [CategoryTheory.Category.assoc, hm_fst, hδY_r₁, hδY_r₁]
        · change (δ_Y σ ≫ m_τ) ≫ r₂ = δ_Y (τ * σ) ≫ r₂
          rw [CategoryTheory.Category.assoc, hm_snd, ← CategoryTheory.Category.assoc,
            hδY_r₂, hδY_r₂, CategoryTheory.Category.assoc, ← h_act_mul k τ σ]
      let σ_of : ↥Y_V → Γ k := fun z => Classical.choose (hCover_δ z)
      have hσ_mem : ∀ z : ↥Y_V, z ∈ Set.range (δ_Y (σ_of z)).base :=
        fun z => Classical.choose_spec (hCover_δ z)
      have hσ_uniq : ∀ (z : ↥Y_V) (σ : Γ k), z ∈ Set.range (δ_Y σ).base → σ_of z = σ := by
        intro z σ hz
        by_contra hne
        exact Set.disjoint_left.mp (hDisj_δ (σ_of z) σ hne) (hσ_mem z) hz
      have hδ_fst_inv : ∀ (z : ↥Y_V) (σ : Γ k),
          z ∈ Set.range (δ_Y σ).base → (δ_Y σ).base (r₁.base z) = z := by
        rintro z σ ⟨q, rfl⟩
        have hq : r₁.base ((δ_Y σ).base q) = q :=
          congrArg (fun f => f.base q) (hδY_r₁ σ)
        rw [hq]
      refine ⟨δ_Y 1, hδY_r₁ 1, ?_, ?_, ?_⟩
      · rw [hδY_r₂ 1, h_act_one k, CategoryTheory.Category.comp_id]
      · intro h₀
        let F_raw : ↥Y_V → (Fin M → ZMod (ℓ ^ (k + 1))) :=
          fun z => ((τ_rep k (σ_of z)).val).mulVec (h₀ (r₁.base z))
        have hF_lc : IsLocallyConstant F_raw := by
          rw [IsLocallyConstant.iff_exists_open]
          intro z
          let σ := σ_of z
          let O := Set.range (δ_Y σ).base ∩ r₁.base ⁻¹' (h₀ ⁻¹' {h₀ (r₁.base z)})
          have hO_open : IsOpen O :=
            (hOpen_δ σ).inter
              ((h₀.isLocallyConstant {h₀ (r₁.base z)}).preimage
                (AlgebraicGeometry.Scheme.Hom.continuous r₁))
          refine ⟨O, hO_open, ⟨hσ_mem z, rfl⟩, ?_⟩
          rintro z' ⟨hz'_s, hz'_h⟩
          have hσ_eq : σ_of z' = σ := hσ_uniq z' σ hz'_s
          have hh_eq : h₀ (r₁.base z') = h₀ (r₁.base z) := hz'_h
          dsimp only [F_raw]
          rw [hσ_eq, hh_eq]
        let F_lc : LocallyConstant ↥Y_V (Fin M → ZMod (ℓ ^ (k + 1))) := ⟨F_raw, hF_lc⟩
        have hF_mem : F_lc ∈ Set.range (triv_J k U_et) := by
          change F_lc ∈ Set.range ((triv k U_et).comp ((ι_ext k).hom.app (Opposite.op U_et)).hom.toAddMonoidHom)
          rw [((hPair k).2 U_et).2.2.2]
          refine ⟨⟨⊥, ?_, fun _ hy => False.elim hy⟩, ?_⟩
          · rw [sup_bot_eq, eq_top_iff]
            intro q _
            change h_Y.base q ∈ (U : Set ↥S)
            have hq : h_Y.base q = U.ι.base ((π k).base (g_U.base q)) :=
              congrArg (fun f => f.base q) hg_U.symm
            rw [hq, ← AlgebraicGeometry.Scheme.Opens.range_ι]
            exact ⟨_, rfl⟩
          · intro μ m_μ hm_fst hm_snd z
            let σ := σ_of z
            have hz_eq : z = (δ_Y σ).base (r₁.base z) := (hδ_fst_inv z σ (hσ_mem z)).symm
            have hm_z : m_μ.base z = (δ_Y (μ * σ)).base (r₁.base z) := by
              conv_lhs => rw [hz_eq]
              exact congrArg (fun f => f.base (r₁.base z)) (hAct_δ σ μ m_μ hm_fst hm_snd)
            have hσ_mz : σ_of (m_μ.base z) = μ * σ :=
              hσ_uniq (m_μ.base z) (μ * σ) ⟨r₁.base z, hm_z.symm⟩
            have hr₁_mz : r₁.base (m_μ.base z) = r₁.base z :=
              congrArg (fun f => f.base z) hm_fst
            change ((τ_rep k (σ_of (m_μ.base z))).val).mulVec (h₀ (r₁.base (m_μ.base z))) =
              ((τ_rep k μ).val).mulVec (((τ_rep k σ).val).mulVec (h₀ (r₁.base z)))
            rw [hσ_mz, hr₁_mz, map_mul, Units.val_mul, Matrix.mulVec_mulVec]
        obtain ⟨s_U, hs_U⟩ := hF_mem
        refine ⟨s_U, fun q => ?_⟩
        rw [hs_U]
        have hσ1 : σ_of ((δ_Y 1).base q) = 1 := hσ_uniq ((δ_Y 1).base q) 1 ⟨q, rfl⟩
        have hr₁1 : r₁.base ((δ_Y 1).base q) = q :=
          congrArg (fun f => f.base q) (hδY_r₁ 1)
        change ((τ_rep k (σ_of ((δ_Y 1).base q))).val).mulVec (h₀ (r₁.base ((δ_Y 1).base q))) = h₀ q
        rw [hσ1, hr₁1, map_one, Units.val_one, Matrix.one_mulVec]
      · intro s₁ s₂ hs_eq
        apply htriv_J_inj k U_et
        ext z i
        let σ := σ_of z
        let q := r₁.base z
        have hz_eq : z = (δ_Y σ).base q := (hδ_fst_inv z σ (hσ_mem z)).symm
        let m_σ : Y_V ⟶ Y_V :=
          CategoryTheory.Limits.pullback.lift r₁ (r₂ ≫ act k σ)
            (by rw [CategoryTheory.Category.assoc, h_over_ι k σ,
                  CategoryTheory.Limits.pullback.condition])
        have hm_δ1 : m_σ.base ((δ_Y 1).base q) = z := by
          have hact := hAct_δ 1 σ m_σ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          rw [mul_one] at hact
          exact (congrArg (fun f => f.base q) hact).trans hz_eq.symm
        have heqv₁ : triv_J k U_et s₁ (m_σ.base ((δ_Y 1).base q)) =
            ((τ_rep k σ).val).mulVec (triv_J k U_et s₁ ((δ_Y 1).base q)) := by
          have hmem : triv_J k U_et s₁ ∈ Set.range (triv_J k U_et) := ⟨s₁, rfl⟩
          rw [htriv_J_range k U_et] at hmem
          exact hmem.2 σ m_σ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) ((δ_Y 1).base q)
        have heqv₂ : triv_J k U_et s₂ (m_σ.base ((δ_Y 1).base q)) =
            ((τ_rep k σ).val).mulVec (triv_J k U_et s₂ ((δ_Y 1).base q)) := by
          have hmem : triv_J k U_et s₂ ∈ Set.range (triv_J k U_et) := ⟨s₂, rfl⟩
          rw [htriv_J_range k U_et] at hmem
          exact hmem.2 σ m_σ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) ((δ_Y 1).base q)
        rw [← hm_δ1, heqv₁, heqv₂, hs_eq q]

    have hLiftPt : ∀ (c : ℕ) (W_sch : AlgebraicGeometry.Scheme.{u}) (h_W : Quiver.Hom W_sch S)
        (x : ↥W_sch),
        h_W.base x ∈ U →
        ∃ y : ↥(CategoryTheory.Limits.pullback h_W (ι_V c)),
          (CategoryTheory.Limits.pullback.fst h_W (ι_V c)).base y = x := by
      intro c W_sch h_W x hx
      have hx_r : h_W.base x ∈ Set.range U.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        exact hx
      obtain ⟨u_pt, hu_pt⟩ := hx_r
      obtain ⟨v_pt, hv_pt⟩ := (hπ_surj c).1 u_pt
      have hv_eq : h_W.base x = (ι_V c).base v_pt := by
        change h_W.base x = U.ι.base ((π c).base v_pt)
        rw [hv_pt, hu_pt]
      obtain ⟨y, hy_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x v_pt hv_eq
      exact ⟨y, hy_fst⟩

    have h0_bock : ∀ (a b c : ℕ) (hc : a + b + 1 = c) (hbc : b ≤ c),
        CategoryTheory.CategoryStruct.comp (ι_bock_sh a b c hc) (τ_𝒥_ab_le hbc) = 0 := by
      intro a b c hc hbc
      have hac : a ≤ c := by omega
      apply hSheafHomExt_J
      intro W s_a y_b i
      obtain ⟨y_c, rfl⟩ := hm_le_surj (Fgt.obj W).hom hbc y_b
      have h0_hom : ((0 : Quiver.Hom (𝒥_ab a) (𝒥_ab b)).hom) = 0 :=
        (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).map_zero _ _
      rw [h0_hom]
      change triv_J b W (((τ_𝒥_ab_le hbc).hom.app (Opposite.op W)).hom
          (((ι_bock_sh a b c hc).hom.app (Opposite.op W)).hom s_a))
          ((m_le (Fgt.obj W).hom hbc).base y_c) i =
        triv_J b W 0 _ i
      rw [hτ_le_spec hbc, hι_bock_spec a b c hc hac, map_zero, LocallyConstant.coe_zero, Pi.zero_apply]
      exact (hemb_ker a b c hc _ _).mpr ⟨_, rfl⟩

    have hSE_bock : ∀ (a b c : ℕ) (hc : a + b + 1 = c) (hbc : b ≤ c),
        (CategoryTheory.ShortComplex.mk (ι_bock_sh a b c hc) (τ_𝒥_ab_le hbc)
          (h0_bock a b c hc hbc)).ShortExact := by
      intro a b c hc hbc
      have hac : a ≤ c := by omega
      refine hShortExact_crit (𝒥_ab a) (𝒥_ab c) (𝒥_ab b)
        (ι_bock_sh a b c hc) (τ_𝒥_ab_le hbc) (h0_bock a b c hc hbc) ?_ ?_ ?_
      · intro W s₁ s₂ hs
        apply htriv_J_inj a W
        ext y_a i
        obtain ⟨y_c, rfl⟩ := hm_le_surj (Fgt.obj W).hom hac y_a
        apply hemb_inj a b c hc
        rw [← hι_bock_spec a b c hc hac W s₁ y_c i, ← hι_bock_spec a b c hc hac W s₂ y_c i]
        exact congrFun (congrArg DFunLike.coe (congrArg (triv_J c W) hs) |> fun h => congrFun h y_c) i
      · intro W s₂ hs₂ x
        let h_W := (Fgt.obj W).hom
        have hf₂_mem : triv_J c W s₂ ∈ Set.range (triv_J c W) := ⟨s₂, rfl⟩
        rw [htriv_J_range c W] at hf₂_mem
        obtain ⟨⟨W₀, hW₀_top, hW₀_zero⟩, _⟩ := hf₂_mem
        have hx_cov : x ∈ ((TopologicalSpace.Opens.map h_W.base).obj U) ⊔ W₀ := by
          rw [hW₀_top]
          trivial
        rcases hx_cov with hx_U | hx_W₀
        · obtain ⟨y_c, hy_c⟩ := hLiftPt c (Fgt.obj W).left h_W x hx_U
          let U_sch := CategoryTheory.Limits.pullback h_W (ι_V c)
          let u_sch : U_sch ⟶ (Fgt.obj W).left := CategoryTheory.Limits.pullback.fst h_W (ι_V c)
          let g_top : U_sch ⟶ V c := CategoryTheory.Limits.pullback.snd h_W (ι_V c)
          have : AlgebraicGeometry.Etale h_W := W.prop
          have : AlgebraicGeometry.Etale (ι_V c) := hι_V_et c
          have : AlgebraicGeometry.Etale u_sch := inferInstance
          have : AlgebraicGeometry.Etale (u_sch ≫ h_W) := inferInstance
          let U_et : S.Etale := AlgebraicGeometry.Scheme.Etale.mk (u_sch ≫ h_W)
          let u : Quiver.Hom U_et W := CategoryTheory.MorphismProperty.Over.homMk u_sch rfl trivial
          have hg_top : g_top ≫ ι_V c = (Fgt.obj U_et).hom :=
            CategoryTheory.Limits.pullback.condition.symm
          let g_Ua : U_sch ⟶ V a := g_top ≫ p_le hac
          have hg_Ua : g_Ua ≫ ι_V a = (Fgt.obj U_et).hom := by
            rw [CategoryTheory.Category.assoc, hp_le_ι hac, hg_top]
          obtain ⟨δ₁_top, hδ₁_top_fst, hδ₁_top_snd, _, hDiagInj_top⟩ :=
            hDiagPkg c U_et g_top hg_top
          obtain ⟨δ₁_a, hδ₁_a_fst, hδ₁_a_snd, hDiagLift_a, _⟩ :=
            hDiagPkg a U_et g_Ua hg_Ua
          have hδ₁_comm : δ₁_top ≫ m_le (Fgt.obj U_et).hom hac = δ₁_a := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                hδ₁_top_fst, hδ₁_a_fst]
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                ← CategoryTheory.Category.assoc, hδ₁_top_snd, hδ₁_a_snd]
              rfl
          let s₂_U := ((𝒥_ab c).obj.map (Opposite.op u)).hom s₂
          have hs₂_U_ker : (((τ_𝒥_ab_le hbc).hom.app (Opposite.op U_et)).hom s₂_U) = 0 := by
            have hnat := congrArg (fun f => f.hom s₂) ((τ_𝒥_ab_le hbc).hom.naturality (Opposite.op u))
            change ((τ_𝒥_ab_le hbc).hom.app (Opposite.op U_et)).hom s₂_U =
              ((𝒥_ab b).obj.map (Opposite.op u)).hom (((τ_𝒥_ab_le hbc).hom.app (Opposite.op W)).hom s₂) at hnat
            have hs₂' : ((τ_𝒥_ab_le hbc).hom.app (Opposite.op W)).hom s₂ = 0 := hs₂
            rw [hnat, hs₂', map_zero]
            rfl
          let h_dvd_b := pow_dvd_pow ℓ (Nat.add_le_add_right hbc 1)
          let unemb : ZMod (ℓ ^ (c + 1)) → ZMod (ℓ ^ (a + 1)) := fun z =>
            if hz : ZMod.castHom h_dvd_b (ZMod (ℓ ^ (b + 1))) z = 0 then
              Classical.choose ((hemb_ker a b c hc h_dvd_b z).mp hz)
            else 0
          let h₀_a : LocallyConstant ↥U_sch (Fin M → ZMod (ℓ ^ (a + 1))) :=
            ((triv_J c U_et s₂_U).comap δ₁_top.base.hom).map (fun v i => unemb (v i))
          have hh₀_a_spec : ∀ (q : ↥U_sch) (i : Fin M),
              emb_zmod a b c hc (h₀_a q i) = triv_J c U_et s₂_U (δ₁_top.base q) i := by
            intro q i
            have hz0 : ZMod.castHom h_dvd_b (ZMod (ℓ ^ (b + 1)))
                (triv_J c U_et s₂_U (δ₁_top.base q) i) = 0 := by
              rw [← hτ_le_spec hbc U_et s₂_U (δ₁_top.base q) i, hs₂_U_ker, map_zero]
              rfl
