          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        refine (congrArg L₁₂ hsplit).trans
          ((L₁₂.map_mul' _ _).trans
            ((congrArg₂ (· * ·) ?_ ?_).trans
