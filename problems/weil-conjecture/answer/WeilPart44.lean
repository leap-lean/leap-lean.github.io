        ((hσ_outer W g g).symm.trans
          ((congrArg (· ≫ u_can (m_can W g))
            ((congrArg (σ_g W ·) (mul_one g).symm).trans (hσ_inner W 1 g).symm)).trans
            (CategoryTheory.Category.assoc _ _ _)))
    have hσ_bc : ∀ {W₁ W₂ : S.Etale} (u : Quiver.Hom W₁ W₂) (g : Γ),
        CategoryTheory.CategoryStruct.comp (u_can u) (σ_g W₂ g) =
          CategoryTheory.CategoryStruct.comp (σ_g W₁ g) (u_can (u_can u)) := by
      intro W₁ W₂ u g
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·) (hσ_fst W₂ g)).trans
            ((CategoryTheory.Category.comp_id _).trans
