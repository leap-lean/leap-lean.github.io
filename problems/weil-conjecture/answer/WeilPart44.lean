    · have hmap := congrArg (RingHom.mapMatrix π_mod) hJ_mul_adj
      change (RingHom.mapMatrix π_mod) J_int * (RingHom.mapMatrix π_mod) J_adj = _
      rw [← map_mul (RingHom.mapMatrix π_mod), hmap]
      ext i j
      by_cases hij : i = j <;>
