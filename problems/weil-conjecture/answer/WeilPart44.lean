  let χ_tilde : Γ → ZMod (ℓ ^ K') :=
    fun σ => ((Matrix.trace (τ_rep σ).val).val : ZMod (ℓ ^ K'))
  let cast_K_K' := ZMod.castHom (pow_dvd_pow ℓ hK'K) (ZMod (ℓ ^ K'))
  let cast_K'_s := ZMod.castHom (pow_dvd_pow ℓ hsK') (ZMod (ℓ ^ (s + 1)))
  let cast_K_s := ZMod.castHom (pow_dvd_pow ℓ (hsK'.trans hK'K)) (ZMod (ℓ ^ (s + 1)))
  let T_cohom : ZMod (ℓ ^ K') := ∑ c : Γ, cast_K_K' (f c⁻¹) * χ_tilde c
  refine ⟨P_σ, T_cohom, hLat_Pσ, ?_, ?_⟩
  · change cast_K'_s (∑ c : Γ, cast_K_K' (f c⁻¹) * χ_tilde c) = cast_K_s (weilCurveTrAltTrace F_K)
    rw [map_sum]
    have h_comp : ∀ x : ZMod (ℓ ^ K), cast_K'_s (cast_K_K' x) = cast_K_s x := by
      intro x
      change (cast_K'_s.comp cast_K_K') x = _
      rw [ZMod.castHom_comp]
    have h_chi : ∀ c : Γ, cast_K'_s (χ_tilde c) = Matrix.trace (τ_rep c).val := by
      intro c
      change cast_K'_s (((Matrix.trace (τ_rep c).val).val : ℕ) : ZMod (ℓ ^ K')) = _
      rw [map_natCast, ZMod.natCast_zmod_val]
    have h_term_b : ∀ c : Γ,
        cast_K'_s (cast_K_K' (f c⁻¹) * χ_tilde c) =
          (∑ j : Fin m₀, cast_K_s (((Φ0_tilde (Pi.single j 1)) j).coeff c⁻¹)) *
            Matrix.trace (τ_rep c).val -
          (∑ j : Fin m₁, cast_K_s (((Φ₁ (Pi.single j 1)) j).coeff c⁻¹)) *
            Matrix.trace (τ_rep c).val +
          (∑ j : Fin m₂, cast_K_s (((Φ₂ (Pi.single j 1)) j).coeff c⁻¹)) *
            Matrix.trace (τ_rep c).val := by
      intro c
      rw [map_mul, h_comp, h_chi]
      dsimp only [f]
      rw [map_add, map_sub, map_sum, map_sum, map_sum, add_mul, sub_mul]
    simp_rw [h_term_b]
    rw [Finset.sum_add_distrib, Finset.sum_sub_distrib]
    exact hTr_FK.symm
  · have h_chi_conj : ∀ (u σ : Γ), χ_tilde (u⁻¹ * σ * u) = χ_tilde σ := by
      intro u σ
      dsimp only [χ_tilde]
      congr 2
      have h_mul : (τ_rep (u⁻¹ * σ * u)).val =
          ((τ_rep u)⁻¹).val * (τ_rep σ).val * (τ_rep u).val := by
        rw [map_mul, map_mul, map_inv, Units.val_mul, Units.val_mul]
      rw [h_mul]
      exact Matrix.trace_units_conj' (τ_rep u) (τ_rep σ).val
    have h_Pσ_sum : ∀ σ : Γ, weilCurveTrAltTrace (P_σ σ) = ∑ u : Γ, f ((u⁻¹ * σ * u)⁻¹) := by
      intro σ
      rw [hTr_Pσ σ]
      dsimp only [f]
      rw [Finset.sum_add_distrib, Finset.sum_sub_distrib]
    change (∑ σ : Γ, cast_K_K' (weilCurveTrAltTrace (P_σ σ)) * χ_tilde σ) =
      (Fintype.card Γ : ZMod (ℓ ^ K')) * T_cohom
    have h_lhs_c : (∑ σ : Γ, cast_K_K' (weilCurveTrAltTrace (P_σ σ)) * χ_tilde σ) =
        ∑ u : Γ, ∑ σ : Γ, cast_K_K' (f ((u⁻¹ * σ * u)⁻¹)) * χ_tilde (u⁻¹ * σ * u) := by
      calc
        (∑ σ : Γ, cast_K_K' (weilCurveTrAltTrace (P_σ σ)) * χ_tilde σ)
            = ∑ σ : Γ, ∑ u : Γ, cast_K_K' (f ((u⁻¹ * σ * u)⁻¹)) * χ_tilde σ := by
              refine Finset.sum_congr rfl fun σ _ => ?_
              rw [h_Pσ_sum σ, map_sum, Finset.sum_mul]
        _ = ∑ u : Γ, ∑ σ : Γ, cast_K_K' (f ((u⁻¹ * σ * u)⁻¹)) * χ_tilde σ := Finset.sum_comm
        _ = ∑ u : Γ, ∑ σ : Γ, cast_K_K' (f ((u⁻¹ * σ * u)⁻¹)) * χ_tilde (u⁻¹ * σ * u) :=
              Finset.sum_congr rfl fun u _ =>
                Finset.sum_congr rfl fun σ _ => by rw [h_chi_conj u σ]
    rw [h_lhs_c]
    have h_inner_c : ∀ u : Γ,
        (∑ σ : Γ, cast_K_K' (f ((u⁻¹ * σ * u)⁻¹)) * χ_tilde (u⁻¹ * σ * u)) = T_cohom := by
      intro u
      let conjEqv : Γ ≃ Γ :=
        { toFun := fun σ => u⁻¹ * σ * u
          invFun := fun c => u * c * u⁻¹
          left_inv := fun σ => by group
          right_inv := fun c => by group }
      exact conjEqv.sum_comp (fun c => cast_K_K' (f c⁻¹) * χ_tilde c)
    simp_rw [h_inner_c]
    rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]

theorem weil_curve_tr_bockstein_konig_lattice_extraction (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (H : ℕ → ℕ → Type u) [∀ q m, AddCommGroup (H q m)]
    (τ : ∀ q m : ℕ, H q (m + 1) →+ H q m)
    (τ_le : ∀ (q a b : ℕ), a ≤ b → H q b →+ H q a)
    (ι : ∀ q a b : ℕ, H q a →+ H q (b + a + 1))
    (δ : ∀ q a b : ℕ, H q b →+ H (q + 1) a)
    (hτ_id : ∀ q a : ℕ, τ_le q a a (le_refl a) = AddMonoidHom.id (H q a))
    (hτ_step : ∀ (q a b : ℕ) (h : a ≤ b),
      τ_le q a (b + 1) (Nat.le_succ_of_le h) = (τ_le q a b h).comp (τ q b))
    (hTor : ∀ (q m : ℕ) (x : H q m), (ℓ ^ (m + 1) : ℕ) • x = 0)
    (hFin0 : ∀ q : ℕ, Finite (H q 0))
    (hEx_ι : ∀ (q a b : ℕ) (x : H q (b + a + 1)),
      τ_le q b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a)) x = 0 ↔
        ∃ y : H q a, ι q a b y = x)
    (hEx_δ : ∀ (q a b : ℕ) (x : H q b),
      δ q a b x = 0 ↔
        ∃ y : H q (b + a + 1),
          τ_le q b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a)) y = x)
    (hComp_ι : ∀ (q a b : ℕ) (y : H q a),
      τ_le q a (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_left a b)) (ι q a b y) =
        (ℓ ^ (b + 1) : ℕ) • y)
    (hComm_ι : ∀ (q a b : ℕ) (y : H q (a + 1)),
      ι q a b (τ q a y) = τ q (b + a + 1) (ι q (a + 1) b y))
    (hComm_δ : ∀ (q a b : ℕ) (y : H q b),
      τ (q + 1) a (δ q (a + 1) b y) = δ q a b y)
    (i : ℕ)
    (α : ∀ m : ℕ, H i m →+ H i m)
    (hα_τ : ∀ (m : ℕ) (x : H i (m + 1)), τ i m (α (m + 1) x) = α m (τ i m x)) :
    ∃ (B_i b_i : ℕ) (M_lat : Matrix (Fin b_i) (Fin b_i) (PadicInt ℓ)),
      (∀ m : ℕ, Finite (H i m)) ∧
      (∀ (K : ℕ), 1 ≤ K →
        let m := K - 1
        let M_mod := (M_lat.map (PadicInt.toZModPow K)).mulVecLin
        ∃ q_K : (Fin b_i → ZMod (ℓ ^ K)) →+ H i m,
          (∀ u, q_K (M_mod u) = α m (q_K u)) ∧
          (∀ u, q_K u = 0 → (ℓ ^ B_i : ℕ) • u = 0) ∧
          (∀ y : H i m, ∃ u, q_K u = (ℓ ^ B_i : ℕ) • y)) ∧
      (∀ (V : Type u) [AddCommGroup V] [Module (Padic ℓ) V] [Module.Finite (Padic ℓ) V]
        (Φ_V : V →ₗ[Padic ℓ] V)
        (sys : AddSubgroup (∀ m : ℕ, H i m)),
        (∀ x : (∀ m : ℕ, H i m), x ∈ sys ↔ ∀ m : ℕ, τ i m (x (m + 1)) = x m) →
        ∀ (equiv : TensorProduct ℤ ℚ ↥sys ≃+ V),
          (∀ (z : PadicInt ℓ) (x y : ↥sys),
            (∀ m : ℕ, y.1 m = (PadicInt.toZModPow (m + 1) z).val • x.1 m) →
            equiv (TensorProduct.tmul ℤ (1 : ℚ) y) =
              (z : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) →
          (∀ (x y : ↥sys),
            (∀ m : ℕ, y.1 m = α m (x.1 m)) →
            Φ_V (equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) =
              equiv (TensorProduct.tmul ℤ (1 : ℚ) y)) →
          LinearMap.trace (Padic ℓ) V Φ_V =
            algebraMap (PadicInt ℓ) (Padic ℓ) (Matrix.trace M_lat)) :=
by
  classical
  let R := PadicInt ℓ
  let E := Padic ℓ
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero
  let _ : ∀ n : ℕ, NeZero (ℓ ^ n) := fun n => ⟨pow_ne_zero n hℓ_ne⟩
  have hFin : ∀ (q m : ℕ), Finite (H q m) := by
    intro q m
    induction m with
    | zero => exact hFin0 q
    | succ m ih =>
      let f : H q (0 + m + 1) →+ H q 0 :=
        τ_le q 0 (0 + m + 1) (Nat.le_succ_of_le (Nat.le_add_right 0 m))
      let g_ker : H q m → ↥f.ker := fun y =>
        ⟨ι q m 0 y, (hEx_ι q m 0 (ι q m 0 y)).mpr ⟨y, rfl⟩⟩
      have hg_surj : Function.Surjective g_ker := by
        rintro ⟨x, hx⟩
        obtain ⟨y, hy⟩ := (hEx_ι q m 0 x).mp hx
        exact ⟨y, Subtype.ext hy⟩
      have hFinKer : Finite ↥f.ker := @Finite.of_surjective _ _ ih g_ker hg_surj
      have hFinQuot : Finite (H q (0 + m + 1) ⧸ f.ker) :=
        @Finite.of_injective _ _ (hFin0 q) _ (QuotientAddGroup.kerLift_injective f)
      have hFin0m : Finite (H q (0 + m + 1)) :=
        @Finite.of_addSubgroup_quotient (H q (0 + m + 1)) _ f.ker hFinKer hFinQuot
      have heq : 0 + m + 1 = m + 1 := by omega
      rwa [heq] at hFin0m
  have hτ_self : ∀ (q a : ℕ) (h : a ≤ a) (x : H q a), τ_le q a a h x = x := by
    intro q a h x
    have hh : h = le_refl a := rfl
    rw [hh, hτ_id q a]
    rfl
  have hτ_one : ∀ (q a : ℕ) (h : a ≤ a + 1), τ_le q a (a + 1) h = τ q a := by
    intro q a h
    have hh : h = Nat.le_succ_of_le (le_refl a) := rfl
    rw [hh, hτ_step q a a (le_refl a), hτ_id q a, AddMonoidHom.id_comp]
  have hτ_comp : ∀ (q a b c : ℕ) (hab : a ≤ b) (hbc : b ≤ c) (hac : a ≤ c),
      τ_le q a c hac = (τ_le q a b hab).comp (τ_le q b c hbc) := by
    intro q a b c hab hbc
    refine Nat.le_induction ?_ ?_ c hbc
    · intro hac
      have hh : hac = hab := rfl
      rw [hh, hτ_id q b, AddMonoidHom.comp_id]
    · intro d hbd ih hac
      have hh : hac = Nat.le_succ_of_le (le_trans hab hbd) := rfl
      rw [hh, hτ_step q a d (le_trans hab hbd), ih (le_trans hab hbd),
        AddMonoidHom.comp_assoc, ← hτ_step q b d hbd]
  have hτ_compat : ∀ (q : ℕ) (f : ∀ m : ℕ, H q m),
      (∀ m : ℕ, τ q m (f (m + 1)) = f m) →
      ∀ (a b : ℕ) (hab : a ≤ b), τ_le q a b hab (f b) = f a := by
    intro q f hf a
    refine Nat.le_induction (hτ_self q a (le_refl a) (f a)) fun b hab ih => ?_
    rw [hτ_step q a b hab, AddMonoidHom.comp_apply, hf b, ih]
  have hτ_ι_comm : ∀ (q b a₁ a₂ : ℕ) (ha : a₁ ≤ a₂)
      (hba : b + a₁ + 1 ≤ b + a₂ + 1) (y : H q a₂),
      ι q a₁ b (τ_le q a₁ a₂ ha y) =
        τ_le q (b + a₁ + 1) (b + a₂ + 1) hba (ι q a₂ b y) := by
    intro q b a₁
    refine Nat.le_induction ?_ fun a₂ ha ih hba' y => ?_
    · intro hba y
      rw [hτ_self q a₁ (le_refl a₁) y, hτ_self q (b + a₁ + 1) hba (ι q a₁ b y)]
    · have hba : b + a₁ + 1 ≤ b + a₂ + 1 := Nat.succ_le_succ (Nat.add_le_add_left ha b)
      rw [hτ_step q a₁ a₂ ha, AddMonoidHom.comp_apply, ih hba (τ q a₂ y), hComm_ι q a₂ b y]
      change (τ_le q (b + a₁ + 1) (b + a₂ + 1) hba) ((τ q (b + a₂ + 1)) ((ι q (a₂ + 1) b) y)) =
        (τ_le q (b + a₁ + 1) ((b + a₂ + 1) + 1) (Nat.le_succ_of_le hba)) ((ι q (a₂ + 1) b) y)
      rw [hτ_step q (b + a₁ + 1) (b + a₂ + 1) hba, AddMonoidHom.comp_apply]
  let Sys (q : ℕ) : AddSubgroup (∀ m : ℕ, H q m) :=
    AddMonoidHom.ker (AddMonoidHom.pi fun m =>
      (τ q m).comp (Pi.evalAddMonoidHom (H q) (m + 1)) -
        Pi.evalAddMonoidHom (H q) m)
  let L (q : ℕ) : Type u := ↥(Sys q)
  have hmemSys : ∀ (q : ℕ) (f : ∀ m : ℕ, H q m),
      f ∈ Sys q ↔ ∀ m : ℕ, τ q m (f (m + 1)) = f m := by
    intro q f
    rw [AddMonoidHom.mem_ker, funext_iff]
    exact ⟨fun h m => sub_eq_zero.mp (h m), fun h m => sub_eq_zero.mpr (h m)⟩
  have hModSmul : ∀ (q m k : ℕ) (w : H q m),
      ((k : ZMod (ℓ ^ (m + 1))).val) • w = k • w := by
    intro q m k w
    rw [ZMod.val_natCast]
    conv_rhs => rw [(Nat.div_add_mod k (ℓ ^ (m + 1))).symm]
    rw [add_nsmul, mul_comm (ℓ ^ (m + 1)), mul_nsmul', hTor q m w, smul_zero, zero_add]
  have hZModZero : ∀ (q m : ℕ) (w : H q m), (0 : ZMod (ℓ ^ (m + 1))).val • w = 0 := by
    intro q m w
    rw [ZMod.val_zero, zero_smul]
  have hZModOne : ∀ (q m : ℕ) (w : H q m), (1 : ZMod (ℓ ^ (m + 1))).val • w = w := by
    intro q m w
    have h1 : (1 : ZMod (ℓ ^ (m + 1))) = ((1 : ℕ) : ZMod (ℓ ^ (m + 1))) := (Nat.cast_one).symm
    rw [h1, hModSmul q m 1 w, one_smul]
  have hZModAdd : ∀ (q m : ℕ) (a b : ZMod (ℓ ^ (m + 1))) (w : H q m),
      (a + b).val • w = a.val • w + b.val • w := by
    intro q m a b w
    have hab : a + b = ((a.val + b.val : ℕ) : ZMod (ℓ ^ (m + 1))) := by
      rw [Nat.cast_add, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
    rw [hab, hModSmul q m (a.val + b.val) w, add_nsmul]
  have hZModMul : ∀ (q m : ℕ) (a b : ZMod (ℓ ^ (m + 1))) (w : H q m),
      (a * b).val • w = a.val • (b.val • w) := by
    intro q m a b w
    have hab : a * b = ((a.val * b.val : ℕ) : ZMod (ℓ ^ (m + 1))) := by
      rw [Nat.cast_mul, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
    rw [hab, hModSmul q m (a.val * b.val) w, mul_nsmul']
  have hZModSum : ∀ {ι_idx : Type} (q m : ℕ) (S : Finset ι_idx)
      (u : ι_idx → ZMod (ℓ ^ (m + 1))) (w : H q m),
      (∑ j ∈ S, u j).val • w = ∑ j ∈ S, (u j).val • w := by
    intro ι_idx q m S u w
    induction S using Finset.induction_on with
    | empty => rw [Finset.sum_empty, Finset.sum_empty, hZModZero]
    | @insert j S hj ih =>
      rw [Finset.sum_insert hj, Finset.sum_insert hj, hZModAdd, ih]
  have hSmulMem : ∀ (q : ℕ) (z : R) (x : L q),
      (fun m => (PadicInt.toZModPow (m + 1) z).val • x.1 m) ∈ Sys q := by
    intro q z x
    rw [hmemSys]
    intro m
    let a₁ : ℕ := (PadicInt.toZModPow (m + 2) z).val
    have hcast : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + 1))) (ZMod (ℓ ^ (m + 1)))
        (PadicInt.toZModPow (m + 2) z) = PadicInt.toZModPow (m + 1) z :=
      RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow (m + 1) (m + 2) (Nat.le_succ (m + 1))) z
    have ha₁ : (a₁ : ZMod (ℓ ^ (m + 1))) = PadicInt.toZModPow (m + 1) z := by
      rw [← hcast]
      have h1 : (a₁ : ZMod (ℓ ^ (m + 2))) = PadicInt.toZModPow (m + 2) z :=
        ZMod.natCast_zmod_val _
      rw [← h1, map_natCast]
    change τ q m (a₁ • x.1 (m + 1)) = (PadicInt.toZModPow (m + 1) z).val • x.1 m
    rw [map_nsmul, (hmemSys q x.1).mp x.2 m, ← ha₁, hModSmul q m a₁ (x.1 m)]
  let instMod : ∀ q : ℕ, Module R (L q) := fun q =>
    { smul := fun z x => ⟨fun m => (PadicInt.toZModPow (m + 1) z).val • x.1 m, hSmulMem q z x⟩
      one_smul := fun x => Subtype.ext <| funext fun m => by
        change (PadicInt.toZModPow (m + 1) 1).val • x.1 m = x.1 m
        rw [map_one, hZModOne]
      mul_smul := fun z₁ z₂ x => Subtype.ext <| funext fun m => by
        change (PadicInt.toZModPow (m + 1) (z₁ * z₂)).val • x.1 m =
          (PadicInt.toZModPow (m + 1) z₁).val • ((PadicInt.toZModPow (m + 1) z₂).val • x.1 m)
        rw [map_mul, hZModMul]
      smul_zero := fun z => Subtype.ext <| funext fun m => by
        change (PadicInt.toZModPow (m + 1) z).val • (0 : H q m) = 0
        rw [smul_zero]
      smul_add := fun z x₁ x₂ => Subtype.ext <| funext fun m => by
        change (PadicInt.toZModPow (m + 1) z).val • (x₁.1 m + x₂.1 m) =
          (PadicInt.toZModPow (m + 1) z).val • x₁.1 m +
            (PadicInt.toZModPow (m + 1) z).val • x₂.1 m
        rw [smul_add]
      add_smul := fun z₁ z₂ x => Subtype.ext <| funext fun m => by
        change (PadicInt.toZModPow (m + 1) (z₁ + z₂)).val • x.1 m =
          (PadicInt.toZModPow (m + 1) z₁).val • x.1 m +
            (PadicInt.toZModPow (m + 1) z₂).val • x.1 m
        rw [map_add, hZModAdd]
      zero_smul := fun x => Subtype.ext <| funext fun m => by
        change (PadicInt.toZModPow (m + 1) 0).val • x.1 m = 0
        rw [map_zero, hZModZero] }
  letI : ∀ q : ℕ, Module R (L q) := instMod
  have hNatSmul : ∀ (q k m : ℕ) (x : L q),
      ((k : R) • x).1 m = k • x.1 m := by
    intro q k m x
    change (PadicInt.toZModPow (m + 1) (k : R)).val • x.1 m = k • x.1 m
    rw [map_natCast, hModSmul q m k (x.1 m)]
  have hPowSmul : ∀ (q n m : ℕ) (x : L q),
      (((ℓ : R) ^ n) • x).1 m = (ℓ ^ n : ℕ) • x.1 m := by
    intro q n m x
    rw [← Nat.cast_pow, hNatSmul q (ℓ ^ n) m x]
  have hKerEv : ∀ (q b : ℕ) (x : L q), x.1 b = 0 →
      ∃ y : L q, x = ((ℓ : R) ^ (b + 1)) • y := by
    intro q b x hxb
    have hx_compat : ∀ m : ℕ, τ q m (x.1 (m + 1)) = x.1 m := (hmemSys q x.1).mp x.2
    let E_fib (a : ℕ) : Type u := { y : H q a // ι q a b y = x.1 (b + a + 1) }
    let F_E : CategoryTheory.Functor ℕᵒᵖ (Type u) :=
      { obj := fun j => E_fib j.unop
        map := fun {j₁ j₂} f => TypeCat.ofHom fun y =>
          ⟨τ_le q j₂.unop j₁.unop (CategoryTheory.leOfHom f.unop) y.1, by
            rw [hτ_ι_comm q b j₂.unop j₁.unop (CategoryTheory.leOfHom f.unop)
              (Nat.succ_le_succ (Nat.add_le_add_left (CategoryTheory.leOfHom f.unop) b)) y.1,
              y.2]
            exact hτ_compat q x.1 hx_compat (b + j₂.unop + 1) (b + j₁.unop + 1) _⟩
        map_id := fun j => by
          ext y
          exact hτ_self q j.unop _ y.1
        map_comp := fun {j₁ j₂ j₃} f g => by
          ext y
          change τ_le q j₃.unop j₁.unop _ y.1 =
            τ_le q j₃.unop j₂.unop (CategoryTheory.leOfHom g.unop)
              (τ_le q j₂.unop j₁.unop (CategoryTheory.leOfHom f.unop) y.1)
          rw [hτ_comp q j₃.unop j₂.unop j₁.unop
            (CategoryTheory.leOfHom g.unop) (CategoryTheory.leOfHom f.unop) _]
          rfl }
    have hFinF : ∀ j : ℕᵒᵖ, Finite (F_E.obj j) := fun j =>
      @Subtype.finite (H q j.unop) (hFin q j.unop) _
    have hNeF : ∀ j : ℕᵒᵖ, Nonempty (F_E.obj j) := fun j => by
      have hx_proj : τ_le q b (b + j.unop + 1)
          (Nat.le_succ_of_le (Nat.le_add_right b j.unop)) (x.1 (b + j.unop + 1)) = 0 := by
        rw [hτ_compat q x.1 hx_compat b (b + j.unop + 1) _, hxb]
      obtain ⟨y₀, hy₀⟩ := (hEx_ι q j.unop b (x.1 (b + j.unop + 1))).mp hx_proj
      exact ⟨⟨y₀, hy₀⟩⟩
    obtain ⟨sec, hsec⟩ := @nonempty_sections_of_finite_inverse_system ℕ _ _ F_E hFinF hNeF
    let y_raw : ∀ a : ℕ, H q a := fun a => (sec (Opposite.op a)).1
    have hy_eq : ∀ a : ℕ, ι q a b (y_raw a) = x.1 (b + a + 1) :=
      fun a => (sec (Opposite.op a)).2
    have hy_compat : ∀ a : ℕ, τ q a (y_raw (a + 1)) = y_raw a := by
      intro a
      have hf := congrArg Subtype.val (hsec (CategoryTheory.homOfLE (Nat.le_succ a)).op)
      change τ_le q a (a + 1) _ (y_raw (a + 1)) = y_raw a at hf
      rwa [hτ_one q a _] at hf
    let y : L q := ⟨y_raw, (hmemSys q y_raw).mpr hy_compat⟩
    refine ⟨y, Subtype.ext <| funext fun a => ?_⟩
    rw [hPowSmul q (b + 1) a y]
    change x.1 a = (ℓ ^ (b + 1) : ℕ) • y_raw a
    rw [← hComp_ι q a b (y_raw a), hy_eq a,
      hτ_compat q x.1 hx_compat a (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_left a b))]
  have hModFin : ∀ q : ℕ, Module.Finite R (L q) := by
    intro q
    let R₀ : Set (H q 0) := Set.range (fun w : L q => w.1 0)
    have hFinR₀ : Finite ↥R₀ := @Subtype.finite (H q 0) (hFin0 q) _
    let _ : Fintype ↥R₀ := Fintype.ofFinite ↥R₀
    let n : ℕ := Fintype.card ↥R₀
    let e₀ : Fin n ≃ ↥R₀ := (Fintype.equivFin ↥R₀).symm
    let g : Fin n → L q := fun j => Classical.choose (e₀ j).2
    have hg : ∀ j : Fin n, (g j).1 0 = (e₀ j).1 := fun j => Classical.choose_spec (e₀ j).2
    let j_of : L q → Fin n := fun w => e₀.symm ⟨w.1 0, ⟨w, rfl⟩⟩
    have hsub0 : ∀ w : L q, (w - g (j_of w)).1 0 = 0 := by
      intro w
      change w.1 0 - (g (j_of w)).1 0 = 0
      rw [hg (j_of w), e₀.apply_symm_apply]
      exact sub_self (w.1 0)
    have hstep : ∀ w : L q, ∃ u : L q, w = g (j_of w) + (ℓ : R) • u := by
      intro w
      obtain ⟨u, hu⟩ := hKerEv q 0 (w - g (j_of w)) (hsub0 w)
      rw [pow_one] at hu
      refine ⟨u, ?_⟩
      rw [← hu]
      abel
    choose next_u hnext_u using hstep
    let evL (m : ℕ) : L q →+ H q m :=
      { toFun := fun w => w.1 m
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    refine Module.Finite.of_fg_top (Submodule.fg_def.mpr ⟨Set.range g, Set.finite_range g, ?_⟩)
    refine le_antisymm le_top fun x _ => ?_
    let u_seq : ℕ → L q := fun k => Nat.recOn k x (fun _ uk => next_u uk)
    let j_seq : ℕ → Fin n := fun k => j_of (u_seq k)
    have hexp : ∀ K : ℕ,
        x = (∑ k ∈ Finset.range K, ((ℓ : R) ^ k) • g (j_seq k)) +
          ((ℓ : R) ^ K) • u_seq K := by
      intro K
      induction K with
      | zero =>
        rw [Finset.sum_range_zero, zero_add, pow_zero, one_smul]; rfl
      | succ K ih =>
        rw [Finset.sum_range_succ, add_assoc]
        conv_lhs => rw [ih]
        congr 1
        have hstep_K : u_seq K = g (j_seq K) + (ℓ : R) • u_seq (K + 1) := hnext_u (u_seq K)
        conv_lhs => rw [hstep_K]
        rw [smul_add, ← mul_smul, ← pow_succ]
    let s_mod (j : Fin n) (K : ℕ) : ZMod (ℓ ^ K) :=
      ∑ k ∈ Finset.range K, if j = j_seq k then (ℓ : ZMod (ℓ ^ K)) ^ k else 0
    have hs_compat : ∀ (j : Fin n) (K₁ K₂ : ℕ) (hk : K₁ ≤ K₂),
        ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ K₁)) (s_mod j K₂) = s_mod j K₁ := by
      intro j K₁ K₂ hk
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hk
      let φ := ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ K₁))
      change φ (s_mod j (K₁ + d)) = s_mod j K₁
      dsimp only [s_mod]
      rw [Finset.sum_range_add, map_add, map_sum, map_sum]
      have hhead : ∑ k ∈ Finset.range K₁,
          φ (if j = j_seq k then (ℓ : ZMod (ℓ ^ (K₁ + d))) ^ k else 0) =
          ∑ k ∈ Finset.range K₁,
            if j = j_seq k then (ℓ : ZMod (ℓ ^ K₁)) ^ k else 0 := by
        refine Finset.sum_congr rfl fun k _ => ?_
        split_ifs
        · rw [map_pow, map_natCast]
        · rw [map_zero]
      have htail : ∑ t ∈ Finset.range d,
          φ (if j = j_seq (K₁ + t) then (ℓ : ZMod (ℓ ^ (K₁ + d))) ^ (K₁ + t) else 0) = 0 := by
        refine Finset.sum_eq_zero fun t _ => ?_
        split_ifs
        · rw [map_pow, map_natCast, pow_add, ← Nat.cast_pow, CharP.cast_eq_zero, zero_mul]
        · rw [map_zero]
      rw [hhead, htail, add_zero]
    let f_hom (j : Fin n) (K : ℕ) : Polynomial ℤ →+* ZMod (ℓ ^ K) :=
      Polynomial.eval₂RingHom (Int.castRingHom (ZMod (ℓ ^ K))) (s_mod j K)
    have hf_compat : ∀ (j : Fin n) (K₁ K₂ : ℕ) (hk : K₁ ≤ K₂),
        (ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ K₁))).comp (f_hom j K₂) = f_hom j K₁ := by
      intro j K₁ K₂ hk
      apply Polynomial.ringHom_ext'
      · exact RingHom.ext_int _ _
      · simp only [RingHom.comp_apply, f_hom, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        exact hs_compat j K₁ K₂ hk
    let c_lift : Fin n → R := fun j => PadicInt.lift (hf_compat j) Polynomial.X
    have hc_mod : ∀ (j : Fin n) (K : ℕ), PadicInt.toZModPow K (c_lift j) = s_mod j K := by
      intro j K
      have hspec := RingHom.congr_fun (PadicInt.lift_spec (hf_compat j) K) Polynomial.X
      simpa [c_lift, f_hom] using hspec
    have hx_eq : x = ∑ j : Fin n, c_lift j • g j := by
      apply Subtype.ext
      funext m
      have hlhs : x.1 m = ∑ k ∈ Finset.range (m + 1), (ℓ ^ k : ℕ) • (g (j_seq k)).1 m := by
        have h1 := congrArg (evL m) (hexp (m + 1))
        rw [map_add, map_sum] at h1
        have hrem : evL m (((ℓ : R) ^ (m + 1)) • u_seq (m + 1)) = 0 := by
          change (((ℓ : R) ^ (m + 1)) • u_seq (m + 1)).1 m = 0
          rw [hPowSmul q (m + 1) m (u_seq (m + 1)), hTor q m _]
        rw [hrem, add_zero] at h1
        refine h1.trans (Finset.sum_congr rfl fun k _ => ?_)
        exact hPowSmul q k m (g (j_seq k))
      have hrhs : (∑ j : Fin n, c_lift j • g j).1 m =
          ∑ k ∈ Finset.range (m + 1), (ℓ ^ k : ℕ) • (g (j_seq k)).1 m := by
        change evL m (∑ j : Fin n, c_lift j • g j) = _
        rw [map_sum]
        have hstep1 : ∑ j : Fin n, evL m (c_lift j • g j) =
            ∑ j : Fin n, ∑ k ∈ Finset.range (m + 1),
              (if j = j_seq k then (ℓ : ZMod (ℓ ^ (m + 1))) ^ k else 0).val • (g j).1 m := by
          refine Finset.sum_congr rfl fun j _ => ?_
          change (PadicInt.toZModPow (m + 1) (c_lift j)).val • (g j).1 m = _
          rw [hc_mod j (m + 1)]
          exact hZModSum q m (Finset.range (m + 1))
            (fun k => if j = j_seq k then (ℓ : ZMod (ℓ ^ (m + 1))) ^ k else 0) ((g j).1 m)
        rw [hstep1, Finset.sum_comm]
        refine Finset.sum_congr rfl fun k _ => ?_
        have hinner : ∑ j : Fin n,
            (if j = j_seq k then (ℓ : ZMod (ℓ ^ (m + 1))) ^ k else 0).val • (g j).1 m =
            ∑ j : Fin n,
              if j = j_seq k then ((ℓ : ZMod (ℓ ^ (m + 1))) ^ k).val • (g j).1 m else 0 := by
          refine Finset.sum_congr rfl fun j _ => ?_
          split_ifs
          · rfl
          · rw [ZMod.val_zero, zero_smul]
        rw [hinner, Finset.sum_ite_eq' Finset.univ (j_seq k)]
        simp only [Finset.mem_univ, ↓reduceIte]
        rw [← Nat.cast_pow, hModSmul q m (ℓ ^ k) ((g (j_seq k)).1 m)]
      exact hlhs.trans hrhs.symm
    rw [hx_eq]
    exact sum_mem fun j _ => Submodule.smul_mem _ (c_lift j) (Submodule.subset_span ⟨j, rfl⟩)
  let _ : ∀ q : ℕ, Module.Finite R (L q) := hModFin
  have hConnLift : ∀ (b : ℕ) (y : H i b),
      (∀ a : ℕ, δ i a b y = 0) → ∃ x : L i, x.1 b = y := by
    intro b y hδ0
    let W_fib (a : ℕ) : Type u :=
      { u : H i (b + a + 1) //
        τ_le i b (b + a + 1) (Nat.le_succ_of_le (Nat.le_add_right b a)) u = y }
    let F_W : CategoryTheory.Functor ℕᵒᵖ (Type u) :=
      { obj := fun j => W_fib j.unop
        map := fun {j₁ j₂} f => TypeCat.ofHom fun u =>
          ⟨τ_le i (b + j₂.unop + 1) (b + j₁.unop + 1)
            (Nat.succ_le_succ (Nat.add_le_add_left (CategoryTheory.leOfHom f.unop) b)) u.1, by
            have hcomp := hτ_comp i b (b + j₂.unop + 1) (b + j₁.unop + 1)
              (Nat.le_succ_of_le (Nat.le_add_right b j₂.unop))
              (Nat.succ_le_succ (Nat.add_le_add_left (CategoryTheory.leOfHom f.unop) b))
              (Nat.le_succ_of_le (Nat.le_add_right b j₁.unop))
            have hcomp_app := DFunLike.congr_fun hcomp u.1
            simp only [AddMonoidHom.comp_apply] at hcomp_app
            exact hcomp_app.symm.trans u.2⟩
        map_id := fun j => by
          ext u
          exact hτ_self i (b + j.unop + 1) _ u.1
        map_comp := fun {j₁ j₂ j₃} f g => by
          ext u
          change τ_le i (b + j₃.unop + 1) (b + j₁.unop + 1) _ u.1 =
            τ_le i (b + j₃.unop + 1) (b + j₂.unop + 1) _
              (τ_le i (b + j₂.unop + 1) (b + j₁.unop + 1) _ u.1)
          rw [hτ_comp i (b + j₃.unop + 1) (b + j₂.unop + 1) (b + j₁.unop + 1)
            (Nat.succ_le_succ (Nat.add_le_add_left (CategoryTheory.leOfHom g.unop) b))
            (Nat.succ_le_succ (Nat.add_le_add_left (CategoryTheory.leOfHom f.unop) b)) _]
          rfl }
    have hFinW : ∀ j : ℕᵒᵖ, Finite (F_W.obj j) := fun j =>
      @Subtype.finite (H i (b + j.unop + 1)) (hFin i (b + j.unop + 1)) _
    have hNeW : ∀ j : ℕᵒᵖ, Nonempty (F_W.obj j) := fun j => by
      obtain ⟨u₀, hu₀⟩ := (hEx_δ i j.unop b y).mp (hδ0 j.unop)
      exact ⟨⟨u₀, hu₀⟩⟩
    obtain ⟨sec, hsec⟩ := @nonempty_sections_of_finite_inverse_system ℕ _ _ F_W hFinW hNeW
    let w_sec : ∀ a : ℕ, W_fib a := fun a => sec (Opposite.op a)
    have hw_step : ∀ a : ℕ, τ i (b + a + 1) (w_sec (a + 1)).1 = (w_sec a).1 := by
      intro a
      have hf := congrArg Subtype.val (hsec (CategoryTheory.homOfLE (Nat.le_succ a)).op)
      change τ_le i (b + a + 1) ((b + a + 1) + 1) _ (w_sec (a + 1)).1 = (w_sec a).1 at hf
      rwa [hτ_one i (b + a + 1) _] at hf
    let x_raw : ∀ m : ℕ, H i m := fun m =>
      τ_le i m (b + m + 1) (Nat.le_succ_of_le (Nat.le_add_left m b)) (w_sec m).1
    have hx_compat : ∀ m : ℕ, τ i m (x_raw (m + 1)) = x_raw m := by
      intro m
      change τ i m (τ_le i (m + 1) ((b + m + 1) + 1)
          (Nat.le_succ_of_le (Nat.le_add_left (m + 1) b)) (w_sec (m + 1)).1) =
        τ_le i m (b + m + 1) (Nat.le_succ_of_le (Nat.le_add_left m b)) (w_sec m).1
      have h1 : τ i m (τ_le i (m + 1) ((b + m + 1) + 1)
          (Nat.le_succ_of_le (Nat.le_add_left (m + 1) b)) (w_sec (m + 1)).1) =
          τ_le i m ((b + m + 1) + 1)
            (Nat.le_succ_of_le (Nat.le_succ_of_le (Nat.le_add_left m b)))
            (w_sec (m + 1)).1 := by
        rw [← hτ_one i m (Nat.le_succ m), ← AddMonoidHom.comp_apply,
          ← hτ_comp i m (m + 1) ((b + m + 1) + 1) (Nat.le_succ m)
            (Nat.le_succ_of_le (Nat.le_add_left (m + 1) b)) _]
      rw [h1, hτ_step i m (b + m + 1) (Nat.le_succ_of_le (Nat.le_add_left m b)),
        AddMonoidHom.comp_apply, hw_step m]
    refine ⟨⟨x_raw, (hmemSys i x_raw).mpr hx_compat⟩, ?_⟩
    exact (w_sec b).2
  have hℓ_R_ne : (ℓ : R) ≠ 0 := Nat.cast_ne_zero.mpr hℓ_ne
  have hTorsBound : ∀ q : ℕ,
      ∃ e_q : ℕ,
        (∀ z ∈ Submodule.torsion R (L q), ((ℓ : R) ^ e_q) • z = 0) ∧
        (∀ z : L q, (∃ n : ℕ, ((ℓ : R) ^ n) • z = 0) → ((ℓ : R) ^ e_q) • z = 0) := by
    intro q
    let T_q : Submodule R (L q) := Submodule.torsion R (L q)
    have hT_pt : ∀ z ∈ T_q, ∃ k : ℕ, ((ℓ : R) ^ k) • z = 0 := by
      intro z hz
      rcases (Submodule.mem_torsion_iff z).mp hz with ⟨a, ha_smul⟩
      rw [Submonoid.smul_def] at ha_smul
      have ha_ne : (a : R) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp a.2
      let u_unit : Rˣ := PadicInt.unitCoeff ha_ne
      let k_z : ℕ := (a : R).valuation
      have ha_fac : (a : R) = (u_unit : R) * (ℓ : R) ^ k_z := PadicInt.unitCoeff_spec ha_ne
      refine ⟨k_z, ?_⟩
      calc
        ((ℓ : R) ^ k_z) • z
          = (1 : R) • (((ℓ : R) ^ k_z) • z) := (one_smul R _).symm
        _ = ((↑u_unit⁻¹ : R) * (u_unit : R)) • (((ℓ : R) ^ k_z) • z) := by
              rw [Units.inv_mul]
        _ = (↑u_unit⁻¹ : R) • (((u_unit : R) * (ℓ : R) ^ k_z) • z) :=
              ((smul_smul (↑u_unit⁻¹ : R) (u_unit : R) (((ℓ : R) ^ k_z) • z)).symm).trans
                (congrArg ((↑u_unit⁻¹ : R) • ·) (smul_smul (u_unit : R) ((ℓ : R) ^ k_z) z))
        _ = (↑u_unit⁻¹ : R) • ((a : R) • z) := by rw [← ha_fac]
        _ = 0 := by rw [ha_smul, smul_zero]
    obtain ⟨m_gen, g_gen, hg_span⟩ :=
      Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian T_q)
    have hg_mem : ∀ s : Fin m_gen, g_gen s ∈ T_q := by
      intro s
      rw [← hg_span]
      exact Submodule.subset_span ⟨s, rfl⟩
    choose k_fn hk_fn using fun s : Fin m_gen => hT_pt (g_gen s) (hg_mem s)
    let e_q : ℕ := Finset.univ.sup k_fn
    let μ_eq : L q →ₗ[R] L q := LinearMap.lsmul R (L q) ((ℓ : R) ^ e_q)
    have hT_le_ker : T_q ≤ LinearMap.ker μ_eq := by
      rw [← hg_span, Submodule.span_le, Set.range_subset_iff]
      intro s
      rw [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.lsmul_apply]
      have hs_le : k_fn s ≤ e_q := Finset.le_sup (f := k_fn) (Finset.mem_univ s)
      rw [← Nat.sub_add_cancel hs_le, pow_add, mul_smul, hk_fn s, smul_zero]
    have hT_kill : ∀ z ∈ T_q, ((ℓ : R) ^ e_q) • z = 0 :=
      fun z hz => LinearMap.mem_ker.mp (hT_le_ker hz)
    refine ⟨e_q, hT_kill, fun z ⟨n, hn⟩ => ?_⟩
    have hpow_ne : ((ℓ : R) ^ n) ≠ 0 := pow_ne_zero n hℓ_R_ne
    have hz_T : z ∈ T_q := by
      rw [Submodule.mem_torsion_iff]
      refine ⟨⟨(ℓ : R) ^ n, mem_nonZeroDivisors_of_ne_zero hpow_ne⟩, ?_⟩
      rwa [Submonoid.smul_def]
    exact hT_kill z hz_T
  obtain ⟨e_i, hTi_kill, _⟩ := hTorsBound i
  obtain ⟨e_next, _, hTors_next⟩ := hTorsBound (i + 1)
  let T_i : Submodule R (L i) := Submodule.torsion R (L i)
  let Q_i := L i ⧸ T_i
  let ⟨b_i, bas_i⟩ := Module.basisOfFiniteTypeTorsionFree' (R := R) (M := Q_i)
  choose v hv using fun t : Fin b_i => Submodule.mkQ_surjective T_i (bas_i t)
  let π_coord : L i →ₗ[R] (Fin b_i → R) := bas_i.equivFun.toLinearMap.comp T_i.mkQ
  have hπ_v : ∀ c : Fin b_i → R, π_coord (∑ t : Fin b_i, c t • v t) = c := by
    intro c
    change bas_i.equivFun (T_i.mkQ (∑ t : Fin b_i, c t • v t)) = c
    rw [map_sum]
    have hsum : ∑ t : Fin b_i, T_i.mkQ (c t • v t) = bas_i.equivFun.symm c := by
      calc ∑ t : Fin b_i, T_i.mkQ (c t • v t)
          = ∑ t : Fin b_i, c t • bas_i t := by
            refine Finset.sum_congr rfl fun t _ => ?_
            rw [map_smul, hv t]
        _ = bas_i.equivFun.symm c := (bas_i.equivFun_symm_apply c).symm
    rw [hsum, bas_i.equivFun.apply_symm_apply]
  have hSpan_v : ∀ w : L i,
      ((ℓ : R) ^ e_i) • w = ∑ t : Fin b_i, (π_coord w t) • (((ℓ : R) ^ e_i) • v t) := by
    intro w
    let z₀ : L i := w - ∑ t : Fin b_i, (π_coord w t) • v t
    have hz₀_ker : z₀ ∈ LinearMap.ker T_i.mkQ := by
      rw [LinearMap.mem_ker]
      change T_i.mkQ w - T_i.mkQ (∑ t : Fin b_i, (bas_i.equivFun (T_i.mkQ w) t) • v t) = 0
      rw [map_sum]
      have hsum : ∑ t : Fin b_i, T_i.mkQ ((bas_i.equivFun (T_i.mkQ w) t) • v t) =
          bas_i.equivFun.symm (bas_i.equivFun (T_i.mkQ w)) := by
        calc ∑ t : Fin b_i, T_i.mkQ ((bas_i.equivFun (T_i.mkQ w) t) • v t)
            = ∑ t : Fin b_i, (bas_i.equivFun (T_i.mkQ w) t) • bas_i t := by
              refine Finset.sum_congr rfl fun t _ => ?_
              rw [map_smul, hv t]
          _ = bas_i.equivFun.symm (bas_i.equivFun (T_i.mkQ w)) :=
              (bas_i.equivFun_symm_apply _).symm
      rw [hsum, bas_i.equivFun.symm_apply_apply, sub_self]
    have hz₀_T : z₀ ∈ T_i := by rwa [Submodule.ker_mkQ T_i] at hz₀_ker
    have hz₀_kill : ((ℓ : R) ^ e_i) • z₀ = 0 := hTi_kill z₀ hz₀_T
    change ((ℓ : R) ^ e_i) • (w - ∑ t : Fin b_i, (π_coord w t) • v t) = 0 at hz₀_kill
    rw [smul_sub] at hz₀_kill
    rw [sub_eq_zero.mp hz₀_kill, Finset.smul_sum]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [smul_comm]
  have hΦL_mem : ∀ x : L i, (fun m => α m (x.1 m)) ∈ Sys i := by
    intro x
    rw [hmemSys]
    intro m
    rw [hα_τ m (x.1 (m + 1)), (hmemSys i x.1).mp x.2 m]
  let Φ_L : L i →ₗ[R] L i :=
    { toFun := fun x => ⟨fun m => α m (x.1 m), hΦL_mem x⟩
      map_add' := fun x₁ x₂ => Subtype.ext <| funext fun m => map_add (α m) (x₁.1 m) (x₂.1 m)
      map_smul' := fun z x => Subtype.ext <| funext fun m => by
        change α m ((PadicInt.toZModPow (m + 1) z).val • x.1 m) =
          (PadicInt.toZModPow (m + 1) z).val • α m (x.1 m)
        exact map_nsmul (α m) _ _ }
  let B_i : ℕ := e_i + e_next
  let v_tilde : Fin b_i → L i := fun t => ((ℓ : R) ^ e_i) • v t
  let M_lat : Matrix (Fin b_i) (Fin b_i) R :=
    Matrix.of fun t j => π_coord (Φ_L (v j)) t
  have hInter_v : ∀ j : Fin b_i,
      ((ℓ : R) ^ e_i) • Φ_L (v j) = ∑ t : Fin b_i, (M_lat t j) • v_tilde t :=
    fun j => hSpan_v (Φ_L (v j))
  have hΦ_vtilde : ∀ j : Fin b_i,
      Φ_L (v_tilde j) = ∑ t : Fin b_i, (M_lat t j) • v_tilde t := by
    intro j
    dsimp only [v_tilde]
    rw [map_smul]
    exact hInter_v j
  refine ⟨B_i, b_i, M_lat, hFin i, ?_, ?_⟩
  · intro K hK
    obtain ⟨m₀, rfl⟩ : ∃ m₀ : ℕ, K = m₀ + 1 := ⟨K - 1, (Nat.sub_add_cancel hK).symm⟩
    change ∃ q_K : (Fin b_i → ZMod (ℓ ^ (m₀ + 1))) →+ H i m₀,
      (∀ u, q_K (((M_lat.map (PadicInt.toZModPow (m₀ + 1))).mulVecLin) u) = α m₀ (q_K u)) ∧
      (∀ u, q_K u = 0 → (ℓ ^ B_i : ℕ) • u = 0) ∧
      (∀ y : H i m₀, ∃ u, q_K u = (ℓ ^ B_i : ℕ) • y)
    let q_K : (Fin b_i → ZMod (ℓ ^ (m₀ + 1))) →+ H i m₀ :=
      { toFun := fun u => ∑ t : Fin b_i, (u t).val • (v_tilde t).1 m₀
        map_zero' := by
          simp only [Pi.zero_apply, ZMod.val_zero, zero_smul, Finset.sum_const_zero]
        map_add' := fun u₁ u₂ => by
          rw [← Finset.sum_add_distrib]
          exact Finset.sum_congr rfl fun t _ =>
            hZModAdd i m₀ (u₁ t) (u₂ t) ((v_tilde t).1 m₀) }
    have hqK_eval : ∀ c : Fin b_i → R,
        (∑ t : Fin b_i, c t • v_tilde t).1 m₀ =
          q_K (fun t => PadicInt.toZModPow (m₀ + 1) (c t)) := by
      intro c
      let ev_m : L i →+ H i m₀ :=
        { toFun := fun w => w.1 m₀
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      exact map_sum ev_m (fun t => c t • v_tilde t) Finset.univ
    refine ⟨q_K, ?_, ?_, ?_⟩
    · intro u
      let u_hat : Fin b_i → R := fun j => ((u j).val : R)
      have hu_mod : ∀ j : Fin b_i, PadicInt.toZModPow (m₀ + 1) (u_hat j) = u j := by
        intro j
        dsimp only [u_hat]
        rw [map_natCast, ZMod.natCast_zmod_val]
      have hq_u : q_K u = (∑ j : Fin b_i, u_hat j • v_tilde j).1 m₀ := by
        rw [hqK_eval u_hat]
        congr 1
        ext j
        exact (hu_mod j).symm
      have hΦ_sum : Φ_L (∑ j : Fin b_i, u_hat j • v_tilde j) =
          ∑ t : Fin b_i, (∑ j : Fin b_i, M_lat t j * u_hat j) • v_tilde t := by
        rw [map_sum]
        calc ∑ j : Fin b_i, Φ_L (u_hat j • v_tilde j)
            = ∑ j : Fin b_i, ∑ t : Fin b_i, (M_lat t j * u_hat j) • v_tilde t := by
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [map_smul, hΦ_vtilde j, Finset.smul_sum]
              refine Finset.sum_congr rfl fun t _ => ?_
              rw [← mul_smul, mul_comm]
          _ = ∑ t : Fin b_i, ∑ j : Fin b_i, (M_lat t j * u_hat j) • v_tilde t :=
              Finset.sum_comm
          _ = ∑ t : Fin b_i, (∑ j : Fin b_i, M_lat t j * u_hat j) • v_tilde t := by
              refine Finset.sum_congr rfl fun t _ => ?_
              rw [Finset.sum_smul]
      have heval_Φ : α m₀ ((∑ j : Fin b_i, u_hat j • v_tilde j).1 m₀) =
          (∑ t : Fin b_i, (∑ j : Fin b_i, M_lat t j * u_hat j) • v_tilde t).1 m₀ :=
        congrFun (congrArg Subtype.val hΦ_sum) m₀
      rw [hq_u, heval_Φ, hqK_eval]
      congr 1
      ext t
      rw [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Matrix.map_apply, map_mul, hu_mod j]
    · intro u hu0
      let u_hat : Fin b_i → R := fun t => ((u t).val : R)
      have hu_mod : ∀ t : Fin b_i, PadicInt.toZModPow (m₀ + 1) (u_hat t) = u t := by
        intro t
        dsimp only [u_hat]
        rw [map_natCast, ZMod.natCast_zmod_val]
      let x : L i := ∑ t : Fin b_i, u_hat t • v_tilde t
      have hxm0 : x.1 m₀ = 0 := by
        dsimp only [x]
        rw [hqK_eval u_hat]
        have hfun : (fun t => PadicInt.toZModPow (m₀ + 1) (u_hat t)) = u := funext hu_mod
        rw [hfun, hu0]
      obtain ⟨w, hw⟩ := hKerEv i m₀ x hxm0
      have hx_v : ∑ t : Fin b_i, (u_hat t * (ℓ : R) ^ e_i) • v t = ((ℓ : R) ^ (m₀ + 1)) • w := by
        rw [← hw]
        dsimp only [x, v_tilde]
        refine Finset.sum_congr rfl fun t _ => ?_
        rw [mul_smul]
      have hcoord := congrArg π_coord hx_v
      rw [hπ_v, map_smul] at hcoord
      have hei_kill : (ℓ ^ e_i : ℕ) • u = 0 := by
        have hei_m0 : PadicInt.toZModPow (m₀ + 1) ((ℓ : R) ^ e_i) =
            ((ℓ ^ e_i : ℕ) : ZMod (ℓ ^ (m₀ + 1))) := by
          rw [← Nat.cast_pow, map_natCast]
        have hzero_m0 : PadicInt.toZModPow (m₀ + 1) ((ℓ : R) ^ (m₀ + 1)) = 0 := by
          rw [← Nat.cast_pow, map_natCast, CharP.cast_eq_zero]
        ext t
        have ht := congrFun hcoord t
        rw [Pi.smul_apply, smul_eq_mul] at ht
        have hmod := congrArg (PadicInt.toZModPow (m₀ + 1)) ht
        rw [map_mul, map_mul, hu_mod t, hei_m0, hzero_m0, zero_mul] at hmod
        rw [Pi.smul_apply, Pi.zero_apply, nsmul_eq_mul, mul_comm]
        exact hmod
      have hpowB : ℓ ^ B_i = ℓ ^ e_next * ℓ ^ e_i := by
        dsimp only [B_i]
        rw [Nat.add_comm, pow_add]
      rw [hpowB, mul_nsmul', hei_kill, smul_zero]
    · intro y
      let z_raw : ∀ a : ℕ, H (i + 1) a := fun a => δ i a m₀ y
      have hz_mem : z_raw ∈ Sys (i + 1) :=
        (hmemSys (i + 1) z_raw).mpr fun a => hComm_δ i a m₀ y
      let z_y : L (i + 1) := ⟨z_raw, hz_mem⟩
      have hz_tor : ((ℓ : R) ^ (m₀ + 1)) • z_y = 0 := by
        apply Subtype.ext
        funext a
        rw [hPowSmul (i + 1) (m₀ + 1) a z_y]
        change (ℓ ^ (m₀ + 1) : ℕ) • δ i a m₀ y = 0
        rw [← map_nsmul (δ i a m₀), hTor i m₀ y, map_zero]
      have hz_enext : ((ℓ : R) ^ e_next) • z_y = 0 :=
        hTors_next z_y ⟨m₀ + 1, hz_tor⟩
      have hδ_enext : ∀ a : ℕ, δ i a m₀ ((ℓ ^ e_next : ℕ) • y) = 0 := by
        intro a
        rw [map_nsmul]
        have ha := congrFun (congrArg Subtype.val hz_enext) a
        rwa [hPowSmul (i + 1) e_next a z_y] at ha
      obtain ⟨x₀, hx₀⟩ := hConnLift m₀ ((ℓ ^ e_next : ℕ) • y) hδ_enext
      refine ⟨fun t => PadicInt.toZModPow (m₀ + 1) (π_coord x₀ t), ?_⟩
      rw [← hqK_eval (π_coord x₀)]
      have hspan_m0 := congrFun (congrArg Subtype.val (hSpan_v x₀)) m₀
      dsimp only [v_tilde]
      rw [← hspan_m0, hPowSmul i e_i m₀ x₀, hx₀, ← mul_nsmul', ← pow_add]
  · intro V hAddV hModV hFinV Φ_V sys hsys equiv hsmul_sys hα_sys
    let _ : AddCommGroup V := hAddV
    let _ : Module E V := hModV
    let _ : Module.Finite E V := hFinV
    let _ : IsFractionRing R E := PadicInt.isFractionRing
    let e_sys : L i ≃+ ↥sys :=
      { toFun := fun x => ⟨x.1, (hsys x.1).mpr ((hmemSys i x.1).mp x.2)⟩
        invFun := fun y => ⟨y.1, (hmemSys i y.1).mpr ((hsys y.1).mp y.2)⟩
        left_inv := fun _ => Subtype.ext rfl
        right_inv := fun _ => Subtype.ext rfl
        map_add' := fun _ _ => Subtype.ext rfl }
    let equiv_L : TensorProduct ℤ ℚ (L i) ≃+ V :=
      ((LinearEquiv.lTensor ℚ e_sys.toIntLinearEquiv).toAddEquiv).trans equiv
    have hequiv_tmul : ∀ (q_rat : ℚ) (x : L i),
        equiv_L (TensorProduct.tmul ℤ q_rat x) =
          equiv (TensorProduct.tmul ℤ q_rat (e_sys x)) := by
      intro q_rat x
      change equiv ((LinearEquiv.lTensor ℚ e_sys.toIntLinearEquiv)
        (TensorProduct.tmul ℤ q_rat x)) = _
      rw [LinearEquiv.lTensor_tmul]
      rfl
    let ι_V : L i →+ V :=
      { toFun := fun x => equiv_L (TensorProduct.tmul ℤ (1 : ℚ) x)
        map_zero' := by rw [TensorProduct.tmul_zero, map_zero]
        map_add' := fun x y => by rw [TensorProduct.tmul_add, map_add] }
    have hι_smul : ∀ (z : R) (x : L i), ι_V (z • x) = (z : E) • ι_V x := by
      intro z x
      change equiv_L (TensorProduct.tmul ℤ (1 : ℚ) (z • x)) =
        (z : E) • equiv_L (TensorProduct.tmul ℤ (1 : ℚ) x)
      rw [hequiv_tmul, hequiv_tmul]
      exact hsmul_sys z (e_sys x) (e_sys (z • x)) (fun _ => rfl)
    have hι_Φ : ∀ x : L i, Φ_V (ι_V x) = ι_V (Φ_L x) := by
      intro x
      change Φ_V (equiv_L (TensorProduct.tmul ℤ (1 : ℚ) x)) =
        equiv_L (TensorProduct.tmul ℤ (1 : ℚ) (Φ_L x))
      rw [hequiv_tmul, hequiv_tmul]
      exact hα_sys (e_sys x) (e_sys (Φ_L x)) (fun _ => rfl)
    let lam_e : E := (((ℓ : R) ^ e_i : R) : E)
    have hℓe_ne : lam_e ≠ 0 :=
      PadicInt.coe_eq_zero.not.mpr (pow_ne_zero e_i hℓ_R_ne)
    let Ψ_V : (Fin b_i → E) →ₗ[E] V :=
      { toFun := fun c => ∑ j : Fin b_i, c j • ι_V (v j)
        map_add' := fun c₁ c₂ => by
          simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
        map_smul' := fun r c => by
          simp only [Pi.smul_apply, smul_eq_mul, mul_smul, RingHom.id_apply, Finset.smul_sum] }
    let M_E : Matrix (Fin b_i) (Fin b_i) E := M_lat.map (algebraMap R E)
    have hΦ_v : ∀ j : Fin b_i, Φ_V (ι_V (v j)) = ∑ t : Fin b_i, M_E t j • ι_V (v t) := by
      intro j
      have h1 : lam_e • Φ_V (ι_V (v j)) =
          lam_e • ∑ t : Fin b_i, M_E t j • ι_V (v t) := by
        calc lam_e • Φ_V (ι_V (v j))
            = lam_e • ι_V (Φ_L (v j)) := by rw [hι_Φ (v j)]
          _ = ι_V (((ℓ : R) ^ e_i) • Φ_L (v j)) := (hι_smul _ _).symm
          _ = ι_V (∑ t : Fin b_i, (M_lat t j) • v_tilde t) := by rw [hInter_v j]
          _ = ∑ t : Fin b_i, (M_lat t j : E) • (lam_e • ι_V (v t)) := by
              rw [map_sum]
              refine Finset.sum_congr rfl fun t _ => ?_
              dsimp only [v_tilde]
              rw [hι_smul, hι_smul]
          _ = lam_e • ∑ t : Fin b_i, M_E t j • ι_V (v t) := by
              rw [Finset.smul_sum]
              refine Finset.sum_congr rfl fun t _ => ?_
              rw [smul_comm]
              have hme : M_E t j = (M_lat t j : E) := by
                change algebraMap R E (M_lat t j) = (M_lat t j : E)
                exact PadicInt.algebraMap_apply (M_lat t j)
              rw [hme]
      have h2 := congrArg (lam_e⁻¹ • ·) h1
      simpa only [inv_smul_smul₀ hℓe_ne] using h2
    have hInter_Ψ : ∀ c : Fin b_i → E, Φ_V (Ψ_V c) = Ψ_V (Matrix.toLin' M_E c) := by
      intro c
      change Φ_V (∑ j : Fin b_i, c j • ι_V (v j)) =
        ∑ t : Fin b_i, (∑ j : Fin b_i, M_E t j * c j) • ι_V (v t)
      rw [map_sum]
      calc ∑ j : Fin b_i, Φ_V (c j • ι_V (v j))
          = ∑ j : Fin b_i, ∑ t : Fin b_i, (M_E t j * c j) • ι_V (v t) := by
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [map_smul, hΦ_v j, Finset.smul_sum]
            refine Finset.sum_congr rfl fun t _ => ?_
            rw [← mul_smul, mul_comm]
        _ = ∑ t : Fin b_i, ∑ j : Fin b_i, (M_E t j * c j) • ι_V (v t) := Finset.sum_comm
        _ = ∑ t : Fin b_i, (∑ j : Fin b_i, M_E t j * c j) • ι_V (v t) := by
            refine Finset.sum_congr rfl fun t _ => ?_
            rw [Finset.sum_smul]
    have hι_mem : ∀ w : L i, ι_V w ∈ LinearMap.range Ψ_V := by
      intro w
      have h1 : lam_e • ι_V w = lam_e • Ψ_V (fun j => (π_coord w j : E)) := by
        calc lam_e • ι_V w
            = ι_V (((ℓ : R) ^ e_i) • w) := (hι_smul _ _).symm
          _ = ι_V (∑ j : Fin b_i, (π_coord w j) • (((ℓ : R) ^ e_i) • v j)) := by rw [hSpan_v w]
          _ = ∑ j : Fin b_i, (π_coord w j : E) • (lam_e • ι_V (v j)) := by
              rw [map_sum]
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [hι_smul, hι_smul]
          _ = lam_e • Ψ_V (fun j => (π_coord w j : E)) := by
              change _ = lam_e • ∑ j : Fin b_i, (π_coord w j : E) • ι_V (v j)
              rw [Finset.smul_sum]
              exact Finset.sum_congr rfl fun j _ => smul_comm _ _ _
      have h2 := congrArg (lam_e⁻¹ • ·) h1
      simp only [inv_smul_smul₀ hℓe_ne] at h2
      exact ⟨fun j => (π_coord w j : E), h2.symm⟩
    have hΨ_surj : Function.Surjective Ψ_V := by
      intro y
      have hmem : ∀ θ : TensorProduct ℤ ℚ (L i), equiv_L θ ∈ LinearMap.range Ψ_V := by
        intro θ
        induction θ using TensorProduct.induction_on with
        | zero =>
          rw [map_zero]
          exact Submodule.zero_mem _
        | tmul q_rat w =>
          let a_int : ℤ := q_rat.num
          let d_nat : ℕ := q_rat.den
          have hd_ne : d_nat ≠ 0 := q_rat.den_nz
          have hq_eq : (d_nat : ℤ) • q_rat = a_int • (1 : ℚ) := by
            rw [zsmul_eq_mul, zsmul_eq_mul, mul_one, Int.cast_natCast, mul_comm]
            have hdiv := Rat.num_div_den q_rat
            have hd_rat_ne : (d_nat : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hd_ne
            exact (eq_div_iff hd_rat_ne).mp hdiv.symm
          have htmul_eq :
              (d_nat : ℤ) • (TensorProduct.tmul ℤ q_rat w) =
                a_int • (TensorProduct.tmul ℤ (1 : ℚ) w) := by
            rw [TensorProduct.smul_tmul', TensorProduct.smul_tmul', hq_eq]
          have heq_V : (d_nat : E) • equiv_L (TensorProduct.tmul ℤ q_rat w) =
              (a_int : E) • ι_V w := by
            have h1 := congrArg equiv_L htmul_eq
            rw [map_zsmul, map_zsmul] at h1
            rw [← Int.cast_smul_eq_zsmul E, ← Int.cast_smul_eq_zsmul E, Int.cast_natCast] at h1
            exact h1
          have hd_E_ne : (d_nat : E) ≠ 0 := Nat.cast_ne_zero.mpr hd_ne
          have heq_V' : equiv_L (TensorProduct.tmul ℤ q_rat w) =
              ((d_nat : E)⁻¹ * (a_int : E)) • ι_V w := by
            have h2 := congrArg ((d_nat : E)⁻¹ • ·) heq_V
            rwa [inv_smul_smul₀ hd_E_ne, smul_smul] at h2
          rw [heq_V']
          exact Submodule.smul_mem _ _ (hι_mem w)
        | add θ₁ θ₂ h₁ h₂ =>
          rw [map_add]
          exact Submodule.add_mem _ h₁ h₂
      have hy := hmem (equiv_L.symm y)
      rwa [equiv_L.apply_symm_apply] at hy
    have hΨ_inj : Function.Injective Ψ_V := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro c hc
      rw [LinearMap.mem_ker] at hc
      obtain ⟨s_sub, hs_int⟩ :=
        IsLocalization.exist_integer_multiples_of_finite (nonZeroDivisors R) c
      choose r hr using hs_int
      have hs_R_ne : (s_sub : R) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s_sub.2
      have hs_E_ne : ((s_sub : R) : E) ≠ 0 := PadicInt.coe_eq_zero.not.mpr hs_R_ne
      have hr_eq : ∀ j : Fin b_i, (r j : E) = ((s_sub : R) : E) * c j := by
        intro j
        have hj := hr j
        rwa [PadicInt.algebraMap_apply, Algebra.smul_def, PadicInt.algebraMap_apply] at hj
      have hsum_V : ι_V (∑ j : Fin b_i, r j • v j) = 0 := by
        calc ι_V (∑ j : Fin b_i, r j • v j)
            = ∑ j : Fin b_i, (r j : E) • ι_V (v j) := by
              rw [map_sum]
              exact Finset.sum_congr rfl fun j _ => hι_smul (r j) (v j)
          _ = ∑ j : Fin b_i, (((s_sub : R) : E) * c j) • ι_V (v j) := by
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [hr_eq j]
          _ = ((s_sub : R) : E) • Ψ_V c := by
              change _ = ((s_sub : R) : E) • ∑ j : Fin b_i, c j • ι_V (v j)
              rw [Finset.smul_sum]
              exact Finset.sum_congr rfl fun j _ => mul_smul _ _ _
          _ = 0 := by rw [hc, smul_zero]
      have htmul0 : TensorProduct.tmul ℤ (1 : ℚ) (∑ j : Fin b_i, r j • v j) = 0 :=
        equiv_L.injective (hsum_V.trans (map_zero equiv_L).symm)
      ext t₀
      let lam_t : L i →+ E :=
        { toFun := fun w => algebraMap R E (π_coord w t₀)
          map_zero' := by simp
          map_add' := fun x y => by simp }
      let B_bilin : ℚ →ₗ[ℤ] (L i →ₗ[ℤ] E) :=
        AddMonoidHom.toIntLinearMap
          { toFun := fun q => AddMonoidHom.toIntLinearMap
              { toFun := fun w => (q : E) * lam_t w
                map_zero' := by simp
                map_add' := fun x y => by rw [map_add, mul_add] }
            map_zero' := by ext w; simp
            map_add' := fun q₁ q₂ => by ext w; simp [Rat.cast_add, add_mul] }
      have hlift0 := congrArg (TensorProduct.lift B_bilin) htmul0
      simp only [TensorProduct.lift.tmul, map_zero] at hlift0
      change ((1 : ℚ) : E) * algebraMap R E (π_coord (∑ j : Fin b_i, r j • v j) t₀) = 0 at hlift0
      rw [Rat.cast_one, one_mul, hπ_v r, PadicInt.algebraMap_apply] at hlift0
      have hmul0 : ((s_sub : R) : E) * c t₀ = 0 := (hr_eq t₀).symm.trans hlift0
      exact (mul_eq_zero.mp hmul0).resolve_left hs_E_ne
    let e_V : (Fin b_i → E) ≃ₗ[E] V := LinearEquiv.ofBijective Ψ_V ⟨hΨ_inj, hΨ_surj⟩
    have hΦ_conj : Φ_V = e_V.conj (Matrix.toLin' M_E) := by
      ext y
      rw [LinearEquiv.conj_apply]
      change Φ_V y = Ψ_V (Matrix.toLin' M_E (e_V.symm y))
      rw [← hInter_Ψ (e_V.symm y)]
      change Φ_V y = Φ_V (e_V (e_V.symm y))
      rw [e_V.apply_symm_apply]
    rw [hΦ_conj, LinearMap.trace_conj', Matrix.trace_toLin'_eq]
    simp only [M_E, Matrix.trace, Matrix.diag, Matrix.map_apply, map_sum]
    rfl

theorem weil_curve_tr_geom_projLine_krullDim_and_omega_points (F : Type u) [Field F]
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base) :
    let k := AlgebraicClosure F
    let D_ov := weilProjectiveSpaceOver F 1
    let D_bar_ov := weilBaseChangeOver F k D_ov
    let D_bar := weilGeomScheme F D_ov
    let Ω := AlgebraicClosure (RatFunc k)
    AlgebraicGeometry.IsProper D_bar_ov.hom ∧
    topologicalKrullDim D_bar ≤ (1 : WithBot ℕ∞) ∧
    ∀ x : ↥D_bar,
      ∃ (x_Ω : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) D_bar)
        (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω))),
        x_Ω.base pt = x :=
by
  intro k D_ov D_bar_ov D_bar Ω
  
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  have _ : IsScalarTower F ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) F) :=
    @IsScalarTower.of_algebraMap_eq F ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) F) _ _ _ _ _ _ fun _ => rfl
  have _ : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) F) :=
    Algebra.FiniteType.of_restrictScalars_finiteType F ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) F)
  have hProp₁ : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) := inferInstance
  let φ₀ : F →+* ↥(𝒜 0) := algebraMap F ↥(𝒜 0)
  have hφ₀_bij : Function.Bijective φ₀ := by
    refine ⟨fun a b hab => ?_, fun y => ?_⟩
    · exact MvPolynomial.C_injective (Fin (1 + 1)) F (congrArg Subtype.val hab)
    · have hy : y.1 ∈ (1 : Submodule F (MvPolynomial (Fin (1 + 1)) F)) := by
        simpa only [𝒜, MvPolynomial.homogeneousSubmodule_zero] using y.2
      obtain ⟨a, ha⟩ := Submodule.mem_one.mp hy
      exact ⟨a, Subtype.ext ha⟩
  let e₀ := (RingEquiv.ofBijective φ₀ hφ₀_bij).toCommRingCatIso
  have he₀_hom : e₀.hom = CommRingCat.ofHom φ₀ := rfl
  have _ : CategoryTheory.IsIso (CommRingCat.ofHom φ₀) := by
    rw [← he₀_hom]; infer_instance
  have hProp_Dov : AlgebraicGeometry.IsProper D_ov.hom :=
    CategoryTheory.MorphismProperty.RespectsIso.postcomp
      @AlgebraicGeometry.IsProper (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀))
      (AlgebraicGeometry.Proj.toSpecZero 𝒜) hProp₁
  have hProp_Dbar : AlgebraicGeometry.IsProper D_bar_ov.hom := by
    dsimp [D_bar_ov, weilBaseChangeOver]
    infer_instance

  
  let f_r : CommRingCat.of F ⟶ CommRingCat.of (Polynomial F) := CommRingCat.ofHom Polynomial.C
  let g_r : CommRingCat.of F ⟶ CommRingCat.of k := CommRingCat.ofHom (algebraMap F k)
  let inl_r : CommRingCat.of (Polynomial F) ⟶ CommRingCat.of (Polynomial k) :=
    CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap F k))
  let inr_r : CommRingCat.of k ⟶ CommRingCat.of (Polynomial k) := CommRingCat.ofHom Polynomial.C
  have h_eq_r : f_r ≫ inl_r = g_r ≫ inr_r := by
    apply CommRingCat.hom_ext
    ext x
    simp [f_r, g_r, inl_r, inr_r]
  have hColim_r : CategoryTheory.Limits.IsColimit
      (CategoryTheory.Limits.PushoutCocone.mk inl_r inr_r h_eq_r) :=
    CategoryTheory.Limits.PushoutCocone.IsColimit.mk h_eq_r
      (fun s => CommRingCat.ofHom (Polynomial.eval₂RingHom s.inr.hom (s.inl.hom Polynomial.X)))
      (fun s => by
        apply CommRingCat.hom_ext
        apply Polynomial.ringHom_ext'
        · ext a
          have hw := congrArg (fun h => h.hom a) s.condition
          simpa [f_r, g_r, inl_r] using hw.symm
        · simp [inl_r])
      (fun s => by
        apply CommRingCat.hom_ext
        ext c
        simp [inr_r])
      (fun s m hm₁ hm₂ => by
        apply CommRingCat.hom_ext
        apply Polynomial.ringHom_ext'
        · ext c
          have hc := congrArg (fun h => h.hom c) hm₂
          simpa [inr_r] using hc
        · have hX := congrArg (fun h => h.hom Polynomial.X) hm₁
          simpa [inl_r] using hX)
  have hPush_r : CategoryTheory.IsPushout f_r g_r inl_r inr_r :=
    { w := h_eq_r, isColimit' := ⟨hColim_r⟩ }
  have hpb_spec := AlgebraicGeometry.isPullback_SpecMap_of_isPushout f_r g_r inl_r inr_r hPush_r
  let f₂ := AlgebraicGeometry.Spec.map g_r
  let g_poly := AlgebraicGeometry.Spec.map inl_r
  let c_k := AlgebraicGeometry.Spec.map inr_r
  let pr_D : D_bar ⟶ D_ov.left := CategoryTheory.Limits.pullback.fst D_ov.hom f₂
  let pr_k : D_bar ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    CategoryTheory.Limits.pullback.snd D_ov.hom f₂
  have hpb_D : CategoryTheory.IsPullback pr_k pr_D f₂ D_ov.hom :=
    (CategoryTheory.IsPullback.of_hasPullback D_ov.hom f₂).flip
  let j_bar : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ D_bar :=
    CategoryTheory.Limits.pullback.lift (g_poly ≫ j_aff) c_k (by
      rw [CategoryTheory.Category.assoc, hj_hom]
      exact hpb_spec.w)
  have hj_bar_fst : j_bar ≫ pr_D = g_poly ≫ j_aff :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hj_bar_hom : j_bar ≫ D_bar_ov.hom = c_k :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hpb_j_outer : CategoryTheory.IsPullback (j_bar ≫ pr_k) g_poly f₂ (j_aff ≫ D_ov.hom) := by
    change CategoryTheory.IsPullback (j_bar ≫ D_bar_ov.hom) g_poly f₂ (j_aff ≫ D_ov.hom)
    rw [hj_bar_hom, hj_hom]
    exact hpb_spec.flip
  have hpb_j : CategoryTheory.IsPullback j_bar g_poly pr_D j_aff :=
    CategoryTheory.IsPullback.of_right hpb_j_outer hj_bar_fst hpb_D
  have hj_bar_open : AlgebraicGeometry.IsOpenImmersion j_bar :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_j.flip hj_open

  let s_bar_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ D_bar :=
    CategoryTheory.Limits.pullback.lift (f₂ ≫ s_inf)
      (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k))) (by
        rw [CategoryTheory.Category.assoc, hsinf_sec, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp])
  have hs_bar_fst : s_bar_inf ≫ pr_D = f₂ ≫ s_inf :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hs_bar_sec : s_bar_inf ≫ D_bar_ov.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hpb_s_outer : CategoryTheory.IsPullback (s_bar_inf ≫ pr_k) f₂ f₂ (s_inf ≫ D_ov.hom) := by
    change CategoryTheory.IsPullback (s_bar_inf ≫ D_bar_ov.hom) f₂ f₂ (s_inf ≫ D_ov.hom)
    rw [hs_bar_sec, hsinf_sec]
    exact CategoryTheory.IsPullback.of_id_fst
  have hpb_s : CategoryTheory.IsPullback s_bar_inf f₂ pr_D s_inf :=
    CategoryTheory.IsPullback.of_right hpb_s_outer hs_bar_fst hpb_D

  have hRange_j : Set.range j_bar.base = pr_D.base ⁻¹' Set.range j_aff.base := by
    ext x
    constructor
    · rintro ⟨p, rfl⟩
      refine ⟨g_poly.base p, ?_⟩
      change (g_poly ≫ j_aff).base p = (j_bar ≫ pr_D).base p
      rw [hj_bar_fst]
    · rintro ⟨q, hq⟩
      obtain ⟨p, hp, _⟩ := AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_j x q hq.symm
      exact ⟨p, hp⟩
  have hRange_s : Set.range s_bar_inf.base = pr_D.base ⁻¹' Set.range s_inf.base := by
    ext x
    constructor
    · rintro ⟨pt, rfl⟩
      refine ⟨f₂.base pt, ?_⟩
      change (f₂ ≫ s_inf).base pt = (s_bar_inf ≫ pr_D).base pt
      rw [hs_bar_fst]
    · rintro ⟨pt_F, hpt⟩
      obtain ⟨pt_k, hpt_k, _⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_s x pt_F hpt.symm
      exact ⟨pt_k, hpt_k⟩
  have hs_bar_compl : (Set.range j_bar.base)ᶜ = Set.range s_bar_inf.base := by
    rw [hRange_j, hRange_s, ← Set.preimage_compl, hsinf_compl]

  
  let pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := default
  let x_inf : ↥D_bar := s_bar_inf.base pt_k
  have hRange_s_sing : Set.range s_bar_inf.base = {x_inf} := by
    ext y
    simp only [Set.mem_range, Set.mem_singleton_iff]
    exact ⟨fun ⟨u, hu⟩ => hu ▸ congrArg s_bar_inf.base (Subsingleton.elim u pt_k),
      fun hy => ⟨pt_k, hy.symm⟩⟩
  have hCompl_sing : (Set.range j_bar.base)ᶜ = {x_inf} := hs_bar_compl.trans hRange_s_sing
  have hClosed_xinf : IsClosed ({x_inf} : Set ↥D_bar) :=
    hCompl_sing ▸ (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding j_bar).isOpen_range.isClosed_compl

  let ev_c : k → (AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) :=
    fun c => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom c))
  let s_c : k → (AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ D_bar) :=
    fun c => ev_c c ≫ j_bar
  have hs_c_sec : ∀ c : k, s_c c ≫ D_bar_ov.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
    intro c
    dsimp [s_c, ev_c]
    rw [CategoryTheory.Category.assoc, hj_bar_hom]
    dsimp [c_k, inr_r]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hcid : (Polynomial.evalRingHom c).comp Polynomial.C = RingHom.id k := by
      ext a; simp
    rw [hcid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
  have hClosed_sc : ∀ c : k, IsClosed ({(s_c c).base pt_k} : Set ↥D_bar) := by
    intro c
    have hsec := hs_c_sec c
    have hci_id : AlgebraicGeometry.IsClosedImmersion
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k))) := inferInstance
    have hci_comp : AlgebraicGeometry.IsClosedImmersion (s_c c ≫ D_bar_ov.hom) := by
      rw [hsec]; exact hci_id
    have hci : AlgebraicGeometry.IsClosedImmersion (s_c c) :=
      AlgebraicGeometry.IsClosedImmersion.of_comp (s_c c) D_bar_ov.hom
    have hRange_sc : Set.range (s_c c).base = {(s_c c).base pt_k} := by
      ext y
      simp only [Set.mem_range, Set.mem_singleton_iff]
      exact ⟨fun ⟨u, hu⟩ => hu ▸ congrArg (s_c c).base (Subsingleton.elim u pt_k),
        fun hy => ⟨pt_k, hy.symm⟩⟩
    exact hRange_sc ▸ (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding (s_c c)).isClosed_range

  have hev_ideal : ∀ c : k,
      ((ev_c c).base pt_k).asIdeal = Ideal.span {Polynomial.X - Polynomial.C c} := by
    intro c
    have hpt_bot : pt_k = (⊥ : PrimeSpectrum k) := Subsingleton.elim _ _
    change (PrimeSpectrum.comap (Polynomial.evalRingHom c) pt_k).asIdeal = _
    rw [hpt_bot, PrimeSpectrum.comap_asIdeal]
    change Ideal.comap (Polynomial.evalRingHom c) ⊥ = _
    exact Polynomial.ker_evalRingHom c

  let η₀ : PrimeSpectrum (Polynomial k) := ⊥
  let η : ↥D_bar := j_bar.base η₀
  have hPrime_class : ∀ p : PrimeSpectrum (Polynomial k),
      p = η₀ ∨ ∃ c : k, p = (ev_c c).base pt_k ∧
        p.asIdeal = Ideal.span {Polynomial.X - Polynomial.C c} := by
    intro p
    by_cases hp : p = η₀
    · exact Or.inl hp
    · right
      have hp_ne_bot : p.asIdeal ≠ ⊥ := fun h => hp (PrimeSpectrum.ext h)
      let g : Polynomial k := Submodule.IsPrincipal.generator p.asIdeal
      have hg_span : Ideal.span {g} = p.asIdeal :=
        Submodule.IsPrincipal.span_singleton_generator p.asIdeal
      have hg_ne : g ≠ 0 := by
        intro h0
        apply hp_ne_bot
        rw [← hg_span, h0, Ideal.span_singleton_eq_bot]
      have hg_deg : g.degree ≠ 0 := by
        intro hdeg
        rw [Polynomial.eq_C_of_degree_eq_zero hdeg] at hg_ne hg_span
        have hc0 : g.coeff 0 ≠ 0 := fun hc => hg_ne (by simp [hc])
        have hunit : IsUnit (Polynomial.C (g.coeff 0)) :=
          Polynomial.isUnit_C.mpr (IsUnit.mk0 _ hc0)
        exact p.isPrime.ne_top (hg_span ▸ Ideal.span_singleton_eq_top.mpr hunit)
      obtain ⟨c, hc⟩ := IsAlgClosed.exists_root g hg_deg
      obtain ⟨q, hq⟩ := Polynomial.dvd_iff_isRoot.mpr hc
      have hg_prime : Prime g :=
        (Ideal.span_singleton_prime hg_ne).mp (hg_span.symm ▸ p.isPrime)
      have hq_unit : IsUnit q := by
        rcases hg_prime.irreducible.isUnit_or_isUnit hq with hu | hu
        · exact absurd hu (Polynomial.irreducible_X_sub_C c).not_isUnit
        · exact hu
      have hp_eq_span : p.asIdeal = Ideal.span {Polynomial.X - Polynomial.C c} := by
        rw [← hg_span, hq, Ideal.span_singleton_mul_right_unit hq_unit]
      refine ⟨c, PrimeSpectrum.ext (hp_eq_span.trans (hev_ideal c).symm), hp_eq_span⟩

  have hClosed_ne_η : ∀ y : ↥D_bar, y ≠ η → IsClosed ({y} : Set ↥D_bar) := by
    intro y hy
    by_cases hy_mem : y ∈ Set.range j_bar.base
    · obtain ⟨p, rfl⟩ := hy_mem
      rcases hPrime_class p with rfl | ⟨c, rfl, -⟩
      · exact absurd rfl hy
      · exact hClosed_sc c
    · have hy_inf : y ∈ ({x_inf} : Set ↥D_bar) := hCompl_sing ▸ hy_mem
      rw [Set.mem_singleton_iff.mp hy_inf]
      exact hClosed_xinf

  
  have hΩ_pts : ∀ x : ↥D_bar,
      ∃ (x_Ω : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) D_bar)
        (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω))),
        x_Ω.base pt = x := by
    let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := default
    let ι_X_Ω : Polynomial k →+* Ω :=
      (algebraMap (RatFunc k) Ω).comp (algebraMap (Polynomial k) (RatFunc k))
    have hInj_ι : Function.Injective ι_X_Ω :=
      (RingHom.injective (algebraMap (RatFunc k) Ω)).comp
        (IsFractionRing.injective (Polynomial k) (RatFunc k))
    let ι_k_Ω : k →+* Ω := ι_X_Ω.comp Polynomial.C
    intro x
    by_cases hx_mem : x ∈ Set.range j_bar.base
    · obtain ⟨p, rfl⟩ := hx_mem
      rcases hPrime_class p with rfl | ⟨c, rfl, -⟩
      · refine ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_X_Ω) ≫ j_bar, pt_Ω, ?_⟩
        change j_bar.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_X_Ω)).base pt_Ω) =
          j_bar.base η₀
        congr 1
        apply PrimeSpectrum.ext
        have hpt_bot : pt_Ω = (⊥ : PrimeSpectrum Ω) := Subsingleton.elim _ _
        change (PrimeSpectrum.comap ι_X_Ω pt_Ω).asIdeal = (⊥ : Ideal (Polynomial k))
        rw [hpt_bot, PrimeSpectrum.comap_asIdeal]
        exact (RingHom.injective_iff_ker_eq_bot ι_X_Ω).mp hInj_ι
      · refine ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_k_Ω) ≫ s_c c, pt_Ω, ?_⟩
        change (s_c c).base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_k_Ω)).base pt_Ω) =
          (s_c c).base pt_k
        exact congrArg (s_c c).base (Subsingleton.elim _ pt_k)
    · have hx_inf : x = x_inf := Set.mem_singleton_iff.mp (hCompl_sing ▸ hx_mem)
      rw [hx_inf]
      refine ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_k_Ω) ≫ s_bar_inf, pt_Ω, ?_⟩
      change s_bar_inf.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_k_Ω)).base pt_Ω) =
        s_bar_inf.base pt_k
      exact congrArg s_bar_inf.base (Subsingleton.elim _ pt_k)

  
  have hZ_avoid_η : ∀ Z : TopologicalSpace.IrreducibleCloseds ↥D_bar,
      η ∉ (Z : Set ↥D_bar) → ∃ z₀ : ↥D_bar, (Z : Set ↥D_bar) = {z₀} := by
    classical
    intro Z hηZ
    have hPre_closed : IsClosed (j_bar.base ⁻¹' (Z : Set ↥D_bar)) :=
      Z.isClosed'.preimage j_bar.base.hom.continuous
    obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal _).mp hPre_closed
    have hη₀_not : η₀ ∉ PrimeSpectrum.zeroLocus (I : Set (Polynomial k)) := by
      rw [← hI]; exact hηZ
    rw [PrimeSpectrum.mem_zeroLocus] at hη₀_not
    have hex_f : ∃ f ∈ I, f ≠ (0 : Polynomial k) := by
      by_contra h_all
      apply hη₀_not
      intro f hf
      change f ∈ (⊥ : Ideal (Polynomial k))
      rw [Ideal.mem_bot]
      by_contra hne
      exact h_all ⟨f, hf, hne⟩
    obtain ⟨f, hfI, hf_ne⟩ := hex_f
    let S_fin : Set ↥D_bar :=
      (Set.image (fun c : k => (s_c c).base pt_k) (f.roots.toFinset : Set k)) ∪ {x_inf}
    have hS_fin : S_fin.Finite :=
      ((f.roots.toFinset.finite_toSet).image _).union (Set.finite_singleton x_inf)
    have hZ_sub : (Z : Set ↥D_bar) ⊆ S_fin := by
      intro y hyZ
      by_cases hy_mem : y ∈ Set.range j_bar.base
      · obtain ⟨p, rfl⟩ := hy_mem
        have hp_zl : (p : PrimeSpectrum (Polynomial k)) ∈
            PrimeSpectrum.zeroLocus (I : Set (Polynomial k)) := by
          rw [← hI]; exact hyZ
        have hf_p : f ∈ p.asIdeal := hp_zl hfI
        rcases hPrime_class p with rfl | ⟨c, rfl, hp_span⟩
        · exact absurd hyZ hηZ
        · left
          refine ⟨c, ?_, rfl⟩
          rw [Finset.mem_coe, Multiset.mem_toFinset, Polynomial.mem_roots hf_ne,
            ← Polynomial.dvd_iff_isRoot, ← Ideal.mem_span_singleton, ← hp_span]
          exact hf_p
      · right
        exact hCompl_sing ▸ hy_mem
    have hZ_fin : (Z : Set ↥D_bar).Finite := hS_fin.subset hZ_sub
    obtain ⟨z₀, hz₀⟩ := Z.isIrreducible'.nonempty
    refine ⟨z₀, ?_⟩
    by_contra hne_sing
    have hex_z₁ : ∃ z₁ ∈ (Z : Set ↥D_bar), z₁ ≠ z₀ := by
      by_contra hall_eq
      apply hne_sing
      ext w
      refine ⟨fun hw => Set.mem_singleton_iff.mpr ?_,
        fun hw => (Set.mem_singleton_iff.mp hw) ▸ hz₀⟩
      by_contra hw_ne
      exact hall_eq ⟨w, hw, hw_ne⟩
    obtain ⟨z₁, hz₁, hz₁_ne⟩ := hex_z₁
    let K_rest : Set ↥D_bar := (Z : Set ↥D_bar) \ {z₀}
    have hK_eq : K_rest = ⋃ y ∈ K_rest, ({y} : Set ↥D_bar) := by
      ext w; simp
    have hClosed_K : IsClosed K_rest := by
      rw [hK_eq]
      exact (hZ_fin.sdiff).isClosed_biUnion fun y hy =>
        hClosed_ne_η y (fun h_eq => hηZ (h_eq ▸ hy.1))
    have hClosed_z₀ : IsClosed ({z₀} : Set ↥D_bar) :=
      hClosed_ne_η z₀ (fun h_eq => hηZ (h_eq ▸ hz₀))
    have hPre := Z.isIrreducible'.isPreirreducible K_restᶜ ({z₀} : Set ↥D_bar)ᶜ
      hClosed_K.isOpen_compl hClosed_z₀.isOpen_compl
      ⟨z₀, hz₀, fun h => h.2 rfl⟩ ⟨z₁, hz₁, hz₁_ne⟩
    rcases hPre with ⟨w, hwZ, hwK, hwz₀⟩
    exact hwK ⟨hwZ, hwz₀⟩

  have hZ_contain_η_sub : ∀ Z : TopologicalSpace.IrreducibleCloseds ↥D_bar,
      η ∈ (Z : Set ↥D_bar) → Set.range j_bar.base ⊆ (Z : Set ↥D_bar) := by
    intro Z hηZ
    have hPre_closed : IsClosed (j_bar.base ⁻¹' (Z : Set ↥D_bar)) :=
      Z.isClosed'.preimage j_bar.base.hom.continuous
    obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal _).mp hPre_closed
    have hη₀_mem : η₀ ∈ PrimeSpectrum.zeroLocus (I : Set (Polynomial k)) := by
      rw [← hI]; exact hηZ
    rw [PrimeSpectrum.mem_zeroLocus] at hη₀_mem
    rintro _ ⟨p, rfl⟩
    have hp_zl : (p : PrimeSpectrum (Polynomial k)) ∈
        PrimeSpectrum.zeroLocus (I : Set (Polynomial k)) :=
      (PrimeSpectrum.mem_zeroLocus _ _).mpr fun f hf =>
        (bot_le : (⊥ : Ideal (Polynomial k)) ≤ (p : PrimeSpectrum (Polynomial k)).asIdeal)
          (hη₀_mem hf)
    exact (Set.ext_iff.mp hI p).mpr hp_zl

  have hZ_contain_η_cases : ∀ Z : TopologicalSpace.IrreducibleCloseds ↥D_bar,
      η ∈ (Z : Set ↥D_bar) →
      (Z : Set ↥D_bar) = Set.range j_bar.base ∨ (Z : Set ↥D_bar) = Set.univ := by
    intro Z hηZ
    have hsub := hZ_contain_η_sub Z hηZ
    by_cases hx : x_inf ∈ (Z : Set ↥D_bar)
    · right
      ext y
      simp only [Set.mem_univ, iff_true]
      by_cases hy : y ∈ Set.range j_bar.base
      · exact hsub hy
      · have hy_eq : y = x_inf := Set.mem_singleton_iff.mp (hCompl_sing ▸ hy)
        exact hy_eq ▸ hx
    · left
      ext y
      refine ⟨fun hy => ?_, fun hy => hsub hy⟩
      by_contra hnot
      have hy_eq : y = x_inf := Set.mem_singleton_iff.mp (hCompl_sing ▸ hnot)
      exact hx (hy_eq ▸ hy)

  have hZ_contain_η_unique : ∀ Z₁ Z₂ : TopologicalSpace.IrreducibleCloseds ↥D_bar,
      η ∈ (Z₁ : Set ↥D_bar) → η ∈ (Z₂ : Set ↥D_bar) → Z₁ = Z₂ := by
    intro Z₁ Z₂ h1 h2
    have hnot_both : ¬ (IsClosed (Set.range j_bar.base) ∧
        IsIrreducible (Set.univ : Set ↥D_bar)) := by
      rintro ⟨hClosed_rng, hIrr_univ⟩
      have hOpen_rng : IsOpen (Set.range j_bar.base) :=
        (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding j_bar).isOpen_range
      have hPre := hIrr_univ.isPreirreducible (Set.range j_bar.base) (Set.range j_bar.base)ᶜ
        hOpen_rng hClosed_rng.isOpen_compl
        ⟨η, trivial, ⟨η₀, rfl⟩⟩ ⟨x_inf, trivial, hCompl_sing.symm ▸ Set.mem_singleton x_inf⟩
      rcases hPre with ⟨w, -, hw1, hw2⟩
      exact hw2 hw1
    rcases hZ_contain_η_cases Z₁ h1 with hZ₁_rng | hZ₁_univ <;>
      rcases hZ_contain_η_cases Z₂ h2 with hZ₂_rng | hZ₂_univ
    · exact SetLike.ext' (hZ₁_rng.trans hZ₂_rng.symm)
    · exfalso
      exact hnot_both ⟨hZ₁_rng ▸ Z₁.isClosed', hZ₂_univ ▸ Z₂.isIrreducible'⟩
    · exfalso
      exact hnot_both ⟨hZ₂_rng ▸ Z₂.isClosed', hZ₁_univ ▸ Z₁.isIrreducible'⟩
    · exact SetLike.ext' (hZ₁_univ.trans hZ₂_univ.symm)

  have hDim_Dbar : topologicalKrullDim D_bar ≤ (1 : WithBot ℕ∞) := by
    let Z_inf : TopologicalSpace.IrreducibleCloseds ↥D_bar :=
      ⟨{x_inf}, isIrreducible_singleton, hClosed_xinf⟩
    have _ : Nonempty (TopologicalSpace.IrreducibleCloseds ↥D_bar) := ⟨Z_inf⟩
    change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥D_bar) ≤ ((1 : ℕ∞) : WithBot ℕ∞)
    rw [Order.krullDim_eq_iSup_length, WithBot.coe_le_coe]
    refine iSup_le fun s => ?_
    have hslen : s.length ≤ 1 := by
      by_contra hgt
      have h2 : 2 ≤ s.length := by omega
      let Z₀ := s ⟨0, by omega⟩
      let Z₁ := s ⟨1, by omega⟩
      let Z₂ := s ⟨2, by omega⟩
      have h01 : Z₀ < Z₁ :=
        s.strictMono (Fin.mk_lt_mk.mpr (by omega) : (⟨0, by omega⟩ : Fin (s.length + 1)) < ⟨1, by omega⟩)
      have h12 : Z₁ < Z₂ :=
        s.strictMono (Fin.mk_lt_mk.mpr (by omega) : (⟨1, by omega⟩ : Fin (s.length + 1)) < ⟨2, by omega⟩)
      by_cases hη₁ : η ∈ (Z₁ : Set ↥D_bar)
      · have hsub12 : (Z₁ : Set ↥D_bar) ⊆ (Z₂ : Set ↥D_bar) := le_of_lt h12
        have hη₂ : η ∈ (Z₂ : Set ↥D_bar) := hsub12 hη₁
        exact (ne_of_lt h12) (hZ_contain_η_unique Z₁ Z₂ hη₁ hη₂)
      · obtain ⟨z₀, hz₀⟩ := hZ_avoid_η Z₁ hη₁
        obtain ⟨w, hw⟩ := Z₀.isIrreducible'.nonempty
        have hsub01 : (Z₀ : Set ↥D_bar) ⊆ (Z₁ : Set ↥D_bar) := le_of_lt h01
        have hw_eq : w = z₀ := Set.mem_singleton_iff.mp (hz₀ ▸ hsub01 hw)
        have hZ₀_eq : Z₀ = Z₁ := SetLike.ext' (Set.Subset.antisymm hsub01 (by
          rw [hz₀]
          intro u hu
          exact (Set.mem_singleton_iff.mp hu) ▸ hw_eq ▸ hw))
        exact (ne_of_lt h01) hZ₀_eq
    exact_mod_cast hslen

  exact ⟨hProp_Dbar, hDim_Dbar, hΩ_pts⟩

theorem weil_scheme_aut_pow_site_pushforward_and_ext_iterate (S : AlgebraicGeometry.Scheme.{u})
