      have hz_cast : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1))) z =
          (z.val : ZMod (ℓ ^ (r + 1))) := by
        conv_lhs => rw [← ZMod.natCast_zmod_val z]
        rw [map_natCast]
      rw [hemb_apply r 0 (r + 1) rfl, hz_cast, ZMod.val_natCast, hModEq r 0 (r + 1) rfl z.val,
        pow_one, Nat.cast_mul, ZMod.natCast_zmod_val, nsmul_eq_mul]

    refine ⟨τ_ℳ_ab, τ_ℳ_dual_ab, τ_𝒥_ab_step, τ_𝒥_ab_le, ι_bock_sh,
      hτ_𝒥_comm, ?_, hτ_le_refl, hτ_le_succ, hτ_le_trans,
      fun a b c hc hbc => ⟨h0_bock a b c hc hbc, hSE_bock a b c hc hbc⟩,
      hComm_bock, hMul_bock⟩
    intro r W h_W ι_up ι_dn m_ι hfst hsnd
    have hm_eq : m_ι = m_ι_can r h_W := hm_ι_eq r h_W m_ι hfst hsnd
    rw [hm_eq]
    exact ⟨fun s_up y_up i => hτ_ℳ_spec r W s_up y_up i,
      fun w_up y_up i => hτ_ℳ_dual_spec r W w_up y_up i⟩

  obtain ⟨τ_ℳ_ab, τ_ℳ_dual_ab, τ_𝒥_ab_step, τ_𝒥_ab_le, ι_bock_sh,
    hτ_𝒥_comm, hτ_ℳ_both_spec, hτ_le_refl, hτ_le_succ, hτ_le_trans,
    hSE_all, hComm_bock, hMul_bock⟩ := hPillar3
  clear hShortExact_crit

  
  
  
  have hPillar4 : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
      (X₀ : 𝒞) (J_obj : ℕ → 𝒞)
      (τ_step : ∀ r : ℕ, Quiver.Hom (J_obj (r + 1)) (J_obj r))
      (τ_le : ∀ {a b : ℕ}, a ≤ b → Quiver.Hom (J_obj b) (J_obj a))
      (ι_sh : ∀ (a b c : ℕ), a + b + 1 = c → Quiver.Hom (J_obj a) (J_obj c))
      (_h_refl : ∀ a : ℕ, τ_le (le_refl a) = CategoryTheory.CategoryStruct.id (J_obj a))
      (_h_succ : ∀ r : ℕ, τ_le (Nat.le_succ r) = τ_step r)
      (_h_trans : ∀ {a b c : ℕ} (hab : a ≤ b) (hbc : b ≤ c),
        τ_le (le_trans hab hbc) = CategoryTheory.CategoryStruct.comp (τ_le hbc) (τ_le hab))
      (_h_se : ∀ (a b c : ℕ) (hc : a + b + 1 = c) (hbc : b ≤ c),
        ∃ h0 : CategoryTheory.CategoryStruct.comp (ι_sh a b c hc) (τ_le hbc) = 0,
          (CategoryTheory.ShortComplex.mk (ι_sh a b c hc) (τ_le hbc) h0).ShortExact)
      (_h_comm : ∀ (a b c : ℕ) (hc : a + b + 1 = c) (hc' : (a + 1) + b + 1 = c + 1),
        CategoryTheory.CategoryStruct.comp (τ_step a) (ι_sh a b c hc) =
          CategoryTheory.CategoryStruct.comp (ι_sh (a + 1) b (c + 1) hc') (τ_step c))
      (_h_mul : ∀ r : ℕ,
        CategoryTheory.CategoryStruct.comp (τ_step r) (ι_sh r 0 (r + 1) rfl) =
          ℓ • CategoryTheory.CategoryStruct.id (J_obj (r + 1))),
      ∃ (res_1 : ∀ {a b : ℕ}, a ≤ b →
          CategoryTheory.Abelian.Ext.{u} X₀ (J_obj b) 1 →+
            CategoryTheory.Abelian.Ext.{u} X₀ (J_obj a) 1)
        (res_2 : ∀ {a b : ℕ}, a ≤ b →
          CategoryTheory.Abelian.Ext.{u} X₀ (J_obj b) 2 →+
            CategoryTheory.Abelian.Ext.{u} X₀ (J_obj a) 2)
        (ι_2 : ∀ r : ℕ,
          CategoryTheory.Abelian.Ext.{u} X₀ (J_obj r) 2 →+
            CategoryTheory.Abelian.Ext.{u} X₀ (J_obj (r + 1)) 2)
        (bock : ∀ r s : ℕ,
          CategoryTheory.Abelian.Ext.{u} X₀ (J_obj r) 1 →+
            CategoryTheory.Abelian.Ext.{u} X₀ (J_obj s) 2),
        (∀ (r : ℕ) (x : CategoryTheory.Abelian.Ext.{u} X₀ (J_obj (r + 1)) 1),
          res_1 (Nat.le_succ r) x =
            ((CategoryTheory.Abelian.Ext.mk₀ (τ_step r)).postcomp X₀ (Nat.add_zero 1)) x) ∧
        (∀ (a : ℕ) (x : CategoryTheory.Abelian.Ext.{u} X₀ (J_obj a) 1),
          res_1 (le_refl a) x = x) ∧
        (∀ {a b c : ℕ} (hab : a ≤ b) (hbc : b ≤ c)
            (x : CategoryTheory.Abelian.Ext.{u} X₀ (J_obj c) 1),
          res_1 hab (res_1 hbc x) = res_1 (le_trans hab hbc) x) ∧
        (∀ {a b c : ℕ} (hab : a ≤ b) (hbc : b ≤ c)
            (x : CategoryTheory.Abelian.Ext.{u} X₀ (J_obj c) 2),
          res_2 hab (res_2 hbc x) = res_2 (le_trans hab hbc) x) ∧
        (∀ (r : ℕ) (z : CategoryTheory.Abelian.Ext.{u} X₀ (J_obj (r + 1)) 2),
          res_2 (Nat.zero_le (r + 1)) z = 0 →
            ∃ y : CategoryTheory.Abelian.Ext.{u} X₀ (J_obj r) 2, ι_2 r y = z) ∧
        (∀ (r : ℕ) (y : CategoryTheory.Abelian.Ext.{u} X₀ (J_obj (r + 1)) 2),
          res_2 (Nat.le_succ (r + 1)) (ι_2 (r + 1) y) = ι_2 r (res_2 (Nat.le_succ r) y)) ∧
        (∀ (r : ℕ) (z : CategoryTheory.Abelian.Ext.{u} X₀ (J_obj (r + 1)) 2),
          ι_2 r (res_2 (Nat.le_succ r) z) = ℓ • z) ∧
        (∀ (r s : ℕ) (x : CategoryTheory.Abelian.Ext.{u} X₀ (J_obj r) 1),
          res_2 (Nat.le_succ s) (bock r (s + 1) x) = bock r s x) ∧
        (∀ (r s : ℕ) (x : CategoryTheory.Abelian.Ext.{u} X₀ (J_obj r) 1),
          bock r s x = 0 →
            ∃ y : CategoryTheory.Abelian.Ext.{u} X₀ (J_obj (r + (s + 1))) 1,
              res_1 (Nat.le_add_right r (s + 1)) y = x) := by
    intro 𝒞 _ _ _ X₀ J_obj τ_step τ_le ι_sh h_refl h_succ h_trans h_se h_comm h_mul
    have hmk₀_nsmul : ∀ (Y : 𝒞) (k c : ℕ) (z : CategoryTheory.Abelian.Ext.{u} X₀ Y k),
        z.comp (CategoryTheory.Abelian.Ext.mk₀ (c • CategoryTheory.CategoryStruct.id Y))
          (Nat.add_zero k) = c • z := by
      intro Y k c z
      induction c with
      | zero =>
        rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero]
        exact CategoryTheory.Abelian.Ext.comp_zero z Y 0 k (Nat.add_zero k)
      | succ t ih =>
        rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
          CategoryTheory.Abelian.Ext.comp_add, CategoryTheory.Abelian.Ext.comp_mk₀_id, ih]
    let h0_fn (a b c : ℕ) (hc : a + b + 1 = c) (hbc : b ≤ c) :=
      Classical.choose (h_se a b c hc hbc)
    let hSE_fn (a b c : ℕ) (hc : a + b + 1 = c) (hbc : b ≤ c) :
        (CategoryTheory.ShortComplex.mk (ι_sh a b c hc) (τ_le hbc) (h0_fn a b c hc hbc)).ShortExact :=
      Classical.choose_spec (h_se a b c hc hbc)
    let res_1 : ∀ {a b : ℕ}, a ≤ b →
        CategoryTheory.Abelian.Ext.{u} X₀ (J_obj b) 1 →+
          CategoryTheory.Abelian.Ext.{u} X₀ (J_obj a) 1 :=
      fun {_ _} hab => (CategoryTheory.Abelian.Ext.mk₀ (τ_le hab)).postcomp X₀ (Nat.add_zero 1)
    let res_2 : ∀ {a b : ℕ}, a ≤ b →
        CategoryTheory.Abelian.Ext.{u} X₀ (J_obj b) 2 →+
          CategoryTheory.Abelian.Ext.{u} X₀ (J_obj a) 2 :=
      fun {_ _} hab => (CategoryTheory.Abelian.Ext.mk₀ (τ_le hab)).postcomp X₀ (Nat.add_zero 2)
    let ι_2 : ∀ r : ℕ,
        CategoryTheory.Abelian.Ext.{u} X₀ (J_obj r) 2 →+
          CategoryTheory.Abelian.Ext.{u} X₀ (J_obj (r + 1)) 2 :=
      fun r => (CategoryTheory.Abelian.Ext.mk₀ (ι_sh r 0 (r + 1) rfl)).postcomp X₀ (Nat.add_zero 2)
    let bock : ∀ r s : ℕ,
        CategoryTheory.Abelian.Ext.{u} X₀ (J_obj r) 1 →+
          CategoryTheory.Abelian.Ext.{u} X₀ (J_obj s) 2 :=
      fun r s =>
        ((hSE_fn s r (r + (s + 1)) (by omega) (Nat.le_add_right r (s + 1))).extClass).postcomp
          X₀ (Nat.one_add 1)
    refine ⟨res_1, res_2, ι_2, bock, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro r x
      dsimp only [res_1]
      rw [h_succ r]
    · intro a x
      change x.comp (CategoryTheory.Abelian.Ext.mk₀ (τ_le (le_refl a))) (Nat.add_zero 1) = x
      rw [h_refl a]
      exact CategoryTheory.Abelian.Ext.comp_mk₀_id x
    · intro a b c hab hbc x
      change (x.comp (CategoryTheory.Abelian.Ext.mk₀ (τ_le hbc)) (Nat.add_zero 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (τ_le hab)) (Nat.add_zero 1) =
        x.comp (CategoryTheory.Abelian.Ext.mk₀ (τ_le (le_trans hab hbc))) (Nat.add_zero 1)
      rw [CategoryTheory.Abelian.Ext.comp_assoc x
            (CategoryTheory.Abelian.Ext.mk₀ (τ_le hbc))
            (CategoryTheory.Abelian.Ext.mk₀ (τ_le hab))
            (Nat.add_zero 1) (Nat.zero_add 0) (Nat.add_zero 1),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← h_trans hab hbc]
    · intro a b c hab hbc x
      change (x.comp (CategoryTheory.Abelian.Ext.mk₀ (τ_le hbc)) (Nat.add_zero 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (τ_le hab)) (Nat.add_zero 2) =
        x.comp (CategoryTheory.Abelian.Ext.mk₀ (τ_le (le_trans hab hbc))) (Nat.add_zero 2)
      rw [CategoryTheory.Abelian.Ext.comp_assoc x
            (CategoryTheory.Abelian.Ext.mk₀ (τ_le hbc))
            (CategoryTheory.Abelian.Ext.mk₀ (τ_le hab))
            (Nat.add_zero 2) (Nat.zero_add 0) (Nat.add_zero 2),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← h_trans hab hbc]
    · intro r z hz
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ X₀
        (hSE_fn r 0 (r + 1) rfl (Nat.zero_le (r + 1))) z hz
    · intro r y
      change (y.comp (CategoryTheory.Abelian.Ext.mk₀ (ι_sh (r + 1) 0 (r + 1 + 1) rfl))
          (Nat.add_zero 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (τ_le (Nat.le_succ (r + 1)))) (Nat.add_zero 2) =
        (y.comp (CategoryTheory.Abelian.Ext.mk₀ (τ_le (Nat.le_succ r))) (Nat.add_zero 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (ι_sh r 0 (r + 1) rfl)) (Nat.add_zero 2)
      rw [h_succ (r + 1), h_succ r,
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 2) (Nat.zero_add 0) (Nat.add_zero 2),
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 2) (Nat.zero_add 0) (Nat.add_zero 2),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        h_comm r 0 (r + 1) rfl rfl]
    · intro r z
      change (z.comp (CategoryTheory.Abelian.Ext.mk₀ (τ_le (Nat.le_succ r))) (Nat.add_zero 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (ι_sh r 0 (r + 1) rfl)) (Nat.add_zero 2) = ℓ • z
      rw [h_succ r,
        CategoryTheory.Abelian.Ext.comp_assoc z _ _ (Nat.add_zero 2) (Nat.zero_add 0) (Nat.add_zero 2),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_mul r]
      exact hmk₀_nsmul (J_obj (r + 1)) 2 ℓ z
    · intro r s x
      let hc_dn : s + r + 1 = r + (s + 1) := by omega
      let hc_up : (s + 1) + r + 1 = r + (s + 1 + 1) := by omega
      let hle_dn : r ≤ r + (s + 1) := Nat.le_add_right r (s + 1)
      let hle_up : r ≤ r + (s + 1 + 1) := Nat.le_add_right r (s + 1 + 1)
      let hSE_dn := hSE_fn s r (r + (s + 1)) hc_dn hle_dn
      let hSE_up := hSE_fn (s + 1) r (r + (s + 1 + 1)) hc_up hle_up
      have hcomm12 : CategoryTheory.CategoryStruct.comp (τ_step s) (ι_sh s r (r + (s + 1)) hc_dn) =
          CategoryTheory.CategoryStruct.comp (ι_sh (s + 1) r (r + (s + 1 + 1)) hc_up)
            (τ_step (r + (s + 1))) :=
        h_comm s r (r + (s + 1)) hc_dn hc_up
      have hcomm23 : CategoryTheory.CategoryStruct.comp (τ_step (r + (s + 1))) (τ_le hle_dn) =
          CategoryTheory.CategoryStruct.comp (τ_le hle_up)
            (CategoryTheory.CategoryStruct.id (J_obj r)) := by
        rw [CategoryTheory.Category.comp_id, ← h_succ (r + (s + 1)),
          ← h_trans hle_dn (Nat.le_succ (r + (s + 1)))]
      let φ_SC : CategoryTheory.ShortComplex.mk (ι_sh (s + 1) r (r + (s + 1 + 1)) hc_up)
            (τ_le hle_up) (h0_fn (s + 1) r (r + (s + 1 + 1)) hc_up hle_up) ⟶
          CategoryTheory.ShortComplex.mk (ι_sh s r (r + (s + 1)) hc_dn)
            (τ_le hle_dn) (h0_fn s r (r + (s + 1)) hc_dn hle_dn) :=
        CategoryTheory.ShortComplex.Hom.mk (τ_step s) (τ_step (r + (s + 1)))
          (CategoryTheory.CategoryStruct.id (J_obj r)) hcomm12 hcomm23
      have hnat := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE_up hSE_dn φ_SC
      change (x.comp hSE_up.extClass (Nat.one_add 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (τ_le (Nat.le_succ s))) (Nat.add_zero 2) =
        x.comp hSE_dn.extClass (Nat.one_add 1)
      rw [h_succ s,
        CategoryTheory.Abelian.Ext.comp_assoc x hSE_up.extClass
          (CategoryTheory.Abelian.Ext.mk₀ (τ_step s))
          (Nat.one_add 1) (Nat.add_zero 1) (Nat.add_zero 2)]
      have hnat' : hSE_up.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (τ_step s)) (Nat.add_zero 1) =
          hSE_dn.extClass := by
        exact hnat.trans (CategoryTheory.Abelian.Ext.mk₀_id_comp hSE_dn.extClass)
      rw [hnat']
    · intro r s x hx
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ X₀
        (hSE_fn s r (r + (s + 1)) (by omega) (Nat.le_add_right r (s + 1))) x (Nat.one_add 1) hx

  obtain ⟨res_J1, res_J2, ι_J2, bock_J, hC5, hC6, hC7, hC8, hC9, hC10, hC11, hC12, hC13⟩ :=
    hPillar4 Fℤ 𝒥_ab τ_𝒥_ab_step (@τ_𝒥_ab_le) ι_bock_sh
      hτ_le_refl hτ_le_succ (@hτ_le_trans) hSE_all hComm_bock hMul_bock

  refine ⟨𝒥, ℳ, 𝒥_dual, ℳ_dual, ι_ext, triv, ι_dual, triv_dual,
    hPair, hPair_dual, ψ_J, ψ_adj, τ_ℳ_ab, τ_ℳ_dual_ab, τ_𝒥_ab_step,
    (fun r => (𝒥_ab r).H 1), (fun r => (𝒥_ab r).H 2),
    (fun r => inferInstance), (fun r => inferInstance), ?_⟩
  exact ⟨(fun r => AddEquiv.refl _), (fun r => AddEquiv.refl _),
    (@res_J1), (@res_J2), ι_J2, bock_J,
    hψ_comp, hψ_J_spec, hτ_𝒥_comm, hτ_ℳ_both_spec,
    hC5, hC6, @hC7, @hC8, hC9, hC10, hC11, hC12, hC13⟩

theorem weil_mid_ext_const_subfield_and_geom_ring_iso (F : Type u) [Finite F] [Field F]
    (R₀ B_r L_r B_bar_r k_L E_L : Type u)
    [CommRing R₀] [IsDomain R₀]
    [CommRing B_r] [IsDomain B_r] [Field L_r]
    [CommRing B_bar_r] [IsDomain B_bar_r]
    [Finite k_L] [Field k_L] [Field E_L]
    [Algebra F R₀] [Algebra F B_r] [Algebra (Polynomial F) B_r] [Algebra R₀ B_r]
    [Algebra F L_r] [Algebra (Polynomial F) L_r] [Algebra (RatFunc F) L_r]
    [Algebra B_r L_r] [Algebra R₀ L_r] [Algebra R₀ (RatFunc F)]
    [IsFractionRing R₀ (RatFunc F)]
    [IsScalarTower F R₀ B_r] [IsScalarTower F B_r L_r]
    [IsScalarTower F (RatFunc F) L_r] [IsScalarTower (Polynomial F) (RatFunc F) L_r]
    [IsScalarTower R₀ B_r L_r] [IsScalarTower R₀ (RatFunc F) L_r]
    [Module.Finite R₀ B_r] [Algebra.Etale R₀ B_r]
    [IsFractionRing B_r L_r] [IsIntegralClosure B_r R₀ L_r]
    [FiniteDimensional (RatFunc F) L_r] [IsGalois (RatFunc F) L_r]
    [Algebra F k_L] [Algebra k_L L_r] [Algebra k_L E_L]
    [Algebra (RatFunc k_L) E_L] [Algebra (RatFunc k_L) L_r] [Algebra E_L L_r]
    [IsScalarTower F k_L L_r] [IsScalarTower k_L (RatFunc k_L) L_r]
    [IsScalarTower k_L E_L L_r] [IsScalarTower (RatFunc k_L) E_L L_r]
    [FiniteDimensional (RatFunc k_L) L_r] [IsGalois (RatFunc k_L) L_r]
    [Algebra (TensorProduct F R₀ (AlgebraicClosure F)) B_bar_r]
    [Module.Finite (TensorProduct F R₀ (AlgebraicClosure F)) B_bar_r]
    [Algebra.Etale (TensorProduct F R₀ (AlgebraicClosure F)) B_bar_r]
    (q_B : B_r →+* B_bar_r) (hq_B_inj : Function.Injective q_B)
    (q_k : AlgebraicClosure F →+* B_bar_r)
    (htmalg : ∀ (z : R₀) (c : AlgebraicClosure F),
      algebraMap (TensorProduct F R₀ (AlgebraicClosure F)) B_bar_r (TensorProduct.tmul F z c) =
        q_B (algebraMap R₀ B_r z) * q_k c)
    (hepi_Bbar : ∀ {A : Type u} [CommRing A] (f₁ f₂ : B_bar_r →+* A),
      (∀ b : B_r, f₁ (q_B b) = f₂ (q_B b)) →
      (∀ c : AlgebraicClosure F, f₁ (q_k c) = f₂ (q_k c)) →
      f₁ = f₂)
    (hk_int : ∀ c : k_L, IsIntegral F (algebraMap k_L L_r c))
    (hE_int : ∀ x : E_L, IsIntegral k_L x → x ∈ Set.range (algebraMap k_L E_L))
    (hGal_fix : ∀ (σ_K : L_r ≃ₐ[RatFunc k_L] L_r) (x : L_r), IsIntegral F x → σ_K x = x) :
    let k := AlgebraicClosure F
    let R0_bar := TensorProduct F R₀ k
    ∃ (ι_kB : k_L →ₐ[F] B_r)
      (κ_k : k_L →ₐ[F] k)
      (res_k : (B_r ≃ₐ[R₀] B_r) →* (k_L ≃ₐ[F] k_L)),
      (Algebra.Etale F k_L ∧ IsGalois F k_L ∧ Algebra.IsAlgebraic F k_L) ∧
      Set.range ι_kB = { x : B_r | IsIntegral F x } ∧
      Function.Surjective res_k ∧
      (∀ (σ : B_r ≃ₐ[R₀] B_r) (c : k_L), σ (ι_kB c) = ι_kB (res_k σ c)) ∧
      (∀ c : k_L, q_B (ι_kB c) = q_k (κ_k c)) ∧
      (letI : Algebra k_L B_r := ι_kB.toRingHom.toAlgebra
       letI : Algebra k_L k := κ_k.toRingHom.toAlgebra
       ∃ ψ_Bk : TensorProduct k_L B_r k ≃+* B_bar_r,
         (∀ (b : B_r) (c : k),
           ψ_Bk (TensorProduct.tmul k_L b c) = q_B b * q_k c) ∧
         (∀ (γ : B_bar_r ≃ₐ[R0_bar] B_bar_r) (σ : B_r ≃ₐ[R₀] B_r)
            (f : TensorProduct k_L B_r k →+* TensorProduct k_L B_r k),
           (∀ b : B_r, γ (q_B b) = q_B (σ b)) →
           (∀ (b : B_r) (c : k),
             f (TensorProduct.tmul k_L b c) = TensorProduct.tmul k_L (σ b) c) →
           ∀ u : TensorProduct k_L B_r k,
             γ (ψ_Bk u) = ψ_Bk (f u))) :=
by
  intro k R0_bar
  classical
  
  let liftRingHom : ∀ (E₀ B₀ k₀ C₀ : Type u) [CommRing E₀] [CommRing B₀]
      [CommRing k₀] [CommRing C₀] [Algebra E₀ B₀] [Algebra E₀ k₀]
      (f_B : B₀ →+* C₀) (f_k : k₀ →+* C₀),
      (∀ x : E₀, f_B (algebraMap E₀ B₀ x) = f_k (algebraMap E₀ k₀ x)) →
      { φ : TensorProduct E₀ B₀ k₀ →+* C₀ //
        ∀ (b : B₀) (c : k₀), φ (TensorProduct.tmul E₀ b c) = f_B b * f_k c } := by
    intro E₀ B₀ k₀ C₀ _ _ _ _ _ _ f_B f_k hcomp
    let _ : Algebra E₀ C₀ := (f_B.comp (algebraMap E₀ B₀)).toAlgebra
    let g_B : B₀ →ₐ[E₀] C₀ := { f_B with commutes' := fun _ => rfl }
    let g_k : k₀ →ₐ[E₀] C₀ := { f_k with commutes' := fun x => (hcomp x).symm }
    exact ⟨(Algebra.TensorProduct.lift g_B g_k (fun _ _ => Commute.all _ _)).toRingHom,
      fun b c => Algebra.TensorProduct.lift_tmul g_B g_k _ b c⟩

  
  have hGal_Fk : IsGalois F k_L := GaloisField.instIsGaloisOfFinite
  let _ : IsGalois F k_L := hGal_Fk
  let _ : FiniteDimensional F k_L := Module.Finite.of_finite
  have hAlg_Fk : Algebra.IsAlgebraic F k_L := inferInstance
  have hEt_Fk : Algebra.Etale F k_L := by
    let _ : Algebra.FormallyEtale F k_L := Algebra.FormallyEtale.of_isSeparable F k_L
    let _ : Algebra.FiniteType F k_L := Module.Finite.finiteType k_L
    let _ : Algebra.FinitePresentation F k_L :=
      (Algebra.FinitePresentation.of_finiteType (R := F) (A := k_L)).mp inferInstance
    exact ⟨inferInstance, inferInstance⟩
  let _ : Algebra.Etale F k_L := hEt_Fk
  let _ : Algebra.IsIntegral F k_L := Algebra.IsIntegral.of_finite F k_L

  have hST_FR0L : IsScalarTower F R₀ L_r :=
    IsScalarTower.of_algebraMap_eq fun a => by
      rw [IsScalarTower.algebraMap_apply F B_r L_r a,
        IsScalarTower.algebraMap_apply F R₀ B_r a,
        ← IsScalarTower.algebraMap_apply R₀ B_r L_r]
  let _ : IsScalarTower F R₀ L_r := hST_FR0L
  have hInj_BL : Function.Injective (algebraMap B_r L_r) := IsFractionRing.injective B_r L_r

  have hex_ι : ∀ c : k_L, ∃ b : B_r, algebraMap B_r L_r b = algebraMap k_L L_r c :=
    fun c => (IsIntegralClosure.isIntegral_iff (A := B_r) (R := R₀) (B := L_r)).mp
      (_root_.IsIntegral.tower_top (hk_int c))
  let ι_fun : k_L → B_r := fun c => Classical.choose (hex_ι c)
  have hι_L : ∀ c : k_L, algebraMap B_r L_r (ι_fun c) = algebraMap k_L L_r c :=
    fun c => Classical.choose_spec (hex_ι c)
  let ι_kB : k_L →ₐ[F] B_r :=
    { toFun := ι_fun
      map_one' := hInj_BL (by rw [hι_L, map_one, map_one])
      map_mul' := fun x y => hInj_BL (by rw [hι_L, map_mul, map_mul, hι_L, hι_L])
      map_zero' := hInj_BL (by rw [hι_L, map_zero, map_zero])
      map_add' := fun x y => hInj_BL (by rw [hι_L, map_add, map_add, hι_L, hι_L])
      commutes' := fun a => hInj_BL (by
        rw [hι_L, ← IsScalarTower.algebraMap_apply F k_L L_r,
          ← IsScalarTower.algebraMap_apply F B_r L_r]) }
  have hι_kB_L : ∀ c : k_L, algebraMap B_r L_r (ι_kB c) = algebraMap k_L L_r c := hι_L
  have hInj_ιkB : Function.Injective ι_kB := ι_kB.toRingHom.injective

  have hRange_ιkB : Set.range ι_kB = { x : B_r | _root_.IsIntegral F x } := by
    ext x
    constructor
    · rintro ⟨c, rfl⟩
      have h1 : _root_.IsIntegral F (algebraMap B_r L_r (ι_kB c)) := by
        rw [hι_kB_L]
        exact hk_int c
      exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom F B_r L_r) hInj_BL).mp h1
    · intro hx
      let z : L_r := algebraMap B_r L_r x
      have hz_F : _root_.IsIntegral F z := hx.map (IsScalarTower.toAlgHom F B_r L_r)
      have hz_fix : z ∈ IntermediateField.fixedField (⊤ : Subgroup (L_r ≃ₐ[RatFunc k_L] L_r)) := by
        rw [IntermediateField.mem_fixedField_iff]
        intro σ_K _
        exact hGal_fix σ_K z hz_F
      rw [IsGalois.fixedField_top, IntermediateField.mem_bot] at hz_fix
      obtain ⟨r, hr⟩ := hz_fix
      let y : E_L := algebraMap (RatFunc k_L) E_L r
      have hy_L : algebraMap E_L L_r y = z := by
        dsimp [y]
        rw [← IsScalarTower.algebraMap_apply (RatFunc k_L) E_L L_r, hr]
      have hz_k : _root_.IsIntegral k_L z := _root_.IsIntegral.tower_top hz_F
      have hy_k : _root_.IsIntegral k_L y :=
        (isIntegral_algHom_iff (IsScalarTower.toAlgHom k_L E_L L_r)
          (algebraMap E_L L_r).injective).mp (by rwa [IsScalarTower.toAlgHom_apply, hy_L])
      obtain ⟨c, hc⟩ := hE_int y hy_k
      refine ⟨c, hInj_BL ?_⟩
      rw [hι_kB_L, IsScalarTower.algebraMap_apply k_L E_L L_r, hc, hy_L]
  have hMem_ιkB : ∀ b : B_r, _root_.IsIntegral F b ↔ ∃ c : k_L, ι_kB c = b :=
    fun b => by
      change b ∈ { x : B_r | _root_.IsIntegral F x } ↔ b ∈ Set.range ι_kB
      rw [hRange_ιkB]

  
  have hex_res : ∀ (σ : B_r ≃ₐ[R₀] B_r) (c : k_L), ∃ c' : k_L, ι_kB c' = σ (ι_kB c) := by
    intro σ c
    have hc_int : _root_.IsIntegral F (ι_kB c) := (hMem_ιkB (ι_kB c)).mpr ⟨c, rfl⟩
    have hσc_int : _root_.IsIntegral F (σ (ι_kB c)) := hc_int.map (σ.restrictScalars F).toAlgHom
    exact (hMem_ιkB (σ (ι_kB c))).mp hσc_int
  let res_fun : (B_r ≃ₐ[R₀] B_r) → k_L → k_L := fun σ c => Classical.choose (hex_res σ c)
  have hres_spec : ∀ (σ : B_r ≃ₐ[R₀] B_r) (c : k_L), ι_kB (res_fun σ c) = σ (ι_kB c) :=
    fun σ c => Classical.choose_spec (hex_res σ c)
  let res_alg : (B_r ≃ₐ[R₀] B_r) → (k_L ≃ₐ[F] k_L) := fun σ =>
    { toFun := res_fun σ
      invFun := res_fun σ.symm
      left_inv := fun c => hInj_ιkB (by rw [hres_spec, hres_spec, σ.symm_apply_apply])
      right_inv := fun c => hInj_ιkB (by rw [hres_spec, hres_spec, σ.apply_symm_apply])
      map_mul' := fun x y =>
        hInj_ιkB (by rw [hres_spec, map_mul, map_mul, map_mul, hres_spec, hres_spec])
      map_add' := fun x y =>
        hInj_ιkB (by rw [hres_spec, map_add, map_add, map_add, hres_spec, hres_spec])
      commutes' := fun a => hInj_ιkB (by
        rw [hres_spec, AlgHom.commutes, IsScalarTower.algebraMap_apply F R₀ B_r, σ.commutes,
          ← IsScalarTower.algebraMap_apply F R₀ B_r]) }
  let res_k : (B_r ≃ₐ[R₀] B_r) →* (k_L ≃ₐ[F] k_L) :=
    { toFun := res_alg
      map_one' := AlgEquiv.ext fun c => hInj_ιkB (by
        change ι_kB (res_fun 1 c) = ι_kB c
        rw [hres_spec, AlgEquiv.one_apply])
      map_mul' := fun σ₁ σ₂ => AlgEquiv.ext fun c => hInj_ιkB (by
        change ι_kB (res_fun (σ₁ * σ₂) c) = ι_kB (res_fun σ₁ (res_fun σ₂ c))
        rw [hres_spec, AlgEquiv.mul_apply, hres_spec, hres_spec]) }
  have hres_comm : ∀ (σ : B_r ≃ₐ[R₀] B_r) (c : k_L), σ (ι_kB c) = ι_kB (res_k σ c) :=
    fun σ c => (hres_spec σ c).symm

  have hSurj_res : Function.Surjective res_k := by
    let j_k : k_L →ₐ[F] L_r := IsScalarTower.toAlgHom F k_L L_r
    let j_RF : RatFunc F →ₐ[F] L_r := IsScalarTower.toAlgHom F (RatFunc F) L_r
    let K_int : IntermediateField F L_r := j_k.fieldRange
    let L_int : IntermediateField F L_r := j_RF.fieldRange
    have hDisj_KL : K_int ⊓ L_int = ⊥ := by
      rw [eq_bot_iff]
      intro z ⟨⟨c, hc⟩, ⟨f, hf⟩⟩
      rw [IntermediateField.mem_bot]
      have hc' : j_k c = z := hc
      have hf' : j_RF f = z := hf
      have hz_int : _root_.IsIntegral F z := by
        rw [← hc']
        exact hk_int c
      have hf_int : _root_.IsIntegral F f :=
        (isIntegral_algHom_iff j_RF j_RF.injective).mp (by rwa [hf'])
      have hf_poly_int : _root_.IsIntegral (Polynomial F) f := _root_.IsIntegral.tower_top hf_int
      obtain ⟨p, rfl⟩ :=
        (IsIntegrallyClosed.isIntegral_iff (R := Polynomial F) (K := RatFunc F)).mp hf_poly_int
      have hp_int : _root_.IsIntegral F p :=
        (isIntegral_algHom_iff (IsScalarTower.toAlgHom F (Polynomial F) (RatFunc F))
          (IsFractionRing.injective (Polynomial F) (RatFunc F))).mp hf_int
      have hp_deg : p.natDegree = 0 := by
        by_contra hdeg
        rcases hp_int with ⟨M, hM_mon, hM_eval⟩
        have hcomp : M.comp p = 0 := by
          rw [Polynomial.comp, ← Polynomial.algebraMap_eq]
          exact hM_eval
        have hlc := Polynomial.leadingCoeff_comp (p := M) (q := p) hdeg
        rw [hcomp, Polynomial.leadingCoeff_zero, hM_mon.leadingCoeff, one_mul] at hlc
        have hp_ne : p ≠ 0 := fun h0 => hdeg (by rw [h0, Polynomial.natDegree_zero])
        exact pow_ne_zero M.natDegree (Polynomial.leadingCoeff_ne_zero.mpr hp_ne) hlc.symm
      let a₀ : F := p.coeff 0
      have hp_eq : p = Polynomial.C a₀ := Polynomial.eq_C_of_natDegree_eq_zero hp_deg
      refine ⟨a₀, ?_⟩
      rw [← hf', IsScalarTower.toAlgHom_apply, hp_eq, ← Polynomial.algebraMap_eq,
        ← IsScalarTower.algebraMap_apply F (Polynomial F) (RatFunc F),
        ← IsScalarTower.algebraMap_apply F (RatFunc F) L_r]
    let e_kK : k_L ≃ₐ[F] ↥K_int :=
      AlgEquiv.ofBijective
        (j_k.codRestrict K_int.toSubalgebra fun c => ⟨c, rfl⟩)
        ⟨fun a b h => j_k.injective (congrArg Subtype.val h), fun ⟨_, c, hc⟩ => ⟨c, Subtype.ext hc⟩⟩
    let e_RFL : RatFunc F ≃ₐ[F] ↥L_int :=
      AlgEquiv.ofBijective
        (j_RF.codRestrict L_int.toSubalgebra fun r => ⟨r, rfl⟩)
        ⟨fun a b h => j_RF.injective (congrArg Subtype.val h), fun ⟨_, r, hr⟩ => ⟨r, Subtype.ext hr⟩⟩
    have hGal_FK : IsGalois F ↥K_int := IsGalois.of_algEquiv e_kK
    have hFin_FK : FiniteDimensional F ↥K_int := Module.Finite.equiv e_kK.toLinearEquiv
    have hFinGal_L : FiniteDimensional ↥L_int L_r ∧ IsGalois ↥L_int L_r := by
      let _ : Algebra (RatFunc F) ↥L_int := e_RFL.toRingHom.toAlgebra
      let _ : IsScalarTower (RatFunc F) ↥L_int L_r := IsScalarTower.of_algebraMap_eq fun _ => rfl
      exact ⟨Module.Finite.of_restrictScalars_finite (RatFunc F) ↥L_int L_r,
        IsGalois.tower_top_of_isGalois (RatFunc F) ↥L_int L_r⟩
    let _ : Normal F ↥K_int := hGal_FK.to_normal
    let _ : FiniteDimensional F ↥K_int := hFin_FK
    let _ : FiniteDimensional ↥L_int L_r := hFinGal_L.1
    let _ : IsGalois ↥L_int L_r := hFinGal_L.2
    let _ : Algebra.IsAlgebraic (RatFunc F) L_r := Algebra.IsAlgebraic.of_finite (RatFunc F) L_r
    intro γ
    let γ_K : ↥K_int ≃ₐ[F] ↥K_int := (e_kK.symm.trans γ).trans e_kK
    obtain ⟨σ_int, hσ_int⟩ :=
      IntermediateField.restrictRestrictAlgEquivMapHom_surjective K_int L_int hDisj_KL γ_K
    have hcomm_RF : ∀ r : RatFunc F,
        σ_int.toRingEquiv (algebraMap (RatFunc F) L_r r) = algebraMap (RatFunc F) L_r r :=
      fun r => σ_int.commutes (e_RFL r)
    let σ_L : L_r ≃ₐ[RatFunc F] L_r := AlgEquiv.ofRingEquiv (f := σ_int.toRingEquiv) hcomm_RF
    let σ_B : B_r ≃ₐ[R₀] B_r := galRestrict R₀ (RatFunc F) L_r B_r σ_L
    refine ⟨σ_B, AlgEquiv.ext fun c => ?_⟩
    apply hInj_ιkB
    apply hInj_BL
    rw [← hres_comm, algebraMap_galRestrict_apply R₀ σ_L (ι_kB c), hι_kB_L, hι_kB_L]
    have h1 : ((IntermediateField.restrictRestrictAlgEquivMapHom F ↥K_int ↥L_int L_r σ_int)
        (e_kK c) : L_r) = (γ_K (e_kK c) : L_r) := by
      rw [hσ_int]
    have h2 : ((IntermediateField.restrictRestrictAlgEquivMapHom F ↥K_int ↥L_int L_r σ_int)
        (e_kK c) : L_r) = σ_int (algebraMap k_L L_r c) :=
      AlgEquiv.restrictNormal_commutes (σ_int.restrictScalars F) ↥K_int (e_kK c)
    have h3 : (γ_K (e_kK c) : L_r) = algebraMap k_L L_r (γ c) := by
      dsimp [γ_K]
      rw [e_kK.symm_apply_apply]
      rfl
    change σ_int (algebraMap k_L L_r c) = algebraMap k_L L_r (γ c)
    rw [← h2, h1, h3]

  
  have hq_Fk : ∀ a : F, q_B (algebraMap F B_r a) = q_k (algebraMap F k a) := by
    intro a
    have htm : TensorProduct.tmul F (algebraMap F R₀ a) (1 : k) =
        TensorProduct.tmul F (1 : R₀) (algebraMap F k a) := by
      rw [Algebra.algebraMap_eq_smul_one (A := R₀),
        TensorProduct.smul_tmul a (1 : R₀) (1 : k),
        ← Algebra.algebraMap_eq_smul_one]
    have h1 := congrArg (algebraMap R0_bar B_bar_r) htm
    rw [htmalg, htmalg, ← IsScalarTower.algebraMap_apply F R₀ B_r,
      map_one, map_one, map_one, mul_one, one_mul] at h1
    exact h1
  have hq_k_inj : Function.Injective q_k := q_k.injective

  have hex_κ : ∀ c : k_L, ∃ α : k, q_k α = q_B (ι_kB c) := by
    intro c
    let P : Polynomial F := minpoly F c
    have hP_mon : P.Monic := minpoly.monic (Algebra.IsIntegral.isIntegral c)
    have hP_aeval : Polynomial.eval₂ (algebraMap F k_L) c P = 0 := minpoly.aeval F c
    have hhom_ev := Polynomial.hom_eval₂ P (algebraMap F k_L) (q_B.comp ι_kB.toRingHom) c
    rw [hP_aeval, map_zero] at hhom_ev
    have hcomp_Fk : (q_B.comp ι_kB.toRingHom).comp (algebraMap F k_L) =
        q_k.comp (algebraMap F k) := by
      ext a
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        AlgHom.commutes, hq_Fk]
    rw [hcomp_Fk, ← Polynomial.eval₂_map] at hhom_ev
    let P_k : Polynomial k := P.map (algebraMap F k)
    have hPk_mon : P_k.Monic := hP_mon.map (algebraMap F k)
    have hPk_prod : P_k = (P_k.roots.map fun α => Polynomial.X - Polynomial.C α).prod :=
      Polynomial.Splits.eq_prod_roots_of_monic (IsAlgClosed.splits P_k) hPk_mon
    let ev_hom : Polynomial k →+* B_bar_r := Polynomial.eval₂RingHom q_k (q_B (ι_kB c))
    have hev0 : ev_hom P_k = 0 := hhom_ev.symm
    rw [hPk_prod, map_multiset_prod, Multiset.map_map, Multiset.prod_eq_zero_iff,
      Multiset.mem_map] at hev0
    obtain ⟨α, _, hα0⟩ := hev0
    simp only [Function.comp_apply, ev_hom, Polynomial.coe_eval₂RingHom,
      Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C] at hα0
    exact ⟨α, (sub_eq_zero.mp hα0).symm⟩

  let κ_fun : k_L → k := fun c => Classical.choose (hex_κ c)
  have hκ_spec : ∀ c : k_L, q_k (κ_fun c) = q_B (ι_kB c) :=
    fun c => Classical.choose_spec (hex_κ c)
  let κ_k : k_L →ₐ[F] k :=
    { toFun := κ_fun
      map_one' := hq_k_inj (by rw [hκ_spec, map_one, map_one, map_one])
      map_mul' := fun x y => hq_k_inj (by rw [hκ_spec, map_mul, map_mul, map_mul, hκ_spec, hκ_spec])
      map_zero' := hq_k_inj (by rw [hκ_spec, map_zero, map_zero, map_zero])
      map_add' := fun x y => hq_k_inj (by rw [hκ_spec, map_add, map_add, map_add, hκ_spec, hκ_spec])
      commutes' := fun a => hq_k_inj (by rw [hκ_spec, AlgHom.commutes, hq_Fk]) }
  have hq_κ : ∀ c : k_L, q_B (ι_kB c) = q_k (κ_k c) := fun c => (hκ_spec c).symm

  refine ⟨ι_kB, κ_k, res_k, ⟨hEt_Fk, hGal_Fk, hAlg_Fk⟩, hRange_ιkB, hSurj_res, hres_comm, hq_κ, ?_⟩
  let _ : Algebra k_L B_r := ι_kB.toRingHom.toAlgebra
  let _ : Algebra k_L k := κ_k.toRingHom.toAlgebra
  let _ : IsScalarTower F k_L B_r := IsScalarTower.of_algebraMap_eq fun a => (ι_kB.commutes a).symm
  let _ : IsScalarTower F k_L k := IsScalarTower.of_algebraMap_eq fun a => (κ_k.commutes a).symm
  let _ : IsScalarTower k_L B_r L_r := IsScalarTower.of_algebraMap_eq fun c => (hι_kB_L c).symm
  let _ : Algebra.IsAlgebraic k_L k := Algebra.IsAlgebraic.tower_top (K := F) k_L

  let T_Bk := TensorProduct k_L B_r k
  obtain ⟨Ψ₀, hΨ₀_tmul⟩ := liftRingHom k_L B_r k B_bar_r q_B q_k hq_κ

  
  have hΨ₀_inj : Function.Injective Ψ₀ := by
    let F_D := FractionRing B_bar_r
    have hInj_DF : Function.Injective (algebraMap B_bar_r F_D) :=
      IsFractionRing.injective B_bar_r F_D
    let j_B : B_r →+* F_D := (algebraMap B_bar_r F_D).comp q_B
    have hInj_jB : Function.Injective j_B := hInj_DF.comp hq_B_inj
    let q_tilde_L : L_r →+* F_D := IsFractionRing.lift hInj_jB
    let q_tilde_k : k →+* F_D := (algebraMap B_bar_r F_D).comp q_k
    obtain ⟨Ψ_tilde, hΨ_tilde_tmul⟩ := liftRingHom k_L L_r k F_D q_tilde_L q_tilde_k fun c => by
      rw [IsScalarTower.algebraMap_apply k_L B_r L_r c, IsFractionRing.lift_algebraMap hInj_jB]
      change algebraMap B_bar_r F_D (q_B (ι_kB c)) = algebraMap B_bar_r F_D (q_k (κ_k c))
      rw [hq_κ c]
    let ι_BL : B_r →ₐ[k_L] L_r := IsScalarTower.toAlgHom k_L B_r L_r
    let φ_BL : T_Bk →ₐ[k_L] TensorProduct k_L L_r k :=
      Algebra.TensorProduct.map ι_BL (AlgHom.id k_L k)
    have hφ_BL_eq : φ_BL.toLinearMap = LinearMap.rTensor k ι_BL.toLinearMap :=
      TensorProduct.ext' fun _ _ => rfl
    have hInj_φBL : Function.Injective φ_BL := by
      change Function.Injective φ_BL.toLinearMap
      rw [hφ_BL_eq]
      exact Module.Flat.rTensor_preserves_injective_linearMap ι_BL.toLinearMap hInj_BL
    have hΨ_tilde_comp : ∀ w : T_Bk, Ψ_tilde (φ_BL w) = algebraMap B_bar_r F_D (Ψ₀ w) := by
      intro w
      refine TensorProduct.inductionOn
        (motive := fun w => Ψ_tilde (φ_BL w) = algebraMap B_bar_r F_D (Ψ₀ w)) w ?_ ?_
      · intro b c
        change Ψ_tilde (TensorProduct.tmul k_L (algebraMap B_r L_r b) c) =
          algebraMap B_bar_r F_D (Ψ₀ (TensorProduct.tmul k_L b c))
        rw [hΨ_tilde_tmul, IsFractionRing.lift_algebraMap hInj_jB, hΨ₀_tmul, map_mul]
        rfl
      · intro x y hx hy
        rw [map_add, map_add, map_add, map_add, hx, hy]
    have hIntCl_kL : ∀ z : L_r, _root_.IsIntegral k_L z → ∃ x : k_L, algebraMap k_L L_r x = z := by
      intro z hz
      have hzF : _root_.IsIntegral F z := isIntegral_trans z hz
      have hzR0 : _root_.IsIntegral R₀ z := _root_.IsIntegral.tower_top hzF
      obtain ⟨b, rfl⟩ :=
        (IsIntegralClosure.isIntegral_iff (A := B_r) (R := R₀) (B := L_r)).mp hzR0
      have hbF : _root_.IsIntegral F b :=
        (isIntegral_algHom_iff (IsScalarTower.toAlgHom F B_r L_r) hInj_BL).mp hzF
      obtain ⟨x, rfl⟩ := (hMem_ιkB b).mp hbF
      exact ⟨x, (hι_kB_L x).symm⟩
    have hIrr_map : ∀ (P : Polynomial k_L), P.Monic → Irreducible P →
        Irreducible (P.map (algebraMap k_L L_r)) := by
      intro P hMon hIrr
      let P_L := P.map (algebraMap k_L L_r)
      have hInj_EL : Function.Injective (algebraMap k_L L_r) :=
        RingHom.injective (algebraMap k_L L_r)
      have hMon_L : P_L.Monic := hMon.map (algebraMap k_L L_r)
      have hdeg_pos : 0 < P_L.natDegree := by
        rw [Polynomial.natDegree_map_eq_of_injective hInj_EL]
        exact hIrr.natDegree_pos
      have hnot_unit : ¬ IsUnit P_L := by
        intro hu
        have h0 := Polynomial.natDegree_eq_zero_of_isUnit hu
        omega
      have hMon_descend : ∀ (f : Polynomial L_r), f.Monic → f ∣ P_L →
          ∃ f₀ : Polynomial k_L, f₀.map (algebraMap k_L L_r) = f := by
        intro f hf_mon ⟨g, hfg⟩
        let Ω := AlgebraicClosure L_r
        let ι_LΩ : L_r →+* Ω := algebraMap L_r Ω
        have hInj_LΩ : Function.Injective ι_LΩ := RingHom.injective ι_LΩ
        let f_Ω : Polynomial Ω := f.map ι_LΩ
        have hfΩ_mon : f_Ω.Monic := hf_mon.map ι_LΩ
        have hfΩ_prod : f_Ω = (f_Ω.roots.map fun r => Polynomial.X - Polynomial.C r).prod :=
          Polynomial.Splits.eq_prod_roots_of_monic (IsAlgClosed.splits f_Ω) hfΩ_mon
        have hroots_int : ∀ r ∈ f_Ω.roots, r ∈ integralClosure k_L Ω := by
          intro r hr
          have heval_f : f_Ω.eval r = 0 := Polynomial.isRoot_of_mem_roots hr
          have heval_P : (P.map (algebraMap k_L Ω)).eval r = 0 := by
            have hmap_eq : P.map (algebraMap k_L Ω) = P_L.map ι_LΩ := by
              dsimp [P_L]
              rw [Polynomial.map_map]
              rfl
            rw [hmap_eq, hfg, Polynomial.map_mul, Polynomial.eval_mul, heval_f, zero_mul]
          refine ⟨P, hMon, ?_⟩
          rwa [Polynomial.eval₂_eq_eval_map]
        have hprod_coeff_int : ∀ (M : Multiset Ω),
            (∀ r ∈ M, r ∈ integralClosure k_L Ω) →
            ∀ n : ℕ, ((M.map fun r => Polynomial.X - Polynomial.C r).prod).coeff n ∈
              integralClosure k_L Ω := by
          intro M
          refine Multiset.induction_on M ?_ ?_
          · intro _ n
            simp only [Multiset.map_zero, Multiset.prod_zero, Polynomial.coeff_one]
            split_ifs
            · exact one_mem (integralClosure k_L Ω)
            · exact zero_mem (integralClosure k_L Ω)
          · intro r M' ih hM n
            have hr_int : r ∈ integralClosure k_L Ω := hM r (Multiset.mem_cons_self r M')
            have hM'_int : ∀ s ∈ M', s ∈ integralClosure k_L Ω :=
              fun s hs => hM s (Multiset.mem_cons_of_mem hs)
            simp only [Multiset.map_cons, Multiset.prod_cons]
            rw [sub_mul, Polynomial.coeff_sub, Polynomial.coeff_C_mul]
            refine sub_mem ?_ (mul_mem hr_int (ih hM'_int n))
            cases n with
            | zero =>
              rw [Polynomial.coeff_X_mul_zero]
              exact zero_mem (integralClosure k_L Ω)
            | succ m =>
              rw [Polynomial.coeff_X_mul]
              exact ih hM'_int m
        have hf_coeff_E : ∀ n : ℕ, ∃ a : k_L, algebraMap k_L L_r a = f.coeff n := by
          intro n
          have hΩ_int : _root_.IsIntegral k_L (ι_LΩ (f.coeff n)) := by
            have hc : f_Ω.coeff n = ι_LΩ (f.coeff n) := Polynomial.coeff_map ι_LΩ n
            rw [← hc, hfΩ_prod]
            exact hprod_coeff_int f_Ω.roots hroots_int n
          have hL_int : _root_.IsIntegral k_L (f.coeff n) :=
            (isIntegral_algHom_iff (IsScalarTower.toAlgHom k_L L_r Ω) hInj_LΩ).mp hΩ_int
          exact hIntCl_kL (f.coeff n) hL_int
        choose a ha using hf_coeff_E
        let f₀ : Polynomial k_L :=
          ∑ n ∈ Finset.range (f.natDegree + 1), Polynomial.C (a n) * Polynomial.X ^ n
        refine ⟨f₀, ?_⟩
        ext n
        rw [Polynomial.coeff_map]
        dsimp [f₀]
        simp only [Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
          mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_range]
        split_ifs with hn
        · exact ha n
        · rw [map_zero]
          exact (Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)).symm
      refine ⟨hnot_unit, fun u v huv => ?_⟩
      have hPL_ne : P_L ≠ 0 := hMon_L.ne_zero
      have hu_ne : u ≠ 0 := fun h => hPL_ne (by change P.map _ = 0; rw [huv, h, zero_mul])
      have hv_ne : v ≠ 0 := fun h => hPL_ne (by change P.map _ = 0; rw [huv, h, mul_zero])
      let cu : L_r := u.leadingCoeff
      let cv : L_r := v.leadingCoeff
      have hcu_ne : cu ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hu_ne
      have hcv_ne : cv ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hv_ne
      let f : Polynomial L_r := u * Polynomial.C cu⁻¹
      let g : Polynomial L_r := v * Polynomial.C cv⁻¹
      have hf_mon : f.Monic := Polynomial.monic_mul_leadingCoeff_inv hu_ne
      have hg_mon : g.Monic := Polynomial.monic_mul_leadingCoeff_inv hv_ne
      have hcuv : cu * cv = 1 := by
        dsimp [cu, cv]
        rw [← Polynomial.leadingCoeff_mul, ← huv, hMon_L.leadingCoeff]
      have hfg : f * g = P_L := by
        dsimp [f, g]
        calc
          (u * Polynomial.C cu⁻¹) * (v * Polynomial.C cv⁻¹)
              = (u * v) * (Polynomial.C cu⁻¹ * Polynomial.C cv⁻¹) := by ring
          _ = (u * v) * Polynomial.C (cu⁻¹ * cv⁻¹) := by rw [← Polynomial.C_mul]
          _ = P_L * Polynomial.C ((cu * cv)⁻¹) := by
                rw [← mul_inv]
                exact congrArg (· * Polynomial.C ((cu * cv)⁻¹)) huv.symm
          _ = P_L := by rw [hcuv, inv_one, Polynomial.C_1, mul_one]
      obtain ⟨f₀, hf₀⟩ := hMon_descend f hf_mon ⟨g, hfg.symm⟩
      obtain ⟨g₀_p, hg₀_p⟩ := hMon_descend g hg_mon ⟨f, by rw [mul_comm, hfg]⟩
      have hf₀g₀ : P = f₀ * g₀_p := by
        apply Polynomial.map_injective _ hInj_EL
        rw [Polynomial.map_mul, hf₀, hg₀_p, hfg]
      rcases hIrr.isUnit_or_isUnit hf₀g₀ with hu₀ | hv₀
      · left
        have hfu : IsUnit f := by
          rw [← hf₀]
          exact hu₀.map (Polynomial.mapRingHom (algebraMap k_L L_r))
        have hu_eq : u = f * Polynomial.C cu := by
          dsimp [f]
          rw [mul_assoc, ← Polynomial.C_mul, inv_mul_cancel₀ hcu_ne, Polynomial.C_1, mul_one]
        rw [hu_eq]
        exact hfu.mul (Polynomial.isUnit_C.mpr hcu_ne.isUnit)
      · right
        have hgv : IsUnit g := by
          rw [← hg₀_p]
          exact hv₀.map (Polynomial.mapRingHom (algebraMap k_L L_r))
        have hv_eq : v = g * Polynomial.C cv := by
          dsimp [g]
          rw [mul_assoc, ← Polynomial.C_mul, inv_mul_cancel₀ hcv_ne, Polynomial.C_1, mul_one]
        rw [hv_eq]
        exact hgv.mul (Polynomial.isUnit_C.mpr hcv_ne.isUnit)
    rw [injective_iff_map_eq_zero]
    intro w hw0
    apply hInj_φBL
    rw [map_zero]
    set u : TensorProduct k_L L_r k := φ_BL w
    have hu0 : Ψ_tilde u = 0 := by
      rw [hΨ_tilde_comp w, hw0, map_zero]
    obtain ⟨S, hS⟩ := TensorProduct.exists_finset u
    let S_k : Finset k := S.image Prod.snd
    let K₀ : IntermediateField k_L k := IntermediateField.adjoin k_L (S_k : Set k)
    have hInt_Sk : ∀ x ∈ (S_k : Set k), _root_.IsIntegral k_L x :=
      fun x _ => (Algebra.IsAlgebraic.isIntegral (K := k_L) (A := k)).isIntegral x
    let _ : FiniteDimensional k_L ↥K₀ := IntermediateField.finiteDimensional_adjoin hInt_Sk
    have hmem_S : ∀ p ∈ S, p.2 ∈ K₀ := fun p hp =>
      IntermediateField.subset_adjoin k_L (S_k : Set k)
        (Finset.mem_coe.mpr (Finset.mem_image_of_mem Prod.snd hp))
    let u' : TensorProduct k_L L_r ↥K₀ :=
      ∑ p ∈ S.attach, TensorProduct.tmul k_L p.1.1 ⟨p.1.2, hmem_S p.1 p.2⟩
    let ι_K : TensorProduct k_L L_r ↥K₀ →ₐ[k_L] TensorProduct k_L L_r k :=
      Algebra.TensorProduct.map (AlgHom.id k_L L_r) K₀.val
    have hu_map : ι_K u' = u := by
      dsimp [u', ι_K]
      rw [map_sum, hS, ← Finset.sum_attach S]
      rfl
    obtain ⟨α, hα⟩ := Field.exists_primitive_element_of_finite_bot k_L ↥K₀
    have hα_int : _root_.IsIntegral k_L α := Algebra.IsIntegral.isIntegral α
    let P : Polynomial k_L := minpoly k_L α
    have hP_mon : P.Monic := minpoly.monic hα_int
    have hP_irr : Irreducible P := minpoly.irreducible hα_int
    let e_K : AdjoinRoot P ≃ₐ[k_L] ↥K₀ :=
      (IntermediateField.adjoinRootEquivAdjoin k_L hα_int).trans
        ((IntermediateField.equivOfEq hα).trans IntermediateField.topEquiv)
    let e_TP1 : TensorProduct k_L L_r ↥K₀ ≃ₐ[k_L] TensorProduct k_L L_r (AdjoinRoot P) :=
      Algebra.TensorProduct.congr (AlgEquiv.refl : L_r ≃ₐ[k_L] L_r) e_K.symm
    let P_L : Polynomial L_r := P.map (algebraMap k_L L_r)
    have hPL_irr : Irreducible P_L := hIrr_map P hP_mon hP_irr
    let _ : Fact (Irreducible P_L) := ⟨hPL_irr⟩
    let _ : Field (AdjoinRoot P_L) := inferInstance
    have hroot_PL : Polynomial.eval₂ ((AdjoinRoot.of P_L).comp (algebraMap k_L L_r))
        (AdjoinRoot.root P_L) P = 0 := by
      rw [← Polynomial.eval₂_map]
      exact AdjoinRoot.eval₂_root P_L
    let g_AR : AdjoinRoot P →+* AdjoinRoot P_L :=
      AdjoinRoot.lift ((AdjoinRoot.of P_L).comp (algebraMap k_L L_r))
        (AdjoinRoot.root P_L) hroot_PL
    obtain ⟨Φ_AR, hΦ_AR⟩ := liftRingHom k_L L_r (AdjoinRoot P) (AdjoinRoot P_L)
      (AdjoinRoot.of P_L) g_AR fun x => (AdjoinRoot.lift_of hroot_PL).symm
    have hroot_TP : Polynomial.eval₂ (algebraMap L_r (TensorProduct k_L L_r (AdjoinRoot P)))
        (TensorProduct.tmul k_L (1 : L_r) (AdjoinRoot.root P)) P_L = 0 := by
      let incR : AdjoinRoot P →+* TensorProduct k_L L_r (AdjoinRoot P) :=
        (Algebra.TensorProduct.includeRight :
          AdjoinRoot P →ₐ[k_L] TensorProduct k_L L_r (AdjoinRoot P)).toRingHom
      have htmul : TensorProduct.tmul k_L (1 : L_r) (AdjoinRoot.root P) =
          incR (AdjoinRoot.root P) := rfl
      dsimp [P_L]
      rw [Polynomial.eval₂_map]
      have hcomp_eq :
          (algebraMap L_r (TensorProduct k_L L_r (AdjoinRoot P))).comp (algebraMap k_L L_r) =
            incR.comp (AdjoinRoot.of P) := by
        ext x
        change TensorProduct.tmul k_L (algebraMap k_L L_r x) 1 =
          TensorProduct.tmul k_L 1 (algebraMap k_L (AdjoinRoot P) x)
        rw [Algebra.algebraMap_eq_smul_one (A := L_r),
          TensorProduct.smul_tmul x (1 : L_r) (1 : AdjoinRoot P),
          ← Algebra.algebraMap_eq_smul_one]
      rw [hcomp_eq, htmul, ← Polynomial.hom_eval₂, AdjoinRoot.eval₂_root P, map_zero]
    let Ψ_AR : AdjoinRoot P_L →+* TensorProduct k_L L_r (AdjoinRoot P) :=
      AdjoinRoot.lift (algebraMap L_r (TensorProduct k_L L_r (AdjoinRoot P)))
        (TensorProduct.tmul k_L (1 : L_r) (AdjoinRoot.root P)) hroot_TP
    have hΨΦ : ∀ v : TensorProduct k_L L_r (AdjoinRoot P), Ψ_AR (Φ_AR v) = v := by
      intro v
      refine TensorProduct.inductionOn (motive := fun v => Ψ_AR (Φ_AR v) = v) v ?_ ?_
      · intro l z
        rw [hΦ_AR l z, map_mul]
        have hl : Ψ_AR (AdjoinRoot.of P_L l) = TensorProduct.tmul k_L l 1 :=
          AdjoinRoot.lift_of hroot_TP
        have hz : Ψ_AR (g_AR z) = TensorProduct.tmul k_L 1 z := by
          have hhom_eq : Ψ_AR.comp g_AR =
              (Algebra.TensorProduct.includeRight :
                AdjoinRoot P →ₐ[k_L] TensorProduct k_L L_r (AdjoinRoot P)).toRingHom := by
            apply AdjoinRoot.ringHom_ext
            · ext x
              change Ψ_AR (g_AR (AdjoinRoot.of P x)) =
                TensorProduct.tmul k_L 1 (algebraMap k_L (AdjoinRoot P) x)
              dsimp only [Ψ_AR, g_AR]
              rw [AdjoinRoot.lift_of hroot_PL, RingHom.comp_apply, AdjoinRoot.lift_of hroot_TP]
              change TensorProduct.tmul k_L (algebraMap k_L L_r x) 1 =
                TensorProduct.tmul k_L 1 (algebraMap k_L (AdjoinRoot P) x)
              rw [Algebra.algebraMap_eq_smul_one (A := L_r),
                TensorProduct.smul_tmul x (1 : L_r) (1 : AdjoinRoot P),
                ← Algebra.algebraMap_eq_smul_one]
            · dsimp only [Ψ_AR, g_AR]
              rw [RingHom.comp_apply, AdjoinRoot.lift_root hroot_PL, AdjoinRoot.lift_root hroot_TP]
              rfl
          exact RingHom.congr_fun hhom_eq z
        rw [hl, hz, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      · intro x y hx hy
        rw [map_add, map_add, hx, hy]
    let χ : AdjoinRoot P_L →+* F_D :=
      Ψ_tilde.comp (ι_K.toRingHom.comp (e_TP1.symm.toRingHom.comp Ψ_AR))
    have hχ_zero : χ (Φ_AR (e_TP1 u')) = 0 := by
      change Ψ_tilde (ι_K (e_TP1.symm (Ψ_AR (Φ_AR (e_TP1 u'))))) = 0
      rw [hΨΦ, e_TP1.symm_apply_apply, hu_map, hu0]
    have hΦ_zero : Φ_AR (e_TP1 u') = 0 := χ.injective (hχ_zero.trans (map_zero χ).symm)
    have he_zero : e_TP1 u' = 0 := by
      rw [← hΨΦ (e_TP1 u'), hΦ_zero, map_zero]
    have hu'_zero : u' = 0 := e_TP1.injective (he_zero.trans (map_zero e_TP1).symm)
    rw [← hu_map, hu'_zero, map_zero]

  
  have hΨ₀_surj : Function.Surjective Ψ₀ := by
    let incL_Bk : B_r →+* T_Bk :=
      (Algebra.TensorProduct.includeLeft : B_r →ₐ[k_L] T_Bk).toRingHom
    let incR_Bk : k →+* T_Bk :=
      (Algebra.TensorProduct.includeRight : k →ₐ[k_L] T_Bk).toRingHom
    obtain ⟨φ_R0bar, hφ_R0bar⟩ := liftRingHom F R₀ k T_Bk
      (incL_Bk.comp (algebraMap R₀ B_r)) incR_Bk fun a => by
        rw [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply F R₀ B_r a,
          IsScalarTower.algebraMap_apply F k_L B_r a,
          IsScalarTower.algebraMap_apply F k_L k a]
        change TensorProduct.tmul k_L (algebraMap k_L B_r (algebraMap F k_L a)) 1 =
          TensorProduct.tmul k_L 1 (algebraMap k_L k (algebraMap F k_L a))
        rw [Algebra.algebraMap_eq_smul_one (A := B_r),
          TensorProduct.smul_tmul (algebraMap F k_L a) (1 : B_r) (1 : k),
          ← Algebra.algebraMap_eq_smul_one]
    let _ : Algebra R0_bar T_Bk := φ_R0bar.toAlgebra
    have hAlg_TBk : ∀ (z : R₀) (c : k),
        algebraMap R0_bar T_Bk (TensorProduct.tmul F z c) =
          TensorProduct.tmul k_L (algebraMap R₀ B_r z) c := by
      intro z c
      change φ_R0bar (TensorProduct.tmul F z c) = _
      rw [hφ_R0bar z c]
      change TensorProduct.tmul k_L (algebraMap R₀ B_r z) 1 * TensorProduct.tmul k_L 1 c = _
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    let Ψ_alg : T_Bk →ₐ[R0_bar] B_bar_r :=
      { Ψ₀ with
        commutes' := fun w => by
          refine TensorProduct.inductionOn
            (motive := fun w =>
              Ψ₀ (algebraMap R0_bar T_Bk w) = algebraMap R0_bar B_bar_r w) w ?_ ?_
          · intro z c
            rw [hAlg_TBk z c, hΨ₀_tmul, htmalg z c]
          · intro x y hx hy
            rw [map_add, map_add, map_add, hx, hy] }
    have hEt_TBk : Algebra.Etale R0_bar T_Bk := by
      let R_E := TensorProduct F R₀ k_L
      let _ : Algebra.Etale R₀ R_E := Algebra.Etale.baseChange F k_L R₀
      let ψ_E : R_E →ₐ[F] B_r :=
        Algebra.TensorProduct.lift
          (IsScalarTower.toAlgHom F R₀ B_r)
          (IsScalarTower.toAlgHom F k_L B_r)
          (fun _ _ => Commute.all _ _)
      let _ : Algebra R_E B_r := ψ_E.toRingHom.toAlgebra
      let _ : IsScalarTower R₀ R_E B_r :=
        IsScalarTower.of_algebraMap_eq fun z => by
          symm
          change ψ_E (TensorProduct.tmul F z (1 : k_L)) = algebraMap R₀ B_r z
          dsimp [ψ_E]
          rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one, IsScalarTower.toAlgHom_apply]
      let _ : Algebra.Etale R_E B_r := Algebra.Etale.of_restrictScalars R₀ R_E B_r
      let _ : Algebra R_E R0_bar :=
        (Algebra.TensorProduct.map (AlgHom.id F R₀)
          (IsScalarTower.toAlgHom F k_L k)).toRingHom.toAlgebra
      let _ : Algebra.Etale R0_bar (TensorProduct R_E R0_bar B_r) :=
        Algebra.Etale.baseChange R_E B_r R0_bar
      obtain ⟨Φ_bc_ring, hΦ_bc⟩ := liftRingHom R_E R0_bar B_r T_Bk
        (algebraMap R0_bar T_Bk) incL_Bk fun u => by
          refine TensorProduct.inductionOn
            (motive := fun u =>
              algebraMap R0_bar T_Bk (algebraMap R_E R0_bar u) = incL_Bk (ψ_E u)) u ?_ ?_
          · intro z y
            change algebraMap R0_bar T_Bk (TensorProduct.tmul F z (algebraMap k_L k y)) =
              TensorProduct.tmul k_L (algebraMap R₀ B_r z * algebraMap k_L B_r y) (1 : k)
            rw [hAlg_TBk z (algebraMap k_L k y), mul_comm (algebraMap R₀ B_r z),
              ← Algebra.smul_def, TensorProduct.smul_tmul y (algebraMap R₀ B_r z) (1 : k),
              Algebra.algebraMap_eq_smul_one (A := k)]
          · intro x y hx hy
            rw [map_add, map_add, map_add, map_add, hx, hy]
      let Φ_bc : TensorProduct R_E R0_bar B_r →ₐ[R0_bar] T_Bk :=
        { Φ_bc_ring with
          commutes' := fun rbar => by
            change Φ_bc_ring (TensorProduct.tmul R_E rbar 1) = algebraMap R0_bar T_Bk rbar
            rw [hΦ_bc rbar 1, map_one, mul_one] }
      let f_B_inv : B_r →+* TensorProduct R_E R0_bar B_r :=
        (Algebra.TensorProduct.includeRight : B_r →ₐ[R_E] TensorProduct R_E R0_bar B_r).toRingHom
      let f_k_inv : k →+* TensorProduct R_E R0_bar B_r :=
        (Algebra.TensorProduct.includeLeft :
          R0_bar →ₐ[R_E] TensorProduct R_E R0_bar B_r).toRingHom.comp
          (Algebra.TensorProduct.includeRight : k →ₐ[F] R0_bar).toRingHom
      obtain ⟨Ψ_bc, hΨ_bc⟩ := liftRingHom k_L B_r k (TensorProduct R_E R0_bar B_r)
        f_B_inv f_k_inv fun y => by
          change TensorProduct.tmul R_E (1 : R0_bar) (algebraMap k_L B_r y) =
            TensorProduct.tmul R_E
              (TensorProduct.tmul F (1 : R₀) (algebraMap k_L k y)) (1 : B_r)
          have h1 : algebraMap k_L B_r y =
              algebraMap R_E B_r (TensorProduct.tmul F (1 : R₀) y) := by
            change _ = ψ_E (TensorProduct.tmul F 1 y)
            dsimp [ψ_E]
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul, IsScalarTower.toAlgHom_apply]
          rw [h1, Algebra.algebraMap_eq_smul_one (A := B_r),
            ← TensorProduct.smul_tmul (TensorProduct.tmul F (1 : R₀) y) (1 : R0_bar) (1 : B_r),
            Algebra.smul_def, mul_one]
          rfl
      have h_left_inv : ∀ w : TensorProduct R_E R0_bar B_r, Ψ_bc (Φ_bc w) = w := by
        intro w
        refine TensorProduct.inductionOn
          (motive := fun w => Ψ_bc (Φ_bc w) = w) w ?_ ?_
        · intro rbar b
          refine TensorProduct.inductionOn
            (motive := fun rbar =>
              Ψ_bc (Φ_bc (TensorProduct.tmul R_E rbar b)) = TensorProduct.tmul R_E rbar b)
            rbar ?_ ?_
          · intro z c
            change Ψ_bc (Φ_bc_ring (TensorProduct.tmul R_E (TensorProduct.tmul F z c) b)) =
              TensorProduct.tmul R_E (TensorProduct.tmul F z c) b
            rw [hΦ_bc (TensorProduct.tmul F z c) b, hAlg_TBk z c]
            change Ψ_bc (TensorProduct.tmul k_L (algebraMap R₀ B_r z) c *
                TensorProduct.tmul k_L b 1) = _
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, hΨ_bc]
            change TensorProduct.tmul R_E (1 : R0_bar) (algebraMap R₀ B_r z * b) *
              TensorProduct.tmul R_E (TensorProduct.tmul F (1 : R₀) c) (1 : B_r) = _
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
            have hzb : algebraMap R₀ B_r z * b = (TensorProduct.tmul F z (1 : k_L) : R_E) • b := by
              rw [Algebra.smul_def]
              congr 1
              change _ = ψ_E (TensorProduct.tmul F z 1)
              dsimp [ψ_E]
              rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one, IsScalarTower.toAlgHom_apply]
            rw [hzb, ← TensorProduct.smul_tmul, Algebra.smul_def]
            change TensorProduct.tmul R_E
              (TensorProduct.tmul F z (algebraMap k_L k 1) * TensorProduct.tmul F (1 : R₀) c) b = _
            rw [map_one, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          · intro x y hx hy
            rw [TensorProduct.add_tmul, map_add, map_add, hx, hy]
        · intro x y hx hy
          rw [map_add, map_add, hx, hy]
      have h_right_inv : ∀ u : T_Bk, Φ_bc (Ψ_bc u) = u := by
        intro u
        refine TensorProduct.inductionOn (motive := fun u => Φ_bc (Ψ_bc u) = u) u ?_ ?_
        · intro b c
          rw [hΨ_bc b c]
          change Φ_bc_ring (TensorProduct.tmul R_E (1 : R0_bar) b *
              TensorProduct.tmul R_E (TensorProduct.tmul F (1 : R₀) c) (1 : B_r)) = _
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one, hΦ_bc, hAlg_TBk 1 c, map_one]
          change TensorProduct.tmul k_L 1 c * TensorProduct.tmul k_L b 1 = _
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
        · intro x y hx hy
          rw [map_add, map_add, hx, hy]
      let e_bc : TensorProduct R_E R0_bar B_r ≃ₐ[R0_bar] T_Bk :=
        { Φ_bc with
          invFun := Ψ_bc
          left_inv := h_left_inv
          right_inv := h_right_inv }
      exact Algebra.Etale.of_equiv e_bc
    let _ : Algebra.Etale R0_bar T_Bk := hEt_TBk
    let A₀ : Subalgebra R0_bar B_bar_r := Ψ_alg.range
    let e_A₀ : T_Bk ≃ₐ[R0_bar] ↥A₀ := AlgEquiv.ofInjective Ψ_alg hΨ₀_inj
    let _ : Algebra.Etale R0_bar ↥A₀ := Algebra.Etale.of_equiv e_A₀
    let _ : Algebra.Etale ↥A₀ B_bar_r := Algebra.Etale.of_restrictScalars R0_bar ↥A₀ B_bar_r
    let _ : Module.Finite ↥A₀ B_bar_r := Module.Finite.of_restrictScalars_finite R0_bar ↥A₀ B_bar_r
    let _ : Algebra.IsIntegral ↥A₀ B_bar_r := Algebra.IsIntegral.of_finite ↥A₀ B_bar_r
    have hInt_A₀ : (algebraMap ↥A₀ B_bar_r).IsIntegral := algebraMap_isIntegral_iff.mpr inferInstance
    have hComap_surj : Function.Surjective (PrimeSpectrum.comap (algebraMap ↥A₀ B_bar_r)) :=
      RingHom.IsIntegral.comap_surjective hInt_A₀ Subtype.val_injective
    let _ : Module.FaithfullyFlat ↥A₀ B_bar_r :=
      Module.FaithfullyFlat.of_comap_surjective hComap_surj
    let T₂ : Type u := TensorProduct ↥A₀ B_bar_r B_bar_r
    let f₁ : B_bar_r →+* T₂ :=
      (Algebra.TensorProduct.includeLeft : B_bar_r →ₐ[↥A₀] T₂).toRingHom
    let f₂ : B_bar_r →+* T₂ :=
      (Algebra.TensorProduct.includeRight : B_bar_r →ₐ[↥A₀] T₂).toRingHom
    have hf₁₂ : f₁ = f₂ := by
      refine hepi_Bbar f₁ f₂ (fun b => ?_) (fun c => ?_)
      · let a_b : ↥A₀ := ⟨q_B b, ⟨TensorProduct.tmul k_L b 1, by
          change Ψ₀ (TensorProduct.tmul k_L b 1) = q_B b
          rw [hΨ₀_tmul, map_one, mul_one]⟩⟩
        change (Algebra.TensorProduct.includeLeft : B_bar_r →ₐ[↥A₀] T₂) (algebraMap ↥A₀ B_bar_r a_b) =
          (Algebra.TensorProduct.includeRight : B_bar_r →ₐ[↥A₀] T₂) (algebraMap ↥A₀ B_bar_r a_b)
        rw [AlgHom.commutes, AlgHom.commutes]
      · let a_c : ↥A₀ := ⟨q_k c, ⟨TensorProduct.tmul k_L 1 c, by
          change Ψ₀ (TensorProduct.tmul k_L 1 c) = q_k c
          rw [hΨ₀_tmul, map_one, one_mul]⟩⟩
        change (Algebra.TensorProduct.includeLeft : B_bar_r →ₐ[↥A₀] T₂) (algebraMap ↥A₀ B_bar_r a_c) =
          (Algebra.TensorProduct.includeRight : B_bar_r →ₐ[↥A₀] T₂) (algebraMap ↥A₀ B_bar_r a_c)
        rw [AlgHom.commutes, AlgHom.commutes]
    let M₀ : Submodule ↥A₀ B_bar_r := 1
    let π : B_bar_r →ₗ[↥A₀] (B_bar_r ⧸ M₀) := Submodule.mkQ M₀
    have hπ1 : π 1 = 0 := by
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact Submodule.mem_one.mpr ⟨1, map_one _⟩
    have hlT_zero : LinearMap.lTensor B_bar_r π = 0 := by
      refine TensorProduct.ext' fun y x => ?_
      have hswap : TensorProduct.tmul ↥A₀ (1 : B_bar_r) x =
          TensorProduct.tmul ↥A₀ x (1 : B_bar_r) :=
        RingHom.congr_fun hf₁₂.symm x
      have hyx : TensorProduct.tmul ↥A₀ y x =
          TensorProduct.tmul ↥A₀ (y * x) (1 : B_bar_r) := by
        calc
          TensorProduct.tmul ↥A₀ y x
              = TensorProduct.tmul ↥A₀ y 1 * TensorProduct.tmul ↥A₀ 1 x := by
                rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          _ = TensorProduct.tmul ↥A₀ y 1 * TensorProduct.tmul ↥A₀ x 1 := by rw [hswap]
          _ = TensorProduct.tmul ↥A₀ (y * x) 1 := by
                rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
      rw [hyx, LinearMap.lTensor_tmul, hπ1, TensorProduct.tmul_zero, LinearMap.zero_apply]
    have hπ_zero : π = 0 :=
      (Module.FaithfullyFlat.zero_iff_lTensor_zero ↥A₀ B_bar_r π).mpr hlT_zero
    intro x
    have hx0 : π x = 0 := by rw [hπ_zero, LinearMap.zero_apply]
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hx0
    obtain ⟨a, ha⟩ := Submodule.mem_one.mp hx0
    obtain ⟨u, hu⟩ := a.2
    exact ⟨u, hu.trans ha⟩

  let ψ_Bk : TensorProduct k_L B_r k ≃+* B_bar_r :=
    RingEquiv.ofBijective Ψ₀ ⟨hΨ₀_inj, hΨ₀_surj⟩
  refine ⟨ψ_Bk, hΨ₀_tmul, ?_⟩
  intro γ σ f hγσ hf u
  have hγ_qk : ∀ c : k, γ (q_k c) = q_k c := by
    intro c
    have h1 := htmalg 1 c
    rw [map_one, map_one, one_mul] at h1
    rw [← h1]
    exact γ.commutes (TensorProduct.tmul F 1 c)
  refine TensorProduct.inductionOn (motive := fun u => γ (ψ_Bk u) = ψ_Bk (f u)) u ?_ ?_
  · intro b c
    change γ (Ψ₀ (TensorProduct.tmul k_L b c)) = Ψ₀ (f (TensorProduct.tmul k_L b c))
    rw [hΨ₀_tmul, map_mul, hγσ b, hγ_qk c, hf b c, hΨ₀_tmul]
  · intro x y hx hy
    rw [map_add, map_add, map_add, map_add, hx, hy]

theorem weil_etale_pullback_iso_of_local_lift_and_zero_descent (D S : AlgebraicGeometry.Scheme.{u})
    (pr : Quiver.Hom S D)
    (hCont_pr : (weilEtaleSitePullback pr).IsContinuous
      D.smallEtaleTopology S.smallEtaleTopology)
    (hAdj_pr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback pr) AddCommGrpCat.{u} _
      D.smallEtaleTopology S.smallEtaleTopology hCont_pr).IsRightAdjoint)
    (hMem_S : ∀ (W : S.Etale) (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left,
          ∃ (Y : S.Etale) (f : Y ⟶ W)
            (y : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y).left),
            R.arrows f ∧
            AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget S).map f).left ∧
            ((AlgebraicGeometry.Scheme.Etale.forget S).map f).left.base y = x)
    (ℱ₀ : CategoryTheory.Sheaf D.smallEtaleTopology AddCommGrpCat.{u})
    (ℳ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
    (η : Quiver.Hom ℱ₀
      ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback pr) AddCommGrpCat.{u} _
        D.smallEtaleTopology S.smallEtaleTopology hCont_pr).obj ℳ))
    (hLocalLift : ∀ (W : S.Etale) (s : ↑(ℳ.obj.obj (Opposite.op W)))
        (x : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left),
      ∃ (W' : S.Etale) (u : Quiver.Hom W' W)
        (x' : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj W').left)
        (W₀ : D.Etale) (q : Quiver.Hom W' ((weilEtaleSitePullback pr).obj W₀))
        (s₀ : ↑(ℱ₀.obj.obj (Opposite.op W₀))),
        AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget S).map u).left ∧
        ((AlgebraicGeometry.Scheme.Etale.forget S).map u).left.base x' = x ∧
        (ℳ.obj.map (Opposite.op u)).hom s =
          (ℳ.obj.map (Opposite.op q)).hom ((η.hom.app (Opposite.op W₀)).hom s₀))
    (hLocalZero : ∀ (W₀ : D.Etale) (s₀ : ↑(ℱ₀.obj.obj (Opposite.op W₀)))
        (Z : S.Etale) (q : Quiver.Hom Z ((weilEtaleSitePullback pr).obj W₀)),
      (ℳ.obj.map (Opposite.op q)).hom ((η.hom.app (Opposite.op W₀)).hom s₀) = 0 →
      ∀ z : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Z).left,
        ∃ (Z' : S.Etale) (v : Quiver.Hom Z' Z)
          (z' : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Z').left)
          (W₀' : D.Etale) (u₀ : Quiver.Hom W₀' W₀)
          (q' : Quiver.Hom Z' ((weilEtaleSitePullback pr).obj W₀')),
          AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ∧
          ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left.base z' = z ∧
          CategoryTheory.CategoryStruct.comp v q =
            CategoryTheory.CategoryStruct.comp q' ((weilEtaleSitePullback pr).map u₀) ∧
          (ℱ₀.obj.map (Opposite.op u₀)).hom s₀ = 0) :
    let B_pr := weilEtaleSitePullback pr
    let adj_pr := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
      B_pr AddCommGrpCat.{u} _ D.smallEtaleTopology S.smallEtaleTopology hCont_pr hAdj_pr
    CategoryTheory.IsIso ((adj_pr.homEquiv ℱ₀ ℳ).symm η) :=
by
  classical
  intro B_pr adj_pr
  let R_pr := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
    B_pr AddCommGrpCat.{u} _ D.smallEtaleTopology S.smallEtaleTopology hCont_pr
  let L_pr := @CategoryTheory.Functor.sheafPullback _ _ _ _
    B_pr AddCommGrpCat.{u} _ D.smallEtaleTopology S.smallEtaleTopology hCont_pr hAdj_pr

  
  let pushHom : ∀ {𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}},
      Quiver.Hom ℱ₀ (R_pr.obj 𝒢) → ∀ (W₀ : D.Etale),
        ↑(ℱ₀.obj.obj (Opposite.op W₀)) →+ ↑(𝒢.obj.obj (Opposite.op (B_pr.obj W₀))) :=
    fun {𝒢} γ W₀ =>
      (γ.hom.app (Opposite.op W₀) :
        ℱ₀.obj.obj (Opposite.op W₀) ⟶ 𝒢.obj.obj (Opposite.op (B_pr.obj W₀))).hom

  have hMapComp : ∀ {C_cat : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C_cat]
      (P_pre : CategoryTheory.Functor (Opposite C_cat) AddCommGrpCat.{u})
      {X Y Z : C_cat} (g : X ⟶ Y) (f : Y ⟶ Z) (s : ↑(P_pre.obj (Opposite.op Z))),
      (P_pre.map (Opposite.op (g ≫ f))).hom s =
        (P_pre.map (Opposite.op g)).hom ((P_pre.map (Opposite.op f)).hom s) := by
    intro C_cat _ P_pre X Y Z g f s
    change (P_pre.map ((g ≫ f).op)).hom s = _
    rw [CategoryTheory.op_comp, P_pre.map_comp]
    rfl

  have hMapId : ∀ {C_cat : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C_cat]
      (P_pre : CategoryTheory.Functor (Opposite C_cat) AddCommGrpCat.{u})
      (X : C_cat) (s : ↑(P_pre.obj (Opposite.op X))),
      (P_pre.map (Opposite.op (𝟙 X))).hom s = s := by
    intro C_cat _ P_pre X s
    have hid : Opposite.op (𝟙 X) = 𝟙 (Opposite.op X) := rfl
    rw [hid, P_pre.map_id]
    rfl

  have hPushNat : ∀ {𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (γ : Quiver.Hom ℱ₀ (R_pr.obj 𝒢))
      {W₀' W₀ : D.Etale} (u₀ : W₀' ⟶ W₀) (s₀ : ↑(ℱ₀.obj.obj (Opposite.op W₀))),
      pushHom γ W₀' ((ℱ₀.obj.map (Opposite.op u₀)).hom s₀) =
        (𝒢.obj.map (Opposite.op (B_pr.map u₀))).hom (pushHom γ W₀ s₀) := by
    intro 𝒢 γ W₀' W₀ u₀ s₀
    have hnat := γ.hom.naturality (Opposite.op u₀)
    exact congrArg (fun m => m.hom s₀) hnat

  
  have hRoof : ∀ (W₁ W₂ : D.Etale) (Z : S.Etale)
      (q₁ : Quiver.Hom Z (B_pr.obj W₁)) (q₂ : Quiver.Hom Z (B_pr.obj W₂)),
      ∃ (W₁₂ : D.Etale) (p₁ : Quiver.Hom W₁₂ W₁) (p₂ : Quiver.Hom W₁₂ W₂)
        (q₁₂ : Quiver.Hom Z (B_pr.obj W₁₂)),
        CategoryTheory.CategoryStruct.comp q₁₂ (B_pr.map p₁) = q₁ ∧
        CategoryTheory.CategoryStruct.comp q₁₂ (B_pr.map p₂) = q₂ := by
    have hTerm : ∀ X : AlgebraicGeometry.Scheme.{u},
        CategoryTheory.Limits.IsTerminal (AlgebraicGeometry.Scheme.Etale.mk (𝟙 X)) := by
      intro X
      refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun W => CategoryTheory.MorphismProperty.Over.homMk W.hom
          (CategoryTheory.Category.comp_id W.hom) trivial) ?_
      intro W m
      exact CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id m.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w m))
        (Subsingleton.elim _ _)
    have : CategoryTheory.Limits.HasTerminal D.Etale := (hTerm D).hasTerminal
    have : CategoryTheory.Limits.HasTerminal S.Etale := (hTerm S).hasTerminal
    have : CategoryTheory.Limits.HasFiniteLimits D.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have : CategoryTheory.Limits.HasFiniteLimits S.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have : P_et.HasPullbacksAlong pr :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : P_et.IsStableUnderBaseChangeAlong pr :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    have : CategoryTheory.Limits.PreservesFiniteLimits B_pr :=
      CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback P_et pr
    intro W₁ W₂ Z q₁ q₂
    refine ⟨CategoryTheory.Limits.prod W₁ W₂,
      CategoryTheory.Limits.prod.fst,
      CategoryTheory.Limits.prod.snd,
      CategoryTheory.Limits.prod.lift q₁ q₂ ≫
        (CategoryTheory.Limits.PreservesLimitPair.iso B_pr W₁ W₂).inv,
      ?_, ?_⟩
    · rw [CategoryTheory.Category.assoc,
        CategoryTheory.Limits.PreservesLimitPair.iso_inv_fst,
        CategoryTheory.Limits.prod.lift_fst]
    · rw [CategoryTheory.Category.assoc,
        CategoryTheory.Limits.PreservesLimitPair.iso_inv_snd,
        CategoryTheory.Limits.prod.lift_snd]

  
  have hSepExt : ∀ (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (W : S.Etale) (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W →
      ∀ (t₁ t₂ : ↑(𝒢.obj.obj (Opposite.op W))),
        (∀ {Y : S.Etale} (f : Y ⟶ W), R.arrows f →
          (𝒢.obj.map (Opposite.op f)).hom t₁ = (𝒢.obj.map (Opposite.op f)).hom t₂) →
        t₁ = t₂ := by
    intro 𝒢 W R hR t₁ t₂ hEq
    have hSh := CategoryTheory.GrothendieckTopology.HasSheafCompose.isSheaf
      (F := CategoryTheory.forget AddCommGrpCat.{u}) 𝒢.obj 𝒢.property
    exact (hSh.isSheafFor R hR).isSeparatedFor.ext (fun Y f hf => hEq f hf)

  
  have hZeroTransfer : ∀ (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (β : Quiver.Hom ℱ₀ (R_pr.obj 𝒢))
      (W₀ : D.Etale) (s₀ : ↑(ℱ₀.obj.obj (Opposite.op W₀)))
      (Z : S.Etale) (q : Quiver.Hom Z (B_pr.obj W₀)),
      (ℳ.obj.map (Opposite.op q)).hom (pushHom η W₀ s₀) = 0 →
      (𝒢.obj.map (Opposite.op q)).hom (pushHom β W₀ s₀) = 0 := by
    intro 𝒢 β W₀ s₀ Z q hq_zero
    set t : ↑(𝒢.obj.obj (Opposite.op Z)) :=
      (𝒢.obj.map (Opposite.op q)).hom (pushHom β W₀ s₀)
    let R_Z : CategoryTheory.Sieve Z :=
      { arrows := fun {Y} g => (𝒢.obj.map (Opposite.op g)).hom t = 0
        downward_closed := by
          intro Y W g hg w
          change (𝒢.obj.map (Opposite.op (w ≫ g))).hom t = 0
          rw [hMapComp 𝒢.obj w g t, hg, map_zero] }
    have hR_Z : R_Z ∈ S.smallEtaleTopology Z := by
      rw [hMem_S Z R_Z]
      intro z
      obtain ⟨Z', v, z', W₀', u₀, q', hv_et, hz', hvq, hs₀_zero⟩ :=
        hLocalZero W₀ s₀ Z q hq_zero z
      refine ⟨Z', v, z', ?_, hv_et, hz'⟩
      show (𝒢.obj.map (Opposite.op v)).hom t = 0
      dsimp only [t]
      rw [← hMapComp 𝒢.obj v q (pushHom β W₀ s₀)]
      change (𝒢.obj.map (Opposite.op (v ≫ q))).hom (pushHom β W₀ s₀) = 0
      rw [hvq, hMapComp 𝒢.obj q' (B_pr.map u₀) (pushHom β W₀ s₀),
        ← hPushNat β u₀ s₀, hs₀_zero, map_zero, map_zero]
    exact hSepExt 𝒢 Z R_Z hR_Z t 0 (fun {Y} g hg => by rw [map_zero]; exact hg)

  have hOverlap : ∀ (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (β : Quiver.Hom ℱ₀ (R_pr.obj 𝒢))
      (W₁ W₂ : D.Etale)
      (s₁ : ↑(ℱ₀.obj.obj (Opposite.op W₁)))
      (s₂ : ↑(ℱ₀.obj.obj (Opposite.op W₂)))
      (Z : S.Etale)
      (q₁ : Quiver.Hom Z (B_pr.obj W₁))
      (q₂ : Quiver.Hom Z (B_pr.obj W₂)),
      (ℳ.obj.map (Opposite.op q₁)).hom (pushHom η W₁ s₁) =
        (ℳ.obj.map (Opposite.op q₂)).hom (pushHom η W₂ s₂) →
      (𝒢.obj.map (Opposite.op q₁)).hom (pushHom β W₁ s₁) =
        (𝒢.obj.map (Opposite.op q₂)).hom (pushHom β W₂ s₂) := by
    intro 𝒢 β W₁ W₂ s₁ s₂ Z q₁ q₂ h_eq
    obtain ⟨W₁₂, p₁, p₂, q₁₂, hq₁, hq₂⟩ := hRoof W₁ W₂ Z q₁ q₂
    let s₁₂ : ↑(ℱ₀.obj.obj (Opposite.op W₁₂)) :=
      (ℱ₀.obj.map (Opposite.op p₁)).hom s₁ - (ℱ₀.obj.map (Opposite.op p₂)).hom s₂
    have hDiff : ∀ {H_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (γ : Quiver.Hom ℱ₀ (R_pr.obj H_sh)),
        (H_sh.obj.map (Opposite.op q₁₂)).hom (pushHom γ W₁₂ s₁₂) =
          (H_sh.obj.map (Opposite.op q₁)).hom (pushHom γ W₁ s₁) -
            (H_sh.obj.map (Opposite.op q₂)).hom (pushHom γ W₂ s₂) := by
      intro H_sh γ
      dsimp only [s₁₂]
      rw [map_sub, map_sub, hPushNat γ p₁ s₁, hPushNat γ p₂ s₂,
        ← hMapComp H_sh.obj q₁₂ (B_pr.map p₁), ← hMapComp H_sh.obj q₁₂ (B_pr.map p₂), hq₁, hq₂]
    have hq₁₂_zero :
        (ℳ.obj.map (Opposite.op q₁₂)).hom (pushHom η W₁₂ s₁₂) = 0 := by
      rw [hDiff η, sub_eq_zero]
      exact h_eq
    have hβ_zero := hZeroTransfer 𝒢 β W₁₂ s₁₂ Z q₁₂ hq₁₂_zero
    rw [hDiff β, sub_eq_zero] at hβ_zero
    exact hβ_zero

  
  let R_lift : ∀ (W : S.Etale), ↑(ℳ.obj.obj (Opposite.op W)) → CategoryTheory.Sieve W :=
    fun W s =>
      { arrows := fun {Y} f =>
          ∃ (W₀ : D.Etale) (q : Quiver.Hom Y (B_pr.obj W₀))
            (s₀ : ↑(ℱ₀.obj.obj (Opposite.op W₀))),
            (ℳ.obj.map (Opposite.op f)).hom s =
              (ℳ.obj.map (Opposite.op q)).hom (pushHom η W₀ s₀)
        downward_closed := by
          rintro Y Z f ⟨W₀, q, s₀, hf⟩ g
          refine ⟨W₀, g ≫ q, s₀, ?_⟩
          rw [hMapComp ℳ.obj g f s, hf, ← hMapComp ℳ.obj g q (pushHom η W₀ s₀)] }

  have hR_lift : ∀ (W : S.Etale) (s : ↑(ℳ.obj.obj (Opposite.op W))),
      R_lift W s ∈ S.smallEtaleTopology W := by
    intro W s
    rw [hMem_S W (R_lift W s)]
    intro x
    obtain ⟨W', u, x', W₀, q, s₀, hu_et, hx', hs_eq⟩ := hLocalLift W s x
    exact ⟨W', u, x', ⟨W₀, q, s₀, hs_eq⟩, hu_et, hx'⟩

  have hHomExt : ∀ (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (α₁ α₂ : Quiver.Hom ℳ 𝒢),
      CategoryTheory.CategoryStruct.comp η (R_pr.map α₁) =
        CategoryTheory.CategoryStruct.comp η (R_pr.map α₂) →
      α₁ = α₂ := by
    intro 𝒢 α₁ α₂ h_eq
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext opW
    rcases opW with ⟨W⟩
    ext s
    refine hSepExt 𝒢 W (R_lift W s) (hR_lift W s) _ _ ?_
    rintro Y f ⟨W₀, q, s₀, hf⟩
    have hEval : ∀ α : Quiver.Hom ℳ 𝒢,
        (𝒢.obj.map (Opposite.op f)).hom ((α.hom.app (Opposite.op W)).hom s) =
          (𝒢.obj.map (Opposite.op q)).hom (pushHom (η ≫ R_pr.map α) W₀ s₀) := by
      intro α
      have hnat_f := congrArg (fun m => m.hom s) (α.hom.naturality (Opposite.op f)).symm
      have hnat_q := congrArg (fun m => m.hom (pushHom η W₀ s₀))
        (α.hom.naturality (Opposite.op q))
      exact hnat_f.trans ((congrArg (α.hom.app (Opposite.op Y)).hom hf).trans hnat_q)
    rw [hEval α₁, hEval α₂, h_eq]

  have hHomLift : ∀ (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (β : Quiver.Hom ℱ₀ (R_pr.obj 𝒢)),
      ∃ α : Quiver.Hom ℳ 𝒢,
        CategoryTheory.CategoryStruct.comp η (R_pr.map α) = β := by
    intro 𝒢 β
    let F_G := 𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    have hSh_G : CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology F_G :=
      CategoryTheory.GrothendieckTopology.HasSheafCompose.isSheaf
        (F := CategoryTheory.forget AddCommGrpCat.{u}) 𝒢.obj 𝒢.property
    let fam : ∀ (W : S.Etale) (s : ↑(ℳ.obj.obj (Opposite.op W))),
        CategoryTheory.Presieve.FamilyOfElements F_G (R_lift W s).arrows :=
      fun W s Y f hf =>
        let W₀ := Classical.choose hf
        let q := Classical.choose (Classical.choose_spec hf)
        let s₀ := Classical.choose (Classical.choose_spec (Classical.choose_spec hf))
        (𝒢.obj.map (Opposite.op q)).hom (pushHom β W₀ s₀)
    have hCompat : ∀ (W : S.Etale) (s : ↑(ℳ.obj.obj (Opposite.op W))),
        (fam W s).Compatible := by
      intro W s Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hgf
      let W₁ := Classical.choose h₁
      let q₁ := Classical.choose (Classical.choose_spec h₁)
      let s₁ := Classical.choose (Classical.choose_spec (Classical.choose_spec h₁))
      have hs₁ : (ℳ.obj.map (Opposite.op f₁)).hom s =
          (ℳ.obj.map (Opposite.op q₁)).hom (pushHom η W₁ s₁) :=
        Classical.choose_spec (Classical.choose_spec (Classical.choose_spec h₁))
      let W₂ := Classical.choose h₂
      let q₂ := Classical.choose (Classical.choose_spec h₂)
      let s₂ := Classical.choose (Classical.choose_spec (Classical.choose_spec h₂))
      have hs₂ : (ℳ.obj.map (Opposite.op f₂)).hom s =
          (ℳ.obj.map (Opposite.op q₂)).hom (pushHom η W₂ s₂) :=
        Classical.choose_spec (Classical.choose_spec (Classical.choose_spec h₂))
      have hη_eq :
          (ℳ.obj.map (Opposite.op (g₁ ≫ q₁))).hom (pushHom η W₁ s₁) =
            (ℳ.obj.map (Opposite.op (g₂ ≫ q₂))).hom (pushHom η W₂ s₂) :=
        (hMapComp ℳ.obj g₁ q₁ (pushHom η W₁ s₁)).trans
          ((congrArg (ℳ.obj.map (Opposite.op g₁)).hom hs₁.symm).trans
            ((hMapComp ℳ.obj g₁ f₁ s).symm.trans
              ((congrArg (fun k => (ℳ.obj.map (Opposite.op k)).hom s) hgf).trans
                ((hMapComp ℳ.obj g₂ f₂ s).trans
                  ((congrArg (ℳ.obj.map (Opposite.op g₂)).hom hs₂).trans
                    (hMapComp ℳ.obj g₂ q₂ (pushHom η W₂ s₂)).symm)))))
      have hβ_eq := hOverlap 𝒢 β W₁ W₂ s₁ s₂ Z (g₁ ≫ q₁) (g₂ ≫ q₂) hη_eq
      rw [hMapComp 𝒢.obj g₁ q₁ (pushHom β W₁ s₁),
        hMapComp 𝒢.obj g₂ q₂ (pushHom β W₂ s₂)] at hβ_eq
      exact hβ_eq
    let α_fn : ∀ (W : S.Etale), ↑(ℳ.obj.obj (Opposite.op W)) → ↑(𝒢.obj.obj (Opposite.op W)) :=
      fun W s => (hSh_G.isSheafFor (R_lift W s) (hR_lift W s)).amalgamate
        (fam W s) (hCompat W s)
    have hα_char : ∀ (W : S.Etale) (s : ↑(ℳ.obj.obj (Opposite.op W)))
        {Y : S.Etale} (f : Y ⟶ W)
        (W₀ : D.Etale) (q : Quiver.Hom Y (B_pr.obj W₀))
        (s₀ : ↑(ℱ₀.obj.obj (Opposite.op W₀))),
        (ℳ.obj.map (Opposite.op f)).hom s =
          (ℳ.obj.map (Opposite.op q)).hom (pushHom η W₀ s₀) →
        (𝒢.obj.map (Opposite.op f)).hom (α_fn W s) =
          (𝒢.obj.map (Opposite.op q)).hom (pushHom β W₀ s₀) := by
      intro W s Y f W₀ q s₀ h_eq
      let hf : (R_lift W s).arrows f := ⟨W₀, q, s₀, h_eq⟩
      have hglue : (𝒢.obj.map (Opposite.op f)).hom (α_fn W s) = fam W s f hf :=
        (hSh_G.isSheafFor (R_lift W s) (hR_lift W s)).valid_glue (hCompat W s) f hf
      let W_ch := Classical.choose hf
      let q_ch := Classical.choose (Classical.choose_spec hf)
      let s_ch := Classical.choose (Classical.choose_spec (Classical.choose_spec hf))
      have hs_ch : (ℳ.obj.map (Opposite.op f)).hom s =
          (ℳ.obj.map (Opposite.op q_ch)).hom (pushHom η W_ch s_ch) :=
        Classical.choose_spec (Classical.choose_spec (Classical.choose_spec hf))
      exact hglue.trans (hOverlap 𝒢 β W_ch W₀ s_ch s₀ Y q_ch q (hs_ch.symm.trans h_eq))
    have h_add : ∀ (W : S.Etale) (s₁ s₂ : ↑(ℳ.obj.obj (Opposite.op W))),
        α_fn W (s₁ + s₂) = α_fn W s₁ + α_fn W s₂ := by
      intro W s₁ s₂
      let R₁₂ := R_lift W s₁ ⊓ R_lift W s₂
      have hR₁₂ : R₁₂ ∈ S.smallEtaleTopology W :=
        S.smallEtaleTopology.intersection_covering (hR_lift W s₁) (hR_lift W s₂)
      refine hSepExt 𝒢 W R₁₂ hR₁₂ _ _ ?_
      rintro Y f ⟨⟨W₁, q₁, t₁, ht₁⟩, ⟨W₂, q₂, t₂, ht₂⟩⟩
      obtain ⟨W₁₂, p₁, p₂, q₁₂, hq₁, hq₂⟩ := hRoof W₁ W₂ Y q₁ q₂
      let t₁₂ : ↑(ℱ₀.obj.obj (Opposite.op W₁₂)) :=
        (ℱ₀.obj.map (Opposite.op p₁)).hom t₁ + (ℱ₀.obj.map (Opposite.op p₂)).hom t₂
      have ht₁₂_η : (ℳ.obj.map (Opposite.op f)).hom (s₁ + s₂) =
          (ℳ.obj.map (Opposite.op q₁₂)).hom (pushHom η W₁₂ t₁₂) := by
        dsimp only [t₁₂]
        rw [map_add, ht₁, ht₂, map_add, map_add, hPushNat η p₁ t₁, hPushNat η p₂ t₂,
          ← hMapComp ℳ.obj q₁₂ (B_pr.map p₁) (pushHom η W₁ t₁),
          ← hMapComp ℳ.obj q₁₂ (B_pr.map p₂) (pushHom η W₂ t₂), hq₁, hq₂]
      calc
        (𝒢.obj.map (Opposite.op f)).hom (α_fn W (s₁ + s₂))
          = (𝒢.obj.map (Opposite.op q₁₂)).hom (pushHom β W₁₂ t₁₂) :=
            hα_char W (s₁ + s₂) f W₁₂ q₁₂ t₁₂ ht₁₂_η
        _ = (𝒢.obj.map (Opposite.op q₁)).hom (pushHom β W₁ t₁) +
              (𝒢.obj.map (Opposite.op q₂)).hom (pushHom β W₂ t₂) := by
            dsimp only [t₁₂]
            rw [map_add, map_add, hPushNat β p₁ t₁, hPushNat β p₂ t₂,
              ← hMapComp 𝒢.obj q₁₂ (B_pr.map p₁) (pushHom β W₁ t₁),
              ← hMapComp 𝒢.obj q₁₂ (B_pr.map p₂) (pushHom β W₂ t₂), hq₁, hq₂]
        _ = (𝒢.obj.map (Opposite.op f)).hom (α_fn W s₁) +
              (𝒢.obj.map (Opposite.op f)).hom (α_fn W s₂) := by
            rw [hα_char W s₁ f W₁ q₁ t₁ ht₁, hα_char W s₂ f W₂ q₂ t₂ ht₂]
        _ = (𝒢.obj.map (Opposite.op f)).hom (α_fn W s₁ + α_fn W s₂) :=
            (map_add (𝒢.obj.map (Opposite.op f)).hom _ _).symm
    have h_zero : ∀ (W : S.Etale), α_fn W 0 = 0 := by
      intro W
      have h00 := h_add W 0 0
      rw [zero_add] at h00
      exact add_left_cancel (h00.symm.trans (add_zero (α_fn W 0)).symm)
    let α_app : ∀ opW : Opposite S.Etale, ℳ.obj.obj opW ⟶ 𝒢.obj.obj opW :=
      fun opW => AddCommGrpCat.ofHom
        { toFun := α_fn (Opposite.unop opW)
          map_zero' := h_zero (Opposite.unop opW)
          map_add' := h_add (Opposite.unop opW) }
    have h_nat : ∀ {X Y : Opposite S.Etale} (φ : X ⟶ Y),
        ℳ.obj.map φ ≫ α_app Y = α_app X ≫ 𝒢.obj.map φ := by
      intro opW₂ opW₁ φ
      rcases opW₁ with ⟨W₁⟩
      rcases opW₂ with ⟨W₂⟩
      let u : W₁ ⟶ W₂ := φ.unop
      have hφ : φ = Opposite.op u := rfl
      rw [hφ]
      ext s
      change α_fn W₁ ((ℳ.obj.map (Opposite.op u)).hom s) =
        (𝒢.obj.map (Opposite.op u)).hom (α_fn W₂ s)
      let su := (ℳ.obj.map (Opposite.op u)).hom s
      refine hSepExt 𝒢 W₁ (R_lift W₁ su) (hR_lift W₁ su) _ _ ?_
      rintro Y f ⟨W₀, q, s₀, hfu⟩
      have hLHS := hα_char W₁ su f W₀ q s₀ hfu
      have hfu_comp : (ℳ.obj.map (Opposite.op (f ≫ u))).hom s =
          (ℳ.obj.map (Opposite.op q)).hom (pushHom η W₀ s₀) := by
        rw [hMapComp ℳ.obj f u s]
        exact hfu
      have hRHS := hα_char W₂ s (f ≫ u) W₀ q s₀ hfu_comp
      rw [hMapComp 𝒢.obj f u (α_fn W₂ s)] at hRHS
      exact hLHS.trans hRHS.symm
    let α : Quiver.Hom ℳ 𝒢 := ⟨{ app := α_app, naturality := fun _ _ φ => h_nat φ }⟩
    refine ⟨α, ?_⟩
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext opW₀
    rcases opW₀ with ⟨W₀⟩
    ext s₀
    change α_fn (B_pr.obj W₀) (pushHom η W₀ s₀) = pushHom β W₀ s₀
    have hid := hα_char (B_pr.obj W₀) (pushHom η W₀ s₀)
      (𝟙 (B_pr.obj W₀)) W₀ (𝟙 (B_pr.obj W₀)) s₀ rfl
    rw [hMapId 𝒢.obj (B_pr.obj W₀), hMapId 𝒢.obj (B_pr.obj W₀)] at hid
    exact hid

  
  let ψ : L_pr.obj ℱ₀ ⟶ ℳ := (adj_pr.homEquiv ℱ₀ ℳ).symm η
  have hψ_unit : adj_pr.unit.app ℱ₀ ≫ R_pr.map ψ = η := by
    rw [← CategoryTheory.Adjunction.homEquiv_unit adj_pr ℱ₀ ℳ ψ]
    exact (adj_pr.homEquiv ℱ₀ ℳ).apply_symm_apply η
  obtain ⟨ψ_inv, hψ_inv⟩ := hHomLift (L_pr.obj ℱ₀) (adj_pr.unit.app ℱ₀)
  have h_left : ψ ≫ ψ_inv = 𝟙 (L_pr.obj ℱ₀) := by
    apply (adj_pr.homEquiv ℱ₀ (L_pr.obj ℱ₀)).injective
    calc
      adj_pr.homEquiv ℱ₀ (L_pr.obj ℱ₀) (ψ ≫ ψ_inv)
        = adj_pr.unit.app ℱ₀ ≫ R_pr.map (ψ ≫ ψ_inv) :=
          CategoryTheory.Adjunction.homEquiv_unit adj_pr ℱ₀ (L_pr.obj ℱ₀) (ψ ≫ ψ_inv)
      _ = (adj_pr.unit.app ℱ₀ ≫ R_pr.map ψ) ≫ R_pr.map ψ_inv := by
          rw [R_pr.map_comp]
          exact (CategoryTheory.Category.assoc _ _ _).symm
      _ = η ≫ R_pr.map ψ_inv := by rw [hψ_unit]
      _ = adj_pr.unit.app ℱ₀ := hψ_inv
      _ = adj_pr.unit.app ℱ₀ ≫ R_pr.map (𝟙 (L_pr.obj ℱ₀)) := by
          rw [R_pr.map_id]
          exact (CategoryTheory.Category.comp_id _).symm
      _ = adj_pr.homEquiv ℱ₀ (L_pr.obj ℱ₀) (𝟙 (L_pr.obj ℱ₀)) :=
          (CategoryTheory.Adjunction.homEquiv_unit adj_pr ℱ₀ (L_pr.obj ℱ₀)
            (𝟙 (L_pr.obj ℱ₀))).symm
  have h_right : ψ_inv ≫ ψ = 𝟙 ℳ := by
    apply hHomExt ℳ (ψ_inv ≫ ψ) (𝟙 ℳ)
    calc
      η ≫ R_pr.map (ψ_inv ≫ ψ)
        = (η ≫ R_pr.map ψ_inv) ≫ R_pr.map ψ := by
          rw [R_pr.map_comp]
          exact (CategoryTheory.Category.assoc _ _ _).symm
      _ = adj_pr.unit.app ℱ₀ ≫ R_pr.map ψ := by rw [hψ_inv]
      _ = η := hψ_unit
      _ = η ≫ R_pr.map (𝟙 ℳ) := by
          rw [R_pr.map_id]
          exact (CategoryTheory.Category.comp_id _).symm
  exact CategoryTheory.IsIso.mk ⟨ψ_inv, h_left, h_right⟩

theorem weil_ind_etale_affine_chart_and_subfield_descent (F : Type u) [Finite F] [Field F]
    (D : AlgebraicGeometry.Scheme.{u})
    (D_hom : Quiver.Hom D (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (W₀ : D.Etale)
    (Z : (CategoryTheory.Limits.pullback D_hom
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).Etale)
    (q : Quiver.Hom Z
      ((weilEtaleSitePullback
        (CategoryTheory.Limits.pullback.fst D_hom
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))).obj W₀))
    (z : ↥((AlgebraicGeometry.Scheme.Etale.forget
      (CategoryTheory.Limits.pullback D_hom
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))).obj Z).left)
    (S_extra : Finset (AlgebraicClosure F)) :
    let k := AlgebraicClosure F
    let f_ext := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
    let S_bar := CategoryTheory.Limits.pullback D_hom f_ext
    let pr_D := CategoryTheory.Limits.pullback.fst D_hom f_ext
    let pr_k := CategoryTheory.Limits.pullback.snd D_hom f_ext
    let Fgt_D := AlgebraicGeometry.Scheme.Etale.forget D
    let Fgt_S := AlgebraicGeometry.Scheme.Etale.forget S_bar
    ∃ (C₀ A : Type u)
      (_ : CommRing C₀) (_ : Algebra F C₀)
      (_ : CommRing A) (_ : Algebra F A) (_ : Algebra C₀ A) (_ : Algebra k A)
      (_ : IsScalarTower F C₀ A) (_ : IsScalarTower F k A)
      (j_C₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of C₀)) (Fgt_D.obj W₀).left)
      (v_aff : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A)) (Fgt_S.obj Z).left)
      (z' : ↥(AlgebraicGeometry.Spec (CommRingCat.of A)))
      (E₁ : IntermediateField F k)
      (_ : FiniteDimensional F ↥E₁)
      (A₁ : Type u)
      (_ : CommRing A₁) (_ : Algebra F A₁) (_ : Algebra C₀ A₁) (_ : Algebra ↥E₁ A₁)
      (_ : IsScalarTower F C₀ A₁) (_ : IsScalarTower F ↥E₁ A₁)
      (_ : Algebra.Etale C₀ A₁)
      (e_A1 : TensorProduct ↥E₁ A₁ k ≃+* A),
      AlgebraicGeometry.Etale j_C₀ ∧
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp j_C₀ (Fgt_D.obj W₀).hom) D_hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F C₀)) ∧
      AlgebraicGeometry.Etale v_aff ∧
      v_aff.base z' = z ∧
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp v_aff (Fgt_S.obj Z).hom) pr_D =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₀ A)))
          (CategoryTheory.CategoryStruct.comp j_C₀ (Fgt_D.obj W₀).hom) ∧
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp v_aff (Fgt_S.obj Z).hom) pr_k =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)) ∧
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp v_aff (Fgt_S.map q).left)
        (CategoryTheory.Limits.pullback.fst (Fgt_D.obj W₀).hom pr_D) =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₀ A))) j_C₀ ∧
      (S_extra : Set k) ⊆ (E₁ : Set k) ∧
      (∀ (a₁ : A₁) (x : k),
        e_A1 (TensorProduct.tmul ↥E₁ a₁ x) =
          e_A1 (TensorProduct.tmul ↥E₁ a₁ 1) * algebraMap k A x) ∧
      (∀ c : C₀,
        e_A1 (TensorProduct.tmul ↥E₁ (algebraMap C₀ A₁ c) 1) = algebraMap C₀ A c) ∧
      (∀ e : ↥E₁,
        e_A1 (TensorProduct.tmul ↥E₁ (algebraMap ↥E₁ A₁ e) 1) = algebraMap k A (e : k)) :=
by
  classical
  
  have hSubfield : ∀ (C₀ : Type u) [CommRing C₀] [Algebra F C₀]
      (A_sub : Subalgebra C₀ (TensorProduct F C₀ (AlgebraicClosure F))),
      A_sub.FG →
      ∃ (E₁ : IntermediateField F (AlgebraicClosure F))
        (_ : FiniteDimensional F ↥E₁)
        (j_sub : ↥A_sub →ₐ[C₀] TensorProduct F C₀ ↥E₁),
        (S_extra : Set (AlgebraicClosure F)) ⊆ (E₁ : Set (AlgebraicClosure F)) ∧
        ∀ u : ↥A_sub,
          Algebra.TensorProduct.map (AlgHom.id F C₀) E₁.val (j_sub u) =
            (u : TensorProduct F C₀ (AlgebraicClosure F)) := by
    intro C₀ _ _ A_sub hFG
    have h_coords : ∀ w : TensorProduct F C₀ (AlgebraicClosure F),
        ∃ S_w : Finset (AlgebraicClosure F),
          ∀ (E : IntermediateField F (AlgebraicClosure F)),
            (S_w : Set (AlgebraicClosure F)) ⊆ (E : Set (AlgebraicClosure F)) →
            ∃ u : TensorProduct F C₀ ↥E,
              Algebra.TensorProduct.map (AlgHom.id F C₀) E.val u = w := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero =>
        exact ⟨∅, fun _ _ => ⟨0, map_zero _⟩⟩
      | tmul c x =>
        refine ⟨{x}, fun E hE => ?_⟩
        have hx : x ∈ E := hE (by simp)
        exact ⟨TensorProduct.tmul F c (⟨x, hx⟩ : ↥E),
          Algebra.TensorProduct.map_tmul _ _ c (⟨x, hx⟩ : ↥E)⟩
      | add u v ihu ihv =>
        rcases ihu with ⟨Su, hSu⟩
        rcases ihv with ⟨Sv, hSv⟩
        refine ⟨Su ∪ Sv, fun E hE => ?_⟩
        rw [Finset.coe_union, Set.union_subset_iff] at hE
        rcases hSu E hE.1 with ⟨u', hu'⟩
        rcases hSv E hE.2 with ⟨v', hv'⟩
        exact ⟨u' + v', by rw [map_add, hu', hv']⟩
    let S_fn : TensorProduct F C₀ (AlgebraicClosure F) → Finset (AlgebraicClosure F) :=
      fun w => Classical.choose (h_coords w)
    have hS_fn : ∀ (w : TensorProduct F C₀ (AlgebraicClosure F))
        (E : IntermediateField F (AlgebraicClosure F)),
        (S_fn w : Set (AlgebraicClosure F)) ⊆ (E : Set (AlgebraicClosure F)) →
          ∃ u : TensorProduct F C₀ ↥E,
            Algebra.TensorProduct.map (AlgHom.id F C₀) E.val u = w :=
      fun w => Classical.choose_spec (h_coords w)
    rcases hFG with ⟨G_fin, hG_adj⟩
    let S_all : Finset (AlgebraicClosure F) := G_fin.biUnion S_fn ∪ S_extra
    let E₁ : IntermediateField F (AlgebraicClosure F) :=
      IntermediateField.adjoin F (S_all : Set (AlgebraicClosure F))
    have hFD_E₁ : FiniteDimensional F ↥E₁ :=
      IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
    have hS_sub_E₁ : (S_extra : Set (AlgebraicClosure F)) ⊆ (E₁ : Set (AlgebraicClosure F)) :=
      (Finset.coe_subset.mpr Finset.subset_union_right).trans
        (IntermediateField.subset_adjoin F (S_all : Set (AlgebraicClosure F)))
    let ι_CE_F : TensorProduct F C₀ ↥E₁ →ₐ[F] TensorProduct F C₀ (AlgebraicClosure F) :=
      Algebra.TensorProduct.map (AlgHom.id F C₀) E₁.val
    let ι_CE : TensorProduct F C₀ ↥E₁ →ₐ[C₀] TensorProduct F C₀ (AlgebraicClosure F) :=
      { toRingHom := ι_CE_F.toRingHom
        commutes' := fun c => Algebra.TensorProduct.map_tmul (AlgHom.id F C₀) E₁.val c 1 }
    have hA_sub_le : A_sub ≤ ι_CE.range := by
      rw [← hG_adj, Algebra.adjoin_le_iff]
      intro g hg
      have hg_fin : g ∈ G_fin := hg
      have hSg : (S_fn g : Set (AlgebraicClosure F)) ⊆ (E₁ : Set (AlgebraicClosure F)) := by
        refine Set.Subset.trans ?_
          ((Finset.coe_subset.mpr Finset.subset_union_left).trans
            (IntermediateField.subset_adjoin F (S_all : Set (AlgebraicClosure F))))
        exact Finset.coe_subset.mpr (Finset.subset_biUnion_of_mem S_fn hg_fin)
      rcases hS_fn g E₁ hSg with ⟨u, hu⟩
      exact ⟨u, hu⟩
    have hι_eq_lTensor : ∀ z : TensorProduct F C₀ ↥E₁,
        ι_CE z = LinearMap.lTensor C₀ E₁.val.toLinearMap z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul c e => rfl
      | add u v ihu ihv => rw [map_add, map_add, ihu, ihv]
    have hι_inj : Function.Injective ι_CE := by
      intro u v huv
      rw [hι_eq_lTensor u, hι_eq_lTensor v] at huv
      exact Module.Flat.lTensor_preserves_injective_linearMap (M := C₀)
        E₁.val.toLinearMap E₁.val.injective huv
    have hEx_sub : ∀ u : ↥A_sub, ∃ y : TensorProduct F C₀ ↥E₁,
        ι_CE_F y = (u : TensorProduct F C₀ (AlgebraicClosure F)) :=
      fun u => hA_sub_le u.2
    let j_sub : ↥A_sub →ₐ[C₀] TensorProduct F C₀ ↥E₁ :=
      { toFun := fun u => Classical.choose (hEx_sub u)
        map_one' := hι_inj
          ((Classical.choose_spec (hEx_sub 1)).trans ι_CE_F.map_one.symm)
        map_mul' := fun x y => hι_inj
          ((Classical.choose_spec (hEx_sub (x * y))).trans
            ((congrArg₂ (· * ·)
              (Classical.choose_spec (hEx_sub x)).symm
              (Classical.choose_spec (hEx_sub y)).symm).trans
              (ι_CE_F.map_mul _ _).symm))
        map_zero' := hι_inj
          ((Classical.choose_spec (hEx_sub 0)).trans ι_CE_F.map_zero.symm)
        map_add' := fun x y => hι_inj
          ((Classical.choose_spec (hEx_sub (x + y))).trans
            ((congrArg₂ (· + ·)
              (Classical.choose_spec (hEx_sub x)).symm
              (Classical.choose_spec (hEx_sub y)).symm).trans
              (ι_CE_F.map_add _ _).symm))
        commutes' := fun c => hι_inj
          ((Classical.choose_spec (hEx_sub (algebraMap C₀ ↥A_sub c))).trans
            ((A_sub.val.commutes c).trans (ι_CE.commutes c).symm)) }
    exact ⟨E₁, hFD_E₁, j_sub, hS_sub_E₁, fun u => Classical.choose_spec (hEx_sub u)⟩
  
  
  have hBaseChange : ∀ (E k_ext C₀ R_sub B₀ A : Type u)
      [Field E] [CommRing k_ext]
      [Algebra F E] [FiniteDimensional F E]
      [Algebra F k_ext] [Algebra E k_ext] [IsScalarTower F E k_ext]
      [CommRing C₀] [Algebra F C₀]
      [CommRing R_sub] [Algebra C₀ R_sub]
      [CommRing B₀] [Algebra R_sub B₀] [Algebra.Etale R_sub B₀]
      [CommRing A] [Algebra F A] [Algebra C₀ A] [Algebra k_ext A]
      [IsScalarTower F C₀ A] [IsScalarTower F k_ext A]
      [Algebra (TensorProduct F C₀ k_ext) A]
      (_hAlg_CkA : ∀ (c : C₀) (x : k_ext),
        algebraMap (TensorProduct F C₀ k_ext) A (TensorProduct.tmul F c x) =
          algebraMap C₀ A c * algebraMap k_ext A x)
      (j_sub : R_sub →ₐ[C₀] TensorProduct F C₀ E)
      (ι_sub : R_sub →ₐ[C₀] TensorProduct F C₀ k_ext)
      (_hj_sub : ∀ u : R_sub,
        Algebra.TensorProduct.map (AlgHom.id F C₀) (IsScalarTower.toAlgHom F E k_ext) (j_sub u) =
          ι_sub u)
