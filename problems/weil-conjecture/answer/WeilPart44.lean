      let i₀ : Fin n₀a := eK1.symm ⟨-q₁, h_neg_q1⟩
      let q₀a : Fin m₀ → R := Pi.single (e0_idx.symm (Sum.inl i₀)) 1
      have hd₀_a : d₀ q₀a = -q₁ := by
        have := h_linOfVec_single (Sum.elim (fun i => (eK1 i).1) (fun _ => 0) ∘ e0_idx)
