            CategoryTheory.Abelian.Ext.{u} G one₀ 2)
        (_hE_nat : ∀ (G : 𝒞₀) (φ : CategoryTheory.Abelian.Ext.{u} one₀ G 0 →+ ZMod m)
          (α : CategoryTheory.Abelian.Ext.{u} one₀ G 0),
          α.comp (E_top G φ) (Nat.zero_add 2) =
            E_top one₀ (φ.comp (α.postcomp one₀ (Nat.add_zero 0))))
        {J₁ M₁ J₂ M₂ : 𝒞₀} (ι₁ : Quiver.Hom J₁ M₁) (ι₂ : Quiver.Hom J₂ M₂)
        (_hMono₁ : CategoryTheory.Mono ι₁)
        (_hSub₁ : Subsingleton (CategoryTheory.Abelian.Ext.{u} one₀ (CategoryTheory.Limits.cokernel ι₁) 1))
        (_hMono₂ : CategoryTheory.Mono ι₂)
        (_hSub₂ : Subsingleton (CategoryTheory.Abelian.Ext.{u} one₀ (CategoryTheory.Limits.cokernel ι₂) 1))
        (_hFin_J₁_1 : Finite (CategoryTheory.Abelian.Ext.{u} one₀ J₁ 1))
        (_hFin_J₂_1 : Finite (CategoryTheory.Abelian.Ext.{u} one₀ J₂ 1))
        (Ψ₁ : CategoryTheory.Abelian.Ext.{u} one₀ M₂ 1 →+ CategoryTheory.Abelian.Ext.{u} J₁ one₀ 1)
        (_hΨ₁_inj : Function.Injective Ψ₁)
        (_hΨ₁_lift : ∀ w : CategoryTheory.Abelian.Ext.{u} one₀ M₂ 1,
