          (CategoryTheory.Abelian.Ext.mk₀ (U_of.map f_mod ≫ βM)) (Nat.add_zero (2 * d))) =
        (((CategoryTheory.Abelian.Ext.mk₀ ηZ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U_of
              (α.comp (CategoryTheory.Abelian.Ext.mk₀ f_mod) (Nat.add_zero (2 * d))))
            (Nat.zero_add (2 * d))).comp
          (CategoryTheory.Abelian.Ext.mk₀ βM) (Nat.add_zero (2 * d)))
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (U_of.map f_mod) βM,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero (2 * d)) (Nat.add_zero 0)
          (Nat.add_zero (2 * d)),
        CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ηZ) _ _
          (Nat.zero_add (2 * d)) (Nat.add_zero (2 * d)) (by omega)]

    have hΨ_ab_eq : Ψ_ab = e_dual.symm ∘ Ψ_mod ∘ e_hom.symm := by
      ext f x
      have hf : f = e_hom (e_hom.symm f) := (e_hom.apply_symm_apply f).symm
      conv_lhs => rw [hf]
      have hc := hCompat (e_hom.symm f)
      have hc' : Ψ_ab (e_hom (e_hom.symm f)) = e_dual.symm (Ψ_mod (e_hom.symm f)) :=
        (e_dual.symm_apply_eq.mpr hc.symm).symm
      exact DFunLike.congr_fun hc' x

    change Function.Bijective Ψ_ab
    rw [hΨ_ab_eq]
    exact e_dual.symm.bijective.comp (hΨ_mod_bij.comp e_hom.symm.bijective)

theorem weil_coinv_base_zero_ext_torsion_and_epi (D_left : AlgebraicGeometry.Scheme.{u})
    (U₀ : D_left.Opens)
    (R₀ B₁ B₂ : Type u) [CommRing R₀] [CommRing B₁] [CommRing B₂]
    [Algebra R₀ B₁] [Algebra R₀ B₂]
    (ι_B : B₁ →ₐ[R₀] B₂)
    (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme)
    (m₁ m₂ N : ℕ) (hdvd : m₁ ∣ m₂)
    (ρ₁ : (B₁ ≃ₐ[R₀] B₁) →* (Matrix (Fin N) (Fin N) (ZMod m₁))ˣ)
    (ρ₂ : (B₂ ≃ₐ[R₀] B₂) →* (Matrix (Fin N) (Fin N) (ZMod m₂))ˣ)
    (hπ₂_et : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₂)) ≫ e_U.hom))
    (hπ₂_surj : AlgebraicGeometry.Surjective
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₂)) ≫ e_U.hom))
    (hSheets₁ :
      let V₁ := AlgebraicGeometry.Spec (CommRingCat.of B₁)
      let π₁ : V₁ ⟶ U₀.toScheme :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₁)) ≫ e_U.hom
      ∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V₁),
        let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ π₁) π₁
        ∃ δ : (B₁ ≃ₐ[R₀] B₁) → (Y ⟶ Y_V),
          (∀ σ : B₁ ≃ₐ[R₀] B₁,
            δ σ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π₁) π₁ = 𝟙 Y ∧
            δ σ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π₁) π₁ =
              g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ∧
            AlgebraicGeometry.Etale (δ σ) ∧
            IsOpen (Set.range (δ σ).base)) ∧
          (∀ σ₁ σ₂ : B₁ ≃ₐ[R₀] B₁, σ₁ ≠ σ₂ →
            Disjoint (Set.range (δ σ₁).base) (Set.range (δ σ₂).base)) ∧
          (⋃ σ : B₁ ≃ₐ[R₀] B₁, Set.range (δ σ).base) = Set.univ ∧
          (∀ (σ τ : B₁ ≃ₐ[R₀] B₁) (m_τ : Y_V ⟶ Y_V),
            m_τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π₁) π₁ =
              CategoryTheory.Limits.pullback.fst (g_Y ≫ π₁) π₁ →
            m_τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π₁) π₁ =
              CategoryTheory.Limits.pullback.snd (g_Y ≫ π₁) π₁ ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
            δ σ ≫ m_τ = δ (τ * σ)))
    (hSheets₂ :
      let V₂ := AlgebraicGeometry.Spec (CommRingCat.of B₂)
      let π₂ : V₂ ⟶ U₀.toScheme :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₂)) ≫ e_U.hom
      ∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V₂),
        let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ π₂) π₂
        ∃ δ : (B₂ ≃ₐ[R₀] B₂) → (Y ⟶ Y_V),
          (∀ σ : B₂ ≃ₐ[R₀] B₂,
            δ σ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π₂) π₂ = 𝟙 Y ∧
            δ σ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π₂) π₂ =
              g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ∧
            AlgebraicGeometry.Etale (δ σ) ∧
            IsOpen (Set.range (δ σ).base)) ∧
          (∀ σ₁ σ₂ : B₂ ≃ₐ[R₀] B₂, σ₁ ≠ σ₂ →
            Disjoint (Set.range (δ σ₁).base) (Set.range (δ σ₂).base)) ∧
          (⋃ σ : B₂ ≃ₐ[R₀] B₂, Set.range (δ σ).base) = Set.univ ∧
          (∀ (σ τ : B₂ ≃ₐ[R₀] B₂) (m_τ : Y_V ⟶ Y_V),
            m_τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π₂) π₂ =
              CategoryTheory.Limits.pullback.fst (g_Y ≫ π₂) π₂ →
            m_τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π₂) π₂ =
              CategoryTheory.Limits.pullback.snd (g_Y ≫ π₂) π₂ ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
            δ σ ≫ m_τ = δ (τ * σ)))
    (hMem_D : ∀ (W : D_left.Etale) (R_sieve : CategoryTheory.Sieve W),
      R_sieve ∈ D_left.smallEtaleTopology W ↔
        ∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).left,
          ∃ (Y : D_left.Etale) (f : Y ⟶ W)
            (y : ↥((AlgebraicGeometry.Scheme.Etale.forget D_left).obj Y).left),
            R_sieve.arrows f ∧
            AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget D_left).map f).left ∧
            ((AlgebraicGeometry.Scheme.Etale.forget D_left).map f).left.base y = x)
    (𝒥₁ 𝒥₂ : CategoryTheory.Sheaf D_left.smallEtaleTopology AddCommGrpCat.{u})
    (τ_𝒥 : Quiver.Hom 𝒥₂ 𝒥₁)
    (triv₁ :
      let V₁ := AlgebraicGeometry.Spec (CommRingCat.of B₁)
      let π₁ : V₁ ⟶ U₀.toScheme :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₁)) ≫ e_U.hom
      let ι₁ : V₁ ⟶ D_left := π₁ ≫ U₀.ι
      ∀ W : D_left.Etale,
        ↑(𝒥₁.obj.obj (Opposite.op W)) →+
          LocallyConstant
            ↥(CategoryTheory.Limits.pullback
              ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom ι₁)
            (Fin N → ZMod m₁))
    (triv₂ :
      let V₂ := AlgebraicGeometry.Spec (CommRingCat.of B₂)
      let π₂ : V₂ ⟶ U₀.toScheme :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₂)) ≫ e_U.hom
      let ι₂ : V₂ ⟶ D_left := π₂ ≫ U₀.ι
      ∀ W : D_left.Etale,
        ↑(𝒥₂.obj.obj (Opposite.op W)) →+
          LocallyConstant
            ↥(CategoryTheory.Limits.pullback
              ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom ι₂)
            (Fin N → ZMod m₂))
    (htriv₁_nat :
      let V₁ := AlgebraicGeometry.Spec (CommRingCat.of B₁)
      let π₁ : V₁ ⟶ U₀.toScheme :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₁)) ≫ e_U.hom
      let ι₁ : V₁ ⟶ D_left := π₁ ≫ U₀.ι
      ∀ {W₁ W₂ : D_left.Etale} (u : Quiver.Hom W₁ W₂),
        let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W₁).hom
        let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W₂).hom
        let W₁_V := CategoryTheory.Limits.pullback h₁ ι₁
        let W₂_V := CategoryTheory.Limits.pullback h₂ ι₁
        ∀ (u_V : Quiver.Hom W₁_V W₂_V),
          CategoryTheory.CategoryStruct.comp u_V (CategoryTheory.Limits.pullback.fst h₂ ι₁) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst h₁ ι₁)
              ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u).left →
          CategoryTheory.CategoryStruct.comp u_V (CategoryTheory.Limits.pullback.snd h₂ ι₁) =
            CategoryTheory.Limits.pullback.snd h₁ ι₁ →
          ∀ (s : ↑(𝒥₁.obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_V),
            triv₁ W₁ ((𝒥₁.obj.map (Opposite.op u)) s) y₁ = triv₁ W₂ s (u_V.base y₁))
    (htriv₁_spec :
      let V₁ := AlgebraicGeometry.Spec (CommRingCat.of B₁)
      let π₁ : V₁ ⟶ U₀.toScheme :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₁)) ≫ e_U.hom
      let ι₁ : V₁ ⟶ D_left := π₁ ≫ U₀.ι
      ∀ W : D_left.Etale,
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
        let W_V := CategoryTheory.Limits.pullback h_W ι₁
        Function.Injective (triv₁ W) ∧
        Set.range (triv₁ W) =
          { f |
            (∃ W₀ : ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).left.Opens,
              ((TopologicalSpace.Opens.map h_W.base).obj U₀) ⊔ W₀ = ⊤ ∧
              ∀ y : ↥W_V,
                (CategoryTheory.Limits.pullback.fst h_W ι₁).base y ∈ W₀ → f y = 0) ∧
            (∀ (σ : B₁ ≃ₐ[R₀] B₁) (m_σ : Quiver.Hom W_V W_V),
              CategoryTheory.CategoryStruct.comp m_σ
                  (CategoryTheory.Limits.pullback.fst h_W ι₁) =
                CategoryTheory.Limits.pullback.fst h_W ι₁ →
              CategoryTheory.CategoryStruct.comp m_σ
                  (CategoryTheory.Limits.pullback.snd h_W ι₁) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W ι₁)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
              ∀ y : ↥W_V, f (m_σ.base y) = ((ρ₁ σ).val).mulVec (f y)) })
    (htriv₂_spec :
      let V₂ := AlgebraicGeometry.Spec (CommRingCat.of B₂)
      let π₂ : V₂ ⟶ U₀.toScheme :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₂)) ≫ e_U.hom
      let ι₂ : V₂ ⟶ D_left := π₂ ≫ U₀.ι
      ∀ W : D_left.Etale,
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
        let W_V := CategoryTheory.Limits.pullback h_W ι₂
        Function.Injective (triv₂ W) ∧
        Set.range (triv₂ W) =
          { f |
            (∃ W₀ : ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).left.Opens,
              ((TopologicalSpace.Opens.map h_W.base).obj U₀) ⊔ W₀ = ⊤ ∧
              ∀ y : ↥W_V,
                (CategoryTheory.Limits.pullback.fst h_W ι₂).base y ∈ W₀ → f y = 0) ∧
            (∀ (σ : B₂ ≃ₐ[R₀] B₂) (m_σ : Quiver.Hom W_V W_V),
              CategoryTheory.CategoryStruct.comp m_σ
                  (CategoryTheory.Limits.pullback.fst h_W ι₂) =
                CategoryTheory.Limits.pullback.fst h_W ι₂ →
              CategoryTheory.CategoryStruct.comp m_σ
                  (CategoryTheory.Limits.pullback.snd h_W ι₂) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W ι₂)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
              ∀ y : ↥W_V, f (m_σ.base y) = ((ρ₂ σ).val).mulVec (f y)) })
    (htriv_trans :
      let V₁ := AlgebraicGeometry.Spec (CommRingCat.of B₁)
      let π₁ : V₁ ⟶ U₀.toScheme :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₁)) ≫ e_U.hom
      let ι₁ : V₁ ⟶ D_left := π₁ ≫ U₀.ι
      let V₂ := AlgebraicGeometry.Spec (CommRingCat.of B₂)
      let π₂ : V₂ ⟶ U₀.toScheme :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₂)) ≫ e_U.hom
      let ι₂ : V₂ ⟶ D_left := π₂ ≫ U₀.ι
      ∀ (W : D_left.Etale),
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
        let W_r := CategoryTheory.Limits.pullback h_W ι₁
        let W_succ := CategoryTheory.Limits.pullback h_W ι₂
        ∀ (s_up : ↑(𝒥₂.obj.obj (Opposite.op W)))
          (m_ι : Quiver.Hom W_succ W_r),
          CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.fst h_W ι₁) =
            CategoryTheory.Limits.pullback.fst h_W ι₂ →
          CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.snd h_W ι₁) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.snd h_W ι₂)
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B.toRingHom)) →
          ∀ (y_up : ↥W_succ) (i : Fin N),
            triv₁ W ((τ_𝒥.hom.app (Opposite.op W)) s_up) (m_ι.base y_up) i =
              ZMod.castHom hdvd (ZMod m₁) (triv₂ W s_up y_up i)) :
    (m₁ • CategoryTheory.CategoryStruct.id 𝒥₁ = 0) ∧ CategoryTheory.Epi τ_𝒥 :=
by
  classical
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget D_left
  let V₁ := AlgebraicGeometry.Spec (CommRingCat.of B₁)
  let π₁ : V₁ ⟶ U₀.toScheme :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₁)) ≫ e_U.hom
  let ι₁ : V₁ ⟶ D_left := π₁ ≫ U₀.ι
  let V₂ := AlgebraicGeometry.Spec (CommRingCat.of B₂)
  let π₂ : V₂ ⟶ U₀.toScheme :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₂)) ≫ e_U.hom
  let ι₂ : V₂ ⟶ D_left := π₂ ≫ U₀.ι

  
  have hTors : m₁ • CategoryTheory.CategoryStruct.id 𝒥₁ = 0 := by
    have hEvalNsmul : ∀ (n : ℕ) (W : D_left.Etale) (s : ↑(𝒥₁.obj.obj (Opposite.op W))),
        ((n • CategoryTheory.CategoryStruct.id 𝒥₁).hom.app (Opposite.op W)) s = n • s := by
      intro n W s
      induction n with
      | zero =>
        rw [zero_nsmul, zero_nsmul]
        rfl
      | succ n ih =>
        rw [succ_nsmul, succ_nsmul]
        change ((n • CategoryTheory.CategoryStruct.id 𝒥₁).hom.app (Opposite.op W)) s + s =
          n • s + s
        rw [ih]
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext W_op
    let W : D_left.Etale := Opposite.unop W_op
    have hW_op : W_op = Opposite.op W := rfl
    rw [hW_op]
    apply AddCommGrpCat.ext
    intro s
    rw [hEvalNsmul m₁ W s]
    change m₁ • s = 0
    apply (htriv₁_spec W).1
    rw [map_nsmul, map_zero]
    apply LocallyConstant.ext
    intro y
    funext i
    rw [LocallyConstant.smul_apply, Pi.smul_apply, nsmul_eq_mul, ZMod.natCast_self,
      zero_mul, LocallyConstant.zero_apply, Pi.zero_apply]

  
  have hEpi : CategoryTheory.Epi τ_𝒥 := by
    have : CategoryTheory.Sheaf.IsLocallySurjective τ_𝒥 := by
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk fun {W} s₁ => ?_
      rw [hMem_D]
      intro x
      let h_W := (Fgt.obj W).hom
      have hf₁_mem : triv₁ W s₁ ∈ Set.range (triv₁ W) := ⟨s₁, rfl⟩
      rw [(htriv₁_spec W).2] at hf₁_mem
      rcases hf₁_mem with ⟨⟨W₀, hCov, hZero⟩, _⟩
      have hx_top : x ∈ (⊤ : (Fgt.obj W).left.Opens) := TopologicalSpace.Opens.mem_top x
      rw [← hCov, TopologicalSpace.Opens.mem_sup] at hx_top
      rcases hx_top with hxU | hxW₀
      · 
        let p_ι : V₂ ⟶ V₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B.toRingHom)
        have hp_π : p_ι ≫ π₁ = π₂ := by
          dsimp only [p_ι, π₁, π₂]
          rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
          congr 2
          apply CommRingCat.hom_ext
          ext r
          exact ι_B.commutes r
        have hp_ι : p_ι ≫ ι₁ = ι₂ := by
          dsimp only [ι₁, ι₂]
          rw [← CategoryTheory.Category.assoc, hp_π]

        have : AlgebraicGeometry.Etale π₂ := hπ₂_et
        have : AlgebraicGeometry.Etale h_W := W.prop
        have hι₂_et : AlgebraicGeometry.Etale ι₂ := inferInstance
        let W_V₂ := CategoryTheory.Limits.pullback h_W ι₂
        let p_fst : W_V₂ ⟶ (Fgt.obj W).left := CategoryTheory.Limits.pullback.fst h_W ι₂
        let g_Y : W_V₂ ⟶ V₂ := CategoryTheory.Limits.pullback.snd h_W ι₂
        have hp_fst_et : AlgebraicGeometry.Etale p_fst :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback h_W ι₂).flip hι₂_et
        have : AlgebraicGeometry.Etale p_fst := hp_fst_et
        let Y : D_left.Etale := AlgebraicGeometry.Scheme.Etale.mk (p_fst ≫ h_W)
        let u : Y ⟶ W := CategoryTheory.MorphismProperty.Over.homMk p_fst rfl
        let h_Y := (Fgt.obj Y).hom

        have hxU_set : h_W.base x ∈ (U₀ : Set D_left) := hxU
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι U₀] at hxU_set
        rcases hxU_set with ⟨u_pt, hu_pt⟩
        obtain ⟨v_pt, hv_pt⟩ := (AlgebraicGeometry.surjective_iff π₂).mp hπ₂_surj u_pt
        have hv_ι₂ : h_W.base x = ι₂.base v_pt := by
          change h_W.base x = U₀.ι.base (π₂.base v_pt)
          rw [hv_pt, hu_pt]
        obtain ⟨y₀, hy₀_fst, _⟩ :=
          @AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback _ _ _ h_W ι₂ x v_pt hv_ι₂

        have hh_Y : p_fst ≫ h_W = (g_Y ≫ π₂) ≫ U₀.ι := by
          rw [CategoryTheory.Category.assoc]
          exact CategoryTheory.Limits.pullback.condition

        
        let Y_V₂ := CategoryTheory.Limits.pullback h_Y ι₂
        let P₂ := CategoryTheory.Limits.pullback (g_Y ≫ π₂) π₂
        let φ₂ : P₂ ⟶ Y_V₂ :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst (g_Y ≫ π₂) π₂)
            (CategoryTheory.Limits.pullback.snd (g_Y ≫ π₂) π₂)
            ((congrArg (CategoryTheory.Limits.pullback.fst (g_Y ≫ π₂) π₂ ≫ ·) hh_Y).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ U₀.ι)
                  (CategoryTheory.Limits.pullback.condition (f := g_Y ≫ π₂) (g := π₂))).trans
                  (CategoryTheory.Category.assoc _ _ _))))
        let ψ₂ : Y_V₂ ⟶ P₂ :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst h_Y ι₂)
            (CategoryTheory.Limits.pullback.snd h_Y ι₂)
            ((CategoryTheory.cancel_mono U₀.ι).mp (by
              have hc : CategoryTheory.Limits.pullback.fst h_Y ι₂ ≫ (p_fst ≫ h_W) =
                  CategoryTheory.Limits.pullback.snd h_Y ι₂ ≫ (π₂ ≫ U₀.ι) :=
                CategoryTheory.Limits.pullback.condition
              calc
                (CategoryTheory.Limits.pullback.fst h_Y ι₂ ≫ (g_Y ≫ π₂)) ≫ U₀.ι
                  = CategoryTheory.Limits.pullback.fst h_Y ι₂ ≫ ((g_Y ≫ π₂) ≫ U₀.ι) :=
                    CategoryTheory.Category.assoc _ _ _
                _ = CategoryTheory.Limits.pullback.fst h_Y ι₂ ≫ (p_fst ≫ h_W) :=
                    congrArg (CategoryTheory.Limits.pullback.fst h_Y ι₂ ≫ ·) hh_Y.symm
                _ = CategoryTheory.Limits.pullback.snd h_Y ι₂ ≫ (π₂ ≫ U₀.ι) := hc
                _ = (CategoryTheory.Limits.pullback.snd h_Y ι₂ ≫ π₂) ≫ U₀.ι :=
                    (CategoryTheory.Category.assoc _ _ _).symm))
        have hφψ₂ : φ₂ ≫ ψ₂ = 𝟙 P₂ :=
          CategoryTheory.Limits.pullback.hom_ext
            ((CategoryTheory.Category.assoc φ₂ ψ₂ _).trans
              ((congrArg (φ₂ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                  (CategoryTheory.Category.id_comp _).symm)))
            ((CategoryTheory.Category.assoc φ₂ ψ₂ _).trans
              ((congrArg (φ₂ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                  (CategoryTheory.Category.id_comp _).symm)))
        have hψφ₂ : ψ₂ ≫ φ₂ = 𝟙 Y_V₂ :=
          CategoryTheory.Limits.pullback.hom_ext
            ((CategoryTheory.Category.assoc ψ₂ φ₂ _).trans
              ((congrArg (ψ₂ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                  (CategoryTheory.Category.id_comp _).symm)))
            ((CategoryTheory.Category.assoc ψ₂ φ₂ _).trans
              ((congrArg (ψ₂ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                  (CategoryTheory.Category.id_comp _).symm)))

        obtain ⟨δ₂, hδ₂_spec, hδ₂_disj, hδ₂_cov, hδ₂_mul⟩ := hSheets₂ W_V₂ g_Y
        let δ₂_ι : (B₂ ≃ₐ[R₀] B₂) → (W_V₂ ⟶ Y_V₂) := fun τ => δ₂ τ ≫ φ₂
        have hδ₂_ι_fst : ∀ τ : B₂ ≃ₐ[R₀] B₂,
            δ₂_ι τ ≫ CategoryTheory.Limits.pullback.fst h_Y ι₂ = 𝟙 W_V₂ :=
          fun τ =>
            (CategoryTheory.Category.assoc (δ₂ τ) φ₂ _).trans
              ((congrArg (δ₂ τ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                (hδ₂_spec τ).1)
        have hδ₂_ι_snd : ∀ τ : B₂ ≃ₐ[R₀] B₂,
            δ₂_ι τ ≫ CategoryTheory.Limits.pullback.snd h_Y ι₂ =
              g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) :=
          fun τ =>
            (CategoryTheory.Category.assoc (δ₂ τ) φ₂ _).trans
              ((congrArg (δ₂ τ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                (hδ₂_spec τ).2.1)
        have hδ₂_ι_range : ∀ τ : B₂ ≃ₐ[R₀] B₂,
            Set.range (δ₂_ι τ).base = ψ₂.base ⁻¹' Set.range (δ₂ τ).base := by
          intro τ
          ext y
          constructor
          · rintro ⟨w, rfl⟩
            change ψ₂.base (φ₂.base ((δ₂ τ).base w)) ∈ Set.range (δ₂ τ).base
            have hpt : ψ₂.base (φ₂.base ((δ₂ τ).base w)) = (δ₂ τ).base w :=
              congrArg (fun m : P₂ ⟶ P₂ => m.base ((δ₂ τ).base w)) hφψ₂
            rw [hpt]
            exact ⟨w, rfl⟩
          · rintro ⟨w, hw⟩
            refine ⟨w, ?_⟩
            have hpt : φ₂.base (ψ₂.base y) = y :=
              congrArg (fun m : Y_V₂ ⟶ Y_V₂ => m.base y) hψφ₂
            exact (congrArg φ₂.base hw).trans hpt
        have hδ₂_ι_open : ∀ τ : B₂ ≃ₐ[R₀] B₂, IsOpen (Set.range (δ₂_ι τ).base) := by
          intro τ
          rw [hδ₂_ι_range τ]
          exact ((hδ₂_spec τ).2.2.2).preimage (AlgebraicGeometry.Scheme.Hom.continuous ψ₂)
        have hδ₂_ι_disj : ∀ τ₁ τ₂ : B₂ ≃ₐ[R₀] B₂, τ₁ ≠ τ₂ →
            Disjoint (Set.range (δ₂_ι τ₁).base) (Set.range (δ₂_ι τ₂).base) := by
          intro τ₁ τ₂ hne
          rw [hδ₂_ι_range τ₁, hδ₂_ι_range τ₂]
          exact (hδ₂_disj τ₁ τ₂ hne).preimage ψ₂.base
        have hδ₂_ι_cov : (⋃ τ : B₂ ≃ₐ[R₀] B₂, Set.range (δ₂_ι τ).base) = Set.univ := by
          ext y
          simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
          have hmem : ψ₂.base y ∈ (Set.univ : Set ↥P₂) := Set.mem_univ _
          rw [← hδ₂_cov, Set.mem_iUnion] at hmem
          rcases hmem with ⟨τ, hτ⟩
          refine ⟨τ, ?_⟩
          rw [hδ₂_ι_range τ]
          exact hτ
        have hδ₂_ι_mul : ∀ (σ τ : B₂ ≃ₐ[R₀] B₂) (m_τ : Y_V₂ ⟶ Y_V₂),
            m_τ ≫ CategoryTheory.Limits.pullback.fst h_Y ι₂ =
              CategoryTheory.Limits.pullback.fst h_Y ι₂ →
            m_τ ≫ CategoryTheory.Limits.pullback.snd h_Y ι₂ =
              CategoryTheory.Limits.pullback.snd h_Y ι₂ ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
            δ₂_ι σ ≫ m_τ = δ₂_ι (τ * σ) := by
          intro σ τ m_τ hm_fst hm_snd
          let m'_τ : P₂ ⟶ P₂ := φ₂ ≫ m_τ ≫ ψ₂
          have hm'_fst : m'_τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π₂) π₂ =
              CategoryTheory.Limits.pullback.fst (g_Y ≫ π₂) π₂ :=
            (CategoryTheory.Category.assoc φ₂ (m_τ ≫ ψ₂) _).trans
              ((congrArg (φ₂ ≫ ·)
                ((CategoryTheory.Category.assoc m_τ ψ₂ _).trans
                  ((congrArg (m_τ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                    hm_fst))).trans
                (CategoryTheory.Limits.pullback.lift_fst _ _ _))
          have hm'_snd : m'_τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π₂) π₂ =
              CategoryTheory.Limits.pullback.snd (g_Y ≫ π₂) π₂ ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) :=
            (CategoryTheory.Category.assoc φ₂ (m_τ ≫ ψ₂) _).trans
              ((congrArg (φ₂ ≫ ·)
                ((CategoryTheory.Category.assoc m_τ ψ₂ _).trans
                  ((congrArg (m_τ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                    hm_snd))).trans
                ((CategoryTheory.Category.assoc φ₂ _ _).symm.trans
                  (congrArg (· ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom))
                    (CategoryTheory.Limits.pullback.lift_snd _ _ _))))
          have heq := hδ₂_mul σ τ m'_τ hm'_fst hm'_snd
          calc
            δ₂_ι σ ≫ m_τ = δ₂ σ ≫ φ₂ ≫ m_τ ≫ 𝟙 Y_V₂ := by
              simp only [δ₂_ι, CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc]
            _ = δ₂ σ ≫ φ₂ ≫ m_τ ≫ (ψ₂ ≫ φ₂) := by rw [hψφ₂]
            _ = (δ₂ σ ≫ m'_τ) ≫ φ₂ := by simp only [m'_τ, CategoryTheory.Category.assoc]
            _ = δ₂_ι (τ * σ) := by rw [heq]

        
        let g_Y₁ : W_V₂ ⟶ V₁ := g_Y ≫ p_ι
        have hh_Y₁ : p_fst ≫ h_W = (g_Y₁ ≫ π₁) ≫ U₀.ι := by
          dsimp only [g_Y₁]
          rw [CategoryTheory.Category.assoc g_Y p_ι π₁, hp_π]
          exact hh_Y
        let Y_V₁ := CategoryTheory.Limits.pullback h_Y ι₁
        let P₁ := CategoryTheory.Limits.pullback (g_Y₁ ≫ π₁) π₁
        let φ₁ : P₁ ⟶ Y_V₁ :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst (g_Y₁ ≫ π₁) π₁)
            (CategoryTheory.Limits.pullback.snd (g_Y₁ ≫ π₁) π₁)
            ((congrArg (CategoryTheory.Limits.pullback.fst (g_Y₁ ≫ π₁) π₁ ≫ ·) hh_Y₁).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ U₀.ι)
                  (CategoryTheory.Limits.pullback.condition (f := g_Y₁ ≫ π₁) (g := π₁))).trans
                  (CategoryTheory.Category.assoc _ _ _))))
        let ψ₁ : Y_V₁ ⟶ P₁ :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst h_Y ι₁)
            (CategoryTheory.Limits.pullback.snd h_Y ι₁)
            ((CategoryTheory.cancel_mono U₀.ι).mp (by
              have hc : CategoryTheory.Limits.pullback.fst h_Y ι₁ ≫ (p_fst ≫ h_W) =
                  CategoryTheory.Limits.pullback.snd h_Y ι₁ ≫ (π₁ ≫ U₀.ι) :=
                CategoryTheory.Limits.pullback.condition
              calc
                (CategoryTheory.Limits.pullback.fst h_Y ι₁ ≫ (g_Y₁ ≫ π₁)) ≫ U₀.ι
                  = CategoryTheory.Limits.pullback.fst h_Y ι₁ ≫ ((g_Y₁ ≫ π₁) ≫ U₀.ι) :=
                    CategoryTheory.Category.assoc _ _ _
                _ = CategoryTheory.Limits.pullback.fst h_Y ι₁ ≫ (p_fst ≫ h_W) :=
                    congrArg (CategoryTheory.Limits.pullback.fst h_Y ι₁ ≫ ·) hh_Y₁.symm
                _ = CategoryTheory.Limits.pullback.snd h_Y ι₁ ≫ (π₁ ≫ U₀.ι) := hc
                _ = (CategoryTheory.Limits.pullback.snd h_Y ι₁ ≫ π₁) ≫ U₀.ι :=
                    (CategoryTheory.Category.assoc _ _ _).symm))
        have hψφ₁ : ψ₁ ≫ φ₁ = 𝟙 Y_V₁ :=
          CategoryTheory.Limits.pullback.hom_ext
            ((CategoryTheory.Category.assoc ψ₁ φ₁ _).trans
              ((congrArg (ψ₁ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                  (CategoryTheory.Category.id_comp _).symm)))
            ((CategoryTheory.Category.assoc ψ₁ φ₁ _).trans
              ((congrArg (ψ₁ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                  (CategoryTheory.Category.id_comp _).symm)))

        obtain ⟨δ₁, hδ₁_spec, _, hδ₁_cov, _⟩ := hSheets₁ W_V₂ g_Y₁
        let δ₁_ι : (B₁ ≃ₐ[R₀] B₁) → (W_V₂ ⟶ Y_V₁) := fun σ => δ₁ σ ≫ φ₁
        have hδ₁_ι_fst : ∀ σ : B₁ ≃ₐ[R₀] B₁,
            δ₁_ι σ ≫ CategoryTheory.Limits.pullback.fst h_Y ι₁ = 𝟙 W_V₂ :=
          fun σ =>
            (CategoryTheory.Category.assoc (δ₁ σ) φ₁ _).trans
              ((congrArg (δ₁ σ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                (hδ₁_spec σ).1)
        have hδ₁_ι_snd : ∀ σ : B₁ ≃ₐ[R₀] B₁,
            δ₁_ι σ ≫ CategoryTheory.Limits.pullback.snd h_Y ι₁ =
              g_Y₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) :=
          fun σ =>
            (CategoryTheory.Category.assoc (δ₁ σ) φ₁ _).trans
              ((congrArg (δ₁ σ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                (hδ₁_spec σ).2.1)
        have hδ₁_ι_cov : (⋃ σ : B₁ ≃ₐ[R₀] B₁, Set.range (δ₁_ι σ).base) = Set.univ := by
          ext z
          simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
          have hmem : ψ₁.base z ∈ (Set.univ : Set ↥P₁) := Set.mem_univ _
          rw [← hδ₁_cov, Set.mem_iUnion] at hmem
          rcases hmem with ⟨σ, w, hw⟩
          refine ⟨σ, w, ?_⟩
          have hpt : φ₁.base (ψ₁.base z) = z :=
            congrArg (fun m : Y_V₁ ⟶ Y_V₁ => m.base z) hψφ₁
          change φ₁.base ((δ₁ σ).base w) = z
          rw [hw, hpt]

        
        let s₁_Y := (𝒥₁.obj.map (Opposite.op u)) s₁
        let g₁ := triv₁ Y s₁_Y
        let Δ₁ : W_V₂ ⟶ Y_V₁ :=
          CategoryTheory.Limits.pullback.lift (𝟙 W_V₂) g_Y₁
            (by
              change 𝟙 W_V₂ ≫ (p_fst ≫ h_W) = (g_Y ≫ p_ι) ≫ ι₁
              rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc g_Y p_ι ι₁, hp_ι]
              exact CategoryTheory.Limits.pullback.condition)
        let g_diag : LocallyConstant ↥W_V₂ (Fin N → ZMod m₁) :=
          g₁.comap ⟨Δ₁.base, AlgebraicGeometry.Scheme.Hom.continuous Δ₁⟩
        let cast_m := ZMod.castHom hdvd (ZMod m₁)
        let sec : ZMod m₁ → ZMod m₂ := fun a => Classical.choose (ZMod.castHom_surjective hdvd a)
        have hsec : ∀ a : ZMod m₁, cast_m (sec a) = a :=
          fun a => Classical.choose_spec (ZMod.castHom_surjective hdvd a)
        let g_tilde : LocallyConstant ↥W_V₂ (Fin N → ZMod m₂) :=
          g_diag.map (fun v i => sec (v i))

        
        have hEx_τ : ∀ y : ↥Y_V₂, ∃ τ : B₂ ≃ₐ[R₀] B₂, y ∈ Set.range (δ₂_ι τ).base := by
          intro y
          have hy : y ∈ (Set.univ : Set ↥Y_V₂) := Set.mem_univ y
          rwa [← hδ₂_ι_cov, Set.mem_iUnion] at hy
        let τ_of : ↥Y_V₂ → (B₂ ≃ₐ[R₀] B₂) := fun y => Classical.choose (hEx_τ y)
        have hτ_of_mem : ∀ y : ↥Y_V₂, y ∈ Set.range (δ₂_ι (τ_of y)).base :=
          fun y => Classical.choose_spec (hEx_τ y)
        let fst₂_cont : C(↥Y_V₂, ↥W_V₂) :=
          ⟨(CategoryTheory.Limits.pullback.fst h_Y ι₂).base,
            AlgebraicGeometry.Scheme.Hom.continuous _⟩
        let h_loc : (B₂ ≃ₐ[R₀] B₂) → LocallyConstant ↥Y_V₂ (Fin N → ZMod m₂) :=
          fun τ => (g_tilde.comap fst₂_cont).map (fun v => ((ρ₂ τ).val).mulVec v)
        let f₂_raw : ↥Y_V₂ → (Fin N → ZMod m₂) :=
          fun y => ((ρ₂ (τ_of y)).val).mulVec (g_tilde (fst₂_cont y))
        have hτ_of_eq : ∀ (τ : B₂ ≃ₐ[R₀] B₂) {y : ↥Y_V₂},
            y ∈ Set.range (δ₂_ι τ).base → τ_of y = τ := by
          intro τ y hy
          by_contra hne
          exact Set.disjoint_left.mp (hδ₂_ι_disj (τ_of y) τ hne) (hτ_of_mem y) hy
        have hf₂_on_U : ∀ (τ : B₂ ≃ₐ[R₀] B₂) {y : ↥Y_V₂},
            y ∈ Set.range (δ₂_ι τ).base → f₂_raw y = h_loc τ y := by
          intro τ y hy
          dsimp only [f₂_raw, h_loc]
          rw [hτ_of_eq τ hy]
          rfl
        have hf₂_loc : IsLocallyConstant f₂_raw := by
          intro S
          have hpre : f₂_raw ⁻¹' S =
              ⋃ τ : B₂ ≃ₐ[R₀] B₂, (Set.range (δ₂_ι τ).base ∩ ((h_loc τ) ⁻¹' S)) := by
            ext y
            simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_inter_iff]
            constructor
            · intro hyS
              refine ⟨τ_of y, hτ_of_mem y, ?_⟩
              rw [← hf₂_on_U (τ_of y) (hτ_of_mem y)]
              exact hyS
            · rintro ⟨τ, hyU, hyh⟩
              rw [hf₂_on_U τ hyU]
              exact hyh
          rw [hpre]
          exact isOpen_iUnion fun τ => (hδ₂_ι_open τ).inter ((h_loc τ).isLocallyConstant S)
        let f₂ : LocallyConstant ↥Y_V₂ (Fin N → ZMod m₂) := ⟨f₂_raw, hf₂_loc⟩
        have hf₂_sheet : ∀ (τ : B₂ ≃ₐ[R₀] B₂) (w : ↥W_V₂),
            f₂ ((δ₂_ι τ).base w) = ((ρ₂ τ).val).mulVec (g_tilde w) := by
          intro τ w
          change f₂_raw ((δ₂_ι τ).base w) = ((ρ₂ τ).val).mulVec (g_tilde w)
          rw [hf₂_on_U τ ⟨w, rfl⟩]
          have hfst_w : fst₂_cont ((δ₂_ι τ).base w) = w :=
            congrArg (fun m : W_V₂ ⟶ W_V₂ => m.base w) (hδ₂_ι_fst τ)
          change ((ρ₂ τ).val).mulVec (g_tilde (fst₂_cont ((δ₂_ι τ).base w))) =
            ((ρ₂ τ).val).mulVec (g_tilde w)
          rw [hfst_w]

        
        have hf₂_mem : f₂ ∈ Set.range (triv₂ Y) := by
          rw [(htriv₂_spec Y).2]
          refine ⟨⟨⊥, ?_, ?_⟩, ?_⟩
          · rw [sup_bot_eq]
            ext w
            refine ⟨fun _ => TopologicalSpace.Opens.mem_top w, fun _ => ?_⟩
            change h_Y.base w ∈ (U₀ : Set D_left)
            have hw_eq : h_Y.base w = U₀.ι.base ((g_Y ≫ π₂).base w) :=
              congrArg (fun m : W_V₂ ⟶ D_left => m.base w) hh_Y
            rw [hw_eq, ← AlgebraicGeometry.Scheme.Opens.range_ι U₀]
            exact ⟨(g_Y ≫ π₂).base w, rfl⟩
          · intro y hy_bot
            change False at hy_bot
            exact False.elim hy_bot
          · intro τ m_τ hm_fst hm_snd y
            obtain ⟨w, hw⟩ := hτ_of_mem y
            set σ := τ_of y
            rw [← hw]
            have hm_pt : m_τ.base ((δ₂_ι σ).base w) = (δ₂_ι (τ * σ)).base w :=
              congrArg (fun m : W_V₂ ⟶ Y_V₂ => m.base w) (hδ₂_ι_mul σ τ m_τ hm_fst hm_snd)
            rw [hm_pt, hf₂_sheet (τ * σ) w, hf₂_sheet σ w, map_mul, Units.val_mul,
              Matrix.mulVec_mulVec]
        rcases hf₂_mem with ⟨s₂, hs₂⟩

        
        have hs₂_eq : (τ_𝒥.hom.app (Opposite.op Y)) s₂ = s₁_Y := by
          apply (htriv₁_spec Y).1
          let t₁ := triv₁ Y ((τ_𝒥.hom.app (Opposite.op Y)) s₂)
          change t₁ = g₁
          let m_ι : Y_V₂ ⟶ Y_V₁ :=
            CategoryTheory.Limits.pullback.lift
              (CategoryTheory.Limits.pullback.fst h_Y ι₂)
              (CategoryTheory.Limits.pullback.snd h_Y ι₂ ≫ p_ι)
              (by rw [CategoryTheory.Category.assoc, hp_ι,
                    CategoryTheory.Limits.pullback.condition])
          have hΔ₁_eq : δ₂_ι 1 ≫ m_ι = Δ₁ := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · exact (CategoryTheory.Category.assoc (δ₂_ι 1) m_ι _).trans
                ((congrArg (δ₂_ι 1 ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  ((hδ₂_ι_fst 1).trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm))
            · have hid_spec : AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (1 : B₂ ≃ₐ[R₀] B₂).symm.toRingHom) = 𝟙 V₂ := by
                have hid_ring : CommRingCat.ofHom (1 : B₂ ≃ₐ[R₀] B₂).symm.toRingHom =
                    𝟙 (CommRingCat.of B₂) := by
                  apply CommRingCat.hom_ext
                  rfl
                rw [hid_ring, AlgebraicGeometry.Spec.map_id]
              have hsnd1 : (δ₂_ι 1 ≫ m_ι) ≫ CategoryTheory.Limits.pullback.snd h_Y ι₁ =
                  (δ₂_ι 1 ≫ CategoryTheory.Limits.pullback.snd h_Y ι₂) ≫ p_ι :=
                (CategoryTheory.Category.assoc (δ₂_ι 1) m_ι _).trans
                  ((congrArg (δ₂_ι 1 ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                    (CategoryTheory.Category.assoc _ _ _).symm)
              have hsnd2 : (δ₂_ι 1 ≫ CategoryTheory.Limits.pullback.snd h_Y ι₂) ≫ p_ι = g_Y₁ := by
                rw [hδ₂_ι_snd 1, hid_spec, CategoryTheory.Category.comp_id]
              exact hsnd1.trans (hsnd2.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm)
          have ht₁_Δ₁ : ∀ w : ↥W_V₂, t₁ (Δ₁.base w) = g₁ (Δ₁.base w) := by
            intro w
            funext i
            have hw_pt : Δ₁.base w = m_ι.base ((δ₂_ι 1).base w) :=
              congrArg (fun m : W_V₂ ⟶ Y_V₁ => m.base w) hΔ₁_eq.symm
            rw [hw_pt]
            have htr := htriv_trans Y s₂ m_ι
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _) ((δ₂_ι 1).base w) i
            dsimp only [t₁]
            rw [htr, hs₂]
            have hf₂_one : f₂ ((δ₂_ι 1).base w) = g_tilde w := by
              rw [hf₂_sheet 1 w, map_one, Units.val_one, Matrix.one_mulVec]
            rw [hf₂_one, ← hw_pt]
            exact hsec (g₁ (Δ₁.base w) i)

          have ht₁_mem : t₁ ∈ Set.range (triv₁ Y) := ⟨(τ_𝒥.hom.app (Opposite.op Y)) s₂, rfl⟩
          have hg₁_mem : g₁ ∈ Set.range (triv₁ Y) := ⟨s₁_Y, rfl⟩
          rw [(htriv₁_spec Y).2] at ht₁_mem hg₁_mem

          apply LocallyConstant.ext
          intro z
          have hz : z ∈ (Set.univ : Set ↥Y_V₁) := Set.mem_univ z
          rw [← hδ₁_ι_cov, Set.mem_iUnion] at hz
          rcases hz with ⟨σ, w, rfl⟩
          have hσ_ι₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ≫ ι₁ =
              ι₁ := by
            dsimp only [ι₁, π₁]
            rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
              ← AlgebraicGeometry.Spec.map_comp]
            congr 3
            apply CommRingCat.hom_ext
            ext r
            exact σ.symm.commutes r
          let m₁_σ : Y_V₁ ⟶ Y_V₁ :=
            CategoryTheory.Limits.pullback.lift
              (CategoryTheory.Limits.pullback.fst h_Y ι₁)
              (CategoryTheory.Limits.pullback.snd h_Y ι₁ ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom))
              (by rw [CategoryTheory.Category.assoc, hσ_ι₁,
                    CategoryTheory.Limits.pullback.condition])
          have hΔ₁_σ : Δ₁ ≫ m₁_σ = δ₁_ι σ :=
            CategoryTheory.Limits.pullback.hom_ext
              ((CategoryTheory.Category.assoc Δ₁ m₁_σ _).trans
                ((congrArg (Δ₁ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                    (hδ₁_ι_fst σ).symm)))
              ((CategoryTheory.Category.assoc Δ₁ m₁_σ _).trans
                ((congrArg (Δ₁ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                  ((CategoryTheory.Category.assoc Δ₁ _ _).symm.trans
                    ((congrArg (· ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom))
                      (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                      (hδ₁_ι_snd σ).symm))))
          have hpt_σ : (δ₁_ι σ).base w = m₁_σ.base (Δ₁.base w) :=
            congrArg (fun m : W_V₂ ⟶ Y_V₁ => m.base w) hΔ₁_σ.symm
          rw [hpt_σ,
            ht₁_mem.2 σ m₁_σ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _) (Δ₁.base w),
            hg₁_mem.2 σ m₁_σ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _) (Δ₁.base w),
            ht₁_Δ₁ w]

        have hEt_u : AlgebraicGeometry.Etale (Fgt.map u).left := by
          change AlgebraicGeometry.Etale p_fst
          exact hp_fst_et
        refine ⟨Y, u, y₀, ?_, hEt_u, hy₀_fst⟩
        rw [CategoryTheory.Presheaf.imageSieve_apply]
        exact ⟨s₂, hs₂_eq⟩

      · 
        have : AlgebraicGeometry.Etale h_W := W.prop
        let Y : D_left.Etale := AlgebraicGeometry.Scheme.Etale.mk (W₀.ι ≫ h_W)
        let u : Y ⟶ W := CategoryTheory.MorphismProperty.Over.homMk W₀.ι rfl
        let h_Y := (Fgt.obj Y).hom
        have hx_range : x ∈ Set.range W₀.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι W₀]
          exact hxW₀
        rcases hx_range with ⟨y₀, hy₀⟩
        let u_V : CategoryTheory.Limits.pullback h_Y ι₁ ⟶
            CategoryTheory.Limits.pullback h_W ι₁ :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst h_Y ι₁ ≫ W₀.ι)
            (CategoryTheory.Limits.pullback.snd h_Y ι₁)
            ((CategoryTheory.Category.assoc
                (CategoryTheory.Limits.pullback.fst h_Y ι₁) W₀.ι h_W).trans
              (CategoryTheory.Limits.pullback.condition (f := h_Y) (g := ι₁)))
        have hs₁_zero : (𝒥₁.obj.map (Opposite.op u)) s₁ = 0 := by
          apply (htriv₁_spec Y).1
          refine (LocallyConstant.ext fun z => ?_).trans (map_zero (triv₁ Y)).symm
          have hnat := htriv₁_nat u u_V
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) s₁ z
          have hz0 : triv₁ W s₁ (u_V.base z) = 0 := by
            apply hZero (u_V.base z)
            have hpt : (CategoryTheory.Limits.pullback.fst h_W ι₁).base (u_V.base z) =
                W₀.ι.base ((CategoryTheory.Limits.pullback.fst h_Y ι₁).base z) :=
              congrArg (fun m : CategoryTheory.Limits.pullback h_Y ι₁ ⟶ (Fgt.obj W).left => m.base z)
                (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            change (CategoryTheory.Limits.pullback.fst h_W ι₁).base (u_V.base z) ∈ (W₀ : Set _)
            rw [hpt, ← AlgebraicGeometry.Scheme.Opens.range_ι W₀]
            exact ⟨(CategoryTheory.Limits.pullback.fst h_Y ι₁).base z, rfl⟩
          exact (hnat.trans hz0).trans (LocallyConstant.zero_apply z).symm
        have hEt_u : AlgebraicGeometry.Etale (Fgt.map u).left := by
          change AlgebraicGeometry.Etale W₀.ι
          infer_instance
        refine ⟨Y, u, y₀, ?_, hEt_u, hy₀⟩
        rw [CategoryTheory.Presheaf.imageSieve_apply]
        exact ⟨0, (map_zero _).trans hs₁_zero.symm⟩
    exact CategoryTheory.Sheaf.epi_of_isLocallySurjective τ_𝒥

  exact ⟨hTors, hEpi⟩

theorem weil_coinv_single_level_sheaf_hom_descent_and_frob_square (D_left S : AlgebraicGeometry.Scheme.{u})
    (pr_D : S ⟶ D_left)
    (hCont_pr : (weilEtaleSitePullback pr_D).IsContinuous
      D_left.smallEtaleTopology S.smallEtaleTopology)
    (hAdj_pr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilEtaleSitePullback pr_D) AddCommGrpCat.{u} _
      D_left.smallEtaleTopology S.smallEtaleTopology hCont_pr).IsRightAdjoint)
    (U₀ : D_left.Opens)
    (R₀ B : Type u) [CommRing R₀] [CommRing B] [Algebra R₀ B]
    (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme)
    (hπ_et : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom))
    (hSheets :
      let V := AlgebraicGeometry.Spec (CommRingCat.of B)
      let π : V ⟶ U₀.toScheme :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom
      ∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V),
        let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ π) π
        ∃ δ : (B ≃ₐ[R₀] B) → (Y ⟶ Y_V),
          (∀ σ : B ≃ₐ[R₀] B,
            δ σ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π = 𝟙 Y ∧
            δ σ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π =
              g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ∧
            AlgebraicGeometry.Etale (δ σ) ∧
            IsOpen (Set.range (δ σ).base)) ∧
          (∀ σ₁ σ₂ : B ≃ₐ[R₀] B, σ₁ ≠ σ₂ →
            Disjoint (Set.range (δ σ₁).base) (Set.range (δ σ₂).base)) ∧
          (⋃ σ : B ≃ₐ[R₀] B, Set.range (δ σ).base) = Set.univ ∧
          (∀ (σ τ : B ≃ₐ[R₀] B) (m_τ : Y_V ⟶ Y_V),
            m_τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π =
              CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π →
            m_τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π =
              CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
            δ σ ≫ m_τ = δ (τ * σ)))
    (V_bar : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥V_bar]
    (q_V : V_bar ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
    (p_Vbar : V_bar ⟶ S) [AlgebraicGeometry.Etale p_Vbar]
    (hp_comm :
      q_V ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom) ≫
            U₀.ι =
        p_Vbar ≫ pr_D)
    (hp_range : Set.range p_Vbar.base = pr_D.base ⁻¹' (U₀ : Set D_left))
    (Γ_geom : Set (B ≃ₐ[R₀] B))
    (d_bar : ∀ σ : B ≃ₐ[R₀] B, σ ∈ Γ_geom → (V_bar ⟶ V_bar))
    (hd_bar : ∀ (σ : B ≃ₐ[R₀] B) (hσ : σ ∈ Γ_geom),
      d_bar σ hσ ≫ p_Vbar = p_Vbar ∧
      d_bar σ hσ ≫ q_V =
        q_V ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom))
    (hFibTrans : ∀ (X : AlgebraicGeometry.Scheme.{u}) (g_S : X ⟶ S)
        (y₁ y₂ : ↥(CategoryTheory.Limits.pullback g_S p_Vbar)),
      (CategoryTheory.Limits.pullback.fst g_S p_Vbar).base y₁ =
        (CategoryTheory.Limits.pullback.fst g_S p_Vbar).base y₂ →
      ∃ (σ : B ≃ₐ[R₀] B) (hσ : σ ∈ Γ_geom)
        (m_tilde : CategoryTheory.Limits.pullback g_S p_Vbar ⟶
          CategoryTheory.Limits.pullback g_S p_Vbar),
        m_tilde ≫ CategoryTheory.Limits.pullback.fst g_S p_Vbar =
          CategoryTheory.Limits.pullback.fst g_S p_Vbar ∧
        m_tilde ≫ CategoryTheory.Limits.pullback.snd g_S p_Vbar =
          CategoryTheory.Limits.pullback.snd g_S p_Vbar ≫ d_bar σ hσ ∧
        m_tilde.base y₁ = y₂)
    (m N : ℕ) (hm : 1 ≤ m)
    (τ_rep : (B ≃ₐ[R₀] B) →* (Matrix (Fin N) (Fin N) (ZMod m))ˣ)
    (H_mat : Set (Matrix (Fin N) (Fin N) (ZMod m)))
    (hΓ_to_H : ∀ σ ∈ Γ_geom, (τ_rep σ).val ∈ H_mat)
    (hH_to_Γ : ∀ h ∈ H_mat, ∃ σ ∈ Γ_geom, (τ_rep σ).val = h)
    (𝒥 : CategoryTheory.Sheaf D_left.smallEtaleTopology AddCommGrpCat.{u})
    (triv_! :
      let V := AlgebraicGeometry.Spec (CommRingCat.of B)
      let π : V ⟶ U₀.toScheme :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom
      let ι : V ⟶ D_left := π ≫ U₀.ι
      ∀ W : D_left.Etale,
        ↑(𝒥.obj.obj (Opposite.op W)) →+
          LocallyConstant
            ↥(CategoryTheory.Limits.pullback
              ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom ι)
            (Fin N → ZMod m))
    (htriv_nat :
      let V := AlgebraicGeometry.Spec (CommRingCat.of B)
      let π : V ⟶ U₀.toScheme :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom
      let ι : V ⟶ D_left := π ≫ U₀.ι
      ∀ {W₁ W₂ : D_left.Etale} (u : Quiver.Hom W₁ W₂),
        let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W₁).hom
        let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W₂).hom
        let W₁_V := CategoryTheory.Limits.pullback h₁ ι
        let W₂_V := CategoryTheory.Limits.pullback h₂ ι
        ∀ (u_V : Quiver.Hom W₁_V W₂_V),
          CategoryTheory.CategoryStruct.comp u_V (CategoryTheory.Limits.pullback.fst h₂ ι) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst h₁ ι)
              ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u).left →
          CategoryTheory.CategoryStruct.comp u_V (CategoryTheory.Limits.pullback.snd h₂ ι) =
            CategoryTheory.Limits.pullback.snd h₁ ι →
          ∀ (s : ↑(𝒥.obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_V),
            triv_! W₁ ((𝒥.obj.map (Opposite.op u)) s) y₁ = triv_! W₂ s (u_V.base y₁))
    (htriv_spec :
      let V := AlgebraicGeometry.Spec (CommRingCat.of B)
      let π : V ⟶ U₀.toScheme :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom
      let ι : V ⟶ D_left := π ≫ U₀.ι
      ∀ W : D_left.Etale,
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
        let W_V := CategoryTheory.Limits.pullback h_W ι
        Function.Injective (triv_! W) ∧
        Set.range (triv_! W) =
          { f |
            (∃ W₀ : ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).left.Opens,
              ((TopologicalSpace.Opens.map h_W.base).obj U₀) ⊔ W₀ = ⊤ ∧
              ∀ y : ↥W_V,
                (CategoryTheory.Limits.pullback.fst h_W ι).base y ∈ W₀ → f y = 0) ∧
            (∀ (σ : B ≃ₐ[R₀] B) (m_σ : Quiver.Hom W_V W_V),
              CategoryTheory.CategoryStruct.comp m_σ
                  (CategoryTheory.Limits.pullback.fst h_W ι) =
                CategoryTheory.Limits.pullback.fst h_W ι →
              CategoryTheory.CategoryStruct.comp m_σ
                  (CategoryTheory.Limits.pullback.snd h_W ι) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W ι)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
              ∀ y : ↥W_V, f (m_σ.base y) = ((τ_rep σ).val).mulVec (f y)) })
    (θ_S : ∀ Y : S.Etale,
      LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y).left (ULift.{u} (ZMod m)) →+
        ↑((weilEtaleTorsionSheaf S m).obj.obj (Opposite.op Y)))
    (hθ_bij : ∀ Y : S.Etale, Function.Bijective (θ_S Y))
    (hθ_nat : ∀ {Y₁ Y₂ : S.Etale} (f : Y₁ ⟶ Y₂)
      (g : LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y₂).left
        (ULift.{u} (ZMod m))),
      ((weilEtaleTorsionSheaf S m).obj.map (Opposite.op f)).hom (θ_S Y₂ g) =
        θ_S Y₁ (g.comap ((AlgebraicGeometry.Scheme.Etale.forget S).map f).left.base.hom)) :
    let B_pr := weilEtaleSitePullback pr_D
    let R_pr := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      B_pr AddCommGrpCat.{u} _
      D_left.smallEtaleTopology S.smallEtaleTopology hCont_pr
    let V := AlgebraicGeometry.Spec (CommRingCat.of B)
    let π : V ⟶ U₀.toScheme :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom
    let ι : V ⟶ D_left := π ≫ U₀.ι
    let Inv_m := { lam : Fin N → ZMod m // ∀ h ∈ H_mat, (h.transpose).mulVec lam = lam }
    ∃ η_α : Inv_m → Quiver.Hom 𝒥 (R_pr.obj (weilEtaleTorsionSheaf S m)),
      Function.Bijective η_α ∧
      (∀ lam₁ lam₂ lam₃ : Inv_m,
        lam₃.1 = lam₁.1 + lam₂.1 → η_α lam₃ = η_α lam₁ + η_α lam₂) ∧
      (∀ (lam : Inv_m) (W : D_left.Etale),
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
        ∀ (s₀ : ↑(𝒥.obj.obj (Opposite.op W)))
          (g_out : LocallyConstant
            ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj (B_pr.obj W)).left
            (ULift.{u} (ZMod m))),
          θ_S (B_pr.obj W) g_out = ((η_α lam).hom.app (Opposite.op W)).hom s₀ →
          ∀ z : ↥(CategoryTheory.Limits.pullback h_W pr_D),
            (h_W.base ((CategoryTheory.Limits.pullback.fst h_W pr_D).base z) ∉
                (U₀ : Set D_left) →
              g_out z = 0) ∧
            (∀ (w_tilde : ↥(CategoryTheory.Limits.pullback
                (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar))
              (ρ_W : CategoryTheory.Limits.pullback
                (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar ⟶
                CategoryTheory.Limits.pullback h_W ι),
              (CategoryTheory.Limits.pullback.fst
                (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar).base w_tilde = z →
              ρ_W ≫ CategoryTheory.Limits.pullback.fst h_W ι =
                CategoryTheory.Limits.pullback.fst
                  (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar ≫
                CategoryTheory.Limits.pullback.fst h_W pr_D →
              ρ_W ≫ CategoryTheory.Limits.pullback.snd h_W ι =
                CategoryTheory.Limits.pullback.snd
                  (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar ≫ q_V →
              g_out z = ULift.up (dotProduct lam.1 (triv_! W s₀ (ρ_W.base w_tilde))))) :=
by
  classical
  intro B_pr R_pr V π ι Inv_m
  have _ : NeZero m := ⟨by omega⟩
  have hp_comm' : q_V ≫ ι = p_Vbar ≫ pr_D := hp_comm

  
  
  
  have h_deck_π : ∀ σ : B ≃ₐ[R₀] B,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ≫ π = π := by
    intro σ
    dsimp only [π]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    congr 2
    apply CommRingCat.hom_ext
    ext r
    exact σ.symm.commutes r

  have h_deck_ι : ∀ σ : B ≃ₐ[R₀] B,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ≫ ι = ι := by
    intro σ
    dsimp only [ι]
    rw [← CategoryTheory.Category.assoc, h_deck_π σ]

  have h_spec_one :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (1 : B ≃ₐ[R₀] B).symm.toRingHom) = 𝟙 V := by
    have h1 : CommRingCat.ofHom (1 : B ≃ₐ[R₀] B).symm.toRingHom = 𝟙 (CommRingCat.of B) := by
      apply CommRingCat.hom_ext
      ext b
      rfl
    rw [h1, AlgebraicGeometry.Spec.map_id]

  let u_Z_of : ∀ {W₁ W₂ : D_left.Etale}, (W₁ ⟶ W₂) →
      (CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W₁).hom pr_D ⟶
       CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W₂).hom pr_D) :=
    fun u => ((AlgebraicGeometry.Scheme.Etale.forget S).map (B_pr.map u)).left

  have hB_pr_fst : ∀ {W₁ W₂ : D_left.Etale} (u : W₁ ⟶ W₂),
      u_Z_of u ≫
        CategoryTheory.Limits.pullback.fst
          ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W₂).hom pr_D =
      CategoryTheory.Limits.pullback.fst
        ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W₁).hom pr_D ≫
        ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u).left :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _

  have hB_pr_snd : ∀ {W₁ W₂ : D_left.Etale} (u : W₁ ⟶ W₂),
      u_Z_of u ≫
        CategoryTheory.Limits.pullback.snd
          ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W₂).hom pr_D =
      CategoryTheory.Limits.pullback.snd
        ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W₁).hom pr_D :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _

  have htriv_mem : ∀ (W : D_left.Etale) (s₀ : ↑(𝒥.obj.obj (Opposite.op W))),
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
      let W_V := CategoryTheory.Limits.pullback h_W ι
      (∃ W₀ : ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).left.Opens,
        ((TopologicalSpace.Opens.map h_W.base).obj U₀) ⊔ W₀ = ⊤ ∧
        ∀ y : ↥W_V,
          (CategoryTheory.Limits.pullback.fst h_W ι).base y ∈ W₀ → triv_! W s₀ y = 0) ∧
      (∀ (σ : B ≃ₐ[R₀] B) (m_σ : Quiver.Hom W_V W_V),
        CategoryTheory.CategoryStruct.comp m_σ
            (CategoryTheory.Limits.pullback.fst h_W ι) =
          CategoryTheory.Limits.pullback.fst h_W ι →
        CategoryTheory.CategoryStruct.comp m_σ
            (CategoryTheory.Limits.pullback.snd h_W ι) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Limits.pullback.snd h_W ι)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
        ∀ y : ↥W_V, triv_! W s₀ (m_σ.base y) = ((τ_rep σ).val).mulVec (triv_! W s₀ y)) := by
    intro W s₀
    have hmem : triv_! W s₀ ∈ Set.range (triv_! W) := ⟨s₀, rfl⟩
    rwa [(htriv_spec W).2] at hmem

  
  
  
  let ρ_can : ∀ W : D_left.Etale,
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
      CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar ⟶
        CategoryTheory.Limits.pullback h_W ι := fun W =>
    let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
    let fst_Z := CategoryTheory.Limits.pullback.fst h_W pr_D
    let snd_Z := CategoryTheory.Limits.pullback.snd h_W pr_D
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst snd_Z p_Vbar ≫ fst_Z)
      (CategoryTheory.Limits.pullback.snd snd_Z p_Vbar ≫ q_V)
      (by
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
          CategoryTheory.Category.assoc, ← hp_comm', ← CategoryTheory.Category.assoc])

  have hρ_can_fst : ∀ W : D_left.Etale,
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
      ρ_can W ≫ CategoryTheory.Limits.pullback.fst h_W ι =
        CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar ≫
          CategoryTheory.Limits.pullback.fst h_W pr_D :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _

  have hρ_can_snd : ∀ W : D_left.Etale,
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
      ρ_can W ≫ CategoryTheory.Limits.pullback.snd h_W ι =
        CategoryTheory.Limits.pullback.snd (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar ≫
          q_V :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _

  have h_mem_range : ∀ (W : D_left.Etale)
      (z : ↥(CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom pr_D)),
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
      (∃ w_tilde : ↥(CategoryTheory.Limits.pullback
          (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar),
        (CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar).base w_tilde = z) ↔
      h_W.base ((CategoryTheory.Limits.pullback.fst h_W pr_D).base z) ∈ (U₀ : Set D_left) := by
    intro W z h_W
    have hcond_z : h_W.base ((CategoryTheory.Limits.pullback.fst h_W pr_D).base z) =
        pr_D.base ((CategoryTheory.Limits.pullback.snd h_W pr_D).base z) :=
      congrArg (fun m : CategoryTheory.Limits.pullback h_W pr_D ⟶ D_left => m.base z)
        (CategoryTheory.Limits.pullback.condition (f := h_W) (g := pr_D))
    constructor
    · rintro ⟨w_tilde, hw⟩
      have hsnd_eq : (CategoryTheory.Limits.pullback.snd h_W pr_D).base z =
          p_Vbar.base
            ((CategoryTheory.Limits.pullback.snd
              (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar).base w_tilde) := by
        rw [← hw]
        exact congrArg
          (fun m : CategoryTheory.Limits.pullback
              (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar ⟶ S => m.base w_tilde)
          (CategoryTheory.Limits.pullback.condition
            (f := CategoryTheory.Limits.pullback.snd h_W pr_D) (g := p_Vbar))
      have hmem_p : (CategoryTheory.Limits.pullback.snd h_W pr_D).base z ∈ Set.range p_Vbar.base :=
        ⟨_, hsnd_eq.symm⟩
      rw [hp_range] at hmem_p
      rw [hcond_z]
      exact hmem_p
    · intro hzU
      rw [hcond_z] at hzU
      have hmem_p : (CategoryTheory.Limits.pullback.snd h_W pr_D).base z ∈ Set.range p_Vbar.base := by
        rw [hp_range]
        exact hzU
      rcases hmem_p with ⟨x_bar, hx_bar⟩
      obtain ⟨w_tilde, hw_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z x_bar hx_bar.symm
      exact ⟨w_tilde, hw_fst⟩

  have h_fib_const : ∀ (lam : Inv_m) (W : D_left.Etale)
      (s₀ : ↑(𝒥.obj.obj (Opposite.op W)))
      (w₁ w₂ : ↥(CategoryTheory.Limits.pullback
        (CategoryTheory.Limits.pullback.snd
          ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom pr_D) p_Vbar)),
      (CategoryTheory.Limits.pullback.fst
        (CategoryTheory.Limits.pullback.snd
          ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom pr_D) p_Vbar).base w₁ =
      (CategoryTheory.Limits.pullback.fst
        (CategoryTheory.Limits.pullback.snd
          ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom pr_D) p_Vbar).base w₂ →
      ULift.up (dotProduct lam.1 (triv_! W s₀ ((ρ_can W).base w₁))) =
        ULift.up (dotProduct lam.1 (triv_! W s₀ ((ρ_can W).base w₂))) := by
    intro lam W s₀ w₁ w₂ hw
    let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
    let snd_Z := CategoryTheory.Limits.pullback.snd h_W pr_D
    obtain ⟨σ, hσ, m_tilde, hm_fst, hm_snd, hm_pt⟩ := hFibTrans _ snd_Z w₁ w₂ hw
    let m_σ : CategoryTheory.Limits.pullback h_W ι ⟶ CategoryTheory.Limits.pullback h_W ι :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst h_W ι)
        (CategoryTheory.Limits.pullback.snd h_W ι ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom))
        (by rw [CategoryTheory.Category.assoc, h_deck_ι σ,
              CategoryTheory.Limits.pullback.condition])
    have hρ_inter : m_tilde ≫ ρ_can W = ρ_can W ≫ m_σ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          hρ_can_fst W, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc m_tilde, hm_fst, hρ_can_fst W]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          hρ_can_snd W, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc m_tilde, hm_snd, CategoryTheory.Category.assoc,
          (hd_bar σ hσ).2, ← CategoryTheory.Category.assoc (ρ_can W),
          hρ_can_snd W, CategoryTheory.Category.assoc]
    have hρ_pt : (ρ_can W).base w₂ = m_σ.base ((ρ_can W).base w₁) := by
      rw [← hm_pt]
      exact congrArg
        (fun m : CategoryTheory.Limits.pullback snd_Z p_Vbar ⟶
            CategoryTheory.Limits.pullback h_W ι => m.base w₁)
        hρ_inter
    have htriv_eq := (htriv_mem W s₀).2 σ m_σ
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      ((ρ_can W).base w₁)
    apply congrArg ULift.up
    rw [hρ_pt, htriv_eq, Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose,
      lam.2 _ (hΓ_to_H σ hσ)]

  let F_fn : ∀ (_lam : Inv_m) (W : D_left.Etale) (_s₀ : ↑(𝒥.obj.obj (Opposite.op W))),
      ↥(CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom pr_D) →
        ULift.{u} (ZMod m) :=
    fun lam W s₀ z =>
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
      if hz : ∃ w_tilde : ↥(CategoryTheory.Limits.pullback
          (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar),
        (CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar).base w_tilde = z
      then ULift.up (dotProduct lam.1 (triv_! W s₀ ((ρ_can W).base (Classical.choose hz))))
      else 0

  have hF_fn_eq : ∀ (lam : Inv_m) (W : D_left.Etale) (s₀ : ↑(𝒥.obj.obj (Opposite.op W)))
      (z : ↥(CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom pr_D))
      (w_tilde : ↥(CategoryTheory.Limits.pullback
        (CategoryTheory.Limits.pullback.snd
          ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom pr_D) p_Vbar)),
      (CategoryTheory.Limits.pullback.fst
        (CategoryTheory.Limits.pullback.snd
          ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom pr_D) p_Vbar).base w_tilde = z →
      F_fn lam W s₀ z = ULift.up (dotProduct lam.1 (triv_! W s₀ ((ρ_can W).base w_tilde))) := by
    intro lam W s₀ z w_tilde hw
    dsimp only [F_fn]
    split_ifs with hz
    · exact h_fib_const lam W s₀ (Classical.choose hz) w_tilde
        ((Classical.choose_spec hz).trans hw.symm)
    · exact False.elim (hz ⟨w_tilde, hw⟩)

  have hF_fn_neg : ∀ (lam : Inv_m) (W : D_left.Etale) (s₀ : ↑(𝒥.obj.obj (Opposite.op W)))
      (z : ↥(CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom pr_D)),
      (¬ ∃ w_tilde : ↥(CategoryTheory.Limits.pullback
          (CategoryTheory.Limits.pullback.snd
            ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom pr_D) p_Vbar),
        (CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.snd
            ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom pr_D) p_Vbar).base w_tilde = z) →
      F_fn lam W s₀ z = 0 := by
    intro lam W s₀ z hno
    dsimp only [F_fn]
    split_ifs with hz
    · exact False.elim (hno hz)
    · rfl

  have hF_fn_lc : ∀ (lam : Inv_m) (W : D_left.Etale) (s₀ : ↑(𝒥.obj.obj (Opposite.op W))),
      IsLocallyConstant (F_fn lam W s₀) := by
    intro lam W s₀
    let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
    let fst_Z := CategoryTheory.Limits.pullback.fst h_W pr_D
    let snd_Z := CategoryTheory.Limits.pullback.snd h_W pr_D
    let π_Wtilde := CategoryTheory.Limits.pullback.fst snd_Z p_Vbar
    have _ : AlgebraicGeometry.Etale π_Wtilde :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback snd_Z p_Vbar).flip inferInstance
    have hOpen_π : IsOpenMap π_Wtilde.base := π_Wtilde.isOpenMap
    let g_tilde : ↥(CategoryTheory.Limits.pullback snd_Z p_Vbar) → ULift.{u} (ZMod m) :=
      fun w_tilde => ULift.up (dotProduct lam.1 (triv_! W s₀ ((ρ_can W).base w_tilde)))
    have hg_lc : IsLocallyConstant g_tilde :=
      ((triv_! W s₀).isLocallyConstant.comp_continuous
        (ρ_can W).base.hom.continuous).comp (fun v => ULift.up (dotProduct lam.1 v))
    obtain ⟨W₀, hCov, hZero⟩ := (htriv_mem W s₀).1
    have hF_W₀ : ∀ z : ↥(CategoryTheory.Limits.pullback h_W pr_D),
        fst_Z.base z ∈ W₀ → F_fn lam W s₀ z = 0 := by
      intro z hzW₀
      by_cases hz : ∃ w_tilde, π_Wtilde.base w_tilde = z
      · rcases hz with ⟨w_tilde, hw⟩
        rw [hF_fn_eq lam W s₀ z w_tilde hw]
        have hpt_W₀ : (CategoryTheory.Limits.pullback.fst h_W ι).base ((ρ_can W).base w_tilde) ∈ W₀ := by
          have h1 : (CategoryTheory.Limits.pullback.fst h_W ι).base ((ρ_can W).base w_tilde) =
              fst_Z.base (π_Wtilde.base w_tilde) :=
            congrArg
              (fun m : CategoryTheory.Limits.pullback snd_Z p_Vbar ⟶
                  ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).left => m.base w_tilde)
              (hρ_can_fst W)
          rwa [h1, hw]
        rw [hZero _ hpt_W₀, dotProduct_zero]
        rfl
      · exact hF_fn_neg lam W s₀ z hz
    rw [IsLocallyConstant.iff_isOpen_fiber]
    intro c
    by_cases hc : c = 0
    · subst hc
      have hset_eq : F_fn lam W s₀ ⁻¹' {(0 : ULift.{u} (ZMod m))} =
          (π_Wtilde.base '' (g_tilde ⁻¹' {0})) ∪ (fst_Z.base ⁻¹' (W₀ : Set _)) := by
        ext z
        constructor
        · intro hz0
          change F_fn lam W s₀ z = 0 at hz0
          by_cases hz : ∃ w_tilde, π_Wtilde.base w_tilde = z
          · rcases hz with ⟨w_tilde, hw⟩
            left
            exact ⟨w_tilde, (hF_fn_eq lam W s₀ z w_tilde hw).symm.trans hz0, hw⟩
          · right
            have hnotU : h_W.base (fst_Z.base z) ∉ (U₀ : Set D_left) :=
              mt (h_mem_range W z).mpr hz
            have htop : fst_Z.base z ∈
                (⊤ : ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).left.Opens) :=
              trivial
            rw [← hCov] at htop
            rcases htop with hxU | hxW₀
            · exact False.elim (hnotU hxU)
            · exact hxW₀
        · rintro (⟨w_tilde, hgw, rfl⟩ | hzW₀)
          · change F_fn lam W s₀ (π_Wtilde.base w_tilde) = 0
            exact (hF_fn_eq lam W s₀ (π_Wtilde.base w_tilde) w_tilde rfl).trans hgw
          · exact hF_W₀ z hzW₀
      rw [hset_eq]
      exact (hOpen_π _ (hg_lc {0})).union (W₀.isOpen.preimage fst_Z.base.hom.continuous)
    · have hset_eq : F_fn lam W s₀ ⁻¹' {c} = π_Wtilde.base '' (g_tilde ⁻¹' {c}) := by
        ext z
        constructor
        · intro hzc
          change F_fn lam W s₀ z = c at hzc
          by_cases hz : ∃ w_tilde, π_Wtilde.base w_tilde = z
          · rcases hz with ⟨w_tilde, hw⟩
            exact ⟨w_tilde, (hF_fn_eq lam W s₀ z w_tilde hw).symm.trans hzc, hw⟩
          · exfalso
            exact hc (hzc.symm.trans (hF_fn_neg lam W s₀ z hz))
        · rintro ⟨w_tilde, hgw, rfl⟩
          change F_fn lam W s₀ (π_Wtilde.base w_tilde) = c
          exact (hF_fn_eq lam W s₀ (π_Wtilde.base w_tilde) w_tilde rfl).trans hgw
      rw [hset_eq]
      exact hOpen_π _ (hg_lc {c})

  let F_α : ∀ (_lam : Inv_m) (W : D_left.Etale),
      ↑(𝒥.obj.obj (Opposite.op W)) →+
        LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj (B_pr.obj W)).left
          (ULift.{u} (ZMod m)) :=
    fun lam W =>
      { toFun := fun s₀ => ⟨F_fn lam W s₀, hF_fn_lc lam W s₀⟩
        map_zero' := by
          apply LocallyConstant.ext
          intro z
          change F_fn lam W 0 z = 0
          dsimp only [F_fn]
          split_ifs with hz
          · rw [map_zero]
            change ULift.up (dotProduct lam.1 0) = 0
            rw [dotProduct_zero]
            rfl
          · rfl
        map_add' := fun s₁ s₂ => by
          apply LocallyConstant.ext
          intro z
          change F_fn lam W (s₁ + s₂) z = F_fn lam W s₁ z + F_fn lam W s₂ z
          dsimp only [F_fn]
          split_ifs with hz
          · rw [map_add, LocallyConstant.add_apply, dotProduct_add]
            rfl
          · exact (zero_add 0).symm }

  let η_α : Inv_m → Quiver.Hom 𝒥 (R_pr.obj (weilEtaleTorsionSheaf S m)) :=
    fun lam =>
      { hom :=
          { app := fun W_op =>
              AddCommGrpCat.ofHom ((θ_S (B_pr.obj W_op.unop)).comp (F_α lam W_op.unop))
            naturality := fun {W₂_op W₁_op} u_op => by
              let W₁ : D_left.Etale := W₁_op.unop
              let W₂ : D_left.Etale := W₂_op.unop
              let u : W₁ ⟶ W₂ := u_op.unop
              apply AddCommGrpCat.ext
              intro s₂
              change θ_S (B_pr.obj W₁) (F_α lam W₁ ((𝒥.obj.map (Opposite.op u)) s₂)) =
                ((weilEtaleTorsionSheaf S m).obj.map (Opposite.op (B_pr.map u))).hom
                  (θ_S (B_pr.obj W₂) (F_α lam W₂ s₂))
              rw [hθ_nat (B_pr.map u)]
              congr 1
              apply LocallyConstant.ext
              intro z₁_raw
              let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W₁).hom
              let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W₂).hom
              let z₁ : ↥(CategoryTheory.Limits.pullback h₁ pr_D) := z₁_raw
              let u_Z : CategoryTheory.Limits.pullback h₁ pr_D ⟶
                  CategoryTheory.Limits.pullback h₂ pr_D := u_Z_of u
              let z₂ : ↥(CategoryTheory.Limits.pullback h₂ pr_D) := u_Z.base z₁
              change F_fn lam W₁ ((𝒥.obj.map (Opposite.op u)) s₂) z₁ = F_fn lam W₂ s₂ z₂
              have hz_base_eq :
                  h₂.base ((CategoryTheory.Limits.pullback.fst h₂ pr_D).base z₂) =
                  h₁.base ((CategoryTheory.Limits.pullback.fst h₁ pr_D).base z₁) := by
                have hfst_u : (CategoryTheory.Limits.pullback.fst h₂ pr_D).base z₂ =
                    ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u).left.base
                      ((CategoryTheory.Limits.pullback.fst h₁ pr_D).base z₁) :=
                  congrArg
                    (fun m : CategoryTheory.Limits.pullback h₁ pr_D ⟶
                        ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W₂).left => m.base z₁)
                    (hB_pr_fst u)
                rw [hfst_u]
                exact congrArg
                  (fun m : ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W₁).left ⟶
                      D_left => m.base ((CategoryTheory.Limits.pullback.fst h₁ pr_D).base z₁))
                  (((AlgebraicGeometry.Scheme.Etale.forget D_left).map u).w)
              by_cases hzU : h₁.base ((CategoryTheory.Limits.pullback.fst h₁ pr_D).base z₁) ∈
                  (U₀ : Set D_left)
              · obtain ⟨w₁, hw₁⟩ := (h_mem_range W₁ z₁).mpr hzU
                let π_W₁ := CategoryTheory.Limits.pullback.fst
                  (CategoryTheory.Limits.pullback.snd h₁ pr_D) p_Vbar
                let q_W₁ := CategoryTheory.Limits.pullback.snd
                  (CategoryTheory.Limits.pullback.snd h₁ pr_D) p_Vbar
                let π_W₂ := CategoryTheory.Limits.pullback.fst
                  (CategoryTheory.Limits.pullback.snd h₂ pr_D) p_Vbar
                let u_Wtilde :
                    CategoryTheory.Limits.pullback
                      (CategoryTheory.Limits.pullback.snd h₁ pr_D) p_Vbar ⟶
                    CategoryTheory.Limits.pullback
                      (CategoryTheory.Limits.pullback.snd h₂ pr_D) p_Vbar :=
                  CategoryTheory.Limits.pullback.lift
                    (π_W₁ ≫ u_Z)
                    q_W₁
                    (by rw [CategoryTheory.Category.assoc, hB_pr_snd u,
                          CategoryTheory.Limits.pullback.condition])
                let w₂ := u_Wtilde.base w₁
                have hw₂ : π_W₂.base w₂ = z₂ := by
                  have h1 : (u_Wtilde ≫ π_W₂).base w₁ = u_Z.base (π_W₁.base w₁) :=
                    congrArg
                      (fun m : CategoryTheory.Limits.pullback
                          (CategoryTheory.Limits.pullback.snd h₁ pr_D) p_Vbar ⟶
                        CategoryTheory.Limits.pullback h₂ pr_D => m.base w₁)
                      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                  exact h1.trans (congrArg u_Z.base hw₁)
                let u_V : CategoryTheory.Limits.pullback h₁ ι ⟶ CategoryTheory.Limits.pullback h₂ ι :=
                  CategoryTheory.Limits.pullback.lift
                    (CategoryTheory.Limits.pullback.fst h₁ ι ≫
                      ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u).left)
                    (CategoryTheory.Limits.pullback.snd h₁ ι)
                    (by
                      rw [CategoryTheory.Category.assoc,
                        ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u).w,
                        CategoryTheory.Limits.pullback.condition])
                have hρ_nat : u_Wtilde ≫ ρ_can W₂ = ρ_can W₁ ≫ u_V := by
                  apply CategoryTheory.Limits.pullback.hom_ext
                  · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                      hρ_can_fst W₂, CategoryTheory.Limits.pullback.lift_fst,
                      ← CategoryTheory.Category.assoc u_Wtilde,
                      CategoryTheory.Limits.pullback.lift_fst,
                      CategoryTheory.Category.assoc, hB_pr_fst u,
                      ← CategoryTheory.Category.assoc (ρ_can W₁),
                      hρ_can_fst W₁, CategoryTheory.Category.assoc]
                  · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                      hρ_can_snd W₂, CategoryTheory.Limits.pullback.lift_snd,
                      ← CategoryTheory.Category.assoc u_Wtilde,
                      CategoryTheory.Limits.pullback.lift_snd, hρ_can_snd W₁]
                have hρ_pt : (ρ_can W₂).base w₂ = u_V.base ((ρ_can W₁).base w₁) :=
                  congrArg
                    (fun m : CategoryTheory.Limits.pullback
                        (CategoryTheory.Limits.pullback.snd h₁ pr_D) p_Vbar ⟶
                      CategoryTheory.Limits.pullback h₂ ι => m.base w₁)
                    hρ_nat
                rw [hF_fn_eq lam W₁ ((𝒥.obj.map (Opposite.op u)) s₂) z₁ w₁ hw₁,
                  hF_fn_eq lam W₂ s₂ z₂ w₂ hw₂, hρ_pt,
                  htriv_nat u u_V (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                    (CategoryTheory.Limits.pullback.lift_snd _ _ _) s₂ ((ρ_can W₁).base w₁)]
              · have hzU₂ : h₂.base ((CategoryTheory.Limits.pullback.fst h₂ pr_D).base z₂) ∉
                    (U₀ : Set D_left) := by
                  rwa [hz_base_eq]
                have hno₁ : ¬ ∃ w₁, (CategoryTheory.Limits.pullback.fst
                    (CategoryTheory.Limits.pullback.snd h₁ pr_D) p_Vbar).base w₁ = z₁ :=
                  mt (h_mem_range W₁ z₁).mp hzU
                have hno₂ : ¬ ∃ w₂, (CategoryTheory.Limits.pullback.fst
                    (CategoryTheory.Limits.pullback.snd h₂ pr_D) p_Vbar).base w₂ = z₂ :=
                  mt (h_mem_range W₂ z₂).mp hzU₂
                rw [hF_fn_neg lam W₁ _ z₁ hno₁, hF_fn_neg lam W₂ _ z₂ hno₂] } }

  have hAdd_η : ∀ lam₁ lam₂ lam₃ : Inv_m,
      lam₃.1 = lam₁.1 + lam₂.1 → η_α lam₃ = η_α lam₁ + η_α lam₂ := by
    intro lam₁ lam₂ lam₃ hsum
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext W_op
    let W := W_op.unop
    apply AddCommGrpCat.ext
    intro s₀
    change θ_S (B_pr.obj W) (F_α lam₃ W s₀) =
      θ_S (B_pr.obj W) (F_α lam₁ W s₀) + θ_S (B_pr.obj W) (F_α lam₂ W s₀)
    rw [← map_add (θ_S (B_pr.obj W))]
    congr 1
    apply LocallyConstant.ext
    intro z_raw
    let z : ↥(CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom pr_D) := z_raw
    change F_fn lam₃ W s₀ z = F_fn lam₁ W s₀ z + F_fn lam₂ W s₀ z
    dsimp only [F_fn]
    split_ifs with hz
    · rw [hsum, add_dotProduct]
      rfl
    · exact (zero_add 0).symm

  have hEval_η : ∀ (lam : Inv_m) (W : D_left.Etale),
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
      ∀ (s₀ : ↑(𝒥.obj.obj (Opposite.op W)))
        (g_out : LocallyConstant
          ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj (B_pr.obj W)).left
          (ULift.{u} (ZMod m))),
        θ_S (B_pr.obj W) g_out = ((η_α lam).hom.app (Opposite.op W)).hom s₀ →
        ∀ z : ↥(CategoryTheory.Limits.pullback h_W pr_D),
          (h_W.base ((CategoryTheory.Limits.pullback.fst h_W pr_D).base z) ∉
              (U₀ : Set D_left) →
            g_out z = 0) ∧
          (∀ (w_tilde : ↥(CategoryTheory.Limits.pullback
              (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar))
            (ρ_W : CategoryTheory.Limits.pullback
              (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar ⟶
              CategoryTheory.Limits.pullback h_W ι),
            (CategoryTheory.Limits.pullback.fst
              (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar).base w_tilde = z →
            ρ_W ≫ CategoryTheory.Limits.pullback.fst h_W ι =
              CategoryTheory.Limits.pullback.fst
                (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar ≫
              CategoryTheory.Limits.pullback.fst h_W pr_D →
            ρ_W ≫ CategoryTheory.Limits.pullback.snd h_W ι =
              CategoryTheory.Limits.pullback.snd
                (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar ≫ q_V →
            g_out z = ULift.up (dotProduct lam.1 (triv_! W s₀ (ρ_W.base w_tilde)))) := by
    intro lam W h_W s₀ g_out hg_out z
    have hg_eq : g_out = F_α lam W s₀ := (hθ_bij (B_pr.obj W)).1 hg_out
    have hg_z : g_out z = F_fn lam W s₀ z := by
      rw [hg_eq]
      rfl
    refine ⟨?_, ?_⟩
    · intro hznotU
      have hno : ¬ ∃ w_tilde, (CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.snd h_W pr_D) p_Vbar).base w_tilde = z :=
        mt (h_mem_range W z).mp hznotU
      exact hg_z.trans (hF_fn_neg lam W s₀ z hno)
    · intro w_tilde ρ_W hw hρ_fst hρ_snd
      have hρ_eq : ρ_W = ρ_can W := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact hρ_fst.trans (hρ_can_fst W).symm
        · exact hρ_snd.trans (hρ_can_snd W).symm
      rw [hg_z, hF_fn_eq lam W s₀ z w_tilde hw, hρ_eq]

  
  
  
  
  have hι_et : AlgebraicGeometry.Etale ι := by
    have _ : AlgebraicGeometry.Etale π := hπ_et
    dsimp only [ι]
    infer_instance
  have _ : AlgebraicGeometry.Etale ι := hι_et

  have hSheets_ι : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V) (h_Y : Y ⟶ D_left),
      h_Y = g_Y ≫ ι →
      let P_ι := CategoryTheory.Limits.pullback h_Y ι
      ∃ δ : (B ≃ₐ[R₀] B) → (Y ⟶ P_ι),
        (∀ σ : B ≃ₐ[R₀] B,
          δ σ ≫ CategoryTheory.Limits.pullback.fst h_Y ι = 𝟙 Y ∧
          δ σ ≫ CategoryTheory.Limits.pullback.snd h_Y ι =
            g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ∧
          IsOpen (Set.range (δ σ).base)) ∧
        (∀ σ₁ σ₂ : B ≃ₐ[R₀] B, σ₁ ≠ σ₂ →
          Disjoint (Set.range (δ σ₁).base) (Set.range (δ σ₂).base)) ∧
        (⋃ σ : B ≃ₐ[R₀] B, Set.range (δ σ).base) = Set.univ ∧
        (∀ (σ τ : B ≃ₐ[R₀] B) (m_τ : P_ι ⟶ P_ι),
          m_τ ≫ CategoryTheory.Limits.pullback.fst h_Y ι =
            CategoryTheory.Limits.pullback.fst h_Y ι →
          m_τ ≫ CategoryTheory.Limits.pullback.snd h_Y ι =
            CategoryTheory.Limits.pullback.snd h_Y ι ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
          δ σ ≫ m_τ = δ (τ * σ)) := by
    intro Y g_Y h_Y hh_Y P_ι
    let P_π := CategoryTheory.Limits.pullback (g_Y ≫ π) π
    let φ : P_π ⟶ P_ι :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π)
        (CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π)
        (by
          rw [hh_Y]
          dsimp only [ι]
          rw [← CategoryTheory.Category.assoc g_Y π U₀.ι,
            ← CategoryTheory.Category.assoc _ (g_Y ≫ π) U₀.ι,
            CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc])
    let ψ : P_ι ⟶ P_π :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst h_Y ι)
        (CategoryTheory.Limits.pullback.snd h_Y ι)
        (by
          apply (cancel_mono U₀.ι).mp
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
          change CategoryTheory.Limits.pullback.fst h_Y ι ≫ (g_Y ≫ ι) =
            CategoryTheory.Limits.pullback.snd h_Y ι ≫ ι
          rw [← hh_Y]
          exact CategoryTheory.Limits.pullback.condition)
    have hφψ : φ ≫ ψ = 𝟙 P_π := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
    have hψφ : ψ ≫ φ = 𝟙 P_ι := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
    obtain ⟨δ_π, hδ_prop, hδ_disj, hδ_univ, hδ_act⟩ := hSheets Y g_Y
    let δ : (B ≃ₐ[R₀] B) → (Y ⟶ P_ι) := fun σ => δ_π σ ≫ φ
    have hrange_eq : ∀ σ : B ≃ₐ[R₀] B,
        Set.range (δ σ).base = ψ.base ⁻¹' Set.range (δ_π σ).base := by
      intro σ
      ext q
      constructor
      · rintro ⟨y, rfl⟩
        refine ⟨y, ?_⟩
        change (δ_π σ).base y = ((δ_π σ ≫ φ) ≫ ψ).base y
        rw [CategoryTheory.Category.assoc, hφψ, CategoryTheory.Category.comp_id]
      · rintro ⟨y, hy⟩
        refine ⟨y, ?_⟩
        have hq : φ.base (ψ.base q) = q :=
          congrArg (fun m : P_ι ⟶ P_ι => m.base q) hψφ
        change φ.base ((δ_π σ).base y) = q
        rwa [hy]
    refine ⟨δ, ?_, ?_, ?_, ?_⟩
    · intro σ
      refine ⟨?_, ?_, ?_⟩
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
        exact (hδ_prop σ).1
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
        exact (hδ_prop σ).2.1
      · rw [hrange_eq σ]
        exact (hδ_prop σ).2.2.2.preimage ψ.base.hom.continuous
    · intro σ₁ σ₂ hne
      rw [hrange_eq σ₁, hrange_eq σ₂]
      exact (hδ_disj σ₁ σ₂ hne).preimage ψ.base
    · ext q
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      have hq_univ : ψ.base q ∈ (⋃ σ : B ≃ₐ[R₀] B, Set.range (δ_π σ).base) := by
        rw [hδ_univ]
        trivial
      rw [Set.mem_iUnion] at hq_univ
      rcases hq_univ with ⟨σ, hmem⟩
      refine ⟨σ, ?_⟩
      rw [hrange_eq σ]
      exact hmem
    · intro σ τ m_τ hm_fst hm_snd
      let m'_τ : P_π ⟶ P_π := φ ≫ m_τ ≫ ψ
      have hm'_fst : m'_τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π =
          CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π := by
        dsimp only [m'_τ]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, hm_fst,
          CategoryTheory.Limits.pullback.lift_fst]
      have hm'_snd : m'_τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π =
          CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) := by
        dsimp only [m'_τ]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, hm_snd,
          ← CategoryTheory.Category.assoc φ, CategoryTheory.Limits.pullback.lift_snd]
      have hact := hδ_act σ τ m'_τ hm'_fst hm'_snd
      have hact_φ := congrArg (· ≫ φ) hact
      dsimp only [δ, m'_τ] at hact_φ ⊢
      rwa [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, hψφ, CategoryTheory.Category.comp_id,
        ← CategoryTheory.Category.assoc] at hact_φ

  have h_id_uniq : ∀ (W_Y : D_left.Etale)
      (g_Y : ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W_Y).left ⟶ V)
      (_hh_Y : ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W_Y).hom = g_Y ≫ ι)
      (δ : (B ≃ₐ[R₀] B) →
        (((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W_Y).left ⟶
          CategoryTheory.Limits.pullback
            ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W_Y).hom ι)),
      (⋃ σ : B ≃ₐ[R₀] B, Set.range (δ σ).base) = Set.univ →
      (∀ (σ τ : B ≃ₐ[R₀] B)
        (m_τ : CategoryTheory.Limits.pullback
            ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W_Y).hom ι ⟶
          CategoryTheory.Limits.pullback
            ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W_Y).hom ι),
        m_τ ≫ CategoryTheory.Limits.pullback.fst _ ι =
          CategoryTheory.Limits.pullback.fst _ ι →
        m_τ ≫ CategoryTheory.Limits.pullback.snd _ ι =
          CategoryTheory.Limits.pullback.snd _ ι ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
        δ σ ≫ m_τ = δ (τ * σ)) →
      ∀ s₁ s₂ : ↑(𝒥.obj.obj (Opposite.op W_Y)),
        (∀ y : ↥((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W_Y).left,
          triv_! W_Y s₁ ((δ 1).base y) = triv_! W_Y s₂ ((δ 1).base y)) →
        s₁ = s₂ := by
    intro W_Y g_Y _hh_Y δ hδ_univ hδ_act s₁ s₂ h_eq_id
    apply (htriv_spec W_Y).1
    apply LocallyConstant.ext
    intro q
    let h_Y := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W_Y).hom
    have hq_mem : q ∈ (⋃ σ : B ≃ₐ[R₀] B, Set.range (δ σ).base) := by
      rw [hδ_univ]
      trivial
    rw [Set.mem_iUnion] at hq_mem
    rcases hq_mem with ⟨σ, y, rfl⟩
    let m_σ : CategoryTheory.Limits.pullback h_Y ι ⟶ CategoryTheory.Limits.pullback h_Y ι :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst h_Y ι)
        (CategoryTheory.Limits.pullback.snd h_Y ι ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom))
        (by rw [CategoryTheory.Category.assoc, h_deck_ι σ,
              CategoryTheory.Limits.pullback.condition])
    have hδ_1_σ : δ 1 ≫ m_σ = δ σ := by
      have h := hδ_act 1 σ m_σ
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      rwa [mul_one] at h
    have hpt : (δ σ).base y = m_σ.base ((δ 1).base y) :=
      congrArg
        (fun m : ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W_Y).left ⟶
            CategoryTheory.Limits.pullback h_Y ι => m.base y)
        hδ_1_σ.symm
    rw [hpt,
      (htriv_mem W_Y s₁).2 σ m_σ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) ((δ 1).base y),
      (htriv_mem W_Y s₂).2 σ m_σ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) ((δ 1).base y),
      h_eq_id y]

  let W_test : D_left.Etale := AlgebraicGeometry.Scheme.Etale.mk ι
  let V_test := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W_test).left
  let h_test := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W_test).hom
  let g_test : V_test ⟶ V := 𝟙 V
  have hh_test : h_test = g_test ≫ ι := (CategoryTheory.Category.id_comp ι).symm
  obtain ⟨δ_test, hδ_test_prop, hδ_test_disj, hδ_test_univ, hδ_test_act⟩ :=
    hSheets_ι V_test g_test h_test hh_test
  have hδ₁_fst : δ_test 1 ≫ CategoryTheory.Limits.pullback.fst h_test ι = 𝟙 V_test :=
    (hδ_test_prop 1).1
  have hδ₁_snd : δ_test 1 ≫ CategoryTheory.Limits.pullback.snd h_test ι = g_test := by
    rw [(hδ_test_prop 1).2.1, h_spec_one, CategoryTheory.Category.comp_id]

  let d_test : (B ≃ₐ[R₀] B) → (W_test ⟶ W_test) :=
    fun σ => CategoryTheory.MorphismProperty.Over.homMk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) (h_deck_ι σ)

  have hd_test_left : ∀ σ : B ≃ₐ[R₀] B,
      ((AlgebraicGeometry.Scheme.Etale.forget D_left).map (d_test σ)).left =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) : V_test ⟶ V_test) :=
    fun _ => rfl

  have h_exists_s_vec : ∀ v : Fin N → ZMod m,
      ∃ s : ↑(𝒥.obj.obj (Opposite.op W_test)),
        ∀ (σ : B ≃ₐ[R₀] B) (x : ↥V_test),
          triv_! W_test s ((δ_test σ).base x) = ((τ_rep σ).val).mulVec v := by
    intro v
    have hcov_q : ∀ q : ↥(CategoryTheory.Limits.pullback h_test ι),
        ∃ σ : B ≃ₐ[R₀] B, q ∈ Set.range (δ_test σ).base := by
      intro q
      have hq : q ∈ (⋃ σ : B ≃ₐ[R₀] B, Set.range (δ_test σ).base) := by
        rw [hδ_test_univ]
        trivial
      exact Set.mem_iUnion.mp hq
    let σ_of : ↥(CategoryTheory.Limits.pullback h_test ι) → (B ≃ₐ[R₀] B) :=
      fun q => Classical.choose (hcov_q q)
    have hσ_of_eq : ∀ (σ : B ≃ₐ[R₀] B) (q : ↥(CategoryTheory.Limits.pullback h_test ι)),
        q ∈ Set.range (δ_test σ).base → σ_of q = σ := by
      intro σ q hq
      by_contra hne
      exact Set.disjoint_left.mp (hδ_test_disj (σ_of q) σ hne)
        (Classical.choose_spec (hcov_q q)) hq
    let f_fn : ↥(CategoryTheory.Limits.pullback h_test ι) → (Fin N → ZMod m) :=
      fun q => ((τ_rep (σ_of q)).val).mulVec v
    have hf_sheet : ∀ (σ : B ≃ₐ[R₀] B) (x : ↥V_test),
        f_fn ((δ_test σ).base x) = ((τ_rep σ).val).mulVec v := by
      intro σ x
      dsimp only [f_fn]
      rw [hσ_of_eq σ ((δ_test σ).base x) ⟨x, rfl⟩]
    have hf_lc : IsLocallyConstant f_fn := by
      rw [IsLocallyConstant.iff_isOpen_fiber]
      intro w
      have hpre : f_fn ⁻¹' {w} =
          ⋃ (σ : B ≃ₐ[R₀] B) (_ : ((τ_rep σ).val).mulVec v = w),
            Set.range (δ_test σ).base := by
        ext q
        simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iUnion, exists_prop]
        constructor
        · intro hqw
          obtain ⟨σ, x, rfl⟩ := hcov_q q
          rw [hf_sheet σ x] at hqw
          exact ⟨σ, hqw, x, rfl⟩
        · rintro ⟨σ, hvw, x, rfl⟩
          rw [hf_sheet σ x, hvw]
      rw [hpre]
      exact isOpen_biUnion fun σ _ => (hδ_test_prop σ).2.2
    let f_v : LocallyConstant ↥(CategoryTheory.Limits.pullback h_test ι) (Fin N → ZMod m) :=
      ⟨f_fn, hf_lc⟩
    have hf_mem : f_v ∈ Set.range (triv_! W_test) := by
      rw [(htriv_spec W_test).2]
      refine ⟨⟨⊥, ?_, fun _ hy => False.elim hy⟩, ?_⟩
      · ext x
        constructor
        · intro _
          trivial
        · intro _
          change h_test.base x ∈ (U₀ : Set D_left) ∨ x ∈ (⊥ : V_test.Opens)
          left
          change (π ≫ U₀.ι).base x ∈ (U₀ : Set D_left)
          rw [← AlgebraicGeometry.Scheme.Opens.range_ι U₀]
          exact ⟨π.base x, rfl⟩
      · intro τ m_τ hm_fst hm_snd q
        obtain ⟨σ, x, rfl⟩ := hcov_q q
        have hact : (δ_test σ ≫ m_τ).base x = (δ_test (τ * σ)).base x :=
          congrArg (fun m : V_test ⟶ CategoryTheory.Limits.pullback h_test ι => m.base x)
            (hδ_test_act σ τ m_τ hm_fst hm_snd)
        change f_fn (m_τ.base ((δ_test σ).base x)) =
          ((τ_rep τ).val).mulVec (f_fn ((δ_test σ).base x))
        change f_fn ((δ_test σ ≫ m_τ).base x) = _
        rw [hact, hf_sheet (τ * σ) x, hf_sheet σ x, map_mul, Units.val_mul,
          Matrix.mulVec_mulVec]
    rcases hf_mem with ⟨s, hs⟩
    refine ⟨s, fun σ x => ?_⟩
    rw [hs]
    exact hf_sheet σ x

  let s_vec : (Fin N → ZMod m) → ↑(𝒥.obj.obj (Opposite.op W_test)) :=
    fun v => Classical.choose (h_exists_s_vec v)
  have hs_sheet : ∀ (v : Fin N → ZMod m) (σ : B ≃ₐ[R₀] B) (x : ↥V_test),
      triv_! W_test (s_vec v) ((δ_test σ).base x) = ((τ_rep σ).val).mulVec v :=
    fun v => Classical.choose_spec (h_exists_s_vec v)
  have hs_eval1 : ∀ (v : Fin N → ZMod m) (x : ↥V_test),
      triv_! W_test (s_vec v) ((δ_test 1).base x) = v := by
    intro v x
    rw [hs_sheet v 1 x, map_one, Units.val_one, Matrix.one_mulVec]

  have hs_basis : ∀ v : Fin N → ZMod m,
      s_vec v = ∑ i : Fin N, (v i).val • s_vec (Pi.single i 1) := by
    intro v
    apply h_id_uniq W_test g_test hh_test δ_test hδ_test_univ hδ_test_act
    intro x
    ext j
    let ev_xj : LocallyConstant ↥(CategoryTheory.Limits.pullback h_test ι) (Fin N → ZMod m) →+
        ZMod m :=
      { toFun := fun g => g ((δ_test 1).base x) j
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let φ_xj := ev_xj.comp (triv_! W_test)
    change φ_xj (s_vec v) = φ_xj (∑ i : Fin N, (v i).val • s_vec (Pi.single i 1))
    rw [map_sum]
    have h_lhs : φ_xj (s_vec v) = v j := congrFun (hs_eval1 v x) j
    have h_rhs : ∑ i : Fin N, φ_xj ((v i).val • s_vec (Pi.single i 1)) =
        ∑ i : Fin N, v i * (Pi.single i (1 : ZMod m) : Fin N → ZMod m) j := by
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_nsmul]
      have hi : φ_xj (s_vec (Pi.single i 1)) =
          (Pi.single i (1 : ZMod m) : Fin N → ZMod m) j :=
        congrFun (hs_eval1 (Pi.single i 1) x) j
      rw [hi, nsmul_eq_mul, ZMod.natCast_zmod_val]
    rw [h_lhs, h_rhs]
    simp [Pi.single_apply]

  have hs_deck : ∀ (σ : B ≃ₐ[R₀] B) (v : Fin N → ZMod m),
      (𝒥.obj.map (Opposite.op (d_test σ))) (s_vec v) =
        s_vec (((τ_rep σ⁻¹).val).mulVec v) := by
    intro σ v
    apply h_id_uniq W_test g_test hh_test δ_test hδ_test_univ hδ_test_act
    intro x
    let v_σ_et : V_test ⟶ V_test :=
      ((AlgebraicGeometry.Scheme.Etale.forget D_left).map (d_test σ)).left
    let u_V : CategoryTheory.Limits.pullback h_test ι ⟶ CategoryTheory.Limits.pullback h_test ι :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst h_test ι ≫ v_σ_et)
        (CategoryTheory.Limits.pullback.snd h_test ι)
        (by
          rw [CategoryTheory.Category.assoc,
            ((AlgebraicGeometry.Scheme.Etale.forget D_left).map (d_test σ)).w,
            CategoryTheory.Limits.pullback.condition])
    have hδ_uV : δ_test 1 ≫ u_V = v_σ_et ≫ δ_test σ⁻¹ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, (hδ_test_prop σ⁻¹).1,
          ← CategoryTheory.Category.assoc (δ_test 1), hδ₁_fst,
          CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, hδ₁_snd, (hδ_test_prop σ⁻¹).2.1]
        have hv_comp : v_σ_et ≫ g_test ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ⁻¹).symm.toRingHom) = g_test := by
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ≫
            (𝟙 V ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom)) = 𝟙 V
          rw [CategoryTheory.Category.id_comp, ← AlgebraicGeometry.Spec.map_comp]
          have hcomp_id :
              CommRingCat.ofHom σ.toRingHom ≫ CommRingCat.ofHom σ.symm.toRingHom =
                𝟙 (CommRingCat.of B) := by
            apply CommRingCat.hom_ext
            ext b
            exact σ.symm_apply_apply b
          rw [hcomp_id, AlgebraicGeometry.Spec.map_id]
        exact hv_comp.symm
    have hpt : u_V.base ((δ_test 1).base x) = (δ_test σ⁻¹).base (v_σ_et.base x) :=
      congrArg (fun m : V_test ⟶ CategoryTheory.Limits.pullback h_test ι => m.base x) hδ_uV
    exact (htriv_nat (d_test σ) u_V
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (s_vec v) ((δ_test 1).base x)).trans
      ((congrArg (triv_! W_test (s_vec v)) hpt).trans
        ((hs_sheet v σ⁻¹ (v_σ_et.base x)).trans (hs_eval1 _ x).symm))

  have hCollar : ∀ (W : D_left.Etale) (s₀ : ↑(𝒥.obj.obj (Opposite.op W))),
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
      ∃ (W₀ : ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).left.Opens)
        (hEt_W₀ : AlgebraicGeometry.Etale (W₀.ι ≫ h_W)),
        let _ : AlgebraicGeometry.Etale (W₀.ι ≫ h_W) := hEt_W₀
        let U_W₀ : D_left.Etale := AlgebraicGeometry.Scheme.Etale.mk (W₀.ι ≫ h_W)
        ((TopologicalSpace.Opens.map h_W.base).obj U₀) ⊔ W₀ = ⊤ ∧
        ∃ (j₀ : U_W₀ ⟶ W),
          ((AlgebraicGeometry.Scheme.Etale.forget D_left).map j₀).left =
            (W₀.ι : ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj U_W₀).left ⟶ _) ∧
          (𝒥.obj.map (Opposite.op j₀)) s₀ = 0 := by
    intro W s₀ h_W
    obtain ⟨W₀, hCov, hZero⟩ := (htriv_mem W s₀).1
    have _ : AlgebraicGeometry.Etale h_W := W.prop
    have hEt_W₀ : AlgebraicGeometry.Etale (W₀.ι ≫ h_W) := inferInstance
    let U_W₀ : D_left.Etale := AlgebraicGeometry.Scheme.Etale.mk (W₀.ι ≫ h_W)
    let j₀ : U_W₀ ⟶ W := CategoryTheory.MorphismProperty.Over.homMk W₀.ι rfl
    refine ⟨W₀, hEt_W₀, hCov, j₀, rfl, ?_⟩
    refine (htriv_spec U_W₀).1 ((LocallyConstant.ext fun y => ?_).trans (map_zero (triv_! U_W₀)).symm)
    let h_UW₀ := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj U_W₀).hom
    let u₀_V : CategoryTheory.Limits.pullback h_UW₀ ι ⟶
        CategoryTheory.Limits.pullback h_W ι :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst h_UW₀ ι ≫
          ((AlgebraicGeometry.Scheme.Etale.forget D_left).map j₀).left)
        (CategoryTheory.Limits.pullback.snd h_UW₀ ι)
        (by
          rw [CategoryTheory.Category.assoc,
            ((AlgebraicGeometry.Scheme.Etale.forget D_left).map j₀).w,
            CategoryTheory.Limits.pullback.condition])
    have hmem_W₀ : (CategoryTheory.Limits.pullback.fst h_W ι).base (u₀_V.base y) ∈ W₀ := by
      have hpt : (CategoryTheory.Limits.pullback.fst h_W ι).base (u₀_V.base y) =
          ((AlgebraicGeometry.Scheme.Etale.forget D_left).map j₀).left.base
            ((CategoryTheory.Limits.pullback.fst h_UW₀ ι).base y) :=
        congrArg
          (fun m : CategoryTheory.Limits.pullback h_UW₀ ι ⟶
              ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).left => m.base y)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      rw [hpt]
      change W₀.ι.base ((CategoryTheory.Limits.pullback.fst h_UW₀ ι).base y) ∈ (W₀ : Set _)
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι W₀]
      exact ⟨_, rfl⟩
    exact (htriv_nat j₀ u₀_V
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _) s₀ y).trans
      (hZero (u₀_V.base y) hmem_W₀)

  have hRoof : ∀ (W : D_left.Etale) (s₀ : ↑(𝒥.obj.obj (Opposite.op W))),
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
      ∀ y₀ : ↥(CategoryTheory.Limits.pullback h_W ι),
        let v := triv_! W s₀ y₀
        ∃ (C_v : (CategoryTheory.Limits.pullback h_W ι).Opens)
          (hEt_Cv : AlgebraicGeometry.Etale
            ((C_v.ι ≫ CategoryTheory.Limits.pullback.snd h_W ι) ≫ ι)),
          let _ : AlgebraicGeometry.Etale
            ((C_v.ι ≫ CategoryTheory.Limits.pullback.snd h_W ι) ≫ ι) := hEt_Cv
          let U_v : D_left.Etale :=
            AlgebraicGeometry.Scheme.Etale.mk
              ((C_v.ι ≫ CategoryTheory.Limits.pullback.snd h_W ι) ≫ ι)
          y₀ ∈ C_v ∧
          ∃ (u₁ : U_v ⟶ W) (u₂ : U_v ⟶ W_test),
            ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u₁).left =
              (C_v.ι ≫ CategoryTheory.Limits.pullback.fst h_W ι :
                ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj U_v).left ⟶ _) ∧
            ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u₂).left =
              (C_v.ι ≫ CategoryTheory.Limits.pullback.snd h_W ι :
                ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj U_v).left ⟶ V_test) ∧
            (𝒥.obj.map (Opposite.op u₁)) s₀ = (𝒥.obj.map (Opposite.op u₂)) (s_vec v) := by
    intro W s₀ h_W y₀ v
    let C_v : (CategoryTheory.Limits.pullback h_W ι).Opens :=
      ⟨(triv_! W s₀) ⁻¹' {v}, (triv_! W s₀).isLocallyConstant {v}⟩
    have hy₀_mem : y₀ ∈ C_v := rfl
    have _ : AlgebraicGeometry.Etale h_W := W.prop
    have _ : AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.snd h_W ι) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback h_W ι) W.prop
    let g_Cv := C_v.ι ≫ CategoryTheory.Limits.pullback.snd h_W ι
    have hEt_Cv : AlgebraicGeometry.Etale (g_Cv ≫ ι) := inferInstance
    let U_v : D_left.Etale := AlgebraicGeometry.Scheme.Etale.mk (g_Cv ≫ ι)
    let V_Uv := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj U_v).left
    let h_Uv := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj U_v).hom
    let g_Uv : V_Uv ⟶ V := g_Cv
    let ι_Cv_et : V_Uv ⟶ CategoryTheory.Limits.pullback h_W ι := C_v.ι
    let u₁ : U_v ⟶ W :=
      CategoryTheory.MorphismProperty.Over.homMk
        (C_v.ι ≫ CategoryTheory.Limits.pullback.fst h_W ι)
        (by
          change (C_v.ι ≫ CategoryTheory.Limits.pullback.fst h_W ι) ≫ h_W = g_Cv ≫ ι
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
            ← CategoryTheory.Category.assoc])
    let u₂ : U_v ⟶ W_test :=
      CategoryTheory.MorphismProperty.Over.homMk g_Cv rfl
    refine ⟨C_v, hEt_Cv, hy₀_mem, u₁, u₂, rfl, rfl, ?_⟩
    obtain ⟨δ_Uv, hδ_Uv_prop, _, hδ_Uv_univ, hδ_Uv_act⟩ :=
      hSheets_ι V_Uv g_Uv h_Uv rfl
    apply h_id_uniq U_v g_Uv rfl δ_Uv hδ_Uv_univ hδ_Uv_act
    intro c
    let u₁_left := ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u₁).left
    let u₂_left := ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u₂).left
    let u₁_V : CategoryTheory.Limits.pullback h_Uv ι ⟶
        CategoryTheory.Limits.pullback h_W ι :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst h_Uv ι ≫ u₁_left)
        (CategoryTheory.Limits.pullback.snd h_Uv ι)
        (by
          rw [CategoryTheory.Category.assoc,
            ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u₁).w,
            CategoryTheory.Limits.pullback.condition])
    let u₂_V : CategoryTheory.Limits.pullback h_Uv ι ⟶
        CategoryTheory.Limits.pullback h_test ι :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst h_Uv ι ≫ u₂_left)
        (CategoryTheory.Limits.pullback.snd h_Uv ι)
        (by
          rw [CategoryTheory.Category.assoc,
            ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u₂).w,
            CategoryTheory.Limits.pullback.condition])
    have hδ_u₁ : δ_Uv 1 ≫ u₁_V = ι_Cv_et := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc (δ_Uv 1), (hδ_Uv_prop 1).1,
          CategoryTheory.Category.id_comp]
        rfl
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          (hδ_Uv_prop 1).2.1, h_spec_one, CategoryTheory.Category.comp_id]
        rfl
    have hδ_u₂ : δ_Uv 1 ≫ u₂_V = u₂_left ≫ δ_test 1 := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, hδ₁_fst, CategoryTheory.Category.comp_id,
          ← CategoryTheory.Category.assoc (δ_Uv 1), (hδ_Uv_prop 1).1,
          CategoryTheory.Category.id_comp]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, hδ₁_snd,
          (hδ_Uv_prop 1).2.1, h_spec_one, CategoryTheory.Category.comp_id]
        exact (CategoryTheory.Category.comp_id g_Uv).symm
    have hpt₁ : u₁_V.base ((δ_Uv 1).base c) = ι_Cv_et.base c :=
      congrArg (fun m : V_Uv ⟶ CategoryTheory.Limits.pullback h_W ι => m.base c) hδ_u₁
    have hpt₂ : u₂_V.base ((δ_Uv 1).base c) = (δ_test 1).base (u₂_left.base c) :=
      congrArg (fun m : V_Uv ⟶ CategoryTheory.Limits.pullback h_test ι => m.base c) hδ_u₂
    have hc_mem : ι_Cv_et.base c ∈ (C_v : Set _) := by
      change C_v.ι.base c ∈ (C_v : Set _)
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι C_v]
      exact ⟨c, rfl⟩
    have hc_val : triv_! W s₀ (ι_Cv_et.base c) = v := hc_mem
    have hLHS : triv_! U_v ((𝒥.obj.map (Opposite.op u₁)) s₀) ((δ_Uv 1).base c) = v :=
      (htriv_nat u₁ u₁_V
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) s₀ ((δ_Uv 1).base c)).trans
        ((congrArg (triv_! W s₀) hpt₁).trans hc_val)
    have hRHS : triv_! U_v ((𝒥.obj.map (Opposite.op u₂)) (s_vec v)) ((δ_Uv 1).base c) = v :=
      (htriv_nat u₂ u₂_V
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) (s_vec v) ((δ_Uv 1).base c)).trans
        ((congrArg (triv_! W_test (s_vec v)) hpt₂).trans (hs_eval1 v (u₂_left.base c)))
    exact hLHS.trans hRHS.symm

  
  
  
  
  let q_V_test : V_bar ⟶ V_test := q_V
  let γ_diag : V_bar ⟶ CategoryTheory.Limits.pullback h_test pr_D :=
    CategoryTheory.Limits.pullback.lift q_V_test p_Vbar hp_comm'
  have hγ_diag_fst : γ_diag ≫ CategoryTheory.Limits.pullback.fst h_test pr_D = q_V_test :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hγ_diag_snd : γ_diag ≫ CategoryTheory.Limits.pullback.snd h_test pr_D = p_Vbar :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  let γ_diag_et : V_bar ⟶ ((AlgebraicGeometry.Scheme.Etale.forget S).obj (B_pr.obj W_test)).left :=
    γ_diag

  have h_const_diag :
      ∀ (g : LocallyConstant
          ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj (B_pr.obj W_test)).left
          (ULift.{u} (ZMod m)))
        (x₁ x₂ : ↥V_bar),
        g (γ_diag_et.base x₁) = g (γ_diag_et.base x₂) := by
    intro g x₁ x₂
    exact LocallyConstant.apply_eq_of_preconnectedSpace
      (g.comap γ_diag_et.base.hom) x₁ x₂

  let x_bar0 : ↥V_bar := Classical.choice ConnectedSpace.toNonempty

  let e_θ : ∀ Y : S.Etale,
      LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y).left
        (ULift.{u} (ZMod m)) ≃+
        ↑((weilEtaleTorsionSheaf S m).obj.obj (Opposite.op Y)) :=
    fun Y => AddEquiv.ofBijective (θ_S Y) (hθ_bij Y)

  let L_of : ∀ (_η : Quiver.Hom 𝒥 (R_pr.obj (weilEtaleTorsionSheaf S m)))
      (W : D_left.Etale),
      ↑(𝒥.obj.obj (Opposite.op W)) →+
        LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj (B_pr.obj W)).left
          (ULift.{u} (ZMod m)) :=
    fun η W => (e_θ (B_pr.obj W)).symm.toAddMonoidHom.comp (η.hom.app (Opposite.op W)).hom

  have hL_θ : ∀ (η : Quiver.Hom 𝒥 (R_pr.obj (weilEtaleTorsionSheaf S m)))
      (W : D_left.Etale) (s : ↑(𝒥.obj.obj (Opposite.op W))),
      θ_S (B_pr.obj W) (L_of η W s) = (η.hom.app (Opposite.op W)).hom s :=
    fun η W s => (e_θ (B_pr.obj W)).apply_symm_apply ((η.hom.app (Opposite.op W)).hom s)

  have hL_nat : ∀ (η : Quiver.Hom 𝒥 (R_pr.obj (weilEtaleTorsionSheaf S m)))
      {W₁ W₂ : D_left.Etale} (u : W₁ ⟶ W₂) (s₂ : ↑(𝒥.obj.obj (Opposite.op W₂))),
      L_of η W₁ ((𝒥.obj.map (Opposite.op u)) s₂) =
        (L_of η W₂ s₂).comap
          ((AlgebraicGeometry.Scheme.Etale.forget S).map (B_pr.map u)).left.base.hom := by
    intro η W₁ W₂ u s₂
    apply (hθ_bij (B_pr.obj W₁)).1
    have hnat := ConcreteCategory.congr_hom (η.hom.naturality (Opposite.op u)) s₂
    exact (hL_θ η W₁ _).trans
      (hnat.trans
        ((congrArg (((weilEtaleTorsionSheaf S m).obj.map (Opposite.op (B_pr.map u))).hom)
          (hL_θ η W₂ s₂).symm).trans (hθ_nat (B_pr.map u) (L_of η W₂ s₂))))

  let β_raw : Quiver.Hom 𝒥 (R_pr.obj (weilEtaleTorsionSheaf S m)) → (Fin N → ZMod m) :=
    fun η i => (L_of η W_test (s_vec (Pi.single i 1)) (γ_diag_et.base x_bar0)).down

  have h_ev_vec : ∀ (η : Quiver.Hom 𝒥 (R_pr.obj (weilEtaleTorsionSheaf S m)))
      (v : Fin N → ZMod m),
      (L_of η W_test (s_vec v) (γ_diag_et.base x_bar0)).down = dotProduct (β_raw η) v := by
    intro η v
    let ev₀ : ↑(𝒥.obj.obj (Opposite.op W_test)) →+ ZMod m :=
      { toFun := fun t => (L_of η W_test t (γ_diag_et.base x_bar0)).down
        map_zero' := by
          change (L_of η W_test 0 (γ_diag_et.base x_bar0)).down = 0
          rw [map_zero]
          rfl
        map_add' := fun t₁ t₂ => by
          change (L_of η W_test (t₁ + t₂) (γ_diag_et.base x_bar0)).down = _
          rw [map_add, LocallyConstant.add_apply]
          rfl }
    change ev₀ (s_vec v) = dotProduct (β_raw η) v
    rw [hs_basis v, map_sum]
    simp only [dotProduct]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val, mul_comm]
    rfl

  have hβ_inv_mem : ∀ η : Quiver.Hom 𝒥 (R_pr.obj (weilEtaleTorsionSheaf S m)),
      ∀ h ∈ H_mat, (h.transpose).mulVec (β_raw η) = β_raw η := by
    intro η h hh
    obtain ⟨σ, hσ, hτ⟩ := hH_to_Γ h hh
    have hγ_deck : d_bar σ hσ ≫ γ_diag = γ_diag ≫ u_Z_of (d_test σ) := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (d_bar σ hσ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            (((hd_bar σ hσ).2).trans
              ((congrArg (· ≫ ((AlgebraicGeometry.Scheme.Etale.forget D_left).map (d_test σ)).left)
                  (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (γ_diag ≫ ·) (hB_pr_fst (d_test σ)).symm)))))
      · exact (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (d_bar σ hσ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
            (((hd_bar σ hσ).1).trans
              ((CategoryTheory.Limits.pullback.lift_snd _ _ _).symm.trans
                ((congrArg (γ_diag ≫ ·) (hB_pr_snd (d_test σ)).symm).trans
                  (CategoryTheory.Category.assoc _ _ _).symm))))
    ext j
    let v : Fin N → ZMod m := Pi.single j 1
    have hmat_id : ((τ_rep σ⁻¹).val).mulVec (h.mulVec v) = v := by
      rw [← hτ, Matrix.mulVec_mulVec, ← Units.val_mul, ← map_mul, inv_mul_cancel,
        map_one, Units.val_one, Matrix.one_mulVec]
    have hs_pull : (𝒥.obj.map (Opposite.op (d_test σ))) (s_vec (h.mulVec v)) = s_vec v :=
      (hs_deck σ (h.mulVec v)).trans (congrArg s_vec hmat_id)
    have hL_eq : L_of η W_test (s_vec v) (γ_diag_et.base x_bar0) =
        L_of η W_test (s_vec (h.mulVec v))
          (((AlgebraicGeometry.Scheme.Etale.forget S).map (B_pr.map (d_test σ))).left.base
            (γ_diag_et.base x_bar0)) :=
      (congrArg (fun s => L_of η W_test s (γ_diag_et.base x_bar0)) hs_pull.symm).trans
        (congrArg (fun f => f (γ_diag_et.base x_bar0)) (hL_nat η (d_test σ) (s_vec (h.mulVec v))))
    have hpt_deck :
        ((AlgebraicGeometry.Scheme.Etale.forget S).map (B_pr.map (d_test σ))).left.base
          (γ_diag_et.base x_bar0) = γ_diag_et.base ((d_bar σ hσ).base x_bar0) :=
      congrArg (fun m : V_bar ⟶ CategoryTheory.Limits.pullback h_test pr_D => m.base x_bar0)
        hγ_deck.symm
    have hval_eq : L_of η W_test (s_vec v) (γ_diag_et.base x_bar0) =
        L_of η W_test (s_vec (h.mulVec v)) (γ_diag_et.base x_bar0) :=
      hL_eq.trans ((congrArg (L_of η W_test (s_vec (h.mulVec v))) hpt_deck).trans
        (h_const_diag (L_of η W_test (s_vec (h.mulVec v))) ((d_bar σ hσ).base x_bar0) x_bar0))
    have hdown_eq : dotProduct (β_raw η) v = dotProduct (β_raw η) (h.mulVec v) :=
      (h_ev_vec η v).symm.trans ((congrArg ULift.down hval_eq).trans (h_ev_vec η (h.mulVec v)))
    rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose] at hdown_eq
    simpa only [v, dotProduct, Pi.single_apply, mul_boole, Finset.sum_ite_eq', Finset.mem_univ,
      ↓reduceIte] using hdown_eq.symm

  let β_inv : Quiver.Hom 𝒥 (R_pr.obj (weilEtaleTorsionSheaf S m)) → Inv_m :=
    fun η => ⟨β_raw η, hβ_inv_mem η⟩

  have h_left_inv : ∀ lam : Inv_m, β_inv (η_α lam) = lam := by
    intro lam
    apply Subtype.ext
    ext i
    let lift_diag : V_bar ⟶
        CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd h_test pr_D) p_Vbar :=
      CategoryTheory.Limits.pullback.lift γ_diag (𝟙 V_bar)
        (by rw [hγ_diag_snd, CategoryTheory.Category.id_comp])
    let w_tilde0 := lift_diag.base x_bar0
    have hw_tilde0_fst : (CategoryTheory.Limits.pullback.fst
        (CategoryTheory.Limits.pullback.snd h_test pr_D) p_Vbar).base w_tilde0 =
        γ_diag.base x_bar0 :=
      congrArg (fun m : V_bar ⟶ CategoryTheory.Limits.pullback h_test pr_D => m.base x_bar0)
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
    have hρ_diag : lift_diag ≫ ρ_can W_test = q_V_test ≫ δ_test 1 := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          hρ_can_fst W_test, hδ₁_fst, CategoryTheory.Category.comp_id,
          ← CategoryTheory.Category.assoc lift_diag, CategoryTheory.Limits.pullback.lift_fst,
          hγ_diag_fst]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          hρ_can_snd W_test, hδ₁_snd,
          ← CategoryTheory.Category.assoc lift_diag, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.id_comp]
        exact (CategoryTheory.Category.comp_id q_V).symm
    have hρ_pt : (ρ_can W_test).base w_tilde0 = (δ_test 1).base (q_V_test.base x_bar0) :=
      congrArg (fun m : V_bar ⟶ CategoryTheory.Limits.pullback h_test ι => m.base x_bar0) hρ_diag
    have heval := (hEval_η lam W_test (s_vec (Pi.single i 1))
      (L_of (η_α lam) W_test (s_vec (Pi.single i 1)))
      (hL_θ (η_α lam) W_test _) (γ_diag.base x_bar0)).2 w_tilde0 (ρ_can W_test) hw_tilde0_fst
      (hρ_can_fst W_test) (hρ_can_snd W_test)
    have htriv_pt :
        triv_! W_test (s_vec (Pi.single i 1)) ((ρ_can W_test).base w_tilde0) =
          Pi.single i (1 : ZMod m) :=
      (congrArg (triv_! W_test (s_vec (Pi.single i 1))) hρ_pt).trans
        (hs_eval1 (Pi.single i 1) (q_V_test.base x_bar0))
    have hdown :
        (L_of (η_α lam) W_test (s_vec (Pi.single i 1)) (γ_diag_et.base x_bar0)).down =
          dotProduct lam.1 (Pi.single i 1) :=
      (congrArg ULift.down heval).trans (congrArg (dotProduct lam.1) htriv_pt)
    change (L_of (η_α lam) W_test (s_vec (Pi.single i 1)) (γ_diag_et.base x_bar0)).down = lam.1 i
    rw [hdown]
    simp [dotProduct, Pi.single_apply]

  have h_right_inv : ∀ η : Quiver.Hom 𝒥 (R_pr.obj (weilEtaleTorsionSheaf S m)),
      η_α (β_inv η) = η := by
    intro η
    let lam := β_inv η
    let η₁ := η_α lam
    let η₂ := η
    have hβ_eq : β_raw η₁ = β_raw η₂ :=
      congrArg Subtype.val (h_left_inv lam)
    have h_agree_test : ∀ (v : Fin N → ZMod m) (x_bar : ↥V_bar),
        L_of η₁ W_test (s_vec v) (γ_diag_et.base x_bar) =
          L_of η₂ W_test (s_vec v) (γ_diag_et.base x_bar) := by
      intro v x_bar
      refine (h_const_diag (L_of η₁ W_test (s_vec v)) x_bar x_bar0).trans
        ((ULift.ext _ _ ?_).trans
          (h_const_diag (L_of η₂ W_test (s_vec v)) x_bar x_bar0).symm)
      exact (h_ev_vec η₁ v).trans ((congrArg (fun b => dotProduct b v) hβ_eq).trans (h_ev_vec η₂ v).symm)
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext W_op
    let W := W_op.unop
    apply AddCommGrpCat.ext
    intro s₀
    change (η₁.hom.app (Opposite.op W)).hom s₀ = (η₂.hom.app (Opposite.op W)).hom s₀
    rw [← hL_θ η₁ W s₀, ← hL_θ η₂ W s₀]
    congr 1
    apply LocallyConstant.ext
    intro z_raw
    let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).hom
    let z : ↥(CategoryTheory.Limits.pullback h_W pr_D) := z_raw
    let fst_Z := CategoryTheory.Limits.pullback.fst h_W pr_D
    let snd_Z := CategoryTheory.Limits.pullback.snd h_W pr_D
    obtain ⟨W₀, hEt_W₀, hCov, j₀, hj₀_left, hj₀_zero⟩ := hCollar W s₀
    let _ : AlgebraicGeometry.Etale (W₀.ι ≫ h_W) := hEt_W₀
    let U_W₀ : D_left.Etale := AlgebraicGeometry.Scheme.Etale.mk (W₀.ι ≫ h_W)
    have hx_top : fst_Z.base z ∈
        (⊤ : ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).left.Opens) := trivial
    rw [← hCov] at hx_top
    rcases hx_top with hzU | hzW₀
    · 
      obtain ⟨w_tilde, hw_tilde_fst⟩ := (h_mem_range W z).mpr hzU
      let x_bar : ↥V_bar := (CategoryTheory.Limits.pullback.snd snd_Z p_Vbar).base w_tilde
      let y₀ := (ρ_can W).base w_tilde
      let v := triv_! W s₀ y₀
      obtain ⟨C_v, hEt_Cv, hy₀_C, u₁, u₂, hu₁_left, hu₂_left, hs₀_eq⟩ := hRoof W s₀ y₀
      let _ : AlgebraicGeometry.Etale ((C_v.ι ≫ CategoryTheory.Limits.pullback.snd h_W ι) ≫ ι) :=
        hEt_Cv
      let U_v : D_left.Etale :=
        AlgebraicGeometry.Scheme.Etale.mk ((C_v.ι ≫ CategoryTheory.Limits.pullback.snd h_W ι) ≫ ι)
      let V_Uv := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj U_v).left
      let h_Uv := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj U_v).hom
      let Omega_tilde : (CategoryTheory.Limits.pullback snd_Z p_Vbar).Opens :=
        (TopologicalSpace.Opens.map (ρ_can W).base).obj C_v
      have hw_tilde_Ω : w_tilde ∈ (Omega_tilde : Set _) := hy₀_C
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι Omega_tilde] at hw_tilde_Ω
      rcases hw_tilde_Ω with ⟨w_tilde_C, hw_tilde_C⟩
      have hrange_ρ : Set.range (Omega_tilde.ι ≫ ρ_can W).base ⊆ Set.range C_v.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι C_v]
        rintro _ ⟨pt, rfl⟩
        have hpt_Ω : Omega_tilde.ι.base pt ∈ (Omega_tilde : Set _) := by
          rw [← AlgebraicGeometry.Scheme.Opens.range_ι Omega_tilde]
          exact ⟨pt, rfl⟩
        exact hpt_Ω
      let ρ_C : Omega_tilde.toScheme ⟶ C_v.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift C_v.ι (Omega_tilde.ι ≫ ρ_can W) hrange_ρ
      have hρ_C_fac : ρ_C ≫ C_v.ι = Omega_tilde.ι ≫ ρ_can W :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac C_v.ι (Omega_tilde.ι ≫ ρ_can W) hrange_ρ
      let ρ_C_et : Omega_tilde.toScheme ⟶ V_Uv := ρ_C
      let Φ_C : Omega_tilde.toScheme ⟶ CategoryTheory.Limits.pullback h_Uv pr_D :=
        CategoryTheory.Limits.pullback.lift ρ_C_et
          (Omega_tilde.ι ≫ CategoryTheory.Limits.pullback.snd snd_Z p_Vbar ≫ p_Vbar)
          (by
            change (ρ_C ≫ C_v.ι ≫ CategoryTheory.Limits.pullback.snd h_W ι) ≫ ι = _
            rw [← CategoryTheory.Category.assoc ρ_C C_v.ι, hρ_C_fac,
              CategoryTheory.Category.assoc Omega_tilde.ι, hρ_can_snd W]
            simp only [CategoryTheory.Category.assoc, hp_comm']
            rfl)
      let c_tilde : ↥(CategoryTheory.Limits.pullback h_Uv pr_D) := Φ_C.base w_tilde_C
      let c_tilde_et : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj (B_pr.obj U_v)).left :=
        c_tilde
      have hΦ_u₁ : Φ_C ≫ u_Z_of u₁ =
          Omega_tilde.ι ≫ CategoryTheory.Limits.pullback.fst snd_Z p_Vbar := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · have h_mid : ρ_C_et ≫ ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u₁).left =
              Omega_tilde.ι ≫ CategoryTheory.Limits.pullback.fst snd_Z p_Vbar ≫ fst_Z := by
            have h_u1 : ρ_C_et ≫ ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u₁).left =
                ρ_C ≫ C_v.ι ≫ CategoryTheory.Limits.pullback.fst h_W ι :=
              congrArg (ρ_C_et ≫ ·) hu₁_left
            refine h_u1.trans ?_
            rw [← CategoryTheory.Category.assoc ρ_C, hρ_C_fac,
              CategoryTheory.Category.assoc Omega_tilde.ι, hρ_can_fst W]
          exact (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (Φ_C ≫ ·) (hB_pr_fst u₁)).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ _) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans h_mid)))
        · exact (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (Φ_C ≫ ·) (hB_pr_snd u₁)).trans
              ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                ((congrArg (Omega_tilde.ι ≫ ·) CategoryTheory.Limits.pullback.condition.symm).trans
                  (CategoryTheory.Category.assoc _ _ _).symm)))
      have hΦ_u₂ : Φ_C ≫ u_Z_of u₂ =
          Omega_tilde.ι ≫ CategoryTheory.Limits.pullback.snd snd_Z p_Vbar ≫ γ_diag := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · have h_mid : ρ_C_et ≫ ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u₂).left =
              Omega_tilde.ι ≫ CategoryTheory.Limits.pullback.snd snd_Z p_Vbar ≫ q_V_test := by
            have h_u2 : ρ_C_et ≫ ((AlgebraicGeometry.Scheme.Etale.forget D_left).map u₂).left =
                ρ_C ≫ C_v.ι ≫ CategoryTheory.Limits.pullback.snd h_W ι :=
              congrArg (ρ_C_et ≫ ·) hu₂_left
            refine h_u2.trans ?_
            change ρ_C ≫ C_v.ι ≫ CategoryTheory.Limits.pullback.snd h_W ι =
              Omega_tilde.ι ≫ CategoryTheory.Limits.pullback.snd snd_Z p_Vbar ≫ q_V
            rw [← CategoryTheory.Category.assoc ρ_C, hρ_C_fac,
              CategoryTheory.Category.assoc Omega_tilde.ι, hρ_can_snd W]
          have h_rhs :
              (Omega_tilde.ι ≫ CategoryTheory.Limits.pullback.snd snd_Z p_Vbar ≫ γ_diag) ≫
                CategoryTheory.Limits.pullback.fst h_test pr_D =
              Omega_tilde.ι ≫ CategoryTheory.Limits.pullback.snd snd_Z p_Vbar ≫ q_V_test :=
            (CategoryTheory.Category.assoc _ _ _).trans
              (congrArg (Omega_tilde.ι ≫ ·)
                ((CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (CategoryTheory.Limits.pullback.snd snd_Z p_Vbar ≫ ·)
                    (CategoryTheory.Limits.pullback.lift_fst _ _ _))))
          exact (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (Φ_C ≫ ·) (hB_pr_fst u₂)).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ _) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  (h_mid.trans h_rhs.symm))))
        · have h_rhs :
              (Omega_tilde.ι ≫ CategoryTheory.Limits.pullback.snd snd_Z p_Vbar ≫ γ_diag) ≫
                CategoryTheory.Limits.pullback.snd h_test pr_D =
              Omega_tilde.ι ≫ CategoryTheory.Limits.pullback.snd snd_Z p_Vbar ≫ p_Vbar :=
            (CategoryTheory.Category.assoc _ _ _).trans
              (congrArg (Omega_tilde.ι ≫ ·)
                ((CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (CategoryTheory.Limits.pullback.snd snd_Z p_Vbar ≫ ·)
                    (CategoryTheory.Limits.pullback.lift_snd _ _ _))))
          exact (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (Φ_C ≫ ·) (hB_pr_snd u₂)).trans
              ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans h_rhs.symm))
      have hc_tilde_u₁ :
          ((AlgebraicGeometry.Scheme.Etale.forget S).map (B_pr.map u₁)).left.base c_tilde_et =
            z_raw := by
        have h1 : (u_Z_of u₁).base c_tilde =
            (CategoryTheory.Limits.pullback.fst snd_Z p_Vbar).base (Omega_tilde.ι.base w_tilde_C) :=
          congrArg
            (fun m : Omega_tilde.toScheme ⟶ CategoryTheory.Limits.pullback h_W pr_D =>
              m.base w_tilde_C) hΦ_u₁
        exact h1.trans
          ((congrArg (CategoryTheory.Limits.pullback.fst snd_Z p_Vbar).base hw_tilde_C).trans
            hw_tilde_fst)
      have hc_tilde_u₂ :
          ((AlgebraicGeometry.Scheme.Etale.forget S).map (B_pr.map u₂)).left.base c_tilde_et =
            γ_diag_et.base x_bar := by
        have h1 : (u_Z_of u₂).base c_tilde =
            γ_diag.base
              ((CategoryTheory.Limits.pullback.snd snd_Z p_Vbar).base
                (Omega_tilde.ι.base w_tilde_C)) :=
          congrArg
            (fun m : Omega_tilde.toScheme ⟶ CategoryTheory.Limits.pullback h_test pr_D =>
              m.base w_tilde_C) hΦ_u₂
        exact h1.trans
          (congrArg (fun w => γ_diag.base ((CategoryTheory.Limits.pullback.snd snd_Z p_Vbar).base w))
            hw_tilde_C)
      have hroof_eval : ∀ η' : Quiver.Hom 𝒥 (R_pr.obj (weilEtaleTorsionSheaf S m)),
          L_of η' W s₀ z_raw = L_of η' W_test (s_vec v) (γ_diag_et.base x_bar) := by
        intro η'
        have h1 : L_of η' U_v ((𝒥.obj.map (Opposite.op u₁)) s₀) c_tilde_et =
            L_of η' W s₀
              (((AlgebraicGeometry.Scheme.Etale.forget S).map (B_pr.map u₁)).left.base
                c_tilde_et) :=
          congrArg (fun f => f c_tilde_et) (hL_nat η' u₁ s₀)
        have h2 : L_of η' U_v ((𝒥.obj.map (Opposite.op u₂)) (s_vec v)) c_tilde_et =
            L_of η' W_test (s_vec v)
              (((AlgebraicGeometry.Scheme.Etale.forget S).map (B_pr.map u₂)).left.base
                c_tilde_et) :=
          congrArg (fun f => f c_tilde_et) (hL_nat η' u₂ (s_vec v))
        have h12 : L_of η' U_v ((𝒥.obj.map (Opposite.op u₁)) s₀) c_tilde_et =
            L_of η' U_v ((𝒥.obj.map (Opposite.op u₂)) (s_vec v)) c_tilde_et :=
          congrArg (fun s => L_of η' U_v s c_tilde_et) hs₀_eq
        exact (congrArg (L_of η' W s₀) hc_tilde_u₁.symm).trans
          (h1.symm.trans (h12.trans (h2.trans (congrArg (L_of η' W_test (s_vec v)) hc_tilde_u₂))))
      exact (hroof_eval η₁).trans ((h_agree_test v x_bar).trans (hroof_eval η₂).symm)
    · 
      let h_UW₀ := ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj U_W₀).hom
      let j_Z : CategoryTheory.Limits.pullback h_UW₀ pr_D ⟶
          CategoryTheory.Limits.pullback h_W pr_D := u_Z_of j₀
      let W₀_ι_et : ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj U_W₀).left ⟶
          ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).left :=
        ((AlgebraicGeometry.Scheme.Etale.forget D_left).map j₀).left
      have hj_fst : j_Z ≫ fst_Z =
          CategoryTheory.Limits.pullback.fst h_UW₀ pr_D ≫ W₀_ι_et :=
        hB_pr_fst j₀
      have hj_snd : j_Z ≫ snd_Z =
          CategoryTheory.Limits.pullback.snd h_UW₀ pr_D :=
        hB_pr_snd j₀
      have hw_j₀ : W₀_ι_et ≫ h_W = h_UW₀ :=
        ((AlgebraicGeometry.Scheme.Etale.forget D_left).map j₀).w
      have hpb_outer₀ : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.snd h_UW₀ pr_D)
          (CategoryTheory.Limits.pullback.fst h_UW₀ pr_D)
          pr_D (W₀_ι_et ≫ h_W) :=
        Eq.ndrec
          (motive := fun g => CategoryTheory.IsPullback
            (CategoryTheory.Limits.pullback.snd h_UW₀ pr_D)
            (CategoryTheory.Limits.pullback.fst h_UW₀ pr_D) pr_D g)
          (CategoryTheory.IsPullback.of_hasPullback h_UW₀ pr_D).flip hw_j₀.symm
      have hpb_outer : CategoryTheory.IsPullback
          (j_Z ≫ snd_Z)
          (CategoryTheory.Limits.pullback.fst h_UW₀ pr_D)
          pr_D (W₀_ι_et ≫ h_W) :=
        Eq.ndrec
          (motive := fun f => CategoryTheory.IsPullback f
            (CategoryTheory.Limits.pullback.fst h_UW₀ pr_D) pr_D (W₀_ι_et ≫ h_W))
          hpb_outer₀ hj_snd.symm
      have hpb_left : CategoryTheory.IsPullback
          j_Z
          (CategoryTheory.Limits.pullback.fst h_UW₀ pr_D)
          fst_Z W₀_ι_et :=
        CategoryTheory.IsPullback.of_right hpb_outer hj_fst
          (CategoryTheory.IsPullback.of_hasPullback h_W pr_D).flip
      have hrange_W₀ : Set.range W₀_ι_et.base = (W₀ : Set _) :=
        (congrArg (fun m : ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj U_W₀).left ⟶
            ((AlgebraicGeometry.Scheme.Etale.forget D_left).obj W).left => Set.range m.base)
          hj₀_left).trans (AlgebraicGeometry.Scheme.Opens.range_ι W₀)
      have hx_range : fst_Z.base z ∈ Set.range W₀_ι_et.base :=
        Eq.mpr (congrArg (fst_Z.base z ∈ ·) hrange_W₀) hzW₀
      rcases hx_range with ⟨x₀, hx₀⟩
      obtain ⟨q₀, hq₀_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z x₀ hx₀.symm
      let z0 : ↥(CategoryTheory.Limits.pullback h_UW₀ pr_D) := hpb_left.isoPullback.inv.base q₀
      let z0_et : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj (B_pr.obj U_W₀)).left := z0
      have hz0_eq :
          ((AlgebraicGeometry.Scheme.Etale.forget S).map (B_pr.map j₀)).left.base z0_et = z_raw := by
        have hinv : (hpb_left.isoPullback.inv ≫ j_Z).base q₀ =
            (CategoryTheory.Limits.pullback.fst fst_Z W₀_ι_et).base q₀ :=
          congrArg
            (fun m : CategoryTheory.Limits.pullback fst_Z W₀_ι_et ⟶
                CategoryTheory.Limits.pullback h_W pr_D => m.base q₀)
            hpb_left.isoPullback_inv_fst
        exact hinv.trans hq₀_fst
      have hcollar_eval : ∀ η' : Quiver.Hom 𝒥 (R_pr.obj (weilEtaleTorsionSheaf S m)),
          L_of η' W s₀ z_raw = 0 := by
        intro η'
        have h1 : L_of η' U_W₀ ((𝒥.obj.map (Opposite.op j₀)) s₀) z0_et =
            L_of η' W s₀
              (((AlgebraicGeometry.Scheme.Etale.forget S).map (B_pr.map j₀)).left.base z0_et) :=
          congrArg (fun f => f z0_et) (hL_nat η' j₀ s₀)
        have h2 : L_of η' U_W₀ ((𝒥.obj.map (Opposite.op j₀)) s₀) z0_et = 0 :=
          (congrArg (fun s => L_of η' U_W₀ s z0_et) hj₀_zero).trans
            (congrArg
              (fun f : LocallyConstant _ (ULift.{u} (ZMod m)) => f z0_et)
              (map_zero (L_of η' U_W₀)))
        exact (congrArg (L_of η' W s₀) hz0_eq.symm).trans (h1.symm.trans h2)
      exact (hcollar_eval η₁).trans (hcollar_eval η₂).symm

  exact ⟨η_α, ⟨Function.LeftInverse.injective h_left_inv, fun η => ⟨β_inv η, h_right_inv η⟩⟩,
    hAdd_η, hEval_η⟩

theorem weil_coinv_frob_site_gauge_and_ext_intertwining (F : Type u) [Finite F] [Field F]
    (Y₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (i : ℕ)
    (hCont_pr :
      (weilEtaleSitePullback
        (CategoryTheory.Limits.pullback.fst Y₀.hom
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))).IsContinuous
        Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology)
    (hAdj_pr :
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback
          (CategoryTheory.Limits.pullback.fst Y₀.hom
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
        AddCommGrpCat.{u} _
        Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology
        hCont_pr).IsRightAdjoint) :
    let S := weilGeomScheme F Y₀
    let pr_Y : Quiver.Hom S Y₀.left :=
      CategoryTheory.Limits.pullback.fst Y₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
    let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let B_pr := weilEtaleSitePullback pr_Y
    let L_pr := @CategoryTheory.Functor.sheafPullback _ _ _ _
      B_pr AddCommGrpCat.{u} _
      Y₀.left.smallEtaleTopology S.smallEtaleTopology hCont_pr hAdj_pr
    let adj_pr := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
      B_pr AddCommGrpCat.{u} _
      Y₀.left.smallEtaleTopology S.smallEtaleTopology hCont_pr hAdj_pr
