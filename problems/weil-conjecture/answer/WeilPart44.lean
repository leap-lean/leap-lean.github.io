          ((congrArg (_ ≫ ·) (hu_snd (p_W W))).trans (hσ_snd W g))
    have hσ_tri1 : ∀ (W : S.Etale) (g : Γ),
        CategoryTheory.CategoryStruct.comp (σ_g W g) (u_can (σ_g W 1)) =
