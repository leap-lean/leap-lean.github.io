        _ = ((ℓ : Padic ℓ) ^ k₂) *
              (((ℓ : Padic ℓ) ^ k₁) * ((((ℓ : Padic ℓ) ^ k₂)⁻¹) * B_int w₂ v)) := by
              calc ((ℓ : Padic ℓ) ^ k₁) * B_int w₂ v
                  = ((ℓ : Padic ℓ) ^ k₁) *
                      ((((ℓ : Padic ℓ) ^ k₂) * ((ℓ : Padic ℓ) ^ k₂)⁻¹) * B_int w₂ v) := by
                      rw [mul_inv_cancel₀ hpow2_ne, one_mul]
                _ = ((ℓ : Padic ℓ) ^ k₂) *
                      (((ℓ : Padic ℓ) ^ k₁) * ((((ℓ : Padic ℓ) ^ k₂)⁻¹) * B_int w₂ v)) := by
                      ring
    let B_coinv : U₁ →ₗ[Padic ℓ] (V →ₗ[Padic ℓ] Padic ℓ) :=
