  refine ⟨Ψ, ?_, ?_⟩
  · refine ⟨⟨T_sh, hAdd, hLim, hColim, triv_T, e_one, ε_tr,
      hT_range, hT_res, hT_map, ?_, ?_, fun _ => rfl⟩⟩
    · intro W s y
      let h_W := (Fgt.obj W).hom
      let W_V := CategoryTheory.Limits.pullback h_W ι_V
      let δ_W : Quiver.Hom W_V (CategoryTheory.Limits.pullback ((Fgt.obj (obj_WV W)).hom) ι_V) :=
        CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id W_V)
          (CategoryTheory.Limits.pullback.snd h_W ι_V)
          ((CategoryTheory.Category.id_comp _).trans CategoryTheory.Limits.pullback.condition)
