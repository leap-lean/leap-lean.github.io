      · exact (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·) (hσ_snd W₂ g)).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ act g) (hu_snd u)).trans
