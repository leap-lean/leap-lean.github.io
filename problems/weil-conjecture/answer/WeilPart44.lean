      have hu_cast : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (a + 1))) (ZMod (ℓ ^ (a + 1))) u_val =
          (u_val.val : ZMod (ℓ ^ (a + 1))) := by
        conv_lhs => rw [← ZMod.natCast_zmod_val u_val]
        rw [map_natCast]
      rw [hemb_apply a b c hc, hemb_apply (a + 1) b (c + 1) hc', hu_cast, ZMod.val_natCast,
        hModEq a b c hc u_val.val, map_natCast]

    have hMul_bock : ∀ r : ℕ,
        CategoryTheory.CategoryStruct.comp (τ_𝒥_ab_step r) (ι_bock_sh r 0 (r + 1) rfl) =
          ℓ • CategoryTheory.CategoryStruct.id (𝒥_ab (r + 1)) := by
      intro r
      have hNsmul_app : ∀ (c_n : ℕ) (W : S.Etale) (s : ↑((𝒥_ab (r + 1)).obj.obj (Opposite.op W))),
          (((c_n • CategoryTheory.CategoryStruct.id (𝒥_ab (r + 1))).hom.app (Opposite.op W)).hom s) =
            c_n • s := by
        intro c_n W s
        induction c_n with
        | zero =>
          rw [zero_nsmul, zero_nsmul]
          have h0 : (0 : Quiver.Hom (𝒥_ab (r + 1)) (𝒥_ab (r + 1))).hom = 0 :=
            (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).map_zero _ _
          rw [h0]
          rfl
        | succ k ih =>
          rw [succ_nsmul, succ_nsmul]
          have hadd : ((k • CategoryTheory.CategoryStruct.id (𝒥_ab (r + 1)) +
              CategoryTheory.CategoryStruct.id (𝒥_ab (r + 1))).hom) =
              (k • CategoryTheory.CategoryStruct.id (𝒥_ab (r + 1))).hom +
              (CategoryTheory.CategoryStruct.id (𝒥_ab (r + 1))).hom :=
            (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).map_add
          rw [hadd]
          change (((k • CategoryTheory.CategoryStruct.id (𝒥_ab (r + 1))).hom.app
              (Opposite.op W)).hom s) + s = k • s + s
          rw [ih]
      apply hSheafHomExt_J
      intro W s_up y_up i
      rw [hNsmul_app ℓ W s_up, map_nsmul]
      change triv_J (r + 1) W (((ι_bock_sh r 0 (r + 1) rfl).hom.app (Opposite.op W)).hom
          (((τ_𝒥_ab_step r).hom.app (Opposite.op W)).hom s_up)) y_up i =
        ℓ • triv_J (r + 1) W s_up y_up i
      rw [hι_bock_spec r 0 (r + 1) rfl (Nat.le_succ r) W _ y_up i]
      have hm_succ : m_le (Fgt.obj W).hom (Nat.le_succ r) = m_ι_can r (Fgt.obj W).hom := by
        change m_le (Fgt.obj W).hom (Nat.le_succ_of_le (le_refl r)) = _
