          intro p
          obtain ⟨Y, f, q, hf_arr, _, hfq⟩ := (hMem W R_sieve).mp hR p
          exact ⟨Y, f, hf_arr, q, hfq⟩
        choose Y_p f_p hf_p q_p hq_p using hCov_base
        have hLift_pt : ∀ {Y : S.Etale} (u : Y ⟶ W) (z : ↥W_V) (y : ↥(Fgt.obj Y).left),
            (Fgt.map u).left.base y = (CategoryTheory.Limits.pullback.fst h_W ι).base z →
            ∃ w : ↥(CategoryTheory.Limits.pullback (Fgt.obj Y).hom ι),
              (u_can u).base w = z ∧
              (CategoryTheory.Limits.pullback.fst (Fgt.obj Y).hom ι).base w = y := by
          intro Y u z y hy
          obtain ⟨pt, hpt_fst, hpt_snd⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hy.symm
          refine ⟨((hu_pb u).isoPullback.inv).base pt, ?_, ?_⟩
          · have h1 := congrArg (fun k => k.base pt) (hu_pb u).isoPullback_inv_fst
            rw [AlgebraicGeometry.Scheme.Hom.comp_apply] at h1
            exact h1.trans hpt_fst
          · have h2 := congrArg (fun k => k.base pt) (hu_pb u).isoPullback_inv_snd
            rw [AlgebraicGeometry.Scheme.Hom.comp_apply] at h2
            exact h2.trans hpt_snd
        have hOverlap : ∀ (m : ↥M_grp) {Y₁ Y₂ : S.Etale} (f₁ : Y₁ ⟶ W) (f₂ : Y₂ ⟶ W)
            (hf₁ : R_sieve.arrows f₁) (hf₂ : R_sieve.arrows f₂)
            (w₁ : ↥(CategoryTheory.Limits.pullback (Fgt.obj Y₁).hom ι))
            (w₂ : ↥(CategoryTheory.Limits.pullback (Fgt.obj Y₂).hom ι)),
            (u_can f₁).base w₁ = (u_can f₂).base w₂ →
            ((x f₁ hf₁).hom m).1 w₁ = ((x f₂ hf₂).hom m).1 w₂ := by
          intro m Y₁ Y₂ f₁ f₂ hf₁ hf₂ w₁ w₂ hw_eq
          let u₁_left := (Fgt.map f₁).left
          let u₂_left := (Fgt.map f₂).left
          let P₁₂ := CategoryTheory.Limits.pullback u₁_left u₂_left
          let p₁ := CategoryTheory.Limits.pullback.fst u₁_left u₂_left
          let p₂ := CategoryTheory.Limits.pullback.snd u₁_left u₂_left
          have hp₁_et : AlgebraicGeometry.Etale p₁ :=
            CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
              (CategoryTheory.IsPullback.of_hasPullback u₁_left u₂_left).flip (hu_et f₂)
          have hp₁Y₁_et : AlgebraicGeometry.Etale (p₁ ≫ (Fgt.obj Y₁).hom) :=
            CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
              p₁ (Fgt.obj Y₁).hom hp₁_et Y₁.prop
          let Z₁₂ : S.Etale := AlgebraicGeometry.Scheme.Etale.mk (p₁ ≫ (Fgt.obj Y₁).hom)
          have hp₂_w : p₂ ≫ (Fgt.obj Y₂).hom = (Fgt.obj Z₁₂).hom := by
            change p₂ ≫ (Fgt.obj Y₂).hom = p₁ ≫ (Fgt.obj Y₁).hom
            rw [← (Fgt.map f₂).w, ← CategoryTheory.Category.assoc,
              ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
              (Fgt.map f₁).w]
          let p1_et : Z₁₂ ⟶ Y₁ :=
            (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful S).preimage
              (CategoryTheory.Over.homMk p₁ rfl)
          let p2_et : Z₁₂ ⟶ Y₂ :=
            (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful S).preimage
              (CategoryTheory.Over.homMk p₂ hp₂_w)
          have hp1_et_left : (Fgt.map p1_et).left = p₁ :=
            congrArg CategoryTheory.Over.Hom.left
              ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful S).map_preimage _)
          have hp2_et_left : (Fgt.map p2_et).left = p₂ :=
            congrArg CategoryTheory.Over.Hom.left
              ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful S).map_preimage _)
          have hp_comm : p1_et ≫ f₁ = p2_et ≫ f₂ := by
            apply (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful S).map_injective
            apply CategoryTheory.Over.OverMorphism.ext
            change (Fgt.map (p1_et ≫ f₁)).left = (Fgt.map (p2_et ≫ f₂)).left
            rw [Fgt.map_comp, Fgt.map_comp]
            change (Fgt.map p1_et).left ≫ u₁_left = (Fgt.map p2_et).left ≫ u₂_left
            rw [hp1_et_left, hp2_et_left]
            exact CategoryTheory.Limits.pullback.condition
          let Q := CategoryTheory.Limits.pullback (u_can f₁) (u_can f₂)
          let q₁ := CategoryTheory.Limits.pullback.fst (u_can f₁) (u_can f₂)
          let q₂ := CategoryTheory.Limits.pullback.snd (u_can f₁) (u_can f₂)
          obtain ⟨q, hq₁, hq₂⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w₁ w₂ hw_eq
          have hψ_U_cond : (q₁ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj Y₁).hom ι) ≫ u₁_left =
              (q₂ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj Y₂).hom ι) ≫ u₂_left := by
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              ← hu_can_fst f₁, ← hu_can_fst f₂,
              ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.condition]
          let ψ_U : Q ⟶ P₁₂ :=
            CategoryTheory.Limits.pullback.lift
              (q₁ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj Y₁).hom ι)
              (q₂ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj Y₂).hom ι)
              hψ_U_cond
          have hψU_fst : ψ_U ≫ p₁ = q₁ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj Y₁).hom ι :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hψU_snd : ψ_U ≫ p₂ = q₂ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj Y₂).hom ι :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hψ_cond : ψ_U ≫ (Fgt.obj Z₁₂).hom =
              (q₁ ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj Y₁).hom ι) ≫ ι := by
            change ψ_U ≫ (p₁ ≫ (Fgt.obj Y₁).hom) = _
            rw [← CategoryTheory.Category.assoc, hψU_fst,
              CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
              CategoryTheory.Category.assoc]
          let ψ : Q ⟶ CategoryTheory.Limits.pullback (Fgt.obj Z₁₂).hom ι :=
            CategoryTheory.Limits.pullback.lift ψ_U
              (q₁ ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj Y₁).hom ι) hψ_cond
          have hψ_fst : ψ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj Z₁₂).hom ι = ψ_U :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hψ_snd : ψ ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj Z₁₂).hom ι =
              q₁ ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj Y₁).hom ι :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hψ_p₁ : ψ ≫ u_can p1_et = q₁ := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Category.assoc, hu_can_fst p1_et,
                ← CategoryTheory.Category.assoc, hψ_fst, hp1_et_left]
              exact hψU_fst
            · rw [CategoryTheory.Category.assoc, hu_can_snd p1_et, hψ_snd]
          have hψ_p₂ : ψ ≫ u_can p2_et = q₂ := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Category.assoc, hu_can_fst p2_et,
                ← CategoryTheory.Category.assoc, hψ_fst, hp2_et_left]
              exact hψU_snd
            · rw [CategoryTheory.Category.assoc, hu_can_snd p2_et, hψ_snd]
              calc q₁ ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj Y₁).hom ι
                  = q₁ ≫ u_can f₁ ≫ CategoryTheory.Limits.pullback.snd h_W ι := by
                      rw [hu_can_snd f₁]
                _ = (q₁ ≫ u_can f₁) ≫ CategoryTheory.Limits.pullback.snd h_W ι :=
                      (CategoryTheory.Category.assoc _ _ _).symm
                _ = (q₂ ≫ u_can f₂) ≫ CategoryTheory.Limits.pullback.snd h_W ι := by
                      rw [CategoryTheory.Limits.pullback.condition]
                _ = q₂ ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj Y₂).hom ι := by
                      rw [CategoryTheory.Category.assoc, hu_can_snd f₂]
          have hcompat :
              (x f₁ hf₁ ≫ 𝒥_pre.map (Opposite.op p1_et) : M_grp ⟶ 𝒥_pre.obj (Opposite.op Z₁₂)) =
                x f₂ hf₂ ≫ 𝒥_pre.map (Opposite.op p2_et) :=
            hx p1_et p2_et hf₁ hf₂ hp_comm
          have hval := congrArg (fun k : M_grp ⟶ 𝒥_pre.obj (Opposite.op Z₁₂) => (k.hom m).1 (ψ.base q))
            hcompat
          change ((x f₁ hf₁).hom m).1 ((u_can p1_et).base (ψ.base q)) =
            ((x f₂ hf₂).hom m).1 ((u_can p2_et).base (ψ.base q)) at hval
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, ← AlgebraicGeometry.Scheme.Hom.comp_apply,
            hψ_p₁, hψ_p₂, hq₁, hq₂] at hval
          exact hval
        let p_z : ↥W_V → ↥(Fgt.obj W).left :=
          fun z => (CategoryTheory.Limits.pullback.fst h_W ι).base z
        let Y_z : ↥W_V → S.Etale := fun z => Y_p (p_z z)
        let f_z : ∀ z : ↥W_V, Y_z z ⟶ W := fun z => f_p (p_z z)
        have hf_z : ∀ z : ↥W_V, R_sieve.arrows (f_z z) := fun z => hf_p (p_z z)
        let w_z : ∀ z : ↥W_V, ↥(CategoryTheory.Limits.pullback (Fgt.obj (Y_z z)).hom ι) :=
          fun z => Classical.choose (hLift_pt (f_z z) z (q_p (p_z z)) (hq_p (p_z z)))
        have hw_z : ∀ z : ↥W_V, (u_can (f_z z)).base (w_z z) = z :=
          fun z => (Classical.choose_spec (hLift_pt (f_z z) z (q_p (p_z z)) (hq_p (p_z z)))).1
        let f_m : ↥M_grp → ↥W_V → A :=
          fun m z => ((x (f_z z) (hf_z z)).hom m).1 (w_z z)
        have hf_m_eval : ∀ (m : ↥M_grp) {Y : S.Etale} (f : Y ⟶ W) (hf : R_sieve.arrows f)
            (w : ↥(CategoryTheory.Limits.pullback (Fgt.obj Y).hom ι)),
            f_m m ((u_can f).base w) = ((x f hf).hom m).1 w := by
          intro m Y f hf w
          exact hOverlap m (f_z ((u_can f).base w)) f (hf_z _) hf (w_z _) w (hw_z _)
        have hf_m_lc : ∀ m : ↥M_grp, IsLocallyConstant (f_m m) := by
          intro m S_set
          have hpre : f_m m ⁻¹' S_set =
              ⋃ z : ↥W_V, (u_can (f_z z)).base '' (((x (f_z z) (hf_z z)).hom m).1 ⁻¹' S_set) := by
            ext z₀
            simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_image]
            constructor
            · intro hz₀
              exact ⟨z₀, w_z z₀, hz₀, hw_z z₀⟩
            · rintro ⟨z, w, hw_mem, rfl⟩
              rwa [hf_m_eval m (f_z z) (hf_z z) w]
          rw [hpre]
          refine isOpen_iUnion fun z => ?_
          have : AlgebraicGeometry.Etale (u_can (f_z z)) := hu_can_et (f_z z)
          exact (u_can (f_z z)).isOpenMap _ (((x (f_z z) (hf_z z)).hom m).1.isLocallyConstant S_set)
        have hf_m_mem : ∀ m : ↥M_grp, ⟨f_m m, hf_m_lc m⟩ ∈ S_! W := by
          intro m
          refine ⟨?_, ?_⟩
          · choose W₀_p hcov_p hvan_p using fun p => ((x (f_p p) (hf_p p)).hom m).2.1
            let O_p : ↥(Fgt.obj W).left → (Fgt.obj W).left.Opens := fun p =>
              have : AlgebraicGeometry.Etale (Fgt.map (f_p p)).left := hu_et (f_p p)
              ⟨(Fgt.map (f_p p)).left.base '' (W₀_p p : Set ↥(Fgt.obj (Y_p p)).left),
                ((Fgt.map (f_p p)).left).isOpenMap _ (W₀_p p).isOpen⟩
            let W₀ : (Fgt.obj W).left.Opens := ⨆ p : ↥(Fgt.obj W).left, O_p p
            refine ⟨W₀, ?_, ?_⟩
            · rw [eq_top_iff]
              intro p _
              have hq_mem : q_p p ∈
                  ((TopologicalSpace.Opens.map (Fgt.obj (Y_p p)).hom.base).obj U₀) ⊔ W₀_p p := by
                rw [hcov_p p]
                trivial
              rcases hq_mem with hqU | hqW
              · left
                change h_W.base p ∈ U₀
                have hw : (Fgt.map (f_p p)).left ≫ h_W = (Fgt.obj (Y_p p)).hom := (Fgt.map (f_p p)).w
                rw [← hq_p p, ← AlgebraicGeometry.Scheme.Hom.comp_apply, hw]
                exact hqU
              · right
                exact TopologicalSpace.Opens.mem_iSup.mpr ⟨p, ⟨q_p p, hqW, hq_p p⟩⟩
            · intro z hz
              obtain ⟨p, hp⟩ := TopologicalSpace.Opens.mem_iSup.mp hz
              rcases hp with ⟨w_p, hw_p_mem, hw_p_eq⟩
              obtain ⟨z_p, hz_p_u, hz_p_fst⟩ := hLift_pt (f_p p) z w_p hw_p_eq
