          funext ⟨j, g₀⟩
          change (∑ g : Γ, (MonoidAlgebra.single g (f (j, g)) : R)).coeff g₀ = f (j, g₀)
          rw [h_coeff_sum, Finset.sum_eq_single g₀]
          · rw [MonoidAlgebra.coeff_single, Finsupp.single_apply]; simp
          · intro g _ hne
            rw [MonoidAlgebra.coeff_single, Finsupp.single_apply]; simp [hne]
          · intro hg₀
            exact False.elim (hg₀ (Finset.mem_univ g₀)) }
    let e_fin_Q : ∀ m : ℕ, (Fin m → R) ≃ₗ[Λ] (Fin (Fintype.card (Fin m × Γ)) → Λ) :=
