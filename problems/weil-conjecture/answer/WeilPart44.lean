  have hSingleLevel := fun r : ℕ =>
    @weil_coinv_single_level_sheaf_hom_descent_and_frob_square
      D₀.left S pr_D M_c2.hCont_pr M_c2.hAdj_pr U₀ R₀ (B r) _ _ _ e_U (hπ_et r) (hSheets_a r)
