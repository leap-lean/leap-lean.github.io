      apply AddCommGrpCat.ext
      intro s₀
      obtain ⟨g_cur, hg_cur⟩ := (hθ_bij (B_pr.obj W)).2
        (((adj_pr.homEquiv ℱ₀ FM
          (CategoryTheory.CategoryStruct.comp iso_bar.hom φ_cur)).hom.app (Opposite.op W)).hom s₀)
      obtain ⟨g_next, hg_next⟩ := (hθ_bij (B_pr.obj W)).2
        (((adj_pr.homEquiv ℱ₀ FM
          (CategoryTheory.CategoryStruct.comp iso_bar.hom φ_next)).hom.app (Opposite.op W)).hom s₀)
      have h_lhs_pt :
