              (((ℓ : Padic ℓ) ^ k) * vecOf ψ.1 x) := by
              refine Finset.sum_congr rfl fun x _ => by rw [map_mul, hw x]
        _ = ((ℓ : Padic ℓ) ^ k) * ∑ x : Fin N,
              algebraMap (PadicInt ℓ) (Padic ℓ) (h.val x i) * vecOf ψ.1 x := by
