      · exact (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·) (hu_snd (σ_g W 1))).trans
            ((hσ_snd W g).trans
              ((congrArg (· ≫ act g)
                ((CategoryTheory.Category.comp_id (snd₁ W)).symm.trans
