        _ = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp p_E δ₁₂) π₁ :=
              (CategoryTheory.Category.assoc _ _ _).symm
        _ = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp q_E Δ_x) π₁ := by
              rw [hcond_E]
        _ = CategoryTheory.CategoryStruct.comp q_E (CategoryTheory.CategoryStruct.comp Δ_x π₁) :=
              CategoryTheory.Category.assoc _ _ _
        _ = q_E := by
              rw [CategoryTheory.Limits.pullback.diagonal_fst, CategoryTheory.Category.comp_id]
        _ = CategoryTheory.CategoryStruct.comp q_E (CategoryTheory.CategoryStruct.comp Δ_x π₂) := by
              rw [CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.comp_id]
        _ = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp q_E Δ_x) π₂ :=
