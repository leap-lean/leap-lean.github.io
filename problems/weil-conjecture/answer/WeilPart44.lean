    rw [CategoryTheory.Abelian.Ext.comp_assoc w
        (CategoryTheory.Abelian.Ext.mk₀ e_dual.hom)
        (CategoryTheory.Abelian.Ext.mk₀ e_dual.inv)
        (Nat.add_zero 1) (Nat.zero_add 0) (Nat.add_zero 1),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      e_dual.hom_inv_id,
      CategoryTheory.Abelian.Ext.comp_mk₀_id,
      CategoryTheory.Abelian.Ext.zero_comp] at h_end
    exact h_end

theorem weil_curve_mid_ext_pinned_shriek_open_res_lift (k : Type u) [Field k] [IsAlgClosed k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 X.hom]
    (U : X.left.Opens)
    (hU_ne : Nonempty ↥U)
    (m M : ℕ) (hm : 1 ≤ m) (hM : 1 ≤ M)
    (h_et_V : ∀ {V : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom V U.toScheme),
      AlgebraicGeometry.Etale π → AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp π U.ι))
    (L : WeilCurveMidExtLevelWitness X.left U m M)
    (Ψ : CategoryTheory.Abelian.Ext.{u} (weilEtaleModuleUnit X.left m) L.ℳ_dual 1 →+
      CategoryTheory.Abelian.Ext.{u} L.𝒥 (weilEtaleModuleUnit X.left m) 1)
    (hShriek : WeilCurveMidExtIsShriekDualMapPinned X.left U m M (@h_et_V) L Ψ)
    (w : CategoryTheory.Abelian.Ext.{u} (weilEtaleModuleUnit X.left m) L.ℳ_dual 1) :
    ∃ w_hat : CategoryTheory.Abelian.Ext.{u} L.ℳ (weilEtaleModuleUnit X.left m) 1,
      (CategoryTheory.Abelian.Ext.mk₀ L.ι_ext).comp w_hat (Nat.zero_add 1) = Ψ w :=
by
  classical
  have _ := hm
  have _ := hM
  
  have hAbsLift :
      ∀ {𝒞₀ : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞₀]
        [CategoryTheory.Abelian 𝒞₀] [CategoryTheory.HasExt.{u} 𝒞₀]
        [CategoryTheory.EnoughInjectives 𝒞₀]
        (one₀ M_dual J_obj M_obj : 𝒞₀)
        (ι_ext : Quiver.Hom J_obj M_obj)
        (T₀ : CategoryTheory.Functor 𝒞₀ 𝒞₀)
        [T₀.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits T₀]
        [CategoryTheory.Limits.PreservesFiniteColimits T₀]
        (e_one : CategoryTheory.Iso J_obj (T₀.obj one₀))
        (ε_tr : Quiver.Hom (T₀.obj M_dual) one₀)
        (J₀ : CategoryTheory.Functor 𝒞₀ 𝒞₀)
        [J₀.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits J₀]
        (η₀ : Quiver.Hom (CategoryTheory.Functor.id 𝒞₀) J₀)
        (θ_M : CategoryTheory.Iso (J₀.obj J_obj) M_obj)
        (_hθ_M : CategoryTheory.CategoryStruct.comp (η₀.app J_obj) θ_M.hom = ι_ext)
        (_hIso_one : CategoryTheory.IsIso (η₀.app one₀))
        (_hEpi_JT : ∀ (ℱ : 𝒞₀) (p : Quiver.Hom ℱ one₀),
          CategoryTheory.Epi p → CategoryTheory.Epi (J₀.map (T₀.map p)))
        (w₀ : CategoryTheory.Abelian.Ext.{u} one₀ M_dual 1),
        ∃ w_hat : CategoryTheory.Abelian.Ext.{u} M_obj one₀ 1,
          (CategoryTheory.Abelian.Ext.mk₀ ι_ext).comp w_hat (Nat.zero_add 1) =
            (CategoryTheory.Abelian.Ext.mk₀ e_one.hom).comp
              (((T₀.mapExtAddHom one₀ M_dual 1) w₀).comp
                (CategoryTheory.Abelian.Ext.mk₀ ε_tr) (Nat.add_zero 1))
              (Nat.zero_add 1) := by
    intro 𝒞₀ _ _ _ _ one₀ M_dual J_obj M_obj ι_ext T₀ _ _ _ e_one ε_tr
      J₀ _ _ η₀ θ_M hθ_M hIso_one hEpi_JT w₀
    let I : 𝒞₀ := CategoryTheory.Injective.under M_dual
    let ι_I : Quiver.Hom M_dual I := CategoryTheory.Injective.ι M_dual
    have hMono_I : CategoryTheory.Mono ι_I := CategoryTheory.Injective.ι_mono M_dual
    let K : 𝒞₀ := CategoryTheory.Limits.cokernel ι_I
    let π_I : Quiver.Hom I K := CategoryTheory.Limits.cokernel.π ι_I
    have hEpi_I : CategoryTheory.Epi π_I := CategoryTheory.Limits.coequalizer.π_epi
    let S_inj : CategoryTheory.ShortComplex 𝒞₀ :=
      CategoryTheory.ShortComplex.mk ι_I π_I (CategoryTheory.Limits.cokernel.condition ι_I)
    have hS_inj : S_inj.ShortExact :=
      { exact := CategoryTheory.ShortComplex.exact_cokernel ι_I
        mono_f := hMono_I
        epi_g := hEpi_I }
    have hSub_I : Subsingleton (CategoryTheory.Abelian.Ext.{u} one₀ I 1) :=
      CategoryTheory.Abelian.Ext.subsingleton_of_injective one₀ I 0
    have hw_ι : w₀.comp (CategoryTheory.Abelian.Ext.mk₀ ι_I) (Nat.add_zero 1) = 0 :=
      @Subsingleton.elim _ hSub_I _ _
    obtain ⟨x₃, hx₃⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ one₀ hS_inj w₀ hw_ι (Nat.zero_add 1)
    let h : Quiver.Hom one₀ K := CategoryTheory.Abelian.Ext.homEquiv₀ x₃
    have hx₃_eq : CategoryTheory.Abelian.Ext.mk₀ h = x₃ :=
      CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply x₃
    let ℱ : 𝒞₀ := CategoryTheory.Limits.pullback π_I h
    let p_I : Quiver.Hom ℱ I := CategoryTheory.Limits.pullback.fst π_I h
    let p_w : Quiver.Hom ℱ one₀ := CategoryTheory.Limits.pullback.snd π_I h
    have hcond0 : CategoryTheory.CategoryStruct.comp ι_I π_I =
        CategoryTheory.CategoryStruct.comp (0 : Quiver.Hom M_dual one₀) h := by
      rw [CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.zero_comp]
    let f_w : Quiver.Hom M_dual ℱ := CategoryTheory.Limits.pullback.lift ι_I 0 hcond0
    have hfw_pI : CategoryTheory.CategoryStruct.comp f_w p_I = ι_I :=
      CategoryTheory.Limits.pullback.lift_fst ι_I 0 hcond0
    have hfw_pw : CategoryTheory.CategoryStruct.comp f_w p_w = 0 :=
      CategoryTheory.Limits.pullback.lift_snd ι_I 0 hcond0
    have hMono_fw : CategoryTheory.Mono f_w := ⟨fun {Z} u₁ u₂ hu => by
      apply (cancel_mono ι_I).mp
      rw [← hfw_pI, ← CategoryTheory.Category.assoc, hu, CategoryTheory.Category.assoc]⟩
    have hEpi_pw : CategoryTheory.Epi p_w := CategoryTheory.Abelian.epi_pullback_of_epi_f π_I h
    let lift_sub : ∀ {W' : 𝒞₀} (k_mor : Quiver.Hom W' ℱ),
        CategoryTheory.CategoryStruct.comp k_mor p_w = 0 →
        { l : Quiver.Hom W' M_dual //
          CategoryTheory.CategoryStruct.comp l ι_I = CategoryTheory.CategoryStruct.comp k_mor p_I } :=
      fun k_mor hk =>
        CategoryTheory.Limits.KernelFork.IsLimit.lift' hS_inj.fIsKernel
          (CategoryTheory.CategoryStruct.comp k_mor p_I) (by
            change (k_mor ≫ p_I) ≫ π_I = 0
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
              ← CategoryTheory.Category.assoc, hk, CategoryTheory.Limits.zero_comp])
    have hLim_fw : CategoryTheory.Limits.IsLimit (CategoryTheory.Limits.KernelFork.ofι f_w hfw_pw) := by
      refine CategoryTheory.Limits.KernelFork.IsLimit.ofι f_w hfw_pw
        (fun {W'} k_mor hk => (lift_sub k_mor hk).1)
        (fun {W'} k_mor hk => ?_)
        (fun {W'} k_mor hk m₀ hm₀ => ?_)
      · apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, hfw_pI]
          exact (lift_sub k_mor hk).2
        · rw [CategoryTheory.Category.assoc, hfw_pw, CategoryTheory.Limits.comp_zero, hk]
      · apply (cancel_mono f_w).mp
        rw [hm₀]
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, hfw_pI]
          exact (lift_sub k_mor hk).2.symm
        · rw [CategoryTheory.Category.assoc, hfw_pw, CategoryTheory.Limits.comp_zero, hk]
    let S_w : CategoryTheory.ShortComplex 𝒞₀ := CategoryTheory.ShortComplex.mk f_w p_w hfw_pw
    have hS_w : S_w.ShortExact :=
      { exact := S_w.exact_of_f_is_kernel hLim_fw
        mono_f := hMono_fw
        epi_g := hEpi_pw }
    let φ_pb : Quiver.Hom S_w S_inj :=
      CategoryTheory.ShortComplex.homMk (CategoryTheory.CategoryStruct.id M_dual) p_I h
        (by dsimp [S_w, S_inj]; rw [CategoryTheory.Category.id_comp, hfw_pI])
        (CategoryTheory.Limits.pullback.condition (f := π_I) (g := h))
    have hnat_pb := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS_w hS_inj φ_pb
    have hw_ext : hS_w.extClass = w₀ := by
      have h1 : hS_w.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ φ_pb.τ₁) (Nat.add_zero 1) =
          hS_w.extClass := CategoryTheory.Abelian.Ext.comp_mk₀_id hS_w.extClass
      have h2 : (CategoryTheory.Abelian.Ext.mk₀ φ_pb.τ₃).comp hS_inj.extClass (Nat.zero_add 1) =
          w₀ := by
        change (CategoryTheory.Abelian.Ext.mk₀ h).comp hS_inj.extClass (Nat.zero_add 1) = w₀
        rw [hx₃_eq, hx₃]
      exact h1.symm.trans (hnat_pb.trans h2)
    let S_T : CategoryTheory.ShortComplex 𝒞₀ := S_w.map T₀
    have hS_T : S_T.ShortExact := hS_w.map_of_exact T₀
    have hST_ext : hS_T.extClass = (T₀.mapExtAddHom one₀ M_dual 1) w₀ := by
      rw [← hw_ext]
      exact (CategoryTheory.Abelian.Ext.mapExactFunctor_extClass T₀ hS_w).symm
    let S_TJ : CategoryTheory.ShortComplex 𝒞₀ := S_T.map J₀
    have hExact_TJ : S_TJ.Exact ∧ CategoryTheory.Mono S_TJ.f :=
      (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono J₀).mp
        inferInstance S_T hS_T
    have hEpi_TJ : CategoryTheory.Epi S_TJ.g := hEpi_JT ℱ p_w hEpi_pw
    have hS_TJ : S_TJ.ShortExact :=
      { exact := hExact_TJ.1
        mono_f := hExact_TJ.2
        epi_g := hEpi_TJ }
