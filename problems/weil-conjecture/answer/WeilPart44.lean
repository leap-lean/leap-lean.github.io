    have hLiftΨ : ∀ ψ : U₁,
        ∃ (k : ℕ) (w : ↥I_int),
          ∀ i : Fin N, algebraMap (PadicInt ℓ) (Padic ℓ) (w.1 i) =
            ((ℓ : Padic ℓ) ^ k) * vecOf ψ.1 i := by
      intro ψ
      obtain ⟨k, w₀, hw₀⟩ := hLiftVec (vecOf ψ.1)
      exact ⟨k, ⟨w₀, hmem_I_of_scale ψ k w₀ hw₀⟩, hw₀⟩
