    have h2 : (φ.hom.app (Opposite.op (Y_lvl Z c x))).hom
        ((𝒢₁.obj.map (Opposite.op (π_lvl Z c x))).hom t) =
        (𝒢₂.obj.map (Opposite.op (π_lvl Z c x))).hom
          ((φ.hom.app (Opposite.op Z)).hom t) := hnat₂
    exact h1.trans
      ((congrArg (φ.hom.app (Opposite.op (Y_lvl Z c x))).hom (hlc_spec 𝒢₁ Z c t x)).trans
        (((φ.hom.app (Opposite.op (Y_lvl Z c x))).hom.map_smul (c x) _).trans
          (congrArg (c x • ·) h2)))
  have hlc_map : ∀ (𝒢 : 𝒞) {Z₁ Z₂ : S.Etale} (u : Quiver.Hom Z₁ Z₂)
      (c : LocallyConstant ↥(Fgt.obj Z₂).left R) (t : ↑(𝒢.obj.obj (Opposite.op Z₂))),
      (𝒢.obj.map (Opposite.op u)).hom (lcSmul 𝒢 Z₂ c t) =
        lcSmul 𝒢 Z₁ (c.comap ((Fgt.map u).left).base.hom) ((𝒢.obj.map (Opposite.op u)).hom t) := by
    intro 𝒢 Z₁ Z₂ u c t
    let c₁ := c.comap ((Fgt.map u).left).base.hom
    apply hlc_uniq 𝒢 Z₁ c₁ ((𝒢.obj.map (Opposite.op u)).hom t)
    intro x₁
    exact (hMapComp 𝒢 (π_lvl Z₁ c₁ x₁) u (lcSmul 𝒢 Z₂ c t)).symm.trans
      ((hlc_const 𝒢 (π_lvl Z₁ c₁ x₁ ≫ u) c t (c₁ x₁) fun y => by
          have hm : (W_open_lvl Z₁ c₁ x₁).ι.base y ∈
              (W_open_lvl Z₁ c₁ x₁ : Set ↥(Fgt.obj Z₁).left) := by
            rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
            exact ⟨y, rfl⟩
          exact hm).trans
        (congrArg (c₁ x₁ • ·) (hMapComp 𝒢 (π_lvl Z₁ c₁ x₁) u t)))
  have hlc_zero : ∀ (𝒢 : 𝒞) (Z : S.Etale) (t : ↑(𝒢.obj.obj (Opposite.op Z))),
      lcSmul 𝒢 Z 0 t = 0 := by
    intro 𝒢 Z t
    symm
    apply hlc_uniq 𝒢 Z 0 t 0
    intro x
    change (𝒢.obj.map _).hom 0 = (0 : R) • _
    rw [map_zero, zero_smul]
  have hlc_add : ∀ (𝒢 : 𝒞) (Z : S.Etale) (c₁ c₂ : LocallyConstant ↥(Fgt.obj Z).left R)
      (t : ↑(𝒢.obj.obj (Opposite.op Z))),
      lcSmul 𝒢 Z (c₁ + c₂) t = lcSmul 𝒢 Z c₁ t + lcSmul 𝒢 Z c₂ t := by
    intro 𝒢 Z c₁ c₂ t
    let W₁₂ : ↥(Fgt.obj Z).left → ((Fgt.obj Z).left).Opens := fun x =>
      ⟨(c₁ : ↥(Fgt.obj Z).left → R) ⁻¹' {c₁ x} ∩ (c₂ : ↥(Fgt.obj Z).left → R) ⁻¹' {c₂ x},
        (c₁.isLocallyConstant {c₁ x}).inter (c₂.isLocallyConstant {c₂ x})⟩
    let Y₁₂ : ↥(Fgt.obj Z).left → S.Etale := fun x =>
      letI : AlgebraicGeometry.Etale (Fgt.obj Z).hom := Z.prop
      CategoryTheory.MorphismProperty.Over.mk ⊤
        (CategoryTheory.CategoryStruct.comp (W₁₂ x).ι (Fgt.obj Z).hom) inferInstance
    let π₁₂ : ∀ x : ↥(Fgt.obj Z).left, Quiver.Hom (Y₁₂ x) Z := fun x =>
      CategoryTheory.MorphismProperty.Over.homMk (W₁₂ x).ι rfl trivial
    have hcov₁₂ : ∀ x : ↥(Fgt.obj Z).left,
        ∃ i : ↥(Fgt.obj Z).left, x ∈ Set.range ⇑((Fgt.map (π₁₂ i)).left).base := by
      intro x
      refine ⟨x, ?_⟩
      change x ∈ Set.range (W₁₂ x).ι.base
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      exact ⟨rfl, rfl⟩
    have hmem₁₂ : ∀ (x : ↥(Fgt.obj Z).left) (y : ↥(Fgt.obj (Y₁₂ x)).left),
        c₁ (((Fgt.map (π₁₂ x)).left).base y) = c₁ x ∧
          c₂ (((Fgt.map (π₁₂ x)).left).base y) = c₂ x := by
      intro x y
      have hm : (W₁₂ x).ι.base y ∈ (W₁₂ x : Set ↥(Fgt.obj Z).left) := by
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
        exact ⟨y, rfl⟩
      exact hm
    obtain ⟨s₀, -, hs₀_uniq⟩ := hArrows_sheaf_G 𝒢 Z Y₁₂ π₁₂ hcov₁₂
      (fun x => (c₁ x + c₂ x) • (𝒢.obj.map (Opposite.op (π₁₂ x))).hom t)
      (fun x₁ x₂ E_et g₁ g₂ hcomm => by
        by_cases hE : IsEmpty ↥(Fgt.obj E_et).left
        · have := hEmpty_sub_G 𝒢 E_et hE
          exact Subsingleton.elim _ _
        · obtain ⟨e₀⟩ := not_isEmpty_iff.mp hE
          have h1 := hmem₁₂ x₁ (((Fgt.map g₁).left).base e₀)
          have h2 := hmem₁₂ x₂ (((Fgt.map g₂).left).base e₀)
          have hc₁_eq : c₁ x₁ = c₁ x₂ := by
            have heq := congrArg (fun φ => c₁ (((Fgt.map φ).left).base e₀)) hcomm
            exact h1.1.symm.trans (heq.trans h2.1)
          have hc₂_eq : c₂ x₁ = c₂ x₂ := by
            have heq := congrArg (fun φ => c₂ (((Fgt.map φ).left).base e₀)) hcomm
            exact h1.2.symm.trans (heq.trans h2.2)
          have hsum_eq : c₁ x₁ + c₂ x₁ = c₁ x₂ + c₂ x₂ := congrArg₂ (· + ·) hc₁_eq hc₂_eq
          have hs₁ := ((𝒢.obj.map (Opposite.op g₁)).hom.map_smul (c₁ x₁ + c₂ x₁) _).trans
            (congrArg ((c₁ x₁ + c₂ x₁) • ·) (hMapComp 𝒢 g₁ (π₁₂ x₁) t).symm)
          have hs₂ := ((𝒢.obj.map (Opposite.op g₂)).hom.map_smul (c₁ x₂ + c₂ x₂) _).trans
            (congrArg ((c₁ x₂ + c₂ x₂) • ·) (hMapComp 𝒢 g₂ (π₁₂ x₂) t).symm)
          exact hs₁.trans
            ((congrArg₂ (fun r₀ φ => r₀ • (𝒢.obj.map (Opposite.op φ)).hom t) hsum_eq hcomm).trans
              hs₂.symm))
    have hLHS : lcSmul 𝒢 Z (c₁ + c₂) t = s₀ :=
      hs₀_uniq _ fun x => hlc_const 𝒢 (π₁₂ x) (c₁ + c₂) t (c₁ x + c₂ x) fun y =>
        congrArg₂ (· + ·) (hmem₁₂ x y).1 (hmem₁₂ x y).2
    have hRHS : lcSmul 𝒢 Z c₁ t + lcSmul 𝒢 Z c₂ t = s₀ :=
      hs₀_uniq _ fun x =>
        ((𝒢.obj.map (Opposite.op (π₁₂ x))).hom.map_add _ _).trans
          ((congrArg₂ (· + ·)
            (hlc_const 𝒢 (π₁₂ x) c₁ t (c₁ x) fun y => (hmem₁₂ x y).1)
            (hlc_const 𝒢 (π₁₂ x) c₂ t (c₂ x) fun y => (hmem₁₂ x y).2)).trans
            (add_smul (c₁ x) (c₂ x) _).symm)
    exact hLHS.trans hRHS.symm
  have hlc_smul : ∀ (𝒢 : 𝒞) (Z : S.Etale) (r : R) (c : LocallyConstant ↥(Fgt.obj Z).left R)
      (t : ↑(𝒢.obj.obj (Opposite.op Z))),
      lcSmul 𝒢 Z (r • c) t = r • lcSmul 𝒢 Z c t := by
    intro 𝒢 Z r c t
    obtain ⟨s₀, -, hs₀_uniq⟩ := hArrows_sheaf_G 𝒢 Z (Y_lvl Z c) (π_lvl Z c) (hlvl_cov Z c)
      (fun x => (r • c x) • (𝒢.obj.map (Opposite.op (π_lvl Z c x))).hom t)
      (fun x₁ x₂ E_et g₁ g₂ hcomm => by
        by_cases hE : IsEmpty ↥(Fgt.obj E_et).left
        · have := hEmpty_sub_G 𝒢 E_et hE
          exact Subsingleton.elim _ _
        · obtain ⟨e₀⟩ := not_isEmpty_iff.mp hE
          have hm₁ : (W_open_lvl Z c x₁).ι.base (((Fgt.map g₁).left).base e₀) ∈
              (W_open_lvl Z c x₁ : Set ↥(Fgt.obj Z).left) := by
            rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
            exact ⟨((Fgt.map g₁).left).base e₀, rfl⟩
          have hm₂ : (W_open_lvl Z c x₂).ι.base (((Fgt.map g₂).left).base e₀) ∈
              (W_open_lvl Z c x₂ : Set ↥(Fgt.obj Z).left) := by
            rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
            exact ⟨((Fgt.map g₂).left).base e₀, rfl⟩
          have heq := congrArg (fun φ => c (((Fgt.map φ).left).base e₀)) hcomm
          have hcx : r • c x₁ = r • c x₂ := congrArg (r • ·) (hm₁.symm.trans (heq.trans hm₂))
          have hs₁ := ((𝒢.obj.map (Opposite.op g₁)).hom.map_smul (r • c x₁) _).trans
            (congrArg ((r • c x₁) • ·) (hMapComp 𝒢 g₁ (π_lvl Z c x₁) t).symm)
          have hs₂ := ((𝒢.obj.map (Opposite.op g₂)).hom.map_smul (r • c x₂) _).trans
            (congrArg ((r • c x₂) • ·) (hMapComp 𝒢 g₂ (π_lvl Z c x₂) t).symm)
          exact hs₁.trans
            ((congrArg₂ (fun r₀ φ => r₀ • (𝒢.obj.map (Opposite.op φ)).hom t) hcx hcomm).trans
              hs₂.symm))
    have hLHS : lcSmul 𝒢 Z (r • c) t = s₀ :=
      hs₀_uniq _ fun x => hlc_const 𝒢 (π_lvl Z c x) (r • c) t (r • c x) fun y => by
        have hm : (W_open_lvl Z c x).ι.base y ∈ (W_open_lvl Z c x : Set ↥(Fgt.obj Z).left) := by
          rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
          exact ⟨y, rfl⟩
        exact congrArg (r • ·) hm
    have hRHS : r • lcSmul 𝒢 Z c t = s₀ :=
      hs₀_uniq _ fun x =>
        ((𝒢.obj.map (Opposite.op (π_lvl Z c x))).hom.map_smul r _).trans
          ((congrArg (r • ·) (hlc_spec 𝒢 Z c t x)).trans
            (smul_smul r (c x) _))
    exact hLHS.trans hRHS.symm
  have hlc_sum : ∀ (𝒢 : 𝒞) (Z : S.Etale) (s_fin : Finset (Fin M))
      (r_fn : Fin M → R) (c_fn : Fin M → LocallyConstant ↥(Fgt.obj Z).left R)
      (t : ↑(𝒢.obj.obj (Opposite.op Z))),
      lcSmul 𝒢 Z (s_fin.sum (fun j => r_fn j • c_fn j)) t =
        s_fin.sum (fun j => r_fn j • lcSmul 𝒢 Z (c_fn j) t) := by
    intro 𝒢 Z s_fin r_fn c_fn t
    induction s_fin using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty, Finset.sum_empty, hlc_zero]
    | @insert a s_sub ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, hlc_add, hlc_smul, ih]

  
  let ψ_fun : ∀ (Z : S.Etale), LocallyConstant ↥(Fgt.obj Z).left R →
      ↑(oneR.obj.obj (Opposite.op Z)) :=
    fun Z f => lcSmul oneR Z f ((η_sh.app (Opposite.op Z)).hom (1 : R))
  have hψ_spec : ∀ (Z : S.Etale) (f : LocallyConstant ↥(Fgt.obj Z).left R)
      (x : ↥(Fgt.obj Z).left),
      (oneR.obj.map (Opposite.op (π_lvl Z f x))).hom (ψ_fun Z f) =
        (η_sh.app (Opposite.op (Y_lvl Z f x))).hom (f x) := by
    intro Z f x
    have hr1 : f x • (1 : R) = f x := mul_one (f x)
    exact (hlc_spec oneR Z f ((η_sh.app (Opposite.op Z)).hom (1 : R)) x).trans
      ((congrArg (f x • ·) (hη_map (π_lvl Z f x) (1 : R))).trans
        (((η_sh.app (Opposite.op (Y_lvl Z f x))).hom.map_smul (f x) (1 : R)).symm.trans
          (congrArg (η_sh.app (Opposite.op (Y_lvl Z f x))).hom hr1)))
  let Ψ_nat : Quiver.Hom L_pre oneR.obj :=
    { app := fun opZ => ModuleCat.ofHom
        { toFun := ψ_fun opZ.unop
          map_add' := fun f₁ f₂ => hlc_add oneR opZ.unop f₁ f₂ _
          map_smul' := fun r f => hlc_smul oneR opZ.unop r f _ }
      naturality := fun {opZ₂ opZ₁} u => by
        apply ModuleCat.hom_ext; apply LinearMap.ext; intro f
        change ψ_fun opZ₁.unop (f.comap ((Fgt.map u.unop).left).base.hom) =
          (oneR.obj.map u).hom (ψ_fun opZ₂.unop f)
        symm
        exact (hlc_map oneR u.unop f _).trans (congrArg _ (hη_map u.unop (1 : R))) }
  have hιΨ : CategoryTheory.CategoryStruct.comp ι_lc Ψ_nat = η_sh := by
    apply CategoryTheory.NatTrans.ext; funext opZ
    apply ModuleCat.hom_ext; apply LinearMap.ext; intro r
    let r₀ : R := r
    have hr1 : r₀ • (1 : R) = r₀ := mul_one r₀
    have hid := hlc_const oneR (CategoryTheory.CategoryStruct.id opZ.unop)
      (LocallyConstant.constₗ R r₀) ((η_sh.app (Opposite.op opZ.unop)).hom (1 : R)) r₀
      (fun _ => rfl)
    have hop : Opposite.op (CategoryTheory.CategoryStruct.id opZ.unop) =
        CategoryTheory.CategoryStruct.id opZ := rfl
    rw [hop, CategoryTheory.Functor.map_id] at hid
    exact hid.trans
      (((η_sh.app opZ).hom.map_smul r₀ (1 : R)).symm.trans
        (congrArg (η_sh.app opZ).hom hr1))
  let Ψ_lc : Quiver.Hom L_sh oneR := { hom := Ψ_nat }
  have hΦΨ : CategoryTheory.CategoryStruct.comp Φ_lc Ψ_lc =
      CategoryTheory.CategoryStruct.id oneR := by
    let oneR' : CategoryTheory.Sheaf J_top ModR :=
      (CategoryTheory.presheafToSheaf J_top ModR).obj P_const
    let α₁ : Quiver.Hom oneR' oneR := CategoryTheory.CategoryStruct.comp Φ_lc Ψ_lc
    let α₂ : Quiver.Hom oneR' oneR := CategoryTheory.CategoryStruct.id oneR
    change α₁ = α₂
    apply (adj_sh.homEquiv P_const oneR).injective
    have heq : CategoryTheory.CategoryStruct.comp η_sh α₁.hom =
        CategoryTheory.CategoryStruct.comp η_sh α₂.hom := by
      change η_sh ≫ (Φ_lc.hom ≫ Ψ_nat) = η_sh ≫ 𝟙 oneR.obj
      rw [← CategoryTheory.Category.assoc, hΦ_unit, hιΨ, CategoryTheory.Category.comp_id]
    exact (CategoryTheory.Adjunction.homEquiv_unit adj_sh P_const oneR α₁).trans
      (heq.trans (CategoryTheory.Adjunction.homEquiv_unit adj_sh P_const oneR α₂).symm)
  have hlc_oneR : ∀ (Z : S.Etale) (a : ↑(oneR.obj.obj (Opposite.op Z))),
      lcSmul oneR Z (ev_lc Z a) ((η_sh.app (Opposite.op Z)).hom (1 : R)) = a := by
    intro Z a
    exact congrArg (fun (θ : Quiver.Hom oneR oneR) => (θ.hom.app (Opposite.op Z)).hom a) hΦΨ
  have hev_bij : ∀ Z : S.Etale, Function.Bijective (ev_lc Z) := by
    intro Z
    refine ⟨fun a₁ a₂ ha => ?_, fun f => ⟨ψ_fun Z f, ?_⟩⟩
    · rw [← hlc_oneR Z a₁, ← hlc_oneR Z a₂, ha]
    · apply LocallyConstant.ext
      intro x
      have hx_mem : x ∈ Set.range (W_open_lvl Z f x).ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        exact rfl
      obtain ⟨y_x, hy_x⟩ := hx_mem
      have hy_x' : ((Fgt.map (π_lvl Z f x)).left).base y_x = x := hy_x
      calc
        ev_lc Z (ψ_fun Z f) x = ev_lc Z (ψ_fun Z f) (((Fgt.map (π_lvl Z f x)).left).base y_x) := by
          rw [hy_x']
        _ = ev_lc (Y_lvl Z f x) ((oneR.obj.map (Opposite.op (π_lvl Z f x))).hom (ψ_fun Z f)) y_x :=
          (h_res (π_lvl Z f x) (ψ_fun Z f) y_x).symm
        _ = ev_lc (Y_lvl Z f x) ((η_sh.app (Opposite.op (Y_lvl Z f x))).hom (f x)) y_x := by
          rw [hψ_spec Z f x]
        _ = f x := h_unit (Y_lvl Z f x) (f x) y_x

  
  have hAlgDomainAway :
      ∀ (R_x : Type u) [CommRing R_x]
        (g_mv : MvPolynomial (Fin 1) k →+* R_x) (_ : g_mv.Etale)
        (B₁ : Type u) [CommRing B₁]
        (φ₁ : R_x →+* B₁) (_ : φ₁.Etale)
        (q₀ : Ideal B₁) [q₀.IsPrime],
        ∃ g_sep : B₁, g_sep ∉ q₀ ∧
          ∀ (D : Type u) [CommRing D] [Algebra B₁ D] [IsLocalization.Away g_sep D],
            IsDomain D := by
    intro R_x _ g_mv hg_mv B₁ _ φ₁ hφ₁ q₀ _
    let A₀ := Polynomial k
    let e_mv : MvPolynomial (Fin 1) k ≃+* A₀ :=
      ((MvPolynomial.finSuccEquiv k 0).trans
        (Polynomial.mapAlgEquiv (MvPolynomial.isEmptyAlgEquiv k (Fin 0)))).toRingEquiv
    let g₀ : A₀ →+* R_x := g_mv.comp e_mv.symm.toRingHom
    have hg₀_et : g₀.Etale := RingHom.Etale.respectsIso.right g_mv e_mv.symm hg_mv
    let _ : Algebra A₀ R_x := g₀.toAlgebra
    have : Algebra.Etale A₀ R_x := RingHom.etale_algebraMap.mp hg₀_et
    let _ : Algebra R_x B₁ := φ₁.toAlgebra
    have : Algebra.Etale R_x B₁ := RingHom.etale_algebraMap.mp hφ₁
    let ψ_AB : A₀ →+* B₁ := φ₁.comp g₀
    let _ : Algebra A₀ B₁ := ψ_AB.toAlgebra
    have : IsScalarTower A₀ R_x B₁ := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.Etale A₀ B₁ := Algebra.Etale.comp A₀ R_x B₁
    have hLocalUnitOfProd :
        ∀ {L_loc E : Type u} [CommRing L_loc] [IsLocalRing L_loc] [CommRing E]
          {I : Type u} {F_i : I → Type u} [∀ i, Field (F_i i)]
          (e_pi : E ≃+* ((i : I) → F_i i))
          (α : E →+* L_loc),
          (∀ x : L_loc, ∃ (z : E) (u : L_loc), IsUnit u ∧ x = α z * u) →
          ∀ x : L_loc, x ≠ 0 → IsUnit x := by
      intro L_loc E _ _ _ I F_i _ e_pi α hSurjU x hx_ne
      obtain ⟨z, u, hu, rfl⟩ := hSurjU x
      let w_pi : (i : I) → F_i i := fun i => (e_pi z i)⁻¹
      let w_el : E := e_pi.symm w_pi
      have hzzw : z * z * w_el = z := by
        apply e_pi.injective
        ext i
        rw [map_mul, map_mul, e_pi.apply_symm_apply]
        simp only [Pi.mul_apply]
        dsimp [w_pi]
        by_cases h0 : e_pi z i = 0
        · simp [h0]
        · rw [mul_assoc, mul_inv_cancel₀ h0, mul_one]
      let ε : L_loc := α (z * w_el)
      have hz_ε : α z * ε = α z := by
        dsimp [ε]
        rw [← map_mul, ← mul_assoc, hzzw]
      have hε_idem : ε * (1 - ε) = 0 := by
        have hε_sq : ε * ε = ε := by
          dsimp [ε]
          rw [← map_mul]
          have h1 : (z * w_el) * (z * w_el) = (z * z * w_el) * w_el := by ring
          rw [h1, hzzw]
        rw [mul_sub, mul_one, hε_sq, sub_self]
      have hUnit_or : IsUnit ε ∨ IsUnit (1 - ε) := by
        by_contra hnot
        have hm1 : ε ∈ IsLocalRing.maximalIdeal L_loc := by
          by_contra h1
          exact hnot (Or.inl (IsLocalRing.notMem_maximalIdeal.mp h1))
        have hm2 : 1 - ε ∈ IsLocalRing.maximalIdeal L_loc := by
          by_contra h2
          exact hnot (Or.inr (IsLocalRing.notMem_maximalIdeal.mp h2))
        have h1_mem : (1 : L_loc) ∈ IsLocalRing.maximalIdeal L_loc := by
          have hsum := Ideal.add_mem (IsLocalRing.maximalIdeal L_loc) hm1 hm2
          rwa [add_sub_cancel] at hsum
        exact (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one) h1_mem
      rcases hUnit_or with hUε | hU1
      · have hUε' : IsUnit (α z * α w_el) := by
          dsimp [ε] at hUε
          rwa [map_mul] at hUε
        exact (isUnit_of_mul_isUnit_left hUε').mul hu
      · exfalso
        obtain ⟨v₁, hv₁⟩ := isUnit_iff_exists_inv.mp hU1
        have hε0 : ε = 0 := by
          calc
            ε = ε * ((1 - ε) * v₁) := by rw [hv₁, mul_one]
            _ = (ε * (1 - ε)) * v₁ := (mul_assoc _ _ _).symm
            _ = 0 := by rw [hε_idem, zero_mul]
        have hz0 : α z = 0 := by rw [← hz_ε, hε0, mul_zero]
        exact hx_ne (by rw [hz0, zero_mul])
    have : Algebra.FinitePresentation A₀ B₁ := Algebra.Etale.finitePresentation
    have : Algebra.FiniteType A₀ B₁ := inferInstance
    have : IsNoetherianRing B₁ := Algebra.FiniteType.isNoetherianRing A₀ B₁
    have : Algebra.Smooth A₀ B₁ := inferInstance
    have : Module.Flat A₀ B₁ := inferInstance
    have : Module.IsTorsionFree A₀ B₁ := Module.Flat.isTorsionFree
    have hReg_A₀ : ∀ {a : A₀} {b : B₁}, a ≠ 0 → algebraMap A₀ B₁ a * b = 0 → b = 0 := by
      intro a b ha h0
      have hsm : a • b = 0 := by rwa [Algebra.smul_def]
      exact (smul_eq_zero.mp hsm).resolve_left ha
    let K₀ := FractionRing A₀
    let M_sub : Submonoid B₁ := Algebra.algebraMapSubmonoid B₁ (nonZeroDivisors A₀)
    let B' := TensorProduct A₀ B₁ K₀
    let B_tens := TensorProduct A₀ K₀ B₁
    have : IsLocalization M_sub B' := IsLocalization.tensor K₀ (nonZeroDivisors A₀)
    have hM_sub : M_sub ≤ nonZeroDivisors B₁ := by
      rintro _ ⟨a, ha, rfl⟩
      exact mem_nonZeroDivisors_iff.mpr
        ⟨fun x hx => hReg_A₀ (nonZeroDivisors.ne_zero ha) hx,
         fun x hx => hReg_A₀ (nonZeroDivisors.ne_zero ha) (by rw [mul_comm]; exact hx)⟩
    have hInj_B' : Function.Injective (algebraMap B₁ B') := IsLocalization.injective B' hM_sub
    let e_comm : B_tens ≃ₐ[A₀] B' := Algebra.TensorProduct.comm A₀ K₀ B₁
    have : Algebra.Etale K₀ B_tens := Algebra.Etale.baseChange A₀ B₁ K₀
    obtain ⟨I_K, _, Ai_K, hFieldAi_K, _, e_prod_K, _⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K₀ B_tens).mp inferInstance
    let _ : ∀ i : I_K, Field (Ai_K i) := hFieldAi_K
    have hRed : ∀ (b : B₁) (n : ℕ), b ^ n = 0 → b = 0 := by
      intro b n hbn
      apply hInj_B'; apply e_comm.symm.injective; apply e_prod_K.injective; ext i
      have h1 : (e_prod_K (e_comm.symm (algebraMap B₁ B' b)) i) ^ n = 0 := by
        change ((e_prod_K (e_comm.symm (algebraMap B₁ B' b))) ^ n) i = 0
        rw [← map_pow, ← map_pow, ← map_pow, hbn, map_zero, map_zero, map_zero]
        rfl
      rw [map_zero, map_zero, map_zero]
      exact eq_zero_of_pow_eq_zero h1
    have hDom_loc : ∀ (q : Ideal B₁) [q.IsPrime], IsDomain (Localization.AtPrime q) := by
      intro q hq
      let S_q := Localization.AtPrime q
      let p : Ideal A₀ := Ideal.comap (algebraMap A₀ B₁) q
      have hp : p.IsPrime := hq.comap (algebraMap A₀ B₁)
      by_cases hp_bot : p = ⊥
      · have hUnits_K : ∀ y : ↥(nonZeroDivisors A₀), IsUnit (algebraMap A₀ S_q y.1) := by
          intro y
          have hy_ne : y.1 ≠ 0 := nonZeroDivisors.ne_zero y.2
          have hy_not_q : algebraMap A₀ B₁ y.1 ∉ q := by
            intro hmem
            have hyp : y.1 ∈ p := hmem
            rw [hp_bot, Ideal.mem_bot] at hyp
            exact hy_ne hyp
          rw [IsScalarTower.algebraMap_apply A₀ B₁ S_q y.1]
          exact IsLocalization.map_units S_q (⟨algebraMap A₀ B₁ y.1, hy_not_q⟩ : q.primeCompl)
        let ρ_K_ring : K₀ →+* S_q := IsLocalization.lift hUnits_K
        let ρ_K_alg : K₀ →ₐ[A₀] S_q :=
          { toRingHom := ρ_K_ring
            commutes' := fun a => IsLocalization.lift_eq hUnits_K a }
        let g_B₁_alg : B₁ →ₐ[A₀] S_q := IsScalarTower.toAlgHom A₀ B₁ S_q
        let α_K_alg : B_tens →ₐ[A₀] S_q :=
          Algebra.TensorProduct.lift ρ_K_alg g_B₁_alg (fun _ _ => Commute.all _ _)
        let α_K : B_tens →+* S_q := α_K_alg.toRingHom
        have hSurj_K : ∀ x : S_q, ∃ (z : B_tens) (u : S_q), IsUnit u ∧ x = α_K z * u := by
          intro x
          obtain ⟨⟨b, s⟩, hx_s⟩ := IsLocalization.surj q.primeCompl x
          have hus : IsUnit (algebraMap B₁ S_q s.1) := IsLocalization.map_units S_q s
          obtain ⟨v_s, hv_s⟩ := isUnit_iff_exists_inv.mp hus
          have hv_unit : IsUnit v_s := isUnit_of_mul_isUnit_right (hv_s ▸ isUnit_one)
          refine ⟨(1 : K₀) ⊗ₜ[A₀] b, v_s, hv_unit, ?_⟩
          have hα_b : α_K ((1 : K₀) ⊗ₜ[A₀] b) = algebraMap B₁ S_q b := by
            dsimp [α_K, α_K_alg]
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
            rfl
          have hx_s' : x * algebraMap B₁ S_q s.1 = algebraMap B₁ S_q b := hx_s
          rw [hα_b, ← hx_s', mul_assoc, hv_s, mul_one]
        have hUnit_Sq : ∀ x : S_q, x ≠ 0 → IsUnit x :=
          hLocalUnitOfProd e_prod_K.toRingEquiv α_K hSurj_K
        have : NoZeroDivisors S_q := ⟨fun {x y} hxy => by
          by_cases hx : x = 0
          · exact Or.inl hx
          · obtain ⟨v, hv⟩ := isUnit_iff_exists_inv'.mp (hUnit_Sq x hx)
            right
            calc
              y = (v * x) * y := by rw [hv, one_mul]
              _ = v * (x * y) := mul_assoc _ _ _
              _ = 0 := by rw [hxy, mul_zero]⟩
        exact NoZeroDivisors.to_isDomain S_q
      · let π₀ : A₀ := Submodule.IsPrincipal.generator p
        have hp_span : Ideal.span {π₀} = p := Submodule.IsPrincipal.span_singleton_generator p
        have hπ₀_ne : π₀ ≠ 0 := fun h0 =>
          hp_bot (by rw [← hp_span, h0, Ideal.span_singleton_eq_bot])
        have hp_max : p.IsMaximal := IsPrime.to_maximal_ideal hp_bot
        let F_p := A₀ ⧸ p
        let _ : Field F_p := Ideal.Quotient.field p
        let π_el : S_q := algebraMap B₁ S_q (algebraMap A₀ B₁ π₀)
        have hπ_reg : ∀ x : S_q, π_el * x = 0 → x = 0 := by
          intro x hπx
          obtain ⟨⟨b, s⟩, hx_s⟩ := IsLocalization.surj q.primeCompl x
          have hx_s' : x * algebraMap B₁ S_q s.1 = algebraMap B₁ S_q b := hx_s
          have hmap0 : algebraMap B₁ S_q (algebraMap A₀ B₁ π₀ * b) = 0 := by
            rw [map_mul, ← hx_s']
            calc
              π_el * (x * algebraMap B₁ S_q s.1) = (π_el * x) * algebraMap B₁ S_q s.1 :=
                (mul_assoc _ _ _).symm
              _ = 0 := by rw [hπx, zero_mul]
          obtain ⟨t, ht⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl S_q _).mp hmap0
          have htb0 : t.1 * b = 0 := by
            apply hReg_A₀ hπ₀_ne
            calc
              algebraMap A₀ B₁ π₀ * (t.1 * b) = t.1 * (algebraMap A₀ B₁ π₀ * b) := by ring
              _ = 0 := ht
          have hb0 : algebraMap B₁ S_q b = 0 := by
            have h1 : algebraMap B₁ S_q t.1 * algebraMap B₁ S_q b = 0 := by
              rw [← map_mul (algebraMap B₁ S_q), htb0, map_zero]
            exact (IsLocalization.map_units S_q t).mul_right_eq_zero.mp h1
          rw [hb0] at hx_s'
          exact (IsLocalization.map_units S_q s).mul_left_eq_zero.mp hx_s'
        have hπ_mem_m : π_el ∈ IsLocalRing.maximalIdeal S_q := by
          have hπ₀_p : π₀ ∈ p := hp_span ▸ Ideal.subset_span (Set.mem_singleton π₀)
          rw [← IsLocalization.AtPrime.map_eq_maximalIdeal q S_q]
          exact Ideal.mem_map_of_mem _ hπ₀_p
        let I_π : Ideal S_q := Ideal.span {π_el}
        have hI_le_m : I_π ≤ IsLocalRing.maximalIdeal S_q :=
          Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπ_mem_m)
        have hI_ne_top : I_π ≠ ⊤ := fun htop =>
          (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one)
            (hI_le_m (htop ▸ Submodule.mem_top))
        let S_bar := S_q ⧸ I_π
        let mk_bar : S_q →+* S_bar := Ideal.Quotient.mk I_π
        let _ : Nontrivial S_bar :=
          ⟨⟨0, 1, fun h01 =>
            hI_ne_top ((Ideal.eq_top_iff_one _).mpr
              (Ideal.Quotient.eq_zero_iff_mem.mp h01.symm))⟩⟩
        have hBar_nonunit :
            ∀ z : S_q, z ∈ IsLocalRing.maximalIdeal S_q → mk_bar z ∈ nonunits S_bar := by
          intro z hz
          rw [mem_nonunits_iff]
          intro hu
          obtain ⟨c_bar, hc_bar⟩ := isUnit_iff_exists_inv.mp hu
          obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective c_bar
          have h1_sub : 1 - z * c ∈ I_π :=
            Ideal.Quotient.eq_zero_iff_mem.mp
              (by change mk_bar (1 - z * c) = 0; rw [map_sub, map_one, map_mul, hc_bar, sub_self])
          have h1_m : (1 : S_q) ∈ IsLocalRing.maximalIdeal S_q := by
            have hsum := Ideal.add_mem _ (hI_le_m h1_sub)
              (Ideal.mul_mem_right c (IsLocalRing.maximalIdeal S_q) hz)
            rwa [sub_add_cancel] at hsum
          exact (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one) h1_m
        have hLift_m : ∀ z : S_q, mk_bar z ∈ nonunits S_bar → z ∈ IsLocalRing.maximalIdeal S_q := by
          intro z hz
          by_contra hnot
          exact mem_nonunits_iff.mp hz ((IsLocalRing.notMem_maximalIdeal.mp hnot).map mk_bar)
        let _ : IsLocalRing S_bar := IsLocalRing.of_nonunits_add (fun a_b b_b ha hb => by
          obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a_b
          obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b_b
          change mk_bar a + mk_bar b ∈ nonunits S_bar
          rw [← map_add]
          exact hBar_nonunit (a + b) (Ideal.add_mem _ (hLift_m a ha) (hLift_m b hb)))
        let g_bar_A₀ : A₀ →+* S_bar := algebraMap A₀ S_bar
        have hker_p : p ≤ RingHom.ker g_bar_A₀ := by
          intro a ha
          rw [← hp_span] at ha
          obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp ha
          rw [RingHom.mem_ker]
          have hmap_eq : g_bar_A₀ (π₀ * c) =
              mk_bar (algebraMap B₁ S_q (algebraMap A₀ B₁ (π₀ * c))) := by
            change algebraMap A₀ S_bar (π₀ * c) = _
            rw [IsScalarTower.algebraMap_apply A₀ S_q S_bar,
              IsScalarTower.algebraMap_apply A₀ B₁ S_q]
            rfl
          rw [hmap_eq, map_mul, map_mul, map_mul]
          have h0 : mk_bar π_el = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton π_el))
          rw [h0, zero_mul]
        let ρ_p_ring : F_p →+* S_bar := Ideal.Quotient.lift p g_bar_A₀ (fun a ha => hker_p ha)
        let ρ_p_alg : F_p →ₐ[A₀] S_bar :=
          { toRingHom := ρ_p_ring
            commutes' := fun _ => rfl }
        let g_B₁_bar : B₁ →ₐ[A₀] S_bar :=
          (IsScalarTower.toAlgHom A₀ S_q S_bar).comp (IsScalarTower.toAlgHom A₀ B₁ S_q)
        let B_p := TensorProduct A₀ F_p B₁
        let α_p_alg : B_p →ₐ[A₀] S_bar :=
          Algebra.TensorProduct.lift ρ_p_alg g_B₁_bar (fun _ _ => Commute.all _ _)
        let α_p : B_p →+* S_bar := α_p_alg.toRingHom
        have : Algebra.Etale F_p B_p := Algebra.Etale.baseChange A₀ B₁ F_p
        obtain ⟨I_p, _, Ai_p, hFieldAi_p, _, e_prod_p, _⟩ :=
          (Algebra.Etale.iff_exists_algEquiv_prod F_p B_p).mp inferInstance
        let _ : ∀ i : I_p, Field (Ai_p i) := hFieldAi_p
        have hSurj_p : ∀ x_b : S_bar, ∃ (z : B_p) (u : S_bar), IsUnit u ∧ x_b = α_p z * u := by
          intro x_b
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x_b
          obtain ⟨⟨b, s⟩, hx_s⟩ := IsLocalization.surj q.primeCompl x
          have hx_s' : x * algebraMap B₁ S_q s.1 = algebraMap B₁ S_q b := hx_s
          have hus : IsUnit (algebraMap B₁ S_q s.1) := IsLocalization.map_units S_q s
          obtain ⟨v_s, hv_s⟩ := isUnit_iff_exists_inv.mp hus
          have hv_unit : IsUnit (mk_bar v_s) :=
            (isUnit_of_mul_isUnit_right (hv_s ▸ isUnit_one)).map mk_bar
          refine ⟨(1 : F_p) ⊗ₜ[A₀] b, mk_bar v_s, hv_unit, ?_⟩
          have hα_b : α_p ((1 : F_p) ⊗ₜ[A₀] b) = mk_bar (algebraMap B₁ S_q b) := by
            dsimp [α_p, α_p_alg]
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
            rfl
          change mk_bar x = α_p ((1 : F_p) ⊗ₜ[A₀] b) * mk_bar v_s
          rw [hα_b, ← map_mul, ← hx_s', mul_assoc, hv_s, mul_one]
        have hUnit_bar : ∀ x_b : S_bar, x_b ≠ 0 → IsUnit x_b :=
          hLocalUnitOfProd e_prod_p.toRingEquiv α_p hSurj_p
        have hm_eq_span : IsLocalRing.maximalIdeal S_q = I_π := by
          apply le_antisymm _ hI_le_m
          intro m_x hm_x
          by_contra hnot_I
          have hne0 : mk_bar m_x ≠ 0 := fun h0 => hnot_I (Ideal.Quotient.eq_zero_iff_mem.mp h0)
          exact mem_nonunits_iff.mp (hBar_nonunit m_x hm_x) (hUnit_bar (mk_bar m_x) hne0)
        have : IsNoetherianRing S_q := IsLocalization.isNoetherianRing q.primeCompl S_q inferInstance
        have hm_ne_top : IsLocalRing.maximalIdeal S_q ≠ ⊤ := fun htop =>
          (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one) (htop ▸ Submodule.mem_top)
        have hiInf : (⨅ n : ℕ, (IsLocalRing.maximalIdeal S_q) ^ n) = ⊥ :=
          Ideal.iInf_pow_eq_bot_of_isLocalRing _ hm_ne_top
        have hFactor : ∀ x : S_q, x ≠ 0 → ∃ (r : ℕ) (u : S_q), IsUnit u ∧ x = π_el ^ r * u := by
          intro x hx
          have hnot_all : ¬ ∀ n : ℕ, x ∈ I_π ^ n := by
            intro hall
            apply hx
            rw [← Ideal.mem_bot, ← hiInf, Ideal.mem_iInf]
            intro n
            rw [hm_eq_span]
            exact hall n
          have hex_n : ∃ n : ℕ, x ∉ I_π ^ n := not_forall.mp hnot_all
          let N : ℕ := Nat.find hex_n
          have hN_spec : x ∉ I_π ^ N := Nat.find_spec hex_n
          have hN_pos : 0 < N := by
            by_contra hle
            have h0 : N = 0 := Nat.eq_zero_of_not_pos hle
            exact hN_spec (by rw [h0, pow_zero, Ideal.one_eq_top]; trivial)
          let r : ℕ := N - 1
          have hr1 : r + 1 = N := Nat.sub_add_cancel hN_pos
          have hx_r : x ∈ I_π ^ r := by
            by_contra hnot_r
            exact Nat.find_min hex_n (by omega : r < N) hnot_r
          rw [Ideal.span_singleton_pow] at hx_r
          obtain ⟨u, hu_eq⟩ := Ideal.mem_span_singleton.mp hx_r
          have hu_unit : IsUnit u := by
            apply IsLocalRing.notMem_maximalIdeal.mp
            rw [hm_eq_span]
            intro hu_I
            obtain ⟨v, rfl⟩ := Ideal.mem_span_singleton.mp hu_I
            apply hN_spec
            rw [← hr1, Ideal.span_singleton_pow]
            refine Ideal.mem_span_singleton.mpr ⟨v, ?_⟩
            rw [hu_eq, pow_succ]
            ring
          exact ⟨r, u, hu_unit, hu_eq⟩
        have hPow_reg : ∀ (k_pow : ℕ) (w_el : S_q), w_el ≠ 0 → π_el ^ k_pow * w_el ≠ 0 := by
          intro k_pow
          induction k_pow with
          | zero => intro w_el hw; rwa [pow_zero, one_mul]
          | succ k_pow ih =>
            intro w_el hw h0
            rw [pow_succ', mul_assoc] at h0
            exact ih w_el hw (hπ_reg _ h0)
        have : NoZeroDivisors S_q := ⟨fun {x y} hxy => by
          by_cases hx : x = 0
          · exact Or.inl hx
          · by_cases hy : y = 0
            · exact Or.inr hy
            · exfalso
              obtain ⟨r, u, hu, rfl⟩ := hFactor x hx
              obtain ⟨s, v, hv, rfl⟩ := hFactor y hy
              have huv_ne : u * v ≠ 0 := (hu.mul hv).ne_zero
              have hxy' : π_el ^ (r + s) * (u * v) = 0 := by
                calc
                  π_el ^ (r + s) * (u * v) = (π_el ^ r * u) * (π_el ^ s * v) := by rw [pow_add]; ring
                  _ = 0 := hxy
              exact hPow_reg (r + s) (u * v) huv_ne hxy'⟩
        exact NoZeroDivisors.to_isDomain S_q
    let P_min : ∀ (q : Ideal B₁) [q.IsPrime], Ideal B₁ :=
      fun q _ => RingHom.ker (algebraMap B₁ (Localization.AtPrime q))
    have hPmin_prime : ∀ (q : Ideal B₁) [q.IsPrime], (P_min q).IsPrime := by
      intro q _
      have : IsDomain (Localization.AtPrime q) := hDom_loc q
      exact RingHom.ker_isPrime _
    have hPmin_le : ∀ (q : Ideal B₁) [q.IsPrime] (p' : Ideal B₁),
        p'.IsPrime → p' ≤ q → P_min q ≤ p' := by
      intro q _ p' hp' hp'_le b hb
      obtain ⟨s, hs⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl _ b).mp hb
      have hmul : s.1 * b ∈ p' := hs ▸ p'.zero_mem
      exact (hp'.mem_or_mem hmul).resolve_left (fun hs_p' => s.2 (hp'_le hs_p'))
    have hPmin_mem : ∀ (q : Ideal B₁) [hq : q.IsPrime], P_min q ∈ minimalPrimes B₁ := by
      intro q hq
      rw [minimalPrimes_eq_minimals]
      exact ⟨hPmin_prime q, fun p' hp' hp'_le =>
        hPmin_le q p' hp' (le_trans hp'_le (hPmin_le q q hq le_rfl))⟩
    have hPmin_uniq : ∀ (q : Ideal B₁) [q.IsPrime] (p : Ideal B₁),
        p ∈ minimalPrimes B₁ → p ≤ q → p = P_min q := by
      intro q _ p hp hp_le
      rw [minimalPrimes_eq_minimals] at hp
      have hle : P_min q ≤ p := hPmin_le q p hp.1 hp_le
      exact le_antisymm (hp.2 (hPmin_prime q) hle) hle
    let p₀ : Ideal B₁ := P_min q₀
    have hp₀_prime : p₀.IsPrime := hPmin_prime q₀
    have hp₀_le_q₀ : p₀ ≤ q₀ := hPmin_le q₀ q₀ inferInstance le_rfl
    have hFin_other : (minimalPrimes B₁ \ {p₀}).Finite :=
      (minimalPrimes.finite_of_isNoetherianRing B₁).sdiff
    let F_fin : Finset (Ideal B₁) := hFin_other.toFinset
    have hex_g : ∀ p : Ideal B₁, p ∈ F_fin → ∃ g : B₁, g ∈ p ∧ g ∉ q₀ := by
      intro p hpF
      have hp_mem : p ∈ minimalPrimes B₁ ∧ p ≠ p₀ := by
        simpa [F_fin, Set.mem_sdiff, Set.mem_singleton_iff] using hpF
      have hnot_le : ¬ (p ≤ q₀) := fun hle => hp_mem.2 (hPmin_uniq q₀ p hp_mem.1 hle)
      exact Set.not_subset.mp hnot_le
    let g_fn : { p : Ideal B₁ // p ∈ F_fin } → B₁ := fun p => (hex_g p.1 p.2).choose
    have hg_fn : ∀ p : { p : Ideal B₁ // p ∈ F_fin }, g_fn p ∈ p.1 ∧ g_fn p ∉ q₀ :=
      fun p => (hex_g p.1 p.2).choose_spec
    let g_sep : B₁ := ∏ p ∈ F_fin.attach, g_fn p
    have hg_sep_not_q₀ : g_sep ∉ q₀ :=
      q₀.primeCompl.prod_mem (fun p _ => (hg_fn p).2)
    have hg_sep_not_p₀ : g_sep ∉ p₀ := fun h => hg_sep_not_q₀ (hp₀_le_q₀ h)
    have h_ann : ∀ b : B₁, b ∈ p₀ ↔ g_sep * b = 0 := by
      intro b
      constructor
      · intro hb
        have hmem_nil : g_sep * b ∈ nilradical B₁ := by
          rw [nilradical_eq_sInf, Ideal.mem_sInf]
          intro q hq
          have : q.IsPrime := hq
          by_cases h_eq : P_min q = p₀
          · have hbq : b ∈ q := hPmin_le q q hq le_rfl (h_eq.symm ▸ hb)
            exact q.mul_mem_left g_sep hbq
          · have hmemF : P_min q ∈ F_fin := by
              rw [Set.Finite.mem_toFinset]
              exact ⟨hPmin_mem q, h_eq⟩
            let pt_F : { p : Ideal B₁ // p ∈ F_fin } := ⟨P_min q, hmemF⟩
            obtain ⟨c_d, hc_d⟩ := Finset.dvd_prod_of_mem g_fn (Finset.mem_attach F_fin pt_F)
            have hgf_q : g_fn pt_F ∈ q := hPmin_le q q hq le_rfl (hg_fn pt_F).1
            dsimp [g_sep]
            rw [hc_d, mul_assoc]
            exact q.mul_mem_right _ hgf_q
        obtain ⟨n, hn⟩ := mem_nilradical.mp hmem_nil
        exact hRed (g_sep * b) n hn
      · intro h0
        have hmem : g_sep * b ∈ p₀ := h0 ▸ p₀.zero_mem
        exact (hp₀_prime.mem_or_mem hmem).resolve_left hg_sep_not_p₀
    refine ⟨g_sep, hg_sep_not_q₀, ?_⟩
    intro D _ _ _
    let M_pow : Submonoid B₁ := Submonoid.powers g_sep
    let ι : B₁ →+* D := algebraMap B₁ D
    have hker_ι : RingHom.ker ι = p₀ := by
      ext b
      rw [RingHom.mem_ker, IsLocalization.map_eq_zero_iff M_pow D b]
      constructor
      · rintro ⟨⟨_, ⟨k_p, rfl⟩⟩, hk⟩
        have hmem : g_sep ^ k_p * b ∈ p₀ := hk ▸ p₀.zero_mem
        exact (hp₀_prime.mem_or_mem hmem).resolve_left (p₀.primeCompl.pow_mem hg_sep_not_p₀ k_p)
      · intro hb
        exact ⟨⟨g_sep, Submonoid.mem_powers g_sep⟩, (h_ann b).mp hb⟩
    have : Nontrivial D := ⟨⟨0, 1, fun h01 => by
      have h1_ker : (1 : B₁) ∈ RingHom.ker ι := by
        rw [RingHom.mem_ker, map_one]
        exact h01.symm
      rw [hker_ι] at h1_ker
      exact hp₀_prime.ne_top ((Ideal.eq_top_iff_one p₀).mpr h1_ker)⟩⟩
    have : NoZeroDivisors D := ⟨fun {z₁ z₂} hz => by
      obtain ⟨⟨b₁, s₁⟩, hb₁⟩ := IsLocalization.surj M_pow z₁
      obtain ⟨⟨b₂, s₂⟩, hb₂⟩ := IsLocalization.surj M_pow z₂
      have hb12 : ι (b₁ * b₂) = 0 := by
        rw [map_mul, ← hb₁, ← hb₂]
        calc
          (z₁ * ι s₁.1) * (z₂ * ι s₂.1) = (z₁ * z₂) * (ι s₁.1 * ι s₂.1) := by ring
          _ = 0 := by rw [hz, zero_mul]
      have hmem_p₀ : b₁ * b₂ ∈ p₀ := by
        rw [← hker_ι, RingHom.mem_ker]
        exact hb12
      rcases hp₀_prime.mem_or_mem hmem_p₀ with h1 | h2
      · left
        have hι1 : ι b₁ = 0 := by rw [← RingHom.mem_ker, hker_ι]; exact h1
        rw [hι1] at hb₁
        exact (IsLocalization.map_units D s₁).mul_left_eq_zero.mp hb₁
      · right
        have hι2 : ι b₂ = 0 := by rw [← RingHom.mem_ker, hker_ι]; exact h2
        rw [hι2] at hb₂
        exact (IsLocalization.map_units D s₂).mul_left_eq_zero.mp hb₂⟩
    exact NoZeroDivisors.to_isDomain D

  have hUnit_bij : ∀ W : S.Etale,
      Function.Bijective ((oneR.obj.map (Opposite.op (inc_WU W))).hom) := by
    intro W
    let h_W := (Fgt.obj W).hom
    let W_U := open_WU W
    have : AlgebraicGeometry.IsIntegral S := hInt
    have : IrreducibleSpace ↥S := AlgebraicGeometry.irreducibleSpace_of_isIntegral S
    have : AlgebraicGeometry.Etale h_W := W.prop
    obtain ⟨u₀_pt, hu₀_pt⟩ := hU_ne
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    have hIrredNbhd : ∀ y : ↥(Fgt.obj W).left,
        ∃ (V_y : ((Fgt.obj W).left).Opens) (u_y : ↥W_U.toScheme),
          y ∈ V_y ∧
          IsPreirreducible (V_y : Set ↥(Fgt.obj W).left) ∧
          W_U.ι.base u_y ∈ V_y := by
      intro y
      let x := h_W.base y
      obtain ⟨U_bx, _, U_x, hAff_x, hx_Ux, e_sub_x, hStd_x⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 X.hom).mp inferInstance x
      have hU_bx_top : U_bx = ⊤ := by
        ext p
        exact ⟨fun _ => trivial, fun _ => Subsingleton.elim (X.hom.base x) p ▸ e_sub_x hx_Ux⟩
      let e_Ux : k ≃+* ↑(S_k.presheaf.obj (Opposite.op U_bx)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.trans
          (S_k.presheaf.mapIso
            (CategoryTheory.eqToIso (congrArg Opposite.op hU_bx_top.symm)))).commRingCatIsoToRingEquiv
      obtain ⟨g_Ux, _, hg_Ux⟩ :=
        RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hStd_x
      let R_x := ↑(S.presheaf.obj (Opposite.op U_x))
      let e_poly_x := MvPolynomial.mapEquiv (Fin 1) e_Ux
      let g_mv : MvPolynomial (Fin 1) k →+* R_x := g_Ux.comp e_poly_x.toRingHom
      have hg_mv : g_mv.Etale := RingHom.Etale.respectsIso.right g_Ux e_poly_x hg_Ux
      have hy_pre : y ∈ (TopologicalSpace.Opens.map h_W.base).obj U_x := hx_Ux
      obtain ⟨V₁, hAff_1, hy_V₁, hV₁_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hy_pre
      let B₁ := ↑(((Fgt.obj W).left).presheaf.obj (Opposite.op V₁))
      let φ₁ : R_x →+* B₁ := (h_W.appLE U_x V₁ hV₁_sub).hom
      have hφ₁ : φ₁.Etale :=
        AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale) h_W W.prop
          ⟨U_x, hAff_x⟩ ⟨V₁, hAff_1⟩ hV₁_sub
      let q₀ : Ideal B₁ := (hAff_1.primeIdealOf ⟨y, hy_V₁⟩).asIdeal
      obtain ⟨g_sep, hg_sep, hAway_g⟩ := hAlgDomainAway R_x g_mv hg_mv B₁ φ₁ hφ₁ q₀
      let V_y : ((Fgt.obj W).left).Opens := ((Fgt.obj W).left).basicOpen g_sep
      have hAff_y : AlgebraicGeometry.IsAffineOpen V_y := hAff_1.basicOpen g_sep
      have hy_Vy : y ∈ V_y := by
        rw [AlgebraicGeometry.Scheme.mem_basicOpen ((Fgt.obj W).left) g_sep y hy_V₁]
        apply IsLocalRing.notMem_maximalIdeal.mp
        have hq₀_eq : q₀ = Ideal.comap (((Fgt.obj W).left).presheaf.germ V₁ y hy_V₁).hom
            (IsLocalRing.maximalIdeal ↑(((Fgt.obj W).left).presheaf.stalk y)) :=
          congrArg PrimeSpectrum.asIdeal (hAff_1.primeIdealOf_eq_map_closedPoint ⟨y, hy_V₁⟩)
        intro hmem
        exact hg_sep (hq₀_eq ▸ hmem)
      let D_y := ↑(((Fgt.obj W).left).presheaf.obj (Opposite.op V_y))
      let _ : Algebra B₁ D_y :=
        (((Fgt.obj W).left).presheaf.map
          (CategoryTheory.homOfLE (((Fgt.obj W).left).basicOpen_le g_sep)).op).hom.toAlgebra
      have : IsLocalization.Away g_sep D_y := hAff_1.isLocalization_basicOpen g_sep
      have : IsDomain D_y := hAway_g D_y
      have : IrreducibleSpace ↥(AlgebraicGeometry.Spec
          (((Fgt.obj W).left).presheaf.obj (Opposite.op V_y))) :=
        @PrimeSpectrum.irreducibleSpace D_y _ _
      have hIrred_Vy : IsIrreducible (V_y : Set ↥(Fgt.obj W).left) := by
        have hImg : hAff_y.fromSpec.base '' Set.univ = (V_y : Set ↥(Fgt.obj W).left) := by
          rw [Set.image_univ, hAff_y.range_fromSpec]
        rw [← hImg]
        exact (IrreducibleSpace.isIrreducible_univ _).image hAff_y.fromSpec.base
          hAff_y.fromSpec.base.hom.continuous.continuousOn
      have hOpen_img : IsOpen (h_W.base '' (V_y : Set ↥(Fgt.obj W).left)) :=
        h_W.isOpenMap _ V_y.isOpen
      have hInter : ((h_W.base '' (V_y : Set ↥(Fgt.obj W).left)) ∩ (U : Set ↥S)).Nonempty := by
        have hUniv := (IrreducibleSpace.isIrreducible_univ ↥S).isPreirreducible
          (h_W.base '' (V_y : Set ↥(Fgt.obj W).left)) (U : Set ↥S) hOpen_img U.isOpen
          ⟨h_W.base y, trivial, y, hy_Vy, rfl⟩ ⟨u₀_pt, trivial, hu₀_pt⟩
        obtain ⟨s_pt, -, hs_pt⟩ := hUniv
        exact ⟨s_pt, hs_pt⟩
      obtain ⟨_, ⟨z_y, hz_Vy, rfl⟩, hz_U⟩ := hInter
      have hz_range : z_y ∈ Set.range W_U.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        exact hz_U
      obtain ⟨u_y, hu_y⟩ := hz_range
      exact ⟨V_y, u_y, hy_Vy, hIrred_Vy.isPreirreducible, hu_y.symm ▸ hz_Vy⟩
    let V_nbhd : ↥(Fgt.obj W).left → ((Fgt.obj W).left).Opens :=
      fun y => (hIrredNbhd y).choose
    let u_pt : ↥(Fgt.obj W).left → ↥W_U.toScheme :=
      fun y => (hIrredNbhd y).choose_spec.choose
    have hV_spec : ∀ y : ↥(Fgt.obj W).left,
        y ∈ V_nbhd y ∧ IsPreirreducible (V_nbhd y : Set ↥(Fgt.obj W).left) ∧
          W_U.ι.base (u_pt y) ∈ V_nbhd y :=
      fun y => (hIrredNbhd y).choose_spec.choose_spec
    have hComap_bij : Function.Bijective
        (fun f : LocallyConstant ↥(Fgt.obj W).left R => f.comap W_U.ι.base.hom) := by
      refine ⟨?_, ?_⟩
      · intro f₁ f₂ hf_eq
        apply LocallyConstant.ext
        intro y
        obtain ⟨hy_V, hPre_V, hu_V⟩ := hV_spec y
        let O_y : Set ↥(Fgt.obj W).left :=
          (f₁ : ↥(Fgt.obj W).left → R) ⁻¹' {f₁ y} ∩
            (f₂ : ↥(Fgt.obj W).left → R) ⁻¹' {f₂ y}
        have hOpen_Oy : IsOpen O_y :=
          (f₁.isLocallyConstant {f₁ y}).inter (f₂.isLocallyConstant {f₂ y})
        obtain ⟨w_pt, -, hw_Oy, hw_WU⟩ := hPre_V O_y (W_U : Set ↥(Fgt.obj W).left)
          hOpen_Oy W_U.isOpen ⟨y, hy_V, rfl, rfl⟩ ⟨W_U.ι.base (u_pt y), hu_V, by
            rw [← AlgebraicGeometry.Scheme.Opens.range_ι]; exact ⟨u_pt y, rfl⟩⟩
        have hw_range : w_pt ∈ Set.range W_U.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          exact hw_WU
        obtain ⟨q, rfl⟩ := hw_range
        have hq_eq : f₁ (W_U.ι.base q) = f₂ (W_U.ι.base q) :=
          congrArg (fun g : LocallyConstant ↥W_U.toScheme R => g q) hf_eq
        exact hw_Oy.1.symm.trans (hq_eq.trans hw_Oy.2)
      · intro g
        have hConst_on_V : ∀ (y : ↥(Fgt.obj W).left) (q₁ q₂ : ↥W_U.toScheme),
            W_U.ι.base q₁ ∈ V_nbhd y → W_U.ι.base q₂ ∈ V_nbhd y → g q₁ = g q₂ := by
          intro y q₁ q₂ hq₁ hq₂
          obtain ⟨-, hPre_V, -⟩ := hV_spec y
          let U₁ : Set ↥(Fgt.obj W).left := W_U.ι.base '' ((g : ↥W_U.toScheme → R) ⁻¹' {g q₁})
          let U₂ : Set ↥(Fgt.obj W).left := W_U.ι.base '' ((g : ↥W_U.toScheme → R) ⁻¹' {g q₂})
          have hOpen₁ : IsOpen U₁ := W_U.ι.isOpenMap _ (g.isLocallyConstant {g q₁})
          have hOpen₂ : IsOpen U₂ := W_U.ι.isOpenMap _ (g.isLocallyConstant {g q₂})
          obtain ⟨w_pt, -, ⟨p₁, hp₁_val, hp₁_eq⟩, ⟨p₂, hp₂_val, hp₂_eq⟩⟩ :=
            hPre_V U₁ U₂ hOpen₁ hOpen₂ ⟨W_U.ι.base q₁, hq₁, q₁, rfl, rfl⟩
              ⟨W_U.ι.base q₂, hq₂, q₂, rfl, rfl⟩
          have hp_eq : p₁ = p₂ :=
            W_U.ι.isOpenEmbedding.injective (hp₁_eq.trans hp₂_eq.symm)
          have h1 : g p₁ = g q₁ := hp₁_val
          have h2 : g p₂ = g q₂ := hp₂_val
          rw [← h1, hp_eq, h2]
        let g_fn : ↥(Fgt.obj W).left → R := fun y => g (u_pt y)
        have hg_const_nbhd : ∀ (y y' : ↥(Fgt.obj W).left), y' ∈ V_nbhd y → g_fn y' = g_fn y := by
          intro y y' hy'
          obtain ⟨-, hPre_y, hu_y⟩ := hV_spec y
          obtain ⟨hy'_V, -, hu_y'⟩ := hV_spec y'
          obtain ⟨w_pt, hw_Vy, hw_Vy', hw_WU⟩ :=
            hPre_y (V_nbhd y' : Set ↥(Fgt.obj W).left) (W_U : Set ↥(Fgt.obj W).left)
              (V_nbhd y').isOpen W_U.isOpen ⟨y', hy', hy'_V⟩
              ⟨W_U.ι.base (u_pt y), hu_y, by
                rw [← AlgebraicGeometry.Scheme.Opens.range_ι]; exact ⟨u_pt y, rfl⟩⟩
          have hw_range : w_pt ∈ Set.range W_U.ι.base := by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            exact hw_WU
          obtain ⟨q, rfl⟩ := hw_range
          exact (hConst_on_V y' (u_pt y') q hu_y' hw_Vy').trans
            (hConst_on_V y q (u_pt y) hw_Vy hu_y)
        have hg_lc : IsLocallyConstant g_fn := by
          intro E_set
          rw [isOpen_iff_forall_mem_open]
          intro y hy
          refine ⟨(V_nbhd y : Set ↥(Fgt.obj W).left), ?_, (V_nbhd y).isOpen, (hV_spec y).1⟩
          intro y' hy'
          change g_fn y' ∈ E_set
          rw [hg_const_nbhd y y' hy']
          exact hy
        refine ⟨⟨g_fn, hg_lc⟩, ?_⟩
        apply LocallyConstant.ext
        intro q
        change g (u_pt (W_U.ι.base q)) = g q
        exact hConst_on_V (W_U.ι.base q) (u_pt (W_U.ι.base q)) q
          (hV_spec (W_U.ι.base q)).2.2 (hV_spec (W_U.ι.base q)).1
    have hComm_ev : (ev_lc (obj_WU W)) ∘ ((oneR.obj.map (Opposite.op (inc_WU W))).hom) =
        (fun f : LocallyConstant ↥(Fgt.obj W).left R => f.comap W_U.ι.base.hom) ∘ (ev_lc W) := by
      funext s
      apply LocallyConstant.ext
      intro q
      exact h_res (inc_WU W) s q
    have hBij_comp : Function.Bijective
        ((ev_lc (obj_WU W)) ∘ ((oneR.obj.map (Opposite.op (inc_WU W))).hom)) := by
      rw [hComm_ev]
      exact hComap_bij.comp (hev_bij W)
    exact (Function.Bijective.of_comp_iff' (hev_bij (obj_WU W)) _).mp hBij_comp

  have hIso_one : CategoryTheory.IsIso (η_U.app oneR) := hIso_η oneR hUnit_bij

  
  rcases hShriek.out with ⟨T_sh, hAdd_T, hLim_T, hColim_T, triv_T, e_one, ε_tr,
    hC1, _, hC3, _, _, hC6⟩
  let _ : T_sh.Additive := hAdd_T
  let _ : CategoryTheory.Limits.PreservesFiniteLimits T_sh := hLim_T
  let _ : CategoryTheory.Limits.PreservesFiniteColimits T_sh := hColim_T

  let ι_V : Quiver.Hom L.V S := CategoryTheory.CategoryStruct.comp L.π U.ι
  let hι_et : AlgebraicGeometry.Etale ι_V := h_et_V L.π L.hGal.2.1
  let obj_WV : S.Etale → S.Etale := fun W =>
    let h_W : Quiver.Hom (Fgt.obj W).left S := (Fgt.obj W).hom
    letI : AlgebraicGeometry.Etale h_W := W.prop
    letI : AlgebraicGeometry.Etale ι_V := hι_et
    CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst h_W ι_V) h_W)
      inferInstance

  have hEpi_JT : ∀ (ℱ : 𝒞) (p : Quiver.Hom ℱ oneR),
      CategoryTheory.Epi p → CategoryTheory.Epi (J_U.map (T_sh.map p)) := by
    intro ℱ p hp
    have : CategoryTheory.Epi p := hp
    have : CategoryTheory.Presheaf.IsLocallySurjective J_top p.hom :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' ModR p).mpr hp
    let P_cov : ∀ W : S.Etale, CategoryTheory.Sieve W :=
      fun W => CategoryTheory.Presheaf.imageSieve p.hom ((η_sh.app (Opposite.op W)).hom (1 : R))
    have hP_mem : ∀ W : S.Etale, P_cov W ∈ J_top W :=
      fun W => CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem _
    apply hEpi_crit (T_sh.map p) P_cov hP_mem
    intro W W' u hu
    obtain ⟨e_sec, he_sec₀⟩ :=
      (CategoryTheory.Presheaf.imageSieve_apply p.hom
        ((η_sh.app (Opposite.op W)).hom (1 : R)) W' u).mp hu
    have he_sec : (p.hom.app (Opposite.op W')).hom e_sec =
        (η_sh.app (Opposite.op W')).hom (1 : R) :=
      he_sec₀.trans (hη_map u (1 : R))
    let obj_WU' := obj_WU W'
    let Z := obj_WV obj_WU'
    let p_WU' : Quiver.Hom Z obj_WU' :=
      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.Limits.pullback.fst (Fgt.obj obj_WU').hom ι_V) rfl trivial
    let q_W' : Quiver.Hom Z W' := CategoryTheory.CategoryStruct.comp p_WU' (inc_WU W')
    let e_tilde : ↑(ℱ.obj.obj (Opposite.op Z)) := (ℱ.obj.map (Opposite.op q_W')).hom e_sec
    have hp_etilde : (p.hom.app (Opposite.op Z)).hom e_tilde =
        (η_sh.app (Opposite.op Z)).hom (1 : R) := by
      have hnat := congrArg (fun θ => ModuleCat.Hom.hom θ e_sec)
        (p.hom.naturality (Opposite.op q_W'))
      have h1 : (p.hom.app (Opposite.op Z)).hom e_tilde =
          (oneR.obj.map (Opposite.op q_W')).hom ((p.hom.app (Opposite.op W')).hom e_sec) := hnat
      exact h1.trans ((congrArg (oneR.obj.map (Opposite.op q_W')).hom he_sec).trans
        (hη_map q_W' (1 : R)))
    intro s₁
    let f := triv_T oneR obj_WU' s₁
    have hf_mem : f ∈ Set.range (triv_T oneR obj_WU') := ⟨s₁, rfl⟩
    rw [(hC1 oneR obj_WU').2] at hf_mem
    let f_tilde : Fin M → ↑(ℱ.obj.obj (Opposite.op Z)) :=
      fun i => lcSmul ℱ Z (ev_lc Z (f i)) e_tilde
    have hf_tilde_mem : f_tilde ∈ Set.range (triv_T ℱ obj_WU') := by
      rw [(hC1 ℱ obj_WU').2]
      refine ⟨?_, ?_⟩
      · refine ⟨⊥, ?_, ?_⟩
        · ext z
          refine ⟨fun _ => trivial, fun _ => Or.inl ?_⟩
          have hz : (open_WU W').ι.base z ∈ (open_WU W' : Set ↥(Fgt.obj W').left) := by
            rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
            exact ⟨z, rfl⟩
          exact hz
        · intro W₀_V obj_W₀V inc_W₀ i
          have hEmpty : IsEmpty ↥(Fgt.obj obj_W₀V).left := ⟨fun z => by
            have hz : W₀_V.ι.base z ∈ (W₀_V : Set ↥(Fgt.obj Z).left) := by
              rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
              exact ⟨z, rfl⟩
            exact hz⟩
          exact @Subsingleton.elim _ (hEmpty_sub_G ℱ obj_W₀V hEmpty) _ _
      · intro g m_g hm_fst hm_snd i
        have hm_p : CategoryTheory.CategoryStruct.comp m_g p_WU' = p_WU' :=
          CategoryTheory.MorphismProperty.Over.Hom.ext hm_fst
        have hm_q : CategoryTheory.CategoryStruct.comp m_g q_W' = q_W' :=
          (CategoryTheory.Category.assoc m_g p_WU' (inc_WU W')).symm.trans
            (congrArg (· ≫ inc_WU W') hm_p)
        have he_inv : (ℱ.obj.map (Opposite.op m_g)).hom e_tilde = e_tilde :=
          (hMapComp ℱ m_g q_W' e_sec).symm.trans
            (congrArg (fun φ => (ℱ.obj.map (Opposite.op φ)).hom e_sec) hm_q)
        have hf_deck := hf_mem.2 g m_g hm_fst hm_snd i
        have hc_deck : (ev_lc Z (f i)).comap ((Fgt.map m_g).left).base.hom =
            Finset.univ.sum (fun j : Fin M =>
              (ULift.up ((L.τ_rep g).val i j) : R) • ev_lc Z (f j)) := by
          have h1 : (ev_lc Z (f i)).comap ((Fgt.map m_g).left).base.hom =
              ev_lc Z ((oneR.obj.map (Opposite.op m_g)).hom (f i)) := by
            apply LocallyConstant.ext
            intro z
            exact (h_res m_g (f i) z).symm
          exact h1.trans ((congrArg (ev_lc Z) hf_deck).trans
            ((map_sum (ev_lc Z) _ Finset.univ).trans
              (Finset.sum_congr rfl fun j _ => (ev_lc Z).map_smul _ _)))
        exact (hlc_map ℱ m_g (ev_lc Z (f i)) e_tilde).trans
          ((congrArg₂ (lcSmul ℱ Z) hc_deck he_inv).trans
            (hlc_sum ℱ Z Finset.univ
              (fun j => (ULift.up ((L.τ_rep g).val i j) : R))
              (fun j => ev_lc Z (f j)) e_tilde))
    obtain ⟨s', hs'⟩ := hf_tilde_mem
    refine ⟨s', ?_⟩
    apply (hC1 oneR obj_WU').1
    funext i
    exact (hC3 p obj_WU' s' i).trans
      ((congrArg (fun v : Fin M → ↑(ℱ.obj.obj (Opposite.op Z)) =>
          (p.hom.app (Opposite.op Z)).hom (v i)) hs').trans
        ((hlc_hom p Z (ev_lc Z (f i)) e_tilde).trans
          ((congrArg (lcSmul oneR Z (ev_lc Z (f i))) hp_etilde).trans
            (hlc_oneR Z (f i)))))

  
  obtain ⟨w_hat, hw_hat⟩ :=
    hAbsLift oneR L.ℳ_dual L.𝒥 L.ℳ L.ι_ext T_sh e_one ε_tr J_U η_U θ_M hθ_M hIso_one hEpi_JT w
  exact ⟨w_hat, hw_hat.trans (hC6 w).symm⟩

theorem weil_curve_mid_ext_algClosed_torsion_duality_pinned (k : Type u) [Field k] [IsAlgClosed k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 X.hom]
    (U : X.left.Opens)
    (hU_ne : Nonempty ↥U)
    (hCompl_fin : ((U : Set ↥X.left)ᶜ).Finite)
    (m M : ℕ) (hm : 1 ≤ m) (hM : 1 ≤ M) (hUnit : IsUnit ((m : ℕ) : k))
    (h_et_V : ∀ {V : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom V U.toScheme),
      AlgebraicGeometry.Etale π → AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp π U.ι))
    (L : WeilCurveMidExtLevelWitness X.left U m M)
    (hGod : WeilHasTruncatedGodementComplex X.left 1 m)
    (τ_tr : weilEtaleModuleH X.left m 2 →+ ZMod m)
    (hEff : WeilHasLocalEffacement X.left 1 m τ_tr) :
    let oneR := weilEtaleModuleUnit X.left m
    Function.Surjective
      ((CategoryTheory.Abelian.Ext.mk₀ L.ι_ext).postcomp oneR (Nat.add_zero 1)) ∧
    (Finite (CategoryTheory.Abelian.Ext.{u} oneR L.𝒥 1) ∧
      Finite (CategoryTheory.Abelian.Ext.{u} oneR L.𝒥 2) ∧
      Finite (CategoryTheory.Abelian.Ext.{u} oneR L.ℳ 1)) ∧
    ∃ (Ψ : CategoryTheory.Abelian.Ext.{u} oneR L.ℳ_dual 1 →+
        CategoryTheory.Abelian.Ext.{u} L.𝒥 oneR 1)
      (P_mid : CategoryTheory.Abelian.Ext.{u} oneR L.ℳ 1 →+
        CategoryTheory.Abelian.Ext.{u} oneR L.ℳ_dual 1 →+ ZMod m),
      WeilCurveMidExtIsShriekDualMapPinned X.left U m M h_et_V L Ψ ∧
      (∀ (x₀ : CategoryTheory.Abelian.Ext.{u} oneR L.𝒥 1)
          (w : CategoryTheory.Abelian.Ext.{u} oneR L.ℳ_dual 1),
        P_mid (((CategoryTheory.Abelian.Ext.mk₀ L.ι_ext).postcomp oneR (Nat.add_zero 1)) x₀) w =
          τ_tr (x₀.comp (Ψ w) (Nat.one_add 1))) ∧
      (∀ u : CategoryTheory.Abelian.Ext.{u} oneR L.ℳ 1,
        (∀ w : CategoryTheory.Abelian.Ext.{u} oneR L.ℳ_dual 1, P_mid u w = 0) → u = 0) ∧
      (∀ w : CategoryTheory.Abelian.Ext.{u} oneR L.ℳ_dual 1,
        (∀ u : CategoryTheory.Abelian.Ext.{u} oneR L.ℳ 1, P_mid u w = 0) → w = 0) :=
by
  classical
  intro oneR
  let R := ULift.{u, 0} (ZMod m)
  
  have hInjR : Module.Injective R R := by
    apply Module.Baer.injective
    intro I g
    by_cases hm1 : m = 1
    · subst hm1
      have : Subsingleton (ZMod 1) := inferInstance
      have : Subsingleton R := Equiv.ulift.subsingleton
      exact ⟨0, fun x hx => Subsingleton.elim _ _⟩
    · have : NeZero m := ⟨by omega⟩
      by_cases hZero : ∀ y : I, (y : R) = 0
      · refine ⟨0, fun x hx => ?_⟩
        have hx0 : (⟨x, hx⟩ : I) = 0 := Subtype.ext (hZero ⟨x, hx⟩)
        simp [hx0]
      · obtain ⟨y₀, hy₀⟩ := not_forall.mp hZero
        have hy₀_down : (y₀ : R).down ≠ 0 := fun h => hy₀ (ULift.ext _ _ h)
        have hy₀_pos : 0 < (y₀ : R).down.val :=
          Nat.pos_of_ne_zero (fun hv => hy₀_down ((ZMod.val_eq_zero _).mp hv))
        let P : ℕ → Prop := fun k => 0 < k ∧ ∃ y : I, (y : R).down.val = k
        have hex : ∃ k, P k := ⟨(y₀ : R).down.val, hy₀_pos, y₀, rfl⟩
        let d₀ : ℕ := Nat.find hex
        have hd₀_spec : P d₀ := Nat.find_spec hex
        have hd₀_pos : 0 < d₀ := hd₀_spec.1
        obtain ⟨e₀, he₀_val⟩ := hd₀_spec.2
        have hd₀_lt : d₀ < m := he₀_val ▸ ZMod.val_lt (e₀ : R).down
        have he₀_cast : ((d₀ : ℕ) : ZMod m) = (e₀ : R).down := by
          rw [← he₀_val, ZMod.natCast_zmod_val]
        have hd₀_dvd_m : d₀ ∣ m := by
          let q := m / d₀
          let r := m % d₀
          have hdiv : d₀ * q + r = m := Nat.div_add_mod m d₀
          have hr_lt : r < d₀ := Nat.mod_lt m hd₀_pos
          let z : I := -(q • e₀)
          have hz_down : (z : R).down = (r : ZMod m) := by
            change -(q • (e₀ : R).down) = (r : ZMod m)
            rw [nsmul_eq_mul, ← he₀_cast]
            have hm0 : ((d₀ * q + r : ℕ) : ZMod m) = 0 := by
              rw [hdiv, ZMod.natCast_self]
            push_cast at hm0
            linear_combination -hm0
          have hz_val : (z : R).down.val = r := by
            rw [hz_down]
            exact ZMod.val_natCast_of_lt (lt_trans hr_lt hd₀_lt)
          by_cases hr0 : r = 0
          · exact Nat.dvd_of_mod_eq_zero hr0
          · exfalso
            exact Nat.find_min hex hr_lt ⟨Nat.pos_of_ne_zero hr0, z, hz_val⟩
        have hgen : ∀ y : I, y = ((y : R).down.val / d₀) • e₀ := by
          intro y
          let v := (y : R).down.val
          let k := v / d₀
          let rem := v % d₀
          have hdiv_v : d₀ * k + rem = v := Nat.div_add_mod v d₀
          have hrem_lt : rem < d₀ := Nat.mod_lt v hd₀_pos
          let z : I := y - k • e₀
          have hz_down : (z : R).down = (rem : ZMod m) := by
            change (y : R).down - k • (e₀ : R).down = (rem : ZMod m)
            have hv_cast : ((v : ℕ) : ZMod m) = (y : R).down := ZMod.natCast_zmod_val _
            rw [← hv_cast, ← hdiv_v, nsmul_eq_mul, ← he₀_cast]
            push_cast
            ring
          have hz_val : (z : R).down.val = rem := by
            rw [hz_down]
            exact ZMod.val_natCast_of_lt (lt_trans hrem_lt hd₀_lt)
          have hrem0 : rem = 0 := by
            by_contra hne
            exact Nat.find_min hex hrem_lt ⟨Nat.pos_of_ne_zero hne, z, hz_val⟩
          have hz0 : z = 0 := by
            apply Subtype.ext
            apply ULift.ext
            rw [hz_down, hrem0, Nat.cast_zero]
            rfl
          exact sub_eq_zero.mp hz0
        let q := m / d₀
        have hqd₀ : q * d₀ = m := Nat.div_mul_cancel hd₀_dvd_m
        have hq_pos : 0 < q := by
          by_contra hq0
          have hq_eq : q = 0 := Nat.eq_zero_of_not_pos hq0
          rw [hq_eq, zero_mul] at hqd₀
          omega
        have hqe₀ : q • e₀ = 0 := by
          apply Subtype.ext
          apply ULift.ext
          change q • (e₀ : R).down = 0
          rw [nsmul_eq_mul, ← he₀_cast]
          exact_mod_cast (by rw [hqd₀, ZMod.natCast_self] : ((q * d₀ : ℕ) : ZMod m) = 0)
        have hqg : q • g e₀ = 0 := by
          rw [← map_nsmul, hqe₀, map_zero]
        have hdvd_prod : m ∣ q * (g e₀).down.val := by
          have hcast0 : ((q * (g e₀).down.val : ℕ) : ZMod m) = 0 := by
            have h1 : q • (g e₀).down = 0 := congrArg ULift.down hqg
            rw [nsmul_eq_mul, ← ZMod.natCast_zmod_val (g e₀).down] at h1
            exact_mod_cast h1
          exact (ZMod.natCast_eq_zero_iff _ _).mp hcast0
        let v_g : ℕ := (g e₀).down.val
        have hdvd_prod' : q * d₀ ∣ q * v_g := by
          change m ∣ q * v_g at hdvd_prod
          rwa [← hqd₀] at hdvd_prod
        obtain ⟨c₀, hc₀⟩ := (Nat.mul_dvd_mul_iff_left hq_pos).mp hdvd_prod'
        have hc₀' : (g e₀).down.val = d₀ * c₀ := hc₀
        let c : R := ULift.up (c₀ : ZMod m)
        refine ⟨LinearMap.lsmul R R c, fun x hx => ?_⟩
        have hx_gen := hgen ⟨x, hx⟩
        let k_div := (x : R).down.val / d₀
        have hx_val : x = k_div • (e₀ : R) := congrArg Subtype.val hx_gen
        have hge₀ : LinearMap.lsmul R R c (e₀ : R) = g e₀ := by
          apply ULift.ext
          change ((c₀ : ZMod m) * (e₀ : R).down) = (g e₀).down
          rw [← he₀_cast, ← ZMod.natCast_zmod_val (g e₀).down, hc₀']
          push_cast
          ring
        calc
          LinearMap.lsmul R R c x = LinearMap.lsmul R R c (k_div • (e₀ : R)) := by rw [hx_val]
          _ = k_div • LinearMap.lsmul R R c (e₀ : R) := map_nsmul _ _ _
          _ = k_div • g e₀ := by rw [hge₀]
          _ = g (k_div • e₀) := (map_nsmul g k_div e₀).symm
          _ = g ⟨x, hx⟩ := by rw [← hx_gen]
  
  have hCog : ∀ (A : Type u) [AddCommGroup A],
      (∀ x : A, m • x = 0) →
      ∀ a : A, (∀ φ : A →+ ZMod m, φ a = 0) → a = 0 := by
    intro A _ hTors a ha
    have hrem : ∀ (n : ℕ) (x : A), n • x = (n % m) • x := by
      intro n x
      conv_lhs => rw [← Nat.div_add_mod n m]
      rw [add_nsmul, mul_comm m (n / m), mul_smul, hTors x, smul_zero, zero_add]
    by_cases hm1 : m = 1
    · subst hm1
      simpa using hTors a
    · have : NeZero m := ⟨by omega⟩
      have : Fact (1 < m) := ⟨by omega⟩
      by_contra ha_ne
      let instSMulRA : SMul R A := ⟨fun r x => r.down.val • x⟩
      let _ := instSMulRA
      have hsmul_def : ∀ (r : R) (x : A), r • x = r.down.val • x := fun _ _ => rfl
      let instModRA : Module R A :=
        { one_smul := fun x => by
            rw [hsmul_def]
            change (1 : ZMod m).val • x = x
            rw [ZMod.val_one m, one_nsmul]
          mul_smul := fun r s x => by
            rw [hsmul_def, hsmul_def, hsmul_def]
            change (r.down * s.down).val • x = r.down.val • (s.down.val • x)
            rw [ZMod.val_mul, ← hrem, mul_smul]
          smul_zero := fun r => by rw [hsmul_def, nsmul_zero]
          smul_add := fun r x y => by rw [hsmul_def, hsmul_def, hsmul_def, nsmul_add]
          add_smul := fun r s x => by
            rw [hsmul_def, hsmul_def, hsmul_def]
            change (r.down + s.down).val • x = r.down.val • x + s.down.val • x
            rw [ZMod.val_add, ← hrem, add_nsmul]
          zero_smul := fun x => by
            rw [hsmul_def]
            change (0 : ZMod m).val • x = 0
            rw [ZMod.val_zero, zero_nsmul] }
      let _ := instModRA
      let P : ℕ → Prop := fun k => 0 < k ∧ k • a = 0
      have hex : ∃ k, P k := ⟨m, by omega, hTors a⟩
      let d₀ : ℕ := Nat.find hex
      have hd₀_spec : P d₀ := Nat.find_spec hex
      have hd₀_pos : 0 < d₀ := hd₀_spec.1
      have hd₀_ann : d₀ • a = 0 := hd₀_spec.2
      have hd₀_ge2 : 2 ≤ d₀ := by
        by_contra hlt
        have hd1 : d₀ = 1 := by omega
        rw [hd1, one_nsmul] at hd₀_ann
        exact ha_ne hd₀_ann
      have hd₀_dvd : ∀ n : ℕ, n • a = 0 → d₀ ∣ n := by
        intro n hn
        let rem := n % d₀
        have hrem_lt : rem < d₀ := Nat.mod_lt n hd₀_pos
        have hrem_ann : rem • a = 0 := by
          have hdiv : d₀ * (n / d₀) + rem = n := Nat.div_add_mod n d₀
          have h1 : (d₀ * (n / d₀)) • a + rem • a = 0 := by
            rw [← add_nsmul, hdiv, hn]
          rw [mul_comm d₀ (n / d₀), mul_smul, hd₀_ann, smul_zero, zero_add] at h1
          exact h1
        by_cases hr0 : rem = 0
        · exact Nat.dvd_of_mod_eq_zero hr0
        · exfalso
          exact Nat.find_min hex hrem_lt ⟨Nat.pos_of_ne_zero hr0, hrem_ann⟩
      have hd₀_dvd_m : d₀ ∣ m := hd₀_dvd m (hTors a)
      let q : ℕ := m / d₀
      have hqd₀ : q * d₀ = m := Nat.div_mul_cancel hd₀_dvd_m
      have hq_pos : 0 < q := by
        by_contra hq0
        have hq_eq : q = 0 := Nat.eq_zero_of_not_pos hq0
        rw [hq_eq, zero_mul] at hqd₀
        omega
      have hq_lt_m : q < m := by nlinarith
      have hq_cast_ne : (q : ZMod m) ≠ 0 := by
        intro hq0
        have hv := congrArg ZMod.val hq0
        rw [ZMod.val_natCast_of_lt hq_lt_m, ZMod.val_zero] at hv
        omega
      let μ : R →ₗ[R] A := LinearMap.toSpanSingleton R A a
      let g_tilde : R →ₗ[R] R := LinearMap.lsmul R R (ULift.up (q : ZMod m))
      have hker : LinearMap.ker μ ≤ LinearMap.ker g_tilde := by
        intro r hr
        rw [LinearMap.mem_ker] at hr ⊢
        change r.down.val • a = 0 at hr
        obtain ⟨k_div, hk⟩ := hd₀_dvd r.down.val hr
        apply ULift.ext
        change (q : ZMod m) * r.down = 0
        rw [← ZMod.natCast_zmod_val r.down, hk]
        have hqm0 : ((q * d₀ : ℕ) : ZMod m) = 0 := by rw [hqd₀, ZMod.natCast_self]
        push_cast at hqm0 ⊢
        linear_combination (k_div : ZMod m) * hqm0
      let g₀ : LinearMap.range μ →ₗ[R] R :=
        (Submodule.liftQ (LinearMap.ker μ) g_tilde hker).comp
          (LinearMap.quotKerEquivRange μ).symm.toLinearMap
      obtain ⟨lam, hlam⟩ := hInjR.out (LinearMap.range μ).subtype Subtype.val_injective g₀
      let φ : A →+ ZMod m :=
        { toFun := fun x => (lam x).down
          map_zero' := by rw [map_zero]; rfl
          map_add' := fun x y => by rw [map_add]; rfl }
      have hφa : φ a = (q : ZMod m) := by
        have ha_mu : μ (1 : R) = a := one_smul R a
        have hmem : a ∈ LinearMap.range μ := ⟨1, ha_mu⟩
        have h1 : lam a = g₀ ⟨a, hmem⟩ := hlam ⟨a, hmem⟩
        have h2 : (LinearMap.quotKerEquivRange μ) (Submodule.Quotient.mk (1 : R)) = ⟨a, hmem⟩ :=
          Subtype.ext ha_mu
        have h3 : (LinearMap.quotKerEquivRange μ).symm ⟨a, hmem⟩ =
            Submodule.Quotient.mk (1 : R) := by
          rw [← h2, LinearEquiv.symm_apply_apply]
        have h4 : g₀ ⟨a, hmem⟩ = g_tilde (1 : R) := by
          change Submodule.liftQ (LinearMap.ker μ) g_tilde hker
            ((LinearMap.quotKerEquivRange μ).symm ⟨a, hmem⟩) = g_tilde 1
          rw [h3, Submodule.liftQ_apply]
        change (lam a).down = (q : ZMod m)
        rw [h1, h4]
        change ((q : ZMod m) * (1 : ZMod m)) = (q : ZMod m)
        exact mul_one _
      exact hq_cast_ne (hφa.symm.trans (ha φ))
  
  have hTrCrit : ∀ (A : Type u) [AddCommGroup A],
      (∀ x : A, m • x = 0) →
      ∀ τ₀ : A →+ ZMod m,
        (∀ φ : A →+ ZMod m, ∃! c : ZMod m, ∀ x : A, φ x = c * τ₀ x) →
        Function.Bijective τ₀ := by
    intro A _ hTors τ₀ hCrit
    have hrem : ∀ (n : ℕ) (x : A), n • x = (n % m) • x := by
      intro n x
      conv_lhs => rw [← Nat.div_add_mod n m]
      rw [add_nsmul, mul_comm m (n / m), mul_smul, hTors x, smul_zero, zero_add]
    by_cases hm1 : m = 1
    · subst hm1
      have : Subsingleton (ZMod 1) := inferInstance
      refine ⟨fun x y _ => ?_, fun z => ⟨0, Subsingleton.elim _ _⟩⟩
      calc
        x = 1 • x := (one_nsmul x).symm
        _ = 0 := hTors x
        _ = 1 • y := (hTors y).symm
        _ = y := one_nsmul y
    · have : NeZero m := ⟨by omega⟩
      have : Fact (1 < m) := ⟨by omega⟩
      have h1_mem : (1 : ZMod m) ∈ τ₀.range := by
        by_contra hnot
        let Q₀ := ZMod m ⧸ τ₀.range
        let B := ULift.{u, 0} Q₀
        let q_mk : ZMod m →+ B :=
          { toFun := fun z => ULift.up (QuotientAddGroup.mk' τ₀.range z)
            map_zero' := ULift.ext _ _ (map_zero _)
            map_add' := fun x y => ULift.ext _ _ (map_add _ x y) }
        have hB_tors : ∀ b : B, m • b = 0 := by
          intro b
          obtain ⟨z, hz⟩ := QuotientAddGroup.mk'_surjective τ₀.range b.down
          have hb_eq : b = q_mk z := ULift.ext _ _ hz.symm
          rw [hb_eq, ← map_nsmul]
          have hmz : m • z = 0 := by
            rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
          rw [hmz, map_zero]
        have hq1_ne : q_mk 1 ≠ 0 := by
          intro h0
          have h0' : QuotientAddGroup.mk' τ₀.range (1 : ZMod m) = 0 :=
            congrArg ULift.down h0
          exact hnot ((QuotientAddGroup.eq_zero_iff (1 : ZMod m)).mp h0')
        have hnot_all : ¬ ∀ χ : B →+ ZMod m, χ (q_mk 1) = 0 :=
          fun hall => hq1_ne (hCog B hB_tors (q_mk 1) hall)
        obtain ⟨χ, hχ⟩ := not_forall.mp hnot_all
        let c : ZMod m := χ (q_mk 1)
        have hc_ann : ∀ x : A, (0 : A →+ ZMod m) x = c * τ₀ x := by
          intro x
          have hmem : τ₀ x ∈ τ₀.range := ⟨x, rfl⟩
          have hqx0 : q_mk (τ₀ x) = 0 :=
            ULift.ext _ _ ((QuotientAddGroup.eq_zero_iff (τ₀ x)).mpr hmem)
          have hval : τ₀ x = (τ₀ x).val • (1 : ZMod m) := by
            rw [nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
          have h0 : χ (q_mk (τ₀ x)) = 0 := by rw [hqx0, map_zero]
          rw [hval, map_nsmul, map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val] at h0
          change (0 : ZMod m) = c * τ₀ x
          rw [mul_comm]
          exact h0.symm
        obtain ⟨c₀, _, hc₀_uniq⟩ := hCrit 0
        have hc_eq : c = c₀ := hc₀_uniq c hc_ann
        have h0_eq : (0 : ZMod m) = c₀ := hc₀_uniq 0 (fun x => by simp)
        exact hχ (hc_eq.trans h0_eq.symm)
      obtain ⟨e₀, he₀⟩ := h1_mem
      have hSurj : Function.Surjective τ₀ := by
        intro z
        refine ⟨z.val • e₀, ?_⟩
        rw [map_nsmul, he₀, nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
      have hInj : Function.Injective τ₀ := by
        rw [injective_iff_map_eq_zero]
        intro z hz
        by_contra hz_ne
        let K := τ₀.ker
        have hK_tors : ∀ u : ↥K, m • u = 0 := fun u => Subtype.ext (hTors u.1)
        let zK : ↥K := ⟨z, hz⟩
        have hzK_ne : zK ≠ 0 := fun h0 => hz_ne (congrArg Subtype.val h0)
        have hnot_all : ¬ ∀ ψ : ↥K →+ ZMod m, ψ zK = 0 :=
          fun hall => hzK_ne (hCog ↥K hK_tors zK hall)
        obtain ⟨ψ, hψ⟩ := not_forall.mp hnot_all
        let π_ker : A →+ ↥K :=
          { toFun := fun x => ⟨x - (τ₀ x).val • e₀, by
              rw [AddMonoidHom.mem_ker, map_sub, map_nsmul, he₀, nsmul_eq_mul,
                mul_one, ZMod.natCast_zmod_val, sub_self]⟩
            map_zero' := by
              apply Subtype.ext
              simp
            map_add' := fun x y => by
              apply Subtype.ext
              change (x + y) - (τ₀ (x + y)).val • e₀ =
                (x - (τ₀ x).val • e₀) + (y - (τ₀ y).val • e₀)
              have hval_add : (τ₀ (x + y)).val • e₀ = (τ₀ x).val • e₀ + (τ₀ y).val • e₀ := by
                rw [map_add, ZMod.val_add, ← hrem, add_nsmul]
              rw [hval_add]
              abel }
        let φ : A →+ ZMod m := ψ.comp π_ker
        obtain ⟨c, hc, _⟩ := hCrit φ
        have hc0 : c = 0 := by
          have he := hc e₀
          have hπe₀ : π_ker e₀ = 0 := by
            apply Subtype.ext
            change e₀ - (τ₀ e₀).val • e₀ = 0
            rw [he₀, ZMod.val_one m, one_nsmul, sub_self]
          have hφe₀ : φ e₀ = 0 := by
            change ψ (π_ker e₀) = 0
            rw [hπe₀, map_zero]
          rw [hφe₀, he₀, mul_one] at he
          exact he.symm
        have hφz : φ z = 0 := by rw [hc z, hc0, zero_mul]
        have hπz : π_ker z = zK := by
          apply Subtype.ext
          change z - (τ₀ z).val • e₀ = z
          rw [hz, ZMod.val_zero, zero_nsmul, sub_zero]
        have hφz' : φ z = ψ zK := by
          change ψ (π_ker z) = ψ zK
          rw [hπz]
        exact hψ (hφz'.symm.trans hφz)
      exact ⟨hInj, hSurj⟩
  
  have hCard_step : ∀ (n : ℕ) (A : Type u) [AddCommGroup A] [Finite A],
      Nat.card A = n → (∀ x : A, m • x = 0) → Nat.card (A →+ ZMod m) = n := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro A _ _ hn hTors
      by_cases hAll0 : ∀ a : A, a = 0
      · have hSubA : Subsingleton A := ⟨fun x y => (hAll0 x).trans (hAll0 y).symm⟩
        have hSubHom : Subsingleton (A →+ ZMod m) :=
          ⟨fun φ₁ φ₂ => AddMonoidHom.ext fun x => by rw [hAll0 x, map_zero, map_zero]⟩
        have hCardA1 : Nat.card A = 1 := @Nat.card_unique A ⟨0⟩ hSubA
        have hCardHom1 : Nat.card (A →+ ZMod m) = 1 :=
          @Nat.card_unique (A →+ ZMod m) ⟨0⟩ hSubHom
        omega
      · obtain ⟨a, ha_ne⟩ := not_forall.mp hAll0
        have hm_ne1 : m ≠ 1 := by
          rintro rfl
          exact ha_ne ((one_nsmul a).symm.trans (hTors a))
        have : NeZero m := ⟨by omega⟩
        have : Fact (1 < m) := ⟨by omega⟩
        have hrem : ∀ (k_val : ℕ) (x : A), k_val • x = (k_val % m) • x := by
          intro k_val x
          conv_lhs => rw [← Nat.div_add_mod k_val m]
          rw [add_nsmul, mul_comm m (k_val / m), mul_smul, hTors x, smul_zero, zero_add]
        have : Finite (A →+ ZMod m) :=
          Finite.of_injective (fun φ : A →+ ZMod m => (φ : A → ZMod m)) DFunLike.coe_injective
        let C : AddSubgroup A := AddSubgroup.zmultiples a
        have : Finite ↥C := Subtype.finite
        have : Finite (A ⧸ C) :=
          Finite.of_surjective (QuotientAddGroup.mk' C) (QuotientAddGroup.mk'_surjective C)
        have hNontrivC : Nontrivial ↥C :=
          ⟨⟨0, C.zero_mem⟩, ⟨a, AddSubgroup.mem_zmultiples a⟩,
            fun h => ha_ne (congrArg Subtype.val h).symm⟩
        have hCardC_gt1 : 1 < Nat.card ↥C := @Finite.one_lt_card ↥C _ hNontrivC
        have hCardQ_pos : 0 < Nat.card (A ⧸ C) := @Finite.card_pos (A ⧸ C) _ ⟨0⟩
        have hLagA : Nat.card A = Nat.card (A ⧸ C) * Nat.card ↥C :=
          AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup C
        have hCardQ_lt : Nat.card (A ⧸ C) < n := by
          rw [← hn, hLagA]
          nlinarith
        have hTorsQ : ∀ q : A ⧸ C, m • q = 0 := by
          intro q
          obtain ⟨x, rfl⟩ := QuotientAddGroup.mk'_surjective C q
          rw [← map_nsmul, hTors x, map_zero]
        have ihQ : Nat.card ((A ⧸ C) →+ ZMod m) = Nat.card (A ⧸ C) :=
          ih (Nat.card (A ⧸ C)) hCardQ_lt (A ⧸ C) rfl hTorsQ
        let res : (A →+ ZMod m) →+ (↥C →+ ZMod m) :=
          AddMonoidHom.mk' (fun φ => φ.comp C.subtype) (fun _ _ => rfl)
        have hres_surj : Function.Surjective res := by
          intro χ
          let instSMulRA : SMul R A := ⟨fun r x => r.down.val • x⟩
          let _ := instSMulRA
          have hsmul_def : ∀ (r : R) (x : A), r • x = r.down.val • x := fun _ _ => rfl
          let instModRA : Module R A :=
            { one_smul := fun x => by
                rw [hsmul_def]
                change (1 : ZMod m).val • x = x
                rw [ZMod.val_one m, one_nsmul]
              mul_smul := fun r s x => by
                rw [hsmul_def, hsmul_def, hsmul_def]
                change (r.down * s.down).val • x = r.down.val • (s.down.val • x)
                rw [ZMod.val_mul, ← hrem, mul_smul]
              smul_zero := fun r => by rw [hsmul_def, nsmul_zero]
              smul_add := fun r x y => by rw [hsmul_def, hsmul_def, hsmul_def, nsmul_add]
              add_smul := fun r s x => by
                rw [hsmul_def, hsmul_def, hsmul_def]
                change (r.down + s.down).val • x = r.down.val • x + s.down.val • x
                rw [ZMod.val_add, ← hrem, add_nsmul]
              zero_smul := fun x => by
                rw [hsmul_def]
                change (0 : ZMod m).val • x = 0
                rw [ZMod.val_zero, zero_nsmul] }
          let _ := instModRA
          let C_mod : Submodule R A :=
            { carrier := (C : Set A)
              zero_mem' := C.zero_mem
              add_mem' := fun hx hy => C.add_mem hx hy
              smul_mem' := fun r _ hx => C.nsmul_mem hx r.down.val }
          let χ_lin : ↥C_mod →ₗ[R] R :=
            { toFun := fun x => ULift.up (χ ⟨x.1, x.2⟩)
              map_add' := fun x y => ULift.ext _ _ (map_add χ ⟨x.1, x.2⟩ ⟨y.1, y.2⟩)
              map_smul' := fun r x => by
                apply ULift.ext
                change χ ⟨r.down.val • x.1, _⟩ = r.down * χ ⟨x.1, x.2⟩
                have hsub : (⟨r.down.val • x.1, C.nsmul_mem x.2 r.down.val⟩ : ↥C) =
                    r.down.val • (⟨x.1, x.2⟩ : ↥C) := rfl
                rw [hsub, map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val] }
          obtain ⟨lam, hlam⟩ := hInjR.out C_mod.subtype Subtype.val_injective χ_lin
          let φ : A →+ ZMod m :=
            { toFun := fun x => (lam x).down
              map_zero' := by rw [map_zero]; rfl
              map_add' := fun x y => by rw [map_add]; rfl }
          refine ⟨φ, ?_⟩
          ext ⟨x, hx⟩
          exact congrArg ULift.down (hlam ⟨x, hx⟩)
        have hCardQuotHom :
            Nat.card ((A →+ ZMod m) ⧸ res.ker) = Nat.card (↥C →+ ZMod m) :=
          Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective res hres_surj).toEquiv
        let π_C : A →+ A ⧸ C := QuotientAddGroup.mk' C
        let toKer : ((A ⧸ C) →+ ZMod m) → ↥res.ker :=
          fun ψ => ⟨ψ.comp π_C, by
            ext ⟨x, hx⟩
            change ψ (x : A ⧸ C) = 0
            rw [(QuotientAddGroup.eq_zero_iff x).mpr hx, map_zero]⟩
        have htoKer_bij : Function.Bijective toKer := by
          refine ⟨?_, ?_⟩
          · intro ψ₁ ψ₂ hψ
            apply AddMonoidHom.ext
            intro q
            obtain ⟨x, hx⟩ := QuotientAddGroup.mk'_surjective C q
            rw [← hx]
            exact DFunLike.congr_fun (congrArg Subtype.val hψ) x
          · rintro ⟨φ, hφ⟩
            have hC_le : C ≤ φ.ker := by
              intro x hx
              exact DFunLike.congr_fun hφ ⟨x, hx⟩
            refine ⟨QuotientAddGroup.lift C φ hC_le, ?_⟩
            apply Subtype.ext
            ext x
            exact QuotientAddGroup.lift_mk' C hC_le x
        have hCardKer : Nat.card ((A ⧸ C) →+ ZMod m) = Nat.card ↥res.ker :=
          Nat.card_eq_of_bijective toKer htoKer_bij
        let P : ℕ → Prop := fun k_val => 0 < k_val ∧ k_val • a = 0
        have hex : ∃ k_val, P k_val := ⟨m, by omega, hTors a⟩
        let d₀ : ℕ := Nat.find hex
        have hd₀_spec : P d₀ := Nat.find_spec hex
        have hd₀_pos : 0 < d₀ := hd₀_spec.1
        have hd₀_ann : d₀ • a = 0 := hd₀_spec.2
        have hd₀_gt1 : 1 < d₀ := by
          by_contra hlt
          have hd1 : d₀ = 1 := by omega
          rw [hd1, one_nsmul] at hd₀_ann
          exact ha_ne hd₀_ann
        have hd₀_dvd : ∀ k_val : ℕ, k_val • a = 0 → d₀ ∣ k_val := by
          intro k_val hk_val
          let rem := k_val % d₀
          have hrem_lt : rem < d₀ := Nat.mod_lt k_val hd₀_pos
          have hrem_ann : rem • a = 0 := by
            have hdiv : d₀ * (k_val / d₀) + rem = k_val := Nat.div_add_mod k_val d₀
            have h1 : (d₀ * (k_val / d₀)) • a + rem • a = 0 := by
              rw [← add_nsmul, hdiv, hk_val]
            rw [mul_comm d₀ (k_val / d₀), mul_smul, hd₀_ann, smul_zero, zero_add] at h1
            exact h1
          by_cases hr0 : rem = 0
          · exact Nat.dvd_of_mod_eq_zero hr0
          · exfalso
            exact Nat.find_min hex hrem_lt ⟨Nat.pos_of_ne_zero hr0, hrem_ann⟩
        have hd₀_dvd_m : d₀ ∣ m := hd₀_dvd m (hTors a)
        let q : ℕ := m / d₀
        have hqd₀ : q * d₀ = m := Nat.div_mul_cancel hd₀_dvd_m
        have hq_pos : 0 < q := by
          by_contra hq0
          have hq_eq : q = 0 := Nat.eq_zero_of_not_pos hq0
          rw [hq_eq, zero_mul] at hqd₀
          omega
        have hrem_a : ∀ k_val : ℕ, (k_val % d₀) • a = k_val • a := by
          intro k_val
          conv_rhs => rw [← Nat.div_add_mod k_val d₀]
          rw [add_nsmul, mul_comm d₀ (k_val / d₀), mul_smul, hd₀_ann, smul_zero, zero_add]
        let f_C : Fin d₀ → ↥C :=
          fun k_fin => ⟨k_fin.1 • a, C.nsmul_mem (AddSubgroup.mem_zmultiples a) k_fin.1⟩
        have hf_C_bij : Function.Bijective f_C := by
          refine ⟨?_, ?_⟩
          · intro i j hij
            have hij_val : i.1 • a = j.1 • a := congrArg Subtype.val hij
            have hsub_ann : ∀ {u v : ℕ}, u ≤ v → v < d₀ → u • a = v • a → u = v := by
              intro u v huv hv h_eq
              have hdiff_ann : (v - u) • a = 0 := by
                have hsum : (v - u) • a + u • a = 0 + u • a := by
                  rw [← add_nsmul, Nat.sub_add_cancel huv, ← h_eq, zero_add]
                exact add_right_cancel hsum
              have hdvd_diff : d₀ ∣ (v - u) := hd₀_dvd (v - u) hdiff_ann
              by_cases h0 : v - u = 0
              · omega
              · exfalso
                have hle_bad : d₀ ≤ v - u := Nat.le_of_dvd (Nat.pos_of_ne_zero h0) hdvd_diff
                omega
            apply Fin.ext
            rcases le_total i.1 j.1 with hle | hge
            · exact hsub_ann hle j.2 hij_val
            · exact (hsub_ann hge i.2 hij_val.symm).symm
          · rintro ⟨x, hx⟩
            obtain ⟨z, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hx
            cases z with
            | ofNat k_nat =>
              refine ⟨⟨k_nat % d₀, Nat.mod_lt k_nat hd₀_pos⟩, Subtype.ext ?_⟩
              change (k_nat % d₀) • a = (Int.ofNat k_nat) • a
              rw [Int.ofNat_eq_natCast, natCast_zsmul]
              exact hrem_a k_nat
            | negSucc k_nat =>
              let r₀ := (k_nat + 1) % d₀
              have hr₀_lt : r₀ < d₀ := Nat.mod_lt (k_nat + 1) hd₀_pos
              have hr₀_eq : r₀ • a = (k_nat + 1) • a := hrem_a (k_nat + 1)
              by_cases hr₀_zero : r₀ = 0
              · refine ⟨⟨0, hd₀_pos⟩, Subtype.ext ?_⟩
                change 0 • a = (Int.negSucc k_nat) • a
                rw [negSucc_zsmul, ← hr₀_eq, hr₀_zero, zero_nsmul, neg_zero]
              · have hr₀_pos : 0 < r₀ := Nat.pos_of_ne_zero hr₀_zero
                refine ⟨⟨d₀ - r₀, by omega⟩, Subtype.ext ?_⟩
                change (d₀ - r₀) • a = (Int.negSucc k_nat) • a
                rw [negSucc_zsmul, ← hr₀_eq]
                have hsum0 : (d₀ - r₀) • a + r₀ • a = 0 := by
                  rw [← add_nsmul, Nat.sub_add_cancel (le_of_lt hr₀_lt), hd₀_ann]
                exact eq_neg_of_add_eq_zero_left hsum0
        have hCardC : Nat.card ↥C = d₀ :=
          (Nat.card_eq_of_bijective f_C hf_C_bij).symm.trans (Nat.card_fin d₀)
        let e_C : Fin d₀ ≃ ↥C := Equiv.ofBijective f_C hf_C_bij
        let a_C : ↥C := ⟨a, AddSubgroup.mem_zmultiples a⟩
        have ha_C_ann : d₀ • a_C = 0 := Subtype.ext hd₀_ann
        let ev_C : (↥C →+ ZMod m) → { z : ZMod m // d₀ • z = 0 } :=
          fun χ => ⟨χ a_C, by rw [← map_nsmul, ha_C_ann, map_zero]⟩
        have hev_C_bij : Function.Bijective ev_C := by
          refine ⟨?_, ?_⟩
          · intro χ₁ χ₂ hχ
            have h_eq : χ₁ a_C = χ₂ a_C := congrArg Subtype.val hχ
            ext y
            obtain ⟨k_fin, hk_fin⟩ := hf_C_bij.2 y
            have hy_eq : y = k_fin.1 • a_C := hk_fin.symm
            rw [hy_eq, map_nsmul, map_nsmul, h_eq]
          · rintro ⟨z, hz⟩
            have hrem_z : ∀ k_val : ℕ, (k_val % d₀) • z = k_val • z := by
              intro k_val
              conv_rhs => rw [← Nat.div_add_mod k_val d₀]
              rw [add_nsmul, mul_comm d₀ (k_val / d₀), mul_smul, hz, smul_zero, zero_add]
            have he_zero : e_C.symm 0 = ⟨0, hd₀_pos⟩ := by
              apply e_C.injective
              rw [e_C.apply_symm_apply]
              exact Subtype.ext (zero_nsmul a).symm
            have he_one : e_C.symm a_C = ⟨1, hd₀_gt1⟩ := by
              apply e_C.injective
              rw [e_C.apply_symm_apply]
              exact Subtype.ext (one_nsmul a).symm
            let χ : ↥C →+ ZMod m :=
              { toFun := fun y => (e_C.symm y).1 • z
                map_zero' := by rw [he_zero]; exact zero_nsmul z
                map_add' := fun y₁ y₂ => by
                  let k₁ := (e_C.symm y₁).1
                  let k₂ := (e_C.symm y₂).1
                  have hy₁ : k₁ • a = y₁.1 := congrArg Subtype.val (e_C.apply_symm_apply y₁)
                  have hy₂ : k₂ • a = y₂.1 := congrArg Subtype.val (e_C.apply_symm_apply y₂)
                  let k_mod : Fin d₀ := ⟨(k₁ + k₂) % d₀, Nat.mod_lt (k₁ + k₂) hd₀_pos⟩
                  have hf_mod : e_C k_mod = y₁ + y₂ := by
                    apply Subtype.ext
                    change ((k₁ + k₂) % d₀) • a = y₁.1 + y₂.1
                    rw [hrem_a (k₁ + k₂), add_nsmul, hy₁, hy₂]
                  have hsymm_add : e_C.symm (y₁ + y₂) = k_mod := by
                    rw [← hf_mod, e_C.symm_apply_apply]
                  change (e_C.symm (y₁ + y₂)).1 • z = k₁ • z + k₂ • z
                  rw [hsymm_add]
                  change ((k₁ + k₂) % d₀) • z = k₁ • z + k₂ • z
                  rw [hrem_z (k₁ + k₂), add_nsmul] }
            refine ⟨χ, Subtype.ext ?_⟩
            change (e_C.symm a_C).1 • z = z
            rw [he_one, one_nsmul]
        let g_T : Fin d₀ → { z : ZMod m // d₀ • z = 0 } :=
          fun t => ⟨((t.1 * q : ℕ) : ZMod m), by
            rw [nsmul_eq_mul]
            have hmul_m : d₀ * (t.1 * q) = t.1 * m := by
              rw [← hqd₀]
              ring
            exact_mod_cast (by
              rw [hmul_m, Nat.cast_mul, ZMod.natCast_self, mul_zero] :
                ((d₀ * (t.1 * q) : ℕ) : ZMod m) = 0)⟩
        have hg_T_bij : Function.Bijective g_T := by
          refine ⟨?_, ?_⟩
          · intro t₁ t₂ ht
            have ht_val : ((t₁.1 * q : ℕ) : ZMod m) = ((t₂.1 * q : ℕ) : ZMod m) :=
              congrArg Subtype.val ht
            have ht₁_lt : t₁.1 * q < m := by
              rw [← hqd₀, mul_comm q d₀]
              exact Nat.mul_lt_mul_of_pos_right t₁.2 hq_pos
            have ht₂_lt : t₂.1 * q < m := by
              rw [← hqd₀, mul_comm q d₀]
              exact Nat.mul_lt_mul_of_pos_right t₂.2 hq_pos
            have hmul_eq : t₁.1 * q = t₂.1 * q := by
              have hv := congrArg ZMod.val ht_val
              rwa [ZMod.val_natCast_of_lt ht₁_lt, ZMod.val_natCast_of_lt ht₂_lt] at hv
            exact Fin.ext (Nat.mul_right_cancel hq_pos hmul_eq)
          · rintro ⟨z, hz⟩
            have hcast0 : ((d₀ * z.val : ℕ) : ZMod m) = 0 := by
              have h1 : d₀ • (z.val : ZMod m) = 0 := by rwa [ZMod.natCast_zmod_val]
              rw [nsmul_eq_mul] at h1
              exact_mod_cast h1
            have hdvd_m : d₀ * q ∣ d₀ * z.val := by
              rw [mul_comm d₀ q, hqd₀]
              exact (ZMod.natCast_eq_zero_iff _ m).mp hcast0
            obtain ⟨t₀, ht₀⟩ := (Nat.mul_dvd_mul_iff_left hd₀_pos).mp hdvd_m
            have ht₀_lt : t₀ < d₀ := by
              have hz_lt : z.val < m := ZMod.val_lt z
              rw [ht₀, ← hqd₀] at hz_lt
              exact lt_of_mul_lt_mul_left hz_lt (Nat.zero_le q)
            refine ⟨⟨t₀, ht₀_lt⟩, Subtype.ext ?_⟩
            change ((t₀ * q : ℕ) : ZMod m) = z
            rw [mul_comm t₀ q, ← ht₀, ZMod.natCast_zmod_val]
        have hCardT : Nat.card { z : ZMod m // d₀ • z = 0 } = d₀ :=
          (Nat.card_eq_of_bijective g_T hg_T_bij).symm.trans (Nat.card_fin d₀)
        have hCardHomC : Nat.card (↥C →+ ZMod m) = d₀ :=
          (Nat.card_eq_of_bijective ev_C hev_C_bij).trans hCardT
        have hLagHom :
            Nat.card (A →+ ZMod m) = Nat.card ((A →+ ZMod m) ⧸ res.ker) * Nat.card ↥res.ker :=
          AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup res.ker
        rw [hLagHom, hCardQuotHom, ← hCardKer, ihQ, hCardHomC, mul_comm, ← hCardC, ← hLagA, hn]
  have hCard_Hom : ∀ (A : Type u) [AddCommGroup A] [Finite A],
      (∀ x : A, m • x = 0) → Nat.card (A →+ ZMod m) = Nat.card A :=
    fun A _ _ hTors => hCard_step (Nat.card A) A rfl hTors
  
  have hAbsExtDuality :
      ∀ {𝒞₀ : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞₀]
        [CategoryTheory.Abelian 𝒞₀] [CategoryTheory.HasExt.{u} 𝒞₀]
