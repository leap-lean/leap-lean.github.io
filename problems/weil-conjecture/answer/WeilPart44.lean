      obtain ⟨q_pt, hq_pt⟩ := hSurj_spec.surj bot_pt
      intro x y hxy
      have hsub : algebraMap R0_bar (B_bar (r + 1)) (x - y) = 0 := by rw [map_sub, hxy, sub_self]
      have hmem_q : algebraMap R0_bar (B_bar (r + 1)) (x - y) ∈ q_pt.asIdeal := by
        rw [hsub]; exact q_pt.asIdeal.zero_mem
      have hcomap : PrimeSpectrum.comap (algebraMap R0_bar (B_bar (r + 1))) q_pt = bot_pt := hq_pt
      have hmem_bot : x - y ∈ (bot_pt.asIdeal : Ideal R0_bar) := by
        rw [← hcomap]; exact hmem_q
      rw [Ideal.mem_bot] at hmem_bot
