        rw [CategoryTheory.Category.assoc τ_Q π₂, ← CategoryTheory.Category.assoc π₂ f_x p_chart,
          ← CategoryTheory.Limits.pullback.condition (f := f_x) (g := f_x),
          CategoryTheory.Category.assoc π₁ f_x p_chart,
