    have hFiniteTower : ∀ (r₀ : ℕ) (z₀ : H_coh r₀),
        ∃ f : (∀ r : ℕ, H_coh r), f r₀ = z₀ ∧ ∀ r < r₀, T_coh r (f (r + 1)) = f r := by
      intro r₀
      induction r₀ with
      | zero =>
        intro z₀
        refine ⟨fun r => if h : r = 0 then h ▸ z₀ else 0, by simp, fun r hr => ?_⟩
        omega
      | succ r₀ ih =>
        intro z₀
        obtain ⟨f₀, hf₀_top, hf₀_step⟩ := ih (T_coh r₀ z₀)
        let f : ∀ r : ℕ, H_coh r := fun r => if h : r = r₀ + 1 then h ▸ z₀ else f₀ r
        have hf_top : f (r₀ + 1) = z₀ := by simp [f]
        refine ⟨f, hf_top, fun r hr => ?_⟩
        by_cases h_eq : r = r₀
        · rw [h_eq, hf_top]
          have hf_r₀ : f r₀ = f₀ r₀ := by
            dsimp [f]; exact dite_cond_eq_false (eq_false (by omega))
          rw [hf_r₀, hf₀_top]
        · have hr_lt : r < r₀ := by omega
          have hf_succ : f (r + 1) = f₀ (r + 1) := by
            dsimp [f]; exact dite_cond_eq_false (eq_false (by omega))
          have hf_cur : f r = f₀ r := by
            dsimp [f]; exact dite_cond_eq_false (eq_false (by omega))
          rw [hf_succ, hf_cur]
          exact hf₀_step r hr_lt
    have hLiftCoh : ∀ (r₀ : ℕ) (z₀ : H_coh r₀), ∃ x : ↥sysSubgroup, x.1 r₀ = z₀ := by
      intro r₀ z₀
      obtain ⟨f, hf_top, hf_step⟩ := hFiniteTower r₀ z₀
      let x_seq : ∀ r : ℕ, H_coh r :=
        Nat.rec (f 0) (fun r prev =>
          if r < r₀ then f (r + 1) else Classical.choose (hSurj_T r prev))
      have hx_le : ∀ r : ℕ, r ≤ r₀ → x_seq r = f r := by
        intro r
        induction r with
        | zero => intro _; rfl
        | succ r _ =>
          intro hr
          have hlt : r < r₀ := by omega
          change (if r < r₀ then f (r + 1) else Classical.choose (hSurj_T r (x_seq r))) = f (r + 1)
          simp [hlt]
      have hx_sys : x_seq ∈ sysSubgroup := by
        rw [hsys]
        intro r
        change T_coh r (if r < r₀ then f (r + 1) else Classical.choose (hSurj_T r (x_seq r))) = x_seq r
        split_ifs with hlt
        · rw [hf_step r hlt, hx_le r (Nat.le_of_lt hlt)]
        · exact Classical.choose_spec (hSurj_T r (x_seq r))
      exact ⟨⟨x_seq, hx_sys⟩, (hx_le r₀ (le_refl r₀)).trans hf_top⟩
    have hInj_left : Function.Injective B_coinv := by
      rw [injective_iff_map_eq_zero]
      intro ψ hψ0
      obtain ⟨k, w, hw⟩ := hLiftΨ ψ
      rw [hB_coinv_eval ψ k w hw] at hψ0
      have hpow_inv_ne : (((ℓ : Padic ℓ) ^ k)⁻¹) ≠ 0 := inv_ne_zero (pow_ne_zero k hℓ_K_ne)
      have hB_w0 : B_int w = 0 := (smul_eq_zero.mp hψ0).resolve_left hpow_inv_ne
      have hw0 : w = 0 := by
        apply Subtype.ext; ext i
        apply PadicInt.ext_of_toZModPow.mp
        intro s
        cases s with
        | zero => exact @Subsingleton.elim _ hSubZ0 _ _
        | succ r =>
          have hred0 : (redInv r w).1 = 0 := by
            apply hLeft r (redInv r w)
            intro z_r
            obtain ⟨x, hx⟩ := hLiftCoh r z_r
            have hBx : algebraMap (PadicInt ℓ) (Padic ℓ) (β w x) = 0 := by
              rw [← hB_int_tmul w x]
              exact LinearMap.congr_fun hB_w0 (equiv (TensorProduct.tmul ℤ (1 : ℚ) x))
            have hβ0 : β w x = 0 := hcoe_inj (hBx.trans (map_zero _).symm)
            rw [← hx, ← hβ_spec w x r, hβ0, map_zero]
          change PadicInt.toZModPow (r + 1) (w.1 i) = PadicInt.toZModPow (r + 1) 0
          rw [map_zero]
          exact congrFun hred0 i
      apply Subtype.ext
      apply hvecOf_inj
      ext i
      have hwi := hw i
      rw [hw0] at hwi
      change algebraMap (PadicInt ℓ) (Padic ℓ) 0 = ((ℓ : Padic ℓ) ^ k) * vecOf ψ.1 i at hwi
      rw [map_zero] at hwi
      simpa [vecOf] using (mul_eq_zero.mp hwi.symm).resolve_left (pow_ne_zero k hℓ_K_ne)
    let W := Fin N → PadicInt ℓ
    let S_K : Set W := { u : W | ∃ h ∈ H_geom, ∃ v : W, u = (h.val - 1).mulVec v }
    let K_sub : Submodule (PadicInt ℓ) W := Submodule.span (PadicInt ℓ) S_K
    have hOrth_I : ∀ w : W, (∀ u ∈ K_sub, dotProduct w u = 0) → w ∈ I_int := by
      intro w hw h hh
      ext i
      have hmem : (h.val - 1).mulVec (Pi.single i (1 : PadicInt ℓ)) ∈ K_sub :=
        Submodule.subset_span ⟨h, hh, Pi.single i 1, rfl⟩
      have h0 := hw _ hmem
      rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose] at h0
      simp only [dotProduct, Pi.single_apply, mul_boole, Finset.sum_ite_eq', Finset.mem_univ,
        ↓reduceIte, Matrix.transpose_sub, Matrix.transpose_one, Matrix.sub_mulVec,
        Matrix.one_mulVec, Pi.sub_apply] at h0
      exact sub_eq_zero.mp h0
    have hMod_ann : ∀ (r : ℕ) (lam : ↥(invTorsSubgroup r)) (lam_tilde : W),
        (∀ i : Fin N, PadicInt.toZModPow (r + 1) (lam_tilde i) = lam.1 i) →
        ∀ u ∈ K_sub, PadicInt.toZModPow (r + 1) (dotProduct lam_tilde u) = 0 := by
      intro r lam lam_tilde hlift
      let L_ann : Submodule (PadicInt ℓ) W :=
        { carrier := { u : W | PadicInt.toZModPow (r + 1) (dotProduct lam_tilde u) = 0 }
          add_mem' := fun {u₁ u₂} h₁ h₂ => by
            change PadicInt.toZModPow (r + 1) (dotProduct lam_tilde (u₁ + u₂)) = 0
            rw [dotProduct_add, map_add, h₁, h₂, add_zero]
          zero_mem' := by simp
          smul_mem' := fun c {u} hu => by
            change PadicInt.toZModPow (r + 1) (dotProduct lam_tilde (c • u)) = 0
            rw [dotProduct_smul, smul_eq_mul, map_mul, hu, mul_zero] }
      have hle : K_sub ≤ L_ann := by
        refine Submodule.span_le.mpr ?_
        rintro u ⟨h, hh, v, rfl⟩
        change PadicInt.toZModPow (r + 1) (dotProduct lam_tilde ((h.val - 1).mulVec v)) = 0
        rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose]
        have hmap_vec : ∀ i : Fin N,
            PadicInt.toZModPow (r + 1) ((((h.val - 1).transpose).mulVec lam_tilde) i) =
              (((((h.val).map (PadicInt.toZModPow (r + 1))).transpose).mulVec lam.1) i - lam.1 i) := by
          intro i
          rw [Matrix.transpose_sub, Matrix.transpose_one, Matrix.sub_mulVec, Matrix.one_mulVec]
          simp only [Pi.sub_apply, Matrix.mulVec, dotProduct, Matrix.transpose_apply,
            Matrix.map_apply, map_sub, map_sum, map_mul, hlift]
        simp only [dotProduct, map_sum, map_mul]
        refine Finset.sum_eq_zero fun i _ => ?_
        rw [hmap_vec i, lam.2 h hh, sub_self, zero_mul]
      exact fun u hu => hle hu
    let K_sat : Submodule (PadicInt ℓ) W :=
      { carrier := { u : W | ∃ k : ℕ, (((ℓ : PadicInt ℓ) ^ k) • u) ∈ K_sub }
        add_mem' := fun {u₁ u₂} ⟨k₁, hk₁⟩ ⟨k₂, hk₂⟩ =>
          ⟨k₁ + k₂, by
            rw [smul_add, pow_add, mul_comm ((ℓ : PadicInt ℓ) ^ k₁) ((ℓ : PadicInt ℓ) ^ k₂),
              mul_smul]
            refine K_sub.add_mem (K_sub.smul_mem ((ℓ : PadicInt ℓ) ^ k₂) hk₁) ?_
            rw [mul_comm, mul_smul]
            exact K_sub.smul_mem ((ℓ : PadicInt ℓ) ^ k₁) hk₂⟩
        zero_mem' := ⟨0, by simp⟩
        smul_mem' := fun c {u} ⟨k, hk⟩ => ⟨k, by rw [smul_comm]; exact K_sub.smul_mem c hk⟩ }
    have hK_le_sat : K_sub ≤ K_sat := fun u hu => ⟨0, by simpa using hu⟩
    have : IsNoetherian (PadicInt ℓ) W :=
      isNoetherian_of_isNoetherianRing_of_finite (PadicInt ℓ) W
    obtain ⟨S_sat, hS_sat⟩ := IsNoetherian.noetherian K_sat
    let k_fn : W → ℕ := fun u => if hu : u ∈ K_sat then Classical.choose hu else 0
    let N_I : ℕ := S_sat.sup k_fn
    have hNI_kill : ∀ u ∈ K_sat, (((ℓ : PadicInt ℓ) ^ N_I) • u) ∈ K_sub := by
      let K_NI : Submodule (PadicInt ℓ) W :=
        K_sub.comap (LinearMap.lsmul (PadicInt ℓ) W ((ℓ : PadicInt ℓ) ^ N_I))
      suffices hle : K_sat ≤ K_NI from fun u hu => hle hu
      rw [← hS_sat]
      refine Submodule.span_le.mpr ?_
      intro g hg
      have hg_sat : g ∈ K_sat := hS_sat ▸ Submodule.subset_span hg
      have hk_le : k_fn g ≤ N_I := Finset.le_sup hg
      have hk_spec : (((ℓ : PadicInt ℓ) ^ (k_fn g)) • g) ∈ K_sub := by
        dsimp [k_fn]
        simp only [hg_sat, ↓reduceDIte]
        exact Classical.choose_spec hg_sat
      change (((ℓ : PadicInt ℓ) ^ N_I) • g) ∈ K_sub
      have hsplit : N_I = (N_I - k_fn g) + k_fn g := (Nat.sub_add_cancel hk_le).symm
      rw [hsplit, pow_add, mul_smul]
      exact K_sub.smul_mem _ hk_spec
    let Q_sat := W ⧸ K_sat
    have : Module.IsTorsionFree (PadicInt ℓ) Q_sat := by
      apply Module.IsTorsionFree.of_smul_eq_zero
      intro c q hcq
      by_cases hc0 : c = 0
      · exact Or.inl hc0
      · right
        obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective K_sat q
        rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hcq
        have hc_eq := PadicInt.unitCoeff_spec hc0
        let u_unit : (PadicInt ℓ)ˣ := PadicInt.unitCoeff hc0
        have hpow_mem : (((ℓ : PadicInt ℓ) ^ c.valuation) • u) ∈ K_sat := by
          have h1 : (↑u_unit⁻¹ : PadicInt ℓ) • (c • u) ∈ K_sat := K_sat.smul_mem _ hcq
          have h2 : (↑u_unit⁻¹ : PadicInt ℓ) * c = (ℓ : PadicInt ℓ) ^ c.valuation := by
            conv_lhs => rw [hc_eq]
            change (↑u_unit⁻¹ : PadicInt ℓ) *
              ((↑u_unit : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ c.valuation) = _
            rw [← mul_assoc, Units.inv_mul, one_mul]
          rwa [← mul_smul, h2] at h1
        obtain ⟨k, hk⟩ := hpow_mem
        have hk' : (((ℓ : PadicInt ℓ) ^ (k + c.valuation)) • u) ∈ K_sub := by
          rwa [pow_add, mul_smul]
        exact (Submodule.Quotient.mk_eq_zero K_sat).mpr ⟨k + c.valuation, hk'⟩
    let ⟨rk_Q, b_Q⟩ := Module.basisOfFiniteTypeTorsionFree' (R := PadicInt ℓ) (M := Q_sat)
    let g_lift : Fin rk_Q → W :=
      fun j => Classical.choose (Submodule.Quotient.mk_surjective K_sat (b_Q j))
    let σ_Q : Q_sat →ₗ[PadicInt ℓ] W := b_Q.constr (PadicInt ℓ) g_lift
    have hmk_σ : K_sat.mkQ.comp σ_Q = LinearMap.id := by
      apply b_Q.ext
      intro j
      simp only [LinearMap.comp_apply, LinearMap.id_apply, σ_Q, Module.Basis.constr_basis]
      exact Classical.choose_spec (Submodule.Quotient.mk_surjective K_sat (b_Q j))
    let P_proj : W →ₗ[PadicInt ℓ] W := σ_Q.comp K_sat.mkQ
    have hP_ker : ∀ u ∈ K_sub, P_proj u = 0 := by
      intro u hu
      have h0 : K_sat.mkQ u = 0 := (Submodule.Quotient.mk_eq_zero K_sat).mpr (hK_le_sat hu)
      simp [P_proj, h0]
    have hP_diff : ∀ v : W, v - P_proj v ∈ K_sat := by
      intro v
      rw [← Submodule.Quotient.mk_eq_zero K_sat]
      change K_sat.mkQ (v - P_proj v) = 0
      rw [map_sub]
      have h1 : K_sat.mkQ (P_proj v) = K_sat.mkQ v :=
        LinearMap.congr_fun hmk_σ (K_sat.mkQ v)
      rw [h1, sub_self]
    have hUniformLiftI : ∀ (r : ℕ) (lam : ↥(invTorsSubgroup r)),
        ∃ w : ↥I_int, ∀ i : Fin N,
          PadicInt.toZModPow (r + 1) (w.1 i) = ((ℓ ^ N_I) • lam).1 i := by
      intro r lam
      let lam_tilde : W := fun i =>
        Classical.choose (ZMod.ringHom_surjective (PadicInt.toZModPow (r + 1)) (lam.1 i))
      have hlam_tilde : ∀ i : Fin N, PadicInt.toZModPow (r + 1) (lam_tilde i) = lam.1 i :=
        fun i => Classical.choose_spec (ZMod.ringHom_surjective (PadicInt.toZModPow (r + 1)) (lam.1 i))
      let φ_proj : W →ₗ[PadicInt ℓ] PadicInt ℓ :=
        { toFun := fun v => ((ℓ : PadicInt ℓ) ^ N_I) * dotProduct lam_tilde (P_proj v)
          map_add' := fun v₁ v₂ => by rw [map_add, dotProduct_add, mul_add]
          map_smul' := fun c v => by
            rw [map_smul, dotProduct_smul, smul_eq_mul, RingHom.id_apply, smul_eq_mul]
            ring }
      let w_lift : W := fun i => φ_proj (Pi.single i 1)
      have hdot_w : ∀ v : W, dotProduct w_lift v = φ_proj v := by
        intro v
        have hv_sum : v = ∑ i : Fin N, v i • Pi.single i (1 : PadicInt ℓ) := by
          ext j
          simp [Pi.single_apply]
        conv_rhs => rw [hv_sum, map_sum]
        simp only [dotProduct, w_lift, map_smul, smul_eq_mul]
        refine Finset.sum_congr rfl fun i _ => mul_comm _ _
      have hw_mem : w_lift ∈ I_int := by
        apply hOrth_I
        intro u hu
        rw [hdot_w u]
        dsimp [φ_proj]
        rw [hP_ker u hu, dotProduct_zero, mul_zero]
      refine ⟨⟨w_lift, hw_mem⟩, fun i => ?_⟩
      let e_i : W := Pi.single i 1
      have hdiff_mem : (((ℓ : PadicInt ℓ) ^ N_I) • (e_i - P_proj e_i)) ∈ K_sub :=
        hNI_kill _ (hP_diff e_i)
      have hann := hMod_ann r lam lam_tilde hlam_tilde _ hdiff_mem
      have hdot_diff : dotProduct lam_tilde (((ℓ : PadicInt ℓ) ^ N_I) • (e_i - P_proj e_i)) =
          ((ℓ : PadicInt ℓ) ^ N_I) * lam_tilde i - w_lift i := by
        rw [smul_sub, dotProduct_sub, dotProduct_smul, dotProduct_smul, smul_eq_mul, smul_eq_mul]
        have hdot_ei : dotProduct lam_tilde e_i = lam_tilde i := by
          simp [e_i, dotProduct, Pi.single_apply]
        rw [hdot_ei]
        rfl
      rw [hdot_diff, map_sub] at hann
      have heq := (sub_eq_zero.mp hann).symm
      rw [heq, map_mul, map_pow, map_natCast, hlam_tilde i]
      change ((ℓ : ZMod (ℓ ^ (r + 1))) ^ N_I) * lam.1 i = (ℓ ^ N_I) • lam.1 i
      rw [nsmul_eq_mul, Nat.cast_pow]
    have hInj_right : Function.Injective B_coinv.flip := by
      rw [injective_iff_map_eq_zero]
      intro z hz0
      have hB_int_zero : ∀ w : ↥I_int, B_int w z = 0 := by
        intro w
        let φ_w : (Fin N → Padic ℓ) →ₗ[Padic ℓ] Padic ℓ :=
          ∑ i : Fin N, algebraMap (PadicInt ℓ) (Padic ℓ) (w.1 i) • LinearMap.proj i
        have hvec_φ : vecOf φ_w = fun i => algebraMap (PadicInt ℓ) (Padic ℓ) (w.1 i) := by
          ext j
          simp [vecOf, φ_w, Pi.single_apply]
        have hφ_mem : φ_w ∈ WeilSymplecticLinInvDual ℓ N H_geom := by
          intro h hh
          apply hvecOf_inj
          rw [hvec_comp_mat, hvec_φ]
          ext i
          have hwi := congrFun (w.2 h hh) i
          simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply,
            Matrix.map_apply] at hwi ⊢
          simpa only [map_sum, map_mul] using
            congrArg (algebraMap (PadicInt ℓ) (Padic ℓ)) hwi
        let ψ_w : U₁ := ⟨φ_w, hφ_mem⟩
        have hw_scale : ∀ i : Fin N,
            algebraMap (PadicInt ℓ) (Padic ℓ) (w.1 i) = ((ℓ : Padic ℓ) ^ 0) * vecOf ψ_w.1 i := by
          intro i
          rw [pow_zero, one_mul]
          exact (congrFun hvec_φ i).symm
        have heval := LinearMap.congr_fun (hB_coinv_eval ψ_w 0 w hw_scale) z
        simp only [pow_zero, inv_one, one_smul] at heval
        rw [← heval]
        exact LinearMap.congr_fun hz0 ψ_w
      obtain ⟨m, hm, x, hx⟩ := hClearTP (equiv.symm z)
      have hm_z : m • z = equiv (TensorProduct.tmul ℤ (1 : ℚ) x) := by
        rw [← equiv.apply_symm_apply (m • z), map_nsmul, hx]
      have hNI_x : (ℓ ^ N_I) • x = 0 := by
        apply Subtype.ext; ext r
        change (ℓ ^ N_I) • x.1 r = 0
        apply hRight r
        intro lam
        obtain ⟨w, hw⟩ := hUniformLiftI r lam
        have hred : redInv r w = (ℓ ^ N_I) • lam := by
          apply Subtype.ext; ext i; exact hw i
        have hBx : algebraMap (PadicInt ℓ) (Padic ℓ) (β w x) = 0 := by
          rw [← hB_int_tmul w x, ← hm_z, map_nsmul (B_int w) m z, hB_int_zero w, nsmul_zero]
        have hβ0 : β w x = 0 := hcoe_inj (hBx.trans (map_zero _).symm)
        have hp0 : pair r (redInv r w) (x.1 r) = 0 := by
          rw [← hβ_spec w x r, hβ0, map_zero]
        rw [hred, map_nsmul, AddMonoidHom.nsmul_apply, ← map_nsmul] at hp0
        exact hp0
      have htmul0 : TensorProduct.tmul ℤ (1 : ℚ) x = 0 := by
        let M_pow : ℕ := ℓ ^ N_I
        have hN_ne : (M_pow : ℚ) ≠ 0 :=
          Nat.cast_ne_zero.mpr (pow_ne_zero N_I hPrime.ne_zero)
        have h1 : (1 : ℚ) = ((M_pow : ℤ) • ((M_pow : ℚ)⁻¹)) := by
          rw [zsmul_eq_mul, Int.cast_natCast, mul_inv_cancel₀ hN_ne]
        rw [h1, TensorProduct.smul_tmul, natCast_zsmul]
        change TensorProduct.tmul ℤ ((M_pow : ℚ)⁻¹) ((ℓ ^ N_I) • x) = 0
        rw [hNI_x, TensorProduct.tmul_zero]
      have hmz0 : (m : Padic ℓ) • z = 0 := by
        rw [Nat.cast_smul_eq_nsmul (Padic ℓ) m z, hm_z, htmul0, map_zero]
      have hm_ne : (m : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      exact (smul_eq_zero.mp hmz0).resolve_left hm_ne
    have : FiniteDimensional (Padic ℓ) U₁ := inferInstance
    have : FiniteDimensional (Padic ℓ) (Module.Dual (Padic ℓ) V) := inferInstance
    have : FiniteDimensional (Padic ℓ) (Module.Dual (Padic ℓ) U₁) := inferInstance
    have hle1 : Module.finrank (Padic ℓ) U₁ ≤ Module.finrank (Padic ℓ) (Module.Dual (Padic ℓ) V) :=
      LinearMap.finrank_le_finrank_of_injective hInj_left
    have hle2 : Module.finrank (Padic ℓ) V ≤ Module.finrank (Padic ℓ) (Module.Dual (Padic ℓ) U₁) :=
      LinearMap.finrank_le_finrank_of_injective hInj_right
    rw [Subspace.dual_finrank_eq] at hle1 hle2
    have hfin_eq : Module.finrank (Padic ℓ) U₁ =
        Module.finrank (Padic ℓ) (Module.Dual (Padic ℓ) V) := by
      rw [Subspace.dual_finrank_eq]
      exact le_antisymm hle1 hle2
    have hSurj : Function.Surjective B_coinv :=
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfin_eq).mp hInj_left
    exact ⟨B_coinv, ⟨hInj_left, hSurj⟩, hFrob_eq⟩

  
  have hMakeHomBij : ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥S₀]
