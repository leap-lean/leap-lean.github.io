    have : Finite ↥(LinearMap.ker M.δ₀) := hFinH.1
    let n₀b := Nat.card ↥(LinearMap.ker M.δ₀)
    let eH0 : Fin n₀b ≃ ↥(LinearMap.ker M.δ₀) := (Finite.equivFin ↥(LinearMap.ker M.δ₀)).symm
    let m₀ := n₀a + n₀b
    let e0_idx : Fin m₀ ≃ Fin n₀a ⊕ Fin n₀b := finSumFinEquiv.symm
    let d₀ : (Fin m₀ → R) →ₗ[R] (Fin m₁ → R) :=
      linOfVec (Sum.elim (fun i => (eK1 i).1) (fun _ => 0) ∘ e0_idx)
    let γ₀ : (Fin m₀ → R) →ₗ[R] M.M₀ :=
      linOfVec (Sum.elim w0a (fun l => (eH0 l).1) ∘ e0_idx)
    have h_d₁_d₀ : d₁.comp d₀ = 0 := by
      apply h_pi_ext
      intro j
      simp only [LinearMap.comp_apply, LinearMap.zero_apply, d₀, h_linOfVec_single,
        Function.comp_apply]
      rcases h_eq : e0_idx j with i | l
      · simp [Sum.elim_inl, (eK1 i).2.1]
      · simp [Sum.elim_inr]
    have h_δ₀_γ₀ : M.δ₀.comp γ₀ = γ₁.comp d₀ := by
      apply h_pi_ext
      intro j
      simp only [LinearMap.comp_apply, d₀, γ₀, h_linOfVec_single, Function.comp_apply]
      rcases h_eq : e0_idx j with i | l
      · simp [Sum.elim_inl, hw0a i]
      · simp [Sum.elim_inr]
    have hCone0_raw : ∀ (y₀ : M.M₀) (q₁ : Fin m₁ → R), M.δ₀ y₀ + γ₁ q₁ = 0 → d₁ q₁ = 0 →
