        have hrhs : (s_sch ≫ (Fgt.map (u_can (σ_g W g))).left) ≫ snd₁ (obj_WV (obj_WV W)) =
            s_sch ≫ snd₁ (obj_WV W) :=
          (CategoryTheory.Category.assoc _ _ _).trans
            (congrArg (s_sch ≫ ·) (hu_snd (σ_g W g)))
