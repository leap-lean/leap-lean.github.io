      have h1 := congrArg
        (fun z => (CategoryTheory.Abelian.Ext.mk₀ e_one.inv).comp z (Nat.zero_add 1)) hw
      rw [← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ e_one.inv)
          (CategoryTheory.Abelian.Ext.mk₀ e_one.hom) _
          (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        e_one.inv_hom_id,
        CategoryTheory.Abelian.Ext.mk₀_id_comp,
        CategoryTheory.Abelian.Ext.comp_zero] at h1
