theorem weil_etale_unit_locallyConstant_and_irreducible_collar_descent (S : AlgebraicGeometry.Scheme.{u}) :
    let J := S.smallEtaleTopology
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
    (∀ m : ℕ,
      let R := ULift.{u, 0} (ZMod m)
      let oneR := weilEtaleModuleUnit S m
      let η_sh := (CategoryTheory.sheafificationAdjunction J (ModuleCat.{u, u} R)).unit.app
        ((CategoryTheory.Functor.const (Opposite S.Etale)).obj (ModuleCat.of R R))
      ∃ ev_lc : ∀ W : S.Etale,
          ↑(oneR.obj.obj (Opposite.op W)) ≃ₗ[R] LocallyConstant ↥((Fgt.obj W).left) R,
        (∀ {W₁ W₂ : S.Etale} (u : Quiver.Hom W₁ W₂)
            (s : ↑(oneR.obj.obj (Opposite.op W₂))) (z : ↥((Fgt.obj W₁).left)),
          ev_lc W₁ ((oneR.obj.map (Opposite.op u)).hom s) z =
            ev_lc W₂ s (((Fgt.map u).left).base z)) ∧
        (∀ (W : S.Etale) (r : R) (z : ↥((Fgt.obj W).left)),
