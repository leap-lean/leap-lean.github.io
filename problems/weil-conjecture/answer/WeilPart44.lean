  refine ⟨hC1, hC2, hC3, α, ?_, ?_, ?_, ?_⟩
  · 
    intro r
    have hbij_η : Function.Bijective (η_α r) := (hη_spec r).1.comp (invEquiv r).bijective
    have hbij_adj : Function.Bijective
        (adj_pr.homEquiv (𝒥₀ r) (weilEtaleTorsionSheaf S (ℓ ^ (r + 1)))).symm :=
      (adj_pr.homEquiv _ _).symm.bijective
