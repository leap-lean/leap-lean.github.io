          have hpow2_ne : ((ℓ : Padic ℓ) ^ k₂) ≠ 0 := pow_ne_zero k₂ hℓ_K_ne
          ext v
          simp only [LinearMap.add_apply, LinearMap.smul_apply, smul_eq_mul, pow_add, mul_inv]
          have hc1 : (((ℓ : Padic ℓ) ^ k₁)⁻¹ * ((ℓ : Padic ℓ) ^ k₂)⁻¹) *
              (((ℓ : Padic ℓ) ^ k₂) * B_int w₁ v) = (((ℓ : Padic ℓ) ^ k₁)⁻¹) * B_int w₁ v := by
            calc (((ℓ : Padic ℓ) ^ k₁)⁻¹ * ((ℓ : Padic ℓ) ^ k₂)⁻¹) *
