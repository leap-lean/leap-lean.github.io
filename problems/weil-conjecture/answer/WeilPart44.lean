  | succ k ih =>
    intro 𝒢
    obtain ⟨ℐ, 𝒬, i_𝒢, p_𝒢, h0_𝒢, hInj_ℐ, hS_𝒢⟩ := mkInjSES 𝒢
    let S_𝒢 := CategoryTheory.ShortComplex.mk i_𝒢 p_𝒢 h0_𝒢
