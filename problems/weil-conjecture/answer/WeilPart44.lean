  let invEquiv : ∀ r : ℕ,
      { lam : Fin N → ZMod (ℓ ^ (r + 1)) //
        ∀ h ∈ H_geom,
          (((h.val).map (PadicInt.toZModPow (r + 1))).transpose).mulVec lam = lam } ≃
