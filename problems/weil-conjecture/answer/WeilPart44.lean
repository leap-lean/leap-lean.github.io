    let equivΦ₀ : (oneR ⟶ 𝒢) ≃ (Fℤ ⟶ (U_mod m).obj 𝒢) :=
      eqDom.trans eqCod.symm
    have hΦ₀_apply : ∀ φ : oneR ⟶ 𝒢, Φ₀ φ = equivΦ₀ φ := by
      intro φ
      apply eqCod.injective
      rw [hΦ₀_eq]
      exact (eqCod.apply_symm_apply (eqDom φ)).symm
    let mk0Dom := Equiv.ofBijective CategoryTheory.Abelian.Ext.mk₀
      (CategoryTheory.Abelian.Ext.mk₀_bijective oneR 𝒢)
    let mk0Cod := Equiv.ofBijective CategoryTheory.Abelian.Ext.mk₀
      (CategoryTheory.Abelian.Ext.mk₀_bijective Fℤ ((U_mod m).obj 𝒢))
    let eTarget : CategoryTheory.Abelian.Ext.{u} oneR 𝒢 0 ≃
