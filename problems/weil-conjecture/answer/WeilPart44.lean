      have hp_eq : (oneR.obj.map (Opposite.op p_W)).hom ((ε_tr.hom.app (Opposite.op W)).hom s) =
          Finset.univ.sum (fun i : Fin M =>
            (oneR.obj.map (Opposite.op δ_W_et)).hom
              (triv_R oneR (obj_WV W) (triv_T (R_sh.obj oneR) W s_R i) i)) :=
        (congrArg (oneR.obj.map (Opposite.op p_W)).hom hε_eq).trans (hCounit_diag oneR W s_R)
