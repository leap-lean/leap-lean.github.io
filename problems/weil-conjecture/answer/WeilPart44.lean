          change (((ℓ : Padic ℓ) ^ (Classical.choose (hLiftΨ (c • ψ))))⁻¹) •
              B_int (Classical.choose (Classical.choose_spec (hLiftΨ (c • ψ)))) = _
          rw [heq_sc, heq₁]
