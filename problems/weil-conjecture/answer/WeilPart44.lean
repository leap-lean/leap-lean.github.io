    letI : Algebra C₀ A₁ := hAlg_C₀A₁
    letI : Algebra ↥E₁ A₁ := hAlg_E₁A₁
    haveI : IsScalarTower F C₀ A₁ := hST_FC₀A₁
    haveI : IsScalarTower F ↥E₁ A₁ := hST_FE₁A₁
    haveI : Algebra.Etale C₀ A₁ := hEt_C₀A₁
    let v_aff : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A)) (Fgt.obj Z).left :=
      v_aff_raw
    have hv_et : AlgebraicGeometry.Etale v_aff := hv_et_raw
    letI : AlgebraicGeometry.Etale v_aff := hv_et
    letI : AlgebraicGeometry.Etale (Fgt.obj Z).hom := Z.prop
    let Z' : S_bar.Etale :=
      AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.comp v_aff (Fgt.obj Z).hom)
    let v : Quiver.Hom Z' Z := CategoryTheory.MorphismProperty.Over.homMk v_aff rfl trivial
    let inc_A₁ : A₁ →+* A :=
      { toFun := fun a₁ => e_A1 (TensorProduct.tmul ↥E₁ a₁ 1)
        map_one' := e_A1.map_one
        map_mul' := fun x y => by
          have hmul : TensorProduct.tmul ↥E₁ (x * y) (1 : k) =
              TensorProduct.tmul ↥E₁ x 1 * TensorProduct.tmul ↥E₁ y 1 := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
          rw [hmul, map_mul]
        map_zero' := by rw [TensorProduct.zero_tmul, map_zero]
        map_add' := fun x y => by rw [TensorProduct.add_tmul, map_add] }
    obtain ⟨W_E₁, u₀, q_E₁, hWE₁_left, hWE₁_hom, hqE₁_fst, hv_comm⟩ :=
      hSiteSquare W₀ Z q C₀ A A₁ j_C₀ hj_et v_aff hv_et hv_prD hv_q_fst inc_A₁ he_A1_C₀
    obtain ⟨C₀_U, hCR_CU, hAlg_FCU, hAlg_C₀CU, hAlg_R₀CU, hST_FC₀CU, hST_FR₀CU, hCovPkg⟩ :=
      weil_ind_etale_affine_cover_pullback_isos F S_aff U₀ U_bar W₀ C₀ j_C₀ hj_hom
        B B_bar e_U he_U_hom q_B q_k e_Ubar heUbar_prD heUbar_prk htmalg
    letI : CommRing C₀_U := hCR_CU
    letI : Algebra F C₀_U := hAlg_FCU
    letI : Algebra C₀ C₀_U := hAlg_C₀CU
    letI : Algebra R₀ C₀_U := hAlg_R₀CU
    haveI : IsScalarTower F C₀ C₀_U := hST_FC₀CU
    haveI : IsScalarTower F R₀ C₀_U := hST_FR₀CU
    let P_bar := TensorProduct C₀ C₀_U A
    letI : CommRing P_bar := inferInstance
    let alg_Pbar_hom : R0_bar →ₐ[F] P_bar :=
      Algebra.TensorProduct.lift
        ((Algebra.TensorProduct.includeLeft : C₀_U →ₐ[C₀] P_bar).restrictScalars F
          |>.comp (IsScalarTower.toAlgHom F R₀ C₀_U))
        ((Algebra.TensorProduct.includeRight : A →ₐ[C₀] P_bar).restrictScalars F
          |>.comp (IsScalarTower.toAlgHom F k A))
        (fun _ _ => Commute.all _ _)
    letI : Algebra R0_bar P_bar := alg_Pbar_hom.toRingHom.toAlgebra
    let D_bar := TensorProduct R0_bar P_bar B_bar
    letI : CommRing D_bar := inferInstance
    letI : CommRing (TensorProduct (TensorProduct F R₀ k) (TensorProduct C₀ C₀_U A) B_bar) :=
      (inferInstance : CommRing D_bar)
    have hAlg_Pbar : ∀ (z_r : R₀) (c_k : k),
        algebraMap R0_bar P_bar (TensorProduct.tmul F z_r c_k) =
          TensorProduct.tmul C₀ (algebraMap R₀ C₀_U z_r) (algebraMap k A c_k) := by
      intro z_r c_k
      exact (Algebra.TensorProduct.lift_tmul _ _ _ z_r c_k).trans (by
        change TensorProduct.tmul C₀ (algebraMap R₀ C₀_U z_r) (1 : A) *
            TensorProduct.tmul C₀ (1 : C₀_U) (algebraMap k A c_k) = _
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul])
    obtain ⟨iso_ZV, _, hArithPkg⟩ :=
      hCovPkg A P_bar D_bar (RingEquiv.refl P_bar) hAlg_Pbar (RingEquiv.refl D_bar)
        Z' rfl (heq_of_eq hv_prD) (heq_of_eq hv_prk)
    obtain ⟨φ₀, iso_WEr, q_EV, θ_WE, hφ₀_pure, hiso_WEr_eqv,
      hqEV_fst, hqEV_snd, hθ_fst, hθ_snd, hcomp_ZV_WEr⟩ :=
      hArithPkg A₁ inc_A₁ he_A1_C₀ W_E₁ hWE₁_left hWE₁_hom q_E₁ hqE₁_fst
    let κ_E₁ : k_L →ₐ[F] ↥E₁ :=
      { toFun := fun c => ⟨κ_k c, hS_sub_E₁ (Finset.mem_image_of_mem κ_k (Finset.mem_univ c))⟩
        map_one' := Subtype.ext κ_k.map_one
        map_mul' := fun x y => Subtype.ext (κ_k.map_mul x y)
        map_zero' := Subtype.ext κ_k.map_zero
        map_add' := fun x y => Subtype.ext (κ_k.map_add x y)
        commutes' := fun f => Subtype.ext (κ_k.commutes f) }
    let P_E₁ := TensorProduct C₀ C₀_U A₁
    letI : CommRing P_E₁ := inferInstance
    letI : Algebra R₀ P_E₁ := inferInstance
    letI : Module R₀ P_E₁ := Algebra.toModule
    let R_E₁r := TensorProduct R₀ P_E₁ B
    letI : CommRing R_E₁r := inferInstance
    let alg_E₁_REr : ↥E₁ →+* R_E₁r :=
      (Algebra.TensorProduct.includeLeftRingHom : P_E₁ →+* R_E₁r).comp
        ((Algebra.TensorProduct.includeRight : A₁ →ₐ[C₀] P_E₁).toRingHom.comp
          (algebraMap ↥E₁ A₁))
    letI : Algebra ↥E₁ R_E₁r := alg_E₁_REr.toAlgebra
    letI : Module ↥E₁ R_E₁r := Algebra.toModule
    obtain ⟨ε_sheet₁, hε₁_idemp, hε₁_disj, hε₁_univ, hε₁_act,
      _, Ψ_diag_E₁, hΨ₁_pure, _⟩ :=
      weil_galois_diag_quotient_and_geom_tensor_iso F k_L ↥E₁ k C₀ C₀_U R₀ B B_bar A₁ A
        R_E₁r (RingEquiv.refl R_E₁r)
        ι_kB (fun _ => rfl) κ_E₁ κ_k (fun _ => rfl) (fun _ => rfl) hAlg_Pbar (fun _ => rfl)
        res_k hres_comm m_k equiv_Γk e_k hIdemp_k
        q_B q_k htmalg ψ_Bk hψ_Bk e_A1 he_A1_tmul he_A1_C₀ he_A1_E₁
    let C₁_E₁ := R_E₁r ⧸ Ideal.span {1 - ε_sheet₁ 1}
    let instCR_C₁ : CommRing C₁_E₁ := Ideal.Quotient.commRing (Ideal.span {1 - ε_sheet₁ 1})
    letI : CommRing C₁_E₁ := instCR_C₁
    letI : AddCommGroup C₁_E₁ := instCR_C₁.toAddCommGroup
    letI : AddCommMonoid C₁_E₁ := instCR_C₁.toAddCommMonoid
    let alg_E₁_C₁ : Algebra ↥E₁ C₁_E₁ := Ideal.Quotient.algebra ↥E₁
    letI : Algebra ↥E₁ C₁_E₁ := alg_E₁_C₁
    letI : Module ↥E₁ C₁_E₁ := alg_E₁_C₁.toModule
    letI : Module ↥E₁ (R_E₁r ⧸ Ideal.span {1 - ε_sheet₁ 1}) :=
      (Ideal.Quotient.algebra ↥E₁).toModule
    letI : CommRing (TensorProduct ↥E₁ C₁_E₁ k) := inferInstance
    letI : CommRing (TensorProduct ↥E₁ (R_E₁r ⧸ Ideal.span {1 - ε_sheet₁ 1}) k) :=
      (inferInstance : CommRing (TensorProduct ↥E₁ C₁_E₁ k))
    let q₁_E₁ : R_E₁r →ₐ[↥E₁] C₁_E₁ := Ideal.Quotient.mkₐ ↥E₁ (Ideal.span {1 - ε_sheet₁ 1})
    let inc_Ck₁ : C₁_E₁ →+* TensorProduct ↥E₁ C₁_E₁ k :=
      Algebra.TensorProduct.includeLeftRingHom
    let s₀' : ↑(ℱ₀_r.obj.obj (Opposite.op W_E₁)) := (ℱ₀_r.obj.map (Opposite.op u₀)).hom s₀
    have hZ'_zero : (ℳ_ab_r.obj.map (Opposite.op q_E₁)).hom
        ((η_r.hom.app (Opposite.op W_E₁)).hom s₀') = 0 := by
      have hnat : (η_r.hom.app (Opposite.op W_E₁)).hom s₀' =
          (ℳ_ab_r.obj.map (Opposite.op (B_pr.map u₀))).hom
            ((η_r.hom.app (Opposite.op W₀)).hom s₀) :=
        congrArg (fun f => f.hom s₀) (η_r.hom.naturality (Opposite.op u₀))
      have hcomp_op : (ℳ_ab_r.obj.map (Opposite.op (q_E₁ ≫ B_pr.map u₀))).hom
          ((η_r.hom.app (Opposite.op W₀)).hom s₀) =
          (ℳ_ab_r.obj.map (Opposite.op q_E₁)).hom
            ((ℳ_ab_r.obj.map (Opposite.op (B_pr.map u₀))).hom
              ((η_r.hom.app (Opposite.op W₀)).hom s₀)) :=
        congrArg (fun g => g.hom ((η_r.hom.app (Opposite.op W₀)).hom s₀))
          (ℳ_ab_r.obj.map_comp (Opposite.op (B_pr.map u₀)) (Opposite.op q_E₁))
      have hcomp_v : (ℳ_ab_r.obj.map (Opposite.op (v ≫ q))).hom
          ((η_r.hom.app (Opposite.op W₀)).hom s₀) =
          (ℳ_ab_r.obj.map (Opposite.op v)).hom
            ((ℳ_ab_r.obj.map (Opposite.op q)).hom
              ((η_r.hom.app (Opposite.op W₀)).hom s₀)) :=
        congrArg (fun g => g.hom ((η_r.hom.app (Opposite.op W₀)).hom s₀))
          (ℳ_ab_r.obj.map_comp (Opposite.op q) (Opposite.op v))
      have hv_eq : (ℳ_ab_r.obj.map (Opposite.op (q_E₁ ≫ B_pr.map u₀))).hom
          ((η_r.hom.app (Opposite.op W₀)).hom s₀) =
          (ℳ_ab_r.obj.map (Opposite.op (v ≫ q))).hom
            ((η_r.hom.app (Opposite.op W₀)).hom s₀) :=
        congrArg (fun f : Z' ⟶ B_pr.obj W₀ =>
          (ℳ_ab_r.obj.map (Opposite.op f)).hom ((η_r.hom.app (Opposite.op W₀)).hom s₀))
          hv_comm.symm
      exact (congrArg ((ℳ_ab_r.obj.map (Opposite.op q_E₁)).hom) hnat).trans
        (hcomp_op.symm.trans (hv_eq.trans (hcomp_v.trans
          ((congrArg ((ℳ_ab_r.obj.map (Opposite.op v)).hom) hq_zero).trans
            (map_zero _)))))
    let f₀ : LocallyConstant (PrimeSpectrum R_E₁r) (Fin M → ZMod m_mod) :=
      ⟨fun p => triv₀_r (B_j.obj W_E₁) s₀' (iso_WEr.hom.base p),
        (triv₀_r (B_j.obj W_E₁) s₀').isLocallyConstant.comp_continuous
          (AlgebraicGeometry.Scheme.Hom.continuous iso_WEr.hom)⟩
    let τ_E₁ : (B ≃ₐ[R₀] B) → (R_E₁r →ₐ[↥E₁] R_E₁r) := fun σ =>
      { toRingHom := (Algebra.TensorProduct.map (AlgHom.id R₀ P_E₁) σ.symm.toAlgHom).toRingHom
        commutes' := fun e₁ => by
          change (Algebra.TensorProduct.map (AlgHom.id R₀ P_E₁) σ.symm.toAlgHom)
            (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ 1 (algebraMap ↥E₁ A₁ e₁)) 1) =
            TensorProduct.tmul R₀ (TensorProduct.tmul C₀ 1 (algebraMap ↥E₁ A₁ e₁)) 1
          simp }
    have hτ_one₁ : ∀ u_r : R_E₁r, τ_E₁ 1 u_r = u_r :=
      fun u_r => hREr_ext (τ_E₁ 1).toRingHom (RingHom.id R_E₁r) (fun _ _ _ => rfl) u_r
    have hτ_mul₁ : ∀ (g₁ g₂ : B ≃ₐ[R₀] B) (u_r : R_E₁r),
        τ_E₁ (g₂ * g₁) u_r = τ_E₁ g₁ (τ_E₁ g₂ u_r) :=
      fun g₁ g₂ u_r => hREr_ext (τ_E₁ (g₂ * g₁)).toRingHom
        ((τ_E₁ g₁).toRingHom.comp (τ_E₁ g₂).toRingHom) (fun _ _ _ => rfl) u_r
    have hf₀_eqv : ∀ (σ : B ≃ₐ[R₀] B) (p : PrimeSpectrum R_E₁r),
        f₀ (PrimeSpectrum.comap (τ_E₁ σ).toRingHom p) = ((ρ_r σ).val).mulVec (f₀ p) := by
      intro σ p
      let h_WE₁_U := (Fgt_U.obj (B_j.obj W_E₁)).hom
      obtain ⟨m_σ, ⟨hmσ_fst, hmσ_snd⟩, _⟩ := (hTors_B _ h_WE₁_U).2.1 σ
      have hiso_mσ := hiso_WEr_eqv σ m_σ hmσ_fst hmσ_snd
      have hbase_mσ : iso_WEr.hom.base (PrimeSpectrum.comap (τ_E₁ σ).toRingHom p) =
          m_σ.base (iso_WEr.hom.base p) := by
        change ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ_E₁ σ).toRingHom) ≫
          iso_WEr.hom).base) p = ((iso_WEr.hom ≫ m_σ).base) p
        rw [hiso_mσ]
      have hs₀'_mem : triv₀_r (B_j.obj W_E₁) s₀' ∈ Set.range (triv₀_r (B_j.obj W_E₁)) :=
        ⟨s₀', rfl⟩
      rw [(htriv₀_r.2 (B_j.obj W_E₁)).2] at hs₀'_mem
      change triv₀_r (B_j.obj W_E₁) s₀'
          (iso_WEr.hom.base (PrimeSpectrum.comap (τ_E₁ σ).toRingHom p)) =
        ((ρ_r σ).val).mulVec (triv₀_r (B_j.obj W_E₁) s₀' (iso_WEr.hom.base p))
      rw [hbase_mσ]
      exact hs₀'_mem σ m_σ hmσ_fst hmσ_snd (iso_WEr.hom.base p)
    have hφ₀_eq : φ₀ = Ψ_diag_E₁.toRingHom.comp (inc_Ck₁.comp q₁_E₁.toRingHom) := by
      apply RingHom.ext
      intro u_r
      refine hREr_ext φ₀ (Ψ_diag_E₁.toRingHom.comp (inc_Ck₁.comp q₁_E₁.toRingHom)) ?_ u_r
      intro c_U a₁ b
      rw [hφ₀_pure]
      exact (hΨ₁_pure c_U a₁ b 1).symm
    have hf₀_vanish : ∀ y : PrimeSpectrum (TensorProduct ↥E₁ C₁_E₁ k),
        f₀ (PrimeSpectrum.comap q₁_E₁.toRingHom (PrimeSpectrum.comap inc_Ck₁ y)) = 0 := by
      intro y
      let d_pt : PrimeSpectrum _ := PrimeSpectrum.comap Ψ_diag_E₁.symm.toRingHom y
      have hcomap_φ₀ : PrimeSpectrum.comap q₁_E₁.toRingHom (PrimeSpectrum.comap inc_Ck₁ y) =
          PrimeSpectrum.comap φ₀ d_pt := by
        rw [hφ₀_eq]
        ext u_r
        change inc_Ck₁ (q₁_E₁ u_r) ∈ y.asIdeal ↔
          Ψ_diag_E₁.symm (Ψ_diag_E₁ (inc_Ck₁ (q₁_E₁ u_r))) ∈ y.asIdeal
        rw [Ψ_diag_E₁.symm_apply_apply]
      have hpt_comp : iso_WEr.hom.base (PrimeSpectrum.comap φ₀ d_pt) =
          θ_WE.base (q_EV.base (iso_ZV.hom.base d_pt)) := by
        change ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ iso_WEr.hom).base) d_pt =
          ((iso_ZV.hom ≫ (q_EV ≫ θ_WE)).base) d_pt
        rw [hcomp_ZV_WEr]
      have h1 := hη_r W_E₁ s₀' θ_WE hθ_fst hθ_snd (q_EV.base (iso_ZV.hom.base d_pt))
      have h2 := htriv_ab_r.1 q_E₁ q_EV hqEV_fst hqEV_snd
        ((η_r.hom.app (Opposite.op W_E₁)).hom s₀') (iso_ZV.hom.base d_pt)
      have hzero_triv : triv_ab_r Z'
          ((ℳ_ab_r.obj.map (Opposite.op q_E₁)).hom ((η_r.hom.app (Opposite.op W_E₁)).hom s₀'))
          (iso_ZV.hom.base d_pt) = 0 := by
        have hz0 : triv_ab_r Z'
            ((ℳ_ab_r.obj.map (Opposite.op q_E₁)).hom ((η_r.hom.app (Opposite.op W_E₁)).hom s₀')) = 0 :=
          (congrArg (triv_ab_r Z') hZ'_zero).trans (triv_ab_r Z').map_zero
        exact congrArg (fun g => g (iso_ZV.hom.base d_pt)) hz0
      exact (congrArg f₀ hcomap_φ₀).trans
        ((congrArg (triv₀_r (B_j.obj W_E₁) s₀') hpt_comp).trans
          (h1.symm.trans (h2.symm.trans hzero_triv)))
    have hf₀_zero : f₀ = 0 :=
      (hDescentLift ↥E₁ R_E₁r (B ≃ₐ[R₀] B) (k_L ≃ₐ[F] k_L) res_k hres_surj ρ_r
        τ_E₁ hτ_one₁ hτ_mul₁ ε_sheet₁ hε₁_idemp hε₁_disj hε₁_univ hε₁_act).1
        f₀ hf₀_eqv hf₀_vanish
    refine ⟨Z', v, z', W_E₁, u₀, q_E₁, hv_et, hv_pt, hv_comm, ?_⟩
    apply (htriv₀_r.2 (B_j.obj W_E₁)).1
    refine (?_ : triv₀_r (B_j.obj W_E₁) s₀' = 0).trans (triv₀_r (B_j.obj W_E₁)).map_zero.symm
    ext w i
    have hw : w = iso_WEr.hom.base (iso_WEr.inv.base w) :=
      congrArg (fun f => f.base w) iso_WEr.inv_hom_id.symm
    exact (congrFun (congrArg (triv₀_r (B_j.obj W_E₁) s₀') hw) i).trans
      (congrFun (congrArg (fun g : LocallyConstant _ _ => g (iso_WEr.inv.base w)) hf₀_zero) i)

theorem weil_mid_ext_frob_gauge_and_ext_intertwining (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (U_bar : (weilGeomScheme F (weilProjectiveSpaceOver F 1)).Opens)
    (m_mod M : ℕ)
    (F_u_mod : Matrix (Fin M) (Fin M) (ZMod m_mod))
    (B B_bar : Type u) [CommRing B] [CommRing B_bar]
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) B]
    [Algebra (TensorProduct F
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
      (AlgebraicClosure F)) B_bar]
    (ρ_r :
      (B ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B) →*
        (Matrix (Fin M) (Fin M) (ZMod m_mod))ˣ)
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U₀.toScheme)
    (σ_u_r :
      B ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B)
    (hσu_mod : (ρ_r σ_u_r).val = F_u_mod)
    (q_B : B →+* B_bar) (q_k : AlgebraicClosure F →+* B_bar)
    (φ_equiv_r : B_bar ≃+* B_bar)
    (e_Ubar : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (TensorProduct F
          (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
          (AlgebraicClosure F))))
      U_bar.toScheme)
    (hFrob_rel :
      let D₀ := weilProjectiveSpaceOver F 1
      let S_bar := weilGeomScheme F D₀
      let k := AlgebraicClosure F
      let f_ext := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
      let pr_D := CategoryTheory.Limits.pullback.fst D₀.hom f_ext
      let pr_k := CategoryTheory.Limits.pullback.snd D₀.hom f_ext
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      let R0_bar := TensorProduct F R₀ k
      let ψ_frob := (@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) k _ _ _).symm
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp e_Ubar.hom U_bar.ι) pr_D =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeLeft : R₀ →ₐ[F] R0_bar).toRingHom))
          (CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι) ∧
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp e_Ubar.hom U_bar.ι) pr_k =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : k →ₐ[F] R0_bar).toRingHom) ∧
      (∀ (z : R₀) (c : k),
        algebraMap R0_bar B_bar (TensorProduct.tmul F z c) =
          q_B (algebraMap R₀ B z) * q_k c) ∧
      (∀ b : B, φ_equiv_r (q_B b) = q_B (σ_u_r b)) ∧
      (∀ c : k, φ_equiv_r (q_k c) = q_k (ψ_frob c)))
    (hCont_j : (weilEtaleSitePullback U₀.ι).IsContinuous
      (weilProjectiveSpaceOver F 1).left.smallEtaleTopology U₀.toScheme.smallEtaleTopology)
    (ℒ₀_r : CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
    (Θ_j_r : CategoryTheory.Iso
      ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback U₀.ι) AddCommGrpCat.{u} _
        (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
        U₀.toScheme.smallEtaleTopology hCont_j).obj ℒ₀_r)
