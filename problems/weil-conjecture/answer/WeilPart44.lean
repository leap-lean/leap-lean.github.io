      obtain ⟨P_mod, hP_mod⟩ := hLiftTorsionSheaf P_bar hm_Pbar
      obtain ⟨ι_mod, hι_mod⟩ := hUFull (eqToHom hK'_mod ≫ ι_bar ≫ eqToHom hP_mod.symm)
      have : CategoryTheory.Mono ι_mod := by
        refine ⟨fun {Z} k₁ k₂ hk => hUFaith ?_⟩
        have hmap : U.map k₁ ≫ U.map ι_mod = U.map k₂ ≫ U.map ι_mod := by
          rw [← U.map_comp, hk, U.map_comp]
        rw [hι_mod] at hmap
        exact (CategoryTheory.cancel_mono (eqToHom hK'_mod ≫ ι_bar ≫ eqToHom hP_mod.symm)).mp hmap
      let g₀_bar : K'_bar ⟶ Y :=
        CategoryTheory.Limits.cokernel.desc (m • 𝟙 SC.X₁) g₀ (by
          calc
            (m • 𝟙 SC.X₁) ≫ g₀ = g₀ ≫ (m • 𝟙 Y) := by simp
            _ = 0 := by rw [hmY, CategoryTheory.Limits.comp_zero])
      have hg₀_bar : pK' ≫ g₀_bar = g₀ := CategoryTheory.Limits.cokernel.π_desc _ _ _
      obtain ⟨g₀_mod, hg₀_mod⟩ := hUFull (eqToHom hK'_mod ≫ g₀_bar)
      let h_mod : P_mod ⟶ ℐ := CategoryTheory.Injective.factorThru g₀_mod ι_mod
      have hh_mod : ι_mod ≫ h_mod = g₀_mod := CategoryTheory.Injective.comp_factorThru g₀_mod ι_mod
      refine ⟨pP ≫ eqToHom hP_mod.symm ≫ U.map h_mod, ?_⟩
      rw [← CategoryTheory.Category.assoc, ← hp_comm, CategoryTheory.Category.assoc]
      have hmid : ι_bar ≫ eqToHom hP_mod.symm ≫ U.map h_mod = g₀_bar := by
        rw [← CategoryTheory.cancel_epi (eqToHom hK'_mod)]
        calc
          eqToHom hK'_mod ≫ ι_bar ≫ eqToHom hP_mod.symm ≫ U.map h_mod
            = (eqToHom hK'_mod ≫ ι_bar ≫ eqToHom hP_mod.symm) ≫ U.map h_mod := by
                simp [CategoryTheory.Category.assoc]
          _ = U.map ι_mod ≫ U.map h_mod := by rw [hι_mod]
          _ = U.map (ι_mod ≫ h_mod) := (U.map_comp _ _).symm
          _ = eqToHom hK'_mod ≫ g₀_bar := by rw [hh_mod, hg₀_mod]
      rw [hmid, hg₀_bar]
    let R_Y := CategoryTheory.InjectiveResolution.of Y
    have hPullCocycle : ∀ (q : ℕ) (K : CategoryTheory.Sheaf J AddCommGrpCat.{u})
        (f : K ⟶ R_Y.cocomplex.X (q + 1)),
        f ≫ R_Y.cocomplex.d (q + 1) (q + 2) = 0 →
        ∃ (P : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (π : P ⟶ K)
          (g : P ⟶ R_Y.cocomplex.X q),
          isTF P ∧ CategoryTheory.Epi π ∧ g ≫ R_Y.cocomplex.d q (q + 1) = π ≫ f := by
      intro q K f hf
      let S_q := CategoryTheory.ShortComplex.mk
        (R_Y.cocomplex.d q (q + 1)) (R_Y.cocomplex.d (q + 1) (q + 2))
        (R_Y.cocomplex.d_comp_d q (q + 1) (q + 2))
      have hex_q : S_q.Exact := R_Y.exact_succ q
      have : CategoryTheory.Epi S_q.toCycles :=
        (CategoryTheory.ShortComplex.exact_iff_epi_toCycles S_q).mp hex_q
      let lift_f : K ⟶ S_q.cycles := S_q.liftCycles f hf
      let E_pb := CategoryTheory.Limits.pullback S_q.toCycles lift_f
      let p₁ : E_pb ⟶ R_Y.cocomplex.X q := CategoryTheory.Limits.pullback.fst S_q.toCycles lift_f
      let p₂ : E_pb ⟶ K := CategoryTheory.Limits.pullback.snd S_q.toCycles lift_f
      have : CategoryTheory.Epi p₂ :=
        CategoryTheory.Abelian.epi_pullback_of_epi_f S_q.toCycles lift_f
      obtain ⟨P, q_cov, hTF_P, hEpi_q⟩ := hCover E_pb
      let π : P ⟶ K := q_cov ≫ p₂
      have : CategoryTheory.Epi π := CategoryTheory.epi_comp q_cov p₂
      refine ⟨P, π, q_cov ≫ p₁, hTF_P, inferInstance, ?_⟩
      have hpb : p₁ ≫ S_q.toCycles = p₂ ≫ lift_f := CategoryTheory.Limits.pullback.condition
      have hpb_i : p₁ ≫ R_Y.cocomplex.d q (q + 1) = p₂ ≫ f := by
        have h1 := hpb =≫ S_q.iCycles
        simpa [S_q, lift_f] using h1
      rw [CategoryTheory.Category.assoc, hpb_i, CategoryTheory.Category.assoc]
    have hVanish : ∀ (p_idx : ℕ) (K : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        isTF K →
        ∀ (e_K : CategoryTheory.Abelian.Ext.{u} K Y (p_idx + 1)), e_K = 0 := by
      intro p_idx
      induction p_idx with
      | zero =>
        intro K hTF_K e_K
        let I₀ := CategoryTheory.Injective.under Y
        let i_Y : Y ⟶ I₀ := CategoryTheory.Injective.ι Y
        let Q₀ := CategoryTheory.Limits.cokernel i_Y
        let p_Y : I₀ ⟶ Q₀ := CategoryTheory.Limits.cokernel.π i_Y
        let S_Y := CategoryTheory.ShortComplex.mk i_Y p_Y
          (CategoryTheory.Limits.cokernel.condition i_Y)
        have hS_Y : S_Y.ShortExact :=
          { exact := CategoryTheory.ShortComplex.exact_cokernel i_Y }
        have he_iY : e_K.comp (CategoryTheory.Abelian.Ext.mk₀ S_Y.f) (Nat.add_zero 1) = 0 :=
          (CategoryTheory.hasInjectiveDimensionLT_iff I₀ 1).mp inferInstance 1 (le_refl 1) _
        obtain ⟨z₀, hz₀⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ K hS_Y e_K
          he_iY (Nat.zero_add 1)
        obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective K Q₀).2 z₀
        let E_pb := CategoryTheory.Limits.pullback p_Y f
        let p₁ : E_pb ⟶ I₀ := CategoryTheory.Limits.pullback.fst p_Y f
        let p₂ : E_pb ⟶ K := CategoryTheory.Limits.pullback.snd p_Y f
        have : CategoryTheory.Epi p₂ := CategoryTheory.Abelian.epi_pullback_of_epi_f p_Y f
        obtain ⟨P, q_cov, hTF_P, _⟩ := hCover E_pb
        let π : P ⟶ K := q_cov ≫ p₂
        have hEpi_π : CategoryTheory.Epi π := CategoryTheory.epi_comp q_cov p₂
        let g : P ⟶ I₀ := q_cov ≫ p₁
        have hg : g ≫ p_Y = π ≫ f := by
          dsimp [g, π]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
            CategoryTheory.Category.assoc]
        let K' := CategoryTheory.Limits.kernel π
        let ι_ker : K' ⟶ P := CategoryTheory.Limits.kernel.ι π
        let S_π := CategoryTheory.ShortComplex.mk ι_ker π
          (CategoryTheory.Limits.kernel.condition π)
        have hS_π : S_π.ShortExact :=
          { exact := CategoryTheory.ShortComplex.exact_kernel π }
        have h_ig_p : (ι_ker ≫ g) ≫ S_Y.g = 0 := by
          dsimp [S_Y]
          rw [CategoryTheory.Category.assoc, hg, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
        have : CategoryTheory.Mono S_Y.f := hS_Y.mono_f
        let g₀ : K' ⟶ Y := hS_Y.exact.lift (ι_ker ≫ g) h_ig_p
        have hg₀ : g₀ ≫ i_Y = ι_ker ≫ g := hS_Y.exact.lift_f (ι_ker ≫ g) h_ig_p
        obtain ⟨h, hh⟩ := hExtend hS_π hTF_K g₀
        have hdiff_ker : ι_ker ≫ (g - h ≫ i_Y) = 0 := by
          rw [CategoryTheory.Preadditive.comp_sub, ← CategoryTheory.Category.assoc]
          change ι_ker ≫ g - (S_π.f ≫ h) ≫ i_Y = 0
          rw [hh, hg₀, sub_self]
        have : CategoryTheory.Epi S_π.g := hEpi_π
        let isCok_π := hS_π.exact.gIsCokernel
        let cofork_s := CategoryTheory.Limits.CokernelCofork.ofπ (g - h ≫ i_Y) hdiff_ker
        let s : K ⟶ I₀ := isCok_π.desc cofork_s
        have hs : π ≫ s = g - h ≫ i_Y :=
          isCok_π.fac cofork_s CategoryTheory.Limits.WalkingParallelPair.one
        have hsp : s ≫ p_Y = f := by
          have hip : i_Y ≫ p_Y = 0 := CategoryTheory.Limits.cokernel.condition i_Y
          rw [← CategoryTheory.cancel_epi π, ← CategoryTheory.Category.assoc, hs,
            CategoryTheory.Preadditive.sub_comp, CategoryTheory.Category.assoc h i_Y p_Y,
            hip, CategoryTheory.Limits.comp_zero, sub_zero, hg]
        rw [← hz₀, ← hsp, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ s p_Y,
          CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ s)
            (CategoryTheory.Abelian.Ext.mk₀ S_Y.g) hS_Y.extClass (Nat.zero_add 0)
            (Nat.zero_add 1) (Nat.zero_add 1),
          hS_Y.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      | succ p' ih =>
        intro K hTF_K e_K
        obtain ⟨f, hf, rfl⟩ := R_Y.extMk_surjective e_K (p' + 3) rfl
        obtain ⟨P, π, g, hTF_P, hEpi_π, hg⟩ := hPullCocycle (p' + 1) K f hf
        have hπf : (π ≫ f) ≫ R_Y.cocomplex.d (p' + 2) (p' + 3) = 0 := by
          rw [CategoryTheory.Category.assoc, hf, CategoryTheory.Limits.comp_zero]
        have h_pull_zero : (CategoryTheory.Abelian.Ext.mk₀ π).comp
            (R_Y.extMk f (p' + 3) rfl hf) (Nat.zero_add (p' + 2)) = 0 := by
          rw [R_Y.mk₀_comp_extMk f (p' + 3) rfl hf π]
          exact (R_Y.extMk_eq_zero_iff (π ≫ f) (p' + 3) rfl hπf (p' + 1) rfl).mpr ⟨g, hg⟩
        let K' := CategoryTheory.Limits.kernel π
        let ι_ker : K' ⟶ P := CategoryTheory.Limits.kernel.ι π
        let S_π := CategoryTheory.ShortComplex.mk ι_ker π
          (CategoryTheory.Limits.kernel.condition π)
        have hS_π : S_π.ShortExact :=
          { exact := CategoryTheory.ShortComplex.exact_kernel π }
        obtain ⟨x₁, hx₁⟩ := CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃
          hS_π Y (R_Y.extMk f (p' + 3) rfl hf) h_pull_zero (Nat.add_comm 1 (p' + 1))
        have hTF_K' : isTF K' := isTF_sub ι_ker hTF_P
        rw [← hx₁, ih K' hTF_K' x₁, CategoryTheory.Abelian.Ext.comp_zero]
    exact hVanish p K₀ hTF_K₀ e

  
  refine ⟨hT_S, hAdd_U, hLim_U, hColim_U, ?_⟩
  intro m k_deg R oneR FgtMod ιM ιℤ adjℤ adjR ηℤ
  have := hAdd_U m
  have := hLim_U m
  have := hColim_U m
  let Θ (𝒢 : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)) (n : ℕ) :
      CategoryTheory.Abelian.Ext.{u} oneR 𝒢 n →+
        CategoryTheory.Abelian.Ext.{u} Fℤ ((U_mod m).obj 𝒢) n :=
    ((CategoryTheory.Abelian.Ext.mk₀ ηℤ).precomp ((U_mod m).obj 𝒢) (Nat.zero_add n)).comp
      ((U_mod m).mapExtAddHom oneR 𝒢 n)
