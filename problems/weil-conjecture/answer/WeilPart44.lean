      rw [hΘ_apply, hΘ_apply, CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ηℤ) _ _
          (Nat.zero_add k) (Nat.add_zero k) (by omega)]
