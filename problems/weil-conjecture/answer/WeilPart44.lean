        (ℓ ^ c₂) • (1 : Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1)))) ∧
      J_adj_m * J_m =
        (ℓ ^ c₂) • (1 : Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1)))) ∧
      ∀ γ : Γ r,
