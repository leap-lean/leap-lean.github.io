    have hσ_cov : ∀ (W : S.Etale) (x : ↥(obj_WV (obj_WV W)).left),
        ∃ g : Γ, x ∈ Set.range ⇑(σ_g W g).left.base := by
      intro W x
      have hmem : (q_VV W).base x ∈ (Set.univ : Set ↥(CategoryTheory.Limits.pullback π π)) := trivial
      rw [← hCov_γ, Set.mem_iUnion] at hmem
      obtain ⟨g, hg⟩ := hmem
      exact ⟨g, (hσ_range W g).symm ▸ hg⟩
    have hSheetGlue : ∀ (ℱ : 𝒞) (W : S.Etale)
        (sec : Γ → ↑(ℱ.obj.obj (Opposite.op (obj_WV W)))),
        ∃! t : ↑(ℱ.obj.obj (Opposite.op (obj_WV (obj_WV W)))),
          ∀ g : Γ, (ℱ.obj.map (Opposite.op (σ_g W g))).hom t = sec g := by
      intro ℱ W sec
      apply hSheafArrows ℱ (obj_WV (obj_WV W)) (fun _ => obj_WV W) (σ_g W) (hσ_cov W) sec
      intro g₁ g₂ Z a₁ a₂ hcomm
      by_cases hg : g₁ = g₂
      · subst hg
        have ha : a₁ = a₂ := by
          have h1 := congrArg (fun φ => CategoryTheory.CategoryStruct.comp φ (p_W (obj_WV W))) hcomm
          exact (CategoryTheory.Category.comp_id a₁).symm.trans
            ((congrArg (a₁ ≫ ·) (hσ_p W g₁).symm).trans
