  have hσu_frob : ∀ (r : ℕ) (b : B r), (σ_u r).symm b - b ^ Nat.card F ∈ Q_u r :=
    fun r => (Classical.choose_spec (hQu_spec r).2.2.2).1
  have hσu_mat : ∀ r : ℕ,
