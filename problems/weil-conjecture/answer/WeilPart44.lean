                (CategoryTheory.Limits.pullback.snd h_W ι_up) (act_bar (r + 1) γ_up) ∧
            ((τ_rep_bar (r + 1) γ_up).val).map
              (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) = 1 ∧
            m_γup.base y₁ = y₂ := by
    intro r W h_W ι_up ι_dn m_ι hm1 hm2 y₁ y₂ hy
    obtain ⟨γ_up, m_γup, hfst, hsnd, hfix, hbase⟩ := hRelFib r W h_W m_ι hm1 hm2 y₁ y₂ hy
    exact ⟨γ_up, m_γup, hfst, hsnd, (hStepPkg r).2 γ_up hfix, hbase⟩

  obtain ⟨𝒥, ℳ, 𝒥_dual, ℳ_dual, ι_ext, triv, ι_dual, triv_dual,
    hPair, hPair_dual, ψ_J, ψ_adj, τ_ℳ_ab, τ_ℳ_dual_ab, τ_𝒥_ab_step,
    J_H1, J_H2, hAdd_J1, hAdd_J2,
    iso_J1, iso_J2, res_J1, res_J2, ι_J2, bock_J,
    hψ_comp, hψ_J_apply, hτ_ι_comm, hτ_apply, h_iso_J1_step,
    hres_J1_id, hres_J1_comp, hres_J2_comp,
    hEx_J2, hComm_ιJ2, hMul_ιJ2, hbock_compat, hbock_exact⟩ :=
    weil_mid_ext_sheaf_pair_symplectic_and_bockstein_tower S_geom U_bar ℓ M c₂ hM
      J_int J_adj hJ_mul_adj hJ_adj_mul G_geom hG_int
      (fun r => B_bar r ≃ₐ[R0_bar] B_bar r) V_bar π_bar act_bar hGal
      p_ι (fun r => (hp_ι_all r).1) (fun r => (hp_ι_all r).2)
      τ_rep_bar τ_dual_bar (fun _ _ => rfl) h_imG_bar h_resΓ h_relTrans
  letI : ∀ r : ℕ, AddCommGroup (J_H1 r) := hAdd_J1
  letI : ∀ r : ℕ, AddCommGroup (J_H2 r) := hAdd_J2

  let L_wit : ∀ r : ℕ, WeilCurveMidExtLevelWitness S_geom U_bar (ℓ ^ (r + 1)) M :=
    fun r =>
      { Γ := B_bar r ≃ₐ[R0_bar] B_bar r
        hGrp := inferInstance
        hFin := hFin_Γbar r
        V := V_bar r
        π := π_bar r
        act := act_bar r
        hGal := hGal r
        τ_rep := τ_rep_bar r
        τ_dual := τ_dual_bar r
        h_dual := fun _ => rfl
        𝒥 := 𝒥 r
        ℳ := ℳ r
        𝒥_dual := 𝒥_dual r
        ℳ_dual := ℳ_dual r
        ι_ext := ι_ext r
        triv := triv r
        ι_dual := ι_dual r
        triv_dual := triv_dual r
        hPair := hPair r
        hPair_dual := hPair_dual r }

  obtain ⟨hCont_j, Θ_j, hΘ_j_nat⟩ :=
    weil_zero_ext_direct_image_zero_functor_iso U₀.toScheme D₀.left U₀.ι

  let U_mod (m : ℕ) := CategoryTheory.sheafCompose S_geom.smallEtaleTopology
    (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u})

  obtain ⟨φ_ℳ, hφ_τ, hfrob_gauge⟩ :=
    weil_mid_ext_ind_etale_baseChange_and_frob_gauge F S_aff
      j_aff hj_open hj_hom s_inf hsinf_sec hsinf_compl U₀ hU₀_eq U_bar hU_bar_eq
      ℓ M F_u ℒ₀ τ_ℒ hCont_j Θ_j hΘ_j_nat W_mid
      B L_fld ρ ι_B e_U he_U σ_u hσu_mat triv₀ (fun r => (htriv₀_all r).2)
      B_bar q_B hq_B_inj q_k ι_Bbar φ_equiv e_Ubar
      ⟨heUbar_prD, heUbar_prk, fun r => ⟨hGal r, (hSheets r).2.1, (hSheets r).2.2.1,
        (hSheets r).2.2.2.1, hφ_B r, hφ_k r,
        (hSheets r).2.2.2.2.2.2.1, (hSheets r).2.2.2.2.2.2.2.1⟩⟩
      τ_rep_bar hτ_rep_bar
      (fun r => (U_mod (ℓ ^ (r + 1))).obj (L_wit r).ℳ) τ_ℳ_ab (fun r => (L_wit r).triv)
      (fun r => ⟨(hPair r).1, fun W => ⟨((hPair r).2 W).1, ((hPair r).2 W).2.2.1,
        fun s_up m_ι hm1 hm2 => (hτ_apply r W m_ι hm1 hm2).1 s_up⟩⟩)

  have hconj_rep : ∀ (r : ℕ) (γ : (L_wit r).Γ),
      ((F_u.val).map (PadicInt.toZModPow (r + 1))) * (((L_wit r).τ_rep (conj_Γ r γ)).val) =
        (((L_wit r).τ_rep γ).val) * ((F_u.val).map (PadicInt.toZModPow (r + 1))) := by
    intro r γ
    have hmul_units : ρ r (σ_u r) * τ_rep_bar r (conj_Γ r γ) =
        τ_rep_bar r γ * ρ r (σ_u r) := by
      change ρ r (σ_u r) * ρ r (res_arith r (conj_Γ r γ)) =
        ρ r (res_arith r γ) * ρ r (σ_u r)
      rw [hconj_res r γ, map_mul, map_mul, map_inv, ← mul_assoc, ← mul_assoc,
        mul_inv_cancel, one_mul]
    have hval := congrArg Units.val hmul_units
    simp only [Units.val_mul, hσu_mat r] at hval
    exact hval

  obtain ⟨e_H, e_J1_raw, e_J2_raw, hq_compat_raw0, hBridge0⟩ :=
    weil_mid_ext_module_comparison_and_shriek_cup_bridge_pinned F D₀ hInt_bar
      U_bar hU_ne hg_U ℓ M (Nat.card F ^ n) (@h_et_V S_geom U_bar)
      J_int F_u hJF_scale L_wit ψ_J hψ_J_apply
      p_ι (fun r => (hp_ι_all r).1) (fun r => (hp_ι_all r).2) h_resΓ h_relTrans
      Φ_V hΦ_V_comm_raw conj_Γ hconj_act hconj_rep
      W_mid.ℳ_bar W_mid.τ_bar W_mid.frobTorsion
      τ_ℳ_ab τ_ℳ_dual_ab τ_𝒥_ab_step hτ_ι_comm hτ_apply
      φ_ℳ hφ_τ hfrob_gauge

  let e_J1 : ∀ r : ℕ,
      J_H1 r ≃+ CategoryTheory.Abelian.Ext.{u}
        (weilEtaleModuleUnit S_geom (ℓ ^ (r + 1))) (L_wit r).𝒥 1 :=
    fun r => (iso_J1 r).trans (e_J1_raw r)
  let e_J2 : ∀ r : ℕ,
      J_H2 r ≃+ CategoryTheory.Abelian.Ext.{u}
        (weilEtaleModuleUnit S_geom (ℓ ^ (r + 1))) (L_wit r).𝒥 2 :=
    fun r => (iso_J2 r).trans (e_J2_raw r)

  refine k_goal (fun hS_bar => ?_)
  have hS_eq : S_bar = S_geom := hS_bar
  rw [hS_eq]
  refine ⟨U_bar, L_wit, ψ_J, ψ_adj, e_H, J_H1, J_H2, hAdd_J1, hAdd_J2, ?_⟩
  refine ⟨e_J1, e_J2, fun {a b} hab => res_J1 hab, fun {a b} hab => res_J2 hab,
    ι_J2, bock_J, ?_⟩
  refine ⟨heq_of_eq hU_bar_eq, hU_ne, hCompl_fin,
    fun r => (hψ_comp r).1, fun r => (hψ_comp r).2,
    hres_J1_id,
    fun {a b c} hab hbc x => hres_J1_comp hab hbc x,
    fun {a b c} hab hbc x => hres_J2_comp hab hbc x,
    hEx_J2, hComm_ιJ2, hMul_ιJ2, hbock_compat, hbock_exact, ?_, ?_⟩
  · intro r x
    exact (hq_compat_raw0 r (iso_J1 (r + 1) x)).trans
      (congrArg (fun z => (e_H r).symm
        (((CategoryTheory.Abelian.Ext.mk₀ (L_wit r).ι_ext).postcomp
          (weilEtaleModuleUnit S_geom (ℓ ^ (r + 1))) (Nat.add_zero 1))
          (e_J1_raw r z)))
        (h_iso_J1_step r x).symm)
  · intro Ψ hΨ θ_top hθ_top f_top hf_top hf_top_smul
    obtain ⟨hBr_trans0, hBr_frob0⟩ :=
      hBridge0 Ψ hΨ θ_top hθ_top f_top hf_top hf_top_smul
    refine ⟨?_, ?_⟩
    · intro r x_up b_up b_dn hb
      exact (hBr_trans0 r (iso_J1 (r + 1) x_up) b_up b_dn hb).trans
        (congrArg (fun z => θ_top r
          ((e_J1_raw r z).comp
            (Ψ r
              (((CategoryTheory.Abelian.Ext.mk₀ (ψ_J r)).postcomp
                (weilEtaleModuleUnit S_geom (ℓ ^ (r + 1))) (Nat.add_zero 1))
                (e_H r b_dn)))
            (Nat.one_add 1)))
          (h_iso_J1_step r x_up).symm)
    · intro r x₀ b
      obtain ⟨x₀', hx₀'_eq, hx₀'_cup⟩ := hBr_frob0 r x₀ b
      refine ⟨x₀', hx₀'_eq, ?_⟩
      have hpow : Nat.card F ^ n * Nat.card F = Nat.card F ^ (n + 1) :=
        (Nat.pow_succ (Nat.card F) n).symm
      rwa [hpow] at hx₀'_cup

theorem weil_curve_mid_ext_punctual_cokernel_vanishing (k : Type u) [Field k] [IsAlgClosed k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 X.hom]
    (U : X.left.Opens)
    (hU_ne : Nonempty ↥U)
    (hCompl_fin : ((U : Set ↥X.left)ᶜ).Finite)
    (m M : ℕ) (hm : 1 ≤ m)
    (Γ : Type u) [Group Γ]
    (V : AlgebraicGeometry.Scheme.{u})
    (π : Quiver.Hom V U.toScheme)
    (act : Γ → Quiver.Hom V V)
    (τ_rep : Γ →* (Matrix (Fin M) (Fin M) (ZMod m))ˣ)
    (𝒥 ℳ : CategoryTheory.Sheaf X.left.smallEtaleTopology
      (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))))
    (ι_ext : Quiver.Hom 𝒥 ℳ)
    (triv : ∀ W : X.left.Etale,
      let ι_V : Quiver.Hom V X.left := CategoryTheory.CategoryStruct.comp π U.ι
      let W_V := CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj W).hom ι_V
      ↑(ℳ.obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_V (Fin M → ZMod m))
    (hPair : WeilCurveMidExtIsSheafPair X.left U m M Γ V π act τ_rep 𝒥 ℳ ι_ext triv) :
    CategoryTheory.Mono ι_ext ∧
    Subsingleton (CategoryTheory.Abelian.Ext.{u} (weilEtaleModuleUnit X.left m)
      (CategoryTheory.Limits.cokernel ι_ext) 1) :=
by
  
  have hExtSplit :
      ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
        [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
        [CategoryTheory.EnoughInjectives 𝒞]
        (X₀ Q₀ : 𝒞),
        (∀ (E : 𝒞) (f : Quiver.Hom Q₀ E) (g : Quiver.Hom E X₀)
          (h0 : CategoryTheory.CategoryStruct.comp f g = 0),
          (CategoryTheory.ShortComplex.mk f g h0).ShortExact →
          ∃ σ : Quiver.Hom X₀ E,
            CategoryTheory.CategoryStruct.comp σ g = CategoryTheory.CategoryStruct.id X₀) →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ Q₀ 1) := by
    intro 𝒞 _ _ _ _ X₀ Q₀ hSec
    have hZero : ∀ ξ : CategoryTheory.Abelian.Ext.{u} X₀ Q₀ 1, ξ = 0 := by
      intro ξ
      let I : 𝒞 := CategoryTheory.Injective.under Q₀
      let ι : Quiver.Hom Q₀ I := CategoryTheory.Injective.ι Q₀
      have hMono_ι : CategoryTheory.Mono ι := CategoryTheory.Injective.ι_mono Q₀
      let K : 𝒞 := CategoryTheory.Limits.cokernel ι
      let π : Quiver.Hom I K := CategoryTheory.Limits.cokernel.π ι
      have hEpi_π : CategoryTheory.Epi π := CategoryTheory.Limits.coequalizer.π_epi
      let S_inj : CategoryTheory.ShortComplex 𝒞 :=
        CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hS_inj : S_inj.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_cokernel ι
          mono_f := hMono_ι
          epi_g := hEpi_π }
      have hSub_I : Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ I 1) :=
        CategoryTheory.Abelian.Ext.subsingleton_of_injective X₀ I 0
      have hξ_ι : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero 1) = 0 :=
        @Subsingleton.elim _ hSub_I _ _
      obtain ⟨x₃, hx₃⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₀ hS_inj ξ hξ_ι (Nat.zero_add 1)
      let h : Quiver.Hom X₀ K := CategoryTheory.Abelian.Ext.homEquiv₀ x₃
      have hx₃_eq : CategoryTheory.Abelian.Ext.mk₀ h = x₃ :=
        CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply x₃
      let E : 𝒞 := CategoryTheory.Limits.pullback π h
      let p_I : Quiver.Hom E I := CategoryTheory.Limits.pullback.fst π h
      let g : Quiver.Hom E X₀ := CategoryTheory.Limits.pullback.snd π h
      have hcond0 : CategoryTheory.CategoryStruct.comp ι π =
          CategoryTheory.CategoryStruct.comp (0 : Quiver.Hom Q₀ X₀) h := by
        rw [CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.zero_comp]
      let f : Quiver.Hom Q₀ E := CategoryTheory.Limits.pullback.lift ι 0 hcond0
      have hf_pI : CategoryTheory.CategoryStruct.comp f p_I = ι :=
        CategoryTheory.Limits.pullback.lift_fst ι 0 hcond0
      have hfg : CategoryTheory.CategoryStruct.comp f g = 0 :=
        CategoryTheory.Limits.pullback.lift_snd ι 0 hcond0
      have hMono_f : CategoryTheory.Mono f := ⟨fun {Z} u₁ u₂ hu => by
        apply (cancel_mono ι).mp
        rw [← hf_pI, ← CategoryTheory.Category.assoc, hu, CategoryTheory.Category.assoc]⟩
      have : CategoryTheory.Epi π := hEpi_π
      have hEpi_g : CategoryTheory.Epi g := CategoryTheory.Abelian.epi_pullback_of_epi_f π h
      let lift_sub : ∀ {W' : 𝒞} (k_mor : Quiver.Hom W' E),
          CategoryTheory.CategoryStruct.comp k_mor g = 0 →
          { l : Quiver.Hom W' Q₀ //
            CategoryTheory.CategoryStruct.comp l ι = CategoryTheory.CategoryStruct.comp k_mor p_I } :=
        fun k_mor hk =>
          CategoryTheory.Limits.KernelFork.IsLimit.lift' hS_inj.fIsKernel
            (CategoryTheory.CategoryStruct.comp k_mor p_I) (by
              change (k_mor ≫ p_I) ≫ π = 0
              rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
                ← CategoryTheory.Category.assoc, hk, CategoryTheory.Limits.zero_comp])
      have hLim_f : CategoryTheory.Limits.IsLimit (CategoryTheory.Limits.KernelFork.ofι f hfg) := by
        refine CategoryTheory.Limits.KernelFork.IsLimit.ofι f hfg
          (fun {W'} k_mor hk => (lift_sub k_mor hk).1)
          (fun {W'} k_mor hk => ?_)
          (fun {W'} k_mor hk m hm => ?_)
        · apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, hf_pI]
            exact (lift_sub k_mor hk).2
          · rw [CategoryTheory.Category.assoc, hfg, CategoryTheory.Limits.comp_zero, hk]
        · apply (cancel_mono f).mp
          rw [hm]
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, hf_pI]
            exact (lift_sub k_mor hk).2.symm
          · rw [CategoryTheory.Category.assoc, hfg, CategoryTheory.Limits.comp_zero, hk]
      let S_E : CategoryTheory.ShortComplex 𝒞 := CategoryTheory.ShortComplex.mk f g hfg
      have hS_E : S_E.ShortExact :=
        { exact := S_E.exact_of_f_is_kernel hLim_f
          mono_f := hMono_f
          epi_g := hEpi_g }
      let φ : Quiver.Hom S_E S_inj :=
        CategoryTheory.ShortComplex.homMk (CategoryTheory.CategoryStruct.id Q₀) p_I h
          (by dsimp [S_E, S_inj]; rw [CategoryTheory.Category.id_comp, hf_pI])
          (CategoryTheory.Limits.pullback.condition (f := π) (g := h))
      have hnat := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS_E hS_inj φ
      have hξ_ext : hS_E.extClass = ξ := by
        have h1 : hS_E.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ φ.τ₁) (Nat.add_zero 1) =
            hS_E.extClass := CategoryTheory.Abelian.Ext.comp_mk₀_id hS_E.extClass
        have h2 : (CategoryTheory.Abelian.Ext.mk₀ φ.τ₃).comp hS_inj.extClass (Nat.zero_add 1) = ξ := by
          change (CategoryTheory.Abelian.Ext.mk₀ h).comp hS_inj.extClass (Nat.zero_add 1) = ξ
          rw [hx₃_eq, hx₃]
        exact h1.symm.trans (hnat.trans h2)
      obtain ⟨σ, hσ⟩ := hSec E f g hfg hS_E
      rw [← hξ_ext]
      calc
        hS_E.extClass
          = (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id X₀)).comp
              hS_E.extClass (Nat.zero_add 1) :=
            (CategoryTheory.Abelian.Ext.mk₀_id_comp hS_E.extClass).symm
        _ = (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.comp σ g)).comp
              hS_E.extClass (Nat.zero_add 1) := by rw [hσ]
        _ = ((CategoryTheory.Abelian.Ext.mk₀ σ).comp (CategoryTheory.Abelian.Ext.mk₀ g)
              (Nat.zero_add 0)).comp hS_E.extClass (Nat.zero_add 1) := by
            rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        _ = (CategoryTheory.Abelian.Ext.mk₀ σ).comp
              ((CategoryTheory.Abelian.Ext.mk₀ g).comp hS_E.extClass (Nat.zero_add 1))
              (Nat.zero_add 1) :=
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add 0) (Nat.zero_add 1)
              (Nat.zero_add 1)
        _ = (CategoryTheory.Abelian.Ext.mk₀ σ).comp 0 (Nat.zero_add 1) := by
            rw [hS_E.comp_extClass]
        _ = 0 := by rw [CategoryTheory.Abelian.Ext.comp_zero]
    exact ⟨fun a b => (hZero a).trans (hZero b).symm⟩

  
  have hMonoAndVan :
      CategoryTheory.Mono ι_ext ∧
      ∀ W : X.left.Etale,
        Set.range (((AlgebraicGeometry.Scheme.Etale.forget X.left).obj W).hom).base ⊆
          (U : Set ↥X.left) →
        Subsingleton ↑((CategoryTheory.Limits.cokernel ι_ext).obj.obj (Opposite.op W)) := by
    let S := X.left
    let R := ULift.{u, 0} (ZMod m)
    let ModR := ModuleCat.{u, u} R
    let J := S.smallEtaleTopology
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
    refine ⟨?_, ?_⟩
    · refine ⟨fun {ℱ} g₁ g₂ hg => ?_⟩
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext opW
      rcases opW with ⟨W⟩
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      apply (hPair.2 W).2.1
      exact congrArg (fun (θ : Quiver.Hom ℱ ℳ) => (θ.hom.app (Opposite.op W)).hom x) hg
    · have hSurj_U : ∀ W' : S.Etale,
          Set.range ((Fgt.obj W').hom).base ⊆ (U : Set ↥S) →
          Function.Surjective (ι_ext.hom.app (Opposite.op W')).hom := by
        intro W' hW' s_M
        let h_W' := (Fgt.obj W').hom
        let f := triv W' s_M
        have hf_range : f ∈ Set.range (triv W') := ⟨s_M, rfl⟩
        rw [(hPair.2 W').2.2.1] at hf_range
        have hU_top : ((TopologicalSpace.Opens.map h_W'.base).obj U) ⊔ ⊥ = ⊤ := by
          ext z
          exact ⟨fun _ => trivial, fun _ => Or.inl (hW' ⟨z, rfl⟩)⟩
        have hf_im :
            f ∈ Set.range ((triv W').comp (ι_ext.hom.app (Opposite.op W')).hom.toAddMonoidHom) := by
          rw [(hPair.2 W').2.2.2]
          exact ⟨⟨⊥, hU_top, fun _ hy => False.elim hy⟩, hf_range⟩
        obtain ⟨s_J, hs_J⟩ := hf_im
        exact ⟨s_J, (hPair.2 W').1 hs_J⟩
      let 𝒬 := CategoryTheory.Limits.cokernel ι_ext
      let π_𝒬 : Quiver.Hom ℳ 𝒬 := CategoryTheory.Limits.cokernel.π ι_ext
      have : CategoryTheory.Epi π_𝒬 := CategoryTheory.Limits.coequalizer.π_epi
      have : CategoryTheory.Presheaf.IsLocallySurjective J π_𝒬.hom :=
        (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' ModR π_𝒬).mpr inferInstance
      have h𝒬_cat : CategoryTheory.Presheaf.IsSheaf J (𝒬.obj ⋙ CategoryTheory.forget ModR) :=
        CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J 𝒬.obj (CategoryTheory.forget ModR)
          𝒬.property
      have h𝒬_type : CategoryTheory.Presieve.IsSheaf J (𝒬.obj ⋙ CategoryTheory.forget ModR) :=
        (CategoryTheory.isSheaf_iff_isSheaf_of_type J _).mp h𝒬_cat
      intro W hW
      have hZero_W : ∀ q : ↑(𝒬.obj.obj (Opposite.op W)), q = 0 := by
        intro q
        let R_q := CategoryTheory.Presheaf.imageSieve π_𝒬.hom q
        have hRq : CategoryTheory.Sieve.generate R_q.arrows ∈ J W := by
          rw [CategoryTheory.Sieve.generate_sieve]
          exact CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem q
        apply (h𝒬_type.isSheafFor R_q.arrows hRq).isSeparatedFor.ext
        intro W' u hu
        change (𝒬.obj.map u.op).hom q = (𝒬.obj.map u.op).hom 0
        rw [map_zero]
