        (((ℓ : Padic ℓ) ^ k₁)⁻¹) • B_int w₁ = (((ℓ : Padic ℓ) ^ k₂)⁻¹) • B_int w₂ := by
      intro k₁ k₂ w₁ w₂ u hw₁ hw₂
