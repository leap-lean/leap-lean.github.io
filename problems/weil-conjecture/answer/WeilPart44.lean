          have hg_top : g_top ≫ ι_V c = (Fgt.obj U_et).hom :=
            CategoryTheory.Limits.pullback.condition.symm
          let g_Ub : U_sch ⟶ V b := g_top ≫ p_le hbc
          have hg_Ub : g_Ub ≫ ι_V b = (Fgt.obj U_et).hom := by
            rw [CategoryTheory.Category.assoc, hp_le_ι hbc, hg_top]
          obtain ⟨δ₁_top, hδ₁_top_fst, hδ₁_top_snd, hDiagLift_top, _⟩ :=
