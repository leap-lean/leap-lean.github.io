        (congrArg (((weilEtaleTorsionSheaf S (ℓ ^ (r + 1))).obj.map (Opposite.op t_y)).hom)
          (hConst_T a)).trans
          ((hθ_nat r t_y (LocallyConstant.const _ (ULift.map cast_r a))).trans
