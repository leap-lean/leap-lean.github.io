    have hu_snd : u_V ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj W₂).hom ι_V =
        CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom ι_V :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hGu_fst : Gu_V ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj (G.obj W₂)).hom ι_V =
        CategoryTheory.Limits.pullback.fst (Fgt.obj (G.obj W₁)).hom ι_V ≫
