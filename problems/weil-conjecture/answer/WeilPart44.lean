      intro f g₀
      have h_gen : ∀ (s : Finset Γ), (∑ g ∈ s, f g).coeff g₀ = ∑ g ∈ s, (f g).coeff g₀ := by
        intro s
        induction s using Finset.cons_induction with
        | empty => rfl
        | cons a s has ih => rw [Finset.sum_cons, Finset.sum_cons, h_coeff_add, ih]
      exact h_gen Finset.univ
    let repr_Q : ∀ m : ℕ, (Fin m → R) ≃ₗ[Λ] (Fin m × Γ → Λ) := fun m =>
      { toFun := fun u p => (u p.1).coeff p.2
        map_add' := fun u₁ u₂ => by
          funext ⟨j, g⟩
          exact h_coeff_add (u₁ j) (u₂ j) g
        map_smul' := fun c u => by
          funext ⟨j, g⟩
          exact h_coeff_smul c (u j) g
