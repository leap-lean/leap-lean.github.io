        ext i j
        exact congrFun (congrFun hγ_val i) j
      have hinv_val : ((τ_rep r γ)⁻¹).val = ((g⁻¹).val).map π_mod := by
        rw [hu_eq, ← map_inv]
        rfl
      have hdual_val : (τ_dual r γ).val = (((g⁻¹).val).transpose).map π_mod := by
        rw [h_dual r γ, hinv_val]
        ext i j
        rfl
      have hinv_tr : ((g⁻¹).val).transpose * (g.val).transpose = 1 := by
        rw [← Matrix.transpose_mul, Units.mul_inv, Matrix.transpose_one]
      have hJ_g : J_int * g.val = ((g⁻¹).val).transpose * J_int := by
