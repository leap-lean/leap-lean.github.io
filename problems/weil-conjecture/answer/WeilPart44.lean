  have hForgottenInjVanish : ∀ (m p : ℕ)
      (K₀ : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
      (∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • 𝟙 K₀)) →
      ∀ (ℐ : CategoryTheory.Sheaf J (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))))
