        rw [← equiv.apply_symm_apply (m • z), map_nsmul, hx]
      let y : ↥sysSubgroup := ⟨fun r => frob_coh r (x.1 r), by
        rw [hsys]; intro r; rw [hFrobTrans r (x.1 (r + 1)), (hsys x.1).mp x.2 r]⟩
