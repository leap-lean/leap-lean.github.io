    have hσ_proj : ∀ (W : S.Etale) (g : Γ),
        CategoryTheory.CategoryStruct.comp (σ_g W g) (u_can (p_W W)) = m_can W g := by
      intro W g
      apply hm_unique
      · exact (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·) (hu_fst (p_W W))).trans
