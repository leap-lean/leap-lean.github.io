      change (RingHom.mapMatrix π_mod) J_adj * (RingHom.mapMatrix π_mod) J_int = _
      rw [← map_mul (RingHom.mapMatrix π_mod), hmap]
      ext i j
      by_cases hij : i = j <;>
        simp [hij, RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.smul_apply, smul_eq_mul,
          nsmul_eq_mul]
