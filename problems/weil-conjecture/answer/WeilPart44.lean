        (CategoryTheory.Abelian.Ext.mapExactFunctor U_of x) (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (U_of.map φ)) (Nat.add_zero q)
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add q) (Nat.add_zero q)
        (by omega)]

  have hΘ_bij : ∀ (q : ℕ) (G_sh : C_R), Function.Bijective (Θ G_sh q) := by
    intro q
    induction q with
    | zero =>
      intro G_sh
      let M_sec := G_sh.obj.obj (Opposite.op T_S)
      let eR_sec : (ModuleCat.of R R ⟶ M_sec) ≃ ↥M_sec :=
        { toFun := fun ψ => ψ.hom (1 : R)
          invFun := fun a => ModuleCat.ofHom (LinearMap.toSpanSingleton R ↥M_sec a)
          left_inv := fun ψ => by
            apply ModuleCat.hom_ext
            apply LinearMap.ext
            intro r
            change r • ψ.hom 1 = ψ.hom r
            rw [← map_smul, smul_eq_mul, mul_one]
          right_inv := fun a => one_smul R a }
      let eZ_sec : (AZ ⟶ FgtMod.obj M_sec) ≃ ↥M_sec :=
        { toFun := fun g => g.hom (ULift.up (1 : ℤ))
          invFun := fun a => AddCommGrpCat.ofHom
            { toFun := fun z => z.down • a
              map_zero' := zero_zsmul a
              map_add' := fun z₁ z₂ => add_zsmul a z₁.down z₂.down }
          left_inv := fun g => by
            ext z
            change z.down • g.hom (ULift.up 1) = g.hom z
            rw [← g.hom.map_zsmul]
            congr 1
            exact ULift.ext _ _ (mul_one z.down)
          right_inv := fun a => one_zsmul a }
      have hHom_bij : Function.Bijective (fun φ : oneR ⟶ G_sh => ηZ ≫ U_of.map φ) := by
        let eDom : (oneR ⟶ G_sh) ≃ ↥M_sec :=
          (adjR.homEquiv (ModuleCat.of R R) G_sh).trans eR_sec
        let eCod : (FZ ⟶ U_of.obj G_sh) ≃ ↥M_sec :=
          (adjZ.homEquiv AZ (U_of.obj G_sh)).trans eZ_sec
        suffices hEq : ∀ φ : oneR ⟶ G_sh, eCod (ηZ ≫ U_of.map φ) = eDom φ by
          refine ⟨fun φ₁ φ₂ h => eDom.injective ?_, fun ψ => ⟨eDom.symm (eCod ψ), eCod.injective ?_⟩⟩
          · rw [← hEq φ₁, ← hEq φ₂]
            exact congrArg eCod h
          · rw [hEq, eDom.apply_symm_apply]
        intro φ
        change eZ_sec ((adjZ.homEquiv AZ (U_of.obj G_sh)) (ηZ ≫ U_of.map φ)) =
          eR_sec ((adjR.homEquiv (ModuleCat.of R R) G_sh) φ)
        have hnat := adjZ.homEquiv_naturality_right ηZ (U_of.map φ)
        have hη : adjZ.homEquiv AZ (U_of.obj oneR) ηZ = ιZ ≫ u₀ :=
          (adjZ.homEquiv AZ (U_of.obj oneR)).apply_symm_apply _
        rw [hnat, hη]
        have hιZ1 : ιZ.hom (ULift.up (1 : ℤ)) = (1 : R) := ULift.ext _ _ Int.cast_one
        change (φ.hom.app (Opposite.op T_S)).hom
            ((adjR.unit.app (ModuleCat.of R R)).hom (ιZ.hom (ULift.up (1 : ℤ)))) =
          ((adjR.homEquiv (ModuleCat.of R R) G_sh) φ).hom (1 : R)
        rw [hιZ1, Adjunction.homEquiv_unit]
        rfl
      have hΘ0_eq : (⇑(Θ G_sh 0)) =
          (⇑(CategoryTheory.Abelian.Ext.addEquiv₀ (X := FZ) (Y := U_of.obj G_sh)).symm) ∘
            (fun φ : oneR ⟶ G_sh => ηZ ≫ U_of.map φ) ∘
            (⇑(CategoryTheory.Abelian.Ext.addEquiv₀ (X := oneR) (Y := G_sh))) := by
        ext x
        have hx : CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.Abelian.Ext.addEquiv₀ x) = x :=
          CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply x
        conv_lhs => rw [← hx]
        change (CategoryTheory.Abelian.Ext.mk₀ ηZ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U_of
              (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.Abelian.Ext.addEquiv₀ x)))
            (Nat.zero_add 0) =
          CategoryTheory.Abelian.Ext.mk₀ (ηZ ≫ U_of.map (CategoryTheory.Abelian.Ext.addEquiv₀ x))
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      rw [hΘ0_eq]
      exact CategoryTheory.Abelian.Ext.addEquiv₀.symm.bijective.comp
        (hHom_bij.comp CategoryTheory.Abelian.Ext.addEquiv₀.bijective)
    | succ q ih =>
      intro G_sh
      obtain ⟨I_sh, Q_sh, i_G, p_G, h0_G, hInj_I, hS⟩ := hAbInjSES C_R G_sh
      let S_G := CategoryTheory.ShortComplex.mk i_G p_G h0_G
      have hUS : (S_G.map U_of).ShortExact := hS.map_of_exact U_of
      have hΘ_ext : ∀ z : CategoryTheory.Abelian.Ext.{u} oneR Q_sh q,
          Θ G_sh (q + 1) (z.comp hS.extClass rfl) = (Θ Q_sh q z).comp hUS.extClass rfl := by
        intro z
        change (CategoryTheory.Abelian.Ext.mk₀ ηZ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U_of (z.comp hS.extClass rfl))
            (Nat.zero_add (q + 1)) =
          ((CategoryTheory.Abelian.Ext.mk₀ ηZ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U_of z) (Nat.zero_add q)).comp
            hUS.extClass rfl
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass U_of hS,
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add q) rfl
            (Nat.zero_add (q + 1))]
      have _ := hInj_I
      have _ : Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR I_sh (q + 1)) :=
        CategoryTheory.Abelian.Ext.subsingleton_of_injective oneR I_sh q
      refine ⟨?_, ?_⟩
      · rw [injective_iff_map_eq_zero]
        intro y hy0
        have hy_i : y.comp (CategoryTheory.Abelian.Ext.mk₀ S_G.f) (Nat.add_zero (q + 1)) = 0 :=
          Subsingleton.elim _ _
        obtain ⟨z, rfl⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ oneR hS y hy_i rfl
        rw [hΘ_ext z] at hy0
        obtain ⟨w', hw'⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ FZ hUS (Θ Q_sh q z) rfl hy0
        obtain ⟨w, rfl⟩ := (ih I_sh).2 w'
        have hz_eq : Θ Q_sh q (w.comp (CategoryTheory.Abelian.Ext.mk₀ p_G) (Nat.add_zero q)) =
            Θ Q_sh q z := by
          rw [hΘ_postcomp]
          exact hw'
        have hz : w.comp (CategoryTheory.Abelian.Ext.mk₀ p_G) (Nat.add_zero q) = z :=
          (ih Q_sh).1 hz_eq
        rw [← hz, CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.zero_add 1) rfl,
          hS.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      · intro y'
        have hy'_i : y'.comp (CategoryTheory.Abelian.Ext.mk₀ (S_G.map U_of).f)
            (Nat.add_zero (q + 1)) = 0 :=
