               algebraMap k₀ A (algebraMap E₂ k₀ e₂) * (e_A1 (φ_A₂ a₂) * algebraMap k₀ A x)
             rw [hφ_mul_e₂, mul_assoc] } : A₂ →ₗ[E₂] k₀ →ₗ[E₂] A)).toAddMonoidHom
    have hpure_fwd : ∀ (a₁ : A₁) (e₂ : E₂) (x : k₀),
        fwd_add (TensorProduct.tmul E₂ (TensorProduct.tmul E₁ a₁ e₂) x) =
          e_A1 (TensorProduct.tmul E₁ a₁ (algebraMap E₂ k₀ e₂ * x)) := by
      intro a₁ e₂ x
      change e_A1 (TensorProduct.tmul E₁ a₁ (algebraMap E₂ k₀ e₂)) * algebraMap k₀ A x = _
      rw [he_A1_tmul a₁ (algebraMap E₂ k₀ e₂), he_A1_tmul a₁ (algebraMap E₂ k₀ e₂ * x),
        map_mul, mul_assoc]
    have hfwd_mul : ∀ w₁ w₂ : TensorProduct E₂ A₂ k₀,
        fwd_add (w₁ * w₂) = fwd_add w₁ * fwd_add w₂ := by
      intro w₁ w₂
      induction w₁ using TensorProduct.induction_on with
      | zero => rw [zero_mul, map_zero, zero_mul]
      | add x y ihx ihy => rw [add_mul, map_add, map_add, ihx, ihy, add_mul]
