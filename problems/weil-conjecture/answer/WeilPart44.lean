        let k₀ : Fin c := eS.symm ⟨u, hu⟩
        refine ⟨Pi.single k₀ 1, fun j => ?_⟩
        rw [Finset.sum_eq_single k₀]
        · simp [B, k₀, Pi.single_eq_same]
        · intro k _ hk; simp [Pi.single_eq_of_ne hk]
        · intro hk₀; exact False.elim (hk₀ (Finset.mem_univ k₀))
      · rintro ⟨w, hw⟩ i
        have hcalc : ∑ j : Fin b, A j i * u j =
            ∑ k : Fin c, (∑ j : Fin b, A j i * B k j) * w k := by
          calc
            ∑ j : Fin b, A j i * u j
                = ∑ j : Fin b, ∑ k : Fin c, A j i * (B k j * w k) := by
                  refine Finset.sum_congr rfl fun j _ => by rw [hw j, Finset.mul_sum]
            _ = ∑ k : Fin c, ∑ j : Fin b, (A j i * B k j) * w k := by
                  rw [Finset.sum_comm]
                  exact Finset.sum_congr rfl fun k _ =>
                    Finset.sum_congr rfl fun j _ => (mul_assoc _ _ _).symm
            _ = ∑ k : Fin c, (∑ j : Fin b, A j i * B k j) * w k :=
                  Finset.sum_congr rfl fun k _ => (Finset.sum_mul _ _ _).symm
        rw [hcalc]
        exact Finset.sum_eq_zero fun k _ => by rw [hAB k i, zero_mul]
    have h_Rel_inj : ∀ {K_mod E C : Type u} [AddCommGroup K_mod] [Module R K_mod]
        [AddCommGroup E] [Module R E] [AddCommGroup C] [Module R C]
        (ι : K_mod →ₗ[R] E) (π : E →ₗ[R] C),
        Function.Injective ι → Function.Surjective π →
        (∀ e : E, π e = 0 ↔ ∃ k : K_mod, ι k = e) →
        WeilCurveTrIsEqFlat Γ (ℓ ^ K) C →
        ∀ k : Fin N → K_mod, (fun i => ι (k i)) ∈ Rel_of E → k ∈ Rel_of K_mod := by
      intro K_mod E C _ _ _ _ _ _ ι π hι_inj hπ_surj hex_seq hC k hk
      rw [h_Rel_mat] at hk ⊢
      rcases hk with ⟨e_vec, he_vec⟩
      have he_C : ∀ i : Fin N, ∑ r : Fin b_rel, A_rel r i • π (e_vec r) = 0 := fun i => by
        have h0 : π (ι (k i)) = 0 := (hex_seq (ι (k i))).mpr ⟨k i, rfl⟩
        rw [he_vec i, map_sum] at h0
        simpa only [map_smul] using h0
      obtain ⟨d, B_rel, hAB_rel, hex_rel⟩ := h_syzygy N b_rel A_rel
      obtain ⟨c_vec, hc_vec⟩ := (hC N b_rel d B_rel A_rel hex_rel (fun r => π (e_vec r))).mp he_C
      choose z_E hz_E using fun t : Fin d => hπ_surj (c_vec t)
      have he'_ker : ∀ r : Fin b_rel, ∃ x : K_mod, ι x = e_vec r - ∑ t : Fin d, B_rel t r • z_E t := by
        intro r
        apply (hex_seq _).mp
        rw [map_sub, map_sum, hc_vec r]
        have hsum : ∑ t : Fin d, π (B_rel t r • z_E t) = ∑ t : Fin d, B_rel t r • c_vec t :=
          Finset.sum_congr rfl fun t _ => by rw [map_smul, hz_E t]
        rw [hsum, sub_self]
      choose x_K hx_K using he'_ker
      refine ⟨x_K, fun i => hι_inj ?_⟩
      rw [map_sum, he_vec i]
      have hcalc : ∑ r : Fin b_rel, ι (A_rel r i • x_K r) =
          (∑ r : Fin b_rel, A_rel r i • e_vec r) -
            ∑ t : Fin d, (∑ r : Fin b_rel, A_rel r i * B_rel t r) • z_E t := by
        calc
          ∑ r : Fin b_rel, ι (A_rel r i • x_K r)
              = ∑ r : Fin b_rel, A_rel r i • (e_vec r - ∑ t : Fin d, B_rel t r • z_E t) :=
                Finset.sum_congr rfl fun r _ => by rw [map_smul, hx_K r]
          _ = (∑ r : Fin b_rel, A_rel r i • e_vec r) -
                ∑ r : Fin b_rel, ∑ t : Fin d, (A_rel r i * B_rel t r) • z_E t := by
                simp only [smul_sub, Finset.sum_sub_distrib, Finset.smul_sum, mul_smul]
          _ = (∑ r : Fin b_rel, A_rel r i • e_vec r) -
                ∑ t : Fin d, (∑ r : Fin b_rel, A_rel r i * B_rel t r) • z_E t := by
                congr 1
                rw [Finset.sum_comm]
                exact Finset.sum_congr rfl fun t _ => Finset.sum_smul.symm
      rw [hcalc]
      have hzero : ∑ t : Fin d, (∑ r : Fin b_rel, A_rel r i * B_rel t r) • z_E t = 0 :=
        Finset.sum_eq_zero fun t _ => by rw [hAB_rel t i, zero_smul]
      rw [hzero, sub_zero]
    have hFlat_pi2 : WeilCurveTrIsEqFlat Γ (ℓ ^ K) (Fin m₂ → R) := by
      intro a b c B A hex x
      constructor
      · intro hx
        have hl : ∀ l : Fin m₂, ∃ w : Fin c → R, ∀ j : Fin b, x j l = ∑ r : Fin c, B r j * w r := by
          intro l
          apply (hex (fun j => x j l)).mp
          intro i
          simpa [Finset.sum_apply] using congrFun (hx i) l
        choose w hw using hl
        exact ⟨fun r l => w l r, fun j => funext fun l => by simpa [Finset.sum_apply] using hw l j⟩
      · rintro ⟨z, hz⟩ i
        funext l
        have hl : ∀ j : Fin b, x j l = ∑ r : Fin c, B r j * z r l :=
          fun j => by simpa [Finset.sum_apply] using congrFun (hz j) l
        simpa [Finset.sum_apply] using (hex (fun j => x j l)).mpr ⟨fun r => z r l, hl⟩ i
    let D₂_map : (M.M₁ × (Fin m₂ → R)) →ₗ[R] M.M₂ :=
      M.δ₁.comp (LinearMap.fst R M.M₁ (Fin m₂ → R)) +
      γ₂.comp (LinearMap.snd R M.M₁ (Fin m₂ → R))
    have hD₂_surj : Function.Surjective D₂_map := fun y₂ => by
      obtain ⟨y₁, q₂, h⟩ := hCone.1 y₂
      exact ⟨(y₁, q₂), h⟩
    let Z₁ := LinearMap.ker D₂_map
    have hFlat_Z₁ : WeilCurveTrIsEqFlat Γ (ℓ ^ K) ↥Z₁ := by
      intro a b c B A hex x
      constructor
      · intro hx
        have hx1 : ∀ i : Fin a, ∑ j : Fin b, A j i • (x j).1.1 = 0 := fun i => by
          have := congrArg (fun z : ↥Z₁ => z.1.1) (hx i)
          simpa [AddSubmonoid.coe_finsetSum, Prod.fst_sum] using this
        have hx2 : ∀ i : Fin a, ∑ j : Fin b, A j i • (x j).1.2 = 0 := fun i => by
          have := congrArg (fun z : ↥Z₁ => z.1.2) (hx i)
          simpa [AddSubmonoid.coe_finsetSum, Prod.snd_sum] using this
        obtain ⟨e₁, he₁⟩ := (hFlat.2.1 a b c B A hex (fun j => (x j).1.1)).mp hx1
        obtain ⟨e₂, he₂⟩ := (hFlat_pi2 a b c B A hex (fun j => (x j).1.2)).mp hx2
        have he_C : ∀ j : Fin b, ∑ k : Fin c, B k j • D₂_map (e₁ k, e₂ k) = 0 := fun j => by
          have h0 : D₂_map (x j).1 = 0 := (x j).2
          have h_eq : (x j).1 = ∑ k : Fin c, B k j • (e₁ k, e₂ k) :=
            Prod.ext (by simpa [Prod.fst_sum] using he₁ j) (by simpa [Prod.snd_sum] using he₂ j)
          rw [h_eq, map_sum] at h0
          simpa only [map_smul] using h0
        obtain ⟨d, D_mat, hBD, hex_B⟩ := h_syzygy b c B
        obtain ⟨c_vec, hc_vec⟩ := (hFlat.2.2 b c d D_mat B hex_B
          (fun k => D₂_map (e₁ k, e₂ k))).mp he_C
        choose t_E ht_E using fun r : Fin d => hD₂_surj (c_vec r)
        have he'_Z₁ : ∀ k : Fin c, (e₁ k, e₂ k) - ∑ r : Fin d, D_mat r k • t_E r ∈ Z₁ := by
          intro k
          rw [LinearMap.mem_ker, map_sub, map_sum, hc_vec k]
          have hsum : ∑ r : Fin d, D₂_map (D_mat r k • t_E r) = ∑ r : Fin d, D_mat r k • c_vec r :=
            Finset.sum_congr rfl fun r _ => by rw [map_smul, ht_E r]
          rw [hsum, sub_self]
        refine ⟨fun k => ⟨_, he'_Z₁ k⟩, fun j => Subtype.ext ?_⟩
        rw [AddSubmonoid.coe_finsetSum]
        change (x j).1 = ∑ k : Fin c, B k j • ((e₁ k, e₂ k) - ∑ r : Fin d, D_mat r k • t_E r)
        have h_eq : (x j).1 = ∑ k : Fin c, B k j • (e₁ k, e₂ k) :=
          Prod.ext (by simpa [Prod.fst_sum] using he₁ j) (by simpa [Prod.snd_sum] using he₂ j)
        rw [h_eq]
        simp only [smul_sub, Finset.sum_sub_distrib, Finset.smul_sum, ← mul_smul]
        have hcomm : ∑ k : Fin c, ∑ r : Fin d, (B k j * D_mat r k) • t_E r =
            ∑ r : Fin d, (∑ k : Fin c, B k j * D_mat r k) • t_E r := by
          rw [Finset.sum_comm]
          exact Finset.sum_congr rfl fun r _ => Finset.sum_smul.symm
        rw [hcomm]
        have hzero : ∑ r : Fin d, (∑ k : Fin c, B k j * D_mat r k) • t_E r = 0 :=
          Finset.sum_eq_zero fun r _ => by rw [hBD r j, zero_smul]
        rw [hzero, sub_zero]
      · rintro ⟨z, hz⟩ i
        have hAB : ∀ k : Fin c, ∑ j : Fin b, A j i * B k j = 0 := fun k =>
          (hex (fun j => B k j)).mpr ⟨Pi.single k 1, fun j => by
            rw [Finset.sum_eq_single k]
            · simp [Pi.single_eq_same]
            · intro k' _ hk'; simp [Pi.single_eq_of_ne hk']
            · intro hk; exact False.elim (hk (Finset.mem_univ k))⟩ i
        calc
          ∑ j : Fin b, A j i • x j
              = ∑ j : Fin b, ∑ k : Fin c, (A j i * B k j) • z k :=
                Finset.sum_congr rfl fun j _ => by
                  rw [hz j, Finset.smul_sum]
                  exact Finset.sum_congr rfl fun k _ => (mul_smul _ _ _).symm
          _ = ∑ k : Fin c, (∑ j : Fin b, A j i * B k j) • z k := by
                rw [Finset.sum_comm]
                exact Finset.sum_congr rfl fun k _ => Finset.sum_smul.symm
          _ = 0 := Finset.sum_eq_zero fun k _ => by rw [hAB k, zero_smul]
    let coeffHom : Γ → (R →+ Λ_K) := fun g =>
      { toFun := fun r => r.coeff g
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have h_val_cast : ∀ x : ZMod (ℓ ^ (s + 1)), ((x.val : ℕ) : Λ_s) = x :=
      fun x => ZMod.natCast_zmod_val x
    let Theta_Q : ∀ m : ℕ, (Fin N → (Fin m → R)) →+ (Fin m × Fin N → Λ_s) := fun m =>
      { toFun := fun v p =>
          ∑ j : Fin N, ∑ τ : Γ, cast_s ((v j p.1).coeff τ) * ((τ_rep τ⁻¹).val p.2 j)
        map_zero' := by
          funext ⟨k, i⟩
          simp
        map_add' := fun v₁ v₂ => by
          funext ⟨k, i⟩
          simp only [Pi.add_apply, show ∀ (r₁ r₂ : R) (g : Γ), (r₁ + r₂).coeff g = r₁.coeff g + r₂.coeff g from fun _ _ _ => rfl,
            map_add, add_mul, Finset.sum_add_distrib] }
    let Sigma_Q : ∀ m : ℕ, (Fin m × Fin N → Λ_s) → (Fin N → (Fin m → R)) :=
      fun m z i k => s_scalar ((z (k, i)).val : Λ_K)
    have h_Theta_Sigma : ∀ (m : ℕ) (z : Fin m × Fin N → Λ_s), Theta_Q m (Sigma_Q m z) = z := by
      intro m z
      funext ⟨k, i⟩
      change (∑ j : Fin N, ∑ τ : Γ,
        cast_s ((MonoidAlgebra.single (1 : Γ) ((z (k, j)).val : Λ_K)).coeff τ) *
          ((τ_rep τ⁻¹).val i j)) = z (k, i)
      rw [Finset.sum_eq_single i]
      · rw [Finset.sum_eq_single (1 : Γ)]
        · rw [MonoidAlgebra.coeff_single, Finsupp.single_apply]
          simp only [↓reduceIte, inv_one, map_one, Units.val_one, Matrix.one_apply_eq,
            mul_one, map_natCast, h_val_cast]
        · intro τ _ hτ
          rw [MonoidAlgebra.coeff_single, Finsupp.single_apply]
          simp [Ne.symm hτ]
        · intro h1; exact False.elim (h1 (Finset.mem_univ 1))
      · intro j _ hji
        rw [Finset.sum_eq_single (1 : Γ)]
        · rw [MonoidAlgebra.coeff_single, Finsupp.single_apply]
          simp only [↓reduceIte, inv_one, map_one, Units.val_one,
            Matrix.one_apply_ne (Ne.symm hji), mul_zero]
        · intro τ _ hτ
          rw [MonoidAlgebra.coeff_single, Finsupp.single_apply]
          simp [Ne.symm hτ]
        · intro h1; exact False.elim (h1 (Finset.mem_univ 1))
      · intro hi; exact False.elim (hi (Finset.mem_univ i))
    have h_Theta_Rel : ∀ (m : ℕ) (u : Fin N → (Fin m → R)), u ∈ Rel_of (Fin m → R) →
        Theta_Q m u = 0 := by
      intro m u hu
      have h_le : Rel_of (Fin m → R) ≤ (Theta_Q m).ker := by
        apply (AddSubgroup.closure_le (Theta_Q m).ker).mpr
        rintro u (⟨w, rfl⟩ | ⟨g, w, rfl⟩)
        · change Theta_Q m ((ℓ ^ (s + 1) : ℕ) • w) = 0
          rw [map_nsmul]
          funext ⟨k, i⟩
          change (ℓ ^ (s + 1) : ℕ) • (Theta_Q m w (k, i)) = 0
          rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
        · change Theta_Q m ((fun i => (MonoidAlgebra.single g (1 : Λ_K) : R) • w i) -
              (fun i => ∑ j : Fin N, s_scalar (((τ_rep g⁻¹).val i j).val : Λ_K) • w j)) = 0
          rw [map_sub, sub_eq_zero]
          funext ⟨k, i⟩
          change (∑ j : Fin N, ∑ τ : Γ,
              cast_s ((MonoidAlgebra.single g (1 : Λ_K) * w j k).coeff τ) *
                ((τ_rep τ⁻¹).val i j)) =
            ∑ r : Fin N, ∑ η : Γ,
              cast_s (((∑ j : Fin N, s_scalar (((τ_rep g⁻¹).val r j).val : Λ_K) • w j) k).coeff η) *
                ((τ_rep η⁻¹).val i r)
          have h_lhs : ∀ j : Fin N,
              (∑ τ : Γ, cast_s ((MonoidAlgebra.single g (1 : Λ_K) * w j k).coeff τ) *
                ((τ_rep τ⁻¹).val i j)) =
              ∑ η : Γ, ∑ r : Fin N,
                cast_s ((w j k).coeff η) * ((τ_rep η⁻¹).val i r) * ((τ_rep g⁻¹).val r j) := by
            intro j
            rw [← Equiv.sum_comp (Equiv.mulLeft g)]
            refine Finset.sum_congr rfl fun η _ => ?_
            change cast_s ((MonoidAlgebra.single g (1 : Λ_K) * w j k).coeff (g * η)) *
              ((τ_rep (g * η)⁻¹).val i j) = _
            rw [MonoidAlgebra.coeff_single_mul_apply, one_mul, inv_mul_cancel_left,
              mul_inv_rev, map_mul τ_rep, Units.val_mul, Matrix.mul_apply, Finset.mul_sum]
            exact Finset.sum_congr rfl fun r _ => (mul_assoc _ _ _).symm
          have h_rhs : ∀ (r : Fin N) (η : Γ),
              cast_s (((∑ j : Fin N, s_scalar (((τ_rep g⁻¹).val r j).val : Λ_K) • w j) k).coeff η) *
                ((τ_rep η⁻¹).val i r) =
              ∑ j : Fin N,
                cast_s ((w j k).coeff η) * ((τ_rep η⁻¹).val i r) * ((τ_rep g⁻¹).val r j) := by
            intro r η
            rw [Finset.sum_apply]
            change cast_s (coeffHom η (∑ j : Fin N, _)) * _ = _
            rw [map_sum (coeffHom η), map_sum, Finset.sum_mul]
            refine Finset.sum_congr rfl fun j _ => ?_
            change cast_s ((MonoidAlgebra.single (1 : Γ) (((τ_rep g⁻¹).val r j).val : Λ_K) *
              w j k).coeff η) * ((τ_rep η⁻¹).val i r) = _
            rw [MonoidAlgebra.coeff_single_mul_apply, inv_one, one_mul, map_mul,
              map_natCast, h_val_cast]
            ring
          simp_rw [h_lhs, h_rhs]
          conv_lhs => rw [Finset.sum_comm]
          conv_rhs => rw [Finset.sum_comm]
          exact Finset.sum_congr rfl fun η _ => Finset.sum_comm
      exact h_le hu
    have h_cast_zero_rel : ∀ {m : ℕ} (v : Fin N → (Fin m → R)),
        (∀ (j : Fin N) (k : Fin m) (τ : Γ), τ ≠ 1 → (v j k).coeff τ = 0) →
        (∀ (j : Fin N) (k : Fin m), cast_s ((v j k).coeff 1) = 0) →
        v ∈ Rel_of (Fin m → R) := by
      intro m v h_supp h_zero
      have h_div : ∀ (j : Fin N) (k : Fin m),
          ∃ q : ℕ, ((v j k).coeff 1).val = (ℓ ^ (s + 1)) * q := by
        intro j k
        exact dvd_iff_exists_eq_mul_right.mp ((ZMod.natCast_eq_zero_iff _ _).mp (by
          have h1 : cast_s ((v j k).coeff 1) = (((v j k).coeff 1).val : Λ_s) := by
            conv_lhs => rw [← ZMod.natCast_zmod_val ((v j k).coeff 1)]
            exact map_natCast cast_s _
          exact h1.symm.trans (h_zero j k)))
      choose q hq using h_div
      apply AddSubgroup.subset_closure
      left
      refine ⟨fun j k => s_scalar (q j k : Λ_K), ?_⟩
      funext j k
      apply MonoidAlgebra.coeff_injective
      ext τ
      by_cases hτ : τ = 1
      · subst hτ
        have h_lhs : (v j k).coeff 1 = (((v j k).coeff 1).val : Λ_K) :=
          (ZMod.natCast_zmod_val _).symm
        rw [h_lhs, hq j k, Nat.cast_mul]
        change _ = ((ℓ ^ (s + 1) : ℕ) • s_scalar (q j k : Λ_K)).coeff 1
        rw [← h_nsmul_R (ℓ ^ (s + 1)) (s_scalar (q j k : Λ_K))]
        change _ = (MonoidAlgebra.single (1 : Γ) ((ℓ ^ (s + 1) : ℕ) : Λ_K) *
          MonoidAlgebra.single (1 : Γ) (q j k : Λ_K)).coeff 1
        rw [MonoidAlgebra.single_mul_single, one_mul, MonoidAlgebra.coeff_single,
          Finsupp.single_apply]
        simp
      · rw [h_supp j k τ hτ]
        change 0 = ((ℓ ^ (s + 1) : ℕ) • MonoidAlgebra.single (1 : Γ) (q j k : Λ_K)).coeff τ
        rw [← h_nsmul_R (ℓ ^ (s + 1)) (MonoidAlgebra.single (1 : Γ) (q j k : Λ_K))]
        change 0 = (MonoidAlgebra.single (1 : Γ) ((ℓ ^ (s + 1) : ℕ) : Λ_K) *
          MonoidAlgebra.single (1 : Γ) (q j k : Λ_K)).coeff τ
        rw [MonoidAlgebra.single_mul_single, one_mul, MonoidAlgebra.coeff_single,
          Finsupp.single_apply]
        simp [Ne.symm hτ]
    have h_coeff_sub : ∀ (r₁ r₂ : R) (g : Γ), (r₁ - r₂).coeff g = r₁.coeff g - r₂.coeff g :=
      fun _ _ _ => rfl
    have h_diff_Sigma_Rel : ∀ (m : ℕ) (v : Fin N → (Fin m → R)),
        v - Sigma_Q m (Theta_Q m v) ∈ Rel_of (Fin m → R) := by
      intro m v
      have h_Sigma_add : ∀ z₁ z₂ : Fin m × Fin N → Λ_s,
          Sigma_Q m (z₁ + z₂) - (Sigma_Q m z₁ + Sigma_Q m z₂) ∈ Rel_of (Fin m → R) := by
        intro z₁ z₂
        apply h_cast_zero_rel
        · intro j k τ hτ
          change (s_scalar (((z₁ + z₂) (k, j)).val : Λ_K) -
            (s_scalar ((z₁ (k, j)).val : Λ_K) + s_scalar ((z₂ (k, j)).val : Λ_K))).coeff τ = 0
          rw [h_coeff_sub, show ∀ (a b : R), (a + b).coeff τ = a.coeff τ + b.coeff τ from fun _ _ => rfl]
          simp only [s_scalar, MonoidAlgebra.coeff_single, Finsupp.single_apply]
          simp [Ne.symm hτ]
        · intro j k
          change cast_s ((s_scalar (((z₁ + z₂) (k, j)).val : Λ_K) -
            (s_scalar ((z₁ (k, j)).val : Λ_K) + s_scalar ((z₂ (k, j)).val : Λ_K))).coeff 1) = 0
          rw [h_coeff_sub, show ∀ (a b : R), (a + b).coeff 1 = a.coeff 1 + b.coeff 1 from fun _ _ => rfl]
          simp only [s_scalar, MonoidAlgebra.coeff_single, Finsupp.single_apply, ↓reduceIte]
          rw [map_sub, map_add, map_natCast, map_natCast, map_natCast,
            h_val_cast, h_val_cast, h_val_cast, Pi.add_apply, sub_self]
      have h_Sigma_sum : ∀ (s_fin : Finset (Fin N × Fin m × Γ))
          (f : Fin N × Fin m × Γ → (Fin m × Fin N → Λ_s)),
          Sigma_Q m (∑ a ∈ s_fin, f a) - ∑ a ∈ s_fin, Sigma_Q m (f a) ∈ Rel_of (Fin m → R) := by
        intro s_fin f
        induction s_fin using Finset.cons_induction with
        | empty =>
          have h0 : Sigma_Q m 0 = 0 := by
            funext i k
            simp [Sigma_Q, s_scalar]
          simp [h0]
        | cons a s_fin has ih =>
          rw [Finset.sum_cons, Finset.sum_cons]
          have h1 := h_Sigma_add (f a) (∑ b ∈ s_fin, f b)
          have h_eq : Sigma_Q m (f a + ∑ b ∈ s_fin, f b) - (Sigma_Q m (f a) + ∑ b ∈ s_fin, Sigma_Q m (f b)) =
              (Sigma_Q m (f a + ∑ b ∈ s_fin, f b) - (Sigma_Q m (f a) + Sigma_Q m (∑ b ∈ s_fin, f b))) +
              (Sigma_Q m (∑ b ∈ s_fin, f b) - ∑ b ∈ s_fin, Sigma_Q m (f b)) := by abel
          rw [h_eq]
          exact add_mem h1 ih
      let elem_v : Fin N × Fin m × Γ → (Fin N → (Fin m → R)) := fun ⟨j₀, k₀, τ₀⟩ =>
        Pi.single j₀ (Pi.single k₀ (MonoidAlgebra.single τ₀ ((v j₀ k₀).coeff τ₀)))
      have hv_decomp : v = ∑ p : Fin N × Fin m × Γ, elem_v p := by
        funext j k
        apply MonoidAlgebra.coeff_injective
        ext τ
        rw [Finset.sum_apply, Finset.sum_apply]
        change (v j k).coeff τ = coeffHom τ (∑ p : Fin N × Fin m × Γ, elem_v p j k)
        rw [map_sum (coeffHom τ), Finset.sum_eq_single (j, k, τ)]
        · change (v j k).coeff τ = (elem_v (j, k, τ) j k).coeff τ
          simp only [elem_v, Pi.single_eq_same, MonoidAlgebra.coeff_single, Finsupp.single_apply,
            ↓reduceIte]
        · rintro ⟨j₀, k₀, τ₀⟩ _ hne
          change (elem_v (j₀, k₀, τ₀) j k).coeff τ = 0
          by_cases hj : j = j₀
          · subst hj
            by_cases hk : k = k₀
            · subst hk
              have hτ : τ₀ ≠ τ := fun h => hne (by rw [h])
              simp only [elem_v, Pi.single_eq_same, MonoidAlgebra.coeff_single, Finsupp.single_apply,
                hτ, ↓reduceIte]
            · simp [elem_v, Pi.single_eq_of_ne hk]
          · simp [elem_v, Pi.single_eq_of_ne hj]
        · intro hp; exact False.elim (hp (Finset.mem_univ _))
      have h_elem_rel : ∀ p : Fin N × Fin m × Γ,
          elem_v p - Sigma_Q m (Theta_Q m (elem_v p)) ∈ Rel_of (Fin m → R) := by
        rintro ⟨j₀, k₀, τ₀⟩
        let c_K : Λ_K := (v j₀ k₀).coeff τ₀
        let w : Fin N → (Fin m → R) := Pi.single j₀ (Pi.single k₀ (s_scalar c_K))
        let u_gen : Fin N → (Fin m → R) :=
          (fun i => (MonoidAlgebra.single τ₀ (1 : Λ_K) : R) • w i) -
          (fun i => ∑ j : Fin N, s_scalar (((τ_rep τ₀⁻¹).val i j).val : Λ_K) • w j)
        have hu_gen_mem : u_gen ∈ Rel_of (Fin m → R) :=
          AddSubgroup.subset_closure (Or.inr ⟨τ₀, w, rfl⟩)
        have h_u1_eq : (fun i => (MonoidAlgebra.single τ₀ (1 : Λ_K) : R) • w i) = elem_v (j₀, k₀, τ₀) := by
          funext i k
          by_cases hi : i = j₀
          · subst hi
            by_cases hk : k = k₀
            · subst hk
              simp [w, elem_v, s_scalar, c_K, Pi.single_eq_same, MonoidAlgebra.single_mul_single]
            · simp [w, elem_v, Pi.single_eq_of_ne hk]
          · simp [w, elem_v, Pi.single_eq_of_ne hi]
        let w₂ : Fin N → (Fin m → R) :=
          fun i => ∑ j : Fin N, s_scalar (((τ_rep τ₀⁻¹).val i j).val : Λ_K) • w j
        have h_w₂_diff : w₂ - Sigma_Q m (Theta_Q m (elem_v (j₀, k₀, τ₀))) ∈ Rel_of (Fin m → R) := by
          apply h_cast_zero_rel
          · intro i k τ hτ
            have hw₂_coeff : (w₂ i k).coeff τ = 0 := by
              simp only [w₂, Finset.sum_apply]
              change coeffHom τ (∑ j : Fin N, _) = 0
              rw [map_sum (coeffHom τ)]
              refine Finset.sum_eq_zero fun j _ => ?_
              · by_cases hj : j = j₀
                · subst hj
                  by_cases hk : k = k₀
                  · subst hk
                    change ((s_scalar _ • w j) k).coeff τ = 0
                    simp only [w, Pi.smul_apply, smul_eq_mul, Pi.single_eq_same]
                    change (MonoidAlgebra.single (1 : Γ) _ * MonoidAlgebra.single (1 : Γ) c_K).coeff τ = 0
                    rw [MonoidAlgebra.single_mul_single, one_mul, MonoidAlgebra.coeff_single,
                      Finsupp.single_apply]
                    simp [Ne.symm hτ]
                  · simp [coeffHom, w, Pi.single_eq_of_ne hk]
                · simp [coeffHom, w, Pi.single_eq_of_ne hj]
            change (w₂ i k - Sigma_Q m _ i k).coeff τ = 0
            rw [h_coeff_sub, hw₂_coeff, zero_sub, neg_eq_zero]
            simp only [Sigma_Q, s_scalar, MonoidAlgebra.coeff_single, Finsupp.single_apply]
            simp [Ne.symm hτ]
          · intro i k
            change cast_s ((w₂ i k - Sigma_Q m (Theta_Q m (elem_v (j₀, k₀, τ₀))) i k).coeff 1) = 0
            rw [h_coeff_sub, map_sub, sub_eq_zero]
            have hw₂_1 : cast_s ((w₂ i k).coeff 1) =
                if k = k₀ then cast_s c_K * ((τ_rep τ₀⁻¹).val i j₀) else 0 := by
              simp only [w₂, Finset.sum_apply]
              change cast_s (coeffHom 1 (∑ j : Fin N, _)) = _
              rw [map_sum (coeffHom 1), Finset.sum_eq_single j₀]
              · by_cases hk : k = k₀
                · subst hk
                  change cast_s (((s_scalar _ • w j₀) k).coeff 1) = _
                  simp only [↓reduceIte, w, Pi.smul_apply, smul_eq_mul, Pi.single_eq_same]
                  change cast_s ((MonoidAlgebra.single (1 : Γ) _ * MonoidAlgebra.single (1 : Γ) c_K).coeff 1) = _
                  rw [MonoidAlgebra.single_mul_single, one_mul, MonoidAlgebra.coeff_single,
                    Finsupp.single_apply]
                  simp only [↓reduceIte, map_mul, map_natCast, h_val_cast, mul_comm]
                · simp [hk, w]
              · intro j _ hj
                simp [w, Pi.single_eq_of_ne hj]
              · intro hj₀; exact False.elim (hj₀ (Finset.mem_univ j₀))
            have hTh_1 : cast_s ((Sigma_Q m (Theta_Q m (elem_v (j₀, k₀, τ₀))) i k).coeff 1) =
                if k = k₀ then cast_s c_K * ((τ_rep τ₀⁻¹).val i j₀) else 0 := by
              change cast_s ((MonoidAlgebra.single (1 : Γ)
                ((Theta_Q m (elem_v (j₀, k₀, τ₀)) (k, i)).val : Λ_K)).coeff 1) = _
              rw [MonoidAlgebra.coeff_single, Finsupp.single_apply]
              simp only [↓reduceIte, map_natCast, h_val_cast]
              change (∑ j : Fin N, ∑ τ : Γ,
                cast_s ((elem_v (j₀, k₀, τ₀) j k).coeff τ) * ((τ_rep τ⁻¹).val i j)) = _
              rw [Finset.sum_eq_single j₀]
              · by_cases hk : k = k₀
                · subst hk
                  simp only [↓reduceIte, elem_v, Pi.single_eq_same]
                  rw [Finset.sum_eq_single τ₀]
                  · rw [MonoidAlgebra.coeff_single, Finsupp.single_apply]; simp [c_K]
                  · intro τ _ hτ
                    rw [MonoidAlgebra.coeff_single, Finsupp.single_apply]
                    simp [Ne.symm hτ]
                  · intro hτ₀; exact False.elim (hτ₀ (Finset.mem_univ τ₀))
                · simp [hk, elem_v]
              · intro j _ hj
                simp [elem_v, Pi.single_eq_of_ne hj]
              · intro hj₀; exact False.elim (hj₀ (Finset.mem_univ j₀))
            rw [hw₂_1, hTh_1]
        have h_split_eq : elem_v (j₀, k₀, τ₀) - Sigma_Q m (Theta_Q m (elem_v (j₀, k₀, τ₀))) =
            u_gen + (w₂ - Sigma_Q m (Theta_Q m (elem_v (j₀, k₀, τ₀)))) := by
          change _ = ((fun i => (MonoidAlgebra.single τ₀ (1 : Λ_K) : R) • w i) - w₂) + _
          rw [h_u1_eq]
          abel
        rw [h_split_eq]
        exact add_mem hu_gen_mem h_w₂_diff
      have h_part1 : (∑ p : Fin N × Fin m × Γ, (elem_v p - Sigma_Q m (Theta_Q m (elem_v p)))) ∈
          Rel_of (Fin m → R) := sum_mem fun p _ => h_elem_rel p
      have h_part2 : (Sigma_Q m (∑ p : Fin N × Fin m × Γ, Theta_Q m (elem_v p)) -
          ∑ p : Fin N × Fin m × Γ, Sigma_Q m (Theta_Q m (elem_v p))) ∈ Rel_of (Fin m → R) :=
        h_Sigma_sum Finset.univ (fun p => Theta_Q m (elem_v p))
      have h_total_eq : v - Sigma_Q m (Theta_Q m v) =
          (∑ p : Fin N × Fin m × Γ, (elem_v p - Sigma_Q m (Theta_Q m (elem_v p)))) -
          (Sigma_Q m (∑ p : Fin N × Fin m × Γ, Theta_Q m (elem_v p)) -
            ∑ p : Fin N × Fin m × Γ, Sigma_Q m (Theta_Q m (elem_v p))) := by
        have hTh_sum : Theta_Q m v = ∑ p : Fin N × Fin m × Γ, Theta_Q m (elem_v p) := by
          have hv_th : Theta_Q m v = Theta_Q m (∑ p : Fin N × Fin m × Γ, elem_v p) :=
            congrArg (Theta_Q m) hv_decomp
          rw [hv_th, map_sum]
        have hv_lhs : v - Sigma_Q m (Theta_Q m v) =
            (∑ p : Fin N × Fin m × Γ, elem_v p) - Sigma_Q m (Theta_Q m v) :=
          congrArg (fun t => t - Sigma_Q m (Theta_Q m v)) hv_decomp
        rw [hv_lhs, hTh_sum, Finset.sum_sub_distrib]
        abel
      rw [h_total_eq]
      exact sub_mem h_part1 h_part2
    have h_Theta_ker : ∀ (m : ℕ) (v : Fin N → (Fin m → R)),
        Theta_Q m v = 0 ↔ v ∈ Rel_of (Fin m → R) := by
      intro m v
      refine ⟨fun hv => ?_, h_Theta_Rel m v⟩
      have h1 := h_diff_Sigma_Rel m v
      have h0 : Sigma_Q m (Theta_Q m v) = 0 := by
        rw [hv]
        funext i k
        simp [Sigma_Q, s_scalar]
      rwa [h0, sub_zero] at h1
    have h_Theta_smul : ∀ (m : ℕ) (c : Λ_K) (v : Fin N → (Fin m → R)),
        Theta_Q m (fun i => s_scalar c • v i) = cast_s c • Theta_Q m v := by
      intro m c v
      funext ⟨k, i⟩
      change (∑ j : Fin N, ∑ τ : Γ,
        cast_s ((MonoidAlgebra.single (1 : Γ) c * v j k).coeff τ) * ((τ_rep τ⁻¹).val i j)) =
        cast_s c * ∑ j : Fin N, ∑ τ : Γ, cast_s ((v j k).coeff τ) * ((τ_rep τ⁻¹).val i j)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun τ _ => ?_
      rw [MonoidAlgebra.coeff_single_mul_apply, inv_one, one_mul, map_mul, mul_assoc]
    let map_Q : ∀ {m m' : ℕ}, ((Fin m → R) →ₗ[R] (Fin m' → R)) →
        ((Fin m × Fin N → Λ_s) →ₗ[Λ_s] (Fin m' × Fin N → Λ_s)) := fun {m m'} f =>
      { toFun := fun z => Theta_Q m' (fun i => f (Sigma_Q m z i))
        map_add' := fun z₁ z₂ => by
          have h_diff := h_Rel_map f _ (h_diff_Sigma_Rel m (Sigma_Q m z₁ + Sigma_Q m z₂))
          have h_eq : Theta_Q m (Sigma_Q m z₁ + Sigma_Q m z₂) = z₁ + z₂ := by
            rw [map_add, h_Theta_Sigma, h_Theta_Sigma]
          rw [h_eq] at h_diff
          have h0 := h_Theta_Rel m' _ h_diff
          have h_sub : Theta_Q m' (fun i => f ((Sigma_Q m z₁ + Sigma_Q m z₂) i)) -
              Theta_Q m' (fun i => f (Sigma_Q m (z₁ + z₂) i)) = 0 := by
            have : (fun i => f ((Sigma_Q m z₁ + Sigma_Q m z₂) i)) -
                (fun i => f (Sigma_Q m (z₁ + z₂) i)) =
                (fun i => f ((Sigma_Q m z₁ + Sigma_Q m z₂ - Sigma_Q m (z₁ + z₂)) i)) :=
              funext fun i => (map_sub f _ _).symm
            rw [← map_sub, this]
            exact h0
          have h_add : Theta_Q m' (fun i => f ((Sigma_Q m z₁ + Sigma_Q m z₂) i)) =
              Theta_Q m' (fun i => f (Sigma_Q m z₁ i)) +
                Theta_Q m' (fun i => f (Sigma_Q m z₂ i)) := by
            have : (fun i => f ((Sigma_Q m z₁ + Sigma_Q m z₂) i)) =
                (fun i => f (Sigma_Q m z₁ i)) + (fun i => f (Sigma_Q m z₂ i)) :=
              funext fun i => map_add f _ _
            rw [this, map_add]
          exact (sub_eq_zero.mp h_sub).symm.trans h_add
        map_smul' := fun c z => by
          rw [RingHom.id_apply]
          have h_sc : Theta_Q m (fun i => s_scalar (c.val : Λ_K) • Sigma_Q m z i) = c • z := by
            rw [h_Theta_smul, h_Theta_Sigma, map_natCast, h_val_cast]
          have h_diff := h_Rel_map f _
            (h_diff_Sigma_Rel m (fun i => s_scalar (c.val : Λ_K) • Sigma_Q m z i))
          rw [h_sc] at h_diff
          have h0 := h_Theta_Rel m' _ h_diff
          have h1 : Theta_Q m' (fun i => f (Sigma_Q m (c • z) i)) =
              Theta_Q m' (fun i => f (s_scalar (c.val : Λ_K) • Sigma_Q m z i)) := by
            symm
            apply sub_eq_zero.mp
            have : (fun i => f (s_scalar (c.val : Λ_K) • Sigma_Q m z i)) -
                (fun i => f (Sigma_Q m (c • z) i)) =
                (fun i => f (((fun j => s_scalar (c.val : Λ_K) • Sigma_Q m z j) -
                  Sigma_Q m (c • z)) i)) :=
              funext fun i => (map_sub f _ _).symm
            rw [← map_sub, this]
            exact h0
          rw [h1]
          have h2 : (fun i => f (s_scalar (c.val : Λ_K) • Sigma_Q m z i)) =
              (fun i => s_scalar (c.val : Λ_K) • f (Sigma_Q m z i)) :=
            funext fun i => map_smul f _ _
          rw [h2, h_Theta_smul, map_natCast, h_val_cast] }
    have h_map_Q_apply : ∀ {m m' : ℕ} (f : (Fin m → R) →ₗ[R] (Fin m' → R))
        (v : Fin N → (Fin m → R)), map_Q f (Theta_Q m v) = Theta_Q m' (fun i => f (v i)) := by
      intro m m' f v
      symm
      apply sub_eq_zero.mp
      change Theta_Q m' (fun i => f (v i)) - Theta_Q m' (fun i => f (Sigma_Q m (Theta_Q m v) i)) = 0
      have h_sub : (fun i => f (v i)) - (fun i => f (Sigma_Q m (Theta_Q m v) i)) =
          (fun i => f ((v - Sigma_Q m (Theta_Q m v)) i)) :=
        funext fun i => (map_sub f _ _).symm
      rw [← map_sub, h_sub]
      exact h_Theta_Rel m' _ (h_Rel_map f _ (h_diff_Sigma_Rel m v))
    have h_map_Q_comp : ∀ {m₁' m₂' m₃' : ℕ} (g : (Fin m₂' → R) →ₗ[R] (Fin m₃' → R))
        (f : (Fin m₁' → R) →ₗ[R] (Fin m₂' → R)),
        (map_Q g).comp (map_Q f) = map_Q (g.comp f) := by
      intro m₁' m₂' m₃' g f
      apply LinearMap.ext
      intro z
      rw [← h_Theta_Sigma m₁' z, LinearMap.comp_apply, h_map_Q_apply, h_map_Q_apply, h_map_Q_apply]
      rfl
    let lift_QM : ∀ {m : ℕ} {X I : Type u} [AddCommGroup X] [Module R X]
        [AddCommGroup I] [Module Λ_s I]
        (q_M : (Fin N → X) →+ I),
        (∀ (c : Λ_K) (v : Fin N → X), q_M (fun i => s_scalar c • v i) = cast_s c • q_M v) →
        q_M.ker = Rel_of X →
        ((Fin m → R) →ₗ[R] X) → ((Fin m × Fin N → Λ_s) →ₗ[Λ_s] I) :=
      fun {m X I} _ _ _ _ q_M hq_smul hq_ker γ =>
        { toFun := fun z => q_M (fun i => γ (Sigma_Q m z i))
          map_add' := fun z₁ z₂ => by
            have h_diff := h_Rel_map γ _ (h_diff_Sigma_Rel m (Sigma_Q m z₁ + Sigma_Q m z₂))
            have h_eq : Theta_Q m (Sigma_Q m z₁ + Sigma_Q m z₂) = z₁ + z₂ := by
              rw [map_add, h_Theta_Sigma, h_Theta_Sigma]
            rw [h_eq, ← hq_ker] at h_diff
            have h_sub : q_M (fun i => γ ((Sigma_Q m z₁ + Sigma_Q m z₂) i)) -
                q_M (fun i => γ (Sigma_Q m (z₁ + z₂) i)) = 0 := by
              have : (fun i => γ ((Sigma_Q m z₁ + Sigma_Q m z₂) i)) -
                  (fun i => γ (Sigma_Q m (z₁ + z₂) i)) =
                  (fun i => γ ((Sigma_Q m z₁ + Sigma_Q m z₂ - Sigma_Q m (z₁ + z₂)) i)) :=
                funext fun i => (map_sub γ _ _).symm
              rw [← map_sub, this]
              exact h_diff
            have h_add : q_M (fun i => γ ((Sigma_Q m z₁ + Sigma_Q m z₂) i)) =
                q_M (fun i => γ (Sigma_Q m z₁ i)) + q_M (fun i => γ (Sigma_Q m z₂ i)) := by
              have : (fun i => γ ((Sigma_Q m z₁ + Sigma_Q m z₂) i)) =
                  (fun i => γ (Sigma_Q m z₁ i)) + (fun i => γ (Sigma_Q m z₂ i)) :=
                funext fun i => map_add γ _ _
              rw [this, map_add]
            exact (sub_eq_zero.mp h_sub).symm.trans h_add
          map_smul' := fun c z => by
            rw [RingHom.id_apply]
            have h_sc : Theta_Q m (fun i => s_scalar (c.val : Λ_K) • Sigma_Q m z i) = c • z := by
              rw [h_Theta_smul, h_Theta_Sigma, map_natCast, h_val_cast]
            have h_diff := h_Rel_map γ _
              (h_diff_Sigma_Rel m (fun i => s_scalar (c.val : Λ_K) • Sigma_Q m z i))
            rw [h_sc, ← hq_ker] at h_diff
            have h1 : q_M (fun i => γ (Sigma_Q m (c • z) i)) =
                q_M (fun i => γ (s_scalar (c.val : Λ_K) • Sigma_Q m z i)) := by
              symm
              apply sub_eq_zero.mp
              have : (fun i => γ (s_scalar (c.val : Λ_K) • Sigma_Q m z i)) -
                  (fun i => γ (Sigma_Q m (c • z) i)) =
                  (fun i => γ (((fun j => s_scalar (c.val : Λ_K) • Sigma_Q m z j) -
                    Sigma_Q m (c • z)) i)) :=
                funext fun i => (map_sub γ _ _).symm
              rw [← map_sub, this]
              exact h_diff
            rw [h1]
            have h2 : (fun i => γ (s_scalar (c.val : Λ_K) • Sigma_Q m z i)) =
                (fun i => s_scalar (c.val : Λ_K) • γ (Sigma_Q m z i)) :=
              funext fun i => map_smul γ _ _
            rw [h2, hq_smul, map_natCast, h_val_cast] }
    have h_lift_QM_apply : ∀ {m : ℕ} {X I : Type u} [AddCommGroup X] [Module R X]
        [AddCommGroup I] [Module Λ_s I] (q_M : (Fin N → X) →+ I)
        (hq_smul : ∀ (c : Λ_K) (v : Fin N → X), q_M (fun i => s_scalar c • v i) = cast_s c • q_M v)
        (hq_ker : q_M.ker = Rel_of X) (γ : (Fin m → R) →ₗ[R] X) (v : Fin N → (Fin m → R)),
        lift_QM q_M hq_smul hq_ker γ (Theta_Q m v) = q_M (fun i => γ (v i)) := by
      intro m X I _ _ _ _ q_M hq_smul hq_ker γ v
      symm
      apply sub_eq_zero.mp
      have h_diff := h_Rel_map γ _ (h_diff_Sigma_Rel m v)
      rw [← hq_ker] at h_diff
      have : (fun i => γ (v i)) - (fun i => γ (Sigma_Q m (Theta_Q m v) i)) =
          (fun i => γ ((v - Sigma_Q m (Theta_Q m v)) i)) :=
        funext fun i => (map_sub γ _ _).symm
      change q_M (fun i => γ (v i)) - q_M (fun i => γ (Sigma_Q m (Theta_Q m v) i)) = 0
      rw [← map_sub, this]
      exact h_diff
    have h_lift_QM₀_apply : ∀ {m : ℕ} (γ : (Fin m → R) →ₗ[R] M.M₀) (v : Fin N → (Fin m → R)),
        lift_QM q_M₀ hqM₀_smul' hqM₀_ker' γ (Theta_Q m v) = q_M₀ (fun i => γ (v i)) :=
      fun γ v => h_lift_QM_apply q_M₀ hqM₀_smul' hqM₀_ker' γ v
    have h_lift_QM₁_apply : ∀ {m : ℕ} (γ : (Fin m → R) →ₗ[R] M.M₁) (v : Fin N → (Fin m → R)),
        lift_QM q_M₁ hqM₁_smul' hqM₁_ker' γ (Theta_Q m v) = q_M₁ (fun i => γ (v i)) :=
      fun γ v => h_lift_QM_apply q_M₁ hqM₁_smul' hqM₁_ker' γ v
    have h_lift_QM₂_apply : ∀ {m : ℕ} (γ : (Fin m → R) →ₗ[R] M.M₂) (v : Fin N → (Fin m → R)),
        lift_QM q_M₂ hqM₂_smul' hqM₂_ker' γ (Theta_Q m v) = q_M₂ (fun i => γ (v i)) :=
      fun γ v => h_lift_QM_apply q_M₂ hqM₂_smul' hqM₂_ker' γ v
    have h_tr_toMatrix' : ∀ {n : ℕ} (f : (Fin n → Λ_s) →ₗ[Λ_s] (Fin n → Λ_s)),
        (LinearMap.toMatrix' f).trace = LinearMap.trace Λ_s (Fin n → Λ_s) f := by
      intro n f
      rw [LinearMap.trace_eq_matrix_trace Λ_s (Pi.basisFun Λ_s (Fin n)) f]
      congr 1
    have h_tr_map_Q : ∀ {m : ℕ} (Ψ : (Fin m → R) →ₗ[R] (Fin m → R)),
        LinearMap.trace Λ_s (Fin m × Fin N → Λ_s) (map_Q Ψ) =
        ∑ c : Γ, (∑ k : Fin m, cast_s (((Ψ (Pi.single k 1)) k).coeff c⁻¹)) *
          Matrix.trace (τ_rep c).val := by
      intro m Ψ
      let eqv := Fintype.equivFin (Fin m × Fin N)
      let e_coord : (Fin m × Fin N → Λ_s) ≃ₗ[Λ_s] (Fin (Fintype.card (Fin m × Fin N)) → Λ_s) :=
        LinearEquiv.funCongrLeft Λ_s Λ_s eqv.symm
      rw [← LinearMap.trace_conj' (map_Q Ψ) e_coord, ← h_tr_toMatrix']
      change ∑ idx : Fin (Fintype.card (Fin m × Fin N)),
        (e_coord.conj (map_Q Ψ)) (Pi.single idx 1) idx = _
      rw [← eqv.sum_comp]
      have h_diag : ∀ p : Fin m × Fin N,
