      have ht_ev := congrArg (fun φ => asLC φ y) (ht g hg)
      have ht_lhs : asLC ((L_pre ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)).map
          (Opposite.op g) t) y = asLC t (g.left.base y) := rfl
      exact (ht_lhs.symm.trans ht_ev).trans (hs_fn_eq g hg y).symm
    have hL_sheaf : CategoryTheory.Presheaf.IsSheaf J_top L_pre := by
      intro E U S_sieve hS x hx
      have hFor := hSheaf_type S_sieve hS
      let fam_e : ↑E → CategoryTheory.Presieve.FamilyOfElements
          (L_pre ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)) S_sieve.arrows :=
        fun e _ g hg => (x g hg).hom e
      have hx_pt : ∀ e : ↑E, (fam_e e).Compatible := by
        intro e Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
        exact congrArg (fun (φ : Quiver.Hom E _) => φ.hom e) (hx g₁ g₂ hf₁ hf₂ hcomm)
      let t_fn : ↑E → LocallyConstant ↥((Fgt.obj U).left) R :=
        fun e => Classical.choose (hFor (fam_e e) (hx_pt e))
      have ht_spec : ∀ (e : ↑E) {V : S.Etale} (g : Quiver.Hom V U) (hg : S_sieve.arrows g),
          (L_pre.map (Opposite.op g)).hom (t_fn e) = (x g hg).hom e :=
        fun e _ g hg => (Classical.choose_spec (hFor (fam_e e) (hx_pt e))).1 g hg
      have ht_uniq : ∀ (e : ↑E) (y : LocallyConstant ↥((Fgt.obj U).left) R),
          (∀ {V : S.Etale} (g : Quiver.Hom V U) (hg : S_sieve.arrows g),
            (L_pre.map (Opposite.op g)).hom y = (x g hg).hom e) →
          y = t_fn e :=
        fun e y hy => (Classical.choose_spec (hFor (fam_e e) (hx_pt e))).2 y (fun _ g hg => hy g hg)
      let t_hom : Quiver.Hom E (L_pre.obj (Opposite.op U)) :=
        ModuleCat.ofHom
          { toFun := t_fn
            map_add' := fun e₁ e₂ => (ht_uniq (e₁ + e₂) (t_fn e₁ + t_fn e₂) fun g hg => by
              rw [map_add, ht_spec e₁ g hg, ht_spec e₂ g hg, ← map_add]).symm
            map_smul' := fun r e => (ht_uniq (r • e) (r • t_fn e) fun g hg => by
              rw [map_smul, ht_spec e g hg, ← map_smul]).symm }
      refine ⟨t_hom, fun _ g hg => ModuleCat.hom_ext (LinearMap.ext fun e => ht_spec e g hg),
        fun y_hom hy => ModuleCat.hom_ext (LinearMap.ext fun e =>
          ht_uniq e (y_hom.hom e) fun g hg => congrArg (fun (φ : Quiver.Hom E _) => φ.hom e) (hy g hg))⟩
    let L_sh : CategoryTheory.Sheaf J_top (ModuleCat.{u, u} R) := ⟨L_pre, hL_sheaf⟩
    let ι_lc : Quiver.Hom P_const L_pre :=
      { app := fun _ => ModuleCat.ofHom (LocallyConstant.constₗ R)
        naturality := fun _ _ _ => ModuleCat.hom_ext (LinearMap.ext fun _ => LocallyConstant.ext fun _ => rfl) }
    let Φ : Quiver.Hom oneR L_sh := (adj_sh.homEquiv P_const L_sh).symm ι_lc
    let ev_fn : ∀ U : S.Etale,
        ↑(oneR.obj.obj (Opposite.op U)) →ₗ[R] LocallyConstant ↥((Fgt.obj U).left) R :=
      fun U => (Φ.hom.app (Opposite.op U)).hom
    have hΦ_unit : CategoryTheory.CategoryStruct.comp η_sh Φ.hom = ι_lc := by
      have h1 : (adj_sh.homEquiv P_const L_sh) Φ = ι_lc :=
        (adj_sh.homEquiv P_const L_sh).apply_symm_apply ι_lc
      exact (CategoryTheory.Adjunction.homEquiv_unit adj_sh P_const L_sh Φ).symm.trans h1
    have h_res_fn : ∀ {U₁ U₂ : S.Etale} (u : Quiver.Hom U₁ U₂)
        (s : ↑(oneR.obj.obj (Opposite.op U₂))) (z : ↥((Fgt.obj U₁).left)),
        ev_fn U₁ ((oneR.obj.map (Opposite.op u)).hom s) z =
          ev_fn U₂ s (((Fgt.map u).left).base z) := by
      intro U₁ U₂ u s z
      exact congrArg (fun (φ : Quiver.Hom (oneR.obj.obj (Opposite.op U₂))
        (L_pre.obj (Opposite.op U₁))) =>
        (φ.hom s : LocallyConstant ↥((Fgt.obj U₁).left) R) z) (Φ.hom.naturality (Opposite.op u))
    have h_unit_fn : ∀ (U : S.Etale) (r : R) (z : ↥((Fgt.obj U).left)),
        ev_fn U ((η_sh.app (Opposite.op U)).hom r) z = r := by
      intro U r z
      exact congrArg (fun (τ : Quiver.Hom P_const L_pre) =>
        ((τ.app (Opposite.op U)).hom r : LocallyConstant ↥((Fgt.obj U).left) R) z) hΦ_unit
    have hOne_type : CategoryTheory.Presieve.IsSheaf J_top
        (oneR.obj ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type J_top _).mp
        (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J_top oneR.obj
          (CategoryTheory.forget (ModuleCat.{u, u} R)) oneR.property)
    have hArrows_sheaf : ∀ (U : S.Etale) {ι : Type u} (Y : ι → S.Etale)
        (π : ∀ i : ι, Quiver.Hom (Y i) U),
        (∀ x : ↥U.left, ∃ i : ι, x ∈ Set.range ⇑(π i).left.base) →
        ∀ (sec : ∀ i : ι, ↑(oneR.obj.obj (Opposite.op (Y i)))),
        (∀ (i j : ι) (Z : S.Etale) (g₁ : Quiver.Hom Z (Y i)) (g₂ : Quiver.Hom Z (Y j)),
          CategoryTheory.CategoryStruct.comp g₁ (π i) =
            CategoryTheory.CategoryStruct.comp g₂ (π j) →
          (oneR.obj.map (Opposite.op g₁)).hom (sec i) =
            (oneR.obj.map (Opposite.op g₂)).hom (sec j)) →
        ∃! t : ↑(oneR.obj.obj (Opposite.op U)),
          ∀ i : ι, (oneR.obj.map (Opposite.op (π i))).hom t = sec i := by
      intro U ι Y π hcov sec hsec
      have hFor : CategoryTheory.Presieve.IsSheafFor
          (oneR.obj ⋙ CategoryTheory.forget (ModuleCat.{u, u} R))
          (CategoryTheory.Presieve.ofArrows Y π) :=
        CategoryTheory.Presieve.IsSheaf.isSheafFor hOne_type
          (CategoryTheory.Presieve.ofArrows Y π) (hArrows_mem U Y π hcov)
      rw [CategoryTheory.Presieve.isSheafFor_arrows_iff] at hFor
      exact hFor sec hsec
    have hEmpty_sub : ∀ (Z : S.Etale), IsEmpty ↥Z.left →
        Subsingleton ↑(oneR.obj.obj (Opposite.op Z)) := by
      intro Z hZ
      refine ⟨fun s₁ s₂ => ?_⟩
      obtain ⟨t, -, ht_uniq⟩ := hArrows_sheaf Z (ι := PEmpty.{u + 1})
        PEmpty.elim (fun i => PEmpty.elim i) (fun x => IsEmpty.elim hZ x)
        (fun i => PEmpty.elim i) (fun i => PEmpty.elim i)
      exact (ht_uniq s₁ fun i => PEmpty.elim i).trans (ht_uniq s₂ fun i => PEmpty.elim i).symm
    have hη_map : ∀ {U₁ U₂ : S.Etale} (g : Quiver.Hom U₁ U₂) (r : R),
        (oneR.obj.map (Opposite.op g)).hom ((η_sh.app (Opposite.op U₂)).hom r) =
          (η_sh.app (Opposite.op U₁)).hom r :=
      fun g r => (congrArg (fun (φ : Quiver.Hom R_mod _) => φ.hom r) (η_sh.naturality (Opposite.op g))).symm
    have hOne_map_comp : ∀ {U₁ U₂ U₃ : S.Etale} (a : Quiver.Hom U₁ U₂) (b : Quiver.Hom U₂ U₃)
        (s : ↑(oneR.obj.obj (Opposite.op U₃))),
        (oneR.obj.map (Opposite.op (CategoryTheory.CategoryStruct.comp a b))).hom s =
          (oneR.obj.map (Opposite.op a)).hom ((oneR.obj.map (Opposite.op b)).hom s) := by
      intro U₁ U₂ U₃ a b s
      have hop : Opposite.op (CategoryTheory.CategoryStruct.comp a b) =
          CategoryTheory.CategoryStruct.comp
            (X := Opposite.op U₃) (Y := Opposite.op U₂) (Z := Opposite.op U₁)
            (Opposite.op b) (Opposite.op a) := rfl
      rw [hop, CategoryTheory.Functor.map_comp]
      rfl
    let W_open : ∀ (U : S.Etale) (f : LocallyConstant ↥((Fgt.obj U).left) R)
        (x : ↥((Fgt.obj U).left)), U.left.Opens :=
      fun U f x => ⟨(f : ↥U.left → R) ⁻¹' {f x}, f.isLocallyConstant {f x}⟩
    let Y_lvl : ∀ (U : S.Etale) (f : LocallyConstant ↥((Fgt.obj U).left) R)
        (x : ↥((Fgt.obj U).left)), S.Etale :=
      fun U f x => CategoryTheory.MorphismProperty.Over.mk ⊤
        (CategoryTheory.CategoryStruct.comp (W_open U f x).ι U.hom)
        (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          (W_open U f x).ι U.hom inferInstance U.prop)
    let π_lvl : ∀ (U : S.Etale) (f : LocallyConstant ↥((Fgt.obj U).left) R)
        (x : ↥((Fgt.obj U).left)), Quiver.Hom (Y_lvl U f x) U :=
      fun U f x => CategoryTheory.MorphismProperty.Over.homMk (W_open U f x).ι rfl
    have hlvl_cov : ∀ (U : S.Etale) (f : LocallyConstant ↥((Fgt.obj U).left) R) (x : ↥U.left),
        ∃ i : ↥((Fgt.obj U).left), x ∈ Set.range ⇑(π_lvl U f i).left.base :=
      fun U f x => ⟨x, ⟨x, rfl⟩, rfl⟩
    have hψ_ex : ∀ (U : S.Etale) (f : LocallyConstant ↥((Fgt.obj U).left) R),
        ∃! t : ↑(oneR.obj.obj (Opposite.op U)),
          ∀ x : ↥((Fgt.obj U).left),
            (oneR.obj.map (Opposite.op (π_lvl U f x))).hom t =
              (η_sh.app (Opposite.op (Y_lvl U f x))).hom (f x) := by
      intro U f
      apply hArrows_sheaf U (Y_lvl U f) (π_lvl U f) (hlvl_cov U f)
      intro x₁ x₂ Z g₁ g₂ hcomm
      by_cases hZ : IsEmpty ↥Z.left
      · have _ := hEmpty_sub Z hZ
        exact Subsingleton.elim _ _
      · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hZ
        have hz₁ : f (((CategoryTheory.CategoryStruct.comp g₁ (π_lvl U f x₁)).left).base z₀) =
            f x₁ := (g₁.left.base z₀).2
        have hz₂ : f (((CategoryTheory.CategoryStruct.comp g₂ (π_lvl U f x₂)).left).base z₀) =
            f x₂ := (g₂.left.base z₀).2
        have hfx : f x₁ = f x₂ := by rw [← hz₁, ← hz₂, hcomm]
        exact (hη_map g₁ (f x₁)).trans ((congrArg _ hfx).trans (hη_map g₂ (f x₂)).symm)
    let ψ_fun : ∀ (U : S.Etale), LocallyConstant ↥((Fgt.obj U).left) R →
        ↑(oneR.obj.obj (Opposite.op U)) :=
      fun U f => Classical.choose (hψ_ex U f)
    have hψ_spec : ∀ (U : S.Etale) (f : LocallyConstant ↥((Fgt.obj U).left) R)
        (x : ↥((Fgt.obj U).left)),
        (oneR.obj.map (Opposite.op (π_lvl U f x))).hom (ψ_fun U f) =
          (η_sh.app (Opposite.op (Y_lvl U f x))).hom (f x) :=
      fun U f => (Classical.choose_spec (hψ_ex U f)).1
    have hψ_uniq : ∀ (U : S.Etale) (f : LocallyConstant ↥((Fgt.obj U).left) R)
        (t : ↑(oneR.obj.obj (Opposite.op U))),
        (∀ x : ↥((Fgt.obj U).left),
          (oneR.obj.map (Opposite.op (π_lvl U f x))).hom t =
            (η_sh.app (Opposite.op (Y_lvl U f x))).hom (f x)) →
        t = ψ_fun U f :=
      fun U f => (Classical.choose_spec (hψ_ex U f)).2
    have hψ_const : ∀ {V U : S.Etale} (g : Quiver.Hom V U)
        (f : LocallyConstant ↥((Fgt.obj U).left) R) (r : R),
        (∀ y : ↥V.left, f (g.left.base y) = r) →
        (oneR.obj.map (Opposite.op g)).hom (ψ_fun U f) =
          (η_sh.app (Opposite.op V)).hom r := by
      intro V U g f r hconst
      by_cases hV : IsEmpty ↥V.left
      · have _ := hEmpty_sub V hV
        exact Subsingleton.elim _ _
      · obtain ⟨y₀⟩ := not_isEmpty_iff.mp hV
        let x₀ : ↥((Fgt.obj U).left) := g.left.base y₀
        have hrx₀ : f x₀ = r := hconst y₀
        let W₀ : U.left.Opens := W_open U f x₀
        have hrange : Set.range ⇑g.left.base ⊆ Set.range ⇑W₀.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨y, rfl⟩
          change f (g.left.base y) = f x₀
          rw [hconst y, hrx₀]
        let l_left : Quiver.Hom V.left W₀.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift W₀.ι g.left hrange
        have hl_fac : CategoryTheory.CategoryStruct.comp l_left W₀.ι = g.left :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac W₀.ι g.left hrange
        have hl_w : CategoryTheory.CategoryStruct.comp l_left (Y_lvl U f x₀).hom = V.hom := by
          change l_left ≫ (W₀.ι ≫ U.hom) = V.hom
          rw [← CategoryTheory.Category.assoc, hl_fac]
          exact CategoryTheory.MorphismProperty.Over.w g
        let l : Quiver.Hom V (Y_lvl U f x₀) :=
          CategoryTheory.MorphismProperty.Over.homMk l_left hl_w
        have hl_eq : CategoryTheory.CategoryStruct.comp l (π_lvl U f x₀) = g :=
          CategoryTheory.MorphismProperty.Over.Hom.ext hl_fac
        exact (congrArg (fun φ => (oneR.obj.map (Opposite.op φ)).hom (ψ_fun U f)) hl_eq.symm).trans
          ((hOne_map_comp l (π_lvl U f x₀) (ψ_fun U f)).trans
            ((congrArg (oneR.obj.map (Opposite.op l)).hom (hψ_spec U f x₀)).trans
              ((hη_map l (f x₀)).trans (congrArg (η_sh.app (Opposite.op V)).hom hrx₀))))
    have hψ_add : ∀ (U : S.Etale) (f₁ f₂ : LocallyConstant ↥((Fgt.obj U).left) R),
        ψ_fun U (f₁ + f₂) = ψ_fun U f₁ + ψ_fun U f₂ := by
      intro U f₁ f₂
      let W₁₂ : ↥((Fgt.obj U).left) → U.left.Opens := fun x =>
        ⟨(f₁ : ↥U.left → R) ⁻¹' {f₁ x} ∩ (f₂ : ↥U.left → R) ⁻¹' {f₂ x},
          (f₁.isLocallyConstant {f₁ x}).inter (f₂.isLocallyConstant {f₂ x})⟩
      let Y₁₂ : ↥((Fgt.obj U).left) → S.Etale := fun x =>
        CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.CategoryStruct.comp (W₁₂ x).ι U.hom)
          (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            (W₁₂ x).ι U.hom inferInstance U.prop)
      let π₁₂ : ∀ x : ↥((Fgt.obj U).left), Quiver.Hom (Y₁₂ x) U :=
        fun x => CategoryTheory.MorphismProperty.Over.homMk (W₁₂ x).ι rfl
      have hcov₁₂ : ∀ x : ↥U.left, ∃ i : ↥((Fgt.obj U).left), x ∈ Set.range ⇑(π₁₂ i).left.base :=
        fun x => ⟨x, ⟨x, rfl, rfl⟩, rfl⟩
      obtain ⟨t, -, ht_uniq⟩ := hArrows_sheaf U Y₁₂ π₁₂ hcov₁₂
        (fun x => (η_sh.app (Opposite.op (Y₁₂ x))).hom (f₁ x + f₂ x))
        (fun x₁ x₂ Z g₁ g₂ hcomm => by
          by_cases hZ : IsEmpty ↥Z.left
          · have _ := hEmpty_sub Z hZ
            exact Subsingleton.elim _ _
          · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hZ
            have h1 : f₁ (((CategoryTheory.CategoryStruct.comp g₁ (π₁₂ x₁)).left).base z₀) = f₁ x₁ ∧
                f₂ (((CategoryTheory.CategoryStruct.comp g₁ (π₁₂ x₁)).left).base z₀) = f₂ x₁ :=
              (g₁.left.base z₀).2
            have h2 : f₁ (((CategoryTheory.CategoryStruct.comp g₂ (π₁₂ x₂)).left).base z₀) = f₁ x₂ ∧
                f₂ (((CategoryTheory.CategoryStruct.comp g₂ (π₁₂ x₂)).left).base z₀) = f₂ x₂ :=
              (g₂.left.base z₀).2
            rw [hcomm] at h1
            have hsum_eq : f₁ x₁ + f₂ x₁ = f₁ x₂ + f₂ x₂ := by
              rw [← h1.1, ← h1.2, h2.1, h2.2]
            exact (hη_map g₁ _).trans ((congrArg _ hsum_eq).trans (hη_map g₂ _).symm))
      have ht_lhs : ψ_fun U (f₁ + f₂) = t :=
        ht_uniq (ψ_fun U (f₁ + f₂)) fun x =>
          hψ_const (π₁₂ x) (f₁ + f₂) (f₁ x + f₂ x) fun y => by
            change f₁ y.1 + f₂ y.1 = f₁ x + f₂ x
            rw [y.2.1, y.2.2]
      have ht_rhs : ψ_fun U f₁ + ψ_fun U f₂ = t :=
        ht_uniq (ψ_fun U f₁ + ψ_fun U f₂) fun x =>
          (map_add (oneR.obj.map (Opposite.op (π₁₂ x))).hom (ψ_fun U f₁) (ψ_fun U f₂)).trans
            ((congrArg₂ (· + ·)
              (hψ_const (π₁₂ x) f₁ (f₁ x) (fun y => y.2.1))
              (hψ_const (π₁₂ x) f₂ (f₂ x) (fun y => y.2.2))).trans
              (map_add (η_sh.app (Opposite.op (Y₁₂ x))).hom (f₁ x) (f₂ x)).symm)
      exact ht_lhs.trans ht_rhs.symm
    have hψ_smul : ∀ (U : S.Etale) (r : R) (f : LocallyConstant ↥((Fgt.obj U).left) R),
        ψ_fun U (r • f) = r • ψ_fun U f := by
      intro U r f
      obtain ⟨t, -, ht_uniq⟩ := hArrows_sheaf U (Y_lvl U f) (π_lvl U f) (hlvl_cov U f)
        (fun x => (η_sh.app (Opposite.op (Y_lvl U f x))).hom (r • f x))
        (fun x₁ x₂ Z g₁ g₂ hcomm => by
          by_cases hZ : IsEmpty ↥Z.left
          · have _ := hEmpty_sub Z hZ
            exact Subsingleton.elim _ _
          · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hZ
            have hz₁ : f (((CategoryTheory.CategoryStruct.comp g₁ (π_lvl U f x₁)).left).base z₀) =
                f x₁ := (g₁.left.base z₀).2
            have hz₂ : f (((CategoryTheory.CategoryStruct.comp g₂ (π_lvl U f x₂)).left).base z₀) =
                f x₂ := (g₂.left.base z₀).2
            have hfx : f x₁ = f x₂ := by rw [← hz₁, ← hz₂, hcomm]
            exact (hη_map g₁ _).trans ((congrArg (fun v => (η_sh.app _).hom (r • v)) hfx).trans
              (hη_map g₂ _).symm))
      have ht_lhs : ψ_fun U (r • f) = t :=
        ht_uniq (ψ_fun U (r • f)) fun x =>
          hψ_const (π_lvl U f x) (r • f) (r • f x) fun y => by
            change r • f y.1 = r • f x
            rw [y.2]
      have ht_rhs : r • ψ_fun U f = t :=
        ht_uniq (r • ψ_fun U f) fun x =>
          (map_smul (oneR.obj.map (Opposite.op (π_lvl U f x))).hom r (ψ_fun U f)).trans
            ((congrArg (r • ·) (hψ_spec U f x)).trans
              (map_smul (η_sh.app (Opposite.op (Y_lvl U f x))).hom r (f x)).symm)
      exact ht_lhs.trans ht_rhs.symm
    let ψ_lin : ∀ U : S.Etale,
        LocallyConstant ↥((Fgt.obj U).left) R →ₗ[R] ↑(oneR.obj.obj (Opposite.op U)) :=
      fun U =>
        { toFun := ψ_fun U
          map_add' := hψ_add U
          map_smul' := hψ_smul U }
    let Ψ_nat : Quiver.Hom L_pre oneR.obj :=
      { app := fun U => ModuleCat.ofHom (ψ_lin U.unop)
        naturality := fun U₂ U₁ u => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro f
          let f₁ : LocallyConstant ↥((Fgt.obj U₁.unop).left) R := (L_pre.map u).hom f
          change ψ_fun U₁.unop f₁ = (oneR.obj.map u).hom (ψ_fun U₂.unop f)
          symm
          apply hψ_uniq U₁.unop f₁
          intro x
          exact (hOne_map_comp (π_lvl U₁.unop f₁ x) u.unop (ψ_fun U₂.unop f)).symm.trans
            (hψ_const (CategoryTheory.CategoryStruct.comp (π_lvl U₁.unop f₁ x) u.unop) f
              (f₁ x) fun y => y.2) }
    have hιΨ : CategoryTheory.CategoryStruct.comp ι_lc Ψ_nat = η_sh := by
      apply CategoryTheory.NatTrans.ext
      funext U
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro r
      have hid := hψ_const (CategoryTheory.CategoryStruct.id U.unop)
        (LocallyConstant.constₗ R r) r (fun _ => rfl)
      have hop : Opposite.op (CategoryTheory.CategoryStruct.id U.unop) =
          CategoryTheory.CategoryStruct.id U := rfl
      rw [hop, CategoryTheory.Functor.map_id] at hid
      exact hid
    let Ψ : Quiver.Hom L_sh oneR := { hom := Ψ_nat }
    have hΦΨ_id : CategoryTheory.CategoryStruct.comp Φ Ψ =
        CategoryTheory.CategoryStruct.id oneR := by
      let oneR' : CategoryTheory.Sheaf J_top (ModuleCat.{u, u} R) :=
        (CategoryTheory.presheafToSheaf J_top (ModuleCat.{u, u} R)).obj P_const
      let α₁ : Quiver.Hom oneR' oneR := CategoryTheory.CategoryStruct.comp Φ Ψ
      let α₂ : Quiver.Hom oneR' oneR := CategoryTheory.CategoryStruct.id oneR
      apply (adj_sh.homEquiv P_const oneR).injective
      have h_eq : CategoryTheory.CategoryStruct.comp η_sh α₁.hom =
          CategoryTheory.CategoryStruct.comp η_sh α₂.hom := by
        change η_sh ≫ (Φ.hom ≫ Ψ_nat) = η_sh ≫ CategoryTheory.CategoryStruct.id oneR.obj
        rw [← CategoryTheory.Category.assoc, hΦ_unit, hιΨ, CategoryTheory.Category.comp_id]
