    have hpb_dn : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst h_W ι_dn)
        (CategoryTheory.Limits.pullback.snd h_W ι_dn) h_W ι_dn :=
      CategoryTheory.IsPullback.of_hasPullback h_W ι_dn
    have hpb_up : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst h_W ι_up)
        (CategoryTheory.Limits.pullback.snd h_W ι_up) h_W ι_up :=
