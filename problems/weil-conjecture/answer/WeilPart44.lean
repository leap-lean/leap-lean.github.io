      · have hZ : IsEmpty ↥Z.left := ⟨fun z => by
          have hx₁ : ((CategoryTheory.CategoryStruct.comp a₁ (σ_g W g₁)).left).base z ∈
              Set.range ((Fgt.map (σ_g W g₁)).left).base := ⟨a₁.left.base z, rfl⟩
          have hx₂ : ((CategoryTheory.CategoryStruct.comp a₂ (σ_g W g₂)).left).base z ∈
              Set.range ((Fgt.map (σ_g W g₂)).left).base := ⟨a₂.left.base z, rfl⟩
          have hcomm_z : ((CategoryTheory.CategoryStruct.comp a₁ (σ_g W g₁)).left).base z =
