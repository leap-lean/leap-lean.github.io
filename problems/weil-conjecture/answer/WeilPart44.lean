      rw [← hx₁, ih K' hTF_K' x₁, CategoryTheory.Abelian.Ext.comp_zero]

  
  let Θ : ∀ (G_sh : C_R) (q : ℕ),
      CategoryTheory.Abelian.Ext.{u} oneR G_sh q →+
        CategoryTheory.Abelian.Ext.{u} FZ (U_of.obj G_sh) q := fun G_sh q =>
