          calc (((ℓ : Padic ℓ) ^ k_c)⁻¹ * ((ℓ : Padic ℓ) ^ k₁)⁻¹) *
              ((((ℓ : Padic ℓ) ^ k_c) * c) * B_int w₁ v)
              = ((((ℓ : Padic ℓ) ^ k_c)⁻¹ * ((ℓ : Padic ℓ) ^ k_c)) * c) *
                  (((ℓ : Padic ℓ) ^ k₁)⁻¹ * B_int w₁ v) := by ring
            _ = c * (((ℓ : Padic ℓ) ^ k₁)⁻¹ * B_int w₁ v) := by
                rw [inv_mul_cancel₀ hpow_c_ne, one_mul] }
    have hB_coinv_eval : ∀ (ψ : U₁) (k : ℕ) (w : ↥I_int),
        (∀ i : Fin N, algebraMap (PadicInt ℓ) (Padic ℓ) (w.1 i) =
          ((ℓ : Padic ℓ) ^ k) * vecOf ψ.1 i) →
        B_coinv ψ = (((ℓ : Padic ℓ) ^ k)⁻¹) • B_int w := by
      intro ψ k w hw
      exact hScaleIndep _ k _ w (vecOf ψ.1)
        (Classical.choose_spec (Classical.choose_spec (hLiftΨ ψ))) hw
    have hFrob_eq : ∀ (ψ ψ' : U₁) (z : V),
        ψ'.1 = ψ.1.comp (((A_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin) →
        B_coinv ψ (frob_V z) = (q_card : Padic ℓ) * B_coinv ψ' z := by
      intro ψ ψ' z hψ'
      obtain ⟨k, w, hw⟩ := hLiftΨ ψ
      let w'_raw : Fin N → PadicInt ℓ := ((A_u.val).transpose).mulVec w.1
      have hw'_scale : ∀ i : Fin N,
          algebraMap (PadicInt ℓ) (Padic ℓ) (w'_raw i) = ((ℓ : Padic ℓ) ^ k) * vecOf ψ'.1 i := by
        intro i
        have hv' := congrFun ((congrArg vecOf hψ').trans (hvec_comp_mat ψ.1 _)) i
        simp only [w'_raw, Matrix.mulVec, dotProduct, Matrix.transpose_apply,
          Matrix.map_apply] at hv' ⊢
        rw [map_sum, hv', Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => by rw [map_mul, hw j]; ring
      let w' : ↥I_int := ⟨w'_raw, hmem_I_of_scale ψ' k w'_raw hw'_scale⟩
      rw [hB_coinv_eval ψ k w hw, hB_coinv_eval ψ' k w' hw'_scale]
      obtain ⟨m, hm, x, hx⟩ := hClearTP (equiv.symm z)
