  have hΘ_postcomp : ∀ {G₁ G₂ : C_R} (φ : G₁ ⟶ G₂) (q : ℕ)
      (x : CategoryTheory.Abelian.Ext.{u} oneR G₁ q),
      Θ G₂ q (x.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero q)) =
        (Θ G₁ q x).comp (CategoryTheory.Abelian.Ext.mk₀ (U_of.map φ)) (Nat.add_zero q) := by
    intro G₁ G₂ φ q x
    change (CategoryTheory.Abelian.Ext.mk₀ ηZ).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor U_of
