  intro D₀ S_bar k R₀ R0_bar J Fℤ Fgt g_D V_bar π_bar ι_V Φ_V_hom
  let _ : CategoryTheory.Abelian (CategoryTheory.Sheaf J AddCommGrpCat.{u}) := inferInstance
