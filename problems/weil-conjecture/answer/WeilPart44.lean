      congr 1
      rw [map_smul]
      congr 1
      exact LinearMap.congr_fun hComm.2.2.1 (e_Q1.symm x)
    let P_σ : Γ → WeilCurveTrFreeComplex (ℓ ^ K) := fun σ =>
      { n₀ := n₀
        n₁ := n₁
        n₂ := n₂
        D₀ := LinearMap.toMatrix' d₀_lin
        D₁ := LinearMap.toMatrix' d₁_lin
