  have hAbstractSite : ∀ (S₀ : AlgebraicGeometry.Scheme.{u})
      (tr : ∀ r : ℕ, weilEtaleTorsionH S₀ (ℓ ^ r) 2 →+ ZMod (ℓ ^ r))
