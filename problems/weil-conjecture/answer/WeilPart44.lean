          _ = (J_adj * J_int) * (g.val * J_adj) := by
              rw [← hJg]; simp only [Matrix.mul_assoc]
          _ = ((ℓ : PadicInt ℓ) ^ c₂) • (g.val * J_adj) := by
              rw [hJ_adj_mul, Matrix.smul_mul, Matrix.one_mul]
      ext a b
      have hab := congrFun (congrFun hscale a) b
      simp only [Matrix.smul_apply, smul_eq_mul] at hab
      exact mul_left_cancel₀ hℓc₂_ne hab
    let k_bar := AlgebraicClosure F
    have hchar_kbar : CharP (AlgebraicClosure F) (ringChar F) :=
      (RingHom.charP_iff_charP (algebraMap F (AlgebraicClosure F)) (ringChar F)).mp inferInstance
    have hchar_eq : ringChar (AlgebraicClosure F) = ringChar F :=
      @ringChar.eq (AlgebraicClosure F) _ (ringChar F) hchar_kbar
    have hℓ_bar : ℓ ≠ ringChar (AlgebraicClosure F) := by
      rw [hchar_eq]; exact hℓ
    have hℓ_kbar_ne : (ℓ : AlgebraicClosure F) ≠ 0 := by
      intro h0
      have hdvd : ringChar F ∣ ℓ :=
        (@CharP.cast_eq_zero_iff (AlgebraicClosure F) _ (ringChar F) hchar_kbar ℓ).mp h0
      rcases CharP.char_is_prime_or_zero F (ringChar F) with hp | hz
      · rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | heq
        · exact hp.ne_one h1
        · exact hℓ heq.symm
