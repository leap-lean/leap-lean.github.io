        _ = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp p_E δ₁₂) π₂ := by
              rw [← hcond_E]
        _ = CategoryTheory.CategoryStruct.comp p_E (CategoryTheory.CategoryStruct.comp δ₁₂ π₂) :=
              CategoryTheory.Category.assoc _ _ _
        _ = CategoryTheory.CategoryStruct.comp p_E g₂_A := by
              rw [hδ_π₂]

  
  have hShortExactSection :
