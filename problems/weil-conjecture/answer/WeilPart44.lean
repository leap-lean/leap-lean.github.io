                (((ℓ : PadicInt ℓ) ^ k₂) * w₁.1 i + ((ℓ : PadicInt ℓ) ^ k₁) * w₂.1 i) =
              ((ℓ : Padic ℓ) ^ (k₁ + k₂)) * (vecOf ψ₁.1 i + vecOf ψ₂.1 i)
            rw [map_add, map_mul, map_mul, map_pow, map_pow, halg_ℓ, hw₁ i, hw₂ i, pow_add]
            ring
          have heq_sum : (((ℓ : Padic ℓ) ^ (Classical.choose (hLiftΨ (ψ₁ + ψ₂))))⁻¹) •
