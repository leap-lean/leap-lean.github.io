        (τ₀ : CategoryTheory.Abelian.Ext.{u} one₀ one₀ 2 →+ ZMod m)
        (𝒯₀ : CategoryTheory.Functor 𝒞₀ 𝒞₀)
        (η₀ : ∀ G : 𝒞₀, Quiver.Hom G (𝒯₀.obj G))
