      have hm_ne : (m : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      apply mul_left_cancel₀ hm_ne
      simp only [LinearMap.smul_apply, smul_eq_mul]
      calc (m : Padic ℓ) * ((((ℓ : Padic ℓ) ^ k)⁻¹) * B_int w (frob_V z))
          = (((ℓ : Padic ℓ) ^ k)⁻¹) * ((m : Padic ℓ) * B_int w (frob_V z)) := by ring
        _ = (((ℓ : Padic ℓ) ^ k)⁻¹) * B_int w (frob_V (m • z)) := by
              rw [map_nsmul frob_V m z, map_nsmul (B_int w) m (frob_V z), nsmul_eq_mul]
        _ = (((ℓ : Padic ℓ) ^ k)⁻¹) * algebraMap (PadicInt ℓ) (Padic ℓ) (β w y) := by
              rw [hfrob_mz, hB_int_tmul w y]
        _ = (((ℓ : Padic ℓ) ^ k)⁻¹) *
              ((q_card : Padic ℓ) * algebraMap (PadicInt ℓ) (Padic ℓ) (β w' x)) := by
              rw [hβ_frob, map_mul, map_natCast]
        _ = (((ℓ : Padic ℓ) ^ k)⁻¹) * ((q_card : Padic ℓ) * B_int w' (m • z)) := by
