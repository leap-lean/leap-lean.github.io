    rfl
  have hEquiv_zero : ∀ (X : CategoryTheory.Sheaf D₀.left.smallEtaleTopology AddCommGrpCat.{u})
      (Y : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      adj_pr.homEquiv X Y 0 = 0 := by
    intro X Y
    rw [CategoryTheory.Adjunction.homEquiv_unit, hR_pr_zero, CategoryTheory.Limits.comp_zero]
  have hEquiv_add : ∀ {X : CategoryTheory.Sheaf D₀.left.smallEtaleTopology AddCommGrpCat.{u}}
      {Y : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (f g : L_pr.obj X ⟶ Y),
      adj_pr.homEquiv X Y (f + g) = adj_pr.homEquiv X Y f + adj_pr.homEquiv X Y g := by
    intro X Y f g
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
      CategoryTheory.Adjunction.homEquiv_unit, hR_pr_add, CategoryTheory.Preadditive.comp_add]
  have hEquiv_symm_add : ∀ {X : CategoryTheory.Sheaf D₀.left.smallEtaleTopology AddCommGrpCat.{u}}
      {Y : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (f g : X ⟶ R_pr.obj Y),
      (adj_pr.homEquiv X Y).symm (f + g) =
        (adj_pr.homEquiv X Y).symm f + (adj_pr.homEquiv X Y).symm g := by
    intro X Y f g
    apply (adj_pr.homEquiv X Y).injective
    rw [hEquiv_add, Equiv.apply_symm_apply, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
  have hL_pr_zero : ∀ (X₁ X₂ : CategoryTheory.Sheaf D₀.left.smallEtaleTopology AddCommGrpCat.{u}),
      L_pr.map (0 : X₁ ⟶ X₂) = 0 := by
    intro X₁ X₂
    apply (adj_pr.homEquiv X₁ (L_pr.obj X₂)).injective
    have h1 := adj_pr.homEquiv_naturality_left (0 : X₁ ⟶ X₂) (𝟙 (L_pr.obj X₂))
    rw [CategoryTheory.Category.comp_id] at h1
    rw [h1, CategoryTheory.Limits.zero_comp, hEquiv_zero]
  have hL_pr_add : ∀ {X₁ X₂ : CategoryTheory.Sheaf D₀.left.smallEtaleTopology AddCommGrpCat.{u}}
      (f g : X₁ ⟶ X₂), L_pr.map (f + g) = L_pr.map f + L_pr.map g := by
    intro X₁ X₂ f g
    apply (adj_pr.homEquiv X₁ (L_pr.obj X₂)).injective
    have hfg := adj_pr.homEquiv_naturality_left (f + g) (𝟙 (L_pr.obj X₂))
    have hf := adj_pr.homEquiv_naturality_left f (𝟙 (L_pr.obj X₂))
    have hg := adj_pr.homEquiv_naturality_left g (𝟙 (L_pr.obj X₂))
    rw [CategoryTheory.Category.comp_id] at hfg hf hg
    rw [hEquiv_add, hfg, hf, hg, CategoryTheory.Preadditive.add_comp]
  have hL_pr_nsmul : ∀ {X₁ X₂ : CategoryTheory.Sheaf D₀.left.smallEtaleTopology AddCommGrpCat.{u}}
      (n : ℕ) (f : X₁ ⟶ X₂), L_pr.map (n • f) = n • L_pr.map f := by
    intro X₁ X₂ n f
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul, hL_pr_zero]
    | succ n ih => rw [succ_nsmul, succ_nsmul, hL_pr_add, ih]

  
  have hIsoTor : ∀ {A_sh B_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (e : CategoryTheory.Iso A_sh B_sh) (n : ℕ),
      n • CategoryTheory.CategoryStruct.id A_sh = 0 →
        n • CategoryTheory.CategoryStruct.id B_sh = 0 := by
    intro A_sh B_sh e n hA
    change n • 𝟙 B_sh = 0
    change n • 𝟙 A_sh = 0 at hA
    have hid : 𝟙 B_sh = e.inv ≫ 𝟙 A_sh ≫ e.hom := by
      rw [CategoryTheory.Category.id_comp, e.inv_hom_id]
    have hconj : ∀ m : ℕ,
        e.inv ≫ (m • 𝟙 A_sh) ≫ e.hom = m • (e.inv ≫ 𝟙 A_sh ≫ e.hom) := by
      intro m
      induction m with
      | zero =>
        rw [zero_nsmul, zero_nsmul, CategoryTheory.Limits.zero_comp,
          CategoryTheory.Limits.comp_zero]
      | succ m ih =>
        rw [succ_nsmul, CategoryTheory.Preadditive.add_comp,
          CategoryTheory.Preadditive.comp_add, ih, ← succ_nsmul]
    rw [hid, ← hconj n, hA, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

  have hIsoEpi : ∀ {A₁ A₂ B₁ B₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (e₁ : CategoryTheory.Iso A₁ B₁) (e₂ : CategoryTheory.Iso A₂ B₂)
      (f : A₁ ⟶ A₂) (g : B₁ ⟶ B₂),
      CategoryTheory.Epi f → f ≫ e₂.hom = e₁.hom ≫ g → CategoryTheory.Epi g := by
    intro A₁ A₂ B₁ B₂ e₁ e₂ f g hEpi hcomm
    haveI : CategoryTheory.Epi f := hEpi
    refine ⟨fun {Z} u₁ u₂ hu => ?_⟩
    have h1 : (e₁.hom ≫ g) ≫ u₁ = (e₁.hom ≫ g) ≫ u₂ := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hu]
    rw [← hcomm, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc] at h1
    have h2 : e₂.hom ≫ u₁ = e₂.hom ≫ u₂ := (cancel_epi f).mp h1
    simpa only [← CategoryTheory.Category.assoc, e₂.inv_hom_id,
      CategoryTheory.Category.id_comp] using congrArg (e₂.inv ≫ ·) h2

  have hIsoPrecompBij :
      ∀ {A_sh B_sh Z_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (e : CategoryTheory.Iso A_sh B_sh),
        Function.Bijective (fun f : A_sh ⟶ Z_sh => e.inv ≫ f) := by
    intro A_sh B_sh Z_sh e
    refine ⟨fun f₁ f₂ h => ?_, fun g => ⟨e.hom ≫ g, ?_⟩⟩
    · simpa only [← CategoryTheory.Category.assoc, e.hom_inv_id,
        CategoryTheory.Category.id_comp] using congrArg (e.hom ≫ ·) h
    · dsimp only
      rw [← CategoryTheory.Category.assoc, e.inv_hom_id, CategoryTheory.Category.id_comp]

  have hIsoPrecompAdd :
      ∀ {A_sh B_sh Z_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (e : CategoryTheory.Iso A_sh B_sh) (f₁ f₂ : A_sh ⟶ Z_sh),
        e.inv ≫ (f₁ + f₂) = (e.inv ≫ f₁) + (e.inv ≫ f₂) := by
    intro A_sh B_sh Z_sh e f₁ f₂
    rw [CategoryTheory.Preadditive.comp_add]

  have hIsoSquare :
      ∀ {A₁ A₂ B₁ B₂ Z₁ Z₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (e₁ : CategoryTheory.Iso A₁ B₁) (e₂ : CategoryTheory.Iso A₂ B₂)
        (f : A₁ ⟶ A₂) (g : B₁ ⟶ B₂)
        (u₁ : A₁ ⟶ Z₁) (u₂ : A₂ ⟶ Z₂) (p : Z₁ ⟶ Z₂),
        f ≫ e₂.hom = e₁.hom ≫ g →
        u₁ ≫ p = f ≫ u₂ →
        (e₁.inv ≫ u₁) ≫ p = g ≫ (e₂.inv ≫ u₂) := by
    intro A₁ A₂ B₁ B₂ Z₁ Z₂ e₁ e₂ f g u₁ u₂ p hcomm hsq
    suffices h : e₁.hom ≫ ((e₁.inv ≫ u₁) ≫ p) = e₁.hom ≫ (g ≫ (e₂.inv ≫ u₂)) by
      simpa only [← CategoryTheory.Category.assoc, e₁.inv_hom_id,
        CategoryTheory.Category.id_comp] using congrArg (e₁.inv ≫ ·) h
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e₁.hom, e₁.hom_inv_id,
      CategoryTheory.Category.id_comp, hsq, ← CategoryTheory.Category.assoc e₁.hom g, ← hcomm,
      CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e₂.hom, e₂.hom_inv_id,
      CategoryTheory.Category.id_comp]

  have hIsoHomInv :
      ∀ {A_sh B_sh Z_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (e : CategoryTheory.Iso A_sh B_sh) (u : A_sh ⟶ Z_sh),
        e.hom ≫ (e.inv ≫ u) = u := by
    intro A_sh B_sh Z_sh e u
    rw [← CategoryTheory.Category.assoc, e.hom_inv_id, CategoryTheory.Category.id_comp]

  
