      intro z
      have hψz : ψ_P (algebraMap R₀ P_E z) =
          TensorProduct.tmul C₀ (algebraMap R₀ C₀_U z) (algebraMap k A 1) := by
        change (Algebra.TensorProduct.map (AlgHom.id C₀ C₀_U) inc_AE_alg)
          (TensorProduct.tmul C₀ (algebraMap R₀ C₀_U z) 1) = _
        rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one, map_one]
      have hPz : _e_Pbar (ψ_P (algebraMap R₀ P_E z)) =
          algebraMap R0_bar P_bar (TensorProduct.tmul F z 1) := by
        rw [hψz, ← _hAlg_Pbar z 1]
      change _e_Dbar (TensorProduct.tmul R0_bar (_e_Pbar (ψ_P (algebraMap R₀ P_E z))) 1) =
        _e_Dbar (TensorProduct.tmul R0_bar 1 (q_B (algebraMap R₀ B z)))
      congr 1
      let r0 : R0_bar := TensorProduct.tmul F z 1
      calc
        TensorProduct.tmul R0_bar (_e_Pbar (ψ_P (algebraMap R₀ P_E z))) (1 : B_bar)
          = TensorProduct.tmul R0_bar (r0 • (1 : P_bar)) (1 : B_bar) := by
            rw [hPz, Algebra.algebraMap_eq_smul_one]
        _ = TensorProduct.tmul R0_bar (1 : P_bar) (r0 • (1 : B_bar)) :=
            TensorProduct.smul_tmul r0 (1 : P_bar) (1 : B_bar)
        _ = TensorProduct.tmul R0_bar (1 : P_bar) (q_B (algebraMap R₀ B z)) := by
            rw [← Algebra.algebraMap_eq_smul_one]
            change TensorProduct.tmul R0_bar 1 (algebraMap R0_bar B_bar (TensorProduct.tmul F z 1)) = _
            rw [_htmalg z 1, map_one, mul_one]

    let instAlgR₀_Dbar : Algebra R₀ D_bar := (f_PE.comp (algebraMap R₀ P_E)).toAlgebra
    letI : Algebra R₀ D_bar := instAlgR₀_Dbar
    let f_PE_alg : P_E →ₐ[R₀] D_bar :=
      { toRingHom := f_PE
        commutes' := fun _ => rfl }
    let f_B_alg : B →ₐ[R₀] D_bar :=
      { toRingHom := f_B
        commutes' := fun z => (hf_agree z).symm }
    let φ₀ : R_Er →+* D_bar :=
      (Algebra.TensorProduct.lift f_PE_alg f_B_alg
        (fun x y => mul_comm (f_PE_alg x) (f_B_alg y))).toRingHom

    have hφ₀_tmul : ∀ (c_U : C₀_U) (a_E : A_E) (b : B),
        φ₀ (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ c_U a_E) b) =
          _e_Dbar (TensorProduct.tmul R0_bar
            (_e_Pbar (TensorProduct.tmul C₀ c_U (inc_AE a_E))) (q_B b)) := by
      intro c_U a_E b
      change f_PE (TensorProduct.tmul C₀ c_U a_E) * f_B b = _
      change _e_Dbar (TensorProduct.tmul R0_bar
          (_e_Pbar (TensorProduct.tmul C₀ c_U (inc_AE a_E))) 1) *
        _e_Dbar (TensorProduct.tmul R0_bar 1 (q_B b)) = _
      rw [← map_mul _e_Dbar, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]

    
    let h_E := (Fgt_D.obj W_E).hom
    let h_bar := (Fgt_S.obj (B_pr.obj W_E)).hom
    let q_EV : Quiver.Hom Z'_V Bpr_V :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (Fgt_S.obj Z').hom ι_V ≫ (Fgt_S.map q_E).left)
        (CategoryTheory.Limits.pullback.snd (Fgt_S.obj Z').hom ι_V)
        (by
          rw [CategoryTheory.Category.assoc, (Fgt_S.map q_E).w]
          exact CategoryTheory.Limits.pullback.condition)

    let q_spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_B)
    let fst_BprV := CategoryTheory.Limits.pullback.fst h_bar ι_V
    let snd_BprV := CategoryTheory.Limits.pullback.snd h_bar ι_V
    let a_WE : Bpr_V ⟶ (Fgt_U.obj (B_j.obj W_E)).left :=
      CategoryTheory.Limits.pullback.lift
        (fst_BprV ≫ CategoryTheory.Limits.pullback.fst h_E pr_D)
        (snd_BprV ≫ q_spec ≫ π_r)
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (fst_BprV ≫ ·) CategoryTheory.Limits.pullback.condition).trans
            ((CategoryTheory.Category.assoc fst_BprV h_bar pr_D).symm.trans
              ((congrArg (· ≫ pr_D) CategoryTheory.Limits.pullback.condition).trans
                ((CategoryTheory.Category.assoc snd_BprV ι_V pr_D).trans
                  ((congrArg (snd_BprV ≫ ·) hSq_V).trans
                    ((CategoryTheory.Category.assoc _ _ _).symm.trans
                      (CategoryTheory.Category.assoc _ _ U₀.ι).symm)))))))

    let θ_WE : Quiver.Hom Bpr_V W_Er :=
      CategoryTheory.Limits.pullback.lift
        a_WE
        (snd_BprV ≫ q_spec)
        ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
          (CategoryTheory.Category.assoc snd_BprV q_spec π_r).symm)

    have hqEV_fst_eq : q_EV ≫ fst_BprV =
        CategoryTheory.Limits.pullback.fst (Fgt_S.obj Z').hom ι_V ≫ (Fgt_S.map q_E).left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _

    have hqEV_snd_eq : q_EV ≫ snd_BprV =
        CategoryTheory.Limits.pullback.snd (Fgt_S.obj Z').hom ι_V :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _

    have hθ_fst_eq : (θ_WE ≫ CategoryTheory.Limits.pullback.fst h_WE_U π_r) ≫
        CategoryTheory.Limits.pullback.fst h_E U₀.ι =
        fst_BprV ≫ CategoryTheory.Limits.pullback.fst h_E pr_D :=
      (congrArg (· ≫ CategoryTheory.Limits.pullback.fst h_E U₀.ι)
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)

    have hθ_snd_eq : θ_WE ≫ CategoryTheory.Limits.pullback.snd h_WE_U π_r =
        snd_BprV ≫ q_spec :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _

    refine ⟨φ₀, iso_WEr, q_EV, θ_WE, hφ₀_tmul, ?_, hqEV_fst_eq, hqEV_snd_eq, hθ_fst_eq, hθ_snd_eq, ?_⟩
    · 
      intro σ m_σ hm_fst hm_snd
      let τ_σ : R_Er →+* R_Er :=
        (Algebra.TensorProduct.map (AlgHom.id R₀ P_E) σ.symm.toAlgHom).toRingHom
      have hτ_incL : τ_σ.comp incL_REr = incL_REr := by
        apply RingHom.ext; intro p
        change (Algebra.TensorProduct.map (AlgHom.id R₀ P_E) σ.symm.toAlgHom)
          (TensorProduct.tmul R₀ p 1) = TensorProduct.tmul R₀ p 1
        simp
      have hτ_incR : τ_σ.comp incR_REr = incR_REr.comp σ.symm.toRingHom := by
        apply RingHom.ext; intro b
        change (Algebra.TensorProduct.map (AlgHom.id R₀ P_E) σ.symm.toAlgHom)
          (TensorProduct.tmul R₀ 1 b) = TensorProduct.tmul R₀ 1 (σ.symm b)
        simp
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_σ) ≫ iso_WEr.hom) ≫
          CategoryTheory.Limits.pullback.fst h_WE_U π_r =
          (iso_WEr.hom ≫ m_σ) ≫ CategoryTheory.Limits.pullback.fst h_WE_U π_r
        rw [CategoryTheory.Category.assoc, hiso_WEr_fst,
          ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_σ)),
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hτ_incL,
          CategoryTheory.Category.assoc iso_WEr.hom m_σ, hm_fst, hiso_WEr_fst]
      · change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_σ) ≫ iso_WEr.hom) ≫
          CategoryTheory.Limits.pullback.snd h_WE_U π_r =
          (iso_WEr.hom ≫ m_σ) ≫ CategoryTheory.Limits.pullback.snd h_WE_U π_r
        rw [CategoryTheory.Category.assoc, hiso_WEr_snd,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hτ_incR,
          CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
          CategoryTheory.Category.assoc iso_WEr.hom m_σ, hm_snd,
          ← CategoryTheory.Category.assoc iso_WEr.hom, hiso_WEr_snd]
    · 
      have h_snd_eq : (iso_ZV.hom ≫ (q_EV ≫ θ_WE)) ≫
          CategoryTheory.Limits.pullback.snd h_WE_U π_r =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ iso_WEr.hom) ≫
            CategoryTheory.Limits.pullback.snd h_WE_U π_r := by
        have hφ₀_incR : φ₀.comp incR_REr = f_B := by
          apply RingHom.ext; intro b
          change f_PE 1 * f_B b = f_B b
          rw [map_one, one_mul]
        have hL1 : (iso_ZV.hom ≫ (q_EV ≫ θ_WE)) ≫
            CategoryTheory.Limits.pullback.snd h_WE_U π_r =
            (iso_ZV.hom ≫ CategoryTheory.Limits.pullback.snd (Fgt_S.obj Z').hom ι_V) ≫ q_spec :=
          (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (iso_ZV.hom ≫ ·) (CategoryTheory.Category.assoc _ _ _)).trans
              ((congrArg (fun g => iso_ZV.hom ≫ (q_EV ≫ g)) hθ_snd_eq).trans
                ((congrArg (iso_ZV.hom ≫ ·) (CategoryTheory.Category.assoc _ _ _).symm).trans
                  ((congrArg (fun g => iso_ZV.hom ≫ (g ≫ q_spec)) hqEV_snd_eq).trans
                    (CategoryTheory.Category.assoc _ _ _).symm))))
        have hL2 : (iso_ZV.hom ≫ CategoryTheory.Limits.pullback.snd (Fgt_S.obj Z').hom ι_V) ≫ q_spec =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_B) := by
          rw [hiso_ZV_snd]
          dsimp [q_spec, f_B]
          rw [CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hR : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_B) =
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ iso_WEr.hom) ≫
              CategoryTheory.Limits.pullback.snd h_WE_U π_r := by
          rw [← hφ₀_incR, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
            CategoryTheory.Category.assoc, hiso_WEr_snd]
        exact hL1.trans (hL2.trans hR)

      apply CategoryTheory.Limits.pullback.hom_ext
      · apply CategoryTheory.Limits.pullback.hom_ext
        · 
          have hqE_eq : e_Z.hom ≫ ((Fgt_S.map q_E).left ≫
              CategoryTheory.Limits.pullback.fst h_E pr_D) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom inc_AE) ≫ e_WE.hom := by
            have h0 := heq_dom_cod_eq _hZ'_left _hWE_left _hqE_fst
            change e_Z.hom ≫ ((Fgt_S.map q_E).left ≫
              CategoryTheory.Limits.pullback.fst h_E pr_D) ≫ e_WE.inv =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom inc_AE) at h0
            have h1 := congrArg (· ≫ e_WE.hom) h0
            simpa only [CategoryTheory.Category.assoc, e_WE.inv_hom_id,
              CategoryTheory.Category.comp_id] using h1
          have hRing_AE : ((_e_Dbar.toRingHom.comp incL_TD).comp _e_Pbar.toRingHom).comp
              (incR_TP.comp inc_AE) =
              (φ₀.comp incL_REr).comp incR_PE := by
            apply RingHom.ext; intro a_E
            change _e_Dbar (TensorProduct.tmul R0_bar
              (_e_Pbar (TensorProduct.tmul C₀ 1 (inc_AE a_E))) 1) =
              φ₀ (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ 1 a_E) 1)
            rw [hφ₀_tmul 1 a_E 1, map_one]
          have hLHS1 : ((iso_ZV.hom ≫ (q_EV ≫ θ_WE)) ≫
              CategoryTheory.Limits.pullback.fst h_WE_U π_r) ≫
              CategoryTheory.Limits.pullback.fst h_E U₀.ι =
              (iso_ZV.hom ≫ CategoryTheory.Limits.pullback.fst (Fgt_S.obj Z').hom ι_V) ≫
                ((Fgt_S.map q_E).left ≫ CategoryTheory.Limits.pullback.fst h_E pr_D) :=
            (congrArg (· ≫ CategoryTheory.Limits.pullback.fst h_E U₀.ι)
                ((CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (iso_ZV.hom ≫ ·) (CategoryTheory.Category.assoc _ _ _)))).trans
              ((CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (iso_ZV.hom ≫ ·) (CategoryTheory.Category.assoc _ _ _)).trans
                  ((congrArg (fun g => iso_ZV.hom ≫ (q_EV ≫ g)) hθ_fst_eq).trans
                    ((congrArg (iso_ZV.hom ≫ ·) (CategoryTheory.Category.assoc _ _ _).symm).trans
                      ((congrArg (fun g => iso_ZV.hom ≫
                          (g ≫ CategoryTheory.Limits.pullback.fst h_E pr_D)) hqEV_fst_eq).trans
                        ((congrArg (iso_ZV.hom ≫ ·) (CategoryTheory.Category.assoc _ _ _)).trans
                          (CategoryTheory.Category.assoc _ _ _).symm))))))
          let u_prefix :=
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom _e_Dbar.toRingHom) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom incL_TD)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom _e_Pbar.toRingHom)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR_TP)
          have hu_fst : iso_ZV.hom ≫ CategoryTheory.Limits.pullback.fst (Fgt_S.obj Z').hom ι_V =
              u_prefix ≫ e_Z.hom := by
            rw [hiso_ZV_fst]
            dsimp only [q_ZP, u_prefix]
            simp only [CategoryTheory.Category.assoc]
          have hStep1 : (iso_ZV.hom ≫ CategoryTheory.Limits.pullback.fst (Fgt_S.obj Z').hom ι_V) ≫
              ((Fgt_S.map q_E).left ≫ CategoryTheory.Limits.pullback.fst h_E pr_D) =
              u_prefix ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inc_AE) ≫ e_WE.hom) :=
            (congrArg (· ≫ ((Fgt_S.map q_E).left ≫ CategoryTheory.Limits.pullback.fst h_E pr_D))
                hu_fst).trans
              ((CategoryTheory.Category.assoc u_prefix e_Z.hom _).trans
                (congrArg (u_prefix ≫ ·) hqE_eq))
          have hStep2 : u_prefix ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inc_AE) ≫ e_WE.hom) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom incL_REr) ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR_PE) ≫ e_WE.hom) := by
            have hEqSpec : u_prefix ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inc_AE) ≫ e_WE.hom) =
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  (((_e_Dbar.toRingHom.comp incL_TD).comp _e_Pbar.toRingHom).comp
                    (incR_TP.comp inc_AE)))) ≫ e_WE.hom := by
              dsimp only [u_prefix]
              simp only [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
                CategoryTheory.Category.assoc]
            rw [hEqSpec, hRing_AE]
            simp only [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
              CategoryTheory.Category.assoc]
          have hLHS2 : (iso_ZV.hom ≫ CategoryTheory.Limits.pullback.fst (Fgt_S.obj Z').hom ι_V) ≫
              ((Fgt_S.map q_E).left ≫ CategoryTheory.Limits.pullback.fst h_E pr_D) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom incL_REr) ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR_PE) ≫ e_WE.hom) :=
            hStep1.trans hStep2
          have hRHS : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom incL_REr) ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR_PE) ≫ e_WE.hom) =
              ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ iso_WEr.hom) ≫
                CategoryTheory.Limits.pullback.fst h_WE_U π_r) ≫
                CategoryTheory.Limits.pullback.fst h_E U₀.ι :=
            (congrArg (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ ·)
                ((congrArg (AlgebraicGeometry.Spec.map (CommRingCat.ofHom incL_REr) ≫ ·)
                    hiso_PE_fst.symm).trans
                  ((CategoryTheory.Category.assoc _ _ _).symm.trans
                    (congrArg (· ≫ CategoryTheory.Limits.pullback.fst h_E U₀.ι)
                      hiso_WEr_fst.symm)))).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                (congrArg (· ≫ CategoryTheory.Limits.pullback.fst h_E U₀.ι)
                  (CategoryTheory.Category.assoc _ _ _).symm))
          exact hLHS1.trans (hLHS2.trans hRHS)
        · 
          exact (CategoryTheory.Category.assoc _
              (CategoryTheory.Limits.pullback.fst h_WE_U π_r) h_WE_U).trans
            ((congrArg (_ ≫ ·) CategoryTheory.Limits.pullback.condition).trans
              ((CategoryTheory.Category.assoc _
                  (CategoryTheory.Limits.pullback.snd h_WE_U π_r) π_r).symm.trans
                ((congrArg (· ≫ π_r) h_snd_eq).trans
                  ((CategoryTheory.Category.assoc _
                      (CategoryTheory.Limits.pullback.snd h_WE_U π_r) π_r).trans
                    ((congrArg (_ ≫ ·) CategoryTheory.Limits.pullback.condition.symm).trans
                      (CategoryTheory.Category.assoc _
                        (CategoryTheory.Limits.pullback.fst h_WE_U π_r) h_WE_U).symm)))))
      · exact h_snd_eq

theorem weil_mid_ext_ind_etale_local_lift_and_zero_descent (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    [AlgebraicGeometry.IsAffineHom U₀.ι]
    (U_bar : (weilGeomScheme F (weilProjectiveSpaceOver F 1)).Opens)
    (m_mod M : ℕ) (hm : 1 ≤ m_mod) :
    let D₀ := weilProjectiveSpaceOver F 1
    let S_bar := weilGeomScheme F D₀
    let k := AlgebraicClosure F
    let f_ext := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
    let pr_D := CategoryTheory.Limits.pullback.fst D₀.hom f_ext
    let pr_k := CategoryTheory.Limits.pullback.snd D₀.hom f_ext
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S_bar
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    let R0_bar := TensorProduct F R₀ k
    ∀ (B k_L B_bar : Type u)
      [CommRing B] [Algebra F B] [Algebra R₀ B] [IsScalarTower F R₀ B]
      [Finite k_L] [Field k_L] [Algebra F k_L] [Algebra.Etale F k_L]
      [CommRing B_bar] [Algebra R0_bar B_bar]
      (ι_kB : k_L →ₐ[F] B),
      Set.range ι_kB = { x : B | IsIntegral F x } →
      ∀ (κ_k : k_L →ₐ[F] k)
        (res_k : (B ≃ₐ[R₀] B) →* (k_L ≃ₐ[F] k_L)),
        Function.Surjective res_k →
        (∀ (σ : B ≃ₐ[R₀] B) (c : k_L), σ (ι_kB c) = ι_kB (res_k σ c)) →
        ∀ (m_k : ℕ) (equiv_Γk : Fin m_k ≃ (k_L ≃ₐ[F] k_L))
          (e_k : Fin m_k → TensorProduct F k_L k_L),
          ((∀ i : Fin m_k, e_k i * e_k i = e_k i) ∧
            (∀ i j : Fin m_k, i ≠ j → e_k i * e_k j = 0) ∧
            (∑ i : Fin m_k, e_k i) = 1 ∧
            (∀ i j : Fin m_k,
              Algebra.TensorProduct.lift (AlgHom.id k_L k_L) (equiv_Γk j).symm.toAlgHom
                (fun _ _ => mul_comm _ _) (e_k i) = if i = j then 1 else 0) ∧
            (∀ (i : Fin m_k) (z : TensorProduct F k_L k_L),
              z * e_k i = TensorProduct.tmul F
                (Algebra.TensorProduct.lift (AlgHom.id k_L k_L) (equiv_Γk i).symm.toAlgHom
                  (fun _ _ => mul_comm _ _) z) (1 : k_L) * e_k i)) →
          ∀ (ρ_r : (B ≃ₐ[R₀] B) →* (Matrix (Fin M) (Fin M) (ZMod m_mod))ˣ)
            (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme),
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι) D₀.hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F R₀)) →
            (let π_r := CategoryTheory.CategoryStruct.comp
               (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B))) e_U.hom
             ∀ (W : AlgebraicGeometry.Scheme.{u}) (h_W : Quiver.Hom W U₀.toScheme),
               let W_r := CategoryTheory.Limits.pullback h_W π_r
               (AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.fst h_W π_r) ∧
                 AlgebraicGeometry.Surjective (CategoryTheory.Limits.pullback.fst h_W π_r)) ∧
               (∀ σ : B ≃ₐ[R₀] B,
                 ∃! m_σ : Quiver.Hom W_r W_r,
                   CategoryTheory.CategoryStruct.comp m_σ
                     (CategoryTheory.Limits.pullback.fst h_W π_r) =
                     CategoryTheory.Limits.pullback.fst h_W π_r ∧
                   CategoryTheory.CategoryStruct.comp m_σ
                     (CategoryTheory.Limits.pullback.snd h_W π_r) =
                     CategoryTheory.CategoryStruct.comp
                       (CategoryTheory.Limits.pullback.snd h_W π_r)
                       (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom))) ∧
               (∀ y₁ y₂ : ↥W_r,
                 (CategoryTheory.Limits.pullback.fst h_W π_r).base y₁ =
                   (CategoryTheory.Limits.pullback.fst h_W π_r).base y₂ →
                 ∃ (σ : B ≃ₐ[R₀] B) (m_σ : Quiver.Hom W_r W_r),
                   CategoryTheory.CategoryStruct.comp m_σ
                     (CategoryTheory.Limits.pullback.fst h_W π_r) =
                     CategoryTheory.Limits.pullback.fst h_W π_r ∧
                   CategoryTheory.CategoryStruct.comp m_σ
                     (CategoryTheory.Limits.pullback.snd h_W π_r) =
                     CategoryTheory.CategoryStruct.comp
                       (CategoryTheory.Limits.pullback.snd h_W π_r)
                       (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) ∧
