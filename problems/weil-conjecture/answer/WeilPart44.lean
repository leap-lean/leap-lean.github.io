        exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          (Fgt.map u).left (Fgt.obj Y₂).hom Y₂.prop (by rw [(Fgt.map u).w]; exact Y₁.prop)
      have hu_pb : ∀ {Y₁ Y₂ : S.Etale} (u : Y₁ ⟶ Y₂),
          CategoryTheory.IsPullback (u_can u)
            (CategoryTheory.Limits.pullback.fst (Fgt.obj Y₁).hom ι)
            (CategoryTheory.Limits.pullback.fst (Fgt.obj Y₂).hom ι)
            (Fgt.map u).left := by
        intro Y₁ Y₂ u
        have hOuter : CategoryTheory.IsPullback
            (u_can u ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj Y₂).hom ι)
            (CategoryTheory.Limits.pullback.fst (Fgt.obj Y₁).hom ι)
            ι ((Fgt.map u).left ≫ (Fgt.obj Y₂).hom) := by
          rw [CategoryTheory.Limits.pullback.lift_snd, (Fgt.map u).w]
          exact (CategoryTheory.IsPullback.of_hasPullback (Fgt.obj Y₁).hom ι).flip
        exact CategoryTheory.IsPullback.of_right hOuter
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.IsPullback.of_hasPullback (Fgt.obj Y₂).hom ι).flip
      have hu_can_et : ∀ {Y₁ Y₂ : S.Etale} (u : Y₁ ⟶ Y₂), AlgebraicGeometry.Etale (u_can u) :=
        fun u => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (hu_pb u).flip (hu_et u)
      have hSheaf : CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology 𝒥_pre := by
        intro M_grp W R_sieve hR x hx
        let h_W := (Fgt.obj W).hom
        let W_V := CategoryTheory.Limits.pullback h_W ι
        have hCov_base : ∀ p : ↥(Fgt.obj W).left,
            ∃ (Y : S.Etale) (f : Y ⟶ W) (_ : R_sieve.arrows f) (q : ↥(Fgt.obj Y).left),
