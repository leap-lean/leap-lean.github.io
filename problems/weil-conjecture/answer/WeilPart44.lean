theorem weil_coinv_zero_ext_hom_equiv (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (ℓ N : ℕ) [Fact (Nat.Prime ℓ)]
    (H_geom : Subgroup ((Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ))
    (A_u : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (A_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin N) (Fin N) (PadicInt ℓ))
    (𝒥₀ : ℕ → CategoryTheory.Sheaf (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
      AddCommGrpCat.{u})
    (τ_𝒥 : ∀ r : ℕ, Quiver.Hom (𝒥₀ (r + 1)) (𝒥₀ r))
    (hZExt : WeilCurveZeroExtSystem.{u} F S_aff j_aff U₀ u₀ ℓ N H_geom A_u A_mat 𝒥₀ τ_𝒥)
    (M_c2 : WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ 2 𝒥₀ τ_𝒥) :
    let D₀ := weilProjectiveSpaceOver F 1
    let S := weilGeomScheme F D₀
    let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    (∀ r : ℕ, (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id (M_c2.ℳ_bar r) = 0) ∧
    (∀ r : ℕ, CategoryTheory.Epi (M_c2.τ_bar r)) ∧
    (∀ (r : ℕ) (u : (M_c2.ℳ_bar (r + 1)).H 2),
      ((CategoryTheory.Abelian.Ext.mk₀ (M_c2.τ_bar r)).postcomp Fℤ (Nat.add_zero 2))
        (M_c2.frobTorsion (r + 1) u) =
      M_c2.frobTorsion r
        (((CategoryTheory.Abelian.Ext.mk₀ (M_c2.τ_bar r)).postcomp Fℤ (Nat.add_zero 2)) u)) ∧
    ∃ α : ∀ r : ℕ,
        { lam : Fin N → ZMod (ℓ ^ (r + 1)) //
          ∀ h ∈ H_geom,
            (((h.val).map (PadicInt.toZModPow (r + 1))).transpose).mulVec lam = lam } →
        Quiver.Hom (M_c2.ℳ_bar r) (weilEtaleTorsionSheaf S (ℓ ^ (r + 1))),
      (∀ r : ℕ, Function.Bijective (α r)) ∧
      (∀ (r : ℕ)
        (lam₁ lam₂ lam₃ : { lam : Fin N → ZMod (ℓ ^ (r + 1)) //
          ∀ h ∈ H_geom,
            (((h.val).map (PadicInt.toZModPow (r + 1))).transpose).mulVec lam = lam }),
        lam₃.1 = lam₁.1 + lam₂.1 → α r lam₃ = α r lam₁ + α r lam₂) ∧
      (∀ (r : ℕ)
        (lam_up : { lam : Fin N → ZMod (ℓ ^ (r + 1 + 1)) //
          ∀ h ∈ H_geom,
            (((h.val).map (PadicInt.toZModPow (r + 1 + 1))).transpose).mulVec lam = lam })
        (lam_dn : { lam : Fin N → ZMod (ℓ ^ (r + 1)) //
          ∀ h ∈ H_geom,
            (((h.val).map (PadicInt.toZModPow (r + 1))).transpose).mulVec lam = lam }),
        (∀ i : Fin N, lam_dn.1 i =
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
            (lam_up.1 i)) →
        CategoryTheory.CategoryStruct.comp (α (r + 1) lam_up)
          ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map
            (AddCommGrpCat.uliftFunctor.{u, 0}.map
              (AddCommGrpCat.ofHom
                (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1)))
                  (ZMod (ℓ ^ (r + 1)))).toAddMonoidHom))) =
        CategoryTheory.CategoryStruct.comp (M_c2.τ_bar r) (α r lam_dn)) ∧
      (∀ (r : ℕ)
        (f_top : weilEtaleTorsionH S (ℓ ^ (r + 1)) 2 →+ weilEtaleTorsionH S (ℓ ^ (r + 1)) 2),
        WeilIsTorsionGeomFrobAction F D₀ (ℓ ^ (r + 1)) 2 f_top →
        ∀ (lam_cur lam_next : { lam : Fin N → ZMod (ℓ ^ (r + 1)) //
            ∀ h ∈ H_geom,
              (((h.val).map (PadicInt.toZModPow (r + 1))).transpose).mulVec lam = lam })
          (z : (M_c2.ℳ_bar r).H 2),
          lam_next.1 =
            (((A_u.val).map (PadicInt.toZModPow (r + 1))).transpose).mulVec lam_cur.1 →
          ((CategoryTheory.Abelian.Ext.mk₀ (α r lam_cur)).postcomp Fℤ (Nat.add_zero 2))
            (M_c2.frobTorsion r z) =
          f_top
            (((CategoryTheory.Abelian.Ext.mk₀ (α r lam_next)).postcomp Fℤ (Nat.add_zero 2)) z)) :=
by
  classical
  dsimp only
  let D₀ := weilProjectiveSpaceOver F 1
  let k := AlgebraicClosure F
