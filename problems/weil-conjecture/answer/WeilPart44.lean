      have h_d₁_mv : (P_σ σ).D₁.mulVecLin = d₁_lin := h_mulVecLin_toMatrix' d₁_lin
      have h_φ₀_mv : (P_σ σ).Φ₀.mulVecLin = φ₀_lin σ := h_mulVecLin_toMatrix' (φ₀_lin σ)
      have h_φ₁_mv : (P_σ σ).Φ₁.mulVecLin = φ₁_lin σ := h_mulVecLin_toMatrix' (φ₁_lin σ)
      have h_φ₂_mv : (P_σ σ).Φ₂.mulVecLin = φ₂_lin σ := h_mulVecLin_toMatrix' (φ₂_lin σ)
