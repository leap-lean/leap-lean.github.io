          obtain ⟨k₂, w₂, hw₂⟩ := hLiftΨ ψ₂
          have heq₁ : (((ℓ : Padic ℓ) ^ (Classical.choose (hLiftΨ ψ₁)))⁻¹) •
              B_int (Classical.choose (Classical.choose_spec (hLiftΨ ψ₁))) =
              (((ℓ : Padic ℓ) ^ k₁)⁻¹) • B_int w₁ :=
            hScaleIndep _ k₁ _ w₁ (vecOf ψ₁.1)
              (Classical.choose_spec (Classical.choose_spec (hLiftΨ ψ₁))) hw₁
          have heq₂ : (((ℓ : Padic ℓ) ^ (Classical.choose (hLiftΨ ψ₂)))⁻¹) •
              B_int (Classical.choose (Classical.choose_spec (hLiftΨ ψ₂))) =
              (((ℓ : Padic ℓ) ^ k₂)⁻¹) • B_int w₂ :=
            hScaleIndep _ k₂ _ w₂ (vecOf ψ₂.1)
              (Classical.choose_spec (Classical.choose_spec (hLiftΨ ψ₂))) hw₂
          have halg_ℓ : algebraMap (PadicInt ℓ) (Padic ℓ) (ℓ : PadicInt ℓ) = (ℓ : Padic ℓ) := rfl
