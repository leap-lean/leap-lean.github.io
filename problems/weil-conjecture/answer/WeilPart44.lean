          { hom :=
              { app := fun opW => 𝒢.obj.map (Opposite.op (inc_WU opW.unop))
                naturality := fun {opW₁ opW₂} u => by
                  have hop : CategoryTheory.CategoryStruct.comp u
                      (Opposite.op (inc_WU opW₂.unop)) =
                    CategoryTheory.CategoryStruct.comp
                      (Opposite.op (inc_WU opW₁.unop)) (B_U.op.map u) :=
                    congrArg Opposite.op (hinc_nat u.unop).symm
                  exact (𝒢.obj.map_comp _ _).symm.trans
                    ((congrArg 𝒢.obj.map hop).trans (𝒢.obj.map_comp _ _)) } }
        naturality := fun {𝒢₁ 𝒢₂} φ => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext opW
          exact (φ.hom.naturality (Opposite.op (inc_WU opW.unop))).symm }
    refine ⟨J_U, hAdd_J, hLim_J, η_U, ?_, ?_, ?_⟩
    · intro 𝒢 hBij
      let e_W : ∀ W : S.Etale,
          ↑(𝒢.obj.obj (Opposite.op W)) ≃ₗ[R] ↑((J_U.obj 𝒢).obj.obj (Opposite.op W)) :=
        fun W => LinearEquiv.ofBijective ((𝒢.obj.map (Opposite.op (inc_WU W))).hom) (hBij W)
      let inv_mor : Quiver.Hom (J_U.obj 𝒢) 𝒢 :=
        { hom :=
            { app := fun opW => ModuleCat.ofHom (e_W opW.unop).symm.toLinearMap
              naturality := fun {opW₁ opW₂} u => by
                apply ModuleCat.hom_ext; apply LinearMap.ext; intro x
                apply (e_W opW₂.unop).injective
                have hnat := congrArg (fun θ => ModuleCat.Hom.hom θ ((e_W opW₁.unop).symm x))
                  ((η_U.app 𝒢).hom.naturality u)
                exact ((e_W opW₂.unop).apply_symm_apply (((J_U.obj 𝒢).obj.map u).hom x)).trans
                  ((congrArg ((J_U.obj 𝒢).obj.map u).hom
                    ((e_W opW₁.unop).apply_symm_apply x)).symm.trans hnat.symm) } }
      refine CategoryTheory.IsIso.mk ⟨inv_mor, ?_, ?_⟩
      · apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext opW
        apply ModuleCat.hom_ext; apply LinearMap.ext; intro x
        exact (e_W opW.unop).symm_apply_apply x
      · apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext opW
        apply ModuleCat.hom_ext; apply LinearMap.ext; intro x
        exact (e_W opW.unop).apply_symm_apply x
    · intro 𝒢₁ 𝒢₂ φ hBij
      let e_W : ∀ W : S.Etale,
          ↑((J_U.obj 𝒢₁).obj.obj (Opposite.op W)) ≃ₗ[R]
            ↑((J_U.obj 𝒢₂).obj.obj (Opposite.op W)) :=
        fun W => LinearEquiv.ofBijective ((φ.hom.app (Opposite.op (obj_WU W))).hom) (hBij W)
      let inv_mor : Quiver.Hom (J_U.obj 𝒢₂) (J_U.obj 𝒢₁) :=
        { hom :=
            { app := fun opW => ModuleCat.ofHom (e_W opW.unop).symm.toLinearMap
              naturality := fun {opW₁ opW₂} u => by
                apply ModuleCat.hom_ext; apply LinearMap.ext; intro x
                apply (e_W opW₂.unop).injective
                have hnat := congrArg (fun θ => ModuleCat.Hom.hom θ ((e_W opW₁.unop).symm x))
                  ((J_U.map φ).hom.naturality u)
                exact ((e_W opW₂.unop).apply_symm_apply (((J_U.obj 𝒢₂).obj.map u).hom x)).trans
                  ((congrArg ((J_U.obj 𝒢₂).obj.map u).hom
                    ((e_W opW₁.unop).apply_symm_apply x)).symm.trans hnat.symm) } }
      refine CategoryTheory.IsIso.mk ⟨inv_mor, ?_, ?_⟩
      · apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext opW
        apply ModuleCat.hom_ext; apply LinearMap.ext; intro x
        exact (e_W opW.unop).symm_apply_apply x
      · apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext opW
        apply ModuleCat.hom_ext; apply LinearMap.ext; intro x
        exact (e_W opW.unop).apply_symm_apply x
    · intro 𝒢₁ 𝒢₂ φ P_cov hP_mem hSurj
      have hLS : CategoryTheory.Sheaf.IsLocallySurjective (J_U.map φ) := by
        refine CategoryTheory.Presheaf.IsLocallySurjective.mk fun {W} s => ?_
        refine J_top.superset_covering ?_ (hP_mem W)
        intro W' u hu
        rw [CategoryTheory.Presheaf.imageSieve_apply]
        exact hSurj W W' u hu (((J_U.obj 𝒢₂).obj.map u.op).hom s)
      exact (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' ModR (J_U.map φ)).mp hLS

  obtain ⟨J_U, hAdd_J, hLim_J, η_U, hIso_η, hIso_map, hEpi_crit⟩ := hOpen_res_pkg
  let _ : J_U.Additive := hAdd_J
  let _ : CategoryTheory.Limits.PreservesFiniteLimits J_U := hLim_J

  
  have hPair_bij : ∀ W : S.Etale,
      Function.Bijective ((L.ℳ.obj.map (Opposite.op (inc_WU W))).hom) ∧
      Function.Bijective ((L.ι_ext.hom.app (Opposite.op (obj_WU W))).hom) := by
    intro W
    let ι_V : Quiver.Hom L.V S := CategoryTheory.CategoryStruct.comp L.π U.ι
    let h_W := (Fgt.obj W).hom
    let W_U := open_WU W
    let h_WU := (Fgt.obj (obj_WU W)).hom
    refine ⟨?_, ?_⟩
    · let W_V := CategoryTheory.Limits.pullback h_W ι_V
      let WU_V := CategoryTheory.Limits.pullback h_WU ι_V
      let fst_W := CategoryTheory.Limits.pullback.fst h_W ι_V
      let snd_W := CategoryTheory.Limits.pullback.snd h_W ι_V
      let fst_WU := CategoryTheory.Limits.pullback.fst h_WU ι_V
      let snd_WU := CategoryTheory.Limits.pullback.snd h_WU ι_V
      have hcond_fwd : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp fst_WU (Fgt.map (inc_WU W)).left) h_W =
          CategoryTheory.CategoryStruct.comp snd_WU ι_V := by
        have hw : CategoryTheory.CategoryStruct.comp (Fgt.map (inc_WU W)).left h_W = h_WU :=
          CategoryTheory.MorphismProperty.Over.w (inc_WU W)
        rw [CategoryTheory.Category.assoc, hw]
        exact CategoryTheory.Limits.pullback.condition (f := h_WU) (g := ι_V)
      let φ_fwd : Quiver.Hom WU_V W_V :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.CategoryStruct.comp fst_WU (Fgt.map (inc_WU W)).left) snd_WU hcond_fwd
      have hrange_fst : Set.range fst_W.base ⊆ Set.range (open_WU W).ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨y, rfl⟩
        change h_W.base (fst_W.base y) ∈ U
        have hcomm_y : h_W.base (fst_W.base y) = ι_V.base (snd_W.base y) :=
          congrArg (fun φ => φ.base y) (CategoryTheory.Limits.pullback.condition (f := h_W) (g := ι_V))
        have hU_mem : U.ι.base (L.π.base (snd_W.base y)) ∈ (U : Set ↥S) := by
          rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
          exact ⟨L.π.base (snd_W.base y), rfl⟩
        rw [hcomm_y]
        exact hU_mem
      let fst_lift_raw := AlgebraicGeometry.IsOpenImmersion.lift (open_WU W).ι fst_W hrange_fst
      have hfst_raw := AlgebraicGeometry.IsOpenImmersion.lift_fac (open_WU W).ι fst_W hrange_fst
      let fst_lift : Quiver.Hom W_V (Fgt.obj (obj_WU W)).left := fst_lift_raw
      have hfst_lift : CategoryTheory.CategoryStruct.comp fst_lift (Fgt.map (inc_WU W)).left =
          fst_W := hfst_raw
      have hcond_inv : CategoryTheory.CategoryStruct.comp fst_lift h_WU =
          CategoryTheory.CategoryStruct.comp snd_W ι_V := by
        have hw : CategoryTheory.CategoryStruct.comp (Fgt.map (inc_WU W)).left h_W = h_WU :=
          CategoryTheory.MorphismProperty.Over.w (inc_WU W)
        rw [← hw, ← CategoryTheory.Category.assoc, hfst_lift]
        exact CategoryTheory.Limits.pullback.condition (f := h_W) (g := ι_V)
      let φ_inv : Quiver.Hom W_V WU_V :=
        CategoryTheory.Limits.pullback.lift fst_lift snd_W hcond_inv
      have hinc_left_mono : CategoryTheory.Mono (Fgt.map (inc_WU W)).left :=
        (inferInstance : CategoryTheory.Mono (open_WU W).ι)
      have hφ_fwd_fst : CategoryTheory.CategoryStruct.comp φ_fwd fst_W =
          CategoryTheory.CategoryStruct.comp fst_WU (Fgt.map (inc_WU W)).left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hφ_fwd_snd : CategoryTheory.CategoryStruct.comp φ_fwd snd_W = snd_WU :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hφ_inv_fst : CategoryTheory.CategoryStruct.comp φ_inv fst_WU = fst_lift :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hφ_inv_snd : CategoryTheory.CategoryStruct.comp φ_inv snd_WU = snd_W :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have h_fwd_inv : CategoryTheory.CategoryStruct.comp φ_fwd φ_inv =
          CategoryTheory.CategoryStruct.id WU_V := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · apply (cancel_mono (Fgt.map (inc_WU W)).left).mp
          have hs1 : ((φ_fwd ≫ φ_inv) ≫ fst_WU) ≫ (Fgt.map (inc_WU W)).left =
              φ_fwd ≫ (φ_inv ≫ fst_WU) ≫ (Fgt.map (inc_WU W)).left :=
            (congrArg (· ≫ (Fgt.map (inc_WU W)).left)
              (CategoryTheory.Category.assoc φ_fwd φ_inv fst_WU)).trans
              (CategoryTheory.Category.assoc φ_fwd (φ_inv ≫ fst_WU) (Fgt.map (inc_WU W)).left)
          have hs2 : (φ_inv ≫ fst_WU) ≫ (Fgt.map (inc_WU W)).left = fst_W :=
            (congrArg (· ≫ (Fgt.map (inc_WU W)).left) hφ_inv_fst).trans hfst_lift
          have hs3 : (𝟙 WU_V ≫ fst_WU) ≫ (Fgt.map (inc_WU W)).left =
              fst_WU ≫ (Fgt.map (inc_WU W)).left :=
            congrArg (· ≫ (Fgt.map (inc_WU W)).left) (CategoryTheory.Category.id_comp fst_WU)
          exact hs1.trans ((congrArg (φ_fwd ≫ ·) hs2).trans (hφ_fwd_fst.trans hs3.symm))
        · exact (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (φ_fwd ≫ ·) hφ_inv_snd).trans
              (hφ_fwd_snd.trans (CategoryTheory.Category.id_comp _).symm))
      have h_inv_fwd : CategoryTheory.CategoryStruct.comp φ_inv φ_fwd =
          CategoryTheory.CategoryStruct.id W_V := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (φ_inv ≫ ·) hφ_fwd_fst).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ _) hφ_inv_fst).trans
                  (hfst_lift.trans (CategoryTheory.Category.id_comp _).symm))))
        · exact (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (φ_inv ≫ ·) hφ_fwd_snd).trans
              (hφ_inv_snd.trans (CategoryTheory.Category.id_comp _).symm))
      have htriv_res : ∀ (s : ↑(L.ℳ.obj.obj (Opposite.op W))) (y₁ : ↥WU_V),
          L.triv (obj_WU W) ((L.ℳ.obj.map (Opposite.op (inc_WU W))).hom s) y₁ =
            L.triv W s (φ_fwd.base y₁) :=
        L.hPair.1 (inc_WU W) φ_fwd
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      refine ⟨?_, ?_⟩
      · intro s₁ s₂ hs
        apply (L.hPair.2 W).1
        apply LocallyConstant.ext
        intro y
        have hy : φ_fwd.base (φ_inv.base y) = y :=
          congrArg (fun φ => φ.base y) h_inv_fwd
        calc
          L.triv W s₁ y = L.triv W s₁ (φ_fwd.base (φ_inv.base y)) := by rw [hy]
          _ = L.triv (obj_WU W) ((L.ℳ.obj.map (Opposite.op (inc_WU W))).hom s₁) (φ_inv.base y) :=
            (htriv_res s₁ (φ_inv.base y)).symm
          _ = L.triv (obj_WU W) ((L.ℳ.obj.map (Opposite.op (inc_WU W))).hom s₂) (φ_inv.base y) := by
            rw [hs]
          _ = L.triv W s₂ (φ_fwd.base (φ_inv.base y)) := htriv_res s₂ (φ_inv.base y)
          _ = L.triv W s₂ y := by rw [hy]
      · intro t
        let f_U := L.triv (obj_WU W) t
        have hf_U_mem : f_U ∈ Set.range (L.triv (obj_WU W)) := ⟨t, rfl⟩
        rw [(L.hPair.2 (obj_WU W)).2.2.1] at hf_U_mem
        let f : LocallyConstant ↥W_V (Fin M → ZMod m) := f_U.comap φ_inv.base.hom
        have hf_mem : f ∈ Set.range (L.triv W) := by
          rw [(L.hPair.2 W).2.2.1]
          intro g m_g hm_fst hm_snd y
          let m'_g : Quiver.Hom WU_V WU_V :=
            CategoryTheory.CategoryStruct.comp φ_fwd (CategoryTheory.CategoryStruct.comp m_g φ_inv)
          have hm'_fst : CategoryTheory.CategoryStruct.comp m'_g fst_WU = fst_WU := by
            apply (cancel_mono (Fgt.map (inc_WU W)).left).mp
            have hstep1 : (φ_inv ≫ fst_WU) ≫ (Fgt.map (inc_WU W)).left = fst_W :=
              (congrArg (· ≫ _) hφ_inv_fst).trans hfst_lift
            have hstep2 : ((m_g ≫ φ_inv) ≫ fst_WU) ≫ (Fgt.map (inc_WU W)).left = fst_W :=
              (congrArg (· ≫ _) (CategoryTheory.Category.assoc m_g φ_inv fst_WU)).trans
                ((CategoryTheory.Category.assoc m_g _ _).trans
                  ((congrArg (m_g ≫ ·) hstep1).trans hm_fst))
            exact (congrArg (· ≫ _) (CategoryTheory.Category.assoc φ_fwd (m_g ≫ φ_inv) fst_WU)).trans
              ((CategoryTheory.Category.assoc φ_fwd _ _).trans
                ((congrArg (φ_fwd ≫ ·) hstep2).trans hφ_fwd_fst))
          have hm'_snd : CategoryTheory.CategoryStruct.comp m'_g snd_WU =
              CategoryTheory.CategoryStruct.comp snd_WU (L.act g) := by
            have hstep1 : (m_g ≫ φ_inv) ≫ snd_WU = snd_W ≫ L.act g :=
              (CategoryTheory.Category.assoc m_g φ_inv snd_WU).trans
                ((congrArg (m_g ≫ ·) hφ_inv_snd).trans hm_snd)
            exact (CategoryTheory.Category.assoc φ_fwd (m_g ≫ φ_inv) snd_WU).trans
              ((congrArg (φ_fwd ≫ ·) hstep1).trans
                ((CategoryTheory.Category.assoc φ_fwd snd_W _).symm.trans
                  (congrArg (· ≫ _) hφ_fwd_snd)))
          have hconj : CategoryTheory.CategoryStruct.comp φ_inv m'_g =
              CategoryTheory.CategoryStruct.comp m_g φ_inv :=
            (CategoryTheory.Category.assoc φ_inv φ_fwd (m_g ≫ φ_inv)).symm.trans
              ((congrArg (· ≫ _) h_inv_fwd).trans (CategoryTheory.Category.id_comp _))
          have hy_eq : φ_inv.base (m_g.base y) = m'_g.base (φ_inv.base y) :=
            (congrArg (fun φ => φ.base y) hconj).symm
          change f_U (φ_inv.base (m_g.base y)) = ((L.τ_rep g).val).mulVec (f_U (φ_inv.base y))
          rw [hy_eq]
          exact hf_U_mem g m'_g hm'_fst hm'_snd (φ_inv.base y)
        obtain ⟨s, hs⟩ := hf_mem
        refine ⟨s, ?_⟩
        apply (L.hPair.2 (obj_WU W)).1
        apply LocallyConstant.ext
        intro y₁
        have hy₁ : φ_inv.base (φ_fwd.base y₁) = y₁ :=
          congrArg (fun φ => φ.base y₁) h_fwd_inv
        rw [htriv_res s y₁, hs]
        change f_U (φ_inv.base (φ_fwd.base y₁)) = f_U y₁
        rw [hy₁]
    · refine ⟨(L.hPair.2 (obj_WU W)).2.1, ?_⟩
      intro s_M
      let f := L.triv (obj_WU W) s_M
      have hf_range : f ∈ Set.range (L.triv (obj_WU W)) := ⟨s_M, rfl⟩
      rw [(L.hPair.2 (obj_WU W)).2.2.1] at hf_range
      have hU_top : ((TopologicalSpace.Opens.map h_WU.base).obj U) ⊔ ⊥ = ⊤ := by
        ext z
        refine ⟨fun _ => trivial, fun _ => Or.inl ?_⟩
        have hz : W_U.ι.base z ∈ (W_U : Set ↥(Fgt.obj W).left) := by
          rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
          exact ⟨z, rfl⟩
        exact hz
      have hf_im : f ∈ Set.range
          ((L.triv (obj_WU W)).comp (L.ι_ext.hom.app (Opposite.op (obj_WU W))).hom.toAddMonoidHom) := by
        rw [(L.hPair.2 (obj_WU W)).2.2.2]
        exact ⟨⟨⊥, hU_top, fun _ hy => False.elim hy⟩, hf_range⟩
      obtain ⟨s_J, hs_J⟩ := hf_im
      exact ⟨s_J, (L.hPair.2 (obj_WU W)).1 hs_J⟩

  have hIso_η_M : CategoryTheory.IsIso (η_U.app L.ℳ) := hIso_η L.ℳ (fun W => (hPair_bij W).1)
  have hIso_J_ι : CategoryTheory.IsIso (J_U.map L.ι_ext) :=
    hIso_map L.ι_ext (fun W => (hPair_bij W).2)
  let θ_M : CategoryTheory.Iso (J_U.obj L.𝒥) L.ℳ :=
    CategoryTheory.Iso.trans
      (@CategoryTheory.asIso _ _ _ _ (J_U.map L.ι_ext) hIso_J_ι)
      (@CategoryTheory.asIso _ _ _ _ (η_U.app L.ℳ) hIso_η_M).symm
  have hθ_M : CategoryTheory.CategoryStruct.comp (η_U.app L.𝒥) θ_M.hom = L.ι_ext := by
    have : CategoryTheory.IsIso (η_U.app L.ℳ) := hIso_η_M
    dsimp [θ_M]
    rw [← CategoryTheory.Category.assoc]
    change (η_U.app L.𝒥 ≫ J_U.map L.ι_ext) ≫ CategoryTheory.inv (η_U.app L.ℳ) = L.ι_ext
    rw [← η_U.naturality L.ι_ext]
    change (L.ι_ext ≫ η_U.app L.ℳ) ≫ CategoryTheory.inv (η_U.app L.ℳ) = L.ι_ext
    rw [CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id,
      CategoryTheory.Category.comp_id]

  
  let P_const : CategoryTheory.Functor (Opposite S.Etale) ModR :=
    (CategoryTheory.Functor.const (Opposite S.Etale)).obj R_mod
  let adj_sh := CategoryTheory.sheafificationAdjunction J_top ModR
  let η_sh : Quiver.Hom P_const oneR.obj := adj_sh.unit.app P_const
  let L_pre : CategoryTheory.Functor (Opposite S.Etale) ModR :=
    { obj := fun W => ModuleCat.of R (LocallyConstant ↥((Fgt.obj W.unop).left) R)
      map := fun u => ModuleCat.ofHom (LocallyConstant.comapₗ R ((Fgt.map u.unop).left).base.hom)
      map_id := fun _ => by
        apply ModuleCat.hom_ext; apply LinearMap.ext; intro _; apply LocallyConstant.ext; intro _; rfl
      map_comp := fun _ _ => by
        apply ModuleCat.hom_ext; apply LinearMap.ext; intro _; apply LocallyConstant.ext; intro _; rfl }
  let asLC : ∀ {V : S.Etale},
      (L_pre ⋙ CategoryTheory.forget ModR).obj (Opposite.op V) →
      LocallyConstant ↥(Fgt.obj V).left R := fun v => v
  have hSheaf_type_LC : CategoryTheory.Presieve.IsSheaf J_top
      (L_pre ⋙ CategoryTheory.forget ModR) := by
    intro W S_sieve hS fam hcompat
    have hSurj : ∀ x : ↥(Fgt.obj W).left,
        ∃ (V : S.Etale) (g : Quiver.Hom V W) (y : ↥(Fgt.obj V).left),
          S_sieve.arrows g ∧ AlgebraicGeometry.Etale (Fgt.map g).left ∧
            ((Fgt.map g).left).base y = x :=
      (hJ_mem W S_sieve).mp hS
    have hFiber : ∀ {V₁ V₂ : S.Etale} (g₁ : Quiver.Hom V₁ W) (g₂ : Quiver.Hom V₂ W)
        (hg₁ : S_sieve.arrows g₁) (hg₂ : S_sieve.arrows g₂)
        (y₁ : ↥(Fgt.obj V₁).left) (y₂ : ↥(Fgt.obj V₂).left),
        ((Fgt.map g₁).left).base y₁ = ((Fgt.map g₂).left).base y₂ →
        asLC (fam g₁ hg₁) y₁ = asLC (fam g₂ hg₂) y₂ := by
      intro V₁ V₂ g₁ g₂ hg₁ hg₂ y₁ y₂ hy_eq
      let W₀ := CategoryTheory.Limits.pullback (Fgt.map g₁).left (Fgt.map g₂).left
      let p₁ : Quiver.Hom W₀ (Fgt.obj V₁).left :=
        CategoryTheory.Limits.pullback.fst (Fgt.map g₁).left (Fgt.map g₂).left
      let p₂ : Quiver.Hom W₀ (Fgt.obj V₂).left :=
        CategoryTheory.Limits.pullback.snd (Fgt.map g₁).left (Fgt.map g₂).left
      have hp₂_et : AlgebraicGeometry.Etale p₂ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback (Fgt.map g₁).left (Fgt.map g₂).left)
          (hEtale_left g₁)
      let E_et : S.Etale :=
        letI : AlgebraicGeometry.Etale p₂ := hp₂_et
        letI : AlgebraicGeometry.Etale (Fgt.obj V₂).hom := V₂.prop
        CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.CategoryStruct.comp p₂ (Fgt.obj V₂).hom) inferInstance
      have hp₁_w : CategoryTheory.CategoryStruct.comp p₁ (Fgt.obj V₁).hom = (Fgt.obj E_et).hom := by
        have hw₁ : CategoryTheory.CategoryStruct.comp (Fgt.map g₁).left (Fgt.obj W).hom =
            (Fgt.obj V₁).hom := CategoryTheory.MorphismProperty.Over.w g₁
