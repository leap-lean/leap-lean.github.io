      (∀ b : B r, tau_bar1 (q_B r b) = tau_bar2 (q_B r b)) → tau_bar1 = tau_bar2 := by
    intro r tau_bar1 tau_bar2 hb
    have hring : tau_bar1.toRingHom = tau_bar2.toRingHom := by
      apply (hGeomTower r).2.2.1
      · exact hb
      · intro c
        have hqk : q_k r c = algebraMap R0_bar (B_bar r) (TensorProduct.tmul F 1 c) := by
          rw [(hGeomTower r).2.1 1 c, map_one, map_one, one_mul]
        change tau_bar1 (q_k r c) = tau_bar2 (q_k r c)
        rw [hqk, tau_bar1.commutes, tau_bar2.commutes]
    ext x
    exact RingHom.congr_fun hring x

  let d_bar : ∀ (r : ℕ) (σ : B r ≃ₐ[R₀] B r), σ ∈ Γ_geom r → (V_bar r ⟶ V_bar r) :=
    fun r σ hσ =>
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Classical.choose (hAut_up r σ hσ)).symm.toRingHom)
  have hd_bar_spec : ∀ (r : ℕ) (σ : B r ≃ₐ[R₀] B r) (hσ : σ ∈ Γ_geom r),
      d_bar r σ hσ ≫ p_Vbar r = p_Vbar r ∧
      d_bar r σ hσ ≫ q_V r =
        q_V r ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) := by
    intro r σ hσ
    set sigma_bar := Classical.choose (hAut_up r σ hσ)
    have hsigma_bar_spec : ∀ b : B r, sigma_bar (q_B r b) = q_B r (σ b) :=
      Classical.choose_spec (hAut_up r σ hσ)
    have hpi_bar_deck : d_bar r σ hσ ≫ pi_bar r = pi_bar r := by
      dsimp only [d_bar, pi_bar]
      rw [← AlgebraicGeometry.Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro w
      exact sigma_bar.symm.commutes w
    refine ⟨?_, ?_⟩
    · dsimp only [p_Vbar]
      rw [← CategoryTheory.Category.assoc, hpi_bar_deck]
    · dsimp only [d_bar, q_V]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      ext b
      change sigma_bar.symm (q_B r b) = q_B r (σ.symm b)
      apply sigma_bar.injective
      rw [sigma_bar.apply_symm_apply, hsigma_bar_spec (σ.symm b), σ.apply_symm_apply]

  have hFibTrans_geom : ∀ (r : ℕ) (X : AlgebraicGeometry.Scheme.{u}) (g_S : X ⟶ S)
      (y₁ y₂ : ↥(CategoryTheory.Limits.pullback g_S (p_Vbar r))),
      (CategoryTheory.Limits.pullback.fst g_S (p_Vbar r)).base y₁ =
        (CategoryTheory.Limits.pullback.fst g_S (p_Vbar r)).base y₂ →
      ∃ (σ : B r ≃ₐ[R₀] B r) (hσ : σ ∈ Γ_geom r)
        (m_tilde : CategoryTheory.Limits.pullback g_S (p_Vbar r) ⟶
          CategoryTheory.Limits.pullback g_S (p_Vbar r)),
        m_tilde ≫ CategoryTheory.Limits.pullback.fst g_S (p_Vbar r) =
          CategoryTheory.Limits.pullback.fst g_S (p_Vbar r) ∧
        m_tilde ≫ CategoryTheory.Limits.pullback.snd g_S (p_Vbar r) =
          CategoryTheory.Limits.pullback.snd g_S (p_Vbar r) ≫ d_bar r σ hσ ∧
        m_tilde.base y₁ = y₂ := by
    intro r X g_S y₁ y₂ hy
    let X_Ubar := CategoryTheory.Limits.pullback g_S j_Ubar
    let ι_X : X_Ubar ⟶ X := CategoryTheory.Limits.pullback.fst g_S j_Ubar
    let g_Ubar : X_Ubar ⟶ AlgebraicGeometry.Spec (CommRingCat.of R0_bar) :=
      CategoryTheory.Limits.pullback.snd g_S j_Ubar
    haveI : AlgebraicGeometry.IsOpenImmersion ι_X :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback g_S j_Ubar).flip inferInstance
    let pi_bar_id : V_bar r ⟶ AlgebraicGeometry.Spec (CommRingCat.of R0_bar) :=
      pi_bar r ≫ (CategoryTheory.Iso.refl _).hom
    have hpi_bar_id : pi_bar_id = pi_bar r := CategoryTheory.Category.comp_id (pi_bar r)
    let P := CategoryTheory.Limits.pullback g_S (p_Vbar r)
    let P' := CategoryTheory.Limits.pullback g_Ubar pi_bar_id
    let to_XUbar : P ⟶ X_Ubar :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g_S (p_Vbar r))
        (CategoryTheory.Limits.pullback.snd g_S (p_Vbar r) ≫ pi_bar r)
        (by rw [CategoryTheory.Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
    let hom_P : P ⟶ P' :=
      CategoryTheory.Limits.pullback.lift to_XUbar
        (CategoryTheory.Limits.pullback.snd g_S (p_Vbar r))
        (by rw [CategoryTheory.Limits.pullback.lift_snd, hpi_bar_id])
    let inv_P : P' ⟶ P :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g_Ubar pi_bar_id ≫ ι_X)
        (CategoryTheory.Limits.pullback.snd g_Ubar pi_bar_id)
        (by
          dsimp only [ι_X, g_Ubar, p_Vbar]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
          exact (congrArg
            (fun m => (CategoryTheory.Limits.pullback.snd g_Ubar pi_bar_id ≫ m) ≫ j_Ubar)
            hpi_bar_id).trans (CategoryTheory.Category.assoc _ _ _))
    have h_hom_inv : hom_P ≫ inv_P = 𝟙 P := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
    have h_fst_eq : (CategoryTheory.Limits.pullback.fst g_Ubar pi_bar_id).base (hom_P.base y₁) =
        (CategoryTheory.Limits.pullback.fst g_Ubar pi_bar_id).base (hom_P.base y₂) := by
      apply ι_X.isOpenEmbedding.injective
      have h1 :
          ι_X.base ((CategoryTheory.Limits.pullback.fst g_Ubar pi_bar_id).base (hom_P.base y₁)) =
          (CategoryTheory.Limits.pullback.fst g_S (p_Vbar r)).base y₁ :=
        congrArg (fun m : P ⟶ X => m.base y₁)
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ ι_X) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)))
      have h2 :
          ι_X.base ((CategoryTheory.Limits.pullback.fst g_Ubar pi_bar_id).base (hom_P.base y₂)) =
          (CategoryTheory.Limits.pullback.fst g_S (p_Vbar r)).base y₂ :=
        congrArg (fun m : P ⟶ X => m.base y₂)
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ ι_X) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)))
      exact h1.trans (hy.trans h2.symm)
    obtain ⟨tau_bar, m_taubar, hm_fst, hm_snd, hm_pt⟩ :=
      ((hTors_geom r).2.1 X_Ubar g_Ubar).2.2 (hom_P.base y₁) (hom_P.base y₂) h_fst_eq
    obtain ⟨σ, hσ, hτσ⟩ := hAut_down r tau_bar
    have hsigma_bar_eq : Classical.choose (hAut_up r σ hσ) = tau_bar :=
      hAut_unique r _ tau_bar
        (fun b => (Classical.choose_spec (hAut_up r σ hσ) b).trans (hτσ b).symm)
    have hd_eq : d_bar r σ hσ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom tau_bar.symm.toRingHom) := by
      dsimp only [d_bar]
      rw [hsigma_bar_eq]
    refine ⟨σ, hσ, hom_P ≫ m_taubar ≫ inv_P, ?_, ?_, ?_⟩
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.assoc m_taubar, hm_fst,
        ← CategoryTheory.Category.assoc hom_P, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Limits.pullback.lift_fst]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_snd, hm_snd,
        ← CategoryTheory.Category.assoc hom_P, CategoryTheory.Limits.pullback.lift_snd, hd_eq]
    · change inv_P.base (m_taubar.base (hom_P.base y₁)) = y₂
      rw [hm_pt]
      exact congrArg (fun m : P ⟶ P => m.base y₂) h_hom_inv

  
  let T_S : S.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 S)
  let A_tors : ℕ → AddCommGrpCat.{u} :=
    fun r => AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ (r + 1))))
  let hConst_S := fun r : ℕ => hConstEquivSite S (A_tors r)
  let hT_S_lvl : ∀ r : ℕ, CategoryTheory.Limits.IsTerminal T_S :=
    fun r => Classical.choose (hConst_S r)
  let θ_S : ∀ (r : ℕ) (Y : S.Etale),
      LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y).left
        (ULift.{u} (ZMod (ℓ ^ (r + 1)))) →+
        ↑((weilEtaleTorsionSheaf S (ℓ ^ (r + 1))).obj.obj (Opposite.op Y)) :=
    fun r => Classical.choose (Classical.choose_spec (hConst_S r))
  have hθ_spec := fun r : ℕ => Classical.choose_spec (Classical.choose_spec (hConst_S r))
  have hθ_bij : ∀ (r : ℕ) (Y : S.Etale), Function.Bijective (θ_S r Y) :=
    fun r => (hθ_spec r).1
  have hθ_nat : ∀ (r : ℕ) {Y₁ Y₂ : S.Etale} (f : Y₁ ⟶ Y₂)
      (g : LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y₂).left
        (ULift.{u} (ZMod (ℓ ^ (r + 1))))),
      ((weilEtaleTorsionSheaf S (ℓ ^ (r + 1))).obj.map (Opposite.op f)).hom (θ_S r Y₂ g) =
        θ_S r Y₁ (g.comap ((AlgebraicGeometry.Scheme.Etale.forget S).map f).left.base.hom) :=
    fun r => @(hθ_spec r).2.1
  have hθ_unit : ∀ (r : ℕ) (a : ULift.{u} (ZMod (ℓ ^ (r + 1)))),
      θ_S r T_S (LocallyConstant.const _ a) =
        ((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u}
          (hT_S_lvl r)).unit.app (A_tors r)).hom a :=
    fun r => (hθ_spec r).2.2

  
  let H_mat_r : ∀ r : ℕ, Set (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1)))) :=
    fun r => (fun h : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ =>
      (h.val).map (PadicInt.toZModPow (r + 1))) '' (H_geom : Set _)
