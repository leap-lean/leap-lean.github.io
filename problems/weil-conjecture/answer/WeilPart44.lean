    intro 𝒞 𝒟 _ _ L X₀ Y₀ Z₀ W₀ Θ iso_b ψ
    simp only [CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom,
      CategoryTheory.Functor.mapIso_inv, ← CategoryTheory.Category.assoc,
      iso_b.hom_inv_id, CategoryTheory.Category.id_comp,
      ← L.map_comp, Θ.hom_inv_id, L.map_id]

  have hCatChase : ∀ {𝒞 𝒟 ℰ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
      [CategoryTheory.Category.{u + 1, u + 1} ℰ]
      (L : CategoryTheory.Functor 𝒟 𝒞) (P : CategoryTheory.Functor ℰ 𝒟)
      {ℒ₁ ℒ₀ : ℰ} (τ_L : ℒ₁ ⟶ ℒ₀)
      {ℋ₁ ℋ₀ : 𝒟} (τ_H : ℋ₁ ⟶ ℋ₀)
      (Θ₁ : P.obj ℒ₁ ≅ ℋ₁) (Θ₀ : P.obj ℒ₀ ≅ ℋ₀)
      (_ : P.map τ_L ≫ Θ₀.hom = Θ₁.hom ≫ τ_H)
      {M₁ M₀ A₁ A₀ : 𝒞}
      (iso₁ : L.obj ℋ₁ ≅ M₁) (iso₀ : L.obj ℋ₀ ≅ M₀)
      (τ_b : M₁ ⟶ M₀)
      (_ : L.map τ_H ≫ iso₀.hom = iso₁.hom ≫ τ_b)
      (ψ₁ : L.obj (P.obj ℒ₁) ≅ A₁) (ψ₀ : L.obj (P.obj ℒ₀) ≅ A₀)
      (τ_a : A₁ ⟶ A₀)
      (_ : L.map (P.map τ_L) ≫ ψ₀.hom = ψ₁.hom ≫ τ_a),
      τ_b ≫ (iso₀.symm ≪≫ (L.mapIso Θ₀).symm ≪≫ ψ₀).hom =
        (iso₁.symm ≪≫ (L.mapIso Θ₁).symm ≪≫ ψ₁).hom ≫ τ_a := by
    intro 𝒞 𝒟 ℰ _ _ _ L P ℒ₁ ℒ₀ τ_L ℋ₁ ℋ₀ τ_H Θ₁ Θ₀ hΘ
      M₁ M₀ A₁ A₀ iso₁ iso₀ τ_b hτ ψ₁ ψ₀ τ_a hψ
    have hΘ_inv : τ_H ≫ Θ₀.inv = Θ₁.inv ≫ P.map τ_L := by
      calc
        τ_H ≫ Θ₀.inv = (Θ₁.inv ≫ Θ₁.hom) ≫ (τ_H ≫ Θ₀.inv) := by
          rw [Θ₁.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = Θ₁.inv ≫ ((Θ₁.hom ≫ τ_H) ≫ Θ₀.inv) := by
          simp only [CategoryTheory.Category.assoc]
        _ = Θ₁.inv ≫ ((P.map τ_L ≫ Θ₀.hom) ≫ Θ₀.inv) := by rw [← hΘ]
        _ = Θ₁.inv ≫ P.map τ_L := by
          rw [CategoryTheory.Category.assoc, Θ₀.hom_inv_id, CategoryTheory.Category.comp_id]
    have hiso_comm : iso₁.hom ≫ (τ_b ≫ (iso₀.symm ≪≫ (L.mapIso Θ₀).symm ≪≫ ψ₀).hom) =
        iso₁.hom ≫ ((iso₁.symm ≪≫ (L.mapIso Θ₁).symm ≪≫ ψ₁).hom ≫ τ_a) := by
      calc
        iso₁.hom ≫ (τ_b ≫ (iso₀.symm ≪≫ (L.mapIso Θ₀).symm ≪≫ ψ₀).hom)
          = (iso₁.hom ≫ τ_b) ≫ (iso₀.symm ≪≫ (L.mapIso Θ₀).symm ≪≫ ψ₀).hom :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = (L.map τ_H ≫ iso₀.hom) ≫ (iso₀.symm ≪≫ (L.mapIso Θ₀).symm ≪≫ ψ₀).hom := by
            rw [← hτ]
        _ = L.map τ_H ≫ (L.map Θ₀.inv ≫ ψ₀.hom) := by
            simp only [CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom,
              CategoryTheory.Functor.mapIso_inv, CategoryTheory.Category.assoc]
            rw [← CategoryTheory.Category.assoc iso₀.hom iso₀.inv, iso₀.hom_inv_id,
              CategoryTheory.Category.id_comp]
        _ = (L.map τ_H ≫ L.map Θ₀.inv) ≫ ψ₀.hom :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = (L.map Θ₁.inv ≫ L.map (P.map τ_L)) ≫ ψ₀.hom := by
            rw [← L.map_comp, hΘ_inv, L.map_comp]
        _ = L.map Θ₁.inv ≫ (ψ₁.hom ≫ τ_a) := by
            rw [CategoryTheory.Category.assoc, hψ]
        _ = iso₁.hom ≫ ((iso₁.symm ≪≫ (L.mapIso Θ₁).symm ≪≫ ψ₁).hom ≫ τ_a) := by
            simp only [CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom,
              CategoryTheory.Functor.mapIso_inv, ← CategoryTheory.Category.assoc,
              iso₁.hom_inv_id, CategoryTheory.Category.id_comp]
    calc
      τ_b ≫ (iso₀.symm ≪≫ (L.mapIso Θ₀).symm ≪≫ ψ₀).hom
        = (iso₁.inv ≫ iso₁.hom) ≫ (τ_b ≫ (iso₀.symm ≪≫ (L.mapIso Θ₀).symm ≪≫ ψ₀).hom) := by
          rw [iso₁.inv_hom_id, CategoryTheory.Category.id_comp]
      _ = iso₁.inv ≫ (iso₁.hom ≫ ((iso₁.symm ≪≫ (L.mapIso Θ₁).symm ≪≫ ψ₁).hom ≫ τ_a)) := by
          rw [CategoryTheory.Category.assoc, hiso_comm]
      _ = (iso₁.symm ≪≫ (L.mapIso Θ₁).symm ≪≫ ψ₁).hom ≫ τ_a := by
          rw [← CategoryTheory.Category.assoc, iso₁.inv_hom_id, CategoryTheory.Category.id_comp]

  have hφ_mate : ∀ r : ℕ,
      L_pr.map (Θ_j (ℒ₀ r)).hom ≫ ((W_mid.iso_bar r).hom ≫ (φ_ℳ r).hom) =
        (adj_pr.homEquiv _ (ℳ_ab r)).symm (η_ℳ r) :=
    fun r => hCatMate L_pr (Θ_j (ℒ₀ r)) (W_mid.iso_bar r) (ψ_iso r)

  have hConj1 : ∀ r : ℕ,
      W_mid.τ_bar r ≫ (φ_ℳ r).hom = (φ_ℳ (r + 1)).hom ≫ τ_ℳ_ab r := by
    intro r
    let B_j := weilEtaleSitePullback U₀.ι
    let P_j := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      B_j AddCommGrpCat.{u} _ D₀.left.smallEtaleTopology U₀.toScheme.smallEtaleTopology hCont_j
    let R_pr := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      B_pr AddCommGrpCat.{u} _ D₀.left.smallEtaleTopology S_bar.smallEtaleTopology W_mid.hCont_pr
    let π_dn := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
    let π_up := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B (r + 1)))) ≫ e_U.hom
    let ι_dn := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R0_bar (B_bar r))) ≫
      e_Ubar.hom) ≫ U_bar.ι
    let ι_up := (AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap R0_bar (B_bar (r + 1)))) ≫ e_Ubar.hom) ≫ U_bar.ι
    have hη_comm : P_j.map (τ_ℒ r) ≫ η_ℳ r = η_ℳ (r + 1) ≫ R_pr.map (τ_ℳ_ab r) := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext opW₀
      rcases opW₀ with ⟨W₀⟩
      ext s_up
      apply ((htriv_ab r).2 (B_pr.obj W₀)).1
      ext y_dn i
      let h₀ := ((AlgebraicGeometry.Scheme.Etale.forget D₀.left).obj W₀).hom
      let h_bar := ((AlgebraicGeometry.Scheme.Etale.forget S_bar).obj (B_pr.obj W₀)).hom
      let h_U := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj (B_j.obj W₀)).hom
      obtain ⟨m_ι_bar, hm_bar_fst, hm_bar_snd, hm_bar_surj⟩ := hm_ι_surj r _ h_bar
      obtain ⟨y_up, rfl⟩ := hm_bar_surj y_dn
      have hp_U : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B r).toRingHom) ≫ π_dn = π_up := by
        dsimp only [π_dn, π_up]
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
        congr 3
        ext z
        exact (ι_B r).commutes z
      let m_ι_U : CategoryTheory.Limits.pullback h_U π_up ⟶
          CategoryTheory.Limits.pullback h_U π_dn :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst h_U π_up)
          (CategoryTheory.Limits.pullback.snd h_U π_up ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B r).toRingHom))
          (by rw [CategoryTheory.Category.assoc, hp_U, CategoryTheory.Limits.pullback.condition])
      have hm_U_fst : m_ι_U ≫ CategoryTheory.Limits.pullback.fst h_U π_dn =
          CategoryTheory.Limits.pullback.fst h_U π_up :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hm_U_snd : m_ι_U ≫ CategoryTheory.Limits.pullback.snd h_U π_dn =
          CategoryTheory.Limits.pullback.snd h_U π_up ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B r).toRingHom) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      let mk_a_dn : CategoryTheory.Limits.pullback h_bar ι_dn ⟶
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj (B_j.obj W₀)).left :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst h_bar ι_dn ≫
            CategoryTheory.Limits.pullback.fst h₀ pr_D)
          (CategoryTheory.Limits.pullback.snd h_bar ι_dn ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q_B r)) ≫ π_dn)
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (CategoryTheory.Limits.pullback.fst h_bar ι_dn ≫ ·)
              CategoryTheory.Limits.pullback.condition).trans
              ((CategoryTheory.Category.assoc _ h_bar pr_D).symm.trans
                ((congrArg (· ≫ pr_D) CategoryTheory.Limits.pullback.condition).trans
                  ((CategoryTheory.Category.assoc _ ι_dn pr_D).trans
                    ((congrArg (CategoryTheory.Limits.pullback.snd h_bar ι_dn ≫ ·)
                      (hSq_cover r)).trans
                      ((CategoryTheory.Category.assoc _ _ _).symm.trans
                        (CategoryTheory.Category.assoc _ _ U₀.ι).symm)))))))
      let θ_dn : CategoryTheory.Limits.pullback h_bar ι_dn ⟶
          CategoryTheory.Limits.pullback h_U π_dn :=
        CategoryTheory.Limits.pullback.lift mk_a_dn
          (CategoryTheory.Limits.pullback.snd h_bar ι_dn ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q_B r)))
          ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
            (CategoryTheory.Category.assoc _ _ π_dn).symm)
      have hθ_dn_fst : (θ_dn ≫ CategoryTheory.Limits.pullback.fst h_U π_dn) ≫
          CategoryTheory.Limits.pullback.fst h₀ U₀.ι =
          CategoryTheory.Limits.pullback.fst h_bar ι_dn ≫
            CategoryTheory.Limits.pullback.fst h₀ pr_D :=
        (congrArg (· ≫ CategoryTheory.Limits.pullback.fst h₀ U₀.ι)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      have hθ_dn_snd : θ_dn ≫ CategoryTheory.Limits.pullback.snd h_U π_dn =
          CategoryTheory.Limits.pullback.snd h_bar ι_dn ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q_B r)) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      let mk_a_up : CategoryTheory.Limits.pullback h_bar ι_up ⟶
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj (B_j.obj W₀)).left :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst h_bar ι_up ≫
            CategoryTheory.Limits.pullback.fst h₀ pr_D)
          (CategoryTheory.Limits.pullback.snd h_bar ι_up ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q_B (r + 1))) ≫ π_up)
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (CategoryTheory.Limits.pullback.fst h_bar ι_up ≫ ·)
              CategoryTheory.Limits.pullback.condition).trans
              ((CategoryTheory.Category.assoc _ h_bar pr_D).symm.trans
                ((congrArg (· ≫ pr_D) CategoryTheory.Limits.pullback.condition).trans
                  ((CategoryTheory.Category.assoc _ ι_up pr_D).trans
                    ((congrArg (CategoryTheory.Limits.pullback.snd h_bar ι_up ≫ ·)
                      (hSq_cover (r + 1))).trans
                      ((CategoryTheory.Category.assoc _ _ _).symm.trans
                        (CategoryTheory.Category.assoc _ _ U₀.ι).symm)))))))
      let θ_up : CategoryTheory.Limits.pullback h_bar ι_up ⟶
          CategoryTheory.Limits.pullback h_U π_up :=
        CategoryTheory.Limits.pullback.lift mk_a_up
          (CategoryTheory.Limits.pullback.snd h_bar ι_up ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q_B (r + 1))))
          ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
            (CategoryTheory.Category.assoc _ _ π_up).symm)
      have hθ_up_fst : (θ_up ≫ CategoryTheory.Limits.pullback.fst h_U π_up) ≫
          CategoryTheory.Limits.pullback.fst h₀ U₀.ι =
          CategoryTheory.Limits.pullback.fst h_bar ι_up ≫
            CategoryTheory.Limits.pullback.fst h₀ pr_D :=
        (congrArg (· ≫ CategoryTheory.Limits.pullback.fst h₀ U₀.ι)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      have hθ_up_snd : θ_up ≫ CategoryTheory.Limits.pullback.snd h_U π_up =
          CategoryTheory.Limits.pullback.snd h_bar ι_up ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q_B (r + 1))) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hq_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_Bbar r).toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q_B r)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q_B (r + 1))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B r).toRingHom) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        congr 2
        ext b
        exact ((hGeom_rel.2.2 r).2.2.2.1 b).symm
      have hθ_step : m_ι_bar ≫ θ_dn = θ_up ≫ m_ι_U := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · apply CategoryTheory.Limits.pullback.hom_ext
          · exact
              ((CategoryTheory.Category.assoc m_ι_bar _ _).trans
                ((congrArg (m_ι_bar ≫ ·) hθ_dn_fst).trans
                  ((CategoryTheory.Category.assoc _ _ _).symm.trans
                    ((congrArg (· ≫ CategoryTheory.Limits.pullback.fst h₀ pr_D) hm_bar_fst).trans
                      (hθ_up_fst.symm.trans
                        (congrArg (· ≫ CategoryTheory.Limits.pullback.fst h₀ U₀.ι)
                          ((congrArg (θ_up ≫ ·) hm_U_fst.symm).trans
                            (CategoryTheory.Category.assoc _ _ _).symm)))))))
          · have hs_mid : (m_ι_bar ≫ θ_dn) ≫ CategoryTheory.Limits.pullback.snd h_U π_dn =
                θ_up ≫ CategoryTheory.Limits.pullback.snd h_U π_up ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B r).toRingHom) :=
              (CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (m_ι_bar ≫ ·) hθ_dn_snd).trans
                  ((CategoryTheory.Category.assoc _ _ _).symm.trans
                    ((congrArg (· ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q_B r)))
                      hm_bar_snd).trans
                      ((CategoryTheory.Category.assoc _ _ _).trans
                        ((congrArg _ hq_spec).trans
                          ((CategoryTheory.Category.assoc _ _ _).symm.trans
                            ((congrArg (· ≫ AlgebraicGeometry.Spec.map
                                (CommRingCat.ofHom (ι_B r).toRingHom))
                              hθ_up_snd.symm).trans
                              (CategoryTheory.Category.assoc _ _ _))))))))
            exact
              ((CategoryTheory.Category.assoc (m_ι_bar ≫ θ_dn) _ h_U).trans
                ((congrArg ((m_ι_bar ≫ θ_dn) ≫ ·) CategoryTheory.Limits.pullback.condition).trans
                  ((CategoryTheory.Category.assoc _ _ π_dn).symm.trans
                    ((congrArg (· ≫ π_dn) hs_mid).trans
                      ((CategoryTheory.Category.assoc θ_up _ π_dn).trans
                        ((congrArg (θ_up ≫ ·)
                          ((CategoryTheory.Category.assoc _ _ π_dn).trans
                            ((congrArg _ hp_U).trans
                              (CategoryTheory.Limits.pullback.condition.symm.trans
                                (congrArg (· ≫ h_U) hm_U_fst.symm))))).trans
                          ((CategoryTheory.Category.assoc θ_up _ h_U).symm.trans
                            (congrArg (· ≫ h_U)
                              (CategoryTheory.Category.assoc θ_up m_ι_U _).symm))))))))
        · exact
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (m_ι_bar ≫ ·) hθ_dn_snd).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q_B r)))
                    hm_bar_snd).trans
                    ((CategoryTheory.Category.assoc _ _ _).trans
                      ((congrArg _ hq_spec).trans
                        ((CategoryTheory.Category.assoc _ _ _).symm.trans
                          ((congrArg (· ≫ AlgebraicGeometry.Spec.map
                              (CommRingCat.ofHom (ι_B r).toRingHom))
                            hθ_up_snd.symm).trans
                            ((CategoryTheory.Category.assoc _ _ _).trans
                              ((congrArg (θ_up ≫ ·) hm_U_snd.symm).trans
                                (CategoryTheory.Category.assoc _ _ _).symm))))))))))
      have hL := congrFun (hη_ℳ r W₀ (((τ_ℒ r).hom.app (Opposite.op (B_j.obj W₀))).hom s_up) θ_dn
        hθ_dn_fst hθ_dn_snd (m_ι_bar.base y_up)) i
      have hpt : θ_dn.base (m_ι_bar.base y_up) = m_ι_U.base (θ_up.base y_up) := by
        change ((m_ι_bar ≫ θ_dn).base) y_up = ((θ_up ≫ m_ι_U).base) y_up
        rw [hθ_step]
      have hstep₀ := ((htriv₀ r).2 (B_j.obj W₀)).2.2 s_up m_ι_U hm_U_fst hm_U_snd
        (θ_up.base y_up) i
      have hR₁ := ((htriv_ab r).2 (B_pr.obj W₀)).2.2
        (((η_ℳ (r + 1)).hom.app (Opposite.op W₀)).hom s_up)
        m_ι_bar hm_bar_fst hm_bar_snd y_up i
      have hR₂ := congrFun (hη_ℳ (r + 1) W₀ s_up θ_up hθ_up_fst hθ_up_snd y_up) i
      change triv_ab r (B_pr.obj W₀)
          (((η_ℳ r).hom.app (Opposite.op W₀)).hom
            (((τ_ℒ r).hom.app (Opposite.op (B_j.obj W₀))).hom s_up)) (m_ι_bar.base y_up) i =
        triv_ab r (B_pr.obj W₀)
          (((τ_ℳ_ab r).hom.app (Opposite.op (B_pr.obj W₀))).hom
            (((η_ℳ (r + 1)).hom.app (Opposite.op W₀)).hom s_up)) (m_ι_bar.base y_up) i
      exact hL.trans ((congrArg (fun p => triv₀ r (B_j.obj W₀) _ p i) hpt).trans
        (hstep₀.trans ((congrArg _ hR₂.symm).trans hR₁.symm)))
    have hψ_comm : L_pr.map (P_j.map (τ_ℒ r)) ≫ (ψ_iso r).hom =
        (ψ_iso (r + 1)).hom ≫ τ_ℳ_ab r := by
      change L_pr.map (P_j.map (τ_ℒ r)) ≫ (adj_pr.homEquiv _ (ℳ_ab r)).symm (η_ℳ r) =
        (adj_pr.homEquiv _ (ℳ_ab (r + 1))).symm (η_ℳ (r + 1)) ≫ τ_ℳ_ab r
      rw [← CategoryTheory.Adjunction.homEquiv_naturality_left_symm,
        ← CategoryTheory.Adjunction.homEquiv_naturality_right_symm, hη_comm]
    exact hCatChase L_pr P_j (τ_ℒ r) (weilEtaleHigherDirectImageMap U₀.ι 0 (τ_ℒ r))
      (Θ_j (ℒ₀ (r + 1))) (Θ_j (ℒ₀ r)) (hΘ_j_nat (τ_ℒ r))
      (W_mid.iso_bar (r + 1)) (W_mid.iso_bar r) (W_mid.τ_bar r) (W_mid.hτ_bar r)
      (ψ_iso (r + 1)) (ψ_iso r) (τ_ℳ_ab r) hψ_comm

  have htriv₀_eqv : ∀ (r : ℕ) (W : U₀.toScheme.Etale),
      let π_r := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
      let W_r := CategoryTheory.Limits.pullback h_W π_r
      ∀ (s : ↑((ℒ₀ r).obj.obj (Opposite.op W)))
        (σ : B r ≃ₐ[R₀] B r) (m_σ : Quiver.Hom W_r W_r),
        m_σ ≫ CategoryTheory.Limits.pullback.fst h_W π_r =
          CategoryTheory.Limits.pullback.fst h_W π_r →
        m_σ ≫ CategoryTheory.Limits.pullback.snd h_W π_r =
          CategoryTheory.Limits.pullback.snd h_W π_r ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) →
        ∀ y : ↥W_r, triv₀ r W s (m_σ.base y) = ((ρ r σ).val).mulVec (triv₀ r W s y) := by
    intro r W π_r h_W W_r s σ m_σ hm1 hm2 y
    have hmem : triv₀ r W s ∈ Set.range (triv₀ r W) := ⟨s, rfl⟩
    rw [((htriv₀ r).2 W).2.1] at hmem
    exact hmem σ m_σ hm1 hm2 y

  refine k_goal ⟨φ_ℳ, hConj1, fun r => ?_⟩
  exact weil_mid_ext_frob_gauge_and_ext_intertwining F S_aff U₀ U_bar
    (ℓ ^ (r + 1)) M ((F_u.val).map (PadicInt.toZModPow (r + 1)))
    (B r) (B_bar r) (ρ r) e_U (σ_u r) (hσu_mat r)
    (q_B r) (q_k r) (φ_equiv r) e_Ubar
    ⟨hGeom_rel.1, hGeom_rel.2.1, (hGeom_rel.2.2 r).2.1,
      (hGeom_rel.2.2 r).2.2.2.2.1, (hGeom_rel.2.2 r).2.2.2.2.2.1⟩
    hCont_j (ℒ₀ r) (Θ_j (ℒ₀ r)) (triv₀ r) (htriv₀_eqv r)
    W_mid.hCont_pr W_mid.hAdj_pr
    (W_mid.ℳ_bar r) (ℳ_ab r) (W_mid.iso_bar r)
    (W_mid.frobTorsion r) (W_mid.hfrobTorsion r)
    (triv_ab r) (htriv_ab r).1
    (η_ℳ r) (hη_ℳ r) (φ_ℳ r) (hφ_mate r) (hLocalPkg r).1

theorem weil_etale_module_ext_general_bijective (S : AlgebraicGeometry.Scheme.{u})
    [∀ m : ℕ, S.smallEtaleTopology.HasSheafCompose
      (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u})] :
    let J := S.smallEtaleTopology
    let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let U_mod (m : ℕ) := CategoryTheory.sheafCompose J
      (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u})
    let T_S : S.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S)
    ∃ (hT_S : CategoryTheory.Limits.IsTerminal T_S)
      (hAdd_U : ∀ m : ℕ, (U_mod m).Additive)
      (hLim_U : ∀ m : ℕ, CategoryTheory.Limits.PreservesFiniteLimits (U_mod m))
