      obtain ⟨g, hg, hγ_val⟩ := h_imG r γ
      obtain ⟨hG1, hG2⟩ := hG_int g hg
      let φM : Matrix (Fin M) (Fin M) (PadicInt ℓ) →*
          Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))) :=
        (RingHom.mapMatrix π_mod).toMonoidHom
