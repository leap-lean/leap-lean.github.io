      have hrew : ((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) * (((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) * y t) =
          ((ℓ ^ (3 * B) : ℕ) : ZMod (ℓ ^ K)) * y t := by
        rw [← mul_assoc, ← Nat.cast_mul, ← pow_add, show 2 * B + B = 3 * B by omega]
      rw [hrew] at hk
      linear_combination -hk

  
  have hPair₁₂_7B : ((ℓ ^ (7 * B) : ℕ) : ZMod (ℓ ^ K)) * (X₁₂.trace - Y₁₂.trace) = 0 :=
    hPowKillHigher B (7 * B) (by omega) _ hPair₁₂_kill
  have hPair₀₁_7B : ((ℓ ^ (7 * B) : ℕ) : ZMod (ℓ ^ K)) * (X₀₁.trace - Y₀₁.trace) = 0 :=
    hPowKillHigher (3 * B) (7 * B) (by omega) _ hPair₀₁_kill
  have hTotal_7B : ((ℓ ^ (7 * B) : ℕ) : ZMod (ℓ ^ K)) *
      (weilCurveTrAltTrace C - ((A 0).trace - (A 1).trace + (A 2).trace)) = 0 := by
    rw [← hTr_C₂_C, hTrSplit]
    linear_combination hPair₀₁_7B - hPair₁₂_7B - hCoh₀ + hCoh₁ - hCoh₂
  exact hCastEqOfPowKill (7 * B) (by omega) _ _ hTotal_7B

theorem weil_curve_tr_group_ring_trace_bridge (Γ : Type u) [Group Γ] [Fintype Γ]
    (ℓ N s K' K B₂ : ℕ) [Fact (Nat.Prime ℓ)]
    (hN : 1 ≤ N) (hsK' : s + 1 ≤ K') (hK'K : K' ≤ K)
    (τ_rep : Γ →* (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (s + 1))))ˣ)
    (F_K : WeilCurveTrFreeComplex (ℓ ^ K))
    (M : WeilCurveTrGroupComplex Γ (ℓ ^ K))
    (b_V : Γ → Fin 3 → ℕ)
    (M_lat_V : ∀ (σ : Γ) (i : Fin 3), Matrix (Fin (b_V σ i)) (Fin (b_V σ i)) (PadicInt ℓ))
    (hFinH : Finite ↥(LinearMap.ker M.δ₀) ∧
      Finite (↥(LinearMap.ker M.δ₁) ⧸
        (Submodule.comap (LinearMap.ker M.δ₁).subtype (LinearMap.range M.δ₀)).toAddSubgroup) ∧
      Finite (M.M₂ ⧸ (LinearMap.range M.δ₁).toAddSubgroup))
    (hFlat : WeilCurveTrIsEqFlat Γ (ℓ ^ K) M.M₀ ∧
      WeilCurveTrIsEqFlat Γ (ℓ ^ K) M.M₁ ∧
      WeilCurveTrIsEqFlat Γ (ℓ ^ K) M.M₂)
    (hBridge : WeilCurveTrHasRepInvBridge ℓ N s K (hsK'.trans hK'K) τ_rep F_K M)
    (hLatV : ∀ σ : Γ, WeilCurveTrHasGroupCohomLatticeModel ℓ K B₂ M σ (b_V σ) (M_lat_V σ)) :
    ∃ (P_σ : Γ → WeilCurveTrFreeComplex (ℓ ^ K)) (T_cohom : ZMod (ℓ ^ K')),
      (∀ σ : Γ, WeilCurveTrHasBoundedLatticeModel ℓ K B₂ (P_σ σ) (b_V σ) (M_lat_V σ)) ∧
      ZMod.castHom (pow_dvd_pow ℓ hsK') (ZMod (ℓ ^ (s + 1))) T_cohom =
        ZMod.castHom (pow_dvd_pow ℓ (hsK'.trans hK'K)) (ZMod (ℓ ^ (s + 1)))
          (weilCurveTrAltTrace F_K) ∧
      ∑ σ : Γ,
        ZMod.castHom (pow_dvd_pow ℓ hK'K) (ZMod (ℓ ^ K')) (weilCurveTrAltTrace (P_σ σ)) *
          ((Matrix.trace (τ_rep σ).val).val : ZMod (ℓ ^ K')) =
        (Fintype.card Γ : ZMod (ℓ ^ K')) * T_cohom :=
by
  have h_pillar1 :
      ∀ (m : ℕ) [NeZero m] (M : WeilCurveTrGroupComplex Γ m)
        (hFinH : Finite ↥(LinearMap.ker M.δ₀) ∧
          Finite (↥(LinearMap.ker M.δ₁) ⧸
            (Submodule.comap (LinearMap.ker M.δ₁).subtype (LinearMap.range M.δ₀)).toAddSubgroup) ∧
          Finite (M.M₂ ⧸ (LinearMap.range M.δ₁).toAddSubgroup))
        (hFlat : WeilCurveTrIsEqFlat Γ m M.M₀ ∧
          WeilCurveTrIsEqFlat Γ m M.M₁ ∧
          WeilCurveTrIsEqFlat Γ m M.M₂),
        let R := MonoidAlgebra (ZMod m) Γ
        ∃ (m₀ m₁ m₂ : ℕ)
          (e₀ Φ0_tilde : (Fin m₀ → R) →ₗ[R] (Fin m₀ → R))
          (d₀ : (Fin m₀ → R) →ₗ[R] (Fin m₁ → R))
          (d₁ : (Fin m₁ → R) →ₗ[R] (Fin m₂ → R))
          (Φ₁ : (Fin m₁ → R) →ₗ[R] (Fin m₁ → R))
          (Φ₂ : (Fin m₂ → R) →ₗ[R] (Fin m₂ → R))
          (γ₀ : (Fin m₀ → R) →ₗ[R] M.M₀)
          (γ₁ : (Fin m₁ → R) →ₗ[R] M.M₁)
          (γ₂ : (Fin m₂ → R) →ₗ[R] M.M₂)
          (h₁ : (Fin m₁ → R) →ₗ[R] M.M₀)
          (h₂ : (Fin m₂ → R) →ₗ[R] M.M₁),
          (e₀.comp e₀ = e₀ ∧ d₀.comp e₀ = d₀ ∧ γ₀.comp e₀ = γ₀ ∧
            e₀.comp Φ0_tilde = Φ0_tilde ∧ Φ0_tilde.comp e₀ = Φ0_tilde) ∧
          (d₁.comp d₀ = 0 ∧ d₀.comp Φ0_tilde = Φ₁.comp d₀ ∧ d₁.comp Φ₁ = Φ₂.comp d₁ ∧
            M.δ₀.comp γ₀ = γ₁.comp d₀ ∧ M.δ₁.comp γ₁ = γ₂.comp d₁) ∧
          (M.Φ₀.comp γ₀ - γ₀.comp Φ0_tilde = h₁.comp d₀ ∧
            M.Φ₁.comp γ₁ - γ₁.comp Φ₁ = M.δ₀.comp h₁ + h₂.comp d₁ ∧
            M.Φ₂.comp γ₂ - γ₂.comp Φ₂ = M.δ₁.comp h₂) ∧
          ((∀ y₂ : M.M₂, ∃ (y₁ : M.M₁) (q₂ : Fin m₂ → R), M.δ₁ y₁ + γ₂ q₂ = y₂) ∧
            (∀ (y₁ : M.M₁) (q₂ : Fin m₂ → R), M.δ₁ y₁ + γ₂ q₂ = 0 →
              ∃ (y₀ : M.M₀) (q₁ : Fin m₁ → R), M.δ₀ y₀ + γ₁ q₁ = y₁ ∧ - d₁ q₁ = q₂) ∧
            (∀ (y₀ : M.M₀) (q₁ : Fin m₁ → R), M.δ₀ y₀ + γ₁ q₁ = 0 → d₁ q₁ = 0 →
              ∃ q₀ : Fin m₀ → R, e₀ q₀ = q₀ ∧ γ₀ q₀ = y₀ ∧ - d₀ q₀ = q₁) ∧
            (∀ q₀ : Fin m₀ → R, e₀ q₀ = q₀ → γ₀ q₀ = 0 → d₀ q₀ = 0 → q₀ = 0)) := by
    clear hLatV; clear hBridge; clear hFlat; clear hFinH
    clear M_lat_V; clear b_V; clear M; clear F_K; clear τ_rep
    clear hK'K; clear hsK'; clear hN
    clear B₂; clear K'; clear K; clear s; clear N
    intro m _ M hFinH hFlat
    let R := MonoidAlgebra (ZMod m) Γ
    have hFinR : Finite R :=
      Finite.of_injective (fun r : R => (fun g : Γ => r.coeff g))
        (fun r₁ r₂ h => MonoidAlgebra.coeff_injective (Finsupp.ext (congrFun h)))
    have : Finite R := hFinR
    let linOfVec : ∀ {X : Type u} [AddCommGroup X] [Module R X] {k : ℕ},
        (Fin k → X) → ((Fin k → R) →ₗ[R] X) :=
      fun {X} _ _ {k} v =>
        { toFun := fun u => ∑ j : Fin k, u j • v j
          map_add' := fun u₁ u₂ => by
            simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
          map_smul' := fun r u => by
            simp only [Pi.smul_apply, smul_eq_mul, mul_smul, RingHom.id_apply, Finset.smul_sum] }
    have h_linOfVec_single : ∀ {X : Type u} [AddCommGroup X] [Module R X] {k : ℕ}
        (v : Fin k → X) (j : Fin k), linOfVec v (Pi.single j 1) = v j := by
      intro X _ _ k v j
      change ∑ i : Fin k, ((Pi.single j (1 : R) : Fin k → R) i) • v i = v j
      rw [Finset.sum_eq_single j]
      · simp [Pi.single_eq_same]
      · intro i _ hij
        simp [Pi.single_eq_of_ne hij]
      · intro hj
        exact False.elim (hj (Finset.mem_univ j))
    have h_pi_decomp : ∀ {k : ℕ} (u : Fin k → R),
        u = ∑ j : Fin k, u j • (Pi.single j (1 : R) : Fin k → R) := by
      intro k u
      funext i
      rw [Finset.sum_apply, Finset.sum_eq_single i]
      · simp [Pi.single_eq_same]
      · intro j _ hji
        simp [Pi.single_eq_of_ne (Ne.symm hji)]
      · intro hi
        exact False.elim (hi (Finset.mem_univ i))
    have h_pi_ext : ∀ {X : Type u} [AddCommGroup X] [Module R X] {k : ℕ}
        (f g : (Fin k → R) →ₗ[R] X),
        (∀ j : Fin k, f (Pi.single j 1) = g (Pi.single j 1)) → f = g := by
      intro X _ _ k f g hfg
      apply LinearMap.ext
      intro u
      conv_lhs => rw [h_pi_decomp u]
      conv_rhs => rw [h_pi_decomp u]
      simp only [map_sum, map_smul]
      exact Finset.sum_congr rfl fun j _ => by rw [hfg j]
    have h_syzygy : ∀ (a b : ℕ) (A : Fin b → Fin a → R),
        ∃ (c : ℕ) (B : Fin c → Fin b → R),
          (∀ (k : Fin c) (i : Fin a), ∑ j : Fin b, A j i * B k j = 0) ∧
          (∀ u : Fin b → R,
            (∀ i : Fin a, ∑ j : Fin b, A j i * u j = 0) ↔
            ∃ w : Fin c → R, ∀ j : Fin b, u j = ∑ k : Fin c, B k j * w k) := by
      intro a b A
      let S : Set (Fin b → R) := { u | ∀ i : Fin a, ∑ j : Fin b, A j i * u j = 0 }
      let c := Nat.card ↥S
      let eS : Fin c ≃ ↥S := (Finite.equivFin ↥S).symm
      let B : Fin c → Fin b → R := fun k j => (eS k).1 j
      have hAB : ∀ (k : Fin c) (i : Fin a), ∑ j : Fin b, A j i * B k j = 0 :=
        fun k i => (eS k).2 i
      refine ⟨c, B, hAB, fun u => ⟨?_, ?_⟩⟩
      · intro hu
        let k₀ : Fin c := eS.symm ⟨u, hu⟩
        refine ⟨Pi.single k₀ 1, fun j => ?_⟩
        rw [Finset.sum_eq_single k₀]
        · simp [B, k₀, Pi.single_eq_same]
        · intro k _ hk
          simp [Pi.single_eq_of_ne hk]
        · intro hk₀
          exact False.elim (hk₀ (Finset.mem_univ k₀))
      · rintro ⟨w, hw⟩ i
        have hcalc : ∑ j : Fin b, A j i * u j =
            ∑ k : Fin c, (∑ j : Fin b, A j i * B k j) * w k := by
          calc
            ∑ j : Fin b, A j i * u j
                = ∑ j : Fin b, ∑ k : Fin c, A j i * (B k j * w k) := by
                  refine Finset.sum_congr rfl fun j _ => ?_
                  rw [hw j, Finset.mul_sum]
            _ = ∑ k : Fin c, ∑ j : Fin b, (A j i * B k j) * w k := by
                  rw [Finset.sum_comm]
                  refine Finset.sum_congr rfl fun k _ =>
                    Finset.sum_congr rfl fun j _ => (mul_assoc _ _ _).symm
            _ = ∑ k : Fin c, (∑ j : Fin b, A j i * B k j) * w k := by
                  refine Finset.sum_congr rfl fun k _ => (Finset.sum_mul _ _ _).symm
        rw [hcalc]
        exact Finset.sum_eq_zero fun k _ => by rw [hAB k i, zero_mul]
    have hFlat_pi : ∀ k : ℕ, WeilCurveTrIsEqFlat Γ m (Fin k → R) := by
      intro k a b c B A hex x
      constructor
      · intro hx
        have hl : ∀ l : Fin k, ∃ w : Fin c → R, ∀ j : Fin b, x j l = ∑ r : Fin c, B r j * w r := by
          intro l
          apply (hex (fun j => x j l)).mp
          intro i
          have hi := congrFun (hx i) l
          simpa [Finset.sum_apply] using hi
        choose w hw using hl
        refine ⟨fun r l => w l r, fun j => ?_⟩
        funext l
        simpa [Finset.sum_apply] using hw l j
      · rintro ⟨z, hz⟩ i
        funext l
        have hl : ∀ j : Fin b, x j l = ∑ r : Fin c, B r j * z r l := fun j => by
          have := congrFun (hz j) l
          simpa [Finset.sum_apply] using this
        have hi := (hex (fun j => x j l)).mpr ⟨fun r => z r l, hl⟩ i
        simpa [Finset.sum_apply] using hi
    have hFlat_prod : ∀ {X Y : Type u} [AddCommGroup X] [Module R X] [AddCommGroup Y] [Module R Y],
        WeilCurveTrIsEqFlat Γ m X → WeilCurveTrIsEqFlat Γ m Y → WeilCurveTrIsEqFlat Γ m (X × Y) := by
      intro X Y _ _ _ _ hX hY a b c B A hex x
      constructor
      · intro hx
        have hx1 : ∀ i : Fin a, ∑ j : Fin b, A j i • (x j).1 = 0 := fun i => by
          have := congrArg Prod.fst (hx i)
          simpa [Prod.fst_sum] using this
        have hx2 : ∀ i : Fin a, ∑ j : Fin b, A j i • (x j).2 = 0 := fun i => by
          have := congrArg Prod.snd (hx i)
          simpa [Prod.snd_sum] using this
        obtain ⟨z₁, hz₁⟩ := (hX a b c B A hex (fun j => (x j).1)).mp hx1
        obtain ⟨z₂, hz₂⟩ := (hY a b c B A hex (fun j => (x j).2)).mp hx2
        refine ⟨fun k => (z₁ k, z₂ k), fun j => Prod.ext ?_ ?_⟩
        · simpa [Prod.fst_sum] using hz₁ j
        · simpa [Prod.snd_sum] using hz₂ j
      · rintro ⟨z, hz⟩ i
        have hx1 : ∀ j : Fin b, (x j).1 = ∑ k : Fin c, B k j • (z k).1 := fun j => by
          have := congrArg Prod.fst (hz j)
          simpa [Prod.fst_sum] using this
        have hx2 : ∀ j : Fin b, (x j).2 = ∑ k : Fin c, B k j • (z k).2 := fun j => by
          have := congrArg Prod.snd (hz j)
          simpa [Prod.snd_sum] using this
        refine Prod.ext ?_ ?_
        · simpa [Prod.fst_sum] using (hX a b c B A hex (fun j => (x j).1)).mpr ⟨fun k => (z k).1, hx1⟩ i
        · simpa [Prod.snd_sum] using (hY a b c B A hex (fun j => (x j).2)).mpr ⟨fun k => (z k).2, hx2⟩ i
    have hFlat_ker : ∀ {K E C : Type u} [AddCommGroup K] [Module R K]
        [AddCommGroup E] [Module R E] [AddCommGroup C] [Module R C]
        (ι : K →ₗ[R] E) (π : E →ₗ[R] C),
        Function.Injective ι → Function.Surjective π →
        (∀ e : E, π e = 0 ↔ ∃ k : K, ι k = e) →
        WeilCurveTrIsEqFlat Γ m E → WeilCurveTrIsEqFlat Γ m C →
        WeilCurveTrIsEqFlat Γ m K := by
      intro K E C _ _ _ _ _ _ ι π hι_inj hπ_surj hex_seq hE hC a b c B A hex x
      constructor
      · intro hx
        have hx_E : ∀ i : Fin a, ∑ j : Fin b, A j i • ι (x j) = 0 := fun i => by
          rw [← map_zero ι, ← hx i, map_sum]
          exact Finset.sum_congr rfl fun j _ => (map_smul ι _ _).symm
        obtain ⟨e, he⟩ := (hE a b c B A hex (fun j => ι (x j))).mp hx_E
        have he_C : ∀ j : Fin b, ∑ k : Fin c, B k j • π (e k) = 0 := fun j => by
          have h1 : π (ι (x j)) = 0 := (hex_seq (ι (x j))).mpr ⟨x j, rfl⟩
          rw [he j, map_sum] at h1
          simpa only [map_smul] using h1
        obtain ⟨d, D, hBD, hex_B⟩ := h_syzygy b c B
        obtain ⟨c_vec, hc_vec⟩ := (hC b c d D B hex_B (fun k => π (e k))).mp he_C
        choose t ht using fun r : Fin d => hπ_surj (c_vec r)
        have he'_ker : ∀ k : Fin c, ∃ z : K, ι z = e k - ∑ r : Fin d, D r k • t r := by
          intro k
          apply (hex_seq _).mp
          rw [map_sub, map_sum, hc_vec k]
          have hsum : ∑ r : Fin d, π (D r k • t r) = ∑ r : Fin d, D r k • c_vec r :=
            Finset.sum_congr rfl fun r _ => by rw [map_smul, ht r]
          rw [hsum, sub_self]
        choose z hz using he'_ker
        refine ⟨z, fun j => hι_inj ?_⟩
        rw [map_sum, he j]
        have hcalc : ∑ k : Fin c, ι (B k j • z k) =
            (∑ k : Fin c, B k j • e k) - ∑ r : Fin d, (∑ k : Fin c, B k j * D r k) • t r := by
          calc
            ∑ k : Fin c, ι (B k j • z k)
                = ∑ k : Fin c, B k j • (e k - ∑ r : Fin d, D r k • t r) :=
                  Finset.sum_congr rfl fun k _ => by rw [map_smul, hz k]
            _ = (∑ k : Fin c, B k j • e k) - ∑ k : Fin c, ∑ r : Fin d, (B k j * D r k) • t r := by
                  simp only [smul_sub, Finset.sum_sub_distrib, Finset.smul_sum, mul_smul]
            _ = (∑ k : Fin c, B k j • e k) - ∑ r : Fin d, (∑ k : Fin c, B k j * D r k) • t r := by
                  congr 1
                  rw [Finset.sum_comm]
                  exact Finset.sum_congr rfl fun r _ => Finset.sum_smul.symm
        rw [hcalc]
        have hzero : ∑ r : Fin d, (∑ k : Fin c, B k j * D r k) • t r = 0 :=
          Finset.sum_eq_zero fun r _ => by rw [hBD r j, zero_smul]
        rw [hzero, sub_zero]
      · rintro ⟨z, hz⟩ i
        have hAB : ∀ k : Fin c, ∑ j : Fin b, A j i * B k j = 0 := by
          intro k
          refine (hex (fun j => B k j)).mpr ⟨Pi.single k 1, fun j => ?_⟩ i
          rw [Finset.sum_eq_single k]
          · simp [Pi.single_eq_same]
          · intro k' _ hk'
            simp [Pi.single_eq_of_ne hk']
          · intro hk
            exact False.elim (hk (Finset.mem_univ k))
        calc
          ∑ j : Fin b, A j i • x j
              = ∑ j : Fin b, ∑ k : Fin c, (A j i * B k j) • z k := by
                refine Finset.sum_congr rfl fun j _ => ?_
                rw [hz j, Finset.smul_sum]
                exact Finset.sum_congr rfl fun k _ => (mul_smul _ _ _).symm
          _ = ∑ k : Fin c, (∑ j : Fin b, A j i * B k j) • z k := by
                rw [Finset.sum_comm]
                exact Finset.sum_congr rfl fun k _ => Finset.sum_smul.symm
          _ = 0 := Finset.sum_eq_zero fun k _ => by rw [hAB k, zero_smul]
    let Q_H2 := M.M₂ ⧸ (LinearMap.range M.δ₁).toAddSubgroup
    have : Finite Q_H2 := hFinH.2.2
    let m₂ := Nat.card Q_H2
