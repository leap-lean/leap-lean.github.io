      (T_S : S.Etale) (hT_S : CategoryTheory.Limits.IsTerminal T_S)
      (μ_pow : ∀ k : ℕ, Quiver.Hom ((G_pow k).obj T_S) T_S),
      (Fgt.obj T_S).left = S ∧
      HEq (Fgt.obj T_S).hom (CategoryTheory.CategoryStruct.id S) ∧
      (∀ k : ℕ,
        (g_pow_iso k).hom = weilSchemeEndPow g₁.hom k ∧
        HEq (Fgt.map (μ_pow k)).left (weilSchemeEndPow g₁.hom k) ∧
        (∀ U : S.Etale, (Fgt.obj ((G_pow k).obj U)).left = (Fgt.obj U).left ∧
          HEq (Fgt.obj ((G_pow k).obj U)).hom
            (CategoryTheory.CategoryStruct.comp (Fgt.obj U).hom (weilSchemeEndPow g₁.hom k))) ∧
        (∀ {U₁ U₂ : S.Etale} (u : Quiver.Hom U₁ U₂),
