  let pr_k : Quiver.Hom S (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Limits.pullback.snd D₀.hom f_ext
  let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
