          obtain ⟨q₀_el, he, hγ, hd⟩ := hCone.2.2.1 y 0 (by rw [hy, map_zero, add_zero]) (map_zero d₁)
          exact ⟨⟨q₀_el, (hP₀_mem q₀_el).mpr he⟩, neg_eq_zero.mp hd, hγ⟩
        have h_ker0_uniq : ∀ p₁ p₂ : ↥P₀_sub,
