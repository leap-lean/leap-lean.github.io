  have _ : ∀ r, IsScalarTower F (RatFunc F) (L_fld r) := hST_FKL
  have _ : ∀ r, IsScalarTower (Polynomial F) (RatFunc F) (L_fld r) := hST_PKL
  have _ : ∀ r, IsScalarTower (Polynomial F) (B r) (L_fld r) := hST_PBL
  have _ : ∀ r, IsScalarTower R₀ (B r) (L_fld r) := hST_RBL
  have _ : ∀ r, Module.Finite R₀ (B r) := hFin_B
  have _ : ∀ r, Algebra.Etale R₀ (B r) := hEt_B
