    have hInj_ι : Function.Injective (ι_Bbar r) := by
      rw [injective_iff_map_eq_zero]
      intro x hx0
      by_contra hx_ne
      obtain ⟨P, hP_mon, hP_eval⟩ := (Algebra.IsIntegral.isIntegral x : IsIntegral R0_bar x)
      have hP_ne : P ≠ 0 := hP_mon.ne_zero
      have hNoAnn : ∀ (d : ℕ) (Q : Polynomial R0_bar),
