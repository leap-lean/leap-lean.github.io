        left_inv := fun u => by
          funext j
          apply MonoidAlgebra.coeff_injective
          ext g₀
          change (∑ g : Γ, (MonoidAlgebra.single g ((u j).coeff g) : R)).coeff g₀ = (u j).coeff g₀
