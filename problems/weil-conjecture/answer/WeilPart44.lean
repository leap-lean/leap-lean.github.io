    have hσ_range : ∀ (W : S.Etale) (g : Γ),
        Set.range ((Fgt.map (σ_g W g)).left).base =
          (q_VV W).base ⁻¹' Set.range (γ_map g).base := by
      intro W g
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        have hq : CategoryTheory.CategoryStruct.comp (Fgt.map (σ_g W g)).left (q_VV W) =
            CategoryTheory.CategoryStruct.comp (snd₁ W) (γ_map g) := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact (CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (_ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ snd₁ W) (hσ_fst W g)).trans
                    ((CategoryTheory.Category.id_comp _).trans
