      let k_hom : Quiver.Hom RM (ℰ.obj.obj (Opposite.op W)) :=
        ModuleCat.ofHom (LinearMap.toSpanSingleton R _ e)
      have hk_p : CategoryTheory.CategoryStruct.comp k_hom (p.hom.app (Opposite.op W)) = 0 := by
        apply ModuleCat.hom_ext
        apply LinearMap.ext_ring
        change (p.hom.app (Opposite.op W)).hom (k_hom.hom (1 : R)) = 0
        have he1 : k_hom.hom (1 : R) = e := one_smul R e
        rw [he1]
        exact he
      obtain ⟨l_hom, hl_hom⟩ :=
        CategoryTheory.Limits.KernelFork.IsLimit.lift' hLim_ker k_hom hk_p
      have hl0 : l_hom.hom (1 : R) = 0 :=
        @Subsingleton.elim _ (hVan_Q W hW) (l_hom.hom (1 : R)) 0
      have he1 : k_hom.hom (1 : R) = e := one_smul R e
      rw [← he1, ← hl_hom]
      change (α.hom.app (Opposite.op W)).hom (l_hom.hom (1 : R)) = 0
      rw [hl0, map_zero]
    have : CategoryTheory.Epi p := hSE.epi_g
    have : CategoryTheory.Presheaf.IsLocallySurjective J p.hom :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' ModR p).mpr inferInstance
    let U_et : S.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι inferInstance
    have hU_et_sub : Set.range ((Fgt.obj U_et).hom).base ⊆ (U : Set ↥S) := by
      change Set.range U.ι.base ⊆ (U : Set ↥S)
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    have hSub_over_U : ∀ {Y : S.Etale} (f : Quiver.Hom Y U_et),
        Set.range ((Fgt.obj Y).hom).base ⊆ (U : Set ↥S) := by
      rintro Y f _ ⟨y, rfl⟩
      apply hU_et_sub
      refine ⟨((Fgt.map f).left).base y, ?_⟩
      have hw : CategoryTheory.CategoryStruct.comp (Fgt.map f).left (Fgt.obj U_et).hom =
          (Fgt.obj Y).hom := CategoryTheory.MorphismProperty.Over.w f
      exact congrArg (fun φ => φ.base y) hw
    let R_U := CategoryTheory.Presheaf.imageSieve p.hom (one_W U_et)
    have hR_U : R_U ∈ J U_et :=
      CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem (one_W U_et)
    have hex_U : ∀ {Y : S.Etale} (f : Quiver.Hom Y U_et), R_U.arrows f →
        ∃ s : ↑(ℰ.obj.obj (Opposite.op Y)),
          (p.hom.app (Opposite.op Y)).hom s = one_W Y := by
      intro Y f hf
      rw [CategoryTheory.Presheaf.imageSieve_apply, hone_map f] at hf
      exact hf
    let fam_U : CategoryTheory.Presieve.FamilyOfElements
        (ℰ.obj ⋙ CategoryTheory.forget ModR) R_U.arrows :=
      fun Y f hf => Classical.choose (hex_U f hf)
    have hfam_U_spec : ∀ {Y : S.Etale} (f : Quiver.Hom Y U_et) (hf : R_U.arrows f),
        (p.hom.app (Opposite.op Y)).hom (fam_U f hf) = one_W Y :=
      fun f hf => Classical.choose_spec (hex_U f hf)
    have hfam_U_compat : fam_U.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ _
      have hZ_sub : Set.range ((Fgt.obj Z).hom).base ⊆ (U : Set ↥S) :=
        hSub_over_U (CategoryTheory.CategoryStruct.comp g₁ f₁)
      apply hInj_p_U Z hZ_sub
      have hnat₁ := congrArg (fun θ => ModuleCat.Hom.hom θ (fam_U f₁ hf₁))
        (p.hom.naturality g₁.op)
      have hnat₂ := congrArg (fun θ => ModuleCat.Hom.hom θ (fam_U f₂ hf₂))
        (p.hom.naturality g₂.op)
      change (p.hom.app (Opposite.op Z)).hom ((ℰ.obj.map g₁.op).hom (fam_U f₁ hf₁)) =
        (p.hom.app (Opposite.op Z)).hom ((ℰ.obj.map g₂.op).hom (fam_U f₂ hf₂))
      have h1 : (p.hom.app (Opposite.op Z)).hom ((ℰ.obj.map g₁.op).hom (fam_U f₁ hf₁)) =
          (oneR.obj.map g₁.op).hom ((p.hom.app (Opposite.op Y₁)).hom (fam_U f₁ hf₁)) := hnat₁
      have h2 : (p.hom.app (Opposite.op Z)).hom ((ℰ.obj.map g₂.op).hom (fam_U f₂ hf₂)) =
          (oneR.obj.map g₂.op).hom ((p.hom.app (Opposite.op Y₂)).hom (fam_U f₂ hf₂)) := hnat₂
      rw [h1, h2, hfam_U_spec f₁ hf₁, hfam_U_spec f₂ hf₂, hone_map g₁, hone_map g₂]
    let e_U : ↑(ℰ.obj.obj (Opposite.op U_et)) :=
      ((hTypeSheaf ℰ).isSheafFor R_U.arrows (hSieveGen R_U hR_U)).amalgamate fam_U hfam_U_compat
    have he_U_p : (p.hom.app (Opposite.op U_et)).hom e_U = one_W U_et := by
      apply ((hTypeSheaf oneR).isSheafFor R_U.arrows (hSieveGen R_U hR_U)).isSeparatedFor.ext
      intro Y f hf
      have hnat := congrArg (fun θ => ModuleCat.Hom.hom θ e_U) (p.hom.naturality f.op)
      have h1 : (oneR.obj.map f.op).hom ((p.hom.app (Opposite.op U_et)).hom e_U) =
          (p.hom.app (Opposite.op Y)).hom ((ℰ.obj.map f.op).hom e_U) := hnat.symm
      have hglue : (ℰ.obj.map f.op).hom e_U = fam_U f hf :=
        ((hTypeSheaf ℰ).isSheafFor R_U.arrows (hSieveGen R_U hR_U)).valid_glue hfam_U_compat f hf
      change (oneR.obj.map f.op).hom ((p.hom.app (Opposite.op U_et)).hom e_U) =
        (oneR.obj.map f.op).hom (one_W U_et)
      rw [h1, hglue, hfam_U_spec f hf, hone_map f]
    let R_top := CategoryTheory.Presheaf.imageSieve p.hom one_top
    have hR_top : R_top ∈ J T_S :=
      CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem one_top
    have hex_bdry : ∀ b : ↥((U : Set ↥S)ᶜ),
        ∃ (W' : S.Etale) (y' : ↥((Fgt.obj W').left))
          (s' : ↑(ℰ.obj.obj (Opposite.op W'))),
          ((Fgt.obj W').hom).base y' = b.1 ∧
          (p.hom.app (Opposite.op W')).hom s' = one_W W' ∧
          (∀ z : ↥((Fgt.obj W').left), ((Fgt.obj W').hom).base z ∉ (U : Set ↥S) → z = y') ∧
          (∀ (Z : S.Etale) (g₁ g₂ : Quiver.Hom Z W') (z : ↥((Fgt.obj Z).left)),
            ((Fgt.map g₁).left).base z = y' → ((Fgt.map g₂).left).base z = y' →
            ∃ (E : S.Etale) (e : Quiver.Hom E Z) (z_E : ↥((Fgt.obj E).left)),
              ((Fgt.map e).left).base z_E = z ∧
              CategoryTheory.CategoryStruct.comp e g₁ = CategoryTheory.CategoryStruct.comp e g₂) := by
      intro b
      obtain ⟨W_x, f_x, y_x, hf_x, _, hy_x⟩ := (hJ_mem T_S R_top).mp hR_top b.1
      have hf_im : ∃ e_x : ↑(ℰ.obj.obj (Opposite.op W_x)),
          (p.hom.app (Opposite.op W_x)).hom e_x = one_W W_x := by
        rw [CategoryTheory.Presheaf.imageSieve_apply, ht_uniq f_x] at hf_x
        exact hf_x
      obtain ⟨e_x, he_x⟩ := hf_im
      have hy_x' : ((Fgt.obj W_x).hom).base y_x = b.1 := by
        have hw : ((Fgt.map f_x).left : Quiver.Hom (Fgt.obj W_x).left S) = (Fgt.obj W_x).hom :=
          (CategoryTheory.Category.comp_id
            ((Fgt.map f_x).left : Quiver.Hom (Fgt.obj W_x).left S)).symm.trans
            (CategoryTheory.MorphismProperty.Over.w f_x)
        exact (congrArg (fun φ => φ.base y_x) hw.symm).trans hy_x
      obtain ⟨W', u_x, y', hy'_y, hIso_b, hDiag_b⟩ := hShrinkDiag b.1 b.2 W_x y_x hy_x'
      have hy'_b : ((Fgt.obj W').hom).base y' = b.1 := by
        have hw : CategoryTheory.CategoryStruct.comp (Fgt.map u_x).left (Fgt.obj W_x).hom =
            (Fgt.obj W').hom := CategoryTheory.MorphismProperty.Over.w u_x
        calc
          ((Fgt.obj W').hom).base y' = ((Fgt.obj W_x).hom).base (((Fgt.map u_x).left).base y') := by
            rw [← hw]; rfl
          _ = ((Fgt.obj W_x).hom).base y_x := by rw [hy'_y]
          _ = b.1 := hy_x'
      let s' : ↑(ℰ.obj.obj (Opposite.op W')) := (ℰ.obj.map u_x.op).hom e_x
      have hs'_p : (p.hom.app (Opposite.op W')).hom s' = one_W W' := by
        have hnat := congrArg (fun θ => ModuleCat.Hom.hom θ e_x) (p.hom.naturality u_x.op)
        change (p.hom.app (Opposite.op W')).hom ((ℰ.obj.map u_x.op).hom e_x) = one_W W'
        have h1 : (p.hom.app (Opposite.op W')).hom ((ℰ.obj.map u_x.op).hom e_x) =
            (oneR.obj.map u_x.op).hom ((p.hom.app (Opposite.op W_x)).hom e_x) := hnat
        rw [h1, he_x, hone_map u_x]
      exact ⟨W', y', s', hy'_b, hs'_p, hIso_b, hDiag_b⟩
    let Idx_cov : Type u := ULift.{u} Unit ⊕ ↥((U : Set ↥S)ᶜ)
    let V_cov : Idx_cov → S.Etale
      | Sum.inl _ => U_et
      | Sum.inr b => Classical.choose (hex_bdry b)
    let s_cov : ∀ i : Idx_cov, ↑(ℰ.obj.obj (Opposite.op (V_cov i)))
      | Sum.inl _ => e_U
      | Sum.inr b =>
        Classical.choose (Classical.choose_spec (Classical.choose_spec (hex_bdry b)))
    have hs_cov_p : ∀ i : Idx_cov,
        (p.hom.app (Opposite.op (V_cov i))).hom (s_cov i) = one_W (V_cov i) := by
      rintro (_ | b)
      · exact he_U_p
      · exact (Classical.choose_spec (Classical.choose_spec
          (Classical.choose_spec (hex_bdry b)))).2.1
    have hOverlap : ∀ (Z : S.Etale) (i₁ i₂ : Idx_cov)
        (g₁ : Quiver.Hom Z (V_cov i₁)) (g₂ : Quiver.Hom Z (V_cov i₂)),
        (ℰ.obj.map g₁.op).hom (s_cov i₁) = (ℰ.obj.map g₂.op).hom (s_cov i₂) := by
      intro Z i₁ i₂ g₁ g₂
      have hp_eq : (p.hom.app (Opposite.op Z)).hom ((ℰ.obj.map g₁.op).hom (s_cov i₁)) =
          (p.hom.app (Opposite.op Z)).hom ((ℰ.obj.map g₂.op).hom (s_cov i₂)) := by
        have hnat₁ := congrArg (fun θ => ModuleCat.Hom.hom θ (s_cov i₁))
          (p.hom.naturality g₁.op)
        have hnat₂ := congrArg (fun θ => ModuleCat.Hom.hom θ (s_cov i₂))
          (p.hom.naturality g₂.op)
        have h1 : (p.hom.app (Opposite.op Z)).hom ((ℰ.obj.map g₁.op).hom (s_cov i₁)) =
            (oneR.obj.map g₁.op).hom ((p.hom.app (Opposite.op (V_cov i₁))).hom (s_cov i₁)) := hnat₁
        have h2 : (p.hom.app (Opposite.op Z)).hom ((ℰ.obj.map g₂.op).hom (s_cov i₂)) =
            (oneR.obj.map g₂.op).hom ((p.hom.app (Opposite.op (V_cov i₂))).hom (s_cov i₂)) := hnat₂
        rw [h1, h2, hs_cov_p i₁, hs_cov_p i₂, hone_map g₁, hone_map g₂]
      apply hSep ℰ Z
      intro z
      let x₀ : ↥S := ((Fgt.obj Z).hom).base z
      by_cases hx₀ : x₀ ∈ (U : Set ↥S)
      · let Z_U_open : ((Fgt.obj Z).left).Opens :=
          (TopologicalSpace.Opens.map ((Fgt.obj Z).hom).base).obj U
        let Z_U : S.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤
            (CategoryTheory.CategoryStruct.comp Z_U_open.ι (Fgt.obj Z).hom)
            (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
              Z_U_open.ι (Fgt.obj Z).hom inferInstance Z.prop)
        let j_U : Quiver.Hom Z_U Z :=
          CategoryTheory.MorphismProperty.Over.homMk Z_U_open.ι rfl
        have hZU_sub : Set.range ((Fgt.obj Z_U).hom).base ⊆ (U : Set ↥S) := by
          rintro _ ⟨w, rfl⟩
          exact w.2
        refine ⟨Z_U, j_U, ⟨z, hx₀⟩, rfl, ?_⟩
        apply hInj_p_U Z_U hZU_sub
        have hnat₁ := congrArg (fun θ =>
          ModuleCat.Hom.hom θ ((ℰ.obj.map g₁.op).hom (s_cov i₁))) (p.hom.naturality j_U.op)
        have hnat₂ := congrArg (fun θ =>
          ModuleCat.Hom.hom θ ((ℰ.obj.map g₂.op).hom (s_cov i₂))) (p.hom.naturality j_U.op)
        exact hnat₁.trans ((congrArg (oneR.obj.map j_U.op).hom hp_eq).trans hnat₂.symm)
      · have hnot_inl₁ : ∀ u₁ : ULift.{u} Unit, i₁ ≠ Sum.inl u₁ := by
          rintro u₁ rfl
          exact hx₀ (hSub_over_U g₁ ⟨z, rfl⟩)
        have hnot_inl₂ : ∀ u₂ : ULift.{u} Unit, i₂ ≠ Sum.inl u₂ := by
          rintro u₂ rfl
          exact hx₀ (hSub_over_U g₂ ⟨z, rfl⟩)
        rcases i₁ with u₁ | b₁
        · exact False.elim (hnot_inl₁ u₁ rfl)
        rcases i₂ with u₂ | b₂
        · exact False.elim (hnot_inl₂ u₂ rfl)
        let y'₁ := Classical.choose (Classical.choose_spec (hex_bdry b₁))
        let hspec₁ := Classical.choose_spec (Classical.choose_spec
          (Classical.choose_spec (hex_bdry b₁)))
        let y'₂ := Classical.choose (Classical.choose_spec (hex_bdry b₂))
        let hspec₂ := Classical.choose_spec (Classical.choose_spec
          (Classical.choose_spec (hex_bdry b₂)))
        have hw₁ : ((Fgt.obj (V_cov (Sum.inr b₁))).hom).base (((Fgt.map g₁).left).base z) = x₀ := by
          have hw := CategoryTheory.MorphismProperty.Over.w g₁
          exact congrArg (fun φ => φ.base z) hw
        have hw₂ : ((Fgt.obj (V_cov (Sum.inr b₂))).hom).base (((Fgt.map g₂).left).base z) = x₀ := by
          have hw := CategoryTheory.MorphismProperty.Over.w g₂
          exact congrArg (fun φ => φ.base z) hw
        have hz₁_eq : ((Fgt.map g₁).left).base z = y'₁ :=
          hspec₁.2.2.1 _ (by rw [hw₁]; exact hx₀)
        have hz₂_eq : ((Fgt.map g₂).left).base z = y'₂ :=
          hspec₂.2.2.1 _ (by rw [hw₂]; exact hx₀)
        have hb₁_eq : b₁.1 = x₀ :=
          hspec₁.1.symm.trans
            ((congrArg ((Fgt.obj (V_cov (Sum.inr b₁))).hom).base hz₁_eq.symm).trans hw₁)
        have hb₂_eq : b₂.1 = x₀ :=
          hspec₂.1.symm.trans
            ((congrArg ((Fgt.obj (V_cov (Sum.inr b₂))).hom).base hz₂_eq.symm).trans hw₂)
        have hb_eq : b₁ = b₂ := Subtype.ext (hb₁_eq.trans hb₂_eq.symm)
        subst hb_eq
        obtain ⟨E, e, z_E, hz_E, heg⟩ := hspec₁.2.2.2 Z g₁ g₂ z hz₁_eq hz₂_eq
        refine ⟨E, e, z_E, hz_E, ?_⟩
        change (ℰ.obj.map e.op).hom ((ℰ.obj.map g₁.op).hom (s_cov (Sum.inr b₁))) =
          (ℰ.obj.map e.op).hom ((ℰ.obj.map g₂.op).hom (s_cov (Sum.inr b₁)))
        rw [← hMapComp ℰ e g₁ (s_cov (Sum.inr b₁)),
          ← hMapComp ℰ e g₂ (s_cov (Sum.inr b₁)), heg]
    let R_all : CategoryTheory.Sieve T_S :=
      { arrows := fun {W} _ => ∃ (i : Idx_cov) (g : Quiver.Hom W (V_cov i)), True
        downward_closed := fun {W₁ W₂} {_} ⟨i, g, _⟩ u =>
          ⟨i, CategoryTheory.CategoryStruct.comp u g, trivial⟩ }
    have hR_all : R_all ∈ J T_S := by
      rw [hJ_mem]
      intro x
      by_cases hx : x ∈ (U : Set ↥S)
      · exact ⟨U_et, t_W U_et, ⟨x, hx⟩,
          ⟨Sum.inl (ULift.up ()), CategoryTheory.CategoryStruct.id U_et, trivial⟩,
          hEtale_left (t_W U_et), rfl⟩
      · let b : ↥((U : Set ↥S)ᶜ) := ⟨x, hx⟩
        let y'_b := Classical.choose (Classical.choose_spec (hex_bdry b))
        let hy'_b := (Classical.choose_spec (Classical.choose_spec
          (Classical.choose_spec (hex_bdry b)))).1
        exact ⟨V_cov (Sum.inr b), t_W (V_cov (Sum.inr b)), y'_b,
          ⟨Sum.inr b, CategoryTheory.CategoryStruct.id (V_cov (Sum.inr b)), trivial⟩,
          hEtale_left (t_W (V_cov (Sum.inr b))), hy'_b⟩
    let fam_all : CategoryTheory.Presieve.FamilyOfElements
        (ℰ.obj ⋙ CategoryTheory.forget ModR) R_all.arrows :=
      fun W _ hf =>
        let i := Classical.choose hf
        let g := Classical.choose (Classical.choose_spec hf)
        (ℰ.obj.map g.op).hom (s_cov i)
    have hfam_all_compat : fam_all.Compatible := by
      intro Y₁ Y₂ Z u₁ u₂ f₁ f₂ hf₁ hf₂ _
      let i₁ := Classical.choose hf₁
      let g₁ := Classical.choose (Classical.choose_spec hf₁)
      let i₂ := Classical.choose hf₂
      let g₂ := Classical.choose (Classical.choose_spec hf₂)
      change (ℰ.obj.map u₁.op).hom ((ℰ.obj.map g₁.op).hom (s_cov i₁)) =
        (ℰ.obj.map u₂.op).hom ((ℰ.obj.map g₂.op).hom (s_cov i₂))
      rw [← hMapComp ℰ u₁ g₁ (s_cov i₁), ← hMapComp ℰ u₂ g₂ (s_cov i₂)]
      exact hOverlap Z i₁ i₂ _ _
    let e_top : ↑(ℰ.obj.obj (Opposite.op T_S)) :=
      ((hTypeSheaf ℰ).isSheafFor R_all.arrows (hSieveGen R_all hR_all)).amalgamate
        fam_all hfam_all_compat
    have he_top_p : (p.hom.app (Opposite.op T_S)).hom e_top = one_top := by
      rw [← hone_top_eq]
      apply ((hTypeSheaf oneR).isSheafFor R_all.arrows (hSieveGen R_all hR_all)).isSeparatedFor.ext
      intro W f hf
      have hnat := congrArg (fun θ => ModuleCat.Hom.hom θ e_top) (p.hom.naturality f.op)
      have h1 : (oneR.obj.map f.op).hom ((p.hom.app (Opposite.op T_S)).hom e_top) =
          (p.hom.app (Opposite.op W)).hom ((ℰ.obj.map f.op).hom e_top) := hnat.symm
      have hglue : (ℰ.obj.map f.op).hom e_top = fam_all f hf :=
        ((hTypeSheaf ℰ).isSheafFor R_all.arrows (hSieveGen R_all hR_all)).valid_glue
          hfam_all_compat f hf
      let i := Classical.choose hf
      let g := Classical.choose (Classical.choose_spec hf)
      have hnat_g := congrArg (fun θ => ModuleCat.Hom.hom θ (s_cov i)) (p.hom.naturality g.op)
      have h2 : (p.hom.app (Opposite.op W)).hom ((ℰ.obj.map g.op).hom (s_cov i)) =
          (oneR.obj.map g.op).hom ((p.hom.app (Opposite.op (V_cov i))).hom (s_cov i)) := hnat_g
      change (oneR.obj.map f.op).hom ((p.hom.app (Opposite.op T_S)).hom e_top) =
        (oneR.obj.map f.op).hom (one_W T_S)
      rw [h1, hglue]
      change (p.hom.app (Opposite.op W)).hom ((ℰ.obj.map g.op).hom (s_cov i)) =
        (oneR.obj.map f.op).hom (one_W T_S)
      rw [h2, hs_cov_p i, hone_map g, hone_map f]
    let e_hom : Quiver.Hom RM (ℰ.obj.obj (Opposite.op T_S)) :=
      ModuleCat.ofHom (LinearMap.toSpanSingleton R _ e_top)
    let σ : Quiver.Hom oneR ℰ := (adj_c.homEquiv RM ℰ).symm e_hom
    refine ⟨σ, ?_⟩
    apply (adj_c.homEquiv RM oneR).injective
    rw [CategoryTheory.Adjunction.homEquiv_naturality_right adj_c σ p,
      (adj_c.homEquiv RM ℰ).apply_symm_apply e_hom,
      CategoryTheory.Adjunction.homEquiv_unit adj_c RM oneR (CategoryTheory.CategoryStruct.id oneR),
      CategoryTheory.Functor.map_id]
    apply ModuleCat.hom_ext
    apply LinearMap.ext_ring
    change (p.hom.app (Opposite.op T_S)).hom (e_hom.hom (ULift.up (1 : ZMod m))) = one_top
    have he1 : e_hom.hom (ULift.up (1 : ZMod m)) = e_top := one_smul R e_top
    rw [he1, he_top_p]

  refine ⟨hMono,
    hExtSplit (weilEtaleModuleUnit X.left m) (CategoryTheory.Limits.cokernel ι_ext)
      (fun E f g h0 hSE =>
        hShortExactSection (CategoryTheory.Limits.cokernel ι_ext) E f g h0 hVan_U hSE)⟩

theorem weil_curve_mid_ext_zero_ext_cohomology_finite (k : Type u) [Field k] [IsAlgClosed k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper X.hom]
    (U : X.left.Opens)
    (m M : ℕ) (hm : 1 ≤ m) (hUnit : IsUnit ((m : ℕ) : k))
    (h_et_V : ∀ {V : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom V U.toScheme),
      AlgebraicGeometry.Etale π → AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp π U.ι))
    (Γ : Type u) [Group Γ] [Finite Γ]
    (V : AlgebraicGeometry.Scheme.{u})
    (π : Quiver.Hom V U.toScheme)
    (act : Γ → Quiver.Hom V V)
