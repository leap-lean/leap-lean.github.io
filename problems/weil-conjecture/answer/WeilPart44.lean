theorem weil_coinv_torsion_verdier_hom_ext_bijective (S : AlgebraicGeometry.Scheme.{u}) (d m : ℕ) (hm : 1 ≤ m) :
    (∀ (hGod : WeilHasTruncatedGodementComplex S d m)
      (ℱ₁ ℱ₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (π : Quiver.Hom ℱ₁ ℱ₂),
      m • CategoryTheory.CategoryStruct.id ℱ₁ = 0 →
      CategoryTheory.Epi π →
      Function.Surjective
        ((CategoryTheory.Abelian.Ext.mk₀ π).postcomp
          ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ)))
          (Nat.add_zero (2 * d)))) ∧
    (∀ (tr_m : weilEtaleTorsionH S m (2 * d) →+ ZMod m)
      (θ_top : weilEtaleModuleH S m (2 * d) →+ weilEtaleTorsionH S m (2 * d)),
      WeilIsModuleToTorsionComparison S m (2 * d) θ_top →
      WeilHasVerdierDualExtPackage S d m (tr_m.comp θ_top) →
      ∀ (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
        m • CategoryTheory.CategoryStruct.id ℱ = 0 →
        Function.Bijective
          (fun (f : Quiver.Hom ℱ (weilEtaleTorsionSheaf S m)) =>
            tr_m.comp
              ((CategoryTheory.Abelian.Ext.mk₀ f).postcomp
                ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
                  (AddCommGrpCat.of (ULift.{u} ℤ)))
                (Nat.add_zero (2 * d))))) :=
by
  let R := ULift.{u, 0} (ZMod m)
  let J := S.smallEtaleTopology
  let C_R := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
  let C_Z := CategoryTheory.Sheaf J AddCommGrpCat.{u}
  let oneR : C_R := weilEtaleModuleUnit S m
  let AZ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let FZ : C_Z := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj AZ
  let FM : C_Z := weilEtaleTorsionSheaf S m
  have hm_ne : m ≠ 0 := by omega

  
  have hAbInjSES : ∀ (C : Type (u + 1)) [Category.{u + 1} C] [Abelian C] [EnoughInjectives C]
      (G : C),
      ∃ (I Q : C) (i : G ⟶ I) (p : I ⟶ Q) (h0 : i ≫ p = 0),
        CategoryTheory.Injective I ∧ (CategoryTheory.ShortComplex.mk i p h0).ShortExact := by
    intro C _ _ _ G
    let I : C := CategoryTheory.Injective.under G
    let i : G ⟶ I := CategoryTheory.Injective.ι G
    let Q : C := CategoryTheory.Limits.cokernel i
    let p : I ⟶ Q := CategoryTheory.Limits.cokernel.π i
    exact ⟨I, Q, i, p, CategoryTheory.Limits.cokernel.condition i, inferInstance,
      { exact := CategoryTheory.ShortComplex.exact_cokernel i
        mono_f := inferInstance
        epi_g := inferInstance }⟩

  
  
  
  have hGodVan : ∀ (hGod : WeilHasTruncatedGodementComplex S d m) (G : C_R),
      Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR G (2 * d + 1)) := by
    intro hGod G
    rcases hGod with ⟨T_god, η, diff, _, hZero, hMonoη, hEx0, hExq, hAcyc, _⟩
    let Z : ℕ → C_R := fun p => CategoryTheory.Limits.kernel ((diff p).app G)
    let ι : ∀ p : ℕ, Z p ⟶ (T_god p).obj G :=
      fun p => CategoryTheory.Limits.kernel.ι ((diff p).app G)
    have hι_mono : ∀ p : ℕ, CategoryTheory.Mono (ι p) :=
      fun _ => CategoryTheory.Limits.equalizer.ι_mono

    
    have hTopSub : Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (Z (2 * d)) 1) := by
      have hIsZero : CategoryTheory.Limits.IsZero ((T_god (2 * d + 1)).obj G) :=
        hZero (2 * d + 1) (by omega) G
      have hdiff_top : (diff (2 * d)).app G = 0 := hIsZero.eq_zero_of_tgt _
      have hid_cond : CategoryTheory.CategoryStruct.id ((T_god (2 * d)).obj G) ≫
          (diff (2 * d)).app G = 0 := by
        rw [hdiff_top, CategoryTheory.Limits.comp_zero]
      let inv_top : (T_god (2 * d)).obj G ⟶ Z (2 * d) :=
        CategoryTheory.Limits.kernel.lift ((diff (2 * d)).app G)
          (CategoryTheory.CategoryStruct.id ((T_god (2 * d)).obj G)) hid_cond
      have hret : ι (2 * d) ≫ inv_top = CategoryTheory.CategoryStruct.id (Z (2 * d)) := by
        have _ := hι_mono (2 * d)
        rw [← CategoryTheory.cancel_mono (ι (2 * d)), CategoryTheory.Category.assoc,
          CategoryTheory.Limits.kernel.lift_ι, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp]
      have _ : Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR ((T_god (2 * d)).obj G) 1) :=
        hAcyc (2 * d) 1 (le_refl 1) G
      refine Subsingleton.intro fun x y => ?_
      have hxy : x.comp (CategoryTheory.Abelian.Ext.mk₀ (ι (2 * d))) (Nat.add_zero 1) =
          y.comp (CategoryTheory.Abelian.Ext.mk₀ (ι (2 * d))) (Nat.add_zero 1) :=
        Subsingleton.elim _ _
      calc
        x = x.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (Z (2 * d))))
              (Nat.add_zero 1) := (CategoryTheory.Abelian.Ext.comp_mk₀_id x).symm
        _ = x.comp (CategoryTheory.Abelian.Ext.mk₀ (ι (2 * d) ≫ inv_top)) (Nat.add_zero 1) := by
              rw [hret]
        _ = (x.comp (CategoryTheory.Abelian.Ext.mk₀ (ι (2 * d))) (Nat.add_zero 1)).comp
              (CategoryTheory.Abelian.Ext.mk₀ inv_top) (Nat.add_zero 1) := by
              rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
                CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 1) (Nat.add_zero 0)
                  (Nat.add_zero 1)]
        _ = (y.comp (CategoryTheory.Abelian.Ext.mk₀ (ι (2 * d))) (Nat.add_zero 1)).comp
              (CategoryTheory.Abelian.Ext.mk₀ inv_top) (Nat.add_zero 1) := by rw [hxy]
        _ = y.comp (CategoryTheory.Abelian.Ext.mk₀ (ι (2 * d) ≫ inv_top)) (Nat.add_zero 1) := by
              rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 1) (Nat.add_zero 0)
                (Nat.add_zero 1), CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        _ = y := by rw [hret, CategoryTheory.Abelian.Ext.comp_mk₀_id]

    
    have hStepSub : ∀ (p k : ℕ), 1 ≤ k →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (Z (p + 1)) k) →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (Z p) (k + 1)) := by
      intro p k hk hSubNext
      obtain ⟨hp, hEx_p⟩ := hExq p G
      let π_p : (T_god p).obj G ⟶ Z (p + 1) :=
        CategoryTheory.Limits.kernel.lift ((diff (p + 1)).app G) ((diff p).app G) hp
      have hEpi_π : CategoryTheory.Epi π_p :=
        CategoryTheory.ShortComplex.Exact.epi_kernelLift hEx_p
      have hιπ : ι p ≫ π_p = 0 := by
        have _ := hι_mono (p + 1)
        rw [← CategoryTheory.cancel_mono (ι (p + 1)), CategoryTheory.Category.assoc,
          CategoryTheory.Limits.kernel.lift_ι, CategoryTheory.Limits.zero_comp]
        exact CategoryTheory.Limits.kernel.condition ((diff p).app G)
      let S_coc := CategoryTheory.ShortComplex.mk (ι p) π_p hιπ
      have hKer_ι : CategoryTheory.Limits.IsLimit
          (CategoryTheory.Limits.KernelFork.ofι S_coc.f S_coc.zero) := by
        refine CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
          (fun {W} w hw => CategoryTheory.Limits.kernel.lift ((diff p).app G) w ?_)
          (fun {W} w hw => CategoryTheory.Limits.kernel.lift_ι _ _ _)
          (fun {W} w hw m hm => by
            have _ := hι_mono p
            rw [← CategoryTheory.cancel_mono (ι p), CategoryTheory.Limits.kernel.lift_ι]
            exact hm)
        calc
          w ≫ (diff p).app G = w ≫ (π_p ≫ ι (p + 1)) := by
            rw [CategoryTheory.Limits.kernel.lift_ι]
          _ = (w ≫ π_p) ≫ ι (p + 1) := (CategoryTheory.Category.assoc _ _ _).symm
          _ = 0 := by rw [hw, CategoryTheory.Limits.zero_comp]
      have hS_coc : S_coc.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel S_coc hKer_ι
          mono_f := hι_mono p
          epi_g := hEpi_π }
      have _ : Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR ((T_god p).obj G) (k + 1)) :=
        hAcyc p (k + 1) (by omega) G
      refine subsingleton_of_forall_eq 0 fun y => ?_
      have hy0 : y.comp (CategoryTheory.Abelian.Ext.mk₀ S_coc.f) (Nat.add_zero (k + 1)) = 0 :=
        Subsingleton.elim _ _
      obtain ⟨z, hz⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ oneR hS_coc y hy0 (rfl : k + 1 = k + 1)
      have hz0 : z = 0 := @Subsingleton.elim _ hSubNext z 0
      rw [← hz, hz0, CategoryTheory.Abelian.Ext.zero_comp]

    
    have hShiftSub : ∀ (r p k c : ℕ), 1 ≤ k → k + r = c →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (Z (p + r)) k) →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (Z p) c) := by
      intro r
      induction r with
      | zero =>
        intro p k c _ hkc hSub
        have h1 : p + 0 = p := Nat.add_zero p
        have h2 : k = c := by omega
        subst h2
        rwa [h1] at hSub
      | succ s ih =>
        intro p k c hk hkc hSub
        have hp_eq : p + (s + 1) = (p + s) + 1 := by omega
        rw [hp_eq] at hSub
        have hSubMid : Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (Z (p + s)) (k + 1)) :=
          hStepSub (p + s) k hk hSub
        exact ih p (k + 1) c (by omega) (by omega) hSubMid

    have hZ0Sub : Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (Z 0) (2 * d + 1)) :=
      hShiftSub (2 * d) 0 1 (2 * d + 1) (le_refl 1) (by omega)
        (by simpa only [Nat.zero_add] using hTopSub)

    
    obtain ⟨h₀, hEx₀⟩ := hEx0 G
    let e₀ : G ⟶ Z 0 := CategoryTheory.Limits.kernel.lift ((diff 0).app G) (η.app G) h₀
    have he₀_fac : e₀ ≫ ι 0 = η.app G := CategoryTheory.Limits.kernel.lift_ι _ _ _
    have _ : CategoryTheory.Mono (η.app G) := hMonoη G
    have _ : CategoryTheory.Mono e₀ := CategoryTheory.mono_of_mono_fac he₀_fac
    have _ : CategoryTheory.Epi e₀ := CategoryTheory.ShortComplex.Exact.epi_kernelLift hEx₀
    have _ : CategoryTheory.IsIso e₀ := CategoryTheory.isIso_of_mono_of_epi e₀
    refine subsingleton_of_forall_eq 0 fun x => ?_
    have hx0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ e₀) (Nat.add_zero (2 * d + 1)) = 0 :=
      @Subsingleton.elim _ hZ0Sub _ 0
    calc
      x = x.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id G))
            (Nat.add_zero (2 * d + 1)) := (CategoryTheory.Abelian.Ext.comp_mk₀_id x).symm
      _ = x.comp (CategoryTheory.Abelian.Ext.mk₀ (e₀ ≫ CategoryTheory.inv e₀))
            (Nat.add_zero (2 * d + 1)) := by rw [CategoryTheory.IsIso.hom_inv_id]
      _ = (x.comp (CategoryTheory.Abelian.Ext.mk₀ e₀) (Nat.add_zero (2 * d + 1))).comp
            (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv e₀))
            (Nat.add_zero (2 * d + 1)) := by
            rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
              CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero (2 * d + 1))
                (Nat.add_zero 0) (Nat.add_zero (2 * d + 1))]
      _ = 0 := by rw [hx0, CategoryTheory.Abelian.Ext.zero_comp]

  
  
  
  let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let eZ := (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
  let L_mod : AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R :=
    eZ.inverse.comp (ModuleCat.extendScalars (Int.castRingHom R))
  let adjModL : L_mod ⊣ FgtMod :=
    eZ.symm.toAdjunction.comp (ModuleCat.extendRestrictScalarsAdj (Int.castRingHom R))
  let C_mod : AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R :=
    eZ.inverse.comp (ModuleCat.coextendScalars (Int.castRingHom R))
  let adjModR : FgtMod ⊣ C_mod :=
    (ModuleCat.restrictCoextendScalarsAdj (Int.castRingHom R)).comp eZ.toAdjunction

  have hHasSheafCompose_of_adj : ∀ {A_cat B_cat : Type (u + 1)} [Category.{u, u + 1} A_cat]
      [Category.{u, u + 1} B_cat] {L : B_cat ⥤ A_cat} {F : A_cat ⥤ B_cat} (adj : L ⊣ F),
      J.HasSheafCompose F := by
    intro A_cat B_cat _ _ L F adj
    refine ⟨fun P hP E => ?_⟩
    let isoE : (P ⋙ F) ⋙ coyoneda.obj (Opposite.op E) ≅
        P ⋙ coyoneda.obj (Opposite.op (L.obj E)) :=
      NatIso.ofComponents
        (fun W => (adj.homEquiv E (P.obj W)).symm.toIso)
        (fun {W₁ W₂} f => by
          ext g
          exact adj.homEquiv_naturality_right_symm g (P.map f))
    exact CategoryTheory.Presieve.isSheaf_iso J isoE.symm (hP (L.obj E))

  letI : J.HasSheafCompose FgtMod := hHasSheafCompose_of_adj adjModL
  letI : J.HasSheafCompose C_mod := hHasSheafCompose_of_adj adjModR

  let U_of : C_R ⥤ C_Z := CategoryTheory.sheafCompose J FgtMod
  let C_sh : C_Z ⥤ C_R := CategoryTheory.sheafCompose J C_mod
  let L_pre : ((S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ ((S.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R) :=
    { obj := fun P => P ⋙ L_mod
      map := fun η => CategoryTheory.Functor.whiskerRight η L_mod }
  let L_sh : C_Z ⥤ C_R :=
    (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).comp
      (L_pre.comp (CategoryTheory.presheafToSheaf J (ModuleCat.{u, u} R)))

  
  let homEquivRight : ∀ (F_sh : C_R) (G_sh : C_Z), (U_of.obj F_sh ⟶ G_sh) ≃ (F_sh ⟶ C_sh.obj G_sh) :=
    fun F_sh G_sh =>
      { toFun := fun φ =>
          ⟨{ app := fun W => (adjModR.homEquiv (F_sh.obj.obj W) (G_sh.obj.obj W)) (φ.hom.app W)
             naturality := fun {W₁ W₂} f => by
               have h1 := adjModR.homEquiv_naturality_left (F_sh.obj.map f) (φ.hom.app W₂)
               have h2 := adjModR.homEquiv_naturality_right (φ.hom.app W₁) (G_sh.obj.map f)
               exact h1.symm.trans ((congrArg _ (φ.hom.naturality f)).trans h2) }⟩
        invFun := fun ψ =>
          ⟨{ app := fun W => (adjModR.homEquiv (F_sh.obj.obj W) (G_sh.obj.obj W)).symm (ψ.hom.app W)
             naturality := fun {W₁ W₂} f => by
               have h1 := adjModR.homEquiv_naturality_left_symm (F_sh.obj.map f) (ψ.hom.app W₂)
               have h2 := adjModR.homEquiv_naturality_right_symm (ψ.hom.app W₁) (G_sh.obj.map f)
               exact h1.symm.trans ((congrArg _ (ψ.hom.naturality f)).trans h2) }⟩
        left_inv := fun φ => by
          ext W : 3
          exact (adjModR.homEquiv _ _).left_inv (φ.hom.app W)
        right_inv := fun ψ => by
          ext W : 3
          exact (adjModR.homEquiv _ _).right_inv (ψ.hom.app W) }

  have adjShR : U_of ⊣ C_sh :=
    CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := homEquivRight
        homEquiv_naturality_left_symm := fun {F' F G} u ψ => by
          ext W : 3
          exact adjModR.homEquiv_naturality_left_symm (u.hom.app W) (ψ.hom.app W)
        homEquiv_naturality_right := fun {F G G'} φ v => by
          ext W : 3
          exact adjModR.homEquiv_naturality_right (φ.hom.app W) (v.hom.app W) }

  
  have adjShL : L_sh ⊣ U_of := by
    let adjSh := CategoryTheory.sheafificationAdjunction J (ModuleCat.{u, u} R)
    let eWhisk : ∀ (G : C_Z) (F : C_R), (G.obj ⋙ L_mod ⟶ F.obj) ≃ (G ⟶ U_of.obj F) := fun G F =>
      { toFun := fun η =>
          ⟨{ app := fun W => (adjModL.homEquiv (G.obj.obj W) (F.obj.obj W)) (η.app W)
             naturality := fun {W₁ W₂} f => by
               have h1 := adjModL.homEquiv_naturality_left (G.obj.map f) (η.app W₂)
               have h2 := adjModL.homEquiv_naturality_right (η.app W₁) (F.obj.map f)
               exact h1.symm.trans ((congrArg _ (η.naturality f)).trans h2) }⟩
        invFun := fun φ =>
          { app := fun W => (adjModL.homEquiv (G.obj.obj W) (F.obj.obj W)).symm (φ.hom.app W)
            naturality := fun {W₁ W₂} f => by
              have h1 := adjModL.homEquiv_naturality_left_symm (G.obj.map f) (φ.hom.app W₂)
              have h2 := adjModL.homEquiv_naturality_right_symm (φ.hom.app W₁) (F.obj.map f)
              exact h1.symm.trans ((congrArg _ (φ.hom.naturality f)).trans h2) }
        left_inv := fun η => by ext W : 2; exact (adjModL.homEquiv _ _).left_inv (η.app W)
        right_inv := fun φ => by ext W : 3; exact (adjModL.homEquiv _ _).right_inv (φ.hom.app W) }
    exact CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := fun G F => (adjSh.homEquiv (G.obj ⋙ L_mod) F).trans (eWhisk G F)
        homEquiv_naturality_left_symm := fun {G' G F} u φ => by
          change (adjSh.homEquiv (G'.obj ⋙ L_mod) F).symm ((eWhisk G' F).symm (u ≫ φ)) =
            (CategoryTheory.presheafToSheaf J (ModuleCat.{u, u} R)).map (L_pre.map u.hom) ≫
              (adjSh.homEquiv (G.obj ⋙ L_mod) F).symm ((eWhisk G F).symm φ)
          rw [← adjSh.homEquiv_naturality_left_symm]
          congr 1
          ext W : 2
          exact adjModL.homEquiv_naturality_left_symm (u.hom.app W) (φ.hom.app W)
        homEquiv_naturality_right := fun {G F F'} ψ v => by
          ext W : 3
          change (adjModL.homEquiv _ _) (((adjSh.homEquiv (G.obj ⋙ L_mod) F') (ψ ≫ v)).app W) =
            (adjModL.homEquiv _ _) (((adjSh.homEquiv (G.obj ⋙ L_mod) F) ψ).app W) ≫
              FgtMod.map (v.hom.app W)
          rw [adjSh.homEquiv_naturality_right]
          exact adjModL.homEquiv_naturality_right
            (((adjSh.homEquiv (G.obj ⋙ L_mod) F) ψ).app W) (v.hom.app W) }

  letI : U_of.IsLeftAdjoint := adjShR.isLeftAdjoint
  letI : U_of.IsRightAdjoint := adjShL.isRightAdjoint
  letI : CategoryTheory.Limits.PreservesFiniteLimits U_of := inferInstance
  letI : CategoryTheory.Limits.PreservesFiniteColimits U_of := inferInstance
  letI : U_of.Additive := { map_add := by intros; ext W : 3; exact FgtMod.map_add }

  
  letI : CategoryTheory.MorphismProperty.ContainsIdentities
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    ⟨fun _ => inferInstance⟩
  let T_S : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
    (CategoryTheory.CategoryStruct.id S)
    (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S))
  let hT_S : CategoryTheory.Limits.IsTerminal T_S :=
    CategoryTheory.MorphismProperty.Over.mkIdTerminal (@AlgebraicGeometry.Etale) S
  let adjZ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S
  let adjR := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) hT_S

  let ιM : AM ⟶ FgtMod.obj (ModuleCat.of R R) := AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let ιM_inv : FgtMod.obj (ModuleCat.of R R) ⟶ AM := AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let ιZ : AZ ⟶ FgtMod.obj (ModuleCat.of R R) :=
    CategoryTheory.CategoryStruct.comp
      (AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u} ℤ)) :
        AZ ⟶ AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ))
      (CategoryTheory.CategoryStruct.comp
        (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (Int.castAddHom (ZMod m))))
        ιM)
  let u₀ : FgtMod.obj (ModuleCat.of R R) ⟶ (U_of.obj oneR).obj.obj (Opposite.op T_S) :=
    FgtMod.map (adjR.unit.app (ModuleCat.of R R))
  let ηZ : FZ ⟶ U_of.obj oneR := (adjZ.homEquiv AZ (U_of.obj oneR)).symm (ιZ ≫ u₀)
  let αM : FM ⟶ U_of.obj oneR := (adjZ.homEquiv AM (U_of.obj oneR)).symm (ιM ≫ u₀)

  
  let E_unit : ∀ (G_sh : C_Z), (U_of.obj oneR ⟶ G_sh) ≃ (FM ⟶ G_sh) := fun G_sh =>
    { toFun := fun φ =>
        let x1 := homEquivRight oneR G_sh φ
        let x2 : ModuleCat.of R R ⟶ C_mod.obj (G_sh.obj.obj (Opposite.op T_S)) :=
          (adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G_sh)) x1
        let x3 := (adjModR.homEquiv (ModuleCat.of R R) (G_sh.obj.obj (Opposite.op T_S))).symm x2
        (adjZ.homEquiv AM G_sh).symm (ιM ≫ x3)
      invFun := fun ψ =>
        let y1 := (adjZ.homEquiv AM G_sh) ψ
        let y2 : ModuleCat.of R R ⟶
            ((CategoryTheory.sheafSections J (ModuleCat.{u, u} R)).obj (Opposite.op T_S)).obj
              (C_sh.obj G_sh) :=
          (adjModR.homEquiv (ModuleCat.of R R) (G_sh.obj.obj (Opposite.op T_S))) (ιM_inv ≫ y1)
        (homEquivRight oneR G_sh).symm
          ((adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G_sh)).symm y2)
      left_inv := fun φ => by
        dsimp only
        let x1 := homEquivRight oneR G_sh φ
        let x2 : ModuleCat.of R R ⟶ C_mod.obj (G_sh.obj.obj (Opposite.op T_S)) :=
          (adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G_sh)) x1
        let x3 := (adjModR.homEquiv (ModuleCat.of R R) (G_sh.obj.obj (Opposite.op T_S))).symm x2
        have h_z : (adjZ.homEquiv AM G_sh) ((adjZ.homEquiv AM G_sh).symm (ιM ≫ x3)) = ιM ≫ x3 :=
          (adjZ.homEquiv AM G_sh).apply_symm_apply (ιM ≫ x3)
        have h_ι : ιM_inv ≫ (ιM ≫ x3) = x3 := by
          have hid : ιM_inv ≫ ιM = 𝟙 _ := rfl
          rw [← Category.assoc, hid, Category.id_comp]
        have h_mod : (adjModR.homEquiv (ModuleCat.of R R) (G_sh.obj.obj (Opposite.op T_S))) x3 = x2 :=
          (adjModR.homEquiv (ModuleCat.of R R) (G_sh.obj.obj (Opposite.op T_S))).apply_symm_apply x2
        change (homEquivRight oneR G_sh).symm
            ((adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G_sh)).symm
              ((adjModR.homEquiv (ModuleCat.of R R) (G_sh.obj.obj (Opposite.op T_S)))
                (ιM_inv ≫ (adjZ.homEquiv AM G_sh) ((adjZ.homEquiv AM G_sh).symm (ιM ≫ x3))))) = φ
        rw [h_z, h_ι, h_mod]
        change (homEquivRight oneR G_sh).symm
            ((adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G_sh)).symm
              ((adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G_sh)) x1)) = φ
        rw [(adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G_sh)).symm_apply_apply]
        exact (homEquivRight oneR G_sh).symm_apply_apply φ
      right_inv := fun ψ => by
        dsimp only
        let y1 := (adjZ.homEquiv AM G_sh) ψ
        let y2 : ModuleCat.of R R ⟶
            ((CategoryTheory.sheafSections J (ModuleCat.{u, u} R)).obj (Opposite.op T_S)).obj
              (C_sh.obj G_sh) :=
          (adjModR.homEquiv (ModuleCat.of R R) (G_sh.obj.obj (Opposite.op T_S))) (ιM_inv ≫ y1)
        have h_r : homEquivRight oneR G_sh ((homEquivRight oneR G_sh).symm
            ((adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G_sh)).symm y2)) =
            (adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G_sh)).symm y2 :=
          (homEquivRight oneR G_sh).apply_symm_apply _
        have h_adjR : (adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G_sh))
            ((adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G_sh)).symm y2) = y2 :=
          (adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G_sh)).apply_symm_apply y2
        change (adjZ.homEquiv AM G_sh).symm
            (ιM ≫ (adjModR.homEquiv (ModuleCat.of R R) (G_sh.obj.obj (Opposite.op T_S))).symm
              ((adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G_sh))
                (homEquivRight oneR G_sh ((homEquivRight oneR G_sh).symm
                  ((adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G_sh)).symm y2))))) = ψ
        rw [h_r, h_adjR]
        change (adjZ.homEquiv AM G_sh).symm
            (ιM ≫ (adjModR.homEquiv (ModuleCat.of R R) (G_sh.obj.obj (Opposite.op T_S))).symm
              ((adjModR.homEquiv (ModuleCat.of R R) (G_sh.obj.obj (Opposite.op T_S)))
                (ιM_inv ≫ y1))) = ψ
        rw [(adjModR.homEquiv (ModuleCat.of R R) (G_sh.obj.obj (Opposite.op T_S))).symm_apply_apply]
        have h_ι : ιM ≫ (ιM_inv ≫ y1) = y1 := by
          have hid : ιM ≫ ιM_inv = 𝟙 _ := rfl
          rw [← Category.assoc, hid, Category.id_comp]
        rw [h_ι]
        exact (adjZ.homEquiv AM G_sh).symm_apply_apply ψ }

  have hE_unit_nat : ∀ {G₁ G₂ : C_Z} (φ : U_of.obj oneR ⟶ G₁) (v : G₁ ⟶ G₂),
      E_unit G₂ (φ ≫ v) = E_unit G₁ φ ≫ v := by
    intro G₁ G₂ φ v
    have h1 : homEquivRight oneR G₂ (φ ≫ v) = homEquivRight oneR G₁ φ ≫ C_sh.map v := by
      ext W : 3
      exact adjModR.homEquiv_naturality_right (φ.hom.app W) (v.hom.app W)
    have h2 : (adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G₂)) (homEquivRight oneR G₂ (φ ≫ v)) =
        (adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G₁)) (homEquivRight oneR G₁ φ) ≫
          ((CategoryTheory.sheafSections J (ModuleCat.{u, u} R)).obj (Opposite.op T_S)).map
            (C_sh.map v) := by
      rw [h1, adjR.homEquiv_naturality_right]
    let x2 : ModuleCat.of R R ⟶ C_mod.obj (G₁.obj.obj (Opposite.op T_S)) :=
      (adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G₁)) (homEquivRight oneR G₁ φ)
    have h2' : ((adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G₂)) (homEquivRight oneR G₂ (φ ≫ v)) :
        ModuleCat.of R R ⟶ C_mod.obj (G₂.obj.obj (Opposite.op T_S))) =
        x2 ≫ C_mod.map (v.hom.app (Opposite.op T_S)) := h2
    change (adjZ.homEquiv AM G₂).symm
        (ιM ≫ (adjModR.homEquiv (ModuleCat.of R R) (G₂.obj.obj (Opposite.op T_S))).symm
          ((adjR.homEquiv (ModuleCat.of R R) (C_sh.obj G₂)) (homEquivRight oneR G₂ (φ ≫ v)))) =
      (adjZ.homEquiv AM G₁).symm
        (ιM ≫ (adjModR.homEquiv (ModuleCat.of R R) (G₁.obj.obj (Opposite.op T_S))).symm x2) ≫ v
    rw [h2', adjModR.homEquiv_naturality_right_symm, ← Category.assoc]
    let y_sec : AM ⟶
        ((CategoryTheory.sheafSections J AddCommGrpCat.{u}).obj (Opposite.op T_S)).obj G₁ :=
      ιM ≫ (adjModR.homEquiv (ModuleCat.of R R) (G₁.obj.obj (Opposite.op T_S))).symm x2
    exact adjZ.homEquiv_naturality_right_symm y_sec v

  have hE_unit_id : E_unit (U_of.obj oneR) (𝟙 (U_of.obj oneR)) = αM := by
    let M0 := oneR.obj.obj (Opposite.op T_S)
    have h1 : ((adjR.homEquiv (ModuleCat.of R R) (C_sh.obj (U_of.obj oneR)))
        (homEquivRight oneR (U_of.obj oneR) (𝟙 (U_of.obj oneR))) :
        ModuleCat.of R R ⟶ C_mod.obj (FgtMod.obj M0)) =
        adjR.unit.app (ModuleCat.of R R) ≫ adjModR.unit.app M0 := by
      rw [Adjunction.homEquiv_unit]
      change adjR.unit.app (ModuleCat.of R R) ≫
          ((adjModR.homEquiv M0 (FgtMod.obj M0)) (𝟙 (FgtMod.obj M0)) :
            M0 ⟶ C_mod.obj (FgtMod.obj M0)) =
        adjR.unit.app (ModuleCat.of R R) ≫ adjModR.unit.app M0
      rw [Adjunction.homEquiv_unit, C_mod.map_id]
      exact congrArg (adjR.unit.app (ModuleCat.of R R) ≫ ·)
        (Category.comp_id (adjModR.unit.app M0))
    change (adjZ.homEquiv AM (U_of.obj oneR)).symm
        (ιM ≫ (adjModR.homEquiv (ModuleCat.of R R) (FgtMod.obj M0)).symm
          ((adjR.homEquiv (ModuleCat.of R R) (C_sh.obj (U_of.obj oneR)))
            (homEquivRight oneR (U_of.obj oneR) (𝟙 (U_of.obj oneR))))) =
      (adjZ.homEquiv AM (U_of.obj oneR)).symm (ιM ≫ u₀)
    congr 1
    congr 1
    rw [h1, Adjunction.homEquiv_counit, FgtMod.map_comp, Category.assoc]
    exact (congrArg (FgtMod.map (adjR.unit.app (ModuleCat.of R R)) ≫ ·)
      (adjModR.left_triangle_components M0)).trans (Category.comp_id _)

  have hE_unit_apply : ∀ {G_sh : C_Z} (φ : U_of.obj oneR ⟶ G_sh), E_unit G_sh φ = αM ≫ φ := by
    intro G_sh φ
    calc
      E_unit G_sh φ = E_unit G_sh (𝟙 (U_of.obj oneR) ≫ φ) := by rw [Category.id_comp]
      _ = E_unit (U_of.obj oneR) (𝟙 (U_of.obj oneR)) ≫ φ := hE_unit_nat _ _
      _ = αM ≫ φ := by rw [hE_unit_id]

  let βM : U_of.obj oneR ⟶ FM := (E_unit FM).symm (𝟙 FM)
  have hαβ : αM ≫ βM = 𝟙 FM := by
    rw [← hE_unit_apply βM]
    exact (E_unit FM).apply_symm_apply (𝟙 FM)
  have hβα : βM ≫ αM = 𝟙 (U_of.obj oneR) := by
    apply (E_unit (U_of.obj oneR)).injective
    rw [hE_unit_apply, ← Category.assoc, hαβ, Category.id_comp, hE_unit_id]

  let θ_of : ∀ k : ℕ, weilEtaleModuleH S m k →+ weilEtaleTorsionH S m k := fun k =>
    ((CategoryTheory.Abelian.Ext.mk₀ βM).postcomp FZ (Nat.add_zero k)).comp
      (((CategoryTheory.Abelian.Ext.mk₀ ηZ).precomp (U_of.obj oneR) (Nat.zero_add k)).comp
        (U_of.mapExtAddHom oneR oneR k))

  have hθ_of : ∀ k : ℕ, WeilIsModuleToTorsionComparison S m k (θ_of k) := by
    intro k
    refine ⟨U_of, fun _ => rfl, fun _ _ => HEq.rfl, inferInstance, inferInstance, inferInstance,
      T_S, hT_S, rfl, HEq.rfl, u₀, HEq.rfl, βM, hαβ, hβα, fun x => rfl⟩

  
  have hModFaith : ∀ {M N : ModuleCat.{u, u} R} {f₁ f₂ : M ⟶ N},
      FgtMod.map f₁ = FgtMod.map f₂ → f₁ = f₂ := by
    intro M N f₁ f₂ h
    ext x
    exact ConcreteCategory.congr_hom h x

  have hModFull : ∀ (M N : ModuleCat.{u, u} R) (g : FgtMod.obj M ⟶ FgtMod.obj N),
      ∃ f : M ⟶ N, FgtMod.map f = g := by
    intro M N g
    let g_fn : ↥M → ↥N := g.hom
    refine ⟨ModuleCat.ofHom
      { toFun := g_fn
        map_add' := fun x y => g.hom.map_add x y
        map_smul' := fun r x => by
          obtain ⟨z, hz⟩ := ZMod.intCast_surjective r.down
          have hzr : (z : R) = r := ULift.ext _ _ hz
          change g_fn (r • x) = r • g_fn x
          rw [← hzr, Int.cast_smul_eq_zsmul R z x, Int.cast_smul_eq_zsmul R z (g_fn x)]
          exact g.hom.map_zsmul z x }, ?_⟩
    ext x
    rfl

  have hUFaith : ∀ {G₁ G₂ : C_R} {ψ₁ ψ₂ : G₁ ⟶ G₂},
      U_of.map ψ₁ = U_of.map ψ₂ → ψ₁ = ψ₂ := by
    intro G₁ G₂ ψ₁ ψ₂ h
    ext W : 3
    exact hModFaith (congrArg (fun u => u.hom.app W) h)

  have hUFull : ∀ {G₁ G₂ : C_R} (φ : U_of.obj G₁ ⟶ U_of.obj G₂),
      ∃ ψ : G₁ ⟶ G₂, U_of.map ψ = φ := by
    intro G₁ G₂ φ
    refine ⟨⟨{ app := fun W => Classical.choose (hModFull _ _ (φ.hom.app W))
               naturality := fun {W₁ W₂} f => by
                 apply hModFaith
                 rw [Functor.map_comp, Functor.map_comp,
                   Classical.choose_spec (hModFull _ _ (φ.hom.app W₂)),
                   Classical.choose_spec (hModFull _ _ (φ.hom.app W₁))]
                 exact φ.hom.naturality f }⟩, ?_⟩
    ext W : 3
    exact Classical.choose_spec (hModFull _ _ (φ.hom.app W))

  
  have hLiftSheaf : ∀ (B_sh : C_Z), m • CategoryTheory.CategoryStruct.id B_sh = 0 →
      ∃ B_mod : C_R, U_of.obj B_mod = B_sh := by
    intro B_sh hTorB
    have hNsmulApp : ∀ (n : ℕ) (u : B_sh ⟶ B_sh) (W : (S.Etale)ᵒᵖ) (x : ↥(B_sh.obj.obj W)),
        ((n • u).hom.app W).hom x = n • ((u.hom.app W).hom x) := by
      intro n u W x
      induction n with
      | zero =>
        rw [zero_nsmul, zero_nsmul]
        rfl
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul]
        change ((k • u).hom.app W).hom x + (u.hom.app W).hom x =
          k • ((u.hom.app W).hom x) + (u.hom.app W).hom x
        rw [ih]
    have hSecTor : ∀ (W : (S.Etale)ᵒᵖ) (x : ↥(B_sh.obj.obj W)), m • x = 0 := by
      intro W x
      have h1 := hNsmulApp m (CategoryTheory.CategoryStruct.id B_sh) W x
      have h2 : (((CategoryTheory.CategoryStruct.id B_sh).hom.app W).hom x) = x := rfl
      rw [h2, hTorB] at h1
      exact h1.symm
    let objMod : (S.Etale)ᵒᵖ → ModuleCat.{u, u} R := fun W =>
      letI : Module (ZMod m) ↥(B_sh.obj.obj W) := @AddCommGroup.zmodModule m _ _ (hSecTor W)
      letI : Module R ↥(B_sh.obj.obj W) :=
        Module.compHom ↥(B_sh.obj.obj W) (ULift.ringEquiv : R ≃+* ZMod m).toRingHom
      ModuleCat.of R ↥(B_sh.obj.obj W)
    let P_mod : (S.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R :=
      { obj := objMod
        map := fun {W₁ W₂} f => Classical.choose (hModFull (objMod W₁) (objMod W₂) (B_sh.obj.map f))
        map_id := fun W => by
          apply hModFaith
          rw [Classical.choose_spec (hModFull (objMod W) (objMod W) (B_sh.obj.map (𝟙 W))),
            B_sh.obj.map_id, FgtMod.map_id]
          rfl
        map_comp := fun {W₁ W₂ W₃} f g => by
          apply hModFaith
          have hc1 := Classical.choose_spec (hModFull (objMod W₁) (objMod W₃) (B_sh.obj.map (f ≫ g)))
          have hc2 := Classical.choose_spec (hModFull (objMod W₁) (objMod W₂) (B_sh.obj.map f))
          have hc3 := Classical.choose_spec (hModFull (objMod W₂) (objMod W₃) (B_sh.obj.map g))
          rw [FgtMod.map_comp, hc1, hc2, hc3, B_sh.obj.map_comp] }
    have hCompEq : P_mod ⋙ FgtMod = B_sh.obj := by
      refine CategoryTheory.Functor.ext (fun _ => rfl) (fun {W₁ W₂} f => ?_)
      simp only [eqToHom_refl, Category.id_comp, Category.comp_id]
      exact Classical.choose_spec (hModFull (objMod W₁) (objMod W₂) (B_sh.obj.map f))
    have hIsSheaf : CategoryTheory.Presheaf.IsSheaf J P_mod := by
      intro E
      let eCoy : ∀ W : (S.Etale)ᵒᵖ,
          (E ⟶ P_mod.obj W) ≃ (FgtMod.obj E ⟶ (P_mod ⋙ FgtMod).obj W) := fun W =>
        { toFun := fun f => FgtMod.map f
          invFun := fun g => Classical.choose (hModFull E (P_mod.obj W) g)
          left_inv := fun f => hModFaith (Classical.choose_spec (hModFull E (P_mod.obj W) (FgtMod.map f)))
          right_inv := fun g => Classical.choose_spec (hModFull E (P_mod.obj W) g) }
      let isoCoy : P_mod ⋙ coyoneda.obj (Opposite.op E) ≅
          (P_mod ⋙ FgtMod) ⋙ coyoneda.obj (Opposite.op (FgtMod.obj E)) :=
        NatIso.ofComponents
          (fun W => (eCoy W).toIso)
          (fun {W₁ W₂} u => by
            ext f
            exact Functor.map_comp FgtMod f (P_mod.map u))
      have hShB : CategoryTheory.Presieve.IsSheaf J
          ((P_mod ⋙ FgtMod) ⋙ coyoneda.obj (Opposite.op (FgtMod.obj E))) := by
        rw [hCompEq]
        exact B_sh.property (FgtMod.obj E)
      exact CategoryTheory.Presieve.isSheaf_iso J isoCoy.symm hShB
    refine ⟨⟨P_mod, hIsSheaf⟩, ?_⟩
    have hSheafEq : ∀ {P₁ P₂ : (S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}}
        (hP : P₁ = P₂) (hp₁ : CategoryTheory.Presheaf.IsSheaf J P₁)
        (hp₂ : CategoryTheory.Presheaf.IsSheaf J P₂),
        (⟨P₁, hp₁⟩ : C_Z) = ⟨P₂, hp₂⟩ := by
      intro P₁ P₂ hP hp₁ hp₂
      subst hP
      rfl
    exact hSheafEq hCompEq _ B_sh.property

  
  
  
  let isTF : C_Z → Prop := fun K => ∀ (n : ℕ), n ≠ 0 →
    CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id K)

  
  have hGrothPkg : ∀ (C : Type (u + 1)) [Category.{u + 1} C] [Abelian C]
      [IsGrothendieckAbelian.{u} C],
      (∀ {I : Type u} (Y : I → C),
        (∀ i : I, ∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id (Y i))) →
        ∃ (G : C) (ι_sig : ∀ i : I, Y i ⟶ G)
          (desc_sig : ∀ {A : C}, (∀ i : I, Y i ⟶ A) → (G ⟶ A)),
          (∀ {A : C} (f : ∀ i : I, Y i ⟶ A) (i : I), ι_sig i ≫ desc_sig f = f i) ∧
          (∀ {A : C} (g₁ g₂ : G ⟶ A), (∀ i : I, ι_sig i ≫ g₁ = ι_sig i ≫ g₂) → g₁ = g₂) ∧
          (∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id G))) ∧
      (∀ (G_tf : C),
        (∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id G_tf)) →
        (∀ {A B : C} (f₁ f₂ : A ⟶ B), (∀ h : G_tf ⟶ A, h ≫ f₁ = h ≫ f₂) → f₁ = f₂) →
        ∀ (E_sh : C), ∃ (P_sh : C) (q : P_sh ⟶ E_sh),
          CategoryTheory.Epi q ∧
          (∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id P_sh))) := by
    intro C _ _ _
    have hCop : ∀ {I : Type u} (Y : I → C),
        (∀ i : I, ∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id (Y i))) →
        ∃ (G : C) (ι_sig : ∀ i : I, Y i ⟶ G)
          (desc_sig : ∀ {A : C}, (∀ i : I, Y i ⟶ A) → (G ⟶ A)),
          (∀ {A : C} (f : ∀ i : I, Y i ⟶ A) (i : I), ι_sig i ≫ desc_sig f = f i) ∧
          (∀ {A : C} (g₁ g₂ : G ⟶ A), (∀ i : I, ι_sig i ≫ g₁ = ι_sig i ≫ g₂) → g₁ = g₂) ∧
          (∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id G)) := by
      intro I Y hY
      let G : C := Limits.sigmaObj Y
      refine ⟨G, Limits.Sigma.ι Y, fun f => Limits.Sigma.desc f,
        fun f i => Limits.Sigma.ι_comp_desc f i,
        fun g₁ g₂ h => Limits.Sigma.hom_ext _ _ (fun i => h i), ?_⟩
      intro n hn
      let D : Discrete I ⥤ C := Discrete.functor Y
      let φ : D ⟶ D := Discrete.natTrans (fun j => n • CategoryTheory.CategoryStruct.id (Y j.as))
      have _ : ∀ j : Discrete I, CategoryTheory.Mono (φ.app j) := fun j => hY j.as n hn
      have _ : CategoryTheory.Mono φ := NatTrans.mono_of_mono_app φ
      let hc : Limits.IsColimit (Limits.colimit.cocone D) := Limits.colimit.isColimit D
      refine Limits.colim.map_mono' φ hc hc (n • CategoryTheory.CategoryStruct.id G) (fun j => ?_)
      change Limits.Sigma.ι Y j.as ≫ (n • CategoryTheory.CategoryStruct.id G) =
        (n • CategoryTheory.CategoryStruct.id (Y j.as)) ≫ Limits.Sigma.ι Y j.as
      rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
    refine ⟨hCop, fun G_tf hG_tf hG_sep E_sh => ?_⟩
    rcases (inferInstance : IsGrothendieckAbelian.{u} C) with ⟨hLocSmall, _, _, _⟩
    letI : LocallySmall.{u} C := hLocSmall
    let I_E : Type u := Shrink.{u} (G_tf ⟶ E_sh)
    obtain ⟨P_sh, ι_E, desc_E, hι_desc_E, _, hP_tf⟩ :=
      hCop (fun _ : I_E => G_tf) (fun _ => hG_tf)
    let q : P_sh ⟶ E_sh := desc_E (fun i => (equivShrink.{u} (G_tf ⟶ E_sh)).symm i)
    refine ⟨P_sh, q, ⟨fun {B} u₁ u₂ hu => hG_sep u₁ u₂ (fun h => ?_)⟩, hP_tf⟩
    let i_h : I_E := equivShrink.{u} (G_tf ⟶ E_sh) h
    have hi : ι_E i_h ≫ q = h := by
      dsimp only [q]
      rw [hι_desc_E, Equiv.symm_apply_apply]
    rw [← hi, Category.assoc, Category.assoc, hu]

  have hMonoAZ : ∀ (n : ℕ), n ≠ 0 → CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id AZ) := by
    intro n hn
    rw [AddCommGrpCat.mono_iff_injective]
    intro a b hab
    exact ULift.ext _ _ (nsmul_right_injective hn (congrArg ULift.down hab))

  have hTF_FZ : isTF FZ := by
    intro n hn
    let C_const := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    letI : C_const.IsLeftAdjoint := adjZ.isLeftAdjoint
    letI : CategoryTheory.Limits.PreservesFiniteLimits C_const :=
      CategoryTheory.Limits.comp_preservesFiniteLimits
        (CategoryTheory.Functor.const (S.Etale)ᵒᵖ)
        (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u})
    letI : C_const.Additive := C_const.additive_of_preserves_binary_products
    have _ : CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id AZ) := hMonoAZ n hn
    have hmap : C_const.map (n • CategoryTheory.CategoryStruct.id AZ) =
        n • CategoryTheory.CategoryStruct.id FZ := by
      rw [C_const.map_nsmul, C_const.map_id]
    rw [← hmap]
    exact C_const.map_mono _

  have hTF_sub : ∀ {K' P : C_Z} (ι : K' ⟶ P) [CategoryTheory.Mono ι], isTF P → isTF K' := by
    intro K' P ι _ hP n hn
    have _ : CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id P) := hP n hn
    have _ : CategoryTheory.Mono (ι ≫ (n • CategoryTheory.CategoryStruct.id P)) :=
      CategoryTheory.mono_comp _ _
    have hfac : (n • CategoryTheory.CategoryStruct.id K') ≫ ι =
        ι ≫ (n • CategoryTheory.CategoryStruct.id P) := by
      rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
    exact CategoryTheory.mono_of_mono_fac hfac

  have hTF_epi : ∀ (E_sh : C_Z), ∃ (P_sh : C_Z) (q : P_sh ⟶ E_sh), CategoryTheory.Epi q ∧ isTF P_sh := by
    let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology S
    let C_aff := CategoryTheory.Sheaf J_aff AddCommGrpCat.{u}
    let I₀ : Type u := CategoryTheory.SmallModel.{u} S.AffineEtale
    let e_aff := CategoryTheory.equivSmallModel.{u} S.AffineEtale
    let W_aff : I₀ → S.AffineEtale := fun i => e_aff.inverse.obj i
    let Y_aff : I₀ → C_aff := fun i => CategoryTheory.Sheaf.freeYoneda J_aff (W_aff i) AZ
    have hY_tf : ∀ (i : I₀) (n : ℕ), n ≠ 0 →
        CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id (Y_aff i)) := by
      intro i n hn
      have hZ := hMonoAZ n hn
      let P₀ := CategoryTheory.Presheaf.freeYoneda (W_aff i) AZ
      have _ : ∀ X : (S.AffineEtale)ᵒᵖ,
          CategoryTheory.Mono ((n • CategoryTheory.CategoryStruct.id P₀).app X) := by
        intro X
        change CategoryTheory.Mono
          (n • CategoryTheory.CategoryStruct.id
            (Limits.sigmaObj (fun _ : (Opposite.unop X ⟶ W_aff i) => AZ)))
        let I_X : Type u := (Opposite.unop X ⟶ W_aff i)
        let D : Discrete I_X ⥤ AddCommGrpCat.{u} := Discrete.functor (fun _ => AZ)
        let φ : D ⟶ D := Discrete.natTrans (fun _ => n • CategoryTheory.CategoryStruct.id AZ)
        have _ : ∀ j : Discrete I_X, CategoryTheory.Mono (φ.app j) := fun _ => hZ
        have _ : CategoryTheory.Mono φ := NatTrans.mono_of_mono_app φ
        let hc := Limits.colimit.isColimit D
        refine Limits.colim.map_mono' φ hc hc _ (fun j => ?_)
        change Limits.Sigma.ι _ j.as ≫ (n • CategoryTheory.CategoryStruct.id _) =
          (n • CategoryTheory.CategoryStruct.id _) ≫ Limits.Sigma.ι _ j.as
        rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
      have _ : CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id P₀) :=
        NatTrans.mono_of_mono_app _
      let sh := CategoryTheory.presheafToSheaf J_aff AddCommGrpCat.{u}
      letI : sh.IsLeftAdjoint :=
        (CategoryTheory.sheafificationAdjunction J_aff AddCommGrpCat.{u}).isLeftAdjoint
      letI : sh.Additive := sh.additive_of_preserves_binary_products
      have hmap : sh.map (n • CategoryTheory.CategoryStruct.id P₀) =
          n • CategoryTheory.CategoryStruct.id (Y_aff i) := by
        rw [sh.map_nsmul, sh.map_id]
        rfl
      rw [← hmap]
      exact sh.map_mono _
    obtain ⟨G₀, ι₀, desc₀, hι_desc₀, _, hG₀_tf⟩ := (hGrothPkg C_aff).1 Y_aff hY_tf
    have hG₀_sep : ∀ {A B : C_aff} (f₁ f₂ : A ⟶ B),
        (∀ h : G₀ ⟶ A, h ≫ f₁ = h ≫ f₂) → f₁ = f₂ := by
      intro A B f₁ f₂ hall
      ext U x
      let i_U : I₀ := e_aff.functor.obj U.unop
      let isoU : W_aff i_U ≅ U.unop := (e_aff.unitIso.app U.unop).symm
      let x' : ↥(A.obj.obj (Opposite.op (W_aff i_U))) :=
        (A.obj.map isoU.hom.op).hom x
      let g_sec : AZ ⟶ A.obj.obj (Opposite.op (W_aff i_U)) :=
        AddCommGrpCat.ofHom
          { toFun := fun z => z.down • x'
            map_zero' := by simp
            map_add' := fun z₁ z₂ => add_zsmul x' z₁.down z₂.down }
      let h_i : Y_aff i_U ⟶ A := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm g_sec
      classical
      let h_tot : G₀ ⟶ A := desc₀ (fun j => if hj : j = i_U then eqToHom (by subst hj; rfl) ≫ h_i else 0)
      have hcomp_eq : h_i ≫ f₁ = h_i ≫ f₂ := by
        have h1 : ι₀ i_U ≫ h_tot = h_i := by
          rw [hι_desc₀]
          simp
        rw [← h1, Category.assoc, Category.assoc, hall h_tot]
      have hfree_comp : ∀ {D_sh : C_aff} (u_mor : A ⟶ D_sh),
          CategoryTheory.Sheaf.freeYonedaHomEquiv (h_i ≫ u_mor) =
            g_sec ≫ u_mor.hom.app (Opposite.op (W_aff i_U)) := by
        intro D_sh u_mor
        let adj_aff := CategoryTheory.sheafificationAdjunction J_aff AddCommGrpCat.{u}
        let sh_aff := CategoryTheory.presheafToSheaf J_aff AddCommGrpCat.{u}
        let h_i' : sh_aff.obj (CategoryTheory.Presheaf.freeYoneda (W_aff i_U) AZ) ⟶ A := h_i
        have hnat_aff := adj_aff.homEquiv_naturality_right h_i' u_mor
        have hdef : ∀ {E_sh : C_aff} (w : Y_aff i_U ⟶ E_sh),
            CategoryTheory.Sheaf.freeYonedaHomEquiv w =
              CategoryTheory.Presheaf.freeYonedaHomEquiv
                ((adj_aff.homEquiv (CategoryTheory.Presheaf.freeYoneda (W_aff i_U) AZ) E_sh) w) :=
          fun _ => rfl
        rw [hdef (h_i ≫ u_mor)]
        change CategoryTheory.Presheaf.freeYonedaHomEquiv
            ((adj_aff.homEquiv (CategoryTheory.Presheaf.freeYoneda (W_aff i_U) AZ) D_sh)
              (h_i' ≫ u_mor)) = _
        rw [hnat_aff]
        change CategoryTheory.Presheaf.freeYonedaHomEquiv
            ((adj_aff.homEquiv _ A) h_i ≫ u_mor.hom) = _
        rw [CategoryTheory.Presheaf.freeYonedaHomEquiv_comp, ← hdef h_i,
          Equiv.apply_symm_apply]
      have hsec_eq := congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv hcomp_eq
      rw [hfree_comp f₁, hfree_comp f₂] at hsec_eq
      have heval := ConcreteCategory.congr_hom hsec_eq (ULift.up (1 : ℤ))
      have hx'_eq : (f₁.hom.app (Opposite.op (W_aff i_U))).hom x' =
          (f₂.hom.app (Opposite.op (W_aff i_U))).hom x' := by
        simpa [g_sec, one_zsmul] using heval
      have hx_back : ∀ (f : A ⟶ B),
          (f.hom.app U).hom x =
            (B.obj.map isoU.inv.op).hom ((f.hom.app (Opposite.op (W_aff i_U))).hom x') := by
        intro f
        have hnat := ConcreteCategory.congr_hom (f.hom.naturality isoU.hom.op) x
        have hnat' : (f.hom.app (Opposite.op (W_aff i_U))).hom x' =
            (B.obj.map isoU.hom.op).hom ((f.hom.app U).hom x) := hnat
        rw [hnat']
        have hid : B.obj.map isoU.hom.op ≫ B.obj.map isoU.inv.op = 𝟙 _ := by
          rw [← B.obj.map_comp, ← op_comp, isoU.inv_hom_id, op_id, B.obj.map_id]
        exact (ConcreteCategory.congr_hom hid ((f.hom.app U).hom x)).symm
      rw [hx_back f₁, hx_back f₂, hx'_eq]
    let E_eqv := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv S AddCommGrpCat.{u}
    let G_tf : C_Z := E_eqv.functor.obj G₀
    have hG_tf : isTF G_tf := by
      intro n hn
      have _ : CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id G₀) := hG₀_tf n hn
      letI : E_eqv.functor.Additive := E_eqv.functor.additive_of_preserves_binary_products
      have hmap : E_eqv.functor.map (n • CategoryTheory.CategoryStruct.id G₀) =
          n • CategoryTheory.CategoryStruct.id G_tf := by
        rw [E_eqv.functor.map_nsmul, E_eqv.functor.map_id]
      rw [← hmap]
      exact E_eqv.functor.map_mono _
    have hG_sep : ∀ {A B : C_Z} (f₁ f₂ : A ⟶ B),
        (∀ h : G_tf ⟶ A, h ≫ f₁ = h ≫ f₂) → f₁ = f₂ := by
      intro A B f₁ f₂ hall
      apply E_eqv.inverse.map_injective
      apply hG₀_sep
      intro h₀
      let adjE := E_eqv.toAdjunction
      let h₁ : G_tf ⟶ A := (adjE.homEquiv G₀ A).symm h₀
      have heq := congrArg (adjE.homEquiv G₀ B) (hall h₁)
      rw [adjE.homEquiv_naturality_right, adjE.homEquiv_naturality_right,
        Equiv.apply_symm_apply] at heq
      exact heq
    exact (hGrothPkg C_Z).2 G_tf hG_tf hG_sep

  
  have hInjEfface : ∀ (I_sh : C_R) [CategoryTheory.Injective I_sh] (p : ℕ) (K_sh : C_Z),
      isTF K_sh → ∀ (e : CategoryTheory.Abelian.Ext.{u} K_sh (U_of.obj I_sh) (p + 1)), e = 0 := by
    intro I_sh _ p
    have hm_I : m • CategoryTheory.CategoryStruct.id (U_of.obj I_sh) = 0 := by
      have hm_R : m • CategoryTheory.CategoryStruct.id I_sh = 0 := by
        ext W y
        change m • y = 0
        have hm0 : ((m : ℕ) : R) = 0 := ULift.ext _ _ (ZMod.natCast_self m)
        rw [← Nat.cast_smul_eq_nsmul R m y, hm0, zero_smul]
      have hmap : U_of.map (m • CategoryTheory.CategoryStruct.id I_sh) =
          m • CategoryTheory.CategoryStruct.id (U_of.obj I_sh) := by
        rw [U_of.map_nsmul, U_of.map_id]
      rw [← hmap, hm_R, Functor.map_zero]

    have hSnakeExt : ∀ {K' P_sh K_sh : C_Z} {ι : K' ⟶ P_sh} {π : P_sh ⟶ K_sh} {h0 : ι ≫ π = 0},
        (CategoryTheory.ShortComplex.mk ι π h0).ShortExact →
        isTF K_sh →
        ∀ (g₀ : K' ⟶ U_of.obj I_sh), ∃ h : P_sh ⟶ U_of.obj I_sh, ι ≫ h = g₀ := by
      intro K' P_sh K_sh ι π h0 hSE hTF_K g₀
      let Kbar := CategoryTheory.Limits.cokernel (m • CategoryTheory.CategoryStruct.id K')
      let pK : K' ⟶ Kbar := CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id K')
      let Pbar := CategoryTheory.Limits.cokernel (m • CategoryTheory.CategoryStruct.id P_sh)
      let pP : P_sh ⟶ Pbar := CategoryTheory.Limits.cokernel.π (m • CategoryTheory.CategoryStruct.id P_sh)
      have hι_cond : (m • CategoryTheory.CategoryStruct.id K') ≫ (ι ≫ pP) = 0 := by
        calc
          (m • CategoryTheory.CategoryStruct.id K') ≫ (ι ≫ pP)
            = ((m • CategoryTheory.CategoryStruct.id K') ≫ ι) ≫ pP := (Category.assoc _ _ _).symm
          _ = (ι ≫ (m • CategoryTheory.CategoryStruct.id P_sh)) ≫ pP := by
              rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
          _ = ι ≫ ((m • CategoryTheory.CategoryStruct.id P_sh) ≫ pP) := Category.assoc _ _ _
          _ = 0 := by rw [CategoryTheory.Limits.cokernel.condition, Limits.comp_zero]
      let ιbar : Kbar ⟶ Pbar :=
        CategoryTheory.Limits.cokernel.desc (m • CategoryTheory.CategoryStruct.id K') (ι ≫ pP) hι_cond
      have hp_ιbar : pK ≫ ιbar = ι ≫ pP := CategoryTheory.Limits.cokernel.π_desc _ _ _
      have hMono_ιbar : CategoryTheory.Mono ιbar := by
        apply CategoryTheory.Abelian.Pseudoelement.mono_of_zero_of_map_zero
        intro abar habar
        obtain ⟨a, rfl⟩ := CategoryTheory.Abelian.Pseudoelement.pseudo_surjective_of_epi pK abar
        have hpPa : CategoryTheory.Abelian.Pseudoelement.pseudoApply pP
            (CategoryTheory.Abelian.Pseudoelement.pseudoApply ι a) = 0 := by
          rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply, ← hp_ιbar,
            CategoryTheory.Abelian.Pseudoelement.comp_apply]
          exact habar
        obtain ⟨b, hb⟩ := CategoryTheory.Abelian.Pseudoelement.pseudo_exact_of_exact
          (CategoryTheory.ShortComplex.exact_cokernel (m • CategoryTheory.CategoryStruct.id P_sh))
          _ hpPa
        have hmK_πb : CategoryTheory.Abelian.Pseudoelement.pseudoApply
            (m • CategoryTheory.CategoryStruct.id K_sh)
            (CategoryTheory.Abelian.Pseudoelement.pseudoApply π b) = 0 := by
          have hcomm : π ≫ (m • CategoryTheory.CategoryStruct.id K_sh) =
              (m • CategoryTheory.CategoryStruct.id P_sh) ≫ π := by
            rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
          rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply, hcomm,
            CategoryTheory.Abelian.Pseudoelement.comp_apply, hb,
            ← CategoryTheory.Abelian.Pseudoelement.comp_apply, h0,
            CategoryTheory.Abelian.Pseudoelement.zero_apply]
        have _ : CategoryTheory.Mono (m • CategoryTheory.CategoryStruct.id K_sh) := hTF_K m hm_ne
        have hπb0 : CategoryTheory.Abelian.Pseudoelement.pseudoApply π b = 0 :=
          CategoryTheory.Abelian.Pseudoelement.zero_of_map_zero _
            (CategoryTheory.Abelian.Pseudoelement.pseudo_injective_of_mono _) _ hmK_πb
        obtain ⟨c, hc⟩ :=
          CategoryTheory.Abelian.Pseudoelement.pseudo_exact_of_exact hSE.exact b hπb0
        have hι_eq : CategoryTheory.Abelian.Pseudoelement.pseudoApply ι
            (CategoryTheory.Abelian.Pseudoelement.pseudoApply
              (m • CategoryTheory.CategoryStruct.id K') c) =
            CategoryTheory.Abelian.Pseudoelement.pseudoApply ι a := by
          have hcomm : (m • CategoryTheory.CategoryStruct.id K') ≫ ι =
              ι ≫ (m • CategoryTheory.CategoryStruct.id P_sh) := by
            rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
          rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply, hcomm,
            CategoryTheory.Abelian.Pseudoelement.comp_apply, hc, hb]
        have _ : CategoryTheory.Mono ι := hSE.mono_f
        have ha_eq : CategoryTheory.Abelian.Pseudoelement.pseudoApply
            (m • CategoryTheory.CategoryStruct.id K') c = a :=
          CategoryTheory.Abelian.Pseudoelement.pseudo_injective_of_mono ι hι_eq
        rw [← ha_eq, ← CategoryTheory.Abelian.Pseudoelement.comp_apply,
          CategoryTheory.Limits.cokernel.condition,
          CategoryTheory.Abelian.Pseudoelement.zero_apply]
      have hTor_Kbar : m • CategoryTheory.CategoryStruct.id Kbar = 0 := by
        rw [← CategoryTheory.cancel_epi pK, Preadditive.comp_nsmul, Category.comp_id,
          ← Category.id_comp pK, ← Preadditive.nsmul_comp,
          CategoryTheory.Limits.cokernel.condition, Limits.comp_zero]
      have hTor_Pbar : m • CategoryTheory.CategoryStruct.id Pbar = 0 := by
        rw [← CategoryTheory.cancel_epi pP, Preadditive.comp_nsmul, Category.comp_id,
          ← Category.id_comp pP, ← Preadditive.nsmul_comp,
          CategoryTheory.Limits.cokernel.condition, Limits.comp_zero]
      have hg₀_cond : (m • CategoryTheory.CategoryStruct.id K') ≫ g₀ = 0 := by
        rw [Preadditive.nsmul_comp, Category.id_comp, ← Category.comp_id g₀,
          ← Preadditive.comp_nsmul, hm_I, Limits.comp_zero]
      let gbar : Kbar ⟶ U_of.obj I_sh :=
        CategoryTheory.Limits.cokernel.desc (m • CategoryTheory.CategoryStruct.id K') g₀ hg₀_cond
      have hp_gbar : pK ≫ gbar = g₀ := CategoryTheory.Limits.cokernel.π_desc _ _ _
      obtain ⟨Kmod, hKmod⟩ := hLiftSheaf Kbar hTor_Kbar
      obtain ⟨Pmod, hPmod⟩ := hLiftSheaf Pbar hTor_Pbar
      let ιbar' : U_of.obj Kmod ⟶ U_of.obj Pmod :=
        eqToHom hKmod ≫ ιbar ≫ eqToHom hPmod.symm
      let gbar' : U_of.obj Kmod ⟶ U_of.obj I_sh := eqToHom hKmod ≫ gbar
      have _ : CategoryTheory.Mono ιbar := hMono_ιbar
      have _ : CategoryTheory.Mono (ιbar ≫ eqToHom hPmod.symm) :=
        CategoryTheory.mono_comp ιbar (eqToHom hPmod.symm)
      have _ : CategoryTheory.Mono ιbar' :=
        CategoryTheory.mono_comp (eqToHom hKmod) (ιbar ≫ eqToHom hPmod.symm)
      obtain ⟨ι_mod, hι_mod⟩ := hUFull ιbar'
      obtain ⟨g_mod, hg_mod⟩ := hUFull gbar'
      have _ : CategoryTheory.Mono ι_mod := by
        refine ⟨fun {W} u₁ u₂ hu => hUFaith ?_⟩
        have h1 : U_of.map u₁ ≫ ιbar' = U_of.map u₂ ≫ ιbar' := by
          rw [← hι_mod, ← Functor.map_comp, ← Functor.map_comp, hu]
        exact (CategoryTheory.cancel_mono ιbar').mp h1
      let h_mod : Pmod ⟶ I_sh := CategoryTheory.Injective.factorThru g_mod ι_mod
      have hfac_mod : ι_mod ≫ h_mod = g_mod := CategoryTheory.Injective.comp_factorThru g_mod ι_mod
      refine ⟨pP ≫ eqToHom hPmod.symm ≫ U_of.map h_mod, ?_⟩
      calc
        ι ≫ pP ≫ eqToHom hPmod.symm ≫ U_of.map h_mod
          = (ι ≫ pP) ≫ eqToHom hPmod.symm ≫ U_of.map h_mod := (Category.assoc _ _ _).symm
        _ = (pK ≫ ιbar) ≫ eqToHom hPmod.symm ≫ U_of.map h_mod := by rw [hp_ιbar]
        _ = pK ≫ eqToHom hKmod.symm ≫ (eqToHom hKmod ≫ ιbar ≫ eqToHom hPmod.symm) ≫ U_of.map h_mod := by
            simp only [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
        _ = pK ≫ eqToHom hKmod.symm ≫ U_of.map ι_mod ≫ U_of.map h_mod := by
            rw [hι_mod]
        _ = pK ≫ eqToHom hKmod.symm ≫ U_of.map g_mod := by
            rw [← Functor.map_comp, hfac_mod]
        _ = pK ≫ eqToHom hKmod.symm ≫ (eqToHom hKmod ≫ gbar) := by rw [hg_mod]
        _ = pK ≫ gbar := by simp only [eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
        _ = g₀ := hp_gbar

    let R_G := CategoryTheory.InjectiveResolution.of (U_of.obj I_sh)
    induction p with
    | zero =>
      intro K_sh hTF_K e
      obtain ⟨f, hf, rfl⟩ := R_G.extMk_surjective e 2 rfl
      have hEx_X1 := R_G.exact_succ 0
      let Z₁ := CategoryTheory.Limits.kernel (R_G.cocomplex.d 1 2)
      let q₀ : R_G.cocomplex.X 0 ⟶ Z₁ :=
        CategoryTheory.Limits.kernel.lift (R_G.cocomplex.d 1 2) (R_G.cocomplex.d 0 1)
          (R_G.cocomplex.d_comp_d 0 1 2)
      have _ : CategoryTheory.Epi q₀ := CategoryTheory.ShortComplex.Exact.epi_kernelLift hEx_X1
      let f_Z : K_sh ⟶ Z₁ := CategoryTheory.Limits.kernel.lift (R_G.cocomplex.d 1 2) f hf
      let E_pb := CategoryTheory.Limits.pullback q₀ f_Z
      have _ : CategoryTheory.Epi (CategoryTheory.Limits.pullback.snd q₀ f_Z) :=
        CategoryTheory.Abelian.epi_pullback_of_epi_f q₀ f_Z
      obtain ⟨P_sh, q_E, _, hTF_P⟩ := hTF_epi E_pb
      let π : P_sh ⟶ K_sh := q_E ≫ CategoryTheory.Limits.pullback.snd q₀ f_Z
      have _ : CategoryTheory.Epi π := CategoryTheory.epi_comp _ _
      let g : P_sh ⟶ R_G.cocomplex.X 0 := q_E ≫ CategoryTheory.Limits.pullback.fst q₀ f_Z
      have hg_comm : g ≫ R_G.cocomplex.d 0 1 = π ≫ f := by
        calc
          g ≫ R_G.cocomplex.d 0 1
            = q_E ≫ CategoryTheory.Limits.pullback.fst q₀ f_Z ≫
                (q₀ ≫ CategoryTheory.Limits.kernel.ι (R_G.cocomplex.d 1 2)) := by
                rw [CategoryTheory.Limits.kernel.lift_ι]; exact Category.assoc _ _ _
          _ = q_E ≫ (CategoryTheory.Limits.pullback.fst q₀ f_Z ≫ q₀) ≫
                CategoryTheory.Limits.kernel.ι (R_G.cocomplex.d 1 2) := by
                simp only [Category.assoc]
          _ = q_E ≫ (CategoryTheory.Limits.pullback.snd q₀ f_Z ≫ f_Z) ≫
                CategoryTheory.Limits.kernel.ι (R_G.cocomplex.d 1 2) := by
                rw [CategoryTheory.Limits.pullback.condition]
          _ = π ≫ f := by
                simp only [π, f_Z, Category.assoc, CategoryTheory.Limits.kernel.lift_ι]
      let K' := CategoryTheory.Limits.kernel π
      let ι : K' ⟶ P_sh := CategoryTheory.Limits.kernel.ι π
      let S_π := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.kernel.condition π)
      have hS_π : S_π.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_kernel π
          mono_f := CategoryTheory.Limits.equalizer.ι_mono
          epi_g := inferInstance }
      have hιg_cond : (ι ≫ g) ≫ R_G.cocomplex.d 0 1 = 0 := by
        rw [Category.assoc, hg_comm, ← Category.assoc,
          CategoryTheory.Limits.kernel.condition, Limits.zero_comp]
      have hEx0 := R_G.exact₀
      have _ : CategoryTheory.Mono (R_G.ι.f 0) := inferInstance
      let iso0 := HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 (U_of.obj I_sh)
      let hKer0 := hEx0.fIsKernel
      let g₀_raw : K' ⟶ ((CochainComplex.single₀ C_Z).obj (U_of.obj I_sh)).X 0 :=
        CategoryTheory.Limits.Fork.IsLimit.lift hKer0 (ι ≫ g)
          (by rw [hιg_cond, Limits.comp_zero])
      have hg₀_fac : g₀_raw ≫ R_G.ι.f 0 = ι ≫ g :=
        CategoryTheory.Limits.Fork.IsLimit.lift_ι hKer0
      obtain ⟨h, hh⟩ := hSnakeExt hS_π hTF_K (g₀_raw ≫ iso0.hom)
      let h_raw : P_sh ⟶ ((CochainComplex.single₀ C_Z).obj (U_of.obj I_sh)).X 0 :=
        h ≫ iso0.inv
      have hh_raw : ι ≫ h_raw = g₀_raw := by
        dsimp only [h_raw]
        rw [← Category.assoc, hh, Category.assoc, iso0.hom_inv_id, Category.comp_id]
      let g' : P_sh ⟶ R_G.cocomplex.X 0 := g - h_raw ≫ R_G.ι.f 0
      have hιg' : ι ≫ g' = 0 := by
        change ι ≫ g - ι ≫ (h_raw ≫ R_G.ι.f 0) = 0
        rw [← Category.assoc ι h_raw, hh_raw, hg₀_fac, sub_self]
      let hCok := hS_π.gIsCokernel
      let s : K_sh ⟶ R_G.cocomplex.X 0 :=
        CategoryTheory.Limits.Cofork.IsColimit.desc hCok g'
          (by rw [hιg', Limits.zero_comp])
      have hs_fac : π ≫ s = g' := CategoryTheory.Limits.Cofork.IsColimit.π_desc hCok
      have hι0_d0 : R_G.ι.f 0 ≫ R_G.cocomplex.d 0 1 = 0 :=
        (fun {Sc : CategoryTheory.ShortComplex C_Z} (_ : Sc.Exact) => Sc.zero) hEx0
      have hs_d : s ≫ R_G.cocomplex.d 0 1 = f := by
        rw [← CategoryTheory.cancel_epi π, ← Category.assoc, hs_fac]
        change (g - h_raw ≫ R_G.ι.f 0) ≫ R_G.cocomplex.d 0 1 = π ≫ f
        rw [Preadditive.sub_comp, hg_comm, Category.assoc h_raw, hι0_d0, Limits.comp_zero, sub_zero]
      exact (R_G.extMk_eq_zero_iff f 2 rfl hf 0 rfl).mpr ⟨s, hs_d⟩
    | succ p' ih =>
      intro K_sh hTF_K e
      obtain ⟨f, hf, rfl⟩ := R_G.extMk_surjective e (p' + 3) rfl
      have hEx_Xp := R_G.exact_succ (p' + 1)
      let Z_p := CategoryTheory.Limits.kernel (R_G.cocomplex.d (p' + 2) (p' + 3))
      let q_p : R_G.cocomplex.X (p' + 1) ⟶ Z_p :=
        CategoryTheory.Limits.kernel.lift (R_G.cocomplex.d (p' + 2) (p' + 3))
          (R_G.cocomplex.d (p' + 1) (p' + 2))
          (R_G.cocomplex.d_comp_d (p' + 1) (p' + 2) (p' + 3))
      have _ : CategoryTheory.Epi q_p := CategoryTheory.ShortComplex.Exact.epi_kernelLift hEx_Xp
      let f_Z : K_sh ⟶ Z_p :=
        CategoryTheory.Limits.kernel.lift (R_G.cocomplex.d (p' + 2) (p' + 3)) f hf
      let E_pb := CategoryTheory.Limits.pullback q_p f_Z
      have _ : CategoryTheory.Epi (CategoryTheory.Limits.pullback.snd q_p f_Z) :=
        CategoryTheory.Abelian.epi_pullback_of_epi_f q_p f_Z
      obtain ⟨P_sh, q_E, _, hTF_P⟩ := hTF_epi E_pb
      let π : P_sh ⟶ K_sh := q_E ≫ CategoryTheory.Limits.pullback.snd q_p f_Z
      have _ : CategoryTheory.Epi π := CategoryTheory.epi_comp _ _
      let g : P_sh ⟶ R_G.cocomplex.X (p' + 1) := q_E ≫ CategoryTheory.Limits.pullback.fst q_p f_Z
      have hg_comm : g ≫ R_G.cocomplex.d (p' + 1) (p' + 2) = π ≫ f := by
        calc
          g ≫ R_G.cocomplex.d (p' + 1) (p' + 2)
            = q_E ≫ CategoryTheory.Limits.pullback.fst q_p f_Z ≫
                (q_p ≫ CategoryTheory.Limits.kernel.ι (R_G.cocomplex.d (p' + 2) (p' + 3))) := by
                rw [CategoryTheory.Limits.kernel.lift_ι]; exact Category.assoc _ _ _
          _ = q_E ≫ (CategoryTheory.Limits.pullback.fst q_p f_Z ≫ q_p) ≫
                CategoryTheory.Limits.kernel.ι (R_G.cocomplex.d (p' + 2) (p' + 3)) := by
                simp only [Category.assoc]
          _ = q_E ≫ (CategoryTheory.Limits.pullback.snd q_p f_Z ≫ f_Z) ≫
                CategoryTheory.Limits.kernel.ι (R_G.cocomplex.d (p' + 2) (p' + 3)) := by
                rw [CategoryTheory.Limits.pullback.condition]
          _ = π ≫ f := by
                simp only [π, f_Z, Category.assoc, CategoryTheory.Limits.kernel.lift_ι]
      have hπ_zero : (CategoryTheory.Abelian.Ext.mk₀ π).comp
          (R_G.extMk f (p' + 3) rfl hf) (Nat.zero_add (p' + 2)) = 0 := by
        rw [R_G.mk₀_comp_extMk]
        exact (R_G.extMk_eq_zero_iff (π ≫ f) (p' + 3) rfl _ (p' + 1) rfl).mpr ⟨g, hg_comm⟩
      let K' := CategoryTheory.Limits.kernel π
      let ι : K' ⟶ P_sh := CategoryTheory.Limits.kernel.ι π
      have _ : CategoryTheory.Mono ι := CategoryTheory.Limits.equalizer.ι_mono
      have hTF_K' : isTF K' := hTF_sub ι hTF_P
      let S_π := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.kernel.condition π)
      have hS_π : S_π.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_kernel π
