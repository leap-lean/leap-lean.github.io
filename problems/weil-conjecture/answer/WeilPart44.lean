              (((ℓ : Padic ℓ) ^ (k₁ + k₂))⁻¹) • B_int w_sum :=
            hScaleIndep _ (k₁ + k₂) _ w_sum (vecOf (ψ₁ + ψ₂).1)
              (Classical.choose_spec (Classical.choose_spec (hLiftΨ (ψ₁ + ψ₂)))) hw_sum
          change (((ℓ : Padic ℓ) ^ (Classical.choose (hLiftΨ (ψ₁ + ψ₂))))⁻¹) •
              B_int (Classical.choose (Classical.choose_spec (hLiftΨ (ψ₁ + ψ₂)))) = _
          rw [heq_sum, heq₁, heq₂]
          dsimp [w_sum]
          rw [hB_int_add, hB_int_smul, hB_int_smul, map_pow, map_pow, halg_ℓ]
