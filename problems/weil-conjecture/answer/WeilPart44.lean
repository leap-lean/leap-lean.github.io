    have hFree_Q0 : Module.Free Λ (Fin m₀ → R) := Module.Free.of_equiv (e_fin_Q m₀).symm
    have hFin_Q0 : Module.Finite Λ (Fin m₀ → R) := Module.Finite.equiv (e_fin_Q m₀).symm
    let e₀_Λ : (Fin m₀ → R) →ₗ[Λ] (Fin m₀ → R) := e₀.restrictScalars Λ
    let P₀_sub : Submodule Λ (Fin m₀ → R) := LinearMap.range e₀_Λ
    have hP₀_mem : ∀ u : Fin m₀ → R, u ∈ P₀_sub ↔ e₀ u = u := by
      intro u
      constructor
