      _ = (v_aff ≫ q_left) ≫ (CategoryTheory.Limits.pullback.snd h_W pr_D ≫ pr_D) := by
          simp only [CategoryTheory.Category.assoc]
      _ = (v_aff ≫ q_left) ≫ (π_W ≫ h_W) := by rw [← CategoryTheory.Limits.pullback.condition]
      _ = ((v_aff ≫ q_left) ≫ π_W) ≫ h_W := by simp only [CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₀ A)) ≫ (j_C₀ ≫ h_W) := by
          rw [hv_q_fst, CategoryTheory.Category.assoc]
  let φ_kA : k →+* A := (AlgebraicGeometry.Spec.preimage ((v_aff ≫ h_Z) ≫ pr_k)).hom
  letI : Algebra k A := φ_kA.toAlgebra
  have hv_prk : (v_aff ≫ h_Z) ≫ pr_k =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)) :=
    (AlgebraicGeometry.Spec.map_preimage ((v_aff ≫ h_Z) ≫ pr_k)).symm
  letI : Algebra F A := ((algebraMap C₀ A).comp (algebraMap F C₀)).toAlgebra
  haveI : IsScalarTower F C₀ A := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hFkA_eq : (algebraMap k A).comp (algebraMap F k) =
      (algebraMap C₀ A).comp (algebraMap F C₀) := by
    have hmap_eq : AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((algebraMap k A).comp (algebraMap F k))) =
        AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((algebraMap C₀ A).comp (algebraMap F C₀))) := by
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
        CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, ← hv_prk, ← hj_hom]
      calc ((v_aff ≫ h_Z) ≫ pr_k) ≫ f_ext
          = (v_aff ≫ h_Z) ≫ (pr_k ≫ f_ext) := by simp only [CategoryTheory.Category.assoc]
        _ = (v_aff ≫ h_Z) ≫ (pr_D ≫ D_hom) := by rw [← CategoryTheory.Limits.pullback.condition]
        _ = ((v_aff ≫ h_Z) ≫ pr_D) ≫ D_hom := by simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₀ A)) ≫
              ((j_C₀ ≫ h_W) ≫ D_hom) := by rw [hv_prD, CategoryTheory.Category.assoc]
    exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hmap_eq)
  haveI : IsScalarTower F k A :=
    IsScalarTower.of_algebraMap_eq (fun f => (RingHom.congr_fun hFkA_eq f).symm)
  let ψ_CkA : TensorProduct F C₀ k →ₐ[F] A :=
    Algebra.TensorProduct.lift
      (IsScalarTower.toAlgHom F C₀ A)
      (IsScalarTower.toAlgHom F k A)
      (fun _ _ => Commute.all _ _)
  letI : Algebra (TensorProduct F C₀ k) A := ψ_CkA.toRingHom.toAlgebra
  have hAlg_CkA : ∀ (c : C₀) (x : k),
      algebraMap (TensorProduct F C₀ k) A (TensorProduct.tmul F c x) =
        algebraMap C₀ A c * algebraMap k A x :=
    fun c x => Algebra.TensorProduct.lift_tmul _ _ _ c x
  let p_L : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F C₀ k)) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of C₀) :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := F) (A := C₀) (B := k)))
  let p_R : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F C₀ k)) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := F) (A := C₀) (B := k)).toRingHom)
  have hpb_spec : CategoryTheory.IsPullback p_L p_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F C₀))) f_ext :=
    CategoryTheory.IsPullback.of_iso_pullback
      (CategoryTheory.CommSq.mk (by
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        congr 2; ext r
        exact (Algebra.TensorProduct.includeLeft (R := F) (S := F) (A := C₀) (B := k)).commutes r
          |>.trans
          ((Algebra.TensorProduct.includeRight (R := F) (A := C₀) (B := k)).commutes r).symm))
      (AlgebraicGeometry.pullbackSpecIso F C₀ k).symm
      (AlgebraicGeometry.pullbackSpecIso_inv_fst F C₀ k)
      (AlgebraicGeometry.pullbackSpecIso_inv_snd F C₀ k)
  have hpb_outer : CategoryTheory.IsPullback p_L p_R ((j_C₀ ≫ h_W) ≫ D_hom) f_ext := by
    rwa [hj_hom]
  let s_Ck : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F C₀ k)) ⟶ S_bar :=
    CategoryTheory.Limits.pullback.lift (p_L ≫ (j_C₀ ≫ h_W)) p_R
      (by rw [CategoryTheory.Category.assoc]; exact hpb_outer.w)
  have hs_prD : s_Ck ≫ pr_D = p_L ≫ (j_C₀ ≫ h_W) :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hs_prk : s_Ck ≫ pr_k = p_R :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hpb_left : CategoryTheory.IsPullback p_L s_Ck (j_C₀ ≫ h_W) pr_D := by
    refine CategoryTheory.IsPullback.flip ?_
    refine (CategoryTheory.IsPullback.paste_horiz_iff
      (CategoryTheory.IsPullback.of_hasPullback D_hom f_ext).flip hs_prD).mp ?_
    rw [hs_prk]
    exact hpb_outer.flip
  have hjW_et : AlgebraicGeometry.Etale (j_C₀ ≫ h_W) := inferInstance
  have hs_et : AlgebraicGeometry.Etale s_Ck :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_left hjW_et
  let f_ACk : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F C₀ k)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (TensorProduct F C₀ k) A))
  have hf_s_eq : f_ACk ≫ s_Ck = v_aff ≫ h_Z := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, hs_prD, ← CategoryTheory.Category.assoc f_ACk p_L,
        hv_prD]
      congr 1
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      ext c
      change algebraMap (TensorProduct F C₀ k) A (TensorProduct.tmul F c 1) = algebraMap C₀ A c
      rw [hAlg_CkA, map_one, mul_one]
    · rw [CategoryTheory.Category.assoc, hs_prk, hv_prk,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      ext x
      change algebraMap (TensorProduct F C₀ k) A (TensorProduct.tmul F 1 x) = algebraMap k A x
      rw [hAlg_CkA, map_one, one_mul]
  have hvZ_et : AlgebraicGeometry.Etale (v_aff ≫ h_Z) := inferInstance
  have hf_ACk_et : AlgebraicGeometry.Etale f_ACk :=
    CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      f_ACk s_Ck hs_et (by rwa [hf_s_eq])
  haveI : Algebra.Etale (TensorProduct F C₀ k) A :=
    RingHom.etale_algebraMap.mp
      ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hf_ACk_et)
  obtain ⟨A_sub, B₀, hCR_B₀, hAlg_B₀, hFG, hEt_B₀, ⟨e_AB⟩⟩ :=
    Algebra.Etale.exists_subalgebra_fg C₀ (TensorProduct F C₀ k) A
  letI : CommRing B₀ := hCR_B₀
  letI : Algebra ↥A_sub B₀ := hAlg_B₀
  haveI : Algebra.Etale ↥A_sub B₀ := hEt_B₀
  obtain ⟨E₁, hFD_E₁, j_sub, hS_sub_E₁, hj_sub⟩ := hSubfield C₀ A_sub hFG
  haveI : FiniteDimensional F ↥E₁ := hFD_E₁
  obtain ⟨A₁, hCR_A₁, hAlg_FA₁, hAlg_C₀A₁, hAlg_E₁A₁,
      hST_FC₀A₁, hST_FE₁A₁, hEt_C₀A₁, e_A1, he_tmul, he_C₀, he_E₁⟩ :=
    hBaseChange ↥E₁ k C₀ ↥A_sub B₀ A hAlg_CkA j_sub A_sub.val hj_sub e_AB
  exact ⟨C₀, A, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance,
    j_C₀, v_aff, z', E₁, hFD_E₁,
    A₁, hCR_A₁, hAlg_FA₁, hAlg_C₀A₁, hAlg_E₁A₁,
    hST_FC₀A₁, hST_FE₁A₁, hEt_C₀A₁, e_A1,
    hj_et, hj_hom, hv_et, hv_pt, hv_prD, hv_prk, hv_q_fst,
    hS_sub_E₁, he_tmul, he_C₀, he_E₁⟩

theorem weil_galois_diag_quotient_and_geom_tensor_iso (F k_L E k : Type u)
    [Field F] [Field k_L] [Field E] [Field k]
    [Algebra F k_L] [Algebra F E] [Algebra F k] [Algebra E k] [IsScalarTower F E k]
    (C₀ C₀_U R₀ B B_bar A_E A : Type u)
    [CommRing C₀] [Algebra F C₀]
    [CommRing R₀] [Algebra F R₀]
    [CommRing C₀_U] [Algebra F C₀_U] [Algebra C₀ C₀_U] [Algebra R₀ C₀_U]
    [IsScalarTower F C₀ C₀_U] [IsScalarTower F R₀ C₀_U]
    [CommRing B] [Algebra F B] [Algebra R₀ B] [IsScalarTower F R₀ B]
    [CommRing B_bar] [Algebra (TensorProduct F R₀ k) B_bar]
    [CommRing A_E] [Algebra F A_E] [Algebra C₀ A_E] [Algebra E A_E]
    [IsScalarTower F C₀ A_E] [IsScalarTower F E A_E]
    [CommRing A] [Algebra F A] [Algebra C₀ A] [Algebra k A]
    [IsScalarTower F C₀ A] [IsScalarTower F k A]
    [Algebra k_L B] [Algebra k_L k]
    [Algebra (TensorProduct F R₀ k) (TensorProduct C₀ C₀_U A)]
    (R_Er : Type u) [CommRing R_Er] [Algebra E R_Er]
    (e_REr : TensorProduct R₀ (TensorProduct C₀ C₀_U A_E) B ≃+* R_Er)
    (ι_kB : k_L →ₐ[F] B)
    (hAlg_kLB : ∀ c : k_L, algebraMap k_L B c = ι_kB c)
    (κ_E : k_L →ₐ[F] E)
    (κ_k : k_L →ₐ[F] k)
    (hAlg_kLk : ∀ c : k_L, algebraMap k_L k c = κ_k c)
    (hκ_Ek : ∀ c : k_L, algebraMap E k (κ_E c) = κ_k c)
    (hAlg_Pbar : ∀ (z : R₀) (c : k),
      algebraMap (TensorProduct F R₀ k) (TensorProduct C₀ C₀_U A) (TensorProduct.tmul F z c) =
        TensorProduct.tmul C₀ (algebraMap R₀ C₀_U z) (algebraMap k A c))
    (hAlg_ER : ∀ e : E,
      algebraMap E R_Er e =
        e_REr (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ 1 (algebraMap E A_E e)) 1))
    (res_k : (B ≃ₐ[R₀] B) →* (k_L ≃ₐ[F] k_L))
    (hres_comm : ∀ (σ : B ≃ₐ[R₀] B) (c : k_L), σ (ι_kB c) = ι_kB (res_k σ c))
    (m_k : ℕ) (equiv_Γk : Fin m_k ≃ (k_L ≃ₐ[F] k_L))
    (e_k : Fin m_k → TensorProduct F k_L k_L)
    (hIdemp_k :
      (∀ i : Fin m_k, e_k i * e_k i = e_k i) ∧
      (∀ i j : Fin m_k, i ≠ j → e_k i * e_k j = 0) ∧
      (∑ i : Fin m_k, e_k i) = 1 ∧
      (∀ i j : Fin m_k,
        Algebra.TensorProduct.lift (AlgHom.id k_L k_L) (equiv_Γk j).symm.toAlgHom
          (fun _ _ => mul_comm _ _) (e_k i) = if i = j then 1 else 0) ∧
      (∀ (i : Fin m_k) (z : TensorProduct F k_L k_L),
        z * e_k i = TensorProduct.tmul F
          (Algebra.TensorProduct.lift (AlgHom.id k_L k_L) (equiv_Γk i).symm.toAlgHom
            (fun _ _ => mul_comm _ _) z) (1 : k_L) * e_k i))
    (q_B : B →+* B_bar) (q_k : k →+* B_bar)
    (htmalg : ∀ (z : R₀) (c : k),
      algebraMap (TensorProduct F R₀ k) B_bar (TensorProduct.tmul F z c) =
        q_B (algebraMap R₀ B z) * q_k c)
    (ψ_Bk : TensorProduct k_L B k ≃+* B_bar)
    (hψ_Bk : ∀ (b : B) (c : k), ψ_Bk (TensorProduct.tmul k_L b c) = q_B b * q_k c)
    (e_AE : TensorProduct E A_E k ≃+* A)
    (he_AE_tmul : ∀ (a_E : A_E) (x : k),
      e_AE (TensorProduct.tmul E a_E x) =
        e_AE (TensorProduct.tmul E a_E 1) * algebraMap k A x)
    (he_AE_C₀ : ∀ c : C₀,
      e_AE (TensorProduct.tmul E (algebraMap C₀ A_E c) 1) = algebraMap C₀ A c)
    (he_AE_E : ∀ e : E,
      e_AE (TensorProduct.tmul E (algebraMap E A_E e) 1) = algebraMap k A (algebraMap E k e)) :
    let P_E := TensorProduct C₀ C₀_U A_E
    let R0_bar := TensorProduct F R₀ k
    let P_bar := TensorProduct C₀ C₀_U A
    let D_bar := TensorProduct R0_bar P_bar B_bar
    ∃ (ε_sheet : (k_L ≃ₐ[F] k_L) → R_Er),
      (∀ α : k_L ≃ₐ[F] k_L, IsIdempotentElem (ε_sheet α)) ∧
      (∀ α₁ α₂ : k_L ≃ₐ[F] k_L, α₁ ≠ α₂ →
        Disjoint
          (PrimeSpectrum.basicOpen (ε_sheet α₁) : Set (PrimeSpectrum R_Er))
          (PrimeSpectrum.basicOpen (ε_sheet α₂) : Set (PrimeSpectrum R_Er))) ∧
      (⋃ α : k_L ≃ₐ[F] k_L,
        (PrimeSpectrum.basicOpen (ε_sheet α) : Set (PrimeSpectrum R_Er))) = Set.univ ∧
      (∀ (σ : B ≃ₐ[R₀] B) (α : k_L ≃ₐ[F] k_L),
        e_REr ((Algebra.TensorProduct.map (AlgHom.id R₀ P_E) σ.symm.toAlgHom)
          (e_REr.symm (ε_sheet (res_k σ * α)))) = ε_sheet α) ∧
      (let C₁ := R_Er ⧸ Ideal.span {1 - ε_sheet 1}
       let q₁ : R_Er →ₐ[E] C₁ := Ideal.Quotient.mkₐ E (Ideal.span {1 - ε_sheet 1})
       IsLocalization.Away (ε_sheet 1) C₁ ∧
       ∃ Ψ_diag : TensorProduct E C₁ k ≃+* D_bar,
         (∀ (c_U : C₀_U) (a_E : A_E) (b : B) (x : k),
           Ψ_diag (TensorProduct.tmul E
             (q₁ (e_REr (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ c_U a_E) b))) x) =
             TensorProduct.tmul R0_bar
               (TensorProduct.tmul C₀ c_U (e_AE (TensorProduct.tmul E a_E x)))
               (q_B b)) ∧
         (∀ (σ : B ≃ₐ[R₀] B) (γ : B_bar ≃ₐ[R0_bar] B_bar),
           res_k σ = 1 →
           (∀ b : B, γ (q_B b) = q_B (σ b)) →
           ∃ τ₁ : C₁ →ₐ[E] C₁,
             (∀ u : R_Er,
               τ₁ (q₁ u) =
                 q₁ (e_REr ((Algebra.TensorProduct.map (AlgHom.id R₀ P_E) σ.symm.toAlgHom)
                   (e_REr.symm u)))) ∧
             ∀ w : TensorProduct E C₁ k,
               (Algebra.TensorProduct.map (AlgHom.id R0_bar P_bar) γ.symm.toAlgHom)
                 (Ψ_diag w) =
                 Ψ_diag (Algebra.TensorProduct.map τ₁ (AlgHom.id E k) w))) :=
by
  intro P_E R0_bar P_bar D_bar
  
  obtain ⟨liftRingHom, liftRingHom_tmul⟩ :
      ∃ (liftRingHom : ∀ (R₁ : Type u) {A₁ A₂ S : Type u}
          [CommRing R₁] [CommRing A₁] [CommRing A₂] [Algebra R₁ A₁] [Algebra R₁ A₂] [CommRing S]
          (f₁ : A₁ →+* S) (f₂ : A₂ →+* S),
          (∀ r : R₁, f₁ (algebraMap R₁ A₁ r) = f₂ (algebraMap R₁ A₂ r)) →
          TensorProduct R₁ A₁ A₂ →+* S),
        ∀ (R₁ : Type u) {A₁ A₂ S : Type u}
          [CommRing R₁] [CommRing A₁] [CommRing A₂] [Algebra R₁ A₁] [Algebra R₁ A₂] [CommRing S]
          (f₁ : A₁ →+* S) (f₂ : A₂ →+* S)
          (hf : ∀ r : R₁, f₁ (algebraMap R₁ A₁ r) = f₂ (algebraMap R₁ A₂ r))
          (a₁ : A₁) (a₂ : A₂),
          liftRingHom R₁ f₁ f₂ hf (TensorProduct.tmul R₁ a₁ a₂) = f₁ a₁ * f₂ a₂ := by
    refine ⟨fun R₁ {A₁ A₂ S} _ _ _ _ _ _ f₁ f₂ hf =>
      letI : Algebra R₁ S := (f₁.comp (algebraMap R₁ A₁)).toAlgebra
      let f₁_alg : A₁ →ₐ[R₁] S := { f₁ with commutes' := fun _ => rfl }
      let f₂_alg : A₂ →ₐ[R₁] S := { f₂ with commutes' := fun r => (hf r).symm }
      (Algebra.TensorProduct.lift f₁_alg f₂_alg (fun _ _ => mul_comm _ _)).toRingHom, ?_⟩
    intro R₁ A₁ A₂ S _ _ _ _ _ _ f₁ f₂ hf a₁ a₂
    letI : Algebra R₁ S := (f₁.comp (algebraMap R₁ A₁)).toAlgebra
    let f₁_alg : A₁ →ₐ[R₁] S := { f₁ with commutes' := fun _ => rfl }
    let f₂_alg : A₂ →ₐ[R₁] S := { f₂ with commutes' := fun r => (hf r).symm }
    exact Algebra.TensorProduct.lift_tmul f₁_alg f₂_alg (fun _ _ => mul_comm _ _) a₁ a₂
  have ringHom_ext_tmul : ∀ (R₁ : Type u) {A₁ A₂ S : Type u}
      [CommRing R₁] [CommRing A₁] [CommRing A₂] [Algebra R₁ A₁] [Algebra R₁ A₂] [CommRing S]
      (g₁ g₂ : TensorProduct R₁ A₁ A₂ →+* S),
      (∀ a₁ : A₁, g₁ (TensorProduct.tmul R₁ a₁ 1) = g₂ (TensorProduct.tmul R₁ a₁ 1)) →
      (∀ a₂ : A₂, g₁ (TensorProduct.tmul R₁ 1 a₂) = g₂ (TensorProduct.tmul R₁ 1 a₂)) →
      ∀ w : TensorProduct R₁ A₁ A₂, g₁ w = g₂ w := by
    intro R₁ A₁ A₂ S _ _ _ _ _ _ g₁ g₂ h₁ h₂ w
    induction w using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero]
    | tmul a₁ a₂ =>
      have hdecomp : TensorProduct.tmul R₁ a₁ a₂ =
          TensorProduct.tmul R₁ a₁ 1 * TensorProduct.tmul R₁ 1 a₂ := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [hdecomp, map_mul, map_mul, h₁ a₁, h₂ a₂]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have tmul_algebraMap_eq : ∀ (R₁ : Type u) {A₁ A₂ : Type u}
      [CommRing R₁] [CommRing A₁] [CommRing A₂] [Algebra R₁ A₁] [Algebra R₁ A₂] (r : R₁),
      TensorProduct.tmul R₁ (algebraMap R₁ A₁ r) (1 : A₂) =
        TensorProduct.tmul R₁ (1 : A₁) (algebraMap R₁ A₂ r) := by
    intro R₁ A₁ A₂ _ _ _ _ _ r
    calc
      TensorProduct.tmul R₁ (algebraMap R₁ A₁ r) (1 : A₂)
        = TensorProduct.tmul R₁ (r • (1 : A₁)) (1 : A₂) := by
            rw [Algebra.smul_def, mul_one]
      _ = TensorProduct.tmul R₁ (1 : A₁) (r • (1 : A₂)) :=
            TensorProduct.smul_tmul r (1 : A₁) (1 : A₂)
      _ = TensorProduct.tmul R₁ (1 : A₁) (algebraMap R₁ A₂ r) := by
            rw [Algebra.smul_def, mul_one]

  
  have hmap_σ : ∀ (σ : B ≃ₐ[R₀] B) (p_E : P_E) (b : B),
      (Algebra.TensorProduct.map (AlgHom.id R₀ P_E) σ.symm.toAlgHom)
        (TensorProduct.tmul R₀ p_E b) = TensorProduct.tmul R₀ p_E (σ.symm b) :=
    fun σ p_E b => Algebra.TensorProduct.map_tmul (AlgHom.id R₀ P_E) σ.symm.toAlgHom p_E b
  have hmap_γ : ∀ (γ : B_bar ≃ₐ[R0_bar] B_bar) (p : P_bar) (b : B_bar),
      (Algebra.TensorProduct.map (AlgHom.id R0_bar P_bar) γ.symm.toAlgHom)
        (TensorProduct.tmul R0_bar p b) = TensorProduct.tmul R0_bar p (γ.symm b) :=
    fun γ p b => Algebra.TensorProduct.map_tmul (AlgHom.id R0_bar P_bar) γ.symm.toAlgHom p b

  
  let f_L : k_L →+* R_Er := (algebraMap E R_Er).comp κ_E.toRingHom
  let f_R : k_L →+* R_Er :=
    e_REr.toRingHom.comp
      ((Algebra.TensorProduct.includeRight : B →ₐ[R₀] TensorProduct R₀ P_E B).toRingHom.comp
        ι_kB.toRingHom)
  have hf_L_apply : ∀ c : k_L, f_L c = algebraMap E R_Er (κ_E c) := fun _ => rfl
  have hf_R_apply : ∀ c : k_L,
      f_R c = e_REr (TensorProduct.tmul R₀ (1 : P_E) (ι_kB c)) := fun _ => rfl
  have hf_F : ∀ a : F, f_L (algebraMap F k_L a) = f_R (algebraMap F k_L a) := by
    intro a
    rw [hf_L_apply, hf_R_apply, κ_E.commutes a, ι_kB.commutes a, hAlg_ER (algebraMap F E a)]
    congr 1
    have hPE : TensorProduct.tmul C₀ (1 : C₀_U) (algebraMap E A_E (algebraMap F E a)) =
        algebraMap R₀ P_E (algebraMap F R₀ a) := by
      rw [← IsScalarTower.algebraMap_apply F E A_E a,
        IsScalarTower.algebraMap_apply F C₀ A_E a,
        ← tmul_algebraMap_eq C₀ (algebraMap F C₀ a),
        ← IsScalarTower.algebraMap_apply F C₀ C₀_U a,
        IsScalarTower.algebraMap_apply F R₀ C₀_U a]
      exact (Algebra.TensorProduct.algebraMap_apply (algebraMap F R₀ a)).symm
    rw [hPE, tmul_algebraMap_eq R₀ (algebraMap F R₀ a),
      ← IsScalarTower.algebraMap_apply F R₀ B a]

  
  rcases hIdemp_k with ⟨hId_k, hOrth_k, hSum_k, hEval_k, hAbs_k⟩
  let μ_k : (k_L ≃ₐ[F] k_L) → (TensorProduct F k_L k_L →ₐ[k_L] k_L) :=
    fun γ => Algebra.TensorProduct.lift (AlgHom.id k_L k_L) γ.symm.toAlgHom
      (fun _ _ => mul_comm _ _)
  have hμ_tmul : ∀ (γ : k_L ≃ₐ[F] k_L) (c₁ c₂ : k_L),
      μ_k γ (TensorProduct.tmul F c₁ c₂) = c₁ * γ.symm c₂ :=
    fun γ c₁ c₂ =>
      Algebra.TensorProduct.lift_tmul (AlgHom.id k_L k_L) γ.symm.toAlgHom
        (fun _ _ => mul_comm _ _) c₁ c₂
  let Φ_k : TensorProduct F k_L k_L →+* R_Er := liftRingHom F f_L f_R hf_F
  let ε_sheet : (k_L ≃ₐ[F] k_L) → R_Er := fun α => Φ_k (e_k (equiv_Γk.symm α))

  have hε_idemp : ∀ α : k_L ≃ₐ[F] k_L, IsIdempotentElem (ε_sheet α) := by
    intro α
    change Φ_k (e_k (equiv_Γk.symm α)) * Φ_k (e_k (equiv_Γk.symm α)) =
      Φ_k (e_k (equiv_Γk.symm α))
    rw [← map_mul, hId_k]

  have hε_orth : ∀ α₁ α₂ : k_L ≃ₐ[F] k_L, α₁ ≠ α₂ → ε_sheet α₁ * ε_sheet α₂ = 0 := by
    intro α₁ α₂ hne
    have hne_i : equiv_Γk.symm α₁ ≠ equiv_Γk.symm α₂ := by
      intro heq
      apply hne
      calc
        α₁ = equiv_Γk (equiv_Γk.symm α₁) := (equiv_Γk.apply_symm_apply α₁).symm
        _ = equiv_Γk (equiv_Γk.symm α₂) := congrArg equiv_Γk heq
        _ = α₂ := equiv_Γk.apply_symm_apply α₂
    change Φ_k (e_k (equiv_Γk.symm α₁)) * Φ_k (e_k (equiv_Γk.symm α₂)) = 0
    rw [← map_mul, hOrth_k _ _ hne_i, map_zero]

  have hε_disj : ∀ α₁ α₂ : k_L ≃ₐ[F] k_L, α₁ ≠ α₂ →
      Disjoint
        (PrimeSpectrum.basicOpen (ε_sheet α₁) : Set (PrimeSpectrum R_Er))
        (PrimeSpectrum.basicOpen (ε_sheet α₂) : Set (PrimeSpectrum R_Er)) := by
    intro α₁ α₂ hne
    rw [Set.disjoint_left]
    intro p hp₁ hp₂
    rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at hp₁ hp₂
    have hmul : ε_sheet α₁ * ε_sheet α₂ ∈ p.asIdeal := by
      rw [hε_orth α₁ α₂ hne]
      exact p.asIdeal.zero_mem
    rcases p.isPrime.mem_or_mem hmul with h1 | h2
    · exact hp₁ h1
    · exact hp₂ h2

  have hε_univ : (⋃ α : k_L ≃ₐ[F] k_L,
      (PrimeSpectrum.basicOpen (ε_sheet α) : Set (PrimeSpectrum R_Er))) = Set.univ := by
    rw [Set.eq_univ_iff_forall]
    intro p
    by_contra hnot
    have hmem : ∀ i : Fin m_k, Φ_k (e_k i) ∈ p.asIdeal := by
      intro i
      have hni : p ∉ (PrimeSpectrum.basicOpen (ε_sheet (equiv_Γk i)) :
          Set (PrimeSpectrum R_Er)) := by
        intro hi
        exact hnot (Set.mem_iUnion.mpr ⟨equiv_Γk i, hi⟩)
      rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, not_not] at hni
      dsimp only [ε_sheet] at hni
      rwa [equiv_Γk.symm_apply_apply] at hni
    have hone : (1 : R_Er) ∈ p.asIdeal := by
      have hsum_one : ∑ i : Fin m_k, Φ_k (e_k i) = 1 := by
        rw [← map_sum, hSum_k, map_one]
      rw [← hsum_one]
      exact Ideal.sum_mem p.asIdeal fun i _ => hmem i
    exact p.isPrime.ne_top ((p.asIdeal.eq_top_iff_one).mpr hone)

  
  have hBasis_k : ∀ z : TensorProduct F k_L k_L,
      z = ∑ j : Fin m_k, TensorProduct.tmul F (μ_k (equiv_Γk j) z) (1 : k_L) * e_k j := by
    intro z
    calc
      z = z * 1 := (mul_one z).symm
      _ = z * ∑ j : Fin m_k, e_k j := by rw [hSum_k]
      _ = ∑ j : Fin m_k, z * e_k j := Finset.mul_sum Finset.univ e_k z
      _ = ∑ j : Fin m_k, TensorProduct.tmul F (μ_k (equiv_Γk j) z) (1 : k_L) * e_k j :=
          Finset.sum_congr rfl fun j _ => hAbs_k j z

  have hSymm_mul : ∀ (β γ : k_L ≃ₐ[F] k_L) (c : k_L),
      (β * γ).symm c = γ.symm (β.symm c) := by
    intro β γ c
    apply (β * γ).injective
    rw [AlgEquiv.apply_symm_apply, AlgEquiv.mul_apply,
      AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]

  let T_k : (k_L ≃ₐ[F] k_L) → (TensorProduct F k_L k_L →ₐ[F] TensorProduct F k_L k_L) :=
    fun β => Algebra.TensorProduct.map (AlgHom.id F k_L) β.symm.toAlgHom
  have hT_tmul : ∀ (β : k_L ≃ₐ[F] k_L) (c₁ c₂ : k_L),
      T_k β (TensorProduct.tmul F c₁ c₂) = TensorProduct.tmul F c₁ (β.symm c₂) :=
    fun β c₁ c₂ => Algebra.TensorProduct.map_tmul (AlgHom.id F k_L) β.symm.toAlgHom c₁ c₂

  have hμ_T : ∀ (β γ : k_L ≃ₐ[F] k_L) (z : TensorProduct F k_L k_L),
      μ_k γ (T_k β z) = μ_k (β * γ) z := by
    intro β γ z
    exact ringHom_ext_tmul F
      ((μ_k γ).toRingHom.comp (T_k β).toRingHom)
      (μ_k (β * γ)).toRingHom
      (fun c₁ => by
        change μ_k γ (T_k β (TensorProduct.tmul F c₁ 1)) =
          μ_k (β * γ) (TensorProduct.tmul F c₁ 1)
        rw [hT_tmul, map_one, hμ_tmul, hμ_tmul, map_one, map_one])
      (fun c₂ => by
        change μ_k γ (T_k β (TensorProduct.tmul F 1 c₂)) =
          μ_k (β * γ) (TensorProduct.tmul F 1 c₂)
        rw [hT_tmul, hμ_tmul, hμ_tmul, one_mul, one_mul, hSymm_mul])
      z

  have hT_ek : ∀ (β α : k_L ≃ₐ[F] k_L),
      T_k β (e_k (equiv_Γk.symm (β * α))) = e_k (equiv_Γk.symm α) := by
    intro β α
    set i_βα := equiv_Γk.symm (β * α)
    set i_α := equiv_Γk.symm α
    rw [hBasis_k (T_k β (e_k i_βα))]
    have hterm : ∀ j : Fin m_k,
        μ_k (equiv_Γk j) (T_k β (e_k i_βα)) = if j = i_α then 1 else 0 := by
      intro j
      rw [hμ_T β (equiv_Γk j) (e_k i_βα)]
      set j' := equiv_Γk.symm (β * equiv_Γk j)
      have hj' : β * equiv_Γk j = equiv_Γk j' := (equiv_Γk.apply_symm_apply _).symm
      rw [hj']
      have hev := hEval_k i_βα j'
      change μ_k (equiv_Γk j') (e_k i_βα) = if i_βα = j' then 1 else 0 at hev
      rw [hev]
      have hiff : (i_βα = j') ↔ (j = i_α) := by
        constructor
        · intro hij
          have h1 : equiv_Γk i_βα = equiv_Γk j' := congrArg equiv_Γk hij
          rw [equiv_Γk.apply_symm_apply, equiv_Γk.apply_symm_apply] at h1
          have h2 : α = equiv_Γk j := by
            ext x
            exact β.injective (AlgEquiv.congr_fun h1 x)
          calc
            j = equiv_Γk.symm (equiv_Γk j) := (equiv_Γk.symm_apply_apply j).symm
            _ = i_α := by rw [← h2]
        · intro hji
          subst hji
          dsimp only [i_βα, j', i_α]
          rw [equiv_Γk.apply_symm_apply]
      by_cases h : j = i_α
      · rw [if_pos h, if_pos (hiff.mpr h)]
      · rw [if_neg h, if_neg (fun hc => h (hiff.mp hc))]
    rw [Finset.sum_eq_single i_α]
    · rw [hterm i_α, if_pos rfl, ← Algebra.TensorProduct.one_def, one_mul]
    · intro j _ hj
      rw [hterm j, if_neg hj, TensorProduct.zero_tmul, zero_mul]
    · intro hnot
      exact False.elim (hnot (Finset.mem_univ i_α))

  have hPerm_gen : ∀ (τ : R_Er →+* R_Er) (β α : k_L ≃ₐ[F] k_L),
      (∀ c : k_L, τ (f_L c) = f_L c) →
      (∀ c : k_L, τ (f_R c) = f_R (β.symm c)) →
      τ (ε_sheet (β * α)) = ε_sheet α := by
    intro τ β α hτL hτR
    have hcomp : ∀ z : TensorProduct F k_L k_L, τ (Φ_k z) = Φ_k (T_k β z) := by
      intro z
      exact ringHom_ext_tmul F (τ.comp Φ_k) (Φ_k.comp (T_k β).toRingHom)
        (fun c₁ => by
          change τ (Φ_k (TensorProduct.tmul F c₁ 1)) =
            Φ_k (T_k β (TensorProduct.tmul F c₁ 1))
          rw [hT_tmul, map_one]
          dsimp only [Φ_k]
          rw [liftRingHom_tmul, map_one, mul_one, hτL c₁])
        (fun c₂ => by
          change τ (Φ_k (TensorProduct.tmul F 1 c₂)) =
            Φ_k (T_k β (TensorProduct.tmul F 1 c₂))
          rw [hT_tmul]
          dsimp only [Φ_k]
          rw [liftRingHom_tmul, liftRingHom_tmul, map_one, one_mul, one_mul, hτR c₂])
        z
    dsimp only [ε_sheet]
    rw [hcomp, hT_ek]

  let τ_deck : (B ≃ₐ[R₀] B) → (R_Er →ₐ[E] R_Er) := fun σ =>
    let g_ring : R_Er →+* R_Er :=
      e_REr.toRingHom.comp
        ((Algebra.TensorProduct.map (AlgHom.id R₀ P_E) σ.symm.toAlgHom).toRingHom.comp
          e_REr.symm.toRingHom)
    { g_ring with
      commutes' := fun e => by
        change e_REr ((Algebra.TensorProduct.map (AlgHom.id R₀ P_E) σ.symm.toAlgHom)
          (e_REr.symm (algebraMap E R_Er e))) = algebraMap E R_Er e
        rw [hAlg_ER e, RingEquiv.symm_apply_apply, hmap_σ, map_one] }

  have hε_deck : ∀ (σ : B ≃ₐ[R₀] B) (α : k_L ≃ₐ[F] k_L),
      e_REr ((Algebra.TensorProduct.map (AlgHom.id R₀ P_E) σ.symm.toAlgHom)
        (e_REr.symm (ε_sheet (res_k σ * α)))) = ε_sheet α := by
    intro σ α
    exact hPerm_gen (τ_deck σ).toRingHom (res_k σ) α
      (fun c => (τ_deck σ).commutes (κ_E c))
      (fun c => by
        have hσ_symm : σ.symm (ι_kB c) = ι_kB ((res_k σ).symm c) := by
          apply σ.injective
          rw [AlgEquiv.apply_symm_apply, hres_comm, AlgEquiv.apply_symm_apply]
        change e_REr ((Algebra.TensorProduct.map (AlgHom.id R₀ P_E) σ.symm.toAlgHom)
          (e_REr.symm (e_REr (TensorProduct.tmul R₀ (1 : P_E) (ι_kB c))))) =
          e_REr (TensorProduct.tmul R₀ (1 : P_E) (ι_kB ((res_k σ).symm c)))
        rw [RingEquiv.symm_apply_apply, hmap_σ, hσ_symm])

  
  let I₁ : Ideal R_Er := Ideal.span {1 - ε_sheet 1}
  let C₁ := R_Er ⧸ I₁
  let q₁ : R_Er →ₐ[E] C₁ := Ideal.Quotient.mkₐ E I₁
  have hLoc : IsLocalization.Away (ε_sheet 1) C₁ :=
    IsLocalization.Away.quotient_of_isIdempotentElem (hε_idemp 1)

  have hq₁_one_sub : q₁ (1 - ε_sheet 1) = 0 := by
    dsimp only [q₁]
    rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_span_singleton_self (1 - ε_sheet 1)

  have hq₁_ε1 : q₁ (ε_sheet 1) = 1 := by
    have hsub : (1 : C₁) - q₁ (ε_sheet 1) = 0 := by
      rw [← map_one q₁, ← map_sub]
      exact hq₁_one_sub
    exact (sub_eq_zero.mp hsub).symm

  have hSymm_one : ∀ c : k_L, (1 : k_L ≃ₐ[F] k_L).symm c = c := by
    intro c
    have h1 := (1 : k_L ≃ₐ[F] k_L).symm_apply_apply c
    rwa [AlgEquiv.one_apply] at h1

  have hDiag : ∀ c : k_L, q₁ (f_R c) = q₁ (f_L c) := by
    intro c
    set i₁ := equiv_Γk.symm 1
    have hi₁ : equiv_Γk i₁ = 1 := equiv_Γk.apply_symm_apply 1
    have habs := hAbs_k i₁ (TensorProduct.tmul F (1 : k_L) c)
    change TensorProduct.tmul F (1 : k_L) c * e_k i₁ =
      TensorProduct.tmul F (μ_k (equiv_Γk i₁) (TensorProduct.tmul F (1 : k_L) c)) (1 : k_L) *
        e_k i₁ at habs
    have hμ1 : μ_k (equiv_Γk i₁) (TensorProduct.tmul F (1 : k_L) c) = c := by
      rw [hi₁, hμ_tmul, one_mul, hSymm_one]
    rw [hμ1] at habs
    have hmap := congrArg (q₁.toRingHom.comp Φ_k) habs
    change q₁ (Φ_k (TensorProduct.tmul F 1 c * e_k i₁)) =
      q₁ (Φ_k (TensorProduct.tmul F c 1 * e_k i₁)) at hmap
    rw [map_mul, map_mul, map_mul, map_mul] at hmap
    change q₁ (Φ_k (TensorProduct.tmul F 1 c)) * q₁ (ε_sheet 1) =
      q₁ (Φ_k (TensorProduct.tmul F c 1)) * q₁ (ε_sheet 1) at hmap
    dsimp only [Φ_k] at hmap
    rw [hq₁_ε1, mul_one, mul_one, liftRingHom_tmul, liftRingHom_tmul,
      map_one, one_mul, map_one, mul_one] at hmap
    exact hmap

  have hEvalOne : ∀ (D : Type u) [CommRing D] (φ : R_Er →+* D),
      (∀ c : k_L, φ (f_L c) = φ (f_R c)) → φ (ε_sheet 1) = 1 := by
    intro D _ φ hφ
    have hcomp : ∀ z : TensorProduct F k_L k_L,
        φ (Φ_k z) = φ (f_L (μ_k 1 z)) := by
      intro z
      exact ringHom_ext_tmul F (φ.comp Φ_k) ((φ.comp f_L).comp (μ_k 1).toRingHom)
        (fun c₁ => by
          change φ (Φ_k (TensorProduct.tmul F c₁ 1)) =
            φ (f_L (μ_k 1 (TensorProduct.tmul F c₁ 1)))
          rw [hμ_tmul, map_one, mul_one]
          dsimp only [Φ_k]
          rw [liftRingHom_tmul, map_one, mul_one])
        (fun c₂ => by
          change φ (Φ_k (TensorProduct.tmul F 1 c₂)) =
            φ (f_L (μ_k 1 (TensorProduct.tmul F 1 c₂)))
          rw [hμ_tmul, one_mul, hSymm_one, hφ c₂]
          dsimp only [Φ_k]
          rw [liftRingHom_tmul, map_one, one_mul])
        z
    set i₁ := equiv_Γk.symm 1
    have hi₁ : (1 : k_L ≃ₐ[F] k_L) = equiv_Γk i₁ := (equiv_Γk.apply_symm_apply 1).symm
    dsimp only [ε_sheet]
    change φ (Φ_k (e_k i₁)) = 1
    rw [hcomp (e_k i₁), hi₁]
    have hev := hEval_k i₁ i₁
    change μ_k (equiv_Γk i₁) (e_k i₁) = if i₁ = i₁ then 1 else 0 at hev
    rw [hev, if_pos rfl, map_one, map_one]

  
  let S_diag := TensorProduct E C₁ k

  have hqB_kL : ∀ c : k_L, q_B (ι_kB c) = q_k (κ_k c) := by
    intro c
    rw [← hAlg_kLB c, ← hAlg_kLk c]
    have htm := congrArg ψ_Bk (tmul_algebraMap_eq k_L (A₁ := B) (A₂ := k) c)
    rw [hψ_Bk, hψ_Bk, map_one, mul_one, map_one, one_mul] at htm
    exact htm

  have he_AE_k : ∀ x : k, e_AE (TensorProduct.tmul E 1 x) = algebraMap k A x := by
    intro x
    rw [he_AE_tmul 1 x, ← Algebra.TensorProduct.one_def, map_one, one_mul]

  have hDbar_k : ∀ x : k,
      TensorProduct.tmul R0_bar
        (TensorProduct.tmul C₀ (1 : C₀_U) (algebraMap k A x)) (1 : B_bar) =
        TensorProduct.tmul R0_bar (1 : P_bar) (q_k x) := by
    intro x
    have hP : TensorProduct.tmul C₀ (1 : C₀_U) (algebraMap k A x) =
        algebraMap R0_bar P_bar (TensorProduct.tmul F 1 x) := by
      rw [hAlg_Pbar 1 x, map_one]
    rw [hP, tmul_algebraMap_eq R0_bar (TensorProduct.tmul F 1 x),
      htmalg 1 x, map_one, map_one, one_mul]

  
  let f_P1 : C₀_U →+* P_bar := Algebra.TensorProduct.includeLeftRingHom
  let f_P2 : A_E →+* P_bar :=
    (Algebra.TensorProduct.includeRight : A →ₐ[C₀] P_bar).toRingHom.comp
      (e_AE.toRingHom.comp
        (Algebra.TensorProduct.includeLeftRingHom : A_E →+* TensorProduct E A_E k))
  have hf_P : ∀ c : C₀, f_P1 (algebraMap C₀ C₀_U c) = f_P2 (algebraMap C₀ A_E c) := by
    intro c
    change TensorProduct.tmul C₀ (algebraMap C₀ C₀_U c) (1 : A) =
      TensorProduct.tmul C₀ (1 : C₀_U) (e_AE (TensorProduct.tmul E (algebraMap C₀ A_E c) 1))
    rw [he_AE_C₀ c, tmul_algebraMap_eq C₀ c]
  let ι_P : P_E →+* P_bar := liftRingHom C₀ f_P1 f_P2 hf_P
  have hι_P_tmul : ∀ (c_U : C₀_U) (a_E : A_E),
      ι_P (TensorProduct.tmul C₀ c_U a_E) =
        TensorProduct.tmul C₀ c_U (e_AE (TensorProduct.tmul E a_E 1)) := by
    intro c_U a_E
    dsimp only [ι_P]
    rw [liftRingHom_tmul]
    change TensorProduct.tmul C₀ c_U (1 : A) *
      TensorProduct.tmul C₀ (1 : C₀_U) (e_AE (TensorProduct.tmul E a_E 1)) = _
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]

  let f_raw1 : P_E →+* D_bar :=
    (Algebra.TensorProduct.includeLeftRingHom : P_bar →+* D_bar).comp ι_P
  let f_raw2 : B →+* D_bar :=
    (Algebra.TensorProduct.includeRight : B_bar →ₐ[R0_bar] D_bar).toRingHom.comp q_B
  have hf_raw : ∀ z : R₀, f_raw1 (algebraMap R₀ P_E z) = f_raw2 (algebraMap R₀ B z) := by
    intro z
    change TensorProduct.tmul R0_bar (ι_P (algebraMap R₀ P_E z)) (1 : B_bar) =
      TensorProduct.tmul R0_bar (1 : P_bar) (q_B (algebraMap R₀ B z))
    have h1 : algebraMap R₀ P_E z = TensorProduct.tmul C₀ (algebraMap R₀ C₀_U z) (1 : A_E) :=
      Algebra.TensorProduct.algebraMap_apply z
    rw [h1, hι_P_tmul, ← Algebra.TensorProduct.one_def, map_one,
      ← map_one (algebraMap k A), ← hAlg_Pbar z 1,
      tmul_algebraMap_eq R0_bar (TensorProduct.tmul F z 1),
      htmalg z 1, map_one, mul_one]
  let φ_raw : TensorProduct R₀ P_E B →+* D_bar := liftRingHom R₀ f_raw1 f_raw2 hf_raw
  have hφ_raw_tmul : ∀ (c_U : C₀_U) (a_E : A_E) (b : B),
      φ_raw (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ c_U a_E) b) =
        TensorProduct.tmul R0_bar
          (TensorProduct.tmul C₀ c_U (e_AE (TensorProduct.tmul E a_E 1)))
          (q_B b) := by
    intro c_U a_E b
    dsimp only [φ_raw]
    rw [liftRingHom_tmul]
    change TensorProduct.tmul R0_bar (ι_P (TensorProduct.tmul C₀ c_U a_E)) (1 : B_bar) *
      TensorProduct.tmul R0_bar (1 : P_bar) (q_B b) = _
    rw [hι_P_tmul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]

  let φ₀ : R_Er →+* D_bar := φ_raw.comp e_REr.symm.toRingHom
  have hφ₀_E : ∀ e : E,
      φ₀ (algebraMap E R_Er e) =
        TensorProduct.tmul R0_bar
          (TensorProduct.tmul C₀ 1 (algebraMap k A (algebraMap E k e))) 1 := by
    intro e
    change φ_raw (e_REr.symm (algebraMap E R_Er e)) = _
    rw [hAlg_ER e, RingEquiv.symm_apply_apply, hφ_raw_tmul, he_AE_E e, map_one]

  have hφ₀_ε1 : φ₀ (ε_sheet 1) = 1 := by
    refine hEvalOne D_bar φ₀ fun c => ?_
    rw [hf_L_apply, hf_R_apply, hφ₀_E (κ_E c), hDbar_k, hκ_Ek c, ← hqB_kL c]
    change _ = φ_raw (e_REr.symm (e_REr (TensorProduct.tmul R₀ (1 : P_E) (ι_kB c))))
    rw [RingEquiv.symm_apply_apply]
    have hone_PE : (1 : P_E) = TensorProduct.tmul C₀ 1 1 := Algebra.TensorProduct.one_def
    rw [hone_PE, hφ_raw_tmul, ← Algebra.TensorProduct.one_def, map_one,
      ← Algebra.TensorProduct.one_def]

  have hφ₀_I₁ : ∀ a ∈ I₁, φ₀ a = 0 := by
    intro a ha
    rcases Ideal.mem_span_singleton.mp ha with ⟨r, rfl⟩
    rw [map_mul, map_sub, map_one, hφ₀_ε1, sub_self, zero_mul]

  let φ₁ : C₁ →+* D_bar := Ideal.Quotient.lift I₁ φ₀ hφ₀_I₁
  have hφ₁_q₁ : ∀ u : R_Er, φ₁ (q₁ u) = φ₀ u := by
    intro u
    dsimp only [q₁, φ₁]
    rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.lift_mk]

  let ι_kD : k →+* D_bar :=
    (Algebra.TensorProduct.includeLeftRingHom : P_bar →+* D_bar).comp
      ((Algebra.TensorProduct.includeRight : A →ₐ[C₀] P_bar).toRingHom.comp (algebraMap k A))
  have hf_fwd : ∀ e : E, φ₁ (algebraMap E C₁ e) = ι_kD (algebraMap E k e) := by
    intro e
    rw [← q₁.commutes e, hφ₁_q₁, hφ₀_E e]
    rfl
  let Φ_fwd : S_diag →+* D_bar := liftRingHom E φ₁ ι_kD hf_fwd

  have hΦ_fwd_tmul : ∀ (c_U : C₀_U) (a_E : A_E) (b : B) (x : k),
      Φ_fwd (TensorProduct.tmul E
        (q₁ (e_REr (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ c_U a_E) b))) x) =
        TensorProduct.tmul R0_bar
          (TensorProduct.tmul C₀ c_U (e_AE (TensorProduct.tmul E a_E x)))
          (q_B b) := by
    intro c_U a_E b x
    dsimp only [Φ_fwd]
    rw [liftRingHom_tmul, hφ₁_q₁]
    change φ_raw (e_REr.symm (e_REr (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ c_U a_E) b))) *
      TensorProduct.tmul R0_bar (TensorProduct.tmul C₀ (1 : C₀_U) (algebraMap k A x)) (1 : B_bar) = _
    rw [RingEquiv.symm_apply_apply, hφ_raw_tmul, Algebra.TensorProduct.tmul_mul_tmul,
      Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_one, ← he_AE_tmul a_E x]

  
  let inc_C1 : C₁ →+* S_diag := Algebra.TensorProduct.includeLeftRingHom
  let inc_k : k →+* S_diag :=
    (Algebra.TensorProduct.includeRight : k →ₐ[E] S_diag).toRingHom
  let q_Er : TensorProduct R₀ P_E B →+* S_diag :=
    inc_C1.comp (q₁.toRingHom.comp e_REr.toRingHom)

  let g_AE : A_E →+* S_diag :=
    q_Er.comp
      ((Algebra.TensorProduct.includeLeftRingHom : P_E →+* TensorProduct R₀ P_E B).comp
        (Algebra.TensorProduct.includeRight : A_E →ₐ[C₀] P_E).toRingHom)
  have hg_AE : ∀ e : E, g_AE (algebraMap E A_E e) = inc_k (algebraMap E k e) := by
    intro e
    change TensorProduct.tmul E
      (q₁ (e_REr (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ 1 (algebraMap E A_E e)) 1))) 1 =
      TensorProduct.tmul E 1 (algebraMap E k e)
    rw [← hAlg_ER e, q₁.commutes e, tmul_algebraMap_eq E e]
  let α_to : TensorProduct E A_E k →+* S_diag := liftRingHom E g_AE inc_k hg_AE
  let α_A : A →+* S_diag := α_to.comp e_AE.symm.toRingHom

  let g_CU : C₀_U →+* S_diag :=
    q_Er.comp
      ((Algebra.TensorProduct.includeLeftRingHom : P_E →+* TensorProduct R₀ P_E B).comp
        (Algebra.TensorProduct.includeLeftRingHom : C₀_U →+* P_E))
  have hg_C0 : ∀ c : C₀, g_CU (algebraMap C₀ C₀_U c) = α_A (algebraMap C₀ A c) := by
    intro c
    have hsymm : e_AE.symm (algebraMap C₀ A c) = TensorProduct.tmul E (algebraMap C₀ A_E c) 1 := by
      rw [← he_AE_C₀ c, RingEquiv.symm_apply_apply]
    change g_CU (algebraMap C₀ C₀_U c) = α_to (e_AE.symm (algebraMap C₀ A c))
    rw [hsymm]
    dsimp only [α_to]
    rw [liftRingHom_tmul, map_one, mul_one]
    change q_Er (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ (algebraMap C₀ C₀_U c) 1) 1) =
      q_Er (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ 1 (algebraMap C₀ A_E c)) 1)
    rw [tmul_algebraMap_eq C₀ c]
  let ψ_left : P_bar →+* S_diag := liftRingHom C₀ g_CU α_A hg_C0

  let g_B : B →+* S_diag :=
    q_Er.comp (Algebra.TensorProduct.includeRight : B →ₐ[R₀] TensorProduct R₀ P_E B).toRingHom
  have hg_kL : ∀ c : k_L, g_B (algebraMap k_L B c) = inc_k (algebraMap k_L k c) := by
    intro c
    rw [hAlg_kLB c, hAlg_kLk c, ← hκ_Ek c]
    change TensorProduct.tmul E (q₁ (f_R c)) 1 = TensorProduct.tmul E 1 (algebraMap E k (κ_E c))
    rw [hDiag c, hf_L_apply, q₁.commutes (κ_E c), tmul_algebraMap_eq E (κ_E c)]
  let β_to : TensorProduct k_L B k →+* S_diag := liftRingHom k_L g_B inc_k hg_kL
  let ψ_right : B_bar →+* S_diag := β_to.comp ψ_Bk.symm.toRingHom

  have hψ_right_qB : ∀ b : B, ψ_right (q_B b) = g_B b := by
    intro b
    have hsymm : ψ_Bk.symm (q_B b) = TensorProduct.tmul k_L b 1 := by
      apply ψ_Bk.injective
      rw [RingEquiv.apply_symm_apply, hψ_Bk, map_one, mul_one]
    change β_to (ψ_Bk.symm (q_B b)) = g_B b
    rw [hsymm]
    dsimp only [β_to]
    rw [liftRingHom_tmul, map_one, mul_one]

  have hψ_right_qk : ∀ x : k, ψ_right (q_k x) = inc_k x := by
    intro x
    have hsymm : ψ_Bk.symm (q_k x) = TensorProduct.tmul k_L 1 x := by
      apply ψ_Bk.injective
      rw [RingEquiv.apply_symm_apply, hψ_Bk, map_one, one_mul]
    change β_to (ψ_Bk.symm (q_k x)) = inc_k x
    rw [hsymm]
    dsimp only [β_to]
    rw [liftRingHom_tmul, map_one, one_mul]

  have hα_A_k : ∀ x : k, α_A (algebraMap k A x) = inc_k x := by
    intro x
    have hsymm : e_AE.symm (algebraMap k A x) = TensorProduct.tmul E 1 x := by
      rw [← he_AE_k x, RingEquiv.symm_apply_apply]
    change α_to (e_AE.symm (algebraMap k A x)) = inc_k x
    rw [hsymm]
    dsimp only [α_to]
    rw [liftRingHom_tmul, map_one, one_mul]

  have hf_R0bar : ∀ w : R0_bar,
      ψ_left (algebraMap R0_bar P_bar w) = ψ_right (algebraMap R0_bar B_bar w) := by
    intro w
    exact ringHom_ext_tmul F
      (ψ_left.comp (algebraMap R0_bar P_bar))
      (ψ_right.comp (algebraMap R0_bar B_bar))
      (fun z => by
        change ψ_left (algebraMap R0_bar P_bar (TensorProduct.tmul F z 1)) =
          ψ_right (algebraMap R0_bar B_bar (TensorProduct.tmul F z 1))
        rw [hAlg_Pbar z 1, map_one, htmalg z 1, map_one, mul_one, hψ_right_qB]
        dsimp only [ψ_left]
        rw [liftRingHom_tmul, map_one, mul_one]
        change q_Er (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ (algebraMap R₀ C₀_U z) 1) 1) =
          q_Er (TensorProduct.tmul R₀ (1 : P_E) (algebraMap R₀ B z))
        have h1 : TensorProduct.tmul C₀ (algebraMap R₀ C₀_U z) (1 : A_E) =
            algebraMap R₀ P_E z := (Algebra.TensorProduct.algebraMap_apply z).symm
        rw [h1, tmul_algebraMap_eq R₀ z])
      (fun x => by
        change ψ_left (algebraMap R0_bar P_bar (TensorProduct.tmul F 1 x)) =
          ψ_right (algebraMap R0_bar B_bar (TensorProduct.tmul F 1 x))
        rw [hAlg_Pbar 1 x, map_one, htmalg 1 x, map_one, map_one, one_mul, hψ_right_qk]
        dsimp only [ψ_left]
        rw [liftRingHom_tmul, map_one, one_mul, hα_A_k])
      w

  let Φ_inv : D_bar →+* S_diag := liftRingHom R0_bar ψ_left ψ_right hf_R0bar

  
  have h_inv_fwd : Φ_inv.comp Φ_fwd = RingHom.id S_diag := by
    apply RingHom.ext
    intro w
    exact ringHom_ext_tmul E (Φ_inv.comp Φ_fwd) (RingHom.id S_diag)
      (fun c₁ => by
        rcases Ideal.Quotient.mk_surjective c₁ with ⟨u, rfl⟩
        rcases e_REr.surjective u with ⟨t, rfl⟩
        have hmk : Ideal.Quotient.mk I₁ (e_REr t) = q₁ (e_REr t) := by
          dsimp only [q₁]
          rw [Ideal.Quotient.mkₐ_eq_mk]
        rw [hmk]
        change ((Φ_inv.comp Φ_fwd).comp q_Er) t = q_Er t
        exact ringHom_ext_tmul R₀ ((Φ_inv.comp Φ_fwd).comp q_Er) q_Er
          (fun p_E => by
            let inc_PE : P_E →+* TensorProduct R₀ P_E B :=
              Algebra.TensorProduct.includeLeftRingHom
            change (((Φ_inv.comp Φ_fwd).comp q_Er).comp inc_PE) p_E = (q_Er.comp inc_PE) p_E
            exact ringHom_ext_tmul C₀
              (((Φ_inv.comp Φ_fwd).comp q_Er).comp inc_PE)
              (q_Er.comp inc_PE)
              (fun c_U => by
                change Φ_inv (Φ_fwd (TensorProduct.tmul E
                  (q₁ (e_REr (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ c_U 1) 1))) 1)) =
                  g_CU c_U
                rw [hΦ_fwd_tmul, ← Algebra.TensorProduct.one_def, map_one, map_one]
                dsimp only [Φ_inv, ψ_left]
                rw [liftRingHom_tmul, map_one, mul_one, liftRingHom_tmul, map_one, mul_one])
              (fun a_E => by
                change Φ_inv (Φ_fwd (TensorProduct.tmul E
                  (q₁ (e_REr (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ 1 a_E) 1))) 1)) =
                  g_AE a_E
                rw [hΦ_fwd_tmul, map_one]
                dsimp only [Φ_inv, ψ_left]
                rw [liftRingHom_tmul, map_one, mul_one, liftRingHom_tmul, map_one, one_mul]
                change α_to (e_AE.symm (e_AE (TensorProduct.tmul E a_E 1))) = g_AE a_E
                rw [RingEquiv.symm_apply_apply]
                dsimp only [α_to]
                rw [liftRingHom_tmul, map_one, mul_one])
              p_E)
          (fun b => by
            have hone_PE : (1 : P_E) = TensorProduct.tmul C₀ 1 1 :=
              Algebra.TensorProduct.one_def
            change Φ_inv (Φ_fwd (TensorProduct.tmul E
              (q₁ (e_REr (TensorProduct.tmul R₀ (1 : P_E) b))) 1)) = g_B b
            rw [hone_PE, hΦ_fwd_tmul, ← Algebra.TensorProduct.one_def, map_one,
              ← Algebra.TensorProduct.one_def]
            dsimp only [Φ_inv]
            rw [liftRingHom_tmul, map_one, one_mul, hψ_right_qB])
          t)
      (fun x => by
        change Φ_inv (Φ_fwd (TensorProduct.tmul E 1 x)) = TensorProduct.tmul E 1 x
        dsimp only [Φ_fwd]
        rw [liftRingHom_tmul, map_one, one_mul]
        change Φ_inv (TensorProduct.tmul R0_bar
          (TensorProduct.tmul C₀ 1 (algebraMap k A x)) 1) = inc_k x
        dsimp only [Φ_inv, ψ_left]
        rw [liftRingHom_tmul, map_one, mul_one, liftRingHom_tmul, map_one, one_mul, hα_A_k])
      w

  
  have h_fwd_inv : Φ_fwd.comp Φ_inv = RingHom.id D_bar := by
    apply RingHom.ext
    intro w
    let inc_Pbar : P_bar →+* D_bar := Algebra.TensorProduct.includeLeftRingHom
    let inc_Bbar : B_bar →+* D_bar :=
      (Algebra.TensorProduct.includeRight : B_bar →ₐ[R0_bar] D_bar).toRingHom
    exact ringHom_ext_tmul R0_bar (Φ_fwd.comp Φ_inv) (RingHom.id D_bar)
      (fun p_bar => by
        change Φ_fwd (Φ_inv (TensorProduct.tmul R0_bar p_bar 1)) = inc_Pbar p_bar
        dsimp only [Φ_inv]
        rw [liftRingHom_tmul, map_one, mul_one]
        change (Φ_fwd.comp ψ_left) p_bar = inc_Pbar p_bar
        exact ringHom_ext_tmul C₀ (Φ_fwd.comp ψ_left) inc_Pbar
          (fun c_U => by
            change Φ_fwd (ψ_left (TensorProduct.tmul C₀ c_U 1)) =
              TensorProduct.tmul R0_bar (TensorProduct.tmul C₀ c_U (1 : A)) (1 : B_bar)
            dsimp only [ψ_left]
            rw [liftRingHom_tmul, map_one, mul_one]
            change Φ_fwd (TensorProduct.tmul E
              (q₁ (e_REr (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ c_U 1) 1))) 1) = _
            rw [hΦ_fwd_tmul, ← Algebra.TensorProduct.one_def, map_one, map_one])
          (fun a => by
            rcases e_AE.surjective a with ⟨v, rfl⟩
            change Φ_fwd (ψ_left (TensorProduct.tmul C₀ 1 (e_AE v))) =
              TensorProduct.tmul R0_bar (TensorProduct.tmul C₀ (1 : C₀_U) (e_AE v)) (1 : B_bar)
            dsimp only [ψ_left]
            rw [liftRingHom_tmul, map_one, one_mul]
            have hαv : α_A (e_AE v) = α_to v := by
              change α_to (e_AE.symm (e_AE v)) = α_to v
              rw [RingEquiv.symm_apply_apply]
            rw [hαv]
            let rhs_AE : TensorProduct E A_E k →+* D_bar :=
              inc_Pbar.comp
                ((Algebra.TensorProduct.includeRight : A →ₐ[C₀] P_bar).toRingHom.comp
                  e_AE.toRingHom)
            change (Φ_fwd.comp α_to) v = rhs_AE v
            exact ringHom_ext_tmul E (Φ_fwd.comp α_to) rhs_AE
              (fun a_E => by
                change Φ_fwd (α_to (TensorProduct.tmul E a_E 1)) =
                  TensorProduct.tmul R0_bar
                    (TensorProduct.tmul C₀ (1 : C₀_U) (e_AE (TensorProduct.tmul E a_E 1)))
                    (1 : B_bar)
                dsimp only [α_to]
                rw [liftRingHom_tmul, map_one, mul_one]
                change Φ_fwd (TensorProduct.tmul E
                  (q₁ (e_REr (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ 1 a_E) 1))) 1) = _
                rw [hΦ_fwd_tmul, map_one])
              (fun x => by
                change Φ_fwd (α_to (TensorProduct.tmul E 1 x)) =
                  TensorProduct.tmul R0_bar
                    (TensorProduct.tmul C₀ (1 : C₀_U) (e_AE (TensorProduct.tmul E 1 x)))
                    (1 : B_bar)
                dsimp only [α_to, Φ_fwd]
                rw [liftRingHom_tmul, map_one, one_mul]
                change liftRingHom E φ₁ ι_kD hf_fwd (TensorProduct.tmul E 1 x) = _
                rw [liftRingHom_tmul, map_one, one_mul, he_AE_k]
                rfl)
              v)
          p_bar)
      (fun b_bar => by
        rcases ψ_Bk.surjective b_bar with ⟨u, rfl⟩
        change Φ_fwd (Φ_inv (TensorProduct.tmul R0_bar 1 (ψ_Bk u))) = inc_Bbar (ψ_Bk u)
        dsimp only [Φ_inv]
        rw [liftRingHom_tmul, map_one, one_mul]
        have hψu : ψ_right (ψ_Bk u) = β_to u := by
          change β_to (ψ_Bk.symm (ψ_Bk u)) = β_to u
          rw [RingEquiv.symm_apply_apply]
        rw [hψu]
        change (Φ_fwd.comp β_to) u = (inc_Bbar.comp ψ_Bk.toRingHom) u
        exact ringHom_ext_tmul k_L (Φ_fwd.comp β_to) (inc_Bbar.comp ψ_Bk.toRingHom)
          (fun b => by
            change Φ_fwd (β_to (TensorProduct.tmul k_L b 1)) =
              TensorProduct.tmul R0_bar (1 : P_bar) (ψ_Bk (TensorProduct.tmul k_L b 1))
            dsimp only [β_to]
            rw [liftRingHom_tmul, map_one, mul_one, hψ_Bk, map_one, mul_one]
            have hone_PE : (1 : P_E) = TensorProduct.tmul C₀ 1 1 :=
              Algebra.TensorProduct.one_def
            change Φ_fwd (TensorProduct.tmul E
              (q₁ (e_REr (TensorProduct.tmul R₀ (1 : P_E) b))) 1) = _
            rw [hone_PE, hΦ_fwd_tmul, ← Algebra.TensorProduct.one_def, map_one,
              ← Algebra.TensorProduct.one_def])
          (fun x => by
            change Φ_fwd (β_to (TensorProduct.tmul k_L 1 x)) =
              TensorProduct.tmul R0_bar (1 : P_bar) (ψ_Bk (TensorProduct.tmul k_L 1 x))
            dsimp only [β_to, Φ_fwd]
            rw [liftRingHom_tmul, map_one, one_mul]
            change liftRingHom E φ₁ ι_kD hf_fwd (TensorProduct.tmul E 1 x) = _
            rw [liftRingHom_tmul, map_one, one_mul, hψ_Bk, map_one, one_mul]
            exact hDbar_k x)
          u)
      w

  let Ψ_diag : TensorProduct E C₁ k ≃+* D_bar :=
    RingEquiv.ofRingHom Φ_fwd Φ_inv h_fwd_inv h_inv_fwd

  
  refine ⟨ε_sheet, hε_idemp, hε_disj, hε_univ, hε_deck, hLoc, Ψ_diag, ?_, ?_⟩
  · intro c_U a_E b x
    dsimp only [Ψ_diag]
    rw [RingEquiv.ofRingHom_apply]
    exact hΦ_fwd_tmul c_U a_E b x
  · intro σ γ hres1 hγσ
    have hγ_symm : ∀ b : B, γ.symm (q_B b) = q_B (σ.symm b) := by
      intro b
      apply γ.injective
      rw [AlgEquiv.apply_symm_apply, hγσ, AlgEquiv.apply_symm_apply]
    have hτ_ε1 : τ_deck σ (ε_sheet 1) = ε_sheet 1 := by
      have hd := hε_deck σ 1
      rw [hres1, one_mul] at hd
      exact hd
    let f_lift : R_Er →ₐ[E] C₁ := q₁.comp (τ_deck σ)
    have hf_lift_I₁ : ∀ a ∈ I₁, f_lift a = 0 := by
      intro a ha
      rcases Ideal.mem_span_singleton.mp ha with ⟨r, rfl⟩
      dsimp only [f_lift]
      rw [map_mul, AlgHom.comp_apply, map_sub, map_one, hτ_ε1, hq₁_one_sub, zero_mul]
    let τ₁ : C₁ →ₐ[E] C₁ := Ideal.Quotient.liftₐ I₁ f_lift hf_lift_I₁
    have hτ₁_q₁ : ∀ u : R_Er,
        τ₁ (q₁ u) =
          q₁ (e_REr ((Algebra.TensorProduct.map (AlgHom.id R₀ P_E) σ.symm.toAlgHom)
            (e_REr.symm u))) := by
      intro u
      exact AlgHom.congr_fun (Ideal.Quotient.liftₐ_comp I₁ f_lift hf_lift_I₁) u
    refine ⟨τ₁, hτ₁_q₁, fun w => ?_⟩
    let lhs_eqv : S_diag →+* D_bar :=
      (Algebra.TensorProduct.map (AlgHom.id R0_bar P_bar) γ.symm.toAlgHom).toRingHom.comp
        Ψ_diag.toRingHom
    let rhs_eqv : S_diag →+* D_bar :=
      Ψ_diag.toRingHom.comp (Algebra.TensorProduct.map τ₁ (AlgHom.id E k)).toRingHom
    exact ringHom_ext_tmul E lhs_eqv rhs_eqv
      (fun c₁ => by
        rcases Ideal.Quotient.mk_surjective c₁ with ⟨u, rfl⟩
        rcases e_REr.surjective u with ⟨t, rfl⟩
        have hmk : Ideal.Quotient.mk I₁ (e_REr t) = q₁ (e_REr t) := by
          dsimp only [q₁]
          rw [Ideal.Quotient.mkₐ_eq_mk]
        rw [hmk]
        change (lhs_eqv.comp q_Er) t = (rhs_eqv.comp q_Er) t
        exact ringHom_ext_tmul R₀ (lhs_eqv.comp q_Er) (rhs_eqv.comp q_Er)
          (fun p_E => by
            change (Algebra.TensorProduct.map (AlgHom.id R0_bar P_bar) γ.symm.toAlgHom)
                (Ψ_diag (TensorProduct.tmul E (q₁ (e_REr (TensorProduct.tmul R₀ p_E 1))) 1)) =
              Ψ_diag ((Algebra.TensorProduct.map τ₁ (AlgHom.id E k))
                (TensorProduct.tmul E (q₁ (e_REr (TensorProduct.tmul R₀ p_E 1))) 1))
            have hτ_fix : τ₁ (q₁ (e_REr (TensorProduct.tmul R₀ p_E 1))) =
                q₁ (e_REr (TensorProduct.tmul R₀ p_E 1)) := by
              rw [hτ₁_q₁, RingEquiv.symm_apply_apply, hmap_σ, map_one]
            rw [Algebra.TensorProduct.map_tmul, hτ_fix, AlgHom.id_apply]
            have hΨ_pE : Ψ_diag (TensorProduct.tmul E
                (q₁ (e_REr (TensorProduct.tmul R₀ p_E 1))) 1) =
                TensorProduct.tmul R0_bar (ι_P p_E) 1 := by
              dsimp only [Ψ_diag, Φ_fwd]
              rw [RingEquiv.ofRingHom_apply, liftRingHom_tmul, map_one, mul_one, hφ₁_q₁]
              change φ_raw (e_REr.symm (e_REr (TensorProduct.tmul R₀ p_E 1))) = _
              rw [RingEquiv.symm_apply_apply]
              dsimp only [φ_raw]
              rw [liftRingHom_tmul, map_one, mul_one]
              rfl
            rw [hΨ_pE, hmap_γ, map_one])
          (fun b => by
            have hone_PE : (1 : P_E) = TensorProduct.tmul C₀ 1 1 :=
              Algebra.TensorProduct.one_def
            change (Algebra.TensorProduct.map (AlgHom.id R0_bar P_bar) γ.symm.toAlgHom)
                (Ψ_diag (TensorProduct.tmul E (q₁ (e_REr (TensorProduct.tmul R₀ (1 : P_E) b))) 1)) =
              Ψ_diag ((Algebra.TensorProduct.map τ₁ (AlgHom.id E k))
                (TensorProduct.tmul E (q₁ (e_REr (TensorProduct.tmul R₀ (1 : P_E) b))) 1))
            have hτ_b : τ₁ (q₁ (e_REr (TensorProduct.tmul R₀ (1 : P_E) b))) =
                q₁ (e_REr (TensorProduct.tmul R₀ (1 : P_E) (σ.symm b))) := by
              rw [hτ₁_q₁, RingEquiv.symm_apply_apply, hmap_σ]
            rw [Algebra.TensorProduct.map_tmul, hτ_b, AlgHom.id_apply]
            dsimp only [Ψ_diag]
            rw [RingEquiv.ofRingHom_apply, RingEquiv.ofRingHom_apply,
              hone_PE, hΦ_fwd_tmul, hΦ_fwd_tmul, hmap_γ, hγ_symm])
          t)
      (fun x => by
        change (Algebra.TensorProduct.map (AlgHom.id R0_bar P_bar) γ.symm.toAlgHom)
            (Ψ_diag (TensorProduct.tmul E 1 x)) =
          Ψ_diag ((Algebra.TensorProduct.map τ₁ (AlgHom.id E k)) (TensorProduct.tmul E 1 x))
        rw [Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply]
        have hΨ_x : Ψ_diag (TensorProduct.tmul E 1 x) =
            TensorProduct.tmul R0_bar (TensorProduct.tmul C₀ 1 (algebraMap k A x)) 1 := by
          dsimp only [Ψ_diag, Φ_fwd]
          rw [RingEquiv.ofRingHom_apply, liftRingHom_tmul, map_one, one_mul]
          rfl
        rw [hΨ_x, hmap_γ, map_one])
      w

theorem weil_clopen_idempotent_descent_and_shapiro_lift (F : Type u) [Field F]
    (k : Type u) [Field k] [Algebra F k] [Algebra.IsIntegral F k]
    (m_mod M : ℕ) (hm : 1 ≤ m_mod) :
    (∀ (E₁ : IntermediateField F k) [FiniteDimensional F ↥E₁]
       (R₁ : Type u) [CommRing R₁] [Algebra ↥E₁ R₁]
       (f_bar₁ : LocallyConstant
         (PrimeSpectrum (TensorProduct ↥E₁ R₁ k)) (Fin M → ZMod m_mod)),
      ∃ (E₂ : IntermediateField F k) (_ : FiniteDimensional F ↥E₂),
        E₁ ≤ E₂ ∧
        ∀ [Algebra ↥E₁ ↥E₂]
          (hinc : ∀ x : ↥E₁, (algebraMap ↥E₁ ↥E₂ x : k) = (x : k))
          (v : Fin M → ZMod m_mod),
          ∃ u_v : TensorProduct ↥E₁ R₁ ↥E₂,
            (PrimeSpectrum.basicOpen
              ((Algebra.TensorProduct.map (AlgHom.id ↥E₁ R₁)
                ({ toRingHom := E₂.val.toRingHom
                   commutes' := fun x => hinc x } : ↥E₂ →ₐ[↥E₁] k)) u_v) :
                Set (PrimeSpectrum (TensorProduct ↥E₁ R₁ k))) =
              f_bar₁ ⁻¹' {v}) ∧
    (∀ (E : Type u) [Field E] [Algebra E k]
       (R_Er : Type u) [CommRing R_Er] [Algebra E R_Er]
       (Γ_B Γ_k : Type u) [Group Γ_B] [Group Γ_k] [Finite Γ_k]
       (res_k : Γ_B →* Γ_k) (_hres_surj : Function.Surjective res_k)
       (ρ : Γ_B →* (Matrix (Fin M) (Fin M) (ZMod m_mod))ˣ)
       (τ : Γ_B → (R_Er →ₐ[E] R_Er))
       (_hτ_one : ∀ u : R_Er, τ 1 u = u)
       (_hτ_mul : ∀ (g₁ g₂ : Γ_B) (u : R_Er), τ (g₂ * g₁) u = τ g₁ (τ g₂ u))
       (ε_sheet : Γ_k → R_Er)
       (_hε_idemp : ∀ α : Γ_k, IsIdempotentElem (ε_sheet α))
       (_hε_disj : ∀ α₁ α₂ : Γ_k, α₁ ≠ α₂ →
         Disjoint
           (PrimeSpectrum.basicOpen (ε_sheet α₁) : Set (PrimeSpectrum R_Er))
           (PrimeSpectrum.basicOpen (ε_sheet α₂) : Set (PrimeSpectrum R_Er)))
       (_hε_univ : (⋃ α : Γ_k,
         (PrimeSpectrum.basicOpen (ε_sheet α) : Set (PrimeSpectrum R_Er))) = Set.univ)
       (_hε_act : ∀ (σ : Γ_B) (α : Γ_k), τ σ (ε_sheet (res_k σ * α)) = ε_sheet α),
      let C₁ := R_Er ⧸ Ideal.span {1 - ε_sheet 1}
      let q₁ : R_Er →ₐ[E] C₁ := Ideal.Quotient.mkₐ E (Ideal.span {1 - ε_sheet 1})
      let inc_Ck : C₁ →+* TensorProduct E C₁ k :=
        (Algebra.TensorProduct.includeLeft : C₁ →ₐ[E] TensorProduct E C₁ k).toRingHom
      (∀ f₀ : LocallyConstant (PrimeSpectrum R_Er) (Fin M → ZMod m_mod),
        (∀ (σ : Γ_B) (p : PrimeSpectrum R_Er),
          f₀ (PrimeSpectrum.comap (τ σ).toRingHom p) = ((ρ σ).val).mulVec (f₀ p)) →
        (∀ y : PrimeSpectrum (TensorProduct E C₁ k),
          f₀ (PrimeSpectrum.comap q₁.toRingHom (PrimeSpectrum.comap inc_Ck y)) = 0) →
        f₀ = 0) ∧
      (∀ f_bar : LocallyConstant
           (PrimeSpectrum (TensorProduct E C₁ k)) (Fin M → ZMod m_mod),
        (∀ v : Fin M → ZMod m_mod,
          ∃ e_v : C₁,
            (PrimeSpectrum.basicOpen (inc_Ck e_v) :
              Set (PrimeSpectrum (TensorProduct E C₁ k))) = f_bar ⁻¹' {v}) →
        (∀ (σ : Γ_B),
          res_k σ = 1 →
          ∀ τ₁ : C₁ →ₐ[E] C₁,
            (∀ u : R_Er, τ₁ (q₁ u) = q₁ (τ σ u)) →
            ∀ y : PrimeSpectrum (TensorProduct E C₁ k),
              f_bar (PrimeSpectrum.comap
                (Algebra.TensorProduct.map τ₁ (AlgHom.id E k)).toRingHom y) =
                ((ρ σ).val).mulVec (f_bar y)) →
        ∃ f₀ : LocallyConstant (PrimeSpectrum R_Er) (Fin M → ZMod m_mod),
          (∀ (σ : Γ_B) (p : PrimeSpectrum R_Er),
            f₀ (PrimeSpectrum.comap (τ σ).toRingHom p) = ((ρ σ).val).mulVec (f₀ p)) ∧
          (∀ y : PrimeSpectrum (TensorProduct E C₁ k),
            f₀ (PrimeSpectrum.comap q₁.toRingHom (PrimeSpectrum.comap inc_Ck y)) =
              f_bar y))) :=
by
  classical
  have : NeZero m_mod := ⟨Nat.ne_of_gt hm⟩
  refine ⟨?_, ?_⟩
  · intro E₁ _ R₁ _ _ f_bar₁
    have hCoord : ∀ w : TensorProduct ↥E₁ R₁ k,
        ∃ S : Finset k,
          ∀ (E₂ : IntermediateField F k) [Algebra ↥E₁ ↥E₂]
            (hinc : ∀ x : ↥E₁, (algebraMap ↥E₁ ↥E₂ x : k) = (x : k)),
            (S : Set k) ⊆ (E₂ : Set k) →
            ∃ u : TensorProduct ↥E₁ R₁ ↥E₂,
              Algebra.TensorProduct.map (AlgHom.id ↥E₁ R₁)
                ({ toRingHom := E₂.val.toRingHom
                   commutes' := fun x => hinc x } : ↥E₂ →ₐ[↥E₁] k) u = w := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero =>
        exact ⟨∅, fun E₂ _ hinc _ => ⟨0, map_zero _⟩⟩
      | tmul r c =>
        refine ⟨{c}, fun E₂ _ hinc hsub => ?_⟩
        have hc : c ∈ E₂ := hsub (by simp)
        refine ⟨TensorProduct.tmul ↥E₁ r ⟨c, hc⟩, ?_⟩
        exact Algebra.TensorProduct.map_tmul (AlgHom.id ↥E₁ R₁)
          ({ toRingHom := E₂.val.toRingHom
             commutes' := fun x => hinc x } : ↥E₂ →ₐ[↥E₁] k) r ⟨c, hc⟩
      | add x y ihx ihy =>
        rcases ihx with ⟨Sx, hx⟩
        rcases ihy with ⟨Sy, hy⟩
        refine ⟨Sx ∪ Sy, fun E₂ _ hinc hsub => ?_⟩
        have hsub_x : (Sx : Set k) ⊆ (E₂ : Set k) := fun z hz =>
          hsub (Finset.mem_coe.mpr (Finset.mem_union_left Sy (Finset.mem_coe.mp hz)))
        have hsub_y : (Sy : Set k) ⊆ (E₂ : Set k) := fun z hz =>
          hsub (Finset.mem_coe.mpr (Finset.mem_union_right Sx (Finset.mem_coe.mp hz)))
        obtain ⟨ux, hux⟩ := hx E₂ hinc hsub_x
        obtain ⟨uy, huy⟩ := hy E₂ hinc hsub_y
        exact ⟨ux + uy, by rw [map_add, hux, huy]⟩
    have hex_idemp : ∀ v : Fin M → ZMod m_mod,
        ∃ w : TensorProduct ↥E₁ R₁ k,
          (PrimeSpectrum.basicOpen w : Set (PrimeSpectrum (TensorProduct ↥E₁ R₁ k))) =
            f_bar₁ ⁻¹' {v} := by
      intro v
      have hcl : IsClopen (f_bar₁ ⁻¹' {v}) := f_bar₁.isLocallyConstant.isClopen_fiber v
      obtain ⟨w, _, hw⟩ := PrimeSpectrum.exists_idempotent_basicOpen_eq_of_isClopen hcl
      exact ⟨w, hw.symm⟩
    choose w_fn hw_fn using hex_idemp
    choose S_fn hS_fn using fun v => hCoord (w_fn v)
    let S_all : Finset k := Finset.univ.biUnion S_fn
    let E_S : IntermediateField F k := IntermediateField.adjoin F (S_all : Set k)
    have : FiniteDimensional F ↥E_S :=
      IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
    let E₂ : IntermediateField F k := E₁ ⊔ E_S
    refine ⟨E₂, inferInstance, le_sup_left, ?_⟩
    intro _ hinc v
    have hsub : (S_fn v : Set k) ⊆ (E₂ : Set k) := by
      intro z hz
      have hz_all : z ∈ (S_all : Set k) :=
        Finset.mem_coe.mpr (Finset.mem_biUnion.mpr ⟨v, Finset.mem_univ v, Finset.mem_coe.mp hz⟩)
      have hz_ES : z ∈ E_S := IntermediateField.subset_adjoin F (S_all : Set k) hz_all
      exact (le_sup_right : E_S ≤ E₁ ⊔ E_S) hz_ES
    obtain ⟨u_v, hu_v⟩ := hS_fn v E₂ hinc hsub
    exact ⟨u_v, by rw [hu_v, hw_fn v]⟩
  · intro E _ _ R_Er _ _ Γ_B Γ_k _ _ _ res_k hres_surj ρ τ hτ_one hτ_mul
      ε_sheet hε_idemp hε_disj hε_univ hε_act C₁ q₁ inc_Ck
    have hSurj_Ck : Function.Surjective (PrimeSpectrum.comap inc_Ck) :=
      PrimeSpectrum.comap_surjective_of_faithfullyFlat
    have hRange_q₁ :
        Set.range (PrimeSpectrum.comap q₁.toRingHom) =
          (PrimeSpectrum.basicOpen (ε_sheet 1) : Set (PrimeSpectrum R_Er)) := by
      have : IsLocalization.Away (ε_sheet 1) C₁ :=
        IsLocalization.Away.quotient_of_isIdempotentElem (hε_idemp 1)
      exact PrimeSpectrum.localization_away_comap_range C₁ (ε_sheet 1)
    have hInj_q₁ : Function.Injective (PrimeSpectrum.comap q₁.toRingHom) :=
      PrimeSpectrum.comap_injective_of_surjective q₁.toRingHom Ideal.Quotient.mk_surjective
    let m (σ : Γ_B) (p : PrimeSpectrum R_Er) : PrimeSpectrum R_Er :=
      PrimeSpectrum.comap (τ σ).toRingHom p
    have hm_one : ∀ p : PrimeSpectrum R_Er, m 1 p = p := by
      intro p
      ext u
      change τ 1 u ∈ p.asIdeal ↔ u ∈ p.asIdeal
      rw [hτ_one u]
    have hm_mul : ∀ (g₁ g₂ : Γ_B) (p : PrimeSpectrum R_Er),
        m g₂ (m g₁ p) = m (g₂ * g₁) p := by
      intro g₁ g₂ p
      ext u
      change τ g₁ (τ g₂ u) ∈ p.asIdeal ↔ τ (g₂ * g₁) u ∈ p.asIdeal
      rw [hτ_mul g₁ g₂ u]
    have hSheet_act : ∀ (σ : Γ_B) (α : Γ_k) (p : PrimeSpectrum R_Er),
        m σ p ∈ PrimeSpectrum.basicOpen (ε_sheet (res_k σ * α)) ↔
          p ∈ PrimeSpectrum.basicOpen (ε_sheet α) := by
      intro σ α p
      change τ σ (ε_sheet (res_k σ * α)) ∉ p.asIdeal ↔ ε_sheet α ∉ p.asIdeal
      rw [hε_act σ α]
    have hUnit_mulVec : ∀ (g : (Matrix (Fin M) (Fin M) (ZMod m_mod))ˣ)
        (w v : Fin M → ZMod m_mod),
        g.val.mulVec w = v ↔ w = (g⁻¹).val.mulVec v := by
      intro g w v
      constructor
      · intro h
        rw [← h, Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel, Units.val_one,
          Matrix.one_mulVec]
      · intro h
        rw [h, Matrix.mulVec_mulVec, ← Units.val_mul, mul_inv_cancel, Units.val_one,
          Matrix.one_mulVec]
    refine ⟨?_, ?_⟩
    · intro f₀ hf₀_eqv hf₀_van
      ext p i
      change (f₀ p) i = (0 : Fin M → ZMod m_mod) i
      suffices hp0 : f₀ p = 0 by rw [hp0]
      have hp_univ : p ∈ (⋃ α : Γ_k,
          (PrimeSpectrum.basicOpen (ε_sheet α) : Set (PrimeSpectrum R_Er))) := by
        rw [hε_univ]
        trivial
      obtain ⟨α, hpα⟩ := Set.mem_iUnion.mp hp_univ
      obtain ⟨σ, hσ⟩ := hres_surj α⁻¹
      have hm_mem : m σ p ∈ (PrimeSpectrum.basicOpen (ε_sheet 1) : Set (PrimeSpectrum R_Er)) := by
        have h1 : res_k σ * α = 1 := by rw [hσ, inv_mul_cancel]
        rw [← h1]
        exact (hSheet_act σ α p).mpr hpα
      rw [← hRange_q₁] at hm_mem
      obtain ⟨x₁, hx₁⟩ := hm_mem
      obtain ⟨y, rfl⟩ := hSurj_Ck x₁
      have hmul0 : ((ρ σ).val).mulVec (f₀ p) = 0 := by
        rw [← hf₀_eqv σ p]
        change f₀ (m σ p) = 0
        rw [← hx₁]
        exact hf₀_van y
      rw [(hUnit_mulVec (ρ σ) (f₀ p) 0).mp hmul0, Matrix.mulVec_zero]
    · intro f_bar hf_idemp hf_eqv
      choose e_fn he_fn using hf_idemp
      choose r_fn hr_fn using fun v => Ideal.Quotient.mk_surjective (e_fn v)
      have hq₁_r : ∀ v : Fin M → ZMod m_mod, q₁ (r_fn v) = e_fn v := hr_fn
      have hf_bar_const : ∀ y₁ y₂ : PrimeSpectrum (TensorProduct E C₁ k),
          PrimeSpectrum.comap inc_Ck y₁ = PrimeSpectrum.comap inc_Ck y₂ →
          f_bar y₁ = f_bar y₂ := by
        intro y₁ y₂ hπ
        set v := f_bar y₂
        have hy₂ : y₂ ∈ f_bar ⁻¹' {v} := rfl
        rw [← he_fn v] at hy₂
        have he_not₂ : e_fn v ∉ (PrimeSpectrum.comap inc_Ck y₂).asIdeal := hy₂
        rw [← hπ] at he_not₂
        have hy₁ : y₁ ∈ (PrimeSpectrum.basicOpen (inc_Ck (e_fn v)) :
            Set (PrimeSpectrum (TensorProduct E C₁ k))) := he_not₂
        rw [he_fn v] at hy₁
        exact hy₁
      let f₁ : PrimeSpectrum C₁ → (Fin M → ZMod m_mod) :=
        fun x₁ => f_bar (Classical.choose (hSurj_Ck x₁))
      have hf₁_pull : ∀ y : PrimeSpectrum (TensorProduct E C₁ k),
          f₁ (PrimeSpectrum.comap inc_Ck y) = f_bar y := by
        intro y
        exact hf_bar_const _ y (Classical.choose_spec (hSurj_Ck (PrimeSpectrum.comap inc_Ck y)))
      have hf₁_fiber : ∀ (x₁ : PrimeSpectrum C₁) (v : Fin M → ZMod m_mod),
          f₁ x₁ = v ↔
            PrimeSpectrum.comap q₁.toRingHom x₁ ∈ PrimeSpectrum.basicOpen (r_fn v) := by
        intro x₁ v
        obtain ⟨y, rfl⟩ := hSurj_Ck x₁
        rw [hf₁_pull y]
        change y ∈ f_bar ⁻¹' {v} ↔
          r_fn v ∉ (PrimeSpectrum.comap q₁.toRingHom (PrimeSpectrum.comap inc_Ck y)).asIdeal
        rw [← he_fn v]
        change inc_Ck (e_fn v) ∉ y.asIdeal ↔ q₁ (r_fn v) ∉ (PrimeSpectrum.comap inc_Ck y).asIdeal
        rw [hq₁_r v]
        rfl
      have hKer_lift : ∀ (κ : Γ_B), res_k κ = 1 →
          ∃ τ₁ : C₁ →ₐ[E] C₁,
            (∀ u : R_Er, τ₁ (q₁ u) = q₁ (τ κ u)) ∧
            (∀ x₁ : PrimeSpectrum C₁,
              PrimeSpectrum.comap q₁.toRingHom (PrimeSpectrum.comap τ₁.toRingHom x₁) =
                m κ (PrimeSpectrum.comap q₁.toRingHom x₁)) ∧
            (∀ x₁ : PrimeSpectrum C₁,
              f₁ (PrimeSpectrum.comap τ₁.toRingHom x₁) = ((ρ κ).val).mulVec (f₁ x₁)) := by
        intro κ hκ
        have hε1 : τ κ (ε_sheet 1) = ε_sheet 1 := by
          have h := hε_act κ 1
          rw [hκ, one_mul] at h
          exact h
        have hker : ∀ a ∈ Ideal.span ({1 - ε_sheet 1} : Set R_Er),
            (q₁.comp (τ κ)) a = 0 := by
          intro a ha
          rw [Ideal.mem_span_singleton] at ha
          rcases ha with ⟨b, rfl⟩
          change q₁ (τ κ ((1 - ε_sheet 1) * b)) = 0
          rw [map_mul, map_sub, map_one, hε1, map_mul]
          have hq0 : q₁ (1 - ε_sheet 1) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
          rw [hq0, zero_mul]
        let τ₁ : C₁ →ₐ[E] C₁ :=
          Ideal.Quotient.liftₐ (Ideal.span ({1 - ε_sheet 1} : Set R_Er)) (q₁.comp (τ κ)) hker
        refine ⟨τ₁, fun _ => rfl, ?_, ?_⟩
        · intro x₁
          ext u
          rfl
        · intro x₁
          obtain ⟨y, rfl⟩ := hSurj_Ck x₁
          let y' : PrimeSpectrum (TensorProduct E C₁ k) :=
            PrimeSpectrum.comap (Algebra.TensorProduct.map τ₁ (AlgHom.id E k)).toRingHom y
          have hπ_y' : PrimeSpectrum.comap inc_Ck y' =
              PrimeSpectrum.comap τ₁.toRingHom (PrimeSpectrum.comap inc_Ck y) := by
            ext c
            change (Algebra.TensorProduct.map τ₁ (AlgHom.id E k)) (inc_Ck c) ∈ y.asIdeal ↔
              inc_Ck (τ₁ c) ∈ y.asIdeal
            have hinc_c : (Algebra.TensorProduct.map τ₁ (AlgHom.id E k)) (inc_Ck c) =
                inc_Ck (τ₁ c) :=
              Algebra.TensorProduct.map_tmul τ₁ (AlgHom.id E k) c 1
            rw [hinc_c]
          rw [← hπ_y', hf₁_pull y', hf_eqv κ hκ τ₁ (fun _ => rfl) y, hf₁_pull y]
      let s_lift : Γ_k → Γ_B := fun α =>
        if α = 1 then 1 else Classical.choose (hres_surj α)
      have hs_one : s_lift 1 = 1 := by simp [s_lift]
      have hs_res : ∀ α : Γ_k, res_k (s_lift α) = α := by
        intro α
        by_cases h : α = 1
        · subst h
          simp [s_lift]
        · simp [s_lift, h, Classical.choose_spec (hres_surj α)]
      have hex_sheet : ∀ p : PrimeSpectrum R_Er,
          ∃ α : Γ_k, p ∈ PrimeSpectrum.basicOpen (ε_sheet α) := by
        intro p
        have hp_univ : p ∈ (⋃ α : Γ_k,
            (PrimeSpectrum.basicOpen (ε_sheet α) : Set (PrimeSpectrum R_Er))) := by
          rw [hε_univ]
          trivial
        exact Set.mem_iUnion.mp hp_univ
      choose sheetIdx hsheet_mem using hex_sheet
      have hsheet_eq : ∀ (p : PrimeSpectrum R_Er) (α : Γ_k),
          p ∈ PrimeSpectrum.basicOpen (ε_sheet α) → sheetIdx p = α := by
        intro p α hpα
        by_contra hne
        exact (hε_disj (sheetIdx p) α hne).le_bot ⟨hsheet_mem p, hpα⟩
      have hex_x₁ : ∀ p : PrimeSpectrum R_Er,
          ∃ x₁ : PrimeSpectrum C₁,
            PrimeSpectrum.comap q₁.toRingHom x₁ = m (s_lift (sheetIdx p))⁻¹ p := by
        intro p
        have hm_in : m (s_lift (sheetIdx p))⁻¹ p ∈
            (PrimeSpectrum.basicOpen (ε_sheet 1) : Set (PrimeSpectrum R_Er)) := by
          have h1 : res_k (s_lift (sheetIdx p))⁻¹ * sheetIdx p = 1 := by
            rw [map_inv, hs_res, inv_mul_cancel]
          rw [← h1]
          exact (hSheet_act (s_lift (sheetIdx p))⁻¹ (sheetIdx p) p).mpr (hsheet_mem p)
        rw [← hRange_q₁] at hm_in
        exact hm_in
      choose x₁_of hx₁_of using hex_x₁
      let f₀_fun : PrimeSpectrum R_Er → (Fin M → ZMod m_mod) :=
        fun p => ((ρ (s_lift (sheetIdx p))).val).mulVec (f₁ (x₁_of p))
      have hf₀_fiber_open : ∀ v : Fin M → ZMod m_mod, IsOpen (f₀_fun ⁻¹' {v}) := by
        intro v
        have hEq : f₀_fun ⁻¹' {v} =
            ⋃ α : Γ_k,
              ((PrimeSpectrum.basicOpen (ε_sheet α) : Set (PrimeSpectrum R_Er)) ∩
                (PrimeSpectrum.basicOpen
                  (τ (s_lift α)⁻¹ (r_fn (((ρ (s_lift α))⁻¹).val.mulVec v))) :
                  Set (PrimeSpectrum R_Er))) := by
          ext p
          simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iUnion, Set.mem_inter_iff]
          constructor
          · intro hp
            refine ⟨sheetIdx p, hsheet_mem p, ?_⟩
            have hf₁_val : f₁ (x₁_of p) = ((ρ (s_lift (sheetIdx p)))⁻¹).val.mulVec v :=
              (hUnit_mulVec (ρ (s_lift (sheetIdx p))) (f₁ (x₁_of p)) v).mp hp
            have hbo := (hf₁_fiber (x₁_of p) _).mp hf₁_val
            rw [hx₁_of p] at hbo
            exact hbo
          · rintro ⟨α, hpα, hbo⟩
            have hidx : sheetIdx p = α := hsheet_eq p α hpα
            have hbo' : PrimeSpectrum.comap q₁.toRingHom (x₁_of p) ∈
                PrimeSpectrum.basicOpen (r_fn (((ρ (s_lift α))⁻¹).val.mulVec v)) := by
              rw [hx₁_of p, hidx]
              exact hbo
            have hf₁_val : f₁ (x₁_of p) = ((ρ (s_lift α))⁻¹).val.mulVec v :=
              (hf₁_fiber (x₁_of p) _).mpr hbo'
            change ((ρ (s_lift (sheetIdx p))).val).mulVec (f₁ (x₁_of p)) = v
            rw [hidx]
            exact (hUnit_mulVec (ρ (s_lift α)) (f₁ (x₁_of p)) v).mpr hf₁_val
        rw [hEq]
        exact isOpen_iUnion fun α =>
          (PrimeSpectrum.basicOpen _).isOpen.inter (PrimeSpectrum.basicOpen _).isOpen
      have hf₀_lc : IsLocallyConstant f₀_fun := by
        intro s
        have hs_eq : f₀_fun ⁻¹' s = ⋃ v ∈ s, f₀_fun ⁻¹' {v} := by
          ext p
          simp
        rw [hs_eq]
        exact isOpen_biUnion fun v _ => hf₀_fiber_open v
      let f₀ : LocallyConstant (PrimeSpectrum R_Er) (Fin M → ZMod m_mod) := ⟨f₀_fun, hf₀_lc⟩
      refine ⟨f₀, ?_, ?_⟩
      · intro σ p
        let α := sheetIdx p
        let p' := m σ p
        let β := res_k σ * α
        have hp'β : p' ∈ PrimeSpectrum.basicOpen (ε_sheet β) :=
          (hSheet_act σ α p).mpr (hsheet_mem p)
        have hidx' : sheetIdx p' = β := hsheet_eq p' β hp'β
        let κ : Γ_B := (s_lift β)⁻¹ * σ * s_lift α
        have hκ_res : res_k κ = 1 := by
          dsimp [κ, β]
          rw [map_mul, map_mul, map_inv, hs_res, hs_res, mul_assoc, inv_mul_cancel]
        obtain ⟨τ₁, _, hτ₁_comap, hf₁_κ⟩ := hKer_lift κ hκ_res
        have hx₁_p' : x₁_of p' = PrimeSpectrum.comap τ₁.toRingHom (x₁_of p) := by
          apply hInj_q₁
          rw [hτ₁_comap (x₁_of p), hx₁_of p, hx₁_of p', hidx']
          change m (s_lift β)⁻¹ (m σ p) = m κ (m (s_lift α)⁻¹ p)
          rw [hm_mul, hm_mul]
          have hgrp : κ * (s_lift α)⁻¹ = (s_lift β)⁻¹ * σ := by
            dsimp [κ]
            exact mul_inv_cancel_right ((s_lift β)⁻¹ * σ) (s_lift α)
          rw [hgrp]
        have hgrp₂ : s_lift β * κ = σ * s_lift α := by
          dsimp [κ]
          rw [← mul_assoc, ← mul_assoc, mul_inv_cancel, one_mul]
        change ((ρ (s_lift (sheetIdx p'))).val).mulVec (f₁ (x₁_of p')) =
          ((ρ σ).val).mulVec (((ρ (s_lift α)).val).mulVec (f₁ (x₁_of p)))
        rw [hidx', hx₁_p', hf₁_κ (x₁_of p), Matrix.mulVec_mulVec, ← Units.val_mul,
          ← map_mul ρ, hgrp₂, map_mul ρ, Units.val_mul, ← Matrix.mulVec_mulVec]
      · intro y
        let x₁ : PrimeSpectrum C₁ := PrimeSpectrum.comap inc_Ck y
        let p : PrimeSpectrum R_Er := PrimeSpectrum.comap q₁.toRingHom x₁
        have hp1 : p ∈ (PrimeSpectrum.basicOpen (ε_sheet 1) : Set (PrimeSpectrum R_Er)) := by
          rw [← hRange_q₁]
          exact ⟨x₁, rfl⟩
        have hidx1 : sheetIdx p = 1 := hsheet_eq p 1 hp1
        have hx₁_eq : x₁_of p = x₁ := by
          apply hInj_q₁
          rw [hx₁_of p, hidx1, hs_one, inv_one, hm_one p]
        change ((ρ (s_lift (sheetIdx p))).val).mulVec (f₁ (x₁_of p)) = f_bar y
        rw [hidx1, hs_one, hx₁_eq, map_one ρ, Units.val_one, Matrix.one_mulVec]
        exact hf₁_pull y

theorem weil_ind_etale_affine_cover_pullback_isos (F : Type u) [Field F]
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    [AlgebraicGeometry.IsAffineHom U₀.ι]
    (U_bar : (weilGeomScheme F (weilProjectiveSpaceOver F 1)).Opens)
    (W₀ : (weilProjectiveSpaceOver F 1).left.Etale)
    (C₀ : Type u) [CommRing C₀] [Algebra F C₀]
    (j_C₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of C₀))
      ((AlgebraicGeometry.Scheme.Etale.forget (weilProjectiveSpaceOver F 1).left).obj W₀).left)
    (hj_C₀_hom :
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp j_C₀
          ((AlgebraicGeometry.Scheme.Etale.forget
            (weilProjectiveSpaceOver F 1).left).obj W₀).hom)
        (weilProjectiveSpaceOver F 1).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F C₀))) :
    let D₀ := weilProjectiveSpaceOver F 1
    let S_bar := weilGeomScheme F D₀
    let k := AlgebraicClosure F
    let f_ext := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
    let pr_D := CategoryTheory.Limits.pullback.fst D₀.hom f_ext
    let pr_k := CategoryTheory.Limits.pullback.snd D₀.hom f_ext
    let Fgt_D := AlgebraicGeometry.Scheme.Etale.forget D₀.left
    let Fgt_U := AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme
    let Fgt_S := AlgebraicGeometry.Scheme.Etale.forget S_bar
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    let R0_bar := TensorProduct F R₀ k
    let B_j := weilEtaleSitePullback U₀.ι
    let B_pr := weilEtaleSitePullback pr_D
    ∀ (B B_bar : Type u) [CommRing B] [CommRing B_bar]
      [Algebra R₀ B] [Algebra R0_bar B_bar]
      (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme)
      (_he_U_hom :
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι) D₀.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F R₀)))
      (q_B : B →+* B_bar) (q_k : k →+* B_bar)
      (e_Ubar : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R0_bar)) U_bar.toScheme)
      (_heUbar_prD :
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp e_Ubar.hom U_bar.ι) pr_D =
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Algebra.TensorProduct.includeLeft : R₀ →ₐ[F] R0_bar).toRingHom))
            (CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι))
      (_heUbar_prk :
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp e_Ubar.hom U_bar.ι) pr_k =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : k →ₐ[F] R0_bar).toRingHom))
      (_htmalg : ∀ (z : R₀) (c : k),
        algebraMap R0_bar B_bar (TensorProduct.tmul F z c) =
          q_B (algebraMap R₀ B z) * q_k c),
      let π_r := CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B))) e_U.hom
      let π_bar := CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R0_bar B_bar))) e_Ubar.hom
      let ι_V := CategoryTheory.CategoryStruct.comp π_bar U_bar.ι
      ∃ (C₀_U : Type u)
        (_ : CommRing C₀_U) (_ : Algebra F C₀_U) (_ : Algebra C₀ C₀_U) (_ : Algebra R₀ C₀_U)
        (_ : IsScalarTower F C₀ C₀_U) (_ : IsScalarTower F R₀ C₀_U),
        ∀ (A : Type u)
          [CommRing A] [Algebra F A] [Algebra C₀ A] [Algebra k A]
          [IsScalarTower F C₀ A] [IsScalarTower F k A]
          (P_bar D_bar : Type u) [CommRing P_bar] [Algebra R0_bar P_bar] [CommRing D_bar]
          (_e_Pbar : TensorProduct C₀ C₀_U A ≃+* P_bar)
          (_hAlg_Pbar : ∀ (z : R₀) (c : k),
            algebraMap R0_bar P_bar (TensorProduct.tmul F z c) =
              _e_Pbar (TensorProduct.tmul C₀ (algebraMap R₀ C₀_U z) (algebraMap k A c)))
          (_e_Dbar : TensorProduct R0_bar P_bar B_bar ≃+* D_bar)
          (Z' : S_bar.Etale)
          (_hZ'_left : (Fgt_S.obj Z').left = AlgebraicGeometry.Spec (CommRingCat.of A))
          (_hZ'_prD : HEq (CategoryTheory.CategoryStruct.comp (Fgt_S.obj Z').hom pr_D)
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₀ A)))
              (CategoryTheory.CategoryStruct.comp j_C₀ (Fgt_D.obj W₀).hom)))
          (_hZ'_prk : HEq (CategoryTheory.CategoryStruct.comp (Fgt_S.obj Z').hom pr_k)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))),
          let Z'_V := CategoryTheory.Limits.pullback (Fgt_S.obj Z').hom ι_V
          ∃ (iso_ZV : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of D_bar)) Z'_V),
            (∀ (γ : B_bar ≃ₐ[R0_bar] B_bar) (m_γ : Quiver.Hom Z'_V Z'_V),
              CategoryTheory.CategoryStruct.comp m_γ
                (CategoryTheory.Limits.pullback.fst (Fgt_S.obj Z').hom ι_V) =
                CategoryTheory.Limits.pullback.fst (Fgt_S.obj Z').hom ι_V →
              CategoryTheory.CategoryStruct.comp m_γ
                (CategoryTheory.Limits.pullback.snd (Fgt_S.obj Z').hom ι_V) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd (Fgt_S.obj Z').hom ι_V)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.symm.toRingHom)) →
              CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  (_e_Dbar.toRingHom.comp
                    ((Algebra.TensorProduct.map (AlgHom.id R0_bar P_bar) γ.symm.toAlgHom).toRingHom.comp
                      _e_Dbar.symm.toRingHom))))
                iso_ZV.hom =
                CategoryTheory.CategoryStruct.comp iso_ZV.hom m_γ) ∧
            ∀ (A_E : Type u)
              [CommRing A_E] [Algebra C₀ A_E]
              (inc_AE : A_E →+* A)
              (_hinc_C₀ : ∀ c : C₀, inc_AE (algebraMap C₀ A_E c) = algebraMap C₀ A c)
              (W_E : D₀.left.Etale)
              (_hWE_left : (Fgt_D.obj W_E).left = AlgebraicGeometry.Spec (CommRingCat.of A_E))
              (_hWE_hom : HEq (Fgt_D.obj W_E).hom
                (CategoryTheory.CategoryStruct.comp
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₀ A_E)))
                  (CategoryTheory.CategoryStruct.comp j_C₀ (Fgt_D.obj W₀).hom)))
              (q_E : Quiver.Hom Z' (B_pr.obj W_E))
              (_hqE_fst : HEq
                (CategoryTheory.CategoryStruct.comp (Fgt_S.map q_E).left
                  (CategoryTheory.Limits.pullback.fst (Fgt_D.obj W_E).hom pr_D))
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inc_AE))),
              let P_E := TensorProduct C₀ C₀_U A_E
              let R_Er := TensorProduct R₀ P_E B
              let h_WE_U := (Fgt_U.obj (B_j.obj W_E)).hom
              let W_Er := CategoryTheory.Limits.pullback h_WE_U π_r
              let Bpr_V := CategoryTheory.Limits.pullback (Fgt_S.obj (B_pr.obj W_E)).hom ι_V
              ∃ (φ₀ : R_Er →+* D_bar)
                (iso_WEr : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R_Er)) W_Er)
                (q_EV : Quiver.Hom Z'_V Bpr_V)
                (θ_WE : Quiver.Hom Bpr_V W_Er),
                (∀ (c_U : C₀_U) (a_E : A_E) (b : B),
                  φ₀ (TensorProduct.tmul R₀ (TensorProduct.tmul C₀ c_U a_E) b) =
                    _e_Dbar (TensorProduct.tmul R0_bar
                      (_e_Pbar (TensorProduct.tmul C₀ c_U (inc_AE a_E))) (q_B b))) ∧
                (∀ (σ : B ≃ₐ[R₀] B) (m_σ : Quiver.Hom W_Er W_Er),
                  CategoryTheory.CategoryStruct.comp m_σ
                    (CategoryTheory.Limits.pullback.fst h_WE_U π_r) =
                    CategoryTheory.Limits.pullback.fst h_WE_U π_r →
                  CategoryTheory.CategoryStruct.comp m_σ
                    (CategoryTheory.Limits.pullback.snd h_WE_U π_r) =
                    CategoryTheory.CategoryStruct.comp
                      (CategoryTheory.Limits.pullback.snd h_WE_U π_r)
                      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
                  CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                      (Algebra.TensorProduct.map (AlgHom.id R₀ P_E) σ.symm.toAlgHom).toRingHom))
                    iso_WEr.hom =
                    CategoryTheory.CategoryStruct.comp iso_WEr.hom m_σ) ∧
                CategoryTheory.CategoryStruct.comp q_EV
                  (CategoryTheory.Limits.pullback.fst (Fgt_S.obj (B_pr.obj W_E)).hom ι_V) =
                  CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.Limits.pullback.fst (Fgt_S.obj Z').hom ι_V)
                    (Fgt_S.map q_E).left ∧
                CategoryTheory.CategoryStruct.comp q_EV
                  (CategoryTheory.Limits.pullback.snd (Fgt_S.obj (B_pr.obj W_E)).hom ι_V) =
                  CategoryTheory.Limits.pullback.snd (Fgt_S.obj Z').hom ι_V ∧
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.CategoryStruct.comp θ_WE
                    (CategoryTheory.Limits.pullback.fst h_WE_U π_r))
                  (CategoryTheory.Limits.pullback.fst (Fgt_D.obj W_E).hom U₀.ι) =
                  CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.Limits.pullback.fst (Fgt_S.obj (B_pr.obj W_E)).hom ι_V)
                    (CategoryTheory.Limits.pullback.fst (Fgt_D.obj W_E).hom pr_D) ∧
                CategoryTheory.CategoryStruct.comp θ_WE
                  (CategoryTheory.Limits.pullback.snd h_WE_U π_r) =
                  CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.Limits.pullback.snd (Fgt_S.obj (B_pr.obj W_E)).hom ι_V)
                    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_B)) ∧
                CategoryTheory.CategoryStruct.comp iso_ZV.hom
                  (CategoryTheory.CategoryStruct.comp q_EV θ_WE) =
                  CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) iso_WEr.hom :=
by
  
  have heq_dom_eq : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}}
      {f : X ⟶ Z} {g : Y ⟶ Z} (h : X = Y), HEq f g →
      CategoryTheory.eqToHom h.symm ≫ f = g := by
    intro X Y Z f g h hfg
    subst h; cases hfg; exact CategoryTheory.Category.id_comp f
  have heq_dom_cod_eq : ∀ {X₁ Y₁ X₂ Y₂ : AlgebraicGeometry.Scheme.{u}}
      {f : X₁ ⟶ X₂} {g : Y₁ ⟶ Y₂} (h₁ : X₁ = Y₁) (h₂ : X₂ = Y₂), HEq f g →
      CategoryTheory.eqToHom h₁.symm ≫ f ≫ CategoryTheory.eqToHom h₂ = g := by
    intro X₁ Y₁ X₂ Y₂ f g h₁ h₂ hfg
    subst h₁; subst h₂; cases hfg; simp
  let specEquivIso : ∀ {R S : Type u} [CommRing R] [CommRing S] (e : R ≃+* S),
      CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of S))
        (AlgebraicGeometry.Spec (CommRingCat.of R)) := fun e =>
    { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.toRingHom)
      inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.symm.toRingHom)
      hom_inv_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h : e.toRingHom.comp e.symm.toRingHom = RingHom.id _ :=
          RingHom.ext e.apply_symm_apply
        rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      inv_hom_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h : e.symm.toRingHom.comp e.toRingHom = RingHom.id _ :=
          RingHom.ext e.symm_apply_apply
        rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
  have isPullback_spec_tensor : ∀ (R S T : Type u) [CommRing R] [CommRing S] [CommRing T]
      [Algebra R S] [Algebra R T],
      CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom : S →+* TensorProduct R S T)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : T →ₐ[R] TensorProduct R S T).toRingHom))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R T))) := by
    intro R S T _ _ _ _ _
    refine (CategoryTheory.IsPullback.of_hasPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S)))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R T)))).of_iso
      (AlgebraicGeometry.pullbackSpecIso R S T)
      (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
      (by simp) (by simp) (by simp) (by simp)
  have spec_map_inj : ∀ {R S : Type u} [CommRing R] [CommRing S] {f g : R →+* S},
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom g) → f = g := by
    intro R S _ _ f g h
    have h1 : Opposite.op (CommRingCat.ofHom f) = Opposite.op (CommRingCat.ofHom g) :=
      AlgebraicGeometry.Spec.fullyFaithful.map_injective h
    exact congrArg CommRingCat.Hom.hom (congrArg Opposite.unop h1)

  
  intro D₀ S_bar k f_ext pr_D pr_k Fgt_D Fgt_U Fgt_S R₀ R0_bar B_j B_pr
    B B_bar _ _ _ _ e_U _he_U_hom q_B q_k e_Ubar _heUbar_prD _heUbar_prk _htmalg
    π_r π_bar ι_V

  let h_C₀ : AlgebraicGeometry.Spec (CommRingCat.of C₀) ⟶ D₀.left :=
    j_C₀ ≫ (Fgt_D.obj W₀).hom
  let X_CU : AlgebraicGeometry.Scheme.{u} :=
    CategoryTheory.Limits.pullback h_C₀ U₀.ι
  let R_CU : CommRingCat.{u} := X_CU.presheaf.obj (Opposite.op ⊤)
  let C₀_U : Type u := ↑R_CU
  letI : CommRing C₀_U := inferInstance
  let e_CU : AlgebraicGeometry.Spec (CommRingCat.of C₀_U) ≅ X_CU :=
    X_CU.isoSpec.symm
  let p_C₀ : AlgebraicGeometry.Spec (CommRingCat.of C₀_U) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of C₀) :=
    e_CU.hom ≫ CategoryTheory.Limits.pullback.fst h_C₀ U₀.ι
  let p_R₀ : AlgebraicGeometry.Spec (CommRingCat.of C₀_U) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
    e_CU.hom ≫ CategoryTheory.Limits.pullback.snd h_C₀ U₀.ι ≫ e_U.inv
  let φ_C₀ : C₀ →+* C₀_U :=
    CommRingCat.Hom.hom (AlgebraicGeometry.Spec.fullyFaithful.preimage p_C₀).unop
  let φ_R₀ : R₀ →+* C₀_U :=
    CommRingCat.Hom.hom (AlgebraicGeometry.Spec.fullyFaithful.preimage p_R₀).unop
  have hSpec_φC₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_C₀) = p_C₀ :=
    AlgebraicGeometry.Spec.fullyFaithful.map_preimage p_C₀
  have hSpec_φR₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R₀) = p_R₀ :=
    AlgebraicGeometry.Spec.fullyFaithful.map_preimage p_R₀

  let instAlgC₀ : Algebra C₀ C₀_U := φ_C₀.toAlgebra
  let instAlgR₀ : Algebra R₀ C₀_U := φ_R₀.toAlgebra
  let instAlgF : Algebra F C₀_U := (φ_C₀.comp (algebraMap F C₀)).toAlgebra
  letI : Algebra C₀ C₀_U := instAlgC₀
  letI : Algebra R₀ C₀_U := instAlgR₀
  letI : Algebra F C₀_U := instAlgF
  have hST_FC₀ : IsScalarTower F C₀ C₀_U := IsScalarTower.of_algebraMap_eq' rfl
  have hST_FR₀ : IsScalarTower F R₀ C₀_U := by
    apply IsScalarTower.of_algebraMap_eq'
    change φ_C₀.comp (algebraMap F C₀) = φ_R₀.comp (algebraMap F R₀)
    apply spec_map_inj
    rw [CommRingCat.ofHom_comp, CommRingCat.ofHom_comp,
      AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
      hSpec_φC₀, hSpec_φR₀, ← hj_C₀_hom, ← _he_U_hom]
    change (e_CU.hom ≫ CategoryTheory.Limits.pullback.fst h_C₀ U₀.ι) ≫ (h_C₀ ≫ D₀.hom) =
      (e_CU.hom ≫ CategoryTheory.Limits.pullback.snd h_C₀ U₀.ι ≫ e_U.inv) ≫
        ((e_U.hom ≫ U₀.ι) ≫ D₀.hom)
    have hcond : CategoryTheory.Limits.pullback.fst h_C₀ U₀.ι ≫ h_C₀ =
        CategoryTheory.Limits.pullback.snd h_C₀ U₀.ι ≫ U₀.ι :=
      CategoryTheory.Limits.pullback.condition
    simp only [CategoryTheory.Category.assoc]
    rw [← CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.fst h_C₀ U₀.ι) h_C₀,
      hcond, CategoryTheory.Category.assoc, e_U.inv_hom_id_assoc]
  letI : IsScalarTower F C₀ C₀_U := hST_FC₀
  letI : IsScalarTower F R₀ C₀_U := hST_FR₀

  have hPB_CU_U : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₀ C₀_U)))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ C₀_U)) ≫ e_U.hom)
      h_C₀ U₀.ι := by
    refine (CategoryTheory.IsPullback.of_hasPullback h_C₀ U₀.ι).of_iso
      e_CU.symm (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
      ?_ ?_ (by simp) (by simp)
    · change CategoryTheory.Limits.pullback.fst h_C₀ U₀.ι ≫ 𝟙 _ =
        e_CU.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_C₀)
      rw [CategoryTheory.Category.comp_id, hSpec_φC₀]
      dsimp [p_C₀]
      rw [e_CU.inv_hom_id_assoc]
    · change CategoryTheory.Limits.pullback.snd h_C₀ U₀.ι ≫ 𝟙 _ =
        e_CU.inv ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R₀) ≫ e_U.hom)
      rw [CategoryTheory.Category.comp_id, hSpec_φR₀]
      dsimp [p_R₀]
      simp only [CategoryTheory.Category.assoc, e_U.inv_hom_id,
        CategoryTheory.Category.comp_id, e_CU.inv_hom_id_assoc]

  have hPB_CU_R₀ : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₀ C₀_U)))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ C₀_U)))
