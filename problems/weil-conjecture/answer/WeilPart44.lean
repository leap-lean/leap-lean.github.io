import WeilPart43
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_mid_ext_geom_punctured_curve_and_frob_galois_cover (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hu₀_mem : Set.range u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left))
    (U_bar : (weilGeomScheme F (weilProjectiveSpaceOver F 1)).Opens)
    (hU_bar : U_bar = (TopologicalSpace.Opens.map
      ((CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap F (AlgebraicClosure F))))) :
        Quiver.Hom (weilGeomScheme F (weilProjectiveSpaceOver F 1))
          (weilProjectiveSpaceOver F 1).left).base).obj U₀)
    [IsDomain (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))]
    [IsDomain (TensorProduct F
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
      (AlgebraicClosure F))]
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U₀.toScheme)
    (he_U : CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (Polynomial F)
            (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))))))
        j_aff)
    (B : ℕ → Type u)
    [∀ r, CommRing (B r)] [∀ r, IsDomain (B r)]
    [∀ r, Algebra
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B r)]
    [∀ r, Module.Finite
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B r)]
    (σ_u : ∀ r : ℕ,
      B r ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B r)
    (B_bar : ℕ → Type u)
    [∀ r, CommRing (B_bar r)] [∀ r, IsDomain (B_bar r)]
    [∀ r, Algebra
      (TensorProduct F
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
        (AlgebraicClosure F)) (B_bar r)]
    [∀ r, Module.Finite
      (TensorProduct F
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
        (AlgebraicClosure F)) (B_bar r)]
    [∀ r, Algebra.Etale
      (TensorProduct F
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
        (AlgebraicClosure F)) (B_bar r)]
    (q_B : ∀ r : ℕ, B r →+* B_bar r)
    (q_k : ∀ r : ℕ, AlgebraicClosure F →+* B_bar r)
    (ι_Bbar : ∀ r : ℕ,
      B_bar r →ₐ[TensorProduct F
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
        (AlgebraicClosure F)] B_bar (r + 1))
    (φ_frob : ∀ r : ℕ, B_bar r →+* B_bar r)
    (m_g : ℕ → ℕ)
    (equiv_Γg : ∀ r : ℕ,
      Fin (m_g r) ≃
        (B_bar r ≃ₐ[TensorProduct F
          (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
          (AlgebraicClosure F)] B_bar r))
    (e_bar : ∀ r : ℕ,
      Fin (m_g r) →
        TensorProduct
          (TensorProduct F
            (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
            (AlgebraicClosure F))
          (B_bar r) (B_bar r))
    (hGeom : ∀ r : ℕ,
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      let k := AlgebraicClosure F
      let ψ_frob := (@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) k _ _ _).symm
      let R0_bar := TensorProduct F R₀ k
      Function.Injective (algebraMap R0_bar (B_bar r)) ∧
      (∀ (z : R₀) (c : k),
        algebraMap R0_bar (B_bar r) (TensorProduct.tmul F z c) =
          q_B r (algebraMap R₀ (B r) z) * q_k r c) ∧
      (∀ {A : Type u} [CommRing A] (f₁ f₂ : B_bar r →+* A),
        (∀ b : B r, f₁ (q_B r b) = f₂ (q_B r b)) →
        (∀ c : k, f₁ (q_k r c) = f₂ (q_k r c)) →
        f₁ = f₂) ∧
      (∀ b : B r, φ_frob r (q_B r b) = q_B r (σ_u r b)) ∧
      (∀ c : k, φ_frob r (q_k r c) = q_k r (ψ_frob c)) ∧
      (∀ i : Fin (m_g r), e_bar r i * e_bar r i = e_bar r i) ∧
      (∀ i j : Fin (m_g r), i ≠ j → e_bar r i * e_bar r j = 0) ∧
      (∑ i : Fin (m_g r), e_bar r i) = 1 ∧
      (∀ i j : Fin (m_g r),
        Algebra.TensorProduct.lift (AlgHom.id (B_bar r) (B_bar r))
          (equiv_Γg r j).symm.toAlgHom
          (fun _ _ => mul_comm _ _) (e_bar r i) = if i = j then 1 else 0) ∧
      (∀ (i : Fin (m_g r)) (z : TensorProduct R0_bar (B_bar r) (B_bar r)),
        z * e_bar r i = TensorProduct.tmul R0_bar
          (Algebra.TensorProduct.lift (AlgHom.id (B_bar r) (B_bar r))
            (equiv_Γg r i).symm.toAlgHom
            (fun _ _ => mul_comm _ _) z) (1 : B_bar r) * e_bar r i)) :
    let D₀ := weilProjectiveSpaceOver F 1
    let S_bar := weilGeomScheme F D₀
    let k := AlgebraicClosure F
    let f_ext := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
    let pr_D : Quiver.Hom S_bar D₀.left := CategoryTheory.Limits.pullback.fst D₀.hom f_ext
    let pr_k : Quiver.Hom S_bar (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Limits.pullback.snd D₀.hom f_ext
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    let R0_bar := TensorProduct F R₀ k
    Nonempty ↥U_bar ∧
    ((U_bar : Set ↥S_bar)ᶜ).Finite ∧
    (weilGeomFrobHom F D₀).base ⁻¹' (U_bar : Set ↥S_bar) = (U_bar : Set ↥S_bar) ∧
    (∀ r : ℕ, Function.Injective (q_B r)) ∧
    ∃ (e_Ubar : CategoryTheory.Iso
        (AlgebraicGeometry.Spec (CommRingCat.of R0_bar)) U_bar.toScheme)
      (φ_equiv : ∀ r : ℕ, B_bar r ≃+* B_bar r),
      let V_bar : ℕ → AlgebraicGeometry.Scheme.{u} :=
        fun r => AlgebraicGeometry.Spec (CommRingCat.of (B_bar r))
      let π_bar : ∀ r : ℕ, Quiver.Hom (V_bar r) U_bar.toScheme :=
        fun r => CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R0_bar (B_bar r))))
          e_Ubar.hom
      let act_bar : ∀ r : ℕ, (B_bar r ≃ₐ[R0_bar] B_bar r) → Quiver.Hom (V_bar r) (V_bar r) :=
        fun r γ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.symm.toRingHom)
      let p_ι : ∀ r : ℕ, Quiver.Hom (V_bar (r + 1)) (V_bar r) :=
        fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_Bbar r).toRingHom)
      (∀ (r : ℕ) (z : B_bar r), φ_equiv r z = φ_frob r z) ∧
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp e_Ubar.hom U_bar.ι) pr_D =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeLeft : R₀ →ₐ[F] R0_bar).toRingHom))
          (CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι) ∧
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp e_Ubar.hom U_bar.ι) pr_k =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : k →ₐ[F] R0_bar).toRingHom) ∧
      (∀ r : ℕ,
        WeilCurveMidExtIsGeomGaloisCover S_bar U_bar
          (B_bar r ≃ₐ[R0_bar] B_bar r) (V_bar r) (π_bar r) (act_bar r)) ∧
      (∀ r : ℕ,
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_equiv r).toRingHom))
          (CategoryTheory.CategoryStruct.comp (π_bar r) U_bar.ι) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp (π_bar r) U_bar.ι)
          (weilGeomFrobHom F D₀)) ∧
      (∀ r : ℕ,
        CategoryTheory.CategoryStruct.comp (p_ι r) (π_bar r) = π_bar (r + 1) ∧
        AlgebraicGeometry.Etale (p_ι r) ∧
        AlgebraicGeometry.Surjective (p_ι r)) ∧
      (∀ (r : ℕ) (W : AlgebraicGeometry.Scheme.{u}) (h_W : Quiver.Hom W S_bar),
        let ι_up := CategoryTheory.CategoryStruct.comp (π_bar (r + 1)) U_bar.ι
        let ι_dn := CategoryTheory.CategoryStruct.comp (π_bar r) U_bar.ι
        ∀ (m_ι : Quiver.Hom (CategoryTheory.Limits.pullback h_W ι_up)
            (CategoryTheory.Limits.pullback h_W ι_dn)),
          CategoryTheory.CategoryStruct.comp m_ι
            (CategoryTheory.Limits.pullback.fst h_W ι_dn) =
            CategoryTheory.Limits.pullback.fst h_W ι_up →
          CategoryTheory.CategoryStruct.comp m_ι
            (CategoryTheory.Limits.pullback.snd h_W ι_dn) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.snd h_W ι_up) (p_ι r) →
          ∀ y₁ y₂ : ↥(CategoryTheory.Limits.pullback h_W ι_up),
            m_ι.base y₁ = m_ι.base y₂ →
            ∃ (γ_up : B_bar (r + 1) ≃ₐ[R0_bar] B_bar (r + 1))
              (m_γup : Quiver.Hom (CategoryTheory.Limits.pullback h_W ι_up)
                (CategoryTheory.Limits.pullback h_W ι_up)),
              CategoryTheory.CategoryStruct.comp m_γup
                (CategoryTheory.Limits.pullback.fst h_W ι_up) =
                CategoryTheory.Limits.pullback.fst h_W ι_up ∧
              CategoryTheory.CategoryStruct.comp m_γup
                (CategoryTheory.Limits.pullback.snd h_W ι_up) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W ι_up) (act_bar (r + 1) γ_up) ∧
              (∀ z : B_bar r, γ_up (ι_Bbar r z) = ι_Bbar r z) ∧
              m_γup.base y₁ = y₂) :=
by
  
  have hInjOfBase : ∀ (R D C : Type u) [CommRing R] [IsDomain R] [CommRing D] [IsDomain D]
      [CommRing C] [Algebra R D] [Module.Finite R D] (f : D →+* C),
      Function.Injective (f.comp (algebraMap R D)) → Function.Injective f := by
    clear hGeom he_U hu₀_mem hu₀_sec hU₀_eq hsinf_compl hsinf_sec hj_hom hj_open
    intro R D C _ _ _ _ _ _ _ f h0
    rw [injective_iff_map_eq_zero]
    intro b hfb
    by_contra hb_ne
    have hInt : Algebra.IsIntegral R D := Algebra.IsIntegral.of_finite R D
    obtain ⟨P, hP_monic, hP_eval⟩ := @Algebra.IsIntegral.isIntegral R D _ _ _ hInt b
    have hP_ne : P ≠ 0 := hP_monic.ne_zero
    let Pred : ℕ → Prop := fun d =>
      ∃ Q : Polynomial R, Q ≠ 0 ∧ Q.natDegree = d ∧ Polynomial.aeval b Q = 0
    classical
    have hex : ∃ d, Pred d := ⟨P.natDegree, P, hP_ne, rfl, hP_eval⟩
    let d₀ := Nat.find hex
    obtain ⟨Q, hQ_ne, hQ_deg, hQ_eval⟩ := Nat.find_spec hex
    have hc0 : Q.coeff 0 ≠ 0 := by
      intro hc0_eq
      obtain ⟨Q₁, hQ₁_eq⟩ := Polynomial.X_dvd_iff.mpr hc0_eq
      have hQ₁_ne : Q₁ ≠ 0 := by
        intro h0_Q₁
        rw [h0_Q₁, mul_zero] at hQ₁_eq
        exact hQ_ne hQ₁_eq
      have hdeg_eq : Q.natDegree = Q₁.natDegree + 1 := by
        rw [hQ₁_eq, Polynomial.natDegree_X_mul hQ₁_ne]
      have hQ₁_eval : Polynomial.aeval b Q₁ = 0 := by
        have hmul : b * Polynomial.aeval b Q₁ = 0 := by
          calc
            b * Polynomial.aeval b Q₁ = Polynomial.aeval b (Polynomial.X * Q₁) := by
              rw [map_mul, Polynomial.aeval_X]
            _ = Polynomial.aeval b Q := by rw [← hQ₁_eq]
            _ = 0 := hQ_eval
        exact (mul_eq_zero.mp hmul).resolve_left hb_ne
      exact Nat.find_min hex (by omega : Q₁.natDegree < d₀) ⟨Q₁, hQ₁_ne, rfl, hQ₁_eval⟩
    have hsub_c0 : (Q - Polynomial.C (Q.coeff 0)).coeff 0 = 0 := by
      rw [Polynomial.coeff_sub, Polynomial.coeff_C_zero, sub_self]
    obtain ⟨Q₂, hQ₂_eq⟩ := Polynomial.X_dvd_iff.mpr hsub_c0
    have hQ_decomp : Q = Polynomial.X * Q₂ + Polynomial.C (Q.coeff 0) := by
      rw [← hQ₂_eq, sub_add_cancel]
    have heval_decomp : b * Polynomial.aeval b Q₂ + algebraMap R D (Q.coeff 0) = 0 := by
      calc
        b * Polynomial.aeval b Q₂ + algebraMap R D (Q.coeff 0) =
            Polynomial.aeval b (Polynomial.X * Q₂ + Polynomial.C (Q.coeff 0)) := by
          rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
        _ = Polynomial.aeval b Q := by rw [← hQ_decomp]
        _ = 0 := hQ_eval
    have hf_zero : (f.comp (algebraMap R D)) (Q.coeff 0) = (f.comp (algebraMap R D)) 0 := by
      change f (algebraMap R D (Q.coeff 0)) = f (algebraMap R D 0)
      rw [map_zero (algebraMap R D), map_zero f]
      have h1 := congrArg f heval_decomp
      rw [map_add, map_mul, hfb, zero_mul, zero_add, map_zero f] at h1
      exact h1
    exact hc0 (h0 hf_zero)

  
  have hEtaleFlat : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [Algebra.Etale A B],
      Module.Flat A B := by
    clear hInjOfBase hGeom he_U hu₀_mem hu₀_sec hU₀_eq hsinf_compl hsinf_sec hj_hom hj_open
    intro A B _ _ _ _
    have h1 : (algebraMap A B).Etale := RingHom.etale_algebraMap.mpr inferInstance
    have h2 : (algebraMap A B).Smooth :=
      (RingHom.etale_iff_formallyUnramified_and_smooth (algebraMap A B)).mp h1 |>.2
    have : Algebra.Smooth A B := RingHom.smooth_algebraMap.mp h2
    infer_instance

  
  have hS4 : ∀ (F₀ R₀ k : Type u) [Field F₀] [CommRing R₀] [IsDomain R₀] [Field k]
      [Algebra F₀ R₀] [Algebra F₀ k]
      (ψ_frob : k ≃ₐ[F₀] k)
      [IsDomain (TensorProduct F₀ R₀ k)]
      (B₀ B_bar₀ : Type u)
      [CommRing B₀] [IsDomain B₀] [Algebra R₀ B₀] [Module.Finite R₀ B₀]
      (σ_u₀ : B₀ ≃ₐ[R₀] B₀)
      [CommRing B_bar₀] [IsDomain B_bar₀]
      [Algebra (TensorProduct F₀ R₀ k) B_bar₀]
      [Module.Finite (TensorProduct F₀ R₀ k) B_bar₀]
      [Algebra.Etale (TensorProduct F₀ R₀ k) B_bar₀]
      (q_B₀ : B₀ →+* B_bar₀)
      (q_k₀ : k →+* B_bar₀)
      (φ_frob₀ : B_bar₀ →+* B_bar₀),
      Function.Injective (algebraMap (TensorProduct F₀ R₀ k) B_bar₀) →
      (∀ (z : R₀) (c : k),
        algebraMap (TensorProduct F₀ R₀ k) B_bar₀ (TensorProduct.tmul F₀ z c) =
          q_B₀ (algebraMap R₀ B₀ z) * q_k₀ c) →
      (∀ {A : Type u} [CommRing A] (f₁ f₂ : B_bar₀ →+* A),
        (∀ b : B₀, f₁ (q_B₀ b) = f₂ (q_B₀ b)) →
        (∀ c : k, f₁ (q_k₀ c) = f₂ (q_k₀ c)) →
        f₁ = f₂) →
      (∀ b : B₀, φ_frob₀ (q_B₀ b) = q_B₀ (σ_u₀ b)) →
      (∀ c : k, φ_frob₀ (q_k₀ c) = q_k₀ (ψ_frob c)) →
      let R0_bar := TensorProduct F₀ R₀ k
      Function.Injective q_B₀ ∧
      Function.Bijective φ_frob₀ ∧
      (∀ z : R₀,
        φ_frob₀ (algebraMap R0_bar B_bar₀
          ((Algebra.TensorProduct.includeLeft : R₀ →ₐ[F₀] R0_bar) z)) =
          algebraMap R0_bar B_bar₀
            ((Algebra.TensorProduct.includeLeft : R₀ →ₐ[F₀] R0_bar) z)) ∧
      (∀ c : k,
        φ_frob₀ (algebraMap R0_bar B_bar₀
          ((Algebra.TensorProduct.includeRight : k →ₐ[F₀] R0_bar) c)) =
          algebraMap R0_bar B_bar₀
            ((Algebra.TensorProduct.includeRight : k →ₐ[F₀] R0_bar) (ψ_frob c))) := by
    clear hGeom he_U hu₀_mem hu₀_sec hU₀_eq hsinf_compl hsinf_sec hj_hom hj_open
    intro F₀ R₀ k _ _ _ _ _ _ ψ_frob _ B₀ B_bar₀ _ _ _ _ σ_u₀ _ _ _ _ _
      q_B₀ q_k₀ φ_frob₀ hInj_bar hAlg_tmul hEpi hφ_B hφ_k
    let R0_bar := TensorProduct F₀ R₀ k
    have hInj_qB : Function.Injective q_B₀ := by
      obtain ⟨g_ret, hg_ret⟩ := LinearMap.exists_leftInverse_of_injective (Algebra.linearMap F₀ k)
        (LinearMap.ker_eq_bot.mpr (RingHom.injective (algebraMap F₀ k)))
      have hg_one : g_ret 1 = 1 := by
        have h1 := LinearMap.congr_fun hg_ret (1 : F₀)
        simpa using h1
      let ret_R0 : R0_bar →ₗ[F₀] R₀ :=
        (TensorProduct.rid F₀ R₀).toLinearMap.comp (LinearMap.lTensor R₀ g_ret)
      have hret_tmul : ∀ z : R₀, ret_R0 (TensorProduct.tmul F₀ z (1 : k)) = z := by
        intro z
        dsimp only [ret_R0, LinearMap.comp_apply, LinearEquiv.coe_coe]
        rw [LinearMap.lTensor_tmul, hg_one, TensorProduct.rid_tmul, one_smul]
      have hInj_comp : Function.Injective (q_B₀.comp (algebraMap R₀ B₀)) := by
        intro z₁ z₂ hz
        have hbar : algebraMap R0_bar B_bar₀ (TensorProduct.tmul F₀ z₁ (1 : k)) =
            algebraMap R0_bar B_bar₀ (TensorProduct.tmul F₀ z₂ (1 : k)) := by
          rw [hAlg_tmul, hAlg_tmul, map_one, mul_one, mul_one]
          exact hz
        have htmul := hInj_bar hbar
        rw [← hret_tmul z₁, ← hret_tmul z₂, htmul]
      exact hInjOfBase R₀ B₀ B_bar₀ q_B₀ hInj_comp
    let φ₀ : R0_bar ≃ₐ[F₀] R0_bar := Algebra.TensorProduct.congr AlgEquiv.refl ψ_frob
    have hφ_alg : ∀ w : R0_bar,
        φ_frob₀ (algebraMap R0_bar B_bar₀ w) = algebraMap R0_bar B_bar₀ (φ₀ w) := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero, map_zero, map_zero]
      | tmul z c =>
        change φ_frob₀ (algebraMap R0_bar B_bar₀ (TensorProduct.tmul F₀ z c)) =
          algebraMap R0_bar B_bar₀ (TensorProduct.tmul F₀ z (ψ_frob c))
        rw [hAlg_tmul, hAlg_tmul, map_mul, hφ_B, hφ_k, σ_u₀.commutes]
      | add x y ihx ihy => rw [map_add, map_add, map_add, map_add, ihx, ihy]
    have hInj_frob : Function.Injective φ_frob₀ := by
      apply hInjOfBase R0_bar B_bar₀ B_bar₀ φ_frob₀
      intro w₁ w₂ hw
      change φ_frob₀ (algebraMap R0_bar B_bar₀ w₁) = φ_frob₀ (algebraMap R0_bar B_bar₀ w₂) at hw
      rw [hφ_alg, hφ_alg] at hw
      exact φ₀.injective (hInj_bar hw)
    have hSurj_frob : Function.Surjective φ_frob₀ := by
      let A₀ : Subring B_bar₀ := φ_frob₀.range
      have hqB_mem : ∀ b : B₀, q_B₀ b ∈ A₀ :=
