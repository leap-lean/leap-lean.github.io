    obtain ⟨s_qy, hs_qy_sec, hs_qy_pt⟩ := hEtaleSec P_V f₂ q_y
    let γ₀ : Quiver.Hom S_k A₀ := CategoryTheory.CategoryStruct.comp s_qy f₁
    have hγ₀_zy : γ₀.base pt_k = z_y := (congrArg f₁.base hs_qy_pt).trans hq_y_fst
    have hγ₀_range : Set.range γ₀.base ⊆ Set.range j₁.base := by
      rw [hAff_V₁.range_fromSpec]
      rintro _ ⟨p, rfl⟩
      rw [Subsingleton.elim p pt_k, hγ₀_zy]
      exact hzy_V₁
    let γ_x : Quiver.Hom S_k A₁ := AlgebraicGeometry.IsOpenImmersion.lift j₁ γ₀ hγ₀_range
    have hγ_x_fac : CategoryTheory.CategoryStruct.comp γ_x j₁ = γ₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j₁ γ₀ hγ₀_range
    have hγ_x_pt : γ_x.base pt_k = y' := by
      apply hAff_V₁.fromSpec.isOpenEmbedding.injective
      have h1 : j₁.base (γ_x.base pt_k) = γ₀.base pt_k :=
        congrArg (fun φ => φ.base pt_k) hγ_x_fac
      rw [h1, hγ₀_zy, ← hj₁_y']
    have hγ_x_fx : CategoryTheory.CategoryStruct.comp γ_x f_x = σ_x := by
      dsimp [f_x]
      rw [← CategoryTheory.Category.assoc, hγ_x_fac]
      change (s_qy ≫ f₁) ≫ g₀ = σ_x
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc, hs_qy_sec, CategoryTheory.Category.id_comp]
    have hγ_x_sec : CategoryTheory.CategoryStruct.comp γ_x
