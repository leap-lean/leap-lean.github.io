    D₀.left.smallEtaleTopology U₀.toScheme.smallEtaleTopology hCont_j).obj ℒ₀_r

  have hBaseInv : ∀ (W₀ : D₀.left.Etale) (s₀ : ↑(ℱ₀_r.obj.obj (Opposite.op W₀)))
      (y : ↥(CategoryTheory.Limits.pullback (Fgt.obj (B_pr.obj W₀)).hom ι_V)),
      triv_ab_r (G.obj (B_pr.obj W₀))
        ((ℳ_ab_r.obj.map (Opposite.op (ν.app W₀))).hom
          ((η_r.hom.app (Opposite.op W₀)).hom s₀))
        ((ξ_can (B_pr.obj W₀)).base y) =
        ((U_mat⁻¹).val).mulVec
          (triv_ab_r (B_pr.obj W₀) ((η_r.hom.app (Opposite.op W₀)).hom s₀) y) := by
    intro W₀ s₀ y
    let W_b := B_pr.obj W₀
    let h₀ := (Fgt_D.obj W₀).hom
    let h_bar := (Fgt.obj W_b).hom
    let h_U := (Fgt_U.obj (B_j.obj W₀)).hom
    let fst_Y := CategoryTheory.Limits.pullback.fst h_bar ι_V
    let snd_Y := CategoryTheory.Limits.pullback.snd h_bar ι_V
    let a_W : CategoryTheory.Limits.pullback h_bar ι_V ⟶ (Fgt_U.obj (B_j.obj W₀)).left :=
      CategoryTheory.Limits.pullback.lift
        (fst_Y ≫ CategoryTheory.Limits.pullback.fst h₀ pr_D)
        (snd_Y ≫ q_spec ≫ π_r)
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (fst_Y ≫ ·) CategoryTheory.Limits.pullback.condition).trans
            ((CategoryTheory.Category.assoc fst_Y h_bar pr_D).symm.trans
              ((congrArg (· ≫ pr_D) CategoryTheory.Limits.pullback.condition).trans
                ((CategoryTheory.Category.assoc snd_Y ι_V pr_D).trans
                  ((congrArg (snd_Y ≫ ·) h_sq_D).trans
                    ((CategoryTheory.Category.assoc _ _ _).symm.trans
                      (CategoryTheory.Category.assoc _ _ U₀.ι).symm)))))))
    let θ₀ : CategoryTheory.Limits.pullback h_bar ι_V ⟶
        CategoryTheory.Limits.pullback h_U π_r :=
      CategoryTheory.Limits.pullback.lift a_W (snd_Y ≫ q_spec)
        ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
          (CategoryTheory.Category.assoc snd_Y q_spec π_r).symm)
    have hθ₁ : (θ₀ ≫ CategoryTheory.Limits.pullback.fst h_U π_r) ≫
        CategoryTheory.Limits.pullback.fst h₀ U₀.ι =
        fst_Y ≫ CategoryTheory.Limits.pullback.fst h₀ pr_D :=
      (congrArg (· ≫ CategoryTheory.Limits.pullback.fst h₀ U₀.ι)
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
    have hθ₂ : θ₀ ≫ CategoryTheory.Limits.pullback.snd h_U π_r = snd_Y ≫ q_spec :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    let u_ν := mk_vV (ν.app W₀)
    have huν₁ : u_ν ≫ fst_Y =
        CategoryTheory.Limits.pullback.fst (Fgt.obj (G.obj W_b)).hom ι_V ≫
          (Fgt.map (ν.app W₀)).left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have huν₂ : u_ν ≫ snd_Y =
        CategoryTheory.Limits.pullback.snd (Fgt.obj (G.obj W_b)).hom ι_V :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hσinv_symm : (σ_u_r⁻¹).symm = σ_u_r := by
      rw [AlgEquiv.aut_inv, AlgEquiv.symm_symm]
    have hσinv_π :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_u_r⁻¹).symm.toRingHom) ≫ π_r = π_r := by
      rw [hσinv_symm]
      exact hσ_π
    let m_σinv : CategoryTheory.Limits.pullback h_U π_r ⟶
        CategoryTheory.Limits.pullback h_U π_r :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst h_U π_r)
        (CategoryTheory.Limits.pullback.snd h_U π_r ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_u_r⁻¹).symm.toRingHom))
        (by rw [CategoryTheory.Category.assoc, hσinv_π, CategoryTheory.Limits.pullback.condition])
    have hm₁ : m_σinv ≫ CategoryTheory.Limits.pullback.fst h_U π_r =
        CategoryTheory.Limits.pullback.fst h_U π_r :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hm₂ : m_σinv ≫ CategoryTheory.Limits.pullback.snd h_U π_r =
        CategoryTheory.Limits.pullback.snd h_U π_r ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_u_r⁻¹).symm.toRingHom) :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hΦ_qB_inv : Φ_V_hom ≫ q_spec =
        q_spec ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_u_r⁻¹).symm.toRingHom) := by
      rw [hσinv_symm]
      exact hΦ_qB
    have hν_fst :
        CategoryTheory.eqToHom (hG_obj W_b).1.symm ≫
          ((Fgt.map (ν.app W₀)).left ≫ CategoryTheory.Limits.pullback.fst h₀ pr_D) =
        CategoryTheory.Limits.pullback.fst h₀ pr_D :=
      eq_of_heq ((CategoryTheory.eqToHom_comp_heq _ _).trans (hν W₀).1)
    have hsnd_eq :
        (ξ_can W_b ≫ (u_ν ≫ θ₀)) ≫ CategoryTheory.Limits.pullback.snd h_U π_r =
        (θ₀ ≫ m_σinv) ≫ CategoryTheory.Limits.pullback.snd h_U π_r := by
      calc
        (ξ_can W_b ≫ (u_ν ≫ θ₀)) ≫ CategoryTheory.Limits.pullback.snd h_U π_r
          = ξ_can W_b ≫ (u_ν ≫ (θ₀ ≫ CategoryTheory.Limits.pullback.snd h_U π_r)) := by
            simp only [CategoryTheory.Category.assoc]
        _ = (ξ_can W_b ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj (G.obj W_b)).hom ι_V) ≫
              q_spec := by
            rw [hθ₂, ← CategoryTheory.Category.assoc u_ν, huν₂, CategoryTheory.Category.assoc]
        _ = snd_Y ≫ (Φ_V_hom ≫ q_spec) := by
            rw [hξ_snd W_b, CategoryTheory.Category.assoc]
        _ = (θ₀ ≫ CategoryTheory.Limits.pullback.snd h_U π_r) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_u_r⁻¹).symm.toRingHom) := by
            rw [hΦ_qB_inv, ← CategoryTheory.Category.assoc, hθ₂]
        _ = (θ₀ ≫ m_σinv) ≫ CategoryTheory.Limits.pullback.snd h_U π_r := by
            rw [CategoryTheory.Category.assoc, ← hm₂, CategoryTheory.Category.assoc]
    have hcomp_θ : ξ_can W_b ≫ (u_ν ≫ θ₀) = θ₀ ≫ m_σinv := by
      let p_U := CategoryTheory.Limits.pullback.fst h_U π_r
      let q_U := CategoryTheory.Limits.pullback.fst h₀ U₀.ι
      let q_D := CategoryTheory.Limits.pullback.fst h₀ pr_D
      apply CategoryTheory.Limits.pullback.hom_ext
      · apply CategoryTheory.Limits.pullback.hom_ext
        · exact
            (congrArg (· ≫ q_U) (CategoryTheory.Category.assoc (ξ_can W_b) (u_ν ≫ θ₀) p_U)).trans
              ((CategoryTheory.Category.assoc (ξ_can W_b) ((u_ν ≫ θ₀) ≫ p_U) q_U).trans
                ((congrArg (ξ_can W_b ≫ ·)
                  ((congrArg (· ≫ q_U) (CategoryTheory.Category.assoc u_ν θ₀ p_U)).trans
                    ((CategoryTheory.Category.assoc u_ν (θ₀ ≫ p_U) q_U).trans
                      ((congrArg (u_ν ≫ ·) hθ₁).trans
                        ((CategoryTheory.Category.assoc u_ν fst_Y q_D).symm.trans
                          ((congrArg (· ≫ q_D) huν₁).trans
                            (CategoryTheory.Category.assoc _ _ q_D))))))).trans
                  ((CategoryTheory.Category.assoc (ξ_can W_b) _ _).symm.trans
                    ((congrArg (· ≫ ((Fgt.map (ν.app W₀)).left ≫ q_D)) (hξ_fst W_b)).trans
                      ((CategoryTheory.Category.assoc fst_Y _ _).trans
                        ((congrArg (fst_Y ≫ ·) hν_fst).trans
                          (hθ₁.symm.trans
                            ((congrArg (· ≫ q_U) (congrArg (θ₀ ≫ ·) hm₁.symm)).trans
                              (congrArg (· ≫ q_U)
                                (CategoryTheory.Category.assoc θ₀ m_σinv p_U).symm)))))))))
        · exact
            ((CategoryTheory.Category.assoc (ξ_can W_b ≫ (u_ν ≫ θ₀)) _ h_U).trans
              ((congrArg ((ξ_can W_b ≫ (u_ν ≫ θ₀)) ≫ ·)
                  CategoryTheory.Limits.pullback.condition).trans
                ((CategoryTheory.Category.assoc _ _ π_r).symm.trans
                  ((congrArg (· ≫ π_r) hsnd_eq).trans
                    ((CategoryTheory.Category.assoc (θ₀ ≫ m_σinv) _ π_r).trans
                      ((congrArg ((θ₀ ≫ m_σinv) ≫ ·)
                          CategoryTheory.Limits.pullback.condition.symm).trans
                        (CategoryTheory.Category.assoc _ _ h_U).symm))))))
      · exact hsnd_eq
    have hpt_θ : θ₀.base (u_ν.base ((ξ_can W_b).base y)) = m_σinv.base (θ₀.base y) :=
      (AlgebraicGeometry.Scheme.Hom.comp_apply u_ν θ₀ ((ξ_can W_b).base y)).symm.trans
        ((AlgebraicGeometry.Scheme.Hom.comp_apply (ξ_can W_b) (u_ν ≫ θ₀) y).symm.trans
          ((congrArg (fun m => m.base y) hcomp_θ).trans
            (AlgebraicGeometry.Scheme.Hom.comp_apply θ₀ m_σinv y)))
    let s₀_U : ↑(ℒ₀_r.obj.obj (Opposite.op (B_j.obj W₀))) := s₀
    have hs₁ := htriv_ab_nat (ν.app W₀) u_ν huν₁ huν₂
      ((η_r.hom.app (Opposite.op W₀)).hom s₀) ((ξ_can W_b).base y)
    have hs₂ := hη_r W₀ s₀_U θ₀ hθ₁ hθ₂ (u_ν.base ((ξ_can W_b).base y))
    have hs₃ := htriv₀_eqv (B_j.obj W₀) s₀_U (σ_u_r⁻¹) m_σinv hm₁ hm₂ (θ₀.base y)
    have hs₄ := hη_r W₀ s₀_U θ₀ hθ₁ hθ₂ y
    exact hs₁.trans
      (hs₂.trans
        ((congrArg (triv₀_r (B_j.obj W₀) s₀_U) hpt_θ).trans
          (hs₃.trans
            ((congrArg (fun u_grp : (Matrix (Fin M) (Fin M) (ZMod m_mod))ˣ =>
                (u_grp.val).mulVec (triv₀_r (B_j.obj W₀) s₀_U (θ₀.base y)))
              (map_inv ρ_r σ_u_r)).trans
              (congrArg ((U_mat⁻¹).val).mulVec hs₄.symm)))))

  
  obtain ⟨α_ℳ_ab, β_ℳ_ab, hαβ, hβα, h_sq, hβ_eval⟩ :=
    hGaugeInvert D₀.left S_bar V_bar ι_V B_pr hCont_pr hAdj_pr G hCont_G ν
      ℱ₀_r (weilEtaleHigherDirectImage U₀.ι 0 ℒ₀_r) Θ_j_r ℳ_bar_r ℳ_ab_r iso_bar_r φ_ℳ_r η_r
      hφ_mate α_bar β_bar hαβ_bar hβα_bar hadj_bar U_mat triv_ab_r @htriv_ab_nat
      ξ_can hBaseInv @hξ_nat_lift hLocalLift_r

  let _ := hCont_G
  let P := G.sheafPushforwardContinuous AddCommGrpCat.{u} J J
  let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
  let αℤ : Quiver.Hom Fℤ (P.obj Fℤ) :=
    (adj.homEquiv (AddCommGrpCat.of (ULift.{u} ℤ)) (P.obj Fℤ)).symm
      (CategoryTheory.CategoryStruct.comp
        (adj.unit.app (AddCommGrpCat.of (ULift.{u} ℤ)))
        (Fℤ.obj.map (Opposite.op μ)))

  refine ⟨G, hG_obj, @hG_map, hCont_G, hAdd_P, hLim_P, hColim_P,
    T, hT, μ, hT_left, hT_hom, hμ_left, α_ℳ_ab, β_ℳ_ab, hαβ, hβα, ?_, ?_⟩
  · intro W s' ξ_W hξ₁ hξ₂ y
    rw [hξ_uniq W ξ_W hξ₁ hξ₂, hβ_eval W s' y, ← hσu_mod]
  · intro x
