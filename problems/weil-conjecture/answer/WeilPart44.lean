    have hσ_fst : ∀ (W : S.Etale) (g : Γ),
        CategoryTheory.CategoryStruct.comp (Fgt.map (σ_g W g)).left (fst₁ (obj_WV W)) =
          CategoryTheory.CategoryStruct.id ((Fgt.obj (obj_WV W)).left) :=
