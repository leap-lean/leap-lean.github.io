            rw [map_smul, hc, (hp₀_raw x).1, map_zero, smul_zero]
          · change γ₀ (p₀_raw _).1 = γ₀ ((MonoidAlgebra.single σ (1 : Λ) : R) • Φ0_tilde (p₀_raw x).1)
            rw [(hp₀_raw _).2, hq₀_comm x, map_smul]
