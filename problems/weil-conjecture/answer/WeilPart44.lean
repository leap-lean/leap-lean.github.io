                          (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm).trans
                          (CategoryTheory.Category.assoc _ _ _).symm))))))
          · exact (CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (_ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                ((hσ_snd W g).trans
                  ((congrArg (snd₁ W ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm).trans
                    (CategoryTheory.Category.assoc _ _ _).symm)))
        exact (congrArg (fun φ => φ.base y ∈ Set.range (γ_map g).base) hq).mpr
          ⟨(snd₁ W).base y, rfl⟩
      · intro hx
        have hx_mem : x ∈ (O'_g W g : Set ↥((Fgt.obj (obj_WV (obj_WV W))).left)) := hx
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι (O'_g W g)] at hx_mem
        obtain ⟨z, rfl⟩ := hx_mem
        exact ⟨((O'_g W g).ι ≫ fst₁ (obj_WV W)).base z,
