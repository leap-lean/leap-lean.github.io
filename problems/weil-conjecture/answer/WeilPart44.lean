        invFun := fun lam => ⟨lam.1, fun h hh => lam.2 _ ⟨h, hh, rfl⟩⟩
        left_inv := fun _ => Subtype.ext rfl
        right_inv := fun _ => Subtype.ext rfl }

  let η_α : ∀ r : ℕ,
      { lam : Fin N → ZMod (ℓ ^ (r + 1)) //
        ∀ h ∈ H_geom,
          (((h.val).map (PadicInt.toZModPow (r + 1))).transpose).mulVec lam = lam } →
        Quiver.Hom (𝒥₀ r) (R_pr.obj (weilEtaleTorsionSheaf S (ℓ ^ (r + 1)))) :=
