      intro r u_M
      obtain ⟨u_J, rfl⟩ := hq_surj r u_M
      let b_thread : ↥L₂ := ⟨fun s => bock_J r s u_J, fun s => hbock_compat r s u_J⟩
      have hb_tors : b_thread ∈ T₂ := by
        refine ⟨r + 1, Subtype.ext (funext fun s => ?_)⟩
        change (ℓ ^ (r + 1)) • bock_J r s u_J = 0
        rw [← map_nsmul, hTors_J1 r u_J, map_zero]
      have hb_kill : (ℓ ^ N_BK) • b_thread = 0 := hT₂_kill b_thread hb_tors
      set v_J : J_H1 r := (ℓ ^ N_BK) • u_J
      have hv_bock : ∀ s : ℕ, bock_J r s v_J = 0 := by
        intro s
        dsimp [v_J]
        rw [map_nsmul]
        exact congrFun (congrArg Subtype.val hb_kill) s
      have hex_above : ∀ t : ℕ, ∃ w : J_H1 (r + t), res_J1 (Nat.le_add_right r t) w = v_J := by
        intro t
        cases t with
        | zero => exact ⟨v_J, hres_J1_id r v_J⟩
        | succ s => exact hbock_exact r s v_J (hv_bock s)
      let Y (t : ℕ) : Type u := { w : J_H1 (r + t) // res_J1 (Nat.le_add_right r t) w = v_J }
      have hY_fin : ∀ t : ℕ, Finite (Y t) := fun t => @Subtype.finite _ (hFin_J1 (r + t)) _
      have hY_ne : ∀ t : ℕ, Nonempty (Y t) := fun t => let ⟨w, hw⟩ := hex_above t; ⟨⟨w, hw⟩⟩
      let stepY (t : ℕ) (w : Y (t + 1)) : Y t :=
        ⟨res_J1 (Nat.le_succ (r + t)) w.1, by
          rw [hres_J1_comp (Nat.le_add_right r t) (Nat.le_succ (r + t)) w.1, w.2]⟩
      let FY : CategoryTheory.Functor ℕᵒᵖ (Type u) :=
        CategoryTheory.Functor.ofOpSequence (fun t => TypeCat.ofHom (stepY t))
      have : ∀ q : ℕᵒᵖ, Finite (FY.obj q) := fun q => hY_fin (Opposite.unop q)
      have : ∀ q : ℕᵒᵖ, Nonempty (FY.obj q) := fun q => hY_ne (Opposite.unop q)
      obtain ⟨secY, hsecY⟩ := nonempty_sections_of_finite_inverse_system FY
      let w_seq (t : ℕ) : J_H1 (r + t) := (secY (Opposite.op t)).1
      have hw_proj : ∀ t : ℕ, res_J1 (Nat.le_add_right r t) (w_seq t) = v_J :=
        fun t => (secY (Opposite.op t)).2
      have hw_step : ∀ t : ℕ, res_J1 (Nat.le_succ (r + t)) (w_seq (t + 1)) = w_seq t := by
        intro t
        have h1 := hsecY (CategoryTheory.homOfLE (Nat.le_succ t)).op
        have h2 := CategoryTheory.Functor.ofOpSequence_map_homOfLE_succ
          (fun s => TypeCat.ofHom (stepY s)) t
        dsimp [FY] at h1
        rw [h2] at h1
        exact congrArg Subtype.val h1
      let yJ_seq (k : ℕ) : J_H1 k := res_J1 (Nat.le_add_left k r) (w_seq k)
      have hyJ_step : ∀ k : ℕ, res_J1 (Nat.le_succ k) (yJ_seq (k + 1)) = yJ_seq k := by
        intro k
        dsimp [yJ_seq]
        rw [hres_J1_comp (Nat.le_succ k) (Nat.le_add_left (k + 1) r) (w_seq (k + 1)),
          ← hw_step k, hres_J1_comp (Nat.le_add_left k r) (Nat.le_succ (r + k)) (w_seq (k + 1))]
      let yM_seq (k : ℕ) : M_H k := q_JM k (yJ_seq k)
      have hyM_mem : yM_seq ∈ sysSubgroup := by
        rw [hsys]
        intro k
        dsimp [yM_seq]
        rw [hq_compat k (yJ_seq (k + 1)), hyJ_step k]
      refine ⟨⟨yM_seq, hyM_mem⟩, ?_⟩
      dsimp [yM_seq, yJ_seq]
      have hproj_r : res_J1 (Nat.le_add_left r r) (w_seq r) = v_J := hw_proj r
      rw [hproj_r, map_nsmul]
    let smulSys (z : PadicInt ℓ) (x : ↥sysSubgroup) : ↥sysSubgroup :=
      ⟨fun r => (PadicInt.toZModPow (r + 1) z).val • x.1 r, (hsys _).mpr fun r => by
        have : NeZero (ℓ ^ (r + 2)) := ⟨pow_ne_zero (r + 2) hℓ_ne⟩
        have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hℓ_ne⟩
        set c := PadicInt.toZModPow (r + 2) z
        have hc_cast : PadicInt.toZModPow (r + 1) z =
            ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1))) c :=
          (RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow (r + 1) (r + 2)
            (Nat.le_succ (r + 1)) (p := ℓ)) z).symm
        have hc_cast2 : PadicInt.toZModPow (r + 1) z = (c.val : ZMod (ℓ ^ (r + 1))) := by
          conv_lhs => rw [hc_cast, ← ZMod.natCast_zmod_val c]
          exact map_natCast (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) c.val
        rw [map_nsmul, (hsys x.1).mp x.2 r, hc_cast2, ZMod.val_natCast]
        have hdiv := (Nat.div_add_mod c.val (ℓ ^ (r + 1))).symm
        conv_lhs => rw [hdiv, add_nsmul, Nat.mul_comm, mul_nsmul', hTors_M r (x.1 r), smul_zero, zero_add]⟩
    let pSeq (x y : ↥sysSubgroup) : ∀ k : ℕ, ZMod (ℓ ^ k)
      | 0 => 0
      | r + 1 => pair r (x.1 r) (y.1 r)
    have hpSeq_step : ∀ (x y : ↥sysSubgroup) (k : ℕ),
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) (pSeq x y (k + 1)) =
          pSeq x y k := by
      intro x y k
      cases k with
      | zero =>
        have : Subsingleton (ZMod (ℓ ^ 0)) := by rw [pow_zero]; infer_instance
        exact Subsingleton.elim _ _
      | succ r =>
        change ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
            (pair (r + 1) (x.1 (r + 1)) (y.1 (r + 1))) =
          pair r (x.1 r) (y.1 r)
        rw [hpair_compat r (x.1 (r + 1)) (y.1 (r + 1)),
          (hsys x.1).mp x.2 r, (hsys y.1).mp y.2 r]
    have hpSeq_compat : ∀ (x y : ↥sysSubgroup) {k₁ k₂ : ℕ} (hk : k₁ ≤ k₂),
        ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁)) (pSeq x y k₂) = pSeq x y k₁ := by
      intro x y k₁ k₂ hk
      induction k₂, hk using Nat.le_induction with
      | base => exact RingHom.congr_fun ZMod.castHom_self _
      | succ t hkt ih =>
        have hcast_comp : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ_of_le hkt)) (ZMod (ℓ ^ k₁)) =
            (ZMod.castHom (pow_dvd_pow ℓ hkt) (ZMod (ℓ ^ k₁))).comp
              (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ t)) (ZMod (ℓ ^ t))) := by
          ext z; simp
        rw [hcast_comp, RingHom.comp_apply, hpSeq_step x y t, ih]
    let fPairRing (x y : ↥sysSubgroup) (k : ℕ) : Polynomial ℤ →+* ZMod (ℓ ^ k) :=
      Polynomial.eval₂RingHom (Int.castRingHom (ZMod (ℓ ^ k))) (pSeq x y k)
    have hfPair_compat : ∀ (x y : ↥sysSubgroup) (k₁ k₂ : ℕ) (hk : k₁ ≤ k₂),
        (ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁))).comp (fPairRing x y k₂) =
          fPairRing x y k₁ := by
      intro x y k₁ k₂ hk
      apply Polynomial.ringHom_ext'
      · ext z; simp [fPairRing]
      · simp [fPairRing, hpSeq_compat x y hk]
    let β (x y : ↥sysSubgroup) : PadicInt ℓ :=
      PadicInt.lift (hfPair_compat x y) Polynomial.X
    have hβ_mod_all : ∀ (x y : ↥sysSubgroup) (k : ℕ),
        PadicInt.toZModPow k (β x y) = pSeq x y k := by
      intro x y k
      have h := RingHom.congr_fun (PadicInt.lift_spec (hfPair_compat x y) k) Polynomial.X
      simpa [β, fPairRing] using h
    have hβ_mod : ∀ (x y : ↥sysSubgroup) (r : ℕ),
        PadicInt.toZModPow (r + 1) (β x y) = pair r (x.1 r) (y.1 r) :=
      fun x y r => hβ_mod_all x y (r + 1)
    have hZMod0 : Subsingleton (ZMod (ℓ ^ 0)) := by rw [pow_zero]; infer_instance
    have hβ_add_left : ∀ (x₁ x₂ y : ↥sysSubgroup), β (x₁ + x₂) y = β x₁ y + β x₂ y := by
      intro x₁ x₂ y; apply PadicInt.ext_of_toZModPow.mp; intro k
      cases k with
      | zero => exact Subsingleton.elim _ _
      | succ r =>
        rw [map_add, hβ_mod, hβ_mod, hβ_mod]
        change pair r (x₁.1 r + x₂.1 r) (y.1 r) = pair r (x₁.1 r) (y.1 r) + pair r (x₂.1 r) (y.1 r)
        rw [map_add, AddMonoidHom.add_apply]
    have hβ_add_right : ∀ (x y₁ y₂ : ↥sysSubgroup), β x (y₁ + y₂) = β x y₁ + β x y₂ := by
      intro x y₁ y₂; apply PadicInt.ext_of_toZModPow.mp; intro k
      cases k with
      | zero => exact Subsingleton.elim _ _
      | succ r =>
        rw [map_add, hβ_mod, hβ_mod, hβ_mod]
        exact map_add (pair r (x.1 r)) (y₁.1 r) (y₂.1 r)
    have hβ_smul_left : ∀ (z : PadicInt ℓ) (x y : ↥sysSubgroup),
        β (smulSys z x) y = z * β x y := by
      intro z x y; apply PadicInt.ext_of_toZModPow.mp; intro k
      cases k with
      | zero => exact Subsingleton.elim _ _
      | succ r =>
        have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hℓ_ne⟩
        rw [map_mul, hβ_mod, hβ_mod]
        change pair r ((PadicInt.toZModPow (r + 1) z).val • x.1 r) (y.1 r) =
          PadicInt.toZModPow (r + 1) z * pair r (x.1 r) (y.1 r)
        rw [map_nsmul, AddMonoidHom.nsmul_apply, nsmul_eq_mul, ZMod.natCast_zmod_val]
    have hβ_smul_right : ∀ (z : PadicInt ℓ) (x y : ↥sysSubgroup),
        β x (smulSys z y) = z * β x y := by
      intro z x y; apply PadicInt.ext_of_toZModPow.mp; intro k
      cases k with
      | zero => exact Subsingleton.elim _ _
      | succ r =>
        have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hℓ_ne⟩
        rw [map_mul, hβ_mod, hβ_mod]
        change pair r (x.1 r) ((PadicInt.toZModPow (r + 1) z).val • y.1 r) =
          PadicInt.toZModPow (r + 1) z * pair r (x.1 r) (y.1 r)
        rw [map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val]
    let frobSys (x : ↥sysSubgroup) : ↥sysSubgroup :=
      ⟨fun r => frob_M r (x.1 r), (hsys _).mpr fun r => by
        rw [hfrob_M r (x.1 (r + 1)), (hsys x.1).mp x.2 r]⟩
    have hβ_frob : ∀ (x y : ↥sysSubgroup),
        β (frobSys x) (frobSys y) = (c_nat : PadicInt ℓ) * β x y := by
      intro x y; apply PadicInt.ext_of_toZModPow.mp; intro k
      cases k with
      | zero => exact Subsingleton.elim _ _
      | succ r =>
        rw [map_mul, map_natCast, hβ_mod, hβ_mod]
        exact hpair_frob r (x.1 r) (y.1 r)
    let β_add : ↥sysSubgroup →+ ↥sysSubgroup →+ Padic ℓ :=
      AddMonoidHom.mk'
        (fun x => AddMonoidHom.mk' (fun y => (β x y : Padic ℓ))
          (fun y₁ y₂ => by rw [hβ_add_right]; push_cast; rfl))
        (fun x₁ x₂ => by
          ext y
          simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply, hβ_add_left]
          push_cast; rfl)
    let β_right_bilin (q₁ : ℚ) (x : ↥sysSubgroup) : ℚ →ₗ[ℤ] ↥sysSubgroup →ₗ[ℤ] Padic ℓ :=
      LinearMap.mk₂ ℤ (fun (q₂ : ℚ) (y : ↥sysSubgroup) => (q₁ : Padic ℓ) * ((q₂ : Padic ℓ) * β_add x y))
        (fun r₁ r₂ y => by push_cast; ring)
        (fun c r y => by
          change (q₁ : Padic ℓ) * (((c • r : ℚ) : Padic ℓ) * β_add x y) =
            c • ((q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add x y))
          rw [zsmul_eq_mul, zsmul_eq_mul]; push_cast; ring)
        (fun r y₁ y₂ => by rw [map_add]; ring)
        (fun c r y => by rw [map_zsmul, zsmul_eq_mul, zsmul_eq_mul]; ring)
    let β_right (q₁ : ℚ) (x : ↥sysSubgroup) : TensorProduct ℤ ℚ ↥sysSubgroup →ₗ[ℤ] Padic ℓ :=
      TensorProduct.lift (β_right_bilin q₁ x)
    let β_left_bilin : ℚ →ₗ[ℤ] ↥sysSubgroup →ₗ[ℤ] (TensorProduct ℤ ℚ ↥sysSubgroup →ₗ[ℤ] Padic ℓ) :=
      LinearMap.mk₂ ℤ β_right
        (fun q₁ q₂ x => TensorProduct.ext' fun r y => by
          change (((q₁ + q₂ : ℚ) : Padic ℓ) * ((r : Padic ℓ) * β_add x y)) =
            (q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add x y) +
              (q₂ : Padic ℓ) * ((r : Padic ℓ) * β_add x y)
          push_cast; ring)
        (fun c q₁ x => TensorProduct.ext' fun r y => by
          change (((c • q₁ : ℚ) : Padic ℓ) * ((r : Padic ℓ) * β_add x y)) =
            c • ((q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add x y))
          rw [zsmul_eq_mul, zsmul_eq_mul]; push_cast; ring)
        (fun q₁ x₁ x₂ => TensorProduct.ext' fun r y => by
          change (q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add (x₁ + x₂) y) =
            (q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add x₁ y) +
              (q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add x₂ y)
          rw [map_add, AddMonoidHom.add_apply]; ring)
        (fun c q₁ x => TensorProduct.ext' fun r y => by
          change (q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add (c • x) y) =
            c • ((q₁ : Padic ℓ) * ((r : Padic ℓ) * β_add x y))
          rw [map_zsmul, AddMonoidHom.zsmul_apply, zsmul_eq_mul, zsmul_eq_mul]; ring)
    let β_Q : TensorProduct ℤ ℚ ↥sysSubgroup →ₗ[ℤ] TensorProduct ℤ ℚ ↥sysSubgroup →ₗ[ℤ] Padic ℓ :=
      TensorProduct.lift β_left_bilin
    have hβ_Q_tmul : ∀ (q₁ q₂ : ℚ) (x y : ↥sysSubgroup),
        β_Q (q₁ ⊗ₜ[ℤ] x) (q₂ ⊗ₜ[ℤ] y) = (q₁ : Padic ℓ) * ((q₂ : Padic ℓ) * (β x y : Padic ℓ)) :=
      fun _ _ _ _ => rfl
    have hEquivRat : ∀ (q : ℚ) (t : TensorProduct ℤ ℚ ↥sysSubgroup),
        equiv (q • t) = (q : Padic ℓ) • equiv t := by
      intro q t
      have hd_ne : q.den ≠ 0 := q.den_nz
      have hd_padic : ((q.den : ℕ) : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hd_ne
      have hrat_eq : (q.den : ℚ) * q = (q.num : ℚ) := by rw [mul_comm, Rat.mul_den_eq_num]
      have ht_eq : q.den • (q • t) = q.num • t := by
        rw [← Nat.cast_smul_eq_nsmul ℚ, ← mul_smul, hrat_eq, Int.cast_smul_eq_zsmul ℚ]
      have he_eq : q.den • equiv (q • t) = q.num • equiv t := by
        rw [← map_nsmul, ht_eq, map_zsmul]
      rw [← Nat.cast_smul_eq_nsmul (Padic ℓ), ← Int.cast_smul_eq_zsmul (Padic ℓ)] at he_eq
      have hpadic_eq : ((q.num : ℤ) : Padic ℓ) = ((q.den : ℕ) : Padic ℓ) * (q : Padic ℓ) := by
        have hq := congrArg (fun r : ℚ => (r : Padic ℓ)) hrat_eq.symm
        push_cast at hq
        exact hq
      rw [hpadic_eq, mul_smul] at he_eq
      exact smul_right_injective V hd_padic he_eq
    have hEquivSymmRat : ∀ (q : ℚ) (v : V),
        equiv.symm ((q : Padic ℓ) • v) = q • equiv.symm v := by
      intro q v
      apply equiv.injective
      rw [equiv.apply_symm_apply, hEquivRat q (equiv.symm v), equiv.apply_symm_apply]
    have hβ_Q_rat_left : ∀ (q : ℚ) (t s : TensorProduct ℤ ℚ ↥sysSubgroup),
        β_Q (q • t) s = (q : Padic ℓ) * β_Q t s := by
      intro q t s
      induction t using TensorProduct.induction_on with
      | zero => rw [smul_zero, map_zero, LinearMap.zero_apply, mul_zero]
      | tmul q₁ x =>
        rw [TensorProduct.smul_tmul', smul_eq_mul]
        induction s using TensorProduct.induction_on with
        | zero => rw [map_zero, map_zero, mul_zero]
        | tmul q₂ y => rw [hβ_Q_tmul, hβ_Q_tmul]; push_cast; ring
        | add s₁ s₂ ih₁ ih₂ => rw [map_add, map_add, ih₁, ih₂, mul_add]
      | add t₁ t₂ ih₁ ih₂ =>
        rw [smul_add, map_add, map_add, LinearMap.add_apply, LinearMap.add_apply, ih₁, ih₂, mul_add]
    have hβ_Q_rat_right : ∀ (q : ℚ) (t s : TensorProduct ℤ ℚ ↥sysSubgroup),
        β_Q t (q • s) = (q : Padic ℓ) * β_Q t s := by
      intro q t s
      induction t using TensorProduct.induction_on with
      | zero => rw [map_zero, LinearMap.zero_apply, LinearMap.zero_apply, mul_zero]
      | tmul q₁ x =>
        induction s using TensorProduct.induction_on with
        | zero => rw [smul_zero, map_zero, mul_zero]
        | tmul q₂ y =>
          rw [TensorProduct.smul_tmul', smul_eq_mul, hβ_Q_tmul, hβ_Q_tmul]; push_cast; ring
        | add s₁ s₂ ih₁ ih₂ => rw [smul_add, map_add, map_add, ih₁, ih₂, mul_add]
      | add t₁ t₂ ih₁ ih₂ =>
        rw [map_add, LinearMap.add_apply, LinearMap.add_apply, ih₁, ih₂, mul_add]
    let B₀ : V →+ V →+ Padic ℓ :=
      AddMonoidHom.mk'
        (fun v => AddMonoidHom.mk' (fun w => β_Q (equiv.symm v) (equiv.symm w))
          (fun w₁ w₂ => by rw [map_add, map_add]))
        (fun v₁ v₂ => by
          ext w
          simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply, map_add, LinearMap.add_apply])
    have hB₀_apply : ∀ (v w : V), B₀ v w = β_Q (equiv.symm v) (equiv.symm w) :=
      fun _ _ => rfl
    have hB₀_tmul : ∀ (q₁ q₂ : ℚ) (x y : ↥sysSubgroup),
        B₀ (equiv (q₁ ⊗ₜ[ℤ] x)) (equiv (q₂ ⊗ₜ[ℤ] y)) =
          (q₁ : Padic ℓ) * ((q₂ : Padic ℓ) * (β x y : Padic ℓ)) := by
      intro q₁ q₂ x y
      rw [hB₀_apply, equiv.symm_apply_apply, equiv.symm_apply_apply, hβ_Q_tmul]
    have hB₀_rat_left : ∀ (q : ℚ) (v w : V),
        B₀ ((q : Padic ℓ) • v) w = (q : Padic ℓ) * B₀ v w := by
      intro q v w
      rw [hB₀_apply, hB₀_apply, hEquivSymmRat q v, hβ_Q_rat_left]
    have hB₀_rat_right : ∀ (q : ℚ) (v w : V),
        B₀ v ((q : Padic ℓ) • w) = (q : Padic ℓ) * B₀ v w := by
      intro q v w
      rw [hB₀_apply, hB₀_apply, hEquivSymmRat q w, hβ_Q_rat_right]
    have hV_int_tmul : ∀ (z : PadicInt ℓ) (q₁ : ℚ) (x : ↥sysSubgroup),
        (z : Padic ℓ) • equiv (q₁ ⊗ₜ[ℤ] x) = equiv (q₁ ⊗ₜ[ℤ] smulSys z x) := by
      intro z q₁ x
      have h1 : ∀ w : ↥sysSubgroup, q₁ ⊗ₜ[ℤ] w = q₁ • ((1 : ℚ) ⊗ₜ[ℤ] w) := by
        intro w; rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [h1 x, h1 (smulSys z x), hEquivRat, hEquivRat,
        hsmul z x (smulSys z x) (fun _ => rfl), smul_comm]
    have hB₀_int_left : ∀ (z : PadicInt ℓ) (v w : V),
        B₀ ((z : Padic ℓ) • v) w = (z : Padic ℓ) * B₀ v w := by
      intro z v w
      rw [← equiv.apply_symm_apply v, ← equiv.apply_symm_apply w]
      generalize equiv.symm v = t
      generalize equiv.symm w = s
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul q₁ x =>
        rw [hV_int_tmul z q₁ x]
        induction s using TensorProduct.induction_on with
        | zero => simp
        | tmul q₂ y =>
          rw [hB₀_tmul q₁ q₂ (smulSys z x) y, hB₀_tmul q₁ q₂ x y, hβ_smul_left z x y]
          push_cast; ring
        | add s₁ s₂ ih₁ ih₂ => rw [map_add, map_add, map_add, ih₁, ih₂, mul_add]
      | add t₁ t₂ ih₁ ih₂ =>
