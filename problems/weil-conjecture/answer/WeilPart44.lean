          have hS : S = leftT := hleft.symm
          subst hS
          have hhom' : homT = CategoryTheory.CategoryStruct.id S := eq_of_heq hhom
          subst hhom'
          rfl
        have hT_eq : T₁ = T₂ :=
          (hEtaleCanon T₁ hT₁_left hT₁_hom).trans (hEtaleCanon T₂ hT₂_left hT₂_hom).symm
        subst hT_eq
        have hhT_eq : hT₁ = hT₂ := Subsingleton.elim _ _
        subst hhT_eq
        have hu_eq : u₁ = u₂ := eq_of_heq (hu₁.trans hu₂.symm)
