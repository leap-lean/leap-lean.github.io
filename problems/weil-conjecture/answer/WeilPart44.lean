      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hGu_snd : Gu_V ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj (G.obj W₂)).hom ι_V =
        CategoryTheory.Limits.pullback.snd (Fgt.obj (G.obj W₁)).hom ι_V :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hu_eqv :
        (Fgt.map u).left ≫ CategoryTheory.eqToHom (hG_obj W₂).1.symm =
        CategoryTheory.eqToHom (hG_obj W₁).1.symm ≫ (Fgt.map (G.map u)).left :=
      eq_of_heq ((CategoryTheory.comp_eqToHom_heq _ _).trans
