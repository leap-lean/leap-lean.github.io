      have hl_1 : l_g = CategoryTheory.CategoryStruct.comp (O'_g W g).ι
          (CategoryTheory.CategoryStruct.comp (fst₁ (obj_WV W)) (snd₁ W)) := by
        have h1 := congrArg (fun φ => φ ≫ CategoryTheory.Limits.pullback.fst π π) hl_fac
        exact (CategoryTheory.Category.comp_id l_g).symm.trans
          ((congrArg (l_g ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
