        (evAt _ y).comp (ev_lc (obj_WV W)).toLinearMap
      have hev_sum : ev_lc (obj_WV W)
          ((oneR.obj.map (Opposite.op p_W)).hom ((ε_tr.hom.app (Opposite.op W)).hom s)) y =
          ULift.up c_sum := by
        have h1 : L_ev ((oneR.obj.map (Opposite.op p_W)).hom ((ε_tr.hom.app (Opposite.op W)).hom s)) =
            Finset.univ.sum (fun i : Fin M =>
              L_ev ((oneR.obj.map (Opposite.op δ_W_et)).hom
                (triv_R oneR (obj_WV W) (triv_T (R_sh.obj oneR) W s_R i) i))) :=
          (congrArg L_ev hp_eq).trans (map_sum L_ev _ _)
        have h2 : Finset.univ.sum (fun i : Fin M =>
              L_ev ((oneR.obj.map (Opposite.op δ_W_et)).hom
                (triv_R oneR (obj_WV W) (triv_T (R_sh.obj oneR) W s_R i) i))) =
            Finset.univ.sum (fun i : Fin M =>
              ULift.up (L.triv_dual (obj_WV W) (triv_T L.ℳ_dual W s i) (δ_W.base y) i)) :=
          Finset.sum_congr rfl fun i _ =>
            (h_res δ_W_et _ y).trans
              ((congrArg (fun z => ev_lc (obj_WV (obj_WV W))
                (triv_R oneR (obj_WV W) z i) (δ_W.base y)) (hT_map e_dual.hom W s i)).trans
                (he_dual (obj_WV W) (triv_T L.ℳ_dual W s i) i (δ_W.base y)))
        exact h1.trans (h2.trans (ULift.ext _ _ (hdown_sum Finset.univ _)))
      obtain ⟨U₀', v₀, z₀, hz₀, hv₀⟩ :=
        h_ref (obj_WV W)
          ((oneR.obj.map (Opposite.op p_W)).hom ((ε_tr.hom.app (Opposite.op W)).hom s)) y
      refine ⟨U₀', v₀, z₀, hz₀, ?_⟩
      exact (hOne_map_comp v₀ p_W _).trans
        (hv₀.trans (congrArg _ hev_sum))
    · intro W s i y c val_one h_loc
      rcases h_loc with ⟨U₀', v₀, z₀, hz₀, hv₀⟩
      have h1 := congrArg (fun t => ev_lc U₀' t z₀) hv₀
      have hlhs : ev_lc U₀' ((oneR.obj.map (Opposite.op v₀)).hom val_one) z₀ =
          ULift.up (L.triv W ((L.ι_ext.hom.app (Opposite.op W)).hom s) y i) :=
        (h_res v₀ val_one z₀).trans
          ((congrArg (ev_lc (obj_WV W) val_one) hz₀).trans (he_one W s i y))
      have hrhs : ev_lc U₀'
          ((((CategoryTheory.sheafificationAdjunction J_top (ModuleCat.{u, u} R)).unit.app
            ((CategoryTheory.Functor.const (Opposite S.Etale)).obj (ModuleCat.of R R))).app
            (Opposite.op U₀')).hom (ULift.up c)) z₀ = ULift.up c :=
        h_unit U₀' (ULift.up c) z₀
      exact congrArg ULift.down (hlhs.symm.trans (h1.trans hrhs))
  · rw [injective_iff_map_eq_zero]
    intro w hw
    have hw_mid : ((T_sh.mapExtAddHom oneR L.ℳ_dual 1) w).comp
        (CategoryTheory.Abelian.Ext.mk₀ ε_tr) (Nat.add_zero 1) = 0 := by
      have hΨw : Ψ w = (CategoryTheory.Abelian.Ext.mk₀ e_one.hom).comp
          (((T_sh.mapExtAddHom oneR L.ℳ_dual 1) w).comp
            (CategoryTheory.Abelian.Ext.mk₀ ε_tr) (Nat.add_zero 1))
          (Nat.zero_add 1) := rfl
