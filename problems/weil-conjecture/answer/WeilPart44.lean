  have hm_pos : ∀ r : ℕ, 1 ≤ ℓ ^ (r + 1) := fun r => Nat.one_le_pow (r + 1) ℓ hPrime.pos

  rcases hZExt with ⟨a₀, ha₀, B, L_fld,
    hCR, hDom, hFld,
    hAF_B, hAP_B, hAR_B,
    hAF_L, hAP_L, hARF_L,
    hABL, hARL,
    hST_FPB, hST_PRB, hST_FKL, hST_PKL, hST_PBL, hST_RBL,
    hFin_B, hEt_B, hFrac_B, hIntCl_B, hFD_L, hGal_L,
