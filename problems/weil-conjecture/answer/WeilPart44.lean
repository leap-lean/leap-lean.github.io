      let L₁₂ : TensorProduct ↥E₁ C₁_E₁ ↥E₂ →+* D_bar :=
        Ψ_E₂.toRingHom.comp (inc_Ck₂.comp ι₁₂)
      let R₁₂ : TensorProduct ↥E₁ C₁_E₁ ↥E₂ →+* D_bar :=
