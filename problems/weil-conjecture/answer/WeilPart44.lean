    obtain ⟨hFin_π, hEt_π, hSurj_π, hact_one, hact_mul, h_over, hγ_open, hγ_disj, hγ_univ⟩ := hGal
    let ι_V : V ⟶ S := π ≫ U.ι
    have hEt_ιV : AlgebraicGeometry.Etale ι_V := h_et_V π hEt_π
    have : AlgebraicGeometry.IsFinite π := hFin_π
    have : AlgebraicGeometry.Etale π := hEt_π
    have : AlgebraicGeometry.Surjective π := hSurj_π
    have : AlgebraicGeometry.Etale ι_V := hEt_ιV
    have hact_ι : ∀ g : Γ, act g ≫ ι_V = ι_V := fun g => by
      dsimp [ι_V]
      rw [← Category.assoc, h_over g]
    let γ_sheet : Γ → (V ⟶ CategoryTheory.Limits.pullback π π) := fun g =>
      CategoryTheory.Limits.pullback.lift (𝟙 V) (act g) ((Category.id_comp π).trans (h_over g).symm)
    have hact_et : ∀ g : Γ, AlgebraicGeometry.Etale (act g) := fun g => by
      have : AlgebraicGeometry.IsOpenImmersion (γ_sheet g) := hγ_open g
      have hcomp : γ_sheet g ≫ CategoryTheory.Limits.pullback.snd π π = act g :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      rw [← hcomp]
      exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        (γ_sheet g) (CategoryTheory.Limits.pullback.snd π π) inferInstance inferInstance

    have hClopenSheets : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (g_Z : Z ⟶ V) (h_Z : Z ⟶ S)
        (hhZ : g_Z ≫ ι_V = h_Z),
        let P_Z := CategoryTheory.Limits.pullback h_Z ι_V
        ∃ δ : Γ → (Z ⟶ P_Z),
          (∀ g : Γ,
            δ g ≫ CategoryTheory.Limits.pullback.fst h_Z ι_V = 𝟙 Z ∧
            δ g ≫ CategoryTheory.Limits.pullback.snd h_Z ι_V = g_Z ≫ act g ∧
            AlgebraicGeometry.IsOpenImmersion (δ g) ∧
            AlgebraicGeometry.Etale (δ g) ∧
            IsOpen (Set.range (δ g).base)) ∧
          (∀ g₁ g₂ : Γ, g₁ ≠ g₂ → Disjoint (Set.range (δ g₁).base) (Set.range (δ g₂).base)) ∧
          (⋃ g : Γ, Set.range (δ g).base) = Set.univ ∧
          (∀ (g h : Γ) (m_h : P_Z ⟶ P_Z),
            m_h ≫ CategoryTheory.Limits.pullback.fst h_Z ι_V =
              CategoryTheory.Limits.pullback.fst h_Z ι_V →
            m_h ≫ CategoryTheory.Limits.pullback.snd h_Z ι_V =
              CategoryTheory.Limits.pullback.snd h_Z ι_V ≫ act h →
            δ g ≫ m_h = δ (h * g)) := by
      intro Z g_Z h_Z hhZ P_Z
      let p₁ := CategoryTheory.Limits.pullback.fst h_Z ι_V
      let p₂ := CategoryTheory.Limits.pullback.snd h_Z ι_V
      have hΨ_cond : (p₁ ≫ g_Z) ≫ π = p₂ ≫ π := by
        apply (CategoryTheory.cancel_mono U.ι).mp
        calc ((p₁ ≫ g_Z) ≫ π) ≫ U.ι
            = p₁ ≫ (g_Z ≫ ι_V) := by simp only [ι_V, Category.assoc]
          _ = p₁ ≫ h_Z := by rw [hhZ]
          _ = p₂ ≫ ι_V := CategoryTheory.Limits.pullback.condition
          _ = (p₂ ≫ π) ≫ U.ι := (Category.assoc _ _ _).symm
      let Ψ : P_Z ⟶ CategoryTheory.Limits.pullback π π :=
        CategoryTheory.Limits.pullback.lift (p₁ ≫ g_Z) p₂ hΨ_cond
      let δ : Γ → (Z ⟶ P_Z) := fun g =>
        CategoryTheory.Limits.pullback.lift (𝟙 Z) (g_Z ≫ act g)
          (by rw [Category.id_comp, Category.assoc, hact_ι g, hhZ])
      have hpb_δ : ∀ g : Γ, CategoryTheory.IsPullback (δ g) g_Z Ψ (γ_sheet g) := fun g => by
        have hcomm : δ g ≫ Ψ = g_Z ≫ γ_sheet g := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · dsimp [δ, Ψ, γ_sheet, p₁]
            rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← Category.assoc (CategoryTheory.Limits.pullback.lift _ _ _),
              CategoryTheory.Limits.pullback.lift_fst, Category.id_comp,
              Category.assoc, CategoryTheory.Limits.pullback.lift_fst, Category.comp_id]
          · dsimp [δ, Ψ, γ_sheet, p₂]
            rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Limits.pullback.lift_snd,
              Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
        refine CategoryTheory.IsPullback.of_isLimit
          (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm
            (fun s => s.fst ≫ p₁)
            (fun s => by
              have h1 := congrArg (· ≫ CategoryTheory.Limits.pullback.fst π π) s.condition
              have h2 := congrArg (· ≫ CategoryTheory.Limits.pullback.snd π π) s.condition
              dsimp [Ψ, γ_sheet, p₁, p₂] at h1 h2
              rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                Category.assoc, CategoryTheory.Limits.pullback.lift_fst, Category.comp_id] at h1
              rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                Category.assoc, CategoryTheory.Limits.pullback.lift_snd] at h2
              apply CategoryTheory.Limits.pullback.hom_ext
              · dsimp [δ, p₁]
                rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, Category.comp_id]
              · calc ((s.fst ≫ p₁) ≫ δ g) ≫ p₂
                    = (s.fst ≫ p₁) ≫ (δ g ≫ p₂) := Category.assoc _ _ _
                  _ = (s.fst ≫ p₁) ≫ (g_Z ≫ act g) := by
                        dsimp [δ, p₂]; rw [CategoryTheory.Limits.pullback.lift_snd]
                  _ = ((s.fst ≫ p₁) ≫ g_Z) ≫ act g := (Category.assoc _ _ _).symm
                  _ = (s.fst ≫ (p₁ ≫ g_Z)) ≫ act g := by rw [Category.assoc s.fst p₁ g_Z]
                  _ = s.snd ≫ act g := by rw [h1]
                  _ = s.fst ≫ p₂ := h2.symm)
            (fun s => by
              have h1 := congrArg (· ≫ CategoryTheory.Limits.pullback.fst π π) s.condition
              dsimp [Ψ, γ_sheet, p₁] at h1
              rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                Category.assoc, CategoryTheory.Limits.pullback.lift_fst, Category.comp_id] at h1
              exact h1)
            (fun s m hm _ => by
              calc m = m ≫ 𝟙 Z := (Category.comp_id m).symm
                _ = m ≫ (δ g ≫ p₁) := by
                      dsimp [δ, p₁]; rw [CategoryTheory.Limits.pullback.lift_fst]
                _ = (m ≫ δ g) ≫ p₁ := (Category.assoc _ _ _).symm
                _ = s.fst ≫ p₁ := by rw [hm]))
      have hOpen_δ : ∀ g : Γ, AlgebraicGeometry.IsOpenImmersion (δ g) := fun g =>
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (hpb_δ g).flip (hγ_open g)
      have hRange_δ : ∀ g : Γ, Set.range (δ g).base = Ψ.base ⁻¹' Set.range (γ_sheet g).base := by
        intro g
        ext y
        simp only [Set.mem_range, Set.mem_preimage]
        constructor
        · rintro ⟨z, rfl⟩
          refine ⟨g_Z.base z, ?_⟩
          calc (γ_sheet g).base (g_Z.base z)
              = (g_Z ≫ γ_sheet g).base z := rfl
            _ = (δ g ≫ Ψ).base z := by rw [(hpb_δ g).w]
            _ = Ψ.base ((δ g).base z) := rfl
        · rintro ⟨v, hv⟩
          obtain ⟨w, hw_fst, -⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y v hv.symm
          refine ⟨(hpb_δ g).isoPullback.inv.base w, ?_⟩
          have hiso_fst : (hpb_δ g).isoPullback.inv ≫ δ g =
              CategoryTheory.Limits.pullback.fst Ψ (γ_sheet g) :=
            (CategoryTheory.Iso.inv_comp_eq (hpb_δ g).isoPullback).mpr
              (hpb_δ g).isoPullback_hom_fst.symm
          calc (δ g).base ((hpb_δ g).isoPullback.inv.base w)
              = ((hpb_δ g).isoPullback.inv ≫ δ g).base w := rfl
            _ = (CategoryTheory.Limits.pullback.fst Ψ (γ_sheet g)).base w := by rw [hiso_fst]
            _ = y := hw_fst
      refine ⟨δ, fun g => ?_, fun g₁ g₂ hne => ?_, ?_, fun g h m_h hm_fst hm_snd => ?_⟩
      · have : AlgebraicGeometry.IsOpenImmersion (δ g) := hOpen_δ g
        exact ⟨CategoryTheory.Limits.pullback.lift_fst _ _ _,
          CategoryTheory.Limits.pullback.lift_snd _ _ _,
          hOpen_δ g, inferInstance, (δ g).isOpenEmbedding.isOpen_range⟩
      · rw [hRange_δ g₁, hRange_δ g₂]
        exact (hγ_disj hne).preimage Ψ.base
      · ext y
        simp only [Set.mem_iUnion, hRange_δ, Set.mem_preimage, Set.mem_univ, iff_true]
        have hy : Ψ.base y ∈ (⋃ g : Γ, Set.range (γ_sheet g).base) :=
          hγ_univ.symm ▸ Set.mem_univ _
        exact Set.mem_iUnion.mp hy
      · apply CategoryTheory.Limits.pullback.hom_ext
        · calc (δ g ≫ m_h) ≫ p₁
              = δ g ≫ (m_h ≫ p₁) := Category.assoc _ _ _
            _ = δ g ≫ p₁ := by rw [hm_fst]
            _ = 𝟙 Z := by dsimp [δ, p₁]; rw [CategoryTheory.Limits.pullback.lift_fst]
            _ = δ (h * g) ≫ p₁ := by
                  dsimp [δ, p₁]; rw [CategoryTheory.Limits.pullback.lift_fst]
        · calc (δ g ≫ m_h) ≫ p₂
              = δ g ≫ (m_h ≫ p₂) := Category.assoc _ _ _
            _ = (δ g ≫ p₂) ≫ act h := by rw [hm_snd, ← Category.assoc]
            _ = (g_Z ≫ act g) ≫ act h := by
                  dsimp [δ, p₂]; rw [CategoryTheory.Limits.pullback.lift_snd]
            _ = g_Z ≫ (act g ≫ act h) := Category.assoc _ _ _
            _ = g_Z ≫ act (h * g) := by rw [← hact_mul h g]
            _ = δ (h * g) ≫ p₂ := by
                  dsimp [δ, p₂]; rw [CategoryTheory.Limits.pullback.lift_snd]

    have hBuildSheetLC : ∀ {Z P : AlgebraicGeometry.Scheme.{u}} {B : Type}
        (fst : P ⟶ Z) (δ : Γ → (Z ⟶ P)),
        (∀ g : Γ, δ g ≫ fst = 𝟙 Z) →
        (∀ g : Γ, IsOpen (Set.range (δ g).base)) →
        (∀ g₁ g₂ : Γ, g₁ ≠ g₂ → Disjoint (Set.range (δ g₁).base) (Set.range (δ g₂).base)) →
        (⋃ g : Γ, Set.range (δ g).base) = Set.univ →
        ∀ (val : Γ → LocallyConstant ↥Z B),
          ∃ F : LocallyConstant ↥P B, ∀ (g : Γ) (z : ↥Z), F ((δ g).base z) = val g z := by
      intro Z P B fst δ h_fst h_open h_disj h_univ val
      have hex : ∀ y : ↥P, ∃ g : Γ, y ∈ Set.range (δ g).base := fun y =>
        Set.mem_iUnion.mp (h_univ.symm ▸ Set.mem_univ y)
      let g_of : ↥P → Γ := fun y => Classical.choose (hex y)
      have hg_mem : ∀ y : ↥P, y ∈ Set.range (δ (g_of y)).base :=
        fun y => Classical.choose_spec (hex y)
      have hg_eq : ∀ (g : Γ) (z : ↥Z), g_of ((δ g).base z) = g := by
        intro g z
        by_contra hne
        exact Set.disjoint_left.mp (h_disj _ _ hne) (hg_mem ((δ g).base z)) ⟨z, rfl⟩
      have hfst_δ : ∀ (g : Γ) (z : ↥Z), fst.base ((δ g).base z) = z := fun g z =>
        congrArg (fun k : Z ⟶ Z => k.base z) (h_fst g)
      let toFun : ↥P → B := fun y => val (g_of y) (fst.base y)
      have htoFun_δ : ∀ (g : Γ) (z : ↥Z), toFun ((δ g).base z) = val g z := fun g z => by
        dsimp [toFun]
        rw [hg_eq g z, hfst_δ g z]
      have hlc : IsLocallyConstant toFun := by
        intro T
        have hpre : toFun ⁻¹' T =
            ⋃ g : Γ, (Set.range (δ g).base ∩ fst.base ⁻¹' ((val g) ⁻¹' T)) := by
          ext y
          simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_inter_iff]
          constructor
          · intro hy
            let g := g_of y
            obtain ⟨z, hz⟩ := hg_mem y
            refine ⟨g, ⟨z, hz⟩, ?_⟩
            have hy' : toFun ((δ g).base z) ∈ T := hz.symm ▸ hy
            rw [htoFun_δ g z] at hy'
            rw [← hz, hfst_δ g z]
            exact hy'
          · rintro ⟨g, ⟨z, rfl⟩, hzT⟩
            rw [hfst_δ] at hzT
            rw [htoFun_δ]
            exact hzT
        rw [hpre]
        exact isOpen_iUnion fun g =>
          (h_open g).inter (fst.continuous.isOpen_preimage _ ((val g).isLocallyConstant T))
      exact ⟨⟨toFun, hlc⟩, htoFun_δ⟩

    
    have h_s8_crux : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
        (A : Type) [AddCommGroup A] [Finite A], (∀ a : A, ℓ • a = 0) →
        ∀ (K_act : Γ → (A →+ A)),
          (∀ a : A, K_act 1 a = a) →
          (∀ (g₁ g₂ : Γ) (a : A), K_act (g₁ * g₂) a = K_act g₁ (K_act g₂ a)) →
        ∀ (𝒦 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
          (triv_K : ∀ W : S.Etale,
            let W_V := CategoryTheory.Limits.pullback
              ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).hom ι_V
            ↑(𝒦.obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_V A),
          (∀ {W₁ W₂ : S.Etale} (u : Quiver.Hom W₁ W₂),
            let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).hom
            let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).hom
            ∀ (u_V : Quiver.Hom (CategoryTheory.Limits.pullback h₁ ι_V)
                (CategoryTheory.Limits.pullback h₂ ι_V)),
              CategoryTheory.CategoryStruct.comp u_V (CategoryTheory.Limits.pullback.fst h₂ ι_V) =
                CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst h₁ ι_V)
                  ((AlgebraicGeometry.Scheme.Etale.forget S).map u).left →
              CategoryTheory.CategoryStruct.comp u_V (CategoryTheory.Limits.pullback.snd h₂ ι_V) =
                CategoryTheory.Limits.pullback.snd h₁ ι_V →
              ∀ (s : ↑(𝒦.obj.obj (Opposite.op W₂)))
                (y₁ : ↥(CategoryTheory.Limits.pullback h₁ ι_V)),
                triv_K W₁ ((𝒦.obj.map (Opposite.op u)).hom s) y₁ = triv_K W₂ s (u_V.base y₁)) →
          (∀ W : S.Etale,
            let h_W := ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).hom
            let W_V := CategoryTheory.Limits.pullback h_W ι_V
            Function.Injective (triv_K W) ∧
            Set.range (triv_K W) =
              { f |
                (∃ W₀ : ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left.Opens,
                  ((TopologicalSpace.Opens.map h_W.base).obj U) ⊔ W₀ = ⊤ ∧
                  ∀ y : ↥W_V,
                    (CategoryTheory.Limits.pullback.fst h_W ι_V).base y ∈ W₀ → f y = 0) ∧
                (∀ (g : Γ) (m_g : Quiver.Hom W_V W_V),
                  CategoryTheory.CategoryStruct.comp m_g (CategoryTheory.Limits.pullback.fst h_W ι_V) =
                    CategoryTheory.Limits.pullback.fst h_W ι_V →
                  CategoryTheory.CategoryStruct.comp m_g (CategoryTheory.Limits.pullback.snd h_W ι_V) =
                    CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd h_W ι_V)
                      (act g) →
                  ∀ y : ↥W_V, f (m_g.base y) = K_act g (f y)) }) →
          WeilIsConstructibleModPrimeSheaf ℓ S 𝒦 := by
      intro ℓ _ A _ _ hTors_A K_act hK_one hK_mul 𝒦 triv_K hNat_K hSpec_K
      let Fgt_S := AlgebraicGeometry.Scheme.Etale.forget S
      have hTor_K : ℓ • CategoryTheory.CategoryStruct.id 𝒦 = 0 := by
        apply CategoryTheory.Sheaf.hom_ext
        ext opW s
        apply (hSpec_K opW.unop).1
        apply LocallyConstant.ext
        intro y
        have hnsmul : ((ℓ • CategoryTheory.CategoryStruct.id 𝒦).hom.app opW).hom s = ℓ • s := rfl
        have hzero : ((0 : 𝒦 ⟶ 𝒦).hom.app opW).hom s = 0 := rfl
        rw [hnsmul, hzero, map_nsmul, map_zero]
        exact hTors_A (triv_K opW.unop s y)
      let V_et : S.Etale := AlgebraicGeometry.Scheme.Etale.mk ι_V
      let h_Vet := (Fgt_S.obj V_et).hom
      obtain ⟨γ₀, hγ₀_props, hγ₀_disj, hγ₀_univ, hγ₀_deck⟩ :=
        hClopenSheets (Fgt_S.obj V_et).left (𝟙 V : (Fgt_S.obj V_et).left ⟶ V) h_Vet
          (Category.id_comp ι_V)
      have hEx_s0 : ∀ c : A,
          ∃ s : ↑(𝒦.obj.obj (Opposite.op V_et)),
            ∀ (g : Γ) (v : ↥(Fgt_S.obj V_et).left), triv_K V_et s ((γ₀ g).base v) = K_act g c := by
        intro c
        obtain ⟨f_c, hf_c⟩ := hBuildSheetLC
          (CategoryTheory.Limits.pullback.fst h_Vet ι_V) γ₀
          (fun g => (hγ₀_props g).1) (fun g => (hγ₀_props g).2.2.2.2)
          hγ₀_disj hγ₀_univ (fun g => LocallyConstant.const ↥(Fgt_S.obj V_et).left (K_act g c))
        have hmem : f_c ∈ Set.range (triv_K V_et) := by
          rw [(hSpec_K V_et).2]
          refine ⟨⟨⊥, ?_, fun _ hy => False.elim hy⟩, fun g m_g hm1 hm2 y => ?_⟩
          · apply eq_top_iff.mpr
            intro v _
            apply TopologicalSpace.Opens.mem_sup.mpr
            left
            change ι_V.base v ∈ (U : Set ↥S)
            rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
            exact ⟨π.base v, rfl⟩
          · obtain ⟨g₀, v, rfl⟩ := Set.mem_iUnion.mp (hγ₀_univ.symm ▸ Set.mem_univ y)
            have hm_pt : m_g.base ((γ₀ g₀).base v) = (γ₀ (g * g₀)).base v :=
              congrArg (fun k => k.base v) (hγ₀_deck g₀ g m_g hm1 hm2)
            rw [hm_pt, hf_c (g * g₀) v, hf_c g₀ v]
            exact hK_mul g g₀ c
        obtain ⟨s, hs⟩ := hmem
        refine ⟨s, fun g v => ?_⟩
        rw [hs]
        exact hf_c g v
      let s₀ : A → ↑(𝒦.obj.obj (Opposite.op V_et)) := fun c => Classical.choose (hEx_s0 c)
      have hs₀_spec : ∀ (c : A) (g : Γ) (v : ↥(Fgt_S.obj V_et).left),
          triv_K V_et (s₀ c) ((γ₀ g).base v) = K_act g c :=
        fun c => Classical.choose_spec (hEx_s0 c)
      have hs₀_zero : s₀ 0 = 0 := by
        apply (hSpec_K V_et).1
        apply LocallyConstant.ext
        intro y
        obtain ⟨g, v, rfl⟩ := Set.mem_iUnion.mp (hγ₀_univ.symm ▸ Set.mem_univ y)
        rw [hs₀_spec 0 g v, map_zero, map_zero, LocallyConstant.zero_apply]
      have hs₀_add : ∀ c₁ c₂ : A, s₀ (c₁ + c₂) = s₀ c₁ + s₀ c₂ := by
        intro c₁ c₂
        apply (hSpec_K V_et).1
        apply LocallyConstant.ext
        intro y
        obtain ⟨g, v, rfl⟩ := Set.mem_iUnion.mp (hγ₀_univ.symm ▸ Set.mem_univ y)
        rw [hs₀_spec (c₁ + c₂) g v, map_add, map_add, LocallyConstant.add_apply,
          hs₀_spec c₁ g v, hs₀_spec c₂ g v]
      let u_aut : Γ → (V_et ⟶ V_et) := fun μ =>
        have : AlgebraicGeometry.Etale (act μ) := hact_et μ
        CategoryTheory.MorphismProperty.Over.homMk (act μ) (hact_ι μ) trivial
      have hs₀_deck : ∀ (μ : Γ) (c : A),
          (𝒦.obj.map (u_aut μ).op).hom (s₀ c) = s₀ (K_act μ⁻¹ c) := by
        intro μ c
        apply (hSpec_K V_et).1
        let fst₀ := CategoryTheory.Limits.pullback.fst h_Vet ι_V
        let snd₀ := CategoryTheory.Limits.pullback.snd h_Vet ι_V
        let act_et : (Fgt_S.obj V_et).left ⟶ (Fgt_S.obj V_et).left := (Fgt_S.map (u_aut μ)).left
        let u_0 : CategoryTheory.Limits.pullback h_Vet ι_V ⟶
            CategoryTheory.Limits.pullback h_Vet ι_V :=
          CategoryTheory.Limits.pullback.lift (fst₀ ≫ act_et) snd₀
            (by rw [Category.assoc, CategoryTheory.Over.w (Fgt_S.map (u_aut μ)),
                  CategoryTheory.Limits.pullback.condition])
        apply LocallyConstant.ext
        intro y
        obtain ⟨g, v, rfl⟩ := Set.mem_iUnion.mp (hγ₀_univ.symm ▸ Set.mem_univ y)
        have hnat := hNat_K (u_aut μ) u_0
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) (s₀ c) ((γ₀ g).base v)
        have hγ_u : γ₀ g ≫ u_0 = act_et ≫ γ₀ (g * μ⁻¹) := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · calc (γ₀ g ≫ u_0) ≫ fst₀
                = γ₀ g ≫ (fst₀ ≫ act_et) := by
                    rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
