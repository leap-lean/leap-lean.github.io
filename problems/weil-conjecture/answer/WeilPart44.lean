      let p_E : Quiver.Hom E_sch ((Fgt.obj Z).left) := CategoryTheory.Limits.pullback.fst δ₁₂ Δ_x
      let q_E : Quiver.Hom E_sch A₁ := CategoryTheory.Limits.pullback.snd δ₁₂ Δ_x
