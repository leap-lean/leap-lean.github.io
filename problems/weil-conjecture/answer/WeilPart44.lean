      let e : Quiver.Hom E Z := CategoryTheory.MorphismProperty.Over.homMk p_E rfl
      refine ⟨E, e, z_E, hz_E_fst, ?_⟩
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
