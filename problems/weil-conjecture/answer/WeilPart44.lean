        intro θ₁ θ₂ h₁ h₂
        rcases h₁ with ⟨U₁, hU₁_obj, hU₁_map, hAdd₁, hLim₁, hColim₁,
          T₁, hT₁, hT₁_left, hT₁_hom, u₁, hu₁, β₁, hαβ₁, hβα₁, hθ₁_eval⟩
        rcases h₂ with ⟨U₂, hU₂_obj, hU₂_map, hAdd₂, hLim₂, hColim₂,
          T₂, hT₂, hT₂_left, hT₂_hom, u₂, hu₂, β₂, hαβ₂, _, hθ₂_eval⟩
        have hSheafEq : ∀ {P₁ P₂ : (S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}}
            (hP : P₁ = P₂) (hp₁ : CategoryTheory.Presheaf.IsSheaf J P₁)
            (hp₂ : CategoryTheory.Presheaf.IsSheaf J P₂),
            (⟨P₁, hp₁⟩ : C_Z) = ⟨P₂, hp₂⟩ := by
          intro P₁ P₂ hP hp₁ hp₂
          subst hP
          rfl
        have hHomEq : ∀ {A₁ A₂ B₁ B₂ : C_Z} (hA : A₁ = A₂) (hB : B₁ = B₂)
            (f : A₁ ⟶ B₁) (g : A₂ ⟶ B₂),
            (∀ W : (S.Etale)ᵒᵖ, HEq (f.hom.app W) (g.hom.app W)) →
            f = eqToHom hA ≫ g ≫ eqToHom hB.symm := by
          intro A₁ A₂ B₁ B₂ hA hB f g hfg
          subst hA hB
          simp only [eqToHom_refl, Category.id_comp, Category.comp_id]
          ext W : 3
          exact eq_of_heq (hfg W)
        have hU_eq : U₁ = U₂ := by
          have hObj : ∀ F_sh : C_R, U₁.obj F_sh = U₂.obj F_sh := fun F_sh =>
            hSheafEq ((hU₁_obj F_sh).trans (hU₂_obj F_sh).symm)
              (U₁.obj F_sh).property (U₂.obj F_sh).property
          refine CategoryTheory.Functor.ext hObj (fun {F₁ F₂} u_mor => ?_)
          exact hHomEq (hObj F₁) (hObj F₂) (U₁.map u_mor) (U₂.map u_mor)
            (fun W => (hU₁_map u_mor W).trans (hU₂_map u_mor W).symm)
        subst hU_eq
        have hEtaleCanon : ∀ (T : S.Etale),
            ((AlgebraicGeometry.Scheme.Etale.forget S).obj T).left = S →
            HEq ((AlgebraicGeometry.Scheme.Etale.forget S).obj T).hom
              (CategoryTheory.CategoryStruct.id S) →
            T = CategoryTheory.MorphismProperty.Over.mk ⊤
              (CategoryTheory.CategoryStruct.id S)
              (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S)) := by
          intro T hleft hhom
