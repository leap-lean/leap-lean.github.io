      · exact (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg ((O'_g W g).ι ≫ fst₁ (obj_WV W) ≫ ·) (hσ_snd W g)).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg ((O'_g W g).ι ≫ ·) (CategoryTheory.Category.assoc _ _ _).symm).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
