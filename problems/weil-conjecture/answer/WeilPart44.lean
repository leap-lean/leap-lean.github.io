      (hη_spec r).2.1 (invEquiv r lam₁) (invEquiv r lam₂) (invEquiv r lam₃) hsum
    exact (congrArg (fun x => (M_c2.iso_bar r).inv ≫
      (adj_pr.homEquiv (𝒥₀ r) (weilEtaleTorsionSheaf S (ℓ ^ (r + 1)))).symm x) hη_add).trans
      ((congrArg ((M_c2.iso_bar r).inv ≫ ·) (hEquiv_symm_add _ _)).trans
        (hIsoPrecompAdd (M_c2.iso_bar r) _ _))

  · 
    intro r lam_up lam_dn hcast
    let cast_r := ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
    let φ_A : A_tors (r + 1) ⟶ A_tors r :=
      AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom cast_r.toAddMonoidHom)
    let π_tors := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map φ_A
    have hπ_θ : ∀ (Y : S.Etale)
        (g : LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y).left
          (ULift.{u} (ZMod (ℓ ^ (r + 1 + 1))))),
        (π_tors.hom.app (Opposite.op Y)).hom (θ_S (r + 1) Y g) =
          θ_S r Y (g.map (ULift.map cast_r)) := by
      intro Y g
      have hT_eq : hT_S_lvl (r + 1) = hT_S_lvl r :=
        @Subsingleton.elim _ (CategoryTheory.Limits.IsLimit.subsingleton) _ _
      have hConst_T : ∀ a : ULift.{u} (ZMod (ℓ ^ (r + 1 + 1))),
          (π_tors.hom.app (Opposite.op T_S)).hom (θ_S (r + 1) T_S (LocallyConstant.const _ a)) =
            θ_S r T_S (LocallyConstant.const _ (ULift.map cast_r a)) := by
        intro a
        rw [hθ_unit (r + 1) a, hθ_unit r (ULift.map cast_r a), hT_eq]
        let adj_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u}
