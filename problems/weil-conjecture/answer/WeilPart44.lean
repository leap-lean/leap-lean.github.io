          (∀ (y₀ : M.M₀) (q₁ : Fin m₁ → MonoidAlgebra (ZMod (ℓ ^ K)) Γ),
            M.δ₀ y₀ + γ₁ q₁ = 0 → d₁ q₁ = 0 →
            ∃ q₀ : Fin m₀ → MonoidAlgebra (ZMod (ℓ ^ K)) Γ,
              e₀ q₀ = q₀ ∧ γ₀ q₀ = y₀ ∧ - d₀ q₀ = q₁) ∧
          (∀ q₀ : Fin m₀ → MonoidAlgebra (ZMod (ℓ ^ K)) Γ,
            e₀ q₀ = q₀ → γ₀ q₀ = 0 → d₀ q₀ = 0 → q₀ = 0)),
        ∃ P_σ : Γ → WeilCurveTrFreeComplex (ℓ ^ K),
          (∀ σ : Γ, WeilCurveTrHasBoundedLatticeModel ℓ K B₂ (P_σ σ) (b_V σ) (M_lat_V σ)) ∧
          (∀ σ : Γ,
            weilCurveTrAltTrace (P_σ σ) =
              (∑ u : Γ, ∑ j : Fin m₀, ((Φ0_tilde (Pi.single j 1)) j).coeff ((u⁻¹ * σ * u)⁻¹)) -
              (∑ u : Γ, ∑ j : Fin m₁, ((Φ₁ (Pi.single j 1)) j).coeff ((u⁻¹ * σ * u)⁻¹)) +
              (∑ u : Γ, ∑ j : Fin m₂, ((Φ₂ (Pi.single j 1)) j).coeff ((u⁻¹ * σ * u)⁻¹))) := by
    clear h_pillar1; clear hBridge; clear hFlat; clear hFinH
    clear F_K; clear τ_rep
    clear hK'K; clear hsK'; clear hN
    clear K'; clear s; clear N
    intro hK m₀ m₁ m₂ e₀ Φ0_tilde d₀ d₁ Φ₁ Φ₂ γ₀ γ₁ γ₂ h₁ h₂ hIdemp hComm hHtpy hCone
    classical
    let Λ := ZMod (ℓ ^ K)
    let R := MonoidAlgebra Λ Γ
    have hp : Nat.Prime ℓ := Fact.out
    have h1lt_K : 1 < ℓ ^ K := one_lt_pow₀ hp.one_lt (by omega)
    have : Fact (1 < ℓ ^ K) := ⟨h1lt_K⟩
    have : NeZero (ℓ ^ K) := ⟨pow_ne_zero K hp.ne_zero⟩
    have hLocal : IsLocalRing Λ := by
      apply IsLocalRing.of_nonunits_add
      intro a b ha hb hab
      have h_dvd : ∀ x : Λ, ¬ IsUnit x → ℓ ∣ x.val := by
        intro x hx
        by_contra hndvd
        have hcop : Nat.Coprime x.val (ℓ ^ K) :=
          ((hp.coprime_iff_not_dvd.mpr hndvd).symm).pow_right K
        have hu : IsUnit ((x.val : ℕ) : Λ) := (ZMod.isUnit_iff_coprime x.val (ℓ ^ K)).mpr hcop
        rw [ZMod.natCast_zmod_val] at hu
        exact hx hu
      have h_not_unit : ∀ x : Λ, ℓ ∣ x.val → ¬ IsUnit x := by
        intro x hxdvd hx
        have hu : IsUnit ((x.val : ℕ) : Λ) := by rwa [ZMod.natCast_zmod_val]
        have hcop : Nat.Coprime x.val (ℓ ^ K) := (ZMod.isUnit_iff_coprime x.val (ℓ ^ K)).mp hu
        have hdvd1 : ℓ ∣ 1 := by
          rw [← hcop.gcd_eq_one]
          exact Nat.dvd_gcd hxdvd (dvd_pow_self ℓ (by omega))
        exact hp.not_dvd_one hdvd1
      have hab_dvd : ℓ ∣ (a + b).val := by
        rw [ZMod.val_add]
        exact (Nat.dvd_mod_iff (dvd_pow_self ℓ (by omega))).mpr (dvd_add (h_dvd a ha) (h_dvd b hb))
      exact h_not_unit (a + b) hab_dvd hab
    have h_algMap_R : ∀ c : Λ, algebraMap Λ R c = MonoidAlgebra.single (1 : Γ) c := by
      intro c
      have h1 := congrFun (MonoidAlgebra.coe_algebraMap (R := Λ) (A := Λ) (M := Γ)) c
      simpa only [Function.comp_apply, Algebra.algebraMap_self, RingHom.id_apply] using h1
    have h_smul_single1 : ∀ {k : ℕ} (c : Λ) (u : Fin k → R),
        c • u = (MonoidAlgebra.single (1 : Γ) c : R) • u := by
      intro k c u
      funext j
      change c • (u j) = MonoidAlgebra.single 1 c * u j
      rw [Algebra.smul_def, h_algMap_R]
    have h_coeff_add : ∀ (r₁ r₂ : R) (g : Γ), (r₁ + r₂).coeff g = r₁.coeff g + r₂.coeff g :=
      fun _ _ _ => rfl
    have h_coeff_smul : ∀ (c : Λ) (r : R) (g : Γ), (c • r).coeff g = c * r.coeff g := by
      intro c r g
      rw [Algebra.smul_def, h_algMap_R, MonoidAlgebra.coeff_single_mul_apply, inv_one, one_mul]
    have h_coeff_sum : ∀ (f : Γ → R) (g₀ : Γ),
