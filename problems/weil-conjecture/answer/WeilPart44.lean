        exact @Subsingleton.elim _ (hEmptySub ℱ Z hZ) _ _
    have hσ_inner : ∀ (W : S.Etale) (g h : Γ),
        CategoryTheory.CategoryStruct.comp (σ_g W g) (m_can (obj_WV W) h) = σ_g W (h * g) := by
      intro W g h
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Category.assoc _ _ _).trans
