        (_hDeg0 : ∀ (F : 𝒞₀) (φ : CategoryTheory.Abelian.Ext.{u} one₀ F 2 →+ ZMod m),
          ∃! f : CategoryTheory.Abelian.Ext.{u} F one₀ 0,
