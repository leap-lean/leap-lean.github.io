              Nat.pow_lt_pow_right hPrime.one_lt (Nat.lt_succ_self s)
            omega
          · have hj_eq : j = s + 2 := by omega
            rw [← hj_eq, ← hord_eq]; exact hord_m
      exact ⟨v, by simpa [v] using hw_prim, hv_pow⟩
    let tower : ∀ s : ℕ,
        { u : (AlgebraicClosure F)ˣ //
          IsPrimitiveRoot ((u : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) (ℓ ^ (s + 1)) } :=
      Nat.rec ⟨u₁, hu₁_prim⟩ (fun s prev =>
        ⟨Classical.choose (hStep s prev.1 prev.2),
         (Classical.choose_spec (hStep s prev.1 prev.2)).1⟩)
    let ζ : ℕ → (AlgebraicClosure F)ˣ := fun r =>
      match r with
      | 0 => 1
      | s + 1 => (tower s).1
    have hPrim : ∀ r : ℕ,
        IsPrimitiveRoot ((ζ r : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) (ℓ ^ r) := by
      intro r; cases r with | zero => exact IsPrimitiveRoot.one | succ s => exact (tower s).2
    have hPow : ∀ r : ℕ, (ζ (r + 1)) ^ ℓ = ζ r := by
      intro r
      cases r with
      | zero => exact hu₁_pow
      | succ s => exact (Classical.choose_spec (hStep s (tower s).1 (tower s).2)).2
    obtain ⟨tr, hTrCompat, hEff⟩ :=
      weil_etale_smooth_proper_trace_and_local_effacement (AlgebraicClosure F)
        (weilBaseChangeOver F (AlgebraicClosure F) Z₀) hIntS 1 ℓ hℓ_k ζ hPrim hPow
    have hMod3 := (weil_etale_module_ext_comparison.{u}.2.2 F Z₀).1
    let f_top : ∀ r : ℕ, weilEtaleTorsionH (weilGeomScheme F Z₀) (ℓ ^ (r + 1)) 2 →+
        weilEtaleTorsionH (weilGeomScheme F Z₀) (ℓ ^ (r + 1)) 2 :=
      fun r => Classical.choose (hMod3 (ℓ ^ (r + 1)) 2)
    have hf_top : ∀ r : ℕ,
        WeilIsTorsionGeomFrobAction F Z₀ (ℓ ^ (r + 1)) 2 (f_top r) :=
      fun r => Classical.choose_spec (hMod3 (ℓ ^ (r + 1)) 2)
    have hf_smul : ∀ (r : ℕ) (w : weilEtaleTorsionH (weilGeomScheme F Z₀) (ℓ ^ (r + 1)) 2),
        f_top r w = (Nat.card F) • w := by
      intro r w
      have h := weil_etale_top_degree_geom_frob_smul F Z₀ 1 ℓ hℓ (r + 1) (f_top r) (hf_top r) w
      rwa [pow_one] at h
    have hGod : ∀ r : ℕ, WeilHasTruncatedGodementComplex (weilGeomScheme F Z₀) 1 (ℓ ^ r) :=
      fun r => weil_etale_truncated_godement_acyclic_complex (AlgebraicClosure F)
        (weilBaseChangeOver F (AlgebraicClosure F) Z₀) 1 (ℓ ^ r) (hm_pow r) (hUnit r) hDim
    have hHomBij_all : ∀ (r : ℕ)
        (ℱ : CategoryTheory.Sheaf (weilGeomScheme F Z₀).smallEtaleTopology AddCommGrpCat.{u}),
        (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id ℱ = 0 →
        Function.Bijective
          (fun (f : Quiver.Hom ℱ
              (weilEtaleTorsionSheaf (weilGeomScheme F Z₀) (ℓ ^ (r + 1)))) =>
            (tr (r + 1)).comp
              ((CategoryTheory.Abelian.Ext.mk₀ f).postcomp
                ((CategoryTheory.constantSheaf
                    (weilGeomScheme F Z₀).smallEtaleTopology AddCommGrpCat.{u}).obj
                  (AddCommGrpCat.of (ULift.{u} ℤ)))
                (Nat.add_zero 2))) :=
      fun r ℱ hTor => hMakeHomBij (weilGeomScheme F Z₀) (ℓ ^ (r + 1)) (hm_pow (r + 1))
        (tr (r + 1)) (hGod (r + 1)) (hEff (r + 1)) ℱ hTor
    exact ⟨tr, f_top, hTrCompat, hf_top, hf_smul, hGod, hHomBij_all⟩

  
  obtain ⟨hGeomD₀, hPropD₀, hSmD₀⟩ := weil_coinv_projLine_proper_smooth_geomIrred F
  have : AlgebraicGeometry.GeometricallyIrreducible (weilProjectiveSpaceOver F 1).hom := hGeomD₀
  have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver F 1).hom := hPropD₀
  have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (weilProjectiveSpaceOver F 1).hom := hSmD₀
  obtain ⟨tr, f_top, hTrCompat, hf_top, hf_smul, hGod, hHomBij_all⟩ :=
    hOverVerdier (weilProjectiveSpaceOver F 1)
  obtain ⟨hTor_J, hEpi_τ, hFrobTrans_J, ⟨α, hBij_α, hAdd_α, hCompat_α, hFrob_α⟩⟩ :=
    weil_coinv_zero_ext_hom_equiv F S_aff j_aff hj_hom U₀ u₀ ℓ N H_geom A_u A_mat 𝒥₀ τ_𝒥
      hZExt M_c2
  obtain ⟨pair, hSurj_T, hCompat_pair, hLeft_pair, hRight_pair, hFrob_pair⟩ :=
    hAbstractSite (weilGeomScheme F (weilProjectiveSpaceOver F 1)) tr hTrCompat f_top hf_smul
      hGod M_c2.ℳ_bar M_c2.τ_bar M_c2.frobTorsion hTor_J hEpi_τ
      (fun r => hHomBij_all r (M_c2.ℳ_bar r) (hTor_J r))
      α hBij_α hAdd_α hCompat_α (fun r => hFrob_α r (f_top r) (hf_top r))
  let T_coh : ∀ r : ℕ, (M_c2.ℳ_bar (r + 1)).H 2 →+ (M_c2.ℳ_bar r).H 2 :=
    fun r => (CategoryTheory.Abelian.Ext.mk₀ (M_c2.τ_bar r)).postcomp
      ((CategoryTheory.constantSheaf
          (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology
          AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ)))
      (Nat.add_zero 2)
  exact hPadicPairing (Nat.card F) (fun r => (M_c2.ℳ_bar r).H 2) T_coh hSurj_T
    M_c2.frobTorsion hFrobTrans_J M_c2.V M_c2.frob M_c2.sysSubgroup M_c2.hsys M_c2.equiv
    M_c2.hsmul M_c2.hfrob pair hCompat_pair hLeft_pair hRight_pair hFrob_pair

theorem weil_curve_tr_pir_complex_trace_congruence (ℓ K K' B : ℕ) [Fact (Nat.Prime ℓ)]
    (hKB : K' + 12 * B ≤ K)
    (C : WeilCurveTrFreeComplex (ℓ ^ K))
    (b : Fin 3 → ℕ)
    (M_lat : ∀ i : Fin 3, Matrix (Fin (b i)) (Fin (b i)) (PadicInt ℓ))
    (hModel : WeilCurveTrHasBoundedLatticeModel ℓ K B C b M_lat) :
    ZMod.castHom (pow_dvd_pow ℓ (Nat.le_of_add_right_le hKB)) (ZMod (ℓ ^ K'))
      (weilCurveTrAltTrace C) =
      PadicInt.toZModPow K'
        (Matrix.trace (M_lat 0) - Matrix.trace (M_lat 1) + Matrix.trace (M_lat 2)) :=
by
  classical
  rcases Nat.eq_zero_or_pos K' with rfl | hK'_pos
  · have _ : Subsingleton (ZMod (ℓ ^ 0)) := by
      change Subsingleton (ZMod 1)
      infer_instance
    exact Subsingleton.elim _ _
  have hPrime : Nat.Prime ℓ := Fact.out
  have hK'K : K' ≤ K := Nat.le_of_add_right_le hKB
  have hBK : 1 + 12 * B ≤ K := by omega
  have hK_pos : 1 ≤ K := by omega
  have : NeZero (ℓ ^ K) := ⟨pow_ne_zero K hPrime.ne_zero⟩
  have : NeZero (ℓ ^ K') := ⟨pow_ne_zero K' hPrime.ne_zero⟩

  
  let A : ∀ i : Fin 3, Matrix (Fin (b i)) (Fin (b i)) (ZMod (ℓ ^ K)) :=
    fun i => (M_lat i).map (PadicInt.toZModPow K)
  let castK' : ZMod (ℓ ^ K) →+* ZMod (ℓ ^ K') :=
    ZMod.castHom (pow_dvd_pow ℓ hK'K) (ZMod (ℓ ^ K'))
  have hRHS_eq :
      PadicInt.toZModPow K'
        (Matrix.trace (M_lat 0) - Matrix.trace (M_lat 1) + Matrix.trace (M_lat 2)) =
      castK' ((A 0).trace - (A 1).trace + (A 2).trace) := by
    have hcomp := (PadicInt.zmod_cast_comp_toZModPow (p := ℓ) K' K hK'K).symm
    have hpt : ∀ z : PadicInt ℓ, PadicInt.toZModPow K' z = castK' (PadicInt.toZModPow K z) :=
      fun z => RingHom.congr_fun hcomp z
    have htr : ∀ i : Fin 3,
        PadicInt.toZModPow K (Matrix.trace (M_lat i)) = (A i).trace := by
      intro i
      simp only [A, Matrix.trace, Matrix.diag, Matrix.map_apply, map_sum]
    rw [hpt, map_add, map_sub, htr 0, htr 1, htr 2]
  rw [hRHS_eq]

  
  have hSumSplit : ∀ {r s N : ℕ} (hN : r + s = N)
      (f : Fin N → ZMod (ℓ ^ K)),
      (∑ k : Fin N, f k) =
        (∑ a : Fin r, f ⟨a.1, by omega⟩) + (∑ c : Fin s, f ⟨r + c.1, by omega⟩) := by
    intro r s N hN f
    rw [← Equiv.sum_comp (finCongr hN) f, Fin.sum_univ_add]
    rfl

  have hPowDvdVal : ∀ (s : ℕ), s ≤ K → ∀ (x c : ZMod (ℓ ^ K)),
      x = ((ℓ ^ s : ℕ) : ZMod (ℓ ^ K)) * c → ℓ ^ s ∣ x.val := by
    intro s hs x c hxc
    have hc : c = (c.val : ZMod (ℓ ^ K)) := (ZMod.natCast_zmod_val c).symm
    rw [hc, ← Nat.cast_mul] at hxc
    rw [hxc, ZMod.val_natCast]
    exact (Nat.dvd_mod_iff (pow_dvd_pow ℓ hs)).mpr (dvd_mul_right (ℓ ^ s) c.val)

  have hPowEqHigherMulFalse : ∀ (m : ℕ), m < K → ∀ (w : ZMod (ℓ ^ K)),
      ((ℓ ^ m : ℕ) : ZMod (ℓ ^ K)) = ((ℓ ^ (m + 1) : ℕ) : ZMod (ℓ ^ K)) * w → False := by
    intro m hm w hw
    have hdvd : ℓ ^ (m + 1) ∣ (((ℓ ^ m : ℕ) : ZMod (ℓ ^ K))).val :=
      hPowDvdVal (m + 1) (by omega) _ w hw
    have hlt : ℓ ^ m < ℓ ^ K := Nat.pow_lt_pow_right hPrime.one_lt hm
    rw [ZMod.val_natCast_of_lt hlt] at hdvd
    exact Nat.not_dvd_of_pos_of_lt (pow_pos hPrime.pos m)
      (Nat.pow_lt_pow_right hPrime.one_lt (Nat.lt_succ_self m)) hdvd

  have hPowKillHigher : ∀ (s t : ℕ), s ≤ t → ∀ (x : ZMod (ℓ ^ K)),
      ((ℓ ^ s : ℕ) : ZMod (ℓ ^ K)) * x = 0 → ((ℓ ^ t : ℕ) : ZMod (ℓ ^ K)) * x = 0 := by
    intro s t hst x hx
    have hts : t = (t - s) + s := (Nat.sub_add_cancel hst).symm
    rw [hts, pow_add, Nat.cast_mul, mul_assoc, hx, mul_zero]

  have hCancelPow : ∀ (s : ℕ), s ≤ K → ∀ (x : ZMod (ℓ ^ K)),
      ((ℓ ^ s : ℕ) : ZMod (ℓ ^ K)) * x = 0 →
      ∃ z : ZMod (ℓ ^ K), x = ((ℓ ^ (K - s) : ℕ) : ZMod (ℓ ^ K)) * z := by
    intro s hs x hx
    have hx_val : (((ℓ ^ s * x.val : ℕ) : ZMod (ℓ ^ K))) = 0 := by
      rw [Nat.cast_mul, ZMod.natCast_zmod_val, hx]
    have hdvdK : ℓ ^ K ∣ ℓ ^ s * x.val :=
      (ZMod.natCast_eq_zero_iff (ℓ ^ s * x.val) (ℓ ^ K)).mp hx_val
    have hKs : ℓ ^ K = ℓ ^ s * ℓ ^ (K - s) := by
      rw [← pow_add, Nat.add_sub_cancel' hs]
    have hdvdK' : ℓ ^ s * ℓ ^ (K - s) ∣ ℓ ^ s * x.val := hKs ▸ hdvdK
    rcases (Nat.mul_dvd_mul_iff_left (pow_pos hPrime.pos s)).mp hdvdK' with ⟨q, hq⟩
    refine ⟨(q : ZMod (ℓ ^ K)), ?_⟩
    rw [← Nat.cast_mul, ← hq, ZMod.natCast_zmod_val]

  have hCastEqOfPowKill : ∀ (M : ℕ), K' + M ≤ K → ∀ (x y : ZMod (ℓ ^ K)),
      ((ℓ ^ M : ℕ) : ZMod (ℓ ^ K)) * (x - y) = 0 →
      castK' x = castK' y := by
    intro M hMK x y hkill
    obtain ⟨z, hz⟩ := hCancelPow M (by omega) (x - y) hkill
    have hsub : castK' (x - y) = 0 := by
      rw [hz, map_mul, map_natCast]
      have h0 : ((ℓ ^ (K - M) : ℕ) : ZMod (ℓ ^ K')) = 0 :=
        (ZMod.natCast_eq_zero_iff _ _).mpr (pow_dvd_pow ℓ (by omega))
      rw [h0, zero_mul]
    rw [map_sub] at hsub
    exact sub_eq_zero.mp hsub

  have hNatFactor : ∀ w : ℕ, 1 ≤ w → ∃ v u₀ : ℕ, w = ℓ ^ v * u₀ ∧ ¬ (ℓ ∣ u₀) := by
    intro w
    induction w using Nat.strongRecOn with
    | ind w ih =>
      intro hw
      by_cases hdvd : ℓ ∣ w
      · rcases hdvd with ⟨w', rfl⟩
        have hw'_pos : 1 ≤ w' := by
          rcases Nat.eq_zero_or_pos w' with rfl | hpos
          · simp at hw
          · exact hpos
        have hw'_lt : w' < ℓ * w' := lt_mul_of_one_lt_left hw'_pos hPrime.one_lt
        obtain ⟨v, u₀, hwu, hndvd⟩ := ih w' hw'_lt hw'_pos
        exact ⟨v + 1, u₀, by rw [hwu, pow_succ']; ring, hndvd⟩
      · exact ⟨0, w, by simp, hdvd⟩

  have hZModFactor : ∀ x : ZMod (ℓ ^ K),
      ∃ (v : ℕ) (u : (ZMod (ℓ ^ K))ˣ),
        v ≤ K ∧ x = ((ℓ ^ v : ℕ) : ZMod (ℓ ^ K)) * u.val ∧ (x = 0 ↔ v = K) := by
    intro x
    by_cases hx : x = 0
    · refine ⟨K, 1, le_rfl, ?_, by simp [hx]⟩
      rw [hx, ZMod.natCast_self, zero_mul]
    · have hval_ne : x.val ≠ 0 := by
        intro hv0
        apply hx
        rw [← ZMod.natCast_zmod_val x, hv0, Nat.cast_zero]
      obtain ⟨v, u₀, hfac, hndvd⟩ := hNatFactor x.val (Nat.pos_of_ne_zero hval_ne)
      have hv_lt : v < K := by
        by_contra hge
        have hdvd : ℓ ^ K ∣ x.val :=
          dvd_trans (pow_dvd_pow ℓ (Nat.le_of_not_lt hge)) ⟨u₀, hfac⟩
        exact absurd (Nat.le_of_dvd (Nat.pos_of_ne_zero hval_ne) hdvd)
          (not_le_of_gt (ZMod.val_lt x))
      have hcop : Nat.Coprime u₀ (ℓ ^ K) :=
        (hPrime.coprime_iff_not_dvd.mpr hndvd).symm.pow_right K
      have hu_unit : IsUnit (u₀ : ZMod (ℓ ^ K)) :=
        (ZMod.isUnit_iff_coprime u₀ (ℓ ^ K)).mpr hcop
      rcases hu_unit with ⟨u, hu_eq⟩
      refine ⟨v, u, hv_lt.le, ?_, ⟨fun h => absurd h hx, fun h => absurd h hv_lt.ne⟩⟩
      rw [hu_eq, ← Nat.cast_mul, ← hfac, ZMod.natCast_zmod_val]

  let ν : ZMod (ℓ ^ K) → ℕ := fun x => (hZModFactor x).choose
  let u_fac : ZMod (ℓ ^ K) → (ZMod (ℓ ^ K))ˣ := fun x => (hZModFactor x).choose_spec.choose
  have hν_spec : ∀ x : ZMod (ℓ ^ K),
      ν x ≤ K ∧ x = ((ℓ ^ ν x : ℕ) : ZMod (ℓ ^ K)) * (u_fac x).val ∧ (x = 0 ↔ ν x = K) :=
    fun x => (hZModFactor x).choose_spec.choose_spec

  
  let blkDiagFun : ∀ (r s N : ℕ), r + s = N →
      Matrix (Fin s) (Fin s) (ZMod (ℓ ^ K)) → Matrix (Fin N) (Fin N) (ZMod (ℓ ^ K)) :=
    fun r s N _ M => Matrix.of fun i j =>
      if hi : i.1 < r then
        if i = j then 1 else 0
      else if hj : j.1 < r then
        0
      else
        M ⟨i.1 - r, by omega⟩ ⟨j.1 - r, by omega⟩

  let blkDiagHom : ∀ (r s N : ℕ) (hN : r + s = N),
      Matrix (Fin s) (Fin s) (ZMod (ℓ ^ K)) →* Matrix (Fin N) (Fin N) (ZMod (ℓ ^ K)) :=
    fun r s N hN =>
      { toFun := blkDiagFun r s N hN
        map_one' := by
          ext i j
          simp only [blkDiagFun, Matrix.of_apply]
          split_ifs with hi h_ij hj
          · subst h_ij; simp
          · exact (Matrix.one_apply_ne h_ij).symm
          · have hne : i ≠ j := fun h => hi (h ▸ hj)
            exact (Matrix.one_apply_ne hne).symm
          · by_cases h_ij : i = j
            · subst h_ij; simp
            · have hne' : (⟨i.1 - r, by omega⟩ : Fin s) ≠ ⟨j.1 - r, by omega⟩ := by
                intro heq
                apply h_ij
                ext
                have := congrArg Fin.val heq
                dsimp at this
                omega
              rw [Matrix.one_apply_ne hne', Matrix.one_apply_ne h_ij]
        map_mul' := by
          intro M₁ M₂
          ext i j
          rw [Matrix.mul_apply, hSumSplit hN]
          by_cases hi : i.1 < r
          · have hsum2 : (∑ c : Fin s,
                blkDiagFun r s N hN M₁ i ⟨r + c.1, by omega⟩ *
                  blkDiagFun r s N hN M₂ ⟨r + c.1, by omega⟩ j) = 0 := by
              refine Finset.sum_eq_zero fun c _ => ?_
              have hne : i ≠ ⟨r + c.1, by omega⟩ := by
                intro heq
                have := congrArg Fin.val heq
                dsimp at this
                omega
              simp [blkDiagFun, hi, hne]
            rw [hsum2, add_zero]
            have hterm1 : ∀ a : Fin r,
                blkDiagFun r s N hN M₁ i ⟨a.1, by omega⟩ *
                  blkDiagFun r s N hN M₂ ⟨a.1, by omega⟩ j =
                if a = ⟨i.1, hi⟩ then (if i = j then 1 else 0) else 0 := by
              intro a
              have ha_lt : (⟨a.1, by omega⟩ : Fin N).1 < r := a.isLt
              simp only [blkDiagFun, Matrix.of_apply, hi, ha_lt, ↓reduceDIte]
              by_cases hai : a = ⟨i.1, hi⟩
              · subst hai
                have hi_eq : (⟨i.1, by omega⟩ : Fin N) = i := Fin.ext rfl
                simp [hi_eq]
              · have hne : i ≠ ⟨a.1, by omega⟩ := by
                  intro heq
                  apply hai
                  ext
                  exact (congrArg Fin.val heq).symm
                simp [hai, hne]
            simp_rw [hterm1]
            simp [blkDiagFun, hi]
          · have hsum1 : (∑ a : Fin r,
                blkDiagFun r s N hN M₁ i ⟨a.1, by omega⟩ *
                  blkDiagFun r s N hN M₂ ⟨a.1, by omega⟩ j) = 0 := by
              refine Finset.sum_eq_zero fun a _ => ?_
              have ha_lt : (⟨a.1, by omega⟩ : Fin N).1 < r := a.isLt
              simp [blkDiagFun, hi, ha_lt]
            rw [hsum1, zero_add]
            by_cases hj : j.1 < r
            · have hsum2 : (∑ c : Fin s,
                  blkDiagFun r s N hN M₁ i ⟨r + c.1, by omega⟩ *
                    blkDiagFun r s N hN M₂ ⟨r + c.1, by omega⟩ j) = 0 := by
                refine Finset.sum_eq_zero fun c _ => ?_
                have hrc : ¬ ((⟨r + c.1, by omega⟩ : Fin N).1 < r) := by dsimp; omega
                simp [blkDiagFun, hi, hrc, hj]
              rw [hsum2]
              simp [blkDiagFun, hi, hj]
            · simp only [blkDiagFun, Matrix.of_apply, hi, hj, ↓reduceDIte, Matrix.mul_apply]
              refine Finset.sum_congr rfl fun c _ => ?_
              have hrc : ¬ (r + c.1 < r) := by omega
              simp only [hrc, ↓reduceDIte]
              have hc_eq : (⟨r + c.1 - r, by omega⟩ : Fin s) = c := by
                ext; dsimp; omega
              rw [hc_eq] }

  have hBlkDiagFix : ∀ (r s N : ℕ) (hN : r + s = N)
      (M : Matrix (Fin s) (Fin s) (ZMod (ℓ ^ K))) (i j : Fin N),
      (i.1 < r ∨ j.1 < r) → blkDiagHom r s N hN M i j = if i = j then 1 else 0 := by
    intro r s N hN M i j hij
    change (if hi : i.1 < r then if i = j then (1 : ZMod (ℓ ^ K)) else 0
      else if hj : j.1 < r then 0
      else M ⟨i.1 - r, by omega⟩ ⟨j.1 - r, by omega⟩) = if i = j then 1 else 0
    by_cases hi : i.1 < r
    · simp [hi]
    · rcases hij with h1 | hj
      · exact absurd h1 hi
      · have hne : i ≠ j := fun h => hi (h ▸ hj)
        simp [hi, hj, hne]

  have hBlkDiagShift : ∀ (r s N : ℕ) (hN : r + s = N)
      (M : Matrix (Fin s) (Fin s) (ZMod (ℓ ^ K))) (a c : Fin s),
      blkDiagHom r s N hN M ⟨r + a.1, by omega⟩ ⟨r + c.1, by omega⟩ = M a c := by
    intro r s N hN M a c
    change (if hi : r + a.1 < r then
        if (⟨r + a.1, by omega⟩ : Fin N) = ⟨r + c.1, by omega⟩ then (1 : ZMod (ℓ ^ K)) else 0
      else if hj : r + c.1 < r then 0
      else M ⟨r + a.1 - r, by omega⟩ ⟨r + c.1 - r, by omega⟩) = M a c
    have ha : ¬ (r + a.1 < r) := by omega
    have hc : ¬ (r + c.1 < r) := by omega
    simp only [ha, hc, ↓reduceDIte]
    congr 1 <;> (ext; dsimp; omega)

  let swapUnit : ∀ (N : ℕ) (a c : Fin N), (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ K)))ˣ :=
    fun N a c =>
      let σ := Equiv.swap a c
      let S : Matrix (Fin N) (Fin N) (ZMod (ℓ ^ K)) :=
        Matrix.of fun i j => if σ i = j then 1 else 0
      have hsq : S * S = 1 := by
        ext i j
        simp only [S, Matrix.mul_apply, Matrix.of_apply]
        have hterm : ∀ k : Fin N,
            (if σ i = k then (1 : ZMod (ℓ ^ K)) else 0) * (if σ k = j then 1 else 0) =
            if k = σ i then (if σ (σ i) = j then 1 else 0) else 0 := by
          intro k
          by_cases hk : k = σ i
          · subst hk; simp
          · have hne : σ i ≠ k := Ne.symm hk
            simp [hk, hne]
        simp_rw [hterm]
        simp only [Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
        dsimp [σ]
        rw [Equiv.swap_apply_self, Matrix.one_apply]
      ⟨S, S, hsq, hsq⟩

  let rowElim : ∀ {m' : ℕ}, (Fin m' → ZMod (ℓ ^ K)) →
      Matrix (Fin (m' + 1)) (Fin (m' + 1)) (ZMod (ℓ ^ K)) :=
    fun c => Matrix.of (Fin.cases
      (fun j => if j = 0 then 1 else 0)
      (fun i => Fin.cases (c i) (fun j => if i = j then 1 else 0)))

  have hRowElimMul : ∀ {m' L : ℕ} (c : Fin m' → ZMod (ℓ ^ K))
      (M : Matrix (Fin (m' + 1)) (Fin L) (ZMod (ℓ ^ K))),
      (∀ k : Fin L, (rowElim c * M) 0 k = M 0 k) ∧
      (∀ (i : Fin m') (k : Fin L), (rowElim c * M) i.succ k = c i * M 0 k + M i.succ k) := by
    intro m' L c M
    refine ⟨fun k => ?_, fun i k => ?_⟩
    · simp only [rowElim, Matrix.mul_apply, Matrix.of_apply, Fin.cases_zero]
      rw [Fin.sum_univ_succ]
      simp
    · simp only [rowElim, Matrix.mul_apply, Matrix.of_apply, Fin.cases_succ]
      rw [Fin.sum_univ_succ]
      simp

  have hRowElimAdd : ∀ {m' : ℕ} (c₁ c₂ : Fin m' → ZMod (ℓ ^ K)),
      rowElim c₁ * rowElim c₂ = rowElim (c₁ + c₂) := by
    intro m' c₁ c₂
    obtain ⟨h0, hs⟩ := hRowElimMul c₁ (rowElim c₂)
    ext i j
    refine Fin.cases ?_ ?_ i
    · rw [h0 j]
      simp [rowElim]
    · intro i'
      rw [hs i' j]
      refine Fin.cases ?_ ?_ j
      · simp [rowElim, Pi.add_apply]
      · intro j'
        simp [rowElim]

  have hRowElimZero : ∀ {m' : ℕ}, rowElim (0 : Fin m' → ZMod (ℓ ^ K)) = 1 := by
    intro m'
    ext i j
    refine Fin.cases ?_ ?_ i
    · refine Fin.cases ?_ ?_ j
      · simp [rowElim]
      · intro j'; simp [rowElim, (Fin.succ_ne_zero j').symm]
    · intro i'
      refine Fin.cases ?_ ?_ j
      · simp [rowElim]
      · intro j'
        simp [rowElim, Matrix.one_apply, Fin.succ_inj]

  have hSNF : ∀ (m n : ℕ) (D : Matrix (Fin m) (Fin n) (ZMod (ℓ ^ K))),
      ∃ (P : (Matrix (Fin m) (Fin m) (ZMod (ℓ ^ K)))ˣ)
        (Q : (Matrix (Fin n) (Fin n) (ZMod (ℓ ^ K)))ˣ)
        (e : ℕ → ℕ),
        Monotone e ∧
        (∀ k : ℕ, e k ≤ K) ∧
        (∀ k : ℕ, min m n ≤ k → e k = K) ∧
        ∀ (i : Fin m) (j : Fin n),
          (P.val * D * Q.val) i j =
            if i.1 = j.1 then ((ℓ ^ e i.1 : ℕ) : ZMod (ℓ ^ K)) else 0 := by
    intro m
    induction m with
    | zero =>
      intro n D
      refine ⟨1, 1, fun _ => K, monotone_const, fun _ => le_rfl, fun _ _ => rfl, ?_⟩
      intro i
      exact Fin.elim0 i
    | succ m' ih =>
      intro n D
      rcases n with _ | n'
      · refine ⟨1, 1, fun _ => K, monotone_const, fun _ => le_rfl, fun _ _ => rfl, ?_⟩
        intro _ j
        exact Fin.elim0 j
      · by_cases hAllZero : ∀ (i : Fin (m' + 1)) (j : Fin (n' + 1)), D i j = 0
        · refine ⟨1, 1, fun _ => K, monotone_const, fun _ => le_rfl, fun _ _ => rfl, ?_⟩
          intro i j
          have hD0 : D = 0 := Matrix.ext hAllZero
          simp only [Units.val_one, hD0, Matrix.mul_zero, Matrix.zero_mul, Matrix.zero_apply,
            ZMod.natCast_self, ite_self]
        · have hExNe : ∃ (i₁ : Fin (m' + 1)) (j₁ : Fin (n' + 1)), D i₁ j₁ ≠ 0 := by
            by_contra hno
            exact hAllZero fun i j => Classical.not_not.mp fun hij => hno ⟨i, j, hij⟩
          rcases hExNe with ⟨i₁, j₁, hne₁⟩
          obtain ⟨p₀, -, hp₀_min⟩ := Finset.exists_min_image
            (Finset.univ : Finset (Fin (m' + 1) × Fin (n' + 1)))
            (fun p => ν (D p.1 p.2)) Finset.univ_nonempty
          let i₀ := p₀.1
          let j₀ := p₀.2
          let v₀ := ν (D i₀ j₀)
          have hv₀_lt : v₀ < K := by
            have hle : v₀ ≤ ν (D i₁ j₁) := hp₀_min (i₁, j₁) (Finset.mem_univ _)
            have hneK : ν (D i₁ j₁) ≠ K := fun hK => hne₁ ((hν_spec (D i₁ j₁)).2.2.mpr hK)
            have hleK : ν (D i₁ j₁) ≤ K := (hν_spec (D i₁ j₁)).1
            omega
          let P_sw := swapUnit (m' + 1) 0 i₀
          let Q_sw := swapUnit (n' + 1) 0 j₀
          let D₁ := P_sw.val * D * Q_sw.val
          have hD₁_apply : ∀ i j, D₁ i j = D (Equiv.swap 0 i₀ i) (Equiv.swap 0 j₀ j) := by
            intro i j
            simp only [D₁, P_sw, Q_sw, swapUnit, Matrix.mul_apply, Matrix.of_apply]
            have hL : ∀ k, (∑ p, (if Equiv.swap 0 i₀ i = p then (1 : ZMod (ℓ ^ K)) else 0) * D p k) =
                D (Equiv.swap 0 i₀ i) k := fun k => by simp
            simp_rw [hL]
            have hswap_iff : ∀ k, (Equiv.swap 0 j₀ k = j) ↔ (k = Equiv.swap 0 j₀ j) := fun k =>
              ⟨fun h => by rw [← h, Equiv.swap_apply_self],
               fun h => by rw [h, Equiv.swap_apply_self]⟩
            simp_rw [hswap_iff]
            simp
          have hD₁_00 : D₁ 0 0 = ((ℓ ^ v₀ : ℕ) : ZMod (ℓ ^ K)) * (u_fac (D i₀ j₀)).val := by
            rw [hD₁_apply, Equiv.swap_apply_left, Equiv.swap_apply_left]
            exact (hν_spec (D i₀ j₀)).2.1
          let u₀ := u_fac (D i₀ j₀)
          let scInvFun : Fin (m' + 1) → ZMod (ℓ ^ K) := fun i => if i = 0 then (u₀⁻¹).val else 1
          let scFun : Fin (m' + 1) → ZMod (ℓ ^ K) := fun i => if i = 0 then u₀.val else 1
          let P_sc : (Matrix (Fin (m' + 1)) (Fin (m' + 1)) (ZMod (ℓ ^ K)))ˣ :=
            { val := Matrix.diagonal scInvFun
              inv := Matrix.diagonal scFun
              val_inv := by
                rw [Matrix.diagonal_mul_diagonal]
                have h1 : (fun i : Fin (m' + 1) => scInvFun i * scFun i) = fun _ => 1 := by
                  ext i
                  dsimp [scInvFun, scFun]
                  split_ifs <;> simp
                rw [h1, Matrix.diagonal_one]
              inv_val := by
                rw [Matrix.diagonal_mul_diagonal]
                have h1 : (fun i : Fin (m' + 1) => scFun i * scInvFun i) = fun _ => 1 := by
                  ext i
                  dsimp [scInvFun, scFun]
                  split_ifs <;> simp
                rw [h1, Matrix.diagonal_one] }
          let D₂ := P_sc.val * D₁
          have hD₂_00 : D₂ 0 0 = ((ℓ ^ v₀ : ℕ) : ZMod (ℓ ^ K)) := by
            change (Matrix.diagonal scInvFun * D₁) 0 0 = _
            rw [Matrix.diagonal_mul, hD₁_00]
            dsimp [scInvFun]
            calc (u₀⁻¹).val * (((ℓ ^ v₀ : ℕ) : ZMod (ℓ ^ K)) * u₀.val)
                = ((ℓ ^ v₀ : ℕ) : ZMod (ℓ ^ K)) * ((u₀⁻¹).val * u₀.val) := by ring
              _ = ((ℓ ^ v₀ : ℕ) : ZMod (ℓ ^ K)) := by rw [Units.inv_mul, mul_one]
          have hD₂_div : ∀ i j, ∃ c : ZMod (ℓ ^ K),
              D₂ i j = ((ℓ ^ v₀ : ℕ) : ZMod (ℓ ^ K)) * c := by
            intro i j
            have hv_le : v₀ ≤ ν (D₁ i j) := by
              rw [hD₁_apply]
              exact hp₀_min (Equiv.swap 0 i₀ i, Equiv.swap 0 j₀ j) (Finset.mem_univ _)
            have hfac := (hν_spec (D₁ i j)).2.1
            have hsplit : ν (D₁ i j) = v₀ + (ν (D₁ i j) - v₀) :=
              (Nat.add_sub_cancel' hv_le).symm
            dsimp only [D₂, P_sc]
            rw [Matrix.diagonal_mul, hfac, hsplit, pow_add, Nat.cast_mul]
            exact ⟨scInvFun i *
              (((ℓ ^ (ν (D₁ i j) - v₀) : ℕ) : ZMod (ℓ ^ K)) * (u_fac (D₁ i j)).val), by ring⟩
          let c₂ : Fin (m' + 1) → Fin (n' + 1) → ZMod (ℓ ^ K) :=
            fun i j => (hD₂_div i j).choose
          have hc₂ : ∀ i j, D₂ i j = ((ℓ ^ v₀ : ℕ) : ZMod (ℓ ^ K)) * c₂ i j :=
            fun i j => (hD₂_div i j).choose_spec
          let c_col : Fin m' → ZMod (ℓ ^ K) := fun i => c₂ i.succ 0
          let P_el : (Matrix (Fin (m' + 1)) (Fin (m' + 1)) (ZMod (ℓ ^ K)))ˣ :=
            { val := rowElim (-c_col)
              inv := rowElim c_col
              val_inv := by rw [hRowElimAdd, neg_add_cancel, hRowElimZero]
              inv_val := by rw [hRowElimAdd, add_neg_cancel, hRowElimZero] }
          let D₃ := P_el.val * D₂
          have hD₃_row0 : ∀ j, D₃ 0 j = D₂ 0 j := (hRowElimMul (-c_col) D₂).1
          have hD₃_col0 : ∀ i : Fin m', D₃ i.succ 0 = 0 := by
            intro i
            change (rowElim (-c_col) * D₂) i.succ 0 = 0
            rw [(hRowElimMul (-c_col) D₂).2 i 0, hD₂_00, hc₂ i.succ 0]
            simp [c_col]
            ring
          have hD₃_sub_div : ∀ (i : Fin m') (j : Fin n'),
              ∃ c : ZMod (ℓ ^ K), D₃ i.succ j.succ = ((ℓ ^ v₀ : ℕ) : ZMod (ℓ ^ K)) * c := by
            intro i j
            change ∃ c, (rowElim (-c_col) * D₂) i.succ j.succ = _
            rw [(hRowElimMul (-c_col) D₂).2 i j.succ, hc₂ 0 j.succ, hc₂ i.succ j.succ]
            exact ⟨c₂ i.succ j.succ - c_col i * c₂ 0 j.succ, by simp [c_col]; ring⟩
          let c_row : Fin n' → ZMod (ℓ ^ K) := fun j => c₂ 0 j.succ
          let Q_el : (Matrix (Fin (n' + 1)) (Fin (n' + 1)) (ZMod (ℓ ^ K)))ˣ :=
            { val := (rowElim (-c_row)).transpose
              inv := (rowElim c_row).transpose
              val_inv := by
                rw [← Matrix.transpose_mul, hRowElimAdd, add_neg_cancel, hRowElimZero,
                  Matrix.transpose_one]
              inv_val := by
                rw [← Matrix.transpose_mul, hRowElimAdd, neg_add_cancel, hRowElimZero,
                  Matrix.transpose_one] }
          let D₄ := D₃ * Q_el.val
          have hColElim : ∀ (r : Fin (m' + 1)),
              D₄ r 0 = D₃ r 0 ∧
              ∀ j : Fin n', D₄ r j.succ = (-c_row j) * D₃ r 0 + D₃ r j.succ := by
            intro r
            have htr : D₄ = (rowElim (-c_row) * D₃.transpose).transpose := by
              dsimp [D₄, Q_el]
              rw [Matrix.transpose_mul, Matrix.transpose_transpose]
            obtain ⟨ht0, hts⟩ := hRowElimMul (-c_row) D₃.transpose
            refine ⟨?_, fun j => ?_⟩
            · rw [htr]; exact ht0 r
            · rw [htr]; exact hts j r
          have hD₄_00 : D₄ 0 0 = ((ℓ ^ v₀ : ℕ) : ZMod (ℓ ^ K)) := by
            rw [(hColElim 0).1, hD₃_row0 0, hD₂_00]
          have hD₄_row0 : ∀ j : Fin n', D₄ 0 j.succ = 0 := by
            intro j
            rw [(hColElim 0).2 j, hD₃_row0 0, hD₃_row0 j.succ, hD₂_00, hc₂ 0 j.succ]
            dsimp [c_row]
            ring
          have hD₄_col0 : ∀ i : Fin m', D₄ i.succ 0 = 0 := by
            intro i
            rw [(hColElim i.succ).1, hD₃_col0 i]
          let D_sub : Matrix (Fin m') (Fin n') (ZMod (ℓ ^ K)) :=
            Matrix.of fun i j => D₄ i.succ j.succ
          have hD_sub_div : ∀ (i : Fin m') (j : Fin n'),
              ∃ c : ZMod (ℓ ^ K), D_sub i j = ((ℓ ^ v₀ : ℕ) : ZMod (ℓ ^ K)) * c := by
            intro i j
            change ∃ c, D₄ i.succ j.succ = _
            rw [(hColElim i.succ).2 j, hD₃_col0 i, mul_zero, zero_add]
            exact hD₃_sub_div i j
          obtain ⟨P', Q', e', he'_mono, he'_le, he'_min, hD_sub_snf⟩ := ih n' D_sub
          have hv₀_le_e'0 : v₀ ≤ e' 0 := by
            by_cases hmn : m' = 0 ∨ n' = 0
            · have hmin0 : min m' n' ≤ 0 := by rcases hmn with rfl | rfl <;> simp
              rw [he'_min 0 hmin0]
              exact hv₀_lt.le
            · have hm_pos : 0 < m' := by omega
              have hn_pos : 0 < n' := by omega
              let zr : Fin m' := ⟨0, hm_pos⟩
              let zc : Fin n' := ⟨0, hn_pos⟩
              have h00 := hD_sub_snf zr zc
              simp only [zr, zc, ↓reduceIte] at h00
              have hmul_div : ∃ w : ZMod (ℓ ^ K),
                  (P'.val * D_sub * Q'.val) zr zc = ((ℓ ^ v₀ : ℕ) : ZMod (ℓ ^ K)) * w := by
                simp only [Matrix.mul_apply]
                choose f_sub hf_sub using hD_sub_div
                refine ⟨∑ b_idx : Fin n', (∑ a_idx : Fin m',
                  P'.val zr a_idx * f_sub a_idx b_idx) * Q'.val b_idx zc, ?_⟩
                rw [Finset.mul_sum]
                refine Finset.sum_congr rfl fun b_idx _ => ?_
                rw [← mul_assoc, Finset.mul_sum]
                congr 1
                refine Finset.sum_congr rfl fun a_idx _ => ?_
                rw [hf_sub a_idx b_idx]
                ring
              rcases hmul_div with ⟨w, hw⟩
              rw [h00] at hw
              by_contra hgt
              have hlt : e' 0 < v₀ := Nat.lt_of_not_ge hgt
              have hv_split : v₀ = (e' 0 + 1) + (v₀ - (e' 0 + 1)) := by omega
              rw [hv_split, pow_add, Nat.cast_mul, mul_assoc] at hw
              exact hPowEqHigherMulFalse (e' 0) (by omega) _ hw
          let P_blk := Units.map (blkDiagHom 1 m' (m' + 1) (Nat.add_comm 1 m')) P'
          let Q_blk := Units.map (blkDiagHom 1 n' (n' + 1) (Nat.add_comm 1 n')) Q'
          have hBlkEq : ∀ (i : Fin (m' + 1)) (j : Fin (n' + 1)),
              (P_blk.val * D₄ * Q_blk.val) i j =
                if i.1 = j.1 then
                  ((ℓ ^ (Nat.casesOn i.1 v₀ e') : ℕ) : ZMod (ℓ ^ K))
                else 0 := by
            have hL_0 : ∀ l : Fin (n' + 1), (P_blk.val * D₄) 0 l = D₄ 0 l := by
              intro l
              rw [Matrix.mul_apply, Fin.sum_univ_succ]
              have h00 : P_blk.val 0 0 = 1 :=
                hBlkDiagFix 1 m' (m' + 1) (Nat.add_comm 1 m') P'.val 0 0 (Or.inl Nat.zero_lt_one)
              have h0s : ∀ a : Fin m', P_blk.val 0 a.succ = 0 := by
                intro a
                change blkDiagHom 1 m' (m' + 1) (Nat.add_comm 1 m') P'.val 0 a.succ = 0
                rw [hBlkDiagFix 1 m' (m' + 1) (Nat.add_comm 1 m') P'.val 0 a.succ (Or.inl Nat.zero_lt_one)]
                simp [(Fin.succ_ne_zero a).symm]
              simp [h00, h0s]
            have hL_s0 : ∀ i : Fin m', (P_blk.val * D₄) i.succ 0 = 0 := by
              intro i
              rw [Matrix.mul_apply, Fin.sum_univ_succ]
              have hs0 : P_blk.val i.succ 0 = 0 := by
                change blkDiagHom 1 m' (m' + 1) (Nat.add_comm 1 m') P'.val i.succ 0 = 0
                rw [hBlkDiagFix 1 m' (m' + 1) (Nat.add_comm 1 m') P'.val i.succ 0 (Or.inr Nat.zero_lt_one)]
                simp [Fin.succ_ne_zero i]
              simp [hs0, hD₄_col0]
            have hL_ss : ∀ (i : Fin m') (b_idx : Fin n'),
                (P_blk.val * D₄) i.succ b_idx.succ = (P'.val * D_sub) i b_idx := by
              intro i b_idx
              rw [Matrix.mul_apply, Fin.sum_univ_succ]
              have hs0 : P_blk.val i.succ 0 = 0 := by
                change blkDiagHom 1 m' (m' + 1) (Nat.add_comm 1 m') P'.val i.succ 0 = 0
                rw [hBlkDiagFix 1 m' (m' + 1) (Nat.add_comm 1 m') P'.val i.succ 0 (Or.inr Nat.zero_lt_one)]
                simp [Fin.succ_ne_zero i]
              rw [hs0, zero_mul, zero_add, Matrix.mul_apply]
              refine Finset.sum_congr rfl fun a _ => ?_
              have hss : P_blk.val i.succ a.succ = P'.val i a := by
                have h := hBlkDiagShift 1 m' (m' + 1) (Nat.add_comm 1 m') P'.val i a
                have hi_eq : (⟨1 + i.1, by omega⟩ : Fin (m' + 1)) = i.succ :=
                  Fin.ext (Nat.add_comm 1 i.1)
                have ha_eq : (⟨1 + a.1, by omega⟩ : Fin (m' + 1)) = a.succ :=
                  Fin.ext (Nat.add_comm 1 a.1)
                rwa [hi_eq, ha_eq] at h
              rw [hss]; rfl
            intro i j
            refine Fin.cases ?_ ?_ i
            · refine Fin.cases ?_ ?_ j
              · rw [Matrix.mul_apply, Fin.sum_univ_succ, hL_0 0, hD₄_00]
                have hq00 : Q_blk.val 0 0 = 1 :=
                  hBlkDiagFix 1 n' (n' + 1) (Nat.add_comm 1 n') Q'.val 0 0 (Or.inl Nat.zero_lt_one)
                have hsum0 : ∑ b_idx : Fin n', (P_blk.val * D₄) 0 b_idx.succ * Q_blk.val b_idx.succ 0 = 0 := by
                  refine Finset.sum_eq_zero fun b_idx _ => ?_
                  rw [hL_0 b_idx.succ, hD₄_row0 b_idx, zero_mul]
                rw [hq00, mul_one, hsum0, add_zero]
                simp
              · intro j'
                rw [Matrix.mul_apply, Fin.sum_univ_succ, hL_0 0]
                have hq0s : Q_blk.val 0 j'.succ = 0 := by
                  change blkDiagHom 1 n' (n' + 1) (Nat.add_comm 1 n') Q'.val 0 j'.succ = 0
                  rw [hBlkDiagFix 1 n' (n' + 1) (Nat.add_comm 1 n') Q'.val 0 j'.succ (Or.inl Nat.zero_lt_one)]
                  simp [(Fin.succ_ne_zero j').symm]
                have hsum0 : ∑ b_idx : Fin n', (P_blk.val * D₄) 0 b_idx.succ * Q_blk.val b_idx.succ j'.succ = 0 := by
                  refine Finset.sum_eq_zero fun b_idx _ => ?_
                  rw [hL_0 b_idx.succ, hD₄_row0 b_idx, zero_mul]
                rw [hq0s, mul_zero, hsum0, add_zero]
                simp
            · intro i'
              refine Fin.cases ?_ ?_ j
              · rw [Matrix.mul_apply, Fin.sum_univ_succ, hL_s0 i', zero_mul, zero_add]
                have hsum0 : ∑ b_idx : Fin n', (P_blk.val * D₄) i'.succ b_idx.succ * Q_blk.val b_idx.succ 0 = 0 := by
                  refine Finset.sum_eq_zero fun b_idx _ => ?_
                  have hqs0 : Q_blk.val b_idx.succ 0 = 0 := by
                    change blkDiagHom 1 n' (n' + 1) (Nat.add_comm 1 n') Q'.val b_idx.succ 0 = 0
                    rw [hBlkDiagFix 1 n' (n' + 1) (Nat.add_comm 1 n') Q'.val b_idx.succ 0 (Or.inr Nat.zero_lt_one)]
                    simp [Fin.succ_ne_zero b_idx]
                  rw [hqs0, mul_zero]
                rw [hsum0]
                simp
              · intro j'
                rw [Matrix.mul_apply, Fin.sum_univ_succ, hL_s0 i', zero_mul, zero_add]
                have hsum_eq : (∑ b_idx : Fin n',
                    (P_blk.val * D₄) i'.succ b_idx.succ * Q_blk.val b_idx.succ j'.succ) =
                    (P'.val * D_sub * Q'.val) i' j' := by
                  rw [Matrix.mul_apply]
                  refine Finset.sum_congr rfl fun b_idx _ => ?_
                  rw [hL_ss i' b_idx]
                  have hqss : Q_blk.val b_idx.succ j'.succ = Q'.val b_idx j' := by
                    have h := hBlkDiagShift 1 n' (n' + 1) (Nat.add_comm 1 n') Q'.val b_idx j'
                    have hb_eq : (⟨1 + b_idx.1, by omega⟩ : Fin (n' + 1)) = b_idx.succ :=
                      Fin.ext (Nat.add_comm 1 b_idx.1)
                    have hj_eq : (⟨1 + j'.1, by omega⟩ : Fin (n' + 1)) = j'.succ :=
                      Fin.ext (Nat.add_comm 1 j'.1)
                    rwa [hb_eq, hj_eq] at h
                  rw [hqss]
                rw [hsum_eq, hD_sub_snf i' j']
                simp [Fin.val_succ]
          let e : ℕ → ℕ := fun k => Nat.casesOn k v₀ e'
          refine ⟨P_blk * P_el * P_sc * P_sw, Q_sw * Q_el * Q_blk, e, ?_, ?_, ?_, ?_⟩
          · refine monotone_nat_of_le_succ fun k => ?_
            cases k with
            | zero => exact hv₀_le_e'0
            | succ k' => exact he'_mono (Nat.le_succ k')
          · intro k
            cases k with
            | zero => exact hv₀_lt.le
            | succ k' => exact he'_le k'
          · intro k hk
            cases k with
            | zero =>
              exfalso
              have : 1 ≤ min (m' + 1) (n' + 1) := by omega
              omega
            | succ k' =>
              exact he'_min k' (by omega)
          · intro i j
            have hmul_assoc :
                ((P_blk * P_el * P_sc * P_sw).val * D * (Q_sw * Q_el * Q_blk).val) =
                P_blk.val * D₄ * Q_blk.val := by
              simp only [Units.val_mul, D₄, D₃, D₂, D₁, Matrix.mul_assoc]
            rw [hmul_assoc]
            exact hBlkEq i j

  
  let conjComplex : ∀ (C₀ : WeilCurveTrFreeComplex (ℓ ^ K))
      (U₀ : (Matrix (Fin C₀.n₀) (Fin C₀.n₀) (ZMod (ℓ ^ K)))ˣ)
      (U₁ : (Matrix (Fin C₀.n₁) (Fin C₀.n₁) (ZMod (ℓ ^ K)))ˣ)
      (U₂ : (Matrix (Fin C₀.n₂) (Fin C₀.n₂) (ZMod (ℓ ^ K)))ˣ),
      WeilCurveTrFreeComplex (ℓ ^ K) :=
    fun C₀ U₀ U₁ U₂ =>
      { n₀ := C₀.n₀
        n₁ := C₀.n₁
        n₂ := C₀.n₂
        D₀ := U₁.val * C₀.D₀ * U₀⁻¹.val
        D₁ := U₂.val * C₀.D₁ * U₁⁻¹.val
        hD := by
          calc (U₂.val * C₀.D₁ * U₁⁻¹.val) * (U₁.val * C₀.D₀ * U₀⁻¹.val)
              = U₂.val * (C₀.D₁ * (U₁⁻¹.val * U₁.val) * C₀.D₀) * U₀⁻¹.val := by
                  simp only [Matrix.mul_assoc]
            _ = 0 := by
                  rw [Units.inv_mul, Matrix.mul_one, C₀.hD, Matrix.mul_zero, Matrix.zero_mul]
        Φ₀ := U₀.val * C₀.Φ₀ * U₀⁻¹.val
        Φ₁ := U₁.val * C₀.Φ₁ * U₁⁻¹.val
        Φ₂ := U₂.val * C₀.Φ₂ * U₂⁻¹.val
        hΦ₀ := by
          calc (U₁.val * C₀.D₀ * U₀⁻¹.val) * (U₀.val * C₀.Φ₀ * U₀⁻¹.val)
              = U₁.val * (C₀.D₀ * (U₀⁻¹.val * U₀.val) * C₀.Φ₀) * U₀⁻¹.val := by
                  simp only [Matrix.mul_assoc]
            _ = U₁.val * (C₀.D₀ * C₀.Φ₀) * U₀⁻¹.val := by rw [Units.inv_mul, Matrix.mul_one]
            _ = U₁.val * (C₀.Φ₁ * C₀.D₀) * U₀⁻¹.val := by rw [C₀.hΦ₀]
            _ = U₁.val * (C₀.Φ₁ * (U₁⁻¹.val * U₁.val) * C₀.D₀) * U₀⁻¹.val := by
                  rw [Units.inv_mul, Matrix.mul_one]
            _ = (U₁.val * C₀.Φ₁ * U₁⁻¹.val) * (U₁.val * C₀.D₀ * U₀⁻¹.val) := by
                  simp only [Matrix.mul_assoc]
        hΦ₁ := by
          calc (U₂.val * C₀.D₁ * U₁⁻¹.val) * (U₁.val * C₀.Φ₁ * U₁⁻¹.val)
              = U₂.val * (C₀.D₁ * (U₁⁻¹.val * U₁.val) * C₀.Φ₁) * U₁⁻¹.val := by
                  simp only [Matrix.mul_assoc]
            _ = U₂.val * (C₀.D₁ * C₀.Φ₁) * U₁⁻¹.val := by rw [Units.inv_mul, Matrix.mul_one]
            _ = U₂.val * (C₀.Φ₂ * C₀.D₁) * U₁⁻¹.val := by rw [C₀.hΦ₁]
            _ = U₂.val * (C₀.Φ₂ * (U₂⁻¹.val * U₂.val) * C₀.D₁) * U₁⁻¹.val := by
                  rw [Units.inv_mul, Matrix.mul_one]
            _ = (U₂.val * C₀.Φ₂ * U₂⁻¹.val) * (U₂.val * C₀.D₁ * U₁⁻¹.val) := by
                  simp only [Matrix.mul_assoc] }

  have hMulVecUnit : ∀ {N : ℕ} (U : (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ K)))ˣ)
      (v : Fin N → ZMod (ℓ ^ K)),
      U⁻¹.val.mulVecLin (U.val.mulVecLin v) = v ∧
      U.val.mulVecLin (U⁻¹.val.mulVecLin v) = v := by
    intro N U v
    refine ⟨?_, ?_⟩
    · rw [← LinearMap.comp_apply, ← Matrix.mulVecLin_mul, Units.inv_mul, Matrix.mulVecLin_one,
        LinearMap.id_apply]
    · rw [← LinearMap.comp_apply, ← Matrix.mulVecLin_mul, Units.mul_inv, Matrix.mulVecLin_one,
        LinearMap.id_apply]

  have hBasisChange : ∀ (C₀ : WeilCurveTrFreeComplex (ℓ ^ K))
      (hM₀ : WeilCurveTrHasBoundedLatticeModel ℓ K B C₀ b M_lat)
      (U₀ : (Matrix (Fin C₀.n₀) (Fin C₀.n₀) (ZMod (ℓ ^ K)))ˣ)
      (U₁ : (Matrix (Fin C₀.n₁) (Fin C₀.n₁) (ZMod (ℓ ^ K)))ˣ)
      (U₂ : (Matrix (Fin C₀.n₂) (Fin C₀.n₂) (ZMod (ℓ ^ K)))ˣ),
      let C' := conjComplex C₀ U₀ U₁ U₂
      weilCurveTrAltTrace C' = weilCurveTrAltTrace C₀ ∧
      WeilCurveTrHasBoundedLatticeModel ℓ K B C' b M_lat := by
    intro C₀ hM₀ U₀ U₁ U₂ C'
    have htr_conj : ∀ {N : ℕ} (U : (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ K)))ˣ)
        (M : Matrix (Fin N) (Fin N) (ZMod (ℓ ^ K))),
        (U.val * M * U⁻¹.val).trace = M.trace := by
      intro N U M
      rw [Matrix.trace_mul_comm, ← mul_assoc, Units.inv_mul, one_mul]
    refine ⟨?_, ?_⟩
    · simp only [weilCurveTrAltTrace, C', conjComplex, htr_conj]
    · rcases hM₀ with ⟨⟨q₀, hq₀_ker, hq₀_int, hq₀_inj, hq₀_surj⟩,
        ⟨q₁, hq₁_ker, hq₁_int, hq₁_inj, hq₁_surj⟩,
        ⟨q₂, hq₂_int, hq₂_inj, hq₂_surj⟩⟩
      let u₀ := U₀.val.mulVecLin
      let u₀_inv := U₀⁻¹.val.mulVecLin
      let u₁ := U₁.val.mulVecLin
      let u₁_inv := U₁⁻¹.val.mulVecLin
      let u₂ := U₂.val.mulVecLin
      let u₂_inv := U₂⁻¹.val.mulVecLin
      have hu₀ : ∀ v, u₀_inv (u₀ v) = v ∧ u₀ (u₀_inv v) = v := hMulVecUnit U₀
      have hu₁ : ∀ v, u₁_inv (u₁ v) = v ∧ u₁ (u₁_inv v) = v := hMulVecUnit U₁
      have hu₂ : ∀ v, u₂_inv (u₂ v) = v ∧ u₂ (u₂_inv v) = v := hMulVecUnit U₂
      have hRange₀ : ∀ w : Fin C₀.n₁ → ZMod (ℓ ^ K),
          w ∈ LinearMap.range C'.D₀.mulVecLin ↔
          u₁_inv w ∈ LinearMap.range C₀.D₀.mulVecLin := by
        intro w
        constructor
        · rintro ⟨z, hz⟩
          refine ⟨u₀_inv z, ?_⟩
          have hd : C'.D₀.mulVecLin z = u₁ (C₀.D₀.mulVecLin (u₀_inv z)) := by
            simp only [C', conjComplex, Matrix.mulVecLin_mul, LinearMap.comp_apply, u₁, u₀_inv]
          rw [← hz, hd, (hu₁ _).1]
        · rintro ⟨z, hz⟩
          refine ⟨u₀ z, ?_⟩
          simp only [C', conjComplex, Matrix.mulVecLin_mul, LinearMap.comp_apply]
          change u₁ (C₀.D₀.mulVecLin (u₀_inv (u₀ z))) = w
          rw [(hu₀ z).1, hz, (hu₁ w).2]
      have hRange₁ : ∀ w : Fin C₀.n₂ → ZMod (ℓ ^ K),
          w ∈ LinearMap.range C'.D₁.mulVecLin ↔
          u₂_inv w ∈ LinearMap.range C₀.D₁.mulVecLin := by
        intro w
        constructor
        · rintro ⟨z, hz⟩
          refine ⟨u₁_inv z, ?_⟩
          have hd : C'.D₁.mulVecLin z = u₂ (C₀.D₁.mulVecLin (u₁_inv z)) := by
            simp only [C', conjComplex, Matrix.mulVecLin_mul, LinearMap.comp_apply, u₂, u₁_inv]
          rw [← hz, hd, (hu₂ _).1]
        · rintro ⟨z, hz⟩
          refine ⟨u₁ z, ?_⟩
          simp only [C', conjComplex, Matrix.mulVecLin_mul, LinearMap.comp_apply]
          change u₂ (C₀.D₁.mulVecLin (u₁_inv (u₁ z))) = w
          rw [(hu₁ z).1, hz, (hu₂ w).2]
      refine ⟨⟨u₀.comp q₀, ?_, ?_, ?_, ?_⟩, ⟨u₁.comp q₁, ?_, ?_, ?_, ?_⟩, ⟨u₂.comp q₂, ?_, ?_, ?_⟩⟩
      · intro x
        simp only [C', conjComplex, Matrix.mulVecLin_mul, LinearMap.comp_apply]
        change u₁ (C₀.D₀.mulVecLin (u₀_inv (u₀ (q₀ x)))) = 0
        rw [(hu₀ _).1, hq₀_ker x, map_zero]
      · intro x
        simp only [C', conjComplex, Matrix.mulVecLin_mul, LinearMap.comp_apply]
        change u₀ (q₀ _) = u₀ (C₀.Φ₀.mulVecLin (u₀_inv (u₀ (q₀ x))))
        rw [(hu₀ _).1, hq₀_int x]
      · intro x hx
        apply hq₀_inj x
        have h1 := congrArg u₀_inv hx
        simp only [LinearMap.comp_apply, map_zero, (hu₀ (q₀ x)).1] at h1
        exact h1
      · intro y hy
        have hy' : C₀.D₀.mulVecLin (u₀_inv y) = 0 := by
          have h1 : u₁ (C₀.D₀.mulVecLin (u₀_inv y)) = 0 := by
            simpa only [C', conjComplex, Matrix.mulVecLin_mul, LinearMap.comp_apply] using hy
          have h2 := congrArg u₁_inv h1
          simp only [map_zero, (hu₁ _).1] at h2
          exact h2
        obtain ⟨x, hx⟩ := hq₀_surj (u₀_inv y) hy'
        refine ⟨x, ?_⟩
        change u₀ (q₀ x) = (ℓ ^ B : ℕ) • y
        rw [hx, map_nsmul, (hu₀ y).2]
      · intro x
        simp only [C', conjComplex, Matrix.mulVecLin_mul, LinearMap.comp_apply]
        change u₂ (C₀.D₁.mulVecLin (u₁_inv (u₁ (q₁ x)))) = 0
        rw [(hu₁ _).1, hq₁_ker x, map_zero]
      · intro x
        rw [hRange₀]
        simp only [C', conjComplex, Matrix.mulVecLin_mul, LinearMap.comp_apply, map_sub]
        change u₁_inv (u₁ (q₁ _)) - u₁_inv (u₁ (C₀.Φ₁.mulVecLin (u₁_inv (u₁ (q₁ x))))) ∈ _
        rw [(hu₁ _).1, (hu₁ _).1, (hu₁ _).1]
        exact hq₁_int x
      · intro x hx
        rw [hRange₀] at hx
        simp only [LinearMap.comp_apply, (hu₁ (q₁ x)).1] at hx
        exact hq₁_inj x hx
      · intro y hy
        have hy' : C₀.D₁.mulVecLin (u₁_inv y) = 0 := by
          have h1 : u₂ (C₀.D₁.mulVecLin (u₁_inv y)) = 0 := by
            simpa only [C', conjComplex, Matrix.mulVecLin_mul, LinearMap.comp_apply] using hy
          have h2 := congrArg u₂_inv h1
          simp only [map_zero, (hu₂ _).1] at h2
          exact h2
        obtain ⟨x, hx⟩ := hq₁_surj (u₁_inv y) hy'
        refine ⟨x, ?_⟩
        rw [hRange₀, map_sub, map_nsmul, LinearMap.comp_apply, (hu₁ (q₁ x)).1]
        exact hx
      · intro x
        rw [hRange₁]
        simp only [C', conjComplex, Matrix.mulVecLin_mul, LinearMap.comp_apply, map_sub]
        change u₂_inv (u₂ (q₂ _)) - u₂_inv (u₂ (C₀.Φ₂.mulVecLin (u₂_inv (u₂ (q₂ x))))) ∈ _
        rw [(hu₂ _).1, (hu₂ _).1, (hu₂ _).1]
        exact hq₂_int x
      · intro x hx
        rw [hRange₁] at hx
        simp only [LinearMap.comp_apply, (hu₂ (q₂ x)).1] at hx
        exact hq₂_inj x hx
      · intro y
        obtain ⟨x, hx⟩ := hq₂_surj (u₂_inv y)
        refine ⟨x, ?_⟩
        rw [hRange₁, map_sub, map_nsmul, LinearMap.comp_apply, (hu₂ (q₂ x)).1]
        exact hx

  
  have hDiagCommTrace : ∀ (E_int E_diag r : ℕ) (s : ℕ → ℕ),
      (∀ k < r, s k ≤ E_diag) →
      ∀ (X Y : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ K))),
        let Δ := Matrix.diagonal (fun k : Fin r => ((ℓ ^ s k.1 : ℕ) : ZMod (ℓ ^ K)))
        (∀ k : Fin r, ((ℓ ^ E_int : ℕ) : ZMod (ℓ ^ K)) * ((Δ * X) k k - (Y * Δ) k k) = 0) →
        ((ℓ ^ (E_int + E_diag) : ℕ) : ZMod (ℓ ^ K)) * (X.trace - Y.trace) = 0 := by
    intro E_int E_diag r s hs X Y Δ hcomm
    simp only [Matrix.trace, Matrix.diag, ← Finset.sum_sub_distrib, Finset.mul_sum]
    refine Finset.sum_eq_zero fun k _ => ?_
    have hk := hcomm k
    simp only [Δ, Matrix.diagonal_mul, Matrix.mul_diagonal] at hk
    have hk' : ((ℓ ^ (E_int + s k.1) : ℕ) : ZMod (ℓ ^ K)) * (X k k - Y k k) = 0 := by
      rw [pow_add, Nat.cast_mul, mul_assoc]
      calc ((ℓ ^ E_int : ℕ) : ZMod (ℓ ^ K)) * (((ℓ ^ s k.1 : ℕ) : ZMod (ℓ ^ K)) * (X k k - Y k k))
          = ((ℓ ^ E_int : ℕ) : ZMod (ℓ ^ K)) *
              (((ℓ ^ s k.1 : ℕ) : ZMod (ℓ ^ K)) * X k k -
                Y k k * ((ℓ ^ s k.1 : ℕ) : ZMod (ℓ ^ K))) := by ring
        _ = 0 := hk
    exact hPowKillHigher (E_int + s k.1) (E_int + E_diag)
      (Nat.add_le_add_left (hs k.1 k.isLt) E_int) _ hk'

  have hApproxQIsoTrace : ∀ (E_int E_inj E_surj E_cok d_dim b_dim : ℕ),
      E_inj < K → E_surj + E_cok < K →
      ∀ (F_mat : Matrix (Fin d_dim) (Fin b_dim) (ZMod (ℓ ^ K)))
        (A_mat : Matrix (Fin b_dim) (Fin b_dim) (ZMod (ℓ ^ K)))
        (Ψ_mat : Matrix (Fin d_dim) (Fin d_dim) (ZMod (ℓ ^ K))),
        (∀ (t : Fin d_dim) (j : Fin b_dim),
          ((ℓ ^ E_int : ℕ) : ZMod (ℓ ^ K)) * ((F_mat * A_mat) t j - (Ψ_mat * F_mat) t j) = 0) →
        (∀ x : Fin b_dim → ZMod (ℓ ^ K), F_mat.mulVec x = 0 → (ℓ ^ E_inj : ℕ) • x = 0) →
        (∀ y : Fin d_dim → ZMod (ℓ ^ K), ∃ x : Fin b_dim → ZMod (ℓ ^ K),
          ∀ t : Fin d_dim,
            ((ℓ ^ E_cok : ℕ) : ZMod (ℓ ^ K)) *
              (F_mat.mulVec x t - ((ℓ ^ E_surj : ℕ) • y) t) = 0) →
        ((ℓ ^ (E_int + E_surj) : ℕ) : ZMod (ℓ ^ K)) * (A_mat.trace - Ψ_mat.trace) = 0 := by
    intro E_int E_inj E_surj E_cok d_dim b_dim hInj hSurj F_mat A_mat Ψ_mat hInt hKer hCok
    obtain ⟨P, Q, s, _, _, _, hF_snf⟩ := hSNF d_dim b_dim F_mat
    let D_rect : Matrix (Fin d_dim) (Fin b_dim) (ZMod (ℓ ^ K)) := P.val * F_mat * Q.val
    let M' : Matrix (Fin b_dim) (Fin b_dim) (ZMod (ℓ ^ K)) := Q⁻¹.val * A_mat * Q.val
    let Ψ' : Matrix (Fin d_dim) (Fin d_dim) (ZMod (ℓ ^ K)) := P.val * Ψ_mat * P⁻¹.val
    have hD_ker : ∀ x : Fin b_dim → ZMod (ℓ ^ K), D_rect.mulVec x = 0 → (ℓ ^ E_inj : ℕ) • x = 0 := by
      intro x hx
      have hFx : F_mat.mulVec (Q.val.mulVec x) = 0 := by
        have h1 : P.val.mulVecLin (F_mat.mulVecLin (Q.val.mulVecLin x)) = 0 := by
          change D_rect.mulVecLin x = 0 at hx
          simpa only [D_rect, Matrix.mulVecLin_mul, LinearMap.comp_apply] using hx
        have h2 := congrArg P⁻¹.val.mulVecLin h1
        rw [(hMulVecUnit P _).1, map_zero] at h2
        exact h2
      have hQx := hKer (Q.val.mulVec x) hFx
      have h3 := congrArg Q⁻¹.val.mulVecLin hQx
      rw [map_nsmul, map_zero] at h3
      change (ℓ ^ E_inj : ℕ) • Q⁻¹.val.mulVecLin (Q.val.mulVecLin x) = 0 at h3
      rwa [(hMulVecUnit Q x).1] at h3
    have hD_cok : ∀ y : Fin d_dim → ZMod (ℓ ^ K), ∃ x : Fin b_dim → ZMod (ℓ ^ K),
        ∀ t : Fin d_dim,
          ((ℓ ^ E_cok : ℕ) : ZMod (ℓ ^ K)) *
            (D_rect.mulVec x t - ((ℓ ^ E_surj : ℕ) • y) t) = 0 := by
      intro y
      obtain ⟨x', hx'⟩ := hCok (P⁻¹.val.mulVec y)
      refine ⟨Q⁻¹.val.mulVec x', fun t => ?_⟩
      let diff_vec : Fin d_dim → ZMod (ℓ ^ K) := F_mat.mulVec x' - (ℓ ^ E_surj : ℕ) • (P⁻¹.val.mulVec y)
      have hdiff_kill : (ℓ ^ E_cok : ℕ) • diff_vec = 0 := by
        ext i
        simpa only [diff_vec, Pi.sub_apply, Pi.smul_apply, Pi.mul_apply, Pi.natCast_apply,
          nsmul_eq_mul, Pi.zero_apply] using hx' i
      have hP_diff : P.val.mulVecLin diff_vec = D_rect.mulVec (Q⁻¹.val.mulVec x') - (ℓ ^ E_surj : ℕ) • y := by
        simp only [diff_vec, map_sub, map_nsmul, Matrix.mulVecLin_apply]
        have h1 : P.val.mulVec (F_mat.mulVec x') = D_rect.mulVec (Q⁻¹.val.mulVec x') := by
          change P.val.mulVecLin (F_mat.mulVecLin x') = D_rect.mulVecLin (Q⁻¹.val.mulVecLin x')
          simp only [D_rect, Matrix.mulVecLin_mul, LinearMap.comp_apply, (hMulVecUnit Q x').2]
        have h2 : P.val.mulVec (P⁻¹.val.mulVec y) = y := (hMulVecUnit P y).2
        rw [h1, h2]
      have hP_kill : (ℓ ^ E_cok : ℕ) • (P.val.mulVecLin diff_vec) = 0 := by
        rw [← map_nsmul, hdiff_kill, map_zero]
      rw [hP_diff] at hP_kill
      have ht := congrFun hP_kill t
      simpa only [Pi.sub_apply, Pi.smul_apply, Pi.mul_apply, Pi.natCast_apply,
        nsmul_eq_mul, Pi.zero_apply] using ht
    have hD_int : ∀ (t : Fin d_dim) (j : Fin b_dim),
        ((ℓ ^ E_int : ℕ) : ZMod (ℓ ^ K)) * ((D_rect * M') t j - (Ψ' * D_rect) t j) = 0 := by
      have hmat : D_rect * M' - Ψ' * D_rect = P.val * (F_mat * A_mat - Ψ_mat * F_mat) * Q.val := by
        have h1 : D_rect * M' = P.val * (F_mat * A_mat) * Q.val := by
          dsimp [D_rect, M']
          calc (P.val * F_mat * Q.val) * (Q⁻¹.val * A_mat * Q.val)
              = P.val * (F_mat * (Q.val * Q⁻¹.val) * A_mat) * Q.val := by
                  simp only [Matrix.mul_assoc]
            _ = P.val * (F_mat * A_mat) * Q.val := by
                  rw [Units.mul_inv, Matrix.mul_one]
        have h2 : Ψ' * D_rect = P.val * (Ψ_mat * F_mat) * Q.val := by
          dsimp [D_rect, Ψ']
          calc (P.val * Ψ_mat * P⁻¹.val) * (P.val * F_mat * Q.val)
              = P.val * (Ψ_mat * (P⁻¹.val * P.val) * F_mat) * Q.val := by
                  simp only [Matrix.mul_assoc]
            _ = P.val * (Ψ_mat * F_mat) * Q.val := by
                  rw [Units.inv_mul, Matrix.mul_one]
        rw [h1, h2, ← Matrix.sub_mul, ← Matrix.mul_sub]
      intro t j
      change ((ℓ ^ E_int : ℕ) : ZMod (ℓ ^ K)) * (D_rect * M' - Ψ' * D_rect) t j = 0
      rw [hmat]
      simp only [Matrix.mul_apply, Finset.mul_sum]
      refine Finset.sum_eq_zero fun v _ => ?_
      rw [← mul_assoc, Finset.mul_sum]
      have hsum_u : ∑ u : Fin d_dim,
          ((ℓ ^ E_int : ℕ) : ZMod (ℓ ^ K)) *
            (P.val t u * (F_mat * A_mat - Ψ_mat * F_mat) u v) = 0 := by
        refine Finset.sum_eq_zero fun u _ => ?_
        have hu := hInt u v
        calc ((ℓ ^ E_int : ℕ) : ZMod (ℓ ^ K)) * (P.val t u * (F_mat * A_mat - Ψ_mat * F_mat) u v)
            = P.val t u * (((ℓ ^ E_int : ℕ) : ZMod (ℓ ^ K)) *
                ((F_mat * A_mat) u v - (Ψ_mat * F_mat) u v)) := by
                simp only [Matrix.sub_apply]; ring
          _ = 0 := by rw [hu, mul_zero]
      rw [hsum_u, zero_mul]
    have hb_le_d : b_dim ≤ d_dim := by
      by_contra hlt
      let j₀ : Fin b_dim := ⟨b_dim - 1, by omega⟩
      have hmul0 : D_rect.mulVec (Pi.single j₀ 1) = 0 := by
        ext i
        simp only [Matrix.mulVec, dotProduct, D_rect, hF_snf, Pi.zero_apply]
        refine Finset.sum_eq_zero fun j _ => ?_
        by_cases hj : j = j₀
        · subst hj
          have hne : i.1 ≠ j₀.1 := by dsimp [j₀]; omega
          simp [hne]
        · simp [Pi.single_eq_of_ne hj]
      have h0 := congrFun (hD_ker (Pi.single j₀ 1) hmul0) j₀
      simp only [Pi.smul_apply, Pi.single_eq_same, nsmul_eq_mul, mul_one, Pi.zero_apply] at h0
      exact hPowEqHigherMulFalse E_inj hInj 0 (by rw [h0, mul_zero])
    have hd_le_b : d_dim ≤ b_dim := by
      by_contra hlt
      let i₀ : Fin d_dim := ⟨d_dim - 1, by omega⟩
      obtain ⟨x, hx⟩ := hD_cok (Pi.single i₀ 1)
      have hx0 := hx i₀
      have hrow0 : D_rect.mulVec x i₀ = 0 := by
        simp only [Matrix.mulVec, dotProduct, D_rect, hF_snf]
        refine Finset.sum_eq_zero fun j _ => ?_
        have hne : i₀.1 ≠ j.1 := by dsimp [i₀]; omega
        simp [hne]
      rw [hrow0, zero_sub, Pi.smul_apply, Pi.single_eq_same, nsmul_eq_mul, mul_one,
        mul_neg, neg_eq_zero, ← Nat.cast_mul, ← pow_add] at hx0
      exact hPowEqHigherMulFalse (E_cok + E_surj) (by omega) 0 (by rw [hx0, mul_zero])
    have hdb : d_dim = b_dim := le_antisymm hd_le_b hb_le_d
    subst hdb
    have hs_bound : ∀ k < d_dim, s k ≤ E_surj := by
      intro k hk
      let k_fin : Fin d_dim := ⟨k, hk⟩
      obtain ⟨x, hx⟩ := hD_cok (Pi.single k_fin 1)
      have hxk := hx k_fin
      have hrowk : D_rect.mulVec x k_fin = ((ℓ ^ s k : ℕ) : ZMod (ℓ ^ K)) * x k_fin := by
        simp only [Matrix.mulVec, dotProduct, D_rect, hF_snf]
        have hiff : ∀ j : Fin d_dim, (k_fin.1 = j.1) ↔ (j = k_fin) :=
          fun j => ⟨fun h => Fin.ext h.symm, fun h => h ▸ rfl⟩
        simp_rw [hiff]
        simp [k_fin]
      rw [hrowk, Pi.smul_apply, Pi.single_eq_same, nsmul_eq_mul, mul_one,
        mul_sub, ← mul_assoc, ← Nat.cast_mul, ← pow_add,
        ← Nat.cast_mul, ← pow_add, sub_eq_zero] at hxk
      by_contra hgt
      have hsplit : E_cok + s k = (E_cok + E_surj + 1) + (s k - (E_surj + 1)) := by omega
      rw [hsplit, pow_add, Nat.cast_mul, mul_assoc] at hxk
      exact hPowEqHigherMulFalse (E_cok + E_surj) (by omega) _ hxk.symm
    have hD_eq_diag : D_rect = Matrix.diagonal (fun k : Fin d_dim => ((ℓ ^ s k.1 : ℕ) : ZMod (ℓ ^ K))) := by
      ext i j
      dsimp only [D_rect]
      rw [hF_snf i j, Matrix.diagonal_apply]
      by_cases hij : i = j
      · subst hij; simp
      · have hne : i.1 ≠ j.1 := fun h => hij (Fin.ext h)
        simp [hij, hne]
    have htr_M' : M'.trace = A_mat.trace := by
      dsimp [M']
      rw [Matrix.trace_mul_comm, ← mul_assoc, Units.mul_inv, one_mul]
    have htr_Ψ' : Ψ'.trace = Ψ_mat.trace := by
      dsimp [Ψ']
      rw [Matrix.trace_mul_comm, ← mul_assoc, Units.inv_mul, one_mul]
    rw [← htr_M', ← htr_Ψ']
    refine hDiagCommTrace E_int E_surj d_dim s hs_bound M' Ψ' fun k => ?_
    rw [← hD_eq_diag]
    exact hD_int k k

  
  obtain ⟨P₂, Q₁, a, ha_mono, ha_le, ha_min, hD₁_snf⟩ := hSNF C.n₂ C.n₁ C.D₁
  have hEx₁₂ : ∃ k : ℕ, ¬ (a k ≤ B) := ⟨min C.n₂ C.n₁, by rw [ha_min _ le_rfl]; omega⟩
  let r₁₂ : ℕ := Nat.find hEx₁₂
  have hr₁₂_min : r₁₂ ≤ min C.n₂ C.n₁ := Nat.find_min' hEx₁₂ (by rw [ha_min _ le_rfl]; omega)
  have hr₁₂_2 : r₁₂ ≤ C.n₂ := le_trans hr₁₂_min (min_le_left _ _)
  have hr₁₂_1 : r₁₂ ≤ C.n₁ := le_trans hr₁₂_min (min_le_right _ _)
  have ha_small : ∀ k < r₁₂, a k ≤ B := fun k hk => not_not.mp (Nat.find_min hEx₁₂ hk)
  have ha_gt : ∀ k, r₁₂ ≤ k → B < a k := fun k hk =>
    lt_of_lt_of_le (Nat.lt_of_not_ge (Nat.find_spec hEx₁₂)) (ha_mono hk)

  let C₁ := conjComplex C 1 Q₁⁻¹ P₂
  have hC₁_n₀ : C₁.n₀ = C.n₀ := rfl
  have hC₁_n₁ : C₁.n₁ = C.n₁ := rfl
  have hC₁_n₂ : C₁.n₂ = C.n₂ := rfl
  obtain ⟨hTr_C₁, hModel_C₁⟩ := hBasisChange C hModel 1 Q₁⁻¹ P₂
  have hC₁_D₁ : ∀ (i : Fin C.n₂) (j : Fin C.n₁),
      C₁.D₁ i j = if i.1 = j.1 then ((ℓ ^ a i.1 : ℕ) : ZMod (ℓ ^ K)) else 0 := by
    intro i j
    change (P₂.val * C.D₁ * (Q₁⁻¹)⁻¹.val) i j = _
    rw [inv_inv]
    exact hD₁_snf i j

  let m₁ : ℕ := C.n₁ - r₁₂
  have hm₁_add : r₁₂ + m₁ = C.n₁ := by omega
  let D₀_L : Matrix (Fin m₁) (Fin C.n₀) (ZMod (ℓ ^ K)) :=
    Matrix.of fun i j => C₁.D₀ ⟨r₁₂ + i.1, by omega⟩ j
  obtain ⟨P₁L, Q₀, e, he_mono, he_le, he_min, hD₀L_snf⟩ := hSNF m₁ C.n₀ D₀_L
  let U₁_blk := Units.map (blkDiagHom r₁₂ m₁ C.n₁ hm₁_add) P₁L
  let C₂ := conjComplex C₁ Q₀⁻¹ U₁_blk 1
  have hC₂_n₀ : C₂.n₀ = C.n₀ := rfl
  have hC₂_n₁ : C₂.n₁ = C.n₁ := rfl
  have hC₂_n₂ : C₂.n₂ = C.n₂ := rfl
  obtain ⟨hTr_C₂, hModel_C₂⟩ := hBasisChange C₁ hModel_C₁ Q₀⁻¹ U₁_blk 1
  have hTr_C₂_C : weilCurveTrAltTrace C₂ = weilCurveTrAltTrace C := hTr_C₂.trans hTr_C₁

  let V₁ : (Matrix (Fin C.n₁) (Fin C.n₁) (ZMod (ℓ ^ K)))ˣ := U₁_blk⁻¹
  have hV₁_fix : ∀ (i j : Fin C.n₁), (i.1 < r₁₂ ∨ j.1 < r₁₂) →
      V₁.val i j = if i = j then 1 else 0 :=
    fun i j hij => hBlkDiagFix r₁₂ m₁ C.n₁ hm₁_add P₁L⁻¹.val i j hij
  have hC₂_D₁ : C₂.D₁ = C₁.D₁ * V₁.val := by
    change (1 : (Matrix (Fin C.n₂) (Fin C.n₂) _)ˣ).val * C₁.D₁ * U₁_blk⁻¹.val = _
    rw [Units.val_one, Matrix.one_mul]
  have hC₂_D₀_L : ∀ (i : Fin m₁) (j : Fin C.n₀),
      C₂.D₀ ⟨r₁₂ + i.1, by omega⟩ j =
        if i.1 = j.1 then ((ℓ ^ e i.1 : ℕ) : ZMod (ℓ ^ K)) else 0 := by
    intro i j
    change (U₁_blk.val * C₁.D₀ * (Q₀⁻¹)⁻¹.val) ⟨r₁₂ + i.1, by omega⟩ j = _
    rw [inv_inv]
    have hL_row : ∀ u : Fin C.n₀,
        (U₁_blk.val * C₁.D₀) ⟨r₁₂ + i.1, by omega⟩ u = (P₁L.val * D₀_L) i u := by
      intro u
      rw [Matrix.mul_apply]
      change (∑ k : Fin C.n₁, U₁_blk.val ⟨r₁₂ + i.1, by omega⟩ k * C₁.D₀ k u) =
        (P₁L.val * D₀_L) i u
      rw [hSumSplit hm₁_add]
      have h1 : (∑ p : Fin r₁₂,
          U₁_blk.val ⟨r₁₂ + i.1, by omega⟩ ⟨p.1, by omega⟩ * C₁.D₀ ⟨p.1, by omega⟩ u) = 0 := by
        refine Finset.sum_eq_zero fun p _ => ?_
        have hfix := hBlkDiagFix r₁₂ m₁ C.n₁ hm₁_add P₁L.val
          ⟨r₁₂ + i.1, by omega⟩ ⟨p.1, by omega⟩ (Or.inr p.isLt)
        have hne : (⟨r₁₂ + i.1, by omega⟩ : Fin C.n₁) ≠ ⟨p.1, by omega⟩ := by
          intro heq
          have := congrArg Fin.val heq
          dsimp at this
          omega
        simp only [hne, ↓reduceIte] at hfix
        change blkDiagHom r₁₂ m₁ C.n₁ hm₁_add P₁L.val _ _ * _ = 0
        rw [hfix, zero_mul]
      rw [h1, zero_add, Matrix.mul_apply]
      refine Finset.sum_congr rfl fun t _ => ?_
      change blkDiagHom r₁₂ m₁ C.n₁ hm₁_add P₁L.val _ _ * _ = _
      rw [hBlkDiagShift r₁₂ m₁ C.n₁ hm₁_add P₁L.val i t]
      rfl
    rw [Matrix.mul_apply, ← hD₀L_snf i j, Matrix.mul_apply]
    refine Finset.sum_congr rfl fun u _ => ?_
    rw [hL_row u]

  
  have hSubmodDichotomy : ∀ (E m_dim b_dim : ℕ), 2 * E < K →
      ∀ (q : (Fin b_dim → ZMod (ℓ ^ K)) →ₗ[ZMod (ℓ ^ K)] (Fin m_dim → ZMod (ℓ ^ K)))
        (S : Submodule (ZMod (ℓ ^ K)) (Fin m_dim → ZMod (ℓ ^ K)))
        (i₀ : Fin m_dim) (c : ℕ), c ≤ K →
        (∀ w ∈ S, ∃ u : ZMod (ℓ ^ K), w i₀ = ((ℓ ^ c : ℕ) : ZMod (ℓ ^ K)) * u) →
        (∀ x : Fin b_dim → ZMod (ℓ ^ K), q x ∈ S → (ℓ ^ E : ℕ) • x = 0) →
        (∃ x : Fin b_dim → ZMod (ℓ ^ K), (ℓ ^ E : ℕ) • Pi.single i₀ (1 : ZMod (ℓ ^ K)) - q x ∈ S) →
        (c < K → (ℓ ^ c : ℕ) • Pi.single i₀ (1 : ZMod (ℓ ^ K)) ∈ S) →
        c ≤ E ∨ K - E ≤ c := by
    intro E m_dim b_dim h2E q S i₀ c hc hS_coord hq_inj hq_surj hS_gen
    by_contra hnot
    have hEc : E < c := by omega
    have hcKE : c < K - E := by omega
    obtain ⟨x, hx⟩ := hq_surj
    let w := (ℓ ^ E : ℕ) • Pi.single i₀ (1 : ZMod (ℓ ^ K)) - q x
    have hw_S : w ∈ S := hx
    have hscale_w : (ℓ ^ (c - E) : ℕ) • w ∈ S := by
      rw [← Nat.cast_smul_eq_nsmul (ZMod (ℓ ^ K))]
      exact S.smul_mem _ hw_S
    have hscale_eq : (ℓ ^ (c - E) : ℕ) • w =
        (ℓ ^ c : ℕ) • Pi.single i₀ (1 : ZMod (ℓ ^ K)) - q ((ℓ ^ (c - E) : ℕ) • x) := by
      dsimp [w]
      rw [smul_sub, ← mul_smul, ← pow_add, Nat.sub_add_cancel hEc.le, map_nsmul]
    rw [hscale_eq] at hscale_w
    have hqx_mem : q ((ℓ ^ (c - E) : ℕ) • x) ∈ S := by
      have hmem := S.sub_mem (hS_gen (by omega)) hscale_w
      have heq : (ℓ ^ c : ℕ) • Pi.single i₀ (1 : ZMod (ℓ ^ K)) -
          ((ℓ ^ c : ℕ) • Pi.single i₀ (1 : ZMod (ℓ ^ K)) - q ((ℓ ^ (c - E) : ℕ) • x)) =
          q ((ℓ ^ (c - E) : ℕ) • x) := sub_sub_self _ _
      rwa [heq] at hmem
    have hcx_zero : (ℓ ^ c : ℕ) • x = 0 := by
      have h1 := hq_inj _ hqx_mem
      rwa [← mul_smul, ← pow_add, Nat.add_sub_cancel' hEc.le] at h1
    have hx_div : ∀ j : Fin b_dim, ∃ z : ZMod (ℓ ^ K),
        x j = ((ℓ ^ (K - c) : ℕ) : ZMod (ℓ ^ K)) * z := by
      intro j
      have hj := congrFun hcx_zero j
      simp only [Pi.smul_apply, nsmul_eq_mul, Pi.zero_apply] at hj
      exact hCancelPow c hc (x j) hj
    choose z hz using hx_div
    have hx_eq : x = (ℓ ^ (K - c) : ℕ) • z := by
      ext j
      simpa only [Pi.smul_apply, nsmul_eq_mul] using hz j
    obtain ⟨u, hu⟩ := hS_coord w hw_S
    have hw_eval : w i₀ = ((ℓ ^ E : ℕ) : ZMod (ℓ ^ K)) -
        ((ℓ ^ (K - c) : ℕ) : ZMod (ℓ ^ K)) * (q z i₀) := by
      dsimp [w]
      rw [hx_eq, map_nsmul]
      simp [Pi.smul_apply, nsmul_eq_mul]
    have hEqE : ((ℓ ^ E : ℕ) : ZMod (ℓ ^ K)) =
        ((ℓ ^ c : ℕ) : ZMod (ℓ ^ K)) * u + ((ℓ ^ (K - c) : ℕ) : ZMod (ℓ ^ K)) * (q z i₀) := by
      rw [hu] at hw_eval
      linear_combination -hw_eval
    let d₁ := c - (E + 1)
    let d₂ := K - c - (E + 1)
    have hc_pow : ℓ ^ c = ℓ ^ (E + 1) * ℓ ^ d₁ := by
      rw [← pow_add]; congr 1; omega
    have hKc_pow : ℓ ^ (K - c) = ℓ ^ (E + 1) * ℓ ^ d₂ := by
      rw [← pow_add]; congr 1; omega
    have hEqHigher : ((ℓ ^ E : ℕ) : ZMod (ℓ ^ K)) =
        ((ℓ ^ (E + 1) : ℕ) : ZMod (ℓ ^ K)) *
          ((((ℓ ^ d₁ : ℕ) : ZMod (ℓ ^ K)) * u) +
            (((ℓ ^ d₂ : ℕ) : ZMod (ℓ ^ K)) * (q z i₀))) := by
      rw [hEqE, hc_pow, hKc_pow]
      simp only [Nat.cast_mul]
      ring
    exact hPowEqHigherMulFalse E (by omega) _ hEqHigher

  have hModel_C₂' : WeilCurveTrHasBoundedLatticeModel ℓ K B C₂ b M_lat := hModel_C₂
  rcases hModel_C₂' with ⟨⟨q₀, hq₀_ker, hq₀_int, hq₀_inj, hq₀_surj⟩,
    ⟨q₁, hq₁_ker, hq₁_int, hq₁_inj, hq₁_surj⟩,
    ⟨q₂, hq₂_int, hq₂_inj, hq₂_surj⟩⟩

  
  have ha_large : ∀ k : ℕ, r₁₂ ≤ k → K - B ≤ a k := by
    intro k hk
    by_cases hk2 : k < C.n₂
    · let i₀ : Fin C.n₂ := ⟨k, hk2⟩
      have hdich := hSubmodDichotomy B C.n₂ (b 2) (by omega) q₂
        (LinearMap.range C₂.D₁.mulVecLin) i₀ (a k) (ha_le k) ?_ hq₂_inj (hq₂_surj _) ?_
      · rcases hdich with hle | hge
        · exact absurd hle (not_le_of_gt (ha_gt k hk))
        · exact hge
      · rintro w ⟨v, rfl⟩
        let v' : Fin C.n₁ → ZMod (ℓ ^ K) := V₁.val.mulVec v
        have hv : C₂.D₁.mulVecLin v = C₁.D₁.mulVec v' := by
          dsimp [v']
          rw [hC₂_D₁]
          exact (Matrix.mulVec_mulVec v C₁.D₁ V₁.val).symm
        rw [hv]
        change ∃ u, (∑ j : Fin C.n₁, C₁.D₁ i₀ j * v' j) = ((ℓ ^ a k : ℕ) : ZMod (ℓ ^ K)) * u
        simp_rw [hC₁_D₁ i₀]
        by_cases hk1 : k < C.n₁
        · refine ⟨v' ⟨k, hk1⟩, ?_⟩
          have hiff : ∀ j : Fin C.n₁, (i₀.1 = j.1) ↔ (j = ⟨k, hk1⟩) :=
            fun j => ⟨fun h => Fin.ext h.symm, fun h => h ▸ rfl⟩
          simp_rw [hiff]
          simp only [ite_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
          rfl
        · refine ⟨0, ?_⟩
          rw [mul_zero]
          refine Finset.sum_eq_zero fun j _ => ?_
          have hne : i₀.1 ≠ j.1 := by dsimp [i₀]; omega
          simp [hne]
      · intro haK
        have hk_min : k < min C.n₂ C.n₁ := by
          by_contra hge
          exact haK.ne (ha_min k (Nat.le_of_not_lt hge))
        let j₀ : Fin C.n₁ := ⟨k, lt_of_lt_of_le hk_min (min_le_right _ _)⟩
        refine ⟨V₁⁻¹.val.mulVec (Pi.single j₀ 1), ?_⟩
        rw [hC₂_D₁, Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, Matrix.mul_assoc,
          Units.mul_inv, Matrix.mul_one]
        ext i
        simp only [Matrix.mulVec, dotProduct, hC₁_D₁, Pi.smul_apply, Pi.single_apply,
          nsmul_eq_mul, mul_boole]
        have hsum : (∑ x : Fin C.n₁,
            if x = j₀ then if i.1 = x.1 then ((ℓ ^ a i.1 : ℕ) : ZMod (ℓ ^ K)) else 0 else 0) =
            if i.1 = j₀.1 then ((ℓ ^ a i.1 : ℕ) : ZMod (ℓ ^ K)) else 0 := by
          simp
        rw [hsum]
        by_cases hi : i = i₀
        · subst hi; simp [i₀, j₀]
        · have hne : i.1 ≠ j₀.1 := fun h => hi (Fin.ext h)
          simp [hi, hne]
    · rw [ha_min k (le_trans (min_le_left _ _) (Nat.le_of_not_lt hk2))]
      omega

  have hD₁_top : ∀ (i : Fin C.n₂), i.1 < r₁₂ → ∀ (j : Fin C.n₁),
      C₂.D₁ i j = if i.1 = j.1 then ((ℓ ^ a i.1 : ℕ) : ZMod (ℓ ^ K)) else 0 := by
    intro i hi j
    rw [hC₂_D₁, Matrix.mul_apply]
    let p₀ : Fin C.n₁ := ⟨i.1, lt_of_lt_of_le hi hr₁₂_1⟩
    have hiff : ∀ p : Fin C.n₁, C₁.D₁ i p =
        if p = p₀ then ((ℓ ^ a i.1 : ℕ) : ZMod (ℓ ^ K)) else 0 := by
      intro p
      rw [hC₁_D₁ i p]
      by_cases hp : p = p₀
      · subst hp; simp [p₀]
      · have hne : i.1 ≠ p.1 := fun h => hp (Fin.ext h.symm)
        simp [hp, hne]
    simp_rw [hiff]
    simp only [ite_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
    rw [hV₁_fix p₀ j (Or.inl hi)]
    by_cases hpj : p₀ = j
    · subst hpj; simp [p₀]
    · have hne : i.1 ≠ j.1 := fun h => hpj (Fin.ext h)
      simp [hpj, hne]

  have hD₁_bot_left : ∀ (i : Fin C.n₂), r₁₂ ≤ i.1 → ∀ (j : Fin C.n₁), j.1 < r₁₂ →
      C₂.D₁ i j = 0 := by
    intro i hi j hj
    rw [hC₂_D₁, Matrix.mul_apply]
    refine Finset.sum_eq_zero fun p _ => ?_
    rw [hC₁_D₁ i p, hV₁_fix p j (Or.inr hj)]
    by_cases hip : i.1 = p.1
    · have hpj : p ≠ j := by
        intro heq; subst heq; omega
      simp [hip, hpj]
    · simp [hip]

  have hD₁_bot_kill : ∀ (i : Fin C.n₂), r₁₂ ≤ i.1 → ∀ (j : Fin C.n₁),
      ((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) * C₂.D₁ i j = 0 := by
    intro i hi j
    rw [hC₂_D₁, Matrix.mul_apply, Finset.mul_sum]
    refine Finset.sum_eq_zero fun p _ => ?_
    rw [hC₁_D₁ i p]
    by_cases hip : i.1 = p.1
    · simp only [hip, ↓reduceIte, ← mul_assoc, ← Nat.cast_mul, ← pow_add]
      rw [← hip]
      have hge : K ≤ B + a i.1 := by have := ha_large i.1 hi; omega
      have h0 : ((ℓ ^ (B + a i.1) : ℕ) : ZMod (ℓ ^ K)) = 0 :=
        (ZMod.natCast_eq_zero_iff _ _).mpr (pow_dvd_pow ℓ hge)
      rw [h0, zero_mul]
    · simp [hip]

  have hD₀_top_kill : ∀ (i : Fin C.n₁), i.1 < r₁₂ → ∀ (j : Fin C.n₀),
      ((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) * C₂.D₀ i j = 0 := by
    intro i hi j
    let i₂ : Fin C.n₂ := ⟨i.1, lt_of_lt_of_le hi hr₁₂_2⟩
    have hprod : (C₂.D₁ * C₂.D₀) i₂ j = 0 := by rw [C₂.hD, Matrix.zero_apply]
    rw [Matrix.mul_apply] at hprod
    have hterm : ∀ p : Fin C.n₁, C₂.D₁ i₂ p * C₂.D₀ p j =
        if p = i then ((ℓ ^ a i.1 : ℕ) : ZMod (ℓ ^ K)) * C₂.D₀ i j else 0 := by
      intro p
      rw [hD₁_top i₂ hi p]
      by_cases hp : p = i
      · subst hp; simp [i₂]
      · have hne : i₂.1 ≠ p.1 := fun h => hp (Fin.ext h.symm)
        simp [hp, hne]
    simp_rw [hterm] at hprod
    simp only [Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte] at hprod
    exact hPowKillHigher (a i.1) B (ha_small i.1 hi) _ hprod

  
  have hq₁_top : ∀ (x : Fin (b 1) → ZMod (ℓ ^ K)) (p : Fin C.n₁), p.1 < r₁₂ →
      ((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) * q₁ x p = 0 := by
    intro x p hp
    let p₂ : Fin C.n₂ := ⟨p.1, lt_of_lt_of_le hp hr₁₂_2⟩
    have h0 := congrFun (hq₁_ker x) p₂
    change (∑ j : Fin C.n₁, C₂.D₁ p₂ j * q₁ x j) = 0 at h0
    have hterm : ∀ j : Fin C.n₁, C₂.D₁ p₂ j * q₁ x j =
        if j = p then ((ℓ ^ a p.1 : ℕ) : ZMod (ℓ ^ K)) * q₁ x p else 0 := by
      intro j
      rw [hD₁_top p₂ hp j]
      by_cases hjp : j = p
      · subst hjp; simp [p₂]
      · have hne : p₂.1 ≠ j.1 := fun h => hjp (Fin.ext h.symm)
        simp [hjp, hne]
    simp_rw [hterm] at h0
    simp only [Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte] at h0
    exact hPowKillHigher (a p.1) B (ha_small p.1 hp) _ h0

  let π_L : (Fin C.n₁ → ZMod (ℓ ^ K)) →ₗ[ZMod (ℓ ^ K)] (Fin m₁ → ZMod (ℓ ^ K)) :=
    { toFun := fun v t => v ⟨r₁₂ + t.1, by omega⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have he_dich : ∀ k : ℕ, e k ≤ 2 * B ∨ K - 2 * B ≤ e k := by
    intro k
    by_cases hkm : k < m₁
    · let t₀ : Fin m₁ := ⟨k, hkm⟩
      refine hSubmodDichotomy (2 * B) m₁ (b 1) (by omega) (π_L.comp q₁)
        (Submodule.map π_L (LinearMap.range C₂.D₀.mulVecLin)) t₀ (e k) (he_le k)
        ?_ ?_ ?_ ?_
      · rintro w ⟨_, ⟨v, rfl⟩, rfl⟩
        change ∃ u, (∑ j : Fin C.n₀, C₂.D₀ ⟨r₁₂ + t₀.1, by omega⟩ j * v j) =
          ((ℓ ^ e k : ℕ) : ZMod (ℓ ^ K)) * u
        simp_rw [hC₂_D₀_L t₀]
        by_cases hk0 : k < C.n₀
        · refine ⟨v ⟨k, hk0⟩, ?_⟩
          have hiff : ∀ j : Fin C.n₀, (t₀.1 = j.1) ↔ (j = ⟨k, hk0⟩) :=
            fun j => ⟨fun h => Fin.ext h.symm, fun h => h ▸ rfl⟩
          simp_rw [hiff]
          simp only [ite_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
          rfl
        · refine ⟨0, ?_⟩
          rw [mul_zero]
          refine Finset.sum_eq_zero fun j _ => ?_
          have hne : t₀.1 ≠ j.1 := by dsimp [t₀]; omega
          simp [hne]
      · intro x hx
        rcases hx with ⟨_, ⟨z, rfl⟩, hπ_eq⟩
        have hBx_mem : q₁ ((ℓ ^ B : ℕ) • x) ∈ LinearMap.range C₂.D₀.mulVecLin := by
          refine ⟨(ℓ ^ B : ℕ) • z, ?_⟩
          ext p
          rw [map_nsmul, map_nsmul]
          simp only [Matrix.mulVecLin_apply, Pi.smul_apply, nsmul_eq_mul]
          by_cases hp : p.1 < r₁₂
          · rw [hq₁_top x p hp]
            simp only [Matrix.mulVec, dotProduct, Finset.mul_sum]
            exact Finset.sum_eq_zero fun j _ => by
              rw [← mul_assoc, hD₀_top_kill p hp j, zero_mul]
          · let t_p : Fin m₁ := ⟨p.1 - r₁₂, by omega⟩
            have hp_eq : (⟨r₁₂ + t_p.1, by omega⟩ : Fin C.n₁) = p := by
              ext; dsimp [t_p]; omega
            have ht := congrFun hπ_eq t_p
            change (C₂.D₀.mulVec z) ⟨r₁₂ + t_p.1, by omega⟩ = q₁ x ⟨r₁₂ + t_p.1, by omega⟩ at ht
            rw [hp_eq] at ht
            rw [ht]
        have hBB := hq₁_inj _ hBx_mem
        rwa [← mul_smul, ← pow_add, ← two_mul] at hBB
      · let col₀ : Fin C.n₁ := ⟨r₁₂ + k, by omega⟩
        let y : Fin C.n₁ → ZMod (ℓ ^ K) := (ℓ ^ B : ℕ) • Pi.single col₀ (1 : ZMod (ℓ ^ K))
        have hy_ker : C₂.D₁.mulVecLin y = 0 := by
          dsimp only [y]
          rw [map_nsmul]
          ext i
          simp only [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, Pi.smul_apply,
            Pi.single_apply, nsmul_eq_mul, mul_boole, Pi.zero_apply]
          have hsum : (∑ j : Fin C.n₁, if j = col₀ then C₂.D₁ i j else 0) = C₂.D₁ i col₀ := by
            simp
          rw [hsum]
          by_cases hi : i.1 < r₁₂
          · rw [hD₁_top i hi col₀]
            have hne : i.1 ≠ col₀.1 := by dsimp [col₀]; omega
            simp [hne]
          · exact hD₁_bot_kill i (Nat.le_of_not_lt hi) col₀
        obtain ⟨x, hx⟩ := hq₁_surj y hy_ker
        refine ⟨x, ?_⟩
        have hmem := Submodule.mem_map_of_mem (f := π_L) hx
        have hπ_y : π_L ((ℓ ^ B : ℕ) • y) =
            (ℓ ^ (2 * B) : ℕ) • Pi.single t₀ (1 : ZMod (ℓ ^ K)) := by
          dsimp [y]
          rw [← mul_smul, ← pow_add, ← two_mul, map_nsmul]
          congr 1
          ext t
          simp only [π_L, LinearMap.coe_mk, AddHom.coe_mk, Pi.single_apply]
          by_cases ht : t = t₀
          · subst ht; simp [t₀, col₀]
          · have hne : (⟨r₁₂ + t.1, by omega⟩ : Fin C.n₁) ≠ col₀ := by
              intro heq
              apply ht
              ext
              have := congrArg Fin.val heq
              dsimp [t₀, col₀] at this ⊢
              omega
            simp [ht, hne]
        rw [map_sub, hπ_y] at hmem
        exact hmem
      · intro heK
        have hk_min : k < min m₁ C.n₀ := by
          by_contra hge
          exact heK.ne (he_min k (Nat.le_of_not_lt hge))
        let j₀ : Fin C.n₀ := ⟨k, lt_of_lt_of_le hk_min (min_le_right _ _)⟩
        refine ⟨C₂.D₀.mulVecLin (Pi.single j₀ 1), ⟨Pi.single j₀ 1, rfl⟩, ?_⟩
        ext t
        simp only [π_L, LinearMap.coe_mk, AddHom.coe_mk, Matrix.mulVecLin_apply,
          Matrix.mulVec, dotProduct, hC₂_D₀_L t, Pi.smul_apply, Pi.single_apply,
          nsmul_eq_mul, mul_boole]
        have hsum : (∑ j : Fin C.n₀,
            if j = j₀ then if t.1 = j.1 then ((ℓ ^ e t.1 : ℕ) : ZMod (ℓ ^ K)) else 0 else 0) =
            if t.1 = j₀.1 then ((ℓ ^ e t.1 : ℕ) : ZMod (ℓ ^ K)) else 0 := by simp
        rw [hsum]
        by_cases ht : t = t₀
        · subst ht; simp [t₀, j₀]
        · have hne : t.1 ≠ j₀.1 := fun h => ht (Fin.ext h)
          simp [ht, hne]
    · rw [he_min k (le_trans (min_le_left _ _) (Nat.le_of_not_lt hkm))]
      omega

  have hEx₀₁ : ∃ k : ℕ, ¬ (e k ≤ 2 * B) := ⟨min m₁ C.n₀, by rw [he_min _ le_rfl]; omega⟩
  let r₀₁ : ℕ := Nat.find hEx₀₁
  have hr₀₁_min : r₀₁ ≤ min m₁ C.n₀ := Nat.find_min' hEx₀₁ (by rw [he_min _ le_rfl]; omega)
  have hr₀₁_m₁ : r₀₁ ≤ m₁ := le_trans hr₀₁_min (min_le_left _ _)
  have hr₀₁_0 : r₀₁ ≤ C.n₀ := le_trans hr₀₁_min (min_le_right _ _)
  have he_small : ∀ k < r₀₁, e k ≤ 2 * B := fun k hk => not_not.mp (Nat.find_min hEx₀₁ hk)
  have he_gt : ∀ k, r₀₁ ≤ k → 2 * B < e k := fun k hk =>
    lt_of_lt_of_le (Nat.lt_of_not_ge (Nat.find_spec hEx₀₁)) (he_mono hk)
  have he_large : ∀ k, r₀₁ ≤ k → K - 2 * B ≤ e k := by
    intro k hk
    rcases he_dich k with hle | hge
    · exact absurd hle (not_le_of_gt (he_gt k hk))
    · exact hge

  
  let d₀_dim : ℕ := C.n₀ - r₀₁
  let d₁_dim : ℕ := m₁ - r₀₁
  let d₂_dim : ℕ := C.n₂ - r₁₂
  have hd₀_add : r₀₁ + d₀_dim = C.n₀ := by omega
  have hd₁_m₁_add : r₀₁ + d₁_dim = m₁ := by omega
  have hd₁_add : (r₁₂ + r₀₁) + d₁_dim = C.n₁ := by omega
  have hd₂_add : r₁₂ + d₂_dim = C.n₂ := by omega

  let X₁₂ : Matrix (Fin r₁₂) (Fin r₁₂) (ZMod (ℓ ^ K)) :=
    Matrix.of fun i j => C₂.Φ₁ ⟨i.1, by omega⟩ ⟨j.1, by omega⟩
  let Y₁₂ : Matrix (Fin r₁₂) (Fin r₁₂) (ZMod (ℓ ^ K)) :=
    Matrix.of fun i j => C₂.Φ₂ ⟨i.1, by omega⟩ ⟨j.1, by omega⟩
  let X₀₁ : Matrix (Fin r₀₁) (Fin r₀₁) (ZMod (ℓ ^ K)) :=
    Matrix.of fun i j => C₂.Φ₀ ⟨i.1, by omega⟩ ⟨j.1, by omega⟩
  let Y₀₁ : Matrix (Fin r₀₁) (Fin r₀₁) (ZMod (ℓ ^ K)) :=
    Matrix.of fun i j => C₂.Φ₁ ⟨r₁₂ + i.1, by omega⟩ ⟨r₁₂ + j.1, by omega⟩
  let Ψ₀ : Matrix (Fin d₀_dim) (Fin d₀_dim) (ZMod (ℓ ^ K)) :=
    Matrix.of fun i j => C₂.Φ₀ ⟨r₀₁ + i.1, by omega⟩ ⟨r₀₁ + j.1, by omega⟩
  let Ψ₁ : Matrix (Fin d₁_dim) (Fin d₁_dim) (ZMod (ℓ ^ K)) :=
    Matrix.of fun i j => C₂.Φ₁ ⟨(r₁₂ + r₀₁) + i.1, by omega⟩ ⟨(r₁₂ + r₀₁) + j.1, by omega⟩
  let Ψ₂ : Matrix (Fin d₂_dim) (Fin d₂_dim) (ZMod (ℓ ^ K)) :=
    Matrix.of fun i j => C₂.Φ₂ ⟨r₁₂ + i.1, by omega⟩ ⟨r₁₂ + j.1, by omega⟩

  have hTrSplit : weilCurveTrAltTrace C₂ =
      (X₀₁.trace - Y₀₁.trace) - (X₁₂.trace - Y₁₂.trace) +
        (Ψ₀.trace - Ψ₁.trace + Ψ₂.trace) := by
    have htr₀ : C₂.Φ₀.trace = X₀₁.trace + Ψ₀.trace := by
      simp only [Matrix.trace, Matrix.diag, X₀₁, Ψ₀, Matrix.of_apply]
      exact hSumSplit hd₀_add (fun k => C₂.Φ₀ k k)
    have htr₂ : C₂.Φ₂.trace = Y₁₂.trace + Ψ₂.trace := by
      simp only [Matrix.trace, Matrix.diag, Y₁₂, Ψ₂, Matrix.of_apply]
      exact hSumSplit hd₂_add (fun k => C₂.Φ₂ k k)
    have htr₁ : C₂.Φ₁.trace = X₁₂.trace + (Y₀₁.trace + Ψ₁.trace) := by
      simp only [Matrix.trace, Matrix.diag, X₁₂, Y₀₁, Ψ₁, Matrix.of_apply]
      rw [hSumSplit hm₁_add (fun k => C₂.Φ₁ k k),
        hSumSplit hd₁_m₁_add (fun c => C₂.Φ₁ ⟨r₁₂ + c.1, by omega⟩ ⟨r₁₂ + c.1, by omega⟩)]
      congr 2
      refine Finset.sum_congr rfl fun c _ => ?_
      have hidx : (⟨r₁₂ + (r₀₁ + c.1), by omega⟩ : Fin C.n₁) =
          ⟨(r₁₂ + r₀₁) + c.1, by omega⟩ := by
        ext; dsimp; omega
      rw [hidx]
    dsimp [weilCurveTrAltTrace]
    rw [htr₀, htr₁, htr₂]
    ring

  
  have hPair₁₂_kill : ((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) * (X₁₂.trace - Y₁₂.trace) = 0 := by
    have h := hDiagCommTrace 0 B r₁₂ a ha_small X₁₂ Y₁₂ ?_
    · simpa only [Nat.zero_add] using h
    · intro k
      have hk_eq := congrFun (congrFun C₂.hΦ₁ ⟨k.1, by omega⟩) ⟨k.1, by omega⟩
      have hLHS : (C₂.D₁ * C₂.Φ₁) ⟨k.1, by omega⟩ ⟨k.1, by omega⟩ =
          ((ℓ ^ a k.1 : ℕ) : ZMod (ℓ ^ K)) * X₁₂ k k := by
        rw [Matrix.mul_apply]
        have hterm : ∀ p : Fin C.n₁,
            C₂.D₁ ⟨k.1, by omega⟩ p * C₂.Φ₁ p ⟨k.1, by omega⟩ =
            if p = ⟨k.1, by omega⟩ then ((ℓ ^ a k.1 : ℕ) : ZMod (ℓ ^ K)) * X₁₂ k k else 0 := by
          intro p
          rw [hD₁_top ⟨k.1, by omega⟩ k.isLt p]
          by_cases hp : p = ⟨k.1, by omega⟩
          · rw [hp]; simp [X₁₂]
          · have hne : k.1 ≠ p.1 := fun h => hp (Fin.ext h.symm)
            simp [hp, hne]
        simp_rw [hterm]
        simp
      have hRHS : (C₂.Φ₂ * C₂.D₁) ⟨k.1, by omega⟩ ⟨k.1, by omega⟩ =
          Y₁₂ k k * ((ℓ ^ a k.1 : ℕ) : ZMod (ℓ ^ K)) := by
        rw [Matrix.mul_apply]
        have hterm : ∀ q_idx : Fin C.n₂,
            C₂.Φ₂ ⟨k.1, by omega⟩ q_idx * C₂.D₁ q_idx ⟨k.1, by omega⟩ =
            if q_idx = ⟨k.1, by omega⟩ then Y₁₂ k k * ((ℓ ^ a k.1 : ℕ) : ZMod (ℓ ^ K)) else 0 := by
          intro q_idx
          by_cases hq_lt : q_idx.1 < r₁₂
          · rw [hD₁_top q_idx hq_lt ⟨k.1, by omega⟩]
            by_cases hqk : q_idx = ⟨k.1, by omega⟩
            · rw [hqk]; simp [Y₁₂]
            · have hne : q_idx.1 ≠ k.1 := fun h => hqk (Fin.ext h)
              simp [hqk, hne]
          · rw [hD₁_bot_left q_idx (Nat.le_of_not_lt hq_lt) ⟨k.1, by omega⟩ k.isLt, mul_zero]
            have hqk : q_idx ≠ ⟨k.1, by omega⟩ := by
              intro heq; apply hq_lt; rw [heq]; exact k.isLt
            simp [hqk]
        simp_rw [hterm]
        simp
      simp only [pow_zero, Nat.cast_one, one_mul, Matrix.diagonal_mul, Matrix.mul_diagonal]
      rw [← hLHS, ← hRHS, hk_eq, sub_self]

  have hΦ₂_off : ∀ (i : Fin d₂_dim) (j : Fin r₁₂),
      ((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) * C₂.Φ₂ ⟨r₁₂ + i.1, by omega⟩ ⟨j.1, by omega⟩ = 0 := by
    intro i j
    have hij_eq := congrFun (congrFun C₂.hΦ₁ ⟨r₁₂ + i.1, by omega⟩) ⟨j.1, by omega⟩
    have hRHS : (C₂.Φ₂ * C₂.D₁) ⟨r₁₂ + i.1, by omega⟩ ⟨j.1, by omega⟩ =
        C₂.Φ₂ ⟨r₁₂ + i.1, by omega⟩ ⟨j.1, by omega⟩ * ((ℓ ^ a j.1 : ℕ) : ZMod (ℓ ^ K)) := by
      rw [Matrix.mul_apply]
      have hterm : ∀ q_idx : Fin C.n₂,
          C₂.Φ₂ ⟨r₁₂ + i.1, by omega⟩ q_idx * C₂.D₁ q_idx ⟨j.1, by omega⟩ =
          if q_idx = ⟨j.1, by omega⟩ then
            C₂.Φ₂ ⟨r₁₂ + i.1, by omega⟩ ⟨j.1, by omega⟩ * ((ℓ ^ a j.1 : ℕ) : ZMod (ℓ ^ K))
          else 0 := by
        intro q_idx
        by_cases hq_lt : q_idx.1 < r₁₂
        · rw [hD₁_top q_idx hq_lt ⟨j.1, by omega⟩]
          by_cases hqj : q_idx = ⟨j.1, by omega⟩
          · rw [hqj]; simp
          · have hne : q_idx.1 ≠ j.1 := fun h => hqj (Fin.ext h)
            simp [hqj, hne]
        · rw [hD₁_bot_left q_idx (Nat.le_of_not_lt hq_lt) ⟨j.1, by omega⟩ j.isLt, mul_zero]
          have hqj : q_idx ≠ ⟨j.1, by omega⟩ := by
            intro heq; apply hq_lt; rw [heq]; exact j.isLt
          simp [hqj]
      simp_rw [hterm]
      simp
    have hLHS_kill : ((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) *
        (C₂.D₁ * C₂.Φ₁) ⟨r₁₂ + i.1, by omega⟩ ⟨j.1, by omega⟩ = 0 := by
      rw [Matrix.mul_apply, Finset.mul_sum]
      refine Finset.sum_eq_zero fun p _ => ?_
      rw [← mul_assoc, hD₁_bot_kill ⟨r₁₂ + i.1, by omega⟩ (by dsimp; omega) p, zero_mul]
    rw [hij_eq, hRHS] at hLHS_kill
    have hBa : ((ℓ ^ (B + a j.1) : ℕ) : ZMod (ℓ ^ K)) *
        C₂.Φ₂ ⟨r₁₂ + i.1, by omega⟩ ⟨j.1, by omega⟩ = 0 := by
      rw [pow_add, Nat.cast_mul]
      linear_combination hLHS_kill
    exact hPowKillHigher (B + a j.1) (2 * B) (by have := ha_small j.1 j.isLt; omega) _ hBa

  have hPair₀₁_kill : ((ℓ ^ (3 * B) : ℕ) : ZMod (ℓ ^ K)) * (X₀₁.trace - Y₀₁.trace) = 0 := by
    have h3B : B + 2 * B = 3 * B := by omega
    rw [← h3B]
    refine hDiagCommTrace B (2 * B) r₀₁ e he_small X₀₁ Y₀₁ fun k => ?_
    have hk_eq := congrFun (congrFun C₂.hΦ₀ ⟨r₁₂ + k.1, by omega⟩) ⟨k.1, by omega⟩
    have hLHS : (C₂.D₀ * C₂.Φ₀) ⟨r₁₂ + k.1, by omega⟩ ⟨k.1, by omega⟩ =
        ((ℓ ^ e k.1 : ℕ) : ZMod (ℓ ^ K)) * X₀₁ k k := by
      rw [Matrix.mul_apply]
      let k_m₁ : Fin m₁ := ⟨k.1, lt_of_lt_of_le k.isLt hr₀₁_m₁⟩
      have hterm : ∀ u : Fin C.n₀,
          C₂.D₀ ⟨r₁₂ + k_m₁.1, by omega⟩ u * C₂.Φ₀ u ⟨k.1, by omega⟩ =
          if u = ⟨k.1, by omega⟩ then ((ℓ ^ e k.1 : ℕ) : ZMod (ℓ ^ K)) * X₀₁ k k else 0 := by
        intro u
        rw [hC₂_D₀_L k_m₁ u]
        by_cases hu : u = ⟨k.1, by omega⟩
        · subst hu; simp [k_m₁, X₀₁]
        · have hne : k_m₁.1 ≠ u.1 := fun h => hu (Fin.ext h.symm)
          simp [hu, hne]
      exact (Finset.sum_congr rfl fun u _ => hterm u).trans (by simp)
    have hRHS_kill : ((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) *
        ((C₂.Φ₁ * C₂.D₀) ⟨r₁₂ + k.1, by omega⟩ ⟨k.1, by omega⟩ -
          Y₀₁ k k * ((ℓ ^ e k.1 : ℕ) : ZMod (ℓ ^ K))) = 0 := by
      rw [Matrix.mul_apply, hSumSplit hm₁_add]
      have htop : ((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) *
          (∑ p : Fin r₁₂,
            C₂.Φ₁ ⟨r₁₂ + k.1, by omega⟩ ⟨p.1, by omega⟩ * C₂.D₀ ⟨p.1, by omega⟩ ⟨k.1, by omega⟩) = 0 := by
        rw [Finset.mul_sum]
        refine Finset.sum_eq_zero fun p _ => ?_
        have hp_kill := hD₀_top_kill ⟨p.1, by omega⟩ p.isLt ⟨k.1, by omega⟩
        calc ((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) *
              (C₂.Φ₁ ⟨r₁₂ + k.1, by omega⟩ ⟨p.1, by omega⟩ * C₂.D₀ ⟨p.1, by omega⟩ ⟨k.1, by omega⟩)
            = C₂.Φ₁ ⟨r₁₂ + k.1, by omega⟩ ⟨p.1, by omega⟩ *
              (((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) * C₂.D₀ ⟨p.1, by omega⟩ ⟨k.1, by omega⟩) := by ring
          _ = 0 := by rw [hp_kill, mul_zero]
      have hbot : (∑ t : Fin m₁,
          C₂.Φ₁ ⟨r₁₂ + k.1, by omega⟩ ⟨r₁₂ + t.1, by omega⟩ *
            C₂.D₀ ⟨r₁₂ + t.1, by omega⟩ ⟨k.1, by omega⟩) =
          Y₀₁ k k * ((ℓ ^ e k.1 : ℕ) : ZMod (ℓ ^ K)) := by
        let k_m₁ : Fin m₁ := ⟨k.1, lt_of_lt_of_le k.isLt hr₀₁_m₁⟩
        have hterm : ∀ t : Fin m₁,
            C₂.Φ₁ ⟨r₁₂ + k.1, by omega⟩ ⟨r₁₂ + t.1, by omega⟩ *
              C₂.D₀ ⟨r₁₂ + t.1, by omega⟩ ⟨k.1, by omega⟩ =
            if t = k_m₁ then Y₀₁ k k * ((ℓ ^ e k.1 : ℕ) : ZMod (ℓ ^ K)) else 0 := by
          intro t
          rw [hC₂_D₀_L t ⟨k.1, by omega⟩]
          by_cases ht : t = k_m₁
          · subst ht; simp [k_m₁, Y₀₁]
          · have hne : t.1 ≠ k.1 := fun h => ht (Fin.ext h)
            simp [ht, hne]
        simp_rw [hterm]
        simp
      rw [hbot, add_sub_cancel_right, htop]
    simp only [Matrix.diagonal_mul, Matrix.mul_diagonal]
    rw [← hLHS, hk_eq]
    exact hRHS_kill

  have hΦ₁_off : ∀ (i : Fin d₁_dim) (j : Fin r₀₁),
      ((ℓ ^ (4 * B) : ℕ) : ZMod (ℓ ^ K)) *
        C₂.Φ₁ ⟨(r₁₂ + r₀₁) + i.1, by omega⟩ ⟨r₁₂ + j.1, by omega⟩ = 0 := by
    intro i j
    let row_m₁ : Fin m₁ := ⟨r₀₁ + i.1, by omega⟩
    have hrow_eq : (⟨(r₁₂ + r₀₁) + i.1, by omega⟩ : Fin C.n₁) = ⟨r₁₂ + row_m₁.1, by omega⟩ := by
      ext; dsimp [row_m₁]; omega
    rw [hrow_eq]
    have hij_eq := congrFun (congrFun C₂.hΦ₀ ⟨r₁₂ + row_m₁.1, by omega⟩) ⟨j.1, by omega⟩
    have hLHS_kill : ((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) *
        (C₂.D₀ * C₂.Φ₀) ⟨r₁₂ + row_m₁.1, by omega⟩ ⟨j.1, by omega⟩ = 0 := by
      rw [Matrix.mul_apply, Finset.mul_sum]
      refine Finset.sum_eq_zero fun u _ => ?_
      rw [hC₂_D₀_L row_m₁ u]
      by_cases hu : row_m₁.1 = u.1
      · simp only [hu, ↓reduceIte, ← mul_assoc, ← Nat.cast_mul, ← pow_add]
        rw [← hu]
        have hge : K ≤ 2 * B + e row_m₁.1 := by
          have := he_large row_m₁.1 (by dsimp [row_m₁]; omega)
          omega
        have h0 : ((ℓ ^ (2 * B + e row_m₁.1) : ℕ) : ZMod (ℓ ^ K)) = 0 :=
          (ZMod.natCast_eq_zero_iff _ _).mpr (pow_dvd_pow ℓ hge)
        rw [h0, zero_mul]
      · simp [hu]
    have hRHS_eval : ((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) *
        (C₂.Φ₁ * C₂.D₀) ⟨r₁₂ + row_m₁.1, by omega⟩ ⟨j.1, by omega⟩ =
        ((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) *
          (C₂.Φ₁ ⟨r₁₂ + row_m₁.1, by omega⟩ ⟨r₁₂ + j.1, by omega⟩ *
            ((ℓ ^ e j.1 : ℕ) : ZMod (ℓ ^ K))) := by
      rw [Matrix.mul_apply, hSumSplit hm₁_add, mul_add]
      have htop : ((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) *
          (∑ p : Fin r₁₂,
            C₂.Φ₁ ⟨r₁₂ + row_m₁.1, by omega⟩ ⟨p.1, by omega⟩ *
              C₂.D₀ ⟨p.1, by omega⟩ ⟨j.1, by omega⟩) = 0 := by
        rw [Finset.mul_sum]
        refine Finset.sum_eq_zero fun p _ => ?_
        have hp_kill : ((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) *
            C₂.D₀ ⟨p.1, by omega⟩ ⟨j.1, by omega⟩ = 0 :=
          hPowKillHigher B (2 * B) (by omega) _ (hD₀_top_kill ⟨p.1, by omega⟩ p.isLt ⟨j.1, by omega⟩)
        calc ((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) *
              (C₂.Φ₁ ⟨r₁₂ + row_m₁.1, by omega⟩ ⟨p.1, by omega⟩ *
                C₂.D₀ ⟨p.1, by omega⟩ ⟨j.1, by omega⟩)
            = C₂.Φ₁ ⟨r₁₂ + row_m₁.1, by omega⟩ ⟨p.1, by omega⟩ *
              (((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) * C₂.D₀ ⟨p.1, by omega⟩ ⟨j.1, by omega⟩) := by ring
          _ = 0 := by rw [hp_kill, mul_zero]
      rw [htop, zero_add]
      congr 1
      let j_m₁ : Fin m₁ := ⟨j.1, lt_of_lt_of_le j.isLt hr₀₁_m₁⟩
      have hterm : ∀ t : Fin m₁,
          C₂.Φ₁ ⟨r₁₂ + row_m₁.1, by omega⟩ ⟨r₁₂ + t.1, by omega⟩ *
            C₂.D₀ ⟨r₁₂ + t.1, by omega⟩ ⟨j.1, by omega⟩ =
          if t = j_m₁ then
            C₂.Φ₁ ⟨r₁₂ + row_m₁.1, by omega⟩ ⟨r₁₂ + j.1, by omega⟩ *
              ((ℓ ^ e j.1 : ℕ) : ZMod (ℓ ^ K))
          else 0 := by
        intro t
        rw [hC₂_D₀_L t ⟨j.1, by omega⟩]
        by_cases ht : t = j_m₁
        · subst ht; simp [j_m₁]
        · have hne : t.1 ≠ j.1 := fun h => ht (Fin.ext h)
          simp [ht, hne]
      simp_rw [hterm]
      simp
    rw [hij_eq, hRHS_eval] at hLHS_kill
    have h2Be : ((ℓ ^ (2 * B + e j.1) : ℕ) : ZMod (ℓ ^ K)) *
        C₂.Φ₁ ⟨r₁₂ + row_m₁.1, by omega⟩ ⟨r₁₂ + j.1, by omega⟩ = 0 := by
      rw [pow_add, Nat.cast_mul]
      linear_combination hLHS_kill
    exact hPowKillHigher (2 * B + e j.1) (4 * B) (by have := he_small j.1 j.isLt; omega) _ h2Be

  
  let matOfLin : ∀ {d_dim b_dim : ℕ},
      ((Fin b_dim → ZMod (ℓ ^ K)) →ₗ[ZMod (ℓ ^ K)] (Fin d_dim → ZMod (ℓ ^ K))) →
      Matrix (Fin d_dim) (Fin b_dim) (ZMod (ℓ ^ K)) :=
    fun f => Matrix.of fun t j => f (Pi.single j 1) t

  have hVecBasisSum : ∀ {N : ℕ} (x : Fin N → ZMod (ℓ ^ K)),
      (∑ j : Fin N, x j • Pi.single j (1 : ZMod (ℓ ^ K))) = x := by
    intro N x
    ext i
    simp [Finset.sum_apply, Pi.single_apply]

  have hMatOfLinMulVec : ∀ {d_dim b_dim : ℕ}
      (f : (Fin b_dim → ZMod (ℓ ^ K)) →ₗ[ZMod (ℓ ^ K)] (Fin d_dim → ZMod (ℓ ^ K)))
      (x : Fin b_dim → ZMod (ℓ ^ K)),
      (matOfLin f).mulVec x = f x := by
    intro d_dim b_dim f x
    conv_rhs => rw [← hVecBasisSum x, map_sum]
    ext t
    simp only [matOfLin, Matrix.mulVec, dotProduct, Matrix.of_apply, Finset.sum_apply,
      map_smul, Pi.smul_apply, smul_eq_mul, mul_comm]

  have hMatOfLinInter : ∀ {d_dim b_dim : ℕ}
      (f : (Fin b_dim → ZMod (ℓ ^ K)) →ₗ[ZMod (ℓ ^ K)] (Fin d_dim → ZMod (ℓ ^ K)))
      (M : Matrix (Fin b_dim) (Fin b_dim) (ZMod (ℓ ^ K)))
      (Ψ_m : Matrix (Fin d_dim) (Fin d_dim) (ZMod (ℓ ^ K)))
      (t : Fin d_dim) (j : Fin b_dim),
      (matOfLin f * M) t j - (Ψ_m * matOfLin f) t j =
        f (M.mulVec (Pi.single j 1)) t - (Ψ_m.mulVec (f (Pi.single j 1))) t := by
    intro d_dim b_dim f M Ψ_m t j
    have h1 : (matOfLin f * M) t j = f (M.mulVec (Pi.single j 1)) t := by
      have hcol : M.mulVec (Pi.single j 1) = ∑ u : Fin b_dim, M u j • Pi.single u (1 : ZMod (ℓ ^ K)) := by
        ext u
        simp [Matrix.mulVec, dotProduct, Finset.sum_apply, Pi.single_apply]
      rw [hcol, map_sum]
      simp only [matOfLin, Matrix.mul_apply, Matrix.of_apply, Finset.sum_apply,
        map_smul, Pi.smul_apply, smul_eq_mul, mul_comm]
    have h2 : (Ψ_m * matOfLin f) t j = (Ψ_m.mulVec (f (Pi.single j 1))) t := by
      simp only [matOfLin, Matrix.mul_apply, Matrix.of_apply, Matrix.mulVec, dotProduct]
    rw [h1, h2]

  
  let π₀ : (Fin C.n₀ → ZMod (ℓ ^ K)) →ₗ[ZMod (ℓ ^ K)] (Fin d₀_dim → ZMod (ℓ ^ K)) :=
    { toFun := fun v t => v ⟨r₀₁ + t.1, by omega⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  let F₀ := matOfLin (π₀.comp q₀)
  have hq₀_top : ∀ (x : Fin (b 0) → ZMod (ℓ ^ K)) (u : Fin C.n₀), u.1 < r₀₁ →
      ((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) * q₀ x u = 0 := by
    intro x u hu
    let row_u : Fin m₁ := ⟨u.1, lt_of_lt_of_le hu hr₀₁_m₁⟩
    have h0 := congrFun (hq₀_ker x) ⟨r₁₂ + row_u.1, by omega⟩
    simp only [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, hC₂_D₀_L row_u, Pi.zero_apply] at h0
    have hterm : ∀ j : Fin C.n₀,
        (if row_u.1 = j.1 then ((ℓ ^ e row_u.1 : ℕ) : ZMod (ℓ ^ K)) else 0) * q₀ x j =
        if j = u then ((ℓ ^ e u.1 : ℕ) : ZMod (ℓ ^ K)) * q₀ x u else 0 := by
      intro j
      by_cases hju : j = u
      · subst hju; simp [row_u]
      · have hne : row_u.1 ≠ j.1 := fun h => hju (Fin.ext h.symm)
        simp [hju, hne]
    simp_rw [hterm] at h0
    simp only [Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte] at h0
    exact hPowKillHigher (e u.1) (2 * B) (he_small u.1 hu) _ h0

  have hCoh₀ : ((ℓ ^ (7 * B) : ℕ) : ZMod (ℓ ^ K)) * ((A 0).trace - Ψ₀.trace) = 0 := by
    have h7 : 4 * B + 3 * B = 7 * B := by omega
    rw [← h7]
    refine hApproxQIsoTrace (4 * B) (4 * B) (3 * B) (2 * B) d₀_dim (b 0) (by omega) (by omega)
      F₀ (A 0) Ψ₀ ?_ ?_ ?_
    · intro t j
      dsimp [F₀]
      rw [hMatOfLinInter]
      let x : Fin (b 0) → ZMod (ℓ ^ K) := Pi.single j 1
      have hint_j := congrFun (hq₀_int x) ⟨r₀₁ + t.1, by omega⟩
      change q₀ ((A 0).mulVec x) ⟨r₀₁ + t.1, by omega⟩ =
        (C₂.Φ₀.mulVec (q₀ x)) ⟨r₀₁ + t.1, by omega⟩ at hint_j
      change ((ℓ ^ (4 * B) : ℕ) : ZMod (ℓ ^ K)) *
        (q₀ ((A 0).mulVec x) ⟨r₀₁ + t.1, by omega⟩ - (Ψ₀.mulVec (π₀ (q₀ x))) t) = 0
      rw [hint_j]
      simp only [Matrix.mulVec, dotProduct]
      rw [hSumSplit hd₀_add]
      have hbot_eq : (∑ c : Fin d₀_dim,
          C₂.Φ₀ ⟨r₀₁ + t.1, by omega⟩ ⟨r₀₁ + c.1, by omega⟩ * q₀ x ⟨r₀₁ + c.1, by omega⟩) =
          ∑ c : Fin d₀_dim, Ψ₀ t c * π₀ (q₀ x) c := rfl
      rw [hbot_eq, add_sub_cancel_right, Finset.mul_sum]
      refine Finset.sum_eq_zero fun u _ => ?_
      have hu_kill := hPowKillHigher (2 * B) (4 * B) (by omega) _ (hq₀_top x ⟨u.1, by omega⟩ u.isLt)
      calc ((ℓ ^ (4 * B) : ℕ) : ZMod (ℓ ^ K)) *
            (C₂.Φ₀ ⟨r₀₁ + t.1, by omega⟩ ⟨u.1, by omega⟩ * q₀ x ⟨u.1, by omega⟩)
          = C₂.Φ₀ ⟨r₀₁ + t.1, by omega⟩ ⟨u.1, by omega⟩ *
            (((ℓ ^ (4 * B) : ℕ) : ZMod (ℓ ^ K)) * q₀ x ⟨u.1, by omega⟩) := by ring
        _ = 0 := by rw [hu_kill, mul_zero]
    · intro x hx
      rw [hMatOfLinMulVec] at hx
      have h2Bx : q₀ ((ℓ ^ (2 * B) : ℕ) • x) = 0 := by
        ext u
        rw [map_nsmul]
        simp only [Pi.smul_apply, nsmul_eq_mul, Pi.zero_apply]
        by_cases hu : u.1 < r₀₁
        · exact hq₀_top x u hu
        · let t_u : Fin d₀_dim := ⟨u.1 - r₀₁, by omega⟩
          have hu_eq : (⟨r₀₁ + t_u.1, by omega⟩ : Fin C.n₀) = u := by
            ext; dsimp [t_u]; omega
          have ht := congrFun hx t_u
          change q₀ x ⟨r₀₁ + t_u.1, by omega⟩ = 0 at ht
          rw [hu_eq] at ht
          rw [ht, mul_zero]
      have h3Bx : (ℓ ^ (3 * B) : ℕ) • x = 0 := by
        have h1 := hq₀_inj _ h2Bx
        rwa [← mul_smul, ← pow_add, show B + 2 * B = 3 * B by omega] at h1
      ext j
      have hj := congrFun h3Bx j
      simp only [Pi.smul_apply, nsmul_eq_mul, Pi.zero_apply] at hj ⊢
      exact hPowKillHigher (3 * B) (4 * B) (by omega) _ hj
    · intro y
      let y_ext : Fin C.n₀ → ZMod (ℓ ^ K) := fun u =>
        if hu : u.1 < r₀₁ then 0 else y ⟨u.1 - r₀₁, by omega⟩
      have hy_ker : C₂.D₀.mulVecLin ((ℓ ^ (2 * B) : ℕ) • y_ext) = 0 := by
        ext row
        simp only [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, Pi.mul_apply,
          Pi.natCast_apply, nsmul_eq_mul, Pi.zero_apply]
        refine Finset.sum_eq_zero fun u _ => ?_
        by_cases hu : u.1 < r₀₁
        · simp [y_ext, hu]
        · by_cases hrow₁ : row.1 < r₁₂
          · have hk := hPowKillHigher B (2 * B) (by omega) _ (hD₀_top_kill row hrow₁ u)
            calc C₂.D₀ row u * (((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) * y_ext u)
                = (((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) * C₂.D₀ row u) * y_ext u := by ring
              _ = 0 := by rw [hk, zero_mul]
          · let row_m₁ : Fin m₁ := ⟨row.1 - r₁₂, by omega⟩
            have hrow_eq : row = ⟨r₁₂ + row_m₁.1, by omega⟩ := by
              ext; dsimp [row_m₁]; omega
            rw [hrow_eq, hC₂_D₀_L row_m₁ u]
            by_cases hru : row_m₁.1 = u.1
            · simp only [hru, ↓reduceIte]
              have hge : K ≤ e u.1 + 2 * B := by
                have := he_large u.1 (Nat.le_of_not_lt hu)
                omega
              have h0 : ((ℓ ^ (e u.1 + 2 * B) : ℕ) : ZMod (ℓ ^ K)) = 0 :=
                (ZMod.natCast_eq_zero_iff _ _).mpr (pow_dvd_pow ℓ hge)
              calc ((ℓ ^ e u.1 : ℕ) : ZMod (ℓ ^ K)) *
                    (((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) * y_ext u)
                  = ((ℓ ^ (e u.1 + 2 * B) : ℕ) : ZMod (ℓ ^ K)) * y_ext u := by
                      rw [pow_add, Nat.cast_mul, mul_assoc]
                _ = 0 := by rw [h0, zero_mul]
            · simp [hru]
      obtain ⟨x, hx⟩ := hq₀_surj _ hy_ker
      refine ⟨x, fun t => ?_⟩
      dsimp [F₀]
      rw [hMatOfLinMulVec]
      change ((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) *
        (q₀ x ⟨r₀₁ + t.1, by omega⟩ - ((ℓ ^ (3 * B) : ℕ) • y) t) = 0
      have hxt := congrFun hx ⟨r₀₁ + t.1, by omega⟩
      have hy_t : y_ext ⟨r₀₁ + t.1, by omega⟩ = y t := by
        dsimp [y_ext]
        have hnot : ¬ (r₀₁ + t.1 < r₀₁) := by omega
        simp only [hnot, ↓reduceDIte]
        congr 1; ext; dsimp; omega
      simp only [Pi.smul_apply, Pi.mul_apply, Pi.natCast_apply, nsmul_eq_mul, hy_t] at hxt ⊢
      have heq : q₀ x ⟨r₀₁ + t.1, by omega⟩ = ((ℓ ^ (3 * B) : ℕ) : ZMod (ℓ ^ K)) * y t := by
        rw [hxt, ← mul_assoc, ← Nat.cast_mul, ← pow_add, show B + 2 * B = 3 * B by omega]
      rw [heq, sub_self, mul_zero]

  
  let π₁ : (Fin C.n₁ → ZMod (ℓ ^ K)) →ₗ[ZMod (ℓ ^ K)] (Fin d₁_dim → ZMod (ℓ ^ K)) :=
    { toFun := fun v t => v ⟨(r₁₂ + r₀₁) + t.1, by omega⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  let F₁ := matOfLin (π₁.comp q₁)
  have hRangeD₀_bot_kill : ∀ w ∈ LinearMap.range C₂.D₀.mulVecLin, ∀ t : Fin d₁_dim,
      ((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) * (π₁ w t) = 0 := by
    rintro _ ⟨z, rfl⟩ t
    let row_m₁ : Fin m₁ := ⟨r₀₁ + t.1, by omega⟩
    have hidx : (⟨(r₁₂ + r₀₁) + t.1, by omega⟩ : Fin C.n₁) = ⟨r₁₂ + row_m₁.1, by omega⟩ := by
      ext; dsimp [row_m₁]; omega
    change ((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) *
      (C₂.D₀.mulVec z) ⟨(r₁₂ + r₀₁) + t.1, by omega⟩ = 0
    rw [hidx]
    simp only [Matrix.mulVec, dotProduct, hC₂_D₀_L row_m₁, Finset.mul_sum]
    refine Finset.sum_eq_zero fun u _ => ?_
    by_cases hru : row_m₁.1 = u.1
    · simp only [hru, ↓reduceIte, ← mul_assoc, ← Nat.cast_mul, ← pow_add]
      rw [← hru]
      have hge : K ≤ 2 * B + e row_m₁.1 := by
        have := he_large row_m₁.1 (by dsimp [row_m₁]; omega)
        omega
      have h0 : ((ℓ ^ (2 * B + e row_m₁.1) : ℕ) : ZMod (ℓ ^ K)) = 0 :=
        (ZMod.natCast_eq_zero_iff _ _).mpr (pow_dvd_pow ℓ hge)
      rw [h0, zero_mul]
    · simp [hru]

  have hCoh₁ : ((ℓ ^ (7 * B) : ℕ) : ZMod (ℓ ^ K)) * ((A 1).trace - Ψ₁.trace) = 0 := by
    have h7 : 4 * B + 3 * B = 7 * B := by omega
    rw [← h7]
    refine hApproxQIsoTrace (4 * B) (4 * B) (3 * B) (2 * B) d₁_dim (b 1) (by omega) (by omega)
      F₁ (A 1) Ψ₁ ?_ ?_ ?_
    · intro t j
      dsimp [F₁]
      rw [hMatOfLinInter]
      let x : Fin (b 1) → ZMod (ℓ ^ K) := Pi.single j 1
      have hint_kill : ((ℓ ^ (4 * B) : ℕ) : ZMod (ℓ ^ K)) *
          (π₁ (q₁ ((A 1).mulVec x) - C₂.Φ₁.mulVec (q₁ x)) t) = 0 :=
        hPowKillHigher (2 * B) (4 * B) (by omega) _
          (hRangeD₀_bot_kill _ (hq₁_int x) t)
      have hmid_kill : ((ℓ ^ (4 * B) : ℕ) : ZMod (ℓ ^ K)) *
          ((C₂.Φ₁.mulVec (q₁ x)) ⟨(r₁₂ + r₀₁) + t.1, by omega⟩ -
            (Ψ₁.mulVec (π₁ (q₁ x))) t) = 0 := by
        simp only [Matrix.mulVec, dotProduct]
        rw [hSumSplit hm₁_add, hSumSplit hd₁_m₁_add]
        have hbot_eq : (∑ c : Fin d₁_dim,
            C₂.Φ₁ ⟨(r₁₂ + r₀₁) + t.1, by omega⟩ ⟨r₁₂ + (r₀₁ + c.1), by omega⟩ *
              q₁ x ⟨r₁₂ + (r₀₁ + c.1), by omega⟩) =
            ∑ c : Fin d₁_dim, Ψ₁ t c * π₁ (q₁ x) c := by
          refine Finset.sum_congr rfl fun c _ => ?_
          have hidx : (⟨r₁₂ + (r₀₁ + c.1), by omega⟩ : Fin C.n₁) =
              ⟨(r₁₂ + r₀₁) + c.1, by omega⟩ := by
            ext; dsimp; omega
          rw [hidx]
          rfl
        rw [hbot_eq, ← add_assoc, add_sub_cancel_right, mul_add]
        have h1 : ((ℓ ^ (4 * B) : ℕ) : ZMod (ℓ ^ K)) *
            (∑ p : Fin r₁₂,
              C₂.Φ₁ ⟨(r₁₂ + r₀₁) + t.1, by omega⟩ ⟨p.1, by omega⟩ *
                q₁ x ⟨p.1, by omega⟩) = 0 := by
          rw [Finset.mul_sum]
          refine Finset.sum_eq_zero fun p _ => ?_
          have hp_kill := hPowKillHigher B (4 * B) (by omega) _
            (hq₁_top x ⟨p.1, by omega⟩ p.isLt)
          calc ((ℓ ^ (4 * B) : ℕ) : ZMod (ℓ ^ K)) *
                (C₂.Φ₁ ⟨(r₁₂ + r₀₁) + t.1, by omega⟩ ⟨p.1, by omega⟩ * q₁ x ⟨p.1, by omega⟩)
              = C₂.Φ₁ ⟨(r₁₂ + r₀₁) + t.1, by omega⟩ ⟨p.1, by omega⟩ *
                (((ℓ ^ (4 * B) : ℕ) : ZMod (ℓ ^ K)) * q₁ x ⟨p.1, by omega⟩) := by ring
            _ = 0 := by rw [hp_kill, mul_zero]
        have h2 : ((ℓ ^ (4 * B) : ℕ) : ZMod (ℓ ^ K)) *
            (∑ k : Fin r₀₁,
              C₂.Φ₁ ⟨(r₁₂ + r₀₁) + t.1, by omega⟩ ⟨r₁₂ + k.1, by omega⟩ *
                q₁ x ⟨r₁₂ + k.1, by omega⟩) = 0 := by
          rw [Finset.mul_sum]
          refine Finset.sum_eq_zero fun k _ => ?_
          rw [← mul_assoc, hΦ₁_off t k, zero_mul]
        rw [h1, h2, add_zero]
      change ((ℓ ^ (4 * B) : ℕ) : ZMod (ℓ ^ K)) *
        (π₁ (q₁ ((A 1).mulVec x)) t - (Ψ₁.mulVec (π₁ (q₁ x))) t) = 0
      simp only [π₁, LinearMap.coe_mk, AddHom.coe_mk, Pi.sub_apply] at hint_kill ⊢
      linear_combination hint_kill + hmid_kill
    · intro x hx
      rw [hMatOfLinMulVec] at hx
      let z : Fin C.n₀ → ZMod (ℓ ^ K) := fun u =>
        if hu : u.1 < r₀₁ then
          ((ℓ ^ (2 * B - e u.1) : ℕ) : ZMod (ℓ ^ K)) * q₁ x ⟨r₁₂ + u.1, by omega⟩
        else 0
      have h3Bx_mem : q₁ ((ℓ ^ (3 * B) : ℕ) • x) ∈ LinearMap.range C₂.D₀.mulVecLin := by
        refine ⟨(ℓ ^ B : ℕ) • z, ?_⟩
        ext p
        rw [map_nsmul, map_nsmul]
        simp only [Matrix.mulVecLin_apply, Pi.smul_apply, nsmul_eq_mul]
        by_cases hp₁ : p.1 < r₁₂
        · have hR : ((ℓ ^ (3 * B) : ℕ) : ZMod (ℓ ^ K)) * q₁ x p = 0 :=
            hPowKillHigher B (3 * B) (by omega) _ (hq₁_top x p hp₁)
          rw [hR]
          simp only [Matrix.mulVec, dotProduct, Finset.mul_sum]
          exact Finset.sum_eq_zero fun u _ => by
            rw [← mul_assoc, hD₀_top_kill p hp₁ u, zero_mul]
        · let p_m₁ : Fin m₁ := ⟨p.1 - r₁₂, by omega⟩
          have hp_eq : p = ⟨r₁₂ + p_m₁.1, by omega⟩ := by
            ext; dsimp [p_m₁]; omega
          rw [hp_eq]
          simp only [Matrix.mulVec, dotProduct, hC₂_D₀_L p_m₁]
          by_cases hp₂ : p_m₁.1 < r₀₁
          · let u₀_idx : Fin C.n₀ := ⟨p_m₁.1, lt_of_lt_of_le hp₂ hr₀₁_0⟩
            have hterm : ∀ u : Fin C.n₀,
                (if p_m₁.1 = u.1 then ((ℓ ^ e p_m₁.1 : ℕ) : ZMod (ℓ ^ K)) else 0) * z u =
                if u = u₀_idx then
                  ((ℓ ^ (2 * B) : ℕ) : ZMod (ℓ ^ K)) * q₁ x ⟨r₁₂ + p_m₁.1, by omega⟩
                else 0 := by
              intro u
              by_cases hu : u = u₀_idx
              · subst hu
                simp only [u₀_idx, hp₂, ↓reduceIte, ↓reduceDIte, z, ← mul_assoc,
                  ← Nat.cast_mul, ← pow_add]
                rw [Nat.add_sub_cancel' (he_small p_m₁.1 hp₂)]
              · have hne : p_m₁.1 ≠ u.1 := fun h => hu (Fin.ext h.symm)
                simp [hu, hne]
            simp_rw [hterm]
            simp only [Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte, ← mul_assoc,
              ← Nat.cast_mul, ← pow_add]
            rw [show B + 2 * B = 3 * B by omega]
          · have hLHS0 : ∑ u : Fin C.n₀,
                (if p_m₁.1 = u.1 then ((ℓ ^ e p_m₁.1 : ℕ) : ZMod (ℓ ^ K)) else 0) * z u = 0 := by
              refine Finset.sum_eq_zero fun u _ => ?_
              by_cases hu : u.1 < r₀₁
              · have hne : p_m₁.1 ≠ u.1 := by omega
                simp [hne]
              · simp [z, hu]
            rw [hLHS0, mul_zero]
            let t_p : Fin d₁_dim := ⟨p_m₁.1 - r₀₁, by omega⟩
            have hidx : (⟨r₁₂ + p_m₁.1, by omega⟩ : Fin C.n₁) =
                ⟨(r₁₂ + r₀₁) + t_p.1, by omega⟩ := by
              ext; dsimp [t_p]; omega
            have ht := congrFun hx t_p
            change q₁ x ⟨(r₁₂ + r₀₁) + t_p.1, by omega⟩ = 0 at ht
            rw [hidx, ht, mul_zero]
      have h4Bx := hq₁_inj _ h3Bx_mem
      rwa [← mul_smul, ← pow_add, show B + 3 * B = 4 * B by omega] at h4Bx
    · intro y
      let y_ext : Fin C.n₁ → ZMod (ℓ ^ K) := fun p =>
        if hp : p.1 < r₁₂ + r₀₁ then 0
        else ((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) * y ⟨p.1 - (r₁₂ + r₀₁), by omega⟩
      have hy_ker : C₂.D₁.mulVecLin y_ext = 0 := by
        ext row
        simp only [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, Pi.zero_apply]
        refine Finset.sum_eq_zero fun p _ => ?_
        by_cases hrow : row.1 < r₁₂
        · rw [hD₁_top row hrow p]
          by_cases hrp : row.1 = p.1
          · have hp_lt : p.1 < r₁₂ + r₀₁ := by omega
            simp [hrp, y_ext, hp_lt]
          · simp [hrp]
        · by_cases hp : p.1 < r₁₂ + r₀₁
          · simp [y_ext, hp]
          · simp only [y_ext, hp, ↓reduceDIte]
            calc C₂.D₁ row p * (((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) * y ⟨p.1 - (r₁₂ + r₀₁), by omega⟩)
                = (((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) * C₂.D₁ row p) *
                  y ⟨p.1 - (r₁₂ + r₀₁), by omega⟩ := by ring
              _ = 0 := by rw [hD₁_bot_kill row (Nat.le_of_not_lt hrow) p, zero_mul]
      obtain ⟨x₀, hx₀⟩ := hq₁_surj y_ext hy_ker
      refine ⟨(ℓ ^ B : ℕ) • x₀, fun t => ?_⟩
      dsimp [F₁]
      rw [hMatOfLinMulVec]
      have hscale_mem : (ℓ ^ B : ℕ) • ((ℓ ^ B : ℕ) • y_ext - q₁ x₀) ∈
          LinearMap.range C₂.D₀.mulVecLin := by
        rw [← Nat.cast_smul_eq_nsmul (ZMod (ℓ ^ K))]
        exact (LinearMap.range C₂.D₀.mulVecLin).smul_mem _ hx₀
      have hk := hRangeD₀_bot_kill _ hscale_mem t
      rw [smul_sub, ← map_nsmul q₁] at hk
      have hy_t : y_ext ⟨(r₁₂ + r₀₁) + t.1, by omega⟩ = ((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) * y t := by
        dsimp [y_ext]
        have hnot : ¬ ((r₁₂ + r₀₁) + t.1 < r₁₂ + r₀₁) := by omega
        simp only [hnot, ↓reduceDIte]
        congr 2; ext; dsimp; omega
      simp only [π₁, LinearMap.comp_apply, LinearMap.coe_mk, AddHom.coe_mk, Pi.sub_apply,
        Pi.mul_apply, Pi.natCast_apply, nsmul_eq_mul, hy_t] at hk ⊢
      have hrew : ((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) *
          (((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) * (((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) * y t)) =
          ((ℓ ^ (3 * B) : ℕ) : ZMod (ℓ ^ K)) * y t := by
        rw [← mul_assoc, ← mul_assoc, ← Nat.cast_mul, ← Nat.cast_mul, ← pow_add, ← pow_add,
          show B + B + B = 3 * B by omega]
      rw [hrew] at hk
      linear_combination -hk

  
  let π₂ : (Fin C.n₂ → ZMod (ℓ ^ K)) →ₗ[ZMod (ℓ ^ K)] (Fin d₂_dim → ZMod (ℓ ^ K)) :=
    { toFun := fun v t => v ⟨r₁₂ + t.1, by omega⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  let F₂ := matOfLin (π₂.comp q₂)
  have hRangeD₁_bot_kill : ∀ w ∈ LinearMap.range C₂.D₁.mulVecLin, ∀ t : Fin d₂_dim,
      ((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) * (π₂ w t) = 0 := by
    rintro _ ⟨z, rfl⟩ t
    change ((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) * (C₂.D₁.mulVec z) ⟨r₁₂ + t.1, by omega⟩ = 0
    simp only [Matrix.mulVec, dotProduct, Finset.mul_sum]
    refine Finset.sum_eq_zero fun p _ => ?_
    rw [← mul_assoc, hD₁_bot_kill ⟨r₁₂ + t.1, by omega⟩ (by dsimp; omega) p, zero_mul]

  have hCoh₂ : ((ℓ ^ (7 * B) : ℕ) : ZMod (ℓ ^ K)) * ((A 2).trace - Ψ₂.trace) = 0 := by
    have h7 : 4 * B + 3 * B = 7 * B := by omega
    rw [← h7]
    refine hApproxQIsoTrace (4 * B) (4 * B) (3 * B) (2 * B) d₂_dim (b 2) (by omega) (by omega)
      F₂ (A 2) Ψ₂ ?_ ?_ ?_
    · intro t j
      dsimp [F₂]
      rw [hMatOfLinInter]
      let x : Fin (b 2) → ZMod (ℓ ^ K) := Pi.single j 1
      have hint_kill : ((ℓ ^ (4 * B) : ℕ) : ZMod (ℓ ^ K)) *
          (π₂ (q₂ ((A 2).mulVec x) - C₂.Φ₂.mulVec (q₂ x)) t) = 0 :=
        hPowKillHigher B (4 * B) (by omega) _ (hRangeD₁_bot_kill _ (hq₂_int x) t)
      have hmid_kill : ((ℓ ^ (4 * B) : ℕ) : ZMod (ℓ ^ K)) *
          ((C₂.Φ₂.mulVec (q₂ x)) ⟨r₁₂ + t.1, by omega⟩ - (Ψ₂.mulVec (π₂ (q₂ x))) t) = 0 := by
        simp only [Matrix.mulVec, dotProduct]
        rw [hSumSplit hd₂_add]
        have hbot_eq : (∑ c : Fin d₂_dim,
            C₂.Φ₂ ⟨r₁₂ + t.1, by omega⟩ ⟨r₁₂ + c.1, by omega⟩ * q₂ x ⟨r₁₂ + c.1, by omega⟩) =
            ∑ c : Fin d₂_dim, Ψ₂ t c * π₂ (q₂ x) c := rfl
        rw [hbot_eq, add_sub_cancel_right, Finset.mul_sum]
        refine Finset.sum_eq_zero fun k _ => ?_
        have hk_kill := hPowKillHigher (2 * B) (4 * B) (by omega) _ (hΦ₂_off t k)
        rw [← mul_assoc, hk_kill, zero_mul]
      change ((ℓ ^ (4 * B) : ℕ) : ZMod (ℓ ^ K)) *
        (π₂ (q₂ ((A 2).mulVec x)) t - (Ψ₂.mulVec (π₂ (q₂ x))) t) = 0
      simp only [π₂, LinearMap.coe_mk, AddHom.coe_mk, Pi.sub_apply] at hint_kill ⊢
      linear_combination hint_kill + hmid_kill
    · intro x hx
      rw [hMatOfLinMulVec] at hx
      let z : Fin C.n₁ → ZMod (ℓ ^ K) := fun p =>
        if hp : p.1 < r₁₂ then
          ((ℓ ^ (B - a p.1) : ℕ) : ZMod (ℓ ^ K)) * q₂ x ⟨p.1, lt_of_lt_of_le hp hr₁₂_2⟩
        else 0
      have hBx_mem : q₂ ((ℓ ^ B : ℕ) • x) ∈ LinearMap.range C₂.D₁.mulVecLin := by
        refine ⟨z, ?_⟩
        ext i
        rw [map_nsmul]
        simp only [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, Pi.smul_apply, nsmul_eq_mul]
        by_cases hi : i.1 < r₁₂
        · let p₀ : Fin C.n₁ := ⟨i.1, lt_of_lt_of_le hi hr₁₂_1⟩
          have hterm : ∀ p : Fin C.n₁, C₂.D₁ i p * z p =
              if p = p₀ then ((ℓ ^ B : ℕ) : ZMod (ℓ ^ K)) * q₂ x i else 0 := by
            intro p
            rw [hD₁_top i hi p]
            by_cases hp : p = p₀
            · subst hp
              simp only [p₀, hi, ↓reduceIte, ↓reduceDIte, z, ← mul_assoc,
                ← Nat.cast_mul, ← pow_add]
              rw [Nat.add_sub_cancel' (ha_small i.1 hi)]
            · have hne : i.1 ≠ p.1 := fun h => hp (Fin.ext h.symm)
              simp [hp, hne]
          simp_rw [hterm]
          simp
        · have hLHS0 : ∑ p : Fin C.n₁, C₂.D₁ i p * z p = 0 := by
            refine Finset.sum_eq_zero fun p _ => ?_
            by_cases hp : p.1 < r₁₂
            · rw [hD₁_bot_left i (Nat.le_of_not_lt hi) p hp, zero_mul]
            · simp [z, hp]
          rw [hLHS0]
          let t_i : Fin d₂_dim := ⟨i.1 - r₁₂, by omega⟩
          have hi_eq : i = ⟨r₁₂ + t_i.1, by omega⟩ := by
            ext; dsimp [t_i]; omega
          have ht := congrFun hx t_i
          change q₂ x ⟨r₁₂ + t_i.1, by omega⟩ = 0 at ht
          rw [hi_eq, ht, mul_zero]
      have h2Bx : (ℓ ^ (2 * B) : ℕ) • x = 0 := by
        have h1 := hq₂_inj _ hBx_mem
        rwa [← mul_smul, ← pow_add, ← two_mul] at h1
      ext j
      have hj := congrFun h2Bx j
      simp only [Pi.smul_apply, nsmul_eq_mul, Pi.zero_apply] at hj ⊢
      exact hPowKillHigher (2 * B) (4 * B) (by omega) _ hj
    · intro y
      let y_ext : Fin C.n₂ → ZMod (ℓ ^ K) := fun i =>
        if hi : i.1 < r₁₂ then 0 else y ⟨i.1 - r₁₂, by omega⟩
      obtain ⟨x₀, hx₀⟩ := hq₂_surj y_ext
      refine ⟨(ℓ ^ (2 * B) : ℕ) • x₀, fun t => ?_⟩
      dsimp [F₂]
      rw [hMatOfLinMulVec]
      have hscale_mem : (ℓ ^ (2 * B) : ℕ) • ((ℓ ^ B : ℕ) • y_ext - q₂ x₀) ∈
          LinearMap.range C₂.D₁.mulVecLin := by
        rw [← Nat.cast_smul_eq_nsmul (ZMod (ℓ ^ K))]
        exact (LinearMap.range C₂.D₁.mulVecLin).smul_mem _ hx₀
      have hk := hPowKillHigher B (2 * B) (by omega) _ (hRangeD₁_bot_kill _ hscale_mem t)
      rw [smul_sub, ← map_nsmul q₂] at hk
