                    ((((ℓ : Padic ℓ) ^ k₂)⁻¹ * ((ℓ : Padic ℓ) ^ k₂)) * B_int w₁ v) := by ring
              _ = (((ℓ : Padic ℓ) ^ k₁)⁻¹) * B_int w₁ v := by
                  rw [inv_mul_cancel₀ hpow2_ne, one_mul]
          have hc2 : (((ℓ : Padic ℓ) ^ k₁)⁻¹ * ((ℓ : Padic ℓ) ^ k₂)⁻¹) *
              (((ℓ : Padic ℓ) ^ k₁) * B_int w₂ v) = (((ℓ : Padic ℓ) ^ k₂)⁻¹) * B_int w₂ v := by
            calc (((ℓ : Padic ℓ) ^ k₁)⁻¹ * ((ℓ : Padic ℓ) ^ k₂)⁻¹) *
                (((ℓ : Padic ℓ) ^ k₁) * B_int w₂ v)
                = (((ℓ : Padic ℓ) ^ k₂)⁻¹) *
                    ((((ℓ : Padic ℓ) ^ k₁)⁻¹ * ((ℓ : Padic ℓ) ^ k₁)) * B_int w₂ v) := by ring
              _ = (((ℓ : Padic ℓ) ^ k₂)⁻¹) * B_int w₂ v := by
