      exact ⟨v, by simpa [v] using hw_prim, hv_pow⟩
    let tower : ∀ s : ℕ, { u : k_barˣ // IsPrimitiveRoot ((u : k_barˣ) : k_bar) (ℓ ^ (s + 1)) } :=
      Nat.rec ⟨u₁, hu₁_prim⟩ (fun s prev =>
