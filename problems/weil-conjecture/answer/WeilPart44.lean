      Quiver.Hom ((U_mod (ℓ ^ (r + 1 + 1))).obj L₁.ℳ) ((U_mod (ℓ ^ (r + 1))).obj L₀.ℳ))
    (τ_ℳ_dual_ab :
      let U_mod (m : ℕ) := CategoryTheory.sheafCompose S.smallEtaleTopology
