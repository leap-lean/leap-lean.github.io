        w ∈ I_int := by
      intro ψ k w hw h hh
      ext i
      apply hcoe_inj
      have hψ_inv := congrArg vecOf (ψ.2 h hh)
      rw [hvec_comp_mat] at hψ_inv
      have hψ_i := congrFun hψ_inv i
      simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply, Matrix.map_apply] at hψ_i ⊢
      rw [map_sum]
      calc ∑ x : Fin N, algebraMap (PadicInt ℓ) (Padic ℓ) (h.val x i * w x)
