    have hRelEq : ∀ (ℱ : 𝒞) (W Z : S.Etale) (a₁ a₂ : Quiver.Hom Z (obj_WV W)),
        CategoryTheory.CategoryStruct.comp a₁ (p_W W) =
          CategoryTheory.CategoryStruct.comp a₂ (p_W W) →
        ∀ c : ↑(ℱ.obj.obj (Opposite.op (obj_WV W))),
          (∀ g : Γ, (ℱ.obj.map (Opposite.op (m_can W g))).hom c = c) →
          (ℱ.obj.map (Opposite.op a₁)).hom c = (ℱ.obj.map (Opposite.op a₂)).hom c := by
      intro ℱ W Z a₁ a₂ hcomm c hc_inv
      have ha_fst : CategoryTheory.CategoryStruct.comp a₁.left (fst₁ W) =
          CategoryTheory.CategoryStruct.comp a₂.left (fst₁ W) :=
        congrArg (fun φ => (Fgt.map φ).left) hcomm
      have hqZ_cond : CategoryTheory.CategoryStruct.comp a₁.left (Fgt.obj (obj_WV W)).hom =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp a₂.left (snd₁ W)) ι_V :=
        (CategoryTheory.Category.assoc a₁.left (fst₁ W) (Fgt.obj W).hom).symm.trans
          ((congrArg (· ≫ (Fgt.obj W).hom) ha_fst).trans
            ((CategoryTheory.Category.assoc a₂.left (fst₁ W) (Fgt.obj W).hom).trans
              ((congrArg (a₂.left ≫ ·)
                (CategoryTheory.Limits.pullback.condition (f := (Fgt.obj W).hom) (g := ι_V))).trans
                (CategoryTheory.Category.assoc _ _ _).symm)))
      let q_Z : Quiver.Hom Z.left ((Fgt.obj (obj_WV (obj_WV W))).left) :=
        CategoryTheory.Limits.pullback.lift a₁.left
          (CategoryTheory.CategoryStruct.comp a₂.left (snd₁ W)) hqZ_cond
      let Z_open : Γ → Z.left.Opens :=
        fun g => (TopologicalSpace.Opens.map q_Z.base).obj (O'_g W g)
      let Y_Z : Γ → S.Etale :=
        fun g => CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.CategoryStruct.comp (Z_open g).ι Z.hom)
          (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            (Z_open g).ι Z.hom inferInstance Z.prop)
      let inc_Z : ∀ g : Γ, Quiver.Hom (Y_Z g) Z :=
        fun g => CategoryTheory.MorphismProperty.Over.homMk (Z_open g).ι rfl trivial
      have hZ_cov : ∀ z : ↥Z.left, ∃ g : Γ, z ∈ Set.range ⇑(inc_Z g).left.base := by
        intro z
        obtain ⟨g, hg⟩ := hσ_cov W (q_Z.base z)
        have hg' : q_Z.base z ∈ (O'_g W g : Set _) := by
          change q_Z.base z ∈ ⇑(q_VV W).base ⁻¹' Set.range ⇑(γ_map g).base
          exact Eq.mp (congrArg (fun S_set => q_Z.base z ∈ S_set) (hσ_range W g)) hg
        refine ⟨g, ?_⟩
        change z ∈ Set.range (Z_open g).ι.base
        rw [AlgebraicGeometry.Scheme.Opens.range_ι (Z_open g)]
        exact hg'
      have hZ_sheet : ∀ g : Γ,
          CategoryTheory.CategoryStruct.comp (inc_Z g) a₂ =
            CategoryTheory.CategoryStruct.comp (inc_Z g)
              (CategoryTheory.CategoryStruct.comp a₁ (m_can W g)) := by
        intro g
        have hsub : Set.range (CategoryTheory.CategoryStruct.comp (Z_open g).ι q_Z).base ⊆
            Set.range (O'_g W g).ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι (O'_g W g)]
          rintro _ ⟨w, rfl⟩
          have hw : (Z_open g).ι.base w ∈ Set.range (Z_open g).ι.base := ⟨w, rfl⟩
          rw [AlgebraicGeometry.Scheme.Opens.range_ι (Z_open g)] at hw
          exact hw
        let q_lift := AlgebraicGeometry.IsOpenImmersion.lift (O'_g W g).ι
          (CategoryTheory.CategoryStruct.comp (Z_open g).ι q_Z) hsub
        have hq_fac : CategoryTheory.CategoryStruct.comp q_lift (O'_g W g).ι =
            CategoryTheory.CategoryStruct.comp (Z_open g).ι q_Z :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ hsub
        have hfst_qZ : CategoryTheory.CategoryStruct.comp q_Z (fst₁ (obj_WV W)) = a₁.left :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hsnd_qZ : CategoryTheory.CategoryStruct.comp q_Z (snd₁ (obj_WV W)) =
            CategoryTheory.CategoryStruct.comp a₂.left (snd₁ W) :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hsec_eq : CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp (Z_open g).ι a₁.left)
            (Fgt.map (σ_g W g)).left =
            CategoryTheory.CategoryStruct.comp (Z_open g).ι q_Z :=
          (congrArg (fun φ => ((Z_open g).ι ≫ φ) ≫ (Fgt.map (σ_g W g)).left) hfst_qZ.symm).trans
            ((congrArg (fun φ => φ ≫ (Fgt.map (σ_g W g)).left)
              (CategoryTheory.Category.assoc _ _ _).symm).trans
              ((congrArg (fun φ => (φ ≫ fst₁ (obj_WV W)) ≫ (Fgt.map (σ_g W g)).left) hq_fac.symm).trans
                ((congrArg (fun φ => φ ≫ (Fgt.map (σ_g W g)).left)
                  (CategoryTheory.Category.assoc _ _ _)).trans
                  ((CategoryTheory.Category.assoc _ _ _).trans
                    ((congrArg (fun φ => q_lift ≫ φ) (hO'_fac W g)).trans hq_fac)))))
        have hsnd_eq : CategoryTheory.CategoryStruct.comp (Z_open g).ι
            (CategoryTheory.CategoryStruct.comp a₂.left (snd₁ W)) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp (Z_open g).ι a₁.left)
              (CategoryTheory.CategoryStruct.comp (snd₁ W) (act g)) :=
          (congrArg ((Z_open g).ι ≫ ·) hsnd_qZ.symm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ snd₁ (obj_WV W)) hsec_eq.symm).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (_ ≫ ·) (hσ_snd W g)))))
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg ((Z_open g).ι ≫ ·) ha_fst.symm).trans
              ((congrArg ((Z_open g).ι ≫ a₁.left ≫ ·) (hm_fst W g).symm).trans
                ((congrArg ((Z_open g).ι ≫ ·) (CategoryTheory.Category.assoc _ _ _).symm).trans
                  (CategoryTheory.Category.assoc _ _ _).symm)))
        · exact (CategoryTheory.Category.assoc _ _ _).trans
            (hsnd_eq.trans
              ((CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg ((Z_open g).ι ≫ a₁.left ≫ ·) (hm_snd W g).symm).trans
                  ((congrArg ((Z_open g).ι ≫ ·) (CategoryTheory.Category.assoc _ _ _).symm).trans
                    (CategoryTheory.Category.assoc _ _ _).symm))))
      obtain ⟨t, -, ht_uniq⟩ := hSheafArrows ℱ Z Y_Z inc_Z hZ_cov
        (fun g => (ℱ.obj.map (Opposite.op (CategoryTheory.CategoryStruct.comp (inc_Z g) a₁))).hom c)
        (fun g₁ g₂ Z' b₁ b₂ hb => by
          have h1 : CategoryTheory.CategoryStruct.comp b₁
              (CategoryTheory.CategoryStruct.comp (inc_Z g₁) a₁) =
            CategoryTheory.CategoryStruct.comp b₂
              (CategoryTheory.CategoryStruct.comp (inc_Z g₂) a₁) :=
            (CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ a₁) hb).trans (CategoryTheory.Category.assoc _ _ _))
          exact (hMapComp ℱ b₁ _ c).symm.trans
            ((congrArg (fun φ => (ℱ.obj.map (Opposite.op φ)).hom c) h1).trans
              (hMapComp ℱ b₂ _ c)))
      have ht1 : (ℱ.obj.map (Opposite.op a₁)).hom c = t :=
        ht_uniq _ fun g => (hMapComp ℱ (inc_Z g) a₁ c).symm
      have ht2 : (ℱ.obj.map (Opposite.op a₂)).hom c = t :=
        ht_uniq _ fun g =>
          (hMapComp ℱ (inc_Z g) a₂ c).symm.trans
            ((congrArg (fun φ => (ℱ.obj.map (Opposite.op φ)).hom c) (hZ_sheet g)).trans
              ((hMapComp ℱ (inc_Z g) (CategoryTheory.CategoryStruct.comp a₁ (m_can W g)) c).trans
                ((congrArg (ℱ.obj.map (Opposite.op (inc_Z g))).hom
                  ((hMapComp ℱ a₁ (m_can W g) c).trans
                    (congrArg (ℱ.obj.map (Opposite.op a₁)).hom (hc_inv g)))).trans
                  (hMapComp ℱ (inc_Z g) a₁ c).symm)))
      exact ht1.trans ht2.symm

    let W₀_V_op : ∀ (W : S.Etale), (Fgt.obj W).left.Opens → ((Fgt.obj (obj_WV W)).left).Opens :=
      fun W W₀ =>
        (TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_V).base).obj W₀
    let obj_W₀V : ∀ (W : S.Etale), (Fgt.obj W).left.Opens → S.Etale :=
      fun W W₀ =>
        letI : AlgebraicGeometry.Etale (Fgt.obj (obj_WV W)).hom := (obj_WV W).prop
        CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.CategoryStruct.comp (W₀_V_op W W₀).ι (Fgt.obj (obj_WV W)).hom)
          inferInstance
    let inc_W₀ : ∀ (W : S.Etale) (W₀ : (Fgt.obj W).left.Opens),
        Quiver.Hom (obj_W₀V W W₀) (obj_WV W) :=
      fun W W₀ => CategoryTheory.MorphismProperty.Over.homMk (W₀_V_op W W₀).ι rfl trivial
    have hIncLe : ∀ (𝒢 : 𝒞) (W : S.Etale) {W₀₁ W₀₂ : (Fgt.obj W).left.Opens},
        W₀₁ ≤ W₀₂ →
        ∀ x : ↑(𝒢.obj.obj (Opposite.op (obj_WV W))),
          (𝒢.obj.map (Opposite.op (inc_W₀ W W₀₂))).hom x = 0 →
          (𝒢.obj.map (Opposite.op (inc_W₀ W W₀₁))).hom x = 0 := by
      intro 𝒢 W W₀₁ W₀₂ hle x hx0
      have hsub : Set.range (W₀_V_op W W₀₁).ι.base ⊆ Set.range (W₀_V_op W W₀₂).ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι, AlgebraicGeometry.Scheme.Opens.range_ι]
        exact fun _ hy => hle hy
      let step_l := AlgebraicGeometry.IsOpenImmersion.lift (W₀_V_op W W₀₂).ι (W₀_V_op W W₀₁).ι hsub
      have hstep_fac : CategoryTheory.CategoryStruct.comp step_l (W₀_V_op W W₀₂).ι =
          (W₀_V_op W W₀₁).ι :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ hsub
      let step_et : Quiver.Hom (obj_W₀V W W₀₁) (obj_W₀V W W₀₂) :=
        CategoryTheory.MorphismProperty.Over.homMk step_l
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            (congrArg (· ≫ (Fgt.obj (obj_WV W)).hom) hstep_fac))
          trivial
      have hcomp_eq : CategoryTheory.CategoryStruct.comp step_et (inc_W₀ W W₀₂) = inc_W₀ W W₀₁ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext hstep_fac
      exact (congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom x) hcomp_eq.symm).trans
        ((hMapComp 𝒢 step_et (inc_W₀ W W₀₂) x).trans
          ((congrArg (𝒢.obj.map (Opposite.op step_et)).hom hx0).trans (map_zero _)))
    have hIncPull : ∀ (𝒢 : 𝒞) {W₁ W₂ : S.Etale} (u : Quiver.Hom W₁ W₂)
        (W₀₂ : (Fgt.obj W₂).left.Opens),
        ((TopologicalSpace.Opens.map (Fgt.obj W₂).hom.base).obj U) ⊔ W₀₂ = ⊤ →
        let W₀₁ : (Fgt.obj W₁).left.Opens :=
          (TopologicalSpace.Opens.map (Fgt.map u).left.base).obj W₀₂
        ((TopologicalSpace.Opens.map (Fgt.obj W₁).hom.base).obj U) ⊔ W₀₁ = ⊤ ∧
        ∀ x : ↑(𝒢.obj.obj (Opposite.op (obj_WV W₂))),
          (𝒢.obj.map (Opposite.op (inc_W₀ W₂ W₀₂))).hom x = 0 →
          (𝒢.obj.map (Opposite.op (inc_W₀ W₁ W₀₁))).hom
            ((𝒢.obj.map (Opposite.op (u_can u))).hom x) = 0 := by
      intro 𝒢 W₁ W₂ u W₀₂ hcov₂ W₀₁
      refine ⟨?_, ?_⟩
      · rw [eq_top_iff]
        intro z _
        have hz₂ : (Fgt.map u).left.base z ∈
            (((TopologicalSpace.Opens.map (Fgt.obj W₂).hom.base).obj U) ⊔ W₀₂ :
              (Fgt.obj W₂).left.Opens) := by
          rw [hcov₂]; trivial
        rcases hz₂ with hU₂ | hW₂
        · left
          have hw : ((Fgt.map u).left ≫ (Fgt.obj W₂).hom).base z = (Fgt.obj W₁).hom.base z :=
            congrArg (fun φ => φ.base z) (Fgt.map u).w
          change (Fgt.obj W₁).hom.base z ∈ U
          exact Eq.mp (congrArg (fun p => p ∈ U) hw) hU₂
        · right; exact hW₂
      · intro x hx0
        have hsub : Set.range
            (CategoryTheory.CategoryStruct.comp (W₀_V_op W₁ W₀₁).ι (Fgt.map (u_can u)).left).base ⊆
            Set.range (W₀_V_op W₂ W₀₂).ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨w, rfl⟩
          have hw : (W₀_V_op W₁ W₀₁).ι.base w ∈ Set.range (W₀_V_op W₁ W₀₁).ι.base := ⟨w, rfl⟩
          rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hw
          have hcomm_fst := congrArg (fun φ => φ.base ((W₀_V_op W₁ W₀₁).ι.base w)) (hu_fst u)
          change ((Fgt.map (u_can u)).left ≫ fst₁ W₂).base ((W₀_V_op W₁ W₀₁).ι.base w) ∈ W₀₂
          exact Eq.mp (congrArg (fun p => p ∈ W₀₂) hcomm_fst.symm) hw
        let l_u := AlgebraicGeometry.IsOpenImmersion.lift (W₀_V_op W₂ W₀₂).ι
          (CategoryTheory.CategoryStruct.comp (W₀_V_op W₁ W₀₁).ι (Fgt.map (u_can u)).left) hsub
        have hl_fac : CategoryTheory.CategoryStruct.comp l_u (W₀_V_op W₂ W₀₂).ι =
            CategoryTheory.CategoryStruct.comp (W₀_V_op W₁ W₀₁).ι (Fgt.map (u_can u)).left :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ hsub
        let l_et : Quiver.Hom (obj_W₀V W₁ W₀₁) (obj_W₀V W₂ W₀₂) :=
          CategoryTheory.MorphismProperty.Over.homMk l_u
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ (Fgt.obj (obj_WV W₂)).hom) hl_fac).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg ((W₀_V_op W₁ W₀₁).ι ≫ ·) (Fgt.map (u_can u)).w))))
            trivial
        have hcomp_eq : CategoryTheory.CategoryStruct.comp (inc_W₀ W₁ W₀₁) (u_can u) =
            CategoryTheory.CategoryStruct.comp l_et (inc_W₀ W₂ W₀₂) :=
          CategoryTheory.MorphismProperty.Over.Hom.ext hl_fac.symm
        exact (hMapComp 𝒢 (inc_W₀ W₁ W₀₁) (u_can u) x).symm.trans
          ((congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom x) hcomp_eq).trans
            ((hMapComp 𝒢 l_et (inc_W₀ W₂ W₀₂) x).trans
              ((congrArg (𝒢.obj.map (Opposite.op l_et)).hom hx0).trans (map_zero _))))

    let T_sub : ∀ (𝒢 : 𝒞) (W : S.Etale),
        Submodule R (Fin M → ↑(𝒢.obj.obj (Opposite.op (obj_WV W)))) :=
      fun 𝒢 W =>
        { carrier :=
            { f |
              (∃ W₀ : (Fgt.obj W).left.Opens,
                ((TopologicalSpace.Opens.map (Fgt.obj W).hom.base).obj U) ⊔ W₀ = ⊤ ∧
                let W₀_V : ((Fgt.obj (obj_WV W)).left).Opens :=
                  (TopologicalSpace.Opens.map
                    (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_V).base).obj W₀
                letI : AlgebraicGeometry.Etale (Fgt.obj (obj_WV W)).hom := (obj_WV W).prop
                let obj_W₀V : S.Etale :=
                  CategoryTheory.MorphismProperty.Over.mk ⊤
                    (CategoryTheory.CategoryStruct.comp W₀_V.ι (Fgt.obj (obj_WV W)).hom)
                    inferInstance
                let inc_W₀ : Quiver.Hom obj_W₀V (obj_WV W) :=
                  CategoryTheory.MorphismProperty.Over.homMk W₀_V.ι rfl trivial
                ∀ i : Fin M, (𝒢.obj.map (Opposite.op inc_W₀)).hom (f i) = 0) ∧
              (∀ (g : Γ) (m_g : Quiver.Hom (obj_WV W) (obj_WV W)),
                CategoryTheory.CategoryStruct.comp (Fgt.map m_g).left
                  (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_V) =
                  CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_V →
                CategoryTheory.CategoryStruct.comp (Fgt.map m_g).left
                  (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_V) =
                  CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_V) (act g) →
                ∀ i : Fin M,
                  (𝒢.obj.map (Opposite.op m_g)).hom (f i) =
                    Finset.univ.sum (fun j : Fin M => (ULift.up ((τ_rep g).val i j) : R) • f j)) }
          zero_mem' := ⟨⟨⊤, sup_top_eq _, fun _ => map_zero _⟩, fun g _ _ _ i =>
            (map_zero _).trans
              (Finset.sum_eq_zero fun j _ =>
                hModSmulZero (𝒢.obj.obj (Opposite.op (obj_WV W)))
                  (ULift.up ((τ_rep g).val i j) : R)).symm⟩
          add_mem' := fun {f₁ f₂} hf₁ hf₂ => by
            rcases hf₁ with ⟨⟨W₀₁, hcov₁, h0₁⟩, heq₁⟩
            rcases hf₂ with ⟨⟨W₀₂, hcov₂, h0₂⟩, heq₂⟩
            refine ⟨⟨W₀₁ ⊓ W₀₂, by rw [sup_inf_left, hcov₁, hcov₂, top_inf_eq], fun i =>
              (map_add _ (f₁ i) (f₂ i)).trans
                ((congrArg₂ (· + ·)
                  (hIncLe 𝒢 W inf_le_left (f₁ i) (h0₁ i))
                  (hIncLe 𝒢 W inf_le_right (f₂ i) (h0₂ i))).trans (add_zero 0))⟩,
              fun g m_g hm1 hm2 i =>
                (map_add (𝒢.obj.map (Opposite.op m_g)).hom (f₁ i) (f₂ i)).trans
                  ((congrArg₂ (· + ·) (heq₁ g m_g hm1 hm2 i) (heq₂ g m_g hm1 hm2 i)).trans
                    (Finset.sum_add_distrib.symm.trans
                      (Finset.sum_congr rfl fun _ _ => (smul_add _ _ _).symm)))⟩
          smul_mem' := fun r {f} hf => by
            rcases hf with ⟨⟨W₀, hcov, h0⟩, heq⟩
            refine ⟨⟨W₀, hcov, fun i =>
              (map_smul _ r (f i)).trans
                ((congrArg (modSmul (𝒢.obj.obj (Opposite.op (obj_W₀V W W₀))) r) (h0 i)).trans
                  (hModSmulZero (𝒢.obj.obj (Opposite.op (obj_W₀V W W₀))) r))⟩,
              fun g m_g hm1 hm2 i =>
                (map_smul (𝒢.obj.map (Opposite.op m_g)).hom r (f i)).trans
                  ((congrArg (modSmul (𝒢.obj.obj (Opposite.op (obj_WV W))) r)
                    (heq g m_g hm1 hm2 i)).trans
                    ((hModSmulSum (𝒢.obj.obj (Opposite.op (obj_WV W))) r _).trans
                      (Finset.sum_congr rfl fun j _ =>
                        hModSmulComm (𝒢.obj.obj (Opposite.op (obj_WV W))) r
                          (ULift.up ((τ_rep g).val i j) : R) (f j))))⟩ }

    let R_sub : ∀ (ℋ : 𝒞) (W : S.Etale),
        Submodule R (Fin M → ↑(ℋ.obj.obj (Opposite.op (obj_WV W)))) :=
      fun ℋ W =>
        { carrier :=
            { f |
              ∀ (g : Γ) (m_g : Quiver.Hom (obj_WV W) (obj_WV W)),
                CategoryTheory.CategoryStruct.comp (Fgt.map m_g).left
                  (CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_V) =
                  CategoryTheory.Limits.pullback.fst (Fgt.obj W).hom ι_V →
                CategoryTheory.CategoryStruct.comp (Fgt.map m_g).left
                  (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_V) =
                  CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.Limits.pullback.snd (Fgt.obj W).hom ι_V) (act g) →
                ∀ i : Fin M,
                  (ℋ.obj.map (Opposite.op m_g)).hom (f i) =
                    Finset.univ.sum (fun j : Fin M => (ULift.up ((τ_dual g).val i j) : R) • f j) }
          zero_mem' := fun g _ _ _ i =>
            (map_zero _).trans
              (Finset.sum_eq_zero fun j _ =>
                hModSmulZero (ℋ.obj.obj (Opposite.op (obj_WV W)))
                  (ULift.up ((τ_dual g).val i j) : R)).symm
          add_mem' := fun {f₁ f₂} heq₁ heq₂ g m_g hm1 hm2 i =>
            (map_add (ℋ.obj.map (Opposite.op m_g)).hom (f₁ i) (f₂ i)).trans
              ((congrArg₂ (· + ·) (heq₁ g m_g hm1 hm2 i) (heq₂ g m_g hm1 hm2 i)).trans
                (Finset.sum_add_distrib.symm.trans
                  (Finset.sum_congr rfl fun _ _ => (smul_add _ _ _).symm)))
          smul_mem' := fun r {f} heq g m_g hm1 hm2 i =>
            (map_smul (ℋ.obj.map (Opposite.op m_g)).hom r (f i)).trans
              ((congrArg (modSmul (ℋ.obj.obj (Opposite.op (obj_WV W))) r)
                (heq g m_g hm1 hm2 i)).trans
                ((hModSmulSum (ℋ.obj.obj (Opposite.op (obj_WV W))) r _).trans
                  (Finset.sum_congr rfl fun j _ =>
                    hModSmulComm (ℋ.obj.obj (Opposite.op (obj_WV W))) r
                      (ULift.up ((τ_dual g).val i j) : R) (f j)))) }

    have hT_res_mem : ∀ (𝒢 : 𝒞) {W₁ W₂ : S.Etale} (u : Quiver.Hom W₁ W₂)
        (s : ↥(T_sub 𝒢 W₂)),
        (fun i => (𝒢.obj.map (Opposite.op (u_can u))).hom (s.1 i)) ∈ T_sub 𝒢 W₁ := by
      intro 𝒢 W₁ W₂ u s
      rcases s.2 with ⟨⟨W₀₂, hcov₂, h0₂⟩, heq₂⟩
      have hp := hIncPull 𝒢 u W₀₂ hcov₂
      refine ⟨⟨_, hp.1, fun i => hp.2 (s.1 i) (h0₂ i)⟩, fun g m_g hm1 hm2 i => ?_⟩
      have hm_eq := hm_unique m_g hm1 hm2
      exact (congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom _) hm_eq).trans
        ((hMapComp 𝒢 (m_can W₁ g) (u_can u) (s.1 i)).symm.trans
          ((congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom (s.1 i)) (hm_u_comm u g)).trans
            ((hMapComp 𝒢 (u_can u) (m_can W₂ g) (s.1 i)).trans
              ((congrArg (𝒢.obj.map (Opposite.op (u_can u))).hom
                (heq₂ g (m_can W₂ g) (hm_fst W₂ g) (hm_snd W₂ g) i)).trans
                ((map_sum _ _ _).trans (Finset.sum_congr rfl fun _ _ => map_smul _ _ _))))))

    have hR_res_mem : ∀ (ℋ : 𝒞) {W₁ W₂ : S.Etale} (u : Quiver.Hom W₁ W₂)
        (s : ↥(R_sub ℋ W₂)),
        (fun i => (ℋ.obj.map (Opposite.op (u_can u))).hom (s.1 i)) ∈ R_sub ℋ W₁ := by
      intro ℋ W₁ W₂ u s g m_g hm1 hm2 i
      have hm_eq := hm_unique m_g hm1 hm2
      exact (congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom _) hm_eq).trans
        ((hMapComp ℋ (m_can W₁ g) (u_can u) (s.1 i)).symm.trans
          ((congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom (s.1 i)) (hm_u_comm u g)).trans
            ((hMapComp ℋ (u_can u) (m_can W₂ g) (s.1 i)).trans
              ((congrArg (ℋ.obj.map (Opposite.op (u_can u))).hom
                (s.2 g (m_can W₂ g) (hm_fst W₂ g) (hm_snd W₂ g) i)).trans
                ((map_sum _ _ _).trans (Finset.sum_congr rfl fun _ _ => map_smul _ _ _))))))

    let T_pre : 𝒞 → CategoryTheory.Functor (Opposite S.Etale) (ModuleCat.{u, u} R) :=
      fun 𝒢 =>
        { obj := fun opW => ModuleCat.of R ↥(T_sub 𝒢 opW.unop)
          map := fun {opW₂ opW₁} opu => ModuleCat.ofHom
            { toFun := fun s => ⟨fun i => (𝒢.obj.map (Opposite.op (u_can opu.unop))).hom (s.1 i),
                hT_res_mem 𝒢 opu.unop s⟩
              map_add' := fun s₁ s₂ => Subtype.ext (funext fun i => map_add _ (s₁.1 i) (s₂.1 i))
              map_smul' := fun r s => Subtype.ext (funext fun i => map_smul _ r (s.1 i)) }
          map_id := fun opW => ModuleCat.hom_ext (LinearMap.ext fun s => Subtype.ext (funext fun i =>
            (congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom (s.1 i)) (hu_id opW.unop)).trans
              (hMapId 𝒢 (obj_WV opW.unop) (s.1 i))))
          map_comp := fun {opW₃ opW₂ opW₁} opu₂ opu₁ => ModuleCat.hom_ext (LinearMap.ext fun s =>
            Subtype.ext (funext fun i =>
              (congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom (s.1 i))
                (hu_comp opu₁.unop opu₂.unop)).trans
                (hMapComp 𝒢 (u_can opu₁.unop) (u_can opu₂.unop) (s.1 i)))) }

    let R_pre : 𝒞 → CategoryTheory.Functor (Opposite S.Etale) (ModuleCat.{u, u} R) :=
      fun ℋ =>
        { obj := fun opW => ModuleCat.of R ↥(R_sub ℋ opW.unop)
          map := fun {opW₂ opW₁} opu => ModuleCat.ofHom
            { toFun := fun s => ⟨fun i => (ℋ.obj.map (Opposite.op (u_can opu.unop))).hom (s.1 i),
                hR_res_mem ℋ opu.unop s⟩
              map_add' := fun s₁ s₂ => Subtype.ext (funext fun i => map_add _ (s₁.1 i) (s₂.1 i))
              map_smul' := fun r s => Subtype.ext (funext fun i => map_smul _ r (s.1 i)) }
          map_id := fun opW => ModuleCat.hom_ext (LinearMap.ext fun s => Subtype.ext (funext fun i =>
            (congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom (s.1 i)) (hu_id opW.unop)).trans
              (hMapId ℋ (obj_WV opW.unop) (s.1 i))))
          map_comp := fun {opW₃ opW₂ opW₁} opu₂ opu₁ => ModuleCat.hom_ext (LinearMap.ext fun s =>
            Subtype.ext (funext fun i =>
              (congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom (s.1 i))
                (hu_comp opu₁.unop opu₂.unop)).trans
                (hMapComp ℋ (u_can opu₁.unop) (u_can opu₂.unop) (s.1 i)))) }

    let τ_sec : ∀ (W : S.Etale) {V' : S.Etale},
        Quiver.Hom V' (obj_WV W) → Quiver.Hom V' (obj_WV V') :=
      fun W {V'} f' =>
        let hcond : CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.id (Fgt.obj V').left) (Fgt.obj V').hom =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp (Fgt.map f').left (snd₁ W)) ι_V :=
          (CategoryTheory.Category.id_comp _).trans
            (((Fgt.map f').w).symm.trans
              ((congrArg ((Fgt.map f').left ≫ ·)
                (CategoryTheory.Limits.pullback.condition (f := (Fgt.obj W).hom) (g := ι_V))).trans
                (CategoryTheory.Category.assoc _ _ _).symm))
        let τ_sch := CategoryTheory.Limits.pullback.lift
          (CategoryTheory.CategoryStruct.id (Fgt.obj V').left)
          (CategoryTheory.CategoryStruct.comp (Fgt.map f').left (snd₁ W)) hcond
        CategoryTheory.MorphismProperty.Over.homMk τ_sch
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ (Fgt.obj V').hom)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              (CategoryTheory.Category.id_comp _)))
          trivial
    have hτ_u_fac : ∀ (W : S.Etale) {V' : S.Etale} (f' : Quiver.Hom V' (obj_WV W)),
        CategoryTheory.CategoryStruct.comp (τ_sec W f')
          (u_can (CategoryTheory.CategoryStruct.comp f' (p_W W))) = f' := by
      intro W V' f'
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·) (hu_fst (f' ≫ p_W W))).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ _) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                (CategoryTheory.Category.id_comp _))))
      · exact (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·) (hu_snd (f' ≫ p_W W))).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _))
    have hτ_nat : ∀ (W : S.Etale) {Z V' : S.Etale} (h : Quiver.Hom Z V')
        (f' : Quiver.Hom V' (obj_WV W)),
        CategoryTheory.CategoryStruct.comp (τ_sec W (CategoryTheory.CategoryStruct.comp h f'))
          (u_can h) =
          CategoryTheory.CategoryStruct.comp h (τ_sec W f') := by
      intro W Z V' h f'
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·) (hu_fst h)).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ _) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                ((CategoryTheory.Category.id_comp _).trans
                  ((CategoryTheory.Category.comp_id _).symm.trans
                    ((congrArg (_ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm).trans
                      (CategoryTheory.Category.assoc _ _ _).symm))))))
      · exact (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·) (hu_snd h)).trans
            ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
              ((CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (_ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm).trans
                  (CategoryTheory.Category.assoc _ _ _).symm))))
    have hτ_ucan_p : ∀ (W : S.Etale) {V₀ : S.Etale} (g : Quiver.Hom V₀ W),
        CategoryTheory.CategoryStruct.comp (τ_sec W (u_can g)) (u_can (p_W V₀)) =
          CategoryTheory.CategoryStruct.id (obj_WV V₀) := by
      intro W V₀ g
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·) (hu_fst (p_W V₀))).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ _) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                ((CategoryTheory.Category.id_comp _).trans
                  (CategoryTheory.Category.id_comp _).symm))))
      · exact (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·) (hu_snd (p_W V₀))).trans
            ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
              ((hu_snd g).trans (CategoryTheory.Category.id_comp _).symm)))

    have hTupleExt : ∀ (ℱ : 𝒞) (W : S.Etale) (S_sieve : CategoryTheory.Sieve W),
        S_sieve ∈ J_top W →
        ∀ (x₁ x₂ : ↑(ℱ.obj.obj (Opposite.op (obj_WV W)))),
          (∀ ⦃V₀ : S.Etale⦄ (g : Quiver.Hom V₀ W), S_sieve.arrows g →
            (ℱ.obj.map (Opposite.op (u_can g))).hom x₁ =
              (ℱ.obj.map (Opposite.op (u_can g))).hom x₂) →
          x₁ = x₂ := by
      intro ℱ W S_sieve hS x₁ x₂ hx
      let S' : CategoryTheory.Sieve (obj_WV W) := CategoryTheory.Sieve.pullback (p_W W) S_sieve
      have hS' : S' ∈ J_top (obj_WV W) := J_top.pullback_stable (p_W W) hS
      obtain ⟨t, -, ht_uniq⟩ := (hSheafType ℱ) S' hS'
        (fun _ f' _ => (ℱ.obj.map (Opposite.op f')).hom x₁)
        ((CategoryTheory.Presieve.compatible_iff_sieveCompatible _).mpr fun _ _ f' h _ =>
          hMapComp ℱ h f' x₁)
      have ht1 : x₁ = t := ht_uniq x₁ fun _ _ _ => rfl
      have ht2 : x₂ = t := ht_uniq x₂ fun V' f' hf' =>
        (congrArg (fun φ => (ℱ.obj.map (Opposite.op φ)).hom x₂) (hτ_u_fac W f').symm).trans
          ((hMapComp ℱ (τ_sec W f') (u_can (f' ≫ p_W W)) x₂).trans
            ((congrArg (ℱ.obj.map (Opposite.op (τ_sec W f'))).hom (hx (f' ≫ p_W W) hf').symm).trans
              ((hMapComp ℱ (τ_sec W f') (u_can (f' ≫ p_W W)) x₁).symm.trans
                (congrArg (fun φ => (ℱ.obj.map (Opposite.op φ)).hom x₁) (hτ_u_fac W f')))))
      exact ht1.trans ht2.symm

    have hTupleGlue : ∀ (ℱ : 𝒞) (W : S.Etale) (S_sieve : CategoryTheory.Sieve W),
        S_sieve ∈ J_top W →
        ∀ (val_fam : ∀ ⦃V₀ : S.Etale⦄ (g : Quiver.Hom V₀ W),
            S_sieve.arrows g → Fin M → ↑(ℱ.obj.obj (Opposite.op (obj_WV V₀)))),
        (∀ ⦃V₁ V₂ : S.Etale⦄ (h : Quiver.Hom V₁ V₂) (g : Quiver.Hom V₂ W) (hg : S_sieve.arrows g)
            (i : Fin M),
          val_fam (CategoryTheory.CategoryStruct.comp h g) (S_sieve.downward_closed hg h) i =
            (ℱ.obj.map (Opposite.op (u_can h))).hom (val_fam g hg i)) →
        ∃! f_glued : Fin M → ↑(ℱ.obj.obj (Opposite.op (obj_WV W))),
          ∀ ⦃V₀ : S.Etale⦄ (g : Quiver.Hom V₀ W) (hg : S_sieve.arrows g) (i : Fin M),
            (ℱ.obj.map (Opposite.op (u_can g))).hom (f_glued i) = val_fam g hg i := by
      intro ℱ W S_sieve hS val_fam hval_sieve
      let S' : CategoryTheory.Sieve (obj_WV W) := CategoryTheory.Sieve.pullback (p_W W) S_sieve
      have hS' : S' ∈ J_top (obj_WV W) := J_top.pullback_stable (p_W W) hS
      let fam_i : ∀ (_ : Fin M),
          CategoryTheory.Presieve.FamilyOfElements
            (ℱ.obj ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)) S'.arrows :=
        fun i _ f' hf' =>
          (ℱ.obj.map (Opposite.op (τ_sec W f'))).hom
            (val_fam (CategoryTheory.CategoryStruct.comp f' (p_W W)) hf' i)
      have hcompat_i : ∀ i : Fin M, (fam_i i).Compatible := by
        intro i
        rw [CategoryTheory.Presieve.compatible_iff_sieveCompatible]
        intro Y Z f' h hf'
        have hf'_down : S_sieve.arrows
            (CategoryTheory.CategoryStruct.comp h (CategoryTheory.CategoryStruct.comp f' (p_W W))) :=
          S_sieve.downward_closed hf' h
        have hassoc : CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp h f')
            (p_W W) =
            CategoryTheory.CategoryStruct.comp h (CategoryTheory.CategoryStruct.comp f' (p_W W)) :=
          CategoryTheory.Category.assoc h f' (p_W W)
        have hval_eq : val_fam (CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp h f') (p_W W)) (S'.downward_closed hf' h) i =
            (ℱ.obj.map (Opposite.op (u_can h))).hom
              (val_fam (CategoryTheory.CategoryStruct.comp f' (p_W W)) hf' i) := by
          have h_irrel : ∀ (u₁ u₂ : Quiver.Hom Z W) (hu : u₁ = u₂)
              (h₁ : S_sieve.arrows u₁) (h₂ : S_sieve.arrows u₂),
              val_fam u₁ h₁ i = val_fam u₂ h₂ i := by
            intro u₁ u₂ hu h₁ h₂; subst hu; rfl
          exact (h_irrel _ _ hassoc _ hf'_down).trans (hval_sieve h (f' ≫ p_W W) hf' i)
        exact (congrArg (ℱ.obj.map (Opposite.op (τ_sec W (h ≫ f')))).hom hval_eq).trans
          ((hMapComp ℱ (τ_sec W (h ≫ f')) (u_can h) _).symm.trans
            ((congrArg (fun φ => (ℱ.obj.map (Opposite.op φ)).hom _) (hτ_nat W h f')).trans
              (hMapComp ℱ h (τ_sec W f') _)))
      let f_glued : Fin M → ↑(ℱ.obj.obj (Opposite.op (obj_WV W))) :=
        fun i => Classical.choose ((hSheafType ℱ) S' hS' (fam_i i) (hcompat_i i))
      have hf_spec : ∀ (i : Fin M) {V' : S.Etale} (f' : Quiver.Hom V' (obj_WV W))
          (hf' : S'.arrows f'),
          (ℱ.obj.map (Opposite.op f')).hom (f_glued i) = fam_i i f' hf' :=
        fun i _ f' hf' => (Classical.choose_spec ((hSheafType ℱ) S' hS' (fam_i i) (hcompat_i i))).1 f' hf'
      have hf_eval : ∀ ⦃V₀ : S.Etale⦄ (g : Quiver.Hom V₀ W) (hg : S_sieve.arrows g) (i : Fin M),
          (ℱ.obj.map (Opposite.op (u_can g))).hom (f_glued i) = val_fam g hg i := by
        intro V₀ g hg i
        have hf' : S'.arrows (u_can g) := by
          change S_sieve.arrows (CategoryTheory.CategoryStruct.comp (u_can g) (p_W W))
          exact Eq.mp (congrArg (fun φ => S_sieve.arrows φ) (hu_p g).symm)
            (S_sieve.downward_closed hg (p_W V₀))
        have h1 := hf_spec i (u_can g) hf'
        have hval_p : val_fam (CategoryTheory.CategoryStruct.comp (u_can g) (p_W W)) hf' i =
            (ℱ.obj.map (Opposite.op (u_can (p_W V₀)))).hom (val_fam g hg i) := by
          have h_irrel : ∀ (u₁ u₂ : Quiver.Hom (obj_WV V₀) W) (hu : u₁ = u₂)
              (h₁ : S_sieve.arrows u₁) (h₂ : S_sieve.arrows u₂),
              val_fam u₁ h₁ i = val_fam u₂ h₂ i := by
            intro u₁ u₂ hu h₁ h₂; subst hu; rfl
          exact (h_irrel _ _ (hu_p g) hf' (S_sieve.downward_closed hg (p_W V₀))).trans
            (hval_sieve (p_W V₀) g hg i)
        exact h1.trans
          ((congrArg (ℱ.obj.map (Opposite.op (τ_sec W (u_can g)))).hom hval_p).trans
            ((hMapComp ℱ (τ_sec W (u_can g)) (u_can (p_W V₀)) _).symm.trans
              ((congrArg (fun φ => (ℱ.obj.map (Opposite.op φ)).hom _) (hτ_ucan_p W g)).trans
                (hMapId ℱ (obj_WV V₀) _))))
      refine ⟨f_glued, hf_eval, fun f' h_f' => ?_⟩
      funext i
      exact hTupleExt ℱ W S_sieve hS (f' i) (f_glued i) fun _ g hg =>
        (h_f' g hg i).trans (hf_eval g hg i).symm

    have hLiftModSheaf : ∀ (P_pre : CategoryTheory.Functor (Opposite S.Etale) (ModuleCat.{u, u} R)),
        CategoryTheory.Presieve.IsSheaf J_top (P_pre ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)) →
        CategoryTheory.Presheaf.IsSheaf J_top P_pre := by
      intro P_pre hType E W S_sieve hS x hx
      have hFor := hType S_sieve hS
      let fam_e : ↑E → CategoryTheory.Presieve.FamilyOfElements
          (P_pre ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)) S_sieve.arrows :=
        fun e _ g hg => (x g hg).hom e
      have hx_pt : ∀ e : ↑E, (fam_e e).Compatible := by
        intro e Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
        exact congrArg (fun (φ : Quiver.Hom E _) => φ.hom e) (hx g₁ g₂ hf₁ hf₂ hcomm)
      let t_fn : ↑E → ↑(P_pre.obj (Opposite.op W)) :=
        fun e => Classical.choose (hFor (fam_e e) (hx_pt e))
      have ht_spec : ∀ (e : ↑E) {V₀ : S.Etale} (g : Quiver.Hom V₀ W) (hg : S_sieve.arrows g),
          (P_pre.map (Opposite.op g)).hom (t_fn e) = (x g hg).hom e :=
        fun e _ g hg => (Classical.choose_spec (hFor (fam_e e) (hx_pt e))).1 g hg
      have ht_uniq : ∀ (e : ↑E) (y : ↑(P_pre.obj (Opposite.op W))),
          (∀ {V₀ : S.Etale} (g : Quiver.Hom V₀ W) (hg : S_sieve.arrows g),
            (P_pre.map (Opposite.op g)).hom y = (x g hg).hom e) →
          y = t_fn e :=
        fun e y hy => (Classical.choose_spec (hFor (fam_e e) (hx_pt e))).2 y (fun _ g hg => hy g hg)
      let t_hom : Quiver.Hom E (P_pre.obj (Opposite.op W)) :=
        ModuleCat.ofHom
          { toFun := t_fn
            map_add' := fun e₁ e₂ => (ht_uniq (e₁ + e₂) (t_fn e₁ + t_fn e₂) fun g hg =>
              (map_add _ _ _).trans
                ((congrArg₂ (· + ·) (ht_spec e₁ g hg) (ht_spec e₂ g hg)).trans
                  (map_add _ _ _).symm)).symm
            map_smul' := fun r e => (ht_uniq (r • e) (r • t_fn e) fun g hg =>
              (map_smul _ _ _).trans
                ((congrArg (r • ·) (ht_spec e g hg)).trans
                  (map_smul _ _ _).symm)).symm }
      exact ⟨t_hom, fun _ g hg => ModuleCat.hom_ext (LinearMap.ext fun e => ht_spec e g hg),
        fun y_hom hy => ModuleCat.hom_ext (LinearMap.ext fun e =>
          ht_uniq e (y_hom.hom e) fun g hg =>
            congrArg (fun (φ : Quiver.Hom E _) => φ.hom e) (hy g hg))⟩

    have hR_sheaf : ∀ ℋ : 𝒞, CategoryTheory.Presheaf.IsSheaf J_top (R_pre ℋ) := by
      intro ℋ
      apply hLiftModSheaf (R_pre ℋ)
      intro W S_sieve hS fam hcompat
      have hsieve := (CategoryTheory.Presieve.compatible_iff_sieveCompatible fam).mp hcompat
      let val_fam : ∀ ⦃V₀ : S.Etale⦄ (g : Quiver.Hom V₀ W),
          S_sieve.arrows g → Fin M → ↑(ℋ.obj.obj (Opposite.op (obj_WV V₀))) :=
        fun _ g hg => (fam g hg : ↥(R_sub ℋ _)).1
      obtain ⟨f_glued, hf_spec, hf_uniq⟩ := hTupleGlue ℋ W S_sieve hS val_fam
        (fun V₁ V₂ h g hg i => congrArg (fun (s : ↥(R_sub ℋ V₁)) => s.1 i) (hsieve g h hg))
      have hf_mem : f_glued ∈ R_sub ℋ W := by
        intro γ m_g hm1 hm2 i
        have hm_eq := hm_unique m_g hm1 hm2
        refine (congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom (f_glued i)) hm_eq).trans ?_
        apply hTupleExt ℋ W S_sieve hS
        intro V₀ g hg
        have hlhs : (ℋ.obj.map (Opposite.op (u_can g))).hom
            ((ℋ.obj.map (Opposite.op (m_can W γ))).hom (f_glued i)) =
            Finset.univ.sum (fun j : Fin M =>
              (ULift.up ((τ_dual γ).val i j) : R) • val_fam g hg j) :=
          (hMapComp ℋ (u_can g) (m_can W γ) (f_glued i)).symm.trans
            ((congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom (f_glued i))
              (hm_u_comm g γ).symm).trans
              ((hMapComp ℋ (m_can V₀ γ) (u_can g) (f_glued i)).trans
                ((congrArg (ℋ.obj.map (Opposite.op (m_can V₀ γ))).hom (hf_spec g hg i)).trans
                  ((fam g hg : ↥(R_sub ℋ V₀)).2 γ (m_can V₀ γ)
                    (hm_fst V₀ γ) (hm_snd V₀ γ) i))))
        have hrhs : (ℋ.obj.map (Opposite.op (u_can g))).hom
            (Finset.univ.sum (fun j : Fin M =>
              (ULift.up ((τ_dual γ).val i j) : R) • f_glued j)) =
            Finset.univ.sum (fun j : Fin M =>
              (ULift.up ((τ_dual γ).val i j) : R) • val_fam g hg j) :=
          (map_sum _ _ _).trans
            (Finset.sum_congr rfl fun j _ =>
              (map_smul _ _ _).trans (congrArg _ (hf_spec g hg j)))
        exact hlhs.trans hrhs.symm
      refine ⟨(⟨f_glued, hf_mem⟩ : ↥(R_sub ℋ W)),
        fun V₀ g hg => Subtype.ext (funext fun i => hf_spec g hg i),
        fun t ht => Subtype.ext (hf_uniq t.1 fun V₀ g hg i =>
          congrArg (fun (s : ↥(R_sub ℋ V₀)) => s.1 i) (ht g hg))⟩

    have hT_sheaf : ∀ 𝒢 : 𝒞, CategoryTheory.Presheaf.IsSheaf J_top (T_pre 𝒢) := by
      intro 𝒢
      apply hLiftModSheaf (T_pre 𝒢)
      intro W S_sieve hS fam hcompat
      have hsieve := (CategoryTheory.Presieve.compatible_iff_sieveCompatible fam).mp hcompat
      let val_fam : ∀ ⦃V₀ : S.Etale⦄ (g : Quiver.Hom V₀ W),
          S_sieve.arrows g → Fin M → ↑(𝒢.obj.obj (Opposite.op (obj_WV V₀))) :=
        fun _ g hg => (fam g hg : ↥(T_sub 𝒢 _)).1
      obtain ⟨f_glued, hf_spec, hf_uniq⟩ := hTupleGlue 𝒢 W S_sieve hS val_fam
        (fun V₁ V₂ h g hg i => congrArg (fun (s : ↥(T_sub 𝒢 V₁)) => s.1 i) (hsieve g h hg))
      have hf_eqv : ∀ (γ : Γ) (m_g : Quiver.Hom (obj_WV W) (obj_WV W)),
          CategoryTheory.CategoryStruct.comp (Fgt.map m_g).left (fst₁ W) = fst₁ W →
          CategoryTheory.CategoryStruct.comp (Fgt.map m_g).left (snd₁ W) =
            CategoryTheory.CategoryStruct.comp (snd₁ W) (act γ) →
          ∀ i : Fin M,
            (𝒢.obj.map (Opposite.op m_g)).hom (f_glued i) =
              Finset.univ.sum (fun j : Fin M => (ULift.up ((τ_rep γ).val i j) : R) • f_glued j) := by
        intro γ m_g hm1 hm2 i
        have hm_eq := hm_unique m_g hm1 hm2
        refine (congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom (f_glued i)) hm_eq).trans ?_
        apply hTupleExt 𝒢 W S_sieve hS
        intro V₀ g hg
        have hlhs : (𝒢.obj.map (Opposite.op (u_can g))).hom
            ((𝒢.obj.map (Opposite.op (m_can W γ))).hom (f_glued i)) =
            Finset.univ.sum (fun j : Fin M =>
              (ULift.up ((τ_rep γ).val i j) : R) • val_fam g hg j) :=
          (hMapComp 𝒢 (u_can g) (m_can W γ) (f_glued i)).symm.trans
            ((congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom (f_glued i))
              (hm_u_comm g γ).symm).trans
              ((hMapComp 𝒢 (m_can V₀ γ) (u_can g) (f_glued i)).trans
                ((congrArg (𝒢.obj.map (Opposite.op (m_can V₀ γ))).hom (hf_spec g hg i)).trans
                  ((fam g hg : ↥(T_sub 𝒢 V₀)).2.2 γ (m_can V₀ γ)
                    (hm_fst V₀ γ) (hm_snd V₀ γ) i))))
        have hrhs : (𝒢.obj.map (Opposite.op (u_can g))).hom
            (Finset.univ.sum (fun j : Fin M =>
              (ULift.up ((τ_rep γ).val i j) : R) • f_glued j)) =
            Finset.univ.sum (fun j : Fin M =>
              (ULift.up ((τ_rep γ).val i j) : R) • val_fam g hg j) :=
          (map_sum _ _ _).trans
            (Finset.sum_congr rfl fun j _ =>
              (map_smul _ _ _).trans (congrArg _ (hf_spec g hg j)))
        exact hlhs.trans hrhs.symm
      have hf_col : ∃ W₀ : (Fgt.obj W).left.Opens,
          ((TopologicalSpace.Opens.map (Fgt.obj W).hom.base).obj U) ⊔ W₀ = ⊤ ∧
          ∀ i : Fin M, (𝒢.obj.map (Opposite.op (inc_W₀ W W₀))).hom (f_glued i) = 0 := by
        have hSurj := (hJ_mem W S_sieve).mp hS
        let V_x : ↥W.left → S.Etale := fun x => Classical.choose (hSurj x)
        let g_x : ∀ x : ↥W.left, Quiver.Hom (V_x x) W :=
          fun x => Classical.choose (Classical.choose_spec (hSurj x))
        let y_x : ∀ x : ↥W.left, ↥(V_x x).left :=
          fun x => Classical.choose (Classical.choose_spec (Classical.choose_spec (hSurj x)))
        have hg_x : ∀ x : ↥W.left, S_sieve.arrows (g_x x) :=
          fun x => (Classical.choose_spec (Classical.choose_spec
            (Classical.choose_spec (hSurj x)))).1
        have hy_x : ∀ x : ↥W.left, (g_x x).left.base (y_x x) = x :=
          fun x => (Classical.choose_spec (Classical.choose_spec
            (Classical.choose_spec (hSurj x)))).2.2
        let W₀_x : ∀ x : ↥W.left, (Fgt.obj (V_x x)).left.Opens :=
          fun x => Classical.choose ((fam (g_x x) (hg_x x) : ↥(T_sub 𝒢 (V_x x))).2.1)
        have hcov_x : ∀ x : ↥W.left,
            ((TopologicalSpace.Opens.map (Fgt.obj (V_x x)).hom.base).obj U) ⊔ W₀_x x = ⊤ :=
          fun x => (Classical.choose_spec ((fam (g_x x) (hg_x x) : ↥(T_sub 𝒢 (V_x x))).2.1)).1
        have h0_x : ∀ (x : ↥W.left) (i : Fin M),
            (𝒢.obj.map (Opposite.op (inc_W₀ (V_x x) (W₀_x x)))).hom
              (val_fam (g_x x) (hg_x x) i) = 0 :=
          fun x => (Classical.choose_spec ((fam (g_x x) (hg_x x) : ↥(T_sub 𝒢 (V_x x))).2.1)).2
        let O_x : ↥W.left → (Fgt.obj W).left.Opens := fun x =>
          letI : AlgebraicGeometry.Etale (g_x x).left := hEtale_left (g_x x)
          ⟨⇑(g_x x).left.base '' (W₀_x x).carrier,
            (g_x x).left.isOpenMap _ (W₀_x x).2⟩
        let W₀ : (Fgt.obj W).left.Opens := ⨆ x : ↥W.left, O_x x
        refine ⟨W₀, ?_, fun i => ?_⟩
        · rw [eq_top_iff]
          intro x _
          have hy_top : y_x x ∈
              (((TopologicalSpace.Opens.map (Fgt.obj (V_x x)).hom.base).obj U) ⊔ W₀_x x :
                (Fgt.obj (V_x x)).left.Opens) := by
            rw [hcov_x x]; trivial
          rcases hy_top with hU_x | hW_x
          · left
            have hw : ((g_x x).left ≫ (Fgt.obj W).hom).base (y_x x) =
                (Fgt.obj (V_x x)).hom.base (y_x x) :=
              congrArg (fun φ => φ.base (y_x x)) (Fgt.map (g_x x)).w
            change (Fgt.obj W).hom.base x ∈ U
            exact hy_x x ▸ (hw.symm ▸ hU_x)
          · right
            exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, ⟨y_x x, hW_x, hy_x x⟩⟩
        · have hsub_x : ∀ x : ↥W.left,
              Set.range
                (CategoryTheory.CategoryStruct.comp (W₀_V_op (V_x x) (W₀_x x)).ι
                  (Fgt.map (u_can (g_x x))).left).base ⊆
                Set.range (W₀_V_op W W₀).ι.base := by
            intro x
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            rintro _ ⟨w, rfl⟩
            have hw : (W₀_V_op (V_x x) (W₀_x x)).ι.base w ∈
                Set.range (W₀_V_op (V_x x) (W₀_x x)).ι.base := ⟨w, rfl⟩
            rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hw
            have hfst_eq := congrArg
              (fun φ => φ.base ((W₀_V_op (V_x x) (W₀_x x)).ι.base w)) (hu_fst (g_x x))
            have hin_W0 : ((fst₁ (V_x x) ≫ (Fgt.map (g_x x)).left).base
                ((W₀_V_op (V_x x) (W₀_x x)).ι.base w)) ∈ W₀ :=
              TopologicalSpace.Opens.mem_iSup.mpr
                ⟨x, ⟨(fst₁ (V_x x)).base ((W₀_V_op (V_x x) (W₀_x x)).ι.base w), hw, rfl⟩⟩
            change ((Fgt.map (u_can (g_x x))).left ≫ fst₁ W).base
              ((W₀_V_op (V_x x) (W₀_x x)).ι.base w) ∈ W₀
            exact Eq.mp (congrArg (fun p => p ∈ W₀) hfst_eq.symm) hin_W0
          let ψ_x : ∀ x : ↥W.left, Quiver.Hom (obj_W₀V (V_x x) (W₀_x x)) (obj_W₀V W W₀) :=
            fun x =>
              let l_sch := AlgebraicGeometry.IsOpenImmersion.lift (W₀_V_op W W₀).ι
                (CategoryTheory.CategoryStruct.comp (W₀_V_op (V_x x) (W₀_x x)).ι
                  (Fgt.map (u_can (g_x x))).left) (hsub_x x)
              CategoryTheory.MorphismProperty.Over.homMk l_sch
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ (Fgt.obj (obj_WV W)).hom)
                    (AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ (hsub_x x))).trans
                    ((CategoryTheory.Category.assoc _ _ _).trans
                      (congrArg ((W₀_V_op (V_x x) (W₀_x x)).ι ≫ ·)
                        (Fgt.map (u_can (g_x x))).w))))
                trivial
          have hψ_fac : ∀ x : ↥W.left,
              CategoryTheory.CategoryStruct.comp (ψ_x x) (inc_W₀ W W₀) =
                CategoryTheory.CategoryStruct.comp (inc_W₀ (V_x x) (W₀_x x)) (u_can (g_x x)) :=
            fun x => CategoryTheory.MorphismProperty.Over.Hom.ext
              (AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ (hsub_x x))
          have hψ_cov : ∀ z : ↥(obj_W₀V W W₀).left,
              ∃ x : ↥W.left, z ∈ Set.range ⇑(ψ_x x).left.base := by
            intro z
            let y : ↥(Fgt.obj (obj_WV W)).left := (W₀_V_op W W₀).ι.base z
            have hy_mem : y ∈ Set.range (W₀_V_op W W₀).ι.base := ⟨z, rfl⟩
            rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hy_mem
            change (fst₁ W).base y ∈ W₀ at hy_mem
            obtain ⟨x, w, hw_in, hwx⟩ := TopologicalSpace.Opens.mem_iSup.mp hy_mem
            have h_right : CategoryTheory.IsPullback (snd₁ W) (fst₁ W) ι_V (Fgt.obj W).hom :=
              (CategoryTheory.IsPullback.of_hasPullback (Fgt.obj W).hom ι_V).flip
            have h_outer : CategoryTheory.IsPullback
                (CategoryTheory.CategoryStruct.comp (Fgt.map (u_can (g_x x))).left (snd₁ W))
                (fst₁ (V_x x)) ι_V
                (CategoryTheory.CategoryStruct.comp (Fgt.map (g_x x)).left (Fgt.obj W).hom) := by
              rw [hu_snd (g_x x), (Fgt.map (g_x x)).w]
              exact (CategoryTheory.IsPullback.of_hasPullback (Fgt.obj (V_x x)).hom ι_V).flip
            have hpb_x : CategoryTheory.IsPullback
                (Fgt.map (u_can (g_x x))).left (fst₁ (V_x x))
                (fst₁ W) (Fgt.map (g_x x)).left :=
              CategoryTheory.IsPullback.of_right h_outer (hu_fst (g_x x)) h_right
            obtain ⟨p, hp₁, hp₂⟩ :=
              AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y w hwx.symm
            let y' := hpb_x.isoPullback.inv.base p
            have hy'_fst : (fst₁ (V_x x)).base y' = w :=
              (congrArg (fun φ => φ.base p) hpb_x.isoPullback_inv_snd).trans hp₂
            have hy'_u : ((Fgt.map (u_can (g_x x))).left).base y' = y :=
              (congrArg (fun φ => φ.base p) hpb_x.isoPullback_inv_fst).trans hp₁
            have hy'_in : y' ∈ Set.range (W₀_V_op (V_x x) (W₀_x x)).ι.base := by
              rw [AlgebraicGeometry.Scheme.Opens.range_ι]
              change (fst₁ (V_x x)).base y' ∈ W₀_x x
              exact Eq.mp (congrArg (fun p => p ∈ W₀_x x) hy'_fst.symm) hw_in
            obtain ⟨z', hz'⟩ := hy'_in
            refine ⟨x, z', ?_⟩
            have hinj : Function.Injective ⇑(W₀_V_op W W₀).ι.base :=
              ((AlgebraicGeometry.IsOpenImmersion.iff_isIso_stalkMap.mp
                (inferInstance : AlgebraicGeometry.IsOpenImmersion (W₀_V_op W W₀).ι)).1).injective
            apply hinj
            have hfac_z' := congrArg (fun φ => φ.base z')
              (AlgebraicGeometry.IsOpenImmersion.lift_fac (W₀_V_op W W₀).ι
                (CategoryTheory.CategoryStruct.comp (W₀_V_op (V_x x) (W₀_x x)).ι
                  (Fgt.map (u_can (g_x x))).left) (hsub_x x))
            exact hfac_z'.trans ((congrArg ((Fgt.map (u_can (g_x x))).left).base hz').trans hy'_u)
          obtain ⟨t₀, -, ht₀_uniq⟩ := hSheafArrows 𝒢 (obj_W₀V W W₀)
            (fun x => obj_W₀V (V_x x) (W₀_x x)) ψ_x hψ_cov
            (fun _ => 0) (fun _ _ _ _ _ _ => (map_zero _).trans (map_zero _).symm)
          have ht_lhs : (𝒢.obj.map (Opposite.op (inc_W₀ W W₀))).hom (f_glued i) = t₀ :=
            ht₀_uniq _ fun x =>
              (hMapComp 𝒢 (ψ_x x) (inc_W₀ W W₀) (f_glued i)).symm.trans
                ((congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom (f_glued i)) (hψ_fac x)).trans
                  ((hMapComp 𝒢 (inc_W₀ (V_x x) (W₀_x x)) (u_can (g_x x)) (f_glued i)).trans
                    ((congrArg (𝒢.obj.map (Opposite.op (inc_W₀ (V_x x) (W₀_x x)))).hom
                      (hf_spec (g_x x) (hg_x x) i)).trans (h0_x x i))))
          have ht_rhs : (0 : ↑(𝒢.obj.obj (Opposite.op (obj_W₀V W W₀)))) = t₀ :=
            ht₀_uniq 0 fun _ => map_zero _
          exact ht_lhs.trans ht_rhs.symm
      refine ⟨(⟨f_glued, hf_col, hf_eqv⟩ : ↥(T_sub 𝒢 W)),
        fun V₀ g hg => Subtype.ext (funext fun i => hf_spec g hg i),
        fun t ht => Subtype.ext (hf_uniq t.1 fun V₀ g hg i =>
          congrArg (fun (s : ↥(T_sub 𝒢 V₀)) => s.1 i) (ht g hg))⟩

    have hT_map_mem : ∀ {𝒢₁ 𝒢₂ : 𝒞} (φ : Quiver.Hom 𝒢₁ 𝒢₂) (W : S.Etale)
        (s : ↥(T_sub 𝒢₁ W)),
        (fun i => (φ.hom.app (Opposite.op (obj_WV W))).hom (s.1 i)) ∈ T_sub 𝒢₂ W := by
      intro 𝒢₁ 𝒢₂ φ W s
      rcases s.2 with ⟨⟨W₀, hcov, h0⟩, heq⟩
      refine ⟨⟨W₀, hcov, fun i => ?_⟩, fun g m_g hm1 hm2 i => ?_⟩
      · have hnat := congrArg
          (fun (τ : Quiver.Hom (𝒢₁.obj.obj (Opposite.op (obj_WV W)))
            (𝒢₂.obj.obj (Opposite.op (obj_W₀V W W₀)))) => τ.hom (s.1 i))
          (φ.hom.naturality (Opposite.op (inc_W₀ W W₀)))
        exact hnat.symm.trans
          ((congrArg (φ.hom.app (Opposite.op (obj_W₀V W W₀))).hom (h0 i)).trans
            (map_zero (φ.hom.app (Opposite.op (obj_W₀V W W₀))).hom))
      · have hnat := congrArg
          (fun (τ : Quiver.Hom (𝒢₁.obj.obj (Opposite.op (obj_WV W)))
            (𝒢₂.obj.obj (Opposite.op (obj_WV W)))) => τ.hom (s.1 i))
          (φ.hom.naturality (Opposite.op m_g))
        exact hnat.symm.trans
          ((congrArg (φ.hom.app (Opposite.op (obj_WV W))).hom (heq g m_g hm1 hm2 i)).trans
            ((map_sum _ _ _).trans (Finset.sum_congr rfl fun _ _ => map_smul _ _ _)))

    have hR_map_mem : ∀ {ℋ₁ ℋ₂ : 𝒞} (φ : Quiver.Hom ℋ₁ ℋ₂) (W : S.Etale)
        (s : ↥(R_sub ℋ₁ W)),
        (fun i => (φ.hom.app (Opposite.op (obj_WV W))).hom (s.1 i)) ∈ R_sub ℋ₂ W := by
      intro ℋ₁ ℋ₂ φ W s g m_g hm1 hm2 i
      have hnat := congrArg
        (fun (τ : Quiver.Hom (ℋ₁.obj.obj (Opposite.op (obj_WV W)))
          (ℋ₂.obj.obj (Opposite.op (obj_WV W)))) => τ.hom (s.1 i))
        (φ.hom.naturality (Opposite.op m_g))
      exact hnat.symm.trans
        ((congrArg (φ.hom.app (Opposite.op (obj_WV W))).hom (s.2 g m_g hm1 hm2 i)).trans
          ((map_sum _ _ _).trans (Finset.sum_congr rfl fun _ _ => map_smul _ _ _)))

    let T_sh : CategoryTheory.Functor 𝒞 𝒞 :=
      { obj := fun 𝒢 => ⟨T_pre 𝒢, hT_sheaf 𝒢⟩
        map := fun {𝒢₁ 𝒢₂} φ =>
          { hom :=
              { app := fun opW => ModuleCat.ofHom
                  { toFun := fun s => ⟨fun i => (φ.hom.app (Opposite.op (obj_WV opW.unop))).hom (s.1 i),
                      hT_map_mem φ opW.unop s⟩
                    map_add' := fun s₁ s₂ => Subtype.ext (funext fun i => map_add _ (s₁.1 i) (s₂.1 i))
                    map_smul' := fun r s => Subtype.ext (funext fun i => map_smul _ r (s.1 i)) }
                naturality := fun {opW₂ opW₁} opu => by
                  apply ModuleCat.hom_ext; apply LinearMap.ext; intro s; apply Subtype.ext; funext i
                  exact congrArg
                    (fun (τ : Quiver.Hom (𝒢₁.obj.obj (Opposite.op (obj_WV opW₂.unop)))
                      (𝒢₂.obj.obj (Opposite.op (obj_WV opW₁.unop)))) => τ.hom (s.1 i))
                    (φ.hom.naturality (Opposite.op (u_can opu.unop))) } }
        map_id := fun _ => by
          apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext _
          apply ModuleCat.hom_ext; apply LinearMap.ext; intro _; apply Subtype.ext; funext _; rfl
        map_comp := fun _ _ => by
          apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext _
          apply ModuleCat.hom_ext; apply LinearMap.ext; intro _; apply Subtype.ext; funext _; rfl }

    let R_sh : CategoryTheory.Functor 𝒞 𝒞 :=
      { obj := fun ℋ => ⟨R_pre ℋ, hR_sheaf ℋ⟩
        map := fun {ℋ₁ ℋ₂} φ =>
          { hom :=
              { app := fun opW => ModuleCat.ofHom
                  { toFun := fun s => ⟨fun i => (φ.hom.app (Opposite.op (obj_WV opW.unop))).hom (s.1 i),
                      hR_map_mem φ opW.unop s⟩
                    map_add' := fun s₁ s₂ => Subtype.ext (funext fun i => map_add _ (s₁.1 i) (s₂.1 i))
                    map_smul' := fun r s => Subtype.ext (funext fun i => map_smul _ r (s.1 i)) }
                naturality := fun {opW₂ opW₁} opu => by
                  apply ModuleCat.hom_ext; apply LinearMap.ext; intro s; apply Subtype.ext; funext i
                  exact congrArg
                    (fun (τ : Quiver.Hom (ℋ₁.obj.obj (Opposite.op (obj_WV opW₂.unop)))
                      (ℋ₂.obj.obj (Opposite.op (obj_WV opW₁.unop)))) => τ.hom (s.1 i))
                    (φ.hom.naturality (Opposite.op (u_can opu.unop))) } }
        map_id := fun _ => by
          apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext _
          apply ModuleCat.hom_ext; apply LinearMap.ext; intro _; apply Subtype.ext; funext _; rfl
        map_comp := fun _ _ => by
          apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext _
          apply ModuleCat.hom_ext; apply LinearMap.ext; intro _; apply Subtype.ext; funext _; rfl }

    let triv_T : ∀ (𝒢 : 𝒞) (W : S.Etale),
        ↑((T_sh.obj 𝒢).obj.obj (Opposite.op W)) →ₗ[R]
          (Fin M → ↑(𝒢.obj.obj (Opposite.op (obj_WV W)))) :=
      fun 𝒢 W => (T_sub 𝒢 W).subtype
    let triv_R : ∀ (ℋ : 𝒞) (W : S.Etale),
        ↑((R_sh.obj ℋ).obj.obj (Opposite.op W)) →ₗ[R]
          (Fin M → ↑(ℋ.obj.obj (Opposite.op (obj_WV W)))) :=
      fun ℋ W => (R_sub ℋ W).subtype

    let u_ij : ∀ (𝒢 : 𝒞) (W : S.Etale),
        ↑(𝒢.obj.obj (Opposite.op W)) → Fin M → Fin M →
          ↑(𝒢.obj.obj (Opposite.op (obj_WV (obj_WV W)))) :=
      fun 𝒢 W x i j =>
        Classical.choose (hSheetGlue 𝒢 W fun g =>
          (ULift.up ((τ_rep g).val j i) : R) • (𝒢.obj.map (Opposite.op (p_W W))).hom x)
    have hu_ij_spec : ∀ (𝒢 : 𝒞) (W : S.Etale) (x : ↑(𝒢.obj.obj (Opposite.op W)))
        (i j : Fin M) (g : Γ),
        (𝒢.obj.map (Opposite.op (σ_g W g))).hom (u_ij 𝒢 W x i j) =
          (ULift.up ((τ_rep g).val j i) : R) • (𝒢.obj.map (Opposite.op (p_W W))).hom x :=
      fun 𝒢 W x i j => (Classical.choose_spec (hSheetGlue 𝒢 W fun g =>
        (ULift.up ((τ_rep g).val j i) : R) • (𝒢.obj.map (Opposite.op (p_W W))).hom x)).1
    have hu_ij_uniq : ∀ (𝒢 : 𝒞) (W : S.Etale) (x : ↑(𝒢.obj.obj (Opposite.op W)))
        (i j : Fin M) (t : ↑(𝒢.obj.obj (Opposite.op (obj_WV (obj_WV W))))),
        (∀ g : Γ, (𝒢.obj.map (Opposite.op (σ_g W g))).hom t =
          (ULift.up ((τ_rep g).val j i) : R) • (𝒢.obj.map (Opposite.op (p_W W))).hom x) →
        t = u_ij 𝒢 W x i j :=
      fun 𝒢 W x i j => (Classical.choose_spec (hSheetGlue 𝒢 W fun g =>
        (ULift.up ((τ_rep g).val j i) : R) • (𝒢.obj.map (Opposite.op (p_W W))).hom x)).2
    have hu_i_mem_T : ∀ (𝒢 : 𝒞) (W : S.Etale) (x : ↑(𝒢.obj.obj (Opposite.op W))) (i : Fin M),
        (fun j => u_ij 𝒢 W x i j) ∈ T_sub 𝒢 (obj_WV W) := by
      intro 𝒢 W x i
      refine ⟨⟨⊥, ?_, fun j => ?_⟩, fun h m_h hm1 hm2 j => ?_⟩
      · rw [sup_bot_eq, eq_top_iff]
        intro y _
        have hy : ((snd₁ W ≫ π) ≫ U.ι).base y = (Fgt.obj (obj_WV W)).hom.base y :=
          congrArg (fun φ => φ.base y)
            (CategoryTheory.Limits.pullback.condition (f := (Fgt.obj W).hom) (g := ι_V)).symm
        have hmem_U : ((snd₁ W ≫ π) ≫ U.ι).base y ∈ (U : Set ↥S) := by
          rw [← AlgebraicGeometry.Scheme.Opens.range_ι U]
          exact ⟨(snd₁ W ≫ π).base y, rfl⟩
        change (Fgt.obj (obj_WV W)).hom.base y ∈ (U : Set ↥S)
        exact Eq.mp (congrArg (fun p => p ∈ (U : Set ↥S)) hy) hmem_U
      · exact @Subsingleton.elim _
          (hEmptySub 𝒢 _ ⟨fun z => by
            have hz : (fst₁ (obj_WV W)).base z.1 ∈ (⊥ : ((Fgt.obj (obj_WV W)).left).Opens) := z.2
            exact hz⟩) _ _
      · have hm_eq := hm_unique m_h hm1 hm2
        obtain ⟨_, -, ht_u⟩ := hSheetGlue 𝒢 W
          (fun g => (ULift.up ((τ_rep (h * g)).val j i) : R) •
            (𝒢.obj.map (Opposite.op (p_W W))).hom x)
        have ht_lhs : (𝒢.obj.map (Opposite.op (m_can (obj_WV W) h))).hom (u_ij 𝒢 W x i j) = _ :=
          ht_u _ fun g =>
            (hMapComp 𝒢 (σ_g W g) (m_can (obj_WV W) h) _).symm.trans
              ((congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom _) (hσ_inner W g h)).trans
                (hu_ij_spec 𝒢 W x i j (h * g)))
        have ht_rhs : Finset.univ.sum (fun k : Fin M =>
            (ULift.up ((τ_rep h).val j k) : R) • u_ij 𝒢 W x i k) = _ :=
          ht_u _ fun g =>
            have hsum : Finset.univ.sum (fun k : Fin M =>
                (𝒢.obj.map (Opposite.op (σ_g W g))).hom
                  ((ULift.up ((τ_rep h).val j k) : R) • u_ij 𝒢 W x i k)) =
                Finset.univ.sum (fun k : Fin M =>
                  (ULift.up ((τ_rep h).val j k * (τ_rep g).val k i) : R) •
                    (𝒢.obj.map (Opposite.op (p_W W))).hom x) :=
              Finset.sum_congr rfl fun k _ =>
                (map_smul _ _ _).trans
                  ((congrArg _ (hu_ij_spec 𝒢 W x i k g)).trans (mul_smul _ _ _).symm)
            have hmul : Finset.univ.sum (fun k : Fin M =>
                (ULift.up ((τ_rep h).val j k * (τ_rep g).val k i) : R)) =
                ULift.up ((τ_rep (h * g)).val j i) :=
              ULift.ext _ _ ((hdown_sum Finset.univ _).trans
                ((Matrix.mul_apply.symm).trans
                  (congrArg (fun M_mat => M_mat j i)
                    ((Units.val_mul _ _).symm.trans (congrArg Units.val (map_mul τ_rep h g).symm)))))
            (map_sum _ _ _).trans
              (hsum.trans ((Finset.sum_smul.symm).trans (congrArg (· • _) hmul)))
        exact (congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom _) hm_eq).trans
          (ht_lhs.trans ht_rhs.symm)

    let u_i : ∀ (𝒢 : 𝒞) (W : S.Etale),
        ↑(𝒢.obj.obj (Opposite.op W)) → Fin M →
          ↑((T_sh.obj 𝒢).obj.obj (Opposite.op (obj_WV W))) :=
      fun 𝒢 W x i => ⟨fun j => u_ij 𝒢 W x i j, hu_i_mem_T 𝒢 W x i⟩
    have hu_mem_R : ∀ (𝒢 : 𝒞) (W : S.Etale) (x : ↑(𝒢.obj.obj (Opposite.op W))),
        u_i 𝒢 W x ∈ R_sub (T_sh.obj 𝒢) W := by
      intro 𝒢 W x h m_h hm1 hm2 i
      have hm_eq := hm_unique m_h hm1 hm2
      refine (congrArg (fun φ => ((T_sh.obj 𝒢).obj.map (Opposite.op φ)).hom (u_i 𝒢 W x i)) hm_eq).trans ?_
      apply Subtype.ext; funext j
      have hsum_coe : (Finset.univ.sum (fun l : Fin M =>
          (ULift.up ((τ_dual h).val i l) : R) • u_i 𝒢 W x l)).1 j =
          Finset.univ.sum (fun l : Fin M =>
            (ULift.up ((τ_dual h).val i l) : R) • u_ij 𝒢 W x l j) := by
        change (Finset.univ.sum (fun l : Fin M =>
          (ULift.up ((τ_dual h).val i l) : R) •
            (u_i 𝒢 W x l : ↥(T_sub 𝒢 (obj_WV W))))).1 j = _
        rw [Submodule.coe_sum]
        simp only [Finset.sum_apply]
        rfl
      obtain ⟨_, -, ht_u⟩ := hSheetGlue 𝒢 W
        (fun g => (ULift.up ((τ_rep (g * h⁻¹)).val j i) : R) •
          (𝒢.obj.map (Opposite.op (p_W W))).hom x)
      have ht_lhs : (𝒢.obj.map (Opposite.op (u_can (m_can W h)))).hom (u_ij 𝒢 W x i j) = _ :=
        ht_u _ fun g =>
          (hMapComp 𝒢 (σ_g W g) (u_can (m_can W h)) _).symm.trans
            ((congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom _) (hσ_outer W g h)).trans
              ((hMapComp 𝒢 (m_can W h) (σ_g W (g * h⁻¹)) _).trans
                ((congrArg (𝒢.obj.map (Opposite.op (m_can W h))).hom
                  (hu_ij_spec 𝒢 W x i j (g * h⁻¹))).trans
                  ((map_smul _ _ _).trans
                    (congrArg _
                      ((hMapComp 𝒢 (m_can W h) (p_W W) x).symm.trans
                        (congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom x) (hm_p W h))))))))
      have ht_rhs : Finset.univ.sum (fun l : Fin M =>
          (ULift.up ((τ_dual h).val i l) : R) • u_ij 𝒢 W x l j) = _ :=
        ht_u _ fun g =>
          have hsum : Finset.univ.sum (fun l : Fin M =>
              (𝒢.obj.map (Opposite.op (σ_g W g))).hom
                ((ULift.up ((τ_dual h).val i l) : R) • u_ij 𝒢 W x l j)) =
              Finset.univ.sum (fun l : Fin M =>
                (ULift.up ((τ_rep g).val j l * (τ_rep h⁻¹).val l i) : R) •
                  (𝒢.obj.map (Opposite.op (p_W W))).hom x) :=
            Finset.sum_congr rfl fun l _ =>
              have hscalar : (ULift.up ((τ_dual h).val i l) : R) *
                  ULift.up ((τ_rep g).val j l) =
                  ULift.up ((τ_rep g).val j l * (τ_rep h⁻¹).val l i) := by
                apply ULift.ext
                change (τ_dual h).val i l * (τ_rep g).val j l =
                  (τ_rep g).val j l * (τ_rep h⁻¹).val l i
                rw [h_dual h, Matrix.transpose_apply, map_inv, mul_comm]
              (map_smul _ _ _).trans
                ((congrArg _ (hu_ij_spec 𝒢 W x l j g)).trans
                  ((mul_smul _ _ _).symm.trans (congrArg (· • _) hscalar)))
          have hmul : Finset.univ.sum (fun l : Fin M =>
              (ULift.up ((τ_rep g).val j l * (τ_rep h⁻¹).val l i) : R)) =
              ULift.up ((τ_rep (g * h⁻¹)).val j i) :=
            ULift.ext _ _ ((hdown_sum Finset.univ _).trans
              ((Matrix.mul_apply.symm).trans
                (congrArg (fun M_mat => M_mat j i)
                  ((Units.val_mul _ _).symm.trans
                    (congrArg Units.val (map_mul τ_rep g h⁻¹).symm)))))
          (map_sum _ _ _).trans
            (hsum.trans ((Finset.sum_smul.symm).trans (congrArg (· • _) hmul)))
      exact ht_lhs.trans (ht_rhs.symm.trans hsum_coe.symm)

    let η_adj : CategoryTheory.NatTrans (CategoryTheory.Functor.id 𝒞) (T_sh ⋙ R_sh) :=
      { app := fun 𝒢 =>
          { hom :=
              { app := fun opW => ModuleCat.ofHom
                  { toFun := fun x => ⟨u_i 𝒢 opW.unop x, hu_mem_R 𝒢 opW.unop x⟩
                    map_add' := fun x₁ x₂ => Subtype.ext (funext fun i => Subtype.ext (funext fun j =>
                      (hu_ij_uniq 𝒢 opW.unop (x₁ + x₂) i j
                        (u_ij 𝒢 opW.unop x₁ i j + u_ij 𝒢 opW.unop x₂ i j) fun g =>
                          (map_add _ _ _).trans
                            ((congrArg₂ (· + ·)
                              (hu_ij_spec 𝒢 opW.unop x₁ i j g)
                              (hu_ij_spec 𝒢 opW.unop x₂ i j g)).trans
                              ((smul_add _ _ _).symm.trans
                                (congrArg _ (map_add _ x₁ x₂).symm)))).symm))
                    map_smul' := fun r x => Subtype.ext (funext fun i => Subtype.ext (funext fun j =>
                      (hu_ij_uniq 𝒢 opW.unop (r • x) i j (r • u_ij 𝒢 opW.unop x i j) fun g =>
                        (map_smul _ _ _).trans
                          ((congrArg (r • ·) (hu_ij_spec 𝒢 opW.unop x i j g)).trans
                            ((smul_comm _ _ _).trans
                              (congrArg _ (map_smul _ r x).symm)))).symm)) }
                naturality := fun {opW₂ opW₁} opu => by
                  apply ModuleCat.hom_ext; apply LinearMap.ext; intro x
                  apply Subtype.ext; funext i; apply Subtype.ext; funext j
                  symm
                  apply hu_ij_uniq 𝒢 opW₁.unop ((𝒢.obj.map opu).hom x) i j
                  intro g
                  exact (hMapComp 𝒢 (σ_g opW₁.unop g) (u_can (u_can opu.unop)) _).symm.trans
                    ((congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom _)
                      (hσ_bc opu.unop g).symm).trans
                      ((hMapComp 𝒢 (u_can opu.unop) (σ_g opW₂.unop g) _).trans
                        ((congrArg (𝒢.obj.map (Opposite.op (u_can opu.unop))).hom
                          (hu_ij_spec 𝒢 opW₂.unop x i j g)).trans
                          ((map_smul _ _ _).trans
                            (congrArg _
                              ((hMapComp 𝒢 (u_can opu.unop) (p_W opW₂.unop) x).symm.trans
                                ((congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom x)
                                  (hu_p opu.unop)).trans
                                  (hMapComp 𝒢 (p_W opW₁.unop) opu.unop x)))))))) } }
        naturality := fun {𝒢₁ 𝒢₂} φ => by
          apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext opW
          apply ModuleCat.hom_ext; apply LinearMap.ext; intro x
          apply Subtype.ext; funext i; apply Subtype.ext; funext j
          symm
          apply hu_ij_uniq 𝒢₂ opW.unop ((φ.hom.app opW).hom x) i j
          intro g
          have hnat_σ := congrArg
            (fun (τ : Quiver.Hom (𝒢₁.obj.obj (Opposite.op (obj_WV (obj_WV opW.unop))))
              (𝒢₂.obj.obj (Opposite.op (obj_WV opW.unop)))) => τ.hom (u_ij 𝒢₁ opW.unop x i j))
            (φ.hom.naturality (Opposite.op (σ_g opW.unop g)))
          have hnat_p := congrArg
            (fun (τ : Quiver.Hom (𝒢₁.obj.obj opW)
              (𝒢₂.obj.obj (Opposite.op (obj_WV opW.unop)))) => τ.hom x)
            (φ.hom.naturality (Opposite.op (p_W opW.unop)))
          exact hnat_σ.symm.trans
            ((congrArg (φ.hom.app (Opposite.op (obj_WV opW.unop))).hom
              (hu_ij_spec 𝒢₁ opW.unop x i j g)).trans
              ((map_smul _ _ _).trans (congrArg _ hnat_p))) }

    have hMatCancel : ∀ (g : Γ) (k l : Fin M),
        Finset.univ.sum (fun i : Fin M => (τ_rep g).val i k * (τ_dual g).val i l) =
          if l = k then 1 else 0 := by
      intro g k l
      calc
        Finset.univ.sum (fun i : Fin M => (τ_rep g).val i k * (τ_dual g).val i l)
          = Finset.univ.sum (fun i : Fin M => ((τ_rep g)⁻¹).val l i * (τ_rep g).val i k) := by
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [h_dual g, Matrix.transpose_apply, mul_comm]
        _ = (((τ_rep g)⁻¹).val * (τ_rep g).val) l k := Matrix.mul_apply.symm
        _ = (1 : Matrix (Fin M) (Fin M) (ZMod m)) l k := by
              rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
        _ = if l = k then 1 else 0 := Matrix.one_apply

    let c_diag : ∀ (ℋ : 𝒞) (W : S.Etale),
        ↑((T_sh.obj (R_sh.obj ℋ)).obj.obj (Opposite.op W)) →
          ↑(ℋ.obj.obj (Opposite.op (obj_WV W))) :=
      fun ℋ W s =>
        Finset.univ.sum (fun i : Fin M =>
          (ℋ.obj.map (Opposite.op (σ_g W 1))).hom ((s.1 i).1 i))

    have hc_diag_inv : ∀ (ℋ : 𝒞) (W : S.Etale)
        (s : ↑((T_sh.obj (R_sh.obj ℋ)).obj.obj (Opposite.op W))) (g : Γ),
        (ℋ.obj.map (Opposite.op (m_can W g))).hom (c_diag ℋ W s) = c_diag ℋ W s := by
      intro ℋ W s g
      let term_fn : Fin M → Fin M → ↑(ℋ.obj.obj (Opposite.op (obj_WV W))) :=
        fun k l => (ℋ.obj.map (Opposite.op (σ_g W 1))).hom ((s.1 k).1 l)
      have hstep : ∀ i : Fin M,
          (ℋ.obj.map (Opposite.op (m_can W g))).hom (term_fn i i) =
          Finset.univ.sum (fun k : Fin M =>
            Finset.univ.sum (fun l : Fin M =>
              (ULift.up ((τ_rep g).val i k * (τ_dual g).val i l) : R) • term_fn k l)) := by
        intro i
        have h1 : (ℋ.obj.map (Opposite.op (m_can W g))).hom (term_fn i i) =
            (ℋ.obj.map (Opposite.op (σ_g W 1))).hom
              ((ℋ.obj.map (Opposite.op (m_can (obj_WV W) g))).hom
                ((ℋ.obj.map (Opposite.op (u_can (m_can W g)))).hom ((s.1 i).1 i))) :=
          (hMapComp ℋ (m_can W g) (σ_g W 1) _).symm.trans
            ((congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom _) (hσ_diag W g)).trans
              ((hMapComp ℋ (σ_g W 1) _ _).trans
                (congrArg (ℋ.obj.map (Opposite.op (σ_g W 1))).hom
                  (hMapComp ℋ (m_can (obj_WV W) g) (u_can (m_can W g)) _))))
        have h2 : (ℋ.obj.map (Opposite.op (u_can (m_can W g)))).hom ((s.1 i).1 i) =
            Finset.univ.sum (fun k : Fin M => (ULift.up ((τ_rep g).val i k) : R) • (s.1 k).1 i) := by
          have hs_eq := s.2.2 g (m_can W g) (hm_fst W g) (hm_snd W g) i
          have hval := congrArg (fun (r : ↥(R_sub ℋ (obj_WV W))) => r.1 i) hs_eq
          exact hval.trans (by
            change (Finset.univ.sum (fun k : Fin M =>
              (ULift.up ((τ_rep g).val i k) : R) • s.1 k)).1 i = _
            rw [Submodule.coe_sum]
            simp only [Finset.sum_apply]
            rfl)
        have h3 : (ℋ.obj.map (Opposite.op (σ_g W 1))).hom
            ((ℋ.obj.map (Opposite.op (m_can (obj_WV W) g))).hom
              (Finset.univ.sum (fun k : Fin M =>
                (ULift.up ((τ_rep g).val i k) : R) • (s.1 k).1 i))) =
            Finset.univ.sum (fun k : Fin M =>
              Finset.univ.sum (fun l : Fin M =>
                (ULift.up ((τ_rep g).val i k * (τ_dual g).val i l) : R) • term_fn k l)) :=
          (congrArg (ℋ.obj.map (Opposite.op (σ_g W 1))).hom (map_sum _ _ _)).trans
            ((map_sum _ _ _).trans
              (Finset.sum_congr rfl fun k _ =>
                (congrArg (ℋ.obj.map (Opposite.op (σ_g W 1))).hom (map_smul _ _ _)).trans
                  ((map_smul _ _ _).trans
                    ((congrArg (modSmul (ℋ.obj.obj (Opposite.op (obj_WV W)))
                        (ULift.up ((τ_rep g).val i k) : R))
                      ((congrArg (ℋ.obj.map (Opposite.op (σ_g W 1))).hom
                        ((s.1 k).2 g (m_can (obj_WV W) g) (hm_fst _ g) (hm_snd _ g) i)).trans
                        (map_sum _ _ _))).trans
                      ((hModSmulSum (ℋ.obj.obj (Opposite.op (obj_WV W)))
                          (ULift.up ((τ_rep g).val i k) : R) _).trans
                        (Finset.sum_congr rfl fun l _ =>
                          ((congrArg (modSmul (ℋ.obj.obj (Opposite.op (obj_WV W)))
                              (ULift.up ((τ_rep g).val i k) : R))
                            (map_smul _ _ _)).trans
                            (hModMulSmul (ℋ.obj.obj (Opposite.op (obj_WV W))) _ _ _).symm)))))))
        exact h1.trans ((congrArg (fun z => (ℋ.obj.map (Opposite.op (σ_g W 1))).hom
          ((ℋ.obj.map (Opposite.op (m_can (obj_WV W) g))).hom z)) h2).trans h3)
      have hcollapse : Finset.univ.sum (fun i : Fin M =>
          Finset.univ.sum (fun k : Fin M =>
            Finset.univ.sum (fun l : Fin M =>
              (ULift.up ((τ_rep g).val i k * (τ_dual g).val i l) : R) • term_fn k l))) =
          Finset.univ.sum (fun k : Fin M => term_fn k k) := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [Finset.sum_comm]
        have h_inner : ∀ l : Fin M,
            Finset.univ.sum (fun i : Fin M =>
              (ULift.up ((τ_rep g).val i k * (τ_dual g).val i l) : R) • term_fn k l) =
            if l = k then term_fn k l else 0 := by
          intro l
          rw [← Finset.sum_smul]
          have hsum_ulift : Finset.univ.sum (fun i : Fin M =>
              (ULift.up ((τ_rep g).val i k * (τ_dual g).val i l) : R)) =
              if l = k then 1 else 0 := by
            apply ULift.ext
            rw [hdown_sum, hMatCancel g k l]
            split_ifs <;> rfl
          rw [hsum_ulift]
          split_ifs <;> simp
        simp_rw [h_inner]
        simp
      exact (map_sum _ _ _).trans ((Finset.sum_congr rfl fun i _ => hstep i).trans hcollapse)

    have hc_diag_collar : ∀ (ℋ : 𝒞) (W : S.Etale) (W₀ : (Fgt.obj W).left.Opens)
        (s : ↑((T_sh.obj (R_sh.obj ℋ)).obj.obj (Opposite.op W))),
        (∀ i : Fin M, ((R_sh.obj ℋ).obj.map (Opposite.op (inc_W₀ W W₀))).hom (s.1 i) = 0) →
        (ℋ.obj.map (Opposite.op (inc_W₀ W W₀))).hom (c_diag ℋ W s) = 0 := by
      intro ℋ W W₀ s h0
      refine (map_sum _ _ _).trans (Finset.sum_eq_zero fun i _ => ?_)
      have hi0 : (ℋ.obj.map (Opposite.op (u_can (inc_W₀ W W₀)))).hom ((s.1 i).1 i) = 0 :=
        congrArg (fun (r : ↥(R_sub ℋ _)) => r.1 i) (h0 i)
      have hfac_inc : CategoryTheory.CategoryStruct.comp (inc_W₀ W W₀) (σ_g W 1) =
          CategoryTheory.CategoryStruct.comp (τ_sec W (inc_W₀ W W₀)) (u_can (inc_W₀ W W₀)) := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (fun φ => (W₀_V_op W W₀).ι ≫ φ) (hσ_fst W 1)).trans
              ((CategoryTheory.Category.comp_id _).trans
                ((CategoryTheory.Category.id_comp (W₀_V_op W W₀).ι).symm.trans
                  ((congrArg (fun φ => φ ≫ (W₀_V_op W W₀).ι)
                    (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm).trans
                    ((CategoryTheory.Category.assoc _ _ _).trans
                      ((congrArg (fun φ => (Fgt.map (τ_sec W (inc_W₀ W W₀))).left ≫ φ)
                        (hu_fst (inc_W₀ W W₀)).symm).trans
                        (CategoryTheory.Category.assoc _ _ _).symm))))))
        · exact (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (fun φ => (W₀_V_op W W₀).ι ≫ φ)
              ((hσ_snd W 1).trans
                ((congrArg (fun φ => snd₁ W ≫ φ) hAct1).trans
                  (CategoryTheory.Category.comp_id _)))).trans
              ((CategoryTheory.Limits.pullback.lift_snd _ _ _).symm.trans
                ((congrArg (fun φ => (Fgt.map (τ_sec W (inc_W₀ W W₀))).left ≫ φ)
                  (hu_snd (inc_W₀ W W₀)).symm).trans
                  (CategoryTheory.Category.assoc _ _ _).symm)))
      exact (hMapComp ℋ (inc_W₀ W W₀) (σ_g W 1) ((s.1 i).1 i)).symm.trans
        ((congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom ((s.1 i).1 i)) hfac_inc).trans
          ((hMapComp ℋ (τ_sec W (inc_W₀ W W₀)) (u_can (inc_W₀ W W₀)) ((s.1 i).1 i)).trans
            ((congrArg (ℋ.obj.map (Opposite.op (τ_sec W (inc_W₀ W W₀)))).hom hi0).trans
              (map_zero _))))

    let obj_W₀_base : ∀ (W : S.Etale), (Fgt.obj W).left.Opens → S.Etale :=
      fun W W₀ =>
        CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.CategoryStruct.comp W₀.ι (Fgt.obj W).hom)
          (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            W₀.ι (Fgt.obj W).hom inferInstance W.prop)
    let ι_W₀_base : ∀ (W : S.Etale) (W₀ : (Fgt.obj W).left.Opens),
        Quiver.Hom (obj_W₀_base W W₀) W :=
      fun W W₀ => CategoryTheory.MorphismProperty.Over.homMk W₀.ι rfl trivial

    have hCollarGlue : ∀ (ℋ : 𝒞) (W : S.Etale) (W₀ : (Fgt.obj W).left.Opens),
        ((TopologicalSpace.Opens.map (Fgt.obj W).hom.base).obj U) ⊔ W₀ = ⊤ →
        ∀ c : ↑(ℋ.obj.obj (Opposite.op (obj_WV W))),
          (∀ g : Γ, (ℋ.obj.map (Opposite.op (m_can W g))).hom c = c) →
          (ℋ.obj.map (Opposite.op (inc_W₀ W W₀))).hom c = 0 →
          ∃! t : ↑(ℋ.obj.obj (Opposite.op W)),
            (ℋ.obj.map (Opposite.op (p_W W))).hom t = c ∧
            (ℋ.obj.map (Opposite.op (ι_W₀_base W W₀))).hom t = 0 := by
      intro ℋ W W₀ hcov c hc_inv hc_0
      let Y_cov : ULift.{u} Bool → S.Etale :=
        fun b => if b.down then obj_WV W else obj_W₀_base W W₀
      let p_cov : ∀ b : ULift.{u} Bool, Quiver.Hom (Y_cov b) W :=
        fun b =>
          match b with
          | ⟨true⟩ => p_W W
          | ⟨false⟩ => ι_W₀_base W W₀
      let sec_cov : ∀ b : ULift.{u} Bool, ↑(ℋ.obj.obj (Opposite.op (Y_cov b))) :=
        fun b =>
          match b with
          | ⟨true⟩ => c
          | ⟨false⟩ => 0
      have hcov_surj : ∀ x : ↥W.left, ∃ b : ULift.{u} Bool, x ∈ Set.range ⇑(p_cov b).left.base := by
        intro x
        have hx_top : (x : ↥(Fgt.obj W).left) ∈
            (((TopologicalSpace.Opens.map (Fgt.obj W).hom.base).obj U) ⊔ W₀ :
              (Fgt.obj W).left.Opens) := by
          rw [hcov]; trivial
        rcases hx_top with hU_x | hW_x
        · have hU_mem : (Fgt.obj W).hom.base x ∈ Set.range U.ι.base := by
            rwa [AlgebraicGeometry.Scheme.Opens.range_ι U]
          obtain ⟨u₀, hu₀⟩ := hU_mem
          obtain ⟨v₀, hv₀⟩ := (AlgebraicGeometry.surjective_iff π).mp hSurj_π u₀
          have hv_ι : ι_V.base v₀ = (Fgt.obj W).hom.base x := by
            change U.ι.base (π.base v₀) = _
            rw [hv₀, hu₀]
          obtain ⟨y, hy₁, _⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x v₀ hv_ι.symm
          exact ⟨⟨true⟩, y, hy₁⟩
        · refine ⟨⟨false⟩, ?_⟩
          change x ∈ Set.range W₀.ι.base
          rwa [AlgebraicGeometry.Scheme.Opens.range_ι W₀]
      have hMixedZero : ∀ (Z : S.Etale) (a₁ : Quiver.Hom Z (obj_WV W))
          (a₂ : Quiver.Hom Z (obj_W₀_base W W₀)),
          CategoryTheory.CategoryStruct.comp a₁ (p_W W) =
            CategoryTheory.CategoryStruct.comp a₂ (ι_W₀_base W W₀) →
          (ℋ.obj.map (Opposite.op a₁)).hom c = 0 := by
        intro Z a₁ a₂ hcomm
        have hcomm_left : CategoryTheory.CategoryStruct.comp (Fgt.map a₁).left (fst₁ W) =
            CategoryTheory.CategoryStruct.comp (Fgt.map a₂).left W₀.ι :=
          congrArg (fun φ => (Fgt.map φ).left) hcomm
        have hsub : Set.range (Fgt.map a₁).left.base ⊆ Set.range (W₀_V_op W W₀).ι.base := by
          rintro _ ⟨z, rfl⟩
          refine (Set.ext_iff.mp (AlgebraicGeometry.Scheme.Opens.range_ι (W₀_V_op W W₀)) _).mpr ?_
          change ((Fgt.map a₁).left ≫ fst₁ W).base z ∈ W₀
          have hz_eq : ((Fgt.map a₁).left ≫ fst₁ W).base z =
              ((Fgt.map a₂).left ≫ W₀.ι).base z :=
            congrArg (fun φ => φ.base z) hcomm_left
          have hz_in : ((Fgt.map a₂).left ≫ W₀.ι).base z ∈ W₀ :=
            (Set.ext_iff.mp (AlgebraicGeometry.Scheme.Opens.range_ι W₀) _).mp
              ⟨(Fgt.map a₂).left.base z, rfl⟩
          exact Eq.mp (congrArg (fun p => p ∈ W₀) hz_eq.symm) hz_in
        have _ : AlgebraicGeometry.IsOpenImmersion (W₀_V_op W W₀).ι := inferInstance
        let l_sch := AlgebraicGeometry.IsOpenImmersion.lift (W₀_V_op W W₀).ι (Fgt.map a₁).left hsub
        have hl_fac : CategoryTheory.CategoryStruct.comp l_sch (W₀_V_op W W₀).ι = (Fgt.map a₁).left :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac (W₀_V_op W W₀).ι (Fgt.map a₁).left hsub
        let l_et : Quiver.Hom Z (obj_W₀V W W₀) :=
          CategoryTheory.MorphismProperty.Over.homMk l_sch
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (fun φ => φ ≫ (Fgt.obj (obj_WV W)).hom) hl_fac).trans
                (CategoryTheory.MorphismProperty.Over.w a₁)))
            trivial
        have hl_eq : CategoryTheory.CategoryStruct.comp l_et (inc_W₀ W W₀) = a₁ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext hl_fac
        exact (congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom c) hl_eq.symm).trans
          ((hMapComp ℋ l_et (inc_W₀ W W₀) c).trans
            ((congrArg (ℋ.obj.map (Opposite.op l_et)).hom hc_0).trans (map_zero _)))
      obtain ⟨t, ht_spec, ht_uniq⟩ := hSheafArrows ℋ W Y_cov p_cov hcov_surj sec_cov
        (fun b₁ b₂ Z a₁ a₂ hcomm => by
          rcases b₁ with ⟨_ | _⟩ <;> rcases b₂ with ⟨_ | _⟩
          · exact (map_zero (ℋ.obj.map (Opposite.op a₁)).hom).trans
              (map_zero (ℋ.obj.map (Opposite.op a₂)).hom).symm
          · exact (map_zero (ℋ.obj.map (Opposite.op a₁)).hom).trans
              (hMixedZero Z a₂ a₁ hcomm.symm).symm
          · exact (hMixedZero Z a₁ a₂ hcomm).trans
              (map_zero (ℋ.obj.map (Opposite.op a₂)).hom).symm
          · exact hRelEq ℋ W Z a₁ a₂ hcomm c hc_inv)
      exact ⟨t, ⟨ht_spec ⟨true⟩, ht_spec ⟨false⟩⟩,
        fun t' ht' => ht_uniq t' fun b => by rcases b with ⟨_ | _⟩; exact ht'.2; exact ht'.1⟩

    let ε_fun : ∀ (ℋ : 𝒞) (W : S.Etale),
        ↑((T_sh.obj (R_sh.obj ℋ)).obj.obj (Opposite.op W)) → ↑(ℋ.obj.obj (Opposite.op W)) :=
      fun ℋ W s =>
        let W₀ := Classical.choose s.2.1
        have hW₀ := Classical.choose_spec s.2.1
        Classical.choose (hCollarGlue ℋ W W₀ hW₀.1 (c_diag ℋ W s)
          (hc_diag_inv ℋ W s) (hc_diag_collar ℋ W W₀ s hW₀.2))

    have hε_p : ∀ (ℋ : 𝒞) (W : S.Etale)
        (s : ↑((T_sh.obj (R_sh.obj ℋ)).obj.obj (Opposite.op W))),
        (ℋ.obj.map (Opposite.op (p_W W))).hom (ε_fun ℋ W s) = c_diag ℋ W s :=
      fun ℋ W s =>
        let W₀ := Classical.choose s.2.1
        let hW₀ := Classical.choose_spec s.2.1
        (Classical.choose_spec (hCollarGlue ℋ W W₀ hW₀.1 (c_diag ℋ W s)
          (hc_diag_inv ℋ W s) (hc_diag_collar ℋ W W₀ s hW₀.2))).1.1

    have hBaseLe : ∀ (ℋ : 𝒞) (W : S.Etale) {A B : (Fgt.obj W).left.Opens}, A ≤ B →
        ∀ z : ↑(ℋ.obj.obj (Opposite.op W)),
          (ℋ.obj.map (Opposite.op (ι_W₀_base W B))).hom z = 0 →
          (ℋ.obj.map (Opposite.op (ι_W₀_base W A))).hom z = 0 := by
      intro ℋ W A B hAB z hz0
      have hsub : Set.range A.ι.base ⊆ Set.range B.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι, AlgebraicGeometry.Scheme.Opens.range_ι]
        exact hAB
      let l_AB := AlgebraicGeometry.IsOpenImmersion.lift B.ι A.ι hsub
      have hl_AB : CategoryTheory.CategoryStruct.comp l_AB B.ι = A.ι :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ hsub
      let step_AB : Quiver.Hom (obj_W₀_base W A) (obj_W₀_base W B) :=
        CategoryTheory.MorphismProperty.Over.homMk l_AB
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            (congrArg (· ≫ (Fgt.obj W).hom) hl_AB))
          trivial
      have heq_AB : CategoryTheory.CategoryStruct.comp step_AB (ι_W₀_base W B) = ι_W₀_base W A :=
        CategoryTheory.MorphismProperty.Over.Hom.ext hl_AB
      exact (congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom z) heq_AB.symm).trans
        ((hMapComp ℋ step_AB (ι_W₀_base W B) z).trans
          ((congrArg (ℋ.obj.map (Opposite.op step_AB)).hom hz0).trans (map_zero _)))

    have hε_uniq : ∀ (ℋ : 𝒞) (W : S.Etale)
        (s : ↑((T_sh.obj (R_sh.obj ℋ)).obj.obj (Opposite.op W)))
        (W'₀ : (Fgt.obj W).left.Opens),
        ((TopologicalSpace.Opens.map (Fgt.obj W).hom.base).obj U) ⊔ W'₀ = ⊤ →
        ∀ t : ↑(ℋ.obj.obj (Opposite.op W)),
          (ℋ.obj.map (Opposite.op (p_W W))).hom t = c_diag ℋ W s →
          (ℋ.obj.map (Opposite.op (ι_W₀_base W W'₀))).hom t = 0 →
          t = ε_fun ℋ W s := by
      intro ℋ W s W'₀ hcov' t htp ht0
      let W₀ := Classical.choose s.2.1
      have hW₀ := Classical.choose_spec s.2.1
      have hε0 : (ℋ.obj.map (Opposite.op (ι_W₀_base W W₀))).hom (ε_fun ℋ W s) = 0 :=
        (Classical.choose_spec (hCollarGlue ℋ W W₀ hW₀.1 (c_diag ℋ W s)
          (hc_diag_inv ℋ W s) (hc_diag_collar ℋ W W₀ s hW₀.2))).1.2
      let W₁₂ := W₀ ⊓ W'₀
      have hcov₁₂ : ((TopologicalSpace.Opens.map (Fgt.obj W).hom.base).obj U) ⊔ W₁₂ = ⊤ := by
        rw [sup_inf_left, hW₀.1, hcov', top_inf_eq]
      obtain ⟨t₁₂, -, ht₁₂_uniq⟩ := hCollarGlue ℋ W W₁₂ hcov₁₂ (c_diag ℋ W s)
        (hc_diag_inv ℋ W s)
        (hIncLe ℋ W inf_le_left (c_diag ℋ W s) (hc_diag_collar ℋ W W₀ s hW₀.2))
      have h1 : t = t₁₂ := ht₁₂_uniq t ⟨htp, hBaseLe ℋ W inf_le_right t ht0⟩
      have h2 : ε_fun ℋ W s = t₁₂ :=
        ht₁₂_uniq (ε_fun ℋ W s) ⟨hε_p ℋ W s, hBaseLe ℋ W inf_le_left _ hε0⟩
      exact h1.trans h2.symm

    have hε_W0 : ∀ (ℋ : 𝒞) (W : S.Etale)
        (s : ↑((T_sh.obj (R_sh.obj ℋ)).obj.obj (Opposite.op W)))
        (W₀ : (Fgt.obj W).left.Opens),
        ((TopologicalSpace.Opens.map (Fgt.obj W).hom.base).obj U) ⊔ W₀ = ⊤ →
        (∀ i : Fin M, ((R_sh.obj ℋ).obj.map (Opposite.op (inc_W₀ W W₀))).hom (s.1 i) = 0) →
        (ℋ.obj.map (Opposite.op (ι_W₀_base W W₀))).hom (ε_fun ℋ W s) = 0 := by
      intro ℋ W s W₀ hcov h0
      obtain ⟨t, ht_spec, -⟩ := hCollarGlue ℋ W W₀ hcov (c_diag ℋ W s)
        (hc_diag_inv ℋ W s) (hc_diag_collar ℋ W W₀ s h0)
      have ht_eq : t = ε_fun ℋ W s := hε_uniq ℋ W s W₀ hcov t ht_spec.1 ht_spec.2
      exact ht_eq ▸ ht_spec.2

    let ε_adj : CategoryTheory.NatTrans (R_sh ⋙ T_sh) (CategoryTheory.Functor.id 𝒞) :=
      { app := fun ℋ =>
          { hom :=
              { app := fun opW => ModuleCat.ofHom
                  { toFun := ε_fun ℋ opW.unop
                    map_add' := fun s₁ s₂ => by
                      let W := opW.unop
                      let s₁' : ↑((T_sh.obj (R_sh.obj ℋ)).obj.obj (Opposite.op W)) := s₁
                      let s₂' : ↑((T_sh.obj (R_sh.obj ℋ)).obj.obj (Opposite.op W)) := s₂
                      rcases s₁'.2.1 with ⟨W₀₁, hcov₁, h0₁⟩
                      rcases s₂'.2.1 with ⟨W₀₂, hcov₂, h0₂⟩
                      symm
                      apply hε_uniq ℋ W (s₁' + s₂') (W₀₁ ⊓ W₀₂)
                        (by rw [sup_inf_left, hcov₁, hcov₂, top_inf_eq])
                      · exact (map_add _ _ _).trans
                          ((congrArg₂ (· + ·) (hε_p ℋ W s₁') (hε_p ℋ W s₂')).trans
                            (Finset.sum_add_distrib.symm.trans
                              (Finset.sum_congr rfl fun i _ => (map_add _ _ _).symm)))
                      · exact (map_add _ _ _).trans
                          ((congrArg₂ (· + ·)
                            (hBaseLe ℋ W inf_le_left _ (hε_W0 ℋ W s₁' W₀₁ hcov₁ h0₁))
                            (hBaseLe ℋ W inf_le_right _ (hε_W0 ℋ W s₂' W₀₂ hcov₂ h0₂))).trans
                            (add_zero 0))
                    map_smul' := fun r s => by
                      let W := opW.unop
                      rcases s.2.1 with ⟨W₀, hcov, h0⟩
                      symm
                      apply hε_uniq ℋ W _ W₀ hcov
                      · exact (map_smul (ℋ.obj.map (Opposite.op (p_W W))).hom r (ε_fun ℋ W s)).trans
                          ((congrArg (modSmul (ℋ.obj.obj (Opposite.op (obj_WV W))) r)
                            (hε_p ℋ W s)).trans
                            ((hModSmulSum (ℋ.obj.obj (Opposite.op (obj_WV W))) r _).trans
                              (Finset.sum_congr rfl fun i _ =>
                                (map_smul (ℋ.obj.map (Opposite.op (σ_g W 1))).hom r
                                  ((s.1 i).1 i)).symm)))
                      · exact (map_smul (ℋ.obj.map (Opposite.op (ι_W₀_base W W₀))).hom r
                          (ε_fun ℋ W s)).trans
                          ((congrArg (modSmul (ℋ.obj.obj (Opposite.op (obj_W₀_base W W₀))) r)
                            (hε_W0 ℋ W s W₀ hcov h0)).trans
                            (hModSmulZero (ℋ.obj.obj (Opposite.op (obj_W₀_base W W₀))) r)) }
                naturality := fun {opW₂ opW₁} opu => by
                  apply ModuleCat.hom_ext; apply LinearMap.ext; intro s
                  let W₂ := opW₂.unop
                  let W₁ := opW₁.unop
                  let u := opu.unop
                  let s' : ↑((T_sh.obj (R_sh.obj ℋ)).obj.obj (Opposite.op W₂)) := s
                  rcases s'.2.1 with ⟨W₀₂, hcov₂, h0₂⟩
                  let W₀₁ : (Fgt.obj W₁).left.Opens :=
                    (TopologicalSpace.Opens.map (Fgt.map u).left.base).obj W₀₂
                  have hp := hIncPull (R_sh.obj ℋ) u W₀₂ hcov₂
                  symm
                  apply hε_uniq ℋ W₁ (((T_sh.obj (R_sh.obj ℋ)).obj.map opu).hom s') W₀₁ hp.1
                  · have h1 : (ℋ.obj.map (Opposite.op (p_W W₁))).hom
                        ((ℋ.obj.map opu).hom (ε_fun ℋ W₂ s')) =
                        (ℋ.obj.map (Opposite.op (u_can u))).hom (c_diag ℋ W₂ s') :=
                      (hMapComp ℋ (p_W W₁) u (ε_fun ℋ W₂ s')).symm.trans
                        ((congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom (ε_fun ℋ W₂ s'))
                          (hu_p u).symm).trans
                          ((hMapComp ℋ (u_can u) (p_W W₂) (ε_fun ℋ W₂ s')).trans
                            (congrArg (ℋ.obj.map (Opposite.op (u_can u))).hom (hε_p ℋ W₂ s'))))
                    refine h1.trans ((map_sum _ _ _).trans (Finset.sum_congr rfl fun i _ => ?_))
                    exact (hMapComp ℋ (u_can u) (σ_g W₂ 1) ((s'.1 i).1 i)).symm.trans
                      ((congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom ((s'.1 i).1 i))
                        (hσ_bc u 1)).trans
                        (hMapComp ℋ (σ_g W₁ 1) (u_can (u_can u)) ((s'.1 i).1 i)))
                  · have hsub : Set.range (CategoryTheory.CategoryStruct.comp W₀₁.ι (Fgt.map u).left).base ⊆
                        Set.range W₀₂.ι.base := by
                      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
                      rintro _ ⟨w, rfl⟩
                      have hw : W₀₁.ι.base w ∈ Set.range W₀₁.ι.base := ⟨w, rfl⟩
                      rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at hw
                    let l_b := AlgebraicGeometry.IsOpenImmersion.lift W₀₂.ι
                      (CategoryTheory.CategoryStruct.comp W₀₁.ι (Fgt.map u).left) hsub
                    have hl_b : CategoryTheory.CategoryStruct.comp l_b W₀₂.ι =
                        CategoryTheory.CategoryStruct.comp W₀₁.ι (Fgt.map u).left :=
                      AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ hsub
                    let step_b : Quiver.Hom (obj_W₀_base W₁ W₀₁) (obj_W₀_base W₂ W₀₂) :=
                      CategoryTheory.MorphismProperty.Over.homMk l_b
                        ((CategoryTheory.Category.assoc _ _ _).symm.trans
                          ((congrArg (· ≫ (Fgt.obj W₂).hom) hl_b).trans
                            ((CategoryTheory.Category.assoc _ _ _).trans
                              (congrArg (W₀₁.ι ≫ ·) (Fgt.map u).w))))
                        trivial
                    have heq_b : CategoryTheory.CategoryStruct.comp (ι_W₀_base W₁ W₀₁) u =
                        CategoryTheory.CategoryStruct.comp step_b (ι_W₀_base W₂ W₀₂) :=
                      CategoryTheory.MorphismProperty.Over.Hom.ext hl_b.symm
                    exact (hMapComp ℋ (ι_W₀_base W₁ W₀₁) u (ε_fun ℋ W₂ s')).symm.trans
                      ((congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom (ε_fun ℋ W₂ s')) heq_b).trans
                        ((hMapComp ℋ step_b (ι_W₀_base W₂ W₀₂) (ε_fun ℋ W₂ s')).trans
                          ((congrArg (ℋ.obj.map (Opposite.op step_b)).hom
                            (hε_W0 ℋ W₂ s' W₀₂ hcov₂ h0₂)).trans (map_zero _)))) } }
        naturality := fun {ℋ₁ ℋ₂} φ => by
          apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext opW
          apply ModuleCat.hom_ext; apply LinearMap.ext; intro s
          let W := opW.unop
          let s' : ↑((T_sh.obj (R_sh.obj ℋ₁)).obj.obj (Opposite.op W)) := s
          rcases s'.2.1 with ⟨W₀, hcov, h0⟩
          symm
          apply hε_uniq ℋ₂ W (((T_sh.map (R_sh.map φ)).hom.app opW).hom s') W₀ hcov
          · have hnat_p := congrArg
              (fun (τ : Quiver.Hom (ℋ₁.obj.obj opW)
                (ℋ₂.obj.obj (Opposite.op (obj_WV W)))) => τ.hom (ε_fun ℋ₁ W s'))
              (φ.hom.naturality (Opposite.op (p_W W)))
            refine hnat_p.symm.trans
              ((congrArg (φ.hom.app (Opposite.op (obj_WV W))).hom (hε_p ℋ₁ W s')).trans
                ((map_sum _ _ _).trans (Finset.sum_congr rfl fun i _ => ?_)))
            exact congrArg
              (fun (τ : Quiver.Hom (ℋ₁.obj.obj (Opposite.op (obj_WV (obj_WV W))))
                (ℋ₂.obj.obj (Opposite.op (obj_WV W)))) => τ.hom ((s'.1 i).1 i))
              (φ.hom.naturality (Opposite.op (σ_g W 1)))
          · have hnat_0 := congrArg
              (fun (τ : Quiver.Hom (ℋ₁.obj.obj opW)
                (ℋ₂.obj.obj (Opposite.op (obj_W₀_base W W₀)))) => τ.hom (ε_fun ℋ₁ W s'))
              (φ.hom.naturality (Opposite.op (ι_W₀_base W W₀)))
            exact hnat_0.symm.trans
              ((congrArg (φ.hom.app (Opposite.op (obj_W₀_base W W₀))).hom
                (hε_W0 ℋ₁ W s' W₀ hcov h0)).trans (map_zero _)) }

    let adj : T_sh ⊣ R_sh :=
      CategoryTheory.Adjunction.mkOfUnitCounit
        { unit := η_adj
          counit := ε_adj
          left_triangle := by
            apply CategoryTheory.NatTrans.ext; funext 𝒢
            apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext opW
            apply ModuleCat.hom_ext; apply LinearMap.ext; intro s
            let W := opW.unop
            let s' : ↑((T_sh.obj 𝒢).obj.obj (Opposite.op W)) := s
            change ε_fun (T_sh.obj 𝒢) W (((T_sh.map (η_adj.app 𝒢)).hom.app opW).hom s') = s'
            rcases s'.2.1 with ⟨W₀, hcov, h0⟩
            symm
            apply hε_uniq (T_sh.obj 𝒢) W (((T_sh.map (η_adj.app 𝒢)).hom.app opW).hom s') W₀ hcov
            · apply Subtype.ext; funext k
              obtain ⟨_, -, ht_u⟩ := hSheetGlue 𝒢 W
                (fun g => Finset.univ.sum (fun j : Fin M =>
                  (ULift.up ((τ_rep g).val k j) : R) • s'.1 j))
              have ht_lhs : (𝒢.obj.map (Opposite.op (u_can (p_W W)))).hom (s'.1 k) = _ :=
                ht_u _ fun g =>
                  (hMapComp 𝒢 (σ_g W g) (u_can (p_W W)) (s'.1 k)).symm.trans
                    ((congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom (s'.1 k)) (hσ_proj W g)).trans
                      (s'.2.2 g (m_can W g) (hm_fst W g) (hm_snd W g) k))
              have hsum_k : (c_diag (T_sh.obj 𝒢) W
                  (((T_sh.map (η_adj.app 𝒢)).hom.app opW).hom s')).1 k =
                  Finset.univ.sum (fun i : Fin M =>
                    (𝒢.obj.map (Opposite.op (u_can (σ_g W 1)))).hom
                      (u_ij 𝒢 (obj_WV W) (s'.1 i) i k)) := by
                change (Finset.univ.sum (fun i : Fin M =>
                  (((T_sh.obj 𝒢).obj.map (Opposite.op (σ_g W 1))).hom _ :
                    ↥(T_sub 𝒢 (obj_WV W))))).1 k = _
                rw [Submodule.coe_sum]
                simp only [Finset.sum_apply]
                rfl
              have ht_rhs : (c_diag (T_sh.obj 𝒢) W
                  (((T_sh.map (η_adj.app 𝒢)).hom.app opW).hom s')).1 k = _ :=
                ht_u _ fun g =>
                  (congrArg (𝒢.obj.map (Opposite.op (σ_g W g))).hom hsum_k).trans
                    ((map_sum _ _ _).trans (Finset.sum_congr rfl fun i _ =>
                      (hMapComp 𝒢 (σ_g W g) (u_can (σ_g W 1)) _).symm.trans
                        ((congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom _) (hσ_tri1 W g)).trans
                          ((hMapComp 𝒢 (σ_g W 1) (σ_g (obj_WV W) g) _).trans
                            ((congrArg (𝒢.obj.map (Opposite.op (σ_g W 1))).hom
                              (hu_ij_spec 𝒢 (obj_WV W) (s'.1 i) i k g)).trans
                              ((map_smul _ _ _).trans
                                (congrArg _
                                  ((hMapComp 𝒢 (σ_g W 1) (p_W (obj_WV W)) (s'.1 i)).symm.trans
                                    ((congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom (s'.1 i))
                                      (hσ_p W 1)).trans
                                      (hMapId 𝒢 (obj_WV W) (s'.1 i)))))))))))
              exact ht_lhs.trans ht_rhs.symm
            · apply Subtype.ext; funext k
              have hsub : Set.range (Fgt.map (u_can (ι_W₀_base W W₀))).left.base ⊆
                  Set.range (W₀_V_op W W₀).ι.base := by
                rw [AlgebraicGeometry.Scheme.Opens.range_ι]
                rintro _ ⟨z, rfl⟩
                have h1 := congrArg (fun φ => φ.base z) (hu_fst (ι_W₀_base W W₀))
                have hz : W₀.ι.base ((fst₁ (obj_W₀_base W W₀)).base z) ∈ Set.range W₀.ι.base :=
                  ⟨(fst₁ (obj_W₀_base W W₀)).base z, rfl⟩
                rw [AlgebraicGeometry.Scheme.Opens.range_ι W₀] at hz
                change ((Fgt.map (u_can (ι_W₀_base W W₀))).left ≫ fst₁ W).base z ∈ W₀
                exact Eq.mp (congrArg (fun p => p ∈ W₀) h1.symm) hz
              let l_sch := AlgebraicGeometry.IsOpenImmersion.lift (W₀_V_op W W₀).ι
                (Fgt.map (u_can (ι_W₀_base W W₀))).left hsub
              have hl_fac : CategoryTheory.CategoryStruct.comp l_sch (W₀_V_op W W₀).ι =
                  (Fgt.map (u_can (ι_W₀_base W W₀))).left :=
                AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ hsub
              let l_et : Quiver.Hom (obj_WV (obj_W₀_base W W₀)) (obj_W₀V W W₀) :=
                CategoryTheory.MorphismProperty.Over.homMk l_sch
                  ((CategoryTheory.Category.assoc _ _ _).symm.trans
                    ((congrArg (· ≫ (Fgt.obj (obj_WV W)).hom) hl_fac).trans
                      (Fgt.map (u_can (ι_W₀_base W W₀))).w))
                  trivial
              have hl_eq : CategoryTheory.CategoryStruct.comp l_et (inc_W₀ W W₀) =
                  u_can (ι_W₀_base W W₀) :=
                CategoryTheory.MorphismProperty.Over.Hom.ext hl_fac
              exact (congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom (s'.1 k)) hl_eq.symm).trans
                ((hMapComp 𝒢 l_et (inc_W₀ W W₀) (s'.1 k)).trans
                  ((congrArg (𝒢.obj.map (Opposite.op l_et)).hom (h0 k)).trans (map_zero _)))
          right_triangle := by
            apply CategoryTheory.NatTrans.ext; funext ℋ
            apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext opW
            apply ModuleCat.hom_ext; apply LinearMap.ext; intro r
            let W := opW.unop
            let r' : ↑((R_sh.obj ℋ).obj.obj (Opposite.op W)) := r
            apply Subtype.ext; funext k
            change ε_fun ℋ (obj_WV W) (u_i (R_sh.obj ℋ) W r' k) = r'.1 k
            symm
            have hcov_bot :
                ((TopologicalSpace.Opens.map (Fgt.obj (obj_WV W)).hom.base).obj U) ⊔ ⊥ = ⊤ := by
              rw [sup_bot_eq, eq_top_iff]
              intro y _
              have hy : ((snd₁ W ≫ π) ≫ U.ι).base y = (Fgt.obj (obj_WV W)).hom.base y :=
                congrArg (fun φ => φ.base y)
                  (CategoryTheory.Limits.pullback.condition (f := (Fgt.obj W).hom) (g := ι_V)).symm
              have hmem_U : ((snd₁ W ≫ π) ≫ U.ι).base y ∈ (U : Set ↥S) := by
                rw [← AlgebraicGeometry.Scheme.Opens.range_ι U]
                exact ⟨(snd₁ W ≫ π).base y, rfl⟩
              change (Fgt.obj (obj_WV W)).hom.base y ∈ (U : Set ↥S)
              exact Eq.mp (congrArg (fun p => p ∈ (U : Set ↥S)) hy) hmem_U
            apply hε_uniq ℋ (obj_WV W) (u_i (R_sh.obj ℋ) W r' k) ⊥ hcov_bot
            · obtain ⟨_, -, ht_u⟩ := hSheetGlue ℋ W (fun _ => r'.1 k)
              have ht_lhs : (ℋ.obj.map (Opposite.op (p_W (obj_WV W)))).hom (r'.1 k) = _ :=
                ht_u _ fun g =>
                  (hMapComp ℋ (σ_g W g) (p_W (obj_WV W)) (r'.1 k)).symm.trans
                    ((congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom (r'.1 k)) (hσ_p W g)).trans
                      (hMapId ℋ (obj_WV W) (r'.1 k)))
              have hterm : ∀ (g : Γ) (j : Fin M),
                  (ℋ.obj.map (Opposite.op (σ_g W g))).hom
                    ((ℋ.obj.map (Opposite.op (σ_g (obj_WV W) 1))).hom
                      ((u_ij (R_sh.obj ℋ) W r' k j).1 j)) =
                  Finset.univ.sum (fun l : Fin M =>
                    (ULift.up ((τ_rep g).val j k * (τ_dual g).val j l) : R) • r'.1 l) := by
                intro g j
                have h1 : (ℋ.obj.map (Opposite.op (σ_g W g))).hom
                    ((ℋ.obj.map (Opposite.op (σ_g (obj_WV W) 1))).hom
                      ((u_ij (R_sh.obj ℋ) W r' k j).1 j)) =
                    (ℋ.obj.map (Opposite.op (σ_g W g))).hom
                      ((ℋ.obj.map (Opposite.op (u_can (σ_g W g)))).hom
                        ((u_ij (R_sh.obj ℋ) W r' k j).1 j)) :=
                  (hMapComp ℋ (σ_g W g) (σ_g (obj_WV W) 1) _).symm.trans
                    ((congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom _) (hσ_tri2 W g)).trans
                      (hMapComp ℋ (σ_g W g) (u_can (σ_g W g)) _))
                have h2 : (ℋ.obj.map (Opposite.op (u_can (σ_g W g)))).hom
                    ((u_ij (R_sh.obj ℋ) W r' k j).1 j) =
                    (ULift.up ((τ_rep g).val j k) : R) •
                      (ℋ.obj.map (Opposite.op (u_can (p_W W)))).hom (r'.1 j) :=
                  congrArg (fun (s : ↥(R_sub ℋ (obj_WV W))) => s.1 j)
                    (hu_ij_spec (R_sh.obj ℋ) W r' k j g)
                have h3 : (ℋ.obj.map (Opposite.op (σ_g W g))).hom
                    ((ℋ.obj.map (Opposite.op (u_can (p_W W)))).hom (r'.1 j)) =
                    Finset.univ.sum (fun l : Fin M =>
                      (ULift.up ((τ_dual g).val j l) : R) • r'.1 l) :=
                  (hMapComp ℋ (σ_g W g) (u_can (p_W W)) (r'.1 j)).symm.trans
                    ((congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom (r'.1 j))
                      (hσ_proj W g)).trans
                      (r'.2 g (m_can W g) (hm_fst W g) (hm_snd W g) j))
                exact h1.trans
                  ((congrArg (ℋ.obj.map (Opposite.op (σ_g W g))).hom h2).trans
                    ((map_smul _ _ _).trans
                      ((congrArg (modSmul (ℋ.obj.obj (Opposite.op (obj_WV W)))
                          (ULift.up ((τ_rep g).val j k) : R)) h3).trans
                        ((hModSmulSum (ℋ.obj.obj (Opposite.op (obj_WV W)))
                            (ULift.up ((τ_rep g).val j k) : R) _).trans
                          (Finset.sum_congr rfl fun l _ =>
                            (hModMulSmul (ℋ.obj.obj (Opposite.op (obj_WV W))) _ _ _).symm)))))
              have hcollapse : ∀ g : Γ,
                  Finset.univ.sum (fun j : Fin M =>
                    Finset.univ.sum (fun l : Fin M =>
                      (ULift.up ((τ_rep g).val j k * (τ_dual g).val j l) : R) • r'.1 l)) =
                  r'.1 k := by
                intro g
                rw [Finset.sum_comm]
                have h_inner : ∀ l : Fin M,
                    Finset.univ.sum (fun j : Fin M =>
                      (ULift.up ((τ_rep g).val j k * (τ_dual g).val j l) : R) • r'.1 l) =
                    if l = k then r'.1 l else 0 := by
                  intro l
                  rw [← Finset.sum_smul]
                  have hsum_ulift : Finset.univ.sum (fun j : Fin M =>
                      (ULift.up ((τ_rep g).val j k * (τ_dual g).val j l) : R)) =
                      if l = k then 1 else 0 := by
                    apply ULift.ext
                    rw [hdown_sum, hMatCancel g k l]
                    split_ifs <;> rfl
                  rw [hsum_ulift]
                  split_ifs <;> simp
                simp_rw [h_inner]
                simp
              have ht_rhs : c_diag ℋ (obj_WV W) (u_i (R_sh.obj ℋ) W r' k) = _ :=
                ht_u _ fun g =>
                  (map_sum _ _ _).trans
                    ((Finset.sum_congr rfl fun j _ => hterm g j).trans (hcollapse g))
              exact ht_lhs.trans ht_rhs.symm
            · exact @Subsingleton.elim _
                (hEmptySub ℋ _ ⟨fun z => by
                  have hz : z.1 ∈ (⊥ : (Fgt.obj (obj_WV W)).left.Opens) := z.2
                  exact hz⟩) _ _ }

    have hAdd : T_sh.Additive :=
      { map_add := fun {_ _ _ _} => by
          apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext opW
          apply ModuleCat.hom_ext; apply LinearMap.ext; intro s; apply Subtype.ext; funext i
          rfl }
    have _ : T_sh.Additive := hAdd
    have _ : CategoryTheory.Limits.PreservesColimitsOfSize.{u + 1, u + 1} T_sh :=
      adj.leftAdjoint_preservesColimits
    have hColim : CategoryTheory.Limits.PreservesFiniteColimits T_sh :=
      CategoryTheory.Limits.PreservesColimitsOfSize.preservesFiniteColimits T_sh

    have hLim : CategoryTheory.Limits.PreservesFiniteLimits T_sh := by
      have : ∀ {X Y : 𝒞} (f : Quiver.Hom X Y),
          CategoryTheory.Limits.PreservesLimit (CategoryTheory.Limits.parallelPair f 0) T_sh := by
        intro X Y f
        refine ⟨fun {c_cone} hc => ⟨?_⟩⟩
        let c : CategoryTheory.Limits.KernelFork f := c_cone
        let hc' : CategoryTheory.Limits.IsLimit c := hc
        let adj_sh := CategoryTheory.sheafificationAdjunction J_top (ModuleCat.{u, u} R)
        have _ : CategoryTheory.Limits.PreservesLimitsOfSize.{u + 1, u + 1}
            (CategoryTheory.sheafToPresheaf J_top (ModuleCat.{u, u} R)) :=
          adj_sh.rightAdjoint_preservesLimits
        have _ : (CategoryTheory.sheafToPresheaf J_top (ModuleCat.{u, u} R)).PreservesZeroMorphisms :=
          { map_zero := fun _ _ => rfl }
        have hKerMod : ∀ V₀ : S.Etale,
            Function.Injective ((c.ι.hom.app (Opposite.op V₀)).hom) ∧
            ∀ (x : ↑(X.obj.obj (Opposite.op V₀))),
              (f.hom.app (Opposite.op V₀)).hom x = 0 →
              ∃ k : ↑(c.pt.obj.obj (Opposite.op V₀)),
                (c.ι.hom.app (Opposite.op V₀)).hom k = x := by
          intro V₀
          let F_mod : 𝒞 ⥤ ModuleCat.{u, u} R :=
            CategoryTheory.sheafToPresheaf J_top (ModuleCat.{u, u} R) ⋙
              (CategoryTheory.evaluation (Opposite S.Etale) (ModuleCat.{u, u} R)).obj (Opposite.op V₀)
          have hc_ker : CategoryTheory.Limits.IsLimit (c.map F_mod) :=
            CategoryTheory.Limits.KernelFork.mapIsLimit c hc' F_mod
          have hmono : CategoryTheory.Mono ((c.map F_mod).ι) :=
            CategoryTheory.Limits.Fork.IsLimit.mono hc_ker
          have hinj : Function.Injective ((c.ι.hom.app (Opposite.op V₀)).hom) :=
            (ModuleCat.mono_iff_injective (c.ι.hom.app (Opposite.op V₀))).mp hmono
          refine ⟨hinj, fun x hx => ?_⟩
          let g_x : Quiver.Hom (ModuleCat.of R R) (X.obj.obj (Opposite.op V₀)) :=
            ModuleCat.ofHom (LinearMap.toSpanSingleton R _ x)
          have hgx_zero : CategoryTheory.CategoryStruct.comp g_x (F_mod.map f) = 0 := by
            apply ModuleCat.hom_ext
            apply LinearMap.ext_ring
            change (f.hom.app (Opposite.op V₀)).hom (g_x.hom 1) = 0
            have hg1 : g_x.hom 1 = x :=
              (LinearMap.toSpanSingleton_apply R _ x 1).trans (one_smul R x)
            rw [hg1, hx]
          obtain ⟨l_x, hl_x⟩ := CategoryTheory.Limits.KernelFork.IsLimit.lift' hc_ker g_x hgx_zero
          refine ⟨l_x.hom 1, ?_⟩
          have hl1 := congrArg
            (fun (τ : Quiver.Hom (ModuleCat.of R R) (X.obj.obj (Opposite.op V₀))) => τ.hom 1) hl_x
          change (c.ι.hom.app (Opposite.op V₀)).hom (l_x.hom 1) = g_x.hom 1 at hl1
          exact hl1.trans ((LinearMap.toSpanSingleton_apply R _ x 1).trans (one_smul R x))
        have hι_inj : ∀ V₀ : S.Etale,
            Function.Injective ((c.ι.hom.app (Opposite.op V₀)).hom) :=
          fun V₀ => (hKerMod V₀).1
        have hKerPt : ∀ (V₀ : S.Etale) (x : ↑(X.obj.obj (Opposite.op V₀))),
            (f.hom.app (Opposite.op V₀)).hom x = 0 →
            ∃ k : ↑(c.pt.obj.obj (Opposite.op V₀)),
              (c.ι.hom.app (Opposite.op V₀)).hom k = x :=
          fun V₀ => (hKerMod V₀).2
        refine (CategoryTheory.Limits.KernelFork.isLimitMapConeEquiv c T_sh).symm ?_
        refine CategoryTheory.Limits.Fork.IsLimit.mk' (c.map T_sh) fun s_fork => ?_
        let A : 𝒞 := s_fork.pt
        let g_A : Quiver.Hom A (T_sh.obj X) := s_fork.ι
        have hg_A : CategoryTheory.CategoryStruct.comp g_A (T_sh.map f) = 0 :=
          CategoryTheory.Limits.KernelFork.condition s_fork
        have hg_ker : ∀ (W : S.Etale) (a : ↑(A.obj.obj (Opposite.op W))) (i : Fin M),
            (f.hom.app (Opposite.op (obj_WV W))).hom
              (((g_A.hom.app (Opposite.op W)).hom a).1 i) = 0 := fun W a i =>
          congrArg (fun (τ : Quiver.Hom A (T_sh.obj Y)) =>
            ((τ.hom.app (Opposite.op W)).hom a).1 i) hg_A
        let k_fn : ∀ (W : S.Etale) (a : ↑(A.obj.obj (Opposite.op W))) (i : Fin M),
            ↑(c.pt.obj.obj (Opposite.op (obj_WV W))) :=
          fun W a i => Classical.choose (hKerPt (obj_WV W) _ (hg_ker W a i))
        have hk_spec : ∀ (W : S.Etale) (a : ↑(A.obj.obj (Opposite.op W))) (i : Fin M),
            (c.ι.hom.app (Opposite.op (obj_WV W))).hom
              (k_fn W a i) = ((g_A.hom.app (Opposite.op W)).hom a).1 i :=
          fun W a i => Classical.choose_spec (hKerPt (obj_WV W) _ (hg_ker W a i))
        have hk_mem : ∀ (W : S.Etale) (a : ↑(A.obj.obj (Opposite.op W))),
            k_fn W a ∈ T_sub c.pt W := by
          intro W a
          rcases ((g_A.hom.app (Opposite.op W)).hom a).2 with ⟨⟨W₀, hcov, h0⟩, heq⟩
          refine ⟨⟨W₀, hcov, fun i => ?_⟩, fun γ m_g hm1 hm2 i => ?_⟩
          · apply hι_inj (obj_W₀V W W₀)
            have hnat := congrArg
              (fun (τ : Quiver.Hom (c.pt.obj.obj (Opposite.op (obj_WV W)))
                (X.obj.obj (Opposite.op (obj_W₀V W W₀)))) => τ.hom (k_fn W a i))
              (c.ι.hom.naturality (Opposite.op (inc_W₀ W W₀)))
            exact hnat.trans
              ((congrArg (X.obj.map (Opposite.op (inc_W₀ W W₀))).hom (hk_spec W a i)).trans
                ((h0 i).trans
                  (map_zero (c.ι.hom.app (Opposite.op (obj_W₀V W W₀))).hom).symm))
          · apply hι_inj (obj_WV W)
            have hnat := congrArg
              (fun (τ : Quiver.Hom (c.pt.obj.obj (Opposite.op (obj_WV W)))
                (X.obj.obj (Opposite.op (obj_WV W)))) => τ.hom (k_fn W a i))
              (c.ι.hom.naturality (Opposite.op m_g))
            refine hnat.trans
              ((congrArg (X.obj.map (Opposite.op m_g)).hom (hk_spec W a i)).trans
                ((heq γ m_g hm1 hm2 i).trans ?_))
            exact ((map_sum (c.ι.hom.app (Opposite.op (obj_WV W))).hom _ _).trans
              (Finset.sum_congr rfl fun j _ =>
                (map_smul (c.ι.hom.app (Opposite.op (obj_WV W))).hom _ _).trans
                  (congrArg (modSmul (X.obj.obj (Opposite.op (obj_WV W))) _)
                    (hk_spec W a j)))).symm
        let lift_hom : Quiver.Hom A (T_sh.obj c.pt) :=
          { hom :=
              { app := fun opW => ModuleCat.ofHom
                  { toFun := fun a => ⟨k_fn opW.unop a, hk_mem opW.unop a⟩
                    map_add' := fun a₁ a₂ => Subtype.ext (funext fun i => hι_inj _
                      ((hk_spec opW.unop (a₁ + a₂) i).trans
                        ((congrArg (fun s => (s : ↥(T_sub X opW.unop)).1 i)
                          (map_add (g_A.hom.app opW).hom a₁ a₂)).trans
                          ((congrArg₂ (· + ·)
                            (hk_spec opW.unop a₁ i).symm
                            (hk_spec opW.unop a₂ i).symm).trans
                            (map_add (c.ι.hom.app
                              (Opposite.op (obj_WV opW.unop))).hom _ _).symm))))
                    map_smul' := fun r a => Subtype.ext (funext fun i => hι_inj _
                      ((hk_spec opW.unop (r • a) i).trans
                        ((congrArg (fun s => (s : ↥(T_sub X opW.unop)).1 i)
                          (map_smul (g_A.hom.app opW).hom r a)).trans
                          ((congrArg (modSmul (X.obj.obj (Opposite.op (obj_WV opW.unop))) r)
                            (hk_spec opW.unop a i).symm).trans
                            (map_smul (c.ι.hom.app
                              (Opposite.op (obj_WV opW.unop))).hom r _).symm)))) }
                naturality := fun {opW₂ opW₁} opu => by
                  apply ModuleCat.hom_ext; apply LinearMap.ext; intro a
                  apply Subtype.ext; funext i
                  apply hι_inj (obj_WV opW₁.unop)
                  have hnat_ι := congrArg
                    (fun (τ : Quiver.Hom
                      (c.pt.obj.obj (Opposite.op (obj_WV opW₂.unop)))
                      (X.obj.obj (Opposite.op (obj_WV opW₁.unop)))) =>
                      τ.hom (k_fn opW₂.unop a i))
                    (c.ι.hom.naturality (Opposite.op (u_can opu.unop)))
                  have hnat_g := congrArg
                    (fun (τ : Quiver.Hom (A.obj.obj opW₂)
                      ((T_sh.obj X).obj.obj opW₁)) => (τ.hom a).1 i)
                    (g_A.hom.naturality opu)
                  exact (hk_spec opW₁.unop _ i).trans
                    (hnat_g.trans
                      ((congrArg (X.obj.map (Opposite.op (u_can opu.unop))).hom
                        (hk_spec opW₂.unop a i).symm).trans hnat_ι.symm)) } }
        refine ⟨lift_hom, ?_, ?_⟩
        · apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext opW
          apply ModuleCat.hom_ext; apply LinearMap.ext; intro a
          apply Subtype.ext; funext i
          exact hk_spec opW.unop a i
        · intro m_hom hm_hom
          apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext opW
          apply ModuleCat.hom_ext; apply LinearMap.ext; intro a
          apply Subtype.ext; funext i
          apply hι_inj (obj_WV opW.unop)
          exact (congrArg (fun (τ : Quiver.Hom A (T_sh.obj X)) =>
            ((τ.hom.app opW).hom a).1 i) hm_hom).trans (hk_spec opW.unop a i).symm
      exact CategoryTheory.Functor.preservesFiniteLimits_of_preservesKernels T_sh

    refine ⟨T_sh, R_sh, hAdd, hLim, hColim, adj, triv_T, triv_R,
      fun 𝒢 W => ⟨Subtype.val_injective, Subtype.range_coe⟩,
      fun 𝒢 {W₁ W₂} u u_WV hu1 hu2 s i =>
        congrArg (fun φ => (𝒢.obj.map (Opposite.op φ)).hom (s.1 i)) (hu_unique u u_WV hu1 hu2).symm,
      fun {_ _} _ _ _ _ => rfl,
      fun ℋ W => ⟨Subtype.val_injective, Subtype.range_coe⟩,
      fun ℋ {W₁ W₂} u u_WV hu1 hu2 s i =>
        congrArg (fun φ => (ℋ.obj.map (Opposite.op φ)).hom (s.1 i)) (hu_unique u u_WV hu1 hu2).symm,
      fun ℋ W s => ?_⟩
    let h_W := (Fgt.obj W).hom
    let W_V := CategoryTheory.Limits.pullback h_W ι_V
    let δ_W : Quiver.Hom W_V (CategoryTheory.Limits.pullback ((Fgt.obj (obj_WV W)).hom) ι_V) :=
      CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id W_V)
