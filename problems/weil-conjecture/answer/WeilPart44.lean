      have hτ_π₂_pt : (CategoryTheory.CategoryStruct.comp τ_Q π₂).base pt_k = γ_x.base pt_k := by
        change π₂.base (τ_Q.base pt_k) = γ_x.base pt_k
        rw [hτ_Q_pt, hπ₂_q, hγ_x_pt]
      have hτ_π₂ : CategoryTheory.CategoryStruct.comp τ_Q π₂ = γ_x :=
        hSecEq (CategoryTheory.CategoryStruct.comp f_x p_chart)
