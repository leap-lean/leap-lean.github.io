      let p_W : Quiver.Hom (obj_WV W) W :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.fst h_W ι_V) rfl trivial
      let c_sum : ZMod m :=
        Finset.univ.sum (fun i : Fin M =>
          L.triv_dual (obj_WV W) (triv_T L.ℳ_dual W s i) (δ_W.base y) i)
      let s_R := ((T_sh.map e_dual.hom).hom.app (Opposite.op W)).hom s
