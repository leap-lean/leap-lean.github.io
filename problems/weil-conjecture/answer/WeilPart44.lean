      rw [hcol, map_sum]
      simp [vecOf, Matrix.mulVec, dotProduct, Matrix.transpose_apply, map_smul, smul_eq_mul]
    have hmem_I_of_scale : ∀ (ψ : U₁) (k : ℕ) (w : Fin N → PadicInt ℓ),
