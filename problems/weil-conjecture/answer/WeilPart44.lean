          (θ_S (r + 1) Y g)).symm
      have hs3 : ((weilEtaleTorsionSheaf S (ℓ ^ (r + 1 + 1))).obj.map (Opposite.op j_y)).hom
            (θ_S (r + 1) Y g) =
