            have hcomm_g : (m • 𝟙 SC.X₂) ≫ SC.g = SC.g ≫ (m • 𝟙 SC.X₃) := by simp
            dsimp [ap] at hb ⊢
            rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply, ← hcomm_g,
              CategoryTheory.Abelian.Pseudoelement.comp_apply, hb,
              ← CategoryTheory.Abelian.Pseudoelement.comp_apply, SC.zero,
