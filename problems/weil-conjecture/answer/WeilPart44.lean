          have hx₁' : (q_VV W).base (((CategoryTheory.CategoryStruct.comp a₂ (σ_g W g₂)).left).base z) ∈
              Set.range (γ_map g₁).base := (Set.ext_iff.mp (hσ_range W g₁) _).mp hx₁_eq
          have hx₂' : (q_VV W).base (((CategoryTheory.CategoryStruct.comp a₂ (σ_g W g₂)).left).base z) ∈
