      { toFun := ULift.down
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hLiftTorsionSheaf : ∀ (ℬ : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        m • 𝟙 ℬ = 0 →
        ∃ (ℬ_mod : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)), U.obj ℬ_mod = ℬ := by
