                (TensorProduct.tmul C₀ 1 1) 1)) (e₂ : k) := by
            rw [hι_right]
            change TensorProduct.tmul ↥E₂ (algebraMap ↥E₂ C₁_E₂ e₂) (1 : k) = _
            rw [Algebra.algebraMap_eq_smul_one (R := ↥E₂) (A := C₁_E₂),
