          have hmap_left : map₁₂_k (TensorProduct.tmul ↥E₁ (q₁_E₁ u) 1) =
              TensorProduct.tmul ↥E₁ (q₁_E₁ u) 1 :=
            Algebra.TensorProduct.map_tmul _ _ (q₁_E₁ u) 1
          exact (congrArg (fun x => Ψ_E₂ (inc_Ck₂ x)) hι_left).trans
            ((hj_R_Ψ u).trans (congrArg Ψ_E₁ hmap_left.symm))
        · have hι_right : ι₁₂ (TensorProduct.tmul ↥E₁ 1 e₂) = algebraMap ↥E₂ C₁_E₂ e₂ :=
            (Algebra.TensorProduct.lift_tmul ι₁₂_left ι₁₂_right _ 1 e₂).trans
