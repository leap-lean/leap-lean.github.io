        exact CategoryTheory.Category.id_comp _
      have hr_eq : (adj_T.unit.app R_mod).hom r = (η_sh.app (Opposite.op T)).hom r :=
        congrArg (fun φ => φ.hom r) hadj_unit
      exact (congrArg (fun s => ev_lc T s z) hr_eq).trans (h_eta T r z)
    · intro W s y
      let f := ev_lc W s
      let r₀ : R := f y
      let W_sch : AlgebraicGeometry.Scheme.{u} := (Fgt.obj W).left
      let Ω₀ : W_sch.Opens := ⟨f ⁻¹' {r₀}, f.isLocallyConstant {r₀}⟩
      have hU₀_et : AlgebraicGeometry.Etale (Ω₀.ι ≫ (Fgt.obj W).hom) :=
        CategoryTheory.MorphismProperty.comp_mem P_et Ω₀.ι (Fgt.obj W).hom inferInstance W.prop
      let U₀' : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (Ω₀.ι ≫ (Fgt.obj W).hom) hU₀_et
      let v₀ : Quiver.Hom U₀' W := CategoryTheory.MorphismProperty.Over.homMk Ω₀.ι rfl trivial
      have hy_mem : y ∈ (Ω₀ : Set ↥W_sch) := rfl
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι Ω₀] at hy_mem
      obtain ⟨z₀, hz₀⟩ := hy_mem
      refine ⟨U₀', v₀, z₀, hz₀, ?_⟩
      apply (ev_lc U₀').injective
      apply LocallyConstant.ext
      intro z
      have hz_mem : ev_lc W s (((Fgt.map v₀).left).base z) = r₀ := by
        change Ω₀.ι.base z ∈ (Ω₀ : Set ↥W_sch)
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι Ω₀]
        exact ⟨z, rfl⟩
      exact (h_nat v₀ s z).trans (hz_mem.trans (h_eta U₀' r₀ z).symm)
  · 
    intro hInt U hU_ne V π hSurj W α f₁ f₂ heq
    have : AlgebraicGeometry.IsIntegral S := hInt
    have : IrreducibleSpace ↥S := AlgebraicGeometry.irreducibleSpace_of_isIntegral S
    let h_W := (Fgt.obj W).hom
    have : AlgebraicGeometry.Etale h_W := W.prop
    let ι_V := CategoryTheory.CategoryStruct.comp π U.ι
    let p_W := CategoryTheory.Limits.pullback.fst h_W ι_V
    ext x
    let Ω : Set ↥((Fgt.obj W).left) := (f₁ ⁻¹' {f₁ x}) ∩ (f₂ ⁻¹' {f₂ x})
    have hΩ_open : IsOpen Ω :=
      (f₁.isLocallyConstant {f₁ x}).inter (f₂.isLocallyConstant {f₂ x})
    have hx_Ω : x ∈ Ω := ⟨rfl, rfl⟩
    let O₁ : Set ↥S := h_W.base '' Ω
    have hO₁_open : IsOpen O₁ := h_W.isOpenMap Ω hΩ_open
    have hO₁_ne : O₁.Nonempty := ⟨h_W.base x, x, hx_Ω, rfl⟩
    let O₂ : Set ↥S := (U : Set ↥S)
    have hO₂_open : IsOpen O₂ := U.isOpen
    obtain ⟨u_pt, hu_pt⟩ := hU_ne
    have hO₂_ne : O₂.Nonempty := ⟨u_pt, hu_pt⟩
    obtain ⟨s₀, ⟨z, ⟨hz₁, hz₂⟩, hz_eq⟩, hs₀_U⟩ :=
      nonempty_preirreducible_inter hO₁_open hO₂_open hO₁_ne hO₂_ne
    have hs₀_range : s₀ ∈ Set.range U.ι.base := by
      rwa [AlgebraicGeometry.Scheme.Opens.range_ι U]
    obtain ⟨u₀, hu₀⟩ := hs₀_range
    obtain ⟨v₀, hv₀⟩ := (AlgebraicGeometry.surjective_iff π).mp hSurj u₀
    have hzv_eq : h_W.base z = ι_V.base v₀ := by
      change h_W.base z = (π ≫ U.ι).base v₀
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hv₀, hu₀, hz_eq]
    obtain ⟨y₀, hy₀, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z v₀ hzv_eq
    have hf₁_eq : f₁ z = f₁ x := hz₁
    have hf₂_eq : f₂ z = f₂ x := hz₂
    calc
      f₁ x = f₁ z := hf₁_eq.symm
      _ = f₁ (p_W.base y₀) := congrArg f₁ hy₀.symm
      _ = f₂ (p_W.base y₀) := heq y₀
      _ = f₂ z := congrArg f₂ hy₀
      _ = f₂ x := hf₂_eq
  · 
    classical
    intro U V π hEt hSurj W α _ c_tilde W₀ hCov hFib hVan
    let h_W := (Fgt.obj W).hom
    have : AlgebraicGeometry.Etale h_W := W.prop
    let ι_V := CategoryTheory.CategoryStruct.comp π U.ι
    have : AlgebraicGeometry.Etale ι_V := hEt
    let P := CategoryTheory.Limits.pullback h_W ι_V
    let p_W := CategoryTheory.Limits.pullback.fst h_W ι_V
    let p_V := CategoryTheory.Limits.pullback.snd h_W ι_V
    let W_U : ((Fgt.obj W).left).Opens := (TopologicalSpace.Opens.map h_W.base).obj U
    have hLift : ∀ (x : ↥((Fgt.obj W).left)), x ∈ W_U → ∃ y : ↥P, p_W.base y = x := by
      intro x hx
      have hx_U : h_W.base x ∈ Set.range U.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι U]
        exact hx
      obtain ⟨u₀, hu₀⟩ := hx_U
      obtain ⟨v₀, hv₀⟩ := (AlgebraicGeometry.surjective_iff π).mp hSurj u₀
      have hxv_eq : h_W.base x = ι_V.base v₀ := by
        change h_W.base x = (π ≫ U.ι).base v₀
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hv₀, hu₀]
      obtain ⟨y, hy, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x v₀ hxv_eq
      exact ⟨y, hy⟩
    have hIm : ∀ y : ↥P, p_W.base y ∈ W_U := by
      intro y
      show h_W.base (p_W.base y) ∈ (U : Set ↥S)
      have hcond : (p_W ≫ h_W).base y = (p_V ≫ ι_V).base y :=
        congrArg (fun (f : P ⟶ S) => f.base y)
          (CategoryTheory.Limits.pullback.condition (f := h_W) (g := ι_V))
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply] at hcond
      rw [hcond]
      change (π ≫ U.ι).base (p_V.base y) ∈ (U : Set ↥S)
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply, ← AlgebraicGeometry.Scheme.Opens.range_ι U]
      exact ⟨π.base (p_V.base y), rfl⟩
    let c_bar_fn : ↥((Fgt.obj W).left) → α :=
      fun x => if hx : x ∈ W_U then c_tilde (Classical.choose (hLift x hx)) else 0
    have hPull : ∀ y : ↥P, c_bar_fn (p_W.base y) = c_tilde y := by
      intro y
      dsimp only [c_bar_fn]
      split_ifs with hx
      · exact hFib (Classical.choose (hLift (p_W.base y) hx)) y
          (Classical.choose_spec (hLift (p_W.base y) hx))
      · exact False.elim (hx (hIm y))
    have hZero : ∀ x : ↥((Fgt.obj W).left), x ∈ W₀ → c_bar_fn x = 0 := by
      intro x hx₀
      dsimp only [c_bar_fn]
      split_ifs with hxU
      · let y_star := Classical.choose (hLift x hxU)
        have hy_star : p_W.base y_star = x := Classical.choose_spec (hLift x hxU)
        exact hVan y_star (hy_star.symm ▸ hx₀)
      · rfl
    have h_isLC : IsLocallyConstant c_bar_fn := by
      intro E
      have hUniv : (W_U : Set ↥((Fgt.obj W).left)) ∪ (W₀ : Set ↥((Fgt.obj W).left)) = Set.univ := by
        have hc := congrArg (fun O : ((Fgt.obj W).left).Opens => (O : Set ↥((Fgt.obj W).left))) hCov
        rwa [TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_top] at hc
      have hDecomp : c_bar_fn ⁻¹' E =
          (c_bar_fn ⁻¹' E ∩ (W_U : Set ↥((Fgt.obj W).left))) ∪
          (c_bar_fn ⁻¹' E ∩ (W₀ : Set ↥((Fgt.obj W).left))) := by
        rw [← Set.inter_union_distrib_left, hUniv, Set.inter_univ]
      rw [hDecomp]
      apply IsOpen.union
      · have hPiece₁ : c_bar_fn ⁻¹' E ∩ (W_U : Set ↥((Fgt.obj W).left)) =
            p_W.base '' (c_tilde ⁻¹' E) := by
          ext x
          constructor
          · rintro ⟨hxE, hxU⟩
            obtain ⟨y, rfl⟩ := hLift x hxU
            refine ⟨y, ?_, rfl⟩
            show c_tilde y ∈ E
            rwa [← hPull y]
          · rintro ⟨y, hyE, rfl⟩
            refine ⟨?_, hIm y⟩
            show c_bar_fn (p_W.base y) ∈ E
            rwa [hPull y]
        rw [hPiece₁]
        exact p_W.isOpenMap (c_tilde ⁻¹' E) (c_tilde.isLocallyConstant E)
      · by_cases h0 : (0 : α) ∈ E
        · have hPiece₂ : c_bar_fn ⁻¹' E ∩ (W₀ : Set ↥((Fgt.obj W).left)) =
              (W₀ : Set ↥((Fgt.obj W).left)) := by
            ext x
            constructor
            · exact fun hx => hx.2
            · intro hx₀
              refine ⟨?_, hx₀⟩
              show c_bar_fn x ∈ E
              rw [hZero x hx₀]
              exact h0
          rw [hPiece₂]
          exact W₀.isOpen
        · have hPiece₂ : c_bar_fn ⁻¹' E ∩ (W₀ : Set ↥((Fgt.obj W).left)) = ∅ := by
            ext x
            constructor
            · rintro ⟨hxE, hx₀⟩
              have hc0 : c_bar_fn x = 0 := hZero x hx₀
              exact False.elim (h0 (hc0 ▸ hxE))
            · exact False.elim
          rw [hPiece₂]
          exact isOpen_empty
    exact ⟨⟨c_bar_fn, h_isLC⟩, hPull, hZero⟩

theorem weil_mid_ext_pinned_shriek_level_transition_cup (S : AlgebraicGeometry.Scheme.{u}) (hInt : AlgebraicGeometry.IsIntegral S)
