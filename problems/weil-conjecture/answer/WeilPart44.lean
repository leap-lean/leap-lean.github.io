          (CategoryTheory.CategoryStruct.comp iso_bar.hom φ_cur) αM =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp iso_bar.hom α_bar) (P.map φ_next) := by
