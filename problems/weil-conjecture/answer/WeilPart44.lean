    intro m p K₀ hTF_K₀ ℐ _ e
    let R := ULift.{u, 0} (ZMod m)
    let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    let U := U_mod m
    let Y : CategoryTheory.Sheaf J AddCommGrpCat.{u} := U.obj ℐ
    let isTF (K : CategoryTheory.Sheaf J AddCommGrpCat.{u}) : Prop :=
      ∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • 𝟙 K)
    have isTF_sub : ∀ {K' P : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (ι : K' ⟶ P)
