        obtain ⟨z', rfl⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ FZ hUS y' hy'_i rfl
        obtain ⟨z, rfl⟩ := (ih Q_sh).2 z'
        exact ⟨z.comp hS.extClass rfl, hΘ_ext z⟩

  
  
  
