    have hComm_bock : ∀ (a b c : ℕ) (hc : a + b + 1 = c) (hc' : (a + 1) + b + 1 = c + 1),
        CategoryTheory.CategoryStruct.comp (τ_𝒥_ab_step a) (ι_bock_sh a b c hc) =
          CategoryTheory.CategoryStruct.comp (ι_bock_sh (a + 1) b (c + 1) hc') (τ_𝒥_ab_step c) := by
      intro a b c hc hc'
      have hac : a ≤ c := by omega
      have hac' : a + 1 ≤ c + 1 := by omega
      apply hSheafHomExt_J
      intro W s_up y_c i
      obtain ⟨y_top, rfl⟩ := hm_ι_surj c (Fgt.obj W).hom y_c
      let h_W := (Fgt.obj W).hom
      have hp_comm : ∀ {d : ℕ} (hd : a + 1 ≤ d),
          p_le (Nat.le_of_succ_le hd) = p_le hd ≫ p_ι a := by
        intro d hd
        induction hd with
        | refl =>
          rw [hp_le_refl, CategoryTheory.Category.id_comp, hp_le_step (le_refl a),
            hp_le_refl, CategoryTheory.Category.comp_id]
        | @step d hd ih =>
          rw [hp_le_step (Nat.le_of_succ_le hd), ih, hp_le_step hd, CategoryTheory.Category.assoc]
      have hm_comm : m_ι_can c h_W ≫ m_le h_W hac = m_le h_W hac' ≫ m_ι_can a h_W := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc (m_le h_W hac'),
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc]
          congr 1
          rw [← hp_le_step hac]
          exact hp_comm hac'
      have hbase : (m_le h_W hac).base ((m_ι_can c h_W).base y_top) =
          (m_ι_can a h_W).base ((m_le h_W hac').base y_top) :=
        congrArg (fun k => k.base y_top) hm_comm
      change triv_J c W (((ι_bock_sh a b c hc).hom.app (Opposite.op W)).hom
          (((τ_𝒥_ab_step a).hom.app (Opposite.op W)).hom s_up))
          ((m_ι_can c h_W).base y_top) i =
        triv_J c W (((τ_𝒥_ab_step c).hom.app (Opposite.op W)).hom
          (((ι_bock_sh (a + 1) b (c + 1) hc').hom.app (Opposite.op W)).hom s_up))
          ((m_ι_can c h_W).base y_top) i
      rw [hι_bock_spec a b c hc hac, hbase, hτ_𝒥_spec a, hτ_𝒥_spec c,
        hι_bock_spec (a + 1) b (c + 1) hc' hac']
