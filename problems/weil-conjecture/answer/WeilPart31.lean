            · exact hcomm_νη.mul_right (Commute.refl ν)
          have hcomm_1_23 : Commute ((μ ^ s') • ν) (μ • η + η * ν) := by
            change ((μ ^ s') • ν) * (μ • η + η * ν) = (μ • η + η * ν) * ((μ ^ s') • ν)
