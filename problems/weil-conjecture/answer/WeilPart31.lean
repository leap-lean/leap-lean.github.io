        rw [Equiv.symm_apply_apply]
        have hsub := congrArg ULift.down (hμ_φ ((eΥ0 G).symm α))
        change (μ_φ ((eΥ0 G).symm α).1).down = (L_φ ((eΥ0 G).symm α)).down at hsub
        rw [hsub, hL_φ]
        change φ (eΥ0 G ((eΥ0 G).symm α)) = φ α
        rw [(eΥ0 G).apply_symm_apply]
      have hΩΘ_ker : ∀ (G : 𝒞₀) (f : G ⟶ 𝒥₀ 0), Ω₀ G f = 0 ↔ Θ₀ G f = 0 := by
        intro G f
        constructor
        · intro hΩ0
          obtain ⟨g₀, hg₀⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
            G hSC₀ (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.zero_add 1) hΩ0
          let g : G ⟶ 𝒥₀ 1 := CategoryTheory.Abelian.Ext.addEquiv₀ g₀
          have hg_mk : CategoryTheory.Abelian.Ext.mk₀ g = g₀ :=
            CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply g₀
          rw [← hg_mk, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hg₀
