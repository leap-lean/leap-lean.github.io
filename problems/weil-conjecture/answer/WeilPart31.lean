          rw [← hw₀]
        · intro f₁ hf₁
          let g₁ : F ⟶ one₀ := CategoryTheory.Abelian.Ext.addEquiv₀ f₁
          have hg₁_mk : CategoryTheory.Abelian.Ext.mk₀ g₁ = f₁ :=
            CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply f₁
          have hg₁_eq : g₁ = f₀ := by
            rw [← CategoryTheory.cancel_mono t_S₀]
