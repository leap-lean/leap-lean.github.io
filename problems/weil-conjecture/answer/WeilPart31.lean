        (β_cart g₁ hg₁ i₁ i₂ g_Z1 hpb₁).hom ≫
          (res_et g₁ hg₁).map (β_cart g₂ hg₂ i₂ i₃ g_Z2 hpb₂).hom := by
    intro Z₁ Y₁ Z₂ Y₂ Z₃ Y₃ g₁ hg₁ g₂ hg₂ g₁₂ hg₁₂ i₁ hi₁ i₂ i₃
      g_Z1 hpb₁ g_Z2 hpb₂ g_Z12 hpb₁₂ σ hσ_T
    have hEpi₁ : CategoryTheory.Epi (q_can i₁) :=
      hEpiQ i₁ (hContB Z₁ Y₁ i₁) hi₁ (T_can Y₁) (hT_can Y₁) (T_can Z₁) (hT_can Z₁)
    have hπ_coh := hCoh_π g₁ hg₁ g₂ hg₂ g₁₂ hg₁₂ σ hσ_T
    apply (CategoryTheory.cancel_epi (q_can i₁)).mp
    calc
      q_can i₁ ≫ ((β_cart g₁₂ hg₁₂ i₁ i₃ g_Z12 hpb₁₂).hom ≫
          σ.hom.app ((push_all i₃).obj (One_sh Z₃)))
          = (q_can i₁ ≫ (β_cart g₁₂ hg₁₂ i₁ i₃ g_Z12 hpb₁₂).hom) ≫
              σ.hom.app ((push_all i₃).obj (One_sh Z₃)) :=
            (CategoryTheory.Category.assoc _ _ _).symm
      _ = (π_can g₁₂ hg₁₂).inv ≫ ((res_et g₁₂ hg₁₂).map (q_can i₃) ≫
              σ.hom.app ((push_all i₃).obj (One_sh Z₃))) := by
            rw [hβ_cart g₁₂ hg₁₂ i₁ i₃ g_Z12 hpb₁₂, CategoryTheory.Category.assoc]
      _ = ((π_can g₁₂ hg₁₂).inv ≫ σ.hom.app (One_sh Y₃)) ≫
            (res_et g₁ hg₁).map ((res_et g₂ hg₂).map (q_can i₃)) := by
            rw [σ.hom.naturality (q_can i₃), ← CategoryTheory.Category.assoc]
            rfl
      _ = (π_can g₁ hg₁).inv ≫ ((res_et g₁ hg₁).map (π_can g₂ hg₂).inv ≫
            (res_et g₁ hg₁).map ((res_et g₂ hg₂).map (q_can i₃))) := by
            rw [hπ_coh, CategoryTheory.Category.assoc]
      _ = (π_can g₁ hg₁).inv ≫
            (res_et g₁ hg₁).map ((π_can g₂ hg₂).inv ≫ (res_et g₂ hg₂).map (q_can i₃)) := by
            rw [← (res_et g₁ hg₁).map_comp]
      _ = (π_can g₁ hg₁).inv ≫
            (res_et g₁ hg₁).map (q_can i₂ ≫ (β_cart g₂ hg₂ i₂ i₃ g_Z2 hpb₂).hom) := by
            rw [← hβ_cart g₂ hg₂ i₂ i₃ g_Z2 hpb₂]
      _ = ((π_can g₁ hg₁).inv ≫ (res_et g₁ hg₁).map (q_can i₂)) ≫
            (res_et g₁ hg₁).map (β_cart g₂ hg₂ i₂ i₃ g_Z2 hpb₂).hom := by
            rw [(res_et g₁ hg₁).map_comp, CategoryTheory.Category.assoc]
      _ = q_can i₁ ≫ ((β_cart g₁ hg₁ i₁ i₂ g_Z1 hpb₁).hom ≫
            (res_et g₁ hg₁).map (β_cart g₂ hg₂ i₂ i₃ g_Z2 hpb₂).hom) := by
            rw [← hβ_cart g₁ hg₁ i₁ i₂ g_Z1 hpb₁, CategoryTheory.Category.assoc]

  have hCompResIso : ∀ {S₁ S₂ S₃ : AlgebraicGeometry.Scheme.{u}}
      (g₁ : Quiver.Hom S₁ S₂) (hg₁ : AlgebraicGeometry.Etale g₁)
      (g₂ : Quiver.Hom S₂ S₃) (hg₂ : AlgebraicGeometry.Etale g₂)
      (g₁₂ : Quiver.Hom S₁ S₃) (hg₁₂ : AlgebraicGeometry.Etale g₁₂)
      (hg_eq : CategoryTheory.CategoryStruct.comp g₁ g₂ = g₁₂),
      ∃ (σ : CategoryTheory.Iso (res_et g₁₂ hg₁₂)
          (CategoryTheory.Functor.comp (res_et g₂ hg₂) (res_et g₁ hg₁))),
        ∀ (ℱ : ShMod S₃) (V : S₁.Etale),
          ∃ u_V : Quiver.Hom (((M_et g₁ hg₁).comp (M_et g₂ hg₂)).obj V : S₃.Etale)
              ((M_et g₁₂ hg₁₂).obj V : S₃.Etale),
            ((σ.hom.app ℱ).hom.app (Opposite.op V)) = ℱ.obj.map u_V.op := by
    intro S₁ S₂ S₃ g₁ hg₁ g₂ hg₂ g₁₂ hg₁₂ hg_eq
    let u_mor (V : S₁.Etale) :
        ((M_et g₁ hg₁).comp (M_et g₂ hg₂)).obj V ⟶ (M_et g₁₂ hg₁₂).obj V :=
      CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id V.left)
        (by
          change CategoryTheory.CategoryStruct.id V.left ≫ (V.hom ≫ g₁₂) = (V.hom ≫ g₁) ≫ g₂
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hg_eq])
        trivial
    let v_mor (V : S₁.Etale) :
        (M_et g₁₂ hg₁₂).obj V ⟶ ((M_et g₁ hg₁).comp (M_et g₂ hg₂)).obj V :=
      CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id V.left)
        (by
          change CategoryTheory.CategoryStruct.id V.left ≫ ((V.hom ≫ g₁) ≫ g₂) = V.hom ≫ g₁₂
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hg_eq])
        trivial
    have huv : ∀ V : S₁.Etale, u_mor V ≫ v_mor V = 𝟙 _ := fun V =>
      CategoryTheory.MorphismProperty.Comma.Hom.ext
        (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
    have hvu : ∀ V : S₁.Etale, v_mor V ≫ u_mor V = 𝟙 _ := fun V =>
      CategoryTheory.MorphismProperty.Comma.Hom.ext
        (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
    have hu_nat : ∀ {V₁ V₂ : S₁.Etale} (f : V₁ ⟶ V₂),
        ((M_et g₁ hg₁).comp (M_et g₂ hg₂)).map f ≫ u_mor V₂ =
          u_mor V₁ ≫ (M_et g₁₂ hg₁₂).map f := fun f =>
      CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id f.left).trans
          (CategoryTheory.Category.id_comp f.left).symm)
        (Subsingleton.elim _ _)
    have hv_nat : ∀ {V₁ V₂ : S₁.Etale} (f : V₁ ⟶ V₂),
        (M_et g₁₂ hg₁₂).map f ≫ v_mor V₂ =
          v_mor V₁ ≫ ((M_et g₁ hg₁).comp (M_et g₂ hg₂)).map f := fun f =>
      CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id f.left).trans
          (CategoryTheory.Category.id_comp f.left).symm)
        (Subsingleton.elim _ _)
    refine ⟨{
      hom :=
        { app := fun ℱ =>
            { hom :=
                { app := fun V => ℱ.obj.map (u_mor V.unop).op
                  naturality := fun {V₁ V₂} f =>
                    (ℱ.obj.map_comp _ _).symm.trans
                      ((congrArg (fun k => ℱ.obj.map k.op) (hu_nat f.unop).symm).trans
                        (ℱ.obj.map_comp _ _)) } }
          naturality := fun {ℱ₁ ℱ₂} α => by
            apply CategoryTheory.Sheaf.hom_ext
            apply CategoryTheory.NatTrans.ext
            funext V
            exact (α.hom.naturality (u_mor V.unop).op).symm }
      inv :=
        { app := fun ℱ =>
            { hom :=
                { app := fun V => ℱ.obj.map (v_mor V.unop).op
                  naturality := fun {V₁ V₂} f =>
                    (ℱ.obj.map_comp _ _).symm.trans
                      ((congrArg (fun k => ℱ.obj.map k.op) (hv_nat f.unop).symm).trans
                        (ℱ.obj.map_comp _ _)) } }
          naturality := fun {ℱ₁ ℱ₂} α => by
            apply CategoryTheory.Sheaf.hom_ext
            apply CategoryTheory.NatTrans.ext
            funext V
            exact (α.hom.naturality (v_mor V.unop).op).symm }
      hom_inv_id := by
        apply CategoryTheory.NatTrans.ext; funext ℱ
        apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext V
        change ℱ.obj.map (u_mor V.unop).op ≫ ℱ.obj.map (v_mor V.unop).op = 𝟙 _
        rw [← ℱ.obj.map_comp, ← op_comp, hvu]
        exact ℱ.obj.map_id _
      inv_hom_id := by
        apply CategoryTheory.NatTrans.ext; funext ℱ
        apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext V
        change ℱ.obj.map (v_mor V.unop).op ≫ ℱ.obj.map (u_mor V.unop).op = 𝟙 _
        rw [← ℱ.obj.map_comp, ← op_comp, huv]
        exact ℱ.obj.map_id _ }, fun _ V => ⟨u_mor V, rfl⟩⟩

  have hCartComp : ∀ {Z₁ Y₁ Z₂ Y₂ Z₃ Y₃ : AlgebraicGeometry.Scheme.{u}}
      (g₁ : Quiver.Hom Y₁ Y₂) (hg₁ : AlgebraicGeometry.Etale g₁)
      (g₂ : Quiver.Hom Y₂ Y₃) (hg₂ : AlgebraicGeometry.Etale g₂)
      (g₁₂ : Quiver.Hom Y₁ Y₃) (hg₁₂ : AlgebraicGeometry.Etale g₁₂)
      (hg_eq : CategoryTheory.CategoryStruct.comp g₁ g₂ = g₁₂)
      (i₁ : Quiver.Hom Z₁ Y₁) (hi₁ : AlgebraicGeometry.IsClosedImmersion i₁)
      (i₂ : Quiver.Hom Z₂ Y₂) (hi₂ : AlgebraicGeometry.IsClosedImmersion i₂)
      (i₃ : Quiver.Hom Z₃ Y₃)
      (g_Z1 : Quiver.Hom Z₁ Z₂) (hpb₁ : CategoryTheory.IsPullback i₁ g_Z1 g₁ i₂)
      (g_Z2 : Quiver.Hom Z₂ Z₃) (hpb₂ : CategoryTheory.IsPullback i₂ g_Z2 g₂ i₃)
      (q : ℕ)
      (τ₁ : WeilGysinSupportClass Z₁ Y₁ i₁ m q)
      (τ₂ : WeilGysinSupportClass Z₂ Y₂ i₂ m q)
      (τ₃ : WeilGysinSupportClass Z₃ Y₃ i₃ m q),
      WeilGysinSupportPullback g₁ i₁ i₂ m q τ₁ τ₂ →
      WeilGysinSupportPullback g₂ i₂ i₃ m q τ₂ τ₃ →
      WeilGysinSupportPullback g₁₂ i₁ i₃ m q τ₁ τ₃ := by
    intro Z₁ Y₁ Z₂ Y₂ Z₃ Y₃ g₁ hg₁ g₂ hg₂ g₁₂ hg₁₂ hg_eq
      i₁ hi₁ i₂ hi₂ i₃ g_Z1 hpb₁ g_Z2 hpb₂ q τ₁ τ₂ τ₃ h12 h23
    have hpb₁₂ : CategoryTheory.IsPullback i₁ (g_Z1 ≫ g_Z2) g₁₂ i₃ :=
      hg_eq ▸ (hpb₁.paste_vert hpb₂)
    obtain ⟨σ, hσ⟩ := hCompResIso g₁ hg₁ g₂ hg₂ g₁₂ hg₁₂ hg_eq
    have hσ_T := hσ (One_sh Y₃) (T_can Y₁)
    let hEx₁ := hResAdj g₁ hg₁ (hContM g₁ hg₁) (hContB Y₁ Y₂ g₁)
    let hEx₂ := hResAdj g₂ hg₂ (hContM g₂ hg₂) (hContB Y₂ Y₃ g₂)
    let hEx₁₂ := hResAdj g₁₂ hg₁₂ (hContM g₁₂ hg₁₂) (hContB Y₁ Y₃ g₁₂)
    let _ := hEx₁.2.1; let _ := hEx₁.2.2.1; let _ := hEx₁.2.2.2
    let _ := hEx₂.2.1; let _ := hEx₂.2.2.1; let _ := hEx₂.2.2.2
    let _ := hEx₁₂.2.1; let _ := hEx₁₂.2.2.1; let _ := hEx₁₂.2.2.2
    have hv₁ := (hCartIff g₁ hg₁ i₁ hi₁ i₂ g_Z1 hpb₁ q τ₂ τ₁).mp h12
    have hv₂ := (hCartIff g₂ hg₂ i₂ hi₂ i₃ g_Z2 hpb₂ q τ₃ τ₂).mp h23
    refine (hCartIff g₁₂ hg₁₂ i₁ hi₁ i₃ (g_Z1 ≫ g_Z2) hpb₁₂ q τ₃ τ₁).mpr ?_
    have hβ_eq := hCoh_β g₁ hg₁ g₂ hg₂ g₁₂ hg₁₂ i₁ hi₁ i₂ i₃
      g_Z1 hpb₁ g_Z2 hpb₂ (g_Z1 ≫ g_Z2) hpb₁₂ σ hσ_T
    have hπ_inv := hCoh_π g₁ hg₁ g₂ hg₂ g₁₂ hg₁₂ σ hσ_T
    have hπ_hom : σ.hom.app (One_sh Y₃) ≫
        ((res_et g₁ hg₁).map (π_can g₂ hg₂).hom ≫ (π_can g₁ hg₁).hom) =
        (π_can g₁₂ hg₁₂).hom := by
      have h_id : (π_can g₁₂ hg₁₂).inv ≫ (σ.hom.app (One_sh Y₃) ≫
          ((res_et g₁ hg₁).map (π_can g₂ hg₂).hom ≫ (π_can g₁ hg₁).hom)) = 𝟙 _ := by
        rw [← CategoryTheory.Category.assoc, hπ_inv, CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc ((res_et g₁ hg₁).map (π_can g₂ hg₂).inv),
          ← (res_et g₁ hg₁).map_comp, (π_can g₂ hg₂).inv_hom_id, (res_et g₁ hg₁).map_id,
          CategoryTheory.Category.id_comp, (π_can g₁ hg₁).inv_hom_id]
      calc
        σ.hom.app (One_sh Y₃) ≫ ((res_et g₁ hg₁).map (π_can g₂ hg₂).hom ≫ (π_can g₁ hg₁).hom)
            = ((π_can g₁₂ hg₁₂).hom ≫ (π_can g₁₂ hg₁₂).inv) ≫
                (σ.hom.app (One_sh Y₃) ≫
                  ((res_et g₁ hg₁).map (π_can g₂ hg₂).hom ≫ (π_can g₁ hg₁).hom)) := by
              rw [(π_can g₁₂ hg₁₂).hom_inv_id, CategoryTheory.Category.id_comp]
        _ = (π_can g₁₂ hg₁₂).hom ≫ ((π_can g₁₂ hg₁₂).inv ≫ _) :=
              CategoryTheory.Category.assoc _ _ _
        _ = (π_can g₁₂ hg₁₂).hom := by rw [h_id, CategoryTheory.Category.comp_id]
    have h_map₂ : (res_et g₁ hg₁).mapExtAddHom
        ((push_all i₂).obj (One_sh Z₂)) (One_sh Y₂) q
        (((CategoryTheory.Abelian.Ext.mk₀ (β_cart g₂ hg₂ i₂ i₃ g_Z2 hpb₂).hom).comp
          ((res_et g₂ hg₂).mapExtAddHom ((push_all i₃).obj (One_sh Z₃)) (One_sh Y₃) q τ₃.val)
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (π_can g₂ hg₂).hom) (Nat.add_zero q)) =
        (((CategoryTheory.Abelian.Ext.mk₀
            ((res_et g₁ hg₁).map (β_cart g₂ hg₂ i₂ i₃ g_Z2 hpb₂).hom)).comp
          (((res_et g₂ hg₂).comp (res_et g₁ hg₁)).mapExtAddHom
            ((push_all i₃).obj (One_sh Z₃)) (One_sh Y₃) q τ₃.val)
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ ((res_et g₁ hg₁).map (π_can g₂ hg₂).hom))
          (Nat.add_zero q)) := by
      have hc := h_comp_mapExt (res_et g₂ hg₂) (res_et g₁ hg₁) q
        ((push_all i₃).obj (One_sh Z₃)) (One_sh Y₃) τ₃.val
      simp only [CategoryTheory.Functor.mapExtAddHom_apply] at hc ⊢
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀, ← hc]
    exact (hv₁.trans (congrArg (fun z =>
        ((CategoryTheory.Abelian.Ext.mk₀ (β_cart g₁ hg₁ i₁ i₂ g_Z1 hpb₁).hom).comp
          ((res_et g₁ hg₁).mapExtAddHom _ _ q z) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (π_can g₁ hg₁).hom) (Nat.add_zero q)) hv₂)).trans
      ((congrArg (fun z =>
        ((CategoryTheory.Abelian.Ext.mk₀ (β_cart g₁ hg₁ i₁ i₂ g_Z1 hpb₁).hom).comp
          z (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (π_can g₁ hg₁).hom) (Nat.add_zero q)) h_map₂).trans
        ((h_ext_sandwich _ _ _ _ q _).trans
          (h_ext_nat_sandwich _ _ _ _ _ _ q _ _ hβ_eq hπ_hom
            (h_natTrans_mapExt (res_et g₁₂ hg₁₂) ((res_et g₂ hg₂).comp (res_et g₁ hg₁))
              σ.hom q ((push_all i₃).obj (One_sh Z₃)) (One_sh Y₃) τ₃.val))))

  
  have hOpenPb : ∀ (W : Y.Opens),
      CategoryTheory.IsPullback (i_open W) (U_open W).ι W.ι i := by
    intro W
    apply AlgebraicGeometry.IsOpenImmersion.isPullback (i_open W) (U_open W).ι W.ι i
    · exact (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι i (le_refl _)).symm
    · simp [AlgebraicGeometry.Scheme.Opens.opensRange_ι, U_open]

  have hOpenClosed : ∀ (W : Y.Opens),
      AlgebraicGeometry.IsClosedImmersion (i_open W) :=
    fun W => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (hOpenPb W).flip hi

  have hLEPb : ∀ {W₁ W₂ : Y.Opens} (h : W₁ ≤ W₂),
      CategoryTheory.IsPullback (i_open W₁)
        (Z.homOfLE ((TopologicalSpace.Opens.map i.base).monotone h))
        (Y.homOfLE h) (i_open W₂) := by
    intro W₁ W₂ h
    let g_ZU := Z.homOfLE ((TopologicalSpace.Opens.map i.base).monotone h)
    have h_tot : CategoryTheory.IsPullback (i_open W₁)
        (g_ZU ≫ (U_open W₂).ι) (Y.homOfLE h ≫ W₂.ι) i := by
      rw [Z.homOfLE_ι, Y.homOfLE_ι]
      exact hOpenPb W₁
    have h_comm : i_open W₁ ≫ Y.homOfLE h = g_ZU ≫ i_open W₂ := by
      apply (inferInstance : CategoryTheory.Mono W₂.ι).right_cancellation
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        Y.homOfLE_ι, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
        AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, ← CategoryTheory.Category.assoc,
        Z.homOfLE_ι]
    exact (CategoryTheory.IsPullback.of_right h_tot.flip h_comm.symm (hOpenPb W₂).flip).flip

  have hIdCompIso : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
      (f₁ : Quiver.Hom S₁ S₂) (hf₁ : AlgebraicGeometry.Etale f₁)
      (f₂ : Quiver.Hom S₂ S₁) (hf₂ : AlgebraicGeometry.Etale f₂),
      CategoryTheory.CategoryStruct.comp f₁ f₂ = CategoryTheory.CategoryStruct.id S₁ →
      Nonempty (CategoryTheory.Iso
        (CategoryTheory.Functor.comp (res_et f₂ hf₂) (res_et f₁ hf₁))
        (CategoryTheory.Functor.id (ShMod S₁))) := by
    intro S₁ S₂ f₁ hf₁ f₂ hf₂ hf_id
    let u_id (V : S₁.Etale) : V ⟶ ((M_et f₁ hf₁).comp (M_et f₂ hf₂)).obj V :=
      CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id V.left)
        ((CategoryTheory.Category.id_comp ((V.hom ≫ f₁) ≫ f₂)).trans
          ((CategoryTheory.Category.assoc V.hom f₁ f₂).trans
            ((congrArg (V.hom ≫ ·) hf_id).trans (CategoryTheory.Category.comp_id V.hom))))
        trivial
    let v_id (V : S₁.Etale) : ((M_et f₁ hf₁).comp (M_et f₂ hf₂)).obj V ⟶ V :=
      CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id V.left)
        ((CategoryTheory.Category.id_comp V.hom).trans
          ((CategoryTheory.Category.assoc V.hom f₁ f₂).trans
            ((congrArg (V.hom ≫ ·) hf_id).trans (CategoryTheory.Category.comp_id V.hom))).symm)
        trivial
    have huv : ∀ V : S₁.Etale, u_id V ≫ v_id V = 𝟙 _ := fun V =>
      CategoryTheory.MorphismProperty.Comma.Hom.ext
        (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
    have hvu : ∀ V : S₁.Etale, v_id V ≫ u_id V = 𝟙 _ := fun V =>
      CategoryTheory.MorphismProperty.Comma.Hom.ext
        (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
    have hu_nat : ∀ {V₁ V₂ : S₁.Etale} (f : V₁ ⟶ V₂),
        f ≫ u_id V₂ = u_id V₁ ≫ ((M_et f₁ hf₁).comp (M_et f₂ hf₂)).map f := fun f =>
      CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id f.left).trans
          (CategoryTheory.Category.id_comp f.left).symm)
        (Subsingleton.elim _ _)
    have hv_nat : ∀ {V₁ V₂ : S₁.Etale} (f : V₁ ⟶ V₂),
        ((M_et f₁ hf₁).comp (M_et f₂ hf₂)).map f ≫ v_id V₂ = v_id V₁ ≫ f := fun f =>
      CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id f.left).trans
          (CategoryTheory.Category.id_comp f.left).symm)
        (Subsingleton.elim _ _)
    refine ⟨{
      hom :=
        { app := fun ℱ =>
            { hom :=
                { app := fun V => ℱ.obj.map (u_id V.unop).op
                  naturality := fun {V₁ V₂} f =>
                    (ℱ.obj.map_comp _ _).symm.trans
                      ((congrArg (fun k => ℱ.obj.map k.op) (hu_nat f.unop).symm).trans
                        (ℱ.obj.map_comp _ _)) } }
          naturality := fun {ℱ₁ ℱ₂} α => by
            apply CategoryTheory.Sheaf.hom_ext
            apply CategoryTheory.NatTrans.ext
            funext V
            exact (α.hom.naturality (u_id V.unop).op).symm }
      inv :=
        { app := fun ℱ =>
            { hom :=
                { app := fun V => ℱ.obj.map (v_id V.unop).op
                  naturality := fun {V₁ V₂} f =>
                    (ℱ.obj.map_comp _ _).symm.trans
                      ((congrArg (fun k => ℱ.obj.map k.op) (hv_nat f.unop).symm).trans
                        (ℱ.obj.map_comp _ _)) } }
          naturality := fun {ℱ₁ ℱ₂} α => by
            apply CategoryTheory.Sheaf.hom_ext
            apply CategoryTheory.NatTrans.ext
            funext V
            exact (α.hom.naturality (v_id V.unop).op).symm }
      hom_inv_id := by
        apply CategoryTheory.NatTrans.ext; funext ℱ
        apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext V
        change ℱ.obj.map (u_id V.unop).op ≫ ℱ.obj.map (v_id V.unop).op = 𝟙 _
        rw [← ℱ.obj.map_comp, ← op_comp, hvu]
        exact ℱ.obj.map_id _
      inv_hom_id := by
        apply CategoryTheory.NatTrans.ext; funext ℱ
        apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext V
        change ℱ.obj.map (v_id V.unop).op ≫ ℱ.obj.map (u_id V.unop).op = 𝟙 _
        rw [← ℱ.obj.map_comp, ← op_comp, huv]
        exact ℱ.obj.map_id _ }⟩

  
  let β_open (W : Y.Opens) :=
    β_cart W.ι inferInstance (i_open W) i (U_open W).ι (hOpenPb W)
  let π_open (W : Y.Opens) :=
    π_can W.ι inferInstance

  have hA2 : ∀ (W : Y.Opens) (q : ℕ)
      (τ : WeilGysinSupportClass Z Y i m q)
      (τ_W : WeilGysinSupportClass (U_open W).toScheme W.toScheme (i_open W) m q),
      let hEx_W := hResAdj W.ι inferInstance (hContM W.ι inferInstance)
        (hContB W.toScheme Y W.ι)
      letI := hEx_W.2.1; letI := hEx_W.2.2.1; letI := hEx_W.2.2.2
      WeilGysinSupportPullback W.ι (i_open W) i m q τ_W τ ↔
        τ_W.val = ((CategoryTheory.Abelian.Ext.mk₀ (β_open W).hom).comp
