      have hVan_succ : ∀ (A : 𝒞₀),
          (∀ k_deg : ℕ, 1 ≤ k_deg → Subsingleton (CategoryTheory.Abelian.Ext.{u} one₀ A k_deg)) →
          ∀ q : ℕ, q < k + 1 → Subsingleton (CategoryTheory.Abelian.Ext.{u} A one₀ q) := by
        intro A hA
        have hExt1_B : ∀ s : ℕ, s < k →
            Subsingleton (CategoryTheory.Abelian.Ext.{u} A (B (s + 1)) 1) := by
          intro s hs
          refine ⟨fun x₁ x₂ => ?_⟩
          suffices h0 : ∀ x : CategoryTheory.Abelian.Ext.{u} A (B (s + 1)) 1, x = 0 by
            rw [h0 x₁, h0 x₂]
          intro x
          have := hInjExt (s + 2) 1 (le_refl 1) A
          have hx0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ (SC_step s).f) (Nat.add_zero 1) = 0 :=
            Subsingleton.elim _ _
          obtain ⟨x₃, hx₃⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
            A (hSC_step s hs) x hx0 (Nat.zero_add 1)
          let g : A ⟶ B s := CategoryTheory.Abelian.Ext.addEquiv₀ x₃
          have hg_mk : CategoryTheory.Abelian.Ext.mk₀ g = x₃ :=
            CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply x₃
          let lam : ↑((C₀ (s + 1)).obj A) →ₗ[R] R := (Ψ₀ (s + 1) A).symm (g ≫ κ s)
