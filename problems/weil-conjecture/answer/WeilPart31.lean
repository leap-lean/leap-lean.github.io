            calc
              π_κ (c * d ^ k) = π_κ c * π_κ d ^ k := by rw [map_mul, map_pow]
              _ = Ideal.Quotient.mk M_pt q_el * (π_κ (r_of pt) * π_κ d) ^ k := by
                rw [← hcq_bar, mul_pow, mul_assoc]
              _ = Ideal.Quotient.mk M_pt q_el := by
                rw [mul_comm (π_κ (r_of pt)), hdr_one, one_pow, mul_one]
          have : Module.Finite Ω κ_pt :=
            Module.Finite.of_surjective π_κ.toLinearMap hSurj_πκ
          have : Algebra.IsIntegral Ω κ_pt := Algebra.IsIntegral.of_finite Ω κ_pt
          have : Algebra.IsAlgebraic Ω κ_pt := Algebra.IsIntegral.isAlgebraic
          let τ_κ : κ_pt →ₐ[Ω] Ω := IsAlgClosed.lift
          have hτ_inv : ∀ z : κ_pt, algebraMap Ω κ_pt (τ_κ z) = z := fun z =>
            τ_κ.injective (τ_κ.commutes (τ_κ z))
          have hLocSurj : Sheaf.IsLocallySurjective α :=
            (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} α).mpr inferInstance
          have hImgCov : Presheaf.imageSieve α.hom t_pt ∈ Z.smallEtaleTopology (V_pt pt) :=
            hLocSurj.imageSieve_mem t_pt
          obtain ⟨Y_p, w_p, y_p, hw_img, _⟩ :=
            (h_mem_etale Z (V_pt pt) _).mp hImgCov q_pt
          obtain ⟨s_Yp, hs_Yp⟩ := hw_img
          obtain ⟨W_m, hW_m, hy_m, _⟩ :=
            AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y_p) (U := ⊤) trivial
