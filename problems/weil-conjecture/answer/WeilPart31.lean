              (weilCupPDTraceLocalTorsionMapH S m (oHom (le_iSup V a)) N)) := by
              simp only [AddMonoidHom.comp_assoc]
        _ = F_sup.comp (weilCupPDTraceLocalTorsionMapH S m (oHom (le_iSup V a)) N) := by
              rw [he_bf, AddMonoidHom.id_comp]
