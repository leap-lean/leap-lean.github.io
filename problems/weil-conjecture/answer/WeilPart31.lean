                  ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k u_tilde)
                    (congrArg (CategoryTheory.CategoryStruct.comp (hpb_W W₁).isoPullback.inv)
                      hB_γ_snd.symm)).trans
                    ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k u_tilde)
                      (CategoryTheory.Category.assoc _ _ _).symm).trans
                      (CategoryTheory.Category.assoc _ _ u_tilde).symm))))))

    let δ_sh : ∀ 𝒢 : CategoryTheory.Sheaf P_a.smallEtaleTopology ModR,
        Quiver.Hom (γ_push.obj (R_u.obj 𝒢)) (R_sh.obj (ibar_push.obj 𝒢)) :=
      fun 𝒢 => CategoryTheory.ObjectProperty.homMk
        { app := fun opW => 𝒢.obj.map (κ_inv opW.unop).op
          naturality := fun {opW₁ opW₂} g_op =>
            ((𝒢.obj.map_comp (Sigma_u.map (B_γ.map g_op.unop)).op (κ_inv opW₂.unop).op).symm.trans
              (congrArg 𝒢.obj.map
                (CategoryTheory.op_comp
                  (f := κ_inv opW₂.unop) (g := Sigma_u.map (B_γ.map g_op.unop))).symm)).trans
              ((congrArg (fun k => 𝒢.obj.map k.op) (hκ_inv_nat g_op.unop).symm).trans
                ((congrArg 𝒢.obj.map
                  (CategoryTheory.op_comp
                    (f := B_ibar.map (Sigma_ψ.map g_op.unop)) (g := κ_inv opW₁.unop))).trans
                  (𝒢.obj.map_comp (κ_inv opW₁.unop).op (B_ibar.map (Sigma_ψ.map g_op.unop)).op))) }
    have hδ_nat : ∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf P_a.smallEtaleTopology ModR}
        (k : Quiver.Hom 𝒢₁ 𝒢₂),
        CategoryTheory.CategoryStruct.comp (δ_sh 𝒢₁) (R_sh.map (ibar_push.map k)) =
          CategoryTheory.CategoryStruct.comp (γ_push.map (R_u.map k)) (δ_sh 𝒢₂) :=
      fun k => CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun opW =>
        k.hom.naturality (κ_inv opW.unop).op))

    let e_U : Quiver.Hom (Sigma_u.obj T_ZV) U_ZV :=
      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.CategoryStruct.id Z_V) (CategoryTheory.Category.id_comp u_tilde) trivial
    let ι₀ : Quiver.Hom R_mod (ℒ_ZV.obj.obj (Opposite.op U_ZV)) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id ℒ_ZV)
    let ν₀ : Quiver.Hom One_ZV (R_u.obj ℒ_ZV) :=
      (adj_ZV.homEquiv R_mod (R_u.obj ℒ_ZV)).symm
        (CategoryTheory.CategoryStruct.comp ι₀ (ℒ_ZV.obj.map e_U.op))
    let η : Quiver.Hom (γ_push.obj One_ZV) (R_sh.obj (ibar_push.obj ℒ_ZV)) :=
      CategoryTheory.CategoryStruct.comp (γ_push.map ν₀) (δ_sh ℒ_ZV)

    
    have hη_term : ∃ μ_V : Quiver.Hom (B_ibar.obj (Sigma_ψ.obj T_V)) U_ZV,
        adj_V.homEquiv R_mod (R_sh.obj (ibar_push.obj ℒ_ZV))
          (CategoryTheory.CategoryStruct.comp q_γ η) =
        CategoryTheory.CategoryStruct.comp ι₀ (ℒ_ZV.obj.map μ_V.op) := by
      let τ_γ : Quiver.Hom (B_γ.obj T_V) T_ZV := hT_ZV.from (B_γ.obj T_V)
      let μ_V : Quiver.Hom (B_ibar.obj (Sigma_ψ.obj T_V)) U_ZV :=
        CategoryTheory.CategoryStruct.comp (κ_inv T_V)
          (CategoryTheory.CategoryStruct.comp (Sigma_u.map τ_γ) e_U)
      refine ⟨μ_V, ?_⟩
      have h1 := adj_V.homEquiv_naturality_right q_γ η
      have hq : adj_V.homEquiv R_mod (γ_push.obj One_ZV) q_γ =
          CategoryTheory.CategoryStruct.comp (adj_ZV.unit.app R_mod)
            (One_ZV.obj.map τ_γ.op) :=
        (adj_V.homEquiv R_mod (γ_push.obj One_ZV)).apply_symm_apply _
      have hν_unit : CategoryTheory.CategoryStruct.comp (adj_ZV.unit.app R_mod)
          (ν₀.hom.app (Opposite.op T_ZV)) =
          CategoryTheory.CategoryStruct.comp ι₀ (ℒ_ZV.obj.map e_U.op) :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_ZV R_mod (R_u.obj ℒ_ZV) ν₀).symm.trans
          ((adj_ZV.homEquiv R_mod (R_u.obj ℒ_ZV)).apply_symm_apply _)
      have hν_nat : CategoryTheory.CategoryStruct.comp
          (One_ZV.obj.map τ_γ.op) (ν₀.hom.app (Opposite.op (B_γ.obj T_V))) =
        CategoryTheory.CategoryStruct.comp
          (ν₀.hom.app (Opposite.op T_ZV)) (ℒ_ZV.obj.map (Sigma_u.map τ_γ).op) :=
        ν₀.hom.naturality τ_γ.op
      have hmap_μ : CategoryTheory.CategoryStruct.comp (ℒ_ZV.obj.map e_U.op)
          (CategoryTheory.CategoryStruct.comp (ℒ_ZV.obj.map (Sigma_u.map τ_γ).op)
            (ℒ_ZV.obj.map (κ_inv T_V).op)) =
          ℒ_ZV.obj.map μ_V.op :=
        (congrArg (CategoryTheory.CategoryStruct.comp (ℒ_ZV.obj.map e_U.op))
          ((ℒ_ZV.obj.map_comp (Sigma_u.map τ_γ).op (κ_inv T_V).op).symm.trans
            (congrArg ℒ_ZV.obj.map
              (CategoryTheory.op_comp (f := κ_inv T_V) (g := Sigma_u.map τ_γ)).symm))).trans
          ((ℒ_ZV.obj.map_comp e_U.op
            (CategoryTheory.CategoryStruct.comp (κ_inv T_V) (Sigma_u.map τ_γ)).op).symm.trans
            (congrArg ℒ_ZV.obj.map
              ((CategoryTheory.op_comp
                (f := CategoryTheory.CategoryStruct.comp (κ_inv T_V) (Sigma_u.map τ_γ))
                (g := e_U)).symm.trans
                (congrArg Quiver.Hom.op
                  (CategoryTheory.Category.assoc (κ_inv T_V) (Sigma_u.map τ_γ) e_U)))))
      let u_Z := adj_ZV.unit.app R_mod
      let m_τ := One_ZV.obj.map τ_γ.op
      let n_B := ν₀.hom.app (Opposite.op (B_γ.obj T_V))
      let n_T := ν₀.hom.app (Opposite.op T_ZV)
      let m_κ := ℒ_ZV.obj.map (κ_inv T_V).op
      let m_S := ℒ_ZV.obj.map (Sigma_u.map τ_γ).op
      let m_e := ℒ_ZV.obj.map e_U.op
      exact h1.trans
        ((congrArg (fun x => CategoryTheory.CategoryStruct.comp x
          (CategoryTheory.CategoryStruct.comp n_B m_κ)) hq).trans
          ((CategoryTheory.Category.assoc u_Z m_τ
            (CategoryTheory.CategoryStruct.comp n_B m_κ)).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp u_Z)
              ((CategoryTheory.Category.assoc m_τ n_B m_κ).symm.trans
                ((congrArg (fun x => CategoryTheory.CategoryStruct.comp x m_κ) hν_nat).trans
                  (CategoryTheory.Category.assoc n_T m_S m_κ)))).trans
              ((CategoryTheory.Category.assoc u_Z n_T
                (CategoryTheory.CategoryStruct.comp m_S m_κ)).symm.trans
                ((congrArg (fun x => CategoryTheory.CategoryStruct.comp x
                  (CategoryTheory.CategoryStruct.comp m_S m_κ)) hν_unit).trans
                  ((CategoryTheory.Category.assoc ι₀ m_e
                    (CategoryTheory.CategoryStruct.comp m_S m_κ)).trans
                    (congrArg (CategoryTheory.CategoryStruct.comp ι₀) hmap_μ)))))))

    
    have hSkyInBij : ∀ {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
        (ξ_a : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) P_a)
        (M : ModR)
        (hS_Pab : CategoryTheory.Presheaf.IsSheaf P_ab.smallEtaleTopology
          (skyPre (CategoryTheory.CategoryStruct.comp ξ_a i_bar) M)),
        Function.Bijective
          (fun f : Quiver.Hom (ibar_push.obj ℒ_ZV)
              ⟨skyPre (CategoryTheory.CategoryStruct.comp ξ_a i_bar) M, hS_Pab⟩ =>
            CategoryTheory.CategoryStruct.comp η (R_sh.map f)) := by
      intro Ω _ _ ξ_a M hS_Pab
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let J_Ω := { τ : Quiver.Hom S_Ω Z_V // CategoryTheory.CategoryStruct.comp τ u_tilde = ξ_a }
      let hS_Pa := hSkyIsSheaf P_a Ω ξ_a M
      let Sky_Pab : CategoryTheory.Sheaf P_ab.smallEtaleTopology ModR :=
        ⟨skyPre (CategoryTheory.CategoryStruct.comp ξ_a i_bar) M, hS_Pab⟩
      let Sky_Pa : CategoryTheory.Sheaf P_a.smallEtaleTopology ModR := ⟨skyPre ξ_a M, hS_Pa⟩
      let e_sky_ib := skyPushIso i_bar hc_ibar ξ_a M hS_Pab hS_Pa
      let hS_V : ∀ τ : J_Ω,
          CategoryTheory.Presheaf.IsSheaf V.smallEtaleTopology
            (skyPre (CategoryTheory.CategoryStruct.comp τ.1 γ_V) M) :=
        fun τ => hSkyIsSheaf V Ω (CategoryTheory.CategoryStruct.comp τ.1 γ_V) M
      let hS_ZV : ∀ τ : J_Ω,
          CategoryTheory.Presheaf.IsSheaf Z_V.smallEtaleTopology (skyPre τ.1 M) :=
        fun τ => hSkyIsSheaf Z_V Ω τ.1 M
      let e_sky_γ : ∀ τ : J_Ω,
          CategoryTheory.Iso
            ⟨skyPre (CategoryTheory.CategoryStruct.comp τ.1 γ_V) M, hS_V τ⟩
            (γ_push.obj ⟨skyPre τ.1 M, hS_ZV τ⟩) :=
        fun τ => skyPushIso γ_V hc_γ τ.1 M (hS_V τ) (hS_ZV τ)

      
      have hYonEval : ∀ k_a : Quiver.Hom ℒ_ZV Sky_Pa,
          CategoryTheory.Sheaf.freeYonedaHomEquiv k_a =
            CategoryTheory.CategoryStruct.comp ι₀ (k_a.hom.app (Opposite.op U_ZV)) := fun k_a =>
        (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
          (CategoryTheory.Category.id_comp k_a).symm).trans
          ((congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
            ((CategoryTheory.sheafificationAdjunction P_a.smallEtaleTopology ModR).homEquiv_naturality_right
              (X := CategoryTheory.Presheaf.freeYoneda U_ZV R_mod)
              (CategoryTheory.CategoryStruct.id ℒ_ZV) k_a)).trans
            (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _))

      
      let evalOneEquiv : ∀ N : ModR, Quiver.Hom R_mod N ≃ ↥N := fun N =>
        { toFun := fun f_lin => f_lin.hom (1 : R)
          invFun := fun v => ModuleCat.ofHom (LinearMap.toSpanSingleton R ↥N v)
          left_inv := fun f_lin => by
            apply ModuleCat.hom_ext
            apply LinearMap.ext_ring
            exact one_smul R (f_lin.hom (1 : R))
          right_inv := fun v => one_smul R v }

      
      let e_post_ib : Quiver.Hom (ibar_push.obj ℒ_ZV) Sky_Pab ≃
          Quiver.Hom (ibar_push.obj ℒ_ZV) (ibar_push.obj Sky_Pa) :=
        { toFun := fun f => CategoryTheory.CategoryStruct.comp f e_sky_ib.hom
          invFun := fun g => CategoryTheory.CategoryStruct.comp g e_sky_ib.inv
          left_inv := fun f =>
            (CategoryTheory.Category.assoc f e_sky_ib.hom e_sky_ib.inv).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp f) e_sky_ib.hom_inv_id).trans
                (CategoryTheory.Category.comp_id f))
          right_inv := fun g =>
            (CategoryTheory.Category.assoc g e_sky_ib.inv e_sky_ib.hom).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp g) e_sky_ib.inv_hom_id).trans
                (CategoryTheory.Category.comp_id g)) }
      let e_ff_ib : Quiver.Hom (ibar_push.obj ℒ_ZV) (ibar_push.obj Sky_Pa) ≃
          Quiver.Hom ℒ_ZV Sky_Pa :=
        { toFun := fun g => hFF_ibar.preimage g
          invFun := fun k => ibar_push.map k
          left_inv := fun g => hFF_ibar.map_preimage g
          right_inv := fun k => hFF_ibar.preimage_map k }
      let e_LHS : Quiver.Hom (ibar_push.obj ℒ_ZV) Sky_Pab ≃ (J_Ω → ↥M) :=
        e_post_ib.trans (e_ff_ib.trans
          (CategoryTheory.Sheaf.freeYonedaHomEquiv.trans
            (evalOneEquiv (Sky_Pa.obj.obj (Opposite.op U_ZV)))))

      
      let proj_V : ∀ τ : J_Ω,
          Quiver.Hom (R_sh.obj Sky_Pab)
            ⟨skyPre (CategoryTheory.CategoryStruct.comp τ.1 γ_V) M, hS_V τ⟩ :=
        fun τ => CategoryTheory.ObjectProperty.homMk
          { app := fun opW => ModuleCat.ofHom
              { toFun := fun sec δ =>
                  sec ⟨δ.1, (CategoryTheory.Category.assoc δ.1 opW.unop.hom ψ_tilde).symm.trans
                    ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k ψ_tilde) δ.2).trans
                      ((CategoryTheory.Category.assoc τ.1 γ_V ψ_tilde).trans
                        ((congrArg (CategoryTheory.CategoryStruct.comp τ.1) hpb.w).trans
                          ((CategoryTheory.Category.assoc τ.1 u_tilde i_bar).symm.trans
                            (congrArg (fun k => CategoryTheory.CategoryStruct.comp k i_bar) τ.2)))))⟩
                map_add' := fun _ _ => rfl
                map_smul' := fun _ _ => rfl }
            naturality := fun _ _ _ => ModuleCat.hom_ext (LinearMap.ext fun _ => rfl) }
      have hFamEq : ∀ (fam : ∀ τ : J_Ω, Quiver.Hom (γ_push.obj One_ZV)
            ⟨skyPre (CategoryTheory.CategoryStruct.comp τ.1 γ_V) M, hS_V τ⟩)
          {opU : Opposite V.Etale} (sU : ↥((γ_push.obj One_ZV).obj.obj opU))
          {a b : J_Ω} (hab : a = b)
          (d₀ : Quiver.Hom S_Ω opU.unop.left)
          (ha : CategoryTheory.CategoryStruct.comp d₀ opU.unop.hom =
            CategoryTheory.CategoryStruct.comp a.1 γ_V)
          (hb : CategoryTheory.CategoryStruct.comp d₀ opU.unop.hom =
            CategoryTheory.CategoryStruct.comp b.1 γ_V),
          ((fam a).hom.app opU).hom sU ⟨d₀, ha⟩ =
            ((fam b).hom.app opU).hom sU ⟨d₀, hb⟩ := by
        rintro fam opU sU a _ rfl d₀ ha hb
        rfl
      let e_curry_V : Quiver.Hom (γ_push.obj One_ZV) (R_sh.obj Sky_Pab) ≃
          (∀ τ : J_Ω, Quiver.Hom (γ_push.obj One_ZV)
            ⟨skyPre (CategoryTheory.CategoryStruct.comp τ.1 γ_V) M, hS_V τ⟩) :=
        { toFun := fun g τ => CategoryTheory.CategoryStruct.comp g (proj_V τ)
          invFun := fun fam => CategoryTheory.ObjectProperty.homMk
            { app := fun opW => ModuleCat.ofHom
                { toFun := fun s δ =>
                    let hcomm : CategoryTheory.CategoryStruct.comp
                        (CategoryTheory.CategoryStruct.comp δ.1 opW.unop.hom) ψ_tilde =
                        CategoryTheory.CategoryStruct.comp ξ_a i_bar :=
                      (CategoryTheory.Category.assoc δ.1 opW.unop.hom ψ_tilde).trans δ.2
                    let τ_δ : J_Ω :=
                      ⟨hpb.lift (CategoryTheory.CategoryStruct.comp δ.1 opW.unop.hom) ξ_a hcomm,
                        hpb.lift_snd _ _ _⟩
                    ((fam τ_δ).hom.app opW).hom s
                      ⟨δ.1, (hpb.lift_fst _ _ _).symm⟩
                  map_add' := fun s₁ s₂ => funext fun δ =>
                    congrFun (map_add
                      (((fam ⟨hpb.lift (CategoryTheory.CategoryStruct.comp δ.1 opW.unop.hom) ξ_a
                        ((CategoryTheory.Category.assoc δ.1 opW.unop.hom ψ_tilde).trans δ.2),
                        hpb.lift_snd _ _ _⟩).hom.app opW).hom) s₁ s₂)
                      ⟨δ.1, (hpb.lift_fst _ _ _).symm⟩
                  map_smul' := fun r s => funext fun δ =>
                    congrFun (map_smul
                      (((fam ⟨hpb.lift (CategoryTheory.CategoryStruct.comp δ.1 opW.unop.hom) ξ_a
                        ((CategoryTheory.Category.assoc δ.1 opW.unop.hom ψ_tilde).trans δ.2),
                        hpb.lift_snd _ _ _⟩).hom.app opW).hom) r s)
                      ⟨δ.1, (hpb.lift_fst _ _ _).symm⟩ }
              naturality := fun {opW₁ opW₂} f_op =>
                ModuleCat.hom_ext (LinearMap.ext fun s => funext fun δ₂ => by
                  let τ₁ : J_Ω :=
                    ⟨hpb.lift
                      (CategoryTheory.CategoryStruct.comp
                        (CategoryTheory.CategoryStruct.comp δ₂.1 f_op.unop.left) opW₁.unop.hom) ξ_a
                      ((CategoryTheory.Category.assoc _ opW₁.unop.hom ψ_tilde).trans
                        ((CategoryTheory.Category.assoc δ₂.1 f_op.unop.left _).trans
                          ((congrArg (CategoryTheory.CategoryStruct.comp δ₂.1)
                            (CategoryTheory.MorphismProperty.Over.w
                              (Sigma_ψ.map f_op.unop))).trans δ₂.2))),
                      hpb.lift_snd _ _ _⟩
                  let τ₂ : J_Ω :=
                    ⟨hpb.lift (CategoryTheory.CategoryStruct.comp δ₂.1 opW₂.unop.hom) ξ_a
                      ((CategoryTheory.Category.assoc δ₂.1 opW₂.unop.hom ψ_tilde).trans δ₂.2),
                      hpb.lift_snd _ _ _⟩
                  have hτ_eq : τ₁ = τ₂ :=
                    Subtype.ext (hpb.hom_ext
                      ((hpb.lift_fst _ _ _).trans
                        ((CategoryTheory.Category.assoc δ₂.1 f_op.unop.left opW₁.unop.hom).trans
                          ((congrArg (CategoryTheory.CategoryStruct.comp δ₂.1)
                            (CategoryTheory.MorphismProperty.Over.w f_op.unop)).trans
                            (hpb.lift_fst _ _ _).symm)))
                      ((hpb.lift_snd _ _ _).trans (hpb.lift_snd _ _ _).symm))
                  have hnat_fam := (fam τ₂).hom.naturality f_op
                  have hev := congrArg (fun m =>
                    (m.hom s) ⟨δ₂.1, (hpb.lift_fst _ _ _).symm⟩) hnat_fam
                  exact hev.trans (hFamEq fam s hτ_eq.symm
                    (CategoryTheory.CategoryStruct.comp δ₂.1 f_op.unop.left) _ _)) }
          left_inv := fun g =>
            CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun opW =>
              ModuleCat.hom_ext (LinearMap.ext fun s => funext fun δ =>
                congrArg ((g.hom.app opW).hom s) (Subtype.ext rfl))))
          right_inv := fun fam => by
            funext τ
            refine CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun opW =>
              ModuleCat.hom_ext (LinearMap.ext fun s => funext fun δ => ?_)))
            let τ' : J_Ω :=
              ⟨hpb.lift (CategoryTheory.CategoryStruct.comp δ.1 opW.unop.hom) ξ_a
                ((CategoryTheory.Category.assoc δ.1 opW.unop.hom ψ_tilde).trans
                  ((CategoryTheory.Category.assoc δ.1 opW.unop.hom ψ_tilde).symm.trans
                    ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k ψ_tilde) δ.2).trans
                      ((CategoryTheory.Category.assoc τ.1 γ_V ψ_tilde).trans
                        ((congrArg (CategoryTheory.CategoryStruct.comp τ.1) hpb.w).trans
                          ((CategoryTheory.Category.assoc τ.1 u_tilde i_bar).symm.trans
                            (congrArg (fun k => CategoryTheory.CategoryStruct.comp k i_bar) τ.2))))))),
                hpb.lift_snd _ _ _⟩
            have hτ_eq : τ' = τ :=
              Subtype.ext (hpb.hom_ext
                ((hpb.lift_fst _ _ _).trans δ.2)
                ((hpb.lift_snd _ _ _).trans τ.2.symm))
            exact hFamEq fam s hτ_eq δ.1 _ δ.2 }

      let e_fiber : ∀ τ : J_Ω,
          Quiver.Hom (γ_push.obj One_ZV)
            ⟨skyPre (CategoryTheory.CategoryStruct.comp τ.1 γ_V) M, hS_V τ⟩ ≃ ↥M := fun τ =>
        let Sky_ZV_τ : CategoryTheory.Sheaf Z_V.smallEtaleTopology ModR := ⟨skyPre τ.1 M, hS_ZV τ⟩
        let e_post_γ : Quiver.Hom (γ_push.obj One_ZV)
            ⟨skyPre (CategoryTheory.CategoryStruct.comp τ.1 γ_V) M, hS_V τ⟩ ≃
            Quiver.Hom (γ_push.obj One_ZV) (γ_push.obj Sky_ZV_τ) :=
          { toFun := fun g => CategoryTheory.CategoryStruct.comp g (e_sky_γ τ).hom
            invFun := fun k => CategoryTheory.CategoryStruct.comp k (e_sky_γ τ).inv
            left_inv := fun g =>
              (CategoryTheory.Category.assoc g (e_sky_γ τ).hom (e_sky_γ τ).inv).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp g) (e_sky_γ τ).hom_inv_id).trans
                  (CategoryTheory.Category.comp_id g))
            right_inv := fun k =>
              (CategoryTheory.Category.assoc k (e_sky_γ τ).inv (e_sky_γ τ).hom).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp k) (e_sky_γ τ).inv_hom_id).trans
                  (CategoryTheory.Category.comp_id k)) }
        let e_ff_γ : Quiver.Hom (γ_push.obj One_ZV) (γ_push.obj Sky_ZV_τ) ≃
            Quiver.Hom One_ZV Sky_ZV_τ :=
          { toFun := fun k => hFF_γ.preimage k
            invFun := fun h => γ_push.map h
            left_inv := fun k => hFF_γ.map_preimage k
            right_inv := fun h => hFF_γ.preimage_map h }
        let σ_τ : { d : Quiver.Hom S_Ω T_ZV.left //
            CategoryTheory.CategoryStruct.comp d T_ZV.hom = τ.1 } :=
          ⟨τ.1, CategoryTheory.Category.comp_id τ.1⟩
        let e_pt_τ : ↥(Sky_ZV_τ.obj.obj (Opposite.op T_ZV)) ≃ ↥M :=
          { toFun := fun sec => sec σ_τ
            invFun := fun m_val _ => m_val
            left_inv := fun sec => funext fun σ =>
              congrArg sec (Subtype.ext (σ.2.symm.trans (CategoryTheory.Category.comp_id σ.1)))
            right_inv := fun _ => rfl }
        e_post_γ.trans (e_ff_γ.trans ((adj_ZV.homEquiv R_mod Sky_ZV_τ).trans
          ((evalOneEquiv (Sky_ZV_τ.obj.obj (Opposite.op T_ZV))).trans e_pt_τ)))

      let e_RHS : Quiver.Hom (γ_push.obj One_ZV) (R_sh.obj Sky_Pab) ≃ (J_Ω → ↥M) :=
        e_curry_V.trans (Equiv.piCongrRight e_fiber)

      let Φ : Quiver.Hom (ibar_push.obj ℒ_ZV) Sky_Pab →
          Quiver.Hom (γ_push.obj One_ZV) (R_sh.obj Sky_Pab) :=
        fun f => CategoryTheory.CategoryStruct.comp η (R_sh.map f)

      have hComm : ∀ f : Quiver.Hom (ibar_push.obj ℒ_ZV) Sky_Pab, e_RHS (Φ f) = e_LHS f := by
        intro f
        let k_a : Quiver.Hom ℒ_ZV Sky_Pa := hFF_ibar.preimage
          (CategoryTheory.CategoryStruct.comp f e_sky_ib.hom)
        have hf_eq : f = CategoryTheory.CategoryStruct.comp
            (ibar_push.map k_a) e_sky_ib.inv :=
          ((congrArg (fun x => CategoryTheory.CategoryStruct.comp x e_sky_ib.inv)
            (hFF_ibar.map_preimage _)).trans
            ((CategoryTheory.Category.assoc f e_sky_ib.hom e_sky_ib.inv).trans
