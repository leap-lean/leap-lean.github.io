        (Φ.naturality (Opposite.op g)).symm
      calc
        (h ≫ G.map (Opposite.op p)) ≫ G.map (Opposite.op ι_x)
          = h ≫ G.map (Opposite.op (ι_x ≫ p)) := by
              rw [CategoryTheory.Category.assoc, ← hopMap G ι_x p]
        _ = (h ≫ G.map (Opposite.op ι_u)) ≫ G.map (Opposite.op q) := by
              rw [← hq, hopMap G q ι_u, CategoryTheory.Category.assoc]
        _ = F.map (Opposite.op (ι_u ≫ k)) ≫ F.map (Opposite.op e_u.inv) ≫
              Φ.app (Opposite.op W) ≫ G.map (Opposite.op (q ≫ e_u.hom)) := by
              rw [h_u]
              simp only [CategoryTheory.Category.assoc, ← hopMap G q e_u.hom]
        _ = F.map (Opposite.op (ι_u ≫ k)) ≫ F.map (Opposite.op e_u.inv) ≫
              (Φ.app (Opposite.op W) ≫ G.map (Opposite.op (B.map g))) ≫
              G.map (Opposite.op e_x.hom) := by
              rw [← he, hopMap G e_x.hom (B.map g)]
              simp only [CategoryTheory.Category.assoc]
        _ = F.map (Opposite.op (ι_u ≫ k)) ≫ F.map (Opposite.op (B.map g ≫ e_u.inv)) ≫
              Φ.app (Opposite.op W') ≫ G.map (Opposite.op e_x.hom) := by
              rw [hnat, hopMap F (B.map g) e_u.inv]
              simp only [CategoryTheory.Category.assoc]
        _ = F.map (Opposite.op (ι_x ≫ (p ≫ k))) ≫ F.map (Opposite.op e_x.inv) ≫
              Φ.app (Opposite.op W') ≫ G.map (Opposite.op e_x.hom) := by
              rw [he_inv]
              have hqk : q ≫ ι_u ≫ k = ι_x ≫ (p ≫ k) := by
                rw [← CategoryTheory.Category.assoc, hq, CategoryTheory.Category.assoc]
              rw [← hqk, hopMap F q (ι_u ≫ k), hopMap F e_x.inv q]
              simp only [CategoryTheory.Category.assoc]
    have hCatSubComp : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
        {A B₁ B₂ C₀ D E : C} (i_sub : A ⟶ B₁) (j₁ : B₁ ⟶ B₂) (j₂ : B₂ ⟶ C₀)
        (j_A : A ⟶ C₀) (p : C₀ ⟶ D) (p_sub : B₂ ⟶ E) (j_E : E ⟶ D),
        i_sub ≫ j₁ ≫ j₂ = j_A →
        p_sub ≫ j_E = j₂ ≫ p →
        (i_sub ≫ j₁ ≫ p_sub) ≫ j_E = j_A ≫ p := by
      intro C _ A B₁ B₂ C₀ D E i_sub j₁ j₂ j_A p p_sub j_E h1 h2
      simp only [CategoryTheory.Category.assoc] at h1 ⊢
      rw [h2, ← CategoryTheory.Category.assoc j₁, ← CategoryTheory.Category.assoc i_sub, h1]
    have hCatIsoSub : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
        {A B₁ E W' W : C} (iso_sub : B₁ ≅ A) (e' : B₁ ≅ W') (j₁ : B₁ ⟶ E)
        (bg : W' ⟶ W) (eu : E ⟶ W),
        e'.hom ≫ bg = j₁ ≫ eu →
        (iso_sub.symm.trans e').hom ≫ bg = (iso_sub.inv ≫ j₁) ≫ eu := by
      intro C _ A B₁ E W' W iso_sub e' j₁ bg eu h
      dsimp [CategoryTheory.Iso.trans, CategoryTheory.Iso.symm]
      rw [CategoryTheory.Category.assoc, h, CategoryTheory.Category.assoc]
    have hCatIncQ : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
        {A B E U : C} (j : A ⟶ B) (inc : B ⟶ E) (ι_E : E ⟶ U) (ι_B : B ⟶ U),
        inc ≫ ι_E = ι_B → (j ≫ inc) ≫ ι_E = j ≫ ι_B := by
      intro C _ A B E U j inc ι_E ι_B h
      rw [CategoryTheory.Category.assoc, h]
    have hCatIncE : ∀ {C D : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
        [CategoryTheory.Category.{u, u + 1} D]
        (B : CategoryTheory.Functor D C) {X U_sub E : C} {W'' W₁₂ W₁ : D}
        (e'' : X ≅ B.obj W'') (f : W'' ⟶ W₁₂) (pr : W₁₂ ⟶ W₁)
        (j : X ⟶ U_sub) (β : U_sub ⟶ B.obj W₁₂) (inc : U_sub ⟶ E) (e₁ : E ≅ B.obj W₁),
        β ≫ B.map pr = inc ≫ e₁.hom →
        e''.hom ≫ B.map f = j ≫ β →
        e''.hom ≫ B.map (f ≫ pr) = (j ≫ inc) ≫ e₁.hom := by
      intro C D _ _ B X U_sub E W'' W₁₂ W₁ e'' f pr j β inc e₁ hβ he''
      rw [B.map_comp, ← CategoryTheory.Category.assoc, he'',
        CategoryTheory.Category.assoc, hβ, CategoryTheory.Category.assoc]
    have hCatTopLoc : ∀ {C M : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
        [CategoryTheory.Category.{u, u + 1} M]
        (F G : CategoryTheory.Functor (Opposite C) M)
        {T X V BW : C} (t : T ≅ X) (ι : X ⟶ V) (e : X ≅ BW)
        (φ : F.obj (Opposite.op BW) ⟶ G.obj (Opposite.op BW)),
        (F.map (Opposite.op ι) ≫ F.map (Opposite.op e.inv) ≫ φ ≫ G.map (Opposite.op e.hom)) ≫
          G.map (Opposite.op t.hom) =
        F.map (Opposite.op (t.hom ≫ ι)) ≫ F.map (Opposite.op (t.trans e).inv) ≫
          φ ≫ G.map (Opposite.op (t.trans e).hom) := by
      intro C M _ _ F G T X V BW t ι e φ
      dsimp [CategoryTheory.Iso.trans]
      rw [hopMap F t.hom ι, hopMap F e.inv t.inv, hopMap G t.hom e.hom]
      simp only [CategoryTheory.Category.assoc]
      rw [← CategoryTheory.Category.assoc (F.map (Opposite.op t.hom)) (F.map (Opposite.op t.inv)),
        ← hopMap F t.inv t.hom, t.inv_hom_id, hidMap F X, CategoryTheory.Category.id_comp]
    have hCatIdPsi : ∀ {C M : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
        [CategoryTheory.Category.{u, u + 1} M]
        (F G : CategoryTheory.Functor (Opposite C) M) {X V BW : C}
        (ι : X ⟶ V) (e : X ≅ BW)
        (ψ : F.obj (Opposite.op V) ⟶ G.obj (Opposite.op V))
        (φ : F.obj (Opposite.op BW) ⟶ G.obj (Opposite.op BW)),
        ψ ≫ G.map (Opposite.op ι) =
          F.map (Opposite.op ι) ≫ F.map (Opposite.op e.inv) ≫ φ ≫ G.map (Opposite.op e.hom) →
        ψ ≫ G.map (Opposite.op ι) =
          F.map (Opposite.op (ι ≫ 𝟙 V)) ≫ F.map (Opposite.op e.inv) ≫ φ ≫ G.map (Opposite.op e.hom) := by
      intro C M _ _ F G X V BW ι e ψ φ h
      rw [CategoryTheory.Category.comp_id]
      exact h
    have hCatNatLeft : ∀ {C M : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
        [CategoryTheory.Category.{u, u + 1} M]
        (F G : CategoryTheory.Functor (Opposite C) M) {V₁ V₂ X BW : C}
        (k : V₁ ⟶ V₂) (ι : X ⟶ V₁) (e : X ≅ BW)
        (ψ₁ : F.obj (Opposite.op V₁) ⟶ G.obj (Opposite.op V₁))
        (φ : F.obj (Opposite.op BW) ⟶ G.obj (Opposite.op BW)),
        ψ₁ ≫ G.map (Opposite.op ι) =
          F.map (Opposite.op (ι ≫ 𝟙 V₁)) ≫ F.map (Opposite.op e.inv) ≫ φ ≫ G.map (Opposite.op e.hom) →
        (F.map (Opposite.op k) ≫ ψ₁) ≫ G.map (Opposite.op ι) =
          F.map (Opposite.op (ι ≫ k)) ≫ F.map (Opposite.op e.inv) ≫ φ ≫ G.map (Opposite.op e.hom) := by
      intro C M _ _ F G V₁ V₂ X BW k ι e ψ₁ φ h
      rw [CategoryTheory.Category.assoc, h, CategoryTheory.Category.comp_id,
        hopMap F ι k, CategoryTheory.Category.assoc]
    have hCatMapPreimage : ∀ {C M : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
        [CategoryTheory.Category.{u, u + 1} M]
        (F G : CategoryTheory.Functor (Opposite C) M) {X U : C}
        (t : X ≅ U) (φ : F.obj (Opposite.op U) ⟶ G.obj (Opposite.op U)),
        φ ≫ G.map (Opposite.op t.hom) =
          F.map (Opposite.op (t.hom ≫ 𝟙 U)) ≫ F.map (Opposite.op t.inv) ≫
            φ ≫ G.map (Opposite.op t.hom) := by
      intro C M _ _ F G X U t φ
      rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc (F.map _),
        ← hopMap F t.inv t.hom, t.inv_hom_id, hidMap F U, CategoryTheory.Category.id_comp]
    have hCatPreimageMap : ∀ {C M : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
        [CategoryTheory.Category.{u, u + 1} M]
        (F G : CategoryTheory.Functor (Opposite C) M) (φ : F ⟶ G) {X V BW : C}
        (ι : X ⟶ V) (e : X ≅ BW),
        φ.app (Opposite.op V) ≫ G.map (Opposite.op ι) =
          F.map (Opposite.op (ι ≫ 𝟙 V)) ≫ F.map (Opposite.op e.inv) ≫
            φ.app (Opposite.op BW) ≫ G.map (Opposite.op e.hom) := by
      intro C M _ _ F G φ X V BW ι e
      rw [CategoryTheory.Category.comp_id, ← φ.naturality (Opposite.op ι)]
      congr 1
      rw [φ.naturality_assoc (Opposite.op e.inv), ← hopMap G e.hom e.inv,
        e.hom_inv_id, hidMap G X, CategoryTheory.Category.comp_id]
    have hCompOpenImm : ∀ (X : AlgebraicGeometry.Scheme.{u})
        (O₁ : X.Opens) (O₂ : O₁.toScheme.Opens),
        AlgebraicGeometry.IsOpenImmersion (O₂.ι ≫ O₁.ι) :=
      fun _ _ _ => inferInstance
    
    have hFF : Nonempty i_push.FullyFaithful := by
      let IsLocalPhiAlong : ∀ {ℱ 𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)}
          (Φ : i_push.obj ℱ ⟶ i_push.obj 𝒢) {U V : Z.Etale} (k : U ⟶ V)
          (h : ℱ.obj.obj (Opposite.op V) ⟶ 𝒢.obj.obj (Opposite.op U)), Prop :=
        fun {ℱ 𝒢} Φ {U V} k h =>
          ∀ u : ↥U.left, ∃ (O_u : U.left.Opens) (_ : u ∈ O_u) (W_u : Y.Etale)
            (e_u : openSub U O_u ≅ B_i.obj W_u),
            h ≫ 𝒢.obj.map (Opposite.op (openSubι U O_u)) =
              ℱ.obj.map (Opposite.op (openSubι U O_u ≫ k)) ≫
                ℱ.obj.map (Opposite.op e_u.inv) ≫
                Φ.hom.app (Opposite.op W_u) ≫
                𝒢.obj.map (Opposite.op e_u.hom)
      have hPullbackLocalPhi : ∀ {ℱ 𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)}
          (Φ : i_push.obj ℱ ⟶ i_push.obj 𝒢) {P U V : Z.Etale} (p : P ⟶ U) (k : U ⟶ V)
          (h : ℱ.obj.obj (Opposite.op V) ⟶ 𝒢.obj.obj (Opposite.op U)),
          IsLocalPhiAlong Φ k h →
          IsLocalPhiAlong Φ (p ≫ k) (h ≫ 𝒢.obj.map (Opposite.op p)) := by
        intro ℱ 𝒢 Φ P U V p k h hLoc x
        obtain ⟨O_u, hu, W_u, e_u, heq_u⟩ := hLoc (p.left.base x)
        let O_P : P.left.Opens := (TopologicalSpace.Opens.map p.left.base).obj O_u
        have hx_OP : x ∈ O_P := hu
        have hRange_OP : Set.range (O_P.ι ≫ p.left).base ⊆ Set.range O_u.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨y, rfl⟩
          exact y.2
        let p_O : O_P.toScheme ⟶ O_u.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift O_u.ι (O_P.ι ≫ p.left) hRange_OP
        have hp_O_fac : p_O ≫ O_u.ι = O_P.ι ≫ p.left :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac O_u.ι (O_P.ι ≫ p.left) hRange_OP
        let p_sub : openSub P O_P ⟶ openSub U O_u :=
          CategoryTheory.MorphismProperty.Over.homMk p_O
            (by
              change p_O ≫ (O_u.ι ≫ U.hom) = O_P.ι ≫ P.hom
              rw [← CategoryTheory.Category.assoc, hp_O_fac, CategoryTheory.Category.assoc]
              erw [CategoryTheory.MorphismProperty.Over.w p])
            trivial
        have hp_sub_ι : p_sub ≫ openSubι U O_u = openSubι P O_P ≫ p :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext hp_O_fac (Subsingleton.elim _ _)
        obtain ⟨O'_x, hx_O', W'_x, g_x, e'_x, he'_x⟩ :=
          hSliceLift W_u (openSub P O_P) (p_sub ≫ e_u.hom) ⟨x, hx_OP⟩
        let j_Ox : O'_x.toScheme ⟶ P.left :=
          (O'_x.ι : O'_x.toScheme ⟶ O_P.toScheme) ≫ O_P.ι
        haveI : AlgebraicGeometry.IsOpenImmersion j_Ox := hCompOpenImm P.left O_P O'_x
        let O_x : P.left.Opens := j_Ox.opensRange
        have hx_Ox : x ∈ O_x := ⟨⟨⟨x, hx_OP⟩, hx_O'⟩, rfl⟩
        let iso_Ox : O'_x.toScheme ≅ O_x.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq j_Ox O_x.ι
            (AlgebraicGeometry.Scheme.Opens.range_ι O_x).symm
        have hiso_Ox : iso_Ox.hom ≫ O_x.ι = j_Ox :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _
        have hiso_inv_Ox : iso_Ox.inv ≫ j_Ox = O_x.ι :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac _ _ _
        let iso_sub : openSub (openSub P O_P) O'_x ≅ openSub P O_x :=
          { hom := CategoryTheory.MorphismProperty.Over.homMk iso_Ox.hom
              (by
                change iso_Ox.hom ≫ (O_x.ι ≫ P.hom) = O'_x.ι ≫ (O_P.ι ≫ P.hom)
                exact (CategoryTheory.Category.assoc iso_Ox.hom O_x.ι P.hom).symm.trans
                  ((congrArg (· ≫ P.hom) hiso_Ox).trans
                    (CategoryTheory.Category.assoc O'_x.ι O_P.ι P.hom)))
              trivial
            inv := CategoryTheory.MorphismProperty.Over.homMk iso_Ox.inv
              (by
                change iso_Ox.inv ≫ (O'_x.ι ≫ (O_P.ι ≫ P.hom)) = O_x.ι ≫ P.hom
                exact (congrArg (iso_Ox.inv ≫ ·)
                  (CategoryTheory.Category.assoc O'_x.ι O_P.ι P.hom).symm).trans
                  ((CategoryTheory.Category.assoc iso_Ox.inv j_Ox P.hom).symm.trans
                    (congrArg (· ≫ P.hom) hiso_inv_Ox)))
              trivial
            hom_inv_id := CategoryTheory.MorphismProperty.Comma.Hom.ext iso_Ox.hom_inv_id (Subsingleton.elim _ _)
            inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext iso_Ox.inv_hom_id (Subsingleton.elim _ _) }
        have hiso_ι : iso_sub.inv ≫ openSubι (openSub P O_P) O'_x ≫ openSubι P O_P = openSubι P O_x :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext hiso_inv_Ox (Subsingleton.elim _ _)
        let e_x : openSub P O_x ≅ B_i.obj W'_x := iso_sub.symm.trans e'_x
        refine ⟨O_x, hx_Ox, W'_x, e_x, ?_⟩
        exact hCatTransport B_i ℱ.obj 𝒢.obj Φ.hom
          (openSubι P O_x) p k (openSubι U O_u)
          (iso_sub.inv ≫ openSubι (openSub P O_P) O'_x ≫ p_sub) g_x e_u e_x h
          (hCatSubComp iso_sub.inv (openSubι (openSub P O_P) O'_x) (openSubι P O_P)
            (openSubι P O_x) p p_sub (openSubι U O_u) hiso_ι hp_sub_ι)
          (hCatIsoSub iso_sub e'_x (openSubι (openSub P O_P) O'_x ≫ p_sub)
            (B_i.map g_x) e_u.hom
            (by
              have h' : e'_x.hom ≫ B_i.map g_x =
                  openSubι (openSub P O_P) O'_x ≫ (p_sub ≫ e_u.hom) := he'_x
              exact h'.trans (CategoryTheory.Category.assoc _ _ _).symm))
          heq_u
      have hUniqueLocalPhi : ∀ {ℱ 𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)}
          (Φ : i_push.obj ℱ ⟶ i_push.obj 𝒢) {U V : Z.Etale} (k : U ⟶ V)
          (h₁ h₂ : ℱ.obj.obj (Opposite.op V) ⟶ 𝒢.obj.obj (Opposite.op U)),
          IsLocalPhiAlong Φ k h₁ → IsLocalPhiAlong Φ k h₂ → h₁ = h₂ := by
        intro ℱ 𝒢 Φ U V k h₁ h₂ hLoc₁ hLoc₂
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro s
        let σ_s : R_mod ⟶ ℱ.obj.obj (Opposite.op V) :=
          ModuleCat.ofHom (LinearMap.toSpanSingleton R _ s)
        suffices hσ : σ_s ≫ h₁ = σ_s ≫ h₂ by
          have hev := congrArg (fun mor : R_mod ⟶ 𝒢.obj.obj (Opposite.op U) => mor.hom (1 : R)) hσ
          change (h₁.hom ((LinearMap.toSpanSingleton R _ s) (1 : R))) =
            (h₂.hom ((LinearMap.toSpanSingleton R _ s) (1 : R))) at hev
          rwa [LinearMap.toSpanSingleton_apply, one_smul] at hev
        let O₁ := fun u : ↥U.left => Classical.choose (hLoc₁ u)
        have hO₁ := fun u : ↥U.left => Classical.choose_spec (hLoc₁ u)
        let O₂ := fun u : ↥U.left => Classical.choose (hLoc₂ u)
        have hO₂ := fun u : ↥U.left => Classical.choose_spec (hLoc₂ u)
        let O₁₂ : ↥U.left → U.left.Opens := fun u => O₁ u ⊓ O₂ u
        have hO₁₂ : ∀ u : ↥U.left, u ∈ O₁₂ u := fun u => ⟨(hO₁ u).choose, (hO₂ u).choose⟩
        apply 𝒢.property.hom_ext_ofArrows (fun u => openSubι U (O₁₂ u)) (hOpenCoverMem U O₁₂ hO₁₂)
        intro u
        rcases (hO₁ u).choose_spec with ⟨W₁, e₁, heq₁⟩
        rcases (hO₂ u).choose_spec with ⟨W₂, e₂, heq₂⟩
        let inc₁ : openSub U (O₁₂ u) ⟶ openSub U (O₁ u) :=
          CategoryTheory.MorphismProperty.Over.homMk (U.left.homOfLE inf_le_left)
            (by
              change U.left.homOfLE inf_le_left ≫ ((O₁ u).ι ≫ U.hom) = (O₁₂ u).ι ≫ U.hom
              rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι])
            trivial
        let inc₂ : openSub U (O₁₂ u) ⟶ openSub U (O₂ u) :=
          CategoryTheory.MorphismProperty.Over.homMk (U.left.homOfLE inf_le_right)
            (by
              change U.left.homOfLE inf_le_right ≫ ((O₂ u).ι ≫ U.hom) = (O₁₂ u).ι ≫ U.hom
              rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι])
            trivial
        have hinc₁ : inc₁ ≫ openSubι U (O₁ u) = openSubι U (O₁₂ u) :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext
            (AlgebraicGeometry.Scheme.homOfLE_ι U.left inf_le_left) (Subsingleton.elim _ _)
        have hinc₂ : inc₂ ≫ openSubι U (O₂ u) = openSubι U (O₁₂ u) :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext
            (AlgebraicGeometry.Scheme.homOfLE_ι U.left inf_le_right) (Subsingleton.elim _ _)
        obtain ⟨W₁₂, pr₁, pr₂, β₁₂, hβ₁, hβ₂⟩ :=
          hPairBi W₁ W₂ (openSub U (O₁₂ u)) (inc₁ ≫ e₁.hom) (inc₂ ≫ e₂.hom)
        let U_sub := openSub U (O₁₂ u)
        let lift_x := fun x : ↥U_sub.left => hSliceLift W₁₂ U_sub β₁₂ x
        let O'_x : ↥U_sub.left → U_sub.left.Opens := fun x => Classical.choose (lift_x x)
        have hO'_x : ∀ x : ↥U_sub.left, x ∈ O'_x x :=
          fun x => (Classical.choose_spec (lift_x x)).choose
        apply 𝒢.property.hom_ext_ofArrows (fun x => openSubι U_sub (O'_x x))
          (hOpenCoverMem U_sub O'_x hO'_x)
        intro x
        rcases (Classical.choose_spec (lift_x x)).choose_spec with ⟨W''_x, f_x, e''_x, he''_x⟩
        let g₁ : W''_x ⟶ W₁ := f_x ≫ pr₁
        let g₂ : W''_x ⟶ W₂ := f_x ≫ pr₂
        have h_side₁ : (h₁ ≫ 𝒢.obj.map (Opposite.op (openSubι U (O₁₂ u)))) ≫
            𝒢.obj.map (Opposite.op (openSubι U_sub (O'_x x))) =
          ℱ.obj.map (Opposite.op (openSubι U_sub (O'_x x) ≫ openSubι U (O₁₂ u) ≫ k)) ≫
            ℱ.obj.map (Opposite.op e''_x.inv) ≫ Φ.hom.app (Opposite.op W''_x) ≫
            𝒢.obj.map (Opposite.op e''_x.hom) :=
          hCatTransport B_i ℱ.obj 𝒢.obj Φ.hom
            (openSubι U_sub (O'_x x)) (openSubι U (O₁₂ u)) k (openSubι U (O₁ u))
            (openSubι U_sub (O'_x x) ≫ inc₁) g₁ e₁ e''_x h₁
            (hCatIncQ (openSubι U_sub (O'_x x)) inc₁ (openSubι U (O₁ u)) (openSubι U (O₁₂ u)) hinc₁)
            (hCatIncE B_i e''_x f_x pr₁ (openSubι U_sub (O'_x x)) β₁₂ inc₁ e₁ hβ₁ he''_x)
            heq₁
        have h_side₂ : (h₂ ≫ 𝒢.obj.map (Opposite.op (openSubι U (O₁₂ u)))) ≫
            𝒢.obj.map (Opposite.op (openSubι U_sub (O'_x x))) =
          ℱ.obj.map (Opposite.op (openSubι U_sub (O'_x x) ≫ openSubι U (O₁₂ u) ≫ k)) ≫
            ℱ.obj.map (Opposite.op e''_x.inv) ≫ Φ.hom.app (Opposite.op W''_x) ≫
            𝒢.obj.map (Opposite.op e''_x.hom) :=
          hCatTransport B_i ℱ.obj 𝒢.obj Φ.hom
            (openSubι U_sub (O'_x x)) (openSubι U (O₁₂ u)) k (openSubι U (O₂ u))
            (openSubι U_sub (O'_x x) ≫ inc₂) g₂ e₂ e''_x h₂
            (hCatIncQ (openSubι U_sub (O'_x x)) inc₂ (openSubι U (O₂ u)) (openSubι U (O₁₂ u)) hinc₂)
            (hCatIncE B_i e''_x f_x pr₂ (openSubι U_sub (O'_x x)) β₁₂ inc₂ e₂ hβ₂ he''_x)
            heq₂
        exact (CategoryTheory.Category.assoc _ _ _).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (σ_s ≫ ·) ((CategoryTheory.Category.assoc _ _ _).symm.trans
              (h_side₁.trans (h_side₂.symm.trans (CategoryTheory.Category.assoc _ _ _))))).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                (CategoryTheory.Category.assoc _ _ _).symm)))
      
      let toBiTY : ∀ (V : Z.Etale), V ⟶ B_i.obj T_Y := fun V =>
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift (V.hom ≫ i) V.hom
            (CategoryTheory.Category.comp_id _).symm)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
      
      let schTopIso : ∀ (X : AlgebraicGeometry.Scheme.{u}), (⊤ : X.Opens).toScheme ≅ X := fun X =>
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (⊤ : X.Opens).ι (𝟙 X)
          (by rw [AlgebraicGeometry.Scheme.Opens.range_ι]; simp)
      have hSchTopIsoHom : ∀ (X : AlgebraicGeometry.Scheme.{u}),
          (schTopIso X).hom = (⊤ : X.Opens).ι := fun X =>
        (CategoryTheory.Category.comp_id _).symm.trans
          (AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac (⊤ : X.Opens).ι (𝟙 X) _)
      have hSchTopIsoInv : ∀ (X : AlgebraicGeometry.Scheme.{u}),
          (schTopIso X).inv ≫ (⊤ : X.Opens).ι = 𝟙 X := fun X =>
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac (⊤ : X.Opens).ι (𝟙 X) _
      let topSubIso : ∀ (U : Z.Etale), openSub U ⊤ ≅ U := fun U =>
        { hom := openSubι U ⊤
          inv := CategoryTheory.MorphismProperty.Over.homMk (schTopIso U.left).inv
            (by
              change (schTopIso U.left).inv ≫ ((⊤ : U.left.Opens).ι ≫ U.hom) = U.hom
              exact (CategoryTheory.Category.assoc (schTopIso U.left).inv
                (⊤ : U.left.Opens).ι U.hom).symm.trans
                ((congrArg (· ≫ U.hom) (hSchTopIsoInv U.left)).trans
                  (CategoryTheory.Category.id_comp U.hom)))
            trivial
          hom_inv_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
            ((congrArg (· ≫ (schTopIso U.left).inv) (hSchTopIsoHom U.left).symm).trans
              (schTopIso U.left).hom_inv_id)
            (Subsingleton.elim _ _)
          inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
            (hSchTopIsoInv U.left) (Subsingleton.elim _ _) }
      
      let mkPsiApp : ∀ {ℱ 𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)}
          (Φ : i_push.obj ℱ ⟶ i_push.obj 𝒢) (V : Z.Etale),
          { ψ_V : ℱ.obj.obj (Opposite.op V) ⟶ 𝒢.obj.obj (Opposite.op V) //
            IsLocalPhiAlong Φ (𝟙 V) ψ_V } := fun {ℱ 𝒢} Φ V => by
        let lift_z := fun z : ↥V.left => hSliceLift T_Y V (toBiTY V) z
        let O_z : ↥V.left → V.left.Opens := fun z => Classical.choose (lift_z z)
        have hO_z : ∀ z : ↥V.left, z ∈ O_z z :=
          fun z => (Classical.choose_spec (lift_z z)).choose
        let W'_z : ↥V.left → Y.Etale :=
          fun z => (Classical.choose_spec (lift_z z)).choose_spec.choose
        let e_z : ∀ z : ↥V.left, openSub V (O_z z) ≅ B_i.obj (W'_z z) :=
          fun z => (Classical.choose_spec (lift_z z)).choose_spec.choose_spec.choose_spec.choose
        let h_loc : ∀ z : ↥V.left,
            ℱ.obj.obj (Opposite.op V) ⟶ 𝒢.obj.obj (Opposite.op (openSub V (O_z z))) :=
          fun z =>
            ℱ.obj.map (Opposite.op (openSubι V (O_z z))) ≫
              ℱ.obj.map (Opposite.op (e_z z).inv) ≫
              Φ.hom.app (Opposite.op (W'_z z)) ≫
              𝒢.obj.map (Opposite.op (e_z z).hom)
        have h_loc_prop : ∀ z : ↥V.left, IsLocalPhiAlong Φ (openSubι V (O_z z)) (h_loc z) := by
          intro z u
          refine ⟨⊤, trivial, W'_z z, (topSubIso (openSub V (O_z z))).trans (e_z z), ?_⟩
          exact hCatTopLoc ℱ.obj 𝒢.obj (topSubIso (openSub V (O_z z)))
            (openSubι V (O_z z)) (e_z z) (Φ.hom.app (Opposite.op (W'_z z)))
        have h_compat : ∀ ⦃P : Z.Etale⦄ ⦃z₁ z₂ : ↥V.left⦄
            (a : P ⟶ openSub V (O_z z₁)) (b : P ⟶ openSub V (O_z z₂)),
            a ≫ openSubι V (O_z z₁) = b ≫ openSubι V (O_z z₂) →
            h_loc z₁ ≫ 𝒢.obj.map a.op = h_loc z₂ ≫ 𝒢.obj.map b.op := by
          intro P z₁ z₂ a b hab
          apply hUniqueLocalPhi Φ (a ≫ openSubι V (O_z z₁))
          · exact hPullbackLocalPhi Φ a (openSubι V (O_z z₁)) (h_loc z₁) (h_loc_prop z₁)
          · erw [hab]
            exact hPullbackLocalPhi Φ b (openSubι V (O_z z₂)) (h_loc z₂) (h_loc_prop z₂)
        let hCov := hOpenCoverMem V O_z hO_z
        let σ : ℱ.obj.obj (Opposite.op V) → (R_mod ⟶ ℱ.obj.obj (Opposite.op V)) :=
          fun s => ModuleCat.ofHom (LinearMap.toSpanSingleton R _ s)
        let amalg : ℱ.obj.obj (Opposite.op V) → (R_mod ⟶ 𝒢.obj.obj (Opposite.op V)) :=
          fun s => 𝒢.property.amalgamateOfArrows (fun z => openSubι V (O_z z)) hCov
            (fun z => σ s ≫ h_loc z)
            (fun P z₁ z₂ a b hab =>
              (CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (σ s ≫ ·) (h_compat a b hab)).trans
                  (CategoryTheory.Category.assoc _ _ _).symm))
        have hamalg_map : ∀ (s : ℱ.obj.obj (Opposite.op V)) (z : ↥V.left),
            amalg s ≫ 𝒢.obj.map (openSubι V (O_z z)).op = σ s ≫ h_loc z :=
          fun s z => 𝒢.property.amalgamateOfArrows_map _ hCov _ _ z
        let ψ_V : ℱ.obj.obj (Opposite.op V) ⟶ 𝒢.obj.obj (Opposite.op V) :=
          ModuleCat.ofHom
            { toFun := fun s => (amalg s).hom (1 : R)
              map_add' := fun s₁ s₂ => by
                have heq : amalg (s₁ + s₂) = amalg s₁ + amalg s₂ := by
                  apply 𝒢.property.hom_ext_ofArrows (fun z => openSubι V (O_z z)) hCov
                  intro z
                  calc
                    amalg (s₁ + s₂) ≫ 𝒢.obj.map (openSubι V (O_z z)).op
                      = σ (s₁ + s₂) ≫ h_loc z := hamalg_map (s₁ + s₂) z
                    _ = (σ s₁ + σ s₂) ≫ h_loc z := by
                          congr 1; apply ModuleCat.hom_ext; ext r; simp [σ, smul_add]
                    _ = σ s₁ ≫ h_loc z + σ s₂ ≫ h_loc z :=
                          CategoryTheory.Preadditive.add_comp _ _ _ _ _ _
                    _ = amalg s₁ ≫ 𝒢.obj.map (openSubι V (O_z z)).op +
                          amalg s₂ ≫ 𝒢.obj.map (openSubι V (O_z z)).op :=
                          congrArg₂ (· + ·) (hamalg_map s₁ z).symm (hamalg_map s₂ z).symm
                    _ = (amalg s₁ + amalg s₂) ≫ 𝒢.obj.map (openSubι V (O_z z)).op :=
                          (CategoryTheory.Preadditive.add_comp _ _ _ _ _ _).symm
                exact congrArg (fun mor : R_mod ⟶ 𝒢.obj.obj (Opposite.op V) => mor.hom (1 : R)) heq
              map_smul' := fun c s => by
                have heq : amalg (c • s) = ModuleCat.ofHom (LinearMap.lsmul R R c) ≫ amalg s := by
                  apply 𝒢.property.hom_ext_ofArrows (fun z => openSubι V (O_z z)) hCov
                  intro z
                  calc
                    amalg (c • s) ≫ 𝒢.obj.map (openSubι V (O_z z)).op
                      = σ (c • s) ≫ h_loc z := hamalg_map (c • s) z
                    _ = (ModuleCat.ofHom (LinearMap.lsmul R R c) ≫ σ s) ≫ h_loc z := by
                          congr 1; apply ModuleCat.hom_ext; ext r; simp [σ, mul_smul]
                    _ = ModuleCat.ofHom (LinearMap.lsmul R R c) ≫ (σ s ≫ h_loc z) :=
                          CategoryTheory.Category.assoc _ _ _
                    _ = ModuleCat.ofHom (LinearMap.lsmul R R c) ≫
                          (amalg s ≫ 𝒢.obj.map (openSubι V (O_z z)).op) :=
                          congrArg (ModuleCat.ofHom (LinearMap.lsmul R R c) ≫ ·) (hamalg_map s z).symm
                    _ = (ModuleCat.ofHom (LinearMap.lsmul R R c) ≫ amalg s) ≫
                          𝒢.obj.map (openSubι V (O_z z)).op :=
                          (CategoryTheory.Category.assoc _ _ _).symm
                have hev := congrArg (fun mor : R_mod ⟶ 𝒢.obj.obj (Opposite.op V) => mor.hom (1 : R)) heq
                change (amalg (c • s)).hom (1 : R) =
                  (amalg s).hom ((LinearMap.lsmul R R c) (1 : R)) at hev
                exact hev.trans (by erw [LinearMap.lsmul_apply, map_smul]; rfl) }
        have hψ_res : ∀ z : ↥V.left,
            ψ_V ≫ 𝒢.obj.map (Opposite.op (openSubι V (O_z z))) = h_loc z := by
          intro z
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro s
          have hev := congrArg (fun mor : R_mod ⟶ 𝒢.obj.obj (Opposite.op (openSub V (O_z z))) =>
            mor.hom (1 : R)) (hamalg_map s z)
          change (ψ_V ≫ 𝒢.obj.map (Opposite.op (openSubι V (O_z z)))).hom s =
            (h_loc z).hom ((LinearMap.toSpanSingleton R _ s) (1 : R)) at hev
          rwa [LinearMap.toSpanSingleton_apply, one_smul] at hev
        refine ⟨ψ_V, fun z => ⟨O_z z, hO_z z, W'_z z, e_z z, ?_⟩⟩
        exact hCatIdPsi ℱ.obj 𝒢.obj (openSubι V (O_z z)) (e_z z) ψ_V
          (Φ.hom.app (Opposite.op (W'_z z))) (hψ_res z)
      let preimagePhi : ∀ {ℱ 𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)},
          (i_push.obj ℱ ⟶ i_push.obj 𝒢) → (ℱ ⟶ 𝒢) := fun {ℱ 𝒢} Φ =>
        CategoryTheory.ObjectProperty.homMk
          { app := fun opV => (mkPsiApp Φ opV.unop).1
            naturality := fun {opV₂ opV₁} k_op => by
              let k : opV₁.unop ⟶ opV₂.unop := k_op.unop
              change ℱ.obj.map (Opposite.op k) ≫ (mkPsiApp Φ opV₁.unop).1 =
                (mkPsiApp Φ opV₂.unop).1 ≫ 𝒢.obj.map (Opposite.op k)
              apply hUniqueLocalPhi Φ k
              · intro u
                obtain ⟨O_u, hu, W_u, e_u, heq_u⟩ := (mkPsiApp Φ opV₁.unop).2 u
                exact ⟨O_u, hu, W_u, e_u,
                  hCatNatLeft ℱ.obj 𝒢.obj k (openSubι opV₁.unop O_u) e_u
                    (mkPsiApp Φ opV₁.unop).1 (Φ.hom.app (Opposite.op W_u)) heq_u⟩
              · have hp := hPullbackLocalPhi Φ k (𝟙 opV₂.unop)
                  (mkPsiApp Φ opV₂.unop).1 (mkPsiApp Φ opV₂.unop).2
                erw [CategoryTheory.Category.comp_id] at hp
                exact hp }
      refine ⟨{
        preimage := fun {ℱ 𝒢} Φ => preimagePhi Φ
        map_preimage := fun {ℱ 𝒢} Φ => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext opW
          let W := opW.unop
          change (mkPsiApp Φ (B_i.obj W)).1 = Φ.hom.app (Opposite.op W)
          apply hUniqueLocalPhi Φ (𝟙 (B_i.obj W)) _ _ (mkPsiApp Φ (B_i.obj W)).2
          intro u
          exact ⟨⊤, trivial, W, topSubIso (B_i.obj W),
            hCatMapPreimage ℱ.obj 𝒢.obj (topSubIso (B_i.obj W)) (Φ.hom.app (Opposite.op W))⟩
        preimage_map := fun {ℱ 𝒢} φ => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext opV
          let V := opV.unop
          change (mkPsiApp (i_push.map φ) V).1 = φ.hom.app (Opposite.op V)
          apply hUniqueLocalPhi (i_push.map φ) (𝟙 V) _ _ (mkPsiApp (i_push.map φ) V).2
          intro z
          obtain ⟨O_z, hz, W'_z, f_z, e_z, _⟩ := hSliceLift T_Y V (toBiTY V) z
          exact ⟨O_z, hz, W'_z, e_z,
            hCatPreimageMap ℱ.obj 𝒢.obj φ.hom (openSubι V O_z) e_z⟩
      }⟩
    
    let U_c : Y.Opens :=
      ⟨(Set.range i.base)ᶜ,
        (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding i).isClosed_range.isOpen_compl⟩
    have hTermZero : ∀ {M : ModuleCat.{u, u} R},
        CategoryTheory.Limits.IsTerminal M → ∀ x : M, x = 0 := by
      intro M hTM x
      have h := hTM.hom_ext
        (ModuleCat.ofHom (LinearMap.toSpanSingleton R M x))
        (0 : R_mod ⟶ M)
      have hev := congrArg (fun f : R_mod ⟶ M => f.hom (1 : R)) h
      change (LinearMap.toSpanSingleton R (↑M) x) (1 : R) = 0 at hev
      rwa [LinearMap.toSpanSingleton_apply, one_smul] at hev
    have hLiftCover : ∀ (W : Y.Etale) (S_Z : CategoryTheory.Sieve (B_i.obj W)),
        S_Z ∈ Z.smallEtaleTopology (B_i.obj W) →
        ∀ w : ↥W.left,
          ∃ (W'_w : Y.Etale) (g_w : W'_w ⟶ W) (p'_w : ↥W'_w.left),
            AlgebraicGeometry.Etale g_w.left ∧
            g_w.left.base p'_w = w ∧
            ((⊥ : CategoryTheory.Sieve (B_i.obj W'_w)) ∈ Z.smallEtaleTopology (B_i.obj W'_w) ∨
              S_Z.arrows (B_i.map g_w)) := by
      intro W S_Z hSZ w
      haveI : AlgebraicGeometry.Etale W.hom := W.prop
      by_cases hw : W.hom.base w ∈ Set.range i.base
      · rcases hw with ⟨z₀, hz₀⟩
        obtain ⟨z₁, hz₁_fst, -⟩ :=
          AlgebraicGeometry.Scheme.exists_preimage_of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback W.hom i) w z₀ hz₀.symm
        obtain ⟨V_Z, α, z, hα_mem, -, hz_map⟩ := (hMemEtaleTop (B_i.obj W) S_Z).mp hSZ z₁
        obtain ⟨O_z, hz_Oz, W'_w, g_w, e_z, he_z⟩ := hSliceLift W V_Z α z
        haveI : AlgebraicGeometry.Etale W'_w.hom := W'_w.prop
        have hg_et : AlgebraicGeometry.Etale g_w.left :=
          CategoryTheory.MorphismProperty.of_postcomp
            (@AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale) g_w.left W.hom W.prop
            (by erw [CategoryTheory.MorphismProperty.Over.w g_w]; exact W'_w.prop)
        let p'_w : ↥W'_w.left :=
          (CategoryTheory.Limits.pullback.fst W'_w.hom i).base (e_z.hom.left.base ⟨z, hz_Oz⟩)
        have hp'_map : g_w.left.base p'_w = w := by
          have hBf_fst : (B_i.map g_w).left ≫ CategoryTheory.Limits.pullback.fst W.hom i =
              CategoryTheory.Limits.pullback.fst W'_w.hom i ≫ g_w.left := by
            dsimp [B_i]
            erw [CategoryTheory.MorphismProperty.Over.pullback_map_left,
              CategoryTheory.Limits.pullback.lift_fst]
          have hpt := congrArg (fun mor : (openSub V_Z O_z).left ⟶ W.left => mor.base ⟨z, hz_Oz⟩)
            (calc
              e_z.hom.left ≫ CategoryTheory.Limits.pullback.fst W'_w.hom i ≫ g_w.left
                = (e_z.hom ≫ B_i.map g_w).left ≫ CategoryTheory.Limits.pullback.fst W.hom i := by
                    erw [← hBf_fst]; rfl
              _ = (openSubι V_Z O_z ≫ α).left ≫ CategoryTheory.Limits.pullback.fst W.hom i := by
                    erw [he_z])
          dsimp [p'_w, openSubι] at hpt ⊢
          refine hpt.trans ?_
          change (CategoryTheory.Limits.pullback.fst W.hom i).base (α.left.base z) = w
          rw [hz_map, hz₁_fst]
        have hS_arrow : S_Z.arrows (B_i.map g_w) := by
          have hfac : B_i.map g_w = (e_z.inv ≫ openSubι V_Z O_z) ≫ α := by
            erw [CategoryTheory.Category.assoc, ← he_z, ← CategoryTheory.Category.assoc,
              e_z.inv_hom_id, CategoryTheory.Category.id_comp]
          rw [hfac]
          exact S_Z.downward_closed hα_mem _
        exact ⟨W'_w, g_w, p'_w, hg_et, hp'_map, Or.inr hS_arrow⟩
      · let O_w : W.left.Opens := (TopologicalSpace.Opens.map W.hom.base).obj U_c
        have hw_Ow : w ∈ O_w := hw
        let W'_w : Y.Etale := openSub W O_w
        let g_w : W'_w ⟶ W := openSubι W O_w
        have hg_et : AlgebraicGeometry.Etale g_w.left := by
          change AlgebraicGeometry.Etale O_w.ι
          infer_instance
        have hBot : (⊥ : CategoryTheory.Sieve (B_i.obj W'_w)) ∈
            Z.smallEtaleTopology (B_i.obj W'_w) := by
          rw [hMemEtaleTop]
          intro p
          exfalso
          let x₀ : ↥O_w := (CategoryTheory.Limits.pullback.fst W'_w.hom i).base p
          let z₀ : ↥Z := (CategoryTheory.Limits.pullback.snd W'_w.hom i).base p
          have hcond : W'_w.hom.base x₀ = i.base z₀ :=
            congrArg (fun mor : (B_i.obj W'_w).left ⟶ Y => mor.base p)
              (CategoryTheory.Limits.pullback.condition (f := W'_w.hom) (g := i))
          exact x₀.2 ⟨z₀, hcond.symm⟩
        exact ⟨W'_w, g_w, ⟨w, hw_Ow⟩, hg_et, rfl, Or.inl hBot⟩
    
    have hEpiPush : ∀ {𝒜 ℬ : CategoryTheory.Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)}
        (π : 𝒜 ⟶ ℬ) [CategoryTheory.Epi π], CategoryTheory.Epi (i_push.map π) := by
      intro 𝒜 ℬ π _
      have hSurj_π : CategoryTheory.Sheaf.IsLocallySurjective π :=
        (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' (ModuleCat.{u, u} R) π).mpr inferInstance
      have hLocSurj : CategoryTheory.Sheaf.IsLocallySurjective (i_push.map π) := by
        refine ⟨fun {W} s => ?_⟩
        let s_Z : ℬ.obj.obj (Opposite.op (B_i.obj W)) := s
        let S_Z : CategoryTheory.Sieve (B_i.obj W) := CategoryTheory.Presheaf.imageSieve π.hom s_Z
        have hSZ : S_Z ∈ Z.smallEtaleTopology (B_i.obj W) := hSurj_π.imageSieve_mem s_Z
        rw [hMemEtaleTop]
        intro w
        obtain ⟨W'_w, g_w, p'_w, hg_et, hp'_map, hcase⟩ := hLiftCover W S_Z hSZ w
        refine ⟨W'_w, g_w, p'_w, ?_, hg_et, hp'_map⟩
        rw [CategoryTheory.Presheaf.imageSieve_apply]
        rcases hcase with hBot | hArrow
        · refine ⟨0, ?_⟩
          have hT := CategoryTheory.Sheaf.isTerminalOfBotCover ℬ (B_i.obj W'_w) hBot
          have h0 := hTermZero hT (((i_push.obj ℬ).obj.map (Opposite.op g_w)).hom s)
          rw [map_zero]
          exact h0.symm
        · rwa [CategoryTheory.Presheaf.imageSieve_apply] at hArrow
      exact CategoryTheory.Sheaf.epi_of_isLocallySurjective (i_push.map π)
    have hColim_ipush : CategoryTheory.Limits.PreservesFiniteColimits i_push := by
      rw [CategoryTheory.Functor.preservesFiniteColimits_iff_forall_exact_map_and_epi]
      intro S hS
      haveI : CategoryTheory.Epi S.g := hS.epi_g
      refine ⟨?_, hEpiPush S.g⟩
      have hK := CategoryTheory.Limits.KernelFork.mapIsLimit _ hS.fIsKernel i_push
      exact CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hK
    
    have hEpi_qi : CategoryTheory.Epi q_i := by
      let P_Y := (CategoryTheory.Functor.const (Opposite Y.Etale)).obj R_mod
      let P_Z := (CategoryTheory.Functor.const (Opposite Z.Etale)).obj R_mod
      let η_Y : P_Y ⟶ One_Y.obj :=
        (CategoryTheory.sheafificationAdjunction Y.smallEtaleTopology (ModuleCat.{u, u} R)).unit.app P_Y
      let η_Z : P_Z ⟶ One_Z.obj :=
