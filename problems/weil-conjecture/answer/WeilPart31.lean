            CategoryTheory.CategoryStruct.comp η₀' (ν.hom.app one₂) = e₀.hom := by
    intro S₁ S₂ _ _ J₁ J₂ B ModCat _ _ _ R_mod hc F_pull adj₀ e₀ T₂ hT₂ T₁ hT₁ hEv₀
      hc' F_pull' adj₀' U₂' hU₂' U₁' hU₁'
    cases Subsingleton.elim hc hc'
    intro one₁ one₂ P_push adjMod₂ adjMod₁ ε₀' η₀' hηε'
    let ν : F_pull' ≅ F_pull := CategoryTheory.Adjunction.leftAdjointUniq adj₀' adj₀
    have hε : ε₀' = ν.hom.app one₂ ≫ e₀.inv := by
      let hat_g₀ : one₂ ⟶ P_push.obj one₁ := (adj₀.homEquiv one₂ one₁) e₀.inv
      have hEv_at :
          (CategoryTheory.constantSheafAdj J₂ ModCat hT₂).unit.app R_mod ≫
            (one₂.obj.map (Opposite.op (hT₂.from U₂')) ≫ hat_g₀.hom.app (Opposite.op U₂')) =
          (CategoryTheory.constantSheafAdj J₁ ModCat hT₁).unit.app R_mod ≫
            (one₁.obj.map (Opposite.op (hT₁.from (B.obj U₂'))) ≫
              (𝟙 one₁ : one₁ ⟶ one₁).hom.app (Opposite.op (B.obj U₂'))) := by
        have h₀ := hEv₀ one₁ (𝟙 one₁) U₂'
        dsimp only at h₀
        rwa [CategoryTheory.Category.comp_id] at h₀
      have h_lhs :
          (CategoryTheory.constantSheafAdj J₂ ModCat hT₂).unit.app R_mod ≫
            (one₂.obj.map (Opposite.op (hT₂.from U₂')) ≫ hat_g₀.hom.app (Opposite.op U₂')) =
          (adjMod₂.homEquiv R_mod (P_push.obj one₁)) hat_g₀ := by
        rw [← CategoryTheory.Category.assoc, hUnit J₂ hT₂ hU₂' R_mod,
          CategoryTheory.Adjunction.homEquiv_unit]
        rfl
      have h_term₁ : hT₁.from (B.obj U₂') = hU₁'.from (B.obj U₂') ≫ hT₁.from U₁' :=
        hT₁.hom_ext _ _
      have h_id_app : (𝟙 one₁ : one₁ ⟶ one₁).hom.app (Opposite.op (B.obj U₂')) = 𝟙 _ := rfl
      have h_map_term₁ :
          one₁.obj.map (Opposite.op (hT₁.from (B.obj U₂'))) =
          one₁.obj.map (Opposite.op (hT₁.from U₁')) ≫
            one₁.obj.map (Opposite.op (hU₁'.from (B.obj U₂'))) := by
        rw [h_term₁]
        exact one₁.obj.map_comp (Opposite.op (hT₁.from U₁')) (Opposite.op (hU₁'.from (B.obj U₂')))
      have h_rhs :
          (CategoryTheory.constantSheafAdj J₁ ModCat hT₁).unit.app R_mod ≫
            (one₁.obj.map (Opposite.op (hT₁.from (B.obj U₂'))) ≫
              (𝟙 one₁ : one₁ ⟶ one₁).hom.app (Opposite.op (B.obj U₂'))) =
          adjMod₁.unit.app R_mod ≫ one₁.obj.map (Opposite.op (hU₁'.from (B.obj U₂'))) := by
        rw [h_id_app, CategoryTheory.Category.comp_id, h_map_term₁,
          ← CategoryTheory.Category.assoc, hUnit J₁ hT₁ hU₁' R_mod]
      have h_eq_mod₂ :
          (adjMod₂.homEquiv R_mod (P_push.obj one₁)) hat_g₀ =
          adjMod₁.unit.app R_mod ≫ one₁.obj.map (Opposite.op (hU₁'.from (B.obj U₂'))) :=
        h_lhs.symm.trans (hEv_at.trans h_rhs)
      have h_symm_mod₂ :
          (adjMod₂.homEquiv R_mod (P_push.obj one₁)).symm
            (adjMod₁.unit.app R_mod ≫ one₁.obj.map (Opposite.op (hU₁'.from (B.obj U₂')))) =
          hat_g₀ :=
        (congrArg (adjMod₂.homEquiv R_mod (P_push.obj one₁)).symm h_eq_mod₂.symm).trans
          ((adjMod₂.homEquiv R_mod (P_push.obj one₁)).symm_apply_apply hat_g₀)
      have h_adj'_mate :
          (adj₀'.homEquiv one₂ one₁) (ν.hom.app one₂ ≫ e₀.inv) = hat_g₀ := by
        rw [CategoryTheory.Adjunction.homEquiv_unit, P_push.map_comp,
          ← CategoryTheory.Category.assoc,
          CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app adj₀' adj₀ one₂,
          ← CategoryTheory.Adjunction.homEquiv_unit]
      exact (congrArg (adj₀'.homEquiv one₂ one₁).symm (h_symm_mod₂.trans h_adj'_mate.symm)).trans
        ((adj₀'.homEquiv one₂ one₁).symm_apply_apply (ν.hom.app one₂ ≫ e₀.inv))
    have hη : η₀' ≫ ν.hom.app one₂ = e₀.hom := by
      calc
        η₀' ≫ ν.hom.app one₂
          = (η₀' ≫ ν.hom.app one₂) ≫ 𝟙 (F_pull.obj one₂) :=
            (CategoryTheory.Category.comp_id _).symm
        _ = (η₀' ≫ ν.hom.app one₂) ≫ (e₀.inv ≫ e₀.hom) := by rw [e₀.inv_hom_id]
        _ = (η₀' ≫ (ν.hom.app one₂ ≫ e₀.inv)) ≫ e₀.hom := by
          simp only [CategoryTheory.Category.assoc]
        _ = (η₀' ≫ ε₀') ≫ e₀.hom := by rw [← hε]
        _ = 𝟙 one₁ ≫ e₀.hom := by rw [hηε']
        _ = e₀.hom := CategoryTheory.Category.id_comp _
    exact ⟨ν, hε, hη⟩
  have hSandwich : ∀ {C_ab D_ab : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C_ab] [CategoryTheory.Abelian C_ab]
      [CategoryTheory.HasExt.{u} C_ab] [CategoryTheory.EnoughInjectives C_ab]
      [CategoryTheory.Category.{u + 1, u + 1} D_ab] [CategoryTheory.Abelian D_ab]
      [CategoryTheory.HasExt.{u} D_ab]
      (F₁ F₂ : C_ab ⥤ D_ab)
      [F₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₁]
      [CategoryTheory.Limits.PreservesFiniteColimits F₁]
      [F₂.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₂]
      [CategoryTheory.Limits.PreservesFiniteColimits F₂]
      (α : F₁ ⟶ F₂)
      (one₂_a : C_ab) (one₁_a : D_ab)
      (e_hom : one₁_a ⟶ F₂.obj one₂_a) (e_inv : F₂.obj one₂_a ⟶ one₁_a)
      (η_a : one₁_a ⟶ F₁.obj one₂_a) (ε_a : F₁.obj one₂_a ⟶ one₁_a),
      ε_a = α.app one₂_a ≫ e_inv →
      η_a ≫ α.app one₂_a = e_hom →
      ∀ (d₀ : ℕ) (γ_a : CategoryTheory.Abelian.Ext.{u} one₂_a one₂_a d₀),
        (CategoryTheory.Abelian.Ext.mk₀ η_a).comp
          (((F₁.mapExtAddHom one₂_a one₂_a d₀) γ_a).comp
            (CategoryTheory.Abelian.Ext.mk₀ ε_a) (Nat.add_zero d₀)) (Nat.zero_add d₀) =
        (CategoryTheory.Abelian.Ext.mk₀ e_hom).comp
          (((F₂.mapExtAddHom one₂_a one₂_a d₀) γ_a).comp
            (CategoryTheory.Abelian.Ext.mk₀ e_inv) (Nat.add_zero d₀)) (Nat.zero_add d₀) := by
    intro C_ab D_ab _ _ _ _ _ _ _ F₁ F₂ _ _ _ _ _ _ α one₂_a one₁_a e_hom e_inv η_a ε_a hε hη d₀ γ_a
    have hNat : ∀ (d : ℕ) {Y : C_ab} (x : CategoryTheory.Abelian.Ext.{u} one₂_a Y d),
        (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ x).comp
          (CategoryTheory.Abelian.Ext.mk₀ (α.app Y)) (Nat.add_zero d) =
        (CategoryTheory.Abelian.Ext.mk₀ (α.app one₂_a)).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor F₂ x) (Nat.zero_add d) := by
      intro d
      induction d with
      | zero =>
        intro Y x
        rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, α.naturality]
      | succ k ih =>
        intro Y x
        let ι : Y ⟶ CategoryTheory.Injective.under Y := CategoryTheory.Injective.ι Y
        let Q : C_ab := CategoryTheory.Limits.cokernel ι
        let π : CategoryTheory.Injective.under Y ⟶ Q := CategoryTheory.Limits.cokernel.π ι
        let S_c : CategoryTheory.ShortComplex C_ab :=
          CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
        have hS : S_c.ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk (CategoryTheory.ShortComplex.exact_cokernel ι)
        have h0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ S_c.f) (Nat.add_zero (k + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨z, hz⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ one₂_a hS x h0 rfl
        rw [← hz]
        let hS₁ : (S_c.map F₁).ShortExact := hS.map_of_exact F₁
        let hS₂ : (S_c.map F₂).ShortExact := hS.map_of_exact F₂
        have h_ext_nat :
            hS₁.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (α.app Y)) (Nat.add_zero 1) =
            (CategoryTheory.Abelian.Ext.mk₀ (α.app Q)).comp hS₂.extClass (Nat.zero_add 1) :=
          CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS₁ hS₂ (S_c.mapNatTrans α)
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F₁ hS,
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ rfl, h_ext_nat,
          ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ rfl, ih z,
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add k) rfl
            (congrArg (· + 1) (Nat.zero_add k)),
          ← CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F₂ hS,
          ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp]
    rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
      hε, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero d₀),
      hNat d₀ γ_a,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.zero_add d₀),
      ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add 0) (Nat.zero_add d₀)
        (Nat.zero_add d₀),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hη]
  intro R ModCat one₁ one₂ P_push' adjMod₂ adjMod₁ ε' η' _ hηε' γ
  have := hAdd
  have := hLim
  have := hColim
  have := hAdd'
  have := hLim'
  have := hColim'
  obtain ⟨ν, hε, hη⟩ := hMate W₁.smallEtaleTopology W₂.smallEtaleTopology
    (weilAltCdSitePullback h) ModCat (ModuleCat.of R R)
    hCont P_pull adj e_unit
    (weilEtaleIdTerminalIsTerminal.{u} W₂) (weilEtaleIdTerminalIsTerminal.{u} W₁) hEv
    hCont' P_pull' adj' T₂' hT₂' T₁' hT₁' η' hηε'
  exact hSandwich P_pull' P_pull ν.hom one₂ one₁ e_unit.hom e_unit.inv η' ε' hε hη q γ

theorem weil_abelian_shifted_cosyzygy_biproduct_homology_iso (𝒞 : Type (u + 1)) [CategoryTheory.Category.{u + 1, u + 1} 𝒞] [CategoryTheory.Abelian 𝒞]
    (Z_K J_K : ℕ → 𝒞)
    (ι_K : ∀ p : ℕ, Z_K p ⟶ J_K p)
    (π_K : ∀ p : ℕ, J_K p ⟶ Z_K (p + 1))
    (hz_K : ∀ p : ℕ, CategoryTheory.CategoryStruct.comp (ι_K p) (π_K p) = 0)
    (hd_K : ∀ p : ℕ, CategoryTheory.CategoryStruct.comp
      (CategoryTheory.CategoryStruct.comp (π_K p) (ι_K (p + 1)))
      (CategoryTheory.CategoryStruct.comp (π_K (p + 1)) (ι_K (p + 2))) = 0)
    (hMono_ιK : ∀ p : ℕ, CategoryTheory.Mono (ι_K p))
    (hKer_K : ∀ p : ℕ, CategoryTheory.Limits.IsLimit
      (CategoryTheory.Limits.KernelFork.ofι (ι_K p) (hz_K p)))
    (B_K H_K : ℕ → 𝒞)
    (p_img : ∀ k : ℕ, J_K k ⟶ B_K k)
    (j_B : ∀ k : ℕ, B_K k ⟶ Z_K (k + 1))
    (q_H : ∀ k : ℕ, Z_K (k + 1) ⟶ H_K k)
    (hz_B : ∀ k : ℕ, CategoryTheory.CategoryStruct.comp (j_B k) (q_H k) = 0)
    (hEpi_p : ∀ k : ℕ, CategoryTheory.Epi (p_img k))
    (hFac_B : ∀ k : ℕ, CategoryTheory.CategoryStruct.comp (p_img k) (j_B k) = π_K k)
    (hEx_B : ∀ k : ℕ, (CategoryTheory.ShortComplex.mk (j_B k) (q_H k) (hz_B k)).ShortExact)
    (Y_E I_E : ℕ → ℕ → 𝒞)
    (ι_E : ∀ q s : ℕ, Y_E q s ⟶ I_E q s)
    (π_E : ∀ q s : ℕ, I_E q s ⟶ Y_E q (s + 1))
    (hz_E : ∀ q s : ℕ, CategoryTheory.CategoryStruct.comp (ι_E q s) (π_E q s) = 0)
    (hEx_E : ∀ q s : ℕ, (CategoryTheory.ShortComplex.mk (ι_E q s) (π_E q s) (hz_E q s)).ShortExact)
    (hat_ψ : ∀ q : ℕ, Y_E q 0 ⟶ Z_K q)
    (f_lad : ∀ q s : ℕ, I_E q s ⟶ J_K (q + s))
    (hf0 : ∀ q : ℕ, CategoryTheory.CategoryStruct.comp (ι_E q 0) (f_lad q 0) =
      CategoryTheory.CategoryStruct.comp (hat_ψ q) (ι_K q))
    (hfSucc : ∀ q s : ℕ,
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp (π_E q s) (ι_E q (s + 1))) (f_lad q (s + 1)) =
      CategoryTheory.CategoryStruct.comp (f_lad q s)
        (CategoryTheory.CategoryStruct.comp (π_K (q + s)) (ι_K (q + s + 1))))
    (i₁ i₂ M : ℕ)
    (hBasis0 : CategoryTheory.Mono (hat_ψ 0) ∧
      ∃ lift₀ : Z_K 0 ⟶ Y_E 0 0,
        CategoryTheory.CategoryStruct.comp lift₀ (hat_ψ 0) =
          M • CategoryTheory.CategoryStruct.id (Z_K 0))
    (hBasisSucc : ∀ k : ℕ, k + 1 ≤ i₁ + i₂ →
      let ψ_k : Y_E (k + 1) 0 ⟶ H_K k :=
        CategoryTheory.CategoryStruct.comp (hat_ψ (k + 1)) (q_H k)
      CategoryTheory.Mono ψ_k ∧
      ∃ lift_k : H_K k ⟶ Y_E (k + 1) 0,
        CategoryTheory.CategoryStruct.comp lift_k ψ_k =
          M • CategoryTheory.CategoryStruct.id (H_K k)) :
    let K : CochainComplex 𝒞 ℕ :=
      CochainComplex.of J_K (fun p => CategoryTheory.CategoryStruct.comp (π_K p) (ι_K (p + 1))) hd_K
    ∃ (E : CochainComplex 𝒞 ℕ) (Φ : E ⟶ K) (ι_summand : I_E i₂ i₁ ⟶ E.X (i₁ + i₂)),
      ((∀ q : ℕ, q ≤ i₁ + i₂ → ∀ s : ℕ, CategoryTheory.Injective (I_E q s)) →
        ∀ p : ℕ, CategoryTheory.Injective (E.X p)) ∧
      (∀ q : ℕ, q ≤ i₁ + i₂ →
        CategoryTheory.Mono (HomologicalComplex.homologyMap Φ q) ∧
        M • CategoryTheory.CategoryStruct.id
          (CategoryTheory.Limits.cokernel (HomologicalComplex.homologyMap Φ q)) = 0) ∧
      (∀ (one : 𝒞) (z₀ : one ⟶ I_E i₂ i₁),
        CategoryTheory.CategoryStruct.comp z₀
            (CategoryTheory.CategoryStruct.comp (π_E i₂ i₁) (ι_E i₂ (i₁ + 1))) = 0 →
        let z : one ⟶ E.X (i₁ + i₂) := CategoryTheory.CategoryStruct.comp z₀ ι_summand
        CategoryTheory.CategoryStruct.comp z (E.d (i₁ + i₂) (i₁ + i₂ + 1)) = 0 ∧
        CategoryTheory.CategoryStruct.comp z (Φ.f (i₁ + i₂)) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp z₀ (f_lad i₂ i₁))
            (eqToHom (congrArg J_K (Nat.add_comm i₂ i₁))) ∧
        (∀ N : ℕ,
          (((i₁ + i₂ = 0 ∧ N • z = 0) ∨
            ∃ (p : ℕ) (_ : p + 1 = i₁ + i₂) (a_E : one ⟶ E.X p),
              CategoryTheory.CategoryStruct.comp a_E (E.d p (i₁ + i₂)) = N • z) →
          ((i₁ = 0 ∧ N • z₀ = 0) ∨
            ∃ (p₁ : ℕ) (hp₁ : p₁ + 1 = i₁) (a₀ : one ⟶ I_E i₂ p₁),
              CategoryTheory.CategoryStruct.comp a₀
                (CategoryTheory.CategoryStruct.comp (π_E i₂ p₁)
                  (CategoryTheory.CategoryStruct.comp (ι_E i₂ (p₁ + 1))
                    (eqToHom (congrArg (I_E i₂) hp₁)))) = N • z₀)))) :=
by
  classical
  intro K
  
  
  
  have hKd : ∀ p : ℕ, K.d p (p + 1) = π_K p ≫ ι_K (p + 1) := by
    intro p
    dsimp [K]
    simp only [CochainComplex.of_d]
  have hz_Kd : ∀ p : ℕ, ι_K p ≫ K.d p (p + 1) = 0 := by
    intro p
    rw [hKd p, ← Category.assoc, hz_K p, Limits.zero_comp]
  have hCyc_πK : ∀ p : ℕ, K.iCycles p ≫ π_K p = 0 := by
    intro p
    have : Mono (ι_K (p + 1)) := hMono_ιK (p + 1)
    apply (cancel_mono (ι_K (p + 1))).mp
    rw [Category.assoc, ← hKd p, K.iCycles_d p (p + 1), Limits.zero_comp]
  let e_cyc : ∀ p : ℕ, Z_K p ≅ K.cycles p := fun p =>
    let hom_p : Z_K p ⟶ K.cycles p :=
      K.liftCycles (ι_K p) (p + 1) ((ComplexShape.up ℕ).next_eq' rfl) (hz_Kd p)
    let inv_pair := Limits.KernelFork.IsLimit.lift' (hKer_K p) (K.iCycles p) (hCyc_πK p)
    { hom := hom_p
      inv := inv_pair.1
      hom_inv_id := by
        have : Mono (ι_K p) := hMono_ιK p
        apply (cancel_mono (ι_K p)).mp
        have hfac : inv_pair.1 ≫ ι_K p = K.iCycles p := inv_pair.2
        rw [Category.assoc, hfac, K.liftCycles_i, Category.id_comp]
      inv_hom_id := by
        apply (cancel_mono (K.iCycles p)).mp
        have hfac : inv_pair.1 ≫ ι_K p = K.iCycles p := inv_pair.2
        rw [Category.assoc, K.liftCycles_i, hfac, Category.id_comp] }
  have h_ecyc : ∀ p : ℕ, (e_cyc p).hom ≫ K.iCycles p = ι_K p :=
    fun p => K.liftCycles_i (ι_K p) (p + 1) ((ComplexShape.up ℕ).next_eq' rfl) (hz_Kd p)
  let e_K0 : Z_K 0 ≅ K.homology 0 := e_cyc 0 ≪≫ K.isoHomologyπ₀
  have h_eK0 : e_K0.hom = (e_cyc 0).hom ≫ K.homologyπ 0 := by
    dsimp [e_K0]
    rw [HomologicalComplex.isoHomologyπ_hom]
  have hToCyc_K : ∀ k : ℕ, K.toCycles k (k + 1) = p_img k ≫ j_B k ≫ (e_cyc (k + 1)).hom := by
    intro k
    apply (cancel_mono (K.iCycles (k + 1))).mp
    rw [K.toCycles_i k (k + 1), hKd k, Category.assoc, Category.assoc, h_ecyc (k + 1),
      ← Category.assoc, hFac_B k]
  have hjB_homπ : ∀ k : ℕ, j_B k ≫ ((e_cyc (k + 1)).hom ≫ K.homologyπ (k + 1)) = 0 := by
    intro k
    have : Epi (p_img k) := hEpi_p k
    apply (cancel_epi (p_img k)).mp
    have h1 := K.toCycles_comp_homologyπ k (k + 1)
    rw [hToCyc_K k, Category.assoc, Category.assoc] at h1
    rw [Limits.comp_zero]
    exact h1
  have hToCyc_qH : ∀ k : ℕ, K.toCycles k (k + 1) ≫ ((e_cyc (k + 1)).inv ≫ q_H k) = 0 := by
    intro k
    rw [hToCyc_K k, Category.assoc, Category.assoc, ← Category.assoc ((e_cyc (k + 1)).hom),
      (e_cyc (k + 1)).hom_inv_id, Category.id_comp, hz_B k, Limits.comp_zero]
  let e_KSucc : ∀ k : ℕ, H_K k ≅ K.homology (k + 1) := fun k =>
    let hCok_B := (hEx_B k).gIsCokernel
    let hCok_K := K.homologyIsCokernel k (k + 1) (CochainComplex.prev_nat_succ k)
    let hom_pair := Limits.CokernelCofork.IsColimit.desc' hCok_B
      ((e_cyc (k + 1)).hom ≫ K.homologyπ (k + 1)) (hjB_homπ k)
    let inv_pair := Limits.CokernelCofork.IsColimit.desc' hCok_K
      ((e_cyc (k + 1)).inv ≫ q_H k) (hToCyc_qH k)
    { hom := hom_pair.1
      inv := inv_pair.1
      hom_inv_id := by
        have : Epi (q_H k) := (hEx_B k).epi_g
        apply (cancel_epi (q_H k)).mp
        have h1 : q_H k ≫ hom_pair.1 = (e_cyc (k + 1)).hom ≫ K.homologyπ (k + 1) := hom_pair.2
        have h2 : K.homologyπ (k + 1) ≫ inv_pair.1 = (e_cyc (k + 1)).inv ≫ q_H k := inv_pair.2
        rw [← Category.assoc, h1, Category.assoc, h2, ← Category.assoc,
          (e_cyc (k + 1)).hom_inv_id, Category.id_comp, Category.comp_id]
      inv_hom_id := by
