      have hν_nil : IsNilpotent ν :=
        Module.End.isNilpotent_restrict_maxGenEigenspace_sub_algebraMap T μ hMaps_sub
      have hTμ_eq : T_μ = μ • 1 + ν := by
        apply LinearMap.ext
        intro x
        apply Subtype.ext
        simp only [T_μ, ν, LinearMap.add_apply, LinearMap.smul_apply, Module.End.one_apply,
