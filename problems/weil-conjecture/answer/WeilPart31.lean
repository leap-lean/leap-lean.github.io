theorem weil_etale_proper_kunneth_integral_injective (k : Type u) [Field k] [IsAlgClosed k]
    (Y₁ Y₂ Y_W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Y₁.hom] [AlgebraicGeometry.IsProper Y₂.hom]
    (pr₁ : Quiver.Hom Y_W.left Y₁.left) (pr₂ : Quiver.Hom Y_W.left Y₂.left)
    (hPb : CategoryTheory.IsPullback pr₁ pr₂ Y₁.hom Y₂.hom)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hFin₁ : ∀ q r : ℕ, Finite (weilEtaleTorsionH Y₁.left (ℓ ^ r) q))
    (hFin₂ : ∀ q r : ℕ, Finite (weilEtaleTorsionH Y₂.left (ℓ ^ r) q))
    (hFinW : ∀ q r : ℕ, Finite (weilEtaleTorsionH Y_W.left (ℓ ^ r) q))
    (i₁ i₂ : ℕ)
    (μ : ∀ r : ℕ, weilEtaleTorsionH Y₁.left (ℓ ^ r) i₁ →+
      weilEtaleTorsionH Y₂.left (ℓ ^ r) i₂ →+
      weilEtaleTorsionH Y_W.left (ℓ ^ r) (i₁ + i₂))
    (hCup : ∀ r : ℕ, WeilIsEtaleExternalCupProduct.{u}
      Y₁.left Y₂.left Y_W.left pr₁ pr₂ (ℓ ^ r) i₁ i₂ (μ r))
    (hTrans : ∀ (r : ℕ)
      (c₁ : weilEtaleTorsionH Y₁.left (ℓ ^ (r + 1)) i₁)
      (c₂ : weilEtaleTorsionH Y₂.left (ℓ ^ (r + 1)) i₂),
      weilEtaleTorsionTransition Y_W.left ℓ r (i₁ + i₂) (μ (r + 1) c₁ c₂) =
        μ r (weilEtaleTorsionTransition Y₁.left ℓ r i₁ c₁)
          (weilEtaleTorsionTransition Y₂.left ℓ r i₂ c₂))
    (m : ℕ)
    (u : Fin m → ↥(weilEtaleIntegralSystem Y₁.left ℓ i₁))
    (w : Fin m → ↥(weilEtaleIntegralSystem Y₂.left ℓ i₂))
    (hu : ∀ z : Fin m → PadicInt ℓ,
      (∀ r : ℕ, ∑ a : Fin m, (PadicInt.toZModPow r (z a)).val • (u a).1 r = 0) → z = 0)
    (hw : ∃ a : Fin m, ∀ k_pow : ℕ, ∃ r : ℕ, (ℓ ^ k_pow) • (w a).1 r ≠ 0) :
    ∀ k_pow : ℕ, ∃ r : ℕ,
      (ℓ ^ k_pow) • (∑ a : Fin m, μ r ((u a).1 r) ((w a).1 r)) ≠ 0 :=
by
  have hTorsH : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m₀ deg : ℕ)
      (c : weilEtaleTorsionH S m₀ deg), m₀ • c = 0 := by
    intro S m₀ deg c
    let J := S.smallEtaleTopology
    let C_shf := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let Fℤ := C_shf.obj (AddCommGrpCat.of (ULift.{u} ℤ))
    let U_lift := AddCommGrpCat.uliftFunctor.{u, 0}
    let Z_m := AddCommGrpCat.of (ZMod m₀)
    have : C_shf.Additive := by dsimp [C_shf]; infer_instance
    have hExt_nsmul : ∀ {Y : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (x : CategoryTheory.Abelian.Ext Fℤ Y deg) (n : ℕ),
        x.comp (CategoryTheory.Abelian.Ext.mk₀ (n • 𝟙 Y)) (Nat.add_zero deg) = n • x := by
      intro Y x n
      induction n with
      | zero =>
        rw [zero_smul, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero, zero_smul]
      | succ n ih =>
        rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add, CategoryTheory.Abelian.Ext.comp_add,
          ih, CategoryTheory.Abelian.Ext.comp_mk₀_id, succ_nsmul]
    have hZ_zero : m₀ • (𝟙 Z_m) = 0 := by
      ext a
      change m₀ • a = 0
      rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
    have hFM_zero : m₀ • (𝟙 (weilEtaleTorsionSheaf S m₀)) = 0 := by
      change m₀ • (𝟙 (C_shf.obj (U_lift.obj Z_m))) = 0
      rw [← C_shf.map_id, ← U_lift.map_id, ← Functor.map_nsmul, ← Functor.map_nsmul,
        hZ_zero, Functor.map_zero, Functor.map_zero]
    change m₀ • (c : CategoryTheory.Abelian.Ext Fℤ (weilEtaleTorsionSheaf S m₀) deg) = 0
    rw [← hExt_nsmul c m₀, hFM_zero, CategoryTheory.Abelian.Ext.mk₀_zero,
      CategoryTheory.Abelian.Ext.comp_zero]
  have hPrime : Nat.Prime ℓ := Fact.out
  have hPBC : WeilProperModPrimeBaseChangeHolds k ℓ :=
    weil_etale_proper_base_change_mod_prime k ℓ hℓ
  have hModComp := weil_etale_module_ext_comparison.{u}.1
  obtain ⟨e, b, v_sys, hSysInj, hSysCoker, hSysDecomp⟩ :=
    weil_etale_bockstein_dvr_free_basis_system Y₂.left ℓ (i₁ + i₂) hFin₂
  obtain ⟨hPullEx, hLoc⟩ :=
    weil_etale_proper_cartesian_torsion_local_constancy k Y₁ Y₂ Y_W pr₁ pr₂ hPb ℓ hℓ hPBC hFin₂
  let C_exp : ℕ := e * (2 * (i₁ + i₂))
  have hBndKer : ∀ (r : ℕ) (x : Fin (b i₂) → weilEtaleTorsionH Y₁.left (ℓ ^ r) i₁),
      ∑ t : Fin (b i₂), μ r (x t) ((v_sys i₂ t).1 r) = 0 →
      ∀ t : Fin (b i₂), (ℓ ^ C_exp) • x t = 0 := by
    intro r x hx
    have hm₀ : 1 ≤ ℓ ^ r := Nat.one_le_pow r ℓ hPrime.pos
    obtain ⟨E, K, Φ, hInjEK, hHomΦ, hBridge⟩ :=
      weil_etale_external_cup_cochain_bridge_of_local_constancy
        Y₁.left Y₂.left Y_W.left pr₁ pr₂ (ℓ ^ r) (ℓ ^ e) i₁ i₂ hm₀ hModComp
        (fun W₁ W₂ h q => hPullEx W₁ W₂ h (ℓ ^ r) q)
        (fun q _ => hLoc r q)
        b (fun q t => (v_sys q t).1 r)
        (fun q hq => hSysInj q r hq)
        (fun q hq => hSysCoker q r hq)
        (μ r) (hCup r)
    obtain ⟨z, hz_cocycle, hz_K, hz_E⟩ := hBridge x hx
    have hz_bnd :=
      weil_abelian_cochain_bounded_kernel_of_homology_mono_coker
        (CategoryTheory.Sheaf Y₁.left.smallEtaleTopology
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod (ℓ ^ r)))))
        (weilEtaleModuleUnit Y₁.left (ℓ ^ r))
        (i₁ + i₂) (ℓ ^ e) E K Φ hInjEK hHomΦ z hz_cocycle hz_K
    have hx_kill := hz_E ((ℓ ^ e) ^ (2 * (i₁ + i₂))) hz_bnd
    intro t
    have hpow : (ℓ ^ e) ^ (2 * (i₁ + i₂)) = ℓ ^ C_exp := (pow_mul ℓ e (2 * (i₁ + i₂))).symm
    rw [← hpow]
    exact hx_kill t
  obtain ⟨a₀, ha₀⟩ := hw
  choose W hW using fun a : Fin m => hSysDecomp i₂ (Nat.le_add_left i₂ i₁) (w a)
  have hex_t₀ : ∃ t₀ : Fin (b i₂), W a₀ t₀ ≠ 0 := by
    by_contra hall_zero
    push_neg at hall_zero
    obtain ⟨r₀, hr₀⟩ := ha₀ e
    apply hr₀
    rw [hW a₀ r₀]
    refine Finset.sum_eq_zero fun t _ => ?_
    rw [hall_zero t, map_zero, ZMod.val_zero, zero_smul]
  obtain ⟨t₀, ht₀_ne⟩ := hex_t₀
  intro k_pow
  by_contra hall0
  push_neg at hall0
  have hBilin_smul_left : ∀ (r n : ℕ)
      (x₁ : weilEtaleTorsionH Y₁.left (ℓ ^ r) i₁)
      (x₂ : weilEtaleTorsionH Y₂.left (ℓ ^ r) i₂),
      n • (μ r x₁ x₂) = μ r (n • x₁) x₂ := by
    intro r n x₁ x₂
    rw [map_nsmul, AddMonoidHom.nsmul_apply]
  have hBilin_smul_right : ∀ (r n : ℕ)
      (x₁ : weilEtaleTorsionH Y₁.left (ℓ ^ r) i₁)
      (x₂ : weilEtaleTorsionH Y₂.left (ℓ ^ r) i₂),
      n • (μ r x₁ x₂) = μ r x₁ (n • x₂) := by
    intro r n x₁ x₂
    exact (map_nsmul (μ r x₁) n x₂).symm
  have hKill_t₀ : ∀ r : ℕ,
      (ℓ ^ C_exp) • (∑ a : Fin m,
        (PadicInt.toZModPow r (W a t₀)).val • ((ℓ ^ k_pow) • (u a).1 r)) = 0 := by
    intro r
    refine hBndKer r
      (fun t => ∑ a : Fin m, (PadicInt.toZModPow r (W a t)).val • ((ℓ ^ k_pow) • (u a).1 r))
      ?_ t₀
    have h0 : (ℓ ^ e) • ((ℓ ^ k_pow) • (∑ a : Fin m, μ r ((u a).1 r) ((w a).1 r))) = 0 := by
      rw [hall0 r, smul_zero]
    rw [Finset.smul_sum, Finset.smul_sum] at h0
    have h1 : ∑ a : Fin m, (ℓ ^ e) • ((ℓ ^ k_pow) • (μ r ((u a).1 r) ((w a).1 r))) =
        ∑ t : Fin (b i₂),
          μ r (∑ a : Fin m, (PadicInt.toZModPow r (W a t)).val • ((ℓ ^ k_pow) • (u a).1 r))
            ((v_sys i₂ t).1 r) := by
      calc
        ∑ a : Fin m, (ℓ ^ e) • ((ℓ ^ k_pow) • (μ r ((u a).1 r) ((w a).1 r)))
          = ∑ a : Fin m,
              ∑ t : Fin (b i₂),
                μ r ((PadicInt.toZModPow r (W a t)).val • ((ℓ ^ k_pow) • (u a).1 r))
                  ((v_sys i₂ t).1 r) := by
              refine Finset.sum_congr rfl fun a _ => ?_
              rw [hBilin_smul_left r (ℓ ^ k_pow), hBilin_smul_right r (ℓ ^ e),
                hW a r, map_sum]
              refine Finset.sum_congr rfl fun t _ => ?_
              rw [← hBilin_smul_right, hBilin_smul_left]
        _ = ∑ t : Fin (b i₂),
              ∑ a : Fin m,
                μ r ((PadicInt.toZModPow r (W a t)).val • ((ℓ ^ k_pow) • (u a).1 r))
                  ((v_sys i₂ t).1 r) := Finset.sum_comm
        _ = ∑ t : Fin (b i₂),
              μ r (∑ a : Fin m, (PadicInt.toZModPow r (W a t)).val • ((ℓ ^ k_pow) • (u a).1 r))
                ((v_sys i₂ t).1 r) := by
              refine Finset.sum_congr rfl fun t _ => ?_
              rw [map_sum, AddMonoidHom.finsetSum_apply]
    rwa [← h1]
  let z : Fin m → PadicInt ℓ := fun a => ((ℓ : PadicInt ℓ) ^ (C_exp + k_pow)) * W a t₀
  have hz_sum : ∀ r : ℕ, ∑ a : Fin m, (PadicInt.toZModPow r (z a)).val • (u a).1 r = 0 := by
    intro r
    have : NeZero (ℓ ^ r) := ⟨pow_ne_zero r hPrime.ne_zero⟩
    have hterm : ∀ a : Fin m,
        (PadicInt.toZModPow r (z a)).val • (u a).1 r =
          (ℓ ^ C_exp) • ((PadicInt.toZModPow r (W a t₀)).val • ((ℓ ^ k_pow) • (u a).1 r)) := by
      intro a
      let w_val : ℕ := (PadicInt.toZModPow r (W a t₀)).val
      have hw_cast : (w_val : ZMod (ℓ ^ r)) = PadicInt.toZModPow r (W a t₀) :=
        ZMod.natCast_zmod_val _
      have hz_zmod : PadicInt.toZModPow r (z a) =
          ((ℓ ^ (C_exp + k_pow) * w_val : ℕ) : ZMod (ℓ ^ r)) := by
        dsimp [z]
        rw [map_mul, map_pow, map_natCast, ← hw_cast, Nat.cast_mul, Nat.cast_pow]
      have hz_val : (PadicInt.toZModPow r (z a)).val =
          (ℓ ^ (C_exp + k_pow) * w_val) % (ℓ ^ r) := by
        rw [hz_zmod, ZMod.val_natCast]
      have hdiv := (Nat.div_add_mod (ℓ ^ (C_exp + k_pow) * w_val) (ℓ ^ r)).symm
      have hsmul_eq : ((ℓ ^ (C_exp + k_pow) * w_val) % (ℓ ^ r)) • (u a).1 r =
          (ℓ ^ (C_exp + k_pow) * w_val) • (u a).1 r := by
        conv_rhs => rw [hdiv]
        rw [add_nsmul, mul_comm (ℓ ^ r), mul_nsmul', hTorsH Y₁.left (ℓ ^ r) i₁ ((u a).1 r),
          smul_zero, zero_add]
      have hmul_eq : ℓ ^ (C_exp + k_pow) * w_val = ℓ ^ C_exp * (w_val * ℓ ^ k_pow) := by
        rw [pow_add]
        ring
      rw [hz_val, hsmul_eq, hmul_eq, mul_nsmul', mul_nsmul']
    calc
      ∑ a : Fin m, (PadicInt.toZModPow r (z a)).val • (u a).1 r
        = ∑ a : Fin m,
            (ℓ ^ C_exp) • ((PadicInt.toZModPow r (W a t₀)).val • ((ℓ ^ k_pow) • (u a).1 r)) :=
          Finset.sum_congr rfl fun a _ => hterm a
      _ = (ℓ ^ C_exp) • ∑ a : Fin m,
            (PadicInt.toZModPow r (W a t₀)).val • ((ℓ ^ k_pow) • (u a).1 r) :=
          (Finset.smul_sum).symm
      _ = 0 := hKill_t₀ r
  have hz_zero : z = 0 := hu z hz_sum
  have ha₀_zero : ((ℓ : PadicInt ℓ) ^ (C_exp + k_pow)) * W a₀ t₀ = 0 :=
    congrFun hz_zero a₀
  have hℓ_padic_ne : (ℓ : PadicInt ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hPrime.ne_zero
  have hpow_ne : ((ℓ : PadicInt ℓ) ^ (C_exp + k_pow)) ≠ 0 :=
    pow_ne_zero (C_exp + k_pow) hℓ_padic_ne
  exact ht₀_ne ((mul_eq_zero.mp ha₀_zero).resolve_left hpow_ne)

theorem weil_projective_product_kunneth_eigenvalue (K : Type u) [Finite K] [Field K]
    (X₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.GeometricallyIrreducible X₁.hom]
    [AlgebraicGeometry.IsProper X₁.hom]
    (d₁ : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d₁ X₁.hom]
    (hProj₁ : ∃ (N₁ : ℕ) (ι₁ : X₁ ⟶ weilProjectiveSpaceOver K N₁),
      AlgebraicGeometry.IsClosedImmersion ι₁.left)
    (X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.GeometricallyIrreducible X₂.hom]
    [AlgebraicGeometry.IsProper X₂.hom]
    (d₂ : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d₂ X₂.hom]
    (hProj₂ : ∃ (N₂ : ℕ) (ι₂ : X₂ ⟶ weilProjectiveSpaceOver K N₂),
      AlgebraicGeometry.IsClosedImmersion ι₂.left)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar K)
    (i₁ i₂ : ℕ)
    (M₁ : WeilEllAdicCohomologyModel K X₁ ℓ i₁)
    (M₂ : WeilEllAdicCohomologyModel K X₂ ℓ i₂)
    (γ₁ γ₂ : AlgebraicClosure (Padic ℓ))
    (hγ₁ : γ₁ ∈ ((M₁.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)))
    (hγ₂ : γ₂ ∈ ((M₂.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ))) :
    ∃ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      (_ : AlgebraicGeometry.GeometricallyIrreducible W.hom)
      (_ : AlgebraicGeometry.IsProper W.hom)
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension (d₁ + d₂) W.hom)
      (_ : ∃ (N : ℕ) (ι : W ⟶ weilProjectiveSpaceOver K N),
        AlgebraicGeometry.IsClosedImmersion ι.left)
      (M_W : WeilEllAdicCohomologyModel K W ℓ (i₁ + i₂)),
      γ₁ * γ₂ ∈ ((M_W.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)) :=
by
  classical
  
  have hTorsH : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m deg : ℕ)
      (w : weilEtaleTorsionH S m deg), m • w = 0 := by
    intro S m deg w
    let J := S.smallEtaleTopology
    let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let Fℤ := C.obj (AddCommGrpCat.of (ULift.{u} ℤ))
    let U_lift := AddCommGrpCat.uliftFunctor.{u, 0}
    let Z_m := AddCommGrpCat.of (ZMod m)
    have : C.Additive := by dsimp [C]; infer_instance
    have hExt_nsmul : ∀ {Y : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (x : CategoryTheory.Abelian.Ext Fℤ Y deg) (n : ℕ),
        x.comp (CategoryTheory.Abelian.Ext.mk₀ (n • 𝟙 Y)) (Nat.add_zero deg) = n • x := by
      intro Y x n
      induction n with
      | zero =>
        rw [zero_smul, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero, zero_smul]
      | succ n ih =>
        rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add, CategoryTheory.Abelian.Ext.comp_add,
          ih, CategoryTheory.Abelian.Ext.comp_mk₀_id, succ_nsmul]
    have hZ_zero : m • (𝟙 Z_m) = 0 := by
      ext a
      change m • a = 0
      rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
    have hFM_zero : m • (𝟙 (weilEtaleTorsionSheaf S m)) = 0 := by
      change m • (𝟙 (C.obj (U_lift.obj Z_m))) = 0
      rw [← C.map_id, ← U_lift.map_id, ← Functor.map_nsmul, ← Functor.map_nsmul,
        hZ_zero, Functor.map_zero, Functor.map_zero]
    change m • (w : CategoryTheory.Abelian.Ext Fℤ (weilEtaleTorsionSheaf S m) deg) = 0
    rw [← hExt_nsmul w m, hFM_zero, CategoryTheory.Abelian.Ext.mk₀_zero,
      CategoryTheory.Abelian.Ext.comp_zero]

  
  have hModelBridge : ∀ (H₁ H₂ H_W : ℕ → Type u)
      [∀ r, AddCommGroup (H₁ r)] [∀ r, AddCommGroup (H₂ r)] [∀ r, AddCommGroup (H_W r)]
      (τ₁ : ∀ r : ℕ, H₁ (r + 1) →+ H₁ r)
      (τ₂ : ∀ r : ℕ, H₂ (r + 1) →+ H₂ r)
      (τ_W : ∀ r : ℕ, H_W (r + 1) →+ H_W r)
      (L₁ : AddSubgroup (∀ r : ℕ, H₁ r))
      (_ : ∀ f, f ∈ L₁ ↔ ∀ r : ℕ, τ₁ r (f (r + 1)) = f r)
      (L₂ : AddSubgroup (∀ r : ℕ, H₂ r))
      (_ : ∀ f, f ∈ L₂ ↔ ∀ r : ℕ, τ₂ r (f (r + 1)) = f r)
      (L_W : AddSubgroup (∀ r : ℕ, H_W r))
      (_ : ∀ f, f ∈ L_W ↔ ∀ r : ℕ, τ_W r (f (r + 1)) = f r)
      (_ : ∀ (r : ℕ) (c : H₁ r), (ℓ ^ r) • c = 0)
      (_ : ∀ (r : ℕ) (c : H₂ r), (ℓ ^ r) • c = 0)
      (_ : ∀ (r : ℕ) (c : H_W r), (ℓ ^ r) • c = 0)
      (frob₁ : ∀ r : ℕ, H₁ r →+ H₁ r)
      (_ : ∀ (r : ℕ) (c : H₁ (r + 1)), τ₁ r (frob₁ (r + 1) c) = frob₁ r (τ₁ r c))
      (frob₂ : ∀ r : ℕ, H₂ r →+ H₂ r)
      (_ : ∀ (r : ℕ) (c : H₂ (r + 1)), τ₂ r (frob₂ (r + 1) c) = frob₂ r (τ₂ r c))
      (frob_W : ∀ r : ℕ, H_W r →+ H_W r)
      (μ : ∀ r : ℕ, H₁ r →+ H₂ r →+ H_W r)
      (_ : ∀ (r : ℕ) (c₁ : H₁ (r + 1)) (c₂ : H₂ (r + 1)),
        τ_W r (μ (r + 1) c₁ c₂) = μ r (τ₁ r c₁) (τ₂ r c₂))
      (_ : ∀ (r : ℕ) (c₁ : H₁ r) (c₂ : H₂ r),
        frob_W r (μ r c₁ c₂) = μ r (frob₁ r c₁) (frob₂ r c₂))
      (_ : ∀ (m : ℕ) (u : Fin m → ↥L₁) (w : Fin m → ↥L₂),
        (∀ z : Fin m → PadicInt ℓ,
          (∀ r : ℕ, ∑ a : Fin m, (PadicInt.toZModPow r (z a)).val • (u a).1 r = 0) → z = 0) →
        (∃ a : Fin m, ∀ k_pow : ℕ, ∃ r : ℕ, (ℓ ^ k_pow) • (w a).1 r ≠ 0) →
        ∀ k_pow : ℕ, ∃ r : ℕ, (ℓ ^ k_pow) • (∑ a : Fin m, μ r ((u a).1 r) ((w a).1 r)) ≠ 0)
      (V₁ V₂ V_W : Type u)
      [AddCommGroup V₁] [Module (Padic ℓ) V₁] [Module.Finite (Padic ℓ) V₁]
      [AddCommGroup V₂] [Module (Padic ℓ) V₂] [Module.Finite (Padic ℓ) V₂]
      [AddCommGroup V_W] [Module (Padic ℓ) V_W] [Module.Finite (Padic ℓ) V_W]
      (Φ₁ : V₁ →ₗ[Padic ℓ] V₁) (Φ₂ : V₂ →ₗ[Padic ℓ] V₂) (Φ_W : V_W →ₗ[Padic ℓ] V_W)
      (e₁ : TensorProduct ℤ ℚ ↥L₁ ≃+ V₁)
      (e₂ : TensorProduct ℤ ℚ ↥L₂ ≃+ V₂)
      (e_W : TensorProduct ℤ ℚ ↥L_W ≃+ V_W)
      (_ : ∀ (z : PadicInt ℓ) (x y : ↥L₁),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
          e₁ (TensorProduct.tmul ℤ (1 : ℚ) y) = (z : Padic ℓ) • e₁ (TensorProduct.tmul ℤ (1 : ℚ) x))
      (_ : ∀ (z : PadicInt ℓ) (x y : ↥L₂),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
          e₂ (TensorProduct.tmul ℤ (1 : ℚ) y) = (z : Padic ℓ) • e₂ (TensorProduct.tmul ℤ (1 : ℚ) x))
      (_ : ∀ (z : PadicInt ℓ) (x y : ↥L_W),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
          e_W (TensorProduct.tmul ℤ (1 : ℚ) y) = (z : Padic ℓ) • e_W (TensorProduct.tmul ℤ (1 : ℚ) x))
      (_ : ∀ (x y : ↥L₁),
        (∀ r : ℕ, y.1 r = frob₁ r (x.1 r)) →
          Φ₁ (e₁ (TensorProduct.tmul ℤ (1 : ℚ) x)) = e₁ (TensorProduct.tmul ℤ (1 : ℚ) y))
      (_ : ∀ (x y : ↥L₂),
        (∀ r : ℕ, y.1 r = frob₂ r (x.1 r)) →
          Φ₂ (e₂ (TensorProduct.tmul ℤ (1 : ℚ) x)) = e₂ (TensorProduct.tmul ℤ (1 : ℚ) y))
      (_ : ∀ (x y : ↥L_W),
        (∀ r : ℕ, y.1 r = frob_W r (x.1 r)) →
          Φ_W (e_W (TensorProduct.tmul ℤ (1 : ℚ) x)) = e_W (TensorProduct.tmul ℤ (1 : ℚ) y)),
      ∃ κ : TensorProduct (Padic ℓ) V₁ V₂ →ₗ[Padic ℓ] V_W,
        Function.Injective κ ∧
        ∀ (v₁ : V₁) (v₂ : V₂),
          κ (TensorProduct.tmul (Padic ℓ) (Φ₁ v₁) (Φ₂ v₂)) =
            Φ_W (κ (TensorProduct.tmul (Padic ℓ) v₁ v₂)) := by
    intro H₁ H₂ H_W _ _ _ τ₁ τ₂ τ_W L₁ hmem₁ L₂ hmem₂ L_W hmem_W
      hTors₁ hTors₂ hTors_W frob₁ hfrobTrans₁ frob₂ hfrobTrans₂ frob_W
      μ hTrans hFrob hNonTors V₁ V₂ V_W _ _ _ _ _ _ _ _ _
      Φ₁ Φ₂ Φ_W e₁ e₂ e_W hsmul₁ hsmul₂ hsmul_W hfrob₁ hfrob₂ hfrob_W
    have hℓ_prime : Nat.Prime ℓ := Fact.out
    have hℓ_pos : 0 < ℓ := hℓ_prime.pos
    have hℓ_ne : ℓ ≠ 0 := hℓ_prime.ne_zero
    have hSmulMem : ∀ {H : ℕ → Type u} [∀ r, AddCommGroup (H r)]
        (τ : ∀ r : ℕ, H (r + 1) →+ H r)
        (hTors : ∀ (r : ℕ) (c : H r), (ℓ ^ r) • c = 0)
        (z : PadicInt ℓ) (x : ∀ r : ℕ, H r),
        (∀ r : ℕ, τ r (x (r + 1)) = x r) →
        ∀ r : ℕ, τ r ((PadicInt.toZModPow (r + 1) z).val • x (r + 1)) =
          (PadicInt.toZModPow r z).val • x r := by
      intro H _ τ hTors z x hx r
      have : NeZero (ℓ ^ r) := ⟨pow_ne_zero r hℓ_ne⟩
      have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hℓ_ne⟩
      let a₁ := (PadicInt.toZModPow (r + 1) z).val
      let a₀ := (PadicInt.toZModPow r z).val
      have hcast : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))
          (PadicInt.toZModPow (r + 1) z) = PadicInt.toZModPow r z :=
        RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow r (r + 1) (Nat.le_succ r)) z
      have hmod_zmod : (a₁ : ZMod (ℓ ^ r)) = PadicInt.toZModPow r z := by
        rw [← hcast]
        have h1 : (a₁ : ZMod (ℓ ^ (r + 1))) = PadicInt.toZModPow (r + 1) z :=
          ZMod.natCast_zmod_val _
        rw [← h1, map_natCast]
      have hmod : a₁ % (ℓ ^ r) = a₀ := by
        have hv := congrArg ZMod.val hmod_zmod
        rwa [ZMod.val_natCast] at hv
      have hdiv := (Nat.div_add_mod a₁ (ℓ ^ r)).symm
      rw [hmod] at hdiv
      change τ r (a₁ • x (r + 1)) = a₀ • x r
      rw [map_nsmul, hx r, hdiv, add_nsmul, mul_comm (ℓ ^ r), mul_nsmul', hTors r (x r),
        smul_zero, zero_add]
    let smulL₁ (z : PadicInt ℓ) (x : ↥L₁) : ↥L₁ :=
      ⟨fun r => (PadicInt.toZModPow r z).val • x.1 r,
        (hmem₁ _).mpr (hSmulMem τ₁ hTors₁ z x.1 ((hmem₁ x.1).mp x.2))⟩
    let smulL₂ (z : PadicInt ℓ) (y : ↥L₂) : ↥L₂ :=
      ⟨fun r => (PadicInt.toZModPow r z).val • y.1 r,
        (hmem₂ _).mpr (hSmulMem τ₂ hTors₂ z y.1 ((hmem₂ y.1).mp y.2))⟩
    let frobL₁ (x : ↥L₁) : ↥L₁ :=
      ⟨fun r => frob₁ r (x.1 r),
        (hmem₁ _).mpr fun r => by rw [hfrobTrans₁ r (x.1 (r + 1)), (hmem₁ x.1).mp x.2 r]⟩
    let frobL₂ (y : ↥L₂) : ↥L₂ :=
      ⟨fun r => frob₂ r (y.1 r),
        (hmem₂ _).mpr fun r => by rw [hfrobTrans₂ r (y.1 (r + 1)), (hmem₂ y.1).mp y.2 r]⟩
    let μL (x : ↥L₁) (y : ↥L₂) : ↥L_W :=
      ⟨fun r => μ r (x.1 r) (y.1 r),
        (hmem_W _).mpr fun r => by
          rw [hTrans r (x.1 (r + 1)) (y.1 (r + 1)),
            (hmem₁ x.1).mp x.2 r, (hmem₂ y.1).mp y.2 r]⟩
    have hμL_add_left : ∀ (x₁ x₂ : ↥L₁) (y : ↥L₂), μL (x₁ + x₂) y = μL x₁ y + μL x₂ y := by
      intro x₁ x₂ y
      ext r
      change μ r (x₁.1 r + x₂.1 r) (y.1 r) = μ r (x₁.1 r) (y.1 r) + μ r (x₂.1 r) (y.1 r)
      rw [map_add, AddMonoidHom.add_apply]
    have hμL_add_right : ∀ (x : ↥L₁) (y₁ y₂ : ↥L₂), μL x (y₁ + y₂) = μL x y₁ + μL x y₂ := by
      intro x y₁ y₂
      ext r
      exact map_add (μ r (x.1 r)) (y₁.1 r) (y₂.1 r)
    let β_add : ↥L₁ →+ ↥L₂ →+ V_W :=
      AddMonoidHom.mk'
        (fun x => AddMonoidHom.mk'
          (fun y => e_W ((1 : ℚ) ⊗ₜ[ℤ] μL x y))
          (fun y₁ y₂ => by rw [hμL_add_right, TensorProduct.tmul_add, map_add]))
        (fun x₁ x₂ => by
          ext y
          simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply]
          rw [hμL_add_left, TensorProduct.tmul_add, map_add])
    have hβ_smul_left : ∀ (z : PadicInt ℓ) (x : ↥L₁) (y : ↥L₂),
        β_add (smulL₁ z x) y = (z : Padic ℓ) • β_add x y := by
      intro z x y
      change e_W ((1 : ℚ) ⊗ₜ[ℤ] μL (smulL₁ z x) y) =
        (z : Padic ℓ) • e_W ((1 : ℚ) ⊗ₜ[ℤ] μL x y)
      refine hsmul_W z (μL x y) (μL (smulL₁ z x) y) fun r => ?_
      change μ r ((PadicInt.toZModPow r z).val • x.1 r) (y.1 r) =
        (PadicInt.toZModPow r z).val • μ r (x.1 r) (y.1 r)
      rw [map_nsmul, AddMonoidHom.nsmul_apply]
    have hβ_smul_right : ∀ (z : PadicInt ℓ) (x : ↥L₁) (y : ↥L₂),
        β_add x (smulL₂ z y) = (z : Padic ℓ) • β_add x y := by
      intro z x y
      change e_W ((1 : ℚ) ⊗ₜ[ℤ] μL x (smulL₂ z y)) =
        (z : Padic ℓ) • e_W ((1 : ℚ) ⊗ₜ[ℤ] μL x y)
      refine hsmul_W z (μL x y) (μL x (smulL₂ z y)) fun r => ?_
      exact map_nsmul (μ r (x.1 r)) (PadicInt.toZModPow r z).val (y.1 r)
    let β_right_bilin (q₁ : ℚ) (x : ↥L₁) : ℚ →ₗ[ℤ] ↥L₂ →ₗ[ℤ] V_W :=
      LinearMap.mk₂ ℤ (fun q₂ y => ((q₁ : Padic ℓ) * (q₂ : Padic ℓ)) • β_add x y)
        (fun r₁ r₂ y => by push_cast; rw [mul_add, add_smul])
        (fun c r y => by
          rw [zsmul_eq_mul]; push_cast
          rw [← mul_assoc, mul_comm (q₁ : Padic ℓ) (c : Padic ℓ), mul_assoc,
            mul_smul, Int.cast_smul_eq_zsmul])
        (fun r y₁ y₂ => by rw [map_add, smul_add])
        (fun c r y => by rw [map_zsmul, smul_comm])
    let β_left_bilin : ℚ →ₗ[ℤ] ↥L₁ →ₗ[ℤ] TensorProduct ℤ ℚ ↥L₂ →ₗ[ℤ] V_W :=
      LinearMap.mk₂ ℤ (fun q₁ x => TensorProduct.lift (β_right_bilin q₁ x))
        (fun q₁ q₂ x => TensorProduct.ext' fun r y => by
          change (((q₁ + q₂ : ℚ) : Padic ℓ) * (r : Padic ℓ)) • β_add x y =
            ((q₁ : Padic ℓ) * (r : Padic ℓ)) • β_add x y +
              ((q₂ : Padic ℓ) * (r : Padic ℓ)) • β_add x y
          push_cast; rw [add_mul, add_smul])
        (fun c q₁ x => TensorProduct.ext' fun r y => by
          change (((c • q₁ : ℚ) : Padic ℓ) * (r : Padic ℓ)) • β_add x y =
            c • (((q₁ : Padic ℓ) * (r : Padic ℓ)) • β_add x y)
          rw [zsmul_eq_mul]; push_cast
          rw [mul_assoc, mul_smul, Int.cast_smul_eq_zsmul])
        (fun q₁ x₁ x₂ => TensorProduct.ext' fun r y => by
          change ((q₁ : Padic ℓ) * (r : Padic ℓ)) • β_add (x₁ + x₂) y =
            ((q₁ : Padic ℓ) * (r : Padic ℓ)) • β_add x₁ y +
              ((q₁ : Padic ℓ) * (r : Padic ℓ)) • β_add x₂ y
          rw [map_add, AddMonoidHom.add_apply, smul_add])
        (fun c q₁ x => TensorProduct.ext' fun r y => by
          change ((q₁ : Padic ℓ) * (r : Padic ℓ)) • β_add (c • x) y =
            c • (((q₁ : Padic ℓ) * (r : Padic ℓ)) • β_add x y)
          rw [map_zsmul, AddMonoidHom.zsmul_apply, smul_comm])
    let β_Q : TensorProduct ℤ ℚ ↥L₁ →ₗ[ℤ] TensorProduct ℤ ℚ ↥L₂ →ₗ[ℤ] V_W :=
      TensorProduct.lift β_left_bilin
    have hβ_Q_tmul : ∀ (q₁ q₂ : ℚ) (x : ↥L₁) (y : ↥L₂),
        β_Q (q₁ ⊗ₜ[ℤ] x) (q₂ ⊗ₜ[ℤ] y) = ((q₁ : Padic ℓ) * (q₂ : Padic ℓ)) • β_add x y :=
      fun _ _ _ _ => rfl
    have hEquivRat : ∀ {L V : Type u} [AddCommGroup L] [AddCommGroup V] [Module (Padic ℓ) V]
        (e : TensorProduct ℤ ℚ L ≃+ V) (q : ℚ) (t : TensorProduct ℤ ℚ L),
        e (q • t) = (q : Padic ℓ) • e t := by
      intro L V _ _ _ e q t
      have hd_ne : q.den ≠ 0 := q.den_nz
      have hd_padic : ((q.den : ℕ) : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hd_ne
      have hrat_eq : (q.den : ℚ) * q = (q.num : ℚ) := by rw [mul_comm, Rat.mul_den_eq_num]
      have ht_eq : q.den • (q • t) = q.num • t := by
        rw [← Nat.cast_smul_eq_nsmul ℚ, ← mul_smul, hrat_eq, Int.cast_smul_eq_zsmul ℚ]
      have he_eq : q.den • e (q • t) = q.num • e t := by
        rw [← map_nsmul, ht_eq, map_zsmul]
      rw [← Nat.cast_smul_eq_nsmul (Padic ℓ), ← Int.cast_smul_eq_zsmul (Padic ℓ)] at he_eq
      have hpadic_eq : ((q.num : ℤ) : Padic ℓ) = ((q.den : ℕ) : Padic ℓ) * (q : Padic ℓ) := by
        have hq := congrArg (fun r : ℚ => (r : Padic ℓ)) hrat_eq.symm
        push_cast at hq
        exact hq
      rw [hpadic_eq, mul_smul] at he_eq
      exact smul_right_injective V hd_padic he_eq
    have hEquivSymmRat : ∀ {L V : Type u} [AddCommGroup L] [AddCommGroup V] [Module (Padic ℓ) V]
        (e : TensorProduct ℤ ℚ L ≃+ V) (q : ℚ) (v : V),
        e.symm ((q : Padic ℓ) • v) = q • e.symm v := by
      intro L V _ _ _ e q v
      apply e.injective
      rw [e.apply_symm_apply, hEquivRat e q (e.symm v), e.apply_symm_apply]
    have hβ_Q_rat_left : ∀ (q : ℚ) (t : TensorProduct ℤ ℚ ↥L₁) (s : TensorProduct ℤ ℚ ↥L₂),
        β_Q (q • t) s = (q : Padic ℓ) • β_Q t s := by
      intro q t s
      refine TensorProduct.inductionOn (motive := fun t => β_Q (q • t) s = (q : Padic ℓ) • β_Q t s) t
        (fun q₁ x => ?_)
        (fun t₁ t₂ ih₁ ih₂ => by
          rw [smul_add, map_add, map_add, LinearMap.add_apply, LinearMap.add_apply,
            ih₁, ih₂, smul_add])
      rw [TensorProduct.smul_tmul', smul_eq_mul]
      exact TensorProduct.inductionOn
        (motive := fun s => β_Q ((q * q₁) ⊗ₜ[ℤ] x) s = (q : Padic ℓ) • β_Q (q₁ ⊗ₜ[ℤ] x) s) s
        (fun q₂ y => by rw [hβ_Q_tmul, hβ_Q_tmul]; push_cast; rw [mul_assoc, mul_smul])
        (fun s₁ s₂ ih₁ ih₂ => by rw [map_add, map_add, ih₁, ih₂, smul_add])
    have hβ_Q_rat_right : ∀ (q : ℚ) (t : TensorProduct ℤ ℚ ↥L₁) (s : TensorProduct ℤ ℚ ↥L₂),
        β_Q t (q • s) = (q : Padic ℓ) • β_Q t s := by
      intro q t s
      refine TensorProduct.inductionOn (motive := fun t => β_Q t (q • s) = (q : Padic ℓ) • β_Q t s) t
        (fun q₁ x => ?_)
        (fun t₁ t₂ ih₁ ih₂ => by
          rw [map_add, LinearMap.add_apply, LinearMap.add_apply, ih₁, ih₂, smul_add])
      exact TensorProduct.inductionOn
        (motive := fun s => β_Q (q₁ ⊗ₜ[ℤ] x) (q • s) = (q : Padic ℓ) • β_Q (q₁ ⊗ₜ[ℤ] x) s) s
        (fun q₂ y => by
          rw [TensorProduct.smul_tmul', smul_eq_mul, hβ_Q_tmul, hβ_Q_tmul]
          push_cast
          rw [← mul_smul, mul_left_comm])
        (fun s₁ s₂ ih₁ ih₂ => by rw [smul_add, map_add, map_add, ih₁, ih₂, smul_add])
    let B₀ : V₁ →+ V₂ →+ V_W :=
      AddMonoidHom.mk'
        (fun v => AddMonoidHom.mk' (fun w => β_Q (e₁.symm v) (e₂.symm w))
          (fun w₁ w₂ => by rw [map_add, map_add]))
        (fun v₁ v₂ => by
          ext w
          simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply, map_add, LinearMap.add_apply])
    have hB₀_apply : ∀ (v : V₁) (w : V₂), B₀ v w = β_Q (e₁.symm v) (e₂.symm w) :=
      fun _ _ => rfl
    have hB₀_tmul : ∀ (q₁ q₂ : ℚ) (x : ↥L₁) (y : ↥L₂),
        B₀ (e₁ (q₁ ⊗ₜ[ℤ] x)) (e₂ (q₂ ⊗ₜ[ℤ] y)) =
          ((q₁ : Padic ℓ) * (q₂ : Padic ℓ)) • β_add x y := by
      intro q₁ q₂ x y
      rw [hB₀_apply, e₁.symm_apply_apply, e₂.symm_apply_apply, hβ_Q_tmul]
    have hB₀_rat_left : ∀ (q : ℚ) (v : V₁) (w : V₂),
        B₀ ((q : Padic ℓ) • v) w = (q : Padic ℓ) • B₀ v w := by
      intro q v w
      rw [hB₀_apply, hB₀_apply, hEquivSymmRat e₁ q v, hβ_Q_rat_left]
    have hB₀_rat_right : ∀ (q : ℚ) (v : V₁) (w : V₂),
        B₀ v ((q : Padic ℓ) • w) = (q : Padic ℓ) • B₀ v w := by
      intro q v w
      rw [hB₀_apply, hB₀_apply, hEquivSymmRat e₂ q w, hβ_Q_rat_right]
    have hV₁_int_tmul : ∀ (z : PadicInt ℓ) (q₁ : ℚ) (x : ↥L₁),
        (z : Padic ℓ) • e₁ (q₁ ⊗ₜ[ℤ] x) = e₁ (q₁ ⊗ₜ[ℤ] smulL₁ z x) := by
      intro z q₁ x
      have h1 : ∀ w : ↥L₁, q₁ ⊗ₜ[ℤ] w = q₁ • ((1 : ℚ) ⊗ₜ[ℤ] w) := by
        intro w; rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [h1 x, h1 (smulL₁ z x), hEquivRat e₁, hEquivRat e₁,
        hsmul₁ z x (smulL₁ z x) (fun _ => rfl), smul_comm]
    have hV₂_int_tmul : ∀ (z : PadicInt ℓ) (q₂ : ℚ) (y : ↥L₂),
        (z : Padic ℓ) • e₂ (q₂ ⊗ₜ[ℤ] y) = e₂ (q₂ ⊗ₜ[ℤ] smulL₂ z y) := by
      intro z q₂ y
      have h1 : ∀ w : ↥L₂, q₂ ⊗ₜ[ℤ] w = q₂ • ((1 : ℚ) ⊗ₜ[ℤ] w) := by
        intro w; rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [h1 y, h1 (smulL₂ z y), hEquivRat e₂, hEquivRat e₂,
        hsmul₂ z y (smulL₂ z y) (fun _ => rfl), smul_comm]
    have hB₀_int_left : ∀ (z : PadicInt ℓ) (v : V₁) (w : V₂),
        B₀ ((z : Padic ℓ) • v) w = (z : Padic ℓ) • B₀ v w := by
      intro z v w
      rw [← e₁.apply_symm_apply v, ← e₂.apply_symm_apply w]
      generalize e₁.symm v = t
      generalize e₂.symm w = s
      refine TensorProduct.inductionOn
        (motive := fun t => B₀ ((z : Padic ℓ) • e₁ t) (e₂ s) = (z : Padic ℓ) • B₀ (e₁ t) (e₂ s)) t
        (fun q₁ x => ?_)
        (fun t₁ t₂ ih₁ ih₂ => by
          rw [map_add, smul_add, map_add, AddMonoidHom.add_apply, map_add, AddMonoidHom.add_apply,
            ih₁, ih₂, smul_add])
      rw [hV₁_int_tmul z q₁ x]
      exact TensorProduct.inductionOn
        (motive := fun s =>
          B₀ (e₁ (q₁ ⊗ₜ[ℤ] smulL₁ z x)) (e₂ s) = (z : Padic ℓ) • B₀ (e₁ (q₁ ⊗ₜ[ℤ] x)) (e₂ s)) s
        (fun q₂ y => by
          rw [hB₀_tmul q₁ q₂ (smulL₁ z x) y, hB₀_tmul q₁ q₂ x y, hβ_smul_left z x y, smul_comm])
        (fun s₁ s₂ ih₁ ih₂ => by rw [map_add, map_add, map_add, ih₁, ih₂, smul_add])
    have hB₀_int_right : ∀ (z : PadicInt ℓ) (v : V₁) (w : V₂),
        B₀ v ((z : Padic ℓ) • w) = (z : Padic ℓ) • B₀ v w := by
      intro z v w
      rw [← e₁.apply_symm_apply v, ← e₂.apply_symm_apply w]
      generalize e₁.symm v = t
      generalize e₂.symm w = s
      refine TensorProduct.inductionOn
        (motive := fun t => B₀ (e₁ t) ((z : Padic ℓ) • e₂ s) = (z : Padic ℓ) • B₀ (e₁ t) (e₂ s)) t
        (fun q₁ x => ?_)
        (fun t₁ t₂ ih₁ ih₂ => by
          rw [map_add, map_add, AddMonoidHom.add_apply, AddMonoidHom.add_apply,
            ih₁, ih₂, smul_add])
      exact TensorProduct.inductionOn
        (motive := fun s =>
          B₀ (e₁ (q₁ ⊗ₜ[ℤ] x)) ((z : Padic ℓ) • e₂ s) =
            (z : Padic ℓ) • B₀ (e₁ (q₁ ⊗ₜ[ℤ] x)) (e₂ s)) s
        (fun q₂ y => by
          rw [hV₂_int_tmul z q₂ y, hB₀_tmul q₁ q₂ x (smulL₂ z y),
            hB₀_tmul q₁ q₂ x y, hβ_smul_right z x y, smul_comm])
        (fun s₁ s₂ ih₁ ih₂ => by rw [map_add, smul_add, map_add, map_add, ih₁, ih₂, smul_add])
    have hex_padic_denom : ∀ c : Padic ℓ, ∃ (k : ℕ) (z₀ : PadicInt ℓ),
        c = ((((ℓ : ℚ) ^ k)⁻¹ : ℚ) : Padic ℓ) * (z₀ : Padic ℓ) := by
      intro c
      have h1lt : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hℓ_prime.one_lt
      obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ‖c‖ h1lt
      have hnorm : ‖(ℓ : Padic ℓ) ^ k * c‖ ≤ 1 := by
        rw [norm_mul, norm_pow, Padic.norm_p, inv_pow]
        have hpos : (0 : ℝ) < (ℓ : ℝ) ^ k := pow_pos (by exact_mod_cast hℓ_pos) k
        calc
          ((ℓ : ℝ) ^ k)⁻¹ * ‖c‖ ≤ ((ℓ : ℝ) ^ k)⁻¹ * (ℓ : ℝ) ^ k :=
            mul_le_mul_of_nonneg_left (le_of_lt hk) (inv_nonneg.mpr (le_of_lt hpos))
          _ = 1 := inv_mul_cancel₀ (ne_of_gt hpos)
      refine ⟨k, ⟨(ℓ : Padic ℓ) ^ k * c, hnorm⟩, ?_⟩
      have hp_ne : (ℓ : Padic ℓ) ^ k ≠ 0 := pow_ne_zero k (Nat.cast_ne_zero.mpr hℓ_ne)
      change c = ((((ℓ : ℚ) ^ k)⁻¹ : ℚ) : Padic ℓ) * ((ℓ : Padic ℓ) ^ k * c)
      push_cast
      rw [← mul_assoc, inv_mul_cancel₀ hp_ne, one_mul]
    let B : V₁ →ₗ[Padic ℓ] V₂ →ₗ[Padic ℓ] V_W :=
      { toFun := fun v =>
          { toFun := fun w => B₀ v w
            map_add' := fun w₁ w₂ => map_add (B₀ v) w₁ w₂
            map_smul' := fun c w => by
              obtain ⟨k, z₀, rfl⟩ := hex_padic_denom c
              rw [mul_smul, hB₀_rat_right, hB₀_int_right, RingHom.id_apply, mul_smul] }
        map_add' := fun v₁ v₂ => by
          ext w
          exact AddMonoidHom.add_apply (B₀ v₁) (B₀ v₂) w ▸ congrArg (fun f => f w) (map_add B₀ v₁ v₂)
        map_smul' := fun c v => by
          ext w
          obtain ⟨k, z₀, rfl⟩ := hex_padic_denom c
          simp only [RingHom.id_apply, LinearMap.smul_apply, LinearMap.coe_mk, AddHom.coe_mk]
          rw [mul_smul, hB₀_rat_left, hB₀_int_left, mul_smul] }
    let κ : TensorProduct (Padic ℓ) V₁ V₂ →ₗ[Padic ℓ] V_W := TensorProduct.lift B
    have hB_pure : ∀ (x : ↥L₁) (y : ↥L₂),
        B (e₁ ((1 : ℚ) ⊗ₜ[ℤ] x)) (e₂ ((1 : ℚ) ⊗ₜ[ℤ] y)) = e_W ((1 : ℚ) ⊗ₜ[ℤ] μL x y) := by
      intro x y
      change B₀ (e₁ ((1 : ℚ) ⊗ₜ[ℤ] x)) (e₂ ((1 : ℚ) ⊗ₜ[ℤ] y)) = e_W ((1 : ℚ) ⊗ₜ[ℤ] μL x y)
      rw [hB₀_tmul 1 1 x y]
      simp [β_add]
    have hκ_pure : ∀ (x : ↥L₁) (y : ↥L₂),
        κ ((e₁ ((1 : ℚ) ⊗ₜ[ℤ] x)) ⊗ₜ[Padic ℓ] (e₂ ((1 : ℚ) ⊗ₜ[ℤ] y))) =
          e_W ((1 : ℚ) ⊗ₜ[ℤ] μL x y) :=
      fun x y => hB_pure x y
    have hκ_frob : ∀ (v₁ : V₁) (v₂ : V₂),
        κ ((Φ₁ v₁) ⊗ₜ[Padic ℓ] (Φ₂ v₂)) = Φ_W (κ (v₁ ⊗ₜ[Padic ℓ] v₂)) := by
      intro v₁ v₂
      rw [TensorProduct.lift.tmul, TensorProduct.lift.tmul]
      rw [← e₁.apply_symm_apply v₁, ← e₂.apply_symm_apply v₂]
      generalize e₁.symm v₁ = t
      generalize e₂.symm v₂ = s
      refine TensorProduct.inductionOn
        (motive := fun t =>
          B (Φ₁ (e₁ t)) (Φ₂ (e₂ s)) = Φ_W (B (e₁ t) (e₂ s))) t
        (fun q₁ x => ?_)
        (fun t₁ t₂ ih₁ ih₂ => by
          rw [map_add, map_add, map_add, LinearMap.add_apply, map_add, LinearMap.add_apply,
            map_add, ih₁, ih₂])
      have ht1 : q₁ ⊗ₜ[ℤ] x = q₁ • ((1 : ℚ) ⊗ₜ[ℤ] x) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [ht1, hEquivRat e₁]
      exact TensorProduct.inductionOn
        (motive := fun s =>
          B (Φ₁ ((q₁ : Padic ℓ) • e₁ ((1 : ℚ) ⊗ₜ[ℤ] x))) (Φ₂ (e₂ s)) =
            Φ_W (B ((q₁ : Padic ℓ) • e₁ ((1 : ℚ) ⊗ₜ[ℤ] x)) (e₂ s))) s
        (fun q₂ y => by
          have hs1 : q₂ ⊗ₜ[ℤ] y = q₂ • ((1 : ℚ) ⊗ₜ[ℤ] y) := by
            rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          rw [hs1, hEquivRat e₂, Φ₁.map_smul, Φ₂.map_smul,
            B.map_smul, LinearMap.smul_apply, (B _).map_smul,
            B.map_smul, LinearMap.smul_apply, (B _).map_smul,
            Φ_W.map_smul, Φ_W.map_smul,
            hfrob₁ x (frobL₁ x) (fun _ => rfl), hfrob₂ y (frobL₂ y) (fun _ => rfl),
            hB_pure (frobL₁ x) (frobL₂ y), hB_pure x y,
            hfrob_W (μL x y) (μL (frobL₁ x) (frobL₂ y)) (fun r => (hFrob r (x.1 r) (y.1 r)).symm)])
        (fun s₁ s₂ ih₁ ih₂ => by
          rw [map_add, map_add, map_add, map_add, map_add, ih₁, ih₂])
    have hClearDenom : ∀ {L : Type u} [AddCommGroup L] (t : TensorProduct ℤ ℚ L),
        ∃ m : ℕ, m ≠ 0 ∧ ∃ x : L, m • t = (1 : ℚ) ⊗ₜ[ℤ] x := by
      intro L _ t
      refine TensorProduct.inductionOn
        (motive := fun t => ∃ m : ℕ, m ≠ 0 ∧ ∃ x : L, m • t = (1 : ℚ) ⊗ₜ[ℤ] x) t
        (fun q x₀ => ?_)
        (fun t₁ t₂ ih₁ ih₂ => ?_)
      · refine ⟨q.den, q.den_nz, q.num • x₀, ?_⟩
        have h1 : q.den • (q ⊗ₜ[ℤ] x₀) = ((q.den : ℤ) • q) ⊗ₜ[ℤ] x₀ := by
          rw [← natCast_zsmul, TensorProduct.smul_tmul']
        have h2 : ((q.den : ℤ) • q) = q.num • (1 : ℚ) := by
          rw [zsmul_eq_mul, Int.cast_natCast, mul_comm, Rat.mul_den_eq_num, zsmul_eq_mul, mul_one]
        rw [h1, h2, TensorProduct.smul_tmul]
      · rcases ih₁ with ⟨m₁, hm₁, x₁, hx₁⟩
        rcases ih₂ with ⟨m₂, hm₂, x₂, hx₂⟩
        refine ⟨m₁ * m₂, Nat.mul_ne_zero hm₁ hm₂, m₂ • x₁ + m₁ • x₂, ?_⟩
        have hmk_nsmul : ∀ (k : ℕ) (w : L), k • ((1 : ℚ) ⊗ₜ[ℤ] w) = (1 : ℚ) ⊗ₜ[ℤ] (k • w) :=
          fun k w => (map_nsmul ((TensorProduct.mk ℤ ℚ L) (1 : ℚ)).toAddMonoidHom k w).symm
        rw [smul_add, mul_comm m₁ m₂, mul_nsmul', hx₁, mul_comm m₂ m₁, mul_nsmul', hx₂,
          hmk_nsmul, hmk_nsmul, TensorProduct.tmul_add]
    have hTensorDecomp : ∀ {F₀ : Type} [Field F₀] {U₁ U₂ : Type u}
        [AddCommGroup U₁] [Module F₀ U₁] [Module.Finite F₀ U₁]
        [AddCommGroup U₂] [Module F₀ U₂] [Module.Finite F₀ U₂]
        (t : TensorProduct F₀ U₁ U₂), t ≠ 0 →
        ∃ (m : ℕ) (v₁ : Fin m → U₁) (v₂ : Fin m → U₂),
          LinearIndependent F₀ v₁ ∧
          (∃ a : Fin m, v₂ a ≠ 0) ∧
          ∑ a : Fin m, v₁ a ⊗ₜ[F₀] v₂ a = t := by
      intro F₀ _ U₁ U₂ _ _ _ _ _ _ t ht_ne
      let I₁ := Module.Free.ChooseBasisIndex F₀ U₁
      let b₁ : Module.Basis I₁ F₀ U₁ := Module.Free.chooseBasis F₀ U₁
      let I₂ := Module.Free.ChooseBasisIndex F₀ U₂
      let b₂ : Module.Basis I₂ F₀ U₂ := Module.Free.chooseBasis F₀ U₂
      let m : ℕ := Fintype.card I₁
      let e_idx : Fin m ≃ I₁ := (Fintype.equivFin I₁).symm
      let v₁ : Fin m → U₁ := fun a => b₁ (e_idx a)
      let v₂ : Fin m → U₂ :=
        fun a => ∑ j : I₂, ((b₁.tensorProduct b₂).repr t (e_idx a, j)) • b₂ j
      have hv₁_lin : LinearIndependent F₀ v₁ :=
        b₁.linearIndependent.comp e_idx e_idx.injective
      have ht_sum : ∑ a : Fin m, v₁ a ⊗ₜ[F₀] v₂ a = t := by
        have hterm : ∀ a : Fin m,
            v₁ a ⊗ₜ[F₀] v₂ a =
              ∑ j : I₂, ((b₁.tensorProduct b₂).repr t (e_idx a, j)) •
                (b₁.tensorProduct b₂) (e_idx a, j) := by
          intro a
          dsimp only [v₁, v₂]
          rw [TensorProduct.tmul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [TensorProduct.tmul_smul, ← Module.Basis.tensorProduct_apply' b₁ b₂ (e_idx a, j)]
        have h1 : ∑ a : Fin m, v₁ a ⊗ₜ[F₀] v₂ a =
            ∑ a : Fin m, ∑ j : I₂, ((b₁.tensorProduct b₂).repr t (e_idx a, j)) •
              (b₁.tensorProduct b₂) (e_idx a, j) :=
          Finset.sum_congr rfl fun a _ => hterm a
        have h2 : ∑ a : Fin m, ∑ j : I₂, ((b₁.tensorProduct b₂).repr t (e_idx a, j)) •
              (b₁.tensorProduct b₂) (e_idx a, j) =
            ∑ i : I₁, ∑ j : I₂, ((b₁.tensorProduct b₂).repr t (i, j)) •
              (b₁.tensorProduct b₂) (i, j) :=
          e_idx.sum_comp (fun i =>
            ∑ j : I₂, ((b₁.tensorProduct b₂).repr t (i, j)) • (b₁.tensorProduct b₂) (i, j))
        have h3 : ∑ i : I₁, ∑ j : I₂, ((b₁.tensorProduct b₂).repr t (i, j)) •
              (b₁.tensorProduct b₂) (i, j) =
            ∑ p : I₁ × I₂, ((b₁.tensorProduct b₂).repr t p) • (b₁.tensorProduct b₂) p :=
          (Fintype.sum_prod_type (fun p : I₁ × I₂ =>
            ((b₁.tensorProduct b₂).repr t p) • (b₁.tensorProduct b₂) p)).symm
        rw [h1, h2, h3]
        exact (b₁.tensorProduct b₂).sum_repr t
      have hex_v₂ : ∃ a : Fin m, v₂ a ≠ 0 := by
        by_contra hall
        simp only [not_exists, not_ne_iff] at hall
        apply ht_ne
        rw [← ht_sum]
        exact Finset.sum_eq_zero fun a _ => by rw [hall a, TensorProduct.tmul_zero]
      exact ⟨m, v₁, v₂, hv₁_lin, hex_v₂, ht_sum⟩
    have hTorsOfTensorZero : ∀ y : ↥L_W, (1 : ℚ) ⊗ₜ[ℤ] y = 0 →
        ∃ N₀ : ℕ, N₀ ≠ 0 ∧ N₀ • y = 0 := by
      intro y hy0
      let f_loc : ↥L_W →ₗ[ℤ] TensorProduct ℤ ℚ ↥L_W := TensorProduct.mk ℤ ℚ ↥L_W 1
      have : IsLocalizedModule (nonZeroDivisors ℤ) f_loc :=
        IsLocalization.tensorProduct_isLocalizedModule (nonZeroDivisors ℤ) ℚ
      have hmk0 : IsLocalizedModule.mk' f_loc y (1 : nonZeroDivisors ℤ) = 0 :=
        (IsLocalizedModule.mk'_eq_zero (S := nonZeroDivisors ℤ) (f := f_loc)
          (1 : nonZeroDivisors ℤ)).mpr hy0
      obtain ⟨s', hs'⟩ :=
        (IsLocalizedModule.mk'_eq_zero' f_loc (1 : nonZeroDivisors ℤ)).mp hmk0
      have hs'_ne : (s' : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s'.2
      refine ⟨(s' : ℤ).natAbs, Int.natAbs_ne_zero.mpr hs'_ne, ?_⟩
      rcases Int.natAbs_eq (s' : ℤ) with hpos | hneg
      · have h1 : ((s' : ℤ).natAbs : ℤ) • y = 0 := by
          rw [← hpos]
          exact hs'
        rwa [natCast_zsmul] at h1
      · have h1 : -(((s' : ℤ).natAbs : ℤ) • y) = 0 := by
          rw [← neg_zsmul, ← hneg]
          exact hs'
        rw [neg_eq_zero, natCast_zsmul] at h1
        exact h1
    have hκ_inj : Function.Injective κ := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro t ht
      rw [LinearMap.mem_ker] at ht
      by_contra ht_ne
      obtain ⟨m, v₁, v₂, hv₁_lin, ⟨a₀, ha₀_ne⟩, ht_sum⟩ := hTensorDecomp t ht_ne
      choose n₁ hn₁_ne u_raw hu_raw using fun a : Fin m => hClearDenom (e₁.symm (v₁ a))
      choose n₂ hn₂_ne w_raw hw_raw using fun a : Fin m => hClearDenom (e₂.symm (v₂ a))
      let N₁ : ℕ := ∏ b : Fin m, n₁ b
      let N₂ : ℕ := ∏ b : Fin m, n₂ b
      have hN₁_ne : N₁ ≠ 0 := Finset.prod_ne_zero_iff.mpr fun b _ => hn₁_ne b
      have hN₂_ne : N₂ ≠ 0 := Finset.prod_ne_zero_iff.mpr fun b _ => hn₂_ne b
      let u : Fin m → ↥L₁ := fun a => (∏ b ∈ Finset.univ.erase a, n₁ b) • u_raw a
      let w : Fin m → ↥L₂ := fun a => (∏ b ∈ Finset.univ.erase a, n₂ b) • w_raw a
      have hmk_nsmul : ∀ {L : Type u} [AddCommGroup L] (k : ℕ) (x : L),
          k • ((1 : ℚ) ⊗ₜ[ℤ] x) = (1 : ℚ) ⊗ₜ[ℤ] (k • x) :=
        fun k x => (map_nsmul ((TensorProduct.mk ℤ ℚ _) (1 : ℚ)).toAddMonoidHom k x).symm
      have hu_eq : ∀ a : Fin m, (N₁ : Padic ℓ) • v₁ a = e₁ ((1 : ℚ) ⊗ₜ[ℤ] u a) := by
        intro a
        have hprod : (∏ b ∈ Finset.univ.erase a, n₁ b) * n₁ a = N₁ :=
          Finset.prod_erase_mul Finset.univ n₁ (Finset.mem_univ a)
        have hv_raw : n₁ a • v₁ a = e₁ ((1 : ℚ) ⊗ₜ[ℤ] u_raw a) := by
          rw [← hu_raw a, map_nsmul, e₁.apply_symm_apply]
        rw [Nat.cast_smul_eq_nsmul, ← hprod, mul_nsmul', hv_raw, ← map_nsmul, hmk_nsmul]
      have hw_eq : ∀ a : Fin m, (N₂ : Padic ℓ) • v₂ a = e₂ ((1 : ℚ) ⊗ₜ[ℤ] w a) := by
        intro a
        have hprod : (∏ b ∈ Finset.univ.erase a, n₂ b) * n₂ a = N₂ :=
          Finset.prod_erase_mul Finset.univ n₂ (Finset.mem_univ a)
        have hv_raw : n₂ a • v₂ a = e₂ ((1 : ℚ) ⊗ₜ[ℤ] w_raw a) := by
          rw [← hw_raw a, map_nsmul, e₂.apply_symm_apply]
        rw [Nat.cast_smul_eq_nsmul, ← hprod, mul_nsmul', hv_raw, ← map_nsmul, hmk_nsmul]
      have hu_indep : ∀ z : Fin m → PadicInt ℓ,
          (∀ r : ℕ, ∑ a : Fin m, (PadicInt.toZModPow r (z a)).val • (u a).1 r = 0) → z = 0 := by
        intro z hz
        have hsum_L₁ : ∑ a : Fin m, smulL₁ (z a) (u a) = 0 := by
          ext r
          change (∑ a : Fin m, smulL₁ (z a) (u a)).1 r = 0
          have hev : ∀ s : Finset (Fin m),
              (∑ a ∈ s, smulL₁ (z a) (u a)).1 r =
                ∑ a ∈ s, (PadicInt.toZModPow r (z a)).val • (u a).1 r := by
            intro s
            induction s using Finset.induction_on with
            | empty => rfl
            | @insert a s ha ih =>
              rw [Finset.sum_insert ha, Finset.sum_insert ha, AddSubgroup.coe_add,
                Pi.add_apply, ih]
          rw [hev Finset.univ]
          exact hz r
        have hsum_V₁ : ∑ a : Fin m, ((z a : Padic ℓ) * (N₁ : Padic ℓ)) • v₁ a = 0 := by
          calc
            ∑ a : Fin m, ((z a : Padic ℓ) * (N₁ : Padic ℓ)) • v₁ a
              = ∑ a : Fin m, (z a : Padic ℓ) • e₁ ((1 : ℚ) ⊗ₜ[ℤ] u a) := by
                  refine Finset.sum_congr rfl fun a _ => ?_
                  rw [mul_smul, hu_eq a]
            _ = ∑ a : Fin m, e₁ ((1 : ℚ) ⊗ₜ[ℤ] smulL₁ (z a) (u a)) := by
                  refine Finset.sum_congr rfl fun a _ =>
                    (hsmul₁ (z a) (u a) (smulL₁ (z a) (u a)) fun _ => rfl).symm
            _ = e₁ ((1 : ℚ) ⊗ₜ[ℤ] ∑ a : Fin m, smulL₁ (z a) (u a)) := by
                  rw [TensorProduct.tmul_sum, map_sum]
            _ = 0 := by rw [hsum_L₁, TensorProduct.tmul_zero, map_zero]
        have hcoeff0 := Fintype.linearIndependent_iff.mp hv₁_lin
          (fun a => (z a : Padic ℓ) * (N₁ : Padic ℓ)) hsum_V₁
        have hN₁_padic : (N₁ : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hN₁_ne
        funext a
        apply Subtype.ext
        exact (mul_eq_zero.mp (hcoeff0 a)).resolve_right hN₁_padic
      have hw_nontors : ∃ a : Fin m, ∀ k_pow : ℕ, ∃ r : ℕ, (ℓ ^ k_pow) • (w a).1 r ≠ 0 := by
        refine ⟨a₀, fun k_pow => ?_⟩
        by_contra hall0
        simp only [not_exists, not_ne_iff] at hall0
        have hw0 : (ℓ ^ k_pow) • w a₀ = 0 := by
          ext r
          exact hall0 r
        have hv0 : ((ℓ ^ k_pow * N₂ : ℕ) : Padic ℓ) • v₂ a₀ = 0 := by
          rw [Nat.cast_mul, mul_smul, hw_eq a₀, Nat.cast_smul_eq_nsmul, ← map_nsmul,
            hmk_nsmul, hw0, TensorProduct.tmul_zero, map_zero]
        have hne : ((ℓ ^ k_pow * N₂ : ℕ) : Padic ℓ) ≠ 0 :=
          Nat.cast_ne_zero.mpr (Nat.mul_ne_zero (pow_ne_zero k_pow hℓ_ne) hN₂_ne)
        exact ha₀_ne ((smul_eq_zero.mp hv0).resolve_left hne)
      let y : ↥L_W := ∑ a : Fin m, μL (u a) (w a)
      have hy_V : e_W ((1 : ℚ) ⊗ₜ[ℤ] y) = 0 := by
        dsimp [y]
        rw [TensorProduct.tmul_sum, map_sum]
        calc
          ∑ a : Fin m, e_W ((1 : ℚ) ⊗ₜ[ℤ] μL (u a) (w a))
            = ∑ a : Fin m, κ ((e₁ ((1 : ℚ) ⊗ₜ[ℤ] u a)) ⊗ₜ[Padic ℓ] (e₂ ((1 : ℚ) ⊗ₜ[ℤ] w a))) := by
                refine Finset.sum_congr rfl fun a _ => (hκ_pure (u a) (w a)).symm
          _ = ∑ a : Fin m, κ (((N₁ : Padic ℓ) • v₁ a) ⊗ₜ[Padic ℓ] ((N₂ : Padic ℓ) • v₂ a)) := by
                refine Finset.sum_congr rfl fun a _ => by rw [hu_eq a, hw_eq a]
          _ = ((N₁ : Padic ℓ) * (N₂ : Padic ℓ)) • κ (∑ a : Fin m, v₁ a ⊗ₜ[Padic ℓ] v₂ a) := by
                rw [map_sum, Finset.smul_sum]
                refine Finset.sum_congr rfl fun a _ => ?_
                rw [TensorProduct.lift.tmul, TensorProduct.lift.tmul, B.map_smul,
                  LinearMap.smul_apply, (B _).map_smul, mul_smul]
          _ = 0 := by rw [ht_sum, ht, smul_zero]
      have hy_tensor0 : (1 : ℚ) ⊗ₜ[ℤ] y = 0 :=
        e_W.injective (hy_V.trans (map_zero e_W).symm)
      obtain ⟨N₀, hN₀_ne, hN₀_y⟩ := hTorsOfTensorZero y hy_tensor0
      let k₀ : ℕ := N₀.factorization ℓ
      let b₀ : ℕ := N₀ / ℓ ^ k₀
      have hN₀_fac : ℓ ^ k₀ * b₀ = N₀ := Nat.ordProj_mul_ordCompl_eq_self N₀ ℓ
      have hcop : ℓ.Coprime b₀ := Nat.coprime_ordCompl hℓ_prime hN₀_ne
      obtain ⟨r₀, hr₀_ne⟩ := hNonTors m u w hu_indep hw_nontors k₀
      apply hr₀_ne
      have hy_eval : ∀ s : Finset (Fin m),
          (∑ a ∈ s, μL (u a) (w a)).1 r₀ = ∑ a ∈ s, μ r₀ ((u a).1 r₀) ((w a).1 r₀) := by
        intro s
        induction s using Finset.induction_on with
        | empty => rfl
        | @insert a s ha ih =>
          rw [Finset.sum_insert ha, Finset.sum_insert ha, AddSubgroup.coe_add, Pi.add_apply, ih]
      rw [← hy_eval Finset.univ]
      change (ℓ ^ k₀) • y.1 r₀ = 0
      set z₀ : H_W r₀ := (ℓ ^ k₀) • y.1 r₀
      have hz₀_b₀ : b₀ • z₀ = 0 := by
        dsimp [z₀]
        rw [← mul_nsmul', mul_comm b₀ (ℓ ^ k₀), hN₀_fac]
        exact congrFun (congrArg Subtype.val hN₀_y) r₀
      have hz₀_pow : (ℓ ^ r₀) • z₀ = 0 := hTors_W r₀ z₀
      rcases Nat.eq_zero_or_pos r₀ with rfl | hr₀_pos
      · simpa using hz₀_pow
      · have : NeZero (ℓ ^ r₀) := ⟨pow_ne_zero r₀ hℓ_ne⟩
        have hcop_pow : b₀.Coprime (ℓ ^ r₀) := hcop.symm.pow_right r₀
        let u_unit : (ZMod (ℓ ^ r₀))ˣ := ZMod.unitOfCoprime b₀ hcop_pow
        let inv_val : ℕ := (u_unit⁻¹ : (ZMod (ℓ ^ r₀))ˣ).val.val
        have hmul_one : ((inv_val * b₀ : ℕ) : ZMod (ℓ ^ r₀)) = 1 := by
          rw [Nat.cast_mul, ZMod.natCast_zmod_val]
          exact Units.inv_mul u_unit
        have h1lt : 1 < ℓ ^ r₀ := one_lt_pow₀ hℓ_prime.one_lt (Nat.ne_of_gt hr₀_pos)
        have hmod1 : (inv_val * b₀) % (ℓ ^ r₀) = 1 := by
          have hv := congrArg ZMod.val hmul_one
          rwa [ZMod.val_natCast, ZMod.val_one'' (ne_of_gt h1lt)] at hv
        have hdiv := (Nat.div_add_mod (inv_val * b₀) (ℓ ^ r₀)).symm
        rw [hmod1] at hdiv
        have hzero_inv : (inv_val * b₀) • z₀ = 0 := by
          rw [mul_nsmul', hz₀_b₀, smul_zero]
        rw [hdiv, add_nsmul, mul_comm (ℓ ^ r₀), mul_nsmul', hz₀_pow, smul_zero, zero_add,
          one_smul] at hzero_inv
        exact hzero_inv
    exact ⟨κ, hκ_inj, hκ_frob⟩

  
  have hLinAlg : ∀ (F₀ : Type) [Field F₀]
      (V₁ V₂ V_W : Type u)
      [AddCommGroup V₁] [Module F₀ V₁] [Module.Finite F₀ V₁]
      [AddCommGroup V₂] [Module F₀ V₂] [Module.Finite F₀ V₂]
      [AddCommGroup V_W] [Module F₀ V_W] [Module.Finite F₀ V_W]
      (Φ₁ : V₁ →ₗ[F₀] V₁) (Φ₂ : V₂ →ₗ[F₀] V₂) (Φ_W : V_W →ₗ[F₀] V_W)
      (κ : TensorProduct F₀ V₁ V₂ →ₗ[F₀] V_W),
      Function.Injective κ →
      (∀ (v₁ : V₁) (v₂ : V₂),
        κ (TensorProduct.tmul F₀ (Φ₁ v₁) (Φ₂ v₂)) = Φ_W (κ (TensorProduct.tmul F₀ v₁ v₂))) →
      ∀ (α₁ α₂ : AlgebraicClosure F₀),
        α₁ ∈ (Φ₁.charpoly).aroots (AlgebraicClosure F₀) →
        α₂ ∈ (Φ₂.charpoly).aroots (AlgebraicClosure F₀) →
        α₁ * α₂ ∈ (Φ_W.charpoly).aroots (AlgebraicClosure F₀) := by
    intro F₀ _ V₁ V₂ V_W _ _ _ _ _ _ _ _ _ Φ₁ Φ₂ Φ_W κ hInj hIntertwine α₁ α₂ hα₁ hα₂
    let L := AlgebraicClosure F₀
    let σ : F₀ →+* L := algebraMap F₀ L
    let I₁ := Module.Free.ChooseBasisIndex F₀ V₁
    let b₁ : Module.Basis I₁ F₀ V₁ := Module.Free.chooseBasis F₀ V₁
    let I₂ := Module.Free.ChooseBasisIndex F₀ V₂
    let b₂ : Module.Basis I₂ F₀ V₂ := Module.Free.chooseBasis F₀ V₂
    let b₁₂ : Module.Basis (I₁ × I₂) F₀ (TensorProduct F₀ V₁ V₂) := b₁.tensorProduct b₂
    let I_W := Module.Free.ChooseBasisIndex F₀ V_W
    let b_W : Module.Basis I_W F₀ V_W := Module.Free.chooseBasis F₀ V_W
    let Ψ₁₂ : TensorProduct F₀ V₁ V₂ →ₗ[F₀] TensorProduct F₀ V₁ V₂ := TensorProduct.map Φ₁ Φ₂
    have hcomm_map : κ ∘ₗ Ψ₁₂ = Φ_W ∘ₗ κ := by
      apply TensorProduct.ext'
      intro v₁ v₂
      exact hIntertwine v₁ v₂
    let A₁ := LinearMap.toMatrix b₁ b₁ Φ₁
    let A₂ := LinearMap.toMatrix b₂ b₂ Φ₂
    let A₁₂ := LinearMap.toMatrix b₁₂ b₁₂ Ψ₁₂
    let A_W := LinearMap.toMatrix b_W b_W Φ_W
    let K_mat := LinearMap.toMatrix b₁₂ b_W κ
    have hKA : K_mat * A₁₂ = A_W * K_mat := by
      dsimp only [K_mat, A₁₂, A_W]
      rw [← LinearMap.toMatrix_comp b₁₂ b₁₂ b_W, hcomm_map, LinearMap.toMatrix_comp b₁₂ b_W b_W]
    have hA₁₂_entry : ∀ (j₁ k₁ : I₁) (j₂ k₂ : I₂),
        A₁₂ (j₁, j₂) (k₁, k₂) = A₁ j₁ k₁ * A₂ j₂ k₂ := by
      intro j₁ k₁ j₂ k₂
      dsimp only [A₁₂, A₁, A₂]
      rw [LinearMap.toMatrix_apply, LinearMap.toMatrix_apply, LinearMap.toMatrix_apply]
      rw [Module.Basis.tensorProduct_apply', TensorProduct.map_tmul,
        Module.Basis.tensorProduct_repr_tmul_apply, smul_eq_mul, mul_comm]
    have hK_inj : Function.Injective K_mat.mulVecLin := by
      intro v₁ v₂ hv
      apply b₁₂.equivFun.symm.injective
      apply hInj
      apply b_W.equivFun.injective
      have hmul : ∀ v : I₁ × I₂ → F₀,
          b_W.equivFun (κ (b₁₂.equivFun.symm v)) = K_mat.mulVecLin v := by
        intro v
        ext k
        have hm := LinearMap.toMatrix_mulVec_repr b₁₂ b_W κ (b₁₂.equivFun.symm v)
        have hrepr : (⇑(b₁₂.repr (b₁₂.equivFun.symm v)) : I₁ × I₂ → F₀) = v :=
          (b₁₂.equivFun_apply (b₁₂.equivFun.symm v)).symm.trans (b₁₂.equivFun.apply_symm_apply v)
        change b_W.repr (κ (b₁₂.equivFun.symm v)) k = (K_mat.mulVec v) k
        have hm_k := congrFun hm.symm k
        dsimp only [K_mat]
        rwa [hrepr] at hm_k
      rw [hmul v₁, hmul v₂, hv]
    obtain ⟨g_left, hg_left⟩ :=
      LinearMap.exists_leftInverse_of_injective K_mat.mulVecLin (LinearMap.ker_eq_bot.mpr hK_inj)
    let L_mat : Matrix (I₁ × I₂) I_W F₀ := LinearMap.toMatrix' g_left
    have hLK : L_mat * K_mat = 1 := by
      apply LinearMap.toMatrix'.symm.injective
      change (L_mat * K_mat).mulVecLin = (1 : Matrix (I₁ × I₂) (I₁ × I₂) F₀).mulVecLin
      rw [Matrix.mulVecLin_mul, Matrix.mulVecLin_one]
      change (LinearMap.toMatrix'.symm (LinearMap.toMatrix' g_left)).comp K_mat.mulVecLin =
        LinearMap.id
      rw [LinearEquiv.symm_apply_apply]
      exact hg_left
    have hEigenOfRoot : ∀ {I : Type u} [Fintype I] [DecidableEq I]
        (B : Matrix I I F₀) (γ : L),
        γ ∈ (B.charpoly).aroots L →
        ∃ c : I → L, c ≠ 0 ∧ (B.map σ).mulVec c = γ • c := by
      intro I _ _ B γ hγ
      rw [Polynomial.aroots_def, ← Matrix.charpoly_map] at hγ
      have hmonic : (B.map σ).charpoly.Monic := Matrix.charpoly_monic (B.map σ)
      have hroot : (B.map σ).charpoly.IsRoot γ :=
        (Polynomial.mem_roots hmonic.ne_zero).mp hγ
      rw [Polynomial.IsRoot.def, Matrix.eval_charpoly] at hroot
      obtain ⟨c, hc_ne, hc0⟩ := (Matrix.exists_mulVec_eq_zero_iff).mpr hroot
      refine ⟨c, hc_ne, ?_⟩
      rw [Matrix.sub_mulVec, sub_eq_zero] at hc0
      have hsc : (Matrix.scalar I γ).mulVec c = γ • c := by
        ext i
        simp [Matrix.scalar_apply, Matrix.mulVec_diagonal]
      rw [← hc0, hsc]
    rw [← LinearMap.charpoly_toMatrix Φ₁ b₁] at hα₁
    rw [← LinearMap.charpoly_toMatrix Φ₂ b₂] at hα₂
    obtain ⟨c₁, hc₁_ne, hc₁_eig⟩ := hEigenOfRoot A₁ α₁ hα₁
    obtain ⟨c₂, hc₂_ne, hc₂_eig⟩ := hEigenOfRoot A₂ α₂ hα₂
    obtain ⟨i₁₀, hi₁₀⟩ := Function.ne_iff.mp hc₁_ne
    obtain ⟨i₂₀, hi₂₀⟩ := Function.ne_iff.mp hc₂_ne
    let c₁₂ : I₁ × I₂ → L := fun p => c₁ p.1 * c₂ p.2
    have hc₁₂_ne : c₁₂ ≠ 0 := by
      intro h0
      exact mul_ne_zero hi₁₀ hi₂₀ (congrFun h0 (i₁₀, i₂₀))
    let K_bar := K_mat.map σ
    let L_bar := L_mat.map σ
    let A₁_bar := A₁.map σ
    let A₂_bar := A₂.map σ
    let A₁₂_bar := A₁₂.map σ
    let AW_bar := A_W.map σ
    have hLK_bar : L_bar * K_bar = 1 := by
      dsimp [L_bar, K_bar]
      rw [← Matrix.map_mul, hLK]
      ext p q
      simp [Matrix.one_apply]
    have hKA_bar : K_bar * A₁₂_bar = AW_bar * K_bar := by
      dsimp [K_bar, A₁₂_bar, AW_bar]
      rw [← Matrix.map_mul, ← Matrix.map_mul, hKA]
    let w : I_W → L := K_bar.mulVec c₁₂
    have hw_ne : w ≠ 0 := by
      intro hw0
      have h1 : L_bar.mulVec w = c₁₂ := by
        dsimp [w]
        rw [Matrix.mulVec_mulVec, hLK_bar, Matrix.one_mulVec]
      rw [hw0, Matrix.mulVec_zero] at h1
