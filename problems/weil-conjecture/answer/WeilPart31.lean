          rw [← hg_diff, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ g (diffDual₀ 0),
            CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ g)
              (CategoryTheory.Abelian.Ext.mk₀ SC₀.g) ε₀
              (Nat.add_zero 0) (Nat.zero_add 1) (by omega),
            hSC₀.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      let e0_lift : ∀ G : 𝒞₀,
          (CategoryTheory.Abelian.Ext.{u} one₀ G 0 →+ ZMod n) → (G ⟶ 𝒥₀ 0) :=
        fun G φ => Classical.choose (hΘ₀_surj G φ)
      have he0_lift : ∀ (G : 𝒞₀) (φ : CategoryTheory.Abelian.Ext.{u} one₀ G 0 →+ ZMod n),
          Θ₀ G (e0_lift G φ) = φ :=
        fun G φ => Classical.choose_spec (hΘ₀_surj G φ)
