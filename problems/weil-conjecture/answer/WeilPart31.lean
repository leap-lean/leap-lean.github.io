        { toFun := fun φ => Ω₀ G (e0_lift G φ)
          invFun := fun y => Θ₀ G (Classical.choose (hΩ₀_surj G y))
          left_inv := fun φ => by
            let f := Classical.choose (hΩ₀_surj G (Ω₀ G (e0_lift G φ)))
            have hf : Ω₀ G f = Ω₀ G (e0_lift G φ) :=
