        (fun {K} α hα m hm => by
          have hm₁ : m ≫ f_sub₁ = α ≫ CategoryTheory.Limits.biprod.fst := by
            rw [← hm, Category.assoc, CategoryTheory.Limits.biprod.lift_fst]
          apply NatTrans.ext; funext X; apply mod_hom_ext
          intro k; funext ⟨h₁₂⟩
          have h₁ := ((hP_inf W₁ W₂ X.unop).mp h₁₂).1
          have hev := congrFun (ConcreteCategory.congr_hom (NatTrans.congr_app hm₁ X) k) ⟨h₁⟩
          change (if h₁₂' : P_W (W₁ ⊓ W₂) X.unop then m.app X k ⟨h₁₂'⟩ else 0) = _ at hev
          rw [dif_pos h₁₂] at hev
