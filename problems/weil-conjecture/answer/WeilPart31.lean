by
  classical
  haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  intro R M_open j_res
  have mod_hom_ext : ∀ {M N : ModuleCat.{u, u} R} {f g : M ⟶ N},
      (∀ x : M, f x = g x) → f = g := by
    intro M N f g h
    ext x
    exact h x
  have mod_map_zero : ∀ {M N : ModuleCat.{u, u} R} (f : M ⟶ N), f 0 = 0 :=
    fun f => map_zero f.hom
  have mod_map_add : ∀ {M N : ModuleCat.{u, u} R} (f : M ⟶ N) (x y : M), f (x + y) = f x + f y :=
    fun f x y => map_add f.hom x y
  have mod_map_smul : ∀ {M N : ModuleCat.{u, u} R} (f : M ⟶ N) (r : R) (x : M), f (r • x) = r • f x :=
    fun f r x => map_smul f.hom r x
  
  have hEt_w : ∀ {S : AlgebraicGeometry.Scheme.{u}} {A B : S.Etale} (u : A ⟶ B),
      u.left ≫ B.hom = A.hom := by
    intro S A B u
    simpa using u.w
  let P_W (W : Y.Opens) (T : Y.Etale) : Prop :=
    Set.range T.hom.base ⊆ Set.range W.ι.base
  have hRange_eq : ∀ W : Y.Opens, Set.range W.ι.base = (W : Set Y) := by
    intro W
    rw [← AlgebraicGeometry.Scheme.Hom.coe_opensRange W.ι,
      AlgebraicGeometry.Scheme.Opens.opensRange_ι W]
  have hP_mono : ∀ {W₁ W₂ : Y.Opens}, W₁ ≤ W₂ → ∀ {T : Y.Etale}, P_W W₁ T → P_W W₂ T := by
    intro W₁ W₂ h T hT
    dsimp only [P_W] at hT ⊢
    rw [hRange_eq] at hT ⊢
    exact Set.Subset.trans hT h
  have hP_inf : ∀ (W₁ W₂ : Y.Opens) (T : Y.Etale),
      P_W (W₁ ⊓ W₂) T ↔ P_W W₁ T ∧ P_W W₂ T := by
    intro W₁ W₂ T
    dsimp only [P_W]
    rw [hRange_eq (W₁ ⊓ W₂), TopologicalSpace.Opens.coe_inf, Set.subset_inter_iff,
      ← hRange_eq W₁, ← hRange_eq W₂]
  have hP_sup : ∀ (W₁ W₂ : Y.Opens) (T : Y.Etale),
      P_W (W₁ ⊔ W₂) T ↔ Set.range T.hom.base ⊆ (W₁ : Set Y) ∪ (W₂ : Set Y) := by
    intro W₁ W₂ T
    dsimp only [P_W]
    rw [hRange_eq (W₁ ⊔ W₂), TopologicalSpace.Opens.coe_sup]
  have hP_map : ∀ (W : Y.Opens) {T₁ T₂ : Y.Etale} (u : T₁ ⟶ T₂),
      P_W W T₂ → P_W W T₁ := by
    intro W T₁ T₂ u h₂
    refine Set.Subset.trans ?_ h₂
    rintro _ ⟨x, rfl⟩
    have hw := hEt_w u
    exact ⟨u.left.base x, by rw [← hw]; rfl⟩
  have hP_mem : ∀ (W : Y.Opens) (V : W.toScheme.Etale), P_W W ((M_open W).obj V) := by
    intro W V
    rintro _ ⟨x, rfl⟩
    exact ⟨V.hom.base x, rfl⟩
  let liftHom (W : Y.Opens) (T : Y.Etale) (hT : P_W W T) : T.left ⟶ W.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift W.ι T.hom hT
  let liftObj (W : Y.Opens) (T : Y.Etale) (hT : P_W W T) : W.toScheme.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (liftHom W T hT)
      (CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (liftHom W T hT) W.ι (inferInstance : AlgebraicGeometry.Etale W.ι)
        (by rw [AlgebraicGeometry.IsOpenImmersion.lift_fac]; exact T.prop))
  let liftMap (W : Y.Opens) {T₁ T₂ : Y.Etale} (u : T₁ ⟶ T₂)
      (h₁ : P_W W T₁) (h₂ : P_W W T₂) : liftObj W T₁ h₁ ⟶ liftObj W T₂ h₂ :=
    CategoryTheory.MorphismProperty.Over.homMk u.left
      (by
        apply (inferInstance : CategoryTheory.Mono W.ι).right_cancellation
        change (u.left ≫ liftHom W T₂ h₂) ≫ W.ι = (liftHom W T₁ h₁ ≫ 𝟙 W.toScheme) ≫ W.ι
        rw [Category.assoc, AlgebraicGeometry.IsOpenImmersion.lift_fac, hEt_w u,
          Category.comp_id, AlgebraicGeometry.IsOpenImmersion.lift_fac])
      trivial
  let κ_iso (W : Y.Opens) (T : Y.Etale) (hT : P_W W T) :
      (M_open W).obj (liftObj W T hT) ≅ T :=
    { hom := CategoryTheory.MorphismProperty.Over.homMk (𝟙 T.left)
        ((Category.id_comp T.hom).trans
          ((AlgebraicGeometry.IsOpenImmersion.lift_fac W.ι T.hom hT).symm.trans
            (Category.comp_id (liftHom W T hT ≫ W.ι)).symm))
        trivial
      inv := CategoryTheory.MorphismProperty.Over.homMk (𝟙 T.left)
        ((Category.id_comp (liftHom W T hT ≫ W.ι)).trans
          ((AlgebraicGeometry.IsOpenImmersion.lift_fac W.ι T.hom hT).trans
            (Category.comp_id T.hom).symm))
        trivial
      hom_inv_id := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact Category.id_comp (𝟙 T.left)
      inv_hom_id := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact Category.id_comp (𝟙 T.left) }
  let ρ_iso (W : Y.Opens) (V : W.toScheme.Etale) :
      liftObj W ((M_open W).obj V) (hP_mem W V) ≅ V :=
    { hom := CategoryTheory.MorphismProperty.Over.homMk (𝟙 V.left)
        ((Category.id_comp V.hom).trans
          (((cancel_mono W.ι).mp
            (AlgebraicGeometry.IsOpenImmersion.lift_fac W.ι (V.hom ≫ W.ι) (hP_mem W V)).symm).trans
            (Category.comp_id (liftHom W ((M_open W).obj V) (hP_mem W V))).symm))
        trivial
      inv := CategoryTheory.MorphismProperty.Over.homMk (𝟙 V.left)
        ((Category.id_comp (liftHom W ((M_open W).obj V) (hP_mem W V))).trans
          (((cancel_mono W.ι).mp
            (AlgebraicGeometry.IsOpenImmersion.lift_fac W.ι (V.hom ≫ W.ι) (hP_mem W V))).trans
            (Category.comp_id V.hom).symm))
        trivial
      hom_inv_id := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact Category.id_comp (𝟙 V.left)
      inv_hom_id := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact Category.id_comp (𝟙 V.left) }

  
  let j_pSh (W : Y.Opens) :
      ((W.toScheme.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R) ⥤ ((Y.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R) :=
    { obj := fun P =>
        { obj := fun X =>
            ModuleCat.of R (∀ h : PLift (P_W W X.unop),
              P.obj (Opposite.op (liftObj W X.unop h.down)))
          map := fun {X₂ X₁} f_op =>
            ModuleCat.ofHom
              { toFun := fun f ⟨h₁⟩ =>
                  if h₂ : P_W W X₂.unop then
                    P.map (liftMap W f_op.unop h₁ h₂).op (f ⟨h₂⟩)
                  else 0
                map_add' := fun f g => by
                  funext ⟨h₁⟩
                  by_cases h₂ : P_W W X₂.unop
                  · simp [dif_pos h₂]
                  · simp [dif_neg h₂]
                map_smul' := fun r f => by
                  funext ⟨h₁⟩
                  by_cases h₂ : P_W W X₂.unop
                  · simp [dif_pos h₂]
                  · simp [dif_neg h₂] }
          map_id := fun X => by
            apply mod_hom_ext
            intro f
            funext ⟨h₁⟩
            change (if h₂ : P_W W X.unop then
              P.map (liftMap W (𝟙 X.unop) h₁ h₂).op (f ⟨h₂⟩) else 0) = f ⟨h₁⟩
            rw [dif_pos h₁]
            have hid : liftMap W (𝟙 X.unop) h₁ h₁ = 𝟙 (liftObj W X.unop h₁) := by
              apply CategoryTheory.MorphismProperty.Over.Hom.ext
              rfl
            rw [hid, CategoryTheory.op_id, P.map_id]
            rfl
          map_comp := fun {X₃ X₂ X₁} f_op g_op => by
            apply mod_hom_ext
            intro f
            funext ⟨h₁⟩
            change (if h₃ : P_W W X₃.unop then
                P.map (liftMap W (g_op.unop ≫ f_op.unop) h₁ h₃).op (f ⟨h₃⟩) else 0) =
              if h₂ : P_W W X₂.unop then
                P.map (liftMap W g_op.unop h₁ h₂).op
                  (if h₃ : P_W W X₃.unop then
                    P.map (liftMap W f_op.unop h₂ h₃).op (f ⟨h₃⟩) else 0)
              else 0
            by_cases h₃ : P_W W X₃.unop
            · have h₂ : P_W W X₂.unop := hP_map W f_op.unop h₃
              rw [dif_pos h₃, dif_pos h₂, dif_pos h₃]
              have hcomp : liftMap W (g_op.unop ≫ f_op.unop) h₁ h₃ =
                  liftMap W g_op.unop h₁ h₂ ≫ liftMap W f_op.unop h₂ h₃ := by
                apply CategoryTheory.MorphismProperty.Over.Hom.ext
                rfl
              rw [hcomp, CategoryTheory.op_comp, P.map_comp]
              rfl
            · rw [dif_neg h₃]
              by_cases h₂ : P_W W X₂.unop
              · rw [dif_pos h₂, dif_neg h₃, map_zero]
              · rw [dif_neg h₂] }
      map := fun {P₁ P₂} φ =>
        { app := fun X =>
            ModuleCat.ofHom
              { toFun := fun f ⟨h⟩ =>
                  φ.app (Opposite.op (liftObj W X.unop h)) (f ⟨h⟩)
                map_add' := fun f g => by funext ⟨h⟩; simp
                map_smul' := fun r f => by funext ⟨h⟩; simp }
          naturality := fun {X₂ X₁} f_op => by
            apply mod_hom_ext
            intro f
            funext ⟨h₁⟩
            change φ.app (Opposite.op (liftObj W X₁.unop h₁))
                (if h₂ : P_W W X₂.unop then
                  P₁.map (liftMap W f_op.unop h₁ h₂).op (f ⟨h₂⟩) else 0) =
              if h₂ : P_W W X₂.unop then
                P₂.map (liftMap W f_op.unop h₁ h₂).op
                  (φ.app (Opposite.op (liftObj W X₂.unop h₂)) (f ⟨h₂⟩))
              else 0
            by_cases h₂ : P_W W X₂.unop
            · rw [dif_pos h₂, dif_pos h₂]
              exact ConcreteCategory.congr_hom (φ.naturality (liftMap W f_op.unop h₁ h₂).op) (f ⟨h₂⟩)
            · rw [dif_neg h₂, dif_neg h₂, map_zero] }
      map_id := fun P => by
        apply NatTrans.ext; funext X; apply mod_hom_ext; intro f; rfl
      map_comp := fun φ ψ => by
        apply NatTrans.ext; funext X; apply mod_hom_ext; intro f; rfl }

  let j_res_pSh (W : Y.Opens) :
      ((Y.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R) ⥤ ((W.toScheme.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R) :=
    { obj := fun Q => (M_open W).op ⋙ Q
      map := fun φ => CategoryTheory.Functor.whiskerLeft (M_open W).op φ }

  let embed_V (W : Y.Opens) (P : (W.toScheme.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R)
      (V : W.toScheme.Etale) :
      P.obj (Opposite.op V) ⟶ ((j_pSh W).obj P).obj (Opposite.op ((M_open W).obj V)) :=
    ModuleCat.ofHom
      { toFun := fun x ⟨h⟩ =>
          (P.map (ρ_iso W V).hom.op x : P.obj (Opposite.op (liftObj W ((M_open W).obj V) h)))
        map_add' := fun x y => by funext ⟨_⟩; simp
        map_smul' := fun r x => by funext ⟨_⟩; simp }

  let adj_pSh (W : Y.Opens) : j_pSh W ⊣ j_res_pSh W :=
    CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := fun P Q =>
          { toFun := fun α =>
              { app := fun X => embed_V W P X.unop ≫ α.app (Opposite.op ((M_open W).obj X.unop))
                naturality := fun {X₂ X₁} w_op => by
                  apply mod_hom_ext
                  intro x
                  let w := w_op.unop
                  have hnat : Q.map ((M_open W).map w).op
                      (α.app (Opposite.op ((M_open W).obj X₂.unop)) (embed_V W P X₂.unop x)) =
                      α.app (Opposite.op ((M_open W).obj X₁.unop))
                        (((j_pSh W).obj P).map ((M_open W).map w).op (embed_V W P X₂.unop x)) :=
                    (ConcreteCategory.congr_hom
                      (α.naturality ((M_open W).map w).op) (embed_V W P X₂.unop x)).symm
                  change α.app (Opposite.op ((M_open W).obj X₁.unop))
                      (embed_V W P X₁.unop (P.map w.op x)) =
                    Q.map ((M_open W).map w).op
                      (α.app (Opposite.op ((M_open W).obj X₂.unop)) (embed_V W P X₂.unop x))
                  rw [hnat]
                  congr 1
                  funext ⟨h₁⟩
                  change P.map (ρ_iso W X₁.unop).hom.op (P.map w.op x) =
                    if h₂ : P_W W ((M_open W).obj X₂.unop) then
                      P.map (liftMap W ((M_open W).map w) h₁ h₂).op
                        (P.map (ρ_iso W X₂.unop).hom.op x)
                    else 0
                  rw [dif_pos (hP_mem W X₂.unop)]
                  have hcomm : (ρ_iso W X₁.unop).hom ≫ w =
                      liftMap W ((M_open W).map w) h₁ (hP_mem W X₂.unop) ≫
                        (ρ_iso W X₂.unop).hom := by
                    apply CategoryTheory.MorphismProperty.Over.Hom.ext
                    change 𝟙 X₁.unop.left ≫ w.left = w.left ≫ 𝟙 X₂.unop.left
                    simp
                  have hcomm_op : w.op ≫ (ρ_iso W X₁.unop).hom.op =
                      (ρ_iso W X₂.unop).hom.op ≫
                        (liftMap W ((M_open W).map w) h₁ (hP_mem W X₂.unop)).op := by
                    rw [← CategoryTheory.op_comp, ← CategoryTheory.op_comp, hcomm]
                  calc
                    P.map (ρ_iso W X₁.unop).hom.op (P.map w.op x)
                      = (P.map w.op ≫ P.map (ρ_iso W X₁.unop).hom.op) x := rfl
                    _ = P.map (w.op ≫ (ρ_iso W X₁.unop).hom.op) x := by rw [← P.map_comp]
                    _ = P.map ((ρ_iso W X₂.unop).hom.op ≫
                          (liftMap W ((M_open W).map w) h₁ (hP_mem W X₂.unop)).op) x := by
                        rw [hcomm_op]
                    _ = P.map (liftMap W ((M_open W).map w) h₁ (hP_mem W X₂.unop)).op
                          (P.map (ρ_iso W X₂.unop).hom.op x) := by
                        rw [P.map_comp]; rfl }
            invFun := fun β =>
              { app := fun X =>
                  ModuleCat.ofHom
                    { toFun := fun f =>
                        if hT : P_W W X.unop then
                          Q.map (κ_iso W X.unop hT).inv.op
                            (β.app (Opposite.op (liftObj W X.unop hT)) (f ⟨hT⟩))
                        else 0
                      map_add' := fun f g => by
                        by_cases hT : P_W W X.unop
                        · simp [dif_pos hT]
                        · simp [dif_neg hT]
                      map_smul' := fun r f => by
                        by_cases hT : P_W W X.unop
                        · simp [dif_pos hT]
                        · simp [dif_neg hT] }
                naturality := fun {X₂ X₁} u_op => by
                  apply mod_hom_ext
                  intro f
                  let u := u_op.unop
                  change (if h₁ : P_W W X₁.unop then
                      Q.map (κ_iso W X₁.unop h₁).inv.op
                        (β.app (Opposite.op (liftObj W X₁.unop h₁))
                          (if h₂ : P_W W X₂.unop then
                            P.map (liftMap W u h₁ h₂).op (f ⟨h₂⟩) else 0))
                    else 0) =
                    Q.map u.op
                      (if h₂ : P_W W X₂.unop then
                        Q.map (κ_iso W X₂.unop h₂).inv.op
                          (β.app (Opposite.op (liftObj W X₂.unop h₂)) (f ⟨h₂⟩))
                      else 0)
                  by_cases h₂ : P_W W X₂.unop
                  · have h₁ : P_W W X₁.unop := hP_map W u h₂
                    rw [dif_pos h₁, dif_pos h₂, dif_pos h₂]
                    have hnat : β.app (Opposite.op (liftObj W X₁.unop h₁))
                        (P.map (liftMap W u h₁ h₂).op (f ⟨h₂⟩)) =
                        Q.map ((M_open W).map (liftMap W u h₁ h₂)).op
                          (β.app (Opposite.op (liftObj W X₂.unop h₂)) (f ⟨h₂⟩)) :=
                      ConcreteCategory.congr_hom (β.naturality (liftMap W u h₁ h₂).op) (f ⟨h₂⟩)
                    rw [hnat]
                    have hcomm : (κ_iso W X₁.unop h₁).inv ≫
                        (M_open W).map (liftMap W u h₁ h₂) =
                        u ≫ (κ_iso W X₂.unop h₂).inv := by
                      apply CategoryTheory.MorphismProperty.Over.Hom.ext
                      change 𝟙 X₁.unop.left ≫ u.left = u.left ≫ 𝟙 X₂.unop.left
                      simp
                    have hcomm_op : ((M_open W).map (liftMap W u h₁ h₂)).op ≫
                        (κ_iso W X₁.unop h₁).inv.op =
                        (κ_iso W X₂.unop h₂).inv.op ≫ u.op := by
                      rw [← CategoryTheory.op_comp, ← CategoryTheory.op_comp, hcomm]
                    calc
                      Q.map (κ_iso W X₁.unop h₁).inv.op
                          (Q.map ((M_open W).map (liftMap W u h₁ h₂)).op
                            (β.app (Opposite.op (liftObj W X₂.unop h₂)) (f ⟨h₂⟩)))
                        = (Q.map ((M_open W).map (liftMap W u h₁ h₂)).op ≫
                            Q.map (κ_iso W X₁.unop h₁).inv.op)
                            (β.app (Opposite.op (liftObj W X₂.unop h₂)) (f ⟨h₂⟩)) := rfl
                      _ = Q.map (((M_open W).map (liftMap W u h₁ h₂)).op ≫
                            (κ_iso W X₁.unop h₁).inv.op)
                            (β.app (Opposite.op (liftObj W X₂.unop h₂)) (f ⟨h₂⟩)) := by
                          rw [← Q.map_comp]
                      _ = Q.map ((κ_iso W X₂.unop h₂).inv.op ≫ u.op)
                            (β.app (Opposite.op (liftObj W X₂.unop h₂)) (f ⟨h₂⟩)) := by
                          rw [hcomm_op]
                      _ = Q.map u.op
                            (Q.map (κ_iso W X₂.unop h₂).inv.op
                              (β.app (Opposite.op (liftObj W X₂.unop h₂)) (f ⟨h₂⟩))) := by
                          rw [Q.map_comp]; rfl
                  · rw [dif_neg h₂, map_zero]
                    by_cases h₁ : P_W W X₁.unop
                    · rw [dif_pos h₁, dif_neg h₂, map_zero, map_zero]
                    · rw [dif_neg h₁] }
            left_inv := fun α => by
              apply NatTrans.ext
              funext X
              apply mod_hom_ext
              intro f
              let T := X.unop
              change (if hT : P_W W T then
                  Q.map (κ_iso W T hT).inv.op
                    (α.app (Opposite.op ((M_open W).obj (liftObj W T hT)))
                      (embed_V W P (liftObj W T hT) (f ⟨hT⟩)))
                else 0) = α.app X f
              by_cases hT : P_W W T
              · rw [dif_pos hT]
                have hnat : Q.map (κ_iso W T hT).inv.op
                    (α.app (Opposite.op ((M_open W).obj (liftObj W T hT)))
                      (embed_V W P (liftObj W T hT) (f ⟨hT⟩))) =
                    α.app (Opposite.op T)
                      (((j_pSh W).obj P).map (κ_iso W T hT).inv.op
                        (embed_V W P (liftObj W T hT) (f ⟨hT⟩))) :=
                  (ConcreteCategory.congr_hom
                    (α.naturality (κ_iso W T hT).inv.op)
                    (embed_V W P (liftObj W T hT) (f ⟨hT⟩))).symm
                change Q.map (κ_iso W T hT).inv.op
                    (α.app (Opposite.op ((M_open W).obj (liftObj W T hT)))
                      (embed_V W P (liftObj W T hT) (f ⟨hT⟩))) =
                  α.app (Opposite.op T) f
                rw [hnat]
                congr 1
                funext ⟨h₁⟩
                have hmem := hP_mem W (liftObj W T hT)
                change (if h₂ : P_W W ((M_open W).obj (liftObj W T hT)) then
                    P.map (liftMap W (κ_iso W T hT).inv h₁ h₂).op
                      (P.map (ρ_iso W (liftObj W T hT)).hom.op (f ⟨hT⟩))
                  else 0) = f ⟨h₁⟩
                rw [dif_pos hmem]
                have hid : liftMap W (κ_iso W T hT).inv hT hmem ≫
                    (ρ_iso W (liftObj W T hT)).hom = 𝟙 (liftObj W T hT) := by
                  apply CategoryTheory.MorphismProperty.Over.Hom.ext
                  change 𝟙 T.left ≫ 𝟙 T.left = 𝟙 T.left
                  simp
                have hid_op : (ρ_iso W (liftObj W T hT)).hom.op ≫
                    (liftMap W (κ_iso W T hT).inv h₁ hmem).op =
                    𝟙 (Opposite.op (liftObj W T hT)) := by
                  change (ρ_iso W (liftObj W T hT)).hom.op ≫
                    (liftMap W (κ_iso W T hT).inv hT hmem).op = _
                  rw [← CategoryTheory.op_comp, hid, CategoryTheory.op_id]
                calc
                  P.map (liftMap W (κ_iso W T hT).inv h₁ hmem).op
                      (P.map (ρ_iso W (liftObj W T hT)).hom.op (f ⟨hT⟩))
                    = P.map ((ρ_iso W (liftObj W T hT)).hom.op ≫
                        (liftMap W (κ_iso W T hT).inv h₁ hmem).op) (f ⟨hT⟩) := by
                      rw [P.map_comp]; rfl
                  _ = P.map (𝟙 _) (f ⟨hT⟩) := by rw [hid_op]
                  _ = f ⟨h₁⟩ := by rw [P.map_id]; rfl
              · rw [dif_neg hT]
                have hf0 : f = 0 := by funext ⟨h⟩; exact (hT h).elim
                rw [hf0, mod_map_zero]
            right_inv := fun β => by
              apply NatTrans.ext
              funext X
              apply mod_hom_ext
              intro x
              let V := X.unop
              have hmem := hP_mem W V
              change (if hT : P_W W ((M_open W).obj V) then
                  Q.map (κ_iso W ((M_open W).obj V) hT).inv.op
                    (β.app (Opposite.op (liftObj W ((M_open W).obj V) hT))
                      (P.map (ρ_iso W V).hom.op x))
                else 0) = β.app (Opposite.op V) x
              rw [dif_pos hmem]
              have hnat : β.app (Opposite.op (liftObj W ((M_open W).obj V) hmem))
                  (P.map (ρ_iso W V).hom.op x) =
                  Q.map ((M_open W).map (ρ_iso W V).hom).op (β.app (Opposite.op V) x) :=
                ConcreteCategory.congr_hom (β.naturality (ρ_iso W V).hom.op) x
              rw [hnat]
              have hid : (κ_iso W ((M_open W).obj V) hmem).inv ≫
                  (M_open W).map (ρ_iso W V).hom = 𝟙 ((M_open W).obj V) := by
                apply CategoryTheory.MorphismProperty.Over.Hom.ext
                change 𝟙 V.left ≫ 𝟙 V.left = 𝟙 V.left
                simp
              have hid_op : ((M_open W).map (ρ_iso W V).hom).op ≫
                  (κ_iso W ((M_open W).obj V) hmem).inv.op =
                  𝟙 (Opposite.op ((M_open W).obj V)) := by
                rw [← CategoryTheory.op_comp, hid, CategoryTheory.op_id]
              calc
                Q.map (κ_iso W ((M_open W).obj V) hmem).inv.op
                    (Q.map ((M_open W).map (ρ_iso W V).hom).op (β.app (Opposite.op V) x))
                  = Q.map (((M_open W).map (ρ_iso W V).hom).op ≫
                      (κ_iso W ((M_open W).obj V) hmem).inv.op) (β.app (Opposite.op V) x) := by
                    rw [Q.map_comp]; rfl
                _ = Q.map (𝟙 (Opposite.op ((M_open W).obj V))) (β.app (Opposite.op V) x) := by
                    rw [hid_op]
                _ = β.app (Opposite.op V) x := by rw [Q.map_id]; rfl }
        homEquiv_naturality_left_symm := fun {P' P Q} f' g => by
          apply NatTrans.ext
          funext X
          apply mod_hom_ext
          intro x
          change (if hT : P_W W X.unop then
              Q.map (κ_iso W X.unop hT).inv.op
                ((f' ≫ g).app (Opposite.op (liftObj W X.unop hT)) (x ⟨hT⟩))
            else 0) =
            if hT : P_W W X.unop then
              Q.map (κ_iso W X.unop hT).inv.op
                (g.app (Opposite.op (liftObj W X.unop hT))
                  (f'.app (Opposite.op (liftObj W X.unop hT)) (x ⟨hT⟩)))
            else 0
          by_cases hT : P_W W X.unop
          · rw [dif_pos hT, dif_pos hT]; rfl
          · rw [dif_neg hT, dif_neg hT]
        homEquiv_naturality_right := fun {P Q Q'} f g' => by
          apply NatTrans.ext
          funext X
          apply mod_hom_ext
          intro x
          rfl }

  
  have hLim_pSh : ∀ W : Y.Opens, CategoryTheory.Limits.PreservesFiniteLimits (j_pSh W) := by
    intro W
    apply CategoryTheory.preservesFiniteLimits_of_evaluation (j_pSh W)
    intro X
    let T := X.unop
    let E_T := (j_pSh W).comp ((CategoryTheory.evaluation _ _).obj X)
    change CategoryTheory.Limits.PreservesFiniteLimits E_T
    by_cases hT : P_W W T
    · let ev_W := (CategoryTheory.evaluation (W.toScheme.Etale)ᵒᵖ (ModuleCat.{u, u} R)).obj
        (Opposite.op (liftObj W T hT))
      let e_ev : ev_W ≅ E_T :=
        { hom :=
            { app := fun P =>
                ModuleCat.ofHom
                  { toFun := fun x _ => x
                    map_add' := fun _ _ => rfl
                    map_smul' := fun _ _ => rfl }
              naturality := fun _ _ _ => by apply mod_hom_ext; intro _; rfl }
          inv :=
            { app := fun P =>
                ModuleCat.ofHom
                  { toFun := fun f => f ⟨hT⟩
                    map_add' := fun _ _ => rfl
                    map_smul' := fun _ _ => rfl }
              naturality := fun _ _ _ => by apply mod_hom_ext; intro _; rfl }
          hom_inv_id := by
            apply NatTrans.ext; funext P; apply mod_hom_ext; intro x; rfl
          inv_hom_id := by
            apply NatTrans.ext; funext P; apply mod_hom_ext; intro f; funext ⟨_⟩; rfl }
      exact CategoryTheory.Limits.preservesFiniteLimits_of_natIso e_ev
    · have hZero : CategoryTheory.Limits.IsZero E_T := by
        rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
        apply NatTrans.ext
        funext P
        apply mod_hom_ext
        intro f
        funext ⟨h⟩
        exact (hT h).elim
      have : CategoryTheory.Limits.PreservesLimitsOfSize.{0, 0} E_T :=
        @CategoryTheory.Functor.preservesLimitsOfSize_of_isZero.{0, 0} _ _ _ _ _ _ E_T hZero
      infer_instance

  let F_sh := CategoryTheory.presheafToSheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)
  let adj_sh := CategoryTheory.sheafificationAdjunction Y.smallEtaleTopology (ModuleCat.{u, u} R)

  let j_ext (W : Y.Opens) :
      CategoryTheory.Sheaf W.toScheme.smallEtaleTopology (ModuleCat.{u, u} R) ⥤
        CategoryTheory.Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R) :=
    ((CategoryTheory.sheafToPresheaf W.toScheme.smallEtaleTopology (ModuleCat.{u, u} R)).comp
      (j_pSh W)).comp F_sh

  let core_ext (W : Y.Opens) : CategoryTheory.Adjunction.CoreHomEquiv (j_ext W) (j_res W) :=
    { homEquiv := fun ℰ ℱ =>
        (adj_sh.homEquiv
          (((CategoryTheory.sheafToPresheaf W.toScheme.smallEtaleTopology
            (ModuleCat.{u, u} R)).comp (j_pSh W)).obj ℰ) ℱ).trans
          (((adj_pSh W).homEquiv ℰ.obj ℱ.obj).trans
            { toFun := fun β => { hom := β }
              invFun := fun γ => γ.hom
              left_inv := fun _ => rfl
              right_inv := fun _ => rfl })
      homEquiv_naturality_left_symm := fun {ℰ' ℰ ℱ} f' g => by
        have h₁ : ((adj_pSh W).homEquiv ℰ'.obj ℱ.obj).symm (f'.hom ≫ g.hom) =
            (j_pSh W).map f'.hom ≫ ((adj_pSh W).homEquiv ℰ.obj ℱ.obj).symm g.hom :=
          (adj_pSh W).homEquiv_naturality_left_symm f'.hom g.hom
        have h₂ := adj_sh.homEquiv_naturality_left_symm ((j_pSh W).map f'.hom)
          (((adj_pSh W).homEquiv ℰ.obj ℱ.obj).symm g.hom)
        exact (congrArg (adj_sh.homEquiv ((j_pSh W).obj ℰ'.obj) ℱ).symm h₁).trans h₂
      homEquiv_naturality_right := fun {ℰ ℱ ℱ'} f g' => by
        apply Sheaf.hom_ext
        have h₁ := adj_sh.homEquiv_naturality_right f g'
        have h₂ := (adj_pSh W).homEquiv_naturality_right
          ((adj_sh.homEquiv _ ℱ) f) g'.hom
        exact (congrArg ((adj_pSh W).homEquiv ℰ.obj ℱ'.obj) h₁).trans h₂ }

  let adj_ext (W : Y.Opens) : j_ext W ⊣ j_res W :=
    CategoryTheory.Adjunction.mkOfHomEquiv (core_ext W)

  have hEx_ext : ∀ W : Y.Opens,
      (j_ext W).Additive ∧
      CategoryTheory.Limits.PreservesFiniteLimits (j_ext W) ∧
      CategoryTheory.Limits.PreservesFiniteColimits (j_ext W) := by
    intro W
    have : CategoryTheory.Limits.PreservesFiniteLimits (j_pSh W) := hLim_pSh W
    have : CategoryTheory.Limits.PreservesFiniteLimits
        ((CategoryTheory.sheafToPresheaf W.toScheme.smallEtaleTopology
          (ModuleCat.{u, u} R)).comp (j_pSh W)) :=
      CategoryTheory.Limits.comp_preservesFiniteLimits _ _
    have hLim : CategoryTheory.Limits.PreservesFiniteLimits (j_ext W) :=
      CategoryTheory.Limits.comp_preservesFiniteLimits _ _
    have : CategoryTheory.Limits.PreservesColimitsOfSize.{0, 0} (j_ext W) :=
      @CategoryTheory.Adjunction.leftAdjoint_preservesColimits.{0, 0} _ _ _ _ _ _ (adj_ext W)
    have hColim : CategoryTheory.Limits.PreservesFiniteColimits (j_ext W) := inferInstance
    have : CategoryTheory.Limits.PreservesBinaryBiproducts (j_ext W) :=
      CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryProducts (j_ext W)
    have hAdd : (j_ext W).Additive :=
      CategoryTheory.Functor.additive_of_preservesBinaryBiproducts (j_ext W)
    exact ⟨hAdd, hLim, hColim⟩

  
  let S_sub (ℋ : CategoryTheory.Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R))
      (W : Y.Opens) : (Y.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R :=
    { obj := fun X => ModuleCat.of R (∀ _ : PLift (P_W W X.unop), ℋ.obj.obj X)
      map := fun {X₂ X₁} f_op =>
        ModuleCat.ofHom
          { toFun := fun g ⟨_⟩ =>
              if h₂ : P_W W X₂.unop then ℋ.obj.map f_op (g ⟨h₂⟩) else 0
            map_add' := fun f g => by
              funext ⟨_⟩
              by_cases h₂ : P_W W X₂.unop
              · simp [dif_pos h₂]
              · simp [dif_neg h₂]
            map_smul' := fun r f => by
              funext ⟨_⟩
              by_cases h₂ : P_W W X₂.unop
              · simp [dif_pos h₂]
              · simp [dif_neg h₂] }
      map_id := fun X => by
        apply mod_hom_ext; intro g; funext ⟨h₁⟩
        change (if h₂ : P_W W X.unop then ℋ.obj.map (𝟙 X) (g ⟨h₂⟩) else 0) = g ⟨h₁⟩
        rw [dif_pos h₁, ℋ.obj.map_id]; rfl
      map_comp := fun {X₃ X₂ X₁} f_op g_op => by
        apply mod_hom_ext; intro g; funext ⟨_⟩
        change (if h₃ : P_W W X₃.unop then ℋ.obj.map (f_op ≫ g_op) (g ⟨h₃⟩) else 0) =
          if h₂ : P_W W X₂.unop then
            ℋ.obj.map g_op (if h₃ : P_W W X₃.unop then ℋ.obj.map f_op (g ⟨h₃⟩) else 0)
          else 0
        by_cases h₃ : P_W W X₃.unop
        · have h₂ : P_W W X₂.unop := hP_map W f_op.unop h₃
          rw [dif_pos h₃, dif_pos h₂, dif_pos h₃, ℋ.obj.map_comp]; rfl
        · rw [dif_neg h₃]
          by_cases h₂ : P_W W X₂.unop
          · rw [dif_pos h₂, dif_neg h₃, map_zero]
          · rw [dif_neg h₂] }

  let Θ_iso (ℋ : CategoryTheory.Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R))
      (W : Y.Opens) : (j_pSh W).obj (((j_res W).obj ℋ).obj) ≅ S_sub ℋ W :=
    CategoryTheory.NatIso.ofComponents
      (fun X =>
        { hom := ModuleCat.ofHom
            { toFun := fun f ⟨hT⟩ =>
                ℋ.obj.map (κ_iso W X.unop hT).inv.op (f ⟨hT⟩)
              map_add' := fun f g => by
                funext ⟨hT⟩
                exact mod_map_add (ℋ.obj.map (κ_iso W X.unop hT).inv.op) (f ⟨hT⟩) (g ⟨hT⟩)
              map_smul' := fun r f => by
                funext ⟨hT⟩
                exact mod_map_smul (ℋ.obj.map (κ_iso W X.unop hT).inv.op) r (f ⟨hT⟩) }
          inv := ModuleCat.ofHom
            { toFun := fun g ⟨hT⟩ =>
                ℋ.obj.map (κ_iso W X.unop hT).hom.op (g ⟨hT⟩)
              map_add' := fun f g => by
                funext ⟨hT⟩
                exact mod_map_add (ℋ.obj.map (κ_iso W X.unop hT).hom.op) (f ⟨hT⟩) (g ⟨hT⟩)
              map_smul' := fun r f => by
                funext ⟨hT⟩
                exact mod_map_smul (ℋ.obj.map (κ_iso W X.unop hT).hom.op) r (f ⟨hT⟩) }
          hom_inv_id := by
            apply mod_hom_ext; intro f; funext ⟨hT⟩
            change ℋ.obj.map (κ_iso W X.unop hT).hom.op
                (ℋ.obj.map (κ_iso W X.unop hT).inv.op (f ⟨hT⟩)) = f ⟨hT⟩
            have hid : (κ_iso W X.unop hT).inv.op ≫ (κ_iso W X.unop hT).hom.op =
                𝟙 (Opposite.op ((M_open W).obj (liftObj W X.unop hT))) := by
              rw [← CategoryTheory.op_comp, (κ_iso W X.unop hT).hom_inv_id, CategoryTheory.op_id]
            have h1 : ℋ.obj.map (κ_iso W X.unop hT).hom.op
                (ℋ.obj.map (κ_iso W X.unop hT).inv.op (f ⟨hT⟩)) =
                ℋ.obj.map ((κ_iso W X.unop hT).inv.op ≫
                  (κ_iso W X.unop hT).hom.op) (f ⟨hT⟩) := by
              rw [ℋ.obj.map_comp]; rfl
            rw [h1, hid, ℋ.obj.map_id]; rfl
          inv_hom_id := by
            apply mod_hom_ext; intro g; funext ⟨hT⟩
            change ℋ.obj.map (κ_iso W X.unop hT).inv.op
                (ℋ.obj.map (κ_iso W X.unop hT).hom.op (g ⟨hT⟩)) = g ⟨hT⟩
            have hid : (κ_iso W X.unop hT).hom.op ≫ (κ_iso W X.unop hT).inv.op =
                𝟙 (Opposite.op X.unop) := by
              rw [← CategoryTheory.op_comp, (κ_iso W X.unop hT).inv_hom_id, CategoryTheory.op_id]
            have h1 : ℋ.obj.map (κ_iso W X.unop hT).inv.op
                (ℋ.obj.map (κ_iso W X.unop hT).hom.op (g ⟨hT⟩)) =
                ℋ.obj.map ((κ_iso W X.unop hT).hom.op ≫
                  (κ_iso W X.unop hT).inv.op) (g ⟨hT⟩) := by
              rw [ℋ.obj.map_comp]; rfl
            rw [h1, hid, ℋ.obj.map_id]; rfl })
      (fun {X₂ X₁} f_op => by
        apply mod_hom_ext; intro f; funext ⟨h₁⟩
        let u := f_op.unop
        change ℋ.obj.map (κ_iso W X₁.unop h₁).inv.op
            (if h₂ : P_W W X₂.unop then
              ℋ.obj.map ((M_open W).map (liftMap W u h₁ h₂)).op (f ⟨h₂⟩) else 0) =
          if h₂ : P_W W X₂.unop then
            ℋ.obj.map f_op (ℋ.obj.map (κ_iso W X₂.unop h₂).inv.op (f ⟨h₂⟩))
          else 0
        by_cases h₂ : P_W W X₂.unop
        · rw [dif_pos h₂, dif_pos h₂]
          have hcomm : (κ_iso W X₁.unop h₁).inv ≫ (M_open W).map (liftMap W u h₁ h₂) =
              u ≫ (κ_iso W X₂.unop h₂).inv := by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            change 𝟙 X₁.unop.left ≫ u.left = u.left ≫ 𝟙 X₂.unop.left
            simp
          have hcomm_op : ((M_open W).map (liftMap W u h₁ h₂)).op ≫
              (κ_iso W X₁.unop h₁).inv.op =
              (κ_iso W X₂.unop h₂).inv.op ≫ f_op := by
            change _ = (κ_iso W X₂.unop h₂).inv.op ≫ u.op
            rw [← CategoryTheory.op_comp, ← CategoryTheory.op_comp, hcomm]
          calc
            ℋ.obj.map (κ_iso W X₁.unop h₁).inv.op
                (ℋ.obj.map ((M_open W).map (liftMap W u h₁ h₂)).op (f ⟨h₂⟩))
              = ℋ.obj.map (((M_open W).map (liftMap W u h₁ h₂)).op ≫
                  (κ_iso W X₁.unop h₁).inv.op) (f ⟨h₂⟩) := by rw [ℋ.obj.map_comp]; rfl
            _ = ℋ.obj.map ((κ_iso W X₂.unop h₂).inv.op ≫ f_op) (f ⟨h₂⟩) := by rw [hcomm_op]
            _ = ℋ.obj.map f_op (ℋ.obj.map (κ_iso W X₂.unop h₂).inv.op (f ⟨h₂⟩)) := by
                rw [ℋ.obj.map_comp]; rfl
        · rw [dif_neg h₂, dif_neg h₂, map_zero])

  let ι_sub (ℋ : CategoryTheory.Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R))
      {W₁ W₂ : Y.Opens} (h : W₁ ≤ W₂) : S_sub ℋ W₁ ⟶ S_sub ℋ W₂ :=
    { app := fun X =>
        ModuleCat.ofHom
