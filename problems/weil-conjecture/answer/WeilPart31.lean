      rw [htr_η, add_zero]
      have hfin_eq : Module.finrank L' ↥(T.maxGenEigenspace μ) = Multiset.count μ T.charpoly.roots := by
        rw [Polynomial.count_roots]
        exact LinearMap.finrank_maxGenEigenspace_eq T μ
      rw [hfin_eq, nsmul_eq_mul, smul_eq_mul, mul_comm]
    intro K _ m B
    have hPart1 : ∀ (L' : Type) [Field L'] [IsAlgClosed L'] [Algebra K L'] (r : ℕ),
