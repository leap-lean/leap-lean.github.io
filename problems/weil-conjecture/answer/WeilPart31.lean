              have hk_ev : ((α₁ ≫ g_sub₁ + α₂ ≫ g_sub₂).app X k) ⟨hu⟩ = 0 := by
                rw [hker]; rfl
              change (if h₁' : P_W W₁ X.unop then α₁.app X k ⟨h₁'⟩ else 0) +
                (if h₂' : P_W W₂ X.unop then α₂.app X k ⟨h₂'⟩ else 0) = 0 at hk_ev
              rw [dif_pos h₁, dif_neg h₂, add_zero] at hk_ev
              exact hk_ev.symm
          · rw [Category.assoc, CategoryTheory.Limits.biprod.lift_snd,
