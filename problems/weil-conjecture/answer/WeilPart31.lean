        let w_ker : ∀ w : ↑((C₀ 0).obj F), ↥(LinearMap.ker (((d_C₀ 0).app F).hom)) :=
          fun w => ⟨w, by change (((d_C₀ 0).app F).hom) w = 0; rw [hDC_top₀ F]; rfl⟩
        let φ_C : ↑((C₀ 0).obj F) →+ ZMod n :=
