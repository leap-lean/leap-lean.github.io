            homToSec W F (secToHom W F sec) = sec := by
          intro W F sec
          dsimp [homToSec, secToHom]
          rw [Equiv.apply_symm_apply]
          have h_counit := Equiv.apply_symm_apply
            (AddCommGrpCat.adj.homEquiv (W ⟶ W) (F.obj.obj (Opposite.op W)))
