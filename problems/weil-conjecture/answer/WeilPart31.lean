        | succ q' =>
          have : Subsingleton (CategoryTheory.Abelian.Ext.{u} A (B k) (q' + 1)) :=
            hB_van k (le_refl k) (q' + 1) (by omega) (by omega)
          refine ⟨fun x₁ x₂ => ?_⟩
          suffices h0 : ∀ x : CategoryTheory.Abelian.Ext.{u} A one₀ (q' + 1), x = 0 by
            rw [h0 x₁, h0 x₂]
          intro x
          have hid : x = (x.comp (CategoryTheory.Abelian.Ext.mk₀ e_dual) (Nat.add_zero (q' + 1))).comp
              (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv e_dual)) (Nat.add_zero (q' + 1)) := by
            rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _
              (Nat.add_zero (q' + 1)) (Nat.add_zero 0) (by omega),
              CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.hom_inv_id,
              CategoryTheory.Abelian.Ext.comp_mk₀_id]
          rw [hid, Subsingleton.elim (x.comp (CategoryTheory.Abelian.Ext.mk₀ e_dual) _) 0,
            CategoryTheory.Abelian.Ext.zero_comp]
      let K0 : ∀ G : 𝒞₀, Submodule R ↑((C₀ 0).obj G) :=
        fun G => LinearMap.ker (((d_C₀ 0).app G).hom)
      let eΥ0 : ∀ G : 𝒞₀, ↥(K0 G) ≃+ CategoryTheory.Abelian.Ext.{u} one₀ G 0 :=
        fun G => AddEquiv.ofBijective (Υ₀ G 0) ⟨hΥ_inj0₀ G, hΥ_surj₀ 0 G⟩
      let Ω₀ : ∀ G : 𝒞₀, (G ⟶ 𝒥₀ 0) →+ CategoryTheory.Abelian.Ext.{u} G (B 0) 1 :=
        fun G => AddMonoidHom.mk'
          (fun f => (CategoryTheory.Abelian.Ext.mk₀ f).comp ε₀ (Nat.zero_add 1))
          (fun f₁ f₂ => by rw [CategoryTheory.Abelian.Ext.mk₀_add, CategoryTheory.Abelian.Ext.add_comp])
      let Θ₀ : ∀ G : 𝒞₀, (G ⟶ 𝒥₀ 0) →+
          (CategoryTheory.Abelian.Ext.{u} one₀ G 0 →+ ZMod n) :=
        fun G => AddMonoidHom.mk'
          (fun f => AddMonoidHom.mk'
            (fun α => ((((Ψ₀ 0 G).symm f) ((eΥ0 G).symm α).1).down))
            (fun α₁ α₂ => by
              have h1 : ((eΥ0 G).symm (α₁ + α₂)).1 =
                  ((eΥ0 G).symm α₁).1 + ((eΥ0 G).symm α₂).1 :=
                congrArg Subtype.val (map_add (eΥ0 G).symm α₁ α₂)
              rw [h1, map_add]
              rfl))
          (fun f₁ f₂ => by
            ext α
            change ((((Ψ₀ 0 G).symm (f₁ + f₂)) ((eΥ0 G).symm α).1).down) = _
            rw [hΨ_symm_add]
            rfl)
      have hΩ₀_surj : ∀ G : 𝒞₀, Function.Surjective (Ω₀ G) := by
        intro G y
        have := hInjExt 1 1 (le_refl 1) G
        have hy0 : y.comp (CategoryTheory.Abelian.Ext.mk₀ SC₀.f) (Nat.add_zero 1) = 0 :=
          Subsingleton.elim _ _
        obtain ⟨x₀, hx₀⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
          G hSC₀ y hy0 (Nat.zero_add 1)
        let f : G ⟶ 𝒥₀ 0 := CategoryTheory.Abelian.Ext.addEquiv₀ x₀
        have hf_mk : CategoryTheory.Abelian.Ext.mk₀ f = x₀ :=
          CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply x₀
        exact ⟨f, by change (CategoryTheory.Abelian.Ext.mk₀ f).comp ε₀ (Nat.zero_add 1) = y; rwa [hf_mk]⟩
      have hΘ₀_surj : ∀ (G : 𝒞₀) (φ : CategoryTheory.Abelian.Ext.{u} one₀ G 0 →+ ZMod n),
