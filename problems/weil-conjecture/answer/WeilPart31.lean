              invFun := fun k =>
                (U_equiv (P_pull_mod.obj ℱ) 𝒢).symm
                  (e_pull_U.hom.app ℱ ≫
                    (adj_ab.homEquiv ((U_fun Y).obj ℱ) ((U_fun Z).obj 𝒢)).symm
                      ((U_fun Y).map k ≫ e_push_U.inv.app 𝒢))
              left_inv := fun f => by
                apply (U_equiv (P_pull_mod.obj ℱ) 𝒢).injective
                change (U_equiv (P_pull_mod.obj ℱ) 𝒢) _ = (U_fun Z).map f
                rw [(U_equiv (P_pull_mod.obj ℱ) 𝒢).apply_symm_apply]
                have h1 : (U_fun Y).map ((U_equiv ℱ (i_push.obj 𝒢)).symm
