        obtain ⟨d, v, hv_open, hw_mem⟩ := hShrinkAff W (δ.1 (⊥ : PrimeSpectrum Ω))
        have := hv_open
        obtain ⟨δ_d, hδ_d⟩ := hLiftOpenGeom v.left δ.1 hw_mem
        refine ⟨⟨d, ⟨δ_d, ?_⟩⟩, v, hδ_d⟩
        exact (congrArg (CategoryTheory.CategoryStruct.comp δ_d)
          (CategoryTheory.MorphismProperty.Over.w v).symm).trans
          ((CategoryTheory.Category.assoc δ_d v.left W.hom).symm.trans
            ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k W.hom) hδ_d).trans δ.2))
      obtain ⟨A₀, v₀, hv₀_fac⟩ := hRefine W₀ ⟨δ₀, rfl⟩
      have : Nonempty StalkObj := ⟨A₀⟩
      have : CategoryTheory.IsFilteredOrEmpty StalkObj :=
        { cocone_objs := fun A₁ A₂ => by
            have : AlgebraicGeometry.Etale (G_aff.obj A₁.1).hom := (G_aff.obj A₁.1).prop
            have : AlgebraicGeometry.Etale (G_aff.obj A₂.1).hom := (G_aff.obj A₂.1).prop
            let p₁ := CategoryTheory.Limits.pullback.fst (G_aff.obj A₁.1).hom (G_aff.obj A₂.1).hom
            let p₂ := CategoryTheory.Limits.pullback.snd (G_aff.obj A₁.1).hom (G_aff.obj A₂.1).hom
            let P_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
              (CategoryTheory.CategoryStruct.comp p₁ (G_aff.obj A₁.1).hom) inferInstance
            let π₁ : Quiver.Hom P_et (G_aff.obj A₁.1) :=
              CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
            let π₂ : Quiver.Hom P_et (G_aff.obj A₂.1) :=
              CategoryTheory.MorphismProperty.Over.homMk p₂
                CategoryTheory.Limits.pullback.condition.symm trivial
