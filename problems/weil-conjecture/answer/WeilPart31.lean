    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) s_UF :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g_UF :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) g_UF :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    letI := τ_V.hCont
    letI := τ_UF.hCont
    letI := hCont_gUF
    let B_γV : CategoryTheory.Functor V.Etale Z_V.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ γ_V
    let B_sUF : CategoryTheory.Functor U_F.Etale S_k.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ s_UF
    let B_gUF : CategoryTheory.Functor V.Etale U_F.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g_UF
    let γV_push := B_γV.sheafPushforwardContinuous (ModuleCat.{u, u} R_r)
      V.smallEtaleTopology Z_V.smallEtaleTopology
    let sUF_push := B_sUF.sheafPushforwardContinuous (ModuleCat.{u, u} R_r)
      U_F.smallEtaleTopology S_k.smallEtaleTopology
    let gUF_push := B_gUF.sheafPushforwardContinuous (ModuleCat.{u, u} R_r)
      V.smallEtaleTopology U_F.smallEtaleTopology
