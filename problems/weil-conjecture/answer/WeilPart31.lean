    let One_ZV := (CategoryTheory.constantSheaf Z_V.smallEtaleTopology (ModuleCat.{u, u} R_r)).obj Rr_mod
    let One_UF := (CategoryTheory.constantSheaf U_F.smallEtaleTopology (ModuleCat.{u, u} R_r)).obj Rr_mod
    let One_Sk := (CategoryTheory.constantSheaf S_k.smallEtaleTopology (ModuleCat.{u, u} R_r)).obj Rr_mod
    let adj_V := CategoryTheory.constantSheafAdj V.smallEtaleTopology (ModuleCat.{u, u} R_r) hT_V
    let adj_UF := CategoryTheory.constantSheafAdj U_F.smallEtaleTopology (ModuleCat.{u, u} R_r) hT_UF
    let π_V : Quiver.Hom (P_pull.obj One_V) One_UF :=
      (adj_pull.homEquiv One_V One_UF).symm
        ((adj_V.homEquiv Rr_mod (gUF_push.obj One_UF)).symm
          (CategoryTheory.CategoryStruct.comp (adj_UF.unit.app Rr_mod)
            (One_UF.obj.map (Opposite.op (hT_UF.from (B_gUF.obj T_V))))))
    let pull_gUF : weilGysinSupportExtGroup τ_V →+ weilGysinSupportExtGroup τ_UF :=
      ((CategoryTheory.Abelian.Ext.mk₀ π_V).postcomp
        (sUF_push.obj One_Sk) (Nat.add_zero (2 * b))).comp
        (((CategoryTheory.Abelian.Ext.mk₀ β_g).precomp
          (P_pull.obj One_V) (Nat.zero_add (2 * b))).comp
          (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull
