  have : U_Z.Faithful := ff_UZ.faithful

  obtain ⟨hCont_ab, P_pull, adj_pull, hAddP, hLimP, hColimP, T_Z_p, hT_Z_p, T_Y_p, hT_Y_p,
      ιℤ_p, hι₁_p, hι₂_p, hp_i_eq⟩ := hp_i
  have hCont_eq : hCont_ab = τ_Y.hCont := Subsingleton.elim _ _
  subst hCont_eq
  have := hAddP; have := hLimP; have := hColimP
  let P_push := B_i.sheafPushforwardContinuous AddCommGrpCat.{u}
    Y.smallEtaleTopology Z.smallEtaleTopology

  
  have hm_R_zero : (m : R) = 0 := ULift.ext _ _ (CharP.cast_eq_zero (ZMod m) m)
  let uliftDownHom : R →+* ZMod m :=
    { toFun := ULift.down
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hm_id_zero : ∀ ℱ : Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R),
      m • (𝟙 ℱ : ℱ ⟶ ℱ) = 0 := by
    intro ℱ
    apply sheaf_hom_ext
    change (sheafToPresheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)).map (m • 𝟙 ℱ) =
      (sheafToPresheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)).map 0
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
        CategoryTheory.Functor.map_zero]
    ext V x
    simp [← Nat.cast_smul_eq_nsmul R m x]
  have hm_pull_zero : ∀ (ℱ : Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R))
      (W : (Z.Etale)ᵒᵖ) (y : (P_pull.obj (U_Y.obj ℱ)).obj.obj W),
      m • y = 0 := by
    intro ℱ W y
    let 𝒢 := P_pull.obj (U_Y.obj ℱ)
    have h𝒢0 : m • (𝟙 𝒢 : 𝒢 ⟶ 𝒢) = 0 := by
      dsimp only [𝒢]
      rw [← P_pull.map_id, ← P_pull.map_nsmul, ← U_Y.map_id, ← U_Y.map_nsmul,
          hm_id_zero ℱ, U_Y.map_zero, P_pull.map_zero]
    have hpre0 : (sheafToPresheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map
        (m • (𝟙 𝒢 : 𝒢 ⟶ 𝒢)) = 0 := by
      rw [h𝒢0, CategoryTheory.Functor.map_zero]
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id] at hpre0
    have happ0 := congrArg (fun φ : 𝒢.obj ⟶ 𝒢.obj => (φ.app W).hom y) hpre0
    simpa using happ0

  let liftModObj : ∀ (ℱ : Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)) (W : (Z.Etale)ᵒᵖ),
      ModuleCat.{u, u} R := fun ℱ W =>
    let G_W := (P_pull.obj (U_Y.obj ℱ)).obj.obj W
    letI : Module (ZMod m) ↑G_W := AddCommGroup.zmodModule (hm_pull_zero ℱ W)
    letI : Module R ↑G_W := Module.compHom ↑G_W uliftDownHom
    ModuleCat.of R ↑G_W
  let liftModIsoW : ∀ (ℱ : Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)) (W : (Z.Etale)ᵒᵖ),
      F_fg.obj (liftModObj ℱ W) ≅ (P_pull.obj (U_Y.obj ℱ)).obj.obj W := fun ℱ W =>
    { hom := AddCommGrpCat.ofHom (AddMonoidHom.id _)
      inv := AddCommGrpCat.ofHom (AddMonoidHom.id _)
      hom_inv_id := by ext x; rfl
      inv_hom_id := by ext x; rfl }
  let liftModPresheaf : Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R) →
      ((Z.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R) := fun ℱ =>
    { obj := fun W => liftModObj ℱ W
      map := fun {W₁ W₂} w =>
        ff_Ffg.preimage
          ((liftModIsoW ℱ W₁).hom ≫ (P_pull.obj (U_Y.obj ℱ)).obj.map w ≫ (liftModIsoW ℱ W₂).inv)
      map_id := fun W => ff_Ffg.map_injective (by simp)
      map_comp := fun {W₁ W₂ W₃} w₁ w₂ => ff_Ffg.map_injective (by
        simp [ff_Ffg.map_preimage]) }
  let liftModCompIso : ∀ ℱ : Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R),
      liftModPresheaf ℱ ⋙ F_fg ≅ (P_pull.obj (U_Y.obj ℱ)).obj := fun ℱ =>
    NatIso.ofComponents (fun W => liftModIsoW ℱ W) (fun {W₁ W₂} w => by
      dsimp [liftModPresheaf]
      rw [ff_Ffg.map_preimage]
      simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id])
  have hLiftIsSheaf : ∀ ℱ : Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R),
      Presheaf.IsSheaf Z.smallEtaleTopology (liftModPresheaf ℱ) := by
    intro ℱ
    apply Presheaf.isSheaf_of_isSheaf_comp Z.smallEtaleTopology (liftModPresheaf ℱ) F_fg
    exact (Presheaf.isSheaf_of_iso_iff (liftModCompIso ℱ)).mpr (P_pull.obj (U_Y.obj ℱ)).2
  let P_pull_R_obj : Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R) →
      Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} R) :=
    fun ℱ => ⟨liftModPresheaf ℱ, hLiftIsSheaf ℱ⟩
  let δ_iso : ∀ ℱ : Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R),
      U_Z.obj (P_pull_R_obj ℱ) ≅ P_pull.obj (U_Y.obj ℱ) := fun ℱ =>
    { hom := { hom := eqToHom (hUZ_obj (P_pull_R_obj ℱ)) ≫ (liftModCompIso ℱ).hom }
      inv := { hom := (liftModCompIso ℱ).inv ≫ eqToHom (hUZ_obj (P_pull_R_obj ℱ)).symm }
      hom_inv_id := sheaf_hom_ext (by simp)
      inv_hom_id := sheaf_hom_ext (by simp) }
  let P_pull_R : Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R) ⥤
      Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} R) :=
    { obj := P_pull_R_obj
      map := fun {ℱ₁ ℱ₂} f =>
        ff_UZ.preimage ((δ_iso ℱ₁).hom ≫ P_pull.map (U_Y.map f) ≫ (δ_iso ℱ₂).inv)
      map_id := fun ℱ => ff_UZ.map_injective (by simp)
      map_comp := fun {ℱ₁ ℱ₂ ℱ₃} f g => ff_UZ.map_injective (by
        simp [ff_UZ.map_preimage]) }
  let δ : P_pull_R ⋙ U_Z ≅ U_Y ⋙ P_pull :=
    NatIso.ofComponents (fun ℱ => δ_iso ℱ) (fun {ℱ₁ ℱ₂} f => by
      dsimp [P_pull_R]
      rw [ff_UZ.map_preimage]
      simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id])
  have hAdd_P_R : P_pull_R.Additive :=
    { map_add := fun {ℱ₁ ℱ₂} {f g} => ff_UZ.map_injective (by
        dsimp [P_pull_R]
        simp only [U_Z.map_add, ff_UZ.map_preimage, U_Y.map_add, P_pull.map_add,
          Preadditive.add_comp, Preadditive.comp_add]) }
  have := hAdd_P_R
  have hLim_comp_R : Limits.PreservesFiniteLimits (P_pull_R ⋙ U_Z) :=
    Limits.preservesFiniteLimits_of_natIso δ.symm
  have hColim_comp_R : Limits.PreservesFiniteColimits (P_pull_R ⋙ U_Z) :=
    Limits.preservesFiniteColimits_of_natIso δ.symm
  have hLim_P_R : Limits.PreservesFiniteLimits P_pull_R :=
    Limits.preservesFiniteLimits_of_reflects_of_preserves P_pull_R U_Z
  have hColim_P_R : Limits.PreservesFiniteColimits P_pull_R :=
    Limits.preservesFiniteColimits_of_reflects_of_preserves P_pull_R U_Z
  have := hLim_P_R; have := hColim_P_R

  
  have hT_BY : Limits.IsTerminal (B_i.obj T_Y_p) := by
    let e_TY : T_Y_p ≅ weilEtaleIdTerminal.{u} Y :=
      hT_Y_p.uniqueUpToIso (weilEtaleIdTerminalIsTerminal.{u} Y)
    let t_left : Scheme.{u} := T_Y_p.left
    let t_hom : t_left ⟶ Y := T_Y_p.hom
    let φ_hom : t_left ⟶ Y := e_TY.hom.left
    let φ_inv : Y ⟶ t_left := e_TY.inv.left
    have h_inv_hom : φ_inv ≫ t_hom = 𝟙 Y := MorphismProperty.Over.w e_TY.inv
    have h_hom_left : φ_hom = t_hom :=
      (Category.comp_id φ_hom).symm.trans (MorphismProperty.Over.w e_TY.hom)
    have h_comp_id : φ_hom ≫ φ_inv = 𝟙 t_left :=
      congrArg (fun f : T_Y_p ⟶ T_Y_p => (f.left : t_left ⟶ t_left)) e_TY.hom_inv_id
    have h_hom_inv : t_hom ≫ φ_inv = 𝟙 t_left := by
      rw [← h_hom_left]
      exact h_comp_id
    refine Limits.IsTerminal.ofUniqueHom
      (fun W =>
        let w_left : Scheme.{u} := W.left
        let w_hom : w_left ⟶ Z := W.hom
        let l_W : w_left ⟶ Limits.pullback t_hom i :=
          Limits.pullback.lift ((w_hom ≫ i) ≫ φ_inv) w_hom
            (by rw [Category.assoc, h_inv_hom, Category.comp_id])
        MorphismProperty.Over.homMk l_W (Limits.pullback.lift_snd _ _ _) trivial)
      (fun W m_hom =>
        let w_left : Scheme.{u} := W.left
        let w_hom : w_left ⟶ Z := W.hom
        let m_left : w_left ⟶ Limits.pullback t_hom i := m_hom.left
        have hw : m_left ≫ Limits.pullback.snd t_hom i = w_hom :=
          MorphismProperty.Over.w m_hom
        MorphismProperty.Comma.Hom.ext (by
          change m_left = Limits.pullback.lift ((w_hom ≫ i) ≫ φ_inv) w_hom _
          apply Limits.pullback.hom_ext
          · have h1 : (m_left ≫ Limits.pullback.fst t_hom i) ≫ t_hom = w_hom ≫ i := by
              rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hw]
            calc
              m_left ≫ Limits.pullback.fst t_hom i =
                (m_left ≫ Limits.pullback.fst t_hom i) ≫ 𝟙 t_left := (Category.comp_id _).symm
              _ = (m_left ≫ Limits.pullback.fst t_hom i) ≫ (t_hom ≫ φ_inv) := by rw [h_hom_inv]
              _ = ((m_left ≫ Limits.pullback.fst t_hom i) ≫ t_hom) ≫ φ_inv :=
                (Category.assoc _ _ _).symm
              _ = (w_hom ≫ i) ≫ φ_inv := by rw [h1]
              _ = _ := (Limits.pullback.lift_fst _ _ _).symm
          · exact hw.trans (Limits.pullback.lift_snd _ _ _).symm)
          (Subsingleton.elim _ _))

  let C_Y := constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}
  let C_Z := constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}
  let Fℤ_Y := C_Y.obj Aℤ
  let Fℤ_Z := C_Z.obj Aℤ
  let FM_Y := C_Y.obj AM
  let FM_Z := C_Z.obj AM
  let adj_Y_p := constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT_Y_p
  let adj_Z_p := constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT_Z_p
  let τ_p : B_i.obj T_Y_p ⟶ T_Z_p := hT_Z_p.from (B_i.obj T_Y_p)
  let τ_p_inv : T_Z_p ⟶ B_i.obj T_Y_p := hT_BY.from T_Z_p
  have hτ_p_id1 : τ_p ≫ τ_p_inv = 𝟙 (B_i.obj T_Y_p) := hT_BY.hom_ext _ _
  have hτ_p_id2 : τ_p_inv ≫ τ_p = 𝟙 T_Z_p := hT_Z_p.hom_ext _ _

  let adj_comp_p := adj_Y_p.comp adj_pull
  let G₁_sec := P_push ⋙ (sheafSections Y.smallEtaleTopology AddCommGrpCat.{u}).obj (Opposite.op T_Y_p)
  let G₂_sec := (sheafSections Z.smallEtaleTopology AddCommGrpCat.{u}).obj (Opposite.op T_Z_p)
  let ρ_sec : G₂_sec ≅ G₁_sec :=
    NatIso.ofComponents
      (fun 𝒢 =>
        { hom := (𝒢.obj.map τ_p.op : G₂_sec.obj 𝒢 ⟶ G₁_sec.obj 𝒢)
          inv := (𝒢.obj.map τ_p_inv.op : G₁_sec.obj 𝒢 ⟶ G₂_sec.obj 𝒢)
          hom_inv_id := by
            change 𝒢.obj.map τ_p.op ≫ 𝒢.obj.map τ_p_inv.op = 𝟙 (𝒢.obj.obj (Opposite.op T_Z_p))
            rw [← 𝒢.obj.map_comp, ← op_comp, hτ_p_id2, op_id, 𝒢.obj.map_id]
          inv_hom_id := by
            change 𝒢.obj.map τ_p_inv.op ≫ 𝒢.obj.map τ_p.op =
              𝟙 (𝒢.obj.obj (Opposite.op (B_i.obj T_Y_p)))
            rw [← 𝒢.obj.map_comp, ← op_comp, hτ_p_id1, op_id, 𝒢.obj.map_id] })
      (fun {𝒢₁ 𝒢₂} u => by
        dsimp [G₁_sec, G₂_sec, P_push, sheafSections]
        exact (u.hom.naturality τ_p.op).symm)
  let π_gen : ∀ A : AddCommGrpCat.{u}, P_pull.obj (C_Y.obj A) ⟶ C_Z.obj A := fun A =>
    (adj_pull.homEquiv (C_Y.obj A) (C_Z.obj A)).symm
      ((adj_Y_p.homEquiv A (P_push.obj (C_Z.obj A))).symm
        (adj_Z_p.unit.app A ≫ (C_Z.obj A).obj.map τ_p.op))
  let ι_gen : ∀ A : AddCommGrpCat.{u}, C_Z.obj A ⟶ P_pull.obj (C_Y.obj A) := fun A =>
    (adj_Z_p.homEquiv A (P_pull.obj (C_Y.obj A))).symm
      (adj_comp_p.unit.app A ≫ (P_pull.obj (C_Y.obj A)).obj.map τ_p_inv.op)
  have hπ_eq_comp : ∀ A : AddCommGrpCat.{u},
      π_gen A = (adj_comp_p.homEquiv A (C_Z.obj A)).symm
        (adj_Z_p.unit.app A ≫ ρ_sec.hom.app (C_Z.obj A)) := by
    intro A
    apply (adj_comp_p.homEquiv A (C_Z.obj A)).injective
    rw [Equiv.apply_symm_apply]
    have h1 : (adj_comp_p.homEquiv A (C_Z.obj A)) (π_gen A) =
        adj_Y_p.unit.app A ≫
          ((sheafSections Y.smallEtaleTopology AddCommGrpCat.{u}).obj (Opposite.op T_Y_p)).map
            (adj_pull.unit.app (C_Y.obj A) ≫ P_push.map (π_gen A)) := by
      rw [Adjunction.homEquiv_unit, Adjunction.comp_unit_app]
      change (adj_Y_p.unit.app A ≫
          ((sheafSections Y.smallEtaleTopology AddCommGrpCat.{u}).obj (Opposite.op T_Y_p)).map
            (adj_pull.unit.app (C_Y.obj A))) ≫
        ((sheafSections Y.smallEtaleTopology AddCommGrpCat.{u}).obj (Opposite.op T_Y_p)).map
          (P_push.map (π_gen A)) = _
      rw [Category.assoc, ← CategoryTheory.Functor.map_comp]
    have h2 : adj_pull.unit.app (C_Y.obj A) ≫ P_push.map (π_gen A) =
        (adj_pull.homEquiv (C_Y.obj A) (C_Z.obj A)) (π_gen A) := by
      symm; rw [Adjunction.homEquiv_unit]
    have h3 : adj_Y_p.unit.app A ≫
        ((sheafSections Y.smallEtaleTopology AddCommGrpCat.{u}).obj (Opposite.op T_Y_p)).map
          ((adj_pull.homEquiv (C_Y.obj A) (C_Z.obj A)) (π_gen A)) =
        (adj_Y_p.homEquiv A (P_push.obj (C_Z.obj A)))
          ((adj_pull.homEquiv (C_Y.obj A) (C_Z.obj A)) (π_gen A)) := by
      symm; rw [Adjunction.homEquiv_unit]
    rw [h1, h2, h3]
    dsimp only [π_gen]
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    rfl
  have hπ_ι_id : ∀ A : AddCommGrpCat.{u}, π_gen A ≫ ι_gen A = 𝟙 (P_pull.obj (C_Y.obj A)) := by
    intro A
    apply (adj_comp_p.homEquiv A (P_pull.obj (C_Y.obj A))).injective
    rw [Adjunction.homEquiv_naturality_right, hπ_eq_comp A, Equiv.apply_symm_apply,
        Category.assoc, ← ρ_sec.hom.naturality (ι_gen A), ← Category.assoc,
        ← Adjunction.homEquiv_unit]
    dsimp only [ι_gen]
    rw [Equiv.apply_symm_apply]
    change (adj_comp_p.unit.app A ≫ ρ_sec.inv.app (P_pull.obj (C_Y.obj A))) ≫
      ρ_sec.hom.app (P_pull.obj (C_Y.obj A)) = _
    rw [Category.assoc, ρ_sec.inv_hom_id_app]
    symm
    rw [Adjunction.homEquiv_unit]
    exact congrArg (fun g => adj_comp_p.unit.app A ≫ g) (G₁_sec.map_id (P_pull.obj (C_Y.obj A)))
  have hι_π_id : ∀ A : AddCommGrpCat.{u}, ι_gen A ≫ π_gen A = 𝟙 (C_Z.obj A) := by
    intro A
    apply (adj_Z_p.homEquiv A (C_Z.obj A)).injective
    rw [Adjunction.homEquiv_naturality_right]
    dsimp only [ι_gen]
    rw [Equiv.apply_symm_apply]
    change (adj_comp_p.unit.app A ≫ ρ_sec.inv.app (P_pull.obj (C_Y.obj A))) ≫
      G₂_sec.map (π_gen A) = _
    have hu_π : adj_comp_p.unit.app A ≫ G₁_sec.map (π_gen A) =
        (adj_comp_p.homEquiv A (C_Z.obj A)) (π_gen A) := by
      symm; rw [Adjunction.homEquiv_unit]
    rw [Category.assoc, ← ρ_sec.inv.naturality (π_gen A), ← Category.assoc,
        hu_π, hπ_eq_comp A, Equiv.apply_symm_apply,
        Category.assoc, ρ_sec.hom_inv_id_app]
    symm
    rw [Adjunction.homEquiv_unit, CategoryTheory.Functor.map_id]
  have hι_nat : ∀ {A₁ A₂ : AddCommGrpCat.{u}} (f : A₁ ⟶ A₂),
      C_Z.map f ≫ ι_gen A₂ = ι_gen A₁ ≫ P_pull.map (C_Y.map f) := by
    intro A₁ A₂ f
    apply (adj_Z_p.homEquiv A₁ (P_pull.obj (C_Y.obj A₂))).injective
    rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right]
    dsimp only [ι_gen]
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    have hun : f ≫ adj_comp_p.unit.app A₂ =
        adj_comp_p.unit.app A₁ ≫ G₁_sec.map (P_pull.map (C_Y.map f)) :=
      adj_comp_p.unit.naturality f
    change f ≫ adj_comp_p.unit.app A₂ ≫ ρ_sec.inv.app (P_pull.obj (C_Y.obj A₂)) =
      (adj_comp_p.unit.app A₁ ≫ ρ_sec.inv.app (P_pull.obj (C_Y.obj A₁))) ≫
