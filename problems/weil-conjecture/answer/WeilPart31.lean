    let τ₃ : F_sh.obj (S_sub ℋ (W₁ ⊔ W₂)) ≅ (j_ext (W₁ ⊔ W₂)).obj ((j_res (W₁ ⊔ W₂)).obj ℋ) :=
      F_sh.mapIso (Θ_iso ℋ (W₁ ⊔ W₂)).symm

    have h_sq₁ : τ₁.hom ≫ CategoryTheory.Limits.biprod.lift f₁ (-f₂) =
        F_sh.map f_sub ≫ τ₂.hom := by
      apply CategoryTheory.Limits.biprod.hom_ext
      · simp only [τ₁, τ₂, Iso.trans_hom, Iso.symm_hom, Functor.mapIso_hom,
          Category.assoc, CategoryTheory.Limits.biprod.lift_fst,
          CategoryTheory.Limits.biprod.mapIso_hom, CategoryTheory.Limits.biprod.map_fst,
