          (w₁ : Quiver.Hom (G_aff.obj A₁.1) W)
          (hw₁ : CategoryTheory.CategoryStruct.comp A₁.2.1 w₁.left = δ.1)
          (w₂ : Quiver.Hom (G_aff.obj A₂.1) W)
          (hw₂ : CategoryTheory.CategoryStruct.comp A₂.2.1 w₂.left = δ.1)
          (s : ↥(ℱ₂.obj.obj (Opposite.op W))),
          (CategoryTheory.Limits.colimit.ι D_stalk A₁).hom ((ℱ₂.obj.map w₁.op).hom s) =
            (CategoryTheory.Limits.colimit.ι D_stalk A₂).hom ((ℱ₂.obj.map w₂.op).hom s) := by
        intro W δ A₁ A₂ w₁ hw₁ w₂ hw₂ s
        have : AlgebraicGeometry.Etale W.hom := W.prop
        have : AlgebraicGeometry.Etale (G_aff.obj A₁.1).hom := (G_aff.obj A₁.1).prop
        have : AlgebraicGeometry.Etale w₁.left :=
          CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) w₁.left W.hom W.prop
            ((CategoryTheory.MorphismProperty.Over.w w₁).symm ▸ (G_aff.obj A₁.1).prop)
        have : AlgebraicGeometry.Etale w₂.left :=
          CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) w₂.left W.hom W.prop
            ((CategoryTheory.MorphismProperty.Over.w w₂).symm ▸ (G_aff.obj A₂.1).prop)
        let p₁ := CategoryTheory.Limits.pullback.fst w₁.left w₂.left
        let p₂ := CategoryTheory.Limits.pullback.snd w₁.left w₂.left
        let P_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.CategoryStruct.comp p₁ (G_aff.obj A₁.1).hom) inferInstance
        let π₁ : Quiver.Hom P_et (G_aff.obj A₁.1) :=
          CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
        let π₂ : Quiver.Hom P_et (G_aff.obj A₂.1) :=
          CategoryTheory.MorphismProperty.Over.homMk p₂
            ((congrArg (CategoryTheory.CategoryStruct.comp p₂)
              (CategoryTheory.MorphismProperty.Over.w w₂).symm).trans
              ((CategoryTheory.Category.assoc p₂ w₂.left W.hom).symm.trans
                ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k W.hom)
                  CategoryTheory.Limits.pullback.condition.symm).trans
                  ((CategoryTheory.Category.assoc p₁ w₁.left W.hom).trans
                    (congrArg (CategoryTheory.CategoryStruct.comp p₁)
