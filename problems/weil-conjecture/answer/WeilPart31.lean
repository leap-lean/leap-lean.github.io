        (CategoryTheory.Limits.KernelFork.ofι (F_sh.map f_sub) h0_sh_sub) := by
      have hcF := CategoryTheory.Limits.KernelFork.mapIsLimit
        (CategoryTheory.Limits.KernelFork.ofι f_sub h0_sub) hc_sub F_sh
      exact CategoryTheory.Limits.Fork.isLimitOfIsos _ hcF
        (CategoryTheory.Limits.KernelFork.ofι (F_sh.map f_sub) h0_sh_sub)
