              α.comp (E_r G φ) (Nat.zero_add (r + 1)) =
                E_r one₀ (φ.comp (α.postcomp one₀ (Nat.add_zero 0))) := by
        intro r
        induction r with
        | zero =>
          intro _
          exact ⟨E₀, hE₀_nat⟩
        | succ s ih =>
          intro hs
          have hsk : s < k := by omega
          obtain ⟨E_s, hE_s_nat⟩ := ih (by omega)
