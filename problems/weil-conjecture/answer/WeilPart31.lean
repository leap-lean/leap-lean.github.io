      rw [Abelian.Ext.comp_assoc w _ _ (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
        Abelian.Ext.mk₀_comp_mk₀, hic, Abelian.Ext.comp_mk₀_id]

  
  
  
