            change (hom_M.app (Opposite.op v)).hom (lift_hom v (Finsupp.single h m)) =
              Finsupp.single h m
            dsimp only [lift_hom]
            rw [Finsupp.liftAddHom_apply_single]
            have hnat : (hom_M.app (Opposite.op v)).hom ((P_WM.map (Opposite.op h)).hom (ξ_M.hom m)) =
                (F_WM.map (Opposite.op h)).hom ((hom_M.app (Opposite.op W)).hom (ξ_M.hom m)) :=
              congrArg (fun k : P_WM.obj (Opposite.op W) ⟶ F_WM.obj (Opposite.op v) =>
                k.hom (ξ_M.hom m)) (hom_M.naturality (Opposite.op h))
            change (hom_M.app (Opposite.op v)).hom ((P_WM.map (Opposite.op h)).hom (ξ_M.hom m)) =
              Finsupp.single h m
            rw [hnat]
            have hm : (hom_M.app (Opposite.op W)).hom (ξ_M.hom m) = Finsupp.single (𝟙 W) m :=
              congrArg (fun k : M ⟶ F_WM.obj (Opposite.op W) => k.hom m) hξ_hom
            rw [hm]
            change Finsupp.mapDomain (fun g : W ⟶ W => h ≫ g) (Finsupp.single (𝟙 W) m) =
              Finsupp.single h m
            rw [Finsupp.mapDomain_single, Category.comp_id] }
      let freeMapPre : ∀ (W : S.Etale) {M₁ M₂ : AddCommGrpCat.{u}}, (M₁ ⟶ M₂) →
          (Presheaf.freeYoneda W M₁ ⟶ Presheaf.freeYoneda W M₂) := fun W {_ _} α =>
        Presheaf.freeYonedaHomEquiv.symm (α ≫ Presheaf.freeYonedaHomEquiv (𝟙 _))
      let fsMapPre : ∀ (W : S.Etale) {M₁ M₂ : AddCommGrpCat.{u}}, (M₁ ⟶ M₂) →
          (fsPresheaf W M₁ ⟶ fsPresheaf W M₂) := fun W {M₁ M₂} α =>
        { app := fun V => AddCommGrpCat.ofHom (Finsupp.mapRange.addMonoidHom α.hom)
          naturality := fun {V₁ V₂} u => by
            rcases V₁ with ⟨v₁⟩
            rcases V₂ with ⟨v₂⟩
            apply AddCommGrpCat.hom_ext
            refine Finsupp.addHom_ext' (fun h => AddMonoidHom.ext fun m => ?_)
            change (Finsupp.mapRange.addMonoidHom α.hom)
                ((Finsupp.mapDomain.addMonoidHom (fun g : v₁ ⟶ W => u.unop ≫ g))
                  (Finsupp.single h m)) =
              (Finsupp.mapDomain.addMonoidHom (fun g : v₁ ⟶ W => u.unop ≫ g))
                ((Finsupp.mapRange.addMonoidHom α.hom) (Finsupp.single h m))
            simp [Finsupp.mapDomain_single] }
      have hΦ_nat : ∀ (W : S.Etale) {M₁ M₂ : AddCommGrpCat.{u}} (α : M₁ ⟶ M₂),
          freeMapPre W α ≫ (Φ_iso W M₂).hom = (Φ_iso W M₁).hom ≫ fsMapPre W α := by
        intro W M₁ M₂ α
        apply Presheaf.freeYonedaHomEquiv.injective
        rw [Presheaf.freeYonedaHomEquiv_comp, Presheaf.freeYonedaHomEquiv_comp]
        have hs1 : Presheaf.freeYonedaHomEquiv (freeMapPre W α) =
            α ≫ Presheaf.freeYonedaHomEquiv (𝟙 (Presheaf.freeYoneda W M₂)) :=
          Equiv.apply_symm_apply _ _
        have hs2 : Presheaf.freeYonedaHomEquiv (Φ_iso W M₁).hom =
            AddCommGrpCat.ofHom (Finsupp.singleAddHom (𝟙 W)) :=
          Equiv.apply_symm_apply _ _
        rw [hs1, hs2, Category.assoc]
        have hξ2 : Presheaf.freeYonedaHomEquiv (𝟙 (Presheaf.freeYoneda W M₂)) ≫
            (Φ_iso W M₂).hom.app (Opposite.op W) =
            AddCommGrpCat.ofHom (Finsupp.singleAddHom (𝟙 W)) := by
          have hc := (Presheaf.freeYonedaHomEquiv_comp (𝟙 _) (Φ_iso W M₂).hom).symm
          rw [Category.id_comp] at hc
          exact hc.trans (Equiv.apply_symm_apply _ _)
        rw [hξ2]
        apply AddCommGrpCat.ext
        intro m
        change Finsupp.single (𝟙 W) (α.hom m) =
          (Finsupp.mapRange.addMonoidHom α.hom) (Finsupp.single (𝟙 W) m)
        simp
      let L_sh := presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
      let Fℤ := (constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      let freeMapSh : ∀ (W : S.Etale) {m₁ m₂ : ℕ},
          (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₁)) ⟶
           AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₂))) →
          (weilCupPDTraceLocalTorsionSheaf S m₁ W ⟶ weilCupPDTraceLocalTorsionSheaf S m₂ W) :=
        fun W {_ _} α => L_sh.map (freeMapPre W α)
      let ι_sh : ∀ W : S.Etale,
          weilCupPDTraceLocalTorsionSheaf S m₀ W ⟶ weilCupPDTraceLocalTorsionSheaf S (ℓ * m₀) W :=
        fun W => freeMapSh W i_u
      let π_sh : ∀ W : S.Etale,
          weilCupPDTraceLocalTorsionSheaf S (ℓ * m₀) W ⟶ weilCupPDTraceLocalTorsionSheaf S ℓ W :=
        fun W => freeMapSh W p_u_hom
      have hFreeMapEquiv : ∀ (W : S.Etale) {m₁ m₂ : ℕ}
          (α : AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₁)) ⟶
               AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₂))),
          Sheaf.freeYonedaHomEquiv (freeMapSh W α) =
            α ≫ Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDTraceLocalTorsionSheaf S m₂ W)) := by
        intro W m₁ m₂ α
        let adj_sh := sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
        let P₁ := Presheaf.freeYoneda W (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₁)))
        let P₂ := Presheaf.freeYoneda W (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₂)))
        have hunit : (adj_sh.homEquiv P₁ (L_sh.obj P₂)) (L_sh.map (freeMapPre W α)) =
            freeMapPre W α ≫ adj_sh.unit.app P₂ := by
          rw [Adjunction.homEquiv_unit]
          exact (adj_sh.unit.naturality (freeMapPre W α)).symm
        change Presheaf.freeYonedaHomEquiv
          ((adj_sh.homEquiv P₁ (L_sh.obj P₂)) (L_sh.map (freeMapPre W α))) = _
        rw [hunit, Presheaf.freeYonedaHomEquiv_comp, Equiv.apply_symm_apply, Category.assoc]
        rfl
      let ι_peel : ∀ W : S.Etale,
          weilCupPDTraceLocalTorsionH S m₀ W q →+ weilCupPDTraceLocalTorsionH S (ℓ * m₀) W q :=
        fun W => (Abelian.Ext.mk₀ (ι_sh W)).postcomp Fℤ (Nat.add_zero q)
      let π_peel : ∀ W : S.Etale,
          weilCupPDTraceLocalTorsionH S (ℓ * m₀) W q →+ weilCupPDTraceLocalTorsionH S ℓ W q :=
        fun W => (Abelian.Ext.mk₀ (π_sh W)).postcomp Fℤ (Nat.add_zero q)
      have hMapNat : ∀ {U₁ U₂ : S.Etale} (v : U₁ ⟶ U₂) {m₁ m₂ : ℕ}
          (α : AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₁)) ⟶
               AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₂))),
          weilCupPDTraceLocalTorsionMap S m₁ v ≫ freeMapSh U₂ α =
            freeMapSh U₁ α ≫ weilCupPDTraceLocalTorsionMap S m₂ v := by
        intro U₁ U₂ v m₁ m₂ α
        have hm1 : Sheaf.freeYonedaHomEquiv (weilCupPDTraceLocalTorsionMap S m₁ v) =
            Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDTraceLocalTorsionSheaf S m₁ U₂)) ≫
              (weilCupPDTraceLocalTorsionSheaf S m₁ U₂).obj.map (Opposite.op v) :=
          Equiv.apply_symm_apply _ _
        have hm2 : Sheaf.freeYonedaHomEquiv (weilCupPDTraceLocalTorsionMap S m₂ v) =
            Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDTraceLocalTorsionSheaf S m₂ U₂)) ≫
              (weilCupPDTraceLocalTorsionSheaf S m₂ U₂).obj.map (Opposite.op v) :=
          Equiv.apply_symm_apply _ _
        apply Sheaf.freeYonedaHomEquiv.injective
        rw [hEquivNat S (weilCupPDTraceLocalTorsionMap S m₁ v) (freeMapSh U₂ α),
          hEquivNat S (freeMapSh U₁ α) (weilCupPDTraceLocalTorsionMap S m₂ v),
          hm1, hFreeMapEquiv, Category.assoc,
          (freeMapSh U₂ α).hom.naturality (Opposite.op v),
          ← Category.assoc,
          ← hEquivNat S (𝟙 (weilCupPDTraceLocalTorsionSheaf S m₁ U₂)) (freeMapSh U₂ α),
          Category.id_comp, hFreeMapEquiv, Category.assoc,
          Category.assoc α,
          ← hEquivNat S (𝟙 (weilCupPDTraceLocalTorsionSheaf S m₂ U₁))
            (weilCupPDTraceLocalTorsionMap S m₂ v),
          Category.id_comp, hm2]
      refine ⟨ι_peel, π_peel, ?_, ?_, ?_⟩
      · intro U₁ U₂ v x
        change (x.comp (Abelian.Ext.mk₀ (ι_sh U₁)) (Nat.add_zero q)).comp
            (Abelian.Ext.mk₀ (weilCupPDTraceLocalTorsionMap S (ℓ * m₀) v)) (Nat.add_zero q) =
          (x.comp (Abelian.Ext.mk₀ (weilCupPDTraceLocalTorsionMap S m₀ v)) (Nat.add_zero q)).comp
            (Abelian.Ext.mk₀ (ι_sh U₂)) (Nat.add_zero q)
        rw [Abelian.Ext.comp_assoc x _ _ (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
          Abelian.Ext.comp_assoc x _ _ (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
          Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
        dsimp only [ι_sh]
        rw [hMapNat v i_u]
      · intro U₁ U₂ v z
        change (z.comp (Abelian.Ext.mk₀ (weilCupPDTraceLocalTorsionMap S (ℓ * m₀) v))
              (Nat.add_zero q)).comp
            (Abelian.Ext.mk₀ (π_sh U₂)) (Nat.add_zero q) =
          (z.comp (Abelian.Ext.mk₀ (π_sh U₁)) (Nat.add_zero q)).comp
            (Abelian.Ext.mk₀ (weilCupPDTraceLocalTorsionMap S ℓ v)) (Nat.add_zero q)
        rw [Abelian.Ext.comp_assoc z _ _ (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
          Abelian.Ext.comp_assoc z _ _ (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
          Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
        dsimp only [π_sh]
        rw [hMapNat v p_u_hom]
      · intro W y hy
        let M₁ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
        let M₂ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ * m₀)))
        let M₃ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
        have hzero_fs : fsMapPre W i_u ≫ fsMapPre W p_u_hom = 0 := by
          ext ⟨v⟩ : 2
          apply AddCommGrpCat.hom_ext
          refine Finsupp.addHom_ext' (fun h => AddMonoidHom.ext fun a => ?_)
          change (Finsupp.mapRange.addMonoidHom p_u_hom.hom)
            ((Finsupp.mapRange.addMonoidHom i_u.hom) (Finsupp.single h a)) = 0
          simp only [Finsupp.mapRange.addMonoidHom_apply, Finsupp.mapRange_single]
          have h0 : p_u_hom (i_u a) = 0 :=
            congrArg (fun g_hom : M₁ ⟶ M₃ => g_hom a) hiu_pu_zero
          change Finsupp.single h (p_u_hom (i_u a)) = 0
          rw [h0, Finsupp.single_zero]
        let SC_fs : ShortComplex (S.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) :=
          ShortComplex.mk (fsMapPre W i_u) (fsMapPre W p_u_hom) hzero_fs
        have hSE_fs : SC_fs.ShortExact := by
          have hMono_app : ∀ X : S.Etaleᵒᵖ, Function.Injective (SC_fs.f.app X).hom :=
            fun _ _ _ hf => Finsupp.mapRange_injective i_u.hom (map_zero _) hi_u_inj hf
          have hEpi_app : ∀ X : S.Etaleᵒᵖ, Function.Surjective (SC_fs.g.app X).hom :=
            fun _ g => Finsupp.mapRange_surjective p_u_hom.hom (map_zero _) hp_u_surj g
          have hMid_app : ∀ (X : S.Etaleᵒᵖ) (b : SC_fs.X₂.obj X),
              (SC_fs.g.app X) b = 0 → ∃ a : SC_fs.X₁.obj X, (SC_fs.f.app X) a = b := by
            intro ⟨v⟩ (b : (v ⟶ W) →₀ ↥M₂) hb
            let lift_fn : ↥M₂ → ↥M₁ := fun z =>
              if hz : p_u_hom z = 0 then Classical.choose (hmid_u z hz) else 0
            have hlift0 : lift_fn 0 = 0 := by
              dsimp [lift_fn]
              rw [dif_pos (map_zero _)]
              apply hi_u_inj
              exact (Classical.choose_spec (hmid_u 0 (map_zero _))).trans (map_zero _).symm
            refine ⟨Finsupp.mapRange lift_fn hlift0 b, ?_⟩
            apply Finsupp.ext
            intro h
            change i_u (lift_fn (b h)) = b h
            have hbh : p_u_hom (b h) = 0 := Finsupp.ext_iff.mp hb h
            dsimp [lift_fn]
            rw [dif_pos hbh]
            exact Classical.choose_spec (hmid_u (b h) hbh)
          have : Mono SC_fs.f := (NatTrans.mono_iff_mono_app SC_fs.f).mpr (fun X =>
            (AddCommGrpCat.mono_iff_injective (SC_fs.f.app X)).mpr (hMono_app X))
          have : Epi SC_fs.g := (NatTrans.epi_iff_epi_app SC_fs.g).mpr (fun X =>
            (AddCommGrpCat.epi_iff_surjective (SC_fs.g.app X)).mpr (hEpi_app X))
          have hKer : Limits.IsLimit (Limits.KernelFork.ofι SC_fs.f SC_fs.zero) := by
            refine Limits.KernelFork.IsLimit.ofι _ _
              (fun {W_f} k_f hk_f =>
                let h_kz : ∀ (X : S.Etaleᵒᵖ) (w : W_f.obj X),
                    (SC_fs.g.app X) ((k_f.app X) w) = 0 := fun X w =>
                  congrArg (fun η : W_f ⟶ SC_fs.X₃ => (η.app X) w) hk_f
                let ch : ∀ (X : S.Etaleᵒᵖ) (w : W_f.obj X), SC_fs.X₁.obj X := fun X w =>
                  Classical.choose (hMid_app X ((k_f.app X) w) (h_kz X w))
                let hch : ∀ (X : S.Etaleᵒᵖ) (w : W_f.obj X),
                    (SC_fs.f.app X) (ch X w) = (k_f.app X) w := fun X w =>
                  Classical.choose_spec (hMid_app X ((k_f.app X) w) (h_kz X w))
                { app := fun X => AddCommGrpCat.ofHom
                    { toFun := ch X
                      map_zero' := hMono_app X ((hch X 0).trans
                        ((map_zero (k_f.app X).hom).trans (map_zero (SC_fs.f.app X).hom).symm))
                      map_add' := fun w₁ w₂ => hMono_app X <| by
                        change (SC_fs.f.app X) (ch X (w₁ + w₂)) =
                          (SC_fs.f.app X) (ch X w₁ + ch X w₂)
                        rw [hch X (w₁ + w₂), map_add, map_add, hch X w₁, hch X w₂] }
                  naturality := fun {X Y} u => AddCommGrpCat.ext fun w => hMono_app Y <| by
                    change (SC_fs.f.app Y) (ch Y ((W_f.map u) w)) =
                      (SC_fs.f.app Y) ((SC_fs.X₁.map u) (ch X w))
                    have hnat_f := congrArg
                      (fun m : SC_fs.X₁.obj X ⟶ SC_fs.X₂.obj Y => m (ch X w))
                      (SC_fs.f.naturality u)
                    have hnat_k := congrArg
                      (fun m : W_f.obj X ⟶ SC_fs.X₂.obj Y => m w)
                      (k_f.naturality u)
                    dsimp only [NatTrans.comp_app] at hnat_f hnat_k
                    calc
                      (SC_fs.f.app Y) (ch Y ((W_f.map u) w))
                        = (k_f.app Y) ((W_f.map u) w) := hch Y ((W_f.map u) w)
                      _ = (SC_fs.X₂.map u) ((k_f.app X) w) := hnat_k
                      _ = (SC_fs.X₂.map u) ((SC_fs.f.app X) (ch X w)) := by rw [hch X w]
                      _ = (SC_fs.f.app Y) ((SC_fs.X₁.map u) (ch X w)) := hnat_f.symm })
              (fun {W_f} k_f hk_f =>
                NatTrans.ext (funext fun X => AddCommGrpCat.ext fun w =>
                  Classical.choose_spec (hMid_app X ((k_f.app X) w)
                    (congrArg (fun η : W_f ⟶ SC_fs.X₃ => (η.app X) w) hk_f))))
              (fun {W_f} k_f hk_f m hm => by
                rw [← cancel_mono SC_fs.f, hm]
                exact NatTrans.ext (funext fun X => AddCommGrpCat.ext fun w =>
                  (Classical.choose_spec (hMid_app X ((k_f.app X) w)
                    (congrArg (fun η : W_f ⟶ SC_fs.X₃ => (η.app X) w) hk_f))).symm))
          exact ShortComplex.ShortExact.mk' (SC_fs.exact_of_f_is_kernel hKer)
            inferInstance inferInstance
        have hzero_free : freeMapPre W i_u ≫ freeMapPre W p_u_hom = 0 := by
          apply Presheaf.freeYonedaHomEquiv.injective
          rw [Presheaf.freeYonedaHomEquiv_comp]
          have hs1 : Presheaf.freeYonedaHomEquiv (freeMapPre W i_u) =
              i_u ≫ Presheaf.freeYonedaHomEquiv (𝟙 (Presheaf.freeYoneda W M₂)) :=
            Equiv.apply_symm_apply _ _
          have hs2 : Presheaf.freeYonedaHomEquiv (𝟙 (Presheaf.freeYoneda W M₂)) ≫
              (freeMapPre W p_u_hom).app (Opposite.op W) =
              p_u_hom ≫ Presheaf.freeYonedaHomEquiv (𝟙 (Presheaf.freeYoneda W M₃)) := by
            have hc := (Presheaf.freeYonedaHomEquiv_comp (𝟙 _) (freeMapPre W p_u_hom)).symm
            rw [Category.id_comp] at hc
            exact hc.trans (Equiv.apply_symm_apply _ _)
          rw [hs1, Category.assoc, hs2, ← Category.assoc, hiu_pu_zero, Limits.zero_comp]
          have hz0 : Presheaf.freeYonedaHomEquiv
              (0 : Presheaf.freeYoneda W M₁ ⟶ Presheaf.freeYoneda W M₃) = 0 := by
            have hc := Presheaf.freeYonedaHomEquiv_comp (𝟙 _)
              (0 : Presheaf.freeYoneda W M₁ ⟶ Presheaf.freeYoneda W M₃)
            rw [Category.id_comp] at hc
            exact hc.trans (AddCommGrpCat.ext fun _ => rfl)
          exact hz0.symm
        let SC_free : ShortComplex (S.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) :=
          ShortComplex.mk (freeMapPre W i_u) (freeMapPre W p_u_hom) hzero_free
        let e_SC : SC_free ≅ SC_fs :=
          ShortComplex.isoMk (Φ_iso W M₁) (Φ_iso W M₂) (Φ_iso W M₃)
            (hΦ_nat W i_u).symm (hΦ_nat W p_u_hom).symm
        have hSE_free : SC_free.ShortExact := (ShortComplex.shortExact_iff_of_iso e_SC).mpr hSE_fs
        have hSE_sh : (SC_free.map L_sh).ShortExact := hSE_free.map_of_exact L_sh
        exact Abelian.Ext.covariant_sequence_exact₂ Fℤ hSE_sh y hy

  
  
  
  let S_k := Spec (CommRingCat.of k)
  let pt_k : ↥S_k := (⊥ : PrimeSpectrum k)

  have hClosedPtSection : ∀ (W : Scheme.{u}) [IsAffine W]
      (p_W : W ⟶ S_k) [LocallyOfFiniteType p_W]
      (x : ↥W), IsClosed ({x} : Set ↥W) →
      ∃ s : S_k ⟶ W, s ≫ p_W = 𝟙 S_k ∧ s.base pt_k = x := by
    intro W _ p_W _ x hx
    let R_W : CommRingCat.{u} := W.presheaf.obj (Opposite.op ⊤)
    let q : ↥(Spec R_W) := W.isoSpec.hom.base x
    have hq_cl : IsClosed ({q} : Set ↥(Spec R_W)) := by
      have hset : ({q} : Set ↥(Spec R_W)) = W.isoSpec.hom.homeomorph '' ({x} : Set ↥W) := by
        simp [q]
      rw [hset]
      exact W.isoSpec.hom.homeomorph.isClosedMap _ hx
    have hq_max : q.asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q).mp hq_cl
    have : q.asIdeal.IsMaximal := hq_max
    let _ : Field (↥R_W ⧸ q.asIdeal) := Ideal.Quotient.field q.asIdeal
    let φ_k : CommRingCat.of k ⟶ R_W := Spec.preimage (W.isoSpec.inv ≫ p_W)
    have hφ_map : Spec.map φ_k = W.isoSpec.inv ≫ p_W := Spec.map_preimage _
    have hLF : LocallyOfFiniteType (Spec.map φ_k) := by
      rw [hφ_map]
      infer_instance
    have hFT_hom : φ_k.hom.FiniteType :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hLF
    let _ : Algebra k ↥R_W := φ_k.hom.toAlgebra
    have : Algebra.FiniteType k ↥R_W := hFT_hom
    have : Algebra.FiniteType k (↥R_W ⧸ q.asIdeal) := inferInstance
    obtain ⟨r, Φ, hΦ_surj⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k) (S := ↥R_W ⧸ q.asIdeal)).mp
        inferInstance
    have hKer_max : (RingHom.ker Φ.toRingHom).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective Φ.toRingHom hΦ_surj
    obtain ⟨a_pt, ha_pt⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hKer_max
    have hBij_k : Function.Bijective (algebraMap k (↥R_W ⧸ q.asIdeal)) := by
      refine ⟨RingHom.injective _, fun y => ?_⟩
      obtain ⟨P, rfl⟩ := hΦ_surj y
      refine ⟨(MvPolynomial.aeval a_pt) P, ?_⟩
      have hmem : P - MvPolynomial.C ((MvPolynomial.aeval a_pt) P) ∈ RingHom.ker Φ.toRingHom := by
