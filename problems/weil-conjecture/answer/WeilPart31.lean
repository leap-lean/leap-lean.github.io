          CategoryTheory.Limits.biprod.mapIso_hom, CategoryTheory.Limits.biprod.map_snd,
          CategoryTheory.Functor.mapBiprod_hom, CategoryTheory.Limits.biprod.lift_snd_assoc]
        dsimp only [f₂, ι_ext, ι_pSh, f_sub]
        rw [CategoryTheory.Preadditive.comp_neg, ← F_sh.map_comp,
          (Θ_iso ℋ (W₁ ⊓ W₂)).inv_hom_id_assoc,
          ← Category.assoc (F_sh.map (CategoryTheory.Limits.biprod.lift _ _)),
          ← F_sh.map_comp, CategoryTheory.Limits.biprod.lift_snd,
          F_sh.map_neg, CategoryTheory.Preadditive.neg_comp, ← F_sh.map_comp]

