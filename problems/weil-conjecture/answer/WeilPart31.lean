              calc
                F_fg.map (ℱ₁.obj.map w) ≫
                    ((eqToHom (hU_obj ℱ₁).symm).app V₂ ≫ ψ.hom.app V₂ ≫
                      (eqToHom (hU_obj ℱ₂)).app V₂) =
                  (F_fg.map (ℱ₁.obj.map w) ≫ (eqToHom (hU_obj ℱ₁).symm).app V₂) ≫
                    ψ.hom.app V₂ ≫ (eqToHom (hU_obj ℱ₂)).app V₂ := by
                      simp only [Category.assoc]
                _ = (eqToHom (hU_obj ℱ₁).symm).app V₁ ≫
                    ((U_W.obj ℱ₁).obj.map w ≫ ψ.hom.app V₂) ≫
                      (eqToHom (hU_obj ℱ₂)).app V₂ := by
                      rw [hn1]; simp only [Category.assoc]
                _ = (eqToHom (hU_obj ℱ₁).symm).app V₁ ≫
                    ψ.hom.app V₁ ≫ ((U_W.obj ℱ₂).obj.map w ≫
                      (eqToHom (hU_obj ℱ₂)).app V₂) := by
                      rw [hn2]; simp only [Category.assoc]
                _ = ((eqToHom (hU_obj ℱ₁).symm).app V₁ ≫ ψ.hom.app V₁ ≫
                      (eqToHom (hU_obj ℱ₂)).app V₁) ≫ F_fg.map (ℱ₂.obj.map w) := by
                      rw [hn3]; simp only [Category.assoc]) } }
    refine
      { preimage := fun {ℱ₁ ℱ₂} ψ => pre_U ψ
        map_preimage := fun {ℱ₁ ℱ₂} ψ => sheaf_hom_ext (by
          ext V : 2
          have hm := hmap_eq (pre_U ψ) V
          have hpre : F_fg.map ((pre_U ψ).hom.app V) =
              (eqToHom (hU_obj ℱ₁).symm).app V ≫ ψ.hom.app V ≫ (eqToHom (hU_obj ℱ₂)).app V :=
            ff_Ffg.map_preimage _
          rw [hpre] at hm
          simp only [eqToHom_app] at hm
          exact (cancel_mono (eqToHom _)).mp ((cancel_epi (eqToHom _)).mp hm))
        preimage_map := fun {ℱ₁ ℱ₂} u => sheaf_hom_ext (by
          ext V : 2
          apply ff_Ffg.map_injective
          exact (ff_Ffg.map_preimage _).trans (hmap_eq u V)) }

  obtain ⟨U_Y, hUY_obj, hUY_map, hAdd_UY, hLim_UY, hColim_UY, T_Y1, hT_Y1, _, _,
      u_unit_Y1, hu_Y1, βM_Y, hαβ_Y, hβα_Y, hθ_Y_eq⟩ := hθ_Y_2d
  obtain ⟨U_Z, hUZ_obj, hUZ_map, hAdd_UZ, hLim_UZ, hColim_UZ, T_Z1, hT_Z1, _, _,
      u_unit_Z1, hu_Z1, βM_Z, hαβ_Z, hβα_Z, hθ_Z_eq⟩ := hθ_Z
  have := hAdd_UY; have := hLim_UY; have := hColim_UY
  have := hAdd_UZ; have := hLim_UZ; have := hColim_UZ
  let ff_UY : U_Y.FullyFaithful := mk_ff_U Y U_Y hUY_obj hUY_map
  let ff_UZ : U_Z.FullyFaithful := mk_ff_U Z U_Z hUZ_obj hUZ_map
