        ZMod.castHom (dvd_mul_right a b) (ZMod a) := RingHom.ext_zmod _ _
    have hE_snd : (RingHom.snd (ZMod a) (ZMod b)).comp e_ring.toRingHom =
        ZMod.castHom (dvd_mul_left b a) (ZMod b) := RingHom.ext_zmod _ _
    have hE_apply : ∀ x : ZMod (a * b), E x = (p_a x, p_b x) := by
      intro x
      exact Prod.ext (DFunLike.congr_fun hE_fst x) (DFunLike.congr_fun hE_snd x)
    let i_a : ZMod a →+ ZMod (a * b) :=
      E.symm.toAddMonoidHom.comp (AddMonoidHom.inl (ZMod a) (ZMod b))
    let i_b : ZMod b →+ ZMod (a * b) :=
      E.symm.toAddMonoidHom.comp (AddMonoidHom.inr (ZMod a) (ZMod b))
    have h_aa : p_a.comp i_a = AddMonoidHom.id (ZMod a) := by
      ext u
      have h := hE_apply (E.symm (u, 0))
      rw [E.apply_symm_apply] at h
      exact (congrArg Prod.fst h).symm
    have h_ba : p_b.comp i_a = 0 := by
      ext u
      have h := hE_apply (E.symm (u, 0))
      rw [E.apply_symm_apply] at h
      exact (congrArg Prod.snd h).symm
    have h_ab : p_a.comp i_b = 0 := by
      ext v
      have h := hE_apply (E.symm (0, v))
      rw [E.apply_symm_apply] at h
      exact (congrArg Prod.fst h).symm
    have h_bb : p_b.comp i_b = AddMonoidHom.id (ZMod b) := by
      ext v
      have h := hE_apply (E.symm (0, v))
      rw [E.apply_symm_apply] at h
      exact (congrArg Prod.snd h).symm
    have h_sum : i_a.comp p_a + i_b.comp p_b = AddMonoidHom.id (ZMod (a * b)) := by
      ext x
      change E.symm (p_a x, 0) + E.symm (0, p_b x) = x
      rw [← map_add E.symm, Prod.mk_add_mk, add_zero, zero_add, ← hE_apply x,
        E.symm_apply_apply]
    refine ⟨{
      toFun := fun w => (M p_a w, M p_b w)
      invFun := fun uv => M i_a uv.1 + M i_b uv.2
      left_inv := fun w => by
        change ((M i_a).comp (M p_a) + (M i_b).comp (M p_b)) w = w
        rw [← hM_comp, ← hM_comp, ← hM_add, h_sum, hM_id, AddMonoidHom.id_apply]
      right_inv := fun ⟨u, v⟩ => by
        apply Prod.ext
        · change M p_a (M i_a u + M i_b v) = u
          rw [map_add, ← AddMonoidHom.comp_apply (M p_a) (M i_a),
            ← AddMonoidHom.comp_apply (M p_a) (M i_b), ← hM_comp, ← hM_comp,
            h_aa, h_ab, hM_id, hM_zero, AddMonoidHom.id_apply,
            AddMonoidHom.zero_apply, add_zero]
        · change M p_b (M i_a u + M i_b v) = v
          rw [map_add, ← AddMonoidHom.comp_apply (M p_b) (M i_a),
            ← AddMonoidHom.comp_apply (M p_b) (M i_b), ← hM_comp, ← hM_comp,
            h_ba, h_bb, hM_zero, hM_id, AddMonoidHom.zero_apply,
            AddMonoidHom.id_apply, zero_add]
      map_add' := fun w₁ w₂ =>
        Prod.ext (map_add (M p_a) w₁ w₂) (map_add (M p_b) w₁ w₂)
    }, fun _ => rfl⟩
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro m q
    exact ⟨hGlob_id m q, fun U => hLoc_id m q U⟩
  · intro m₁ m₂ m₃ φ ψ q
    exact ⟨hGlob_comp φ ψ q, fun U => hLoc_comp φ ψ q U⟩
  · intro m₁ m₂ φ U q z
    rw [hGlob_eq, hLoc_eq, hCounitH_eq, hCounitH_eq,
      ← AddMonoidHom.comp_apply (post_q (G_sh φ) q),
      ← AddMonoidHom.comp_apply (post_q (weilCupPDTraceLocalTorsionCounit S m₂ U) q),
      ← hPost_comp, ← hPost_comp, hCounit_sh]
  · intro q
    refine ⟨hSubOne (fun m => weilEtaleTorsionH S m q)
        (fun φ => weilCupPDTraceGlobCoeffMapH S φ q)
        (hGlob_id 1 q) (hGlob_zero 1 1 q),
      fun U => hSubOne (fun m => weilCupPDTraceLocalTorsionH S m U q)
        (fun φ => weilCupPDTraceLocCoeffMapH S φ U q)
        (hLoc_id 1 q U) (hLoc_zero 1 1 q U)⟩
  · intro a b hcop q
    dsimp only
    refine ⟨hBiprod hcop (fun m => weilEtaleTorsionH S m q)
        (fun φ => weilCupPDTraceGlobCoeffMapH S φ q)
        (fun m => hGlob_id m q)
        (fun φ ψ => hGlob_comp φ ψ q)
        (fun m₁ m₂ => hGlob_zero m₁ m₂ q)
        (fun φ₁ φ₂ => hGlob_add φ₁ φ₂ q),
      fun U => hBiprod hcop (fun m => weilCupPDTraceLocalTorsionH S m U q)
        (fun φ => weilCupPDTraceLocCoeffMapH S φ U q)
        (fun m => hLoc_id m q U)
        (fun φ ψ => hLoc_comp φ ψ q U)
        (fun m₁ m₂ => hLoc_zero m₁ m₂ q U)
        (fun φ₁ φ₂ => hLoc_add φ₁ φ₂ U q)⟩

theorem weil_cupPD_trace_prime_pow_root_tower (k : Type u) [Field k] [IsAlgClosed k]
    (n ℓ r₀ : ℕ) (hn : 1 ≤ n) [Fact (Nat.Prime ℓ)] (hr₀ : 1 ≤ r₀) (hdvd : ℓ ^ r₀ ∣ n)
    (ζ : kˣ) (hPrim : IsPrimitiveRoot ((ζ : kˣ) : k) n) :
    ∃ ζ_tower : ℕ → kˣ,
      (∀ r : ℕ, IsPrimitiveRoot ((ζ_tower r : kˣ) : k) (ℓ ^ r)) ∧
      (∀ r : ℕ, (ζ_tower (r + 1)) ^ ℓ = ζ_tower r) :=
by
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_pow : ℓ ∣ ℓ ^ r₀ := by
    have h1 : ℓ ^ 1 ∣ ℓ ^ r₀ := Nat.pow_dvd_pow ℓ hr₀
    rwa [pow_one] at h1
  have hℓ_dvd : ℓ ∣ n := dvd_trans hℓ_pow hdvd
  have hn_eq : n = (n / ℓ) * ℓ := (Nat.div_mul_cancel hℓ_dvd).symm
  have hn_pos : 0 < n := hn
  let ζ₁ : kˣ := ζ ^ (n / ℓ)
  have hPrim₁ : IsPrimitiveRoot ((ζ₁ : kˣ) : k) (ℓ ^ (0 + 1)) := by
    have h0 : IsPrimitiveRoot (((ζ : kˣ) : k) ^ (n / ℓ)) ℓ :=
      IsPrimitiveRoot.pow hn_pos hPrim hn_eq
    simp only [ζ₁, Units.val_pow_eq_pow_val, zero_add, pow_one]
    exact h0
  have hStep : ∀ (t : ℕ) (u : kˣ),
      IsPrimitiveRoot ((u : kˣ) : k) (ℓ ^ (t + 1)) →
      ∃ u' : kˣ, IsPrimitiveRoot ((u' : kˣ) : k) (ℓ ^ (t + 2)) ∧ u' ^ ℓ = u := by
    intro t u hu
    obtain ⟨w, hw⟩ := IsAlgClosed.exists_pow_nat_eq ((u : kˣ) : k) hPrime.pos
    have hw_ne : w ≠ 0 := by
      intro h0
      rw [h0, zero_pow hPrime.ne_zero] at hw
      exact u.ne_zero hw.symm
    let u' : kˣ := Units.mk0 w hw_ne
    refine ⟨u', ?_, ?_⟩
    · simp only [u', Units.val_mk0]
      refine IsPrimitiveRoot.mk ?_ ?_
      · rw [show t + 2 = (t + 1) + 1 from rfl, pow_succ', pow_mul, hw]
        exact hu.pow_eq_one
      · intro l hl
        have hul : ((u : kˣ) : k) ^ l = 1 := by
          rw [← hw, ← pow_mul, mul_comm, pow_mul, hl, one_pow]
        obtain ⟨c, rfl⟩ := hu.dvd_of_pow_eq_one l hul
        have huc : ((u : kˣ) : k) ^ (ℓ ^ t * c) = 1 := by
          rw [← hw, ← pow_mul, ← mul_assoc, ← pow_succ', hl]
        have hdvd_c : ℓ ^ (t + 1) ∣ ℓ ^ t * c :=
          hu.dvd_of_pow_eq_one (ℓ ^ t * c) huc
        have hmul := mul_dvd_mul_left ℓ hdvd_c
        rwa [← pow_succ', ← mul_assoc, ← pow_succ'] at hmul
    · apply Units.ext
      simp only [u', Units.val_pow_eq_pow_val, Units.val_mk0, hw]
  let ξ : ∀ t : ℕ, { u : kˣ // IsPrimitiveRoot ((u : kˣ) : k) (ℓ ^ (t + 1)) } :=
    Nat.rec ⟨ζ₁, hPrim₁⟩ (fun t prev =>
      ⟨Classical.choose (hStep t prev.1 prev.2),
       (Classical.choose_spec (hStep t prev.1 prev.2)).1⟩)
  let ζ_tower : ℕ → kˣ := fun r => Nat.casesOn r 1 (fun t => (ξ t).1)
  refine ⟨ζ_tower, ?_, ?_⟩
  · intro r
    cases r with
    | zero =>
      change IsPrimitiveRoot (((1 : kˣ) : k)) (ℓ ^ 0)
      rw [Units.val_one, pow_zero]
      exact IsPrimitiveRoot.one
    | succ t =>
      exact (ξ t).2
  · intro r
    cases r with
    | zero =>
      change ζ₁ ^ ℓ = 1
      apply Units.ext
      rw [Units.val_pow_eq_pow_val, Units.val_one]
      have h1 := hPrim₁.pow_eq_one
      rwa [zero_add, pow_one] at h1
    | succ t =>
      exact (Classical.choose_spec (hStep t (ξ t).1 (ξ t).2)).2

theorem weil_cupPD_trace_pinned_roof_castHom_compat (k : Type u) [Field k]
    (n ℓ r₀ : ℕ) [Fact (Nat.Prime ℓ)] (hdvd : ℓ ^ r₀ ∣ n)
    (Ψ : WeilCupPDTraceRoofSystem k n) (hΨ : WeilCupPDTraceIsPinnedRoof k n Ψ)
    (Ψ_ℓ : WeilRoofTransferSystem k ℓ) (hΨ_ℓ : WeilIsPinnedRoofTransfer k ℓ Ψ_ℓ)
    (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₁ : Y₁.left.Etale) (U₂ : Y₂.left.Etale)
    (e : CategoryTheory.Iso
      ((AlgebraicGeometry.Scheme.Etale.forget Y₁.left).obj U₁).left
      ((AlgebraicGeometry.Scheme.Etale.forget Y₂.left).obj U₂).left)
    (h : WeilCupPDTraceIsAffineRoofIso k Y₁ Y₂ U₁ U₂ e)
    (q : ℕ) (z : weilCupPDTraceLocalTorsionH Y₁.left n U₁ q) :
    let p_a : ZMod n →+ ZMod (ℓ ^ r₀) :=
      (ZMod.castHom hdvd (ZMod (ℓ ^ r₀))).toAddMonoidHom
    weilCupPDTraceLocCoeffMapH Y₂.left p_a U₂ q (Ψ Y₁ Y₂ U₁ U₂ e h q z) =
      Ψ_ℓ Y₁ Y₂ U₁ U₂ e h r₀ q (weilCupPDTraceLocCoeffMapH Y₁.left p_a U₁ q z) :=
by
  intro p_a
  obtain ⟨hc_all, hr_all, hSiteExact, _, hConstIso, _, _, _, hClopenPkg, _, _⟩ :=
    weil_etale_pinned_clopen_section_and_stalk_criteria.{u}
  letI : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂),
      (weilEtaleSitePullback f).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology :=
    @hc_all
  letI : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint :=
    @hr_all
  obtain ⟨_, _, hLerayPkg, _⟩ :=
    weil_etale_bockstein_and_degenerate_leray_ext_calculus.{u}

  
  have hSingleBack :
      ∀ (W_bar Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (π : Quiver.Hom W_bar.left Y.left)
        (U_W : W_bar.left.Etale) (U_Y : Y.left.Etale)
        (e₀ : CategoryTheory.Iso
          ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).left
          ((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U_Y).left)
        (h₀ : WeilCupPDTraceIsAffineRoofIso k W_bar Y U_W U_Y e₀),
        CategoryTheory.CategoryStruct.comp π Y.hom = W_bar.hom →
        CategoryTheory.CategoryStruct.comp
            (((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).hom) π =
          CategoryTheory.CategoryStruct.comp e₀.hom
            (((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U_Y).hom) →
        ∀ (y : weilCupPDTraceLocalTorsionH Y.left n U_Y q),
          weilCupPDTraceLocCoeffMapH W_bar.left p_a U_W q
              ((Ψ W_bar Y U_W U_Y e₀ h₀ q).symm y) =
            (Ψ_ℓ W_bar Y U_W U_Y e₀ h₀ r₀ q).symm
              (weilCupPDTraceLocCoeffMapH Y.left p_a U_Y q y) := by
    intro W_bar Y π U_W U_Y e₀ h₀ hπ_hom hU_comm y
    haveI hProp_W : AlgebraicGeometry.IsProper W_bar.hom := h₀.1
    haveI hProp_Y : AlgebraicGeometry.IsProper Y.hom := h₀.2.1
    have hProp_comp : AlgebraicGeometry.IsProper (CategoryTheory.CategoryStruct.comp π Y.hom) := by
      rwa [hπ_hom]
    haveI hProp_π : AlgebraicGeometry.IsProper π :=
      @AlgebraicGeometry.IsProper.of_comp _ _ _ π Y.hom hProp_comp inferInstance
    let B_π := weilEtaleSitePullback π
    let J_W := W_bar.left.smallEtaleTopology
    let J_Y := Y.left.smallEtaleTopology
    let pb_π := B_π.sheafPullback AddCommGrpCat.{u} J_Y J_W
    haveI hAdd : pb_π.Additive := (hSiteExact π).1
    haveI hLim : CategoryTheory.Limits.PreservesFiniteLimits pb_π := (hSiteExact π).2.2.1
    haveI hColim : CategoryTheory.Limits.PreservesFiniteColimits pb_π := (hSiteExact π).2.2.2
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let T_W := weilEtaleIdTerminal W_bar.left
    let hT_W := weilEtaleIdTerminalIsTerminal W_bar.left
    let T_Y := weilEtaleIdTerminal Y.left
    let hT_Y := weilEtaleIdTerminalIsTerminal Y.left
    let πℤ := weilEtaleConstPullbackHom π hT_W hT_Y Aℤ
    haveI hIso_πℤ : CategoryTheory.IsIso πℤ := hConstIso π hT_W hT_Y Aℤ
    let ιℤ := CategoryTheory.inv πℤ
    have hιπ : CategoryTheory.CategoryStruct.comp ιℤ πℤ = CategoryTheory.CategoryStruct.id _ :=
      CategoryTheory.IsIso.inv_hom_id πℤ
    have hπι : CategoryTheory.CategoryStruct.comp πℤ ιℤ = CategoryTheory.CategoryStruct.id _ :=
      CategoryTheory.IsIso.hom_inv_id πℤ
    obtain ⟨σ_e, α_sys, hσ_fst, _, hα_spec, _, hα_coeff⟩ :=
      hClopenPkg π U_W U_Y e₀ hU_comm
    have hPin_n := hΨ.2 W_bar Y π U_W U_Y e₀ h₀ hπ_hom hU_comm
      (hc_all π) (hr_all π) hAdd hLim hColim T_W hT_W T_Y hT_Y ιℤ σ_e (α_sys n)
      hιπ hπι hσ_fst (hα_spec n).1 (hα_spec n).2.1 q y
    have hPin_ℓ := hΨ_ℓ.2.2.2.2 W_bar Y π U_W U_Y e₀ h₀ hπ_hom hU_comm
      (hc_all π) (hr_all π) hAdd hLim hColim T_W hT_W T_Y hT_Y ιℤ σ_e r₀ (α_sys (ℓ ^ r₀))
      hιπ hπι hσ_fst (hα_spec (ℓ ^ r₀)).1 (hα_spec (ℓ ^ r₀)).2.1 q
      (weilCupPDTraceLocCoeffMapH Y.left p_a U_Y q y)
    let c_pa := AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom p_a)
    let map_Y : Quiver.Hom (weilEtaleLocalTorsionSheaf Y.left n U_Y)
        (weilEtaleLocalTorsionSheaf Y.left (ℓ ^ r₀) U_Y) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
        (CategoryTheory.CategoryStruct.comp c_pa
          (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf Y.left (ℓ ^ r₀) U_Y))))
    let map_W : Quiver.Hom (weilEtaleLocalTorsionSheaf W_bar.left n U_W)
        (weilEtaleLocalTorsionSheaf W_bar.left (ℓ ^ r₀) U_W) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
        (CategoryTheory.CategoryStruct.comp c_pa
          (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf W_bar.left (ℓ ^ r₀) U_W))))
    have hSqNat := (hLerayPkg π hT_W hT_Y ιℤ hιπ hπι).2
      map_Y map_W (α_sys n) (α_sys (ℓ ^ r₀)) (hα_coeff n (ℓ ^ r₀) p_a) q y
    exact (congrArg (weilCupPDTraceLocCoeffMapH W_bar.left p_a U_W q) hPin_n).trans
      (hSqNat.trans hPin_ℓ.symm)

  have hSingleFwd :
      ∀ (W_bar Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (π : Quiver.Hom W_bar.left Y.left)
        (U_W : W_bar.left.Etale) (U_Y : Y.left.Etale)
        (e₀ : CategoryTheory.Iso
          ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).left
          ((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U_Y).left)
        (h₀ : WeilCupPDTraceIsAffineRoofIso k W_bar Y U_W U_Y e₀),
        CategoryTheory.CategoryStruct.comp π Y.hom = W_bar.hom →
        CategoryTheory.CategoryStruct.comp
            (((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).hom) π =
          CategoryTheory.CategoryStruct.comp e₀.hom
            (((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U_Y).hom) →
        ∀ (w : weilCupPDTraceLocalTorsionH W_bar.left n U_W q),
          weilCupPDTraceLocCoeffMapH Y.left p_a U_Y q (Ψ W_bar Y U_W U_Y e₀ h₀ q w) =
            Ψ_ℓ W_bar Y U_W U_Y e₀ h₀ r₀ q
              (weilCupPDTraceLocCoeffMapH W_bar.left p_a U_W q w) := by
    intro W_bar Y π U_W U_Y e₀ h₀ hπ_hom hU_comm w
    have hBack := hSingleBack W_bar Y π U_W U_Y e₀ h₀ hπ_hom hU_comm
      (Ψ W_bar Y U_W U_Y e₀ h₀ q w)
    rw [(Ψ W_bar Y U_W U_Y e₀ h₀ q).symm_apply_apply] at hBack
    have hApp := congrArg (Ψ_ℓ W_bar Y U_W U_Y e₀ h₀ r₀ q) hBack
    rw [(Ψ_ℓ W_bar Y U_W U_Y e₀ h₀ r₀ q).apply_symm_apply] at hApp
    exact hApp.symm

  
  rcases h with ⟨hProp₁, hProp₂, hAff₁, he_over⟩
  let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget Y₁.left
  let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget Y₂.left
  let W : AlgebraicGeometry.Scheme.{u} := (Fgt₁.obj U₁).left
  haveI : AlgebraicGeometry.IsProper Y₁.hom := hProp₁
  haveI : AlgebraicGeometry.IsProper Y₂.hom := hProp₂
  haveI : AlgebraicGeometry.IsAffine W := hAff₁
  haveI : AlgebraicGeometry.Etale (Fgt₁.obj U₁).hom := U₁.prop
  let pr₁ := CategoryTheory.Limits.pullback.fst Y₁.hom Y₂.hom
  let pr₂ := CategoryTheory.Limits.pullback.snd Y₁.hom Y₂.hom
  let Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (CategoryTheory.CategoryStruct.comp pr₁ Y₁.hom)
  haveI : AlgebraicGeometry.IsProper Z.hom := by
    dsimp [Z, pr₁]
    infer_instance
  have hu_cond :
      CategoryTheory.CategoryStruct.comp (Fgt₁.obj U₁).hom Y₁.hom =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp e.hom (Fgt₂.obj U₂).hom) Y₂.hom :=
    he_over.symm.trans (CategoryTheory.Category.assoc _ _ _).symm
  let u : Quiver.Hom W Z.left :=
    CategoryTheory.Limits.pullback.lift (Fgt₁.obj U₁).hom
      (CategoryTheory.CategoryStruct.comp e.hom (Fgt₂.obj U₂).hom) hu_cond
  have hu_Z :
      CategoryTheory.CategoryStruct.comp u Z.hom =
        CategoryTheory.CategoryStruct.comp (Fgt₁.obj U₁).hom Y₁.hom := by
    change u ≫ (pr₁ ≫ Y₁.hom) = (Fgt₁.obj U₁).hom ≫ Y₁.hom
    rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
  haveI : AlgebraicGeometry.LocallyOfFiniteType (CategoryTheory.CategoryStruct.comp u Z.hom) := by
    rw [hu_Z]
    infer_instance
  obtain ⟨W_bar, π_Z, j, hProp_Wbar, hπZ_hom, hOpen_j, hj_πZ⟩ :=
    weil_affine_proper_image_compactification k Z W u
  haveI : AlgebraicGeometry.IsProper W_bar.hom := hProp_Wbar
  haveI : AlgebraicGeometry.IsOpenImmersion j := hOpen_j
  let π₁ : Quiver.Hom W_bar.left Y₁.left := CategoryTheory.CategoryStruct.comp π_Z pr₁
  let π₂ : Quiver.Hom W_bar.left Y₂.left := CategoryTheory.CategoryStruct.comp π_Z pr₂
  let U_W : W_bar.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ j inferInstance
  let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget W_bar.left
  have hπ₁_hom : CategoryTheory.CategoryStruct.comp π₁ Y₁.hom = W_bar.hom := by
    change (π_Z ≫ pr₁) ≫ Y₁.hom = W_bar.hom
    rw [CategoryTheory.Category.assoc]
    exact hπZ_hom
  have hπ₂_hom : CategoryTheory.CategoryStruct.comp π₂ Y₂.hom = W_bar.hom := by
    change (π_Z ≫ pr₂) ≫ Y₂.hom = W_bar.hom
    rw [CategoryTheory.Category.assoc,
      ← CategoryTheory.Limits.pullback.condition (f := Y₁.hom) (g := Y₂.hom)]
    exact hπZ_hom
  have hj_π₁ : CategoryTheory.CategoryStruct.comp j π₁ = (Fgt₁.obj U₁).hom := by
    change j ≫ (π_Z ≫ pr₁) = (Fgt₁.obj U₁).hom
    rw [← CategoryTheory.Category.assoc, hj_πZ]
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hj_π₂ :
      CategoryTheory.CategoryStruct.comp j π₂ =
        CategoryTheory.CategoryStruct.comp e.hom (Fgt₂.obj U₂).hom := by
    change j ≫ (π_Z ≫ pr₂) = e.hom ≫ (Fgt₂.obj U₂).hom
    rw [← CategoryTheory.Category.assoc, hj_πZ]
    exact CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hU₁_comm :
      CategoryTheory.CategoryStruct.comp ((Fgt_W.obj U_W).hom) π₁ =
        CategoryTheory.CategoryStruct.comp (CategoryTheory.Iso.refl W).hom
          ((Fgt₁.obj U₁).hom) := by
    change j ≫ π₁ = 𝟙 W ≫ (Fgt₁.obj U₁).hom
    rw [CategoryTheory.Category.id_comp, hj_π₁]
  have hU₂_comm :
      CategoryTheory.CategoryStruct.comp ((Fgt_W.obj U_W).hom) π₂ =
        CategoryTheory.CategoryStruct.comp e.hom ((Fgt₂.obj U₂).hom) := hj_π₂
  have hRoof₁ : WeilCupPDTraceIsAffineRoofIso k W_bar Y₁ U_W U₁ (CategoryTheory.Iso.refl W) := by
    refine ⟨hProp_Wbar, hProp₁, hAff₁, ?_⟩
    change 𝟙 W ≫ ((Fgt₁.obj U₁).hom ≫ Y₁.hom) = j ≫ W_bar.hom
    rw [CategoryTheory.Category.id_comp, ← hj_π₁, CategoryTheory.Category.assoc, hπ₁_hom]
  have hRoof₂ : WeilCupPDTraceIsAffineRoofIso k W_bar Y₂ U_W U₂ e := by
    refine ⟨hProp_Wbar, hProp₂, hAff₁, ?_⟩
    change e.hom ≫ ((Fgt₂.obj U₂).hom ≫ Y₂.hom) = j ≫ W_bar.hom
    rw [← CategoryTheory.Category.assoc, ← hj_π₂, CategoryTheory.Category.assoc, hπ₂_hom]
  have hOrig : WeilCupPDTraceIsAffineRoofIso k Y₁ Y₂ U₁ U₂ e :=
    ⟨hProp₁, hProp₂, hAff₁, he_over⟩
  have he_trans : CategoryTheory.Iso.trans (CategoryTheory.Iso.refl W) e = e :=
    CategoryTheory.Iso.ext (CategoryTheory.Category.id_comp e.hom)
  have hRoof₂' :
      WeilCupPDTraceIsAffineRoofIso k W_bar Y₂ U_W U₂
        (CategoryTheory.Iso.trans (CategoryTheory.Iso.refl W) e) :=
    he_trans.symm ▸ hRoof₂
  have hΨ_congr :
      ∀ (eA eB : CategoryTheory.Iso (Fgt_W.obj U_W).left (Fgt₂.obj U₂).left)
        (hA : WeilCupPDTraceIsAffineRoofIso k W_bar Y₂ U_W U₂ eA)
        (hB : WeilCupPDTraceIsAffineRoofIso k W_bar Y₂ U_W U₂ eB),
        eA = eB →
        Ψ W_bar Y₂ U_W U₂ eA hA q = Ψ W_bar Y₂ U_W U₂ eB hB q := by
    intro eA eB hA hB hEq
    subst hEq
    rfl
  have hΨℓ_congr :
      ∀ (eA eB : CategoryTheory.Iso (Fgt_W.obj U_W).left (Fgt₂.obj U₂).left)
        (hA : WeilIsAffineRoofIso k W_bar Y₂ U_W U₂ eA)
        (hB : WeilIsAffineRoofIso k W_bar Y₂ U_W U₂ eB),
        eA = eB →
        Ψ_ℓ W_bar Y₂ U_W U₂ eA hA r₀ q = Ψ_ℓ W_bar Y₂ U_W U₂ eB hB r₀ q := by
    intro eA eB hA hB hEq
    subst hEq
    rfl
  let w_n := (Ψ W_bar Y₁ U_W U₁ (CategoryTheory.Iso.refl W) hRoof₁ q).symm z
  have hFact_n :
      Ψ Y₁ Y₂ U₁ U₂ e hOrig q z = Ψ W_bar Y₂ U_W U₂ e hRoof₂ q w_n := by
    have hTr := DFunLike.congr_fun
      (hΨ.1.2.1 W_bar Y₁ Y₂ U_W U₁ U₂ (CategoryTheory.Iso.refl W) e hRoof₁ hOrig hRoof₂' q) w_n
    change Ψ Y₁ Y₂ U₁ U₂ e hOrig q
        (Ψ W_bar Y₁ U_W U₁ (CategoryTheory.Iso.refl W) hRoof₁ q w_n) =
      Ψ W_bar Y₂ U_W U₂ (CategoryTheory.Iso.trans (CategoryTheory.Iso.refl W) e) hRoof₂' q w_n at hTr
    rw [(Ψ W_bar Y₁ U_W U₁ (CategoryTheory.Iso.refl W) hRoof₁ q).apply_symm_apply,
      hΨ_congr _ e hRoof₂' hRoof₂ he_trans] at hTr
    exact hTr
  let z_a := weilCupPDTraceLocCoeffMapH Y₁.left p_a U₁ q z
  let w_a := (Ψ_ℓ W_bar Y₁ U_W U₁ (CategoryTheory.Iso.refl W) hRoof₁ r₀ q).symm z_a
  have hFact_ℓ :
      Ψ_ℓ Y₁ Y₂ U₁ U₂ e hOrig r₀ q z_a = Ψ_ℓ W_bar Y₂ U_W U₂ e hRoof₂ r₀ q w_a := by
    have hTr := DFunLike.congr_fun
      (hΨ_ℓ.2.1 W_bar Y₁ Y₂ U_W U₁ U₂ (CategoryTheory.Iso.refl W) e hRoof₁ hOrig hRoof₂' r₀ q) w_a
    change Ψ_ℓ Y₁ Y₂ U₁ U₂ e hOrig r₀ q
        (Ψ_ℓ W_bar Y₁ U_W U₁ (CategoryTheory.Iso.refl W) hRoof₁ r₀ q w_a) =
      Ψ_ℓ W_bar Y₂ U_W U₂ (CategoryTheory.Iso.trans (CategoryTheory.Iso.refl W) e) hRoof₂' r₀ q w_a at hTr
    rw [(Ψ_ℓ W_bar Y₁ U_W U₁ (CategoryTheory.Iso.refl W) hRoof₁ r₀ q).apply_symm_apply,
      hΨℓ_congr _ e hRoof₂' hRoof₂ he_trans] at hTr
    exact hTr
  calc
    weilCupPDTraceLocCoeffMapH Y₂.left p_a U₂ q (Ψ Y₁ Y₂ U₁ U₂ e hOrig q z)
      = weilCupPDTraceLocCoeffMapH Y₂.left p_a U₂ q (Ψ W_bar Y₂ U_W U₂ e hRoof₂ q w_n) := by
          rw [hFact_n]
    _ = Ψ_ℓ W_bar Y₂ U_W U₂ e hRoof₂ r₀ q
          (weilCupPDTraceLocCoeffMapH W_bar.left p_a U_W q w_n) :=
          hSingleFwd W_bar Y₂ π₂ U_W U₂ e hRoof₂ hπ₂_hom hU₂_comm w_n
    _ = Ψ_ℓ W_bar Y₂ U_W U₂ e hRoof₂ r₀ q w_a :=
          congrArg (Ψ_ℓ W_bar Y₂ U_W U₂ e hRoof₂ r₀ q)
            (hSingleBack W_bar Y₁ π₁ U_W U₁ (CategoryTheory.Iso.refl W) hRoof₁ hπ₁_hom hU₁_comm z)
    _ = Ψ_ℓ Y₁ Y₂ U₁ U₂ e hOrig r₀ q z_a := hFact_ℓ.symm

theorem weil_cupPD_trace_pinned_polyP1_kummer_model (k : Type u) [Field k] [IsAlgClosed k]
    (n : ℕ) (hn : 1 ≤ n) (hUnit : IsUnit (n : k))
    (ζ : kˣ) (hPrim : IsPrimitiveRoot ((ζ : kˣ) : k) n)
    (Ψ : WeilCupPDTraceRoofSystem k n)
    (hΨ : WeilCupPDTraceIsPinnedRoof k n Ψ) :
    ∃ (ι_aff : ∀ δ : ℕ, Quiver.Hom (weilCupPDTraceAffineSpaceOver k δ).left
        (weilCupPDTracePolyP1Over k δ).left)
      (tr_Pd : ∀ δ : ℕ,
        weilEtaleTorsionH (weilCupPDTracePolyP1Over k δ).left n (2 * δ) →+ ZMod n),
      WeilCupPDTraceIsPolyP1ModelPkg k n Ψ ι_aff tr_Pd :=
by
  classical
  
  have hPoly_fun : weilCupPDTracePolyP1Over k = weilPolyP1Over k := by
    funext δ
    induction δ with
    | zero => rfl
    | succ δ ih =>
      exact congrArg
        (fun Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) =>
          CategoryTheory.Over.mk
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst Z.hom (weilProjectiveSpaceOver k 1).hom)
              Z.hom))
        ih
  have hAff_fun : weilCupPDTraceAffineSpaceOver k = weilAffineSpaceOver k := rfl

  
  obtain ⟨ι_P1, ι_aff, hCoord⟩ := weil_polyP1_coord_compactification_and_properness k
  have hClause1 : ∀ δ : ℕ,
      AlgebraicGeometry.IsProper (weilPolyP1Over k δ).hom ∧
      AlgebraicGeometry.IsOpenImmersion (ι_aff δ) ∧
      CategoryTheory.CategoryStruct.comp (ι_aff δ) (weilPolyP1Over k δ).hom =
        (weilAffineSpaceOver k δ).hom := by
    intro δ
    have hδ := hCoord.2.2.2.2.2.2.2.2 δ
    exact ⟨hδ.1, hδ.2.1, hδ.2.2.1⟩

  
  have hHallPeel : ∀ m : ℕ, 1 ≤ m → m ∣ n → Nat.Coprime m (n / m) →
      m = 1 ∨
      (∃ ℓ r₀ : ℕ, Nat.Prime ℓ ∧ 1 ≤ r₀ ∧ m = ℓ ^ r₀) ∨
      (∃ a b : ℕ, 1 ≤ a ∧ 1 ≤ b ∧ a < a * b ∧ b < a * b ∧
        Nat.Coprime a b ∧ a ∣ n ∧ b ∣ n ∧
        Nat.Coprime a (n / a) ∧ Nat.Coprime b (n / b) ∧ m = a * b) := by
    intro m hm_pos hm_dvd hm_cop
    by_cases hm1 : m = 1
    · exact Or.inl hm1
    · have hm2 : 2 ≤ m := by omega
      let ℓ : ℕ := m.minFac
      have hPrime : Nat.Prime ℓ := Nat.minFac_prime hm1
      let r₀ : ℕ := m.factorization ℓ
      have hr₀ : 1 ≤ r₀ :=
        (hPrime.dvd_iff_one_le_factorization (by omega)).mp (Nat.minFac_dvd m)
      let a : ℕ := ℓ ^ r₀
      let b : ℕ := m / a
      have hab : a * b = m := Nat.ordProj_mul_ordCompl_eq_self m ℓ
      have hcop_ab : Nat.Coprime a b :=
        (Nat.coprime_ordCompl hPrime (by omega)).pow_left r₀
      have ha2 : 2 ≤ a := by
        calc 2 ≤ ℓ ^ 1 := (pow_one ℓ).symm ▸ hPrime.two_le
          _ ≤ ℓ ^ r₀ := Nat.pow_le_pow_right hPrime.pos hr₀
      by_cases hb1 : b = 1
      · right; left
        refine ⟨ℓ, r₀, hPrime, hr₀, ?_⟩
        rw [← hab, hb1, mul_one]
      · have hb0 : b ≠ 0 := by
          intro h0
          rw [h0, mul_zero] at hab
          omega
        have hb2 : 2 ≤ b := by
          match b, hb0, hb1 with
          | 0, h, _ => exact absurd rfl h
          | 1, _, h => exact absurd rfl h
          | c₀ + 2, _, _ => exact Nat.le_add_left 2 c₀
        right; right
        have ha_lt : a < a * b := lt_mul_of_one_lt_right (by omega) hb2
        have hb_lt : b < a * b := lt_mul_of_one_lt_left (by omega) ha2
        let c : ℕ := n / m
        have hnc : m * c = n := Nat.mul_div_cancel' hm_dvd
        have hcop_mc : Nat.Coprime (a * b) c := hab ▸ hm_cop
        have hcop_ac : Nat.Coprime a c :=
          Nat.Coprime.coprime_dvd_left (dvd_mul_right a b) hcop_mc
        have hcop_bc : Nat.Coprime b c :=
          Nat.Coprime.coprime_dvd_left (dvd_mul_left b a) hcop_mc
        have hna : n / a = b * c := by
          have hn_eq : a * (b * c) = n := by rw [← mul_assoc, hab, hnc]
          rw [← hn_eq, Nat.mul_div_right (b * c) (by omega)]
        have hnb : n / b = a * c := by
          have hn_eq : b * (a * c) = n := by rw [← mul_assoc, mul_comm b a, hab, hnc]
          rw [← hn_eq, Nat.mul_div_right (a * c) (by omega)]
        refine ⟨a, b, by omega, by omega, ha_lt, hb_lt, hcop_ab,
          dvd_trans (hab ▸ dvd_mul_right a b) hm_dvd,
          dvd_trans (hab ▸ dvd_mul_left b a) hm_dvd,
          hna ▸ hcop_ab.mul_right hcop_ac,
          hnb ▸ hcop_ab.symm.mul_right hcop_bc,
          hab.symm⟩

  
  have hCoeffCRT := @weil_cupPD_trace_coeff_functoriality_and_crt_equiv
  have hHallInd : ∀ m : ℕ,
      1 ≤ m →
      ∀ (hm_dvd : m ∣ n),
      Nat.Coprime m (n / m) →
      ∃ tr_m : ∀ δ : ℕ, weilEtaleTorsionH (weilPolyP1Over k δ).left m (2 * δ) →+ ZMod m,
        WeilCupPDTraceHallStepPkg k n Ψ (weilPolyP1Over k) ι_aff m hm_dvd tr_m := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
      intro hm_pos hm_dvd hm_cop
      rcases hHallPeel m hm_pos hm_dvd hm_cop with
        rfl | ⟨ℓ, r₀, hPrime, hr₀, rfl⟩ |
        ⟨a, b, ha_pos, hb_pos, ha_lt, hb_lt, hcop_ab, ha_dvd, hb_dvd, ha_cop, hb_cop, rfl⟩
      · 
        have : Subsingleton (ZMod 1) := ZMod.subsingleton_iff.mpr rfl
        refine ⟨fun _ => 0, ?_, ?_, ?_, ?_⟩
        · have : Subsingleton (weilEtaleTorsionH (weilPolyP1Over k 0).left 1 (2 * 0)) :=
            ((hCoeffCRT (weilPolyP1Over k 0).left).2.2.2.1 (2 * 0)).1
          exact ⟨fun x y _ => Subsingleton.elim x y, fun y => ⟨0, Subsingleton.elim _ y⟩⟩
        · intro δ q U _ _
          exact ((hCoeffCRT (weilPolyP1Over k δ).left).2.2.2.1 q).2 U
        · intro _ _ _ _ _ _ _ _ _ _ _ _ _ _
          exact Subsingleton.elim _ _
        · intro δ V U _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
          have : Subsingleton
              (weilCupPDTraceLocalTorsionH (weilPolyP1Over k (δ + 1)).left 1 U (2 * (δ + 1))) :=
            ((hCoeffCRT (weilPolyP1Over k (δ + 1)).left).2.2.2.1 (2 * (δ + 1))).2 U
          exact ⟨fun x y _ => Subsingleton.elim x y, fun y => ⟨0, Subsingleton.elim _ y⟩⟩
      · 
        letI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
        have hℓ : ℓ ≠ ringChar k := by
          intro hchar
          have hℓ_dvd_pow : ℓ ∣ ℓ ^ r₀ := dvd_pow_self ℓ (by omega)
          obtain ⟨c, hc⟩ := dvd_trans hℓ_dvd_pow hm_dvd
          have hℓ0 : (ℓ : k) = 0 := by
            rw [hchar]
            exact CharP.cast_eq_zero k (ringChar k)
          have hn0 : (n : k) = 0 := by
            rw [hc, Nat.cast_mul, hℓ0, zero_mul]
          exact hUnit.ne_zero hn0
        obtain ⟨ζ_tower, hPrim_t, hPow_t⟩ :=
          weil_cupPD_trace_prime_pow_root_tower k n ℓ r₀ hn hr₀ hm_dvd ζ hPrim
        obtain ⟨Ψ_ℓ, hΨ_ℓ⟩ := weil_etale_pinned_compact_support_roof_transfer k ℓ hℓ
        have hCD_pkg := weil_polyP1_torsion_cohomological_dim_vanishing k ℓ hℓ
        obtain ⟨tr_ℓ, hBij_ℓ, _, hTrace_ℓ⟩ :=
          weil_polyP1_kummer_leray_trace_tower k ℓ hℓ ζ_tower hPrim_t hPow_t ι_P1 ι_aff hCoord
            (fun δ r F q hTor hq => (hCD_pkg δ r).1 F q hTor hq)
        refine ⟨fun δ => tr_ℓ δ r₀, hBij_ℓ 0 r₀, ?_, ?_, ?_⟩
        · intro δ q U hAff hq
          exact (hCD_pkg δ r₀).2 q U hAff hq
        · intro δ j U₁ U₂ u₁ u₂ e h hu₁ hu₂ hcomp₁ hcomp₂ hagree z
          have hRoofCompat :=
            weil_cupPD_trace_pinned_roof_castHom_compat k n ℓ r₀ hm_dvd Ψ hΨ Ψ_ℓ hΨ_ℓ
              (weilPolyP1Over k δ) (weilPolyP1Over k δ) U₁ U₂ e h (2 * δ) z
          dsimp only at hRoofCompat
          rw [hRoofCompat]
          set z₁ : weilEtaleLocalTorsionH (weilPolyP1Over k δ).left (ℓ ^ r₀) U₁ (2 * δ) :=
            weilCupPDTraceLocCoeffMapH (weilPolyP1Over k δ).left
              (ZMod.castHom hm_dvd (ZMod (ℓ ^ r₀))).toAddMonoidHom U₁ (2 * δ) z
          cases δ with
          | zero => exact Fin.elim0 j
          | succ m₀ =>
            let P := weilPolyP1Over k (m₀ + 1)
            let Fgt := AlgebraicGeometry.Scheme.Etale.forget P.left
            let W₁ := (Fgt.obj U₁).left
            let W₂ := (Fgt.obj U₂).left
            have hProp : AlgebraicGeometry.IsProper P.hom := h.1
            have hAff₁ : AlgebraicGeometry.IsAffine W₁ := h.2.2.1
            have he_over :
                CategoryTheory.CategoryStruct.comp e.hom
                  (CategoryTheory.CategoryStruct.comp (Fgt.obj U₂).hom P.hom) =
                CategoryTheory.CategoryStruct.comp (Fgt.obj U₁).hom P.hom := h.2.2.2
            have hAff₂ : AlgebraicGeometry.IsAffine W₂ :=
              (AlgebraicGeometry.IsAffine.iff_of_isIso e.hom).mp hAff₁
            obtain ⟨α_j, β_j, hβ_over, hαβ, hα_pr, hSwapTr⟩ :=
              weil_polyP1_pinned_coord_swap_trace_invariance k ℓ hℓ ζ_tower hPrim_t hPow_t Ψ_ℓ hΨ_ℓ
                ι_P1 ι_aff hCoord tr_ℓ hBij_ℓ hTrace_ℓ m₀ j
            have hEt_U₁ : AlgebraicGeometry.Etale (Fgt.obj U₁).hom := U₁.prop
            have hEt_U₂ : AlgebraicGeometry.Etale (Fgt.obj U₂).hom := U₂.prop
            have hEt_β : AlgebraicGeometry.Etale β_j.hom := inferInstance
            have hEt₁' : AlgebraicGeometry.Etale ((Fgt.obj U₁).hom ≫ β_j.hom) := inferInstance
            have hEt₂' : AlgebraicGeometry.Etale ((Fgt.obj U₂).hom ≫ β_j.hom) := inferInstance
            let U'₁ : P.left.Etale :=
              CategoryTheory.MorphismProperty.Over.mk ⊤ ((Fgt.obj U₁).hom ≫ β_j.hom) hEt₁'
            let U'₂ : P.left.Etale :=
              CategoryTheory.MorphismProperty.Over.mk ⊤ ((Fgt.obj U₂).hom ≫ β_j.hom) hEt₂'
            let e₀₁ : CategoryTheory.Iso (Fgt.obj U₁).left (Fgt.obj U'₁).left :=
              CategoryTheory.Iso.refl W₁
            let e₀₂ : CategoryTheory.Iso (Fgt.obj U₂).left (Fgt.obj U'₂).left :=
              CategoryTheory.Iso.refl W₂
            let e' : CategoryTheory.Iso (Fgt.obj U'₁).left (Fgt.obj U'₂).left := e
            let e_top : CategoryTheory.Iso (Fgt.obj U₁).left (Fgt.obj U'₂).left := e
            have h₀₁ : WeilIsAffineRoofIso k P P U₁ U'₁ e₀₁ := by
              refine ⟨hProp, hProp, hAff₁, ?_⟩
              change 𝟙 W₁ ≫ (((Fgt.obj U₁).hom ≫ β_j.hom) ≫ P.hom) = (Fgt.obj U₁).hom ≫ P.hom
              rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hβ_over]
            have h₀₂ : WeilIsAffineRoofIso k P P U₂ U'₂ e₀₂ := by
              refine ⟨hProp, hProp, hAff₂, ?_⟩
              change 𝟙 W₂ ≫ (((Fgt.obj U₂).hom ≫ β_j.hom) ≫ P.hom) = (Fgt.obj U₂).hom ≫ P.hom
              rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hβ_over]
            have h' : WeilIsAffineRoofIso k P P U'₁ U'₂ e' := by
              refine ⟨hProp, hProp, hAff₁, ?_⟩
              change e.hom ≫ (((Fgt.obj U₂).hom ≫ β_j.hom) ≫ P.hom) =
                ((Fgt.obj U₁).hom ≫ β_j.hom) ≫ P.hom
              rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hβ_over]
              exact he_over
            have h_top : WeilIsAffineRoofIso k P P U₁ U'₂ e_top := by
              refine ⟨hProp, hProp, hAff₁, ?_⟩
              change e.hom ≫ (((Fgt.obj U₂).hom ≫ β_j.hom) ≫ P.hom) = (Fgt.obj U₁).hom ≫ P.hom
              rw [CategoryTheory.Category.assoc, hβ_over]
              exact he_over
            have he_left : CategoryTheory.Iso.trans e₀₁ e' = e_top := by
              ext1
              exact CategoryTheory.Category.id_comp e.hom
            have he_right : CategoryTheory.Iso.trans e e₀₂ = e_top := by
              ext1
              exact CategoryTheory.Category.comp_id e.hom
            have h₁₃_left : WeilIsAffineRoofIso k P P U₁ U'₂ (CategoryTheory.Iso.trans e₀₁ e') :=
              he_left.symm ▸ h_top
            have h₁₃_right : WeilIsAffineRoofIso k P P U₁ U'₂ (CategoryTheory.Iso.trans e e₀₂) :=
              he_right.symm ▸ h_top
            have hΨ_eq :
                ∀ (eA eB : CategoryTheory.Iso (Fgt.obj U₁).left (Fgt.obj U'₂).left)
                  (hA : WeilIsAffineRoofIso k P P U₁ U'₂ eA)
                  (hB : WeilIsAffineRoofIso k P P U₁ U'₂ eB),
                  eA = eB →
                  Ψ_ℓ P P U₁ U'₂ eA hA r₀ (2 * (m₀ + 1)) z₁ =
                    Ψ_ℓ P P U₁ U'₂ eB hB r₀ (2 * (m₀ + 1)) z₁ := by
              intro eA eB hA hB hEq
              subst hEq
              rfl
            have hEt_α : AlgebraicGeometry.Etale α_j.hom := inferInstance
            let u₁_hom : W₁ ⟶ (weilAffineSpaceOver k (m₀ + 1)).left := u₁
            let u₂_hom : W₂ ⟶ (weilAffineSpaceOver k (m₀ + 1)).left := u₂
            have hEt_u₁ : AlgebraicGeometry.Etale u₁_hom := hu₁
            have hEt_u₂ : AlgebraicGeometry.Etale u₂_hom := hu₂
            let u'₁ : Quiver.Hom (Fgt.obj U'₁).left (weilAffineSpaceOver k (m₀ + 1)).left :=
              u₁_hom ≫ α_j.hom
            let u'₂ : Quiver.Hom (Fgt.obj U'₂).left (weilAffineSpaceOver k (m₀ + 1)).left :=
              u₂_hom ≫ α_j.hom
