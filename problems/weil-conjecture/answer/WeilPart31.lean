          let R_m_cat : CommRingCat.{u} := W_m.toScheme.presheaf.obj (Opposite.op ⊤)
          let R_m : Type u := ↑R_m_cat
          let e_Wm : W_m.toScheme ≅ AlgebraicGeometry.Spec R_m_cat := W_m.toScheme.isoSpec
          have hEt_wp : Etale w_p.left :=
            MorphismProperty.of_postcomp Et_prop w_p.left (V_pt pt).hom
