        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F hS,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G hSF,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass (F.comp G) hS,
