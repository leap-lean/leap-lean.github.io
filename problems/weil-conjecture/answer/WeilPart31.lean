            rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id, hLift_fg])))
    let e_push_U : (U_fun Z ⋙ i_push_ab) ≅ (i_push ⋙ U_fun Y) :=
      CategoryTheory.NatIso.ofComponents
        (fun 𝒢 =>
          { hom := CategoryTheory.ObjectProperty.homMk
              { app := fun _ => 𝟙 _
                naturality := fun {_ _} _ =>
                  (CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm }
            inv := CategoryTheory.ObjectProperty.homMk
              { app := fun _ => 𝟙 _
                naturality := fun {_ _} _ =>
                  (CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm }
            hom_inv_id := CategoryTheory.Sheaf.hom_ext
              (CategoryTheory.NatTrans.ext (funext fun _ => CategoryTheory.Category.id_comp _))
            inv_hom_id := CategoryTheory.Sheaf.hom_ext
              (CategoryTheory.NatTrans.ext (funext fun _ => CategoryTheory.Category.id_comp _)) })
        (fun {_ _} _ => CategoryTheory.Sheaf.hom_ext
          (CategoryTheory.NatTrans.ext (funext fun _ =>
            (CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)))
    let adj_mod : P_pull_mod ⊣ i_push :=
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun ℱ 𝒢 =>
            { toFun := fun f =>
                (U_equiv ℱ (i_push.obj 𝒢)).symm
                  (adj_ab.homEquiv ((U_fun Y).obj ℱ) ((U_fun Z).obj 𝒢)
