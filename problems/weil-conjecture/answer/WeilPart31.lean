        (x₁ x₂ : CategoryTheory.Abelian.Ext.{u} X Y a)
        (z : CategoryTheory.Abelian.Ext.{u} Y W b) (h : a + b = c),
        (x₁ - x₂).comp z h = x₁.comp z h - x₂.comp z h := by
      intro X Y W a b c x₁ x₂ z h
      rw [eq_sub_iff_add_eq, ← CategoryTheory.Abelian.Ext.add_comp, sub_add_cancel]
    have addHomToLinear : ∀ {M : Type u} [AddCommGroup M] [Module R M]
