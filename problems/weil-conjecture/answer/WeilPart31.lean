        [AddCommGroup M₂] [Module R M₂] (D_map : M₁ →ₗ[R] M₂) (lam : M₁ →ₗ[R] R),
        (∀ x : M₁, D_map x = 0 → lam x = 0) →
        ∃ μ : M₂ →ₗ[R] R, μ.comp D_map = lam := by
      intro M₁ M₂ _ _ _ _ D_map lam hker
      have hle : LinearMap.ker D_map ≤ LinearMap.ker lam := fun x hx => hker x hx
      let μ_sub : LinearMap.range D_map →ₗ[R] R :=
        ((LinearMap.ker D_map).liftQ lam hle).comp D_map.quotKerEquivRange.symm.toLinearMap
      obtain ⟨μ, hμ⟩ := Module.Injective.out (LinearMap.range D_map).subtype
