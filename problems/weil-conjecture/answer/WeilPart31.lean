    let P_pull_mod : CategoryTheory.Functor
        (CategoryTheory.Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R))
        (CategoryTheory.Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)) :=
      { obj := fun ℱ => ⟨P_pre ℱ, hP_pre_sheaf ℱ⟩
        map := fun {ℱ₁ ℱ₂} u => CategoryTheory.ObjectProperty.homMk
          { app := fun opV => liftLinear ((P_pull_ab.map ((U_fun Y).map u)).hom.app opV)
            naturality := fun {opV₁ opV₂} g => ModuleCat.hom_ext (LinearMap.ext fun x => by
