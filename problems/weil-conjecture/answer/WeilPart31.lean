            rcases hx with hx₁ | hx₂
            · exact ⟨T₁, ι₁, ⟨x, hx₁⟩, h_sieve₁, inferInstance, rfl⟩
            · exact ⟨T₂, ι₂, ⟨x, hx₂⟩, h_sieve₂, inferInstance, rfl⟩
        have heq_mem : (CategoryTheory.Presheaf.imageSieve g_sub s ∈ Y.smallEtaleTopology T) =
            (R' ∈
              (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := Y)).toGrothendieck T') :=
