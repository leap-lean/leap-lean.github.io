  have hSingleShift : ∀ (q : ℕ)
      (Y I : ℕ → 𝒞)
      (ι_Y : ∀ s : ℕ, Y s ⟶ I s)
      (π_Y : ∀ s : ℕ, I s ⟶ Y (s + 1))
      (hz_Y : ∀ s : ℕ, ι_Y s ≫ π_Y s = 0)
      (hEx_Y : ∀ s : ℕ, (ShortComplex.mk (ι_Y s) (π_Y s) (hz_Y s)).ShortExact)
      (Z_t J_t : ℕ → 𝒞)
      (ι_t : ∀ p : ℕ, Z_t p ⟶ J_t p)
      (π_t : ∀ p : ℕ, J_t p ⟶ Z_t (p + 1))
      (hd_t : ∀ p : ℕ, (π_t p ≫ ι_t (p + 1)) ≫ (π_t (p + 1) ≫ ι_t (p + 2)) = 0)
      (hat_ψ_q : Y 0 ⟶ Z_t q)
      (f_q : ∀ s : ℕ, I s ⟶ J_t (q + s))
      (hf0_q : ι_Y 0 ≫ f_q 0 = hat_ψ_q ≫ ι_t q)
      (hfSucc_q : ∀ s : ℕ,
        (π_Y s ≫ ι_Y (s + 1)) ≫ f_q (s + 1) =
          f_q s ≫ (π_t (q + s) ≫ ι_t (q + s + 1))),
      let K_t : CochainComplex 𝒞 ℕ :=
        CochainComplex.of J_t (fun p => π_t p ≫ ι_t (p + 1)) hd_t
      ∃ (S : CochainComplex 𝒞 ℕ) (Φ_q : S ⟶ K_t)
        (e_X : ∀ s : ℕ, I s ≅ S.X (s + q))
        (e_cyc_S : Y 0 ≅ S.cycles q),
        (∀ p : ℕ, p < q → Limits.IsZero (S.X p)) ∧
        ((∀ s : ℕ, Injective (I s)) → ∀ p : ℕ, Injective (S.X p)) ∧
