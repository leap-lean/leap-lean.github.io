  have hTermCounitBij : ∀ (S : Scheme.{u}) (m q : ℕ),
      Function.Bijective (weilCupPDTraceLocalTorsionCounitH S m (weilEtaleIdTerminal S) q) := by
    intro S m q
    let T_S := weilEtaleIdTerminal S
    let hT_S := weilEtaleIdTerminalIsTerminal S
    let J := S.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let LT := weilCupPDTraceLocalTorsionSheaf S m T_S
    let FM := weilEtaleTorsionSheaf S m
    let counit := weilCupPDTraceLocalTorsionCounit S m T_S
    let P_const : Opposite S.Etale ⥤ AddCommGrpCat.{u} := (Functor.const (Opposite S.Etale)).obj AM
    let adj_sh := sheafificationAdjunction J AddCommGrpCat.{u}
    let inv_pre : P_const ⟶ (sheafToPresheaf J AddCommGrpCat.{u}).obj LT :=
      { app := fun U =>
          Sheaf.freeYonedaHomEquiv (𝟙 LT) ≫ LT.obj.map (Opposite.op (hT_S.from (Opposite.unop U)))
        naturality := fun U₁ U₂ g => by
          dsimp [P_const]
          rw [Category.id_comp, Category.assoc, ← LT.obj.map_comp]
          congr 2
          exact Opposite.unop_injective (hT_S.hom_ext _ _) }
    let inv_c : FM ⟶ LT := (adj_sh.homEquiv P_const LT).symm inv_pre
    have hcounit : Sheaf.freeYonedaHomEquiv counit =
        (adj_sh.unit.app P_const).app (Opposite.op T_S) :=
      Equiv.apply_symm_apply _ _
    have h_inv_eq :
        adj_sh.unit.app P_const ≫ (sheafToPresheaf J AddCommGrpCat.{u}).map inv_c = inv_pre :=
      (adj_sh.homEquiv_unit P_const LT inv_c).symm.trans (Equiv.apply_symm_apply _ _)
    have hci : counit ≫ inv_c = 𝟙 LT := by
      apply Sheaf.freeYonedaHomEquiv.injective
      rw [hEquivNat S counit inv_c, hcounit]
      have happ := congrArg (fun η => η.app (Opposite.op T_S)) h_inv_eq
      dsimp [inv_pre] at happ
      have h_id_T : Opposite.op (hT_S.from T_S) = 𝟙 (Opposite.op T_S) :=
        Opposite.unop_injective (hT_S.hom_ext _ _)
      rw [h_id_T, LT.obj.map_id, Category.comp_id] at happ
      exact happ
    have hic : inv_c ≫ counit = 𝟙 FM := by
      let S_fgt := sheafToPresheaf J AddCommGrpCat.{u}
      let FM' : Sheaf J AddCommGrpCat.{u} := (presheafToSheaf J AddCommGrpCat.{u}).obj P_const
      let inv_c' : FM' ⟶ LT := inv_c
      let counit' : LT ⟶ FM' := counit
      let ξ₀ := Sheaf.freeYonedaHomEquiv (𝟙 LT)
      have h_id_eq : ξ₀ ≫ counit'.hom.app (Opposite.op T_S) =
          (adj_sh.unit.app P_const).app (Opposite.op T_S) :=
        ((hEquivNat S (𝟙 LT) counit').symm.trans
          (congrArg Sheaf.freeYonedaHomEquiv (Category.id_comp counit'))).trans hcounit
      have h_nat_eq : inv_pre ≫ S_fgt.map counit' = adj_sh.unit.app P_const :=
        NatTrans.ext (funext fun U =>
          let f_U : Opposite.op T_S ⟶ U := Opposite.op (hT_S.from (Opposite.unop U))
          have h_u : (adj_sh.unit.app P_const).app (Opposite.op T_S) ≫ FM'.obj.map f_U =
              (adj_sh.unit.app P_const).app U :=
            ((adj_sh.unit.app P_const).naturality f_U).symm.trans
              (Category.id_comp ((adj_sh.unit.app P_const).app U))
          (Category.assoc ξ₀ (LT.obj.map f_U) (counit'.hom.app U)).trans
            ((congrArg (ξ₀ ≫ ·) (counit'.hom.naturality f_U)).trans
              ((Category.assoc ξ₀ (counit'.hom.app (Opposite.op T_S))
                (FM'.obj.map f_U)).symm.trans
                ((congrArg (· ≫ FM'.obj.map f_U) h_id_eq).trans h_u))))
      have h1 : adj_sh.homEquiv P_const LT inv_c' = inv_pre := Equiv.apply_symm_apply _ _
      have h2 : adj_sh.homEquiv P_const FM' (𝟙 FM') = adj_sh.unit.app P_const :=
        (adj_sh.homEquiv_unit P_const FM' (𝟙 FM')).trans
          ((congrArg (adj_sh.unit.app P_const ≫ ·) (S_fgt.map_id FM')).trans
            (Category.comp_id (adj_sh.unit.app P_const)))
      exact (adj_sh.homEquiv P_const FM').injective
        ((adj_sh.homEquiv_naturality_right inv_c' counit').trans
          ((congrArg (· ≫ S_fgt.map counit') h1).trans (h_nat_eq.trans h2.symm)))
    rw [Function.bijective_iff_has_inverse]
    let Fℤ_S := (constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    refine ⟨(Abelian.Ext.mk₀ inv_c).postcomp Fℤ_S (Nat.add_zero q), fun z => ?_, fun w => ?_⟩
    · change (z.comp (Abelian.Ext.mk₀ counit) (Nat.add_zero q)).comp
