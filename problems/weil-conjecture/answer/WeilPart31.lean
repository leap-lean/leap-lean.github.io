      have he0 : e.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (q + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₃, rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₀ hS e he0 (rfl : q + 1 = q + 1)
      have hSF : (S.map F).ShortExact := hS.map_of_exact F
      have hSG : (S.map G).ShortExact := hS.map_of_exact G
      let φ_S : S.map F ⟶ S.map G :=
        { τ₁ := θ.app S.X₁
          τ₂ := θ.app S.X₂
          τ₃ := θ.app S.X₃
          comm₁₂ := (θ.naturality S.f).symm
          comm₂₃ := (θ.naturality S.g).symm }
      have h_ext_nat := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSF hSG φ_S
      have ihx := ih X₀ S.X₃ x₃
      simp only [CategoryTheory.Functor.mapExtAddHom_apply] at ihx ⊢
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F hS,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G hS,
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (rfl : q + 1 = q + 1),
        h_ext_nat,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (rfl : q + 1 = q + 1),
        ihx,
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add q) (rfl : q + 1 = q + 1) (by omega)]

  have h_conj_ext_iso : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C]
