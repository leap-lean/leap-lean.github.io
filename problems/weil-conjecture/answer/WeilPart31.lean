      exact ⟨π_q, hz_q, CategoryTheory.ShortComplex.ShortExact.mk' hex_S (hι_mono q) hπ_epi⟩
    have hStepZ : ∀ (q k : ℕ), 1 ≤ k →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (Z (q + 1)) k) →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (Z q) (k + 1)) := by
      intro q k hk hSubNext
      obtain ⟨π_q, hz_q, hSq⟩ := hShortZ q
      have hSubT : Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR ((𝒯 q).obj F) (k + 1)) :=
        hAcyc q (k + 1) (by omega) F
      have hzero_ext : ∀ x : CategoryTheory.Abelian.Ext.{u} oneR (Z q) (k + 1), x = 0 := by
