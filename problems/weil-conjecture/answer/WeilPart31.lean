    ← hExtComp P_pull_R U_src_0 One_tgt One_tgt i α,
    hExtIso (U_tgt_0.comp P_pull_Z) (P_pull_R.comp U_src_0) Φ_inv One_tgt One_tgt i α,
    hExtComp U_tgt_0 P_pull_Z One_tgt One_tgt i α]
  let y := (P_pull_Z.mapExtAddHom (U_tgt_0.obj One_tgt) (U_tgt_0.obj One_tgt) i)
    ((U_tgt_0.mapExtAddHom One_tgt One_tgt i) α)
  have hCollapse := ext_conj_eq (ηℤ_src ≫ U_src_0.map η_R) (Φ_inv.inv.app One_tgt)
    (Φ_inv.hom.app One_tgt) (U_src_0.map ε_R ≫ βM_src) y
  rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (ηℤ_src ≫ U_src_0.map η_R)) _ _
    (Nat.zero_add i) (Nat.add_zero i) (by omega)]
  exact hCollapse.trans (by rw [hLeft_end, hRight_end])

theorem weil_etale_external_cup_product_frob_system (K : Type u) [Finite K] [Field K]
    (X₁ X₂ W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    (pr₁ : Quiver.Hom (weilGeomScheme K W) (weilGeomScheme K X₁))
    (pr₂ : Quiver.Hom (weilGeomScheme K W) (weilGeomScheme K X₂))
    (hFrob₁ : CategoryTheory.CategoryStruct.comp (weilGeomFrobHom K W) pr₁ =
      CategoryTheory.CategoryStruct.comp pr₁ (weilGeomFrobHom K X₁))
    (hFrob₂ : CategoryTheory.CategoryStruct.comp (weilGeomFrobHom K W) pr₂ =
      CategoryTheory.CategoryStruct.comp pr₂ (weilGeomFrobHom K X₂))
    (ℓ i₁ i₂ : ℕ)
    (f₁ : ∀ r : ℕ, weilEtaleTorsionH (weilGeomScheme K X₁) (ℓ ^ r) i₁ →+
      weilEtaleTorsionH (weilGeomScheme K X₁) (ℓ ^ r) i₁)
    (f₂ : ∀ r : ℕ, weilEtaleTorsionH (weilGeomScheme K X₂) (ℓ ^ r) i₂ →+
      weilEtaleTorsionH (weilGeomScheme K X₂) (ℓ ^ r) i₂)
    (f_W : ∀ r : ℕ, weilEtaleTorsionH (weilGeomScheme K W) (ℓ ^ r) (i₁ + i₂) →+
      weilEtaleTorsionH (weilGeomScheme K W) (ℓ ^ r) (i₁ + i₂))
    (hf₁ : ∀ r : ℕ, WeilIsTorsionGeomFrobAction K X₁ (ℓ ^ r) i₁ (f₁ r))
    (hf₂ : ∀ r : ℕ, WeilIsTorsionGeomFrobAction K X₂ (ℓ ^ r) i₂ (f₂ r))
    (hf_W : ∀ r : ℕ, WeilIsTorsionGeomFrobAction K W (ℓ ^ r) (i₁ + i₂) (f_W r)) :
    (∀ (r : ℕ) (c₁ : weilEtaleTorsionH (weilGeomScheme K X₁) (ℓ ^ (r + 1)) i₁),
      weilEtaleTorsionTransition (weilGeomScheme K X₁) ℓ r i₁ (f₁ (r + 1) c₁) =
        f₁ r (weilEtaleTorsionTransition (weilGeomScheme K X₁) ℓ r i₁ c₁)) ∧
    (∀ (r : ℕ) (c₂ : weilEtaleTorsionH (weilGeomScheme K X₂) (ℓ ^ (r + 1)) i₂),
      weilEtaleTorsionTransition (weilGeomScheme K X₂) ℓ r i₂ (f₂ (r + 1) c₂) =
        f₂ r (weilEtaleTorsionTransition (weilGeomScheme K X₂) ℓ r i₂ c₂)) ∧
    ∃ μ : ∀ r : ℕ, weilEtaleTorsionH (weilGeomScheme K X₁) (ℓ ^ r) i₁ →+
        weilEtaleTorsionH (weilGeomScheme K X₂) (ℓ ^ r) i₂ →+
        weilEtaleTorsionH (weilGeomScheme K W) (ℓ ^ r) (i₁ + i₂),
      (∀ r : ℕ, WeilIsEtaleExternalCupProduct.{u}
        (weilGeomScheme K X₁) (weilGeomScheme K X₂) (weilGeomScheme K W)
        pr₁ pr₂ (ℓ ^ r) i₁ i₂ (μ r)) ∧
      (∀ (r : ℕ)
        (c₁ : weilEtaleTorsionH (weilGeomScheme K X₁) (ℓ ^ (r + 1)) i₁)
        (c₂ : weilEtaleTorsionH (weilGeomScheme K X₂) (ℓ ^ (r + 1)) i₂),
        weilEtaleTorsionTransition (weilGeomScheme K W) ℓ r (i₁ + i₂) (μ (r + 1) c₁ c₂) =
          μ r (weilEtaleTorsionTransition (weilGeomScheme K X₁) ℓ r i₁ c₁)
            (weilEtaleTorsionTransition (weilGeomScheme K X₂) ℓ r i₂ c₂)) ∧
      (∀ (r : ℕ)
        (c₁ : weilEtaleTorsionH (weilGeomScheme K X₁) (ℓ ^ r) i₁)
        (c₂ : weilEtaleTorsionH (weilGeomScheme K X₂) (ℓ ^ r) i₂),
        f_W r (μ r c₁ c₂) = μ r (f₁ r c₁) (f₂ r c₂)) :=
by
  classical
  obtain ⟨hPullTorsEx, _, hPullTorsComp, hPullTorsTrans, hFrobEqPull⟩ :=
    weil_etale_torsion_pullback_functoriality
  obtain ⟨hModCmp, hCupTransW, hFrobPkg⟩ := weil_etale_module_ext_comparison
  refine ⟨?_, ?_, ?_⟩
  · intro r c₁
    exact (hFrobPkg K X₁).2.1 ℓ r i₁ (f₁ (r + 1)) (f₁ r) (hf₁ (r + 1)) (hf₁ r) c₁
  · intro r c₂
    exact (hFrobPkg K X₂).2.1 ℓ r i₂ (f₂ (r + 1)) (f₂ r) (hf₂ (r + 1)) (hf₂ r) c₂
  · let S₁ := weilGeomScheme K X₁
    let S₂ := weilGeomScheme K X₂
    let S_W := weilGeomScheme K W
    choose Θ₁ hΘ₁_spec using fun r : ℕ => (hModCmp S₁ (ℓ ^ r) i₁).1
    choose Θ₂ hΘ₂_spec using fun r : ℕ => (hModCmp S₂ (ℓ ^ r) i₂).1
    choose Θ_W hΘW_spec using fun r : ℕ => (hModCmp S_W (ℓ ^ r) (i₁ + i₂)).1
    choose Θ_Wi₁ hΘWi₁_spec using fun r : ℕ => (hModCmp S_W (ℓ ^ r) i₁).1
    have hΘWi₁ : ∀ r : ℕ, WeilIsModuleToTorsionComparison S_W (ℓ ^ r) i₁ (Θ_Wi₁ r) :=
      fun r => (hΘWi₁_spec r).1
    choose Θ_Wi₂ hΘWi₂_spec using fun r : ℕ => (hModCmp S_W (ℓ ^ r) i₂).1
    have hΘWi₂ : ∀ r : ℕ, WeilIsModuleToTorsionComparison S_W (ℓ ^ r) i₂ (Θ_Wi₂ r) :=
      fun r => (hΘWi₂_spec r).1
    obtain ⟨inv₁, hinv₁_left, hinv₁_right⟩ :
        ∃ inv₁ : ∀ r : ℕ, weilEtaleTorsionH S₁ (ℓ ^ r) i₁ →+ weilEtaleModuleH S₁ (ℓ ^ r) i₁,
          (∀ r α₁, inv₁ r (Θ₁ r α₁) = α₁) ∧ (∀ r c₁, Θ₁ r (inv₁ r c₁) = c₁) :=
      ⟨fun r => (AddEquiv.ofBijective (Θ₁ r) (hΘ₁_spec r).2).symm.toAddMonoidHom,
       fun r α₁ => (AddEquiv.ofBijective (Θ₁ r) (hΘ₁_spec r).2).symm_apply_apply α₁,
       fun r c₁ => (AddEquiv.ofBijective (Θ₁ r) (hΘ₁_spec r).2).apply_symm_apply c₁⟩
    obtain ⟨inv₂, hinv₂_left, hinv₂_right⟩ :
        ∃ inv₂ : ∀ r : ℕ, weilEtaleTorsionH S₂ (ℓ ^ r) i₂ →+ weilEtaleModuleH S₂ (ℓ ^ r) i₂,
          (∀ r α₂, inv₂ r (Θ₂ r α₂) = α₂) ∧ (∀ r c₂, Θ₂ r (inv₂ r c₂) = c₂) :=
      ⟨fun r => (AddEquiv.ofBijective (Θ₂ r) (hΘ₂_spec r).2).symm.toAddMonoidHom,
       fun r α₂ => (AddEquiv.ofBijective (Θ₂ r) (hΘ₂_spec r).2).symm_apply_apply α₂,
       fun r c₂ => (AddEquiv.ofBijective (Θ₂ r) (hΘ₂_spec r).2).apply_symm_apply c₂⟩
    choose pull₁ hPull₁ using fun r : ℕ => weil_etale_module_pullback_exists pr₁ (ℓ ^ r) i₁
    choose pull₂ hPull₂ using fun r : ℕ => weil_etale_module_pullback_exists pr₂ (ℓ ^ r) i₂
    let μ : ∀ r : ℕ, weilEtaleTorsionH S₁ (ℓ ^ r) i₁ →+
        weilEtaleTorsionH S₂ (ℓ ^ r) i₂ →+
        weilEtaleTorsionH S_W (ℓ ^ r) (i₁ + i₂) :=
      fun r =>
        AddMonoidHom.mk'
          (fun c₁ =>
            AddMonoidHom.mk'
              (fun c₂ =>
                Θ_W r ((pull₁ r (inv₁ r c₁)).comp (pull₂ r (inv₂ r c₂)) rfl))
              (fun c₂ c₂' => by
                rw [map_add, map_add, Abelian.Ext.comp_add, map_add]))
          (fun c₁ c₁' => by
            ext c₂
            simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply]
            rw [map_add, map_add, Abelian.Ext.add_comp, map_add])
    refine ⟨μ, ?_, ?_, ?_⟩
    · intro r
      rcases hPull₁ r with ⟨hB₁, P₁_pull, adj₁, hAdd₁, hLim₁, hColim₁, hSpec₁⟩
      rcases hPull₂ r with ⟨hB₂, P₂_pull, adj₂, hAdd₂, hLim₂, hColim₂, hSpec₂⟩
      let T₁ : S₁.Etale := ⊤_ S₁.Etale
      let hT₁ : Limits.IsTerminal T₁ := Limits.terminalIsTerminal
      let T₂ : S₂.Etale := ⊤_ S₂.Etale
      let hT₂ : Limits.IsTerminal T₂ := Limits.terminalIsTerminal
      let T_W : S_W.Etale := ⊤_ S_W.Etale
      let hT_W : Limits.IsTerminal T_W := Limits.terminalIsTerminal
      obtain ⟨η₁, hεη₁, hηε₁, hpull₁_eq⟩ := hSpec₁ T₁ hT₁ T_W hT_W
      obtain ⟨η₂, hεη₂, hηε₂, hpull₂_eq⟩ := hSpec₂ T₂ hT₂ T_W hT_W
      refine ⟨hB₁, hB₂, P₁_pull, adj₁, hAdd₁, hLim₁, hColim₁,
        P₂_pull, adj₂, hAdd₂, hLim₂, hColim₂,
        T₁, hT₁, T₂, hT₂, T_W, hT_W,
        η₁, η₂, Θ₁ r, Θ₂ r, Θ_W r,
        hεη₁, hηε₁, hεη₂, hηε₂,
        (hΘ₁_spec r).1, (hΘ₂_spec r).1, (hΘW_spec r).1,
        (hΘ₁_spec r).2, (hΘ₂_spec r).2, (hΘW_spec r).2, ?_⟩
      intro α₁ α₂
      change Θ_W r ((pull₁ r (inv₁ r (Θ₁ r α₁))).comp
          (pull₂ r (inv₂ r (Θ₂ r α₂))) rfl) = _
      rw [hinv₁_left r α₁, hinv₂_left r α₂, hpull₁_eq α₁, hpull₂_eq α₂]
    · intro r c₁ c₂
      let α₁ := inv₁ (r + 1) c₁
      let α₂ := inv₂ (r + 1) c₂
      let α₁_0 := inv₁ r (weilEtaleTorsionTransition S₁ ℓ r i₁ c₁)
      let α₂_0 := inv₂ r (weilEtaleTorsionTransition S₂ ℓ r i₂ c₂)
      have hα₁ : Θ₁ (r + 1) α₁ = c₁ := hinv₁_right (r + 1) c₁
      have hα₂ : Θ₂ (r + 1) α₂ = c₂ := hinv₂_right (r + 1) c₂
      have hα₁_0 : Θ₁ r α₁_0 = weilEtaleTorsionTransition S₁ ℓ r i₁ c₁ := hinv₁_right r _
      have hα₂_0 : Θ₂ r α₂_0 = weilEtaleTorsionTransition S₂ ℓ r i₂ c₂ := hinv₂_right r _
      obtain ⟨p₁_succ, hp₁_succ⟩ := hPullTorsEx pr₁ (ℓ ^ (r + 1)) i₁
      obtain ⟨p₁_r, hp₁_r⟩ := hPullTorsEx pr₁ (ℓ ^ r) i₁
      have htr₁ := DFunLike.congr_fun
        (hPullTorsTrans pr₁ ℓ r i₁ p₁_succ p₁_r hp₁_succ hp₁_r) c₁
      have hc₁_comm : weilEtaleTorsionTransition S_W ℓ r i₁
          (Θ_Wi₁ (r + 1) (pull₁ (r + 1) α₁)) = Θ_Wi₁ r (pull₁ r α₁_0) := by
        rw [weil_etale_module_torsion_pullback_comm pr₁ (ℓ ^ (r + 1)) i₁ (pull₁ (r + 1)) p₁_succ (Θ₁ (r + 1))
            (Θ_Wi₁ (r + 1)) (hPull₁ (r + 1)) hp₁_succ (hΘ₁_spec (r + 1)).1 (hΘWi₁ (r + 1)) α₁,
          hα₁]
        exact htr₁.trans (by
          rw [AddMonoidHom.comp_apply, ← hα₁_0,
            ← weil_etale_module_torsion_pullback_comm pr₁ (ℓ ^ r) i₁ (pull₁ r) p₁_r (Θ₁ r) (Θ_Wi₁ r)
              (hPull₁ r) hp₁_r (hΘ₁_spec r).1 (hΘWi₁ r) α₁_0])
      obtain ⟨p₂_succ, hp₂_succ⟩ := hPullTorsEx pr₂ (ℓ ^ (r + 1)) i₂
      obtain ⟨p₂_r, hp₂_r⟩ := hPullTorsEx pr₂ (ℓ ^ r) i₂
      have htr₂ := DFunLike.congr_fun
        (hPullTorsTrans pr₂ ℓ r i₂ p₂_succ p₂_r hp₂_succ hp₂_r) c₂
      have hc₂_comm : weilEtaleTorsionTransition S_W ℓ r i₂
          (Θ_Wi₂ (r + 1) (pull₂ (r + 1) α₂)) = Θ_Wi₂ r (pull₂ r α₂_0) := by
        rw [weil_etale_module_torsion_pullback_comm pr₂ (ℓ ^ (r + 1)) i₂ (pull₂ (r + 1)) p₂_succ (Θ₂ (r + 1))
            (Θ_Wi₂ (r + 1)) (hPull₂ (r + 1)) hp₂_succ (hΘ₂_spec (r + 1)).1 (hΘWi₂ (r + 1)) α₂,
          hα₂]
        exact htr₂.trans (by
          rw [AddMonoidHom.comp_apply, ← hα₂_0,
            ← weil_etale_module_torsion_pullback_comm pr₂ (ℓ ^ r) i₂ (pull₂ r) p₂_r (Θ₂ r) (Θ_Wi₂ r)
              (hPull₂ r) hp₂_r (hΘ₂_spec r).1 (hΘWi₂ r) α₂_0])
      exact hCupTransW S_W ℓ r i₁ i₂ (i₁ + i₂) rfl
        (Θ_Wi₁ (r + 1)) (Θ_Wi₁ r) (Θ_Wi₂ (r + 1)) (Θ_Wi₂ r) (Θ_W (r + 1)) (Θ_W r)
        (hΘWi₁ (r + 1)) (hΘWi₁ r) (hΘWi₂ (r + 1)) (hΘWi₂ r) (hΘW_spec (r + 1)).1 (hΘW_spec r).1
        (pull₁ (r + 1) α₁) (pull₂ (r + 1) α₂) (pull₁ r α₁_0) (pull₂ r α₂_0) hc₁_comm hc₂_comm
    · intro r c₁ c₂
      let m := ℓ ^ r
      let α₁ := inv₁ r c₁
      let α₂ := inv₂ r c₂
      let α'₁ := inv₁ r (f₁ r c₁)
      let α'₂ := inv₂ r (f₂ r c₂)
      have hα₁ : Θ₁ r α₁ = c₁ := hinv₁_right r c₁
      have hα₂ : Θ₂ r α₂ = c₂ := hinv₂_right r c₂
      have hα'₁ : Θ₁ r α'₁ = f₁ r c₁ := hinv₁_right r _
      have hα'₂ : Θ₂ r α'₂ = f₂ r c₂ := hinv₂_right r _
      obtain ⟨f_Wi₁, hf_Wi₁⟩ := (hFrobPkg K W).1 m i₁
      obtain ⟨f_Wi₂, hf_Wi₂⟩ := (hFrobPkg K W).1 m i₂
      let gW := weilGeomFrobHom K W
      let g₁ := weilGeomFrobHom K X₁
      let g₂ := weilGeomFrobHom K X₂
      obtain ⟨p_gW1, hp_gW1⟩ := hPullTorsEx gW m i₁
      obtain ⟨p_g1, hp_g1⟩ := hPullTorsEx g₁ m i₁
      obtain ⟨p_pr1, hp_pr1⟩ := hPullTorsEx pr₁ m i₁
      obtain ⟨p_comp1, hp_comp1⟩ := hPullTorsEx (CategoryStruct.comp gW pr₁) m i₁
      have hfW1_eq : f_Wi₁ = p_gW1 := hFrobEqPull K W m i₁ f_Wi₁ p_gW1 hf_Wi₁ hp_gW1
      have hf1_eq : f₁ r = p_g1 := hFrobEqPull K X₁ m i₁ (f₁ r) p_g1 (hf₁ r) hp_g1
      have hp_fW1 : WeilIsTorsionEtalePullback gW m i₁ f_Wi₁ := hfW1_eq ▸ hp_gW1
      have hp_f1 : WeilIsTorsionEtalePullback g₁ m i₁ (f₁ r) := hf1_eq ▸ hp_g1
      have hp'_comp1 : WeilIsTorsionEtalePullback (CategoryStruct.comp pr₁ g₁) m i₁ p_comp1 :=
        hFrob₁ ▸ hp_comp1
      have h_int1 : f_Wi₁.comp p_pr1 = p_pr1.comp (f₁ r) :=
        (hPullTorsComp gW pr₁ m i₁ f_Wi₁ p_pr1 p_comp1 hp_fW1 hp_pr1 hp_comp1).symm.trans
          (hPullTorsComp pr₁ g₁ m i₁ p_pr1 (f₁ r) p_comp1 hp_pr1 hp_f1 hp'_comp1)
      have hc₁_frob : f_Wi₁ (Θ_Wi₁ r (pull₁ r α₁)) = Θ_Wi₁ r (pull₁ r α'₁) := by
        rw [weil_etale_module_torsion_pullback_comm pr₁ m i₁ (pull₁ r) p_pr1 (Θ₁ r) (Θ_Wi₁ r)
            (hPull₁ r) hp_pr1 (hΘ₁_spec r).1 (hΘWi₁ r) α₁, hα₁]
        exact (DFunLike.congr_fun h_int1 c₁).trans (by
          rw [AddMonoidHom.comp_apply, ← hα'₁,
            ← weil_etale_module_torsion_pullback_comm pr₁ m i₁ (pull₁ r) p_pr1 (Θ₁ r) (Θ_Wi₁ r)
              (hPull₁ r) hp_pr1 (hΘ₁_spec r).1 (hΘWi₁ r) α'₁])
      obtain ⟨p_gW2, hp_gW2⟩ := hPullTorsEx gW m i₂
      obtain ⟨p_g2, hp_g2⟩ := hPullTorsEx g₂ m i₂
      obtain ⟨p_pr2, hp_pr2⟩ := hPullTorsEx pr₂ m i₂
      obtain ⟨p_comp2, hp_comp2⟩ := hPullTorsEx (CategoryStruct.comp gW pr₂) m i₂
      have hfW2_eq : f_Wi₂ = p_gW2 := hFrobEqPull K W m i₂ f_Wi₂ p_gW2 hf_Wi₂ hp_gW2
      have hf2_eq : f₂ r = p_g2 := hFrobEqPull K X₂ m i₂ (f₂ r) p_g2 (hf₂ r) hp_g2
      have hp_fW2 : WeilIsTorsionEtalePullback gW m i₂ f_Wi₂ := hfW2_eq ▸ hp_gW2
      have hp_f2 : WeilIsTorsionEtalePullback g₂ m i₂ (f₂ r) := hf2_eq ▸ hp_g2
      have hp'_comp2 : WeilIsTorsionEtalePullback (CategoryStruct.comp pr₂ g₂) m i₂ p_comp2 :=
        hFrob₂ ▸ hp_comp2
      have h_int2 : f_Wi₂.comp p_pr2 = p_pr2.comp (f₂ r) :=
        (hPullTorsComp gW pr₂ m i₂ f_Wi₂ p_pr2 p_comp2 hp_fW2 hp_pr2 hp_comp2).symm.trans
          (hPullTorsComp pr₂ g₂ m i₂ p_pr2 (f₂ r) p_comp2 hp_pr2 hp_f2 hp'_comp2)
      have hc₂_frob : f_Wi₂ (Θ_Wi₂ r (pull₂ r α₂)) = Θ_Wi₂ r (pull₂ r α'₂) := by
        rw [weil_etale_module_torsion_pullback_comm pr₂ m i₂ (pull₂ r) p_pr2 (Θ₂ r) (Θ_Wi₂ r)
            (hPull₂ r) hp_pr2 (hΘ₂_spec r).1 (hΘWi₂ r) α₂, hα₂]
        exact (DFunLike.congr_fun h_int2 c₂).trans (by
          rw [AddMonoidHom.comp_apply, ← hα'₂,
            ← weil_etale_module_torsion_pullback_comm pr₂ m i₂ (pull₂ r) p_pr2 (Θ₂ r) (Θ_Wi₂ r)
              (hPull₂ r) hp_pr2 (hΘ₂_spec r).1 (hΘWi₂ r) α'₂])
      exact (hFrobPkg K W).2.2 m i₁ i₂ (i₁ + i₂) rfl
        f_Wi₁ f_Wi₂ (f_W r) (Θ_Wi₁ r) (Θ_Wi₂ r) (Θ_W r)
        hf_Wi₁ hf_Wi₂ (hf_W r) (hΘWi₁ r) (hΘWi₂ r) (hΘW_spec r).1
        (pull₁ r α₁) (pull₂ r α₂) (pull₁ r α'₁) (pull₂ r α'₂) hc₁_frob hc₂_frob

theorem weil_abelian_cochain_bounded_kernel_of_homology_mono_coker (𝒞 : Type (u + 1)) [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
    [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
    (one : 𝒞) (n M : ℕ) (E K : CochainComplex 𝒞 ℕ) (Φ : E ⟶ K)
    (hInj : ∀ p : ℕ, p < n →
      CategoryTheory.Injective (E.X p) ∧ CategoryTheory.Injective (K.X p))
    (hHom : ∀ q : ℕ, q ≤ n →
      CategoryTheory.Mono (HomologicalComplex.homologyMap Φ q) ∧
      M • CategoryTheory.CategoryStruct.id
        (CategoryTheory.Limits.cokernel (HomologicalComplex.homologyMap Φ q)) = 0)
    (z : one ⟶ E.X n)
    (hz : CategoryTheory.CategoryStruct.comp z (E.d n (n + 1)) = 0)
    (hK : (n = 0 ∧ CategoryTheory.CategoryStruct.comp z (Φ.f n) = 0) ∨
      ∃ (p : ℕ) (_ : p + 1 = n) (b : one ⟶ K.X p),
        CategoryTheory.CategoryStruct.comp b (K.d p n) =
          CategoryTheory.CategoryStruct.comp z (Φ.f n)) :
    (n = 0 ∧ (M ^ (2 * n)) • z = 0) ∨
      ∃ (p : ℕ) (_ : p + 1 = n) (a : one ⟶ E.X p),
        CategoryTheory.CategoryStruct.comp a (E.d p n) = (M ^ (2 * n)) • z :=
by
  have hMk₀_inj : ∀ {X Y : 𝒞} {f g : X ⟶ Y},
      (CategoryTheory.Abelian.Ext.mk₀ f : CategoryTheory.Abelian.Ext.{u} X Y 0) =
        CategoryTheory.Abelian.Ext.mk₀ g → f = g := by
    intro X Y f g hfg
    apply CategoryTheory.Abelian.Ext.homEquiv₀.symm.injective
    rw [CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
      CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply]
    exact hfg
  have hMk₀_nsmul : ∀ {X Y : 𝒞} (f : X ⟶ Y) (m : ℕ),
      (CategoryTheory.Abelian.Ext.mk₀ (m • f) : CategoryTheory.Abelian.Ext.{u} X Y 0) =
        m • CategoryTheory.Abelian.Ext.mk₀ f := by
    intro X Y f m
    induction m with
    | zero =>
      rw [zero_smul, CategoryTheory.Abelian.Ext.mk₀_zero, zero_smul]
    | succ m ih =>
      rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add, ih, succ_nsmul]
  have hNsmul_comp : ∀ {X Y Z : 𝒞} {a b c : ℕ}
      (α : CategoryTheory.Abelian.Ext.{u} X Y a)
      (β : CategoryTheory.Abelian.Ext.{u} Y Z b) (hab : a + b = c) (m : ℕ),
      (m • α).comp β hab = m • (α.comp β hab) := by
    intro X Y Z a b c α β hab m
    induction m with
    | zero =>
      rw [zero_smul, CategoryTheory.Abelian.Ext.zero_comp, zero_smul]
    | succ m ih =>
      rw [succ_nsmul, CategoryTheory.Abelian.Ext.add_comp, ih, succ_nsmul]
  have hComp_nsmul : ∀ {X Y Z : 𝒞} {a b c : ℕ}
      (α : CategoryTheory.Abelian.Ext.{u} X Y a)
      (β : CategoryTheory.Abelian.Ext.{u} Y Z b) (hab : a + b = c) (m : ℕ),
      α.comp (m • β) hab = m • (α.comp β hab) := by
    intro X Y Z a b c α β hab m
    induction m with
    | zero =>
      rw [zero_smul, CategoryTheory.Abelian.Ext.comp_zero, zero_smul]
    | succ m ih =>
      rw [succ_nsmul, CategoryTheory.Abelian.Ext.comp_add, ih, succ_nsmul]

  have hSingleSES : ∀ (C : CochainComplex 𝒞 ℕ) (p : ℕ),
      ∃ (hzero_A : C.iCycles p ≫
          CategoryTheory.Abelian.factorThruImage (C.toCycles p (p + 1)) = 0)
        (hzero_B : CategoryTheory.Abelian.image.ι (C.toCycles p (p + 1)) ≫
          C.homologyπ (p + 1) = 0),
        (CategoryTheory.ShortComplex.mk (C.iCycles p)
          (CategoryTheory.Abelian.factorThruImage (C.toCycles p (p + 1))) hzero_A).ShortExact ∧
        (CategoryTheory.ShortComplex.mk
          (CategoryTheory.Abelian.image.ι (C.toCycles p (p + 1)))
          (C.homologyπ (p + 1)) hzero_B).ShortExact := by
    intro C p
    let fC := C.toCycles p (p + 1)
    let qC := CategoryTheory.Abelian.factorThruImage fC
    let jC := CategoryTheory.Abelian.image.ι fC
    have hfac : qC ≫ jC = fC := CategoryTheory.Abelian.image.fac fC
    have hnext : (ComplexShape.up ℕ).next p = p + 1 :=
      ComplexShape.next_eq' (ComplexShape.up ℕ) (rfl : p + 1 = p + 1)
    have hprev : (ComplexShape.up ℕ).prev (p + 1) = p :=
      ComplexShape.prev_eq' (ComplexShape.up ℕ) (rfl : p + 1 = p + 1)
    have hzero_A : C.iCycles p ≫ qC = 0 := by
      apply (CategoryTheory.cancel_mono jC).mp
      apply (CategoryTheory.cancel_mono (C.iCycles (p + 1))).mp
      calc
        ((C.iCycles p ≫ qC) ≫ jC) ≫ C.iCycles (p + 1)
          = (C.iCycles p ≫ (qC ≫ jC)) ≫ C.iCycles (p + 1) := by
            rw [CategoryTheory.Category.assoc (C.iCycles p) qC jC]
        _ = C.iCycles p ≫ (C.toCycles p (p + 1) ≫ C.iCycles (p + 1)) := by
            rw [hfac, CategoryTheory.Category.assoc]
        _ = C.iCycles p ≫ C.d p (p + 1) := by
            rw [HomologicalComplex.toCycles_i]
        _ = 0 := HomologicalComplex.iCycles_d C p (p + 1)
        _ = (0 ≫ jC) ≫ C.iCycles (p + 1) := by
            rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.zero_comp]
    have hzero_B : jC ≫ C.homologyπ (p + 1) = 0 := by
      apply (CategoryTheory.cancel_epi qC).mp
      rw [CategoryTheory.Limits.comp_zero, ← CategoryTheory.Category.assoc]
      dsimp [qC, jC, fC]
      rw [CategoryTheory.Abelian.image.fac]
      exact HomologicalComplex.toCycles_comp_homologyπ C p (p + 1)
    have hKerA : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι (C.iCycles p) hzero_A) := by
      refine CategoryTheory.Limits.KernelFork.IsLimit.ofι (C.iCycles p) hzero_A
        (fun {W} g hg => C.liftCycles g (p + 1) hnext ?_)
        (fun {W} g hg => C.liftCycles_i g (p + 1) hnext _)
        (fun {W} g hg m hm => ?_)
      · calc
          g ≫ C.d p (p + 1)
            = g ≫ C.toCycles p (p + 1) ≫ C.iCycles (p + 1) := by
              rw [HomologicalComplex.toCycles_i]
          _ = g ≫ (qC ≫ jC) ≫ C.iCycles (p + 1) := by
              dsimp [qC, jC, fC]
              rw [CategoryTheory.Abelian.image.fac]
          _ = (g ≫ qC) ≫ jC ≫ C.iCycles (p + 1) := by
              rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
          _ = 0 := by
              rw [hg, CategoryTheory.Limits.zero_comp]
      · apply (CategoryTheory.cancel_mono (C.iCycles p)).mp
        rw [hm, C.liftCycles_i]
    have hSA : (CategoryTheory.ShortComplex.mk (C.iCycles p) qC hzero_A).ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hKerA)
        inferInstance inferInstance
    have hcok := C.homologyIsCokernel p (p + 1) hprev
    have hCokB : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.CokernelCofork.ofπ (C.homologyπ (p + 1)) hzero_B) := by
      have hfC_zero : ∀ {W : 𝒞} (g : C.cycles (p + 1) ⟶ W),
          jC ≫ g = 0 → fC ≫ g = 0 := by
        intro W g hg
        rw [← hfac, CategoryTheory.Category.assoc, hg, CategoryTheory.Limits.comp_zero]
      refine CategoryTheory.Limits.CokernelCofork.IsColimit.ofπ (C.homologyπ (p + 1)) hzero_B
        (fun {W} g hg =>
          (CategoryTheory.Limits.CokernelCofork.IsColimit.desc' hcok g (hfC_zero g hg)).1)
        (fun {W} g hg => by
          simpa using
            (CategoryTheory.Limits.CokernelCofork.IsColimit.desc' hcok g (hfC_zero g hg)).2)
        (fun {W} g hg m hm => ?_)
      apply (CategoryTheory.cancel_epi (C.homologyπ (p + 1))).mp
      rw [hm]
      simpa using
        (CategoryTheory.Limits.CokernelCofork.IsColimit.desc' hcok g (hfC_zero g hg)).2.symm
    have hSB : (CategoryTheory.ShortComplex.mk jC (C.homologyπ (p + 1)) hzero_B).ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_g_is_cokernel _ hCokB)
        inferInstance inferInstance
    exact ⟨hzero_A, hzero_B, hSA, hSB⟩

  have hImageMap : ∀ p : ℕ,
      ∃ u_B : CategoryTheory.Abelian.image (E.toCycles p (p + 1)) ⟶
          CategoryTheory.Abelian.image (K.toCycles p (p + 1)),
        CategoryTheory.Abelian.factorThruImage (E.toCycles p (p + 1)) ≫ u_B =
          Φ.f p ≫ CategoryTheory.Abelian.factorThruImage (K.toCycles p (p + 1)) ∧
        u_B ≫ CategoryTheory.Abelian.image.ι (K.toCycles p (p + 1)) =
          CategoryTheory.Abelian.image.ι (E.toCycles p (p + 1)) ≫
            HomologicalComplex.cyclesMap Φ (p + 1) := by
    intro p
    let fE := E.toCycles p (p + 1)
    let fK := K.toCycles p (p + 1)
    have hcomm_toCycles : fE ≫ HomologicalComplex.cyclesMap Φ (p + 1) = Φ.f p ≫ fK := by
      apply (CategoryTheory.cancel_mono (K.iCycles (p + 1))).mp
      rw [CategoryTheory.Category.assoc, HomologicalComplex.cyclesMap_i,
        ← CategoryTheory.Category.assoc, HomologicalComplex.toCycles_i,
        CategoryTheory.Category.assoc, HomologicalComplex.toCycles_i,
        (Φ.comm p (p + 1)).symm]
    have hcond : (CategoryTheory.Abelian.image.ι fE ≫
        HomologicalComplex.cyclesMap Φ (p + 1)) ≫ CategoryTheory.Limits.cokernel.π fK = 0 := by
      apply (CategoryTheory.cancel_epi (CategoryTheory.Abelian.factorThruImage fE)).mp
      rw [CategoryTheory.Limits.comp_zero, ← CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc, CategoryTheory.Abelian.image.fac fE,
        CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc fE,
        hcomm_toCycles, CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.condition,
        CategoryTheory.Limits.comp_zero]
    let u_B : CategoryTheory.Abelian.image fE ⟶ CategoryTheory.Abelian.image fK :=
      CategoryTheory.Limits.kernel.lift (CategoryTheory.Limits.cokernel.π fK)
        (CategoryTheory.Abelian.image.ι fE ≫ HomologicalComplex.cyclesMap Φ (p + 1)) hcond
    have hu_ι : u_B ≫ CategoryTheory.Abelian.image.ι fK =
        CategoryTheory.Abelian.image.ι fE ≫ HomologicalComplex.cyclesMap Φ (p + 1) :=
      CategoryTheory.Limits.kernel.lift_ι _ _ _
    have hu_fac : CategoryTheory.Abelian.factorThruImage fE ≫ u_B =
        Φ.f p ≫ CategoryTheory.Abelian.factorThruImage fK := by
      apply (CategoryTheory.cancel_mono (CategoryTheory.Abelian.image.ι fK)).mp
      rw [CategoryTheory.Category.assoc, hu_ι, ← CategoryTheory.Category.assoc,
        CategoryTheory.Abelian.image.fac fE, hcomm_toCycles,
        CategoryTheory.Category.assoc, CategoryTheory.Abelian.image.fac fK]
    exact ⟨u_B, hu_fac, hu_ι⟩

  have hExtMonoCoker : ∀ {H₁ H₂ : 𝒞} (h : H₁ ⟶ H₂),
      CategoryTheory.Mono h →
      M • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.cokernel h) = 0 →
      (∀ (k : ℕ) (x₁ : CategoryTheory.Abelian.Ext.{u} one H₁ k),
        x₁.comp (CategoryTheory.Abelian.Ext.mk₀ h) (Nat.add_zero k) = 0 → M • x₁ = 0) ∧
      (∀ (k : ℕ) (x₂ : CategoryTheory.Abelian.Ext.{u} one H₂ k),
        ∃ x₁ : CategoryTheory.Abelian.Ext.{u} one H₁ k,
          x₁.comp (CategoryTheory.Abelian.Ext.mk₀ h) (Nat.add_zero k) = M • x₂) := by
    intro H₁ H₂ h hMono hCoker
    let Q := CategoryTheory.Limits.cokernel h
    let π := CategoryTheory.Limits.cokernel.π h
    let S := CategoryTheory.ShortComplex.mk h π (CategoryTheory.Limits.cokernel.condition h)
    have hS : S.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel h) hMono inferInstance
    have hKillQ : ∀ (k : ℕ) (γ : CategoryTheory.Abelian.Ext.{u} one Q k), M • γ = 0 := by
      intro k γ
      calc
        M • γ = M • (γ.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 Q)) (Nat.add_zero k)) := by
          rw [CategoryTheory.Abelian.Ext.comp_mk₀_id]
        _ = γ.comp (CategoryTheory.Abelian.Ext.mk₀ (M • 𝟙 Q)) (Nat.add_zero k) := by
          rw [← hComp_nsmul, ← hMk₀_nsmul]
        _ = 0 := by
          rw [hCoker, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
    refine ⟨?_, ?_⟩
    · intro k x₁ hx₁
      cases k with
      | zero =>
        let u₁ : one ⟶ H₁ := CategoryTheory.Abelian.Ext.homEquiv₀ x₁
        have hu₁ : CategoryTheory.Abelian.Ext.mk₀ u₁ = x₁ :=
          CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply x₁
        have hcomp0 : (CategoryTheory.Abelian.Ext.mk₀ (u₁ ≫ h) :
            CategoryTheory.Abelian.Ext.{u} one H₂ 0) =
            CategoryTheory.Abelian.Ext.mk₀ (0 : one ⟶ H₂) := by
          rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ u₁ h, hu₁, hx₁,
            CategoryTheory.Abelian.Ext.mk₀_zero]
        have hu₁_h : u₁ ≫ h = 0 := hMk₀_inj hcomp0
        have hu₁_zero : u₁ = 0 :=
          (CategoryTheory.cancel_mono h).mp (hu₁_h.trans (CategoryTheory.Limits.zero_comp).symm)
        rw [← hu₁, hu₁_zero, CategoryTheory.Abelian.Ext.mk₀_zero, smul_zero]
      | succ k₀ =>
        obtain ⟨x₃, rfl⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ one hS x₁ hx₁ rfl
        rw [← hNsmul_comp, hKillQ k₀ x₃, CategoryTheory.Abelian.Ext.zero_comp]
    · intro k x₂
      have hx₂_π : (M • x₂).comp (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero k) = 0 := by
        rw [hNsmul_comp]
        exact hKillQ k (x₂.comp (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero k))
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ one hS (M • x₂) hx₂_π

  have hCyclesExtKer : ∀ (p s : ℕ), p + s = n → 1 ≤ s →
      ∀ (x : CategoryTheory.Abelian.Ext.{u} one (E.cycles p) s),
        x.comp (CategoryTheory.Abelian.Ext.mk₀ (HomologicalComplex.cyclesMap Φ p))
          (Nat.add_zero s) = 0 →
        (M ^ (2 * p + 1)) • x = 0 := by
    intro p
    induction p with
    | zero =>
      intro s hp_s hs x hx
      have h0_le : 0 ≤ n := Nat.zero_le n
      obtain ⟨hKer₀, _⟩ := hExtMonoCoker (HomologicalComplex.homologyMap Φ 0)
        (hHom 0 h0_le).1 (hHom 0 h0_le).2
      let y := x.comp (CategoryTheory.Abelian.Ext.mk₀ (E.homologyπ 0)) (Nat.add_zero s)
      have hy0 : y.comp (CategoryTheory.Abelian.Ext.mk₀ (HomologicalComplex.homologyMap Φ 0))
          (Nat.add_zero s) = 0 := by
        dsimp [y]
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, HomologicalComplex.homologyπ_naturality,
          ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          hx, CategoryTheory.Abelian.Ext.zero_comp]
      have hMy : M • y = 0 := hKer₀ s y hy0
      have hMx_π : (M • x).comp (CategoryTheory.Abelian.Ext.mk₀ (E.homologyπ 0))
          (Nat.add_zero s) = 0 := by
        rw [hNsmul_comp]
        exact hMy
      have hMx : M • x = 0 := by
        calc
          M • x = (M • x).comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 (E.cycles 0)))
              (Nat.add_zero s) := (CategoryTheory.Abelian.Ext.comp_mk₀_id _).symm
          _ = (M • x).comp
              (CategoryTheory.Abelian.Ext.mk₀
                (E.homologyπ 0 ≫ CategoryTheory.inv (E.homologyπ 0)))
              (Nat.add_zero s) := by
            rw [CategoryTheory.IsIso.hom_inv_id]
          _ = ((M • x).comp (CategoryTheory.Abelian.Ext.mk₀ (E.homologyπ 0))
              (Nat.add_zero s)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv (E.homologyπ 0)))
              (Nat.add_zero s) := by
            rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
              CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
          _ = 0 := by
            rw [hMx_π, CategoryTheory.Abelian.Ext.zero_comp]
      simpa using hMx
    | succ p ih =>
      intro s hp_s hs x hx
      have hp_lt : p < n := by omega
      have hp1_le : p + 1 ≤ n := by omega
      obtain ⟨s₀, hs₀⟩ : ∃ s₀ : ℕ, s₀ + 1 = s := ⟨s - 1, Nat.sub_add_cancel hs⟩
      obtain ⟨hzero_AE, hzero_BE, hAE, hBE⟩ := hSingleSES E p
      obtain ⟨hzero_AK, hzero_BK, hAK, hBK⟩ := hSingleSES K p
      obtain ⟨u_B, hfac_comm, hι_comm⟩ := hImageMap p
      obtain ⟨hKer_p1, hLift_p1⟩ := hExtMonoCoker
        (HomologicalComplex.homologyMap Φ (p + 1)) (hHom (p + 1) hp1_le).1 (hHom (p + 1) hp1_le).2
      let qE := CategoryTheory.Abelian.factorThruImage (E.toCycles p (p + 1))
      let jE := CategoryTheory.Abelian.image.ι (E.toCycles p (p + 1))
      let qK := CategoryTheory.Abelian.factorThruImage (K.toCycles p (p + 1))
      let jK := CategoryTheory.Abelian.image.ι (K.toCycles p (p + 1))
      let α : CategoryTheory.ShortComplex.mk (E.iCycles p) qE hzero_AE ⟶
          CategoryTheory.ShortComplex.mk (K.iCycles p) qK hzero_AK :=
        CategoryTheory.ShortComplex.homMk (HomologicalComplex.cyclesMap Φ p) (Φ.f p) u_B
          (HomologicalComplex.cyclesMap_i Φ p) hfac_comm.symm
      let β : CategoryTheory.ShortComplex.mk jE (E.homologyπ (p + 1)) hzero_BE ⟶
          CategoryTheory.ShortComplex.mk jK (K.homologyπ (p + 1)) hzero_BK :=
        CategoryTheory.ShortComplex.homMk u_B
          (HomologicalComplex.cyclesMap Φ (p + 1))
          (HomologicalComplex.homologyMap Φ (p + 1))
          hι_comm (HomologicalComplex.homologyπ_naturality Φ (p + 1)).symm
      have hnat_α : hAE.extClass.comp
          (CategoryTheory.Abelian.Ext.mk₀ (HomologicalComplex.cyclesMap Φ p)) (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ u_B).comp hAK.extClass (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hAE hAK α
      have hnat_β : hBE.extClass.comp
          (CategoryTheory.Abelian.Ext.mk₀ u_B) (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ (HomologicalComplex.homologyMap Φ (p + 1))).comp
            hBK.extClass (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hBE hBK β
      let y_H := x.comp (CategoryTheory.Abelian.Ext.mk₀ (E.homologyπ (p + 1))) (Nat.add_zero s)
      have hy_H_zero : y_H.comp
          (CategoryTheory.Abelian.Ext.mk₀ (HomologicalComplex.homologyMap Φ (p + 1)))
          (Nat.add_zero s) = 0 := by
        dsimp [y_H]
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, HomologicalComplex.homologyπ_naturality,
          ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          hx, CategoryTheory.Abelian.Ext.zero_comp]
      have hMx_π : (M • x).comp (CategoryTheory.Abelian.Ext.mk₀ (E.homologyπ (p + 1)))
          (Nat.add_zero s) = 0 := by
        rw [hNsmul_comp]
        exact hKer_p1 s y_H hy_H_zero
      obtain ⟨y, hy⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ one hBE (M • x) hMx_π
      let y_K := y.comp (CategoryTheory.Abelian.Ext.mk₀ u_B) (Nat.add_zero s)
      have hy_K_jK : y_K.comp (CategoryTheory.Abelian.Ext.mk₀ jK) (Nat.add_zero s) = 0 := by
        dsimp [y_K]
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hι_comm,
          ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          hy, hNsmul_comp, hx, smul_zero]
      obtain ⟨u', hu'⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ one hBK y_K hy_K_jK hs₀
      obtain ⟨u, hu⟩ := hLift_p1 s₀ u'
      let y₁ := M • y - u.comp hBE.extClass hs₀
      have hy₁_jE : y₁.comp (CategoryTheory.Abelian.Ext.mk₀ jE) (Nat.add_zero s) =
          (M * M) • x := by
        dsimp [y₁]
        rw [sub_eq_add_neg, CategoryTheory.Abelian.Ext.add_comp,
          CategoryTheory.Abelian.Ext.neg_comp, hNsmul_comp, hy, mul_nsmul',
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.ShortComplex.ShortExact.extClass_comp hBE,
          CategoryTheory.Abelian.Ext.comp_zero, neg_zero, add_zero]
      have hy₁_uB : y₁.comp (CategoryTheory.Abelian.Ext.mk₀ u_B) (Nat.add_zero s) = 0 := by
        dsimp [y₁]
        have hu_nat : (u.comp hBE.extClass hs₀).comp
            (CategoryTheory.Abelian.Ext.mk₀ u_B) (Nat.add_zero s) = M • y_K := by
          rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero, hnat_β,
            ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero,
            hu, hNsmul_comp, hu']
        rw [sub_eq_add_neg, CategoryTheory.Abelian.Ext.add_comp,
          CategoryTheory.Abelian.Ext.neg_comp, hNsmul_comp, hu_nat, add_neg_cancel]
      let x' := y₁.comp hAE.extClass (rfl : s + 1 = s + 1)
      have hx'_zero : x'.comp (CategoryTheory.Abelian.Ext.mk₀ (HomologicalComplex.cyclesMap Φ p))
          (Nat.add_zero (s + 1)) = 0 := by
        dsimp [x']
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero, hnat_α,
          ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero,
          hy₁_uB, CategoryTheory.Abelian.Ext.zero_comp]
      have hIH := ih (s + 1) (by omega) (by omega) x' hx'_zero
      have hKy₁_ext : ((M ^ (2 * p + 1)) • y₁).comp hAE.extClass (rfl : s + 1 = s + 1) = 0 := by
        rw [hNsmul_comp]
        exact hIH
      obtain ⟨w, hw⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ one hAE
        ((M ^ (2 * p + 1)) • y₁) (rfl : s + 1 = s + 1) hKy₁_ext
      have : CategoryTheory.Injective (E.X p) := (hInj p hp_lt).1
      have : CategoryTheory.HasInjectiveDimensionLT (E.X p) 1 := inferInstance
      have : Subsingleton (CategoryTheory.Abelian.Ext.{u} one (E.X p) s) :=
        CategoryTheory.HasInjectiveDimensionLT.subsingleton (E.X p) 1 s hs one
      have hw0 : w = 0 := Subsingleton.elim w 0
      have hKy₁_zero : (M ^ (2 * p + 1)) • y₁ = 0 := by
        rw [← hw, hw0, CategoryTheory.Abelian.Ext.zero_comp]
      have hpow_eq : M ^ (2 * (p + 1) + 1) = M ^ (2 * p + 1) * (M * M) := by ring
      rw [hpow_eq, mul_nsmul', ← hy₁_jE, ← hNsmul_comp, hKy₁_zero,
        CategoryTheory.Abelian.Ext.zero_comp]

  rcases Nat.eq_zero_or_pos n with rfl | hn_pos
  · left
    refine ⟨rfl, ?_⟩
    have hzK : z ≫ Φ.f 0 = 0 := by
      rcases hK with ⟨_, hz0⟩ | ⟨p, hp, _⟩
      · exact hz0
      · omega
    have hnext0 : (ComplexShape.up ℕ).next 0 = 1 :=
      ComplexShape.next_eq' (ComplexShape.up ℕ) (rfl : 0 + 1 = 1)
    let z_E : one ⟶ E.cycles 0 := E.liftCycles z 1 hnext0 hz
    have hz_E_i : z_E ≫ E.iCycles 0 = z := E.liftCycles_i z 1 hnext0 hz
    have hz_K : z_E ≫ HomologicalComplex.cyclesMap Φ 0 = 0 := by
      apply (CategoryTheory.cancel_mono (K.iCycles 0)).mp
      rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Category.assoc,
        HomologicalComplex.cyclesMap_i, ← CategoryTheory.Category.assoc, hz_E_i, hzK]
    have hz_hom : (z_E ≫ E.homologyπ 0) ≫ HomologicalComplex.homologyMap Φ 0 = 0 := by
      rw [CategoryTheory.Category.assoc, HomologicalComplex.homologyπ_naturality,
        ← CategoryTheory.Category.assoc, hz_K, CategoryTheory.Limits.zero_comp]
    have : CategoryTheory.Mono (HomologicalComplex.homologyMap Φ 0) :=
      (hHom 0 (le_refl 0)).1
    have hz_π0 : z_E ≫ E.homologyπ 0 = 0 :=
      (CategoryTheory.cancel_mono (HomologicalComplex.homologyMap Φ 0)).mp
        (hz_hom.trans (CategoryTheory.Limits.zero_comp).symm)
    have hz_E_zero : z_E = 0 :=
      (CategoryTheory.cancel_mono (E.homologyπ 0)).mp
        (hz_π0.trans (CategoryTheory.Limits.zero_comp).symm)
    have hz_zero : z = 0 := by
      rw [← hz_E_i, hz_E_zero, CategoryTheory.Limits.zero_comp]
    rw [hz_zero, smul_zero]
  · right
    obtain ⟨p₀, rfl⟩ : ∃ p₀ : ℕ, p₀ + 1 = n := ⟨n - 1, Nat.sub_add_cancel hn_pos⟩
    have hb_ex : ∃ b : one ⟶ K.X p₀, b ≫ K.d p₀ (p₀ + 1) = z ≫ Φ.f (p₀ + 1) := by
      rcases hK with ⟨h0, _⟩ | ⟨p, hp, b, hb⟩
      · omega
      · have hp_eq : p = p₀ := by omega
        subst hp_eq
        exact ⟨b, hb⟩
    obtain ⟨b, hb⟩ := hb_ex
    obtain ⟨hzero_AE, hzero_BE, hAE, hBE⟩ := hSingleSES E p₀
    obtain ⟨hzero_AK, _, hAK, _⟩ := hSingleSES K p₀
    obtain ⟨u_B, hfac_comm, hι_comm⟩ := hImageMap p₀
    let qE := CategoryTheory.Abelian.factorThruImage (E.toCycles p₀ (p₀ + 1))
    let jE := CategoryTheory.Abelian.image.ι (E.toCycles p₀ (p₀ + 1))
    let qK := CategoryTheory.Abelian.factorThruImage (K.toCycles p₀ (p₀ + 1))
    let jK := CategoryTheory.Abelian.image.ι (K.toCycles p₀ (p₀ + 1))
    have hnext_n : (ComplexShape.up ℕ).next (p₀ + 1) = p₀ + 1 + 1 :=
      ComplexShape.next_eq' (ComplexShape.up ℕ) (rfl : (p₀ + 1) + 1 = p₀ + 1 + 1)
    let z_E : one ⟶ E.cycles (p₀ + 1) := E.liftCycles z (p₀ + 1 + 1) hnext_n hz
    have hz_E_i : z_E ≫ E.iCycles (p₀ + 1) = z := E.liftCycles_i z (p₀ + 1 + 1) hnext_n hz
    have hz_K : z_E ≫ HomologicalComplex.cyclesMap Φ (p₀ + 1) =
        b ≫ K.toCycles p₀ (p₀ + 1) := by
      apply (CategoryTheory.cancel_mono (K.iCycles (p₀ + 1))).mp
      rw [CategoryTheory.Category.assoc, HomologicalComplex.cyclesMap_i,
        ← CategoryTheory.Category.assoc, hz_E_i,
        CategoryTheory.Category.assoc, HomologicalComplex.toCycles_i, hb]
    have hz_hom : (z_E ≫ E.homologyπ (p₀ + 1)) ≫
        HomologicalComplex.homologyMap Φ (p₀ + 1) = 0 := by
      rw [CategoryTheory.Category.assoc, HomologicalComplex.homologyπ_naturality,
        ← CategoryTheory.Category.assoc, hz_K, CategoryTheory.Category.assoc,
        HomologicalComplex.toCycles_comp_homologyπ, CategoryTheory.Limits.comp_zero]
    have : CategoryTheory.Mono (HomologicalComplex.homologyMap Φ (p₀ + 1)) :=
      (hHom (p₀ + 1) (le_refl (p₀ + 1))).1
    have hz_π : z_E ≫ E.homologyπ (p₀ + 1) = 0 :=
      (CategoryTheory.cancel_mono (HomologicalComplex.homologyMap Φ (p₀ + 1))).mp
        (hz_hom.trans (CategoryTheory.Limits.zero_comp).symm)
    let w_E : one ⟶ CategoryTheory.Abelian.image (E.toCycles p₀ (p₀ + 1)) :=
      hBE.exact.lift z_E hz_π
    have hw_E : w_E ≫ jE = z_E := hBE.exact.lift_f z_E hz_π
    have hw_K : w_E ≫ u_B = b ≫ qK := by
      apply (CategoryTheory.cancel_mono jK).mp
      rw [CategoryTheory.Category.assoc, hι_comm, ← CategoryTheory.Category.assoc, hw_E,
        hz_K, CategoryTheory.Category.assoc,
        CategoryTheory.Abelian.image.fac (K.toCycles p₀ (p₀ + 1))]
    let α₀ : CategoryTheory.ShortComplex.mk (E.iCycles p₀) qE hzero_AE ⟶
        CategoryTheory.ShortComplex.mk (K.iCycles p₀) qK hzero_AK :=
      CategoryTheory.ShortComplex.homMk (HomologicalComplex.cyclesMap Φ p₀) (Φ.f p₀) u_B
        (HomologicalComplex.cyclesMap_i Φ p₀) hfac_comm.symm
    have hnat_α₀ : hAE.extClass.comp
        (CategoryTheory.Abelian.Ext.mk₀ (HomologicalComplex.cyclesMap Φ p₀)) (Nat.add_zero 1) =
        (CategoryTheory.Abelian.Ext.mk₀ u_B).comp hAK.extClass (Nat.zero_add 1) :=
      CategoryTheory.ShortComplex.ShortExact.extClass_naturality hAE hAK α₀
    let obs_E : CategoryTheory.Abelian.Ext.{u} one (E.cycles p₀) 1 :=
      (CategoryTheory.Abelian.Ext.mk₀ w_E).comp hAE.extClass (Nat.zero_add 1)
    have hobs_zero : obs_E.comp
        (CategoryTheory.Abelian.Ext.mk₀ (HomologicalComplex.cyclesMap Φ p₀))
        (Nat.add_zero 1) = 0 := by
      dsimp [obs_E]
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero, hnat_α₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, hw_K,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
        CategoryTheory.ShortComplex.ShortExact.comp_extClass hAK,
        CategoryTheory.Abelian.Ext.comp_zero]
    have hKill_odd : (M ^ (2 * p₀ + 1)) • obs_E = 0 :=
      hCyclesExtKer p₀ 1 rfl (le_refl 1) obs_E hobs_zero
    have hpow_even : M ^ (2 * (p₀ + 1)) = M * M ^ (2 * p₀ + 1) := by
      have hexp : 2 * (p₀ + 1) = (2 * p₀ + 1) + 1 := by omega
      rw [hexp, pow_succ']
    have hKill_even : ((CategoryTheory.Abelian.Ext.mk₀ ((M ^ (2 * (p₀ + 1))) • w_E) :
        CategoryTheory.Abelian.Ext.{u} one
          (CategoryTheory.Abelian.image (E.toCycles p₀ (p₀ + 1))) 0)).comp
        hAE.extClass (Nat.zero_add 1) = 0 := by
      rw [hMk₀_nsmul, hNsmul_comp]
      change (M ^ (2 * (p₀ + 1))) • obs_E = 0
      rw [hpow_even, mul_nsmul', hKill_odd, smul_zero]
    obtain ⟨a₀, ha₀⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ one hAE
      (CategoryTheory.Abelian.Ext.mk₀ ((M ^ (2 * (p₀ + 1))) • w_E)) (Nat.zero_add 1) hKill_even
    let a : one ⟶ E.X p₀ := CategoryTheory.Abelian.Ext.homEquiv₀ a₀
    have ha₀_eq : CategoryTheory.Abelian.Ext.mk₀ a = a₀ :=
      CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply a₀
    have ha_qE : a ≫ qE = (M ^ (2 * (p₀ + 1))) • w_E := by
      apply hMk₀_inj
      rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ a qE, ha₀_eq]
      exact ha₀
    refine ⟨p₀, rfl, a, ?_⟩
    calc
      a ≫ E.d p₀ (p₀ + 1)
        = a ≫ E.toCycles p₀ (p₀ + 1) ≫ E.iCycles (p₀ + 1) := by
          rw [HomologicalComplex.toCycles_i]
      _ = (a ≫ qE) ≫ jE ≫ E.iCycles (p₀ + 1) := by
          dsimp [qE, jE]
          rw [CategoryTheory.Category.assoc a,
            ← CategoryTheory.Category.assoc (CategoryTheory.Abelian.factorThruImage _),
            CategoryTheory.Abelian.image.fac]
      _ = ((M ^ (2 * (p₀ + 1))) • w_E) ≫ jE ≫ E.iCycles (p₀ + 1) := by
          rw [ha_qE]
      _ = (M ^ (2 * (p₀ + 1))) • ((w_E ≫ jE) ≫ E.iCycles (p₀ + 1)) := by
          rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.assoc]
      _ = (M ^ (2 * (p₀ + 1))) • z := by
          rw [hw_E, hz_E_i]

