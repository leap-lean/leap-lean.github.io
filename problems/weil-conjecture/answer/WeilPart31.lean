          if r ≠ 0 ∧ 1 ∣ r then ((1 : ℕ) : L₀) * (R.map (· ^ (r / 1))).sum else 0) =
        PowerSeries.map ι (PowerSeries.mk (fun r => if r = 0 then 0 else Matrix.trace (B ^ r))) := by
      ext r
      simp only [PowerSeries.coeff_map, PowerSeries.coeff_mk, one_dvd, and_true, Nat.div_one,
        Nat.cast_one, one_mul]
      by_cases hr : r = 0
      · simp [hr]
      · rw [if_pos hr, if_neg hr]
        exact (hPart1 L₀ r).symm
    rw [hMap_ps, hDeriv_map, hSeries_eq, ← PowerSeries.map_X ι, ← (PowerSeries.map ι).map_mul,
      ← (PowerSeries.map ι).map_neg, ← (PowerSeries.map ι).map_mul] at hLog_L₀
    ext r
    apply hι_inj
    have hr := congr_arg (PowerSeries.coeff r) hLog_L₀
    rw [PowerSeries.coeff_map, PowerSeries.coeff_map] at hr
    exact hr

  
  have h_ode_unique : ∀ (K : Type) [Field K] [CharZero K] (F₁ F₂ G : PowerSeries K),
      PowerSeries.coeff 0 G = 0 →
      PowerSeries.coeff 0 F₁ = PowerSeries.coeff 0 F₂ →
      PowerSeries.X * PowerSeries.derivative F₁ = F₁ * G →
      PowerSeries.X * PowerSeries.derivative F₂ = F₂ * G →
      F₁ = F₂ := by
    intro K _ _ F₁ F₂ G hG0 hF0 h1 h2
    let Δ : PowerSeries K := F₁ - F₂
    have hΔ_deriv : PowerSeries.X * PowerSeries.derivative Δ = Δ * G := by
      dsimp [Δ]
      rw [map_sub, mul_sub, h1, h2, sub_mul]
    have hΔ_coeff : ∀ r : ℕ, PowerSeries.coeff r Δ = 0 := by
      intro r
      induction r using Nat.strong_induction_on with
      | h r ih =>
        rcases r with _ | m
        · dsimp [Δ]
          rw [map_sub, hF0, sub_self]
        · have hm_eq := congr_arg (PowerSeries.coeff (m + 1)) hΔ_deriv
          rw [PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_derivative, PowerSeries.coeff_mul] at hm_eq
          have hsum0 : ∑ p ∈ Finset.HasAntidiagonal.antidiagonal (m + 1),
              PowerSeries.coeff p.1 Δ * PowerSeries.coeff p.2 G = 0 := by
            apply Finset.sum_eq_zero
            intro p hp
            rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
            by_cases hp2 : p.2 = 0
            · rw [hp2, hG0, mul_zero]
            · have hp1_lt : p.1 < m + 1 := by omega
              rw [ih p.1 hp1_lt, zero_mul]
          rw [hsum0] at hm_eq
          have hm_ne : ((m : K) + 1) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero m
          exact (mul_eq_zero.mp hm_eq).resolve_right hm_ne
    ext r
    have hr := hΔ_coeff r
    dsimp [Δ] at hr
    rw [map_sub] at hr
    exact sub_eq_zero.mp hr

  have h_ode_engine : ∀ (c : ℕ → ℚ), c 0 = 0 →
      ∃ Z : PowerSeries ℚ,
        PowerSeries.coeff 0 Z = 1 ∧
        PowerSeries.X * PowerSeries.derivative Z = Z * PowerSeries.mk c ∧
        (∀ (c₀ : ℕ → ℚ), c₀ 0 = 0 → (∀ r : ℕ, 0 ≤ c₀ r ∧ c₀ r ≤ c r) →
          ∃ Z₀ : PowerSeries ℚ,
            PowerSeries.coeff 0 Z₀ = 1 ∧
            PowerSeries.X * PowerSeries.derivative Z₀ = Z₀ * PowerSeries.mk c₀ ∧
            ∀ r : ℕ, 0 ≤ PowerSeries.coeff r Z₀ ∧ PowerSeries.coeff r Z₀ ≤ PowerSeries.coeff r Z) ∧
        (∀ (K : Type) [Field K] [CharZero K] (N : ℕ) (α : ℚ) (Q_K : Polynomial K),
          1 ≤ α → Q_K.coeff 0 = 1 →
