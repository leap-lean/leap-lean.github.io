    let pZ_app_B : (One_sh Z').obj.obj (Opposite.op (B_i'.obj (T_can Y'))) ⟶
        (One_sh Z₀).obj.obj (Opposite.op (M_gZ.obj (B_i'.obj (T_can Y')))) :=
