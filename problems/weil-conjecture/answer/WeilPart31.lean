                ((CategoryTheory.Category.assoc (adj_Y.unit.app R_mod)
                  (q_iY.hom.app (Opposite.op T_Y)) (One_Z.obj.map (B_iY.map τ_YV).op)).symm.trans
                  ((congrArg (fun x => CategoryTheory.CategoryStruct.comp x
                    (One_Z.obj.map (B_iY.map τ_YV).op)) hqY).trans
                    ((CategoryTheory.Category.assoc (adj_Z.unit.app R_mod)
                      (One_Z.obj.map τ_ZY.op) (One_Z.obj.map (B_iY.map τ_YV).op)).trans
                      (congrArg (CategoryTheory.CategoryStruct.comp (adj_Z.unit.app R_mod))
                        ((One_Z.obj.map_comp τ_ZY.op (B_iY.map τ_YV).op).symm.trans
                          (congrArg One_Z.obj.map
                            (CategoryTheory.op_comp (f := B_iY.map τ_YV) (g := τ_ZY)).symm)))))))))
      exact (hLHS.trans
        (congrArg (fun k => CategoryTheory.CategoryStruct.comp (adj_Z.unit.app R_mod)
          (One_Z.obj.map k.op))
          (hT_Z.hom_ext μ_V' (CategoryTheory.CategoryStruct.comp (B_iY.map τ_YV) τ_ZY)))).trans
        hRHS.symm

