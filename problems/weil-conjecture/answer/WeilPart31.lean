      (X.left.fromSpecResidueField x)
  let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := Classical.arbitrary _
  let x_U : ↥(Fgt.obj U).left := γ.base pt_Ω
  let x' : ↥X.left := ((Fgt.obj U).hom).base x_U
  obtain ⟨U_k, hAff_Uk, V_X, hAff_VX, hx'_VX, e_XV, hStd⟩ :=
    (AlgebraicGeometry.smoothOfRelativeDimension_iff d X.hom).mp inferInstance x'
  obtain ⟨g_et, hget_C, hget_et⟩ := hStd.exists_etale_mvPolynomial
  let id_Sk : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of k) := 𝟙 _
  have hUk_sub : Set.range id_Sk.base ⊆ Set.range U_k.ι.base := by
    rintro p -
    rw [AlgebraicGeometry.Scheme.Opens.range_ι, Subsingleton.elim p (X.hom.base x')]
    exact e_XV hx'_VX
  let inv_Uk : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U_k.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U_k.ι (𝟙 _) hUk_sub
  have h_inv_Uk : inv_Uk ≫ U_k.ι = 𝟙 _ :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U_k.ι (𝟙 _) hUk_sub
  have h_Uk_inv : U_k.ι ≫ inv_Uk = 𝟙 _ := by
    apply (cancel_mono U_k.ι).mp
    rw [CategoryTheory.Category.assoc, h_inv_Uk,
      CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
  have hIso_Uk : CategoryTheory.IsIso U_k.ι := ⟨⟨inv_Uk, h_Uk_inv, h_inv_Uk⟩⟩
  have hIso_from : CategoryTheory.IsIso hAff_Uk.fromSpec := by
    rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
    infer_instance
  let α_k := AlgebraicGeometry.Spec.preimage hAff_Uk.fromSpec
  let β_k := AlgebraicGeometry.Spec.preimage (CategoryTheory.inv hAff_Uk.fromSpec)
  have hαβ : α_k ≫ β_k = 𝟙 _ := AlgebraicGeometry.Spec.map_injective (by
    rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
      AlgebraicGeometry.Spec.map_preimage, CategoryTheory.IsIso.inv_hom_id,
      AlgebraicGeometry.Spec.map_id])
  have hβα : β_k ≫ α_k = 𝟙 _ := AlgebraicGeometry.Spec.map_injective (by
    rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
      AlgebraicGeometry.Spec.map_preimage, CategoryTheory.IsIso.hom_inv_id,
      AlgebraicGeometry.Spec.map_id])
  let m_α : MvPolynomial (Fin d) k →+*
      MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U_k)) :=
    MvPolynomial.map α_k.hom
  let m_β : MvPolynomial (Fin d)
      ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U_k)) →+*
      MvPolynomial (Fin d) k :=
    MvPolynomial.map β_k.hom
  have hm_αβ : m_α.comp m_β = RingHom.id _ := by
    apply RingHom.ext
    intro p
    change m_α (m_β p) = p
    dsimp [m_α, m_β]
    rw [MvPolynomial.map_map,
      show α_k.hom.comp β_k.hom = RingHom.id _ from congrArg CommRingCat.Hom.hom hβα,
      MvPolynomial.map_id]
  have hm_βα : m_β.comp m_α = RingHom.id _ := by
    apply RingHom.ext
    intro p
    change m_β (m_α p) = p
    dsimp [m_α, m_β]
    rw [MvPolynomial.map_map,
      show β_k.hom.comp α_k.hom = RingHom.id _ from congrArg CommRingCat.Hom.hom hαβ,
      MvPolynomial.map_id]
  have hm_iso : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom m_α)) :=
    ⟨⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom m_β),
      by rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hm_αβ,
          CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id],
      by rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hm_βα,
          CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]⟩⟩
  have hEt_get : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_et)) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hget_et
  let u_VX : V_X.toScheme ⟶ (weilCupPDTraceAffineSpaceOver k d).left :=
    hAff_VX.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_et) ≫
