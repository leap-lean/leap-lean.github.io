        let res'_h : S →+* S'_h :=
          (H.presheaf.map (CategoryTheory.homOfLE (H.basicOpen_le (φ_U h))).op).hom
        have halg_S : (algebraMap S S'_h : S →+* S'_h) = res'_h := rfl
        have heq_H : (ι_H ⁻¹ᵁ U_h : H.Opens) = H.basicOpen (φ_U h) :=
          ι_H.preimage_basicOpen h
        let e_H : H.presheaf.obj (Opposite.op (ι_H ⁻¹ᵁ U_h)) ≅
            H.presheaf.obj (Opposite.op (H.basicOpen (φ_U h))) :=
          H.presheaf.mapIso (CategoryTheory.eqToIso (congrArg Opposite.op heq_H))
        have hcomm_h : ∀ x : R, e_H.hom.hom ((ι_H.app U_h).hom (res_h x)) = res'_h (φ_U x) := by
          intro x
          have hnat := ι_H.naturality (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h)).op
          have h1 : (Z_bar.left.presheaf.map (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h)).op ≫
              ι_H.app U_h ≫ e_H.hom).hom x =
              (ι_H.app U ≫ H.presheaf.map (CategoryTheory.homOfLE (H.basicOpen_le (φ_U h))).op).hom x := by
            dsimp only [e_H, CategoryTheory.Functor.mapIso_hom, CategoryTheory.eqToIso.hom]
            rw [← CategoryTheory.Category.assoc, hnat, CategoryTheory.Category.assoc,
              ← H.presheaf.map_comp]
            have hmor : ((TopologicalSpace.Opens.map ι_H.base).map
                (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h)).op.unop).op ≫
                CategoryTheory.eqToHom (congrArg Opposite.op heq_H) =
                (CategoryTheory.homOfLE (H.basicOpen_le (φ_U h))).op :=
              Subsingleton.elim _ _
            rw [hmor]
          exact h1
        refine ⟨?_, ?_⟩
        · intro hr
          have h0 : e_H.hom.hom ((ι_H.app U_h).hom (res_h r)) = 0 := by
            rw [hcomm_h r, RingHom.mem_ker.mp hr, map_zero]
          apply RingHom.mem_ker.mpr
          have hinv := RingHom.congr_fun (congrArg CommRingCat.Hom.hom e_H.hom_inv_id)
            ((ι_H.app U_h).hom (res_h r))
          change e_H.inv.hom (e_H.hom.hom ((ι_H.app U_h).hom (res_h r))) =
            (ι_H.app U_h).hom (res_h r) at hinv
          rw [h0, map_zero] at hinv
          exact hinv.symm
        · intro hr_h
          have h0 : (algebraMap S S'_h) (φ_U r) = 0 := by
            rw [halg_S, ← hcomm_h r, RingHom.mem_ker.mp hr_h, map_zero]
          obtain ⟨⟨_, n, rfl⟩, hn⟩ :=
            (IsLocalization.map_eq_zero_iff (Submonoid.powers (φ_U h)) S'_h (φ_U r)).mp h0
          refine ⟨n, ?_⟩
          change φ_U (h ^ n * r) = 0
          rw [map_mul, map_pow]
          exact hn
      have hLoc_J₂ : ∀ (h r : R),
          let res_h := (Z_bar.left.presheaf.map
            (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h)).op).hom
          (r ∈ J₂ → res_h r ∈ Ideal.span {res_h f_U}) ∧
          (res_h r ∈ Ideal.span {res_h f_U} → ∃ n : ℕ, h ^ n * r ∈ J₂) := by
        intro h r res_h
        let R_h := ↑(Z_bar.left.presheaf.obj (Opposite.op (Z_bar.left.basicOpen h)))
        have _ : IsLocalization.Away h R_h := hAffU.isLocalization_basicOpen h
        have halg_R : (algebraMap R R_h : R →+* R_h) = res_h := rfl
        refine ⟨?_, ?_⟩
        · intro hr
          obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hr
          rw [map_mul]
          exact Ideal.mem_span_singleton.mpr ⟨res_h a, rfl⟩
        · intro hr_h
          obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp hr_h
          obtain ⟨⟨a, ⟨_, m, rfl⟩⟩, hsurj⟩ := IsLocalization.surj (Submonoid.powers h) q
          have h1 : (algebraMap R R_h) (h ^ m * r - f_U * a) = 0 := by
            rw [map_sub, map_mul, map_mul, halg_R, hq, mul_comm (res_h (h ^ m)) (res_h f_U * q),
              mul_assoc, ← halg_R, hsurj, sub_self]
          obtain ⟨⟨_, n, rfl⟩, hn⟩ :=
            (IsLocalization.map_eq_zero_iff (Submonoid.powers h) R_h (h ^ m * r - f_U * a)).mp h1
          refine ⟨n + m, ?_⟩
          have heq_r : h ^ (n + m) * r = f_U * (h ^ n * a) := by
            have hsub0 : h ^ n * (h ^ m * r) = h ^ n * (f_U * a) :=
              sub_eq_zero.mp (by rwa [mul_sub] at hn)
            calc h ^ (n + m) * r = h ^ n * (h ^ m * r) := by rw [pow_add, mul_assoc]
              _ = h ^ n * (f_U * a) := hsub0
              _ = f_U * (h ^ n * a) := by ring
          rw [heq_r]
          exact Ideal.mem_span_singleton.mpr ⟨h ^ n * a, rfl⟩
      have hPrimeChart : ∀ (𝔭 : Ideal R), 𝔭.IsPrime →
          ∃ h : R, h ∉ 𝔭 ∧
            let U_h := Z_bar.left.basicOpen h
            let res_h := (Z_bar.left.presheaf.map
              (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h)).op).hom
            RingHom.ker (ι_H.app U_h).hom = Ideal.span {res_h f_U} := by
        intro 𝔭 h𝔭
        let p_pt : PrimeSpectrum R := ⟨𝔭, h𝔭⟩
        let v_pt : ↥U.toScheme := hAffU.isoSpec.inv.base p_pt
        let z : Z_bar.left := U.ι.base v_pt
        have hz_from : hAffU.fromSpec.base p_pt = z := rfl
        obtain ⟨α, hz_α⟩ := hProjCover M (ι_bar_left.base z)
        have hz_mem : z ∈ U ⊓ (TopologicalSpace.Opens.map ι_bar_left.base).obj (D_M α) :=
          ⟨v_pt.2, hz_α⟩
        obtain ⟨h, hh_le, hz_Uh⟩ := hAffU.exists_basicOpen_le ⟨z, hz_mem⟩ v_pt.2
        have hh_not_𝔭 : h ∉ 𝔭 := by
          have hp_mem : p_pt ∈ (TopologicalSpace.Opens.map hAffU.fromSpec.base).obj
              (Z_bar.left.basicOpen h) := by
            change hAffU.fromSpec.base p_pt ∈ Z_bar.left.basicOpen h
            rwa [hz_from]
          rw [hAffU.fromSpec_preimage_basicOpen h] at hp_mem
          exact hp_mem
        refine ⟨h, hh_not_𝔭, ?_⟩
        dsimp only
        let U_h := Z_bar.left.basicOpen h
        let res_h := (Z_bar.left.presheaf.map
          (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h)).op).hom
        have hAff_Uh : AlgebraicGeometry.IsAffineOpen U_h := hAffU.basicOpen h
        have hUh_α : U_h ≤ (TopologicalSpace.Opens.map ι_bar_left.base).obj (D_M α) :=
          hh_le.trans inf_le_right
        have hUh_μ : U_h ≤ (TopologicalSpace.Opens.map f₀.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ)) :=
          (Z_bar.left.basicOpen_le h).trans hU_sub
        have hKer_Uh := hKer_M α (hXM α) U_h hAff_Uh hUh_α
        let e_ℓ : HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α) :=
          HomogeneousLocalization.mk ⟨1, ⟨L, hL⟩, ⟨MvPolynomial.X α, hXM α⟩, ⟨1, pow_one _⟩⟩
        let ℓ_Uh := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) (hXM α) zero_lt_one).hom ≫
          ι_bar_left.appLE (D_M α) U_h hUh_α).hom e_ℓ
        have hℓ_eq : (ι_bar.left.appLE (D_M α) U_h hUh_α).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜_M (MvPolynomial.X α)).hom
              (HomogeneousLocalization.Away.mk 𝒜_M (hXM α) 1 L hL_smul)) = ℓ_Uh := by
          dsimp only [ℓ_Uh]
          rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
          change (ι_bar_left.appLE (D_M α) U_h hUh_α).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜_M (MvPolynomial.X α)).hom _) =
            (ι_bar_left.appLE (D_M α) U_h hUh_α).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜_M (MvPolynomial.X α)).hom e_ℓ)
          apply congrArg ((ι_bar_left.appLE (D_M α) U_h hUh_α).hom ∘
            (AlgebraicGeometry.Proj.awayToSection 𝒜_M (MvPolynomial.X α)).hom)
          apply HomogeneousLocalization.val_injective
          rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_mk]
          dsimp only [e_ℓ]
          simp only [pow_one]
        rw [hℓ_eq] at hKer_Uh
        have hg_unit := hUnit_and_Ratio.1 α μ hXμ U_h hUh_α hUh_μ
        have hratio := hUnit_and_Ratio.2 L hL hFL α (hXM α) μ hXμ U_h hUh_α hUh_μ
        have hres_fU : res_h f_U =
            ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one).hom ≫
              f₀.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ)) U_h hUh_μ).hom
              (HomogeneousLocalization.mk ⟨3, ⟨F_L, hFL⟩, ⟨MvPolynomial.X μ ^ 3, hXμ3⟩, ⟨3, rfl⟩⟩) := by
          dsimp only [res_h, f_U]
          have hmap := f₀.appLE_map hU_sub (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h)).op
          exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom
            (congrArg (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one).hom) hmap)) _
        exact hKer_Uh.trans
          ((Ideal.span_singleton_mul_left_unit hg_unit ℓ_Uh).symm.trans
            (congrArg (fun x => Ideal.span {x}) (hratio.trans hres_fU.symm)))
      apply le_antisymm
      · refine hColonGlue J₁ J₂ fun 𝔭 h𝔭 => ?_
        obtain ⟨h, hh_not, hKer_eq⟩ := hPrimeChart 𝔭 h𝔭
        refine ⟨h, hh_not, fun r hr => ?_⟩
        have hr_h : (Z_bar.left.presheaf.map
            (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h)).op).hom r ∈
            Ideal.span {(Z_bar.left.presheaf.map
              (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h)).op).hom f_U} := by
          rw [← hKer_eq]
          exact (hLoc_J₁ h r).1 hr
        exact (hLoc_J₂ h r).2 hr_h
      · refine hColonGlue J₂ J₁ fun 𝔭 h𝔭 => ?_
        obtain ⟨h, hh_not, hKer_eq⟩ := hPrimeChart 𝔭 h𝔭
        refine ⟨h, hh_not, fun r hr => ?_⟩
        have hr_h : (Z_bar.left.presheaf.map
            (CategoryTheory.homOfLE (Z_bar.left.basicOpen_le h)).op).hom r ∈
            RingHom.ker (ι_H.app (Z_bar.left.basicOpen h)).hom := by
          rw [hKer_eq]
          exact (hLoc_J₂ h r).1 hr
        exact (hLoc_J₁ h r).2 hr_h

