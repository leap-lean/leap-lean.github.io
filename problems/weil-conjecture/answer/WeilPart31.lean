            have hsum : Θ₀ G (e0_lift G φ₁ + e0_lift G φ₂) = φ₁ + φ₂ := by
              rw [map_add, he0_lift, he0_lift]
            calc
              Ω₀ G (e0_lift G (φ₁ + φ₂)) = Ω₀ G (e0_lift G (Θ₀ G (e0_lift G φ₁ + e0_lift G φ₂))) := by
                rw [hsum]
              _ = Ω₀ G (e0_lift G φ₁ + e0_lift G φ₂) := (hΩ_eq_e0 G _).symm
              _ = Ω₀ G (e0_lift G φ₁) + Ω₀ G (e0_lift G φ₂) := map_add (Ω₀ G) _ _ }
      have hE₀_nat : ∀ (G : 𝒞₀) (φ : CategoryTheory.Abelian.Ext.{u} one₀ G 0 →+ ZMod n)
          (α : CategoryTheory.Abelian.Ext.{u} one₀ G 0),
          α.comp (E₀ G φ) (Nat.zero_add 1) =
            E₀ one₀ (φ.comp (α.postcomp one₀ (Nat.add_zero 0))) := by
        intro G φ α
        let s : one₀ ⟶ G := CategoryTheory.Abelian.Ext.addEquiv₀ α
        have hs_mk : CategoryTheory.Abelian.Ext.mk₀ s = α :=
          CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply α
        let f := e0_lift G φ
        have hLHS : α.comp (E₀ G φ) (Nat.zero_add 1) = Ω₀ one₀ (s ≫ f) := by
