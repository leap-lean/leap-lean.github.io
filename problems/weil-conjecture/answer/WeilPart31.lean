        F_sh.map g_sub ≫ τ₃.hom := by
      rw [← CategoryTheory.Iso.cancel_iso_inv_left (F_sh.mapBiprod (S_sub ℋ W₁) (S_sub ℋ W₂))]
      have hτ₂ : (F_sh.mapBiprod (S_sub ℋ W₁) (S_sub ℋ W₂)).inv ≫ τ₂.hom =
          CategoryTheory.Limits.biprod.map
            (F_sh.map (Θ_iso ℋ W₁).inv) (F_sh.map (Θ_iso ℋ W₂).inv) := by
        dsimp only [τ₂, Iso.trans_hom]
        rw [Iso.inv_hom_id_assoc]
        rfl
      rw [← Category.assoc, hτ₂]
      apply CategoryTheory.Limits.biprod.hom_ext'
      · simp only [CategoryTheory.Functor.mapBiprod_inv, τ₃, Iso.symm_hom, Functor.mapIso_hom,
          CategoryTheory.Limits.biprod.inl_map_assoc,
          CategoryTheory.Limits.biprod.inl_desc, CategoryTheory.Limits.biprod.inl_desc_assoc]
        dsimp only [g₁, ι_ext, ι_pSh, g_sub]
        rw [← F_sh.map_comp, ← F_sh.map_comp, ← F_sh.map_comp,
          CategoryTheory.Limits.biprod.inl_desc_assoc, (Θ_iso ℋ W₁).inv_hom_id_assoc]
      · simp only [CategoryTheory.Functor.mapBiprod_inv, τ₃, Iso.symm_hom, Functor.mapIso_hom,
          CategoryTheory.Limits.biprod.inr_map_assoc,
          CategoryTheory.Limits.biprod.inr_desc, CategoryTheory.Limits.biprod.inr_desc_assoc]
        dsimp only [g₂, ι_ext, ι_pSh, g_sub]
        rw [← F_sh.map_comp, ← F_sh.map_comp, ← F_sh.map_comp,
          CategoryTheory.Limits.biprod.inr_desc_assoc, (Θ_iso ℋ W₂).inv_hom_id_assoc]

    have h0 : CategoryTheory.Limits.biprod.lift f₁ (-f₂) ≫
        CategoryTheory.Limits.biprod.desc g₁ g₂ = 0 := by
      rw [← CategoryTheory.Iso.cancel_iso_hom_left τ₁]
      calc
        τ₁.hom ≫ (CategoryTheory.Limits.biprod.lift f₁ (-f₂) ≫
            CategoryTheory.Limits.biprod.desc g₁ g₂)
          = (τ₁.hom ≫ CategoryTheory.Limits.biprod.lift f₁ (-f₂)) ≫
              CategoryTheory.Limits.biprod.desc g₁ g₂ := (Category.assoc _ _ _).symm
        _ = (F_sh.map f_sub ≫ τ₂.hom) ≫ CategoryTheory.Limits.biprod.desc g₁ g₂ := by
            rw [h_sq₁]
        _ = F_sh.map f_sub ≫ (τ₂.hom ≫ CategoryTheory.Limits.biprod.desc g₁ g₂) :=
            Category.assoc _ _ _
        _ = F_sh.map f_sub ≫ (F_sh.map g_sub ≫ τ₃.hom) := by rw [h_sq₂]
        _ = (F_sh.map f_sub ≫ F_sh.map g_sub) ≫ τ₃.hom := (Category.assoc _ _ _).symm
        _ = 0 ≫ τ₃.hom := by rw [h0_sh_sub]
        _ = τ₁.hom ≫ 0 := by simp

    refine ⟨h0, CategoryTheory.ShortComplex.shortExact_of_iso
      (CategoryTheory.ShortComplex.isoMk τ₁ τ₂ τ₃ h_sq₁ h_sq₂) hSE_sub⟩

theorem weil_gysin_zariski_mayer_vietoris_support_gluing (Z Y : AlgebraicGeometry.Scheme.{u}) (i : Quiver.Hom Z Y)
    (hi : AlgebraicGeometry.IsClosedImmersion i)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r D n : ℕ)
    (V_cov : Fin n → Y.Opens)
    (hcov : (⋃ α : Fin n, (V_cov α : Set Y)) = Set.univ)
    (hvan : ∀ (α : Fin n) (W_sub : Y.Opens), W_sub ≤ V_cov α →
      ∀ (q : ℕ), q < D →
        let U_sub : Z.Opens := (TopologicalSpace.Opens.map i.base).obj W_sub
        ∀ β : WeilGysinSupportClass U_sub.toScheme W_sub.toScheme
            (i.resLE W_sub U_sub (le_refl _)) (ℓ ^ r) q,
          β.val = 0) :
    (∀ (τ₁ τ₂ : WeilGysinSupportClass Z Y i (ℓ ^ r) D),
      (∀ α : Fin n,
        let U_α : Z.Opens := (TopologicalSpace.Opens.map i.base).obj (V_cov α)
