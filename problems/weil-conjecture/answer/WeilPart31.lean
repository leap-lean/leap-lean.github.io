          ∃ E_r : ∀ G : 𝒞₀,
              (CategoryTheory.Abelian.Ext.{u} one₀ G 0 →+ ZMod n) ≃+
                CategoryTheory.Abelian.Ext.{u} G (B r) (r + 1),
            ∀ (G : 𝒞₀) (φ : CategoryTheory.Abelian.Ext.{u} one₀ G 0 →+ ZMod n)
