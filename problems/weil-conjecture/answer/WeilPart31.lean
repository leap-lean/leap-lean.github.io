    weil_gysin_support_pullback_forget_and_clopen_sum.{u} ℓ
  have hSuppExt : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} {i : Quiver.Hom Z Y} {m q : ℕ}
      (τ₁ τ₂ : WeilGysinSupportClass Z Y i m q), τ₁.val = τ₂.val → τ₁ = τ₂ := by
    rintro Z Y i m q ⟨_, v₁⟩ ⟨_, v₂⟩ hv
