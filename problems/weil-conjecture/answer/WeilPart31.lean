            have hsum_abs : |((∑ s ∈ Finset.range (m + 1), odeSeq (-c) s * (-c) (m + 1 - s) : ℚ) : ℝ)| ≤
                ((d : ℝ) + 1) * (∑ s ∈ Finset.range (m + 1), ((Nat.choose (s + d) d : ℕ) : ℝ)) *
                  ρ ^ (m + 1) := by
              have h_neg_fn : ∀ x : ℕ, (-c) x = -(c x) := fun _ => rfl
              simp only [h_neg_fn]
              push_cast
              calc |∑ s ∈ Finset.range (m + 1), (odeSeq (-c) s : ℝ) * -(c (m + 1 - s) : ℝ)|
                  ≤ ∑ s ∈ Finset.range (m + 1), |(odeSeq (-c) s : ℝ) * -(c (m + 1 - s) : ℝ)| :=
                    Finset.abs_sum_le_sum_abs _ _
                _ ≤ ∑ s ∈ Finset.range (m + 1),
                      (((Nat.choose (s + d) d : ℕ) : ℝ) * ρ ^ s) *
                        (((d : ℝ) + 1) * ρ ^ (m + 1 - s)) := by
                    apply Finset.sum_le_sum
                    intro s hs
                    rw [Finset.mem_range] at hs
                    rw [abs_mul, abs_neg]
                    have hc_s := hc_geom (m + 1 - s) (by omega)
                    push_cast at hc_s
                    exact mul_le_mul (ih s hs) hc_s (abs_nonneg _) (by positivity)
                _ = ((d : ℝ) + 1) *
                      (∑ s ∈ Finset.range (m + 1), ((Nat.choose (s + d) d : ℕ) : ℝ)) * ρ ^ (m + 1) := by
                    have h_term : ∀ s ∈ Finset.range (m + 1),
                        (((Nat.choose (s + d) d : ℕ) : ℝ) * ρ ^ s) *
                          (((d : ℝ) + 1) * ρ ^ (m + 1 - s)) =
                        (((d : ℝ) + 1) * ρ ^ (m + 1)) * ((Nat.choose (s + d) d : ℕ) : ℝ) := by
                      intro s hs
                      rw [Finset.mem_range] at hs
                      have hpow_add : ρ ^ s * ρ ^ (m + 1 - s) = ρ ^ (m + 1) := by
                        rw [← pow_add, Nat.add_sub_of_le (by omega)]
                      calc (((Nat.choose (s + d) d : ℕ) : ℝ) * ρ ^ s) *
                            (((d : ℝ) + 1) * ρ ^ (m + 1 - s))
                          = ((d : ℝ) + 1) * (ρ ^ s * ρ ^ (m + 1 - s)) *
                              ((Nat.choose (s + d) d : ℕ) : ℝ) := by ring
                        _ = (((d : ℝ) + 1) * ρ ^ (m + 1)) * ((Nat.choose (s + d) d : ℕ) : ℝ) := by
                            rw [hpow_add, mul_assoc]
                    rw [Finset.sum_congr rfl h_term, ← Finset.mul_sum]
                    ring
            have h_hockey_nat : (d + 1) * (∑ s ∈ Finset.range (m + 1), (s + d).choose d) =
                (m + 1) * (m + 1 + d).choose d := by
              rw [Nat.sum_range_add_choose m d, mul_comm, Nat.choose_succ_right_eq (m + d + 1) d]
              have hsub : m + d + 1 - d = m + 1 := by omega
              have hadd : m + d + 1 = m + 1 + d := by omega
              rw [hsub, hadd, mul_comm]
            have h_hockey_real : ((d : ℝ) + 1) *
                  (∑ s ∈ Finset.range (m + 1), ((Nat.choose (s + d) d : ℕ) : ℝ)) =
                ((m : ℝ) + 1) * ((Nat.choose (m + 1 + d) d : ℕ) : ℝ) := by
              have hcast : (((d + 1) * (∑ s ∈ Finset.range (m + 1), (s + d).choose d) : ℕ) : ℝ) =
                  (((m + 1) * (m + 1 + d).choose d : ℕ) : ℝ) := by exact_mod_cast h_hockey_nat
              push_cast at hcast
              exact hcast
            rw [h_hockey_real] at hsum_abs
            calc (((m : ℝ) + 1))⁻¹ * |((∑ s ∈ Finset.range (m + 1), odeSeq (-c) s * (-c) (m + 1 - s) : ℚ) : ℝ)|
                ≤ (((m : ℝ) + 1))⁻¹ * (((m : ℝ) + 1) * ((Nat.choose (m + 1 + d) d : ℕ) : ℝ) * ρ ^ (m + 1)) :=
                  mul_le_mul_of_nonneg_left hsum_abs (inv_nonneg.mpr hm1_pos.le)
              _ = ((Nat.choose (m + 1 + d) d : ℕ) : ℝ) * ρ ^ (m + 1) := by
                  rw [← mul_assoc, ← mul_assoc, inv_mul_cancel₀ hm1_pos.ne', one_mul]
      have h_choose_le_pow : ∀ (k r : ℕ), (r + k).choose k ≤ (r + 1) ^ k := by
        intro k
        induction k with
        | zero =>
          intro r
          simp
        | succ k' ihk =>
          intro r
          have h_eq : (r + (k' + 1)).choose (k' + 1) = ∑ s ∈ Finset.range (r + 1), (s + k').choose k' := by
            have h1 := (Nat.sum_range_add_choose r k').symm
            have hadd : r + k' + 1 = r + (k' + 1) := by omega
            rwa [hadd] at h1
          rw [h_eq]
          calc ∑ s ∈ Finset.range (r + 1), (s + k').choose k'
              ≤ ∑ s ∈ Finset.range (r + 1), (r + 1) ^ k' := by
                apply Finset.sum_le_sum
                intro s hs
                rw [Finset.mem_range] at hs
                exact le_trans (ihk s) (Nat.pow_le_pow_left (by omega) k')
            _ = (r + 1) ^ (k' + 1) := by
                rw [Finset.sum_const, Finset.card_range, smul_eq_mul, pow_succ']
      refine ⟨W, d, hZW_eq_one, fun r => ?_⟩
      calc |((PowerSeries.coeff r W : ℚ) : ℝ)|
          ≤ ((Nat.choose (r + d) d : ℕ) : ℝ) * ρ ^ r := hW_choose r
        _ ≤ (((r + 1) ^ d : ℕ) : ℝ) * ρ ^ r := by
            gcongr
            exact_mod_cast h_choose_le_pow d r
        _ = ((r : ℝ) + 1) ^ d * ρ ^ r := by push_cast; rfl

  
  have h_multiset_recip : ∀ (d₀ m : ℕ), 1 ≤ d₀ → ∀ (R₀ : Multiset ℂ) (F : PowerSeries ℂ),
      PowerSeries.coeff 0 F = 1 →
      PowerSeries.X * PowerSeries.derivative F =
        F * PowerSeries.mk (fun r =>
          if r ≠ 0 ∧ d₀ ∣ r then (d₀ : ℂ) * ((R₀.map (· ^ (r / d₀))).sum) ^ m else 0) →
      ∃ Q : Polynomial ℂ,
        Polynomial.toPowerSeries Q * F = 1 ∧
        ∀ z ∈ R₀, ∀ t₀ : ℂ, z ^ m * t₀ ^ d₀ = 1 → Polynomial.eval t₀ Q = 0 := by
    intro d₀ m hd₀ R₀ F hF0 hFderiv
    let mulPow : ℕ → Multiset ℂ :=
      fun j => Nat.rec ({1} : Multiset ℂ) (fun _ acc => R₀.bind (fun a => acc.map (a * ·))) j
    have h_sum_mul_left : ∀ (S : Multiset ℂ) (c₀ : ℂ), (S.map (c₀ * ·)).sum = c₀ * S.sum := by
      intro S c₀
      refine Multiset.induction_on S (by simp) (fun x S' ih => ?_)
      simp [ih, mul_add]
    have h_sum_mul_right : ∀ (S : Multiset ℂ) (c₀ : ℂ), (S.map (· * c₀)).sum = S.sum * c₀ := by
      intro S c₀
      refine Multiset.induction_on S (by simp) (fun x S' ih => ?_)
      simp [ih, add_mul]
    have h_mulPow_sum : ∀ (j s : ℕ), ((mulPow j).map (· ^ s)).sum = ((R₀.map (· ^ s)).sum) ^ j := by
      intro j s
      induction j with
      | zero =>
        change (({1} : Multiset ℂ).map (· ^ s)).sum = _
        simp
      | succ j' ihj =>
        change ((R₀.bind (fun a => (mulPow j').map (a * ·))).map (· ^ s)).sum = _
        rw [Multiset.map_bind, Multiset.sum_bind]
        have h_inner : (fun a : ℂ => (((mulPow j').map (a * ·)).map (· ^ s)).sum) =
            (fun a : ℂ => a ^ s * ((mulPow j').map (· ^ s)).sum) := by
          funext a
          rw [Multiset.map_map]
          have hfn : ((fun x : ℂ => x ^ s) ∘ (fun b : ℂ => a * b)) =
              ((fun y : ℂ => a ^ s * y) ∘ (fun b : ℂ => b ^ s)) := by
            funext b
            simp [mul_pow]
          rw [hfn, ← Multiset.map_map, h_sum_mul_left]
        rw [h_inner]
        have hmap2 : R₀.map (fun a : ℂ => a ^ s * ((mulPow j').map (· ^ s)).sum) =
            (R₀.map (· ^ s)).map (· * ((mulPow j').map (· ^ s)).sum) := by
          rw [Multiset.map_map]
          rfl
        rw [hmap2, h_sum_mul_right, ihj, pow_succ']
    have h_mulPow_mem : ∀ z ∈ R₀, ∀ j : ℕ, z ^ j ∈ mulPow j := by
      intro z hz j
      induction j with
      | zero =>
        change z ^ 0 ∈ ({1} : Multiset ℂ)
        simp
      | succ j' ihj =>
        change z ^ (j' + 1) ∈ R₀.bind (fun a => (mulPow j').map (a * ·))
        rw [pow_succ', Multiset.mem_bind]
        exact ⟨z, hz, Multiset.mem_map.mpr ⟨z ^ j', ihj, rfl⟩⟩
    let Q : Polynomial ℂ :=
      ((mulPow m).map (fun μ => (1 : Polynomial ℂ) - Polynomial.C μ * Polynomial.X ^ d₀)).prod
    rcases h_polyProd_logDeriv ℂ d₀ hd₀ (mulPow m) with ⟨hQ0, hQderiv⟩
    have hQ_root : ∀ z ∈ R₀, ∀ t₀ : ℂ, z ^ m * t₀ ^ d₀ = 1 → Polynomial.eval t₀ Q = 0 := by
      intro z hz t₀ hzt
      have hzm : z ^ m ∈ mulPow m := h_mulPow_mem z hz m
      let q_z : Polynomial ℂ := (1 : Polynomial ℂ) - Polynomial.C (z ^ m) * Polynomial.X ^ d₀
      have hqz_mem : q_z ∈ (mulPow m).map
          (fun μ => (1 : Polynomial ℂ) - Polynomial.C μ * Polynomial.X ^ d₀) :=
        Multiset.mem_map.mpr ⟨z ^ m, hzm, rfl⟩
      rcases Multiset.dvd_prod hqz_mem with ⟨R_rem, hQ_eq⟩
      dsimp [Q]
      rw [hQ_eq, Polynomial.eval_mul]
      have hqz_eval : Polynomial.eval t₀ q_z = 0 := by
        dsimp [q_z]
        simp [hzt]
      rw [hqz_eval, zero_mul]
    have hQF0 : PowerSeries.coeff 0 (Polynomial.toPowerSeries Q * F) = PowerSeries.coeff 0 1 := by
      rw [PowerSeries.coeff_mul, Finset.HasAntidiagonal.antidiagonal_zero, Finset.sum_singleton,
        Polynomial.coeff_coe, PowerSeries.coeff_one, if_pos rfl]
      dsimp [Q]
      rw [hQ0, hF0, mul_one]
    have hL_eq : PowerSeries.mk (fun r =>
          if r ≠ 0 ∧ d₀ ∣ r then (d₀ : ℂ) * ((mulPow m).map (· ^ (r / d₀))).sum else 0) =
        PowerSeries.mk (fun r =>
          if r ≠ 0 ∧ d₀ ∣ r then (d₀ : ℂ) * ((R₀.map (· ^ (r / d₀))).sum) ^ m else 0) := by
      ext r
      simp only [PowerSeries.coeff_mk]
      split_ifs
      · rw [h_mulPow_sum]
      · rfl
    have hQF_deriv : PowerSeries.X * PowerSeries.derivative (Polynomial.toPowerSeries Q * F) =
        (Polynomial.toPowerSeries Q * F) * 0 := by
      rw [Derivation.leibniz]
      dsimp only [smul_eq_mul]
      have h_leib : PowerSeries.X * (Polynomial.toPowerSeries Q * PowerSeries.derivative F +
            F * PowerSeries.derivative (Polynomial.toPowerSeries Q)) =
          Polynomial.toPowerSeries Q * (PowerSeries.X * PowerSeries.derivative F) +
            (PowerSeries.X * PowerSeries.derivative (Polynomial.toPowerSeries Q)) * F := by ring
      change PowerSeries.X * PowerSeries.derivative (Polynomial.toPowerSeries Q) =
        - Polynomial.toPowerSeries Q * _ at hQderiv
      rw [h_leib, hFderiv, hQderiv, hL_eq]
      ring
    exact ⟨Q, h_ode_unique ℂ (Polynomial.toPowerSeries Q * F) 1 0 (by simp) hQF0 hQF_deriv (by simp),
      hQ_root⟩

  
  have h_zero_free_disk : ∀ (P : Polynomial ℂ) (F : PowerSeries ℂ),
      Polynomial.toPowerSeries P * F = 1 →
      ∀ (C ρ : ℝ) (B : ℕ), 0 ≤ C → 0 < ρ →
        (∀ r : ℕ, ‖PowerSeries.coeff r F‖ ≤ C * ((r : ℝ) + 1) ^ B * ρ ^ r) →
        ∀ t₀ : ℂ, ρ * ‖t₀‖ < 1 → Polynomial.eval t₀ P ≠ 0 := by
    intro P F hInv C ρ B hC hρ hBound t₀ ht₀ hEval
    have hP0_ne : P.coeff 0 ≠ 0 := by
      intro hp0
      have h0 := congr_arg (PowerSeries.coeff 0) hInv
      rw [PowerSeries.coeff_mul, Finset.HasAntidiagonal.antidiagonal_zero, Finset.sum_singleton,
        Polynomial.coeff_coe, PowerSeries.coeff_one, if_pos rfl, hp0, zero_mul] at h0
      exact zero_ne_one h0
    have ht₀_ne : t₀ ≠ 0 := by
      intro ht0
      rw [ht0, ← Polynomial.coeff_zero_eq_eval_zero] at hEval
      exact hP0_ne hEval
    have ht₀_pos : 0 < ‖t₀‖ := norm_pos_iff.mpr ht₀_ne
    let D : ℕ := P.natDegree
    have hD_pos : 1 ≤ D := by
      by_contra hD0
      have hD_eq : P.natDegree = 0 := by omega
      have hPC := Polynomial.eq_C_of_natDegree_eq_zero hD_eq
      rw [hPC, Polynomial.eval_C] at hEval
      exact hP0_ne hEval
    let M_P : ℝ := ∑ i ∈ Finset.range (D + 1), ‖P.coeff i‖ * ‖t₀‖ ^ i
    have hMP_nn : 0 ≤ M_P := Finset.sum_nonneg (fun _ _ => by positivity)
    let θ : ℝ := ρ * ‖t₀‖
    have hθ_pos : 0 < θ := mul_pos hρ ht₀_pos
    let a : ℕ → ℝ := fun r => C * ((r : ℝ) + 1) ^ B * θ ^ r
    have h_trunc : ∀ N : ℕ, D ≤ N → 1 ≤ M_P * ∑ r ∈ Finset.Ico (N + 1 - D) (N + 1), a r := by
      intro N hND
      let Ω : Finset (ℕ × ℕ) := Finset.range (D + 1) ×ˢ Finset.range (N + 1)
      let g : ℕ × ℕ → ℂ := fun p => P.coeff p.1 * PowerSeries.coeff p.2 F * t₀ ^ (p.1 + p.2)
      have hΩ_zero : ∑ p ∈ Ω, g p = 0 := by
        dsimp [Ω, g]
        rw [Finset.sum_product]
        have h_prod : (∑ i ∈ Finset.range (D + 1), ∑ r ∈ Finset.range (N + 1),
              P.coeff i * PowerSeries.coeff r F * t₀ ^ (i + r)) =
            (∑ i ∈ Finset.range (D + 1), P.coeff i * t₀ ^ i) *
              (∑ r ∈ Finset.range (N + 1), PowerSeries.coeff r F * t₀ ^ r) := by
          rw [Finset.sum_mul_sum]
          refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun r _ => ?_))
          rw [pow_add]
          ring
        rw [h_prod, ← Polynomial.eval_eq_sum_range, hEval, zero_mul]
      let Ω_low : Finset (ℕ × ℕ) := Ω.filter (fun p => p.1 + p.2 ≤ N)
      let Ω_high : Finset (ℕ × ℕ) := Ω.filter (fun p => ¬ (p.1 + p.2 ≤ N))
      have hΩ_split : (∑ p ∈ Ω_low, g p) + (∑ p ∈ Ω_high, g p) = 0 := by
        rw [Finset.sum_filter_add_sum_filter_not, hΩ_zero]
      have hΩ_low_one : ∑ p ∈ Ω_low, g p = 1 := by
        have h_maps : ∀ p ∈ Ω_low, p.1 + p.2 ∈ Finset.range (N + 1) := by
          intro p hp
          rw [Finset.mem_filter] at hp
          exact Finset.mem_range.mpr (by omega)
        rw [← Finset.sum_fiberwise_of_maps_to h_maps g]
        have h_fib : ∀ m ∈ Finset.range (N + 1),
            (∑ p ∈ Ω_low.filter (fun p => p.1 + p.2 = m), g p) =
              if m = 0 then (1 : ℂ) else 0 := by
          intro m hm
          rw [Finset.mem_range] at hm
          have h_sub : Ω_low.filter (fun p => p.1 + p.2 = m) ⊆
              Finset.HasAntidiagonal.antidiagonal m := by
            intro p hp
            rw [Finset.mem_filter] at hp
            exact Finset.HasAntidiagonal.mem_antidiagonal.mpr hp.2
          have h_sum_anti : (∑ p ∈ Ω_low.filter (fun p => p.1 + p.2 = m), g p) =
              ∑ p ∈ Finset.HasAntidiagonal.antidiagonal m, g p := by
            apply Finset.sum_subset h_sub
            intro p hp_anti hp_not
            rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp_anti
            have hp1_gt : D < p.1 := by
              by_contra hp1_le
              apply hp_not
              rw [Finset.mem_filter, Finset.mem_filter, Finset.mem_product,
                Finset.mem_range, Finset.mem_range]
              exact ⟨⟨⟨by omega, by omega⟩, by omega⟩, hp_anti⟩
            dsimp [g]
            rw [Polynomial.coeff_eq_zero_of_natDegree_lt hp1_gt, zero_mul, zero_mul]
          rw [h_sum_anti]
          have h_anti_eq : (∑ p ∈ Finset.HasAntidiagonal.antidiagonal m, g p) =
              (∑ p ∈ Finset.HasAntidiagonal.antidiagonal m,
                P.coeff p.1 * PowerSeries.coeff p.2 F) * t₀ ^ m := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl (fun p hp => ?_)
            rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
            dsimp [g]
            rw [hp]
          rw [h_anti_eq]
          have h_coeff_inv : (∑ p ∈ Finset.HasAntidiagonal.antidiagonal m,
                P.coeff p.1 * PowerSeries.coeff p.2 F) =
              PowerSeries.coeff m (Polynomial.toPowerSeries P * F) := by
            rw [PowerSeries.coeff_mul]
            refine Finset.sum_congr rfl (fun p _ => ?_)
            rw [Polynomial.coeff_coe]
          rw [h_coeff_inv, hInv, PowerSeries.coeff_one]
          split_ifs with hm0
          · subst hm0
            simp
          · simp
        rw [Finset.sum_congr rfl h_fib, Finset.sum_ite_eq',
          if_pos (Finset.mem_range.mpr (Nat.succ_pos N))]
      rw [hΩ_low_one] at hΩ_split
      have hΩ_high_eq : ∑ p ∈ Ω_high, g p = -1 := eq_neg_of_add_eq_zero_right hΩ_split
      have h1_le_norm : (1 : ℝ) ≤ ∑ p ∈ Ω_high, ‖g p‖ := by
        calc (1 : ℝ) = ‖(-1 : ℂ)‖ := by simp
          _ = ‖∑ p ∈ Ω_high, g p‖ := by rw [hΩ_high_eq]
          _ ≤ ∑ p ∈ Ω_high, ‖g p‖ := norm_sum_le _ _
      have h_high_sub : Ω_high ⊆ Finset.range (D + 1) ×ˢ Finset.Ico (N + 1 - D) (N + 1) := by
        intro p hp
        rw [Finset.mem_filter, Finset.mem_product, Finset.mem_range, Finset.mem_range] at hp
        rw [Finset.mem_product, Finset.mem_range, Finset.mem_Ico]
        exact ⟨hp.1.1, ⟨by omega, hp.1.2⟩⟩
      calc (1 : ℝ) ≤ ∑ p ∈ Ω_high, ‖g p‖ := h1_le_norm
        _ ≤ ∑ p ∈ Finset.range (D + 1) ×ˢ Finset.Ico (N + 1 - D) (N + 1), ‖g p‖ :=
            Finset.sum_le_sum_of_subset_of_nonneg h_high_sub (fun _ _ _ => norm_nonneg _)
        _ = M_P * ∑ r ∈ Finset.Ico (N + 1 - D) (N + 1), ‖PowerSeries.coeff r F‖ * ‖t₀‖ ^ r := by
            rw [Finset.sum_product, Finset.sum_mul_sum]
            refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun r _ => ?_))
            dsimp [g]
            rw [norm_mul, norm_mul, norm_pow, pow_add]
            ring
        _ ≤ M_P * ∑ r ∈ Finset.Ico (N + 1 - D) (N + 1), a r := by
            refine mul_le_mul_of_nonneg_left (Finset.sum_le_sum (fun r _ => ?_)) hMP_nn
            calc ‖PowerSeries.coeff r F‖ * ‖t₀‖ ^ r
                ≤ (C * ((r : ℝ) + 1) ^ B * ρ ^ r) * ‖t₀‖ ^ r :=
                  mul_le_mul_of_nonneg_right (hBound r) (by positivity)
              _ = a r := by
                  dsimp [a, θ]
                  rw [mul_pow]
                  ring
    have h_tendsto : Filter.Tendsto a Filter.atTop (nhds 0) := by
      have h_abs : |θ| < 1 := by
        rw [abs_of_pos hθ_pos]
        exact ht₀
      have h_base :=
        (tendsto_pow_const_mul_const_pow_of_abs_lt_one B h_abs).comp (Filter.tendsto_add_atTop_nat 1)
      have h_mul := h_base.const_mul (C * θ⁻¹)
      rw [mul_zero] at h_mul
      refine h_mul.congr (fun r => ?_)
      dsimp [a, Function.comp]
      push_cast
      rw [pow_succ']
      have hθ_ne : θ ≠ 0 := hθ_pos.ne'
      field_simp [hθ_ne]
    let ε : ℝ := ((D : ℝ) * (M_P + 1))⁻¹
    have hD_real_pos : (0 : ℝ) < (D : ℝ) := by exact_mod_cast hD_pos
    have hε_pos : 0 < ε := by
      dsimp [ε]
      positivity
    rcases Filter.eventually_atTop.mp (h_tendsto.eventually (gt_mem_nhds hε_pos)) with ⟨R₀, hR₀⟩
    let N : ℕ := R₀ + D
    have h1_le := h_trunc N (by omega)
    have h_sub_eq : N + 1 - D = R₀ + 1 := by omega
    have h_add_eq : N + 1 = R₀ + D + 1 := by omega
    rw [h_sub_eq, h_add_eq] at h1_le
    have h_sum_le : ∑ r ∈ Finset.Ico (R₀ + 1) (R₀ + D + 1), a r ≤ (D : ℝ) * ε := by
      calc ∑ r ∈ Finset.Ico (R₀ + 1) (R₀ + D + 1), a r
          ≤ ∑ _r ∈ Finset.Ico (R₀ + 1) (R₀ + D + 1), ε := by
            apply Finset.sum_le_sum
            intro r hr
            rw [Finset.mem_Ico] at hr
            exact le_of_lt (hR₀ r (by omega))
        _ = (D : ℝ) * ε := by
            rw [Finset.sum_const, Nat.card_Ico]
            have hcard : R₀ + D + 1 - (R₀ + 1) = D := by omega
            rw [hcard, nsmul_eq_mul]
    have h1_le' : 1 ≤ M_P * ((D : ℝ) * ε) :=
      le_trans h1_le (mul_le_mul_of_nonneg_left h_sum_le hMP_nn)
    have h_strict : M_P * ((D : ℝ) * ε) < (M_P + 1) * ((D : ℝ) * ε) := by
      have hDe_pos : 0 < (D : ℝ) * ε := mul_pos hD_real_pos hε_pos
      nlinarith
    have h_eq_one : (M_P + 1) * ((D : ℝ) * ε) = 1 := by
      dsimp [ε]
      have hD_ne : (D : ℝ) ≠ 0 := hD_real_pos.ne'
      have hMP1_ne : M_P + 1 ≠ 0 := by positivity
      field_simp [hD_ne, hMP1_ne]
    linarith

  
  rcases hPkg with ⟨hγ_ne, M, c, A, hc0, hc_le, hSymp,
    ⟨V₁, hAdd₁, hMod₁, hFin₁, Φ₁, hγ_mem, hγ_dual_mem, hTr₁⟩, hEvenPkg⟩
  let _ : AddCommGroup V₁ := hAdd₁
  let _ : Module (Padic ℓ) V₁ := hMod₁
  let _ : Module.Finite (Padic ℓ) V₁ := hFin₁

  have h_linMap_bridge : ∀ (V : Type u) [AddCommGroup V] [Module (Padic ℓ) V]
      [Module.Finite (Padic ℓ) V] (Φ : V →ₗ[Padic ℓ] V),
      (Φ.charpoly).reverse.coeff 0 = 1 ∧
      PowerSeries.X * PowerSeries.derivative (Polynomial.toPowerSeries (Φ.charpoly).reverse) =
        - Polynomial.toPowerSeries (Φ.charpoly).reverse *
          PowerSeries.mk (fun r => if r = 0 then 0 else LinearMap.trace (Padic ℓ) V (Φ ^ r)) := by
    intro V _ _ _ Φ
    let b := Module.finBasis (Padic ℓ) V
    let B : Matrix (Fin (Module.finrank (Padic ℓ) V)) (Fin (Module.finrank (Padic ℓ) V)) (Padic ℓ) :=
      LinearMap.toMatrix b b Φ
    have hchar : B.charpoly = Φ.charpoly := LinearMap.charpoly_toMatrix Φ b
    have htr : ∀ r : ℕ, Matrix.trace (B ^ r) = LinearMap.trace (Padic ℓ) V (Φ ^ r) := by
      intro r
      rw [LinearMap.trace_eq_matrix_trace (Padic ℓ) b (Φ ^ r)]
      have hpow : LinearMap.toMatrix b b (Φ ^ r) = B ^ r :=
        (LinearMap.toMatrixAlgEquiv b).map_pow Φ r
      rw [hpow]
    rcases h_matrix_trace_and_reverse (Padic ℓ) (Module.finrank (Padic ℓ) V) B with ⟨-, hB0, hBderiv⟩
    rw [hchar] at hB0 hBderiv
    refine ⟨hB0, ?_⟩
    rw [hBderiv]
    congr 1
    ext r
    simp only [PowerSeries.coeff_mk]
    by_cases hr : r = 0 <;> simp [hr, htr]

  have h_local_upper : ∀ (d₀ : ℕ), 1 ≤ d₀ → ∀ (j₀ : Fin (c d₀)) (z : ℂ),
      z ∈ ((A d₀ j₀).charpoly).aroots ℂ → ‖z‖ ^ 2 ≤ (q : ℝ) ^ (n * d₀) := by
    intro d₀ hd₀ j₀ z hz
    have hz_ne : z ≠ 0 := (hSymp d₀ j₀ z hz).1
    have hz_pos : 0 < ‖z‖ := norm_pos_iff.mpr hz_ne
    have h_pow_bound : ∀ k : ℕ, 1 ≤ k →
        (‖z‖ ^ 2) ^ k ≤ (q : ℝ) ^ d₀ * ((q : ℝ) ^ (n * d₀)) ^ k := by
      intro k hk
      rcases hEvenPkg k hk with ⟨N_k, V₂ₖ, hAdd₂ₖ, hMod₂ₖ, hFin₂ₖ, Φ₂ₖ, hTr₂ₖ⟩
      let _ : AddCommGroup V₂ₖ := hAdd₂ₖ
      let _ : Module (Padic ℓ) V₂ₖ := hMod₂ₖ
      let _ : Module.Finite (Padic ℓ) V₂ₖ := hFin₂ₖ
      let c₂ₖ : ℕ → ℚ := fun r =>
        if r = 0 then 0
        else ∑ d ∈ Nat.divisors r, ∑ j : Fin (c d), (d : ℚ) * (Matrix.trace (A d j ^ (r / d))) ^ (2 * k)
      let c₀ : ℕ → ℚ := fun r =>
        if r ≠ 0 ∧ d₀ ∣ r then (d₀ : ℚ) * (Matrix.trace (A d₀ j₀ ^ (r / d₀))) ^ (2 * k) else 0
      have hc₂ₖ_0 : c₂ₖ 0 = 0 := rfl
      have hc₀_0 : c₀ 0 = 0 := by simp [c₀]
      have hc_dom : ∀ r : ℕ, 0 ≤ c₀ r ∧ c₀ r ≤ c₂ₖ r := by
        intro r
        have h_term_nn : ∀ (d : ℕ) (j : Fin (c d)),
            (0 : ℚ) ≤ (d : ℚ) * (Matrix.trace (A d j ^ (r / d))) ^ (2 * k) := by
          intro d j
          exact mul_nonneg (Nat.cast_nonneg d) (by rw [mul_comm, pow_mul]; exact sq_nonneg _)
        by_cases hr : r ≠ 0 ∧ d₀ ∣ r
        · have hc0_eq : c₀ r = (d₀ : ℚ) * (Matrix.trace (A d₀ j₀ ^ (r / d₀))) ^ (2 * k) := if_pos hr
          have hc2k_eq : c₂ₖ r = ∑ d ∈ Nat.divisors r, ∑ j : Fin (c d),
              (d : ℚ) * (Matrix.trace (A d j ^ (r / d))) ^ (2 * k) := if_neg hr.1
          rw [hc0_eq, hc2k_eq]
          refine ⟨h_term_nn d₀ j₀, ?_⟩
          have hj_le : (d₀ : ℚ) * (Matrix.trace (A d₀ j₀ ^ (r / d₀))) ^ (2 * k) ≤
              ∑ j : Fin (c d₀), (d₀ : ℚ) * (Matrix.trace (A d₀ j ^ (r / d₀))) ^ (2 * k) :=
            Finset.single_le_sum (fun j _ => h_term_nn d₀ j) (Finset.mem_univ j₀)
          have hd_mem : d₀ ∈ Nat.divisors r := Nat.mem_divisors.mpr ⟨hr.2, hr.1⟩
          exact le_trans hj_le
            (Finset.single_le_sum (fun d _ => Finset.sum_nonneg (fun j _ => h_term_nn d j)) hd_mem)
        · have hc0_eq : c₀ r = 0 := if_neg hr
          rw [hc0_eq]
          refine ⟨le_refl 0, ?_⟩
          dsimp [c₂ₖ]
          split_ifs
          · exact le_refl 0
          · exact Finset.sum_nonneg (fun d _ => Finset.sum_nonneg (fun j _ => h_term_nn d j))
      rcases h_ode_engine c₂ₖ hc₂ₖ_0 with ⟨Z, -, -, hDom, hPole, -⟩
      rcases hDom c₀ hc₀_0 hc_dom with ⟨Z₀, hZ₀_0, hZ₀_deriv, hZ₀_le⟩
      rcases h_linMap_bridge V₂ₖ Φ₂ₖ with ⟨hQK0, hQK_deriv⟩
      let α_k : ℚ := (q : ℚ) ^ (k * n + 1)
      have hα_k_ge : 1 ≤ α_k := by
        dsimp [α_k]
        have hq_rat : (1 : ℚ) ≤ (q : ℚ) := by exact_mod_cast (by omega : 1 ≤ q)
        exact one_le_pow₀ hq_rat
      have hQK_deriv' : PowerSeries.X *
            PowerSeries.derivative (Polynomial.toPowerSeries (Φ₂ₖ.charpoly).reverse) =
          Polynomial.toPowerSeries (Φ₂ₖ.charpoly).reverse *
            PowerSeries.mk (fun r =>
              if r = 0 then 0 else algebraMap ℚ (Padic ℓ) (c₂ₖ r - (N_k : ℚ) * α_k ^ r)) := by
        rw [hQK_deriv]
        have h_neg_mk : - Polynomial.toPowerSeries (Φ₂ₖ.charpoly).reverse *
              PowerSeries.mk (fun r => if r = 0 then 0 else LinearMap.trace (Padic ℓ) V₂ₖ (Φ₂ₖ ^ r)) =
            Polynomial.toPowerSeries (Φ₂ₖ.charpoly).reverse *
              PowerSeries.mk (fun r => if r = 0 then 0 else - LinearMap.trace (Padic ℓ) V₂ₖ (Φ₂ₖ ^ r)) := by
          have h1 : - PowerSeries.mk (fun r => if r = 0 then 0 else LinearMap.trace (Padic ℓ) V₂ₖ (Φ₂ₖ ^ r)) =
              PowerSeries.mk (fun r => if r = 0 then 0 else - LinearMap.trace (Padic ℓ) V₂ₖ (Φ₂ₖ ^ r)) := by
            ext r
            simp only [map_neg, PowerSeries.coeff_mk]
            split_ifs <;> simp
          rw [← h1]
          ring
        rw [h_neg_mk]
        congr 1
        ext r
        simp only [PowerSeries.coeff_mk]
        split_ifs with hr
        · rfl
        · have hr_pos : 1 ≤ r := Nat.pos_of_ne_zero hr
          have htr := hTr₂ₖ r hr_pos
          have hc2k_r : c₂ₖ r = ∑ d ∈ Nat.divisors r, ∑ j : Fin (c d),
              (d : ℚ) * (Matrix.trace (A d j ^ (r / d))) ^ (2 * k) := if_neg hr
          rw [← hc2k_r] at htr
          have h_cast : algebraMap ℚ (Padic ℓ) (c₂ₖ r - (N_k : ℚ) * α_k ^ r) =
              (c₂ₖ r : Padic ℓ) - (N_k : Padic ℓ) * ((q : Padic ℓ) ^ (k * n + 1)) ^ r := by
            dsimp [α_k]
            rw [map_sub, eq_ratCast, map_mul, map_natCast, map_pow, map_pow, map_natCast]
          rw [h_cast, htr]
          ring
      rcases hPole (Padic ℓ) N_k α_k (Φ₂ₖ.charpoly).reverse hα_k_ge hQK0 hQK_deriv' with
        ⟨_, C_k, hCk_nn, -, -, -, hZ_bound⟩
      let ι_ℂ : ℚ →+* ℂ := algebraMap ℚ ℂ
      let F_k : PowerSeries ℂ := PowerSeries.map ι_ℂ Z₀
      have hFk0 : PowerSeries.coeff 0 F_k = 1 := by
        change PowerSeries.coeff 0 (PowerSeries.map ι_ℂ Z₀) = 1
        rw [PowerSeries.coeff_map, hZ₀_0, map_one]
      let R₀ : Multiset ℂ := ((A d₀ j₀).charpoly).aroots ℂ
      have hFk_deriv : PowerSeries.X * PowerSeries.derivative F_k =
          F_k * PowerSeries.mk (fun r =>
            if r ≠ 0 ∧ d₀ ∣ r then (d₀ : ℂ) * ((R₀.map (· ^ (r / d₀))).sum) ^ (2 * k) else 0) := by
        have hDeriv_map : PowerSeries.derivative (PowerSeries.map ι_ℂ Z₀) =
            PowerSeries.map ι_ℂ (PowerSeries.derivative Z₀) := by
          ext r
          simp [PowerSeries.coeff_derivative]
        dsimp [F_k]
        rw [hDeriv_map, ← PowerSeries.map_X ι_ℂ, ← map_mul, hZ₀_deriv, map_mul]
        congr 1
        ext r
        simp only [PowerSeries.coeff_map, PowerSeries.coeff_mk, c₀]
        split_ifs with hr
        · rw [map_mul, map_natCast, map_pow]
          have htr_C := (h_matrix_trace_and_reverse ℚ M (A d₀ j₀)).1 ℂ (r / d₀)
          rw [← htr_C]
        · exact map_zero ι_ℂ
      rcases h_multiset_recip d₀ (2 * k) hd₀ R₀ F_k hFk0 hFk_deriv with ⟨Q_k, hQk_inv, hQk_root⟩
      rcases IsAlgClosed.exists_pow_nat_eq ((z ^ (2 * k))⁻¹) (by omega : 0 < d₀) with ⟨t₀, ht₀_pow⟩
      have hzt₀ : z ^ (2 * k) * t₀ ^ d₀ = 1 := by
        rw [ht₀_pow, mul_inv_cancel₀ (pow_ne_zero (2 * k) hz_ne)]
      have hQk_eval0 : Polynomial.eval t₀ Q_k = 0 := hQk_root z hz t₀ hzt₀
      let ρ_k : ℝ := (q : ℝ) ^ (k * n + 1)
      have hρ_k_pos : 0 < ρ_k := by
        dsimp [ρ_k]
        have hq_pos : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
        positivity
      have hFk_bound : ∀ r : ℕ, ‖PowerSeries.coeff r F_k‖ ≤ C_k * ((r : ℝ) + 1) ^ N_k * ρ_k ^ r := by
        intro r
        change ‖PowerSeries.coeff r (PowerSeries.map ι_ℂ Z₀)‖ ≤ _
        rw [PowerSeries.coeff_map, eq_ratCast, Complex.norm_ratCast]
        have h0_le : (0 : ℝ) ≤ ((PowerSeries.coeff r Z₀ : ℚ) : ℝ) := by exact_mod_cast (hZ₀_le r).1
        have h_le_Z : ((PowerSeries.coeff r Z₀ : ℚ) : ℝ) ≤ ((PowerSeries.coeff r Z : ℚ) : ℝ) := by
          exact_mod_cast (hZ₀_le r).2
        have habs_le : |((PowerSeries.coeff r Z₀ : ℚ) : ℝ)| ≤ |((PowerSeries.coeff r Z : ℚ) : ℝ)| := by
          rw [abs_of_nonneg h0_le]
          exact le_trans h_le_Z (le_abs_self _)
        have hα_cast : (α_k : ℝ) = ρ_k := by
          dsimp [α_k, ρ_k]
          push_cast
          rfl
        rw [← hα_cast]
        exact le_trans habs_le (hZ_bound r)
      have h1_le_disk : 1 ≤ ρ_k * ‖t₀‖ := by
        by_contra hlt
        exact h_zero_free_disk Q_k F_k hQk_inv C_k ρ_k N_k hCk_nn hρ_k_pos hFk_bound t₀
          (lt_of_not_ge hlt) hQk_eval0
      have h1_pow_d₀ : (1 : ℝ) ≤ (ρ_k * ‖t₀‖) ^ d₀ := by
        calc (1 : ℝ) = 1 ^ d₀ := (one_pow d₀).symm
          _ ≤ (ρ_k * ‖t₀‖) ^ d₀ := pow_le_pow_left₀ zero_le_one h1_le_disk d₀
      have h_t₀_norm : ‖t₀‖ ^ d₀ = ((‖z‖ ^ 2) ^ k)⁻¹ := by
        rw [← norm_pow, ht₀_pow, norm_inv, norm_pow, pow_mul]
      have h_ρ_pow : ρ_k ^ d₀ = (q : ℝ) ^ d₀ * ((q : ℝ) ^ (n * d₀)) ^ k := by
        dsimp [ρ_k]
        rw [← pow_mul, ← pow_mul, ← pow_add]
        congr 1
        ring
      rw [mul_pow, h_t₀_norm, h_ρ_pow] at h1_pow_d₀
      have hz2k_pos : 0 < (‖z‖ ^ 2) ^ k := by positivity
      have hmul := mul_le_mul_of_nonneg_right h1_pow_d₀ hz2k_pos.le
      rwa [one_mul, inv_mul_cancel_right₀ hz2k_pos.ne'] at hmul
    by_contra hgt
    have hgt' : (q : ℝ) ^ (n * d₀) < ‖z‖ ^ 2 := lt_of_not_ge hgt
    have hqnd_pos : (0 : ℝ) < (q : ℝ) ^ (n * d₀) := by
      have hq_pos : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
      positivity
    have h1_lt : 1 < ‖z‖ ^ 2 / (q : ℝ) ^ (n * d₀) := (one_lt_div hqnd_pos).mpr hgt'
    rcases pow_unbounded_of_one_lt ((q : ℝ) ^ d₀) h1_lt with ⟨k, hk_lt⟩
    have hk_pos : 1 ≤ k := by
      rcases Nat.eq_zero_or_pos k with rfl | hpos
      · rw [pow_zero] at hk_lt
        have hq1 : (1 : ℝ) ≤ (q : ℝ) := by exact_mod_cast (by omega : 1 ≤ q)
        have hqd1 : (1 : ℝ) ≤ (q : ℝ) ^ d₀ := one_le_pow₀ hq1
        linarith
      · exact hpos
    rw [div_pow, lt_div_iff₀ (pow_pos hqnd_pos k)] at hk_lt
    linarith [h_pow_bound k hk_pos]

  have h_local_eq : ∀ (d₀ : ℕ), 1 ≤ d₀ → ∀ (j₀ : Fin (c d₀)) (z : ℂ),
      z ∈ ((A d₀ j₀).charpoly).aroots ℂ → ‖z‖ ^ 2 = (q : ℝ) ^ (n * d₀) := by
    intro d₀ hd₀ j₀ z hz
    have h_up := h_local_upper d₀ hd₀ j₀ z hz
    rcases hSymp d₀ j₀ z hz with ⟨hz_ne, hz_dual⟩
    have h_dual_up := h_local_upper d₀ hd₀ j₀ (((q : ℂ) ^ (n * d₀)) / z) hz_dual
    rw [norm_div, norm_pow, Complex.norm_natCast, div_pow] at h_dual_up
    have hz2_pos : 0 < ‖z‖ ^ 2 := by
      have : 0 < ‖z‖ := norm_pos_iff.mpr hz_ne
      positivity
    have hqnd_pos : (0 : ℝ) < (q : ℝ) ^ (n * d₀) := by
      have : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
      positivity
    rw [div_le_iff₀ hz2_pos] at h_dual_up
    have h_low : (q : ℝ) ^ (n * d₀) ≤ ‖z‖ ^ 2 := by nlinarith
    exact le_antisymm h_up h_low

  
  let c₁ : ℕ → ℚ := fun r =>
    if r = 0 then 0
    else ∑ d ∈ Nat.divisors r, ∑ j : Fin (c d), (d : ℚ) * Matrix.trace (A d j ^ (r / d))
  have hc₁_0 : c₁ 0 = 0 := rfl
  rcases h_ode_engine c₁ hc₁_0 with ⟨Z₁, -, -, -, hPole₁, hRecip₁⟩
  rcases h_linMap_bridge V₁ Φ₁ with ⟨hQ₁_0, hQ₁_deriv⟩
  have hQ₁_deriv' : PowerSeries.X *
        PowerSeries.derivative (Polynomial.toPowerSeries (Φ₁.charpoly).reverse) =
      Polynomial.toPowerSeries (Φ₁.charpoly).reverse *
        PowerSeries.mk (fun r =>
          if r = 0 then 0 else algebraMap ℚ (Padic ℓ) (c₁ r - ((0 : ℕ) : ℚ) * (1 : ℚ) ^ r)) := by
    rw [hQ₁_deriv]
    have h_neg_mk : - Polynomial.toPowerSeries (Φ₁.charpoly).reverse *
          PowerSeries.mk (fun r => if r = 0 then 0 else LinearMap.trace (Padic ℓ) V₁ (Φ₁ ^ r)) =
        Polynomial.toPowerSeries (Φ₁.charpoly).reverse *
          PowerSeries.mk (fun r => if r = 0 then 0 else - LinearMap.trace (Padic ℓ) V₁ (Φ₁ ^ r)) := by
      have h1 : - PowerSeries.mk (fun r => if r = 0 then 0 else LinearMap.trace (Padic ℓ) V₁ (Φ₁ ^ r)) =
          PowerSeries.mk (fun r => if r = 0 then 0 else - LinearMap.trace (Padic ℓ) V₁ (Φ₁ ^ r)) := by
        ext r
        simp only [map_neg, PowerSeries.coeff_mk]
        split_ifs <;> simp
      rw [← h1]
      ring
    rw [h_neg_mk]
    congr 1
    ext r
    simp only [PowerSeries.coeff_mk, Nat.cast_zero, zero_mul, sub_zero]
    split_ifs with hr
    · rfl
    · have htr := hTr₁ r (Nat.pos_of_ne_zero hr)
      have hc₁_r : c₁ r = ∑ d ∈ Nat.divisors r, ∑ j : Fin (c d),
          (d : ℚ) * Matrix.trace (A d j ^ (r / d)) := if_neg hr
      rw [← hc₁_r] at htr
      rw [eq_ratCast, htr]
  rcases hPole₁ (Padic ℓ) 0 1 (Φ₁.charpoly).reverse (le_refl 1) hQ₁_0 hQ₁_deriv' with
    ⟨B₁, _, -, hB₁_0, hB₁_map, hZ₁_eq_B₁, -⟩
  rw [pow_zero, one_mul] at hZ₁_eq_B₁

  let ξ₀ : ℝ := Real.sqrt (q : ℝ)
  let ξ : ℝ := ξ₀ ^ (n + 2)
  have hq_real_ge2 : (2 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq
  have hq_real_nn : (0 : ℝ) ≤ (q : ℝ) := by linarith
  have hξ₀_sq : ξ₀ ^ 2 = (q : ℝ) := Real.sq_sqrt hq_real_nn
  have hξ₀_nn : 0 ≤ ξ₀ := Real.sqrt_nonneg (q : ℝ)
  have hξ₀_ge1 : 1 ≤ ξ₀ := by nlinarith
  have hξ_ge1 : 1 ≤ ξ := one_le_pow₀ hξ₀_ge1

  have hc₁_bound : ∀ r : ℕ, 1 ≤ r → |(c₁ r : ℝ)| ≤ (M : ℝ) * (r : ℝ) ^ 2 * ξ ^ r := by
    intro r hr
    have hr_ne : r ≠ 0 := by omega
    have hc₁_r : c₁ r = ∑ d ∈ Nat.divisors r, ∑ j : Fin (c d),
        (d : ℚ) * Matrix.trace (A d j ^ (r / d)) := if_neg hr_ne
    rw [hc₁_r]
    push_cast
    have h_multiset_const_norm : ∀ (S : Multiset ℂ) (K_val : ℝ),
        0 ≤ K_val → (∀ w ∈ S, ‖w‖ = K_val) → ‖S.sum‖ ≤ (S.card : ℝ) * K_val := by
      intro S K_val _ hK
      refine le_trans (norm_multiset_sum_le S) ?_
      have hmap : S.map (fun x => ‖x‖) = Multiset.replicate S.card K_val := by
        rw [← Multiset.map_const]
        exact Multiset.map_congr rfl (fun x hx => hK x hx)
      rw [hmap, Multiset.sum_replicate, nsmul_eq_mul]
    have h_div_term : ∀ d ∈ Nat.divisors r,
        |∑ j : Fin (c d), (d : ℝ) * ((Matrix.trace (A d j ^ (r / d)) : ℚ) : ℝ)| ≤
          (r : ℝ) * ((M : ℝ) * ξ ^ r) := by
      intro d hd_mem
      have hd_dvd : d ∣ r := Nat.dvd_of_mem_divisors hd_mem
      have hd_le : d ≤ r := Nat.divisor_le hd_mem
      have hd_pos : 1 ≤ d := Nat.pos_of_dvd_of_pos hd_dvd hr
      have h_single_j : ∀ j : Fin (c d),
          |(d : ℝ) * ((Matrix.trace (A d j ^ (r / d)) : ℚ) : ℝ)| ≤
            (r : ℝ) * ((M : ℝ) * ξ₀ ^ (n * r)) := by
        intro j
        rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg d)]
        have hd_real_le : (d : ℝ) ≤ (r : ℝ) := by exact_mod_cast hd_le
        have htr_C := (h_matrix_trace_and_reverse ℚ M (A d j)).1 ℂ (r / d)
        let R_dj : Multiset ℂ := ((A d j).charpoly).aroots ℂ
        have htr_norm : |((Matrix.trace (A d j ^ (r / d)) : ℚ) : ℝ)| =
            ‖(R_dj.map (· ^ (r / d))).sum‖ := by
          rw [← Complex.norm_ratCast, ← eq_ratCast (algebraMap ℚ ℂ), htr_C]
        have h_card_le : R_dj.card ≤ M := by
          dsimp [R_dj, Polynomial.aroots]
          calc (((A d j).charpoly).map (algebraMap ℚ ℂ)).roots.card
              ≤ (((A d j).charpoly).map (algebraMap ℚ ℂ)).natDegree := Polynomial.card_roots' _
            _ = (A d j).charpoly.natDegree :=
                Polynomial.natDegree_map_eq_of_injective (algebraMap ℚ ℂ).injective _
            _ = M := by simp [Matrix.charpoly_natDegree_eq_dim]
        have h_elem_norm : ∀ w ∈ R_dj.map (· ^ (r / d)), ‖w‖ = ξ₀ ^ (n * r) := by
          intro w hw
          rcases Multiset.mem_map.mp hw with ⟨z, hz, rfl⟩
          have hz_sq := h_local_eq d hd_pos j z hz
          have hz_eq : ‖z‖ = ξ₀ ^ (n * d) := by
            have hsq_eq : ‖z‖ ^ 2 = (ξ₀ ^ (n * d)) ^ 2 := by
              rw [hz_sq, ← hξ₀_sq, ← pow_mul, ← pow_mul, mul_comm 2 (n * d)]
            nlinarith [norm_nonneg z, pow_nonneg hξ₀_nn (n * d)]
          rw [norm_pow, hz_eq, ← pow_mul, mul_assoc, Nat.mul_div_cancel' hd_dvd]
        have htr_le : |((Matrix.trace (A d j ^ (r / d)) : ℚ) : ℝ)| ≤ (M : ℝ) * ξ₀ ^ (n * r) := by
          rw [htr_norm]
          calc ‖(R_dj.map (· ^ (r / d))).sum‖
              ≤ ((R_dj.map (· ^ (r / d))).card : ℝ) * ξ₀ ^ (n * r) :=
                h_multiset_const_norm _ _ (by positivity) h_elem_norm
            _ = (R_dj.card : ℝ) * ξ₀ ^ (n * r) := by rw [Multiset.card_map]
            _ ≤ (M : ℝ) * ξ₀ ^ (n * r) := by gcongr
        exact mul_le_mul hd_real_le htr_le (abs_nonneg _) (Nat.cast_nonneg r)
      have hcd_le : (c d : ℝ) ≤ ξ₀ ^ (2 * r) := by
        have h1 : c d ≤ q ^ d := hc_le d hd_pos
        calc (c d : ℝ) ≤ ((q ^ d : ℕ) : ℝ) := by exact_mod_cast h1
          _ = (q : ℝ) ^ d := by push_cast; rfl
          _ = (ξ₀ ^ 2) ^ d := by rw [hξ₀_sq]
          _ = ξ₀ ^ (2 * d) := (pow_mul ξ₀ 2 d).symm
          _ ≤ ξ₀ ^ (2 * r) := pow_le_pow_right₀ hξ₀_ge1 (by omega)
      calc |∑ j : Fin (c d), (d : ℝ) * ((Matrix.trace (A d j ^ (r / d)) : ℚ) : ℝ)|
          ≤ ∑ j : Fin (c d), |(d : ℝ) * ((Matrix.trace (A d j ^ (r / d)) : ℚ) : ℝ)| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ _j : Fin (c d), (r : ℝ) * ((M : ℝ) * ξ₀ ^ (n * r)) :=
            Finset.sum_le_sum (fun j _ => h_single_j j)
        _ = (c d : ℝ) * ((r : ℝ) * ((M : ℝ) * ξ₀ ^ (n * r))) := by
            rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        _ ≤ ξ₀ ^ (2 * r) * ((r : ℝ) * ((M : ℝ) * ξ₀ ^ (n * r))) :=
            mul_le_mul_of_nonneg_right hcd_le (by positivity)
        _ = (r : ℝ) * ((M : ℝ) * ξ ^ r) := by
            have hξ_pow : ξ ^ r = ξ₀ ^ (n * r) * ξ₀ ^ (2 * r) := by
              dsimp [ξ]
              rw [← pow_mul, ← pow_add]
              congr 1
              ring
            rw [hξ_pow]
            ring
    calc |∑ d ∈ Nat.divisors r, ∑ j : Fin (c d), (d : ℝ) * ((Matrix.trace (A d j ^ (r / d)) : ℚ) : ℝ)|
        ≤ ∑ d ∈ Nat.divisors r, |∑ j : Fin (c d), (d : ℝ) * ((Matrix.trace (A d j ^ (r / d)) : ℚ) : ℝ)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _d ∈ Nat.divisors r, (r : ℝ) * ((M : ℝ) * ξ ^ r) :=
          Finset.sum_le_sum h_div_term
      _ = ((Nat.divisors r).card : ℝ) * ((r : ℝ) * ((M : ℝ) * ξ ^ r)) := by
          rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ (r : ℝ) * ((r : ℝ) * ((M : ℝ) * ξ ^ r)) := by
          refine mul_le_mul_of_nonneg_right ?_ (by positivity)
          exact_mod_cast Nat.card_divisors_le_self r
      _ = (M : ℝ) * (r : ℝ) ^ 2 * ξ ^ r := by ring

  have hB₁_zero_free : ∀ t : ℂ, (q : ℝ) ^ (n + 2) * ‖t‖ ^ 2 < 1 → Polynomial.aeval t B₁ ≠ 0 := by
    intro t ht
    by_cases ht0 : t = 0
    · subst ht0
      rw [Polynomial.aeval_def, Polynomial.eval₂_at_zero, hB₁_0, map_one]
      exact one_ne_zero
    · have ht_pos : 0 < ‖t‖ := norm_pos_iff.mpr ht0
      have ht_ne : ‖t‖ ≠ 0 := ht_pos.ne'
      have hξt_sq : (ξ * ‖t‖) ^ 2 < 1 := by
        have hξ_sq : ξ ^ 2 = (q : ℝ) ^ (n + 2) := by
          dsimp [ξ]
          rw [← pow_mul, mul_comm (n + 2) 2, pow_mul, hξ₀_sq]
        rwa [mul_pow, hξ_sq]
      have hξt_lt1 : ξ * ‖t‖ < 1 := by
        nlinarith [mul_nonneg (by positivity : 0 ≤ ξ) (norm_nonneg t)]
      have hξ_lt_inv : ξ < ‖t‖⁻¹ := by
        have h1 : ξ * ‖t‖ < ‖t‖⁻¹ * ‖t‖ := by rwa [inv_mul_cancel₀ ht_ne]
        exact lt_of_mul_lt_mul_right h1 (norm_nonneg t)
      let ρ : ℝ := (ξ + ‖t‖⁻¹) / 2
      have hξ_lt_ρ : ξ < ρ := by dsimp [ρ]; linarith
      have hρ_pos : 0 < ρ := by linarith
      have hρt_lt1 : ρ * ‖t‖ < 1 := by
        have h_eq : ρ * ‖t‖ = (ξ * ‖t‖ + 1) / 2 := by
          dsimp [ρ]
          rw [← inv_mul_cancel₀ ht_ne]
          ring
        linarith
      rcases hRecip₁ ξ M hξ_ge1 hc₁_bound ρ hξ_lt_ρ with ⟨W₁, B_exp, hZW₁, hW₁_bound⟩
      rw [hZ₁_eq_B₁] at hZW₁
      let ι_ℂ : ℚ →+* ℂ := algebraMap ℚ ℂ
      let P_ℂ : Polynomial ℂ := B₁.map ι_ℂ
      let F_ℂ : PowerSeries ℂ := PowerSeries.map ι_ℂ W₁
      have hMap_ps : Polynomial.toPowerSeries P_ℂ = PowerSeries.map ι_ℂ (Polynomial.toPowerSeries B₁) := by
        ext r
        simp [P_ℂ, Polynomial.coeff_coe]
      have hPF_inv : Polynomial.toPowerSeries P_ℂ * F_ℂ = 1 := by
        dsimp [F_ℂ]
        rw [hMap_ps, ← map_mul, hZW₁, map_one]
      have hF_bound : ∀ r : ℕ, ‖PowerSeries.coeff r F_ℂ‖ ≤ 1 * ((r : ℝ) + 1) ^ B_exp * ρ ^ r := by
        intro r
        change ‖PowerSeries.coeff r (PowerSeries.map ι_ℂ W₁)‖ ≤ _
        rw [PowerSeries.coeff_map, eq_ratCast, Complex.norm_ratCast, one_mul]
        exact hW₁_bound r
      have hEval_ne := h_zero_free_disk P_ℂ F_ℂ hPF_inv 1 ρ B_exp zero_le_one hρ_pos hF_bound t hρt_lt1
      rwa [Polynomial.aeval_def, ← Polynomial.eval_map]

  
  let L := AlgebraicClosure (Padic ℓ)
  have hB₁_root_iff : ∀ y : L, y ≠ 0 →
      (Polynomial.aeval (y⁻¹) B₁ = 0 ↔ Polynomial.aeval y Φ₁.charpoly = 0) := by
    intro y hy
    let _ : Invertible y := invertibleOfNonzero hy
    have h_alg_eq : (algebraMap (Padic ℓ) L).comp (algebraMap ℚ (Padic ℓ)) = algebraMap ℚ L :=
      Subsingleton.elim _ _
    have h_lhs : Polynomial.aeval (y⁻¹) B₁ =
        Polynomial.eval₂ (algebraMap (Padic ℓ) L) (⅟ y) (Φ₁.charpoly).reverse := by
      rw [Polynomial.aeval_def, ← h_alg_eq, ← Polynomial.eval₂_map, hB₁_map, invOf_eq_inv]
    rw [h_lhs, Polynomial.eval₂_reverse_eq_zero_iff, Polynomial.aeval_def]

  
  let γ_dual : L := ((q : L) ^ (n + 1)) / γ
  have hq_L_ne : (q : L) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hγ_dual_ne : γ_dual ≠ 0 := div_ne_zero (pow_ne_zero (n + 1) hq_L_ne) hγ_ne
  have hγ_dual_eval : Polynomial.aeval γ_dual Φ₁.charpoly = 0 :=
    (Polynomial.mem_aroots.mp hγ_dual_mem).2
  have hB₁_dual_inv : Polynomial.aeval (γ_dual⁻¹) B₁ = 0 :=
    (hB₁_root_iff γ_dual hγ_dual_ne).mpr hγ_dual_eval
  let c_q : ℚ := ((q : ℚ) ^ (n + 1))⁻¹
  let Q_low : Polynomial ℚ := B₁.comp (Polynomial.C c_q * Polynomial.X)
  have hQ_low_ne : Q_low ≠ 0 := by
    intro h0
    have hev : Polynomial.eval 0 Q_low = 0 := by rw [h0, Polynomial.eval_zero]
    dsimp [Q_low] at hev
    rw [Polynomial.eval_comp, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X,
      mul_zero, ← Polynomial.coeff_zero_eq_eval_zero, hB₁_0] at hev
    exact one_ne_zero hev
  have hQ_low_eval : Polynomial.aeval γ Q_low = 0 := by
    dsimp [Q_low]
    rw [Polynomial.aeval_comp, map_mul, Polynomial.aeval_C, Polynomial.aeval_X]
    have h_eq : algebraMap ℚ L c_q * γ = γ_dual⁻¹ := by
      dsimp [c_q, γ_dual]
      rw [map_inv₀, map_pow, map_natCast, inv_div, div_eq_inv_mul]
    rw [h_eq]
    exact hB₁_dual_inv
  have hAlg : IsAlgebraic ℚ γ := ⟨Q_low, hQ_low_ne, hQ_low_eval⟩

  
  have hγ_eval : Polynomial.aeval γ Φ₁.charpoly = 0 :=
    (Polynomial.mem_aroots.mp hγ_mem).2
  have hB₁_γ_inv : Polynomial.aeval (γ⁻¹) B₁ = 0 :=
    (hB₁_root_iff γ hγ_ne).mpr hγ_eval
  have hB₁_rev_γ : Polynomial.aeval γ B₁.reverse = 0 := by
    let _ : Invertible (γ⁻¹) := invertibleOfNonzero (inv_ne_zero hγ_ne)
    have h_invOf : (⅟ (γ⁻¹) : L) = γ := by rw [invOf_eq_inv, inv_inv]
    rw [Polynomial.aeval_def, ← h_invOf]
    exact (Polynomial.eval₂_reverse_eq_zero_iff (algebraMap ℚ L) (γ⁻¹) B₁).mpr hB₁_γ_inv

  refine ⟨hAlg, fun β hβ => ?_⟩
  
  rcases minpoly.dvd ℚ γ hQ_low_eval with ⟨S_low, hS_low⟩
  have hβ_Q_low : Polynomial.aeval β Q_low = 0 := by
    rw [hS_low, map_mul, hβ, zero_mul]
  dsimp [Q_low] at hβ_Q_low
  rw [Polynomial.aeval_comp, map_mul, Polynomial.aeval_C, Polynomial.aeval_X] at hβ_Q_low
  have h1_le_low : 1 ≤ (q : ℝ) ^ (n + 2) * ‖algebraMap ℚ ℂ c_q * β‖ ^ 2 := by
    by_contra hlt
    exact hB₁_zero_free _ (lt_of_not_ge hlt) hβ_Q_low
  have h_cq_norm : ‖algebraMap ℚ ℂ c_q * β‖ ^ 2 = (((q : ℝ) ^ (n + 1))⁻¹) ^ 2 * ‖β‖ ^ 2 := by
    dsimp [c_q]
    rw [map_inv₀, map_pow, map_natCast, norm_mul, norm_inv, norm_pow, Complex.norm_natCast, mul_pow]
  rw [h_cq_norm] at h1_le_low
  have hq_pos : (0 : ℝ) < (q : ℝ) := by linarith
  have hqn1_ne : (q : ℝ) ^ (n + 1) ≠ 0 := by positivity
  have h_low_mul := mul_le_mul_of_nonneg_left h1_le_low (by positivity : (0 : ℝ) ≤ ((q : ℝ) ^ (n + 1)) ^ 2)
  have h_low_simp : ((q : ℝ) ^ (n + 1)) ^ 2 *
        ((q : ℝ) ^ (n + 2) * ((((q : ℝ) ^ (n + 1))⁻¹) ^ 2 * ‖β‖ ^ 2)) =
      (q : ℝ) ^ (n + 2) * ‖β‖ ^ 2 := by
    calc ((q : ℝ) ^ (n + 1)) ^ 2 *
          ((q : ℝ) ^ (n + 2) * ((((q : ℝ) ^ (n + 1))⁻¹) ^ 2 * ‖β‖ ^ 2))
        = (q : ℝ) ^ (n + 2) * ((((q : ℝ) ^ (n + 1) * ((q : ℝ) ^ (n + 1))⁻¹) ^ 2) * ‖β‖ ^ 2) := by ring
      _ = (q : ℝ) ^ (n + 2) * ‖β‖ ^ 2 := by rw [mul_inv_cancel₀ hqn1_ne, one_pow, one_mul]
  rw [mul_one, h_low_simp] at h_low_mul
  have h_lhs_pow : ((q : ℝ) ^ (n + 1)) ^ 2 = (q : ℝ) ^ (n + 2) * (q : ℝ) ^ n := by ring
  rw [h_lhs_pow] at h_low_mul
  have h_lower : (q : ℝ) ^ n ≤ ‖β‖ ^ 2 :=
    le_of_mul_le_mul_left h_low_mul (by positivity : (0 : ℝ) < (q : ℝ) ^ (n + 2))

  
  have hβ_sq_pos : 0 < ‖β‖ ^ 2 := by
    have hqn_ge1 : (1 : ℝ) ≤ (q : ℝ) ^ n := one_le_pow₀ (by linarith)
    linarith
  have hβ_ne : β ≠ 0 := by
    intro h0
    rw [h0, norm_zero, zero_pow (by decide)] at hβ_sq_pos
    exact lt_irrefl 0 hβ_sq_pos

  
  rcases minpoly.dvd ℚ γ hB₁_rev_γ with ⟨S_up, hS_up⟩
  have hβ_rev : Polynomial.aeval β B₁.reverse = 0 := by
    rw [hS_up, map_mul, hβ, zero_mul]
  have hB₁_β_inv : Polynomial.aeval (β⁻¹) B₁ = 0 := by
    let _ : Invertible (β⁻¹) := invertibleOfNonzero (inv_ne_zero hβ_ne)
    have h_invOf : (⅟ (β⁻¹) : ℂ) = β := by rw [invOf_eq_inv, inv_inv]
    rw [Polynomial.aeval_def, ← h_invOf] at hβ_rev
    exact (Polynomial.eval₂_reverse_eq_zero_iff (algebraMap ℚ ℂ) (β⁻¹) B₁).mp hβ_rev
  have h1_le_up : 1 ≤ (q : ℝ) ^ (n + 2) * ‖β⁻¹‖ ^ 2 := by
    by_contra hlt
    exact hB₁_zero_free _ (lt_of_not_ge hlt) hB₁_β_inv
  rw [norm_inv, inv_pow] at h1_le_up
  have h_up_mul := mul_le_mul_of_nonneg_right h1_le_up hβ_sq_pos.le
  rw [one_mul, inv_mul_cancel_right₀ hβ_sq_pos.ne'] at h_up_mul
  exact ⟨h_lower, h_up_mul⟩

theorem weil_cubic_veronese_linear_span_bridge (k : Type u) [Field k] (N : ℕ)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Z_bar.left)
    (ι₀ : Z_bar ⟶ weilProjectiveSpaceOver k N)
    (hCl₀ : AlgebraicGeometry.IsClosedImmersion ι₀.left) :
    let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
    ∃ (M : ℕ) (ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M)
      (G_coord : Fin (M + 1) → MvPolynomial (Fin (N + 1)) k)
      (hG : ∀ α : Fin (M + 1), G_coord α ∈ 𝒜_N 3),
      let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
      letI : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
      AlgebraicGeometry.IsClosedImmersion ι_bar.left ∧
      (∀ L : MvPolynomial (Fin (M + 1)) k, L ∈ 𝒜_M 1 → L ≠ 0 →
        ∃ z : Z_bar.left, ι_bar.left.base z ∉ weilProjHyperplaneSet k M L) ∧
      (∀ (α : Fin (M + 1))
          (μ : Fin (N + 1)) (hXμ : (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1)
          (V : Z_bar.left.Opens)
          (_ : V ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)))
          (hVμ : V ≤ (TopologicalSpace.Opens.map ι₀.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ))),
        IsUnit (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one).hom ≫
          ι₀.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ)) V hVμ).hom
          (HomogeneousLocalization.mk ⟨3, ⟨G_coord α, hG α⟩,
            ⟨MvPolynomial.X μ ^ 3, (MvPolynomial.mem_homogeneousSubmodule 3 _).mpr
              (MvPolynomial.isHomogeneous_X_pow μ 3)⟩, ⟨3, rfl⟩⟩))) ∧
      (∀ (F : MvPolynomial (Fin (N + 1)) k) (hF : F ∈ 𝒜_N 3),
        ∃ (L : MvPolynomial (Fin (M + 1)) k) (hL : L ∈ 𝒜_M 1),
          ∀ (α : Fin (M + 1)) (hXα : (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1)
            (μ : Fin (N + 1)) (hXμ : (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1)
            (V : Z_bar.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen V)
            (hVα : V ≤ (TopologicalSpace.Opens.map ι_bar.left.base).obj
              (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)))
            (hVμ : V ≤ (TopologicalSpace.Opens.map ι₀.left.base).obj
              (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ))),
            let g_V := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one).hom ≫
              ι₀.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ)) V hVμ).hom
              (HomogeneousLocalization.mk ⟨3, ⟨G_coord α, hG α⟩,
                ⟨MvPolynomial.X μ ^ 3, (MvPolynomial.mem_homogeneousSubmodule 3 _).mpr
                  (MvPolynomial.isHomogeneous_X_pow μ 3)⟩, ⟨3, rfl⟩⟩)
            let ℓ_V := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X α) hXα zero_lt_one).hom ≫
              ι_bar.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)) V hVα).hom
              (HomogeneousLocalization.mk ⟨1, ⟨L, hL⟩, ⟨MvPolynomial.X α, hXα⟩, ⟨1, pow_one _⟩⟩)
            let f_V := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one).hom ≫
              ι₀.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ)) V hVμ).hom
              (HomogeneousLocalization.mk ⟨3, ⟨F, hF⟩,
                ⟨MvPolynomial.X μ ^ 3, (MvPolynomial.mem_homogeneousSubmodule 3 _).mpr
                  (MvPolynomial.isHomogeneous_X_pow μ 3)⟩, ⟨3, rfl⟩⟩)
            g_V * ℓ_V = f_V) ∧
      (∀ (L : MvPolynomial (Fin (M + 1)) k), L ∈ 𝒜_M 1 → L ≠ 0 →
        ∀ {H : AlgebraicGeometry.Scheme.{u}} (ι_H : H ⟶ Z_bar.left),
          IsHomogeneousHypersurfacePullbackOver k M 1 ι_bar L ι_H →
          ∃ F_L : MvPolynomial (Fin (N + 1)) k,
            F_L ∈ 𝒜_N 3 ∧
            (∃ z : Z_bar.left, ι₀.left.base z ∉ weilProjHyperplaneSet k N F_L) ∧
            IsHomogeneousHypersurfacePullbackOver k N 3 ι₀ F_L ι_H) :=
by
  classical
  let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
  let _ : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
  let f₀ : Z_bar.left ⟶ AlgebraicGeometry.Proj 𝒜_N := ι₀.left
  have _ : AlgebraicGeometry.IsIntegral Z_bar.left := hInt
  have _ : IrreducibleSpace Z_bar.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral Z_bar.left
  have _ : AlgebraicGeometry.IsReduced Z_bar.left := inferInstance
  have _ : AlgebraicGeometry.IsClosedImmersion f₀ := hCl₀

  
  have hProjCover : ∀ (R_dim : ℕ),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (R_dim + 1)) k) :=
        MvPolynomial.gradedAlgebra
      ∀ (x : AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (R_dim + 1)) k)),
      ∃ μ : Fin (R_dim + 1),
        x ∈ AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (R_dim + 1)) k) (MvPolynomial.X μ) := by
    intro R_dim x
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (R_dim + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    by_contra h
    apply x.not_irrelevant_le
    intro P hP
    rw [HomogeneousIdeal.mem_irrelevant_iff] at hP
    have hP0 : P.coeff 0 = 0 := by
      have hsplit : P = MvPolynomial.C (P.coeff 0) +
          ∑ d ∈ P.support.erase 0, MvPolynomial.monomial d (P.coeff d) := by
        conv_lhs => rw [P.as_sum]
        by_cases h0 : (0 : Fin (R_dim + 1) →₀ ℕ) ∈ P.support
        · rw [← Finset.add_sum_erase _ _ h0, MvPolynomial.monomial_zero']
        · rw [Finset.erase_eq_of_notMem h0, MvPolynomial.notMem_support_iff.mp h0,
            map_zero, zero_add]
      have hproj_sum : GradedRing.proj 𝒜 0
          (∑ d ∈ P.support.erase 0, MvPolynomial.monomial d (P.coeff d)) = 0 := by
        rw [map_sum]
        refine Finset.sum_eq_zero fun d hd => ?_
        have hd_ne : d ≠ 0 := (Finset.mem_erase.mp hd).1
        have hdeg_ne : d.degree ≠ 0 := by
          intro hsum
          apply hd_ne
          ext i
          have hsum' : ∑ j ∈ d.support, d j = 0 := hsum
          rw [Finset.sum_eq_zero_iff] at hsum'
          by_cases hi : i ∈ d.support
          · exact hsum' i hi
          · exact Finsupp.notMem_support_iff.mp hi
        have hmem : MvPolynomial.monomial d (P.coeff d) ∈ 𝒜 d.degree :=
          MvPolynomial.isHomogeneous_monomial (P.coeff d) rfl
        rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_ne 𝒜 hmem hdeg_ne]
      have hC_mem : (MvPolynomial.C (P.coeff 0) : MvPolynomial (Fin (R_dim + 1)) k) ∈ 𝒜 0 :=
        MvPolynomial.isHomogeneous_C _ _
      have hproj_C : GradedRing.proj 𝒜 0
          (MvPolynomial.C (P.coeff 0) : MvPolynomial (Fin (R_dim + 1)) k) =
          MvPolynomial.C (P.coeff 0) := by
        rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_same 𝒜 hC_mem]
      have hP_eq : (MvPolynomial.C (P.coeff 0) : MvPolynomial (Fin (R_dim + 1)) k) = 0 := by
        calc (MvPolynomial.C (P.coeff 0) : MvPolynomial (Fin (R_dim + 1)) k)
          _ = GradedRing.proj 𝒜 0 (MvPolynomial.C (P.coeff 0) : MvPolynomial (Fin (R_dim + 1)) k) +
              GradedRing.proj 𝒜 0
                (∑ d ∈ P.support.erase 0, MvPolynomial.monomial d (P.coeff d)) := by
            rw [hproj_C, hproj_sum, add_zero]
          _ = GradedRing.proj 𝒜 0 P := by rw [← map_add, ← hsplit]
          _ = 0 := hP
      simpa using congrArg MvPolynomial.constantCoeff hP_eq
    rw [P.as_sum]
    refine Ideal.sum_mem _ fun d hd => ?_
    have hd0 : d ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hd) hP0
    have ⟨μ, hμ⟩ : ∃ μ : Fin (R_dim + 1), 0 < d μ := by
      by_contra hall
      apply hd0
      ext μ
      exact Nat.eq_zero_of_not_pos (fun hpos => hall ⟨μ, hpos⟩)
    have hX_mem : (MvPolynomial.X μ : MvPolynomial (Fin (R_dim + 1)) k) ∈
        x.asHomogeneousIdeal := by
      by_contra hnot
      exact h ⟨μ, (ProjectiveSpectrum.mem_basicOpen 𝒜 (MvPolynomial.X μ) x).mpr hnot⟩
    obtain ⟨r, hr⟩ : (MvPolynomial.X μ : MvPolynomial (Fin (R_dim + 1)) k) ∣
        MvPolynomial.monomial d (P.coeff d) := by
      refine ⟨MvPolynomial.monomial (d - Finsupp.single μ 1) (P.coeff d), ?_⟩
      rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, one_mul, add_tsub_cancel_of_le]
      intro i
      by_cases hi : i = μ
      · subst hi; simp; omega
      · simp [hi]
    rw [hr]
    exact x.asHomogeneousIdeal.toIdeal.mul_mem_right r hX_mem

  
  have hMonomHomog : ∀ {R_dim n : ℕ} (d : Fin (R_dim + 1) →₀ ℕ) (c : k),
      (∑ i : Fin (R_dim + 1), d i) = n →
      MvPolynomial.monomial d c ∈ MvPolynomial.homogeneousSubmodule (Fin (R_dim + 1)) k n := by
    intro R_dim n d c hsum
    rw [MvPolynomial.mem_homogeneousSubmodule]
    intro s hs
    have hsd : s = d := by
      by_contra hne
      rw [MvPolynomial.coeff_monomial, ite_eq_right_iff.mpr fun h => False.elim (hne h.symm)] at hs
      exact hs rfl
    subst hsd
    simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using hsum

  have hPeel1 : ∀ {R_dim m : ℕ} (d : Fin (R_dim + 1) →₀ ℕ) (c : k),
      (∑ i : Fin (R_dim + 1), d i) = m + 1 →
      ∃ (u : Fin (R_dim + 1)) (d' : Fin (R_dim + 1) →₀ ℕ),
        (∑ i : Fin (R_dim + 1), d' i) = m ∧
        MvPolynomial.monomial d c = MvPolynomial.monomial d' c * MvPolynomial.X u := by
    intro R_dim m d c hsum
    have ⟨u, hu⟩ : ∃ u : Fin (R_dim + 1), 0 < d u := by
      by_contra hall
      have h0 : (∑ i : Fin (R_dim + 1), d i) = 0 :=
        Finset.sum_eq_zero fun i _ => Nat.eq_zero_of_not_pos (fun hp => hall ⟨i, hp⟩)
      omega
    let d' : Fin (R_dim + 1) →₀ ℕ := d - Finsupp.single u 1
    have hd'_add : d' + Finsupp.single u 1 = d := by
      apply tsub_add_cancel_of_le
      intro i
      by_cases hi : i = u
      · subst hi; simp; omega
      · simp [hi]
    have hsum' : (∑ i : Fin (R_dim + 1), d' i) = m := by
      have h1 : (∑ i : Fin (R_dim + 1), (d' + Finsupp.single u 1 : Fin (R_dim + 1) →₀ ℕ) i) = m + 1 := by
        rw [hd'_add]; exact hsum
      simp only [Finsupp.add_apply, Finset.sum_add_distrib, Finsupp.single_apply,
        Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte] at h1
      omega
    refine ⟨u, d', hsum', ?_⟩
    rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, mul_one, hd'_add]

  have hDeg0 : ∀ {R_dim : ℕ} (P : MvPolynomial (Fin (R_dim + 1)) k),
      P ∈ MvPolynomial.homogeneousSubmodule (Fin (R_dim + 1)) k 0 →
      P = MvPolynomial.C (P.coeff 0) := by
    intro R_dim P hP
    ext d
    by_cases hd0 : d = 0
    · subst hd0; simp [MvPolynomial.coeff_C]
    · rw [MvPolynomial.coeff_C, ite_eq_right_iff.mpr fun h => False.elim (hd0 h.symm)]
      by_contra hne
      have h1 := (MvPolynomial.mem_homogeneousSubmodule 0 P).mp hP hne
      have hsum : (∑ i : Fin (R_dim + 1), d i) = 0 := by
        simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using h1
      apply hd0
      ext i
      exact Finset.sum_eq_zero_iff.mp hsum i (Finset.mem_univ i)

  have hPeel3 : ∀ (r : ℕ) (d : Fin (N + 1) →₀ ℕ) (c : k),
      (∑ i : Fin (N + 1), d i) = 3 * (r + 1) →
      ∃ (u v w : Fin (N + 1)) (d₃ : Fin (N + 1) →₀ ℕ),
        (∑ i : Fin (N + 1), d₃ i) = 3 * r ∧
        MvPolynomial.monomial d c =
          MvPolynomial.monomial d₃ c * (MvPolynomial.X u * MvPolynomial.X v * MvPolynomial.X w) := by
    intro r d c hsum
    obtain ⟨w, d₁, hsum₁, eq₁⟩ := hPeel1 (m := 3 * r + 2) d c (by omega)
    obtain ⟨v, d₂, hsum₂, eq₂⟩ := hPeel1 (m := 3 * r + 1) d₁ c hsum₁
    obtain ⟨u, d₃, hsum₃, eq₃⟩ := hPeel1 (m := 3 * r) d₂ c hsum₂
    refine ⟨u, v, w, d₃, hsum₃, ?_⟩
    rw [eq₁, eq₂, eq₃]
    ring

  have hTripleHomog : ∀ u v w : Fin (N + 1),
      (MvPolynomial.X u * MvPolynomial.X v * MvPolynomial.X w :
        MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 3 := by
    intro u v w
    have hXu : (MvPolynomial.X u : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1 :=
      MvPolynomial.isHomogeneous_X k u
    have hXv : (MvPolynomial.X v : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1 :=
      MvPolynomial.isHomogeneous_X k v
    have hXw : (MvPolynomial.X w : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1 :=
      MvPolynomial.isHomogeneous_X k w
    exact SetLike.mul_mem_graded (SetLike.mul_mem_graded hXu hXv) hXw

  
  let v_cub : Fin (N + 1) × Fin (N + 1) × Fin (N + 1) → ↥(𝒜_N 3) :=
    fun t => ⟨MvPolynomial.X t.1 * MvPolynomial.X t.2.1 * MvPolynomial.X t.2.2,
      hTripleHomog t.1 t.2.1 t.2.2⟩
  have hSpan_cub : Submodule.span k (Set.range v_cub) = ⊤ := by
    rw [eq_top_iff]
    rintro ⟨F, hF⟩ _
    have hmem_mon : ∀ d ∈ F.support,
        ∃ hmd : MvPolynomial.monomial d (F.coeff d) ∈ 𝒜_N 3,
          (⟨MvPolynomial.monomial d (F.coeff d), hmd⟩ : ↥(𝒜_N 3)) ∈
            Submodule.span k (Set.range v_cub) := by
      intro d hd
      have hd_sum : (∑ i : Fin (N + 1), d i) = 3 := by
        have h1 := (MvPolynomial.mem_homogeneousSubmodule 3 F).mp hF
          (MvPolynomial.mem_support_iff.mp hd)
        simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using h1
      have hmd : MvPolynomial.monomial d (F.coeff d) ∈ 𝒜_N 3 :=
        hMonomHomog d (F.coeff d) hd_sum
      obtain ⟨u, v, w, d₃, hd₃_sum, hmon_eq⟩ := hPeel3 0 d (F.coeff d) (by omega)
      have hd₃_zero : d₃ = 0 := by
        ext i
        exact Finset.sum_eq_zero_iff.mp hd₃_sum i (Finset.mem_univ i)
      subst hd₃_zero
      rw [MvPolynomial.monomial_zero'] at hmon_eq
      refine ⟨hmd, ?_⟩
      have heq_sub : (⟨MvPolynomial.monomial d (F.coeff d), hmd⟩ : ↥(𝒜_N 3)) =
          (F.coeff d) • v_cub (u, v, w) := by
        apply Subtype.ext
        change MvPolynomial.monomial d (F.coeff d) =
          (F.coeff d) • (MvPolynomial.X u * MvPolynomial.X v * MvPolynomial.X w)
        rw [Algebra.smul_def, MvPolynomial.algebraMap_eq]
        exact hmon_eq
      rw [heq_sub]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨(u, v, w), rfl⟩)
    have hF_sum : (⟨F, hF⟩ : ↥(𝒜_N 3)) =
        ∑ d ∈ F.support.attach, ⟨MvPolynomial.monomial d.1 (F.coeff d.1), (hmem_mon d.1 d.2).1⟩ := by
      apply Subtype.ext
      push_cast
      conv_lhs => rw [F.as_sum]
      exact (Finset.sum_attach F.support (fun d => MvPolynomial.monomial d (F.coeff d))).symm
    rw [hF_sum]
    exact Submodule.sum_mem _ fun d _ => (hmem_mon d.1 d.2).2
  have hFG_cub : (⊤ : Submodule k ↥(𝒜_N 3)).FG :=
    hSpan_cub ▸ Submodule.fg_span (Set.finite_range v_cub)
  let _ : Module.Finite k ↥(𝒜_N 3) := Module.Finite.of_fg_top hFG_cub

  
  let J_van : Ideal (MvPolynomial (Fin (N + 1)) k) :=
    ⨅ z : Z_bar.left, (f₀.base z).asHomogeneousIdeal.toIdeal
  let I_3 : Submodule k ↥(𝒜_N 3) := (J_van.restrictScalars k).comap (𝒜_N 3).subtype
  obtain ⟨V_span, hCompl⟩ := Submodule.exists_isCompl I_3
  have hVspan_ne_bot : V_span ≠ ⊥ := by
    intro hbot
    have hI3_top : I_3 = ⊤ := by
      have hsup := hCompl.sup_eq_top
      rwa [hbot, sup_bot_eq] at hsup
    let z₀ : Z_bar.left := Classical.arbitrary Z_bar.left
    obtain ⟨μ₀, hz₀_μ₀⟩ := hProjCover N (f₀.base z₀)
    have hX_notMem : (MvPolynomial.X μ₀ : MvPolynomial (Fin (N + 1)) k) ∉
        (f₀.base z₀).asHomogeneousIdeal :=
      (ProjectiveSpectrum.mem_basicOpen 𝒜_N (MvPolynomial.X μ₀) (f₀.base z₀)).mp hz₀_μ₀
    have hX3_hom : (MvPolynomial.X μ₀ ^ 3 : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 3 :=
      (MvPolynomial.mem_homogeneousSubmodule 3 _).mpr (MvPolynomial.isHomogeneous_X_pow μ₀ 3)
    have hX3_mem_I3 : (⟨MvPolynomial.X μ₀ ^ 3, hX3_hom⟩ : ↥(𝒜_N 3)) ∈ I_3 := by
      rw [hI3_top]; trivial
    have hX3_mem_J : (MvPolynomial.X μ₀ ^ 3 : MvPolynomial (Fin (N + 1)) k) ∈ J_van := hX3_mem_I3
    have hX3_mem_z₀ : (MvPolynomial.X μ₀ ^ 3 : MvPolynomial (Fin (N + 1)) k) ∈
        (f₀.base z₀).asHomogeneousIdeal.toIdeal :=
      (Ideal.mem_iInf.mp hX3_mem_J) z₀
    exact hX_notMem ((f₀.base z₀).isPrime.mem_of_pow_mem 3 hX3_mem_z₀)
  have ⟨v₀_sp, hv₀_mem, hv₀_ne⟩ : ∃ v₀_sp ∈ V_span, v₀_sp ≠ 0 := by
    by_contra hall
    exact hVspan_ne_bot (eq_bot_iff.mpr fun v hv => by
      by_contra hv0
      exact hall ⟨v, hv, hv0⟩)
  have : Nontrivial ↥V_span :=
    ⟨⟨⟨v₀_sp, hv₀_mem⟩, 0, fun h => hv₀_ne (congrArg Subtype.val h)⟩⟩
  have : Module.Free k ↥V_span := Module.Free.of_divisionRing k ↥V_span
  have hpos_rk : 0 < Module.finrank k ↥V_span := Module.finrank_pos (R := k) (M := ↥V_span)
  obtain ⟨M, ⟨b_span⟩⟩ : ∃ (M : ℕ), Nonempty (Module.Basis (Fin (M + 1)) k ↥V_span) :=
    ⟨Module.finrank k ↥V_span - 1,
      ⟨Module.finBasisOfFinrankEq k ↥V_span (Nat.sub_add_cancel hpos_rk).symm⟩⟩
  obtain ⟨G_coord, hG, hG_eq⟩ : ∃ (G_coord : Fin (M + 1) → MvPolynomial (Fin (N + 1)) k)
      (hG : ∀ α : Fin (M + 1), G_coord α ∈ 𝒜_N 3),
      ∀ α : Fin (M + 1), G_coord α = ((b_span α : ↥V_span) : ↥(𝒜_N 3)).1 :=
    ⟨fun α => ((b_span α : ↥V_span) : ↥(𝒜_N 3)).1,
      fun α => ((b_span α : ↥V_span) : ↥(𝒜_N 3)).2,
      fun _ => rfl⟩
  have hG_ne : ∀ α : Fin (M + 1), G_coord α ≠ 0 := by
    intro α h0
    rw [hG_eq α] at h0
    exact b_span.ne_zero α (Subtype.ext (Subtype.ext h0))

  let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let _ : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
  let Φ_G : MvPolynomial (Fin (M + 1)) k →+* MvPolynomial (Fin (N + 1)) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C G_coord

  have hΦ_homog : ∀ {d : ℕ} {Q : MvPolynomial (Fin (M + 1)) k},
      Q ∈ 𝒜_M d → Φ_G Q ∈ 𝒜_N (3 * d) := by
    intro d Q hQ
    rw [MvPolynomial.mem_homogeneousSubmodule] at hQ ⊢
    exact hQ.eval₂ MvPolynomial.C G_coord (fun r => MvPolynomial.isHomogeneous_C _ r)
      (fun α => (MvPolynomial.mem_homogeneousSubmodule 3 _).mp (hG α))

  have hLinForm_M : ∀ (L : MvPolynomial (Fin (M + 1)) k), L ∈ 𝒜_M 1 →
      L = ∑ β : Fin (M + 1), MvPolynomial.C (L.coeff (Finsupp.single β 1)) * MvPolynomial.X β := by
    intro L hL
    ext d
    rw [MvPolynomial.coeff_sum]
    by_cases hd : d ∈ L.support
    · have hd_deg : ∑ β : Fin (M + 1), d β = 1 := by
        have h1 := (MvPolynomial.mem_homogeneousSubmodule 1 L).mp hL
          (MvPolynomial.mem_support_iff.mp hd)
        simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using h1
      obtain ⟨β₀, d', hd'_sum, hmon⟩ := hPeel1 (m := 0) d 1 hd_deg
      have hd'_zero : d' = 0 := by
        ext β
        exact Finset.sum_eq_zero_iff.mp hd'_sum β (Finset.mem_univ β)
      have hd_single : d = Finsupp.single β₀ 1 := by
        have h1 : MvPolynomial.monomial d (1 : k) = MvPolynomial.monomial (Finsupp.single β₀ 1) 1 := by
          rw [hmon, hd'_zero, MvPolynomial.monomial_zero', map_one, one_mul, MvPolynomial.X]
        by_contra hne
        have hc := congrArg (fun P : MvPolynomial (Fin (M + 1)) k => P.coeff d) h1
        rw [MvPolynomial.coeff_monomial, ite_eq_left_iff.mpr fun h => False.elim (h rfl),
          MvPolynomial.coeff_monomial, ite_eq_right_iff.mpr fun h => False.elim (hne h.symm)] at hc
        exact one_ne_zero hc
      subst hd_single
      rw [Finset.sum_eq_single β₀]
      · simp [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X]
      · intro β _ hβ
        have hne : Finsupp.single β 1 ≠ Finsupp.single β₀ 1 :=
          fun heq => hβ ((Finsupp.single_left_inj one_ne_zero).mp heq)
        simp [MvPolynomial.coeff_C_mul, MvPolynomial.X, MvPolynomial.coeff_monomial, hne]
      · intro hmem; exact False.elim (hmem (Finset.mem_univ β₀))
    · rw [MvPolynomial.notMem_support_iff.mp hd]
      symm
      refine Finset.sum_eq_zero fun β _ => ?_
      by_cases hsingle : d = Finsupp.single β 1
      · subst hsingle
        simp [MvPolynomial.notMem_support_iff.mp hd]
      · simp [MvPolynomial.coeff_C_mul, MvPolynomial.X, MvPolynomial.coeff_monomial, Ne.symm hsingle]

  have hΦ_sum : ∀ (c : Fin (M + 1) → k),
      Φ_G (∑ β : Fin (M + 1), MvPolynomial.C (c β) * MvPolynomial.X β) =
        (((∑ β : Fin (M + 1), c β • b_span β : ↥V_span) : ↥(𝒜_N 3)) :
          MvPolynomial (Fin (N + 1)) k) := by
    intro c
    rw [map_sum]
    push_cast
    refine Finset.sum_congr rfl fun β _ => ?_
    change Φ_G (MvPolynomial.C (c β) * MvPolynomial.X β) = c β • ((b_span β : ↥V_span) : ↥(𝒜_N 3)).1
    rw [map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X', hG_eq β,
      Algebra.smul_def, MvPolynomial.algebraMap_eq]

  
  have hNondeg : ∀ L : MvPolynomial (Fin (M + 1)) k, L ∈ 𝒜_M 1 → L ≠ 0 →
      ∃ z : Z_bar.left, ι₀.left.base z ∉ weilProjHyperplaneSet k N (Φ_G L) := by
    intro L hL hL_ne
    let c : Fin (M + 1) → k := fun β => L.coeff (Finsupp.single β 1)
    have hL_eq : L = ∑ β : Fin (M + 1), MvPolynomial.C (c β) * MvPolynomial.X β :=
      hLinForm_M L hL
    let v_L : ↥V_span := ∑ β : Fin (M + 1), c β • b_span β
    have hvL_ne : v_L ≠ 0 := by
      intro hv0
      have hrepr0 : b_span.repr v_L = 0 := by
        rw [hv0, map_zero]
      have hc_zero : ∀ β : Fin (M + 1), c β = 0 := by
        intro β
        have h1 : (b_span.repr v_L) β = 0 := by
          rw [hrepr0]
          rfl
        dsimp only [v_L] at h1
        rw [map_sum, Finsupp.finsetSum_apply] at h1
        have h2 : ∑ x : Fin (M + 1), (b_span.repr (c x • b_span x)) β = c β := by
          rw [Finset.sum_eq_single β]
          · rw [map_smul, b_span.repr_self, Finsupp.smul_single_one, Finsupp.single_eq_same]
          · intro x _ hx
            rw [map_smul, b_span.repr_self, Finsupp.smul_single_one,
              Finsupp.single_eq_of_ne (Ne.symm hx)]
          · intro hmem
            exact False.elim (hmem (Finset.mem_univ β))
        exact h2.symm.trans h1
      apply hL_ne
      rw [hL_eq]
      refine Finset.sum_eq_zero fun β _ => ?_
      rw [hc_zero β, map_zero, zero_mul]
    have hnot_I3 : (v_L : ↥(𝒜_N 3)) ∉ I_3 := by
      intro hmem
      have hinf : (v_L : ↥(𝒜_N 3)) ∈ I_3 ⊓ V_span := ⟨hmem, v_L.2⟩
      rw [hCompl.inf_eq_bot, Submodule.mem_bot] at hinf
      exact hvL_ne (Subtype.ext hinf)
    have hΦL_eq : Φ_G L = ((v_L : ↥(𝒜_N 3)) : MvPolynomial (Fin (N + 1)) k) := by
      rw [hL_eq, hΦ_sum]
    have hnot_J : Φ_G L ∉ J_van := by
      rw [hΦL_eq]
      exact hnot_I3
    rw [Ideal.mem_iInf, not_forall] at hnot_J
    obtain ⟨z, hz_notMem⟩ := hnot_J
    refine ⟨z, ?_⟩
    intro hz_hyp
    exact hz_hyp ((ProjectiveSpectrum.mem_basicOpen 𝒜_N (Φ_G L) (f₀.base z)).mpr hz_notMem)

  
  have hProjCubic : ∀ (F : MvPolynomial (Fin (N + 1)) k) (hF : F ∈ 𝒜_N 3),
      ∃ (L : MvPolynomial (Fin (M + 1)) k) (hL : L ∈ 𝒜_M 1),
        F - Φ_G L ∈ J_van := by
    intro F hF
    have htop : (⟨F, hF⟩ : ↥(𝒜_N 3)) ∈ I_3 ⊔ V_span := by
      rw [hCompl.sup_eq_top]; trivial
    obtain ⟨u_van, hu_mem, v_sp, hv_mem, huv⟩ := Submodule.mem_sup.mp htop
    let c : Fin (M + 1) → k := fun β => b_span.repr ⟨v_sp, hv_mem⟩ β
    let L : MvPolynomial (Fin (M + 1)) k :=
      ∑ β : Fin (M + 1), MvPolynomial.C (c β) * MvPolynomial.X β
    have hL : L ∈ 𝒜_M 1 := by
      refine Submodule.sum_mem _ fun β _ => ?_
      rw [← MvPolynomial.algebraMap_eq, ← Algebra.smul_def]
      exact (𝒜_M 1).smul_mem (c β) (MvPolynomial.isHomogeneous_X k β)
    have hΦL : Φ_G L = v_sp.1 := by
      dsimp [L]
      rw [hΦ_sum, b_span.sum_repr ⟨v_sp, hv_mem⟩]
    have hsub : F - Φ_G L = u_van.1 := by
      have hval : u_van.1 + v_sp.1 = F := congrArg Subtype.val huv
      rw [hΦL, ← hval, add_sub_cancel_right]
    refine ⟨L, hL, ?_⟩
    rw [hsub]
    exact hu_mem

  
  have hBp : ∀ z : Z_bar.left, ∃ α : Fin (M + 1),
      f₀.base z ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N (G_coord α) := by
    intro z
    obtain ⟨μ, hz_μ⟩ := hProjCover N (f₀.base z)
    have hX_not : (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) k) ∉
        (f₀.base z).asHomogeneousIdeal :=
      (ProjectiveSpectrum.mem_basicOpen 𝒜_N (MvPolynomial.X μ) (f₀.base z)).mp hz_μ
    have hX3_not : (MvPolynomial.X μ ^ 3 : MvPolynomial (Fin (N + 1)) k) ∉
        (f₀.base z).asHomogeneousIdeal.toIdeal :=
      fun h => hX_not ((f₀.base z).isPrime.mem_of_pow_mem 3 h)
    have hX3_hom : (MvPolynomial.X μ ^ 3 : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 3 :=
      (MvPolynomial.mem_homogeneousSubmodule 3 _).mpr (MvPolynomial.isHomogeneous_X_pow μ 3)
    obtain ⟨L, hL, hdiff_J⟩ := hProjCubic (MvPolynomial.X μ ^ 3) hX3_hom
    have hdiff_z : MvPolynomial.X μ ^ 3 - Φ_G L ∈
        (f₀.base z).asHomogeneousIdeal.toIdeal :=
      (Ideal.mem_iInf.mp hdiff_J) z
    by_contra hall
    have hΦL_z : Φ_G L ∈ (f₀.base z).asHomogeneousIdeal.toIdeal := by
      rw [hLinForm_M L hL, map_sum]
      refine Ideal.sum_mem _ fun β _ => ?_
      rw [map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
      have hG_z : G_coord β ∈ (f₀.base z).asHomogeneousIdeal := by
        by_contra hnot
        exact hall ⟨β, (ProjectiveSpectrum.mem_basicOpen 𝒜_N (G_coord β) (f₀.base z)).mpr hnot⟩
      exact (f₀.base z).asHomogeneousIdeal.toIdeal.mul_mem_left _ hG_z
    exact hX3_not (by simpa only [sub_add_cancel] using
      (f₀.base z).asHomogeneousIdeal.toIdeal.add_mem hdiff_z hΦL_z)

  
  have hNilVanish : ∀ {d_den d_num : ℕ} {D H : MvPolynomial (Fin (N + 1)) k}
      (hD : D ∈ 𝒜_N d_den) (hd_pos : 0 < d_den)
      (hH : H ∈ 𝒜_N d_num) (hn_pos : 0 < d_num)
      (hH_van : H ∈ J_van)
      (r : ℕ) (hr_deg : d_num = d_den * r)
      (hDr : D ^ r ∈ 𝒜_N d_num)
      (V : Z_bar.left.Opens) (hAffV : AlgebraicGeometry.IsAffineOpen V)
      (hVD : V ≤ (TopologicalSpace.Opens.map f₀.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_N D)),
      (AlgebraicGeometry.Proj.awayToSection 𝒜_N D ≫
        f₀.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N D) V hVD).hom
        (HomogeneousLocalization.mk ⟨d_num, ⟨H, hH⟩, ⟨D ^ r, hDr⟩,
          pow_mem (Submonoid.mem_powers D) r⟩) = 0 := by
    intro d_den d_num D H hD hd_pos hH hn_pos hH_van r hr_deg hDr V hAffV hVD
    let U_D : (AlgebraicGeometry.Proj 𝒜_N).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_N D
    let ψ_DV := AlgebraicGeometry.Proj.awayToSection 𝒜_N D ≫ f₀.appLE U_D V hVD
    let w : HomogeneousLocalization.Away 𝒜_N D :=
      HomogeneousLocalization.mk ⟨d_num, ⟨H, hH⟩, ⟨D ^ r, hDr⟩,
        pow_mem (Submonoid.mem_powers D) r⟩
    let A := ↑(Z_bar.left.presheaf.obj (Opposite.op V))
    have _ : IsReduced A := AlgebraicGeometry.IsReduced.component_reduced V
    have hSpec_comm : V.toSpecΓ ≫ AlgebraicGeometry.Spec.map ψ_DV ≫
        AlgebraicGeometry.Proj.awayι 𝒜_N D hD hd_pos = V.ι ≫ f₀ := by
      dsimp only [ψ_DV]
      rw [AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE]
      have h1 : U_D.toSpecΓ ≫
          AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜_N D) =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N D hD hd_pos).hom :=
        (AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜_N D hD hd_pos).symm
      rw [CategoryTheory.Category.assoc (f₀.resLE U_D V hVD), h1,
        CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_N D hD hd_pos,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N D hD hd_pos).hom,
        CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp,
        AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
    have hw_pow : w ^ d_den = HomogeneousLocalization.Away.isLocalizationElem hD hH := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_pow, HomogeneousLocalization.Away.isLocalizationElem,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_mk]
      dsimp only
      have hpow_mk : ∀ (k_exp : ℕ),
          (Localization.mk H (⟨D ^ r, pow_mem (Submonoid.mem_powers D) r⟩ :
            Submonoid.powers D)) ^ k_exp =
            Localization.mk (H ^ k_exp)
              (⟨(D ^ r) ^ k_exp,
                pow_mem (pow_mem (Submonoid.mem_powers D) r) k_exp⟩ :
                Submonoid.powers D) := by
        intro k_exp
        induction k_exp with
        | zero => simp
        | succ k_exp ih =>
          rw [pow_succ, ih, Localization.mk_mul]
          rfl
      rw [hpow_mk d_den]
      have hden_eq : (D ^ r) ^ d_den = D ^ d_num := by
        rw [← pow_mul, mul_comm, ← hr_deg]
      exact congrArg (Localization.mk _) (Subtype.ext hden_eq)
    have hmem_sInf : ψ_DV.hom w ∈ sInf {J : Ideal A | J.IsPrime} := by
      rw [Ideal.mem_sInf]
      intro J hJ
      let _ : J.IsPrime := hJ
      let p : AlgebraicGeometry.Spec (CommRingCat.of A) := ⟨J, hJ⟩
      let v : ↥V.toScheme := hAffV.isoSpec.inv.base p
      have hv_p : V.toSpecΓ.base v = p := by
        rw [← hAffV.isoSpec_hom]
        exact congrArg (fun g : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of A) => g.base p) hAffV.isoSpec.inv_hom_id
      let z : Z_bar.left := V.ι.base v
      let q : PrimeSpectrum (HomogeneousLocalization.Away 𝒜_N D) :=
        (AlgebraicGeometry.Spec.map ψ_DV).base p
      have hq_base : (AlgebraicGeometry.Proj.awayι 𝒜_N D hD hd_pos).base q = f₀.base z := by
        have hc := congrArg (fun g : V.toScheme ⟶ AlgebraicGeometry.Proj 𝒜_N => g.base v) hSpec_comm
        dsimp only at hc
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply,
          AlgebraicGeometry.Scheme.Hom.comp_apply, hv_p] at hc
        exact hc
      have hH_z : H ∈ (f₀.base z).asHomogeneousIdeal :=
        (Ideal.mem_iInf.mp hH_van) z
      have hz_not_basic : f₀.base z ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_N H :=
        fun hmem => ((ProjectiveSpectrum.mem_basicOpen 𝒜_N H (f₀.base z)).mp hmem) hH_z
      have hq_not_pre : q ∉ (TopologicalSpace.Opens.map
          (AlgebraicGeometry.Proj.awayι 𝒜_N D hD hd_pos).base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N H) := by
        change (AlgebraicGeometry.Proj.awayι 𝒜_N D hD hd_pos).base q ∉
          AlgebraicGeometry.Proj.basicOpen 𝒜_N H
        rwa [hq_base]
      rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_N hD hd_pos hH hn_pos,
        ← hw_pow] at hq_not_pre
      have hw_pow_q : w ^ d_den ∈ q.asIdeal := by
        by_contra hnot
        exact hq_not_pre hnot
      have hw_q : w ∈ q.asIdeal := q.isPrime.mem_of_pow_mem d_den hw_pow_q
      exact hw_q
    rw [← nilradical_eq_sInf A, nilradical_eq_bot_iff.mpr inferInstance, Ideal.mem_bot] at hmem_sInf
    exact hmem_sInf

  have hMk_sub : ∀ {S : Submonoid (MvPolynomial (Fin (N + 1)) k)} {d : ℕ}
      (P₁ P₂ : MvPolynomial (Fin (N + 1)) k) (hP₁ : P₁ ∈ 𝒜_N d) (hP₂ : P₂ ∈ 𝒜_N d)
      (hSub : P₁ - P₂ ∈ 𝒜_N d) (den : ↥(𝒜_N d)) (hden : den.1 ∈ S),
      (HomogeneousLocalization.mk ⟨d, ⟨P₁, hP₁⟩, den, hden⟩ : HomogeneousLocalization 𝒜_N S) -
        HomogeneousLocalization.mk ⟨d, ⟨P₂, hP₂⟩, den, hden⟩ =
        HomogeneousLocalization.mk ⟨d, ⟨P₁ - P₂, hSub⟩, den, hden⟩ := by
    intro S d P₁ P₂ hP₁ hP₂ hSub den hden
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_sub, HomogeneousLocalization.val_mk,
      HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
    dsimp only
    rw [sub_eq_add_neg, Localization.neg_mk, Localization.add_mk_self, ← sub_eq_add_neg]

  have hLift_F : ∀ (F : MvPolynomial (Fin (N + 1)) k) (hF : F ∈ 𝒜_N 3),
      ∃ (L : MvPolynomial (Fin (M + 1)) k) (hL : L ∈ 𝒜_M 1) (hΦL : Φ_G L ∈ 𝒜_N 3),
        ∀ (μ : Fin (N + 1)) (hXμ : (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1)
          (V : Z_bar.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen V)
          (hVμ : V ≤ (TopologicalSpace.Opens.map f₀.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ))),
          let hXμ3 : MvPolynomial.X μ ^ 3 ∈ 𝒜_N 3 :=
            (MvPolynomial.mem_homogeneousSubmodule 3 _).mpr (MvPolynomial.isHomogeneous_X_pow μ 3)
          let φ_μ := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one).hom ≫
            f₀.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ)) V hVμ).hom
          φ_μ (HomogeneousLocalization.mk ⟨3, ⟨F, hF⟩, ⟨MvPolynomial.X μ ^ 3, hXμ3⟩, ⟨3, rfl⟩⟩) =
          φ_μ (HomogeneousLocalization.mk ⟨3, ⟨Φ_G L, hΦL⟩, ⟨MvPolynomial.X μ ^ 3, hXμ3⟩, ⟨3, rfl⟩⟩) := by
    intro F hF
    obtain ⟨L, hL, hdiff_J⟩ := hProjCubic F hF
    have hΦL : Φ_G L ∈ 𝒜_N 3 := by simpa using hΦ_homog hL
    refine ⟨L, hL, hΦL, fun μ hXμ V hAffV hVμ => ?_⟩
    intro hXμ3 φ_μ
    have hSub_hom : F - Φ_G L ∈ 𝒜_N 3 := sub_mem hF hΦL
    have h0 := hNilVanish hXμ zero_lt_one hSub_hom (by decide : 0 < 3) hdiff_J 3 (by omega) hXμ3
      V hAffV hVμ
    have hφ_eq : φ_μ = (AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X μ) ≫
        f₀.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X μ)) V hVμ).hom := by
      dsimp only [φ_μ]
      rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜_N (MvPolynomial.X μ) hXμ zero_lt_one]
    have hden3 : (⟨MvPolynomial.X μ ^ 3, hXμ3⟩ : ↥(𝒜_N 3)).1 ∈
        Submonoid.powers (MvPolynomial.X μ : MvPolynomial (Fin (N + 1)) k) :=
      pow_mem (Submonoid.mem_powers (MvPolynomial.X μ)) 3
    rw [← sub_eq_zero, ← map_sub,
      hMk_sub F (Φ_G L) hF hΦL hSub_hom ⟨MvPolynomial.X μ ^ 3, hXμ3⟩ hden3, hφ_eq]
    exact h0

  have hDeg3r : ∀ (α : Fin (M + 1))
      (V : Z_bar.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen V)
      (hVG : V ≤ (TopologicalSpace.Opens.map f₀.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_N (G_coord α)))
      (r : ℕ) (P : MvPolynomial (Fin (N + 1)) k) (hP : P ∈ 𝒜_N (3 * r)),
      ∃ (Q : MvPolynomial (Fin (M + 1)) k) (hQ : Q ∈ 𝒜_M r),
        let hΦQ : Φ_G Q ∈ 𝒜_N (3 * r) := hΦ_homog hQ
        let hGr : G_coord α ^ r ∈ 𝒜_N (3 * r) :=
          (MvPolynomial.mem_homogeneousSubmodule (3 * r) _).mpr
            (((MvPolynomial.mem_homogeneousSubmodule 3 _).mp (hG α)).pow r)
        let φ_V := (AlgebraicGeometry.Proj.awayToSection 𝒜_N (G_coord α) ≫
          f₀.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (G_coord α)) V hVG).hom
        φ_V (HomogeneousLocalization.mk ⟨3 * r, ⟨P, hP⟩, ⟨G_coord α ^ r, hGr⟩,
          pow_mem (Submonoid.mem_powers (G_coord α)) r⟩) =
        φ_V (HomogeneousLocalization.mk ⟨3 * r, ⟨Φ_G Q, hΦQ⟩, ⟨G_coord α ^ r, hGr⟩,
          pow_mem (Submonoid.mem_powers (G_coord α)) r⟩) := by
    intro α V hAffV hVG r
    let φ_V := (AlgebraicGeometry.Proj.awayToSection 𝒜_N (G_coord α) ≫
      f₀.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (G_coord α)) V hVG).hom
    induction r with
    | zero =>
      intro P hP
      have hP_C : P = MvPolynomial.C (P.coeff 0) := hDeg0 P hP
      let Q : MvPolynomial (Fin (M + 1)) k := MvPolynomial.C (P.coeff 0)
      have hQ : Q ∈ 𝒜_M 0 := MvPolynomial.isHomogeneous_C _ _
      refine ⟨Q, hQ, ?_⟩
      have hΦQ_eq : Φ_G Q = P := by
        dsimp only [Q]
        rw [MvPolynomial.eval₂Hom_C, ← hP_C]
      apply congrArg φ_V
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
      exact congrArg (fun x => Localization.mk x _) hΦQ_eq.symm
    | succ r ih =>
      intro P hP
      have hGr1 : G_coord α ^ (r + 1) ∈ 𝒜_N (3 * (r + 1)) :=
        (MvPolynomial.mem_homogeneousSubmodule (3 * (r + 1)) _).mpr
          (((MvPolynomial.mem_homogeneousSubmodule 3 _).mp (hG α)).pow (r + 1))
      have hGr : G_coord α ^ r ∈ 𝒜_N (3 * r) :=
        (MvPolynomial.mem_homogeneousSubmodule (3 * r) _).mpr
          (((MvPolynomial.mem_homogeneousSubmodule 3 _).mp (hG α)).pow r)
      let hmem_r1 := pow_mem (Submonoid.mem_powers (G_coord α)) (r + 1)
      let hmem_r := pow_mem (Submonoid.mem_powers (G_coord α)) r
      let hmem_1 := Submonoid.mem_powers (G_coord α)
      have hMonLift : ∀ s ∈ P.support,
          ∃ (Q_s : MvPolynomial (Fin (M + 1)) k) (hQs : Q_s ∈ 𝒜_M (r + 1))
            (hms : MvPolynomial.monomial s (P.coeff s) ∈ 𝒜_N (3 * (r + 1))),
            φ_V (HomogeneousLocalization.mk ⟨3 * (r + 1),
              ⟨MvPolynomial.monomial s (P.coeff s), hms⟩,
              ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩) =
            φ_V (HomogeneousLocalization.mk ⟨3 * (r + 1),
              ⟨Φ_G Q_s, hΦ_homog hQs⟩,
              ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩) := by
        intro s hs
        have hs_sum : (∑ i : Fin (N + 1), s i) = 3 * (r + 1) := by
          have h1 := (MvPolynomial.mem_homogeneousSubmodule (3 * (r + 1)) P).mp hP
            (MvPolynomial.mem_support_iff.mp hs)
          simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using h1
        have hms : MvPolynomial.monomial s (P.coeff s) ∈ 𝒜_N (3 * (r + 1)) :=
          hMonomHomog s (P.coeff s) hs_sum
        obtain ⟨u, v, w, d₃, hd₃_sum, hmon_eq⟩ := hPeel3 r s (P.coeff s) hs_sum
        let P₃ := MvPolynomial.monomial d₃ (P.coeff s)
        have hP₃ : P₃ ∈ 𝒜_N (3 * r) := hMonomHomog d₃ (P.coeff s) hd₃_sum
        let M₃ : MvPolynomial (Fin (N + 1)) k :=
          MvPolynomial.X u * MvPolynomial.X v * MvPolynomial.X w
        have hM₃ : M₃ ∈ 𝒜_N 3 := hTripleHomog u v w
        obtain ⟨Q₃, hQ₃, hQ₃_eq⟩ := ih P₃ hP₃
        obtain ⟨L₁, hL₁, hL₁_van⟩ := hProjCubic M₃ hM₃
        let Q_s := Q₃ * L₁
        have hQs : Q_s ∈ 𝒜_M (r + 1) := SetLike.mul_mem_graded hQ₃ hL₁
        have hΦL₁ : Φ_G L₁ ∈ 𝒜_N 3 := by simpa using hΦ_homog hL₁
        let F_van := M₃ - Φ_G L₁
        have hFvan_hom : F_van ∈ 𝒜_N 3 := sub_mem hM₃ hΦL₁
        have hProd_hom : F_van * P₃ ∈ 𝒜_N (3 * (r + 1)) := by
          have h1 : F_van * P₃ ∈ 𝒜_N (3 + 3 * r) := SetLike.mul_mem_graded hFvan_hom hP₃
          simpa [Nat.mul_succ, Nat.add_comm] using h1
        have hProd_van : F_van * P₃ ∈ J_van := J_van.mul_mem_right P₃ hL₁_van
        have hVan_term : φ_V (HomogeneousLocalization.mk ⟨3 * (r + 1),
            ⟨F_van * P₃, hProd_hom⟩, ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩) = 0 :=
          hNilVanish (hG α) (by decide : 0 < 3) hProd_hom (by omega) hProd_van
            (r + 1) rfl hGr1 V hAffV hVG
        refine ⟨Q_s, hQs, hms, ?_⟩
        have hAlg_away :
            HomogeneousLocalization.mk ⟨3 * (r + 1),
              ⟨MvPolynomial.monomial s (P.coeff s), hms⟩,
              ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩ -
            HomogeneousLocalization.mk ⟨3 * (r + 1),
              ⟨Φ_G Q_s, hΦ_homog hQs⟩,
              ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩ =
            HomogeneousLocalization.mk ⟨3 * (r + 1),
              ⟨F_van * P₃, hProd_hom⟩, ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩ +
            (HomogeneousLocalization.mk ⟨3 * r, ⟨P₃, hP₃⟩, ⟨G_coord α ^ r, hGr⟩, hmem_r⟩ -
              HomogeneousLocalization.mk ⟨3 * r, ⟨Φ_G Q₃, hΦ_homog hQ₃⟩, ⟨G_coord α ^ r, hGr⟩, hmem_r⟩) *
              HomogeneousLocalization.mk ⟨3, ⟨Φ_G L₁, hΦL₁⟩, ⟨G_coord α, hG α⟩, hmem_1⟩ := by
          apply HomogeneousLocalization.val_injective
          simp only [HomogeneousLocalization.val_sub, HomogeneousLocalization.val_add,
            HomogeneousLocalization.val_mul, HomogeneousLocalization.val_mk]
          rw [sub_eq_add_neg, Localization.neg_mk, Localization.add_mk_self,
            sub_eq_add_neg, Localization.neg_mk, Localization.add_mk_self,
            Localization.mk_mul]
          have hden_mul : (⟨G_coord α ^ r, hmem_r⟩ : Submonoid.powers (G_coord α)) *
              ⟨G_coord α, hmem_1⟩ = ⟨G_coord α ^ (r + 1), hmem_r1⟩ :=
            Subtype.ext (pow_succ (G_coord α) r).symm
          rw [hden_mul, Localization.add_mk_self]
          refine congrArg (fun x => Localization.mk x _) ?_
          dsimp only [Q_s, F_van, P₃, M₃] at hmon_eq ⊢
          rw [hmon_eq, map_mul]
          ring
        rw [← sub_eq_zero, ← map_sub, hAlg_away, map_add, hVan_term, zero_add,
          map_mul, map_sub, sub_eq_zero.mpr hQ₃_eq, zero_mul]
      let Q_pick : ∀ s ∈ P.support, MvPolynomial (Fin (M + 1)) k :=
        fun s hs => Classical.choose (hMonLift s hs)
      have hQ_pick_mem : ∀ s (hs : s ∈ P.support), Q_pick s hs ∈ 𝒜_M (r + 1) :=
        fun s hs => (Classical.choose_spec (hMonLift s hs)).1
      let Q : MvPolynomial (Fin (M + 1)) k := ∑ s ∈ P.support.attach, Q_pick s.1 s.2
      have hQ : Q ∈ 𝒜_M (r + 1) :=
        Submodule.sum_mem _ fun s _ => hQ_pick_mem s.1 s.2
      refine ⟨Q, hQ, ?_⟩
      change φ_V (HomogeneousLocalization.mk ⟨3 * (r + 1), ⟨P, hP⟩,
          ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩) =
        φ_V (HomogeneousLocalization.mk ⟨3 * (r + 1), ⟨Φ_G Q, hΦ_homog hQ⟩,
          ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩)
      have hSum_mk : ∀ (S_fin : Finset {s // s ∈ P.support}),
          let P_part := ∑ s ∈ S_fin, MvPolynomial.monomial s.1 (P.coeff s.1)
          let Q_part := ∑ s ∈ S_fin, Q_pick s.1 s.2
          have hP_part : P_part ∈ 𝒜_N (3 * (r + 1)) :=
            Submodule.sum_mem _ fun s _ => (Classical.choose_spec (hMonLift s.1 s.2)).2.1
          have hQ_part : Q_part ∈ 𝒜_M (r + 1) :=
            Submodule.sum_mem _ fun s _ => hQ_pick_mem s.1 s.2
          φ_V (HomogeneousLocalization.mk ⟨3 * (r + 1), ⟨P_part, hP_part⟩,
            ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩) =
          φ_V (HomogeneousLocalization.mk ⟨3 * (r + 1), ⟨Φ_G Q_part, hΦ_homog hQ_part⟩,
            ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩) := by
        intro S_fin
        induction S_fin using Finset.induction_on with
        | empty =>
          simp only [Finset.sum_empty, map_zero]
        | @insert a S_fin ha ih_S =>
          simp only [Finset.sum_insert ha]
          have hmk_add : ∀ (A₁ A₂ : MvPolynomial (Fin (N + 1)) k)
              (hA₁ : A₁ ∈ 𝒜_N (3 * (r + 1))) (hA₂ : A₂ ∈ 𝒜_N (3 * (r + 1)))
              (hA12 : A₁ + A₂ ∈ 𝒜_N (3 * (r + 1))),
              HomogeneousLocalization.mk ⟨3 * (r + 1), ⟨A₁ + A₂, hA12⟩,
                ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩ =
              HomogeneousLocalization.mk ⟨3 * (r + 1), ⟨A₁, hA₁⟩,
                ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩ +
              HomogeneousLocalization.mk ⟨3 * (r + 1), ⟨A₂, hA₂⟩,
                ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩ := by
            intro A₁ A₂ hA₁ hA₂ hA12
            apply HomogeneousLocalization.val_injective
            rw [HomogeneousLocalization.val_add, HomogeneousLocalization.val_mk,
              HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
            exact (Localization.add_mk_self _ _ _).symm
          have hP_a := (Classical.choose_spec (hMonLift a.1 a.2)).2.1
          have hP_S : (∑ s ∈ S_fin, MvPolynomial.monomial s.1 (P.coeff s.1)) ∈ 𝒜_N (3 * (r + 1)) :=
            Submodule.sum_mem _ fun s _ => (Classical.choose_spec (hMonLift s.1 s.2)).2.1
          have hQ_a := hQ_pick_mem a.1 a.2
          have hQ_S : (∑ s ∈ S_fin, Q_pick s.1 s.2) ∈ 𝒜_M (r + 1) :=
            Submodule.sum_mem _ fun s _ => hQ_pick_mem s.1 s.2
          have hΦ_add : HomogeneousLocalization.mk ⟨3 * (r + 1),
              ⟨Φ_G (Q_pick a.1 a.2 + ∑ s ∈ S_fin, Q_pick s.1 s.2),
                hΦ_homog (add_mem hQ_a hQ_S)⟩,
              ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩ =
              HomogeneousLocalization.mk ⟨3 * (r + 1),
                ⟨Φ_G (Q_pick a.1 a.2) + Φ_G (∑ s ∈ S_fin, Q_pick s.1 s.2),
                  add_mem (hΦ_homog hQ_a) (hΦ_homog hQ_S)⟩,
                ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩ := by
            apply HomogeneousLocalization.val_injective
            rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
            exact congrArg (fun x => Localization.mk x _) (map_add Φ_G _ _)
          rw [hmk_add _ _ hP_a hP_S _, hΦ_add, hmk_add _ _ (hΦ_homog hQ_a) (hΦ_homog hQ_S) _,
            map_add, map_add, (Classical.choose_spec (hMonLift a.1 a.2)).2.2, ih_S]
      have hP_eq : ∑ s ∈ P.support.attach, MvPolynomial.monomial s.1 (P.coeff s.1) = P := by
        rw [Finset.sum_attach P.support (fun s => MvPolynomial.monomial s (P.coeff s))]
        exact P.as_sum.symm
      have hmk_P : HomogeneousLocalization.mk ⟨3 * (r + 1), ⟨P, hP⟩,
          ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩ =
          HomogeneousLocalization.mk ⟨3 * (r + 1),
            ⟨∑ s ∈ P.support.attach, MvPolynomial.monomial s.1 (P.coeff s.1),
              Submodule.sum_mem _ fun s _ => (Classical.choose_spec (hMonLift s.1 s.2)).2.1⟩,
            ⟨G_coord α ^ (r + 1), hGr1⟩, hmem_r1⟩ := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
        exact congrArg (fun x => Localization.mk x _) hP_eq.symm
      rw [hmk_P]
      exact hSum_mk P.support.attach

  
  obtain ⟨veroneseLocMap, hVeronese_val⟩ :
      ∃ (veroneseLocMap : ∀ {S : Submonoid (MvPolynomial (Fin (M + 1)) k)}
          {T : Submonoid (MvPolynomial (Fin (N + 1)) k)}
          (_ : S ≤ T.comap Φ_G),
          HomogeneousLocalization 𝒜_M S →+* HomogeneousLocalization 𝒜_N T),
        ∀ {S : Submonoid (MvPolynomial (Fin (M + 1)) k)}
          {T : Submonoid (MvPolynomial (Fin (N + 1)) k)}
          (hST : S ≤ T.comap Φ_G) (x : HomogeneousLocalization 𝒜_M S),
          (veroneseLocMap hST x).val = IsLocalization.map (Localization T) Φ_G hST x.val := by
    refine ⟨fun {S} {T} hST =>
      let L_map : Localization S →+* Localization T :=
        IsLocalization.map (Localization T) Φ_G hST
      let f_fun : HomogeneousLocalization 𝒜_M S → HomogeneousLocalization 𝒜_N T := fun x =>
        let nd := Classical.choose (HomogeneousLocalization.mk_surjective x)
        HomogeneousLocalization.mk
          ⟨3 * nd.deg, ⟨Φ_G nd.num.1, hΦ_homog nd.num.2⟩,
            ⟨Φ_G nd.den.1, hΦ_homog nd.den.2⟩, Submonoid.mem_comap.mp (hST nd.den_mem)⟩
      have hf_val : ∀ x : HomogeneousLocalization 𝒜_M S, (f_fun x).val = L_map x.val := by
        intro x
        let nd := Classical.choose (HomogeneousLocalization.mk_surjective x)
        have hnd : HomogeneousLocalization.mk nd = x :=
          Classical.choose_spec (HomogeneousLocalization.mk_surjective x)
        change (HomogeneousLocalization.mk
          ⟨3 * nd.deg, ⟨Φ_G nd.num.1, hΦ_homog nd.num.2⟩,
            ⟨Φ_G nd.den.1, hΦ_homog nd.den.2⟩, Submonoid.mem_comap.mp (hST nd.den_mem)⟩).val =
          IsLocalization.map (Localization T) Φ_G hST x.val
        rw [← hnd, HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
        dsimp only
        rw [Localization.mk_eq_mk', Localization.mk_eq_mk', IsLocalization.map_mk']
      { toFun := f_fun
        map_one' := HomogeneousLocalization.val_injective T (by
          rw [hf_val, HomogeneousLocalization.val_one, map_one, HomogeneousLocalization.val_one])
        map_mul' := fun x y => HomogeneousLocalization.val_injective T (by
          rw [hf_val, HomogeneousLocalization.val_mul, map_mul, ← hf_val, ← hf_val,
            HomogeneousLocalization.val_mul])
        map_zero' := HomogeneousLocalization.val_injective T (by
          rw [hf_val, HomogeneousLocalization.val_zero, map_zero, HomogeneousLocalization.val_zero])
        map_add' := fun x y => HomogeneousLocalization.val_injective T (by
          rw [hf_val, HomogeneousLocalization.val_add, map_add, ← hf_val, ← hf_val,
            HomogeneousLocalization.val_add]) }, ?_⟩
    intro S T hST x
    let nd := Classical.choose (HomogeneousLocalization.mk_surjective x)
    have hnd : HomogeneousLocalization.mk nd = x :=
      Classical.choose_spec (HomogeneousLocalization.mk_surjective x)
    change (HomogeneousLocalization.mk
      ⟨3 * nd.deg, ⟨Φ_G nd.num.1, hΦ_homog nd.num.2⟩,
        ⟨Φ_G nd.den.1, hΦ_homog nd.den.2⟩, Submonoid.mem_comap.mp (hST nd.den_mem)⟩).val =
      IsLocalization.map (Localization T) Φ_G hST x.val
    rw [← hnd, HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
    dsimp only
    rw [Localization.mk_eq_mk', Localization.mk_eq_mk', IsLocalization.map_mk']

  have hPowers_sub : ∀ (P : MvPolynomial (Fin (M + 1)) k) (Q : MvPolynomial (Fin (N + 1)) k),
      Φ_G P = Q → Submonoid.powers P ≤ (Submonoid.powers Q).comap Φ_G := by
    intro P Q hPQ s hs
    rcases hs with ⟨n, rfl⟩
    change Φ_G (P ^ n) ∈ Submonoid.powers Q
    rw [map_pow, hPQ]
    exact ⟨n, rfl⟩

  let θ : ∀ α : Fin (M + 1),
      HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α) →+*
        HomogeneousLocalization.Away 𝒜_N (G_coord α) :=
    fun α => veroneseLocMap (hPowers_sub (MvPolynomial.X α) (G_coord α) (MvPolynomial.eval₂Hom_X' _ _ α))

  let θ_ov : ∀ α α' : Fin (M + 1),
      HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α * MvPolynomial.X α') →+*
        HomogeneousLocalization.Away 𝒜_N (G_coord α * G_coord α') :=
    fun α α' => veroneseLocMap (hPowers_sub (MvPolynomial.X α * MvPolynomial.X α')
      (G_coord α * G_coord α') (by
        rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']))

  have hθ_mk : ∀ (α : Fin (M + 1)) {d : ℕ} (P : MvPolynomial (Fin (M + 1)) k) (hP : P ∈ 𝒜_M d)
      (r : ℕ) (hXr : MvPolynomial.X α ^ r ∈ 𝒜_M d) (hGr : G_coord α ^ r ∈ 𝒜_N (3 * d)),
      θ α (HomogeneousLocalization.mk ⟨d, ⟨P, hP⟩, ⟨MvPolynomial.X α ^ r, hXr⟩,
        pow_mem (Submonoid.mem_powers (MvPolynomial.X α)) r⟩) =
        HomogeneousLocalization.mk ⟨3 * d, ⟨Φ_G P, hΦ_homog hP⟩, ⟨G_coord α ^ r, hGr⟩,
          pow_mem (Submonoid.mem_powers (G_coord α)) r⟩ := by
    intro α d P hP r hXr hGr
    apply HomogeneousLocalization.val_injective
    rw [hVeronese_val, HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
    dsimp only
    rw [Localization.mk_eq_mk', IsLocalization.map_mk', ← Localization.mk_eq_mk']
    refine congrArg (Localization.mk _) (Subtype.ext ?_)
    change Φ_G (MvPolynomial.X α ^ r) = G_coord α ^ r
    rw [map_pow, MvPolynomial.eval₂Hom_X']

  have hAway_comm : ∀ {f g x : MvPolynomial (Fin (M + 1)) k} {e : ℕ}
      (hg : g ∈ 𝒜_M e) (hx : x = f * g)
      {f' g' x' : MvPolynomial (Fin (N + 1)) k}
      (hg' : g' ∈ 𝒜_N (3 * e)) (hx' : x' = f' * g')
      (hf_eq : Φ_G f = f') (hg_eq : Φ_G g = g') (hx_eq : Φ_G x = x')
      (z : HomogeneousLocalization.Away 𝒜_M f),
      veroneseLocMap (hPowers_sub x x' hx_eq) (HomogeneousLocalization.awayMap 𝒜_M hg hx z) =
        HomogeneousLocalization.awayMap 𝒜_N hg' hx' (veroneseLocMap (hPowers_sub f f' hf_eq) z) := by
    intro f g x e hg hx f' g' x' hg' hx' hf_eq hg_eq hx_eq z
    obtain ⟨nd, rfl⟩ := HomogeneousLocalization.mk_surjective z
    rcases nd.den_mem with ⟨i, hi⟩
    have hi' : f ^ i = nd.den.1 := hi
    have hfi : f ^ i ∈ 𝒜_M nd.deg := by
      rw [hi']
      exact nd.den.2
    have hf'i : f' ^ i ∈ 𝒜_N (3 * nd.deg) := by
      rw [← hf_eq, ← map_pow]
      exact hΦ_homog hfi
    have hnd_eq : (HomogeneousLocalization.mk nd : HomogeneousLocalization.Away 𝒜_M f) =
        HomogeneousLocalization.mk ⟨nd.deg, nd.num, ⟨f ^ i, hfi⟩,
          pow_mem (Submonoid.mem_powers f) i⟩ := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
      exact congrArg (Localization.mk _) (Subtype.ext hi'.symm)
    have hmap_nd : veroneseLocMap (hPowers_sub f f' hf_eq)
        (HomogeneousLocalization.mk ⟨nd.deg, nd.num, ⟨f ^ i, hfi⟩,
          pow_mem (Submonoid.mem_powers f) i⟩) =
        HomogeneousLocalization.mk ⟨3 * nd.deg, ⟨Φ_G nd.num.1, hΦ_homog nd.num.2⟩,
          ⟨f' ^ i, hf'i⟩, pow_mem (Submonoid.mem_powers f') i⟩ := by
      apply HomogeneousLocalization.val_injective
      rw [hVeronese_val, HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
      dsimp only
      rw [Localization.mk_eq_mk', IsLocalization.map_mk', ← Localization.mk_eq_mk']
      refine congrArg (Localization.mk _) (Subtype.ext ?_)
      change Φ_G (f ^ i) = f' ^ i
      rw [map_pow, hf_eq]
    rw [hnd_eq]
    apply HomogeneousLocalization.val_injective
    rw [hVeronese_val, HomogeneousLocalization.val_awayMap_mk, hmap_nd,
      HomogeneousLocalization.val_awayMap_mk]
    rw [Localization.mk_eq_mk', IsLocalization.map_mk', ← Localization.mk_eq_mk']
    have hnum_eq : Φ_G (nd.num.1 * g ^ i) = Φ_G nd.num.1 * g' ^ i := by
      rw [map_mul, map_pow, hg_eq]
    refine congrArg₂ Localization.mk hnum_eq (Subtype.ext ?_)
    change Φ_G (x ^ i) = x' ^ i
    rw [map_pow, hx_eq]

  have hXM : ∀ α : Fin (M + 1), (MvPolynomial.X α : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1 :=
    fun α => MvPolynomial.isHomogeneous_X k α
  let D_N : Fin (M + 1) → (AlgebraicGeometry.Proj 𝒜_N).Opens :=
    fun α => AlgebraicGeometry.Proj.basicOpen 𝒜_N (G_coord α)
  let D_M : Fin (M + 1) → (AlgebraicGeometry.Proj 𝒜_M).Opens :=
    fun α => AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X α)
  let W : Fin (M + 1) → Z_bar.left.Opens :=
    fun α => (TopologicalSpace.Opens.map f₀.base).obj (D_N α)

  let π_tilde : ∀ α : Fin (M + 1), (D_N α).toScheme ⟶ AlgebraicGeometry.Proj 𝒜_M :=
    fun α =>
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (G_coord α) (hG α) (by decide : 0 < 3)).hom ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ α)) ≫
      AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X α) (hXM α) zero_lt_one

  have hπ_tilde_ov : ∀ α α' : Fin (M + 1),
      (AlgebraicGeometry.Proj 𝒜_N).homOfLE (inf_le_left : D_N α ⊓ D_N α' ≤ D_N α) ≫ π_tilde α =
      (AlgebraicGeometry.Proj 𝒜_N).homOfLE (inf_le_right : D_N α ⊓ D_N α' ≤ D_N α') ≫ π_tilde α' := by
    intro α α'
    have hmul_N : AlgebraicGeometry.Proj.basicOpen 𝒜_N (G_coord α * G_coord α') = D_N α ⊓ D_N α' :=
      AlgebraicGeometry.Proj.basicOpen_mul 𝒜_N (G_coord α) (G_coord α')
    have hG_mul : G_coord α * G_coord α' ∈ 𝒜_N (3 + 3) :=
      SetLike.mul_mem_graded (hG α) (hG α')
    have hX_mul : (MvPolynomial.X α * MvPolynomial.X α' : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M (1 + 1) :=
      SetLike.mul_mem_graded (hXM α) (hXM α')
    let iso_ov := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N
      (G_coord α * G_coord α') hG_mul (by decide : 0 < 3 + 3)
    let common : (AlgebraicGeometry.Proj.basicOpen 𝒜_N (G_coord α * G_coord α')).toScheme ⟶
        AlgebraicGeometry.Proj 𝒜_M :=
      iso_ov.hom ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_ov α α')) ≫
      AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X α * MvPolynomial.X α') hX_mul (by decide : 0 < 1 + 1)
    have hL_eq : (AlgebraicGeometry.Proj 𝒜_N).homOfLE (hmul_N.le.trans inf_le_left) ≫ π_tilde α =
        common := by
      dsimp only [π_tilde, common, iso_ov]
      rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_hom, AlgebraicGeometry.Proj.basicOpenIsoSpec_hom,
        ← CategoryTheory.Category.assoc ((AlgebraicGeometry.Proj 𝒜_N).homOfLE _),
        ← AlgebraicGeometry.Proj.basicOpenToSpec_SpecMap_awayMap 𝒜_N (hG α') rfl,
        CategoryTheory.Category.assoc]
      congr 1
      have hcomm1 : CommRingCat.ofHom (θ α) ≫
          CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜_N (hG α') rfl) =
          CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜_M (hXM α') rfl) ≫
          CommRingCat.ofHom (θ_ov α α') := by
        ext z
        exact congrArg HomogeneousLocalization.val ((hAway_comm (hXM α') rfl (hG α') rfl
          (MvPolynomial.eval₂Hom_X' _ _ α) (MvPolynomial.eval₂Hom_X' _ _ α')
          (by rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']) z).symm)
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hcomm1,
        AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜_M (hXM α) zero_lt_one (hXM α') rfl]
    have hR_eq : (AlgebraicGeometry.Proj 𝒜_N).homOfLE (hmul_N.le.trans inf_le_right) ≫ π_tilde α' =
        common := by
      dsimp only [π_tilde, common, iso_ov]
      rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_hom, AlgebraicGeometry.Proj.basicOpenIsoSpec_hom,
        ← CategoryTheory.Category.assoc ((AlgebraicGeometry.Proj 𝒜_N).homOfLE _),
        ← AlgebraicGeometry.Proj.basicOpenToSpec_SpecMap_awayMap 𝒜_N (hG α) (mul_comm (G_coord α) (G_coord α')),
        CategoryTheory.Category.assoc]
      congr 1
      have hcomm2 : CommRingCat.ofHom (θ α') ≫
          CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜_N (hG α) (mul_comm (G_coord α) (G_coord α'))) =
          CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜_M (hXM α) (mul_comm _ _)) ≫
          CommRingCat.ofHom (θ_ov α α') := by
        ext z
        exact congrArg HomogeneousLocalization.val ((hAway_comm (hXM α) (mul_comm _ _) (hG α) (mul_comm _ _)
          (MvPolynomial.eval₂Hom_X' _ _ α') (MvPolynomial.eval₂Hom_X' _ _ α)
          (by rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']) z).symm)
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hcomm2,
        AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜_M (hXM α') zero_lt_one (hXM α) (mul_comm _ _)]
    let hIsoOv := (AlgebraicGeometry.Proj 𝒜_N).isoOfEq hmul_N
    rw [← CategoryTheory.cancel_epi hIsoOv.hom]
    have hl : hIsoOv.hom ≫ (AlgebraicGeometry.Proj 𝒜_N).homOfLE inf_le_left =
        (AlgebraicGeometry.Proj 𝒜_N).homOfLE (hmul_N.le.trans inf_le_left) := by
      dsimp only [hIsoOv]
      rw [← CategoryTheory.cancel_mono (D_N α).ι, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.isoOfEq_hom_ι,
        AlgebraicGeometry.Scheme.homOfLE_ι]
    have hr : hIsoOv.hom ≫ (AlgebraicGeometry.Proj 𝒜_N).homOfLE inf_le_right =
        (AlgebraicGeometry.Proj 𝒜_N).homOfLE (hmul_N.le.trans inf_le_right) := by
      dsimp only [hIsoOv]
      rw [← CategoryTheory.cancel_mono (D_N α').ι, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.isoOfEq_hom_ι,
        AlgebraicGeometry.Scheme.homOfLE_ι]
    rw [← CategoryTheory.Category.assoc, hl, hL_eq, ← CategoryTheory.Category.assoc, hr, hR_eq]

  
  let W_u : ULift.{u} (Fin (M + 1)) → Z_bar.left.Opens := fun i => W i.down
  have hWu_cov : TopologicalSpace.IsOpenCover W_u := by
    rw [TopologicalSpace.IsOpenCover, eq_top_iff]
    intro z _
    obtain ⟨α, hzα⟩ := hBp z
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨ULift.up α, hzα⟩
  let 𝒰 : Z_bar.left.OpenCover := Z_bar.left.openCoverOfIsOpenCover W_u hWu_cov
  let π_loc : ∀ α : Fin (M + 1), (W α).toScheme ⟶ AlgebraicGeometry.Proj 𝒜_M :=
    fun α => (f₀ ∣_ D_N α) ≫ π_tilde α
  let π_u : ∀ i : 𝒰.I₀, 𝒰.X i ⟶ AlgebraicGeometry.Proj 𝒜_M :=
    fun i => π_loc i.down

  have hGlue_cocycle : ∀ i j : 𝒰.I₀,
      CategoryTheory.Limits.pullback.fst (𝒰.f i) (𝒰.f j) ≫ π_u i =
      CategoryTheory.Limits.pullback.snd (𝒰.f i) (𝒰.f j) ≫ π_u j := by
    intro i j
    let α := i.down
    let α' := j.down
    change CategoryTheory.Limits.pullback.fst (W α).ι (W α').ι ≫ π_loc α =
      CategoryTheory.Limits.pullback.snd (W α).ι (W α').ι ≫ π_loc α'
    let p₁ := CategoryTheory.Limits.pullback.fst (W α).ι (W α').ι
    let p₂ := CategoryTheory.Limits.pullback.snd (W α).ι (W α').ι
    have hcond : p₁ ≫ (W α).ι = p₂ ≫ (W α').ι := CategoryTheory.Limits.pullback.condition
    have hrange : Set.range (p₁ ≫ (W α).ι).base ⊆ Set.range (W α ⊓ W α').ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      have hx1 : (p₁ ≫ (W α).ι).base x ∈ W α := (p₁.base x).2
      have hx2 : (p₁ ≫ (W α).ι).base x ∈ W α' := by
        rw [hcond]
        exact (p₂.base x).2
      exact ⟨hx1, hx2⟩
    let lam := AlgebraicGeometry.IsOpenImmersion.lift (W α ⊓ W α').ι (p₁ ≫ (W α).ι) hrange
    have hlam : lam ≫ (W α ⊓ W α').ι = p₁ ≫ (W α).ι :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (W α ⊓ W α').ι (p₁ ≫ (W α).ι) hrange
    have hp₁ : p₁ = lam ≫ Z_bar.left.homOfLE inf_le_left := by
      rw [← CategoryTheory.cancel_mono (W α).ι, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, hlam]
    have hp₂ : p₂ = lam ≫ Z_bar.left.homOfLE inf_le_right := by
      rw [← CategoryTheory.cancel_mono (W α').ι, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, hlam, hcond]
    have h_ov : W α ⊓ W α' ≤
        (TopologicalSpace.Opens.map f₀.base).obj (D_N α ⊓ D_N α') := le_rfl
    have hres_L : Z_bar.left.homOfLE (inf_le_left : W α ⊓ W α' ≤ W α) ≫ (f₀ ∣_ D_N α) =
        f₀.resLE (D_N α ⊓ D_N α') (W α ⊓ W α') h_ov ≫
          (AlgebraicGeometry.Proj 𝒜_N).homOfLE (inf_le_left : D_N α ⊓ D_N α' ≤ D_N α) := by
      rw [← CategoryTheory.cancel_mono (D_N α).ι, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
        ← CategoryTheory.Category.assoc]
      change (Z_bar.left.homOfLE _ ≫ (W α).ι) ≫ f₀ = (W α ⊓ W α').ι ≫ f₀
      rw [AlgebraicGeometry.Scheme.homOfLE_ι]
    have hres_R : Z_bar.left.homOfLE (inf_le_right : W α ⊓ W α' ≤ W α') ≫ (f₀ ∣_ D_N α') =
        f₀.resLE (D_N α ⊓ D_N α') (W α ⊓ W α') h_ov ≫
          (AlgebraicGeometry.Proj 𝒜_N).homOfLE (inf_le_right : D_N α ⊓ D_N α' ≤ D_N α') := by
      rw [← CategoryTheory.cancel_mono (D_N α').ι, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
        ← CategoryTheory.Category.assoc]
      change (Z_bar.left.homOfLE _ ≫ (W α').ι) ≫ f₀ = (W α ⊓ W α').ι ≫ f₀
      rw [AlgebraicGeometry.Scheme.homOfLE_ι]
    change p₁ ≫ π_loc α = p₂ ≫ π_loc α'
    dsimp only [π_loc]
    rw [hp₁, hp₂, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc (Z_bar.left.homOfLE inf_le_left), hres_L,
      ← CategoryTheory.Category.assoc (Z_bar.left.homOfLE inf_le_right), hres_R,
      CategoryTheory.Category.assoc (f₀.resLE _ _ _),
      CategoryTheory.Category.assoc (f₀.resLE _ _ _), hπ_tilde_ov α α']

  obtain ⟨ι_bar_left, hι_chart⟩ :
      ∃ (ι_bar_left : Z_bar.left ⟶ AlgebraicGeometry.Proj 𝒜_M),
        ∀ α : Fin (M + 1), (W α).ι ≫ ι_bar_left = π_loc α :=
    ⟨𝒰.glueMorphisms π_u hGlue_cocycle,
      fun α => 𝒰.ι_glueMorphisms π_u hGlue_cocycle (ULift.up α)⟩

  have hι_over : ι_bar_left ≫ (weilProjectiveSpaceOver k M).hom = Z_bar.hom := by
    apply 𝒰.hom_ext
    intro i
    let α := i.down
    change ((W α).ι ≫ ι_bar_left) ≫
      (AlgebraicGeometry.Proj.toSpecZero 𝒜_M ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_M 0)))) =
      (W α).ι ≫ Z_bar.hom
    rw [hι_chart α]
    dsimp only [π_loc, π_tilde]
    simp only [CategoryTheory.Category.assoc]
    rw [← CategoryTheory.Category.assoc (AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X α) (hXM α) zero_lt_one),
      AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_M (MvPolynomial.X α) (hXM α) zero_lt_one]
    have hZero_comm : CommRingCat.ofHom (algebraMap k ↥(𝒜_M 0)) ≫
        CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜_M (Submonoid.powers (MvPolynomial.X α))) ≫
        CommRingCat.ofHom (θ α) =
        CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0)) ≫
        CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (G_coord α))) := by
      ext c
      change (θ α (HomogeneousLocalization.fromZeroRingHom 𝒜_M (Submonoid.powers (MvPolynomial.X α))
        (algebraMap k ↥(𝒜_M 0) c))).val =
        (HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (G_coord α))
          (algebraMap k ↥(𝒜_N 0) c)).val
      rw [hVeronese_val]
      have hfz_M : (HomogeneousLocalization.fromZeroRingHom 𝒜_M
          (Submonoid.powers (MvPolynomial.X α)) (algebraMap k ↥(𝒜_M 0) c)).val =
          Localization.mk (MvPolynomial.C c) 1 := by
        change Localization.mk (algebraMap k (MvPolynomial (Fin (M + 1)) k) c) 1 =
          Localization.mk (MvPolynomial.C c) 1
        rw [MvPolynomial.algebraMap_eq]
      have hfz_N : (HomogeneousLocalization.fromZeroRingHom 𝒜_N
          (Submonoid.powers (G_coord α)) (algebraMap k ↥(𝒜_N 0) c)).val =
          Localization.mk (MvPolynomial.C c) 1 := by
        change Localization.mk (algebraMap k (MvPolynomial (Fin (N + 1)) k) c) 1 =
          Localization.mk (MvPolynomial.C c) 1
        rw [MvPolynomial.algebraMap_eq]
      rw [hfz_M, hfz_N, Localization.mk_eq_mk', IsLocalization.map_mk', ← Localization.mk_eq_mk']
      refine congrArg₂ Localization.mk ?_ (Subtype.ext (map_one Φ_G))
      exact MvPolynomial.eval₂Hom_C _ _ c
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      CategoryTheory.Category.assoc (CommRingCat.ofHom (algebraMap k ↥(𝒜_M 0))), hZero_comm,
      AlgebraicGeometry.Spec.map_comp,
      ← AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_N (G_coord α) (hG α) (by decide : 0 < 3),
      ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_N (G_coord α) (hG α) (by decide : 0 < 3)]
    simp only [← CategoryTheory.Category.assoc]
    rw [CategoryTheory.Category.assoc (f₀ ∣_ D_N α),
      CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.comp_id,
      AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
    exact congrArg ((W α).ι ≫ ·) ι₀.w

  let ι_bar : Z_bar ⟶ weilProjectiveSpaceOver k M :=
    CategoryTheory.Over.homMk ι_bar_left hι_over

  
  have hPre_L : ∀ (L : MvPolynomial (Fin (M + 1)) k), L ∈ 𝒜_M 1 →
      (TopologicalSpace.Opens.map ι_bar_left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_M L) =
      (TopologicalSpace.Opens.map f₀.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_N (Φ_G L)) := by
    intro L hL
    have hΦL : Φ_G L ∈ 𝒜_N 3 := by simpa using hΦ_homog hL
    have hChart_pre : ∀ α : Fin (M + 1),
        (TopologicalSpace.Opens.map (π_tilde α).base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_M L) =
        (TopologicalSpace.Opens.map (D_N α).ι.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N (Φ_G L)) := by
      intro α
      have hElem_pow : (θ α (HomogeneousLocalization.Away.isLocalizationElem (hXM α) hL)) ^ 3 =
          HomogeneousLocalization.Away.isLocalizationElem (hG α) hΦL := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.isLocalizationElem,
          HomogeneousLocalization.Away.isLocalizationElem,
          HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_pow,
          hVeronese_val, HomogeneousLocalization.Away.val_mk]
        rw [Localization.mk_eq_mk', IsLocalization.map_mk', ← Localization.mk_eq_mk']
        simp only [pow_one]
        have h3 : ∀ (a : MvPolynomial (Fin (N + 1)) k) (b : Submonoid.powers (G_coord α)),
            (Localization.mk a b) ^ 3 = Localization.mk (a ^ 3) (b ^ 3) := by
          intro a b
          rw [pow_succ, pow_succ, pow_one, Localization.mk_mul, Localization.mk_mul]
          refine congrArg₂ Localization.mk (by ring) (Subtype.ext ?_)
          push_cast
          ring
        rw [h3]
        refine congrArg (Localization.mk _) (Subtype.ext ?_)
        change (Φ_G (MvPolynomial.X α)) ^ 3 = G_coord α ^ 3
        rw [MvPolynomial.eval₂Hom_X']
      dsimp only [π_tilde]
      change (TopologicalSpace.Opens.map
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (G_coord α) (hG α) (by decide : 0 < 3)).hom.base).obj
        ((TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ α))).base).obj
          ((TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X α) (hXM α) zero_lt_one).base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_M L))) = _
      rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_M (hXM α) zero_lt_one hL zero_lt_one]
      have hSpec_pre : (TopologicalSpace.Opens.map
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ α))).base).obj
          (PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem (hXM α) hL)) =
          PrimeSpectrum.basicOpen (θ α (HomogeneousLocalization.Away.isLocalizationElem (hXM α) hL)) := by
        ext q
        exact Iff.rfl
      rw [hSpec_pre, ← PrimeSpectrum.basicOpen_pow _ 3 (by decide : 0 < 3), hElem_pow,
        ← AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_N (hG α) (by decide : 0 < 3) hΦL (by decide : 0 < 3)]
      have hι_eq : (D_N α).ι =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (G_coord α) (hG α) (by decide : 0 < 3)).hom ≫
            AlgebraicGeometry.Proj.awayι 𝒜_N (G_coord α) (hG α) (by decide : 0 < 3) := by
        rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_N (G_coord α) (hG α) (by decide : 0 < 3),
          ← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
          CategoryTheory.Category.id_comp]
      conv_rhs => rw [hι_eq]
      rfl
    ext z
    obtain ⟨α, hzα⟩ := hBp z
    let w : ↥(W α).toScheme := ⟨z, hzα⟩
    have hw_z : (W α).ι.base w = z := rfl
    have h1 : ι_bar_left.base z = (π_tilde α).base ((f₀ ∣_ D_N α).base w) := by
      have hc := congrArg (fun g : (W α).toScheme ⟶ AlgebraicGeometry.Proj 𝒜_M => g.base w) (hι_chart α)
      dsimp only [π_loc] at hc
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply, hw_z] at hc
      exact hc
    have h2 : (D_N α).ι.base ((f₀ ∣_ D_N α).base w) = f₀.base z := by
      have hc := congrArg (fun g : (W α).toScheme ⟶ AlgebraicGeometry.Proj 𝒜_N => g.base w)
        (AlgebraicGeometry.morphismRestrict_ι f₀ (D_N α))
      dsimp only at hc
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply, hw_z] at hc
      exact hc
    change ι_bar_left.base z ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M L ↔
      f₀.base z ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N (Φ_G L)
    rw [h1, ← h2]
    exact SetLike.ext_iff.mp (hChart_pre α) ((f₀ ∣_ D_N α).base w)

  have hPre_X : ∀ α : Fin (M + 1),
      (TopologicalSpace.Opens.map ι_bar_left.base).obj (D_M α) = W α := by
    intro α
    rw [hPre_L (MvPolynomial.X α) (hXM α)]
    change (TopologicalSpace.Opens.map f₀.base).obj
      (AlgebraicGeometry.Proj.basicOpen 𝒜_N (Φ_G (MvPolynomial.X α))) = W α
    rw [MvPolynomial.eval₂Hom_X']

  
  let θ_Z : ∀ α : Fin (M + 1),
      CommRingCat.of (HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X α)) ⟶
        Z_bar.left.presheaf.obj (Opposite.op (W α)) :=
    fun α =>
      CommRingCat.ofHom (θ α) ≫
      AlgebraicGeometry.Proj.awayToSection 𝒜_N (G_coord α) ≫
      f₀.appLE (D_N α) (W α) le_rfl

  have hChart_restrict_eq : ∀ α : Fin (M + 1),
      (Z_bar.left.isoOfEq (hPre_X α)).inv ≫ (ι_bar_left ∣_ D_M α) =
        (W α).toSpecΓ ≫ AlgebraicGeometry.Spec.map (θ_Z α) ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (MvPolynomial.X α) (hXM α) zero_lt_one).inv := by
    intro α
    rw [← CategoryTheory.cancel_mono (D_M α).ι]
    simp only [CategoryTheory.Category.assoc]
    rw [AlgebraicGeometry.morphismRestrict_ι, ← CategoryTheory.Category.assoc,
      AlgebraicGeometry.Scheme.isoOfEq_inv_ι]
    change (W α).ι ≫ ι_bar_left = _
    rw [hι_chart α]
    dsimp only [π_loc, π_tilde, θ_Z]
    rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_M (MvPolynomial.X α) (hXM α) zero_lt_one,
      AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp]
    simp only [← CategoryTheory.Category.assoc]
    rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE,
      AlgebraicGeometry.Scheme.Hom.resLE_eq_morphismRestrict]
    simp only [CategoryTheory.Category.assoc]
    congr 1

  have hCl_bar : AlgebraicGeometry.IsClosedImmersion ι_bar.left := by
    change AlgebraicGeometry.IsClosedImmersion ι_bar_left
    have hDM_cov : iSup D_M = ⊤ := by
      rw [eq_top_iff]
      intro y _
      obtain ⟨α, hyα⟩ := hProjCover M y
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨α, hyα⟩
    rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := @AlgebraicGeometry.IsClosedImmersion) D_M hDM_cov]
    intro α
    have hAff_DN : AlgebraicGeometry.IsAffineOpen (D_N α) :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_N (G_coord α) (hG α) (by decide : 0 < 3)
    have hAff_W : AlgebraicGeometry.IsAffineOpen (W α) := hAff_DN.preimage f₀
    have _ : CategoryTheory.IsIso (W α).toSpecΓ := by
      rw [← hAff_W.isoSpec_hom]
      infer_instance
    have hSurj_θZ : Function.Surjective (θ_Z α).hom := by
      intro y
      have happ_eq : f₀.appLE (D_N α) (W α) le_rfl = f₀.app (D_N α) := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE,
          Subsingleton.elim (CategoryTheory.homOfLE (le_rfl : W α ≤ W α)).op (𝟙 (Opposite.op (W α))),
          Z_bar.left.presheaf.map_id, CategoryTheory.Category.comp_id]
      obtain ⟨s₀, rfl⟩ := AlgebraicGeometry.Scheme.Hom.app_surjective f₀ (D_N α) hAff_DN y
      let iso_away := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (G_coord α) (hG α) (by decide : 0 < 3)
      let w : HomogeneousLocalization.Away 𝒜_N (G_coord α) := iso_away.inv.hom s₀
      have hw_sec : (AlgebraicGeometry.Proj.awayToSection 𝒜_N (G_coord α)).hom w = s₀ := by
        rw [← AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜_N (G_coord α) (hG α) (by decide : 0 < 3)]
        exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom iso_away.inv_hom_id) s₀
      obtain ⟨nd, hnd⟩ := HomogeneousLocalization.mk_surjective w
      rcases nd.den_mem with ⟨r, hr⟩
      have hden_ne : nd.den.1 ≠ 0 := by
        rw [← hr]
        exact pow_ne_zero r (hG_ne α)
      have hGr : G_coord α ^ r ∈ 𝒜_N (3 * r) :=
        (MvPolynomial.mem_homogeneousSubmodule (3 * r) _).mpr
          (((MvPolynomial.mem_homogeneousSubmodule 3 _).mp (hG α)).pow r)
      have hdeg_eq : nd.deg = 3 * r := by
        have h1 : nd.den.1.IsHomogeneous nd.deg :=
          (MvPolynomial.mem_homogeneousSubmodule nd.deg _).mp nd.den.2
        have h2 : nd.den.1.IsHomogeneous (3 * r) := by
          rw [← hr]
          exact (MvPolynomial.mem_homogeneousSubmodule (3 * r) _).mp hGr
        exact MvPolynomial.IsHomogeneous.inj_right h1 h2 hden_ne
      have hP3r : nd.num.1 ∈ 𝒜_N (3 * r) := hdeg_eq ▸ nd.num.2
      have hnd_mk : (HomogeneousLocalization.mk nd : HomogeneousLocalization.Away 𝒜_N (G_coord α)) =
          HomogeneousLocalization.mk ⟨3 * r, ⟨nd.num.1, hP3r⟩, ⟨G_coord α ^ r, hGr⟩,
            pow_mem (Submonoid.mem_powers (G_coord α)) r⟩ := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
        exact congrArg (Localization.mk _) (Subtype.ext hr.symm)
      obtain ⟨Q, hQ, hQ_eq⟩ := hDeg3r α (W α) hAff_W le_rfl r nd.num.1 hP3r
      have hXr : MvPolynomial.X α ^ r ∈ 𝒜_M r :=
        (MvPolynomial.mem_homogeneousSubmodule r _).mpr (MvPolynomial.isHomogeneous_X_pow α r)
      refine ⟨HomogeneousLocalization.mk ⟨r, ⟨Q, hQ⟩, ⟨MvPolynomial.X α ^ r, hXr⟩,
        pow_mem (Submonoid.mem_powers (MvPolynomial.X α)) r⟩, ?_⟩
      dsimp only [θ_Z]
      change (f₀.appLE (D_N α) (W α) le_rfl).hom
        ((AlgebraicGeometry.Proj.awayToSection 𝒜_N (G_coord α)).hom
          (θ α (HomogeneousLocalization.mk ⟨r, ⟨Q, hQ⟩, ⟨MvPolynomial.X α ^ r, hXr⟩,
            pow_mem (Submonoid.mem_powers (MvPolynomial.X α)) r⟩))) = _
      rw [hθ_mk α Q hQ r hXr hGr]
      change (AlgebraicGeometry.Proj.awayToSection 𝒜_N (G_coord α) ≫
        f₀.appLE (D_N α) (W α) le_rfl).hom _ = _
      rw [← hQ_eq, ← hnd_mk, hnd]
      change (f₀.appLE (D_N α) (W α) le_rfl).hom
        ((AlgebraicGeometry.Proj.awayToSection 𝒜_N (G_coord α)).hom w) = _
      rw [hw_sec, happ_eq]
    have _ : AlgebraicGeometry.IsClosedImmersion (AlgebraicGeometry.Spec.map (θ_Z α)) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (θ_Z α) hSurj_θZ
    have hEq_hom : ι_bar_left ∣_ D_M α =
        (Z_bar.left.isoOfEq (hPre_X α)).hom ≫ (W α).toSpecΓ ≫
          AlgebraicGeometry.Spec.map (θ_Z α) ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (MvPolynomial.X α) (hXM α) zero_lt_one).inv := by
      rw [← hChart_restrict_eq α, ← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
        CategoryTheory.Category.id_comp]
    rw [hEq_hom]
    infer_instance

  
  have hAppLE_bridge : ∀ (α : Fin (M + 1)) (V : Z_bar.left.Opens)
      (hVα : V ≤ (TopologicalSpace.Opens.map ι_bar_left.base).obj (D_M α)),
      let hVW : V ≤ W α := hVα.trans (hPre_X α).le
