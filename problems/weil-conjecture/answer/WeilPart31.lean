                (CategoryTheory.MorphismProperty.Over.w f₂.1).symm)
            let j_E := CategoryTheory.Limits.pullback.snd Δ pair₁₂
            have : AlgebraicGeometry.IsOpenImmersion j_E := inferInstance
            let E_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
              (CategoryTheory.CategoryStruct.comp j_E (G_aff.obj A₂.1).hom) inferInstance
            let j_mor : Quiver.Hom E_et (G_aff.obj A₂.1) :=
              CategoryTheory.MorphismProperty.Over.homMk j_E rfl trivial
            have hΔ_pair : CategoryTheory.CategoryStruct.comp A₁.2.1 Δ =
                CategoryTheory.CategoryStruct.comp A₂.2.1 pair₁₂ := by
              apply CategoryTheory.Limits.pullback.hom_ext
              · exact (CategoryTheory.Category.assoc A₁.2.1 Δ _).trans
                  ((congrArg (CategoryTheory.CategoryStruct.comp A₁.2.1)
                    (CategoryTheory.Limits.pullback.diagonal_fst h₁)).trans
                    ((CategoryTheory.Category.comp_id A₁.2.1).trans
                      (f₁.2.symm.trans
                        ((congrArg (CategoryTheory.CategoryStruct.comp A₂.2.1)
                          (CategoryTheory.Limits.pullback.lift_fst _ _ _)).symm.trans
                          (CategoryTheory.Category.assoc A₂.2.1 pair₁₂ _).symm))))
              · exact (CategoryTheory.Category.assoc A₁.2.1 Δ _).trans
                  ((congrArg (CategoryTheory.CategoryStruct.comp A₁.2.1)
                    (CategoryTheory.Limits.pullback.diagonal_snd h₁)).trans
                    ((CategoryTheory.Category.comp_id A₁.2.1).trans
                      (f₂.2.symm.trans
                        ((congrArg (CategoryTheory.CategoryStruct.comp A₂.2.1)
                          (CategoryTheory.Limits.pullback.lift_snd _ _ _)).symm.trans
                          (CategoryTheory.Category.assoc A₂.2.1 pair₁₂ _).symm))))
            let δ_E : { d : Quiver.Hom S_Ω E_et.left //
                CategoryTheory.CategoryStruct.comp d E_et.hom = ξ } :=
              ⟨CategoryTheory.Limits.pullback.lift A₁.2.1 A₂.2.1 hΔ_pair,
                (CategoryTheory.Category.assoc _ j_E (G_aff.obj A₂.1).hom).symm.trans
                  ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k (G_aff.obj A₂.1).hom)
                    (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans A₂.2.2)⟩
            obtain ⟨A₃, v₃, hv₃⟩ := hRefine E_et δ_E
            have hj_eq : CategoryTheory.CategoryStruct.comp j_E f₁.1.left =
                CategoryTheory.CategoryStruct.comp j_E f₂.1.left := by
              have hc := CategoryTheory.Limits.pullback.condition (f := Δ) (g := pair₁₂)
              have hc₁ : CategoryTheory.Limits.pullback.fst Δ pair₁₂ =
                  CategoryTheory.CategoryStruct.comp j_E f₁.1.left :=
                (CategoryTheory.Category.comp_id _).symm.trans
                  ((congrArg (CategoryTheory.CategoryStruct.comp _)
                    (CategoryTheory.Limits.pullback.diagonal_fst h₁).symm).trans
                    ((CategoryTheory.Category.assoc _ Δ _).symm.trans
                      ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k _) hc).trans
                        ((CategoryTheory.Category.assoc j_E pair₁₂ _).trans
                          (congrArg (CategoryTheory.CategoryStruct.comp j_E)
                            (CategoryTheory.Limits.pullback.lift_fst _ _ _))))))
              have hc₂ : CategoryTheory.Limits.pullback.fst Δ pair₁₂ =
                  CategoryTheory.CategoryStruct.comp j_E f₂.1.left :=
                (CategoryTheory.Category.comp_id _).symm.trans
                  ((congrArg (CategoryTheory.CategoryStruct.comp _)
                    (CategoryTheory.Limits.pullback.diagonal_snd h₁).symm).trans
                    ((CategoryTheory.Category.assoc _ Δ _).symm.trans
                      ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k _) hc).trans
                        ((CategoryTheory.Category.assoc j_E pair₁₂ _).trans
                          (congrArg (CategoryTheory.CategoryStruct.comp j_E)
                            (CategoryTheory.Limits.pullback.lift_snd _ _ _))))))
