      change τ (α.comp (E_top G φ) (Nat.zero_add (2 * d))) = ψ α
      rw [hCalib G φ α]
      change (ψ α * v₀) * u₀ = ψ α
      rw [mul_assoc, hv₀u₀, mul_one]
  
  have hBij_Φ : ∀ (p q : ℕ) (hpq : p + q = 2 * d) (G : 𝒞),
