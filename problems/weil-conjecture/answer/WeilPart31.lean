        refine hSheafifyIsZero S_Ω (B₀.op ⋙ H.cohomologyPresheaf 1) fun U c => ?_
        have hSub1 : Subsingleton (Abelian.Ext (Z_fun.obj (B₀.obj U)) J_inj 1) :=
