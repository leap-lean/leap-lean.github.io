    change η_add (H.equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) = _
    rw [hη_tmul 1 x, Rat.cast_one, one_mul]
  obtain ⟨η_X_std, e_X, tr_padic_X, he_X_tr, htr_fn_X, hη_X_tmul, hη_X_vX, hvX_ne, hX_span⟩ :=
    hBuildStdTrace X.left (2 * d) (H_X (2 * d)) tr_X htr_X_bij htr_X_trans
  obtain ⟨η_P_std, e_P, tr_padic_P, he_P_tr, htr_fn_P, hη_P_tmul, hη_P_vP, hvP_ne, hP_span⟩ :=
    hBuildStdTrace P (2 * (2 * d)) (H_P (2 * (2 * d))) tr_P htr_P_bij htr_P_trans
  let v_X : (H_X (2 * d)).V := (H_X (2 * d)).equiv (TensorProduct.tmul ℤ (1 : ℚ) e_X)
  let v_P : (H_P (2 * (2 * d))).V := (H_P (2 * (2 * d))).equiv (TensorProduct.tmul ℤ (1 : ℚ) e_P)
  have hy₁_mem : (fun r => p₁_tors r (e_X.1 r)) ∈ weilEtaleIntegralSystem P ℓ (2 * d) := by
    rw [hMemSys]
    intro r
    rw [hPullTrans p₁ r (2 * d) (p₁_tors (r + 1)) (p₁_tors r) (hp₁_tors (r + 1)) (hp₁_tors r),
      (hMemSys e_X.1).mp e_X.2 r]
  have hy₂_mem : (fun r => p₂_tors r (e_X.1 r)) ∈ weilEtaleIntegralSystem P ℓ (2 * d) := by
    rw [hMemSys]
    intro r
    rw [hPullTrans p₂ r (2 * d) (p₂_tors (r + 1)) (p₂_tors r) (hp₂_tors (r + 1)) (hp₂_tors r),
      (hMemSys e_X.1).mp e_X.2 r]
  let y₁_sys : ↥(weilEtaleIntegralSystem P ℓ (2 * d)) := ⟨_, hy₁_mem⟩
  let y₂_sys : ↥(weilEtaleIntegralSystem P ℓ (2 * d)) := ⟨_, hy₂_mem⟩
  have hz_prod_mem :
      (fun r => c_P_tors r (y₁_sys.1 r) (y₂_sys.1 r)) ∈ weilEtaleIntegralSystem P ℓ (2 * (2 * d)) := by
    rw [hMemSys]
    intro r
    rw [hCupTrans P r (2 * d) (2 * d) (2 * (2 * d)) h_sum (c_P_tors (r + 1)) (c_P_tors r)
        (hc_P_tors (r + 1)) (hc_P_tors r),
      (hMemSys y₁_sys.1).mp y₁_sys.2 r, (hMemSys y₂_sys.1).mp y₂_sys.2 r]
  let z_prod_sys : ↥(weilEtaleIntegralSystem P ℓ (2 * (2 * d))) := ⟨_, hz_prod_mem⟩
  have hv_P_eq : cup_P_top' (fp₁_top v_X) (fp₂_top v_X) = v_P := by
    have hfp₁_vX : fp₁_top v_X = (H_P (2 * d)).equiv (TensorProduct.tmul ℤ (1 : ℚ) y₁_sys) :=
      hp₁_lim e_X y₁_sys (fun _ => rfl)
    have hfp₂_vX : fp₂_top v_X = (H_P (2 * d)).equiv (TensorProduct.tmul ℤ (1 : ℚ) y₂_sys) :=
      hp₂_lim e_X y₂_sys (fun _ => rfl)
    have hcup_eq : cup_P_top' (fp₁_top v_X) (fp₂_top v_X) =
        (H_P (2 * (2 * d))).equiv (TensorProduct.tmul ℤ (1 : ℚ) z_prod_sys) := by
      rw [hfp₁_vX, hfp₂_vX]
      exact hc_P_lim y₁_sys y₂_sys z_prod_sys (fun _ => rfl)
    have hz_tr1 : tr_padic_P z_prod_sys = 1 :=
      PadicInt.ext_of_toZModPow.mp (fun r => by
        rw [htr_fn_P z_prod_sys r]
        change tr_P r (c_P_tors r (p₁_tors r (e_X.1 r)) (p₂_tors r (e_X.1 r))) = _
        rw [hTorsProd r (e_X.1 r) (e_X.1 r), he_X_tr r, mul_one, map_one])
    have hη1 : η_P_std (cup_P_top' (fp₁_top v_X) (fp₂_top v_X)) = 1 := by
      rw [hcup_eq, hη_P_tmul z_prod_sys, hz_tr1, PadicInt.coe_one]
    conv_lhs => rw [hP_span (cup_P_top' (fp₁_top v_X) (fp₂_top v_X))]
    rw [hη1, one_smul]
  have hγ_mem : γ_tors ∈ weilEtaleIntegralSystem P ℓ (2 * d) := (hMemSys γ_tors).mpr hγ_trans
  let γ_sys : ↥(weilEtaleIntegralSystem P ℓ (2 * d)) := ⟨γ_tors, hγ_mem⟩
  let γ_std : (H_P (2 * d)).V := (H_P (2 * d)).equiv (TensorProduct.tmul ℤ (1 : ℚ) γ_sys)
  have hw_Δ_mem : (fun r => p_Δ_tors r (γ_tors r)) ∈ weilEtaleIntegralSystem X.left ℓ (2 * d) := by
    rw [hMemSys]
    intro r
    rw [hPullTrans Δ r (2 * d) (p_Δ_tors (r + 1)) (p_Δ_tors r) (hp_Δ_tors (r + 1)) (hp_Δ_tors r),
      hγ_trans r]
  let w_Δ_sys : ↥(weilEtaleIntegralSystem X.left ℓ (2 * d)) := ⟨_, hw_Δ_mem⟩
  have hStdDiag : η_X_std (fΔ γ_std) = (Nat.card ↥W : Padic ℓ) := by
    have hfΔ_eq : fΔ γ_std = (H_X (2 * d)).equiv (TensorProduct.tmul ℤ (1 : ℚ) w_Δ_sys) :=
      hp_Δ_lim γ_sys w_Δ_sys (fun _ => rfl)
    have hw_tr : tr_padic_X w_Δ_sys = (Nat.card ↥W : PadicInt ℓ) :=
      PadicInt.ext_of_toZModPow.mp (fun r => by
        rw [htr_fn_X w_Δ_sys r, map_natCast]
        exact hTorsDiag r)
    rw [hfΔ_eq, hη_X_tmul w_Δ_sys, hw_tr, PadicInt.coe_natCast]
  have hStdGysin_tmul1 : ∀ x : ↥(weilEtaleIntegralSystem P ℓ (2 * d)),
      η_P_std (cup_P_top' γ_std ((H_P (2 * d)).equiv (TensorProduct.tmul ℤ (1 : ℚ) x))) =
        η_X_std (fΓ ((H_P (2 * d)).equiv (TensorProduct.tmul ℤ (1 : ℚ) x))) := by
    intro x
    have hz_c_mem :
        (fun r => c_P_tors r (γ_tors r) (x.1 r)) ∈ weilEtaleIntegralSystem P ℓ (2 * (2 * d)) := by
      rw [hMemSys]
      intro r
      rw [hCupTrans P r (2 * d) (2 * d) (2 * (2 * d)) h_sum (c_P_tors (r + 1)) (c_P_tors r)
          (hc_P_tors (r + 1)) (hc_P_tors r),
        hγ_trans r, (hMemSys x.1).mp x.2 r]
    have hw_Γ_mem :
        (fun r => p_Γ_tors r (x.1 r)) ∈ weilEtaleIntegralSystem X.left ℓ (2 * d) := by
      rw [hMemSys]
      intro r
      rw [hPullTrans Γ_φ r (2 * d) (p_Γ_tors (r + 1)) (p_Γ_tors r)
          (hp_Γ_tors (r + 1)) (hp_Γ_tors r),
        (hMemSys x.1).mp x.2 r]
    let z_c_sys : ↥(weilEtaleIntegralSystem P ℓ (2 * (2 * d))) := ⟨_, hz_c_mem⟩
    let w_Γ_sys : ↥(weilEtaleIntegralSystem X.left ℓ (2 * d)) := ⟨_, hw_Γ_mem⟩
    have hc_eq : cup_P_top' γ_std ((H_P (2 * d)).equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) =
        (H_P (2 * (2 * d))).equiv (TensorProduct.tmul ℤ (1 : ℚ) z_c_sys) :=
      hc_P_lim γ_sys x z_c_sys (fun _ => rfl)
    have hfΓ_eq : fΓ ((H_P (2 * d)).equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) =
        (H_X (2 * d)).equiv (TensorProduct.tmul ℤ (1 : ℚ) w_Γ_sys) :=
      hp_Γ_lim x w_Γ_sys (fun _ => rfl)
    have htr_eq : tr_padic_P z_c_sys = tr_padic_X w_Γ_sys :=
      PadicInt.ext_of_toZModPow.mp (fun r => by
        rw [htr_fn_P z_c_sys r, htr_fn_X w_Γ_sys r]
        exact hTorsGysin r (x.1 r))
    rw [hc_eq, hfΓ_eq, hη_P_tmul z_c_sys, hη_X_tmul w_Γ_sys, htr_eq]
  have hStdGysin : ∀ ξ : (H_P (2 * d)).V,
      η_P_std (cup_P_top' γ_std ξ) = η_X_std (fΓ ξ) := by
    intro ξ
    obtain ⟨t, rfl⟩ := (H_P (2 * d)).equiv.surjective ξ
    induction t using TensorProduct.induction_on with
    | zero => simp
    | tmul q x =>
      let g₁ : ℚ →+ Padic ℓ :=
        (η_P_std.comp (cup_P_top' γ_std)).toAddMonoidHom.comp
          { toFun := fun r => (H_P (2 * d)).equiv (TensorProduct.tmul ℤ r x)
            map_zero' := by rw [TensorProduct.zero_tmul, map_zero]
            map_add' := fun r₁ r₂ => by rw [TensorProduct.add_tmul, map_add] }
      let g₂ : ℚ →+ Padic ℓ :=
        (η_X_std.comp fΓ).toAddMonoidHom.comp
          { toFun := fun r => (H_P (2 * d)).equiv (TensorProduct.tmul ℤ r x)
            map_zero' := by rw [TensorProduct.zero_tmul, map_zero]
            map_add' := fun r₁ r₂ => by rw [TensorProduct.add_tmul, map_add] }
      exact hRatAddHomEq_0 g₁ g₂ (hStdGysin_tmul1 x) q
    | add t₁ t₂ ih₁ ih₂ =>
      simp only [map_add, ih₁, ih₂]
  let c : Padic ℓ := η_X v_X
  have hη_X_scale : ∀ u : (H_X (2 * d)).V, η_X u = η_X_std u * c := by
    intro u
    conv_lhs => rw [hX_span u]
    rw [map_smul, smul_eq_mul]
  have hc_ne : c ≠ 0 := by
    intro hc0
    apply hvX_ne
    apply (hB_bij (2 * d) 0 (by omega)).injective
    ext y
    simp only [LinearMap.comp_apply, map_zero, LinearMap.zero_apply]
    rw [hη_X_scale, hc0, mul_zero]
  have hη_P_vP : η_P' v_P = c * c := by
    rw [← hv_P_eq, hProdTr' v_X v_X]
  have hη_P_scale : ∀ z : (H_P (2 * (2 * d))).V, η_P' z = η_P_std z * (c * c) := by
    intro z
    conv_lhs => rw [hP_span z]
    rw [map_smul, smul_eq_mul, hη_P_vP]
  refine ⟨c⁻¹ • γ_std, ?_, ?_⟩
  · intro ξ
    rw [map_smul, LinearMap.smul_apply, map_smul, smul_eq_mul,
      hη_P_scale (cup_P_top' γ_std ξ), hStdGysin ξ, hη_X_scale (fΓ ξ)]
    calc
      c⁻¹ * (η_X_std (fΓ ξ) * (c * c)) = (c⁻¹ * c) * (η_X_std (fΓ ξ) * c) := by ring
      _ = 1 * (η_X_std (fΓ ξ) * c) := by rw [inv_mul_cancel₀ hc_ne]
      _ = η_X_std (fΓ ξ) * c := one_mul _
  · rw [map_smul, map_smul, smul_eq_mul, hη_X_scale (fΔ γ_std), hStdDiag]
    calc
      c⁻¹ * ((Nat.card ↥W : Padic ℓ) * c) = (c⁻¹ * c) * (Nat.card ↥W : Padic ℓ) := by ring
      _ = 1 * (Nat.card ↥W : Padic ℓ) := by rw [inv_mul_cancel₀ hc_ne]
      _ = (Nat.card ↥W : Padic ℓ) := one_mul _

theorem weil_etale_lefschetz_fixed_point_trace (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.GeometricallyIrreducible Z.hom]
    [AlgebraicGeometry.IsProper Z.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d Z.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar K)
    (M : ∀ i : ℕ, WeilEllAdicCohomologyModel K Z ℓ i)
    (n : ℕ) (hn : 1 ≤ n) :
    (Nat.card { x : ↥(weilGeomScheme K Z) //
      IsClosed ({x} : Set ↥(weilGeomScheme K Z)) ∧
      (⇑(weilGeomFrobHom K Z).base)^[n] x = x } : Padic ℓ) =
    ∑ i ∈ Finset.Iic (2 * d),
      (-1) ^ i * LinearMap.trace (Padic ℓ) (M i).V ((M i).frob ^ n) :=
by
  
  have h_engine : ∀ (V_X V_P : ℕ → Type u)
      [∀ i, AddCommGroup (V_X i)] [∀ i, Module (Padic ℓ) (V_X i)]
      [∀ i, Module.Finite (Padic ℓ) (V_X i)]
      [∀ i, AddCommGroup (V_P i)] [∀ i, Module (Padic ℓ) (V_P i)]
      (Φ : ∀ i : ℕ, V_X i →ₗ[Padic ℓ] V_X i)
      (fp₁ fp₂ : ∀ i : ℕ, V_X i →ₗ[Padic ℓ] V_P i)
      (fΔ fΓ : V_P (2 * d) →ₗ[Padic ℓ] V_X (2 * d))
      (cup_X : ∀ (a b c : ℕ), a + b = c → V_X a →ₗ[Padic ℓ] V_X b →ₗ[Padic ℓ] V_X c)
      (cup_P : ∀ (a b c : ℕ), a + b = c → V_P a →ₗ[Padic ℓ] V_P b →ₗ[Padic ℓ] V_P c),
      (∀ (a b c : ℕ) (hab : a + b = c) (hba : b + a = c) (x : V_X a) (y : V_X b),
        cup_X a b c hab x y = ((-1 : Padic ℓ) ^ (a * b)) • cup_X b a c hba y x) →
      (∀ (a b c : ℕ) (hab : a + b = c) (hba : b + a = c) (x : V_P a) (y : V_P b),
        cup_P a b c hab x y = ((-1 : Padic ℓ) ^ (a * b)) • cup_P b a c hba y x) →
      (∀ (a b c ab bc abc : ℕ)
        (hab : a + b = ab) (hbc : b + c = bc) (hab_c : ab + c = abc) (ha_bc : a + bc = abc)
        (x : V_P a) (y : V_P b) (z : V_P c),
        cup_P ab c abc hab_c (cup_P a b ab hab x y) z =
          cup_P a bc abc ha_bc x (cup_P b c bc hbc y z)) →
      (∀ (a b c : ℕ) (hab : a + b = c) (x : V_X a) (y : V_X b),
        fp₁ c (cup_X a b c hab x y) = cup_P a b c hab (fp₁ a x) (fp₁ b y)) →
      (∀ (a b c : ℕ) (hab : a + b = c) (x : V_X a) (y : V_X b),
        fp₂ c (cup_X a b c hab x y) = cup_P a b c hab (fp₂ a x) (fp₂ b y)) →
      (∀ (i j : ℕ) (hij : i + j = 2 * d) (u : V_X i) (w : V_X j),
        fΔ (cup_P i j (2 * d) hij (fp₁ i u) (fp₂ j w)) = cup_X i j (2 * d) hij u w) →
      (∀ (i j : ℕ) (hij : i + j = 2 * d) (u : V_X i) (w : V_X j),
        fΓ (cup_P i j (2 * d) hij (fp₁ i u) (fp₂ j w)) = cup_X i j (2 * d) hij u (Φ j w)) →
      (∀ (m : ℕ), 2 * d < m → ∀ (v : V_X m), v = 0) →
      (⊤ ≤ Submodule.span (Padic ℓ) { z : V_P (2 * d) |
        ∃ (i j : ℕ) (hij : i + j = 2 * d) (u : V_X i) (w : V_X j),
          z = cup_P i j (2 * d) hij (fp₁ i u) (fp₂ j w) }) →
      ∀ (η_X : V_X (2 * d) →ₗ[Padic ℓ] Padic ℓ)
        (η_P : V_P (4 * d) →ₗ[Padic ℓ] Padic ℓ),
        (∀ (i j : ℕ) (hij : i + j = 2 * d),
          Function.Bijective (fun u : V_X i => η_X.comp (cup_X i j (2 * d) hij u))) →
        (∀ (u w : V_X (2 * d)),
          η_P (cup_P (2 * d) (2 * d) (4 * d) (by omega) (fp₁ (2 * d) u) (fp₂ (2 * d) w)) =
            η_X u * η_X w) →
        ∀ (N_card : Padic ℓ) (γ : V_P (2 * d)),
          (∀ ξ : V_P (2 * d),
            η_P (cup_P (2 * d) (2 * d) (4 * d) (by omega) γ ξ) = η_X (fΓ ξ)) →
          η_X (fΔ γ) = N_card →
          N_card = ∑ i ∈ Finset.Iic (2 * d),
            (-1 : Padic ℓ) ^ i * LinearMap.trace (Padic ℓ) (V_X i) (Φ i) := by
    intro V_X V_P _ _ _ _ _ Φ fp₁ fp₂ fΔ fΓ cup_X cup_P
      hcup_X_comm hcup_P_comm hcup_P_assoc hfp₁_cup hfp₂_cup
      hfΔ_pure hfΓ_pure hvanish hspan η_X η_P hB_bij hProdTr N_card γ hGysin hDiagCard
    classical
    have hsigns : ∀ (i : ℕ), i ≤ 2 * d →
        (-1 : Padic ℓ) ^ i * (-1 : Padic ℓ) ^ i = 1 ∧
        (-1 : Padic ℓ) ^ (i * (2 * d - i)) = (-1 : Padic ℓ) ^ i ∧
        (-1 : Padic ℓ) ^ ((2 * d - i) * i) = (-1 : Padic ℓ) ^ i ∧
        (-1 : Padic ℓ) ^ ((2 * d - i) * (2 * d - i)) = (-1 : Padic ℓ) ^ i := by
      intro i hi
      have hsq : (-1 : Padic ℓ) ^ i * (-1 : Padic ℓ) ^ i = 1 := by
        rw [← mul_pow, neg_one_mul, neg_neg, one_pow]
      have hsub : Even i ∧ Even (2 * d - i) ∨ Odd i ∧ Odd (2 * d - i) := by
        rcases Nat.even_or_odd i with ⟨m_ev, rfl⟩ | ⟨m_od, rfl⟩
        · left
          exact ⟨⟨m_ev, rfl⟩, ⟨d - m_ev, by omega⟩⟩
        · right
          exact ⟨⟨m_od, rfl⟩, ⟨d - 1 - m_od, by omega⟩⟩
      refine ⟨hsq, ?_, ?_, ?_⟩
      · rcases hsub with ⟨he₁, _⟩ | ⟨ho₁, ho₂⟩
        · rw [(he₁.mul_right _).neg_one_pow, he₁.neg_one_pow]
        · rw [(ho₁.mul ho₂).neg_one_pow, ho₁.neg_one_pow]
      · rcases hsub with ⟨he₁, _⟩ | ⟨ho₁, ho₂⟩
        · rw [(he₁.mul_left _).neg_one_pow, he₁.neg_one_pow]
        · rw [(ho₂.mul ho₁).neg_one_pow, ho₁.neg_one_pow]
      · rcases hsub with ⟨he₁, he₂⟩ | ⟨ho₁, ho₂⟩
        · rw [(he₂.mul_right _).neg_one_pow, he₁.neg_one_pow]
        · rw [(ho₂.mul ho₂).neg_one_pow, ho₁.neg_one_pow]
    let ι : ℕ → Type u := fun i => Module.Free.ChooseBasisIndex (Padic ℓ) (V_X i)
    let b : ∀ i : ℕ, Module.Basis (ι i) (Padic ℓ) (V_X i) :=
      fun i => Module.Free.chooseBasis (Padic ℓ) (V_X i)
    let B_left (i : ℕ) (hi : i ≤ 2 * d) :
        V_X (2 * d - i) →ₗ[Padic ℓ] Module.Dual (Padic ℓ) (V_X i) :=
      { toFun := fun w => η_X.comp (cup_X (2 * d - i) i (2 * d) (by omega) w)
        map_add' := fun x y => by ext u; simp
        map_smul' := fun c x => by ext u; simp }
    let e_dual (i : ℕ) (hi : i ≤ 2 * d) :
        V_X (2 * d - i) ≃ₗ[Padic ℓ] Module.Dual (Padic ℓ) (V_X i) :=
      LinearEquiv.ofBijective (B_left i hi) (hB_bij (2 * d - i) i (by omega))
    let f_dual (i : ℕ) (hi : i ≤ 2 * d) (m : ι i) : V_X (2 * d - i) :=
      (-1 : Padic ℓ) ^ i • (e_dual i hi).symm ((b i).dualBasis m)
    have hf_left : ∀ (i : ℕ) (hi : i ≤ 2 * d) (hji : (2 * d - i) + i = 2 * d)
        (m : ι i) (u : V_X i),
        η_X (cup_X (2 * d - i) i (2 * d) hji (f_dual i hi m) u) =
          (-1 : Padic ℓ) ^ i * ((b i).dualBasis m) u := by
      intro i hi hji m u
      have heq : cup_X (2 * d - i) i (2 * d) hji = cup_X (2 * d - i) i (2 * d) (by omega) := rfl
      rw [heq]
      change (e_dual i hi (f_dual i hi m)) u = _
      dsimp only [f_dual]
      rw [map_smul, LinearEquiv.apply_symm_apply, LinearMap.smul_apply, smul_eq_mul]
    have hf_basis : ∀ (i : ℕ) (hi : i ≤ 2 * d) (hji : (2 * d - i) + i = 2 * d) (m l : ι i),
        η_X (cup_X (2 * d - i) i (2 * d) hji (f_dual i hi m) (b i l)) =
          if m = l then (-1 : Padic ℓ) ^ i else 0 := by
      intro i hi hji m l
      rw [hf_left i hi hji m (b i l), (b i).dualBasis_apply, (b i).repr_self, Finsupp.single_apply]
      by_cases hml : m = l
      · subst hml; simp
      · simp [hml, Ne.symm hml]
    have hf_right : ∀ (i : ℕ) (hi : i ≤ 2 * d) (hij : i + (2 * d - i) = 2 * d)
        (m : ι i) (u : V_X i),
        η_X (cup_X i (2 * d - i) (2 * d) hij u (f_dual i hi m)) = ((b i).dualBasis m) u := by
      intro i hi hij m u
      rw [hcup_X_comm i (2 * d - i) (2 * d) hij (by omega) u (f_dual i hi m),
        map_smul, smul_eq_mul, hf_left i hi (by omega) m u, (hsigns i hi).2.1,
        ← mul_assoc, (hsigns i hi).1, one_mul]
    have hf_span : ∀ (i : ℕ) (hi : i ≤ 2 * d) (w : V_X (2 * d - i)),
        ∃ c : ι i → Padic ℓ, w = ∑ m : ι i, c m • f_dual i hi m := by
      intro i hi w
