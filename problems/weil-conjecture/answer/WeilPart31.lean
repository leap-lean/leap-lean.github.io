          let z_S : one ⟶ S.X (s + q) := z₀ ≫ (e_X s).hom
          z_S ≫ S.d (s + q) (s + q + 1) = 0 ∧
          z_S ≫ Φ_q.f (s + q) =
            (z₀ ≫ f_q s) ≫ eqToHom (congrArg J_t (Nat.add_comm q s)) ∧
          (∀ N : ℕ,
            (((s + q = 0 ∧ N • z_S = 0) ∨
              ∃ (p : ℕ) (_ : p + 1 = s + q) (a_S : one ⟶ S.X p),
                a_S ≫ S.d p (s + q) = N • z_S) →
            ((s = 0 ∧ N • z₀ = 0) ∨
              ∃ (p₁ : ℕ) (hp₁ : p₁ + 1 = s) (a₀ : one ⟶ I p₁),
                a₀ ≫ (π_Y p₁ ≫ (ι_Y (p₁ + 1) ≫ eqToHom (congrArg I hp₁))) = N • z₀)))) := by
    intro q
    induction q with
    | zero =>
      intro Y I ι_Y π_Y hz_Y hEx_Y Z_t J_t ι_t π_t hd_t hat_ψ_q f_q hf0_q hfSucc_q K_t
      have hd_Y : ∀ s : ℕ, (π_Y s ≫ ι_Y (s + 1)) ≫ (π_Y (s + 1) ≫ ι_Y (s + 2)) = 0 := by
        intro s
        rw [Category.assoc, ← Category.assoc (ι_Y (s + 1)), hz_Y (s + 1),
          Limits.zero_comp, Limits.comp_zero]
      let S₀ : CochainComplex 𝒞 ℕ :=
        CochainComplex.of I (fun s => π_Y s ≫ ι_Y (s + 1)) hd_Y
      have hS₀_d : ∀ s : ℕ, S₀.d s (s + 1) = π_Y s ≫ ι_Y (s + 1) := by
        intro s
        dsimp [S₀]
        simp only [CochainComplex.of_d]
      have hS₀_d_gen : ∀ {p s : ℕ} (hp : p + 1 = s),
          S₀.d p s = π_Y p ≫ (ι_Y (p + 1) ≫ eqToHom (congrArg I hp)) := by
        intro p s hp
        subst hp
        simp [hS₀_d]
      have hKt_eq : ∀ {a b : ℕ} (hab : a = b),
          eqToHom (congrArg J_t hab) ≫ (π_t b ≫ ι_t (b + 1)) =
            (π_t a ≫ ι_t (a + 1)) ≫ eqToHom (congrArg J_t (congrArg Nat.succ hab)) := by
        intro a b hab
        subst hab
        simp
      let Φ₀ : S₀ ⟶ K_t :=
        { f := fun s => f_q s ≫ eqToHom (congrArg J_t (Nat.zero_add s))
          comm' := by
            intro i j (hij : i + 1 = j)
            subst hij
            have hKd_i : K_t.d i (i + 1) = π_t i ≫ ι_t (i + 1) := by
              dsimp [K_t]
              simp only [CochainComplex.of_d]
            rw [hKd_i, hS₀_d i, Category.assoc, hKt_eq (Nat.zero_add i),
              ← Category.assoc (f_q i), ← hfSucc_q i, Category.assoc] }
      have hz_Yd : ∀ s : ℕ, ι_Y s ≫ S₀.d s (s + 1) = 0 := by
        intro s
        rw [hS₀_d s, ← Category.assoc, hz_Y s, Limits.zero_comp]
      have hCyc_πY : ∀ s : ℕ, S₀.iCycles s ≫ π_Y s = 0 := by
        intro s
        have : Mono (ι_Y (s + 1)) := (hEx_Y (s + 1)).mono_f
        apply (cancel_mono (ι_Y (s + 1))).mp
        rw [Category.assoc, ← hS₀_d s, S₀.iCycles_d s (s + 1), Limits.zero_comp]
      let e_cyc_Y : ∀ s : ℕ, Y s ≅ S₀.cycles s := fun s =>
        let hom_s := S₀.liftCycles (ι_Y s) (s + 1) ((ComplexShape.up ℕ).next_eq' rfl) (hz_Yd s)
        let inv_p := Limits.KernelFork.IsLimit.lift' (hEx_Y s).fIsKernel (S₀.iCycles s) (hCyc_πY s)
        { hom := hom_s
          inv := inv_p.1
          hom_inv_id := by
            have : Mono (ι_Y s) := (hEx_Y s).mono_f
            apply (cancel_mono (ι_Y s)).mp
            have hfac : inv_p.1 ≫ ι_Y s = S₀.iCycles s := inv_p.2
            rw [Category.assoc, hfac, S₀.liftCycles_i, Category.id_comp]
          inv_hom_id := by
            apply (cancel_mono (S₀.iCycles s)).mp
            have hfac : inv_p.1 ≫ ι_Y s = S₀.iCycles s := inv_p.2
            rw [Category.assoc, S₀.liftCycles_i, hfac, Category.id_comp] }
      have h_ecyc_Y : ∀ s : ℕ, (e_cyc_Y s).hom ≫ S₀.iCycles s = ι_Y s :=
        fun s => S₀.liftCycles_i (ι_Y s) (s + 1) ((ComplexShape.up ℕ).next_eq' rfl) (hz_Yd s)
      refine ⟨S₀, Φ₀, fun s => Iso.refl (I s), e_cyc_Y 0, ?_, ?_, ?_, ?_, ?_⟩
      · intro p hp
        omega
      · intro hInj p
        exact hInj p
      · intro p hp
        cases p with
        | zero => exact absurd rfl hp
        | succ k =>
          have hToCyc_Y : S₀.toCycles k (k + 1) = π_Y k ≫ (e_cyc_Y (k + 1)).hom := by
            apply (cancel_mono (S₀.iCycles (k + 1))).mp
            rw [S₀.toCycles_i k (k + 1), hS₀_d k, Category.assoc, h_ecyc_Y (k + 1)]
          have hπ_zero : S₀.homologyπ (k + 1) = 0 := by
            have h1 : (e_cyc_Y (k + 1)).hom ≫ S₀.homologyπ (k + 1) = 0 := by
              have : Epi (π_Y k) := (hEx_Y k).epi_g
              apply (cancel_epi (π_Y k)).mp
              rw [Limits.comp_zero, ← Category.assoc, ← hToCyc_Y,
                S₀.toCycles_comp_homologyπ k (k + 1)]
            rw [← Category.id_comp (S₀.homologyπ (k + 1)), ← (e_cyc_Y (k + 1)).inv_hom_id,
              Category.assoc, h1, Limits.comp_zero]
          rw [Limits.IsZero.iff_id_eq_zero]
          apply (cancel_epi (S₀.homologyπ (k + 1))).mp
          rw [Category.comp_id, Limits.comp_zero, hπ_zero]
      · refine ⟨S₀.isIso_homologyπ₀, ?_⟩
        rw [h_ecyc_Y 0]
        change ι_Y 0 ≫ (f_q 0 ≫ eqToHom (congrArg J_t (Nat.zero_add 0))) = hat_ψ_q ≫ ι_t 0
        rw [eqToHom_refl, Category.comp_id, hf0_q]
      · intro s one z₀ hz₀ z_S
        have hz_eq : z_S = z₀ := Category.comp_id z₀
        refine ⟨?_, ?_, ?_⟩
        · change z_S ≫ S₀.d s (s + 1) = 0
          rw [hz_eq, hS₀_d s]
          exact hz₀
        · rw [hz_eq]
          change z₀ ≫ (f_q s ≫ eqToHom (congrArg J_t (Nat.zero_add s))) =
            (z₀ ≫ f_q s) ≫ eqToHom (congrArg J_t (Nat.add_comm 0 s))
          rw [Category.assoc]
        · intro N hCob
          rcases hCob with ⟨hs0, hNz⟩ | ⟨p, hp, a_S, ha⟩
          · left
            rw [hz_eq] at hNz
            exact ⟨hs0, hNz⟩
          · right
            rw [hz_eq, hS₀_d_gen hp] at ha
            exact ⟨p, hp, a_S, ha⟩
    | succ q' ih =>
      intro Y I ι_Y π_Y hz_Y hEx_Y Z_t J_t ι_t π_t hd_t hat_ψ_q f_q hf0_q hfSucc_q K_t
      obtain ⟨Z_t', rfl⟩ : ∃ Z_t' : ℕ → 𝒞, Z_t' = fun p => Z_t (p + 1) := ⟨_, rfl⟩
      obtain ⟨J_t', rfl⟩ : ∃ J_t' : ℕ → 𝒞, J_t' = fun p => J_t (p + 1) := ⟨_, rfl⟩
      let ι_t' (p : ℕ) : Z_t (p + 1) ⟶ J_t (p + 1) := ι_t (p + 1)
      let π_t' (p : ℕ) : J_t (p + 1) ⟶ Z_t (p + 2) := π_t (p + 1)
      have hd_t' : ∀ p : ℕ, (π_t' p ≫ ι_t' (p + 1)) ≫ (π_t' (p + 1) ≫ ι_t' (p + 2)) = 0 :=
        fun p => hd_t (p + 1)
      let K_t' : CochainComplex 𝒞 ℕ :=
        CochainComplex.of (fun p => J_t (p + 1)) (fun p => π_t' p ≫ ι_t' (p + 1)) hd_t'
      let f_q' (s : ℕ) : I s ⟶ J_t ((q' + s) + 1) :=
        f_q s ≫ eqToHom (congrArg J_t (Nat.succ_add q' s))
      have hJt_step : ∀ {a b : ℕ} (hab : a = b),
          eqToHom (congrArg J_t hab) ≫ (π_t b ≫ ι_t (b + 1)) =
            (π_t a ≫ ι_t (a + 1)) ≫ eqToHom (congrArg J_t (congrArg Nat.succ hab)) := by
        intro a b hab
        subst hab
        simp
      have hf0_q' : ι_Y 0 ≫ f_q' 0 = hat_ψ_q ≫ ι_t' q' := by
        dsimp [f_q', ι_t']
        rw [Category.comp_id]
        exact hf0_q
      have hfSucc_q' : ∀ s : ℕ,
          (π_Y s ≫ ι_Y (s + 1)) ≫ f_q' (s + 1) =
            f_q' s ≫ (π_t' (q' + s) ≫ ι_t' (q' + s + 1)) := by
        intro s
        dsimp [f_q', π_t', ι_t']
        have h_eq : eqToHom (congrArg J_t (Nat.succ_add q' (s + 1))) =
            eqToHom (congrArg J_t (congrArg Nat.succ (Nat.succ_add q' s))) := rfl
        rw [h_eq, ← Category.assoc, hfSucc_q s, Category.assoc,
          Category.assoc (f_q s), hJt_step (Nat.succ_add q' s)]
      obtain ⟨S', Φ', e_X', e_cyc_S', hZ_lt', hInj', hHom_ne', ⟨_, hCyc_Φ'⟩, hCocyc'⟩ :=
        ih Y I ι_Y π_Y hz_Y hEx_Y (fun p => Z_t (p + 1)) (fun p => J_t (p + 1))
          ι_t' π_t' hd_t' hat_ψ_q f_q' hf0_q' hfSucc_q'
      let S : CochainComplex 𝒞 ℕ := weilCochainShift1 Z₀ S'
      let Φ_succ : S ⟶ K_t :=
        { f := fun i =>
            match i with
            | 0 => 0
            | p + 1 => Φ'.f p
          comm' := by
            intro i j (hij : i + 1 = j)
            subst hij
            cases i with
            | zero =>
              exact Limits.zero_comp.trans
                ((congrArg (fun d => d ≫ Φ'.f 0) (shift1_d_zero S')).trans
                  Limits.zero_comp).symm
            | succ p =>
              have hKt_p : K_t.d (p + 1) (p + 2) = K_t'.d p (p + 1) :=
                (CochainComplex.of_d J_t (fun p => π_t p ≫ ι_t (p + 1)) (p + 1)).trans
                  (CochainComplex.of_d (fun p => J_t (p + 1))
                    (fun p => π_t' p ≫ ι_t' (p + 1)) p).symm
              exact (congrArg (fun d => Φ'.f p ≫ d) hKt_p).trans
                ((Φ'.comm p (p + 1)).trans
                  (congrArg (fun d => d ≫ Φ'.f (p + 1)) (shift1_d_succ S' p).symm)) }
      have hZ_lt : ∀ p : ℕ, p < q' + 1 → Limits.IsZero (S.X p) := by
        intro p hp
        cases p with
        | zero => exact hZ₀
        | succ r => exact hZ_lt' r (Nat.lt_of_succ_lt_succ hp)
      refine ⟨S, Φ_succ, e_X', e_cyc_S' ≪≫ e_sh_cyc S' q', hZ_lt, ?_, ?_, ?_, ?_⟩
      · intro hInj_I p
        cases p with
        | zero => exact hInj_Z₀
        | succ r => exact hInj' hInj_I r
      · intro p hp
        cases p with
        | zero => exact shift1_hom0_isZero S'
        | succ p' =>
          have hp' : p' ≠ q' := fun h => hp (congrArg Nat.succ h)
          exact shift1_hom_succ_isZero S' p' (hHom_ne' p' hp')
      · refine ⟨?_, ?_⟩
        · have hd_q' : S.d q' (q' + 1) = 0 :=
            (hZ_lt q' (Nat.lt_succ_self q')).eq_of_src _ _
          exact S.isIso_homologyπ q' (q' + 1) (CochainComplex.prev_nat_succ q') hd_q'
        · change ((e_cyc_S'.hom ≫ (e_sh_cyc S' q').hom) ≫ S.iCycles (q' + 1)) ≫ Φ'.f q' = _
          rw [Category.assoc (e_cyc_S'.hom), e_sh_cyc_hom_i S' q']
          exact hCyc_Φ'
      · intro s one z₀ hz₀ z_S
        obtain ⟨hz_d', hz_Φ', hz_cob'⟩ := hCocyc' s one z₀ hz₀
        refine ⟨?_, ?_, ?_⟩
        · change (z₀ ≫ (e_X' s).hom) ≫ S.d ((s + q') + 1) ((s + q') + 2) = 0
          rw [shift1_d_succ S' (s + q')]
          exact hz_d'
        · change (z₀ ≫ (e_X' s).hom) ≫ Φ'.f (s + q') = _
          rw [hz_Φ']
          dsimp [f_q']
          have hcast_eq : ∀ {a b : ℕ} (h : a = b),
              eqToHom (congrArg (fun p => J_t (p + 1)) h) =
                eqToHom (congrArg J_t (congrArg Nat.succ h)) := by
            intro a b h
            subst h
            rfl
          rw [hcast_eq (Nat.add_comm q' s)]
          simp only [Category.assoc, eqToHom_trans]
        · intro N hCob
          rcases hCob with ⟨h0, _⟩ | ⟨p, hp, a_S, ha⟩
          · omega
          · have hp' : p = s + q' := Nat.succ.inj hp
            cases p with
            | zero =>
              have ha0 : a_S = 0 := hZ₀.eq_of_tgt a_S 0
              rw [ha0, Limits.zero_comp] at ha
              exact hz_cob' N (Or.inl ⟨hp'.symm, ha.symm⟩)
            | succ p₀ =>
              have ha' : (a_S : one ⟶ S'.X p₀) ≫ S'.d p₀ (s + q') =
                  N • (z₀ ≫ (e_X' s).hom) :=
                (congrArg (fun d => a_S ≫ d) (shift1_d_succ_gen S' hp')).symm.trans ha
              exact hz_cob' N (Or.inr ⟨p₀, hp', a_S, ha'⟩)

  
  choose S Φ_s e_X e_cyc_S hS_zeroX hS_inj hS_zeroHom hS_homPair hS_cocyc using
    fun q : ℕ => hSingleShift q (Y_E q) (I_E q) (ι_E q) (π_E q) (hz_E q) (hEx_E q)
      Z_K J_K ι_K π_K hd_K (hat_ψ q) (f_lad q) (hf0 q) (hfSucc q)

  let e_H : ∀ q : ℕ, Y_E q 0 ≅ (S q).homology q := fun q =>
    have : IsIso ((S q).homologyπ q) := (hS_homPair q).1
    e_cyc_S q ≪≫ asIso ((S q).homologyπ q)

  have hS_hom : ∀ q : ℕ,
      (e_H q).hom ≫ HomologicalComplex.homologyMap (Φ_s q) q =
        hat_ψ q ≫ (e_cyc q).hom ≫ K.homologyπ q := by
    intro q
    have h_cyc_map : (e_cyc_S q).hom ≫ HomologicalComplex.cyclesMap (Φ_s q) q =
        hat_ψ q ≫ (e_cyc q).hom := by
      apply (cancel_mono (K.iCycles q)).mp
      rw [Category.assoc, HomologicalComplex.cyclesMap_i (Φ_s q) q, ← Category.assoc,
        (hS_homPair q).2, Category.assoc, h_ecyc q]
    have : IsIso ((S q).homologyπ q) := (hS_homPair q).1
    change ((e_cyc_S q).hom ≫ (S q).homologyπ q) ≫ HomologicalComplex.homologyMap (Φ_s q) q = _
    rw [Category.assoc, HomologicalComplex.homologyπ_naturality (Φ_s q) q,
      ← Category.assoc, h_cyc_map, Category.assoc]

  
  
  
  have hBiprod_tot : ∀ (A B : CochainComplex 𝒞 ℕ) (p : ℕ),
      HomologicalComplex.homologyMap (Limits.biprod.fst : A ⊞ B ⟶ A) p ≫
          HomologicalComplex.homologyMap Limits.biprod.inl p +
        HomologicalComplex.homologyMap (Limits.biprod.snd : A ⊞ B ⟶ B) p ≫
          HomologicalComplex.homologyMap Limits.biprod.inr p =
      𝟙 ((A ⊞ B).homology p) := by
    intro A B p
    rw [← HomologicalComplex.homologyMap_comp, ← HomologicalComplex.homologyMap_comp,
      ← HomologicalComplex.homologyMap_add, Limits.biprod.total,
      HomologicalComplex.homologyMap_id]
  have biprod_hom_isZero : ∀ {A B : CochainComplex 𝒞 ℕ} {p : ℕ},
      Limits.IsZero (A.homology p) → Limits.IsZero (B.homology p) →
      Limits.IsZero ((A ⊞ B).homology p) := by
    intro A B p hA hB
    rw [Limits.IsZero.iff_id_eq_zero, ← hBiprod_tot A B p,
      hA.eq_of_src (HomologicalComplex.homologyMap Limits.biprod.inl p) 0,
      hB.eq_of_src (HomologicalComplex.homologyMap Limits.biprod.inr p) 0,
      Limits.comp_zero, Limits.comp_zero, add_zero]
  have biprod_inl_isIso : ∀ {A B : CochainComplex 𝒞 ℕ} {p : ℕ},
      Limits.IsZero (B.homology p) →
      IsIso (HomologicalComplex.homologyMap (Limits.biprod.inl : A ⟶ A ⊞ B) p) := by
    intro A B p hB
    refine ⟨⟨HomologicalComplex.homologyMap (Limits.biprod.fst : A ⊞ B ⟶ A) p, ?_, ?_⟩⟩
    · rw [← HomologicalComplex.homologyMap_comp, Limits.biprod.inl_fst,
        HomologicalComplex.homologyMap_id]
    · have htot := hBiprod_tot A B p
      rw [hB.eq_of_src (HomologicalComplex.homologyMap Limits.biprod.inr p) 0,
        Limits.comp_zero, add_zero] at htot
      exact htot
  have biprod_inr_isIso : ∀ {A B : CochainComplex 𝒞 ℕ} {p : ℕ},
      Limits.IsZero (A.homology p) →
      IsIso (HomologicalComplex.homologyMap (Limits.biprod.inr : B ⟶ A ⊞ B) p) := by
    intro A B p hA
    refine ⟨⟨HomologicalComplex.homologyMap (Limits.biprod.snd : A ⊞ B ⟶ B) p, ?_, ?_⟩⟩
    · rw [← HomologicalComplex.homologyMap_comp, Limits.biprod.inr_snd,
        HomologicalComplex.homologyMap_id]
    · have htot := hBiprod_tot A B p
      rw [hA.eq_of_src (HomologicalComplex.homologyMap Limits.biprod.inl p) 0,
        Limits.comp_zero, zero_add] at htot
      exact htot

  have hE_above : ∀ (r p : ℕ), r < p →
      Limits.IsZero ((weilCochainBiprodRec S r).homology p) := by
    intro r
    induction r with
    | zero =>
      intro p hp
      exact hS_zeroHom 0 p (Nat.ne_of_gt hp)
    | succ r' ih =>
      intro p hp
      exact biprod_hom_isZero (ih p (Nat.lt_of_succ_lt hp)) (hS_zeroHom (r' + 1) p (Nat.ne_of_gt hp))

  have hE_summand : ∀ (r q : ℕ), q ≤ r →
      ∃ (inl_q : S q ⟶ weilCochainBiprodRec S r)
        (prj_q : weilCochainBiprodRec S r ⟶ S q),
        inl_q ≫ prj_q = 𝟙 (S q) ∧
        inl_q ≫ weilCochainBiprodDescRec S Φ_s r = Φ_s q ∧
        IsIso (HomologicalComplex.homologyMap inl_q q) := by
    intro r
    induction r with
    | zero =>
      intro q hq
      obtain rfl : q = 0 := Nat.le_zero.mp hq
      have h0 : ∃ (inl_q : S 0 ⟶ S 0) (prj_q : S 0 ⟶ S 0),
          inl_q ≫ prj_q = 𝟙 (S 0) ∧
          inl_q ≫ Φ_s 0 = Φ_s 0 ∧
          IsIso (HomologicalComplex.homologyMap inl_q 0) := by
        refine ⟨𝟙 (S 0), 𝟙 (S 0), Category.id_comp _, Category.id_comp _, ?_⟩
        rw [HomologicalComplex.homologyMap_id]
        infer_instance
      exact h0
    | succ r' ih =>
      intro q hq
      have h_step : ∃ (inl_q : S q ⟶ weilCochainBiprodRec S r' ⊞ S (r' + 1))
          (prj_q : weilCochainBiprodRec S r' ⊞ S (r' + 1) ⟶ S q),
          inl_q ≫ prj_q = 𝟙 (S q) ∧
          inl_q ≫ Limits.biprod.desc (weilCochainBiprodDescRec S Φ_s r') (Φ_s (r' + 1)) = Φ_s q ∧
          IsIso (HomologicalComplex.homologyMap inl_q q) := by
        rcases Nat.of_le_succ hq with hqr | rfl
        · obtain ⟨inl', prj', hRetr', hΦ', hIso'⟩ := ih q hqr
          refine ⟨inl' ≫ Limits.biprod.inl, Limits.biprod.fst ≫ prj', ?_, ?_, ?_⟩
          · rw [Category.assoc, ← Category.assoc Limits.biprod.inl, Limits.biprod.inl_fst,
              Category.id_comp, hRetr']
          · rw [Category.assoc, Limits.biprod.inl_desc, hΦ']
          · rw [HomologicalComplex.homologyMap_comp]
            have : IsIso (HomologicalComplex.homologyMap inl' q) := hIso'
            have : IsIso (HomologicalComplex.homologyMap
                (Limits.biprod.inl : weilCochainBiprodRec S r' ⟶
                  weilCochainBiprodRec S r' ⊞ S (r' + 1)) q) :=
              biprod_inl_isIso (hS_zeroHom (r' + 1) q (by omega))
            exact IsIso.comp_isIso
        · refine ⟨Limits.biprod.inr, Limits.biprod.snd, Limits.biprod.inr_snd,
            Limits.biprod.inr_desc _ _, ?_⟩
          exact biprod_inr_isIso (hE_above r' (r' + 1) (Nat.lt_succ_self r'))
      exact h_step

  let n : ℕ := i₁ + i₂
  have hE_inj_rec : ∀ r : ℕ, r ≤ n →
      (∀ q : ℕ, q ≤ n → ∀ s : ℕ, Injective (I_E q s)) →
      ∀ p : ℕ, Injective ((weilCochainBiprodRec S r).X p) := by
    intro r
    induction r with
    | zero =>
      intro hr hInj_I p
      exact hS_inj 0 (hInj_I 0 hr) p
    | succ r' ih =>
      intro hr hInj_I p
      have : Injective ((weilCochainBiprodRec S r').X p) := ih (Nat.le_of_succ_le hr) hInj_I p
      have : Injective ((S (r' + 1)).X p) := hS_inj (r' + 1) (hInj_I (r' + 1) hr) p
      exact Injective.of_iso
        (HomologicalComplex.biprodXIso (weilCochainBiprodRec S r') (S (r' + 1)) p).symm
        inferInstance

  
  
  
  let E : CochainComplex 𝒞 ℕ := weilCochainBiprodRec S n
  let Φ : E ⟶ K := weilCochainBiprodDescRec S Φ_s n
  have hi₂_le : i₂ ≤ n := Nat.le_add_left i₂ i₁
  obtain ⟨inl_i₂, prj_i₂, hRetr_i₂, hΦ_i₂, _⟩ := hE_summand n i₂ hi₂_le
  let ι_summand : I_E i₂ i₁ ⟶ E.X n := (e_X i₂ i₁).hom ≫ inl_i₂.f n

  have hMono_and_coker : ∀ {X₁ X₂ Y₁ Y₂ : 𝒞} (e₁ : X₁ ≅ X₂) (e₂ : Y₁ ≅ Y₂)
      (ψ : X₁ ⟶ Y₁) (h : X₂ ⟶ Y₂) (lift : Y₁ ⟶ X₁),
      Mono ψ →
      lift ≫ ψ = M • 𝟙 Y₁ →
      e₁.hom ≫ h = ψ ≫ e₂.hom →
      Mono h ∧ M • 𝟙 (Limits.cokernel h) = 0 := by
    intro X₁ X₂ Y₁ Y₂ e₁ e₂ ψ h lift hMonoψ hLift hComm
    have hh_eq : h = e₁.inv ≫ ψ ≫ e₂.hom := by
      rw [← hComm, ← Category.assoc, e₁.inv_hom_id, Category.id_comp]
    have hMono_h : Mono h := by
      rw [hh_eq]
      exact mono_comp e₁.inv (ψ ≫ e₂.hom)
    let L : Y₂ ⟶ X₂ := e₂.inv ≫ lift ≫ e₁.hom
    have hLh : L ≫ h = M • 𝟙 Y₂ := by
      dsimp [L]
      rw [Category.assoc, Category.assoc, hComm, ← Category.assoc lift, hLift,
        Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, e₂.inv_hom_id]
    have hCoker0 : M • 𝟙 (Limits.cokernel h) = 0 := by
      let π_c := Limits.cokernel.π h
      apply (cancel_epi π_c).mp
      rw [Limits.comp_zero, Preadditive.comp_nsmul, Category.comp_id,
        ← Category.id_comp π_c, ← Preadditive.nsmul_comp,
        ← hLh, Category.assoc, Limits.cokernel.condition h, Limits.comp_zero]
    exact ⟨hMono_h, hCoker0⟩

  refine ⟨E, Φ, ι_summand, ?_, ?_, ?_⟩
  · 
    exact hE_inj_rec n (le_refl n)
  · 
    intro q hq
    obtain ⟨inl_q, _, _, hΦ_q, hIso_q⟩ := hE_summand n q hq
    have : IsIso (HomologicalComplex.homologyMap inl_q q) := hIso_q
    let e_inl_q : (S q).homology q ≅ E.homology q :=
      asIso (HomologicalComplex.homologyMap inl_q q)
    let e₁ : Y_E q 0 ≅ E.homology q := e_H q ≪≫ e_inl_q
    have hComm_q : e₁.hom ≫ HomologicalComplex.homologyMap Φ q =
        hat_ψ q ≫ (e_cyc q).hom ≫ K.homologyπ q := by
      change ((e_H q).hom ≫ HomologicalComplex.homologyMap inl_q q) ≫
          HomologicalComplex.homologyMap Φ q = _
      rw [Category.assoc, ← HomologicalComplex.homologyMap_comp, hΦ_q]
      exact hS_hom q
    cases q with
    | zero =>
      rw [← h_eK0] at hComm_q
      obtain ⟨hMono0, lift₀, hLift0⟩ := hBasis0
      exact hMono_and_coker e₁ e_K0 (hat_ψ 0) (HomologicalComplex.homologyMap Φ 0)
        lift₀ hMono0 hLift0 hComm_q
    | succ k =>
      rw [← h_eKSucc k, ← Category.assoc] at hComm_q
      obtain ⟨hMono_k, lift_k, hLift_k⟩ := hBasisSucc k hq
      exact hMono_and_coker e₁ (e_KSucc k) (hat_ψ (k + 1) ≫ q_H k)
        (HomologicalComplex.homologyMap Φ (k + 1)) lift_k hMono_k hLift_k hComm_q
  · 
    intro one z₀ hz₀ z
    let z_S : one ⟶ (S i₂).X n := z₀ ≫ (e_X i₂ i₁).hom
    have hz_eq : z = z_S ≫ inl_i₂.f n :=
      (Category.assoc z₀ ((e_X i₂ i₁).hom) (inl_i₂.f n)).symm
    obtain ⟨hz_S_d, hz_S_Φ, hz_S_cob⟩ := hS_cocyc i₂ i₁ one z₀ hz₀
    refine ⟨?_, ?_, ?_⟩
    · 
      rw [hz_eq, Category.assoc, inl_i₂.comm n (n + 1), ← Category.assoc,
        hz_S_d, Limits.zero_comp]
    · 
      have hΦ_f : inl_i₂.f n ≫ Φ.f n = (Φ_s i₂).f n := congrArg (fun φ => φ.f n) hΦ_i₂
      rw [hz_eq, Category.assoc, hΦ_f]
      exact hz_S_Φ
    · 
      intro N hCob
      have hRetr_f : inl_i₂.f n ≫ prj_i₂.f n = 𝟙 ((S i₂).X n) :=
        congrArg (fun φ => φ.f n) hRetr_i₂
      have hz_prj : (N • z) ≫ prj_i₂.f n = N • z_S := by
        rw [Preadditive.nsmul_comp, hz_eq, Category.assoc, hRetr_f, Category.comp_id]
      rcases hCob with ⟨hn0, hNz⟩ | ⟨p, hp, a_E, ha⟩
      · rw [hNz, Limits.zero_comp] at hz_prj
        exact hz_S_cob N (Or.inl ⟨hn0, hz_prj.symm⟩)
      · refine hz_S_cob N (Or.inr ⟨p, hp, a_E ≫ prj_i₂.f p, ?_⟩)
        rw [Category.assoc, prj_i₂.comm p n, ← Category.assoc, ha, hz_prj]

theorem weil_abelian_adjunction_cosyzygy_ladder_and_cup_bridge (𝒞₁ 𝒞₂ : Type (u + 1))
    [CategoryTheory.Category.{u + 1, u + 1} 𝒞₁] [CategoryTheory.Abelian 𝒞₁]
    [CategoryTheory.EnoughInjectives 𝒞₁] [CategoryTheory.HasExt.{u} 𝒞₁]
    [CategoryTheory.Category.{u + 1, u + 1} 𝒞₂] [CategoryTheory.Abelian 𝒞₂]
    [CategoryTheory.EnoughInjectives 𝒞₂] [CategoryTheory.HasExt.{u} 𝒞₂]
    (P_pull : CategoryTheory.Functor 𝒞₁ 𝒞₂)
    (P_push : CategoryTheory.Functor 𝒞₂ 𝒞₁)
    (adj : P_pull ⊣ P_push)
    [P_pull.Additive]
    [CategoryTheory.Limits.PreservesFiniteLimits P_pull]
    [CategoryTheory.Limits.PreservesFiniteColimits P_pull]
    (one₁ : 𝒞₁) (one₂ : 𝒞₂) (e_unit : one₂ ≅ P_pull.obj one₁)
    (b : ℕ → ℕ)
    (w₂ : ∀ q : ℕ, Fin (b q) → CategoryTheory.Abelian.Ext.{u} one₂ one₂ q)
    (Z₂ J₂ : ℕ → 𝒞₂) (hZ0 : Z₂ 0 = one₂)
    (hInj₂ : ∀ k : ℕ, CategoryTheory.Injective (J₂ k))
    (ι_Z : ∀ k : ℕ, Z₂ k ⟶ J₂ k)
    (π_Z : ∀ k : ℕ, J₂ k ⟶ Z₂ (k + 1))
    (hz_Z : ∀ k : ℕ, CategoryTheory.CategoryStruct.comp (ι_Z k) (π_Z k) = 0)
    (hEx_Z : ∀ k : ℕ, (CategoryTheory.ShortComplex.mk (ι_Z k) (π_Z k) (hz_Z k)).ShortExact)
    (η₂ : ∀ q : ℕ, CategoryTheory.Abelian.Ext.{u} (Z₂ q) one₂ q)
    (hη0 : η₂ 0 = CategoryTheory.Abelian.Ext.mk₀ (eqToHom hZ0))
    (hηSucc : ∀ k : ℕ, η₂ (k + 1) = ((hEx_Z k).extClass).comp (η₂ k) (Nat.one_add k))
    (g_tilde : ∀ q : ℕ, Fin (b q) → (one₂ ⟶ Z₂ q))
    (hg_tilde : ∀ (q : ℕ) (t : Fin (b q)),
      (CategoryTheory.Abelian.Ext.mk₀ (g_tilde q t)).comp (η₂ q) (Nat.zero_add q) = w₂ q t)
    (E_free : ℕ → 𝒞₁)
    (incl₁ : ∀ q : ℕ, Fin (b q) → (one₁ ⟶ E_free q))
    (proj₁ : ∀ q : ℕ, Fin (b q) → (E_free q ⟶ one₁))
    (hCoord : ∀ (q : ℕ) (t t' : Fin (b q)),
      CategoryTheory.CategoryStruct.comp (incl₁ q t) (proj₁ q t') =
        if t = t' then CategoryTheory.CategoryStruct.id one₁ else 0) :
    let hat_ψ : ∀ q : ℕ, E_free q ⟶ P_push.obj (Z₂ q) := fun q =>
      ∑ t : Fin (b q),
        CategoryTheory.CategoryStruct.comp (proj₁ q t)
          ((adj.homEquiv one₁ (Z₂ q))
            (CategoryTheory.CategoryStruct.comp e_unit.inv (g_tilde q t)))
    ∃ (Y₁ I₁ : ℕ → ℕ → 𝒞₁) (hY0 : ∀ q : ℕ, Y₁ q 0 = E_free q)
      (_ : ∀ q s : ℕ, CategoryTheory.Injective (I₁ q s))
      (ι_Y : ∀ q s : ℕ, Y₁ q s ⟶ I₁ q s)
      (π_Y : ∀ q s : ℕ, I₁ q s ⟶ Y₁ q (s + 1))
      (hz_Y : ∀ q s : ℕ, CategoryTheory.CategoryStruct.comp (ι_Y q s) (π_Y q s) = 0)
      (_ : ∀ q s : ℕ, (CategoryTheory.ShortComplex.mk (ι_Y q s) (π_Y q s) (hz_Y q s)).ShortExact)
      (f_lad : ∀ q s : ℕ, I₁ q s ⟶ P_push.obj (J₂ (q + s))),
      (∀ q : ℕ,
        CategoryTheory.CategoryStruct.comp (ι_Y q 0) (f_lad q 0) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp (eqToHom (hY0 q)) (hat_ψ q))
            (P_push.map (ι_Z q))) ∧
      (∀ q s : ℕ,
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp (π_Y q s) (ι_Y q (s + 1))) (f_lad q (s + 1)) =
        CategoryTheory.CategoryStruct.comp (f_lad q s)
          (CategoryTheory.CategoryStruct.comp
            (P_push.map (π_Z (q + s))) (P_push.map (ι_Z (q + s + 1))))) ∧
      (∀ (i₁ i₂ : ℕ) (α : Fin (b i₂) → CategoryTheory.Abelian.Ext.{u} one₁ one₁ i₁),
        ∑ t : Fin (b i₂),
          ((CategoryTheory.Abelian.Ext.mk₀ e_unit.hom).comp
            (((P_pull.mapExtAddHom one₁ one₁ i₁ (α t)).comp
              (CategoryTheory.Abelian.Ext.mk₀ e_unit.inv) (Nat.add_zero i₁)))
            (Nat.zero_add i₁)).comp (w₂ i₂ t) (rfl : i₁ + i₂ = i₁ + i₂) = 0 →
        ∃ z₀ : one₁ ⟶ I₁ i₂ i₁,
          CategoryTheory.CategoryStruct.comp z₀
            (CategoryTheory.CategoryStruct.comp (π_Y i₂ i₁) (ι_Y i₂ (i₁ + 1))) = 0 ∧
          ((i₁ + i₂ = 0 ∧ CategoryTheory.CategoryStruct.comp z₀ (f_lad i₂ i₁) = 0) ∨
            ∃ (p : ℕ) (hp : p + 1 = i₂ + i₁) (b_K : one₁ ⟶ P_push.obj (J₂ p)),
              CategoryTheory.CategoryStruct.comp b_K
                (CategoryTheory.CategoryStruct.comp (P_push.map (π_Z p))
                  (CategoryTheory.CategoryStruct.comp (P_push.map (ι_Z (p + 1)))
                    (eqToHom (congrArg (fun k => P_push.obj (J₂ k)) hp)))) =
                CategoryTheory.CategoryStruct.comp z₀ (f_lad i₂ i₁)) ∧
          (∀ N : ℕ,
            ((i₁ = 0 ∧ N • z₀ = 0) ∨
              ∃ (p₁ : ℕ) (hp₁ : p₁ + 1 = i₁) (a₀ : one₁ ⟶ I₁ i₂ p₁),
                CategoryTheory.CategoryStruct.comp a₀
                  (CategoryTheory.CategoryStruct.comp (π_Y i₂ p₁)
                    (CategoryTheory.CategoryStruct.comp (ι_Y i₂ (p₁ + 1))
                      (eqToHom (congrArg (I₁ i₂) hp₁)))) = N • z₀) →
            ∀ t : Fin (b i₂), N • α t = 0)) :=
by
  intro hat_ψ
  have : P_push.Additive := adj.right_adjoint_additive
  have h_mk₀_inj : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C]
      [CategoryTheory.Abelian C] [CategoryTheory.HasExt.{u} C] {A B : C} (f g : A ⟶ B),
      CategoryTheory.Abelian.Ext.mk₀ f = CategoryTheory.Abelian.Ext.mk₀ g → f = g := by
    intro C _ _ _ A B f g hfg
    have h1 := congrArg CategoryTheory.Abelian.Ext.homEquiv₀ hfg
    simpa [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply] using h1

  
  have h_tower_Y : ∃ (Y₁ I₁ : ℕ → ℕ → 𝒞₁) (hY0 : ∀ q : ℕ, Y₁ q 0 = E_free q)
      (_ : ∀ q s : ℕ, CategoryTheory.Injective (I₁ q s))
      (ι_Y : ∀ q s : ℕ, Y₁ q s ⟶ I₁ q s)
      (π_Y : ∀ q s : ℕ, I₁ q s ⟶ Y₁ q (s + 1))
      (hz_Y : ∀ q s : ℕ, CategoryTheory.CategoryStruct.comp (ι_Y q s) (π_Y q s) = 0)
      (hEx_Y : ∀ q s : ℕ, (CategoryTheory.ShortComplex.mk (ι_Y q s) (π_Y q s) (hz_Y q s)).ShortExact)
      (η_Y : ∀ q s : ℕ, CategoryTheory.Abelian.Ext.{u} (Y₁ q s) (E_free q) s),
      (∀ q : ℕ, η_Y q 0 = CategoryTheory.Abelian.Ext.mk₀ (eqToHom (hY0 q))) ∧
      (∀ q s : ℕ, η_Y q (s + 1) = ((hEx_Y q s).extClass).comp (η_Y q s) (Nat.one_add s)) := by
    let step_Y : 𝒞₁ → 𝒞₁ := fun W =>
      CategoryTheory.Limits.cokernel (CategoryTheory.Injective.ι W)
    let step_π : ∀ W : 𝒞₁, CategoryTheory.Injective.under W ⟶ step_Y W := fun W =>
      CategoryTheory.Limits.cokernel.π (CategoryTheory.Injective.ι W)
    have step_hz : ∀ W : 𝒞₁,
        CategoryTheory.CategoryStruct.comp (CategoryTheory.Injective.ι W) (step_π W) = 0 :=
      fun W => CategoryTheory.Limits.cokernel.condition (CategoryTheory.Injective.ι W)
    have step_ex : ∀ W : 𝒞₁,
        (CategoryTheory.ShortComplex.mk (CategoryTheory.Injective.ι W) (step_π W)
          (step_hz W)).ShortExact :=
      fun W => CategoryTheory.ShortComplex.ShortExact.mk
        (CategoryTheory.ShortComplex.exact_cokernel (CategoryTheory.Injective.ι W))
    let Y₁ : ℕ → ℕ → 𝒞₁ := fun q s =>
      Nat.rec (motive := fun _ => 𝒞₁) (E_free q) (fun _ W => step_Y W) s
    let I₁ : ℕ → ℕ → 𝒞₁ := fun q s => CategoryTheory.Injective.under (Y₁ q s)
    let ι_Y : ∀ q s : ℕ, Y₁ q s ⟶ I₁ q s := fun q s => CategoryTheory.Injective.ι (Y₁ q s)
    let π_Y : ∀ q s : ℕ, I₁ q s ⟶ Y₁ q (s + 1) := fun q s => step_π (Y₁ q s)
    have hInj₁ : ∀ q s : ℕ, CategoryTheory.Injective (I₁ q s) :=
      fun q s => CategoryTheory.Injective.injective_under (Y₁ q s)
    have hz_Y := fun q s : ℕ => step_hz (Y₁ q s)
    have hEx_Y := fun q s : ℕ => step_ex (Y₁ q s)
    let η_Y : ∀ q s : ℕ, CategoryTheory.Abelian.Ext.{u} (Y₁ q s) (E_free q) s := fun q s =>
      Nat.rec (motive := fun s => CategoryTheory.Abelian.Ext.{u} (Y₁ q s) (E_free q) s)
        (CategoryTheory.Abelian.Ext.mk₀ (eqToHom (rfl : Y₁ q 0 = E_free q)))
        (fun s η_s => ((hEx_Y q s).extClass).comp η_s (Nat.one_add s)) s
    exact ⟨Y₁, I₁, fun _ => rfl, hInj₁, ι_Y, π_Y, hz_Y, hEx_Y, η_Y,
      fun _ => rfl, fun _ _ => rfl⟩
  obtain ⟨Y₁, I₁, hY0, hInj₁, ι_Y, π_Y, hz_Y, hEx_Y, η_Y, hηY0, hηYSucc⟩ := h_tower_Y

  
  have h_lift_Y : ∀ (q d : ℕ) (γ : CategoryTheory.Abelian.Ext.{u} one₁ (E_free q) d),
      ∃ z_tilde : one₁ ⟶ Y₁ q d,
        (CategoryTheory.Abelian.Ext.mk₀ z_tilde).comp (η_Y q d) (Nat.zero_add d) = γ := by
    intro q d γ
    have h_ind : ∀ (k m : ℕ) (hmk : m + k = d),
        ∃ β : CategoryTheory.Abelian.Ext.{u} one₁ (Y₁ q k) m, β.comp (η_Y q k) hmk = γ := by
      intro k
      induction k with
      | zero =>
        intro m hmk
        have hm : m = d := by omega
        subst hm
        refine ⟨γ.comp (CategoryTheory.Abelian.Ext.mk₀ (eqToHom (hY0 q).symm)) (Nat.add_zero m), ?_⟩
        rw [hηY0 q,
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero γ
            (CategoryTheory.Abelian.Ext.mk₀ (eqToHom (hY0 q).symm))
            (CategoryTheory.Abelian.Ext.mk₀ (eqToHom (hY0 q))) (Nat.add_zero m),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.eqToHom_trans,
          CategoryTheory.eqToHom_refl, CategoryTheory.Abelian.Ext.comp_mk₀_id]
      | succ k ih =>
        intro m hmk
        obtain ⟨β_k, hβ_k⟩ := ih (m + 1) (by omega)
        have hDimI : CategoryTheory.HasInjectiveDimensionLT (I₁ q k) 1 :=
          CategoryTheory.injective_iff_hasInjectiveDimensionLT_one.mp (hInj₁ q k)
        have hSubI : Subsingleton (CategoryTheory.Abelian.Ext.{u} one₁ (I₁ q k) (m + 1)) :=
          CategoryTheory.HasInjectiveDimensionLT.subsingleton (hX := hDimI) (I₁ q k) 1 (m + 1)
            (Nat.le_add_left 1 m) one₁
        have h0 : β_k.comp (CategoryTheory.Abelian.Ext.mk₀ (ι_Y q k)) (Nat.add_zero (m + 1)) = 0 :=
          @Subsingleton.elim _ hSubI _ _
        obtain ⟨β_succ, h_lift⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ one₁ (hEx_Y q k) β_k h0 rfl
        refine ⟨β_succ, ?_⟩
        rw [hηYSucc q k,
          ← CategoryTheory.Abelian.Ext.comp_assoc β_succ (hEx_Y q k).extClass (η_Y q k)
            rfl (Nat.one_add k) (by omega),
          h_lift]
        exact hβ_k
    obtain ⟨β_d, hβ_d⟩ := h_ind d 0 (Nat.zero_add d)
    refine ⟨CategoryTheory.Abelian.Ext.homEquiv₀ β_d, ?_⟩
    rw [CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply]
    exact hβ_d

  
  have h_cob_bwd_Y : ∀ (q d : ℕ) (g : one₁ ⟶ Y₁ q d),
      ((d = 0 ∧ g = 0) ∨
        ∃ (p : ℕ) (hp : p + 1 = d) (a : one₁ ⟶ I₁ q p),
          CategoryTheory.CategoryStruct.comp a
            (CategoryTheory.CategoryStruct.comp (π_Y q p)
              (eqToHom (congrArg (Y₁ q) hp))) = g) →
      (CategoryTheory.Abelian.Ext.mk₀ g).comp (η_Y q d) (Nat.zero_add d) = 0 := by
    intro q d g h_disj
    rcases h_disj with ⟨rfl, rfl⟩ | ⟨p, hp, a, ha⟩
    · rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.zero_comp]
    · subst hp
      subst ha
      simp only [CategoryTheory.eqToHom_refl, CategoryTheory.Category.comp_id]
      rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ a (π_Y q p), hηYSucc q p,
        CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
          (CategoryTheory.Abelian.Ext.mk₀ a)
          (CategoryTheory.Abelian.Ext.mk₀ (π_Y q p))
          (((hEx_Y q p).extClass).comp (η_Y q p) (Nat.one_add p))
          (Nat.zero_add (p + 1)),
        CategoryTheory.ShortComplex.ShortExact.comp_extClass_assoc (hEx_Y q p) (η_Y q p)
          (Nat.one_add p),
        CategoryTheory.Abelian.Ext.comp_zero]

  
  have h_pos_inj_Z : ∀ (k m r : ℕ) (hmr : (m + 1) + k = r)
      (β : CategoryTheory.Abelian.Ext.{u} one₂ (Z₂ k) (m + 1)),
      β.comp (η₂ k) hmr = 0 → β = 0 := by
    intro k
    induction k with
    | zero =>
      intro m r hmr β hβ
      have hr : m + 1 = r := by omega
      subst hr
      have hpost := congrArg
        (fun x => x.comp (CategoryTheory.Abelian.Ext.mk₀ (eqToHom hZ0.symm)) (Nat.add_zero (m + 1)))
        hβ
      rw [CategoryTheory.Abelian.Ext.zero_comp, hη0,
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero β
          (CategoryTheory.Abelian.Ext.mk₀ (eqToHom hZ0))
          (CategoryTheory.Abelian.Ext.mk₀ (eqToHom hZ0.symm)) (Nat.add_zero (m + 1)),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.eqToHom_trans,
        CategoryTheory.eqToHom_refl, CategoryTheory.Abelian.Ext.comp_mk₀_id] at hpost
      exact hpost
    | succ k ih =>
      intro m r hmr β hβ
      rw [hηSucc k,
        ← CategoryTheory.Abelian.Ext.comp_assoc β (hEx_Z k).extClass (η₂ k)
          (rfl : (m + 1) + 1 = (m + 1) + 1) (Nat.one_add k) (by omega)] at hβ
      have hβ_ext : β.comp (hEx_Z k).extClass (rfl : (m + 1) + 1 = (m + 1) + 1) = 0 :=
        ih (m + 1) r (by omega) _ hβ
      obtain ⟨x₂, hx₂⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ one₂ (hEx_Z k) β rfl hβ_ext
      have hDimJ : CategoryTheory.HasInjectiveDimensionLT (J₂ k) 1 :=
        CategoryTheory.injective_iff_hasInjectiveDimensionLT_one.mp (hInj₂ k)
      have hSubJ : Subsingleton (CategoryTheory.Abelian.Ext.{u} one₂ (J₂ k) (m + 1)) :=
        CategoryTheory.HasInjectiveDimensionLT.subsingleton (hX := hDimJ) (J₂ k) 1 (m + 1)
          (Nat.le_add_left 1 m) one₂
      have hx₂0 : x₂ = 0 := @Subsingleton.elim _ hSubJ _ _
      rw [← hx₂, hx₂0, CategoryTheory.Abelian.Ext.zero_comp]

  have h_cob_fwd_Z : ∀ (d : ℕ) (g : one₂ ⟶ Z₂ d),
      (CategoryTheory.Abelian.Ext.mk₀ g).comp (η₂ d) (Nat.zero_add d) = 0 →
      (d = 0 ∧ g = 0) ∨
        ∃ (p : ℕ) (hp : p + 1 = d) (b_tilde : one₂ ⟶ J₂ p),
          CategoryTheory.CategoryStruct.comp b_tilde
            (CategoryTheory.CategoryStruct.comp (π_Z p) (eqToHom (congrArg Z₂ hp))) = g := by
    intro d g hg
    rcases d with _ | p
    · left
      refine ⟨rfl, ?_⟩
      rw [hη0, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.mk₀_zero] at hg
      have hg_eq := h_mk₀_inj _ _ hg
      have hg_id := congrArg (fun u => CategoryTheory.CategoryStruct.comp u (eqToHom hZ0.symm)) hg_eq
      simpa [CategoryTheory.Category.assoc] using hg_id
    · right
      rw [hηSucc p,
        ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ g)
          (hEx_Z p).extClass (η₂ p) (Nat.zero_add 1) (Nat.one_add p) (by omega)] at hg
      have hg_ext : (CategoryTheory.Abelian.Ext.mk₀ g).comp (hEx_Z p).extClass (Nat.zero_add 1) = 0 :=
        h_pos_inj_Z p 0 (p + 1) (Nat.one_add p) _ hg
      obtain ⟨x₂, hx₂⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ one₂ (hEx_Z p)
          (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.zero_add 1) hg_ext
      let b_tilde : one₂ ⟶ J₂ p := CategoryTheory.Abelian.Ext.homEquiv₀ x₂
      have hb_mk : CategoryTheory.Abelian.Ext.mk₀ b_tilde = x₂ :=
        CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply x₂
      rw [← hb_mk, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hx₂
      have hb_eq : CategoryTheory.CategoryStruct.comp b_tilde (π_Z p) = g :=
        h_mk₀_inj _ _ hx₂
      refine ⟨p, rfl, b_tilde, ?_⟩
      simpa [CategoryTheory.eqToHom_refl, CategoryTheory.Category.comp_id] using hb_eq

  
  let ω₀ (q : ℕ) : CategoryTheory.Abelian.Ext.{u} (P_pull.obj (E_free q)) one₂ q :=
    (CategoryTheory.Abelian.Ext.mk₀ ((adj.homEquiv (E_free q) (Z₂ q)).symm (hat_ψ q))).comp
      (η₂ q) (Nat.zero_add q)

  have h_ladder : ∃ (f_lad : ∀ q s : ℕ, I₁ q s ⟶ P_push.obj (J₂ (q + s)))
      (v_lad : ∀ q s : ℕ, P_pull.obj (Y₁ q s) ⟶ Z₂ (q + s)),
      (∀ q : ℕ,
        CategoryTheory.CategoryStruct.comp (ι_Y q 0) (f_lad q 0) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp (eqToHom (hY0 q)) (hat_ψ q))
            (P_push.map (ι_Z q))) ∧
      (∀ q s : ℕ,
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp (π_Y q s) (ι_Y q (s + 1))) (f_lad q (s + 1)) =
        CategoryTheory.CategoryStruct.comp (f_lad q s)
          (CategoryTheory.CategoryStruct.comp
            (P_push.map (π_Z (q + s))) (P_push.map (ι_Z (q + s + 1))))) ∧
      (∀ q s : ℕ,
        (adj.homEquiv (Y₁ q s) (J₂ (q + s)))
          (CategoryTheory.CategoryStruct.comp (v_lad q s) (ι_Z (q + s))) =
          CategoryTheory.CategoryStruct.comp (ι_Y q s) (f_lad q s)) ∧
      (∀ q s : ℕ,
        (CategoryTheory.Abelian.Ext.mk₀ (v_lad q s)).comp (η₂ (q + s)) (Nat.zero_add (q + s)) =
          (P_pull.mapExtAddHom (Y₁ q s) (E_free q) s (η_Y q s)).comp (ω₀ q) (Nat.add_comm s q)) := by
    let S_Y (q s : ℕ) : CategoryTheory.ShortComplex 𝒞₁ :=
      CategoryTheory.ShortComplex.mk (ι_Y q s) (π_Y q s) (hz_Y q s)
    have hEx_pull : ∀ q s : ℕ, ((S_Y q s).map P_pull).ShortExact :=
      fun q s => (hEx_Y q s).map_of_exact P_pull
    have h_step_ex : ∀ (q s : ℕ) (v : P_pull.obj (Y₁ q s) ⟶ Z₂ (q + s)),
        ∃ (f : P_pull.obj (I₁ q s) ⟶ J₂ (q + s))
          (v' : P_pull.obj (Y₁ q (s + 1)) ⟶ Z₂ (q + (s + 1))),
          CategoryTheory.CategoryStruct.comp (P_pull.map (ι_Y q s)) f =
            CategoryTheory.CategoryStruct.comp v (ι_Z (q + s)) ∧
          CategoryTheory.CategoryStruct.comp (P_pull.map (π_Y q s)) v' =
            CategoryTheory.CategoryStruct.comp f (π_Z (q + s)) := by
      intro q s v
      have := hInj₂ (q + s)
      have : CategoryTheory.Mono (P_pull.map (ι_Y q s)) := (hEx_pull q s).mono_f
      let f : P_pull.obj (I₁ q s) ⟶ J₂ (q + s) :=
        CategoryTheory.Injective.factorThru
          (CategoryTheory.CategoryStruct.comp v (ι_Z (q + s))) (P_pull.map (ι_Y q s))
      have hf : CategoryTheory.CategoryStruct.comp (P_pull.map (ι_Y q s)) f =
          CategoryTheory.CategoryStruct.comp v (ι_Z (q + s)) :=
        CategoryTheory.Injective.comp_factorThru
          (CategoryTheory.CategoryStruct.comp v (ι_Z (q + s))) (P_pull.map (ι_Y q s))
      have hzero : CategoryTheory.CategoryStruct.comp ((S_Y q s).map P_pull).f
          (CategoryTheory.CategoryStruct.comp f (π_Z (q + s))) = 0 := by
        change CategoryTheory.CategoryStruct.comp (P_pull.map (ι_Y q s))
          (CategoryTheory.CategoryStruct.comp f (π_Z (q + s))) = 0
        rw [← CategoryTheory.Category.assoc, hf, CategoryTheory.Category.assoc,
          hz_Z (q + s), CategoryTheory.Limits.comp_zero]
      let d := CategoryTheory.Limits.CokernelCofork.IsColimit.desc'
        (hEx_pull q s).gIsCokernel
        (CategoryTheory.CategoryStruct.comp f (π_Z (q + s))) hzero
      exact ⟨f, d.1, hf, by simpa using d.2⟩
    choose step_f step_v h_comm₁₂ h_comm₂₃ using h_step_ex
    let v_lad (q s : ℕ) : P_pull.obj (Y₁ q s) ⟶ Z₂ (q + s) :=
      Nat.rec (motive := fun s => P_pull.obj (Y₁ q s) ⟶ Z₂ (q + s))
        (CategoryTheory.CategoryStruct.comp (P_pull.map (eqToHom (hY0 q)))
          ((adj.homEquiv (E_free q) (Z₂ q)).symm (hat_ψ q)))
        (fun s v_s => step_v q s v_s) s
    let f_W (q s : ℕ) : P_pull.obj (I₁ q s) ⟶ J₂ (q + s) := step_f q s (v_lad q s)
    let f_lad (q s : ℕ) : I₁ q s ⟶ P_push.obj (J₂ (q + s)) :=
      (adj.homEquiv (I₁ q s) (J₂ (q + s))) (f_W q s)
    have hfAdj : ∀ q s : ℕ,
        (adj.homEquiv (Y₁ q s) (J₂ (q + s)))
          (CategoryTheory.CategoryStruct.comp (v_lad q s) (ι_Z (q + s))) =
          CategoryTheory.CategoryStruct.comp (ι_Y q s) (f_lad q s) := by
      intro q s
      dsimp only [f_lad, f_W]
      rw [← h_comm₁₂ q s (v_lad q s), adj.homEquiv_naturality_left]
    have hf0 : ∀ q : ℕ,
        CategoryTheory.CategoryStruct.comp (ι_Y q 0) (f_lad q 0) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp (eqToHom (hY0 q)) (hat_ψ q))
            (P_push.map (ι_Z q)) := by
      intro q
      rw [← hfAdj q 0, adj.homEquiv_naturality_right]
      change CategoryTheory.CategoryStruct.comp
        ((adj.homEquiv (Y₁ q 0) (Z₂ q))
          (CategoryTheory.CategoryStruct.comp (P_pull.map (eqToHom (hY0 q)))
            ((adj.homEquiv (E_free q) (Z₂ q)).symm (hat_ψ q))))
        (P_push.map (ι_Z q)) = _
      rw [adj.homEquiv_naturality_left, Equiv.apply_symm_apply]
    have hfSucc : ∀ q s : ℕ,
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp (π_Y q s) (ι_Y q (s + 1))) (f_lad q (s + 1)) =
        CategoryTheory.CategoryStruct.comp (f_lad q s)
          (CategoryTheory.CategoryStruct.comp
            (P_push.map (π_Z (q + s))) (P_push.map (ι_Z (q + s + 1)))) := by
      intro q s
      have hsq : CategoryTheory.CategoryStruct.comp
          (P_pull.map (CategoryTheory.CategoryStruct.comp (π_Y q s) (ι_Y q (s + 1))))
          (f_W q (s + 1)) =
          CategoryTheory.CategoryStruct.comp (f_W q s)
            (CategoryTheory.CategoryStruct.comp (π_Z (q + s)) (ι_Z (q + s + 1))) := by
        dsimp only [f_W]
        change CategoryTheory.CategoryStruct.comp
          (P_pull.map (CategoryTheory.CategoryStruct.comp (π_Y q s) (ι_Y q (s + 1))))
          (step_f q (s + 1) (step_v q s (v_lad q s))) = _
        rw [P_pull.map_comp, CategoryTheory.Category.assoc,
          h_comm₁₂ q (s + 1) (step_v q s (v_lad q s)),
          ← CategoryTheory.Category.assoc, h_comm₂₃ q s (v_lad q s),
          CategoryTheory.Category.assoc]
        rfl
      rw [← P_push.map_comp]
      exact adj.homEquiv_naturality_left_square
        (CategoryTheory.CategoryStruct.comp (π_Y q s) (ι_Y q (s + 1)))
        (f_W q (s + 1)) (f_W q s)
        (CategoryTheory.CategoryStruct.comp (π_Z (q + s)) (ι_Z (q + s + 1))) hsq
    have hvComm : ∀ q s : ℕ,
        (CategoryTheory.Abelian.Ext.mk₀ (v_lad q s)).comp (η₂ (q + s)) (Nat.zero_add (q + s)) =
          (P_pull.mapExtAddHom (Y₁ q s) (E_free q) s (η_Y q s)).comp (ω₀ q) (Nat.add_comm s q) := by
      intro q s
      induction s with
      | zero =>
        change (CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.CategoryStruct.comp (P_pull.map (eqToHom (hY0 q)))
            ((adj.homEquiv (E_free q) (Z₂ q)).symm (hat_ψ q)))).comp
          (η₂ q) (Nat.zero_add q) = _
        rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, hηY0 q,
          CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      | succ s ih =>
        let φ_s : (S_Y q s).map P_pull ⟶
            CategoryTheory.ShortComplex.mk (ι_Z (q + s)) (π_Z (q + s)) (hz_Z (q + s)) :=
          CategoryTheory.ShortComplex.homMk (v_lad q s) (f_W q s) (v_lad q (s + 1))
            (h_comm₁₂ q s (v_lad q s)).symm (h_comm₂₃ q s (v_lad q s)).symm
        have hnat : ((hEx_pull q s).extClass).comp
            (CategoryTheory.Abelian.Ext.mk₀ (v_lad q s)) (Nat.add_zero 1) =
            (CategoryTheory.Abelian.Ext.mk₀ (v_lad q (s + 1))).comp
              ((hEx_Z (q + s)).extClass) (Nat.zero_add 1) :=
          CategoryTheory.ShortComplex.ShortExact.extClass_naturality
            (hEx_pull q s) (hEx_Z (q + s)) φ_s
        rw [hηYSucc q s]
        change (CategoryTheory.Abelian.Ext.mk₀ (v_lad q (s + 1))).comp
          (η₂ (q + s + 1)) (Nat.zero_add (q + s + 1)) = _
        rw [hηSucc (q + s),
          ← CategoryTheory.Abelian.Ext.comp_assoc
            (CategoryTheory.Abelian.Ext.mk₀ (v_lad q (s + 1)))
            (hEx_Z (q + s)).extClass (η₂ (q + s))
            (Nat.zero_add 1) (Nat.one_add (q + s)) (by omega),
          ← hnat,
          CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
            (hEx_pull q s).extClass
            (CategoryTheory.Abelian.Ext.mk₀ (v_lad q s))
            (η₂ (q + s)) (Nat.one_add (q + s)),
          ih,
          ← CategoryTheory.Abelian.Ext.comp_assoc
            (hEx_pull q s).extClass
            (P_pull.mapExtAddHom (Y₁ q s) (E_free q) s (η_Y q s))
            (ω₀ q) (Nat.one_add s) (Nat.add_comm s q) (by omega),
          CategoryTheory.Functor.mapExtAddHom_apply P_pull (Y₁ q s) (E_free q) s (η_Y q s),
          CategoryTheory.Functor.mapExtAddHom_apply P_pull (Y₁ q (s + 1)) (E_free q) (s + 1),
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass P_pull (hEx_Y q s)]
    exact ⟨f_lad, v_lad, hf0, hfSucc, hfAdj, hvComm⟩
  obtain ⟨f_lad, v_lad, hf0, hfSucc, hfAdj, hvComm⟩ := h_ladder

  
  refine ⟨Y₁, I₁, hY0, hInj₁, ι_Y, π_Y, hz_Y, hEx_Y, f_lad, hf0, hfSucc, ?_⟩
  intro i₁ i₂ α hCup0
  let α_tot : CategoryTheory.Abelian.Ext.{u} one₁ (E_free i₂) i₁ :=
    ∑ t : Fin (b i₂),
      (α t).comp (CategoryTheory.Abelian.Ext.mk₀ (incl₁ i₂ t)) (Nat.add_zero i₁)

  
  have hRetr : ∀ t' : Fin (b i₂),
      α_tot.comp (CategoryTheory.Abelian.Ext.mk₀ (proj₁ i₂ t')) (Nat.add_zero i₁) = α t' := by
    intro t'
    let Φ_proj := (CategoryTheory.Abelian.Ext.mk₀ (proj₁ i₂ t')).postcomp one₁ (Nat.add_zero i₁)
    change Φ_proj α_tot = α t'
    dsimp only [α_tot]
    rw [map_sum, Finset.sum_eq_single t' (fun t _ htt' => ?_)
      (fun ht' => absurd (Finset.mem_univ t') ht')]
    · change ((α t').comp (CategoryTheory.Abelian.Ext.mk₀ (incl₁ i₂ t')) (Nat.add_zero i₁)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (proj₁ i₂ t')) (Nat.add_zero i₁) = α t'
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero (α t')
          (CategoryTheory.Abelian.Ext.mk₀ (incl₁ i₂ t'))
          (CategoryTheory.Abelian.Ext.mk₀ (proj₁ i₂ t')) (Nat.add_zero i₁),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hCoord i₂ t' t']
      simp only [↓reduceIte, CategoryTheory.Abelian.Ext.comp_mk₀_id]
    · change ((α t).comp (CategoryTheory.Abelian.Ext.mk₀ (incl₁ i₂ t)) (Nat.add_zero i₁)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (proj₁ i₂ t')) (Nat.add_zero i₁) = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero (α t)
          (CategoryTheory.Abelian.Ext.mk₀ (incl₁ i₂ t))
          (CategoryTheory.Abelian.Ext.mk₀ (proj₁ i₂ t')) (Nat.add_zero i₁),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hCoord i₂ t t']
      simp only [htt', ↓reduceIte, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.comp_zero]

  
  have h_mate_sum : (adj.homEquiv (E_free i₂) (Z₂ i₂)).symm (hat_ψ i₂) =
      ∑ t : Fin (b i₂),
        CategoryTheory.CategoryStruct.comp (P_pull.map (proj₁ i₂ t))
          (CategoryTheory.CategoryStruct.comp e_unit.inv (g_tilde i₂ t)) := by
    rw [adj.homEquiv_counit]
    dsimp only [hat_ψ]
    rw [CategoryTheory.Functor.map_sum, CategoryTheory.Preadditive.sum_comp]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [← adj.homEquiv_counit, adj.homEquiv_naturality_left_symm, Equiv.symm_apply_apply]

  have hω₀_sum : ω₀ i₂ =
      ∑ t : Fin (b i₂),
        (CategoryTheory.Abelian.Ext.mk₀ (P_pull.map (proj₁ i₂ t))).comp
          ((CategoryTheory.Abelian.Ext.mk₀ e_unit.inv).comp (w₂ i₂ t) (Nat.zero_add i₂))
          (Nat.zero_add i₂) := by
    let Ψ_η := ((η₂ i₂).postcomp (P_pull.obj (E_free i₂)) (Nat.zero_add i₂)).comp
      CategoryTheory.Abelian.Ext.addEquiv₀.symm.toAddMonoidHom
    have hΨ : ω₀ i₂ = Ψ_η ((adj.homEquiv (E_free i₂) (Z₂ i₂)).symm (hat_ψ i₂)) := by
      dsimp only [Ψ_η, ω₀]
      simp [CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
    rw [hΨ, h_mate_sum, map_sum]
    refine Finset.sum_congr rfl fun t _ => ?_
    dsimp only [Ψ_η]
    simp only [AddMonoidHom.coe_comp, AddEquiv.coe_toAddMonoidHom, Function.comp_apply,
      CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
    change (CategoryTheory.Abelian.Ext.mk₀
        (CategoryTheory.CategoryStruct.comp (P_pull.map (proj₁ i₂ t))
          (CategoryTheory.CategoryStruct.comp e_unit.inv (g_tilde i₂ t)))).comp
        (η₂ i₂) (Nat.zero_add i₂) = _
    rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, hg_tilde i₂ t]

  
  obtain ⟨z_tilde, hz_tilde⟩ := h_lift_Y i₂ i₁ α_tot
  let z₀ : one₁ ⟶ I₁ i₂ i₁ := CategoryTheory.CategoryStruct.comp z_tilde (ι_Y i₂ i₁)

  refine ⟨z₀, ?_, ?_, ?_⟩
  · 
    dsimp only [z₀]
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (ι_Y i₂ i₁),
      hz_Y i₂ i₁, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
  · 
    let g_W : one₂ ⟶ Z₂ (i₂ + i₁) :=
      CategoryTheory.CategoryStruct.comp e_unit.hom
        (CategoryTheory.CategoryStruct.comp (P_pull.map z_tilde) (v_lad i₂ i₁))
    have hMate_gW : (adj.homEquiv one₁ (J₂ (i₂ + i₁)))
        (CategoryTheory.CategoryStruct.comp e_unit.inv
          (CategoryTheory.CategoryStruct.comp g_W (ι_Z (i₂ + i₁)))) =
        CategoryTheory.CategoryStruct.comp z₀ (f_lad i₂ i₁) := by
      have h_cancel : CategoryTheory.CategoryStruct.comp e_unit.inv
          (CategoryTheory.CategoryStruct.comp g_W (ι_Z (i₂ + i₁))) =
          CategoryTheory.CategoryStruct.comp (P_pull.map z_tilde)
            (CategoryTheory.CategoryStruct.comp (v_lad i₂ i₁) (ι_Z (i₂ + i₁))) := by
        dsimp only [g_W]
        rw [← CategoryTheory.Category.assoc e_unit.inv,
          ← CategoryTheory.Category.assoc e_unit.inv, e_unit.inv_hom_id,
          CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc]
      rw [h_cancel, adj.homEquiv_naturality_left, hfAdj i₂ i₁, ← CategoryTheory.Category.assoc]
    have hgW_sum : (CategoryTheory.Abelian.Ext.mk₀ g_W).comp (η₂ (i₂ + i₁))
        (Nat.zero_add (i₂ + i₁)) =
        ∑ t : Fin (b i₂),
          ((CategoryTheory.Abelian.Ext.mk₀ e_unit.hom).comp
            (((P_pull.mapExtAddHom one₁ one₁ i₁ (α t)).comp
              (CategoryTheory.Abelian.Ext.mk₀ e_unit.inv) (Nat.add_zero i₁)))
            (Nat.zero_add i₁)).comp (w₂ i₂ t) (Nat.add_comm i₁ i₂) := by
      dsimp only [g_W]
      rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
        hvComm i₂ i₁,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (P_pull.map z_tilde))
          (P_pull.mapExtAddHom (Y₁ i₂ i₁) (E_free i₂) i₁ (η_Y i₂ i₁))
          (ω₀ i₂) (Nat.zero_add i₁) (Nat.add_comm i₁ i₂) (by omega)]
      have h_pull_zt : (CategoryTheory.Abelian.Ext.mk₀ (P_pull.map z_tilde)).comp
          (P_pull.mapExtAddHom (Y₁ i₂ i₁) (E_free i₂) i₁ (η_Y i₂ i₁)) (Nat.zero_add i₁) =
          P_pull.mapExtAddHom one₁ (E_free i₂) i₁ α_tot := by
        rw [← hz_tilde,
          CategoryTheory.Functor.mapExtAddHom_apply P_pull (Y₁ i₂ i₁) (E_free i₂) i₁,
          CategoryTheory.Functor.mapExtAddHom_apply P_pull one₁ (E_free i₂) i₁,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rw [h_pull_zt, hω₀_sum]
      let Φ_left := ((CategoryTheory.Abelian.Ext.mk₀ e_unit.hom).precomp one₂
        (Nat.zero_add (i₂ + i₁))).comp
        ((P_pull.mapExtAddHom one₁ (E_free i₂) i₁ α_tot).precomp one₂ (Nat.add_comm i₁ i₂))
      change Φ_left _ = _
      rw [map_sum]
      refine Finset.sum_congr rfl fun t _ => ?_
      change (CategoryTheory.Abelian.Ext.mk₀ e_unit.hom).comp
        ((P_pull.mapExtAddHom one₁ (E_free i₂) i₁ α_tot).comp _ (Nat.add_comm i₁ i₂))
        (Nat.zero_add (i₂ + i₁)) = _
      have h_pull_pr : (P_pull.mapExtAddHom one₁ (E_free i₂) i₁ α_tot).comp
          (CategoryTheory.Abelian.Ext.mk₀ (P_pull.map (proj₁ i₂ t))) (Nat.add_zero i₁) =
          P_pull.mapExtAddHom one₁ one₁ i₁ (α t) := by
        rw [← hRetr t,
          CategoryTheory.Functor.mapExtAddHom_apply P_pull one₁ (E_free i₂) i₁,
          CategoryTheory.Functor.mapExtAddHom_apply P_pull one₁ one₁ i₁,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rw [← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
          (P_pull.mapExtAddHom one₁ (E_free i₂) i₁ α_tot)
          (CategoryTheory.Abelian.Ext.mk₀ (P_pull.map (proj₁ i₂ t)))
          ((CategoryTheory.Abelian.Ext.mk₀ e_unit.inv).comp (w₂ i₂ t) (Nat.zero_add i₂))
          (Nat.add_comm i₁ i₂),
        h_pull_pr,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
          (P_pull.mapExtAddHom one₁ one₁ i₁ (α t))
          (CategoryTheory.Abelian.Ext.mk₀ e_unit.inv)
          (w₂ i₂ t) (Nat.add_comm i₁ i₂),
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ e_unit.hom)
          ((P_pull.mapExtAddHom one₁ one₁ i₁ (α t)).comp
            (CategoryTheory.Abelian.Ext.mk₀ e_unit.inv) (Nat.add_zero i₁))
          (w₂ i₂ t) (Nat.zero_add i₁) (Nat.add_comm i₁ i₂) (by omega)]
    have hDegEq : ∀ {d₁ d₂ : ℕ} (hd : d₁ = d₂) (h₁ : i₁ + i₂ = d₁) (h₂ : i₁ + i₂ = d₂),
        ∑ t : Fin (b i₂),
          ((CategoryTheory.Abelian.Ext.mk₀ e_unit.hom).comp
            (((P_pull.mapExtAddHom one₁ one₁ i₁ (α t)).comp
              (CategoryTheory.Abelian.Ext.mk₀ e_unit.inv) (Nat.add_zero i₁)))
            (Nat.zero_add i₁)).comp (w₂ i₂ t) h₁ = 0 →
        ∑ t : Fin (b i₂),
          ((CategoryTheory.Abelian.Ext.mk₀ e_unit.hom).comp
            (((P_pull.mapExtAddHom one₁ one₁ i₁ (α t)).comp
              (CategoryTheory.Abelian.Ext.mk₀ e_unit.inv) (Nat.add_zero i₁)))
            (Nat.zero_add i₁)).comp (w₂ i₂ t) h₂ = 0 := by
      intro d₁ d₂ hd h₁ h₂ hs
      subst hd
      exact hs
    have hgW_zero : (CategoryTheory.Abelian.Ext.mk₀ g_W).comp (η₂ (i₂ + i₁))
        (Nat.zero_add (i₂ + i₁)) = 0 := by
      rw [hgW_sum]
      exact hDegEq (Nat.add_comm i₁ i₂) rfl (Nat.add_comm i₁ i₂) hCup0
    rcases h_cob_fwd_Z (i₂ + i₁) g_W hgW_zero with ⟨hdeg0, hgW0⟩ | ⟨p, hp, b_tilde, hb_tilde⟩
    · left
      refine ⟨by omega, ?_⟩
      rw [← hMate_gW, hgW0, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero,
        adj.homEquiv_unit, P_push.map_zero, CategoryTheory.Limits.comp_zero]
    · right
      let b_K : one₁ ⟶ P_push.obj (J₂ p) :=
        (adj.homEquiv one₁ (J₂ p)) (CategoryTheory.CategoryStruct.comp e_unit.inv b_tilde)
      have h_cob_K : ∀ {k : ℕ} (hp' : p + 1 = k) (g : one₂ ⟶ Z₂ k),
          CategoryTheory.CategoryStruct.comp b_tilde
            (CategoryTheory.CategoryStruct.comp (π_Z p) (eqToHom (congrArg Z₂ hp'))) = g →
          CategoryTheory.CategoryStruct.comp b_K
            (CategoryTheory.CategoryStruct.comp (P_push.map (π_Z p))
              (CategoryTheory.CategoryStruct.comp (P_push.map (ι_Z (p + 1)))
                (eqToHom (congrArg (fun m => P_push.obj (J₂ m)) hp')))) =
            (adj.homEquiv one₁ (J₂ k))
              (CategoryTheory.CategoryStruct.comp e_unit.inv
                (CategoryTheory.CategoryStruct.comp g (ι_Z k))) := by
        intro k hp' g hg
        subst hp'
        subst hg
        simp only [CategoryTheory.eqToHom_refl, CategoryTheory.Category.comp_id]
        dsimp only [b_K]
        rw [← CategoryTheory.Category.assoc, ← adj.homEquiv_naturality_right,
          ← adj.homEquiv_naturality_right]
        simp only [CategoryTheory.Category.assoc]
      refine ⟨p, hp, b_K, ?_⟩
      rw [h_cob_K hp g_W hb_tilde, hMate_gW]
  · 
    intro N hNz t
    have hMonoY : ∀ s : ℕ, CategoryTheory.Mono (ι_Y i₂ s) :=
      fun s => (hEx_Y i₂ s).mono_f
    have hNz₀_eq : N • z₀ = CategoryTheory.CategoryStruct.comp (N • z_tilde) (ι_Y i₂ i₁) := by
      dsimp only [z₀]
      simp only [CategoryTheory.Preadditive.nsmul_comp]
    have h_zt_cob : (i₁ = 0 ∧ N • z_tilde = 0) ∨
        ∃ (p₁ : ℕ) (hp₁ : p₁ + 1 = i₁) (a₀ : one₁ ⟶ I₁ i₂ p₁),
          CategoryTheory.CategoryStruct.comp a₀
            (CategoryTheory.CategoryStruct.comp (π_Y i₂ p₁)
              (eqToHom (congrArg (Y₁ i₂) hp₁))) = N • z_tilde := by
      rcases hNz with ⟨hi₁, hNz0⟩ | ⟨p₁, hp₁, a₀, ha₀⟩
      · left
        have := hMonoY i₁
        refine ⟨hi₁, (CategoryTheory.cancel_mono (ι_Y i₂ i₁)).mp ?_⟩
        rw [← hNz₀_eq, hNz0, CategoryTheory.Limits.zero_comp]
      · right
        have h_cob_Y : ∀ {k₁ : ℕ} (hp₁' : p₁ + 1 = k₁) (zt : one₁ ⟶ Y₁ i₂ k₁),
            CategoryTheory.CategoryStruct.comp a₀
              (CategoryTheory.CategoryStruct.comp (π_Y i₂ p₁)
                (CategoryTheory.CategoryStruct.comp (ι_Y i₂ (p₁ + 1))
                  (eqToHom (congrArg (I₁ i₂) hp₁')))) =
              CategoryTheory.CategoryStruct.comp zt (ι_Y i₂ k₁) →
            CategoryTheory.CategoryStruct.comp a₀
              (CategoryTheory.CategoryStruct.comp (π_Y i₂ p₁)
                (eqToHom (congrArg (Y₁ i₂) hp₁'))) = zt := by
          intro k₁ hp₁' zt h_eq
          subst hp₁'
          have := hMonoY (p₁ + 1)
          simp only [CategoryTheory.eqToHom_refl, CategoryTheory.Category.comp_id] at h_eq ⊢
          exact (CategoryTheory.cancel_mono (ι_Y i₂ (p₁ + 1))).mp
            (by simpa [CategoryTheory.Category.assoc] using h_eq)
        rw [hNz₀_eq] at ha₀
        exact ⟨p₁, hp₁, a₀, h_cob_Y hp₁ (N • z_tilde) ha₀⟩
    have hNα_tot : N • α_tot = 0 := by
      let Φ_η := ((η_Y i₂ i₁).postcomp one₁ (Nat.zero_add i₁)).comp
        CategoryTheory.Abelian.Ext.addEquiv₀.symm.toAddMonoidHom
      have hΦ_zt : Φ_η z_tilde = α_tot := by
        dsimp only [Φ_η]
        simpa [CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply] using hz_tilde
      have hΦ_Nzt : Φ_η (N • z_tilde) =
          (CategoryTheory.Abelian.Ext.mk₀ (N • z_tilde)).comp (η_Y i₂ i₁) (Nat.zero_add i₁) := by
        dsimp only [Φ_η]
        simp [CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
      rw [← hΦ_zt, ← map_nsmul, hΦ_Nzt]
      exact h_cob_bwd_Y i₂ i₁ (N • z_tilde) h_zt_cob
    let Φ_proj_t := (CategoryTheory.Abelian.Ext.mk₀ (proj₁ i₂ t)).postcomp one₁ (Nat.add_zero i₁)
    have hΦ_t : Φ_proj_t α_tot = α t := hRetr t
    rw [← hΦ_t, ← map_nsmul, hNα_tot, map_zero]

theorem weil_etale_external_cup_cochain_bridge_of_local_constancy (S₁ S₂ S_W : AlgebraicGeometry.Scheme.{u})
    (pr₁ : Quiver.Hom S_W S₁) (pr₂ : Quiver.Hom S_W S₂)
