          (fun β => δ.comp β (Nat.add_comm 1 q))
          (fun β₁ β₂ => CategoryTheory.Abelian.Ext.comp_add δ β₁ β₂ (Nat.add_comm 1 q))
      let p_top : CategoryTheory.Abelian.Ext.{u} Q oneR (q + 1) →+
          CategoryTheory.Abelian.Ext.{u} A oneR (q + 1) :=
        AddMonoidHom.mk'
          (fun γ => (CategoryTheory.Abelian.Ext.mk₀ πG).comp γ (Nat.zero_add (q + 1)))
