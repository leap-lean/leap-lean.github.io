      (∀ (ℐ : CategoryTheory.Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} R))
        [CategoryTheory.Injective ℐ], CategoryTheory.Injective (i_push.obj ℐ)) := by
    dsimp only
    let R := ULift.{u, 0} (ZMod m)
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    letI := hc_i
    let B_i : CategoryTheory.Functor Y.Etale Z.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
    let i_push := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R)
      Y.smallEtaleTopology Z.smallEtaleTopology
    let i_push_ab := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilAltCdSitePullback i) AddCommGrpCat.{u} _
      Y.smallEtaleTopology Z.smallEtaleTopology hc_ab
    let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    let e_ring : R ≃+* ZMod m := ULift.ringEquiv
    have hm_zero : (m : R) = 0 :=
      e_ring.injective ((map_natCast e_ring m).trans ((ZMod.natCast_self m).trans (map_zero e_ring).symm))
    have hIntSurj : ∀ r : R, ∃ k : ℤ, (k : R) = r := fun r => by
      obtain ⟨k, hk⟩ := ZMod.intCast_surjective (e_ring r)
      exact ⟨k, e_ring.injective ((map_intCast e_ring k).trans hk)⟩
    let liftLinear : ∀ {M₁ M₂ : ModuleCat.{u, u} R},
        (F_fg.obj M₁ ⟶ F_fg.obj M₂) → (M₁ ⟶ M₂) := fun {M₁ M₂} φ =>
      let f_add : M₁ →+ M₂ := φ.hom
      ModuleCat.ofHom
        { toAddHom := f_add.toAddHom
          map_smul' := fun r x => by
            obtain ⟨k, rfl⟩ := hIntSurj r
            change f_add ((k : R) • x) = (k : R) • f_add x
            rw [Int.cast_smul_eq_zsmul R k x, map_zsmul f_add k x,
              Int.cast_smul_eq_zsmul R k (f_add x)] }
    have hLift_fg : ∀ {M₁ M₂ : ModuleCat.{u, u} R} (φ : F_fg.obj M₁ ⟶ F_fg.obj M₂),
        F_fg.map (liftLinear φ) = φ := fun _ => AddCommGrpCat.ext fun _ => rfl
    have hFg_lift : ∀ {M₁ M₂ : ModuleCat.{u, u} R} (ψ : M₁ ⟶ M₂),
        liftLinear (F_fg.map ψ) = ψ := fun _ => ModuleCat.hom_ext (LinearMap.ext fun _ => rfl)
    have hSheafFg : ∀ (S : AlgebraicGeometry.Scheme.{u})
        (P : CategoryTheory.Functor (Opposite S.Etale) (ModuleCat.{u, u} R)),
        CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology P →
        CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (P ⋙ F_fg) := by
      intro S P hP X
      let K_X : AddSubgroup X :=
        { carrier := Set.range (fun x : X => m • x)
          add_mem' := by rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩; exact ⟨a + b, smul_add m a b⟩
          zero_mem' := ⟨0, smul_zero m⟩
          neg_mem' := by rintro _ ⟨a, rfl⟩; exact ⟨-a, smul_neg m a⟩ }
      let Q_X : Type u := X ⧸ K_X
      have hK_mem : ∀ x : X, m • x ∈ K_X := fun x => ⟨x, rfl⟩
      letI : Module (ZMod m) Q_X := QuotientAddGroup.zmodModule hK_mem
      letI : Module R Q_X := Module.compHom Q_X e_ring.toRingHom
      let L_X : ModuleCat.{u, u} R := ModuleCat.of R Q_X
      let π_X : X ⟶ F_fg.obj L_X := AddCommGrpCat.ofHom (QuotientAddGroup.mk' K_X)
      let e_iso : (P ⋙ CategoryTheory.coyoneda.obj (Opposite.op L_X)) ≅
          ((P ⋙ F_fg) ⋙ CategoryTheory.coyoneda.obj (Opposite.op X)) :=
        CategoryTheory.NatIso.ofComponents
          (fun opU => Equiv.toIso
            { toFun := fun f => π_X ≫ F_fg.map f
              invFun := fun g =>
                liftLinear (AddCommGrpCat.ofHom (QuotientAddGroup.lift K_X g.hom (by
                  rintro _ ⟨a, rfl⟩
                  let g_add : X →+ P.obj opU := g.hom
                  change g_add (m • a) = 0
                  rw [map_nsmul g_add m a, ← Nat.cast_smul_eq_nsmul R m (g_add a),
                    hm_zero, zero_smul])))
              left_inv := fun f =>
                ModuleCat.hom_ext (LinearMap.ext fun q =>
                  QuotientAddGroup.induction_on q fun _ => rfl)
              right_inv := fun g => AddCommGrpCat.ext fun _ => rfl })
          (fun {opU₁ opU₂} u => by
            ext f
            change π_X ≫ F_fg.map (f ≫ P.map u) = (π_X ≫ F_fg.map f) ≫ F_fg.map (P.map u)
            rw [F_fg.map_comp, CategoryTheory.Category.assoc])
      exact CategoryTheory.Presieve.isSheaf_iso S.smallEtaleTopology e_iso (hP L_X)
    have hSheafMod : ∀ (S : AlgebraicGeometry.Scheme.{u})
        (P : CategoryTheory.Functor (Opposite S.Etale) (ModuleCat.{u, u} R)),
        CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (P ⋙ F_fg) →
        CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology P := by
      intro S P hPF M
      let e_iso : ((P ⋙ F_fg) ⋙ CategoryTheory.coyoneda.obj (Opposite.op (F_fg.obj M))) ≅
          (P ⋙ CategoryTheory.coyoneda.obj (Opposite.op M)) :=
        CategoryTheory.NatIso.ofComponents
          (fun opU => Equiv.toIso
            { toFun := fun g => liftLinear g
              invFun := fun f => F_fg.map f
              left_inv := fun g => hLift_fg g
              right_inv := fun f => hFg_lift f })
          (fun {opU₁ opU₂} u => by
            ext g
            change liftLinear (g ≫ F_fg.map (P.map u)) = liftLinear g ≫ P.map u
            apply (fun {M₁ M₂} {a b : M₁ ⟶ M₂} (h : F_fg.map a = F_fg.map b) =>
              (hFg_lift a).symm.trans ((congrArg liftLinear h).trans (hFg_lift b)))
            rw [F_fg.map_comp, hLift_fg, hLift_fg])
      exact CategoryTheory.Presieve.isSheaf_iso S.smallEtaleTopology e_iso (hPF (F_fg.obj M))
    let U_fun : ∀ (S : AlgebraicGeometry.Scheme.{u}),
        CategoryTheory.Functor
          (CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R))
          (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) := fun S =>
      { obj := fun ℱ => ⟨ℱ.obj ⋙ F_fg, hSheafFg S ℱ.obj ℱ.property⟩
        map := fun u => CategoryTheory.ObjectProperty.homMk
          (CategoryTheory.Functor.whiskerRight u.hom F_fg)
        map_id := fun _ => CategoryTheory.Sheaf.hom_ext
          (CategoryTheory.NatTrans.ext (funext fun _ => AddCommGrpCat.ext fun _ => rfl))
        map_comp := fun _ _ => CategoryTheory.Sheaf.hom_ext
          (CategoryTheory.NatTrans.ext (funext fun _ => AddCommGrpCat.ext fun _ => rfl)) }
    let U_equiv : ∀ {S : AlgebraicGeometry.Scheme.{u}}
        (ℱ₁ ℱ₂ : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)),
        (ℱ₁ ⟶ ℱ₂) ≃ ((U_fun S).obj ℱ₁ ⟶ (U_fun S).obj ℱ₂) := fun {S} ℱ₁ ℱ₂ =>
      { toFun := (U_fun S).map
        invFun := fun ψ => CategoryTheory.ObjectProperty.homMk
          { app := fun opV => liftLinear (ψ.hom.app opV)
            naturality := fun {opV₁ opV₂} g => by
              have hnat := ψ.hom.naturality g
              dsimp [U_fun] at hnat
              apply (fun {M₁ M₂} {a b : M₁ ⟶ M₂} h =>
                (hFg_lift a).symm.trans ((congrArg liftLinear h).trans (hFg_lift b)))
              rw [F_fg.map_comp, F_fg.map_comp, hLift_fg, hLift_fg]
              exact hnat }
        left_inv := fun φ => CategoryTheory.Sheaf.hom_ext
          (CategoryTheory.NatTrans.ext (funext fun opV => hFg_lift (φ.hom.app opV)))
        right_inv := fun ψ => CategoryTheory.Sheaf.hom_ext
          (CategoryTheory.NatTrans.ext (funext fun opV => hLift_fg (ψ.hom.app opV))) }
    have hNsmulApp : ∀ {S : AlgebraicGeometry.Scheme.{u}}
        (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (k : ℕ) (opV : Opposite S.Etale) (y : 𝒢.obj.obj opV),
        ((k • CategoryTheory.CategoryStruct.id 𝒢).hom.app opV).hom y = k • y := by
      intro S 𝒢 k opV y
      induction k with
      | zero =>
        rw [zero_nsmul, zero_nsmul]
        rfl
      | succ k' ih =>
        rw [succ_nsmul, CategoryTheory.Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply,
          ih, succ_nsmul]
        rfl
    have hAnn_Z : ∀ (ℱ : CategoryTheory.Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R))
        (opV : Opposite Z.Etale) (y : (P_pull_ab.obj ((U_fun Y).obj ℱ)).obj.obj opV),
        m • y = 0 := by
      intro ℱ opV y
      have hm_Y : m • CategoryTheory.CategoryStruct.id ((U_fun Y).obj ℱ) = 0 := by
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext opW
        apply AddCommGrpCat.ext
        intro x
        rw [hNsmulApp ((U_fun Y).obj ℱ) m opW x]
        let x' : ℱ.obj.obj opW := x
        change m • x' = 0
        rw [← Nat.cast_smul_eq_nsmul R m x', hm_zero, zero_smul]
      haveI : P_pull_ab.Additive := hAdd_ab
      have hm_Z : m • CategoryTheory.CategoryStruct.id (P_pull_ab.obj ((U_fun Y).obj ℱ)) = 0 := by
        rw [← P_pull_ab.map_id, ← P_pull_ab.map_nsmul, hm_Y, P_pull_ab.map_zero]
      have hy := hNsmulApp (P_pull_ab.obj ((U_fun Y).obj ℱ)) m opV y
      rw [hm_Z] at hy
      exact hy.symm
    let mod_Z : ∀ (ℱ : CategoryTheory.Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R))
        (opV : Opposite Z.Etale),
        Module R ↥((P_pull_ab.obj ((U_fun Y).obj ℱ)).obj.obj opV) := fun ℱ opV =>
      letI : Module (ZMod m) ↥((P_pull_ab.obj ((U_fun Y).obj ℱ)).obj.obj opV) :=
        AddCommGroup.zmodModule (hAnn_Z ℱ opV)
      Module.compHom _ e_ring.toRingHom
    let P_pre : ∀ (ℱ : CategoryTheory.Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)),
        CategoryTheory.Functor (Opposite Z.Etale) (ModuleCat.{u, u} R) := fun ℱ =>
      { obj := fun opV => @ModuleCat.of R _ _ _ (mod_Z ℱ opV)
        map := fun {opV₁ opV₂} g =>
          liftLinear ((P_pull_ab.obj ((U_fun Y).obj ℱ)).obj.map g)
        map_id := fun opV => ModuleCat.hom_ext (LinearMap.ext fun x => by
          change (((P_pull_ab.obj ((U_fun Y).obj ℱ)).obj.map (𝟙 opV)).hom) x = x
          rw [(P_pull_ab.obj ((U_fun Y).obj ℱ)).obj.map_id]
          rfl)
        map_comp := fun f g => ModuleCat.hom_ext (LinearMap.ext fun x => by
          change (((P_pull_ab.obj ((U_fun Y).obj ℱ)).obj.map (f ≫ g)).hom) x = _
          rw [(P_pull_ab.obj ((U_fun Y).obj ℱ)).obj.map_comp]
          rfl) }
    have hP_pre_sheaf : ∀ (ℱ : CategoryTheory.Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)),
