        refine ⟨β, AddMonoidHom.ext fun α => ?_⟩
        obtain ⟨α₀, rfl⟩ := hg_cov_surj α
        rw [← hSq1 β α₀, hγ]
        rfl
  exact ⟨hCD, hBij_τ, hBij_Φ⟩

theorem weil_gysin_affine_pair_purity (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit (ℓ : k))
    (τ : ∀ (c r : ℕ), WeilGysinSupportClass
      (AlgebraicGeometry.Spec (CommRingCat.of k))
      (weilGysinAffineSpace k c) (weilGysinAffineOrigin k c) (ℓ ^ r) (2 * c))
    (hτ : WeilGysinIsAffineOriginThomTower k ℓ τ)
    (a b ab r : ℕ) (hab : a + b = ab)
    (Z_V V : AlgebraicGeometry.Scheme.{u})
    (γ_V : Quiver.Hom Z_V V)
    (u_V : Quiver.Hom Z_V (weilGysinAffineSpace k a))
    (ψ : Quiver.Hom V (weilGysinAffineSpace k ab))
    (hψ_et : AlgebraicGeometry.Etale ψ)
