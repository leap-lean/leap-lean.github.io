                (U_equiv (P_pull_mod.obj ℱ) 𝒢).symm
                  (e_pull_U.hom.app ℱ ≫
                    (adj_ab.homEquiv ((U_fun Y).obj ℱ) ((U_fun Z).obj 𝒢)).symm
                      ((U_fun Y).map k ≫ e_push_U.inv.app 𝒢)))
            rw [(U_equiv (P_pull_mod.obj ℱ') 𝒢).apply_symm_apply, (U_fun Z).map_comp]
            have h1 : (U_fun Z).map ((U_equiv (P_pull_mod.obj ℱ) 𝒢).symm
                (e_pull_U.hom.app ℱ ≫
                  (adj_ab.homEquiv ((U_fun Y).obj ℱ) ((U_fun Z).obj 𝒢)).symm
                    ((U_fun Y).map k ≫ e_push_U.inv.app 𝒢))) =
              e_pull_U.hom.app ℱ ≫
                (adj_ab.homEquiv ((U_fun Y).obj ℱ) ((U_fun Z).obj 𝒢)).symm
                  ((U_fun Y).map k ≫ e_push_U.inv.app 𝒢) :=
              (U_equiv (P_pull_mod.obj ℱ) 𝒢).apply_symm_apply _
            have hnat := e_pull_U.hom.naturality h
            dsimp only [CategoryTheory.Functor.comp_map] at hnat
            rw [h1, (U_fun Y).map_comp, CategoryTheory.Category.assoc ((U_fun Y).map h),
              adj_ab.homEquiv_naturality_left_symm,
              ← CategoryTheory.Category.assoc (e_pull_U.hom.app ℱ'), ← hnat,
              CategoryTheory.Category.assoc]
          homEquiv_naturality_right := fun {ℱ 𝒢 𝒢'} f g => by
            apply (U_equiv ℱ (i_push.obj 𝒢')).injective
            change (U_equiv ℱ (i_push.obj 𝒢'))
              ((U_equiv ℱ (i_push.obj 𝒢')).symm
