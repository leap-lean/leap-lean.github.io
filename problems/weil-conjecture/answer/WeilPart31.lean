      have hMaps_sub : Set.MapsTo ⇑(T - (algebraMap L' (Module.End L' (Fin m → L'))) μ)
          ↑(T.maxGenEigenspace μ) ↑(T.maxGenEigenspace μ) := by
        intro x hx
