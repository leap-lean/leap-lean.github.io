    have hpZ : u_Z' ≫ pZ_app_0 = u_Z₀ ≫ (One_sh Z₀).obj.map μ_gZ.op :=
      (CategoryTheory.Adjunction.homEquiv_unit adj_Z' R_mod _ (π_can g_Z hg_Z).inv).symm.trans
        ((congrArg (adj_Z'.homEquiv R_mod _) (hπ_can g_Z hg_Z).2).trans
