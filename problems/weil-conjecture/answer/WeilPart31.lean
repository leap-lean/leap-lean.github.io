import WeilPart30
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_gysin_support_pullback_forget_and_clopen_sum (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ((∀ (Z Y : AlgebraicGeometry.Scheme.{u}) (i : Quiver.Hom Z Y),
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) i :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B : CategoryTheory.Functor Y.Etale Z.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
      B.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology) ∧
      (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y),
        IsEmpty ↥Z →
        ∀ (m q : ℕ) (τ : WeilGysinSupportClass Z Y i m q), τ.val = 0) ∧
      (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
        (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q) (c₁ c₂ : ℕ),
        (c₁ : ZMod (ℓ ^ r)) = (c₂ : ZMod (ℓ ^ r)) →
        c₁ • τ.val = c₂ • τ.val)) ∧
    ((∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
      (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y) (g_Z : Quiver.Hom Z' Z),
      AlgebraicGeometry.IsClosedImmersion i →
      CategoryTheory.IsPullback i' g_Z g i →
      ∀ (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q),
        ∃ τ' : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q,
          WeilGysinSupportPullback g i' i (ℓ ^ r) q τ' τ) ∧
      (∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
        (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y),
        AlgebraicGeometry.IsClosedImmersion i' →
        ∀ (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
          (τ'₁ τ'₂ : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q),
          WeilGysinSupportPullback g i' i (ℓ ^ r) q τ'₁ τ →
          WeilGysinSupportPullback g i' i (ℓ ^ r) q τ'₂ τ →
          τ'₁ = τ'₂) ∧
      (∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
        (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y)
        (r q : ℕ) (τ' : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q)
        (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q),
        WeilGysinSupportPullback g i' i (ℓ ^ r) q τ' τ →
        ∀ c : ℕ,
          WeilGysinSupportPullback g i' i (ℓ ^ r) q
            ⟨τ'.hCont, c • τ'.val⟩ ⟨τ.hCont, c • τ.val⟩) ∧
      (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
        (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q),
        WeilGysinSupportPullback (CategoryTheory.CategoryStruct.id Y) i i (ℓ ^ r) q τ τ) ∧
      (∀ {Z'' Y'' Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
        (g₁ : Quiver.Hom Y'' Y') (g₂ : Quiver.Hom Y' Y)
        (i'' : Quiver.Hom Z'' Y'') (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y)
        (r q : ℕ)
        (τ'' : WeilGysinSupportClass Z'' Y'' i'' (ℓ ^ r) q)
        (τ' : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q)
        (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q),
        WeilGysinSupportPullback g₁ i'' i' (ℓ ^ r) q τ'' τ' →
        WeilGysinSupportPullback g₂ i' i (ℓ ^ r) q τ' τ →
        WeilGysinSupportPullback (CategoryTheory.CategoryStruct.comp g₁ g₂)
          i'' i (ℓ ^ r) q τ'' τ)) ∧
    ((∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
      (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q),
      ∃! cl : weilEtaleTorsionH Y (ℓ ^ r) q, WeilGysinForgetsTo τ cl) ∧
      (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} {i : Quiver.Hom Z Y} {r q : ℕ}
        (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
        (cl : weilEtaleTorsionH Y (ℓ ^ r) q),
        WeilGysinForgetsTo τ cl →
        ∀ c : ℕ, WeilGysinForgetsTo ⟨τ.hCont, c • τ.val⟩ (c • cl)) ∧
      (∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
        (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y)
        (r q : ℕ)
        (τ' : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q)
        (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
        (cl' : weilEtaleTorsionH Y' (ℓ ^ r) q)
        (cl : weilEtaleTorsionH Y (ℓ ^ r) q)
        (p_g : weilEtaleTorsionH Y (ℓ ^ r) q →+ weilEtaleTorsionH Y' (ℓ ^ r) q),
        WeilGysinSupportPullback g i' i (ℓ ^ r) q τ' τ →
        WeilGysinForgetsTo τ cl →
        WeilGysinForgetsTo τ' cl' →
        WeilLefschetzTorsionPullback g (ℓ ^ r) q p_g →
        p_g cl = cl')) ∧
    (∃ SupportRed : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} {i : Quiver.Hom Z Y} (r q : ℕ),
        WeilGysinSupportClass Z Y i (ℓ ^ (r + 1)) q →
        WeilGysinSupportClass Z Y i (ℓ ^ r) q → Prop,
      ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y),
        AlgebraicGeometry.IsClosedImmersion i →
        (∀ (r q : ℕ) (τ_succ : WeilGysinSupportClass Z Y i (ℓ ^ (r + 1)) q),
          ∃! τ_curr : WeilGysinSupportClass Z Y i (ℓ ^ r) q,
            SupportRed r q τ_succ τ_curr) ∧
        (∀ {Z' Y' : AlgebraicGeometry.Scheme.{u}}
          (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (g_Z : Quiver.Hom Z' Z),
          CategoryTheory.IsPullback i' g_Z g i →
          ∀ (r q : ℕ)
            (τ_succ : WeilGysinSupportClass Z Y i (ℓ ^ (r + 1)) q)
            (τ_curr : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
            (τ'_succ : WeilGysinSupportClass Z' Y' i' (ℓ ^ (r + 1)) q)
            (τ'_curr : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q),
            WeilGysinSupportPullback g i' i (ℓ ^ (r + 1)) q τ'_succ τ_succ →
            WeilGysinSupportPullback g i' i (ℓ ^ r) q τ'_curr τ_curr →
            SupportRed r q τ_succ τ_curr →
            SupportRed r q τ'_succ τ'_curr) ∧
        (∀ (r q : ℕ)
          (τ_succ : WeilGysinSupportClass Z Y i (ℓ ^ (r + 1)) q)
          (τ_curr : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
          (cl_succ : weilEtaleTorsionH Y (ℓ ^ (r + 1)) q)
          (cl_curr : weilEtaleTorsionH Y (ℓ ^ r) q),
          SupportRed r q τ_succ τ_curr →
          WeilGysinForgetsTo τ_succ cl_succ →
          WeilGysinForgetsTo τ_curr cl_curr →
          weilEtaleTorsionTransition Y ℓ r q cl_succ = cl_curr)) ∧
    ((∀ {S Z Y : AlgebraicGeometry.Scheme.{u}}
      {s : Quiver.Hom S Z} {i : Quiver.Hom Z Y} {si : Quiver.Hom S Y}
      (hsi : CategoryTheory.CategoryStruct.comp s i = si),
      AlgebraicGeometry.IsClosedImmersion s →
      AlgebraicGeometry.IsClosedImmersion i →
      AlgebraicGeometry.IsClosedImmersion si →
      ∀ {r a b c : ℕ} (hab : a + b = c)
        (τ_Z : WeilGysinSupportClass S Z s (ℓ ^ r) a)
        (τ_Y : WeilGysinSupportClass Z Y i (ℓ ^ r) b),
        ∃! τ_SY : WeilGysinSupportClass S Y si (ℓ ^ r) c,
          WeilGysinSupportGysinComp hsi hab τ_Z τ_Y τ_SY) ∧
      (∀ {S Z Y : AlgebraicGeometry.Scheme.{u}}
        {s : Quiver.Hom S Z} {i : Quiver.Hom Z Y} {si : Quiver.Hom S Y}
        (hsi : CategoryTheory.CategoryStruct.comp s i = si)
        {r a b c : ℕ} (hab : a + b = c)
        (τ_Z : WeilGysinSupportClass S Z s (ℓ ^ r) a)
        (τ_Y : WeilGysinSupportClass Z Y i (ℓ ^ r) b)
        (τ_SY : WeilGysinSupportClass S Y si (ℓ ^ r) c),
        WeilGysinSupportGysinComp hsi hab τ_Z τ_Y τ_SY →
        ∀ n : ℕ,
          WeilGysinSupportGysinComp hsi hab τ_Z
            ⟨τ_Y.hCont, n • τ_Y.val⟩ ⟨τ_SY.hCont, n • τ_SY.val⟩) ∧
      (∀ {S' Z' Y' S Z Y : AlgebraicGeometry.Scheme.{u}}
        {s' : Quiver.Hom S' Z'} {i' : Quiver.Hom Z' Y'} {si' : Quiver.Hom S' Y'}
        {s : Quiver.Hom S Z} {i : Quiver.Hom Z Y} {si : Quiver.Hom S Y}
        (hsi' : CategoryTheory.CategoryStruct.comp s' i' = si')
        (hsi : CategoryTheory.CategoryStruct.comp s i = si)
        (g_S : Quiver.Hom S' S) (g_Z : Quiver.Hom Z' Z) (g : Quiver.Hom Y' Y),
        AlgebraicGeometry.IsClosedImmersion s →
        AlgebraicGeometry.IsClosedImmersion i →
        CategoryTheory.IsPullback i' g_Z g i →
        CategoryTheory.IsPullback s' g_S g_Z s →
        ∀ {r a b c : ℕ} (hab : a + b = c)
          (τ'_Z : WeilGysinSupportClass S' Z' s' (ℓ ^ r) a)
          (τ'_Y : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) b)
          (τ'_SY : WeilGysinSupportClass S' Y' si' (ℓ ^ r) c)
          (τ_Z : WeilGysinSupportClass S Z s (ℓ ^ r) a)
          (τ_Y : WeilGysinSupportClass Z Y i (ℓ ^ r) b)
          (τ_SY : WeilGysinSupportClass S Y si (ℓ ^ r) c),
          WeilGysinSupportGysinComp hsi hab τ_Z τ_Y τ_SY →
          WeilGysinSupportPullback g_Z s' s (ℓ ^ r) a τ'_Z τ_Z →
          WeilGysinSupportPullback g i' i (ℓ ^ r) b τ'_Y τ_Y →
          WeilGysinSupportPullback g si' si (ℓ ^ r) c τ'_SY τ_SY →
          WeilGysinSupportGysinComp hsi' hab τ'_Z τ'_Y τ'_SY)) ∧
    (∀ (S₀ W X_sch : AlgebraicGeometry.Scheme.{u})
      (i_W : Quiver.Hom W X_sch),
      AlgebraicGeometry.IsClosedImmersion i_W →
      ∀ [Fintype ↥W] [DiscreteTopology ↥W]
        (s'_W : ∀ _ : ↥W, Quiver.Hom S₀ W),
        (∀ w : ↥W,
          AlgebraicGeometry.IsOpenImmersion (s'_W w) ∧
          Set.range (s'_W w).base = {w} ∧
          AlgebraicGeometry.IsClosedImmersion
            (CategoryTheory.CategoryStruct.comp (s'_W w) i_W)) →
        ∀ (r q : ℕ)
          (τ_W : WeilGysinSupportClass W X_sch i_W (ℓ ^ r) q)
          (cl_tot : weilEtaleTorsionH X_sch (ℓ ^ r) q),
          WeilGysinForgetsTo τ_W cl_tot →
          ∃ (τ_pt : ∀ w : ↥W,
              WeilGysinSupportClass S₀ X_sch
                (CategoryTheory.CategoryStruct.comp (s'_W w) i_W) (ℓ ^ r) q)
            (cl_pt : ∀ _ : ↥W, weilEtaleTorsionH X_sch (ℓ ^ r) q),
            (∀ w : ↥W, WeilGysinForgetsTo (τ_pt w) (cl_pt w)) ∧
            cl_tot = ∑ w : ↥W, cl_pt w ∧
            ∀ (w : ↥W) (U_w : X_sch.Opens) (s_Uw : Quiver.Hom S₀ U_w.toScheme)
              (τ_Uw : WeilGysinSupportClass S₀ U_w.toScheme s_Uw (ℓ ^ r) q),
              (U_w : Set X_sch) ∩ Set.range i_W.base = {i_W.base w} →
              CategoryTheory.CategoryStruct.comp s_Uw U_w.ι =
                CategoryTheory.CategoryStruct.comp (s'_W w) i_W →
              WeilGysinSupportPullback U_w.ι s_Uw i_W (ℓ ^ r) q τ_Uw τ_W →
              WeilGysinSupportPullback U_w.ι s_Uw
                (CategoryTheory.CategoryStruct.comp (s'_W w) i_W) (ℓ ^ r) q τ_Uw (τ_pt w)) :=
by
  let sitePullback : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (_ : Quiver.Hom S₁ S₂),
      CategoryTheory.Functor S₂.Etale S₁.Etale :=
    fun h =>
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
  
  have hContAll : ∀ (Z Y : AlgebraicGeometry.Scheme.{u}) (i : Quiver.Hom Z Y),
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) i :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B : CategoryTheory.Functor Y.Etale Z.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
      B.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology := by
    intro Z Y i
    let B : Y.Etale ⥤ Z.Etale := sitePullback i
    have hEq : B ⋙ AlgebraicGeometry.Scheme.Etale.forget Z =
        AlgebraicGeometry.Scheme.Etale.forget Y ⋙ CategoryTheory.Over.pullback i := rfl
    have hPres : CategoryTheory.Limits.PreservesFiniteLimits B :=
      @CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _
        B (AlgebraicGeometry.Scheme.Etale.forget Z)
        (by rw [hEq]; infer_instance) inferInstance
    letI := hPres
    haveI : CategoryTheory.RepresentablyFlat B := CategoryTheory.flat_of_preservesFiniteLimits B
    apply CategoryTheory.Functor.isContinuous_of_coverPreserving
      (CategoryTheory.compatiblePreservingOfFlat Z.smallEtaleTopology B)
    constructor
    intro U S hS
    letI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hEq_Y := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) Y le_rfl
    have hEq_Z := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) Z le_rfl
    have hS' := (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := Y) U S).mp
      (by erw [← hEq_Y]; exact hS)
    refine Eq.mp (congrArg (fun J => _ ∈ J (B.obj U)) hEq_Z.symm) ?_
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := Z) (B.obj U) _).mpr ?_
    intro z
    obtain ⟨V, f, y, hfS, hf_et, hy⟩ :=
      hS' ((CategoryTheory.Limits.pullback.fst U.hom i).base z)
    let V' : Y.Etale := V
    let f' : V' ⟶ U := f
    have h_bot : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst U.hom i)
        (CategoryTheory.Limits.pullback.snd U.hom i) U.hom i :=
      CategoryTheory.IsPullback.of_hasPullback U.hom i
    have h_outer : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst V'.hom i)
        ((B.map f').left ≫ CategoryTheory.Limits.pullback.snd U.hom i)
        (f'.left ≫ U.hom) i := by
      have h1 : (B.map f').left ≫ CategoryTheory.Limits.pullback.snd U.hom i =
          CategoryTheory.Limits.pullback.snd V'.hom i :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have h2 : f'.left ≫ U.hom = V'.hom :=
        CategoryTheory.MorphismProperty.Over.w f'
      exact Eq.ndrec
        (motive := fun s => CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst V'.hom i) s (f'.left ≫ U.hom) i)
        (Eq.ndrec
          (motive := fun u => CategoryTheory.IsPullback
            (CategoryTheory.Limits.pullback.fst V'.hom i)
            (CategoryTheory.Limits.pullback.snd V'.hom i) u i)
          (CategoryTheory.IsPullback.of_hasPullback V'.hom i) h2.symm)
        h1.symm
    have h_comm : CategoryTheory.Limits.pullback.fst V'.hom i ≫ f'.left =
        (B.map f').left ≫ CategoryTheory.Limits.pullback.fst U.hom i :=
      (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
    have h_top_pb : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst V'.hom i)
        (B.map f').left f'.left (CategoryTheory.Limits.pullback.fst U.hom i) :=
      CategoryTheory.IsPullback.of_bot h_outer h_comm h_bot
    obtain ⟨w, _, hw₂⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback h_top_pb y z hy
    exact ⟨B.obj V', B.map f', w,
      CategoryTheory.Sieve.image_mem_functorPushforward B S (V := V') (f := f') hfS,
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Etale) h_top_pb hf_et,
      hw₂⟩
  
  have hEmptyZero : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y),
      IsEmpty ↥Z →
      ∀ (m q : ℕ) (τ : WeilGysinSupportClass Z Y i m q), τ.val = 0 := by
    intro Z Y i hZ m q τ
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    letI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    let B : Y.Etale ⥤ Z.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
    letI := τ.hCont
    let R := ULift.{u, 0} (ZMod m)
    let i_push := B.sheafPushforwardContinuous (ModuleCat.{u, u} R) Y.smallEtaleTopology Z.smallEtaleTopology
    let One_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)).obj (ModuleCat.of R R)
    let One_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)).obj (ModuleCat.of R R)
    have hBotCover : ∀ W : Z.Etale, (⊥ : CategoryTheory.Sieve W) ∈ Z.smallEtaleTopology W := by
      intro W
      let S_bot : CategoryTheory.Sieve W := ⊥
      have hEq_Z := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) Z le_rfl
      refine Eq.mp (congrArg (fun J => S_bot ∈ J W) hEq_Z.symm) ?_
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := Z) W S_bot).mpr ?_
      intro x
      exact (hZ.false (W.hom.base x)).elim
    have hIdZero : (𝟙 (i_push.obj One_Z) : i_push.obj One_Z ⟶ i_push.obj One_Z) = 0 := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext V
      have hTermW : CategoryTheory.Limits.IsTerminal
          (One_Z.val.obj (Opposite.op (B.obj V.unop))) :=
        CategoryTheory.Sheaf.isTerminalOfBotCover One_Z (B.obj V.unop) (hBotCover (B.obj V.unop))
      exact hTermW.hom_ext _ _
    change τ.val = (0 : CategoryTheory.Abelian.Ext.{u} (i_push.obj One_Z) One_Y q)
    calc
      τ.val = (CategoryTheory.Abelian.Ext.mk₀ (𝟙 (i_push.obj One_Z))).comp τ.val (Nat.zero_add q) :=
        (CategoryTheory.Abelian.Ext.mk₀_id_comp τ.val).symm
      _ = (CategoryTheory.Abelian.Ext.mk₀ (0 : i_push.obj One_Z ⟶ i_push.obj One_Z)).comp τ.val (Nat.zero_add q) := by
        rw [hIdZero]
      _ = 0 := by
        rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.zero_comp]
  
  have hScalarMod : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
      (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q) (c₁ c₂ : ℕ),
      (c₁ : ZMod (ℓ ^ r)) = (c₂ : ZMod (ℓ ^ r)) →
      c₁ • τ.val = c₂ • τ.val := by
    intro Z Y i r q τ c₁ c₂ hmod
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : Y.Etale ⥤ Z.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
    letI := τ.hCont
    let R := ULift.{u, 0} (ZMod (ℓ ^ r))
    let i_push := B.sheafPushforwardContinuous (ModuleCat.{u, u} R) Y.smallEtaleTopology Z.smallEtaleTopology
    let One_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology (ModuleCat.{u, u} R)).obj (ModuleCat.of R R)
