        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        (π_open W).hom_inv_id,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]
    rw [hconj, (hΦΨ W q).1]
  have h_to_zero (W : Y.Opens) (q : ℕ) : (toSupp W q 0).val = 0 := by
    have hΦ0 : Φ_adj W q 0 = 0 := by
      let hEx_W := hResAdj W.ι inferInstance (hContM W.ι inferInstance) (hContB W.toScheme Y W.ι)
      letI := hEx_W.2.1; letI := hEx_W.2.2.1; letI := hEx_W.2.2.2
      change (CategoryTheory.Abelian.Ext.mk₀ ((adj_ext W).unit.app ((j_res W).obj ℋ))).comp
        ((j_res W).mapExtAddHom ((j_ext W).obj ((j_res W).obj ℋ)) One_Y q 0) (Nat.zero_add q) = 0
      rw [map_zero, CategoryTheory.Abelian.Ext.comp_zero]
    change ((CategoryTheory.Abelian.Ext.mk₀ (β_open W).hom).comp
        (Φ_adj W q 0) (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (π_open W).hom) (Nat.add_zero q) = 0
    rw [hΦ0, CategoryTheory.Abelian.Ext.comp_zero, CategoryTheory.Abelian.Ext.zero_comp]

  have h_pb_intertwine : ∀ {W₁ W₂ : Y.Opens} (h : W₁ ≤ W₂) (q : ℕ)
      (τ₁ : Supp_open W₁ q) (τ₂ : Supp_open W₂ q),
      WeilGysinSupportPullback (Y.homOfLE h) (i_open W₁) (i_open W₂) m q τ₁ τ₂ ↔
        (CategoryTheory.Abelian.Ext.mk₀ (ι_ext ℋ h)).comp
          (fromSupp W₂ q τ₂) (Nat.zero_add q) = fromSupp W₁ q τ₁ := by
    intro W₁ W₂ h q τ₁ τ₂
    obtain ⟨σ_h, hσ_app, hσ_tr⟩ := hExtTrans ℋ W₁ W₂ h
    have hpb_iff := hPb_homOfLE_iff W₁ W₂ h σ_h hσ_app q τ₂ τ₁
    let g_h := Y.homOfLE h
    let M_h : CategoryTheory.Functor W₁.toScheme.Etale W₂.toScheme.Etale :=
      CategoryTheory.MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤
        (inferInstance : AlgebraicGeometry.Etale g_h)
    let h_res := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      M_h (ModuleCat.{u, u} R) _ W₁.toScheme.smallEtaleTopology W₂.toScheme.smallEtaleTopology
      (hContM g_h inferInstance)
    let hEx_W₁ := hResAdj W₁.ι inferInstance (hContM W₁.ι inferInstance) (hContB W₁.toScheme Y W₁.ι)
    let hEx_W₂ := hResAdj W₂.ι inferInstance (hContM W₂.ι inferInstance) (hContB W₂.toScheme Y W₂.ι)
    let hEx_h := hResAdj g_h inferInstance (hContM g_h inferInstance)
      (hContB W₁.toScheme W₂.toScheme g_h)
    letI := hEx_W₁.2.1; letI := hEx_W₁.2.2.1; letI := hEx_W₁.2.2.2
    letI := hEx_W₂.2.1; letI := hEx_W₂.2.2.1; letI := hEx_W₂.2.2.2
    letI := hEx_h.2.1; letI := hEx_h.2.2.1; letI := hEx_h.2.2.2
    letI := (hEx_ext W₁).1; letI := (hEx_ext W₁).2.1; letI := (hEx_ext W₁).2.2
    letI := (hEx_ext W₂).1; letI := (hEx_ext W₂).2.1; letI := (hEx_ext W₂).2.2
    let ζ₁ := ((CategoryTheory.Abelian.Ext.mk₀ (β_open W₁).inv).comp
      τ₁.val (Nat.zero_add q)).comp
      (CategoryTheory.Abelian.Ext.mk₀ (π_open W₁).inv) (Nat.add_zero q)
    let ζ₂ := ((CategoryTheory.Abelian.Ext.mk₀ (β_open W₂).inv).comp
      τ₂.val (Nat.zero_add q)).comp
      (CategoryTheory.Abelian.Ext.mk₀ (π_open W₂).inv) (Nat.add_zero q)
    have hrel := h_rel_trans (adj_ext W₁) (adj_ext W₂) h_res σ_h ℋ One_Y (ι_ext ℋ h) hσ_tr q ζ₂
    refine hpb_iff.trans ?_
    change ζ₁ = ((CategoryTheory.Abelian.Ext.mk₀ (σ_h.hom.app ℋ)).comp
        (h_res.mapExtAddHom ((j_res W₂).obj ℋ) ((j_res W₂).obj One_Y) q ζ₂)
        (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (σ_h.inv.app One_Y)) (Nat.add_zero q) ↔ _
    rw [← hrel]
    change ζ₁ = Φ_adj W₁ q ((CategoryTheory.Abelian.Ext.mk₀ (ι_ext ℋ h)).comp
      (fromSupp W₂ q τ₂) (Nat.zero_add q)) ↔
      (CategoryTheory.Abelian.Ext.mk₀ (ι_ext ℋ h)).comp
        (fromSupp W₂ q τ₂) (Nat.zero_add q) = Ψ_adj W₁ q ζ₁
    constructor
    · intro h_eq
      rw [h_eq, (hΦΨ W₁ q).1]
    · intro h_eq
      rw [h_eq, (hΦΨ W₁ q).2]

  have hBinMV : ∀ (W₁ W₂ W_int W_sup : Y.Opens)
      (h_int : W_int = W₁ ⊓ W₂) (h_sup : W_sup = W₁ ⊔ W₂)
      (h_int_l : W_int ≤ W₁) (h_int_r : W_int ≤ W₂)
      (h_sup_l : W₁ ≤ W_sup) (h_sup_r : W₂ ≤ W_sup),
      (∀ (q : ℕ),
        (∀ β₁ : Supp_open W₁ q, β₁.val = 0) →
        (∀ β₂ : Supp_open W₂ q, β₂.val = 0) →
        (∀ q' : ℕ, q = q' + 1 → ∀ β₀ : Supp_open W_int q', β₀.val = 0) →
        ∀ β : Supp_open W_sup q, β.val = 0) ∧
      ((∀ q' : ℕ, D = q' + 1 → ∀ β₀ : Supp_open W_int q', β₀.val = 0) →
        ∀ (τ_a τ_b : Supp_open W_sup D),
          (∃ τ₁ : Supp_open W₁ D,
            WeilGysinSupportPullback (Y.homOfLE h_sup_l) (i_open W₁) (i_open W_sup) m D τ₁ τ_a ∧
            WeilGysinSupportPullback (Y.homOfLE h_sup_l) (i_open W₁) (i_open W_sup) m D τ₁ τ_b) →
          (∃ τ₂ : Supp_open W₂ D,
            WeilGysinSupportPullback (Y.homOfLE h_sup_r) (i_open W₂) (i_open W_sup) m D τ₂ τ_a ∧
            WeilGysinSupportPullback (Y.homOfLE h_sup_r) (i_open W₂) (i_open W_sup) m D τ₂ τ_b) →
          τ_a = τ_b) ∧
      (∀ (τ₁ : Supp_open W₁ D) (τ₂ : Supp_open W₂ D),
        (∃ τ₁₂ : Supp_open W_int D,
          WeilGysinSupportPullback (Y.homOfLE h_int_l) (i_open W_int) (i_open W₁) m D τ₁₂ τ₁ ∧
          WeilGysinSupportPullback (Y.homOfLE h_int_r) (i_open W_int) (i_open W₂) m D τ₁₂ τ₂) →
        ∃ τ_u : Supp_open W_sup D,
          WeilGysinSupportPullback (Y.homOfLE h_sup_l) (i_open W₁) (i_open W_sup) m D τ₁ τ_u ∧
          WeilGysinSupportPullback (Y.homOfLE h_sup_r) (i_open W₂) (i_open W_sup) m D τ₂ τ_u) := by
    intro W₁ W₂ W_int W_sup h_int h_sup h_int_l h_int_r h_sup_l h_sup_r
    subst h_int; subst h_sup
    obtain ⟨h0, hSE⟩ := hExtMV ℋ W₁ W₂
    obtain ⟨hmv_van, hmv_uniq, hmv_glue⟩ := h_mv_ext One_Y
      (ι_ext ℋ (inf_le_left : W₁ ⊓ W₂ ≤ W₁))
      (ι_ext ℋ (inf_le_right : W₁ ⊓ W₂ ≤ W₂))
      (ι_ext ℋ (le_sup_left : W₁ ≤ W₁ ⊔ W₂))
      (ι_ext ℋ (le_sup_right : W₂ ≤ W₁ ⊔ W₂))
      h0 hSE
    have hext_zero : ∀ (W : Y.Opens) (q : ℕ),
        (∀ β : Supp_open W q, β.val = 0) → ∀ x : E_ext W q, x = 0 := by
      intro W q hW x
      have h0_val : (toSupp W q x).val = 0 := hW (toSupp W q x)
      have heq : toSupp W q x = toSupp W q 0 := hSuppExt _ _ (h0_val.trans (h_to_zero W q).symm)
      calc
        x = fromSupp W q (toSupp W q x) := (h_from_to W q x).symm
        _ = fromSupp W q (toSupp W q 0) := congrArg (fromSupp W q) heq
        _ = 0 := h_from_to W q 0
    refine ⟨?_, ?_, ?_⟩
    · intro q h1 h2 h0_van β
      have h_fb : fromSupp (W₁ ⊔ W₂) q β = 0 :=
        hmv_van q (hext_zero W₁ q h1) (hext_zero W₂ q h2)
          (fun q' hq' => hext_zero (W₁ ⊓ W₂) q' (h0_van q' hq'))
          (fromSupp (W₁ ⊔ W₂) q β)
      have h_tb : β = toSupp (W₁ ⊔ W₂) q 0 := by
        rw [← h_to_from (W₁ ⊔ W₂) q β, h_fb]
      rw [h_tb]
      exact h_to_zero (W₁ ⊔ W₂) q
    · intro h0_van τ_a τ_b ⟨τ₁, h1a, h1b⟩ ⟨τ₂, h2a, h2b⟩
      have he1a := (h_pb_intertwine h_sup_l D τ₁ τ_a).mp h1a
      have he1b := (h_pb_intertwine h_sup_l D τ₁ τ_b).mp h1b
      have he2a := (h_pb_intertwine h_sup_r D τ₂ τ_a).mp h2a
      have he2b := (h_pb_intertwine h_sup_r D τ₂ τ_b).mp h2b
      have h_eq : fromSupp (W₁ ⊔ W₂) D τ_a = fromSupp (W₁ ⊔ W₂) D τ_b :=
        hmv_uniq D (fun q' hq' => hext_zero (W₁ ⊓ W₂) q' (h0_van q' hq'))
          (fromSupp (W₁ ⊔ W₂) D τ_a) (fromSupp (W₁ ⊔ W₂) D τ_b)
          (he1a.trans he1b.symm) (he2a.trans he2b.symm)
      rw [← h_to_from (W₁ ⊔ W₂) D τ_a, ← h_to_from (W₁ ⊔ W₂) D τ_b, h_eq]
    · intro τ₁ τ₂ ⟨τ₁₂, h12_1, h12_2⟩
      have he1 := (h_pb_intertwine h_int_l D τ₁₂ τ₁).mp h12_1
      have he2 := (h_pb_intertwine h_int_r D τ₁₂ τ₂).mp h12_2
      obtain ⟨x, hx1, hx2⟩ := hmv_glue D (fromSupp W₁ D τ₁) (fromSupp W₂ D τ₂)
        (he1.trans he2.symm)
      refine ⟨toSupp (W₁ ⊔ W₂) D x, ?_, ?_⟩
      · rw [h_pb_intertwine h_sup_l D τ₁ (toSupp (W₁ ⊔ W₂) D x), h_from_to]
        exact hx1
      · rw [h_pb_intertwine h_sup_r D τ₂ (toSupp (W₁ ⊔ W₂) D x), h_from_to]
        exact hx2

  have hInd : ∀ (k : ℕ) (F : Fin k → Y.Opens),
      (∀ (α : Fin k) (W_sub : Y.Opens), W_sub ≤ F α →
        ∀ (q : ℕ), q < D → ∀ β : Supp_open W_sub q, β.val = 0) →
      ∀ (W_F : Y.Opens) (hW_F : W_F = ⨆ α : Fin k, F α)
        (h_le_WF : ∀ α : Fin k, F α ≤ W_F),
        (∀ (q : ℕ), q < D → ∀ β : Supp_open W_F q, β.val = 0) ∧
        (∀ (τ₁ τ₂ : Supp_open W_F D),
          (∀ α : Fin k, ∃ τ_α : Supp_open (F α) D,
            WeilGysinSupportPullback (Y.homOfLE (h_le_WF α)) (i_open (F α)) (i_open W_F) m D τ_α τ₁ ∧
            WeilGysinSupportPullback (Y.homOfLE (h_le_WF α)) (i_open (F α)) (i_open W_F) m D τ_α τ₂) →
          τ₁ = τ₂) ∧
        (∀ (τ_loc : ∀ α : Fin k, Supp_open (F α) D),
          (∀ α β : Fin k, ∃ τ_αβ : Supp_open (F α ⊓ F β) D,
            WeilGysinSupportPullback (Y.homOfLE inf_le_left)
              (i_open (F α ⊓ F β)) (i_open (F α)) m D τ_αβ (τ_loc α) ∧
            WeilGysinSupportPullback (Y.homOfLE inf_le_right)
              (i_open (F α ⊓ F β)) (i_open (F β)) m D τ_αβ (τ_loc β)) →
          ∃ τ_glob : Supp_open W_F D,
            ∀ α : Fin k,
              WeilGysinSupportPullback (Y.homOfLE (h_le_WF α))
                (i_open (F α)) (i_open W_F) m D (τ_loc α) τ_glob) := by
    intro k
    induction k with
    | zero =>
      intro F _ W_F hW_F _
      have hWF_bot : W_F = ⊥ := by
        rw [hW_F]
        exact iSup_of_empty F
      subst hWF_bot
      have hEmp : IsEmpty ↥(U_open ⊥).toScheme := ⟨fun z => z.2⟩
      refine ⟨?_, ?_, ?_⟩
      · intro q _ β
        exact hEmpty_zero (i_open ⊥) hEmp m q β
      · intro τ₁ τ₂ _
        exact hSuppExt τ₁ τ₂
          ((hEmpty_zero (i_open ⊥) hEmp m D τ₁).trans
            (hEmpty_zero (i_open ⊥) hEmp m D τ₂).symm)
      · intro _ _
        exact ⟨⟨hContB (U_open ⊥).toScheme (⊥ : Y.Opens).toScheme (i_open ⊥), 0⟩,
          fun α => Fin.elim0 α⟩
    | succ k ih =>
      intro F hF_van W_F hW_F h_le_WF
      let F_init : Fin k → Y.Opens := fun j => F j.castSucc
      let V_last : Y.Opens := F (Fin.last k)
      let W' : Y.Opens := ⨆ j : Fin k, F_init j
      let F_inter : Fin k → Y.Opens := fun j => F_init j ⊓ V_last
      let W_inter : Y.Opens := ⨆ j : Fin k, F_inter j
      have hWF_sup : W_F = W' ⊔ V_last := by
        rw [hW_F]
        apply le_antisymm
        · apply iSup_le
          intro α
          refine Fin.lastCases ?_ ?_ α
          · exact le_sup_right
          · intro j
            exact le_trans (le_iSup F_init j) le_sup_left
        · exact sup_le (iSup_le fun j => le_iSup F j.castSucc) (le_iSup F (Fin.last k))
      have hWinter_inf : W_inter = W' ⊓ V_last := by
        dsimp only [W_inter, W', F_inter]
        exact (@iSup_inf_eq Y.Opens _ _ F_init V_last).symm
      have h_W'_le : W' ≤ W_F := by rw [hWF_sup]; exact le_sup_left
      have h_V_le : V_last ≤ W_F := h_le_WF (Fin.last k)
      have h_int_W' : W_inter ≤ W' := by rw [hWinter_inf]; exact inf_le_left
      have h_int_V : W_inter ≤ V_last := by rw [hWinter_inf]; exact inf_le_right
      have hF_init_van : ∀ (j : Fin k) (W_sub : Y.Opens), W_sub ≤ F_init j →
          ∀ (q : ℕ), q < D → ∀ β : Supp_open W_sub q, β.val = 0 :=
        fun j W_sub hW => hF_van j.castSucc W_sub hW
      have hF_inter_van : ∀ (j : Fin k) (W_sub : Y.Opens), W_sub ≤ F_inter j →
          ∀ (q : ℕ), q < D → ∀ β : Supp_open W_sub q, β.val = 0 :=
        fun j W_sub hW => hF_van j.castSucc W_sub (le_trans hW inf_le_left)
      obtain ⟨ih_init_van, ih_init_uniq, ih_init_glue⟩ :=
        ih F_init hF_init_van W' rfl (fun j => le_iSup F_init j)
      obtain ⟨ih_inter_van, ih_inter_uniq, _⟩ :=
        ih F_inter hF_inter_van W_inter rfl (fun j => le_iSup F_inter j)
      obtain ⟨hbin_van, hbin_uniq, hbin_glue⟩ :=
        hBinMV W' V_last W_inter W_F hWinter_inf hWF_sup h_int_W' h_int_V h_W'_le h_V_le
      refine ⟨?_, ?_, ?_⟩
      · intro q hq β
        exact hbin_van q (ih_init_van q hq)
          (hF_van (Fin.last k) V_last (le_refl _) q hq)
          (fun q' hq' => ih_inter_van q' (by omega)) β
      · intro τ₁ τ₂ h_agree
        obtain ⟨τ'₁, hτ'₁, -⟩ := (hFunc D).1 W' W_F h_W'_le τ₁
        obtain ⟨τ'₂, hτ'₂, -⟩ := (hFunc D).1 W' W_F h_W'_le τ₂
        have hτ'_eq : τ'₁ = τ'₂ := by
          apply ih_init_uniq τ'₁ τ'₂
          intro j
          obtain ⟨τ_j, hτ_j1, hτ_j2⟩ := h_agree j.castSucc
          obtain ⟨σ_j1, hσ_j1, -⟩ := (hFunc D).1 (F_init j) W' (le_iSup F_init j) τ'₁
          obtain ⟨σ_j2, hσ_j2, -⟩ := (hFunc D).1 (F_init j) W' (le_iSup F_init j) τ'₂
          have hσ1_eq : σ_j1 = τ_j :=
            ((hFunc D).1 (F j.castSucc) W_F (h_le_WF j.castSucc) τ₁).unique
              ((hFunc D).2.2.1 (F_init j) W' W_F (le_iSup F_init j) h_W'_le σ_j1 τ'₁ τ₁ hσ_j1 hτ'₁)
              hτ_j1
          have hσ2_eq : σ_j2 = τ_j :=
            ((hFunc D).1 (F j.castSucc) W_F (h_le_WF j.castSucc) τ₂).unique
              ((hFunc D).2.2.1 (F_init j) W' W_F (le_iSup F_init j) h_W'_le σ_j2 τ'₂ τ₂ hσ_j2 hτ'₂)
              hτ_j2
          exact ⟨τ_j, hσ1_eq ▸ hσ_j1, hσ2_eq ▸ hσ_j2⟩
        rw [hτ'_eq] at hτ'₁
        exact hbin_uniq (fun q' hq' => ih_inter_van q' (by omega)) τ₁ τ₂
          ⟨τ'₂, hτ'₁, hτ'₂⟩ (h_agree (Fin.last k))
      · intro τ_loc h_compat
        obtain ⟨τ', hτ'⟩ := ih_init_glue (fun j => τ_loc j.castSucc)
          (fun j₁ j₂ => h_compat j₁.castSucc j₂.castSucc)
        let τ_last := τ_loc (Fin.last k)
        obtain ⟨σ₁, hσ₁, -⟩ := (hFunc D).1 W_inter W' h_int_W' τ'
        obtain ⟨σ₂, hσ₂, -⟩ := (hFunc D).1 W_inter V_last h_int_V τ_last
        have hσ_eq : σ₁ = σ₂ := by
          apply ih_inter_uniq σ₁ σ₂
          intro j
          obtain ⟨ω_j, hω_jL, hω_jR⟩ := h_compat j.castSucc (Fin.last k)
          obtain ⟨ω₁, hω₁, -⟩ := (hFunc D).1 (F_inter j) W_inter (le_iSup F_inter j) σ₁
          obtain ⟨ω₂, hω₂, -⟩ := (hFunc D).1 (F_inter j) W_inter (le_iSup F_inter j) σ₂
          have hω1_eq : ω₁ = ω_j :=
            ((hFunc D).1 (F_inter j) W'
              (le_trans (inf_le_left : F_inter j ≤ F_init j) (le_iSup F_init j)) τ').unique
              ((hFunc D).2.2.1 (F_inter j) W_inter W' (le_iSup F_inter j) h_int_W' ω₁ σ₁ τ' hω₁ hσ₁)
              ((hFunc D).2.2.1 (F_inter j) (F_init j) W' inf_le_left (le_iSup F_init j)
                ω_j (τ_loc j.castSucc) τ' hω_jL (hτ' j))
          have hω2_eq : ω₂ = ω_j :=
            ((hFunc D).1 (F_inter j) V_last (inf_le_right : F_inter j ≤ V_last) τ_last).unique
              ((hFunc D).2.2.1 (F_inter j) W_inter V_last (le_iSup F_inter j) h_int_V
                ω₂ σ₂ τ_last hω₂ hσ₂)
              hω_jR
          exact ⟨ω_j, hω1_eq ▸ hω₁, hω2_eq ▸ hω₂⟩
        rw [hσ_eq] at hσ₁
        obtain ⟨τ_glob, h_glob_W', h_glob_V⟩ :=
          hbin_glue τ' τ_last ⟨σ₂, hσ₁, hσ₂⟩
        refine ⟨τ_glob, fun α => ?_⟩
        refine Fin.lastCases ?_ ?_ α
        · exact h_glob_V
        · intro j
          exact (hFunc D).2.2.1 (F_init j) W' W_F (le_iSup F_init j) h_W'_le
            (τ_loc j.castSucc) τ' τ_glob (hτ' j) h_glob_W'

  have hTop_eq : (⊤ : Y.Opens) = ⨆ α : Fin n, V_cov α := by
    apply SetLike.ext'
    rw [TopologicalSpace.Opens.coe_top, TopologicalSpace.Opens.coe_iSup, hcov]
  obtain ⟨_, hTop_uniq, hTop_glue⟩ :=
    hInd n V_cov hvan ⊤ hTop_eq (fun α => le_top)
  refine ⟨?_, ?_⟩
  · intro τ₁ τ₂ h_agree
    obtain ⟨τ_top1, h_top1, -⟩ := (hFunc D).2.1 ⊤ τ₁
    obtain ⟨τ_top2, h_top2, -⟩ := (hFunc D).2.1 ⊤ τ₂
    have h_top_eq : τ_top1 = τ_top2 := by
      apply hTop_uniq τ_top1 τ_top2
      intro α
      obtain ⟨τ_α, hα1, hα2⟩ := h_agree α
      obtain ⟨σ_α1, hσ1, -⟩ := (hFunc D).1 (V_cov α) ⊤ le_top τ_top1
      obtain ⟨σ_α2, hσ2, -⟩ := (hFunc D).1 (V_cov α) ⊤ le_top τ_top2
      have hσ1_eq : σ_α1 = τ_α :=
        ((hFunc D).2.1 (V_cov α) τ₁).unique
          ((hFunc D).2.2.2.1 (V_cov α) ⊤ le_top σ_α1 τ_top1 τ₁ hσ1 h_top1)
          hα1
      have hσ2_eq : σ_α2 = τ_α :=
        ((hFunc D).2.1 (V_cov α) τ₂).unique
          ((hFunc D).2.2.2.1 (V_cov α) ⊤ le_top σ_α2 τ_top2 τ₂ hσ2 h_top2)
          hα2
      exact ⟨τ_α, hσ1_eq ▸ hσ1, hσ2_eq ▸ hσ2⟩
    rw [h_top_eq] at h_top1
    exact (hFunc D).2.2.2.2.1 τ₁ τ₂ τ_top2 h_top1 h_top2
  · intro τ_loc h_compat
    obtain ⟨τ_top, hτ_top⟩ := hTop_glue τ_loc h_compat
    obtain ⟨τ_glob, hτ_glob⟩ := (hFunc D).2.2.2.2.2 τ_top
    refine ⟨τ_glob, fun α => ?_⟩
    exact (hFunc D).2.2.2.1 (V_cov α) ⊤ le_top (τ_loc α) τ_top τ_glob (hτ_top α) hτ_glob

theorem weil_gysin_homological_projection_formula (S₀ Z Y : AlgebraicGeometry.Scheme.{u})
    (s : Quiver.Hom S₀ Z) (i : Quiver.Hom Z Y) (si : Quiver.Hom S₀ Y)
    (hs_cl : AlgebraicGeometry.IsClosedImmersion s)
    (hi_cl : AlgebraicGeometry.IsClosedImmersion i)
    (hsi_cl : AlgebraicGeometry.IsClosedImmersion si)
    (hsi : CategoryTheory.CategoryStruct.comp s i = si)
    (m d : ℕ) (h4d : 2 * d + 2 * d = 2 * (2 * d))
    (τ_Z : WeilGysinSupportClass S₀ Z s m (2 * d))
    (τ_Y : WeilGysinSupportClass Z Y i m (2 * d))
    (τ_SY : WeilGysinSupportClass S₀ Y si m (2 * (2 * d)))
    (hGys : WeilGysinSupportGysinComp hsi h4d τ_Z τ_Y τ_SY)
    (cl_Z : weilEtaleTorsionH Z m (2 * d))
    (γ_Y : weilEtaleTorsionH Y m (2 * d))
    (cl_SY : weilEtaleTorsionH Y m (2 * (2 * d)))
    (hfg_Z : WeilGysinForgetsTo τ_Z cl_Z)
    (hfg_Y : WeilGysinForgetsTo τ_Y γ_Y)
    (hfg_SY : WeilGysinForgetsTo τ_SY cl_SY)
    (p_i : weilEtaleTorsionH Y m (2 * d) →+ weilEtaleTorsionH Z m (2 * d))
    (c_Y : weilEtaleTorsionH Y m (2 * d) →+
      weilEtaleTorsionH Y m (2 * d) →+ weilEtaleTorsionH Y m (2 * (2 * d)))
    (ξ : weilEtaleTorsionH Y m (2 * d)) (a : ℕ)
    (hp_i : WeilLefschetzTorsionPullback i m (2 * d) p_i)
    (hc_Y : WeilLefschetzIsTorsionCup Y m (2 * d) (2 * d) (2 * (2 * d)) h4d c_Y)
    (hξ : p_i ξ = a • cl_Z) :
    c_Y γ_Y ξ = a • cl_SY :=
by
  clear hs_cl hi_cl hsi_cl
  
  
  
  have sheaf_hom_ext : ∀ {𝒞 : Type (u + 1)} [Category.{u, u + 1} 𝒞]
      {J : GrothendieckTopology 𝒞} {𝒱 : Type (u + 1)} [Category.{u, u + 1} 𝒱]
      {ℱ₁ ℱ₂ : Sheaf J 𝒱} {f g : ℱ₁ ⟶ ℱ₂}, f.hom = g.hom → f = g := by
    rintro _ _ _ _ _ _ _ ⟨f⟩ ⟨g⟩ rfl
    rfl
  have hom_comp_eqToHom_of_heq : ∀ {𝒞 : Type (u + 1)} [Category.{u, u + 1} 𝒞]
      {X₁ X₂ Y₁ Y₂ : 𝒞} (hx : X₁ = X₂) (hy : Y₁ = Y₂)
      {f : X₁ ⟶ Y₁} {g : X₂ ⟶ Y₂}, HEq f g →
      f ≫ eqToHom hy = eqToHom hx ≫ g := by
    rintro _ _ _ _ _ _ rfl rfl _ _ h
    cases h
    simp
  have hExtComp : ∀ {C D E : Type (u + 1)}
      [Category.{u + 1, u + 1} C] [Abelian C] [HasExt.{u} C] [EnoughInjectives C]
      [Category.{u + 1, u + 1} D] [Abelian D] [HasExt.{u} D]
      [Category.{u + 1, u + 1} E] [Abelian E] [HasExt.{u} E]
      (F : C ⥤ D) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
      (G : D ⥤ E) [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      (A B : C) (n : ℕ) (x : Abelian.Ext A B n),
      ((F.comp G).mapExtAddHom A B n) x =
        (G.mapExtAddHom (F.obj A) (F.obj B) n) ((F.mapExtAddHom A B n) x) := by
    intro C D E _ _ _ _ _ _ _ _ _ _ F _ _ _ G _ _ _ A B n x
    rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply]
    induction n generalizing B with
    | zero =>
      have hx : Abelian.Ext.mk₀ (Abelian.Ext.addEquiv₀ x) = x := Abelian.Ext.addEquiv₀.left_inv x
      rw [← hx, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
          Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ k ih =>
      let ι : B ⟶ Injective.under B := Injective.ι B
      let S : ShortComplex C := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hzero : x.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ A hS x hzero rfl
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
          Abelian.Ext.mapExactFunctor_comp, ih S.X₃ z,
          Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass,
          Abelian.Ext.mapExactFunctor_extClass]
  have hExtNatTrans : ∀ {C D : Type (u + 1)}
      [Category.{u + 1, u + 1} C] [Abelian C] [HasExt.{u} C] [EnoughInjectives C]
      [Category.{u + 1, u + 1} D] [Abelian D] [HasExt.{u} D]
      (F₁ F₂ : C ⥤ D)
      [F₁.Additive] [Limits.PreservesFiniteLimits F₁] [Limits.PreservesFiniteColimits F₁]
      [F₂.Additive] [Limits.PreservesFiniteLimits F₂] [Limits.PreservesFiniteColimits F₂]
      (σ : F₁ ⟶ F₂) (A B : C) (n : ℕ) (x : Abelian.Ext A B n),
      ((F₁.mapExtAddHom A B n) x).comp (Abelian.Ext.mk₀ (σ.app B)) (Nat.add_zero n) =
        (Abelian.Ext.mk₀ (σ.app A)).comp ((F₂.mapExtAddHom A B n) x) (Nat.zero_add n) := by
    intro C D _ _ _ _ _ _ _ F₁ F₂ _ _ _ _ _ _ σ A B n x
    rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply]
    induction n generalizing B with
    | zero =>
      have hx : Abelian.Ext.mk₀ (Abelian.Ext.addEquiv₀ x) = x := Abelian.Ext.addEquiv₀.left_inv x
      rw [← hx, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
          Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, σ.naturality]
    | succ k ih =>
      let ι : B ⟶ Injective.under B := Injective.ι B
      let S : ShortComplex C := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hzero : x.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ A hS x hzero rfl
      let φ_S : S.map F₁ ⟶ S.map F₂ :=
        { τ₁ := σ.app S.X₁
          τ₂ := σ.app S.X₂
          τ₃ := σ.app S.X₃
          comm₁₂ := (σ.naturality S.f).symm
          comm₂₃ := (σ.naturality S.g).symm }
      have hnat_ext :
          (hS.map_of_exact F₁).extClass.comp (Abelian.Ext.mk₀ (σ.app B)) (Nat.add_zero 1) =
            (Abelian.Ext.mk₀ (σ.app S.X₃)).comp (hS.map_of_exact F₂).extClass (Nat.zero_add 1) :=
        ShortComplex.ShortExact.extClass_naturality (hS.map_of_exact F₁) (hS.map_of_exact F₂) φ_S
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
          Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass,
          Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ rfl,
          hnat_ext,
          ← Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ rfl,
          ih S.X₃ z,
          Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (σ.app A)) _ _ (Nat.zero_add k) rfl (by omega)]
  have hExtIso : ∀ {C D : Type (u + 1)}
      [Category.{u + 1, u + 1} C] [Abelian C] [HasExt.{u} C] [EnoughInjectives C]
      [Category.{u + 1, u + 1} D] [Abelian D] [HasExt.{u} D]
      (F₁ F₂ : C ⥤ D)
      [F₁.Additive] [Limits.PreservesFiniteLimits F₁] [Limits.PreservesFiniteColimits F₁]
      [F₂.Additive] [Limits.PreservesFiniteLimits F₂] [Limits.PreservesFiniteColimits F₂]
      (σ : F₁ ≅ F₂) (A B : C) (n : ℕ) (x : Abelian.Ext A B n),
      (F₂.mapExtAddHom A B n) x =
        (Abelian.Ext.mk₀ (σ.inv.app A)).comp
          (((F₁.mapExtAddHom A B n) x).comp (Abelian.Ext.mk₀ (σ.hom.app B)) (Nat.add_zero n))
          (Nat.zero_add n) := by
    intro C D _ _ _ _ _ _ _ F₁ F₂ _ _ _ _ _ _ σ A B n x
    rw [hExtNatTrans F₁ F₂ σ.hom A B n x,
        ← Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add n),
        Abelian.Ext.mk₀_comp_mk₀, σ.inv_hom_id_app, Abelian.Ext.mk₀_id_comp]
  have ext_conj_eq : ∀ {C : Type (u + 1)} [Category.{u + 1, u + 1} C]
      [Abelian C] [HasExt.{u} C] {X₁ X₂ X₃ Z₁ Z₂ Z₃ : C} {n : ℕ}
      (a : X₁ ⟶ X₂) (a' : X₂ ⟶ X₃) (b' : Z₁ ⟶ Z₂) (b : Z₂ ⟶ Z₃) (y : Abelian.Ext X₃ Z₁ n),
      ((Abelian.Ext.mk₀ a).comp
        ((Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (Nat.add_zero n))
          (Nat.zero_add n)) (Nat.zero_add n)).comp
        (Abelian.Ext.mk₀ b) (Nat.add_zero n) =
      (Abelian.Ext.mk₀ (a ≫ a')).comp (y.comp (Abelian.Ext.mk₀ (b' ≫ b)) (Nat.add_zero n))
        (Nat.zero_add n) := by
    intro C _ _ _ X₁ X₂ X₃ Z₁ Z₂ Z₃ n a a' b' b y
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add n),
        Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (a ≫ a')) _ _
          (Nat.zero_add n) (Nat.add_zero n) (by omega),
        Abelian.Ext.comp_assoc_of_third_deg_zero y _ _ (Nat.add_zero n),
        Abelian.Ext.mk₀_comp_mk₀]
  have hExtId : ∀ {C : Type (u + 1)}
      [Category.{u + 1, u + 1} C] [Abelian C] [HasExt.{u} C] [EnoughInjectives C]
      (A B : C) (n : ℕ) (x : Abelian.Ext A B n),
      ((𝟭 C).mapExtAddHom A B n) x = x := by
    intro C _ _ _ _ A B n x
    rw [Functor.mapExtAddHom_apply]
    induction n generalizing B with
    | zero =>
      have hx : Abelian.Ext.mk₀ (Abelian.Ext.addEquiv₀ x) = x := Abelian.Ext.addEquiv₀.left_inv x
      rw [← hx, Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ k ih =>
      let ι : B ⟶ Injective.under B := Injective.ι B
      let S : ShortComplex C := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hzero : x.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ A hS x hzero rfl
      let φ_id : S.map (𝟭 C) ⟶ S :=
        { τ₁ := 𝟙 S.X₁, τ₂ := 𝟙 S.X₂, τ₃ := 𝟙 S.X₃ }
      have hext_id : (hS.map_of_exact (𝟭 C)).extClass = hS.extClass :=
        ((Abelian.Ext.comp_mk₀_id _).symm.trans
          (ShortComplex.ShortExact.extClass_naturality (hS.map_of_exact (𝟭 C)) hS φ_id)).trans
          (Abelian.Ext.mk₀_id_comp _)
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass, hext_id,
          ih S.X₃ z]

  
  
  
  have hConstUnitShift : ∀ (W : Scheme.{u}) (𝒱 : Type (u + 1)) [Category.{u, u + 1} 𝒱]
      [HasWeakSheafify W.smallEtaleTopology 𝒱]
      {T T' : W.Etale} (hT : Limits.IsTerminal T) (hT' : Limits.IsTerminal T')
      (β : T' ⟶ T) (A : 𝒱),
      (constantSheafAdj W.smallEtaleTopology 𝒱 hT').unit.app A =
        (constantSheafAdj W.smallEtaleTopology 𝒱 hT).unit.app A ≫
          (((constantSheaf W.smallEtaleTopology 𝒱).obj A).obj.map β.op) := by
    intro W 𝒱 _ _ T T' hT hT' β A
    have hnat := ((sheafificationAdjunction W.smallEtaleTopology 𝒱).unit.app
      ((Functor.const (W.Etale)ᵒᵖ).obj A)).naturality β.op
    simpa [constantSheafAdj, constantPresheafAdj, constantSheaf] using hnat
  have hConstSymmShift : ∀ (W : Scheme.{u}) (𝒱 : Type (u + 1)) [Category.{u, u + 1} 𝒱]
      [HasWeakSheafify W.smallEtaleTopology 𝒱]
      {T T' : W.Etale} (hT : Limits.IsTerminal T) (hT' : Limits.IsTerminal T')
      (β : T' ⟶ T) (A : 𝒱) (𝒢 : Sheaf W.smallEtaleTopology 𝒱)
      (g : A ⟶ 𝒢.obj.obj (Opposite.op T)),
      ((constantSheafAdj W.smallEtaleTopology 𝒱 hT).homEquiv A 𝒢).symm g =
        ((constantSheafAdj W.smallEtaleTopology 𝒱 hT').homEquiv A 𝒢).symm
          (g ≫ 𝒢.obj.map β.op) := by
    intro W 𝒱 _ _ T T' hT hT' β A 𝒢 g
    let adj := constantSheafAdj W.smallEtaleTopology 𝒱 hT
    let adj' := constantSheafAdj W.smallEtaleTopology 𝒱 hT'
    apply (adj'.homEquiv A 𝒢).injective
    rw [Equiv.apply_symm_apply, Adjunction.homEquiv_unit]
    dsimp [sheafSections]
    rw [hConstUnitShift W 𝒱 hT hT' β A, Category.assoc,
        ((adj.homEquiv A 𝒢).symm g).hom.naturality β.op]
    have hg : adj.homEquiv A 𝒢 ((adj.homEquiv A 𝒢).symm g) = g :=
      (adj.homEquiv A 𝒢).apply_symm_apply g
    rw [Adjunction.homEquiv_unit] at hg
    dsimp [sheafSections] at hg
    rw [← Category.assoc, hg]

  let R := ULift.{u, 0} (ZMod m)
  let R_mod := ModuleCat.of R R
  let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let ιM : AM ⟶ F_fg.obj R_mod := AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let z_to_m : Aℤ ⟶ AM :=
    AddCommGrpCat.ofHom
      { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod m)
        map_zero' := congrArg ULift.up Int.cast_zero
        map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }

  
  have hq_std_eq : ∀ {W₁ W₂ : Scheme.{u}} (f : W₁ ⟶ W₂),
      letI : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
        MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
        MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_f : W₂.Etale ⥤ W₁.Etale :=
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
      ∀ (hCont : B_f.IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology)
        (T₂ : W₂.Etale) (hT₂ : Limits.IsTerminal T₂)
        (T₁ : W₁.Etale) (hT₁ : Limits.IsTerminal T₁),
        letI := hCont
        let f_push := B_f.sheafPushforwardContinuous (ModuleCat.{u, u} R)
          W₂.smallEtaleTopology W₁.smallEtaleTopology
        let One₂ := weilEtaleModuleUnit W₂ m
        let One₁ := weilEtaleModuleUnit W₁ m
        let adj₂ := constantSheafAdj W₂.smallEtaleTopology (ModuleCat.{u, u} R) hT₂
        let adj₁ := constantSheafAdj W₁.smallEtaleTopology (ModuleCat.{u, u} R) hT₁
        let τ_f : B_f.obj T₂ ⟶ T₁ := hT₁.from (B_f.obj T₂)
        let adj₂_std := constantSheafAdj W₂.smallEtaleTopology (ModuleCat.{u, u} R)
          (weilEtaleIdTerminalIsTerminal.{u} W₂)
        let adj₁_std := constantSheafAdj W₁.smallEtaleTopology (ModuleCat.{u, u} R)
          (weilEtaleIdTerminalIsTerminal.{u} W₁)
        let τ_f_std : B_f.obj (weilEtaleIdTerminal.{u} W₂) ⟶ weilEtaleIdTerminal.{u} W₁ :=
          (weilEtaleIdTerminalIsTerminal.{u} W₁).from (B_f.obj (weilEtaleIdTerminal.{u} W₂))
        (adj₂.homEquiv R_mod (f_push.obj One₁)).symm
          (adj₁.unit.app R_mod ≫ One₁.obj.map τ_f.op) =
        (adj₂_std.homEquiv R_mod (f_push.obj One₁)).symm
          (adj₁_std.unit.app R_mod ≫ One₁.obj.map τ_f_std.op) := by
    intro W₁ W₂ f
    dsimp only
    intro hCont T₂ hT₂ T₁ hT₁
    have : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_f : W₂.Etale ⥤ W₁.Etale :=
      MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    have := hCont
    let f_push := B_f.sheafPushforwardContinuous (ModuleCat.{u, u} R)
      W₂.smallEtaleTopology W₁.smallEtaleTopology
    let One₁ := weilEtaleModuleUnit W₁ m
    let β₂ : weilEtaleIdTerminal.{u} W₂ ⟶ T₂ := hT₂.from (weilEtaleIdTerminal.{u} W₂)
    let β₁ : weilEtaleIdTerminal.{u} W₁ ⟶ T₁ := hT₁.from (weilEtaleIdTerminal.{u} W₁)
    let τ_f : B_f.obj T₂ ⟶ T₁ := hT₁.from (B_f.obj T₂)
    let τ_f_std : B_f.obj (weilEtaleIdTerminal.{u} W₂) ⟶ weilEtaleIdTerminal.{u} W₁ :=
      (weilEtaleIdTerminalIsTerminal.{u} W₁).from (B_f.obj (weilEtaleIdTerminal.{u} W₂))
    have hτ_comm : τ_f_std ≫ β₁ = B_f.map β₂ ≫ τ_f := hT₁.hom_ext _ _
    have hτ_op : τ_f.op ≫ (B_f.map β₂).op = β₁.op ≫ τ_f_std.op := by
      rw [← op_comp, ← op_comp, hτ_comm]
    rw [hConstSymmShift W₂ (ModuleCat.{u, u} R) hT₂
        (weilEtaleIdTerminalIsTerminal.{u} W₂) β₂ R_mod (f_push.obj One₁)]
    congr 1
    change (constantSheafAdj W₁.smallEtaleTopology (ModuleCat.{u, u} R) hT₁).unit.app R_mod ≫
        (One₁.obj.map τ_f.op ≫ One₁.obj.map (B_f.map β₂).op) =
      (constantSheafAdj W₁.smallEtaleTopology (ModuleCat.{u, u} R)
        (weilEtaleIdTerminalIsTerminal.{u} W₁)).unit.app R_mod ≫
        One₁.obj.map τ_f_std.op
    rw [← One₁.obj.map_comp, hτ_op, One₁.obj.map_comp, ← Category.assoc,
        ← hConstUnitShift W₁ (ModuleCat.{u, u} R) hT₁
          (weilEtaleIdTerminalIsTerminal.{u} W₁) β₁ R_mod]

  
  have hForgetWitnessAlign : ∀ (W : Scheme.{u}) (k : ℕ)
      (θ : weilEtaleModuleH W m k →+ weilEtaleTorsionH W m k),
      WeilIsModuleToTorsionComparison W m k θ →
      let J := W.smallEtaleTopology
      let One_W := weilEtaleModuleUnit W m
      let C_ab := constantSheaf J AddCommGrpCat.{u}
      let Fℤ := C_ab.obj Aℤ
      let FM := C_ab.obj AM
      ∀ (U₂ : Sheaf J (ModuleCat.{u, u} R) ⥤ Sheaf J AddCommGrpCat.{u}),
        (∀ ℱ : Sheaf J (ModuleCat.{u, u} R), (U₂.obj ℱ).obj = ℱ.obj ⋙ F_fg) →
        (∀ {ℱ₁ ℱ₂ : Sheaf J (ModuleCat.{u, u} R)} (u : ℱ₁ ⟶ ℱ₂) (V : (W.Etale)ᵒᵖ),
          HEq ((U₂.map u).hom.app V) (F_fg.map (u.hom.app V))) →
        ∀ (hAdd₂ : U₂.Additive) (hLim₂ : Limits.PreservesFiniteLimits U₂)
          (hColim₂ : Limits.PreservesFiniteColimits U₂)
          (T₂ : W.Etale) (hT₂ : Limits.IsTerminal T₂),
          letI := hAdd₂; letI := hLim₂; letI := hColim₂
          let adj_ab₂ := constantSheafAdj J AddCommGrpCat.{u} hT₂
          let adj_mod₂ := constantSheafAdj J (ModuleCat.{u, u} R) hT₂
          ∀ (u_unit₂ : F_fg.obj R_mod ⟶ (U₂.obj One_W).obj.obj (Opposite.op T₂)),
            HEq u_unit₂ (F_fg.map (adj_mod₂.unit.app R_mod)) →
            let αM₂ : FM ⟶ U₂.obj One_W :=
              (adj_ab₂.homEquiv AM (U₂.obj One_W)).symm (ιM ≫ u_unit₂)
            let ιℤ₂ : Fℤ ⟶ U₂.obj One_W := C_ab.map z_to_m ≫ αM₂
            ∀ (πM₂ : U₂.obj One_W ⟶ FM),
              αM₂ ≫ πM₂ = 𝟙 FM →
              πM₂ ≫ αM₂ = 𝟙 (U₂.obj One_W) →
              ∀ γ : weilEtaleModuleH W m k,
                (Abelian.Ext.mk₀ πM₂).postcomp Fℤ (Nat.add_zero k)
                  ((Abelian.Ext.mk₀ ιℤ₂).comp
                    ((@Functor.mapExtAddHom _ _ _ _ _ _ U₂ _ _ _ _ _ One_W One_W k) γ)
                    (Nat.zero_add k)) = θ γ := by
    intro W k θ hθ
    dsimp only
    intro U₂ hU₂_obj hU₂_map hAdd₂ hLim₂ hColim₂ T₂ hT₂
    intro u_unit₂ hu₂
    intro πM₂ hαπ₂ hπα₂ γ
    let J := W.smallEtaleTopology
    let One_W := weilEtaleModuleUnit W m
    let C_ab := constantSheaf J AddCommGrpCat.{u}
    let Fℤ := C_ab.obj Aℤ
    let FM := C_ab.obj AM
    have := hAdd₂; have := hLim₂; have := hColim₂
    obtain ⟨U₁, hU₁_obj, hU₁_map, hAdd₁, hLim₁, hColim₁, T₁, hT₁, _, _, u_unit₁, hu₁,
        βM₁, hαβ₁, hβα₁, hθ_eq⟩ := hθ
    have := hAdd₁; have := hLim₁; have := hColim₁
    let σ : U₁ ≅ U₂ :=
      NatIso.ofComponents
        (fun ℱ =>
          { hom := { hom := eqToHom ((hU₁_obj ℱ).trans (hU₂_obj ℱ).symm) }
            inv := { hom := eqToHom ((hU₂_obj ℱ).trans (hU₁_obj ℱ).symm) }
            hom_inv_id := sheaf_hom_ext (by simp)
            inv_hom_id := sheaf_hom_ext (by simp) })
        (fun {ℱ₁ ℱ₂} u => sheaf_hom_ext (by
          ext V : 2
          dsimp
          simp only [eqToHom_app]
          exact hom_comp_eqToHom_of_heq _ _ ((hU₁_map u V).trans (hU₂_map u V).symm)))
    let adj_ab₁ := constantSheafAdj J AddCommGrpCat.{u} hT₁
    let adj_mod₁ := constantSheafAdj J (ModuleCat.{u, u} R) hT₁
    let adj_ab₂ := constantSheafAdj J AddCommGrpCat.{u} hT₂
    let adj_mod₂ := constantSheafAdj J (ModuleCat.{u, u} R) hT₂
    let β : T₂ ⟶ T₁ := hT₁.from T₂
    have h_mod_shift : F_fg.map (adj_mod₂.unit.app R_mod) =
        F_fg.map (adj_mod₁.unit.app R_mod) ≫ F_fg.map (One_W.obj.map β.op) := by
      rw [← F_fg.map_comp, ← hConstUnitShift W (ModuleCat.{u, u} R) hT₁ hT₂ β R_mod]
    have h_u_align : ∀ (P₁ P₂ : (W.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u})
        (hp₁ : P₁ = One_W.obj ⋙ F_fg) (hp₂ : P₂ = One_W.obj ⋙ F_fg)
        (u₁ : F_fg.obj R_mod ⟶ P₁.obj (Opposite.op T₁))
        (u₂ : F_fg.obj R_mod ⟶ P₂.obj (Opposite.op T₂)),
        HEq u₁ (F_fg.map (adj_mod₁.unit.app R_mod)) →
        HEq u₂ (F_fg.map (adj_mod₂.unit.app R_mod)) →
        (u₁ ≫ (eqToHom (hp₁.trans hp₂.symm)).app (Opposite.op T₁)) ≫ P₂.map β.op = u₂ := by
      rintro _ _ rfl rfl u₁ u₂ hu₁' hu₂'
      cases hu₁'; cases hu₂'
      simp [Functor.comp_map, h_mod_shift]
    let αM₁ : FM ⟶ U₁.obj One_W :=
      (adj_ab₁.homEquiv AM (U₁.obj One_W)).symm (ιM ≫ u_unit₁)
    let αM₂ : FM ⟶ U₂.obj One_W :=
      (adj_ab₂.homEquiv AM (U₂.obj One_W)).symm (ιM ≫ u_unit₂)
    have hαM_σ : αM₁ ≫ σ.hom.app One_W = αM₂ := by
      dsimp only [αM₁, αM₂]
      rw [← Adjunction.homEquiv_naturality_right_symm,
          hConstSymmShift W AddCommGrpCat.{u} hT₁ hT₂ β AM (U₂.obj One_W)]
      congr 1
      change (ιM ≫ u_unit₁) ≫ ((eqToHom ((hU₁_obj One_W).trans (hU₂_obj One_W).symm)).app
          (Opposite.op T₁)) ≫ (U₂.obj One_W).obj.map β.op = ιM ≫ u_unit₂
      rw [Category.assoc, ← Category.assoc u_unit₁,
          h_u_align (U₁.obj One_W).obj (U₂.obj One_W).obj
            (hU₁_obj One_W) (hU₂_obj One_W) u_unit₁ u_unit₂ hu₁ hu₂]
    have hσ_πM : σ.hom.app One_W ≫ πM₂ = βM₁ := by
      calc
        σ.hom.app One_W ≫ πM₂ = 𝟙 (U₁.obj One_W) ≫ σ.hom.app One_W ≫ πM₂ :=
          (Category.id_comp _).symm
        _ = (βM₁ ≫ αM₁) ≫ σ.hom.app One_W ≫ πM₂ := by rw [hβα₁]
        _ = βM₁ ≫ (αM₁ ≫ σ.hom.app One_W) ≫ πM₂ := by simp only [Category.assoc]
        _ = βM₁ ≫ αM₂ ≫ πM₂ := by rw [hαM_σ]
        _ = βM₁ ≫ 𝟙 FM := by rw [hαπ₂]
        _ = βM₁ := Category.comp_id _
    let ιℤ_mod : Aℤ ⟶ F_fg.obj R_mod :=
      (AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u} ℤ)) :
        Aℤ ⟶ AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ)) ≫
        (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (Int.castAddHom (ZMod m))) ≫ ιM)
    have hz_ι : z_to_m ≫ ιM = ιℤ_mod := by
      ext x
      rfl
    let ηℤ₁ : Fℤ ⟶ U₁.obj One_W :=
      (adj_ab₁.homEquiv Aℤ (U₁.obj One_W)).symm (ιℤ_mod ≫ u_unit₁)
    have hηℤ₁_eq : C_ab.map z_to_m ≫ αM₁ = ηℤ₁ := by
      dsimp only [αM₁, ηℤ₁]
      rw [← Adjunction.homEquiv_naturality_left_symm, ← Category.assoc, hz_ι]
    let ιℤ₂ : Fℤ ⟶ U₂.obj One_W := C_ab.map z_to_m ≫ αM₂
    have hιℤ_σ : ιℤ₂ ≫ σ.inv.app One_W = ηℤ₁ := by
      dsimp only [ιℤ₂]
      rw [← hαM_σ]
      simp only [Category.assoc, σ.hom_inv_id_app, Category.comp_id, hηℤ₁_eq]
    rw [hθ_eq γ]
    change (((Abelian.Ext.mk₀ ιℤ₂).comp
        ((U₂.mapExtAddHom One_W One_W k) γ) (Nat.zero_add k)).comp
        (Abelian.Ext.mk₀ πM₂) (Nat.add_zero k)) =
      (((Abelian.Ext.mk₀ ηℤ₁).comp
        ((U₁.mapExtAddHom One_W One_W k) γ) (Nat.zero_add k)).comp
        (Abelian.Ext.mk₀ βM₁) (Nat.add_zero k))
    rw [hExtIso U₁ U₂ σ One_W One_W k γ,
        ext_conj_eq ιℤ₂ (σ.inv.app One_W) (σ.hom.app One_W) πM₂
          ((U₁.mapExtAddHom One_W One_W k) γ),
        hιℤ_σ, hσ_πM]
    exact (Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ηℤ₁)
      ((U₁.mapExtAddHom One_W One_W k) γ) (Abelian.Ext.mk₀ βM₁)
      (Nat.zero_add k) (Nat.add_zero k) (by omega)).symm

  
  
  
