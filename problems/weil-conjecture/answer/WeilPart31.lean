      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
          (CategoryTheory.Abelian.Ext.mk₀ eX.inv) x
          (CategoryTheory.Abelian.Ext.mk₀ eY.hom) (Nat.zero_add q),
