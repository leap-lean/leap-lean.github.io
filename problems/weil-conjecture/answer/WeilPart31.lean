    have hpZ_nat : (One_sh Z').obj.map τ_i'.op ≫ pZ_app_B =
        pZ_app_0 ≫ (One_sh Z₀).obj.map (M_gZ.map τ_i').op :=
      (π_can g_Z hg_Z).inv.hom.naturality τ_i'.op
    have hpY : u_Y' ≫ pY_app = u_Y₀ ≫ (One_sh Y₀).obj.map μ_g.op :=
      (CategoryTheory.Adjunction.homEquiv_unit adj_Y' R_mod _ (π_can g hg).inv).symm.trans
        ((congrArg (adj_Y'.homEquiv R_mod _) (hπ_can g hg).2).trans
          ((adj_Y'.homEquiv R_mod _).apply_symm_apply _))
    have hqi₀ : u_Y₀ ≫ qi₀_app_0 = u_Z₀ ≫ (One_sh Z₀).obj.map τ_i₀.op :=
      (CategoryTheory.Adjunction.homEquiv_unit adj_Y₀ R_mod _ (q_can i₀)).symm.trans
        ((adj_Y₀.homEquiv R_mod _).apply_symm_apply _)
    have hqi₀_nat : (One_sh Y₀).obj.map μ_g.op ≫ qi₀_app_M =
        qi₀_app_0 ≫ (One_sh Z₀).obj.map (B_i₀.map μ_g).op :=
      (q_can i₀).hom.naturality μ_g.op
    have h_term : (θ.inv.app (T_can Y') ≫ M_gZ.map τ_i') ≫ μ_gZ = B_i₀.map μ_g ≫ τ_i₀ :=
      (hT_can Z₀).hom_ext _ _
    change u_Y' ≫ (qi'_app ≫ (pZ_app_B ≫ ξ_app)) = u_Y' ≫ (pY_app ≫ qi₀_app_M)
    calc
      u_Y' ≫ (qi'_app ≫ (pZ_app_B ≫ ξ_app))
          = (u_Y' ≫ qi'_app) ≫ (pZ_app_B ≫ ξ_app) :=
            (CategoryTheory.Category.assoc _ _ _).symm
      _ = u_Z' ≫ (((One_sh Z').obj.map τ_i'.op ≫ pZ_app_B) ≫ ξ_app) := by
            rw [hqi']
            simp only [CategoryTheory.Category.assoc]
      _ = (u_Z' ≫ pZ_app_0) ≫ ((One_sh Z₀).obj.map (M_gZ.map τ_i').op ≫ ξ_app) := by
            rw [hpZ_nat]
            simp only [CategoryTheory.Category.assoc]
      _ = u_Z₀ ≫ ((One_sh Z₀).obj.map μ_gZ.op ≫
            (One_sh Z₀).obj.map (M_gZ.map τ_i').op ≫
            (One_sh Z₀).obj.map (θ.inv.app (T_can Y')).op) := by
            rw [hpZ]
            simp only [CategoryTheory.Category.assoc, ξ_app]
      _ = u_Z₀ ≫ (One_sh Z₀).obj.map ((θ.inv.app (T_can Y') ≫ M_gZ.map τ_i') ≫ μ_gZ).op := by
            rw [← (One_sh Z₀).obj.map_comp, ← (One_sh Z₀).obj.map_comp, ← op_comp, ← op_comp]
      _ = u_Z₀ ≫ (One_sh Z₀).obj.map (B_i₀.map μ_g ≫ τ_i₀).op := by
            rw [h_term]
      _ = (u_Z₀ ≫ (One_sh Z₀).obj.map τ_i₀.op) ≫ (One_sh Z₀).obj.map (B_i₀.map μ_g).op := by
            rw [op_comp, (One_sh Z₀).obj.map_comp, CategoryTheory.Category.assoc]
      _ = u_Y₀ ≫ (qi₀_app_0 ≫ (One_sh Z₀).obj.map (B_i₀.map μ_g).op) := by
            rw [← hqi₀, CategoryTheory.Category.assoc]
      _ = (u_Y₀ ≫ (One_sh Y₀).obj.map μ_g.op) ≫ qi₀_app_M := by
            rw [← hqi₀_nat, CategoryTheory.Category.assoc]
      _ = u_Y' ≫ (pY_app ≫ qi₀_app_M) := by
            rw [← hpY, CategoryTheory.Category.assoc]

  choose β_cart hβ_cart using @h_beta_ex

  
  have hCartIff : ∀ {Z' Y' Z₀ Y₀ : AlgebraicGeometry.Scheme.{u}}
      (g : Quiver.Hom Y' Y₀) (hg : AlgebraicGeometry.Etale g)
      (i' : Quiver.Hom Z' Y') (hi' : AlgebraicGeometry.IsClosedImmersion i')
      (i₀ : Quiver.Hom Z₀ Y₀) (g_Z : Quiver.Hom Z' Z₀)
      (hpb : CategoryTheory.IsPullback i' g_Z g i₀)
      (q : ℕ) (τ : WeilGysinSupportClass Z₀ Y₀ i₀ m q)
      (τ' : WeilGysinSupportClass Z' Y' i' m q),
      let hEx := hResAdj g hg (hContM g hg) (hContB Y' Y₀ g)
      letI := hEx.2.1; letI := hEx.2.2.1; letI := hEx.2.2.2
      WeilGysinSupportPullback g i' i₀ m q τ' τ ↔
        τ'.val = ((CategoryTheory.Abelian.Ext.mk₀ (β_cart g hg i' i₀ g_Z hpb).hom).comp
          ((res_et g hg).mapExtAddHom ((push_all i₀).obj (One_sh Z₀)) (One_sh Y₀) q τ.val)
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (π_can g hg).hom) (Nat.add_zero q) := by
    intro Z' Y' Z₀ Y₀ g hg i' hi' i₀ g_Z hpb q τ τ' hEx
    let _ := hEx.2.1; let _ := hEx.2.2.1; let _ := hEx.2.2.2
    have h_rev : ∀ (ω : WeilGysinSupportClass Z' Y' i' m q),
        ω.val = ((CategoryTheory.Abelian.Ext.mk₀ (β_cart g hg i' i₀ g_Z hpb).hom).comp
          ((res_et g hg).mapExtAddHom ((push_all i₀).obj (One_sh Z₀)) (One_sh Y₀) q τ.val)
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (π_can g hg).hom) (Nat.add_zero q) →
        WeilGysinSupportPullback g i' i₀ m q ω τ := by
      intro ω hω
      refine ⟨hContB Y' Y₀ g, res_et g hg, adj_can g hg, hEx.2.1, hEx.2.2.1, hEx.2.2.2,
        T_can Y₀, hT_can Y₀, T_can Z₀, hT_can Z₀, T_can Y', hT_can Y', T_can Z', hT_can Z',
        (π_can g hg).inv, (β_cart g hg i' i₀ g_Z hpb).hom, ?_, ?_, hβ_cart g hg i' i₀ g_Z hpb, ?_⟩
      · exact (hπ_can g hg).1 ▸ (π_can g hg).inv_hom_id
      · exact (hπ_can g hg).1 ▸ (π_can g hg).hom_inv_id
      · exact (hπ_can g hg).1 ▸ hω
    constructor
    · intro h_pb
      let τ'_std : WeilGysinSupportClass Z' Y' i' m q :=
        ⟨τ'.hCont, ((CategoryTheory.Abelian.Ext.mk₀ (β_cart g hg i' i₀ g_Z hpb).hom).comp
          ((res_et g hg).mapExtAddHom ((push_all i₀).obj (One_sh Z₀)) (One_sh Y₀) q τ.val)
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (π_can g hg).hom) (Nat.add_zero q)⟩
      have h_eq : τ' = τ'_std := hPbUniq g i' i₀ hi' q τ τ' τ'_std h_pb (h_rev τ'_std rfl)
      rw [h_eq]
    · exact h_rev τ'

  have hCoh_β : ∀ {Z₁ Y₁ Z₂ Y₂ Z₃ Y₃ : AlgebraicGeometry.Scheme.{u}}
      (g₁ : Quiver.Hom Y₁ Y₂) (hg₁ : AlgebraicGeometry.Etale g₁)
      (g₂ : Quiver.Hom Y₂ Y₃) (hg₂ : AlgebraicGeometry.Etale g₂)
      (g₁₂ : Quiver.Hom Y₁ Y₃) (hg₁₂ : AlgebraicGeometry.Etale g₁₂)
      (i₁ : Quiver.Hom Z₁ Y₁) (hi₁ : AlgebraicGeometry.IsClosedImmersion i₁)
      (i₂ : Quiver.Hom Z₂ Y₂) (i₃ : Quiver.Hom Z₃ Y₃)
      (g_Z1 : Quiver.Hom Z₁ Z₂) (hpb₁ : CategoryTheory.IsPullback i₁ g_Z1 g₁ i₂)
      (g_Z2 : Quiver.Hom Z₂ Z₃) (hpb₂ : CategoryTheory.IsPullback i₂ g_Z2 g₂ i₃)
      (g_Z12 : Quiver.Hom Z₁ Z₃) (hpb₁₂ : CategoryTheory.IsPullback i₁ g_Z12 g₁₂ i₃)
      (σ : CategoryTheory.Iso (res_et g₁₂ hg₁₂)
        (CategoryTheory.Functor.comp (res_et g₂ hg₂) (res_et g₁ hg₁))),
      (∃ u_T : Quiver.Hom (((M_et g₁ hg₁).comp (M_et g₂ hg₂)).obj (T_can Y₁))
          ((M_et g₁₂ hg₁₂).obj (T_can Y₁)),
        ((σ.hom.app (One_sh Y₃)).hom.app (Opposite.op (T_can Y₁))) = (One_sh Y₃).obj.map u_T.op) →
