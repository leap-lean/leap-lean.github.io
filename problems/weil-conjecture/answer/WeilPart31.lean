        refine ⟨s₀, ?_⟩
        suffices hdiff : (α.hom.app (Opposite.op V₀)).hom s₀ - t₀ = 0 by
          exact sub_eq_zero.mp hdiff
        refine hSheafEqZeroOfCover Z G₂ V₀ _ S_V₀ hS_V₀ ?_
        intro W g hg
        obtain ⟨pt, h_w, rfl⟩ := hExFactor g hg
        rw [map_sub, op_comp, G₂.obj.map_comp]
        have hnat := congrArg (fun m => m.hom s₀) (α.hom.naturality (v_pt pt).op)
        have hnat' : (G₂.obj.map (v_pt pt).op).hom ((α.hom.app (Opposite.op V₀)).hom s₀) =
