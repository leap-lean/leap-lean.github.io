    rcases hu_b_unit with ⟨u_unit, hu_unit⟩
    have hu_inv_mul : (((u_unit⁻¹ : (ZMod (ℓ ^ r))ˣ) : ZMod (ℓ ^ r))) * u_b = 1 := by
      rw [← hu_unit]
