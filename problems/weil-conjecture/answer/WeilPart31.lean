    have hg_loc : CategoryTheory.Presheaf.IsLocallySurjective Y.smallEtaleTopology g_sub := by
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk fun {T} s => ?_
      by_cases hu : P_W (W₁ ⊔ W₂) T
      · let O₁ : T.left.Opens := (TopologicalSpace.Opens.map T.hom.base).obj W₁
        let O₂ : T.left.Opens := (TopologicalSpace.Opens.map T.hom.base).obj W₂
        let T₁ : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O₁.ι ≫ T.hom)
          (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            O₁.ι T.hom inferInstance T.prop)
        let T₂ : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O₂.ι ≫ T.hom)
          (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            O₂.ι T.hom inferInstance T.prop)
        let ι₁ : T₁ ⟶ T := CategoryTheory.MorphismProperty.Over.homMk O₁.ι
          (Category.comp_id (O₁.ι ≫ T.hom)).symm trivial
        let ι₂ : T₂ ⟶ T := CategoryTheory.MorphismProperty.Over.homMk O₂.ι
          (Category.comp_id (O₂.ι ≫ T.hom)).symm trivial
        have h₁_T₁ : P_W W₁ T₁ := by
          dsimp only [P_W]
          rw [hRange_eq W₁]
          rintro _ ⟨z, rfl⟩
          exact z.2
        have h₂_T₂ : P_W W₂ T₂ := by
          dsimp only [P_W]
          rw [hRange_eq W₂]
          rintro _ ⟨z, rfl⟩
          exact z.2
        have h_sieve₁ : (CategoryTheory.Presheaf.imageSieve g_sub s).arrows ι₁ := by
          rw [CategoryTheory.Presheaf.imageSieve_apply]
          let y₁ : (S_sub ℋ W₁).obj (Opposite.op T₁) :=
            fun _ => ℋ.obj.map ι₁.op (s ⟨hu⟩)
          refine ⟨(CategoryTheory.Limits.biprod.inl :
            S_sub ℋ W₁ ⟶ S_sub ℋ W₁ ⊞ S_sub ℋ W₂).app (Opposite.op T₁) y₁, ?_⟩
          have hinl : (CategoryTheory.Limits.biprod.inl ≫ g_sub).app (Opposite.op T₁) y₁ =
              g_sub₁.app (Opposite.op T₁) y₁ := by
            dsimp only [g_sub]
            rw [CategoryTheory.Limits.biprod.inl_desc]
          change ((CategoryTheory.Limits.biprod.inl ≫ g_sub).app (Opposite.op T₁) y₁) =
            (S_sub ℋ (W₁ ⊔ W₂)).map ι₁.op s
          rw [hinl]
          funext ⟨_⟩
          change (if h₁ : P_W W₁ T₁ then y₁ ⟨h₁⟩ else 0) =
            if hu' : P_W (W₁ ⊔ W₂) T then ℋ.obj.map ι₁.op (s ⟨hu'⟩) else 0
          rw [dif_pos h₁_T₁, dif_pos hu]
        have h_sieve₂ : (CategoryTheory.Presheaf.imageSieve g_sub s).arrows ι₂ := by
          rw [CategoryTheory.Presheaf.imageSieve_apply]
          let y₂ : (S_sub ℋ W₂).obj (Opposite.op T₂) :=
            fun _ => ℋ.obj.map ι₂.op (s ⟨hu⟩)
          refine ⟨(CategoryTheory.Limits.biprod.inr :
            S_sub ℋ W₂ ⟶ S_sub ℋ W₁ ⊞ S_sub ℋ W₂).app (Opposite.op T₂) y₂, ?_⟩
          have hinr : (CategoryTheory.Limits.biprod.inr ≫ g_sub).app (Opposite.op T₂) y₂ =
              g_sub₂.app (Opposite.op T₂) y₂ := by
            dsimp only [g_sub]
            rw [CategoryTheory.Limits.biprod.inr_desc]
          change ((CategoryTheory.Limits.biprod.inr ≫ g_sub).app (Opposite.op T₂) y₂) =
            (S_sub ℋ (W₁ ⊔ W₂)).map ι₂.op s
          rw [hinr]
          funext ⟨_⟩
          change (if h₂ : P_W W₂ T₂ then y₂ ⟨h₂⟩ else 0) =
            if hu' : P_W (W₁ ⊔ W₂) T then ℋ.obj.map ι₂.op (s ⟨hu'⟩) else 0
          rw [dif_pos h₂_T₂, dif_pos hu]
        let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
          @AlgebraicGeometry.Etale
        have : P_et.IsStableUnderComposition :=
          CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
        have htop_eq : Y.smallEtaleTopology =
            (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := Y)).toGrothendieck :=
