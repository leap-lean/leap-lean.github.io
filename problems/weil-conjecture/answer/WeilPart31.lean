        have hmem' : R' ∈
            (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := Y)).toGrothendieck T' :=
          (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
            (P := P_et) (Q := P_et) (S := Y) T' R').mpr fun x => by
            have hx : T.hom.base x ∈ (W₁ : Set Y) ∪ (W₂ : Set Y) :=
