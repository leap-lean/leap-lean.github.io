    have hg_bij : Function.Bijective g_end := Finite.surjective_iff_bijective.mp hg_surj
    have hφ_eq : (φ_slice : weilGysinSupportExtGroup τ_V → ZMod (ℓ ^ r)) = g_end ∘ e_V := by
      funext v
      change φ_slice v = φ_slice (e_V.symm (e_V v))
      rw [e_V.symm_apply_apply]
    have hφ_bij : Function.Bijective φ_slice := by
      rw [hφ_eq]
      exact hg_bij.comp e_V.bijective
    let c : ℕ := (φ_slice α * ((u_unit⁻¹ : (ZMod (ℓ ^ r))ˣ) : ZMod (ℓ ^ r))).val
    refine ⟨c, hφ_bij.injective ?_⟩
    rw [map_nsmul, hφ_τV, nsmul_eq_mul, ZMod.natCast_zmod_val,
      mul_assoc, hu_inv_mul, mul_one]

theorem weil_gysin_graph_purity_thom_and_transversal_pullback (k : Type u) [Field k] [IsAlgClosed k]
