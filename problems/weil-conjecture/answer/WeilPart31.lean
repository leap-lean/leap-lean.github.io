            rw [← hπ_comp, ← CategoryTheory.Category.assoc, hw,
              CategoryTheory.Limits.zero_comp]))
          (fun w _ => CategoryTheory.Limits.kernel.lift_ι _ _ _)
          (fun w _ m hm => by
            have : CategoryTheory.Mono (ι q) := hι_mono q
