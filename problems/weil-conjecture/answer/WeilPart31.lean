  have hColonGlue : ∀ {R : Type u} [CommRing R] (I K : Ideal R),
      (∀ (𝔭 : Ideal R), 𝔭.IsPrime → ∃ h : R, h ∉ 𝔭 ∧ ∀ r ∈ I, ∃ n : ℕ, h ^ n * r ∈ K) →
      I ≤ K := by
    intro R _ I K hLoc r hr
    let 𝔞 : Ideal R :=
      { carrier := {x : R | x * r ∈ K}
        add_mem' := fun {x y} hx hy => by
          change (x + y) * r ∈ K
          rw [add_mul]
          exact K.add_mem hx hy
        zero_mem' := by
          change 0 * r ∈ K
          rw [zero_mul]
          exact K.zero_mem
        smul_mem' := fun c {x} hx => by
          change (c * x) * r ∈ K
          rw [mul_assoc]
          exact K.mul_mem_left c hx }
    by_contra hr_not
    have h𝔞_ne_top : 𝔞 ≠ ⊤ := by
      rw [Ideal.ne_top_iff_one]
      intro h1
      change 1 * r ∈ K at h1
      rw [one_mul] at h1
      exact hr_not h1
    obtain ⟨𝔪, h𝔪_max, h𝔞_le⟩ := Ideal.exists_le_maximal 𝔞 h𝔞_ne_top
    obtain ⟨h, hh_not, hh_pow⟩ := hLoc 𝔪 h𝔪_max.isPrime
    obtain ⟨n, hn⟩ := hh_pow r hr
    have hhn_mem : h ^ n ∈ 𝔪 := h𝔞_le hn
    exact hh_not (h𝔪_max.isPrime.mem_of_pow_mem n hhn_mem)

  
