      intro ℱ
      apply hSheafMod Z (P_pre ℱ)
      let e_pre : (P_pull_ab.obj ((U_fun Y).obj ℱ)).obj ≅ (P_pre ℱ ⋙ F_fg) :=
        CategoryTheory.NatIso.ofComponents
          (fun _ => CategoryTheory.Iso.refl _)
