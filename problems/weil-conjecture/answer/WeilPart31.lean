      refine ⟨fun hw => by rw [hw]; exact hq_eq, fun hw => ?_⟩
      exact W.isoSpec.hom.homeomorph.injective (hw.trans hq_eq.symm)
    rw [hset]
    exact hq_cl.preimage W.isoSpec.hom.homeomorph.continuous

