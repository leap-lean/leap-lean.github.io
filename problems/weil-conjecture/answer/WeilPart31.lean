    have hSE_sub : S_sh_sub.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' hExMono.1 hExMono.2 inferInstance

    let τ₁ : F_sh.obj (S_sub ℋ (W₁ ⊓ W₂)) ≅ (j_ext (W₁ ⊓ W₂)).obj ((j_res (W₁ ⊓ W₂)).obj ℋ) :=
      F_sh.mapIso (Θ_iso ℋ (W₁ ⊓ W₂)).symm
    let τ₂ : F_sh.obj (S_sub ℋ W₁ ⊞ S_sub ℋ W₂) ≅
