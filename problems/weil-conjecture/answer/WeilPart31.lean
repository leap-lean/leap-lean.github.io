  have hBase0 : ∀ (G : 𝒞) (hpq : 0 + 2 * d = 2 * d),
      Function.Bijective (Φ G 0 (2 * d) hpq) := by
    intro G hpq
    have hpq_eq : hpq = Nat.zero_add (2 * d) := Subsingleton.elim _ _
    subst hpq_eq
    refine ⟨?_, ?_⟩
    · intro β₁ β₂ h12
      apply (E_top G).symm.injective
      let φ₁ := (E_top G).symm β₁
      let φ₂ := (E_top G).symm β₂
      have hβ₁ : E_top G φ₁ = β₁ := (E_top G).apply_symm_apply β₁
      have hβ₂ : E_top G φ₂ = β₂ := (E_top G).apply_symm_apply β₂
      apply AddMonoidHom.ext
      intro α
      have hα := DFunLike.congr_fun h12 α
      change τ (α.comp β₁ (Nat.zero_add (2 * d))) =
        τ (α.comp β₂ (Nat.zero_add (2 * d))) at hα
      rw [← hβ₁, ← hβ₂, hCalib G φ₁ α, hCalib G φ₂ α] at hα
