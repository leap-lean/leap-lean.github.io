    intro C _ _ _ _ q X₀ Y₀ e
    induction q generalizing X₀ Y₀ with
    | zero =>
      obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective X₀ Y₀).2 e
      simp only [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀, CategoryTheory.Functor.id_map]
    | succ q ih =>
      let I : C := CategoryTheory.Injective.under Y₀
      let ι : Y₀ ⟶ I := CategoryTheory.Injective.ι Y₀
      let π : I ⟶ CategoryTheory.Limits.cokernel ι := CategoryTheory.Limits.cokernel.π ι
