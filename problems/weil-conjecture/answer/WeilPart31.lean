        · intro α
          obtain ⟨w₀, rfl⟩ := hΥ_surj₀ (k + 1) F α
          have hw₀ : w₀ = w_ker w₀.1 := Subtype.ext rfl
          rw [← hPair₀ F f₀ w₀, hf₀_tS, Equiv.symm_apply_apply, hμ_φ]
