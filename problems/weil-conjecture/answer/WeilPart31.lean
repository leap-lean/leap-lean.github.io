          let w_p_left : Y_p.left ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Q_of pt)) := w_p.left
          have : Etale w_p_left := hEt_wp
          have hEt_waff : Etale (e_Wm.inv ≫ W_m.ι ≫ w_p_left) := inferInstance
          let w_aff : AlgebraicGeometry.Spec R_m_cat ⟶
              AlgebraicGeometry.Spec (CommRingCat.of (Q_of pt)) :=
            e_Wm.inv ≫ W_m.ι ≫ w_p_left
          have : Etale w_aff := hEt_waff
          let ψ_m_cat : CommRingCat.of (Q_of pt) ⟶ R_m_cat :=
            AlgebraicGeometry.Spec.preimage w_aff
          have hψ_m_map : AlgebraicGeometry.Spec.map ψ_m_cat = w_aff :=
            AlgebraicGeometry.Spec.map_preimage w_aff
          have hEt_ψm : ψ_m_cat.hom.Etale :=
            (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
              (hψ_m_map.symm ▸ inferInstance)
          let _ : Algebra (Q_of pt) R_m := ψ_m_cat.hom.toAlgebra
          have : Algebra.Etale (Q_of pt) R_m := RingHom.etale_algebraMap.mp hEt_ψm
          let g_Q : S_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Q_of pt)) :=
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (τ_κ.toRingHom.comp (Ideal.Quotient.mk M_pt)))
          let pt₀ : ↥S_Ω := ⟨⊥, Ideal.isPrime_bot⟩
          let x_ym : ↥(AlgebraicGeometry.Spec R_m_cat) := e_Wm.hom.base ⟨y_p, hy_m⟩
          have hx_eq_gQ : w_aff.base x_ym = g_Q.base pt₀ :=
            (hq_uniq _).trans (hq_uniq _).symm
          obtain ⟨p_pb, _, _⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x_ym pt₀ hx_eq_gQ
          let q_m := Limits.pullback.snd w_aff g_Q
          have : Etale q_m := inferInstance
          obtain ⟨s_pb, hs_pb, _⟩ := hSecAlgClosed Ω q_m p_pb
          let s_Rm : S_Ω ⟶ AlgebraicGeometry.Spec R_m_cat :=
            s_pb ≫ Limits.pullback.fst w_aff g_Q
          have hs_Rm_w : s_Rm ≫ w_aff = g_Q := by
            dsimp [s_Rm]
            rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hs_pb,
              Category.id_comp]
          let β_cat : R_m_cat ⟶ CommRingCat.of Ω := AlgebraicGeometry.Spec.preimage s_Rm
          have hβ_map : AlgebraicGeometry.Spec.map β_cat = s_Rm :=
            AlgebraicGeometry.Spec.map_preimage s_Rm
          have hψβ : β_cat.hom.comp ψ_m_cat.hom =
              τ_κ.toRingHom.comp (Ideal.Quotient.mk M_pt) := by
            have h_spec_eq : AlgebraicGeometry.Spec.map (ψ_m_cat ≫ β_cat) = g_Q := by
              rw [AlgebraicGeometry.Spec.map_comp, hψ_m_map, hβ_map, hs_Rm_w]
            have h_pre := AlgebraicGeometry.Spec.map_injective h_spec_eq
            exact congrArg CommRingCat.Hom.hom h_pre
          let f_res : R_m →ₐ[Q_of pt] κ_pt :=
            { toRingHom := (algebraMap Ω κ_pt).comp β_cat.hom
              commutes' := fun q_el => by
                change algebraMap Ω κ_pt (β_cat.hom (ψ_m_cat.hom q_el)) = Ideal.Quotient.mk M_pt q_el
                have h_app := congrArg (fun f => f q_el) hψβ
                change β_cat.hom (ψ_m_cat.hom q_el) = τ_κ (Ideal.Quotient.mk M_pt q_el) at h_app
                rw [h_app, hτ_inv] }
          obtain ⟨f_lift, _⟩ := Algebra.FormallySmooth.exists_lift M_pt hNil_M f_res
          let f_lift_cat : R_m_cat ⟶ CommRingCat.of (Q_of pt) := CommRingCat.ofHom f_lift.toRingHom
          have hψ_lift : ψ_m_cat ≫ f_lift_cat = 𝟙 (CommRingCat.of (Q_of pt)) := by
            ext q_el
            exact f_lift.commutes q_el
          let τ_left : (V_pt pt).left ⟶ Y_p.left :=
            AlgebraicGeometry.Spec.map f_lift_cat ≫ e_Wm.inv ≫ W_m.ι
          have hτ_wp : τ_left ≫ w_p.left = 𝟙 (V_pt pt).left :=
            (Category.assoc _ _ w_p.left).trans
              ((congrArg (_ ≫ ·) (Category.assoc _ _ w_p.left)).trans
                ((congrArg (_ ≫ ·) hψ_m_map.symm).trans
                  ((AlgebraicGeometry.Spec.map_comp ψ_m_cat f_lift_cat).symm.trans
                    ((congrArg AlgebraicGeometry.Spec.map hψ_lift).trans
                      (AlgebraicGeometry.Spec.map_id _)))))
          have hτ_hom : τ_left ≫ Y_p.hom = (V_pt pt).hom :=
            (congrArg (τ_left ≫ ·) (MorphismProperty.Over.w w_p).symm).trans
              ((Category.assoc τ_left w_p.left _).symm.trans
                ((congrArg (· ≫ (V_pt pt).hom) hτ_wp).trans (Category.id_comp _)))
