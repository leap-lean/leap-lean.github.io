          intro G φ α
          change α.comp ((E_s G φ).comp (hSC_step s hsk).extClass rfl) (Nat.zero_add (s + 2)) =
            (E_s one₀ (φ.comp (α.postcomp one₀ (Nat.add_zero 0)))).comp (hSC_step s hsk).extClass rfl
          rw [← CategoryTheory.Abelian.Ext.comp_assoc α (E_s G φ) (hSC_step s hsk).extClass
            (Nat.zero_add (s + 1)) rfl (by omega),
            hE_s_nat G φ α]
      obtain ⟨E_k, hE_k_nat⟩ := hE_tower k (le_refl k)
      let iso_Bk : ∀ G : 𝒞₀,
          CategoryTheory.Abelian.Ext.{u} G (B k) (k + 1) ≃+
            CategoryTheory.Abelian.Ext.{u} G one₀ (k + 1) := fun G =>
        { toFun := fun x =>
            x.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv e_dual)) (Nat.add_zero (k + 1))
          invFun := fun y =>
            y.comp (CategoryTheory.Abelian.Ext.mk₀ e_dual) (Nat.add_zero (k + 1))
          left_inv := fun x => by
            dsimp
            rw [CategoryTheory.Abelian.Ext.comp_assoc x _ _
              (Nat.add_zero (k + 1)) (Nat.add_zero 0) (by omega),
              CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.inv_hom_id,
              CategoryTheory.Abelian.Ext.comp_mk₀_id]
          right_inv := fun y => by
            dsimp
            rw [CategoryTheory.Abelian.Ext.comp_assoc y _ _
              (Nat.add_zero (k + 1)) (Nat.add_zero 0) (by omega),
              CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.hom_inv_id,
              CategoryTheory.Abelian.Ext.comp_mk₀_id]
          map_add' := fun x₁ x₂ => CategoryTheory.Abelian.Ext.add_comp x₁ x₂ _ _ }
      refine ⟨hDeg0_succ, hVan_succ, fun G => (E_k G).trans (iso_Bk G), ?_⟩
      intro G φ α
      change α.comp ((E_k G φ).comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv e_dual))
          (Nat.add_zero (k + 1))) (Nat.zero_add (k + 1)) =
        (E_k one₀ (φ.comp (α.postcomp one₀ (Nat.add_zero 0)))).comp
          (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv e_dual)) (Nat.add_zero (k + 1))
      rw [← CategoryTheory.Abelian.Ext.comp_assoc α (E_k G φ) _
        (Nat.zero_add (k + 1)) (Nat.add_zero (k + 1)) (by omega),
        hE_k_nat G φ α]
  exact hPillar3 (weilCupPDModUnit S n) (2 * d) τ C d_C Υ
    hDC_top hΥ_surj hΥ_inj0 hΥ_ker hΥ_nat
    𝒥 Ψ diffDual t_S hInj𝒥 hΨ_add hΨ_nat hΨ_diff hDiffZero hPair hMono_tS hExCases

theorem weil_cupPD_verdier_left_nondegenerate_of_effacement (S : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥S]
    (d i n : ℕ) (hi : i ≤ 2 * d) (hn : 1 ≤ n)
    (τ : weilCupPDModH S n (2 * d) →+ ZMod n)
    (hGod : WeilCupPDHasTruncatedGodement S d n)
    (hEff : WeilCupPDHasLocalEffacement S d n τ)
    (a : weilCupPDModH S n i)
    (ha : ∀ b : weilCupPDModH S n (2 * d - i),
      CategoryTheory.Abelian.Ext.comp a b (Nat.add_sub_of_le hi) = 0) :
    a = 0 :=
by
  let R := ULift.{u, 0} (ZMod n)
  let J := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
  let oneR : 𝒞 := weilCupPDModUnit S n
  
  have hInjR : Module.Injective R R := by
    apply Module.Baer.injective
    intro I g
    rcases eq_or_lt_of_le hn with rfl | hn2
    · refine ⟨0, fun x hx => ?_⟩
      apply ULift.ext
      exact Subsingleton.elim _ _
    · have : NeZero n := ⟨by omega⟩
      by_cases hI : ∀ x ∈ I, x = 0
      · refine ⟨0, fun x hx => ?_⟩
        have hx0 : (⟨x, hx⟩ : I) = 0 := Subtype.ext (hI x hx)
        rw [hx0, map_zero, LinearMap.zero_apply]
      · have hex_ne : ∃ x₀ ∈ I, x₀ ≠ 0 := by
          by_contra hc
          exact hI (fun x hx => by by_contra hne; exact hc ⟨x, hx, hne⟩)
        rcases hex_ne with ⟨x₀, hx₀I, hx₀_ne⟩
        have hex_pos : ∃ k : ℕ, 1 ≤ k ∧ k < n ∧ (ULift.up (k : ZMod n) : R) ∈ I := by
          refine ⟨x₀.down.val, ?_, x₀.down.val_lt, ?_⟩
          · have hne0 : x₀.down.val ≠ 0 := by
              intro h0
              apply hx₀_ne
              apply ULift.ext
              simpa [h0] using (ZMod.natCast_zmod_val x₀.down).symm
            omega
          · have heq : (ULift.up ((x₀.down.val : ℕ) : ZMod n) : R) = x₀ := by
              ext
              exact ZMod.natCast_zmod_val x₀.down
            rwa [heq]
        classical
        let g₀ : ℕ := Nat.find hex_pos
        have hg₀_ge1 : 1 ≤ g₀ := (Nat.find_spec hex_pos).1
        have hg₀_lt : g₀ < n := (Nat.find_spec hex_pos).2.1
        have hg₀_mem : (ULift.up (g₀ : ZMod n) : R) ∈ I := (Nat.find_spec hex_pos).2.2
        let r₀ : R := ULift.up (g₀ : ZMod n)
        have hdiv_mem : ∀ m : ℕ, (ULift.up (m : ZMod n) : R) ∈ I → g₀ ∣ m := by
          intro m hmI
          by_contra hndvd
          let rem := m % g₀
          let qm := m / g₀
          have hrem_pos : 1 ≤ rem := by
            have hne : rem ≠ 0 := fun h0 => hndvd (Nat.dvd_of_mod_eq_zero h0)
            omega
          have hrem_lt_g0 : rem < g₀ := Nat.mod_lt m (by omega)
          have hrem_lt_n : rem < n := lt_trans hrem_lt_g0 hg₀_lt
          have hrem_mem : (ULift.up (rem : ZMod n) : R) ∈ I := by
            have hmod : m = g₀ * qm + rem := (Nat.div_add_mod m g₀).symm
            have hrel : (ULift.up (rem : ZMod n) : R) =
                (ULift.up (m : ZMod n) : R) - (ULift.up (qm : ZMod n) : R) * r₀ := by
              apply ULift.ext
              change (rem : ZMod n) = (m : ZMod n) - (qm : ZMod n) * (g₀ : ZMod n)
              rw [hmod]
              push_cast
              ring
            rw [hrel]
            exact I.sub_mem hmI (I.smul_mem _ hg₀_mem)
          exact Nat.find_min hex_pos hrem_lt_g0 ⟨hrem_pos, hrem_lt_n, hrem_mem⟩
        have hg₀_dvd_n : g₀ ∣ n := by
          apply hdiv_mem n
          have hn0 : (ULift.up (n : ZMod n) : R) = 0 := by
            apply ULift.ext
            exact ZMod.natCast_self n
          rw [hn0]
          exact I.zero_mem
        let q₀ : ℕ := n / g₀
        have hq₀_pos : 0 < q₀ := Nat.div_pos (le_of_lt hg₀_lt) (by omega)
        have hqg : q₀ * g₀ = n := Nat.div_mul_cancel hg₀_dvd_n
        let y₀ : R := g ⟨r₀, hg₀_mem⟩
        let v : ℕ := y₀.down.val
        have hq₀_r₀ : (ULift.up (q₀ : ZMod n) : R) • (⟨r₀, hg₀_mem⟩ : I) = 0 := by
          ext
          change (q₀ : ZMod n) * (g₀ : ZMod n) = 0
          rw [← Nat.cast_mul, hqg, ZMod.natCast_self]
        have hq₀_y₀ : (q₀ : ZMod n) * y₀.down = 0 := by
          have h1 := congrArg ULift.down (g.map_smul (ULift.up (q₀ : ZMod n) : R) ⟨r₀, hg₀_mem⟩)
          rw [hq₀_r₀, map_zero] at h1
          exact h1.symm
        have hn_dvd_qv : n ∣ q₀ * v := by
          rw [← ZMod.natCast_eq_zero_iff]
          push_cast
          rw [ZMod.natCast_zmod_val]
          exact hq₀_y₀
        have hg₀_dvd_v : g₀ ∣ v := by
          rw [← hqg] at hn_dvd_qv
          exact (Nat.mul_dvd_mul_iff_left hq₀_pos).mp hn_dvd_qv
        let c₀ : ℕ := v / g₀
        have hgc : g₀ * c₀ = v := Nat.mul_div_cancel' hg₀_dvd_v
        refine ⟨LinearMap.mulRight R (ULift.up (c₀ : ZMod n)), fun x hx => ?_⟩
        have hg₀_dvd_x : g₀ ∣ x.down.val := by
          apply hdiv_mem x.down.val
          have heq : (ULift.up ((x.down.val : ℕ) : ZMod n) : R) = x := by
            ext
            exact ZMod.natCast_zmod_val x.down
          rwa [heq]
        let k := x.down.val / g₀
        have hgk : k * g₀ = x.down.val := by
          rw [mul_comm]
          exact Nat.mul_div_cancel' hg₀_dvd_x
        have hx_eq : (⟨x, hx⟩ : I) = (ULift.up (k : ZMod n) : R) • ⟨r₀, hg₀_mem⟩ := by
          ext
          change x.down = (k : ZMod n) * (g₀ : ZMod n)
          rw [← Nat.cast_mul, hgk, ZMod.natCast_zmod_val]
        rw [hx_eq, g.map_smul]
        apply ULift.ext
        change x.down * (c₀ : ZMod n) = (k : ZMod n) * y₀.down
        have hy₀_eq : y₀.down = (g₀ : ZMod n) * (c₀ : ZMod n) := by
          rw [← Nat.cast_mul, hgc]
          exact (ZMod.natCast_zmod_val y₀.down).symm
        have hx_down : x.down = (k : ZMod n) * (g₀ : ZMod n) := by
          rw [← Nat.cast_mul, hgk]
          exact (ZMod.natCast_zmod_val x.down).symm
        rw [hy₀_eq, hx_down, mul_assoc]
  have hModSep : ∀ (M : Type u) [AddCommGroup M] [Module R M] (m_el : M),
      m_el ≠ 0 → ∃ f : M →ₗ[R] R, f m_el ≠ 0 := by
    intro M _ _ m_el hm_el
    have hn2 : 2 ≤ n := by
      by_contra hlt
      have hn1 : n = 1 := by omega
      subst hn1
      apply hm_el
      have h10 : (1 : ULift.{u, 0} (ZMod 1)) = 0 := Subsingleton.elim _ _
      calc
        m_el = (1 : ULift.{u, 0} (ZMod 1)) • m_el := (one_smul _ m_el).symm
        _ = (0 : ULift.{u, 0} (ZMod 1)) • m_el := by rw [h10]
        _ = 0 := zero_smul _ m_el
    have : NeZero n := ⟨by omega⟩
    have hna : n • m_el = 0 := by
      have hnR : ((n : ℕ) : R) = 0 := by
        apply ULift.ext
        exact ZMod.natCast_self n
      rw [← Nat.cast_smul_eq_nsmul R n m_el, hnR, zero_smul]
    let m₀ : ℕ := addOrderOf m_el
    have hm₀_dvd : m₀ ∣ n := addOrderOf_dvd_of_nsmul_eq_zero hna
    have hm₀_gt1 : 1 < m₀ := by
      have hm₀_ne0 : m₀ ≠ 0 := by
        intro h0
        rw [h0, zero_dvd_iff] at hm₀_dvd
        omega
      have hm₀_ne1 : m₀ ≠ 1 := by
        intro h1
        have h1a : 1 • m_el = 0 := h1 ▸ addOrderOf_nsmul_eq_zero m_el
        rw [one_nsmul] at h1a
        exact hm_el h1a
      omega
    let d₁ : ℕ := n / m₀
    have hmd : m₀ * d₁ = n := Nat.mul_div_cancel' hm₀_dvd
    have hd₁_pos : 0 < d₁ := by
      apply Nat.pos_of_ne_zero
      intro h0
      rw [h0, mul_zero] at hmd
      omega
    have hd₁_lt : d₁ < n := by
      have h1 : 1 * d₁ < m₀ * d₁ := Nat.mul_lt_mul_of_pos_right hm₀_gt1 hd₁_pos
      omega
    have hd₁_ne_zero : (ULift.up (d₁ : ZMod n) : R) ≠ 0 := by
      intro h0
      have hz : (d₁ : ZMod n) = 0 := congrArg ULift.down h0
      have hdvd : n ∣ d₁ := (ZMod.natCast_eq_zero_iff d₁ n).mp hz
      have hle : n ≤ d₁ := Nat.le_of_dvd hd₁_pos hdvd
      omega
    let φ_a : R →ₗ[R] M := LinearMap.toSpanSingleton R M m_el
    let ψ_d : R →ₗ[R] R := LinearMap.mulRight R (ULift.up (d₁ : ZMod n))
    have hker : LinearMap.ker φ_a ≤ LinearMap.ker ψ_d := by
      intro r hr
      change ψ_d r = 0
      have hra : r • m_el = 0 := hr
      have hr_cast : ((r.down.val : ℕ) : R) = r := by
        apply ULift.ext
        exact ZMod.natCast_zmod_val r.down
      have hval_a : r.down.val • m_el = 0 := by
        rw [← Nat.cast_smul_eq_nsmul R r.down.val m_el, hr_cast, hra]
      obtain ⟨k, hk⟩ := addOrderOf_dvd_of_nsmul_eq_zero hval_a
      apply ULift.ext
      change r.down * (d₁ : ZMod n) = 0
      have hr_down : r.down = ((r.down.val : ℕ) : ZMod n) := (ZMod.natCast_zmod_val r.down).symm
      rw [hr_down, hk]
      have hmul : m₀ * k * d₁ = n * k := by
        calc
          m₀ * k * d₁ = (m₀ * d₁) * k := by ring
          _ = n * k := by rw [hmd]
      rw [← Nat.cast_mul, hmul, Nat.cast_mul, ZMod.natCast_self, zero_mul]
    let f_sub : LinearMap.range φ_a →ₗ[R] R :=
      ((LinearMap.ker φ_a).liftQ ψ_d hker).comp φ_a.quotKerEquivRange.symm.toLinearMap
    have : Module.Injective R R := hInjR
    obtain ⟨f, hf⟩ := Module.Injective.out (LinearMap.range φ_a).subtype
      (Submodule.subtype_injective _) f_sub
    refine ⟨f, ?_⟩
    have ha_mem : m_el ∈ LinearMap.range φ_a := ⟨1, one_smul R m_el⟩
    have hfa : f m_el = f_sub ⟨m_el, ha_mem⟩ := hf ⟨m_el, ha_mem⟩
    rw [hfa]
    have hf_sub_a : f_sub ⟨m_el, ha_mem⟩ = ULift.up (d₁ : ZMod n) := by
      have ha1 : (⟨m_el, ha_mem⟩ : LinearMap.range φ_a) = φ_a.rangeRestrict 1 := by
        ext
        exact (one_smul R m_el).symm
      rw [ha1]
      have hsymm : φ_a.quotKerEquivRange.symm (φ_a.rangeRestrict 1) =
          Submodule.Quotient.mk 1 := by
        apply φ_a.quotKerEquivRange.injective
        rw [LinearEquiv.apply_symm_apply]
        rfl
      change (LinearMap.ker φ_a).liftQ ψ_d hker
          (φ_a.quotKerEquivRange.symm (φ_a.rangeRestrict 1)) = ULift.up (d₁ : ZMod n)
      rw [hsymm, Submodule.liftQ_apply]
      change (1 : R) * ULift.up (d₁ : ZMod n) = ULift.up (d₁ : ZMod n)
      exact one_mul _
    rw [hf_sub_a]
    exact hd₁_ne_zero
  have hNsmulMod : ∀ {A : Type u} [AddCommGroup A],
      (∀ x : A, n • x = 0) → ∀ (u : ℕ) (x : A), (u % n) • x = u • x := by
    intro A _ hTors u x
    conv_rhs => rw [← Nat.div_add_mod u n]
    rw [add_nsmul, mul_nsmul, hTors x, nsmul_zero, zero_add]
  have hCog : ∀ (A : Type u) [AddCommGroup A],
      (∀ x : A, n • x = 0) →
      ∀ a_el : A, (∀ φ : A →+ ZMod n, φ a_el = 0) → a_el = 0 := by
    intro A _ hTors a_el hAll
    have : NeZero n := ⟨by omega⟩
    let instModA : Module R A :=
      { smul := fun r x => r.down.val • x
        one_smul := fun x => by
          change ((1 : ZMod n).val) • x = x
          have h1 : (1 : ZMod n).val = 1 % n := by
            rw [← Nat.cast_one]
            exact ZMod.val_natCast (n := n) 1
          rw [h1, hNsmulMod hTors 1 x, one_nsmul]
        mul_smul := fun r s x => by
          change (r.down * s.down).val • x = r.down.val • (s.down.val • x)
          rw [ZMod.val_mul, hNsmulMod hTors, mul_nsmul']
        smul_zero := fun _ => nsmul_zero _
        smul_add := fun _ x y => nsmul_add x y _
        add_smul := fun r s x => by
          change (r.down + s.down).val • x = r.down.val • x + s.down.val • x
          rw [ZMod.val_add, hNsmulMod hTors, add_nsmul]
        zero_smul := fun x => by
          change (0 : ZMod n).val • x = 0
          rw [ZMod.val_zero, zero_nsmul] }
    by_contra hne
    obtain ⟨f, hfa⟩ := @hModSep A _ instModA a_el hne
    let φ : A →+ ZMod n :=
      { toFun := fun x => (f x).down
        map_zero' := congrArg ULift.down f.map_zero
        map_add' := fun x y => congrArg ULift.down (f.map_add x y) }
    have h0 : (f a_el).down = 0 := hAll φ
    exact hfa (ULift.ext _ _ h0)
  have hTrCrit : ∀ (A : Type u) [AddCommGroup A],
      (∀ x : A, n • x = 0) →
      ∀ τ₀ : A →+ ZMod n,
        (∀ φ : A →+ ZMod n, ∃! c : ZMod n, ∀ x : A, φ x = c * τ₀ x) →
        Function.Bijective τ₀ := by
    intro A _ hTors τ₀ hCrit
    rcases eq_or_lt_of_le hn with rfl | hn2
    · have _ : Subsingleton A :=
        ⟨fun x y => by rw [← one_nsmul x, ← one_nsmul y, hTors x, hTors y]⟩
      exact ⟨fun x y _ => Subsingleton.elim x y, fun y => ⟨0, Subsingleton.elim _ _⟩⟩
    · have : NeZero n := ⟨by omega⟩
      have : Fact (1 < n) := ⟨hn2⟩
      have hOneMem : ∃ e₀ : A, τ₀ e₀ = 1 := by
        by_contra hNoOne
        by_cases hAllZero : ∀ x : A, τ₀ x = 0
        · obtain ⟨c, _, hUniq⟩ := hCrit 0
          have h10 : (1 : ZMod n) = 0 := by
            have hc1 : (1 : ZMod n) = c := hUniq 1 (fun x => by simp [hAllZero x])
            have hc0 : (0 : ZMod n) = c := hUniq 0 (fun x => by simp)
            exact hc1.trans hc0.symm
          exact one_ne_zero h10
        · have hex_x₀ : ∃ x₀ : A, τ₀ x₀ ≠ 0 := by
            by_contra hc
            exact hAllZero (fun x => by by_contra hx; exact hc ⟨x, hx⟩)
          rcases hex_x₀ with ⟨x₀, hx₀⟩
          let I : Submodule R R :=
            { carrier := { r : R | ∃ x : A, τ₀ x = r.down }
              add_mem' := by
                rintro r s ⟨x, hx⟩ ⟨y, hy⟩
                exact ⟨x + y, by rw [map_add, hx, hy]; rfl⟩
              zero_mem' := ⟨0, map_zero τ₀⟩
              smul_mem' := by
                rintro c r ⟨x, hx⟩
                refine ⟨c.down.val • x, ?_⟩
                rw [map_nsmul, hx, nsmul_eq_mul, ZMod.natCast_zmod_val]
                rfl }
          have hex_pos : ∃ k : ℕ, 1 ≤ k ∧ k < n ∧ (ULift.up (k : ZMod n) : R) ∈ I := by
            refine ⟨(τ₀ x₀).val, ?_, (τ₀ x₀).val_lt, ?_⟩
            · have hne0 : (τ₀ x₀).val ≠ 0 := by
                intro h0
                apply hx₀
                simpa [h0] using (ZMod.natCast_zmod_val (τ₀ x₀)).symm
              omega
            · exact ⟨x₀, (ZMod.natCast_zmod_val (τ₀ x₀)).symm⟩
          classical
          let g₀ : ℕ := Nat.find hex_pos
          have hg₀_ge1 : 1 ≤ g₀ := (Nat.find_spec hex_pos).1
          have hg₀_lt : g₀ < n := (Nat.find_spec hex_pos).2.1
          have hg₀_mem : (ULift.up (g₀ : ZMod n) : R) ∈ I := (Nat.find_spec hex_pos).2.2
          let r₀ : R := ULift.up (g₀ : ZMod n)
          have hdiv_mem : ∀ m : ℕ, (ULift.up (m : ZMod n) : R) ∈ I → g₀ ∣ m := by
            intro m hmI
            by_contra hndvd
            let rem := m % g₀
            let qm := m / g₀
            have hrem_pos : 1 ≤ rem := by
              have hne : rem ≠ 0 := fun h0 => hndvd (Nat.dvd_of_mod_eq_zero h0)
              omega
            have hrem_lt_g0 : rem < g₀ := Nat.mod_lt m (by omega)
            have hrem_lt_n : rem < n := lt_trans hrem_lt_g0 hg₀_lt
            have hrem_mem : (ULift.up (rem : ZMod n) : R) ∈ I := by
              have hmod : m = g₀ * qm + rem := (Nat.div_add_mod m g₀).symm
              have hrel : (ULift.up (rem : ZMod n) : R) =
                  (ULift.up (m : ZMod n) : R) - (ULift.up (qm : ZMod n) : R) * r₀ := by
                apply ULift.ext
                change (rem : ZMod n) = (m : ZMod n) - (qm : ZMod n) * (g₀ : ZMod n)
                rw [hmod]
                push_cast
                ring
              rw [hrel]
              exact I.sub_mem hmI (I.smul_mem _ hg₀_mem)
            exact Nat.find_min hex_pos hrem_lt_g0 ⟨hrem_pos, hrem_lt_n, hrem_mem⟩
          have hg₀_dvd_n : g₀ ∣ n := by
            apply hdiv_mem n
            refine ⟨0, ?_⟩
            change τ₀ 0 = (n : ZMod n)
            rw [map_zero, ZMod.natCast_self]
          have hg₀_ne1 : g₀ ≠ 1 := by
            intro h1
            rw [h1] at hg₀_mem
            rcases hg₀_mem with ⟨e₀, he₀⟩
            exact hNoOne ⟨e₀, by simpa using he₀⟩
          have hg₀_gt1 : 1 < g₀ := by omega
          let q₀ : ℕ := n / g₀
          have hqg : q₀ * g₀ = n := Nat.div_mul_cancel hg₀_dvd_n
          have hq₀_pos : 0 < q₀ := Nat.div_pos (le_of_lt hg₀_lt) (by omega)
          have hq₀_lt : q₀ < n := by
            have h1 : q₀ * 1 < q₀ * g₀ := Nat.mul_lt_mul_of_pos_left hg₀_gt1 hq₀_pos
            omega
