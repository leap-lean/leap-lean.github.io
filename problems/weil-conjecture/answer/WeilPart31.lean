        rw [hcomp_nsmul, hcomp_id₀, map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val]
      obtain ⟨f, hf, hf_uniq⟩ := hExf
      refine ⟨e0.symm f, ?_, ?_⟩
      · intro α
        have h1 := hf α
        rw [← e0.apply_symm_apply f, htau_e0] at h1
        exact h1.symm
      · intro c hc
        apply e0.injective
        rw [e0.apply_symm_apply]
        apply hf_uniq
        intro α
        rw [htau_e0, hc α]
    let Φ : ∀ (G : 𝒞₀) (p q : ℕ) (_ : p + q = 2 * d),
        CategoryTheory.Abelian.Ext.{u} G one₀ q →+
          (CategoryTheory.Abelian.Ext.{u} one₀ G p →+ ZMod n) :=
      fun G p q hpq =>
        AddMonoidHom.mk'
          (fun β =>
            AddMonoidHom.mk'
              (fun α => τ₀ (α.comp β hpq))
              (fun α₁ α₂ => by rw [CategoryTheory.Abelian.Ext.add_comp, map_add]))
          (fun β₁ β₂ => by
            ext α
            change τ₀ (α.comp (β₁ + β₂) hpq) = τ₀ (α.comp β₁ hpq) + τ₀ (α.comp β₂ hpq)
            rw [CategoryTheory.Abelian.Ext.comp_add, map_add])
    let ψ₁ : CategoryTheory.Abelian.Ext.{u} one₀ one₀ 0 →+ ZMod n := e0.symm.toAddMonoidHom
    let u₀ : ZMod n := τ₀ (E_top₀ one₀ ψ₁)
    have hΦ_Etop : ∀ (G : 𝒞₀) (φ : CategoryTheory.Abelian.Ext.{u} one₀ G 0 →+ ZMod n)
        (α : CategoryTheory.Abelian.Ext.{u} one₀ G 0),
        Φ G 0 (2 * d) (Nat.zero_add (2 * d)) (E_top₀ G φ) α = φ α * u₀ := by
      intro G φ α
      have hfunc_eq : φ.comp (α.postcomp one₀ (Nat.add_zero 0)) = (φ α).val • ψ₁ := by
        apply AddMonoidHom.ext
        intro x
        have hx : e0 (ψ₁ x) = x := e0.apply_symm_apply x
        rw [← hx]
        set c := ψ₁ x
        change φ (((e0 c).comp α (Nat.add_zero 0))) = (φ α).val • (ψ₁ (e0 c))
        have hψc : ψ₁ (e0 c) = c := e0.symm_apply_apply c
        rw [hψc]
        change φ ((c.val • id₀).comp α (Nat.add_zero 0)) = (φ α).val • c
        rw [hnsmul_comp, CategoryTheory.Abelian.Ext.mk₀_id_comp, map_nsmul,
          nsmul_eq_mul, nsmul_eq_mul, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val, mul_comm]
      change τ₀ (α.comp (E_top₀ G φ) (Nat.zero_add (2 * d))) = φ α * u₀
      rw [hE_nat₀ G φ α, hfunc_eq, map_nsmul, map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val]
    obtain ⟨z₁, hz₁⟩ := hτ_bij.2 1
    let φ₁ := (E_top₀ one₀).symm z₁
    have hv₀_u₀ : φ₁ id₀ * u₀ = 1 := by
      have h1 := hΦ_Etop one₀ φ₁ id₀
      change τ₀ (id₀.comp (E_top₀ one₀ φ₁) (Nat.zero_add (2 * d))) = φ₁ id₀ * u₀ at h1
      rw [CategoryTheory.Abelian.Ext.mk₀_id_comp, (E_top₀ one₀).apply_symm_apply, hz₁] at h1
      exact h1.symm
    let v₀ : ZMod n := φ₁ id₀
    have hu₀_v₀ : u₀ * v₀ = 1 := by rw [mul_comm]; exact hv₀_u₀
    have hΦ_base : ∀ G : 𝒞₀, Function.Bijective (Φ G 0 (2 * d) (Nat.zero_add (2 * d))) := by
      intro G
      let mulU : (CategoryTheory.Abelian.Ext.{u} one₀ G 0 →+ ZMod n) →
          (CategoryTheory.Abelian.Ext.{u} one₀ G 0 →+ ZMod n) :=
        fun φ => AddMonoidHom.mk' (fun α => φ α * u₀) (fun α₁ α₂ => by rw [map_add, add_mul])
      let mulV : (CategoryTheory.Abelian.Ext.{u} one₀ G 0 →+ ZMod n) →
          (CategoryTheory.Abelian.Ext.{u} one₀ G 0 →+ ZMod n) :=
        fun ψ => AddMonoidHom.mk' (fun α => ψ α * v₀) (fun α₁ α₂ => by rw [map_add, add_mul])
      have hmulU_bij : Function.Bijective mulU := by
        refine Function.bijective_iff_has_inverse.mpr ⟨mulV, ?_, ?_⟩
        · intro φ; ext α; change (φ α * u₀) * v₀ = φ α; rw [mul_assoc, hu₀_v₀, mul_one]
        · intro ψ; ext α; change (ψ α * v₀) * u₀ = ψ α; rw [mul_assoc, hv₀_u₀, mul_one]
      have hcomp_eq : (Φ G 0 (2 * d) (Nat.zero_add (2 * d)) : _ → _) ∘ (E_top₀ G) = mulU := by
        ext φ α
        exact hΦ_Etop G φ α
      exact (Function.Bijective.of_comp_iff _ (E_top₀ G).bijective).mp (hcomp_eq.symm ▸ hmulU_bij)
    have hΦ_all : ∀ (p q : ℕ) (hpq : p + q = 2 * d) (G : 𝒞₀),
        Function.Bijective (Φ G p q hpq) := by
      intro p
      induction p with
      | zero =>
        intro q hpq G
        have hq : q = 2 * d := by omega
        subst hq
        exact hΦ_base G
      | succ p ih =>
        intro q hpq G
        have hpq_succ : p + (q + 1) = 2 * d := by omega
        have hq_lt : q < 2 * d := by omega
        let M : 𝒞₀ := T₀ G
        let f : Quiver.Hom G M := η₀ G
        have hf_mono : CategoryTheory.Mono f := hMono₀ G
        let Q : 𝒞₀ := CategoryTheory.Limits.cokernel f
        let g : Quiver.Hom M Q := CategoryTheory.Limits.cokernel.π f
        let SC : CategoryTheory.ShortComplex 𝒞₀ :=
          CategoryTheory.ShortComplex.mk f g (CategoryTheory.Limits.cokernel.condition f)
        have hSC_exact : SC.Exact := CategoryTheory.ShortComplex.exact_cokernel f
        have hSC : SC.ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk' hSC_exact hf_mono inferInstance
        let δ : CategoryTheory.Abelian.Ext.{u} Q G 1 := hSC.extClass
        have h1q : 1 + q = q + 1 := Nat.add_comm 1 q
        have _ : Subsingleton (CategoryTheory.Abelian.Ext.{u} M one₀ q) :=
          hVan₀ M (fun k hk => hAcyc₀ k hk G) q hq_lt
        have _ : Subsingleton (CategoryTheory.Abelian.Ext.{u} one₀ M (p + 1)) :=
          hAcyc₀ (p + 1) (by omega) G
        have hδ_inj : ∀ β : CategoryTheory.Abelian.Ext.{u} G one₀ q,
            δ.comp β h1q = 0 → β = 0 := by
          intro β hβ
          obtain ⟨x₂, hx₂⟩ :=
            CategoryTheory.Abelian.Ext.contravariant_sequence_exact₁ hSC one₀ β h1q hβ
          rw [← hx₂, Subsingleton.elim x₂ 0, CategoryTheory.Abelian.Ext.comp_zero]
        have hδ_surj : ∀ ξ : CategoryTheory.Abelian.Ext.{u} one₀ G (p + 1),
            ∃ α : CategoryTheory.Abelian.Ext.{u} one₀ Q p, α.comp δ rfl = ξ := by
          intro ξ
          have hξ0 : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero (p + 1)) = 0 :=
            Subsingleton.elim _ _
          exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ one₀ hSC ξ hξ0 rfl
        refine ⟨?_, ?_⟩
        · rw [injective_iff_map_eq_zero]
          intro β hβ0
          apply hδ_inj β
          apply (ih (q + 1) hpq_succ Q).1
          rw [map_zero]
          ext α
          change τ₀ (α.comp (δ.comp β h1q) hpq_succ) = 0
          have hassoc := (CategoryTheory.Abelian.Ext.comp_assoc α δ β rfl h1q (by omega)).symm
          rw [hassoc]
          change Φ G (p + 1) q hpq β (α.comp δ rfl) = 0
          rw [hβ0]
          rfl
        · intro ψ
          let post_δ : CategoryTheory.Abelian.Ext.{u} one₀ Q p →+
              CategoryTheory.Abelian.Ext.{u} one₀ G (p + 1) :=
            δ.postcomp one₀ rfl
          obtain ⟨γ, hγ⟩ := (ih (q + 1) hpq_succ Q).2 (ψ.comp post_δ)
          have hg_γ_zero :
              (CategoryTheory.Abelian.Ext.mk₀ SC.g).comp γ (Nat.zero_add (q + 1)) = 0 := by
            apply (ih (q + 1) hpq_succ M).1
            rw [map_zero]
            ext μ
            change τ₀ (μ.comp ((CategoryTheory.Abelian.Ext.mk₀ SC.g).comp γ (Nat.zero_add (q + 1)))
              hpq_succ) = 0
            have hassoc := (CategoryTheory.Abelian.Ext.comp_assoc
              μ (CategoryTheory.Abelian.Ext.mk₀ SC.g) γ
              (Nat.add_zero p) (Nat.zero_add (q + 1)) (by omega)).symm
            rw [hassoc]
            change (Φ Q p (q + 1) hpq_succ γ)
              (μ.comp (CategoryTheory.Abelian.Ext.mk₀ SC.g) (Nat.add_zero p)) = 0
            rw [hγ]
            change ψ (((μ.comp (CategoryTheory.Abelian.Ext.mk₀ SC.g)
              (Nat.add_zero p))).comp δ rfl) = 0
            have hassoc2 := CategoryTheory.Abelian.Ext.comp_assoc
              μ (CategoryTheory.Abelian.Ext.mk₀ SC.g) δ
              (Nat.add_zero p) (Nat.zero_add 1) rfl
            rw [hassoc2, hSC.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero, map_zero]
          obtain ⟨β, hβ⟩ :=
            CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hSC one₀ γ hg_γ_zero h1q
          refine ⟨β, ?_⟩
          ext ξ
          obtain ⟨α, rfl⟩ := hδ_surj ξ
          change τ₀ ((α.comp δ rfl).comp β hpq) = ψ (α.comp δ rfl)
          have hassoc := CategoryTheory.Abelian.Ext.comp_assoc α δ β rfl h1q (by omega)
          rw [hassoc, hβ]
          change (Φ Q p (q + 1) hpq_succ γ) α = ψ (α.comp δ rfl)
          rw [hγ]
          rfl
    apply hCog (CategoryTheory.Abelian.Ext.{u} one₀ one₀ i) (hExtTors one₀ i) a₀
    intro φ
    obtain ⟨b₀, hb₀⟩ := (hΦ_all i (2 * d - i) (Nat.add_sub_of_le hi) one₀).2 φ
    rw [← hb₀]
    change τ₀ (CategoryTheory.Abelian.Ext.comp a₀ b₀ (Nat.add_sub_of_le hi)) = 0
    rw [ha₀ b₀, map_zero]
  exact hAbs oneR hn_id_oneR hEnd τ hDeg0 hVan E_top hE_nat
    (fun G => (𝒯 0).obj G) (fun G => η.app G) hMonoη (hAcyc 0) a ha

theorem weil_etale_cup_product_poincare_nondegenerate (d i n : ℕ) (hi : i ≤ 2 * d) :
    ∃ (cup : ∀ (S : AlgebraicGeometry.Scheme.{u}),
        weilEtaleTorsionH S n i →+
          weilEtaleTorsionH S n (2 * d - i) →+
            weilEtaleTorsionH S n (2 * d)),
      (∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂)
        (p_i : weilEtaleTorsionH S₂ n i →+ weilEtaleTorsionH S₁ n i)
        (p_compl : weilEtaleTorsionH S₂ n (2 * d - i) →+ weilEtaleTorsionH S₁ n (2 * d - i))
        (p_top : weilEtaleTorsionH S₂ n (2 * d) →+ weilEtaleTorsionH S₁ n (2 * d)),
        WeilIsTorsionEtalePullback h n i p_i →
        WeilIsTorsionEtalePullback h n (2 * d - i) p_compl →
        WeilIsTorsionEtalePullback h n (2 * d) p_top →
        ∀ (u : weilEtaleTorsionH S₂ n i) (z : weilEtaleTorsionH S₂ n (2 * d - i)),
          p_top (cup S₂ u z) = cup S₁ (p_i u) (p_compl z)) ∧
      (∀ (k : Type u) [Field k] [IsAlgClosed k],
        1 ≤ n → IsUnit (n : k) →
        ∀ (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          [IrreducibleSpace X.left]
          [AlgebraicGeometry.IsProper X.hom]
          [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
          (v : weilEtaleTorsionH X.left n i),
          (∀ z : weilEtaleTorsionH X.left n (2 * d - i), cup X.left v z = 0) →
          v = 0) :=
by
  have hc : i + (2 * d - i) = 2 * d := Nat.add_sub_of_le hi
  let θ : ∀ (S : AlgebraicGeometry.Scheme.{u}) (j : ℕ),
      weilCupPDModH S n j →+ weilEtaleTorsionH S n j :=
    fun S j => Classical.choose (weil_cupPD_mod_comparison_bijective_unique S n j).1
  have hθ : ∀ (S : AlgebraicGeometry.Scheme.{u}) (j : ℕ),
      WeilCupPDIsModComparison S n j (θ S j) :=
    fun S j => (Classical.choose_spec (weil_cupPD_mod_comparison_bijective_unique S n j).1).1
  have hθ_bij : ∀ (S : AlgebraicGeometry.Scheme.{u}) (j : ℕ),
      Function.Bijective (θ S j) :=
    fun S j => (Classical.choose_spec (weil_cupPD_mod_comparison_bijective_unique S n j).1).2
  let eθ : ∀ (S : AlgebraicGeometry.Scheme.{u}) (j : ℕ),
      weilCupPDModH S n j ≃+ weilEtaleTorsionH S n j :=
    fun S j => AddEquiv.ofBijective (θ S j) (hθ_bij S j)
  have hθ_symm : ∀ (S : AlgebraicGeometry.Scheme.{u}) (j : ℕ) (w : weilEtaleTorsionH S n j),
      θ S j ((eθ S j).symm w) = w :=
    fun S j w => (eθ S j).apply_symm_apply w
  have hsymm_θ : ∀ (S : AlgebraicGeometry.Scheme.{u}) (j : ℕ) (a : weilCupPDModH S n j),
      (eθ S j).symm (θ S j a) = a :=
    fun S j a => (eθ S j).symm_apply_apply a
  let cup : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      weilEtaleTorsionH S n i →+
        weilEtaleTorsionH S n (2 * d - i) →+
          weilEtaleTorsionH S n (2 * d) :=
    fun S =>
      AddMonoidHom.mk'
        (fun u =>
          AddMonoidHom.mk'
            (fun z =>
              θ S (2 * d)
                (CategoryTheory.Abelian.Ext.comp
                  ((eθ S i).symm u) ((eθ S (2 * d - i)).symm z) hc))
            (fun z₁ z₂ => by
              rw [map_add, CategoryTheory.Abelian.Ext.comp_add, map_add]))
        (fun u₁ u₂ => by
          ext z
          change θ S (2 * d)
              (CategoryTheory.Abelian.Ext.comp
                ((eθ S i).symm (u₁ + u₂)) ((eθ S (2 * d - i)).symm z) hc) =
            θ S (2 * d)
              (CategoryTheory.Abelian.Ext.comp
                ((eθ S i).symm u₁) ((eθ S (2 * d - i)).symm z) hc) +
            θ S (2 * d)
              (CategoryTheory.Abelian.Ext.comp
                ((eθ S i).symm u₂) ((eθ S (2 * d - i)).symm z) hc)
          rw [map_add, CategoryTheory.Abelian.Ext.add_comp, map_add])
  refine ⟨cup, ?_, ?_⟩
  · intro S₁ S₂ h p_i p_compl p_top hp_i hp_compl hp_top u z
    have hModInj : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m j : ℕ)
        (θ' : weilCupPDModH S m j →+ weilEtaleTorsionH S m j),
        WeilCupPDIsModComparison S m j θ' → Function.Injective θ' := by
      intro S m j θ' hθ'
      obtain ⟨⟨θ₀, hθ₀, hbij₀⟩, hUniq⟩ := weil_cupPD_mod_comparison_bijective_unique S m j
      rw [hUniq θ' θ₀ hθ' hθ₀]
      exact hbij₀.1
    have hModUniq : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m j : ℕ)
        (θ₁ θ₂ : weilCupPDModH S m j →+ weilEtaleTorsionH S m j),
        WeilCupPDIsModComparison S m j θ₁ →
        WeilCupPDIsModComparison S m j θ₂ →
        θ₁ = θ₂ :=
      fun S m j => (weil_cupPD_mod_comparison_bijective_unique S m j).2
    exact weil_cupPD_pullback_ext_comp_compat hModInj hModUniq h
      n i (2 * d - i) (2 * d) hc
      p_i p_compl p_top
      (θ S₂ i) (θ S₁ i)
      (θ S₂ (2 * d - i)) (θ S₁ (2 * d - i))
      (θ S₂ (2 * d)) (θ S₁ (2 * d))
      hp_i hp_compl hp_top
      (hθ S₂ i) (hθ S₁ i)
      (hθ S₂ (2 * d - i)) (hθ S₁ (2 * d - i))
      (hθ S₂ (2 * d)) (hθ S₁ (2 * d))
      ((eθ S₂ i).symm u) ((eθ S₂ (2 * d - i)).symm z)
      ((eθ S₁ i).symm (p_i u)) ((eθ S₁ (2 * d - i)).symm (p_compl z))
      (by rw [hθ_symm, hθ_symm])
      (by rw [hθ_symm, hθ_symm])
  · intro k _ _ hn hUnit X _ _ _ v hv
    have : IsSepClosed k := IsSepClosed.of_isAlgClosed k
    have : NeZero (n : k) := ⟨hUnit.ne_zero⟩
    have : HasEnoughRootsOfUnity k n := IsSepClosed.hasEnoughRootsOfUnity k n
    obtain ⟨ζ₀, hζ₀⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot k n
    let ζ : kˣ := Units.mk0 ζ₀ (hζ₀.ne_zero (by omega))
    have hPrim : IsPrimitiveRoot ((ζ : kˣ) : k) n := by simpa [ζ] using hζ₀
    have hRed : AlgebraicGeometry.IsReduced X.left := by
      refine @AlgebraicGeometry.isReduced_of_isReduced_stalk X.left (fun x => ?_)
      obtain ⟨U, _, V, hV, hx, e, hStd⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff d X.hom).mp inferInstance x
      have : Nonempty U := ⟨⟨X.hom.base x, e hx⟩⟩
      obtain ⟨g_et, _, hg_et⟩ := hStd.exists_etale_mvPolynomial
      let _ : Algebra (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U)))
          ↑(X.left.presheaf.obj (Opposite.op V)) := g_et.toAlgebra
      have : Algebra.Etale
          (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U)))
          ↑(X.left.presheaf.obj (Opposite.op V)) := hg_et.toAlgebra
      have hinj_base : Function.Injective
          (Algebra.ofId
            (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U)))
            (FractionRing (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U))))).toLinearMap :=
        IsFractionRing.injective _ _
      have hinj_tensor := Module.Flat.rTensor_preserves_injective_linearMap
        (M := ↑(X.left.presheaf.obj (Opposite.op V))) _ hinj_base
      have hinj_inc : Function.Injective
          (Algebra.TensorProduct.includeRight :
            ↑(X.left.presheaf.obj (Opposite.op V)) →ₐ[MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U))]
              TensorProduct
                (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U)))
                (FractionRing (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U))))
                ↑(X.left.presheaf.obj (Opposite.op V))) := by
        intro a b hab
        have ha : LinearMap.rTensor ↑(X.left.presheaf.obj (Opposite.op V))
            (Algebra.ofId
              (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U)))
              (FractionRing (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U))))).toLinearMap
            ((TensorProduct.lid
              (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U)))
              ↑(X.left.presheaf.obj (Opposite.op V))).symm a) =
            Algebra.TensorProduct.includeRight a := by
          simp [TensorProduct.lid_symm_apply]
        have hb : LinearMap.rTensor ↑(X.left.presheaf.obj (Opposite.op V))
            (Algebra.ofId
              (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U)))
              (FractionRing (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U))))).toLinearMap
            ((TensorProduct.lid
              (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U)))
              ↑(X.left.presheaf.obj (Opposite.op V))).symm b) =
            Algebra.TensorProduct.includeRight b := by
          simp [TensorProduct.lid_symm_apply]
        have h1 : (TensorProduct.lid
              (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U)))
              ↑(X.left.presheaf.obj (Opposite.op V))).symm a =
            (TensorProduct.lid
              (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U)))
              ↑(X.left.presheaf.obj (Opposite.op V))).symm b := by
          apply hinj_tensor
          rw [ha, hb, hab]
        exact (TensorProduct.lid
          (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U)))
          ↑(X.left.presheaf.obj (Opposite.op V))).symm.injective h1
      have : _root_.IsReduced
          (TensorProduct
            (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U)))
            (FractionRing (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U))))
            ↑(X.left.presheaf.obj (Opposite.op V))) :=
        Algebra.FormallyUnramified.isReduced_of_field
          (FractionRing (MvPolynomial (Fin d) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U)))) _
      have hRedV : _root_.IsReduced ↑(X.left.presheaf.obj (Opposite.op V)) :=
        isReduced_of_injective Algebra.TensorProduct.includeRight hinj_inc
      let _ : Algebra ↑(X.left.presheaf.obj (Opposite.op V)) ↑(X.left.presheaf.stalk x) :=
        TopCat.Presheaf.algebra_section_stalk X.left.presheaf ⟨x, hx⟩
      have := hV.isLocalization_stalk ⟨x, hx⟩
      exact @isReduced_localizationPreserves
        ↑(X.left.presheaf.obj (Opposite.op V)) _
        (hV.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl
        ↑(X.left.presheaf.stalk x) _ _ _ hRedV
    have hInt : AlgebraicGeometry.IsIntegral X.left :=
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced X.left
    have : ConnectedSpace ↥X.left := IrreducibleSpace.connectedSpace ↥X.left
    have hDim : topologicalKrullDim X.left ≤ (d : WithBot ℕ∞) :=
      le_of_eq (weil_smooth_integral_krullDim_over_field k d X hInt)
    have hGod : WeilCupPDHasTruncatedGodement X.left d n :=
      weil_cupPD_truncated_godement_complex k X d n hn hUnit hDim
    obtain ⟨τ, hEff⟩ :=
      weil_cupPD_smooth_proper_trace_and_local_effacement k X hInt d n hn hUnit ζ hPrim
    have ha_zero : ∀ b : weilCupPDModH X.left n (2 * d - i),
        CategoryTheory.Abelian.Ext.comp ((eθ X.left i).symm v) b hc = 0 := by
      intro b
      apply (hθ_bij X.left (2 * d)).1
      rw [map_zero]
      have hvb := hv (θ X.left (2 * d - i) b)
      change θ X.left (2 * d)
          (CategoryTheory.Abelian.Ext.comp
            ((eθ X.left i).symm v)
            ((eθ X.left (2 * d - i)).symm (θ X.left (2 * d - i) b)) hc) = 0 at hvb
      rwa [hsymm_θ] at hvb
    have hsymm_v : (eθ X.left i).symm v = 0 :=
      weil_cupPD_verdier_left_nondegenerate_of_effacement X.left d i n hi hn τ hGod hEff
        ((eθ X.left i).symm v) ha_zero
    calc
      v = θ X.left i ((eθ X.left i).symm v) := (hθ_symm X.left i v).symm
      _ = θ X.left i 0 := by rw [hsymm_v]
      _ = 0 := map_zero _

theorem weil_ell_adic_model_linear_map_of_torsion_pullback (F : Type u) [Finite F] [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (F₁ : Type u) [Finite F₁] [Field F₁]
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F₁)))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (m i δ : ℕ) (hδ : 1 ≤ δ)
    (M_X : WeilEllAdicCohomologyModel F X ℓ i)
    (M_Y : WeilEllAdicCohomologyModel F₁ Y ℓ i)
    (p : ∀ r : ℕ,
      weilEtaleTorsionH (weilGeomScheme F X) (ℓ ^ r) i →+
        weilEtaleTorsionH (weilGeomScheme F₁ Y) (ℓ ^ r) i)
    (hp_trans : ∀ r : ℕ,
      (weilEtaleTorsionTransition (weilGeomScheme F₁ Y) ℓ r i).comp (p (r + 1)) =
        (p r).comp (weilEtaleTorsionTransition (weilGeomScheme F X) ℓ r i))
    (hX_frob_trans : ∀ r : ℕ,
      (weilEtaleTorsionTransition (weilGeomScheme F X) ℓ r i).comp (M_X.frobTorsion (r + 1)) =
        (M_X.frobTorsion r).comp (weilEtaleTorsionTransition (weilGeomScheme F X) ℓ r i))
    (hp_frob : ∀ (r : ℕ) (u : weilEtaleTorsionH (weilGeomScheme F X) (ℓ ^ r) i),
      p r ((⇑(M_X.frobTorsion r))^[m] u) = M_Y.frobTorsion r (p r u))
    (hp_ker : ∀ (r : ℕ) (u : weilEtaleTorsionH (weilGeomScheme F X) (ℓ ^ r) i),
      p r u = 0 → δ • u = 0) :
    ∃ f : M_X.V →ₗ[Padic ℓ] M_Y.V,
      Function.Injective f ∧
      ∀ v : M_X.V, f ((M_X.frob ^ m) v) = M_Y.frob (f v) :=
by
  
  have hTorsionAnn : ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (n i₀ : ℕ)
      (w : weilEtaleTorsionH S₀ n i₀), n • w = 0 := by
    clear * -
    intro S₀ n i₀ w
    let J := S₀.smallEtaleTopology
    let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    have : C.Additive := by
      dsimp [C]
      unfold CategoryTheory.constantSheaf
      infer_instance
    let U := AddCommGrpCat.uliftFunctor.{u, 0}
    let A_n := AddCommGrpCat.of (ZMod n)
    let FM := C.obj (U.obj A_n)
    let Fℤ := C.obj (AddCommGrpCat.of (ULift.{u} ℤ))
    have hAn : n • (𝟙 A_n) = 0 := by
      ext a
      change n • a = 0
      rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
    have hUn : n • (𝟙 (U.obj A_n)) = 0 := by
      rw [← U.map_id, ← Functor.map_nsmul, hAn, U.map_zero]
    have hFM : n • (𝟙 FM) = 0 := by
      dsimp [FM]
      rw [← C.map_id, ← Functor.map_nsmul, hUn, C.map_zero]
    let w' : CategoryTheory.Abelian.Ext Fℤ FM i₀ := w
    change n • w' = 0
    have hExtComp : ∀ k : ℕ,
        w'.comp (CategoryTheory.Abelian.Ext.mk₀ (k • 𝟙 FM)) (Nat.add_zero i₀) =
          k • (w'.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 FM)) (Nat.add_zero i₀)) := by
      intro k
      induction k with
      | zero =>
        rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero]
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
          CategoryTheory.Abelian.Ext.comp_add, ih]
    have hn := hExtComp n
    rw [hFM, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero,
      CategoryTheory.Abelian.Ext.comp_mk₀_id] at hn
    exact hn.symm
  have hmem_gen : ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (ℓ₀ i₀ : ℕ)
      (y : ∀ r : ℕ, weilEtaleTorsionH S₀ (ℓ₀ ^ r) i₀),
      y ∈ weilEtaleIntegralSystem S₀ ℓ₀ i₀ ↔
        ∀ r : ℕ, weilEtaleTorsionTransition S₀ ℓ₀ r i₀ (y (r + 1)) = y r := by
    clear * -
    intro S₀ ℓ₀ i₀ y
    change (AddMonoidHom.pi fun r =>
        (weilEtaleTorsionTransition S₀ ℓ₀ r i₀).comp
          (Pi.evalAddMonoidHom (fun k => weilEtaleTorsionH S₀ (ℓ₀ ^ k) i₀) (r + 1)) -
        Pi.evalAddMonoidHom (fun k => weilEtaleTorsionH S₀ (ℓ₀ ^ k) i₀) r) y = 0 ↔ _
    refine ⟨fun h r => sub_eq_zero.mp (congrFun h r),
      fun h => funext fun r => sub_eq_zero.mpr (h r)⟩
  
  have hAbstract : ∀ (ℓ₀ : ℕ) [Fact (Nat.Prime ℓ₀)] (m₀ δ₀ : ℕ) (_ : 1 ≤ δ₀)
      (H_X H_Y : ℕ → Type u) [∀ r, AddCommGroup (H_X r)] [∀ r, AddCommGroup (H_Y r)]
      (tr_X : ∀ r : ℕ, H_X (r + 1) →+ H_X r)
      (tr_Y : ∀ r : ℕ, H_Y (r + 1) →+ H_Y r)
      (L_X : AddSubgroup (∀ r : ℕ, H_X r))
      (L_Y : AddSubgroup (∀ r : ℕ, H_Y r))
      (hLX_mem : ∀ y : ∀ r : ℕ, H_X r, y ∈ L_X ↔ ∀ r : ℕ, tr_X r (y (r + 1)) = y r)
      (hLY_mem : ∀ y : ∀ r : ℕ, H_Y r, y ∈ L_Y ↔ ∀ r : ℕ, tr_Y r (y (r + 1)) = y r)
      (hTors_X : ∀ (r : ℕ) (u : H_X r), (ℓ₀ ^ r) • u = 0)
      (V_X V_Y : Type u)
      [AddCommGroup V_X] [Module (Padic ℓ₀) V_X]
      [AddCommGroup V_Y] [Module (Padic ℓ₀) V_Y]
      (frob_X : V_X →ₗ[Padic ℓ₀] V_X) (frob_Y : V_Y →ₗ[Padic ℓ₀] V_Y)
      (frobTors_X : ∀ r : ℕ, H_X r →+ H_X r)
      (frobTors_Y : ∀ r : ℕ, H_Y r →+ H_Y r)
      (equiv_X : TensorProduct ℤ ℚ ↥L_X ≃+ V_X)
      (equiv_Y : TensorProduct ℤ ℚ ↥L_Y ≃+ V_Y)
      (hsmul_X : ∀ (z : PadicInt ℓ₀) (x y : ↥L_X),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
          equiv_X (TensorProduct.tmul ℤ (1 : ℚ) y) =
            (z : Padic ℓ₀) • equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x))
      (hsmul_Y : ∀ (z : PadicInt ℓ₀) (x y : ↥L_Y),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
          equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) y) =
            (z : Padic ℓ₀) • equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) x))
      (hfrob_X : ∀ (x y : ↥L_X),
        (∀ r : ℕ, y.1 r = frobTors_X r (x.1 r)) →
          frob_X (equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x)) =
            equiv_X (TensorProduct.tmul ℤ (1 : ℚ) y))
      (hfrob_Y : ∀ (x y : ↥L_Y),
        (∀ r : ℕ, y.1 r = frobTors_Y r (x.1 r)) →
          frob_Y (equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) x)) =
            equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) y))
      (p₀ : ∀ r : ℕ, H_X r →+ H_Y r)
      (hp₀_trans : ∀ r : ℕ, (tr_Y r).comp (p₀ (r + 1)) = (p₀ r).comp (tr_X r))
      (hX₀_frob_trans : ∀ r : ℕ,
        (tr_X r).comp (frobTors_X (r + 1)) = (frobTors_X r).comp (tr_X r))
      (hp₀_frob : ∀ (r : ℕ) (u : H_X r),
        p₀ r ((⇑(frobTors_X r))^[m₀] u) = frobTors_Y r (p₀ r u))
      (hp₀_ker : ∀ (r : ℕ) (u : H_X r), p₀ r u = 0 → δ₀ • u = 0),
      ∃ f : V_X →ₗ[Padic ℓ₀] V_Y,
        Function.Injective f ∧ ∀ v : V_X, f ((frob_X ^ m₀) v) = frob_Y (f v) := by
    clear * -
    intro ℓ₀ _ m₀ δ₀ hδ₀ H_X H_Y _ _ tr_X tr_Y L_X L_Y hLX_mem hLY_mem hTors_X
      V_X V_Y _ _ _ _ frob_X frob_Y frobTors_X frobTors_Y equiv_X equiv_Y
      hsmul_X hsmul_Y hfrob_X hfrob_Y p₀ hp₀_trans hX₀_frob_trans hp₀_frob hp₀_ker
    have hPrime : Nat.Prime ℓ₀ := Fact.out
    have hZModSmul : ∀ (z : PadicInt ℓ₀) (x : ↥L_X),
        (fun r : ℕ => (PadicInt.toZModPow r z).val • x.1 r) ∈ L_X := by
      intro z x
      rw [hLX_mem]
      intro r
      rw [map_nsmul, (hLX_mem x.1).mp x.2 r]
      have : NeZero (ℓ₀ ^ r) := ⟨pow_ne_zero r hPrime.ne_zero⟩
      have : NeZero (ℓ₀ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hPrime.ne_zero⟩
      set a := PadicInt.toZModPow (r + 1) z
      set b := PadicInt.toZModPow r z
      have hcast : ZMod.castHom (pow_dvd_pow ℓ₀ (Nat.le_succ r)) (ZMod (ℓ₀ ^ r)) a = b :=
        RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow (p := ℓ₀) r (r + 1) (Nat.le_succ r)) z
      have hb_eq : (a.val : ZMod (ℓ₀ ^ r)) = b := by
        have ha : (a.val : ZMod (ℓ₀ ^ (r + 1))) = a := ZMod.natCast_zmod_val a
        calc
          (a.val : ZMod (ℓ₀ ^ r)) =
              ZMod.castHom (pow_dvd_pow ℓ₀ (Nat.le_succ r)) (ZMod (ℓ₀ ^ r))
                (a.val : ZMod (ℓ₀ ^ (r + 1))) := (map_natCast _ a.val).symm
          _ = ZMod.castHom (pow_dvd_pow ℓ₀ (Nat.le_succ r)) (ZMod (ℓ₀ ^ r)) a := by rw [ha]
          _ = b := hcast
      have hb_val : b.val = a.val % (ℓ₀ ^ r) := by
        rw [← hb_eq, ZMod.val_natCast]
      have hdiv : a.val = (a.val / (ℓ₀ ^ r)) * (ℓ₀ ^ r) + b.val := by
        rw [hb_val, mul_comm]
        exact (Nat.div_add_mod a.val (ℓ₀ ^ r)).symm
      rw [hdiv, add_nsmul, mul_smul, hTors_X r (x.1 r), smul_zero, zero_add]
    have hp_mem_LY : ∀ x : ↥L_X, (fun r : ℕ => p₀ r (x.1 r)) ∈ L_Y := by
      intro x
      rw [hLY_mem]
      intro r
      have htr := DFunLike.congr_fun (hp₀_trans r) (x.1 (r + 1))
      change tr_Y r (p₀ (r + 1) (x.1 (r + 1))) = p₀ r (tr_X r (x.1 (r + 1))) at htr
      rw [htr, (hLX_mem x.1).mp x.2 r]
    let p_L : ↥L_X →+ ↥L_Y :=
      { toFun := fun x => ⟨fun r => p₀ r (x.1 r), hp_mem_LY x⟩
        map_zero' := Subtype.ext (funext fun r => map_zero (p₀ r))
        map_add' := fun x₁ x₂ => Subtype.ext (funext fun r => map_add (p₀ r) (x₁.1 r) (x₂.1 r)) }
    have hp_L_ker : ∀ x : ↥L_X, p_L x = 0 → δ₀ • x = 0 := by
      intro x hx
      refine Subtype.ext (funext fun r => ?_)
      have hpr : p₀ r (x.1 r) = 0 := congrFun (congrArg Subtype.val hx) r
      exact hp₀_ker r (x.1 r) hpr
    let B : ℚ →+ ↥L_X →+ TensorProduct ℤ ℚ ↥L_Y :=
      { toFun := fun q => (TensorProduct.mk ℤ ℚ ↥L_Y q).toAddMonoidHom.comp p_L
        map_zero' := by
          ext x
          exact TensorProduct.zero_tmul ℚ (p_L x)
        map_add' := fun q₁ q₂ => by
          ext x
          exact TensorProduct.add_tmul q₁ q₂ (p_L x) }
    have hB : ∀ (r : ℤ) (q : ℚ) (x : ↥L_X), B (r • q) x = B q (r • x) := by
      intro r q x
      change TensorProduct.tmul ℤ (r • q) (p_L x) = TensorProduct.tmul ℤ q (p_L (r • x))
      have hp_zsmul : p_L (r • x) = r • p_L x := map_zsmul p_L r x
      rw [hp_zsmul, TensorProduct.smul_tmul]
    let p_Q : TensorProduct ℤ ℚ ↥L_X →+ TensorProduct ℤ ℚ ↥L_Y :=
      TensorProduct.liftAddHom B hB
    have hp_Q_tmul : ∀ (q : ℚ) (x : ↥L_X),
        p_Q (TensorProduct.tmul ℤ q x) = TensorProduct.tmul ℤ q (p_L x) :=
      fun q x => TensorProduct.liftAddHom_tmul B hB q x
    have hp_Q_inj : Function.Injective p_Q := by
      rw [injective_iff_map_eq_zero]
      intro t ht
      let S₀ : Submonoid ℤ := nonZeroDivisors ℤ
      let f₁ : ↥L_X →ₗ[ℤ] TensorProduct ℤ ℚ ↥L_X := TensorProduct.mk ℤ ℚ ↥L_X (1 : ℚ)
      let f₂ : ↥L_Y →ₗ[ℤ] TensorProduct ℤ ℚ ↥L_Y := TensorProduct.mk ℤ ℚ ↥L_Y (1 : ℚ)
      have : IsLocalizedModule S₀ f₁ :=
        IsLocalization.tensorProduct_isLocalizedModule S₀ ℚ
      have : IsLocalizedModule S₀ f₂ :=
        IsLocalization.tensorProduct_isLocalizedModule S₀ ℚ
      obtain ⟨⟨x, s⟩, hst⟩ := IsLocalizedModule.surj S₀ f₁ t
      have hst_z : (s : ℤ) • t = TensorProduct.tmul ℤ (1 : ℚ) x := hst
      have hs_ne : (s : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have hf₂_zero : f₂ (p_L x) = 0 := by
        change TensorProduct.tmul ℤ (1 : ℚ) (p_L x) = 0
        rw [← hp_Q_tmul (1 : ℚ) x, ← hst_z, map_zsmul, ht, smul_zero]
      have hmk_zero : IsLocalizedModule.mk' f₂ (p_L x) (1 : S₀) = 0 :=
        (IsLocalizedModule.mk'_eq_zero (1 : S₀)).mpr hf₂_zero
      obtain ⟨s', hs'⟩ := (IsLocalizedModule.mk'_eq_zero' f₂ (1 : S₀)).mp hmk_zero
      have hs'_z : (s' : ℤ) • p_L x = 0 := hs'
      have hs'_ne : (s' : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s'.2
      set M := (s' : ℤ).natAbs
      have hM_pos : 0 < M := Int.natAbs_pos.mpr hs'_ne
      have hM_ann : M • p_L x = 0 := by
        rcases Int.natAbs_eq (s' : ℤ) with hpos | hneg
        · rw [hpos, natCast_zsmul] at hs'_z
          exact hs'_z
        · rw [hneg, neg_zsmul, natCast_zsmul, neg_eq_zero] at hs'_z
          exact hs'_z
      have hp_Mx : p_L (M • x) = 0 := by
        rw [map_nsmul, hM_ann]
      have hδM_x : (δ₀ * M) • x = 0 := by
        rw [mul_smul]
        exact hp_L_ker (M • x) hp_Mx
      have hδM_t : (δ₀ * M) • ((s : ℤ) • t) = 0 := by
        rw [hst_z, ← TensorProduct.tmul_smul, hδM_x, TensorProduct.tmul_zero]
      have hQ_t : (((δ₀ * M : ℕ) : ℚ) * ((s : ℤ) : ℚ)) • t = 0 := by
        rw [mul_smul, Int.cast_smul_eq_zsmul, Nat.cast_smul_eq_nsmul]
        exact hδM_t
      have hδM_pos : 0 < δ₀ * M := Nat.mul_pos (Nat.lt_of_lt_of_le Nat.zero_lt_one hδ₀) hM_pos
      have hcoeff_ne : (((δ₀ * M : ℕ) : ℚ) * ((s : ℤ) : ℚ)) ≠ 0 :=
        mul_ne_zero (Nat.cast_ne_zero.mpr (Nat.ne_of_gt hδM_pos)) (Int.cast_ne_zero.mpr hs_ne)
      exact (smul_eq_zero.mp hQ_t).resolve_left hcoeff_ne
    let f₀ : V_X →+ V_Y :=
      (equiv_Y.toAddMonoidHom.comp p_Q).comp equiv_X.symm.toAddMonoidHom
    have hf₀_inj : Function.Injective f₀ :=
      equiv_Y.injective.comp (hp_Q_inj.comp equiv_X.symm.injective)
    have hf₀_tmul : ∀ x : ↥L_X,
        f₀ (equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x)) =
          equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) (p_L x)) := by
      intro x
      change equiv_Y (p_Q (equiv_X.symm (equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x)))) = _
      rw [equiv_X.symm_apply_apply, hp_Q_tmul]
    have hf₀_rat : ∀ (q : ℚ) (v : V_X),
        f₀ ((q : Padic ℓ₀) • v) = (q : Padic ℓ₀) • f₀ v :=
      fun q v => map_ratCast_smul f₀ (Padic ℓ₀) (Padic ℓ₀) q v
    have heX_tmul : ∀ (q : ℚ) (x : ↥L_X),
        equiv_X (TensorProduct.tmul ℤ q x) =
          (q : Padic ℓ₀) • equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x) := by
      intro q x
      have hq : TensorProduct.tmul ℤ q x =
          (q : ℚ) • TensorProduct.tmul ℤ (1 : ℚ) x := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [hq]
      exact map_ratCast_smul equiv_X ℚ (Padic ℓ₀) q (TensorProduct.tmul ℤ (1 : ℚ) x)
    have hLin_ext : ∀ (g₁ g₂ : V_X →ₗ[Padic ℓ₀] V_Y),
        (∀ x : ↥L_X,
          g₁ (equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x)) =
            g₂ (equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x))) →
        g₁ = g₂ := by
      intro g₁ g₂ hg
      ext v
      have hv : ∀ t : TensorProduct ℤ ℚ ↥L_X, g₁ (equiv_X t) = g₂ (equiv_X t) := by
        intro t
        refine TensorProduct.inductionOn t ?_ ?_
        · intro q x
          rw [heX_tmul q x, map_smul, map_smul, hg x]
        · intro t₁ t₂ ht₁ ht₂
          rw [map_add, map_add, map_add, ht₁, ht₂]
      simpa [equiv_X.apply_symm_apply] using hv (equiv_X.symm v)
    have hf₀_padicInt : ∀ (z : PadicInt ℓ₀) (v : V_X),
        f₀ ((z : Padic ℓ₀) • v) = (z : Padic ℓ₀) • f₀ v := by
      intro z v
      have ht : ∀ t : TensorProduct ℤ ℚ ↥L_X,
          f₀ ((z : Padic ℓ₀) • equiv_X t) = (z : Padic ℓ₀) • f₀ (equiv_X t) := by
        intro t
        refine TensorProduct.inductionOn t ?_ ?_
        · intro q x
          let y : ↥L_X := ⟨fun r => (PadicInt.toZModPow r z).val • x.1 r, hZModSmul z x⟩
          have hy₁ : equiv_X (TensorProduct.tmul ℤ (1 : ℚ) y) =
              (z : Padic ℓ₀) • equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x) :=
            hsmul_X z x y (fun _ => rfl)
          have hy₂ : equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) (p_L y)) =
              (z : Padic ℓ₀) • equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) (p_L x)) :=
            hsmul_Y z (p_L x) (p_L y) (fun r => map_nsmul (p₀ r) _ (x.1 r))
          calc
            f₀ ((z : Padic ℓ₀) • equiv_X (TensorProduct.tmul ℤ q x)) =
                f₀ ((z : Padic ℓ₀) • ((q : Padic ℓ₀) • equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x))) := by
              rw [heX_tmul q x]
            _ = f₀ ((q : Padic ℓ₀) • ((z : Padic ℓ₀) • equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x))) := by
              rw [smul_comm]
            _ = (q : Padic ℓ₀) • f₀ (equiv_X (TensorProduct.tmul ℤ (1 : ℚ) y)) := by
              rw [hf₀_rat, hy₁]
            _ = (q : Padic ℓ₀) • equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) (p_L y)) := by
              rw [hf₀_tmul y]
            _ = (q : Padic ℓ₀) • ((z : Padic ℓ₀) • equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) (p_L x))) := by
              rw [hy₂]
            _ = (z : Padic ℓ₀) • ((q : Padic ℓ₀) • f₀ (equiv_X (TensorProduct.tmul ℤ (1 : ℚ) x))) := by
              rw [← hf₀_tmul x, smul_comm]
            _ = (z : Padic ℓ₀) • f₀ (equiv_X (TensorProduct.tmul ℤ q x)) := by
              rw [← hf₀_rat, ← heX_tmul q x]
        · intro t₁ t₂ ht₁ ht₂
          rw [map_add, smul_add, map_add, ht₁, ht₂, ← smul_add, ← map_add]
      simpa [equiv_X.apply_symm_apply] using ht (equiv_X.symm v)
    have hf₀_smul : ∀ (c : Padic ℓ₀) (v : V_X), f₀ (c • v) = c • f₀ v := by
      intro c v
      have h1lt : (1 : ℝ) < (ℓ₀ : ℝ) := Nat.one_lt_cast.mpr hPrime.one_lt
      have h0lt : (0 : ℝ) < (ℓ₀ : ℝ) := lt_trans zero_lt_one h1lt
      obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ‖c‖ h1lt
      let w : Padic ℓ₀ := (ℓ₀ : Padic ℓ₀) ^ k * c
      have hw : ‖w‖ ≤ 1 := by
        have hpow_pos : (0 : ℝ) < (ℓ₀ : ℝ) ^ k := pow_pos h0lt k
        calc
          ‖w‖ = ‖(ℓ₀ : Padic ℓ₀) ^ k‖ * ‖c‖ := norm_mul _ _
          _ = ((ℓ₀ : ℝ) ^ k)⁻¹ * ‖c‖ := by rw [norm_pow, Padic.norm_p, inv_pow]
          _ ≤ ((ℓ₀ : ℝ) ^ k)⁻¹ * (ℓ₀ : ℝ) ^ k :=
            mul_le_mul_of_nonneg_left (le_of_lt hk) (inv_nonneg.mpr (le_of_lt hpow_pos))
          _ = 1 := inv_mul_cancel₀ (ne_of_gt hpow_pos)
      let z₀ : PadicInt ℓ₀ := ⟨w, hw⟩
      let q_k : ℚ := (((ℓ₀ ^ k : ℕ) : ℚ))⁻¹
      have hℓ_ne_padic : (ℓ₀ : Padic ℓ₀) ^ k ≠ 0 :=
        pow_ne_zero k (Nat.cast_ne_zero.mpr hPrime.ne_zero)
      have hc_eq : (q_k : Padic ℓ₀) * (z₀ : Padic ℓ₀) = c := by
        change ((((ℓ₀ ^ k : ℕ) : ℚ)⁻¹ : ℚ) : Padic ℓ₀) * ((ℓ₀ : Padic ℓ₀) ^ k * c) = c
        rw [Rat.cast_inv, Rat.cast_natCast, Nat.cast_pow]
        exact inv_mul_cancel_left₀ hℓ_ne_padic c
      calc
        f₀ (c • v) = f₀ (((q_k : Padic ℓ₀) * (z₀ : Padic ℓ₀)) • v) := by rw [hc_eq]
        _ = f₀ ((q_k : Padic ℓ₀) • ((z₀ : Padic ℓ₀) • v)) := by rw [mul_smul]
        _ = (q_k : Padic ℓ₀) • f₀ ((z₀ : Padic ℓ₀) • v) := hf₀_rat q_k _
        _ = (q_k : Padic ℓ₀) • ((z₀ : Padic ℓ₀) • f₀ v) := by rw [hf₀_padicInt z₀ v]
        _ = ((q_k : Padic ℓ₀) * (z₀ : Padic ℓ₀)) • f₀ v := (mul_smul _ _ _).symm
        _ = c • f₀ v := by rw [hc_eq]
    let f : V_X →ₗ[Padic ℓ₀] V_Y :=
      { toFun := f₀
        map_add' := f₀.map_add
        map_smul' := hf₀_smul }
    have hFX_mem : ∀ z : ↥L_X, (fun r : ℕ => frobTors_X r (z.1 r)) ∈ L_X := by
      intro z
      rw [hLX_mem]
      intro r
      have htr := DFunLike.congr_fun (hX₀_frob_trans r) (z.1 (r + 1))
      change tr_X r (frobTors_X (r + 1) (z.1 (r + 1))) = frobTors_X r (tr_X r (z.1 (r + 1))) at htr
      rw [htr, (hLX_mem z.1).mp z.2 r]
    let F_X : ↥L_X → ↥L_X := fun z => ⟨fun r => frobTors_X r (z.1 r), hFX_mem z⟩
    have hFX_equiv : ∀ z : ↥L_X,
        frob_X (equiv_X (TensorProduct.tmul ℤ (1 : ℚ) z)) =
          equiv_X (TensorProduct.tmul ℤ (1 : ℚ) (F_X z)) :=
      fun z => hfrob_X z (F_X z) (fun _ => rfl)
    have hFX_iter_equiv : ∀ (k : ℕ) (z : ↥L_X),
        (⇑frob_X)^[k] (equiv_X (TensorProduct.tmul ℤ (1 : ℚ) z)) =
          equiv_X (TensorProduct.tmul ℤ (1 : ℚ) (F_X^[k] z)) := by
      intro k
      induction k with
      | zero =>
        intro z
        rfl
      | succ k ih =>
        intro z
        rw [Function.iterate_succ_apply, hFX_equiv z, ih (F_X z), ← Function.iterate_succ_apply]
    have hFX_iter_val : ∀ (k : ℕ) (z : ↥L_X) (r : ℕ),
        (F_X^[k] z).1 r = (⇑(frobTors_X r))^[k] (z.1 r) := by
      intro k
      induction k with
      | zero =>
        intro z r
        rfl
      | succ k ih =>
        intro z r
        rw [Function.iterate_succ_apply, ih (F_X z) r]
        exact (Function.iterate_succ_apply (⇑(frobTors_X r)) k (z.1 r)).symm
    have hFrob_eq : f.comp (frob_X ^ m₀) = frob_Y.comp f := by
      apply hLin_ext
      intro x
      simp only [LinearMap.comp_apply]
      rw [Module.End.pow_apply, hFX_iter_equiv m₀ x]
      have hf_apply : ∀ w : ↥L_X,
          f (equiv_X (TensorProduct.tmul ℤ (1 : ℚ) w)) =
            equiv_Y (TensorProduct.tmul ℤ (1 : ℚ) (p_L w)) := hf₀_tmul
      rw [hf_apply (F_X^[m₀] x), hf_apply x]
      symm
      apply hfrob_Y (p_L x) (p_L (F_X^[m₀] x))
      intro r
      change p₀ r ((F_X^[m₀] x).1 r) = frobTors_Y r (p₀ r (x.1 r))
      rw [hFX_iter_val m₀ x r]
      exact hp₀_frob r (x.1 r)
    exact ⟨f, hf₀_inj, fun v => DFunLike.congr_fun hFrob_eq v⟩
  exact hAbstract ℓ m δ hδ
    (fun r => weilEtaleTorsionH (weilGeomScheme F X) (ℓ ^ r) i)
    (fun r => weilEtaleTorsionH (weilGeomScheme F₁ Y) (ℓ ^ r) i)
    (fun r => weilEtaleTorsionTransition (weilGeomScheme F X) ℓ r i)
    (fun r => weilEtaleTorsionTransition (weilGeomScheme F₁ Y) ℓ r i)
    (weilEtaleIntegralSystem (weilGeomScheme F X) ℓ i)
    (weilEtaleIntegralSystem (weilGeomScheme F₁ Y) ℓ i)
    (hmem_gen (weilGeomScheme F X) ℓ i)
    (hmem_gen (weilGeomScheme F₁ Y) ℓ i)
    (fun r => hTorsionAnn (weilGeomScheme F X) (ℓ ^ r) i)
    M_X.V M_Y.V M_X.frob M_Y.frob M_X.frobTorsion M_Y.frobTorsion
    M_X.equiv M_Y.equiv M_X.hsmul M_Y.hsmul M_X.hfrob M_Y.hfrob
    p hp_trans hX_frob_trans hp_frob hp_ker

theorem weil_etale_alteration_pullback_injective (F : Type u) [Finite F] [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible X.hom]
    [AlgebraicGeometry.IsProper X.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (F₁ : Type u) [Finite F₁] [Field F₁] [Algebra F F₁] [FiniteDimensional F F₁]
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F₁)))
    [AlgebraicGeometry.GeometricallyIrreducible Y.hom]
    [AlgebraicGeometry.IsProper Y.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d Y.hom]
    (φ : Y ⟶ weilBaseChangeOver F F₁ X)
    (hφ_prop : AlgebraicGeometry.IsProper φ.left)
    (hφ_surj : AlgebraicGeometry.Surjective φ.left)
    (U : (weilBaseChangeOver F F₁ X).left.Opens)
    (hU_ne : Nonempty U)
    (hU_fin : AlgebraicGeometry.IsFinite (φ.left ∣_ U))
    (hU_et : AlgebraicGeometry.Etale (φ.left ∣_ U))
    (hU_surj : AlgebraicGeometry.Surjective (φ.left ∣_ U))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (i : ℕ) (hi : i ≤ 2 * d)
    (M_X : WeilEllAdicCohomologyModel F X ℓ i)
    (M_Y : WeilEllAdicCohomologyModel F₁ Y ℓ i) :
    ∃ f : M_X.V →ₗ[Padic ℓ] M_Y.V,
      Function.Injective f ∧
      ∀ v : M_X.V, f ((M_X.frob ^ Module.finrank F F₁) v) = M_Y.frob (f v) :=
by
  have hPrime : Nat.Prime ℓ := Fact.out
  have hCharF₁ : CharP F₁ (ringChar F) :=
    (RingHom.charP_iff_charP (algebraMap F F₁) (ringChar F)).mp inferInstance
  have hCharK : CharP (AlgebraicClosure F₁) (ringChar F) :=
    (RingHom.charP_iff_charP (algebraMap F₁ (AlgebraicClosure F₁)) (ringChar F)).mp hCharF₁
  have hℓ_ne_zero_K : ((ℓ : ℕ) : AlgebraicClosure F₁) ≠ 0 := by
    intro hzero
    have hdvd : ringChar F ∣ ℓ :=
      (@CharP.cast_eq_zero_iff (AlgebraicClosure F₁) _ (ringChar F) hCharK ℓ).mp hzero
    rcases CharP.char_is_prime_or_zero F (ringChar F) with hp | hz
    · rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | heq
      · exact hp.ne_one h1
      · exact hℓ heq.symm
    · rw [hz, zero_dvd_iff] at hdvd
      exact hPrime.ne_zero hdvd
  have hOneLe : ∀ r : ℕ, 1 ≤ ℓ ^ r := fun r => Nat.one_le_pow r ℓ hPrime.pos
  have hUnit : ∀ r : ℕ, IsUnit ((ℓ ^ r : ℕ) : AlgebraicClosure F₁) := by
    intro r
    apply IsUnit.mk0
    rw [Nat.cast_pow]
    exact pow_ne_zero r hℓ_ne_zero_K
  obtain ⟨hPullEx, hPullId, hPullComp, hPullTrans, hPullFrob⟩ :=
    weil_etale_torsion_pullback_functoriality.{u}
  obtain ⟨X_bar₁, ψ, U_bar, σ, hIrrX, hPropX, hSmoothX, hIrrY, hPropY, hSmoothY,
    hψ_prop, hψ_surj, hUbar_ne, hUbar_fin, hUbar_et, hUbar_surj, hFrob_comm⟩ :=
    weil_algClosure_alteration_geometry_and_frob_alignment F X d F₁ Y φ hφ_prop hφ_surj
      U hU_ne hU_fin hU_et hU_surj
  letI : IrreducibleSpace X_bar₁.left := hIrrX
  letI : AlgebraicGeometry.IsProper X_bar₁.hom := hPropX
  letI : AlgebraicGeometry.SmoothOfRelativeDimension d X_bar₁.hom := hSmoothX
  letI : IrreducibleSpace (weilBaseChangeOver F₁ (AlgebraicClosure F₁) Y).left := hIrrY
  letI : AlgebraicGeometry.IsProper (weilBaseChangeOver F₁ (AlgebraicClosure F₁) Y).hom := hPropY
  letI : AlgebraicGeometry.SmoothOfRelativeDimension d
    (weilBaseChangeOver F₁ (AlgebraicClosure F₁) Y).hom := hSmoothY
  obtain ⟨δ, hδ, hTopAnn⟩ :=
    weil_etale_top_degree_alteration_rank_annihilation (AlgebraicClosure F₁) d
      X_bar₁ (weilBaseChangeOver F₁ (AlgebraicClosure F₁) Y) ψ hψ_prop hψ_surj
      U_bar hUbar_ne hUbar_fin hUbar_et hUbar_surj
  let π : weilGeomScheme F₁ Y ⟶ weilGeomScheme F X :=
    CategoryTheory.CategoryStruct.comp ψ.left σ.hom
  let p : ∀ r : ℕ,
      weilEtaleTorsionH (weilGeomScheme F X) (ℓ ^ r) i →+
        weilEtaleTorsionH (weilGeomScheme F₁ Y) (ℓ ^ r) i :=
    fun r => Classical.choose (hPullEx π (ℓ ^ r) i)
  have hp : ∀ r : ℕ, WeilIsTorsionEtalePullback π (ℓ ^ r) i (p r) :=
    fun r => Classical.choose_spec (hPullEx π (ℓ ^ r) i)
  have hp_trans : ∀ r : ℕ,
      (weilEtaleTorsionTransition (weilGeomScheme F₁ Y) ℓ r i).comp (p (r + 1)) =
        (p r).comp (weilEtaleTorsionTransition (weilGeomScheme F X) ℓ r i) :=
    fun r => hPullTrans π ℓ r i (p (r + 1)) (p r) (hp (r + 1)) (hp r)
  have hPullFrobX : ∀ r : ℕ,
      WeilIsTorsionEtalePullback (weilGeomFrobHom F X) (ℓ ^ r) i (M_X.frobTorsion r) := by
    intro r
    obtain ⟨qX, hqX⟩ := hPullEx (weilGeomFrobHom F X) (ℓ ^ r) i
    have heq := hPullFrob F X (ℓ ^ r) i (M_X.frobTorsion r) qX (M_X.hfrobTorsion r) hqX
    rwa [heq]
  have hPullFrobY : ∀ r : ℕ,
      WeilIsTorsionEtalePullback (weilGeomFrobHom F₁ Y) (ℓ ^ r) i (M_Y.frobTorsion r) := by
    intro r
    obtain ⟨qY, hqY⟩ := hPullEx (weilGeomFrobHom F₁ Y) (ℓ ^ r) i
    have heq := hPullFrob F₁ Y (ℓ ^ r) i (M_Y.frobTorsion r) qY (M_Y.hfrobTorsion r) hqY
    rwa [heq]
  have hX_frob_trans : ∀ r : ℕ,
      (weilEtaleTorsionTransition (weilGeomScheme F X) ℓ r i).comp (M_X.frobTorsion (r + 1)) =
        (M_X.frobTorsion r).comp (weilEtaleTorsionTransition (weilGeomScheme F X) ℓ r i) :=
    fun r => hPullTrans (weilGeomFrobHom F X) ℓ r i
      (M_X.frobTorsion (r + 1)) (M_X.frobTorsion r) (hPullFrobX (r + 1)) (hPullFrobX r)
  have hp_frob : ∀ (r : ℕ) (u : weilEtaleTorsionH (weilGeomScheme F X) (ℓ ^ r) i),
      p r ((⇑(M_X.frobTorsion r))^[Module.finrank F F₁] u) = M_Y.frobTorsion r (p r u) := by
    intro r u
    let frobPow : ℕ →
        (weilEtaleTorsionH (weilGeomScheme F X) (ℓ ^ r) i →+
          weilEtaleTorsionH (weilGeomScheme F X) (ℓ ^ r) i) :=
      Nat.rec (AddMonoidHom.id _) (fun _ ih => (M_X.frobTorsion r).comp ih)
    have hfrobPow_apply : ∀ (k : ℕ) (w : weilEtaleTorsionH (weilGeomScheme F X) (ℓ ^ r) i),
        frobPow k w = (⇑(M_X.frobTorsion r))^[k] w := by
      intro k w
      induction k with
      | zero => rfl
      | succ k ih =>
        change M_X.frobTorsion r (frobPow k w) = (⇑(M_X.frobTorsion r))^[k + 1] w
        rw [ih, Function.iterate_succ_apply']
    have hfrobPow_pull : ∀ k : ℕ,
        WeilIsTorsionEtalePullback
          (weilSchemeEndPow (weilGeomFrobHom F X) k) (ℓ ^ r) i (frobPow k) := by
      intro k
      induction k with
      | zero =>
        obtain ⟨pid, hpid⟩ :=
          hPullEx (CategoryTheory.CategoryStruct.id (weilGeomScheme F X)) (ℓ ^ r) i
        have heq := hPullId (ℓ ^ r) i pid hpid
        change WeilIsTorsionEtalePullback
          (CategoryTheory.CategoryStruct.id (weilGeomScheme F X)) (ℓ ^ r) i (AddMonoidHom.id _)
        rwa [← heq]
      | succ k ih =>
        obtain ⟨pk, hpk⟩ := hPullEx
          (CategoryTheory.CategoryStruct.comp (weilGeomFrobHom F X)
            (weilSchemeEndPow (weilGeomFrobHom F X) k)) (ℓ ^ r) i
        have heq := hPullComp (weilGeomFrobHom F X)
          (weilSchemeEndPow (weilGeomFrobHom F X) k) (ℓ ^ r) i
          (M_X.frobTorsion r) (frobPow k) pk (hPullFrobX r) ih hpk
        change WeilIsTorsionEtalePullback
          (CategoryTheory.CategoryStruct.comp (weilGeomFrobHom F X)
            (weilSchemeEndPow (weilGeomFrobHom F X) k)) (ℓ ^ r) i
          ((M_X.frobTorsion r).comp (frobPow k))
        rwa [← heq]
    set m := Module.finrank F F₁
    obtain ⟨pLHS, hpLHS⟩ := hPullEx
      (CategoryTheory.CategoryStruct.comp (weilGeomFrobHom F₁ Y) π) (ℓ ^ r) i
    have hLHS_eq : pLHS = (M_Y.frobTorsion r).comp (p r) :=
      hPullComp (weilGeomFrobHom F₁ Y) π (ℓ ^ r) i
        (M_Y.frobTorsion r) (p r) pLHS (hPullFrobY r) (hp r) hpLHS
    have hpLHS_rhs : WeilIsTorsionEtalePullback
        (CategoryTheory.CategoryStruct.comp π
          (weilSchemeEndPow (weilGeomFrobHom F X) m)) (ℓ ^ r) i pLHS := by
      rwa [← hFrob_comm]
    have hRHS_eq : pLHS = (p r).comp (frobPow m) :=
      hPullComp π (weilSchemeEndPow (weilGeomFrobHom F X) m) (ℓ ^ r) i
        (p r) (frobPow m) pLHS (hp r) (hfrobPow_pull m) hpLHS_rhs
    have hcomm_hom : (p r).comp (frobPow m) = (M_Y.frobTorsion r).comp (p r) :=
      hRHS_eq.symm.trans hLHS_eq
    rw [← hfrobPow_apply m u]
    exact DFunLike.congr_fun hcomm_hom u
  have hp_ker : ∀ (r : ℕ) (u : weilEtaleTorsionH (weilGeomScheme F X) (ℓ ^ r) i),
      p r u = 0 → δ • u = 0 := by
    intro r u hpu
    let n := ℓ ^ r
    obtain ⟨q_σ, hq_σ⟩ := hPullEx σ.hom n i
    obtain ⟨q_σ_inv, hq_σ_inv⟩ := hPullEx σ.inv n i
    obtain ⟨p_ψ_i, hp_ψ_i⟩ := hPullEx ψ.left n i
    obtain ⟨p_ψ_compl, hp_ψ_compl⟩ := hPullEx ψ.left n (2 * d - i)
    obtain ⟨p_ψ_top, hp_ψ_top⟩ := hPullEx ψ.left n (2 * d)
    have hp_decomp : p r = p_ψ_i.comp q_σ :=
      hPullComp ψ.left σ.hom n i p_ψ_i q_σ (p r) hp_ψ_i hq_σ (hp r)
    have hψ_zero : p_ψ_i (q_σ u) = 0 := by
      have h1 : (p_ψ_i.comp q_σ) u = 0 := by rw [← hp_decomp]; exact hpu
      exact h1
    obtain ⟨cup, hCupNat, hCupNonDeg⟩ :=
      weil_etale_cup_product_poincare_nondegenerate.{u} d i n hi
    have hAllZ : ∀ z : weilEtaleTorsionH X_bar₁.left n (2 * d - i),
        cup X_bar₁.left (δ • q_σ u) z = 0 := by
      intro z
      have hnat := hCupNat ψ.left p_ψ_i p_ψ_compl p_ψ_top
        hp_ψ_i hp_ψ_compl hp_ψ_top (q_σ u) z
      rw [hψ_zero, map_zero, AddMonoidHom.zero_apply] at hnat
      have hann := hTopAnn n (hOneLe r) (hUnit r) p_ψ_top hp_ψ_top
        (cup X_bar₁.left (q_σ u) z) hnat
      rw [map_nsmul, AddMonoidHom.nsmul_apply]
      exact hann
    have hδ_qσ : δ • q_σ u = 0 :=
      hCupNonDeg (AlgebraicClosure F₁) (hOneLe r) (hUnit r) X_bar₁ (δ • q_σ u) hAllZ
    obtain ⟨pid, hpid⟩ := hPullEx (CategoryTheory.CategoryStruct.id (weilGeomScheme F X)) n i
    have hpid_eq : pid = AddMonoidHom.id _ := hPullId n i pid hpid
    have hpid_comp : WeilIsTorsionEtalePullback
        (CategoryTheory.CategoryStruct.comp σ.inv σ.hom) n i pid := by
      rw [σ.inv_hom_id]
      exact hpid
    have hinv_comp : pid = q_σ_inv.comp q_σ :=
      hPullComp σ.inv σ.hom n i q_σ_inv q_σ pid hq_σ_inv hq_σ hpid_comp
    have hid_apply : q_σ_inv (q_σ (δ • u)) = δ • u := by
      have h2 : (q_σ_inv.comp q_σ) (δ • u) = pid (δ • u) := by rw [hinv_comp]
      rw [hpid_eq] at h2
      exact h2
    calc
      δ • u = q_σ_inv (q_σ (δ • u)) := hid_apply.symm
      _ = q_σ_inv (δ • q_σ u) := congrArg q_σ_inv (map_nsmul q_σ δ u)
      _ = q_σ_inv 0 := congrArg q_σ_inv hδ_qσ
      _ = 0 := map_zero q_σ_inv
  exact weil_ell_adic_model_linear_map_of_torsion_pullback F X F₁ Y ℓ
    (Module.finrank F F₁) i δ hδ M_X M_Y p hp_trans hX_frob_trans hp_frob hp_ker

theorem weil_ellAdicModel_charpoly_eq (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i : ℕ)
    (M₁ M₂ : WeilEllAdicCohomologyModel K Z ℓ i) :
    (M₁.frob).charpoly = (M₂.frob).charpoly :=
by
  have hTorsGen : ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (m i₀ : ℕ)
      (w : weilEtaleTorsionH S₀ m i₀), m • w = 0 := by
    intro S₀ m i₀ w
    let J := S₀.smallEtaleTopology
    let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let Ulift := AddCommGrpCat.uliftFunctor.{u, 0}
    let Zm := AddCommGrpCat.of (ZMod m)
    let FM := weilEtaleTorsionSheaf S₀ m
    have hExt_nsmul : ∀ (k : ℕ),
        w.comp (CategoryTheory.Abelian.Ext.mk₀ (k • 𝟙 FM)) (Nat.add_zero i₀) = k • w := by
      intro k
      induction k with
      | zero =>
        rw [zero_smul, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero, zero_smul]
      | succ k ih =>
        rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
          CategoryTheory.Abelian.Ext.comp_add, ih,
          CategoryTheory.Abelian.Ext.comp_mk₀_id, succ_nsmul]
    have hZm_zero : m • (𝟙 Zm) = 0 := by
      ext a
      simp [nsmul_eq_mul, CharP.cast_eq_zero]
    letI : CategoryTheory.Limits.PreservesFiniteLimits C :=
      CategoryTheory.Limits.comp_preservesFiniteLimits
        (CategoryTheory.Functor.const (S₀.Etale)ᵒᵖ)
        (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u})
    letI : C.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products C
    have hUlift_zero : m • (𝟙 (Ulift.obj Zm)) = 0 := by
      rw [← Ulift.map_id, ← CategoryTheory.Functor.map_nsmul, hZm_zero,
        CategoryTheory.Functor.map_zero]
    have hFM_zero : m • (𝟙 FM) = 0 := by
      change m • (𝟙 (C.obj (Ulift.obj Zm))) = 0
      rw [← C.map_id, ← CategoryTheory.Functor.map_nsmul, hUlift_zero,
        CategoryTheory.Functor.map_zero]
    have hw := hExt_nsmul m
    rw [hFM_zero, CategoryTheory.Abelian.Ext.mk₀_zero,
      CategoryTheory.Abelian.Ext.comp_zero] at hw
    exact hw.symm

  let IsFrobAct (S₀ : AlgebraicGeometry.Scheme.{u}) (g₀ : Quiver.Hom S₀ S₀) (m i₀ : ℕ)
      (f : weilEtaleTorsionH S₀ m i₀ →+ weilEtaleTorsionH S₀ m i₀) : Prop :=
    let J := S₀.smallEtaleTopology
    let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let Fℤ := C.obj (AddCommGrpCat.of (ULift.{u} ℤ))
    let FM := weilEtaleTorsionSheaf S₀ m
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S₀
    ∃ (G : CategoryTheory.Functor S₀.Etale S₀.Etale),
      (∀ U : S₀.Etale, (Fgt.obj (G.obj U)).left = (Fgt.obj U).left ∧
        HEq (Fgt.obj (G.obj U)).hom (CategoryTheory.CategoryStruct.comp (Fgt.obj U).hom g₀)) ∧
      (∀ {U₁ U₂ : S₀.Etale} (u : Quiver.Hom U₁ U₂), HEq (Fgt.map (G.map u)).left (Fgt.map u).left) ∧
      ∃ (_ : G.IsContinuous J J),
        let P := G.sheafPushforwardContinuous AddCommGrpCat.{u} J J
        ∃ (_ : P.Additive) (_ : CategoryTheory.Limits.PreservesFiniteLimits P)
          (_ : CategoryTheory.Limits.PreservesFiniteColimits P)
          (T : S₀.Etale) (hT : CategoryTheory.Limits.IsTerminal T) (μ : Quiver.Hom (G.obj T) T),
          (Fgt.obj T).left = S₀ ∧
          HEq (Fgt.obj T).hom (CategoryTheory.CategoryStruct.id S₀) ∧
          HEq (Fgt.map μ).left g₀ ∧
          let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
          let αℤ : Quiver.Hom Fℤ (P.obj Fℤ) :=
            (adj.homEquiv (AddCommGrpCat.of (ULift.{u} ℤ)) (P.obj Fℤ)).symm
              (CategoryTheory.CategoryStruct.comp (adj.unit.app (AddCommGrpCat.of (ULift.{u} ℤ))) (Fℤ.obj.map μ.op))
          let αM : Quiver.Hom FM (P.obj FM) :=
            (adj.homEquiv (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))) (P.obj FM)).symm
              (CategoryTheory.CategoryStruct.comp (adj.unit.app _) (FM.obj.map μ.op))
          ∃ (βM : Quiver.Hom (P.obj FM) FM),
            CategoryTheory.CategoryStruct.comp αM βM = CategoryTheory.CategoryStruct.id FM ∧
            CategoryTheory.CategoryStruct.comp βM αM = CategoryTheory.CategoryStruct.id (P.obj FM) ∧
            ∀ x : weilEtaleTorsionH S₀ m i₀,
              f x = (CategoryTheory.Abelian.Ext.mk₀ βM).postcomp Fℤ (Nat.add_zero i₀)
                ((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp
                  ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P _ _ _ _ _ Fℤ FM i₀) x) (Nat.zero_add i₀))

  have hFrobAct : ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (g₀ : Quiver.Hom S₀ S₀) (i₀ : ℕ),
      (∀ (m : ℕ) (p₁ p₂ : weilEtaleTorsionH S₀ m i₀ →+ weilEtaleTorsionH S₀ m i₀),
        IsFrobAct S₀ g₀ m i₀ p₁ → IsFrobAct S₀ g₀ m i₀ p₂ → p₁ = p₂) ∧
      (∀ (ℓ₀ r : ℕ)
        (p₁ : weilEtaleTorsionH S₀ (ℓ₀ ^ (r + 1)) i₀ →+ weilEtaleTorsionH S₀ (ℓ₀ ^ (r + 1)) i₀)
        (p₂ : weilEtaleTorsionH S₀ (ℓ₀ ^ r) i₀ →+ weilEtaleTorsionH S₀ (ℓ₀ ^ r) i₀),
        IsFrobAct S₀ g₀ (ℓ₀ ^ (r + 1)) i₀ p₁ →
        IsFrobAct S₀ g₀ (ℓ₀ ^ r) i₀ p₂ →
        ∀ w : weilEtaleTorsionH S₀ (ℓ₀ ^ (r + 1)) i₀,
          weilEtaleTorsionTransition S₀ ℓ₀ r i₀ (p₁ w) =
            p₂ (weilEtaleTorsionTransition S₀ ℓ₀ r i₀ w)) := by
    intro S₀ g₀ i₀
    let J := S₀.smallEtaleTopology
    let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let Fℤ := C.obj (AddCommGrpCat.of (ULift.{u} ℤ))
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S₀
    have etale_obj_ext : ∀ {U₁ U₂ : S₀.Etale},
        (Fgt.obj U₁).left = (Fgt.obj U₂).left →
        HEq (Fgt.obj U₁).hom (Fgt.obj U₂).hom → U₁ = U₂ :=
      fun hl hh =>
        @CategoryTheory.MorphismProperty.Comma.ext _ _ _ _ _ _ _ _
          (@AlgebraicGeometry.Etale) ⊤ ⊤ _ _ hl (Subsingleton.elim _ _) hh
    have etale_hom_ext : ∀ {U₁ U₂ : S₀.Etale} {u₁ u₂ : U₁ ⟶ U₂},
        (Fgt.map u₁).left = (Fgt.map u₂).left → u₁ = u₂ :=
      fun h => Fgt.map_injective (CategoryTheory.Over.OverMorphism.ext h)
    have heq_fgt_eqToHom : ∀ {A₁ A₂ B₁ B₂ : S₀.Etale}
        (e₁ : A₁ = B₁) (e₂ : A₂ = B₂) (v : B₁ ⟶ B₂),
        HEq (Fgt.map (eqToHom e₁ ≫ v ≫ eqToHom e₂.symm)).left (Fgt.map v).left := by
      intro A₁ A₂ B₁ B₂ e₁ e₂ v
      subst e₁
      subst e₂
      simp
    refine ⟨?_, ?_⟩
    · intro m p₁ p₂ h₁ h₂
      rcases h₁ with ⟨G₁, hG₁_obj, hG₁_map, hCont₁, hAdd₁, hLim₁, hColim₁,
        T₁, hT₁, μ₁, hT₁_l, hT₁_h, _, β₁, _, hβα₁, hp₁⟩
      rcases h₂ with ⟨G₂, hG₂_obj, hG₂_map, hCont₂, hAdd₂, hLim₂, hColim₂,
        T₂, hT₂, μ₂, hT₂_l, hT₂_h, _, β₂, hαβ₂, _, hp₂⟩
      have h_obj : ∀ U : S₀.Etale, G₁.obj U = G₂.obj U := fun U =>
        etale_obj_ext ((hG₁_obj U).1.trans (hG₂_obj U).1.symm)
          ((hG₁_obj U).2.trans (hG₂_obj U).2.symm)
      have hG_eq : G₁ = G₂ := CategoryTheory.Functor.ext h_obj fun U₁ U₂ u =>
        etale_hom_ext (eq_of_heq ((hG₁_map u).trans
          ((hG₂_map u).symm.trans (heq_fgt_eqToHom (h_obj U₁) (h_obj U₂) (G₂.map u)).symm)))
      subst hG_eq
      have hCont_eq : hCont₁ = hCont₂ := Subsingleton.elim _ _; subst hCont_eq
      have hAdd_eq : hAdd₁ = hAdd₂ := Subsingleton.elim _ _; subst hAdd_eq
      have hLim_eq : hLim₁ = hLim₂ := Subsingleton.elim _ _; subst hLim_eq
      have hColim_eq : hColim₁ = hColim₂ := Subsingleton.elim _ _; subst hColim_eq
      have hT_obj_eq : T₁ = T₂ := etale_obj_ext (hT₁_l.trans hT₂_l.symm) (hT₁_h.trans hT₂_h.symm)
      subst hT_obj_eq
      have hT_eq : hT₁ = hT₂ := Subsingleton.elim _ _; subst hT_eq
      have hμ_eq : μ₁ = μ₂ := hT₁.hom_ext μ₁ μ₂; subst hμ_eq
      have hβ_eq : β₁ = β₂ := by
        calc
          β₁ = β₁ ≫ 𝟙 _ := (CategoryTheory.Category.comp_id β₁).symm
          _ = β₁ ≫ (_ ≫ β₂) := by rw [hαβ₂]
          _ = (β₁ ≫ _) ≫ β₂ := (CategoryTheory.Category.assoc _ _ _).symm
          _ = 𝟙 _ ≫ β₂ := by rw [hβα₁]
          _ = β₂ := CategoryTheory.Category.id_comp β₂
      subst hβ_eq
      ext x
      exact (hp₁ x).trans (hp₂ x).symm
    · intro ℓ₀ r p₁ p₂ h₁ h₂ w
      rcases h₁ with ⟨G₁, hG₁_obj, hG₁_map, hCont₁, hAdd₁, hLim₁, hColim₁,
        T₁, hT₁, μ₁, hT₁_l, hT₁_h, _, β₁, _, hβα₁, hp₁⟩
      rcases h₂ with ⟨G₂, hG₂_obj, hG₂_map, hCont₂, hAdd₂, hLim₂, hColim₂,
        T₂, hT₂, μ₂, hT₂_l, hT₂_h, _, β₂, hαβ₂, _, hp₂⟩
      have h_obj : ∀ U : S₀.Etale, G₁.obj U = G₂.obj U := fun U =>
        etale_obj_ext ((hG₁_obj U).1.trans (hG₂_obj U).1.symm)
          ((hG₁_obj U).2.trans (hG₂_obj U).2.symm)
      have hG_eq : G₁ = G₂ := CategoryTheory.Functor.ext h_obj fun U₁ U₂ u =>
        etale_hom_ext (eq_of_heq ((hG₁_map u).trans
          ((hG₂_map u).symm.trans (heq_fgt_eqToHom (h_obj U₁) (h_obj U₂) (G₂.map u)).symm)))
      subst hG_eq
      have hCont_eq : hCont₁ = hCont₂ := Subsingleton.elim _ _; subst hCont_eq
      have hAdd_eq : hAdd₁ = hAdd₂ := Subsingleton.elim _ _; subst hAdd_eq
      have hLim_eq : hLim₁ = hLim₂ := Subsingleton.elim _ _; subst hLim_eq
      have hColim_eq : hColim₁ = hColim₂ := Subsingleton.elim _ _; subst hColim_eq
      have hT_obj_eq : T₁ = T₂ := etale_obj_ext (hT₁_l.trans hT₂_l.symm) (hT₁_h.trans hT₂_h.symm)
      subst hT_obj_eq
      have hT_eq : hT₁ = hT₂ := Subsingleton.elim _ _; subst hT_eq
      have hμ_eq : μ₁ = μ₂ := hT₁.hom_ext μ₁ μ₂; subst hμ_eq
      let P := G₁.sheafPushforwardContinuous AddCommGrpCat.{u} J J
      let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT₁
      let A₁ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ₀ ^ (r + 1))))
      let A₂ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ₀ ^ r)))
      let FM₁ := weilEtaleTorsionSheaf S₀ (ℓ₀ ^ (r + 1))
      let FM₂ := weilEtaleTorsionSheaf S₀ (ℓ₀ ^ r)
      let π₀ : A₁ ⟶ A₂ :=
        AddCommGrpCat.uliftFunctor.{u, 0}.map
          (AddCommGrpCat.ofHom
            (ZMod.castHom (pow_dvd_pow ℓ₀ (Nat.le_succ r)) (ZMod (ℓ₀ ^ r))).toAddMonoidHom)
      let π : FM₁ ⟶ FM₂ := C.map π₀
      let αℤ : Fℤ ⟶ P.obj Fℤ :=
        (adj.homEquiv (AddCommGrpCat.of (ULift.{u} ℤ)) (P.obj Fℤ)).symm
          (adj.unit.app (AddCommGrpCat.of (ULift.{u} ℤ)) ≫ Fℤ.obj.map μ₁.op)
      let αM₁ : FM₁ ⟶ P.obj FM₁ :=
        (adj.homEquiv A₁ (P.obj FM₁)).symm (adj.unit.app A₁ ≫ FM₁.obj.map μ₁.op)
      let αM₂ : FM₂ ⟶ P.obj FM₂ :=
        (adj.homEquiv A₂ (P.obj FM₂)).symm (adj.unit.app A₂ ≫ FM₂.obj.map μ₁.op)
      have hα_nat : π ≫ αM₂ = αM₁ ≫ P.map π := by
        apply (adj.homEquiv A₁ (P.obj FM₂)).injective
        have hunit : π₀ ≫ (adj.unit.app A₂ : A₂ ⟶ FM₂.obj.obj (Opposite.op T₁)) =
            (adj.unit.app A₁ : A₁ ⟶ FM₁.obj.obj (Opposite.op T₁)) ≫
              π.hom.app (Opposite.op T₁) :=
          adj.unit.naturality π₀
        have hnat : π.hom.app (Opposite.op T₁) ≫ FM₂.obj.map μ₁.op =
            FM₁.obj.map μ₁.op ≫ π.hom.app (Opposite.op (G₁.obj T₁)) :=
          (π.hom.naturality μ₁.op).symm
        exact ((adj.homEquiv_naturality_left π₀ αM₂).trans
          (congrArg (π₀ ≫ ·) ((adj.homEquiv A₂ (P.obj FM₂)).apply_symm_apply _))).trans
          (((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ FM₂.obj.map μ₁.op) hunit).trans
              ((CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (_ ≫ ·) hnat).trans
                  (CategoryTheory.Category.assoc _ _ _).symm)))).trans
            ((adj.homEquiv_naturality_right αM₁ (P.map π)).trans
              (congrArg (· ≫ _) ((adj.homEquiv A₁ (P.obj FM₁)).apply_symm_apply _))).symm)
      have hβα₁' : β₁ ≫ αM₁ = 𝟙 (P.obj FM₁) := hβα₁
      have hαβ₂' : αM₂ ≫ β₂ = 𝟙 FM₂ := hαβ₂
      have hβ_nat : P.map π ≫ β₂ = β₁ ≫ π := by
        calc
          P.map π ≫ β₂ = 𝟙 (P.obj FM₁) ≫ (P.map π ≫ β₂) :=
            (CategoryTheory.Category.id_comp _).symm
          _ = (β₁ ≫ αM₁) ≫ (P.map π ≫ β₂) := by rw [hβα₁']
          _ = β₁ ≫ (αM₁ ≫ P.map π) ≫ β₂ := by simp only [CategoryTheory.Category.assoc]
          _ = β₁ ≫ (π ≫ αM₂) ≫ β₂ := by rw [← hα_nat]
          _ = (β₁ ≫ π) ≫ (αM₂ ≫ β₂) := by simp only [CategoryTheory.Category.assoc]
          _ = (β₁ ≫ π) ≫ 𝟙 FM₂ := by rw [hαβ₂']
          _ = β₁ ≫ π := CategoryTheory.Category.comp_id _
      rw [hp₁ w, hp₂ (weilEtaleTorsionTransition S₀ ℓ₀ r i₀ w)]
      dsimp only [weilEtaleTorsionTransition]
      change (((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp
          ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P _ _ _ _ _ Fℤ FM₁ i₀) w)
          (Nat.zero_add i₀)).comp (CategoryTheory.Abelian.Ext.mk₀ β₁) (Nat.add_zero i₀)).comp
          (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero i₀) =
        ((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp
          ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P _ _ _ _ _ Fℤ FM₂ i₀)
            (w.comp (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero i₀)))
          (Nat.zero_add i₀)).comp (CategoryTheory.Abelian.Ext.mk₀ β₂) (Nat.add_zero i₀)
      rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero i₀) (zero_add 0) (Nat.add_zero i₀),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← hβ_nat,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero i₀) (zero_add 0) (Nat.add_zero i₀),
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add i₀) (Nat.add_zero i₀) (Nat.zero_add i₀)]

  let S := weilGeomScheme K Z
  have hTors : ∀ (r : ℕ) (w : weilEtaleTorsionH S (ℓ ^ r) i), (ℓ ^ r) • w = 0 :=
    fun r w => hTorsGen S (ℓ ^ r) i w
  have hf_eq : ∀ r : ℕ, M₁.frobTorsion r = M₂.frobTorsion r :=
    fun r => (hFrobAct S (weilGeomFrobHom K Z) i).1 (ℓ ^ r)
      (M₁.frobTorsion r) (M₂.frobTorsion r) (M₁.hfrobTorsion r) (M₂.hfrobTorsion r)
  have hf_tr : ∀ (r : ℕ) (w : weilEtaleTorsionH S (ℓ ^ (r + 1)) i),
      weilEtaleTorsionTransition S ℓ r i (M₁.frobTorsion (r + 1) w) =
        M₁.frobTorsion r (weilEtaleTorsionTransition S ℓ r i w) :=
    fun r w => (hFrobAct S (weilGeomFrobHom K Z) i).2 ℓ r
      (M₁.frobTorsion (r + 1)) (M₁.frobTorsion r)
      (M₁.hfrobTorsion (r + 1)) (M₁.hfrobTorsion r) w

  let L_sub := weilEtaleIntegralSystem S ℓ i
  have hL_mem : ∀ f : (∀ r : ℕ, weilEtaleTorsionH S (ℓ ^ r) i),
      f ∈ L_sub ↔ ∀ r : ℕ, weilEtaleTorsionTransition S ℓ r i (f (r + 1)) = f r := by
    intro f
    change f ∈ AddMonoidHom.ker _ ↔ _
    rw [AddMonoidHom.mem_ker, funext_iff]
    exact forall_congr' fun r => sub_eq_zero

  have hRatTmul : ∀ {W : Type u} [AddCommGroup W] [Module (Padic ℓ) W]
      (φ : TensorProduct ℤ ℚ ↥L_sub ≃+ W) (q : ℚ) (x : ↥L_sub),
      φ (TensorProduct.tmul ℤ q x) = (q : Padic ℓ) • φ (TensorProduct.tmul ℤ (1 : ℚ) x) := by
    intro W _ _ φ q x
    have hq : TensorProduct.tmul ℤ q x = q • TensorProduct.tmul ℤ (1 : ℚ) x := by
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    rw [hq]
    exact map_ratCast_smul φ ℚ (Padic ℓ) q (TensorProduct.tmul ℤ (1 : ℚ) x)

  let e₀ : M₁.V ≃+ M₂.V := M₁.equiv.symm.trans M₂.equiv
  have he₀_apply : ∀ t : TensorProduct ℤ ℚ ↥L_sub, e₀ (M₁.equiv t) = M₂.equiv t := by
    intro t
    dsimp [e₀]
    rw [AddEquiv.symm_apply_apply]

  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero

  have he₀_zsmul : ∀ (z : PadicInt ℓ) (x : ↥L_sub),
      e₀ ((z : Padic ℓ) • M₁.equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) =
        (z : Padic ℓ) • M₂.equiv (TensorProduct.tmul ℤ (1 : ℚ) x) := by
    intro z x
    have hy_mem : (fun r : ℕ => (PadicInt.toZModPow r z).val • x.1 r) ∈ L_sub := by
      rw [hL_mem]
      intro r
      letI : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hℓ_ne⟩
      let c : ZMod (ℓ ^ (r + 1)) := PadicInt.toZModPow (r + 1) z
      have hx_r : weilEtaleTorsionTransition S ℓ r i (x.1 (r + 1)) = x.1 r :=
        (hL_mem x.1).mp x.2 r
      rw [map_nsmul, hx_r]
      have hcast : PadicInt.toZModPow r z = (c.val : ZMod (ℓ ^ r)) :=
        (RingHom.congr_fun
          (PadicInt.zmod_cast_comp_toZModPow (p := ℓ) r (r + 1) (Nat.le_succ r)) z).symm.trans
          ((congrArg (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)))
            (ZMod.natCast_zmod_val c).symm).trans (map_natCast _ c.val))
      have hval : (PadicInt.toZModPow r z).val = c.val % (ℓ ^ r) := by
        rw [hcast, ZMod.val_natCast]
      have hdiv := (Nat.div_add_mod c.val (ℓ ^ r)).symm
      calc
        c.val • x.1 r = (ℓ ^ r * (c.val / ℓ ^ r) + c.val % ℓ ^ r) • x.1 r := by
          conv_lhs => rw [hdiv]
        _ = (c.val / ℓ ^ r) • ((ℓ ^ r) • x.1 r) + (PadicInt.toZModPow r z).val • x.1 r := by
          rw [add_nsmul, mul_nsmul, hval]
        _ = (PadicInt.toZModPow r z).val • x.1 r := by
          rw [hTors r (x.1 r), smul_zero, zero_add]
    let y : ↥L_sub := ⟨fun r => (PadicInt.toZModPow r z).val • x.1 r, hy_mem⟩
    rw [← M₁.hsmul z x y (fun _ => rfl), he₀_apply, M₂.hsmul z x y (fun _ => rfl)]

  have he₀_smul : ∀ (c : Padic ℓ) (v : M₁.V), e₀ (c • v) = c • e₀ v := by
    intro c v
    have hℓ_gt1 : (1 : ℝ) < (ℓ : ℝ) := Nat.one_lt_cast.mpr hPrime.one_lt
    obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ‖c‖ hℓ_gt1
    have hnorm_le : ‖((ℓ : Padic ℓ) ^ k * c)‖ ≤ 1 := by
      rw [norm_mul, norm_pow, Padic.norm_p]
      have hℓ_pos : (0 : ℝ) < (ℓ : ℝ) := by positivity
      calc
        ((ℓ : ℝ)⁻¹) ^ k * ‖c‖ ≤ ((ℓ : ℝ)⁻¹) ^ k * (ℓ : ℝ) ^ k :=
          mul_le_mul_of_nonneg_left hk.le (by positivity)
        _ = ((ℓ : ℝ)⁻¹ * (ℓ : ℝ)) ^ k := by rw [← mul_pow]
        _ = 1 := by rw [inv_mul_cancel₀ hℓ_pos.ne', one_pow]
    obtain ⟨z, hz_coe⟩ : ∃ z : PadicInt ℓ, (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * c :=
      ⟨⟨(ℓ : Padic ℓ) ^ k * c, hnorm_le⟩, rfl⟩
    have hℓ_padic_ne : (ℓ : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hℓ_ne
    have hpow_ne : (ℓ : Padic ℓ) ^ k ≠ 0 := pow_ne_zero k hℓ_padic_ne
    rw [← M₁.equiv.apply_symm_apply v]
    generalize M₁.equiv.symm v = t
    induction t using TensorProduct.induction_on with
    | zero =>
      rw [map_zero, smul_zero, map_zero, smul_zero]
    | tmul q x =>
      let q' : ℚ := q / (ℓ : ℚ) ^ k
      have hcq : c * (q : Padic ℓ) = (q' : Padic ℓ) * (z : Padic ℓ) := by
        dsimp [q']
        push_cast
        rw [hz_coe, div_eq_mul_inv]
        calc
          c * (q : Padic ℓ) = (q : Padic ℓ) * ((((ℓ : Padic ℓ) ^ k)⁻¹ * (ℓ : Padic ℓ) ^ k) * c) := by
            rw [inv_mul_cancel₀ hpow_ne, one_mul, mul_comm]
          _ = (q : Padic ℓ) * ((ℓ : Padic ℓ) ^ k)⁻¹ * ((ℓ : Padic ℓ) ^ k * c) := by ring
      calc
        e₀ (c • M₁.equiv (TensorProduct.tmul ℤ q x)) =
            e₀ (c • ((q : Padic ℓ) • M₁.equiv (TensorProduct.tmul ℤ (1 : ℚ) x))) := by
          rw [hRatTmul M₁.equiv q x]
        _ = e₀ (((q' : Padic ℓ) * (z : Padic ℓ)) • M₁.equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) := by
          rw [← mul_smul, hcq]
        _ = (q' : Padic ℓ) • e₀ ((z : Padic ℓ) • M₁.equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) := by
          rw [mul_smul, map_ratCast_smul e₀ (Padic ℓ) (Padic ℓ) q']
        _ = (q' : Padic ℓ) • ((z : Padic ℓ) • M₂.equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) := by
          rw [he₀_zsmul z x]
        _ = c • M₂.equiv (TensorProduct.tmul ℤ q x) := by
          rw [← mul_smul, ← hcq, mul_smul, ← hRatTmul M₂.equiv q x]
        _ = c • e₀ (M₁.equiv (TensorProduct.tmul ℤ q x)) := by
          rw [← he₀_apply]
    | add t₁ t₂ ih₁ ih₂ =>
      rw [map_add, smul_add, map_add, ih₁, ih₂, map_add, smul_add]

  let e : M₁.V ≃ₗ[Padic ℓ] M₂.V := { e₀ with map_smul' := he₀_smul }

  have he_frob : ∀ v : M₁.V, e (M₁.frob v) = M₂.frob (e v) := by
    intro v
    rw [← M₁.equiv.apply_symm_apply v]
    generalize M₁.equiv.symm v = t
    induction t using TensorProduct.induction_on with
    | zero =>
      rw [map_zero, map_zero, map_zero, map_zero]
    | tmul q x =>
      have hy_mem : (fun r : ℕ => M₁.frobTorsion r (x.1 r)) ∈ L_sub := by
        rw [hL_mem]
        intro r
        rw [hf_tr r (x.1 (r + 1)), (hL_mem x.1).mp x.2 r]
      let y : ↥L_sub := ⟨fun r => M₁.frobTorsion r (x.1 r), hy_mem⟩
      have hy₂ : ∀ r : ℕ, y.1 r = M₂.frobTorsion r (x.1 r) := by
        intro r
        rw [← hf_eq r]
      change e (M₁.frob (M₁.equiv (TensorProduct.tmul ℤ q x))) =
        M₂.frob (e₀ (M₁.equiv (TensorProduct.tmul ℤ q x)))
      rw [he₀_apply, hRatTmul M₁.equiv q x, hRatTmul M₂.equiv q x,
        map_smul, map_smul, map_smul, M₁.hfrob x y (fun _ => rfl)]
      change (q : Padic ℓ) • e₀ (M₁.equiv (TensorProduct.tmul ℤ (1 : ℚ) y)) =
        (q : Padic ℓ) • M₂.frob (M₂.equiv (TensorProduct.tmul ℤ (1 : ℚ) x))
      rw [he₀_apply, M₂.hfrob x y hy₂]
    | add t₁ t₂ ih₁ ih₂ =>
      rw [map_add, map_add, map_add, ih₁, ih₂, ← map_add, ← map_add]

  have hconj : e.conj M₁.frob = M₂.frob := by
    ext w
    rw [LinearEquiv.conj_apply]
    change e (M₁.frob (e.symm w)) = M₂.frob w
    rw [he_frob (e.symm w), e.apply_symm_apply]

  exact (LinearEquiv.charpoly_conj e M₁.frob).symm.trans (congrArg LinearMap.charpoly hconj)

theorem weil_etale_module_pullback_exists {S_src S_tgt : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom S_src S_tgt) (m i : ℕ) :
    ∃ pull : weilEtaleModuleH S_tgt m i →+ weilEtaleModuleH S_src m i,
      WeilIsModuleEtalePullback h m i pull :=
by
  let R_m : Type u := ULift.{u, 0} (ZMod m)
  let ModCat := ModuleCat.{u, u} R_m
  let OneMod := fun S : AlgebraicGeometry.Scheme.{u} => weilEtaleModuleUnit S m
  have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    ⟨fun _ _ => inferInstance⟩
  have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    ⟨fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg⟩
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let B : CategoryTheory.Functor S_tgt.Etale S_src.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
  let J_src := S_src.smallEtaleTopology
  let J_tgt := S_tgt.smallEtaleTopology
  let Fgt_src := AlgebraicGeometry.Scheme.Etale.forget S_src
  let Fgt_tgt := AlgebraicGeometry.Scheme.Etale.forget S_tgt

  
  have hLimOver : CategoryTheory.Limits.PreservesLimits (CategoryTheory.Over.pullback h) :=
    (CategoryTheory.Over.mapPullbackAdj h).rightAdjoint_preservesLimits
  have hLimComp : CategoryTheory.Limits.PreservesFiniteLimits (B ⋙ Fgt_src) := by
    change CategoryTheory.Limits.PreservesFiniteLimits (Fgt_tgt ⋙ CategoryTheory.Over.pullback h)
    exact CategoryTheory.Limits.comp_preservesFiniteLimits Fgt_tgt (CategoryTheory.Over.pullback h)
  have hLimB : CategoryTheory.Limits.PreservesFiniteLimits B :=
    CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves B Fgt_src
  have hFlatB : CategoryTheory.RepresentablyFlat B :=
    CategoryTheory.flat_of_preservesFiniteLimits B
  have hCovB : CategoryTheory.CoverPreserving J_tgt J_src B := by
    refine ⟨fun {V} R hR => ?_⟩
    change R ∈ S_tgt.smallGrothendieckTopology (@AlgebraicGeometry.Etale) V at hR
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S_tgt (le_refl (@AlgebraicGeometry.Etale))] at hR
    have hR' := (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology V R).mp hR
    change CategoryTheory.Sieve.functorPushforward B R ∈
      S_src.smallGrothendieckTopology (@AlgebraicGeometry.Etale) (B.obj V)
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S_src (le_refl (@AlgebraicGeometry.Etale))]
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (B.obj V) (CategoryTheory.Sieve.functorPushforward B R)).mpr fun x => ?_
    let fst_V : (B.obj V).left ⟶ V.left := CategoryTheory.Limits.pullback.fst V.hom h
    let snd_V : (B.obj V).left ⟶ S_src := CategoryTheory.Limits.pullback.snd V.hom h
    obtain ⟨Y, f, w, hfR, hEt_f, hw⟩ := hR' (fst_V.base x)
    let fst_Y : (B.obj Y).left ⟶ Y.left := CategoryTheory.Limits.pullback.fst Y.hom h
    have hmap_fst : (B.map f).left ≫ fst_V = fst_Y ≫ f.left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hmap_snd : (B.map f).left ≫ snd_V = CategoryTheory.Limits.pullback.snd Y.hom h :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPb_outer : CategoryTheory.IsPullback
        ((B.map f).left ≫ snd_V) fst_Y h (f.left ≫ V.hom) := by
      rw [hmap_snd, CategoryTheory.MorphismProperty.Over.w f]
      exact (CategoryTheory.IsPullback.of_hasPullback Y.hom h).flip
    have hPb_left : CategoryTheory.IsPullback (B.map f).left fst_Y fst_V f.left :=
      CategoryTheory.IsPullback.of_right hPb_outer hmap_fst
        (CategoryTheory.IsPullback.of_hasPullback V.hom h).flip
    have hEt_Bf : AlgebraicGeometry.Etale (B.map f).left :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_left.flip hEt_f
    obtain ⟨u, hu_x, _⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_left x w hw.symm
    exact ⟨B.obj Y, B.map f, u,
      CategoryTheory.Sieve.image_mem_functorPushforward B R hfR, hEt_Bf, hu_x⟩
  have hB : B.IsContinuous J_tgt J_src :=
    CategoryTheory.Functor.isContinuous_of_coverPreserving
      (CategoryTheory.compatiblePreservingOfFlat J_src B) hCovB

  
  let e_small := CategoryTheory.equivSmallModel.{u} S_tgt.AffineEtale
  let g₀ : CategoryTheory.SmallModel.{u} S_tgt.AffineEtale → S_tgt.Etale :=
    fun idx => CategoryTheory.MorphismProperty.Over.mk ⊤
      (e_small.inverse.obj idx).hom (e_small.inverse.obj idx).prop
  let Stage_data : ℕ → Σ (X : Type u), (X → S_tgt.Etale) :=
    Nat.rec
      ⟨PUnit.{u + 1} ⊕ CategoryTheory.SmallModel.{u} S_tgt.AffineEtale,
        Sum.elim (fun _ => ⊤_ S_tgt.Etale) g₀⟩
      (fun _ prev =>
        ⟨prev.1 ⊕ (Σ (a b c : prev.1) (_ : prev.2 a ⟶ prev.2 c), (prev.2 b ⟶ prev.2 c)),
          Sum.elim prev.2 (fun p => CategoryTheory.Limits.pullback p.2.2.2.1 p.2.2.2.2)⟩)
  let Idx : Type u := Σ n : ℕ, (Stage_data n).1
  let eval : Idx → S_tgt.Etale := fun p => (Stage_data p.1).2 p.2
  let D_tgt : Type u := CategoryTheory.InducedCategory S_tgt.Etale eval
  let G_tgt : CategoryTheory.Functor D_tgt S_tgt.Etale := CategoryTheory.inducedFunctor eval

  have lift_add : ∀ (n d : ℕ) (x : (Stage_data n).1),
      ∃ y : (Stage_data (n + d)).1, (Stage_data (n + d)).2 y = (Stage_data n).2 x := by
    intro n d x
    induction d with
    | zero => exact ⟨x, rfl⟩
    | succ d ih =>
      obtain ⟨y, hy⟩ := ih
      exact ⟨Sum.inl y, hy⟩
  have lift_le : ∀ {n N : ℕ} (_ : n ≤ N) (x : (Stage_data n).1),
      ∃ y : (Stage_data N).1, (Stage_data N).2 y = eval ⟨n, x⟩ := by
    intro n N hle x
    obtain ⟨d, rfl⟩ : ∃ d : ℕ, N = n + d := ⟨N - n, (Nat.add_sub_of_le hle).symm⟩
    exact lift_add n d x

  let t₀ : D_tgt := ⟨0, Sum.inl PUnit.unit⟩
  have ht₀ : CategoryTheory.Limits.IsTerminal t₀ :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun d => CategoryTheory.InducedCategory.homMk (CategoryTheory.Limits.terminal.from (eval d)))
      (fun _ _ => CategoryTheory.InducedCategory.hom_ext (CategoryTheory.Limits.terminal.hom_ext _ _))
  have hHasTermD : CategoryTheory.Limits.HasTerminal D_tgt := ht₀.hasTerminal
  have hMapTerm : CategoryTheory.Limits.IsLimit (G_tgt.mapCone (CategoryTheory.Limits.asEmptyCone t₀)) :=
    { lift := fun s => CategoryTheory.Limits.terminal.from s.pt
      fac := fun _ j => PEmpty.elim j.as
      uniq := fun _ _ _ => CategoryTheory.Limits.terminal.hom_ext _ _ }
  have hPresEmpty : CategoryTheory.Limits.PreservesLimit (CategoryTheory.Functor.empty D_tgt) G_tgt :=
    CategoryTheory.Limits.preservesLimit_of_preserves_limit_cone ht₀ hMapTerm
  have hPresTermG : CategoryTheory.Limits.PreservesLimitsOfShape (CategoryTheory.Discrete PEmpty.{1}) G_tgt :=
    CategoryTheory.Limits.preservesLimitsOfShape_pempty_of_preservesTerminal G_tgt

  have hCospan : ∀ (K_diag : CategoryTheory.Functor CategoryTheory.Limits.WalkingCospan D_tgt),
      ∃ (c : CategoryTheory.Limits.Cone K_diag),
        Nonempty (CategoryTheory.Limits.IsLimit c) ∧
        Nonempty (CategoryTheory.Limits.IsLimit (G_tgt.mapCone c)) := by
    intro K_diag
    let d₁ := K_diag.obj CategoryTheory.Limits.WalkingCospan.left
    let d₂ := K_diag.obj CategoryTheory.Limits.WalkingCospan.right
    let d₃ := K_diag.obj CategoryTheory.Limits.WalkingCospan.one
    let u := K_diag.map CategoryTheory.Limits.WalkingCospan.Hom.inl
    let v := K_diag.map CategoryTheory.Limits.WalkingCospan.Hom.inr
    obtain ⟨N, ⟨x₁, hx₁⟩, ⟨x₂, hx₂⟩, ⟨x₃, hx₃⟩⟩ :
        ∃ N : ℕ,
          (∃ x₁ : (Stage_data N).1, (Stage_data N).2 x₁ = G_tgt.obj d₁) ∧
          (∃ x₂ : (Stage_data N).1, (Stage_data N).2 x₂ = G_tgt.obj d₂) ∧
          (∃ x₃ : (Stage_data N).1, (Stage_data N).2 x₃ = G_tgt.obj d₃) :=
      ⟨max d₁.1 (max d₂.1 d₃.1),
        lift_le (Nat.le_max_left _ _) d₁.2,
        lift_le ((Nat.le_max_left _ _).trans (Nat.le_max_right _ _)) d₂.2,
        lift_le ((Nat.le_max_right _ _).trans (Nat.le_max_right _ _)) d₃.2⟩
    let Y₁ := (Stage_data N).2 x₁
    let Y₂ := (Stage_data N).2 x₂
    let Y₃ := (Stage_data N).2 x₃
    let g₁ : Y₁ ⟶ Y₃ := CategoryTheory.eqToHom hx₁ ≫ G_tgt.map u ≫ CategoryTheory.eqToHom hx₃.symm
    let g₂ : Y₂ ⟶ Y₃ := CategoryTheory.eqToHom hx₂ ≫ G_tgt.map v ≫ CategoryTheory.eqToHom hx₃.symm
    let pr₁_et : CategoryTheory.Limits.pullback g₁ g₂ ⟶ G_tgt.obj d₁ :=
      CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ CategoryTheory.eqToHom hx₁
    let pr₂_et : CategoryTheory.Limits.pullback g₁ g₂ ⟶ G_tgt.obj d₂ :=
      CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ CategoryTheory.eqToHom hx₂
    have hcond_et : pr₁_et ≫ G_tgt.map u = pr₂_et ≫ G_tgt.map v := by
      have hpb := CategoryTheory.Limits.pullback.condition (f := g₁) (g := g₂)
      dsimp only [g₁, g₂] at hpb
      have hpb' := congrArg (· ≫ CategoryTheory.eqToHom hx₃) hpb
      simp only [CategoryTheory.Category.assoc, CategoryTheory.eqToHom_trans,
        CategoryTheory.eqToHom_refl, CategoryTheory.Category.comp_id] at hpb'
      dsimp only [pr₁_et, pr₂_et]
      simpa only [CategoryTheory.Category.assoc] using hpb'
    let p_obj : D_tgt := ⟨N + 1, Sum.inr ⟨x₁, x₂, x₃, g₁, g₂⟩⟩
    let p₁ : p_obj ⟶ d₁ := CategoryTheory.InducedCategory.homMk pr₁_et
    let p₂ : p_obj ⟶ d₂ := CategoryTheory.InducedCategory.homMk pr₂_et
    have hcond_D : p₁ ≫ u = p₂ ≫ v := CategoryTheory.InducedCategory.hom_ext hcond_et
    let c₀ : CategoryTheory.Limits.PullbackCone u v :=
      CategoryTheory.Limits.PullbackCone.mk p₁ p₂ hcond_D
    have hlim_map : CategoryTheory.Limits.IsLimit (c₀.map G_tgt) := by
      refine CategoryTheory.Limits.PullbackCone.IsLimit.mk (c₀.map G_tgt).condition
        (fun s => CategoryTheory.Limits.pullback.lift
          (s.fst ≫ CategoryTheory.eqToHom hx₁.symm)
          (s.snd ≫ CategoryTheory.eqToHom hx₂.symm) ?_)
        (fun s => ?_) (fun s => ?_) (fun s m hm₁ hm₂ => ?_)
      · dsimp only [g₁, g₂]
        simp only [CategoryTheory.Category.assoc, CategoryTheory.eqToHom_trans_assoc,
          CategoryTheory.eqToHom_refl, CategoryTheory.Category.id_comp]
        rw [← CategoryTheory.Category.assoc s.fst, s.condition, CategoryTheory.Category.assoc]
      · change CategoryTheory.Limits.pullback.lift _ _ _ ≫ pr₁_et = s.fst
        dsimp only [pr₁_et]
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, CategoryTheory.eqToHom_trans,
          CategoryTheory.eqToHom_refl, CategoryTheory.Category.comp_id]
      · change CategoryTheory.Limits.pullback.lift _ _ _ ≫ pr₂_et = s.snd
        dsimp only [pr₂_et]
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc, CategoryTheory.eqToHom_trans,
          CategoryTheory.eqToHom_refl, CategoryTheory.Category.comp_id]
      · let m' : s.pt ⟶ CategoryTheory.Limits.pullback g₁ g₂ := m
        change m' = _
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Limits.pullback.lift_fst]
          have hm₁' : m' ≫ CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ CategoryTheory.eqToHom hx₁ = s.fst := hm₁
          have hm₁'' := congrArg (· ≫ CategoryTheory.eqToHom hx₁.symm) hm₁'
          simpa only [CategoryTheory.Category.assoc, CategoryTheory.eqToHom_trans,
            CategoryTheory.eqToHom_refl, CategoryTheory.Category.comp_id] using hm₁''
        · rw [CategoryTheory.Limits.pullback.lift_snd]
          have hm₂' : m' ≫ CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ CategoryTheory.eqToHom hx₂ = s.snd := hm₂
          have hm₂'' := congrArg (· ≫ CategoryTheory.eqToHom hx₂.symm) hm₂'
          simpa only [CategoryTheory.Category.assoc, CategoryTheory.eqToHom_trans,
            CategoryTheory.eqToHom_refl, CategoryTheory.Category.comp_id] using hm₂''
    have hGc₀ : CategoryTheory.Limits.IsLimit (G_tgt.mapCone c₀) :=
      (CategoryTheory.Limits.PullbackCone.isLimitMapConeEquiv c₀ G_tgt).symm hlim_map
    have hc₀ : CategoryTheory.Limits.IsLimit c₀ :=
      CategoryTheory.Limits.isLimitOfReflects G_tgt hGc₀
    let α_diag := CategoryTheory.Limits.diagramIsoCospan K_diag
    let c : CategoryTheory.Limits.Cone K_diag :=
      (CategoryTheory.Limits.Cone.postcompose α_diag.inv).obj c₀
    have hc : CategoryTheory.Limits.IsLimit c :=
      (CategoryTheory.Limits.IsLimit.postcomposeInvEquiv α_diag c₀).symm hc₀
    let α_G := CategoryTheory.Functor.isoWhiskerRight α_diag G_tgt
    have hGc_post : CategoryTheory.Limits.IsLimit
        ((CategoryTheory.Limits.Cone.postcompose α_G.inv).obj (G_tgt.mapCone c₀)) :=
      (CategoryTheory.Limits.IsLimit.postcomposeInvEquiv α_G (G_tgt.mapCone c₀)).symm hGc₀
    have hConeIso : (CategoryTheory.Limits.Cone.postcompose α_G.inv).obj (G_tgt.mapCone c₀) ≅
        G_tgt.mapCone c :=
      CategoryTheory.Limits.Cone.ext (CategoryTheory.Iso.refl _) (fun j => by
        dsimp [c, α_G]
        rw [CategoryTheory.Category.id_comp, G_tgt.map_comp])
    have hGc : CategoryTheory.Limits.IsLimit (G_tgt.mapCone c) :=
      CategoryTheory.Limits.IsLimit.ofIsoLimit hGc_post hConeIso
    exact ⟨c, ⟨hc⟩, ⟨hGc⟩⟩

  have hHasPbD : CategoryTheory.Limits.HasPullbacks D_tgt :=
    ⟨fun K_diag => let ⟨c, ⟨hc⟩, _⟩ := hCospan K_diag; CategoryTheory.Limits.HasLimit.mk ⟨c, hc⟩⟩
  have hPresPbG : CategoryTheory.Limits.PreservesLimitsOfShape
      CategoryTheory.Limits.WalkingCospan G_tgt :=
    ⟨fun {K_diag} =>
      let ⟨_, ⟨hc⟩, ⟨hGc⟩⟩ := hCospan K_diag
      CategoryTheory.Limits.preservesLimit_of_preserves_limit_cone hc hGc⟩
  have hHasFinLimD : CategoryTheory.Limits.HasFiniteLimits D_tgt :=
    CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
  have hPresFinLimG : CategoryTheory.Limits.PreservesFiniteLimits G_tgt :=
    CategoryTheory.Limits.preservesFiniteLimits_of_preservesTerminal_and_pullbacks G_tgt

  
  have hCoverDenseG : G_tgt.IsCoverDense J_tgt := by
    constructor
    intro U
    change CategoryTheory.Sieve.coverByImage G_tgt U ∈
      S_tgt.smallGrothendieckTopology (@AlgebraicGeometry.Etale) U
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S_tgt (le_refl (@AlgebraicGeometry.Etale))]
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      U (CategoryTheory.Sieve.coverByImage G_tgt U)).mpr fun y => ?_
    let X_U : AlgebraicGeometry.Scheme.{u} := U.left
    obtain ⟨_, ⟨V, hV, rfl⟩, hyV, _⟩ :=
      (AlgebraicGeometry.Scheme.isBasis_affineOpens X_U).exists_subset_of_mem_open
        (Set.mem_univ y) isOpen_univ
    have : AlgebraicGeometry.IsOpenImmersion hV.fromSpec := hV.isOpenImmersion_fromSpec
    rw [← hV.range_fromSpec] at hyV
    obtain ⟨z₀, hz₀⟩ := hyV
    let W_aff : S_tgt.AffineEtale :=
      { left := Opposite.op (X_U.presheaf.obj (Opposite.op V))
        right := ⟨PUnit.unit⟩
        hom := hV.fromSpec ≫ U.hom
        prop := inferInstance }
    let idx := e_small.functor.obj W_aff
    let isoW : e_small.inverse.obj idx ≅ W_aff := (e_small.unitIso.app W_aff).symm
    let α_left := isoW.hom.left
    let β_left := isoW.inv.left
    let s_hom : AlgebraicGeometry.Scheme.Spec.obj (e_small.inverse.obj idx).left ⟶
        AlgebraicGeometry.Spec (X_U.presheaf.obj (Opposite.op V)) :=
      AlgebraicGeometry.Scheme.Spec.map α_left
    let s_inv : AlgebraicGeometry.Spec (X_U.presheaf.obj (Opposite.op V)) ⟶
        AlgebraicGeometry.Scheme.Spec.obj (e_small.inverse.obj idx).left :=
      AlgebraicGeometry.Scheme.Spec.map β_left
    have hs_hom_inv : s_hom ≫ s_inv = 𝟙 _ := by
      dsimp only [s_hom, s_inv]
      rw [← AlgebraicGeometry.Scheme.Spec.map_comp]
      have hleft : α_left ≫ β_left = 𝟙 _ := congrArg (fun f => f.left) isoW.hom_inv_id
      rw [hleft, AlgebraicGeometry.Scheme.Spec.map_id]
    have hs_inv_hom : s_inv ≫ s_hom = 𝟙 _ := by
      dsimp only [s_hom, s_inv]
      rw [← AlgebraicGeometry.Scheme.Spec.map_comp]
      have hleft : β_left ≫ α_left = 𝟙 _ := congrArg (fun f => f.left) isoW.inv_hom_id
      rw [hleft, AlgebraicGeometry.Scheme.Spec.map_id]
      rfl
    have : CategoryTheory.IsIso s_hom := ⟨⟨s_inv, hs_hom_inv, hs_inv_hom⟩⟩
    have hw_over : (s_hom ≫ hV.fromSpec) ≫ U.hom = (e_small.inverse.obj idx).hom := by
      rw [CategoryTheory.Category.assoc]
      have hw : s_hom ≫ (hV.fromSpec ≫ U.hom) =
          (e_small.inverse.obj idx).hom ≫
            (CategoryTheory.Functor.fromPUnit S_tgt).map isoW.hom.right := isoW.hom.w
      have hright : isoW.hom.right = 𝟙 _ := Subsingleton.elim _ _
      rw [hright, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id] at hw
      exact hw
    let d_idx : D_tgt := ⟨0, Sum.inr idx⟩
    let u_et : G_tgt.obj d_idx ⟶ U :=
      CategoryTheory.MorphismProperty.Over.homMk (s_hom ≫ hV.fromSpec) hw_over
    have hu_mem : (CategoryTheory.Sieve.coverByImage G_tgt U).arrows u_et :=
      CategoryTheory.Presieve.in_coverByImage G_tgt u_et
    refine ⟨G_tgt.obj d_idx, u_et, s_inv.base z₀, hu_mem, inferInstance, ?_⟩
    change (s_inv ≫ s_hom ≫ hV.fromSpec).base z₀ = y
    rw [← CategoryTheory.Category.assoc, hs_inv_hom, CategoryTheory.Category.id_comp]
    exact hz₀

  have hDenseInd : CategoryTheory.Functor.IsDenseSubsite (G_tgt.inducedTopology J_tgt) J_tgt G_tgt :=
    inferInstance
  let K_tgt : CategoryTheory.GrothendieckTopology D_tgt := G_tgt.inducedTopology J_tgt
  have hDenseG : CategoryTheory.Functor.IsDenseSubsite K_tgt J_tgt G_tgt := hDenseInd
  let E_tgt := G_tgt.sheafPushforwardContinuous ModCat K_tgt J_tgt
  let eE_tgt : CategoryTheory.Sheaf J_tgt ModCat ≌ CategoryTheory.Sheaf K_tgt ModCat :=
    E_tgt.asEquivalence

  
  let F₀ : CategoryTheory.Functor D_tgt S_src.Etale := G_tgt ⋙ B
  have hContF₀ : F₀.IsContinuous K_tgt J_src :=
    CategoryTheory.Functor.isContinuous_comp G_tgt B K_tgt J_tgt J_src
  have hLimF₀ : CategoryTheory.Limits.PreservesFiniteLimits F₀ :=
    CategoryTheory.Limits.comp_preservesFiniteLimits G_tgt B
  have hFlatF₀ : CategoryTheory.RepresentablyFlat F₀ :=
    CategoryTheory.flat_of_preservesFiniteLimits F₀

  have hLanLim : CategoryTheory.Limits.PreservesFiniteLimits
      (F₀.op.lan : CategoryTheory.Functor (D_tgtᵒᵖ ⥤ ModCat) ((S_src.Etale)ᵒᵖ ⥤ ModCat)) := by
    refine ⟨fun J_fin _ _ => ?_⟩
    refine CategoryTheory.Limits.preservesLimitsOfShape_of_evaluation F₀.op.lan J_fin fun Y => ?_
    let U : S_src.Etale := Opposite.unop Y
    have : CategoryTheory.IsCofiltered (CategoryTheory.StructuredArrow U F₀) :=
      CategoryTheory.RepresentablyFlat.cofiltered U
    have : CategoryTheory.IsFiltered (CategoryTheory.StructuredArrow U F₀)ᵒᵖ :=
      CategoryTheory.isFiltered_op_of_isCofiltered (CategoryTheory.StructuredArrow U F₀)
    let e_arrow : (CategoryTheory.StructuredArrow U F₀)ᵒᵖ ≌
        CategoryTheory.CostructuredArrow F₀.op Y :=
      { functor :=
          { obj := fun X => CategoryTheory.CostructuredArrow.mk
              (Y := Opposite.op (Opposite.unop X).right) (Opposite.unop X).hom.op
            map := fun f => CategoryTheory.CostructuredArrow.homMk f.unop.right.op
              (Quiver.Hom.unop_inj (CategoryTheory.StructuredArrow.w f.unop)) }
        inverse :=
          { obj := fun Z => Opposite.op (CategoryTheory.StructuredArrow.mk Z.hom.unop)
            map := fun k => Opposite.op (CategoryTheory.StructuredArrow.homMk k.left.unop
              (Quiver.Hom.op_inj (CategoryTheory.CostructuredArrow.w k))) }
        unitIso := CategoryTheory.NatIso.ofComponents
          (fun X => CategoryTheory.Iso.op
            (CategoryTheory.StructuredArrow.isoMk (CategoryTheory.Iso.refl _)
              (by dsimp; rw [F₀.map_id, CategoryTheory.Category.comp_id])))
          (fun f => Quiver.Hom.unop_inj (by ext; dsimp; simp))
        counitIso := CategoryTheory.NatIso.ofComponents
          (fun Z => CategoryTheory.CostructuredArrow.isoMk (CategoryTheory.Iso.refl _)
            (by dsimp; rw [F₀.map_id, CategoryTheory.op_id, CategoryTheory.Category.id_comp]))
          (fun k => by ext; dsimp; simp) }
    have : CategoryTheory.IsFiltered (CategoryTheory.CostructuredArrow F₀.op Y) :=
      CategoryTheory.IsFiltered.of_equivalence e_arrow
    let Idx_Y := CategoryTheory.CostructuredArrow F₀.op Y
    have hColimPres : CategoryTheory.Limits.PreservesLimitsOfShape J_fin
        (CategoryTheory.Limits.colim (J := Idx_Y) (C := ModCat)) :=
      CategoryTheory.Limits.filtered_colim_preservesFiniteLimits
    let W_proj : CategoryTheory.Functor (D_tgtᵒᵖ ⥤ ModCat) (Idx_Y ⥤ ModCat) :=
      (CategoryTheory.Functor.whiskeringLeft Idx_Y D_tgtᵒᵖ ModCat).obj
        (CategoryTheory.CostructuredArrow.proj F₀.op Y)
    have hCompPres : CategoryTheory.Limits.PreservesLimitsOfShape J_fin
        (W_proj ⋙ CategoryTheory.Limits.colim) :=
      CategoryTheory.Limits.comp_preservesLimitsOfShape W_proj CategoryTheory.Limits.colim
    let iso_lan_symm : (W_proj ⋙ CategoryTheory.Limits.colim) ≅
        (F₀.op.lan ⋙ (CategoryTheory.evaluation (S_src.Etale)ᵒᵖ ModCat).obj Y) :=
      CategoryTheory.NatIso.ofComponents
        (fun P => (F₀.op.leftKanExtensionObjIsoColimit P Y).symm)
        (fun {P₁ P₂} α => by
          apply CategoryTheory.Limits.colimit.hom_ext
          intro j
          have h1 :
              CategoryTheory.Limits.colimit.ι (CategoryTheory.CostructuredArrow.proj F₀.op Y ⋙ P₁) j ≫
                (W_proj ⋙ CategoryTheory.Limits.colim).map α =
              α.app j.left ≫
                CategoryTheory.Limits.colimit.ι (CategoryTheory.CostructuredArrow.proj F₀.op Y ⋙ P₂) j := by
            dsimp [W_proj]
            exact CategoryTheory.Limits.ι_colimMap
              ((CategoryTheory.CostructuredArrow.proj F₀.op Y).whiskerLeft α) j
          have h2 := F₀.op.ι_leftKanExtensionObjIsoColimit_inv P₂ Y j
          have h3 := F₀.op.ι_leftKanExtensionObjIsoColimit_inv P₁ Y j
          have h4 : (F₀.op.leftKanExtension P₁).map j.hom ≫ (F₀.op.lan.map α).app Y =
              (F₀.op.lan.map α).app (F₀.op.obj j.left) ≫ (F₀.op.leftKanExtension P₂).map j.hom :=
            (F₀.op.lan.map α).naturality j.hom
          have h5 : α.app j.left ≫ (F₀.op.leftKanExtensionUnit P₂).app j.left =
              (F₀.op.leftKanExtensionUnit P₁).app j.left ≫ (F₀.op.lan.map α).app (F₀.op.obj j.left) :=
            congrArg (fun t => t.app j.left) (F₀.op.lanUnit.naturality α)
          exact (CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ (F₀.op.leftKanExtensionObjIsoColimit P₂ Y).inv) h1).trans
              ((CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (α.app j.left ≫ ·) h2).trans
                  ((CategoryTheory.Category.assoc _ _ _).symm.trans
                    ((congrArg (· ≫ (F₀.op.leftKanExtension P₂).map j.hom) h5).trans
                      ((CategoryTheory.Category.assoc _ _ _).trans
                        ((congrArg (_ ≫ ·) h4.symm).trans
                          ((CategoryTheory.Category.assoc _ _ _).symm.trans
                            (congrArg (· ≫ (F₀.op.lan.map α).app Y) h3.symm))))))))))
    exact CategoryTheory.Limits.preservesLimitsOfShape_of_natIso iso_lan_symm

  
  let P_F₀ := F₀.sheafPushforwardContinuous ModCat K_tgt J_src
  let adj_F₀ := F₀.sheafAdjunctionContinuous ModCat K_tgt J_src
  have hLimF₀Pull : CategoryTheory.Limits.PreservesFiniteLimits
      (F₀.sheafPullback ModCat K_tgt J_src) :=
    CategoryTheory.Functor.sheafPullbackConstruction.preservesFiniteLimits F₀ ModCat K_tgt J_src
  let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B ModCat _ J_tgt J_src hB
  let P_pull : CategoryTheory.Functor
      (CategoryTheory.Sheaf J_tgt ModCat) (CategoryTheory.Sheaf J_src ModCat) :=
    E_tgt ⋙ F₀.sheafPullback ModCat K_tgt J_src
  let iso_push : P_F₀ ⋙ eE_tgt.inverse ≅ P_push :=
    (CategoryTheory.Functor.isoWhiskerRight
      (CategoryTheory.Functor.sheafPushforwardContinuousComp G_tgt B ModCat K_tgt J_tgt J_src).symm
      eE_tgt.inverse) ≪≫
    CategoryTheory.Functor.associator P_push eE_tgt.functor eE_tgt.inverse ≪≫
    CategoryTheory.Functor.isoWhiskerLeft P_push eE_tgt.unitIso.symm ≪≫
    CategoryTheory.Functor.rightUnitor P_push
  let adj : P_pull ⊣ P_push :=
    (eE_tgt.toAdjunction.comp adj_F₀).ofNatIsoRight iso_push
  have hLim : CategoryTheory.Limits.PreservesFiniteLimits P_pull :=
    CategoryTheory.Limits.comp_preservesFiniteLimits E_tgt (F₀.sheafPullback ModCat K_tgt J_src)
  have : P_pull.IsLeftAdjoint := ⟨P_push, ⟨adj⟩⟩
  have hColim : CategoryTheory.Limits.PreservesFiniteColimits P_pull :=
    ⟨fun _ _ _ => inferInstance⟩
  have : P_push.Additive :=
    { map_add := CategoryTheory.ObjectProperty.hom_ext _ (CategoryTheory.NatTrans.ext (funext fun _ => rfl)) }
  have hAdd : P_pull.Additive := adj.left_adjoint_additive

  
  have hUnitMap : ∀ {S : AlgebraicGeometry.Scheme.{u}} {T T' : S.Etale}
      (hT : CategoryTheory.Limits.IsTerminal T) (hT' : CategoryTheory.Limits.IsTerminal T')
      (α : T' ⟶ T) (A : ModCat),
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology ModCat hT').unit.app A =
        (CategoryTheory.constantSheafAdj S.smallEtaleTopology ModCat hT).unit.app A ≫
          ((CategoryTheory.constantSheaf S.smallEtaleTopology ModCat).obj A).obj.map α.op := by
    intro S T T' hT hT' α A
    have hnat := (CategoryTheory.toSheafify S.smallEtaleTopology
      ((CategoryTheory.Functor.const (S.Etale)ᵒᵖ).obj A)).naturality α.op
    dsimp [CategoryTheory.constantSheafAdj, CategoryTheory.constantSheaf] at hnat ⊢
    simpa using hnat

  have hSymmMap : ∀ {S : AlgebraicGeometry.Scheme.{u}} {T T' : S.Etale}
      (hT : CategoryTheory.Limits.IsTerminal T) (hT' : CategoryTheory.Limits.IsTerminal T')
      (β : T' ⟶ T) (A : ModCat) (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology ModCat)
      (g : A ⟶ 𝒢.obj.obj (Opposite.op T)),
      ((CategoryTheory.constantSheafAdj S.smallEtaleTopology ModCat hT').homEquiv A 𝒢).symm
        (g ≫ 𝒢.obj.map β.op) =
      ((CategoryTheory.constantSheafAdj S.smallEtaleTopology ModCat hT).homEquiv A 𝒢).symm g := by
    intro S T T' hT hT' β A 𝒢 g
    let adjT := CategoryTheory.constantSheafAdj S.smallEtaleTopology ModCat hT
    let adjT' := CategoryTheory.constantSheafAdj S.smallEtaleTopology ModCat hT'
    apply (adjT'.homEquiv A 𝒢).injective
    rw [Equiv.apply_symm_apply]
    let k := (adjT.homEquiv A 𝒢).symm g
    change g ≫ 𝒢.obj.map β.op = (adjT'.homEquiv A 𝒢) k
    rw [CategoryTheory.Adjunction.homEquiv_unit]
    dsimp [CategoryTheory.sheafSections]
    rw [hUnitMap hT hT' β A, CategoryTheory.Category.assoc]
    have hk_nat : ((CategoryTheory.constantSheaf S.smallEtaleTopology ModCat).obj A).obj.map β.op ≫
        k.hom.app (Opposite.op T') = k.hom.app (Opposite.op T) ≫ 𝒢.obj.map β.op :=
      k.hom.naturality β.op
    rw [hk_nat, ← CategoryTheory.Category.assoc]
    have hk_eq : (adjT.unit.app A ≫ k.hom.app (Opposite.op T)) = g := by
      change (adjT.homEquiv A 𝒢) k = g
      exact Equiv.apply_symm_apply (adjT.homEquiv A 𝒢) g
    rw [hk_eq]

  let mk_eps : ∀ {T_tgt : S_tgt.Etale} (hT_tgt : CategoryTheory.Limits.IsTerminal T_tgt)
      {T_src : S_src.Etale} (hT_src : CategoryTheory.Limits.IsTerminal T_src),
      P_pull.obj (OneMod S_tgt) ⟶ OneMod S_src :=
    fun {T_tgt} hT_tgt {T_src} hT_src =>
      let adjMod_tgt := CategoryTheory.constantSheafAdj J_tgt ModCat hT_tgt
      let adjMod_src := CategoryTheory.constantSheafAdj J_src ModCat hT_src
      (adj.homEquiv (OneMod S_tgt) (OneMod S_src)).symm
        ((adjMod_tgt.homEquiv (ModuleCat.of R_m R_m) (P_push.obj (OneMod S_src))).symm
          (adjMod_src.unit.app (ModuleCat.of R_m R_m) ≫
            (OneMod S_src).obj.map (Opposite.op (hT_src.from (B.obj T_tgt)))))

  have hEps_indep : ∀ {T_tgt T'_tgt : S_tgt.Etale}
      (hT_tgt : CategoryTheory.Limits.IsTerminal T_tgt)
      (hT'_tgt : CategoryTheory.Limits.IsTerminal T'_tgt)
      {T_src T'_src : S_src.Etale}
      (hT_src : CategoryTheory.Limits.IsTerminal T_src)
      (hT'_src : CategoryTheory.Limits.IsTerminal T'_src),
      mk_eps hT_tgt hT_src = mk_eps hT'_tgt hT'_src := by
    intro T_tgt T'_tgt hT_tgt hT'_tgt T_src T'_src hT_src hT'_src
    let β : T'_tgt ⟶ T_tgt := hT_tgt.from T'_tgt
    let α : T'_src ⟶ T_src := hT_src.from T'_src
    let u₁ : ModuleCat.of R_m R_m ⟶ (OneMod S_src).obj.obj (Opposite.op (B.obj T_tgt)) :=
      (CategoryTheory.constantSheafAdj J_src ModCat hT_src).unit.app (ModuleCat.of R_m R_m) ≫
        (OneMod S_src).obj.map (hT_src.from (B.obj T_tgt)).op
    let u₂ : ModuleCat.of R_m R_m ⟶ (OneMod S_src).obj.obj (Opposite.op (B.obj T'_tgt)) :=
      (CategoryTheory.constantSheafAdj J_src ModCat hT'_src).unit.app (ModuleCat.of R_m R_m) ≫
        (OneMod S_src).obj.map (hT'_src.from (B.obj T'_tgt)).op
    have hu_eq : u₁ ≫ (OneMod S_src).obj.map (B.map β).op = u₂ := by
      dsimp only [u₁, u₂]
      have hcomm_term : B.map β ≫ hT_src.from (B.obj T_tgt) =
          hT'_src.from (B.obj T'_tgt) ≫ α := hT_src.hom_ext _ _
      rw [CategoryTheory.Category.assoc, ← (OneMod S_src).obj.map_comp, ← CategoryTheory.op_comp,
        hcomm_term, CategoryTheory.op_comp, (OneMod S_src).obj.map_comp,
        ← CategoryTheory.Category.assoc,
        ← hUnitMap hT_src hT'_src α (ModuleCat.of R_m R_m)]
    dsimp only [mk_eps]
    congr 1
    exact (hSymmMap hT_tgt hT'_tgt β (ModuleCat.of R_m R_m)
      (P_push.obj (OneMod S_src)) u₁).symm.trans (congrArg _ hu_eq)

  have hEps_iso : ∀ {T_tgt : S_tgt.Etale} (hT_tgt : CategoryTheory.Limits.IsTerminal T_tgt)
      {T_src : S_src.Etale} (hT_src : CategoryTheory.Limits.IsTerminal T_src),
      CategoryTheory.IsIso (mk_eps hT_tgt hT_src) := by
    intro T_tgt hT_tgt T_src hT_src
    have hBT_tgt : CategoryTheory.Limits.IsTerminal (B.obj T_tgt) :=
      CategoryTheory.Limits.IsTerminal.isTerminalObj B T_tgt hT_tgt
    let τ_iso : B.obj T_tgt ≅ T_src :=
      { hom := hT_src.from (B.obj T_tgt)
        inv := hBT_tgt.from T_src
        hom_inv_id := hBT_tgt.hom_ext _ _
        inv_hom_id := hT_src.hom_ext _ _ }
    let θ_τ : (CategoryTheory.sheafSections J_src ModCat).obj (Opposite.op T_src) ≅
        P_push ⋙ (CategoryTheory.sheafSections J_tgt ModCat).obj (Opposite.op T_tgt) :=
      CategoryTheory.NatIso.ofComponents
        (fun ℱ => ℱ.obj.mapIso τ_iso.op)
        (fun φ => (φ.hom.naturality τ_iso.hom.op).symm)
    let adjMod_tgt := CategoryTheory.constantSheafAdj J_tgt ModCat hT_tgt
    let adjMod_src := CategoryTheory.constantSheafAdj J_src ModCat hT_src
    let adj_comp := adjMod_tgt.comp adj
    let adj_alt := adjMod_src.ofNatIsoRight θ_τ
    let α_iso := adj_comp.leftAdjointUniq adj_alt
    have heq_eps : mk_eps hT_tgt hT_src = α_iso.hom.app (ModuleCat.of R_m R_m) := by
      apply (adj_comp.homEquiv (ModuleCat.of R_m R_m) (OneMod S_src)).injective
      rw [CategoryTheory.Adjunction.homEquiv_leftAdjointUniq_hom_app]
      have hlhs : (adj_comp.homEquiv (ModuleCat.of R_m R_m) (OneMod S_src)) (mk_eps hT_tgt hT_src) =
          adjMod_src.unit.app (ModuleCat.of R_m R_m) ≫
            (OneMod S_src).obj.map (Opposite.op (hT_src.from (B.obj T_tgt))) := by
        rw [CategoryTheory.Adjunction.comp_homEquiv]
        dsimp only [Equiv.trans_apply, mk_eps]
        rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        rfl
      rw [hlhs]
      rfl
    rw [heq_eps]
    infer_instance

  
  let T_tgt₀ : S_tgt.Etale := ⊤_ S_tgt.Etale
  let hT_tgt₀ : CategoryTheory.Limits.IsTerminal T_tgt₀ := CategoryTheory.Limits.terminalIsTerminal
  let T_src₀ : S_src.Etale := ⊤_ S_src.Etale
  let hT_src₀ : CategoryTheory.Limits.IsTerminal T_src₀ := CategoryTheory.Limits.terminalIsTerminal
  let ε₀ : P_pull.obj (OneMod S_tgt) ⟶ OneMod S_src := mk_eps hT_tgt₀ hT_src₀
  have : CategoryTheory.IsIso ε₀ := hEps_iso hT_tgt₀ hT_src₀
  let η₀ : OneMod S_src ⟶ P_pull.obj (OneMod S_tgt) := CategoryTheory.inv ε₀
  let pull : weilEtaleModuleH S_tgt m i →+ weilEtaleModuleH S_src m i :=
    ((CategoryTheory.Abelian.Ext.mk₀ η₀).precomp (OneMod S_src) (Nat.zero_add i)).comp
      (((CategoryTheory.Abelian.Ext.mk₀ ε₀).postcomp (P_pull.obj (OneMod S_tgt)) (Nat.add_zero i)).comp
        (P_pull.mapExtAddHom (OneMod S_tgt) (OneMod S_tgt) i))
  refine ⟨pull, hB, P_pull, adj, hAdd, hLim, hColim, ?_⟩
  intro T_tgt hT_tgt T_src hT_src
  have hε_eq : mk_eps hT_tgt hT_src = ε₀ := hEps_indep hT_tgt hT_tgt₀ hT_src hT_src₀
  refine ⟨η₀, ?_, ?_, ?_⟩
  · change mk_eps hT_tgt hT_src ≫ η₀ = 𝟙 _
    rw [hε_eq]
    exact CategoryTheory.IsIso.hom_inv_id ε₀
  · change η₀ ≫ mk_eps hT_tgt hT_src = 𝟙 _
    rw [hε_eq]
    exact CategoryTheory.IsIso.inv_hom_id ε₀
  · intro α
    dsimp [pull]
    rw [← hε_eq]
    rfl

theorem weil_etale_module_torsion_pullback_comm {S_src S_tgt : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom S_src S_tgt) (m i : ℕ)
    (pull : weilEtaleModuleH S_tgt m i →+ weilEtaleModuleH S_src m i)
    (p : weilEtaleTorsionH S_tgt m i →+ weilEtaleTorsionH S_src m i)
    (Θ_tgt : weilEtaleModuleH S_tgt m i →+ weilEtaleTorsionH S_tgt m i)
    (Θ_src : weilEtaleModuleH S_src m i →+ weilEtaleTorsionH S_src m i)
    (hPull : WeilIsModuleEtalePullback h m i pull)
    (hp : WeilIsTorsionEtalePullback h m i p)
    (hΘ_tgt : WeilIsModuleToTorsionComparison S_tgt m i Θ_tgt)
    (hΘ_src : WeilIsModuleToTorsionComparison S_src m i Θ_src)
    (α : weilEtaleModuleH S_tgt m i) :
    Θ_src (pull α) = p (Θ_tgt α) :=
by
  have hExtComp : ∀ {C D E : Type (u + 1)}
      [Category.{u + 1, u + 1} C] [Abelian C] [HasExt.{u} C] [EnoughInjectives C]
      [Category.{u + 1, u + 1} D] [Abelian D] [HasExt.{u} D]
      [Category.{u + 1, u + 1} E] [Abelian E] [HasExt.{u} E]
      (F : Functor C D) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
      (G : Functor D E) [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      (X Y : C) (k : ℕ) (x : Abelian.Ext X Y k),
      ((F.comp G).mapExtAddHom X Y k) x =
        (G.mapExtAddHom (F.obj X) (F.obj Y) k) ((F.mapExtAddHom X Y k) x) := by
    intro C D E _ _ _ _ _ _ _ _ _ _ F _ _ _ G _ _ _ X Y k x
    rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply]
    induction k generalizing Y with
    | zero =>
      have hx : Abelian.Ext.mk₀ (Abelian.Ext.addEquiv₀ x) = x := Abelian.Ext.addEquiv₀.left_inv x
      rw [← hx, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mapExactFunctor_mk₀]; rfl
    | succ k ih =>
      let I : C := Injective.under Y
      let ι : Y ⟶ I := Injective.ι Y
      let S : ShortComplex C := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hzero : x.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS x hzero rfl
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_comp, ih S.X₃ z,
        Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass,
        Abelian.Ext.mapExactFunctor_extClass]
  have hExtIso : ∀ {C D : Type (u + 1)}
      [Category.{u + 1, u + 1} C] [Abelian C] [HasExt.{u} C] [EnoughInjectives C]
      [Category.{u + 1, u + 1} D] [Abelian D] [HasExt.{u} D]
      (F G : Functor C D)
      [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
      [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      (η : F ≅ G) (X Y : C) (k : ℕ) (x : Abelian.Ext X Y k),
      (G.mapExtAddHom X Y k) x =
        (Abelian.Ext.mk₀ (η.inv.app X)).comp
          (((F.mapExtAddHom X Y k) x).comp
            (Abelian.Ext.mk₀ (η.hom.app Y)) (Nat.add_zero k))
          (Nat.zero_add k) := by
    intro C D _ _ _ _ _ _ _ F G _ _ _ _ _ _ η X Y k x
    rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply]
    induction k generalizing Y with
    | zero =>
      let f : X ⟶ Y := Abelian.Ext.addEquiv₀ x
      have hx : Abelian.Ext.mk₀ f = x := Abelian.Ext.addEquiv₀.left_inv x
      rw [← hx, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      rw [η.hom.naturality f, ← Category.assoc, η.inv_hom_id_app, Category.id_comp]
    | succ k ih =>
      let I : C := Injective.under Y
      let ι : Y ⟶ I := Injective.ι Y
      let S : ShortComplex C := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hzero : x.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS x hzero rfl
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        ih S.X₃ z, Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass]
      let φ : S.map F ⟶ S.map G :=
        { τ₁ := η.hom.app S.X₁, τ₂ := η.hom.app S.X₂, τ₃ := η.hom.app S.X₃
          comm₁₂ := (η.hom.naturality S.f).symm, comm₂₃ := (η.hom.naturality S.g).symm }
      have hnat := ShortComplex.ShortExact.extClass_naturality
        (hS.map_of_exact F) (hS.map_of_exact G) φ
      change (hS.map_of_exact F).extClass.comp (Abelian.Ext.mk₀ (η.hom.app Y)) (Nat.add_zero 1) =
        (Abelian.Ext.mk₀ (η.hom.app S.X₃)).comp (hS.map_of_exact G).extClass (Nat.zero_add 1) at hnat
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ rfl, hnat,
        ← Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ rfl,
        Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (η.inv.app X)) _ _
          (Nat.zero_add k) rfl (by omega)]
  have ext_conj_eq : ∀ {C : Type (u + 1)} [Category.{u + 1, u + 1} C]
      [Abelian C] [HasExt.{u} C] {W₁ W₂ W₃ Z₁ Z₂ Z₃ : C} {k : ℕ}
      (a : W₁ ⟶ W₂) (a' : W₂ ⟶ W₃) (b' : Z₁ ⟶ Z₂) (b : Z₂ ⟶ Z₃)
      (y : Abelian.Ext W₃ Z₁ k),
      ((Abelian.Ext.mk₀ a).comp
        (((Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (Nat.add_zero k))
          (Nat.zero_add k))) (Nat.zero_add k)).comp
        (Abelian.Ext.mk₀ b) (Nat.add_zero k) =
      (Abelian.Ext.mk₀ (a ≫ a')).comp (y.comp (Abelian.Ext.mk₀ (b' ≫ b)) (Nat.add_zero k))
        (Nat.zero_add k) := by
    intro C _ _ _ W₁ W₂ W₃ Z₁ Z₂ Z₃ k a a' b' b y
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add k),
      Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (a ≫ a')) _ _ (Nat.zero_add k) (Nat.add_zero k) (by omega),
      Abelian.Ext.comp_assoc_of_third_deg_zero y _ _ (Nat.add_zero k),
      Abelian.Ext.mk₀_comp_mk₀]
  have constantSheafAdj_unit_map : ∀ {A_cat : Type (u + 1)} [Category.{u, u + 1} A_cat]
      {S : Scheme.{u}} [HasWeakSheafify S.smallEtaleTopology A_cat]
      {T T' : S.Etale} (hT : Limits.IsTerminal T) (hT' : Limits.IsTerminal T')
      (α_t : T' ⟶ T) (A : A_cat),
      (constantSheafAdj S.smallEtaleTopology A_cat hT').unit.app A =
        (constantSheafAdj S.smallEtaleTopology A_cat hT).unit.app A ≫
          (((constantSheaf S.smallEtaleTopology A_cat).obj A).obj.map α_t.op) := by
    intro A_cat _ S _ T T' hT hT' α_t A
    have hnat := (toSheafify S.smallEtaleTopology ((Functor.const (S.Etale)ᵒᵖ).obj A)).naturality α_t.op
    dsimp [constantSheafAdj, constantSheaf] at hnat ⊢
    simpa using hnat
  have constantSheafAdj_homEquiv_symm_map : ∀ {A_cat : Type (u + 1)} [Category.{u, u + 1} A_cat]
      {S : Scheme.{u}} [HasWeakSheafify S.smallEtaleTopology A_cat]
      {T T' : S.Etale} (hT : Limits.IsTerminal T) (hT' : Limits.IsTerminal T')
      (β : T' ⟶ T) (A : A_cat)
      (𝒢 : Sheaf S.smallEtaleTopology A_cat)
      (g : A ⟶ 𝒢.obj.obj (Opposite.op T)),
      ((constantSheafAdj S.smallEtaleTopology A_cat hT').homEquiv A 𝒢).symm
        (g ≫ 𝒢.obj.map β.op) =
      ((constantSheafAdj S.smallEtaleTopology A_cat hT).homEquiv A 𝒢).symm g := by
    intro A_cat _ S _ T T' hT hT' β A 𝒢 g
    let adj := constantSheafAdj S.smallEtaleTopology A_cat hT
    let adj' := constantSheafAdj S.smallEtaleTopology A_cat hT'
    apply (adj'.homEquiv A 𝒢).injective
    rw [Equiv.apply_symm_apply, Adjunction.homEquiv_unit]
    let k := (adj.homEquiv A 𝒢).symm g
    change g ≫ 𝒢.obj.map β.op = adj'.unit.app A ≫ k.hom.app (Opposite.op T')
    rw [constantSheafAdj_unit_map hT hT' β A, Category.assoc, k.hom.naturality β.op, ← Category.assoc]
    have hk : adj.unit.app A ≫ k.hom.app (Opposite.op T) = g := by
      change (adj.homEquiv A 𝒢) k = g
      exact Equiv.apply_symm_apply _ g
    rw [hk]
  have hSheafComposeEq : ∀ (S : Scheme.{u})
      (U : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) ⥤
        Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      [S.smallEtaleTopology.HasSheafCompose
        (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u})]
      (_ : ∀ ℱ, (U.obj ℱ).obj =
        Functor.comp ℱ.obj
          (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}))
      (_ : ∀ {ℱ₁ ℱ₂} (u : ℱ₁ ⟶ ℱ₂) (W_op : (S.Etale)ᵒᵖ),
        HEq ((U.map u).hom.app W_op)
          ((CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}).map
            (u.hom.app W_op))),
      U = CategoryTheory.sheafCompose S.smallEtaleTopology
        (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}) := by
    intro S U _ hU_obj hU_map
    let J := S.smallEtaleTopology
    let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}
    let U₀ := CategoryTheory.sheafCompose J FgtMod
    have eqToHom_sheaf_app : ∀ {𝒜 ℬ : Sheaf J AddCommGrpCat.{u}} (h_eq : 𝒜 = ℬ) (W_op : (S.Etale)ᵒᵖ),
        (eqToHom h_eq).hom.app W_op = eqToHom (congrArg (fun X => X.obj.obj W_op) h_eq) := by
      intro 𝒜 ℬ h_eq W_op; cases h_eq; rfl
    have eqToHom_comp_heq : ∀ {X₁ X₂ Y₁ Y₂ : AddCommGrpCat.{u}}
        (hX : X₁ = X₂) (hY : Y₁ = Y₂) {f : X₁ ⟶ Y₁} {g : X₂ ⟶ Y₂},
        HEq f g → f = eqToHom hX ≫ g ≫ eqToHom hY.symm := by
      intro X₁ X₂ Y₁ Y₂ hX hY f g hfg
      subst hX; subst hY; cases hfg; simp
    have h_obj : ∀ ℱ, U.obj ℱ = U₀.obj ℱ := fun ℱ =>
      ObjectProperty.FullSubcategory.ext (hU_obj ℱ)
    refine CategoryTheory.Functor.ext h_obj fun ℱ₁ ℱ₂ u => ?_
    apply ObjectProperty.hom_ext
    refine NatTrans.ext (funext fun W_op => ?_)
    change (U.map u).hom.app W_op =
      (eqToHom (h_obj ℱ₁)).hom.app W_op ≫ FgtMod.map (u.hom.app W_op) ≫
        (eqToHom (h_obj ℱ₂).symm).hom.app W_op
    rw [eqToHom_sheaf_app, eqToHom_sheaf_app]
    exact eqToHom_comp_heq
      (congrArg (fun X => X.obj W_op) (hU_obj ℱ₁))
      (congrArg (fun X => X.obj W_op) (hU_obj ℱ₂))
      (hU_map u W_op)
  let R := ULift.{u, 0} (ZMod m)
  let ModCat := ModuleCat.{u, u} R
  let FgtMod := CategoryTheory.forget₂ ModCat AddCommGrpCat.{u}
  let J_src := S_src.smallEtaleTopology
  let J_tgt := S_tgt.smallEtaleTopology
  let B := weilEtaleSitePullback h
  have := ModuleCat.forget₂AddCommGroupIsEquivalence.{u}
  let eZ := (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
  let L_mod : AddCommGrpCat.{u} ⥤ ModCat :=
    eZ.inverse.comp (ModuleCat.extendScalars (Int.castRingHom R))
  let C_mod : AddCommGrpCat.{u} ⥤ ModCat :=
    eZ.inverse.comp (ModuleCat.coextendScalars (Int.castRingHom R))
  let adj_LF : L_mod ⊣ FgtMod :=
    eZ.symm.toAdjunction.comp (ModuleCat.extendRestrictScalarsAdj (Int.castRingHom R))
  let adj_FC : FgtMod ⊣ C_mod :=
    (ModuleCat.restrictCoextendScalarsAdj (Int.castRingHom R)).comp eZ.toAdjunction
  have : J_src.HasSheafCompose FgtMod :=
    @CategoryTheory.hasSheafCompose_of_preservesLimitsOfSize _ _ _ _ _ _ J_src FgtMod
      adj_LF.rightAdjoint_preservesLimits
  have : J_tgt.HasSheafCompose FgtMod :=
    @CategoryTheory.hasSheafCompose_of_preservesLimitsOfSize _ _ _ _ _ _ J_tgt FgtMod
      adj_LF.rightAdjoint_preservesLimits
  have : J_src.HasSheafCompose C_mod :=
    @CategoryTheory.hasSheafCompose_of_preservesLimitsOfSize _ _ _ _ _ _ J_src C_mod
      adj_FC.rightAdjoint_preservesLimits
  have : J_tgt.HasSheafCompose C_mod :=
    @CategoryTheory.hasSheafCompose_of_preservesLimitsOfSize _ _ _ _ _ _ J_tgt C_mod
      adj_FC.rightAdjoint_preservesLimits
  rcases hΘ_tgt with ⟨U_tgt, hU_tgt_obj, hU_tgt_map, hAdd_Utgt, hLim_Utgt, hColim_Utgt,
    T_tgt, hT_tgt, _, _, u_tgt, hu_tgt, βM_tgt, _, hβα_tgt, hΘ_tgt_eq⟩
  rcases hΘ_src with ⟨U_src, hU_src_obj, hU_src_map, hAdd_Usrc, hLim_Usrc, hColim_Usrc,
    T_src, hT_src, _, _, u_src, hu_src, βM_src, hαβ_src, _, hΘ_src_eq⟩
  have hU_tgt_eq : U_tgt = CategoryTheory.sheafCompose J_tgt FgtMod :=
    hSheafComposeEq S_tgt U_tgt hU_tgt_obj hU_tgt_map
  have hU_src_eq : U_src = CategoryTheory.sheafCompose J_src FgtMod :=
    hSheafComposeEq S_src U_src hU_src_obj hU_src_map
  subst hU_tgt_eq
  subst hU_src_eq
  have hu_tgt_eq : u_tgt = FgtMod.map ((constantSheafAdj J_tgt ModCat hT_tgt).unit.app (ModuleCat.of R R)) :=
    eq_of_heq hu_tgt
  have hu_src_eq : u_src = FgtMod.map ((constantSheafAdj J_src ModCat hT_src).unit.app (ModuleCat.of R R)) :=
    eq_of_heq hu_src
  subst hu_tgt_eq
  subst hu_src_eq
  have unpack_pull : ∃ (hB : B.IsContinuous J_tgt J_src),
      let P_push := @Functor.sheafPushforwardContinuous _ _ _ _ B ModCat _ J_tgt J_src hB
      ∃ (P_pull : Sheaf J_tgt ModCat ⥤ Sheaf J_src ModCat)
        (adj : P_pull ⊣ P_push)
        (hAdd : P_pull.Additive)
        (hLim : Limits.PreservesFiniteLimits P_pull)
        (hColim : Limits.PreservesFiniteColimits P_pull),
        ∀ (T_tgt : S_tgt.Etale) (hT_tgt : Limits.IsTerminal T_tgt)
          (T_src : S_src.Etale) (hT_src : Limits.IsTerminal T_src),
          let adjMod_tgt := constantSheafAdj J_tgt ModCat hT_tgt
          let adjMod_src := constantSheafAdj J_src ModCat hT_src
          let ε : P_pull.obj (weilEtaleModuleUnit S_tgt m) ⟶ weilEtaleModuleUnit S_src m :=
            (adj.homEquiv (weilEtaleModuleUnit S_tgt m) (weilEtaleModuleUnit S_src m)).symm
              ((adjMod_tgt.homEquiv (ModuleCat.of R R) (P_push.obj (weilEtaleModuleUnit S_src m))).symm
                (CategoryStruct.comp
                  (adjMod_src.unit.app (ModuleCat.of R R))
                  ((weilEtaleModuleUnit S_src m).obj.map (Opposite.op (hT_src.from (B.obj T_tgt))))))
          ∃ (η : weilEtaleModuleUnit S_src m ⟶ P_pull.obj (weilEtaleModuleUnit S_tgt m)),
            CategoryStruct.comp ε η = CategoryStruct.id _ ∧
            CategoryStruct.comp η ε = CategoryStruct.id _ ∧
            ∀ α : weilEtaleModuleH S_tgt m i,
              pull α = (Abelian.Ext.mk₀ η).comp
                (((@Functor.mapExtAddHom _ _ _ _ _ _ P_pull hAdd hLim hColim _ _
                  (weilEtaleModuleUnit S_tgt m) (weilEtaleModuleUnit S_tgt m) i) α).comp
                  (Abelian.Ext.mk₀ ε) (Nat.add_zero i)) (Nat.zero_add i) := hPull
  rcases unpack_pull with ⟨hB_R, P_pull_R, adj_R, hAdd_R, hLim_R, hColim_R, hPull_spec⟩
  obtain ⟨η_R, hεη_R, _, hpull_eq⟩ := hPull_spec T_tgt hT_tgt T_src hT_src
  have unpack_p : ∃ (hCont : B.IsContinuous J_tgt J_src)
      (hAdj : (B.sheafPushforwardContinuous AddCommGrpCat.{u} J_tgt J_src).IsRightAdjoint),
      let P_pull_Z := B.sheafPullback AddCommGrpCat.{u} J_tgt J_src
      let C₁ := constantSheaf J_src AddCommGrpCat.{u}
      let C₂ := constantSheaf J_tgt AddCommGrpCat.{u}
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
      ∃ (hAdd : P_pull_Z.Additive)
        (hLim : Limits.PreservesFiniteLimits P_pull_Z)
        (hColim : Limits.PreservesFiniteColimits P_pull_Z)
        (T₁ : S_src.Etale) (hT₁ : Limits.IsTerminal T₁)
        (T₂ : S_tgt.Etale) (hT₂ : Limits.IsTerminal T₂)
        (ιℤ : C₁.obj Aℤ ⟶ P_pull_Z.obj (C₂.obj Aℤ)),
        ιℤ ≫ @weilEtaleConstPullbackHom S_src S_tgt h hCont hAdj T₁ hT₁ T₂ hT₂ Aℤ =
          𝟙 (C₁.obj Aℤ) ∧
        @weilEtaleConstPullbackHom S_src S_tgt h hCont hAdj T₁ hT₁ T₂ hT₂ Aℤ ≫ ιℤ =
          𝟙 (P_pull_Z.obj (C₂.obj Aℤ)) ∧
        ∀ x : weilEtaleTorsionH S_tgt m i,
          p x = ((Abelian.Ext.mk₀ ιℤ).comp
            ((@Functor.mapExtAddHom _ _ _ _ _ _ P_pull_Z hAdd hLim hColim _ _
              (C₂.obj Aℤ) (C₂.obj AM) i) x)
            (Nat.zero_add i)).comp
            (Abelian.Ext.mk₀ (@weilEtaleConstPullbackHom S_src S_tgt h hCont hAdj T₁ hT₁ T₂ hT₂ AM))
            (Nat.add_zero i) := hp
  rcases unpack_p with ⟨hB_Z, hAdj_Z, hAdd_Z, hLim_Z, hColim_Z,
    T₁_Z, hT₁_Z, T₂_Z, hT₂_Z, ιℤ_h, hιπ_Z, _, hp_eq⟩
  cases Subsingleton.elim hB_Z hB_R
  have hConstIndep : ∀ {T₁ T'₁ : S_src.Etale} (hT₁ : Limits.IsTerminal T₁) (hT'₁ : Limits.IsTerminal T'₁)
      {T₂ T'₂ : S_tgt.Etale} (hT₂ : Limits.IsTerminal T₂) (hT'₂ : Limits.IsTerminal T'₂)
      (A : AddCommGrpCat.{u}),
      @weilEtaleConstPullbackHom S_src S_tgt h hB_R hAdj_Z T₁ hT₁ T₂ hT₂ A =
        @weilEtaleConstPullbackHom S_src S_tgt h hB_R hAdj_Z T'₁ hT'₁ T'₂ hT'₂ A := by
    intro T₁ T'₁ hT₁ hT'₁ T₂ T'₂ hT₂ hT'₂ A
    dsimp only [weilEtaleConstPullbackHom]
    congr 1
    let α_s : T'₁ ⟶ T₁ := hT₁.from T'₁
    let β_t : T'₂ ⟶ T₂ := hT₂.from T'₂
    rw [← constantSheafAdj_homEquiv_symm_map hT₂ hT'₂ β_t A]
    congr 1
    let C₁ := constantSheaf J_src AddCommGrpCat.{u}
    change ((constantSheafAdj J_src AddCommGrpCat.{u} hT₁).unit.app A ≫
        (C₁.obj A).obj.map (hT₁.from (B.obj T₂)).op) ≫
        (C₁.obj A).obj.map (B.map β_t).op =
      (constantSheafAdj J_src AddCommGrpCat.{u} hT'₁).unit.app A ≫
        (C₁.obj A).obj.map (hT'₁.from (B.obj T'₂)).op
    rw [Category.assoc, ← Functor.map_comp, ← op_comp,
      show B.map β_t ≫ hT₁.from (B.obj T₂) = hT'₁.from (B.obj T'₂) ≫ α_s from hT₁.hom_ext _ _,
      op_comp, Functor.map_comp, ← Category.assoc,
