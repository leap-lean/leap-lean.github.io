            (η₂.app W').hom ((AddCommGrpCat.adj.unit.app _) u_w)
          rw [← hu]
          exact hnat₁.trans ((congrArg (F.obj.map u_w.op).hom heq).trans hnat₂.symm)
        have hSecToHom_eval : ∀ (W : Z.Etale) (F : Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
