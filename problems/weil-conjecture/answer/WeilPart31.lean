            have : AlgebraicGeometry.Etale (G_aff.obj A₁.1).hom := (G_aff.obj A₁.1).prop
            have : AlgebraicGeometry.Etale (G_aff.obj A₂.1).hom := (G_aff.obj A₂.1).prop
            let h₁ := (G_aff.obj A₁.1).hom
            let Δ := CategoryTheory.Limits.pullback.diagonal h₁
            have : AlgebraicGeometry.IsOpenImmersion Δ :=
