        have hSheafG₁ := G₁.property Eℤ S_V₀ hS_V₀
        let amalg := hSheafG₁.amalgamate x_fam hx_compat
        have hamalg := hSheafG₁.isAmalgamation hx_compat
        let s₀ : ↥(G₁.obj.obj (Opposite.op V₀)) := amalg.hom (ULift.up 1)
        have hs₀_res : ∀ pt : PrimeSpectrum C₀,
            (G₁.obj.map (v_pt pt).op).hom s₀ = s_fam pt := by
          intro pt
          have hf_mem : S_V₀.arrows (v_pt pt) := Sieve.ofArrows_mk V_pt v_pt pt
