                exact hi hi_not
              exact lt_of_le_of_lt (Finset.card_le_card hsub) (Finset.card_erase_lt_of_mem hj)
            have hstep1 : ∀ i : Fin δ, i ≠ m → w i = w_mid i :=
              fun i hi => (Function.update_of_ne hi _ _).symm
            have hstep2 : ∀ i : Fin δ, i ≠ j → w_mid i = w' i :=
              fun i hi => (Function.update_of_ne hi _ _).symm
            exact h_prepend w w_mid m hw_det hstep1
              (h_prepend w_mid w' j hmid_det hstep2 (ih _ hw'_card w' rfl hw'_det))
        · rw [Finset.not_nonempty_iff_eq_empty] at hne
          have hw_eq : w = u₂ := by
            ext i
            by_contra hne_i
            have hmem : i ∈ dis w := by
              simp only [dis, Finset.mem_filter, Finset.mem_univ, true_and]
              exact hne_i
            rw [hne] at hmem
            exact Finset.notMem_empty i hmem
          refine ⟨0, fun _ => w, rfl, hw_eq, fun _ => hw_det, fun s => Fin.elim0 s⟩
    exact h_ind (dis u₁).card u₁ rfl hdet₁
  let _ : Algebra k A := (φ₁.comp MvPolynomial.C).toAlgebra
  obtain ⟨hSmooth, b₁, hb₁⟩ := h_s1 φ₁ rfl hEt₁
  have : Algebra.Smooth k A := hSmooth
  obtain ⟨_, b₂, hb₂⟩ := h_s1 φ₂ hC.symm hEt₂
  let u₁ : Fin δ → A := fun i => φ₁ (MvPolynomial.X i)
  let u₂ : Fin δ → A := fun i => φ₂ (MvPolynomial.X i)
  let detJ : (Fin δ → A) → A :=
    fun w => b₁.det (fun i => KaehlerDifferential.D k A (w i))
  have hUnit_u₁ : IsUnit (detJ u₁) := by
    have heq : (fun i : Fin δ => KaehlerDifferential.D k A (u₁ i)) = ⇑b₁ :=
      funext fun i => (hb₁ i).symm
    dsimp [detJ]
    rw [heq, Module.Basis.det_self]
    exact isUnit_one
  have hUnit_u₂ : IsUnit (detJ u₂) := by
    have heq : (fun i : Fin δ => KaehlerDifferential.D k A (u₂ i)) = ⇑b₂ :=
      funext fun i => (hb₂ i).symm
    dsimp [detJ]
    rw [heq]
    exact (b₁.is_basis_iff_det).mp ⟨b₂.linearIndependent, b₂.span_eq⟩
  let S_gen : Set A :=
    { f : A | ∃ (K : ℕ) (W : Fin (K + 1) → (Fin δ → A)),
        W 0 = u₁ ∧
        W (Fin.last K) = u₂ ∧
        (∀ s : Fin K, ∃ j : Fin δ, ∀ i : Fin δ, i ≠ j →
          W (Fin.castSucc s) i = W s.succ i) ∧
        f = ∏ s : Fin (K + 1), detJ (W s) }
  have hSpanTop : Ideal.span S_gen = ⊤ := by
    by_contra hNeTop
    obtain ⟨𝔪, h𝔪_max, hle⟩ := Ideal.exists_le_maximal (Ideal.span S_gen) hNeTop
    let _ : Field (A ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    let π : A →+* (A ⧸ 𝔪) := Ideal.Quotient.mk 𝔪
    let L_m : A →+ (Fin δ → (A ⧸ 𝔪)) :=
      AddMonoidHom.mk'
        (fun a r => π ((b₁.repr (KaehlerDifferential.D k A a)) r))
        (fun a₁ a₂ => by
          funext r
          simp only [map_add, Finsupp.coe_add, Pi.add_apply])
    have hL_det : ∀ w : Fin δ → A,
        (Matrix.of (fun r i : Fin δ => L_m (w i) r)).det = π (detJ w) := by
      intro w
      have hmat : Matrix.of (fun r i : Fin δ => L_m (w i) r) =
          π.mapMatrix (b₁.toMatrix (fun i : Fin δ => KaehlerDifferential.D k A (w i))) := by
        ext r i
        simp only [L_m, AddMonoidHom.mk'_apply, Matrix.of_apply, RingHom.mapMatrix_apply,
          Matrix.map_apply, Module.Basis.toMatrix_apply]
      rw [hmat, ← RingHom.map_det, ← Module.Basis.det_apply]
    have hdet₁_m : (Matrix.of (fun r i : Fin δ => L_m (u₁ i) r)).det ≠ 0 := by
      rw [hL_det]
      exact (hUnit_u₁.map π).ne_zero
    have hdet₂_m : (Matrix.of (fun r i : Fin δ => L_m (u₂ i) r)).det ≠ 0 := by
      rw [hL_det]
      exact (hUnit_u₂.map π).ne_zero
    obtain ⟨K_m, W_m, hW0, hWK, hWdet, hWstep⟩ :=
      h_s3 (A ⧸ 𝔪) L_m u₁ u₂ hdet₁_m hdet₂_m
    let f_m : A := ∏ s : Fin (K_m + 1), detJ (W_m s)
    have hfm_mem : f_m ∈ 𝔪 :=
      hle (Ideal.subset_span ⟨K_m, W_m, hW0, hWK, hWstep, rfl⟩)
    have hπ_zero : π f_m = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hfm_mem
    have hπ_ne : π f_m ≠ 0 := by
      dsimp [f_m]
      rw [map_prod]
      refine Finset.prod_ne_zero_iff.mpr fun s _ => ?_
      rw [← hL_det]
      exact hWdet s
    exact hπ_ne hπ_zero
  obtain ⟨s', hs'_sub, hs'_top⟩ := (Ideal.span_eq_top_iff_finite S_gen).mp hSpanTop
  let M : ℕ := Fintype.card ↥s'
  let e_fin : Fin M ≃ ↥s' := (Fintype.equivFin ↥s').symm
  let g : Fin M → A := fun a => (e_fin a).1
  have hrange_g : Set.range g = (↑s' : Set A) := by
    ext x
    simp only [Set.mem_range, Finset.mem_coe, g]
    constructor
    · rintro ⟨a, rfl⟩
      exact (e_fin a).2
    · intro hx
      exact ⟨e_fin.symm ⟨x, hx⟩, congrArg Subtype.val (e_fin.apply_symm_apply ⟨x, hx⟩)⟩
  refine ⟨M, g, ?_, ?_⟩
  · rw [hrange_g]
    exact hs'_top
  · intro a
    obtain ⟨K, W, hW0, hWK, hWstep, hg_eq⟩ := hs'_sub (e_fin a).2
    let S_a := Localization.Away (g a)
    let ψ : Fin (K + 1) → (MvPolynomial (Fin δ) k →+* S_a) :=
      fun s =>
        (MvPolynomial.aeval (R := k) (S₁ := S_a)
          (fun i : Fin δ => algebraMap A S_a (W s i))).toRingHom
    refine ⟨K, ψ, ?_, ?_, ?_, ?_⟩
    · apply MvPolynomial.ringHom_ext
      · intro c
        dsimp [ψ]
        rw [MvPolynomial.aeval_C, IsScalarTower.algebraMap_apply k A S_a]
        rfl
      · intro i
        dsimp [ψ]
        rw [MvPolynomial.aeval_X, hW0]
    · apply MvPolynomial.ringHom_ext
      · intro c
        dsimp [ψ]
        rw [MvPolynomial.aeval_C, IsScalarTower.algebraMap_apply k A S_a]
        change algebraMap A S_a ((φ₁.comp MvPolynomial.C) c) =
          algebraMap A S_a ((φ₂.comp MvPolynomial.C) c)
        rw [hC]
      · intro i
        dsimp [ψ]
        rw [MvPolynomial.aeval_X, hWK]
    · intro s
      refine ⟨?_, ?_⟩
      · ext c
        dsimp [ψ]
        rw [MvPolynomial.aeval_C, IsScalarTower.algebraMap_apply k A S_a]
        rfl
      · have hdvd_A : detJ (W s) ∣ g a := by
          change detJ (W s) ∣ (e_fin a).1
          rw [hg_eq]
          exact Finset.dvd_prod_of_mem _ (Finset.mem_univ s)
        have hdvd_S : algebraMap A S_a (detJ (W s)) ∣ algebraMap A S_a (g a) :=
          map_dvd (algebraMap A S_a) hdvd_A
        have hUnit_ga : IsUnit (algebraMap A S_a (g a)) :=
          IsLocalization.Away.algebraMap_isUnit (S := S_a) (g a)
        have hUnit_s : IsUnit (algebraMap A S_a (detJ (W s))) :=
          isUnit_of_dvd_unit hdvd_S hUnit_ga
        exact h_s2 b₁ (g a) S_a (W s) hUnit_s
    · intro s
      obtain ⟨j, hj⟩ := hWstep s
      refine ⟨j, fun i hi => ?_⟩
      dsimp [ψ]
      rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X, hj i hi]

theorem weil_cupPD_trace_affine_basicOpen_and_smooth_cover (k : Type u) [Field k] :
    (∀ (δ : ℕ) (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
      (u₁ u₂ : Quiver.Hom W (weilCupPDTraceAffineSpaceOver k δ).left),
      AlgebraicGeometry.Etale u₁ →
      AlgebraicGeometry.Etale u₂ →
      CategoryTheory.CategoryStruct.comp u₁ (weilCupPDTraceAffineSpaceOver k δ).hom =
        CategoryTheory.CategoryStruct.comp u₂ (weilCupPDTraceAffineSpaceOver k δ).hom →
      ∃ (φ₁ φ₂ : MvPolynomial (Fin δ) k →+* ↑(W.presheaf.obj (Opposite.op ⊤))),
        φ₁.comp MvPolynomial.C = φ₂.comp MvPolynomial.C ∧
        φ₁.Etale ∧
        φ₂.Etale ∧
        ∀ (M : ℕ) (g : Fin M → ↑(W.presheaf.obj (Opposite.op ⊤))),
          Ideal.span (Set.range g) = ⊤ →
          (∀ a : Fin M,
            ∃ (K : ℕ)
              (ψ : Fin (K + 1) →
                (MvPolynomial (Fin δ) k →+* Localization.Away (g a))),
              ψ 0 = (algebraMap _ (Localization.Away (g a))).comp φ₁ ∧
              ψ (Fin.last K) = (algebraMap _ (Localization.Away (g a))).comp φ₂ ∧
              (∀ s : Fin (K + 1),
                (ψ s).comp MvPolynomial.C =
                  ((algebraMap _ (Localization.Away (g a))).comp φ₁).comp MvPolynomial.C ∧
                (ψ s).Etale) ∧
              (∀ s : Fin K, ∃ j : Fin δ, ∀ i : Fin δ, i ≠ j →
                ψ (Fin.castSucc s) (MvPolynomial.X i) = ψ s.succ (MvPolynomial.X i))) →
          ∃ (V : Fin M → W.Opens),
            (⨆ a : Fin M, V a) = ⊤ ∧
            (∀ (I : Finset (Fin M)), I.Nonempty →
              AlgebraicGeometry.IsAffineOpen (⨅ a ∈ I, V a)) ∧
            ∀ a : Fin M,
              ∃ (K : ℕ)
                (w : Fin (K + 1) →
                  Quiver.Hom (V a).toScheme (weilCupPDTraceAffineSpaceOver k δ).left),
                w 0 = CategoryTheory.CategoryStruct.comp (V a).ι u₁ ∧
                w (Fin.last K) = CategoryTheory.CategoryStruct.comp (V a).ι u₂ ∧
                (∀ s : Fin (K + 1),
                  CategoryTheory.CategoryStruct.comp (w s)
                    (weilCupPDTraceAffineSpaceOver k δ).hom =
                    CategoryTheory.CategoryStruct.comp (V a).ι
                      (CategoryTheory.CategoryStruct.comp u₁
                        (weilCupPDTraceAffineSpaceOver k δ).hom) ∧
                  AlgebraicGeometry.Etale (w s)) ∧
                (∀ s : Fin K, ∃ j : Fin δ, ∀ i : Fin δ, i ≠ j →
                  let pr_i : Quiver.Hom (weilCupPDTraceAffineSpaceOver k δ).left
                      (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) :=
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                      (Polynomial.aeval (MvPolynomial.X i : MvPolynomial (Fin δ) k)).toRingHom)
                  CategoryTheory.CategoryStruct.comp (w (Fin.castSucc s)) pr_i =
                    CategoryTheory.CategoryStruct.comp (w s.succ) pr_i)) ∧
    (∀ (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsProper X.hom]
      (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom],
      ∃ (M : ℕ) (V : Fin M → X.left.Opens)
        (u : ∀ a : Fin M, Quiver.Hom (V a).toScheme (weilCupPDTraceAffineSpaceOver k d).left),
        (⨆ a : Fin M, V a) = ⊤ ∧
        (∀ a : Fin M, AlgebraicGeometry.IsAffineOpen (V a)) ∧
        (∀ a : Fin M,
          AlgebraicGeometry.Etale (u a) ∧
          CategoryTheory.CategoryStruct.comp (u a) (weilCupPDTraceAffineSpaceOver k d).hom =
            CategoryTheory.CategoryStruct.comp (V a).ι X.hom) ∧
        (∀ (I : Finset (Fin M)), I.Nonempty →
          AlgebraicGeometry.IsAffineOpen (⨅ a ∈ I, V a)) ∧
        (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
          (p : Quiver.Hom W X.left) (I : Finset (Fin M)),
          I.Nonempty →
          AlgebraicGeometry.IsAffineOpen
            ((TopologicalSpace.Opens.map p.base).obj (⨅ a ∈ I, V a)))) :=
by
  constructor
  · intro δ W _ u₁ u₂ hu₁ hu₂ hu₁₂_hom
    dsimp [weilCupPDTraceAffineSpaceOver] at u₁ u₂ hu₁ hu₂ hu₁₂_hom ⊢
    let P_obj := CommRingCat.of (MvPolynomial (Fin δ) k)
    let R_obj := W.presheaf.obj (Opposite.op ⊤)
    let c_hom : CommRingCat.of k ⟶ P_obj :=
      CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin δ) k)
    let φ₁_cat : P_obj ⟶ R_obj := AlgebraicGeometry.Spec.preimage (W.isoSpec.inv ≫ u₁)
    let φ₂_cat : P_obj ⟶ R_obj := AlgebraicGeometry.Spec.preimage (W.isoSpec.inv ≫ u₂)
    let φ₁ : MvPolynomial (Fin δ) k →+* ↑R_obj := φ₁_cat.hom
    let φ₂ : MvPolynomial (Fin δ) k →+* ↑R_obj := φ₂_cat.hom
    have hSpec_φ₁ : AlgebraicGeometry.Spec.map φ₁_cat = W.isoSpec.inv ≫ u₁ :=
      AlgebraicGeometry.Spec.map_preimage (W.isoSpec.inv ≫ u₁)
    have hSpec_φ₂ : AlgebraicGeometry.Spec.map φ₂_cat = W.isoSpec.inv ≫ u₂ :=
      AlgebraicGeometry.Spec.map_preimage (W.isoSpec.inv ≫ u₂)
    have hu₁_rec : W.toSpecΓ ≫ AlgebraicGeometry.Spec.map φ₁_cat = u₁ := by
      rw [hSpec_φ₁, ← W.isoSpec_hom, ← CategoryTheory.Category.assoc,
        W.isoSpec.hom_inv_id, CategoryTheory.Category.id_comp]
    have hu₂_rec : W.toSpecΓ ≫ AlgebraicGeometry.Spec.map φ₂_cat = u₂ := by
      rw [hSpec_φ₂, ← W.isoSpec_hom, ← CategoryTheory.Category.assoc,
        W.isoSpec.hom_inv_id, CategoryTheory.Category.id_comp]
    have hC : φ₁.comp MvPolynomial.C = φ₂.comp MvPolynomial.C := by
      have hSpec_eq : AlgebraicGeometry.Spec.map (c_hom ≫ φ₁_cat) =
          AlgebraicGeometry.Spec.map (c_hom ≫ φ₂_cat) := by
        calc
          AlgebraicGeometry.Spec.map (c_hom ≫ φ₁_cat)
              = AlgebraicGeometry.Spec.map φ₁_cat ≫ AlgebraicGeometry.Spec.map c_hom :=
                AlgebraicGeometry.Spec.map_comp c_hom φ₁_cat
          _ = (W.isoSpec.inv ≫ u₁) ≫ AlgebraicGeometry.Spec.map c_hom := by rw [hSpec_φ₁]
          _ = W.isoSpec.inv ≫ (u₁ ≫ AlgebraicGeometry.Spec.map c_hom) :=
                CategoryTheory.Category.assoc _ _ _
          _ = W.isoSpec.inv ≫ (u₂ ≫ AlgebraicGeometry.Spec.map c_hom) := by rw [hu₁₂_hom]
          _ = (W.isoSpec.inv ≫ u₂) ≫ AlgebraicGeometry.Spec.map c_hom :=
                (CategoryTheory.Category.assoc _ _ _).symm
          _ = AlgebraicGeometry.Spec.map φ₂_cat ≫ AlgebraicGeometry.Spec.map c_hom := by
                rw [hSpec_φ₂]
          _ = AlgebraicGeometry.Spec.map (c_hom ≫ φ₂_cat) :=
                (AlgebraicGeometry.Spec.map_comp c_hom φ₂_cat).symm
      have hcat_eq : c_hom ≫ φ₁_cat = c_hom ≫ φ₂_cat :=
        AlgebraicGeometry.Spec.map_injective hSpec_eq
      exact congrArg CommRingCat.Hom.hom hcat_eq
    have hEt_inv : AlgebraicGeometry.Etale W.isoSpec.inv := inferInstance
    have hEt₁ : φ₁.Etale := by
      have h1 : AlgebraicGeometry.Etale (W.isoSpec.inv ≫ u₁) := by
        have := hEt_inv
        have := hu₁
        infer_instance
      rw [← hSpec_φ₁] at h1
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp h1
    have hEt₂ : φ₂.Etale := by
      have h2 : AlgebraicGeometry.Etale (W.isoSpec.inv ≫ u₂) := by
        have := hEt_inv
        have := hu₂
        infer_instance
      rw [← hSpec_φ₂] at h2
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp h2
    refine ⟨φ₁, φ₂, hC, hEt₁, hEt₂, ?_⟩
    intro M g hg_span hChains
    let V : Fin M → W.Opens := fun a => W.basicOpen (g a)
    have hTop : AlgebraicGeometry.IsAffineOpen (⊤ : W.Opens) :=
      AlgebraicGeometry.isAffineOpen_top W
    have hV_sup : (⨆ a : Fin M, V a) = ⊤ := by
      have h1 := AlgebraicGeometry.iSup_basicOpen_of_span_eq_top (⊤ : W.Opens) (Set.range g) hg_span
      refine le_antisymm le_top ?_
      rw [← h1]
      exact iSup₂_le fun x ⟨a, ha⟩ => ha ▸ le_iSup V a
    have hbiInf_insert : ∀ (b : Fin M) (J : Finset (Fin M)),
        (⨅ a ∈ insert b J, V a) = V b ⊓ (⨅ a ∈ J, V a) := by
      intro b J
      exact le_antisymm
        (le_inf (iInf₂_le b (Finset.mem_insert_self b J))
          (le_iInf₂ fun a ha => iInf₂_le a (Finset.mem_insert_of_mem ha)))
        (le_iInf₂ fun a ha => by
          rcases Finset.mem_insert.mp ha with rfl | ha
          · exact inf_le_left
          · exact inf_le_right.trans (iInf₂_le a ha))
    have hV_prod_eq : ∀ I : Finset (Fin M), (⨅ a ∈ I, V a) = W.basicOpen (∏ a ∈ I, g a) := by
      intro I
      induction I using Finset.induction_on with
      | empty =>
        have hemp : (⨅ a ∈ (∅ : Finset (Fin M)), V a) = ⊤ :=
          le_antisymm le_top (le_iInf₂ fun _ h => False.elim (Finset.notMem_empty _ h))
        rw [hemp, Finset.prod_empty, AlgebraicGeometry.Scheme.basicOpen_one]
      | @insert b J hb ih =>
        rw [hbiInf_insert b J, ih, ← W.basicOpen_mul, Finset.prod_insert hb]
    have hV_inter : ∀ (I : Finset (Fin M)), I.Nonempty →
        AlgebraicGeometry.IsAffineOpen (⨅ a ∈ I, V a) := by
      intro I _
      rw [hV_prod_eq I]
      exact hTop.basicOpen (∏ a ∈ I, g a)
    refine ⟨V, hV_sup, hV_inter, ?_⟩
    intro a
    obtain ⟨K, ψ, hψ0, hψK, hψC_et, hψ_step⟩ := hChains a
    let R_Va_obj := W.presheaf.obj (Opposite.op (V a))
    have hVa : AlgebraicGeometry.IsAffineOpen (V a) := hTop.basicOpen (g a)
    let e_loc : Localization.Away (g a) ≃ₐ[↑R_obj] ↑R_Va_obj :=
      IsLocalization.algEquiv (Submonoid.powers (g a)) (Localization.Away (g a)) ↑R_Va_obj
    let ψ'_cat : Fin (K + 1) → (P_obj ⟶ R_Va_obj) :=
      fun s => CommRingCat.ofHom (e_loc.toRingHom.comp (ψ s))
    let w : Fin (K + 1) → ((V a).toScheme ⟶ AlgebraicGeometry.Spec P_obj) :=
      fun s => (V a).toSpecΓ ≫ AlgebraicGeometry.Spec.map (ψ'_cat s)
    have hw0 : w 0 = (V a).ι ≫ u₁ := by
      have h0_cat : ψ'_cat 0 =
          φ₁_cat ≫ W.presheaf.map (CategoryTheory.homOfLE (le_top : V a ≤ ⊤)).op := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        change e_loc (ψ 0 p) =
          (W.presheaf.map (CategoryTheory.homOfLE (le_top : V a ≤ ⊤)).op).hom (φ₁ p)
        rw [hψ0, RingHom.comp_apply]
        exact e_loc.commutes (φ₁ p)
      dsimp [w]
      rw [h0_cat, AlgebraicGeometry.Spec.map_comp,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_top_assoc (V a)
          (AlgebraicGeometry.Spec.map φ₁_cat),
        hu₁_rec]
    have hwK : w (Fin.last K) = (V a).ι ≫ u₂ := by
      have hK_cat : ψ'_cat (Fin.last K) =
          φ₂_cat ≫ W.presheaf.map (CategoryTheory.homOfLE (le_top : V a ≤ ⊤)).op := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        change e_loc (ψ (Fin.last K) p) =
          (W.presheaf.map (CategoryTheory.homOfLE (le_top : V a ≤ ⊤)).op).hom (φ₂ p)
        rw [hψK, RingHom.comp_apply]
        exact e_loc.commutes (φ₂ p)
      dsimp [w]
      rw [hK_cat, AlgebraicGeometry.Spec.map_comp,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_top_assoc (V a)
          (AlgebraicGeometry.Spec.map φ₂_cat),
        hu₂_rec]
    have hIso_Va : CategoryTheory.IsIso (V a).toSpecΓ := by
      rw [← hVa.isoSpec_hom]
      infer_instance
    have hEt_Va : AlgebraicGeometry.Etale (V a).toSpecΓ := by
      have := hIso_Va
      infer_instance
    have he_et : e_loc.toRingHom.Etale :=
      RingHom.Etale.of_bijective e_loc.bijective
    refine ⟨K, w, hw0, hwK, ?_, ?_⟩
    · intro s
      refine ⟨?_, ?_⟩
      · have hs_c : c_hom ≫ ψ'_cat s = c_hom ≫ ψ'_cat 0 := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro c
          change e_loc (((ψ s).comp MvPolynomial.C) c) =
            e_loc (((ψ 0).comp MvPolynomial.C) c)
          rw [(hψC_et s).1, hψ0]
        calc
          w s ≫ AlgebraicGeometry.Spec.map c_hom
              = (V a).toSpecΓ ≫ (AlgebraicGeometry.Spec.map (ψ'_cat s) ≫
                  AlgebraicGeometry.Spec.map c_hom) := CategoryTheory.Category.assoc _ _ _
          _ = (V a).toSpecΓ ≫ AlgebraicGeometry.Spec.map (c_hom ≫ ψ'_cat s) := by
                rw [← AlgebraicGeometry.Spec.map_comp]
          _ = (V a).toSpecΓ ≫ AlgebraicGeometry.Spec.map (c_hom ≫ ψ'_cat 0) := by
                rw [hs_c]
          _ = (V a).toSpecΓ ≫ (AlgebraicGeometry.Spec.map (ψ'_cat 0) ≫
                AlgebraicGeometry.Spec.map c_hom) := by
                rw [AlgebraicGeometry.Spec.map_comp]
