        ∃ L : M →ₗ[R] R, ∀ x : M, (L x).down = φ₀ x := by
      intro M _ _ φ₀
      refine ⟨
        { toFun := fun x => ULift.up (φ₀ x)
          map_add' := fun x y => by
            apply ULift.ext
            exact φ₀.map_add x y
          map_smul' := fun r x => by
            apply ULift.ext
            change φ₀ (r • x) = r.down * φ₀ x
            have hr : ((r.down.val : ℕ) : R) = r := by
              apply ULift.ext
              exact ZMod.natCast_zmod_val r.down
            have hsmul : r • x = r.down.val • x := by
              rw [← Nat.cast_smul_eq_nsmul R r.down.val x, hr]
            rw [hsmul, map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val] },
        fun _ => rfl⟩
