              let g := g_op.unop
              let δ₁ : { d : Quiver.Hom S_Ω opW₁.unop.left //
                  CategoryTheory.CategoryStruct.comp d opW₁.unop.hom = ξ } :=
                ⟨CategoryTheory.CategoryStruct.comp δ₂.1 g.left,
                  (CategoryTheory.Category.assoc δ₂.1 g.left _).trans
                    ((congrArg (CategoryTheory.CategoryStruct.comp δ₂.1)
                      (CategoryTheory.MorphismProperty.Over.w g)).trans δ₂.2)⟩
              have hfac_comp : CategoryTheory.CategoryStruct.comp (A_W opW₂.unop δ₂).2.1
                  (CategoryTheory.CategoryStruct.comp (v_W opW₂.unop δ₂) g).left = δ₁.1 :=
                (CategoryTheory.Category.assoc (A_W opW₂.unop δ₂).2.1
                  (v_W opW₂.unop δ₂).left g.left).symm.trans
                  (congrArg (fun k => CategoryTheory.CategoryStruct.comp k g.left)
                    (hv_W opW₂.unop δ₂))
              have hind := hIndep opW₁.unop δ₁
                (A_W opW₂.unop δ₂) (A_W opW₁.unop δ₁)
                (CategoryTheory.CategoryStruct.comp (v_W opW₂.unop δ₂) g) hfac_comp
                (v_W opW₁.unop δ₁) (hv_W opW₁.unop δ₁) s
              have hcomp_s : (ℱ₂.obj.map (v_W opW₂.unop δ₂).op).hom
                  ((ℱ₂.obj.map g_op).hom s) =
                (ℱ₂.obj.map (CategoryTheory.CategoryStruct.comp (v_W opW₂.unop δ₂) g).op).hom s :=
                congrArg (fun m => m.hom s)
                  ((ℱ₂.obj.map_comp g_op (v_W opW₂.unop δ₂).op).symm.trans
                    (congrArg ℱ₂.obj.map
                      (CategoryTheory.op_comp (f := v_W opW₂.unop δ₂) (g := g)).symm))
              exact (congrArg (CategoryTheory.Limits.colimit.ι D_stalk (A_W opW₂.unop δ₂)).hom
                hcomp_s).trans hind) }
      have hu_η₂ : CategoryTheory.CategoryStruct.comp u η₂ = 0 :=
        hZeroSky Ω ξ M_stalk hS_stalk η₂
      have hev₀ : ((CategoryTheory.CategoryStruct.comp u η₂).hom.app (Opposite.op W₀)).hom
          s₀ ⟨δ₀, rfl⟩ = 0 := by
        rw [hu_η₂]
        rfl
      have hev₀' : (CategoryTheory.Limits.colimit.ι D_stalk A₀).hom
          ((ℱ₂.obj.map v₀.op).hom x₂) =
        (CategoryTheory.Limits.colimit.ι D_stalk A₀).hom 0 := by
        rw [map_zero]
        exact (hIndep W₀ ⟨δ₀, rfl⟩ A₀ (A_W W₀ ⟨δ₀, rfl⟩)
          v₀ hv₀_fac (v_W W₀ ⟨δ₀, rfl⟩) (hv_W W₀ ⟨δ₀, rfl⟩) x₂).trans hev₀
      obtain ⟨A₁, m₁, m₂, hm_zero⟩ :=
        (CategoryTheory.Limits.Concrete.colimit_rep_eq_iff_exists D_stalk
          ((ℱ₂.obj.map v₀.op).hom x₂) (0 : ↥(D_stalk.obj A₀))).mp hev₀'
      have hm₂_zero : (CategoryTheory.ConcreteCategory.hom (D_stalk.map m₂))
          (0 : ↥(D_stalk.obj A₀)) = 0 := map_zero (D_stalk.map m₂).hom
      rw [hm₂_zero] at hm_zero
      let v_tot : Quiver.Hom (G_aff.obj A₁.1) W₀ :=
        CategoryTheory.CategoryStruct.comp m₁.1 v₀
      refine ⟨G_aff.obj A₁.1, v_tot, A₁.2.1 (⊥ : PrimeSpectrum Ω), ?_, ?_⟩
      · have hfac_tot : CategoryTheory.CategoryStruct.comp A₁.2.1 v_tot.left = δ₀ :=
          (CategoryTheory.Category.assoc A₁.2.1 m₁.1.left v₀.left).symm.trans
            ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k v₀.left) m₁.2).trans hv₀_fac)
        have hpt := congrArg (fun k : Quiver.Hom S_Ω W₀.left => k (⊥ : PrimeSpectrum Ω)) hfac_tot
        exact hpt.trans hδ₀_pt
      · exact (congrArg (fun m => m.hom x₂)
          ((congrArg ℱ₂.obj.map (CategoryTheory.op_comp (f := m₁.1) (g := v₀))).trans
            (ℱ₂.obj.map_comp v₀.op m₁.1.op))).trans hm_zero
    choose V_cov v_cov y_cov hy_cov hmap_zero using hLocalZero
    have hSieve : CategoryTheory.Sieve.ofArrows V_cov v_cov ∈ S.smallEtaleTopology W₀ := by
      have hTopEq := congrArg
        (fun J : CategoryTheory.GrothendieckTopology S.Etale =>
          CategoryTheory.Sieve.ofArrows V_cov v_cov ∈ J W₀)
        (AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          S (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (le_refl _))
      refine Eq.mpr hTopEq
        ((AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology W₀ _).mpr fun x₀ => ?_)
      have : AlgebraicGeometry.Etale W₀.hom := W₀.prop
      exact ⟨V_cov x₀, v_cov x₀, y_cov x₀, CategoryTheory.Sieve.ofArrows_mk V_cov v_cov x₀,
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          (v_cov x₀).left W₀.hom W₀.prop
          ((CategoryTheory.MorphismProperty.Over.w (v_cov x₀)).symm ▸ (V_cov x₀).prop),
        hy_cov x₀⟩
    let φ_x₂ : Quiver.Hom R_mod (ℱ₂.obj.obj (Opposite.op W₀)) :=
      ModuleCat.ofHom (LinearMap.toSpanSingleton R _ x₂)
    have hφ_eq : φ_x₂ = 0 := by
      refine ℱ₂.2.hom_ext_ofArrows v_cov hSieve fun x₀ => ?_
      rw [CategoryTheory.Limits.zero_comp]
      apply ModuleCat.hom_ext
      apply LinearMap.ext_ring
      change (ℱ₂.obj.map (v_cov x₀).op).hom (φ_x₂.hom (1 : R)) = 0
      have h1 : φ_x₂.hom (1 : R) = x₂ := one_smul R x₂
      rw [h1, hmap_zero x₀]
    have h1 : φ_x₂.hom (1 : R) = x₂ := one_smul R x₂
    rw [← h1, hφ_eq]
    rfl

  have hIsoOfSky : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {𝒳 𝒴 : CategoryTheory.Sheaf S.smallEtaleTopology ModR}
      (Θ : Quiver.Hom 𝒳 𝒴),
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (ξ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) S)
        (M : ModR) (hS : CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (skyPre ξ M)),
        Function.Bijective
          (fun k : Quiver.Hom 𝒴 ⟨skyPre ξ M, hS⟩ => CategoryTheory.CategoryStruct.comp Θ k)) →
      CategoryTheory.IsIso Θ := by
    intro S 𝒳 𝒴 Θ hBij
    have : CategoryTheory.Epi Θ := ⟨fun {𝒵} g₁ g₂ hg => by
      rw [← sub_eq_zero]
      apply hZeroOfHomSkyZero (g₁ - g₂)
      intro Ω _ _ ξ M hS k
      apply (hBij Ω ξ M hS).injective
      change CategoryTheory.CategoryStruct.comp Θ
          (CategoryTheory.CategoryStruct.comp (g₁ - g₂) k) =
        CategoryTheory.CategoryStruct.comp Θ 0
      rw [CategoryTheory.Limits.comp_zero, ← CategoryTheory.Category.assoc,
        CategoryTheory.Preadditive.comp_sub, hg, sub_self, CategoryTheory.Limits.zero_comp]⟩
    have : CategoryTheory.Mono Θ := ⟨fun {𝒲} h₁ h₂ hh => by
      rw [← sub_eq_zero]
      apply hZeroOfHomSkyZero (h₁ - h₂)
      intro Ω _ _ ξ M hS k
      obtain ⟨k_Y, hk_Y⟩ := (hBij Ω ξ M hS).surjective k
      rw [← hk_Y, ← CategoryTheory.Category.assoc, CategoryTheory.Preadditive.sub_comp,
        hh, sub_self, CategoryTheory.Limits.zero_comp]⟩
    exact CategoryTheory.isIso_of_mono_of_epi Θ

  have hClosedLift : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}}
      (i : Quiver.Hom Z Y) (hi : AlgebraicGeometry.IsClosedImmersion i)
      {Ω : Type u} [Field Ω]
      (ξ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) Y),
      ξ (⊥ : PrimeSpectrum Ω) ∈ Set.range ⇑i →
      ∃ ξ_Z : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) Z,
        CategoryTheory.CategoryStruct.comp ξ_Z i = ξ := by
    intro Z Y i hi Ω _ ξ ⟨z₀, hz₀⟩
    have : AlgebraicGeometry.IsClosedImmersion i := hi
    let P := CategoryTheory.Limits.pullback i ξ
    let π₁ := CategoryTheory.Limits.pullback.fst i ξ
    let π₂ := CategoryTheory.Limits.pullback.snd i ξ
    have : AlgebraicGeometry.IsClosedImmersion π₂ := inferInstance
    obtain ⟨p₀, _, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
        (f := i) (g := ξ) z₀ (⊥ : PrimeSpectrum Ω) hz₀
    obtain ⟨I, e_P, hπ₂⟩ := AlgebraicGeometry.IsClosedImmersion.Spec_iff.mp ‹_›
    have : Nontrivial (↑(CommRingCat.of Ω) ⧸ I) :=
      PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨e_P.hom p₀⟩
    have hI_bot : I = ⊥ := by
      rcases Ideal.eq_bot_or_top I with rfl | rfl
      · rfl
      · exfalso
        apply one_ne_zero (α := ↑(CommRingCat.of Ω) ⧸ (⊤ : Ideal ↑(CommRingCat.of Ω)))
        exact Ideal.Quotient.eq_zero_iff_mem.mpr Submodule.mem_top
    subst hI_bot
    let lift_bot : ↑(CommRingCat.of Ω) ⧸ (⊥ : Ideal ↑(CommRingCat.of Ω)) →+*
        ↑(CommRingCat.of Ω) :=
      Ideal.Quotient.lift (⊥ : Ideal ↑(CommRingCat.of Ω)) (RingHom.id ↑(CommRingCat.of Ω))
        (fun _ ha => Ideal.mem_bot.mp ha)
    let s_P : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) P :=
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lift_bot))
        e_P.inv
    have hs_π₂ : CategoryTheory.CategoryStruct.comp s_P π₂ =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
      rw [hπ₂, CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e_P.inv,
        e_P.inv_hom_id, CategoryTheory.Category.id_comp, ← AlgebraicGeometry.Spec.map_comp]
      have hcomp : CategoryTheory.CategoryStruct.comp
          (CommRingCat.ofHom (Ideal.Quotient.mk (⊥ : Ideal ↑(CommRingCat.of Ω))))
          (CommRingCat.ofHom lift_bot) =
          CategoryTheory.CategoryStruct.id (CommRingCat.of Ω) :=
        CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
      rw [hcomp, AlgebraicGeometry.Spec.map_id]
    refine ⟨CategoryTheory.CategoryStruct.comp s_P π₁, ?_⟩
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
      ← CategoryTheory.Category.assoc, hs_π₂, CategoryTheory.Category.id_comp]

  have hClosedComplZero : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}}
      (i : Quiver.Hom Z Y) (hi : AlgebraicGeometry.IsClosedImmersion i)
      (hc_i :
        letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
          CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
        letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
            (@AlgebraicGeometry.Etale) i :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
            (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
        let B : CategoryTheory.Functor Y.Etale Z.Etale :=
          CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
        B.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology)
      {Ω : Type u} [Field Ω]
      (ξ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) Y),
      ξ (⊥ : PrimeSpectrum Ω) ∉ Set.range ⇑i →
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) i :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      letI := hc_i
      let B_i : CategoryTheory.Functor Y.Etale Z.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
      let i_push := B_i.sheafPushforwardContinuous ModR Y.smallEtaleTopology Z.smallEtaleTopology
      ∀ (ℱ : CategoryTheory.Sheaf Z.smallEtaleTopology ModR) (M : ModR)
        (hS : CategoryTheory.Presheaf.IsSheaf Y.smallEtaleTopology (skyPre ξ M))
        (α : Quiver.Hom (i_push.obj ℱ) ⟨skyPre ξ M, hS⟩), α = 0 := by
    intro Z Y i hi hc_i Ω _ ξ hnot
    dsimp only
    intro ℱ M hS α
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    have := hc_i
    let B_i : CategoryTheory.Functor Y.Etale Z.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
    have : AlgebraicGeometry.IsClosedImmersion i := hi
    let U_c : Y.Opens :=
      ⟨(Set.range ⇑i)ᶜ, (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding i).isClosed_range.isOpen_compl⟩
    refine CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun opW =>
      ModuleCat.hom_ext (LinearMap.ext fun s => funext fun δ => ?_)))
    let W := opW.unop
    change ((α.hom.app (Opposite.op W)).hom s) δ = 0
    have : AlgebraicGeometry.Etale W.hom := W.prop
    let O_W : W.left.Opens := (TopologicalSpace.Opens.map W.hom.base).obj U_c
    let W_O : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.comp O_W.ι W.hom) inferInstance
    let j_W : Quiver.Hom W_O W :=
      CategoryTheory.MorphismProperty.Over.homMk O_W.ι rfl trivial
    have hδ_in : δ.1 (⊥ : PrimeSpectrum Ω) ∈ Set.range ⇑O_W.ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      change W.hom (δ.1 (⊥ : PrimeSpectrum Ω)) ∈ (Set.range ⇑i)ᶜ
      have hpt := congrArg (fun k : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) Y =>
        k (⊥ : PrimeSpectrum Ω)) δ.2
      exact hpt.symm ▸ hnot
    obtain ⟨δ_O_hom, hδ_O⟩ := hLiftOpenGeom O_W.ι δ.1 hδ_in
    let δ_O : { d : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) W_O.left //
        CategoryTheory.CategoryStruct.comp d W_O.hom = ξ } :=
      ⟨δ_O_hom,
        (CategoryTheory.Category.assoc δ_O_hom O_W.ι W.hom).symm.trans
          ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k W.hom) hδ_O).trans δ.2)⟩
    have hEmpty : IsEmpty ↥(B_i.obj W_O).left := ⟨fun p => by
      let p₁ := CategoryTheory.Limits.pullback.fst W_O.hom i p
      let p₂ := CategoryTheory.Limits.pullback.snd W_O.hom i p
      have hcond : W_O.hom p₁ = i p₂ :=
        congrArg (fun k : Quiver.Hom (B_i.obj W_O).left Y => k p)
          CategoryTheory.Limits.pullback.condition
      have hp₁_mem : W.hom (O_W.ι p₁) ∈ (Set.range ⇑i)ᶜ := p₁.2
      exact hp₁_mem ⟨p₂, hcond.symm⟩⟩
    have hBot : (⊥ : CategoryTheory.Sieve (B_i.obj W_O)) ∈ Z.smallEtaleTopology (B_i.obj W_O) := by
      have hTopEq := congrArg
        (fun J : CategoryTheory.GrothendieckTopology Z.Etale =>
          (⊥ : CategoryTheory.Sieve (B_i.obj W_O)) ∈ J (B_i.obj W_O))
        (AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          Z (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (le_refl _))
      exact Eq.mpr hTopEq
        ((AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (B_i.obj W_O) _).mpr
          fun x => IsEmpty.elim hEmpty x)
    let hTerm := CategoryTheory.Sheaf.isTerminalOfBotCover ℱ (B_i.obj W_O) hBot
    have hs_res : (ℱ.obj.map (B_i.map j_W).op).hom s = 0 := by
      have hid0 : CategoryTheory.CategoryStruct.id (ℱ.obj.obj (Opposite.op (B_i.obj W_O))) = 0 :=
        hTerm.hom_ext _ _
      exact congrArg (fun m => m.hom ((ℱ.obj.map (B_i.map j_W).op).hom s)) hid0
    have hnat := α.hom.naturality j_W.op
    have hev : ((α.hom.app (Opposite.op W_O)).hom ((ℱ.obj.map (B_i.map j_W).op).hom s)) δ_O =
        ((α.hom.app (Opposite.op W)).hom s)
          ⟨CategoryTheory.CategoryStruct.comp δ_O.1 j_W.left,
            (CategoryTheory.Category.assoc δ_O.1 j_W.left W.hom).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp δ_O.1)
                (CategoryTheory.MorphismProperty.Over.w j_W)).trans δ_O.2)⟩ :=
      congrArg (fun m : Quiver.Hom (ℱ.obj.obj (Opposite.op (B_i.obj W)))
        ((skyPre ξ M).obj (Opposite.op W_O)) => m.hom s δ_O) hnat
    exact (congrArg ((α.hom.app (Opposite.op W)).hom s) (Subtype.ext hδ_O.symm)).trans
      (hev.symm.trans
        ((congrArg (fun v => ((α.hom.app (Opposite.op W_O)).hom v) δ_O) hs_res).trans
          (congrFun (map_zero (α.hom.app (Opposite.op W_O)).hom) δ_O)))

  
  
  
  let skyPushIso : ∀ {X Y : AlgebraicGeometry.Scheme.{u}}
