        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro e
        apply LocallyConstant.ext
        intro x
        have htx := ht' (u_pt x) (hu_pt x)
        change t' ≫ (PSh S).map (u_pt x).op = x_fam (u_pt x) (hu_pt x) at htx
