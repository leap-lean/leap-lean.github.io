        τ_UF τ_V (τ b r) hpb_τUF hτ_V_pb
    obtain ⟨e_exc_fU, he_exc_fU⟩ := (hBridge r).2.1 S_k U_F (weilGysinAffineSpace k b)
      s_UF f_U (weilGysinAffineOrigin k b) (h0_cl b) hf_U_et hpb_fU (2 * b)
      τ_UF (τ b r)
    have he_exc_τ : e_exc_fU.symm τ_UF.val = (τ b r).val := by
      apply e_exc_fU.injective
      rw [e_exc_fU.apply_symm_apply, he_exc_fU τ_UF (τ b r) hpb_fU_τbr]
    rcases hpb_τUF with ⟨hCont_gUF, P_pull, adj_pull, hAdd_p, hLim_p, hColim_p,
      T_V, hT_V, T_ZV, hT_ZV, T_UF, hT_UF, T_Sk', hT_Sk',
      ι_Y, β_g, _, _, _, hval_τUF⟩
    let R_r := ULift.{u, 0} (ZMod (ℓ ^ r))
    let Rr_mod := ModuleCat.of R_r R_r
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) γ_V :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) γ_V :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) s_UF :=
