        have hLocSurj_π : Sheaf.IsLocallySurjective (pf₀.map π) :=
          (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} (pf₀.map π)).mpr inferInstance
        let adj_sh_Z := sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
        let secToHom : ∀ (W : Z.Etale) (F : Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
            ↥(F.obj.obj (Opposite.op W)) → (Z_fun.obj W ⟶ F) :=
          fun W F sec =>
            (adj_sh_Z.homEquiv (yoneda.obj W ⋙ AddCommGrpCat.free) F).symm
              { app := fun W' =>
                  (AddCommGrpCat.adj.homEquiv (W'.unop ⟶ W)
                    (((sheafToPresheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj F).obj W')).symm
                    (TypeCat.ofHom fun (u_w : W'.unop ⟶ W) => (F.obj.map u_w.op).hom sec)
                naturality := fun W₁ W₂ f_w => by
                  apply (AddCommGrpCat.adj.homEquiv (W₁.unop ⟶ W)
                    (((sheafToPresheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj F).obj W₂)).injective
                  dsimp only [Functor.comp_map]
                  rw [Adjunction.homEquiv_naturality_left,
                    Adjunction.homEquiv_naturality_right,
                    Equiv.apply_symm_apply, Equiv.apply_symm_apply]
                  ext u_w
                  change (F.obj.map (f_w.unop ≫ u_w).op).hom sec =
                    (F.obj.map f_w).hom ((F.obj.map u_w.op).hom sec)
                  rw [op_comp, F.obj.map_comp]
                  rfl }
        let homToSec : ∀ (W : Z.Etale) (F : Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
            (Z_fun.obj W ⟶ F) → ↥(F.obj.obj (Opposite.op W)) :=
          fun W F φ =>
            let η := adj_sh_Z.homEquiv (yoneda.obj W ⋙ AddCommGrpCat.free) F φ
            (η.app (Opposite.op W)).hom ((AddCommGrpCat.adj.unit.app (W ⟶ W)) (𝟙 W))
        have hHomEqIff : ∀ {W : Z.Etale} {F : Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
            (φ₁ φ₂ : Z_fun.obj W ⟶ F),
            homToSec W F φ₁ = homToSec W F φ₂ → φ₁ = φ₂ := by
          intro W F φ₁ φ₂ heq
          apply (adj_sh_Z.homEquiv (yoneda.obj W ⋙ AddCommGrpCat.free) F).injective
          let η₁ := adj_sh_Z.homEquiv (yoneda.obj W ⋙ AddCommGrpCat.free) F φ₁
          let η₂ := adj_sh_Z.homEquiv (yoneda.obj W ⋙ AddCommGrpCat.free) F φ₂
          refine NatTrans.ext (funext fun W' => ?_)
          apply (AddCommGrpCat.adj.homEquiv (W'.unop ⟶ W) (F.obj.obj W')).injective
          ext u_w
          have hnat₁ := congrArg (fun m => m.hom ((AddCommGrpCat.adj.unit.app (W ⟶ W)) (𝟙 W)))
            (η₁.naturality u_w.op)
          have hnat₂ := congrArg (fun m => m.hom ((AddCommGrpCat.adj.unit.app (W ⟶ W)) (𝟙 W)))
            (η₂.naturality u_w.op)
          have hu : (AddCommGrpCat.free.map ((yoneda.obj W).map u_w.op)).hom
