              (((d_C₀ (s + 1)).app A).hom) w = 0 → lam w = 0 := by
            intro w hw
            have : Subsingleton (CategoryTheory.Abelian.Ext.{u} one₀ A (s + 1)) :=
              hA (s + 1) (by omega)
            have hΥ0 : Υ₀ A (s + 1) ⟨w, hw⟩ = 0 := Subsingleton.elim _ _
            obtain ⟨u, hu⟩ := (hΥ_ker₀ s A ⟨w, hw⟩).mp hΥ0
            change (((d_C₀ s).app A).hom) u = w at hu
            change lam w = 0
            rw [← hu]
            exact congrArg (fun L : ↑((C₀ s).obj A) →ₗ[R] R => L u) hlam_d
          obtain ⟨μ, hμ⟩ := extendKerLe (((d_C₀ (s + 1)).app A).hom) lam hlam_ker
          let h_hom : A ⟶ 𝒥₀ (s + 2) := Ψ₀ (s + 2) A μ
          have hh_q : h_hom ≫ q_map s = g := by
            have := hκ_mono s
            rw [← CategoryTheory.cancel_mono (κ s), Category.assoc, hq_κ]
            dsimp [h_hom]
            rw [hΨ_diff₀, hμ]
            exact (Ψ₀ (s + 1) A).apply_symm_apply (g ≫ κ s)
          rw [← hx₃, ← hg_mk, ← hh_q, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ h_hom (q_map s),
            CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ h_hom)
              (CategoryTheory.Abelian.Ext.mk₀ (SC_step s).g) (hSC_step s hs).extClass
              (Nat.add_zero 0) (Nat.zero_add 1) (by omega),
            (hSC_step s hs).comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
        have hB_van : ∀ (r : ℕ), r ≤ k → ∀ q : ℕ, 1 ≤ q → q ≤ r →
            Subsingleton (CategoryTheory.Abelian.Ext.{u} A (B r) q) := by
          intro r
          induction r with
          | zero =>
            intro _ q hq1 hq0
            omega
          | succ s ih =>
            intro hs q hq1 hqs
            cases q with
            | zero => omega
            | succ q' =>
              rcases eq_or_lt_of_le (Nat.zero_le q') with rfl | hq'_pos
              · exact hExt1_B s (by omega)
              · have : Subsingleton (CategoryTheory.Abelian.Ext.{u} A (B s) q') :=
                  ih (by omega) q' hq'_pos (by omega)
                have := hInjExt (s + 2) (q' + 1) (by omega) A
                refine ⟨fun y₁ y₂ => ?_⟩
                suffices h0 : ∀ y : CategoryTheory.Abelian.Ext.{u} A (B (s + 1)) (q' + 1), y = 0 by
                  rw [h0 y₁, h0 y₂]
                intro y
