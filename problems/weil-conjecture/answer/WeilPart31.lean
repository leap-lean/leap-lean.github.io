                    (α.app opV)) := by
                rw [CategoryTheory.Category.assoc]
            _ = CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.CategoryStruct.comp
                      (P_pre.map (e_Z (Z_obj opV.unop φ)).op)
                      (P_pre.map (u_lift (κ_Vφ opV.unop φ) (π_Z (Z_obj opV.unop φ))).op))
                    (CategoryTheory.Limits.Sigma.ι (fam P_pre opV.unop)
                      (CategoryTheory.CategoryStruct.comp (κ_Vφ opV.unop φ)
                        (π_Z (Z_obj opV.unop φ)))))
                  (α.app opV) :=
                (congrArg (CategoryTheory.CategoryStruct.comp (P_pre.map (e_Z (Z_obj opV.unop φ)).op))
                  (congrArg (fun k => CategoryTheory.CategoryStruct.comp k (α.app opV)) h₂)).trans
                  ((CategoryTheory.Category.assoc _ _ _).symm.trans
                    (congrArg (fun k => CategoryTheory.CategoryStruct.comp k (α.app opV))
                      (CategoryTheory.Category.assoc _ _ _).symm))
            _ = CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.Sigma.ι (fam P_pre opV.unop) φ) (α.app opV) := by
                rw [← P_pre.map_comp, ← CategoryTheory.op_comp,
                  hu_κe opV.unop φ (hκ_π opV.unop φ), hTransp P_pre (hκ_π opV.unop φ)]
        right_inv := fun β => by
          ext opZ : 2
          dsimp only [L_pre, L_pre_obj]
          rw [CategoryTheory.Limits.Sigma.ι_comp_desc, ← CategoryTheory.Category.assoc]
          have hb : CategoryTheory.CategoryStruct.comp
              (P_pre.map (e_Z opZ.unop).op)
              (β.app (Opposite.op (Z_obj (F.obj opZ.unop) (π_Z opZ.unop)))) =
            CategoryTheory.CategoryStruct.comp (β.app opZ)
              (Q_pre.map (F.map (e_Z opZ.unop)).op) :=
            β.naturality (e_Z opZ.unop).op
          rw [hb, CategoryTheory.Category.assoc, ← Q_pre.map_comp, ← CategoryTheory.op_comp,
            hκ_Fe opZ.unop, CategoryTheory.op_id,
            Q_pre.map_id (Opposite.op (F.obj opZ.unop))]
          exact CategoryTheory.Category.comp_id (β.app opZ) }
    let fgt₁ := CategoryTheory.sheafToPresheaf J₁ ModR
    let shf₂ := CategoryTheory.presheafToSheaf J₂ ModR
    let L_sh := CategoryTheory.Functor.comp fgt₁ (CategoryTheory.Functor.comp L_pre shf₂)
    let R_sh := F.sheafPushforwardContinuous ModR J₁ J₂
    let adj_sh₂ := CategoryTheory.sheafificationAdjunction J₂ ModR
    refine ⟨L_sh, ⟨CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := fun ℱ 𝒢 =>
          (adj_sh₂.homEquiv (L_pre.obj ℱ.obj) 𝒢).trans
            ((ePreLR ℱ.obj 𝒢.obj).trans
              { toFun := fun η => CategoryTheory.ObjectProperty.homMk η
                invFun := fun k => k.hom
                left_inv := fun _ => rfl
                right_inv := fun _ => rfl })
        homEquiv_naturality_left_symm := fun {ℱ' ℱ 𝒢} h g => by
          refine (congrArg (adj_sh₂.homEquiv (L_pre.obj ℱ'.obj) 𝒢).symm ?_).trans
            (adj_sh₂.homEquiv_naturality_left_symm (L_pre.map h.hom)
              ((ePreLR ℱ.obj 𝒢.obj).symm g.hom))
          ext opV : 2
          apply CategoryTheory.Limits.Sigma.hom_ext
          intro φ
          dsimp [L_pre, ePreLR]
          exact (CategoryTheory.Limits.Sigma.ι_comp_desc _ φ).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k _)
                  (CategoryTheory.Limits.Sigma.ι_comp_desc _ φ)).trans
                  ((CategoryTheory.Category.assoc _ _ _).trans
                    (congrArg (CategoryTheory.CategoryStruct.comp _)
                      (CategoryTheory.Limits.Sigma.ι_comp_desc _ φ))))).symm)
        homEquiv_naturality_right := fun {ℱ 𝒢 𝒢'} f k => by
          ext opZ : 3
          have hf := adj_sh₂.homEquiv_naturality_right (X := L_pre.obj ℱ.obj) f k
          change (ePreLR ℱ.obj 𝒢'.obj (adj_sh₂.homEquiv _ 𝒢' (CategoryTheory.CategoryStruct.comp f k))).app opZ =
            CategoryTheory.CategoryStruct.comp
              ((ePreLR ℱ.obj 𝒢.obj (adj_sh₂.homEquiv _ 𝒢 f)).app opZ)
              (k.hom.app (Opposite.op (F.obj opZ.unop)))
          rw [hf]
          dsimp [ePreLR]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc] }⟩⟩

  have hHasLeftAdj : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (h : Quiver.Hom Y₁ Y₂) (hh : AlgebraicGeometry.Etale h)
      (hc : (weilEtalePostcomp h hh).IsContinuous Y₁.smallEtaleTopology Y₂.smallEtaleTopology),
      letI := hc
      ∃ L_sh : CategoryTheory.Functor
          (CategoryTheory.Sheaf Y₁.smallEtaleTopology ModR)
          (CategoryTheory.Sheaf Y₂.smallEtaleTopology ModR),
        Nonempty (L_sh ⊣ (weilEtalePostcomp h hh).sheafPushforwardContinuous
          ModR Y₁.smallEtaleTopology Y₂.smallEtaleTopology) := by
    intro Y₁ Y₂ h hh hc
    have := hc
    let Sigma_h := weilEtalePostcomp h hh
    let W_h : Y₂.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ h hh
    let Z_h : ∀ V : Y₂.Etale, Quiver.Hom V W_h → Y₁.Etale := fun V φ =>
      CategoryTheory.MorphismProperty.Over.mk ⊤ φ.left
        (CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) φ.left h hh
          ((CategoryTheory.MorphismProperty.Over.w φ).symm ▸ V.prop))
    have hEqToHom_left : ∀ {V : Y₂.Etale} {ψ₁ ψ₂ : Quiver.Hom V W_h} (hψ : ψ₁ = ψ₂),
        (CategoryTheory.eqToHom (congrArg (Z_h V) hψ)).left =
          CategoryTheory.CategoryStruct.id V.left := by
      intro V ψ₁ ψ₂ hψ
      subst hψ
      rfl
    let u_lift : ∀ {V' V : Y₂.Etale} (g : Quiver.Hom V' V) (φ : Quiver.Hom V W_h),
        Quiver.Hom (Z_h V' (CategoryTheory.CategoryStruct.comp g φ)) (Z_h V φ) :=
      fun g _ => CategoryTheory.MorphismProperty.Over.homMk g.left rfl trivial
    let π_Z : ∀ Z : Y₁.Etale, Quiver.Hom (Sigma_h.obj Z) W_h :=
      fun Z => CategoryTheory.MorphismProperty.Over.homMk Z.hom rfl trivial
    let e_Z : ∀ Z : Y₁.Etale, Quiver.Hom (Z_h (Sigma_h.obj Z) (π_Z Z)) Z :=
      fun Z => CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.CategoryStruct.id Z.left) (CategoryTheory.Category.id_comp Z.hom) trivial
    let κ_Vφ : ∀ (V : Y₂.Etale) (φ : Quiver.Hom V W_h), Quiver.Hom V (Sigma_h.obj (Z_h V φ)) :=
      fun V φ => CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.CategoryStruct.id V.left)
        ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.MorphismProperty.Over.w φ))
        trivial
    exact hAbstractIndexedSiteAdj Y₁.smallEtaleTopology Y₂.smallEtaleTopology Sigma_h
      W_h Z_h (@u_lift) π_Z e_Z κ_Vφ
      (fun V φ => CategoryTheory.MorphismProperty.Comma.Hom.ext
        (hEqToHom_left (CategoryTheory.Category.id_comp φ)).symm (Subsingleton.elim _ _))
      (fun g₂ g₁ φ => CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k _)
          (hEqToHom_left (CategoryTheory.Category.assoc g₂ g₁ φ))).trans
          (CategoryTheory.Category.id_comp _)) (Subsingleton.elim _ _))
      (fun u => CategoryTheory.MorphismProperty.Comma.Hom.ext
        (CategoryTheory.MorphismProperty.Over.w u) (Subsingleton.elim _ _))
      (fun u hπ => CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id u.left).trans
          (((CategoryTheory.Category.id_comp u.left).symm).trans
            ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k _) (hEqToHom_left hπ)).trans
              (CategoryTheory.Category.id_comp _)).symm))
        (Subsingleton.elim _ _))
      (fun g φ => CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.id_comp g.left).trans (CategoryTheory.Category.comp_id g.left).symm)
        (Subsingleton.elim _ _))
      (fun V φ => CategoryTheory.MorphismProperty.Comma.Hom.ext
        (CategoryTheory.Category.id_comp φ.left) (Subsingleton.elim _ _))
      (fun V φ hκ => CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id _).trans (hEqToHom_left hκ).symm)
        (Subsingleton.elim _ _))
      (fun Z => CategoryTheory.MorphismProperty.Comma.Hom.ext
        (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _))

  
  
  
  have hNullstellensatz : ∀ {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
      {B : Type u} [CommRing B] [Nontrivial B] [Algebra Ω B] [Algebra.FiniteType Ω B],
      Nonempty (B →ₐ[Ω] Ω) := by
    intro Ω _ _ B _ _ _ _
    obtain ⟨n, f, hf⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := Ω) (S := B)).mp inferInstance
    let I : Ideal (MvPolynomial (Fin n) Ω) := RingHom.ker f.toRingHom
    have h1_not_rad : (1 : MvPolynomial (Fin n) Ω) ∉ I.radical := by
      rintro ⟨k, hk⟩
      rw [one_pow] at hk
      have hf1 : f 1 = 0 := hk
      rw [map_one] at hf1
      exact one_ne_zero hf1
    have hZ_ne : (MvPolynomial.zeroLocus Ω I).Nonempty := by
      rw [Set.nonempty_iff_ne_empty]
      intro hemp
      apply h1_not_rad
      rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (k := Ω) (K := Ω) I, hemp]
      simp [MvPolynomial.vanishingIdeal]
    obtain ⟨v, hv⟩ := hZ_ne
    have hker : RingHom.ker f.toRingHom ≤ RingHom.ker (MvPolynomial.aeval v).toRingHom := by
      intro p hp
      rw [RingHom.mem_ker]
      change MvPolynomial.aeval v p = 0
      rw [MvPolynomial.aeval_def]
      exact hv p hp
    exact ⟨AlgHom.liftOfSurjective f hf (MvPolynomial.aeval v) hker⟩

  have hLiftGeomPointEtale : ∀ {Y W : AlgebraicGeometry.Scheme.{u}}
      (u : Quiver.Hom Y W) [AlgebraicGeometry.Etale u]
      {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
      (δ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) W)
      (y : ↥Y),
      u y = δ (⊥ : PrimeSpectrum Ω) →
      ∃ δ' : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) Y,
        CategoryTheory.CategoryStruct.comp δ' u = δ := by
    intro Y W u _ Ω _ _ δ y hy
    let P := CategoryTheory.Limits.pullback u δ
    let π₁ := CategoryTheory.Limits.pullback.fst u δ
    let π₂ := CategoryTheory.Limits.pullback.snd u δ
    obtain ⟨p₀, _, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
        (f := u) (g := δ) y (⊥ : PrimeSpectrum Ω) hy
    obtain ⟨V, hV, hp₀V, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := p₀) (U := ⊤) trivial
    let R_V : CommRingCat.{u} := P.presheaf.obj (Opposite.op V)
    have hq_ex : ∃ q₀ : ↥(AlgebraicGeometry.Spec R_V), hV.fromSpec q₀ = p₀ := by
      rw [← Set.mem_range, hV.range_fromSpec]
      exact hp₀V
    obtain ⟨q₀, _⟩ := hq_ex
    have : Nontrivial ↑R_V := PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨q₀⟩
    let g_V : Quiver.Hom (AlgebraicGeometry.Spec R_V) (AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
      CategoryTheory.CategoryStruct.comp hV.fromSpec π₂
    have : AlgebraicGeometry.Etale g_V := inferInstance
    let φ_V : Quiver.Hom (CommRingCat.of Ω) R_V := (AlgebraicGeometry.Scheme.Spec.preimage g_V).unop
    have hEqG : AlgebraicGeometry.Spec.map φ_V = g_V :=
      AlgebraicGeometry.Scheme.Spec.map_preimage g_V
    letI : Algebra Ω ↑R_V := φ_V.hom.toAlgebra
    have : Algebra.Etale Ω ↑R_V :=
      RingHom.etale_algebraMap.mp
        ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (hEqG.symm ▸ (inferInstance : AlgebraicGeometry.Etale g_V)))
    have : Algebra.FiniteType Ω ↑R_V := inferInstance
    obtain ⟨ψ⟩ := hNullstellensatz (Ω := Ω) (B := ↑R_V)
    let s_V : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (AlgebraicGeometry.Spec R_V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom)
    have hs_gV : CategoryTheory.CategoryStruct.comp s_V g_V =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
      rw [← hEqG, ← AlgebraicGeometry.Spec.map_comp]
      have hcomp : CategoryTheory.CategoryStruct.comp φ_V (CommRingCat.ofHom ψ.toRingHom) =
          CategoryTheory.CategoryStruct.id (CommRingCat.of Ω) :=
        CommRingCat.hom_ext ψ.comp_algebraMap
      rw [hcomp, AlgebraicGeometry.Spec.map_id]
    refine ⟨CategoryTheory.CategoryStruct.comp s_V
      (CategoryTheory.CategoryStruct.comp hV.fromSpec π₁), ?_⟩
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc hV.fromSpec π₂ δ,
      ← CategoryTheory.Category.assoc s_V, hs_gV, CategoryTheory.Category.id_comp]

  have hSkyIsSheaf : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (ξ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) S) (M : ModR),
      CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (skyPre ξ M) := by
    intro S Ω _ _ ξ M E W S_cov hS_cov
    have hTopEq := congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => S_cov ∈ J W)
      (AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (le_refl _))
    have hCov :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology W S_cov).mp
        (Eq.mp hTopEq hS_cov)
    intro x hx
    have hLiftAll : ∀ δ : { δ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) W.left //
        CategoryTheory.CategoryStruct.comp δ W.hom = ξ },
        ∃ (Y : S.Etale) (f : Quiver.Hom Y W) (hf : S_cov.arrows f)
          (δ' : { δ' : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) Y.left //
            CategoryTheory.CategoryStruct.comp δ' Y.hom = ξ }),
          CategoryTheory.CategoryStruct.comp δ'.1 f.left = δ.1 := by
      intro δ
      obtain ⟨Y, f, y, hf_arr, hf_et, hfy⟩ := hCov (δ.1 (⊥ : PrimeSpectrum Ω))
      have : AlgebraicGeometry.Etale f.left := hf_et
      obtain ⟨δ'_hom, hδ'_fac⟩ := hLiftGeomPointEtale f.left δ.1 y hfy
      refine ⟨Y, f, hf_arr, ⟨δ'_hom, ?_⟩, hδ'_fac⟩
      rw [← CategoryTheory.MorphismProperty.Over.w f, ← CategoryTheory.Category.assoc,
        hδ'_fac, δ.2]
    choose Y_δ f_δ hf_δ δ'_δ hfac_δ using hLiftAll
    have hAgree : ∀ (δ : { δ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) W.left //
          CategoryTheory.CategoryStruct.comp δ W.hom = ξ })
        {Y₁ Y₂ : S.Etale} (f₁ : Quiver.Hom Y₁ W) (hf₁ : S_cov.arrows f₁)
        (δ₁ : { d : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) Y₁.left //
          CategoryTheory.CategoryStruct.comp d Y₁.hom = ξ })
        (hfac₁ : CategoryTheory.CategoryStruct.comp δ₁.1 f₁.left = δ.1)
        (f₂ : Quiver.Hom Y₂ W) (hf₂ : S_cov.arrows f₂)
        (δ₂ : { d : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) Y₂.left //
          CategoryTheory.CategoryStruct.comp d Y₂.hom = ξ })
        (hfac₂ : CategoryTheory.CategoryStruct.comp δ₂.1 f₂.left = δ.1)
        (e : ↥E),
        (x f₁ hf₁).hom e δ₁ = (x f₂ hf₂).hom e δ₂ := by
      intro δ Y₁ Y₂ f₁ hf₁ δ₁ hfac₁ f₂ hf₂ δ₂ hfac₂ e
      have : AlgebraicGeometry.Etale f₁.left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) f₁.left W.hom W.prop
          ((CategoryTheory.MorphismProperty.Over.w f₁).symm ▸ Y₁.prop)
      have : AlgebraicGeometry.Etale f₂.left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) f₂.left W.hom W.prop
          ((CategoryTheory.MorphismProperty.Over.w f₂).symm ▸ Y₂.prop)
      have : AlgebraicGeometry.Etale W.hom := W.prop
      let p₁_left := CategoryTheory.Limits.pullback.fst f₁.left f₂.left
      let p₂_left := CategoryTheory.Limits.pullback.snd f₁.left f₂.left
      have : AlgebraicGeometry.Etale Y₁.hom := Y₁.prop
      let P₁₂ : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
        (CategoryTheory.CategoryStruct.comp p₁_left Y₁.hom) inferInstance
      let g₁ : Quiver.Hom P₁₂ Y₁ := CategoryTheory.MorphismProperty.Over.homMk p₁_left rfl trivial
      let g₂ : Quiver.Hom P₁₂ Y₂ := CategoryTheory.MorphismProperty.Over.homMk p₂_left
        ((congrArg (CategoryTheory.CategoryStruct.comp p₂_left)
          (CategoryTheory.MorphismProperty.Over.w f₂).symm).trans
          ((CategoryTheory.Category.assoc p₂_left f₂.left W.hom).symm.trans
            ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k W.hom)
              CategoryTheory.Limits.pullback.condition.symm).trans
              ((CategoryTheory.Category.assoc p₁_left f₁.left W.hom).trans
                (congrArg (CategoryTheory.CategoryStruct.comp p₁_left)
                  (CategoryTheory.MorphismProperty.Over.w f₁))))))
        trivial
      have hg_comm : CategoryTheory.CategoryStruct.comp g₁ f₁ =
          CategoryTheory.CategoryStruct.comp g₂ f₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          CategoryTheory.Limits.pullback.condition (Subsingleton.elim _ _)
      let δ₁₂ : { d : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) P₁₂.left //
          CategoryTheory.CategoryStruct.comp d P₁₂.hom = ξ } :=
        ⟨CategoryTheory.Limits.pullback.lift δ₁.1 δ₂.1 (hfac₁.trans hfac₂.symm),
          (CategoryTheory.Category.assoc _ p₁_left Y₁.hom).symm.trans
            ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k Y₁.hom)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans δ₁.2)⟩
      have hcomp := hx g₁ g₂ hf₁ hf₂ hg_comm
      have hev : (x f₁ hf₁).hom e
          ⟨CategoryTheory.CategoryStruct.comp δ₁₂.1 p₁_left,
            (CategoryTheory.Category.assoc δ₁₂.1 p₁_left Y₁.hom).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp δ₁₂.1)
                (CategoryTheory.MorphismProperty.Over.w g₁)).trans δ₁₂.2)⟩ =
        (x f₂ hf₂).hom e
          ⟨CategoryTheory.CategoryStruct.comp δ₁₂.1 p₂_left,
            (CategoryTheory.Category.assoc δ₁₂.1 p₂_left Y₂.hom).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp δ₁₂.1)
                (CategoryTheory.MorphismProperty.Over.w g₂)).trans δ₁₂.2)⟩ :=
        congrArg (fun m : Quiver.Hom E ((skyPre ξ M).obj (Opposite.op P₁₂)) =>
          m.hom e δ₁₂) hcomp
      exact (congrArg ((x f₁ hf₁).hom e)
        (Subtype.ext (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)).trans
        (hev.trans (congrArg ((x f₂ hf₂).hom e)
          (Subtype.ext (CategoryTheory.Limits.pullback.lift_snd _ _ _))))
    let t : Quiver.Hom E ((skyPre ξ M).obj (Opposite.op W)) := ModuleCat.ofHom
      { toFun := fun e δ => (x (f_δ δ) (hf_δ δ)).hom e (δ'_δ δ)
        map_add' := fun e₁ e₂ => funext fun δ =>
          congrFun (map_add ((x (f_δ δ) (hf_δ δ)).hom) e₁ e₂) (δ'_δ δ)
        map_smul' := fun r e => funext fun δ =>
          congrFun (map_smul ((x (f_δ δ) (hf_δ δ)).hom) r e) (δ'_δ δ) }
    refine ⟨t, fun Y f hf => ?_, fun t' ht' => ?_⟩
    · refine ModuleCat.hom_ext (LinearMap.ext fun e => funext fun δ_Y => ?_)
      let δ_W : { d : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) W.left //
          CategoryTheory.CategoryStruct.comp d W.hom = ξ } :=
        ⟨CategoryTheory.CategoryStruct.comp δ_Y.1 f.left,
          (CategoryTheory.Category.assoc δ_Y.1 f.left W.hom).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp δ_Y.1)
              (CategoryTheory.MorphismProperty.Over.w f)).trans δ_Y.2)⟩
      exact hAgree δ_W (f_δ δ_W) (hf_δ δ_W) (δ'_δ δ_W) (hfac_δ δ_W) f hf δ_Y rfl e
    · refine ModuleCat.hom_ext (LinearMap.ext fun e => funext fun δ => ?_)
      have ht'_f := ht' (f_δ δ) (hf_δ δ)
      have hev : t'.hom e
          ⟨CategoryTheory.CategoryStruct.comp (δ'_δ δ).1 (f_δ δ).left,
            (CategoryTheory.Category.assoc (δ'_δ δ).1 (f_δ δ).left W.hom).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp (δ'_δ δ).1)
                (CategoryTheory.MorphismProperty.Over.w (f_δ δ))).trans (δ'_δ δ).2)⟩ =
        (x (f_δ δ) (hf_δ δ)).hom e (δ'_δ δ) :=
        congrArg (fun m : Quiver.Hom E ((skyPre ξ M).obj (Opposite.op (Y_δ δ))) =>
          m.hom e (δ'_δ δ)) ht'_f
      exact (congrArg (t'.hom e) (Subtype.ext (hfac_δ δ).symm)).trans hev

  have hShrinkAff : ∀ {S : AlgebraicGeometry.Scheme.{u}} (W : S.Etale) (w : ↥W.left),
      ∃ (d : weilGysinAxisRecollSite S)
        (v : Quiver.Hom ((weilGysinAxisRecollAffSpec S).obj d) W),
        AlgebraicGeometry.IsOpenImmersion v.left ∧ w ∈ Set.range ⇑v.left := by
    intro S W w
    obtain ⟨U, hU, hwU, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := w) (U := ⊤) trivial
    have : AlgebraicGeometry.Etale W.hom := W.prop
    have : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp hU.fromSpec W.hom) :=
      inferInstance
    let A_U : S.AffineEtale :=
      AlgebraicGeometry.Scheme.AffineEtale.mk
        (CategoryTheory.CategoryStruct.comp hU.fromSpec W.hom)
    let eqv := CategoryTheory.equivSmallModel.{u} S.AffineEtale
    let d : weilGysinAxisRecollSite S := eqv.functor.obj A_U
    let e_d : CategoryTheory.Iso ((weilGysinAxisRecollAffSpec S).obj d)
        ((AlgebraicGeometry.Scheme.AffineEtale.Spec S).obj A_U) :=
      (AlgebraicGeometry.Scheme.AffineEtale.Spec S).mapIso (eqv.unitIso.app A_U).symm
    let u_AU : Quiver.Hom ((AlgebraicGeometry.Scheme.AffineEtale.Spec S).obj A_U) W :=
      CategoryTheory.MorphismProperty.Over.homMk hU.fromSpec rfl trivial
    let v : Quiver.Hom ((weilGysinAxisRecollAffSpec S).obj d) W :=
      CategoryTheory.CategoryStruct.comp e_d.hom u_AU
    let e_left : CategoryTheory.Iso ((weilGysinAxisRecollAffSpec S).obj d).left
        ((AlgebraicGeometry.Scheme.AffineEtale.Spec S).obj A_U).left :=
      { hom := e_d.hom.left
        inv := e_d.inv.left
        hom_inv_id := congrArg (fun m => m.left) e_d.hom_inv_id
        inv_hom_id := congrArg (fun m => m.left) e_d.inv_hom_id }
    have : CategoryTheory.IsIso e_d.hom.left := e_left.isIso_hom
    have hOpen_e : AlgebraicGeometry.IsOpenImmersion e_d.hom.left := inferInstance
    have hOpen_U : AlgebraicGeometry.IsOpenImmersion hU.fromSpec := inferInstance
    have hv_open : AlgebraicGeometry.IsOpenImmersion v.left :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion)
        e_d.hom.left hU.fromSpec hOpen_e hOpen_U
    refine ⟨d, v, hv_open, ?_⟩
    have hw_range : w ∈ Set.range ⇑hU.fromSpec := by
      rw [hU.range_fromSpec]
      exact hwU
    obtain ⟨p, hp⟩ := hw_range
    refine ⟨e_d.inv.left p, ?_⟩
    have hp' : e_d.hom.left (e_d.inv.left p) = p := by
      change (CategoryTheory.CategoryStruct.comp e_d.inv.left e_d.hom.left) p = p
      rw [e_left.inv_hom_id]
      rfl
    change hU.fromSpec (e_d.hom.left (e_d.inv.left p)) = w
    rw [hp', hp]

  have hLiftOpenGeom : ∀ {X Y : AlgebraicGeometry.Scheme.{u}}
      (f : Quiver.Hom X Y) [AlgebraicGeometry.IsOpenImmersion f]
      {Ω : Type u} [Field Ω]
      (δ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) Y),
      δ (⊥ : PrimeSpectrum Ω) ∈ Set.range ⇑f →
      ∃ δ' : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) X,
        CategoryTheory.CategoryStruct.comp δ' f = δ := by
    intro X Y f _ Ω _ δ hmem
    have hsub : Set.range ⇑δ ⊆ Set.range ⇑f := by
      rintro _ ⟨p, rfl⟩
      rw [Subsingleton.elim p (⊥ : PrimeSpectrum Ω)]
      exact hmem
    exact ⟨AlgebraicGeometry.IsOpenImmersion.lift f δ hsub,
      AlgebraicGeometry.IsOpenImmersion.lift_fac f δ hsub⟩

  have hZeroOfHomSkyZero : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {ℱ₁ ℱ₂ : CategoryTheory.Sheaf S.smallEtaleTopology ModR}
      (u : Quiver.Hom ℱ₁ ℱ₂),
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (ξ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) S)
        (M : ModR) (hS : CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (skyPre ξ M))
        (k : Quiver.Hom ℱ₂ ⟨skyPre ξ M, hS⟩),
        CategoryTheory.CategoryStruct.comp u k = 0) →
      u = 0 := by
    intro S ℱ₁ ℱ₂ u hZeroSky
    apply CategoryTheory.Sheaf.hom_ext
    ext opW₀ : 2
    let W₀ : S.Etale := opW₀.unop
    apply ModuleCat.hom_ext
    ext s₀
    change (u.hom.app (Opposite.op W₀)).hom s₀ = 0
    set x₂ : ↥(ℱ₂.obj.obj (Opposite.op W₀)) := (u.hom.app (Opposite.op W₀)).hom s₀
    have hLocalZero : ∀ x₀ : ↥W₀.left,
        ∃ (V : S.Etale) (v : Quiver.Hom V W₀) (y₀ : ↥V.left),
          v.left y₀ = x₀ ∧ (ℱ₂.obj.map v.op).hom x₂ = 0 := by
      intro x₀
      let κ : Type u := ↥(W₀.left.residueField x₀)
      let Ω : Type u := AlgebraicClosure κ
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let δ₀ : Quiver.Hom S_Ω W₀.left :=
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ Ω)))
          (W₀.left.fromSpecResidueField x₀)
      have hδ₀_pt : δ₀ (⊥ : PrimeSpectrum Ω) = x₀ :=
        AlgebraicGeometry.Scheme.fromSpecResidueField_apply x₀ _
      let ξ : Quiver.Hom S_Ω S := CategoryTheory.CategoryStruct.comp δ₀ W₀.hom
      let G_aff := weilGysinAxisRecollAffSpec S
      let StalkObj : Type u :=
        Σ d : weilGysinAxisRecollSite S,
          { δ : Quiver.Hom S_Ω (G_aff.obj d).left //
            CategoryTheory.CategoryStruct.comp δ (G_aff.obj d).hom = ξ }
      letI : CategoryTheory.SmallCategory StalkObj :=
        { Hom := fun A B =>
            { f : Quiver.Hom (G_aff.obj B.1) (G_aff.obj A.1) //
              CategoryTheory.CategoryStruct.comp B.2.1 f.left = A.2.1 }
          id := fun A => ⟨CategoryTheory.CategoryStruct.id _, CategoryTheory.Category.comp_id _⟩
          comp := fun f g =>
            ⟨CategoryTheory.CategoryStruct.comp g.1 f.1,
              (CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k f.1.left) g.2).trans f.2)⟩
          id_comp := fun f => Subtype.ext (CategoryTheory.Category.comp_id f.1)
          comp_id := fun f => Subtype.ext (CategoryTheory.Category.id_comp f.1)
          assoc := fun f g h => Subtype.ext (CategoryTheory.Category.assoc h.1 g.1 f.1).symm }
      have hRefine : ∀ (W : S.Etale)
          (δ : { d : Quiver.Hom S_Ω W.left // CategoryTheory.CategoryStruct.comp d W.hom = ξ }),
          ∃ (A : StalkObj) (v : Quiver.Hom (G_aff.obj A.1) W),
            CategoryTheory.CategoryStruct.comp A.2.1 v.left = δ.1 := by
