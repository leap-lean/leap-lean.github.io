            intro c f ⟨k, hk⟩
            refine ⟨k, ?_⟩
            rw [smul_pow, hk, smul_zero]
          have h1_nil : IsNilpotent ((μ ^ s') • ν) := hsmul_nil (μ ^ s') ν hν_nil
          have h2_nil : IsNilpotent (μ • η) := hsmul_nil μ η hη_nil
          have h3_nil : IsNilpotent (η * ν) := hcomm_νη.symm.isNilpotent_mul_left hν_nil
          have hcomm_23 : Commute (μ • η) (η * ν) := by
