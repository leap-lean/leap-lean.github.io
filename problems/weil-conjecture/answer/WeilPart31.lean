    let e_bwdH := weilCupPDTraceLocalTorsionMapH S m u_bwd N
    have he_bf : e_bwdH.comp e_fwdH = AddMonoidHom.id _ := by
      rw [← hMapCompH m N u_fwd u_bwd, h_fb, hMapIdH]
    have he_fb : e_fwdH.comp e_bwdH = AddMonoidHom.id _ := by
      rw [← hMapCompH m N u_bwd u_fwd, h_bf, hMapIdH]
