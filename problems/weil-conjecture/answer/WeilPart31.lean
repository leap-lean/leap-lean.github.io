          have hRHS : homToSec (B₀.obj V) Q (j_hom ≫ π) =
              (π.hom.app (Opposite.op (B₀.obj V))).hom s_V' := by
            dsimp [homToSec]
            rw [Adjunction.homEquiv_naturality_right]
            exact congrArg (π.hom.app (Opposite.op (B₀.obj V))).hom
              (hSecToHom_eval (B₀.obj V) J_inj s_V')
          have hLHS : homToSec (B₀.obj V) Q (Z_fun.map (B₀.map g) ≫ q_hom) =
              (Q.obj.map (B₀.map g).op).hom t_U := by
            dsimp [homToSec, Z_fun]
            rw [Adjunction.homEquiv_naturality_left]
            let η_q := adj_sh_Z.homEquiv (yoneda.obj (B₀.obj U) ⋙ AddCommGrpCat.free) Q q_hom
            have hnat' := congrArg (fun m => m.hom ((AddCommGrpCat.adj.unit.app _) (𝟙 (B₀.obj U))))
              (η_q.naturality (B₀.map g).op)
            have hu : (AddCommGrpCat.free.map (yoneda.map (B₀.map g) |>.app (Opposite.op (B₀.obj V)))).hom
                ((AddCommGrpCat.adj.unit.app _) (𝟙 (B₀.obj V))) =
                (AddCommGrpCat.adj.unit.app _) (B₀.map g) := by
              have hunit := congrArg (fun m => m (𝟙 (B₀.obj V)))
                (AddCommGrpCat.adj.unit.naturality (yoneda.map (B₀.map g) |>.app (Opposite.op (B₀.obj V))))
              have hid : (yoneda.map (B₀.map g) |>.app (Opposite.op (B₀.obj V))) (𝟙 (B₀.obj V)) =
                  B₀.map g := show 𝟙 (B₀.obj V) ≫ B₀.map g = B₀.map g from Category.id_comp _
              exact hunit.symm.trans (congrArg (AddCommGrpCat.adj.unit.app _) hid)
            have hu' : (AddCommGrpCat.free.map ((yoneda.obj (B₀.obj U)).map (B₀.map g).op)).hom
                ((AddCommGrpCat.adj.unit.app _) (𝟙 (B₀.obj U))) =
                (AddCommGrpCat.adj.unit.app _) (B₀.map g) := by
              have hunit := congrArg (fun m => m (𝟙 (B₀.obj U)))
                (AddCommGrpCat.adj.unit.naturality ((yoneda.obj (B₀.obj U)).map (B₀.map g).op))
