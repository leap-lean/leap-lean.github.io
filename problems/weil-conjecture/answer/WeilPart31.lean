            change (if h₁' : P_W W₁ X.unop then α₁.app X k ⟨h₁'⟩ else 0) +
              (if h₂' : P_W W₂ X.unop then α₂.app X k ⟨h₂'⟩ else 0) = 0 at hk_ev
            by_cases h₁ : P_W W₁ X.unop
            · rw [dif_pos ((hP_inf W₁ W₂ X.unop).mpr ⟨h₁, h₂⟩)]
