        φ₁ α = φ₁ α * (u₀ * v₀) := by rw [hu₀v₀, mul_one]
        _ = (φ₁ α * u₀) * v₀ := (mul_assoc _ _ _).symm
        _ = (φ₂ α * u₀) * v₀ := by rw [hα]
        _ = φ₂ α * (u₀ * v₀) := mul_assoc _ _ _
        _ = φ₂ α := by rw [hu₀v₀, mul_one]
    · intro ψ
      let φ : CategoryTheory.Abelian.Ext.{u} oneR G 0 →+ ZMod m :=
