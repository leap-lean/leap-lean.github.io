        (ψ_Z.hom.app (Opposite.op T_Z)) = ι₀_Z :=
      (CategoryTheory.Adjunction.homEquiv_unit adj_Z R_mod ℒ_Z ψ_Z).symm.trans
        ((adj_Z.homEquiv R_mod ℒ_Z).apply_symm_apply ι₀_Z)
    have hφ_yon : CategoryTheory.CategoryStruct.comp ι₀_Z
        (φ_Z.hom.app (Opposite.op T_Z)) = adj_Z.unit.app R_mod :=
      (hYonEvalZ φ_Z).symm.trans
        (CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply (adj_Z.unit.app R_mod))
    have hφψ : CategoryTheory.CategoryStruct.comp φ_Z ψ_Z =
        CategoryTheory.CategoryStruct.id ℒ_Z :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
        ((hYonEvalZ (CategoryTheory.CategoryStruct.comp φ_Z ψ_Z)).trans
          ((CategoryTheory.Category.assoc ι₀_Z (φ_Z.hom.app (Opposite.op T_Z))
            (ψ_Z.hom.app (Opposite.op T_Z))).symm.trans
            ((congrArg (fun x => CategoryTheory.CategoryStruct.comp x
              (ψ_Z.hom.app (Opposite.op T_Z))) hφ_yon).trans hψ_unit)))
    have hψφ : CategoryTheory.CategoryStruct.comp ψ_Z φ_Z =
        CategoryTheory.CategoryStruct.id One_Z :=
      (adj_Z.homEquiv R_mod One_Z).injective
        ((adj_Z.homEquiv_naturality_right ψ_Z φ_Z).trans
          ((congrArg (fun x => CategoryTheory.CategoryStruct.comp x
            (φ_Z.hom.app (Opposite.op T_Z)))
            ((adj_Z.homEquiv R_mod ℒ_Z).apply_symm_apply ι₀_Z)).trans
            (hφ_yon.trans
              ((CategoryTheory.Category.comp_id (adj_Z.unit.app R_mod)).symm.trans
                (CategoryTheory.Adjunction.homEquiv_unit adj_Z R_mod One_Z
                  (CategoryTheory.CategoryStruct.id One_Z)).symm))))

    let η_Z : Quiver.Hom (iV_push.obj One_Z) (R_sh.obj (iY_push.obj One_Z)) :=
      CategoryTheory.CategoryStruct.comp η (R_sh.map (iY_push.map φ_Z))
    refine ⟨η_Z, fun ℱ => ?_, ?_⟩
    · let e_pre : Quiver.Hom (iY_push.obj One_Z) ℱ ≃ Quiver.Hom (iY_push.obj ℒ_Z) ℱ :=
        { toFun := fun f => CategoryTheory.CategoryStruct.comp (iY_push.map φ_Z) f
          invFun := fun g => CategoryTheory.CategoryStruct.comp (iY_push.map ψ_Z) g
          left_inv := fun f =>
            (CategoryTheory.Category.assoc (iY_push.map ψ_Z) (iY_push.map φ_Z) f).symm.trans
              ((congrArg (fun x => CategoryTheory.CategoryStruct.comp x f)
                ((iY_push.map_comp ψ_Z φ_Z).symm.trans
                  ((congrArg iY_push.map hψφ).trans (iY_push.map_id One_Z)))).trans
                (CategoryTheory.Category.id_comp f))
          right_inv := fun g =>
            (CategoryTheory.Category.assoc (iY_push.map φ_Z) (iY_push.map ψ_Z) g).symm.trans
              ((congrArg (fun x => CategoryTheory.CategoryStruct.comp x g)
                ((iY_push.map_comp φ_Z ψ_Z).symm.trans
                  ((congrArg iY_push.map hφψ).trans (iY_push.map_id ℒ_Z)))).trans
                (CategoryTheory.Category.id_comp g)) }
      have hEqFn : (fun f : Quiver.Hom (iY_push.obj One_Z) ℱ =>
          CategoryTheory.CategoryStruct.comp η_Z (R_sh.map f)) =
        (fun g : Quiver.Hom (iY_push.obj ℒ_Z) ℱ =>
          CategoryTheory.CategoryStruct.comp η (R_sh.map g)) ∘ e_pre :=
        funext fun f =>
          (CategoryTheory.Category.assoc η (R_sh.map (iY_push.map φ_Z)) (R_sh.map f)).trans
            (congrArg (CategoryTheory.CategoryStruct.comp η)
              (R_sh.map_comp (iY_push.map φ_Z) f).symm)
      rw [hEqFn]
      exact (hBij_η ℱ).comp e_pre.bijective
    · apply (adj_V.homEquiv R_mod (R_sh.obj (iY_push.obj One_Z))).injective
      let μ_V' : Quiver.Hom (B_iY.obj (Sigma_ψ.obj T_V)) T_Z := μ_V
      have hη_term' : adj_V.homEquiv R_mod (R_sh.obj (iY_push.obj ℒ_Z))
          (CategoryTheory.CategoryStruct.comp q_iV η) =
        CategoryTheory.CategoryStruct.comp ι₀_Z (ℒ_Z.obj.map μ_V'.op) := hη_term
      have hLHS : adj_V.homEquiv R_mod (R_sh.obj (iY_push.obj One_Z))
          (CategoryTheory.CategoryStruct.comp q_iV η_Z) =
        CategoryTheory.CategoryStruct.comp (adj_Z.unit.app R_mod)
          (One_Z.obj.map μ_V'.op) :=
        (congrArg (adj_V.homEquiv R_mod (R_sh.obj (iY_push.obj One_Z)))
          (CategoryTheory.Category.assoc q_iV η (R_sh.map (iY_push.map φ_Z))).symm).trans
          ((adj_V.homEquiv_naturality_right
            (CategoryTheory.CategoryStruct.comp q_iV η)
            (R_sh.map (iY_push.map φ_Z))).trans
            ((congrArg (fun x => CategoryTheory.CategoryStruct.comp x
              (φ_Z.hom.app (Opposite.op (B_iY.obj (Sigma_ψ.obj T_V))))) hη_term').trans
              ((CategoryTheory.Category.assoc ι₀_Z (ℒ_Z.obj.map μ_V'.op) _).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp ι₀_Z)
                  (φ_Z.hom.naturality μ_V'.op)).trans
                  ((CategoryTheory.Category.assoc ι₀_Z (φ_Z.hom.app (Opposite.op T_Z))
                    (One_Z.obj.map μ_V'.op)).symm.trans
                    (congrArg (fun x => CategoryTheory.CategoryStruct.comp x
                      (One_Z.obj.map μ_V'.op)) hφ_yon))))))
      let τ_YV : Quiver.Hom (Sigma_ψ.obj T_V) T_Y := hT_Y.from (Sigma_ψ.obj T_V)
      let τ_ZY : Quiver.Hom (B_iY.obj T_Y) T_Z := hT_Z.from (B_iY.obj T_Y)
      have hα : adj_V.homEquiv R_mod (R_sh.obj One_Y) α_ψ =
          CategoryTheory.CategoryStruct.comp (adj_Y.unit.app R_mod)
            (One_Y.obj.map τ_YV.op) :=
        (adj_V.homEquiv R_mod (R_sh.obj One_Y)).apply_symm_apply _
      have hqY : CategoryTheory.CategoryStruct.comp (adj_Y.unit.app R_mod)
          (q_iY.hom.app (Opposite.op T_Y)) =
        CategoryTheory.CategoryStruct.comp (adj_Z.unit.app R_mod)
          (One_Z.obj.map τ_ZY.op) :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_Y R_mod (iY_push.obj One_Z) q_iY).symm.trans
          ((adj_Y.homEquiv R_mod (iY_push.obj One_Z)).apply_symm_apply _)
      have hRHS : adj_V.homEquiv R_mod (R_sh.obj (iY_push.obj One_Z))
          (CategoryTheory.CategoryStruct.comp α_ψ (R_sh.map q_iY)) =
        CategoryTheory.CategoryStruct.comp (adj_Z.unit.app R_mod)
          (One_Z.obj.map (CategoryTheory.CategoryStruct.comp (B_iY.map τ_YV) τ_ZY).op) :=
        (adj_V.homEquiv_naturality_right α_ψ (R_sh.map q_iY)).trans
          ((congrArg (fun x => CategoryTheory.CategoryStruct.comp x
            (q_iY.hom.app (Opposite.op (Sigma_ψ.obj T_V)))) hα).trans
            ((CategoryTheory.Category.assoc (adj_Y.unit.app R_mod) (One_Y.obj.map τ_YV.op) _).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp (adj_Y.unit.app R_mod))
