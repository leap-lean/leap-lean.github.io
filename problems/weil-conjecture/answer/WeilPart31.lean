      have hSG : ((S.map F).map G).ShortExact := hSF.map_of_exact G
      have hSFG : (S.map (F.comp G)).ShortExact := hS.map_of_exact (F.comp G)
      let ψ_S : (S.map F).map G ⟶ S.map (F.comp G) :=
        { τ₁ := 𝟙 _, τ₂ := 𝟙 _, τ₃ := 𝟙 _, comm₁₂ := by simp, comm₂₃ := by simp }
      have hext_eq : hSG.extClass = hSFG.extClass :=
        (CategoryTheory.Abelian.Ext.comp_mk₀_id hSG.extClass).symm.trans
