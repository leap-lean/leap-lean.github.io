          PowerSeries.mk (fun r => if r = 0 then 0 else Matrix.trace (B ^ r)) := by
    have h_algClosed_trace : ∀ (L' : Type) [Field L'] [IsAlgClosed L'] (m : ℕ)
        (T : Module.End L' (Fin m → L')) (r : ℕ),
        LinearMap.trace L' (Fin m → L') (T ^ r) = ((T.charpoly.roots).map (· ^ r)).sum := by
      intro L' _ _ m T r
      classical
      have hInd : iSupIndep T.maxGenEigenspace := Module.End.independent_maxGenEigenspace T
      have hTop : iSup T.maxGenEigenspace = ⊤ := Module.End.iSup_maxGenEigenspace_eq_top T
      have hInt : DirectSum.IsInternal T.maxGenEigenspace :=
        DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top hInd hTop
      have hMaps_T : ∀ μ : L', Set.MapsTo ⇑T ↑(T.maxGenEigenspace μ) ↑(T.maxGenEigenspace μ) := by
        intro μ x hx
        rw [SetLike.mem_coe, Module.End.mem_maxGenEigenspace] at hx ⊢
        rcases hx with ⟨k, hk⟩
