            ((G₂.obj.map (v_pt pt).op).hom ((α.hom.app (Opposite.op V₀)).hom s₀)) -
          (G₂.obj.map h_w.op).hom ((G₂.obj.map (v_pt pt).op).hom t₀) = 0
        rw [hnat', hs₀_res pt, hs_fam pt, sub_self]
      have hLocSurj_pf : Sheaf.IsLocallySurjective (pf₀.map α) := by
        refine ⟨fun {U} t => ?_⟩
        let pt₀ : ↥S_Ω := ⟨⊥, Ideal.isPrime_bot⟩
