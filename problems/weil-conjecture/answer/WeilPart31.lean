  have hfΔ_pure : ∀ (i j : ℕ) (hij : i + j = 2 * d) (u : (M i).V) (w : (M j).V),
      fΔ (2 * d) (cup_P i j (2 * d) hij (fp₁ i u) (fp₂ j w)) = cup_X i j (2 * d) hij u w := by
    intro i j hij u w
    have hu : fΔ i (fp₁ i u) = u := LinearMap.congr_fun (hcomp_Δ₁ i) u
    have hw : fΔ j (fp₂ j w) = w := LinearMap.congr_fun (hcomp_Δ₂ j) w
    rw [hCup_nat Δ i j (2 * d) hij (H_X i) (H_X j) (H_X (2 * d))
        (H_P i) (H_P j) (H_P (2 * d)) (fΔ i) (fΔ j) (fΔ (2 * d))
        (cup_X i j (2 * d) hij) (cup_P i j (2 * d) hij)
        (hfΔ i) (hfΔ j) (hfΔ (2 * d))
        (hcup_X i j (2 * d) hij) (hcup_P i j (2 * d) hij), hu, hw]
  have hfΓ_pure : ∀ (i j : ℕ) (hij : i + j = 2 * d) (u : (M i).V) (w : (M j).V),
      fΓ (2 * d) (cup_P i j (2 * d) hij (fp₁ i u) (fp₂ j w)) =
        cup_X i j (2 * d) hij u (((M j).frob ^ n) w) := by
    intro i j hij u w
    have hu : fΓ i (fp₁ i u) = u := LinearMap.congr_fun (hcomp_Γ₁ i) u
    have hw : fΓ j (fp₂ j w) = ((M j).frob ^ n) w := LinearMap.congr_fun (hcomp_Γ₂ j) w
    rw [hCup_nat Γ_φ i j (2 * d) hij (H_X i) (H_X j) (H_X (2 * d))
        (H_P i) (H_P j) (H_P (2 * d)) (fΓ i) (fΓ j) (fΓ (2 * d))
        (cup_X i j (2 * d) hij) (cup_P i j (2 * d) hij)
        (hfΓ i) (hfΓ j) (hfΓ (2 * d))
        (hcup_X i j (2 * d) hij) (hcup_P i j (2 * d) hij), hu, hw]
  
  obtain ⟨hvanish_gen, hspan_gen⟩ :=
    weil_lefschetz_cd_vanishing_and_kunneth_span (AlgebraicClosure K) d X hIntX ℓ hUnit_ℓ
  obtain ⟨η_X, η_P, hB_bij, hProdTr⟩ :=
    weil_lefschetz_poincare_trace_and_product (AlgebraicClosure K) d X hIntX ℓ hUnit_ℓ H_X H_P
      (fp₁ (2 * d)) (fp₂ (2 * d)) (hfp₁ (2 * d)) (hfp₂ (2 * d))
      (fun i j hij => cup_X i j (2 * d) hij) (fun i j hij => hcup_X i j (2 * d) hij)
      (cup_P (2 * d) (2 * d) (4 * d) (by omega)) (hcup_P (2 * d) (2 * d) (4 * d) (by omega))
  obtain ⟨γ, hGysin, hDiagCard⟩ :=
    weil_lefschetz_transversal_graph_gysin_class (AlgebraicClosure K) d X hIntX ℓ hUnit_ℓ H_X H_P
      (fp₁ (2 * d)) (fp₂ (2 * d)) (hfp₁ (2 * d)) (hfp₂ (2 * d))
      (fun i j hij => cup_X i j (2 * d) hij) (fun i j hij => hcup_X i j (2 * d) hij)
      (cup_P (2 * d) (2 * d) (4 * d) (by omega)) (hcup_P (2 * d) (2 * d) (4 * d) (by omega))
      η_X η_P hB_bij hProdTr φ hφ hW_fin hW_et
      (fΔ (2 * d)) (fΓ (2 * d)) (hfΔ (2 * d)) (hfΓ (2 * d))
  rw [← hW_card]
  exact h_engine (fun i => (M i).V) (fun i => (H_P i).V) (fun i => (M i).frob ^ n)
    fp₁ fp₂ (fΔ (2 * d)) (fΓ (2 * d)) cup_X cup_P
    (fun a b c hab hba x y => hCup_comm X.left a b c hab hba (H_X a) (H_X b) (H_X c)
      (cup_X a b c hab) (cup_X b a c hba) (hcup_X a b c hab) (hcup_X b a c hba) x y)
    (fun a b c hab hba x y => hCup_comm P a b c hab hba (H_P a) (H_P b) (H_P c)
      (cup_P a b c hab) (cup_P b a c hba) (hcup_P a b c hab) (hcup_P b a c hba) x y)
    (fun a b c ab bc abc hab hbc hab_c ha_bc x y z =>
      hCup_assoc P a b c ab bc abc hab hbc hab_c ha_bc
        (H_P a) (H_P b) (H_P c) (H_P ab) (H_P bc) (H_P abc)
        (cup_P a b ab hab) (cup_P b c bc hbc) (cup_P ab c abc hab_c) (cup_P a bc abc ha_bc)
        (hcup_P _ _ _ _) (hcup_P _ _ _ _) (hcup_P _ _ _ _) (hcup_P _ _ _ _) x y z)
    (fun a b c hab x y => hCup_nat p₁ a b c hab (H_P a) (H_P b) (H_P c)
      (H_X a) (H_X b) (H_X c) (fp₁ a) (fp₁ b) (fp₁ c)
      (cup_P a b c hab) (cup_X a b c hab) (hfp₁ a) (hfp₁ b) (hfp₁ c)
      (hcup_P _ _ _ _) (hcup_X _ _ _ _) x y)
    (fun a b c hab x y => hCup_nat p₂ a b c hab (H_P a) (H_P b) (H_P c)
      (H_X a) (H_X b) (H_X c) (fp₂ a) (fp₂ b) (fp₂ c)
      (cup_P a b c hab) (cup_X a b c hab) (hfp₂ a) (hfp₂ b) (hfp₂ c)
      (hcup_P _ _ _ _) (hcup_X _ _ _ _) x y)
    hfΔ_pure hfΓ_pure
    (fun m hm v => hvanish_gen m hm (H_X m) v)
    (hspan_gen H_X H_P fp₁ fp₂ hfp₁ hfp₂
      (fun i j hij => cup_P i j (2 * d) hij) (fun i j hij => hcup_P i j (2 * d) hij))
    η_X η_P hB_bij hProdTr _ γ hGysin hDiagCard

theorem weil_etale_cohomology_grothendieck_package (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.GeometricallyIrreducible Z.hom]
    [AlgebraicGeometry.IsProper Z.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d Z.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar K) :
    ∃ M : ∀ i : ℕ, WeilEllAdicCohomologyModel K Z ℓ i,
      (((M 0).frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)) = {1} ∧
      (∀ i ≤ 2 * d,
        (((M (2 * d - i)).frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)) =
          ((((M i).frob).charpoly).aroots (AlgebraicClosure (Padic ℓ))).map
            ((Nat.card K : AlgebraicClosure (Padic ℓ)) ^ d / ·)) ∧
      (∀ n : ℕ, 1 ≤ n →
        (weilPointCount K Z n : Padic ℓ) =
          ∑ i ∈ Finset.Iic (2 * d),
            (-1) ^ i * LinearMap.trace (Padic ℓ) (M i).V ((M i).frob ^ n)) :=
by
  classical
  have h1 : 1 < Nat.card K := Finite.one_lt_card
  have hq_ne : Nat.card K ≠ 0 := by omega
  have hq_padic : (Nat.card K : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hq_ne
  let c : Padic ℓ := (Nat.card K : Padic ℓ) ^ d
  have hc : c ≠ 0 := pow_ne_zero d hq_padic
  let M : ∀ i : ℕ, WeilEllAdicCohomologyModel K Z ℓ i := fun i =>
    Classical.choice
      (weil_etale_model_of_torsion_finite K Z ℓ i
        (weil_etale_proper_torsion_finiteness K Z d ℓ hℓ i))
  refine ⟨M, weil_etale_degree_zero_frob_roots K Z d ℓ hℓ (M 0), ?_, ?_⟩
  · intro i hi
    obtain ⟨B, hB, hEquiv⟩ :=
      weil_etale_poincare_duality_pairing K Z d ℓ hℓ i hi (M i) (M (2 * d - i))
    let Φ : (M i).V →ₗ[Padic ℓ] (M i).V := (M i).frob
    let Ψ : (M (2 * d - i)).V →ₗ[Padic ℓ] (M (2 * d - i)).V := (M (2 * d - i)).frob
    have hΦ_inj : Function.Injective Φ := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro x hx
      rw [LinearMap.mem_ker] at hx
      apply hB.injective
      ext y
      have h0 : c * B x y = 0 := by
        dsimp [c]
        rw [← hEquiv x y]
        change B (Φ x) (Ψ y) = 0
        rw [hx, map_zero, LinearMap.zero_apply]
      simpa [hc] using h0
    have hΦ_bij : Function.Bijective Φ := ⟨hΦ_inj, LinearMap.injective_iff_surjective.mp hΦ_inj⟩
    let eΦ : (M i).V ≃ₗ[Padic ℓ] (M i).V := LinearEquiv.ofBijective Φ hΦ_bij
    let eB : (M i).V ≃ₗ[Padic ℓ] Module.Dual (Padic ℓ) (M (2 * d - i)).V :=
      LinearEquiv.ofBijective B hB
    have hTrans : Module.Dual.transpose Ψ = eB.conj (c • eΦ.symm.toLinearMap) := by
      ext f y
      have hf : eB (eB.symm f) = f := eB.apply_symm_apply f
      have hx : Φ (eΦ.symm (eB.symm f)) = eB.symm f := eΦ.apply_symm_apply (eB.symm f)
      change f (Ψ y) = (eB (c • eΦ.symm (eB.symm f))) y
      calc
        f (Ψ y) = (eB (eB.symm f)) (Ψ y) := by rw [hf]
        _ = B (Φ (eΦ.symm (eB.symm f))) (Ψ y) := by rw [hx]; rfl
        _ = c * B (eΦ.symm (eB.symm f)) y := hEquiv _ y
        _ = (eB (c • eΦ.symm (eB.symm f))) y := by simp [eB, smul_eq_mul]
    let bW := Module.Free.chooseBasis (Padic ℓ) (M (2 * d - i)).V
    have hCharΨ : Ψ.charpoly = (c • eΦ.symm.toLinearMap).charpoly := by
      calc
        Ψ.charpoly = (LinearMap.toMatrix bW bW Ψ).charpoly :=
          (LinearMap.charpoly_toMatrix Ψ bW).symm
        _ = (LinearMap.toMatrix bW bW Ψ).transpose.charpoly :=
          (Matrix.charpoly_transpose _).symm
        _ = (LinearMap.toMatrix bW.dualBasis bW.dualBasis (Module.Dual.transpose Ψ)).charpoly := by
          rw [LinearMap.toMatrix_transpose]
        _ = (Module.Dual.transpose Ψ).charpoly :=
          LinearMap.charpoly_toMatrix (Module.Dual.transpose Ψ) bW.dualBasis
        _ = (eB.conj (c • eΦ.symm.toLinearMap)).charpoly := by rw [hTrans]
        _ = (c • eΦ.symm.toLinearMap).charpoly := LinearEquiv.charpoly_conj eB _
    let bV := Module.Free.chooseBasis (Padic ℓ) (M i).V
    let A := LinearMap.toMatrix bV bV Φ
    let A_inv := LinearMap.toMatrix bV bV eΦ.symm.toLinearMap
    have hA_mul : A_inv * A = 1 := by
      dsimp [A, A_inv]
      rw [← LinearMap.toMatrix_comp bV bV bV, ← LinearMap.toMatrix_id bV]
      congr 1
      ext v
      exact eΦ.symm_apply_apply v
    let σ : Padic ℓ →+* AlgebraicClosure (Padic ℓ) :=
      algebraMap (Padic ℓ) (AlgebraicClosure (Padic ℓ))
    let cbar : AlgebraicClosure (Padic ℓ) := σ c
    let Abar := A.map σ
    let Ainv_bar := A_inv.map σ
    have hAbar_mul : Ainv_bar * Abar = 1 := by
      dsimp [Abar, Ainv_bar]
      rw [← Matrix.map_mul, hA_mul]
      ext u v
      simp [Matrix.one_apply]
    have hdet_mul : Ainv_bar.det * Abar.det = 1 := by
      rw [← Matrix.det_mul, hAbar_mul, Matrix.det_one]
    have hdetA : Abar.det ≠ 0 := right_ne_zero_of_mul_eq_one hdet_mul
    have hP_eq : (Φ.charpoly).map σ = Abar.charpoly := by
      rw [← LinearMap.charpoly_toMatrix Φ bV, Matrix.charpoly_map]
    have hQ_eq : (Ψ.charpoly).map σ = (cbar • Ainv_bar).charpoly := by
      rw [hCharΨ, ← LinearMap.charpoly_toMatrix (c • eΦ.symm.toLinearMap) bV,
        ← Matrix.charpoly_map]
      congr 1
      ext u v
      simp [Ainv_bar, A_inv, cbar, σ]
    let P : Polynomial (AlgebraicClosure (Padic ℓ)) := Abar.charpoly
    let Q : Polynomial (AlgebraicClosure (Padic ℓ)) := (cbar • Ainv_bar).charpoly
    let R : Multiset (AlgebraicClosure (Padic ℓ)) := P.roots
    let r : ℕ := Fintype.card (Module.Free.ChooseBasisIndex (Padic ℓ) (M i).V)
    have hP_monic : P.Monic := Matrix.charpoly_monic Abar
    have hP_splits : P.Splits := IsAlgClosed.splits P
    have hP_deg : P.natDegree = r := Matrix.charpoly_natDegree_eq_dim Abar
    have hR_card : R.card = r := by
      dsimp [R]
      rw [← hP_splits.natDegree_eq_card_roots, hP_deg]
    have hP_eval : ∀ z : AlgebraicClosure (Padic ℓ), P.eval z = (R.map (fun α => z - α)).prod :=
      hP_splits.eval_eq_prod_roots_of_monic hP_monic
    have hdet_eq_prod : Abar.det = R.prod := by
      have h_ev1 : P.eval 0 = (-1 : AlgebraicClosure (Padic ℓ)) ^ r * Abar.det := by
        dsimp [P]
        rw [Matrix.eval_charpoly]
        have hmat : Matrix.scalar (Module.Free.ChooseBasisIndex (Padic ℓ) (M i).V)
            (0 : AlgebraicClosure (Padic ℓ)) - Abar =
            (-1 : AlgebraicClosure (Padic ℓ)) • Abar := by
          ext u v; simp
        rw [hmat, Matrix.det_smul]
      have h_ev2 : P.eval 0 = (-1 : AlgebraicClosure (Padic ℓ)) ^ r * R.prod := by
        rw [hP_eval 0]
        have hmap : R.map (fun α : AlgebraicClosure (Padic ℓ) =>
            (0 : AlgebraicClosure (Padic ℓ)) - α) =
            R.map (fun α : AlgebraicClosure (Padic ℓ) =>
              (-1 : AlgebraicClosure (Padic ℓ)) * α) := by
          congr 1; ext α; ring
        rw [hmap, Multiset.prod_map_mul]
        simp [hR_card]
      have hsign : (-1 : AlgebraicClosure (Padic ℓ)) ^ r ≠ 0 :=
        pow_ne_zero r (neg_ne_zero.mpr one_ne_zero)
      exact mul_left_cancel₀ hsign (h_ev1.symm.trans h_ev2)
    have hR_ne_zero : ∀ α ∈ R, α ≠ 0 := by
      intro α hα hα0
      apply hdetA
      rw [hdet_eq_prod]
      exact Multiset.prod_eq_zero (hα0 ▸ hα)
    let Q2 : Polynomial (AlgebraicClosure (Padic ℓ)) :=
      ((R.map (cbar / ·)).map (fun β => Polynomial.X - Polynomial.C β)).prod
    have hQ_eq_Q2 : Q = Q2 := by
      apply Polynomial.funext
      intro t
      apply mul_right_cancel₀ hdetA
      have hLHS_mat : Q.eval t * Abar.det =
          (t • Abar - Matrix.scalar (Module.Free.ChooseBasisIndex (Padic ℓ) (M i).V) cbar).det := by
        dsimp [Q]
        rw [Matrix.eval_charpoly, ← Matrix.det_mul]
        congr 1
        rw [sub_mul]
        have hm1 : Matrix.scalar (Module.Free.ChooseBasisIndex (Padic ℓ) (M i).V) t * Abar =
            t • Abar := by
          ext u v; simp [Matrix.scalar_apply, Matrix.diagonal_mul]
        have hm2 : (cbar • Ainv_bar) * Abar =
            Matrix.scalar (Module.Free.ChooseBasisIndex (Padic ℓ) (M i).V) cbar := by
          rw [Matrix.smul_mul, hAbar_mul]
          ext u v; simp [Matrix.scalar_apply, Matrix.diagonal_apply, Matrix.one_apply]
        rw [hm1, hm2]
        rfl
      have hRHS_prod : Q2.eval t * Abar.det = (R.map (fun α => t * α - cbar)).prod := by
        dsimp [Q2]
        rw [Polynomial.eval_multiset_prod, Multiset.map_map, Multiset.map_map]
        have heval_map : R.map
            ((Polynomial.eval t ∘ fun β => Polynomial.X - Polynomial.C β) ∘ (cbar / ·)) =
            R.map (fun α => t - cbar / α) := by
          congr 1; ext α; simp
        have hR_id : R.prod = (R.map (fun α => α)).prod := by
          rw [Multiset.map_id']
        rw [heval_map, hdet_eq_prod, hR_id, ← Multiset.prod_map_mul]
        congr 1
        apply Multiset.map_congr rfl
        intro α hα
        have hα_ne : α ≠ 0 := hR_ne_zero α hα
        simp only [sub_mul, div_mul_cancel₀ cbar hα_ne]
      rw [hLHS_mat, hRHS_prod]
      by_cases ht : t = 0
      · subst ht
        have hmat0 : (0 : AlgebraicClosure (Padic ℓ)) • Abar -
            Matrix.scalar (Module.Free.ChooseBasisIndex (Padic ℓ) (M i).V) cbar =
            (-cbar) • (1 : Matrix (Module.Free.ChooseBasisIndex (Padic ℓ) (M i).V)
              (Module.Free.ChooseBasisIndex (Padic ℓ) (M i).V)
              (AlgebraicClosure (Padic ℓ))) := by
          ext u v
          simp only [zero_smul, zero_sub, Matrix.neg_apply, Matrix.scalar_apply,
            Matrix.diagonal_apply, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
          split_ifs <;> ring
        rw [hmat0, Matrix.det_smul, Matrix.det_one, mul_one]
        have hmap0 : R.map (fun α : AlgebraicClosure (Padic ℓ) =>
            (0 : AlgebraicClosure (Padic ℓ)) * α - cbar) =
            Multiset.replicate R.card (-cbar) := by
          rw [← Multiset.map_const']
          congr 1; ext α; ring
        rw [hmap0, Multiset.prod_replicate, hR_card]
      · have htc : (-t) * (cbar / t) = -cbar := by
          rw [neg_mul, mul_div_cancel₀ cbar ht]
        have hmat_t : t • Abar -
            Matrix.scalar (Module.Free.ChooseBasisIndex (Padic ℓ) (M i).V) cbar =
            (-t) • (Matrix.scalar (Module.Free.ChooseBasisIndex (Padic ℓ) (M i).V)
              (cbar / t) - Abar) := by
          ext u v
          simp only [Matrix.sub_apply, Matrix.smul_apply, Matrix.scalar_apply,
            Matrix.diagonal_apply, smul_eq_mul, mul_sub]
          split_ifs
          · rw [htc]; ring
          · ring
        rw [hmat_t, Matrix.det_smul, ← Matrix.eval_charpoly Abar (cbar / t)]
        change (-t) ^ r * P.eval (cbar / t) = _
        rw [hP_eval (cbar / t), ← hR_card, ← Multiset.prod_replicate, ← Multiset.map_const',
          ← Multiset.prod_map_mul]
        congr 1
        apply Multiset.map_congr rfl
        intro α _
        rw [mul_sub, htc]
        ring
    have hcbar_val : cbar = (Nat.card K : AlgebraicClosure (Padic ℓ)) ^ d := by
      simp [cbar, σ, c]
    change (Ψ.charpoly).aroots (AlgebraicClosure (Padic ℓ)) =
      ((Φ.charpoly).aroots (AlgebraicClosure (Padic ℓ))).map
        ((Nat.card K : AlgebraicClosure (Padic ℓ)) ^ d / ·)
    rw [← hcbar_val, Polynomial.aroots_def, Polynomial.aroots_def, hQ_eq, hP_eq]
    change Q.roots = R.map (cbar / ·)
    rw [hQ_eq_Q2]
    exact Polynomial.roots_multiset_prod_X_sub_C (R.map (cbar / ·))
  · intro n hn
    rw [← weil_closed_frob_fixed_card_eq_pointCount K Z n hn]
    exact weil_etale_lefschetz_fixed_point_trace K Z d ℓ hℓ M n hn

theorem weil_algClosure_alteration_geometry_and_frob_alignment (F : Type u) [Finite F] [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible X.hom]
    [AlgebraicGeometry.IsProper X.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (F₁ : Type u) [Finite F₁] [Field F₁] [Algebra F F₁] [FiniteDimensional F F₁]
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F₁)))
    [AlgebraicGeometry.GeometricallyIrreducible Y.hom]
    [AlgebraicGeometry.IsProper Y.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d Y.hom]
    (φ : Y ⟶ weilBaseChangeOver F F₁ X)
    (hφ_prop : AlgebraicGeometry.IsProper φ.left)
    (hφ_surj : AlgebraicGeometry.Surjective φ.left)
    (U : (weilBaseChangeOver F F₁ X).left.Opens)
    (hU_ne : Nonempty U)
    (hU_fin : AlgebraicGeometry.IsFinite (φ.left ∣_ U))
    (hU_et : AlgebraicGeometry.Etale (φ.left ∣_ U))
    (hU_surj : AlgebraicGeometry.Surjective (φ.left ∣_ U)) :
    ∃ (X_bar₁ : CategoryTheory.Over
        (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F₁))))
      (ψ : weilBaseChangeOver F₁ (AlgebraicClosure F₁) Y ⟶ X_bar₁)
      (U_bar : X_bar₁.left.Opens)
      (σ : X_bar₁.left ≅ weilGeomScheme F X),
      IrreducibleSpace X_bar₁.left ∧
      AlgebraicGeometry.IsProper X_bar₁.hom ∧
      AlgebraicGeometry.SmoothOfRelativeDimension d X_bar₁.hom ∧
      IrreducibleSpace (weilBaseChangeOver F₁ (AlgebraicClosure F₁) Y).left ∧
      AlgebraicGeometry.IsProper (weilBaseChangeOver F₁ (AlgebraicClosure F₁) Y).hom ∧
      AlgebraicGeometry.SmoothOfRelativeDimension d
        (weilBaseChangeOver F₁ (AlgebraicClosure F₁) Y).hom ∧
      AlgebraicGeometry.IsProper ψ.left ∧
      AlgebraicGeometry.Surjective ψ.left ∧
      Nonempty U_bar ∧
      AlgebraicGeometry.IsFinite (ψ.left ∣_ U_bar) ∧
      AlgebraicGeometry.Etale (ψ.left ∣_ U_bar) ∧
      AlgebraicGeometry.Surjective (ψ.left ∣_ U_bar) ∧
      CategoryTheory.CategoryStruct.comp (weilGeomFrobHom F₁ Y)
          (CategoryTheory.CategoryStruct.comp ψ.left σ.hom) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp ψ.left σ.hom)
          (weilSchemeEndPow (weilGeomFrobHom F X) (Module.finrank F F₁)) :=
by
  
  let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F F₁))
  let X₁ := weilBaseChangeOver F F₁ X
  let fst₁ : X₁.left ⟶ X.left := CategoryTheory.Limits.pullback.fst X.hom s₀
  let snd₁ : X₁.left ⟶ AlgebraicGeometry.Spec (CommRingCat.of F₁) := X₁.hom
  have hp₀ : CategoryTheory.IsPullback fst₁ X₁.hom X.hom s₀ :=
    CategoryTheory.IsPullback.of_hasPullback X.hom s₀
  have : AlgebraicGeometry.GeometricallyIrreducible X₁.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.GeometricallyIrreducible) hp₀ inferInstance
  have : AlgebraicGeometry.IsProper X₁.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsProper) hp₀ inferInstance
  have : AlgebraicGeometry.SmoothOfRelativeDimension d X₁.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.SmoothOfRelativeDimension d) hp₀ inferInstance
  let X_bar₁ := weilBaseChangeOver F₁ (AlgebraicClosure F₁) X₁
  let Y_bar := weilBaseChangeOver F₁ (AlgebraicClosure F₁) Y
  let s₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F₁ (AlgebraicClosure F₁)))
  let p_Y : Y_bar.left ⟶ Y.left := CategoryTheory.Limits.pullback.fst Y.hom s₁
  let q_Y : Y_bar.left ⟶ AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F₁)) := Y_bar.hom
  let p_X₁ : X_bar₁.left ⟶ X₁.left := CategoryTheory.Limits.pullback.fst X₁.hom s₁
  let q_X₁ : X_bar₁.left ⟶ AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F₁)) := X_bar₁.hom
  have hpY : CategoryTheory.IsPullback p_Y q_Y Y.hom s₁ :=
    CategoryTheory.IsPullback.of_hasPullback Y.hom s₁
  have hpX₁ : CategoryTheory.IsPullback p_X₁ q_X₁ X₁.hom s₁ :=
    CategoryTheory.IsPullback.of_hasPullback X₁.hom s₁
  have : AlgebraicGeometry.GeometricallyIrreducible X_bar₁.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.GeometricallyIrreducible) hpX₁ inferInstance
  have hPropX : AlgebraicGeometry.IsProper X_bar₁.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsProper) hpX₁ inferInstance
  have hSmX : AlgebraicGeometry.SmoothOfRelativeDimension d X_bar₁.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.SmoothOfRelativeDimension d) hpX₁ inferInstance
  have hIrrX : IrreducibleSpace X_bar₁.left :=
    AlgebraicGeometry.GeometricallyIrreducible.irreducibleSpace X_bar₁.hom
      (fun s _ => isOpen_discrete (⇑X_bar₁.hom '' s))
  have : AlgebraicGeometry.GeometricallyIrreducible Y_bar.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.GeometricallyIrreducible) hpY inferInstance
  have hPropY : AlgebraicGeometry.IsProper Y_bar.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsProper) hpY inferInstance
  have hSmY : AlgebraicGeometry.SmoothOfRelativeDimension d Y_bar.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.SmoothOfRelativeDimension d) hpY inferInstance
  have hIrrY : IrreducibleSpace Y_bar.left :=
    AlgebraicGeometry.GeometricallyIrreducible.irreducibleSpace Y_bar.hom
      (fun s _ => isOpen_discrete (⇑Y_bar.hom '' s))

  
  let κ₀ : AlgebraicClosure F₁ ≃ₐ[F] AlgebraicClosure F :=
    IsAlgClosure.equiv F (AlgebraicClosure F₁) (AlgebraicClosure F)
  let κ : AlgebraicClosure F₁ ≃+* AlgebraicClosure F := κ₀.toRingEquiv
  have hκ_alg : ∀ a : F, κ.symm (algebraMap F (AlgebraicClosure F) a) =
      algebraMap F₁ (AlgebraicClosure F₁) (algebraMap F F₁ a) := by
    intro a
    change κ₀.symm (algebraMap F (AlgebraicClosure F) a) = _
    rw [κ₀.symm.commutes a, IsScalarTower.algebraMap_apply F F₁ (AlgebraicClosure F₁) a]
  let I₀ : Fintype F := Fintype.ofFinite F
  let I₁ : Fintype F₁ := Fintype.ofFinite F₁
  let φ₀ := @FiniteField.frobeniusAlgEquivOfAlgebraic F _ I₀ (AlgebraicClosure F) _ _ _
  let φ₁ := @FiniteField.frobeniusAlgEquivOfAlgebraic F₁ _ I₁ (AlgebraicClosure F₁) _ _ _
  let ψ₀ := φ₀.symm
  let ψ₁ := φ₁.symm
  set q := Nat.card F
  set m := Module.finrank F F₁
  have hcard_F₁ : Nat.card F₁ = q ^ m := Module.natCard_eq_pow_finrank
  have hφ₀_apply : ∀ w : AlgebraicClosure F, φ₀ w = w ^ q := by
    intro w
    rw [@FiniteField.frobeniusAlgEquivOfAlgebraic_apply F _ I₀ (AlgebraicClosure F) _ _ _ w,
      ← @Nat.card_eq_fintype_card F I₀]
  have hφ₁_apply : ∀ x : AlgebraicClosure F₁, φ₁ x = x ^ (q ^ m) := by
    intro x
    rw [@FiniteField.frobeniusAlgEquivOfAlgebraic_apply F₁ _ I₁ (AlgebraicClosure F₁) _ _ _ x,
      ← @Nat.card_eq_fintype_card F₁ I₁, hcard_F₁]
  have hφ₀_pow : ∀ (k : ℕ) (w : AlgebraicClosure F), (φ₀ ^ k) w = w ^ (q ^ k) := by
    intro k
    induction k with
    | zero =>
      intro w
      rw [pow_zero, pow_zero, pow_one]
      rfl
    | succ k ih =>
      intro w
      rw [pow_succ' φ₀ k, AlgEquiv.mul_apply, ih w, hφ₀_apply, ← pow_mul, ← pow_succ]
  have hκ_φ : ∀ x : AlgebraicClosure F₁, κ (φ₁ x) = (φ₀ ^ m) (κ x) := by
    intro x
    rw [hφ₁_apply x, map_pow, hφ₀_pow m (κ x)]
  have hφψ_pow : ∀ (k : ℕ) (w : AlgebraicClosure F), (φ₀ ^ k) ((ψ₀ ^ k) w) = w := by
    intro k
    induction k with
    | zero =>
      intro w
      rfl
    | succ k ih =>
      intro w
      rw [pow_succ' φ₀ k, pow_succ ψ₀ k, AlgEquiv.mul_apply, AlgEquiv.mul_apply,
        ih (ψ₀ w), φ₀.apply_symm_apply]
  have hκ_frob : ∀ z : AlgebraicClosure F, ψ₁ (κ.symm z) = κ.symm ((ψ₀ ^ m) z) := by
    intro z
    apply φ₁.injective
    apply κ.injective
    rw [φ₁.apply_symm_apply, hκ_φ, κ.apply_symm_apply, κ.apply_symm_apply, hφψ_pow m z]

  
  have hψ_cond : (p_Y ≫ φ.left) ≫ X₁.hom = q_Y ≫ s₁ := by
    rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w φ]
    exact CategoryTheory.Limits.pullback.condition
  let ψ_left : Y_bar.left ⟶ X_bar₁.left :=
    CategoryTheory.Limits.pullback.lift (p_Y ≫ φ.left) q_Y hψ_cond
  let ψ : Y_bar ⟶ X_bar₁ :=
    CategoryTheory.Over.homMk ψ_left (CategoryTheory.Limits.pullback.lift_snd _ _ _)
  have hψ_fst : ψ.left ≫ p_X₁ = p_Y ≫ φ.left :=
    CategoryTheory.Limits.pullback.lift_fst (p_Y ≫ φ.left) q_Y hψ_cond
  have hψ_snd : ψ.left ≫ q_X₁ = q_Y :=
    CategoryTheory.Limits.pullback.lift_snd (p_Y ≫ φ.left) q_Y hψ_cond
  have hpY_comp : CategoryTheory.IsPullback p_Y (ψ.left ≫ q_X₁) (φ.left ≫ X₁.hom) s₁ := by
    rw [hψ_snd, CategoryTheory.Over.w φ]
    exact hpY
  have hp_ψ : CategoryTheory.IsPullback p_Y ψ.left φ.left p_X₁ :=
    CategoryTheory.IsPullback.of_bot hpY_comp hψ_fst.symm hpX₁
  have hψ_prop : AlgebraicGeometry.IsProper ψ.left :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsProper) hp_ψ hφ_prop
  have hψ_surj : AlgebraicGeometry.Surjective ψ.left :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.Surjective) hp_ψ hφ_surj
  let U_bar : X_bar₁.left.Opens := (TopologicalSpace.Opens.map p_X₁.base).obj U
  have hSurj_pX₁ : AlgebraicGeometry.Surjective p_X₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.Surjective) hpX₁.flip inferInstance
  have hUbar_ne : Nonempty U_bar := by
    obtain ⟨⟨u₀, hu₀⟩⟩ := hU_ne
    rcases hSurj_pX₁ with ⟨hSurj_fn⟩
    obtain ⟨x₀, hx₀⟩ := hSurj_fn u₀
    refine ⟨⟨x₀, ?_⟩⟩
    change p_X₁.base x₀ ∈ U
    rwa [hx₀]
  let W : Y.left.Opens := (TopologicalSpace.Opens.map φ.left.base).obj U
  let W_bar : Y_bar.left.Opens := (TopologicalSpace.Opens.map ψ.left.base).obj U_bar
  have hOpenW : (TopologicalSpace.Opens.map p_Y.base).obj W = W_bar := by
    ext y
    have hbase : (p_Y ≫ φ.left).base y = (ψ.left ≫ p_X₁).base y := by rw [hψ_fst]
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply] at hbase
    change φ.left.base (p_Y.base y) ∈ U ↔ p_X₁.base (ψ.left.base y) ∈ U
    rw [hbase]
  have hrange : Set.range ⇑(CategoryTheory.ConcreteCategory.hom (W_bar.ι ≫ p_Y).base) ⊆
      Set.range ⇑(CategoryTheory.ConcreteCategory.hom W.ι.base) := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨y, rfl⟩
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
    have hy : y.1 ∈ (TopologicalSpace.Opens.map p_Y.base).obj W := by
      rw [hOpenW]
      exact y.2
    exact hy
  let q_W : (W_bar : AlgebraicGeometry.Scheme.{u}) ⟶ (W : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.IsOpenImmersion.lift W.ι (W_bar.ι ≫ p_Y) hrange
  have hq_W : q_W ≫ W.ι = W_bar.ι ≫ p_Y :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac W.ι (W_bar.ι ≫ p_Y) hrange
  have hp_W : CategoryTheory.IsPullback q_W W_bar.ι W.ι p_Y := by
    apply AlgebraicGeometry.IsOpenImmersion.isPullback q_W W_bar.ι W.ι p_Y hq_W.symm
    rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι, AlgebraicGeometry.Scheme.Opens.opensRange_ι]
    exact hOpenW
  have hφ_res_ι : (φ.left ∣_ U) ≫ U.ι = W.ι ≫ φ.left :=
    AlgebraicGeometry.morphismRestrict_ι φ.left U
  have hψ_res_ι : (ψ.left ∣_ U_bar) ≫ U_bar.ι = W_bar.ι ≫ ψ.left :=
    AlgebraicGeometry.morphismRestrict_ι ψ.left U_bar
  have hpX₁_res_ι : (p_X₁ ∣_ U) ≫ U.ι = U_bar.ι ≫ p_X₁ :=
    AlgebraicGeometry.morphismRestrict_ι p_X₁ U
  have hp_vert : CategoryTheory.IsPullback q_W
      ((ψ.left ∣_ U_bar) ≫ U_bar.ι) ((φ.left ∣_ U) ≫ U.ι) p_X₁ := by
    have hp_v := hp_W.paste_vert hp_ψ
    rwa [← hψ_res_ι, ← hφ_res_ι] at hp_v
  have h_top_comm : q_W ≫ (φ.left ∣_ U) = (ψ.left ∣_ U_bar) ≫ (p_X₁ ∣_ U) := by
    rw [← CategoryTheory.cancel_mono U.ι]
    calc
      (q_W ≫ (φ.left ∣_ U)) ≫ U.ι
          = q_W ≫ ((φ.left ∣_ U) ≫ U.ι) := CategoryTheory.Category.assoc _ _ _
      _ = q_W ≫ (W.ι ≫ φ.left) := by rw [hφ_res_ι]
      _ = (q_W ≫ W.ι) ≫ φ.left := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (W_bar.ι ≫ p_Y) ≫ φ.left := by rw [hq_W]
      _ = W_bar.ι ≫ (p_Y ≫ φ.left) := CategoryTheory.Category.assoc _ _ _
      _ = W_bar.ι ≫ (ψ.left ≫ p_X₁) := by rw [← hψ_fst]
      _ = (W_bar.ι ≫ ψ.left) ≫ p_X₁ := (CategoryTheory.Category.assoc _ _ _).symm
      _ = ((ψ.left ∣_ U_bar) ≫ U_bar.ι) ≫ p_X₁ := by rw [← hψ_res_ι]
      _ = (ψ.left ∣_ U_bar) ≫ (U_bar.ι ≫ p_X₁) := CategoryTheory.Category.assoc _ _ _
      _ = (ψ.left ∣_ U_bar) ≫ ((p_X₁ ∣_ U) ≫ U.ι) := by rw [← hpX₁_res_ι]
      _ = ((ψ.left ∣_ U_bar) ≫ (p_X₁ ∣_ U)) ≫ U.ι :=
          (CategoryTheory.Category.assoc _ _ _).symm
  have hp_res : CategoryTheory.IsPullback q_W (ψ.left ∣_ U_bar) (φ.left ∣_ U) (p_X₁ ∣_ U) :=
    CategoryTheory.IsPullback.of_bot hp_vert h_top_comm
      (AlgebraicGeometry.isPullback_morphismRestrict p_X₁ U)
  have hUbar_fin : AlgebraicGeometry.IsFinite (ψ.left ∣_ U_bar) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsFinite) hp_res hU_fin
  have hUbar_et : AlgebraicGeometry.Etale (ψ.left ∣_ U_bar) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.Etale) hp_res hU_et
  have hUbar_surj : AlgebraicGeometry.Surjective (ψ.left ∣_ U_bar) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.Surjective) hp_res hU_surj

  
  let s_F := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))
  let u := AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ.symm.toRingHom)
  let v := AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ.toRingHom)
  have hu_v : u ≫ v = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F₁))) := by
    dsimp [u, v]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_id, ← CommRingCat.ofHom_id]
    congr 2
    ext x
    exact κ.symm_apply_apply x
  have hv_u : v ≫ u = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))) := by
    dsimp [u, v]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_id, ← CommRingCat.ofHom_id]
    congr 2
    ext z
    exact κ.apply_symm_apply z
  have hu_s : u ≫ s_F = s₁ ≫ s₀ := by
    dsimp [u, s_F, s₁, s₀]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 2
    exact RingHom.ext hκ_alg
  have hv_s : s_F = v ≫ s₁ ≫ s₀ := by
    calc
      s_F = 𝟙 _ ≫ s_F := (CategoryTheory.Category.id_comp s_F).symm
      _ = (v ≫ u) ≫ s_F := by rw [hv_u]
      _ = v ≫ (u ≫ s_F) := CategoryTheory.Category.assoc _ _ _
      _ = v ≫ s₁ ≫ s₀ := by rw [hu_s]
  let p_X₀ : weilGeomScheme F X ⟶ X.left := CategoryTheory.Limits.pullback.fst X.hom s_F
  let q_X₀ : weilGeomScheme F X ⟶ AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)) :=
    CategoryTheory.Limits.pullback.snd X.hom s_F
  have hcond₁ : fst₁ ≫ X.hom = snd₁ ≫ s₀ := CategoryTheory.Limits.pullback.condition
  have hcond_Xbar₁ : p_X₁ ≫ snd₁ = q_X₁ ≫ s₁ := CategoryTheory.Limits.pullback.condition
  have hcond_X₀ : p_X₀ ≫ X.hom = q_X₀ ≫ s_F := CategoryTheory.Limits.pullback.condition
  have hσ_hom_cond : (p_X₁ ≫ fst₁) ≫ X.hom = (q_X₁ ≫ u) ≫ s_F := by
    calc
      (p_X₁ ≫ fst₁) ≫ X.hom
          = p_X₁ ≫ (fst₁ ≫ X.hom) := CategoryTheory.Category.assoc _ _ _
      _ = p_X₁ ≫ (snd₁ ≫ s₀) := by rw [hcond₁]
      _ = (p_X₁ ≫ snd₁) ≫ s₀ := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (q_X₁ ≫ s₁) ≫ s₀ := by rw [hcond_Xbar₁]
      _ = q_X₁ ≫ (s₁ ≫ s₀) := CategoryTheory.Category.assoc _ _ _
      _ = q_X₁ ≫ (u ≫ s_F) := by rw [← hu_s]
      _ = (q_X₁ ≫ u) ≫ s_F := (CategoryTheory.Category.assoc _ _ _).symm
  let σ_hom : X_bar₁.left ⟶ weilGeomScheme F X :=
    CategoryTheory.Limits.pullback.lift (p_X₁ ≫ fst₁) (q_X₁ ≫ u) hσ_hom_cond
  have hσ_hom_fst : σ_hom ≫ p_X₀ = p_X₁ ≫ fst₁ :=
    CategoryTheory.Limits.pullback.lift_fst (p_X₁ ≫ fst₁) (q_X₁ ≫ u) hσ_hom_cond
  have hσ_hom_snd : σ_hom ≫ q_X₀ = q_X₁ ≫ u :=
    CategoryTheory.Limits.pullback.lift_snd (p_X₁ ≫ fst₁) (q_X₁ ≫ u) hσ_hom_cond
  have hw₁_cond : p_X₀ ≫ X.hom = (q_X₀ ≫ v ≫ s₁) ≫ s₀ := by
    calc
      p_X₀ ≫ X.hom = q_X₀ ≫ s_F := hcond_X₀
      _ = q_X₀ ≫ (v ≫ s₁ ≫ s₀) := congrArg (q_X₀ ≫ ·) hv_s
      _ = (q_X₀ ≫ v ≫ s₁) ≫ s₀ := by simp only [CategoryTheory.Category.assoc]
  let w₁ : weilGeomScheme F X ⟶ X₁.left :=
    CategoryTheory.Limits.pullback.lift p_X₀ (q_X₀ ≫ v ≫ s₁) hw₁_cond
  have hw₁_fst : w₁ ≫ fst₁ = p_X₀ :=
    CategoryTheory.Limits.pullback.lift_fst p_X₀ (q_X₀ ≫ v ≫ s₁) hw₁_cond
  have hw₁_snd : w₁ ≫ snd₁ = q_X₀ ≫ v ≫ s₁ :=
    CategoryTheory.Limits.pullback.lift_snd p_X₀ (q_X₀ ≫ v ≫ s₁) hw₁_cond
  have hσ_inv_cond : w₁ ≫ X₁.hom = (q_X₀ ≫ v) ≫ s₁ := by
    calc
      w₁ ≫ X₁.hom = q_X₀ ≫ v ≫ s₁ := hw₁_snd
      _ = (q_X₀ ≫ v) ≫ s₁ := (CategoryTheory.Category.assoc _ _ _).symm
  let σ_inv : weilGeomScheme F X ⟶ X_bar₁.left :=
    CategoryTheory.Limits.pullback.lift w₁ (q_X₀ ≫ v) hσ_inv_cond
  have hσ_inv_fst : σ_inv ≫ p_X₁ = w₁ :=
    CategoryTheory.Limits.pullback.lift_fst w₁ (q_X₀ ≫ v) hσ_inv_cond
  have hσ_inv_snd : σ_inv ≫ q_X₁ = q_X₀ ≫ v :=
    CategoryTheory.Limits.pullback.lift_snd w₁ (q_X₀ ≫ v) hσ_inv_cond
  have hσ_hom_inv : σ_hom ≫ σ_inv = 𝟙 X_bar₁.left := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · apply CategoryTheory.Limits.pullback.hom_ext
      · change ((σ_hom ≫ σ_inv) ≫ p_X₁) ≫ fst₁ = (𝟙 X_bar₁.left ≫ p_X₁) ≫ fst₁
        calc
          ((σ_hom ≫ σ_inv) ≫ p_X₁) ≫ fst₁
              = (σ_hom ≫ (σ_inv ≫ p_X₁)) ≫ fst₁ := by simp only [CategoryTheory.Category.assoc]
          _ = (σ_hom ≫ w₁) ≫ fst₁ := by rw [hσ_inv_fst]
          _ = σ_hom ≫ (w₁ ≫ fst₁) := CategoryTheory.Category.assoc _ _ _
          _ = σ_hom ≫ p_X₀ := by rw [hw₁_fst]
          _ = p_X₁ ≫ fst₁ := hσ_hom_fst
          _ = (𝟙 X_bar₁.left ≫ p_X₁) ≫ fst₁ := by rw [CategoryTheory.Category.id_comp]
      · change ((σ_hom ≫ σ_inv) ≫ p_X₁) ≫ snd₁ = (𝟙 X_bar₁.left ≫ p_X₁) ≫ snd₁
        calc
          ((σ_hom ≫ σ_inv) ≫ p_X₁) ≫ snd₁
              = (σ_hom ≫ (σ_inv ≫ p_X₁)) ≫ snd₁ := by simp only [CategoryTheory.Category.assoc]
          _ = (σ_hom ≫ w₁) ≫ snd₁ := by rw [hσ_inv_fst]
          _ = σ_hom ≫ (w₁ ≫ snd₁) := CategoryTheory.Category.assoc _ _ _
          _ = σ_hom ≫ (q_X₀ ≫ v ≫ s₁) := by rw [hw₁_snd]
          _ = (σ_hom ≫ q_X₀) ≫ v ≫ s₁ := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (q_X₁ ≫ u) ≫ v ≫ s₁ := by rw [hσ_hom_snd]
          _ = q_X₁ ≫ (u ≫ v) ≫ s₁ := by simp only [CategoryTheory.Category.assoc]
          _ = q_X₁ ≫ 𝟙 _ ≫ s₁ := by rw [hu_v]
          _ = q_X₁ ≫ s₁ := by rw [CategoryTheory.Category.id_comp]
          _ = p_X₁ ≫ snd₁ := hcond_Xbar₁.symm
          _ = (𝟙 X_bar₁.left ≫ p_X₁) ≫ snd₁ := by rw [CategoryTheory.Category.id_comp]
    · change (σ_hom ≫ σ_inv) ≫ q_X₁ = 𝟙 X_bar₁.left ≫ q_X₁
      calc
        (σ_hom ≫ σ_inv) ≫ q_X₁
            = σ_hom ≫ (σ_inv ≫ q_X₁) := CategoryTheory.Category.assoc _ _ _
        _ = σ_hom ≫ (q_X₀ ≫ v) := by rw [hσ_inv_snd]
        _ = (σ_hom ≫ q_X₀) ≫ v := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (q_X₁ ≫ u) ≫ v := by rw [hσ_hom_snd]
        _ = q_X₁ ≫ (u ≫ v) := CategoryTheory.Category.assoc _ _ _
        _ = q_X₁ ≫ 𝟙 _ := by rw [hu_v]
        _ = q_X₁ := CategoryTheory.Category.comp_id _
        _ = 𝟙 X_bar₁.left ≫ q_X₁ := (CategoryTheory.Category.id_comp _).symm
  have hσ_inv_hom : σ_inv ≫ σ_hom = 𝟙 (weilGeomScheme F X) := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · change (σ_inv ≫ σ_hom) ≫ p_X₀ = 𝟙 (weilGeomScheme F X) ≫ p_X₀
      calc
        (σ_inv ≫ σ_hom) ≫ p_X₀
            = σ_inv ≫ (σ_hom ≫ p_X₀) := CategoryTheory.Category.assoc _ _ _
        _ = σ_inv ≫ (p_X₁ ≫ fst₁) := by rw [hσ_hom_fst]
        _ = (σ_inv ≫ p_X₁) ≫ fst₁ := (CategoryTheory.Category.assoc _ _ _).symm
        _ = w₁ ≫ fst₁ := by rw [hσ_inv_fst]
        _ = p_X₀ := hw₁_fst
        _ = 𝟙 (weilGeomScheme F X) ≫ p_X₀ := (CategoryTheory.Category.id_comp _).symm
    · change (σ_inv ≫ σ_hom) ≫ q_X₀ = 𝟙 (weilGeomScheme F X) ≫ q_X₀
      calc
        (σ_inv ≫ σ_hom) ≫ q_X₀
            = σ_inv ≫ (σ_hom ≫ q_X₀) := CategoryTheory.Category.assoc _ _ _
        _ = σ_inv ≫ (q_X₁ ≫ u) := by rw [hσ_hom_snd]
        _ = (σ_inv ≫ q_X₁) ≫ u := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (q_X₀ ≫ v) ≫ u := by rw [hσ_inv_snd]
        _ = q_X₀ ≫ (v ≫ u) := CategoryTheory.Category.assoc _ _ _
        _ = q_X₀ ≫ 𝟙 _ := by rw [hv_u]
        _ = q_X₀ := CategoryTheory.Category.comp_id _
        _ = 𝟙 (weilGeomScheme F X) ≫ q_X₀ := (CategoryTheory.Category.id_comp _).symm
  let σ : X_bar₁.left ≅ weilGeomScheme F X :=
    { hom := σ_hom, inv := σ_inv, hom_inv_id := hσ_hom_inv, inv_hom_id := hσ_inv_hom }
  let g_Y := weilGeomFrobHom F₁ Y
  let g_X := weilGeomFrobHom F X
  have hgY_fst : g_Y ≫ p_Y = p_Y :=
    (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans (CategoryTheory.Category.comp_id _)
  have hgY_snd : g_Y ≫ q_Y = q_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁.toRingHom) :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hgX_fst : g_X ≫ p_X₀ = p_X₀ :=
    (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans (CategoryTheory.Category.comp_id _)
  have hgX_snd : g_X ≫ q_X₀ = q_X₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.toRingHom) :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hpow_fst : ∀ k : ℕ, weilSchemeEndPow g_X k ≫ p_X₀ = p_X₀ := by
    intro k
    induction k with
    | zero => exact CategoryTheory.Category.id_comp p_X₀
    | succ k ih =>
      change (g_X ≫ weilSchemeEndPow g_X k) ≫ p_X₀ = p_X₀
      rw [CategoryTheory.Category.assoc, ih, hgX_fst]
  have hpow_snd : ∀ k : ℕ,
      weilSchemeEndPow g_X k ≫ q_X₀ =
        q_X₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀ ^ k).toRingHom) := by
    intro k
    induction k with
    | zero =>
      change 𝟙 _ ≫ q_X₀ = q_X₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀ ^ 0).toRingHom)
      rw [CategoryTheory.Category.id_comp, pow_zero]
      have hid : (1 : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F).toRingHom =
          RingHom.id (AlgebraicClosure F) := rfl
      rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.comp_id]
    | succ k ih =>
      change (g_X ≫ weilSchemeEndPow g_X k) ≫ q_X₀ = _
      calc
        (g_X ≫ weilSchemeEndPow g_X k) ≫ q_X₀
            = g_X ≫ (weilSchemeEndPow g_X k ≫ q_X₀) := CategoryTheory.Category.assoc _ _ _
        _ = g_X ≫ (q_X₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀ ^ k).toRingHom)) := by
            rw [ih]
        _ = (g_X ≫ q_X₀) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀ ^ k).toRingHom) :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = (q_X₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.toRingHom)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀ ^ k).toRingHom) := by
            rw [hgX_snd]
        _ = q_X₀ ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀ ^ k).toRingHom)) :=
            CategoryTheory.Category.assoc _ _ _
        _ = q_X₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀ ^ (k + 1)).toRingHom) := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            congr 2
            ext z
            change ψ₀ ((ψ₀ ^ k) z) = (ψ₀ ^ (k + 1)) z
            rw [pow_succ' ψ₀ k, AlgEquiv.mul_apply]
  have hπ_fst : (ψ.left ≫ σ.hom) ≫ p_X₀ = p_Y ≫ φ.left ≫ fst₁ := by
    calc
      (ψ.left ≫ σ.hom) ≫ p_X₀
          = ψ.left ≫ (σ_hom ≫ p_X₀) := CategoryTheory.Category.assoc _ _ _
      _ = ψ.left ≫ (p_X₁ ≫ fst₁) := by rw [hσ_hom_fst]
      _ = (ψ.left ≫ p_X₁) ≫ fst₁ := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (p_Y ≫ φ.left) ≫ fst₁ := by rw [hψ_fst]
      _ = p_Y ≫ φ.left ≫ fst₁ := CategoryTheory.Category.assoc _ _ _
  have hπ_snd : (ψ.left ≫ σ.hom) ≫ q_X₀ = q_Y ≫ u := by
    calc
      (ψ.left ≫ σ.hom) ≫ q_X₀
          = ψ.left ≫ (σ_hom ≫ q_X₀) := CategoryTheory.Category.assoc _ _ _
      _ = ψ.left ≫ (q_X₁ ≫ u) := by rw [hσ_hom_snd]
      _ = (ψ.left ≫ q_X₁) ≫ u := (CategoryTheory.Category.assoc _ _ _).symm
      _ = q_Y ≫ u := by rw [hψ_snd]
  have hFrob_comm : g_Y ≫ (ψ.left ≫ σ.hom) = (ψ.left ≫ σ.hom) ≫ weilSchemeEndPow g_X m := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · change (g_Y ≫ (ψ.left ≫ σ.hom)) ≫ p_X₀ =
          ((ψ.left ≫ σ.hom) ≫ weilSchemeEndPow g_X m) ≫ p_X₀
      calc
        (g_Y ≫ (ψ.left ≫ σ.hom)) ≫ p_X₀
            = g_Y ≫ ((ψ.left ≫ σ.hom) ≫ p_X₀) := CategoryTheory.Category.assoc _ _ _
        _ = g_Y ≫ (p_Y ≫ φ.left ≫ fst₁) := by rw [hπ_fst]
        _ = (g_Y ≫ p_Y) ≫ φ.left ≫ fst₁ := (CategoryTheory.Category.assoc _ _ _).symm
        _ = p_Y ≫ φ.left ≫ fst₁ := by rw [hgY_fst]
        _ = (ψ.left ≫ σ.hom) ≫ p_X₀ := hπ_fst.symm
        _ = (ψ.left ≫ σ.hom) ≫ (weilSchemeEndPow g_X m ≫ p_X₀) := by rw [hpow_fst m]
        _ = ((ψ.left ≫ σ.hom) ≫ weilSchemeEndPow g_X m) ≫ p_X₀ :=
            (CategoryTheory.Category.assoc _ _ _).symm
    · change (g_Y ≫ (ψ.left ≫ σ.hom)) ≫ q_X₀ =
          ((ψ.left ≫ σ.hom) ≫ weilSchemeEndPow g_X m) ≫ q_X₀
      calc
        (g_Y ≫ (ψ.left ≫ σ.hom)) ≫ q_X₀
            = g_Y ≫ ((ψ.left ≫ σ.hom) ≫ q_X₀) := CategoryTheory.Category.assoc _ _ _
        _ = g_Y ≫ (q_Y ≫ u) := by rw [hπ_snd]
        _ = (g_Y ≫ q_Y) ≫ u := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (q_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁.toRingHom)) ≫ u := by
            rw [hgY_snd]
        _ = q_Y ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁.toRingHom) ≫ u) :=
            CategoryTheory.Category.assoc _ _ _
        _ = q_Y ≫ (u ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀ ^ m).toRingHom)) := by
            dsimp [u]
            rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
              ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
            congr 2
            ext z
            exact hκ_frob z
        _ = (q_Y ≫ u) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀ ^ m).toRingHom) :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = ((ψ.left ≫ σ.hom) ≫ q_X₀) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀ ^ m).toRingHom) := by
            rw [← hπ_snd]
        _ = (ψ.left ≫ σ.hom) ≫
              (q_X₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀ ^ m).toRingHom)) :=
            CategoryTheory.Category.assoc _ _ _
        _ = (ψ.left ≫ σ.hom) ≫ (weilSchemeEndPow g_X m ≫ q_X₀) := by rw [← hpow_snd m]
        _ = ((ψ.left ≫ σ.hom) ≫ weilSchemeEndPow g_X m) ≫ q_X₀ :=
            (CategoryTheory.Category.assoc _ _ _).symm
  exact ⟨X_bar₁, ψ, U_bar, σ, hIrrX, hPropX, hSmX, hIrrY, hPropY, hSmY,
    hψ_prop, hψ_surj, hUbar_ne, hUbar_fin, hUbar_et, hUbar_surj, hFrob_comm⟩

theorem weil_alt_leray_ext_and_zero_bdry_devissage : (∀ (S : AlgebraicGeometry.Scheme.{u}) (V : S.Opens) (n : ℕ)
        (K : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (ι : Quiver.Hom K (weilEtaleTorsionSheaf S n)),
      WeilAltIsZeroBdryExact S V n K ι →
      n • CategoryTheory.CategoryStruct.id K = 0 ∧
      WeilAltLerayStalkZeroOutside V K) ∧
    (∀ {Y₀ X₀ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₀ X₀)
        (V_Y : Y₀.Opens) (ℓ m : ℕ)
        (F : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}),
      (ℓ * m) • CategoryTheory.CategoryStruct.id F = 0 →
      WeilAltLerayStalkZeroOutside V_Y F →
      (∀ (G₁ : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id G₁ = 0 →
        WeilAltLerayStalkZeroOutside V_Y G₁ →
        ∀ s : ℕ, 1 ≤ s → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h s G₁)) →
      (∀ (G₂ : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}),
        m • CategoryTheory.CategoryStruct.id G₂ = 0 →
        WeilAltLerayStalkZeroOutside V_Y G₂ →
        ∀ s : ℕ, 1 ≤ s → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h s G₂)) →
      ∀ s : ℕ, 1 ≤ s → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h s F)) ∧
    (∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂) (q : ℕ)
        (F : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ s : ℕ, 1 ≤ s → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h s F)) →
      WeilAltZeroBdryLerayInjective h q F) :=
by
  have hMonoApp : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {F₁ F₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (f : F₁ ⟶ F₂) [CategoryTheory.Mono f] (W : S.Etale)
      (x : F₁.obj.obj (Opposite.op W)),
      f.hom.app (Opposite.op W) x = 0 → x = 0 := by
    intro S F₁ F₂ f _ W x hx
    have h1 : CategoryTheory.Mono
        ((CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).map f) :=
      inferInstance
    have h2 : CategoryTheory.Mono (f.hom.app (Opposite.op W)) :=
      @CategoryTheory.Functor.map_mono _ _ _ _
        ((CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op W)) _ _ _
        ((CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).map f) h1
    have hker : (AddCommGrpCat.Hom.hom (f.hom.app (Opposite.op W))).ker = ⊥ :=
      (AddCommGrpCat.mono_iff_ker_eq_bot (f.hom.app (Opposite.op W))).mp h2
    exact (AddSubgroup.eq_bot_iff_forall _).mp hker x hx

  have hEtaleSieveIff : ∀ {Y : AlgebraicGeometry.Scheme.{u}} {U : Y.Etale}
      (R : CategoryTheory.Sieve U),
      R ∈ Y.smallEtaleTopology U ↔
        ∀ x : ↥U.left, ∃ (W_x : Y.Etale) (f_x : W_x ⟶ U) (y_x : ↥W_x.left),
          R.arrows f_x ∧ AlgebraicGeometry.Etale f_x.left ∧ f_x.left.base y_x = x := by
    intro Y U R
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have hJ :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        Y (le_refl P_et)
    refine ⟨fun hR x => ?_, fun hpt => ?_⟩
    · have hR' : R ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck U := by
        change R ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et Y U at hR
        rwa [hJ] at hR
      exact (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) U R).mp hR' x
    · change R ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et Y U
      rw [hJ]
      exact (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) U R).mpr hpt

  have hLocConstIsSheaf : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (n : ℕ),
      CategoryTheory.Presheaf.IsSheaf Y.smallEtaleTopology (weilAltLocConstPresheaf Y n) := by
    intro Y n
    let P := weilAltLocConstPresheaf Y n
    let P_set : (Y.Etale)ᵒᵖ ⥤ Type u := P ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    have hType : CategoryTheory.Presieve.IsSheaf Y.smallEtaleTopology P_set := by
      intro U R hR x_fam hx
      have hR' := (hEtaleSieveIff R).mp hR
      let g₀ : ↥U.left → ULift.{u} (ZMod n) := fun x =>
        let W_x := Classical.choose (hR' x)
        let f_x := Classical.choose (Classical.choose_spec (hR' x))
        let y_x := Classical.choose (Classical.choose_spec (Classical.choose_spec (hR' x)))
        let hf_x := (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hR' x)))).1
        let s_x : LocallyConstant ↥W_x.left (ULift.{u} (ZMod n)) := x_fam f_x hf_x
        s_x y_x
      have hg₀_agree : ∀ {W₁ : Y.Etale} (f₁ : W₁ ⟶ U) (hf₁ : R.arrows f₁) (y₁ : ↥W₁.left),
          (show LocallyConstant ↥W₁.left (ULift.{u} (ZMod n)) from x_fam f₁ hf₁) y₁ =
            g₀ (f₁.left.base y₁) := by
        intro W₁ f₁ hf₁ y₁
        set x := f₁.left.base y₁
        let W_x := Classical.choose (hR' x)
        let f_x := Classical.choose (Classical.choose_spec (hR' x))
        let y_x := Classical.choose (Classical.choose_spec (Classical.choose_spec (hR' x)))
        have hspec := Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hR' x)))
        have hf_x : R.arrows f_x := hspec.1
        haveI : AlgebraicGeometry.Etale f_x.left := hspec.2.1
        have hy_x : f_x.left.base y_x = x := hspec.2.2
        haveI : AlgebraicGeometry.Etale W₁.hom := W₁.prop
        let P₁₂ := CategoryTheory.Limits.pullback f₁.left f_x.left
        let π₁ : P₁₂ ⟶ W₁.left := CategoryTheory.Limits.pullback.fst f₁.left f_x.left
        let π₂ : P₁₂ ⟶ W_x.left := CategoryTheory.Limits.pullback.snd f₁.left f_x.left
        let W₁₂ : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
          (π₁ ≫ W₁.hom) inferInstance
        let p₁ : W₁₂ ⟶ W₁ := CategoryTheory.MorphismProperty.Over.homMk π₁ rfl
        let p₂ : W₁₂ ⟶ W_x := CategoryTheory.MorphismProperty.Over.homMk π₂ (by
          change π₂ ≫ W_x.hom = π₁ ≫ W₁.hom
          rw [← CategoryTheory.MorphismProperty.Over.w f_x,
            ← CategoryTheory.MorphismProperty.Over.w f₁,
            ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.condition])
        have hcomm : p₁ ≫ f₁ = p₂ ≫ f_x :=
          CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y_x hy_x.symm
        have hcomp := hx p₁ p₂ hf₁ hf_x hcomm
        let s₁ : LocallyConstant ↥W₁.left (ULift.{u} (ZMod n)) := x_fam f₁ hf₁
        let s_x : LocallyConstant ↥W_x.left (ULift.{u} (ZMod n)) := x_fam f_x hf_x
        have hz_eq := congrArg (fun (k : LocallyConstant ↥W₁₂.left (ULift.{u} (ZMod n))) => k z) hcomp
        change s₁ (π₁.base z) = s_x (π₂.base z) at hz_eq
        rw [hz₁, hz₂] at hz_eq
        exact hz_eq
      have hg₀_loc : IsLocallyConstant g₀ := by
        intro E
        rw [isOpen_iff_forall_mem_open]
        intro x hxE
        let W_x := Classical.choose (hR' x)
        let f_x := Classical.choose (Classical.choose_spec (hR' x))
        let y_x := Classical.choose (Classical.choose_spec (Classical.choose_spec (hR' x)))
        have hspec := Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hR' x)))
        have hf_x : R.arrows f_x := hspec.1
        haveI : AlgebraicGeometry.Etale f_x.left := hspec.2.1
        have hy_x : f_x.left.base y_x = x := hspec.2.2
        let s_x : LocallyConstant ↥W_x.left (ULift.{u} (ZMod n)) := x_fam f_x hf_x
        let O_y : Set ↥W_x.left := s_x ⁻¹' E
        have hOy_open : IsOpen O_y := s_x.isLocallyConstant E
        have hy_xE : y_x ∈ O_y := by
          change s_x y_x ∈ E
          rw [hg₀_agree f_x hf_x y_x, hy_x]
          exact hxE
        refine ⟨f_x.left.base '' O_y, ?_, f_x.left.isOpenMap O_y hOy_open,
          ⟨y_x, hy_xE, hy_x⟩⟩
        rintro x' ⟨y', hy'E, rfl⟩
        change g₀ (f_x.left.base y') ∈ E
        rw [← hg₀_agree f_x hf_x y']
        exact hy'E
      let g : LocallyConstant ↥U.left (ULift.{u} (ZMod n)) := ⟨g₀, hg₀_loc⟩
      refine ⟨g, ?_, ?_⟩
      · intro W₁ f₁ hf₁
        exact LocallyConstant.ext (fun y₁ => (hg₀_agree f₁ hf₁ y₁).symm)
      · intro g' hg'
        let g'₀ : LocallyConstant ↥U.left (ULift.{u} (ZMod n)) := g'
        refine LocallyConstant.ext (fun x => ?_)
        let W_x := Classical.choose (hR' x)
        let f_x := Classical.choose (Classical.choose_spec (hR' x))
        let y_x := Classical.choose (Classical.choose_spec (Classical.choose_spec (hR' x)))
        have hspec := Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hR' x)))
        have hf_x : R.arrows f_x := hspec.1
        have hy_x : f_x.left.base y_x = x := hspec.2.2
        let s_x : LocallyConstant ↥W_x.left (ULift.{u} (ZMod n)) := x_fam f_x hf_x
        have h1 := congrArg (fun (k : LocallyConstant ↥W_x.left (ULift.{u} (ZMod n))) => k y_x)
          (hg' f_x hf_x)
        change g'₀ (f_x.left.base y_x) = s_x y_x at h1
        rw [hy_x] at h1
        exact h1
    intro E U R hR x_fam hx
    have hE : ∀ e : E, ∃! g : LocallyConstant ↥U.left (ULift.{u} (ZMod n)),
        ∀ {W₁ : Y.Etale} (f₁ : W₁ ⟶ U) (hf₁ : R.arrows f₁),
          P_set.map (Opposite.op f₁) g =
            (x_fam f₁ hf₁ : E ⟶ P.obj (Opposite.op W₁)).hom e := by
      intro e
      let x_e : CategoryTheory.Presieve.FamilyOfElements P_set R.arrows :=
        fun W₁ f₁ hf₁ => (x_fam f₁ hf₁ : E ⟶ P.obj (Opposite.op W₁)).hom e
      have hx_e : x_e.Compatible := by
        intro W₁ W₂ Z₀ g₁ g₂ f₁ f₂ h₁ h₂ hcomm
        have hcomp := hx g₁ g₂ h₁ h₂ hcomm
        exact congrArg (fun (k : E ⟶ P.obj (Opposite.op Z₀)) => k.hom e) hcomp
      exact hType R hR x_e hx_e
    let φ_fun : E → LocallyConstant ↥U.left (ULift.{u} (ZMod n)) :=
      fun e => Classical.choose (hE e)
    have hφ_spec : ∀ (e : E) {W₁ : Y.Etale} (f₁ : W₁ ⟶ U) (hf₁ : R.arrows f₁),
        P_set.map (Opposite.op f₁) (φ_fun e) =
