          αM_Y ≫ U_Y.map q_i_p ≫ μ.hom.app One_Z by
      have h1 := congrArg (fun g => βM_Y ≫ g ≫ μ.inv.app One_Z) h_conj
      simp only [← Category.assoc, hβα_Y'] at h1
      simp only [Category.assoc, μ.hom_inv_id_app, Category.id_comp, Category.comp_id] at h1
      exact h1
    apply (adj_Y_p.homEquiv AM (P_push.obj (U_Z.obj One_Z))).injective
    have hLHS :
        αM_Y ≫ U_Y.map (η_R.app One_Y ≫ i_push.map ε_R.hom) ≫ μ.hom.app One_Z =
          (adj_Y_p.homEquiv AM (P_push.obj (U_Z.obj One_Z))).symm
            (ιM ≫ u_Zp ≫ (U_Z.obj One_Z).obj.map τ_p.op) := by
      rw [U_Y.map_comp]
      dsimp only [η_R]
      rw [ff_UY.map_preimage]
      have hμ_nat : μ.inv.app (P_pull_R.obj One_Y) ≫ U_Y.map (i_push.map ε_R.hom) ≫ μ.hom.app One_Z =
          P_push.map (U_Z.map ε_R.hom) := by
        have hn := μ.hom.naturality ε_R.hom
        dsimp only [Functor.comp_map] at hn
        rw [hn, ← Category.assoc, μ.inv_hom_id_app, Category.id_comp]
      have hn_α : αM_Y ≫ adj_pull.unit.app (U_Y.obj One_Y) =
          adj_pull.unit.app FM_Y ≫ P_push.map (P_pull.map αM_Y) :=
        adj_pull.unit.naturality αM_Y
      calc
        αM_Y ≫ (adj_pull.unit.app (U_Y.obj One_Y) ≫ P_push.map (δ.inv.app One_Y) ≫
            μ.inv.app (P_pull_R.obj One_Y)) ≫ U_Y.map (i_push.map ε_R.hom) ≫ μ.hom.app One_Z =
          (αM_Y ≫ adj_pull.unit.app (U_Y.obj One_Y)) ≫ P_push.map (δ.inv.app One_Y) ≫
            (μ.inv.app (P_pull_R.obj One_Y) ≫ U_Y.map (i_push.map ε_R.hom) ≫ μ.hom.app One_Z) := by
              simp only [Category.assoc]
        _ = adj_pull.unit.app FM_Y ≫ P_push.map (P_pull.map αM_Y) ≫
            P_push.map (δ.inv.app One_Y) ≫ P_push.map (U_Z.map ε_R.hom) := by
              rw [hn_α, hμ_nat]
              simp only [Category.assoc]
        _ = adj_pull.unit.app FM_Y ≫
            P_push.map (P_pull.map αM_Y ≫ δ.inv.app One_Y ≫ U_Z.map ε_R.hom) := by
              rw [← P_push.map_comp, ← P_push.map_comp]
        _ = (adj_pull.unit.app FM_Y ≫ P_push.map (π_gen AM)) ≫ P_push.map αM_Z := by
              rw [hε_hom_UZ]
              have hmid : P_pull.map αM_Y ≫ δ.inv.app One_Y ≫
                  (δ.hom.app One_Y ≫ P_pull.map βM_Y ≫ π_gen AM ≫ αM_Z) =
                  π_gen AM ≫ αM_Z := by
                calc
                  P_pull.map αM_Y ≫ δ.inv.app One_Y ≫
                      (δ.hom.app One_Y ≫ P_pull.map βM_Y ≫ π_gen AM ≫ αM_Z) =
                    P_pull.map αM_Y ≫ (δ.inv.app One_Y ≫ δ.hom.app One_Y) ≫
                      P_pull.map βM_Y ≫ π_gen AM ≫ αM_Z := by simp only [Category.assoc]
                  _ = (P_pull.map αM_Y ≫ P_pull.map βM_Y) ≫ π_gen AM ≫ αM_Z := by
                      rw [hδ_inv_hom, Category.id_comp, ← Category.assoc (P_pull.map αM_Y)]
                  _ = π_gen AM ≫ αM_Z := by rw [← P_pull.map_comp, hαβ_Y', P_pull.map_id, Category.id_comp]
              rw [hmid, P_push.map_comp, Category.assoc]
        _ = adj_pull.homEquiv FM_Y FM_Z (π_gen AM) ≫ P_push.map αM_Z := by
              symm; rw [Adjunction.homEquiv_unit]
        _ = (adj_Y_p.homEquiv AM (P_push.obj FM_Z)).symm
              (adj_Z_p.unit.app AM ≫ FM_Z.obj.map τ_p.op) ≫ P_push.map αM_Z := by
              dsimp only [π_gen]
              rw [Equiv.apply_symm_apply]
        _ = (adj_Y_p.homEquiv AM (P_push.obj (U_Z.obj One_Z))).symm
              (ιM ≫ u_Zp ≫ (U_Z.obj One_Z).obj.map τ_p.op) := by
              rw [← Adjunction.homEquiv_naturality_right_symm]
              congr 1
              change (adj_Z_p.unit.app AM ≫ FM_Z.obj.map τ_p.op) ≫
                αM_Z.hom.app (Opposite.op (B_i.obj T_Y_p)) = _
              rw [Category.assoc, αM_Z.hom.naturality τ_p.op, ← Category.assoc]
              have hαZ_unit : adj_Z_p.unit.app AM ≫ αM_Z.hom.app (Opposite.op T_Z_p) = ιM ≫ u_Zp := by
                have heq := (adj_Z_p.homEquiv AM (U_Z.obj One_Z)).apply_symm_apply (ιM ≫ u_Zp)
                rw [← hαM_Zp, Adjunction.homEquiv_unit] at heq
                dsimp [sheafSections] at heq
                exact heq
              rw [hαZ_unit, Category.assoc]
              rfl
    rw [hLHS, Equiv.apply_symm_apply, Adjunction.homEquiv_unit]
    have hαY_unit : adj_Y_p.unit.app AM ≫ αM_Y.hom.app (Opposite.op T_Y_p) = ιM ≫ u_Yp := by
      have heq := (adj_Y_p.homEquiv AM (U_Y.obj One_Y)).apply_symm_apply (ιM ≫ u_Yp)
      rw [← hαM_Yp, Adjunction.homEquiv_unit] at heq
      dsimp [sheafSections] at heq
      exact heq
    change ιM ≫ u_Zp ≫ (U_Z.obj One_Z).obj.map τ_p.op =
      (adj_Y_p.unit.app AM ≫ αM_Y.hom.app (Opposite.op T_Y_p)) ≫
        (U_Y.map q_i_p).hom.app (Opposite.op T_Y_p) ≫
          (eqToHom (h_mu_obj One_Z)).app (Opposite.op T_Y_p)
    rw [hαY_unit]
    have hq_mod_unit : adj_mod_Yp.unit.app R_mod ≫ q_i_p.hom.app (Opposite.op T_Y_p) =
        adj_mod_Zp.unit.app R_mod ≫ One_Z.obj.map τ_p.op := by
      have heq := (adj_mod_Yp.homEquiv R_mod (i_push.obj One_Z)).apply_symm_apply
        (adj_mod_Zp.unit.app R_mod ≫ One_Z.obj.map τ_p.op)
      rw [Adjunction.homEquiv_unit] at heq
      dsimp [sheafSections] at heq
      exact heq
    have h_sec_eq : ∀ (P_Y : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}) (hpY : P_Y = One_Y.obj ⋙ F_fg)
        (P_Z : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}) (hpZ : P_Z = One_Z.obj ⋙ F_fg)
        (P_Yi : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}) (hpYi : P_Yi = B_i.op ⋙ P_Z)
        (f_q : P_Y.obj (Opposite.op T_Y_p) ⟶ P_Yi.obj (Opposite.op T_Y_p)),
        HEq f_q (F_fg.map (q_i_p.hom.app (Opposite.op T_Y_p))) →
        (F_fg.map (adj_mod_Yp.unit.app R_mod) ≫ (eqToHom hpY.symm).app (Opposite.op T_Y_p)) ≫
          f_q ≫ (eqToHom hpYi).app (Opposite.op T_Y_p) =
          (F_fg.map (adj_mod_Zp.unit.app R_mod) ≫ (eqToHom hpZ.symm).app (Opposite.op T_Z_p)) ≫
            P_Z.map τ_p.op := by
      rintro _ rfl _ rfl _ rfl f_q hfq
      have hfq_eq : f_q = F_fg.map (q_i_p.hom.app (Opposite.op T_Y_p)) := eq_of_heq hfq
      let eY := (eqToHom (rfl : One_Y.obj ⋙ F_fg = One_Y.obj ⋙ F_fg)).app (Opposite.op T_Y_p)
      let eYi := (eqToHom (rfl : B_i.op ⋙ (One_Z.obj ⋙ F_fg) = B_i.op ⋙ (One_Z.obj ⋙ F_fg))).app
        (Opposite.op T_Y_p)
      let eZ := (eqToHom (rfl : One_Z.obj ⋙ F_fg = One_Z.obj ⋙ F_fg)).app (Opposite.op T_Z_p)
      have h1 : F_fg.map (adj_mod_Yp.unit.app R_mod) ≫ eY =
          F_fg.map (adj_mod_Yp.unit.app R_mod) := Category.comp_id _
      have h2 : F_fg.map (q_i_p.hom.app (Opposite.op T_Y_p)) ≫ eYi =
          F_fg.map (q_i_p.hom.app (Opposite.op T_Y_p)) := Category.comp_id _
      have h3 : F_fg.map (adj_mod_Zp.unit.app R_mod) ≫ eZ =
          F_fg.map (adj_mod_Zp.unit.app R_mod) := Category.comp_id _
      have h0 : (F_fg.map (adj_mod_Yp.unit.app R_mod) ≫ eY) ≫ f_q ≫ eYi =
          (F_fg.map (adj_mod_Yp.unit.app R_mod) ≫ eY) ≫
            F_fg.map (q_i_p.hom.app (Opposite.op T_Y_p)) ≫ eYi :=
        congrArg (fun g => (F_fg.map (adj_mod_Yp.unit.app R_mod) ≫ eY) ≫ g ≫ eYi) hfq_eq
      exact h0.trans
        ((congrArg (fun g => g ≫ F_fg.map (q_i_p.hom.app (Opposite.op T_Y_p)) ≫ eYi) h1).trans
          ((congrArg (fun g => F_fg.map (adj_mod_Yp.unit.app R_mod) ≫ g) h2).trans
            ((F_fg.map_comp (adj_mod_Yp.unit.app R_mod) (q_i_p.hom.app (Opposite.op T_Y_p))).symm.trans
              ((congrArg F_fg.map hq_mod_unit).trans
                ((F_fg.map_comp (adj_mod_Zp.unit.app R_mod) (One_Z.obj.map τ_p.op)).trans
                  (congrArg (fun g => g ≫ (One_Z.obj ⋙ F_fg).map τ_p.op) h3.symm))))))
    have hsec := h_sec_eq
      (U_Y.obj One_Y).obj (hUY_obj One_Y)
      (U_Z.obj One_Z).obj (hUZ_obj One_Z)
      (U_Y.obj (i_push.obj One_Z)).obj (h_mu_obj One_Z)
      ((U_Y.map q_i_p).hom.app (Opposite.op T_Y_p)) (hUY_map q_i_p (Opposite.op T_Y_p))
    exact (congrArg (fun g => ιM ≫ g) hsec.symm).trans (Category.assoc ιM u_Yp _).symm

  have hη_R_inv_eq : η_R.app One_Y = q_i_std ≫ i_push.map ε_R.inv := by
    rw [← hη_R_unit_eq, Category.assoc, ← i_push.map_comp, ε_R.hom_inv_id, i_push.map_id]
    exact (Category.comp_id (η_R.app One_Y)).symm

  have hIntertwine :
      ξ_tilde.comp (Abelian.Ext.mk₀ q_i_std) (Nat.add_zero q) =
        (Abelian.Ext.mk₀ q_i_std).comp
          ((i_push.mapExtAddHom One_Z One_Z q) δ_Z) (Nat.zero_add q) := by
    have hnat := hExtNatTrans (𝟭 _) (P_pull_R ⋙ i_push) η_R One_Y One_Y q ξ_tilde
    rw [hExtId One_Y One_Y q ξ_tilde] at hnat
    have hpost := congrArg
      (fun w => w.comp (Abelian.Ext.mk₀ (i_push.map ε_R.hom)) (Nat.add_zero q)) hnat
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero ξ_tilde _ _ (Nat.add_zero q),
        Abelian.Ext.mk₀_comp_mk₀, hη_R_unit_eq] at hpost
    rw [hpost,
        Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (η_R.app One_Y)) _ _
          (Nat.zero_add q) (Nat.add_zero q) (by omega),
        hη_R_inv_eq, hExtComp P_pull_R i_push One_Y One_Y q ξ_tilde,
        ← Abelian.Ext.mk₀_comp_mk₀ q_i_std (i_push.map ε_R.inv),
        Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add q)]
    congr 1
    rw [← hξ_Z_eq_δ]
    dsimp only [ξ_tilde_Z]
    simp only [Functor.mapExtAddHom_apply,
        Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]

  
  
  
  have hKoszul : γ_tilde_Y.comp ξ_tilde h4d = ξ_tilde.comp γ_tilde_Y h4d := by
    have hcomm := weil_lefschetz_module_ext_cup_graded_comm Y m q q (2 * q) h4d h4d
      γ_tilde_Y ξ_tilde
    have heven : Even (q * q) := ⟨2 * d * d, by dsimp [q]; ring⟩
    rw [heven.neg_one_pow, one_zsmul] at hcomm
    exact hcomm

  have hPull_nsmul :
      ((Abelian.Ext.mk₀ q_i_std).comp
        ((i_push.mapExtAddHom One_Z One_Z q) δ_Z) (Nat.zero_add q)).comp τ_Y.val h4d =
        a • cl_tilde_SY := by
    dsimp only [δ_Z]
    rw [map_nsmul]
    change (((Abelian.Ext.mk₀ q_i_std).precomp (i_push.obj One_Z) (Nat.zero_add q))
        (a • (i_push.mapExtAddHom One_Z One_Z q) cl_tilde_Z)).comp τ_Y.val h4d = _
    rw [map_nsmul]
    change (τ_Y.val.postcomp One_Y h4d)
        (a • ((Abelian.Ext.mk₀ q_i_std).precomp (i_push.obj One_Z) (Nat.zero_add q)
          ((i_push.mapExtAddHom One_Z One_Z q) cl_tilde_Z))) = _
    rw [map_nsmul]
    congr 1
    change ((Abelian.Ext.mk₀ q_i_std).comp
        ((i_push.mapExtAddHom One_Z One_Z q) cl_tilde_Z) (Nat.zero_add q)).comp τ_Y.val h4d =
      cl_tilde_SY
    have hτ_SY_val' :
        τ_SY.val =
          ((Abelian.Ext.mk₀ α_push).comp
            ((i_push.mapExtAddHom (s_push.obj One_S) One_Z q) τ_Z.val)
            (Nat.zero_add q)).comp τ_Y.val h4d := hτ_SY_val
    dsimp only [cl_tilde_Z, cl_tilde_SY]
    rw [Functor.mapExtAddHom_apply, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_mk₀, ← Functor.mapExtAddHom_apply,
        ← Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add q),
        Abelian.Ext.mk₀_comp_mk₀, ← hq_gys,
        ← Abelian.Ext.mk₀_comp_mk₀ q_si_std α_push,
        Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add q),
        Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ q_si_std) _ _
          (Nat.zero_add q) h4d (by omega),
        ← hτ_SY_val']

  rw [hc_Y_eq, hKoszul]
  dsimp only [γ_tilde_Y]
  rw [← Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ h4d,
      hIntertwine, hPull_nsmul, map_nsmul, ← hcl_SY_eq]

theorem weil_gysin_polyP1_axis_and_point_slice_squares (k : Type u) [Field k] [IsAlgClosed k]
    (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (weilProjectiveSpaceOver k 1).left)
    (ι_aff : ∀ δ : ℕ,
      Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left)
    (hComp : WeilIsPolyP1PinnedCoordCompactification k ι_P1 ι_aff) :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let o_P1 : Quiver.Hom S_k (weilProjectiveSpaceOver k 1).left :=
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k))))
        ι_P1
    let f_P1 : Quiver.Hom (weilGysinAffineSpace k 1) (weilProjectiveSpaceOver k 1).left :=
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Polynomial.aeval (R := k) (MvPolynomial.X 0 : MvPolynomial (Fin 1) k)).toRingHom))
        ι_P1
    let s_Pc : ∀ c : ℕ, Quiver.Hom S_k (weilPolyP1Over k c).left :=
      fun c => CategoryTheory.CategoryStruct.comp (weilGysinAffineOrigin k c) (ι_aff c)
    ((∀ c : ℕ, AlgebraicGeometry.IsClosedImmersion (weilGysinAffineOrigin k c)) ∧
      (AlgebraicGeometry.IsClosedImmersion o_P1 ∧
        AlgebraicGeometry.Etale f_P1 ∧
        CategoryTheory.IsPullback (weilGysinAffineOrigin k 1)
          (CategoryTheory.CategoryStruct.id S_k) f_P1 o_P1) ∧
      (∀ c : ℕ,
        CategoryTheory.CategoryStruct.comp (s_Pc c) (weilPolyP1Over k c).hom =
          CategoryTheory.CategoryStruct.id S_k ∧
        AlgebraicGeometry.IsClosedImmersion (s_Pc c) ∧
        CategoryTheory.IsPullback (weilGysinAffineOrigin k c)
          (CategoryTheory.CategoryStruct.id S_k) (ι_aff c) (s_Pc c) ∧
        ∃ (U_Pc : (weilPolyP1Over k c).left.Opens)
          (s_UPc : Quiver.Hom S_k U_Pc.toScheme)
          (u_Pc : Quiver.Hom U_Pc.toScheme (weilGysinAffineSpace k c))
          (e_Pc : Quiver.Hom (weilGysinAffineSpace k c) U_Pc.toScheme),
          WeilGysinIsEtaleOriginChart c (weilPolyP1Over k c).hom (s_Pc c) U_Pc s_UPc u_Pc ∧
          CategoryTheory.CategoryStruct.comp e_Pc U_Pc.ι = ι_aff c ∧
          CategoryTheory.CategoryStruct.comp e_Pc u_Pc =
            CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k c) ∧
          CategoryTheory.IsPullback (weilGysinAffineOrigin k c)
            (CategoryTheory.CategoryStruct.id S_k) e_Pc s_UPc) ∧
      (∀ c : ℕ,
        CategoryTheory.CategoryStruct.comp (ι_aff (c + 1))
          (CategoryTheory.Limits.pullback.snd (weilPolyP1Over k c).hom
            (weilProjectiveSpaceOver k 1).hom) =
          CategoryTheory.CategoryStruct.comp
            (weilGysinAffineProjRight k c 1 (c + 1) rfl) f_P1 ∧
        ∃ σ_c : Quiver.Hom (weilPolyP1Over k c).left (weilPolyP1Over k (c + 1)).left,
          AlgebraicGeometry.IsClosedImmersion σ_c ∧
          CategoryTheory.CategoryStruct.comp (s_Pc c) σ_c = s_Pc (c + 1) ∧
          CategoryTheory.IsPullback σ_c (weilPolyP1Over k c).hom
            (CategoryTheory.Limits.pullback.snd (weilPolyP1Over k c).hom
              (weilProjectiveSpaceOver k 1).hom) o_P1 ∧
          CategoryTheory.IsPullback (weilGysinAffineLeftAxis k c 1 (c + 1) rfl)
            (ι_aff c) (ι_aff (c + 1)) σ_c) ∧
      (∀ c : ℕ,
        CategoryTheory.IsPullback (weilGysinAffineOrigin k c) (weilGysinAffineOrigin k 0)
          (CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k c))
          (weilGysinAffineLeftAxis k 0 c c (Nat.zero_add c)) ∧
        ∃ ι_right : Quiver.Hom (weilGysinAffineSpace k 1) (weilGysinAffineSpace k (c + 1)),
          CategoryTheory.IsPullback (weilGysinAffineOrigin k 1) (weilGysinAffineOrigin k c)
            ι_right (weilGysinAffineLeftAxis k c 1 (c + 1) rfl) ∧
          CategoryTheory.CategoryStruct.comp ι_right
            (weilGysinAffineProjRight k c 1 (c + 1) rfl) =
            CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k 1)) ∧
      (∀ (a b ab : ℕ) (hab : a + b = ab),
        ∃ i_bar : Quiver.Hom (weilPolyP1Over k a).left (weilPolyP1Over k ab).left,
          AlgebraicGeometry.IsClosedImmersion i_bar ∧
          CategoryTheory.IsPullback (weilGysinAffineLeftAxis k a b ab hab)
            (ι_aff a) (ι_aff ab) i_bar)) ∧
    (∀ (a b ab : ℕ) (hab : a + b = ab)
      (Z_V V : AlgebraicGeometry.Scheme.{u})
      (γ_V : Quiver.Hom Z_V V)
      (u_V : Quiver.Hom Z_V (weilGysinAffineSpace k a))
      (ψ : Quiver.Hom V (weilGysinAffineSpace k ab)),
      AlgebraicGeometry.Etale ψ →
      CategoryTheory.IsPullback γ_V u_V ψ (weilGysinAffineLeftAxis k a b ab hab) →
      ConnectedSpace ↥Z_V →
      ∃ (U_F : AlgebraicGeometry.Scheme.{u})
        (s_UF : Quiver.Hom S_k U_F)
        (s_Z : Quiver.Hom S_k Z_V)
        (g_UF : Quiver.Hom U_F V)
        (f_U : Quiver.Hom U_F (weilGysinAffineSpace k b)),
        AlgebraicGeometry.Etale f_U ∧
        AlgebraicGeometry.IsClosedImmersion s_UF ∧
        CategoryTheory.IsPullback s_UF (CategoryTheory.CategoryStruct.id S_k)
          f_U (weilGysinAffineOrigin k b) ∧
        CategoryTheory.IsPullback s_UF s_Z g_UF γ_V ∧
        CategoryTheory.CategoryStruct.comp g_UF
          (CategoryTheory.CategoryStruct.comp ψ (weilGysinAffineProjRight k a b ab hab)) = f_U) :=
by
  intro S_k o_P1 f_P1 s_Pc
  have hOpen_ι : ∀ {X : AlgebraicGeometry.Scheme.{u}} (U : X.Opens),
      AlgebraicGeometry.IsOpenImmersion U.ι := fun _ => inferInstance
  have hIso_open : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y),
      CategoryTheory.IsIso f → AlgebraicGeometry.IsOpenImmersion f := by
    intro X Y f hf; have := hf; infer_instance
  have hIso_et : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y),
      CategoryTheory.IsIso f → AlgebraicGeometry.Etale f := by
    intro X Y f hf; have := hf; infer_instance
  have hIso_mono : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y),
      CategoryTheory.IsIso f → CategoryTheory.Mono f := by
    intro X Y f hf; have := hf; infer_instance
  have hIso_epi : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y),
      CategoryTheory.IsIso f → CategoryTheory.Epi f := by
    intro X Y f hf; have := hf; infer_instance
  have hOpen_et : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y),
      AlgebraicGeometry.IsOpenImmersion f → AlgebraicGeometry.Etale f := by
    intro X Y f hf; have := hf; infer_instance
  have hOpen_mono : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y),
      AlgebraicGeometry.IsOpenImmersion f → CategoryTheory.Mono f := by
    intro X Y f hf; have := hf; infer_instance
  have hOpen_ft : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y),
      AlgebraicGeometry.IsOpenImmersion f → AlgebraicGeometry.LocallyOfFiniteType f := by
