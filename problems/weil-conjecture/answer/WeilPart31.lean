theorem weil_cupPD_connected_unit_end_and_loc_const (S : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥S] (n : ℕ) (hn : 1 ≤ n) :
    let R := ULift.{u, 0} (ZMod n)
    let J := S.smallEtaleTopology
    let oneR := weilCupPDModUnit S n
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
    Function.Bijective
      (fun c : ZMod n => c.val • CategoryTheory.CategoryStruct.id oneR) ∧
    (∀ (U : S.Etale) (s : ↑(oneR.obj.obj (Opposite.op U))) (y : ↥((Fgt.obj U).left)),
      ∃ (U₀ : S.Etale) (u₀ : Quiver.Hom U₀ U) (y₀ : ↥((Fgt.obj U₀).left)) (c : ZMod n),
        ((Fgt.map u₀).left).base y₀ = y ∧
        (oneR.obj.map (Opposite.op u₀)).hom s =
          (((CategoryTheory.sheafificationAdjunction J (ModuleCat.{u, u} R)).unit.app
            ((CategoryTheory.Functor.const (Opposite S.Etale)).obj (ModuleCat.of R R))).app
            (Opposite.op U₀)).hom (ULift.up c)) :=
by
  intro R J oneR Fgt
  let ModR := ModuleCat.{u, u} R
  let R_mod : ModR := ModuleCat.of R R
  let P_const : CategoryTheory.Functor (Opposite S.Etale) ModR :=
    (CategoryTheory.Functor.const (Opposite S.Etale)).obj R_mod
  let adj_sh := CategoryTheory.sheafificationAdjunction J ModR
  let η_sh := adj_sh.unit.app P_const
  have hEt_comp : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hEt_hom : ∀ {V U : S.Etale} (g : V ⟶ U), AlgebraicGeometry.Etale g.left := by
    intro V U g
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) g.left U.hom U.prop
      (by rw [CategoryTheory.MorphismProperty.Over.w g]; exact V.prop)
  have hOpen_hom : ∀ {V U : S.Etale} (g : V ⟶ U), IsOpenMap g.left.base := by
    intro V U g
    have : AlgebraicGeometry.Etale g.left := hEt_hom g
    exact AlgebraicGeometry.Scheme.Hom.isOpenMap g.left
  have hJ_mem : ∀ {U : S.Etale} (S_cov : CategoryTheory.Sieve U),
      S_cov ∈ J U ↔
        ∀ x : ↥U.left, ∃ (Y : S.Etale) (f : Y ⟶ U) (y : ↥Y.left),
          S_cov.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro U S_cov
    have hJ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S
      (le_refl (@AlgebraicGeometry.Etale))
    exact (Iff.of_eq (congrArg (fun T : CategoryTheory.GrothendieckTopology S.Etale => S_cov ∈ T U) hJ)).trans
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology U S_cov)

  
  let P_lc : CategoryTheory.Functor (Opposite S.Etale) ModR :=
    { obj := fun W => ModuleCat.of R (LocallyConstant ↥((Fgt.obj W.unop).left) R)
      map := fun {W₁ W₂} f =>
        ModuleCat.ofHom (LocallyConstant.comapₗ R ((Fgt.map f.unop).left).base.hom)
      map_id := fun W => by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro g
        apply LocallyConstant.ext
        intro z
        rfl
      map_comp := fun {W₁ W₂ W₃} f₁ f₂ => by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro g
        apply LocallyConstant.ext
        intro z
        rfl }
  let F_type := P_lc ⋙ CategoryTheory.forget ModR
  let lcOf : ∀ {V : S.Etale}, F_type.obj (Opposite.op V) → LocallyConstant ↥V.left R :=
    fun fn => fn
  have hSheaf_type : CategoryTheory.Presieve.IsSheaf J F_type := by
    intro U R_cov hR_cov x hx
    have hsurj : ∀ u : ↥U.left, ∃ (V : S.Etale) (g : V ⟶ U) (_ : R_cov.arrows g) (y : ↥V.left),
        g.left.base y = u := by
      intro u
      obtain ⟨V, g, y, hg, _, hy⟩ := (hJ_mem R_cov).mp hR_cov u
      exact ⟨V, g, hg, y, hy⟩
    have hoverlap : ∀ {V₁ V₂ : S.Etale} {g₁ : V₁ ⟶ U} {g₂ : V₂ ⟶ U}
        (hg₁ : R_cov.arrows g₁) (hg₂ : R_cov.arrows g₂) (y₁ : ↥V₁.left) (y₂ : ↥V₂.left),
        g₁.left.base y₁ = g₂.left.base y₂ →
        lcOf (x g₁ hg₁) y₁ = lcOf (x g₂ hg₂) y₂ := by
      intro V₁ V₂ g₁ g₂ hg₁ hg₂ y₁ y₂ hy
      have _ : AlgebraicGeometry.Etale g₁.left := hEt_hom g₁
      have _ : AlgebraicGeometry.Etale V₂.hom := V₂.prop
      let W₀ := CategoryTheory.Limits.pullback g₁.left g₂.left
      let p₁ : W₀ ⟶ V₁.left := CategoryTheory.Limits.pullback.fst g₁.left g₂.left
      let p₂ : W₀ ⟶ V₂.left := CategoryTheory.Limits.pullback.snd g₁.left g₂.left
      have _ : AlgebraicGeometry.Etale p₂ := inferInstance
      let W : S.Etale := AlgebraicGeometry.Scheme.Etale.mk (p₂ ≫ V₂.hom)
      let π₁ : W ⟶ V₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ (by
        change p₁ ≫ V₁.hom = p₂ ≫ V₂.hom
        rw [← CategoryTheory.MorphismProperty.Over.w g₁, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
          CategoryTheory.MorphismProperty.Over.w g₂])
      let π₂ : W ⟶ V₂ := CategoryTheory.MorphismProperty.Over.homMk p₂ rfl
      have hcomm : π₁ ≫ g₁ = π₂ ≫ g₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
      obtain ⟨z, hz₁, hz₂⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy
      have hcompat := hx π₁ π₂ hg₁ hg₂ hcomm
      have hz_eq : lcOf (F_type.map π₁.op (x g₁ hg₁)) z = lcOf (F_type.map π₂.op (x g₂ hg₂)) z :=
        congrArg (fun fn : F_type.obj (Opposite.op W) => lcOf fn z) hcompat
      change lcOf (x g₁ hg₁) (p₁.base z) = lcOf (x g₂ hg₂) (p₂.base z) at hz_eq
      exact (congrArg (lcOf (x g₁ hg₁)) hz₁.symm).trans
        (hz_eq.trans (congrArg (lcOf (x g₂ hg₂)) hz₂))
    classical
    let s₀ : ↥U.left → R := fun u =>
      let h1 := Classical.choose_spec (hsurj u)
      let h2 := Classical.choose_spec h1
      let h3 := Classical.choose_spec h2
      lcOf (x (Classical.choose h1) (Classical.choose h2)) (Classical.choose h3)
    have hs₀_eq : ∀ {V : S.Etale} (g : V ⟶ U) (hg : R_cov.arrows g) (y : ↥V.left),
        s₀ (g.left.base y) = lcOf (x g hg) y := by
      intro V g hg y
      let u := g.left.base y
      let h1 := Classical.choose_spec (hsurj u)
      let h2 := Classical.choose_spec h1
      let h3 := Classical.choose_spec h2
      let hy_u : (Classical.choose h1).left.base (Classical.choose h3) = u :=
        Classical.choose_spec h3
      exact hoverlap (Classical.choose h2) hg (Classical.choose h3) y hy_u
    have hs₀_lc : IsLocallyConstant s₀ := by
      intro E
      rw [isOpen_iff_forall_mem_open]
      intro u hu
      obtain ⟨V, g, hg, y, hy⟩ := hsurj u
      refine ⟨g.left.base '' (lcOf (x g hg) ⁻¹' E), ?_,
        hOpen_hom g _ ((lcOf (x g hg)).isLocallyConstant E), ⟨y, ?_, hy⟩⟩
      · rintro _ ⟨y', hy', rfl⟩
        change s₀ (g.left.base y') ∈ E
        rw [hs₀_eq g hg y']
        exact hy'
      · change lcOf (x g hg) y ∈ E
        rw [← hs₀_eq g hg y, hy]
        exact hu
    let s_lc : F_type.obj (Opposite.op U) := (⟨s₀, hs₀_lc⟩ : LocallyConstant ↥U.left R)
    refine ⟨s_lc, ?_, ?_⟩
    · intro V g hg
      apply LocallyConstant.ext
      intro y
      exact hs₀_eq g hg y
    · intro t ht
      apply LocallyConstant.ext
      intro u
      obtain ⟨V, g, hg, y, rfl⟩ := hsurj u
      have hty : lcOf (F_type.map g.op t) y = lcOf (x g hg) y :=
        congrArg (fun fn : F_type.obj (Opposite.op V) => lcOf fn y) (ht g hg)
      exact hty.trans (hs₀_eq g hg y).symm
  have hSheaf_lc : CategoryTheory.Presheaf.IsSheaf J P_lc := by
    intro E U R_cov hR_cov x hx
    have h_pt : ∀ e : ↑E,
        ∃! t : LocallyConstant ↥((Fgt.obj U).left) R,
          ∀ ⦃V : S.Etale⦄ (g : V ⟶ U) (hg : R_cov.arrows g),
            (P_lc.map g.op).hom t = (x g hg).hom e := by
      intro e
      let x_e : CategoryTheory.Presieve.FamilyOfElements F_type R_cov.arrows :=
        fun V g hg => (x g hg).hom e
      have hx_e : x_e.Compatible := by
        intro Y₁ Y₂ Z f₁ f₂ g₁ g₂ hg₁ hg₂ hcomm
        have h := hx f₁ f₂ hg₁ hg₂ hcomm
        exact congrArg (fun φ : E ⟶ P_lc.obj (Opposite.op Z) => φ.hom e) h
      exact hSheaf_type R_cov hR_cov x_e hx_e
    classical
    let t_fun : ↑E → LocallyConstant ↥((Fgt.obj U).left) R :=
      fun e => Classical.choose (h_pt e)
    have ht_spec : ∀ (e : ↑E) ⦃V : S.Etale⦄ (g : V ⟶ U) (hg : R_cov.arrows g),
        (P_lc.map g.op).hom (t_fun e) = (x g hg).hom e :=
      fun e => (Classical.choose_spec (h_pt e)).1
    have ht_uniq : ∀ (e : ↑E) (t' : LocallyConstant ↥((Fgt.obj U).left) R),
        (∀ ⦃V : S.Etale⦄ (g : V ⟶ U) (hg : R_cov.arrows g),
          (P_lc.map g.op).hom t' = (x g hg).hom e) → t' = t_fun e :=
      fun e t' ht' => (Classical.choose_spec (h_pt e)).2 t' ht'
    let t_hom : E ⟶ P_lc.obj (Opposite.op U) :=
      ModuleCat.ofHom
        { toFun := t_fun
          map_add' := fun e₁ e₂ =>
            (ht_uniq (e₁ + e₂) (t_fun e₁ + t_fun e₂) (fun V g hg => by
              rw [map_add, ht_spec e₁ g hg, ht_spec e₂ g hg, map_add])).symm
          map_smul' := fun r e =>
            (ht_uniq (r • e) (r • t_fun e) (fun V g hg => by
              rw [map_smul, ht_spec e g hg, map_smul])).symm }
    refine ⟨t_hom, ?_, ?_⟩
    · intro V g hg
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro e
      exact ht_spec e g hg
    · intro y hy
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro e
      exact ht_uniq e (y.hom e) (fun V g hg =>
        congrArg (fun φ : E ⟶ P_lc.obj (Opposite.op V) => φ.hom e) (hy g hg))
  let L_sh : CategoryTheory.Sheaf J ModR := ⟨P_lc, hSheaf_lc⟩
  let ι_lc : P_const ⟶ P_lc :=
    { app := fun W => ModuleCat.ofHom (LocallyConstant.constₗ R)
      naturality := fun {W₁ W₂} f => by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro r
        apply LocallyConstant.ext
        intro z
        rfl }
  let Φ : oneR ⟶ L_sh := (adj_sh.homEquiv P_const L_sh).symm ι_lc
  have hΦ_unit : η_sh ≫ Φ.hom = ι_lc :=
    (adj_sh.homEquiv P_const L_sh).apply_symm_apply ι_lc
  let ev : ∀ U : S.Etale, ↑(oneR.obj.obj (Opposite.op U)) →ₗ[R] LocallyConstant ↥((Fgt.obj U).left) R :=
    fun U => (Φ.hom.app (Opposite.op U)).hom
  have hev_res : ∀ {U₁ U₂ : S.Etale} (u : U₁ ⟶ U₂)
      (s : ↑(oneR.obj.obj (Opposite.op U₂))) (z : ↥((Fgt.obj U₁).left)),
      ev U₁ ((oneR.obj.map (Opposite.op u)).hom s) z = ev U₂ s (((Fgt.map u).left).base z) := by
    intro U₁ U₂ u s z
    have hnat := Φ.hom.naturality (Opposite.op u)
    exact congrArg (fun φ : oneR.obj.obj (Opposite.op U₂) ⟶ P_lc.obj (Opposite.op U₁) =>
      (φ.hom s) z) hnat
  have hev_unit : ∀ (U : S.Etale) (r : R) (z : ↥((Fgt.obj U).left)),
      ev U ((η_sh.app (Opposite.op U)).hom r) z = r := by
    intro U r z
    exact congrArg (fun α : P_const ⟶ P_lc => ((α.app (Opposite.op U)).hom r) z) hΦ_unit

  
  let oneR_type := oneR.obj ⋙ CategoryTheory.forget ModR
  have hOne_type : CategoryTheory.Presieve.IsSheaf J oneR_type :=
    (CategoryTheory.isSheaf_iff_isSheaf_of_type J _).mp
      (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J oneR.obj
        (CategoryTheory.forget ModR) oneR.property)
  have hGlue_arr : ∀ {U : S.Etale} {ι : Type u} (Y : ι → S.Etale) (π : ∀ i : ι, Y i ⟶ U),
      (∀ x : ↥U.left, ∃ (i : ι) (y : ↥(Y i).left), (π i).left.base y = x) →
      ∀ (sec : ∀ i : ι, ↑(oneR.obj.obj (Opposite.op (Y i)))),
        CategoryTheory.Presieve.Arrows.Compatible oneR_type π sec →
        ∃! t : ↑(oneR.obj.obj (Opposite.op U)),
          ∀ i : ι, (oneR.obj.map (Opposite.op (π i))).hom t = sec i := by
    intro U ι Y π hsurj sec hcompat
    have hmem : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows Y π) ∈ J U := by
      rw [hJ_mem]
      intro x
      obtain ⟨i, y, hy⟩ := hsurj x
      refine ⟨Y i, π i, y, ?_, hEt_hom (π i), hy⟩
      exact CategoryTheory.Sieve.le_generate (CategoryTheory.Presieve.ofArrows Y π) (Y i) (π i)
        (CategoryTheory.Presieve.ofArrows.mk i)
    exact (CategoryTheory.Presieve.isSheafFor_arrows_iff oneR_type π).mp
      (hOne_type.isSheafFor (CategoryTheory.Presieve.ofArrows Y π) hmem) sec hcompat
  have hUnique_arr : ∀ {U : S.Etale} {ι : Type u} (Y : ι → S.Etale) (π : ∀ i : ι, Y i ⟶ U),
      (∀ x : ↥U.left, ∃ (i : ι) (y : ↥(Y i).left), (π i).left.base y = x) →
      ∀ (t₁ t₂ : ↑(oneR.obj.obj (Opposite.op U))),
        (∀ i : ι, (oneR.obj.map (Opposite.op (π i))).hom t₁ =
          (oneR.obj.map (Opposite.op (π i))).hom t₂) →
        t₁ = t₂ := by
    intro U ι Y π hsurj t₁ t₂ heq
    let sec : ∀ i : ι, ↑(oneR.obj.obj (Opposite.op (Y i))) :=
      fun i => (oneR.obj.map (Opposite.op (π i))).hom t₁
    have hcompat : CategoryTheory.Presieve.Arrows.Compatible oneR_type π sec := by
      intro i j Z g₁ g₂ hcomm
      have h1 : (oneR.obj.map g₁.op).hom ((oneR.obj.map (π i).op).hom t₁) =
          (oneR.obj.map (g₁ ≫ π i).op).hom t₁ :=
        congrArg (fun φ => φ.hom t₁) (oneR.obj.map_comp (π i).op g₁.op).symm
      have h2 : (oneR.obj.map g₂.op).hom ((oneR.obj.map (π j).op).hom t₁) =
          (oneR.obj.map (g₂ ≫ π j).op).hom t₁ :=
        congrArg (fun φ => φ.hom t₁) (oneR.obj.map_comp (π j).op g₂.op).symm
      exact h1.trans ((congrArg (fun h => (oneR.obj.map h.op).hom t₁) hcomm).trans h2.symm)
    obtain ⟨t₀, _, huniq⟩ := hGlue_arr Y π hsurj sec hcompat
    exact (huniq t₁ (fun _ => rfl)).trans (huniq t₂ (fun i => (heq i).symm)).symm
  have hEmpty_sub : ∀ (Z : S.Etale), IsEmpty ↥Z.left →
      ∀ (t₁ t₂ : ↑(oneR.obj.obj (Opposite.op Z))), t₁ = t₂ := by
    intro Z hEmp t₁ t₂
    exact hUnique_arr (ι := PEmpty.{u + 1}) (fun i => i.elim) (fun i => i.elim)
      (fun x => hEmp.elim x) t₁ t₂ (fun i => i.elim)
  have hη_nat : ∀ {V₁ V₂ : S.Etale} (g : V₁ ⟶ V₂) (r : R),
      (oneR.obj.map (Opposite.op g)).hom ((η_sh.app (Opposite.op V₂)).hom r) =
        (η_sh.app (Opposite.op V₁)).hom r := by
    intro V₁ V₂ g r
    have hnat := η_sh.naturality (Opposite.op g)
    exact (congrArg (fun φ : P_const.obj (Opposite.op V₂) ⟶ oneR.obj.obj (Opposite.op V₁) =>
      φ.hom r) hnat).symm

  let mkOpenEt : ∀ (U : S.Etale) (W : U.left.Opens), S.Etale :=
    fun U W =>
      letI : AlgebraicGeometry.Etale U.hom := U.prop
      AlgebraicGeometry.Scheme.Etale.mk (W.ι ≫ U.hom)
  let mkOpenHom : ∀ (U : S.Etale) (W : U.left.Opens), mkOpenEt U W ⟶ U :=
    fun U W => CategoryTheory.MorphismProperty.Over.homMk W.ι rfl
  let lvlOpen : ∀ (U : S.Etale) (f : LocallyConstant ↥U.left R) (x : ↥U.left), U.left.Opens :=
    fun U f x => ⟨f ⁻¹' {f x}, f.isLocallyConstant {f x}⟩

  have hψ_ex : ∀ (U : S.Etale) (f : LocallyConstant ↥U.left R),
      ∃! t : ↑(oneR.obj.obj (Opposite.op U)),
        ∀ x : ↥U.left,
          (oneR.obj.map (Opposite.op (mkOpenHom U (lvlOpen U f x)))).hom t =
            (η_sh.app (Opposite.op (mkOpenEt U (lvlOpen U f x)))).hom (f x) := by
    intro U f
    let Y : ↥U.left → S.Etale := fun x => mkOpenEt U (lvlOpen U f x)
    let π : ∀ x : ↥U.left, Y x ⟶ U := fun x => mkOpenHom U (lvlOpen U f x)
    let sec : ∀ x : ↥U.left, ↑(oneR.obj.obj (Opposite.op (Y x))) :=
      fun x => (η_sh.app (Opposite.op (Y x))).hom (f x)
    have hsurj : ∀ x : ↥U.left, ∃ (i : ↥U.left) (y : ↥(Y i).left), (π i).left.base y = x :=
      fun x => ⟨x, ⟨x, rfl⟩, rfl⟩
    have hcompat : CategoryTheory.Presieve.Arrows.Compatible oneR_type π sec := by
      intro x₁ x₂ Z g₁ g₂ hcomm
      have h1 : (oneR.obj.map g₁.op).hom (sec x₁) = (η_sh.app (Opposite.op Z)).hom (f x₁) :=
        hη_nat g₁ (f x₁)
      have h2 : (oneR.obj.map g₂.op).hom (sec x₂) = (η_sh.app (Opposite.op Z)).hom (f x₂) :=
        hη_nat g₂ (f x₂)
      refine h1.trans (Eq.trans ?_ h2.symm)
      rcases isEmpty_or_nonempty ↥Z.left with hEmp | hNe
      · exact hEmpty_sub Z hEmp _ _
      · obtain ⟨z₀⟩ := hNe
        have hz₁ : f ((π x₁).left.base (g₁.left.base z₀)) = f x₁ := (g₁.left.base z₀).2
        have hz₂ : f ((π x₂).left.base (g₂.left.base z₀)) = f x₂ := (g₂.left.base z₀).2
        have hpt : (π x₁).left.base (g₁.left.base z₀) = (π x₂).left.base (g₂.left.base z₀) :=
          congrArg (fun h : Z ⟶ U => h.left.base z₀) hcomm
        exact congrArg ((η_sh.app (Opposite.op Z)).hom)
          (hz₁.symm.trans ((congrArg f hpt).trans hz₂))
    exact hGlue_arr Y π hsurj sec hcompat

  classical
  let ψ₀ : ∀ (U : S.Etale), LocallyConstant ↥U.left R → ↑(oneR.obj.obj (Opposite.op U)) :=
    fun U f => Classical.choose (hψ_ex U f)
  have hψ₀_spec : ∀ (U : S.Etale) (f : LocallyConstant ↥U.left R) (x : ↥U.left),
      (oneR.obj.map (Opposite.op (mkOpenHom U (lvlOpen U f x)))).hom (ψ₀ U f) =
        (η_sh.app (Opposite.op (mkOpenEt U (lvlOpen U f x)))).hom (f x) :=
    fun U f => (Classical.choose_spec (hψ_ex U f)).1

  have hψ₀_const_pull : ∀ {V U : S.Etale} (f : LocallyConstant ↥U.left R) (g : V ⟶ U) (r : R),
      (∀ y : ↥V.left, f (g.left.base y) = r) →
      (oneR.obj.map (Opposite.op g)).hom (ψ₀ U f) = (η_sh.app (Opposite.op V)).hom r := by
    intro V U f g r hg_const
    rcases isEmpty_or_nonempty ↥V.left with hEmp | hNe
    · exact hEmpty_sub V hEmp _ _
    · obtain ⟨y₀⟩ := hNe
      let x₀ : ↥U.left := g.left.base y₀
      have hfx₀ : f x₀ = r := hg_const y₀
      let W₀ := lvlOpen U f x₀
      have hrange : Set.range g.left.base ⊆ Set.range W₀.ι.base := by
        rintro _ ⟨y, rfl⟩
        exact ⟨⟨g.left.base y, (hg_const y).trans hfx₀.symm⟩, rfl⟩
      let g_tilde : V.left ⟶ W₀.toScheme := AlgebraicGeometry.IsOpenImmersion.lift W₀.ι g.left hrange
      have hfac : g_tilde ≫ W₀.ι = g.left :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac W₀.ι g.left hrange
      let g_et : V ⟶ mkOpenEt U W₀ :=
        CategoryTheory.MorphismProperty.Over.homMk g_tilde (by
          change g_tilde ≫ (W₀.ι ≫ U.hom) = V.hom
          rw [← CategoryTheory.Category.assoc, hfac, CategoryTheory.MorphismProperty.Over.w g])
      have hg_eq : g_et ≫ mkOpenHom U W₀ = g :=
        CategoryTheory.MorphismProperty.Over.Hom.ext hfac
      have hmap : oneR.obj.map (Opposite.op g) =
          oneR.obj.map (Opposite.op (mkOpenHom U W₀)) ≫ oneR.obj.map (Opposite.op g_et) :=
        (congrArg (fun h => oneR.obj.map (Opposite.op h)) hg_eq.symm).trans
          (oneR.obj.map_comp (Opposite.op (mkOpenHom U W₀)) (Opposite.op g_et))
      have happ : (oneR.obj.map (Opposite.op g)).hom (ψ₀ U f) =
          (oneR.obj.map (Opposite.op g_et)).hom
            ((oneR.obj.map (Opposite.op (mkOpenHom U W₀))).hom (ψ₀ U f)) :=
        congrArg (fun φ => φ.hom (ψ₀ U f)) hmap
      exact happ.trans
        ((congrArg ((oneR.obj.map (Opposite.op g_et)).hom) (hψ₀_spec U f x₀)).trans
          ((hη_nat g_et (f x₀)).trans (congrArg ((η_sh.app (Opposite.op V)).hom) hfx₀)))

  let ψ : ∀ U : S.Etale, LocallyConstant ↥((Fgt.obj U).left) R →ₗ[R] ↑(oneR.obj.obj (Opposite.op U)) :=
    fun U =>
      { toFun := ψ₀ U
        map_add' := fun f₁ f₂ => by
          let W₁₂ : ↥U.left → U.left.Opens := fun x =>
            ⟨f₁ ⁻¹' {f₁ x} ∩ f₂ ⁻¹' {f₂ x},
              (f₁.isLocallyConstant {f₁ x}).inter (f₂.isLocallyConstant {f₂ x})⟩
          let Y₁₂ : ↥U.left → S.Etale := fun x => mkOpenEt U (W₁₂ x)
          let π₁₂ : ∀ x : ↥U.left, Y₁₂ x ⟶ U := fun x => mkOpenHom U (W₁₂ x)
          apply hUnique_arr Y₁₂ π₁₂ (fun x => ⟨x, ⟨x, ⟨rfl, rfl⟩⟩, rfl⟩)
          intro x
          have hL : (oneR.obj.map (Opposite.op (π₁₂ x))).hom (ψ₀ U (f₁ + f₂)) =
              (η_sh.app (Opposite.op (Y₁₂ x))).hom (f₁ x + f₂ x) :=
            hψ₀_const_pull (f₁ + f₂) (π₁₂ x) (f₁ x + f₂ x) (fun y =>
              congrArg₂ (· + ·) y.2.1 y.2.2)
          have hR₁ : (oneR.obj.map (Opposite.op (π₁₂ x))).hom (ψ₀ U f₁) =
              (η_sh.app (Opposite.op (Y₁₂ x))).hom (f₁ x) :=
            hψ₀_const_pull f₁ (π₁₂ x) (f₁ x) (fun y => y.2.1)
          have hR₂ : (oneR.obj.map (Opposite.op (π₁₂ x))).hom (ψ₀ U f₂) =
              (η_sh.app (Opposite.op (Y₁₂ x))).hom (f₂ x) :=
            hψ₀_const_pull f₂ (π₁₂ x) (f₂ x) (fun y => y.2.2)
          exact hL.trans
            ((map_add ((η_sh.app (Opposite.op (Y₁₂ x))).hom) (f₁ x) (f₂ x)).trans
              ((congrArg₂ (· + ·) hR₁.symm hR₂.symm).trans
                (map_add ((oneR.obj.map (Opposite.op (π₁₂ x))).hom) (ψ₀ U f₁) (ψ₀ U f₂)).symm))
        map_smul' := fun r f => by
          let Y : ↥U.left → S.Etale := fun x => mkOpenEt U (lvlOpen U f x)
          let π : ∀ x : ↥U.left, Y x ⟶ U := fun x => mkOpenHom U (lvlOpen U f x)
          apply hUnique_arr Y π (fun x => ⟨x, ⟨x, rfl⟩, rfl⟩)
          intro x
          have hL : (oneR.obj.map (Opposite.op (π x))).hom (ψ₀ U (r • f)) =
              (η_sh.app (Opposite.op (Y x))).hom (r • f x) :=
            hψ₀_const_pull (r • f) (π x) (r • f x) (fun y => congrArg (r • ·) y.2)
          have hR : (oneR.obj.map (Opposite.op (π x))).hom (ψ₀ U f) =
              (η_sh.app (Opposite.op (Y x))).hom (f x) :=
            hψ₀_const_pull f (π x) (f x) (fun y => y.2)
          exact hL.trans
            ((map_smul ((η_sh.app (Opposite.op (Y x))).hom) r (f x)).trans
              ((congrArg (r • ·) hR.symm).trans
                (map_smul ((oneR.obj.map (Opposite.op (π x))).hom) r (ψ₀ U f)).symm)) }

  have hψ_const : ∀ (U : S.Etale) (r : R),
      ψ U (LocallyConstant.const ↥((Fgt.obj U).left) r) = (η_sh.app (Opposite.op U)).hom r := by
    intro U r
    have h1 := hψ₀_const_pull (LocallyConstant.const ↥U.left r) (CategoryTheory.CategoryStruct.id U) r
      (fun _ => rfl)
    have hid : (oneR.obj.map (Opposite.op (CategoryTheory.CategoryStruct.id U))).hom
        (ψ₀ U (LocallyConstant.const ↥U.left r)) =
        ψ₀ U (LocallyConstant.const ↥U.left r) :=
      congrArg (fun φ => φ.hom (ψ₀ U (LocallyConstant.const ↥U.left r)))
        (oneR.obj.map_id (Opposite.op U))
    exact hid.symm.trans h1

  have hψ_res : ∀ {U₁ U₂ : S.Etale} (u : U₁ ⟶ U₂)
      (f₂ : LocallyConstant ↥((Fgt.obj U₂).left) R)
      (f₁ : LocallyConstant ↥((Fgt.obj U₁).left) R),
      (∀ z : ↥((Fgt.obj U₁).left), f₁ z = f₂ (((Fgt.map u).left).base z)) →
      (oneR.obj.map (Opposite.op u)).hom (ψ U₂ f₂) = ψ U₁ f₁ := by
    intro U₁ U₂ u f₂ f₁ hf
    let Y₁ : ↥U₁.left → S.Etale := fun x => mkOpenEt U₁ (lvlOpen U₁ f₁ x)
    let π₁ : ∀ x : ↥U₁.left, Y₁ x ⟶ U₁ := fun x => mkOpenHom U₁ (lvlOpen U₁ f₁ x)
    apply hUnique_arr Y₁ π₁ (fun x => ⟨x, ⟨x, rfl⟩, rfl⟩)
    intro x
    have happ : (oneR.obj.map (Opposite.op (π₁ x ≫ u))).hom (ψ U₂ f₂) =
        (oneR.obj.map (Opposite.op (π₁ x))).hom ((oneR.obj.map (Opposite.op u)).hom (ψ U₂ f₂)) :=
      congrArg (fun φ => φ.hom (ψ U₂ f₂))
        (oneR.obj.map_comp (Opposite.op u) (Opposite.op (π₁ x)))
    have hL : (oneR.obj.map (Opposite.op (π₁ x ≫ u))).hom (ψ₀ U₂ f₂) =
        (η_sh.app (Opposite.op (Y₁ x))).hom (f₁ x) :=
      hψ₀_const_pull f₂ (π₁ x ≫ u) (f₁ x) (fun y => by
        have hcomp : (π₁ x ≫ u).left.base y = u.left.base y.1 := rfl
        exact (congrArg f₂ hcomp).trans ((hf y.1).symm.trans y.2))
    have hR : (oneR.obj.map (Opposite.op (π₁ x))).hom (ψ₀ U₁ f₁) =
        (η_sh.app (Opposite.op (Y₁ x))).hom (f₁ x) :=
      hψ₀_const_pull f₁ (π₁ x) (f₁ x) (fun y => y.2)
    exact happ.symm.trans (hL.trans hR.symm)

  
  let End_sh : oneR ⟶ oneR :=
    { hom :=
        { app := fun W => ModuleCat.ofHom ((ψ W.unop).comp (ev W.unop))
          naturality := fun {W₁ W₂} f => by
            apply ModuleCat.hom_ext
            apply LinearMap.ext
            intro s
            exact (hψ_res f.unop (ev W₁.unop s) (ev W₂.unop ((oneR.obj.map (Opposite.op f.unop)).hom s))
              (fun z => hev_res f.unop s z)).symm } }
  have hEnd_unit : η_sh ≫ End_sh.hom = η_sh ≫ (CategoryTheory.CategoryStruct.id oneR).hom := by
    ext W : 2
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro r
    change ψ W.unop (ev W.unop ((η_sh.app W).hom r)) = (η_sh.app W).hom r
    have hev_const : ev W.unop ((η_sh.app W).hom r) =
        LocallyConstant.const ↥((Fgt.obj W.unop).left) r := by
      apply LocallyConstant.ext
      intro z
      exact hev_unit W.unop r z
    exact (congrArg (ψ W.unop) hev_const).trans (hψ_const W.unop r)
  have hEnd_id : End_sh = CategoryTheory.CategoryStruct.id oneR :=
    (adj_sh.homEquiv P_const oneR).injective hEnd_unit
  have h_retract : ∀ (U : S.Etale) (s : ↑(oneR.obj.obj (Opposite.op U))), ψ U (ev U s) = s := by
    intro U s
    exact congrArg (fun α : oneR ⟶ oneR => ((α.hom.app (Opposite.op U)).hom) s) hEnd_id
  have h_inj : ∀ U : S.Etale, Function.Injective (ev U) := by
    intro U s₁ s₂ heq
    exact (h_retract U s₁).symm.trans ((congrArg (ψ U) heq).trans (h_retract U s₂))

  
  refine ⟨?_, ?_⟩
  · 
    have hdown_nsmul : ∀ (k : ℕ), (k • (1 : R)).down = (k : ZMod n) := by
      intro k
      induction k with
      | zero =>
        rw [zero_nsmul, Nat.cast_zero]
        rfl
      | succ k ih =>
        rw [succ_nsmul, Nat.cast_succ]
        change (k • (1 : R)).down + (1 : R).down = (k : ZMod n) + 1
        rw [ih]
        rfl
    have hval_R : ∀ c : ZMod n, c.val • (1 : R) = ULift.up c := by
      intro c
      rcases eq_or_lt_of_le hn with rfl | hn2
      · exact ULift.ext _ _ (Subsingleton.elim _ _)
      · have : NeZero n := ⟨by omega⟩
        apply ULift.ext
        change (c.val • (1 : R)).down = c
        rw [hdown_nsmul, ZMod.natCast_zmod_val]
    have hnsmul_id_app : ∀ (k : ℕ) (U : S.Etale) (s : ↑(oneR.obj.obj (Opposite.op U))),
        (((k • CategoryTheory.CategoryStruct.id oneR).hom.app (Opposite.op U)).hom s) = k • s := by
      intro k U s
      induction k with
      | zero =>
        rw [zero_nsmul, zero_nsmul]
        rfl
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul, ← ih]
        rfl
    have hlc_nsmul : ∀ {X : Type u} [TopologicalSpace X] (k : ℕ) (g : LocallyConstant X R) (x : X),
        (k • g) x = k • (g x) := by
      intro X _ k g x
      induction k with
      | zero =>
        rw [zero_nsmul, zero_nsmul]
        rfl
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul, LocallyConstant.add_apply, ih]
    let T_S : S.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S)
    let one_TS : ↑(oneR.obj.obj (Opposite.op T_S)) := (η_sh.app (Opposite.op T_S)).hom (1 : R)
    have hConn_TS : ConnectedSpace ↥((Fgt.obj T_S).left) := ‹ConnectedSpace ↥S›
    obtain ⟨x₀⟩ : Nonempty ↥((Fgt.obj T_S).left) := @ConnectedSpace.toNonempty _ _ hConn_TS
    have hPre_TS : PreconnectedSpace ↥((Fgt.obj T_S).left) :=
      @ConnectedSpace.toPreconnectedSpace _ _ hConn_TS
    have hev_nsmul_one : ∀ (k : ℕ) (x : ↥((Fgt.obj T_S).left)),
        ev T_S (k • one_TS) x = k • (1 : R) := by
      intro k x
      calc
        ev T_S (k • one_TS) x = (k • ev T_S one_TS) x :=
          congrArg (fun fn : LocallyConstant ↥((Fgt.obj T_S).left) R => fn x)
            (map_nsmul (ev T_S) k one_TS)
        _ = k • (ev T_S one_TS x) := hlc_nsmul k (ev T_S one_TS) x
        _ = k • (1 : R) := congrArg (k • ·) (hev_unit T_S (1 : R) x)
    refine ⟨?_, ?_⟩
    · 
      intro c₁ c₂ heq
      have happ : ev T_S ((((c₁.val • CategoryTheory.CategoryStruct.id oneR).hom.app
            (Opposite.op T_S)).hom) one_TS) x₀ =
          ev T_S ((((c₂.val • CategoryTheory.CategoryStruct.id oneR).hom.app
            (Opposite.op T_S)).hom) one_TS) x₀ :=
        congrArg (fun α : oneR ⟶ oneR =>
          ev T_S (((α.hom.app (Opposite.op T_S)).hom) one_TS) x₀) heq
      have hL : ev T_S ((((c₁.val • CategoryTheory.CategoryStruct.id oneR).hom.app
            (Opposite.op T_S)).hom) one_TS) x₀ = ULift.up c₁ :=
        (congrArg (fun s => ev T_S s x₀) (hnsmul_id_app c₁.val T_S one_TS)).trans
          ((hev_nsmul_one c₁.val x₀).trans (hval_R c₁))
      have hR : ev T_S ((((c₂.val • CategoryTheory.CategoryStruct.id oneR).hom.app
            (Opposite.op T_S)).hom) one_TS) x₀ = ULift.up c₂ :=
        (congrArg (fun s => ev T_S s x₀) (hnsmul_id_app c₂.val T_S one_TS)).trans
          ((hev_nsmul_one c₂.val x₀).trans (hval_R c₂))
      exact congrArg ULift.down (hL.symm.trans (happ.trans hR))
    · 
      intro α
      let s₁ : ↑(oneR.obj.obj (Opposite.op T_S)) := (α.hom.app (Opposite.op T_S)).hom one_TS
      let g : LocallyConstant ↥((Fgt.obj T_S).left) R := ev T_S s₁
      let c : ZMod n := (g x₀).down
      have hgx₀ : g x₀ = c.val • (1 : R) := (hval_R c).symm
      have hg_eq : g = ev T_S (c.val • one_TS) := by
        apply LocallyConstant.ext
        intro x
        have hconst : g x = g x₀ :=
          @LocallyConstant.apply_eq_of_preconnectedSpace _ _ _ hPre_TS g x x₀
        exact hconst.trans (hgx₀.trans (hev_nsmul_one c.val x).symm)
      have hs₁_eq : s₁ = c.val • one_TS := h_inj T_S hg_eq
      refine ⟨c, ?_⟩
      apply (adj_sh.homEquiv P_const oneR).injective
      change η_sh ≫ (c.val • CategoryTheory.CategoryStruct.id oneR).hom = η_sh ≫ α.hom
      ext W : 2
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro (r : R)
      let U : S.Etale := W.unop
      let τ_U : U ⟶ T_S := CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom)
      have hnat_α : (oneR.obj.map (Opposite.op τ_U)).hom s₁ =
          (α.hom.app (Opposite.op U)).hom ((oneR.obj.map (Opposite.op τ_U)).hom one_TS) :=
        (congrArg (fun φ => φ.hom one_TS) (α.hom.naturality (Opposite.op τ_U))).symm
      have h_at_one : (((c.val • CategoryTheory.CategoryStruct.id oneR).hom.app (Opposite.op U)).hom
            ((η_sh.app (Opposite.op U)).hom (1 : R))) =
          (α.hom.app (Opposite.op U)).hom ((η_sh.app (Opposite.op U)).hom (1 : R)) := by
        have h1 : (((c.val • CategoryTheory.CategoryStruct.id oneR).hom.app (Opposite.op U)).hom
            ((η_sh.app (Opposite.op U)).hom (1 : R))) =
            c.val • ((η_sh.app (Opposite.op U)).hom (1 : R)) :=
          hnsmul_id_app c.val U ((η_sh.app (Opposite.op U)).hom (1 : R))
        have h2 : c.val • ((η_sh.app (Opposite.op U)).hom (1 : R)) =
            c.val • ((oneR.obj.map (Opposite.op τ_U)).hom one_TS) :=
          congrArg (c.val • ·) (hη_nat τ_U (1 : R)).symm
        have h3 : c.val • ((oneR.obj.map (Opposite.op τ_U)).hom one_TS) =
            (oneR.obj.map (Opposite.op τ_U)).hom s₁ :=
          (map_nsmul ((oneR.obj.map (Opposite.op τ_U)).hom) c.val one_TS).symm.trans
            (congrArg ((oneR.obj.map (Opposite.op τ_U)).hom) hs₁_eq.symm)
        have h4 : (α.hom.app (Opposite.op U)).hom ((oneR.obj.map (Opposite.op τ_U)).hom one_TS) =
            (α.hom.app (Opposite.op U)).hom ((η_sh.app (Opposite.op U)).hom (1 : R)) :=
          congrArg ((α.hom.app (Opposite.op U)).hom) (hη_nat τ_U (1 : R))
        exact h1.trans (h2.trans (h3.trans (hnat_α.trans h4)))
      have hr : r = r • (1 : R) := ((smul_eq_mul r 1).trans (mul_one r)).symm
      change (((c.val • CategoryTheory.CategoryStruct.id oneR).hom.app (Opposite.op U)).hom
          ((η_sh.app (Opposite.op U)).hom r)) =
        (α.hom.app (Opposite.op U)).hom ((η_sh.app (Opposite.op U)).hom r)
      calc
        (((c.val • CategoryTheory.CategoryStruct.id oneR).hom.app (Opposite.op U)).hom
            ((η_sh.app (Opposite.op U)).hom r))
          = (((c.val • CategoryTheory.CategoryStruct.id oneR).hom.app (Opposite.op U)).hom
              ((η_sh.app (Opposite.op U)).hom (r • (1 : R)))) := by
            exact congrArg (fun x => (((c.val • CategoryTheory.CategoryStruct.id oneR).hom.app
              (Opposite.op U)).hom ((η_sh.app (Opposite.op U)).hom x))) hr
        _ = r • (((c.val • CategoryTheory.CategoryStruct.id oneR).hom.app (Opposite.op U)).hom
              ((η_sh.app (Opposite.op U)).hom (1 : R))) := by
            exact (congrArg (((c.val • CategoryTheory.CategoryStruct.id oneR).hom.app
              (Opposite.op U)).hom) (map_smul ((η_sh.app (Opposite.op U)).hom) r (1 : R))).trans
              (map_smul (((c.val • CategoryTheory.CategoryStruct.id oneR).hom.app
                (Opposite.op U)).hom) r ((η_sh.app (Opposite.op U)).hom (1 : R)))
        _ = r • ((α.hom.app (Opposite.op U)).hom ((η_sh.app (Opposite.op U)).hom (1 : R))) :=
            congrArg (r • ·) h_at_one
        _ = (α.hom.app (Opposite.op U)).hom ((η_sh.app (Opposite.op U)).hom (r • (1 : R))) := by
            exact (map_smul ((α.hom.app (Opposite.op U)).hom) r
              ((η_sh.app (Opposite.op U)).hom (1 : R))).symm.trans
              (congrArg ((α.hom.app (Opposite.op U)).hom)
                (map_smul ((η_sh.app (Opposite.op U)).hom) r (1 : R)).symm)
        _ = (α.hom.app (Opposite.op U)).hom ((η_sh.app (Opposite.op U)).hom r) := by
            exact congrArg (fun x => (α.hom.app (Opposite.op U)).hom ((η_sh.app (Opposite.op U)).hom x))
              hr.symm
  · 
    intro U s y
    let f : LocallyConstant ↥((Fgt.obj U).left) R := ev U s
    let c : ZMod n := (f y).down
    let W₀ : ((Fgt.obj U).left).Opens := lvlOpen U f y
    let U₀ : S.Etale := mkOpenEt U W₀
    let u₀ : Quiver.Hom U₀ U := mkOpenHom U W₀
    let y₀ : ↥((Fgt.obj U₀).left) := ⟨y, rfl⟩
    refine ⟨U₀, u₀, y₀, c, rfl, ?_⟩
    exact (congrArg ((oneR.obj.map (Opposite.op u₀)).hom) (h_retract U s).symm).trans
      (hψ₀_const_pull f u₀ (ULift.up c) (fun z => z.2))

theorem weil_cupPD_colimit_dual_injective_sheaf (S : AlgebraicGeometry.Scheme.{u}) (n : ℕ) (hn : 1 ≤ n)
    (hInjR : Module.Injective (ULift.{u, 0} (ZMod n)) (ULift.{u, 0} (ZMod n))) :
    WeilCupPDHasVerdierDualSheafRep S n :=
by
  let _ := hn
  intro C hFinLim hColim
  let R := ULift.{u, 0} (ZMod n)
  let J := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
  let R_M : ModuleCat.{u, u} R := ModuleCat.of R R
  have : CategoryTheory.Limits.PreservesFiniteLimits C := hFinLim
  have : CategoryTheory.Limits.PreservesColimitsOfSize.{u, u} C := hColim
  have : Module.Injective R R := hInjR
  let aux : ∀ (𝒞₀ : Type (u + 1)) [CategoryTheory.Category.{u + 1, u + 1} 𝒞₀]
      [CategoryTheory.Abelian 𝒞₀] [CategoryTheory.IsGrothendieckAbelian.{u} 𝒞₀]
      (F : CategoryTheory.Functor 𝒞₀ (ModuleCat.{u, u} R))
      [CategoryTheory.Limits.PreservesColimitsOfSize.{u, u} F], F.IsLeftAdjoint :=
    fun 𝒞₀ _ _ _ F _ =>
      letI : CategoryTheory.Limits.HasColimitsOfSize.{u, u} 𝒞₀ :=
        CategoryTheory.Limits.hasColimitsOfSizeShrink 𝒞₀
      letI : CategoryTheory.HasSeparator 𝒞₀ :=
        CategoryTheory.IsGrothendieckAbelian.hasSeparator (C := 𝒞₀)
      CategoryTheory.isLeftAdjoint_of_preservesColimits_of_isSeparating.{u}
        (CategoryTheory.isSeparator_separator 𝒞₀) F
  let auxAdd : ∀ {𝒞₀ : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞₀]
      [CategoryTheory.Abelian 𝒞₀]
      (F : CategoryTheory.Functor 𝒞₀ (ModuleCat.{u, u} R))
      [CategoryTheory.Limits.PreservesFiniteLimits F], F.Additive :=
    fun F => CategoryTheory.Functor.additive_of_preserves_binary_products F
  have : C.IsLeftAdjoint := aux 𝒞 C
  have : C.Additive := auxAdd C
  let adj := CategoryTheory.Adjunction.ofIsLeftAdjoint C
  let 𝒥 : 𝒞 := C.rightAdjoint.obj R_M
  let hInjRM : CategoryTheory.Injective R_M := Module.injective_object_of_injective_module R R
  let hInjJ : CategoryTheory.Injective 𝒥 := CategoryTheory.Adjunction.map_injective adj R_M hInjRM
  let eMod : ∀ F : 𝒞, (↑(C.obj F) →ₗ[R] R) ≃ Quiver.Hom (C.obj F) R_M :=
    fun _ =>
      { toFun := fun ψ => ModuleCat.ofHom ψ
        invFun := fun φ => φ.hom
        left_inv := fun _ => rfl
        right_inv := fun φ => ModuleCat.ofHom_hom φ }
  let Ψ : ∀ F : 𝒞, (↑(C.obj F) →ₗ[R] R) ≃ Quiver.Hom F 𝒥 :=
    fun F => (eMod F).trans (adj.homEquiv F R_M)
  refine ⟨𝒥, Ψ, hInjJ, ?_, ?_⟩
  · intro F ψ₁ ψ₂
    change (adj.homEquiv F R_M) (ModuleCat.ofHom (ψ₁ + ψ₂)) =
      (adj.homEquiv F R_M) (ModuleCat.ofHom ψ₁) + (adj.homEquiv F R_M) (ModuleCat.ofHom ψ₂)
    rw [ModuleCat.ofHom_add]
    exact CategoryTheory.Adjunction.homAddEquiv_add adj F R_M (ModuleCat.ofHom ψ₁) (ModuleCat.ofHom ψ₂)
  · intro F₁ F₂ f ψ
    have hcomp : CategoryTheory.CategoryStruct.comp (C.map f) (ModuleCat.ofHom ψ) =
        ModuleCat.ofHom (ψ.comp (C.map f).hom) := by
      rw [ModuleCat.ofHom_comp (C.map f).hom ψ, ModuleCat.ofHom_hom]
    change CategoryTheory.CategoryStruct.comp f ((adj.homEquiv F₂ R_M) (ModuleCat.ofHom ψ)) =
      (adj.homEquiv F₁ R_M) (ModuleCat.ofHom (ψ.comp (C.map f).hom))
    rw [← hcomp]
    exact (CategoryTheory.Adjunction.homEquiv_naturality_left adj f (ModuleCat.ofHom ψ)).symm

theorem weil_cupPD_verdier_dual_resolution_ext_pkg (S : AlgebraicGeometry.Scheme.{u}) (d n : ℕ) (hn : 1 ≤ n)
    (τ : weilCupPDModH S n (2 * d) →+ ZMod n)
    (hGod : WeilCupPDHasTruncatedGodement S d n)
    (hEff : WeilCupPDHasLocalEffacement S d n τ)
    (hInjR : Module.Injective (ULift.{u, 0} (ZMod n)) (ULift.{u, 0} (ZMod n)))
    (hGeomLift :
      let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
      ∀ (U : S.Etale) (y : ↥((Fgt.obj U).left)),
        let x : ↥S := ((Fgt.obj U).hom).base y
        let κ := S.residueField x
        let Ω := AlgebraicClosure ↥κ
        let gx : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) S :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
            (S.fromSpecResidueField x)
        ∃ (γ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (Fgt.obj U).left)
          (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω))),
          CategoryTheory.CategoryStruct.comp γ (Fgt.obj U).hom = gx ∧ γ.base pt = y)
    (hLocConst :
      let R := ULift.{u, 0} (ZMod n)
      let J := S.smallEtaleTopology
      let oneR := weilCupPDModUnit S n
      let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
      ∀ (U : S.Etale) (s : ↑(oneR.obj.obj (Opposite.op U))) (y : ↥((Fgt.obj U).left)),
        ∃ (U₀ : S.Etale) (u₀ : Quiver.Hom U₀ U) (y₀ : ↥((Fgt.obj U₀).left)) (c : ZMod n),
          ((Fgt.map u₀).left).base y₀ = y ∧
          (oneR.obj.map (Opposite.op u₀)).hom s =
            (((CategoryTheory.sheafificationAdjunction J (ModuleCat.{u, u} R)).unit.app
              ((CategoryTheory.Functor.const (Opposite S.Etale)).obj (ModuleCat.of R R))).app
              (Opposite.op U₀)).hom (ULift.up c))
    (hDualRep : WeilCupPDHasVerdierDualSheafRep S n) :
    WeilCupPDHasVerdierDualExtPackage S d n τ :=
by
  
  have hPillar1 :
      let R := ULift.{u, 0} (ZMod n)
      let J := S.smallEtaleTopology
      let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
      let oneR := weilCupPDModUnit S n
      ∃ (C : ℕ → CategoryTheory.Functor 𝒞 (ModuleCat.{u, u} R))
        (d_C : ∀ p : ℕ, CategoryTheory.NatTrans (C p) (C (p + 1)))
        (Υ : ∀ (F : 𝒞) (p : ℕ),
          ↥(LinearMap.ker (((d_C p).app F).hom)) →+
            CategoryTheory.Abelian.Ext.{u} oneR F p),
        (∀ p : ℕ, (C p).Additive) ∧
        (∀ p : ℕ,
          CategoryTheory.Limits.PreservesFiniteLimits (C p) ∧
          CategoryTheory.Limits.PreservesColimitsOfSize.{u, u} (C p)) ∧
        (∀ (p : ℕ) (F : 𝒞),
          (((d_C (p + 1)).app F).hom).comp (((d_C p).app F).hom) = 0) ∧
        (∀ F : 𝒞, ((d_C (2 * d)).app F).hom = 0) ∧
        (∀ (p : ℕ) (F : 𝒞), Function.Surjective (Υ F p)) ∧
        (∀ F : 𝒞, Function.Injective (Υ F 0)) ∧
        (∀ (p : ℕ) (F : 𝒞) (x : ↥(LinearMap.ker (((d_C (p + 1)).app F).hom))),
          Υ F (p + 1) x = 0 ↔ x.1 ∈ LinearMap.range (((d_C p).app F).hom)) ∧
        (∀ (p : ℕ) {F G : 𝒞} (φ : Quiver.Hom F G)
          (x : ↥(LinearMap.ker (((d_C p).app F).hom))),
          ∃ hx : ((C p).map φ).hom x.1 ∈ LinearMap.ker (((d_C p).app G).hom),
            (Υ F p x).comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero p) =
              Υ G p ⟨((C p).map φ).hom x.1, hx⟩) := by
    let R := ULift.{u, 0} (ZMod n)
    let J := S.smallEtaleTopology
    let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
    let oneR := weilCupPDModUnit S n
    have hAbsP1 : ∀ {𝒞₀ : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞₀]
        [CategoryTheory.Abelian 𝒞₀] [CategoryTheory.HasExt.{u} 𝒞₀]
        (one₀ : 𝒞₀)
        (Γ₀ : CategoryTheory.Functor 𝒞₀ (ModuleCat.{u, u} R))
        (γ : ∀ W : 𝒞₀, (one₀ ⟶ W) ≃+ ↑(Γ₀.obj W))
        (_hγ_nat : ∀ {W₁ W₂ : 𝒞₀} (g : W₁ ⟶ W₂) (u : one₀ ⟶ W₁),
          γ W₂ (u ≫ g) = (Γ₀.map g).hom (γ W₁ u))
        (𝒯 : ℕ → CategoryTheory.Functor 𝒞₀ 𝒞₀)
        (η : CategoryTheory.Functor.id 𝒞₀ ⟶ 𝒯 0)
        (diff : ∀ q : ℕ, 𝒯 q ⟶ 𝒯 (q + 1))
        (_hMonoη : ∀ F : 𝒞₀, CategoryTheory.Mono (η.app F))
        (_hEx0 : ∀ F : 𝒞₀, ∃ h₀ : η.app F ≫ (diff 0).app F = 0,
          (CategoryTheory.ShortComplex.mk (η.app F) ((diff 0).app F) h₀).Exact)
        (_hExq : ∀ (q : ℕ) (F : 𝒞₀),
          ∃ hq : (diff q).app F ≫ (diff (q + 1)).app F = 0,
            (CategoryTheory.ShortComplex.mk ((diff q).app F) ((diff (q + 1)).app F) hq).Exact)
        (_hAcyc : ∀ (q k : ℕ), 1 ≤ k → ∀ F : 𝒞₀,
          Subsingleton (CategoryTheory.Abelian.Ext.{u} one₀ ((𝒯 q).obj F) k)),
        let C : ℕ → CategoryTheory.Functor 𝒞₀ (ModuleCat.{u, u} R) :=
          fun p => (𝒯 p).comp Γ₀
        let d_C : ∀ p : ℕ, CategoryTheory.NatTrans (C p) (C (p + 1)) :=
          fun p =>
            { app := fun F => Γ₀.map ((diff p).app F)
              naturality := fun {X Y} f => by
                dsimp [C]
                rw [← Γ₀.map_comp, ← Γ₀.map_comp, (diff p).naturality f] }
        ∃ Υ : ∀ (F : 𝒞₀) (p : ℕ),
            ↥(LinearMap.ker (((d_C p).app F).hom)) →+
              CategoryTheory.Abelian.Ext.{u} one₀ F p,
          (∀ (p : ℕ) (F : 𝒞₀), Function.Surjective (Υ F p)) ∧
          (∀ F : 𝒞₀, Function.Injective (Υ F 0)) ∧
          (∀ (p : ℕ) (F : 𝒞₀) (x : ↥(LinearMap.ker (((d_C (p + 1)).app F).hom))),
            Υ F (p + 1) x = 0 ↔ x.1 ∈ LinearMap.range (((d_C p).app F).hom)) ∧
          (∀ (p : ℕ) {F G : 𝒞₀} (φ : F ⟶ G)
            (x : ↥(LinearMap.ker (((d_C p).app F).hom))),
            ∃ hx : ((C p).map φ).hom x.1 ∈ LinearMap.ker (((d_C p).app G).hom),
              (Υ F p x).comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero p) =
                Υ G p ⟨((C p).map φ).hom x.1, hx⟩) := by
      intro 𝒞₀ _ _ _ one₀ Γ₀ γ hγ_nat 𝒯 η diff hMonoη hEx0 hExq hAcyc C d_C
      have ext_sub_comp : ∀ {X Y W : 𝒞₀} {a b c : ℕ}
          (x₁ x₂ : CategoryTheory.Abelian.Ext.{u} X Y a)
          (z : CategoryTheory.Abelian.Ext.{u} Y W b) (h : a + b = c),
          (x₁ - x₂).comp z h = x₁.comp z h - x₂.comp z h := by
        intro X Y W a b c x₁ x₂ z h
        rw [eq_sub_iff_add_eq, ← CategoryTheory.Abelian.Ext.add_comp, sub_add_cancel]
      let Z : ℕ → 𝒞₀ → 𝒞₀ := fun p F => CategoryTheory.Limits.kernel ((diff p).app F)
      let ι : ∀ (p : ℕ) (F : 𝒞₀), Z p F ⟶ (𝒯 p).obj F :=
        fun p F => CategoryTheory.Limits.kernel.ι ((diff p).app F)
      have hι_mono : ∀ (p : ℕ) (F : 𝒞₀), CategoryTheory.Mono (ι p F) :=
        fun p F => CategoryTheory.Limits.equalizer.ι_mono
      let zMap : ∀ (p : ℕ) {F G : 𝒞₀}, (F ⟶ G) → (Z p F ⟶ Z p G) :=
        fun p {F G} φ =>
          CategoryTheory.Limits.kernel.lift ((diff p).app G) (ι p F ≫ (𝒯 p).map φ)
            (by rw [Category.assoc, (diff p).naturality φ, ← Category.assoc,
              CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp])
      have hzMap : ∀ (p : ℕ) {F G : 𝒞₀} (φ : F ⟶ G),
          zMap p φ ≫ ι p G = ι p F ≫ (𝒯 p).map φ :=
        fun p {_ _} _ => CategoryTheory.Limits.kernel.lift_ι _ _ _
      let h₀_w : ∀ F : 𝒞₀, η.app F ≫ (diff 0).app F = 0 :=
        fun F => Classical.choose (hEx0 F)
      have hEx₀_w : ∀ F : 𝒞₀,
          (CategoryTheory.ShortComplex.mk (η.app F) ((diff 0).app F) (h₀_w F)).Exact :=
        fun F => Classical.choose_spec (hEx0 F)
      let e₀ : ∀ F : 𝒞₀, F ⟶ Z 0 F :=
        fun F => CategoryTheory.Limits.kernel.lift ((diff 0).app F) (η.app F) (h₀_w F)
      have he₀_ι : ∀ F : 𝒞₀, e₀ F ≫ ι 0 F = η.app F :=
        fun F => CategoryTheory.Limits.kernel.lift_ι _ _ _
      have he₀_iso : ∀ F : 𝒞₀, CategoryTheory.IsIso (e₀ F) := by
        intro F
        have hm : CategoryTheory.Mono (e₀ F) := by
          have := hMonoη F
          exact CategoryTheory.mono_of_mono_fac (he₀_ι F)
        have he : CategoryTheory.Epi (e₀ F) :=
          CategoryTheory.ShortComplex.Exact.epi_kernelLift (hEx₀_w F)
        exact CategoryTheory.isIso_of_mono_of_epi (e₀ F)
      let _ : ∀ F : 𝒞₀, CategoryTheory.IsIso (e₀ F) := he₀_iso
      have hzMap0_inv : ∀ {F G : 𝒞₀} (φ : F ⟶ G),
          zMap 0 φ ≫ CategoryTheory.inv (e₀ G) = CategoryTheory.inv (e₀ F) ≫ φ := by
        intro F G φ
        have hcomm : φ ≫ e₀ G = e₀ F ≫ zMap 0 φ := by
          have := hι_mono 0 G
          rw [← CategoryTheory.cancel_mono (ι 0 G)]
          calc
            (φ ≫ e₀ G) ≫ ι 0 G = φ ≫ η.app G := by rw [Category.assoc, he₀_ι]
            _ = η.app F ≫ (𝒯 0).map φ := by simpa using η.naturality φ
            _ = e₀ F ≫ ι 0 F ≫ (𝒯 0).map φ := by rw [← Category.assoc, he₀_ι]
            _ = (e₀ F ≫ zMap 0 φ) ≫ ι 0 G := by rw [Category.assoc, hzMap]
        rw [CategoryTheory.IsIso.comp_inv_eq, Category.assoc, hcomm,
          CategoryTheory.IsIso.inv_hom_id_assoc]
      let hq_w : ∀ (p : ℕ) (F : 𝒞₀), (diff p).app F ≫ (diff (p + 1)).app F = 0 :=
        fun p F => Classical.choose (hExq p F)
      have hExq_w : ∀ (p : ℕ) (F : 𝒞₀),
          (CategoryTheory.ShortComplex.mk ((diff p).app F) ((diff (p + 1)).app F) (hq_w p F)).Exact :=
        fun p F => Classical.choose_spec (hExq p F)
      let π_Z : ∀ (p : ℕ) (F : 𝒞₀), (𝒯 p).obj F ⟶ Z (p + 1) F :=
        fun p F => CategoryTheory.Limits.kernel.lift ((diff (p + 1)).app F) ((diff p).app F) (hq_w p F)
      have hπ_ι : ∀ (p : ℕ) (F : 𝒞₀), π_Z p F ≫ ι (p + 1) F = (diff p).app F :=
        fun p F => CategoryTheory.Limits.kernel.lift_ι _ _ _
      have hπ_epi : ∀ (p : ℕ) (F : 𝒞₀), CategoryTheory.Epi (π_Z p F) :=
        fun p F => CategoryTheory.ShortComplex.Exact.epi_kernelLift (hExq_w p F)
      have hι_π : ∀ (p : ℕ) (F : 𝒞₀), ι p F ≫ π_Z p F = 0 := by
        intro p F
        have := hι_mono (p + 1) F
        rw [← CategoryTheory.cancel_mono (ι (p + 1) F), Category.assoc, hπ_ι,
          CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
      let S_p : ∀ (p : ℕ) (F : 𝒞₀), CategoryTheory.ShortComplex 𝒞₀ :=
        fun p F => CategoryTheory.ShortComplex.mk (ι p F) (π_Z p F) (hι_π p F)
      have hS_p : ∀ (p : ℕ) (F : 𝒞₀), (S_p p F).ShortExact := by
        intro p F
        have hker : ∀ {W : 𝒞₀} (k : W ⟶ (𝒯 p).obj F), k ≫ π_Z p F = 0 →
            ∃ m : W ⟶ Z p F, m ≫ ι p F = k := by
          intro W k hk
          have hk0 : k ≫ (diff p).app F = 0 := by
            rw [← hπ_ι p F, ← Category.assoc, hk, CategoryTheory.Limits.zero_comp]
          exact ⟨CategoryTheory.Limits.kernel.lift ((diff p).app F) k hk0,
            CategoryTheory.Limits.kernel.lift_ι _ _ _⟩
        have isLim : CategoryTheory.Limits.IsLimit
            (CategoryTheory.Limits.KernelFork.ofι (ι p F) (hι_π p F)) :=
          CategoryTheory.Limits.KernelFork.IsLimit.ofι _ (hι_π p F)
            (fun k hk => Classical.choose (hker k hk))
            (fun k hk => Classical.choose_spec (hker k hk))
            (fun k hk m hm => by
              have := hι_mono p F
              exact (CategoryTheory.cancel_mono (ι p F)).mp
                (hm.trans (Classical.choose_spec (hker k hk)).symm))
        exact
          { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel _ isLim
            mono_f := hι_mono p F
            epi_g := hπ_epi p F }
      let δ : ∀ (p : ℕ) (F : 𝒞₀), CategoryTheory.Abelian.Ext.{u} (Z (p + 1) F) (Z p F) 1 :=
        fun p F => (hS_p p F).extClass
      have hδ_nat : ∀ (p : ℕ) {F G : 𝒞₀} (φ : F ⟶ G),
          (δ p F).comp (CategoryTheory.Abelian.Ext.mk₀ (zMap p φ)) (Nat.add_zero 1) =
            (CategoryTheory.Abelian.Ext.mk₀ (zMap (p + 1) φ)).comp (δ p G) (Nat.zero_add 1) := by
        intro p F G φ
        have hπ_nat : (𝒯 p).map φ ≫ π_Z p G = π_Z p F ≫ zMap (p + 1) φ := by
          have := hι_mono (p + 1) G
          rw [← CategoryTheory.cancel_mono (ι (p + 1) G), Category.assoc, hπ_ι,
            Category.assoc, hzMap, ← Category.assoc, hπ_ι, (diff p).naturality φ]
        let mor : S_p p F ⟶ S_p p G :=
          CategoryTheory.ShortComplex.homMk (zMap p φ) ((𝒯 p).map φ) (zMap (p + 1) φ)
            (hzMap p φ) hπ_nat
        exact CategoryTheory.ShortComplex.ShortExact.extClass_naturality (hS_p p F) (hS_p p G) mor
      let D : ∀ (p : ℕ) (F : 𝒞₀), CategoryTheory.Abelian.Ext.{u} (Z p F) (Z 0 F) p :=
        fun p => Nat.rec
          (fun F => CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (Z 0 F)))
          (fun q ih F => (δ q F).comp (ih F) (Nat.one_add q)) p
      have hD_nat : ∀ (p : ℕ) {F G : 𝒞₀} (φ : F ⟶ G),
          (D p F).comp (CategoryTheory.Abelian.Ext.mk₀ (zMap 0 φ)) (Nat.add_zero p) =
            (CategoryTheory.Abelian.Ext.mk₀ (zMap p φ)).comp (D p G) (Nat.zero_add p) := by
        intro p
        induction p with
        | zero =>
          intro F G φ
          change (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (Z 0 F))).comp
              (CategoryTheory.Abelian.Ext.mk₀ (zMap 0 φ)) (Nat.add_zero 0) =
            (CategoryTheory.Abelian.Ext.mk₀ (zMap 0 φ)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (Z 0 G)))
              (Nat.zero_add 0)
          rw [CategoryTheory.Abelian.Ext.mk₀_id_comp, CategoryTheory.Abelian.Ext.comp_mk₀_id]
        | succ p ih =>
          intro F G φ
          change ((δ p F).comp (D p F) (Nat.one_add p)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (zMap 0 φ)) (Nat.add_zero (p + 1)) =
            (CategoryTheory.Abelian.Ext.mk₀ (zMap (p + 1) φ)).comp
              ((δ p G).comp (D p G) (Nat.one_add p)) (Nat.zero_add (p + 1))
          rw [CategoryTheory.Abelian.Ext.comp_assoc (δ p F) (D p F)
            (CategoryTheory.Abelian.Ext.mk₀ (zMap 0 φ))
            (Nat.one_add p) (Nat.add_zero p) (by omega),
            ih φ,
            ← CategoryTheory.Abelian.Ext.comp_assoc (δ p F)
              (CategoryTheory.Abelian.Ext.mk₀ (zMap p φ)) (D p G)
              (Nat.add_zero 1) (Nat.zero_add p) (by omega),
            hδ_nat p φ,
            CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ (zMap (p + 1) φ)) (δ p G) (D p G)
              (Nat.zero_add 1) (Nat.one_add p) (by omega)]
      have hδ_bij : ∀ (r k : ℕ), 1 ≤ k → ∀ F : 𝒞₀,
          Function.Bijective (fun y : CategoryTheory.Abelian.Ext.{u} one₀ (Z (r + 1) F) k =>
            y.comp (δ r F) rfl) := by
        intro r k hk F
        have : Subsingleton (CategoryTheory.Abelian.Ext.{u} one₀ ((𝒯 r).obj F) k) :=
          hAcyc r k hk F
        have : Subsingleton (CategoryTheory.Abelian.Ext.{u} one₀ ((𝒯 r).obj F) (k + 1)) :=
          hAcyc r (k + 1) (by omega) F
        refine ⟨?_, ?_⟩
        · intro y₁ y₂ hy
          dsimp at hy
          have hsub : (y₁ - y₂).comp (δ r F) rfl = 0 := by
            rw [ext_sub_comp, hy, sub_self]
          obtain ⟨x, hx⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
            one₀ (hS_p r F) (y₁ - y₂) rfl hsub
          have hx0 : x = 0 := Subsingleton.elim x 0
          rw [hx0, CategoryTheory.Abelian.Ext.zero_comp] at hx
          exact sub_eq_zero.mp hx.symm
        · intro w
          have hw0 : w.comp (CategoryTheory.Abelian.Ext.mk₀ (S_p r F).f) (Nat.add_zero (k + 1)) = 0 :=
            Subsingleton.elim _ _
          exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ one₀ (hS_p r F) w hw0 rfl
      have hD_bij : ∀ (r k m : ℕ), 1 ≤ k → ∀ (hm : k + r = m) (F : 𝒞₀),
          Function.Bijective (fun y : CategoryTheory.Abelian.Ext.{u} one₀ (Z r F) k =>
            y.comp (D r F) hm) := by
        intro r
        induction r with
        | zero =>
          intro k m _ hm F
          subst hm
          have hid : (fun y : CategoryTheory.Abelian.Ext.{u} one₀ (Z 0 F) k =>
              y.comp (D 0 F) (Nat.add_zero k)) = id := by
            ext y
            exact CategoryTheory.Abelian.Ext.comp_mk₀_id y
          rw [hid]
          exact Function.bijective_id
        | succ r ih =>
          intro k m hk hm F
          have hm' : (k + 1) + r = m := by omega
          have hcomp_fn : (fun y : CategoryTheory.Abelian.Ext.{u} one₀ (Z (r + 1) F) k =>
              y.comp (D (r + 1) F) hm) =
            (fun w : CategoryTheory.Abelian.Ext.{u} one₀ (Z r F) (k + 1) => w.comp (D r F) hm') ∘
              (fun y : CategoryTheory.Abelian.Ext.{u} one₀ (Z (r + 1) F) k => y.comp (δ r F) rfl) := by
            ext y
            exact (CategoryTheory.Abelian.Ext.comp_assoc y (δ r F) (D r F)
              rfl (Nat.one_add r) (by omega)).symm
          rw [hcomp_fn]
          exact (ih (k + 1) m (by omega) hm' F).comp (hδ_bij r k hk F)
      have hker_lift_cond : ∀ (F : 𝒞₀) (p : ℕ) (x : ↥(LinearMap.ker (((d_C p).app F).hom))),
          ((γ ((𝒯 p).obj F)).symm x.1) ≫ (diff p).app F = 0 := by
        intro F p x
        apply (γ ((𝒯 (p + 1)).obj F)).injective
        rw [map_zero, hγ_nat ((diff p).app F), (γ ((𝒯 p).obj F)).apply_symm_apply]
        exact x.2
      let β_Z : ∀ (F : 𝒞₀) (p : ℕ),
          ↥(LinearMap.ker (((d_C p).app F).hom)) → (one₀ ⟶ Z p F) :=
        fun F p x => CategoryTheory.Limits.kernel.lift ((diff p).app F)
          ((γ ((𝒯 p).obj F)).symm x.1) (hker_lift_cond F p x)
      have hβ_ι : ∀ (F : 𝒞₀) (p : ℕ) (x : ↥(LinearMap.ker (((d_C p).app F).hom))),
          β_Z F p x ≫ ι p F = (γ ((𝒯 p).obj F)).symm x.1 :=
        fun F p x => CategoryTheory.Limits.kernel.lift_ι _ _ _
      have hβ_add : ∀ (F : 𝒞₀) (p : ℕ) (x₁ x₂ : ↥(LinearMap.ker (((d_C p).app F).hom))),
          β_Z F p (x₁ + x₂) = β_Z F p x₁ + β_Z F p x₂ := by
        intro F p x₁ x₂
        have := hι_mono p F
        rw [← CategoryTheory.cancel_mono (ι p F), CategoryTheory.Preadditive.add_comp,
          hβ_ι, hβ_ι, hβ_ι]
        exact map_add (γ ((𝒯 p).obj F)).symm x₁.1 x₂.1
      have hβ_bij : ∀ (F : 𝒞₀) (p : ℕ), Function.Bijective (β_Z F p) := by
        intro F p
        refine ⟨?_, ?_⟩
        · intro x₁ x₂ h
          ext1
          apply (γ ((𝒯 p).obj F)).symm.injective
          rw [← hβ_ι F p x₁, ← hβ_ι F p x₂, h]
        · intro b
          have hb_mem : γ ((𝒯 p).obj F) (b ≫ ι p F) ∈ LinearMap.ker (((d_C p).app F).hom) := by
            change (((d_C p).app F).hom) (γ ((𝒯 p).obj F) (b ≫ ι p F)) = 0
            have h1 := hγ_nat ((diff p).app F) (b ≫ ι p F)
            rw [Category.assoc, CategoryTheory.Limits.kernel.condition,
              CategoryTheory.Limits.comp_zero, map_zero] at h1
            exact h1.symm
          refine ⟨⟨γ ((𝒯 p).obj F) (b ≫ ι p F), hb_mem⟩, ?_⟩
          have := hι_mono p F
          rw [← CategoryTheory.cancel_mono (ι p F), hβ_ι,
            (γ ((𝒯 p).obj F)).symm_apply_apply]
      let Υ : ∀ (F : 𝒞₀) (p : ℕ),
          ↥(LinearMap.ker (((d_C p).app F).hom)) →+
            CategoryTheory.Abelian.Ext.{u} one₀ F p :=
        fun F p => AddMonoidHom.mk'
          (fun x => (((CategoryTheory.Abelian.Ext.mk₀ (β_Z F p x)).comp (D p F) (Nat.zero_add p))).comp
            (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv (e₀ F))) (Nat.add_zero p))
          (fun x₁ x₂ => by
            rw [hβ_add, CategoryTheory.Abelian.Ext.mk₀_add,
              CategoryTheory.Abelian.Ext.add_comp, CategoryTheory.Abelian.Ext.add_comp])
      have he₀_inv_bij : ∀ (p : ℕ) (F : 𝒞₀),
          Function.Bijective (fun w : CategoryTheory.Abelian.Ext.{u} one₀ (Z 0 F) p =>
            w.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv (e₀ F))) (Nat.add_zero p)) := by
        intro p F
        refine Function.bijective_iff_has_inverse.mpr
          ⟨fun v => v.comp (CategoryTheory.Abelian.Ext.mk₀ (e₀ F)) (Nat.add_zero p), ?_, ?_⟩
        · intro w
          dsimp
          rw [CategoryTheory.Abelian.Ext.comp_assoc w _ _ (Nat.add_zero p) (Nat.add_zero 0) (by omega),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.inv_hom_id,
            CategoryTheory.Abelian.Ext.comp_mk₀_id]
        · intro v
          dsimp
          rw [CategoryTheory.Abelian.Ext.comp_assoc v _ _ (Nat.add_zero p) (Nat.add_zero 0) (by omega),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.hom_inv_id,
            CategoryTheory.Abelian.Ext.comp_mk₀_id]
      have hΥ0_bij : ∀ F : 𝒞₀, Function.Bijective (Υ F 0) := by
        intro F
        have hfn : (Υ F 0 : _ → _) =
            (fun w : CategoryTheory.Abelian.Ext.{u} one₀ (Z 0 F) 0 =>
              w.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv (e₀ F))) (Nat.add_zero 0)) ∘
            (⇑(CategoryTheory.Abelian.Ext.addEquiv₀ (X := one₀) (Y := Z 0 F)).symm) ∘
            (β_Z F 0) := by
          ext x
          change (((CategoryTheory.Abelian.Ext.mk₀ (β_Z F 0 x)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (Z 0 F)))
              (Nat.zero_add 0))).comp
            (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv (e₀ F))) (Nat.add_zero 0) = _
          rw [CategoryTheory.Abelian.Ext.comp_mk₀_id]
          rfl
        rw [hfn]
        exact (he₀_inv_bij 0 F).comp
          ((CategoryTheory.Abelian.Ext.addEquiv₀.symm.bijective).comp (hβ_bij F 0))
      refine ⟨Υ, ?_, fun F => (hΥ0_bij F).1, ?_, ?_⟩
      · intro p F
        cases p with
        | zero => exact (hΥ0_bij F).2
        | succ p =>
          intro z
          obtain ⟨w₀, rfl⟩ := (he₀_inv_bij (p + 1) F).2 z
          obtain ⟨y, rfl⟩ := (hD_bij p 1 (p + 1) (le_refl 1) (Nat.one_add p) F).2 w₀
          have : Subsingleton (CategoryTheory.Abelian.Ext.{u} one₀ ((𝒯 p).obj F) 1) :=
            hAcyc p 1 (le_refl 1) F
          have hy0 : y.comp (CategoryTheory.Abelian.Ext.mk₀ (S_p p F).f) (Nat.add_zero 1) = 0 :=
            Subsingleton.elim _ _
          obtain ⟨b₀, hb₀⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
            one₀ (hS_p p F) y hy0 (Nat.zero_add 1)
          let b_hom : one₀ ⟶ Z (p + 1) F := CategoryTheory.Abelian.Ext.addEquiv₀ b₀
          have hb_eq : CategoryTheory.Abelian.Ext.mk₀ b_hom = b₀ :=
            CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply b₀
          obtain ⟨x, hx⟩ := (hβ_bij F (p + 1)).2 b_hom
          refine ⟨x, ?_⟩
