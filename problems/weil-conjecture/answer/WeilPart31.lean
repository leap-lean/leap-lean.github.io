          (CategoryTheory.NatTrans.ext (funext fun opV => ModuleCat.hom_ext (LinearMap.ext fun x => by
            change (((P_pull_ab.map ((U_fun Y).map (u ≫ v))).hom.app opV).hom) x = _
            rw [(U_fun Y).map_comp, P_pull_ab.map_comp]
            rfl))) }
    let e_pull_U : (P_pull_mod ⋙ U_fun Z) ≅ (U_fun Y ⋙ P_pull_ab) :=
      CategoryTheory.NatIso.ofComponents
        (fun ℱ =>
          { hom := CategoryTheory.ObjectProperty.homMk
              { app := fun _ => 𝟙 _
                naturality := fun {_ _} g => by
