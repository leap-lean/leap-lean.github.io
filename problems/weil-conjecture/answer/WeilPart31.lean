          exact hLHS.trans (hs_V.symm.trans hRHS.symm)
        let c_in : Abelian.Ext (Z_fun.obj (B₀.obj U)) H 1 := c
        change (Abelian.Ext.mk₀ (Z_fun.map (B₀.map g))).comp c_in (Nat.zero_add 1) = 0
        calc
          (Abelian.Ext.mk₀ (Z_fun.map (B₀.map g))).comp c_in (Nat.zero_add 1)
              = (Abelian.Ext.mk₀ (Z_fun.map (B₀.map g))).comp
                  ((Abelian.Ext.mk₀ q_hom).comp hSE.extClass (Nat.zero_add 1)) (Nat.zero_add 1) := by
                rw [hx₃_mk, hx₃]
          _ = ((Abelian.Ext.mk₀ (Z_fun.map (B₀.map g))).comp
                (Abelian.Ext.mk₀ q_hom) (Nat.zero_add 0)).comp hSE.extClass (Nat.zero_add 1) :=
                (Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1)).symm
          _ = (Abelian.Ext.mk₀ (j_hom ≫ π)).comp hSE.extClass (Nat.zero_add 1) := by
                rw [Abelian.Ext.mk₀_comp_mk₀, hj_π]
          _ = (Abelian.Ext.mk₀ j_hom).comp
                ((Abelian.Ext.mk₀ SC.g).comp hSE.extClass (Nat.zero_add 1)) (Nat.zero_add 1) := by
                rw [← Abelian.Ext.mk₀_comp_mk₀]
                exact Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1)
          _ = 0 := by rw [hSE.comp_extClass, Abelian.Ext.comp_zero]
      | succ m ih =>
        intro H
        let J_inj : Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} := Injective.under H
        let ι : H ⟶ J_inj := Injective.ι H
        let Q : Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} := Limits.cokernel ι
        let π : J_inj ⟶ Q := Limits.cokernel.π ι
        let SC : ShortComplex (Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) :=
          ShortComplex.mk ι π (Limits.cokernel.condition ι)
        have hSE : SC.ShortExact :=
          ShortComplex.ShortExact.mk'
            (ShortComplex.exact_of_g_is_cokernel _ (Limits.cokernelIsCokernel ι))
            inferInstance inferInstance
        let δ_nat : Q.cohomologyPresheaf (m + 1) ⟶ H.cohomologyPresheaf (m + 2) :=
          { app := fun W => AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_fun.obj W.unop) rfl)
            naturality := fun W₁ W₂ f => by
              ext x₃
              let x₃' : Abelian.Ext (Z_fun.obj W₁.unop) SC.X₃ (m + 1) := x₃
              exact Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (Z_fun.map f.unop)) x₃' hSE.extClass
                (Nat.zero_add (m + 1)) rfl (Nat.zero_add (m + 2)) }
        have : ∀ W : Opposite Z.Etale, IsIso (δ_nat.app W) := by
          intro W
          rw [ConcreteCategory.isIso_iff_bijective]
          constructor
          · intro x₁ x₂ h_eq
            let x₁' : Abelian.Ext (Z_fun.obj W.unop) SC.X₃ (m + 1) := x₁
            let x₂' : Abelian.Ext (Z_fun.obj W.unop) SC.X₃ (m + 1) := x₂
            have hdiff : (x₁' - x₂').comp hSE.extClass rfl = 0 := by
              change (δ_nat.app W).hom (x₁ - x₂) = 0
              rw [map_sub, h_eq, sub_self]
            obtain ⟨x_J, hx_J⟩ :=
              Abelian.Ext.covariant_sequence_exact₃ (Z_fun.obj W.unop) hSE (x₁' - x₂') rfl hdiff
            have hSubJ : Subsingleton (Abelian.Ext (Z_fun.obj W.unop) J_inj (m + 1)) :=
              Abelian.Ext.subsingleton_of_injective (Z_fun.obj W.unop) J_inj m
            have hx_J0 : x_J = 0 := @Subsingleton.elim _ hSubJ _ _
            rw [hx_J0, Abelian.Ext.zero_comp] at hx_J
            exact sub_eq_zero.mp hx_J.symm
          · intro y
            let y' : Abelian.Ext (Z_fun.obj W.unop) SC.X₁ (m + 2) := y
            have hSubJ2 : Subsingleton (Abelian.Ext (Z_fun.obj W.unop) J_inj (m + 2)) :=
              Abelian.Ext.subsingleton_of_injective (Z_fun.obj W.unop) J_inj (m + 1)
            have hy_ι : y'.comp (Abelian.Ext.mk₀ SC.f) (Nat.add_zero (m + 2)) = 0 :=
              @Subsingleton.elim _ hSubJ2 _ _
            exact Abelian.Ext.covariant_sequence_exact₁ (Z_fun.obj W.unop) hSE y' hy_ι rfl
        have : IsIso δ_nat := NatIso.isIso_of_isIso_app δ_nat
        let e_coh : Q.cohomologyPresheaf (m + 1) ≅ H.cohomologyPresheaf (m + 2) := asIso δ_nat
        let e_hdi : weilEtaleHigherDirectImage f₀ (m + 1) Q ≅
            weilEtaleHigherDirectImage f₀ (m + 2) H :=
          (presheafToSheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}).mapIso
            (Functor.isoWhiskerLeft B₀.op e_coh)
        exact (ih Q).of_iso e_hdi.symm
    rw [← Nat.sub_add_cancel hp]
    exact hInd (p - 1) H₀

  refine hGeomIsZero X₀ (weilEtaleHigherDirectImage h s G) fun x => ?_
  let Ω := AlgebraicClosure ↥(X₀.residueField x)
  let S_x := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  let gx : S_x ⟶ X₀ :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(X₀.residueField x) Ω)) ≫
      X₀.fromSpecResidueField x
  let Y_x := Limits.pullback h gx
  let g'_x := Limits.pullback.fst h gx
  let f'_x := Limits.pullback.snd h gx
  obtain ⟨hc_g', hr_g'⟩ := hSite g'_x
  let _ : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g'_x :=
    MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) g'_x :=
    MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_g' : Y₀.Etale ⥤ Y_x.Etale := MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g'_x
  let _ := hc_g'; let _ := hr_g'
  let F'_x := (B_g'.sheafPullback AddCommGrpCat.{u}
    Y₀.smallEtaleTopology Y_x.smallEtaleTopology).obj G
  have hPull_g' : WeilIsEtaleSheafPullback g'_x G F'_x := ⟨hc_g', hr_g', ⟨Iso.refl F'_x⟩⟩
  have hPull_gx := hBaseChange x F'_x hPull_g'
  refine ⟨weilEtaleHigherDirectImage f'_x s F'_x, hPull_gx, ?_⟩
  have hgx_apply : ∀ pt : ↥S_x, gx.base pt = x := fun pt => by
    change (X₀.fromSpecResidueField x).base _ = x
    exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply x _
  by_cases hx : x ∈ V_X
  · have hRange_gx : Set.range gx.base ⊆ Set.range V_X.ι.base := by
      rintro _ ⟨pt, rfl⟩
      rw [hgx_apply pt, V_X.range_ι]
      exact hx
    let gx_V : S_x ⟶ V_X.toScheme := AlgebraicGeometry.IsOpenImmersion.lift V_X.ι gx hRange_gx
    have hgx_V : gx_V ≫ V_X.ι = gx := AlgebraicGeometry.IsOpenImmersion.lift_fac V_X.ι gx hRange_gx
    have hpb_res : IsPullback (h ⁻¹ᵁ V_X).ι (h ∣_ V_X) h V_X.ι :=
      (AlgebraicGeometry.isPullback_morphismRestrict h V_X).flip
    have h_outer_comm : g'_x ≫ h = (f'_x ≫ gx_V) ≫ V_X.ι := by
      rw [Category.assoc, hgx_V]
      exact Limits.pullback.condition
    let u_x : Y_x ⟶ (h ⁻¹ᵁ V_X).toScheme := hpb_res.lift g'_x (f'_x ≫ gx_V) h_outer_comm
    have hu_fst : u_x ≫ (h ⁻¹ᵁ V_X).ι = g'_x := hpb_res.lift_fst _ _ _
    have hu_snd : u_x ≫ (h ∣_ V_X) = f'_x ≫ gx_V := hpb_res.lift_snd _ _ _
    have hpb_fin : IsPullback u_x f'_x (h ∣_ V_X) gx_V := by
      refine IsPullback.of_right ?_ hu_snd hpb_res
      rw [hu_fst, hgx_V]
      exact IsPullback.of_hasPullback h gx
    have : AlgebraicGeometry.IsFinite f'_x :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_fin hFin_V
    exact hFinSpecHigherZero Ω f'_x F'_x s hs
  · have hZero_F' : Limits.IsZero F'_x := by
      refine hGeomIsZero Y_x F'_x fun y' => ?_
      let Ω' := AlgebraicClosure ↥(Y_x.residueField y')
      let gy' : AlgebraicGeometry.Spec (CommRingCat.of Ω') ⟶ Y_x :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(Y_x.residueField y') Ω')) ≫
          Y_x.fromSpecResidueField y'
      obtain ⟨hc_gy', hr_gy'⟩ := hSite gy'
      let _ : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) gy' :=
        MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) gy' :=
        MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_gy' : Y_x.Etale ⥤ (AlgebraicGeometry.Spec (CommRingCat.of Ω')).Etale :=
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ gy'
      let _ := hc_gy'; let _ := hr_gy'
      let K := (B_gy'.sheafPullback AddCommGrpCat.{u}
        Y_x.smallEtaleTopology
        (AlgebraicGeometry.Spec (CommRingCat.of Ω')).smallEtaleTopology).obj F'_x
      have hPull_gy' : WeilIsEtaleSheafPullback gy' F'_x K := ⟨hc_gy', hr_gy', ⟨Iso.refl K⟩⟩
      have hPull_comp : WeilIsEtaleSheafPullback (gy' ≫ g'_x) G K :=
        hPullComp gy' g'_x G F'_x K hPull_g' hPull_gy'
      have hOut : ∀ pt' : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω')),
          (gy' ≫ g'_x).base pt' ∉ (TopologicalSpace.Opens.map h.base).obj V_X := by
        intro pt' hmem
        change h.base ((gy' ≫ g'_x).base pt') ∈ V_X at hmem
        have heq_x : h.base ((gy' ≫ g'_x).base pt') = x := by
          change (gy' ≫ g'_x ≫ h).base pt' = x
          rw [Limits.pullback.condition]
          exact hgx_apply (f'_x.base (gy'.base pt'))
        rw [heq_x] at hmem
        exact hx hmem
      exact ⟨K, hPull_gy',
        hStalkSpecZero ((TopologicalSpace.Opens.map h.base).obj V_X) G hStalk Ω'
          (gy' ≫ g'_x) K hOut hPull_comp⟩
    have hid_F' : 𝟙 F'_x = 0 := (Limits.IsZero.iff_id_eq_zero F'_x).mp hZero_F'
    let _ : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f'_x :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f'_x :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_f' : S_x.Etale ⥤ Y_x.Etale := MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f'_x
    let Z_Yx : Y_x.Etale ⥤ Sheaf Y_x.smallEtaleTopology AddCommGrpCat.{u} :=
      yoneda ⋙ (Functor.whiskeringRight (Opposite Y_x.Etale) (Type u) AddCommGrpCat.{u}).obj
        AddCommGrpCat.free ⋙ presheafToSheaf Y_x.smallEtaleTopology AddCommGrpCat.{u}
    refine hSheafifyIsZero S_x (B_f'.op ⋙ F'_x.cohomologyPresheaf s) fun U c => ?_
    refine ⟨⊤, S_x.smallEtaleTopology.top_mem U, fun V g _ => ?_⟩
    let c' : Abelian.Ext (Z_Yx.obj (B_f'.obj V)) F'_x s :=
      ((B_f'.op ⋙ F'_x.cohomologyPresheaf s).map g.op).hom c
    change c' = 0
    have hc'_id : c'.comp (Abelian.Ext.mk₀ (𝟙 F'_x)) (Nat.add_zero s) = c' :=
      Abelian.Ext.comp_mk₀_id c'
    rw [← hc'_id, hid_F', Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

theorem weil_alt_proper_zero_bdry_leray_injective (k : Type u) [Field k] [IsAlgClosed k]
    (X Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper X.hom]
    [AlgebraicGeometry.IsProper Y.hom]
    (ψ : Y ⟶ X)
    (hψ_prop : AlgebraicGeometry.IsProper ψ.left)
    (U : X.left.Opens)
    (hU_fin : AlgebraicGeometry.IsFinite (ψ.left ∣_ U))
    (n q : ℕ) (hn : 1 ≤ n) (hUnit : IsUnit (n : k))
    (K_Y : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u})
    (ι_Y : Quiver.Hom K_Y (weilEtaleTorsionSheaf Y.left n))
    (hKY : WeilAltIsZeroBdryExact Y.left ((TopologicalSpace.Opens.map ψ.left.base).obj U) n K_Y ι_Y) :
    WeilAltZeroBdryLerayInjective ψ.left q K_Y :=
by
  let U_Y : Y.left.Opens := (TopologicalSpace.Opens.map ψ.left.base).obj U
  obtain ⟨hZBE, hCompDev, hLerayExt⟩ := weil_alt_leray_ext_and_zero_bdry_devissage.{u}
  obtain ⟨hTor_KY, hStalk_KY⟩ := hZBE Y.left U_Y n K_Y ι_Y hKY
  obtain ⟨hIsoP0, hVieta⟩ := weil_vieta_binary_form_cover_projSpace k
  have hLFT_Proj : ∀ (N : ℕ),
      AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
    intro N
    dsimp [weilProjectiveSpaceOver]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hSurj₀ : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro p
      have hp1 : p.1 ∈ (1 : Submodule k (MvPolynomial (Fin (N + 1)) k)) := by
        rw [← MvPolynomial.homogeneousSubmodule_zero]
        exact p.2
      obtain ⟨c, hc⟩ := Submodule.mem_one.mp hp1
      exact ⟨c, Subtype.ext hc⟩
    have hFT₀ : (algebraMap k ↥(𝒜 0)).FiniteType :=
      RingHom.FiniteType.of_surjective _ hSurj₀
    have hSpec₀ : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hFT₀
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      @IsScalarTower.of_algebraMap_eq k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) _ _ _ _ _ _
        (fun _ => rfl)
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hProj₀ : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      inferInstance
    exact inferInstance
  have hPrimeVanish : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : k) ≠ 0 →
      ∀ (G : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id G = 0 →
        WeilAltLerayStalkZeroOutside U_Y G →
        ∀ (s : ℕ), 1 ≤ s →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage ψ.left s G) := by
    intro ℓ _ hℓ G hG_tor hG_stalk s hs
    obtain ⟨hExtract, hComp, hCancel, hAffineLoc, hArrowIso⟩ :=
      weil_pbc_canonical_calculus_and_extraction.{u} ℓ
    have hProjSpace : ∀ (N : ℕ)
        (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.LocallyOfFiniteType B.hom],
        WeilCanonicalModPrimePBC ℓ
          (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k N).hom) := by
      intro N
      induction N with
      | zero =>
        intro B _
        have : CategoryTheory.IsIso (weilProjectiveSpaceOver k 0).hom := hIsoP0
        let p₀ := CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 0).hom
        have : CategoryTheory.IsIso p₀ := inferInstance
        have : AlgebraicGeometry.IsFinite p₀ := inferInstance
        exact weil_pbc_finite_morphism ℓ p₀
      | succ m ih =>
        intro B _
        let P_m := weilProjectiveSpaceOver k m
        let P_1 := weilProjectiveSpaceOver k 1
        let P_succ := weilProjectiveSpaceOver k (m + 1)
        let p_mB := CategoryTheory.Limits.pullback.fst B.hom P_m.hom
        have : AlgebraicGeometry.LocallyOfFiniteType P_m.hom := hLFT_Proj m
        have : AlgebraicGeometry.LocallyOfFiniteType p_mB := inferInstance
        let B_m : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
          CategoryTheory.Over.mk (p_mB ≫ B.hom)
        have : AlgebraicGeometry.LocallyOfFiniteType B_m.hom := by
          dsimp [B_m]
          infer_instance
        let p_1Bm := CategoryTheory.Limits.pullback.fst B_m.hom P_1.hom
        have hPBC_1Bm : WeilCanonicalModPrimePBC ℓ p_1Bm := by
          apply hAffineLoc
          intro W hW
          let B_W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
            CategoryTheory.Over.mk (W.ι ≫ B_m.hom)
          have : AlgebraicGeometry.IsAffine B_W.left := hW
          have : AlgebraicGeometry.LocallyOfFiniteType B_W.hom := by
            dsimp [B_W]
            infer_instance
          have hBW : WeilCanonicalModPrimePBC ℓ
              (CategoryTheory.Limits.pullback.fst B_W.hom P_1.hom) :=
            weil_pbc_projLine_over_affine_finiteType k ℓ hℓ B_W
          have hpb_res : CategoryTheory.IsPullback
              (p_1Bm ∣_ W)
              ((p_1Bm ⁻¹ᵁ W).ι ≫ CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom)
              B_W.hom P_1.hom :=
            (AlgebraicGeometry.isPullback_morphismRestrict p_1Bm W).paste_vert
              (CategoryTheory.IsPullback.of_hasPullback B_m.hom P_1.hom)
          refine hArrowIso (p_1Bm ∣_ W)
            (CategoryTheory.Limits.pullback.fst B_W.hom P_1.hom)
            hpb_res.isoPullback (CategoryTheory.Iso.refl _) ?_ hBW
          rw [hpb_res.isoPullback_hom_fst, CategoryTheory.Iso.refl_hom,
            CategoryTheory.Category.comp_id]
        have hPBC_mB : WeilCanonicalModPrimePBC ℓ p_mB := ih B
        have hPBC_tower : WeilCanonicalModPrimePBC ℓ (p_1Bm ≫ p_mB) :=
          hComp p_1Bm p_mB hPBC_1Bm hPBC_mB
        obtain ⟨μ, hFin_μ, hSurj_μ, hw_μ⟩ := hVieta m
        let P_m1_hom := CategoryTheory.Limits.pullback.fst P_m.hom P_1.hom ≫ P_m.hom
        let μ_B : CategoryTheory.Limits.pullback B.hom P_m1_hom ⟶
            CategoryTheory.Limits.pullback B.hom P_succ.hom :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst B.hom P_m1_hom)
            (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom ≫ μ)
            (by rw [CategoryTheory.Category.assoc, hw_μ, CategoryTheory.Limits.pullback.condition])
        have hμ_fst : μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom =
            CategoryTheory.Limits.pullback.fst B.hom P_m1_hom :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hμ_snd : μ_B ≫ CategoryTheory.Limits.pullback.snd B.hom P_succ.hom =
            CategoryTheory.Limits.pullback.snd B.hom P_m1_hom ≫ μ :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hpb_μB : CategoryTheory.IsPullback
            μ_B
            (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom)
            (CategoryTheory.Limits.pullback.snd B.hom P_succ.hom)
            μ := by
          refine CategoryTheory.IsPullback.of_right ?_ hμ_snd
            (CategoryTheory.IsPullback.of_hasPullback B.hom P_succ.hom)
          rw [hμ_fst]
          have h_outer : CategoryTheory.IsPullback
              (CategoryTheory.Limits.pullback.fst B.hom P_m1_hom)
              (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom)
              B.hom (μ ≫ P_succ.hom) := by
            rw [hw_μ]
            exact CategoryTheory.IsPullback.of_hasPullback B.hom P_m1_hom
          exact h_outer
        have : AlgebraicGeometry.IsFinite μ_B :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_μB.flip hFin_μ
        have hSurj_μB : AlgebraicGeometry.Surjective μ_B :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_μB.flip hSurj_μ
        have hPBC_μB : WeilCanonicalModPrimePBC ℓ μ_B :=
          weil_pbc_finite_morphism ℓ μ_B
        let α : CategoryTheory.Limits.pullback B_m.hom P_1.hom ⟶
            CategoryTheory.Limits.pullback P_m.hom P_1.hom :=
          CategoryTheory.Limits.pullback.lift
            (p_1Bm ≫ CategoryTheory.Limits.pullback.snd B.hom P_m.hom)
            (CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom)
            (by
              rw [CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition]
              exact CategoryTheory.Limits.pullback.condition)
        have hpb_left : CategoryTheory.IsPullback
            p_1Bm α
            (CategoryTheory.Limits.pullback.snd B.hom P_m.hom)
            (CategoryTheory.Limits.pullback.fst P_m.hom P_1.hom) := by
          refine CategoryTheory.IsPullback.of_bot ?_
            (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
            (CategoryTheory.IsPullback.of_hasPullback P_m.hom P_1.hom)
          rw [CategoryTheory.Limits.pullback.lift_snd]
          have h_eq : CategoryTheory.Limits.pullback.snd B.hom P_m.hom ≫ P_m.hom = B_m.hom :=
            (CategoryTheory.Limits.pullback.condition (f := B.hom) (g := P_m.hom)).symm
          rw [h_eq]
          exact CategoryTheory.IsPullback.of_hasPullback B_m.hom P_1.hom
        have hpb_assoc : CategoryTheory.IsPullback
            (p_1Bm ≫ p_mB) α B.hom P_m1_hom :=
          hpb_left.paste_horiz (CategoryTheory.IsPullback.of_hasPullback B.hom P_m.hom)
        have hPBC_comp_μB : WeilCanonicalModPrimePBC ℓ
            (μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom) := by
          refine hArrowIso
            (μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom)
            (p_1Bm ≫ p_mB)
            hpb_assoc.isoPullback.symm (CategoryTheory.Iso.refl B.left) ?_ hPBC_tower
          rw [CategoryTheory.Iso.symm_hom, hpb_assoc.isoPullback_inv_fst, hμ_fst,
            CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id]
        exact hCancel μ_B (CategoryTheory.Limits.pullback.fst B.hom P_succ.hom)
          hSurj_μB hPBC_μB hPBC_comp_μB
    have hPBC_ψ : WeilCanonicalModPrimePBC ℓ ψ.left := by
      apply hAffineLoc
      intro W hW
      let X_W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (W.ι ≫ X.hom)
      let Y_W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk ((ψ.left ⁻¹ᵁ W).ι ≫ Y.hom)
      let ψ_W : Y_W ⟶ X_W :=
        CategoryTheory.Over.homMk (ψ.left ∣_ W) (by
          dsimp [Y_W, X_W]
          rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
            CategoryTheory.Category.assoc, CategoryTheory.Over.w ψ])
      have : AlgebraicGeometry.IsAffine X_W.left := hW
      have : AlgebraicGeometry.LocallyOfFiniteType X_W.hom := by
        dsimp [X_W]
        infer_instance
      have : AlgebraicGeometry.IsProper ψ_W.left := by
        dsimp [ψ_W]
        exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (AlgebraicGeometry.isPullback_morphismRestrict ψ.left W).flip hψ_prop
      obtain ⟨N, Y_tilde, ι_Y', ι_X', hFin_Y, hFin_X, hSurj_π, hComm⟩ :=
        weil_relative_chow_projective_factorization k Y_W X_W ψ_W
      have : AlgebraicGeometry.IsFinite ι_Y' := hFin_Y
      have : AlgebraicGeometry.IsFinite ι_X' := hFin_X
      let p_NY := CategoryTheory.Limits.pullback.fst Y_W.hom (weilProjectiveSpaceOver k N).hom
      let p_NX := CategoryTheory.Limits.pullback.fst X_W.hom (weilProjectiveSpaceOver k N).hom
      have : AlgebraicGeometry.LocallyOfFiniteType ψ_W.left := inferInstance
      have : AlgebraicGeometry.LocallyOfFiniteType Y_W.hom := by
        have hw : ψ_W.left ≫ X_W.hom = Y_W.hom := CategoryTheory.Over.w ψ_W
        rw [← hw]
        infer_instance
      let π := ι_Y' ≫ p_NY
      have hPBC_π : WeilCanonicalModPrimePBC ℓ π :=
        hComp ι_Y' p_NY (weil_pbc_finite_morphism ℓ ι_Y') (hProjSpace N Y_W)
      have hPBC_ιX : WeilCanonicalModPrimePBC ℓ (ι_X' ≫ p_NX) :=
        hComp ι_X' p_NX (weil_pbc_finite_morphism ℓ ι_X') (hProjSpace N X_W)
      have hPBC_πψ : WeilCanonicalModPrimePBC ℓ (π ≫ ψ_W.left) := by
        dsimp [π]
        rwa [hComm]
      exact hCancel π ψ_W.left hSurj_π hPBC_π hPBC_πψ
    refine weil_alt_leray_geom_fiber_vanishing_of_pbc_pullback ψ.left U hU_fin G s hs hG_stalk ?_
    intro x Ω gx F' hF'
    exact hExtract ψ.left gx (CategoryTheory.Limits.pullback.snd ψ.left gx)
      (CategoryTheory.Limits.pullback.fst ψ.left gx) hPBC_ψ
      (CategoryTheory.IsPullback.of_hasPullback ψ.left gx) G F' hG_tor hF' s
  have hModVanish : ∀ (m : ℕ), 1 ≤ m → IsUnit (m : k) →
      ∀ (F : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}),
        m • CategoryTheory.CategoryStruct.id F = 0 →
        WeilAltLerayStalkZeroOutside U_Y F →
        ∀ (s : ℕ), 1 ≤ s →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage ψ.left s F) := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
      intro hm1 hmUnit F hF_tor hF_stalk s hs
      by_cases hm_eq : m = 1
      · subst hm_eq
        have hid0 : CategoryTheory.CategoryStruct.id F = 0 := by simpa using hF_tor
        let ℓ₀ : ℕ := if ringChar k = 2 then 3 else 2
        have hPrime₀ : Nat.Prime ℓ₀ := by
          dsimp [ℓ₀]
          split_ifs
          · exact Nat.prime_three
          · exact Nat.prime_two
        have : Fact (Nat.Prime ℓ₀) := ⟨hPrime₀⟩
        have hℓ₀_ne_char : ℓ₀ ≠ ringChar k := by
          dsimp [ℓ₀]
          split_ifs with hc
          · omega
          · exact Ne.symm hc
        have hℓ₀_ne : (ℓ₀ : k) ≠ 0 := by
          intro hz
          have hdvd : ringChar k ∣ ℓ₀ := (CharP.cast_eq_zero_iff k (ringChar k) ℓ₀).mp hz
          rcases CharP.char_is_prime_or_zero k (ringChar k) with hp | hcz
          · rcases (Nat.dvd_prime hPrime₀).mp hdvd with h1 | heq
            · exact hp.ne_one h1
            · exact hℓ₀_ne_char heq.symm
          · rw [hcz, zero_dvd_iff] at hdvd
            exact hPrime₀.ne_zero hdvd
        have hF_tor₀ : ℓ₀ • CategoryTheory.CategoryStruct.id F = 0 := by
          rw [hid0, smul_zero]
        exact hPrimeVanish ℓ₀ hℓ₀_ne F hF_tor₀ hF_stalk s hs
      · have hm2 : 2 ≤ m := by omega
        let ℓ := m.minFac
        let m' := m / ℓ
        have hPrime : Nat.Prime ℓ := Nat.minFac_prime (by omega)
        have : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
        have hdvd : ℓ ∣ m := Nat.minFac_dvd m
        have hmul : ℓ * m' = m := Nat.mul_div_cancel' hdvd
        have hm'_pos : 1 ≤ m' := Nat.div_pos (Nat.le_of_dvd (by omega) hdvd) hPrime.pos
        have hm'_lt : m' < m := Nat.div_lt_self (by omega) hPrime.one_lt
        have hUnit_mul : IsUnit ((ℓ : k) * (m' : k)) := by
          rw [← Nat.cast_mul, hmul]
          exact hmUnit
        have hℓ_ne : (ℓ : k) ≠ 0 := (isUnit_of_mul_isUnit_left hUnit_mul).ne_zero
        have hm'_unit : IsUnit (m' : k) := isUnit_of_mul_isUnit_right hUnit_mul
        have hF_mul : (ℓ * m') • CategoryTheory.CategoryStruct.id F = 0 := by
          rwa [hmul]
        exact hCompDev ψ.left U_Y ℓ m' F hF_mul hF_stalk
          (fun G₁ hG₁_tor hG₁_stalk s₁ hs₁ =>
            hPrimeVanish ℓ hℓ_ne G₁ hG₁_tor hG₁_stalk s₁ hs₁)
          (fun G₂ hG₂_tor hG₂_stalk s₂ hs₂ =>
            ih m' hm'_lt hm'_pos hm'_unit G₂ hG₂_tor hG₂_stalk s₂ hs₂)
          s hs
  exact hLerayExt ψ.left q K_Y (hModVanish n hn hUnit K_Y hTor_KY hStalk_KY)

theorem weil_etale_top_degree_alteration_rank_annihilation (k : Type u) [Field k] [IsAlgClosed k]
    (d : ℕ)
    (X Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [IrreducibleSpace X.left]
    [AlgebraicGeometry.IsProper X.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    [IrreducibleSpace Y.left]
    [AlgebraicGeometry.IsProper Y.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d Y.hom]
    (ψ : Y ⟶ X)
    (hψ_prop : AlgebraicGeometry.IsProper ψ.left)
    (hψ_surj : AlgebraicGeometry.Surjective ψ.left)
    (U : X.left.Opens)
    (hU_ne : Nonempty U)
    (hU_fin : AlgebraicGeometry.IsFinite (ψ.left ∣_ U))
    (hU_et : AlgebraicGeometry.Etale (ψ.left ∣_ U))
    (hU_surj : AlgebraicGeometry.Surjective (ψ.left ∣_ U)) :
    ∃ δ : ℕ, 1 ≤ δ ∧
      ∀ (n : ℕ), 1 ≤ n → IsUnit (n : k) →
        ∀ (p_top : weilEtaleTorsionH X.left n (2 * d) →+ weilEtaleTorsionH Y.left n (2 * d)),
          WeilIsTorsionEtalePullback ψ.left n (2 * d) p_top →
          ∀ w : weilEtaleTorsionH X.left n (2 * d), p_top w = 0 → δ • w = 0 :=
by
  
  have hBdry : ∀ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [IrreducibleSpace W.left]
      [AlgebraicGeometry.IsProper W.hom]
      [AlgebraicGeometry.SmoothOfRelativeDimension d W.hom]
      (V : W.left.Opens), Nonempty V →
      let I_Z := weilAltClosedComplIdeal W.left V
      (d = 0 → IsEmpty ↥I_Z.subscheme) ∧
      (∀ m : ℕ, m + 1 = d →
        AlgebraicGeometry.IsProper (CategoryTheory.CategoryStruct.comp I_Z.subschemeι W.hom) ∧
        topologicalKrullDim ↥I_Z.subscheme ≤ (m : WithBot ℕ∞)) := by
    intro W _ _ _ V hV_ne I_Z
    have hRedStalk : ∀ x : ↥W.left, _root_.IsReduced ↑(W.left.presheaf.stalk x) := by
      intro x
      obtain ⟨U₀, _hU₀, V₀, hV₀, hx, e, hf⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff d W.hom).mp inferInstance x
      have hU₀_top : U₀ = ⊤ := by
        ext p
        exact ⟨fun _ => trivial, fun _ => Subsingleton.elim (W.hom.base x) p ▸ e hx⟩
      let e_U₀ : k ≃+* ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of k), U₀) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.trans
          ((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.mapIso
            (CategoryTheory.eqToIso (congrArg Opposite.op hU₀_top.symm)))).commRingCatIsoToRingEquiv
      obtain ⟨g_U₀, _, hg_U₀⟩ := hf.exists_etale_mvPolynomial
      let P : Type u := MvPolynomial (Fin d) k
      let A : Type u := ↑Γ(W.left, V₀)
      let g_et : P →+* A := g_U₀.comp (MvPolynomial.mapEquiv (Fin d) e_U₀).toRingHom
      have hg_et : g_et.Etale := RingHom.Etale.respectsIso.right g_U₀ _ hg_U₀
      let _ : Algebra P A := g_et.toAlgebra
      have : Algebra.Etale P A := RingHom.etale_algebraMap.mp hg_et
      have : _root_.IsReduced (TensorProduct P (FractionRing P) A) :=
        Algebra.FormallyUnramified.isReduced_of_field (FractionRing P) _
      have hInjPK : Function.Injective (Algebra.linearMap P (FractionRing P)) :=
        fun _ _ h => IsFractionRing.injective P (FractionRing P) h
      have hInjRT : Function.Injective (LinearMap.rTensor A (Algebra.linearMap P (FractionRing P))) :=
        Module.Flat.rTensor_preserves_injective_linearMap _ hInjPK
      have hInj : Function.Injective
          (Algebra.TensorProduct.includeRight : A →ₐ[P] TensorProduct P (FractionRing P) A) := by
        intro s₁ s₂ hs
        apply (TensorProduct.lid P A).symm.injective
        apply hInjRT
        have hEq : ∀ s : A,
            LinearMap.rTensor A (Algebra.linearMap P (FractionRing P))
              ((TensorProduct.lid P A).symm s) =
              (Algebra.TensorProduct.includeRight : A →ₐ[P] TensorProduct P (FractionRing P) A) s := by
          intro s
          rw [TensorProduct.lid_symm_apply, LinearMap.rTensor_tmul, Algebra.linearMap_apply,
            map_one, Algebra.TensorProduct.includeRight_apply]
        rw [hEq, hEq, hs]
      have hRedA : _root_.IsReduced A := isReduced_of_injective _ hInj
      let xV : ↥V₀ := ⟨x, hx⟩
      exact @isReduced_localizationPreserves A _
        (hV₀.primeIdealOf xV).asIdeal.primeCompl
        ↑(W.left.presheaf.stalk ↑xV) _
        (TopCat.Presheaf.algebra_section_stalk W.left.presheaf xV)
        (hV₀.isLocalization_stalk xV) hRedA
    have hRedW : AlgebraicGeometry.IsReduced W.left :=
      AlgebraicGeometry.isReduced_of_isReduced_stalk W.left
    have hIntW : AlgebraicGeometry.IsIntegral W.left :=
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced W.left
    have hDimW : topologicalKrullDim W.left = (d : WithBot ℕ∞) :=
      weil_smooth_integral_krullDim_over_field k d W hIntW
    have hClEmb : Topology.IsClosedEmbedding I_Z.subschemeι.base :=
      AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding I_Z.subschemeι
    have hRange : Set.range I_Z.subschemeι.base = (V : Set ↥W.left)ᶜ :=
      (AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι I_Z).trans
        (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal _)
    obtain ⟨v₀, hv₀⟩ := hV_ne
    let T_univ : TopologicalSpace.IrreducibleCloseds ↥W.left :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥W.left, isClosed_univ⟩
    let pushIC : TopologicalSpace.IrreducibleCloseds ↥I_Z.subscheme →
        TopologicalSpace.IrreducibleCloseds ↥W.left :=
      fun C =>
        { carrier := I_Z.subschemeι.base '' (C : Set ↥I_Z.subscheme)
          isIrreducible' := C.isIrreducible.image _ I_Z.subschemeι.base.hom.continuous.continuousOn
          isClosed' := hClEmb.isClosedMap _ C.isClosed }
    have hStrictPush : StrictMono pushIC := by
      intro C₁ C₂ hlt
      have hle : pushIC C₁ ≤ pushIC C₂ := Set.image_mono (le_of_lt hlt)
      refine lt_of_le_not_ge hle (fun hge => not_le_of_gt hlt ?_)
      intro z hz
      rcases hge ⟨z, hz, rfl⟩ with ⟨z', hz', heq⟩
      rwa [← hClEmb.injective heq]
    have hLtTop : ∀ C : TopologicalSpace.IrreducibleCloseds ↥I_Z.subscheme, pushIC C < T_univ := by
      intro C
      refine lt_of_le_not_ge (fun _ _ => trivial) (fun hge => ?_)
      have hv_mem : v₀ ∈ (pushIC C : Set ↥W.left) := hge trivial
      rcases hv_mem with ⟨z, _, rfl⟩
      have hz_compl : I_Z.subschemeι.base z ∈ (V : Set ↥W.left)ᶜ := by
        rw [← hRange]
        exact ⟨z, rfl⟩
      exact hz_compl hv₀
    refine ⟨?_, ?_⟩
    · intro hd0
      refine ⟨fun z => ?_⟩
      let C₀ : TopologicalSpace.IrreducibleCloseds ↥I_Z.subscheme :=
        ⟨closure {z}, isIrreducible_singleton.closure, isClosed_closure⟩
      let l₁ : LTSeries (TopologicalSpace.IrreducibleCloseds ↥W.left) :=
        (RelSeries.singleton _ (pushIC C₀)).snoc T_univ (by simpa using hLtTop C₀)
      have hle := (Order.LTSeries.length_le_krullDim l₁).trans_eq hDimW
      rw [hd0] at hle
      have hlen : l₁.length = 1 := rfl
      rw [hlen] at hle
      exact absurd (WithBot.coe_le_coe.mp hle) (by decide)
    · intro m hm
      have hPropComp : AlgebraicGeometry.IsProper
          (CategoryTheory.CategoryStruct.comp I_Z.subschemeι W.hom) := inferInstance
      refine ⟨hPropComp, ?_⟩
      by_cases hEmptyIC : IsEmpty (TopologicalSpace.IrreducibleCloseds ↥I_Z.subscheme)
      · change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥I_Z.subscheme) ≤ _
        rw [Order.krullDim_eq_bot]
        exact bot_le
      · have : Nonempty (TopologicalSpace.IrreducibleCloseds ↥I_Z.subscheme) :=
          not_isEmpty_iff.mp hEmptyIC
        change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥I_Z.subscheme) ≤
          ((m : ℕ∞) : WithBot ℕ∞)
        rw [Order.krullDim_eq_iSup_length]
        refine WithBot.coe_le_coe.mpr (iSup_le fun l => ?_)
        let l_map : LTSeries (TopologicalSpace.IrreducibleCloseds ↥W.left) :=
          RelSeries.map l ⟨pushIC, fun h => hStrictPush h⟩
        let l_ext : LTSeries (TopologicalSpace.IrreducibleCloseds ↥W.left) :=
          l_map.snoc T_univ (hLtTop _)
        have hle := (Order.LTSeries.length_le_krullDim l_ext).trans_eq hDimW
        rw [← hm] at hle
        have hlen : l_ext.length = l.length + 1 :=
          (RelSeries.snoc_length l_map T_univ (hLtTop _)).trans
            (congrArg (· + 1) (RelSeries.map_length l _))
        rw [hlen] at hle
        have hle_enat : ((l.length + 1 : ℕ) : ℕ∞) ≤ ((m + 1 : ℕ) : ℕ∞) :=
          WithBot.coe_le_coe.mp hle
        have hle_nat : l.length + 1 ≤ m + 1 := Nat.cast_le.mp hle_enat
        exact Nat.cast_le.mpr (Nat.le_of_succ_le_succ hle_nat)

  
  have hOpenEmbU : Topology.IsOpenEmbedding U.ι.base :=
    AlgebraicGeometry.Scheme.Hom.isOpenEmbedding U.ι
  have hPreU : PreirreducibleSpace ↥(U : AlgebraicGeometry.Scheme.{u}) :=
    hOpenEmbU.preirreducibleSpace
  have hNeUSch : Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}) := hU_ne
  have : IrreducibleSpace ↥(U : AlgebraicGeometry.Scheme.{u}) :=
    { toPreirreducibleSpace := hPreU, toNonempty := hNeUSch }
  have : ConnectedSpace ↥(U : AlgebraicGeometry.Scheme.{u}) := inferInstance
  have : AlgebraicGeometry.IsFinite (ψ.left ∣_ U) := hU_fin
  have : AlgebraicGeometry.Etale (ψ.left ∣_ U) := hU_et
  have : AlgebraicGeometry.Surjective (ψ.left ∣_ U) := hU_surj
  obtain ⟨δ, hδ_pos, hSplit⟩ := weil_alt_finite_etale_sheet_split_of_connected (ψ.left ∣_ U)

  
  let U_Y : Y.left.Opens := (TopologicalSpace.Opens.map ψ.left.base).obj U
  have hUY_ne : Nonempty U_Y := by
    obtain ⟨u₀, hu₀⟩ := hU_ne
    obtain ⟨y₀, hy₀⟩ := hψ_surj.surj u₀
    exact ⟨⟨y₀, show ψ.left.base y₀ ∈ U by rw [hy₀]; exact hu₀⟩⟩
  obtain ⟨hZX_zero, hZX_pos⟩ := hBdry X U hU_ne
  obtain ⟨hZY_zero, hZY_pos⟩ := hBdry Y U_Y hUY_ne

  
  refine ⟨δ, hδ_pos, fun n hn hUnit p_top hp_top w hw => ?_⟩
  let I_ZX := weilAltClosedComplIdeal X.left U
  let I_ZY := weilAltClosedComplIdeal Y.left U_Y
  have hExc :
      (IsEmpty ↥I_ZX.subscheme ∨ Subsingleton (weilEtaleTorsionH I_ZX.subscheme n (2 * d))) ∧
      (IsEmpty ↥I_ZY.subscheme ∨
        ∃ q₀ : ℕ, q₀ + 1 = 2 * d ∧ Subsingleton (weilEtaleTorsionH I_ZY.subscheme n q₀)) := by
    rcases Nat.eq_zero_or_pos d with hd0 | hd_pos
    · exact ⟨Or.inl (hZX_zero hd0), Or.inl (hZY_zero hd0)⟩
    · set m := d - 1
      have hm : m + 1 = d := Nat.sub_add_cancel hd_pos
      obtain ⟨hPropZX, hDimZX⟩ := hZX_pos m hm
      obtain ⟨hPropZY, hDimZY⟩ := hZY_pos m hm
      let Z_X_over : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (CategoryTheory.CategoryStruct.comp I_ZX.subschemeι X.hom)
      let Z_Y_over : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (CategoryTheory.CategoryStruct.comp I_ZY.subschemeι Y.hom)
      have : AlgebraicGeometry.IsProper Z_X_over.hom := hPropZX
      have : AlgebraicGeometry.IsProper Z_Y_over.hom := hPropZY
      have hSubZX : Subsingleton (weilEtaleTorsionH I_ZX.subscheme n (2 * d)) :=
        weil_alt_proper_etale_cohomological_dimension k m n (2 * d) hn hUnit Z_X_over hDimZX
          (by omega)
      have hSubZY : Subsingleton (weilEtaleTorsionH I_ZY.subscheme n (2 * m + 1)) :=
        weil_alt_proper_etale_cohomological_dimension k m n (2 * m + 1) hn hUnit Z_Y_over hDimZY
          (by omega)
      exact ⟨Or.inr hSubZX, Or.inr ⟨2 * m + 1, by omega, hSubZY⟩⟩
  obtain ⟨hZeroEx, hTraceAnn⟩ := weil_alt_zero_bdry_excision_and_sheet_trace.{u}
  obtain ⟨K_X, ι_X, hKX⟩ := hZeroEx X.left U n
  obtain ⟨K_Y, ι_Y, hKY⟩ := hZeroEx Y.left U_Y n
  have hLeray : WeilAltZeroBdryLerayInjective ψ.left (2 * d) K_Y :=
    weil_alt_proper_zero_bdry_leray_injective k X Y ψ hψ_prop U hU_fin n (2 * d) hn hUnit
      K_Y ι_Y hKY
  have : AlgebraicGeometry.IsProper ψ.left := hψ_prop
  exact hTraceAnn ψ.left U δ n (2 * d) K_X ι_X K_Y ι_Y p_top hSplit hKX hKY hLeray
    hExc.1 hExc.2 hp_top w hw

theorem weil_cupPD_truncated_godement_complex (k : Type u) [Field k] [IsAlgClosed k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper X.hom]
    (d n : ℕ) (hn : 1 ≤ n) (hUnit : IsUnit (n : k))
    (hDim : topologicalKrullDim X.left ≤ (d : WithBot ℕ∞)) :
    WeilCupPDHasTruncatedGodement X.left d n :=
by
  classical
  have hColimProper : ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
      (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
      [AlgebraicGeometry.IsProper B.hom] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ),
      (∀ (ℬ : CategoryTheory.Sheaf B.left.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsConstructibleModPrimeSheaf ℓ B.left ℬ → Subsingleton (ℬ.H r)) →
      ∀ (𝒜 : CategoryTheory.Sheaf B.left.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id 𝒜 = 0 → Subsingleton (𝒜.H r) := by
    intro k₀ _ _ B _ ℓ hP r
    exact (weil_etale_noetherian_ind_godement_and_colimit_reduction k₀ B).1 ℓ r
      (weil_etale_ordinary_godement_resolution B.left ℓ hP.out.one_le)
  have hCurveVanish : ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
      (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom],
      AlgebraicGeometry.IsIntegral C.left →
      IsProjectiveOverField k₀ C →
      ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : k₀) ≠ 0 →
      ∀ (q : ℕ), 3 ≤ q → Subsingleton (weilEtaleTorsionH C.left ℓ q) := by
    intro k₀ _ _ C _ hIntC hProjC ℓ _ hℓ₀ q hq
    exact (weil_etale_smooth_proj_curve_mod_prime_cohomology k₀ C hIntC hProjC ℓ hℓ₀).2.1 q hq
  have hOrd_n : WeilHasOrdinaryGodementResolution X.left n :=
    weil_etale_ordinary_godement_resolution X.left n hn
  change WeilHasTruncatedGodementComplex X.left d n
  apply (weil_etale_noetherian_ind_godement_and_colimit_reduction k X).2 d n hn hOrd_n
  intro q hq F
  obtain ⟨_, _, _, _, _, _, _, _, hExtEquiv⟩ := hOrd_n
  obtain ⟨e_q⟩ := hExtEquiv q F
  let R := ULift.{u, 0} (ZMod n)
  let J := X.left.smallEtaleTopology
  let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let U_n := CategoryTheory.Sheaf.composeAndSheafify J FgtMod
  have hPrimeVanish : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], ℓ ∣ n →
      ∀ (𝒜 : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id 𝒜 = 0 → Subsingleton (𝒜.H q) := by
    intro ℓ _ hdvd 𝒜 h𝒜
    have hℓ_ne : (ℓ : k) ≠ 0 := by
      intro h0
      obtain ⟨c, hnc⟩ := hdvd
      have hn0 : (n : k) = 0 := by
        rw [hnc, Nat.cast_mul, h0, zero_mul]
      exact hUnit.ne_zero hn0
    exact hColimProper k X ℓ q
      (fun ℬ hℬ => weil_etale_proper_constructible_cohomological_dim_le_two_mul
        weil_etale_proper_base_change_mod_prime hCurveVanish hColimProper
        k X d ℓ hℓ_ne hDim ℬ hℬ q hq)
      𝒜 h𝒜
  have hDivVanish : ∀ (m₀ : ℕ), 1 ≤ m₀ → m₀ ∣ n →
      ∀ (ℬ : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        m₀ • CategoryTheory.CategoryStruct.id ℬ = 0 → Subsingleton (ℬ.H q) := by
    intro m₀
    induction m₀ using Nat.strongRecOn with
    | ind m₀ ih =>
      intro hm₁ hmn ℬ hmℬ
      let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      by_cases hm_eq1 : m₀ = 1
      · subst hm_eq1
        rw [one_nsmul] at hmℬ
        refine ⟨fun x y => ?_⟩
        have hzero : ∀ z : ℬ.H q, z = 0 := by
          intro z
          calc
            z = z.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 ℬ)) (Nat.add_zero q) := by simp
            _ = z.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : ℬ ⟶ ℬ)) (Nat.add_zero q) := by
              rw [hmℬ]
            _ = 0 := by simp
        rw [hzero x, hzero y]
      · obtain ⟨ℓ, hℓ_prime, hℓ_dvd_m₀⟩ := Nat.exists_prime_and_dvd hm_eq1
        let _hFact : Fact (Nat.Prime ℓ) := ⟨hℓ_prime⟩
        obtain ⟨c, hmc⟩ := hℓ_dvd_m₀
        have hc1 : 1 ≤ c := by
          by_contra hc0
          have : c = 0 := by omega
          rw [this, mul_zero] at hmc
          omega
        have hc_lt : c < m₀ := by
          have hℓ2 : 2 ≤ ℓ := hℓ_prime.two_le
          nlinarith
        have hℓ_dvd_n : ℓ ∣ n := dvd_trans ⟨c, hmc⟩ hmn
        have hc_dvd_n : c ∣ n := dvd_trans ⟨ℓ, by rw [hmc, mul_comm]⟩ hmn
        let φ : ℬ ⟶ ℬ := ℓ • 𝟙 ℬ
        let K := CategoryTheory.Limits.kernel φ
        let Im := CategoryTheory.Limits.image φ
        have hcomp0 : CategoryTheory.Limits.kernel.ι φ ≫
            CategoryTheory.Limits.factorThruImage φ = 0 := by
          apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.image.ι φ)).mp
          simp
        let S_ex : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J AddCommGrpCat.{u}) :=
          CategoryTheory.ShortComplex.mk
            (CategoryTheory.Limits.kernel.ι φ)
            (CategoryTheory.Limits.factorThruImage φ) hcomp0
        have hIsKernel : CategoryTheory.Limits.IsLimit
            (CategoryTheory.Limits.KernelFork.ofι
              (CategoryTheory.Limits.kernel.ι φ) hcomp0) := by
          refine CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
            (fun {W} u hu => CategoryTheory.Limits.kernel.lift φ u ?_)
            (fun {W} u hu => CategoryTheory.Limits.kernel.lift_ι φ u _)
            (fun {W} u hu m_hom hm_eq => ?_)
          · have : (u ≫ CategoryTheory.Limits.factorThruImage φ) ≫
                CategoryTheory.Limits.image.ι φ = 0 := by
              rw [hu, CategoryTheory.Limits.zero_comp]
            simpa using this
          · apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι φ)).mp
            rw [hm_eq, CategoryTheory.Limits.kernel.lift_ι]
        have hShortExact : S_ex.ShortExact :=
          { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel S_ex hIsKernel
            mono_f := inferInstance
            epi_g := inferInstance }
        have hK_tor : ℓ • CategoryTheory.CategoryStruct.id K = 0 := by
          apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι φ)).mp
          have hcomm : (ℓ • 𝟙 K) ≫ CategoryTheory.Limits.kernel.ι φ =
              CategoryTheory.Limits.kernel.ι φ ≫ φ := by
            simp [φ]
          rw [hcomm, CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
        have hIm_tor : c • CategoryTheory.CategoryStruct.id Im = 0 := by
          apply (CategoryTheory.cancel_epi (CategoryTheory.Limits.factorThruImage φ)).mp
          have hcomm : CategoryTheory.Limits.factorThruImage φ ≫ (c • 𝟙 Im) =
              (c • 𝟙 ℬ) ≫ CategoryTheory.Limits.factorThruImage φ := by
            simp [Im]
          rw [hcomm, CategoryTheory.Limits.comp_zero]
          apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.image.ι φ)).mp
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.image.fac,
            CategoryTheory.Limits.zero_comp]
          change (c • 𝟙 ℬ) ≫ (ℓ • 𝟙 ℬ) = 0
          have hmul : (c • 𝟙 ℬ) ≫ (ℓ • 𝟙 ℬ) = (ℓ * c) • 𝟙 ℬ := by
            simp [mul_smul]
          rw [hmul, ← hmc]
          exact hmℬ
        have hSubK : Subsingleton (K.H q) := hPrimeVanish ℓ hℓ_dvd_n K hK_tor
        have hSubIm : Subsingleton (Im.H q) := ih c hc_lt hc1 hc_dvd_n Im hIm_tor
        refine ⟨fun x y => ?_⟩
        have hzero : ∀ z : ℬ.H q, z = 0 := by
          intro z
          have hmap0 : z.comp (CategoryTheory.Abelian.Ext.mk₀ S_ex.g) (Nat.add_zero q) = 0 :=
            Subsingleton.elim _ 0
          obtain ⟨x_K, hx_K⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ hShortExact z hmap0
          have hx0 : x_K = 0 := Subsingleton.elim x_K 0
          rw [← hx_K, hx0]
          simp
        rw [hzero x, hzero y]
  have hn_tor_UF : n • CategoryTheory.CategoryStruct.id (U_n.obj F) = 0 := by
    have hn_cast0 : (n : R) = 0 := by
      ext
      change (n : ZMod n) = 0
      exact ZMod.natCast_self n
    let P : (X.left.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := F.obj ⋙ FgtMod
    have hP0 : n • CategoryTheory.CategoryStruct.id P = 0 := by
      ext W x
      let x_mod : ↑(F.obj.obj W) := x
      change n • x_mod = 0
      rw [← Nat.cast_smul_eq_nsmul R n x_mod, hn_cast0, zero_smul]
    change n • CategoryTheory.CategoryStruct.id
        ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P) = 0
    rw [← (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map_id,
      ← CategoryTheory.Functor.map_nsmul, hP0, CategoryTheory.Functor.map_zero]
  have hSubUF : Subsingleton ((U_n.obj F).H q) :=
    hDivVanish n hn (dvd_refl n) (U_n.obj F) hn_tor_UF
  exact e_q.toEquiv.subsingleton

theorem weil_cupPD_trace_mod_to_torsion_effacement_bridge (S : AlgebraicGeometry.Scheme.{u}) (d m : ℕ)
    (tr_m : weilEtaleTorsionH S m (2 * d) →+ ZMod m)
    (hTors : WeilCupPDTraceHasTorsionEffacement S d m tr_m) :
    ∃ τ : weilCupPDModH S m (2 * d) →+ ZMod m,
      WeilCupPDHasLocalEffacement S d m τ :=
by
  
  let R := ULift.{u, 0} (ZMod m)
  let R_mod : ModuleCat.{u, u} R := ModuleCat.of R R
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let Fℤ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let FM : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} := weilEtaleTorsionSheaf S m
  let oneR : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R) := weilCupPDModUnit S m
  let FgtMod : CategoryTheory.Functor (ModuleCat.{u, u} R) AddCommGrpCat.{u} :=
    CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}

  have hR_valMinAbs : ∀ r : R, ((r.down.valMinAbs : ℤ) : R) = r :=
    fun r => ULift.ext _ _ (ZMod.coe_valMinAbs r.down)
  have hR_smul_eq_zsmul : ∀ {E : Type u} [AddCommGroup E] [Module R E] (r : R) (x : E),
      r • x = r.down.valMinAbs • x := by
    intro E _ _ r x
    calc
      r • x = ((r.down.valMinAbs : ℤ) : R) • x := by rw [hR_valMinAbs]
      _ = r.down.valMinAbs • x := Int.cast_smul_eq_zsmul R _ x
  have hR_nsmul_zero : ∀ {E : Type u} [AddCommGroup E] [Module R E] (x : E), m • x = 0 := by
    intro E _ _ x
    have hmR : ((m : ℕ) : R) = 0 := ULift.ext _ _ (ZMod.natCast_self m)
    rw [← Nat.cast_smul_eq_nsmul R m x, hmR, zero_smul]

  let mkRMod : ∀ (E : Type u) [AddCommGroup E], (∀ x : E, m • x = 0) → Module R E :=
    fun E _ hE =>
      letI : Module (ZMod m) E := AddCommGroup.zmodModule hE
      Module.compHom E (ULift.ringEquiv (R := ZMod m)).toRingHom
  let mkRLin : ∀ {E₁ E₂ : Type u} [AddCommGroup E₁] [Module R E₁] [AddCommGroup E₂] [Module R E₂]
      (f : E₁ →+ E₂), E₁ →ₗ[R] E₂ :=
    fun f =>
      { toAddHom := f.toAddHom
        map_smul' := fun r x => by
          change f (r • x) = r • f x
          rw [hR_smul_eq_zsmul, map_zsmul, ← hR_smul_eq_zsmul] }

  
  let subL : ∀ (A : AddCommGrpCat.{u}), AddSubgroup ↑A :=
    fun A => (nsmulAddMonoidHom m : ↑A →+ ↑A).range
  let instModL : ∀ (A : AddCommGrpCat.{u}), Module R (↑A ⧸ subL A) := fun A =>
    mkRMod (↑A ⧸ subL A) (fun q =>
      QuotientAddGroup.induction_on q (fun a => by
        rw [← QuotientAddGroup.mk_nsmul]
        exact (QuotientAddGroup.eq_zero_iff _).mpr ⟨a, rfl⟩))
  let L_mod_obj : AddCommGrpCat.{u} → ModuleCat.{u, u} R := fun A =>
    letI : Module R (↑A ⧸ subL A) := instModL A
    ModuleCat.of R (↑A ⧸ subL A)
  let L_mod : CategoryTheory.Functor AddCommGrpCat.{u} (ModuleCat.{u, u} R) :=
    { obj := L_mod_obj
      map := fun {A B} f =>
        letI : Module R (↑A ⧸ subL A) := instModL A
        letI : Module R (↑B ⧸ subL B) := instModL B
        ModuleCat.ofHom (mkRLin (QuotientAddGroup.map (subL A) (subL B) f.hom (by
          rintro _ ⟨a, rfl⟩
          exact ⟨f.hom a, (map_nsmul f.hom m a).symm⟩)))
      map_id := fun A => by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro x
        refine QuotientAddGroup.induction_on x (fun _ => rfl)
      map_comp := fun f g => by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro x
        refine QuotientAddGroup.induction_on x (fun _ => rfl) }

  let adjL_mod : L_mod ⊣ FgtMod :=
    CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := fun A M =>
          { toFun := fun φ =>
              AddCommGrpCat.ofHom (φ.hom.toAddMonoidHom.comp (QuotientAddGroup.mk' (subL A)))
            invFun := fun ψ =>
              letI : Module R (↑A ⧸ subL A) := instModL A
              ModuleCat.ofHom (mkRLin (QuotientAddGroup.lift (subL A) ψ.hom (by
                rintro _ ⟨a, rfl⟩
                change ψ.hom (m • a) = 0
                rw [map_nsmul]
                exact @hR_nsmul_zero ↑M _ _ (ψ.hom a))))
            left_inv := fun φ => by
              apply ModuleCat.hom_ext
              apply LinearMap.ext
              intro x
              refine QuotientAddGroup.induction_on x (fun _ => rfl)
            right_inv := fun ψ => by
              ext a
              rfl }
        homEquiv_naturality_left_symm := fun f g => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro x
          refine QuotientAddGroup.induction_on x (fun _ => rfl)
        homEquiv_naturality_right := fun φ g => by
          ext a
          rfl }

  
  let subC : ∀ (A : AddCommGrpCat.{u}), AddSubgroup ↑A :=
    fun A => (nsmulAddMonoidHom m : ↑A →+ ↑A).ker
  let instModC : ∀ (A : AddCommGrpCat.{u}), Module R ↥(subC A) := fun A =>
    mkRMod ↥(subC A) (fun x => Subtype.ext x.2)
  let C_mod_obj : AddCommGrpCat.{u} → ModuleCat.{u, u} R := fun A =>
    letI : Module R ↥(subC A) := instModC A
    ModuleCat.of R ↥(subC A)
  let C_mod : CategoryTheory.Functor AddCommGrpCat.{u} (ModuleCat.{u, u} R) :=
    { obj := C_mod_obj
      map := fun {A B} f =>
        letI : Module R ↥(subC A) := instModC A
        letI : Module R ↥(subC B) := instModC B
        ModuleCat.ofHom (mkRLin
          { toFun := fun x => ⟨f.hom x.1, by
              change m • f.hom x.1 = 0
              rw [← map_nsmul, show m • x.1 = 0 from x.2, map_zero]⟩
            map_zero' := Subtype.ext f.hom.map_zero
            map_add' := fun x y => Subtype.ext (f.hom.map_add x.1 y.1) })
      map_id := fun _ => by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro x
        rfl
      map_comp := fun _ _ => by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro x
        rfl }

  let adjR_mod : FgtMod ⊣ C_mod :=
    CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := fun M A =>
          { toFun := fun φ =>
              letI : Module R ↥(subC A) := instModC A
              ModuleCat.ofHom (mkRLin (φ.hom.codRestrict (subC A) (fun x => by
                change m • φ.hom x = 0
                rw [← map_nsmul, @hR_nsmul_zero ↑M _ _ x, map_zero])))
            invFun := fun ψ =>
              AddCommGrpCat.ofHom ((subC A).subtype.comp ψ.hom.toAddMonoidHom)
            left_inv := fun _ => by
              ext x
              rfl
            right_inv := fun _ => by
              apply ModuleCat.hom_ext
              apply LinearMap.ext
              intro x
              rfl }
        homEquiv_naturality_left_symm := fun _ _ => by
          ext x
          rfl
        homEquiv_naturality_right := fun _ _ => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro x
          rfl }

  
  let : CategoryTheory.Limits.PreservesLimitsOfSize.{u, u + 1} FgtMod :=
    adjL_mod.rightAdjoint_preservesLimits
  let : CategoryTheory.Limits.PreservesLimitsOfSize.{u, u + 1} C_mod :=
    adjR_mod.rightAdjoint_preservesLimits
  let : S.smallEtaleTopology.HasSheafCompose FgtMod :=
    CategoryTheory.hasSheafCompose_of_preservesLimitsOfSize S.smallEtaleTopology
  let : S.smallEtaleTopology.HasSheafCompose C_mod :=
    CategoryTheory.hasSheafCompose_of_preservesLimitsOfSize S.smallEtaleTopology

  let U : CategoryTheory.Functor
      (CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R))
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
    CategoryTheory.sheafCompose S.smallEtaleTopology FgtMod
  let C_sh : CategoryTheory.Functor
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)) :=
    CategoryTheory.sheafCompose S.smallEtaleTopology C_mod
  let adjL_sh := CategoryTheory.Sheaf.adjunction S.smallEtaleTopology adjL_mod
  let adjR_sh : U ⊣ C_sh :=
    CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := fun F_sh G_sh =>
          { toFun := fun α =>
              CategoryTheory.ObjectProperty.homMk
                { app := fun W => adjR_mod.homEquiv _ _ (α.hom.app W)
                  naturality := fun {W₁ W₂} f => by
                    apply ModuleCat.hom_ext
                    apply LinearMap.ext
                    intro x
                    exact Subtype.ext (congrArg (fun k => k.hom x) (α.hom.naturality f)) }
            invFun := fun β =>
              CategoryTheory.ObjectProperty.homMk
                { app := fun W => (adjR_mod.homEquiv _ _).symm (β.hom.app W)
                  naturality := fun {W₁ W₂} f => by
                    ext x
                    exact congrArg Subtype.val (congrArg (fun k => k.hom x) (β.hom.naturality f)) }
            left_inv := fun α => by
              ext W : 3
              exact (adjR_mod.homEquiv _ _).left_inv (α.hom.app W)
            right_inv := fun β => by
              ext W : 3
              exact (adjR_mod.homEquiv _ _).right_inv (β.hom.app W) }
        homEquiv_naturality_left_symm := fun f g => by
          ext W : 3
          exact adjR_mod.homEquiv_naturality_left_symm (f.hom.app W) (g.hom.app W)
        homEquiv_naturality_right := fun f g => by
          ext W : 3
          exact adjR_mod.homEquiv_naturality_right (f.hom.app W) (g.hom.app W) }

  let : CategoryTheory.Limits.PreservesFiniteLimits U := by
    have := adjL_sh.rightAdjoint_preservesLimits
    infer_instance
  let : CategoryTheory.Limits.PreservesFiniteColimits U := by
    have := adjR_sh.leftAdjoint_preservesColimits
    infer_instance
  let : U.Additive := { map_add := by intros; ext W : 3; rfl }
  let : CategoryTheory.Limits.PreservesLimitsOfSize.{0, 0} C_sh :=
    adjR_sh.rightAdjoint_preservesLimits

  
  let T : S.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (CategoryTheory.CategoryStruct.id S)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S))
  have hT : CategoryTheory.Limits.IsTerminal T := by
    let FgtS := AlgebraicGeometry.Scheme.Etale.forget S
    let ffS := AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful S
    have hTermOver : CategoryTheory.Limits.IsTerminal (FgtS.obj T) :=
      CategoryTheory.Over.mkIdTerminal
    exact CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => ffS.preimage (hTermOver.from (FgtS.obj W)))
      (fun W m => ffS.map_injective (hTermOver.hom_ext (FgtS.map m) _))

  let adjℤ := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT
  let adjR := CategoryTheory.constantSheafAdj S.smallEtaleTopology (ModuleCat.{u, u} R) hT
  let ιM : AM ⟶ FgtMod.obj R_mod := AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let ιM_inv : FgtMod.obj R_mod ⟶ AM := AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let e_ιM : ∀ B : AddCommGrpCat.{u}, (FgtMod.obj R_mod ⟶ B) ≃ (AM ⟶ B) := fun B =>
    { toFun := fun f => ιM ≫ f
      invFun := fun g => ιM_inv ≫ g
      left_inv := fun _ => by ext x; rfl
      right_inv := fun _ => by ext x; rfl }
  let ιℤ : Aℤ ⟶ FgtMod.obj R_mod :=
    AddCommGrpCat.ofHom
      { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod m)
        map_zero' := ULift.ext _ _ Int.cast_zero
        map_add' := fun x y => ULift.ext _ _ (Int.cast_add x.down y.down) }

  let ηℤ : Fℤ ⟶ U.obj oneR :=
    (adjℤ.homEquiv Aℤ (U.obj oneR)).symm (ιℤ ≫ FgtMod.map (adjR.unit.app R_mod))
  let αM : FM ⟶ U.obj oneR :=
    (adjℤ.homEquiv AM (U.obj oneR)).symm (ιM ≫ FgtMod.map (adjR.unit.app R_mod))

  
  let e_Unit : ∀ G_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u},
      (U.obj oneR ⟶ G_sh) ≃ (FM ⟶ G_sh) :=
    fun G_sh =>
      (adjR_sh.homEquiv oneR G_sh).trans
        ((adjR.homEquiv R_mod (C_sh.obj G_sh)).trans
          ((adjR_mod.homEquiv R_mod (G_sh.obj.obj (Opposite.op T))).symm.trans
            ((e_ιM (G_sh.obj.obj (Opposite.op T))).trans (adjℤ.homEquiv AM G_sh).symm)))
  have he_Unit_apply : ∀ {G_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : U.obj oneR ⟶ G_sh),
      e_Unit G_sh φ = αM ≫ φ := by
    intro G_sh φ
    apply (adjℤ.homEquiv AM G_sh).injective
    change (adjℤ.homEquiv AM G_sh)
        ((adjℤ.homEquiv AM G_sh).symm
          (e_ιM (G_sh.obj.obj (Opposite.op T))
            ((adjR_mod.homEquiv R_mod (G_sh.obj.obj (Opposite.op T))).symm
              ((adjR.homEquiv R_mod (C_sh.obj G_sh))
                ((adjR_sh.homEquiv oneR G_sh) φ))))) =
      (adjℤ.homEquiv AM G_sh) (αM ≫ φ)
    dsimp only [αM]
    rw [Equiv.apply_symm_apply, adjℤ.homEquiv_naturality_right, Equiv.apply_symm_apply,
      adjR.homEquiv_unit]
    apply AddCommGrpCat.hom_ext
    ext r
    rfl
  let βM : U.obj oneR ⟶ FM := (e_Unit FM).symm (𝟙 FM)
  have hαβ : αM ≫ βM = 𝟙 FM := by
    rw [← he_Unit_apply βM]
    exact (e_Unit FM).apply_symm_apply (𝟙 FM)

  
  let genMap : ∀ (F_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)) (q : ℕ),
      CategoryTheory.Abelian.Ext.{u} oneR F_sh q →+
        CategoryTheory.Abelian.Ext.{u} Fℤ (U.obj F_sh) q :=
    fun F_sh q =>
      ((CategoryTheory.Abelian.Ext.mk₀ ηℤ).precomp (U.obj F_sh) (Nat.zero_add q)).comp
        (U.mapExtAddHom oneR F_sh q)

  
  have hBase0 : ∀ F_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R),
      Function.Bijective (genMap F_sh 0) := by
    intro F_sh
    let A : ModuleCat.{u, u} R := F_sh.obj.obj (Opposite.op T)
    let e_R : (R_mod ⟶ A) ≃ ↑A :=
      { toFun := fun ψ => ψ.hom (ULift.up 1)
        invFun := fun a => ModuleCat.ofHom (LinearMap.toSpanSingleton R (↑A) a)
        left_inv := fun ψ => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro r
          change r • ψ.hom (ULift.up 1) = ψ.hom r
          rw [← map_smul]
          congr 1
          exact ULift.ext _ _ (mul_one r.down)
        right_inv := fun a => by
          change (ULift.up (1 : ZMod m) : R) • a = a
          exact one_smul R a }
    let e_ℤ : (Aℤ ⟶ (U.obj F_sh).obj.obj (Opposite.op T)) ≃ ↑A :=
      { toFun := fun g => g.hom (ULift.up (1 : ℤ))
        invFun := fun a =>
          AddCommGrpCat.ofHom
            { toFun := fun z => z.down • a
              map_zero' := zero_zsmul a
              map_add' := fun x y => add_zsmul a x.down y.down }
        left_inv := fun g => by
          ext z
          change z.down • g.hom (ULift.up 1) = g.hom z
          rw [← map_zsmul]
          congr 1
          exact ULift.ext _ _ (mul_one z.down)
        right_inv := fun a => one_zsmul a }
    let eqDom : (oneR ⟶ F_sh) ≃ ↑A := (adjR.homEquiv R_mod F_sh).trans e_R
    let eqCod : (Fℤ ⟶ U.obj F_sh) ≃ ↑A := (adjℤ.homEquiv Aℤ (U.obj F_sh)).trans e_ℤ
    have hHomBij : Function.Bijective (fun φ : oneR ⟶ F_sh => ηℤ ≫ U.map φ) := by
      have hcomm : (fun φ : oneR ⟶ F_sh => ηℤ ≫ U.map φ) = eqCod.symm ∘ eqDom := by
        funext φ
        apply eqCod.injective
        rw [Function.comp_apply, Equiv.apply_symm_apply]
        dsimp only [eqCod, eqDom, Equiv.trans_apply, ηℤ]
        rw [adjℤ.homEquiv_naturality_right, Equiv.apply_symm_apply]
        dsimp only [e_ℤ, e_R, Equiv.coe_fn_mk]
        change (FgtMod.map (φ.hom.app (Opposite.op T))).hom
            ((FgtMod.map (adjR.unit.app R_mod)).hom (ιℤ.hom (ULift.up 1))) =
          (φ.hom.app (Opposite.op T)).hom ((adjR.unit.app R_mod).hom (ULift.up 1))
        have hι1 : ιℤ.hom (ULift.up 1) = (ULift.up 1 : R) := ULift.ext _ _ Int.cast_one
        rw [hι1]
        rfl
      rw [hcomm]
      exact eqCod.symm.bijective.comp eqDom.bijective
    have hmk0_dom := CategoryTheory.Abelian.Ext.mk₀_bijective oneR F_sh
    have hmk0_cod := CategoryTheory.Abelian.Ext.mk₀_bijective Fℤ (U.obj F_sh)
    have hcomp_eq : ∀ φ : oneR ⟶ F_sh,
        genMap F_sh 0 (CategoryTheory.Abelian.Ext.mk₀ φ) =
          CategoryTheory.Abelian.Ext.mk₀ (ηℤ ≫ U.map φ) := by
      intro φ
      dsimp [genMap]
      change (CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor U (CategoryTheory.Abelian.Ext.mk₀ φ))
          (Nat.zero_add 0) =
        CategoryTheory.Abelian.Ext.mk₀ (ηℤ ≫ U.map φ)
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    refine ⟨?_, ?_⟩
    · intro x₁ x₂ hx
      obtain ⟨φ₁, rfl⟩ := hmk0_dom.2 x₁
      obtain ⟨φ₂, rfl⟩ := hmk0_dom.2 x₂
      congr 1
      apply hHomBij.1
      apply hmk0_cod.1
      exact (hcomp_eq φ₁).symm.trans (hx.trans (hcomp_eq φ₂))
    · intro y
      obtain ⟨ψ, rfl⟩ := hmk0_cod.2 y
      obtain ⟨φ, rfl⟩ := hHomBij.2 ψ
      exact ⟨CategoryTheory.Abelian.Ext.mk₀ φ, hcomp_eq φ⟩

  
  have hFreeComp_ab : ∀ {W : S.Etale}
      {F_sh G_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (α : CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology W AM ⟶ F_sh)
      (g : F_sh ⟶ G_sh),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) :=
    fun α g => CategoryTheory.Presheaf.freeYonedaHomEquiv_comp
      ((CategoryTheory.sheafificationAdjunction _ AddCommGrpCat.{u}).homEquiv _ _ α) g.hom
  have hFreeComp_mod : ∀ {W : S.Etale}
      {F_sh G_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)}
      (α : CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology W R_mod ⟶ F_sh)
      (g : F_sh ⟶ G_sh),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) :=
    fun α g => CategoryTheory.Presheaf.freeYonedaHomEquiv_comp
      ((CategoryTheory.sheafificationAdjunction _ (ModuleCat.{u, u} R)).homEquiv _ _ α) g.hom

  let α_loc : ∀ W : S.Etale,
      weilCupPDTraceLocalTorsionSheaf S m W ⟶ U.obj (weilCupPDLocalFreeSheaf S m W) :=
    fun W =>
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
        (ιM ≫ FgtMod.map
          (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilCupPDLocalFreeSheaf S m W))))
  let e_Loc : ∀ (W : S.Etale)
      (G_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      (U.obj (weilCupPDLocalFreeSheaf S m W) ⟶ G_sh) ≃
        (weilCupPDTraceLocalTorsionSheaf S m W ⟶ G_sh) :=
    fun W G_sh =>
      (adjR_sh.homEquiv (weilCupPDLocalFreeSheaf S m W) G_sh).trans
        (CategoryTheory.Sheaf.freeYonedaHomEquiv.trans
          ((adjR_mod.homEquiv R_mod (G_sh.obj.obj (Opposite.op W))).symm.trans
            ((e_ιM (G_sh.obj.obj (Opposite.op W))).trans
              CategoryTheory.Sheaf.freeYonedaHomEquiv.symm)))
  have he_Loc_apply : ∀ (W : S.Etale)
      {G_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : U.obj (weilCupPDLocalFreeSheaf S m W) ⟶ G_sh),
      e_Loc W G_sh φ = α_loc W ≫ φ := by
    intro W G_sh φ
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    change CategoryTheory.Sheaf.freeYonedaHomEquiv
        (CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
          (e_ιM (G_sh.obj.obj (Opposite.op W))
            ((adjR_mod.homEquiv R_mod (G_sh.obj.obj (Opposite.op W))).symm
              (CategoryTheory.Sheaf.freeYonedaHomEquiv
                ((adjR_sh.homEquiv (weilCupPDLocalFreeSheaf S m W) G_sh) φ))))) =
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α_loc W ≫ φ)
    dsimp only [α_loc]
    rw [Equiv.apply_symm_apply, hFreeComp_ab, Equiv.apply_symm_apply]
    have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv
        ((adjR_sh.homEquiv (weilCupPDLocalFreeSheaf S m W) G_sh) φ) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S m W)) ≫
          ((adjR_sh.homEquiv (weilCupPDLocalFreeSheaf S m W) G_sh) φ).hom.app (Opposite.op W) := by
      rw [← hFreeComp_mod, CategoryTheory.Category.id_comp]
    rw [h1]
    apply AddCommGrpCat.hom_ext
    ext r
    rfl
  let β_loc : ∀ W : S.Etale,
      U.obj (weilCupPDLocalFreeSheaf S m W) ⟶ weilCupPDTraceLocalTorsionSheaf S m W :=
    fun W => (e_Loc W (weilCupPDTraceLocalTorsionSheaf S m W)).symm
      (𝟙 (weilCupPDTraceLocalTorsionSheaf S m W))
  have hInv_loc : ∀ W : S.Etale,
      α_loc W ≫ β_loc W = 𝟙 (weilCupPDTraceLocalTorsionSheaf S m W) ∧
      β_loc W ≫ α_loc W = 𝟙 (U.obj (weilCupPDLocalFreeSheaf S m W)) := by
    intro W
    have h1 : α_loc W ≫ β_loc W = 𝟙 _ := by
      rw [← he_Loc_apply W (β_loc W)]
      exact (e_Loc W _).apply_symm_apply (𝟙 _)
    refine ⟨h1, ?_⟩
    apply (e_Loc W (U.obj (weilCupPDLocalFreeSheaf S m W))).injective
    rw [he_Loc_apply, he_Loc_apply, CategoryTheory.Category.comp_id,
      ← CategoryTheory.Category.assoc, h1, CategoryTheory.Category.id_comp]

  have hNatMap : ∀ {U' U_et : S.Etale} (v : U' ⟶ U_et),
      U.map (weilCupPDLocalFreeMap S m v) ≫ β_loc U_et =
        β_loc U' ≫ weilCupPDTraceLocalTorsionMap S m v := by
    intro U' U_et v
    have hα : α_loc U' ≫ U.map (weilCupPDLocalFreeMap S m v) =
        weilCupPDTraceLocalTorsionMap S m v ≫ α_loc U_et := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hFreeComp_ab, hFreeComp_ab]
      have h_lhs0 : CategoryTheory.Sheaf.freeYonedaHomEquiv (α_loc U') =
          ιM ≫ FgtMod.map (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilCupPDLocalFreeSheaf S m U'))) :=
        Equiv.apply_symm_apply _ _
      have h_rhs0 : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilCupPDTraceLocalTorsionMap S m v) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDTraceLocalTorsionSheaf S m U_et)) ≫
            (weilCupPDTraceLocalTorsionSheaf S m U_et).obj.map (Opposite.op v) :=
        Equiv.apply_symm_apply _ _
      have h_lhs : CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S m U')) ≫
          ((weilCupPDLocalFreeMap S m v).hom.app (Opposite.op U')) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S m U_et)) ≫
            (weilCupPDLocalFreeSheaf S m U_et).obj.map (Opposite.op v) := by
        rw [← hFreeComp_mod, CategoryTheory.Category.id_comp]
        exact Equiv.apply_symm_apply _ _
      have h_rhs : CategoryTheory.Sheaf.freeYonedaHomEquiv
          (𝟙 (weilCupPDTraceLocalTorsionSheaf S m U_et)) ≫
          (α_loc U_et).hom.app (Opposite.op U_et) =
          ιM ≫ FgtMod.map (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilCupPDLocalFreeSheaf S m U_et))) := by
        rw [← hFreeComp_ab, CategoryTheory.Category.id_comp]
        exact Equiv.apply_symm_apply _ _
      rw [h_lhs0, h_rhs0, CategoryTheory.Category.assoc,
        (α_loc U_et).hom.naturality (Opposite.op v),
        ← CategoryTheory.Category.assoc _ ((α_loc U_et).hom.app (Opposite.op U_et)), h_rhs]
      change (ιM ≫ FgtMod.map (CategoryTheory.Sheaf.freeYonedaHomEquiv
          (𝟙 (weilCupPDLocalFreeSheaf S m U')))) ≫
          FgtMod.map ((weilCupPDLocalFreeMap S m v).hom.app (Opposite.op U')) =
        (ιM ≫ FgtMod.map (CategoryTheory.Sheaf.freeYonedaHomEquiv
          (𝟙 (weilCupPDLocalFreeSheaf S m U_et)))) ≫
          FgtMod.map ((weilCupPDLocalFreeSheaf S m U_et).obj.map (Opposite.op v))
      rw [CategoryTheory.Category.assoc, ← FgtMod.map_comp, h_lhs,
        FgtMod.map_comp, CategoryTheory.Category.assoc]
    calc
      U.map (weilCupPDLocalFreeMap S m v) ≫ β_loc U_et
        = (β_loc U' ≫ α_loc U') ≫ U.map (weilCupPDLocalFreeMap S m v) ≫ β_loc U_et := by
            rw [(hInv_loc U').2, CategoryTheory.Category.id_comp]
      _ = β_loc U' ≫ (α_loc U' ≫ U.map (weilCupPDLocalFreeMap S m v)) ≫ β_loc U_et := by
            simp only [CategoryTheory.Category.assoc]
      _ = β_loc U' ≫ weilCupPDTraceLocalTorsionMap S m v ≫ (α_loc U_et ≫ β_loc U_et) := by
            rw [hα, CategoryTheory.Category.assoc]
      _ = β_loc U' ≫ weilCupPDTraceLocalTorsionMap S m v := by
            rw [(hInv_loc U_et).1, CategoryTheory.Category.comp_id]

  have hNatCounit : ∀ W : S.Etale,
      U.map (weilCupPDLocalCounit S m W) ≫ βM =
        β_loc W ≫ weilCupPDTraceLocalTorsionCounit S m W := by
    intro W
    have hα : α_loc W ≫ U.map (weilCupPDLocalCounit S m W) =
        weilCupPDTraceLocalTorsionCounit S m W ≫ αM := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hFreeComp_ab, hFreeComp_ab]
      have h_αloc : CategoryTheory.Sheaf.freeYonedaHomEquiv (α_loc W) =
          ιM ≫ FgtMod.map (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilCupPDLocalFreeSheaf S m W))) :=
        Equiv.apply_symm_apply _ _
      rw [h_αloc]
      let τ_W : W ⟶ T := hT.from W
      let η_sh_ab : (CategoryTheory.Functor.const (Opposite S.Etale)).obj AM ⟶ FM.obj :=
        (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
          AddCommGrpCat.{u}).unit.app ((CategoryTheory.Functor.const (Opposite S.Etale)).obj AM)
      let η_sh_mod : (CategoryTheory.Functor.const (Opposite S.Etale)).obj R_mod ⟶ oneR.obj :=
        (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
          (ModuleCat.{u, u} R)).unit.app
          ((CategoryTheory.Functor.const (Opposite S.Etale)).obj R_mod)
      have h_lhs_mod : CategoryTheory.Sheaf.freeYonedaHomEquiv
          (𝟙 (weilCupPDLocalFreeSheaf S m W)) ≫
          (weilCupPDLocalCounit S m W).hom.app (Opposite.op W) =
          η_sh_mod.app (Opposite.op W) := by
        rw [← hFreeComp_mod, CategoryTheory.Category.id_comp]
        exact Equiv.apply_symm_apply _ _
      have h_counit_ab : CategoryTheory.Sheaf.freeYonedaHomEquiv
          (weilCupPDTraceLocalTorsionCounit S m W) =
          η_sh_ab.app (Opposite.op W) :=
        Equiv.apply_symm_apply _ _
      have h_unit_ab : adjℤ.unit.app AM = η_sh_ab.app (Opposite.op T) := by
        dsimp [adjℤ, CategoryTheory.constantSheafAdj]
        rw [CategoryTheory.Adjunction.comp_unit_app,
          CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
        rfl
      have h_unit_mod : adjR.unit.app R_mod = η_sh_mod.app (Opposite.op T) := by
        dsimp [adjR, CategoryTheory.constantSheafAdj]
        rw [CategoryTheory.Adjunction.comp_unit_app,
          CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
        rfl
      have h_αM_T : η_sh_ab.app (Opposite.op T) ≫ αM.hom.app (Opposite.op T) =
          ιM ≫ FgtMod.map (η_sh_mod.app (Opposite.op T)) := by
        rw [← h_unit_ab, ← h_unit_mod]
        exact (adjℤ.homEquiv_unit AM (U.obj oneR) αM).symm.trans
          ((adjℤ.homEquiv AM (U.obj oneR)).apply_symm_apply _)
      have h_nat_ab : η_sh_ab.app (Opposite.op W) =
          η_sh_ab.app (Opposite.op T) ≫ FM.obj.map (Opposite.op τ_W) := by
        have hnat := η_sh_ab.naturality (Opposite.op τ_W)
        change 𝟙 AM ≫ η_sh_ab.app (Opposite.op W) =
          η_sh_ab.app (Opposite.op T) ≫ FM.obj.map (Opposite.op τ_W) at hnat
        rwa [CategoryTheory.Category.id_comp] at hnat
      have h_nat_mod : η_sh_mod.app (Opposite.op W) =
          η_sh_mod.app (Opposite.op T) ≫ oneR.obj.map (Opposite.op τ_W) := by
        have hnat := η_sh_mod.naturality (Opposite.op τ_W)
        change 𝟙 R_mod ≫ η_sh_mod.app (Opposite.op W) =
          η_sh_mod.app (Opposite.op T) ≫ oneR.obj.map (Opposite.op τ_W) at hnat
        rwa [CategoryTheory.Category.id_comp] at hnat
      change (ιM ≫ FgtMod.map (CategoryTheory.Sheaf.freeYonedaHomEquiv
          (𝟙 (weilCupPDLocalFreeSheaf S m W)))) ≫
          FgtMod.map ((weilCupPDLocalCounit S m W).hom.app (Opposite.op W)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv
          (weilCupPDTraceLocalTorsionCounit S m W) ≫
          αM.hom.app (Opposite.op W)
      rw [CategoryTheory.Category.assoc, ← FgtMod.map_comp, h_lhs_mod, h_nat_mod,
        FgtMod.map_comp, ← CategoryTheory.Category.assoc ιM]
      change (ιM ≫ FgtMod.map (η_sh_mod.app (Opposite.op T))) ≫
          (U.obj oneR).obj.map (Opposite.op τ_W) = _
      have h_αM_nat : (η_sh_ab.app (Opposite.op T) ≫ αM.hom.app (Opposite.op T)) ≫
          (U.obj oneR).obj.map (Opposite.op τ_W) =
          (η_sh_ab.app (Opposite.op T) ≫ FM.obj.map (Opposite.op τ_W)) ≫
          αM.hom.app (Opposite.op W) := by
        have hnat := αM.hom.naturality (Opposite.op τ_W)
        apply AddCommGrpCat.hom_ext
        ext r
        exact congrArg (fun k => k.hom ((η_sh_ab.app (Opposite.op T)).hom r)) hnat.symm
      exact (congrArg (fun k => k ≫ (U.obj oneR).obj.map (Opposite.op τ_W)) h_αM_T.symm).trans
        (h_αM_nat.trans
          (congrArg (fun k => k ≫ αM.hom.app (Opposite.op W))
            (h_nat_ab.symm.trans h_counit_ab.symm)))
    calc
      U.map (weilCupPDLocalCounit S m W) ≫ βM
        = (β_loc W ≫ α_loc W) ≫ U.map (weilCupPDLocalCounit S m W) ≫ βM := by
            rw [(hInv_loc W).2, CategoryTheory.Category.id_comp]
      _ = β_loc W ≫ (α_loc W ≫ U.map (weilCupPDLocalCounit S m W)) ≫ βM := by
            simp only [CategoryTheory.Category.assoc]
      _ = β_loc W ≫ weilCupPDTraceLocalTorsionCounit S m W ≫ (αM ≫ βM) := by
            rw [hα, CategoryTheory.Category.assoc]
      _ = β_loc W ≫ weilCupPDTraceLocalTorsionCounit S m W := by
            rw [hαβ, CategoryTheory.Category.comp_id]

  
  let IsTF : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} → Prop :=
    fun K_sh => ∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id K_sh)

  have hAℤ_mono : ∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • 𝟙 Aℤ) := by
    intro n hn
    rw [AddCommGrpCat.mono_iff_injective]
    intro x y hxy
    have h2 : n • x.down = n • y.down := congrArg ULift.down (show n • x = n • y from hxy)
    rw [nsmul_eq_mul, nsmul_eq_mul] at h2
    exact ULift.ext _ _ (mul_left_cancel₀ (Nat.cast_ne_zero.mpr hn) h2)

  have hInitTF : IsTF Fℤ := by
    intro n hn
    let C_const := CategoryTheory.Functor.const (Opposite S.Etale) ⋙
      CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    have : CategoryTheory.Limits.PreservesFiniteLimits C_const :=
      CategoryTheory.Limits.comp_preservesFiniteLimits _ _
    have : CategoryTheory.Mono (n • 𝟙 Aℤ) := hAℤ_mono n hn
    have hmap : C_const.map (n • 𝟙 Aℤ) = n • 𝟙 Fℤ := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      rfl
    rw [← hmap]
    exact C_const.map_mono (n • 𝟙 Aℤ)

  have hGrothCover : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u + 1} C]
      [CategoryTheory.Abelian C] [CategoryTheory.IsGrothendieckAbelian.{u} C]
      {C₀ : Type u} (Y_gen : C₀ → C),
      (∀ (x : C₀) (n : ℕ), n ≠ 0 → CategoryTheory.Mono (n • 𝟙 (Y_gen x))) →
      (∀ {E₁ E₂ : C} (f₁ f₂ : E₁ ⟶ E₂),
        (∀ (x : C₀) (g : Y_gen x ⟶ E₁), g ≫ f₁ = g ≫ f₂) → f₁ = f₂) →
      ∀ E_sh : C, ∃ (P_cov : C) (π : P_cov ⟶ E_sh),
        CategoryTheory.Epi π ∧ ∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • 𝟙 P_cov) := by
    intro C _ _ _ C₀ Y_gen hGenTF hSep E_sh
    let : CategoryTheory.LocallySmall.{u} C :=
      CategoryTheory.IsGrothendieckAbelian.locallySmall
    let : CategoryTheory.Limits.HasColimitsOfSize.{u, u} C :=
      CategoryTheory.IsGrothendieckAbelian.hasColimits C
    let : CategoryTheory.Limits.HasColimitsOfSize.{0, u} C :=
      CategoryTheory.Limits.hasColimitsOfSizeShrink.{0, u, u, u} C
    let Idx : Type u := Σ x : C₀, Shrink.{u} (Y_gen x ⟶ E_sh)
    let fam : Idx → C := fun p => Y_gen p.1
    let P_cov : C := CategoryTheory.Limits.sigmaObj fam
    let π : P_cov ⟶ E_sh :=
      CategoryTheory.Limits.Sigma.desc (fun p : Idx => (equivShrink _).symm p.2)
    refine ⟨P_cov, π, ⟨fun {Z} f₁ f₂ hEq => hSep f₁ f₂ (fun x g => ?_)⟩, fun n hn => ?_⟩
    · let p : Idx := ⟨x, equivShrink _ g⟩
      have hι := CategoryTheory.Limits.Sigma.ι_comp_desc (fun q : Idx => (equivShrink _).symm q.2) p
      have h1 : CategoryTheory.Limits.Sigma.ι fam p ≫ (π ≫ f₁) =
          CategoryTheory.Limits.Sigma.ι fam p ≫ (π ≫ f₂) := by
        rw [hEq]
      rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, hι] at h1
      simpa [p] using h1
    · let α : CategoryTheory.Discrete.functor fam ⟶ CategoryTheory.Discrete.functor fam :=
        CategoryTheory.Discrete.natTrans (fun i => n • 𝟙 (fam i.as))
      have : ∀ i : CategoryTheory.Discrete Idx, CategoryTheory.Mono (α.app i) :=
        fun i => hGenTF i.as.1 n hn
      have : CategoryTheory.Mono α := CategoryTheory.NatTrans.mono_of_mono_app α
      have : CategoryTheory.HasExactColimitsOfShape (CategoryTheory.Discrete Idx) C :=
        CategoryTheory.AB4OfSize.ofShape Idx
      exact CategoryTheory.Limits.colim.map_mono' α
        (CategoryTheory.Limits.colimit.isColimit _)
        (CategoryTheory.Limits.colimit.isColimit _)
        (n • 𝟙 P_cov)
        (fun j => by
          have hid : (CategoryTheory.Limits.colimit.cocone
              (CategoryTheory.Discrete.functor fam)).ι.app j ≫ 𝟙 P_cov =
              (CategoryTheory.Limits.colimit.cocone
                (CategoryTheory.Discrete.functor fam)).ι.app j :=
            CategoryTheory.Category.comp_id _
          rw [CategoryTheory.Preadditive.comp_nsmul, hid]
          dsimp [α]
          rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp])

  have hCoverTF : ∀ E_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u},
      ∃ (P_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (π : P_sh ⟶ E_sh),
        CategoryTheory.Epi π ∧ IsTF P_sh := by
    let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology S
    let C₀ : Type u := CategoryTheory.SmallModel.{u} S.AffineEtale
    let e_Aff := CategoryTheory.equivSmallModel.{u} S.AffineEtale
    let E_eq := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv S AddCommGrpCat.{u}
    let Y_aff : C₀ → CategoryTheory.Sheaf J_aff AddCommGrpCat.{u} :=
      fun x => CategoryTheory.Sheaf.freeYoneda J_aff (e_Aff.inverse.obj x) Aℤ
    let Y_et : C₀ → CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
      fun x => E_eq.functor.obj (Y_aff x)
    have hY_tf : ∀ (x : C₀) (n : ℕ), n ≠ 0 → CategoryTheory.Mono (n • 𝟙 (Y_et x)) := by
      intro x n hn
      let W := e_Aff.inverse.obj x
      let P_pre := CategoryTheory.Presheaf.freeYoneda W Aℤ
      have hP_app : ∀ V : Opposite S.AffineEtale, CategoryTheory.Mono ((n • 𝟙 P_pre).app V) := by
        intro V
        let IdxV : Type u := Opposite.unop V ⟶ W
        let famV : IdxV → AddCommGrpCat.{u} := fun _ => Aℤ
        change CategoryTheory.Mono (n • 𝟙 (CategoryTheory.Limits.sigmaObj famV))
        let αV : CategoryTheory.Discrete.functor famV ⟶ CategoryTheory.Discrete.functor famV :=
          CategoryTheory.Discrete.natTrans (fun _ => n • 𝟙 Aℤ)
        have : ∀ i : CategoryTheory.Discrete IdxV, CategoryTheory.Mono (αV.app i) :=
          fun _ => hAℤ_mono n hn
        have : CategoryTheory.Mono αV := CategoryTheory.NatTrans.mono_of_mono_app αV
        have : CategoryTheory.HasExactColimitsOfShape
            (CategoryTheory.Discrete IdxV) AddCommGrpCat.{u} :=
          CategoryTheory.AB4OfSize.ofShape IdxV
        exact CategoryTheory.Limits.colim.map_mono' αV
          (CategoryTheory.Limits.colimit.isColimit _)
          (CategoryTheory.Limits.colimit.isColimit _)
          (n • 𝟙 (CategoryTheory.Limits.sigmaObj famV))
          (fun j => by
            have hid : (CategoryTheory.Limits.colimit.cocone
                (CategoryTheory.Discrete.functor famV)).ι.app j ≫
                𝟙 (CategoryTheory.Limits.sigmaObj famV) =
                (CategoryTheory.Limits.colimit.cocone
                  (CategoryTheory.Discrete.functor famV)).ι.app j :=
              CategoryTheory.Category.comp_id _
            rw [CategoryTheory.Preadditive.comp_nsmul, hid]
            dsimp [αV]
            rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp])
      have : ∀ V : Opposite S.AffineEtale, CategoryTheory.Mono ((n • 𝟙 P_pre).app V) := hP_app
      have : CategoryTheory.Mono (n • 𝟙 P_pre) :=
        CategoryTheory.NatTrans.mono_of_mono_app (n • 𝟙 P_pre)
      let F_comp := CategoryTheory.presheafToSheaf J_aff AddCommGrpCat.{u} ⋙ E_eq.functor
      have : CategoryTheory.Limits.PreservesFiniteLimits F_comp :=
        CategoryTheory.Limits.comp_preservesFiniteLimits _ _
      have : F_comp.Additive := F_comp.additive_of_preserves_binary_products
      have hmap : F_comp.map (n • 𝟙 P_pre) = n • 𝟙 (Y_et x) := by
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
        rfl
      rw [← hmap]
      exact F_comp.map_mono (n • 𝟙 P_pre)
    have hY_sep : ∀ {E₁ E₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (f₁ f₂ : E₁ ⟶ E₂),
        (∀ (x : C₀) (g : Y_et x ⟶ E₁), g ≫ f₁ = g ≫ f₂) → f₁ = f₂ := by
      intro E₁ E₂ f₁ f₂ hAll
      apply E_eq.inverse.map_injective
      apply CategoryTheory.ObjectProperty.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext V_op
      apply AddCommGrpCat.hom_ext
      ext a
      let V := Opposite.unop V_op
      let x : C₀ := e_Aff.functor.obj V
      let W : S.AffineEtale := e_Aff.inverse.obj x
      let iso_VW : V ≅ W := e_Aff.unitIso.app V
      let a' : ↑((E_eq.inverse.obj E₁).obj.obj (Opposite.op W)) :=
        ((E_eq.inverse.obj E₁).obj.map (Opposite.op iso_VW.inv)).hom a
      let α_hom : Aℤ ⟶ (E_eq.inverse.obj E₁).obj.obj (Opposite.op W) :=
        AddCommGrpCat.ofHom
          { toFun := fun z => z.down • a'
            map_zero' := zero_zsmul a'
            map_add' := fun z₁ z₂ => add_zsmul a' z₁.down z₂.down }
      let α_aff : Y_aff x ⟶ E_eq.inverse.obj E₁ :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv.symm α_hom
      let g : Y_et x ⟶ E₁ :=
        E_eq.functor.map α_aff ≫ E_eq.counitIso.hom.app E₁
      have hg_eq := hAll x g
      have h_aff_eq : α_aff ≫ E_eq.inverse.map f₁ = α_aff ≫ E_eq.inverse.map f₂ := by
        have hnat₁ : E_eq.counitIso.hom.app E₁ ≫ f₁ =
            E_eq.functor.map (E_eq.inverse.map f₁) ≫ E_eq.counitIso.hom.app E₂ :=
          (E_eq.counitIso.hom.naturality f₁).symm
        have hnat₂ : E_eq.counitIso.hom.app E₁ ≫ f₂ =
            E_eq.functor.map (E_eq.inverse.map f₂) ≫ E_eq.counitIso.hom.app E₂ :=
          (E_eq.counitIso.hom.naturality f₂).symm
        have hg₁ : g ≫ f₁ =
            E_eq.functor.map (α_aff ≫ E_eq.inverse.map f₁) ≫ E_eq.counitIso.hom.app E₂ := by
          dsimp [g]
          rw [CategoryTheory.Category.assoc, hnat₁,
            ← CategoryTheory.Category.assoc, ← E_eq.functor.map_comp]
        have hg₂ : g ≫ f₂ =
            E_eq.functor.map (α_aff ≫ E_eq.inverse.map f₂) ≫ E_eq.counitIso.hom.app E₂ := by
          dsimp [g]
          rw [CategoryTheory.Category.assoc, hnat₂,
            ← CategoryTheory.Category.assoc, ← E_eq.functor.map_comp]
        rw [hg₁, hg₂] at hg_eq
        exact E_eq.functor.map_injective ((cancel_mono (E_eq.counitIso.hom.app E₂)).mp hg_eq)
      have h_ev := congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv h_aff_eq
      have h_comp₁ : CategoryTheory.Sheaf.freeYonedaHomEquiv
          (α_aff ≫ E_eq.inverse.map f₁) =
          α_hom ≫ (E_eq.inverse.map f₁).hom.app (Opposite.op W) := by
        refine (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp
          ((CategoryTheory.sheafificationAdjunction J_aff AddCommGrpCat.{u}).homEquiv _ _ α_aff)
          (E_eq.inverse.map f₁).hom).trans ?_
        change CategoryTheory.Sheaf.freeYonedaHomEquiv α_aff ≫ _ = _
        rw [Equiv.apply_symm_apply]
      have h_comp₂ : CategoryTheory.Sheaf.freeYonedaHomEquiv
          (α_aff ≫ E_eq.inverse.map f₂) =
          α_hom ≫ (E_eq.inverse.map f₂).hom.app (Opposite.op W) := by
        refine (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp
          ((CategoryTheory.sheafificationAdjunction J_aff AddCommGrpCat.{u}).homEquiv _ _ α_aff)
          (E_eq.inverse.map f₂).hom).trans ?_
        change CategoryTheory.Sheaf.freeYonedaHomEquiv α_aff ≫ _ = _
        rw [Equiv.apply_symm_apply]
      rw [h_comp₁, h_comp₂] at h_ev
      have h_a' : ((E_eq.inverse.map f₁).hom.app (Opposite.op W)).hom a' =
          ((E_eq.inverse.map f₂).hom.app (Opposite.op W)).hom a' := by
        have hpt := congrArg (fun k => k.hom (ULift.up (1 : ℤ))) h_ev
        change ((E_eq.inverse.map f₁).hom.app (Opposite.op W)).hom ((1 : ℤ) • a') =
          ((E_eq.inverse.map f₂).hom.app (Opposite.op W)).hom ((1 : ℤ) • a') at hpt
        rwa [one_zsmul] at hpt
      have h_recover : ∀ (k : E_eq.inverse.obj E₁ ⟶ E_eq.inverse.obj E₂),
          (k.hom.app V_op).hom a =
            ((E_eq.inverse.obj E₂).obj.map (Opposite.op iso_VW.hom)).hom
              ((k.hom.app (Opposite.op W)).hom a') := by
        intro k
        have hnat : (k.hom.app (Opposite.op W)).hom a' =
            ((E_eq.inverse.obj E₂).obj.map (Opposite.op iso_VW.inv)).hom
              ((k.hom.app V_op).hom a) :=
          congrArg (fun m => m.hom a) (k.hom.naturality (Opposite.op iso_VW.inv))
        rw [hnat]
        have h_inv_hom : Opposite.op iso_VW.inv ≫ Opposite.op iso_VW.hom = 𝟙 V_op := by
          change Opposite.op (iso_VW.hom ≫ iso_VW.inv) = Opposite.op (𝟙 V)
          rw [iso_VW.hom_inv_id]
        change _ = (((E_eq.inverse.obj E₂).obj.map (Opposite.op iso_VW.inv) ≫
            (E_eq.inverse.obj E₂).obj.map (Opposite.op iso_VW.hom)).hom)
            ((k.hom.app V_op).hom a)
        rw [← (E_eq.inverse.obj E₂).obj.map_comp, h_inv_hom,
          (E_eq.inverse.obj E₂).obj.map_id]
        rfl
      rw [h_recover (E_eq.inverse.map f₁), h_recover (E_eq.inverse.map f₂), h_a']
    exact hGrothCover Y_et hY_tf hY_sep

  
  let η_inv_sh : ∀ M_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R),
      C_sh.obj (U.obj M_sh) ⟶ M_sh :=
    fun M_sh =>
      CategoryTheory.ObjectProperty.homMk
        { app := fun W =>
            letI : Module R ↥(subC (FgtMod.obj (M_sh.obj.obj W))) :=
              instModC (FgtMod.obj (M_sh.obj.obj W))
            ModuleCat.ofHom (mkRLin (subC (FgtMod.obj (M_sh.obj.obj W))).subtype)
          naturality := fun {_ _} _ => by
            apply ModuleCat.hom_ext
            apply LinearMap.ext
            intro x
            rfl }

  let mkDelta : ∀ (B_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      m • CategoryTheory.CategoryStruct.id B_sh = 0 →
      (B_sh ⟶ U.obj (C_sh.obj B_sh)) :=
    fun B_sh hAnn =>
      CategoryTheory.ObjectProperty.homMk
        { app := fun W =>
            AddCommGrpCat.ofHom
              ((AddMonoidHom.id ↑(B_sh.obj.obj W)).codRestrict
                (subC (B_sh.obj.obj W)) (fun x => by
                  change m • x = 0
                  have h1 := congrArg (fun k => (k.hom.app W).hom x) hAnn
                  exact h1))
          naturality := fun {_ _} _ => by
            ext x
            rfl }

  have hExtInj : ∀ (I_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R))
      [CategoryTheory.Injective I_sh]
      (S_ex : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})),
      S_ex.ShortExact → IsTF S_ex.X₃ →
      ∀ g₀ : S_ex.X₁ ⟶ U.obj I_sh, ∃ h : S_ex.X₂ ⟶ U.obj I_sh, S_ex.f ≫ h = g₀ := by
    intro I_sh _ S_ex hEx hTF g₀
    let B₁ := CategoryTheory.Limits.cokernel (m • 𝟙 S_ex.X₁)
    let p₁ := CategoryTheory.Limits.cokernel.π (m • 𝟙 S_ex.X₁)
    let B₂ := CategoryTheory.Limits.cokernel (m • 𝟙 S_ex.X₂)
    let p₂ := CategoryTheory.Limits.cokernel.π (m • 𝟙 S_ex.X₂)
    have hi_cond : (m • 𝟙 S_ex.X₁) ≫ (S_ex.f ≫ p₂) = 0 := by
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Preadditive.nsmul_comp,
        CategoryTheory.Category.id_comp, ← CategoryTheory.Category.comp_id S_ex.f,
        ← CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.comp_zero]
    let i_bar : B₁ ⟶ B₂ := CategoryTheory.Limits.cokernel.desc (m • 𝟙 S_ex.X₁) (S_ex.f ≫ p₂) hi_cond
    have hp₁_ibar : p₁ ≫ i_bar = S_ex.f ≫ p₂ :=
      CategoryTheory.Limits.cokernel.π_desc (m • 𝟙 S_ex.X₁) (S_ex.f ≫ p₂) hi_cond

    
    have : CategoryTheory.Mono S_ex.f := hEx.mono_f
    have hMono_ibar : CategoryTheory.Mono i_bar := by
      let := @CategoryTheory.Abelian.Pseudoelement.homToFun
      apply CategoryTheory.Abelian.Pseudoelement.mono_of_zero_of_map_zero
      intro a_bar ha_bar
      obtain ⟨a, rfl⟩ := CategoryTheory.Abelian.Pseudoelement.pseudo_surjective_of_epi p₁ a_bar
      have hp₂_fa : p₂ (S_ex.f a) = 0 := by
        rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply, ← hp₁_ibar,
          CategoryTheory.Abelian.Pseudoelement.comp_apply, ha_bar]
      obtain ⟨b, hb⟩ := CategoryTheory.Abelian.Pseudoelement.pseudo_exact_of_exact
        (CategoryTheory.ShortComplex.exact_cokernel (m • 𝟙 S_ex.X₂)) (S_ex.f a) hp₂_fa
      by_cases hm0 : m = 0
      · have hm_zero : (m • 𝟙 S_ex.X₂) = 0 := by rw [hm0, zero_nsmul]
        rw [hm_zero, CategoryTheory.Abelian.Pseudoelement.zero_apply] at hb
        have ha0 : a = 0 :=
          CategoryTheory.Abelian.Pseudoelement.zero_of_map_zero S_ex.f
            (CategoryTheory.Abelian.Pseudoelement.pseudo_injective_of_mono S_ex.f) a hb.symm
        rw [ha0, CategoryTheory.Abelian.Pseudoelement.apply_zero]
      · have hgb_m : (m • 𝟙 S_ex.X₃) (S_ex.g b) = 0 := by
          have hcomm_g : (m • 𝟙 S_ex.X₂) ≫ S_ex.g = S_ex.g ≫ (m • 𝟙 S_ex.X₃) := by
            rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
              CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
          rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply, ← hcomm_g,
            CategoryTheory.Abelian.Pseudoelement.comp_apply, hb,
            ← CategoryTheory.Abelian.Pseudoelement.comp_apply, S_ex.zero,
            CategoryTheory.Abelian.Pseudoelement.zero_apply]
        have : CategoryTheory.Mono (m • 𝟙 S_ex.X₃) := hTF m hm0
        have hgb : S_ex.g b = 0 :=
          CategoryTheory.Abelian.Pseudoelement.zero_of_map_zero (m • 𝟙 S_ex.X₃)
            (CategoryTheory.Abelian.Pseudoelement.pseudo_injective_of_mono (m • 𝟙 S_ex.X₃))
            (S_ex.g b) hgb_m
        obtain ⟨c, hc⟩ := CategoryTheory.Abelian.Pseudoelement.pseudo_exact_of_exact
          hEx.exact b hgb
        have hfc : S_ex.f ((m • 𝟙 S_ex.X₁) c) = S_ex.f a := by
          have hcomm_f : (m • 𝟙 S_ex.X₁) ≫ S_ex.f = S_ex.f ≫ (m • 𝟙 S_ex.X₂) := by
            rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
              CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
          rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply, hcomm_f,
            CategoryTheory.Abelian.Pseudoelement.comp_apply, hc, hb]
        have hmc : (m • 𝟙 S_ex.X₁) c = a :=
          CategoryTheory.Abelian.Pseudoelement.pseudo_injective_of_mono S_ex.f hfc
        rw [← hmc, ← CategoryTheory.Abelian.Pseudoelement.comp_apply,
          CategoryTheory.Limits.cokernel.condition,
          CategoryTheory.Abelian.Pseudoelement.zero_apply]

    have hAnn₁ : m • 𝟙 B₁ = 0 := by
      apply (cancel_epi p₁).mp
      rw [CategoryTheory.Limits.comp_zero, CategoryTheory.Preadditive.comp_nsmul,
        CategoryTheory.Category.comp_id, ← CategoryTheory.Category.id_comp p₁,
        ← CategoryTheory.Preadditive.nsmul_comp]
      exact CategoryTheory.Limits.cokernel.condition (m • 𝟙 S_ex.X₁)
    have hAnn₂ : m • 𝟙 B₂ = 0 := by
      apply (cancel_epi p₂).mp
      rw [CategoryTheory.Limits.comp_zero, CategoryTheory.Preadditive.comp_nsmul,
        CategoryTheory.Category.comp_id, ← CategoryTheory.Category.id_comp p₂,
        ← CategoryTheory.Preadditive.nsmul_comp]
      exact CategoryTheory.Limits.cokernel.condition (m • 𝟙 S_ex.X₂)
    have hAnn_UI : m • 𝟙 (U.obj I_sh) = 0 := by
      apply CategoryTheory.ObjectProperty.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext W
      apply AddCommGrpCat.hom_ext
      ext x
      exact @hR_nsmul_zero ↑(I_sh.obj.obj W) _ _ x
    have hg₀_cond : (m • 𝟙 S_ex.X₁) ≫ g₀ = 0 := by
      rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.comp_id g₀, ← CategoryTheory.Preadditive.comp_nsmul,
        hAnn_UI, CategoryTheory.Limits.comp_zero]
    let g_bar₀ : B₁ ⟶ U.obj I_sh :=
      CategoryTheory.Limits.cokernel.desc (m • 𝟙 S_ex.X₁) g₀ hg₀_cond
    have hp₁_gbar : p₁ ≫ g_bar₀ = g₀ :=
      CategoryTheory.Limits.cokernel.π_desc (m • 𝟙 S_ex.X₁) g₀ hg₀_cond

    have : CategoryTheory.Mono i_bar := hMono_ibar
    have : CategoryTheory.Mono (C_sh.map i_bar) := C_sh.map_mono i_bar
    let g_tilde₀ : C_sh.obj B₁ ⟶ I_sh := C_sh.map g_bar₀ ≫ η_inv_sh I_sh
    let h_tilde : C_sh.obj B₂ ⟶ I_sh :=
      CategoryTheory.Injective.factorThru g_tilde₀ (C_sh.map i_bar)
    have hh_tilde : C_sh.map i_bar ≫ h_tilde = g_tilde₀ :=
      CategoryTheory.Injective.comp_factorThru g_tilde₀ (C_sh.map i_bar)

    let δ₁ := mkDelta B₁ hAnn₁
    let δ₂ := mkDelta B₂ hAnn₂
    have hδ_nat : i_bar ≫ δ₂ = δ₁ ≫ U.map (C_sh.map i_bar) := by
      apply CategoryTheory.ObjectProperty.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext W
      apply AddCommGrpCat.hom_ext
      ext x
      rfl
    have hδ_gbar : δ₁ ≫ U.map g_tilde₀ = g_bar₀ := by
      apply CategoryTheory.ObjectProperty.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext W
      apply AddCommGrpCat.hom_ext
      ext x
      rfl
    let h : S_ex.X₂ ⟶ U.obj I_sh := p₂ ≫ δ₂ ≫ U.map h_tilde
    refine ⟨h, ?_⟩
    calc
      S_ex.f ≫ h = (S_ex.f ≫ p₂) ≫ δ₂ ≫ U.map h_tilde :=
        (CategoryTheory.Category.assoc S_ex.f p₂ _).symm
      _ = (p₁ ≫ i_bar) ≫ δ₂ ≫ U.map h_tilde := by rw [← hp₁_ibar]
      _ = p₁ ≫ (i_bar ≫ δ₂) ≫ U.map h_tilde := by
        simp only [CategoryTheory.Category.assoc]
      _ = p₁ ≫ δ₁ ≫ U.map (C_sh.map i_bar ≫ h_tilde) := by
        rw [hδ_nat, CategoryTheory.Category.assoc, ← U.map_comp]
      _ = p₁ ≫ (δ₁ ≫ U.map g_tilde₀) := by rw [hh_tilde]
      _ = g₀ := by rw [hδ_gbar, hp₁_gbar]

  
  have hSubTF : ∀ {K₁ P_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (j : K₁ ⟶ P_sh) [CategoryTheory.Mono j], IsTF P_sh → IsTF K₁ := by
    intro K₁ P_sh j _ hP n hn
    have hcomm : (n • 𝟙 K₁) ≫ j = j ≫ (n • 𝟙 P_sh) := by
      rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
        CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
    have : CategoryTheory.Mono (n • 𝟙 P_sh) := hP n hn
    have : CategoryTheory.Mono ((n • 𝟙 K₁) ≫ j) := by
      rw [hcomm]
      exact CategoryTheory.mono_comp j (n • 𝟙 P_sh)
    exact CategoryTheory.mono_of_mono (n • 𝟙 K₁) j

  have hEfface : ∀ (I_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R))
      [CategoryTheory.Injective I_sh] (p : ℕ)
      (K_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (e : CategoryTheory.Abelian.Ext.{u} K_sh (U.obj I_sh) (p + 1)),
      ∃ (P_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (π : P_sh ⟶ K_sh),
        CategoryTheory.Epi π ∧ IsTF P_sh ∧
        (CategoryTheory.Abelian.Ext.mk₀ π).comp e (Nat.zero_add (p + 1)) = 0 := by
    intro I_sh _ p K_sh e
    let R_I := CategoryTheory.InjectiveResolution.of (U.obj I_sh)
    obtain ⟨f, hf, rfl⟩ := R_I.extMk_surjective e (p + 2) rfl
    let S_p := CategoryTheory.ShortComplex.mk
      (R_I.cocomplex.d p (p + 1)) (R_I.cocomplex.d (p + 1) (p + 2))
      (R_I.cocomplex.d_comp_d p (p + 1) (p + 2))
    have hEx_p : S_p.Exact := R_I.exact_succ p
    have : CategoryTheory.Epi S_p.toCycles :=
      (CategoryTheory.ShortComplex.exact_iff_epi_toCycles S_p).mp hEx_p
    let f_cyc : K_sh ⟶ S_p.cycles := S_p.liftCycles f hf
    let PB := CategoryTheory.Limits.pullback S_p.toCycles f_cyc
    let pr₁ : PB ⟶ S_p.X₁ := CategoryTheory.Limits.pullback.fst S_p.toCycles f_cyc
    let pr₂ : PB ⟶ K_sh := CategoryTheory.Limits.pullback.snd S_p.toCycles f_cyc
    have : CategoryTheory.Epi pr₂ :=
      CategoryTheory.Abelian.epi_pullback_of_epi_f S_p.toCycles f_cyc
    obtain ⟨P_sh, q_P, hEpi_q, hTF_P⟩ := hCoverTF PB
    let π : P_sh ⟶ K_sh := q_P ≫ pr₂
    let g : P_sh ⟶ R_I.cocomplex.X p := q_P ≫ pr₁
    have : CategoryTheory.Epi π := CategoryTheory.epi_comp q_P pr₂
    have hg_eq : g ≫ R_I.cocomplex.d p (p + 1) = π ≫ f := by
      dsimp [g, π]
      have h1 : pr₁ ≫ S_p.f = pr₂ ≫ f := by
        rw [← S_p.toCycles_i, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
          S_p.liftCycles_i f hf]
      calc
        (q_P ≫ pr₁) ≫ S_p.f = q_P ≫ (pr₁ ≫ S_p.f) := CategoryTheory.Category.assoc _ _ _
        _ = q_P ≫ (pr₂ ≫ f) := by rw [h1]
        _ = (q_P ≫ pr₂) ≫ f := (CategoryTheory.Category.assoc _ _ _).symm
    refine ⟨P_sh, π, inferInstance, hTF_P, ?_⟩
    rw [R_I.mk₀_comp_extMk f (p + 2) rfl hf π]
    exact (R_I.extMk_eq_zero_iff (π ≫ f) (p + 2) rfl _ p rfl).mpr ⟨g, hg_eq⟩

  have hAcyclic : ∀ (p : ℕ) (K_sh : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      IsTF K_sh →
      ∀ (I_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R))
        [CategoryTheory.Injective I_sh]
        (e : CategoryTheory.Abelian.Ext.{u} K_sh (U.obj I_sh) (p + 1)),
        e = 0 := by
    intro p
    induction p with
    | zero =>
      intro K_sh hTF_K I_sh _ e
      obtain ⟨P_sh, π, hEpi_π, hTF_P, he_zero⟩ := hEfface I_sh 0 K_sh e
      let : CategoryTheory.Epi π := hEpi_π
      let S_π := CategoryTheory.ShortComplex.mk
        (CategoryTheory.Limits.kernel.ι π) π (CategoryTheory.Limits.kernel.condition π)
      have hSE_π : S_π.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_kernel π }
      obtain ⟨x₀, hx₀⟩ := CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃
        hSE_π (U.obj I_sh) e he_zero (Nat.add_zero 1)
      obtain ⟨g₀, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective S_π.X₁ (U.obj I_sh)).2 x₀
      obtain ⟨h_ext, hh_ext⟩ := hExtInj I_sh S_π hSE_π hTF_K g₀
      rw [← hx₀, ← hh_ext, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc hSE_π.extClass _ _
          (Nat.add_zero 1) (Nat.add_zero 0) (Nat.add_zero 1),
        hSE_π.extClass_comp, CategoryTheory.Abelian.Ext.zero_comp]
    | succ p ih =>
      intro K_sh _ I_sh _ e
      obtain ⟨P_sh, π, hEpi_π, hTF_P, he_zero⟩ := hEfface I_sh (p + 1) K_sh e
      let : CategoryTheory.Epi π := hEpi_π
      let S_π := CategoryTheory.ShortComplex.mk
        (CategoryTheory.Limits.kernel.ι π) π (CategoryTheory.Limits.kernel.condition π)
      have hSE_π : S_π.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_kernel π }
      have hTF_ker : IsTF S_π.X₁ := hSubTF (CategoryTheory.Limits.kernel.ι π) hTF_P
      obtain ⟨x₁, hx₁⟩ := CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃
        hSE_π (U.obj I_sh) e he_zero (Nat.one_add (p + 1))
      rw [← hx₁, ih S_π.X₁ hTF_ker I_sh x₁, CategoryTheory.Abelian.Ext.comp_zero]

  have hGenBij : ∀ (q : ℕ)
      (F_sh : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)),
      Function.Bijective (genMap F_sh q) := by
    intro q
    induction q with
    | zero => exact hBase0
    | succ q ih =>
      intro F_sh
      let I_sh := CategoryTheory.Injective.under F_sh
      let : CategoryTheory.Injective I_sh := CategoryTheory.Injective.injective_under F_sh
      let i_F : F_sh ⟶ I_sh := CategoryTheory.Injective.ι F_sh
      let : CategoryTheory.Mono i_F := CategoryTheory.Injective.ι_mono F_sh
      let Q_sh := CategoryTheory.Limits.cokernel i_F
      let p_F : I_sh ⟶ Q_sh := CategoryTheory.Limits.cokernel.π i_F
      let : CategoryTheory.Epi p_F := CategoryTheory.Limits.coequalizer.π_epi
      let S_F := CategoryTheory.ShortComplex.mk i_F p_F
        (CategoryTheory.Limits.cokernel.condition i_F)
      have hSE_F : S_F.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_cokernel i_F }
      have hUSE_F : (S_F.map U).ShortExact := hSE_F.map_of_exact U

      have hVan_mod : ∀ z : CategoryTheory.Abelian.Ext.{u} oneR I_sh (q + 1), z = 0 := by
        intro z
        have : CategoryTheory.HasInjectiveDimensionLT I_sh 1 := inferInstance
        exact (CategoryTheory.hasInjectiveDimensionLT_iff I_sh 1).mp inferInstance
          (q + 1) (Nat.le_add_left 1 q) z
      have hVan_ab : ∀ w : CategoryTheory.Abelian.Ext.{u} Fℤ (U.obj I_sh) (q + 1), w = 0 :=
        fun w => hAcyclic q Fℤ hInitTF I_sh w

      have hGen_postcomp : ∀ {M₁ M₂ : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)}
          (φ : M₁ ⟶ M₂) (k : ℕ) (x : CategoryTheory.Abelian.Ext.{u} oneR M₁ k),
          genMap M₂ k (x.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero k)) =
            (genMap M₁ k x).comp (CategoryTheory.Abelian.Ext.mk₀ (U.map φ)) (Nat.add_zero k) := by
        intro M₁ M₂ φ k x
        dsimp [genMap]
        change (CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U
              (x.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero k)))
            (Nat.zero_add k) =
          ((CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U x) (Nat.zero_add k)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (U.map φ)) (Nat.add_zero k)
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add k) (Nat.add_zero k)
            (by omega)]

      have hGen_extClass : ∀ (y : CategoryTheory.Abelian.Ext.{u} oneR Q_sh q),
          genMap F_sh (q + 1) (y.comp hSE_F.extClass rfl) =
            (genMap Q_sh q y).comp hUSE_F.extClass rfl := by
        intro y
        dsimp [genMap]
        change (CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U (y.comp hSE_F.extClass rfl))
            (Nat.zero_add (q + 1)) =
          ((CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U y) (Nat.zero_add q)).comp
            hUSE_F.extClass rfl
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass U hSE_F,
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add q) rfl (by omega)]

      refine ⟨?_, ?_⟩
      · 
        intro z₁ z₂ hz
        suffices h0 : ∀ z : CategoryTheory.Abelian.Ext.{u} oneR F_sh (q + 1),
            genMap F_sh (q + 1) z = 0 → z = 0 by
          have hsub : genMap F_sh (q + 1) (z₁ - z₂) = 0 := by
            rw [map_sub, hz, sub_self]
          exact sub_eq_zero.mp (h0 (z₁ - z₂) hsub)
        intro z hz0
        obtain ⟨y, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
          oneR hSE_F z (hVan_mod _) rfl
        have hy_ext : (genMap Q_sh q y).comp hUSE_F.extClass rfl = 0 := by
          rw [← hGen_extClass y, hz0]
        obtain ⟨x', hx'⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
          Fℤ hUSE_F (genMap Q_sh q y) rfl hy_ext
        obtain ⟨x, rfl⟩ := (ih I_sh).2 x'
        have hy_eq : y = x.comp (CategoryTheory.Abelian.Ext.mk₀ p_F) (Nat.add_zero q) := by
          apply (ih Q_sh).1
          rw [hGen_postcomp p_F q x]
          exact hx'.symm
        rw [hy_eq, CategoryTheory.Abelian.Ext.comp_assoc x _ _ (Nat.add_zero q) (Nat.zero_add 1) rfl,
          hSE_F.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      · 
        intro w
        obtain ⟨y', rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
          Fℤ hUSE_F w (hVan_ab _) rfl
        obtain ⟨y, rfl⟩ := (ih Q_sh).2 y'
        exact ⟨y.comp hSE_F.extClass rfl, hGen_extClass y⟩

  
  let θ_top : weilCupPDModH S m (2 * d) →+ weilEtaleTorsionH S m (2 * d) :=
    ((CategoryTheory.Abelian.Ext.mk₀ βM).postcomp Fℤ (Nat.add_zero (2 * d))).comp
      (genMap oneR (2 * d))
  let τ : weilCupPDModH S m (2 * d) →+ ZMod m := tr_m.comp θ_top
  let Φ : ∀ (W : S.Etale) (q : ℕ),
      weilCupPDLocalModH S m W q →+ weilCupPDTraceLocalTorsionH S m W q :=
    fun W q =>
      ((CategoryTheory.Abelian.Ext.mk₀ (β_loc W)).postcomp Fℤ (Nat.add_zero q)).comp
        (genMap (weilCupPDLocalFreeSheaf S m W) q)

  have hΦ_bij : ∀ (W : S.Etale) (q : ℕ), Function.Bijective (Φ W q) := by
    intro W q
    have hPostBij : Function.Bijective
        ((CategoryTheory.Abelian.Ext.mk₀ (β_loc W)).postcomp Fℤ (Nat.add_zero q)) := by
      rw [Function.bijective_iff_has_inverse]
      refine ⟨(CategoryTheory.Abelian.Ext.mk₀ (α_loc W)).postcomp Fℤ (Nat.add_zero q),
        fun z => ?_, fun w => ?_⟩
      · change (z.comp (CategoryTheory.Abelian.Ext.mk₀ (β_loc W)) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (α_loc W)) (Nat.add_zero q) = z
        rw [CategoryTheory.Abelian.Ext.comp_assoc z _ _
          (Nat.add_zero q) (Nat.zero_add 0) (Nat.add_zero q),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, (hInv_loc W).2,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
      · change (w.comp (CategoryTheory.Abelian.Ext.mk₀ (α_loc W)) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (β_loc W)) (Nat.add_zero q) = w
        rw [CategoryTheory.Abelian.Ext.comp_assoc w _ _
          (Nat.add_zero q) (Nat.zero_add 0) (Nat.add_zero q),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, (hInv_loc W).1,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
    exact hPostBij.comp (hGenBij q (weilCupPDLocalFreeSheaf S m W))

  have hΦ_map : ∀ {U' U_et : S.Etale} (v : U' ⟶ U_et) (q : ℕ)
      (z : weilCupPDLocalModH S m U' q),
      Φ U_et q (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDLocalFreeMap S m v))
        (Nat.add_zero q)) =
        weilCupPDTraceLocalTorsionMapH S m v q (Φ U' q z) := by
    intro U' U_et v q z
    change (((CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor U
          (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDLocalFreeMap S m v)) (Nat.add_zero q)))
        (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (β_loc U_et)) (Nat.add_zero q)) =
      (((CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor U z) (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (β_loc U')) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDTraceLocalTorsionMap S m v)) (Nat.add_zero q)
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ηℤ) _ _
        (Nat.zero_add q) (Nat.add_zero q) (by omega),
      CategoryTheory.Abelian.Ext.comp_assoc _ _ (CategoryTheory.Abelian.Ext.mk₀ (β_loc U_et))
        (Nat.add_zero q) (Nat.zero_add 0) (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.comp_assoc _ (CategoryTheory.Abelian.Ext.mk₀ (β_loc U')) _
        (Nat.add_zero q) (Nat.zero_add 0) (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      hNatMap v,
      ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ηℤ) _ _
        (Nat.zero_add q) (Nat.add_zero q) (by omega)]

  have hΦ_counit : ∀ (W : S.Etale) (z : weilCupPDLocalModH S m W (2 * d)),
      θ_top (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDLocalCounit S m W))
        (Nat.add_zero (2 * d))) =
        weilCupPDTraceLocalTorsionCounitH S m W (2 * d) (Φ W (2 * d) z) := by
    intro W z
    change (((CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor U
          (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDLocalCounit S m W))
            (Nat.add_zero (2 * d))))
        (Nat.zero_add (2 * d))).comp
        (CategoryTheory.Abelian.Ext.mk₀ βM) (Nat.add_zero (2 * d))) =
      (((CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor U z) (Nat.zero_add (2 * d))).comp
        (CategoryTheory.Abelian.Ext.mk₀ (β_loc W)) (Nat.add_zero (2 * d))).comp
        (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDTraceLocalTorsionCounit S m W))
        (Nat.add_zero (2 * d))
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ηℤ) _ _
        (Nat.zero_add (2 * d)) (Nat.add_zero (2 * d)) (by omega),
      CategoryTheory.Abelian.Ext.comp_assoc _ _ (CategoryTheory.Abelian.Ext.mk₀ βM)
        (Nat.add_zero (2 * d)) (Nat.zero_add 0) (Nat.add_zero (2 * d)),
      CategoryTheory.Abelian.Ext.comp_assoc _ (CategoryTheory.Abelian.Ext.mk₀ (β_loc W)) _
        (Nat.add_zero (2 * d)) (Nat.zero_add 0) (Nat.add_zero (2 * d)),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      hNatCounit W,
      ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ηℤ) _ _
        (Nat.zero_add (2 * d)) (Nat.add_zero (2 * d)) (by omega)]

  refine ⟨τ, ?_⟩
  unfold WeilCupPDHasLocalEffacement
  dsimp only
  intro x U_et γ hγ
  obtain ⟨U', v, γ', hγ'₁, hγ'₂, hVanTors, hBijTors⟩ := hTors x U_et γ hγ
  refine ⟨U', v, γ', hγ'₁, hγ'₂, ?_, ?_⟩
  · intro q hq z
    apply (hΦ_bij U_et q).1
    rw [hΦ_map v q z, hVanTors q hq (Φ U' q z), map_zero]
  · have hfun_eq : (fun z : weilCupPDLocalModH S m U' (2 * d) =>
        τ (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDLocalCounit S m U'))
          (Nat.add_zero (2 * d)))) =
      (fun w : weilCupPDTraceLocalTorsionH S m U' (2 * d) =>
        tr_m (weilCupPDTraceLocalTorsionCounitH S m U' (2 * d) w)) ∘ (Φ U' (2 * d)) := by
      funext z
      dsimp [τ]
      rw [hΦ_counit U' z]
    rw [hfun_eq]
    exact hBijTors.comp (hΦ_bij U' (2 * d))

theorem weil_cupPD_trace_pinned_compact_support_roof_transfer (k : Type u) [Field k] [IsAlgClosed k]
    (n : ℕ) (hn : 1 ≤ n) (hUnit : IsUnit (n : k)) :
    ∃ Ψ : WeilCupPDTraceRoofSystem k n,
      WeilCupPDTraceIsPinnedRoof k n Ψ :=
by
  classical
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  obtain ⟨hc_all, hr_all, hSiteExact, hConstIndep, hConstIso, hFreePull,
    hZeroStalk, hIsoStalk, hClopenPkg, hCompAlpha, hCovAlpha⟩ :=
    weil_etale_pinned_clopen_section_and_stalk_criteria.{u}
  letI : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂),
      (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology :=
    @hc_all
  letI : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂),
      ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint :=
    @hr_all
  obtain ⟨hR0Iso, hBockstein, hLerayPkg, hPullComp⟩ :=
    weil_etale_bockstein_and_degenerate_leray_ext_calculus.{u}

  
  
  
  have hEquiv_comp : ∀ {S : AlgebraicGeometry.Scheme.{u}} {W : S.Etale} {M : AddCommGrpCat.{u}}
      {G H : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (α : CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology W M ⟶ G) (g : G ⟶ H),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) := by
    intro S W M G H α g
    let α' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda W M) ⟶ G := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
            AddCommGrpCat.{u}).homEquiv _ H) (α' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
              AddCommGrpCat.{u}).homEquiv _ G) α' ≫
              (CategoryTheory.sheafToPresheaf S.smallEtaleTopology
                AddCommGrpCat.{u}).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  have hEquiv_add : ∀ {S : AlgebraicGeometry.Scheme.{u}} {W : S.Etale} {M : AddCommGrpCat.{u}}
      {F : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (α₁ α₂ : CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology W M ⟶ F),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α₁ + α₂) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α₁ +
          CategoryTheory.Sheaf.freeYonedaHomEquiv α₂ := by
    intro S W M F α₁ α₂
    have h1 := hEquiv_comp (𝟙 (CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology W M)) (α₁ + α₂)
    have h2 := hEquiv_comp (𝟙 (CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology W M)) α₁
    have h3 := hEquiv_comp (𝟙 (CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology W M)) α₂
    rw [CategoryTheory.Category.id_comp] at h1 h2 h3
    have happ : (α₁ + α₂).hom.app (Opposite.op W) =
        α₁.hom.app (Opposite.op W) + α₂.hom.app (Opposite.op W) := rfl
    rw [h1, happ, CategoryTheory.Preadditive.comp_add, ← h2, ← h3]

  let locCoeffMap : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) {m₁ m₂ : ℕ}
      (φ : ZMod m₁ →+ ZMod m₂),
      Quiver.Hom (weilEtaleLocalTorsionSheaf S m₁ U) (weilEtaleLocalTorsionSheaf S m₂ U) :=
    fun S U {m₁ m₂} φ =>
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
        (CategoryTheory.CategoryStruct.comp
          (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ))
          (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m₂ U))))

  have hLocCoeff_id : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) (m : ℕ),
      locCoeffMap S U (AddMonoidHom.id (ZMod m)) =
        CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m U) := by
    intro S U m
    dsimp only [locCoeffMap]
    have hof_id : AddCommGrpCat.ofHom (AddMonoidHom.id (ZMod m)) =
        CategoryTheory.CategoryStruct.id (AddCommGrpCat.of (ZMod m)) := by
      ext x
      rfl
    rw [hof_id, CategoryTheory.Functor.map_id, CategoryTheory.Category.id_comp,
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm_apply_apply]

  have hLocCoeff_comp : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) {m₁ m₂ m₃ : ℕ}
      (φ : ZMod m₁ →+ ZMod m₂) (ψ : ZMod m₂ →+ ZMod m₃),
      locCoeffMap S U (ψ.comp φ) =
        CategoryTheory.CategoryStruct.comp (locCoeffMap S U φ) (locCoeffMap S U ψ) := by
    intro S U m₁ m₂ m₃ φ ψ
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    have hof_comp : AddCommGrpCat.ofHom (ψ.comp φ) =
        CategoryTheory.CategoryStruct.comp (AddCommGrpCat.ofHom φ) (AddCommGrpCat.ofHom ψ) := by
      ext x
      rfl
    rw [hEquiv_comp (locCoeffMap S U φ) (locCoeffMap S U ψ)]
    have hφ : CategoryTheory.Sheaf.freeYonedaHomEquiv (locCoeffMap S U φ) =
        CategoryTheory.CategoryStruct.comp
          (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ))
          (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m₂ U))) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    have hψ : CategoryTheory.Sheaf.freeYonedaHomEquiv (locCoeffMap S U ψ) =
        CategoryTheory.CategoryStruct.comp
          (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom ψ))
          (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m₃ U))) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    have hψ_app : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m₂ U)))
          ((locCoeffMap S U ψ).hom.app (Opposite.op U)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (locCoeffMap S U ψ) := by
      rw [← hEquiv_comp, CategoryTheory.Category.id_comp]
    have hψφ : CategoryTheory.Sheaf.freeYonedaHomEquiv (locCoeffMap S U (ψ.comp φ)) =
        CategoryTheory.CategoryStruct.comp
          (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (ψ.comp φ)))
          (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m₃ U))) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    rw [hψφ, hof_comp, CategoryTheory.Functor.map_comp, CategoryTheory.Category.assoc,
      hφ, CategoryTheory.Category.assoc, hψ_app, hψ]

  have hLocCoeff_add : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) {m₁ m₂ : ℕ}
      (φ₁ φ₂ : ZMod m₁ →+ ZMod m₂),
      locCoeffMap S U (φ₁ + φ₂) = locCoeffMap S U φ₁ + locCoeffMap S U φ₂ := by
    intro S U m₁ m₂ φ₁ φ₂
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    have hulift_add : AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (φ₁ + φ₂)) =
        AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ₁) +
          AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ₂) := by
      ext ⟨x⟩
      rfl
    rw [hEquiv_add]
    dsimp only [locCoeffMap]
    rw [CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply,
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply,
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply,
      hulift_add, CategoryTheory.Preadditive.add_comp]

  have hLocCoeff_zero : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) (m₁ m₂ : ℕ),
      locCoeffMap S U (0 : ZMod m₁ →+ ZMod m₂) = 0 := by
    intro S U m₁ m₂
    have h2 : locCoeffMap S U (0 : ZMod m₁ →+ ZMod m₂) + locCoeffMap S U 0 =
        locCoeffMap S U (0 : ZMod m₁ →+ ZMod m₂) + 0 := by
      rw [← hLocCoeff_add, add_zero, add_zero]
    exact add_left_cancel h2

  have hLocTors_smul : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) (m : ℕ),
      m • CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m U) = 0 := by
    intro S U m
    let locEndHom : (ZMod m →+ ZMod m) →+
        Quiver.Hom (weilEtaleLocalTorsionSheaf S m U) (weilEtaleLocalTorsionSheaf S m U) :=
      { toFun := locCoeffMap S U
        map_zero' := hLocCoeff_zero S U m m
        map_add' := hLocCoeff_add S U }
    have hid_eq : CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m U) =
        locEndHom (AddMonoidHom.id (ZMod m)) := (hLocCoeff_id S U m).symm
    have hsmul_zero : m • AddMonoidHom.id (ZMod m) = 0 := by
      ext x
      change m • x = 0
      rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    rw [hid_eq, ← map_nsmul, hsmul_zero, map_zero]

  have hLocTors_one : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale),
      CategoryTheory.Limits.IsZero (weilEtaleLocalTorsionSheaf S 1 U) := by
    intro S U
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    change CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S 1 U) = 0
    rw [← hLocCoeff_id S U 1]
    have hid1 : AddMonoidHom.id (ZMod 1) = 0 := by
      ext x
      exact Subsingleton.elim _ _
    rw [hid1, hLocCoeff_zero]

  have hCohomAdd : ∀ (X : AlgebraicGeometry.Scheme.{u}) (q : ℕ),
      (CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q).Additive := by
    intro X q
    refine ⟨fun {F₁ F₂} f g => ?_⟩
    ext W x
    let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
      (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
    let Sh_X := CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}
    let Z_W : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
      Opposite.unop ((CategoryTheory.yoneda ⋙ (Free_PSh ⋙ Sh_X)).op.obj W)
    have hmap_eq : ∀ {G₁ G₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        (u : G₁ ⟶ G₂),
        (((CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q).map u).app W) =
          AddCommGrpCat.ofHom
            ((CategoryTheory.Abelian.Ext.mk₀ u).postcomp Z_W (Nat.add_zero q)) :=
      fun u => CategoryTheory.Abelian.extFunctorObj_map Z_W q u
    rw [hmap_eq (f + g), CategoryTheory.NatTrans.app_add, hmap_eq f, hmap_eq g]
    let x_ext : CategoryTheory.Abelian.Ext Z_W F₁ q := x
    change x_ext.comp (CategoryTheory.Abelian.Ext.mk₀ (f + g)) (Nat.add_zero q) =
      x_ext.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero q) +
        x_ext.comp (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.add_zero q)
    have hmk0_add : CategoryTheory.Abelian.Ext.mk₀ (f + g) =
        CategoryTheory.Abelian.Ext.mk₀ f + CategoryTheory.Abelian.Ext.mk₀ g :=
      CategoryTheory.Abelian.Ext.addEquiv₀.symm.map_add f g
    rw [hmk0_add, CategoryTheory.Abelian.Ext.comp_add]

  have hHDIZeroOfZero : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom X Y) (q : ℕ)
      (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.Limits.IsZero F →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π q F) := by
    intro X Y π q F hF
    letI : (CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q).Additive :=
      hCohomAdd X q
    let W_B := (CategoryTheory.Functor.whiskeringLeft (Opposite Y.Etale) (Opposite X.Etale)
      AddCommGrpCat.{u}).obj (weilEtaleSitePullback π).op
    let R_fun := (CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q).comp
      (W_B.comp (CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}))
    letI : R_fun.Additive := inferInstance
    change CategoryTheory.Limits.IsZero (R_fun.obj F)
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero, ← R_fun.map_id,
      hF.eq_of_src (𝟙 F) 0, R_fun.map_zero]

  have hHDIZeroOfSum : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom X Y) (q : ℕ)
      {F F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (f₁ : F ⟶ F₁) (g₁ : F₁ ⟶ F) (f₂ : F ⟶ F₂) (g₂ : F₂ ⟶ F),
      f₁ ≫ g₁ + f₂ ≫ g₂ = 𝟙 F →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π q F₁) →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π q F₂) →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π q F) := by
    intro X Y π q F F₁ F₂ f₁ g₁ f₂ g₂ hsum hZ₁ hZ₂
    letI : (CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q).Additive :=
      hCohomAdd X q
    let W_B := (CategoryTheory.Functor.whiskeringLeft (Opposite Y.Etale) (Opposite X.Etale)
      AddCommGrpCat.{u}).obj (weilEtaleSitePullback π).op
    let R_fun := (CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q).comp
      (W_B.comp (CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}))
    letI : R_fun.Additive := inferInstance
    change CategoryTheory.Limits.IsZero (R_fun.obj F)
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero, ← R_fun.map_id, ← hsum,
      R_fun.map_add, R_fun.map_comp, R_fun.map_comp]
    have hz1 : R_fun.map f₁ = 0 := hZ₁.eq_of_tgt _ 0
    have hz2 : R_fun.map f₂ = 0 := hZ₂.eq_of_tgt _ 0
    rw [hz1, hz2, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.zero_comp, add_zero]

  
  
  
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let πℤ_std : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom X Y),
      Quiver.Hom
        (((weilEtaleSitePullback π).sheafPullback AddCommGrpCat.{u}
          Y.smallEtaleTopology X.smallEtaleTopology).obj
          ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ))
        ((CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ) :=
    fun {X Y} π =>
      weilEtaleConstPullbackHom π
        (weilEtaleIdTerminalIsTerminal X) (weilEtaleIdTerminalIsTerminal Y) Aℤ
  let ιℤ_std : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom X Y),
      Quiver.Hom
        ((CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
        (((weilEtaleSitePullback π).sheafPullback AddCommGrpCat.{u}
          Y.smallEtaleTopology X.smallEtaleTopology).obj
          ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)) :=
    fun {X Y} π =>
      @CategoryTheory.inv _ _ _ _ (πℤ_std π)
        (hConstIso π (weilEtaleIdTerminalIsTerminal X) (weilEtaleIdTerminalIsTerminal Y) Aℤ)
  have hιπ_std : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom X Y),
      CategoryTheory.CategoryStruct.comp (ιℤ_std π) (πℤ_std π) =
        CategoryTheory.CategoryStruct.id _ :=
    fun {X Y} π =>
      @CategoryTheory.IsIso.inv_hom_id _ _ _ _ (πℤ_std π)
        (hConstIso π (weilEtaleIdTerminalIsTerminal X) (weilEtaleIdTerminalIsTerminal Y) Aℤ)
  have hπι_std : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom X Y),
      CategoryTheory.CategoryStruct.comp (πℤ_std π) (ιℤ_std π) =
        CategoryTheory.CategoryStruct.id _ :=
    fun {X Y} π =>
      @CategoryTheory.IsIso.hom_inv_id _ _ _ _ (πℤ_std π)
        (hConstIso π (weilEtaleIdTerminalIsTerminal X) (weilEtaleIdTerminalIsTerminal Y) Aℤ)

  let pullH_std : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom X Y)
      {G_Y : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
      {G_X : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (α : Quiver.Hom G_Y
        (((weilEtaleSitePullback π).sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology X.smallEtaleTopology).obj G_X))
      (q : ℕ), G_Y.H q →+ G_X.H q :=
    fun {X Y} π {G_Y G_X} α q =>
      let B_π := weilEtaleSitePullback π
      let pb_π := B_π.sheafPullback AddCommGrpCat.{u} Y.smallEtaleTopology X.smallEtaleTopology
      let adj_π := B_π.sheafAdjunctionContinuous AddCommGrpCat.{u}
        Y.smallEtaleTopology X.smallEtaleTopology
      let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      letI : pb_π.Additive := (hSiteExact π).1
      letI : CategoryTheory.Limits.PreservesFiniteLimits pb_π := (hSiteExact π).2.2.1
      letI : CategoryTheory.Limits.PreservesFiniteColimits pb_π := (hSiteExact π).2.2.2
      AddMonoidHom.mk'
        (fun z =>
          (CategoryTheory.Abelian.Ext.mk₀ ((adj_π.homEquiv G_Y G_X).symm α)).postcomp
            Fℤ_X (Nat.add_zero q)
            ((CategoryTheory.Abelian.Ext.mk₀ (ιℤ_std π)).comp
              ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_π _ _ _ _ _ Fℤ_Y G_Y q) z)
              (Nat.zero_add q)))
        (fun z₁ z₂ => by
          rw [map_add, CategoryTheory.Abelian.Ext.comp_add, map_add])

  have hSingleLeg : ∀ (W_bar Y : CategoryTheory.Over S_k)
      [AlgebraicGeometry.IsProper W_bar.hom] [AlgebraicGeometry.IsProper Y.hom]
      (π : Quiver.Hom W_bar.left Y.left)
      (U_W : W_bar.left.Etale) (U_Y : Y.left.Etale)
      [AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).left]
      (e : CategoryTheory.Iso
        ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).left
        ((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U_Y).left),
      CategoryTheory.CategoryStruct.comp π Y.hom = W_bar.hom →
      CategoryTheory.CategoryStruct.comp
          (((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).hom) π =
        CategoryTheory.CategoryStruct.comp e.hom
          (((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U_Y).hom) →
      let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget W_bar.left
      let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget Y.left
      let B_π := weilEtaleSitePullback π
      let pf_π := B_π.sheafPushforwardContinuous AddCommGrpCat.{u}
        Y.left.smallEtaleTopology W_bar.left.smallEtaleTopology
      let p_fst : Quiver.Hom ((Fgt_W.obj (B_π.obj U_Y)).left) ((Fgt_Y.obj U_Y).left) :=
        CategoryTheory.Limits.pullback.fst ((Fgt_Y.obj U_Y).hom) π
      ∃ (σ_e : Quiver.Hom U_W (B_π.obj U_Y))
        (α_n : Quiver.Hom (weilEtaleLocalTorsionSheaf Y.left n U_Y)
          (pf_π.obj (weilEtaleLocalTorsionSheaf W_bar.left n U_W))),
        CategoryTheory.CategoryStruct.comp ((Fgt_W.map σ_e).left) p_fst = e.hom ∧
        (∀ σ'_e : Quiver.Hom U_W (B_π.obj U_Y),
          CategoryTheory.CategoryStruct.comp ((Fgt_W.map σ'_e).left) p_fst = e.hom →
          σ'_e = σ_e) ∧
        (let L_W := weilEtaleLocalTorsionSheaf W_bar.left n U_W
         let ξ := CategoryTheory.Sheaf.freeYonedaHomEquiv α_n
         CategoryTheory.CategoryStruct.comp ξ (L_W.obj.map (Opposite.op σ_e)) =
           CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_W) ∧
         (∀ (V : W_bar.left.Etale) (w : Quiver.Hom V (B_π.obj U_Y)),
           Disjoint (Set.range ((Fgt_W.map w).left).base)
             (Set.range ((Fgt_W.map σ_e).left).base) →
           CategoryTheory.CategoryStruct.comp ξ (L_W.obj.map (Opposite.op w)) = 0) ∧
         (∀ α' : Quiver.Hom (weilEtaleLocalTorsionSheaf Y.left n U_Y) (pf_π.obj L_W),
           let ξ' := CategoryTheory.Sheaf.freeYonedaHomEquiv α'
           CategoryTheory.CategoryStruct.comp ξ' (L_W.obj.map (Opposite.op σ_e)) =
             CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_W) →
           (∀ (V : W_bar.left.Etale) (w : Quiver.Hom V (B_π.obj U_Y)),
             Disjoint (Set.range ((Fgt_W.map w).left).base)
               (Set.range ((Fgt_W.map σ_e).left).base) →
             CategoryTheory.CategoryStruct.comp ξ' (L_W.obj.map (Opposite.op w)) = 0) →
           α' = α_n)) ∧
        (∀ q : ℕ, Function.Bijective (pullH_std π α_n q)) := by
    intro W_bar Y _ _ π U_W U_Y _ e hπ_hom hU_comm
    let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget W_bar.left
    let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget Y.left
    let B_π := weilEtaleSitePullback π
    let pf_π := B_π.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y.left.smallEtaleTopology W_bar.left.smallEtaleTopology
    have hProp_comp : AlgebraicGeometry.IsProper (CategoryTheory.CategoryStruct.comp π Y.hom) := by
      rwa [hπ_hom]
    have hProp_π : AlgebraicGeometry.IsProper π :=
      @AlgebraicGeometry.IsProper.of_comp _ _ _ π Y.hom hProp_comp inferInstance
    haveI : AlgebraicGeometry.IsProper π := hProp_π
    haveI : AlgebraicGeometry.IsAffine ((Fgt_Y.obj U_Y).left) :=
      @AlgebraicGeometry.IsAffine.of_isIso _ _ e.inv inferInstance inferInstance
    have hAff_UY_Sk : AlgebraicGeometry.IsAffineHom
        (CategoryTheory.CategoryStruct.comp ((Fgt_Y.obj U_Y).hom) Y.hom) :=
      AlgebraicGeometry.isAffineHom_of_isAffine _
    have hAffHom_UY : AlgebraicGeometry.IsAffineHom ((Fgt_Y.obj U_Y).hom) :=
      @AlgebraicGeometry.IsAffineHom.of_comp _ _ _ ((Fgt_Y.obj U_Y).hom) Y.hom
        hAff_UY_Sk inferInstance

    obtain ⟨σ_std, α_std, hσ_fst, hσ_uniq, hα_char, hStalkInj, hCoeffNat⟩ :=
      hClopenPkg π U_W U_Y e hU_comm

    
    have hPrimePow : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : k) ≠ 0 →
        ∀ r : ℕ,
          CategoryTheory.IsIso (α_std (ℓ ^ r)) ∧
          (∀ q : ℕ, 1 ≤ q →
            CategoryTheory.Limits.IsZero
              (weilEtaleHigherDirectImage π q
                (weilEtaleLocalTorsionSheaf W_bar.left (ℓ ^ r) U_W))) := by
      intro ℓ hFact_ℓ hℓ_ne r
      have hPrime_ℓ : Nat.Prime ℓ := hFact_ℓ.out
      have hPBC := weil_etale_proper_base_change_mod_prime k ℓ hℓ_ne
      let F_ℓ := weilEtaleLocalTorsionSheaf W_bar.left ℓ U_W
      have hF_tor : ℓ • CategoryTheory.CategoryStruct.id F_ℓ = 0 :=
        hLocTors_smul W_bar.left U_W ℓ

      
      have hAtPoint : ∀ (y : ↥Y.left),
          let κ := Y.left.residueField y
          let Ω := AlgebraicClosure ↥κ
          let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
