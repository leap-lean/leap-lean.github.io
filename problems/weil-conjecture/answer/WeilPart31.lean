        exact hRoot
      have hFinN : {μ : L' | T.maxGenEigenspace μ ≠ ⊥}.Finite := S.finite_toSet.subset hSub
      rw [LinearMap.trace_eq_sum_trace_restrict' hInt hFinN hMaps_pow]
