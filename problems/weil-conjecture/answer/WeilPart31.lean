          have hτ_id : τ_mor ≫ w_p = 𝟙 (V_pt pt) := MorphismProperty.Over.Hom.ext hτ_wp
          refine ⟨(G₁.obj.map τ_mor.op).hom s_Yp, ?_⟩
          have hnat := congrArg (fun m => m.hom s_Yp) (α.hom.naturality τ_mor.op)
          change (G₁.obj.map τ_mor.op ≫ α.hom.app (Opposite.op (V_pt pt))).hom s_Yp = _
          rw [hnat]
          change (G₂.obj.map τ_mor.op).hom ((α.hom.app (Opposite.op Y_p)).hom s_Yp) = t_pt
          rw [hs_Yp]
          change (G₂.obj.map w_p.op ≫ G₂.obj.map τ_mor.op).hom t_pt = t_pt
          rw [← G₂.obj.map_comp, ← op_comp, hτ_id, op_id, G₂.obj.map_id]
          rfl
        let s_fam := fun pt => (hLiftPt pt).choose
        have hs_fam : ∀ pt, (α.hom.app (Opposite.op (V_pt pt))).hom (s_fam pt) =
            (G₂.obj.map (v_pt pt).op).hom t₀ :=
          fun pt => (hLiftPt pt).choose_spec
        let Eℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
        have hFamIndep : ∀ {W : Z.Etale} {pt₁ pt₂ : PrimeSpectrum C₀}
            (h₁ : W ⟶ V_pt pt₁) (h₂ : W ⟶ V_pt pt₂),
            h₁ ≫ v_pt pt₁ = h₂ ≫ v_pt pt₂ →
            (G₁.obj.map h₁.op).hom (s_fam pt₁) = (G₁.obj.map h₂.op).hom (s_fam pt₂) := by
          intro W pt₁ pt₂ h₁ h₂ h_eq
          by_cases hpt : pt₁ = pt₂
          · subst hpt
            have := hv_mono pt₁
            have hh : h₁ = h₂ := (cancel_mono (v_pt pt₁)).mp h_eq
            rw [hh]
          · have : IsEmpty ↥W.left := hv_disj hpt h₁ h₂ h_eq
            have hbot : (⊥ : Sieve W) ∈ Z.smallEtaleTopology W :=
              (h_mem_etale Z W ⊥).mpr fun w => IsEmpty.elim inferInstance w
            have hz₁ : (G₁.obj.map h₁.op).hom (s_fam pt₁) = 0 :=
              hSheafEqZeroOfCover Z G₁ W _ ⊥ hbot fun _ _ hf => False.elim hf
            have hz₂ : (G₁.obj.map h₂.op).hom (s_fam pt₂) = 0 :=
              hSheafEqZeroOfCover Z G₁ W _ ⊥ hbot fun _ _ hf => False.elim hf
            rw [hz₁, hz₂]
        have hExFactor : ∀ {W : Z.Etale} (g : W ⟶ V₀), S_V₀.arrows g →
            ∃ (pt : PrimeSpectrum C₀) (h_w : W ⟶ V_pt pt), h_w ≫ v_pt pt = g := by
          intro W g hg
          rcases hg with ⟨W₀, h_w, g₀, ⟨pt⟩, rfl⟩
          exact ⟨pt, h_w, rfl⟩
        let x_fam : Presieve.FamilyOfElements
            (G₁.obj ⋙ coyoneda.obj (Opposite.op Eℤ)) S_V₀.arrows :=
          fun _ g hg =>
            let pt := (hExFactor g hg).choose
            let h_w := (hExFactor g hg).choose_spec.choose
            AddCommGrpCat.ofHom
              { toFun := fun n => n.down • (G₁.obj.map h_w.op).hom (s_fam pt)
                map_zero' := zero_zsmul _
                map_add' := fun a b => add_zsmul _ a.down b.down }
        have hx_compat : x_fam.Compatible := by
          intro W₁ W₂ W₃ g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
          apply AddCommGrpCat.ext
          intro ⟨n⟩
          let pt₁ := (hExFactor f₁ hf₁).choose
          let h₁ := (hExFactor f₁ hf₁).choose_spec.choose
          have hh₁ : h₁ ≫ v_pt pt₁ = f₁ := (hExFactor f₁ hf₁).choose_spec.choose_spec
          let pt₂ := (hExFactor f₂ hf₂).choose
          let h₂ := (hExFactor f₂ hf₂).choose_spec.choose
          have hh₂ : h₂ ≫ v_pt pt₂ = f₂ := (hExFactor f₂ hf₂).choose_spec.choose_spec
          change (G₁.obj.map g₁.op).hom (n • (G₁.obj.map h₁.op).hom (s_fam pt₁)) =
            (G₁.obj.map g₂.op).hom (n • (G₁.obj.map h₂.op).hom (s_fam pt₂))
          rw [map_zsmul, map_zsmul]
          congr 1
          have h_eq : (g₁ ≫ h₁) ≫ v_pt pt₁ = (g₂ ≫ h₂) ≫ v_pt pt₂ := by
            rw [Category.assoc, hh₁, Category.assoc, hh₂, hcomm]
