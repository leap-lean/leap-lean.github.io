    apply (adj_Y'.homEquiv R_mod ((res_et g hg).obj ((push_all i₀).obj (One_sh Z₀)))).injective
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
    let τ_i' : B_i'.obj (T_can Y') ⟶ T_can Z' := (hT_can Z').from _
    let τ_i₀ : B_i₀.obj (T_can Y₀) ⟶ T_can Z₀ := (hT_can Z₀).from _
    let μ_g : M_g.obj (T_can Y') ⟶ T_can Y₀ := (hT_can Y₀).from _
    let μ_gZ : M_gZ.obj (T_can Z') ⟶ T_can Z₀ := (hT_can Z₀).from _
    let u_Y₀ : R_mod ⟶ (One_sh Y₀).obj.obj (Opposite.op (T_can Y₀)) := adj_Y₀.unit.app R_mod
    let u_Z₀ : R_mod ⟶ (One_sh Z₀).obj.obj (Opposite.op (T_can Z₀)) := adj_Z₀.unit.app R_mod
    let u_Y' : R_mod ⟶ (One_sh Y').obj.obj (Opposite.op (T_can Y')) := adj_Y'.unit.app R_mod
    let u_Z' : R_mod ⟶ (One_sh Z').obj.obj (Opposite.op (T_can Z')) := adj_Z'.unit.app R_mod
    let qi'_app : (One_sh Y').obj.obj (Opposite.op (T_can Y')) ⟶
        (One_sh Z').obj.obj (Opposite.op (B_i'.obj (T_can Y'))) :=
