theorem weil_gysin_truncated_godement_and_verdier_pairing (S : AlgebraicGeometry.Scheme.{u})
    [ConnectedSpace ↥S] (m : ℕ) (hm : 1 ≤ m) :
    let R := ULift.{u, 0} (ZMod m)
    let 𝒞 := CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)
    let oneR := weilEtaleModuleUnit S m
    Nonempty (ZMod m ≃+ CategoryTheory.Abelian.Ext.{u} oneR oneR 0) ∧
    (∀ (d : ℕ) (τ : weilEtaleModuleH S m (2 * d) →+ ZMod m),
      WeilHasTruncatedGodementComplex S d m →
      WeilHasLocalEffacement S d m τ →
      (∀ (F : 𝒞) (p : ℕ), 2 * d < p →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR F p)) ∧
      Function.Bijective τ ∧
      (∀ (p q : ℕ) (hpq : p + q = 2 * d) (G : 𝒞),
        Function.Bijective
          (fun β : CategoryTheory.Abelian.Ext.{u} G oneR q =>
            AddMonoidHom.mk'
              (fun α : CategoryTheory.Abelian.Ext.{u} oneR G p => τ (α.comp β hpq))
              (fun α₁ α₂ => by
                rw [CategoryTheory.Abelian.Ext.add_comp, map_add])))) :=
by
