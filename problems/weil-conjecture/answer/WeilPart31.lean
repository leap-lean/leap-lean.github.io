            intro z
            obtain ⟨q_el, rfl⟩ := Ideal.Quotient.mk_surjective z
            obtain ⟨⟨c, ⟨_, k, rfl⟩⟩, hcq⟩ :=
              IsLocalization.surj (Submonoid.powers (r_of pt)) q_el
            refine ⟨c * d ^ k, ?_⟩
            have hcq_bar : Ideal.Quotient.mk M_pt q_el * π_κ (r_of pt) ^ k = π_κ c := by
              have h1 := congrArg (Ideal.Quotient.mk M_pt) hcq
