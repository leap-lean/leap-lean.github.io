                ((congrArg (· ≫ u_τ) hs_q).trans (Category.id_comp u_τ))))
        have hu_τ_hom : u_τ ≫ U.hom = g_pt :=
          (Category.assoc τ.left _ U.hom).trans
            ((congrArg (τ.left ≫ ·) Limits.pullback.condition).trans
              ((Category.assoc τ.left _ g_pt).symm.trans
                ((congrArg (· ≫ g_pt) (MorphismProperty.Over.w τ)).trans (Category.id_comp g_pt))))
        have hu_V_hom : u_V ≫ V.hom = 𝟙 S_Ω ≫ g_pt :=
          (congrArg (u_V ≫ ·) (MorphismProperty.Over.w f).symm).trans
            ((Category.assoc u_V f.left U.hom).symm.trans
              ((congrArg (· ≫ U.hom) hu_V_f).trans (hu_τ_hom.trans (Category.id_comp g_pt).symm)))
        let τ'_left : S_Ω ⟶ (B_g.obj V).left :=
          Limits.pullback.lift u_V (𝟙 S_Ω) hu_V_hom
        let τ' : T₀ ⟶ B_g.obj V :=
          MorphismProperty.Over.homMk τ'_left (Limits.pullback.lift_snd _ _ _) trivial
        refine ⟨V, f, hfR, τ', ?_⟩
        apply MorphismProperty.Over.Hom.ext
        apply Limits.pullback.hom_ext
        · change (τ'_left ≫ (B_g.map f).left) ≫ Limits.pullback.fst U.hom g_pt = _
          exact (Category.assoc _ _ _).trans
            ((congrArg (τ'_left ≫ ·) (Limits.pullback.lift_fst _ _ _)).trans
              ((Category.assoc τ'_left _ f.left).symm.trans
                ((congrArg (· ≫ f.left) (Limits.pullback.lift_fst _ _ _)).trans hu_V_f)))
        · change (τ'_left ≫ (B_g.map f).left) ≫ Limits.pullback.snd U.hom g_pt = _
          exact (Category.assoc _ _ _).trans
            ((congrArg (τ'_left ≫ ·) (Limits.pullback.lift_snd _ _ _)).trans
              ((Limits.pullback.lift_snd _ _ _).trans (MorphismProperty.Over.w τ).symm)) )

  have hGeomIsZero (X : AlgebraicGeometry.Scheme.{u})
      (H : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      (hFibZero : ∀ (x : ↥X),
        let Ω := AlgebraicClosure ↥(X.residueField x)
        let gx : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) X :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap ↥(X.residueField x) Ω)))
            (X.fromSpecResidueField x)
        ∃ (H_x : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback gx H H_x ∧
          CategoryTheory.Limits.IsZero H_x) :
      CategoryTheory.Limits.IsZero H := by
    have hFiberZero : ∀ (x : ↥X),
        let Ω := AlgebraicClosure ↥(X.residueField x)
        let gx : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(X.residueField x) Ω)) ≫
            X.fromSpecResidueField x
        Limits.IsZero ((mkGeomPoint Ω X gx).sheafFiber.obj H) := by
      intro x Ω gx
      let S_x := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let _ : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) gx :=
        MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) gx :=
        MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_gx : X.Etale ⥤ S_x.Etale := MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ gx
      let Φ₀ := mkSpecPoint Ω
      let Φ_x := mkGeomPoint Ω X gx
      obtain ⟨H_x, ⟨hc_gx, hr_gx, ⟨e_Hx⟩⟩, hZero_Hx⟩ := hFibZero x
      let _ := hc_gx; let _ := hr_gx
      let pf_gx := B_gx.sheafPushforwardContinuous AddCommGrpCat.{u}
        X.smallEtaleTopology S_x.smallEtaleTopology
      let pb_gx := B_gx.sheafPullback AddCommGrpCat.{u}
        X.smallEtaleTopology S_x.smallEtaleTopology
      let adj_gx := B_gx.sheafAdjunctionContinuous AddCommGrpCat.{u}
        X.smallEtaleTopology S_x.smallEtaleTopology
      obtain ⟨adj₀⟩ := hSkyAdj Φ₀
      obtain ⟨adj_x⟩ := hSkyAdj Φ_x
      let isoSky : mkSkyFunctor Φ₀ ⋙ pf_gx ≅ mkSkyFunctor Φ_x :=
        NatIso.ofComponents
          (fun M =>
            { hom :=
                { hom :=
                    { app := fun _ => AddCommGrpCat.ofHom (AddMonoidHom.id _)
                      naturality := fun _ _ _ => by ext; rfl } }
              inv :=
                { hom :=
                    { app := fun _ => AddCommGrpCat.ofHom (AddMonoidHom.id _)
                      naturality := fun _ _ _ => by ext; rfl } }
              hom_inv_id := Sheaf.hom_ext <| by ext U z; rfl
              inv_hom_id := Sheaf.hom_ext <| by ext U z; rfl })
          (fun _ => Sheaf.hom_ext <| by ext U z; rfl)
      let θ_x : pb_gx ⋙ Φ₀.sheafFiber ≅ Φ_x.sheafFiber :=
        ((adj_gx.comp adj₀).ofNatIsoRight isoSky).leftAdjointUniq adj_x
      have hZero_pb : Limits.IsZero (pb_gx.obj H) := hZero_Hx.of_iso e_Hx
      have : (Φ₀.sheafFiber (A := AddCommGrpCat.{u})).IsLeftAdjoint := ⟨_, ⟨adj₀⟩⟩
      have : (Φ₀.sheafFiber (A := AddCommGrpCat.{u})).PreservesZeroMorphisms := inferInstance
      have hZero_lhs : Limits.IsZero ((pb_gx ⋙ Φ₀.sheafFiber).obj H) :=
        Φ₀.sheafFiber.map_isZero hZero_pb
      exact hZero_lhs.of_iso (θ_x.symm.app H)
    rw [Limits.IsZero.iff_id_eq_zero]
    apply Sheaf.hom_ext
    ext V sec
    have hKillAt : ∀ z : ↥V.unop.left,
        ∃ (U_z : X.Etale) (f_z : U_z ⟶ V.unop) (y_z : ↥U_z.left),
          f_z.left.base y_z = z ∧ (H.obj.map f_z.op).hom sec = 0 := by
      intro z
      let x : ↥X := V.unop.hom.base z
      let Ω := AlgebraicClosure ↥(X.residueField x)
      let S_x := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let gx : S_x ⟶ X :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(X.residueField x) Ω)) ≫
          X.fromSpecResidueField x
      let _ : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) gx :=
        MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) gx :=
        MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_gx : X.Etale ⥤ S_x.Etale := MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ gx
      let Φ_x := mkGeomPoint Ω X gx
      have hZero_stalk : Limits.IsZero (Φ_x.sheafFiber.obj H) := hFiberZero x
      let pt₀ : ↥S_x := ⟨⊥, Ideal.isPrime_bot⟩
      have hgx_pt : gx.base pt₀ = x := by
        change (X.fromSpecResidueField x).base _ = x
        exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply x _
      obtain ⟨p₀, hp₀_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z pt₀ hgx_pt.symm
      let v_hom : V.unop.left ⟶ X := V.unop.hom
      have : Etale v_hom := V.unop.prop
      let q_pb : Limits.pullback v_hom gx ⟶ S_x := Limits.pullback.snd v_hom gx
      have : Etale q_pb := inferInstance
      obtain ⟨s_P, hs_q, hs_pt⟩ := hSecAlgClosed Ω q_pb p₀
      let τ_z : Φ_x.fiber.obj V.unop := MorphismProperty.Over.homMk s_P hs_q trivial
      have h_id0 : 𝟙 (Φ_x.presheafFiber.obj H.obj) = 0 :=
        (Limits.IsZero.iff_id_eq_zero _).mp hZero_stalk
      have h_eq_stalk : (Φ_x.toPresheafFiber V.unop τ_z H.obj).hom sec =
          (Φ_x.toPresheafFiber V.unop τ_z H.obj).hom 0 := by
        rw [map_zero]
        have hcomp := congrArg (fun φ => (Φ_x.toPresheafFiber V.unop τ_z H.obj ≫ φ).hom sec) h_id0
        simpa using hcomp
      obtain ⟨U_z, f_z, y_fib, hy_map, hy_sec⟩ :=
        (Φ_x.toPresheafFiber_eq_iff' V.unop τ_z sec 0).mp h_eq_stalk
      rw [map_zero] at hy_sec
      let y_z : ↥U_z.left := (y_fib.left ≫ Limits.pullback.fst U_z.hom gx).base pt₀
      refine ⟨U_z, f_z, y_z, ?_, hy_sec⟩
      have hy_left : y_fib.left ≫ (B_gx.map f_z).left = s_P :=
        congrArg (fun m => m.left) hy_map
      have h_comp_map : (y_fib.left ≫ Limits.pullback.fst U_z.hom gx) ≫ f_z.left =
          s_P ≫ Limits.pullback.fst v_hom gx :=
        (Category.assoc y_fib.left _ f_z.left).trans
          ((congrArg (y_fib.left ≫ ·) (Limits.pullback.lift_fst _ _ _).symm).trans
            ((Category.assoc y_fib.left _ _).symm.trans
              (congrArg (· ≫ Limits.pullback.fst v_hom gx) hy_left)))
      have h_base : f_z.left.base y_z = (Limits.pullback.fst v_hom gx).base (s_P.base pt₀) :=
        congrArg (fun m => m.base pt₀) h_comp_map
      rw [h_base, hs_pt pt₀, hp₀_fst]
    let U_fn := fun z => (hKillAt z).choose
    let f_fn := fun z => (hKillAt z).choose_spec.choose
    let y_fn := fun z => (hKillAt z).choose_spec.choose_spec.choose
    have hf_pt : ∀ z, (f_fn z).left.base (y_fn z) = z :=
      fun z => (hKillAt z).choose_spec.choose_spec.choose_spec.1
    have hf_sec : ∀ z, (H.obj.map (f_fn z).op).hom sec = 0 :=
      fun z => (hKillAt z).choose_spec.choose_spec.choose_spec.2
    let R_V : Sieve V.unop := Sieve.ofArrows U_fn f_fn
    have hR_V : R_V ∈ X.smallEtaleTopology V.unop :=
      (h_mem_etale X V.unop R_V).mpr fun z =>
        ⟨U_fn z, f_fn z, y_fn z, Sieve.ofArrows_mk U_fn f_fn z, hf_pt z⟩
    refine hSheafEqZeroOfCover X H V.unop sec R_V hR_V ?_
    intro W g hg
    rcases hg with ⟨W₀, h_w, g₀, ⟨z⟩, rfl⟩
    change (H.obj.map (h_w ≫ f_fn z).op).hom sec = 0
    rw [op_comp, H.obj.map_comp]
    change (H.obj.map h_w.op).hom ((H.obj.map (f_fn z).op).hom sec) = 0
    rw [hf_sec z, map_zero]

  have hPullComp {Z₁ Z₂ Z₃ : AlgebraicGeometry.Scheme.{u}}
      (u : Z₁ ⟶ Z₂) (v : Z₂ ⟶ Z₃)
      (F₃ : CategoryTheory.Sheaf Z₃.smallEtaleTopology AddCommGrpCat.{u})
      (F₂ : CategoryTheory.Sheaf Z₂.smallEtaleTopology AddCommGrpCat.{u})
      (F₁ : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u})
      (hv : WeilIsEtaleSheafPullback v F₃ F₂)
      (hu : WeilIsEtaleSheafPullback u F₂ F₁) :
      WeilIsEtaleSheafPullback (u ≫ v) F₃ F₁ := by
    obtain ⟨hc_v, hr_v, ⟨e₂⟩⟩ := hv
    obtain ⟨hc_u, hr_u, ⟨e₁⟩⟩ := hu
    obtain ⟨hc_uv, _⟩ := hSite (u ≫ v)
    let _ : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) u :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) u :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let _ : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) v :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) v :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let _ : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) (u ≫ v) :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) (u ≫ v) :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_u : Z₂.Etale ⥤ Z₁.Etale := MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ u
    let B_v : Z₃.Etale ⥤ Z₂.Etale := MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ v
    let B_uv : Z₃.Etale ⥤ Z₁.Etale := MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ (u ≫ v)
    let _ := hc_u; let _ := hr_u; let _ := hc_v; let _ := hr_v; let _ := hc_uv
    let pf_u := B_u.sheafPushforwardContinuous AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology
    let pf_v := B_v.sheafPushforwardContinuous AddCommGrpCat.{u} Z₃.smallEtaleTopology Z₂.smallEtaleTopology
    let pf_uv := B_uv.sheafPushforwardContinuous AddCommGrpCat.{u} Z₃.smallEtaleTopology Z₁.smallEtaleTopology
    let pb_u := B_u.sheafPullback AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology
    let pb_v := B_v.sheafPullback AddCommGrpCat.{u} Z₃.smallEtaleTopology Z₂.smallEtaleTopology
    let adj_u := B_u.sheafAdjunctionContinuous AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology
    let adj_v := B_v.sheafAdjunctionContinuous AddCommGrpCat.{u} Z₃.smallEtaleTopology Z₂.smallEtaleTopology
    let e_B : B_uv ≅ B_v ⋙ B_u := MorphismProperty.Over.pullbackComp u v
    let _ : (B_v ⋙ B_u).IsContinuous Z₃.smallEtaleTopology Z₁.smallEtaleTopology :=
      Functor.isContinuous_comp B_v B_u
        Z₃.smallEtaleTopology Z₂.smallEtaleTopology Z₁.smallEtaleTopology
    let e_pf₁ := Functor.sheafPushforwardContinuousIso e_B AddCommGrpCat.{u}
      Z₃.smallEtaleTopology Z₁.smallEtaleTopology
    let e_pf₂ : (B_v ⋙ B_u).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₃.smallEtaleTopology Z₁.smallEtaleTopology ≅ pf_u ⋙ pf_v :=
      NatIso.ofComponents
        (fun _ =>
          { hom :=
              { hom :=
                  { app := fun _ => AddCommGrpCat.ofHom (AddMonoidHom.id _)
                    naturality := fun _ _ _ => by ext; rfl } }
            inv :=
              { hom :=
                  { app := fun _ => AddCommGrpCat.ofHom (AddMonoidHom.id _)
                    naturality := fun _ _ _ => by ext; rfl } }
            hom_inv_id := Sheaf.hom_ext <| by ext U z; rfl
            inv_hom_id := Sheaf.hom_ext <| by ext U z; rfl })
        (fun _ => Sheaf.hom_ext <| by ext U z; rfl)
    let e_pf : pf_uv ≅ pf_u ⋙ pf_v := e_pf₁ ≪≫ e_pf₂
    let adj_comp : (pb_v ⋙ pb_u) ⊣ pf_uv := (adj_v.comp adj_u).ofNatIsoRight e_pf.symm
    let hr_uv : pf_uv.IsRightAdjoint := ⟨pb_v ⋙ pb_u, ⟨adj_comp⟩⟩
    let _ := hr_uv
    let pb_uv := B_uv.sheafPullback AddCommGrpCat.{u} Z₃.smallEtaleTopology Z₁.smallEtaleTopology
    let adj_uv := B_uv.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Z₃.smallEtaleTopology Z₁.smallEtaleTopology
    let e_pb : pb_v ⋙ pb_u ≅ pb_uv := adj_comp.leftAdjointUniq adj_uv
    exact ⟨hc_uv, hr_uv, ⟨e_pb.symm.app F₃ ≪≫ pb_u.mapIso e₂ ≪≫ e₁⟩⟩

  have hStalkSpecZero {Y_s : AlgebraicGeometry.Scheme.{u}}
      (V_Y : Y_s.Opens)
      (G_s : CategoryTheory.Sheaf Y_s.smallEtaleTopology AddCommGrpCat.{u})
      (hStalk_s : WeilAltLerayStalkZeroOutside V_Y G_s)
      (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (gy : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y_s)
      (K : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u})
      (hOut : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), gy.base pt ∉ V_Y)
      (hPull : WeilIsEtaleSheafPullback gy G_s K) :
      CategoryTheory.Limits.IsZero K := by
    obtain ⟨hc_gy, hr_gy, ⟨e_K⟩⟩ := hPull
    let S₀ := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let T₀ : S₀.Etale := MorphismProperty.Over.mk ⊤ (𝟙 S₀) inferInstance
    let Φ₀ := mkSpecPoint Ω
    let _ : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) gy :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) gy :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_gy : Y_s.Etale ⥤ S₀.Etale := MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ gy
    let _ := hc_gy; let _ := hr_gy
    let pf_gy := B_gy.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y_s.smallEtaleTopology S₀.smallEtaleTopology
    let pb_gy := B_gy.sheafPullback AddCommGrpCat.{u}
      Y_s.smallEtaleTopology S₀.smallEtaleTopology
    let adj_gy := B_gy.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Y_s.smallEtaleTopology S₀.smallEtaleTopology
    let A_K : AddCommGrpCat.{u} := K.obj.obj (Opposite.op T₀)
    let η_K : K ⟶ (mkSkyFunctor Φ₀).obj A_K :=
      { hom :=
          { app := fun _ => AddCommGrpCat.ofHom
              { toFun := fun z γ => (K.obj.map γ.op).hom z
                map_zero' := by funext _; exact map_zero _
                map_add' := fun a b => by funext γ; exact map_add _ a b }
            naturality := fun U V f => by
              apply AddCommGrpCat.ext
              intro z
              funext γ
              change (K.obj.map γ.op).hom ((K.obj.map f).hom z) =
                (K.obj.map (γ ≫ f.unop).op).hom z
              rw [op_comp, K.obj.map_comp]
              rfl } }
    let ψ₀ : pb_gy.obj G_s ⟶ (mkSkyFunctor Φ₀).obj A_K := e_K.hom ≫ η_K
    let φ : G_s ⟶ pf_gy.obj ((mkSkyFunctor Φ₀).obj A_K) :=
      adj_gy.homEquiv G_s ((mkSkyFunctor Φ₀).obj A_K) ψ₀
    have hφ_zero : φ = 0 := by
      apply Sheaf.hom_ext
      refine NatTrans.ext (funext fun W => ?_)
      apply AddCommGrpCat.ext
      intro σ
      funext γ
      let gw : S₀ ⟶ W.unop.left := γ.left ≫ Limits.pullback.fst W.unop.hom gy
      have hgw : gw ≫ W.unop.hom = gy :=
        (Category.assoc γ.left _ W.unop.hom).trans
          ((congrArg (γ.left ≫ ·) Limits.pullback.condition).trans
            ((Category.assoc γ.left _ gy).symm.trans
              ((congrArg (· ≫ gy) (MorphismProperty.Over.w γ)).trans (Category.id_comp gy))))
      obtain ⟨W', u_mor, gw', hgw'_u, hσ_zero⟩ := hStalk_s Ω gy hOut W.unop gw hgw σ
      have hgw'_hom : gw' ≫ W'.hom = 𝟙 S₀ ≫ gy :=
        (congrArg (gw' ≫ ·) (MorphismProperty.Over.w u_mor).symm).trans
          ((Category.assoc gw' u_mor.left W.unop.hom).symm.trans
            ((congrArg (· ≫ W.unop.hom) hgw'_u).trans (hgw.trans (Category.id_comp gy).symm)))
      let γ'_left : S₀ ⟶ (B_gy.obj W').left :=
        Limits.pullback.lift gw' (𝟙 S₀) hgw'_hom
      let γ' : T₀ ⟶ B_gy.obj W' :=
        MorphismProperty.Over.homMk γ'_left (Limits.pullback.lift_snd _ _ _) trivial
      have hγ'_eq : γ' ≫ B_gy.map u_mor = γ := by
        apply MorphismProperty.Over.Hom.ext
        apply Limits.pullback.hom_ext
        · change (γ'_left ≫ (B_gy.map u_mor).left) ≫ Limits.pullback.fst W.unop.hom gy = _
          exact (Category.assoc _ _ _).trans
            ((congrArg (γ'_left ≫ ·) (Limits.pullback.lift_fst _ _ _)).trans
              ((Category.assoc γ'_left _ u_mor.left).symm.trans
                ((congrArg (· ≫ u_mor.left) (Limits.pullback.lift_fst _ _ _)).trans hgw'_u)))
        · change (γ'_left ≫ (B_gy.map u_mor).left) ≫ Limits.pullback.snd W.unop.hom gy = _
          exact (Category.assoc _ _ _).trans
            ((congrArg (γ'_left ≫ ·) (Limits.pullback.lift_snd _ _ _)).trans
              ((Limits.pullback.lift_snd _ _ _).trans (MorphismProperty.Over.w γ).symm))
      have hnat := congrArg (fun m => m.hom σ γ') (φ.hom.naturality u_mor.op)
      change (G_s.obj.map u_mor.op ≫ φ.hom.app (Opposite.op W')).hom σ γ' =
        (φ.hom.app W).hom σ (γ' ≫ B_gy.map u_mor) at hnat
      rw [hγ'_eq] at hnat
      rw [← hnat]
      have hmap0 : (φ.hom.app (Opposite.op W')).hom 0 = 0 := map_zero _
      exact (congrArg (fun s => (φ.hom.app (Opposite.op W')).hom s γ') hσ_zero).trans
        (congrArg (fun f => f γ') hmap0)
    have hψ₀_zero : ψ₀ = 0 := by
      apply (adj_gy.homEquiv G_s ((mkSkyFunctor Φ₀).obj A_K)).injective
      have h0 : adj_gy.homEquiv G_s ((mkSkyFunctor Φ₀).obj A_K) 0 = 0 := by
        have hpf0 : pf_gy.map (0 : pb_gy.obj G_s ⟶ (mkSkyFunctor Φ₀).obj A_K) = 0 := by
          apply Sheaf.hom_ext
          ext W_z x_z
          rfl
        rw [Adjunction.homEquiv_unit, hpf0, Limits.comp_zero]
      rw [h0]
      exact hφ_zero
    have hη_zero : η_K = 0 := by
      calc
        η_K = (e_K.inv ≫ e_K.hom) ≫ η_K := by rw [e_K.inv_hom_id, Category.id_comp]
        _ = e_K.inv ≫ ψ₀ := Category.assoc _ _ _
        _ = 0 := by rw [hψ₀_zero, Limits.comp_zero]
    rw [Limits.IsZero.iff_id_eq_zero]
    apply Sheaf.hom_ext
    ext U z
    let pt₀ : ↥S₀ := ⟨⊥, Ideal.isPrime_bot⟩
    have hSecU : ∀ u₀ : ↥U.unop.left,
        ∃ γ_u : T₀ ⟶ U.unop, γ_u.left.base pt₀ = u₀ := by
      intro u₀
      let u_hom : U.unop.left ⟶ S₀ := U.unop.hom
      have : Etale u_hom := U.unop.prop
      obtain ⟨s_U, hs_U, hs_pt⟩ := hSecAlgClosed Ω u_hom u₀
      exact ⟨MorphismProperty.Over.homMk s_U hs_U trivial, hs_pt pt₀⟩
    let γ_fn := fun u₀ => (hSecU u₀).choose
    have hγ_pt : ∀ u₀, (γ_fn u₀).left.base pt₀ = u₀ := fun u₀ => (hSecU u₀).choose_spec
    let R_U : Sieve U.unop := Sieve.ofArrows (fun _ : ↥U.unop.left => T₀) γ_fn
    have hR_U : R_U ∈ S₀.smallEtaleTopology U.unop :=
      (h_mem_etale S₀ U.unop R_U).mpr fun u₀ =>
        ⟨T₀, γ_fn u₀, pt₀, Sieve.ofArrows_mk _ γ_fn u₀, hγ_pt u₀⟩
    refine hSheafEqZeroOfCover S₀ K U.unop z R_U hR_U ?_
    intro V g hg
    rcases hg with ⟨W₀, h_w, g₀, ⟨u₀⟩, rfl⟩
    have h_ev : (K.obj.map (γ_fn u₀).op).hom z = 0 :=
      congrArg (fun m => (m.hom.app U).hom z (γ_fn u₀)) hη_zero
    change (K.obj.map (h_w ≫ γ_fn u₀).op).hom z = 0
    rw [op_comp, K.obj.map_comp]
    change (K.obj.map h_w.op).hom ((K.obj.map (γ_fn u₀).op).hom z) = 0
    rw [h_ev, map_zero]

  have hFinSpecHigherZero (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      {Z : AlgebraicGeometry.Scheme.{u}}
      (f₀ : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      [AlgebraicGeometry.IsFinite f₀]
      (H₀ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (p : ℕ) (hp : 1 ≤ p) :
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f₀ p H₀) := by
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let Et_prop : MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    obtain ⟨hc_f₀, _⟩ := hSite f₀
    let _ : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f₀ :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f₀ :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp' hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp' hg)
    let B₀ : S_Ω.Etale ⥤ Z.Etale := MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f₀
    let _ := hc_f₀
    let pf₀ := B₀.sheafPushforwardContinuous AddCommGrpCat.{u}
      S_Ω.smallEtaleTopology Z.smallEtaleTopology
    have hEpi_pf₀ : ∀ (G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
        (α : G₁ ⟶ G₂) [CategoryTheory.Epi α], CategoryTheory.Epi (pf₀.map α) := by
      intro G₁ G₂ α _
      have : MorphismProperty.IsStableUnderComposition Et_prop :=
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      have : AlgebraicGeometry.IsAffine Z := AlgebraicGeometry.isAffine_of_isAffineHom f₀
      let C_cat : CommRingCat.{u} := Z.presheaf.obj (Opposite.op ⊤)
      let C₀ : Type u := ↑C_cat
      let e_Z : Z ≅ AlgebraicGeometry.Spec C_cat := Z.isoSpec
      let φ_cat : CommRingCat.of Ω ⟶ C_cat := AlgebraicGeometry.Spec.preimage (e_Z.inv ≫ f₀)
      have hφ_map : AlgebraicGeometry.Spec.map φ_cat = e_Z.inv ≫ f₀ :=
        AlgebraicGeometry.Spec.map_preimage (e_Z.inv ≫ f₀)
      have hFin_hom : φ_cat.hom.Finite :=
        (AlgebraicGeometry.IsFinite.SpecMap_iff φ_cat).mp (hφ_map.symm ▸ inferInstance)
      let _ : Algebra Ω C₀ := φ_cat.hom.toAlgebra
      have : Module.Finite Ω C₀ := RingHom.finite_algebraMap.mp hFin_hom
      have : IsArtinianRing C₀ := IsArtinianRing.of_finite Ω C₀
      have : IsNoetherianRing C₀ := inferInstance
      have : T1Space (PrimeSpectrum C₀) :=
        ⟨fun pt => (PrimeSpectrum.isClosed_singleton_iff_isMaximal pt).mpr
          ((IsArtinianRing.isPrime_iff_isMaximal pt.asIdeal).mp pt.isPrime)⟩
      have : DiscreteTopology (PrimeSpectrum C₀) := Finite.instDiscreteTopology
      have hBasisOpen : ∀ pt : PrimeSpectrum C₀,
          ∃ r_pt : C₀, (PrimeSpectrum.basicOpen r_pt : Set (PrimeSpectrum C₀)) = {pt} := by
        intro pt
        obtain ⟨_, ⟨r_pt, rfl⟩, hmem, hsub⟩ :=
          PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open
            (Set.mem_singleton pt) (isOpen_discrete {pt})
        exact ⟨r_pt, Set.Subset.antisymm hsub (Set.singleton_subset_iff.mpr hmem)⟩
      let r_of := fun pt : PrimeSpectrum C₀ => (hBasisOpen pt).choose
      have hr_eq : ∀ pt : PrimeSpectrum C₀,
          (PrimeSpectrum.basicOpen (r_of pt) : Set (PrimeSpectrum C₀)) = {pt} :=
        fun pt => (hBasisOpen pt).choose_spec
      let Q_of := fun pt : PrimeSpectrum C₀ => Localization.Away (r_of pt)
      let T₀ : S_Ω.Etale := MorphismProperty.Over.mk ⊤ (𝟙 S_Ω) inferInstance
      let V₀ : Z.Etale := B₀.obj T₀
      let e_V₀Z : V₀.left ≅ Z :=
        { hom := Limits.pullback.snd (𝟙 S_Ω) f₀
          inv := Limits.pullback.lift f₀ (𝟙 Z)
            ((Category.comp_id f₀).trans (Category.id_comp f₀).symm)
          hom_inv_id := by
            apply Limits.pullback.hom_ext
            · exact (Category.assoc _ _ _).trans
                ((congrArg (_ ≫ ·) (Limits.pullback.lift_fst _ _ _)).trans
                  (Limits.pullback.condition.symm.trans
                    ((Category.comp_id _).trans (Category.id_comp _).symm)))
            · exact (Category.assoc _ _ _).trans
                ((congrArg (_ ≫ ·) (Limits.pullback.lift_snd _ _ _)).trans
                  ((Category.comp_id _).trans (Category.id_comp _).symm))
          inv_hom_id := Limits.pullback.lift_snd _ _ _ }
      let e_V : V₀.left ≅ AlgebraicGeometry.Spec C_cat := e_V₀Z ≪≫ e_Z
      let j_of := fun pt : PrimeSpectrum C₀ =>
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₀ (Q_of pt)))
      have hj_open : ∀ pt, AlgebraicGeometry.IsOpenImmersion (j_of pt) :=
        fun pt => AlgebraicGeometry.IsOpenImmersion.of_isLocalization (S := Q_of pt) (r_of pt)
      have hj_range : ∀ pt : PrimeSpectrum C₀, Set.range (j_of pt).base = {pt} := by
        intro pt
        exact (PrimeSpectrum.localization_away_comap_range (Q_of pt) (r_of pt)).trans (hr_eq pt)
      let v_left := fun pt : PrimeSpectrum C₀ => j_of pt ≫ e_V.inv
      have hv_open : ∀ pt, AlgebraicGeometry.IsOpenImmersion (v_left pt) := fun pt => by
        have := hj_open pt
        dsimp [v_left]
        infer_instance
      have hv_et : ∀ pt, AlgebraicGeometry.Etale (v_left pt) := fun pt => by
        have := hv_open pt
        infer_instance
      let V_pt : PrimeSpectrum C₀ → Z.Etale := fun pt =>
        have := hv_et pt
        have : AlgebraicGeometry.Etale V₀.hom := V₀.prop
        MorphismProperty.Over.mk ⊤ (v_left pt ≫ V₀.hom) inferInstance
      let v_pt : ∀ pt : PrimeSpectrum C₀, V_pt pt ⟶ V₀ := fun pt =>
        MorphismProperty.Over.homMk (v_left pt) rfl trivial
      have hv_mono : ∀ pt : PrimeSpectrum C₀, Mono (v_pt pt) := by
        intro pt
        have := hv_open pt
        refine ⟨fun {W} g₁ g₂ hg => ?_⟩
        apply MorphismProperty.Over.Hom.ext
        have hg_left : g₁.left ≫ v_left pt = g₂.left ≫ v_left pt :=
          congrArg (fun m => m.left) hg
        exact (cancel_mono (v_left pt)).mp hg_left
      have hv_disj : ∀ {pt₁ pt₂ : PrimeSpectrum C₀}, pt₁ ≠ pt₂ →
          ∀ {W : Z.Etale} (g₁ : W ⟶ V_pt pt₁) (g₂ : W ⟶ V_pt pt₂),
            g₁ ≫ v_pt pt₁ = g₂ ≫ v_pt pt₂ → IsEmpty ↥W.left := by
        intro pt₁ pt₂ hne W g₁ g₂ hg
        refine ⟨fun w => hne ?_⟩
        have hg_left : (g₁.left ≫ v_left pt₁) ≫ e_V.hom = (g₂.left ≫ v_left pt₂) ≫ e_V.hom :=
          congrArg (· ≫ e_V.hom) (congrArg (fun m => m.left) hg)
        have h1 : (j_of pt₁).base (g₁.left.base w) = pt₁ := by
          have hm : (j_of pt₁).base (g₁.left.base w) ∈ ({pt₁} : Set (PrimeSpectrum C₀)) :=
            hj_range pt₁ ▸ ⟨_, rfl⟩
          exact Set.mem_singleton_iff.mp hm
        have h2 : (j_of pt₂).base (g₂.left.base w) = pt₂ := by
          have hm : (j_of pt₂).base (g₂.left.base w) ∈ ({pt₂} : Set (PrimeSpectrum C₀)) :=
            hj_range pt₂ ▸ ⟨_, rfl⟩
          exact Set.mem_singleton_iff.mp hm
        have h12 : (j_of pt₁).base (g₁.left.base w) = (j_of pt₂).base (g₂.left.base w) := by
          have hl : ((g₁.left ≫ v_left pt₁) ≫ e_V.hom).base w = (j_of pt₁).base (g₁.left.base w) := by
            have hm_eq : (g₁.left ≫ j_of pt₁ ≫ e_V.inv) ≫ e_V.hom = g₁.left ≫ j_of pt₁ :=
              (Category.assoc g₁.left _ e_V.hom).trans
                (congrArg (g₁.left ≫ ·)
                  ((Category.assoc (j_of pt₁) e_V.inv e_V.hom).trans
                    ((congrArg (j_of pt₁ ≫ ·) e_V.inv_hom_id).trans (Category.comp_id _))))
            exact congrArg (fun m => m.base w) hm_eq
          have hr : ((g₂.left ≫ v_left pt₂) ≫ e_V.hom).base w = (j_of pt₂).base (g₂.left.base w) := by
            have hm_eq : (g₂.left ≫ j_of pt₂ ≫ e_V.inv) ≫ e_V.hom = g₂.left ≫ j_of pt₂ :=
              (Category.assoc g₂.left _ e_V.hom).trans
                (congrArg (g₂.left ≫ ·)
                  ((Category.assoc (j_of pt₂) e_V.inv e_V.hom).trans
                    ((congrArg (j_of pt₂ ≫ ·) e_V.inv_hom_id).trans (Category.comp_id _))))
            exact congrArg (fun m => m.base w) hm_eq
          exact hl.symm.trans ((congrArg (fun m => m.base w) hg_left).trans hr)
        exact h1.symm.trans (h12.trans h2)
      let S_V₀ : Sieve V₀ := Sieve.ofArrows V_pt v_pt
      have hS_V₀ : S_V₀ ∈ Z.smallEtaleTopology V₀ := by
        refine (h_mem_etale Z V₀ S_V₀).mpr fun x => ?_
        let pt : PrimeSpectrum C₀ := e_V.hom.base x
        have hmem_pt : pt ∈ Set.range (j_of pt).base := by rw [hj_range pt]; rfl
        obtain ⟨q_x, hq_x⟩ := hmem_pt
        refine ⟨V_pt pt, v_pt pt, q_x, Sieve.ofArrows_mk V_pt v_pt pt, ?_⟩
        change e_V.inv.base ((j_of pt).base q_x) = x
        rw [hq_x]
        change (e_V.hom ≫ e_V.inv).base x = x
        rw [e_V.hom_inv_id]
        rfl
      have hSurj_V₀ : ∀ t₀ : ↥(G₂.obj.obj (Opposite.op V₀)),
          ∃ s₀ : ↥(G₁.obj.obj (Opposite.op V₀)),
            (α.hom.app (Opposite.op V₀)).hom s₀ = t₀ := by
        intro t₀
        have hLiftPt : ∀ pt : PrimeSpectrum C₀,
            ∃ s_pt : ↥(G₁.obj.obj (Opposite.op (V_pt pt))),
              (α.hom.app (Opposite.op (V_pt pt))).hom s_pt =
                (G₂.obj.map (v_pt pt).op).hom t₀ := by
          intro pt
          let t_pt := (G₂.obj.map (v_pt pt).op).hom t₀
          have hmem_pt : pt ∈ Set.range (j_of pt).base := by rw [hj_range pt]; rfl
          obtain ⟨q_pt, hq_pt⟩ := hmem_pt
          have hq_uniq : ∀ q' : PrimeSpectrum (Q_of pt), q' = q_pt := by
            intro q'
            have hq'_in : (j_of pt).base q' ∈ ({pt} : Set (PrimeSpectrum C₀)) :=
              hj_range pt ▸ ⟨q', rfl⟩
            have hq'_eq : (j_of pt).base q' = pt := Set.mem_singleton_iff.mp hq'_in
            have := hj_open pt
            exact (j_of pt).isOpenEmbedding.injective (hq'_eq.trans hq_pt.symm)
          let M_pt : Ideal (Q_of pt) := q_pt.asIdeal
          have hMax_M : M_pt.IsMaximal := by
            obtain ⟨M', hM'_max, _⟩ := Ideal.exists_le_maximal M_pt q_pt.isPrime.ne_top
            have : M'.IsPrime := hM'_max.isPrime
            have heq : (⟨M', this⟩ : PrimeSpectrum (Q_of pt)) = q_pt := hq_uniq _
            have hM_eq : M' = M_pt := congrArg PrimeSpectrum.asIdeal heq
            rwa [← hM_eq]
          let _ : M_pt.IsMaximal := hMax_M
          have : IsNoetherianRing (Q_of pt) :=
            IsLocalization.isNoetherianRing (Submonoid.powers (r_of pt)) (Q_of pt) inferInstance
          have hNil_M : IsNilpotent M_pt := by
            rw [(Ideal.FG.isNilpotent_iff_le_nilradical (IsNoetherian.noetherian M_pt)),
              _root_.nilradical_eq_sInf]
            refine le_sInf fun J hJ => ?_
            have heq : (⟨J, hJ⟩ : PrimeSpectrum (Q_of pt)) = q_pt := hq_uniq ⟨J, hJ⟩
