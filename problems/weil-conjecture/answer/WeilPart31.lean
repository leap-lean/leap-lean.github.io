      have hBij_Q := ih (q + 1) hpq' Q
      have hBij_A := ih (q + 1) hpq' A
      refine ⟨?_, ?_⟩
      · intro β₁ β₂ h12
        apply hi_top_inj
        apply hBij_Q.1
        apply AddMonoidHom.ext
        intro α₀
        rw [hSq1 β₁ α₀, hSq1 β₂ α₀, h12]
      · intro lam
        let μ : CategoryTheory.Abelian.Ext.{u} oneR Q p →+ ZMod m := lam.comp g_cov
        obtain ⟨γ, hγ⟩ := hBij_Q.2 μ
        have hp_γ0 : p_top γ = 0 := by
          apply hBij_A.1
