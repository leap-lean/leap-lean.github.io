        (RingHom.mapMatrix φ).map_pow B r
      have htr_map : φ (Matrix.trace (B ^ r)) = Matrix.trace (B_L ^ r) := by
        rw [← hpow_map]
        dsimp [Matrix.trace, Matrix.diag]
        exact map_sum φ _ _
      rw [htr_map, ← Matrix.trace_toLin'_eq, Matrix.toLin'_pow]
      rw [h_algClosed_trace L' m (Matrix.toLin' B_L) r]
      rw [Matrix.charpoly_toLin', Matrix.charpoly_map]
    have hPart2 : (B.charpoly).reverse.coeff 0 = 1 := by
      rw [Polynomial.coeff_zero_reverse, (Matrix.charpoly_monic B).leadingCoeff]
    refine ⟨hPart1, hPart2, ?_⟩
    let L₀ := AlgebraicClosure K
    let ι : K →+* L₀ := algebraMap K L₀
    have hι_inj : Function.Injective ι := ι.injective
    let R : Multiset L₀ := (B.charpoly).aroots L₀
    have hmap_rev : Polynomial.map ι ((B.charpoly).reverse) = (Polynomial.map ι B.charpoly).reverse := by
      ext i
      rw [Polynomial.coeff_map, Polynomial.coeff_reverse, Polynomial.coeff_reverse,
        Polynomial.natDegree_map_eq_of_injective hι_inj, Polynomial.coeff_map]
    have hSplits : (Polynomial.map ι B.charpoly).Splits :=
      IsAlgClosed.splits (Polynomial.map ι B.charpoly)
