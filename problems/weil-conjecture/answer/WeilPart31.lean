    obtain ⟨L_sh, ⟨adj_LR⟩⟩ := hHasLeftAdj ψ_tilde hψ_et hc_ψ
    let Θ : Quiver.Hom (L_sh.obj (γ_push.obj One_ZV)) (ibar_push.obj ℒ_ZV) :=
