        exact Eq.mp heq_mem.symm hmem'
      · have hs0 : s = 0 := by funext ⟨h⟩; exact (hu h).elim
        have hid_mem : (CategoryTheory.Presheaf.imageSieve g_sub s).arrows (𝟙 T) := by
          rw [CategoryTheory.Presheaf.imageSieve_apply]
