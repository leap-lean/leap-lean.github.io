        hEtComp f_v₀ u₀ hEt_fv₀ hu₀
      haveI hOpen_ιsucc : IsOpenImmersion (ι_aff (d + 1)) := (hModel.1 (d + 1)).2.1
      have hEt_U'_hom : Etale (u_U' ≫ ι_aff (d + 1)) :=
        hEtComp u_U' (ι_aff (d + 1)) hEt_uU' inferInstance
      let U' : Psucc.left.Etale :=
        MorphismProperty.Over.mk ⊤ (u_U' ≫ ι_aff (d + 1)) hEt_U'_hom
      have hv_to_eff_w : f_to_Weff ≫ (Fgt_Ps.obj U_eff).hom = (Fgt_Ps.obj U').hom := by
        change f_to_Weff ≫ (Fgt_Ps.obj U_eff).hom = ((f_to_Weff ≫ f_eff) ≫ u₀) ≫ ι_aff (d + 1)
        rw [Category.assoc (f_to_Weff ≫ f_eff), hu₀_hom, Category.assoc f_to_Weff,
          (Fgt_Ps.map v_eff).w]
      let v_to_eff : U' ⟶ U_eff := MorphismProperty.Over.homMk f_to_Weff hv_to_eff_w
      let v₀ : U' ⟶ U₀ := v_to_eff ≫ v_eff
      have hEt_U'fib_hom : Etale (u_fib ≫ ι_aff (d + 1)) :=
        hEtComp u_fib (ι_aff (d + 1)) hEt_ufib inferInstance
      let U'_fib : Psucc.left.Etale :=
        MorphismProperty.Over.mk ⊤ (u_fib ≫ ι_aff (d + 1)) hEt_U'fib_hom
      have hAff_W' : IsAffine W' := inferInstance
      have hBij_fib : Function.Bijective
          (fun w : weilCupPDTraceLocalTorsionH Psucc.left n U'_fib (2 * (d + 1)) =>
            tr_Pd (d + 1) (weilCupPDTraceLocalTorsionCounitH Psucc.left n U'_fib (2 * (d + 1)) w)) :=
        hModel.2.2.2.2 d V'''_Pd U'_fib u_V''' u_fib h_W'V''' (u_fib_As ≫ pr_1)
          hAff_V''' (show IsAffine ((Fgt_Ps.obj U'_fib).left) from hAff_W')
          hEt_uV''' hEt_ufib hu_V'''_hom rfl
          hu_fib_prd rfl hSm_W' hConn_fib hBij_V'''
      
      have hprd_k : pr_d ≫ p_Ad = (weilCupPDTraceAffineSpaceOver k (d + 1)).hom := by
        dsimp [pr_d, p_Ad, weilCupPDTraceAffineSpaceOver]
        rw [← Spec.map_comp]
        congr 1
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        exact MvPolynomial.rename_C Fin.castSucc c
      have hCharts_k : u_U' ≫ (weilCupPDTraceAffineSpaceOver k (d + 1)).hom =
          u_fib ≫ (weilCupPDTraceAffineSpaceOver k (d + 1)).hom := by
        have hrhs : u_fib ≫ (weilCupPDTraceAffineSpaceOver k (d + 1)).hom =
            p_W'U'' ≫ U''.ι ≫ E_top.W₁_open.ι ≫ E_top.g_Y₁ ≫ E_top.Y_bar.hom := by
          calc
            u_fib ≫ (weilCupPDTraceAffineSpaceOver k (d + 1)).hom
              = u_fib_As ≫ (pr_d ≫ p_Ad) := by rw [hprd_k]; rfl
            _ = (u_fib_As ≫ pr_d) ≫ p_Ad := (Category.assoc _ _ _).symm
            _ = h_W'V''' ≫ (u_V'''_Ad ≫ p_Ad) := by rw [hu_fib_prd, Category.assoc]
            _ = (h_W'V''' ≫ w_top) ≫ V''.ι ≫ p_V₁_k := by
                rw [hu_V'''_k, ← Category.assoc]
            _ = p_W'U'' ≫ (h_UV'' ≫ V''.ι) ≫ p_V₁_k :=
                (congrArg (· ≫ (V''.ι ≫ p_V₁_k))
                  (Limits.pullback.condition (f := h_UV'') (g := w_top)).symm).trans
                  ((Category.assoc p_W'U'' h_UV'' _).trans
                    (congrArg (p_W'U'' ≫ ·) (Category.assoc h_UV'' V''.ι p_V₁_k).symm))
            _ = p_W'U'' ≫ (U''.ι ≫ h_sm) ≫ p_V₁_k := by
                have hres : h_UV'' ≫ V''.ι = U''.ι ≫ h_sm :=
                  Scheme.Hom.resLE_comp_ι h_sm
                    (inf_le_right : U'' ≤ (TopologicalSpace.Opens.map h_sm.base).obj V'')
                rw [hres]
            _ = p_W'U'' ≫ U''.ι ≫ E_top.W₁_open.ι ≫
                  (E_top.f_bar₁ ≫ ((Scheme.Etale.forget E_top.V_bar.left).obj E_top.V₁).hom) ≫
                  E_top.V_bar.hom := by
                simp only [h_sm, p_V₁_k, Category.assoc]
            _ = p_W'U'' ≫ U''.ι ≫ E_top.W₁_open.ι ≫ E_top.g_Y₁ ≫
                  (E_top.π_bar.left ≫ E_top.V_bar.hom) := by
                rw [← E_top.hComm_Y₁]
                simp only [Category.assoc]
            _ = p_W'U'' ≫ U''.ι ≫ E_top.W₁_open.ι ≫ E_top.g_Y₁ ≫ E_top.Y_bar.hom := by
                rw [E_top.π_bar.w]
        have hlhs : u_U' ≫ (weilCupPDTraceAffineSpaceOver k (d + 1)).hom =
            p_W'U'' ≫ U''.ι ≫ E_top.W₁_open.ι ≫ E_top.g_Y₁ ≫ E_top.Y_bar.hom := by
          have he_inv : E_top.e_W₁.inv ≫
              ((Scheme.Etale.forget E_top.Y_bar.left).obj E_top.W₁).hom =
              E_top.W₁_open.ι ≫ E_top.g_Y₁ := by
            rw [← E_top.he_W₁_hom, ← Category.assoc, E_top.e_W₁.inv_hom_id, Category.id_comp]
          calc
            u_U' ≫ (weilCupPDTraceAffineSpaceOver k (d + 1)).hom
              = p_W'U'' ≫ U''.ι ≫ E_top.e_W₁.inv ≫
                  (E_top.j_W₁ ≫ (u_eff_aff ≫ (weilAffineSpaceOver k (d + 1)).hom)) := by
                simp only [u_U', f_v₀, f_to_Weff, u_eff_aff, weilCupPDTraceAffineSpaceOver,
                  weilAffineSpaceOver, Category.assoc]
            _ = p_W'U'' ≫ U''.ι ≫
                  (E_top.e_W₁.inv ≫ ((Scheme.Etale.forget E_top.Y_bar.left).obj E_top.W₁).hom) ≫
                  E_top.Y_bar.hom := by
                rw [E_top.hComp_jW₁]
                simp only [Category.assoc]
            _ = p_W'U'' ≫ U''.ι ≫ E_top.W₁_open.ι ≫ E_top.g_Y₁ ≫ E_top.Y_bar.hom := by
                rw [he_inv]
                simp only [Category.assoc]
        exact hlhs.trans hrhs.symm
      let e_chart : ((Fgt_Ps.obj U').left) ≅ ((Fgt_Ps.obj U'_fib).left) := Iso.refl W'
      have hRoof_chart : WeilCupPDTraceIsAffineRoofIso k Psucc Psucc U' U'_fib e_chart := by
        refine ⟨(hModel.1 (d + 1)).1, (hModel.1 (d + 1)).1,
          (show IsAffine ((Fgt_Ps.obj U').left) from hAff_W'), ?_⟩
        change 𝟙 W' ≫ (u_fib ≫ ι_aff (d + 1)) ≫ Psucc.hom =
          (u_U' ≫ ι_aff (d + 1)) ≫ Psucc.hom
        rw [Category.id_comp, Category.assoc u_fib, Category.assoc u_U',
          (hModel.1 (d + 1)).2.2, hCharts_k]
      refine ⟨U', v₀, x'₀, (show IsAffine ((Fgt_Ps.obj U').left) from hAff_W'),
        hx'₀_cl, ?_, ?_, ?_⟩
      · change f_eff.base (E_top.j_W₁.base (E_top.e_W₁.inv.base (U''.ι.base (p_W'U''.base x'₀)))) = x₀
        rw [hx'₀_fst]
        have hy_eq : U''.ι.base y''₀ = E_top.e_W₁.hom.base E_top.x₁ := rfl
        rw [hy_eq]
        have hinv_hom : E_top.e_W₁.inv.base (E_top.e_W₁.hom.base E_top.x₁) = E_top.x₁ := by
          change (E_top.e_W₁.hom ≫ E_top.e_W₁.inv).base E_top.x₁ = E_top.x₁
          rw [E_top.e_W₁.hom_inv_id]
          rfl
        rw [hinv_hom, E_top.hx₁_map, hx_eff_map]
      · intro q hq z
        change weilCupPDTraceLocalTorsionMapH Psucc.left n (v_to_eff ≫ v_eff) q z = 0
        rw [hMapHComp Psucc.left n v_to_eff v_eff q z]
        exact hVan_eff q hq _
      · have hfun : (fun z : weilCupPDTraceLocalTorsionH Psucc.left n U' (2 * (d + 1)) =>
            tr_Pd (d + 1) (weilCupPDTraceLocalTorsionCounitH Psucc.left n U' (2 * (d + 1)) z)) =
            (fun w : weilCupPDTraceLocalTorsionH Psucc.left n U'_fib (2 * (d + 1)) =>
              tr_Pd (d + 1)
                (weilCupPDTraceLocalTorsionCounitH Psucc.left n U'_fib (2 * (d + 1)) w)) ∘
            (Ψ Psucc Psucc U' U'_fib e_chart hRoof_chart (2 * (d + 1))) := by
          funext z
          exact hChartIndep (d + 1) U' U'_fib u_U' u_fib e_chart hRoof_chart
            hEt_uU' hEt_ufib rfl rfl z
        rw [hfun]
        exact hBij_fib.comp
          (Ψ Psucc Psucc U' U'_fib e_chart hRoof_chart (2 * (d + 1))).bijective

  obtain ⟨U', v₀, x'₀, hAff', _, hx'₀_map, hVan', hBij'⟩ :=
    (hMainInd δ).2 U₀ u₀ x₀ hx₀_cl hAff₀ hu₀_et hu₀_hom
  exact ⟨U', v₀, x'₀, hAff', hx'₀_map, hVan', hBij'⟩

theorem weil_cupPD_smooth_proper_trace_and_local_effacement (k : Type u) [Field k] [IsAlgClosed k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    (d n : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (hn : 1 ≤ n) (hUnit : IsUnit (n : k))
    (ζ : kˣ) (hPrim : IsPrimitiveRoot ((ζ : kˣ) : k) n) :
    ∃ τ : weilCupPDModH X.left n (2 * d) →+ ZMod n,
      WeilCupPDHasLocalEffacement X.left d n τ :=
by
  obtain ⟨Ψ, hΨ_pin⟩ := weil_cupPD_trace_pinned_compact_support_roof_transfer k n hn hUnit
  have hΨ : WeilCupPDTraceIsValidRoof k n Ψ := hΨ_pin.1
  obtain ⟨ι_aff, tr_Pd, hModel⟩ :=
    weil_cupPD_trace_pinned_polyP1_kummer_model k n hn hUnit ζ hPrim Ψ hΨ_pin
  obtain ⟨hChartIndep, tr_X, hTrChart⟩ :=
    weil_cupPD_trace_steinitz_chart_gluing k X hInt d n hn hUnit Ψ hΨ ι_aff tr_Pd hModel
  apply weil_cupPD_trace_mod_to_torsion_effacement_bridge X.left d n tr_X
  have hFreeYonedaComp : ∀ {S : AlgebraicGeometry.Scheme.{u}} {W : S.Etale}
      {F G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (α : weilCupPDTraceLocalTorsionSheaf S n W ⟶ F) (f : F ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ f) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ f.hom.app (Opposite.op W) :=
    fun α f => CategoryTheory.Presheaf.freeYonedaHomEquiv_comp
      ((CategoryTheory.sheafificationAdjunction _ AddCommGrpCat.{u}).homEquiv _ _ α) f.hom
  have hMapComp : ∀ (S : AlgebraicGeometry.Scheme.{u}) {U₁ U₂ U₃ : S.Etale}
      (u₁ : U₁ ⟶ U₂) (u₂ : U₂ ⟶ U₃) (q : ℕ)
      (z : weilCupPDTraceLocalTorsionH S n U₁ q),
      weilCupPDTraceLocalTorsionMapH S n (u₁ ≫ u₂) q z =
        weilCupPDTraceLocalTorsionMapH S n u₂ q
          (weilCupPDTraceLocalTorsionMapH S n u₁ q z) := by
    intro S U₁ U₂ U₃ u₁ u₂ q z
    have hmor : weilCupPDTraceLocalTorsionMap S n (u₁ ≫ u₂) =
        weilCupPDTraceLocalTorsionMap S n u₁ ≫ weilCupPDTraceLocalTorsionMap S n u₂ := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hFreeYonedaComp]
      have h_u₁ : CategoryTheory.Sheaf.freeYonedaHomEquiv
          (weilCupPDTraceLocalTorsionMap S n u₁) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilCupPDTraceLocalTorsionSheaf S n U₂)) ≫
            (weilCupPDTraceLocalTorsionSheaf S n U₂).obj.map (Opposite.op u₁) :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
      have h_u₂ : CategoryTheory.Sheaf.freeYonedaHomEquiv
          (weilCupPDTraceLocalTorsionMap S n u₂) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilCupPDTraceLocalTorsionSheaf S n U₃)) ≫
            (weilCupPDTraceLocalTorsionSheaf S n U₃).obj.map (Opposite.op u₂) :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
      have h_u₁₂ : CategoryTheory.Sheaf.freeYonedaHomEquiv
          (weilCupPDTraceLocalTorsionMap S n (u₁ ≫ u₂)) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilCupPDTraceLocalTorsionSheaf S n U₃)) ≫
            (weilCupPDTraceLocalTorsionSheaf S n U₃).obj.map (Opposite.op (u₁ ≫ u₂)) :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
      rw [h_u₁₂, h_u₁, CategoryTheory.Category.assoc,
        (weilCupPDTraceLocalTorsionMap S n u₂).hom.naturality (Opposite.op u₁),
        ← CategoryTheory.Category.assoc,
        ← hFreeYonedaComp (𝟙 (weilCupPDTraceLocalTorsionSheaf S n U₂))
          (weilCupPDTraceLocalTorsionMap S n u₂),
        CategoryTheory.Category.id_comp, h_u₂,
        CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp]
      rfl
    change z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDTraceLocalTorsionMap S n (u₁ ≫ u₂)))
        (Nat.add_zero q) =
      (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDTraceLocalTorsionMap S n u₁))
        (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDTraceLocalTorsionMap S n u₂))
        (Nat.add_zero q)
    rw [hmor, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀
        (weilCupPDTraceLocalTorsionMap S n u₁) (weilCupPDTraceLocalTorsionMap S n u₂),
      ← CategoryTheory.Abelian.Ext.comp_assoc z _ _
        (Nat.add_zero q) (Nat.zero_add 0) (Nat.add_zero q)]
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget X.left
  let Pd := weilCupPDTracePolyP1Over k d
  let Fgt_Pd := AlgebraicGeometry.Scheme.Etale.forget Pd.left
  have hProp_Pd : AlgebraicGeometry.IsProper Pd.hom := (hModel.1 d).1
  have hOpen_ι : AlgebraicGeometry.IsOpenImmersion (ι_aff d) := (hModel.1 d).2.1
  have hComp_ι : CategoryTheory.CategoryStruct.comp (ι_aff d) Pd.hom =
      (weilCupPDTraceAffineSpaceOver k d).hom := (hModel.1 d).2.2
  unfold WeilCupPDTraceHasTorsionEffacement
  dsimp only
  intro x U γ hγ
  let κ := X.left.residueField x
  let Ω := AlgebraicClosure ↥κ
  let gx : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) X.left :=
    CategoryTheory.CategoryStruct.comp
