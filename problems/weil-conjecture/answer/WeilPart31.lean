          (hPX₁ 1 le_rfl).eq_of_tgt _ 0
        haveI : CategoryTheory.Epi ((SC₀.map W_B).map Sh₂).f :=
          (CategoryTheory.ShortComplex.Exact.epi_f_iff hEx_sh₀).mpr hg₀_zero
        have hev_comm : H₀_pre.map S₀.g ≫ (evNatIso S₀.X₃).hom =
            (evNatIso S₀.X₂).hom ≫ S₀.g.hom := by
          ext W x
          rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.comp_app]
          change (evAddEquiv S₀.X₃ W) (x.comp (CategoryTheory.Abelian.Ext.mk₀ S₀.g) (Nat.add_zero 0)) =
            (S₀.g.hom.app W).hom ((evAddEquiv S₀.X₂ W) x)
          let φ : weilPolyP1CohomologyRepSheaf S₁ W.unop ⟶ S₀.X₂ :=
            CategoryTheory.Abelian.Ext.homEquiv₀ x
          have hx : x = CategoryTheory.Abelian.Ext.mk₀ φ := by
            rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply]
            exact (CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply x).symm
          rw [hx, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
          change weilPolyP1CohomologyRepHomEquiv S₁ W.unop S₀.X₃
              (CategoryTheory.Abelian.Ext.homEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ (φ ≫ S₀.g))) =
            (S₀.g.hom.app W).hom
              (weilPolyP1CohomologyRepHomEquiv S₁ W.unop S₀.X₂
                (CategoryTheory.Abelian.Ext.homEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ φ)))
          rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
            ← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
            Equiv.apply_symm_apply, Equiv.apply_symm_apply, hRepApply, hRepApply]
          rfl
        let ε_sh₂ := (CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).counit
        haveI : CategoryTheory.IsIso (ε_sh₂.app (R.obj S₀.X₃)) :=
          CategoryTheory.isIso_sheafificationAdjunction_counit (R.obj S₀.X₃)
        let e₂ : Sh₂.obj (W_B.obj (S₀.X₂.cohomologyPresheaf 0)) ⟶ Sh₂.obj (W_B.obj S₀.X₂.obj) :=
          Sh₂.map (W_B.map (evNatIso S₀.X₂).hom)
        let e₃ : Sh₂.obj (W_B.obj (S₀.X₃.cohomologyPresheaf 0)) ⟶ Sh₂.obj (W_B.obj S₀.X₃.obj) :=
          Sh₂.map (W_B.map (evNatIso S₀.X₃).hom)
        let e₃_inv : Sh₂.obj (W_B.obj S₀.X₃.obj) ⟶ Sh₂.obj (W_B.obj (S₀.X₃.cohomologyPresheaf 0)) :=
          Sh₂.map (W_B.map (evNatIso S₀.X₃).inv)
        have he₃_inv_hom : e₃_inv ≫ e₃ = CategoryTheory.CategoryStruct.id _ := by
          have h1 : W_B.map (evNatIso S₀.X₃).inv ≫ W_B.map (evNatIso S₀.X₃).hom =
              CategoryTheory.CategoryStruct.id _ := by
            rw [← W_B.map_comp, CategoryTheory.Iso.inv_hom_id, W_B.map_id]
          exact (Sh₂.map_comp _ _).symm.trans
            ((congrArg Sh₂.map h1).trans (Sh₂.map_id _))
        have hSh_sq : ((SC₀.map W_B).map Sh₂).f ≫ e₃ = e₂ ≫ Sh₂.map (R.map S₀.g).hom := by
          have h1 : W_B.map (H₀_pre.map S₀.g) ≫ W_B.map (evNatIso S₀.X₃).hom =
              W_B.map (evNatIso S₀.X₂).hom ≫ W_B.map S₀.g.hom := by
            rw [← W_B.map_comp, ← W_B.map_comp, hev_comm]
          exact (Sh₂.map_comp _ _).symm.trans
            ((congrArg Sh₂.map h1).trans (Sh₂.map_comp _ _))
        have hε_sq : Sh₂.map (R.map S₀.g).hom ≫ ε_sh₂.app (R.obj S₀.X₃) =
            ε_sh₂.app (R.obj S₀.X₂) ≫ R.map S₀.g :=
          ε_sh₂.naturality (R.map S₀.g)
        have hEpi_g : CategoryTheory.Epi (S₀.map R).g := by
          change CategoryTheory.Epi (R.map S₀.g)
          refine ⟨fun {Z_sh} k₁ k₂ hk => ?_⟩
          have hL : ∀ k : R.obj S₀.X₃ ⟶ Z_sh,
              ((SC₀.map W_B).map Sh₂).f ≫ (e₃ ≫ (ε_sh₂.app (R.obj S₀.X₃) ≫ k)) =
                e₂ ≫ (ε_sh₂.app (R.obj S₀.X₂) ≫ (R.map S₀.g ≫ k)) := fun k =>
            (CategoryTheory.Category.assoc ((SC₀.map W_B).map Sh₂).f e₃ _).symm.trans
              ((congrArg (· ≫ (ε_sh₂.app (R.obj S₀.X₃) ≫ k)) hSh_sq).trans
                ((CategoryTheory.Category.assoc e₂ (Sh₂.map (R.map S₀.g).hom) _).trans
                  (congrArg (e₂ ≫ ·)
                    ((CategoryTheory.Category.assoc (Sh₂.map (R.map S₀.g).hom) _ k).symm.trans
                      ((congrArg (· ≫ k) hε_sq).trans
                        (CategoryTheory.Category.assoc _ (R.map S₀.g) k))))))
          have h1 : ((SC₀.map W_B).map Sh₂).f ≫ (e₃ ≫ (ε_sh₂.app (R.obj S₀.X₃) ≫ k₁)) =
              ((SC₀.map W_B).map Sh₂).f ≫ (e₃ ≫ (ε_sh₂.app (R.obj S₀.X₃) ≫ k₂)) :=
            (hL k₁).trans ((congrArg (fun m => e₂ ≫ (ε_sh₂.app (R.obj S₀.X₂) ≫ m)) hk).trans
              (hL k₂).symm)
          have h2 : e₃ ≫ (ε_sh₂.app (R.obj S₀.X₃) ≫ k₁) = e₃ ≫ (ε_sh₂.app (R.obj S₀.X₃) ≫ k₂) :=
            (CategoryTheory.cancel_epi ((SC₀.map W_B).map Sh₂).f).mp h1
          have h3 : ε_sh₂.app (R.obj S₀.X₃) ≫ k₁ = ε_sh₂.app (R.obj S₀.X₃) ≫ k₂ := by
            have hCancel_e₃ : ∀ m : Sh₂.obj (W_B.obj S₀.X₃.obj) ⟶ Z_sh,
                e₃_inv ≫ (e₃ ≫ m) = m := fun m =>
              (CategoryTheory.Category.assoc e₃_inv e₃ m).symm.trans
                ((congrArg (· ≫ m) he₃_inv_hom).trans (CategoryTheory.Category.id_comp m))
            exact (hCancel_e₃ (ε_sh₂.app (R.obj S₀.X₃) ≫ k₁)).symm.trans
              ((congrArg (e₃_inv ≫ ·) h2).trans
                (hCancel_e₃ (ε_sh₂.app (R.obj S₀.X₃) ≫ k₂)))
          have h4 := congrArg (CategoryTheory.inv (ε_sh₂.app (R.obj S₀.X₃)) ≫ ·) h3
          exact (CategoryTheory.IsIso.inv_hom_id_assoc (ε_sh₂.app (R.obj S₀.X₃)) k₁).symm.trans
            (h4.trans (CategoryTheory.IsIso.inv_hom_id_assoc (ε_sh₂.app (R.obj S₀.X₃)) k₂))
        exact CategoryTheory.ShortComplex.ShortExact.mk' hLimR.1 hLimR.2 hEpi_g
      · 
        intro s hs
        obtain ⟨p₀, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : s ≠ 0)
        have hIsoApp : ∀ W : (S₁.Etale)ᵒᵖ, CategoryTheory.IsIso ((δ_nat (p₀ + 1)).app W) := by
          intro W
          let ℱ_W := weilPolyP1CohomologyRepSheaf S₁ W.unop
          have hBij : Function.Bijective
              (hSE₀.extClass.postcomp ℱ_W (rfl : (p₀ + 1) + 1 = p₀ + 2)) := by
            refine ⟨?_, ?_⟩
            · intro x₁ x₂ hx_eq
              have hx₀ : (hSE₀.extClass.postcomp ℱ_W (rfl : (p₀ + 1) + 1 = p₀ + 2))
                  (x₁ - x₂) = 0 := by
                rw [map_sub, hx_eq, sub_self]
              suffices h0 : x₁ - x₂ = 0 from sub_eq_zero.mp h0
              obtain ⟨u, hu⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
                ℱ_W hSE₀ (x₁ - x₂) rfl hx₀
              have hu0 : u = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective u
              rw [← hu, hu0, CategoryTheory.Abelian.Ext.zero_comp]
            · intro y
              have hy_f : y.comp (CategoryTheory.Abelian.Ext.mk₀ S₀.f)
                  (Nat.add_zero ((p₀ + 1) + 1)) = 0 :=
                CategoryTheory.Abelian.Ext.eq_zero_of_injective _
              exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ ℱ_W hSE₀ y hy_f rfl
          let eW := AddEquiv.toAddCommGrpIso
            (X := (S₀.X₃.cohomologyPresheaf (p₀ + 1)).obj W)
            (Y := (S₀.X₁.cohomologyPresheaf (p₀ + 2)).obj W)
            (AddEquiv.ofBijective _ hBij)
          have heW : (δ_nat (p₀ + 1)).app W = eW.hom := rfl
          rw [heW]
          infer_instance
        haveI : CategoryTheory.IsIso (δ_nat (p₀ + 1)) :=
          CategoryTheory.NatIso.isIso_of_isIso_app (δ_nat (p₀ + 1))
        let e_sh : weilEtaleHigherDirectImage h (p₀ + 1) S₀.X₃ ≅
            weilEtaleHigherDirectImage h (p₀ + 2) S₀.X₁ :=
          Sh₂.mapIso (W_B.mapIso (CategoryTheory.asIso (δ_nat (p₀ + 1))))
        exact CategoryTheory.Limits.IsZero.of_iso (hPX₁ (p₀ + 2) (by omega)) e_sh

    let Λ₀ : ∀ (m : ℕ) (H : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}),
        CategoryTheory.Abelian.Ext A₀ (R.obj H) m →+
          CategoryTheory.Abelian.Ext (L.obj A₀) H m :=
      fun m H =>
        ((CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app H)).postcomp
          (L.obj A₀) (Nat.add_zero m)).comp
          (L.mapExtAddHom A₀ (R.obj H) m)

    have hΛ₀_apply : ∀ (m : ℕ) (H : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u})
        (w : CategoryTheory.Abelian.Ext A₀ (R.obj H) m),
        Λ₀ m H w =
          (CategoryTheory.Abelian.Ext.mapExactFunctor L w).comp
            (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app H)) (Nat.add_zero m) := by
      intro m H w
      change ((L.mapExtAddHom A₀ (R.obj H) m) w).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app H)) (Nat.add_zero m) = _
      rw [CategoryTheory.Functor.mapExtAddHom_apply]

    have hΛ₀_bij : ∀ (m : ℕ) (H : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}),
        P H → Function.Bijective (Λ₀ m H) := by
      intro m
      induction m with
      | zero =>
        intro H _
        let e₀ : CategoryTheory.Abelian.Ext A₀ (R.obj H) 0 ≃
            CategoryTheory.Abelian.Ext (L.obj A₀) H 0 :=
          CategoryTheory.Abelian.Ext.homEquiv₀.trans
            ((adj.homEquiv A₀ H).symm.trans CategoryTheory.Abelian.Ext.homEquiv₀.symm)
        have he₀ : (⇑(Λ₀ 0 H) : CategoryTheory.Abelian.Ext A₀ (R.obj H) 0 → _) = ⇑e₀ := by
          ext w
          let u : A₀ ⟶ R.obj H := CategoryTheory.Abelian.Ext.homEquiv₀ w
          have hw : w = CategoryTheory.Abelian.Ext.mk₀ u := by
            rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply]
            exact (CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply w).symm
          rw [hΛ₀_apply, hw, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
          change CategoryTheory.Abelian.Ext.mk₀ (L.map u ≫ adj.counit.app H) =
            CategoryTheory.Abelian.Ext.homEquiv₀.symm
              ((adj.homEquiv A₀ H).symm
                (CategoryTheory.Abelian.Ext.homEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ u)))
          rw [CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
            ← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply u, Equiv.apply_symm_apply,
            CategoryTheory.Adjunction.homEquiv_counit]
        rw [he₀]
        exact e₀.bijective
      | succ m ih =>
        intro H hPH
        let I := CategoryTheory.Injective.under H
        let α : H ⟶ I := CategoryTheory.Injective.ι H
        let Q := CategoryTheory.Limits.cokernel α
        let β : I ⟶ Q := CategoryTheory.Limits.cokernel.π α
        let S₀ := CategoryTheory.ShortComplex.mk α β (CategoryTheory.Limits.cokernel.condition α)
        have hCoker : CategoryTheory.Limits.IsColimit
            (CategoryTheory.Limits.CokernelCofork.ofπ S₀.g S₀.zero) :=
          CategoryTheory.Limits.CokernelCofork.IsColimit.ofπ' β
            (CategoryTheory.Limits.cokernel.condition α)
            (fun k hk => ⟨CategoryTheory.Limits.cokernel.desc α k hk,
              CategoryTheory.Limits.cokernel.π_desc α k hk⟩)
        have hSE₀ : S₀.ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk'
            (CategoryTheory.ShortComplex.exact_of_g_is_cokernel S₀ hCoker)
            inferInstance inferInstance
        have hPI : P I := hP_inj I inferInstance
        obtain ⟨hSE₁, hPQ⟩ := hP_ses S₀ hSE₀ inferInstance hPH
        let S₁_sc := S₀.map R
        let S₂_sc := S₁_sc.map L
        have hSE₂ : S₂_sc.ShortExact := hSE₁.map_of_exact L
        haveI : CategoryTheory.Injective S₁_sc.X₂ :=
          CategoryTheory.Adjunction.map_injective adj I inferInstance
        let ε_sc : S₂_sc ⟶ S₀ :=
          { τ₁ := adj.counit.app H
            τ₂ := adj.counit.app I
            τ₃ := adj.counit.app Q
            comm₁₂ := (adj.counit.naturality α).symm
            comm₂₃ := (adj.counit.naturality β).symm }
        have hSq₁ : ∀ u₁ : CategoryTheory.Abelian.Ext A₀ (R.obj I) m,
            Λ₀ m Q (u₁.comp (CategoryTheory.Abelian.Ext.mk₀ S₁_sc.g) (Nat.add_zero m)) =
              (Λ₀ m I u₁).comp (CategoryTheory.Abelian.Ext.mk₀ S₀.g) (Nat.add_zero m) := by
          intro u₁
          rw [hΛ₀_apply, hΛ₀_apply, CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
            CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero m) (Nat.zero_add 0)
              (by omega),
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero m) (Nat.zero_add 0)
              (by omega),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
          congr 2
          exact adj.counit.naturality β
        have hSq₂ : ∀ y₁ : CategoryTheory.Abelian.Ext A₀ (R.obj Q) m,
            Λ₀ (m + 1) H (y₁.comp hSE₁.extClass rfl) =
              (Λ₀ m Q y₁).comp hSE₀.extClass rfl := by
          intro y₁
          rw [hΛ₀_apply, hΛ₀_apply, CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
            CategoryTheory.Abelian.Ext.mapExactFunctor_extClass L hSE₁,
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _ rfl (Nat.add_zero 1) (by omega),
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero m) (Nat.zero_add 1)
              (by omega)]
          congr 1
          exact CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE₂ hSE₀ ε_sc
        refine ⟨?_, ?_⟩
        · intro w₁ w₂ hw_eq
          have hw₀ : Λ₀ (m + 1) H (w₁ - w₂) = 0 := by
            rw [map_sub, hw_eq, sub_self]
          suffices hzero : w₁ - w₂ = 0 from sub_eq_zero.mp hzero
          set w := w₁ - w₂
          have hw_f : w.comp (CategoryTheory.Abelian.Ext.mk₀ S₁_sc.f) (Nat.add_zero (m + 1)) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨y₁, hy₁⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ A₀ hSE₁ w hw_f rfl
          have hy₁_bdry : (Λ₀ m Q y₁).comp hSE₀.extClass rfl = 0 := by
            rw [← hSq₂ y₁, hy₁]
            exact hw₀
          obtain ⟨u₀, hu₀⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ (L.obj A₀) hSE₀ (Λ₀ m Q y₁) rfl
              hy₁_bdry
          obtain ⟨u₁, hu₁⟩ := (ih I hPI).2 u₀
          have hy₁_eq : y₁ = u₁.comp (CategoryTheory.Abelian.Ext.mk₀ S₁_sc.g) (Nat.add_zero m) := by
            apply (ih Q hPQ).1
            rw [hSq₁ u₁, hu₁, hu₀]
          rw [← hy₁, hy₁_eq,
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero m) (Nat.zero_add 1)
              (by omega),
            CategoryTheory.ShortComplex.ShortExact.comp_extClass hSE₁,
            CategoryTheory.Abelian.Ext.comp_zero]
        · intro x
          have hx_f : x.comp (CategoryTheory.Abelian.Ext.mk₀ S₀.f) (Nat.add_zero (m + 1)) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨y₀, hy₀⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (L.obj A₀) hSE₀ x hx_f rfl
          obtain ⟨y₁, hy₁⟩ := (ih Q hPQ).2 y₀
          refine ⟨y₁.comp hSE₁.extClass rfl, ?_⟩
          rw [hSq₂ y₁, hy₁, hy₀]

    have hι_Λ : (CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp (Λ₀ q F z) (Nat.zero_add q) = 0 := by
      change (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((L.mapExtAddHom A₀ (R.obj F) q) z) (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj.counit.app F)) (Nat.add_zero q)) = 0 at hz
      rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add q) (Nat.add_zero q)
        (by omega)] at hz
      exact hz
    have hΛ_z : Λ₀ q F z = 0 := by
      have h1 := congrArg
        (fun w => (CategoryTheory.Abelian.Ext.mk₀ πℤ).comp w (Nat.zero_add q))
        hι_Λ
      rw [CategoryTheory.Abelian.Ext.comp_zero,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add 0) (Nat.zero_add q) (by omega),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hπι,
        CategoryTheory.Abelian.Ext.mk₀_id_comp] at h1
      exact h1
    exact (hΛ₀_bij q F hF_acyc).1 (hΛ_z.trans (map_zero (Λ₀ q F)).symm)

theorem weil_alt_leray_geom_fiber_vanishing_of_pbc_pullback {Y₀ X₀ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₀ X₀)
    (V_X : X₀.Opens) (hFin_V : AlgebraicGeometry.IsFinite (h ∣_ V_X))
    (G : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u})
    (s : ℕ) (hs : 1 ≤ s)
    (hStalk : WeilAltLerayStalkZeroOutside ((TopologicalSpace.Opens.map h.base).obj V_X) G)
    (hBaseChange : ∀ (x : ↥X₀),
      let Ω := AlgebraicClosure ↥(X₀.residueField x)
      let gx : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) X₀ :=
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥(X₀.residueField x) Ω)))
          (X₀.fromSpecResidueField x)
      ∀ (F' : CategoryTheory.Sheaf
          (CategoryTheory.Limits.pullback h gx).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback (CategoryTheory.Limits.pullback.fst h gx) G F' →
        WeilIsEtaleSheafPullback gx
          (weilEtaleHigherDirectImage h s G)
          (weilEtaleHigherDirectImage (CategoryTheory.Limits.pullback.snd h gx) s F')) :
    CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h s G) :=
by
  have hSheafEqZeroOfCover (Z : AlgebraicGeometry.Scheme.{u})
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (W : Z.Etale) (sec : ↥(F.obj.obj (Opposite.op W)))
      (R : CategoryTheory.Sieve W)
      (hR : R ∈ Z.smallEtaleTopology W)
      (hzero : ∀ ⦃V : Z.Etale⦄ (f : V ⟶ W), R.arrows f → (F.obj.map f.op).hom sec = 0) :
      sec = 0 := by
    let Eℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let zeroW : Eℤ ⟶ F.obj.obj (Opposite.op W) := 0
    let φ₁ : Eℤ ⟶ F.obj.obj (Opposite.op W) :=
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • sec
          map_zero' := zero_zsmul sec
          map_add' := fun a b => add_zsmul sec a.down b.down }
    let x₀ : CategoryTheory.Presieve.FamilyOfElements
        (F.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Eℤ)) R.arrows :=
      fun V _ _ => (0 : Eℤ ⟶ F.obj.obj (Opposite.op V))
    have hSheaf := F.property Eℤ R hR
    have hAmalg₁ : x₀.IsAmalgamation φ₁ := by
      intro V f hf
      change φ₁ ≫ F.obj.map f.op = (0 : Eℤ ⟶ F.obj.obj (Opposite.op V))
      apply AddCommGrpCat.ext
      intro ⟨n⟩
      change (F.obj.map f.op).hom (n • sec) = 0
      rw [map_zsmul, hzero f hf, zsmul_zero]
    have hAmalg₂ : x₀.IsAmalgamation zeroW := by
      intro V f _
      change zeroW ≫ F.obj.map f.op = (0 : Eℤ ⟶ F.obj.obj (Opposite.op V))
      exact Limits.zero_comp
    have hEq : φ₁ = zeroW := hSheaf.isSeparatedFor x₀ φ₁ zeroW hAmalg₁ hAmalg₂
    have h1 : φ₁.hom (ULift.up 1) = zeroW.hom (ULift.up 1) :=
      congrArg (fun φ => φ.hom (ULift.up 1)) hEq
    simpa [φ₁, zeroW] using h1

  have hSheafifyIsZero (Z : AlgebraicGeometry.Scheme.{u})
      (P : Opposite Z.Etale ⥤ AddCommGrpCat.{u})
      (hLoc : ∀ (U : Z.Etale) (c : ↥(P.obj (Opposite.op U))),
        ∃ R ∈ Z.smallEtaleTopology U,
          ∀ ⦃V : Z.Etale⦄ (g : V ⟶ U), R.arrows g → (P.map g.op).hom c = 0) :
      Limits.IsZero ((presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj P) := by
    let S_P := (presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj P
    let adj_sh := sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    let η : P ⟶ S_P.obj := adj_sh.unit.app P
    have hη_zero : η = 0 := by
      ext U c
      obtain ⟨R, hR, hkill⟩ := hLoc U.unop c
      refine hSheafEqZeroOfCover Z S_P U.unop ((η.app (Opposite.op U.unop)).hom c) R hR ?_
      intro V g hg
      have hnat := congrArg (fun φ => φ.hom c) (η.naturality g.op)
      change (S_P.obj.map g.op).hom ((η.app (Opposite.op U.unop)).hom c) = 0
      have hnat' : (S_P.obj.map g.op).hom ((η.app (Opposite.op U.unop)).hom c) =
          (η.app (Opposite.op V)).hom ((P.map g.op).hom c) := hnat.symm
      rw [hnat', hkill g hg, map_zero]
    rw [Limits.IsZero.iff_id_eq_zero]
    apply (adj_sh.homEquiv P S_P).injective
    have h_lhs : adj_sh.homEquiv P S_P (𝟙 S_P) = 0 := by
      change η ≫ (sheafToPresheaf _ _).map (𝟙 S_P) = 0
      rw [hη_zero, Limits.zero_comp]
    have h_rhs : adj_sh.homEquiv P S_P 0 = 0 := by
      change η ≫ (sheafToPresheaf _ _).map (0 : S_P ⟶ S_P) = 0
      rw [hη_zero, Limits.zero_comp]
    rw [h_lhs, h_rhs]

  have hSecAlgClosed (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      {P : AlgebraicGeometry.Scheme.{u}}
      (q : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      [AlgebraicGeometry.Etale q] (p₀ : ↥P) :
      ∃ s_P : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ P,
        s_P ≫ q = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ∧
        ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), s_P.base pt = p₀ := by
    obtain ⟨W_P, hW_P, hp₀, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := p₀) (U := ⊤) trivial
    have : AlgebraicGeometry.IsAffine W_P.toScheme := hW_P
    let R_cat : CommRingCat.{u} := W_P.toScheme.presheaf.obj (Opposite.op ⊤)
    let R_W : Type u := ↑R_cat
    let e_W : W_P.toScheme ≅ AlgebraicGeometry.Spec R_cat := W_P.toScheme.isoSpec
    let q_W : AlgebraicGeometry.Spec R_cat ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
      e_W.inv ≫ W_P.ι ≫ q
    have : AlgebraicGeometry.Etale q_W := inferInstance
    let φ_cat : CommRingCat.of Ω ⟶ R_cat := AlgebraicGeometry.Spec.preimage q_W
    have hφ_map : AlgebraicGeometry.Spec.map φ_cat = q_W :=
      AlgebraicGeometry.Spec.map_preimage q_W
    have hEt_φ : φ_cat.hom.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (hφ_map.symm ▸ inferInstance)
    let _ : Algebra Ω R_W := φ_cat.hom.toAlgebra
    have : Algebra.Etale Ω R_W := RingHom.etale_algebraMap.mp hEt_φ
    let x_W : PrimeSpectrum R_W := e_W.hom.base ⟨p₀, hp₀⟩
    let J : Ideal R_W := x_W.asIdeal
    have : J.IsPrime := x_W.isPrime
    let L := Localization.AtPrime J
    let κ := IsLocalRing.ResidueField L
    have : Algebra.EssFiniteType R_W L :=
      Algebra.EssFiniteType.of_isLocalization L J.primeCompl
    have : Algebra.EssFiniteType Ω L := Algebra.EssFiniteType.comp Ω R_W L
    have : Algebra.FormallyUnramified R_W L :=
      Algebra.FormallyUnramified.of_isLocalization J.primeCompl
    have : Algebra.FormallyUnramified Ω L := Algebra.FormallyUnramified.comp Ω R_W L
    have hAlg : Algebra.IsAlgebraic Ω κ := by
      refine ⟨fun z => ?_⟩
      obtain ⟨p, hp_ne, hp_eval⟩ :=
        (Algebra.IsSeparable.isAlgebraic (IsLocalRing.ResidueField Ω) κ).1 z
      let e_Ω : Ω ≃+* IsLocalRing.ResidueField Ω :=
        RingEquiv.ofBijective (IsLocalRing.residue Ω)
          ⟨RingHom.injective _, Ideal.Quotient.mk_surjective⟩
      refine ⟨p.map e_Ω.symm.toRingHom, Polynomial.map_ne_zero hp_ne, ?_⟩
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      have hcomp : (algebraMap Ω κ).comp e_Ω.symm.toRingHom =
          algebraMap (IsLocalRing.ResidueField Ω) κ := by
        ext w
        obtain ⟨c, rfl⟩ : ∃ c : Ω, e_Ω c = w := e_Ω.surjective w
        simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
          RingEquiv.symm_apply_apply]
        exact (IsLocalRing.ResidueField.map_residue (algebraMap Ω L) c).symm
      rw [hcomp, ← Polynomial.aeval_def, hp_eval]
    let σ : κ →ₐ[Ω] Ω := IsAlgClosed.lift
    let ψ : R_W →+* Ω := σ.toRingHom.comp (algebraMap R_W κ)
    let ψ_cat : R_cat ⟶ CommRingCat.of Ω := CommRingCat.ofHom ψ
    have hφψ : φ_cat ≫ ψ_cat = 𝟙 (CommRingCat.of Ω) := by
      ext c
      change σ (algebraMap R_W κ (algebraMap Ω R_W c)) = c
      rw [← IsScalarTower.algebraMap_apply Ω R_W κ, σ.commutes]
      rfl
    refine ⟨AlgebraicGeometry.Spec.map ψ_cat ≫ e_W.inv ≫ W_P.ι, ?_, ?_⟩
    · calc
        (AlgebraicGeometry.Spec.map ψ_cat ≫ e_W.inv ≫ W_P.ι) ≫ q
            = AlgebraicGeometry.Spec.map ψ_cat ≫ q_W := by simp only [q_W, Category.assoc]
        _ = AlgebraicGeometry.Spec.map ψ_cat ≫ AlgebraicGeometry.Spec.map φ_cat := by rw [hφ_map]
        _ = AlgebraicGeometry.Spec.map (φ_cat ≫ ψ_cat) := (AlgebraicGeometry.Spec.map_comp _ _).symm
        _ = 𝟙 _ := by rw [hφψ, AlgebraicGeometry.Spec.map_id]
    · intro pt
      have hpt_bot : pt.asIdeal = ⊥ :=
        (Ideal.eq_bot_or_top pt.asIdeal).resolve_right pt.isPrime.ne_top
      have h_spec_pt : (AlgebraicGeometry.Spec.map ψ_cat).base pt = x_W := by
        apply PrimeSpectrum.ext
        ext r
        change r ∈ Ideal.comap ψ pt.asIdeal ↔ r ∈ J
        rw [hpt_bot, Ideal.mem_comap, Ideal.mem_bot]
        change σ (algebraMap R_W κ r) = 0 ↔ r ∈ J
        rw [map_eq_zero_iff σ σ.injective]
        change IsLocalRing.residue L (algebraMap R_W L r) = 0 ↔ r ∈ J
        rw [IsLocalRing.residue_eq_zero_iff]
        have h_under := @Localization.AtPrime.under_maximalIdeal R_W _ J _
        exact Iff.of_eq (congrArg (r ∈ ·) h_under)
      have h_inv_x : e_W.inv.base x_W = ⟨p₀, hp₀⟩ := by
        change (e_W.hom ≫ e_W.inv).base ⟨p₀, hp₀⟩ = ⟨p₀, hp₀⟩
        rw [e_W.hom_inv_id]
        rfl
      change W_P.ι.base (e_W.inv.base ((AlgebraicGeometry.Spec.map ψ_cat).base pt)) = p₀
      rw [h_spec_pt, h_inv_x]
      rfl

  have h_mem_etale (Z : AlgebraicGeometry.Scheme.{u}) (W : Z.Etale) (S : CategoryTheory.Sieve W) :
      S ∈ Z.smallEtaleTopology W ↔
        ∀ x : ↥W.left, ∃ (V : Z.Etale) (f : V ⟶ W) (y : ↥V.left),
          S.arrows f ∧ f.left.base y = x := by
    let Et_prop : MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    have : MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hJ_eq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        Z (le_refl (@AlgebraicGeometry.Etale))
    refine (Iff.of_eq (congrArg (fun J : GrothendieckTopology Z.Etale => S ∈ J W) hJ_eq)).trans
      ((AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) W S).trans ?_)
    constructor
    · rintro hcov x
      obtain ⟨V, f, y, hf, _, hy⟩ := hcov x
      exact ⟨V, f, y, hf, hy⟩
    · intro hcov x
      obtain ⟨V, f, y, hf, hy⟩ := hcov x
      have hEt_f : Et_prop f.left :=
        CategoryTheory.MorphismProperty.of_postcomp Et_prop f.left W.hom W.prop
          ((MorphismProperty.Over.w f).symm ▸ V.prop)
      exact ⟨V, f, y, hf, hEt_f, hy⟩

  have hSite {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (u : Y₁ ⟶ Y₂) :
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) u :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) u :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_u : CategoryTheory.Functor Y₂.Etale Y₁.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ u
      ∃ (_hc : B_u.IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology),
        (B_u.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y₂.smallEtaleTopology Y₁.smallEtaleTopology).IsRightAdjoint := by
    let Et_prop : MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) u :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) u :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_u : CategoryTheory.Functor Y₂.Etale Y₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ u
    have hCompatPres : CompatiblePreserving Y₁.smallEtaleTopology B_u := by
      constructor
      intro ℱ Z T x hx Y'_1 Y'_2 W f₁ f₂ g₁ g₂ hg₁ hg₂ hcomm
      have : MorphismProperty.IsStableUnderComposition Et_prop :=
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      let g₁_left : Y'_1.left ⟶ Z.left := g₁.left
      let g₂_left : Y'_2.left ⟶ Z.left := g₂.left
      have hg₁_w : g₁_left ≫ Z.hom = Y'_1.hom := MorphismProperty.Over.w g₁
      have hg₂_w : g₂_left ≫ Z.hom = Y'_2.hom := MorphismProperty.Over.w g₂
      let P_left : Scheme.{u} := Limits.pullback g₁_left g₂_left
      let π₁_left : P_left ⟶ Y'_1.left := Limits.pullback.fst g₁_left g₂_left
      let π₂_left : P_left ⟶ Y'_2.left := Limits.pullback.snd g₁_left g₂_left
      have : Etale g₁_left :=
        MorphismProperty.of_postcomp Et_prop g₁_left Z.hom Z.prop (hg₁_w.symm ▸ Y'_1.prop)
      have : Etale g₂_left :=
        MorphismProperty.of_postcomp Et_prop g₂_left Z.hom Z.prop (hg₂_w.symm ▸ Y'_2.prop)
      have : Etale π₁_left := inferInstance
      have : Etale Y'_1.hom := Y'_1.prop
      let P_hom : P_left ⟶ Y₂ := π₁_left ≫ Y'_1.hom
      have : Etale P_hom := inferInstance
      let P_Y : Y₂.Etale := MorphismProperty.Over.mk ⊤ P_hom inferInstance
      let p₁ : P_Y ⟶ Y'_1 := MorphismProperty.Over.homMk π₁_left rfl trivial
      have hp₂_w : π₂_left ≫ Y'_2.hom = P_hom :=
        (congrArg (π₂_left ≫ ·) hg₂_w.symm).trans
          ((Category.assoc π₂_left g₂_left Z.hom).symm.trans
            ((congrArg (· ≫ Z.hom) Limits.pullback.condition.symm).trans
              ((Category.assoc π₁_left g₁_left Z.hom).trans (congrArg (π₁_left ≫ ·) hg₁_w))))
      let p₂ : P_Y ⟶ Y'_2 := MorphismProperty.Over.homMk π₂_left hp₂_w trivial
      have hp_eq : p₁ ≫ g₁ = p₂ ≫ g₂ :=
        MorphismProperty.Over.Hom.ext Limits.pullback.condition
      have hf_fst : (f₁.left ≫ Limits.pullback.fst Y'_1.hom u) ≫ g₁_left =
          (f₂.left ≫ Limits.pullback.fst Y'_2.hom u) ≫ g₂_left := by
        have hcomm_left : f₁.left ≫ (B_u.map g₁).left = f₂.left ≫ (B_u.map g₂).left :=
          congrArg (fun m => m.left) hcomm
        have h1 : (f₁.left ≫ (B_u.map g₁).left) ≫ Limits.pullback.fst Z.hom u =
            (f₁.left ≫ Limits.pullback.fst Y'_1.hom u) ≫ g₁_left :=
          (Category.assoc _ _ _).trans
            ((congrArg (f₁.left ≫ ·) (Limits.pullback.lift_fst _ _ _)).trans
              (Category.assoc _ _ _).symm)
        have h2 : (f₂.left ≫ (B_u.map g₂).left) ≫ Limits.pullback.fst Z.hom u =
            (f₂.left ≫ Limits.pullback.fst Y'_2.hom u) ≫ g₂_left :=
          (Category.assoc _ _ _).trans
            ((congrArg (f₂.left ≫ ·) (Limits.pullback.lift_fst _ _ _)).trans
              (Category.assoc _ _ _).symm)
        exact h1.symm.trans ((congrArg (· ≫ Limits.pullback.fst Z.hom u) hcomm_left).trans h2)
      let lift_P : W.left ⟶ P_left :=
        Limits.pullback.lift (f₁.left ≫ Limits.pullback.fst Y'_1.hom u)
          (f₂.left ≫ Limits.pullback.fst Y'_2.hom u) hf_fst
      have hlift_P_hom : lift_P ≫ P_hom = W.hom ≫ u :=
        (Category.assoc lift_P π₁_left Y'_1.hom).symm.trans
          ((congrArg (· ≫ Y'_1.hom) (Limits.pullback.lift_fst _ _ _)).trans
            ((Category.assoc f₁.left _ Y'_1.hom).trans
              ((congrArg (f₁.left ≫ ·) Limits.pullback.condition).trans
                ((Category.assoc f₁.left _ u).symm.trans
                  (congrArg (· ≫ u) (MorphismProperty.Over.w f₁))))))
      let f₁₂_left : W.left ⟶ (B_u.obj P_Y).left :=
        Limits.pullback.lift lift_P W.hom hlift_P_hom
      let f₁₂ : W ⟶ B_u.obj P_Y :=
        MorphismProperty.Over.homMk f₁₂_left (Limits.pullback.lift_snd _ _ _) trivial
      have hf₁₂_1 : f₁₂ ≫ B_u.map p₁ = f₁ := by
        apply MorphismProperty.Over.Hom.ext
        apply Limits.pullback.hom_ext
        · change (f₁₂_left ≫ (B_u.map p₁).left) ≫ Limits.pullback.fst Y'_1.hom u = _
          exact (Category.assoc _ _ _).trans
            ((congrArg (f₁₂_left ≫ ·) (Limits.pullback.lift_fst _ _ _)).trans
              ((Category.assoc f₁₂_left _ π₁_left).symm.trans
                ((congrArg (· ≫ π₁_left) (Limits.pullback.lift_fst _ _ _)).trans
                  (Limits.pullback.lift_fst _ _ _))))
        · change (f₁₂_left ≫ (B_u.map p₁).left) ≫ Limits.pullback.snd Y'_1.hom u = _
          exact (Category.assoc _ _ _).trans
            ((congrArg (f₁₂_left ≫ ·) (Limits.pullback.lift_snd _ _ _)).trans
              ((Limits.pullback.lift_snd _ _ _).trans (MorphismProperty.Over.w f₁).symm))
      have hf₁₂_2 : f₁₂ ≫ B_u.map p₂ = f₂ := by
        apply MorphismProperty.Over.Hom.ext
        apply Limits.pullback.hom_ext
        · change (f₁₂_left ≫ (B_u.map p₂).left) ≫ Limits.pullback.fst Y'_2.hom u = _
          exact (Category.assoc _ _ _).trans
            ((congrArg (f₁₂_left ≫ ·) (Limits.pullback.lift_fst _ _ _)).trans
              ((Category.assoc f₁₂_left _ π₂_left).symm.trans
                ((congrArg (· ≫ π₂_left) (Limits.pullback.lift_fst _ _ _)).trans
                  (Limits.pullback.lift_snd _ _ _))))
        · change (f₁₂_left ≫ (B_u.map p₂).left) ≫ Limits.pullback.snd Y'_2.hom u = _
          exact (Category.assoc _ _ _).trans
            ((congrArg (f₁₂_left ≫ ·) (Limits.pullback.lift_snd _ _ _)).trans
              ((Limits.pullback.lift_snd _ _ _).trans (MorphismProperty.Over.w f₂).symm))
      have hT_compat := hx p₁ p₂ hg₁ hg₂ hp_eq
      have h_ap := congrArg (ℱ.obj.map f₁₂.op) hT_compat
      have hL : ℱ.obj.map f₁₂.op ((B_u.op ⋙ ℱ.obj).map p₁.op (x g₁ hg₁)) =
          ℱ.obj.map f₁.op (x g₁ hg₁) := by
        rw [← hf₁₂_1, op_comp, ℱ.obj.map_comp]
        rfl
      have hR : ℱ.obj.map f₁₂.op ((B_u.op ⋙ ℱ.obj).map p₂.op (x g₂ hg₂)) =
          ℱ.obj.map f₂.op (x g₂ hg₂) := by
        rw [← hf₁₂_2, op_comp, ℱ.obj.map_comp]
        rfl
      exact hL.symm.trans (h_ap.trans hR)
    have hCovPres : CoverPreserving Y₂.smallEtaleTopology Y₁.smallEtaleTopology B_u := by
      refine ⟨fun {W} {S} hS => (h_mem_etale Y₁ (B_u.obj W) (S.functorPushforward B_u)).mpr ?_⟩
      intro y
      let fst_W : Limits.pullback W.hom u ⟶ W.left := Limits.pullback.fst W.hom u
      let snd_W : Limits.pullback W.hom u ⟶ Y₁ := Limits.pullback.snd W.hom u
      obtain ⟨V, f, v, hfS, hfv⟩ := (h_mem_etale Y₂ W S).mp hS (fst_W.base y)
      let fst_V : Limits.pullback V.hom u ⟶ V.left := Limits.pullback.fst V.hom u
      let snd_V : Limits.pullback V.hom u ⟶ Y₁ := Limits.pullback.snd V.hom u
      let g_left : Limits.pullback V.hom u ⟶ Limits.pullback W.hom u := (B_u.map f).left
      have hg_fst : g_left ≫ fst_W = fst_V ≫ f.left := Limits.pullback.lift_fst _ _ _
      have hg_snd : g_left ≫ snd_W = snd_V := Limits.pullback.lift_snd _ _ _
      have hf_w : f.left ≫ W.hom = V.hom := MorphismProperty.Over.w f
      have hpb_Bf : IsPullback g_left fst_V fst_W f.left := by
        refine (IsPullback.of_bot ?_ hg_fst.symm (IsPullback.of_hasPullback W.hom u)).flip
        rw [hg_snd, hf_w]
        exact IsPullback.of_hasPullback V.hom u
      obtain ⟨z₀, hz₀_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y v hfv.symm
      let v' : ↥(B_u.obj V).left := hpb_Bf.isoPullback.inv.base z₀
      refine ⟨B_u.obj V, B_u.map f, v', Sieve.image_mem_functorPushforward B_u S hfS, ?_⟩
      change (hpb_Bf.isoPullback.inv ≫ g_left).base z₀ = y
      rw [hpb_Bf.isoPullback_inv_fst]
      exact hz₀_fst
    have hc : B_u.IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology :=
      Functor.isContinuous_of_coverPreserving hCompatPres hCovPres
    let _ := hc
    let pf_u := B_u.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let e_sm : Y₂.AffineEtale ≌ SmallModel.{u} Y₂.AffineEtale := equivSmallModel.{u} Y₂.AffineEtale
    let G₂ : SmallModel.{u} Y₂.AffineEtale ⥤ Y₂.Etale :=
      e_sm.inverse ⋙ AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂
    have hCD_G₂ : G₂.IsCoverDense Y₂.smallEtaleTopology := by
      refine ⟨fun U => (h_mem_etale Y₂ U _).mpr fun x => ?_⟩
      obtain ⟨W_U, hW_U, hx, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
      have : AlgebraicGeometry.IsAffine W_U.toScheme := hW_U
      have : AlgebraicGeometry.Etale U.hom := U.prop
      let R_U : CommRingCat.{u} := W_U.toScheme.presheaf.obj (Opposite.op ⊤)
      let e_WU : W_U.toScheme ≅ AlgebraicGeometry.Spec R_U := W_U.toScheme.isoSpec
      have : AlgebraicGeometry.Etale (e_WU.inv ≫ W_U.ι ≫ U.hom) := inferInstance
      let A_U : Y₂.AffineEtale :=
        AlgebraicGeometry.Scheme.AffineEtale.mk (e_WU.inv ≫ W_U.ι ≫ U.hom)
      let m : SmallModel.{u} Y₂.AffineEtale := e_sm.functor.obj A_U
      let f_A : (AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂).obj A_U ⟶ U :=
        MorphismProperty.Over.homMk (e_WU.inv ≫ W_U.ι) (Category.assoc _ _ _) trivial
      let u_iso : G₂.obj m ≅ (AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂).obj A_U :=
        (AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂).mapIso (e_sm.unitIso.symm.app A_U)
      let f_m : G₂.obj m ⟶ U := u_iso.hom ≫ f_A
      let x_spec : ↥((AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂).obj A_U).left :=
        e_WU.hom.base ⟨x, hx⟩
      let y_m : ↥(G₂.obj m).left := u_iso.inv.left.base x_spec
      have h_in_pull : (Sieve.coverByImage G₂ U).arrows f_m :=
        Presieve.in_coverByImage G₂ f_m
      refine ⟨G₂.obj m, f_m, y_m, h_in_pull, ?_⟩
      have hy1 : u_iso.hom.left.base y_m = x_spec := by
        have h_id : u_iso.inv.left ≫ u_iso.hom.left = 𝟙 _ :=
          congrArg (fun m => m.left) u_iso.inv_hom_id
        change (u_iso.inv.left ≫ u_iso.hom.left).base x_spec = x_spec
        rw [h_id]
        rfl
      change f_A.left.base (u_iso.hom.left.base y_m) = x
      rw [hy1]
      change W_U.ι.base ((e_WU.hom ≫ e_WU.inv).base ⟨x, hx⟩) = x
      rw [e_WU.hom_inv_id]
      rfl
    let _ : G₂.IsCoverDense Y₂.smallEtaleTopology := hCD_G₂
    let _ : G₂.LocallyCoverDense Y₂.smallEtaleTopology :=
      Functor.locallyCoverDense_of_isCoverDense G₂ Y₂.smallEtaleTopology
    let _ : G₂.Full := Functor.Full.comp e_sm.inverse (AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂)
    let _ : G₂.Faithful := Functor.Faithful.comp e_sm.inverse (AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂)
    let _ : G₂.IsLocallyFull Y₂.smallEtaleTopology := Functor.IsLocallyFull.of_full G₂
    let _ : G₂.IsLocallyFaithful Y₂.smallEtaleTopology := Functor.IsLocallyFaithful.of_faithful G₂
    let J_M₂ := G₂.inducedTopology Y₂.smallEtaleTopology
    have : ∀ (X : Y₂.Etaleᵒᵖ), Limits.HasLimitsOfShape (StructuredArrow X G₂.op) AddCommGrpCat.{u} := by
      intro X
      have : LocallySmall.{u} (StructuredArrow X G₂.op) := inferInstance
      exact Limits.hasLimitsOfShape_of_equivalence
        (equivSmallModel.{u} (StructuredArrow X G₂.op)).symm
    let E₂ : Sheaf J_M₂ AddCommGrpCat.{u} ≌ Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u} :=
      Functor.sheafInducedTopologyEquivOfIsCoverDense G₂ Y₂.smallEtaleTopology AddCommGrpCat.{u}
    let _ : G₂.IsContinuous J_M₂ Y₂.smallEtaleTopology := inferInstance
    let _ : (G₂ ⋙ B_u).IsContinuous J_M₂ Y₁.smallEtaleTopology :=
      Functor.isContinuous_comp G₂ B_u J_M₂ Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let K := (G₂ ⋙ B_u).sheafPushforwardContinuous AddCommGrpCat.{u} J_M₂ Y₁.smallEtaleTopology
    have : K.IsRightAdjoint := inferInstance
    let adj_K := Adjunction.ofIsRightAdjoint K
    let iso_KE : pf_u ⋙ E₂.inverse ≅ K :=
      NatIso.ofComponents
        (fun F =>
          { hom :=
              { hom :=
                  { app := fun m => AddCommGrpCat.ofHom (AddMonoidHom.id _)
                    naturality := fun _ _ _ => by ext; rfl } }
            inv :=
              { hom :=
                  { app := fun m => AddCommGrpCat.ofHom (AddMonoidHom.id _)
                    naturality := fun _ _ _ => by ext; rfl } }
            hom_inv_id := Sheaf.hom_ext <| by ext m x; rfl
            inv_hom_id := Sheaf.hom_ext <| by ext m x; rfl })
        (fun _ => Sheaf.hom_ext <| by ext m x; rfl)
    let iso_pf : K ⋙ E₂.functor ≅ pf_u :=
      Functor.isoWhiskerRight iso_KE.symm E₂.functor ≪≫
        Functor.associator pf_u E₂.inverse E₂.functor ≪≫
        Functor.isoWhiskerLeft pf_u E₂.counitIso ≪≫
        Functor.rightUnitor pf_u
    exact ⟨hc, ⟨_, ⟨(E₂.symm.toAdjunction.comp adj_K).ofNatIsoRight iso_pf⟩⟩⟩

  let mkSkyPresheaf {C : Type (u + 1)} [Category.{u, u + 1} C]
      {J : GrothendieckTopology C} (Φ : GrothendieckTopology.Point.{u} J)
      (M : AddCommGrpCat.{u}) : Cᵒᵖ ⥤ AddCommGrpCat.{u} :=
    { obj := fun U => AddCommGrpCat.of (Φ.fiber.obj U.unop → ↥M)
      map := fun f => AddCommGrpCat.ofHom
        { toFun := fun sec τ => sec (Φ.fiber.map f.unop τ)
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      map_id := fun U => by
        apply AddCommGrpCat.ext
        intro sec
        funext τ
        change sec (Φ.fiber.map (𝟙 U.unop) τ) = sec τ
        rw [Φ.fiber.map_id]
        rfl
      map_comp := fun f g => by
        apply AddCommGrpCat.ext
        intro sec
        funext τ
        change sec (Φ.fiber.map (g.unop ≫ f.unop) τ) =
          sec (Φ.fiber.map f.unop (Φ.fiber.map g.unop τ))
        rw [Φ.fiber.map_comp]
        rfl }

  have mkSky_isSheaf {C : Type (u + 1)} [Category.{u, u + 1} C]
      {J : GrothendieckTopology C} (Φ : GrothendieckTopology.Point.{u} J)
      (M : AddCommGrpCat.{u}) :
      Presheaf.IsSheaf J (mkSkyPresheaf Φ M) := by
    intro E U S hS x hx
    have : IsCofiltered Φ.fiber.Elements := Φ.isCofiltered
    have hIndep : ∀ ⦃Y₁ Y₂ : C⦄ (f₁ : Y₁ ⟶ U) (f₂ : Y₂ ⟶ U)
        (hf₁ : S.arrows f₁) (hf₂ : S.arrows f₂)
        (y₁ : Φ.fiber.obj Y₁) (y₂ : Φ.fiber.obj Y₂) (e : ↥E),
        Φ.fiber.map f₁ y₁ = Φ.fiber.map f₂ y₂ →
        (x f₁ hf₁).hom e y₁ = (x f₂ hf₂).hom e y₂ := by
      intro Y₁ Y₂ f₁ f₂ hf₁ hf₂ y₁ y₂ e hmap
      let e₁ : Φ.fiber.Elements := Functor.elementsMk Φ.fiber Y₁ y₁
      let e₂ : Φ.fiber.Elements := Functor.elementsMk Φ.fiber Y₂ y₂
      let e₀ : Φ.fiber.Elements := Functor.elementsMk Φ.fiber U (Φ.fiber.map f₁ y₁)
      let m₁ : e₁ ⟶ e₀ := { hom := f₁, map_val := rfl }
      let m₂ : e₂ ⟶ e₀ := { hom := f₂, map_val := hmap.symm }
      obtain ⟨w, g₁, g₂, _⟩ := IsCofilteredOrEmpty.cone_objs e₁ e₂
      obtain ⟨w', k, hk⟩ := IsCofilteredOrEmpty.cone_maps (g₁ ≫ m₁) (g₂ ≫ m₂)
      have hk_arrow : (k.hom ≫ g₁.hom) ≫ f₁ = (k.hom ≫ g₂.hom) ≫ f₂ :=
        (Category.assoc k.hom g₁.hom f₁).trans
          ((congrArg Functor.Elements.Hom.hom hk).trans (Category.assoc k.hom g₂.hom f₂).symm)
      have hcompat := hx (k.hom ≫ g₁.hom) (k.hom ≫ g₂.hom) hf₁ hf₂ hk_arrow
      have heval := congrArg (fun φ => φ.hom e w'.val) hcompat
      have h1 : Φ.fiber.map (k.hom ≫ g₁.hom) w'.val = y₁ := (k ≫ g₁).map_val
      have h2 : Φ.fiber.map (k.hom ≫ g₂.hom) w'.val = y₂ := (k ≫ g₂).map_val
      change (x f₁ hf₁).hom e (Φ.fiber.map (k.hom ≫ g₁.hom) w'.val) =
        (x f₂ hf₂).hom e (Φ.fiber.map (k.hom ≫ g₂.hom) w'.val) at heval
      rwa [h1, h2] at heval
    let liftData := fun (τ : Φ.fiber.obj U) => Φ.jointly_surjective S hS τ
    let f_τ := fun τ => (liftData τ).choose_spec.choose
    let hf_τ := fun τ => (liftData τ).choose_spec.choose_spec.choose
    let y_τ := fun τ => (liftData τ).choose_spec.choose_spec.choose_spec.choose
    have hy_τ : ∀ τ, Φ.fiber.map (f_τ τ) (y_τ τ) = τ :=
      fun τ => (liftData τ).choose_spec.choose_spec.choose_spec.choose_spec
    let amalg : E ⟶ (mkSkyPresheaf Φ M).obj (Opposite.op U) :=
      AddCommGrpCat.ofHom
        { toFun := fun e τ => (x (f_τ τ) (hf_τ τ)).hom e (y_τ τ)
          map_zero' := by
            funext τ
            rw [map_zero]
            rfl
          map_add' := fun e₁ e₂ => by
            funext τ
            rw [map_add]
            rfl }
    refine ⟨amalg, ?_, ?_⟩
    · intro Y f hf
      apply AddCommGrpCat.ext
      intro e
      funext y
      change (x (f_τ (Φ.fiber.map f y)) (hf_τ (Φ.fiber.map f y))).hom e
        (y_τ (Φ.fiber.map f y)) = (x f hf).hom e y
      exact hIndep _ f _ hf _ y e (hy_τ (Φ.fiber.map f y))
    · intro z hz
      apply AddCommGrpCat.ext
      intro e
      funext τ
      have hz_f := hz (f_τ τ) (hf_τ τ)
      have heval := congrArg (fun φ => φ.hom e (y_τ τ)) hz_f
      change z.hom e (Φ.fiber.map (f_τ τ) (y_τ τ)) =
        (x (f_τ τ) (hf_τ τ)).hom e (y_τ τ) at heval
      rw [hy_τ τ] at heval
      exact heval

  let mkSkyFunctor {C : Type (u + 1)} [Category.{u, u + 1} C]
      {J : GrothendieckTopology C} (Φ : GrothendieckTopology.Point.{u} J) :
      AddCommGrpCat.{u} ⥤ Sheaf J AddCommGrpCat.{u} :=
    { obj := fun M => ⟨mkSkyPresheaf Φ M, mkSky_isSheaf Φ M⟩
      map := fun φ =>
        { hom :=
            { app := fun _ => AddCommGrpCat.ofHom
                { toFun := fun sec τ => φ.hom (sec τ)
                  map_zero' := by funext _; exact φ.hom.map_zero
                  map_add' := fun a b => by funext τ; exact φ.hom.map_add (a τ) (b τ) }
              naturality := fun _ _ _ => by ext; rfl } }
      map_id := fun _ => Sheaf.hom_ext <| by ext; rfl
      map_comp := fun _ _ => Sheaf.hom_ext <| by ext; rfl }

  have hSkyAdj {C : Type (u + 1)} [Category.{u, u + 1} C]
      {J : GrothendieckTopology C} (Φ : GrothendieckTopology.Point.{u} J) :
      Nonempty (Φ.sheafFiber (A := AddCommGrpCat.{u}) ⊣ mkSkyFunctor Φ) := by
    let descFn : ∀ (F : Sheaf J AddCommGrpCat.{u}) (M : AddCommGrpCat.{u})
        (β : F ⟶ (mkSkyFunctor Φ).obj M) (U : C) (τ : Φ.fiber.obj U),
        F.obj.obj (Opposite.op U) ⟶ M :=
      fun F _ β U τ => AddCommGrpCat.ofHom
        { toFun := fun sec => (β.hom.app (Opposite.op U)).hom sec τ
          map_zero' := by rw [map_zero]; rfl
          map_add' := fun a b => by rw [map_add]; rfl }
    have descNat : ∀ (F : Sheaf J AddCommGrpCat.{u}) (M : AddCommGrpCat.{u})
        (β : F ⟶ (mkSkyFunctor Φ).obj M) ⦃X Y : C⦄ (f : X ⟶ Y) (τ : Φ.fiber.obj X),
        F.obj.map f.op ≫ descFn F M β X τ = descFn F M β Y (Φ.fiber.map f τ) := by
      intro F M β X Y f τ
      ext sec
      exact congrArg (fun φ => φ.hom sec τ) (β.hom.naturality f.op)
    let fwdFn : ∀ (F : Sheaf J AddCommGrpCat.{u}) (M : AddCommGrpCat.{u}),
        (Φ.sheafFiber.obj F ⟶ M) → (F ⟶ (mkSkyFunctor Φ).obj M) :=
      fun F M α =>
        let α' : Φ.presheafFiber.obj F.obj ⟶ M := α
        { hom :=
            { app := fun U => AddCommGrpCat.ofHom
                { toFun := fun sec τ => (Φ.toPresheafFiber U.unop τ F.obj ≫ α').hom sec
                  map_zero' := by funext _; simp
                  map_add' := fun a b => by funext τ; simp }
              naturality := fun U V f => by
                apply AddCommGrpCat.ext
                intro sec
                funext τ
                exact congrArg (fun m => (m ≫ α').hom sec)
                  (Φ.toPresheafFiber_w f.unop τ F.obj) } }
    refine ⟨Adjunction.mkOfHomEquiv
      { homEquiv := fun F M =>
          { toFun := fwdFn F M
            invFun := fun β => Φ.presheafFiberDesc (descFn F M β) (descNat F M β)
            left_inv := fun α => by
              let α' : Φ.presheafFiber.obj F.obj ⟶ M := α
              change Φ.presheafFiberDesc (descFn F M (fwdFn F M α)) (descNat F M (fwdFn F M α)) = α'
              apply Φ.presheafFiber_hom_ext
              intro U τ
              refine (Φ.toPresheafFiber_presheafFiberDesc
                (descFn F M (fwdFn F M α)) (descNat F M (fwdFn F M α)) U τ).trans ?_
              ext sec
              rfl
            right_inv := fun β => by
              apply Sheaf.hom_ext
              refine NatTrans.ext (funext fun U => ?_)
              apply AddCommGrpCat.ext
              intro sec
              funext τ
              have h_desc := Φ.toPresheafFiber_presheafFiberDesc
                (descFn F M β) (descNat F M β) U.unop τ
              exact congrArg (fun φ => φ.hom sec) h_desc }
        homEquiv_naturality_left_symm := fun {F' F M} h_F β => by
          apply Φ.presheafFiber_hom_ext
          intro U τ
          have hLHS : Φ.toPresheafFiber U τ F'.obj ≫
              Φ.presheafFiberDesc (descFn F' M (h_F ≫ β)) (descNat F' M (h_F ≫ β)) =
              descFn F' M (h_F ≫ β) U τ :=
            Φ.toPresheafFiber_presheafFiberDesc
              (descFn F' M (h_F ≫ β)) (descNat F' M (h_F ≫ β)) U τ
          have h_map : Φ.toPresheafFiber U τ F'.obj ≫ Φ.presheafFiber.map h_F.hom =
              h_F.hom.app (Opposite.op U) ≫ Φ.toPresheafFiber U τ F.obj := by
            dsimp [GrothendieckTopology.Point.presheafFiber]
            exact Φ.toPresheafFiber_presheafFiberDesc
              (fun X x => h_F.hom.app (Opposite.op X) ≫ Φ.toPresheafFiber X x F.obj)
              (fun X Y f x =>
                (Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ Φ.toPresheafFiber X x F.obj) (h_F.hom.naturality f.op)).trans
                    ((Category.assoc _ _ _).trans
                      (congrArg (h_F.hom.app (Opposite.op Y) ≫ ·)
                        (Φ.toPresheafFiber_w f x F.obj)))))
              U τ
          let d_β : Φ.presheafFiber.obj F.obj ⟶ M :=
            Φ.presheafFiberDesc (descFn F M β) (descNat F M β)
          have hRHS : Φ.toPresheafFiber U τ F'.obj ≫ (Φ.presheafFiber.map h_F.hom ≫ d_β) =
              h_F.hom.app (Opposite.op U) ≫ descFn F M β U τ :=
            (Category.assoc _ _ d_β).symm.trans
              ((congrArg (· ≫ d_β) h_map).trans
                ((Category.assoc _ _ d_β).trans
                  (congrArg (h_F.hom.app (Opposite.op U) ≫ ·)
                    (Φ.toPresheafFiber_presheafFiberDesc (descFn F M β) (descNat F M β) U τ))))
          refine hLHS.trans (Eq.trans ?_ hRHS.symm)
          ext sec
          rfl
        homEquiv_naturality_right := fun {F M M'} α g_M => by
          apply Sheaf.hom_ext
          refine NatTrans.ext (funext fun U => ?_)
          apply AddCommGrpCat.ext
          intro sec
          funext τ
          rfl }⟩

  let mkSpecPoint (Ω : Type u) [Field Ω] [IsAlgClosed Ω] :
      GrothendieckTopology.Point.{u}
        (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology := (
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let Et_prop : MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    let T₀ : S_Ω.Etale := MorphismProperty.Over.mk ⊤ (𝟙 S_Ω) inferInstance
    let F₀ : S_Ω.Etale ⥤ Type u := coyoneda.obj (Opposite.op T₀)
    let hCofil : IsCofiltered F₀.Elements := Functor.isCofiltered_elements F₀
    let e_init : F₀.Elements := Functor.elementsMk F₀ T₀ (𝟙 T₀)
    let I_unit : Discrete (ULift.{u} Unit) ⥤ F₀.Elements :=
      (Functor.const (Discrete (ULift.{u} Unit))).obj e_init
    letI : IsCofilteredOrEmpty (Discrete (ULift.{u} Unit)) :=
      { cone_objs := fun X Y => by
          cases X with | mk x => cases Y with | mk y =>
          exact ⟨⟨⟨()⟩⟩, Discrete.eqToHom rfl, Discrete.eqToHom rfl, trivial⟩
        cone_maps := fun {X Y} _ _ => ⟨X, 𝟙 X, Subsingleton.elim _ _⟩ }
    have hInit : I_unit.Initial := by
      rw [Functor.initial_iff_of_isCofiltered]
      refine ⟨fun d => ⟨⟨⟨()⟩⟩, ⟨{ hom := d.val, map_val := Category.id_comp d.val }⟩⟩, ?_⟩
      intro d c s₁ s₂
      refine ⟨c, 𝟙 c, ?_⟩
      have hs₁ : s₁.hom = d.val := (Category.id_comp s₁.hom).symm.trans s₁.map_val
      have hs₂ : s₂.hom = d.val := (Category.id_comp s₂.hom).symm.trans s₂.map_val
      have heq : s₁ = s₂ := Functor.Elements.Hom.ext (hs₁.trans hs₂.symm)
      rw [heq]
    letI : I_unit.Initial := hInit
    let hSmall : InitiallySmall.{u} F₀.Elements := InitiallySmall.mk' I_unit
    let pt₀ : ↥S_Ω := ⟨⊥, Ideal.isPrime_bot⟩
    @GrothendieckTopology.Point.mk S_Ω.Etale _ S_Ω.smallEtaleTopology F₀ hCofil hSmall
      fun {U} R hR τ => by
        have : MorphismProperty.IsStableUnderComposition Et_prop :=
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition
        obtain ⟨V, f, v₀, hfR, hfv⟩ := (h_mem_etale S_Ω U R).mp hR (τ.left.base pt₀)
        have : Etale f.left :=
          MorphismProperty.of_postcomp Et_prop f.left U.hom U.prop
            ((MorphismProperty.Over.w f).symm ▸ V.prop)
        obtain ⟨p₀, _, _⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback v₀ pt₀ hfv
        let f_left : V.left ⟶ U.left := f.left
        let τ_left : S_Ω ⟶ U.left := τ.left
        have : Etale f_left := ‹Etale f.left›
        let q_pb : Limits.pullback f_left τ_left ⟶ S_Ω := Limits.pullback.snd f_left τ_left
        have : Etale q_pb := inferInstance
        obtain ⟨s_P, hs_q, _⟩ := hSecAlgClosed Ω q_pb p₀
        let τ'_left : S_Ω ⟶ V.left := s_P ≫ Limits.pullback.fst f_left τ_left
        have hτ'_f : τ'_left ≫ f.left = τ.left :=
          (Category.assoc s_P _ f_left).trans
            ((congrArg (s_P ≫ ·) Limits.pullback.condition).trans
              ((Category.assoc s_P q_pb τ_left).symm.trans
                ((congrArg (· ≫ τ_left) hs_q).trans (Category.id_comp τ_left))))
        have hτ'_w : τ'_left ≫ V.hom = 𝟙 S_Ω :=
          (congrArg (τ'_left ≫ ·) (MorphismProperty.Over.w f).symm).trans
            ((Category.assoc τ'_left f.left U.hom).symm.trans
              ((congrArg (· ≫ U.hom) hτ'_f).trans (MorphismProperty.Over.w τ)))
        let τ' : T₀ ⟶ V := MorphismProperty.Over.homMk τ'_left hτ'_w trivial
        exact ⟨V, f, hfR, τ', MorphismProperty.Over.Hom.ext hτ'_f⟩ )

  let mkGeomPoint (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (Z : AlgebraicGeometry.Scheme.{u})
      (g_pt : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z) :
      GrothendieckTopology.Point.{u} Z.smallEtaleTopology := (
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let Et_prop : MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    let T₀ : S_Ω.Etale := MorphismProperty.Over.mk ⊤ (𝟙 S_Ω) inferInstance
    let F₀ : S_Ω.Etale ⥤ Type u := coyoneda.obj (Opposite.op T₀)
    letI : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g_pt :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) g_pt :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_g : Z.Etale ⥤ S_Ω.Etale := MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g_pt
    let F_g : Z.Etale ⥤ Type u := B_g ⋙ F₀
    have : MorphismProperty.IsStableUnderComposition Et_prop :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hCofil_Fg : IsCofiltered F_g.Elements := by
      refine
        { toIsCofilteredOrEmpty :=
            { cone_objs := fun e₁ e₂ => ?_
              cone_maps := fun {e₁ e₂} f₁ f₂ => ?_ }
          nonempty := ?_ }
      · let U₁ := e₁.obj; let γ₁ := e₁.val
        let U₂ := e₂.obj; let γ₂ := e₂.val
        let u₁ : S_Ω ⟶ U₁.left := γ₁.left ≫ Limits.pullback.fst U₁.hom g_pt
        let u₂ : S_Ω ⟶ U₂.left := γ₂.left ≫ Limits.pullback.fst U₂.hom g_pt
        have hu₁ : u₁ ≫ U₁.hom = g_pt :=
          (Category.assoc γ₁.left _ U₁.hom).trans
            ((congrArg (γ₁.left ≫ ·) Limits.pullback.condition).trans
              ((Category.assoc γ₁.left _ g_pt).symm.trans
                ((congrArg (· ≫ g_pt) (MorphismProperty.Over.w γ₁)).trans (Category.id_comp g_pt))))
        have hu₂ : u₂ ≫ U₂.hom = g_pt :=
