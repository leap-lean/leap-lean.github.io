          let η' : Module.End L' ↥(T.maxGenEigenspace μ) := (μ ^ s') • ν + (μ • η + η * ν)
          have hsmul_nil : ∀ (c : L') (f : Module.End L' ↥(T.maxGenEigenspace μ)),
