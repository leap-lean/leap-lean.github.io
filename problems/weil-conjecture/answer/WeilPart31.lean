    let ξ_app : (One_sh Z₀).obj.obj (Opposite.op (M_gZ.obj (B_i'.obj (T_can Y')))) ⟶
        (One_sh Z₀).obj.obj (Opposite.op (B_i₀.obj (M_g.obj (T_can Y')))) :=
