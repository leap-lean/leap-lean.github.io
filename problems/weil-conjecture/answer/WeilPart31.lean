          exact hx
        | succ r' ihr =>
          intro x hx
          rw [pow_succ', Module.End.mul_eq_comp, LinearMap.comp_apply]
          exact hMaps_T μ (ihr hx)
      let S : Finset L' := T.charpoly.roots.toFinset
      have hSub : {μ : L' | T.maxGenEigenspace μ ≠ ⊥} ⊆ (S : Set L') := by
        intro μ hμ_ne
        rcases Submodule.exists_mem_ne_zero_of_ne_bot hμ_ne with ⟨x, hx_mem, hx_ne⟩
