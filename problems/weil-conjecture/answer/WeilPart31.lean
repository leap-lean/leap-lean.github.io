      refine ⟨μ, ?_⟩
      apply LinearMap.ext
      intro x
      change μ ((LinearMap.range D_map).subtype (D_map.rangeRestrict x)) = lam x
      rw [hμ (D_map.rangeRestrict x)]
      have hq : D_map.quotKerEquivRange.symm (D_map.rangeRestrict x) =
