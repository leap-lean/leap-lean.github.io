          τ ((α₀.comp δ rfl).comp β hpq)
        congr 1
        exact (CategoryTheory.Abelian.Ext.comp_assoc α₀ δ β
          (rfl : p + 1 = p + 1) (Nat.add_comm 1 q) (by omega : p + 1 + q = 2 * d)).symm
      have hSq2 : ∀ (γ : CategoryTheory.Abelian.Ext.{u} Q oneR (q + 1))
          (ξ : CategoryTheory.Abelian.Ext.{u} oneR A p),
