      have : Sheaf.IsLocallySurjective (pf₀.map α) := hLocSurj_pf
      exact Sheaf.epi_of_isLocallySurjective (pf₀.map α)

    let Z_fun : Z.Etale ⥤ Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
      yoneda ⋙ (Functor.whiskeringRight (Opposite Z.Etale) (Type u) AddCommGrpCat.{u}).obj
        AddCommGrpCat.free ⋙ presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}
    have hInd : ∀ (k : ℕ) (H : Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
        Limits.IsZero (weilEtaleHigherDirectImage f₀ (k + 1) H) := by
      intro k
      induction k with
      | zero =>
        intro H
        let J_inj : Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} := Injective.under H
        let ι : H ⟶ J_inj := Injective.ι H
        let Q : Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} := Limits.cokernel ι
        let π : J_inj ⟶ Q := Limits.cokernel.π ι
