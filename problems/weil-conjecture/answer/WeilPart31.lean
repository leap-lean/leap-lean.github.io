        have hβ_comp : β.comp α (Nat.add_zero 0) = eΥ0 G ⟨((C₀ 0).map s).hom x₀.1, hx_s⟩ := by
          have hx₀_eq : Υ₀ one₀ 0 x₀ = β := (eΥ0 one₀).apply_symm_apply β
          rw [← hx₀_eq, ← hs_mk]
