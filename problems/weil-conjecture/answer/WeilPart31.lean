        apply D_map.quotKerEquivRange.injective
        rw [LinearEquiv.apply_symm_apply]
        rfl
      change (LinearMap.ker D_map).liftQ lam hle
          (D_map.quotKerEquivRange.symm (D_map.rangeRestrict x)) = lam x
      rw [hq, Submodule.liftQ_apply]
    have hΨ_zero : ∀ (p : ℕ) (F : 𝒞₀), Ψ₀ p F 0 = 0 := by
      intro p F
      have h := hΨ_add₀ p F 0 0
      rw [add_zero] at h
      exact add_left_cancel (h.symm.trans (add_zero _).symm)
