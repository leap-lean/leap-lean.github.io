theorem weil_rankin_landau_curve_bound (ℓ q n : ℕ) [Fact (Nat.Prime ℓ)] (hq : 2 ≤ q)
    (γ : AlgebraicClosure (Padic ℓ))
    (hPkg : WeilSymplecticCurveTracePackage.{u} ℓ q n γ) :
    IsAlgebraic ℚ γ ∧
    ∀ β : ℂ, Polynomial.aeval β (minpoly ℚ γ) = 0 →
      (q : ℝ) ^ n ≤ ‖β‖ ^ 2 ∧ ‖β‖ ^ 2 ≤ (q : ℝ) ^ (n + 2) :=
by
  
  have h_polyProd_logDeriv : ∀ (A : Type) [CommRing A] (d₀ : ℕ), 1 ≤ d₀ →
      ∀ (S : Multiset A),
        let P_S : Polynomial A :=
          (S.map (fun μ => (1 : Polynomial A) - Polynomial.C μ * Polynomial.X ^ d₀)).prod
        P_S.coeff 0 = 1 ∧
        PowerSeries.X * PowerSeries.derivative (Polynomial.toPowerSeries P_S) =
          - Polynomial.toPowerSeries P_S *
            PowerSeries.mk (fun r =>
              if r ≠ 0 ∧ d₀ ∣ r then (d₀ : A) * (S.map (· ^ (r / d₀))).sum else 0) := by
    intro A _ d₀ hd₀
    have hd₀_ne : d₀ ≠ 0 := by omega
    have h_single : ∀ μ : A,
        let q_μ : Polynomial A := (1 : Polynomial A) - Polynomial.C μ * Polynomial.X ^ d₀
        let f_μ : PowerSeries A := Polynomial.toPowerSeries q_μ
        let L_μ : PowerSeries A :=
          PowerSeries.mk (fun r => if r ≠ 0 ∧ d₀ ∣ r then (d₀ : A) * μ ^ (r / d₀) else 0)
        q_μ.coeff 0 = 1 ∧
        PowerSeries.X * PowerSeries.derivative f_μ = - f_μ * L_μ := by
      intro μ q_μ f_μ L_μ
      have hq0 : q_μ.coeff 0 = 1 := by
        dsimp [q_μ]
        rw [Polynomial.coeff_sub, Polynomial.coeff_one_zero, Polynomial.coeff_C_mul,
          Polynomial.coeff_X_pow, ite_eq_right_iff.mpr (fun h => (hd₀_ne h.symm).elim),
          mul_zero, sub_zero]
      refine ⟨hq0, ?_⟩
      have hf_eq : f_μ = 1 - PowerSeries.C μ * PowerSeries.X ^ d₀ := by
        dsimp [f_μ, q_μ]
        rw [Polynomial.coe_sub, Polynomial.coe_one, Polynomial.coe_mul, Polynomial.coe_pow,
          Polynomial.coe_C, Polynomial.coe_X]
      have h_rhs_eq : - f_μ * L_μ = PowerSeries.C μ * (PowerSeries.X ^ d₀ * L_μ) - L_μ := by
        rw [hf_eq]
        ring
      rw [h_rhs_eq]
      ext r
      have h_lhs : PowerSeries.coeff r (PowerSeries.X * PowerSeries.derivative f_μ) =
          if r = d₀ then - ((d₀ : A) * μ) else 0 := by
        rcases r with _ | m
        · rw [PowerSeries.coeff_zero_X_mul, if_neg hd₀_ne.symm]
        · rw [PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_derivative]
          dsimp [f_μ, q_μ]
          rw [Polynomial.coeff_coe, Polynomial.coeff_sub, Polynomial.coeff_one,
            if_neg (Nat.succ_ne_zero m), Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
          by_cases hm : m + 1 = d₀
          · rw [if_pos hm, if_pos hm, zero_sub]
            subst hm
            push_cast
            ring
          · rw [if_neg hm, if_neg hm]
            ring
      rw [h_lhs, map_sub, PowerSeries.coeff_C_mul, PowerSeries.coeff_X_pow_mul']
      rcases lt_trichotomy d₀ r with hgt | rfl | hlt
      · have hle : d₀ ≤ r := le_of_lt hgt
        have hr_ne : r ≠ d₀ := ne_of_gt hgt
        have hm_ne : r - d₀ ≠ 0 := by omega
        have hr0 : r ≠ 0 := by omega
        rw [if_neg hr_ne, if_pos hle, PowerSeries.coeff_mk, PowerSeries.coeff_mk]
        have hdvd_iff : d₀ ∣ r - d₀ ↔ d₀ ∣ r := by
          have hr_add : r = (r - d₀) + d₀ := (Nat.sub_add_cancel hle).symm
          conv_rhs => rw [hr_add]
          exact (Nat.dvd_add_self_right).symm
        by_cases hdvd : d₀ ∣ r - d₀
        · have hdvd_r : d₀ ∣ r := hdvd_iff.mp hdvd
          rw [if_pos ⟨hm_ne, hdvd⟩, if_pos ⟨hr0, hdvd_r⟩]
          have hdiv : r / d₀ = (r - d₀) / d₀ + 1 := by
            have hr_add : r = (r - d₀) + d₀ := (Nat.sub_add_cancel hle).symm
            conv_lhs => rw [hr_add]
            exact Nat.add_div_right (r - d₀) hd₀
          rw [hdiv]
          ring
        · have hdvd_r : ¬ (d₀ ∣ r) := fun h => hdvd (hdvd_iff.mpr h)
          rw [if_neg (fun h => hdvd h.2), if_neg (fun h => hdvd_r h.2), mul_zero, sub_zero]
      · rw [if_pos rfl, if_pos (le_refl d₀), Nat.sub_self, PowerSeries.coeff_mk,
          PowerSeries.coeff_mk]
        simp only [ne_eq, not_true_eq_false, false_and, ↓reduceIte, mul_zero, zero_sub,
          hd₀_ne, not_false_eq_true, dvd_refl, and_self, Nat.div_self hd₀, pow_one]
      · have hnot : ¬ (d₀ ≤ r) := by omega
        have hnot_dvd : ¬ (r ≠ 0 ∧ d₀ ∣ r) := by
          rintro ⟨hr0, hdvd⟩
          exact hnot (Nat.le_of_dvd (Nat.pos_of_ne_zero hr0) hdvd)
        rw [if_neg (ne_of_lt hlt), if_neg hnot, PowerSeries.coeff_mk, if_neg hnot_dvd,
          mul_zero, sub_zero]
    intro S
    refine Multiset.induction_on S ?_ ?_
    · dsimp
      refine ⟨Polynomial.coeff_one_zero, ?_⟩
      ext r
      simp
    · intro μ S' ih
      rcases ih with ⟨hP0_S', hDeriv_S'⟩
      rcases h_single μ with ⟨hq0, hDeriv_μ⟩
      dsimp only at hP0_S' hDeriv_S' ⊢
      rw [Multiset.map_cons, Multiset.prod_cons]
      set q_μ : Polynomial A := (1 : Polynomial A) - Polynomial.C μ * Polynomial.X ^ d₀
      set P_S' : Polynomial A :=
        (S'.map (fun x => (1 : Polynomial A) - Polynomial.C x * Polynomial.X ^ d₀)).prod
      have hcoeff0 : (q_μ * P_S').coeff 0 = 1 := by
        rw [Polynomial.mul_coeff_zero, hq0, hP0_S', mul_one]
