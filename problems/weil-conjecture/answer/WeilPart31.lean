        B_K_a H_K_a p_img_a j_B_a q_H_a hz_B_a hEpi_p_a hFac_B_a hEx_B_a
        Y₁_a I₁_a ι_Y_a π_Y_a hz_Y_a hEx_Y_a hat_ψ_a f_lad_a hf0_a hfSucc_a
        i₁ i₂ M hBasis0_y hBasisSucc_y
    have hInj_E_all : ∀ p : ℕ, CategoryTheory.Injective (E.X p) :=
      hInj_E_fn (fun q _ s => hInj_I₁_a q s)
    have hKd_eq : ∀ (p m : ℕ) (hm : p + 1 = m),
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp (π_K_a p) (ι_K_a (p + 1)))
          (eqToHom (congrArg J_K_a hm)) = K.d p m := by
      intro p m hm
      subst hm
      rw [CategoryTheory.eqToHom_refl, CategoryTheory.Category.comp_id]
      exact (CochainComplex.of_d J_K_a
        (fun k => CategoryTheory.CategoryStruct.comp (π_K_a k) (ι_K_a (k + 1))) p).symm
    refine ⟨E, K, Φ,
      fun p _ => ⟨hInj_E_all p, hInj_K_a p⟩,
      hHomΦ,
      fun x hx => ?_⟩
    let α : Fin (b i₂) → CategoryTheory.Abelian.Ext.{u} one₁_a one₁_a i₁ :=
      fun t => (AddEquiv.ofBijective Θ₁_a hΘ₁_a_bij).symm (x t)
    have hα_Θ₁ : ∀ t : Fin (b i₂), Θ₁_a (α t) = x t :=
      fun t => AddEquiv.ofBijective_apply_symm_apply Θ₁_a hΘ₁_a_bij
    have hα_sum : ∑ t : Fin (b i₂), μ_a (Θ₁_a (α t)) (v₂_i₂ t) = 0 := by
      rw [← hx]
      exact Finset.sum_congr rfl fun t _ => by rw [hα_Θ₁ t]
    obtain ⟨z₀, hz₀_cocycle, hz₀_K, hz₀_kill⟩ :=
      hCupBridge_a i₁ i₂ α (hCup_a α hα_sum)
    obtain ⟨hz_cocycle, hz_Φ, hz_proj⟩ := hSummand one₁_a z₀ hz₀_cocycle
    refine ⟨CategoryTheory.CategoryStruct.comp z₀ ι_summand, hz_cocycle, ?_, ?_⟩
    · rcases hz₀_K with ⟨hn0, hz₀_f0⟩ | ⟨p, hp, b_K, hb_K⟩
