        intro G φ
        obtain ⟨L_φ, hL_φ⟩ := addHomToLinear (φ.comp (eΥ0 G).toAddMonoidHom)
        obtain ⟨μ_φ, hμ_φ⟩ := Module.Injective.out (K0 G).subtype
