          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ oneR hSq x hx0 rfl
        have hy0 : y = 0 := @Subsingleton.elim _ hSubNext y 0
        rw [← hy, hy0, CategoryTheory.Abelian.Ext.zero_comp]
      exact ⟨fun x₁ x₂ => (hzero_ext x₁).trans (hzero_ext x₂).symm⟩
    have hTopZ : ∀ k : ℕ, 1 ≤ k →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (Z (2 * d)) k) := by
      intro k hk
      have hZero2d1 : CategoryTheory.Limits.IsZero ((𝒯 (2 * d + 1)).obj F) :=
        hZero_gt (2 * d + 1) (by omega) F
      have hdiff_top : (diff (2 * d)).app F = 0 :=
        hZero2d1.eq_of_tgt ((diff (2 * d)).app F) 0
      let r_top : (𝒯 (2 * d)).obj F ⟶ Z (2 * d) :=
        CategoryTheory.Limits.kernel.lift ((diff (2 * d)).app F)
          (CategoryTheory.CategoryStruct.id ((𝒯 (2 * d)).obj F))
          (by rw [hdiff_top, CategoryTheory.Category.id_comp])
      have h_retract : ι (2 * d) ≫ r_top = CategoryTheory.CategoryStruct.id (Z (2 * d)) := by
        have : CategoryTheory.Mono (ι (2 * d)) := hι_mono (2 * d)
        apply (CategoryTheory.cancel_mono (ι (2 * d))).mp
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      have hSubT : Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR ((𝒯 (2 * d)).obj F) k) :=
        hAcyc (2 * d) k hk F
      have hzero_ext : ∀ x : CategoryTheory.Abelian.Ext.{u} oneR (Z (2 * d)) k, x = 0 := by
        intro x
        have hx_ι : x.comp (CategoryTheory.Abelian.Ext.mk₀ (ι (2 * d))) (Nat.add_zero k) = 0 :=
          @Subsingleton.elim _ hSubT _ 0
        calc
          x = x.comp (CategoryTheory.Abelian.Ext.mk₀
              (CategoryTheory.CategoryStruct.id (Z (2 * d)))) (Nat.add_zero k) :=
            (CategoryTheory.Abelian.Ext.comp_mk₀_id x).symm
          _ = x.comp (CategoryTheory.Abelian.Ext.mk₀ (ι (2 * d) ≫ r_top)) (Nat.add_zero k) := by
            rw [h_retract]
          _ = x.comp ((CategoryTheory.Abelian.Ext.mk₀ (ι (2 * d))).comp
              (CategoryTheory.Abelian.Ext.mk₀ r_top) (Nat.add_zero 0)) (Nat.add_zero k) := by
            rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
          _ = (x.comp (CategoryTheory.Abelian.Ext.mk₀ (ι (2 * d))) (Nat.add_zero k)).comp
              (CategoryTheory.Abelian.Ext.mk₀ r_top) (Nat.add_zero k) :=
            (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
          _ = 0 := by rw [hx_ι, CategoryTheory.Abelian.Ext.zero_comp]
      exact ⟨fun x₁ x₂ => (hzero_ext x₁).trans (hzero_ext x₂).symm⟩
    have hShiftZ : ∀ (b a : ℕ), a + b = 2 * d → ∀ (k : ℕ), 1 ≤ k →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (Z a) (k + b)) := by
      intro b
      induction b with
      | zero =>
        intro a ha k hk
        have ha_eq : a = 2 * d := by omega
        subst ha_eq
        simpa using hTopZ k hk
      | succ b ih =>
        intro a hab k hk
        have hab' : (a + 1) + b = 2 * d := by omega
        have hSubNext := ih (a + 1) hab' k hk
        have hStep := hStepZ a (k + b) (by omega) hSubNext
        simpa [Nat.add_assoc] using hStep
    obtain ⟨k', hk'⟩ := Nat.exists_eq_add_of_lt hp
    have hkp : (k' + 1) + 2 * d = p := by omega
    have hSubZ0 : Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR (Z 0) p) := by
      rw [← hkp]
      exact hShiftZ (2 * d) 0 (Nat.zero_add (2 * d)) (k' + 1) (by omega)
    have hzero_F : ∀ x : CategoryTheory.Abelian.Ext.{u} oneR F p, x = 0 := by
      intro x
      have hx_e : x.comp (CategoryTheory.Abelian.Ext.mk₀ e_ker) (Nat.add_zero p) = 0 :=
        @Subsingleton.elim _ hSubZ0 _ 0
      calc
        x = x.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id F))
            (Nat.add_zero p) := (CategoryTheory.Abelian.Ext.comp_mk₀_id x).symm
        _ = x.comp (CategoryTheory.Abelian.Ext.mk₀ (e_ker ≫ CategoryTheory.inv e_ker))
            (Nat.add_zero p) := by rw [CategoryTheory.IsIso.hom_inv_id]
        _ = x.comp ((CategoryTheory.Abelian.Ext.mk₀ e_ker).comp
            (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv e_ker)) (Nat.add_zero 0))
            (Nat.add_zero p) := by rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        _ = (x.comp (CategoryTheory.Abelian.Ext.mk₀ e_ker) (Nat.add_zero p)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv e_ker)) (Nat.add_zero p) :=
          (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
        _ = 0 := by rw [hx_e, CategoryTheory.Abelian.Ext.zero_comp]
    exact ⟨fun x₁ x₂ => (hzero_F x₁).trans (hzero_F x₂).symm⟩
  
  have hDualExt : WeilHasVerdierDualExtPackage S d m τ :=
    weil_etale_verdier_dual_injective_resolution_of_effacement S d m hm τ hGod hEff
      hInjR hGeomLift hLocConst hDualRep
  rcases hDualExt with ⟨hDeg0, hVan, ⟨E_top, hE_nat⟩⟩
  have hComp_e₀ : ∀ (c : ZMod m) (α : CategoryTheory.Abelian.Ext.{u} oneR oneR (2 * d)),
      τ (α.comp (e₀ c) (Nat.add_zero (2 * d))) = c * τ α := by
    intro c α
    rw [he₀_apply c, h_comp_nsmul, CategoryTheory.Abelian.Ext.comp_mk₀_id,
      map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val]
  have hBij_τ : Function.Bijective τ := by
    apply hTrCrit (weilEtaleModuleH S m (2 * d)) (hm_ext oneR oneR (2 * d)) τ
    intro φ
    obtain ⟨f, hf_eq, hf_uniq⟩ := hDeg0 oneR φ
    refine ⟨e₀.symm f, ?_, ?_⟩
    · intro α
      have hf : e₀ (e₀.symm f) = f := e₀.apply_symm_apply f
      rw [← hComp_e₀ (e₀.symm f) α, hf, hf_eq α]
    · intro c hc
      apply e₀.injective
      rw [e₀.apply_symm_apply]
      exact hf_uniq (e₀ c) (fun α => (hComp_e₀ c α).trans (hc α).symm)
  let Φ : ∀ (G : 𝒞) (p q : ℕ) (hpq : p + q = 2 * d),
      CategoryTheory.Abelian.Ext.{u} G oneR q →
        (CategoryTheory.Abelian.Ext.{u} oneR G p →+ ZMod m) :=
    fun G p q hpq β =>
      AddMonoidHom.mk'
        (fun α : CategoryTheory.Abelian.Ext.{u} oneR G p => τ (α.comp β hpq))
        (fun α₁ α₂ => by rw [CategoryTheory.Abelian.Ext.add_comp, map_add])
  
  let ψ₁ : CategoryTheory.Abelian.Ext.{u} oneR oneR 0 →+ ZMod m := e₀.symm.toAddMonoidHom
  let u₀ : ZMod m := τ (E_top oneR ψ₁)
  have hCalib : ∀ (G : 𝒞) (φ : CategoryTheory.Abelian.Ext.{u} oneR G 0 →+ ZMod m)
      (α : CategoryTheory.Abelian.Ext.{u} oneR G 0),
      τ (α.comp (E_top G φ) (Nat.zero_add (2 * d))) = φ α * u₀ := by
    intro G φ α
    have hpost : φ.comp (α.postcomp oneR (Nat.add_zero 0)) = (φ α).val • ψ₁ := by
      apply AddMonoidHom.ext
      intro x
      obtain ⟨c, rfl⟩ := e₀.surjective x
      change φ ((e₀ c).comp α (Nat.add_zero 0)) = (φ α).val • (e₀.symm (e₀ c))
      rw [e₀.symm_apply_apply, he₀_apply c, h_nsmul_comp, CategoryTheory.Abelian.Ext.mk₀_id_comp,
        map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val,
        nsmul_eq_mul, ZMod.natCast_zmod_val, mul_comm]
    rw [hE_nat G φ α, hpost, map_nsmul, map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val]
  obtain ⟨y_one, hy_one⟩ := hBij_τ.2 1
  let φ₀ : CategoryTheory.Abelian.Ext.{u} oneR oneR 0 →+ ZMod m := (E_top oneR).symm y_one
  have hE_φ₀ : τ (E_top oneR φ₀) = 1 := by
    dsimp [φ₀]
    rw [(E_top oneR).apply_symm_apply, hy_one]
  let v₀ : ZMod m :=
    φ₀ (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id oneR))
  have hv₀u₀ : v₀ * u₀ = 1 := by
    have h := hCalib oneR φ₀
      (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id oneR))
    rw [CategoryTheory.Abelian.Ext.mk₀_id_comp, hE_φ₀] at h
