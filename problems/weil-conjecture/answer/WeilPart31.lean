            (ψ s).comp MvPolynomial.C =
              ((algebraMap A (Localization.Away (g a))).comp φ₁).comp MvPolynomial.C ∧
            (ψ s).Etale) ∧
          (∀ s : Fin K, ∃ j : Fin δ, ∀ i : Fin δ, i ≠ j →
            ψ (Fin.castSucc s) (MvPolynomial.X i) = ψ s.succ (MvPolynomial.X i)) :=
by
  by_cases hSub : Subsingleton A
  · have : Subsingleton A := hSub
    refine ⟨0, Fin.elim0, ?_, fun a => Fin.elim0 a⟩
    rw [Ideal.eq_top_iff_one, Subsingleton.elim (1 : A) 0]
    exact Submodule.zero_mem _
  have : Nontrivial A := not_subsingleton_iff_nontrivial.mp hSub
  have h_s1 : ∀ [Algebra k A] (φ : MvPolynomial (Fin δ) k →+* A),
      φ.comp MvPolynomial.C = algebraMap k A →
      φ.Etale →
      Algebra.Smooth k A ∧
      ∃ b : Module.Basis (Fin δ) A (KaehlerDifferential k A),
        ∀ i : Fin δ, b i = KaehlerDifferential.D k A (φ (MvPolynomial.X i)) := by
    intro _ φ hφC hEt
    let P := MvPolynomial (Fin δ) k
    let _ : Algebra P A := φ.toAlgebra
    have h_alg_eq : (algebraMap P A).comp (algebraMap k P) = algebraMap k A := by
