      intro p
      ext r
      simp [Polynomial.coeff_coe]
    have hDeriv_map : ∀ f : PowerSeries K,
        PowerSeries.derivative (PowerSeries.map ι f) =
          PowerSeries.map ι (PowerSeries.derivative f) := by
      intro f
      ext r
      simp [PowerSeries.coeff_derivative]
