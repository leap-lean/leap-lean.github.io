            · have hn₁₂ : ¬ P_W (W₁ ⊓ W₂) X.unop :=
                fun h => h₁ ((hP_inf W₁ W₂ X.unop).mp h).1
              rw [dif_neg hn₁₂, neg_zero]
              rw [dif_neg h₁, dif_pos h₂, zero_add] at hk_ev
