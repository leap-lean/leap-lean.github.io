          refine ⟨fun f₁ f₂ => ?_⟩
          have h1 : f₁ = f_0 := hf_uniq f₁ (fun α => by
            rw [Subsingleton.elim α 0, CategoryTheory.Abelian.Ext.zero_comp, map_zero]; rfl)
          have h2 : f₂ = f_0 := hf_uniq f₂ (fun α => by
            rw [Subsingleton.elim α 0, CategoryTheory.Abelian.Ext.zero_comp, map_zero]; rfl)
