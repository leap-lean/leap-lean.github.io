                ((U_equiv ℱ (i_push.obj 𝒢)).symm
                  (adj_ab.homEquiv ((U_fun Y).obj ℱ) ((U_fun Z).obj 𝒢)
                    (e_pull_U.inv.app ℱ ≫ (U_fun Z).map f) ≫ e_push_U.hom.app 𝒢) ≫
                  i_push.map g)
            rw [(U_equiv ℱ (i_push.obj 𝒢')).apply_symm_apply, (U_fun Y).map_comp]
