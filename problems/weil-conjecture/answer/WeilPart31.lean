                  fun h => h₁_2 ((hP_inf W₁ W₂ X₂.unop).mp h).1
                rw [dif_neg h₁_2, dif_neg hn₁₂_2] })
        (fun {K} α hα => by
          let α₁ := α ≫ CategoryTheory.Limits.biprod.fst
          let α₂ := α ≫ CategoryTheory.Limits.biprod.snd
          have h_decomp : α ≫ g_sub = α₁ ≫ g_sub₁ + α₂ ≫ g_sub₂ := by
            have hg_eq : g_sub = CategoryTheory.Limits.biprod.fst ≫ g_sub₁ +
                CategoryTheory.Limits.biprod.snd ≫ g_sub₂ := by
              apply CategoryTheory.Limits.biprod.hom_ext'
              · simp [g_sub]
              · simp [g_sub]
            rw [hg_eq, CategoryTheory.Preadditive.comp_add, ← Category.assoc, ← Category.assoc]
          have hker : α₁ ≫ g_sub₁ + α₂ ≫ g_sub₂ = 0 := h_decomp.symm.trans hα
          apply CategoryTheory.Limits.biprod.hom_ext
          · rw [Category.assoc, CategoryTheory.Limits.biprod.lift_fst]
            apply NatTrans.ext; funext X; apply mod_hom_ext
            intro k; funext ⟨h₁⟩
            change (if h₁₂ : P_W (W₁ ⊓ W₂) X.unop then
                α₁.app X k ⟨((hP_inf W₁ W₂ X.unop).mp h₁₂).1⟩ else 0) = α₁.app X k ⟨h₁⟩
            by_cases h₂ : P_W W₂ X.unop
