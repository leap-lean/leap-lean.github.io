          let h' := (hExFactor (v_pt pt) hf_mem).choose_spec.choose
          have hh' : h' ≫ v_pt pt' = v_pt pt := (hExFactor (v_pt pt) hf_mem).choose_spec.choose_spec
          change (G₁.obj.map (v_pt pt).op).hom s₀ = (1 : ℤ) • (G₁.obj.map h'.op).hom (s_fam pt') at h_am
          rw [one_zsmul] at h_am
          have hind := hFamIndep h' (𝟙 (V_pt pt)) (hh'.trans (Category.id_comp _).symm)
          rw [op_id, G₁.obj.map_id] at hind
