        CategoryTheory.Abelian.Ext.mk₀_id_comp,
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, eY.hom_inv_id,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]

  have h_ext_sandwich : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C]
      [CategoryTheory.Abelian C] [CategoryTheory.HasExt.{u} C]
      {A₀ A₁ A₂ B₂ B₁ B₀ : C} (b₁ : A₀ ⟶ A₁) (b₂ : A₁ ⟶ A₂)
      (c₁ : B₂ ⟶ B₁) (c₂ : B₁ ⟶ B₀) (q : ℕ)
      (e : CategoryTheory.Abelian.Ext.{u} A₂ B₂ q),
      ((CategoryTheory.Abelian.Ext.mk₀ b₁).comp
        (((CategoryTheory.Abelian.Ext.mk₀ b₂).comp e (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ c₁) (Nat.add_zero q))
        (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ c₂) (Nat.add_zero q) =
      ((CategoryTheory.Abelian.Ext.mk₀ (b₁ ≫ b₂)).comp e (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (c₁ ≫ c₂)) (Nat.add_zero q) := by
    intro C _ _ _ A₀ A₁ A₂ B₂ B₁ B₀ b₁ b₂ c₁ c₂ q e
    rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ b₂) e
        (CategoryTheory.Abelian.Ext.mk₀ c₁) (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ (b₁ ≫ b₂)) _ _ (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero e _ _ (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.zero_add q)]

  have h_ext_nat_sandwich : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C]
      [CategoryTheory.Abelian C] [CategoryTheory.HasExt.{u} C]
      {A₀ A₁ A₂ B₂ B₁ B₀ : C}
      (b₁₂ : A₀ ⟶ A₁) (θ_A : A₁ ⟶ A₂) (b_comp : A₀ ⟶ A₂)
      (θ_B : B₁ ⟶ B₂) (c_comp : B₂ ⟶ B₀) (c₁₂ : B₁ ⟶ B₀) (q : ℕ)
      (e₁ : CategoryTheory.Abelian.Ext.{u} A₁ B₁ q)
      (e₂ : CategoryTheory.Abelian.Ext.{u} A₂ B₂ q),
      b₁₂ ≫ θ_A = b_comp →
      θ_B ≫ c_comp = c₁₂ →
      e₁.comp (CategoryTheory.Abelian.Ext.mk₀ θ_B) (Nat.add_zero q) =
        (CategoryTheory.Abelian.Ext.mk₀ θ_A).comp e₂ (Nat.zero_add q) →
      ((CategoryTheory.Abelian.Ext.mk₀ b_comp).comp e₂ (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ c_comp) (Nat.add_zero q) =
        ((CategoryTheory.Abelian.Ext.mk₀ b₁₂).comp e₁ (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ c₁₂) (Nat.add_zero q) := by
    intro C _ _ _ A₀ A₁ A₂ B₂ B₁ B₀ b₁₂ θ_A b_comp θ_B c_comp c₁₂ q e₁ e₂ hb hc hnat
    rw [← hb, ← hc, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add q),
      ← hnat,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero q)]

  
  have hConstUnitNat : ∀ (S : AlgebraicGeometry.Scheme.{u})
      {T₁ T₂ : S.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT₂ : CategoryTheory.Limits.IsTerminal T₂) (φ : T₂ ⟶ T₁),
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology (ModuleCat.{u, u} R) hT₁).unit.app R_mod ≫
        (One_sh S).obj.map φ.op =
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology (ModuleCat.{u, u} R) hT₂).unit.app R_mod := by
    intro S T₁ T₂ hT₁ hT₂ φ
    dsimp [CategoryTheory.constantSheafAdj]
    rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.Adjunction.comp_unit_app]
    simp only [CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
    have hnat := ((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
      (ModuleCat.{u, u} R)).unit.app
      ((CategoryTheory.Functor.const (Opposite S.Etale)).obj R_mod)).naturality φ.op
    dsimp at hnat
    rw [CategoryTheory.Category.id_comp] at hnat
    exact hnat.symm

  let B_all {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂) :
      CategoryTheory.Functor S₂.Etale S₁.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
  let push_all {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂) :
      CategoryTheory.Functor (ShMod S₁) (ShMod S₂) :=
    @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (B_all f) (ModuleCat.{u, u} R) _ S₂.smallEtaleTopology S₁.smallEtaleTopology
      (hContB S₁ S₂ f)
  let q_can {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂) :
      One_sh S₂ ⟶ (push_all f).obj (One_sh S₁) :=
    ((CategoryTheory.constantSheafAdj S₂.smallEtaleTopology (ModuleCat.{u, u} R)
        (hT_can S₂)).homEquiv R_mod ((push_all f).obj (One_sh S₁))).symm
      (((CategoryTheory.constantSheafAdj S₁.smallEtaleTopology (ModuleCat.{u, u} R)
          (hT_can S₁)).unit.app R_mod) ≫
        (One_sh S₁).obj.map ((hT_can S₁).from ((B_all f).obj (T_can S₂))).op)

  have hUnitMapIndep : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂)
      (T₂ : S₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (T₁ : S₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁),
      let adj₂ := CategoryTheory.constantSheafAdj S₂.smallEtaleTopology (ModuleCat.{u, u} R) hT₂
      let adj₁ := CategoryTheory.constantSheafAdj S₁.smallEtaleTopology (ModuleCat.{u, u} R) hT₁
      (adj₂.homEquiv R_mod ((push_all f).obj (One_sh S₁))).symm
        (adj₁.unit.app R_mod ≫ (One_sh S₁).obj.map (hT₁.from ((B_all f).obj T₂)).op) =
      q_can f := by
    intro S₁ S₂ f T₂ hT₂ T₁ hT₁ adj₂ adj₁
    let adj₂₀ := CategoryTheory.constantSheafAdj S₂.smallEtaleTopology
      (ModuleCat.{u, u} R) (hT_can S₂)
    let adj₁₀ := CategoryTheory.constantSheafAdj S₁.smallEtaleTopology
      (ModuleCat.{u, u} R) (hT_can S₁)
    apply (adj₂.homEquiv R_mod ((push_all f).obj (One_sh S₁))).injective
    rw [Equiv.apply_symm_apply]
    let φ₂ : T₂ ⟶ T_can S₂ := (hT_can S₂).from T₂
    let φ₁ : T_can S₁ ⟶ T₁ := hT₁.from (T_can S₁)
    let τ₀ : (B_all f).obj (T_can S₂) ⟶ T_can S₁ := (hT_can S₁).from ((B_all f).obj (T_can S₂))
    let q_app₂ : (One_sh S₂).obj.obj (Opposite.op T₂) ⟶
        (One_sh S₁).obj.obj (Opposite.op ((B_all f).obj T₂)) :=
      (q_can f).hom.app (Opposite.op T₂)
    let q_app₀ : (One_sh S₂).obj.obj (Opposite.op (T_can S₂)) ⟶
        (One_sh S₁).obj.obj (Opposite.op ((B_all f).obj (T_can S₂))) :=
      (q_can f).hom.app (Opposite.op (T_can S₂))
    have h_rhs_ev : adj₂.homEquiv R_mod ((push_all f).obj (One_sh S₁)) (q_can f) =
        adj₂.unit.app R_mod ≫ q_app₂ :=
      CategoryTheory.Adjunction.homEquiv_unit adj₂ R_mod ((push_all f).obj (One_sh S₁)) (q_can f)
    have h_q0_ev : (adj₂₀.unit.app R_mod : R_mod ⟶ (One_sh S₂).obj.obj (Opposite.op (T_can S₂))) ≫
        q_app₀ = adj₁₀.unit.app R_mod ≫ (One_sh S₁).obj.map τ₀.op :=
      (CategoryTheory.Adjunction.homEquiv_unit adj₂₀ R_mod ((push_all f).obj (One_sh S₁))
        (q_can f)).symm.trans
        ((adj₂₀.homEquiv R_mod ((push_all f).obj (One_sh S₁))).apply_symm_apply _)
    have h_q_nat : (One_sh S₂).obj.map φ₂.op ≫ q_app₂ =
        q_app₀ ≫ (One_sh S₁).obj.map ((B_all f).map φ₂).op :=
      (q_can f).hom.naturality φ₂.op
    have h_u2 : adj₂.unit.app R_mod = adj₂₀.unit.app R_mod ≫ (One_sh S₂).obj.map φ₂.op :=
      (hConstUnitNat S₂ (hT_can S₂) hT₂ φ₂).symm
    have h_u1 : adj₁₀.unit.app R_mod = adj₁.unit.app R_mod ≫ (One_sh S₁).obj.map φ₁.op :=
      (hConstUnitNat S₁ hT₁ (hT_can S₁) φ₁).symm
    have h_term : ((B_all f).map φ₂ ≫ τ₀) ≫ φ₁ = hT₁.from ((B_all f).obj T₂) :=
      hT₁.hom_ext _ _
    rw [h_rhs_ev]
    symm
    calc
      adj₂.unit.app R_mod ≫ q_app₂
          = (adj₂₀.unit.app R_mod ≫ (One_sh S₂).obj.map φ₂.op) ≫ q_app₂ := by rw [h_u2]
      _ = adj₂₀.unit.app R_mod ≫ ((One_sh S₂).obj.map φ₂.op ≫ q_app₂) :=
            CategoryTheory.Category.assoc _ _ _
      _ = (adj₂₀.unit.app R_mod ≫ q_app₀) ≫ (One_sh S₁).obj.map ((B_all f).map φ₂).op := by
            rw [h_q_nat, CategoryTheory.Category.assoc]
      _ = adj₁₀.unit.app R_mod ≫ ((One_sh S₁).obj.map τ₀.op ≫
            (One_sh S₁).obj.map ((B_all f).map φ₂).op) := by
            rw [h_q0_ev, CategoryTheory.Category.assoc]
      _ = adj₁.unit.app R_mod ≫ ((One_sh S₁).obj.map φ₁.op ≫
            (One_sh S₁).obj.map τ₀.op ≫ (One_sh S₁).obj.map ((B_all f).map φ₂).op) := by
            rw [h_u1]
            simp only [CategoryTheory.Category.assoc]
      _ = adj₁.unit.app R_mod ≫ (One_sh S₁).obj.map (((B_all f).map φ₂ ≫ τ₀) ≫ φ₁).op := by
            rw [← (One_sh S₁).obj.map_comp, ← (One_sh S₁).obj.map_comp, ← op_comp, ← op_comp]
      _ = adj₁.unit.app R_mod ≫ (One_sh S₁).obj.map (hT₁.from ((B_all f).obj T₂)).op := by
            rw [h_term]

  have hPbUniq : ∀ {Z' Y' Z₀ Y₀ : AlgebraicGeometry.Scheme.{u}}
      (g : Quiver.Hom Y' Y₀) (i' : Quiver.Hom Z' Y') (i₀ : Quiver.Hom Z₀ Y₀),
      AlgebraicGeometry.IsClosedImmersion i' →
      ∀ (q : ℕ) (τ : WeilGysinSupportClass Z₀ Y₀ i₀ m q)
        (τ'₁ τ'₂ : WeilGysinSupportClass Z' Y' i' m q),
        WeilGysinSupportPullback g i' i₀ m q τ'₁ τ →
        WeilGysinSupportPullback g i' i₀ m q τ'₂ τ →
        τ'₁ = τ'₂ := by
    intro Z' Y' Z₀ Y₀ g i' i₀ hi' q τ τ'₁ τ'₂ h₁ h₂
    apply hSuppExt
    obtain ⟨hCg₁, P₁, adj₁, hAdd₁, hLim₁, hColim₁,
      TY1, hTY1, TZ1, hTZ1, TY'1, hTY'1, TZ'1, hTZ'1,
      ι₁, β₁, hιπ₁, _, hqβ₁, hval₁⟩ := h₁
    obtain ⟨hCg₂, P₂, adj₂, hAdd₂, hLim₂, hColim₂,
      TY2, hTY2, TZ2, hTZ2, TY'2, hTY'2, TZ'2, hTZ'2,
      ι₂, β₂, _, hπι₂, hqβ₂, hval₂⟩ := h₂
    let _ := hAdd₁; let _ := hLim₁; let _ := hColim₁
    let _ := hAdd₂; let _ := hLim₂; let _ := hColim₂
    have hqi1 : ((CategoryTheory.constantSheafAdj Y₀.smallEtaleTopology _ hTY1).homEquiv R_mod
        ((push_all i₀).obj (One_sh Z₀))).symm
        ((CategoryTheory.constantSheafAdj Z₀.smallEtaleTopology _ hTZ1).unit.app R_mod ≫
          (One_sh Z₀).obj.map (hTZ1.from ((B_all i₀).obj TY1)).op) = q_can i₀ :=
      hUnitMapIndep i₀ TY1 hTY1 TZ1 hTZ1
    have hqi2 : ((CategoryTheory.constantSheafAdj Y₀.smallEtaleTopology _ hTY2).homEquiv R_mod
        ((push_all i₀).obj (One_sh Z₀))).symm
        ((CategoryTheory.constantSheafAdj Z₀.smallEtaleTopology _ hTZ2).unit.app R_mod ≫
          (One_sh Z₀).obj.map (hTZ2.from ((B_all i₀).obj TY2)).op) = q_can i₀ :=
      hUnitMapIndep i₀ TY2 hTY2 TZ2 hTZ2
    have hqi'1 : ((CategoryTheory.constantSheafAdj Y'.smallEtaleTopology _ hTY'1).homEquiv R_mod
        ((push_all i').obj (One_sh Z'))).symm
        ((CategoryTheory.constantSheafAdj Z'.smallEtaleTopology _ hTZ'1).unit.app R_mod ≫
          (One_sh Z').obj.map (hTZ'1.from ((B_all i').obj TY'1)).op) = q_can i' :=
      hUnitMapIndep i' TY'1 hTY'1 TZ'1 hTZ'1
    have hqi'2 : ((CategoryTheory.constantSheafAdj Y'.smallEtaleTopology _ hTY'2).homEquiv R_mod
        ((push_all i').obj (One_sh Z'))).symm
        ((CategoryTheory.constantSheafAdj Z'.smallEtaleTopology _ hTZ'2).unit.app R_mod ≫
          (One_sh Z').obj.map (hTZ'2.from ((B_all i').obj TY'2)).op) = q_can i' :=
      hUnitMapIndep i' TY'2 hTY'2 TZ'2 hTZ'2
    have hug1 : ((CategoryTheory.constantSheafAdj Y₀.smallEtaleTopology _ hTY1).homEquiv R_mod
        ((push_all g).obj (One_sh Y'))).symm
        ((CategoryTheory.constantSheafAdj Y'.smallEtaleTopology _ hTY'1).unit.app R_mod ≫
          (One_sh Y').obj.map (hTY'1.from ((B_all g).obj TY1)).op) = q_can g :=
      hUnitMapIndep g TY1 hTY1 TY'1 hTY'1
    have hug2 : ((CategoryTheory.constantSheafAdj Y₀.smallEtaleTopology _ hTY2).homEquiv R_mod
        ((push_all g).obj (One_sh Y'))).symm
        ((CategoryTheory.constantSheafAdj Y'.smallEtaleTopology _ hTY'2).unit.app R_mod ≫
          (One_sh Y').obj.map (hTY'2.from ((B_all g).obj TY2)).op) = q_can g :=
      hUnitMapIndep g TY2 hTY2 TY'2 hTY'2
    let π₁ : P₁.obj (One_sh Y₀) ⟶ One_sh Y' :=
      (adj₁.homEquiv (One_sh Y₀) (One_sh Y')).symm (q_can g)
    let π₂ : P₂.obj (One_sh Y₀) ⟶ One_sh Y' :=
      (adj₂.homEquiv (One_sh Y₀) (One_sh Y')).symm (q_can g)
    have hπ₁_eq : (adj₁.homEquiv (One_sh Y₀) (One_sh Y')).symm
        (((CategoryTheory.constantSheafAdj Y₀.smallEtaleTopology _ hTY1).homEquiv R_mod
          ((push_all g).obj (One_sh Y'))).symm
          ((CategoryTheory.constantSheafAdj Y'.smallEtaleTopology _ hTY'1).unit.app R_mod ≫
            (One_sh Y').obj.map (hTY'1.from ((B_all g).obj TY1)).op)) = π₁ :=
      congrArg (adj₁.homEquiv (One_sh Y₀) (One_sh Y')).symm hug1
    have hπ₂_eq : (adj₂.homEquiv (One_sh Y₀) (One_sh Y')).symm
        (((CategoryTheory.constantSheafAdj Y₀.smallEtaleTopology _ hTY2).homEquiv R_mod
          ((push_all g).obj (One_sh Y'))).symm
          ((CategoryTheory.constantSheafAdj Y'.smallEtaleTopology _ hTY'2).unit.app R_mod ≫
            (One_sh Y').obj.map (hTY'2.from ((B_all g).obj TY2)).op)) = π₂ :=
      congrArg (adj₂.homEquiv (One_sh Y₀) (One_sh Y')).symm hug2
    have hιπ₁' : ι₁ ≫ π₁ = 𝟙 (One_sh Y') := hπ₁_eq ▸ hιπ₁
    have hπι₂' : π₂ ≫ ι₂ = 𝟙 (P₂.obj (One_sh Y₀)) := hπ₂_eq ▸ hπι₂
    have hqβ₁' : q_can i' ≫ β₁ = ι₁ ≫ P₁.map (q_can i₀) := hqi'1 ▸ hqi1 ▸ hqβ₁
    have hqβ₂' : q_can i' ≫ β₂ = ι₂ ≫ P₂.map (q_can i₀) := hqi'2 ▸ hqi2 ▸ hqβ₂
    have hval₁' : τ'₁.val =
        ((CategoryTheory.Abelian.Ext.mk₀ β₁).comp
          (P₁.mapExtAddHom ((push_all i₀).obj (One_sh Z₀)) (One_sh Y₀) q τ.val)
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ π₁) (Nat.add_zero q) := hπ₁_eq ▸ hval₁
    have hval₂' : τ'₂.val =
        ((CategoryTheory.Abelian.Ext.mk₀ β₂).comp
          (P₂.mapExtAddHom ((push_all i₀).obj (One_sh Z₀)) (One_sh Y₀) q τ.val)
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ π₂) (Nat.add_zero q) := hπ₂_eq ▸ hval₂
    let e_P : P₁ ≅ P₂ := adj₁.leftAdjointUniq adj₂
    have hπ_rel : e_P.hom.app (One_sh Y₀) ≫ π₂ = π₁ := by
      apply (adj₁.homEquiv (One_sh Y₀) (One_sh Y')).injective
      have hev1 : adj₁.homEquiv (One_sh Y₀) (One_sh Y') π₁ = q_can g :=
        (adj₁.homEquiv (One_sh Y₀) (One_sh Y')).apply_symm_apply _
      have hev2 : adj₂.homEquiv (One_sh Y₀) (One_sh Y') π₂ = q_can g :=
        (adj₂.homEquiv (One_sh Y₀) (One_sh Y')).apply_symm_apply _
      have hu_uniq := CategoryTheory.Adjunction.homEquiv_leftAdjointUniq_hom_app
        adj₁ adj₂ (One_sh Y₀)
      rw [CategoryTheory.Adjunction.homEquiv_unit] at hu_uniq
      rw [hev1, ← hev2, CategoryTheory.Adjunction.homEquiv_unit,
        CategoryTheory.Adjunction.homEquiv_unit, Functor.map_comp,
        ← CategoryTheory.Category.assoc, hu_uniq]
    have hι_rel : ι₁ ≫ e_P.hom.app (One_sh Y₀) = ι₂ := by
      calc
        ι₁ ≫ e_P.hom.app (One_sh Y₀)
            = (ι₁ ≫ e_P.hom.app (One_sh Y₀)) ≫ 𝟙 (P₂.obj (One_sh Y₀)) :=
              (CategoryTheory.Category.comp_id _).symm
        _ = (ι₁ ≫ e_P.hom.app (One_sh Y₀)) ≫ (π₂ ≫ ι₂) := by rw [hπι₂']
        _ = (ι₁ ≫ (e_P.hom.app (One_sh Y₀) ≫ π₂)) ≫ ι₂ := by
              simp only [CategoryTheory.Category.assoc]
        _ = (ι₁ ≫ π₁) ≫ ι₂ := by rw [hπ_rel]
        _ = ι₂ := by rw [hιπ₁', CategoryTheory.Category.id_comp]
    have hEpi_i' : CategoryTheory.Epi (q_can i') :=
      hEpiQ i' (hContB Z' Y' i') hi' (T_can Y') (hT_can Y') (T_can Z') (hT_can Z')
    have hβ_rel : β₁ ≫ e_P.hom.app ((push_all i₀).obj (One_sh Z₀)) = β₂ := by
      apply (CategoryTheory.cancel_epi (q_can i')).mp
      calc
        q_can i' ≫ (β₁ ≫ e_P.hom.app ((push_all i₀).obj (One_sh Z₀)))
            = (q_can i' ≫ β₁) ≫ e_P.hom.app ((push_all i₀).obj (One_sh Z₀)) :=
              (CategoryTheory.Category.assoc _ _ _).symm
        _ = ι₁ ≫ (P₁.map (q_can i₀) ≫ e_P.hom.app ((push_all i₀).obj (One_sh Z₀))) := by
              rw [hqβ₁', CategoryTheory.Category.assoc]
        _ = (ι₁ ≫ e_P.hom.app (One_sh Y₀)) ≫ P₂.map (q_can i₀) := by
              rw [e_P.hom.naturality (q_can i₀), CategoryTheory.Category.assoc]
        _ = q_can i' ≫ β₂ := by rw [hι_rel, hqβ₂']
    rw [hval₁', hval₂', ← hπ_rel, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ β₁) _ _ (Nat.zero_add q),
      h_natTrans_mapExt P₁ P₂ e_P.hom q ((push_all i₀).obj (One_sh Z₀)) (One_sh Y₀) τ.val,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hβ_rel]

  
  let M_et {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (g : Quiver.Hom S₁ S₂)
      (hg : AlgebraicGeometry.Etale g) : CategoryTheory.Functor S₁.Etale S₂.Etale :=
    CategoryTheory.MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤ hg
  let res_et {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (g : Quiver.Hom S₁ S₂)
      (hg : AlgebraicGeometry.Etale g) : CategoryTheory.Functor (ShMod S₂) (ShMod S₁) :=
    @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (M_et g hg) (ModuleCat.{u, u} R) _ S₁.smallEtaleTopology S₂.smallEtaleTopology
      (hContM g hg)

  have h_pi_ex : ∀ {Y' Y₀ : AlgebraicGeometry.Scheme.{u}} (g : Quiver.Hom Y' Y₀)
      (hg : AlgebraicGeometry.Etale g),
      ∃ (adj_can : CategoryTheory.Adjunction (res_et g hg) (push_all g))
        (π_can : CategoryTheory.Iso ((res_et g hg).obj (One_sh Y₀)) (One_sh Y')),
        π_can.hom = (adj_can.homEquiv (One_sh Y₀) (One_sh Y')).symm (q_can g) ∧
        π_can.inv = ((CategoryTheory.constantSheafAdj Y'.smallEtaleTopology
            (ModuleCat.{u, u} R) (hT_can Y')).homEquiv R_mod ((res_et g hg).obj (One_sh Y₀))).symm
          ((CategoryTheory.constantSheafAdj Y₀.smallEtaleTopology
              (ModuleCat.{u, u} R) (hT_can Y₀)).unit.app R_mod ≫
            (One_sh Y₀).obj.map ((hT_can Y₀).from ((M_et g hg).obj (T_can Y'))).op) := by
    intro Y' Y₀ g hg
    let g_res := res_et g hg
    let g_push := push_all g
    let M_g := M_et g hg
    let B_g := B_all g
    let adj_Y₀ := CategoryTheory.constantSheafAdj Y₀.smallEtaleTopology
      (ModuleCat.{u, u} R) (hT_can Y₀)
    let adj_Y' := CategoryTheory.constantSheafAdj Y'.smallEtaleTopology
      (ModuleCat.{u, u} R) (hT_can Y')
    let τ_g : B_g.obj (T_can Y₀) ⟶ T_can Y' := (hT_can Y').from (B_g.obj (T_can Y₀))
    let μ_g : M_g.obj (T_can Y') ⟶ T_can Y₀ := (hT_can Y₀).from (M_g.obj (T_can Y'))
    let adj_site : M_g ⊣ B_g :=
      CategoryTheory.MorphismProperty.Over.mapPullbackAdj (@AlgebraicGeometry.Etale) ⊤ g hg trivial
    let η_sh : 𝟭 (ShMod Y₀) ⟶ g_res ⋙ g_push :=
      { app := fun ℱ =>
          { hom :=
              { app := fun U => ℱ.obj.map (adj_site.counit.app U.unop).op
                naturality := fun {U₁ U₂} f =>
                  (ℱ.obj.map_comp f (adj_site.counit.app U₂.unop).op).symm.trans
                    ((congrArg (fun k => ℱ.obj.map k.op)
                      (adj_site.counit.naturality f.unop).symm).trans
                      (ℱ.obj.map_comp (adj_site.counit.app U₁.unop).op
                        (M_g.map (B_g.map f.unop)).op)) } }
        naturality := fun {ℱ₁ ℱ₂} α => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext U
          exact (α.hom.naturality (adj_site.counit.app U.unop).op).symm }
    let ε_sh : g_push ⋙ g_res ⟶ 𝟭 (ShMod Y') :=
      { app := fun 𝒢 =>
          { hom :=
              { app := fun V' => 𝒢.obj.map (adj_site.unit.app V'.unop).op
                naturality := fun {V'₁ V'₂} f =>
                  (𝒢.obj.map_comp (B_g.map (M_g.map f.unop)).op
                    (adj_site.unit.app V'₂.unop).op).symm.trans
                    ((congrArg (fun k => 𝒢.obj.map k.op)
                      (adj_site.unit.naturality f.unop).symm).trans
                      (𝒢.obj.map_comp (adj_site.unit.app V'₁.unop).op f)) } }
        naturality := fun {𝒢₁ 𝒢₂} β => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext V'
          exact (β.hom.naturality (adj_site.unit.app V'.unop).op).symm }
    let adj_can : g_res ⊣ g_push := CategoryTheory.Adjunction.mkOfUnitCounit
      { unit := η_sh
        counit := ε_sh
        left_triangle := by
          apply CategoryTheory.NatTrans.ext
          funext ℱ
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext V'
          change 𝟙 _ ≫ (ℱ.obj.map (adj_site.counit.app (M_g.obj V'.unop)).op ≫
              ℱ.obj.map (M_g.map (adj_site.unit.app V'.unop)).op) = 𝟙 _
          rw [CategoryTheory.Category.id_comp, ← ℱ.obj.map_comp, ← op_comp,
            adj_site.left_triangle_components V'.unop]
          exact ℱ.obj.map_id _
        right_triangle := by
          apply CategoryTheory.NatTrans.ext
          funext 𝒢
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext U
          change (𝒢.obj.map (B_g.map (adj_site.counit.app U.unop)).op ≫
              𝟙 _) ≫ 𝒢.obj.map (adj_site.unit.app (B_g.obj U.unop)).op = 𝟙 _
          rw [CategoryTheory.Category.comp_id, ← 𝒢.obj.map_comp, ← op_comp,
            adj_site.right_triangle_components U.unop]
          exact 𝒢.obj.map_id _ }
    let hT_Bg : CategoryTheory.Limits.IsTerminal (B_g.obj (T_can Y₀)) :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun V' => adj_site.homEquiv V' (T_can Y₀) ((hT_can Y₀).from (M_g.obj V')))
        (fun V' f => by
          apply (adj_site.homEquiv V' (T_can Y₀)).symm.injective
          rw [Equiv.symm_apply_apply]
          exact (hT_can Y₀).hom_ext _ _)
    let adj_L := adj_Y₀.comp adj_can
    let adj_Bg := CategoryTheory.constantSheafAdj Y'.smallEtaleTopology (ModuleCat.{u, u} R) hT_Bg
    let π_can : g_res.obj (One_sh Y₀) ≅ One_sh Y' := (adj_L.leftAdjointUniq adj_Bg).app R_mod
    have h_unit_Bg : adj_Bg.unit.app R_mod = adj_Y'.unit.app R_mod ≫ (One_sh Y').obj.map τ_g.op :=
      (hConstUnitNat Y' (hT_can Y') hT_Bg τ_g).symm
    have hπ_hom : π_can.hom = (adj_can.homEquiv (One_sh Y₀) (One_sh Y')).symm (q_can g) := by
      apply (adj_L.homEquiv R_mod (One_sh Y')).injective
      have h1 : adj_L.homEquiv R_mod (One_sh Y') π_can.hom = adj_Bg.unit.app R_mod :=
        CategoryTheory.Adjunction.homEquiv_leftAdjointUniq_hom_app adj_L adj_Bg R_mod
      have h2 : adj_L.homEquiv R_mod (One_sh Y')
          ((adj_can.homEquiv (One_sh Y₀) (One_sh Y')).symm (q_can g)) =
          adj_Y'.unit.app R_mod ≫ (One_sh Y').obj.map τ_g.op := by
        change (adj_Y₀.homEquiv R_mod (g_push.obj (One_sh Y')))
          ((adj_can.homEquiv (One_sh Y₀) (One_sh Y'))
            ((adj_can.homEquiv (One_sh Y₀) (One_sh Y')).symm (q_can g))) = _
        exact (congrArg (adj_Y₀.homEquiv R_mod (g_push.obj (One_sh Y')))
          ((adj_can.homEquiv (One_sh Y₀) (One_sh Y')).apply_symm_apply _)).trans
          ((adj_Y₀.homEquiv R_mod (g_push.obj (One_sh Y'))).apply_symm_apply _)
      exact (h1.trans h_unit_Bg).trans h2.symm
    let ι_expl : One_sh Y' ⟶ g_res.obj (One_sh Y₀) :=
      (adj_Y'.homEquiv R_mod (g_res.obj (One_sh Y₀))).symm
        (adj_Y₀.unit.app R_mod ≫ (One_sh Y₀).obj.map μ_g.op)
    have h_inv_comp : ι_expl ≫ π_can.hom = 𝟙 (One_sh Y') := by
      apply (adj_Y'.homEquiv R_mod (One_sh Y')).injective
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
      let f_ι : (One_sh Y').obj.obj (Opposite.op (T_can Y')) ⟶
          (One_sh Y₀).obj.obj (Opposite.op (M_g.obj (T_can Y'))) :=
        ι_expl.hom.app (Opposite.op (T_can Y'))
      let f_π : (One_sh Y₀).obj.obj (Opposite.op (M_g.obj (T_can Y'))) ⟶
          (One_sh Y').obj.obj (Opposite.op (T_can Y')) :=
        π_can.hom.hom.app (Opposite.op (T_can Y'))
      let f_u1 : (One_sh Y₀).obj.obj (Opposite.op (M_g.obj (T_can Y'))) ⟶
          (One_sh Y').obj.obj (Opposite.op (B_g.obj (M_g.obj (T_can Y')))) :=
        (q_can g).hom.app (Opposite.op (M_g.obj (T_can Y')))
      let f_u0 : (One_sh Y₀).obj.obj (Opposite.op (T_can Y₀)) ⟶
          (One_sh Y').obj.obj (Opposite.op (B_g.obj (T_can Y₀))) :=
        (q_can g).hom.app (Opposite.op (T_can Y₀))
      let u_Y₀ : R_mod ⟶ (One_sh Y₀).obj.obj (Opposite.op (T_can Y₀)) := adj_Y₀.unit.app R_mod
      let u_Y' : R_mod ⟶ (One_sh Y').obj.obj (Opposite.op (T_can Y')) := adj_Y'.unit.app R_mod
      have h_ι_app : u_Y' ≫ f_ι = u_Y₀ ≫ (One_sh Y₀).obj.map μ_g.op :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_Y' R_mod (g_res.obj (One_sh Y₀))
          ι_expl).symm.trans ((adj_Y'.homEquiv R_mod (g_res.obj (One_sh Y₀))).apply_symm_apply _)
      have hu_g_app : u_Y₀ ≫ f_u0 = u_Y' ≫ (One_sh Y').obj.map τ_g.op :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_Y₀ R_mod (g_push.obj (One_sh Y'))
          (q_can g)).symm.trans
          ((adj_Y₀.homEquiv R_mod (g_push.obj (One_sh Y'))).apply_symm_apply _)
      have h_ug_nat : (One_sh Y₀).obj.map μ_g.op ≫ f_u1 =
          f_u0 ≫ (One_sh Y').obj.map (B_g.map μ_g).op :=
        (q_can g).hom.naturality μ_g.op
      have hπ_app : f_π = f_u1 ≫ (One_sh Y').obj.map (adj_site.unit.app (T_can Y')).op := by
        dsimp [f_π]
        rw [hπ_hom, CategoryTheory.Adjunction.homEquiv_counit]
        rfl
      have h_term : adj_site.unit.app (T_can Y') ≫ B_g.map μ_g ≫ τ_g = 𝟙 (T_can Y') :=
        (hT_can Y').hom_ext _ _
      change u_Y' ≫ (f_ι ≫ f_π) = u_Y' ≫ 𝟙 ((One_sh Y').obj.obj (Opposite.op (T_can Y')))
      calc
        u_Y' ≫ (f_ι ≫ f_π) = (u_Y' ≫ f_ι) ≫ f_π := (CategoryTheory.Category.assoc u_Y' f_ι f_π).symm
        _ = (u_Y₀ ≫ (One_sh Y₀).obj.map μ_g.op) ≫
              (f_u1 ≫ (One_sh Y').obj.map (adj_site.unit.app (T_can Y')).op) := by
          rw [h_ι_app, hπ_app]
        _ = u_Y₀ ≫ (((One_sh Y₀).obj.map μ_g.op ≫ f_u1) ≫
              (One_sh Y').obj.map (adj_site.unit.app (T_can Y')).op) := by
          simp only [CategoryTheory.Category.assoc]
        _ = (u_Y₀ ≫ f_u0) ≫ ((One_sh Y').obj.map (B_g.map μ_g).op ≫
              (One_sh Y').obj.map (adj_site.unit.app (T_can Y')).op) := by
          rw [h_ug_nat]
          simp only [CategoryTheory.Category.assoc]
        _ = u_Y' ≫ ((One_sh Y').obj.map τ_g.op ≫ (One_sh Y').obj.map (B_g.map μ_g).op ≫
              (One_sh Y').obj.map (adj_site.unit.app (T_can Y')).op) := by
          rw [hu_g_app]
          simp only [CategoryTheory.Category.assoc]
        _ = u_Y' ≫ (One_sh Y').obj.map (adj_site.unit.app (T_can Y') ≫ B_g.map μ_g ≫ τ_g).op := by
          rw [← (One_sh Y').obj.map_comp, ← (One_sh Y').obj.map_comp, ← op_comp, ← op_comp,
            CategoryTheory.Category.assoc (adj_site.unit.app (T_can Y'))]
        _ = u_Y' ≫ 𝟙 _ := by
          rw [h_term]
          exact congrArg (u_Y' ≫ ·) ((One_sh Y').obj.map_id _)
    refine ⟨adj_can, π_can, hπ_hom, ?_⟩
    calc
      π_can.inv = 𝟙 (One_sh Y') ≫ π_can.inv := (CategoryTheory.Category.id_comp _).symm
      _ = (ι_expl ≫ π_can.hom) ≫ π_can.inv := by rw [h_inv_comp]
      _ = ι_expl ≫ (π_can.hom ≫ π_can.inv) := CategoryTheory.Category.assoc _ _ _
      _ = ι_expl := by rw [π_can.hom_inv_id, CategoryTheory.Category.comp_id]

  choose adj_can π_can hπ_can using @h_pi_ex

  
  have hCoh_π : ∀ {Y₁ Y₂ Y₃ : AlgebraicGeometry.Scheme.{u}}
      (g₁ : Quiver.Hom Y₁ Y₂) (hg₁ : AlgebraicGeometry.Etale g₁)
      (g₂ : Quiver.Hom Y₂ Y₃) (hg₂ : AlgebraicGeometry.Etale g₂)
      (g₁₂ : Quiver.Hom Y₁ Y₃) (hg₁₂ : AlgebraicGeometry.Etale g₁₂)
      (σ : CategoryTheory.Iso (res_et g₁₂ hg₁₂)
        (CategoryTheory.Functor.comp (res_et g₂ hg₂) (res_et g₁ hg₁))),
      (∃ u_T : Quiver.Hom (((M_et g₁ hg₁).comp (M_et g₂ hg₂)).obj (T_can Y₁))
          ((M_et g₁₂ hg₁₂).obj (T_can Y₁)),
        ((σ.hom.app (One_sh Y₃)).hom.app (Opposite.op (T_can Y₁))) = (One_sh Y₃).obj.map u_T.op) →
      (π_can g₁₂ hg₁₂).inv ≫ σ.hom.app (One_sh Y₃) =
        (π_can g₁ hg₁).inv ≫ (res_et g₁ hg₁).map (π_can g₂ hg₂).inv := by
    rintro Y₁ Y₂ Y₃ g₁ hg₁ g₂ hg₂ g₁₂ hg₁₂ σ ⟨u_T, hu_T⟩
    let adj₁ := CategoryTheory.constantSheafAdj Y₁.smallEtaleTopology (ModuleCat.{u, u} R) (hT_can Y₁)
    let adj₂ := CategoryTheory.constantSheafAdj Y₂.smallEtaleTopology (ModuleCat.{u, u} R) (hT_can Y₂)
    let adj₃ := CategoryTheory.constantSheafAdj Y₃.smallEtaleTopology (ModuleCat.{u, u} R) (hT_can Y₃)
    let μ₁ : (M_et g₁ hg₁).obj (T_can Y₁) ⟶ T_can Y₂ := (hT_can Y₂).from _
    let μ₂ : (M_et g₂ hg₂).obj (T_can Y₂) ⟶ T_can Y₃ := (hT_can Y₃).from _
    let μ₁₂ : (M_et g₁₂ hg₁₂).obj (T_can Y₁) ⟶ T_can Y₃ := (hT_can Y₃).from _
    apply (adj₁.homEquiv R_mod (((res_et g₂ hg₂).comp (res_et g₁ hg₁)).obj (One_sh Y₃))).injective
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
    let u₁ : R_mod ⟶ (One_sh Y₁).obj.obj (Opposite.op (T_can Y₁)) := adj₁.unit.app R_mod
    let u₂ : R_mod ⟶ (One_sh Y₂).obj.obj (Opposite.op (T_can Y₂)) := adj₂.unit.app R_mod
    let u₃ : R_mod ⟶ (One_sh Y₃).obj.obj (Opposite.op (T_can Y₃)) := adj₃.unit.app R_mod
    let p₁₂_app : (One_sh Y₁).obj.obj (Opposite.op (T_can Y₁)) ⟶
        (One_sh Y₃).obj.obj (Opposite.op ((M_et g₁₂ hg₁₂).obj (T_can Y₁))) :=
      (π_can g₁₂ hg₁₂).inv.hom.app (Opposite.op (T_can Y₁))
    let p₁_app : (One_sh Y₁).obj.obj (Opposite.op (T_can Y₁)) ⟶
        (One_sh Y₂).obj.obj (Opposite.op ((M_et g₁ hg₁).obj (T_can Y₁))) :=
      (π_can g₁ hg₁).inv.hom.app (Opposite.op (T_can Y₁))
    let p₂_app_M : (One_sh Y₂).obj.obj (Opposite.op ((M_et g₁ hg₁).obj (T_can Y₁))) ⟶
        (One_sh Y₃).obj.obj (Opposite.op ((M_et g₂ hg₂).obj ((M_et g₁ hg₁).obj (T_can Y₁)))) :=
      (π_can g₂ hg₂).inv.hom.app (Opposite.op ((M_et g₁ hg₁).obj (T_can Y₁)))
    let p₂_app_0 : (One_sh Y₂).obj.obj (Opposite.op (T_can Y₂)) ⟶
        (One_sh Y₃).obj.obj (Opposite.op ((M_et g₂ hg₂).obj (T_can Y₂))) :=
      (π_can g₂ hg₂).inv.hom.app (Opposite.op (T_can Y₂))
    let σ_app : (One_sh Y₃).obj.obj (Opposite.op ((M_et g₁₂ hg₁₂).obj (T_can Y₁))) ⟶
        (One_sh Y₃).obj.obj (Opposite.op ((M_et g₂ hg₂).obj ((M_et g₁ hg₁).obj (T_can Y₁)))) :=
      (σ.hom.app (One_sh Y₃)).hom.app (Opposite.op (T_can Y₁))
    have hp₁₂ : u₁ ≫ p₁₂_app = u₃ ≫ (One_sh Y₃).obj.map μ₁₂.op :=
      (CategoryTheory.Adjunction.homEquiv_unit adj₁ R_mod _ (π_can g₁₂ hg₁₂).inv).symm.trans
        ((congrArg (adj₁.homEquiv R_mod _) (hπ_can g₁₂ hg₁₂).2).trans
          ((adj₁.homEquiv R_mod _).apply_symm_apply _))
    have hp₁ : u₁ ≫ p₁_app = u₂ ≫ (One_sh Y₂).obj.map μ₁.op :=
      (CategoryTheory.Adjunction.homEquiv_unit adj₁ R_mod _ (π_can g₁ hg₁).inv).symm.trans
        ((congrArg (adj₁.homEquiv R_mod _) (hπ_can g₁ hg₁).2).trans
          ((adj₁.homEquiv R_mod _).apply_symm_apply _))
    have hp₂ : u₂ ≫ p₂_app_0 = u₃ ≫ (One_sh Y₃).obj.map μ₂.op :=
      (CategoryTheory.Adjunction.homEquiv_unit adj₂ R_mod _ (π_can g₂ hg₂).inv).symm.trans
        ((congrArg (adj₂.homEquiv R_mod _) (hπ_can g₂ hg₂).2).trans
          ((adj₂.homEquiv R_mod _).apply_symm_apply _))
    have hp₂_nat : (One_sh Y₂).obj.map μ₁.op ≫ p₂_app_M =
        p₂_app_0 ≫ (One_sh Y₃).obj.map ((M_et g₂ hg₂).map μ₁).op :=
      (π_can g₂ hg₂).inv.hom.naturality μ₁.op
    have hσ_val : σ_app = (One_sh Y₃).obj.map u_T.op := hu_T
    have h_term : u_T ≫ μ₁₂ = (M_et g₂ hg₂).map μ₁ ≫ μ₂ := (hT_can Y₃).hom_ext _ _
    change u₁ ≫ (p₁₂_app ≫ σ_app) = u₁ ≫ (p₁_app ≫ p₂_app_M)
    calc
      u₁ ≫ (p₁₂_app ≫ σ_app) = (u₁ ≫ p₁₂_app) ≫ σ_app :=
        (CategoryTheory.Category.assoc _ _ _).symm
      _ = u₃ ≫ ((One_sh Y₃).obj.map μ₁₂.op ≫ (One_sh Y₃).obj.map u_T.op) := by
        rw [hp₁₂, hσ_val, CategoryTheory.Category.assoc]
      _ = u₃ ≫ (One_sh Y₃).obj.map (u_T ≫ μ₁₂).op := by
        rw [← (One_sh Y₃).obj.map_comp, ← op_comp]
      _ = u₃ ≫ (One_sh Y₃).obj.map ((M_et g₂ hg₂).map μ₁ ≫ μ₂).op := by
        rw [h_term]
      _ = (u₃ ≫ (One_sh Y₃).obj.map μ₂.op) ≫ (One_sh Y₃).obj.map ((M_et g₂ hg₂).map μ₁).op := by
        rw [op_comp, (One_sh Y₃).obj.map_comp, CategoryTheory.Category.assoc]
      _ = u₂ ≫ (p₂_app_0 ≫ (One_sh Y₃).obj.map ((M_et g₂ hg₂).map μ₁).op) := by
        rw [← hp₂, CategoryTheory.Category.assoc]
      _ = (u₂ ≫ (One_sh Y₂).obj.map μ₁.op) ≫ p₂_app_M := by
        rw [← hp₂_nat, CategoryTheory.Category.assoc]
      _ = u₁ ≫ (p₁_app ≫ p₂_app_M) := by
        rw [← hp₁, CategoryTheory.Category.assoc]

  
  have h_beta_ex : ∀ {Z' Y' Z₀ Y₀ : AlgebraicGeometry.Scheme.{u}}
      (g : Quiver.Hom Y' Y₀) (hg : AlgebraicGeometry.Etale g)
      (i' : Quiver.Hom Z' Y') (i₀ : Quiver.Hom Z₀ Y₀) (g_Z : Quiver.Hom Z' Z₀),
      CategoryTheory.IsPullback i' g_Z g i₀ →
      ∃ (β_g : CategoryTheory.Iso ((push_all i').obj (One_sh Z'))
          ((res_et g hg).obj ((push_all i₀).obj (One_sh Z₀)))),
        q_can i' ≫ β_g.hom = (π_can g hg).inv ≫ (res_et g hg).map (q_can i₀) := by
    intro Z' Y' Z₀ Y₀ g hg i' i₀ g_Z hpb
    have hg_Z : AlgebraicGeometry.Etale g_Z :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb hg
    let M_g := M_et g hg
    let M_gZ := M_et g_Z hg_Z
    let B_i₀ := B_all i₀
    let B_i' := B_all i'
    let h_paste (V' : Y'.Etale) :
        CategoryTheory.IsPullback (CategoryTheory.Limits.pullback.fst V'.hom i')
          (CategoryTheory.Limits.pullback.snd V'.hom i' ≫ g_Z) (V'.hom ≫ g) i₀ :=
      (CategoryTheory.IsPullback.of_hasPullback V'.hom i').paste_vert hpb
    have h_sq : ∀ {V'₁ V'₂ : Y'.Etale} (u_left : V'₁.left ⟶ V'₂.left)
        (f₁ : CategoryTheory.Limits.pullback V'₁.hom i' ⟶
          CategoryTheory.Limits.pullback V'₂.hom i')
        (f₂ : CategoryTheory.Limits.pullback (V'₁.hom ≫ g) i₀ ⟶
          CategoryTheory.Limits.pullback (V'₂.hom ≫ g) i₀),
        f₁ ≫ CategoryTheory.Limits.pullback.fst V'₂.hom i' =
          CategoryTheory.Limits.pullback.fst V'₁.hom i' ≫ u_left →
        f₁ ≫ CategoryTheory.Limits.pullback.snd V'₂.hom i' =
          CategoryTheory.Limits.pullback.snd V'₁.hom i' →
        f₂ ≫ CategoryTheory.Limits.pullback.fst (V'₂.hom ≫ g) i₀ =
          CategoryTheory.Limits.pullback.fst (V'₁.hom ≫ g) i₀ ≫ u_left →
        f₂ ≫ CategoryTheory.Limits.pullback.snd (V'₂.hom ≫ g) i₀ =
          CategoryTheory.Limits.pullback.snd (V'₁.hom ≫ g) i₀ →
        f₁ ≫ (h_paste V'₂).isoPullback.hom = (h_paste V'₁).isoPullback.hom ≫ f₂ := by
      intro V'₁ V'₂ u_left f₁ f₂ hf1_fst hf1_snd hf2_fst hf2_snd
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, (h_paste V'₂).isoPullback_hom_fst, hf1_fst,
          CategoryTheory.Category.assoc, hf2_fst, ← CategoryTheory.Category.assoc,
          (h_paste V'₁).isoPullback_hom_fst]
      · rw [CategoryTheory.Category.assoc, (h_paste V'₂).isoPullback_hom_snd,
          ← CategoryTheory.Category.assoc, hf1_snd, CategoryTheory.Category.assoc, hf2_snd,
          (h_paste V'₁).isoPullback_hom_snd]
    let θ : B_i' ⋙ M_gZ ≅ M_g ⋙ B_i₀ := CategoryTheory.NatIso.ofComponents
      (fun V' =>
        { hom := CategoryTheory.MorphismProperty.Over.homMk (h_paste V').isoPullback.hom
            ((h_paste V').isoPullback_hom_snd) trivial
          inv := CategoryTheory.MorphismProperty.Over.homMk (h_paste V').isoPullback.inv
            ((h_paste V').isoPullback_inv_snd) trivial
          hom_inv_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
            (h_paste V').isoPullback.hom_inv_id (Subsingleton.elim _ _)
          inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
            (h_paste V').isoPullback.inv_hom_id (Subsingleton.elim _ _) })
      (fun {V'₁ V'₂} u => by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        have heq1 : V'₁.hom ≫ 𝟙 Y' = u.left ≫ V'₂.hom :=
          (CategoryTheory.Category.comp_id V'₁.hom).trans
            (CategoryTheory.MorphismProperty.Over.w u).symm
        have heq2 : i' ≫ 𝟙 Y' = 𝟙 Z' ≫ i' :=
          (CategoryTheory.Category.comp_id i').trans (CategoryTheory.Category.id_comp i').symm
        have heq3 : (V'₁.hom ≫ g) ≫ 𝟙 Y₀ = u.left ≫ (V'₂.hom ≫ g) := by
          rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc,
            CategoryTheory.MorphismProperty.Over.w u]
        have heq4 : i₀ ≫ 𝟙 Y₀ = 𝟙 Z₀ ≫ i₀ :=
          (CategoryTheory.Category.comp_id i₀).trans (CategoryTheory.Category.id_comp i₀).symm
        exact h_sq u.left
          (CategoryTheory.Limits.pullback.map V'₁.hom i' V'₂.hom i' u.left (𝟙 Z') (𝟙 Y') heq1 heq2)
          (CategoryTheory.Limits.pullback.map (V'₁.hom ≫ g) i₀ (V'₂.hom ≫ g) i₀
            u.left (𝟙 Z₀) (𝟙 Y₀) heq3 heq4)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
            (CategoryTheory.Category.comp_id _))
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
            (CategoryTheory.Category.comp_id _)))
    let Ξ_g : (push_all i').obj ((res_et g_Z hg_Z).obj (One_sh Z₀)) ≅
        (res_et g hg).obj ((push_all i₀).obj (One_sh Z₀)) :=
      { hom :=
          { hom :=
              { app := fun V' => (One_sh Z₀).obj.map (θ.inv.app V'.unop).op
                naturality := fun {V'₁ V'₂} f =>
                  ((One_sh Z₀).obj.map_comp _ _).symm.trans
                    ((congrArg (fun k => (One_sh Z₀).obj.map k.op)
                      (θ.inv.naturality f.unop).symm).trans
                      ((One_sh Z₀).obj.map_comp _ _)) } }
        inv :=
          { hom :=
              { app := fun V' => (One_sh Z₀).obj.map (θ.hom.app V'.unop).op
                naturality := fun {V'₁ V'₂} f =>
                  ((One_sh Z₀).obj.map_comp _ _).symm.trans
                    ((congrArg (fun k => (One_sh Z₀).obj.map k.op)
                      (θ.hom.naturality f.unop).symm).trans
                      ((One_sh Z₀).obj.map_comp _ _)) } }
        hom_inv_id := by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext V'
          change (One_sh Z₀).obj.map (θ.inv.app V'.unop).op ≫
              (One_sh Z₀).obj.map (θ.hom.app V'.unop).op = 𝟙 _
          rw [← (One_sh Z₀).obj.map_comp, ← op_comp, θ.hom_inv_id_app]
          exact (One_sh Z₀).obj.map_id _
        inv_hom_id := by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext V'
          change (One_sh Z₀).obj.map (θ.hom.app V'.unop).op ≫
              (One_sh Z₀).obj.map (θ.inv.app V'.unop).op = 𝟙 _
          rw [← (One_sh Z₀).obj.map_comp, ← op_comp, θ.inv_hom_id_app]
          exact (One_sh Z₀).obj.map_id _ }
    let β_g : (push_all i').obj (One_sh Z') ≅ (res_et g hg).obj ((push_all i₀).obj (One_sh Z₀)) :=
      ((push_all i').mapIso (π_can g_Z hg_Z).symm).trans Ξ_g
    refine ⟨β_g, ?_⟩
    let adj_Y₀ := CategoryTheory.constantSheafAdj Y₀.smallEtaleTopology
