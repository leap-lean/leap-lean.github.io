      AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
      ← CategoryTheory.Category.assoc,
      AlgebraicGeometry.IsAffineOpen.isoSpec_hom hAff_VX,
      AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE,
      CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.IsAffineOpen.isoSpec_hom hAff_Uk,
      AlgebraicGeometry.IsAffineOpen.isoSpec_hom_fromSpec,
      AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
  let O_U : ((Fgt.obj U).left).Opens :=
