                (CategoryTheory.Category.assoc A₃.2.1 v₃.left p₂).symm.trans
                  ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k p₂) hv₃).trans
                    (CategoryTheory.Limits.pullback.lift_snd _ _ _))⟩,
              trivial⟩
