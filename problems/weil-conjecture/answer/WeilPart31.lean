    let pY_app : (One_sh Y').obj.obj (Opposite.op (T_can Y')) ⟶
        (One_sh Y₀).obj.obj (Opposite.op (M_g.obj (T_can Y'))) :=
      (π_can g hg).inv.hom.app (Opposite.op (T_can Y'))
    let qi₀_app_M : (One_sh Y₀).obj.obj (Opposite.op (M_g.obj (T_can Y'))) ⟶
        (One_sh Z₀).obj.obj (Opposite.op (B_i₀.obj (M_g.obj (T_can Y')))) :=
      (q_can i₀).hom.app (Opposite.op (M_g.obj (T_can Y')))
    let qi₀_app_0 : (One_sh Y₀).obj.obj (Opposite.op (T_can Y₀)) ⟶
        (One_sh Z₀).obj.obj (Opposite.op (B_i₀.obj (T_can Y₀))) :=
      (q_can i₀).hom.app (Opposite.op (T_can Y₀))
    have hqi' : u_Y' ≫ qi'_app = u_Z' ≫ (One_sh Z').obj.map τ_i'.op :=
      (CategoryTheory.Adjunction.homEquiv_unit adj_Y' R_mod _ (q_can i')).symm.trans
