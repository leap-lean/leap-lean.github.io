          let κ_pt := Q_of pt ⧸ M_pt
          let _ : Field κ_pt := Ideal.Quotient.field M_pt
          let π_κ : C₀ →ₐ[Ω] κ_pt :=
            { toRingHom := (Ideal.Quotient.mk M_pt).comp (algebraMap C₀ (Q_of pt))
              commutes' := fun c => by
                change Ideal.Quotient.mk M_pt (algebraMap C₀ (Q_of pt) (algebraMap Ω C₀ c)) =
                  Ideal.Quotient.mk M_pt (algebraMap Ω (Q_of pt) c)
                rw [← IsScalarTower.algebraMap_apply Ω C₀ (Q_of pt)] }
          have hSurj_πκ : Function.Surjective π_κ := by
            have hker : RingHom.ker π_κ.toRingHom = pt.asIdeal := by
              ext c
              change Ideal.Quotient.mk M_pt (algebraMap C₀ (Q_of pt) c) = 0 ↔ c ∈ pt.asIdeal
              rw [Ideal.Quotient.eq_zero_iff_mem]
              exact Iff.of_eq (congrArg (c ∈ ·.asIdeal) hq_pt)
            have hMax_pt : pt.asIdeal.IsMaximal :=
              (IsArtinianRing.isPrime_iff_isMaximal pt.asIdeal).mp pt.isPrime
            let _ : pt.asIdeal.IsMaximal := hMax_pt
            let _ : Field (C₀ ⧸ pt.asIdeal) := Ideal.Quotient.field pt.asIdeal
            have hr_notin : r_of pt ∉ pt.asIdeal := by
              have hp_in : pt ∈ PrimeSpectrum.basicOpen (r_of pt) := by
                rw [← SetLike.mem_coe, hr_eq pt]; rfl
              exact hp_in
            have hr_ne0 : Ideal.Quotient.mk pt.asIdeal (r_of pt) ≠ 0 := by
              rw [Ne, Ideal.Quotient.eq_zero_iff_mem]
              exact hr_notin
            obtain ⟨d, hd⟩ := Ideal.Quotient.mk_surjective (Ideal.Quotient.mk pt.asIdeal (r_of pt))⁻¹
