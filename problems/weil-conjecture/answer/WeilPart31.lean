          rw [map_sub, h12, sub_self]
        obtain ⟨x, hx⟩ :=
          CategoryTheory.Abelian.Ext.contravariant_sequence_exact₁ hSC oneR (β₁ - β₂)
            (Nat.add_comm 1 q) hsub0
        have hx0 : x = 0 := @Subsingleton.elim _ hA_van_q x 0
        rw [← hx, hx0, CategoryTheory.Abelian.Ext.comp_zero]
      have hex_top : ∀ γ : CategoryTheory.Abelian.Ext.{u} Q oneR (q + 1),
          p_top γ = 0 → ∃ β : CategoryTheory.Abelian.Ext.{u} G oneR q, i_top β = γ := by
        intro γ hγ0
        exact CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hSC oneR γ hγ0
          (Nat.add_comm 1 q)
      let f_cov : CategoryTheory.Abelian.Ext.{u} oneR A p →+
          CategoryTheory.Abelian.Ext.{u} oneR Q p :=
        AddMonoidHom.mk'
          (fun ξ => ξ.comp (CategoryTheory.Abelian.Ext.mk₀ πG) (Nat.add_zero p))
          (fun ξ₁ ξ₂ => CategoryTheory.Abelian.Ext.add_comp ξ₁ ξ₂ _ (Nat.add_zero p))
      let g_cov : CategoryTheory.Abelian.Ext.{u} oneR Q p →+
          CategoryTheory.Abelian.Ext.{u} oneR G (p + 1) :=
        AddMonoidHom.mk'
          (fun α₀ => α₀.comp δ rfl)
          (fun α₁ α₂ => CategoryTheory.Abelian.Ext.add_comp α₁ α₂ δ rfl)
      have hg_cov_surj : Function.Surjective g_cov := by
        intro α
        have hSubA : Subsingleton (CategoryTheory.Abelian.Ext.{u} oneR A (p + 1)) :=
          hA_acyc (p + 1) (by omega)
        have hα0 : α.comp (CategoryTheory.Abelian.Ext.mk₀ ηG) (Nat.add_zero (p + 1)) = 0 :=
          @Subsingleton.elim _ hSubA _ 0
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ oneR hSC α hα0 rfl
      have hg_f_cov : ∀ ξ : CategoryTheory.Abelian.Ext.{u} oneR A p,
          g_cov (f_cov ξ) = 0 := by
        intro ξ
        change (ξ.comp (CategoryTheory.Abelian.Ext.mk₀ πG) (Nat.add_zero p)).comp δ rfl = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc ξ (CategoryTheory.Abelian.Ext.mk₀ πG) δ
            (Nat.add_zero p) (Nat.zero_add 1) (by omega : p + 0 + 1 = p + 1),
          hSC.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      have hSq1 : ∀ (β : CategoryTheory.Abelian.Ext.{u} G oneR q)
          (α₀ : CategoryTheory.Abelian.Ext.{u} oneR Q p),
          Φ Q p (q + 1) hpq' (i_top β) α₀ = Φ G (p + 1) q hpq β (g_cov α₀) := by
        intro β α₀
