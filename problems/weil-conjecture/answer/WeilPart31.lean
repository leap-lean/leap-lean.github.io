      have h_leib : PowerSeries.X * (Polynomial.toPowerSeries q_μ *
            PowerSeries.derivative (Polynomial.toPowerSeries P_S') +
            Polynomial.toPowerSeries P_S' *
            PowerSeries.derivative (Polynomial.toPowerSeries q_μ)) =
          Polynomial.toPowerSeries q_μ *
            (PowerSeries.X * PowerSeries.derivative (Polynomial.toPowerSeries P_S')) +
          (PowerSeries.X * PowerSeries.derivative (Polynomial.toPowerSeries q_μ)) *
            Polynomial.toPowerSeries P_S' := by ring
      rw [h_leib, hDeriv_S', hDeriv_μ]
      set L_μ : PowerSeries A :=
        PowerSeries.mk (fun r => if r ≠ 0 ∧ d₀ ∣ r then (d₀ : A) * μ ^ (r / d₀) else 0)
      set L_S' : PowerSeries A :=
        PowerSeries.mk (fun r =>
          if r ≠ 0 ∧ d₀ ∣ r then (d₀ : A) * (S'.map (· ^ (r / d₀))).sum else 0)
      set L_tot : PowerSeries A :=
        PowerSeries.mk (fun r =>
          if r ≠ 0 ∧ d₀ ∣ r then (d₀ : A) * ((μ ::ₘ S').map (· ^ (r / d₀))).sum else 0)
      have hL_add : L_tot = L_μ + L_S' := by
        ext r
        simp only [L_tot, L_μ, L_S', map_add, PowerSeries.coeff_mk, Multiset.map_cons,
          Multiset.sum_cons]
        split_ifs
        · ring
        · ring
      rw [hL_add]
      ring

  
  have h_matrix_trace_and_reverse : ∀ (K : Type) [Field K] (m : ℕ) (B : Matrix (Fin m) (Fin m) K),
