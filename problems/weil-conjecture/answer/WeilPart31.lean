              (AddCommGrpCat.adj.unit.app (W'.unop ⟶ W)) u_w := by
            have hunit := congrArg (fun m => m (𝟙 W))
              (AddCommGrpCat.adj.unit.naturality ((yoneda.obj W).map u_w.op))
            have hid : ((yoneda.obj W).map u_w.op) (𝟙 W) = u_w :=
