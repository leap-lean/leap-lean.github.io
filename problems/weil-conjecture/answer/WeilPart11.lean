        rw [hj_eq, hEvalCongr z hβ_eq.symm _ hle]
      refine ⟨s, fun α => ?_⟩
      by_cases hMem : lam ∈ Finset.univ.image α.1
      · 
        rcases Finset.mem_image.mp hMem with ⟨j₀, _, hj₀⟩
        rw [Fin.sum_univ_succAbove _ j₀]
        have hNotMem0 : lam ∉ Finset.univ.image (faceOf α j₀).1 := by
          rw [hFaceImg α j₀, hj₀]
