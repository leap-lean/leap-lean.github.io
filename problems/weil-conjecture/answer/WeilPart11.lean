                w₁ ≫ snd₁' = snd₁_L ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) →
                w₂ ≫ fst₂' = CategoryTheory.Limits.pullback.fst g₂ η_L →
                w₂ ≫ snd₂' =
                  CategoryTheory.Limits.pullback.snd g₂ η_L ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) →
                w₁ ≫ φ'.hom = φ_L.hom ≫ w₂ →
                ∀ (e₁' : Fin (r₁ + 1) → ∀ a : Fin M₁'.m,
                    ↑(C₁'.presheaf.obj (Opposite.op (⊤ ⊓ M₁'.V a))))
                  (e₂' : Fin (r₂ + 1) → ∀ b : Fin M₂'.m,
                    ↑(C₂'.presheaf.obj (Opposite.op (⊤ ⊓ M₂'.V b))))
                  (hV₁_w : ∀ a : Fin M₁_L.m,
                    ⊤ ⊓ M₁_L.V a =
                      (TopologicalSpace.Opens.map w₁.base).obj
                        (⊤ ⊓ M₁'.V ((eIdx₁_L.trans eIdx₁'.symm) a)))
                  (hV₂_w : ∀ b : Fin M₂_L.m,
                    ⊤ ⊓ M₂_L.V b =
                      (TopologicalSpace.Opens.map w₂.base).obj
                        (⊤ ⊓ M₂'.V ((eIdx₂_L.trans eIdx₂'.symm) b))),
                  (∀ i : Fin (r₁ + 1), IsWeilTricanonicalSection M₁' ⊤ (e₁' i)) →
                  (∀ s' : ∀ a : Fin M₁'.m, ↑(C₁'.presheaf.obj (Opposite.op (⊤ ⊓ M₁'.V a))),
                    IsWeilTricanonicalSection M₁' ⊤ s' →
                    ∃! c : Fin (r₁ + 1) → R',
                      ∀ a : Fin M₁'.m,
                        s' a = ∑ i : Fin (r₁ + 1),
                          (C₁'.presheaf.map
                              (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M₁'.V a ≤ ⊤)).op).hom
                            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫
                              snd₁'.appTop).hom (c i)) * e₁' i a) →
                  (∀ j : Fin (r₂ + 1), IsWeilTricanonicalSection M₂' ⊤ (e₂' j)) →
                  (∀ s' : ∀ b : Fin M₂'.m, ↑(C₂'.presheaf.obj (Opposite.op (⊤ ⊓ M₂'.V b))),
                    IsWeilTricanonicalSection M₂' ⊤ s' →
                    ∃! c : Fin (r₂ + 1) → R',
                      ∀ b : Fin M₂'.m,
                        s' b = ∑ j : Fin (r₂ + 1),
                          (C₂'.presheaf.map
                              (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M₂'.V b ≤ ⊤)).op).hom
                            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫
                              snd₂'.appTop).hom (c j)) * e₂' j b) →
                  (∀ (i : Fin (r₁ + 1)) (a : Fin M₁_L.m),
                    e₁_L i a =
                      (C₁_L.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV₁_w a))).op).hom
                        ((w₁.app _).hom (e₁' i ((eIdx₁_L.trans eIdx₁'.symm) a)))) →
