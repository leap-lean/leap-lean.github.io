        intro a b hab
        let β : WeilStrictMonoTuple r 1 :=
          ⟨![a, b], Fin.strictMono_iff_lt_succ.mpr fun i => by fin_cases i; exact hab⟩
        let face : Fin 2 → WeilStrictMonoTuple r 0 :=
          fun j => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
