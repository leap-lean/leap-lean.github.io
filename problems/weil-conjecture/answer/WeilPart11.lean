        (CommRingCat.ofHom (algebraMap ↑(Y.presheaf.obj (Opposite.op ⊤)) (Localization.Away x))) =
        B.ι ≫ Y.toSpecΓ := by
      dsimp only [μ_x]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
      have hfac : (AlgebraicGeometry.basicOpenIsoSpecAway x).hom ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↑(Y.presheaf.obj (Opposite.op ⊤)) (Localization.Away x))) =
          U_ps.ι := by
