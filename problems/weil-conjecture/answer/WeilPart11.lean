            v_kx • MvPolynomial.X i := (Algebra.smul_def v_kx _).symm
        have h2 : MvPolynomial.C v_ix * (MvPolynomial.X k : MvPolynomial (Fin (r₀ + 1)) Ω) =
            v_ix • MvPolynomial.X k := (Algebra.smul_def v_ix _).symm
        dsimp only [L]
        rw [h1, h2]
        exact (𝒜 1).sub_mem ((𝒜 1).smul_mem v_kx (MvPolynomial.isHomogeneous_X Ω i))
          ((𝒜 1).smul_mem v_ix (MvPolynomial.isHomogeneous_X Ω k))
      have hx_not_in : j₀.base x ∉ AlgebraicGeometry.Proj.basicOpen 𝒜 L := by
        rw [← hpx_eq, hMem_basicOpen_deg1 a_x p_x L hL]
