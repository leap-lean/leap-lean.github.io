      ⟨F (X_k ^ n), (Submonoid.powers_le.mpr hx_comap) (Submonoid.pow_mem _ (Submonoid.mem_powers _) n)⟩
    have hMul : IsLocalization.mk' (Localization.Away x) (F P) den_x *
        algebraMap _ (Localization.Away x) (F (X_k ^ n)) =
        algebraMap _ (Localization.Away x) (F P) :=
      IsLocalization.mk'_spec (Localization.Away x) (F P) den_x
    have hρMul := congrArg ρ hMul
    rw [map_mul, hρ_alg, hρ_alg, map_pow, map_pow] at hρMul
    exact hρMul
  have hNullstellensatz_C : ∀ (U : C.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (m : Ideal ↑(C.presheaf.obj (Opposite.op U))) [m.IsMaximal],
      let φ_U : Ω →+* ↑(C.presheaf.obj (Opposite.op U)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ g.appLE ⊤ U le_top).hom
      ∀ s : ↑(C.presheaf.obj (Opposite.op U)), ∃ d : Ω, s - φ_U d ∈ m := by
    intro U hU m hm φ_U
    let A_U := ↑(C.presheaf.obj (Opposite.op U))
    have hFT_app : (g.appLE ⊤ U le_top).hom.FiniteType :=
      g.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top _) hU le_top
    have hSurjΓ : Function.Surjective
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).symm.commRingCatIsoToRingEquiv.surjective
    have hFT_φ : φ_U.FiniteType :=
      hFT_app.comp (RingHom.FiniteType.of_surjective _ hSurjΓ)
    let _ : Algebra Ω A_U := φ_U.toAlgebra
    have hAlgFT : Algebra.FiniteType Ω A_U := hFT_φ
    obtain ⟨s_gen, hs_gen⟩ := hAlgFT
    let aev : MvPolynomial ↥s_gen Ω →ₐ[Ω] A_U :=
      MvPolynomial.aeval (Subtype.val : ↥s_gen → A_U)
    have haev_surj : Function.Surjective aev := by
      intro b
      have hb : b ∈ (⊤ : Subalgebra Ω A_U) := trivial
      have hSubRange : Set.range (Subtype.val : ↥s_gen → A_U) = (↑s_gen : Set A_U) :=
        Subtype.range_coe
      rw [← hs_gen, ← hSubRange] at hb
      have hRange := MvPolynomial.aeval_range (R := Ω) (Subtype.val : ↥s_gen → A_U)
      change b ∈ aev.range
      rwa [hRange]
    let _ : Field (A_U ⧸ m) := @Ideal.Quotient.field _ _ m hm
    let π_q : MvPolynomial ↥s_gen Ω →+* (A_U ⧸ m) :=
      (Ideal.Quotient.mk m).comp aev.toRingHom
    have hπ_surj : Function.Surjective π_q :=
      (Ideal.Quotient.mk_surjective).comp haev_surj
    have _ : (RingHom.ker π_q).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective π_q hπ_surj
    obtain ⟨v₀, hv₀⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp ‹_›
    intro b
    obtain ⟨Q, hQ⟩ := haev_surj b
    let d₀ : Ω := (MvPolynomial.aeval v₀) Q
    refine ⟨d₀, ?_⟩
    have hMemVan : Q - MvPolynomial.C d₀ ∈ RingHom.ker π_q := by
      rw [hv₀, MvPolynomial.mem_vanishingIdeal_iff]
      intro v hv
      rw [Set.mem_singleton_iff.mp hv, map_sub, MvPolynomial.aeval_C]
      exact sub_self d₀
    rw [RingHom.mem_ker] at hMemVan
    dsimp only [π_q, RingHom.comp_apply] at hMemVan
    have hQ' : aev.toRingHom Q = b := hQ
    have hC_eq : aev.toRingHom (MvPolynomial.C d₀) = φ_U d₀ :=
      MvPolynomial.aeval_C _ d₀
    rw [map_sub, hQ', hC_eq, Ideal.Quotient.eq_zero_iff_mem] at hMemVan
    exact hMemVan
  
  
  
  
  have hPart1 : ∃ (j : letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
                       (⊤ : C.Opens).toScheme ⟶ AlgebraicGeometry.Proj 𝒜),
      IsLineBundleProjMorphism M ⊤ φ_Ω r₀ e' j ∧
      AlgebraicGeometry.IsProper j ∧
      AlgebraicGeometry.LocallyOfFiniteType j := by
    have hProjHom_ext : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
        (m₁ m₂ : Y ⟶ AlgebraicGeometry.Proj 𝒜),
        (∀ k : Fin (r₀ + 1),
          let D_k := AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X k)
          ∃ (V_k : Y.Opens)
            (e₁ : V_k ≤ (TopologicalSpace.Opens.map m₁.base).obj D_k)
            (e₂ : V_k ≤ (TopologicalSpace.Opens.map m₂.base).obj D_k),
            (TopologicalSpace.Opens.map m₁.base).obj D_k ≤ V_k ∧
            AlgebraicGeometry.Scheme.Hom.resLE m₁ D_k V_k e₁ =
              AlgebraicGeometry.Scheme.Hom.resLE m₂ D_k V_k e₂) →
        m₁ = m₂ := by
      intro Y m₁ m₂ hLoc
      let U_cov : Fin (r₀ + 1) → Y.Opens := fun k =>
        (TopologicalSpace.Opens.map m₁.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X k))
      have hUCov_top : (⨆ k : Fin (r₀ + 1), U_cov k) = ⊤ := by
        rw [eq_top_iff]
        intro z _
        have hz : m₁.base z ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜).Opens) := trivial
        rw [← hProjCov, TopologicalSpace.Opens.mem_iSup] at hz
        exact TopologicalSpace.Opens.mem_iSup.mpr hz
      let 𝒰 : (⨆ k : Fin (r₀ + 1), U_cov k).toScheme.OpenCover :=
        AlgebraicGeometry.Scheme.Opens.iSupOpenCover U_cov
      have hTopIso : (⨆ k : Fin (r₀ + 1), U_cov k).ι ≫ m₁ =
          (⨆ k : Fin (r₀ + 1), U_cov k).ι ≫ m₂ := by
        apply AlgebraicGeometry.Scheme.Cover.hom_ext 𝒰
        intro k
        dsimp only [𝒰, AlgebraicGeometry.Scheme.Opens.iSupOpenCover] at k ⊢
        rw [← CategoryTheory.Category.assoc, Y.homOfLE_ι (le_iSup U_cov k),
          ← CategoryTheory.Category.assoc, Y.homOfLE_ι (le_iSup U_cov k)]
        obtain ⟨V_k, e₁, e₂, hle, hres⟩ := hLoc k
        have hEqV : U_cov k = V_k := le_antisymm hle e₁
        subst hEqV
        rw [← AlgebraicGeometry.Scheme.Hom.resLE_comp_ι m₁ e₁,
          ← AlgebraicGeometry.Scheme.Hom.resLE_comp_ι m₂ e₂, hres]
      have _ : IsIso (⨆ k : Fin (r₀ + 1), U_cov k).ι := by
        rw [hUCov_top, ← Y.topIso_hom]
        infer_instance
      exact (cancel_epi (⨆ k : Fin (r₀ + 1), U_cov k).ι).mp hTopIso
    have hIsUnit_basicOpen_ι : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
        (s : ↑(Y.presheaf.obj (Opposite.op ⊤))),
        IsUnit ((Y.basicOpen s).ι.appTop.hom s) := by
      intro Y s
      let B := Y.basicOpen s
