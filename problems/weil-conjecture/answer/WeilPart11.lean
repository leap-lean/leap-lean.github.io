      intro p d₁ d₂; funext α; dsimp only [Θ]
      change H_Z.res _ (e _ (d₁ α + d₂ α)) = _ + _
      rw [map_add, map_add]
    have hΘ_sum : ∀ (p : ℕ) {ι : Type} (I : Finset ι) (f_i : ι → WeilModuleCechCochain V H_C p),
