    have hιR_inj : Function.Injective ι_R :=
      hLiftInj p_z.asIdeal.primeCompl (Localization.AtPrime p_z.asIdeal) φ_W.hom hφW_inj hUnitR
    have hι_comp : ι_R.comp g_loc = ι_B := by
      apply IsLocalization.ringHom_ext q.asIdeal.primeCompl
      ext b
