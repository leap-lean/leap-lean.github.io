        have hImg0 : Finset.univ.image α.1 = insert lam (Finset.univ.image (faceOf α j₀).1) := by
          rw [hFaceImg α j₀, hj₀, Finset.insert_erase hMem]
        have hle0 : U lam ⊓ weilCoverChartInter U (faceOf α j₀) ≤ weilCoverChartInter U α :=
