  have hClear : ∀ u : F, ∃ a ∈ A₀, a ≠ 0 ∧ a * u ∈ E₀_inf := by
    intro u
    obtain ⟨a, ha, ha_ne, hau⟩ := hClear0 u
    exact ⟨a, ha, ha_ne, hE0_le hau⟩
  
  let L_sub : Submodule Ω F :=
    { carrier := {h : F | ∃ (N : ℕ) (P : Polynomial Ω), x ^ N * h = Polynomial.aeval x P}
      zero_mem' := ⟨0, 0, by simp⟩
      add_mem' := by
        rintro h₁ h₂ ⟨N₁, P₁, hEq₁⟩ ⟨N₂, P₂, hEq₂⟩
        refine ⟨N₁ + N₂, Polynomial.X ^ N₂ * P₁ + Polynomial.X ^ N₁ * P₂, ?_⟩
        simp only [map_add, map_mul, map_pow, Polynomial.aeval_X]
        calc x ^ (N₁ + N₂) * (h₁ + h₂)
            = x ^ N₂ * (x ^ N₁ * h₁) + x ^ N₁ * (x ^ N₂ * h₂) := by
              rw [pow_add]; ring
          _ = x ^ N₂ * Polynomial.aeval x P₁ + x ^ N₁ * Polynomial.aeval x P₂ := by
              rw [hEq₁, hEq₂]
      smul_mem' := by
        rintro c h ⟨N, P, hEq⟩
        refine ⟨N, c • P, ?_⟩
        rw [Algebra.smul_def, map_smul, Algebra.smul_def]
        calc x ^ N * (algebraMap Ω F c * h)
            = algebraMap Ω F c * (x ^ N * h) := by ring
          _ = algebraMap Ω F c * Polynomial.aeval x P := by rw [hEq] }
  let laurentCoeff : ℕ → Polynomial Ω → Ω :=
    fun N P => if N = 0 then 0 else P.coeff (N - 1)
  have hInv : ∀ (h : F) (N₁ N₂ : ℕ) (P₁ P₂ : Polynomial Ω),
      x ^ N₁ * h = Polynomial.aeval x P₁ →
      x ^ N₂ * h = Polynomial.aeval x P₂ →
      laurentCoeff N₁ P₁ = laurentCoeff N₂ P₂ := by
    intro h N₁ N₂ P₁ P₂ h₁ h₂
    have hPolyEq : Polynomial.X ^ N₂ * P₁ = Polynomial.X ^ N₁ * P₂ := by
      apply hinj_aeval
      simp only [map_mul, map_pow, Polynomial.aeval_X]
      calc x ^ N₂ * Polynomial.aeval x P₁
          = x ^ N₂ * (x ^ N₁ * h) := by rw [← h₁]
        _ = x ^ N₁ * (x ^ N₂ * h) := by ring
        _ = x ^ N₁ * Polynomial.aeval x P₂ := by rw [← h₂]
    cases N₁ with
    | zero =>
      cases N₂ with
      | zero => rfl
      | succ n₂ =>
        dsimp only [laurentCoeff]
        rw [if_pos rfl, if_neg (by omega : n₂ + 1 ≠ 0)]
        simp only [Nat.add_sub_cancel, pow_zero, one_mul] at hPolyEq ⊢
        have hc := congrArg (fun Q : Polynomial Ω => Q.coeff n₂) hPolyEq
        rw [Polynomial.coeff_X_pow_mul'] at hc
        rw [if_neg (by omega : ¬(n₂ + 1 ≤ n₂))] at hc
        exact hc
    | succ n₁ =>
      cases N₂ with
      | zero =>
        dsimp only [laurentCoeff]
        rw [if_neg (by omega : n₁ + 1 ≠ 0), if_pos rfl]
        simp only [Nat.add_sub_cancel, pow_zero, one_mul] at hPolyEq ⊢
        have hc := congrArg (fun Q : Polynomial Ω => Q.coeff n₁) hPolyEq
        rw [Polynomial.coeff_X_pow_mul'] at hc
        rw [if_neg (by omega : ¬(n₁ + 1 ≤ n₁))] at hc
        exact hc
      | succ n₂ =>
        dsimp only [laurentCoeff]
        rw [if_neg (by omega : n₁ + 1 ≠ 0), if_neg (by omega : n₂ + 1 ≠ 0)]
        simp only [Nat.add_sub_cancel]
        have hc := congrArg (fun Q : Polynomial Ω => Q.coeff (n₁ + n₂ + 1)) hPolyEq
        have hidx₁ : n₁ + n₂ + 1 = n₁ + (n₂ + 1) := by omega
        have hidx₂ : n₁ + n₂ + 1 = n₂ + (n₁ + 1) := by omega
        have hL : (Polynomial.X ^ (n₂ + 1) * P₁).coeff (n₁ + n₂ + 1) = P₁.coeff n₁ := by
          rw [hidx₁, Polynomial.coeff_X_pow_mul]
        have hR : (Polynomial.X ^ (n₁ + 1) * P₂).coeff (n₁ + n₂ + 1) = P₂.coeff n₂ := by
          rw [hidx₂, Polynomial.coeff_X_pow_mul]
        rw [hL, hR] at hc
        exact hc
  let f₀_raw : ↥L_sub → Ω := fun u =>
    laurentCoeff (Classical.choose u.2) (Classical.choose (Classical.choose_spec u.2))
  have hf₀_eq : ∀ (u : ↥L_sub) (N : ℕ) (P : Polynomial Ω),
      x ^ N * u.1 = Polynomial.aeval x P → f₀_raw u = laurentCoeff N P := by
    intro u N P hEq
    exact hInv u.1 _ N _ P (Classical.choose_spec (Classical.choose_spec u.2)) hEq
  let f₀ : ↥L_sub →ₗ[Ω] Ω :=
    { toFun := f₀_raw
      map_add' := by
        intro u₁ u₂
        obtain ⟨N₁, P₁, h₁⟩ := u₁.2
        obtain ⟨N₂, P₂, h₂⟩ := u₂.2
        have h₁' : x ^ (N₁ + N₂ + 1) * u₁.1 =
            Polynomial.aeval x (Polynomial.X ^ (N₂ + 1) * P₁) := by
          simp only [map_mul, map_pow, Polynomial.aeval_X]
          calc x ^ (N₁ + N₂ + 1) * u₁.1 = x ^ (N₂ + 1) * (x ^ N₁ * u₁.1) := by
                rw [show N₁ + N₂ + 1 = (N₂ + 1) + N₁ by omega, pow_add]; ring
            _ = x ^ (N₂ + 1) * Polynomial.aeval x P₁ := by rw [h₁]
        have h₂' : x ^ (N₁ + N₂ + 1) * u₂.1 =
            Polynomial.aeval x (Polynomial.X ^ (N₁ + 1) * P₂) := by
          simp only [map_mul, map_pow, Polynomial.aeval_X]
          calc x ^ (N₁ + N₂ + 1) * u₂.1 = x ^ (N₁ + 1) * (x ^ N₂ * u₂.1) := by
                rw [show N₁ + N₂ + 1 = (N₁ + 1) + N₂ by omega, pow_add]; ring
            _ = x ^ (N₁ + 1) * Polynomial.aeval x P₂ := by rw [h₂]
        have h₁₂' : x ^ (N₁ + N₂ + 1) * (u₁ + u₂).1 =
            Polynomial.aeval x (Polynomial.X ^ (N₂ + 1) * P₁ + Polynomial.X ^ (N₁ + 1) * P₂) := by
          change x ^ (N₁ + N₂ + 1) * (u₁.1 + u₂.1) = _
          rw [mul_add, h₁', h₂', map_add]
        rw [hf₀_eq u₁ _ _ h₁', hf₀_eq u₂ _ _ h₂', hf₀_eq (u₁ + u₂) _ _ h₁₂']
        dsimp only [laurentCoeff]
        have hne : N₁ + N₂ + 1 ≠ 0 := by omega
        simp only [hne, ↓reduceIte, Nat.add_sub_cancel, Polynomial.coeff_add]
      map_smul' := by
        intro c u
        obtain ⟨N, P, h⟩ := u.2
        have h' : x ^ (N + 1) * u.1 = Polynomial.aeval x (Polynomial.X * P) := by
          simp only [map_mul, Polynomial.aeval_X]
          calc x ^ (N + 1) * u.1 = x * (x ^ N * u.1) := by rw [pow_succ']; ring
            _ = x * Polynomial.aeval x P := by rw [h]
        have hc' : x ^ (N + 1) * (c • u).1 = Polynomial.aeval x (c • (Polynomial.X * P)) := by
          change x ^ (N + 1) * (c • u.1) = _
          rw [Algebra.smul_def, map_smul, Algebra.smul_def]
          calc x ^ (N + 1) * (algebraMap Ω F c * u.1)
              = algebraMap Ω F c * (x ^ (N + 1) * u.1) := by ring
            _ = algebraMap Ω F c * Polynomial.aeval x (Polynomial.X * P) := by rw [h']
        rw [hf₀_eq (c • u) _ _ hc', hf₀_eq u _ _ h', RingHom.id_apply]
        dsimp only [laurentCoeff]
        have hne : N + 1 ≠ 0 := by omega
        simp only [hne, ↓reduceIte, Nat.add_sub_cancel, Polynomial.coeff_smul] }
  obtain ⟨res, hres_ext⟩ := LinearMap.exists_extend f₀
  have hres_eq : ∀ (h : F) (N : ℕ) (P : Polynomial Ω),
      x ^ N * h = Polynomial.aeval x P → res h = laurentCoeff N P := by
    intro h N P hEq
    have hh : h ∈ L_sub := ⟨N, P, hEq⟩
    have hcomp : res h = f₀ ⟨h, hh⟩ := by
      have h1 := LinearMap.congr_fun hres_ext ⟨h, hh⟩
      simpa using h1
    rw [hcomp]
    exact hf₀_eq ⟨h, hh⟩ N P hEq
  have hres_A0 : ∀ h ∈ A₀, res h = 0 := by
    intro h hh
    change h ∈ Algebra.adjoin Ω ({x} : Set F) at hh
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hh
    rcases hh with ⟨P, hP⟩
    change Polynomial.aeval x P = h at hP
    have hEq : x ^ 0 * h = Polynomial.aeval x P := by rw [pow_zero, one_mul, ← hP]
    rw [hres_eq h 0 P hEq]
    rfl
  have hres_Ainf : ∀ h : F, x ^ 2 * h ∈ A_inf → res h = 0 := by
    intro h hh
    change x ^ 2 * h ∈ Algebra.adjoin Ω ({x⁻¹} : Set F) at hh
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hh
    rcases hh with ⟨Q, hQ⟩
    change Polynomial.aeval x⁻¹ Q = x ^ 2 * h at hQ
    let M : ℕ := Q.natDegree
    let Q_tilde : Polynomial Ω :=
      ∑ m ∈ Finset.range (M + 1), Polynomial.C (Q.coeff m) * Polynomial.X ^ (M - m)
    have hEq : x ^ (M + 2) * h = Polynomial.aeval x Q_tilde := by
      have h1 : x ^ (M + 2) * h = x ^ M * Polynomial.aeval x⁻¹ Q := by
        calc x ^ (M + 2) * h = x ^ M * (x ^ 2 * h) := by rw [pow_add]; ring
          _ = x ^ M * Polynomial.aeval x⁻¹ Q := by rw [← hQ]
      rw [h1, Polynomial.aeval_eq_sum_range, Finset.mul_sum]
      dsimp only [Q_tilde]
      simp only [map_sum, map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
      refine Finset.sum_congr rfl ?_
      intro m hm
      have hm_le : m ≤ M := Nat.lt_succ_iff.mp (Finset.mem_range.mp hm)
      rw [Algebra.smul_def]
      have hpow : x ^ M * (x⁻¹) ^ m = x ^ (M - m) := by
        have hM : M = (M - m) + m := (Nat.sub_add_cancel hm_le).symm
        calc x ^ M * (x⁻¹) ^ m
            = (x ^ (M - m) * x ^ m) * (x⁻¹) ^ m := by rw [← pow_add, ← hM]
          _ = x ^ (M - m) * (x * x⁻¹) ^ m := by rw [mul_assoc, ← mul_pow]
          _ = x ^ (M - m) := by rw [mul_inv_cancel₀ hx_ne, one_pow, mul_one]
      calc x ^ M * (algebraMap Ω F (Q.coeff m) * (x⁻¹) ^ m)
          = algebraMap Ω F (Q.coeff m) * (x ^ M * (x⁻¹) ^ m) := by ring
        _ = algebraMap Ω F (Q.coeff m) * x ^ (M - m) := by rw [hpow]
    rw [hres_eq h (M + 2) Q_tilde hEq]
    dsimp only [laurentCoeff, Q_tilde]
    rw [if_neg (by omega : M + 2 ≠ 0)]
    have hsub : M + 2 - 1 = M + 1 := by omega
    rw [hsub, Polynomial.finsetSum_coeff]
    refine Finset.sum_eq_zero ?_
    intro m hm
    rw [Polynomial.coeff_C_mul_X_pow, if_neg]
    omega
  have hres_mon : ∀ (c : Ω) (k : ℤ),
      res (algebraMap Ω F c * x ^ k) = if k = -1 then c else 0 := by
    intro c k
    cases k with
    | ofNat n =>
      change res (algebraMap Ω F c * x ^ (n : ℤ)) = if (n : ℤ) = -1 then c else 0
      rw [zpow_natCast]
      have hEq : x ^ 0 * (algebraMap Ω F c * x ^ n) =
          Polynomial.aeval x (Polynomial.C c * Polynomial.X ^ n) := by
        simp
      rw [hres_eq _ 0 _ hEq, if_neg (by omega : (n : ℤ) ≠ -1)]
      rfl
    | negSucc n =>
      have hEq : x ^ (n + 1) * (algebraMap Ω F c * x ^ Int.negSucc n) =
          Polynomial.aeval x (Polynomial.C c) := by
        rw [zpow_negSucc, Polynomial.aeval_C]
        calc x ^ (n + 1) * (algebraMap Ω F c * (x ^ (n + 1))⁻¹)
            = algebraMap Ω F c * (x ^ (n + 1) * (x ^ (n + 1))⁻¹) := by ring
          _ = algebraMap Ω F c := by rw [mul_inv_cancel₀ (pow_ne_zero (n + 1) hx_ne), mul_one]
      rw [hres_eq _ (n + 1) _ hEq]
      dsimp only [laurentCoeff]
      rw [if_neg (by omega : n + 1 ≠ 0)]
      have hsub : n + 1 - 1 = n := by omega
      rw [hsub]
      have hC : Polynomial.C c = Polynomial.C c * Polynomial.X ^ 0 := by simp
      rw [hC, Polynomial.coeff_C_mul_X_pow]
      by_cases hn0 : n = 0
      · subst hn0; simp
      · rw [if_neg hn0, if_neg (by omega : Int.negSucc n ≠ -1)]
  have hres_sum : ∀ h : F, (∃ N : ℕ, x ^ N * h ∈ A₀) →
      (Function.support fun k : ℤ => res (x ^ (-k - 1) * h)).Finite ∧
      (∑ᶠ k : ℤ, algebraMap Ω F (res (x ^ (-k - 1) * h)) * x ^ k) = h := by
    rintro h ⟨N, hNh⟩
    change x ^ N * h ∈ Algebra.adjoin Ω ({x} : Set F) at hNh
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hNh
    rcases hNh with ⟨P, hP⟩
    change Polynomial.aeval x P = x ^ N * h at hP
    let d : ℕ := P.natDegree
    let ι : ℕ → ℤ := fun i => (i : ℤ) - (N : ℤ)
    have hinj_ι : Function.Injective ι := by
      intro i j hij
      dsimp only [ι] at hij
      omega
    have hh_decomp : h = ∑ i ∈ Finset.range (d + 1),
        algebraMap Ω F (P.coeff i) * x ^ (ι i) := by
      have hxN_ne : x ^ N ≠ 0 := pow_ne_zero N hx_ne
      apply mul_left_cancel₀ hxN_ne
      rw [← hP, Polynomial.aeval_eq_sum_range, Finset.mul_sum]
      refine Finset.sum_congr rfl ?_
      intro i _
      rw [Algebra.smul_def]
      have hzpow : x ^ N * x ^ (ι i) = x ^ i := by
        rw [← zpow_natCast x N, ← zpow_natCast x i, ← zpow_add₀ hx_ne]
        congr 1
        dsimp only [ι]
        omega
      calc algebraMap Ω F (P.coeff i) * x ^ i
          = algebraMap Ω F (P.coeff i) * (x ^ N * x ^ (ι i)) := by rw [hzpow]
        _ = x ^ N * (algebraMap Ω F (P.coeff i) * x ^ (ι i)) := by ring
    have hres_k : ∀ k : ℤ, res (x ^ (-k - 1) * h) =
        ∑ i ∈ Finset.range (d + 1), if k = ι i then P.coeff i else 0 := by
      intro k
      have hmul : x ^ (-k - 1) * h = ∑ i ∈ Finset.range (d + 1),
          algebraMap Ω F (P.coeff i) * x ^ (-k - 1 + ι i) := by
        rw [hh_decomp, Finset.mul_sum]
        refine Finset.sum_congr rfl ?_
        intro i _
        calc x ^ (-k - 1) * (algebraMap Ω F (P.coeff i) * x ^ (ι i))
            = algebraMap Ω F (P.coeff i) * (x ^ (-k - 1) * x ^ (ι i)) := by ring
          _ = algebraMap Ω F (P.coeff i) * x ^ (-k - 1 + ι i) := by rw [← zpow_add₀ hx_ne]
      rw [hmul, map_sum]
      refine Finset.sum_congr rfl ?_
      intro i _
      rw [hres_mon]
      have hiff : (-k - 1 + ι i = -1) ↔ (k = ι i) := by omega
      by_cases hk : k = ι i
      · rw [if_pos (hiff.mpr hk), if_pos hk]
      · rw [if_neg (mt hiff.mp hk), if_neg hk]
    let S_h : Finset ℤ := (Finset.range (d + 1)).image ι
    have hSupp : Function.support (fun k : ℤ => res (x ^ (-k - 1) * h)) ⊆ ↑S_h := by
      intro k hk
      rw [Function.mem_support] at hk
      rw [Finset.mem_coe, Finset.mem_image]
      by_contra hnot
      apply hk
      rw [hres_k k]
      refine Finset.sum_eq_zero ?_
      intro i hi
      rw [if_neg]
      intro hEq
      exact hnot ⟨i, hi, hEq.symm⟩
    have hSuppTerm : Function.support
        (fun k : ℤ => algebraMap Ω F (res (x ^ (-k - 1) * h)) * x ^ k) ⊆ ↑S_h := by
      intro k hk
      rw [Function.mem_support] at hk
      apply hSupp
      rw [Function.mem_support]
      intro h0
      apply hk
      rw [h0, map_zero, zero_mul]
    refine ⟨S_h.finite_toSet.subset hSupp, ?_⟩
    rw [finsum_eq_sum_of_support_subset _ hSuppTerm]
    rw [Finset.sum_image (fun i _ j _ hij => hinj_ι hij)]
    refine (Finset.sum_congr rfl ?_).trans hh_decomp.symm
    intro i hi
    congr 2
    rw [hres_k (ι i)]
    rw [← Finset.add_sum_erase _ _ hi, if_pos rfl]
    have hrest : (∑ j ∈ (Finset.range (d + 1)).erase i,
        if ι i = ι j then P.coeff j else 0) = 0 := by
      refine Finset.sum_eq_zero ?_
      intro j hj
      have hne : j ≠ i := Finset.ne_of_mem_erase hj
      rw [if_neg (fun hEq => hne (hinj_ι hEq.symm))]
    rw [hrest, add_zero]
  
  have hExtend : ∀ (lam : ↥E₀_inf →ₗ[Ω] Ω),
      (∀ (v : F) (hv : v ∈ E₀_inf),
        (Function.support fun k : ℤ => lam ⟨x ^ (-k - 1) * v, hShift (-k - 1) v hv⟩).Finite) →
      ∃ (Φ : F →ₗ[↥K₀] ↥K₀),
        (∀ (v : F) (hv : v ∈ E₀_inf),
          (Φ v : F) = ∑ᶠ k : ℤ,
            algebraMap Ω F (lam ⟨x ^ (-k - 1) * v, hShift (-k - 1) v hv⟩) * x ^ k) ∧
        (∀ (Ψ : F →ₗ[↥K₀] ↥K₀), (∀ v ∈ E₀_inf, Ψ v = Φ v) → Ψ = Φ) := by
    intro lam hlam_fin
    let term : ∀ (v : F), v ∈ E₀_inf → ℤ → F :=
      fun v hv k => algebraMap Ω F (lam ⟨x ^ (-k - 1) * v, hShift (-k - 1) v hv⟩) * x ^ k
    have hterm_fin : ∀ (v : F) (hv : v ∈ E₀_inf), Function.HasFiniteSupport (term v hv) := by
      intro v hv
      refine (hlam_fin v hv).subset ?_
      intro k hk
      rw [Function.mem_support] at hk ⊢
      intro h0
      apply hk
      dsimp only [term]
      rw [h0, map_zero, zero_mul]
    let ϕ₀ : ∀ (v : F), v ∈ E₀_inf → F := fun v hv => ∑ᶠ k : ℤ, term v hv k
    have hϕ₀_congr : ∀ (u₁ u₂ : F) (hu₁ : u₁ ∈ E₀_inf) (hu₂ : u₂ ∈ E₀_inf),
        u₁ = u₂ → ϕ₀ u₁ hu₁ = ϕ₀ u₂ hu₂ := by
      intro u₁ u₂ hu₁ hu₂ hEq
      subst hEq
      rfl
    have hϕ₀_K₀ : ∀ (v : F) (hv : v ∈ E₀_inf), ϕ₀ v hv ∈ K₀ := by
      intro v hv
      dsimp only [ϕ₀]
      rw [finsum_eq_sum (term v hv) (hterm_fin v hv)]
      refine K₀.sum_mem ?_
      intro k _
      exact K₀.mul_mem (K₀.algebraMap_mem _) (K₀.pow_mem hx_K₀ k)
    have hϕ₀_add : ∀ (v₁ v₂ : F) (hv₁ : v₁ ∈ E₀_inf) (hv₂ : v₂ ∈ E₀_inf),
        ϕ₀ (v₁ + v₂) (E₀_inf.add_mem hv₁ hv₂) = ϕ₀ v₁ hv₁ + ϕ₀ v₂ hv₂ := by
      intro v₁ v₂ hv₁ hv₂
      dsimp only [ϕ₀]
      have hpt : ∀ k : ℤ,
          term (v₁ + v₂) (E₀_inf.add_mem hv₁ hv₂) k = term v₁ hv₁ k + term v₂ hv₂ k := by
        intro k
        dsimp only [term]
        have hsub : (⟨x ^ (-k - 1) * (v₁ + v₂),
            hShift (-k - 1) (v₁ + v₂) (E₀_inf.add_mem hv₁ hv₂)⟩ : ↥E₀_inf) =
            ⟨x ^ (-k - 1) * v₁, hShift (-k - 1) v₁ hv₁⟩ +
              ⟨x ^ (-k - 1) * v₂, hShift (-k - 1) v₂ hv₂⟩ := by
          ext
          exact mul_add _ _ _
        rw [hsub, map_add, map_add, add_mul]
      simp_rw [hpt]
      exact finsum_add_distrib (hterm_fin v₁ hv₁) (hterm_fin v₂ hv₂)
    have hϕ₀_smul_Ω : ∀ (c : Ω) (v : F) (hv : v ∈ E₀_inf),
        ϕ₀ (algebraMap Ω F c * v) (by rw [← Algebra.smul_def]; exact E₀_inf.smul_mem c hv) =
          algebraMap Ω F c * ϕ₀ v hv := by
      intro c v hv
      have hcv : algebraMap Ω F c * v ∈ E₀_inf := by
        rw [← Algebra.smul_def]
        exact E₀_inf.smul_mem c hv
      dsimp only [ϕ₀]
      have hpt : ∀ k : ℤ,
          term (algebraMap Ω F c * v) hcv k =
            algebraMap Ω F c • term v hv k := by
        intro k
        dsimp only [term]
        have hsub : (⟨x ^ (-k - 1) * (algebraMap Ω F c * v),
            hShift (-k - 1) (algebraMap Ω F c * v) hcv⟩ : ↥E₀_inf) =
            c • ⟨x ^ (-k - 1) * v, hShift (-k - 1) v hv⟩ := by
          ext
          change x ^ (-k - 1) * (algebraMap Ω F c * v) = c • (x ^ (-k - 1) * v)
          rw [Algebra.smul_def]
          ring
        rw [hsub, map_smul, smul_eq_mul, map_mul, smul_eq_mul, mul_assoc]
      simp_rw [hpt]
      rw [← smul_finsum, smul_eq_mul]
    have hϕ₀_x : ∀ (v : F) (hv : v ∈ E₀_inf),
        ϕ₀ (x * v) (by simpa [zpow_one] using hShift 1 v hv) = x * ϕ₀ v hv := by
      intro v hv
      have hxv : x * v ∈ E₀_inf := by simpa [zpow_one] using hShift 1 v hv
      dsimp only [ϕ₀]
      rw [← finsum_comp_equiv (Equiv.addRight (1 : ℤ))]
      have hpt : ∀ j : ℤ,
          term (x * v) hxv (Equiv.addRight (1 : ℤ) j) = x • term v hv j := by
        intro j
        change term (x * v) hxv (j + 1) = x * term v hv j
        dsimp only [term]
        have hexp : x ^ (-(j + 1) - 1) * (x * v) = x ^ (-j - 1) * v := by
          calc x ^ (-(j + 1) - 1) * (x * v)
              = (x ^ (-(j + 1) - 1) * x ^ (1 : ℤ)) * v := by rw [zpow_one]; ring
            _ = x ^ (-(j + 1) - 1 + 1) * v := by rw [← zpow_add₀ hx_ne]
            _ = x ^ (-j - 1) * v := by congr 2; omega
        have hsub : (⟨x ^ (-(j + 1) - 1) * (x * v),
            hShift (-(j + 1) - 1) (x * v) hxv⟩ : ↥E₀_inf) =
            ⟨x ^ (-j - 1) * v, hShift (-j - 1) v hv⟩ := Subtype.ext hexp
        have hxpow : x ^ (j + 1) = x ^ j * x := by rw [zpow_add₀ hx_ne, zpow_one]
        rw [hsub, hxpow]
        ring
      simp_rw [hpt]
      rw [← smul_finsum, smul_eq_mul]
    have hϕ₀_A₀ : ∀ (a : F), a ∈ A₀ → ∀ (v : F) (hv : v ∈ E₀_inf),
        ∃ hav : a * v ∈ E₀_inf, ϕ₀ (a * v) hav = a * ϕ₀ v hv := by
      intro a ha
      change a ∈ Algebra.adjoin Ω ({x} : Set F) at ha
      refine Algebra.adjoin_induction
        (p := fun a _ => ∀ (v : F) (hv : v ∈ E₀_inf),
