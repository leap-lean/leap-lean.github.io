          map_add' := fun x y => Subtype.ext (map_add (R0_vert.res h) x.1 y.1) }
      res_smul := fun h a x => Subtype.ext (R0_vert.res_smul h a x.1)
      res_id := fun U x => Subtype.ext (R0_vert.res_id U x.1)
      res_comp := fun h₁ h₂ x => Subtype.ext (R0_vert.res_comp h₁ h₂ x.1) }
  let Im_sub : ∀ U : Z.Opens, Submodule ↑(Z.presheaf.obj (Opposite.op U)) (R0_vert.sec U) :=
    fun U =>
      letI := instModE U 0
      (LinearMap.range (η_raw U)).comap (K0_sub U).subtype
  let Q_1 : WeilPresheafModule Z :=
    { sec := fun U => R0_vert.sec U ⧸ Im_sub U
      instAddCommGroup := fun _ => inferInstance
      instModule := fun _ => inferInstance
      res := fun {U W} h =>
        (Submodule.mapQ ((Im_sub U).restrictScalars ℤ) ((Im_sub W).restrictScalars ℤ)
