    have hB2 : Function.Injective res0 := by
      intro s₁ s₂ h_eq
      apply (e_Y W).injective
      let y₁ := e_Y W s₁
      let y₂ := e_Y W s₂
      let iU : ∀ a : Fin r, U a ⟶ W := fun a => CategoryTheory.homOfLE (hU_le a)
      let sf : ∀ a : Fin r, ↑(Y.presheaf.obj (Opposite.op (U a))) :=
        fun a => (Y.presheaf.map (iU a).op).hom y₁
      have hCompat : TopCat.Presheaf.IsCompatible Y.presheaf U sf := by
        intro a b
        have hL : TopologicalSpace.Opens.infLELeft (U a) (U b) =
            CategoryTheory.homOfLE (inf_le_left : U a ⊓ U b ≤ U a) := Subsingleton.elim _ _
