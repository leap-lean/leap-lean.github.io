    have hDichotomy : ∀ x : C,
        IsClosed ({x} : Set C) ∨ ∃ α : Fin (c + 1), closure ({x} : Set C) = E_set α := by
      intro x
      by_cases hx : IsClosed ({x} : Set C)
      · exact Or.inl hx
      · right
        have hx_univ : x ∈ (Set.univ : Set C) := Set.mem_univ x
        rw [← hE_cov, Set.mem_iUnion] at hx_univ
        obtain ⟨α, hx_α⟩ := hx_univ
