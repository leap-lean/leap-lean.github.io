        have h1 := hh_LQ Q' hQ'_cl
        have h_eq : -(D_Q Q') = -(Δ_div β Q') + 1 := by
          change -((Δ_div β Q' - B_div β Q') + if Q' = Q then 1 else 0) = _
          rw [if_neg hQ'_ne, hQ'_B]; omega
