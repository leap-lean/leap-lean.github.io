      res_comp := fun {U W T} h₁ h₂ x => H_Z.res_comp _ _ x }
  
  have hInter : ∀ (p : ℕ) (α : WeilStrictMonoTuple m p),
      (TopologicalSpace.Opens.map ι_Z.base).obj (weilCoverChartInter V α) =
        weilCoverChartInter V_Z α := by
    intro p α
    suffices ∀ (S₀ : Finset (Fin (p + 1))) (hS₀ : S₀.Nonempty),
        (TopologicalSpace.Opens.map ι_Z.base).obj (S₀.inf' hS₀ (fun k => V (α.1 k))) =
          S₀.inf' hS₀ (fun k => V_Z (α.1 k)) from
      this Finset.univ ⟨0, Finset.mem_univ _⟩
    intro S₀
    induction S₀ using Finset.cons_induction with
    | empty => intro hS₀; exact False.elim (Finset.not_nonempty_empty hS₀)
    | cons k₀ s hk₀ ih =>
      intro _
      rcases s.eq_empty_or_nonempty with rfl | hs
      · have h1 : Finset.cons k₀ ∅ hk₀ = {k₀} := rfl
        simp only [h1, Finset.inf'_singleton]
        rfl
      · rw [Finset.inf'_cons hs, Finset.inf'_cons hs, ← ih hs]
        rfl
  have hPushCechIff : ∀ (H_Z : WeilPresheafModule Z) (H_C : WeilPresheafModule C)
      (e : ∀ U : C.Opens, H_C.sec U ≃+ H_Z.sec ((TopologicalSpace.Opens.map ι_Z.base).obj U)),
      (∀ (U : C.Opens) (a : ↑(C.presheaf.obj (Opposite.op U))) (x : H_C.sec U),
        e U (@SMul.smul _ _ (H_C.instModule U).toSMul a x) = (ι_Z.app U).hom a • e U x) →
