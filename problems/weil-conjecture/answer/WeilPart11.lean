        (a₂ : A) (ha₂ : a₂ ∈ 𝒜₀ (n₂ • d)),
        a₁ * f ^ n₂ = a₂ * f ^ n₁ →
        HomogeneousLocalization.Away.mk 𝒜₀ hf n₁ a₁ ha₁ =
          HomogeneousLocalization.Away.mk 𝒜₀ hf n₂ a₂ ha₂ := by
      intro d f hf n₁ n₂ a₁ ha₁ a₂ ha₂ hpoly
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk]
      refine Localization.mk_eq_mk_iff.mpr (Localization.r_iff_exists.mpr ⟨1, ?_⟩)
      simp only [Submonoid.coe_one, one_mul]
      calc f ^ n₂ * a₁ = a₁ * f ^ n₂ := mul_comm _ _
        _ = a₂ * f ^ n₁ := hpoly
        _ = f ^ n₁ * a₂ := mul_comm _ _
