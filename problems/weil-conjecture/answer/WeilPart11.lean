                          congrArg (fun z : R0_vert.sec U => (e_R0 U z).1 β) (add_zero 0).symm
                      _ = (e_R0 U 0).1 β + (e_R0 U 0).1 β := h0
                  exact (add_left_cancel hcancel).symm
                map_add' := fun x y => he_R0_add U x y β }, fun _ => rfl⟩
    refine @hTransFinCohom
      (fun p => ↥(LinearMap.ker (d_v p 0)))
      (WeilModuleCechCochain V_Z R0_vert)
      _ _ _ _
      dV0 (cechDiffLin g_Z V_Z R0_vert) (fun p => (e_V0 p).symm) ?_
      hFinCohom_dV0
    intro p x
    obtain ⟨s, rfl⟩ := (e_V0 p).surjective x
    rw [LinearEquiv.symm_apply_apply]
    apply (e_V0 (p + 1)).injective
    rw [LinearEquiv.apply_symm_apply]
    apply Subtype.ext
    funext α' β
    obtain ⟨f_αβ, hf_αβ⟩ := h_eR0_addHom (weilCoverChartInter V_Z α') β
    change ∑ i : Fin (p + 2), ((-1 : ℤ) ^ (i : ℕ)) •
        (Z'.presheaf.map (CategoryTheory.homOfLE (hΩ_h α' β i)).op).hom
          ((e_R0 _ (s (face_m α' i))).1 β) =
      (e_R0 _ (∑ i : Fin (p + 2), ((-1 : ℤ) ^ (i : ℕ)) •
        R0_vert.res (hFace_m α' i) (s (face_m α' i)))).1 β
    rw [← hf_αβ, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_zsmul, hf_αβ]
    congr 1
    exact (he_R0_res (hFace_m α' i) (s (face_m α' i)) β).symm
  
  obtain ⟨i₁, q₁, i₂, q₂, hSES_ex, hSES_smul, hSES_res⟩ := hSES_data
  let liftCechMap : ∀ {F₁ F₂ : WeilPresheafModule Z}
      (f : ∀ U : Z.Opens, F₁.sec U →+ F₂.sec U)
      (_ : ∀ (U : Z.Opens) (a : ↑(Z.presheaf.obj (Opposite.op U))) (x : F₁.sec U),
        f U (a • x) = a • f U x)
      (p : ℕ),
      WeilModuleCechCochain V_Z F₁ p →ₗ[R] WeilModuleCechCochain V_Z F₂ p :=
    fun {F₁ F₂} f hf_smul p =>
      { toFun := fun c α => f (weilCoverChartInter V_Z α) (c α)
        map_add' := fun c₁ c₂ => funext fun α => map_add (f _) (c₁ α) (c₂ α)
        map_smul' := fun r₀ c => funext fun α => hf_smul _ _ (c α) }
  have hLiftDiff : ∀ {F₁ F₂ : WeilPresheafModule Z}
      (f : ∀ U : Z.Opens, F₁.sec U →+ F₂.sec U)
      (hf_smul : ∀ (U : Z.Opens) (a : ↑(Z.presheaf.obj (Opposite.op U))) (x : F₁.sec U),
        f U (a • x) = a • f U x)
      (hf_res : ∀ {U W : Z.Opens} (h : W ≤ U) (x : F₁.sec U),
        F₂.res h (f U x) = f W (F₁.res h x))
      (p : ℕ) (c : WeilModuleCechCochain V_Z F₁ p),
      liftCechMap f hf_smul (p + 1) (cechDiffLin g_Z V_Z F₁ p c) =
        cechDiffLin g_Z V_Z F₂ p (liftCechMap f hf_smul p c) := by
    intro F₁ F₂ f hf_smul hf_res p c
    funext β
    change f _ (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • F₁.res _ (c _)) =
      ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • F₂.res _ (f _ (c _))
    rw [map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_zsmul]
    congr 1
    exact (hf_res _ _).symm
  let i₂_C := liftCechMap i₂ (fun U a x => (hSES_smul U a).2.2.1 x)
  let q₂_C := liftCechMap q₂ (fun U a x => (hSES_smul U a).2.2.2 x)
  have hFinCohom_Q1 := (hCechFinIff g_Z V_Z Q_1).mp hFin_Q1
  have hFinCohom_Im :
      Module.Finite R ↥(LinearMap.ker (cechDiffLin g_Z V_Z Im_η 0)) ∧
      ∀ p : ℕ, Module.Finite R
        (↥(LinearMap.ker (cechDiffLin g_Z V_Z Im_η (p + 1))) ⧸
          (LinearMap.range (cechDiffLin g_Z V_Z Im_η p)).comap
            (LinearMap.ker (cechDiffLin g_Z V_Z Im_η (p + 1))).subtype) := by
    apply (hSES_lem
      (WeilModuleCechCochain V_Z Im_η)
      (WeilModuleCechCochain V_Z R0_vert)
      (WeilModuleCechCochain V_Z Q_1)
      (cechDiffLin g_Z V_Z Im_η)
      (cechDiffLin g_Z V_Z R0_vert)
      (cechDiffLin g_Z V_Z Q_1)
      i₂_C q₂_C
      (fun p x => hd2_univ Z m V_Z Im_η p x)
      (fun p x => hd2_univ Z m V_Z R0_vert p x)
      (fun p x => hd2_univ Z m V_Z Q_1 p x)
      (fun p c₁ c₂ hc => funext fun α =>
        (hSES_ex (weilCoverChartInter V_Z α)).2.2.2.1 (congrFun hc α))
      (fun p c => by
        choose b hb using fun α : WeilStrictMonoTuple m p =>
          (hSES_ex (weilCoverChartInter V_Z α)).2.2.2.2.1 (c α)
        exact ⟨b, funext hb⟩)
      (fun p c => by
        constructor
        · intro hc0
          choose a ha using fun α : WeilStrictMonoTuple m p =>
            ((hSES_ex (weilCoverChartInter V_Z α)).2.2.2.2.2 (c α)).mp (congrFun hc0 α)
          exact ⟨a, funext ha⟩
        · rintro ⟨a, rfl⟩
          funext α
          exact ((hSES_ex (weilCoverChartInter V_Z α)).2.2.2.2.2 (i₂_C p a α)).mpr ⟨a α, rfl⟩)
      (fun p c => hLiftDiff i₂ (fun U a x => (hSES_smul U a).2.2.1 x)
        (fun h x => (hSES_res h).2.2.1 x) p c)
      (fun p c => hLiftDiff q₂ (fun U a x => (hSES_smul U a).2.2.2 x)
        (fun h x => (hSES_res h).2.2.2 x) p c)
      hFinCohom_Q1.1 hFinCohom_Q1.2).mpr hFinCohom_R0
  let i₁_C := liftCechMap i₁ (fun U a x => (hSES_smul U a).1 x)
  let q₁_C := liftCechMap q₁ (fun U a x => (hSES_smul U a).2.1 x)
  have hFinCohom_K1 := (hCechFinIff g_Z V_Z K_1).mp hFin_K1
  have hFinCohom_OZ :
      Module.Finite R ↥(LinearMap.ker (cechDiffLin g_Z V_Z O_Z 0)) ∧
      ∀ p : ℕ, Module.Finite R
        (↥(LinearMap.ker (cechDiffLin g_Z V_Z O_Z (p + 1))) ⧸
          (LinearMap.range (cechDiffLin g_Z V_Z O_Z p)).comap
            (LinearMap.ker (cechDiffLin g_Z V_Z O_Z (p + 1))).subtype) := by
    apply (hSES_lem
      (WeilModuleCechCochain V_Z K_1)
      (WeilModuleCechCochain V_Z O_Z)
      (WeilModuleCechCochain V_Z Im_η)
      (cechDiffLin g_Z V_Z K_1)
      (cechDiffLin g_Z V_Z O_Z)
      (cechDiffLin g_Z V_Z Im_η)
      i₁_C q₁_C
      (fun p x => hd2_univ Z m V_Z K_1 p x)
      (fun p x => hd2_univ Z m V_Z O_Z p x)
      (fun p x => hd2_univ Z m V_Z Im_η p x)
      (fun p c₁ c₂ hc => funext fun α =>
        (hSES_ex (weilCoverChartInter V_Z α)).1 (congrFun hc α))
      (fun p c => by
        choose b hb using fun α : WeilStrictMonoTuple m p =>
          (hSES_ex (weilCoverChartInter V_Z α)).2.1 (c α)
        exact ⟨b, funext hb⟩)
      (fun p c => by
        constructor
        · intro hc0
          choose a ha using fun α : WeilStrictMonoTuple m p =>
            ((hSES_ex (weilCoverChartInter V_Z α)).2.2.1 (c α)).mp (congrFun hc0 α)
          exact ⟨a, funext ha⟩
        · rintro ⟨a, rfl⟩
          funext α
          exact ((hSES_ex (weilCoverChartInter V_Z α)).2.2.1 (i₁_C p a α)).mpr ⟨a α, rfl⟩)
      (fun p c => hLiftDiff i₁ (fun U a x => (hSES_smul U a).1 x)
        (fun h x => (hSES_res h).1 x) p c)
      (fun p c => hLiftDiff q₁ (fun U a x => (hSES_smul U a).2.1 x)
        (fun h x => (hSES_res h).2.1 x) p c)
      hFinCohom_Im.1 hFinCohom_Im.2).mp hFinCohom_K1
  have hFin_OZ : HasFiniteWeilModuleCechCohomology g_Z V_Z O_Z :=
    (hCechFinIff g_Z V_Z O_Z).mpr hFinCohom_OZ
  exact ⟨F_Z, hFZ_struct, hFZ_from_OZ O_Z hOZ_iso hFin_OZ⟩

theorem weil_noetherian_coherent_devissage_step (R : Type u) [CommRing R] [IsNoetherianRing R]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hProp : AlgebraicGeometry.IsProper g)
    (m : ℕ)
    (V : Fin m → C.Opens)
    (hAffV : ∀ a : Fin m, AlgebraicGeometry.IsAffineOpen (V a))
    (hCovV : (⋃ a : Fin m, (V a : Set C)) = Set.univ)
    (S : TopologicalSpace.Closeds ↥C)
    (hSmaller : ∀ (S' : TopologicalSpace.Closeds ↥C), S' < S →
      ∀ (H : WeilPresheafModule C),
        IsWeilCoherentSubChartModule V H →
        IsWeilSupportedOn V H S' →
        HasFiniteWeilModuleCechCohomology g V H)
    (hIrredStruct : ((S : Set ↥C).Nonempty ∧ IsIrreducible (S : Set ↥C)) →
      ∃ (F_Z : WeilPresheafModule C),
        IsWeilClosedSubschemeStructureModule
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal S) F_Z ∧
        HasFiniteWeilModuleCechCohomology g V F_Z)
    (F : WeilPresheafModule C)
    (hCohF : IsWeilCoherentSubChartModule V F)
    (hSuppF : IsWeilSupportedOn V F S) :
    HasFiniteWeilModuleCechCohomology g V F :=
by
  have hPart1 :
      (∀ (F : WeilPresheafModule C),
        (∀ (p : ℕ) (α : WeilStrictMonoTuple m p) (x : F.sec (weilCoverChartInter V α)), x = 0) →
        HasFiniteWeilModuleCechCohomology g V F) ∧
      (∀ (P : C.Opens → Prop)
         (_hPV : ∀ {p : ℕ} (α : WeilStrictMonoTuple m p), P (weilCoverChartInter V α))
         (F₁ F₂ F₃ : WeilPresheafModule C)
         (i : ∀ (U : C.Opens), P U → F₁.sec U →+ F₂.sec U)
         (q : ∀ (U : C.Opens), P U → F₂.sec U →+ F₃.sec U),
        (∀ (U : C.Opens) (hU : P U) (a : ↑(C.presheaf.obj (Opposite.op U))) (x : F₁.sec U),
          i U hU (a • x) = a • i U hU x) →
        (∀ (U : C.Opens) (hU : P U) (a : ↑(C.presheaf.obj (Opposite.op U))) (x : F₂.sec U),
          q U hU (a • x) = a • q U hU x) →
        (∀ {U W : C.Opens} (hU : P U) (hW : P W) (h : W ≤ U) (x : F₁.sec U),
          i W hW (F₁.res h x) = F₂.res h (i U hU x)) →
        (∀ {U W : C.Opens} (hU : P U) (hW : P W) (h : W ≤ U) (x : F₂.sec U),
          q W hW (F₂.res h x) = F₃.res h (q U hU x)) →
        (∀ (U : C.Opens) (hU : P U), Function.Injective (i U hU)) →
        (∀ (U : C.Opens) (hU : P U), Function.Surjective (q U hU)) →
        (∀ (U : C.Opens) (hU : P U) (x : F₂.sec U),
          q U hU x = 0 ↔ ∃ y : F₁.sec U, i U hU y = x) →
        (HasFiniteWeilModuleCechCohomology g V F₁ →
          HasFiniteWeilModuleCechCohomology g V F₃ →
          HasFiniteWeilModuleCechCohomology g V F₂) ∧
        (HasFiniteWeilModuleCechCohomology g V F₂ →
          HasFiniteWeilModuleCechCohomology g V F₃ →
          HasFiniteWeilModuleCechCohomology g V F₁)) := by
    clear hProp hAffV hCovV S hSmaller hIrredStruct F hCohF hSuppF
    refine ⟨?_, ?_⟩
    · intro F hZeroSec
      refine ⟨⟨0, Fin.elim0, fun j => Fin.elim0 j, fun z _ => ⟨Fin.elim0, ?_⟩⟩, fun p =>
        ⟨0, Fin.elim0, fun j => Fin.elim0 j, fun z _ => ⟨Fin.elim0, 0, ?_⟩⟩⟩
      · simp only [Finset.univ_eq_empty, Finset.sum_empty]
        funext α
        exact hZeroSec 0 α (z α)
      · simp only [Finset.univ_eq_empty, Finset.sum_empty, zero_add]
        funext α
        exact (hZeroSec (p + 1) α (z α)).trans (hZeroSec (p + 1) α _).symm
    · intro P hPV F₁ F₂ F₃ i q hi_smul hq_smul hi_res hq_res hi_inj hq_surj h_ex
      let φ_R : ∀ U : C.Opens, R →+* ↑(C.presheaf.obj (Opposite.op U)) :=
        fun U =>
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
            g.appLE ⊤ U le_top).hom
      have hφ_res : ∀ {U W : C.Opens} (h : W ≤ U) (r : R),
          (C.presheaf.map (CategoryTheory.homOfLE h).op).hom (φ_R U r) = φ_R W r := by
        intro U W h r
        have hcomp : g.appLE ⊤ U le_top ≫ C.presheaf.map (CategoryTheory.homOfLE h).op =
            g.appLE ⊤ W le_top := g.appLE_map le_top (CategoryTheory.homOfLE h).op
        change (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
          g.appLE ⊤ U le_top) ≫ C.presheaf.map (CategoryTheory.homOfLE h).op).hom r = _
        rw [CategoryTheory.Category.assoc, hcomp]
      have hResSmul : ∀ (F : WeilPresheafModule C) {U W : C.Opens} (h : W ≤ U)
          (a : ↑(C.presheaf.obj (Opposite.op U))) (x : F.sec U),
          F.res h (a • x) = ((C.presheaf.map (CategoryTheory.homOfLE h).op).hom a) • F.res h x :=
        fun F _ _ h a x => F.res_smul h a x
      let instModSec : ∀ (F : WeilPresheafModule C) (U : C.Opens), Module R (F.sec U) :=
        fun F U => Module.compHom (F.sec U) (φ_R U)
      let instModCochain : ∀ (F : WeilPresheafModule C) (p : ℕ),
          Module R (WeilModuleCechCochain V F p) :=
        fun F p => @Pi.module (WeilStrictMonoTuple m p)
          (fun α => F.sec (weilCoverChartInter V α)) R _
          (fun α => inferInstance) (fun α => instModSec F (weilCoverChartInter V α))
      let _ : ∀ (F : WeilPresheafModule C) (p : ℕ), Module R (WeilModuleCechCochain V F p) :=
        instModCochain
      let d_lin : ∀ (F : WeilPresheafModule C) (p : ℕ),
          WeilModuleCechCochain V F p →ₗ[R] WeilModuleCechCochain V F (p + 1) :=
        fun F p =>
          { toFun := weilModuleCechDiff V F p
            map_add' := fun c₁ c₂ => by
              funext β
              dsimp only [weilModuleCechDiff]
              change ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • F.res _ (c₁ _ + c₂ _) =
                (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • F.res _ (c₁ _)) +
                (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • F.res _ (c₂ _))
              rw [← Finset.sum_add_distrib]
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [map_add, smul_add]
            map_smul' := fun r c => by
              funext β
              dsimp only [RingHom.id_apply, weilModuleCechDiff]
              let face : Fin (p + 2) → WeilStrictMonoTuple m p :=
                fun j => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
              let hFace : ∀ j : Fin (p + 2),
                  weilCoverChartInter V β ≤ weilCoverChartInter V (face j) :=
                fun j => Finset.le_inf' _ _
                  (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
              change ∑ j : Fin (p + 2),
                  ((-1 : ℤ) ^ (j : ℕ)) •
                    F.res (hFace j) (φ_R (weilCoverChartInter V (face j)) r • c (face j)) =
                φ_R (weilCoverChartInter V β) r •
                  ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • F.res (hFace j) (c (face j))
              rw [Finset.smul_sum]
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [hResSmul, hφ_res]
              exact smul_comm _ _ _ }
      have hd2 : ∀ (F : WeilPresheafModule C) (p : ℕ) (c : WeilModuleCechCochain V F p),
          d_lin F (p + 1) (d_lin F p c) = 0 := by
        intro F p c
        funext γ
        let face1 : Fin (p + 3) → WeilStrictMonoTuple m (p + 1) :=
          fun a => ⟨fun k => γ.1 (a.succAbove k), γ.2.comp (Fin.strictMono_succAbove a)⟩
        let hFace1 : ∀ a : Fin (p + 3), weilCoverChartInter V γ ≤ weilCoverChartInter V (face1 a) :=
          fun a => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (a.succAbove k)))
        let face0 : ∀ (a : Fin (p + 3)), Fin (p + 2) → WeilStrictMonoTuple m p :=
          fun a b => ⟨fun k => (face1 a).1 (b.succAbove k),
            (face1 a).2.comp (Fin.strictMono_succAbove b)⟩
        let hFace0 : ∀ (a : Fin (p + 3)) (b : Fin (p + 2)),
            weilCoverChartInter V (face1 a) ≤ weilCoverChartInter V (face0 a b) :=
          fun a b => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (b.succAbove k)))
        change ∑ a : Fin (p + 3), ((-1 : ℤ) ^ (a : ℕ)) • F.res (hFace1 a)
            (∑ b : Fin (p + 2), ((-1 : ℤ) ^ (b : ℕ)) • F.res (hFace0 a b) (c (face0 a b))) = 0
        have hExpand :
            (∑ a : Fin (p + 3), ((-1 : ℤ) ^ (a : ℕ)) • F.res (hFace1 a)
              (∑ b : Fin (p + 2), ((-1 : ℤ) ^ (b : ℕ)) • F.res (hFace0 a b) (c (face0 a b)))) =
            ∑ x : Fin (p + 3) × Fin (p + 2),
              ((-1 : ℤ) ^ (x.1 : ℕ) * (-1 : ℤ) ^ (x.2 : ℕ)) •
                F.res (le_trans (hFace1 x.1) (hFace0 x.1 x.2)) (c (face0 x.1 x.2)) := by
          rw [Fintype.sum_prod_type]
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [map_sum, Finset.smul_sum]
          refine Finset.sum_congr rfl fun b _ => ?_
          rw [map_zsmul, F.res_comp, smul_smul]
        rw [hExpand]
        let term : Fin (p + 3) × Fin (p + 2) → F.sec (weilCoverChartInter V γ) :=
          fun x => ((-1 : ℤ) ^ (x.1 : ℕ) * (-1 : ℤ) ^ (x.2 : ℕ)) •
            F.res (le_trans (hFace1 x.1) (hFace0 x.1 x.2)) (c (face0 x.1 x.2))
        let σ : Fin (p + 3) × Fin (p + 2) → Fin (p + 3) × Fin (p + 2) :=
          fun x =>
            if h : (x.1 : ℕ) ≤ (x.2 : ℕ) then
              (⟨(x.2 : ℕ) + 1, by omega⟩, ⟨(x.1 : ℕ), by omega⟩)
            else
              (⟨(x.2 : ℕ), by omega⟩, ⟨(x.1 : ℕ) - 1, by omega⟩)
        have hσ_inv : ∀ x, σ (σ x) = x := by
          rintro ⟨⟨a, ha⟩, ⟨b, hb⟩⟩
          simp only [σ, Prod.ext_iff, Fin.ext_iff]
          by_cases hab : a ≤ b
          · rw [dite_cond_eq_true (eq_true hab)]
            have hnot : ¬(b + 1 ≤ a) := by omega
            rw [dite_cond_eq_false (eq_false hnot)]
            dsimp only
            omega
          · rw [dite_cond_eq_false (eq_false hab)]
            have hle : b ≤ a - 1 := by omega
            rw [dite_cond_eq_true (eq_true hle)]
            dsimp only
            omega
        have hσ_ne : ∀ x, σ x ≠ x := by
          rintro ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ hEq
          simp only [σ, Prod.ext_iff, Fin.ext_iff] at hEq
          by_cases hab : a ≤ b
          · rw [dite_cond_eq_true (eq_true hab)] at hEq
            dsimp only at hEq
            omega
          · rw [dite_cond_eq_false (eq_false hab)] at hEq
            dsimp only at hEq
            omega
        have hResCongr : ∀ (τ₁ τ₂ : WeilStrictMonoTuple m p) (hτ : τ₁ = τ₂)
            (h₁ : weilCoverChartInter V γ ≤ weilCoverChartInter V τ₁)
            (h₂ : weilCoverChartInter V γ ≤ weilCoverChartInter V τ₂),
            F.res h₁ (c τ₁) = F.res h₂ (c τ₂) := by
          intro τ₁ τ₂ hτ h₁ h₂
          subst hτ
          rfl
        have hCancelCase : ∀ (a : Fin (p + 3)) (b : Fin (p + 2)) (hab : (a : ℕ) ≤ (b : ℕ)),
            term (a, b) +
              term (⟨(b : ℕ) + 1, Nat.add_lt_add_right b.2 1⟩,
                ⟨(a : ℕ), Nat.lt_of_le_of_lt hab b.2⟩) = 0 := by
          intro a b hab
          let a' : Fin (p + 3) := ⟨(b : ℕ) + 1, Nat.add_lt_add_right b.2 1⟩
          let b' : Fin (p + 2) := ⟨(a : ℕ), Nat.lt_of_le_of_lt hab b.2⟩
          have hTuple : face0 a b = face0 a' b' := by
            apply Subtype.ext
            funext k
            change γ.1 (a.succAbove (b.succAbove k)) = γ.1 (a'.succAbove (b'.succAbove k))
            congr 1
            ext
            simp only [a', b', Fin.succAbove, Fin.lt_def, Fin.val_castSucc]
            split_ifs <;> simp_all <;> omega
          dsimp only [term]
          rw [hResCongr (face0 a b) (face0 a' b') hTuple
            (le_trans (hFace1 a) (hFace0 a b)) (le_trans (hFace1 a') (hFace0 a' b')),
            ← add_smul]
          have hSign : (-1 : ℤ) ^ (a : ℕ) * (-1 : ℤ) ^ (b : ℕ) +
              (-1 : ℤ) ^ (a' : ℕ) * (-1 : ℤ) ^ (b' : ℕ) = 0 := by
            change (-1 : ℤ) ^ (a : ℕ) * (-1 : ℤ) ^ (b : ℕ) +
              (-1 : ℤ) ^ ((b : ℕ) + 1) * (-1 : ℤ) ^ (a : ℕ) = 0
            rw [pow_succ]
            ring
          rw [hSign, zero_smul]
        have hTermCongr : ∀ {x₁ x₂ : Fin (p + 3) × Fin (p + 2)}, x₁ = x₂ → term x₁ = term x₂ := by
          rintro _ _ rfl; rfl
        refine Finset.sum_ninvolution σ ?_ (fun x _ => hσ_ne x) (fun _ => Finset.mem_univ _) hσ_inv
        intro ⟨a, b⟩
        change term (a, b) + term (σ (a, b)) = 0
        by_cases hab : (a : ℕ) ≤ (b : ℕ)
        · have hσ_eq : σ (a, b) =
              (⟨(b : ℕ) + 1, Nat.add_lt_add_right b.2 1⟩,
                ⟨(a : ℕ), Nat.lt_of_le_of_lt hab b.2⟩) := by
            dsimp only [σ]
            rw [dite_cond_eq_true (eq_true hab)]
          rw [hTermCongr hσ_eq]
          exact hCancelCase a b hab
        · let y := σ (a, b)
          have hy_le : (y.1 : ℕ) ≤ (y.2 : ℕ) := by
            dsimp only [y, σ]
            rw [dite_cond_eq_false (eq_false hab)]
            dsimp only
            omega
          have hσy : σ y =
              (⟨(y.2 : ℕ) + 1, Nat.add_lt_add_right y.2.2 1⟩,
                ⟨(y.1 : ℕ), Nat.lt_of_le_of_lt hy_le y.2.2⟩) := by
            dsimp only [σ]
            rw [dite_cond_eq_true (eq_true hy_le)]
          have h_back :
              (⟨(y.2 : ℕ) + 1, Nat.add_lt_add_right y.2.2 1⟩,
                ⟨(y.1 : ℕ), Nat.lt_of_le_of_lt hy_le y.2.2⟩) = (a, b) :=
            hσy.symm.trans (hσ_inv (a, b))
          calc term (a, b) + term (σ (a, b))
              = term y + term (a, b) := add_comm _ _
            _ = term y + term (⟨(y.2 : ℕ) + 1, Nat.add_lt_add_right y.2.2 1⟩,
                  ⟨(y.1 : ℕ), Nat.lt_of_le_of_lt hy_le y.2.2⟩) := by
                rw [hTermCongr h_back]
            _ = 0 := hCancelCase y.1 y.2 hy_le
      let B_sub : ∀ (F : WeilPresheafModule C) (n : ℕ),
          Submodule R ↥(LinearMap.ker (d_lin F n)) :=
        fun F n => match n with
          | 0 => ⊥
          | p + 1 => (LinearMap.range (d_lin F p)).comap (LinearMap.ker (d_lin F (p + 1))).subtype
      let H_mod : ∀ (F : WeilPresheafModule C) (n : ℕ), Type u :=
        fun F n => ↥(LinearMap.ker (d_lin F n)) ⧸ B_sub F n
      have hFinIff : ∀ (F : WeilPresheafModule C),
          HasFiniteWeilModuleCechCohomology g V F ↔ ∀ n : ℕ, Module.Finite R (H_mod F n) := by
        intro F
        constructor
        · rintro ⟨⟨k₀, gen₀, hgen₀_ker, hgen₀_span⟩, hSucc⟩ n
          cases n with
          | zero =>
            let gen₀_ker : Fin k₀ → ↥(LinearMap.ker (d_lin F 0)) := fun j =>
              ⟨gen₀ j, hgen₀_ker j⟩
            let gen₀_sub : Fin k₀ → H_mod F 0 := fun j =>
              Submodule.mkQ (B_sub F 0) (gen₀_ker j)
            let φ₀ : (Fin k₀ → R) →ₗ[R] H_mod F 0 :=
              Fintype.linearCombination R gen₀_sub
            apply Module.Finite.of_surjective φ₀
            intro q_el
            obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (B_sub F 0) q_el
            obtain ⟨c, hc⟩ := hgen₀_span z.1 z.2
            refine ⟨c, ?_⟩
            change (∑ j : Fin k₀, c j • Submodule.mkQ (B_sub F 0) (gen₀_ker j)) =
              Submodule.mkQ (B_sub F 0) z
            have hsum : (∑ j : Fin k₀, c j • Submodule.mkQ (B_sub F 0) (gen₀_ker j)) =
                Submodule.mkQ (B_sub F 0) (∑ j : Fin k₀, c j • gen₀_ker j) := by
              rw [map_sum]
              exact Finset.sum_congr rfl fun j _ => (LinearMap.map_smul _ _ _).symm
            rw [hsum]
            congr 1
            apply Subtype.ext
            rw [AddSubmonoidClass.coe_finsetSum]
            exact hc.symm
          | succ p =>
            obtain ⟨k, gen, hgen_ker, hgen_span⟩ := hSucc p
            let gen_ker : Fin k → ↥(LinearMap.ker (d_lin F (p + 1))) := fun j =>
              ⟨gen j, hgen_ker j⟩
            let gen_sub : Fin k → H_mod F (p + 1) := fun j =>
              Submodule.mkQ (B_sub F (p + 1)) (gen_ker j)
            let φ_p : (Fin k → R) →ₗ[R] H_mod F (p + 1) :=
              Fintype.linearCombination R gen_sub
            apply Module.Finite.of_surjective φ_p
            intro q_el
            obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (B_sub F (p + 1)) q_el
            obtain ⟨c, b, hzb⟩ := hgen_span z.1 z.2
            refine ⟨c, ?_⟩
            change (∑ j : Fin k, c j • Submodule.mkQ (B_sub F (p + 1)) (gen_ker j)) =
              Submodule.Quotient.mk z
            have hsum : (∑ j : Fin k, c j • Submodule.mkQ (B_sub F (p + 1)) (gen_ker j)) =
                Submodule.Quotient.mk (∑ j : Fin k, c j • gen_ker j) := by
              change _ = Submodule.mkQ (B_sub F (p + 1)) (∑ j : Fin k, c j • gen_ker j)
              rw [map_sum]
              exact Finset.sum_congr rfl fun j _ => (LinearMap.map_smul _ _ _).symm
            rw [hsum, Submodule.Quotient.eq]
            change (∑ j : Fin k, c j • gen_ker j).1 - z.1 ∈ LinearMap.range (d_lin F p)
            rw [AddSubmonoidClass.coe_finsetSum]
            refine ⟨-b, ?_⟩
            rw [map_neg]
            change -(weilModuleCechDiff V F p b) =
              (∑ j : Fin k, weilModuleCechSmul g V F (p + 1) (c j) (gen j)) - z.1
            rw [hzb]
            abel
        · intro hFin
          refine ⟨?_, fun p => ?_⟩
          · obtain ⟨k₀, φ₀, hφ₀⟩ := Module.Finite.exists_fin' R (H_mod F 0)
            choose lift₀ hlift₀ using fun j : Fin k₀ =>
              Submodule.mkQ_surjective (B_sub F 0) (φ₀ (Pi.single j 1))
            refine ⟨k₀, fun j => (lift₀ j).1, fun j => (lift₀ j).2, fun z hz => ?_⟩
            obtain ⟨c, hc⟩ := hφ₀ (Submodule.mkQ (B_sub F 0) ⟨z, hz⟩)
            refine ⟨c, ?_⟩
            have hc_eq : φ₀ c = ∑ j : Fin k₀, c j • φ₀ (Pi.single j 1) := by
              conv_lhs => rw [← Finset.univ_sum_single c, map_sum]
              refine Finset.sum_congr rfl fun j _ => ?_
              have hsingle : Pi.single j (c j) = c j • (Pi.single j (1 : R) : Fin k₀ → R) := by
                ext k; simp [Pi.single_apply]
              rw [hsingle, LinearMap.map_smul]
            rw [hc_eq] at hc
            have hc_mk : Submodule.Quotient.mk (p := B_sub F 0) (∑ j : Fin k₀, c j • lift₀ j) =
                Submodule.Quotient.mk (p := B_sub F 0) ⟨z, hz⟩ := by
              change Submodule.mkQ (B_sub F 0) (∑ j : Fin k₀, c j • lift₀ j) =
                Submodule.mkQ (B_sub F 0) ⟨z, hz⟩
              rw [map_sum, ← hc]
              exact Finset.sum_congr rfl fun j _ => by
                rw [LinearMap.map_smul, hlift₀ j]
            rw [Submodule.Quotient.eq] at hc_mk
            have hbot : (∑ j : Fin k₀, c j • lift₀ j) - ⟨z, hz⟩ = 0 :=
              (Submodule.mem_bot R).mp hc_mk
            have hval := congrArg Subtype.val (sub_eq_zero.mp hbot)
            rw [AddSubmonoidClass.coe_finsetSum] at hval
            exact hval.symm
          · obtain ⟨k, φ_p, hφ_p⟩ := Module.Finite.exists_fin' R (H_mod F (p + 1))
            choose lift_p hlift_p using fun j : Fin k =>
              Submodule.mkQ_surjective (B_sub F (p + 1)) (φ_p (Pi.single j 1))
            refine ⟨k, fun j => (lift_p j).1, fun j => (lift_p j).2, fun z hz => ?_⟩
            obtain ⟨c, hc⟩ := hφ_p (Submodule.mkQ (B_sub F (p + 1)) ⟨z, hz⟩)
            have hc_eq : φ_p c = ∑ j : Fin k, c j • φ_p (Pi.single j 1) := by
              conv_lhs => rw [← Finset.univ_sum_single c, map_sum]
              refine Finset.sum_congr rfl fun j _ => ?_
              have hsingle : Pi.single j (c j) = c j • (Pi.single j (1 : R) : Fin k → R) := by
                ext k'; simp [Pi.single_apply]
              rw [hsingle, LinearMap.map_smul]
            rw [hc_eq] at hc
            have hc_mk : Submodule.Quotient.mk (p := B_sub F (p + 1)) (∑ j : Fin k, c j • lift_p j) =
                Submodule.Quotient.mk (p := B_sub F (p + 1)) ⟨z, hz⟩ := by
              change Submodule.mkQ (B_sub F (p + 1)) (∑ j : Fin k, c j • lift_p j) =
                Submodule.mkQ (B_sub F (p + 1)) ⟨z, hz⟩
              rw [map_sum, ← hc]
              exact Finset.sum_congr rfl fun j _ => by
                rw [LinearMap.map_smul, hlift_p j]
            rw [Submodule.Quotient.eq] at hc_mk
            obtain ⟨b, hb⟩ := hc_mk
            refine ⟨c, -b, ?_⟩
            have hb' : d_lin F p b = (∑ j : Fin k, c j • lift_p j).1 - z := hb
            rw [AddSubmonoidClass.coe_finsetSum] at hb'
            simp only [SetLike.val_smul] at hb'
            change z = (∑ j : Fin k, c j • (lift_p j).1) + d_lin F p (-b)
            rw [map_neg, hb']
            abel
      let i_c : ∀ n : ℕ, WeilModuleCechCochain V F₁ n →ₗ[R] WeilModuleCechCochain V F₂ n :=
        fun n =>
          { toFun := fun c α => i (weilCoverChartInter V α) (hPV α) (c α)
            map_add' := fun c₁ c₂ => funext fun α => map_add _ _ _
            map_smul' := fun r c => funext fun α => hi_smul _ (hPV α) _ _ }
      let q_c : ∀ n : ℕ, WeilModuleCechCochain V F₂ n →ₗ[R] WeilModuleCechCochain V F₃ n :=
        fun n =>
          { toFun := fun c α => q (weilCoverChartInter V α) (hPV α) (c α)
            map_add' := fun c₁ c₂ => funext fun α => map_add _ _ _
            map_smul' := fun r c => funext fun α => hq_smul _ (hPV α) _ _ }
      have hi_c_inj : ∀ n : ℕ, Function.Injective (i_c n) := by
        intro n c₁ c₂ hEq
        funext α
        exact hi_inj _ (hPV α) (congrFun hEq α)
      have hq_c_surj : ∀ n : ℕ, Function.Surjective (q_c n) := by
        intro n c₃
        refine ⟨fun α => Classical.choose (hq_surj _ (hPV α) (c₃ α)), funext fun α => ?_⟩
        exact Classical.choose_spec (hq_surj _ (hPV α) (c₃ α))
      have h_c_ex : ∀ (n : ℕ) (x : WeilModuleCechCochain V F₂ n),
          q_c n x = 0 ↔ ∃ y : WeilModuleCechCochain V F₁ n, i_c n y = x := by
        intro n x
        constructor
        · intro hx
          have hx_α : ∀ α, ∃ y, i _ (hPV α) y = x α :=
            fun α => (h_ex _ (hPV α) (x α)).mp (congrFun hx α)
          exact ⟨fun α => Classical.choose (hx_α α),
            funext fun α => Classical.choose_spec (hx_α α)⟩
        · rintro ⟨y, rfl⟩
          funext α
          exact (h_ex _ (hPV α) _).mpr ⟨y α, rfl⟩
      have hi_comm : ∀ (n : ℕ) (c : WeilModuleCechCochain V F₁ n),
          d_lin F₂ n (i_c n c) = i_c (n + 1) (d_lin F₁ n c) := by
        intro n c
        funext β
        let face : Fin (n + 2) → WeilStrictMonoTuple m n :=
          fun j => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
        let hFace : ∀ j : Fin (n + 2),
            weilCoverChartInter V β ≤ weilCoverChartInter V (face j) :=
          fun j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
        change (∑ j : Fin (n + 2),
            ((-1 : ℤ) ^ (j : ℕ)) • F₂.res (hFace j) (i _ (hPV (face j)) (c (face j)))) =
          i _ (hPV β) (∑ j : Fin (n + 2), ((-1 : ℤ) ^ (j : ℕ)) • F₁.res (hFace j) (c (face j)))
        rw [map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_zsmul, hi_res (hPV (face j)) (hPV β) (hFace j)]
      have hq_comm : ∀ (n : ℕ) (c : WeilModuleCechCochain V F₂ n),
          d_lin F₃ n (q_c n c) = q_c (n + 1) (d_lin F₂ n c) := by
        intro n c
        funext β
        let face : Fin (n + 2) → WeilStrictMonoTuple m n :=
          fun j => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
        let hFace : ∀ j : Fin (n + 2),
            weilCoverChartInter V β ≤ weilCoverChartInter V (face j) :=
          fun j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
        change (∑ j : Fin (n + 2),
            ((-1 : ℤ) ^ (j : ℕ)) • F₃.res (hFace j) (q _ (hPV (face j)) (c (face j)))) =
          q _ (hPV β) (∑ j : Fin (n + 2), ((-1 : ℤ) ^ (j : ℕ)) • F₂.res (hFace j) (c (face j)))
        rw [map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_zsmul, hq_res (hPV (face j)) (hPV β) (hFace j)]
      let i_ker : ∀ n : ℕ, ↥(LinearMap.ker (d_lin F₁ n)) →ₗ[R] ↥(LinearMap.ker (d_lin F₂ n)) :=
        fun n =>
          { toFun := fun z => ⟨i_c n z.1, by
              change d_lin F₂ n (i_c n z.1) = 0
              rw [hi_comm, show d_lin F₁ n z.1 = 0 from z.2, map_zero]⟩
            map_add' := fun z₁ z₂ => Subtype.ext (map_add (i_c n) z₁.1 z₂.1)
            map_smul' := fun r z => Subtype.ext (map_smul (i_c n) r z.1) }
      let q_ker : ∀ n : ℕ, ↥(LinearMap.ker (d_lin F₂ n)) →ₗ[R] ↥(LinearMap.ker (d_lin F₃ n)) :=
        fun n =>
          { toFun := fun z => ⟨q_c n z.1, by
              change d_lin F₃ n (q_c n z.1) = 0
              rw [hq_comm, show d_lin F₂ n z.1 = 0 from z.2, map_zero]⟩
            map_add' := fun z₁ z₂ => Subtype.ext (map_add (q_c n) z₁.1 z₂.1)
            map_smul' := fun r z => Subtype.ext (map_smul (q_c n) r z.1) }
      let i_H : ∀ n : ℕ, H_mod F₁ n →ₗ[R] H_mod F₂ n :=
        fun n => Submodule.mapQ (B_sub F₁ n) (B_sub F₂ n) (i_ker n) (by
          intro z hz
          cases n with
          | zero =>
            rw [Submodule.mem_bot] at hz
            rw [hz]
            exact Submodule.zero_mem _
          | succ p =>
            obtain ⟨b₁, hb₁⟩ := hz
            exact ⟨i_c p b₁, (hi_comm p b₁).trans (congrArg (i_c (p + 1)) hb₁)⟩)
      let q_H : ∀ n : ℕ, H_mod F₂ n →ₗ[R] H_mod F₃ n :=
        fun n => Submodule.mapQ (B_sub F₂ n) (B_sub F₃ n) (q_ker n) (by
          intro z hz
          cases n with
          | zero =>
            rw [Submodule.mem_bot] at hz
            rw [hz]
            exact Submodule.zero_mem _
          | succ p =>
            obtain ⟨b₂, hb₂⟩ := hz
            exact ⟨q_c p b₂, (hq_comm p b₂).trans (congrArg (q_c (p + 1)) hb₂)⟩)
      have hSnakeEx : ∀ (n : ℕ) (z₃ : ↥(LinearMap.ker (d_lin F₃ n))),
          ∃ (x₂ : WeilModuleCechCochain V F₂ n) (y₁ : ↥(LinearMap.ker (d_lin F₁ (n + 1)))),
            q_c n x₂ = z₃.1 ∧ i_c (n + 1) y₁.1 = d_lin F₂ n x₂ := by
        intro n z₃
        obtain ⟨x₂, hx₂⟩ := hq_c_surj n z₃.1
        have hqd : q_c (n + 1) (d_lin F₂ n x₂) = 0 := by
          rw [← hq_comm, hx₂, show d_lin F₃ n z₃.1 = 0 from z₃.2]
        obtain ⟨y₁, hy₁⟩ := (h_c_ex (n + 1) (d_lin F₂ n x₂)).mp hqd
        have hy₁_ker : d_lin F₁ (n + 1) y₁ = 0 := by
          apply hi_c_inj (n + 2)
          rw [← hi_comm, hy₁, hd2, map_zero]
        exact ⟨x₂, ⟨y₁, hy₁_ker⟩, hx₂, hy₁⟩
      let δ_fn : ∀ n : ℕ, ↥(LinearMap.ker (d_lin F₃ n)) → H_mod F₁ (n + 1) :=
        fun n z₃ => Submodule.Quotient.mk (Classical.choose (Classical.choose_spec (hSnakeEx n z₃)))
      have hδ_rel : ∀ (n : ℕ) (z₃ : ↥(LinearMap.ker (d_lin F₃ n)))
          (x₂ : WeilModuleCechCochain V F₂ n) (y₁ : ↥(LinearMap.ker (d_lin F₁ (n + 1)))),
          q_c n x₂ = z₃.1 → i_c (n + 1) y₁.1 = d_lin F₂ n x₂ →
          δ_fn n z₃ = Submodule.Quotient.mk y₁ := by
        intro n z₃ x₂ y₁ hx₂ hy₁
        let x₂_0 := Classical.choose (hSnakeEx n z₃)
        let y₁_0 := Classical.choose (Classical.choose_spec (hSnakeEx n z₃))
        obtain ⟨hx₂_0, hy₁_0⟩ := Classical.choose_spec (Classical.choose_spec (hSnakeEx n z₃))
        change Submodule.Quotient.mk y₁_0 = Submodule.Quotient.mk y₁
        rw [Submodule.Quotient.eq]
        have hq_diff : q_c n (x₂_0 - x₂) = 0 := by rw [map_sub, hx₂_0, hx₂, sub_self]
        obtain ⟨w₁, hw₁⟩ := (h_c_ex n (x₂_0 - x₂)).mp hq_diff
        refine ⟨w₁, hi_c_inj (n + 1) ?_⟩
        calc i_c (n + 1) (d_lin F₁ n w₁)
            = d_lin F₂ n (i_c n w₁) := (hi_comm n w₁).symm
          _ = d_lin F₂ n (x₂_0 - x₂) := by rw [hw₁]
          _ = i_c (n + 1) (y₁_0.1 - y₁.1) := by rw [map_sub, ← hy₁_0, ← hy₁, map_sub]
      let δ_raw : ∀ n : ℕ, ↥(LinearMap.ker (d_lin F₃ n)) →ₗ[R] H_mod F₁ (n + 1) :=
        fun n =>
          { toFun := δ_fn n
            map_add' := fun z₃ z₃' => by
              obtain ⟨x₂, y₁, hx₂, hy₁⟩ := hSnakeEx n z₃
              obtain ⟨x₂', y₁', hx₂', hy₁'⟩ := hSnakeEx n z₃'
              rw [hδ_rel n z₃ x₂ y₁ hx₂ hy₁,
                hδ_rel n z₃' x₂' y₁' hx₂' hy₁',
                hδ_rel n (z₃ + z₃') (x₂ + x₂') (y₁ + y₁')
                  (by rw [map_add, hx₂, hx₂']; rfl)
                  (by rw [Submodule.coe_add, map_add, hy₁, hy₁', map_add])]
              rfl
            map_smul' := fun r z₃ => by
              obtain ⟨x₂, y₁, hx₂, hy₁⟩ := hSnakeEx n z₃
              rw [hδ_rel n z₃ x₂ y₁ hx₂ hy₁,
                hδ_rel n (r • z₃) (r • x₂) (r • y₁)
                  (by rw [map_smul, hx₂]; rfl)
                  (by rw [SetLike.val_smul, map_smul, hy₁, map_smul])]
              rfl }
      let δ_H : ∀ n : ℕ, H_mod F₃ n →ₗ[R] H_mod F₁ (n + 1) :=
        fun n => Submodule.liftQ (B_sub F₃ n) (δ_raw n) (by
          intro z₃ hz₃
          cases n with
          | zero =>
            rw [Submodule.mem_bot] at hz₃
            rw [hz₃]
            exact (LinearMap.ker (δ_raw 0)).zero_mem
          | succ p =>
            obtain ⟨b₃, hb₃⟩ := hz₃
            obtain ⟨b₂, hb₂⟩ := hq_c_surj p b₃
            have hb₃' : d_lin F₃ p b₃ = z₃.1 := hb₃
            exact hδ_rel (p + 1) z₃ (d_lin F₂ p b₂) 0
