        have hc1 : w 0 1 * ∑ s : Fin (r + 1), (-1) ^ ((s : ℕ) + 1) * T 0 s.succ +
            ∑ s : Fin (r + 1), (-1) ^ ((s : ℕ) + 2) * (w 0 1 * T 0 s.succ) = 0 := by
