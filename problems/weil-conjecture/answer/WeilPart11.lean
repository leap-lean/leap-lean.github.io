                    (∀ i j : Fin (r₁ + 1), ψ ((M'⁻¹).val i j) = (M⁻¹).val i j)) :=
by
  
  have res_res : ∀ (X : AlgebraicGeometry.Scheme.{u}) {U₁ U₂ U₃ : X.Opens}
      (h₁₂ : U₁ ≤ U₂) (h₂₃ : U₂ ≤ U₃) (h₁₃ : U₁ ≤ U₃)
      (x : ↑(X.presheaf.obj (Opposite.op U₃))),
      (X.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom
        ((X.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom x) =
        (X.presheaf.map (CategoryTheory.homOfLE h₁₃).op).hom x := by
    intro X U₁ U₂ U₃ h₁₂ h₂₃ h₁₃ x
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← X.presheaf.map_comp,
      ← op_comp, CategoryTheory.homOfLE_comp]
  have res_app_res : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
      {V₁ V₂ : Y.Opens} (hV : V₁ ≤ V₂) {U : X.Opens}
      (hU₁ : U ≤ (TopologicalSpace.Opens.map f.base).obj V₁)
      (hU₂ : U ≤ (TopologicalSpace.Opens.map f.base).obj V₂)
      (y : ↑(Y.presheaf.obj (Opposite.op V₂))),
      (X.presheaf.map (CategoryTheory.homOfLE hU₁).op).hom
        ((f.app V₁).hom ((Y.presheaf.map (CategoryTheory.homOfLE hV).op).hom y)) =
        (X.presheaf.map (CategoryTheory.homOfLE hU₂).op).hom ((f.app V₂).hom y) := by
    intro X Y f V₁ V₂ hV U hU₁ hU₂ y
    have hnat := CategoryTheory.ConcreteCategory.congr_hom
      (AlgebraicGeometry.Scheme.Hom.naturality f (CategoryTheory.homOfLE hV).op) y
    change (f.app V₁).hom ((Y.presheaf.map (CategoryTheory.homOfLE hV).op).hom y) =
      (X.presheaf.map (CategoryTheory.homOfLE ((TopologicalSpace.Opens.map f.base).monotone hV)).op).hom
        ((f.app V₂).hom y) at hnat
    rw [hnat, res_res]
  have res_comp_app : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
      {V : Z.Opens} {U : X.Opens}
      (hU : U ≤ (TopologicalSpace.Opens.map (f ≫ g).base).obj V)
      (hU' : U ≤ (TopologicalSpace.Opens.map f.base).obj ((TopologicalSpace.Opens.map g.base).obj V))
      (z : ↑(Z.presheaf.obj (Opposite.op V))),
      (X.presheaf.map (CategoryTheory.homOfLE hU).op).hom (((f ≫ g).app V).hom z) =
        (X.presheaf.map (CategoryTheory.homOfLE hU').op).hom
          ((f.app ((TopologicalSpace.Opens.map g.base).obj V)).hom ((g.app V).hom z)) := by
    intro X Y Z f g V U hU hU' z
    have hc := CategoryTheory.ConcreteCategory.congr_hom
      (AlgebraicGeometry.Scheme.Hom.comp_app f g V) z
    change ((f ≫ g).app V).hom z =
      (f.app ((TopologicalSpace.Opens.map g.base).obj V)).hom ((g.app V).hom z) at hc
    rw [hc]; rfl
  have res_congr_app : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} {f₁ f₂ : X ⟶ Y}
      (hf : f₁ = f₂) {V : Y.Opens} {U : X.Opens}
      (hU₁ : U ≤ (TopologicalSpace.Opens.map f₁.base).obj V)
      (hU₂ : U ≤ (TopologicalSpace.Opens.map f₂.base).obj V)
      (y : ↑(Y.presheaf.obj (Opposite.op V))),
      (X.presheaf.map (CategoryTheory.homOfLE hU₁).op).hom ((f₁.app V).hom y) =
        (X.presheaf.map (CategoryTheory.homOfLE hU₂).op).hom ((f₂.app V).hom y) := by
    intro X Y f₁ f₂ hf V U hU₁ hU₂ y
    subst hf; rfl
  have res_id_app : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ X)
      (hfg : f ≫ g = 𝟙 X) {V U : X.Opens}
      (hU' : U ≤ (TopologicalSpace.Opens.map f.base).obj ((TopologicalSpace.Opens.map g.base).obj V))
      (hUV : U ≤ V)
      (x : ↑(X.presheaf.obj (Opposite.op V))),
      (X.presheaf.map (CategoryTheory.homOfLE hU').op).hom
        ((f.app ((TopologicalSpace.Opens.map g.base).obj V)).hom ((g.app V).hom x)) =
        (X.presheaf.map (CategoryTheory.homOfLE hUV).op).hom x := by
    intro X Y f g hfg V U hU' hUV x
    have hU : U ≤ (TopologicalSpace.Opens.map (f ≫ g).base).obj V := fun p hp => hU' hp
    rw [← res_comp_app f g hU hU', res_congr_app hfg hU hUV,
      AlgebraicGeometry.Scheme.Hom.id_app V]
    rfl

  
  have hLocalExt : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : X₁ ⟶ X₂)
      (N₂ : WeilLineBundle X₂) (V : X₁.Opens)
      (x₁ x₂ : ↑(X₁.presheaf.obj (Opposite.op V))),
      (∀ b : Fin N₂.m,
        (X₁.presheaf.map (CategoryTheory.homOfLE
          (inf_le_left : V ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b) ≤ V)).op).hom x₁ =
        (X₁.presheaf.map (CategoryTheory.homOfLE
          (inf_le_left : V ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b) ≤ V)).op).hom x₂) →
      x₁ = x₂ := by
    intro X₁ X₂ f N₂ V x₁ x₂ hx
    let U : ULift.{u} (Fin N₂.m) → X₁.Opens :=
      fun b => V ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b.down)
    let iU : ∀ b : ULift.{u} (Fin N₂.m), U b ⟶ V :=
      fun _ => CategoryTheory.homOfLE inf_le_left
    have hCovU : V ≤ ⨆ b : ULift.{u} (Fin N₂.m), U b := by
      intro p hp
      have hfp : f.base p ∈ (Set.univ : Set X₂) := Set.mem_univ _
      rw [← N₂.hCov, Set.mem_iUnion] at hfp
      obtain ⟨b, hb⟩ := hfp
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨b⟩, ⟨hp, ⟨trivial, hb⟩⟩⟩
    exact X₁.sheaf.eq_of_locally_eq' U V iU hCovU x₁ x₂ (fun b => hx b.down)

  have hGluePull : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : X₁ ⟶ X₂)
