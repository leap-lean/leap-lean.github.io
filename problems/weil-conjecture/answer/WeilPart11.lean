    let openCochain : X.Opens → ℕ → Type u :=
      fun W s => ∀ α : WeilStrictMonoTuple L.m s,
        ↑(X.presheaf.obj (Opposite.op (W ⊓ weilChartInter L α)))
    let openDiff : ∀ (W : X.Opens) (s : ℕ), openCochain W s → openCochain W (s + 1) :=
      fun W s c β =>
        let h01 : W ⊓ weilChartInter L β ≤ L.V (β.1 0) ⊓ L.V (β.1 1) :=
          le_trans inf_le_right
            (le_inf (Finset.inf'_le _ (Finset.mem_univ (0 : Fin (s + 2))))
              (Finset.inf'_le _ (Finset.mem_univ (1 : Fin (s + 2)))))
