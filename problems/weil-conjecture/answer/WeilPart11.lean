      let A₁ := ↑(X.presheaf.obj (Opposite.op U₁))
      let A₂ := ↑(X.presheaf.obj (Opposite.op U₂))
      let ρ : A₁ →+* A₂ := (X.presheaf.map (CategoryTheory.homOfLE h₂₁).op).hom
      let _ : Algebra A₁ A₂ := RingHom.toAlgebra ρ
      have _ : IsLocalization.Away r A₂ := hLoc
      obtain ⟨φ, hφ⟩ := hCohG₀.2 U₁ U₂ hAff₁ hAff₂ hSub₁ h₂₁
      let _ : Module A₁ (G₀.sec U₂) := Module.compHom (G₀.sec U₂) (algebraMap A₁ A₂)
      have _ : IsScalarTower A₁ A₂ (G₀.sec U₂) := IsScalarTower.of_algebraMap_smul (fun _ _ => rfl)
      let resLin : G₀.sec U₁ →ₗ[A₁] G₀.sec U₂ :=
        { toFun := G₀.res h₂₁
          map_add' := map_add (G₀.res h₂₁)
          map_smul' := fun a x => G₀.res_smul h₂₁ a x }
      let φ₁ : TensorProduct A₁ A₂ (G₀.sec U₁) ≃ₗ[A₁] G₀.sec U₂ := φ.restrictScalars A₁
      have h_comp : (↑φ₁ : TensorProduct A₁ A₂ (G₀.sec U₁) →ₗ[A₁] G₀.sec U₂) ∘ₗ
          TensorProduct.mk A₁ A₂ (G₀.sec U₁) 1 = resLin := by
        ext x
        change φ (TensorProduct.tmul A₁ (1 : A₂) x) = G₀.res h₂₁ x
        rw [hφ 1 x, one_smul]
      have _ : IsLocalizedModule (Submonoid.powers r) ((TensorProduct.mk A₁ A₂ (G₀.sec U₁)) 1) :=
        IsLocalization.tensorProduct_isLocalizedModule (Submonoid.powers r) A₂
      have _ : IsLocalizedModule (Submonoid.powers r) resLin := by
        rw [← h_comp]
        exact IsLocalizedModule.of_linearEquiv (Submonoid.powers r)
          (TensorProduct.mk A₁ A₂ (G₀.sec U₁) 1) φ₁
      refine ⟨?_, ?_⟩
      · intro y
        obtain ⟨⟨x, ⟨_, d, rfl⟩⟩, hxd⟩ := IsLocalizedModule.surj (Submonoid.powers r) resLin y
        refine ⟨d, x, ?_⟩
        have hxd' : ρ (r ^ d) • y = G₀.res h₂₁ x := hxd
        rw [map_pow] at hxd'
        exact hxd'
      · intro x hx
        have hx' : resLin x = 0 := hx
        obtain ⟨⟨_, d, rfl⟩, hd⟩ :=
          (IsLocalizedModule.eq_zero_iff (Submonoid.powers r) resLin).mp hx'
        exact ⟨d, hd⟩
    have hFinV : ∀ k₀ : Fin m, ∃ (n : ℕ) (g : Fin n → G₀.sec (V k₀)),
        Submodule.span ↑(X.presheaf.obj (Opposite.op (V k₀))) (Set.range g) = ⊤ :=
      fun k₀ =>
        @Module.Finite.exists_fin _ _ _ _ _ (hCohG₀.1 (V k₀) (hAffV k₀) ⟨k₀, le_refl _⟩)
    choose n_gen g_gen hg_span using hFinV
    let Idx := Σ k₀ : Fin m, Fin (n_gen k₀)
    let s : ℕ := Fintype.card Idx
    let eIdx : Fin s ≃ Idx := (Fintype.equivFin Idx).symm
    have hStage1_ex : ∀ (l : Fin s) (j : Fin m),
        ∃ (d : ℕ) (x : G₀.sec (V j)),
          ((X.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : V j ⊓ V (eIdx l).1 ≤ V j)).op).hom
            (t (eIdx l).1 j)) ^ d •
            G₀.res (inf_le_right : V j ⊓ V (eIdx l).1 ≤ V (eIdx l).1)
              (g_gen (eIdx l).1 (eIdx l).2) =
          G₀.res (inf_le_left : V j ⊓ V (eIdx l).1 ≤ V j) x := by
      intro l j
      exact (hLocMod (V j) (V j ⊓ V (eIdx l).1) (hAffV j)
        (AlgebraicGeometry.IsAffineOpen.inf (hAffV j) (hAffV (eIdx l).1))
        ⟨j, le_refl _⟩ inf_le_left (t (eIdx l).1 j) (hLoc1 (eIdx l).1 j)).1 _
    choose d₁_raw m_raw hm_raw using hStage1_ex
    let d₁ : Fin s → ℕ := fun l => Finset.univ.sup (d₁_raw l)
    let m_tilde : ∀ (l : Fin s) (j : Fin m), G₀.sec (V j) :=
      fun l j => (t (eIdx l).1 j) ^ (d₁ l - d₁_raw l j) • m_raw l j
    have hm_tilde_spec : ∀ (l : Fin s) (j : Fin m),
        G₀.res (inf_le_left : V j ⊓ V (eIdx l).1 ≤ V j) (m_tilde l j) =
          ((X.presheaf.map (CategoryTheory.homOfLE
            (le_inf inf_le_right inf_le_left :
              V j ⊓ V (eIdx l).1 ≤ V (eIdx l).1 ⊓ V j)).op).hom
            (u (eIdx l).1 j)) ^ (d₁ l) •
          G₀.res (inf_le_right : V j ⊓ V (eIdx l).1 ≤ V (eIdx l).1)
            (g_gen (eIdx l).1 (eIdx l).2) := by
      intro l j
      have hle_d : d₁_raw l j ≤ d₁ l := Finset.le_sup (Finset.mem_univ j)
      change G₀.res inf_le_left ((t (eIdx l).1 j) ^ (d₁ l - d₁_raw l j) • m_raw l j) = _
      rw [hResSmul inf_le_left _ (m_raw l j), map_pow, ← hm_raw l j, ← mul_smul, ← pow_add,
        Nat.sub_add_cancel hle_d,
        hT2 (V j ⊓ V (eIdx l).1) (eIdx l).1 j inf_le_left inf_le_right]
    have hm_tilde_self : ∀ l : Fin s, m_tilde l (eIdx l).1 = g_gen (eIdx l).1 (eIdx l).2 := by
      intro l
      let k₀ := (eIdx l).1
      have hdiag : V k₀ ≤ V k₀ ⊓ V k₀ := le_inf (le_refl _) (le_refl _)
      have h_eq := congrArg (G₀.res hdiag) (hm_tilde_spec l k₀)
      rw [G₀.res_comp, G₀.res_id, hResSmul hdiag, G₀.res_comp, G₀.res_id, map_pow,
        hMapComp (le_inf inf_le_right inf_le_left) hdiag (le_inf (le_refl _) (le_refl _)),
        hU1 k₀, map_one, one_pow, one_smul] at h_eq
      exact h_eq
    let δ : ∀ (l : Fin s) (p : Fin m × Fin m), G₀.sec (V p.1 ⊓ V p.2) :=
      fun l p =>
        G₀.res (inf_le_left : V p.1 ⊓ V p.2 ≤ V p.1) (m_tilde l p.1) -
          ((X.presheaf.map (CategoryTheory.homOfLE
            (le_inf inf_le_right inf_le_left :
              V p.1 ⊓ V p.2 ≤ V p.2 ⊓ V p.1)).op).hom
            (u p.2 p.1)) ^ (d₁ l) •
            G₀.res (inf_le_right : V p.1 ⊓ V p.2 ≤ V p.2) (m_tilde l p.2)
    have hStage2_ex : ∀ (l : Fin s) (p : Fin m × Fin m),
        ∃ d : ℕ,
          (((X.presheaf.map
                (CategoryTheory.homOfLE (inf_le_left : V p.1 ⊓ V p.2 ≤ V p.1)).op).hom
              (t (eIdx l).1 p.1) *
            (X.presheaf.map
                (CategoryTheory.homOfLE (inf_le_right : V p.1 ⊓ V p.2 ≤ V p.2)).op).hom
              (t (eIdx l).1 p.2)) ^ d) • δ l p = 0 := by
      intro l p
      let k₀ := (eIdx l).1
      let W_ij : X.Opens := V p.1 ⊓ V p.2
      let W₃ : X.Opens := W_ij ⊓ V k₀
      have hAffWij : AlgebraicGeometry.IsAffineOpen W_ij :=
        AlgebraicGeometry.IsAffineOpen.inf (hAffV p.1) (hAffV p.2)
      have hAffW₃ : AlgebraicGeometry.IsAffineOpen W₃ :=
        AlgebraicGeometry.IsAffineOpen.inf hAffWij (hAffV k₀)
      apply (hLocMod W_ij W₃ hAffWij hAffW₃ ⟨p.1, inf_le_left⟩ inf_le_left _
        (hLoc2 k₀ p.1 p.2)).2
      change G₀.res (inf_le_left : W₃ ≤ W_ij)
        (G₀.res inf_le_left (m_tilde l p.1) - _ • G₀.res inf_le_right (m_tilde l p.2)) = 0
      rw [map_sub, hResSmul (inf_le_left : W₃ ≤ W_ij) _ (G₀.res inf_le_right (m_tilde l p.2)),
        map_pow]
      have ht1 : G₀.res (inf_le_left : W₃ ≤ W_ij)
          (G₀.res (inf_le_left : W_ij ≤ V p.1) (m_tilde l p.1)) =
        G₀.res (le_inf (le_trans inf_le_left inf_le_left) inf_le_right : W₃ ≤ V p.1 ⊓ V k₀)
          (G₀.res (inf_le_left : V p.1 ⊓ V k₀ ≤ V p.1) (m_tilde l p.1)) := by
        rw [G₀.res_comp, G₀.res_comp]
      have ht2 : G₀.res (inf_le_left : W₃ ≤ W_ij)
          (G₀.res (inf_le_right : W_ij ≤ V p.2) (m_tilde l p.2)) =
        G₀.res (le_inf (le_trans inf_le_left inf_le_right) inf_le_right : W₃ ≤ V p.2 ⊓ V k₀)
          (G₀.res (inf_le_left : V p.2 ⊓ V k₀ ≤ V p.2) (m_tilde l p.2)) := by
        rw [G₀.res_comp, G₀.res_comp]
      rw [ht1, ht2, hm_tilde_spec l p.1, hm_tilde_spec l p.2,
        hResSmul (le_inf (le_trans inf_le_left inf_le_left) inf_le_right) _
          (G₀.res inf_le_right (g_gen k₀ (eIdx l).2)),
        hResSmul (le_inf (le_trans inf_le_left inf_le_right) inf_le_right) _
          (G₀.res inf_le_right (g_gen k₀ (eIdx l).2)),
        map_pow, map_pow, G₀.res_comp, G₀.res_comp, ← mul_smul]
      have h_u_eq :
          (X.presheaf.map (CategoryTheory.homOfLE
              (le_inf (le_trans (inf_le_left : W₃ ≤ W_ij) inf_le_right)
                (le_trans (inf_le_left : W₃ ≤ W_ij) inf_le_left))).op).hom (u p.2 p.1) *
            (X.presheaf.map (CategoryTheory.homOfLE
              (le_inf (inf_le_right : W₃ ≤ V k₀)
                (le_trans (inf_le_left : W₃ ≤ W_ij) inf_le_right))).op).hom (u k₀ p.2) =
          (X.presheaf.map (CategoryTheory.homOfLE
            (le_inf (inf_le_right : W₃ ≤ V k₀)
              (le_trans (inf_le_left : W₃ ≤ W_ij) inf_le_left))).op).hom (u k₀ p.1) := by
        rw [mul_comm]
        exact hU3 W₃ k₀ p.2 p.1 inf_le_right
          (le_trans inf_le_left inf_le_right) (le_trans inf_le_left inf_le_left)
      rw [hMapComp (le_inf inf_le_right inf_le_left) (inf_le_left : W₃ ≤ W_ij)
          (le_inf (le_trans inf_le_left inf_le_right) (le_trans inf_le_left inf_le_left)),
        hMapComp (le_inf inf_le_right inf_le_left)
          (le_inf (le_trans inf_le_left inf_le_left) inf_le_right)
          (le_inf inf_le_right (le_trans inf_le_left inf_le_left)),
        hMapComp (le_inf inf_le_right inf_le_left)
          (le_inf (le_trans inf_le_left inf_le_right) inf_le_right)
          (le_inf inf_le_right (le_trans inf_le_left inf_le_right)),
        ← mul_pow, h_u_eq, sub_self]
    choose d₂_raw hd₂_raw using hStage2_ex
    let d₂ : Fin s → ℕ := fun l => Finset.univ.sup (d₂_raw l)
    have hAnn_ti : ∀ (l : Fin s) (i j : Fin m),
        (((X.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : V i ⊓ V j ≤ V i)).op).hom
          (t (eIdx l).1 i)) ^ (2 * d₂ l)) • δ l (i, j) = 0 := by
      intro l i j
      let k₀ := (eIdx l).1
      let W_ij : X.Opens := V i ⊓ V j
      let ti :=
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_ij ≤ V i)).op).hom (t k₀ i)
      let tj :=
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W_ij ≤ V j)).op).hom (t k₀ j)
      let uij := (X.presheaf.map (CategoryTheory.homOfLE
        (le_inf (inf_le_left : W_ij ≤ V i) inf_le_right)).op).hom (u i j)
      let uji := (X.presheaf.map (CategoryTheory.homOfLE
        (le_inf (inf_le_right : W_ij ≤ V j) inf_le_left)).op).hom (u j i)
      have hle_d2 : d₂_raw l (i, j) ≤ d₂ l := Finset.le_sup (Finset.mem_univ (i, j))
      have hq_d2 : ((ti * tj) ^ (d₂ l)) • δ l (i, j) = 0 := by
        have hsplit : d₂ l = (d₂ l - d₂_raw l (i, j)) + d₂_raw l (i, j) :=
          (Nat.sub_add_cancel hle_d2).symm
        rw [hsplit, pow_add, mul_smul, hd₂_raw l (i, j), smul_zero]
      have htj_eq : tj = uij * ti := hT3 W_ij k₀ j i inf_le_right inf_le_left
      have hq_pow : (ti * tj) ^ (d₂ l) = uij ^ (d₂ l) * ti ^ (2 * d₂ l) := by
        rw [htj_eq]; ring
      have hu_inv : uji * uij = 1 := hU2 W_ij j i inf_le_right inf_le_left
      have h_unit_pow : uji ^ (d₂ l) * (ti * tj) ^ (d₂ l) = ti ^ (2 * d₂ l) := by
        calc uji ^ (d₂ l) * (ti * tj) ^ (d₂ l)
            = (uji * uij) ^ (d₂ l) * ti ^ (2 * d₂ l) := by rw [hq_pow, ← mul_assoc, ← mul_pow]
          _ = ti ^ (2 * d₂ l) := by rw [hu_inv, one_pow, one_mul]
      calc (ti ^ (2 * d₂ l)) • δ l (i, j)
          = (uji ^ (d₂ l) * (ti * tj) ^ (d₂ l)) • δ l (i, j) := by rw [h_unit_pow]
        _ = uji ^ (d₂ l) • (((ti * tj) ^ (d₂ l)) • δ l (i, j)) := mul_smul _ _ _
        _ = 0 := by rw [hq_d2, smul_zero]
    let D : ℕ := Finset.univ.sup (fun l : Fin s => d₁ l + 2 * d₂ l)
    let m_hat : Fin s → ∀ j : Fin m, G₀.sec (V j) :=
      fun l j => (t (eIdx l).1 j) ^ (D - d₁ l) • m_tilde l j
    refine ⟨D, s, m_hat, ?_, ?_⟩
    · intro l i j
      let k₀ := (eIdx l).1
      let W_ij : X.Opens := V i ⊓ V j
      let ti :=
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_ij ≤ V i)).op).hom (t k₀ i)
      let tj :=
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W_ij ≤ V j)).op).hom (t k₀ j)
      let uji := (X.presheaf.map (CategoryTheory.homOfLE
        (le_inf (inf_le_right : W_ij ≤ V j) inf_le_left)).op).hom (u j i)
      have hD_le : d₁ l + 2 * d₂ l ≤ D :=
        Finset.le_sup (f := fun l' : Fin s => d₁ l' + 2 * d₂ l') (Finset.mem_univ l)
      have hsplit : D - d₁ l = (D - d₁ l - 2 * d₂ l) + 2 * d₂ l := by omega
      have h_ann_eq : (ti ^ (2 * d₂ l)) • G₀.res (inf_le_left : W_ij ≤ V i) (m_tilde l i) =
          (ti ^ (2 * d₂ l) * uji ^ (d₁ l)) • G₀.res (inf_le_right : W_ij ≤ V j) (m_tilde l j) := by
        have h0 := hAnn_ti l i j
        change (ti ^ (2 * d₂ l)) •
          (G₀.res inf_le_left (m_tilde l i) - uji ^ (d₁ l) • G₀.res inf_le_right (m_tilde l j)) = 0
          at h0
        rw [smul_sub, ← mul_smul] at h0
        exact sub_eq_zero.mp h0
      have hti_eq : ti = uji * tj := hT3 W_ij k₀ i j inf_le_left inf_le_right
      have h_alg : ti ^ (D - d₁ l - 2 * d₂ l) * (ti ^ (2 * d₂ l) * uji ^ (d₁ l)) =
          uji ^ D * tj ^ (D - d₁ l) := by
        have h1 : ti ^ (D - d₁ l - 2 * d₂ l) * (ti ^ (2 * d₂ l) * uji ^ (d₁ l)) =
            ti ^ (D - d₁ l) * uji ^ (d₁ l) := by
          calc ti ^ (D - d₁ l - 2 * d₂ l) * (ti ^ (2 * d₂ l) * uji ^ (d₁ l))
              = (ti ^ (D - d₁ l - 2 * d₂ l) * ti ^ (2 * d₂ l)) * uji ^ (d₁ l) :=
                (mul_assoc _ _ _).symm
            _ = ti ^ (D - d₁ l) * uji ^ (d₁ l) := by rw [← pow_add, ← hsplit]
        have h2 : (D - d₁ l) + d₁ l = D := by omega
        calc ti ^ (D - d₁ l - 2 * d₂ l) * (ti ^ (2 * d₂ l) * uji ^ (d₁ l))
            = (uji * tj) ^ (D - d₁ l) * uji ^ (d₁ l) := by rw [h1, hti_eq]
          _ = (uji ^ (D - d₁ l) * uji ^ (d₁ l)) * tj ^ (D - d₁ l) := by rw [mul_pow]; ring
          _ = uji ^ D * tj ^ (D - d₁ l) := by rw [← pow_add, h2]
      change G₀.res (inf_le_left : W_ij ≤ V i) ((t k₀ i) ^ (D - d₁ l) • m_tilde l i) =
        uji ^ D • G₀.res (inf_le_right : W_ij ≤ V j) ((t k₀ j) ^ (D - d₁ l) • m_tilde l j)
      calc G₀.res (inf_le_left : W_ij ≤ V i) ((t k₀ i) ^ (D - d₁ l) • m_tilde l i)
          = (ti ^ (D - d₁ l)) • G₀.res (inf_le_left : W_ij ≤ V i) (m_tilde l i) := by
            rw [hResSmul (inf_le_left : W_ij ≤ V i) ((t k₀ i) ^ (D - d₁ l)) (m_tilde l i),
              map_pow]
        _ = (ti ^ (D - d₁ l - 2 * d₂ l)) •
              ((ti ^ (2 * d₂ l)) • G₀.res (inf_le_left : W_ij ≤ V i) (m_tilde l i)) := by
            rw [← mul_smul, ← pow_add, ← hsplit]
        _ = (ti ^ (D - d₁ l - 2 * d₂ l) * (ti ^ (2 * d₂ l) * uji ^ (d₁ l))) •
              G₀.res (inf_le_right : W_ij ≤ V j) (m_tilde l j) := by
            rw [h_ann_eq, ← mul_smul]
        _ = (uji ^ D * tj ^ (D - d₁ l)) • G₀.res (inf_le_right : W_ij ≤ V j) (m_tilde l j) := by
            rw [h_alg]
        _ = uji ^ D • G₀.res (inf_le_right : W_ij ≤ V j)
              ((t k₀ j) ^ (D - d₁ l) • m_tilde l j) := by
            rw [hResSmul (inf_le_right : W_ij ≤ V j) ((t k₀ j) ^ (D - d₁ l)) (m_tilde l j),
              map_pow, mul_smul]
    · intro k₀ y
      have hy_mem : y ∈ Submodule.span ↑(X.presheaf.obj (Opposite.op (V k₀)))
          (Set.range (g_gen k₀)) := by
        rw [hg_span k₀]; trivial
      rw [Submodule.mem_span_range_iff_exists_fun] at hy_mem
      obtain ⟨c₀, hc₀⟩ := hy_mem
      classical
      let c : Fin s → ↑(X.presheaf.obj (Opposite.op (V k₀))) :=
        fun l => ∑ r : Fin (n_gen k₀), if l = eIdx.symm ⟨k₀, r⟩ then c₀ r else 0
      refine ⟨c, ?_⟩
      have hm_hat_self : ∀ r : Fin (n_gen k₀),
          m_hat (eIdx.symm ⟨k₀, r⟩) k₀ = g_gen k₀ r := by
        intro r
        let l := eIdx.symm ⟨k₀, r⟩
        have hl : eIdx l = ⟨k₀, r⟩ := eIdx.apply_symm_apply ⟨k₀, r⟩
        have h_self := hm_tilde_self l
        change (t (eIdx l).1 k₀) ^ (D - d₁ l) • m_tilde l k₀ = g_gen k₀ r
        rw [hl] at h_self ⊢
        dsimp only at h_self ⊢
        rw [hT1 k₀, one_pow, one_smul, h_self]
      calc y
          = ∑ r : Fin (n_gen k₀), c₀ r • g_gen k₀ r := hc₀.symm
        _ = ∑ r : Fin (n_gen k₀),
              ∑ l : Fin s, (if l = eIdx.symm ⟨k₀, r⟩ then c₀ r else 0) • m_hat l k₀ := by
            refine Finset.sum_congr rfl fun r _ => ?_
            rw [Fintype.sum_eq_single (eIdx.symm ⟨k₀, r⟩)
              (fun l hl => by simp [hl])]
            simp [hm_hat_self r]
        _ = ∑ l : Fin s, c l • m_hat l k₀ := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun l _ => ?_
            rw [Finset.sum_smul]
  have hAbstractExact : ∀ (X : AlgebraicGeometry.Scheme.{u}) (m : ℕ) (V : Fin m → X.Opens)
      (_hAffV : ∀ k : Fin m, AlgebraicGeometry.IsAffineOpen (V k))
      (_hNoeth : ∀ U : X.Opens, AlgebraicGeometry.IsAffineOpen U →
        IsNoetherianRing ↑(X.presheaf.obj (Opposite.op U)))
      (u : ∀ j k : Fin m, ↑(X.presheaf.obj (Opposite.op (V j ⊓ V k))))
      (_hU1 : ∀ k : Fin m, u k k = 1)
      (_hU2 : ∀ (U : X.Opens) (j k : Fin m) (hUj : U ≤ V j) (hUk : U ≤ V k),
        (X.presheaf.map (CategoryTheory.homOfLE (le_inf hUj hUk)).op).hom (u j k) *
          (X.presheaf.map (CategoryTheory.homOfLE (le_inf hUk hUj)).op).hom (u k j) = 1)
      (_hU3 : ∀ (U : X.Opens) (i j k : Fin m)
          (hUi : U ≤ V i) (hUj : U ≤ V j) (hUk : U ≤ V k),
        (X.presheaf.map (CategoryTheory.homOfLE (le_inf hUi hUj)).op).hom (u i j) *
          (X.presheaf.map (CategoryTheory.homOfLE (le_inf hUj hUk)).op).hom (u j k) =
          (X.presheaf.map (CategoryTheory.homOfLE (le_inf hUi hUk)).op).hom (u i k))
      (G₀ : WeilPresheafModule X)
      (_hCohG₀ : IsWeilCoherentSubChartModule V G₀)
      (D s : ℕ)
      (m_hat : Fin s → ∀ j : Fin m, G₀.sec (V j))
      (_hCoc : ∀ (l : Fin s) (i j : Fin m),
        G₀.res (inf_le_left : V i ⊓ V j ≤ V i) (m_hat l i) =
          ((X.presheaf.map (CategoryTheory.homOfLE
            (le_inf inf_le_right inf_le_left : V i ⊓ V j ≤ V j ⊓ V i)).op).hom (u j i)) ^ D •
            G₀.res (inf_le_right : V i ⊓ V j ≤ V j) (m_hat l j))
      (_hSpan : ∀ (k₀ : Fin m) (y : G₀.sec (V k₀)),
        ∃ c : Fin s → ↑(X.presheaf.obj (Opposite.op (V k₀))),
          y = ∑ l : Fin s, c l • m_hat l k₀),
      ∃ (K E : WeilPresheafModule X)
        (ev : ∀ (U : X.Opens) (k : Fin m), U ≤ V k →
          E.sec U ≃ₗ[↑(X.presheaf.obj (Opposite.op U))]
            (Fin s → ↑(X.presheaf.obj (Opposite.op U)))),
        (∀ {U W : X.Opens} (k : Fin m) (hUk : U ≤ V k) (hWU : W ≤ U)
          (x : E.sec U) (l : Fin s),
          ev W k (le_trans hWU hUk) (E.res hWU x) l =
            (X.presheaf.map (CategoryTheory.homOfLE hWU).op).hom (ev U k hUk x l)) ∧
        (∀ (U : X.Opens) (j k : Fin m) (hUj : U ≤ V j) (hUk : U ≤ V k)
          (x : E.sec U) (l : Fin s),
          ev U j hUj x l =
            ((X.presheaf.map (CategoryTheory.homOfLE (le_inf hUj hUk)).op).hom (u j k)) ^ D *
              ev U k hUk x l) ∧
        IsWeilCoherentSubChartModule V K ∧
        HasWeilSubChartShortExactSeq V K E G₀ := by
    intro X m V hAffV hNoeth u hU1 hU2 hU3 G₀ hCohG₀ D s m_hat hCoc hSpan
    have hMapComp : ∀ {U₁ U₂ U₃ : X.Opens} (h₁₂ : U₂ ≤ U₁) (h₂₃ : U₃ ≤ U₂) (h₁₃ : U₃ ≤ U₁)
        (x : ↑(X.presheaf.obj (Opposite.op U₁))),
        (X.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom
          ((X.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom x) =
        (X.presheaf.map (CategoryTheory.homOfLE h₁₃).op).hom x := by
      intro U₁ U₂ U₃ h₁₂ h₂₃ h₁₃ x
      have hHom : (CategoryTheory.homOfLE h₁₂).op ≫ (CategoryTheory.homOfLE h₂₃).op =
          (CategoryTheory.homOfLE h₁₃).op := by
        rw [← op_comp, CategoryTheory.homOfLE_comp]
      have hMap := congrArg (fun f => f.hom x)
        (X.presheaf.map_comp (CategoryTheory.homOfLE h₁₂).op (CategoryTheory.homOfLE h₂₃).op)
      rw [hHom, CommRingCat.hom_comp, RingHom.comp_apply] at hMap
      exact hMap.symm
    have hMapId : ∀ (U₁ : X.Opens) (h₁₁ : U₁ ≤ U₁) (x : ↑(X.presheaf.obj (Opposite.op U₁))),
        (X.presheaf.map (CategoryTheory.homOfLE h₁₁).op).hom x = x := by
      intro U₁ h₁₁ x
      have hHom : CategoryTheory.homOfLE h₁₁ = 𝟙 U₁ := Subsingleton.elim _ _
      rw [hHom, op_id, X.presheaf.map_id]
      rfl
    have hResSmul : ∀ {F : WeilPresheafModule X} {U W : X.Opens} (h : W ≤ U)
        (a : ↑(X.presheaf.obj (Opposite.op U))) (x : F.sec U),
        F.res h (a • x) = ((X.presheaf.map (CategoryTheory.homOfLE h).op).hom a) • F.res h x :=
      fun {F} _ _ h a x => F.res_smul h a x
    let IsTwistedSec : ∀ U : X.Opens,
        (Fin s → ∀ b : Fin m, ↑(X.presheaf.obj (Opposite.op (U ⊓ V b)))) → Prop :=
      fun U f => ∀ (l : Fin s) (a b : Fin m),
        (X.presheaf.map (CategoryTheory.homOfLE
          (inf_le_inf_left U (inf_le_left : V a ⊓ V b ≤ V a))).op).hom (f l a) =
        ((X.presheaf.map (CategoryTheory.homOfLE
          (inf_le_right : U ⊓ (V a ⊓ V b) ≤ V a ⊓ V b)).op).hom (u a b)) ^ D *
        (X.presheaf.map (CategoryTheory.homOfLE
          (inf_le_inf_left U (inf_le_right : V a ⊓ V b ≤ V b))).op).hom (f l b)
    let E_addSub : ∀ U : X.Opens,
        AddSubgroup (Fin s → ∀ b : Fin m, ↑(X.presheaf.obj (Opposite.op (U ⊓ V b)))) :=
      fun U =>
        { carrier := { f | IsTwistedSec U f }
          zero_mem' := by
            intro l a b
            change (X.presheaf.map _).hom 0 = _ * (X.presheaf.map _).hom 0
            rw [map_zero, map_zero, mul_zero]
          add_mem' := by
            intro f₁ f₂ hf₁ hf₂ l a b
            change (X.presheaf.map _).hom (f₁ l a + f₂ l a) =
              _ * (X.presheaf.map _).hom (f₁ l b + f₂ l b)
            rw [map_add, map_add, hf₁ l a b, hf₂ l a b, mul_add]
          neg_mem' := by
            intro f hf l a b
            change (X.presheaf.map _).hom (-f l a) = _ * (X.presheaf.map _).hom (-f l b)
            rw [map_neg, map_neg, hf l a b, mul_neg] }
    let smulE : ∀ (U : X.Opens),
        ↑(X.presheaf.obj (Opposite.op U)) → ↥(E_addSub U) → ↥(E_addSub U) :=
      fun U r f =>
        ⟨fun l b =>
          (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U ⊓ V b ≤ U)).op).hom r * f.1 l b,
          by
            intro l a b
            dsimp only
            rw [map_mul, map_mul,
              hMapComp (inf_le_left : U ⊓ V a ≤ U) (inf_le_inf_left U inf_le_left)
                (inf_le_left : U ⊓ (V a ⊓ V b) ≤ U),
              hMapComp (inf_le_left : U ⊓ V b ≤ U) (inf_le_inf_left U inf_le_right)
                (inf_le_left : U ⊓ (V a ⊓ V b) ≤ U),
              f.2 l a b]
            ring⟩
    let instModE : ∀ (U : X.Opens),
        Module ↑(X.presheaf.obj (Opposite.op U)) ↥(E_addSub U) :=
      fun U =>
        { smul := smulE U
          one_smul := fun f => Subtype.ext (funext fun l => funext fun b => by
            change (X.presheaf.map _).hom 1 * f.1 l b = f.1 l b
            rw [map_one, one_mul])
          mul_smul := fun r₁ r₂ f => Subtype.ext (funext fun l => funext fun b => by
            change (X.presheaf.map _).hom (r₁ * r₂) * f.1 l b =
              (X.presheaf.map _).hom r₁ * ((X.presheaf.map _).hom r₂ * f.1 l b)
            rw [map_mul, mul_assoc])
          smul_zero := fun r => Subtype.ext (funext fun l => funext fun b => by
            change (X.presheaf.map _).hom r * 0 = 0
            rw [mul_zero])
          smul_add := fun r f₁ f₂ => Subtype.ext (funext fun l => funext fun b => by
            change (X.presheaf.map _).hom r * (f₁.1 l b + f₂.1 l b) =
              (X.presheaf.map _).hom r * f₁.1 l b + (X.presheaf.map _).hom r * f₂.1 l b
            rw [mul_add])
          add_smul := fun r₁ r₂ f => Subtype.ext (funext fun l => funext fun b => by
            change (X.presheaf.map _).hom (r₁ + r₂) * f.1 l b =
              (X.presheaf.map _).hom r₁ * f.1 l b + (X.presheaf.map _).hom r₂ * f.1 l b
            rw [map_add, add_mul])
          zero_smul := fun f => Subtype.ext (funext fun l => funext fun b => by
            change (X.presheaf.map _).hom 0 * f.1 l b = 0
            rw [map_zero, zero_mul]) }
    let resE : ∀ {U W : X.Opens}, W ≤ U → (↥(E_addSub U) →+ ↥(E_addSub W)) :=
      fun {U W} hWU =>
        { toFun := fun f =>
            ⟨fun l b =>
              (X.presheaf.map (CategoryTheory.homOfLE (inf_le_inf_right (V b) hWU)).op).hom
                (f.1 l b),
              by
                intro l a b
                dsimp only
                have h_ab : W ⊓ (V a ⊓ V b) ≤ U ⊓ (V a ⊓ V b) := inf_le_inf_right _ hWU
                have hf_ab := congrArg
                  (X.presheaf.map (CategoryTheory.homOfLE h_ab).op).hom (f.2 l a b)
                rw [map_mul, map_pow] at hf_ab
                rw [hMapComp (inf_le_inf_right (V a) hWU) (inf_le_inf_left W inf_le_left)
                    (le_trans h_ab (inf_le_inf_left U inf_le_left)),
                  hMapComp (inf_le_inf_right (V b) hWU) (inf_le_inf_left W inf_le_right)
                    (le_trans h_ab (inf_le_inf_left U inf_le_right)),
                  ← hMapComp (inf_le_inf_left U inf_le_left) h_ab
                    (le_trans h_ab (inf_le_inf_left U inf_le_left)),
                  ← hMapComp (inf_le_inf_left U inf_le_right) h_ab
                    (le_trans h_ab (inf_le_inf_left U inf_le_right)),
                  ← hMapComp (inf_le_right : U ⊓ (V a ⊓ V b) ≤ V a ⊓ V b) h_ab
                    (inf_le_right : W ⊓ (V a ⊓ V b) ≤ V a ⊓ V b)]
                exact hf_ab⟩
          map_zero' := Subtype.ext (funext fun l => funext fun b => by
            change (X.presheaf.map _).hom 0 = 0
            rw [map_zero])
          map_add' := fun f₁ f₂ => Subtype.ext (funext fun l => funext fun b => by
            change (X.presheaf.map _).hom (f₁.1 l b + f₂.1 l b) = _ + _
            rw [map_add]) }
    let E : WeilPresheafModule X :=
      { sec := fun U => ↥(E_addSub U)
        instAddCommGroup := fun U => inferInstance
        instModule := instModE
        res := fun h => resE h
        res_smul := fun {U W} h r f => Subtype.ext (funext fun l => funext fun b => by
          change (X.presheaf.map _).hom ((X.presheaf.map _).hom r * f.1 l b) =
            (X.presheaf.map _).hom ((X.presheaf.map _).hom r) * (X.presheaf.map _).hom (f.1 l b)
          rw [map_mul,
            hMapComp (inf_le_left : U ⊓ V b ≤ U) (inf_le_inf_right (V b) h)
              (le_trans (inf_le_left : W ⊓ V b ≤ W) h),
            hMapComp h (inf_le_left : W ⊓ V b ≤ W)
              (le_trans (inf_le_left : W ⊓ V b ≤ W) h)])
        res_id := fun U f => Subtype.ext (funext fun l => funext fun b =>
          hMapId (U ⊓ V b) _ (f.1 l b))
        res_comp := fun {U W T} h₁ h₂ f => Subtype.ext (funext fun l => funext fun b =>
          hMapComp _ _ _ (f.1 l b)) }
    let evLin : ∀ (U : X.Opens) (k : Fin m) (_ : U ≤ V k),
        E.sec U →ₗ[↑(X.presheaf.obj (Opposite.op U))]
          (Fin s → ↑(X.presheaf.obj (Opposite.op U))) :=
      fun U k hUk =>
        { toFun := fun f l =>
            (X.presheaf.map (CategoryTheory.homOfLE (le_inf (le_refl U) hUk)).op).hom (f.1 l k)
          map_add' := fun f₁ f₂ => funext fun l => by
            change (X.presheaf.map _).hom (f₁.1 l k + f₂.1 l k) = _ + _
            rw [map_add]
          map_smul' := fun r f => funext fun l => by
            change (X.presheaf.map _).hom ((X.presheaf.map _).hom r * f.1 l k) = r * _
            rw [map_mul, hMapComp _ _ (le_refl U), hMapId U (le_refl U) r] }
    let trivLin : ∀ (U : X.Opens) (k : Fin m) (_ : U ≤ V k),
        (Fin s → ↑(X.presheaf.obj (Opposite.op U))) →ₗ[↑(X.presheaf.obj (Opposite.op U))]
          E.sec U :=
      fun U k hUk =>
        { toFun := fun g =>
            ⟨fun l b =>
              ((X.presheaf.map (CategoryTheory.homOfLE
                (le_inf (inf_le_right : U ⊓ V b ≤ V b)
                  (le_trans (inf_le_left : U ⊓ V b ≤ U) hUk))).op).hom (u b k)) ^ D *
                (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U ⊓ V b ≤ U)).op).hom
                  (g l),
              by
                intro l a b
                dsimp only
                have hcoc_u := congrArg (· ^ D)
                  (hU3 (U ⊓ (V a ⊓ V b)) a b k
                    (le_trans inf_le_right inf_le_left)
                    (le_trans inf_le_right inf_le_right)
                    (le_trans inf_le_left hUk))
                rw [mul_pow] at hcoc_u
                rw [map_mul, map_pow, map_mul, map_pow,
                  hMapComp _ _
                    (le_inf (le_trans inf_le_right inf_le_left) (le_trans inf_le_left hUk)),
                  hMapComp (inf_le_left : U ⊓ V a ≤ U) _
                    (inf_le_left : U ⊓ (V a ⊓ V b) ≤ U),
                  hMapComp _ _
                    (le_inf (le_trans inf_le_right inf_le_right) (le_trans inf_le_left hUk)),
                  hMapComp (inf_le_left : U ⊓ V b ≤ U) _
                    (inf_le_left : U ⊓ (V a ⊓ V b) ≤ U)]
                have h_ab_eq :
                    (X.presheaf.map (CategoryTheory.homOfLE
                      (inf_le_right : U ⊓ (V a ⊓ V b) ≤ V a ⊓ V b)).op).hom (u a b) =
                    (X.presheaf.map (CategoryTheory.homOfLE
                      (le_inf (le_trans inf_le_right inf_le_left)
                        (le_trans inf_le_right inf_le_right))).op).hom (u a b) := rfl
                rw [h_ab_eq, ← mul_assoc, hcoc_u]⟩
          map_add' := fun g₁ g₂ => Subtype.ext (funext fun l => funext fun b => by
            change _ * (X.presheaf.map _).hom (g₁ l + g₂ l) = _ * _ + _ * _
            rw [map_add, mul_add])
          map_smul' := fun r g => Subtype.ext (funext fun l => funext fun b => by
            change _ * (X.presheaf.map _).hom (r * g l) =
              (X.presheaf.map _).hom r * (_ * (X.presheaf.map _).hom (g l))
            rw [map_mul]
            ring) }
    let ev : ∀ (U : X.Opens) (k : Fin m), U ≤ V k →
        E.sec U ≃ₗ[↑(X.presheaf.obj (Opposite.op U))]
          (Fin s → ↑(X.presheaf.obj (Opposite.op U))) :=
      fun U k hUk =>
        LinearEquiv.ofLinearMap (evLin U k hUk) (trivLin U k hUk)
          (LinearMap.ext fun g => funext fun l => by
            change (X.presheaf.map _).hom (((X.presheaf.map _).hom (u k k)) ^ D *
              (X.presheaf.map _).hom (g l)) = g l
            rw [hU1 k, map_one, one_pow, one_mul, hMapComp _ _ (le_refl U),
              hMapId U (le_refl U) (g l)])
          (LinearMap.ext fun f => Subtype.ext (funext fun l => funext fun b => by
            change ((X.presheaf.map _).hom (u b k)) ^ D *
              (X.presheaf.map _).hom ((X.presheaf.map _).hom (f.1 l k)) = f.1 l b
            have h_ub : U ⊓ V b ≤ U ⊓ (V b ⊓ V k) :=
              le_inf inf_le_left (le_inf inf_le_right (le_trans inf_le_left hUk))
            have hfb := congrArg
              (X.presheaf.map (CategoryTheory.homOfLE h_ub).op).hom (f.2 l b k)
            rw [map_mul, map_pow,
              hMapComp _ _ (le_refl (U ⊓ V b)),
              hMapId (U ⊓ V b) _ (f.1 l b),
              hMapComp _ _ (le_inf (inf_le_right : U ⊓ V b ≤ V b)
                (le_trans (inf_le_left : U ⊓ V b ≤ U) hUk)),
              hMapComp _ _ (le_trans (inf_le_left : U ⊓ V b ≤ U) (le_inf (le_refl U) hUk))]
              at hfb
            rw [hMapComp (le_inf (le_refl U) hUk) (inf_le_left : U ⊓ V b ≤ U)
              (le_trans (inf_le_left : U ⊓ V b ≤ U) (le_inf (le_refl U) hUk))]
            exact hfb.symm))
    have hEvRes : ∀ {U W : X.Opens} (k : Fin m) (hUk : U ≤ V k) (hWU : W ≤ U)
        (x : E.sec U) (l : Fin s),
        ev W k (le_trans hWU hUk) (E.res hWU x) l =
          (X.presheaf.map (CategoryTheory.homOfLE hWU).op).hom (ev U k hUk x l) := by
      intro U W k hUk hWU x l
      change (X.presheaf.map _).hom ((X.presheaf.map _).hom (x.1 l k)) =
        (X.presheaf.map _).hom ((X.presheaf.map _).hom (x.1 l k))
      rw [hMapComp _ _ (le_trans hWU (le_inf (le_refl U) hUk)),
        hMapComp _ _ (le_trans hWU (le_inf (le_refl U) hUk))]
    have hEvTwist : ∀ (U : X.Opens) (j k : Fin m) (hUj : U ≤ V j) (hUk : U ≤ V k)
        (x : E.sec U) (l : Fin s),
        ev U j hUj x l =
          ((X.presheaf.map (CategoryTheory.homOfLE (le_inf hUj hUk)).op).hom (u j k)) ^ D *
            ev U k hUk x l := by
      intro U j k hUj hUk x l
      have h_u : U ≤ U ⊓ (V j ⊓ V k) := le_inf (le_refl U) (le_inf hUj hUk)
      have hjk := congrArg (X.presheaf.map (CategoryTheory.homOfLE h_u).op).hom (x.2 l j k)
      rw [map_mul, map_pow,
        hMapComp _ h_u (le_inf (le_refl U) hUj),
        hMapComp _ h_u (le_inf hUj hUk),
        hMapComp _ h_u (le_inf (le_refl U) hUk)] at hjk
      exact hjk
    let π_chart : ∀ (U : X.Opens) (k : Fin m) (_ : U ≤ V k),
        E.sec U →ₗ[↑(X.presheaf.obj (Opposite.op U))] G₀.sec U :=
      fun U k hUk =>
        { toFun := fun x => ∑ l : Fin s, (ev U k hUk x l) • G₀.res hUk (m_hat l k)
          map_add' := fun x₁ x₂ => by
            simp only [map_add, Pi.add_apply, add_smul, Finset.sum_add_distrib]
          map_smul' := fun r x => by
            simp only [LinearEquiv.map_smul, Pi.smul_apply, smul_eq_mul, mul_smul,
              RingHom.id_apply, Finset.smul_sum] }
    have hπ_indep : ∀ (U : X.Opens) (j k : Fin m)
        (hUj : U ≤ V j) (hUk : U ≤ V k) (x : E.sec U),
        π_chart U j hUj x = π_chart U k hUk x := by
      intro U j k hUj hUk x
      change ∑ l : Fin s, (ev U j hUj x l) • G₀.res hUj (m_hat l j) =
        ∑ l : Fin s, (ev U k hUk x l) • G₀.res hUk (m_hat l k)
      refine Finset.sum_congr rfl fun l _ => ?_
      have hres_m := congrArg (G₀.res (le_inf hUj hUk : U ≤ V j ⊓ V k)) (hCoc l j k)
      rw [G₀.res_comp, hResSmul (le_inf hUj hUk), G₀.res_comp, map_pow,
        hMapComp (le_inf inf_le_right inf_le_left) (le_inf hUj hUk) (le_inf hUk hUj)] at hres_m
      rw [hEvTwist U j k hUj hUk x l, hres_m, ← mul_smul]
      have h_cancel :
          (((X.presheaf.map (CategoryTheory.homOfLE (le_inf hUj hUk)).op).hom (u j k)) ^ D *
            ev U k hUk x l) *
          ((X.presheaf.map (CategoryTheory.homOfLE (le_inf hUk hUj)).op).hom (u k j)) ^ D =
          ev U k hUk x l := by
        calc (((X.presheaf.map (CategoryTheory.homOfLE (le_inf hUj hUk)).op).hom (u j k)) ^ D *
                ev U k hUk x l) *
              ((X.presheaf.map (CategoryTheory.homOfLE (le_inf hUk hUj)).op).hom (u k j)) ^ D
            = ((X.presheaf.map (CategoryTheory.homOfLE (le_inf hUj hUk)).op).hom (u j k) *
                (X.presheaf.map (CategoryTheory.homOfLE (le_inf hUk hUj)).op).hom (u k j)) ^ D *
                ev U k hUk x l := by rw [mul_pow]; ring
          _ = ev U k hUk x l := by rw [hU2 U j k hUj hUk, one_pow, one_mul]
      rw [h_cancel]
    let π : ∀ (U : X.Opens), (∃ k : Fin m, U ≤ V k) →
        E.sec U →ₗ[↑(X.presheaf.obj (Opposite.op U))] G₀.sec U :=
      fun U hU => π_chart U (Classical.choose hU) (Classical.choose_spec hU)
    have hπ_eq : ∀ (U : X.Opens) (hU : ∃ k : Fin m, U ≤ V k)
        (k : Fin m) (hUk : U ≤ V k) (x : E.sec U),
        π U hU x = π_chart U k hUk x :=
      fun U hU k hUk x => hπ_indep U (Classical.choose hU) k (Classical.choose_spec hU) hUk x
    have hπ_res : ∀ {U W : X.Opens} (hU : ∃ k : Fin m, U ≤ V k)
        (hW : ∃ k : Fin m, W ≤ V k) (hWU : W ≤ U) (y : E.sec U),
        G₀.res hWU (π U hU y) = π W hW (E.res hWU y) := by
      intro U W hU hW hWU y
      obtain ⟨k, hUk⟩ := hU
      rw [hπ_eq U ⟨k, hUk⟩ k hUk y, hπ_eq W hW k (le_trans hWU hUk) (E.res hWU y)]
      change G₀.res hWU (∑ l : Fin s, (ev U k hUk y l) • G₀.res hUk (m_hat l k)) =
        ∑ l : Fin s, (ev W k (le_trans hWU hUk) (E.res hWU y) l) •
          G₀.res (le_trans hWU hUk) (m_hat l k)
      rw [map_sum]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [hResSmul hWU, G₀.res_comp, hEvRes k hUk hWU y l]
    have hπ_surj_V : ∀ (k₀ : Fin m),
        Function.Surjective (π (V k₀) ⟨k₀, le_refl _⟩) := by
      intro k₀ y
      obtain ⟨c, rfl⟩ := hSpan k₀ y
      refine ⟨(ev (V k₀) k₀ (le_refl _)).symm c, ?_⟩
      rw [hπ_eq (V k₀) ⟨k₀, le_refl _⟩ k₀ (le_refl _)]
      change ∑ l : Fin s,
        (ev (V k₀) k₀ (le_refl _) ((ev (V k₀) k₀ (le_refl _)).symm c) l) •
          G₀.res (le_refl _) (m_hat l k₀) = ∑ l : Fin s, c l • m_hat l k₀
      rw [LinearEquiv.apply_symm_apply]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [G₀.res_id]
    have hπ_surj : ∀ (U : X.Opens), AlgebraicGeometry.IsAffineOpen U →
        ∀ (hU : ∃ k : Fin m, U ≤ V k), Function.Surjective (π U hU) := by
      intro U hAffU hU z
      obtain ⟨k₀, hUk₀⟩ := hU
      let A₀ := ↑(X.presheaf.obj (Opposite.op (V k₀)))
      let A_U := ↑(X.presheaf.obj (Opposite.op U))
      let _ : Algebra A₀ A_U :=
        RingHom.toAlgebra (X.presheaf.map (CategoryTheory.homOfLE hUk₀).op).hom
      obtain ⟨φ_G, hφ_G⟩ := hCohG₀.2 (V k₀) U (hAffV k₀) hAffU ⟨k₀, le_refl _⟩ hUk₀
      change z ∈ LinearMap.range (π U ⟨k₀, hUk₀⟩)
      rw [← φ_G.apply_symm_apply z]
      generalize φ_G.symm z = t_z
      induction t_z using TensorProduct.induction_on with
      | zero =>
        rw [map_zero]
        exact Submodule.zero_mem _
      | tmul b y =>
        obtain ⟨x₀, rfl⟩ := hπ_surj_V k₀ y
        refine ⟨b • E.res hUk₀ x₀, ?_⟩
        rw [LinearMap.map_smul, ← hπ_res ⟨k₀, le_refl _⟩ ⟨k₀, hUk₀⟩ hUk₀ x₀, ← hφ_G b _]
      | add t₁ t₂ ht₁ ht₂ =>
        rw [map_add]
        exact Submodule.add_mem _ ht₁ ht₂
    let K_sub : ∀ U : X.Opens, Submodule ↑(X.presheaf.obj (Opposite.op U)) (E.sec U) :=
      fun U =>
        { carrier := { x : E.sec U |
            ∀ (W : X.Opens) (hWU : W ≤ U) (hW : ∃ k : Fin m, W ≤ V k),
              π W hW (E.res hWU x) = 0 }
          zero_mem' := fun W hWU hW => by rw [map_zero, map_zero]
          add_mem' := fun {x₁ x₂} hx₁ hx₂ W hWU hW => by
            rw [map_add, map_add, hx₁ W hWU hW, hx₂ W hWU hW, add_zero]
          smul_mem' := fun r {x} hx W hWU hW => by
            rw [hResSmul hWU, LinearMap.map_smul, hx W hWU hW, smul_zero] }
    have hK_mem_sub : ∀ (U : X.Opens) (hU : ∃ k : Fin m, U ≤ V k) (x : E.sec U),
        x ∈ K_sub U ↔ π U hU x = 0 := by
      intro U hU x
      constructor
      · intro hx
        have h0 := hx U (le_refl U) hU
        rwa [E.res_id] at h0
      · intro hx W hWU hW
        rw [← hπ_res hU hW hWU x, hx, map_zero]
    let K : WeilPresheafModule X :=
      { sec := fun U => ↥(K_sub U)
        instAddCommGroup := fun U => inferInstance
        instModule := fun U => inferInstance
        res := fun {U W} hWU =>
          { toFun := fun x =>
              ⟨E.res hWU x.1, fun T hTW hT => by
                rw [E.res_comp]
                exact x.2 T (le_trans hTW hWU) hT⟩
            map_zero' := Subtype.ext (map_zero _)
            map_add' := fun x₁ x₂ => Subtype.ext (map_add _ _ _) }
        res_smul := fun {U W} h a x => Subtype.ext (hResSmul h a x.1)
        res_id := fun U x => Subtype.ext (E.res_id U x.1)
        res_comp := fun {U W T} h₁ h₂ x => Subtype.ext (E.res_comp h₁ h₂ x.1) }
    let ι : ∀ (U : X.Opens), (∃ k : Fin m, U ≤ V k) →
        K.sec U →ₗ[↑(X.presheaf.obj (Opposite.op U))] E.sec U :=
      fun U _ => (K_sub U).subtype
    have hSES : HasWeilSubChartShortExactSeq V K E G₀ := by
      refine ⟨ι, π, ?_, hπ_res, ?_⟩
      · intro U W hU hW hWU x
        rfl
      · intro U hAffU hU
        refine ⟨Subtype.val_injective, hπ_surj U hAffU hU, ?_⟩
        ext y
        rw [LinearMap.mem_ker, Submodule.range_subtype]
        exact (hK_mem_sub U hU y).symm
    have hCohK : IsWeilCoherentSubChartModule V K := by
      refine ⟨?_, ?_⟩
      · intro U hAffU ⟨k₀, hUk₀⟩
        have _ : IsNoetherianRing ↑(X.presheaf.obj (Opposite.op U)) := hNoeth U hAffU
        have _ : Module.Finite ↑(X.presheaf.obj (Opposite.op U))
            (Fin s → ↑(X.presheaf.obj (Opposite.op U))) := Module.Finite.pi
        have _ : Module.Finite ↑(X.presheaf.obj (Opposite.op U)) (E.sec U) :=
          Module.Finite.equiv (ev U k₀ hUk₀).symm
        have _ : IsNoetherian ↑(X.presheaf.obj (Opposite.op U)) (E.sec U) := inferInstance
        exact Module.Finite.iff_fg.mpr (IsNoetherian.noetherian (K_sub U))
      · intro U W hAffU hAffW hU hWU
        let A_U := ↑(X.presheaf.obj (Opposite.op U))
        let A_W := ↑(X.presheaf.obj (Opposite.op W))
        let _ : Algebra A_U A_W :=
          RingHom.toAlgebra (X.presheaf.map (CategoryTheory.homOfLE hWU).op).hom
        obtain ⟨k₀, hUk₀⟩ := hU
        have hWk₀ : W ≤ V k₀ := le_trans hWU hUk₀
        have hU' : ∃ k : Fin m, U ≤ V k := ⟨k₀, hUk₀⟩
        have hW' : ∃ k : Fin m, W ≤ V k := ⟨k₀, hWk₀⟩
        have _ : Module.Flat A_U A_W := by
          have hFlatId : (((𝟙 X : X ⟶ X).appLE U W hWU).hom).Flat :=
            (𝟙 X : X ⟶ X).flat_appLE hAffU hAffW hWU
          have hEq : (𝟙 X : X ⟶ X).appLE U W hWU =
              X.presheaf.map (CategoryTheory.homOfLE hWU).op := by
            simp [AlgebraicGeometry.Scheme.Hom.appLE]
            exact CategoryTheory.Category.id_comp _
          rw [hEq] at hFlatId
          exact RingHom.flat_algebraMap_iff.mp hFlatId
        let e_ev : TensorProduct A_U A_W (E.sec U) ≃ₗ[A_W] TensorProduct A_U A_W (Fin s → A_U) :=
          TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl A_W A_W) (ev U k₀ hUk₀)
        let e_pi : TensorProduct A_U A_W (Fin s → A_U) ≃ₗ[A_W]
            (Fin s → TensorProduct A_U A_W A_U) :=
          TensorProduct.piRight A_U A_W A_W (fun _ : Fin s => A_U)
        let e_rid : (Fin s → TensorProduct A_U A_W A_U) ≃ₗ[A_W] (Fin s → A_W) :=
          LinearEquiv.piCongrRight
            (fun _ : Fin s => TensorProduct.AlgebraTensorModule.rid A_U A_W A_W)
        let φ_E : TensorProduct A_U A_W (E.sec U) ≃ₗ[A_W] E.sec W :=
          ((e_ev.trans e_pi).trans e_rid).trans (ev W k₀ hWk₀).symm
        have hφ_E : ∀ (b : A_W) (y : E.sec U),
            φ_E (TensorProduct.tmul A_U b y) = b • E.res hWU y := by
          intro b y
          apply (ev W k₀ hWk₀).injective
          funext l
          have hlhs : ev W k₀ hWk₀ (φ_E (TensorProduct.tmul A_U b y)) l =
              (X.presheaf.map (CategoryTheory.homOfLE hWU).op).hom (ev U k₀ hUk₀ y l) * b := by
            change (ev W k₀ hWk₀
              ((ev W k₀ hWk₀).symm (e_rid (e_pi (e_ev (TensorProduct.tmul A_U b y)))))) l = _
            rw [LinearEquiv.apply_symm_apply]
            change TensorProduct.AlgebraTensorModule.rid A_U A_W A_W
              (e_pi (TensorProduct.tmul A_U b (ev U k₀ hUk₀ y)) l) = _
            rw [TensorProduct.piRight_apply, TensorProduct.piRightHom_tmul,
              TensorProduct.AlgebraTensorModule.rid_tmul]
            rfl
          have hrhs : ev W k₀ hWk₀ (b • E.res hWU y) l =
              b * (X.presheaf.map (CategoryTheory.homOfLE hWU).op).hom (ev U k₀ hUk₀ y l) := by
            rw [LinearEquiv.map_smul, Pi.smul_apply, smul_eq_mul, hEvRes k₀ hUk₀ hWU y l]
          rw [hlhs, hrhs, mul_comm]
        obtain ⟨φ_G, hφ_G⟩ := hCohG₀.2 U W hAffU hAffW hU' hWU
        let f_ι : TensorProduct A_U A_W (K.sec U) →ₗ[A_W] TensorProduct A_U A_W (E.sec U) :=
          TensorProduct.AlgebraTensorModule.lTensor A_W A_W (ι U hU')
        let f_π : TensorProduct A_U A_W (E.sec U) →ₗ[A_W] TensorProduct A_U A_W (G₀.sec U) :=
          TensorProduct.AlgebraTensorModule.lTensor A_W A_W (π U hU')
        have hf_ι_inj : Function.Injective f_ι := by
          change Function.Injective ⇑(TensorProduct.AlgebraTensorModule.lTensor A_W A_W (ι U hU'))
          rw [TensorProduct.AlgebraTensorModule.coe_lTensor]
          exact Module.Flat.lTensor_preserves_injective_linearMap (ι U hU') Subtype.val_injective
        have hex_U : Function.Exact (ι U hU') (π U hU') := by
          rw [LinearMap.exact_iff]
          ext y
          rw [LinearMap.mem_ker, Submodule.range_subtype]
          exact (hK_mem_sub U hU' y).symm
        have hex_W : LinearMap.ker f_π = LinearMap.range f_ι := by
          rw [← LinearMap.exact_iff]
          change Function.Exact ⇑(TensorProduct.AlgebraTensorModule.lTensor A_W A_W (ι U hU'))
            ⇑(TensorProduct.AlgebraTensorModule.lTensor A_W A_W (π U hU'))
          rw [TensorProduct.AlgebraTensorModule.coe_lTensor,
            TensorProduct.AlgebraTensorModule.coe_lTensor]
          exact Module.Flat.lTensor_exact A_W hex_U
        have h_comm_π : ∀ t : TensorProduct A_U A_W (E.sec U),
            π W hW' (φ_E t) = φ_G (f_π t) := by
          intro t
          induction t using TensorProduct.induction_on with
          | zero => simp
          | tmul b y =>
            change π W hW' (φ_E (TensorProduct.tmul A_U b y)) =
              φ_G (TensorProduct.tmul A_U b (π U hU' y))
            rw [hφ_E b y, LinearMap.map_smul, ← hπ_res hU' hW' hWU y, hφ_G b (π U hU' y)]
          | add t₁ t₂ ht₁ ht₂ =>
            rw [map_add, map_add, map_add, map_add, ht₁, ht₂]
        let ψ_raw : TensorProduct A_U A_W (K.sec U) →ₗ[A_W] E.sec W :=
          φ_E.toLinearMap.comp f_ι
        have hψ_mem : ∀ z : TensorProduct A_U A_W (K.sec U), ψ_raw z ∈ K_sub W := by
          intro z
          rw [hK_mem_sub W hW']
          change π W hW' (φ_E (f_ι z)) = 0
          have hz_ker : f_ι z ∈ LinearMap.ker f_π := by
            rw [hex_W]
            exact ⟨z, rfl⟩
          rw [h_comm_π (f_ι z), LinearMap.mem_ker.mp hz_ker, map_zero]
        let ψ_cod : TensorProduct A_U A_W (K.sec U) →ₗ[A_W] K.sec W :=
          ψ_raw.codRestrict (K_sub W) hψ_mem
        have hψ_inj : Function.Injective ψ_cod := by
          intro z₁ z₂ hz
          have hz' : φ_E (f_ι z₁) = φ_E (f_ι z₂) := congrArg Subtype.val hz
          exact hf_ι_inj (φ_E.injective hz')
        have hψ_surj : Function.Surjective ψ_cod := by
          intro y
          let t : TensorProduct A_U A_W (E.sec U) := φ_E.symm y.1
          have ht_ker : t ∈ LinearMap.ker f_π := by
            rw [LinearMap.mem_ker]
            apply φ_G.injective
            rw [map_zero, ← h_comm_π t, φ_E.apply_symm_apply]
            exact (hK_mem_sub W hW' y.1).mp y.2
          rw [hex_W, LinearMap.mem_range] at ht_ker
          obtain ⟨z, hz⟩ := ht_ker
          refine ⟨z, Subtype.ext ?_⟩
          change φ_E (f_ι z) = y.1
          rw [hz, φ_E.apply_symm_apply]
        let φ_K : TensorProduct A_U A_W (K.sec U) ≃ₗ[A_W] K.sec W :=
          LinearEquiv.ofBijective ψ_cod ⟨hψ_inj, hψ_surj⟩
        refine ⟨φ_K, fun b x => Subtype.ext ?_⟩
        change φ_E (TensorProduct.tmul A_U b x.1) = b • E.res hWU x.1
        exact hφ_E b x.1
    exact ⟨K, E, ev, hEvRes, hEvTwist, hCohK, hSES⟩
  dsimp only
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let P_B : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
  let W_std : Fin (N + 1) → P_B.Opens :=
    fun k => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X k)
  let u : ∀ j k : Fin (N + 1), ↑(P_B.presheaf.obj (Opposite.op (W_std j ⊓ W_std k))) :=
    fun j k =>
      (P_B.presheaf.map (CategoryTheory.homOfLE
        (le_of_eq (AlgebraicGeometry.Proj.basicOpen_mul 𝒜
          (MvPolynomial.X j) (MvPolynomial.X k)).symm)).op).hom
        (weilProjTransitionElem B N j k)
  intro hCohG
  have hj : ∀ k : Fin (N + 1), MvPolynomial.X k ∈ 𝒜 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X k)).mpr
      (MvPolynomial.isHomogeneous_X B k)
  have hSep : P_B.IsSeparated := inferInstance
  have hAffW : ∀ k : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (W_std k) := fun k =>
    AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X k) (hj k) Nat.zero_lt_one
  have hNoeth : ∀ U : P_B.Opens, AlgebraicGeometry.IsAffineOpen U →
      IsNoetherianRing ↑(P_B.presheaf.obj (Opposite.op U)) := by
    have hAlgFT : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) B) := by
      classical
      let sX : Finset (MvPolynomial (Fin (N + 1)) B) := Finset.univ.image MvPolynomial.X
      let S_sub : Subalgebra ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) B) := Algebra.adjoin ↥(𝒜 0) ↑sX
      have h_all : ∀ p : MvPolynomial (Fin (N + 1)) B, p ∈ S_sub := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C c =>
          have hc : MvPolynomial.C c ∈ 𝒜 0 := MvPolynomial.isHomogeneous_C (Fin (N + 1)) c
          exact S_sub.algebraMap_mem ⟨MvPolynomial.C c, hc⟩
        | add p q hp hq => exact S_sub.add_mem hp hq
        | mul_X p i hp =>
          exact S_sub.mul_mem hp
            (Algebra.subset_adjoin
              (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_univ i))))
      refine ⟨⟨sX, eq_top_iff.mpr fun p _ => h_all p⟩⟩
    have hC_surj : Function.Surjective (algebraMap B ↥(𝒜 0)) := by
      intro y
      refine ⟨MvPolynomial.constantCoeff y.1, Subtype.ext ?_⟩
      have hy0 : y.1.IsHomogeneous 0 := y.2
      have hy_eq : MvPolynomial.C (MvPolynomial.constantCoeff y.1) = y.1 := by
        ext m
        rw [MvPolynomial.coeff_C]
        split_ifs with hm
        · subst hm; rfl
        · symm
          by_contra hne
          have hdeg := hy0 hne
          simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, Pi.one_apply, mul_one] at hdeg
          apply hm
          symm
          ext i
          by_cases hi : i ∈ m.support
          · exact Nat.eq_zero_of_le_zero
              (hdeg ▸ Finset.single_le_sum (fun _ _ => Nat.zero_le _) hi)
          · exact Finsupp.notMem_support_iff.mp hi
      change (algebraMap B ↥(𝒜 0) (MvPolynomial.constantCoeff y.1)).1 = y.1
      rw [Algebra.algebraMap_eq_smul_one]
      change (MvPolynomial.constantCoeff y.1) • (1 : MvPolynomial (Fin (N + 1)) B) = y.1
      rw [Algebra.smul_def, mul_one]
      exact hy_eq
    have hFT_map : (algebraMap B ↥(𝒜 0)).FiniteType :=
      RingHom.FiniteType.of_surjective _ hC_surj
    have hLftSpec : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B ↥(𝒜 0)))) :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr hFT_map
    have hLftProj : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      inferInstance
    let π_B : P_B ⟶ AlgebraicGeometry.Spec (CommRingCat.of B) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B ↥(𝒜 0)))
    have _ : AlgebraicGeometry.LocallyOfFiniteType π_B :=
      CategoryTheory.MorphismProperty.comp_mem _ _ _ hLftProj hLftSpec
    have _ : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Spec (CommRingCat.of B)) :=
      AlgebraicGeometry.isLocallyNoetherian_Spec.mpr ‹IsNoetherianRing B›
    have _ : AlgebraicGeometry.IsLocallyNoetherian P_B :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian π_B
    exact fun U hU => AlgebraicGeometry.IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  obtain ⟨t, hU1, hU2, hU3, hT1, hT2, hT3, hLoc1, hLoc2⟩ :=
    hAbstractGraded 𝒜 N MvPolynomial.X hj (weilProjTransitionElem B N) (fun _ _ => rfl)
  obtain ⟨D, s, m_hat, hCoc, hSpan⟩ :=
    hAbstractLift P_B hSep (N + 1) W_std hAffW u t hU1 hU2 hU3 hT1 hT2 hT3 hLoc1 hLoc2 G hCohG
  obtain ⟨K, E, ev, hEvRes, hEvTwist, hCohK, hSES⟩ :=
    hAbstractExact P_B (N + 1) W_std hAffW hNoeth u hU1 hU2 hU3 G hCohG D s m_hat hCoc hSpan
  refine ⟨D, s, K, E, ⟨ev, hEvRes, ?_⟩, hCohK, hSES⟩
  intro U j k hUj hUk x l
  dsimp only
  have hUjk : U ≤ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X j * MvPolynomial.X k) :=
    le_trans (le_inf hUj hUk)
      (le_of_eq (AlgebraicGeometry.Proj.basicOpen_mul 𝒜 (MvPolynomial.X j) (MvPolynomial.X k)).symm)
  have hMapEq : (P_B.presheaf.map (CategoryTheory.homOfLE (le_inf hUj hUk)).op).hom (u j k) =
      (P_B.presheaf.map (CategoryTheory.homOfLE hUjk).op).hom
        (weilProjTransitionElem B N j k) := by
    have hHom : (CategoryTheory.homOfLE
          (le_of_eq (AlgebraicGeometry.Proj.basicOpen_mul 𝒜
            (MvPolynomial.X j) (MvPolynomial.X k)).symm)).op ≫
        (CategoryTheory.homOfLE (le_inf hUj hUk)).op =
        (CategoryTheory.homOfLE hUjk).op := by
      rw [← op_comp, CategoryTheory.homOfLE_comp]
    have hMap := congrArg (fun f => f.hom (weilProjTransitionElem B N j k))
      (P_B.presheaf.map_comp
        (CategoryTheory.homOfLE
          (le_of_eq (AlgebraicGeometry.Proj.basicOpen_mul 𝒜
            (MvPolynomial.X j) (MvPolynomial.X k)).symm)).op
        (CategoryTheory.homOfLE (le_inf hUj hUk)).op)
    rw [hHom, CommRingCat.hom_comp, RingHom.comp_apply] at hMap
    exact hMap.symm
  rw [hEvTwist U j k hUj hUk x l, hMapEq]

theorem weil_serre_proj_coherent_cech_cohomology_finite (B : Type u) [CommRing B] [IsNoetherianRing B]
    (N : ℕ)
    (G : WeilPresheafModule
      (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) :=
         MvPolynomial.gradedAlgebra
       AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B))) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) :=
      MvPolynomial.gradedAlgebra
    let W_std : Fin (N + 1) →
        (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B)).Opens :=
      fun k => AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) (MvPolynomial.X k)
    let π_B : AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B) :=
      AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap B ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B 0)))
    IsWeilCoherentSubChartModule W_std G →
    HasFiniteWeilModuleCechCohomology π_B W_std G :=
by
  dsimp only
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let P_B : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
  let W_std : Fin (N + 1) → P_B.Opens :=
    fun k => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X k)
  let π_B : P_B ⟶ AlgebraicGeometry.Spec (CommRingCat.of B) :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B ↥(𝒜 0)))
  intro hCohG
  have hAffW : ∀ k : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (W_std k) := fun k =>
    AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X k)
      ((MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X k)).mpr
        (MvPolynomial.isHomogeneous_X B k))
      Nat.zero_lt_one
  have hAffInter : ∀ {p : ℕ} (α : WeilStrictMonoTuple (N + 1) p),
      AlgebraicGeometry.IsAffineOpen (weilCoverChartInter W_std α) := by
    intro p α
    exact Finset.inf'_induction
      (p := fun U : P_B.Opens => AlgebraicGeometry.IsAffineOpen U)
      ⟨0, Finset.mem_univ (0 : Fin (p + 1))⟩
      (fun l => W_std (α.1 l))
      (fun _ h₁ _ h₂ => AlgebraicGeometry.IsAffineOpen.inf h₁ h₂)
      (fun l _ => hAffW (α.1 l))
  have hSubInter : ∀ {p : ℕ} (α : WeilStrictMonoTuple (N + 1) p),
      ∃ k : Fin (N + 1), weilCoverChartInter W_std α ≤ W_std k := fun α =>
    ⟨α.1 0, Finset.inf'_le _ (Finset.mem_univ (0 : Fin (_ + 1)))⟩
  let σ_B : ∀ U : P_B.Opens, B →+* ↑(P_B.presheaf.obj (Opposite.op U)) := fun U =>
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
      π_B.appLE ⊤ U (fun _ _ => trivial)).hom
  have hσ_map : ∀ {U W : P_B.Opens} (hWU : W ≤ U) (r : B),
      (P_B.presheaf.map (CategoryTheory.homOfLE hWU).op).hom (σ_B U r) = σ_B W r := by
    intro U W hWU r
    have hmap : π_B.appLE ⊤ U (fun _ _ => trivial) ≫
        P_B.presheaf.map (CategoryTheory.homOfLE hWU).op =
      π_B.appLE ⊤ W (fun _ _ => trivial) :=
      AlgebraicGeometry.Scheme.Hom.appLE_map π_B (le_top : U ≤ (TopologicalSpace.Opens.map π_B.base).obj ⊤)
        (CategoryTheory.homOfLE hWU).op
    have hcomp : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
          π_B.appLE ⊤ U (fun _ _ => trivial)) ≫
        P_B.presheaf.map (CategoryTheory.homOfLE hWU).op =
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
        π_B.appLE ⊤ W (fun _ _ => trivial) := by
      rw [CategoryTheory.Category.assoc, hmap]
    exact congrArg (fun f => f.hom r) hcomp
  let instSMulCoch : ∀ (F : WeilPresheafModule P_B) (p : ℕ),
      SMul B (WeilModuleCechCochain W_std F p) :=
    fun F p => ⟨weilModuleCechSmul π_B W_std F p⟩
  let instModCoch : ∀ (F : WeilPresheafModule P_B) (p : ℕ),
      Module B (WeilModuleCechCochain W_std F p) := fun F p =>
    { toSMul := instSMulCoch F p
      one_smul := fun c => funext fun α => by
        show σ_B (weilCoverChartInter W_std α) 1 • c α = c α
        rw [map_one, one_smul]
      mul_smul := fun r₁ r₂ c => funext fun α => by
        show σ_B (weilCoverChartInter W_std α) (r₁ * r₂) • c α =
          σ_B (weilCoverChartInter W_std α) r₁ • (σ_B (weilCoverChartInter W_std α) r₂ • c α)
        rw [map_mul, mul_smul]
      smul_zero := fun r => funext fun α => by
        show σ_B (weilCoverChartInter W_std α) r • (0 : F.sec (weilCoverChartInter W_std α)) = 0
        exact smul_zero _
      smul_add := fun r c₁ c₂ => funext fun α => by
        show σ_B (weilCoverChartInter W_std α) r • (c₁ α + c₂ α) =
          σ_B (weilCoverChartInter W_std α) r • c₁ α + σ_B (weilCoverChartInter W_std α) r • c₂ α
        exact smul_add _ _ _
      add_smul := fun r₁ r₂ c => funext fun α => by
        show σ_B (weilCoverChartInter W_std α) (r₁ + r₂) • c α =
          σ_B (weilCoverChartInter W_std α) r₁ • c α + σ_B (weilCoverChartInter W_std α) r₂ • c α
        rw [map_add, add_smul]
      zero_smul := fun c => funext fun α => by
        show σ_B (weilCoverChartInter W_std α) 0 • c α = 0
        rw [map_zero, zero_smul] }
  let dLin : ∀ (F : WeilPresheafModule P_B) (p : ℕ),
      WeilModuleCechCochain W_std F p →ₗ[B] WeilModuleCechCochain W_std F (p + 1) := fun F p =>
    { toFun := weilModuleCechDiff W_std F p
      map_add' := fun c₁ c₂ => funext fun β => by
        simp only [weilModuleCechDiff, Pi.add_apply, map_add, smul_add, Finset.sum_add_distrib]
      map_smul' := fun r c => funext fun β => by
        let face : Fin (p + 2) → WeilStrictMonoTuple (N + 1) p :=
          fun j => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
        let hFace : ∀ j : Fin (p + 2),
            weilCoverChartInter W_std β ≤ weilCoverChartInter W_std (face j) :=
          fun j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
        change ∑ j : Fin (p + 2),
            ((-1 : ℤ) ^ (j : ℕ)) • F.res (hFace j) (σ_B (weilCoverChartInter W_std (face j)) r • c (face j)) =
          σ_B (weilCoverChartInter W_std β) r •
            ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • F.res (hFace j) (c (face j))
        rw [Finset.smul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        have hres : F.res (hFace j) (σ_B (weilCoverChartInter W_std (face j)) r • c (face j)) =
            ((P_B.presheaf.map (CategoryTheory.homOfLE (hFace j)).op).hom
              (σ_B (weilCoverChartInter W_std (face j)) r)) •
            F.res (hFace j) (c (face j)) :=
          F.res_smul (hFace j) (σ_B (weilCoverChartInter W_std (face j)) r) (c (face j))
        rw [hres, hσ_map (hFace j) r, smul_comm] }
  have hd_sq : ∀ (F : WeilPresheafModule P_B) (p : ℕ) (c : WeilModuleCechCochain W_std F p),
      dLin F (p + 1) (dLin F p c) = 0 := by
    intro F p c
    funext γ
    let face1 : Fin (p + 3) → WeilStrictMonoTuple (N + 1) (p + 1) :=
      fun i => ⟨fun k => γ.1 (i.succAbove k), γ.2.comp (Fin.strictMono_succAbove i)⟩
    let hFace1 : ∀ i : Fin (p + 3),
        weilCoverChartInter W_std γ ≤ weilCoverChartInter W_std (face1 i) :=
      fun i => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (i.succAbove k)))
    let face2 : Fin (p + 3) → Fin (p + 2) → WeilStrictMonoTuple (N + 1) p :=
      fun i j => ⟨fun k => (face1 i).1 (j.succAbove k), (face1 i).2.comp (Fin.strictMono_succAbove j)⟩
    let hFace12 : ∀ (i : Fin (p + 3)) (j : Fin (p + 2)),
        weilCoverChartInter W_std (face1 i) ≤ weilCoverChartInter W_std (face2 i j) :=
      fun i j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
    let hFace2 : ∀ (i : Fin (p + 3)) (j : Fin (p + 2)),
        weilCoverChartInter W_std γ ≤ weilCoverChartInter W_std (face2 i j) :=
      fun i j => le_trans (hFace1 i) (hFace12 i j)
    let term : Fin (p + 3) × Fin (p + 2) → F.sec (weilCoverChartInter W_std γ) :=
      fun x => (((-1 : ℤ) ^ (x.1 : ℕ)) * ((-1 : ℤ) ^ (x.2 : ℕ))) •
        F.res (hFace2 x.1 x.2) (c (face2 x.1 x.2))
    change (∑ i : Fin (p + 3), ((-1 : ℤ) ^ (i : ℕ)) • F.res (hFace1 i)
        (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • F.res (hFace12 i j) (c (face2 i j)))) = 0
    have h_expand : (∑ i : Fin (p + 3), ((-1 : ℤ) ^ (i : ℕ)) • F.res (hFace1 i)
        (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • F.res (hFace12 i j) (c (face2 i j)))) =
        ∑ x : Fin (p + 3) × Fin (p + 2), term x := by
      rw [Fintype.sum_prod_type]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_sum, Finset.smul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_zsmul, F.res_comp, ← mul_smul]
    rw [h_expand]
    have h_res_congr : ∀ {α₁ α₂ : WeilStrictMonoTuple (N + 1) p} (hα : α₁ = α₂)
        (h₁ : weilCoverChartInter W_std γ ≤ weilCoverChartInter W_std α₁)
        (h₂ : weilCoverChartInter W_std γ ≤ weilCoverChartInter W_std α₂),
        F.res h₁ (c α₁) = F.res h₂ (c α₂) := by
      intro α₁ α₂ hα h₁ h₂
      subst hα
      rfl
    let P_lt : Fin (p + 3) × Fin (p + 2) → Prop := fun x => (x.2 : ℕ) < (x.1 : ℕ)
    classical
    rw [← Finset.sum_filter_add_sum_filter_not Finset.univ P_lt]
    have h_bij : ∑ x ∈ Finset.univ.filter P_lt, term x =
        ∑ y ∈ Finset.univ.filter (fun y => ¬P_lt y), (-term y) := by
      refine Finset.sum_bij
        (fun x hx => (x.2.castSucc, ⟨(x.1 : ℕ) - 1, by
          have hx' : (x.2 : ℕ) < (x.1 : ℕ) := (Finset.mem_filter.mp hx).2
          omega⟩))
        (fun x hx => by
          have hx' : (x.2 : ℕ) < (x.1 : ℕ) := (Finset.mem_filter.mp hx).2
          rw [Finset.mem_filter]
          refine ⟨Finset.mem_univ _, ?_⟩
          show ¬((x.1 : ℕ) - 1 < (x.2.castSucc : ℕ))
          simp only [Fin.val_castSucc]
          omega)
        (fun x₁ hx₁ x₂ hx₂ h_eq => by
          have hx₁' : (x₁.2 : ℕ) < (x₁.1 : ℕ) := (Finset.mem_filter.mp hx₁).2
          have hx₂' : (x₂.2 : ℕ) < (x₂.1 : ℕ) := (Finset.mem_filter.mp hx₂).2
          have h1 := congrArg (fun z : Fin (p + 3) × Fin (p + 2) => (z.1 : ℕ)) h_eq
          have h2 := congrArg (fun z : Fin (p + 3) × Fin (p + 2) => (z.2 : ℕ)) h_eq
          simp only [Fin.val_castSucc] at h1 h2
          ext
          · omega
          · exact h1)
        (fun y hy => by
          have hy' : ¬(y.2 : ℕ) < (y.1 : ℕ) := (Finset.mem_filter.mp hy).2
          refine ⟨(y.2.succ, ⟨(y.1 : ℕ), by have := y.2.isLt; omega⟩), ?_, ?_⟩
          · rw [Finset.mem_filter]
            refine ⟨Finset.mem_univ _, ?_⟩
            show (y.1 : ℕ) < (y.2.succ : ℕ)
            simp only [Fin.val_succ]
            omega
          · ext <;> simp)
        (fun x hx => by
          have hx' : (x.2 : ℕ) < (x.1 : ℕ) := (Finset.mem_filter.mp hx).2
          let i' : Fin (p + 2) := ⟨(x.1 : ℕ) - 1, by omega⟩
          have h_sa : ∀ {n : ℕ} (a : Fin (n + 1)) (b : Fin n),
              (a.succAbove b : ℕ) = if (b : ℕ) < (a : ℕ) then (b : ℕ) else (b : ℕ) + 1 := by
            intro n a b
            simp only [Fin.succAbove, Fin.lt_def, Fin.val_castSucc]
            split_ifs <;> rfl
          have h_face : face2 x.1 x.2 = face2 x.2.castSucc i' := by
            apply Subtype.ext
            funext k
            apply congrArg γ.1
            apply Fin.ext
            rw [h_sa, h_sa, h_sa, h_sa]
            simp only [Fin.val_castSucc, i']
            by_cases hk1 : (k : ℕ) < (x.2 : ℕ) <;>
              by_cases hk2 : (k : ℕ) < (x.1 : ℕ) - 1 <;>
              simp only [hk1, hk2, ↓reduceIte] <;>
              split_ifs <;> omega
          show (((-1 : ℤ) ^ (x.1 : ℕ)) * ((-1 : ℤ) ^ (x.2 : ℕ))) •
              F.res (hFace2 x.1 x.2) (c (face2 x.1 x.2)) =
            -(((( -1 : ℤ) ^ (x.2.castSucc : ℕ)) * ((-1 : ℤ) ^ (i' : ℕ))) •
              F.res (hFace2 x.2.castSucc i') (c (face2 x.2.castSucc i')))
          rw [h_res_congr h_face (hFace2 x.1 x.2) (hFace2 x.2.castSucc i')]
          have hi_val : (x.1 : ℕ) = (i' : ℕ) + 1 := by simp only [i']; omega
          have h_sign : ((-1 : ℤ) ^ (x.1 : ℕ)) * ((-1 : ℤ) ^ (x.2 : ℕ)) =
              -(((-1 : ℤ) ^ (x.2.castSucc : ℕ)) * ((-1 : ℤ) ^ (i' : ℕ))) := by
            rw [hi_val, Fin.val_castSucc, pow_succ]
            ring
          rw [h_sign, neg_smul])
    rw [h_bij, Finset.sum_neg_distrib, neg_add_cancel]
  let B_sub : ∀ (F : WeilPresheafModule P_B) (q : ℕ),
      Submodule B ↥(LinearMap.ker (dLin F q)) := fun F q =>
    match q with
    | 0 => ⊥
    | p + 1 => (LinearMap.range (dLin F p)).comap (LinearMap.ker (dLin F (p + 1))).subtype
  let H_cech : ∀ (F : WeilPresheafModule P_B) (q : ℕ), Type u :=
    fun F q => ↥(LinearMap.ker (dLin F q)) ⧸ B_sub F q
  have hFinToH : ∀ (E : WeilPresheafModule P_B),
      HasFiniteWeilModuleCechCohomology π_B W_std E →
      ∀ q : ℕ, Module.Finite B (H_cech E q) := by
    intro E ⟨⟨k₀, gen₀, hgen₀_ker, hgen₀_span⟩, hSucc⟩ q
    cases q with
    | zero =>
      let gen₀_sub : Fin k₀ → ↥(LinearMap.ker (dLin E 0)) := fun j =>
        ⟨gen₀ j, hgen₀_ker j⟩
      let φ₀ : (Fin k₀ → B) →ₗ[B] ↥(LinearMap.ker (dLin E 0)) :=
        { toFun := fun c => ∑ j : Fin k₀, c j • gen₀_sub j
          map_add' := fun c₁ c₂ => by simp [add_smul, Finset.sum_add_distrib]
          map_smul' := fun r c => by simp [mul_smul, Finset.smul_sum] }
      have hFinKer0 : Module.Finite B ↥(LinearMap.ker (dLin E 0)) := by
        apply Module.Finite.of_surjective φ₀
        intro z
        obtain ⟨c, hc⟩ := hgen₀_span z.1 z.2
        refine ⟨c, Subtype.ext ?_⟩
        change (∑ j : Fin k₀, c j • gen₀_sub j).1 = z.1
        rw [AddSubmonoidClass.coe_finsetSum, hc]
        rfl
      exact Module.Finite.quotient B (B_sub E 0)
    | succ p =>
      obtain ⟨k, gen, hgen_ker, hgen_span⟩ := hSucc p
      let gen_sub : Fin k → ↥(LinearMap.ker (dLin E (p + 1))) := fun j =>
        ⟨gen j, hgen_ker j⟩
      let gen_q : Fin k → H_cech E (p + 1) := fun j =>
        Submodule.mkQ (B_sub E (p + 1)) (gen_sub j)
      let φ_p : (Fin k → B) →ₗ[B] H_cech E (p + 1) :=
        { toFun := fun c => ∑ j : Fin k, c j • gen_q j
          map_add' := fun c₁ c₂ => by simp [add_smul, Finset.sum_add_distrib]
          map_smul' := fun r c => by simp [mul_smul, Finset.smul_sum] }
      apply Module.Finite.of_surjective φ_p
      intro q_el
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (B_sub E (p + 1)) q_el
      obtain ⟨c, b, hzb⟩ := hgen_span z.1 z.2
      refine ⟨c, ?_⟩
      have hφ_eq : φ_p c = Submodule.mkQ (B_sub E (p + 1)) (∑ j : Fin k, c j • gen_sub j) := by
        change ∑ j : Fin k, c j • Submodule.mkQ (B_sub E (p + 1)) (gen_sub j) =
          Submodule.mkQ (B_sub E (p + 1)) (∑ j : Fin k, c j • gen_sub j)
        rw [map_sum]
        exact Finset.sum_congr rfl fun j _ =>
          (LinearMap.map_smul (Submodule.mkQ (B_sub E (p + 1))) (c j) (gen_sub j)).symm
      rw [hφ_eq]
      change Submodule.Quotient.mk (∑ j : Fin k, c j • gen_sub j) = Submodule.Quotient.mk z
      rw [Submodule.Quotient.eq, Submodule.mem_comap, LinearMap.mem_range]
      refine ⟨-b, ?_⟩
      change weilModuleCechDiff W_std E p (-b) = (∑ j : Fin k, c j • gen_sub j).1 - z.1
      have hneg : weilModuleCechDiff W_std E p (-b) = -weilModuleCechDiff W_std E p b :=
        map_neg (dLin E p) b
      rw [hneg, AddSubmonoidClass.coe_finsetSum, hzb]
      change -weilModuleCechDiff W_std E p b =
        (∑ j : Fin k, weilModuleCechSmul π_B W_std E (p + 1) (c j) (gen j)) -
          ((∑ j : Fin k, weilModuleCechSmul π_B W_std E (p + 1) (c j) (gen j)) +
            weilModuleCechDiff W_std E p b)
      abel
  have hStep : ∀ (K E F : WeilPresheafModule P_B),
      HasWeilSubChartShortExactSeq W_std K E F →
      ∀ (q : ℕ),
        Module.Finite B (H_cech E q) →
        Module.Finite B (H_cech K (q + 1)) →
        Module.Finite B (H_cech F q) := by
    intro K E F ⟨ι, π_map, hι_res, hπ_res, hExact⟩ q hFinE hFinK
    let iCoch : ∀ p : ℕ, WeilModuleCechCochain W_std K p →ₗ[B] WeilModuleCechCochain W_std E p :=
      fun p =>
        { toFun := fun x α => ι (weilCoverChartInter W_std α) (hSubInter α) (x α)
          map_add' := fun x₁ x₂ => funext fun α => map_add _ _ _
          map_smul' := fun r x => funext fun α =>
            LinearMap.map_smul (ι (weilCoverChartInter W_std α) (hSubInter α))
              (σ_B (weilCoverChartInter W_std α) r) (x α) }
    let pCoch : ∀ p : ℕ, WeilModuleCechCochain W_std E p →ₗ[B] WeilModuleCechCochain W_std F p :=
      fun p =>
        { toFun := fun y α => π_map (weilCoverChartInter W_std α) (hSubInter α) (y α)
          map_add' := fun y₁ y₂ => funext fun α => map_add _ _ _
          map_smul' := fun r y => funext fun α =>
            LinearMap.map_smul (π_map (weilCoverChartInter W_std α) (hSubInter α))
              (σ_B (weilCoverChartInter W_std α) r) (y α) }
    have hi_inj : ∀ p : ℕ, Function.Injective (iCoch p) := by
      intro p x₁ x₂ hx
      funext α
      exact (hExact _ (hAffInter α) (hSubInter α)).1 (congrFun hx α)
    have hp_surj : ∀ p : ℕ, Function.Surjective (pCoch p) := by
      intro p z
      refine ⟨fun α => Classical.choose ((hExact _ (hAffInter α) (hSubInter α)).2.1 (z α)), ?_⟩
      funext α
      exact Classical.choose_spec ((hExact _ (hAffInter α) (hSubInter α)).2.1 (z α))
    have hker_eq : ∀ p : ℕ, LinearMap.ker (pCoch p) = LinearMap.range (iCoch p) := by
      intro p
      ext y
      simp only [LinearMap.mem_ker, LinearMap.mem_range]
      constructor
      · intro hy
        have hy_α : ∀ α : WeilStrictMonoTuple (N + 1) p,
            ∃ x_α, ι (weilCoverChartInter W_std α) (hSubInter α) x_α = y α := by
          intro α
          have hmem : y α ∈ LinearMap.ker (π_map (weilCoverChartInter W_std α) (hSubInter α)) :=
            congrFun hy α
          rw [(hExact _ (hAffInter α) (hSubInter α)).2.2] at hmem
          exact hmem
        exact ⟨fun α => Classical.choose (hy_α α), funext fun α => Classical.choose_spec (hy_α α)⟩
      · rintro ⟨x, rfl⟩
        funext α
        have hmem : ι (weilCoverChartInter W_std α) (hSubInter α) (x α) ∈
            LinearMap.range (ι (weilCoverChartInter W_std α) (hSubInter α)) := ⟨x α, rfl⟩
        rw [← (hExact _ (hAffInter α) (hSubInter α)).2.2] at hmem
        exact hmem
    have hi_comm : ∀ (p : ℕ) (x : WeilModuleCechCochain W_std K p),
        dLin E p (iCoch p x) = iCoch (p + 1) (dLin K p x) := by
      intro p x
      funext β
      let face : Fin (p + 2) → WeilStrictMonoTuple (N + 1) p :=
        fun j => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
      let hFace : ∀ j : Fin (p + 2),
          weilCoverChartInter W_std β ≤ weilCoverChartInter W_std (face j) :=
        fun j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
      change (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • E.res (hFace j) (iCoch p x (face j))) =
        ι (weilCoverChartInter W_std β) (hSubInter β)
          (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • K.res (hFace j) (x (face j)))
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_zsmul]
      exact congrArg (((-1 : ℤ) ^ (j : ℕ)) • ·)
        (hι_res (hSubInter (face j)) (hSubInter β) (hFace j) (x (face j)))
    have hp_comm : ∀ (p : ℕ) (y : WeilModuleCechCochain W_std E p),
        dLin F p (pCoch p y) = pCoch (p + 1) (dLin E p y) := by
      intro p y
      funext β
      let face : Fin (p + 2) → WeilStrictMonoTuple (N + 1) p :=
        fun j => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
      let hFace : ∀ j : Fin (p + 2),
          weilCoverChartInter W_std β ≤ weilCoverChartInter W_std (face j) :=
        fun j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
      change (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • F.res (hFace j) (pCoch p y (face j))) =
        π_map (weilCoverChartInter W_std β) (hSubInter β)
          (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • E.res (hFace j) (y (face j)))
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_zsmul]
      exact congrArg (((-1 : ℤ) ^ (j : ℕ)) • ·)
        (hπ_res (hSubInter (face j)) (hSubInter β) (hFace j) (y (face j)))
    have hLiftWitness : ∀ z : ↥(LinearMap.ker (dLin F q)),
        ∃ (e : WeilModuleCechCochain W_std E q) (w : ↥(LinearMap.ker (dLin K (q + 1)))),
          pCoch q e = z.1 ∧ iCoch (q + 1) w.1 = dLin E q e := by
      intro z
      obtain ⟨e, he⟩ := hp_surj q z.1
      have hde_ker : dLin E q e ∈ LinearMap.ker (pCoch (q + 1)) := by
        rw [LinearMap.mem_ker, ← hp_comm q e, he]
        exact z.2
      rw [hker_eq (q + 1), LinearMap.mem_range] at hde_ker
      obtain ⟨w, hw⟩ := hde_ker
      have hw_ker : w ∈ LinearMap.ker (dLin K (q + 1)) := by
        rw [LinearMap.mem_ker]
        apply hi_inj (q + 2)
        rw [map_zero, ← hi_comm (q + 1) w, hw, hd_sq E q e]
      exact ⟨e, ⟨w, hw_ker⟩, he, hw⟩
    have hWitnessUniq : ∀ (z : ↥(LinearMap.ker (dLin F q)))
        (e₁ e₂ : WeilModuleCechCochain W_std E q)
        (w₁ w₂ : ↥(LinearMap.ker (dLin K (q + 1)))),
        pCoch q e₁ = z.1 → iCoch (q + 1) w₁.1 = dLin E q e₁ →
        pCoch q e₂ = z.1 → iCoch (q + 1) w₂.1 = dLin E q e₂ →
        (Submodule.Quotient.mk w₁ : H_cech K (q + 1)) = Submodule.Quotient.mk w₂ := by
      intro z e₁ e₂ w₁ w₂ he₁ hw₁ he₂ hw₂
      rw [Submodule.Quotient.eq]
      change w₁ - w₂ ∈ (LinearMap.range (dLin K q)).comap (LinearMap.ker (dLin K (q + 1))).subtype
      rw [Submodule.mem_comap, LinearMap.mem_range]
      have hdiff : e₁ - e₂ ∈ LinearMap.ker (pCoch q) := by
        rw [LinearMap.mem_ker, map_sub, he₁, he₂, sub_self]
      rw [hker_eq q, LinearMap.mem_range] at hdiff
      obtain ⟨u, hu⟩ := hdiff
      refine ⟨u, ?_⟩
      apply hi_inj (q + 1)
      calc iCoch (q + 1) (dLin K q u)
          = dLin E q (iCoch q u) := (hi_comm q u).symm
        _ = dLin E q (e₁ - e₂) := by rw [hu]
        _ = iCoch (q + 1) (w₁.1 - w₂.1) := by rw [map_sub, ← hw₁, ← hw₂, map_sub]
    let δ_fun : ↥(LinearMap.ker (dLin F q)) → H_cech K (q + 1) := fun z =>
      Submodule.Quotient.mk (Classical.choose (Classical.choose_spec (hLiftWitness z)))
    have hδ_spec : ∀ (z : ↥(LinearMap.ker (dLin F q)))
        (e : WeilModuleCechCochain W_std E q) (w : ↥(LinearMap.ker (dLin K (q + 1)))),
        pCoch q e = z.1 → iCoch (q + 1) w.1 = dLin E q e →
        δ_fun z = Submodule.Quotient.mk w := by
      intro z e w he hw
      let e₀ := Classical.choose (hLiftWitness z)
      let w₀ := Classical.choose (Classical.choose_spec (hLiftWitness z))
      obtain ⟨he₀, hw₀⟩ := Classical.choose_spec (Classical.choose_spec (hLiftWitness z))
      exact hWitnessUniq z e₀ e w₀ w he₀ hw₀ he hw
    let δ_raw : ↥(LinearMap.ker (dLin F q)) →ₗ[B] H_cech K (q + 1) :=
      { toFun := δ_fun
        map_add' := fun z₁ z₂ => by
          obtain ⟨e₁, w₁, he₁, hw₁⟩ := hLiftWitness z₁
          obtain ⟨e₂, w₂, he₂, hw₂⟩ := hLiftWitness z₂
          rw [hδ_spec z₁ e₁ w₁ he₁ hw₁, hδ_spec z₂ e₂ w₂ he₂ hw₂,
            hδ_spec (z₁ + z₂) (e₁ + e₂) (w₁ + w₂) (by rw [map_add, he₁, he₂]; rfl)
              (by rw [Submodule.coe_add, map_add, map_add, hw₁, hw₂])]
          rfl
        map_smul' := fun r z => by
          obtain ⟨e, w, he, hw⟩ := hLiftWitness z
          rw [hδ_spec z e w he hw,
            hδ_spec (r • z) (r • e) (r • w) (by rw [map_smul, he]; rfl)
              (by rw [SetLike.val_smul, map_smul, map_smul, hw])]
          rfl }
    let q_ker : ↥(LinearMap.ker (dLin E q)) →ₗ[B] ↥(LinearMap.ker (dLin F q)) :=
      { toFun := fun e₀ =>
          ⟨pCoch q e₀.1, by rw [LinearMap.mem_ker, hp_comm q e₀.1, e₀.2, map_zero]⟩
        map_add' := fun a b => Subtype.ext (map_add (pCoch q) a.1 b.1)
        map_smul' := fun r a => Subtype.ext (map_smul (pCoch q) r a.1) }
    have hker_δ : LinearMap.ker δ_raw = LinearMap.range q_ker := by
      ext z
      simp only [LinearMap.mem_ker, LinearMap.mem_range]
      constructor
      · intro hz
        obtain ⟨e, w, he, hw⟩ := hLiftWitness z
        have hw_zero : (Submodule.Quotient.mk w : H_cech K (q + 1)) = 0 := by
          rw [← hδ_spec z e w he hw]
          exact hz
        rw [Submodule.Quotient.mk_eq_zero] at hw_zero
        change w ∈ (LinearMap.range (dLin K q)).comap (LinearMap.ker (dLin K (q + 1))).subtype at hw_zero
        rw [Submodule.mem_comap, LinearMap.mem_range] at hw_zero
        obtain ⟨u, hu⟩ := hw_zero
        change dLin K q u = w.1 at hu
        have he_ker : e - iCoch q u ∈ LinearMap.ker (dLin E q) := by
          rw [LinearMap.mem_ker, map_sub, hi_comm q u, hu, hw, sub_self]
        refine ⟨⟨e - iCoch q u, he_ker⟩, Subtype.ext ?_⟩
        change pCoch q (e - iCoch q u) = z.1
        have hi_zero : pCoch q (iCoch q u) = 0 := by
          rw [← LinearMap.mem_ker, hker_eq q]
          exact ⟨u, rfl⟩
        rw [map_sub, he, hi_zero, sub_zero]
      · rintro ⟨e₀, rfl⟩
        exact hδ_spec (q_ker e₀) e₀.1 0 rfl (by simp)
    have hB_le_ker : B_sub F q ≤ LinearMap.ker δ_raw := by
      cases q with
      | zero => exact bot_le
      | succ p =>
        intro z hz
        rw [Submodule.mem_comap, LinearMap.mem_range] at hz
        obtain ⟨b_F, hb_F⟩ := hz
        obtain ⟨b_E, hb_E⟩ := hp_surj p b_F
        rw [LinearMap.mem_ker]
        exact hδ_spec z (dLin E p b_E) 0
          (by rw [← hp_comm p b_E, hb_E, hb_F]; rfl)
          (by rw [Submodule.coe_zero, map_zero, hd_sq E p b_E])
    have hB_map : B_sub E q ≤ (B_sub F q).comap q_ker := by
      cases q with
      | zero => exact bot_le
      | succ p =>
        intro e₀ he₀
        change e₀.1 ∈ LinearMap.range (dLin E p) at he₀
        change pCoch (p + 1) e₀.1 ∈ LinearMap.range (dLin F p)
        rw [LinearMap.mem_range] at he₀ ⊢
        obtain ⟨b_E, hb_E⟩ := he₀
        exact ⟨pCoch p b_E, by rw [hp_comm p b_E, hb_E]⟩
    let δ_bar : H_cech F q →ₗ[B] H_cech K (q + 1) :=
      Submodule.liftQ (B_sub F q) δ_raw hB_le_ker
    let q_H : H_cech E q →ₗ[B] H_cech F q :=
      Submodule.mapQ (B_sub E q) (B_sub F q) q_ker hB_map
    have hqH_into_ker : ∀ x : H_cech E q, q_H x ∈ LinearMap.ker δ_bar := by
      intro x
      obtain ⟨e₀, rfl⟩ := Submodule.Quotient.mk_surjective (B_sub E q) x
      rw [LinearMap.mem_ker]
      change δ_raw (q_ker e₀) = 0
      rw [← LinearMap.mem_ker, hker_δ]
      exact ⟨e₀, rfl⟩
    have hFinKerBar : Module.Finite B ↥(LinearMap.ker δ_bar) := by
      apply Module.Finite.of_surjective (q_H.codRestrict (LinearMap.ker δ_bar) hqH_into_ker)
      rintro ⟨y, hy⟩
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (B_sub F q) y
      have hz_ker : z ∈ LinearMap.ker δ_raw := hy
      rw [hker_δ, LinearMap.mem_range] at hz_ker
      obtain ⟨e₀, rfl⟩ := hz_ker
      exact ⟨Submodule.Quotient.mk e₀, Subtype.ext rfl⟩
    have hFinRangeBar : Module.Finite B ↥(LinearMap.range δ_bar) :=
      Module.Finite.iff_fg.mpr (IsNoetherian.noetherian (LinearMap.range δ_bar))
    have hFinQuotBar : Module.Finite B (H_cech F q ⧸ LinearMap.ker δ_bar) :=
      Module.Finite.equiv (LinearMap.quotKerEquivRange δ_bar).symm
    exact Module.Finite.of_submodule_quotient (LinearMap.ker δ_bar)
  have hHigh : ∀ (q : ℕ), N + 1 ≤ q → ∀ (F : WeilPresheafModule P_B),
      Module.Finite B (H_cech F q) := by
    intro q hq F
    have hEmpty : IsEmpty (WeilStrictMonoTuple (N + 1) q) :=
      ⟨fun α => by
        have hcard := Fintype.card_le_of_injective α.1 α.2.injective
        simp only [Fintype.card_fin] at hcard
        omega⟩
    have : Subsingleton (WeilModuleCechCochain W_std F q) :=
      ⟨fun x y => funext fun α => hEmpty.elim α⟩
    have : Subsingleton ↥(LinearMap.ker (dLin F q)) := inferInstance
    have : Subsingleton (H_cech F q) := inferInstance
    exact Module.Finite.of_surjective (0 : B →ₗ[B] H_cech F q)
      (fun x => ⟨0, Subsingleton.elim _ _⟩)
  have hInd : ∀ (r : ℕ) (q : ℕ), (N + 1) - q ≤ r →
      ∀ (F : WeilPresheafModule P_B),
        IsWeilCoherentSubChartModule W_std F →
        Module.Finite B (H_cech F q) := by
    intro r
    induction r with
    | zero =>
      intro q hq F _
      exact hHigh q (by omega) F
    | succ r ih =>
      intro q hq F hCohF
      by_cases hge : N + 1 ≤ q
      · exact hHigh q hge F
      · obtain ⟨D, s, K, E, hTwistE, hCohK, hSES⟩ :=
          weil_proj_coherent_twisted_surjection_exact B N F hCohF
        have hFinE :=
          weil_proj_neg_twisted_free_sum_cohomology_finite B N D s E
            (weil_laurent_monomial_cech_cohomology_finite B N) hTwistE
        exact hStep K E F hSES q (hFinToH E hFinE q) (ih (q + 1) (by omega) K hCohK)
  have hAllG : ∀ q : ℕ, Module.Finite B (H_cech G q) := fun q =>
    hInd (N + 1) q (Nat.sub_le _ _) G hCohG
  refine ⟨?_, ?_⟩
  · have : Module.Finite B (H_cech G 0) := hAllG 0
    obtain ⟨k₀, s₀, hs₀⟩ := Module.Finite.exists_fin (R := B) (M := H_cech G 0)
    choose g₀ hg₀ using fun j : Fin k₀ => Submodule.Quotient.mk_surjective (B_sub G 0) (s₀ j)
    refine ⟨k₀, fun j => (g₀ j).1, fun j => (g₀ j).2, ?_⟩
    intro z hz
    have hmem : (Submodule.Quotient.mk (⟨z, hz⟩ : ↥(LinearMap.ker (dLin G 0))) : H_cech G 0) ∈
        Submodule.span B (Set.range s₀) := by
      rw [hs₀]; trivial
    rw [Submodule.mem_span_range_iff_exists_fun] at hmem
    obtain ⟨c, hc⟩ := hmem
    refine ⟨c, ?_⟩
    have h_quot : (Submodule.Quotient.mk (∑ j : Fin k₀, c j • g₀ j) : H_cech G 0) =
        Submodule.Quotient.mk ⟨z, hz⟩ := by
      calc (Submodule.Quotient.mk (∑ j : Fin k₀, c j • g₀ j) : H_cech G 0)
          = ∑ j : Fin k₀, c j • (Submodule.Quotient.mk (g₀ j) : H_cech G 0) := by
            change Submodule.mkQ (B_sub G 0) _ = _
            rw [map_sum]
            exact Finset.sum_congr rfl fun j _ => LinearMap.map_smul _ _ _
        _ = ∑ j : Fin k₀, c j • s₀ j := by
            refine Finset.sum_congr rfl fun j _ => by rw [hg₀ j]
        _ = Submodule.Quotient.mk ⟨z, hz⟩ := hc
    rw [Submodule.Quotient.eq] at h_quot
    change (∑ j : Fin k₀, c j • g₀ j) - ⟨z, hz⟩ ∈ (⊥ : Submodule B _) at h_quot
    rw [Submodule.mem_bot, sub_eq_zero] at h_quot
    have h_val := congrArg Subtype.val h_quot
    rw [AddSubmonoidClass.coe_finsetSum] at h_val
    exact h_val.symm
  · intro p
    have : Module.Finite B (H_cech G (p + 1)) := hAllG (p + 1)
    obtain ⟨k, s, hs⟩ := Module.Finite.exists_fin (R := B) (M := H_cech G (p + 1))
    choose g hg using fun j : Fin k => Submodule.Quotient.mk_surjective (B_sub G (p + 1)) (s j)
    refine ⟨k, fun j => (g j).1, fun j => (g j).2, ?_⟩
    intro z hz
    have hmem : (Submodule.Quotient.mk (⟨z, hz⟩ : ↥(LinearMap.ker (dLin G (p + 1)))) :
        H_cech G (p + 1)) ∈ Submodule.span B (Set.range s) := by
      rw [hs]; trivial
    rw [Submodule.mem_span_range_iff_exists_fun] at hmem
    obtain ⟨c, hc⟩ := hmem
    have h_quot : (Submodule.Quotient.mk (∑ j : Fin k, c j • g j) : H_cech G (p + 1)) =
        Submodule.Quotient.mk ⟨z, hz⟩ := by
      calc (Submodule.Quotient.mk (∑ j : Fin k, c j • g j) : H_cech G (p + 1))
          = ∑ j : Fin k, c j • (Submodule.Quotient.mk (g j) : H_cech G (p + 1)) := by
            change Submodule.mkQ (B_sub G (p + 1)) _ = _
            rw [map_sum]
            exact Finset.sum_congr rfl fun j _ => LinearMap.map_smul _ _ _
        _ = ∑ j : Fin k, c j • s j := by
            refine Finset.sum_congr rfl fun j _ => by rw [hg j]
        _ = Submodule.Quotient.mk ⟨z, hz⟩ := hc
    rw [Submodule.Quotient.eq] at h_quot
    change (∑ j : Fin k, c j • g j) - ⟨z, hz⟩ ∈ B_sub G (p + 1) at h_quot
    rw [Submodule.mem_comap, LinearMap.mem_range] at h_quot
    obtain ⟨b₀, hb₀⟩ := h_quot
    refine ⟨c, -b₀, ?_⟩
    have hsum_val : (∑ j : Fin k, c j • g j).1 =
        ∑ j : Fin k, weilModuleCechSmul π_B W_std G (p + 1) (c j) (g j).1 := by
      rw [AddSubmonoidClass.coe_finsetSum]
      rfl
    have hneg : weilModuleCechDiff W_std G p (-b₀) = -weilModuleCechDiff W_std G p b₀ :=
      map_neg (dLin G p) b₀
    have hb₀' : weilModuleCechDiff W_std G p b₀ = (∑ j : Fin k, c j • g j).1 - z := hb₀
    change z = (∑ j : Fin k, weilModuleCechSmul π_B W_std G (p + 1) (c j) (g j).1) +
      weilModuleCechDiff W_std G p (-b₀)
    rw [← hsum_val, hneg, hb₀']
    abel

theorem weil_vanishingIdeal_integral_subscheme_and_pushforward (R : Type u) [CommRing R]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hProp : AlgebraicGeometry.IsProper g)
    (m : ℕ) (V : Fin m → C.Opens)
    (hAffV : ∀ a : Fin m, AlgebraicGeometry.IsAffineOpen (V a))
    (hCovV : (⋃ a : Fin m, (V a : Set C)) = Set.univ)
    (S : TopologicalSpace.Closeds ↥C)
    (hNonemptyS : (S : Set ↥C).Nonempty)
    (hIrredS : IsIrreducible (S : Set ↥C)) :
    let I_S := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal S
    let Z := I_S.subscheme
    let ι_Z := I_S.subschemeι
    let g_Z := ι_Z ≫ g
    let V_Z : Fin m → Z.Opens := fun a => (TopologicalSpace.Opens.map ι_Z.base).obj (V a)
    AlgebraicGeometry.IsIntegral Z ∧
    AlgebraicGeometry.IsProper g_Z ∧
    (∀ a : Fin m, AlgebraicGeometry.IsAffineOpen (V_Z a)) ∧
    (⋃ a : Fin m, (V_Z a : Set Z)) = Set.univ ∧
    (∃ (F_Z : WeilPresheafModule C),
      IsWeilClosedSubschemeStructureModule I_S F_Z ∧
      ∀ (O_Z : WeilPresheafModule Z),
        (∃ e_O : ∀ U : Z.Opens, O_Z.sec U ≃+ ↑(Z.presheaf.obj (Opposite.op U)),
          (∀ (U : Z.Opens) (a : ↑(Z.presheaf.obj (Opposite.op U))) (x : O_Z.sec U),
            e_O U (a • x) = a * e_O U x) ∧
          (∀ {U W : Z.Opens} (h : W ≤ U) (x : O_Z.sec U),
            e_O W (O_Z.res h x) =
              (Z.presheaf.map (CategoryTheory.homOfLE h).op).hom (e_O U x))) →
        HasFiniteWeilModuleCechCohomology g_Z V_Z O_Z →
        HasFiniteWeilModuleCechCohomology g V F_Z) ∧
    (∀ (U_dense : Z.Opens),
      Nonempty ↥U_dense →
      ∃ (S' : TopologicalSpace.Closeds ↥C),
        S' < S ∧
        ∀ (H_Z : WeilPresheafModule Z),
          IsWeilCoherentSubChartModule V_Z H_Z →
          (∀ U : Z.Opens, AlgebraicGeometry.IsAffineOpen U → U ≤ U_dense →
            ∀ x : H_Z.sec U, x = 0) →
          ∃ (H_C : WeilPresheafModule C),
            IsWeilCoherentSubChartModule V H_C ∧
            IsWeilSupportedOn V H_C S' ∧
            (HasFiniteWeilModuleCechCohomology g V H_C →
              HasFiniteWeilModuleCechCohomology g_Z V_Z H_Z)) :=
by
  let I_S := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal S
  let Z := I_S.subscheme
  let ι_Z := I_S.subschemeι
  let g_Z := ι_Z ≫ g
  let V_Z : Fin m → Z.Opens := fun a => (TopologicalSpace.Opens.map ι_Z.base).obj (V a)
  have _ : AlgebraicGeometry.IsClosedImmersion ι_Z := inferInstance
  have _ : AlgebraicGeometry.IsProper ι_Z := inferInstance
  have _ : AlgebraicGeometry.IsAffineHom ι_Z := inferInstance
  have hClEmb : Topology.IsClosedEmbedding ι_Z.base :=
    AlgebraicGeometry.Scheme.Hom.isClosedEmbedding ι_Z
  have hRange : Set.range ι_Z.base = (S : Set ↥C) :=
    (AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι I_S).trans
      (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal S)
  
  have hMapId : ∀ (X : AlgebraicGeometry.Scheme.{u}) (U₁ : X.Opens) (h₁₁ : U₁ ≤ U₁)
      (x : ↑(X.presheaf.obj (Opposite.op U₁))),
      (X.presheaf.map (CategoryTheory.homOfLE h₁₁).op).hom x = x := by
    intro X U₁ h₁₁ x
    have hHom : CategoryTheory.homOfLE h₁₁ = 𝟙 U₁ := Subsingleton.elim _ _
    rw [hHom, op_id, X.presheaf.map_id]
    rfl
  have hMapComp : ∀ (X : AlgebraicGeometry.Scheme.{u}) {U₁ U₂ U₃ : X.Opens}
      (h₁₂ : U₂ ≤ U₁) (h₂₃ : U₃ ≤ U₂) (h₁₃ : U₃ ≤ U₁)
      (x : ↑(X.presheaf.obj (Opposite.op U₁))),
      (X.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom
        ((X.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom x) =
      (X.presheaf.map (CategoryTheory.homOfLE h₁₃).op).hom x := by
    intro X U₁ U₂ U₃ h₁₂ h₂₃ h₁₃ x
    have hHom : (CategoryTheory.homOfLE h₁₂).op ≫ (CategoryTheory.homOfLE h₂₃).op =
        (CategoryTheory.homOfLE h₁₃).op := by
      rw [← op_comp, CategoryTheory.homOfLE_comp]
    calc (X.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom
           ((X.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom x)
        = (X.presheaf.map (CategoryTheory.homOfLE h₁₂).op ≫
             X.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom x := rfl
      _ = (X.presheaf.map (CategoryTheory.homOfLE h₁₃).op).hom x := by
           rw [← X.presheaf.map_comp, hHom]
  have hNatι : ∀ {U W : C.Opens} (hWU : W ≤ U) (u : ↑(C.presheaf.obj (Opposite.op U))),
      (ι_Z.app W).hom ((C.presheaf.map (CategoryTheory.homOfLE hWU).op).hom u) =
        (Z.presheaf.map
          (CategoryTheory.homOfLE ((TopologicalSpace.Opens.map ι_Z.base).monotone hWU)).op).hom
          ((ι_Z.app U).hom u) := by
    intro U W hWU u
    exact congrArg (fun φ => φ.hom u) (ι_Z.naturality (CategoryTheory.homOfLE hWU).op)
  have hAppLEMap : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
      {U : Y.Opens} {V₁ V₂ : X.Opens}
      (h₁ : V₁ ≤ (TopologicalSpace.Opens.map f.base).obj U)
      (h₂ : V₂ ≤ (TopologicalSpace.Opens.map f.base).obj U)
      (h₂₁ : V₂ ≤ V₁)
