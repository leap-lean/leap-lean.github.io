        · intro j hj
          have hwj : 0 ≤ a j - ((-(m : ℤ)) * e_ind p α j + (-(D : ℤ)) * δ (α.1 0) j) :=
            hw_nonneg j
          have hej : e_ind p α j = 0 := he_ind_not_mem p α j hj
          have hsj : δ (α.1 0) j = 0 := by
            dsimp only [δ]
            have h0j : α.1 0 ≠ j := hj 0
            simp [Pi.single_apply, h0j]
          rw [hej, hsj, mul_zero, mul_zero, add_zero, sub_zero] at hwj
          exact hwj
    · 
      intro p α g hg
      have hSingleHit : ∀ (a : Fin (N + 1) → ℤ) (c : B),
          IsValidLaurentExp N (-(D : ℤ)) α a →
          ∃ y : HomogeneousLocalization.Away 𝒜 (f_prod p α),
            μ p α y = Finsupp.single a c := by
        intro a c hVal
        let m : ℕ := Finset.univ.sup (fun l : Fin (p + 1) => (-a (α.1 l)).toNat)
        let b_tilde : Fin (N + 1) → ℤ := a + (m : ℤ) • e_ind p α + (D : ℤ) • δ (α.1 0)
        have hb_nonneg : ∀ j : Fin (N + 1), 0 ≤ b_tilde j := by
          intro j
          have hD_nonneg : 0 ≤ (D : ℤ) * δ (α.1 0) j := by
            dsimp only [δ]
            by_cases h0 : j = α.1 0
            · subst h0; simp
            · simp [Pi.single_apply, h0]
          by_cases hex : ∃ l : Fin (p + 1), α.1 l = j
          · obtain ⟨l₀, hl₀⟩ := hex
            have hej : e_ind p α j = 1 := hl₀ ▸ he_ind_mem p α l₀
            have hle_m : (-a (α.1 l₀)).toNat ≤ m :=
              Finset.le_sup (f := fun l : Fin (p + 1) => (-a (α.1 l)).toNat) (Finset.mem_univ l₀)
            have hm_ge : -a j ≤ (m : ℤ) := by
              rw [← hl₀]
              have h1 : -a (α.1 l₀) ≤ ((-a (α.1 l₀)).toNat : ℤ) := by omega
              have h2 : ((-a (α.1 l₀)).toNat : ℤ) ≤ (m : ℤ) := Nat.cast_le.mpr hle_m
              omega
            change 0 ≤ a j + (m : ℤ) * e_ind p α j + (D : ℤ) * δ (α.1 0) j
            rw [hej, mul_one]
            omega
          · push_neg at hex
            have hej : e_ind p α j = 0 := he_ind_not_mem p α j hex
            have haj : 0 ≤ a j := hVal.2 j hex
            change 0 ≤ a j + (m : ℤ) * e_ind p α j + (D : ℤ) * δ (α.1 0) j
            rw [hej, mul_zero, add_zero]
            omega
        let b : Fin (N + 1) →₀ ℕ :=
          Finsupp.equivFunOnFinite.symm (fun j => (b_tilde j).toNat)
        have hb_cast : natCastVec b = b_tilde := by
          ext j
          change (((b_tilde j).toNat : ℕ) : ℤ) = b_tilde j
          exact Int.toNat_of_nonneg (hb_nonneg j)
        have hb_deg : Finsupp.degree b = m • (p + 1) := by
          rw [Finsupp.degree_eq_sum]
          apply Nat.cast_injective (R := ℤ)
          rw [Nat.cast_sum]
          have hsum_lhs : ∑ j : Fin (N + 1), (b j : ℤ) = ∑ j : Fin (N + 1), b_tilde j :=
            Finset.sum_congr rfl fun j _ => congrFun hb_cast j
          have hsum_D : ∑ j : Fin (N + 1), ((D : ℤ) • δ (α.1 0)) j = (D : ℤ) := by
            change ∑ j : Fin (N + 1), (D : ℤ) * δ (α.1 0) j = (D : ℤ)
            rw [← Finset.mul_sum, hδ_sum (α.1 0), mul_one]
          have hsum_e : ∑ j : Fin (N + 1), ((m : ℤ) • e_ind p α) j =
              (m : ℤ) * ((p + 1 : ℕ) : ℤ) := by
            change ∑ j : Fin (N + 1), (m : ℤ) * e_ind p α j = _
            rw [← Finset.mul_sum, he_ind_sum p α]
          have hsum_bt : ∑ j : Fin (N + 1), b_tilde j = (m : ℤ) * ((p + 1 : ℕ) : ℤ) := by
            change ∑ j : Fin (N + 1),
              (a j + ((m : ℤ) • e_ind p α) j + ((D : ℤ) • δ (α.1 0)) j) = _
            rw [Finset.sum_add_distrib, Finset.sum_add_distrib, hVal.1, hsum_e, hsum_D]
            omega
          rw [hsum_lhs, hsum_bt, smul_eq_mul, Nat.cast_mul]
        have hb_hom : MvPolynomial.monomial b c ∈ 𝒜 (m • (p + 1)) :=
          (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
            (MvPolynomial.isHomogeneous_monomial c hb_deg)
        have hf_hom : f_prod p α ∈ 𝒜 (p + 1) := hProdHom (p + 1) α.1
        let y := HomogeneousLocalization.Away.mk 𝒜 hf_hom m (MvPolynomial.monomial b c) hb_hom
        refine ⟨y, ?_⟩
        have hpow_mem : f_prod p α ^ m ∈ Submonoid.powers (f_prod p α) :=
          Submonoid.pow_mem _ (Submonoid.mem_powers (f_prod p α)) m
        have hy_spec : y.val *
            (algebraMap _ (Localization.Away (f_prod p α)) (f_prod p α)) ^ m =
            algebraMap _ (Localization.Away (f_prod p α)) (MvPolynomial.monomial b c) := by
          rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
