            (Y.presheaf.map (CategoryTheory.homOfLE hle).op).hom (z β) := by
        intro ν hNotMem β hβ j₀ hj₀ hle
        simp only [s, hNotMem, ↓reduceDIte]
        let S' : Finset (Fin r) := insert lam (Finset.univ.image ν.1)
