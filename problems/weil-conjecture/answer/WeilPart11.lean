          let w₁' : V_X a ⊓ V_X b ⊓ V_X c ⟶ V_X a ⊓ V_X b := CategoryTheory.homOfLE inf_le_left
          let w₂' : V_X a ⊓ V_X b ⊓ V_X c ⟶ V_X b ⊓ V_X c :=
            CategoryTheory.homOfLE (inf_le_inf inf_le_right (le_refl _))
          let w₃' : V_X a ⊓ V_X b ⊓ V_X c ⟶ V_X a ⊓ V_X c :=
            CategoryTheory.homOfLE (inf_le_inf inf_le_left (le_refl _))
          have h1 : (X.presheaf.map w₁'.op).hom ((φ.app (M.V a ⊓ M.V b)).hom (M.u a b).val) =
