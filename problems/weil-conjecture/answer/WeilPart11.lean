        have h_ua := congrArg
          (Y.presheaf.map (CategoryTheory.homOfLE (le_of_eq (h0Eq (pt0 a)).symm)).op).hom h_pt
        rw [hMapComp _ _ (hU_le a), hMapComp _ _ (hU_le a)] at h_ua
