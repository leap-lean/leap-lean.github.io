      obtain ⟨s_Y, hs_Y, _⟩ :=
        TopCat.Sheaf.existsUnique_gluing'.{u} Y.sheaf U W iU (le_of_eq hCov.symm) sf hCompat
      let s_W : ↑(Y.presheaf.obj (Opposite.op W)) := s_Y
      have hs_W : ∀ a : Fin r, (Y.presheaf.map (iU a).op).hom s_W = sf a := hs_Y
      refine ⟨(e_Y W).symm s_W, funext fun α => ?_⟩
      suffices ∀ (a : Fin r) (α₀ : WeilStrictMonoTuple r 0), α₀ = pt0 a →
          res0 ((e_Y W).symm s_W) α₀ = z α₀ from this (α.1 0) α (hα0_eq α)
      rintro a _ rfl
      apply (e_Y (weilCoverChartInter U (pt0 a))).injective
      rw [hRes0_apply, he_Y, (e_Y W).apply_symm_apply s_W,
        ← hMapComp (hU_le a) (le_of_eq (h0Eq (pt0 a))) _,
