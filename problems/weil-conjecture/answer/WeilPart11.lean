        · rw [hξ_off b k hkb]
      have he_ge2 : (2 : WithTop ℤ) ≤ ord (P_br k) ((e k : F) - 1) :=
        le_trans (WithTop.coe_le_coe.mpr (by exact_mod_cast hN_ge2 : (2 : ℤ) ≤ (N : ℤ)))
          (he_sub_one_ord k)
      have herr1 : (2 : WithTop ℤ) ≤
          ord (P_br k) (((e k : F) - 1) * (algebraMap Ω F (c_br k) + ξ k)) := by
        rw [(hVal.1 (P_br k) (hP_pl k)).2.1]
        simpa only [add_zero] using add_le_add he_ge2 (hterm_nonneg k)
      have herr2 : (2 : WithTop ℤ) ≤
          ord (P_br k) (∑ b ∈ Finset.univ.erase k, (e b : F) * (algebraMap Ω F (c_br b) + ξ b)) := by
        refine hOrdSumGeFin (Finset.univ.erase k) _ (P_br k) (2 : WithTop ℤ) (hP_pl k) fun b hb => ?_
        rw [(hVal.1 (P_br k) (hP_pl k)).2.1]
        have hkb : k ≠ b := (Finset.mem_erase.mp hb).1.symm
        have heb_ge2 : (2 : WithTop ℤ) ≤ ord (P_br k) (e b : F) :=
          le_trans (WithTop.coe_le_coe.mpr (by exact_mod_cast hN_ge2 : (2 : ℤ) ≤ (N : ℤ)))
            (he_J b k hkb)
        simpa only [add_zero] using add_le_add heb_ge2 (hterm_nonneg b)
      have herr_ge2 : (2 : WithTop ℤ) ≤ ord (P_br k) err_k :=
        le_trans (le_min herr1 herr2) ((hVal.1 (P_br k) (hP_pl k)).2.2.1 _ _)
      have hlt : ord (P_br k) (ξ k) < ord (P_br k) err_k := by
        rw [hξ_diag k]
        exact lt_of_lt_of_le (WithTop.coe_lt_coe.mpr (by omega : (1 : ℤ) < 2)) herr_ge2
      rw [hz_sub_eq, hOrdAddLt (P_br k) (hP_pl k) _ _ hlt, hξ_diag k]
    have hz_mem : z ∈ M_c := by
      intro P hP htc
      have hPin : P ∈ Set.range P_br := by
        rw [hP_range]
        exact ⟨hP, htc⟩
      rcases hPin with ⟨k, rfl⟩
      have hz_eq : z = (z - algebraMap Ω F (c_br k)) + algebraMap Ω F (c_br k) :=
        (sub_add_cancel z _).symm
      rw [hz_eq]
      refine le_trans ?_ ((hVal.1 (P_br k) (hP_pl k)).2.2.1 _ _)
      rw [hz_ord k]
      exact le_min (WithTop.coe_le_coe.mpr (by omega : (0 : ℤ) ≤ 1))
        (hOrdAlgNonneg (P_br k) (hP_pl k) (c_br k))
    have hz_int : IsIntegral ↥K₀ z := IsIntegral.of_finite ↥K₀ z
    
    have hu_ord_fiber : ∀ P : X, IsPlace P → (1 : WithTop ℤ) ≤ ord P τ_c →
        ord P u_D = ((-D P : ℤ) : WithTop ℤ) := by
      intro P hP htc
      have hPin : P ∈ Set.range P_br := by
        rw [hP_range]
        exact ⟨hP, htc⟩
      rcases hPin with ⟨k, rfl⟩
      rw [← hCoeNeg]
      exact hu_ord k
    have hNegDFin : {P : X | -D P ≠ 0}.Finite := by
      refine hD_fin.subset ?_
      intro P hP
      exact neg_ne_zero.mp hP
    have hAt_le_K₀ : At ≤ K₀.toSubalgebra := by
      rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
      change t ∈ K₀
      rw [hK₀]
      exact IntermediateField.mem_adjoin_simple_self Ω t
    have hu_tr : ∀ w : F,
        (∀ v ∈ E_t, ((Algebra.trace ↥K₀ F (w * v) : ↥K₀) : F) ∈ R_c) ↔
        (∀ b ∈ M_c, ((Algebra.trace ↥K₀ F ((w * u_D) * b) : ↥K₀) : F) ∈ R_c) := by
      intro w
      constructor
      · intro hE b hb
        have hy_fib : ∀ P : X, IsPlace P → (1 : WithTop ℤ) ≤ ord P τ_c →
            ((-D P : ℤ) : WithTop ℤ) ≤ ord P (u_D * b) := by
          intro P hP htc
          rw [(hVal.1 P hP).2.1, hu_ord_fiber P hP htc]
          simpa only [add_zero] using add_le_add (le_refl ((-D P : ℤ) : WithTop ℤ)) (hb P hP htc)
        obtain ⟨S_poly, _, hS_ord, hS_eval_imp⟩ := hClearBound c (fun P => -D P) hNegDFin (u_D * b)
        have hS_eval : Polynomial.eval c S_poly ≠ 0 := hS_eval_imp hy_fib
        let v : F := Polynomial.aeval t S_poly * (u_D * b)
        have hv_Et : v ∈ E_t := by
          intro R hR hRt
          rw [hCoeNeg]
          exact hS_ord R hR hRt
        have hs_At : Polynomial.aeval t S_poly ∈ At := (hAt_iff _).mpr ⟨S_poly, rfl⟩
        let s_K : ↥K₀ := ⟨Polynomial.aeval t S_poly, hAt_le_K₀ hs_At⟩
        have hSmul : w * v = s_K • ((w * u_D) * b) := by
          rw [Algebra.smul_def, IntermediateField.algebraMap_apply]
          dsimp only [s_K, v]
          ring
        have hTrEq : ((Algebra.trace ↥K₀ F (w * v) : ↥K₀) : F) =
            Polynomial.aeval t S_poly * ((Algebra.trace ↥K₀ F ((w * u_D) * b) : ↥K₀) : F) := by
          rw [hSmul, LinearMap.map_smul, smul_eq_mul, MulMemClass.coe_mul]
        obtain ⟨P₁, Q₁, hQ₁_eval, hPQ₁⟩ := hE v hv_Et
        refine ⟨P₁, S_poly * Q₁, ?_, ?_⟩
        · rw [Polynomial.eval_mul]
          exact mul_ne_zero hS_eval hQ₁_eval
        · rw [map_mul (Polynomial.aeval t)]
          calc ((Algebra.trace ↥K₀ F ((w * u_D) * b) : ↥K₀) : F) *
                (Polynomial.aeval t S_poly * Polynomial.aeval t Q₁)
              = (Polynomial.aeval t S_poly *
                  ((Algebra.trace ↥K₀ F ((w * u_D) * b) : ↥K₀) : F)) *
                  Polynomial.aeval t Q₁ := by ring
            _ = Polynomial.aeval t P₁ := by rw [← hTrEq, hPQ₁]
      · intro hM v hv
        let b : F := u_D⁻¹ * v
        have hb_Mc : b ∈ M_c := by
          intro P hP htc
          dsimp only [b]
          rw [(hVal.1 P hP).2.1,
            hOrdInv P hP u_D (-D P) hu_ne (hu_ord_fiber P hP htc), neg_neg]
          have hvP : ((-D P : ℤ) : WithTop ℤ) ≤ ord P v := by
            rw [← hCoeNeg]
            exact hv P hP (hOrdCoordNonneg c P hP htc)
          have hsum := add_le_add (le_refl (D P : WithTop ℤ)) hvP
          have hzero : (D P : WithTop ℤ) + ((-D P : ℤ) : WithTop ℤ) = (0 : WithTop ℤ) := by
            rw [← WithTop.coe_add, add_neg_cancel, WithTop.coe_zero]
          rwa [hzero] at hsum
        have hmul : (w * u_D) * b = w * v := by
          dsimp only [b]
          calc (w * u_D) * (u_D⁻¹ * v)
              = w * (u_D * u_D⁻¹) * v := by ring
            _ = w * v := by rw [mul_inv_cancel₀ hu_ne, mul_one]
        rw [← hmul]
        exact hM b hb_Mc
    exact ⟨r, P_br, e_br, c_br, s_gen, u_D, z, hr, hP_inj, hP_range, he_br, hc_inj,
      hs_sub, hs_span, hClear, hu_ne, hu_ord, hu_tr, hz_mem, hz_int, hz_ord⟩

theorem weil_semilocal_monogenic_powerBasis_traceDual_and_residue_factor (Ω X F : Type u) [Field Ω] [Field F] [Algebra Ω F]
    (IsPlace : X → Prop) (ord : X → F → WithTop ℤ)
    (hVal : IsCurvePlaceValuation Ω X F IsPlace ord)
    (t : F) (ht_tr : Transcendental Ω t)
    (K₀ : IntermediateField Ω F) (hK₀ : K₀ = IntermediateField.adjoin Ω ({t} : Set F))
    [FiniteDimensional ↥K₀ F] [Algebra.IsSeparable ↥K₀ F]
    (c : Ω) (r : ℕ) (hr : 1 ≤ r)
    (P_br : Fin r → X) (hP_inj : Function.Injective P_br) (hP_pl : ∀ k : Fin r, IsPlace (P_br k))
    (e_br : Fin r → ℕ)
    (he_br : ∀ k : Fin r, 1 ≤ e_br k ∧ ord (P_br k) (t - algebraMap Ω F c) = (e_br k : WithTop ℤ))
    (c_br : Fin r → Ω) (hc_inj : Function.Injective c_br)
    (s_gen : Finset F) (z : F)
    (hs_sub : (↑s_gen : Set F) ⊆ {v : F | ∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) v})
    (hs_span : ∀ v : F, (∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) v) →
      ∃ coeff : F → F, (∀ g ∈ s_gen, coeff g ∈ weilRatLocalSet Ω F t c) ∧
        v = ∑ g ∈ s_gen, coeff g * g)
    (hClear : ∀ u : F, ∃ a : Polynomial Ω, a ≠ 0 ∧
      ∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) (Polynomial.aeval t a * u))
    (hz_mem : ∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) z)
    (hz_int : IsIntegral ↥K₀ z)
    (hz_ord : ∀ k : Fin r, ord (P_br k) (z - algebraMap Ω F (c_br k)) = (1 : WithTop ℤ)) :
    ∃ G : Polynomial F,
      G.Monic ∧
      G.natDegree = Module.finrank ↥K₀ F ∧
      Module.finrank ↥K₀ F = ∑ k : Fin r, e_br k ∧
      (∀ j : ℕ, G.coeff j ∈ weilRatLocalSet Ω F t c) ∧
      Polynomial.eval z G = 0 ∧
      Polynomial.eval z (Polynomial.derivative G) ≠ 0 ∧
      (∀ z' : F,
        (∀ b : F, (∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) b) →
          ((Algebra.trace ↥K₀ F (z' * b) : ↥K₀) : F) ∈ weilRatLocalSet Ω F t c) ↔
        (∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) (Polynomial.eval z (Polynomial.derivative G) * z'))) ∧
      (∀ j : ℕ, ∃ u ∈ weilRatLocalSet Ω F t c,
        G.coeff j - algebraMap Ω F
          ((∏ k : Fin r, (Polynomial.X - Polynomial.C (c_br k)) ^ (e_br k)).coeff j) =
          (t - algebraMap Ω F c) * u) :=
by
  classical
  let _ := hP_inj
  
  
  
  have hOrdZero : ∀ P : X, IsPlace P → ord P 0 = ⊤ :=
    fun P hP => ((hVal.1 P hP).1 0).mpr rfl
  have hOrdOne : ∀ P : X, IsPlace P → ord P 1 = (0 : WithTop ℤ) := by
    intro P hP
    rw [← map_one (algebraMap Ω F)]
    exact (hVal.1 P hP).2.2.2.1 1 one_ne_zero
  have hOrdNegOne : ∀ P : X, IsPlace P → ord P (-1) = (0 : WithTop ℤ) := by
    intro P hP
    have hm1 : (-1 : F) = algebraMap Ω F (-1) := by rw [map_neg, map_one]
    rw [hm1]
    exact (hVal.1 P hP).2.2.2.1 (-1) (neg_ne_zero.mpr one_ne_zero)
  have hOrdNeg : ∀ (P : X), IsPlace P → ∀ x : F, ord P (-x) = ord P x := by
    intro P hP x
    have hnx : -x = (-1 : F) * x := by ring
    rw [hnx, (hVal.1 P hP).2.1, hOrdNegOne P hP, zero_add]
  have hOrdAlgNonneg : ∀ (P : X), IsPlace P → ∀ a : Ω, (0 : WithTop ℤ) ≤ ord P (algebraMap Ω F a) := by
    intro P hP a
    by_cases ha : a = 0
    · rw [ha, map_zero, hOrdZero P hP]; exact le_top
    · rw [(hVal.1 P hP).2.2.2.1 a ha]
  have hOrdAddOfLt : ∀ (P : X), IsPlace P → ∀ x y : F,
      ord P x < ord P y → ord P (x + y) = ord P x := by
    intro P hP x y hlt
    apply le_antisymm
    · by_contra hnot
      have hnot' : ord P x < ord P (x + y) := lt_of_not_ge hnot
      have hx_eq : x + y + (-y) = x := by ring
      have hmin : min (ord P (x + y)) (ord P y) ≤ ord P x := by
        have h := (hVal.1 P hP).2.2.1 (x + y) (-y)
        rwa [hx_eq, hOrdNeg P hP y] at h
      exact lt_irrefl (ord P x) (lt_of_lt_of_le (lt_min hnot' hlt) hmin)
    · exact le_trans (min_eq_left (le_of_lt hlt)).symm.le ((hVal.1 P hP).2.2.1 x y)
  have hOrdPowEq : ∀ (P : X), IsPlace P → ∀ (x : F) (m : ℤ) (n : ℕ),
      ord P x = (m : WithTop ℤ) → ord P (x ^ n) = (((n : ℤ) * m : ℤ) : WithTop ℤ) := by
    intro P hP x m n hx
    induction n with
    | zero =>
      rw [pow_zero, hOrdOne P hP]
      simp
    | succ n ih =>
      rw [pow_succ, (hVal.1 P hP).2.1, ih, hx, ← WithTop.coe_add]
      congr 1
      push_cast
      ring
  have hOrdInvEq : ∀ (P : X), IsPlace P → ∀ (x : F) (m : ℤ),
      ord P x = (m : WithTop ℤ) → ord P x⁻¹ = ((-m : ℤ) : WithTop ℤ) := by
    intro P hP x m hx
    have hx_ne : x ≠ 0 := by
      intro h0
      rw [h0, hOrdZero P hP] at hx
      exact WithTop.top_ne_coe hx
    have hinv_ne : x⁻¹ ≠ 0 := inv_ne_zero hx_ne
    have hinv_nt : ord P x⁻¹ ≠ ⊤ := mt ((hVal.1 P hP).1 x⁻¹).mp hinv_ne
    obtain ⟨m', hm'⟩ := WithTop.ne_top_iff_exists.mp hinv_nt
    have h1 := (hVal.1 P hP).2.1 x x⁻¹
    rw [mul_inv_cancel₀ hx_ne, hOrdOne P hP, hx, ← hm', ← WithTop.coe_add,
      ← WithTop.coe_zero, WithTop.coe_inj] at h1
    have hm'_eq : m' = -m := by omega
    rw [← hm', hm'_eq]
  have hOrdSumGe : ∀ {ι : Type} (P : X), IsPlace P → ∀ (S : Finset ι) (f : ι → F) (B : WithTop ℤ),
      (∀ i ∈ S, B ≤ ord P (f i)) → B ≤ ord P (∑ i ∈ S, f i) := by
    intro ι P hP S f B hB
    induction S using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty, hOrdZero P hP]
      exact le_top
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      refine le_trans ?_ ((hVal.1 P hP).2.2.1 (f a) (∑ i ∈ s, f i))
      exact le_min (hB a (Finset.mem_insert_self a s))
        (ih (fun i hi => hB i (Finset.mem_insert_of_mem hi)))

  have hinj_aeval : Function.Injective (Polynomial.aeval t : Polynomial Ω →ₐ[Ω] F) :=
    transcendental_iff_injective.mp ht_tr
  have haeval_ne_zero : ∀ {Q : Polynomial Ω}, Q ≠ 0 → Polynomial.aeval t Q ≠ 0 :=
    fun hQ h0 => hQ (hinj_aeval (h0.trans (map_zero _).symm))
  have haeval_ne_of_eval_ne : ∀ {Q : Polynomial Ω}, Polynomial.eval c Q ≠ 0 → Polynomial.aeval t Q ≠ 0 :=
    fun hQc => haeval_ne_zero fun hQ0 => hQc (by rw [hQ0, Polynomial.eval_zero])
  have ht_K₀ : t ∈ K₀ := hK₀ ▸ IntermediateField.mem_adjoin_simple_self Ω t
  have haeval_in_K₀ : ∀ P : Polynomial Ω, Polynomial.aeval t P ∈ K₀ := by
    intro P
    induction P using Polynomial.induction_on' with
    | add p q hp hq => rw [map_add]; exact K₀.add_mem hp hq
    | monomial n a =>
      rw [Polynomial.aeval_monomial]
      exact K₀.mul_mem (K₀.algebraMap_mem a) (K₀.toSubalgebra.pow_mem ht_K₀ n)

  
  
  
  have hStage1 : ∃ (R_sub : Subalgebra Ω F) (τ_sub : ↥R_sub) (π_c : ↥R_sub →ₐ[Ω] Ω),
      (∀ u : F, u ∈ R_sub ↔ u ∈ weilRatLocalSet Ω F t c) ∧
      (∀ a : ↥R_sub, (a : F) ∈ K₀) ∧
      (∀ k : ↥K₀, ∃ a b : ↥R_sub, b ≠ 0 ∧ (b : F) * (k : F) = (a : F)) ∧
      (τ_sub : F) = t - algebraMap Ω F c ∧
      IsIntegrallyClosed ↥R_sub ∧
      Ideal.span ({τ_sub} : Set ↥R_sub) ≤ (⊥ : Ideal ↥R_sub).jacobson ∧
      π_c τ_sub = 0 ∧
      (∀ a : ↥R_sub, π_c a = 0 ↔ ∃ u : ↥R_sub, a = τ_sub * u) := by
    let R_sub : Subalgebra Ω F :=
      { carrier := weilRatLocalSet Ω F t c
        algebraMap_mem' := fun a => ⟨Polynomial.C a, 1, by simp, by simp⟩
        add_mem' := by
          rintro u₁ u₂ ⟨P₁, Q₁, hQ₁, hu₁⟩ ⟨P₂, Q₂, hQ₂, hu₂⟩
          refine ⟨P₁ * Q₂ + P₂ * Q₁, Q₁ * Q₂, ?_, ?_⟩
          · rw [Polynomial.eval_mul]; exact mul_ne_zero hQ₁ hQ₂
          · calc (u₁ + u₂) * Polynomial.aeval t (Q₁ * Q₂)
                = (u₁ * Polynomial.aeval t Q₁) * Polynomial.aeval t Q₂ +
                  (u₂ * Polynomial.aeval t Q₂) * Polynomial.aeval t Q₁ := by rw [map_mul]; ring
              _ = Polynomial.aeval t (P₁ * Q₂ + P₂ * Q₁) := by rw [hu₁, hu₂, map_add, map_mul, map_mul]
        mul_mem' := by
          rintro u₁ u₂ ⟨P₁, Q₁, hQ₁, hu₁⟩ ⟨P₂, Q₂, hQ₂, hu₂⟩
          refine ⟨P₁ * P₂, Q₁ * Q₂, ?_, ?_⟩
          · rw [Polynomial.eval_mul]; exact mul_ne_zero hQ₁ hQ₂
          · calc (u₁ * u₂) * Polynomial.aeval t (Q₁ * Q₂)
                = (u₁ * Polynomial.aeval t Q₁) * (u₂ * Polynomial.aeval t Q₂) := by rw [map_mul]; ring
              _ = Polynomial.aeval t (P₁ * P₂) := by rw [hu₁, hu₂, map_mul] }

    let τ_c : F := t - algebraMap Ω F c
    have hτ_mem_R : τ_c ∈ R_sub := ⟨Polynomial.X - Polynomial.C c, 1, by simp, by simp [τ_c]⟩
    let τ_sub : ↥R_sub := ⟨τ_c, hτ_mem_R⟩
    have ht_mem_R : t ∈ R_sub := ⟨Polynomial.X, 1, by simp, by simp⟩

    have hR_in_K₀ : ∀ a : ↥R_sub, (a : F) ∈ K₀ := by
      intro a
      obtain ⟨P, Q, hQc, haQ⟩ := a.2
      have hQt_ne : Polynomial.aeval t Q ≠ 0 := haeval_ne_of_eval_ne hQc
      have ha_eq : (a : F) = Polynomial.aeval t P * (Polynomial.aeval t Q)⁻¹ := by
        rw [← haQ, mul_assoc, mul_inv_cancel₀ hQt_ne, mul_one]
      rw [ha_eq]
      exact K₀.mul_mem (haeval_in_K₀ P) (K₀.inv_mem (haeval_in_K₀ Q))

    let K_frac : IntermediateField Ω F :=
      { carrier := {x : F | ∃ a b : ↥R_sub, b ≠ 0 ∧ (b : F) * x = (a : F)}
        algebraMap_mem' := fun α => ⟨algebraMap Ω ↥R_sub α, 1, one_ne_zero, by simp⟩
        add_mem' := by
          rintro x₁ x₂ ⟨a₁, b₁, hb₁, hx₁⟩ ⟨a₂, b₂, hb₂, hx₂⟩
          refine ⟨b₂ * a₁ + b₁ * a₂, b₁ * b₂, mul_ne_zero hb₁ hb₂, ?_⟩
          push_cast
          calc ((b₁ : F) * (b₂ : F)) * (x₁ + x₂)
              = (b₂ : F) * ((b₁ : F) * x₁) + (b₁ : F) * ((b₂ : F) * x₂) := by ring
            _ = (b₂ : F) * (a₁ : F) + (b₁ : F) * (a₂ : F) := by rw [hx₁, hx₂]
        mul_mem' := by
          rintro x₁ x₂ ⟨a₁, b₁, hb₁, hx₁⟩ ⟨a₂, b₂, hb₂, hx₂⟩
          refine ⟨a₁ * a₂, b₁ * b₂, mul_ne_zero hb₁ hb₂, ?_⟩
          push_cast
          calc ((b₁ : F) * (b₂ : F)) * (x₁ * x₂)
              = ((b₁ : F) * x₁) * ((b₂ : F) * x₂) := by ring
            _ = (a₁ : F) * (a₂ : F) := by rw [hx₁, hx₂]
        inv_mem' := by
          rintro x ⟨a, b, hb, hx⟩
          by_cases hx0 : x = 0
          · rw [hx0, inv_zero]
            exact ⟨0, 1, one_ne_zero, by simp⟩
          · have hbF : (b : F) ≠ 0 := fun h => hb (Subtype.ext h)
            have haF : (a : F) ≠ 0 := by rw [← hx]; exact mul_ne_zero hbF hx0
            have ha : a ≠ 0 := fun h => haF (congrArg Subtype.val h)
            refine ⟨b, a, ha, ?_⟩
            rw [← hx, mul_assoc, mul_inv_cancel₀ hx0, mul_one] }

    have hK₀_le_frac : K₀ ≤ K_frac := by
      rw [hK₀, IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
      exact ⟨⟨t, ht_mem_R⟩, 1, one_ne_zero, by simp⟩

    let φ_RK₀ : ↥R_sub →+* ↥K₀ :=
      { toFun := fun a => ⟨(a : F), hR_in_K₀ a⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let _ : Algebra ↥R_sub ↥K₀ := φ_RK₀.toAlgebra
    have hinj_RK₀ : Function.Injective (algebraMap ↥R_sub ↥K₀) :=
      fun _ _ h => Subtype.ext (congrArg (Subtype.val : ↥K₀ → F) h)
    have _ : FaithfulSMul ↥R_sub ↥K₀ :=
      (faithfulSMul_iff_algebraMap_injective ↥R_sub ↥K₀).mpr hinj_RK₀
    have _ : IsFractionRing ↥R_sub ↥K₀ := by
      apply IsFractionRing.of_field ↥R_sub ↥K₀
      intro x
      obtain ⟨a, b, hb, hbx⟩ := hK₀_le_frac x.2
      refine ⟨a, b, ?_⟩
      apply Subtype.ext
      have hbF : (b : F) ≠ 0 := fun h => hb (Subtype.ext h)
      change (x : F) = (a : F) / (b : F)
      rw [eq_div_iff hbF, mul_comm, hbx]

    have hτ_jac : Ideal.span ({τ_sub} : Set ↥R_sub) ≤ (⊥ : Ideal ↥R_sub).jacobson := by
      rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_jacobson_bot]
      intro y
      obtain ⟨P, Q, hQc, hyQ⟩ := y.2
      let P₁ : Polynomial Ω := (Polynomial.X - Polynomial.C c) * P + Q
      have hP₁c : Polynomial.eval c P₁ ≠ 0 := by dsimp [P₁]; simpa using hQc
      have hP₁t_ne : Polynomial.aeval t P₁ ≠ 0 := haeval_ne_of_eval_ne hP₁c
      have h_eq : ((τ_sub * y + 1 : ↥R_sub) : F) * Polynomial.aeval t Q = Polynomial.aeval t P₁ := by
        change (τ_c * (y : F) + 1) * Polynomial.aeval t Q = Polynomial.aeval t P₁
        calc (τ_c * (y : F) + 1) * Polynomial.aeval t Q
            = τ_c * ((y : F) * Polynomial.aeval t Q) + Polynomial.aeval t Q := by ring
          _ = Polynomial.aeval t (Polynomial.X - Polynomial.C c) * Polynomial.aeval t P +
              Polynomial.aeval t Q := by rw [hyQ]; simp [τ_c]
          _ = Polynomial.aeval t P₁ := by dsimp [P₁]; rw [map_add, map_mul]
      have hw_mem : Polynomial.aeval t Q * (Polynomial.aeval t P₁)⁻¹ ∈ R_sub := by
        refine ⟨Q, P₁, hP₁c, ?_⟩
        rw [mul_assoc, inv_mul_cancel₀ hP₁t_ne, mul_one]
      refine isUnit_iff_exists_inv.mpr ⟨⟨Polynomial.aeval t Q * (Polynomial.aeval t P₁)⁻¹, hw_mem⟩, ?_⟩
      apply Subtype.ext
      change ((τ_sub * y + 1 : ↥R_sub) : F) * (Polynomial.aeval t Q * (Polynomial.aeval t P₁)⁻¹) = 1
      rw [← mul_assoc, h_eq, mul_inv_cancel₀ hP₁t_ne]

    let π_fn : ↥R_sub → Ω := fun a =>
      Polynomial.eval c (Classical.choose a.2) /
        Polynomial.eval c (Classical.choose (Classical.choose_spec a.2))
    have hπ_spec : ∀ (a : ↥R_sub) (P Q : Polynomial Ω),
        Polynomial.eval c Q ≠ 0 →
        (a : F) * Polynomial.aeval t Q = Polynomial.aeval t P →
        π_fn a * Polynomial.eval c Q = Polynomial.eval c P := by
      intro a P Q hQc haQ
      let P₀ := Classical.choose a.2
      let Q₀ := Classical.choose (Classical.choose_spec a.2)
      have hSpec := Classical.choose_spec (Classical.choose_spec a.2)
      have hQ₀c : Polynomial.eval c Q₀ ≠ 0 := hSpec.1
      have haQ₀ : (a : F) * Polynomial.aeval t Q₀ = Polynomial.aeval t P₀ := hSpec.2
      have h_poly : P₀ * Q = P * Q₀ := by
        apply hinj_aeval
        calc Polynomial.aeval t (P₀ * Q)
            = ((a : F) * Polynomial.aeval t Q₀) * Polynomial.aeval t Q := by rw [map_mul, haQ₀]
          _ = ((a : F) * Polynomial.aeval t Q) * Polynomial.aeval t Q₀ := by ring
          _ = Polynomial.aeval t (P * Q₀) := by rw [haQ, map_mul]
      have h_eval : Polynomial.eval c P₀ * Polynomial.eval c Q =
          Polynomial.eval c P * Polynomial.eval c Q₀ := by
        simpa only [Polynomial.eval_mul] using congrArg (Polynomial.eval c) h_poly
      change (Polynomial.eval c P₀ / Polynomial.eval c Q₀) * Polynomial.eval c Q = Polynomial.eval c P
      rw [div_mul_eq_mul_div, h_eval, mul_div_cancel_right₀ _ hQ₀c]

    have hπ_comm : ∀ α : Ω, π_fn (algebraMap Ω ↥R_sub α) = α := by
      intro α
      simpa using hπ_spec (algebraMap Ω ↥R_sub α) (Polynomial.C α) 1 (by simp) (by simp)

    let π_c : ↥R_sub →ₐ[Ω] Ω :=
      { toFun := π_fn
        map_one' := by simpa only [map_one] using hπ_comm 1
        map_zero' := by simpa only [map_zero] using hπ_comm 0
        map_add' := fun x y => by
          obtain ⟨P₁, Q₁, hQ₁, hx₁⟩ := x.2
          obtain ⟨P₂, Q₂, hQ₂, hy₂⟩ := y.2
          have hxy : ((x + y : ↥R_sub) : F) * Polynomial.aeval t (Q₁ * Q₂) =
              Polynomial.aeval t (P₁ * Q₂ + P₂ * Q₁) := by
            change ((x : F) + (y : F)) * Polynomial.aeval t (Q₁ * Q₂) = _
            calc ((x : F) + (y : F)) * Polynomial.aeval t (Q₁ * Q₂)
                = ((x : F) * Polynomial.aeval t Q₁) * Polynomial.aeval t Q₂ +
                  ((y : F) * Polynomial.aeval t Q₂) * Polynomial.aeval t Q₁ := by rw [map_mul]; ring
              _ = Polynomial.aeval t (P₁ * Q₂ + P₂ * Q₁) := by rw [hx₁, hy₂, map_add, map_mul, map_mul]
          have hQ12 : Polynomial.eval c (Q₁ * Q₂) ≠ 0 := by
            rw [Polynomial.eval_mul]; exact mul_ne_zero hQ₁ hQ₂
          apply mul_right_cancel₀ hQ12
          rw [hπ_spec (x + y) _ _ hQ12 hxy]
          simp only [Polynomial.eval_add, Polynomial.eval_mul]
          calc Polynomial.eval c P₁ * Polynomial.eval c Q₂ + Polynomial.eval c P₂ * Polynomial.eval c Q₁
              = (π_fn x * Polynomial.eval c Q₁) * Polynomial.eval c Q₂ +
                (π_fn y * Polynomial.eval c Q₂) * Polynomial.eval c Q₁ := by
                rw [hπ_spec x P₁ Q₁ hQ₁ hx₁, hπ_spec y P₂ Q₂ hQ₂ hy₂]
            _ = (π_fn x + π_fn y) * (Polynomial.eval c Q₁ * Polynomial.eval c Q₂) := by ring
        map_mul' := fun x y => by
          obtain ⟨P₁, Q₁, hQ₁, hx₁⟩ := x.2
          obtain ⟨P₂, Q₂, hQ₂, hy₂⟩ := y.2
          have hxy : ((x * y : ↥R_sub) : F) * Polynomial.aeval t (Q₁ * Q₂) =
              Polynomial.aeval t (P₁ * P₂) := by
            change ((x : F) * (y : F)) * Polynomial.aeval t (Q₁ * Q₂) = _
            calc ((x : F) * (y : F)) * Polynomial.aeval t (Q₁ * Q₂)
                = ((x : F) * Polynomial.aeval t Q₁) * ((y : F) * Polynomial.aeval t Q₂) := by
                  rw [map_mul]; ring
              _ = Polynomial.aeval t (P₁ * P₂) := by rw [hx₁, hy₂, map_mul]
          have hQ12 : Polynomial.eval c (Q₁ * Q₂) ≠ 0 := by
            rw [Polynomial.eval_mul]; exact mul_ne_zero hQ₁ hQ₂
          apply mul_right_cancel₀ hQ12
          rw [hπ_spec (x * y) _ _ hQ12 hxy]
          simp only [Polynomial.eval_mul]
          calc Polynomial.eval c P₁ * Polynomial.eval c P₂
              = (π_fn x * Polynomial.eval c Q₁) * (π_fn y * Polynomial.eval c Q₂) := by
                rw [hπ_spec x P₁ Q₁ hQ₁ hx₁, hπ_spec y P₂ Q₂ hQ₂ hy₂]
            _ = (π_fn x * π_fn y) * (Polynomial.eval c Q₁ * Polynomial.eval c Q₂) := by ring
        commutes' := hπ_comm }

    have hπ_τ : π_c τ_sub = 0 := by
      have h := hπ_spec τ_sub (Polynomial.X - Polynomial.C c) 1 (by simp) (by simp [τ_sub, τ_c])
      change π_fn τ_sub = 0
      simpa using h

    have hπ_ker : ∀ a : ↥R_sub, π_c a = 0 ↔ ∃ u : ↥R_sub, a = τ_sub * u := by
      intro a
      constructor
      · intro ha0
        obtain ⟨P, Q, hQc, haQ⟩ := a.2
        have hPc0 : Polynomial.eval c P = 0 := by
          have h := hπ_spec a P Q hQc haQ
          change π_c a * Polynomial.eval c Q = Polynomial.eval c P at h
          rw [ha0, zero_mul] at h
          exact h.symm
        obtain ⟨P₁, hP₁⟩ := Polynomial.dvd_iff_isRoot.mpr hPc0
        have hQt_ne : Polynomial.aeval t Q ≠ 0 := haeval_ne_of_eval_ne hQc
        have hu_mem : Polynomial.aeval t P₁ * (Polynomial.aeval t Q)⁻¹ ∈ R_sub := by
          refine ⟨P₁, Q, hQc, ?_⟩
          rw [mul_assoc, inv_mul_cancel₀ hQt_ne, mul_one]
        refine ⟨⟨Polynomial.aeval t P₁ * (Polynomial.aeval t Q)⁻¹, hu_mem⟩, ?_⟩
        apply Subtype.ext
        apply mul_right_cancel₀ hQt_ne
        have hmul_val : ((τ_sub * ⟨Polynomial.aeval t P₁ * (Polynomial.aeval t Q)⁻¹, hu_mem⟩ : ↥R_sub) : F) =
            τ_c * (Polynomial.aeval t P₁ * (Polynomial.aeval t Q)⁻¹) := rfl
        rw [hmul_val]
        calc (a : F) * Polynomial.aeval t Q
            = Polynomial.aeval t P := haQ
          _ = Polynomial.aeval t (Polynomial.X - Polynomial.C c) * Polynomial.aeval t P₁ := by
              rw [hP₁, map_mul]
          _ = τ_c * ((Polynomial.aeval t P₁ * (Polynomial.aeval t Q)⁻¹) * Polynomial.aeval t Q) := by
              rw [mul_assoc _ _ (Polynomial.aeval t Q), inv_mul_cancel₀ hQt_ne, mul_one]
              simp [τ_c]
          _ = (τ_c * (Polynomial.aeval t P₁ * (Polynomial.aeval t Q)⁻¹)) * Polynomial.aeval t Q := by
              ring
      · rintro ⟨u, rfl⟩
        rw [map_mul, hπ_τ, zero_mul]

    have hIC : IsIntegrallyClosed ↥R_sub := by
      rw [isIntegrallyClosed_iff ↥K₀]
      intro x hx_int
      obtain ⟨a₀, b₀, hb₀_ne, hbx₀⟩ := hK₀_le_frac x.2
      obtain ⟨P_a, Q_a, hQac, ha_eq⟩ := a₀.2
      obtain ⟨P_b, Q_b, hQbc, hb_eq⟩ := b₀.2
      have hPb_ne : P_b ≠ 0 := by
        intro h0
        rw [h0, map_zero] at hb_eq
        exact hb₀_ne (Subtype.ext ((mul_eq_zero.mp hb_eq).resolve_right (haeval_ne_of_eval_ne hQbc)))
      have hQa_ne : Q_a ≠ 0 := fun h0 => hQac (by rw [h0, Polynomial.eval_zero])
      let P₀ : Polynomial Ω := P_a * Q_b
      let Q₀ : Polynomial Ω := P_b * Q_a
      have hQ₀_ne : Q₀ ≠ 0 := mul_ne_zero hPb_ne hQa_ne
      have hxQ₀ : (x : F) * Polynomial.aeval t Q₀ = Polynomial.aeval t P₀ := by
        dsimp [P₀, Q₀]
        calc (x : F) * Polynomial.aeval t (P_b * Q_a)
            = (x : F) * ((b₀ : F) * Polynomial.aeval t Q_b) * Polynomial.aeval t Q_a := by
              rw [map_mul, ← hb_eq]; ring
          _ = ((b₀ : F) * (x : F)) * Polynomial.aeval t Q_a * Polynomial.aeval t Q_b := by ring
          _ = Polynomial.aeval t (P_a * Q_b) := by rw [hbx₀, ha_eq, map_mul]
      let g_cd : Polynomial Ω := EuclideanDomain.gcd P₀ Q₀
      obtain ⟨P, hP_eq⟩ := EuclideanDomain.gcd_dvd_left P₀ Q₀
      obtain ⟨Q, hQ_eq⟩ := EuclideanDomain.gcd_dvd_right P₀ Q₀
      have hg_ne : g_cd ≠ 0 := by
        intro h0
        apply hQ₀_ne
        dsimp [g_cd] at h0
        rw [hQ_eq, h0, zero_mul]
      have hBez : P * EuclideanDomain.gcdA P₀ Q₀ + Q * EuclideanDomain.gcdB P₀ Q₀ = 1 := by
        apply mul_left_cancel₀ hg_ne
        have h_ab : g_cd = P₀ * EuclideanDomain.gcdA P₀ Q₀ + Q₀ * EuclideanDomain.gcdB P₀ Q₀ :=
          EuclideanDomain.gcd_eq_gcd_ab P₀ Q₀
        calc g_cd * (P * EuclideanDomain.gcdA P₀ Q₀ + Q * EuclideanDomain.gcdB P₀ Q₀)
            = (g_cd * P) * EuclideanDomain.gcdA P₀ Q₀ + (g_cd * Q) * EuclideanDomain.gcdB P₀ Q₀ := by ring
          _ = g_cd * 1 := by dsimp [g_cd]; rw [← hP_eq, ← hQ_eq, ← h_ab, mul_one]
      have hxQ : (x : F) * Polynomial.aeval t Q = Polynomial.aeval t P := by
        apply mul_left_cancel₀ (haeval_ne_zero hg_ne)
        calc Polynomial.aeval t g_cd * ((x : F) * Polynomial.aeval t Q)
            = (x : F) * Polynomial.aeval t (g_cd * Q) := by rw [map_mul]; ring
          _ = (x : F) * Polynomial.aeval t Q₀ := congrArg ((x : F) * Polynomial.aeval t ·) hQ_eq.symm
          _ = Polynomial.aeval t P₀ := hxQ₀
          _ = Polynomial.aeval t (g_cd * P) := congrArg (Polynomial.aeval t) hP_eq
          _ = Polynomial.aeval t g_cd * Polynomial.aeval t P := map_mul _ g_cd P
      have h_aevalF : ∀ p : Polynomial ↥R_sub,
          (Polynomial.aeval x p : F) = Polynomial.aeval (x : F) p := by
        intro p
        induction p using Polynomial.induction_on' with
        | add p q hp hq =>
          rw [map_add, map_add, AddMemClass.coe_add, hp, hq]
        | monomial k r_k =>
          rw [Polynomial.aeval_monomial, Polynomial.aeval_monomial,
            MulMemClass.coe_mul, SubmonoidClass.coe_pow]
          rfl
      obtain ⟨M, hM_monic, hM_eval⟩ := hx_int
      rw [← Polynomial.aeval_def] at hM_eval
      let n : ℕ := M.natDegree
      have hM_sum : (x : F) ^ n + ∑ j ∈ Finset.range n, ((M.coeff j : ↥R_sub) : F) * (x : F) ^ j = 0 := by
        have h_val : Polynomial.aeval (x : F) M = 0 := by
          rw [← h_aevalF M, hM_eval, ZeroMemClass.coe_zero]
        have hM_decomp := Polynomial.as_sum_range_C_mul_X_pow M
        rw [hM_decomp, Finset.sum_range_succ, hM_monic.coeff_natDegree, map_add, map_sum,
          map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X, map_one, one_mul, add_comm] at h_val
        convert h_val using 2
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
        rfl
      choose P_coeff Q_coeff hQc_coeff h_coeff_eq using fun j : ℕ => (M.coeff j).2
      let D : Polynomial Ω := ∏ j ∈ Finset.range n, Q_coeff j
      have hDc : Polynomial.eval c D ≠ 0 := by
        rw [Polynomial.eval_prod]
        exact Finset.prod_ne_zero_iff.mpr (fun j _ => hQc_coeff j)
      let A_poly : ℕ → Polynomial Ω :=
        fun j => P_coeff j * ∏ l ∈ (Finset.range n).erase j, Q_coeff l
      have hA_eq : ∀ j ∈ Finset.range n,
          ((M.coeff j : ↥R_sub) : F) * Polynomial.aeval t D = Polynomial.aeval t (A_poly j) := by
        intro j hj
        have hD_split : D = Q_coeff j * ∏ l ∈ (Finset.range n).erase j, Q_coeff l :=
          (Finset.mul_prod_erase (Finset.range n) Q_coeff hj).symm
        dsimp [A_poly]
        rw [hD_split, map_mul, ← mul_assoc, h_coeff_eq j, ← map_mul]
      have hPolyRel : D * P ^ n + Q * ∑ j ∈ Finset.range n, A_poly j * P ^ j * Q ^ (n - 1 - j) = 0 := by
        apply hinj_aeval
        rw [map_zero, map_add, map_mul, map_pow, map_mul, map_sum]
        have hTerm : ∀ j ∈ Finset.range n,
            Polynomial.aeval t Q * Polynomial.aeval t (A_poly j * P ^ j * Q ^ (n - 1 - j)) =
            (((M.coeff j : ↥R_sub) : F) * (x : F) ^ j) *
              (Polynomial.aeval t D * (Polynomial.aeval t Q) ^ n) := by
          intro j hj
          have hj_lt : j < n := Finset.mem_range.mp hj
          have h_exp : j + (1 + (n - 1 - j)) = n := by omega
          calc Polynomial.aeval t Q * Polynomial.aeval t (A_poly j * P ^ j * Q ^ (n - 1 - j))
              = Polynomial.aeval t (A_poly j) * (Polynomial.aeval t P) ^ j *
                (Polynomial.aeval t Q ^ 1 * (Polynomial.aeval t Q) ^ (n - 1 - j)) := by
                simp only [map_mul, map_pow, pow_one]; ring
            _ = (((M.coeff j : ↥R_sub) : F) * Polynomial.aeval t D) *
                ((x : F) ^ j * (Polynomial.aeval t Q) ^ j) *
                (Polynomial.aeval t Q) ^ (1 + (n - 1 - j)) := by
                rw [← hA_eq j hj, ← hxQ, mul_pow, ← pow_add]
            _ = (((M.coeff j : ↥R_sub) : F) * (x : F) ^ j) *
                (Polynomial.aeval t D * ((Polynomial.aeval t Q) ^ j *
                  (Polynomial.aeval t Q) ^ (1 + (n - 1 - j)))) := by ring
            _ = (((M.coeff j : ↥R_sub) : F) * (x : F) ^ j) *
                (Polynomial.aeval t D * (Polynomial.aeval t Q) ^ n) := by
                rw [← pow_add, h_exp]
        rw [Finset.mul_sum, Finset.sum_congr rfl hTerm, ← Finset.sum_mul]
        have hHead : Polynomial.aeval t D * (Polynomial.aeval t P) ^ n =
            (x : F) ^ n * (Polynomial.aeval t D * (Polynomial.aeval t Q) ^ n) := by
          rw [← hxQ, mul_pow]; ring
        rw [hHead, ← add_mul, hM_sum, zero_mul]
      have hQc_ne : Polynomial.eval c Q ≠ 0 := by
        intro hQc0
        have hEvalRel := congrArg (Polynomial.eval c) hPolyRel
        simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_pow,
          Polynomial.eval_zero, hQc0, zero_mul, add_zero] at hEvalRel
        have hPn0 : (Polynomial.eval c P) ^ n = 0 :=
          (mul_eq_zero.mp hEvalRel).resolve_left hDc
        rcases Nat.eq_zero_or_pos n with hn0 | hn_pos
        · rw [hn0, pow_zero] at hPn0
          exact one_ne_zero hPn0
        · have hPc0 : Polynomial.eval c P = 0 := by
            by_contra hPc_ne
            exact pow_ne_zero n hPc_ne hPn0
          have hEvalBez := congrArg (Polynomial.eval c) hBez
          simp [hPc0, hQc0] at hEvalBez
      exact ⟨⟨(x : F), ⟨P, Q, hQc_ne, hxQ⟩⟩, Subtype.ext rfl⟩

    exact ⟨R_sub, τ_sub, π_c, fun _ => Iff.rfl, hR_in_K₀, fun k => hK₀_le_frac k.2,
      rfl, hIC, hτ_jac, hπ_τ, hπ_ker⟩

  obtain ⟨R_sub, τ_sub, π_c, hR_mem, hR_in_K₀, hK₀_frac, hτ_val,
    instIC_R, hτ_jac, hπ_τ, hπ_ker⟩ := hStage1
  have _ : IsIntegrallyClosed ↥R_sub := instIC_R

  
  
  
  have hStage2 : ∃ (M_sub : Subalgebra ↥R_sub F),
      (∀ v : F, v ∈ M_sub ↔ ∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) v) ∧
      M_sub = Algebra.adjoin ↥R_sub ({z} : Set F) ∧
      (τ_sub : F) ≠ 0 ∧
      IsIntegral ↥R_sub z ∧
      Algebra.adjoin ↥K₀ ({z} : Set F) = ⊤ := by
    have hR_ord : ∀ (a : ↥R_sub) (k : Fin r), (0 : WithTop ℤ) ≤ ord (P_br k) (a : F) := by
      intro a k
      have hPk : IsPlace (P_br k) := hP_pl k
      have ht_ord : (0 : WithTop ℤ) ≤ ord (P_br k) t := by
        have ht_eq : t = (t - algebraMap Ω F c) + algebraMap Ω F c := (sub_add_cancel t _).symm
        rw [ht_eq]
        refine le_trans ?_ ((hVal.1 (P_br k) hPk).2.2.1 _ _)
        refine le_min ?_ (hOrdAlgNonneg (P_br k) hPk c)
        rw [(he_br k).2]
        exact_mod_cast Nat.zero_le (e_br k)
      have haeval_ord : ∀ H : Polynomial Ω, (0 : WithTop ℤ) ≤ ord (P_br k) (Polynomial.aeval t H) := by
        intro H
        induction H using Polynomial.induction_on' with
        | add p q hp hq =>
          rw [map_add]
          exact le_trans (le_min hp hq) ((hVal.1 (P_br k) hPk).2.2.1 _ _)
        | monomial m α =>
          rw [Polynomial.aeval_monomial, (hVal.1 (P_br k) hPk).2.1]
          have hpow : (0 : WithTop ℤ) ≤ ord (P_br k) (t ^ m) := by
            induction m with
            | zero => rw [pow_zero, hOrdOne (P_br k) hPk]
            | succ m ih =>
              rw [pow_succ, (hVal.1 (P_br k) hPk).2.1]
              exact add_nonneg ih ht_ord
          exact add_nonneg (hOrdAlgNonneg (P_br k) hPk α) hpow
      obtain ⟨P, Q, hQc, haQ⟩ := (hR_mem (a : F)).mp a.2
      have hQ_root : Polynomial.IsRoot (Q - Polynomial.C (Polynomial.eval c Q)) c := by simp
      obtain ⟨Q₁, hQ₁⟩ := Polynomial.dvd_iff_isRoot.mpr hQ_root
      have hQt_ord : ord (P_br k) (Polynomial.aeval t Q) = (0 : WithTop ℤ) := by
        have hQ_eq : Q = Polynomial.C (Polynomial.eval c Q) + (Polynomial.X - Polynomial.C c) * Q₁ := by
          linear_combination hQ₁
        have hQt_split : Polynomial.aeval t Q =
            algebraMap Ω F (Polynomial.eval c Q) +
            (t - algebraMap Ω F c) * Polynomial.aeval t Q₁ := by
          conv_lhs => rw [hQ_eq]
          simp
        rw [hQt_split]
        have hLeft : ord (P_br k) (algebraMap Ω F (Polynomial.eval c Q)) = (0 : WithTop ℤ) :=
          (hVal.1 (P_br k) hPk).2.2.2.1 _ hQc
        have hRight : (1 : WithTop ℤ) ≤ ord (P_br k) ((t - algebraMap Ω F c) * Polynomial.aeval t Q₁) := by
          rw [(hVal.1 (P_br k) hPk).2.1, (he_br k).2]
          have he1 : (1 : WithTop ℤ) ≤ (e_br k : WithTop ℤ) := by exact_mod_cast (he_br k).1
          exact le_trans (by simpa using he1) (add_le_add le_rfl (haeval_ord Q₁))
        have hlt_ord : ord (P_br k) (algebraMap Ω F (Polynomial.eval c Q)) <
            ord (P_br k) ((t - algebraMap Ω F c) * Polynomial.aeval t Q₁) := by
          rw [hLeft]
          exact lt_of_lt_of_le (by decide : (0 : WithTop ℤ) < 1) hRight
        rw [hOrdAddOfLt (P_br k) hPk _ _ hlt_ord, hLeft]
      have hProdOrd := (hVal.1 (P_br k) hPk).2.1 (a : F) (Polynomial.aeval t Q)
      rw [haQ, hQt_ord, add_zero] at hProdOrd
      rw [← hProdOrd]
      exact haeval_ord P

    let M_sub : Subalgebra ↥R_sub F :=
      { carrier := {v : F | ∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) v}
        algebraMap_mem' := hR_ord
        add_mem' := fun {v₁ v₂} hv₁ hv₂ k =>
          le_trans (le_min (hv₁ k) (hv₂ k)) ((hVal.1 (P_br k) (hP_pl k)).2.2.1 v₁ v₂)
        mul_mem' := fun {v₁ v₂} hv₁ hv₂ k => by
          rw [(hVal.1 (P_br k) (hP_pl k)).2.1]
          exact add_nonneg (hv₁ k) (hv₂ k) }

    have hAz_le_M : Algebra.adjoin ↥R_sub ({z} : Set F) ≤ M_sub := by
      rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
      exact hz_mem

    have hM_fg : M_sub.toSubmodule.FG := by
      refine ⟨s_gen, le_antisymm ?_ ?_⟩
      · rw [Submodule.span_le]
        exact hs_sub
      · intro v hv
        obtain ⟨coeff, hcoeff_mem, hv_eq⟩ := hs_span v hv
        rw [hv_eq]
        refine Submodule.sum_mem _ fun g hg => ?_
        have hcR : coeff g ∈ R_sub := (hR_mem _).mpr (hcoeff_mem g hg)
        change (⟨coeff g, hcR⟩ : ↥R_sub) • g ∈ Submodule.span ↥R_sub (↑s_gen : Set F)
        exact Submodule.smul_mem _ _ (Submodule.subset_span hg)

    have haeval_z_mem_Az : ∀ H : Polynomial Ω,
        Polynomial.aeval z H ∈ Algebra.adjoin ↥R_sub ({z} : Set F) := by
      intro H
      induction H using Polynomial.induction_on' with
      | add p q hp hq =>
        rw [map_add]
        exact (Algebra.adjoin ↥R_sub ({z} : Set F)).add_mem hp hq
      | monomial m α =>
        rw [Polynomial.aeval_monomial]
        exact (Algebra.adjoin ↥R_sub ({z} : Set F)).mul_mem
          ((Algebra.adjoin ↥R_sub ({z} : Set F)).algebraMap_mem (algebraMap Ω ↥R_sub α))
          ((Algebra.adjoin ↥R_sub ({z} : Set F)).pow_mem
            (Algebra.subset_adjoin (Set.mem_singleton z)) m)

    have hBranchApprox : ∀ (b : F), b ∈ M_sub → ∀ (k : Fin r) (m : ℕ),
        ∃ P : Polynomial Ω, ((m : ℤ) : WithTop ℤ) ≤ ord (P_br k) (b - Polynomial.aeval z P) := by
      intro b hb k m
      have hPk : IsPlace (P_br k) := hP_pl k
      let z_k : F := z - algebraMap Ω F (c_br k)
      have hzk_ord : ord (P_br k) z_k = (1 : WithTop ℤ) := hz_ord k
      have hzk_ne : z_k ≠ 0 := by
        intro h0
        rw [h0, hOrdZero (P_br k) hPk] at hzk_ord
        exact WithTop.top_ne_coe hzk_ord
      induction m with
      | zero =>
        refine ⟨0, ?_⟩
        simpa using hb k
      | succ m ih =>
        obtain ⟨P_m, hPm⟩ := ih
        have hzkm_ord : ord (P_br k) (z_k ^ m) = ((m : ℤ) : WithTop ℤ) := by
          simpa using hOrdPowEq (P_br k) hPk z_k 1 m hzk_ord
        have hzkm_inv_ord := hOrdInvEq (P_br k) hPk (z_k ^ m) (m : ℤ) hzkm_ord
        let Δ_m : F := (b - Polynomial.aeval z P_m) * (z_k ^ m)⁻¹
        have hΔ_nonneg : (0 : WithTop ℤ) ≤ ord (P_br k) Δ_m := by
          dsimp [Δ_m]
          rw [(hVal.1 (P_br k) hPk).2.1, hzkm_inv_ord]
          cases h_ob : ord (P_br k) (b - Polynomial.aeval z P_m) with
          | top => simp
          | coe v =>
            rw [h_ob] at hPm
            have hv : (m : ℤ) ≤ v := WithTop.coe_le_coe.mp hPm
            rw [← WithTop.coe_add, ← WithTop.coe_zero, WithTop.coe_le_coe]
            omega
        obtain ⟨α_m, hα_m⟩ := (hVal.1 (P_br k) hPk).2.2.2.2.2 Δ_m hΔ_nonneg
        refine ⟨P_m + Polynomial.C α_m * (Polynomial.X - Polynomial.C (c_br k)) ^ m, ?_⟩
        have hzkm_ne : z_k ^ m ≠ 0 := pow_ne_zero m hzk_ne
        have hDiffEq : b - Polynomial.aeval z
            (P_m + Polynomial.C α_m * (Polynomial.X - Polynomial.C (c_br k)) ^ m) =
            (Δ_m - algebraMap Ω F α_m) * z_k ^ m := by
          simp only [map_add, map_mul, map_pow, Polynomial.aeval_C, map_sub, Polynomial.aeval_X]
          change b - (Polynomial.aeval z P_m + algebraMap Ω F α_m * z_k ^ m) =
            ((b - Polynomial.aeval z P_m) * (z_k ^ m)⁻¹ - algebraMap Ω F α_m) * z_k ^ m
          rw [sub_mul, mul_assoc, inv_mul_cancel₀ hzkm_ne, mul_one, sub_add_eq_sub_sub]
        rw [hDiffEq, (hVal.1 (P_br k) hPk).2.1, hzkm_ord]
        have h1m : ((1 : ℤ) : WithTop ℤ) + ((m : ℤ) : WithTop ℤ) =
            (((m + 1 : ℕ) : ℤ) : WithTop ℤ) := by
          rw [← WithTop.coe_add]; congr 1; omega
        rw [← h1m]
        exact add_le_add hα_m le_rfl

    let M_fac : Fin r → Polynomial Ω := fun k => (Polynomial.X - Polynomial.C (c_br k)) ^ (e_br k)
    let L_fac : Fin r → Polynomial Ω := fun k => ∏ l ∈ Finset.univ.erase k, M_fac l
    have hCoprime_ML : ∀ k : Fin r, IsCoprime (M_fac k) (L_fac k) := by
      intro k
      apply IsCoprime.prod_right
      intro l hl
      have hkl : k ≠ l := (Finset.ne_of_mem_erase hl).symm
      exact (Polynomial.isCoprime_X_sub_C_of_isUnit_sub
        (IsUnit.mk0 _ (sub_ne_zero.mpr (hc_inj.ne hkl)))).pow
    choose A_bez B_bez hBez_ML using hCoprime_ML

    have hk0_fin : Fin r := ⟨0, by omega⟩
    have hτ_ne_zero : (τ_sub : F) ≠ 0 := by
      intro h0
      have h := (he_br hk0_fin).2
      rw [← hτ_val, h0, hOrdZero (P_br hk0_fin) (hP_pl hk0_fin)] at h
      exact WithTop.top_ne_coe h

    have hM_le_Az : M_sub ≤ Algebra.adjoin ↥R_sub ({z} : Set F) := by
      change M_sub.toSubmodule ≤ (Algebra.adjoin ↥R_sub ({z} : Set F)).toSubmodule
      apply Submodule.le_of_le_smul_of_le_jacobson_bot hM_fg hτ_jac
      intro b hb
      choose P_loc hP_loc using fun k : Fin r => hBranchApprox b hb k (e_br k)
      let P_tot : Polynomial Ω := ∑ k : Fin r, P_loc k * B_bez k * L_fac k
      have hP_tot_ord : ∀ k₀ : Fin r,
          ((e_br k₀ : ℤ) : WithTop ℤ) ≤ ord (P_br k₀) (b - Polynomial.aeval z P_tot) := by
        intro k₀
        have hPk₀ : IsPlace (P_br k₀) := hP_pl k₀
        let z_k₀ : F := z - algebraMap Ω F (c_br k₀)
        have hzk₀_pow : ord (P_br k₀) (z_k₀ ^ (e_br k₀)) = ((e_br k₀ : ℤ) : WithTop ℤ) := by
          simpa using hOrdPowEq (P_br k₀) hPk₀ z_k₀ 1 (e_br k₀) (hz_ord k₀)
        have hSumSplit : Polynomial.aeval z P_tot =
            Polynomial.aeval z (P_loc k₀ * B_bez k₀ * L_fac k₀) +
            ∑ k ∈ Finset.univ.erase k₀, Polynomial.aeval z (P_loc k * B_bez k * L_fac k) := by
          dsimp [P_tot]
          rw [map_sum, ← Finset.add_sum_erase _ _ (Finset.mem_univ k₀)]
        have hDiffSplit : b - Polynomial.aeval z P_tot =
            (b - Polynomial.aeval z (P_loc k₀ * B_bez k₀ * L_fac k₀)) +
            (-(∑ k ∈ Finset.univ.erase k₀, Polynomial.aeval z (P_loc k * B_bez k * L_fac k))) := by
          rw [hSumSplit]; ring
        rw [hDiffSplit]
        refine le_trans ?_ ((hVal.1 (P_br k₀) hPk₀).2.2.1 _ _)
        refine le_min ?_ ?_
        · have hBL_eq : B_bez k₀ * L_fac k₀ = 1 - A_bez k₀ * M_fac k₀ := by
            linear_combination hBez_ML k₀
          have hMainEq : b - Polynomial.aeval z (P_loc k₀ * B_bez k₀ * L_fac k₀) =
              (b - Polynomial.aeval z (P_loc k₀)) +
              Polynomial.aeval z (P_loc k₀ * A_bez k₀) * z_k₀ ^ (e_br k₀) := by
            have hM_eval : Polynomial.aeval z (M_fac k₀) = z_k₀ ^ (e_br k₀) := by
              simp [M_fac, z_k₀]
            rw [mul_assoc (P_loc k₀), hBL_eq, mul_sub, mul_one, map_sub]
            simp only [map_mul, hM_eval]
            ring
          rw [hMainEq]
          refine le_trans ?_ ((hVal.1 (P_br k₀) hPk₀).2.2.1 _ _)
          refine le_min (hP_loc k₀) ?_
          rw [(hVal.1 (P_br k₀) hPk₀).2.1, hzk₀_pow]
          have h_nonneg : (0 : WithTop ℤ) ≤ ord (P_br k₀) (Polynomial.aeval z (P_loc k₀ * A_bez k₀)) :=
            hAz_le_M (haeval_z_mem_Az _) k₀
          simpa using add_le_add h_nonneg le_rfl
        · rw [hOrdNeg (P_br k₀) hPk₀]
          apply hOrdSumGe (P_br k₀) hPk₀
          intro k hk
          have hne : k₀ ≠ k := (Finset.ne_of_mem_erase hk).symm
          have hk₀_mem : k₀ ∈ Finset.univ.erase k :=
            Finset.mem_erase.mpr ⟨hne, Finset.mem_univ k₀⟩
          obtain ⟨E_k, hEk⟩ := Finset.dvd_prod_of_mem M_fac hk₀_mem
          have hTermEq : Polynomial.aeval z (P_loc k * B_bez k * L_fac k) =
              Polynomial.aeval z (P_loc k * B_bez k * E_k) * z_k₀ ^ (e_br k₀) := by
            dsimp only [L_fac]
            rw [hEk, ← mul_assoc, mul_right_comm (P_loc k * B_bez k) (M_fac k₀) E_k, map_mul]
            simp [M_fac, z_k₀]
          rw [hTermEq, (hVal.1 (P_br k₀) hPk₀).2.1, hzk₀_pow]
          have h_nonneg : (0 : WithTop ℤ) ≤ ord (P_br k₀) (Polynomial.aeval z (P_loc k * B_bez k * E_k)) :=
            hAz_le_M (haeval_z_mem_Az _) k₀
          simpa using add_le_add h_nonneg le_rfl
      let m_b : F := (τ_sub : F)⁻¹ * (b - Polynomial.aeval z P_tot)
      have hm_b_mem : m_b ∈ M_sub.toSubmodule := by
        intro k
        dsimp [m_b]
        have hτ_ord : ord (P_br k) (τ_sub : F) = ((e_br k : ℤ) : WithTop ℤ) := by
          rw [hτ_val]; exact (he_br k).2
        rw [(hVal.1 (P_br k) (hP_pl k)).2.1,
          hOrdInvEq (P_br k) (hP_pl k) (τ_sub : F) (e_br k : ℤ) hτ_ord]
        have h_ge := hP_tot_ord k
        cases h_ob : ord (P_br k) (b - Polynomial.aeval z P_tot) with
        | top => simp
        | coe v =>
          rw [h_ob] at h_ge
          have hv : (e_br k : ℤ) ≤ v := WithTop.coe_le_coe.mp h_ge
          rw [← WithTop.coe_add, ← WithTop.coe_zero, WithTop.coe_le_coe]
          omega
      have hb_eq : b = Polynomial.aeval z P_tot + τ_sub • m_b := by
        change b = Polynomial.aeval z P_tot + (τ_sub : F) * ((τ_sub : F)⁻¹ * (b - Polynomial.aeval z P_tot))
        rw [← mul_assoc, mul_inv_cancel₀ hτ_ne_zero, one_mul, add_sub_cancel]
      rw [hb_eq]
      exact Submodule.add_mem_sup (haeval_z_mem_Az P_tot)
        (Submodule.smul_mem_smul (Ideal.mem_span_singleton_self τ_sub) hm_b_mem)

    have hM_eq_Az : M_sub = Algebra.adjoin ↥R_sub ({z} : Set F) :=
      le_antisymm hM_le_Az hAz_le_M

    have hz_int_R : IsIntegral ↥R_sub z := by
      have h_gen_in_Az : ∀ g ∈ s_gen, ∃ Q : Polynomial ↥R_sub, Polynomial.aeval z Q = g := by
        intro g hg
        have hgA : g ∈ Algebra.adjoin ↥R_sub ({z} : Set F) := hM_eq_Az ▸ hs_sub hg
        rwa [Algebra.adjoin_singleton_eq_range_aeval] at hgA
      let Q_fn : F → Polynomial ↥R_sub := fun g =>
        if hg : g ∈ s_gen then Classical.choose (h_gen_in_Az g hg) else 0
      have hQ_fn_spec : ∀ g ∈ s_gen, Polynomial.aeval z (Q_fn g) = g := by
        intro g hg
        simp only [Q_fn, hg, ↓reduceDIte]
        exact Classical.choose_spec (h_gen_in_Az g hg)
      let N_deg : ℕ := s_gen.sup (fun g => (Q_fn g).natDegree)
      obtain ⟨coeff_z, hcoeff_z, hz_pow_eq⟩ :=
        hs_span (z ^ (N_deg + 1)) (M_sub.pow_mem hz_mem (N_deg + 1))
      let c_sub : F → ↥R_sub := fun g =>
        if hg : g ∈ s_gen then ⟨coeff_z g, (hR_mem _).mpr (hcoeff_z g hg)⟩ else 0
      let R_poly : Polynomial ↥R_sub := ∑ g ∈ s_gen, Polynomial.C (c_sub g) * Q_fn g
      have hR_deg_lt : R_poly.degree < ((N_deg + 1 : ℕ) : WithBot ℕ) := by
        by_cases hR0 : R_poly = 0
        · rw [hR0, Polynomial.degree_zero]; exact WithBot.bot_lt_coe _
        · rw [Polynomial.degree_eq_natDegree hR0]
          exact WithBot.coe_lt_coe.mpr (Nat.lt_succ_of_le (le_trans (Polynomial.natDegree_sum_le _ _)
            (Finset.sup_le fun g hg => le_trans (Polynomial.natDegree_C_mul_le _ _)
              (Finset.le_sup (f := fun g => (Q_fn g).natDegree) hg))))
      refine ⟨Polynomial.X ^ (N_deg + 1) - R_poly, Polynomial.monic_X_pow_sub hR_deg_lt, ?_⟩
      rw [← Polynomial.aeval_def, map_sub, map_pow, Polynomial.aeval_X, sub_eq_zero, hz_pow_eq]
      dsimp [R_poly]
      rw [map_sum]
      refine Finset.sum_congr rfl fun g hg => ?_
      rw [map_mul, Polynomial.aeval_C, hQ_fn_spec g hg]
      simp only [c_sub, hg, ↓reduceDIte]
      rfl

    have hAz_le_K₀z : ∀ x ∈ Algebra.adjoin ↥R_sub ({z} : Set F),
        x ∈ Algebra.adjoin ↥K₀ ({z} : Set F) := by
      intro x hx
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hx
      · intro y hy; exact Algebra.subset_adjoin hy
      · intro a; exact (Algebra.adjoin ↥K₀ ({z} : Set F)).algebraMap_mem ⟨(a : F), hR_in_K₀ a⟩
      · intro u v _ _ hu hv; exact (Algebra.adjoin ↥K₀ ({z} : Set F)).add_mem hu hv
      · intro u v _ _ hu hv; exact (Algebra.adjoin ↥K₀ ({z} : Set F)).mul_mem hu hv

    have hz_gen_K₀ : Algebra.adjoin ↥K₀ ({z} : Set F) = ⊤ := by
      rw [eq_top_iff]
      intro u _
      obtain ⟨a, ha_ne, ha_ord⟩ := hClear u
      have hau_Az : Polynomial.aeval t a * u ∈ Algebra.adjoin ↥R_sub ({z} : Set F) :=
        hM_eq_Az ▸ ha_ord
      have hau_K₀z : Polynomial.aeval t a * u ∈ Algebra.adjoin ↥K₀ ({z} : Set F) :=
        hAz_le_K₀z _ hau_Az
      have hat_ne : Polynomial.aeval t a ≠ 0 := haeval_ne_zero ha_ne
      let k_inv : ↥K₀ := ⟨(Polynomial.aeval t a)⁻¹, K₀.inv_mem (haeval_in_K₀ a)⟩
      have hu_eq : u = (algebraMap ↥K₀ F k_inv) * (Polynomial.aeval t a * u) := by
        change u = (Polynomial.aeval t a)⁻¹ * (Polynomial.aeval t a * u)
        rw [← mul_assoc, inv_mul_cancel₀ hat_ne, one_mul]
      rw [hu_eq]
      exact (Algebra.adjoin ↥K₀ ({z} : Set F)).mul_mem
        ((Algebra.adjoin ↥K₀ ({z} : Set F)).algebraMap_mem k_inv) hau_K₀z

    exact ⟨M_sub, fun _ => Iff.rfl, hM_eq_Az, hτ_ne_zero, hz_int_R, hz_gen_K₀⟩

  obtain ⟨M_sub, hM_mem, hM_eq_Az, hτ_ne_zero, hz_int_R, hz_gen_K₀⟩ := hStage2

  
  let φ_RK₀ : ↥R_sub →+* ↥K₀ :=
    { toFun := fun a => ⟨(a : F), hR_in_K₀ a⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let _ : Algebra ↥R_sub ↥K₀ := φ_RK₀.toAlgebra
  have _ : IsScalarTower ↥R_sub ↥K₀ F := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hRK₀_val : ∀ a : ↥R_sub, ((algebraMap ↥R_sub ↥K₀ a : ↥K₀) : F) = (a : F) :=
    fun _ => rfl
  have hinj_RK₀ : Function.Injective (algebraMap ↥R_sub ↥K₀) :=
    fun _ _ h => Subtype.ext (congrArg (Subtype.val : ↥K₀ → F) h)
  have _ : FaithfulSMul ↥R_sub ↥K₀ :=
    (faithfulSMul_iff_algebraMap_injective ↥R_sub ↥K₀).mpr hinj_RK₀
  have _ : IsFractionRing ↥R_sub ↥K₀ := by
    apply IsFractionRing.of_field ↥R_sub ↥K₀
    intro x
    obtain ⟨a, b, hb, hbx⟩ := hK₀_frac x
    refine ⟨a, b, ?_⟩
    apply Subtype.ext
    have hbF : (b : F) ≠ 0 := fun h => hb (Subtype.ext h)
    change (x : F) = (a : F) / (b : F)
    rw [eq_div_iff hbF, mul_comm, hbx]

  
  
  
  let G_R : Polynomial ↥R_sub := minpoly ↥R_sub z
  have hGR_monic : G_R.Monic := minpoly.monic hz_int_R
  have hGR_aeval : Polynomial.aeval z G_R = 0 := minpoly.aeval ↥R_sub z
  have hmin_eq : minpoly ↥K₀ z = G_R.map (algebraMap ↥R_sub ↥K₀) :=
    minpoly.isIntegrallyClosed_eq_field_fractions' ↥K₀ hz_int_R
  let G : Polynomial F := G_R.map (algebraMap ↥R_sub F)
  have hG_eq_K₀ : G = (minpoly ↥K₀ z).map (algebraMap ↥K₀ F) := by
    rw [hmin_eq, Polynomial.map_map, ← IsScalarTower.algebraMap_eq]

  let pb : PowerBasis ↥K₀ F :=
    (Algebra.adjoin.powerBasis' hz_int).map
      ((Subalgebra.equivOfEq _ _ hz_gen_K₀).trans Subalgebra.topEquiv)
  have hpb_gen : pb.gen = z := by simp [pb]
  have hpb_dim_min : pb.dim = (minpoly ↥K₀ z).natDegree := by simp [pb]
  let d : ℕ := pb.dim
  have hd_finrank : Module.finrank ↥K₀ F = d := pb.finrank
  have hd_pos : 1 ≤ d := by
    rw [← hd_finrank]
    exact Module.finrank_pos
  have hGR_deg : G_R.natDegree = d := by
    have h := hGR_monic.natDegree_map (algebraMap ↥R_sub ↥K₀)
    rw [← hmin_eq, ← hpb_dim_min] at h
    exact h.symm
  have hG_monic : G.Monic := hGR_monic.map (algebraMap ↥R_sub F)
  have hG_deg : G.natDegree = d := (hGR_monic.natDegree_map (algebraMap ↥R_sub F)).trans hGR_deg
  have hG_coeff_mem : ∀ j : ℕ, G.coeff j ∈ weilRatLocalSet Ω F t c := by
    intro j
    rw [Polynomial.coeff_map]
    exact (hR_mem _).mp (G_R.coeff j).2
  have hG_eval : Polynomial.eval z G = 0 := by
    rw [Polynomial.eval_map, ← Polynomial.aeval_def]
    exact hGR_aeval
  let Δ : F := Polynomial.eval z (Polynomial.derivative G)
  have hΔ_eq : Δ = Polynomial.aeval z (Polynomial.derivative (minpoly ↥K₀ z)) := by
    dsimp [Δ]
    rw [hG_eq_K₀, Polynomial.derivative_map, Polynomial.eval_map, ← Polynomial.aeval_def]
  have hΔ_ne : Δ ≠ 0 := by
    rw [hΔ_eq]
    exact (Algebra.IsSeparable.isSeparable ↥K₀ z).aeval_derivative_ne_zero (minpoly.aeval ↥K₀ z)

  have hBasis_span : ∀ b ∈ Algebra.adjoin ↥R_sub ({z} : Set F), ∃ m : Fin d → ↥R_sub,
      b = ∑ i : Fin d, (m i : F) * z ^ (i : ℕ) := by
    intro b hb
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hb
    obtain ⟨P, rfl⟩ := hb
    let R_rem : Polynomial ↥R_sub := P %ₘ G_R
    have hP_div : P = R_rem + G_R * (P /ₘ G_R) := (Polynomial.modByMonic_add_div P G_R).symm
    have heval_eq : Polynomial.aeval z P = Polynomial.aeval z R_rem := by
      conv_lhs => rw [hP_div]
      rw [map_add, map_mul, hGR_aeval, zero_mul, add_zero]
    change ∃ m : Fin d → ↥R_sub, Polynomial.aeval z P = ∑ i : Fin d, (m i : F) * z ^ (i : ℕ)
    rw [heval_eq]
    by_cases hR0 : R_rem = 0
    · refine ⟨0, ?_⟩
      rw [hR0, map_zero]
      simp
    · have hdeg_lt : R_rem.degree < G_R.degree := Polynomial.degree_modByMonic_lt P hGR_monic
      rw [Polynomial.degree_eq_natDegree hR0, Polynomial.degree_eq_natDegree hGR_monic.ne_zero,
        hGR_deg] at hdeg_lt
      have hdeg_nat : R_rem.natDegree < d := by exact_mod_cast hdeg_lt
      have hR_sum : R_rem = ∑ j ∈ Finset.range d, Polynomial.C (R_rem.coeff j) * Polynomial.X ^ j := by
        conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow R_rem]
        refine Finset.sum_subset (Finset.range_mono (Nat.succ_le_of_lt hdeg_nat)) ?_
        intro j _ hj_not
        have hj_gt : R_rem.natDegree < j := by rw [Finset.mem_range] at hj_not; omega
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt hj_gt, map_zero, zero_mul]
      refine ⟨fun i => R_rem.coeff (i : ℕ), ?_⟩
      conv_lhs => rw [hR_sum]
      rw [map_sum, ← Fin.sum_univ_eq_sum_range]
      refine Finset.sum_congr rfl fun i _ => ?_
      simp only [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
      rfl

  have hpb_basis : ∀ i : Fin d, pb.basis i = z ^ (i : ℕ) := by
    intro i
    rw [PowerBasis.basis_eq_pow, hpb_gen]

  have hBasis_indep : ∀ m : Fin d → ↥R_sub,
      (∑ i : Fin d, (m i : F) * z ^ (i : ℕ)) = 0 → ∀ i : Fin d, m i = 0 := by
    intro m hm0 i
    have hlin : ∑ j : Fin d, (algebraMap ↥R_sub ↥K₀ (m j)) • pb.basis j = 0 := by
      rw [← hm0]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [hpb_basis j, Algebra.smul_def, IntermediateField.algebraMap_apply, hRK₀_val]
    exact hinj_RK₀ ((Fintype.linearIndependent_iff.mp pb.basis.linearIndependent _ hlin i).trans
      (map_zero _).symm)

  let Q : Polynomial F := minpolyDiv ↥K₀ z
  have hQ_eq_R : minpolyDiv ↥R_sub z = Q := minpolyDiv_eq_of_isIntegrallyClosed ↥K₀ hz_int_R
  let S_Q : Submodule ↥R_sub F := Submodule.span ↥R_sub (Set.range fun i : Fin d => Q.coeff (i : ℕ))

  have hSQ_le_Az : S_Q ≤ (Algebra.adjoin ↥R_sub ({z} : Set F)).toSubmodule := by
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    rw [← hQ_eq_R]
    exact coeff_minpolyDiv_mem_adjoin z (i : ℕ)

  have hQ_monic : Q.Monic := minpolyDiv_monic hz_int
  have hQ_deg : Q.natDegree = d - 1 := by
    rw [natDegree_minpolyDiv, ← hpb_dim_min]
  have hQ_top : Q.coeff (d - 1) = 1 := hQ_deg ▸ hQ_monic.coeff_natDegree
  have hQ_rec : ∀ j : ℕ, Q.coeff j = ((G_R.coeff (j + 1) : ↥R_sub) : F) + Q.coeff (j + 1) * z := by
    intro j
    rw [← hQ_eq_R]
    exact coeff_minpolyDiv ↥R_sub z j

  let T_span : ℕ → Submodule ↥R_sub F :=
    fun m => Submodule.span ↥R_sub ((fun k : ℕ => z ^ k) '' ↑(Finset.range m))
  have hT_mul_z : ∀ (m : ℕ) {w : F}, w ∈ T_span m → w * z ∈ T_span (m + 1) := by
    intro m w hw
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hw
    · rintro _ ⟨k, hk, rfl⟩
      rw [← pow_succ]
      apply Submodule.subset_span
      refine ⟨k + 1, ?_, rfl⟩
      rw [Finset.mem_coe, Finset.mem_range] at hk ⊢
      omega
    · rw [zero_mul]; exact (T_span (m + 1)).zero_mem
    · intro x y _ _ hx hy; rw [add_mul]; exact (T_span (m + 1)).add_mem hx hy
    · intro a x _ hx; rw [smul_mul_assoc]; exact (T_span (m + 1)).smul_mem a hx

  have hUnitri : ∀ m : ℕ, m < d → Q.coeff (d - 1 - m) - z ^ m ∈ T_span m := by
    intro m
    induction m with
    | zero =>
      intro _
      simp only [Nat.sub_zero, pow_zero, hQ_top, sub_self]
      exact (T_span 0).zero_mem
    | succ m ih =>
      intro hm1
      have hm : m < d := Nat.lt_of_succ_lt hm1
      have hj_succ : (d - 1 - (m + 1)) + 1 = d - 1 - m := by omega
      have h_step : Q.coeff (d - 1 - (m + 1)) - z ^ (m + 1) =
          (G_R.coeff (d - 1 - m)) • (z ^ 0) + (Q.coeff (d - 1 - m) - z ^ m) * z := by
        rw [hQ_rec (d - 1 - (m + 1)), hj_succ, pow_zero, pow_succ]
        change ((G_R.coeff (d - 1 - m) : ↥R_sub) : F) + Q.coeff (d - 1 - m) * z - z ^ m * z =
          ((G_R.coeff (d - 1 - m) : ↥R_sub) : F) * 1 + (Q.coeff (d - 1 - m) - z ^ m) * z
        ring
      rw [h_step]
      refine (T_span (m + 1)).add_mem ?_ (hT_mul_z m (ih hm))
      refine (T_span (m + 1)).smul_mem _ (Submodule.subset_span ⟨0, ?_, rfl⟩)
      simp

  have hz_pow_SQ : ∀ m : ℕ, m < d → z ^ m ∈ S_Q := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
      intro hm
      have hTm_le : T_span m ≤ S_Q := by
        rw [Submodule.span_le]
        rintro _ ⟨k, hk, rfl⟩
        rw [Finset.mem_coe, Finset.mem_range] at hk
        exact ih k hk (lt_trans hk hm)
      have hdiff_in : Q.coeff (d - 1 - m) - z ^ m ∈ S_Q := hTm_le (hUnitri m hm)
      have hQ_in : Q.coeff (d - 1 - m) ∈ S_Q :=
        Submodule.subset_span ⟨⟨d - 1 - m, by omega⟩, rfl⟩
      have h_eq : z ^ m = Q.coeff (d - 1 - m) - (Q.coeff (d - 1 - m) - z ^ m) := by ring
      rw [h_eq]
      exact S_Q.sub_mem hQ_in hdiff_in

  have hAz_le_SQ : (Algebra.adjoin ↥R_sub ({z} : Set F)).toSubmodule ≤ S_Q := by
    intro b hb
    obtain ⟨m, rfl⟩ := hBasis_span b hb
    refine Submodule.sum_mem S_Q fun i _ => ?_
    change (m i) • z ^ (i : ℕ) ∈ S_Q
    exact S_Q.smul_mem (m i) (hz_pow_SQ (i : ℕ) i.2)

  have hSQ_eq_M : S_Q = M_sub.toSubmodule :=
    le_antisymm (hM_eq_Az.symm ▸ hSQ_le_Az) (hM_eq_Az.symm ▸ hAz_le_SQ)

  have hΔ_dual : ∀ i : Fin d, Δ * pb.basis.traceDual i = Q.coeff (i : ℕ) := by
    intro i
    rw [Module.Basis.traceDual_powerBasis_eq pb i, hpb_gen]
    change Δ * (Q.coeff (i : ℕ) / Polynomial.aeval z (Polynomial.derivative (minpoly ↥K₀ z))) =
      Q.coeff (i : ℕ)
    rw [← hΔ_eq, mul_div_cancel₀ _ hΔ_ne]

  have hEuler_z' : ∀ z' : F,
      z' = ∑ i : Fin d, (Algebra.trace ↥K₀ F (z' * z ^ (i : ℕ))) • pb.basis.traceDual i := by
    intro z'
    conv_lhs => rw [← pb.basis.traceDual.sum_repr z']
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Module.Basis.traceDual_repr_apply, Algebra.traceForm_apply, hpb_basis i]

  have hTraceDual_iff : ∀ z' : F,
      (∀ b : F, (∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) b) →
        ((Algebra.trace ↥K₀ F (z' * b) : ↥K₀) : F) ∈ weilRatLocalSet Ω F t c) ↔
      (∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) (Δ * z')) := by
    intro z'
    rw [← hM_mem (Δ * z'), ← Subalgebra.mem_toSubmodule, ← hSQ_eq_M]
    constructor
    · intro hTr
      have hΔz' : Δ * z' = ∑ i : Fin d,
          (Algebra.trace ↥K₀ F (z' * z ^ (i : ℕ))) • Q.coeff (i : ℕ) := by
        conv_lhs => rw [hEuler_z' z']
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Algebra.smul_def, Algebra.smul_def, ← hΔ_dual i]
        ring
      rw [hΔz']
      refine Submodule.sum_mem S_Q fun i _ => ?_
      have hzi_ord : ∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) (z ^ (i : ℕ)) :=
        (hM_mem _).mp (M_sub.pow_mem ((hM_mem z).mpr hz_mem) (i : ℕ))
      have htr_mem : ((Algebra.trace ↥K₀ F (z' * z ^ (i : ℕ)) : ↥K₀) : F) ∈ R_sub :=
        (hR_mem _).mpr (hTr (z ^ (i : ℕ)) hzi_ord)
      let r_i : ↥R_sub := ⟨((Algebra.trace ↥K₀ F (z' * z ^ (i : ℕ)) : ↥K₀) : F), htr_mem⟩
      have hr_i_eq : algebraMap ↥R_sub ↥K₀ r_i = Algebra.trace ↥K₀ F (z' * z ^ (i : ℕ)) :=
        Subtype.ext (hRK₀_val r_i)
      rw [← hr_i_eq, IsScalarTower.algebraMap_smul]
      exact S_Q.smul_mem r_i (Submodule.subset_span ⟨i, rfl⟩)
    · intro hMemSQ b hb
      rw [Submodule.mem_span_range_iff_exists_fun] at hMemSQ
      obtain ⟨r_fn, hr_fn⟩ := hMemSQ
      have hSumEq : ∑ i : Fin d, (algebraMap ↥R_sub ↥K₀ (r_fn i)) • pb.basis.traceDual i =
          ∑ i : Fin d, (Algebra.trace ↥K₀ F (z' * z ^ (i : ℕ))) • pb.basis.traceDual i := by
        apply mul_left_cancel₀ hΔ_ne
        rw [← hEuler_z' z', ← hr_fn, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [← hΔ_dual i, IsScalarTower.algebraMap_smul, Algebra.smul_def, Algebra.smul_def]
        ring
      have hr_tr : ∀ i : Fin d,
          Algebra.trace ↥K₀ F (z' * z ^ (i : ℕ)) = algebraMap ↥R_sub ↥K₀ (r_fn i) := by
        intro i
        have hdiff : ∑ j : Fin d,
            (Algebra.trace ↥K₀ F (z' * z ^ (j : ℕ)) - algebraMap ↥R_sub ↥K₀ (r_fn j)) •
              pb.basis.traceDual j = 0 := by
          simp_rw [sub_smul, Finset.sum_sub_distrib, hSumEq, sub_self]
        exact sub_eq_zero.mp
          (Fintype.linearIndependent_iff.mp pb.basis.traceDual.linearIndependent _ hdiff i)
      have hb_Az : b ∈ Algebra.adjoin ↥R_sub ({z} : Set F) := hM_eq_Az ▸ (hM_mem b).mpr hb
      obtain ⟨m_b, rfl⟩ := hBasis_span b hb_Az
      have hzb_eq : z' * ∑ i : Fin d, (m_b i : F) * z ^ (i : ℕ) =
          ∑ i : Fin d, (algebraMap ↥R_sub ↥K₀ (m_b i)) • (z' * z ^ (i : ℕ)) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Algebra.smul_def, IntermediateField.algebraMap_apply, hRK₀_val]
        ring
      have htr_eq : Algebra.trace ↥K₀ F (z' * ∑ i : Fin d, (m_b i : F) * z ^ (i : ℕ)) =
          algebraMap ↥R_sub ↥K₀ (∑ i : Fin d, m_b i * r_fn i) := by
        rw [hzb_eq, map_sum, map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [LinearMap.map_smul, hr_tr i, smul_eq_mul, map_mul]
      rw [htr_eq, hRK₀_val]
      exact (hR_mem _).mp (∑ i : Fin d, m_b i * r_fn i).2

  
  
  
  let G_bar : Polynomial Ω := G_R.map π_c.toRingHom
  let H : Polynomial Ω := ∏ k : Fin r, (Polynomial.X - Polynomial.C (c_br k)) ^ (e_br k)
  have hGbar_monic : G_bar.Monic := hGR_monic.map π_c.toRingHom
  have hGbar_deg : G_bar.natDegree = d := (hGR_monic.natDegree_map π_c.toRingHom).trans hGR_deg
  have hH_monic : H.Monic :=
    Polynomial.monic_prod_of_monic _ _ fun k _ => (Polynomial.monic_X_sub_C (c_br k)).pow (e_br k)
  have hH_deg : H.natDegree = ∑ k : Fin r, e_br k := by
    dsimp [H]
    rw [Polynomial.natDegree_prod_of_monic _ _
      (fun k _ => (Polynomial.monic_X_sub_C (c_br k)).pow (e_br k))]
    simp

  have hH_ord : ∀ k₀ : Fin r, ord (P_br k₀) (Polynomial.aeval z H) = ((e_br k₀ : ℤ) : WithTop ℤ) := by
    intro k₀
    have hPk₀ : IsPlace (P_br k₀) := hP_pl k₀
    dsimp [H]
    rw [map_prod, ← Finset.mul_prod_erase _ _ (Finset.mem_univ k₀), (hVal.1 (P_br k₀) hPk₀).2.1]
    have hHead : ord (P_br k₀) (Polynomial.aeval z ((Polynomial.X - Polynomial.C (c_br k₀)) ^ (e_br k₀))) =
        ((e_br k₀ : ℤ) : WithTop ℤ) := by
      simp only [map_pow, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
      simpa using hOrdPowEq (P_br k₀) hPk₀ _ 1 (e_br k₀) (hz_ord k₀)
    have hTail : ord (P_br k₀)
        (∏ k ∈ Finset.univ.erase k₀, Polynomial.aeval z ((Polynomial.X - Polynomial.C (c_br k)) ^ (e_br k))) =
        (0 : WithTop ℤ) := by
      have hFactor0 : ∀ k ∈ Finset.univ.erase k₀,
          ord (P_br k₀) (Polynomial.aeval z ((Polynomial.X - Polynomial.C (c_br k)) ^ (e_br k))) =
            (0 : WithTop ℤ) := by
        intro k hk
        have hne : k₀ ≠ k := (Finset.ne_of_mem_erase hk).symm
        have hc_ne : c_br k₀ - c_br k ≠ 0 := sub_ne_zero.mpr (hc_inj.ne hne)
        simp only [map_pow, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
        have h_base : ord (P_br k₀) (z - algebraMap Ω F (c_br k)) = (0 : WithTop ℤ) := by
          have h_split : z - algebraMap Ω F (c_br k) =
              algebraMap Ω F (c_br k₀ - c_br k) + (z - algebraMap Ω F (c_br k₀)) := by
            rw [map_sub]; ring
          rw [h_split]
          have hL : ord (P_br k₀) (algebraMap Ω F (c_br k₀ - c_br k)) = (0 : WithTop ℤ) :=
            (hVal.1 (P_br k₀) hPk₀).2.2.2.1 _ hc_ne
          have hR : ord (P_br k₀) (z - algebraMap Ω F (c_br k₀)) = (1 : WithTop ℤ) := hz_ord k₀
          rw [hOrdAddOfLt (P_br k₀) hPk₀ _ _ (by rw [hL, hR]; decide)]
          exact hL
        simpa using hOrdPowEq (P_br k₀) hPk₀ _ 0 (e_br k) h_base
      have hProdZero : ∀ (S : Finset (Fin r)),
          (∀ k ∈ S, ord (P_br k₀) (Polynomial.aeval z ((Polynomial.X - Polynomial.C (c_br k)) ^ (e_br k))) = 0) →
          ord (P_br k₀) (∏ k ∈ S, Polynomial.aeval z ((Polynomial.X - Polynomial.C (c_br k)) ^ (e_br k))) = 0 := by
        intro S hS
        induction S using Finset.induction_on with
        | empty => rw [Finset.prod_empty, hOrdOne (P_br k₀) hPk₀]
        | @insert a s ha ih =>
          rw [Finset.prod_insert ha, (hVal.1 (P_br k₀) hPk₀).2.1,
            hS a (Finset.mem_insert_self a s),
            ih (fun k hk => hS k (Finset.mem_insert_of_mem hk)), add_zero]
      exact hProdZero _ hFactor0
    rw [hHead, hTail, add_zero]
    norm_cast

  have hGH_dvd : G_bar ∣ H := by
    let b_H : F := (τ_sub : F)⁻¹ * Polynomial.aeval z H
    have hbH_M : b_H ∈ M_sub := by
      rw [hM_mem]
      intro k₀
      dsimp [b_H]
      have hτ_ord : ord (P_br k₀) (τ_sub : F) = ((e_br k₀ : ℤ) : WithTop ℤ) := by
        rw [hτ_val]; exact (he_br k₀).2
      rw [(hVal.1 (P_br k₀) (hP_pl k₀)).2.1,
        hOrdInvEq (P_br k₀) (hP_pl k₀) (τ_sub : F) (e_br k₀ : ℤ) hτ_ord,
        hH_ord k₀, ← WithTop.coe_add]
      simp
    obtain ⟨m_H, hm_H⟩ := hBasis_span b_H (hM_eq_Az ▸ hbH_M)
    have hHz_sum : Polynomial.aeval z H =
        ∑ i : Fin d, ((τ_sub * m_H i : ↥R_sub) : F) * z ^ (i : ℕ) := by
      have h_mul : (τ_sub : F) * b_H = Polynomial.aeval z H := by
        dsimp [b_H]
        rw [← mul_assoc, mul_inv_cancel₀ hτ_ne_zero, one_mul]
      rw [← h_mul, hm_H, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      change (τ_sub : F) * ((m_H i : F) * z ^ (i : ℕ)) = ((τ_sub : F) * (m_H i : F)) * z ^ (i : ℕ)
      ring
    let H_R : Polynomial ↥R_sub := H.map (algebraMap Ω ↥R_sub)
    have haeval_HR : Polynomial.aeval z H_R = Polynomial.aeval z H := by
      have h_map : ∀ p : Polynomial Ω,
          Polynomial.aeval z (p.map (algebraMap Ω ↥R_sub)) = Polynomial.aeval z p := by
        intro p
        induction p using Polynomial.induction_on' with
        | add p q hp hq => rw [Polynomial.map_add, map_add, map_add, hp, hq]
        | monomial m α =>
          rw [Polynomial.map_monomial, Polynomial.aeval_monomial, Polynomial.aeval_monomial,
            ← IsScalarTower.algebraMap_apply Ω ↥R_sub F]
      exact h_map H
    let R_rem : Polynomial ↥R_sub := H_R %ₘ G_R
    have hHR_div : H_R = R_rem + G_R * (H_R /ₘ G_R) :=
      (Polynomial.modByMonic_add_div H_R G_R).symm
    have hRrem_aeval : Polynomial.aeval z R_rem =
        ∑ i : Fin d, ((R_rem.coeff (i : ℕ) : ↥R_sub) : F) * z ^ (i : ℕ) := by
      by_cases hR0 : R_rem = 0
      · rw [hR0, map_zero]; simp
      · have hdeg_lt : R_rem.degree < G_R.degree := Polynomial.degree_modByMonic_lt H_R hGR_monic
        rw [Polynomial.degree_eq_natDegree hR0, Polynomial.degree_eq_natDegree hGR_monic.ne_zero,
          hGR_deg] at hdeg_lt
        have hdeg_nat : R_rem.natDegree < d := by exact_mod_cast hdeg_lt
        have hR_sum : R_rem = ∑ j ∈ Finset.range d, Polynomial.C (R_rem.coeff j) * Polynomial.X ^ j := by
          conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow R_rem]
          refine Finset.sum_subset (Finset.range_mono (Nat.succ_le_of_lt hdeg_nat)) ?_
          intro j _ hj_not
          have hj_gt : R_rem.natDegree < j := by rw [Finset.mem_range] at hj_not; omega
          rw [Polynomial.coeff_eq_zero_of_natDegree_lt hj_gt, map_zero, zero_mul]
        conv_lhs => rw [hR_sum]
        rw [map_sum, ← Fin.sum_univ_eq_sum_range]
        refine Finset.sum_congr rfl fun i _ => ?_
        simp only [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
        rfl
    have hDiff0 : ∑ i : Fin d, ((R_rem.coeff (i : ℕ) - τ_sub * m_H i : ↥R_sub) : F) * z ^ (i : ℕ) = 0 := by
      have h_eq : Polynomial.aeval z R_rem = Polynomial.aeval z H := by
        rw [← haeval_HR]
        conv_rhs => rw [hHR_div]
        rw [map_add, map_mul, hGR_aeval, zero_mul, add_zero]
      have h_eq2 : ∑ i : Fin d, ((R_rem.coeff (i : ℕ) : ↥R_sub) : F) * z ^ (i : ℕ) =
          ∑ i : Fin d, ((τ_sub * m_H i : ↥R_sub) : F) * z ^ (i : ℕ) := by
        rw [← hRrem_aeval, h_eq, hHz_sum]
      calc ∑ i : Fin d, ((R_rem.coeff (i : ℕ) - τ_sub * m_H i : ↥R_sub) : F) * z ^ (i : ℕ)
          = (∑ i : Fin d, ((R_rem.coeff (i : ℕ) : ↥R_sub) : F) * z ^ (i : ℕ)) -
            (∑ i : Fin d, ((τ_sub * m_H i : ↥R_sub) : F) * z ^ (i : ℕ)) := by
            rw [← Finset.sum_sub_distrib]
            refine Finset.sum_congr rfl fun i _ => ?_
            push_cast
            ring
        _ = 0 := sub_eq_zero.mpr h_eq2
    have hCoeffEq : ∀ i : Fin d, R_rem.coeff (i : ℕ) = τ_sub * m_H i := fun i =>
      sub_eq_zero.mp (hBasis_indep (fun j => R_rem.coeff (j : ℕ) - τ_sub * m_H j) hDiff0 i)
    have hRrem_map0 : R_rem.map π_c.toRingHom = 0 := by
      ext j
      rw [Polynomial.coeff_map, Polynomial.coeff_zero]
      by_cases hj : j < d
      · have hc := hCoeffEq ⟨j, hj⟩
        dsimp at hc
        rw [hc]
        exact (hπ_ker _).mpr ⟨m_H ⟨j, hj⟩, rfl⟩
      · by_cases hR0 : R_rem = 0
        · rw [hR0, Polynomial.coeff_zero, map_zero]
        · have hdeg_lt : R_rem.degree < G_R.degree := Polynomial.degree_modByMonic_lt H_R hGR_monic
          rw [Polynomial.degree_eq_natDegree hR0, Polynomial.degree_eq_natDegree hGR_monic.ne_zero,
            hGR_deg] at hdeg_lt
          have hdeg_nat : R_rem.natDegree < d := by exact_mod_cast hdeg_lt
          rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), map_zero]
    have hHR_map : H_R.map π_c.toRingHom = H := by
      ext j
      dsimp [H_R]
      rw [Polynomial.coeff_map, Polynomial.coeff_map]
      exact π_c.commutes (H.coeff j)
    refine ⟨(H_R /ₘ G_R).map π_c.toRingHom, ?_⟩
    rw [← hHR_map]
    conv_lhs => rw [hHR_div]
    rw [Polynomial.map_add, Polynomial.map_mul, hRrem_map0, zero_add]

  have hCoeffKer : ∀ j : ℕ, ∃ w : ↥R_sub,
      G_R.coeff j - algebraMap Ω ↥R_sub (G_bar.coeff j) = τ_sub * w := by
    intro j
    apply (hπ_ker _).mp
    rw [map_sub, π_c.commutes, Polynomial.coeff_map]
    exact sub_self _
  choose w_coeff hw_coeff using hCoeffKer

  have hGbar_ord : ∀ k : Fin r, ((e_br k : ℤ) : WithTop ℤ) ≤ ord (P_br k) (Polynomial.aeval z G_bar) := by
    intro k
    have hPk : IsPlace (P_br k) := hP_pl k
    have hGR_sum : Polynomial.aeval z G_R =
        ∑ j ∈ Finset.range (d + 1), ((G_R.coeff j : ↥R_sub) : F) * z ^ j := by
      conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow G_R, hGR_deg]
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
      rfl
    have hGbar_sum : Polynomial.aeval z G_bar =
        ∑ j ∈ Finset.range (d + 1), algebraMap Ω F (G_bar.coeff j) * z ^ j := by
      conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow G_bar, hGbar_deg]
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
    have hGbar_eq : Polynomial.aeval z G_bar =
        (-1 : F) * ((τ_sub : F) * ∑ j ∈ Finset.range (d + 1), (w_coeff j : F) * z ^ j) := by
      calc Polynomial.aeval z G_bar
          = Polynomial.aeval z G_bar - Polynomial.aeval z G_R := by rw [hGR_aeval, sub_zero]
        _ = ∑ j ∈ Finset.range (d + 1),
              (algebraMap Ω F (G_bar.coeff j) - ((G_R.coeff j : ↥R_sub) : F)) * z ^ j := by
            rw [hGbar_sum, hGR_sum, ← Finset.sum_sub_distrib]
            refine Finset.sum_congr rfl fun j _ => by ring
        _ = (-1 : F) * ((τ_sub : F) * ∑ j ∈ Finset.range (d + 1), (w_coeff j : F) * z ^ j) := by
            rw [Finset.mul_sum, Finset.mul_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            have hwj := congrArg (Subtype.val : ↥R_sub → F) (hw_coeff j)
            change ((G_R.coeff j : ↥R_sub) : F) - algebraMap Ω F (G_bar.coeff j) =
              (τ_sub : F) * (w_coeff j : F) at hwj
            linear_combination -hwj * z ^ j
    rw [hGbar_eq, (hVal.1 (P_br k) hPk).2.1, hOrdNegOne (P_br k) hPk, zero_add,
      (hVal.1 (P_br k) hPk).2.1, hτ_val, (he_br k).2]
    have hSumM : (∑ j ∈ Finset.range (d + 1), (w_coeff j : F) * z ^ j) ∈ M_sub := by
      refine M_sub.sum_mem fun j _ =>
        M_sub.mul_mem (M_sub.algebraMap_mem (w_coeff j))
          (M_sub.pow_mem ((hM_mem z).mpr hz_mem) j)
    have h_add := add_le_add (le_rfl : ((e_br k : ℤ) : WithTop ℤ) ≤ ((e_br k : ℤ) : WithTop ℤ))
      ((hM_mem _).mp hSumM k)
    simpa using h_add

  have hBranchDvd : ∀ k : Fin r,
      (Polynomial.X - Polynomial.C (c_br k)) ^ (e_br k) ∣ G_bar := by
    intro k
    have hPk : IsPlace (P_br k) := hP_pl k
    let z_k : F := z - algebraMap Ω F (c_br k)
    have hzk_ord : ord (P_br k) z_k = (1 : WithTop ℤ) := hz_ord k
    have hzk_mem : z_k ∈ M_sub :=
      M_sub.sub_mem ((hM_mem z).mpr hz_mem)
        (M_sub.algebraMap_mem (algebraMap Ω ↥R_sub (c_br k)))
    have haeval_zk_M : ∀ p : Polynomial Ω, Polynomial.aeval z_k p ∈ M_sub := by
      intro p
      induction p using Polynomial.induction_on' with
      | add p q hp hq => rw [map_add]; exact M_sub.add_mem hp hq
      | monomial m α =>
        rw [Polynomial.aeval_monomial]
        exact M_sub.mul_mem (M_sub.algebraMap_mem (algebraMap Ω ↥R_sub α))
          (M_sub.pow_mem hzk_mem m)
    let P_k : Polynomial Ω := G_bar.comp (Polynomial.X + Polynomial.C (c_br k))
    have hPk_aeval : Polynomial.aeval z_k P_k = Polynomial.aeval z G_bar := by
      dsimp [P_k, z_k]
      rw [Polynomial.aeval_comp]
      simp
    let S_k : Polynomial Ω := P_k %ₘ (Polynomial.X ^ (e_br k))
    let T_k : Polynomial Ω := P_k /ₘ (Polynomial.X ^ (e_br k))
    have hPk_div : P_k = S_k + Polynomial.X ^ (e_br k) * T_k :=
      (Polynomial.modByMonic_add_div P_k (Polynomial.X ^ (e_br k))).symm
    have hSk_ord : ((e_br k : ℤ) : WithTop ℤ) ≤ ord (P_br k) (Polynomial.aeval z_k S_k) := by
      have hSk_eq : Polynomial.aeval z_k S_k =
          Polynomial.aeval z G_bar + (-(z_k ^ (e_br k) * Polynomial.aeval z_k T_k)) := by
        have h_eval_div : Polynomial.aeval z_k P_k =
            Polynomial.aeval z_k S_k + z_k ^ (e_br k) * Polynomial.aeval z_k T_k := by
          conv_lhs => rw [hPk_div]
          rw [map_add, map_mul, map_pow, Polynomial.aeval_X]
        linear_combination hPk_aeval - h_eval_div
      rw [hSk_eq]
      refine le_trans ?_ ((hVal.1 (P_br k) hPk).2.2.1 _ _)
      refine le_min (hGbar_ord k) ?_
      rw [hOrdNeg (P_br k) hPk, (hVal.1 (P_br k) hPk).2.1]
      have hpow_ord : ord (P_br k) (z_k ^ (e_br k)) = ((e_br k : ℤ) : WithTop ℤ) := by
        simpa using hOrdPowEq (P_br k) hPk z_k 1 (e_br k) hzk_ord
      rw [hpow_ord]
      simpa using add_le_add le_rfl ((hM_mem _).mp (haeval_zk_M T_k) k)
    have hSk_sum : Polynomial.aeval z_k S_k =
        ∑ j ∈ Finset.range (e_br k), algebraMap Ω F (S_k.coeff j) * z_k ^ j := by
      by_cases hS0 : S_k = 0
      · rw [hS0, map_zero]; simp
      · have hdeg_lt : S_k.degree < (Polynomial.X ^ (e_br k) : Polynomial Ω).degree :=
          Polynomial.degree_modByMonic_lt P_k (Polynomial.monic_X_pow (e_br k))
        rw [Polynomial.degree_eq_natDegree hS0, Polynomial.degree_X_pow] at hdeg_lt
        have hdeg_nat : S_k.natDegree < e_br k := by exact_mod_cast hdeg_lt
        have hS_poly : S_k = ∑ j ∈ Finset.range (e_br k), Polynomial.C (S_k.coeff j) * Polynomial.X ^ j := by
          conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow S_k]
          refine Finset.sum_subset (Finset.range_mono (Nat.succ_le_of_lt hdeg_nat)) ?_
          intro j _ hj_not
          have hj_gt : S_k.natDegree < j := by rw [Finset.mem_range] at hj_not; omega
          rw [Polynomial.coeff_eq_zero_of_natDegree_lt hj_gt, map_zero, zero_mul]
        conv_lhs => rw [hS_poly]
        rw [map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        simp only [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
    have hSk_coeff_lt : ∀ m : ℕ, m < e_br k → S_k.coeff m = 0 := by
      intro m
      induction m using Nat.strong_induction_on with
      | h m ih =>
        intro hm_lt
        by_contra hm_ne
        have hSplitRange : e_br k = (m + 1) + (e_br k - (m + 1)) := by omega
        have hEvalSplit : Polynomial.aeval z_k S_k =
            algebraMap Ω F (S_k.coeff m) * z_k ^ m +
            ∑ l ∈ Finset.range (e_br k - (m + 1)),
              algebraMap Ω F (S_k.coeff (m + 1 + l)) * z_k ^ (m + 1 + l) := by
          rw [hSk_sum]
          conv_lhs => rw [hSplitRange]
          rw [Finset.sum_range_add, Finset.sum_range_succ]
          have hZeroLow : ∑ x ∈ Finset.range m, algebraMap Ω F (S_k.coeff x) * z_k ^ x = 0 := by
            refine Finset.sum_eq_zero fun x hx => ?_
            rw [ih x (Finset.mem_range.mp hx) (lt_trans (Finset.mem_range.mp hx) hm_lt),
              map_zero, zero_mul]
          rw [hZeroLow, zero_add]
        have hLeadOrd : ord (P_br k) (algebraMap Ω F (S_k.coeff m) * z_k ^ m) =
            ((m : ℤ) : WithTop ℤ) := by
          rw [(hVal.1 (P_br k) hPk).2.1, (hVal.1 (P_br k) hPk).2.2.2.1 _ hm_ne, zero_add]
          simpa using hOrdPowEq (P_br k) hPk z_k 1 m hzk_ord
        have hTailOrd : (((m + 1 : ℕ) : ℤ) : WithTop ℤ) ≤
            ord (P_br k) (∑ l ∈ Finset.range (e_br k - (m + 1)),
              algebraMap Ω F (S_k.coeff (m + 1 + l)) * z_k ^ (m + 1 + l)) := by
          apply hOrdSumGe (P_br k) hPk
          intro l _
          rw [(hVal.1 (P_br k) hPk).2.1]
          have hpow_l : ord (P_br k) (z_k ^ (m + 1 + l)) = (((m + 1 + l : ℕ) : ℤ) : WithTop ℤ) := by
            simpa using hOrdPowEq (P_br k) hPk z_k 1 (m + 1 + l) hzk_ord
          rw [hpow_l]
          have h_le : (((m + 1 : ℕ) : ℤ) : WithTop ℤ) ≤ (((m + 1 + l : ℕ) : ℤ) : WithTop ℤ) :=
            WithTop.coe_le_coe.mpr (by omega)
          exact le_trans h_le (by
            simpa using add_le_add (hOrdAlgNonneg (P_br k) hPk (S_k.coeff (m + 1 + l))) le_rfl)
        have hLt : ord (P_br k) (algebraMap Ω F (S_k.coeff m) * z_k ^ m) <
            ord (P_br k) (∑ l ∈ Finset.range (e_br k - (m + 1)),
              algebraMap Ω F (S_k.coeff (m + 1 + l)) * z_k ^ (m + 1 + l)) := by
          rw [hLeadOrd]
          exact lt_of_lt_of_le (WithTop.coe_lt_coe.mpr (by omega)) hTailOrd
        have hOrdEq : ord (P_br k) (Polynomial.aeval z_k S_k) = ((m : ℤ) : WithTop ℤ) := by
          rw [hEvalSplit, hOrdAddOfLt (P_br k) hPk _ _ hLt, hLeadOrd]
        rw [hOrdEq, WithTop.coe_le_coe] at hSk_ord
        omega
    have hSk_eq0 : S_k = 0 := by
      by_contra hS_ne
      have hdeg_lt : S_k.degree < (Polynomial.X ^ (e_br k) : Polynomial Ω).degree :=
        Polynomial.degree_modByMonic_lt P_k (Polynomial.monic_X_pow (e_br k))
      rw [Polynomial.degree_eq_natDegree hS_ne, Polynomial.degree_X_pow] at hdeg_lt
      have hdeg_nat : S_k.natDegree < e_br k := by exact_mod_cast hdeg_lt
      exact Polynomial.leadingCoeff_ne_zero.mpr hS_ne (hSk_coeff_lt S_k.natDegree hdeg_nat)
    have hPk_mul : P_k = Polynomial.X ^ (e_br k) * T_k := by
      rw [hPk_div, hSk_eq0, zero_add]
    refine ⟨T_k.comp (Polynomial.X - Polynomial.C (c_br k)), ?_⟩
    have hCompBack : P_k.comp (Polynomial.X - Polynomial.C (c_br k)) = G_bar := by
      dsimp [P_k]
      rw [Polynomial.comp_assoc]
      have h_id : (Polynomial.X + Polynomial.C (c_br k)).comp
          (Polynomial.X - Polynomial.C (c_br k)) = Polynomial.X := by
        simp
      rw [h_id, Polynomial.comp_X]
    rw [← hCompBack, hPk_mul, Polynomial.mul_comp, Polynomial.pow_comp, Polynomial.X_comp]

  have hHG_dvd : H ∣ G_bar := by
    dsimp [H]
    apply Fintype.prod_dvd_of_coprime
    · intro i j hij
      exact (Polynomial.isCoprime_X_sub_C_of_isUnit_sub
        (IsUnit.mk0 _ (sub_ne_zero.mpr (hc_inj.ne hij)))).pow
    · exact hBranchDvd

  have h_deg_le : H.natDegree ≤ G_bar.natDegree :=
    Polynomial.natDegree_le_of_dvd hHG_dvd hGbar_monic.ne_zero
  have h_assoc : Associated G_bar H :=
    Polynomial.associated_of_dvd_of_natDegree_le hGH_dvd hH_monic.ne_zero h_deg_le
  have hGbar_eq_H : G_bar = H :=
    Polynomial.eq_of_monic_of_associated hGbar_monic hH_monic h_assoc

  have hd_eq_sum : Module.finrank ↥K₀ F = ∑ k : Fin r, e_br k := by
    rw [hd_finrank, ← hGbar_deg, hGbar_eq_H, hH_deg]

  refine ⟨G, hG_monic, hG_deg.trans hd_finrank.symm, hd_eq_sum, hG_coeff_mem,
    hG_eval, hΔ_ne, hTraceDual_iff, ?_⟩
  intro j
  refine ⟨(w_coeff j : F), (hR_mem _).mp (w_coeff j).2, ?_⟩
  have hwj := congrArg (Subtype.val : ↥R_sub → F) (hw_coeff j)
  change ((G_R.coeff j : ↥R_sub) : F) - algebraMap Ω F (G_bar.coeff j) =
    (τ_sub : F) * (w_coeff j : F) at hwj
  change G.coeff j - algebraMap Ω F (H.coeff j) = (t - algebraMap Ω F c) * (w_coeff j : F)
  rw [Polynomial.coeff_map, ← hGbar_eq_H, ← hτ_val]
  exact hwj

theorem weil_taylor_shifted_kaehler_codifferent_ord_eq (Ω X F : Type u) [Field Ω] [Field F] [Algebra Ω F]
    (IsPlace : X → Prop) (ord : X → F → WithTop ℤ)
    (hVal : IsCurvePlaceValuation Ω X F IsPlace ord)
    (t : F) (ht_tr : Transcendental Ω t)
    (c : Ω) (r : ℕ)
    (P_br : Fin r → X) (hP_pl : ∀ k : Fin r, IsPlace (P_br k))
    (e_br : Fin r → ℕ)
    (he_br : ∀ k : Fin r, 1 ≤ e_br k ∧ ord (P_br k) (t - algebraMap Ω F c) = (e_br k : WithTop ℤ))
    (c_br : Fin r → Ω) (hc_inj : Function.Injective c_br)
    (z : F) (hz_ord : ∀ k : Fin r, ord (P_br k) (z - algebraMap Ω F (c_br k)) = (1 : WithTop ℤ))
    (d : ℕ) (hd_eq : d = ∑ k : Fin r, e_br k)
    (G : Polynomial F)
    (hG_monic : G.Monic)
    (hG_deg : G.natDegree = d)
    (hG_coeff : ∀ j : ℕ, G.coeff j ∈ weilRatLocalSet Ω F t c)
    (hG_root : Polynomial.eval z G = 0)
    (hG_deriv_ne : Polynomial.eval z (Polynomial.derivative G) ≠ 0)
    (hG_mod : ∀ j : ℕ, ∃ u ∈ weilRatLocalSet Ω F t c,
      G.coeff j - algebraMap Ω F
        ((∏ k : Fin r, (Polynomial.X - Polynomial.C (c_br k)) ^ (e_br k)).coeff j) =
        (t - algebraMap Ω F c) * u)
    (δ : Fin r → F)
    (hδ_ne : ∀ k : Fin r, δ k ≠ 0)
    (hdz_ne : ∀ k : Fin r, KaehlerDifferential.D Ω F (z - algebraMap Ω F (c_br k)) ≠ 0)
    (hdt_eq : ∀ k : Fin r,
      KaehlerDifferential.D Ω F t = δ k • KaehlerDifferential.D Ω F (z - algebraMap Ω F (c_br k))) :
    ∀ k : Fin r, ord (P_br k) (Polynomial.eval z (Polynomial.derivative G)) = ord (P_br k) (δ k) :=
by
  have _ : G.Monic ∧ Polynomial.eval z (Polynomial.derivative G) ≠ 0 ∧ (∀ k : Fin r, δ k ≠ 0) :=
    ⟨hG_monic, hG_deriv_ne, hδ_ne⟩
  classical
  intro k
  set P : X := P_br k
  have hP : IsPlace P := hP_pl k
  set e : ℕ := e_br k
  have he : 1 ≤ e := (he_br k).1
  set τ_c : F := t - algebraMap Ω F c
  have htc : ord P τ_c = ((e : ℤ) : WithTop ℤ) := (he_br k).2
  set c_k : Ω := c_br k
  set α_k : F := algebraMap Ω F c_k
  set z_k : F := z - α_k
  have hz_k : ord P z_k = (1 : WithTop ℤ) := hz_ord k
  have he_le_d : e ≤ d := by
    rw [hd_eq]
    exact Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ k)
  have hd_pos : 1 ≤ d := le_trans he he_le_d
  have hAeval_inj : Function.Injective (Polynomial.aeval t : Polynomial Ω →ₐ[Ω] F) :=
    transcendental_iff_injective.mp ht_tr
  have hAeval_ne : ∀ A : Polynomial Ω, Polynomial.eval c A ≠ 0 → Polynomial.aeval t A ≠ 0 := by
    intro A hAc hAt
    apply hAc
    have hA0 : A = 0 := hAeval_inj (hAt.trans (map_zero _).symm)
    rw [hA0, Polynomial.eval_zero]
  have hAlg_mem : ∀ a : Ω, algebraMap Ω F a ∈ weilRatLocalSet Ω F t c := by
    intro a
    refine ⟨Polynomial.C a, 1, by simp, ?_⟩
    simp [Polynomial.aeval_C]
  let Rc : Subring F :=
    { carrier := weilRatLocalSet Ω F t c
      mul_mem' := by
        rintro u₁ u₂ ⟨P₁, Q₁, hQ₁, h₁⟩ ⟨P₂, Q₂, hQ₂, h₂⟩
        refine ⟨P₁ * P₂, Q₁ * Q₂, by simp [Polynomial.eval_mul, hQ₁, hQ₂], ?_⟩
        rw [map_mul, map_mul]
        calc (u₁ * u₂) * (Polynomial.aeval t Q₁ * Polynomial.aeval t Q₂)
            = (u₁ * Polynomial.aeval t Q₁) * (u₂ * Polynomial.aeval t Q₂) := by ring
          _ = Polynomial.aeval t P₁ * Polynomial.aeval t P₂ := by rw [h₁, h₂]
      one_mem' := by
        simpa using hAlg_mem 1
      add_mem' := by
        rintro u₁ u₂ ⟨P₁, Q₁, hQ₁, h₁⟩ ⟨P₂, Q₂, hQ₂, h₂⟩
        refine ⟨P₁ * Q₂ + P₂ * Q₁, Q₁ * Q₂, by simp [Polynomial.eval_mul, hQ₁, hQ₂], ?_⟩
        rw [map_add, map_mul, map_mul, map_mul]
        calc (u₁ + u₂) * (Polynomial.aeval t Q₁ * Polynomial.aeval t Q₂)
            = (u₁ * Polynomial.aeval t Q₁) * Polynomial.aeval t Q₂ +
                (u₂ * Polynomial.aeval t Q₂) * Polynomial.aeval t Q₁ := by ring
          _ = Polynomial.aeval t P₁ * Polynomial.aeval t Q₂ +
                Polynomial.aeval t P₂ * Polynomial.aeval t Q₁ := by rw [h₁, h₂]
      zero_mem' := by
        simpa using hAlg_mem 0
      neg_mem' := by
        rintro u₁ ⟨P₁, Q₁, hQ₁, h₁⟩
        refine ⟨-P₁, Q₁, hQ₁, ?_⟩
        rw [map_neg, neg_mul, h₁] }
  let PolyRc : Subring (Polynomial F) :=
    { carrier := {A : Polynomial F | ∀ j : ℕ, A.coeff j ∈ Rc}
      mul_mem' := by
        intro A B hA hB j
        rw [Polynomial.coeff_mul]
        exact Rc.sum_mem fun x _ => Rc.mul_mem (hA x.1) (hB x.2)
      one_mem' := by
        intro j
        rw [Polynomial.coeff_one]
