              have hi_val : (i_star : ℕ) = (j_lam : ℕ) + 1 := by rw [hi_eq, Fin.val_succ]
              rw [hmj_val, hi_val, pow_succ]
              have hsq : (-1 : R_α) ^ (j_lam : ℕ) * (-1) ^ (j_lam : ℕ) = 1 := by
                rw [← mul_pow, neg_one_mul, neg_neg, one_pow]
              linear_combination - ((-1 : R_α) ^ (j : ℕ)) * hsq
            · have hmj_eq : m_j = j.succ := Fin.succAbove_of_le_castSucc i_star j hi_le
              have hjlam_lt : j_lam.castSucc < m_j := by
                by_contra hge
                rw [not_lt] at hge
                have hcontra : j.succ < i_star := by
                  have h1 : m_j.succAbove j_lam = j_lam.succ :=
                    Fin.succAbove_of_le_castSucc m_j j_lam hge
                  rw [hj_lam_succ] at h1
                  rw [← hmj_eq, h1]
                  exact lt_of_le_of_lt hge j_lam.castSucc_lt_succ
                have hi_le_succ : i_star ≤ j.succ :=
                  le_trans hi_le (le_of_lt j.castSucc_lt_succ)
                exact not_lt_of_ge hi_le_succ hcontra
              have hi_eq : i_star = j_lam.castSucc := by
                rw [← hj_lam_succ, Fin.succAbove_of_castSucc_lt m_j j_lam hjlam_lt]
              have hmj_val : (m_j : ℕ) = (j : ℕ) + 1 := by rw [hmj_eq, Fin.val_succ]
              have hi_val : (i_star : ℕ) = (j_lam : ℕ) := by rw [hi_eq]; rfl
              rw [hmj_val, hi_val, pow_succ]
              have hsq : (-1 : R_α) ^ (j_lam : ℕ) * (-1) ^ (j_lam : ℕ) = 1 := by
                rw [← mul_pow, neg_one_mul, neg_neg, one_pow]
              linear_combination ((-1 : R_α) ^ (j : ℕ)) * hsq
          calc (-1 : R_α) ^ (i_star : ℕ) *
                ((-1) ^ (j : ℕ) *
                  ((-1) ^ (j_lam : ℕ) *
                    (Y.presheaf.map (CategoryTheory.homOfLE
                      (le_trans hW_γ (hFaceOf γ m_j))).op).hom (z (faceOf γ m_j))))
              = ((-1 : R_α) ^ (i_star : ℕ) * ((-1) ^ (j : ℕ) * (-1) ^ (j_lam : ℕ))) *
                  (Y.presheaf.map (CategoryTheory.homOfLE
                    (le_trans hW_γ (hFaceOf γ m_j))).op).hom (z (faceOf γ m_j)) := by ring
            _ = - ((-1 : R_α) ^ (m_j : ℕ) *
                  (Y.presheaf.map (CategoryTheory.homOfLE
                    (le_trans hW_γ (hFaceOf γ m_j))).op).hom (z (faceOf γ m_j))) := by
                  rw [hSign, neg_mul]
        let R_α := ↑(Y.presheaf.obj (Opposite.op W_α))
        have hSumMul : (-1 : R_α) ^ (i_star : ℕ) *
            (∑ j : Fin (p + 2), (-1) ^ (j : ℕ) *
              (Y.presheaf.map (CategoryTheory.homOfLE
                (inf_le_inf_left (U lam) (hFaceOf α j))).op).hom (s (faceOf α j))) =
            - ∑ j : Fin (p + 2), (-1) ^ (i_star.succAbove j : ℕ) *
                (Y.presheaf.map (CategoryTheory.homOfLE hW_γ).op).hom
                  ((Y.presheaf.map (CategoryTheory.homOfLE
                    (hFaceOf γ (i_star.succAbove j))).op).hom
                    (z (faceOf γ (i_star.succAbove j)))) := by
          rw [Finset.mul_sum, ← Finset.sum_neg_distrib]
          exact Finset.sum_congr rfl fun j _ => hTermEq j
        have hEqScaled : (-1 : R_α) ^ (i_star : ℕ) *
            (∑ j : Fin (p + 2), (-1) ^ (j : ℕ) *
              (Y.presheaf.map (CategoryTheory.homOfLE
                (inf_le_inf_left (U lam) (hFaceOf α j))).op).hom (s (faceOf α j))) =
            (-1 : R_α) ^ (i_star : ℕ) *
              (Y.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (z α) := by
          linear_combination hSumMul - hCocW
        have hMulInv := congrArg ((-1 : R_α) ^ (i_star : ℕ) * ·) hEqScaled
        have hsq_i : (-1 : R_α) ^ (i_star : ℕ) * (-1) ^ (i_star : ℕ) = 1 := by
          rw [← mul_pow, neg_one_mul, neg_neg, one_pow]
        change (-1 : R_α) ^ (i_star : ℕ) *
            ((-1 : R_α) ^ (i_star : ℕ) * _) =
          (-1 : R_α) ^ (i_star : ℕ) *
            ((-1 : R_α) ^ (i_star : ℕ) * _) at hMulInv
        rw [← mul_assoc, ← mul_assoc, hsq_i, one_mul, one_mul] at hMulInv
        exact hMulInv
    
    have hClear : ∀ (lam : Fin r) (f_lam : A) (hf_lam : Y.basicOpen f_lam ≤ U lam)
        (s : ∀ ν : WeilStrictMonoTuple r p,
          ↑(Y.presheaf.obj (Opposite.op (U lam ⊓ weilCoverChartInter U ν))))
        (hs : ∀ α : WeilStrictMonoTuple r (p + 1),
          ∑ j : Fin (p + 2), (-1) ^ (j : ℕ) *
            (Y.presheaf.map (CategoryTheory.homOfLE
              (inf_le_inf_left (U lam) (hFaceOf α j))).op).hom (s (faceOf α j)) =
          (Y.presheaf.map (CategoryTheory.homOfLE
            (inf_le_right : U lam ⊓ weilCoverChartInter U α ≤ weilCoverChartInter U α)).op).hom
            (z α)),
        ∃ (N : ℕ) (y : C_Y p),
          ∀ α : WeilStrictMonoTuple r (p + 1),
            d_Y p y α =
              (Y.presheaf.map (CategoryTheory.homOfLE (hInterLeW α)).op).hom (f_lam ^ N) * z α := by
      intro lam f_lam hf_lam s hs
      have hStep1 : ∀ ν : WeilStrictMonoTuple r p,
          let U_ν := weilCoverChartInter U ν
          let W_ν := U lam ⊓ U_ν
          ∃ (n_ν : ℕ) (x_ν : ↑(Y.presheaf.obj (Opposite.op U_ν))),
            (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W_ν ≤ U_ν)).op).hom x_ν =
              ((Y.presheaf.map (CategoryTheory.homOfLE
                (le_trans (inf_le_right : W_ν ≤ U_ν) (hInterLeW ν))).op).hom f_lam) ^ n_ν * s ν := by
        intro ν U_ν W_ν
        let f₁ : ↑(Y.presheaf.obj (Opposite.op U_ν)) :=
          (Y.presheaf.map (CategoryTheory.homOfLE (hInterLeW ν)).op).hom f_lam
        let f₂ : ↑(Y.presheaf.obj (Opposite.op W_ν)) :=
          (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W_ν ≤ U_ν)).op).hom f₁
        have hf₂_eq : f₂ = (Y.presheaf.map (CategoryTheory.homOfLE
            (le_trans (inf_le_right : W_ν ≤ U_ν) (hInterLeW ν))).op).hom f_lam :=
          hMapComp (hInterLeW ν) inf_le_right _ f_lam
        let D_ν : Y.Opens := Y.basicOpen f₁
        have hD_le_W : D_ν ≤ W_ν := by
          change Y.basicOpen f₁ ≤ U lam ⊓ U_ν
          rw [Y.basicOpen_res]
          exact le_inf (inf_le_right.trans hf_lam) inf_le_left
        have hD_eq : D_ν = Y.basicOpen f₂ := by
          change D_ν = Y.basicOpen ((Y.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom f₁)
          rw [Y.basicOpen_res]
          exact (inf_eq_right.mpr hD_le_W).symm
        let i₁ : D_ν ⟶ U_ν := CategoryTheory.homOfLE (Y.basicOpen_le f₁)
        let i₂ : D_ν ⟶ W_ν := CategoryTheory.homOfLE hD_le_W
        let _ : Algebra ↑(Y.presheaf.obj (Opposite.op U_ν)) ↑(Y.presheaf.obj (Opposite.op D_ν)) :=
          (Y.presheaf.map i₁.op).hom.toAlgebra
        have _ : IsLocalization.Away f₁ ↑(Y.presheaf.obj (Opposite.op D_ν)) :=
          (hAffInter p ν).isLocalization_of_eq_basicOpen f₁ i₁ rfl
        let p_sec := IsLocalization.Away.sec f₁ ((Y.presheaf.map i₂.op).hom (s ν))
        have h_sec : (Y.presheaf.map i₂.op).hom (s ν) *
            (Y.presheaf.map i₁.op).hom (f₁ ^ p_sec.2) =
            (Y.presheaf.map i₁.op).hom p_sec.1 :=
          IsLocalization.Away.sec_spec f₁ ((Y.presheaf.map i₂.op).hom (s ν))
        have hx₀ : (Y.presheaf.map i₂.op).hom
            ((Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W_ν ≤ U_ν)).op).hom p_sec.1) =
            (Y.presheaf.map i₂.op).hom (f₂ ^ p_sec.2 * s ν) := by
          rw [hMapComp inf_le_right hD_le_W (Y.basicOpen_le f₁) p_sec.1]
          change (Y.presheaf.map i₁.op).hom p_sec.1 = _
          rw [← h_sec, map_mul, map_pow, mul_comm]
          congr 1
          rw [map_pow]
          exact congrArg (· ^ p_sec.2) (hMapComp inf_le_right hD_le_W (Y.basicOpen_le f₁) f₁).symm
        let _ : Algebra ↑(Y.presheaf.obj (Opposite.op W_ν)) ↑(Y.presheaf.obj (Opposite.op D_ν)) :=
          (Y.presheaf.map i₂.op).hom.toAlgebra
        have _ : IsLocalization.Away f₂ ↑(Y.presheaf.obj (Opposite.op D_ν)) :=
          ((hAffU lam).inf (hAffInter p ν)).isLocalization_of_eq_basicOpen f₂ i₂ hD_eq
        obtain ⟨n₂, hn₂⟩ := IsLocalization.Away.exists_of_eq f₂ hx₀
        refine ⟨p_sec.2 + n₂, f₁ ^ n₂ * p_sec.1, ?_⟩
        rw [map_mul, map_pow]
        change f₂ ^ n₂ * (Y.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom p_sec.1 = _
        rw [hn₂, ← hf₂_eq, ← mul_assoc, ← pow_add, add_comm n₂ p_sec.2]
      choose n_fn x_fn hx_fn using hStep1
      let N₁ : ℕ := Finset.univ.sup n_fn
      let y₁ : C_Y p := fun ν =>
        ((Y.presheaf.map (CategoryTheory.homOfLE (hInterLeW ν)).op).hom f_lam) ^ (N₁ - n_fn ν) *
          x_fn ν
      have hy₁ : ∀ ν : WeilStrictMonoTuple r p,
          (Y.presheaf.map (CategoryTheory.homOfLE
            (inf_le_right : U lam ⊓ weilCoverChartInter U ν ≤ weilCoverChartInter U ν)).op).hom
            (y₁ ν) =
          ((Y.presheaf.map (CategoryTheory.homOfLE
            (le_trans inf_le_right (hInterLeW ν))).op).hom f_lam) ^ N₁ * s ν := by
        intro ν
        dsimp only [y₁]
        rw [map_mul, map_pow, hMapComp (hInterLeW ν) inf_le_right _, hx_fn ν,
          ← mul_assoc, ← pow_add, Nat.sub_add_cancel (Finset.le_sup (Finset.mem_univ ν))]
      have hStep2 : ∀ α : WeilStrictMonoTuple r (p + 1),
          let U_α := weilCoverChartInter U α
          let f_α := (Y.presheaf.map (CategoryTheory.homOfLE (hInterLeW α)).op).hom f_lam
          ∃ m_α : ℕ, f_α ^ m_α * d_Y p y₁ α = f_α ^ m_α * (f_α ^ N₁ * z α) := by
        intro α U_α f_α
        let W_α : Y.Opens := U lam ⊓ U_α
        have hDiff_W : (Y.presheaf.map (CategoryTheory.homOfLE
              (inf_le_right : W_α ≤ U_α)).op).hom (d_Y p y₁ α) =
            (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W_α ≤ U_α)).op).hom
              (f_α ^ N₁ * z α) := by
          change (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W_α ≤ U_α)).op).hom
              (∑ j : Fin (p + 2), (-1) ^ (j : ℕ) *
                (Y.presheaf.map (CategoryTheory.homOfLE (hFaceOf α j)).op).hom
                  (y₁ (faceOf α j))) = _
          rw [map_sum, map_mul, map_pow, hMapComp (hInterLeW α) inf_le_right _]
          have hSumEq : (∑ j : Fin (p + 2),
              (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W_α ≤ U_α)).op).hom
                ((-1) ^ (j : ℕ) *
                  (Y.presheaf.map (CategoryTheory.homOfLE (hFaceOf α j)).op).hom
                    (y₁ (faceOf α j)))) =
              ((Y.presheaf.map (CategoryTheory.homOfLE
                (le_trans (inf_le_right : W_α ≤ U_α) (hInterLeW α))).op).hom f_lam) ^ N₁ *
              ∑ j : Fin (p + 2), (-1) ^ (j : ℕ) *
                (Y.presheaf.map (CategoryTheory.homOfLE
                  (inf_le_inf_left (U lam) (hFaceOf α j))).op).hom (s (faceOf α j)) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [map_mul, hMapNegOnePow,
              hMapComp (hFaceOf α j) inf_le_right
                (le_trans (inf_le_inf_left (U lam) (hFaceOf α j)) inf_le_right),
              ← hMapComp inf_le_right (inf_le_inf_left (U lam) (hFaceOf α j))
                (le_trans (inf_le_inf_left (U lam) (hFaceOf α j)) inf_le_right),
              hy₁ (faceOf α j), map_mul, map_pow,
              hMapComp _ (inf_le_inf_left (U lam) (hFaceOf α j))
                (le_trans (inf_le_right : W_α ≤ U_α) (hInterLeW α))]
            ring
          rw [hSumEq, hs α]
        have hDα_le_W : Y.basicOpen f_α ≤ W_α := by
          change Y.basicOpen ((Y.presheaf.map (CategoryTheory.homOfLE (hInterLeW α)).op).hom f_lam) ≤
            U lam ⊓ U_α
          rw [Y.basicOpen_res]
          exact le_inf (inf_le_right.trans hf_lam) inf_le_left
        let i_α : Y.basicOpen f_α ⟶ U_α := CategoryTheory.homOfLE (Y.basicOpen_le f_α)
        have hDiff_Dα : (Y.presheaf.map i_α.op).hom (d_Y p y₁ α) =
            (Y.presheaf.map i_α.op).hom (f_α ^ N₁ * z α) := by
          have h1 := congrArg (Y.presheaf.map (CategoryTheory.homOfLE hDα_le_W).op).hom hDiff_W
          dsimp only [U_α] at hDα_le_W i_α ⊢
          rw [hMapComp inf_le_right hDα_le_W (Y.basicOpen_le f_α),
            hMapComp inf_le_right hDα_le_W (Y.basicOpen_le f_α)] at h1
          exact h1
        let _ : Algebra ↑(Y.presheaf.obj (Opposite.op U_α))
            ↑(Y.presheaf.obj (Opposite.op (Y.basicOpen f_α))) :=
          (Y.presheaf.map i_α.op).hom.toAlgebra
        have _ : IsLocalization.Away f_α ↑(Y.presheaf.obj (Opposite.op (Y.basicOpen f_α))) :=
          (hAffInter (p + 1) α).isLocalization_of_eq_basicOpen f_α i_α rfl
        exact IsLocalization.Away.exists_of_eq f_α hDiff_Dα
      choose m_fn hm_fn using hStep2
      let N₂ : ℕ := Finset.univ.sup m_fn
      let y : C_Y p := fun ν =>
        (Y.presheaf.map (CategoryTheory.homOfLE (hInterLeW ν)).op).hom (f_lam ^ N₂) * y₁ ν
      refine ⟨N₁ + N₂, y, fun α => ?_⟩
      rw [hDiffWMul (f_lam ^ N₂) y₁ α]
      let f_α := (Y.presheaf.map (CategoryTheory.homOfLE (hInterLeW α)).op).hom f_lam
      have hf_pow : ∀ k : ℕ,
          (Y.presheaf.map (CategoryTheory.homOfLE (hInterLeW α)).op).hom (f_lam ^ k) = f_α ^ k :=
        fun k => map_pow _ f_lam k
      rw [hf_pow N₂, hf_pow (N₁ + N₂)]
      have hm_le : m_fn α ≤ N₂ := Finset.le_sup (Finset.mem_univ α)
      calc f_α ^ N₂ * d_Y p y₁ α
          = f_α ^ (N₂ - m_fn α) * (f_α ^ m_fn α * d_Y p y₁ α) := by
            rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hm_le]
        _ = f_α ^ (N₂ - m_fn α) * (f_α ^ m_fn α * (f_α ^ N₁ * z α)) := by rw [hm_fn α]
        _ = f_α ^ (N₁ + N₂) * z α := by
            rw [← mul_assoc, ← mul_assoc, ← pow_add, Nat.sub_add_cancel hm_le,
              ← pow_add, add_comm N₂ N₁]
    
    obtain ⟨f, hf_le, hf_pow⟩ := hPOU
    choose s_fam hs_fam using hLocalHomotopy
    choose N_fam y_fam hy_fam using fun lam : Fin r =>
      hClear lam (f lam) (hf_le lam) (s_fam lam) (hs_fam lam)
    let K : ℕ := Finset.univ.sup N_fam
    obtain ⟨h, hh⟩ := hf_pow K
    let C_fam : Fin r → C_Y p := fun lam ν =>
      (Y.presheaf.map (CategoryTheory.homOfLE (hInterLeW ν)).op).hom
        (h lam * (f lam) ^ (K - N_fam lam)) * y_fam lam ν
    let b : C_Y p := fun ν => ∑ lam : Fin r, C_fam lam ν
    have hb : d_Y p b = z := by
      funext α
      have hEach : ∀ lam : Fin r,
          d_Y p (C_fam lam) α =
          (Y.presheaf.map (CategoryTheory.homOfLE (hInterLeW α)).op).hom
            (h lam * (f lam) ^ K) * z α := by
        intro lam
        change d_Y p (fun ν =>
          (Y.presheaf.map (CategoryTheory.homOfLE (hInterLeW ν)).op).hom
            (h lam * (f lam) ^ (K - N_fam lam)) * y_fam lam ν) α = _
        rw [hDiffWMul, hy_fam lam α, ← mul_assoc, ← map_mul, mul_assoc, ← pow_add,
          Nat.sub_add_cancel (Finset.le_sup (Finset.mem_univ lam))]
      calc d_Y p b α
          = ∑ lam : Fin r, d_Y p (C_fam lam) α := hDiffSum C_fam α
        _ = ∑ lam : Fin r,
              (Y.presheaf.map (CategoryTheory.homOfLE (hInterLeW α)).op).hom
                (h lam * (f lam) ^ K) * z α :=
            Finset.sum_congr rfl fun lam _ => hEach lam
        _ = ((Y.presheaf.map (CategoryTheory.homOfLE (hInterLeW α)).op).hom
              (∑ lam : Fin r, h lam * (f lam) ^ K)) * z α := by
            rw [← Finset.sum_mul, map_sum]
        _ = z α := by
            rw [hh, map_one, one_mul]
    refine ⟨fromCY p b, ?_⟩
    calc weilModuleCechDiff U O_Y p (fromCY p b)
        = fromCY (p + 1) (toCY (p + 1) (weilModuleCechDiff U O_Y p (fromCY p b))) :=
          (hFromTo (p + 1) _).symm
      _ = fromCY (p + 1) (d_Y p b) := by rw [hToDiff p, hToFrom p b]
      _ = fromCY (p + 1) z := by rw [hb]
      _ = z_mod := hFromTo (p + 1) z_mod

theorem weil_chow_vertical_direct_image_coherence_and_dense_iso (hSerre : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B]
      (N : ℕ)
      (G : WeilPresheafModule
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) :=
           MvPolynomial.gradedAlgebra
         AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B))),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) :=
        MvPolynomial.gradedAlgebra
      let W_std : Fin (N + 1) →
          (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B)).Opens :=
        fun k => AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) (MvPolynomial.X k)
      let π_B : AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of B) :=
        AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap B ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B 0)))
      IsWeilCoherentSubChartModule W_std G →
      HasFiniteWeilModuleCechCohomology π_B W_std G)
    (R : Type u) [CommRing R] [IsNoetherianRing R]
    (Z : AlgebraicGeometry.Scheme.{u})
    (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hPropZ : AlgebraicGeometry.IsProper g_Z)
    (m : ℕ) (V_Z : Fin m → Z.Opens)
    (hAffVZ : ∀ a : Fin m, AlgebraicGeometry.IsAffineOpen (V_Z a))
    (hCovVZ : (⋃ a : Fin m, (V_Z a : Set Z)) = Set.univ)
    (U_dense : Z.Opens)
    (hAffU : AlgebraicGeometry.IsAffineOpen U_dense)
    (N : ℕ) (Z' : AlgebraicGeometry.Scheme.{u}) (π : Z' ⟶ Z)
    (ι_proj : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) :=
                MvPolynomial.gradedAlgebra
              Z' ⟶ AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) :=
      MvPolynomial.gradedAlgebra
    let 𝒜_R := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let W_R : Fin (N + 1) → (AlgebraicGeometry.Proj 𝒜_R).Opens :=
      fun k => AlgebraicGeometry.Proj.basicOpen 𝒜_R (MvPolynomial.X k)
    let π_R : AlgebraicGeometry.Proj 𝒜_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜_R ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜_R 0)))
    let Z'_std : Fin (N + 1) → Z'.Opens :=
      fun k => (TopologicalSpace.Opens.map ι_proj.base).obj (W_R k)
    AlgebraicGeometry.IsProper π →
    CategoryTheory.IsIso (π ∣_ U_dense) →
    AlgebraicGeometry.IsClosedImmersion ι_proj →
    π ≫ g_Z = ι_proj ≫ π_R →
    (Z'.IsSeparated →
      ∀ (W : Z'.Opens),
        AlgebraicGeometry.IsAffineOpen W →
        ∀ (r : ℕ) (U : Fin r → Z'.Opens) (hU_le : ∀ a : Fin r, U a ≤ W),
          (∀ a : Fin r, AlgebraicGeometry.IsAffineOpen (U a)) →
          (⨆ a : Fin r, U a) = W →
          ∀ (O_Z' : WeilPresheafModule Z'),
            (∃ e_Z' : ∀ V₀ : Z'.Opens, O_Z'.sec V₀ ≃+ ↑(Z'.presheaf.obj (Opposite.op V₀)),
