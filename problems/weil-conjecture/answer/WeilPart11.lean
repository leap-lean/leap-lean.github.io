        change Y.toRingedSpace.basicOpen (w * F₂ (MvPolynomial.X k)) =
          Y.toRingedSpace.basicOpen (F₂ (MvPolynomial.X k))
        rw [Y.toRingedSpace.basicOpen_mul, Y.toRingedSpace.basicOpen_of_isUnit hw, top_inf_eq]
      refine ⟨Y.basicOpen (F₁ (MvPolynomial.X k)), le_of_eq hPre₁.symm,
        le_of_eq (hBasicEq.trans hPre₂.symm), le_of_eq hPre₁, ?_⟩
      rw [AlgebraicGeometry.Proj.fromOfGlobalSections_resLE 𝒜 F₁ hF₁ zero_lt_one hXk]
      have hRes₂ := AlgebraicGeometry.Proj.fromOfGlobalSections_resLE 𝒜 F₂ hF₂ zero_lt_one hXk
      rw [← cancel_mono (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X k) hXk zero_lt_one).hom]
      apply hToSpec_eq
      ext m
      obtain ⟨n, P, hP, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hXk m
      have hP_deg : P ∈ 𝒜 n := by simpa using hP
      let B₁ := Y.basicOpen (F₁ (MvPolynomial.X k))
      have hUnit₁ : IsUnit ((B₁.ι.appTop.hom (F₁ (MvPolynomial.X k))) ^ n) :=
        (hIsUnit_basicOpen_ι (F₁ (MvPolynomial.X k))).pow n
      apply hUnit₁.mul_right_cancel
      have hc₁ := hToBasic_char F₁ k hXk n P hP
