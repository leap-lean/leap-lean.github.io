        (∀ i : Fin (r₀ + 1),
          f₁ (MvPolynomial.X i) = u_scale.val * φ_X.appTop.hom (f₂ (MvPolynomial.X i))) →
        AlgebraicGeometry.Proj.fromOfGlobalSections
            (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A) f₁ hf₁ =
          φ_X ≫ AlgebraicGeometry.Proj.fromOfGlobalSections
            (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A) f₂ hf₂) ∧
    (∀ (A B : Type u) [CommRing A] [CommRing B] (ψ : A →+* B),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A) :=
        MvPolynomial.gradedAlgebra
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) B) :=
        MvPolynomial.gradedAlgebra
      ∃ (Ψ : MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A →+*ᵍ
            MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) B)
        (hΨ : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) B) ≤
          HomogeneousIdeal.map Ψ
            (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A))),
        Ψ.toRingHom = MvPolynomial.map ψ ∧
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Proj.map Ψ hΨ)
          (AlgebraicGeometry.Proj.toSpecZero
              (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) B) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap B ↥(MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) B 0))))
          (AlgebraicGeometry.Proj.toSpecZero
              (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A 0))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
        ∀ (Y X : AlgebraicGeometry.Scheme.{u}) (w : Y ⟶ X)
          (f_A : MvPolynomial (Fin (r₀ + 1)) A →+* ↑(X.presheaf.obj (Opposite.op ⊤)))
          (hf_A : Ideal.map f_A
            (HomogeneousIdeal.irrelevant
              (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A)).toIdeal = ⊤)
          (f_B : MvPolynomial (Fin (r₀ + 1)) B →+* ↑(Y.presheaf.obj (Opposite.op ⊤)))
          (hf_B : Ideal.map f_B
            (HomogeneousIdeal.irrelevant
              (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) B)).toIdeal = ⊤),
          (∀ c : A, f_B (MvPolynomial.C (ψ c)) = w.appTop.hom (f_A (MvPolynomial.C c))) →
          (∀ i : Fin (r₀ + 1), f_B (MvPolynomial.X i) = w.appTop.hom (f_A (MvPolynomial.X i))) →
          AlgebraicGeometry.Proj.fromOfGlobalSections
              (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) B) f_B hf_B ≫
            AlgebraicGeometry.Proj.map Ψ hΨ =
          w ≫ AlgebraicGeometry.Proj.fromOfGlobalSections
              (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A) f_A hf_A) :=
by
  
  have hIrrel : ∀ (K : Type u) [CommRing K],
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) K) :=
        MvPolynomial.gradedAlgebra
      (HomogeneousIdeal.irrelevant
        (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) K)).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (r₀ + 1) → MvPolynomial (Fin (r₀ + 1)) K)) := by
    intro K _
    let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) K) :=
      MvPolynomial.gradedAlgebra
    intro p hp
    have hp0 : (GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) K) 0) p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff _ p).mp hp
    have hcoeff0 : p.coeff 0 = 0 := by
      have h1 : (MvPolynomial.homogeneousComponent 0 p).coeff 0 =
          ((GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) K) 0) p).coeff 0 := by
        rw [GradedRing.proj_apply]
        exact congrArg (fun q => q.coeff 0) (MvPolynomial.decompose'_apply K 1 p 0).symm
      rw [hp0] at h1
      simpa [MvPolynomial.coeff_homogeneousComponent] using h1
