    obtain ⟨φ_W, _, hφ_W⟩ := hFunc W hW ⟨⟨x, hxW⟩⟩
    obtain ⟨hφW_inj, _, _, hPrimeW⟩ := hB2 W hW ⟨⟨x, hxW⟩⟩ φ_W hφ_W
    have hφ_σW : ∀ b : ↥B, φ_W.hom (σ_W b) = (b : F) := by
      intro b
      dsimp only [σ_W, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
      rw [hρ_compat W hW ⟨⟨x, hxW⟩⟩ hW_le φ_W hφ_W (σ₀ b), hρ_σ₀ b]
