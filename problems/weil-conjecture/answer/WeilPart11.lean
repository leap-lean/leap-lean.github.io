    rcases Submodule.mem_sup.mp hv with ⟨v₀, hv₀, v_inf, hv_inf, hv_eq⟩
    change res ((Algebra.trace ↥K₀ F (w.1 * v.1) : ↥K₀) : F) = 0
    rw [← hv_eq, mul_add, map_add, AddMemClass.coe_add, map_add]
    obtain ⟨hw₀, hw_inf⟩ := (hW_dual w.1).mp w.2
    rw [hres_A0 _ (hw₀ v₀ hv₀), hres_Ainf _ (hw_inf v_inf hv_inf), add_zero]
  let bwd : ↥W_dual →ₗ[Ω] Module.Dual Ω (↥E₀_inf ⧸ S_0inf) :=
    { toFun := fun w => S_0inf.liftQ (β_tilde w) (hβ_ker w)
