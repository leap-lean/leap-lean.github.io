    have hLagrange : ∀ (β : Fin (c + 1)) (Q : E_norm β)
        (hQ_cl : IsClosed ({Q} : Set (E_norm β))) (hQ_B : B_div β Q = 1)
        (a : Fin M.m)
        (hQ_mem : Q ∈ (TopologicalSpace.Opens.map (ν β).base).obj (M.V a)),
        ∃ h : F β,
          (∀ P : E_norm β, IsClosed ({P} : Set (E_norm β)) →
            (-(Δ_div β P) : WithTop ℤ) ≤ ord β P h) ∧
          ev_pt β Q hQ_cl a hQ_mem (chartLift β a h) = 1 ∧
          (∀ (Q' : E_norm β) (hQ'_cl : IsClosed ({Q'} : Set (E_norm β))),
            B_div β Q' = 1 → Q' ≠ Q →
            ∀ (a' : Fin M.m) (hQ'_mem : Q' ∈ (TopologicalSpace.Opens.map (ν β).base).obj (M.V a')),
              ev_pt β Q' hQ'_cl a' hQ'_mem (chartLift β a' h) = 0) := by
      intro β Q hQ_cl hQ_B a hQ_mem
      let D' : E_norm β → ℤ := fun P => Δ_div β P - B_div β P
      let D_Q : E_norm β → ℤ := fun P => D' P + if P = Q then 1 else 0
      have hD'_not_cl : ∀ P, ¬IsClosed ({P} : Set (E_norm β)) → D' P = 0 := by
        intro P hnot; change Δ_div β P - B_div β P = 0
        rw [hDelta_not_cl β P hnot, hB_not_cl β P hnot, sub_zero]
      have hDQ_not_cl : ∀ P, ¬IsClosed ({P} : Set (E_norm β)) → D_Q P = 0 := by
        intro P hnot
        have hPQ : P ≠ Q := fun h => hnot (h ▸ hQ_cl)
        change D' P + (if P = Q then 1 else 0) = 0
        rw [hD'_not_cl P hnot, if_neg hPQ, add_zero]
      have hD'_fin : {P : E_norm β | D' P ≠ 0}.Finite :=
        ((hDelta_fin β).union (hStabSys.2.1 β).1).subset fun P hP => by
          by_contra h_not
          simp only [Set.mem_union, Set.mem_setOf_eq, not_or, not_not] at h_not
          exact hP (by change Δ_div β P - B_div β P = 0; rw [h_not.1, h_not.2, sub_zero])
      have hInd_fin : {P : E_norm β | (if P = Q then (1 : ℤ) else 0) ≠ 0}.Finite :=
        (Set.finite_singleton Q).subset fun P hP => by
          by_contra hPQ; exact hP (if_neg hPQ)
      have hDQ_fin : {P : E_norm β | D_Q P ≠ 0}.Finite :=
        (hD'_fin.union hInd_fin).subset fun P hP => by
          by_contra h_not
          simp only [Set.mem_union, Set.mem_setOf_eq, not_or, not_not] at h_not
          exact hP (by change D' P + _ = 0; rw [h_not.1, h_not.2, add_zero])
      have hD'_deg : (∑ᶠ P : E_norm β, D' P) = 3 * d_comp β - ∑ᶠ P : E_norm β, B_div β P := by
        change (∑ᶠ P : E_norm β, (Δ_div β P - B_div β P)) = _
        rw [finsum_sub_distrib (hDelta_fin β) (hStabSys.2.1 β).1, hDelta_deg β]
      have hDQ_deg : (∑ᶠ P : E_norm β, D_Q P) = (∑ᶠ P : E_norm β, D' P) + 1 := by
        change (∑ᶠ P : E_norm β, (D' P + if P = Q then 1 else 0)) = _
        rw [finsum_add_distrib hD'_fin hInd_fin,
          finsum_eq_single (fun P => if P = Q then (1 : ℤ) else 0) Q (fun P hPQ => if_neg hPQ),
          if_pos rfl]
      have h_st := (hStabSys.2.2.1 β).2.1
      change (2 : ℤ) * (g_E β : ℤ) ≤ 3 * d_comp β - ∑ᶠ P : E_norm β, B_div β P at h_st
      have hD'_gt : (2 : ℤ) * (g_E β : ℤ) - 2 < ∑ᶠ P : E_norm β, D' P := by omega
      have hDQ_gt : (2 : ℤ) * (g_E β : ℤ) - 2 < ∑ᶠ P : E_norm β, D_Q P := by omega
      let L' := mkDivSub β D'
      let LQ := mkDivSub β D_Q
      obtain ⟨_, h_rk'⟩ := ((hRR_data β).2.2.2.2.2.2.2.2.2.2.2.1 D' hD'_not_cl hD'_fin hD'_gt).1
        L' (fun _ => Iff.rfl)
      obtain ⟨_, h_rkQ⟩ := ((hRR_data β).2.2.2.2.2.2.2.2.2.2.2.1 D_Q hDQ_not_cl hDQ_fin hDQ_gt).1
        LQ (fun _ => Iff.rfl)
      have hL_le : L' ≤ LQ := by
