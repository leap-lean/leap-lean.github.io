    let ψ_Ω : Localization.Away h →+* Ω :=
      (AlgebraicGeometry.Spec.preimage (z_h ≫ snd_h)).hom
    have hSpec_ψ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ω) = z_h ≫ snd_h :=
      AlgebraicGeometry.Spec.map_preimage (z_h ≫ snd_h)
    let 𝒜_Ω := MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) Ω
    letI : GradedAlgebra 𝒜_Ω := MvPolynomial.gradedAlgebra
    obtain ⟨w_Ω, hw1_Ω, hw2_Ω, M_Ω, eIdx_Ω, hV_Ω, j_Ω, hj_Ω_proj, _hj_Ω_closed⟩ :=
      hFibClosed Ω ψ_Ω
    let u_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (ψ_Ω.comp (algebraMap R (Localization.Away h))))
    let C_Ω := CategoryTheory.Limits.pullback g u_Ω
    let snd_Ω := CategoryTheory.Limits.pullback.snd g u_Ω
    have hu_Ω_eq : u_Ω = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ω) ≫ u_h := by
      change AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (ψ_Ω.comp (algebraMap R (Localization.Away h)))) = _
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    have hz_lift_comm :
        (z_h ≫ fst_h) ≫ g = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ≫ u_Ω := by
      calc (z_h ≫ fst_h) ≫ g
          = z_h ≫ (CategoryTheory.Limits.pullback.fst g u_h ≫ g) :=
            CategoryTheory.Category.assoc _ _ _
        _ = z_h ≫ (CategoryTheory.Limits.pullback.snd g u_h ≫ u_h) := by
            rw [CategoryTheory.Limits.pullback.condition]
        _ = (z_h ≫ snd_h) ≫ u_h := (CategoryTheory.Category.assoc _ _ _).symm
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ω) ≫ u_h := by rw [← hSpec_ψ]
        _ = u_Ω := hu_Ω_eq.symm
        _ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ≫ u_Ω :=
            (CategoryTheory.Category.id_comp _).symm
    let z_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C_Ω :=
      CategoryTheory.Limits.pullback.lift (z_h ≫ fst_h) (𝟙 _) hz_lift_comm
    have hz_w : z_Ω ≫ w_Ω = z_h := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hw1_Ω]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      · rw [CategoryTheory.Category.assoc, hw2_Ω, ← CategoryTheory.Category.assoc,
          show z_Ω ≫ snd_Ω = 𝟙 _ from CategoryTheory.Limits.pullback.lift_snd _ _ _,
          CategoryTheory.Category.id_comp, hSpec_ψ]
    let a' : Fin M_Ω.m := eIdx_Ω.symm a
    have ha' : eIdx_Ω a' = a := eIdx_Ω.apply_symm_apply a
    let U_Ωa' : C_Ω.Opens := ⊤ ⊓ M_Ω.V a'
    have hU_Ωa'_eq : U_Ωa' = (TopologicalSpace.Opens.map w_Ω.base).obj U_ha := by
      change ⊤ ⊓ M_Ω.V a' =
        (TopologicalSpace.Opens.map w_Ω.base).obj
          (⊤ ⊓ (TopologicalSpace.Opens.map fst_h.base).obj (M.V a))
      rw [hV_Ω a', ha']
    have hz_Ω_mem : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
        (TopologicalSpace.Opens.map z_Ω.base).obj U_Ωa' := by
      intro pt _
      change z_Ω.base pt ∈ U_Ωa'
      rw [hU_Ωa'_eq]
      have hpt : w_Ω.base (z_Ω.base pt) = z_h.base pt := congrArg (fun k => k.base pt) hz_w
      change w_Ω.base (z_Ω.base pt) ∈ U_ha
      rw [hpt]
      exact hz_h_mem trivial
    obtain ⟨f_a', hf_a', _hC, hX, _hj⟩ := hj_Ω_proj a'
    let ev_Ω : ↑(U_Ωa'.toScheme.presheaf.obj (Opposite.op ⊤)) →+* Ω :=
      (U_Ωa'.topIso.hom ≫ z_Ω.appLE U_Ωa' ⊤ hz_Ω_mem ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom).hom
    let g_ev : MvPolynomial (Fin (r₀ + 1)) Ω →+* Ω := ev_Ω.comp f_a'
    have hg_ev_X : ∀ i : Fin (r₀ + 1), g_ev (MvPolynomial.X i) = 0 := by
      intro i
      have h_eval_gen : ∀ (b : Fin M.m) (_ : b = a)
          (hVb : U_Ωa' =
            (TopologicalSpace.Opens.map w_Ω.base).obj
              (⊤ ⊓ (TopologicalSpace.Opens.map fst_h.base).obj (M.V b))),
          ((w_Ω.app (⊤ ⊓ (TopologicalSpace.Opens.map fst_h.base).obj (M.V b)) ≫
              C_Ω.presheaf.map (CategoryTheory.homOfLE (le_of_eq hVb)).op ≫
              z_Ω.appLE U_Ωa' ⊤ hz_Ω_mem ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom).hom
            (e_raw i b)) = 0 := by
        rintro b rfl hVb
        have h_mor :
            w_Ω.app U_ha ≫
              C_Ω.presheaf.map (CategoryTheory.homOfLE (le_of_eq hVb)).op ≫
              z_Ω.appLE U_Ωa' ⊤ hz_Ω_mem ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom = φ_Ω := by
          have h_congr : ∀ (k₁ k₂ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C_h)
              (_ : k₁ = k₂)
              (e₁ : ⊤ ≤ (TopologicalSpace.Opens.map k₁.base).obj U_ha)
              (e₂ : ⊤ ≤ (TopologicalSpace.Opens.map k₂.base).obj U_ha),
              k₁.appLE U_ha ⊤ e₁ = k₂.appLE U_ha ⊤ e₂ := by
            rintro k₁ _ rfl e₁ e₂; rfl
          rw [w_Ω.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map_assoc,
            ← CategoryTheory.Category.assoc (w_Ω.appLE _ _ _),
            AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE,
            h_congr (z_Ω ≫ w_Ω) z_h hz_w _ hz_h_mem,
            ← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE (AlgebraicGeometry.Spec.map φ_Ω)
              hAffU.fromSpec U_ha ⊤ ⊤ hAffU_top (fun _ _ => trivial)]
          have h_fromSpec : hAffU.fromSpec.appLE U_ha ⊤ hAffU_top =
              (AlgebraicGeometry.Scheme.ΓSpecIso R_U).inv := by
            rw [AlgebraicGeometry.Scheme.Hom.appLE, hAffU.fromSpec_app_self,
              CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp]
            have h_endo :
                (CategoryTheory.eqToHom hAffU.fromSpec_preimage_self).op ≫
                  (CategoryTheory.homOfLE hAffU_top).op =
                  𝟙 (Opposite.op (⊤ : (AlgebraicGeometry.Spec R_U).Opens)) :=
              Subsingleton.elim _ _
            rw [h_endo, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
          have h_specTop : (AlgebraicGeometry.Spec.map φ_Ω).appLE ⊤ ⊤ (fun _ _ => trivial) =
              (AlgebraicGeometry.Spec.map φ_Ω).appTop :=
            ((AlgebraicGeometry.Spec.map φ_Ω).app_eq_appLE).symm
          rw [h_fromSpec, h_specTop, CategoryTheory.Category.assoc,
            AlgebraicGeometry.Scheme.ΓSpecIso_naturality φ_Ω, CategoryTheory.Iso.inv_hom_id_assoc]
        rw [h_mor]
        exact hπ_zero i
      change ev_Ω (f_a' (MvPolynomial.X i)) = 0
      rw [hX i]
      change ((U_Ωa'.topIso.inv ≫ U_Ωa'.topIso.hom ≫ z_Ω.appLE U_Ωa' ⊤ hz_Ω_mem ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom).hom
        ((C_Ω.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV_Ω a'))).op).hom
          ((w_Ω.app _).hom (e_raw i (eIdx_Ω a'))))) = 0
      rw [CategoryTheory.Iso.inv_hom_id_assoc]
      exact h_eval_gen (eIdx_Ω a') ha' (hV_Ω a')
    have h_irr_ker : (HomogeneousIdeal.irrelevant 𝒜_Ω).toIdeal ≤ RingHom.ker g_ev := by
      change (HomogeneousIdeal.irrelevant 𝒜_Ω).toAddSubmonoid ≤ (RingHom.ker g_ev).toAddSubmonoid
      rw [HomogeneousIdeal.irrelevant_eq_iSup]
      refine iSup_le fun n => iSup_le fun hn => ?_
      intro P hP
      change P ∈ 𝒜_Ω n at hP
      rw [MvPolynomial.mem_homogeneousSubmodule] at hP
      change g_ev P = 0
      rw [MvPolynomial.as_sum P, map_sum]
      refine Finset.sum_eq_zero fun d hd => ?_
      have hd_coeff : P.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
      have hdeg := hP hd_coeff
      have hd_ne : d ≠ 0 := by
        intro hd0
        subst hd0
        simp at hdeg
        omega
      obtain ⟨i₀, hi₀⟩ : ∃ i₀ : Fin (r₀ + 1), d i₀ ≠ 0 :=
        not_forall.mp (fun h_all => hd_ne (Finsupp.ext h_all))
      rw [MvPolynomial.monomial_eq, map_mul, map_finsuppProd]
      refine mul_eq_zero_of_right _ ?_
      exact Finset.prod_eq_zero (Finsupp.mem_support_iff.mpr hi₀)
        (by dsimp only; rw [map_pow, hg_ev_X i₀, zero_pow hi₀])
    have h_map_bot : Ideal.map g_ev (HomogeneousIdeal.irrelevant 𝒜_Ω).toIdeal ≤ ⊥ :=
      Ideal.map_le_iff_le_comap.mpr h_irr_ker
    have h_map_top : Ideal.map g_ev (HomogeneousIdeal.irrelevant 𝒜_Ω).toIdeal = ⊤ := by
      change Ideal.map (ev_Ω.comp f_a') (HomogeneousIdeal.irrelevant 𝒜_Ω).toIdeal = ⊤
      rw [← Ideal.map_map, hf_a', Ideal.map_top]
    rw [h_map_top] at h_map_bot
    exact bot_ne_top (eq_bot_iff.mpr h_map_bot).symm
  refine ⟨hSpanRaw, ?_, hFibClosed⟩
  let fst_h := CategoryTheory.Limits.pullback.fst g u_h
  let snd_h := CategoryTheory.Limits.pullback.snd g u_h
  obtain ⟨M_h, eIdx_h, hV_pb_h, hU_h⟩ := hMakePb fst_h
  have hV_h : ∀ a : Fin M_h.m,
      ⊤ ⊓ M_h.V a =
        ⊤ ⊓ (TopologicalSpace.Opens.map fst_h.base).obj (M.V (eIdx_h a)) := by
    intro a; rw [hV_pb_h a]
  refine ⟨M_h, eIdx_h, hV_h, ?_⟩
  dsimp only
  have hw1_id : 𝟙 C_h ≫ fst_h = fst_h := CategoryTheory.Category.id_comp _
  have hw2_id : 𝟙 C_h ≫ snd_h =
      snd_h ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id (Localization.Away h))) := by
    rw [CategoryTheory.Category.id_comp, CommRingCat.ofHom_id,
      AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.comp_id]
  have he_id_sec :=
    (hBasis (Localization.Away h) (RingHom.id (Localization.Away h))
      (𝟙 C_h) hw1_id hw2_id M_h eIdx_h hV_h (fun a b hEq => hU_h a b hEq)).1
  refine ⟨?_, ?_⟩
  · intro i
    have hs_eq : (fun a : Fin M_h.m =>
        (C_h.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV_h a))).op).hom
          (e_raw i (eIdx_h a))) =
        (fun a : Fin M_h.m =>
          (C_h.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV_h a))).op).hom
            ((AlgebraicGeometry.Scheme.Hom.app (𝟙 C_h)
              (⊤ ⊓ (TopologicalSpace.Opens.map fst_h.base).obj (M.V (eIdx_h a)))).hom
              (e_raw i (eIdx_h a)))) := by
      ext a
      refine congrArg (C_h.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV_h a))).op).hom ?_
      rw [AlgebraicGeometry.Scheme.Hom.id_app]
      rfl
    rw [hs_eq]
    exact he_id_sec i
  · intro a
    have hrange : (Set.range fun i : Fin (r₀ + 1) =>
        (C_h.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV_h a))).op).hom
          (e_raw i (eIdx_h a))) =
        (C_h.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV_h a))).op).hom ''
          (Set.range fun i : Fin (r₀ + 1) => e_raw i (eIdx_h a)) := by
      ext x; simp
    rw [hrange, ← Ideal.map_span, hSpanRaw (eIdx_h a), Ideal.map_top]

theorem weil_isClosedImmersion_of_isProper_of_algClosed_fibers (X Y : AlgebraicGeometry.Scheme.{u})
    (j : X ⟶ Y)
    (hProp : AlgebraicGeometry.IsProper j)
    (hFib : ∀ y : ↥Y,
      ∃ (Ω : Type u) (_ : Field Ω) (_ : IsAlgClosed Ω)
        (y_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y)
        (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω))),
        y_Ω.base pt = y ∧
        AlgebraicGeometry.IsClosedImmersion (CategoryTheory.Limits.pullback.snd j y_Ω)) :
    AlgebraicGeometry.IsClosedImmersion j :=
by
  have hSpecBot : ∀ (K : Type u) [Field K] (p : PrimeSpectrum K), p.asIdeal = ⊥ := by
    intro K _ p
    rcases Ideal.eq_bot_or_top p.asIdeal with hbot | htop
    · exact hbot
    · exact False.elim (p.isPrime.ne_top htop)
  have hSpecSub : ∀ (K : Type u) [Field K],
      Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := by
    intro K _
    change Subsingleton (PrimeSpectrum K)
    exact ⟨fun p₁ p₂ => PrimeSpectrum.ext ((hSpecBot K p₁).trans (hSpecBot K p₂).symm)⟩
  have hj_inj : ∀ x₁ x₂ : ↥X, j.base x₁ = j.base x₂ → x₁ = x₂ := by
    intro x₁ x₂ hx₁₂
    obtain ⟨Ω, instFieldΩ, _, y_Ω, pt, hpt, hCl⟩ := hFib (j.base x₁)
    let _ : Field Ω := instFieldΩ
    have _ : AlgebraicGeometry.IsClosedImmersion (CategoryTheory.Limits.pullback.snd j y_Ω) := hCl
    obtain ⟨z₁, hz₁_fst, hz₁_snd⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x₁ pt hpt.symm
    obtain ⟨z₂, hz₂_fst, hz₂_snd⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x₂ pt (hx₁₂.symm.trans hpt.symm)
    have hz_eq : z₁ = z₂ :=
      (CategoryTheory.Limits.pullback.snd j y_Ω).isClosedEmbedding.injective
        (hz₁_snd.trans hz₂_snd.symm)
    rw [← hz₁_fst, ← hz₂_fst, hz_eq]
  have _ : AlgebraicGeometry.IsProper j := hProp
  have hLqf : AlgebraicGeometry.LocallyQuasiFinite j := by
    rw [AlgebraicGeometry.locallyQuasiFinite_iff]
    intro U hU V hV e
    let P := ↑(Y.presheaf.obj (Opposite.op U))
    let Q := ↑(X.presheaf.obj (Opposite.op V))
    let φ : P →+* Q := (j.appLE U V e).hom
    let _ : Algebra P Q := φ.toAlgebra
    have _ : Algebra.FiniteType P Q := j.finiteType_appLE hU hV e
    change Algebra.QuasiFinite P Q
    rw [Algebra.QuasiFinite.iff_finite_comap_preimage_singleton]
    intro p
    refine Set.Subsingleton.finite ?_
    intro q₁ hq₁ q₂ hq₂
    have hq₁_eq : (AlgebraicGeometry.Spec.map (j.appLE U V e)).base q₁ = p := hq₁
    have hq₂_eq : (AlgebraicGeometry.Spec.map (j.appLE U V e)).base q₂ = p := hq₂
    have hSpecComm := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec j hU hV e
    have h1 : j.base (hV.fromSpec.base q₁) = hU.fromSpec.base p := by
      calc j.base (hV.fromSpec.base q₁)
          = (hV.fromSpec ≫ j).base q₁ := rfl
        _ = (AlgebraicGeometry.Spec.map (j.appLE U V e) ≫ hU.fromSpec).base q₁ := by
            rw [← hSpecComm]
        _ = hU.fromSpec.base ((AlgebraicGeometry.Spec.map (j.appLE U V e)).base q₁) := rfl
        _ = hU.fromSpec.base p := by rw [hq₁_eq]
    have h2 : j.base (hV.fromSpec.base q₂) = hU.fromSpec.base p := by
      calc j.base (hV.fromSpec.base q₂)
          = (hV.fromSpec ≫ j).base q₂ := rfl
        _ = (AlgebraicGeometry.Spec.map (j.appLE U V e) ≫ hU.fromSpec).base q₂ := by
            rw [← hSpecComm]
        _ = hU.fromSpec.base ((AlgebraicGeometry.Spec.map (j.appLE U V e)).base q₂) := rfl
        _ = hU.fromSpec.base p := by rw [hq₂_eq]
    exact hV.fromSpec.isOpenEmbedding.injective (hj_inj _ _ (h1.trans h2.symm))
  have _ : AlgebraicGeometry.LocallyQuasiFinite j := hLqf
  have _ : AlgebraicGeometry.IsFinite j :=
    AlgebraicGeometry.IsFinite.of_isProper_of_locallyQuasiFinite j
  rw [AlgebraicGeometry.isClosedImmersion_iff_isAffineHom]
  refine ⟨inferInstance, ?_⟩
  intro U hU
  let P_cat := Y.presheaf.obj (Opposite.op U)
  let P : Type u := ↑P_cat
  let V : X.Opens := (TopologicalSpace.Opens.map j.base).obj U
  let Q_cat := X.presheaf.obj (Opposite.op V)
  let Q : Type u := ↑Q_cat
  let φ : P →+* Q := (j.app U).hom
  let _ : Algebra P Q := φ.toAlgebra
  have hFinφ : φ.Finite := AlgebraicGeometry.IsFinite.finite_app j U hU
  have _ : Module.Finite P Q := hFinφ
  have hMaxFib : ∀ (𝔪 : Ideal P), 𝔪.IsMaximal →
      ∃ (Ω : Type u) (_ : Field Ω) (θ : P →+* Ω),
        RingHom.ker θ = 𝔪 ∧
        (letI : Algebra P Ω := θ.toAlgebra
         Function.Surjective
           (Algebra.TensorProduct.includeRight : Ω →ₐ[P] TensorProduct P Q Ω)) := by
    intro 𝔪 h𝔪
    have _ : 𝔪.IsMaximal := h𝔪
    let p_𝔪 : PrimeSpectrum P := ⟨𝔪, h𝔪.isPrime⟩
    let y : ↥Y := hU.fromSpec.base p_𝔪
    obtain ⟨Ω, instFieldΩ, _, y_Ω, pt, hpt, hCl⟩ := hFib y
    let _ : Field Ω := instFieldΩ
    have _ : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := hSpecSub Ω
    have hRange : Set.range y_Ω.base ⊆ Set.range hU.fromSpec.base := by
      rintro _ ⟨z, rfl⟩
      rw [Subsingleton.elim z pt, hpt]
      exact ⟨p_𝔪, rfl⟩
    let y_U : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec P_cat :=
      AlgebraicGeometry.IsOpenImmersion.lift hU.fromSpec y_Ω hRange
    have hy_U : y_U ≫ hU.fromSpec = y_Ω :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hU.fromSpec y_Ω hRange
    have hy_U_pt : y_U.base pt = p_𝔪 := by
      apply hU.fromSpec.isOpenEmbedding.injective
      change (y_U ≫ hU.fromSpec).base pt = hU.fromSpec.base p_𝔪
      rw [hy_U, hpt]
    let θ : P →+* Ω := (AlgebraicGeometry.Spec.preimage y_U).hom
    have hSpec_θ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) = y_U :=
      AlgebraicGeometry.Spec.map_preimage y_U
    have hker : RingHom.ker θ = 𝔪 := by
      have hcomap : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ)).base pt = p_𝔪 := by
        rw [hSpec_θ, hy_U_pt]
      have hIdeal : Ideal.comap θ (pt : PrimeSpectrum Ω).asIdeal = 𝔪 :=
        congrArg PrimeSpectrum.asIdeal hcomap
      rwa [hSpecBot Ω pt, ← RingHom.ker_eq_comap_bot] at hIdeal
    let _ : Algebra P Ω := θ.toAlgebra
    refine ⟨Ω, instFieldΩ, θ, hker, ?_⟩
    have hV : AlgebraicGeometry.IsAffineOpen V := hU.preimage j
    have hSq : hV.fromSpec ≫ j = AlgebraicGeometry.Spec.map (j.app U) ≫ hU.fromSpec := by
      rw [j.app_eq_appLE]
      exact (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec j hU hV le_rfl).symm
    have hOpens :
        (TopologicalSpace.Opens.map j.base).obj hU.fromSpec.opensRange =
          hV.fromSpec.opensRange := by
      rw [hU.opensRange_fromSpec, hV.opensRange_fromSpec]
    have hPb_chart :
        CategoryTheory.IsPullback hV.fromSpec (AlgebraicGeometry.Spec.map (j.app U)) j hU.fromSpec :=
      (AlgebraicGeometry.IsOpenImmersion.isPullback
        (AlgebraicGeometry.Spec.map (j.app U)) hV.fromSpec hU.fromSpec j hSq hOpens).flip
    have hPb_fib :
        CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst (AlgebraicGeometry.Spec.map (j.app U)) y_U ≫
            hV.fromSpec)
          (CategoryTheory.Limits.pullback.snd (AlgebraicGeometry.Spec.map (j.app U)) y_U)
          j y_Ω := by
      have hPaste :=
        (CategoryTheory.IsPullback.of_hasPullback
          (AlgebraicGeometry.Spec.map (j.app U)) y_U).paste_horiz hPb_chart
      rwa [hy_U] at hPaste
    have _ : AlgebraicGeometry.IsClosedImmersion (CategoryTheory.Limits.pullback.snd j y_Ω) := hCl
    have hCl_snd_U :
        AlgebraicGeometry.IsClosedImmersion
          (CategoryTheory.Limits.pullback.snd (AlgebraicGeometry.Spec.map (j.app U)) y_U) := by
      rw [← hPb_fib.isoPullback_hom_snd]
      infer_instance
    have hCl_snd_alg :
        AlgebraicGeometry.IsClosedImmersion
          (CategoryTheory.Limits.pullback.snd
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P Q)))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P Ω)))) := by
      have hEq1 : CommRingCat.ofHom (algebraMap P Q) = j.app U := rfl
      have hEq2 :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P Ω)) = y_U := hSpec_θ
      rwa [hEq1, hEq2]
    let ι_R := CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : Ω →ₐ[P] TensorProduct P Q Ω).toRingHom
    have hCl_spec : AlgebraicGeometry.IsClosedImmersion (AlgebraicGeometry.Spec.map ι_R) := by
      have _ := hCl_snd_alg
      have hCl_comp :
          AlgebraicGeometry.IsClosedImmersion
            ((AlgebraicGeometry.pullbackSpecIso P Q Ω).inv ≫
              CategoryTheory.Limits.pullback.snd
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P Q)))
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P Ω)))) :=
        inferInstance
      rwa [AlgebraicGeometry.pullbackSpecIso_inv_snd P Q Ω] at hCl_comp
    have _ := hCl_spec
    have hSurjTop : Function.Surjective ((AlgebraicGeometry.Spec.map ι_R).appTop).hom :=
      (AlgebraicGeometry.IsClosedImmersion.isAffine_surjective_of_isAffine
        (AlgebraicGeometry.Spec.map ι_R)).2
    have hNat := AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality ι_R
    have hSurjComp :
        Function.Surjective
          (ι_R ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (TensorProduct P Q Ω))).inv).hom := by
      rw [hNat]
      change Function.Surjective
        (((AlgebraicGeometry.Spec.map ι_R).appTop).hom ∘
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)
      exact hSurjTop.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).symm.commRingCatIsoToRingEquiv.surjective
    intro z
    obtain ⟨ω, hω⟩ := hSurjComp
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (TensorProduct P Q Ω))).inv.hom z)
    refine ⟨ω, ?_⟩
    exact (AlgebraicGeometry.Scheme.ΓSpecIso
      (CommRingCat.of (TensorProduct P Q Ω))).symm.commRingCatIsoToRingEquiv.injective hω
  let N_sub : Submodule P Q := LinearMap.range (Algebra.linearMap P Q)
  let M_cok : Type u := Q ⧸ N_sub
  have _ : Module.Finite P M_cok :=
    Module.Finite.of_surjective N_sub.mkQ (Submodule.mkQ_surjective N_sub)
  have hFG : (⊤ : Submodule P M_cok).FG := Module.Finite.fg_top
  have hSmulTop : ∀ (𝔪 : Ideal P), 𝔪.IsMaximal →
      (⊤ : Submodule P M_cok) ≤ 𝔪 • (⊤ : Submodule P M_cok) := by
    intro 𝔪 h𝔪
    have _ : 𝔪.IsMaximal := h𝔪
    obtain ⟨Ω, instFieldΩ, θ, hker, hSurj⟩ := hMaxFib 𝔪 h𝔪
    let _ : Field Ω := instFieldΩ
    let _ : Algebra P Ω := θ.toAlgebra
    let mapN := TensorProduct.map N_sub.subtype (LinearMap.id : Ω →ₗ[P] Ω)
    have h1_mem_N : (1 : Q) ∈ N_sub := ⟨1, map_one φ⟩
    have hRangeTop : LinearMap.range mapN = ⊤ := by
      rw [eq_top_iff]
      intro z _
      obtain ⟨ω, rfl⟩ := hSurj z
      exact ⟨TensorProduct.tmul P ⟨1, h1_mem_N⟩ ω, rfl⟩
    have hSubQuot : Subsingleton (TensorProduct P Q Ω ⧸ LinearMap.range mapN) :=
      Submodule.Quotient.subsingleton_iff.mpr hRangeTop
    let e₁ := TensorProduct.quotientTensorEquiv Ω N_sub
    have hSubMΩ : Subsingleton (TensorProduct P M_cok Ω) :=
      ⟨fun x y => e₁.injective (@Subsingleton.elim _ hSubQuot (e₁ x) (e₁ y))⟩
    let e₂ := (TensorProduct.comm P M_cok Ω).symm
    have hSubΩM : Subsingleton (TensorProduct P Ω M_cok) :=
      ⟨fun x y => e₂.injective (@Subsingleton.elim _ hSubMΩ (e₂ x) (e₂ y))⟩
    let κ : Type u := P ⧸ 𝔪
    let _ : Field κ := Ideal.Quotient.field 𝔪
    let θ_bar : κ →+* Ω := Ideal.Quotient.lift 𝔪 θ (fun a ha => by rwa [← hker] at ha)
    let _ : Algebra κ Ω := θ_bar.toAlgebra
    have _ : IsScalarTower P κ Ω := IsScalarTower.of_algebraMap_eq' rfl
    have _ : Module.Flat κ Ω := Module.Flat.of_free
    have hFF : Module.FaithfullyFlat κ Ω := by
      rw [Module.FaithfullyFlat.iff_flat_and_ideal_smul_eq_top]
      refine ⟨inferInstance, ?_⟩
      intro I hI
      rcases Ideal.eq_bot_or_top I with rfl | htop
      · exfalso
        have h1_mem : (1 : Ω) ∈ (⊥ : Ideal κ) • (⊤ : Submodule κ Ω) := by
          rw [hI]; exact Submodule.mem_top
        have hle : (⊥ : Ideal κ) • (⊤ : Submodule κ Ω) ≤ ⊥ :=
          Submodule.smul_le.mpr fun r hr x _ => by
            rw [Ideal.mem_bot] at hr
            rw [hr, zero_smul]
            exact Submodule.zero_mem ⊥
        have h1_bot : (1 : Ω) ∈ (⊥ : Submodule κ Ω) := hle h1_mem
        rw [Submodule.mem_bot] at h1_bot
        exact one_ne_zero h1_bot
      · exact htop
    let e₃ := TensorProduct.AlgebraTensorModule.cancelBaseChange P κ Ω Ω M_cok
    have hSubCancel : Subsingleton (TensorProduct κ Ω (TensorProduct P κ M_cok)) :=
      ⟨fun x y => e₃.injective (@Subsingleton.elim _ hSubΩM (e₃ x) (e₃ y))⟩
    have hSubκM : Subsingleton (TensorProduct P κ M_cok) :=
      ((Module.FaithfullyFlat.iff_flat_and_lTensor_reflects_triviality κ Ω).mp hFF).2
        (TensorProduct P κ M_cok) hSubCancel
    let e₄ := (TensorProduct.quotTensorEquivQuotSMul M_cok 𝔪).symm
    have hSubMod : Subsingleton (M_cok ⧸ (𝔪 • (⊤ : Submodule P M_cok))) :=
      ⟨fun x y => e₄.injective (@Subsingleton.elim _ hSubκM (e₄ x) (e₄ y))⟩
    have hEqTop : 𝔪 • (⊤ : Submodule P M_cok) = ⊤ :=
      Submodule.Quotient.subsingleton_iff.mp hSubMod
    exact le_of_eq hEqTop.symm
  intro q
  let v : M_cok := Submodule.Quotient.mk q
  let J_v : Ideal P := (⊥ : Submodule P M_cok).comap (LinearMap.toSpanSingleton P M_cok v)
  have hJv_top : J_v = ⊤ := by
    by_contra hJv_ne
    obtain ⟨𝔪, h𝔪, hJ_le⟩ := Ideal.exists_le_maximal J_v hJv_ne
    obtain ⟨r, hr_mem, hr_smul⟩ :=
      Submodule.exists_mem_and_smul_eq_self_of_fg_of_le_smul 𝔪 (⊤ : Submodule P M_cok)
        hFG (hSmulTop 𝔪 h𝔪)
    have h1_sub_mem_J : 1 - r ∈ J_v := by
      change (1 - r) • v = 0
      rw [sub_smul, one_smul, hr_smul v Submodule.mem_top, sub_self]
    have h1_mem : (1 : P) ∈ 𝔪 := by
      have h1 : (1 : P) = r + (1 - r) := by ring
      rw [h1]
      exact 𝔪.add_mem hr_mem (hJ_le h1_sub_mem_J)
    exact h𝔪.ne_top ((Ideal.eq_top_iff_one 𝔪).mpr h1_mem)
  have hv_zero : v = 0 := by
    have h1_in_J : (1 : P) ∈ J_v := by rw [hJv_top]; trivial
    change (1 : P) • v = 0 at h1_in_J
    rwa [one_smul] at h1_in_J
  have hq_sub : q - 0 ∈ N_sub := (Submodule.Quotient.eq N_sub).mp hv_zero
  rw [sub_zero] at hq_sub
  rcases hq_sub with ⟨p, hp⟩
  exact ⟨p, hp⟩

theorem weil_universal_tricanonical_basis_to_relative_proj_closedImmersion (R : Type u) [CommRing R] [IsNoetherianRing R]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hProp : AlgebraicGeometry.IsProper g)
    (M : WeilLineBundle C)
    (hAffM : ∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a))
    (hFib : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (M_s : WeilLineBundle (CategoryTheory.Limits.pullback g s)),
      WeilPullbackLineBundle (CategoryTheory.Limits.pullback.fst g s) M M_s →
      HasFiberTricanonicalProperties (CategoryTheory.Limits.pullback.snd g s) M_s)
    (h : R) (r₀ : ℕ) (hr₀ : 3 ≤ r₀)
    (e_raw : Fin (r₀ + 1) → ∀ a : Fin M.m,
      ↑((CategoryTheory.Limits.pullback g
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap R (Localization.Away h))))).presheaf.obj
        (Opposite.op
          (⊤ ⊓ (TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.fst g
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap R (Localization.Away h))))).base).obj (M.V a)))))
    (hBasis : ∀ (R' : Type u) [CommRing R'] (ψ : Localization.Away h →+* R'),
      let u_h := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap R (Localization.Away h)))
      let u' := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (ψ.comp (algebraMap R (Localization.Away h))))
      let C' := CategoryTheory.Limits.pullback g u'
      let snd' := CategoryTheory.Limits.pullback.snd g u'
      ∀ (w' : C' ⟶ CategoryTheory.Limits.pullback g u_h),
        w' ≫ CategoryTheory.Limits.pullback.fst g u_h =
          CategoryTheory.Limits.pullback.fst g u' →
        w' ≫ CategoryTheory.Limits.pullback.snd g u_h =
          snd' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) →
        ∀ (M' : WeilLineBundle C') (eIdx : Fin M'.m ≃ Fin M.m)
          (hV : ∀ a : Fin M'.m,
            ⊤ ⊓ M'.V a =
              (TopologicalSpace.Opens.map w'.base).obj
                (⊤ ⊓ (TopologicalSpace.Opens.map
                  (CategoryTheory.Limits.pullback.fst g u_h).base).obj (M.V (eIdx a)))),
          (∀ a b : Fin M'.m,
            ∀ hEq : M'.V a ⊓ M'.V b =
                (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g u').base).obj
                  (M.V (eIdx a) ⊓ M.V (eIdx b)),
              (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq hEq.symm)).op).hom
                  (M'.u a b).val =
                ((CategoryTheory.Limits.pullback.fst g u').app
                  (M.V (eIdx a) ⊓ M.V (eIdx b))).hom (M.u (eIdx a) (eIdx b)).val) →
          let e' : Fin (r₀ + 1) → ∀ a : Fin M'.m,
              ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))) :=
            fun i a =>
              (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV a))).op).hom
                ((w'.app _).hom (e_raw i (eIdx a)))
          (∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M' ⊤ (e' i)) ∧
          (∀ s' : ∀ a : Fin M'.m, ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))),
            IsWeilTricanonicalSection M' ⊤ s' →
            ∃! c : Fin (r₀ + 1) → R',
              ∀ a : Fin M'.m,
                s' a = ∑ i : Fin (r₀ + 1),
                  (C'.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M'.V a ≤ ⊤)).op).hom
                    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫
                      snd'.appTop).hom (c i)) * e' i a)) :
    ∀ (R' : Type u) [CommRing R'] (ψ : Localization.Away h →+* R'),
      let u_h := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap R (Localization.Away h)))
      let u' := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (ψ.comp (algebraMap R (Localization.Away h))))
      let C' := CategoryTheory.Limits.pullback g u'
      let snd' := CategoryTheory.Limits.pullback.snd g u'
      ∀ (w' : C' ⟶ CategoryTheory.Limits.pullback g u_h),
        w' ≫ CategoryTheory.Limits.pullback.fst g u_h =
          CategoryTheory.Limits.pullback.fst g u' →
        w' ≫ CategoryTheory.Limits.pullback.snd g u_h =
          snd' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) →
        ∀ (M' : WeilLineBundle C') (eIdx : Fin M'.m ≃ Fin M.m)
          (hV : ∀ a : Fin M'.m,
            ⊤ ⊓ M'.V a =
              (TopologicalSpace.Opens.map w'.base).obj
                (⊤ ⊓ (TopologicalSpace.Opens.map
                  (CategoryTheory.Limits.pullback.fst g u_h).base).obj (M.V (eIdx a)))),
          (∀ a b : Fin M'.m,
            ∀ hEq : M'.V a ⊓ M'.V b =
                (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g u').base).obj
                  (M.V (eIdx a) ⊓ M.V (eIdx b)),
              (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq hEq.symm)).op).hom
                  (M'.u a b).val =
                ((CategoryTheory.Limits.pullback.fst g u').app
                  (M.V (eIdx a) ⊓ M.V (eIdx b))).hom (M.u (eIdx a) (eIdx b)).val) →
          let e' : Fin (r₀ + 1) → ∀ a : Fin M'.m,
              ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))) :=
            fun i a =>
              (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV a))).op).hom
                ((w'.app _).hom (e_raw i (eIdx a)))
          ∃ (j' : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) R') :=
                    MvPolynomial.gradedAlgebra
                  (⊤ : C'.Opens).toScheme ⟶
                    AlgebraicGeometry.Proj
                      (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) R')),
            IsLineBundleProjMorphism M' ⊤
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫ snd'.appTop).hom
              r₀ e' j' ∧
            AlgebraicGeometry.IsClosedImmersion j' :=
by
  have _ := hr₀
  obtain ⟨hPrecomp, hMapProj⟩ :=
    weil_proj_mvPoly_fromOfGlobalSections_functoriality_and_baseChange.{u} r₀
  obtain ⟨hGlue, hSpanPb⟩ :=
    weil_lineBundle_glued_projMorphism_and_pullback.{u} r₀ hPrecomp
  obtain ⟨hSpanRaw, ⟨M_h, eIdx_h, hV_h, he_h_sec, hSpan_h⟩, hFibClosed⟩ :=
    weil_universal_tricanonical_basis_span_top_and_algClosed_fiber
      R C g M hAffM hFib h r₀ e_raw hBasis
  let u_h := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap R (Localization.Away h)))
  let C_h := CategoryTheory.Limits.pullback g u_h
  let snd_h := CategoryTheory.Limits.pullback.snd g u_h
  let 𝒜_h := MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) (Localization.Away h)
  let _ : GradedAlgebra 𝒜_h := MvPolynomial.gradedAlgebra
  let e_h : Fin (r₀ + 1) → ∀ a : Fin M_h.m,
      ↑(C_h.presheaf.obj (Opposite.op (⊤ ⊓ M_h.V a))) :=
    fun i a =>
      (C_h.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV_h a))).op).hom
        (e_raw i (eIdx_h a))
  obtain ⟨j_h, hj_h_proj⟩ :=
    (hGlue (Localization.Away h) C_h snd_h M_h e_h).2.2 he_h_sec hSpan_h
  have hj_h_comm :
      j_h ≫
        AlgebraicGeometry.Proj.toSpecZero 𝒜_h ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (Localization.Away h) ↥(𝒜_h 0))) =
        (⊤ : C_h.Opens).ι ≫ snd_h :=
    (hGlue (Localization.Away h) C_h snd_h M_h e_h).1 j_h hj_h_proj
  let π_h :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜_h ≫
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (Localization.Away h) ↥(𝒜_h 0)))
  have _ : AlgebraicGeometry.IsProper g := hProp
  have hProp_snd_h : AlgebraicGeometry.IsProper snd_h := inferInstance
  have hIso_top : CategoryTheory.IsIso (⊤ : C_h.Opens).ι := by
    rw [← AlgebraicGeometry.Scheme.topIso_hom]
    infer_instance
  have hProp_comp : AlgebraicGeometry.IsProper (j_h ≫ π_h) := by
    change AlgebraicGeometry.IsProper
      (j_h ≫
        AlgebraicGeometry.Proj.toSpecZero 𝒜_h ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (Localization.Away h) ↥(𝒜_h 0))))
    rw [hj_h_comm]
    infer_instance
  have hSep_π_h : AlgebraicGeometry.IsSeparated π_h := inferInstance
  have hProp_jh : AlgebraicGeometry.IsProper j_h :=
    AlgebraicGeometry.IsProper.of_comp j_h π_h
  have hj_h_closed : AlgebraicGeometry.IsClosedImmersion j_h := by
    apply weil_isClosedImmersion_of_isProper_of_algClosed_fibers _ _ j_h hProp_jh
    intro y
    let κ_y := (AlgebraicGeometry.Proj 𝒜_h).residueField y
    let Ω : Type u := AlgebraicClosure ↥κ_y
    let y_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Proj 𝒜_h :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥κ_y Ω)) ≫
        (AlgebraicGeometry.Proj 𝒜_h).fromSpecResidueField y
    let pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
      (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum Ω)
    have hpt : y_Ω.base pt = y := by
      change (AlgebraicGeometry.Proj 𝒜_h).fromSpecResidueField y
        ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥κ_y Ω))) pt) = y
      exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply y _
    let ψ_Ω : Localization.Away h →+* Ω :=
      (AlgebraicGeometry.Spec.preimage (y_Ω ≫ π_h)).hom
    have hSpec_ψ_Ω :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ω) = y_Ω ≫ π_h :=
      AlgebraicGeometry.Spec.map_preimage (y_Ω ≫ π_h)
    let 𝒜_Ω := MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) Ω
    let _ : GradedAlgebra 𝒜_Ω := MvPolynomial.gradedAlgebra
    obtain ⟨Ψ_Ω, hΨ_Ω, _, hPbProj_Ω, hPost_Ω⟩ :=
      hMapProj (Localization.Away h) Ω ψ_Ω
    obtain ⟨w_Ω, hw1_Ω, hw2_Ω, M_Ω, eIdx_Ω, hV_Ω, j_Ω, hj_Ω_proj, hj_Ω_closed⟩ :=
      hFibClosed Ω ψ_Ω
    have hPbJ_Ω :=
      (hSpanPb R C g M h e_raw hSpanRaw M_h eIdx_h hV_h j_h hj_h_proj
        Ω ψ_Ω w_Ω hw1_Ω hw2_Ω M_Ω eIdx_Ω hV_Ω).2
        j_Ω hj_Ω_proj Ψ_Ω hΨ_Ω hPbProj_Ω hPost_Ω
    have hLiftComm :
        y_Ω ≫ π_h =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ω) := by
      rw [CategoryTheory.Category.id_comp, hSpec_ψ_Ω]
    let y_hat : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Proj 𝒜_Ω :=
      hPbProj_Ω.lift y_Ω (𝟙 _) hLiftComm
    have hy_hat_fst : y_hat ≫ AlgebraicGeometry.Proj.map Ψ_Ω hΨ_Ω = y_Ω :=
      hPbProj_Ω.lift_fst y_Ω (𝟙 _) hLiftComm
    have hPbFib :
        CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst j_Ω y_hat ≫
            ((⊤ : (CategoryTheory.Limits.pullback g
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (ψ_Ω.comp (algebraMap R (Localization.Away h)))))).Opens).ι ≫
              w_Ω ≫ C_h.topIso.inv))
          (CategoryTheory.Limits.pullback.snd j_Ω y_hat)
          j_h y_Ω := by
      have hPaste :=
        (CategoryTheory.IsPullback.of_hasPullback j_Ω y_hat).paste_horiz hPbJ_Ω
      rwa [hy_hat_fst] at hPaste
    have _ : AlgebraicGeometry.IsClosedImmersion j_Ω := hj_Ω_closed
    have hCl_snd_h :
        AlgebraicGeometry.IsClosedImmersion
          (CategoryTheory.Limits.pullback.snd j_h y_Ω) := by
      rw [← hPbFib.isoPullback_inv_snd]
      infer_instance
    exact ⟨Ω, inferInstance, inferInstance, y_Ω, pt, hpt, hCl_snd_h⟩
  intro R' _ ψ u_h' u' C' snd' w' hw1 hw2 M' eIdx hV hU e'
  let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) R') :=
    MvPolynomial.gradedAlgebra
  have he'_sec : ∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M' ⊤ (e' i) :=
    (hBasis R' ψ w' hw1 hw2 M' eIdx hV hU).1
  obtain ⟨Ψ, hΨ, _, hPbProj, hPost⟩ := hMapProj (Localization.Away h) R' ψ
  have hSpanAndPb :=
    hSpanPb R C g M h e_raw hSpanRaw M_h eIdx_h hV_h j_h hj_h_proj
      R' ψ w' hw1 hw2 M' eIdx hV
  obtain ⟨j', hj'_proj⟩ :=
    (hGlue R' C' snd' M' e').2.2 he'_sec hSpanAndPb.1
  have hPbJ' := hSpanAndPb.2 j' hj'_proj Ψ hΨ hPbProj hPost
  have hj'_closed : AlgebraicGeometry.IsClosedImmersion j' :=
    AlgebraicGeometry.IsClosedImmersion.isStableUnderBaseChange.of_isPullback
      hPbJ' hj_h_closed
  exact ⟨j', hj'_proj, hj'_closed⟩

theorem weil_proper_flat_lineBundle_cohomology_baseChange_and_projImmersion (R : Type u) [CommRing R] [IsNoetherianRing R]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hFlat : AlgebraicGeometry.Flat g)
    (hProp : AlgebraicGeometry.IsProper g)
    (hLfp : AlgebraicGeometry.LocallyOfFinitePresentation g)
    (M : WeilLineBundle C)
    (hAffM : ∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a))
    (hFib : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (M_s : WeilLineBundle (CategoryTheory.Limits.pullback g s)),
      WeilPullbackLineBundle (CategoryTheory.Limits.pullback.fst g s) M M_s →
      HasFiberTricanonicalProperties (CategoryTheory.Limits.pullback.snd g s) M_s) :
    HasLocalFreeTricanonicalBaseChange g M :=
by
  have _ := hLfp
  obtain ⟨instMod, d, hSmul, hDiff, hd2, hBound, hFlatK, hBridge, hSpecFib⟩ :=
    weil_cech_cochain_flat_baseChange_and_fiber_vanishing R C g hFlat hProp M hAffM hFib
  let _ : ∀ p : ℕ, Module R (WeilTricanonicalCechCochain M p) := instMod
  obtain ⟨⟨k₀, gen₀, hgen₀_ker, hgen₀_span⟩, hSuccGen⟩ :=
    weil_proper_noetherian_lineBundle_cech_cohomology_finite
      (fun R₀ _ _ Z g_Z hIntZ hPropZ =>
        weil_noetherian_integral_proper_chow_modification R₀ Z g_Z hIntZ hPropZ)
      R C g hProp M hAffM
  have hFin0 : Module.Finite R ↥(LinearMap.ker (d 0)) := by
    let gen₀_sub : Fin k₀ → ↥(LinearMap.ker (d 0)) := fun j =>
      ⟨gen₀ j, by rw [LinearMap.mem_ker, hDiff]; exact hgen₀_ker j⟩
    let φ₀ : (Fin k₀ → R) →ₗ[R] ↥(LinearMap.ker (d 0)) :=
      { toFun := fun c => ∑ j : Fin k₀, c j • gen₀_sub j
        map_add' := fun c₁ c₂ => by simp [add_smul, Finset.sum_add_distrib]
        map_smul' := fun r c => by simp [mul_smul, Finset.smul_sum] }
    apply Module.Finite.of_surjective φ₀
    intro z
    obtain ⟨c, hc⟩ := hgen₀_span z.1 (by rw [← hDiff]; exact z.2)
    refine ⟨c, Subtype.ext ?_⟩
    change (∑ j : Fin k₀, c j • gen₀_sub j).1 = z.1
    rw [AddSubmonoidClass.coe_finsetSum, hc]
    refine Finset.sum_congr rfl fun j _ => ?_
    exact hSmul 0 (c j) (gen₀ j)
  have hFinSucc : ∀ p : ℕ, Module.Finite R
      (↥(LinearMap.ker (d (p + 1))) ⧸
        (LinearMap.range (d p)).comap (LinearMap.ker (d (p + 1))).subtype) := by
    intro p
    obtain ⟨k, gen, hgen_ker, hgen_span⟩ := hSuccGen p
    let B_sub : Submodule R ↥(LinearMap.ker (d (p + 1))) :=
      (LinearMap.range (d p)).comap (LinearMap.ker (d (p + 1))).subtype
    let gen_sub : Fin k → ↥(LinearMap.ker (d (p + 1))) := fun j =>
      ⟨gen j, by rw [LinearMap.mem_ker, hDiff]; exact hgen_ker j⟩
    let gen_q : Fin k → ↥(LinearMap.ker (d (p + 1))) ⧸ B_sub := fun j =>
      Submodule.mkQ B_sub (gen_sub j)
    let φ_p : (Fin k → R) →ₗ[R] (↥(LinearMap.ker (d (p + 1))) ⧸ B_sub) :=
      { toFun := fun c => ∑ j : Fin k, c j • gen_q j
        map_add' := fun c₁ c₂ => by simp [add_smul, Finset.sum_add_distrib]
        map_smul' := fun r c => by simp [mul_smul, Finset.smul_sum] }
    apply Module.Finite.of_surjective φ_p
    intro q_el
    obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective B_sub q_el
    obtain ⟨c, b, hzb⟩ := hgen_span z.1 (by rw [← hDiff]; exact z.2)
    refine ⟨c, ?_⟩
    have hφ_eq : φ_p c = Submodule.mkQ B_sub (∑ j : Fin k, c j • gen_sub j) := by
      change ∑ j : Fin k, c j • Submodule.mkQ B_sub (gen_sub j) =
        Submodule.mkQ B_sub (∑ j : Fin k, c j • gen_sub j)
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      exact (LinearMap.map_smul (Submodule.mkQ B_sub) (c j) (gen_sub j)).symm
    rw [hφ_eq]
    change Submodule.Quotient.mk (∑ j : Fin k, c j • gen_sub j) = Submodule.Quotient.mk z
    rw [Submodule.Quotient.eq, Submodule.mem_comap, LinearMap.mem_range]
    refine ⟨-b, ?_⟩
    change d p (-b) = (∑ j : Fin k, c j • gen_sub j).1 - z.1
    rw [map_neg, hDiff, AddSubmonoidClass.coe_finsetSum]
    have hsum_eq : ∑ j : Fin k, (c j • gen_sub j).1 =
        ∑ j : Fin k, weilCechSmul g M (p + 1) (c j) (gen j) :=
      Finset.sum_congr rfl fun j _ => hSmul (p + 1) (c j) (gen j)
    rw [hsum_eq, hzb]
    abel
  intro q
  obtain ⟨r₀, hr₀, hVan_q, hDim_q⟩ := hSpecFib q
  obtain ⟨h, hh, v, hv_univ⟩ :=
    weil_flat_cochain_noetherian_nakayama_universal_free_baseChange
      R q M.m r₀ (WeilTricanonicalCechCochain M) d hd2 hBound hFlatK hFin0 hFinSucc hVan_q hDim_q
  obtain ⟨e_raw, he_raw⟩ := hBridge h r₀ v
  have hBasis : ∀ (R' : Type u) [CommRing R'] (ψ : Localization.Away h →+* R'),
      let u_h := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap R (Localization.Away h)))
      let u' := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (ψ.comp (algebraMap R (Localization.Away h))))
      let C' := CategoryTheory.Limits.pullback g u'
      let snd' := CategoryTheory.Limits.pullback.snd g u'
      ∀ (w' : C' ⟶ CategoryTheory.Limits.pullback g u_h),
        w' ≫ CategoryTheory.Limits.pullback.fst g u_h =
          CategoryTheory.Limits.pullback.fst g u' →
        w' ≫ CategoryTheory.Limits.pullback.snd g u_h =
          snd' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) →
        ∀ (M' : WeilLineBundle C') (eIdx : Fin M'.m ≃ Fin M.m)
          (hV : ∀ a : Fin M'.m,
            ⊤ ⊓ M'.V a =
              (TopologicalSpace.Opens.map w'.base).obj
                (⊤ ⊓ (TopologicalSpace.Opens.map
                  (CategoryTheory.Limits.pullback.fst g u_h).base).obj (M.V (eIdx a)))),
          (∀ a b : Fin M'.m,
            ∀ hEq : M'.V a ⊓ M'.V b =
                (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g u').base).obj
                  (M.V (eIdx a) ⊓ M.V (eIdx b)),
              (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq hEq.symm)).op).hom
                  (M'.u a b).val =
                ((CategoryTheory.Limits.pullback.fst g u').app
                  (M.V (eIdx a) ⊓ M.V (eIdx b))).hom (M.u (eIdx a) (eIdx b)).val) →
          let e' : Fin (r₀ + 1) → ∀ a : Fin M'.m,
              ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))) :=
            fun i a =>
              (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV a))).op).hom
                ((w'.app _).hom (e_raw i (eIdx a)))
          (∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M' ⊤ (e' i)) ∧
          (∀ s' : ∀ a : Fin M'.m, ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))),
            IsWeilTricanonicalSection M' ⊤ s' →
            ∃! c : Fin (r₀ + 1) → R',
              ∀ a : Fin M'.m,
                s' a = ∑ i : Fin (r₀ + 1),
                  (C'.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M'.V a ≤ ⊤)).op).hom
                    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫
                      snd'.appTop).hom (c i)) * e' i a) := by
    intro R' _ ψ
    let _ : Algebra R R' := (ψ.comp (algebraMap R (Localization.Away h))).toAlgebra
    let _ : Algebra (Localization.Away h) R' := ψ.toAlgebra
    have _ : IsScalarTower R (Localization.Away h) R' := IsScalarTower.of_algebraMap_eq' rfl
    exact he_raw R' ψ (hv_univ R')
  have hProjImm :=
    weil_universal_tricanonical_basis_to_relative_proj_closedImmersion
      R C g hProp M hAffM hFib h r₀ hr₀ e_raw hBasis
  refine ⟨h, hh, r₀, hr₀, e_raw, ?_⟩
  intro R' _ ψ _ _ _ _ w' hw1 hw2 M' eIdx hV hU
  obtain ⟨hP1, hP2⟩ := hBasis R' ψ w' hw1 hw2 M' eIdx hV hU
  exact ⟨hP1, hP2, hProjImm R' ψ w' hw1 hw2 M' eIdx hV hU⟩

theorem weil_proj_bundle_atlas_of_relative_very_ample_lineBundle (S : AlgebraicGeometry.Scheme.{u})
    (hIntS : AlgebraicGeometry.IsIntegral S)
    (hCompS : CompactSpace ↥S)
    (hSepS : S.IsSeparated)
    (hNoethS : ∀ U : S.Opens, AlgebraicGeometry.IsAffineOpen U →
      IsNoetherianRing ↑(S.presheaf.obj (Opposite.op U)))
    (C : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S)
    (hFlat : AlgebraicGeometry.Flat g)
    (hProp : AlgebraicGeometry.IsProper g)
    (hLfp : AlgebraicGeometry.LocallyOfFinitePresentation g)
    (M : WeilLineBundle C)
    (hAffM : ∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a))
    (hFibM : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S)
      (M_s : WeilLineBundle (CategoryTheory.Limits.pullback g s)),
      WeilPullbackLineBundle (CategoryTheory.Limits.pullback.fst g s) M M_s →
      HasFiberTricanonicalProperties (CategoryTheory.Limits.pullback.snd g s) M_s)
    (hBaseChange : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R]
      (C_R : AlgebraicGeometry.Scheme.{u})
      (g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)),
      AlgebraicGeometry.Flat g_R →
      AlgebraicGeometry.IsProper g_R →
      AlgebraicGeometry.LocallyOfFinitePresentation g_R →
      ∀ (M_R : WeilLineBundle C_R),
        (∀ a : Fin M_R.m, AlgebraicGeometry.IsAffineOpen (M_R.V a)) →
        (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
          (M_s : WeilLineBundle (CategoryTheory.Limits.pullback g_R s)),
          WeilPullbackLineBundle (CategoryTheory.Limits.pullback.fst g_R s) M_R M_s →
          HasFiberTricanonicalProperties (CategoryTheory.Limits.pullback.snd g_R s) M_s) →
        HasLocalFreeTricanonicalBaseChange g_R M_R) :
    HasGLProjBundleAtlas g :=
by
  classical
  
  have h_s1 :
      (∀ {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
        (𝒜 : ℕ → σ) [GradedRing 𝒜]
        {X Y : AlgebraicGeometry.Scheme.{u}} (φ_sch : X ⟶ Y)
        (f_Y : A →+* ↑(Y.presheaf.obj (Opposite.op ⊤)))
        (hf_Y : Ideal.map f_Y (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤),
        let f_X : A →+* ↑(X.presheaf.obj (Opposite.op ⊤)) := φ_sch.appTop.hom.comp f_Y
        Ideal.map f_X (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤ ∧
        ∀ (hf_X : Ideal.map f_X (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤),
          φ_sch ≫ AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f_Y hf_Y =
            AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f_X hf_X) ∧
      (∀ {A σ B τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
        [CommRing B] [SetLike τ B] [AddSubgroupClass τ B]
        (𝒜 : ℕ → σ) (ℬ : ℕ → τ) [GradedRing 𝒜] [GradedRing ℬ]
        (Φ : 𝒜 →+*ᵍ ℬ)
        (hΦ : HomogeneousIdeal.irrelevant ℬ ≤
          HomogeneousIdeal.map Φ (HomogeneousIdeal.irrelevant 𝒜))
        {X : AlgebraicGeometry.Scheme.{u}}
        (f_X : B →+* ↑(X.presheaf.obj (Opposite.op ⊤)))
        (hf_X : Ideal.map f_X (HomogeneousIdeal.irrelevant ℬ).toIdeal = ⊤),
        let f'_X : A →+* ↑(X.presheaf.obj (Opposite.op ⊤)) := f_X.comp Φ.toRingHom
        Ideal.map f'_X (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤ ∧
        ∀ (hf'_X : Ideal.map f'_X (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤),
          AlgebraicGeometry.Proj.fromOfGlobalSections ℬ f_X hf_X ≫
              AlgebraicGeometry.Proj.map Φ hΦ =
            AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f'_X hf'_X) := by
    have helper_basicOpenIsoSpecAway_hom_ι : ∀ (R : CommRingCat.{u}) (r : ↑R),
        (basicOpenIsoSpecAway r).hom ≫
          Spec.map (CommRingCat.ofHom (algebraMap ↑R (Localization.Away r))) =
        Scheme.Opens.ι (show (Spec R).Opens from PrimeSpectrum.basicOpen r) := by
      intro R r
      simp
    have helper_cancel_spec_away : ∀ {Z : Scheme.{u}} (R : CommRingCat.{u}) (r : ↑R)
        (m₁ m₂ : Z ⟶ Spec (CommRingCat.of (Localization.Away r))),
        m₁ ≫ Spec.map (CommRingCat.ofHom (algebraMap ↑R (Localization.Away r))) =
          m₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap ↑R (Localization.Away r))) →
        m₁ = m₂ := by
      intro Z R r m₁ m₂ h
      let S₀ : CommRingCat.{u} := CommRingCat.of (Localization.Away r)
      let φ : R ⟶ S₀ := CommRingCat.ofHom (algebraMap ↑R (Localization.Away r))
      change m₁ ≫ Spec.map φ = m₂ ≫ Spec.map φ at h
      have hΓ_nat : (Scheme.ΓSpecIso R).inv ≫ (Spec.map φ).appTop = φ ≫ (Scheme.ΓSpecIso S₀).inv := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [Spec.map_comp, Spec.map_comp, ← Scheme.isoSpec_Spec_inv R, ← Scheme.isoSpec_Spec_inv S₀]
        have hnat := Scheme.toSpecΓ_naturality (Spec.map φ)
        change Spec.map φ ≫ (Spec R).isoSpec.hom = (Spec S₀).isoSpec.hom ≫ Spec.map (Spec.map φ).appTop at hnat
        rw [← cancel_epi (Spec S₀).isoSpec.hom, ← Category.assoc, ← hnat,
          Category.assoc, (Spec R).isoSpec.hom_inv_id, Category.comp_id,
          ← Category.assoc, (Spec S₀).isoSpec.hom_inv_id, Category.id_comp]
      rw [← cancel_mono (Spec S₀).toSpecΓ, Scheme.toSpecΓ_naturality, Scheme.toSpecΓ_naturality]
      congr 1
      congr 1
      rw [← cancel_epi (Scheme.ΓSpecIso S₀).inv]
      apply CommRingCat.hom_ext
      apply IsLocalization.ringHom_ext (Submonoid.powers r)
      have h_app' : (φ ≫ (Scheme.ΓSpecIso S₀).inv) ≫ m₁.appTop =
          (φ ≫ (Scheme.ΓSpecIso S₀).inv) ≫ m₂.appTop := by
        rw [← hΓ_nat, Category.assoc, Category.assoc, ← Scheme.Hom.comp_appTop,
          ← Scheme.Hom.comp_appTop, h]
      ext a
      exact congrArg (fun k : R ⟶ Z.presheaf.obj (Opposite.op ⊤) => k.hom a) h_app'
    have hPref : ∃ pref : ∀ (Z : Scheme.{u}) (x : ↑(Z.presheaf.obj (Opposite.op ⊤))),
        (Z.basicOpen x).toScheme ⟶ Spec (CommRingCat.of (Localization.Away x)),
        (∀ (Z : Scheme.{u}) (x : ↑(Z.presheaf.obj (Opposite.op ⊤))),
          pref Z x ≫ Spec.map (CommRingCat.ofHom (algebraMap _ (Localization.Away x))) =
            (Z.basicOpen x).ι ≫ Z.toSpecΓ) ∧
        (∀ {B τ : Type u} [CommRing B] [SetLike τ B] [AddSubgroupClass τ B]
          (ℬ : ℕ → τ) [GradedRing ℬ] {Z : Scheme.{u}}
          (f : B →+* ↑(Z.presheaf.obj (Opposite.op ⊤)))
          {x : ↑(Z.presheaf.obj (Opposite.op ⊤))} {t : B} {d : ℕ}
          (hft : f t = x) (hd : 0 < d) (ht : t ∈ ℬ d),
          let hsub : Submonoid.powers t ≤ Submonoid.comap f (Submonoid.powers x) :=
            Submonoid.powers_le.mpr ⟨1, by simp [hft]⟩
          AlgebraicGeometry.Proj.toBasicOpenOfGlobalSections ℬ f hft hd ht ≫
            (AlgebraicGeometry.Proj.basicOpen ℬ t).ι =
          pref Z x ≫
            Spec.map (CommRingCat.ofHom
              ((IsLocalization.map (Localization.Away x) f hsub).comp
                (algebraMap (HomogeneousLocalization.Away ℬ t) (Localization.Away t)))) ≫
            AlgebraicGeometry.Proj.awayι ℬ t ht hd) := by
      refine ⟨fun Z x =>
        (Z.isoOfEq (Z.toSpecΓ_preimage_basicOpen x)).inv ≫
          (Z.toSpecΓ ∣_ (show (Spec (Z.presheaf.obj (Opposite.op ⊤))).Opens from PrimeSpectrum.basicOpen x)) ≫
            (basicOpenIsoSpecAway x).hom, ?_, ?_⟩
      · intro Z x
        simp only [Category.assoc, helper_basicOpenIsoSpecAway_hom_ι]
        exact (congrArg ((Z.isoOfEq (Z.toSpecΓ_preimage_basicOpen x)).inv ≫ ·)
          (morphismRestrict_ι Z.toSpecΓ
            (show (Spec (Z.presheaf.obj (Opposite.op ⊤))).Opens from PrimeSpectrum.basicOpen x))).trans
          (Scheme.isoOfEq_inv_ι_assoc Z (Z.toSpecΓ_preimage_basicOpen x) Z.toSpecΓ)
      · intro B τ _ _ _ ℬ _ Z f x t d hft hd ht hsub
        dsimp only [AlgebraicGeometry.Proj.toBasicOpenOfGlobalSections]
        simp only [Category.assoc, AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
    obtain ⟨pref, hPref_ι, hToBasic_ι⟩ := hPref
    refine ⟨?_, ?_⟩
    · intro A σ _ _ _ 𝒜 _ X Y φ_sch f_Y hf_Y f_X
      have hf_X_auto : Ideal.map f_X (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤ := by
        dsimp only [f_X]
        rw [← Ideal.map_map, hf_Y, Ideal.map_top]
      refine ⟨hf_X_auto, fun hf_X => ?_⟩
      let F_Y := AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f_Y hf_Y
      let F_X := AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f_X hf_X
      apply Scheme.hom_ext_of_forall
      intro x₀
      obtain ⟨d, hd, t, ht, ht_not⟩ : ∃ d > 0, ∃ t ∈ 𝒜 d,
          t ∉ (F_X.base x₀).asHomogeneousIdeal := by
        by_contra hAll
        apply (F_X.base x₀).not_irrelevant_le
        change (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ (F_X.base x₀).asHomogeneousIdeal.toIdeal
        rw [HomogeneousIdeal.toIdeal_irrelevant_le]
        intro d hd t ht
        by_contra hnot
        exact hAll ⟨d, hd, t, ht, hnot⟩
      let W_X : X.Opens := X.basicOpen (f_X t)
      let W_Y : Y.Opens := Y.basicOpen (f_Y t)
      have hp_mem : F_X.base x₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 t := ht_not
      have hpre_X : F_X ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 t = W_X :=
        AlgebraicGeometry.Proj.fromOfGlobalSections_preimage_basicOpen 𝒜 f_X hf_X hd ht
      have hpre_Y : F_Y ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 t = W_Y :=
        AlgebraicGeometry.Proj.fromOfGlobalSections_preimage_basicOpen 𝒜 f_Y hf_Y hd ht
      have hpre_φ : φ_sch ⁻¹ᵁ W_Y = W_X :=
        Scheme.Hom.preimage_basicOpen φ_sch (f_Y t)
      have hx₀ : x₀ ∈ W_X := hpre_X ▸ hp_mem
      refine ⟨W_X, hx₀, ?_⟩
      change W_X.ι ≫ (φ_sch ≫ F_Y) = W_X.ι ≫ F_X
      rw [← Category.assoc, ← Scheme.Hom.resLE_comp_ι φ_sch (le_of_eq hpre_φ.symm),
        Category.assoc, ← Scheme.Hom.resLE_comp_ι F_Y (le_of_eq hpre_Y.symm),
        ← Scheme.Hom.resLE_comp_ι F_X (le_of_eq hpre_X.symm)]
      dsimp only [F_Y, F_X, W_X, W_Y]
      rw [AlgebraicGeometry.Proj.fromOfGlobalSections_resLE 𝒜 f_Y hf_Y hd ht,
        AlgebraicGeometry.Proj.fromOfGlobalSections_resLE 𝒜 f_X hf_X hd ht,
        hToBasic_ι 𝒜 f_Y rfl hd ht, hToBasic_ι 𝒜 f_X rfl hd ht]
      let y : ↑(Y.presheaf.obj (Opposite.op ⊤)) := f_Y t
      let x : ↑(X.presheaf.obj (Opposite.op ⊤)) := f_X t
      have hsub_φ : Submonoid.powers y ≤ Submonoid.comap φ_sch.appTop.hom (Submonoid.powers x) :=
        Submonoid.powers_le.mpr ⟨1, pow_one x⟩
      have hm_eq : φ_sch.resLE (Y.basicOpen y) (X.basicOpen x) (le_of_eq hpre_φ.symm) ≫ pref Y y =
          pref X x ≫
            Spec.map (CommRingCat.ofHom (IsLocalization.map (Localization.Away x) φ_sch.appTop.hom hsub_φ)) := by
        apply helper_cancel_spec_away (Y.presheaf.obj (Opposite.op ⊤)) y
        rw [Category.assoc, hPref_ι Y y, ← Category.assoc, Scheme.Hom.resLE_comp_ι,
          Category.assoc, Scheme.toSpecΓ_naturality]
        rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
          IsLocalization.map_comp, CommRingCat.ofHom_comp, Spec.map_comp]
        have hhom : CommRingCat.ofHom φ_sch.appTop.hom = φ_sch.appTop := rfl
        rw [hhom, ← Category.assoc (pref X x), hPref_ι X x, Category.assoc]
      rw [← Category.assoc (φ_sch.resLE _ _ _), hm_eq, Category.assoc,
        ← Category.assoc (Spec.map _) (Spec.map _), ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      congr 1
      congr 1
      ext z
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 ht z
      simp only [RingHom.comp_apply]
