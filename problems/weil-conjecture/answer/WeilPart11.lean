  let j₀ : C ⟶ AlgebraicGeometry.Proj 𝒜 := C.topIso.inv ≫ j
  
  have hMem_basicOpen_deg1 : ∀ (a : Fin M.m)
      (p : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a))))
