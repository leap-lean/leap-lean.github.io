                  φ_Ω_Va a_y v_ix * (e'_Va k a_y - φ_Ω_Va a_y v_ky)) := by
            dsimp only [δ]
            rw [map_sub, map_mul, map_mul]
            ring
          rw [hId]
          exact p_y.asIdeal.sub_mem hMem
            (p_y.asIdeal.sub_mem (p_y.asIdeal.mul_mem_left _ h_iy)
              (p_y.asIdeal.mul_mem_left _ h_ky))
        have hUnit : IsUnit (φ_Ω_Va a_y δ) := (IsUnit.mk0 δ hδ_ne).map (φ_Ω_Va a_y)
        exact p_y.isPrime.ne_top (p_y.asIdeal.eq_top_of_isUnit_mem hδ_mem hUnit)
      rw [hj_xy] at hx_not_in
