      haveI := hSub_sw q (p + 1)
      exact fin_of_subsingleton _ inferInstance
    have hFinTotSw : HasFinCohom (Tot E_sw) (totDiff E_sw d_h_sw d_v_sw) :=
      (hVertCollapse K_h E_sw d_h_sw d_v_sw
        (fun a b x => hd_v2 b a x)
        (fun a b x => hd_h2 b a x)
        (fun a b x => (hd_hv b a x).symm)
        (fun a b h => hBound_h b a h)
        dVq_sw dH0 hdVq_sw hdH0 hFin_dVq_sw).mp ⟨hFinH0_0, hFinH0_succ⟩
    have hFinTotE : HasFinCohom (Tot E) (totDiff E d_h d_v) :=
      (totSwap_fin_iff E d_h d_v).mpr hFinTotSw
    exact (hVertCollapse K_v E d_h d_v hd_h2 hd_v2 hd_hv hBound_v
      dVq dV0 hdVq hdV0 hFin_dVq).mpr hFinTotE

