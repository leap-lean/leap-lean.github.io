            _ = u₁ ≫ g₁ := hu_eq
            _ = (e₀₁.hom ≫ CategoryTheory.Limits.pullback.snd U₀.ι U₁.ι) ≫ g₁ := by rw [he₀₁_snd]
            _ = e₀₁.hom ≫ CategoryTheory.Limits.pullback.snd U₀.ι U₁.ι ≫ g₁ :=
                Category.assoc _ _ _
      · rw [Fin.forall_fin_two]
        refine ⟨?_, ?_⟩
        · let e₁₀ := CategoryTheory.IsPullback.isoIsPullback U₁.toScheme U₀.toScheme hPB₀₁.flip
            (CategoryTheory.IsPullback.of_hasPullback U₁.ι U₀.ι)
          have he₁₀_fst : e₁₀.hom ≫ CategoryTheory.Limits.pullback.fst U₁.ι U₀.ι = u₁ :=
            CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ _ _
          have he₁₀_snd : e₁₀.hom ≫ CategoryTheory.Limits.pullback.snd U₁.ι U₀.ι = u₀ :=
            CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ _ _
          change CategoryTheory.Limits.pullback.fst U₁.ι U₀.ι ≫ g₁ =
            CategoryTheory.Limits.pullback.snd U₁.ι U₀.ι ≫ g₀
          rw [← cancel_epi e₁₀.hom]
          calc e₁₀.hom ≫ CategoryTheory.Limits.pullback.fst U₁.ι U₀.ι ≫ g₁
              = (e₁₀.hom ≫ CategoryTheory.Limits.pullback.fst U₁.ι U₀.ι) ≫ g₁ :=
                (Category.assoc _ _ _).symm
            _ = u₁ ≫ g₁ := by rw [he₁₀_fst]
            _ = u₀ ≫ g₀ := hu_eq.symm
            _ = (e₁₀.hom ≫ CategoryTheory.Limits.pullback.snd U₁.ι U₀.ι) ≫ g₀ := by rw [he₁₀_snd]
            _ = e₁₀.hom ≫ CategoryTheory.Limits.pullback.snd U₁.ι U₀.ι ≫ g₀ :=
                Category.assoc _ _ _
        · have hEqProj :
              CategoryTheory.Limits.pullback.fst U₁.ι U₁.ι =
                CategoryTheory.Limits.pullback.snd U₁.ι U₁.ι := by
            rw [← cancel_mono U₁.ι]
            exact CategoryTheory.Limits.pullback.condition
          change CategoryTheory.Limits.pullback.fst U₁.ι U₁.ι ≫ g₁ =
            CategoryTheory.Limits.pullback.snd U₁.ι U₁.ι ≫ g₁
          rw [hEqProj]
    let Φ : Z₁ ⟶ Z₂ := 𝒰.glueMorphisms g_vec hGlue
    have hΦ₀ : U₀.ι ≫ Φ = g₀ := 𝒰.ι_glueMorphisms g_vec hGlue (0 : Fin 2)
    have hΦ₁ : U₁.ι ≫ Φ = g₁ := 𝒰.ι_glueMorphisms g_vec hGlue (1 : Fin 2)
    have hΦ_base : Φ ≫ p₂ = p₁ := by
      apply 𝒰.hom_ext
      intro (i : Fin 2)
      revert i
      rw [Fin.forall_fin_two]
      refine ⟨?_, ?_⟩
      · change U₀.ι ≫ (Φ ≫ p₂) = U₀.ι ≫ p₁
        have hBaseCat₀ :
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                p₂.appLE ⊤ W₀ le_top) ≫ fθ₀ =
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                p₁.appLE ⊤ U₀ le_top :=
          CommRingCat.Hom.ext hBase₀
        calc U₀.ι ≫ (Φ ≫ p₂)
            = (U₀.ι ≫ Φ) ≫ p₂ := (Category.assoc _ _ _).symm
          _ = hU₀.isoSpec.hom ≫ AlgebraicGeometry.Spec.map fθ₀ ≫
                (hW₀.fromSpec ≫ p₂) := by
              rw [hΦ₀]
              simp only [g₀, Category.assoc]
          _ = hU₀.isoSpec.hom ≫
                (AlgebraicGeometry.Spec.map fθ₀ ≫
                  AlgebraicGeometry.Spec.map
                    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                      p₂.appLE ⊤ W₀ le_top)) := by
              rw [hFromSpecBase p₂ hW₀]
          _ = hU₀.isoSpec.hom ≫
                AlgebraicGeometry.Spec.map
                  (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                      p₂.appLE ⊤ W₀ le_top) ≫ fθ₀) := by
              rw [← AlgebraicGeometry.Spec.map_comp]
          _ = hU₀.isoSpec.hom ≫ (hU₀.fromSpec ≫ p₁) := by
              rw [hBaseCat₀, ← hFromSpecBase p₁ hU₀]
          _ = U₀.ι ≫ p₁ := by
              rw [← hU₀.isoSpec_inv_ι, Category.assoc, Iso.hom_inv_id_assoc]
      · change U₁.ι ≫ (Φ ≫ p₂) = U₁.ι ≫ p₁
        have hBaseCat₁ :
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                p₂.appLE ⊤ W₁ le_top) ≫ fθ₁ =
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                p₁.appLE ⊤ U₁ le_top :=
          CommRingCat.Hom.ext hBase₁
        calc U₁.ι ≫ (Φ ≫ p₂)
            = (U₁.ι ≫ Φ) ≫ p₂ := (Category.assoc _ _ _).symm
          _ = hU₁.isoSpec.hom ≫ AlgebraicGeometry.Spec.map fθ₁ ≫
                (hW₁.fromSpec ≫ p₂) := by
              rw [hΦ₁]
              simp only [g₁, Category.assoc]
          _ = hU₁.isoSpec.hom ≫
                (AlgebraicGeometry.Spec.map fθ₁ ≫
                  AlgebraicGeometry.Spec.map
                    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                      p₂.appLE ⊤ W₁ le_top)) := by
              rw [hFromSpecBase p₂ hW₁]
          _ = hU₁.isoSpec.hom ≫
                AlgebraicGeometry.Spec.map
                  (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                      p₂.appLE ⊤ W₁ le_top) ≫ fθ₁) := by
              rw [← AlgebraicGeometry.Spec.map_comp]
          _ = hU₁.isoSpec.hom ≫ (hU₁.fromSpec ≫ p₁) := by
              rw [hBaseCat₁, ← hFromSpecBase p₁ hU₁]
          _ = U₁.ι ≫ p₁ := by
