    have hWa_j₀ : W_a.ι ≫ j₀ = AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f_a hf_a := by
      dsimp only [j₀]
      have hι : W_a.ι ≫ C.topIso.inv = C.homOfLE (inf_le_left : W_a ≤ ⊤) := by
        rw [← cancel_mono C.topIso.hom, CategoryTheory.Category.assoc, Iso.inv_hom_id,
