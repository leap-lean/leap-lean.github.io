            ((TopologicalSpace.Opens.map fst'.base).obj (M.V (eIdx a))) (hw_le (eIdx a)) ≫
            C'.presheaf.map (CategoryTheory.homOfLE
              (le_trans (inf_le_right : ⊤ ⊓ M'.V a ≤ M'.V a) (le_of_eq (hV' a)))).op := by
        rw [w'.naturality_assoc]
        simp only [AlgebraicGeometry.Scheme.Hom.appLE, CategoryTheory.Category.assoc,
          ← C'.presheaf.map_comp]
        rfl
      exact ConcreteCategory.congr_hom h_nat (Θ₀_h (v i) (eIdx a))
    refine ⟨?_, ?_⟩
    · intro i
      rw [he'_eq i]
      exact (hSec_ρ (Θ₀_R' (v' i))).mpr ((hKer_R' (v' i)).mp (hv'_ker i))
    · intro s' hs'
      obtain ⟨f_s, hf_s⟩ := hBij_ρ.surjective s'
      obtain ⟨x_s, hx_s⟩ := hBij_R'.surjective f_s
      have hs'_eq : ρ (Θ₀_R' x_s) = s' := by rw [hx_s, hf_s]
      have hx_ker : LinearMap.baseChange R' (d 0) x_s = 0 := by
        apply (hKer_R' x_s).mpr
        apply (hSec_ρ (Θ₀_R' x_s)).mp
        rwa [hs'_eq]
      obtain ⟨c, hc_eq, hc_uniq⟩ := hv'_basis x_s hx_ker
      have hCoeffIff : ∀ c' : Fin (r₀ + 1) → R',
          (x_s = ∑ i : Fin (r₀ + 1), c' i • v' i) ↔
          (∀ a : Fin M'.m,
            s' a = ∑ i : Fin (r₀ + 1),
              (C'.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M'.V a ≤ ⊤)).op).hom
                (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫
                  snd'.appTop).hom (c' i)) * e' i a) := by
        intro c'
        rw [← hBij_R'.injective.eq_iff, funext_iff]
        simp only [hΘ₀Sum R' Θ₀_R' hAdd_R' hZero_R' hSmul_R']
        rw [hSum_ρ r₀ c' (fun i => Θ₀_R' (v' i)) (Θ₀_R' x_s)]
        simp only [hs'_eq, ← he'_eq]
      refine ⟨c, (hCoeffIff c).mp hc_eq, fun c' hc' => hc_uniq c' ((hCoeffIff c').mpr hc')⟩
  · intro S _ _ u_S C_S
    let fst_S := CategoryTheory.Limits.pullback.fst g u_S
    let snd_S := CategoryTheory.Limits.pullback.snd g u_S
    obtain ⟨⟨M_S, hPbMS, hAffMS, hCohMS⟩, Θ₀_S, hBij_S, hAdd_S, hZero_S, hSmul_S, _, hKer_S⟩ :=
      hS2 S
    refine ⟨M_S, hPbMS, hAffMS, hCohMS, ?_⟩
    intro r₀ e he_sec he_exp
    obtain ⟨eIdx_S, hV_S, hU_S⟩ := hPbMS
    obtain ⟨ρ_S, _, hBij_ρ, hSec_ρ, hSum_ρ⟩ := hS3 S C_S fst_S snd_S M_S eIdx_S hV_S hU_S
    have hCompBij : Function.Bijective (ρ_S ∘ Θ₀_S) := hBij_ρ.comp hBij_S
    let w_vec : Fin (r₀ + 1) → TensorProduct R S (WeilTricanonicalCechCochain M 0) :=
      fun i => Classical.choose (hCompBij.surjective (e i))
    have hw_eq : ∀ i : Fin (r₀ + 1), ρ_S (Θ₀_S (w_vec i)) = e i :=
      fun i => Classical.choose_spec (hCompBij.surjective (e i))
    have hw_ker : ∀ i : Fin (r₀ + 1), w_vec i ∈ LinearMap.ker (LinearMap.baseChange S (d 0)) := by
      intro i
      rw [LinearMap.mem_ker]
      apply (hKer_S (w_vec i)).mpr
      apply (hSec_ρ (Θ₀_S (w_vec i))).mp
      rw [hw_eq i]
      exact he_sec i
    let w_sub : Fin (r₀ + 1) → ↥(LinearMap.ker (LinearMap.baseChange S (d 0))) :=
      fun i => ⟨w_vec i, hw_ker i⟩
    let L : (Fin (r₀ + 1) → S) →ₗ[S] ↥(LinearMap.ker (LinearMap.baseChange S (d 0))) :=
      { toFun := fun c => ∑ i : Fin (r₀ + 1), c i • w_sub i
        map_add' := fun c₁ c₂ => by simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
        map_smul' := fun s c => by simp only [Pi.smul_apply, smul_eq_mul, mul_smul,
          RingHom.id_apply, Finset.smul_sum] }
    have hL_iff : ∀ (z : ↥(LinearMap.ker (LinearMap.baseChange S (d 0)))) (c : Fin (r₀ + 1) → S),
        L c = z ↔
        ∀ a : Fin M_S.m,
          ρ_S (Θ₀_S z.1) a = ∑ i : Fin (r₀ + 1),
            (C_S.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M_S.V a ≤ ⊤)).op).hom
              (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of S)).inv ≫
                snd_S.appTop).hom (c i)) * e i a := by
      intro z c
      rw [Subtype.ext_iff]
      change (∑ i : Fin (r₀ + 1), c i • w_sub i).1 = z.1 ↔ _
      rw [AddSubmonoidClass.coe_finsetSum]
      have h_sum_coe : (∑ i : Fin (r₀ + 1), (c i • w_sub i).1) =
          ∑ i : Fin (r₀ + 1), c i • w_vec i := rfl
      rw [h_sum_coe, eq_comm, ← hBij_S.injective.eq_iff, funext_iff]
      simp only [hΘ₀Sum S Θ₀_S hAdd_S hZero_S hSmul_S]
      rw [hSum_ρ r₀ c (fun i => Θ₀_S (w_vec i)) (Θ₀_S z.1)]
      simp only [hw_eq]
    have hL_bij : Function.Bijective L := by
      refine ⟨?_, ?_⟩
      · intro c₁ c₂ hc
        have hz : IsWeilTricanonicalSection M_S ⊤ (ρ_S (Θ₀_S (L c₁).1)) :=
          (hSec_ρ (Θ₀_S (L c₁).1)).mpr ((hKer_S (L c₁).1).mp (L c₁).2)
        obtain ⟨c₀, _, hc₀_uniq⟩ := he_exp (ρ_S (Θ₀_S (L c₁).1)) hz
        have h1 : c₁ = c₀ := hc₀_uniq c₁ ((hL_iff (L c₁) c₁).mp rfl)
        have h2 : c₂ = c₀ := hc₀_uniq c₂ ((hL_iff (L c₁) c₂).mp hc.symm)
        exact h1.trans h2.symm
      · intro z
        have hz : IsWeilTricanonicalSection M_S ⊤ (ρ_S (Θ₀_S z.1)) :=
          (hSec_ρ (Θ₀_S z.1)).mpr ((hKer_S z.1).mp z.2)
        obtain ⟨c, hc, _⟩ := he_exp (ρ_S (Θ₀_S z.1)) hz
        exact ⟨c, (hL_iff z c).mpr hc⟩
    exact ⟨LinearEquiv.ofBijective L hL_bij⟩

theorem weil_isAffine_twisted_cech_higher_cohomology_vanishing (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine X]
    (L : WeilLineBundle X)
    (hAffL : ∀ a : Fin L.m, AlgebraicGeometry.IsAffineOpen (L.V a))
    (p : ℕ) (z : WeilTricanonicalCechCochain L (p + 1))
    (hz : weilTricanonicalCechDiff L (p + 1) z = 0) :
    ∃ b : WeilTricanonicalCechCochain L p, weilTricanonicalCechDiff L p b = z :=
by
  classical
  have hResComp : ∀ {U₁ U₂ U₃ : X.Opens} (h₁₂ : U₁ ≤ U₂) (h₂₃ : U₂ ≤ U₃)
      (x : ↑(X.presheaf.obj (Opposite.op U₃))),
      (X.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom
        ((X.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom x) =
      (X.presheaf.map (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op).hom x := by
    intro U₁ U₂ U₃ h₁₂ h₂₃ x
    change (X.presheaf.map (CategoryTheory.homOfLE h₂₃).op ≫
      X.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom x = _
    rw [← X.presheaf.map_comp]
    rfl
  have hMapNegOnePow : ∀ {U₁ U₂ : X.Opens}
      (f_hom : X.presheaf.obj (Opposite.op U₁) ⟶ X.presheaf.obj (Opposite.op U₂))
      (n : ℕ), f_hom.hom ((-1) ^ n) = (-1) ^ n := by
    intro U₁ U₂ f_hom n
    rw [map_pow, map_neg, map_one]
  have hDiffSum : ∀ (C_fam : Fin L.m → WeilTricanonicalCechCochain L p)
      (α : WeilStrictMonoTuple L.m (p + 1)),
      weilTricanonicalCechDiff L p (fun ν => ∑ lam : Fin L.m, C_fam lam ν) α =
        ∑ lam : Fin L.m, weilTricanonicalCechDiff L p (C_fam lam) α := by
    intro C_fam α
    simp only [weilTricanonicalCechDiff, map_sum, Finset.mul_sum, Finset.sum_add_distrib]
    congr 1
    rw [Finset.sum_comm]
  have hDiffTopMul : ∀ (g : ↑(X.presheaf.obj (Opposite.op (⊤ : X.Opens))))
      (c : WeilTricanonicalCechCochain L p)
      (α : WeilStrictMonoTuple L.m (p + 1)),
      weilTricanonicalCechDiff L p
        (fun ν => (X.presheaf.map (CategoryTheory.homOfLE (le_top : weilChartInter L ν ≤ ⊤)).op).hom g * c ν) α =
      (X.presheaf.map (CategoryTheory.homOfLE (le_top : weilChartInter L α ≤ ⊤)).op).hom g *
        weilTricanonicalCechDiff L p c α := by
    intro g c α
    simp only [weilTricanonicalCechDiff, map_mul, hResComp, mul_add, Finset.mul_sum]
    congr 1
    · ring
    · refine Finset.sum_congr rfl fun k _ => ?_
      ring
  
  let A := ↑(X.presheaf.obj (Opposite.op (⊤ : X.Opens)))
  have h_s1 : ∃ f : Fin L.m → A,
      (∀ a : Fin L.m, X.basicOpen (f a) ≤ L.V a) ∧
      (∀ K : ℕ, ∃ h : Fin L.m → A, ∑ a : Fin L.m, h a * (f a) ^ K = 1) := by
    have hTop : AlgebraicGeometry.IsAffineOpen (⊤ : X.Opens) :=
      AlgebraicGeometry.isAffineOpen_top X
    let I : Fin L.m → Ideal A := fun a =>
      { carrier := { x : A | X.basicOpen x ≤ L.V a }
        zero_mem' := by
          change X.basicOpen (0 : A) ≤ L.V a
          rw [X.basicOpen_zero]
          exact bot_le
        add_mem' := fun {x y} hx hy => (X.basicOpen_add_le x y).trans (sup_le hx hy)
        smul_mem' := fun c {x} hx => by
          change X.basicOpen (c * x) ≤ L.V a
          rw [X.basicOpen_mul]
          exact inf_le_right.trans hx }
    let S : Set A := ⋃ a : Fin L.m, (I a : Set A)
    have hTopLe : (⊤ : X.Opens) ≤ ⨆ x : S, X.basicOpen (x : A) := by
      intro pt _
      have hpt_univ : (pt : X) ∈ (⋃ a : Fin L.m, (L.V a : Set X)) := by
        rw [L.hCov]; trivial
      obtain ⟨a, hpta⟩ := Set.mem_iUnion.mp hpt_univ
      obtain ⟨g, hg_le, hptg⟩ :=
        hTop.exists_basicOpen_le (⟨pt, hpta⟩ : ↥(L.V a)) (by trivial : pt ∈ (⊤ : X.Opens))
      have hgS : g ∈ S := Set.mem_iUnion.mpr ⟨a, hg_le⟩
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨g, hgS⟩, hptg⟩
    have hSpanS : Ideal.span S = (⊤ : Ideal A) :=
      (hTop.self_le_iSup_basicOpen_iff (s := S)).mp hTopLe
    have hSpanLe : Ideal.span S ≤ ⨆ a ∈ (Finset.univ : Finset (Fin L.m)), I a := by
      refine Ideal.span_le.mpr fun x hx => ?_
      obtain ⟨a, hxa⟩ := Set.mem_iUnion.mp hx
      exact SetLike.le_def.mp (le_iSup₂_of_le a (Finset.mem_univ a) (le_refl (I a))) hxa
    have hOneMem : (1 : A) ∈ ⨆ a ∈ (Finset.univ : Finset (Fin L.m)), I a :=
      hSpanLe (by rw [hSpanS]; trivial)
    obtain ⟨μ, hμ⟩ := (Submodule.mem_iSup_finset_iff_exists_sum I (1 : A)).mp hOneMem
    let f : Fin L.m → A := fun a => (μ a).1
    refine ⟨f, fun a => (μ a).2, fun K => ?_⟩
    have hf_span : Ideal.span (Set.range f) = (⊤ : Ideal A) := by
      rw [Ideal.eq_top_iff_one]
      exact (Submodule.mem_span_range_iff_exists_fun A).mpr
        ⟨fun _ => 1, by simp only [one_smul, f]; exact hμ⟩
    have hPowTop : Ideal.span (Set.range (fun a : Fin L.m => (f a) ^ K)) = (⊤ : Ideal A) := by
      have h1 := Ideal.span_pow_eq_top (Set.range f) hf_span K
      rwa [← Set.range_comp] at h1
    have hOnePow : (1 : A) ∈ Ideal.span (Set.range (fun a : Fin L.m => (f a) ^ K)) := by
      rw [hPowTop]; trivial
    obtain ⟨h, hh⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hOnePow
    exact ⟨h, by simpa only [smul_eq_mul] using hh⟩
  
  have hSuccAbove : ∀ {n : ℕ} (i₀ j₀ : Fin (n + 1)) (k : Fin n),
      i₀ ≤ j₀ → j₀.succ.succAbove (i₀.succAbove k) = i₀.castSucc.succAbove (j₀.succAbove k) := by
    intro n i₀ j₀ k hij
    rcases lt_or_ge k.castSucc i₀ with hki | hik
    · have hkj : k.castSucc < j₀ := lt_of_lt_of_le hki hij
      rw [Fin.succAbove_of_castSucc_lt _ _ hki, Fin.succAbove_of_castSucc_lt _ _ hkj,
        Fin.succAbove_of_castSucc_lt _ _ (Fin.castSucc_lt_castSucc_iff.mpr hki),
        Fin.succAbove_of_castSucc_lt _ _
          (lt_trans (Fin.castSucc_lt_castSucc_iff.mpr hkj) j₀.castSucc_lt_succ)]
    · rcases lt_or_ge k.castSucc j₀ with hkj | hjk
      · rw [Fin.succAbove_of_le_castSucc _ _ hik, Fin.succAbove_of_castSucc_lt _ _ hkj,
          Fin.succAbove_of_le_castSucc _ _ (Fin.castSucc_le_castSucc_iff.mpr hik),
          Fin.succAbove_of_castSucc_lt _ _ (Fin.succ_lt_succ_iff.mpr hkj)]
        ext; simp
      · rw [Fin.succAbove_of_le_castSucc _ _ hik, Fin.succAbove_of_le_castSucc _ _ hjk,
          Fin.succAbove_of_le_castSucc _ _ (Fin.succ_le_succ_iff.mpr hjk),
          Fin.succAbove_of_le_castSucc _ _
            (le_trans (Fin.castSucc_le_castSucc_iff.mpr hik)
              (le_of_lt (Fin.castSucc_lt_castSucc_iff.mpr k.castSucc_lt_succ)))]
  let w_on : ∀ (W : X.Opens) (a b : Fin L.m), W ≤ L.V a ⊓ L.V b →
      ↑(X.presheaf.obj (Opposite.op W)) :=
    fun W a b h => ((X.presheaf.map (CategoryTheory.homOfLE h).op).hom (L.u a b).val) ^ 3
  have hw_eq : ∀ {W : X.Opens} {a₁ b₁ a₂ b₂ : Fin L.m} (ha : a₁ = a₂) (hb : b₁ = b₂)
      (h₁ : W ≤ L.V a₁ ⊓ L.V b₁) (h₂ : W ≤ L.V a₂ ⊓ L.V b₂),
      w_on W a₁ b₁ h₁ = w_on W a₂ b₂ h₂ := by
    intro W a₁ b₁ a₂ b₂ ha hb h₁ h₂
    subst ha; subst hb; rfl
  have hw_cocycle : ∀ {W : X.Opens} {a b c : Fin L.m}
      (ha : W ≤ L.V a) (hb : W ≤ L.V b) (hc : W ≤ L.V c)
      (hab : W ≤ L.V a ⊓ L.V b) (hbc : W ≤ L.V b ⊓ L.V c) (hac : W ≤ L.V a ⊓ L.V c),
      w_on W a b hab * w_on W b c hbc = w_on W a c hac := by
    intro W a b c ha hb hc hab hbc hac
    let h_abc : W ≤ L.V a ⊓ L.V b ⊓ L.V c := le_inf (le_inf ha hb) hc
    have h_u := congrArg ((X.presheaf.map (CategoryTheory.homOfLE h_abc).op).hom)
      (L.u_cocycle a b c)
    rw [map_mul, hResComp, hResComp, hResComp] at h_u
    dsimp only [w_on]
    rw [← mul_pow]
    exact congrArg (· ^ 3) h_u
  have hw_inv : ∀ {W : X.Opens} {a b : Fin L.m}
      (ha : W ≤ L.V a) (hb : W ≤ L.V b)
      (hab : W ≤ L.V a ⊓ L.V b) (hba : W ≤ L.V b ⊓ L.V a),
      w_on W a b hab * w_on W b a hba = 1 := by
    intro W a b ha hb hab hba
    rw [hw_cocycle ha hb ha hab hba (le_inf ha ha)]
    dsimp only [w_on]
    rw [L.u_refl a, map_one, one_pow]
  have hZEq : ∀ {W : X.Opens} {μ₁ μ₂ : WeilStrictMonoTuple L.m (p + 1)} (hEq : μ₁ = μ₂)
      (h₁ : W ≤ weilChartInter L μ₁) (h₂ : W ≤ weilChartInter L μ₂),
      (X.presheaf.map (CategoryTheory.homOfLE h₁).op).hom (z μ₁) =
      (X.presheaf.map (CategoryTheory.homOfLE h₂).op).hom (z μ₂) := by
    intro W μ₁ μ₂ hEq h₁ h₂
    subst hEq; rfl
  
  have h_s2 : ∀ lam : Fin L.m,
      ∃ s : ∀ ν : WeilStrictMonoTuple L.m p,
          ↑(X.presheaf.obj (Opposite.op (L.V lam ⊓ weilChartInter L ν))),
        ∀ α : WeilStrictMonoTuple L.m (p + 1),
          let face : Fin (p + 2) → WeilStrictMonoTuple L.m p :=
            fun j => ⟨fun k => α.1 (j.succAbove k), α.2.comp (Fin.strictMono_succAbove j)⟩
          let h01 : L.V lam ⊓ weilChartInter L α ≤ L.V (α.1 0) ⊓ L.V (α.1 1) :=
            inf_le_right.trans (le_inf (Finset.inf'_le _ (Finset.mem_univ (0 : Fin (p + 2))))
              (Finset.inf'_le _ (Finset.mem_univ (1 : Fin (p + 2)))))
          let hFace : ∀ j : Fin (p + 2),
              L.V lam ⊓ weilChartInter L α ≤ L.V lam ⊓ weilChartInter L (face j) :=
            fun j => inf_le_inf_left (L.V lam)
              (Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k))))
          ((X.presheaf.map (CategoryTheory.homOfLE h01).op).hom (L.u (α.1 0) (α.1 1)).val) ^ 3 *
              (X.presheaf.map (CategoryTheory.homOfLE (hFace 0)).op).hom (s (face 0)) +
            ∑ k : Fin (p + 1), (-1) ^ ((k : ℕ) + 1) *
              (X.presheaf.map (CategoryTheory.homOfLE (hFace k.succ)).op).hom (s (face k.succ)) =
          (X.presheaf.map (CategoryTheory.homOfLE
            (inf_le_right : L.V lam ⊓ weilChartInter L α ≤ weilChartInter L α)).op).hom (z α) := by
    intro lam
    let IsIns : ∀ (r : ℕ), WeilStrictMonoTuple L.m r → Fin (r + 2) →
        WeilStrictMonoTuple L.m (r + 1) → Prop :=
      fun r ν i μ => μ.1 i = lam ∧ ∀ k : Fin (r + 1), μ.1 (i.succAbove k) = ν.1 k
    have notMem_of_isIns : ∀ {r : ℕ} {ν : WeilStrictMonoTuple L.m r}
        {i : Fin (r + 2)} {μ : WeilStrictMonoTuple L.m (r + 1)},
        IsIns r ν i μ → lam ∉ Set.range ν.1 := by
      rintro r ν i μ ⟨hμi, hμk⟩ ⟨k, hk⟩
      have hEq : μ.1 (i.succAbove k) = μ.1 i := (hμk k).trans (hk.trans hμi.symm)
      exact Fin.succAbove_ne i k (μ.2.injective hEq)
    have range_of_isIns : ∀ {r : ℕ} {ν : WeilStrictMonoTuple L.m r}
        {i : Fin (r + 2)} {μ : WeilStrictMonoTuple L.m (r + 1)},
        IsIns r ν i μ → Set.range μ.1 = insert lam (Set.range ν.1) := by
      rintro r ν i μ ⟨hμi, hμk⟩
      ext x
      simp only [Set.mem_range, Set.mem_insert_iff]
      constructor
      · rintro ⟨j, rfl⟩
        by_cases hj : j = i
        · subst hj; left; exact hμi
        · obtain ⟨k, rfl⟩ := Fin.exists_succAbove_eq hj
          right; exact ⟨k, (hμk k).symm⟩
      · rintro (rfl | ⟨k, rfl⟩)
        · exact ⟨i, hμi⟩
        · exact ⟨i.succAbove k, hμk k⟩
    have unique_of_isIns : ∀ {r : ℕ} {ν : WeilStrictMonoTuple L.m r}
        {i₁ i₂ : Fin (r + 2)} {μ₁ μ₂ : WeilStrictMonoTuple L.m (r + 1)},
        IsIns r ν i₁ μ₁ → IsIns r ν i₂ μ₂ → i₁ = i₂ ∧ μ₁ = μ₂ := by
      intro r ν i₁ i₂ μ₁ μ₂ h₁ h₂
      have hR : Set.range μ₁.1 = Set.range μ₂.1 :=
        (range_of_isIns h₁).trans (range_of_isIns h₂).symm
      have hFun : μ₁.1 = μ₂.1 := (StrictMono.range_inj_of_wellFoundedLT μ₁.2 μ₂.2).mp hR
      have hμ : μ₁ = μ₂ := Subtype.ext hFun
      subst hμ
      exact ⟨μ₁.2.injective (h₁.1.trans h₂.1.symm), rfl⟩
    have exists_isIns : ∀ (r : ℕ) (ν : WeilStrictMonoTuple L.m r),
        lam ∉ Set.range ν.1 →
        ∃ (i : Fin (r + 2)) (μ : WeilStrictMonoTuple L.m (r + 1)), IsIns r ν i μ := by
      intro r ν hNot
      let S₀ : Finset (Fin L.m) := Finset.univ.image ν.1
      let T : Finset (Fin L.m) := insert lam S₀
      have hNotS₀ : lam ∉ S₀ := by
        simp only [S₀, Finset.mem_image, Finset.mem_univ, true_and]
        intro hex; exact hNot hex
      have hCardS₀ : S₀.card = r + 1 :=
        (Finset.card_image_of_injective Finset.univ ν.2.injective).trans (Finset.card_fin (r + 1))
      have hCardT : T.card = r + 2 :=
