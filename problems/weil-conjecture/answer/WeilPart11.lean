    refine ⟨s₀_glued, ?_⟩
    rw [← hρ_compat (W_cov x₀) (hW_cov x₀) ⟨⟨η₀, hx_W x₀⟩⟩ (hW_le x₀) (φ_cov x₀) (hφ_cov x₀)
      s₀_glued, hs_glue0, hs_cov x₀]
  let ρ_B : ↑(E_sm.presheaf.obj (Opposite.op U_f)) →+* ↥B := ρ_Uf.codRestrict B hρ_mem_B
  have hρB_bij : Function.Bijective ρ_B := by
    refine ⟨?_, ?_⟩
    · intro s₁ s₂ hs
      exact hρ_inj (congrArg Subtype.val hs)
    · intro b
      obtain ⟨s, hs⟩ := hρ_surj_B b
      exact ⟨s, Subtype.ext hs⟩
  let σ₀ : ↥B ≃+* ↑(E_sm.presheaf.obj (Opposite.op U_f)) := (RingEquiv.ofBijective ρ_B hρB_bij).symm
  have hρ_σ₀ : ∀ b : ↥B, ρ_Uf (σ₀ b) = (b : F) := by
    intro b
    change ((RingEquiv.ofBijective ρ_B hρB_bij) (σ₀ b) : F) = (b : F)
    rw [RingEquiv.apply_symm_apply]
  
  let π_f : U_f.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥B) :=
    U_f.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ₀.toRingHom)
  have hChart_πf : ∀ (W : E_sm.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) (hW_le : W ≤ U_f),
      (hW.isoSpec.inv ≫ E_sm.homOfLE hW_le) ≫ U_f.ι = hW.fromSpec ∧
      (hW.isoSpec.inv ≫ E_sm.homOfLE hW_le) ≫ π_f =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((E_sm.presheaf.map (CategoryTheory.homOfLE hW_le).op).hom.comp σ₀.toRingHom)) := by
    intro W hW hW_le
    refine ⟨?_, ?_⟩
    · rw [Category.assoc, E_sm.homOfLE_ι, hW.isoSpec_inv_ι]
    · dsimp only [π_f]
      rw [Category.assoc,
        ← AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_assoc,
        ← hW.isoSpec_hom, Iso.inv_hom_id_assoc, ← AlgebraicGeometry.Spec.map_comp]
      rfl
  have hBase_ideal : ∀ z : ↥U_f.toScheme,
      let x : E_sm := U_f.ι.base z
      (¬IsClosed ({x} : Set E_sm) → x = η₀ ∧ (π_f.base z).asIdeal = ⊥) ∧
      (IsClosed ({x} : Set E_sm) →
        (0 : WithTop ℤ) ≤ ord x f ∧
        (π_f.base z).asIdeal.IsMaximal ∧
        (π_f.base z).asIdeal ≠ ⊥ ∧
        ∀ b : ↥B, b ∈ (π_f.base z).asIdeal ↔ (1 : WithTop ℤ) ≤ ord x (b : F)) := by
    intro z x
    have hx_Uf : x ∈ U_f := by
      have hx_range : x ∈ Set.range U_f.ι.base := ⟨z, rfl⟩
      rwa [U_f.range_ι] at hx_range
    obtain ⟨W, hW, hxW, hW_le⟩ := hAffNbhd U_f x hx_Uf
    let e_W := hW.isoSpec.inv ≫ E_sm.homOfLE hW_le
    let σ_W := (E_sm.presheaf.map (CategoryTheory.homOfLE hW_le).op).hom.comp σ₀.toRingHom
    obtain ⟨heW_ι, heW_πf⟩ := hChart_πf W hW hW_le
    have hx_from : x ∈ Set.range hW.fromSpec.base := by
      rw [hW.range_fromSpec]
