        obtain ⟨y₁, rfl⟩ := Submodule.Quotient.mk_surjective (B_sub F₁ (n + 1)) u₁
        change Submodule.Quotient.mk (i_ker (n + 1) y₁) = 0 at hu₁
        rw [Submodule.Quotient.mk_eq_zero] at hu₁
        obtain ⟨x₂, hx₂⟩ := hu₁
        have hz₃_ker : d_lin F₃ n (q_c n x₂) = 0 := by
          rw [hq_comm]
          change q_c (n + 1) (d_lin F₂ n x₂) = 0
          have hx₂' : d_lin F₂ n x₂ = i_c (n + 1) y₁.1 := hx₂
          rw [hx₂']
          exact (h_c_ex (n + 1) _).mpr ⟨y₁.1, rfl⟩
        let z₃ : ↥(LinearMap.ker (d_lin F₃ n)) := ⟨q_c n x₂, hz₃_ker⟩
        refine ⟨Submodule.Quotient.mk z₃, ?_⟩
        exact hδ_rel n z₃ x₂ y₁ rfl hx₂.symm
      have hNoethExact : ∀ {A B D : Type u} [AddCommGroup A] [AddCommGroup B] [AddCommGroup D]
          [Module R A] [Module R B] [Module R D]
          (f : A →ₗ[R] B) (h : B →ₗ[R] D),
          LinearMap.ker h ≤ LinearMap.range f →
          Module.Finite R A → Module.Finite R D → Module.Finite R B := by
        intro A B D _ _ _ _ _ _ f h hex hA hD
