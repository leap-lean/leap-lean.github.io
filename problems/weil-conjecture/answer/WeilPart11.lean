      intro h0
      have hs0 : s.1 = 0 := Subtype.ext h0
      exact s.2 (by rw [hs0]; exact q.asIdeal.zero_mem)
    have hUnitR : ∀ t : p_z.asIdeal.primeCompl, IsUnit (φ_W.hom t.1) := by
      intro t
      apply Ne.isUnit
      intro h0
      have ht0 : t.1 = 0 := hφW_inj (h0.trans (map_zero φ_W.hom).symm)
      exact t.2 (by rw [ht0]; exact p_z.asIdeal.zero_mem)
    let ι_B : Localization.AtPrime q.asIdeal →+* F :=
      IsLocalization.lift (S := Localization.AtPrime q.asIdeal) hUnitB
    let ι_R : Localization.AtPrime p_z.asIdeal →+* F :=
      IsLocalization.lift (S := Localization.AtPrime p_z.asIdeal) hUnitR
    have hιB_inj : Function.Injective ι_B :=
      hLiftInj q.asIdeal.primeCompl (Localization.AtPrime q.asIdeal) B.subtype
