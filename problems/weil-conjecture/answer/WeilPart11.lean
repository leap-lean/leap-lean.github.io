          have hqz : q_c 0 z₂.1 = 0 := congrArg Subtype.val hu₂
          obtain ⟨y₁, hy₁⟩ := (h_c_ex 0 z₂.1).mp hqz
          have hy₁_ker : d_lin F₁ 0 y₁ = 0 := by
            apply hi_c_inj 1
            rw [← hi_comm, hy₁, show d_lin F₂ 0 z₂.1 = 0 from z₂.2, map_zero]
