            rw [hLin_zero, (((hRR_data α).2.2.1 P hP).1 0).mpr rfl]
            exact le_top
          add_mem' := by
            intro u v hu hv
            show ((1 - Δ_div α P : ℤ) : WithTop ℤ) ≤ ord α P (linComb (u + v) α)
            rw [hLin_add]
            exact le_trans (le_min hu hv) (((hRR_data α).2.2.1 P hP).2.2.1 _ _)
          smul_mem' := by
            intro d v hv
            show ((1 - Δ_div α P : ℤ) : WithTop ℤ) ≤ ord α P (linComb (d • v) α)
            rw [hLin_smul]
            exact hOrd_smul α P hP _ d _ hv }
    let Z_pole : ∀ α : Fin (c + 1), Set (E_norm α) :=
      fun α => (((TopologicalSpace.Opens.map (ν α).base).obj U_k : (E_norm α).Opens) :
        Set (E_norm α))ᶜ
    let S_α : Fin (c + 1) → Set (Submodule Ω (Fin (r₀ + 1) → Ω)) := fun α =>
      {K | ∃ hα : secFunc (e' k) α ≠ 0,
        K = K_der α ∨ ∃ P : E_norm α, ∃ hPZ : P ∈ Z_pole α,
          K = K_pole α P ((hW_act α hα).2.2.1 P hPZ).1}
    let S_sub : Set (Submodule Ω (Fin (r₀ + 1) → Ω)) := ⋃ α : Fin (c + 1), S_α α
    have hS_fin : S_sub.Finite := by
      refine Set.finite_iUnion fun α => ?_
      by_cases hα : secFunc (e' k) α ≠ 0
      · let f_pole : ↥(Z_pole α) → Submodule Ω (Fin (r₀ + 1) → Ω) :=
          fun q => K_pole α q.1 ((hW_act α hα).2.2.1 q.1 q.2).1
        have _ : Finite ↥(Z_pole α) := (hW_act α hα).2.1.to_subtype
        refine ((Set.finite_singleton (K_der α)).union (Set.finite_range f_pole)).subset ?_
        rintro K ⟨_, rfl | ⟨P, hPZ, rfl⟩⟩
        · exact Or.inl rfl
        · exact Or.inr ⟨⟨P, hPZ⟩, rfl⟩
      · have hemp : S_α α = ∅ :=
          Set.eq_empty_of_forall_notMem fun K ⟨hα', _⟩ => hα hα'
        rw [hemp]
        exact Set.finite_empty
    have hS_proper : ∀ K ∈ S_sub, K ≠ ⊤ := by
      intro K hK htop
      rcases Set.mem_iUnion.mp hK with ⟨α, hα, rfl | ⟨P, hPZ, rfl⟩⟩
      · obtain ⟨c_der, hc_der⟩ := (hWitness α).2 hα
        have hmem : c_der ∈ K_der α := by rw [htop]; trivial
        exact hc_der hmem
      · have hP_cl := ((hW_act α hα).2.2.1 P hPZ).1
        obtain ⟨c_P, hc_P⟩ := (hWitness α).1 P hP_cl
        have hmem : c_P ∈ K_pole α P hP_cl := by rw [htop]; trivial
        exact hc_P hmem
    let e_fin := hS_fin.toFinset.equivFin.symm
    obtain ⟨c_lin, hc_lin⟩ := hSubFin hS_fin.toFinset.card
      (fun l => (e_fin l).1)
      (fun l => hS_proper (e_fin l).1 (hS_fin.mem_toFinset.mp (e_fin l).2))
    have hc_not_in : ∀ K ∈ S_sub, c_lin ∉ K := by
      intro K hK hc_in
      let q : ↥hS_fin.toFinset := ⟨K, hS_fin.mem_toFinset.mpr hK⟩
      have h1 := hc_lin (e_fin.symm q)
      simp only [Equiv.apply_symm_apply] at h1
      exact h1 hc_in
    refine ⟨c_lin, ?_⟩
    intro α hgk W_αk f_α
    have hf_mul : f_α * secFunc (e' k) α = linComb c_lin α := div_mul_cancel₀ _ hgk
    have hD_ne : KaehlerDifferential.D Ω (F α) f_α ≠ 0 :=
      hc_not_in (K_der α) (Set.mem_iUnion.mpr ⟨α, hgk, Or.inl rfl⟩)
    obtain ⟨hW_set_ord, _, hZ_props, _⟩ := hW_act α hgk
    refine ⟨hD_ne, ?_⟩
    ext z
    by_cases hz_cl : IsClosed ({z} : Set (E_norm α))
    · constructor
      · intro hz_in
        right
        have hgk_ord : ord α z (secFunc (e' k) α) = (-(Δ_div α z) : WithTop ℤ) := by
          have hz_or : ¬IsClosed ({z} : Set (E_norm α)) ∨
              ord α z (secFunc (e' k) α) = (-(Δ_div α z) : WithTop ℤ) :=
            (Set.ext_iff.mp hW_set_ord z).mp hz_in
          exact hz_or.resolve_left (not_not.mpr hz_cl)
        have hg_low : (-(Δ_div α z) : WithTop ℤ) ≤ ord α z (linComb c_lin α) := by
          refine hOrd_sum α z hz_cl _ Finset.univ _ ?_
          intro i _
          exact hOrd_smul α z hz_cl _ (c_lin i) _ (hg_bdd i α z hz_cl)
        have hsum_ord : ord α z f_α + (-(Δ_div α z) : WithTop ℤ) = ord α z (linComb c_lin α) := by
          rw [← hgk_ord, ← ((hRR_data α).2.2.1 z hz_cl).2.1, hf_mul]
        rw [← hsum_ord] at hg_low
        cases h_of : ord α z f_α with
        | top => exact le_top
        | coe m =>
          rw [h_of, ← hCoeNeg, ← WithTop.coe_add, WithTop.coe_le_coe] at hg_low
          rw [← WithTop.coe_zero, WithTop.coe_le_coe]
          omega
      · intro hz_or
        have h_nonneg : (0 : WithTop ℤ) ≤ ord α z f_α :=
          hz_or.resolve_left (not_not.mpr hz_cl)
        by_contra hz_not
        have hPZ : z ∈ Z_pole α := hz_not
        have hgk_high : ((1 - Δ_div α z : ℤ) : WithTop ℤ) ≤ ord α z (secFunc (e' k) α) :=
          (hZ_props z hz_not).2
        have hK_in : K_pole α z ((hZ_props z hz_not).1) ∈ S_sub :=
          Set.mem_iUnion.mpr ⟨α, hgk, Or.inr ⟨z, hPZ, rfl⟩⟩
        have hnot_pole : ¬(((1 - Δ_div α z : ℤ) : WithTop ℤ) ≤ ord α z (linComb c_lin α)) :=
          hc_not_in _ hK_in
        apply hnot_pole
        have h_add := add_le_add h_nonneg hgk_high
        rwa [zero_add, ← ((hRR_data α).2.2.1 z hz_cl).2.1, hf_mul] at h_add
    · constructor
      · intro _; exact Or.inl hz_cl
      · intro _
        exact (Set.ext_iff.mp hW_set_ord z).mpr (Or.inl hz_cl)
  obtain ⟨c_lin, hc_lin_props⟩ := hAvoid_phase
  
  refine ⟨ratio, c_lin, hRatio_mul, ?_⟩
  intro α
  let W_αk : (E_norm α).Opens := (TopologicalSpace.Opens.map (ν α).base).obj U_k
  by_cases hgk : secFunc (e' k) α = 0
  · exact Or.inl (hW_inact α hgk)
  · right
    let f_α : F α :=
      (∑ i : Fin (r₀ + 1), algebraMap Ω (F α) (c_lin i) * secFunc (e' i) α) /
        secFunc (e' k) α
    obtain ⟨hD_ne, hW_set_f⟩ := hc_lin_props α hgk
    obtain ⟨_, _, _, hRatio_eval⟩ := hW_act α hgk
    obtain ⟨U_f, hUf, hUf_set, hUf_ne, hUf_poly⟩ :=
      (hRR_data α).2.2.2.2.2.2.2.2.2.2.2.2 f_α hD_ne
    have hU_eq : U_f = W_αk := SetLike.coe_injective (hUf_set.trans hW_set_f.symm)
    subst hU_eq
    obtain ⟨φ_W, _, hφ_W⟩ := hFuncF α W_αk hUf hUf_ne
    obtain ⟨ψ_poly, hψ_C, hψ_X, hψ_fin⟩ := hUf_poly φ_W hφ_W
    have hinj := ((hRR_data α).2.2.2.1 W_αk hUf hUf_ne φ_W hφ_W).1
    have hφ_const := ((hRR_data α).2.2.2.1 W_αk hUf hUf_ne φ_W hφ_W).2.1
    refine ⟨hUf, ψ_poly, hψ_C, ?_, hψ_fin⟩
    apply hinj
    rw [hψ_X, map_sum]
    have hsum_eq :
        (∑ i : Fin (r₀ + 1),
          φ_W.hom ((((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
              (p_norm α).appLE ⊤ W_αk le_top).hom (c_lin i)) *
            ((ν α).app U_k).hom (ratio i))) =
        (∑ i : Fin (r₀ + 1),
          (algebraMap Ω (F α) (c_lin i) * secFunc (e' i) α) / secFunc (e' k) α) := by
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul, hφ_const (c_lin i), hRatio_eval hUf hUf_ne φ_W hφ_W i, mul_div_assoc]
    rw [hsum_eq, ← Finset.sum_div]

theorem weil_algClosed_nodal_tricanonical_cohomology_and_separation (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (M : WeilLineBundle C)
    (c δ : ℕ)
    (E_set : Fin (c + 1) → Set C)
    (E_norm : Fin (c + 1) → AlgebraicGeometry.Scheme.{u})
    (p_norm : ∀ α : Fin (c + 1), E_norm α ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (ν : ∀ α : Fin (c + 1), E_norm α ⟶ C)
    (F : Fin (c + 1) → Type u)
    [∀ α : Fin (c + 1), Field (F α)]
    [∀ α : Fin (c + 1), Algebra Ω (F α)]
    (η_F : ∀ α : Fin (c + 1), AlgebraicGeometry.Spec (CommRingCat.of (F α)) ⟶ E_norm α)
    (z_node : Fin δ → C)
    (α₀ : Fin δ → Fin (c + 1)) (P₀ : ∀ r : Fin δ, E_norm (α₀ r))
    (α₁ : Fin δ → Fin (c + 1)) (P₁ : ∀ r : Fin δ, E_norm (α₁ r))
    (hNormPkg : IsNodalCurveLogNormalizationPackage g n τ M c δ E_set E_norm p_norm ν F η_F
      z_node α₀ P₀ α₁ P₁)
    (hRR : ∀ α : Fin (c + 1),
      HasSmoothCurveRiemannRochPackage Ω (E_norm α) (p_norm α) (F α) (η_F α)) :
    (∀ c_coc : ∀ p : Fin M.m × Fin M.m, ↑(C.presheaf.obj (Opposite.op (M.V p.1 ⊓ M.V p.2))),
      (∀ a : Fin M.m, c_coc (a, a) = 0) →
      (∀ a b d : Fin M.m,
        let w₁ : M.V a ⊓ M.V b ⊓ M.V d ⟶ M.V a ⊓ M.V b := CategoryTheory.homOfLE inf_le_left
        let w₂ : M.V a ⊓ M.V b ⊓ M.V d ⟶ M.V b ⊓ M.V d :=
          CategoryTheory.homOfLE (inf_le_inf inf_le_right (le_refl _))
        let w₃ : M.V a ⊓ M.V b ⊓ M.V d ⟶ M.V a ⊓ M.V d :=
          CategoryTheory.homOfLE (inf_le_inf inf_le_left (le_refl _))
        (C.presheaf.map w₁.op).hom (c_coc (a, b)) +
          ((C.presheaf.map w₁.op).hom (M.u a b).val) ^ 3 *
            (C.presheaf.map w₂.op).hom (c_coc (b, d)) =
          (C.presheaf.map w₃.op).hom (c_coc (a, d))) →
      ∃ s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (M.V a))),
        ∀ a b : Fin M.m,
          c_coc (a, b) =
            (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : M.V a ⊓ M.V b ≤ M.V a)).op).hom (s a) -
              (M.u a b).val ^ 3 *
                (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : M.V a ⊓ M.V b ≤ M.V b)).op).hom (s b)) ∧
    ∃ (hAff : ∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a))
      (r₀ : ℕ) (_ : 3 ≤ r₀)
      (e : Fin (r₀ + 1) → ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a)))),
      (∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M ⊤ (e i)) ∧
      (∀ s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))),
        IsWeilTricanonicalSection M ⊤ s →
        ∃! c_coef : Fin (r₀ + 1) → Ω,
          ∀ a : Fin M.m,
            s a = ∑ i : Fin (r₀ + 1),
              (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M.V a ≤ ⊤)).op).hom
                (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ g.appTop).hom (c_coef i)) *
                e i a) ∧
      ∀ (e' : Fin (r₀ + 1) → ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a)))),
        (∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M ⊤ (e' i)) →
        (∀ s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))),
          IsWeilTricanonicalSection M ⊤ s →
          ∃! c_coef : Fin (r₀ + 1) → Ω,
            ∀ a : Fin M.m,
              s a = ∑ i : Fin (r₀ + 1),
                (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M.V a ≤ ⊤)).op).hom
                  (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ g.appTop).hom (c_coef i)) *
                  e' i a) →
        HasTricanonicalSeparationData Ω C g M hAff c E_norm p_norm ν r₀ e' :=
by
  choose ord g_E x_sep K_div hRR_body using fun α => (hRR α).2.2
  have hRR_data : ∀ α : Fin (c + 1),
      IsSmoothCurveRRData Ω (E_norm α) (p_norm α) (F α) (η_F α)
        (ord α) (g_E α) (x_sep α) (K_div α) :=
    fun α => ⟨(hRR α).1, (hRR α).2.1, hRR_body α⟩
  obtain ⟨B_div, B_self_div, D_div, hStabSys⟩ :=
    weil_nodal_pointed_stability_degree_bounds Ω C g n τ hStab M c δ E_set E_norm p_norm ν
      F η_F z_node α₀ P₀ α₁ P₁ hNormPkg g_E
      (fun α => (hRR_data α).2.2.2.2.2.2.2.2.2.1)
  obtain ⟨hH1, hAff, r₀, hr₀, e, lam_triv, secFunc, he_sec, he_bas, hBridge⟩ :=
    weil_nodal_tricanonical_divisor_bridge_and_cech Ω C g n τ M c δ E_set E_norm p_norm ν
      F η_F z_node α₀ P₀ α₁ P₁ hNormPkg ord g_E x_sep K_div hRR_data
      B_div B_self_div D_div hStabSys
  refine ⟨hH1, hAff, r₀, hr₀, e, he_sec, he_bas, ?_⟩
  intro e' he'_sec he'_bas
  obtain ⟨hC1, hC2, hC3, hC4⟩ :=
    weil_nodal_tricanonical_point_and_cotangent_separation Ω C g n τ M hAff c δ E_set
      E_norm p_norm ν F η_F z_node α₀ P₀ α₁ P₁ hNormPkg ord g_E x_sep K_div hRR_data
      B_div B_self_div D_div hStabSys r₀ lam_triv secFunc hBridge e' he'_sec he'_bas
  have hC5 :=
    weil_nodal_tricanonical_active_pole_finiteness Ω C g n τ M hAff c δ E_set
      E_norm p_norm ν F η_F z_node α₀ P₀ α₁ P₁ hNormPkg ord g_E x_sep K_div hRR_data
      B_div B_self_div D_div hStabSys r₀ lam_triv secFunc hBridge e' he'_sec he'_bas
  exact ⟨hC1, hC2, hC3, hC4, hC5⟩

theorem weil_algClosed_proj_closedImmersion_and_twoChart_cover (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (hProp_g : AlgebraicGeometry.IsProper g)
    (hLfp_g : AlgebraicGeometry.LocallyOfFinitePresentation g)
    (M : WeilLineBundle C)
    (hAff : ∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a))
    (c : ℕ)
    (E_set : Fin (c + 1) → Set C)
    (hE_inj : Function.Injective E_set)
    (hE_cov : (⋃ α : Fin (c + 1), E_set α) = Set.univ)
    (hE_inter : ∀ α β : Fin (c + 1), α ≠ β → (E_set α ∩ E_set β).Finite)
    (E_norm : Fin (c + 1) → AlgebraicGeometry.Scheme.{u})
    (p_norm : ∀ α : Fin (c + 1), E_norm α ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (ν : ∀ α : Fin (c + 1), E_norm α ⟶ C)
    (hNorm : ∀ α : Fin (c + 1),
      AlgebraicGeometry.IsIntegral (E_norm α) ∧
      AlgebraicGeometry.IsProper (p_norm α) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (p_norm α) ∧
      AlgebraicGeometry.IsFinite (ν α) ∧
      ν α ≫ g = p_norm α ∧
      Set.range (ν α).base = E_set α ∧
      (∀ P : E_norm α, IsClosed ({P} : Set (E_norm α)) ↔ IsClosed ({(ν α).base P} : Set C)) ∧
      Set.Infinite {P : E_norm α | IsClosed ({P} : Set (E_norm α))} ∧
      (∀ S : Set (E_norm α), IsClosed S → S ≠ Set.univ →
        S.Finite ∧ ∀ P ∈ S, IsClosed ({P} : Set (E_norm α))))
    (hResInj : ∀ (U : C.Opens) (s₁ s₂ : ↑(C.presheaf.obj (Opposite.op U))),
      (∀ α : Fin (c + 1), ((ν α).app U).hom s₁ = ((ν α).app U).hom s₂) → s₁ = s₂)
    (r₀ : ℕ) (hr₀ : 3 ≤ r₀)
    (e' : Fin (r₀ + 1) → ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))))
    (hSep : HasTricanonicalSeparationData Ω C g M hAff c E_norm p_norm ν r₀ e') :
    (∃ (j : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) Ω) :=
              MvPolynomial.gradedAlgebra
            (⊤ : C.Opens).toScheme ⟶
              AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) Ω)),
      IsLineBundleProjMorphism M ⊤
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ g.appTop).hom r₀ e' j ∧
      AlgebraicGeometry.IsClosedImmersion j) ∧
    (∃ W₀ W₁ : C.Opens,
      AlgebraicGeometry.IsAffineOpen W₀ ∧ AlgebraicGeometry.IsAffineOpen W₁ ∧ W₀ ⊔ W₁ = ⊤) :=
by
  have _ : True := by
    have _ := hE_inj; have _ := hResInj; have _ := hr₀; let _ := p_norm; trivial
  obtain ⟨hSec, hSpan, hSepPt, hCot, _⟩ := hSep
  have hNorm2 : ∀ α : Fin (c + 1),
      AlgebraicGeometry.IsFinite (ν α) ∧
      Set.range (ν α).base = E_set α ∧
      (∀ P : E_norm α, IsClosed ({P} : Set (E_norm α)) ↔ IsClosed ({(ν α).base P} : Set C)) ∧
      Set.Infinite {P : E_norm α | IsClosed ({P} : Set (E_norm α))} ∧
      (∀ S : Set (E_norm α), IsClosed S → S ≠ Set.univ →
        S.Finite ∧ ∀ P ∈ S, IsClosed ({P} : Set (E_norm α))) :=
    fun α => ⟨(hNorm α).2.2.2.1, (hNorm α).2.2.2.2.2.1, (hNorm α).2.2.2.2.2.2.1,
      (hNorm α).2.2.2.2.2.2.2.1, (hNorm α).2.2.2.2.2.2.2.2⟩
  have hNorm4 : ∀ α : Fin (c + 1),
      Set.range (ν α).base = E_set α ∧
      (∀ P : E_norm α, IsClosed ({P} : Set (E_norm α)) ↔ IsClosed ({(ν α).base P} : Set C)) ∧
      Set.Infinite {P : E_norm α | IsClosed ({P} : Set (E_norm α))} ∧
      (∀ S : Set (E_norm α), IsClosed S → S ≠ Set.univ →
        S.Finite ∧ ∀ P ∈ S, IsClosed ({P} : Set (E_norm α))) :=
    fun α => ⟨(hNorm α).2.2.2.2.2.1, (hNorm α).2.2.2.2.2.2.1,
      (hNorm α).2.2.2.2.2.2.2.1, (hNorm α).2.2.2.2.2.2.2.2⟩
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) Ω
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  have _ : AlgebraicGeometry.LocallyOfFiniteType g := inferInstance
  let e'_Va : Fin (r₀ + 1) → ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (M.V a))) :=
    fun i a =>
      (C.presheaf.map (CategoryTheory.homOfLE (le_inf le_top (le_refl (M.V a)))).op).hom (e' i a)
  let φ_Ω : Ω →+* ↑(C.presheaf.obj (Opposite.op ⊤)) :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ g.appTop).hom
  let φ_Ω_Va : ∀ a : Fin M.m, Ω →+* ↑(C.presheaf.obj (Opposite.op (M.V a))) :=
    fun a =>
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        g.appLE ⊤ (M.V a) le_top).hom
  have hφ_compat : ∀ (a : Fin M.m) (d : Ω),
      (C.presheaf.map (CategoryTheory.homOfLE (le_inf le_top (le_refl (M.V a)))).op).hom
        ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M.V a ≤ ⊤)).op).hom (φ_Ω d)) =
      φ_Ω_Va a d := by
    intro a d
    dsimp only [φ_Ω, φ_Ω_Va, AlgebraicGeometry.Scheme.Hom.appLE]
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    rw [← Functor.map_comp_apply]
    rfl
  
  have hSpecMap_inv : ∀ {R₁ R₂ : CommRingCat.{u}} (φ : R₁ ⟶ R₂),
