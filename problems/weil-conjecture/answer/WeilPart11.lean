          intro U_ov hU_aff h_le_C φ_ov hφ_ov x
          have h_nat : ((ν α).app (M.V a ⊓ M.V b ⊓ M.V d)).hom
              ((C.presheaf.map (CategoryTheory.homOfLE h_le_C).op).hom x) =
              ((E_norm α).presheaf.map (CategoryTheory.homOfLE
                ((TopologicalSpace.Opens.map (ν α).base).monotone h_le_C)).op).hom
                (((ν α).app U_ov).hom x) :=
            CategoryTheory.ConcreteCategory.congr_hom
              ((ν α).naturality (CategoryTheory.homOfLE h_le_C).op) x
          have h_comp_res : res_W'
              (((E_norm α).presheaf.map (CategoryTheory.homOfLE
                ((TopologicalSpace.Opens.map (ν α).base).monotone h_le_C)).op).hom
                (((ν α).app U_ov).hom x)) =
              ((E_norm α).presheaf.map (CategoryTheory.homOfLE
                (le_trans hW'_le ((TopologicalSpace.Opens.map (ν α).base).monotone h_le_C))).op).hom
                (((ν α).app U_ov).hom x) := by
            change ((E_norm α).presheaf.map _ ≫ (E_norm α).presheaf.map _).hom _ = _
            rw [← (E_norm α).presheaf.map_comp, ← op_comp]
            congr 2
          rw [h_nat, h_comp_res]
          exact hPhiAlign α _ _ hU_aff hW'_aff
            (le_trans hW'_le ((TopologicalSpace.Opens.map (ν α).base).monotone h_le_C))
            φ_ov φ_W' hφ_ov hφ_W' _
        rw [hPull (hAffW_ov α a b) inf_le_left φ_ab hφ_ab (c_coc (a, b)),
          hPull (hAffW_ov α a b) inf_le_left φ_ab hφ_ab (M.u a b).val,
          hPull (hAffW_ov α b d) (inf_le_inf inf_le_right (le_refl _)) φ_bd hφ_bd (c_coc (b, d)),
          hPull (hAffW_ov α a d) (inf_le_inf inf_le_left (le_refl _)) φ_ad hφ_ad (c_coc (a, d))]
          at h_ap
        have hLa_ne : (lam_triv α a ha) ^ 3 ≠ 0 := pow_ne_zero 3 (hLam_ne α a ha)
        have hLb_ne : (lam_triv α b hb) ^ 3 ≠ 0 := pow_ne_zero 3 (hLam_ne α b hb)
        have h_lam_rel := hLam_coc α a b ha hb (hAffW_ov α a b) φ_ab hφ_ab
        apply mul_right_cancel₀ hLa_ne
        rw [add_mul, hcF_val a b ha hb φ_ab hφ_ab, div_mul_cancel₀ _ hLa_ne,
          hcF_val a d ha hd φ_ad hφ_ad, div_mul_cancel₀ _ hLa_ne,
          hcF_val b d hb hd φ_bd hφ_bd]
        calc φ_ab.hom (((ν α).app (M.V a ⊓ M.V b)).hom (c_coc (a, b))) +
              (φ_bd.hom (((ν α).app (M.V b ⊓ M.V d)).hom (c_coc (b, d))) /
                (lam_triv α b hb) ^ 3) * (lam_triv α a ha) ^ 3
            = φ_ab.hom (((ν α).app (M.V a ⊓ M.V b)).hom (c_coc (a, b))) +
                (φ_ab.hom (((ν α).app (M.V a ⊓ M.V b)).hom (M.u a b).val)) ^ 3 *
                  ((φ_bd.hom (((ν α).app (M.V b ⊓ M.V d)).hom (c_coc (b, d))) /
                    (lam_triv α b hb) ^ 3) * (lam_triv α b hb) ^ 3) := by
              rw [h_lam_rel]; ring
          _ = φ_ad.hom (((ν α).app (M.V a ⊓ M.V d)).hom (c_coc (a, d))) := by
              rw [div_mul_cancel₀ _ hLb_ne, h_ap]
      obtain ⟨f_F, hf_pole, hf_cob⟩ :=
        ((hRR_data α).2.2.2.2.2.2.2.2.2.2.2.1 (Δ_div α) (hDelta_not_cl α)
          (hDelta_fin α) (hDelta_gt α)).2 M.m W_cov (hAffW α) hWCovUniv c_F
          hcF_diag hcF_pole hcF_coc
      have hf_loc : ∀ a : Fin M.m, IsLocBounded α a (f_F a) :=
        fun a P hP_in hP_cl => hf_pole a ⟨⟨P, hP_in⟩⟩ P hP_in hP_cl
      refine ⟨fun a => chartLift α a (f_F a), fun a b => ?_⟩
      by_cases hab : Nonempty ↥(W_cov a) ∧ Nonempty ↥(W_cov b)
      · rcases hab with ⟨ha, hb⟩
        obtain ⟨φ_ab, _, hφ_ab⟩ :=
          (hNormPkg.2.1 α).2.2.2.2.2.2.2.2 _ (hAffW_ov α a b) (hOvNe ha hb)
        obtain ⟨φ_a, _, hφ_a⟩ := (hNormPkg.2.1 α).2.2.2.2.2.2.2.2 _ (hAffW α a) ha
        obtain ⟨φ_b, _, hφ_b⟩ := (hNormPkg.2.1 α).2.2.2.2.2.2.2.2 _ (hAffW α b) hb
        apply ((hRR_data α).2.2.2.1 _ (hAffW_ov α a b) (hOvNe ha hb) φ_ab hφ_ab).1
        rw [map_sub, map_mul, map_pow,
          hPhiAlign α _ _ (hAffW α a) (hAffW_ov α a b)
            ((TopologicalSpace.Opens.map (ν α).base).monotone inf_le_left) φ_a φ_ab hφ_a hφ_ab,
          hPhiAlign α _ _ (hAffW α b) (hAffW_ov α a b)
            ((TopologicalSpace.Opens.map (ν α).base).monotone inf_le_right) φ_b φ_ab hφ_b hφ_ab,
          hCL_phi α a ha (hAffW α a) φ_a hφ_a (f_F a) (hf_loc a),
          hCL_phi α b hb (hAffW α b) φ_b hφ_b (f_F b) (hf_loc b)]
        have h_lam_rel := hLam_coc α a b ha hb (hAffW_ov α a b) φ_ab hφ_ab
        have hLa_ne : (lam_triv α a ha) ^ 3 ≠ 0 := pow_ne_zero 3 (hLam_ne α a ha)
        have h_c_eq := hcF_val a b ha hb φ_ab hφ_ab
        calc f_F a * (lam_triv α a ha) ^ 3 -
              (φ_ab.hom (((ν α).app (M.V a ⊓ M.V b)).hom (M.u a b).val)) ^ 3 *
                (f_F b * (lam_triv α b hb) ^ 3)
            = (f_F a - f_F b) * (lam_triv α a ha) ^ 3 := by rw [h_lam_rel]; ring
          _ = c_F a b * (lam_triv α a ha) ^ 3 := by rw [hf_cob a b ha hb]
          _ = φ_ab.hom (((ν α).app (M.V a ⊓ M.V b)).hom (c_coc (a, b))) := by
              rw [h_c_eq, div_mul_cancel₀ _ hLa_ne]
      · have h_ov_emp : ¬Nonempty ↥((TopologicalSpace.Opens.map (ν α).base).obj (M.V a ⊓ M.V b)) := by
          rintro ⟨x, hx_a, hx_b⟩
          exact hab ⟨⟨⟨x, hx_a⟩⟩, ⟨⟨x, hx_b⟩⟩⟩
        exact @Subsingleton.elim _ (hEmptySub (E_norm α) _ h_ov_emp) _ _
    choose t_tilde ht_tilde using hCompCech
    obtain ⟨g_tup, s, hg_gl, hs⟩ := hCovPinch c_coc t_tilde ht_tilde
    refine ⟨s, fun a b => ?_⟩
    apply hProdInj (M.V a ⊓ M.V b)
    intro α
    have h_nat_a : ((ν α).app (M.V a ⊓ M.V b)).hom
        ((C.presheaf.map (CategoryTheory.homOfLE
          (inf_le_left : M.V a ⊓ M.V b ≤ M.V a)).op).hom (s a)) =
        ((E_norm α).presheaf.map (CategoryTheory.homOfLE
          ((TopologicalSpace.Opens.map (ν α).base).monotone
            (inf_le_left : M.V a ⊓ M.V b ≤ M.V a))).op).hom
          (((ν α).app (M.V a)).hom (s a)) :=
      CategoryTheory.ConcreteCategory.congr_hom
        ((ν α).naturality (CategoryTheory.homOfLE
          (inf_le_left : M.V a ⊓ M.V b ≤ M.V a)).op) (s a)
    have h_nat_b : ((ν α).app (M.V a ⊓ M.V b)).hom
        ((C.presheaf.map (CategoryTheory.homOfLE
          (inf_le_right : M.V a ⊓ M.V b ≤ M.V b)).op).hom (s b)) =
        ((E_norm α).presheaf.map (CategoryTheory.homOfLE
          ((TopologicalSpace.Opens.map (ν α).base).monotone
            (inf_le_right : M.V a ⊓ M.V b ≤ M.V b))).op).hom
          (((ν α).app (M.V b)).hom (s b)) :=
      CategoryTheory.ConcreteCategory.congr_hom
        ((ν α).naturality (CategoryTheory.homOfLE
          (inf_le_right : M.V a ⊓ M.V b ≤ M.V b)).op) (s b)
    rw [map_sub, map_mul, map_pow, h_nat_a, h_nat_b, hs a α, hs b α, map_sub, map_sub]
    have h_t := ht_tilde α a b
    have h_g := sub_eq_zero.mpr (hCL_coc α (g_tup α) (hg_gl α) a b)
    linear_combination -h_t + h_g
  exact ⟨hH1, hAff, r₀, hr₀_ge, e, lam_triv, secFunc, he_sec, he_bas,
    hBr1, hBr2, hBr3, hBr4, hBr5⟩

theorem weil_nodal_tricanonical_point_and_cotangent_separation (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (M : WeilLineBundle C)
    (hAff : ∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a))
    (c δ : ℕ)
    (E_set : Fin (c + 1) → Set C)
    (E_norm : Fin (c + 1) → AlgebraicGeometry.Scheme.{u})
    (p_norm : ∀ α : Fin (c + 1), E_norm α ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (ν : ∀ α : Fin (c + 1), E_norm α ⟶ C)
    (F : Fin (c + 1) → Type u)
    [∀ α : Fin (c + 1), Field (F α)]
    [∀ α : Fin (c + 1), Algebra Ω (F α)]
    (η_F : ∀ α : Fin (c + 1), AlgebraicGeometry.Spec (CommRingCat.of (F α)) ⟶ E_norm α)
    (z_node : Fin δ → C)
    (α₀ : Fin δ → Fin (c + 1)) (P₀ : ∀ r : Fin δ, E_norm (α₀ r))
    (α₁ : Fin δ → Fin (c + 1)) (P₁ : ∀ r : Fin δ, E_norm (α₁ r))
    (hNormPkg : IsNodalCurveLogNormalizationPackage g n τ M c δ E_set E_norm p_norm ν F η_F
      z_node α₀ P₀ α₁ P₁)
    (ord : ∀ α : Fin (c + 1), E_norm α → F α → WithTop ℤ)
    (g_E : Fin (c + 1) → ℕ)
    (x_sep : ∀ α : Fin (c + 1), F α)
    (K_div : ∀ α : Fin (c + 1), E_norm α → ℤ)
    (hRR_data : ∀ α : Fin (c + 1),
      IsSmoothCurveRRData Ω (E_norm α) (p_norm α) (F α) (η_F α)
        (ord α) (g_E α) (x_sep α) (K_div α))
    (B_div B_self_div D_div : ∀ α : Fin (c + 1), E_norm α → ℤ)
    (hStabSys : IsNodalStabilityDivisorSystem g n τ c δ E_norm ν z_node α₀ α₁ g_E
      B_div B_self_div D_div)
    (r₀ : ℕ)
    (lam_triv : ∀ (α : Fin (c + 1)) (a : Fin M.m),
      Nonempty ↥((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)) → F α)
    (secFunc : (∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a)))) →
      ∀ α : Fin (c + 1), F α)
    (hBridge : HasNodalTricanonicalDivisorBridge Ω C g M hAff c δ E_norm ν F η_F z_node
      ord K_div B_div B_self_div D_div lam_triv secFunc)
    (e' : Fin (r₀ + 1) → ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))))
    (he'_sec : ∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M ⊤ (e' i))
    (he'_bas : ∀ s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))),
      IsWeilTricanonicalSection M ⊤ s →
      ∃! c_coef : Fin (r₀ + 1) → Ω,
        ∀ a : Fin M.m,
          s a = ∑ i : Fin (r₀ + 1),
            (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M.V a ≤ ⊤)).op).hom
              (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ g.appTop).hom (c_coef i)) *
              e' i a) :
    let e'_Va : Fin (r₀ + 1) → ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (M.V a))) :=
      fun i a =>
        (C.presheaf.map (CategoryTheory.homOfLE (le_inf le_top (le_refl (M.V a)))).op).hom (e' i a)
    let φ_Ω_Va : ∀ a : Fin M.m, Ω →+* ↑(C.presheaf.obj (Opposite.op (M.V a))) :=
      fun a =>
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          g.appLE ⊤ (M.V a) le_top).hom
    (∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M ⊤ (e' i)) ∧
    (∀ a : Fin M.m,
      Ideal.span (Set.range fun i : Fin (r₀ + 1) => e' i a) = ⊤) ∧
    (∀ (a_x a_y : Fin M.m)
        (p_x : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a_x))))
        (p_y : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a_y)))),
      let x : C := (hAff a_x).fromSpec.base p_x
      let y : C := (hAff a_y).fromSpec.base p_y
      IsClosed ({x} : Set C) →
      IsClosed ({y} : Set C) →
      x ≠ y →
      ∃ (i k : Fin (r₀ + 1)) (v_ix v_kx v_iy v_ky : Ω),
        e'_Va i a_x - φ_Ω_Va a_x v_ix ∈ p_x.asIdeal ∧
        e'_Va k a_x - φ_Ω_Va a_x v_kx ∈ p_x.asIdeal ∧
        e'_Va i a_y - φ_Ω_Va a_y v_iy ∈ p_y.asIdeal ∧
        e'_Va k a_y - φ_Ω_Va a_y v_ky ∈ p_y.asIdeal ∧
        v_ix * v_ky ≠ v_iy * v_kx) ∧
    (∀ (a : Fin M.m)
        (p_x : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a))))
        (k : Fin (r₀ + 1))
        (he_not_mem : e'_Va k a ∉ p_x.asIdeal),
      IsClosed ({(hAff a).fromSpec.base p_x} : Set C) →
      let O_x := Localization.AtPrime p_x.asIdeal
      let m_x := IsLocalRing.maximalIdeal O_x
      ∃ c_val : Fin (r₀ + 1) → Ω,
        (∀ i : Fin (r₀ + 1),
          IsLocalization.mk' O_x (e'_Va i a) (⟨e'_Va k a, he_not_mem⟩ : p_x.asIdeal.primeCompl) -
            algebraMap _ O_x (φ_Ω_Va a (c_val i)) ∈ m_x) ∧
        m_x ≤ Ideal.span (Set.range fun i : Fin (r₀ + 1) =>
          IsLocalization.mk' O_x (e'_Va i a) (⟨e'_Va k a, he_not_mem⟩ : p_x.asIdeal.primeCompl) -
            algebraMap _ O_x (φ_Ω_Va a (c_val i))) ⊔ m_x ^ 2) :=
by
  intro e'_Va φ_Ω_Va
  let toVa : (∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a)))) →
      ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (M.V a))) :=
    fun s a =>
      (C.presheaf.map (CategoryTheory.homOfLE (le_inf le_top (le_refl (M.V a)))).op).hom (s a)
  let Δ_div : ∀ α : Fin (c + 1), E_norm α → ℤ :=
    fun α P => 3 * K_div α P + 3 * B_div α P + 3 * D_div α P
  obtain ⟨hE_cov_data, hE_comp, _, hNodes_data, _, _, hAffW, _, pt_C, pt_E,
      hpt_C, hpt_E, _, hCot_smooth, hCot_nodal, _⟩ := hNormPkg
  rcases hStabSys with ⟨hDiv_pt, hDiv_fin, hDiv_deg, _⟩
  rcases hBridge with ⟨hBr_triv, _, hBr_node, hBr_extB, hBr_extBself⟩

  have hAddFin : ∀ {α_t : Type u} (f₁ f₂ : α_t → ℤ),
      {x : α_t | f₁ x ≠ 0}.Finite → {x : α_t | f₂ x ≠ 0}.Finite →
      {x : α_t | (f₁ x + f₂ x) ≠ 0}.Finite := by
    intro α_t f₁ f₂ hf₁ hf₂
    refine (hf₁.union hf₂).subset (fun x hx => ?_)
    by_contra h
    simp only [Set.mem_union, Set.mem_setOf_eq, not_or, Classical.not_not] at h
    exact hx (by show f₁ x + f₂ x = 0; rw [h.1, h.2, add_zero])

  have hSubFin : ∀ {α_t : Type u} (f₁ f₂ : α_t → ℤ),
      {x : α_t | f₁ x ≠ 0}.Finite → {x : α_t | f₂ x ≠ 0}.Finite →
      {x : α_t | (f₁ x - f₂ x) ≠ 0}.Finite := by
    intro α_t f₁ f₂ hf₁ hf₂
    refine (hf₁.union hf₂).subset (fun x hx => ?_)
    by_contra h
    simp only [Set.mem_union, Set.mem_setOf_eq, not_or, Classical.not_not] at h
    exact hx (by show f₁ x - f₂ x = 0; rw [h.1, h.2, sub_self])

  have hIndFin : ∀ {α_t : Type u} [DecidableEq α_t] (Q : α_t),
      Function.HasFiniteSupport (fun R : α_t => if R = Q then (1 : ℤ) else 0) := by
    intro α_t _ Q
    refine (Set.finite_singleton Q).subset (fun R hR => ?_)
    rw [Set.mem_singleton_iff]
    by_contra hRQ
    exact hR (if_neg hRQ)

  
  have hΔ_info : ∀ α : Fin (c + 1),
      (∀ P : E_norm α, ¬IsClosed ({P} : Set (E_norm α)) → Δ_div α P = 0) ∧
      {P : E_norm α | Δ_div α P ≠ 0}.Finite ∧
      (∑ᶠ P : E_norm α, Δ_div α P) =
        3 * ((2 : ℤ) * (g_E α : ℤ) - 2 +
          (∑ᶠ P : E_norm α, B_div α P) + (∑ᶠ P : E_norm α, D_div α P)) := by
    intro α
    rcases hRR_data α with ⟨_, _, _, _, _, hK_noncl, hK_fin, hK_deg, _⟩
    rcases hDiv_fin α with ⟨hB_fin, _, hD_fin⟩
    have h_noncl : ∀ P : E_norm α, ¬IsClosed ({P} : Set (E_norm α)) → Δ_div α P = 0 := by
      intro P hP
      have hK0 : K_div α P = 0 := hK_noncl P hP
      have hB0 : B_div α P = 0 := by
        rcases (hDiv_pt α P).1 with ⟨_, hcl, _⟩ | ⟨h0, _⟩
        · exact False.elim (hP hcl)
        · exact h0
      have hD0 : D_div α P = 0 := by
        rcases (hDiv_pt α P).2.2.1 with ⟨_, hcl, _⟩ | ⟨h0, _⟩
        · exact False.elim (hP hcl)
        · exact h0
      show 3 * K_div α P + 3 * B_div α P + 3 * D_div α P = 0
      rw [hK0, hB0, hD0]
      ring
    have h3K_fin : Function.HasFiniteSupport (fun P => 3 * K_div α P) :=
      hK_fin.subset (fun P hP h0 => hP (by show 3 * K_div α P = 0; rw [h0, mul_zero]))
    have h3B_fin : Function.HasFiniteSupport (fun P => 3 * B_div α P) :=
      hB_fin.subset (fun P hP h0 => hP (by show 3 * B_div α P = 0; rw [h0, mul_zero]))
    have h3D_fin : Function.HasFiniteSupport (fun P => 3 * D_div α P) :=
      hD_fin.subset (fun P hP h0 => hP (by show 3 * D_div α P = 0; rw [h0, mul_zero]))
    have h3KB_fin : Function.HasFiniteSupport (fun P => 3 * K_div α P + 3 * B_div α P) :=
      hAddFin _ _ h3K_fin h3B_fin
    have hΔ_fin : {P : E_norm α | Δ_div α P ≠ 0}.Finite :=
      hAddFin _ _ h3KB_fin h3D_fin
    refine ⟨h_noncl, hΔ_fin, ?_⟩
    calc (∑ᶠ P : E_norm α, (3 * K_div α P + 3 * B_div α P + 3 * D_div α P))
        = (∑ᶠ P : E_norm α, (3 * K_div α P + 3 * B_div α P)) +
            (∑ᶠ P : E_norm α, 3 * D_div α P) := finsum_add_distrib h3KB_fin h3D_fin
      _ = (∑ᶠ P : E_norm α, 3 * K_div α P) + (∑ᶠ P : E_norm α, 3 * B_div α P) +
            (∑ᶠ P : E_norm α, 3 * D_div α P) := by rw [finsum_add_distrib h3K_fin h3B_fin]
      _ = 3 * (∑ᶠ P : E_norm α, K_div α P) + 3 * (∑ᶠ P : E_norm α, B_div α P) +
            3 * (∑ᶠ P : E_norm α, D_div α P) := by
          rw [← mul_finsum, ← mul_finsum, ← mul_finsum]
      _ = 3 * ((2 : ℤ) * (g_E α : ℤ) - 2 +
            (∑ᶠ P : E_norm α, B_div α P) + (∑ᶠ P : E_norm α, D_div α P)) := by
          rw [hK_deg]; ring

  
  have hExactOrd : ∀ (α : Fin (c + 1)) (E : E_norm α → ℤ) (P : E_norm α),
      (∀ R : E_norm α, ¬IsClosed ({R} : Set (E_norm α)) → E R = 0) →
      {R : E_norm α | E R ≠ 0}.Finite →
      (2 : ℤ) * (g_E α : ℤ) ≤ (∑ᶠ R : E_norm α, E R) →
      IsClosed ({P} : Set (E_norm α)) →
      ∃ f : F α,
        (∀ R : E_norm α, IsClosed ({R} : Set (E_norm α)) →
          (-(E R) : WithTop ℤ) ≤ ord α R f) ∧
        ¬(((1 - E P : ℤ) : WithTop ℤ) ≤ ord α P f) := by
    classical
    intro α E P hE_noncl hE_fin hE_deg hP_cl
    rcases hRR_data α with ⟨_, _, hOrd_ax, _, _, _, _, _, _, _, _, hRR_dim, _⟩
    let mkL : (E_norm α → ℤ) → Submodule Ω (F α) := fun D =>
      { carrier := {f : F α | ∀ R : E_norm α, IsClosed ({R} : Set (E_norm α)) →
          (-(D R) : WithTop ℤ) ≤ ord α R f}
        zero_mem' := fun R hR => by
          rw [((hOrd_ax R hR).1 0).mpr rfl]
          exact le_top
        add_mem' := fun {x y} hx hy R hR =>
          le_trans (le_min (hx R hR) (hy R hR)) ((hOrd_ax R hR).2.2.1 x y)
        smul_mem' := fun c {x} hx R hR => by
          by_cases hc : c = 0
          · subst hc
            rw [zero_smul, ((hOrd_ax R hR).1 0).mpr rfl]
            exact le_top
          · rw [Algebra.smul_def, (hOrd_ax R hR).2.1, (hOrd_ax R hR).2.2.2.1 c hc, zero_add]
            exact hx R hR }
    let δ_P : E_norm α → ℤ := fun R => if R = P then 1 else 0
    let E' : E_norm α → ℤ := fun R => E R - δ_P R
    have hδ_fin : Function.HasFiniteSupport δ_P := hIndFin P
    have hE'_noncl : ∀ R : E_norm α, ¬IsClosed ({R} : Set (E_norm α)) → E' R = 0 := by
      intro R hR
      have hRP : R ≠ P := fun h => hR (h ▸ hP_cl)
      show E R - (if R = P then 1 else 0) = 0
      rw [hE_noncl R hR, if_neg hRP, sub_zero]
    have hE'_fin : {R : E_norm α | E' R ≠ 0}.Finite := hSubFin E δ_P hE_fin hδ_fin
    have hδ_sum : (∑ᶠ R : E_norm α, δ_P R) = 1 := by
      rw [finsum_eq_single δ_P P (fun R hRP => if_neg hRP)]
      simp [δ_P]
    have hE'_sum : (∑ᶠ R : E_norm α, E' R) = (∑ᶠ R : E_norm α, E R) - 1 := by
      change (∑ᶠ R : E_norm α, (E R - δ_P R)) = _
      rw [finsum_sub_distrib hE_fin hδ_fin, hδ_sum]
    have hE_gt : (2 : ℤ) * (g_E α : ℤ) - 2 < (∑ᶠ R : E_norm α, E R) := by omega
    have hE'_gt : (2 : ℤ) * (g_E α : ℤ) - 2 < (∑ᶠ R : E_norm α, E' R) := by omega
    have h_dim_E := ((hRR_dim E hE_noncl hE_fin hE_gt).1 (mkL E) (fun _ => Iff.rfl)).2
    have h_dim_E' := ((hRR_dim E' hE'_noncl hE'_fin hE'_gt).1 (mkL E') (fun _ => Iff.rfl)).2
    have h_le : mkL E' ≤ mkL E := by
      intro f hf R hR
      have hER : -(E R) ≤ -(E' R) := by
        dsimp only [E', δ_P]
        split_ifs <;> omega
      exact le_trans (WithTop.coe_le_coe.mpr hER) (hf R hR)
    have h_fr_lt : Module.finrank Ω ↥(mkL E') < Module.finrank Ω ↥(mkL E) := by omega
    obtain ⟨f, hf_E, hf_not_E'⟩ :=
      SetLike.exists_of_lt (Submodule.lt_of_le_of_finrank_lt_finrank h_le h_fr_lt)
    refine ⟨f, hf_E, fun h_ord_P => hf_not_E' (fun R hR => ?_)⟩
    by_cases hRP : R = P
    · subst hRP
      have hEP : 1 - E R = -(E' R) := by
        show 1 - E R = -(E R - (if R = R then 1 else 0))
        simp
      rw [hEP] at h_ord_P
      exact h_ord_P
    · have hER : E' R = E R := by
        show E R - (if R = P then 1 else 0) = E R
        rw [if_neg hRP, sub_zero]
      rw [hER]
      exact hf_E R hR

  
  have hValDict : ∀ (α : Fin (c + 1)) (a : Fin M.m)
      (p_P : PrimeSpectrum ↑((E_norm α).presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)))))
      (s : ∀ b : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V b)))),
      let P : E_norm α := (hAffW α a).fromSpec.base p_P
      IsClosed ({P} : Set (E_norm α)) →
      IsWeilTricanonicalSection M ⊤ s →
      ((((ν α).app (M.V a)).hom (toVa s a) ∈ p_P.asIdeal ↔
          ((1 - Δ_div α P : ℤ) : WithTop ℤ) ≤ ord α P (secFunc s α)) ∧
        (((ν α).app (M.V a)).hom (toVa s a) ∈ p_P.asIdeal ^ 2 ↔
          ((2 - Δ_div α P : ℤ) : WithTop ℤ) ≤ ord α P (secFunc s α)) ∧
        (secFunc s α = 0 → ((ν α).app (M.V a)).hom (toVa s a) = 0)) := by
    intro α a p_P s P hP_cl hs
    let W := (TopologicalSpace.Opens.map (ν α).base).obj (M.V a)
    have hP_mem : P ∈ W := by
      change P ∈ (W : Set (E_norm α))
      rw [← (hAffW α a).range_fromSpec]
      exact ⟨p_P, rfl⟩
    have ha : Nonempty ↥W := ⟨⟨P, hP_mem⟩⟩
    obtain ⟨φ_a, _, hφ_a⟩ := (hE_comp α).2.2.2.2.2.2.2.2 W (hAffW α a) ha
    rcases hBr_triv α a ha (hAffW α a) with ⟨_, hOrd_lam, hSec_triv⟩
    have h_pull := (hSec_triv s hs).2 φ_a hφ_a
    have h_lam := hOrd_lam P hP_mem hP_cl
    rcases hRR_data α with ⟨_, _, hOrd_ax, hChart_val, _⟩
    rcases hChart_val W (hAffW α a) ha φ_a hφ_a with ⟨hφ_inj, _, _, hIdeal_iff⟩
    rcases hIdeal_iff p_P hP_cl with ⟨_, hMem1, hMem2⟩
    have h_shift : ∀ (w : WithTop ℤ) (k d : ℤ),
        (k : WithTop ℤ) ≤ w + (d : WithTop ℤ) ↔ ((k - d : ℤ) : WithTop ℤ) ≤ w := by
      intro w k d
      cases w with
      | top => simp
      | coe z => norm_cast; omega
    refine ⟨?_, ?_, ?_⟩
    · rw [hMem1, h_pull, (hOrd_ax P hP_cl).2.1, h_lam]
      exact h_shift (ord α P (secFunc s α)) 1 (Δ_div α P)
    · rw [hMem2, h_pull, (hOrd_ax P hP_cl).2.1, h_lam]
      exact h_shift (ord α P (secFunc s α)) 2 (Δ_div α P)
    · intro h0
      apply hφ_inj
      rw [h_pull, h0, zero_mul, map_zero]

  
  have hExpandVa : ∀ s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))),
      IsWeilTricanonicalSection M ⊤ s →
      ∃ c_coef : Fin (r₀ + 1) → Ω,
        ∀ a : Fin M.m,
          toVa s a = ∑ i : Fin (r₀ + 1), φ_Ω_Va a (c_coef i) * e'_Va i a := by
    intro s hs
    obtain ⟨c_coef, hc_coef, _⟩ := he'_bas s hs
    refine ⟨c_coef, fun a => ?_⟩
    let ρ := (C.presheaf.map (CategoryTheory.homOfLE (le_inf le_top (le_refl (M.V a)))).op).hom
    change ρ (s a) = _
    rw [hc_coef a, map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul]
    have h_map : g.appTop ≫ C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M.V a ≤ ⊤)).op ≫
        C.presheaf.map (CategoryTheory.homOfLE (le_inf le_top (le_refl (M.V a)))).op =
        g.appLE ⊤ (M.V a) le_top := by
      rw [← C.presheaf.map_comp, ← op_comp, CategoryTheory.homOfLE_comp]
      rfl
    have h_sc : ρ ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M.V a ≤ ⊤)).op).hom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ g.appTop).hom (c_coef i))) =
        φ_Ω_Va a (c_coef i) := by
      change (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        (g.appTop ≫ C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M.V a ≤ ⊤)).op ≫
          C.presheaf.map (CategoryTheory.homOfLE (le_inf le_top (le_refl (M.V a)))).op)).hom (c_coef i)) = _
      rw [h_map]
    rw [h_sc]

  
  have hEvalPt : ∀ (a : Fin M.m)
      (p_x : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a)))),
      let x : C := (hAff a).fromSpec.base p_x
      IsClosed ({x} : Set C) →
      (∃ ev_x : ↑(C.presheaf.obj (Opposite.op (M.V a))) →+* Ω,
        RingHom.ker ev_x = p_x.asIdeal ∧
        ∀ c : Ω, ev_x (φ_Ω_Va a c) = c) ∧
      (∀ (α : Fin (c + 1)) (P : E_norm α),
        (ν α).base P = x →
        ∃ p_P : PrimeSpectrum ↑((E_norm α).presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)))),
          (hAffW α a).fromSpec.base p_P = P ∧
          ∀ b : ↑(C.presheaf.obj (Opposite.op (M.V a))),
            b ∈ p_x.asIdeal ↔ ((ν α).app (M.V a)).hom b ∈ p_P.asIdeal) := by
    intro a p_x x hx
    have hx_mem : x ∈ M.V a := by
      change x ∈ (M.V a : Set C)
      rw [← (hAff a).range_fromSpec]
      exact ⟨p_x, rfl⟩
    have h_in_C : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
        (TopologicalSpace.Opens.map (pt_C x hx).base).obj (M.V a) := by
      intro q _
      change (pt_C x hx).base q ∈ M.V a
      rw [(hpt_C x hx).2.1 q]
      exact hx_mem
    refine ⟨⟨weilPointEvalRingHom (pt_C x hx) (M.V a) h_in_C,
      (hpt_C x hx).2.2 a p_x h_in_C rfl, fun c => ?_⟩, fun α P hPx => ?_⟩
    · have h_app : g.appLE ⊤ (M.V a) le_top ≫ (pt_C x hx).appLE (M.V a) ⊤ h_in_C =
          AlgebraicGeometry.Scheme.Hom.appLE
            (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω))) ⊤ ⊤ le_rfl := by
        refine (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
          (pt_C x hx) g ⊤ (M.V a) ⊤ le_top h_in_C).trans ?_
        congr 1
        exact (hpt_C x hx).1
      have hid : AlgebraicGeometry.Scheme.Hom.appLE
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω))) ⊤ ⊤ le_rfl = 𝟙 _ := by
        simp [AlgebraicGeometry.Scheme.Hom.appLE]
      have hcomp : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          (g.appLE ⊤ (M.V a) le_top ≫ (pt_C x hx).appLE (M.V a) ⊤ h_in_C) ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom) = 𝟙 (CommRingCat.of Ω) := by
        rw [h_app, hid, CategoryTheory.Category.id_comp, CategoryTheory.Iso.inv_hom_id]
      exact ConcreteCategory.congr_hom hcomp c
    · have hx' : IsClosed ({(ν α).base P} : Set C) := by rwa [hPx]
      have hP_cl : IsClosed ({P} : Set (E_norm α)) := ((hE_comp α).2.2.2.2.2.2.1 P).mpr hx'
      let W := (TopologicalSpace.Opens.map (ν α).base).obj (M.V a)
      have hP_mem : P ∈ (W : Set (E_norm α)) := by
        change (ν α).base P ∈ M.V a
        rw [hPx]
        exact hx_mem
      rw [← (hAffW α a).range_fromSpec] at hP_mem
      obtain ⟨p_P, hp_P⟩ := hP_mem
      refine ⟨p_P, hp_P, fun b => ?_⟩
      have h_in_E : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
          (TopologicalSpace.Opens.map (pt_E α P hP_cl).base).obj W := by
        intro q _
        change (ν α).base ((pt_E α P hP_cl).base q) ∈ M.V a
        rw [(hpt_E α P hP_cl).2.1 q, hPx]
        exact hx_mem
      have h_in_C' : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
          (TopologicalSpace.Opens.map (pt_C ((ν α).base P) hx').base).obj (M.V a) := by
        intro q _
        change (pt_C ((ν α).base P) hx').base q ∈ M.V a
        rw [(hpt_C _ hx').2.1 q, hPx]
        exact hx_mem
      have hker_E := (hpt_E α P hP_cl).2.2.2 W (hAffW α a) p_P h_in_E hp_P
      have hker_C := (hpt_C ((ν α).base P) hx').2.2 a p_x h_in_C' hPx.symm
      have h_ev_eq : weilPointEvalRingHom (pt_E α P hP_cl) W h_in_E (((ν α).app (M.V a)).hom b) =
          weilPointEvalRingHom (pt_C ((ν α).base P) hx') (M.V a) h_in_C' b := by
        have h_app : (ν α).app (M.V a) ≫ (pt_E α P hP_cl).appLE W ⊤ h_in_E =
            (pt_C ((ν α).base P) hx').appLE (M.V a) ⊤ h_in_C' := by
          rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
          refine (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
            (pt_E α P hP_cl) (ν α) (M.V a) W ⊤ le_rfl h_in_E).trans ?_
          congr 1
          exact (hpt_E α P hP_cl).2.2.1 hx'
        change (((ν α).app (M.V a) ≫ (pt_E α P hP_cl).appLE W ⊤ h_in_E) ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom).hom b = _
        rw [h_app]
        rfl
      rw [← hker_C, ← hker_E, RingHom.mem_ker, RingHom.mem_ker, h_ev_eq]

  
  have hSmoothInd : ∀ (a : Fin M.m)
      (p_z : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a)))),
      let z : C := (hAff a).fromSpec.base p_z
      IsClosed ({z} : Set C) →
      z ∉ Set.range z_node →
      ∃ (α : Fin (c + 1)) (P : E_norm α)
        (s_z : ∀ b : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V b)))),
        (ν α).base P = z ∧
        IsClosed ({P} : Set (E_norm α)) ∧
        IsWeilTricanonicalSection M ⊤ s_z ∧
        toVa s_z a ∉ p_z.asIdeal ∧
        (∀ β : Fin (c + 1), β ≠ α → secFunc s_z β = 0) ∧
        (∀ (r : Fin δ) (a' : Fin M.m)
            (p_n : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a')))),
          (hAff a').fromSpec.base p_n = z_node r →
          toVa s_z a' ∈ p_n.asIdeal) := by
    intro a p_z z hz_cl hz_sm
    obtain ⟨⟨α, P⟩, hPz, _⟩ := (hNodes_data.2.2.1 z hz_sm).2
    dsimp only at hPz
    have hP_cl : IsClosed ({P} : Set (E_norm α)) :=
      ((hE_comp α).2.2.2.2.2.2.1 P).mpr (by rwa [hPz])
    have hB_P : B_div α P = 0 := by
      rcases (hDiv_pt α P).1 with ⟨_, _, hmem⟩ | ⟨h0, _⟩
      · rw [hPz] at hmem; exact False.elim (hz_sm hmem)
      · exact h0
    let E : E_norm α → ℤ := fun R => Δ_div α R - B_div α R
    have hE_noncl : ∀ R : E_norm α, ¬IsClosed ({R} : Set (E_norm α)) → E R = 0 := by
      intro R hR
      have hB0 : B_div α R = 0 := by
        rcases (hDiv_pt α R).1 with ⟨_, hcl, _⟩ | ⟨h0, _⟩
        · exact False.elim (hR hcl)
        · exact h0
      show Δ_div α R - B_div α R = 0
      rw [(hΔ_info α).1 R hR, hB0, sub_zero]
    have hE_fin : {R : E_norm α | E R ≠ 0}.Finite :=
      hSubFin (Δ_div α) (B_div α) (hΔ_info α).2.1 (hDiv_fin α).1
    have hE_deg : (2 : ℤ) * (g_E α : ℤ) ≤ (∑ᶠ R : E_norm α, E R) := by
      have h_sub : (∑ᶠ R : E_norm α, E R) =
          (∑ᶠ R : E_norm α, Δ_div α R) - (∑ᶠ R : E_norm α, B_div α R) :=
        finsum_sub_distrib (hΔ_info α).2.1 (hDiv_fin α).1
      have h_deg_α := (hDiv_deg α).2.1
      rw [h_sub, (hΔ_info α).2.2]
      omega
    obtain ⟨f_α, hf_pole, hf_P⟩ := hExactOrd α E P hE_noncl hE_fin hE_deg hP_cl
    obtain ⟨s_z, hs_z, hsec_α, hsec_ne, hnode_van⟩ := hBr_extB α f_α hf_pole
    refine ⟨α, P, s_z, hPz, hP_cl, hs_z, ?_, hsec_ne, hnode_van⟩
    obtain ⟨p_P, hp_P, hmem_iff⟩ := (hEvalPt a p_z hz_cl).2 α P hPz
    rw [hmem_iff]
    have hP_cl' : IsClosed ({(hAffW α a).fromSpec.base p_P} : Set (E_norm α)) := by rwa [hp_P]
    rw [(hValDict α a p_P s_z hP_cl' hs_z).1, hp_P, hsec_α]
    have hEP : 1 - Δ_div α P = 1 - E P := by
      show 1 - Δ_div α P = 1 - (Δ_div α P - B_div α P)
      rw [hB_P, sub_zero]
    rw [hEP]
    exact hf_P

  refine ⟨he'_sec, ?_, ?_, ?_⟩

  
  
  
  · intro a
    have hVa_top : Ideal.span (Set.range fun i : Fin (r₀ + 1) => e'_Va i a) = ⊤ := by
      by_contra h_ne_top
      obtain ⟨m, hm_max, hm_le⟩ :=
        Ideal.exists_le_maximal (Ideal.span (Set.range fun i : Fin (r₀ + 1) => e'_Va i a)) h_ne_top
      let p_x : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a))) := ⟨m, hm_max.isPrime⟩
      let x : C := (hAff a).fromSpec.base p_x
      have hx_cl : IsClosed ({x} : Set C) := by
        have hp_cl : IsClosed ({p_x} : Set (AlgebraicGeometry.Spec (C.presheaf.obj (Opposite.op (M.V a))))) :=
          (PrimeSpectrum.isClosed_singleton_iff_isMaximal p_x).mpr hm_max
        have hEmb := (hAff a).fromSpec.isOpenEmbedding
        obtain ⟨Z, hZ_cl, hZ_pre⟩ := hEmb.isInducing.isClosed_iff.mp hp_cl
        have hx_Z : x ∈ Z := by
          have hp_mem : p_x ∈ (hAff a).fromSpec.base ⁻¹' Z := by
            rw [hZ_pre]; exact Set.mem_singleton p_x
          exact hp_mem
        have hZ_uniq : ∀ y : C, y ∈ M.V a → y ∈ Z → y = x := by
          intro y hy_V hy_Z
          change y ∈ (M.V a : Set C) at hy_V
          rw [← (hAff a).range_fromSpec] at hy_V
          obtain ⟨q, rfl⟩ := hy_V
          have hq_mem : q ∈ (hAff a).fromSpec.base ⁻¹' Z := hy_Z
          rw [hZ_pre] at hq_mem
          have hq_eq : q = p_x := hq_mem
          rw [hq_eq]
        have hx_univ : x ∈ (Set.univ : Set C) := Set.mem_univ x
        rw [← hE_cov_data.2.2, Set.mem_iUnion] at hx_univ
        obtain ⟨α, hxα⟩ := hx_univ
        rw [← (hE_comp α).2.2.2.2.2.1] at hxα
        obtain ⟨P, hPx⟩ := hxα
        let W := (TopologicalSpace.Opens.map (ν α).base).obj (M.V a)
        have hP_W : P ∈ (W : Set (E_norm α)) := by
          change (ν α).base P ∈ M.V a
          rw [hPx]
          change x ∈ (M.V a : Set C)
          rw [← (hAff a).range_fromSpec]
          exact ⟨p_x, rfl⟩
        let S_x : Set (E_norm α) := (ν α).base ⁻¹' Z
        have hSx_cl : IsClosed S_x := hZ_cl.preimage (ν α).continuous
        have hP_Sx : P ∈ S_x := by
          change (ν α).base P ∈ Z
          rw [hPx]; exact hx_Z
        by_cases hS_univ : S_x = Set.univ
        · let K_c : Set (E_norm α) := (W : Set (E_norm α))ᶜ
          have hKc_cl : IsClosed K_c := W.isOpen.isClosed_compl
          have hKc_ne : K_c ≠ Set.univ := by
            intro huniv
            have : P ∈ K_c := by rw [huniv]; exact Set.mem_univ P
            exact this hP_W
          have hKc_fin : K_c.Finite := ((hRR_data α).2.1 K_c hKc_cl hKc_ne).1
          obtain ⟨Q₁, hQ₁_cl, hQ₁_not_Kc⟩ :=
            ((hRR_data α).1.sdiff hKc_fin).nonempty
          have hQ₁_W : (ν α).base Q₁ ∈ M.V a := by
            by_contra h_not_W
            exact hQ₁_not_Kc h_not_W
          have hQ₁_Z : (ν α).base Q₁ ∈ Z := by
            change Q₁ ∈ S_x
            rw [hS_univ]; exact Set.mem_univ Q₁
          have hQ₁_x : (ν α).base Q₁ = x := hZ_uniq ((ν α).base Q₁) hQ₁_W hQ₁_Z
          rw [← hQ₁_x]
          exact ((hE_comp α).2.2.2.2.2.2.1 Q₁).mp hQ₁_cl
        · have hP_cl : IsClosed ({P} : Set (E_norm α)) :=
            ((hRR_data α).2.1 S_x hSx_cl hS_univ).2 P hP_Sx
          rw [← hPx]
          exact ((hE_comp α).2.2.2.2.2.2.1 P).mp hP_cl
      have h_exists_nonvan : ∃ s : ∀ b : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V b))),
          IsWeilTricanonicalSection M ⊤ s ∧ toVa s a ∉ p_x.asIdeal := by
        by_cases hx_node : x ∈ Set.range z_node
        · obtain ⟨r, hr⟩ := hx_node
          obtain ⟨s_r, hs_r, h_nonvan, _⟩ := hBr_node r
          exact ⟨s_r, hs_r, h_nonvan a p_x hr.symm⟩
        · obtain ⟨_, _, s_x, _, _, hs_x, h_nonvan, _, _⟩ := hSmoothInd a p_x hx_cl hx_node
          exact ⟨s_x, hs_x, h_nonvan⟩
      obtain ⟨s, hs, hs_not_mem⟩ := h_exists_nonvan
      obtain ⟨c_coef, hc_coef⟩ := hExpandVa s hs
      apply hs_not_mem
      change toVa s a ∈ m
      rw [hc_coef a]
      refine Ideal.sum_mem m (fun i _ => ?_)
      exact Ideal.mul_mem_left m _ (hm_le (Ideal.subset_span ⟨i, rfl⟩))
    have h1_Va : (1 : ↑(C.presheaf.obj (Opposite.op (M.V a)))) ∈
        Ideal.span (Set.range fun i : Fin (r₀ + 1) => e'_Va i a) := by
      rw [hVa_top]; exact Submodule.mem_top
    obtain ⟨g_coef, hg_coef⟩ := Ideal.mem_span_range_iff_exists_fun.mp h1_Va
    let ρ_from :=
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : ⊤ ⊓ M.V a ≤ M.V a)).op).hom
    have h_retr : ∀ i : Fin (r₀ + 1), ρ_from (e'_Va i a) = e' i a := by
      intro i
      change (C.presheaf.map _ ≫ C.presheaf.map _).hom (e' i a) = e' i a
      rw [← C.presheaf.map_comp, ← op_comp, CategoryTheory.homOfLE_comp]
      simp
    rw [Ideal.eq_top_iff_one, Ideal.mem_span_range_iff_exists_fun]
    refine ⟨fun i => ρ_from (g_coef i), ?_⟩
    calc (∑ i : Fin (r₀ + 1), ρ_from (g_coef i) * e' i a)
        = ∑ i : Fin (r₀ + 1), ρ_from (g_coef i * e'_Va i a) := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [map_mul, h_retr i]
      _ = ρ_from (∑ i : Fin (r₀ + 1), g_coef i * e'_Va i a) := (map_sum ρ_from _ _).symm
      _ = 1 := by rw [hg_coef, map_one]

  
  
  
  · intro a_x a_y p_x p_y x y hx_cl hy_cl hxy
    have h_sep_sec : ∃ s₁ s₂ : ∀ b : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V b))),
        IsWeilTricanonicalSection M ⊤ s₁ ∧
        IsWeilTricanonicalSection M ⊤ s₂ ∧
        toVa s₁ a_x ∉ p_x.asIdeal ∧
        toVa s₂ a_y ∉ p_y.asIdeal ∧
        (toVa s₁ a_y ∈ p_y.asIdeal ∨ toVa s₂ a_x ∈ p_x.asIdeal) := by
      by_cases hx_node : x ∈ Set.range z_node
      · obtain ⟨r, hr⟩ := hx_node
        obtain ⟨s_r, hs_r, hr_nonvan, hr_van⟩ := hBr_node r
        by_cases hy_node : y ∈ Set.range z_node
        · obtain ⟨r', hr'⟩ := hy_node
          have hrr' : r' ≠ r := fun h => hxy (by rw [← hr, ← hr', h])
          obtain ⟨s_r', hs_r', hr'_nonvan, _⟩ := hBr_node r'
          exact ⟨s_r, s_r', hs_r, hs_r', hr_nonvan a_x p_x hr.symm,
            hr'_nonvan a_y p_y hr'.symm, Or.inl (hr_van r' hrr' a_y p_y hr'.symm)⟩
        · obtain ⟨_, _, s_y, _, _, hs_y, hy_nonvan, _, hy_node_van⟩ :=
            hSmoothInd a_y p_y hy_cl hy_node
          exact ⟨s_r, s_y, hs_r, hs_y, hr_nonvan a_x p_x hr.symm,
            hy_nonvan, Or.inr (hy_node_van r a_x p_x hr.symm)⟩
      · obtain ⟨α, P, s_x, hPx, hP_cl, hs_x, hx_nonvan, hx_sec_ne, hx_node_van⟩ :=
          hSmoothInd a_x p_x hx_cl hx_node
        by_cases hy_node : y ∈ Set.range z_node
        · obtain ⟨r', hr'⟩ := hy_node
          obtain ⟨s_r', hs_r', hr'_nonvan, _⟩ := hBr_node r'
          exact ⟨s_x, s_r', hs_x, hs_r', hx_nonvan,
            hr'_nonvan a_y p_y hr'.symm, Or.inl (hx_node_van r' a_y p_y hr'.symm)⟩
        · obtain ⟨β, Q, s_y, hQy, hQ_cl, hs_y, hy_nonvan, _, _⟩ :=
            hSmoothInd a_y p_y hy_cl hy_node
          by_cases hαβ : α = β
          · subst hαβ
            classical
            have hPQ : P ≠ Q :=
              fun h => hxy (hPx.symm.trans ((congrArg (ν α).base h).trans hQy))
            have hBs_P : B_self_div α P = 0 := by
              rcases (hDiv_pt α P).2.1 with ⟨_, _, r, _, _, hnr⟩ | ⟨h0, _⟩
              · rw [hPx] at hnr; exact False.elim (hx_node ⟨r, hnr.symm⟩)
              · exact h0
            have hBs_Q : B_self_div α Q = 0 := by
              rcases (hDiv_pt α Q).2.1 with ⟨_, _, r, _, _, hnr⟩ | ⟨h0, _⟩
              · rw [hQy] at hnr; exact False.elim (hy_node ⟨r, hnr.symm⟩)
              · exact h0
            let δ_Q : E_norm α → ℤ := fun R => if R = Q then 1 else 0
            let E : E_norm α → ℤ := fun R => Δ_div α R - B_self_div α R - δ_Q R
            have hδQ_fin : Function.HasFiniteSupport δ_Q := hIndFin Q
            have hΔBs_fin : Function.HasFiniteSupport (fun R => Δ_div α R - B_self_div α R) :=
              hSubFin (Δ_div α) (B_self_div α) (hΔ_info α).2.1 (hDiv_fin α).2.1
            have hE_noncl : ∀ R : E_norm α, ¬IsClosed ({R} : Set (E_norm α)) → E R = 0 := by
              intro R hR
              have hBs0 : B_self_div α R = 0 := by
                rcases (hDiv_pt α R).2.1 with ⟨_, hcl, _⟩ | ⟨h0, _⟩
                · exact False.elim (hR hcl)
                · exact h0
              have hRQ : R ≠ Q := fun h => hR (h ▸ hQ_cl)
              show Δ_div α R - B_self_div α R - (if R = Q then 1 else 0) = 0
              rw [(hΔ_info α).1 R hR, hBs0, if_neg hRQ]; ring
            have hE_fin : {R : E_norm α | E R ≠ 0}.Finite :=
              hSubFin (fun R => Δ_div α R - B_self_div α R) δ_Q hΔBs_fin hδQ_fin
            have hE_deg : (2 : ℤ) * (g_E α : ℤ) ≤ (∑ᶠ R : E_norm α, E R) := by
              have h1 : (∑ᶠ R : E_norm α, E R) =
                  (∑ᶠ R : E_norm α, (Δ_div α R - B_self_div α R)) - (∑ᶠ R : E_norm α, δ_Q R) :=
                finsum_sub_distrib hΔBs_fin hδQ_fin
              have h2 : (∑ᶠ R : E_norm α, (Δ_div α R - B_self_div α R)) =
                  (∑ᶠ R : E_norm α, Δ_div α R) - (∑ᶠ R : E_norm α, B_self_div α R) :=
                finsum_sub_distrib (hΔ_info α).2.1 (hDiv_fin α).2.1
              have h3 : (∑ᶠ R : E_norm α, δ_Q R) = 1 := by
                rw [finsum_eq_single δ_Q Q (fun R hRQ => if_neg hRQ)]
                simp [δ_Q]
              have h_deg_α := (hDiv_deg α).2.2
              rw [h1, h2, h3, (hΔ_info α).2.2]
              omega
            obtain ⟨f_α, hf_pole, hf_P⟩ := hExactOrd α E P hE_noncl hE_fin hE_deg hP_cl
            have hf_Bs : ∀ R : E_norm α, IsClosed ({R} : Set (E_norm α)) →
                (-(Δ_div α R - B_self_div α R) : WithTop ℤ) ≤ ord α R f_α := by
              intro R hR
              have h_le : -(Δ_div α R - B_self_div α R) ≤ -(E R) := by
                dsimp only [E, δ_Q]
                split_ifs <;> omega
              exact le_trans (WithTop.coe_le_coe.mpr h_le) (hf_pole R hR)
            obtain ⟨s₁, hs₁, hsec₁⟩ := hBr_extBself α f_α hf_Bs
            have hs₁_x : toVa s₁ a_x ∉ p_x.asIdeal := by
              obtain ⟨p_P, hp_P, hmem_iff⟩ := (hEvalPt a_x p_x hx_cl).2 α P hPx
              rw [hmem_iff]
              have hP_cl' : IsClosed ({(hAffW α a_x).fromSpec.base p_P} : Set (E_norm α)) := by
                rwa [hp_P]
              rw [(hValDict α a_x p_P s₁ hP_cl' hs₁).1, hp_P, hsec₁]
              have hEP : 1 - Δ_div α P = 1 - E P := by
                show 1 - Δ_div α P = 1 - (Δ_div α P - B_self_div α P - (if P = Q then 1 else 0))
                rw [hBs_P, if_neg hPQ]; ring
              rw [hEP]
              exact hf_P
            have hs₁_y : toVa s₁ a_y ∈ p_y.asIdeal := by
              obtain ⟨p_Q, hp_Q, hmem_iff⟩ := (hEvalPt a_y p_y hy_cl).2 α Q hQy
              rw [hmem_iff]
              have hQ_cl' : IsClosed ({(hAffW α a_y).fromSpec.base p_Q} : Set (E_norm α)) := by
                rwa [hp_Q]
              rw [(hValDict α a_y p_Q s₁ hQ_cl' hs₁).1, hp_Q, hsec₁]
              have hEQ : 1 - Δ_div α Q = -(E Q) := by
                show 1 - Δ_div α Q = -(Δ_div α Q - B_self_div α Q - (if Q = Q then 1 else 0))
                rw [hBs_Q, if_pos rfl]; ring
              rw [hEQ]
              exact hf_pole Q hQ_cl
            exact ⟨s₁, s_y, hs₁, hs_y, hs₁_x, hy_nonvan, Or.inl hs₁_y⟩
          · have hs_x_y : toVa s_x a_y ∈ p_y.asIdeal := by
              obtain ⟨p_Q, hp_Q, hmem_iff⟩ := (hEvalPt a_y p_y hy_cl).2 β Q hQy
              rw [hmem_iff]
              have hQ_cl' : IsClosed ({(hAffW β a_y).fromSpec.base p_Q} : Set (E_norm β)) := by
                rwa [hp_Q]
              rw [(hValDict β a_y p_Q s_x hQ_cl' hs_x).2.2 (hx_sec_ne β (Ne.symm hαβ))]
              exact Ideal.zero_mem _
            exact ⟨s_x, s_y, hs_x, hs_y, hx_nonvan, hy_nonvan, Or.inl hs_x_y⟩
    obtain ⟨s₁, s₂, hs₁, hs₂, hs₁_x, hs₂_y, h_van⟩ := h_sep_sec
    obtain ⟨⟨ev_x, hev_x_ker, hev_x_φ⟩, _⟩ := hEvalPt a_x p_x hx_cl
    obtain ⟨⟨ev_y, hev_y_ker, hev_y_φ⟩, _⟩ := hEvalPt a_y p_y hy_cl
    let v_x : Fin (r₀ + 1) → Ω := fun j => ev_x (e'_Va j a_x)
    let v_y : Fin (r₀ + 1) → Ω := fun j => ev_y (e'_Va j a_y)
    have hv_x_mem : ∀ j : Fin (r₀ + 1), e'_Va j a_x - φ_Ω_Va a_x (v_x j) ∈ p_x.asIdeal := by
      intro j
      rw [← hev_x_ker, RingHom.mem_ker, map_sub, hev_x_φ]
      exact sub_self (v_x j)
    have hv_y_mem : ∀ j : Fin (r₀ + 1), e'_Va j a_y - φ_Ω_Va a_y (v_y j) ∈ p_y.asIdeal := by
      intro j
      rw [← hev_y_ker, RingHom.mem_ker, map_sub, hev_y_φ]
      exact sub_self (v_y j)
    have hev1x_ne : ev_x (toVa s₁ a_x) ≠ 0 :=
      fun h => hs₁_x (by rw [← hev_x_ker]; exact h)
    have hev2y_ne : ev_y (toVa s₂ a_y) ≠ 0 :=
      fun h => hs₂_y (by rw [← hev_y_ker]; exact h)
    have hD_ne : ev_x (toVa s₁ a_x) * ev_y (toVa s₂ a_y) -
        ev_y (toVa s₁ a_y) * ev_x (toVa s₂ a_x) ≠ 0 := by
      rcases h_van with h1y | h2x
      · have h0 : ev_y (toVa s₁ a_y) = 0 := by rwa [← hev_y_ker] at h1y
        rw [h0, zero_mul, sub_zero]
        exact mul_ne_zero hev1x_ne hev2y_ne
      · have h0 : ev_x (toVa s₂ a_x) = 0 := by rwa [← hev_x_ker] at h2x
        rw [h0, mul_zero, sub_zero]
        exact mul_ne_zero hev1x_ne hev2y_ne
    obtain ⟨c₁, hc₁⟩ := hExpandVa s₁ hs₁
    obtain ⟨c₂, hc₂⟩ := hExpandVa s₂ hs₂
    have hev_lin_x : ∀ (s : ∀ b : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V b))))
        (c_s : Fin (r₀ + 1) → Ω),
        toVa s a_x = ∑ i : Fin (r₀ + 1), φ_Ω_Va a_x (c_s i) * e'_Va i a_x →
        ev_x (toVa s a_x) = ∑ i : Fin (r₀ + 1), c_s i * v_x i := by
      intro s c_s hcs
      rw [hcs, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, hev_x_φ]
    have hev_lin_y : ∀ (s : ∀ b : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V b))))
        (c_s : Fin (r₀ + 1) → Ω),
        toVa s a_y = ∑ i : Fin (r₀ + 1), φ_Ω_Va a_y (c_s i) * e'_Va i a_y →
        ev_y (toVa s a_y) = ∑ i : Fin (r₀ + 1), c_s i * v_y i := by
      intro s c_s hcs
      rw [hcs, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, hev_y_φ]
    have h_exists_ik : ∃ i k : Fin (r₀ + 1), v_x i * v_y k ≠ v_y i * v_x k := by
      by_contra h_all
      push_neg at h_all
      apply hD_ne
      rw [hev_lin_x s₁ c₁ (hc₁ a_x), hev_lin_y s₂ c₂ (hc₂ a_y),
          hev_lin_y s₁ c₁ (hc₁ a_y), hev_lin_x s₂ c₂ (hc₂ a_x)]
      rw [Finset.sum_mul, Finset.sum_mul, ← Finset.sum_sub_distrib]
      refine Finset.sum_eq_zero (fun i _ => ?_)
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_eq_zero (fun k _ => ?_)
      have hik := h_all i k
      calc c₁ i * v_x i * (c₂ k * v_y k) - c₁ i * v_y i * (c₂ k * v_x k)
          = c₁ i * c₂ k * (v_x i * v_y k - v_y i * v_x k) := by ring
        _ = 0 := by rw [hik, sub_self, mul_zero]
    obtain ⟨i, k, hik⟩ := h_exists_ik
    exact ⟨i, k, v_x i, v_x k, v_y i, v_y k,
      hv_x_mem i, hv_x_mem k, hv_y_mem i, hv_y_mem k, hik⟩

  
  
  
  · intro a p_x k he_not_mem hx_cl
    dsimp only
    let x : C := (hAff a).fromSpec.base p_x
    let m_x : Ideal (Localization.AtPrime p_x.asIdeal) :=
      IsLocalRing.maximalIdeal (Localization.AtPrime p_x.asIdeal)
    obtain ⟨⟨ev_x, hev_ker, hev_φ⟩, hPullPrimes⟩ := hEvalPt a p_x hx_cl
    have hv_k : ev_x (e'_Va k a) ≠ 0 :=
      fun h0 => he_not_mem (by rw [← hev_ker]; exact h0)
    let c_val : Fin (r₀ + 1) → Ω := fun i => ev_x (e'_Va i a) * (ev_x (e'_Va k a))⁻¹
    let s_k : p_x.asIdeal.primeCompl := ⟨e'_Va k a, he_not_mem⟩
    let q_fn : Fin (r₀ + 1) → Localization.AtPrime p_x.asIdeal := fun i =>
      IsLocalization.mk' (Localization.AtPrime p_x.asIdeal) (e'_Va i a) s_k -
        algebraMap _ (Localization.AtPrime p_x.asIdeal) (φ_Ω_Va a (c_val i))
    let num_fn : Fin (r₀ + 1) → ↑(C.presheaf.obj (Opposite.op (M.V a))) := fun i =>
      e'_Va i a - φ_Ω_Va a (c_val i) * e'_Va k a
    have hnum_mem : ∀ i : Fin (r₀ + 1), num_fn i ∈ p_x.asIdeal := by
      intro i
      rw [← hev_ker, RingHom.mem_ker]
      dsimp only [num_fn, c_val]
      rw [map_sub, map_mul, hev_φ, inv_mul_cancel_right₀ hv_k, sub_self]
    have hu_q : ∀ i : Fin (r₀ + 1),
        algebraMap _ (Localization.AtPrime p_x.asIdeal) (e'_Va k a) * q_fn i =
          algebraMap _ (Localization.AtPrime p_x.asIdeal) (num_fn i) := by
      intro i
      dsimp only [q_fn, num_fn]
      let ι_loc := algebraMap ↑(C.presheaf.obj (Opposite.op (M.V a)))
        (Localization.AtPrime p_x.asIdeal)
      rw [mul_sub, IsLocalization.mk'_spec' (Localization.AtPrime p_x.asIdeal) (e'_Va i a) s_k,
        ι_loc.map_sub, ι_loc.map_mul]
      ring
    have hq_mem_mx : ∀ i : Fin (r₀ + 1), q_fn i ∈ m_x := by
      intro i
      obtain ⟨u_inv, hu_inv⟩ :=
        (IsLocalization.map_units (Localization.AtPrime p_x.asIdeal) s_k).exists_left_inv
      have hu_inv' : u_inv * algebraMap _ (Localization.AtPrime p_x.asIdeal) (e'_Va k a) = 1 :=
        hu_inv
      have h_num_mx : algebraMap _ (Localization.AtPrime p_x.asIdeal) (num_fn i) ∈ m_x :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff
          (Localization.AtPrime p_x.asIdeal) p_x.asIdeal (num_fn i)).mpr (hnum_mem i)
      have hq_eq : q_fn i = u_inv * algebraMap _ (Localization.AtPrime p_x.asIdeal) (num_fn i) := by
        rw [← hu_q i, ← mul_assoc, hu_inv', one_mul]
      rw [hq_eq]
      exact Ideal.mul_mem_left m_x u_inv h_num_mx
    let I_q : Ideal (Localization.AtPrime p_x.asIdeal) := Ideal.span (Set.range q_fn)
    have hVanSpan : ∀ s : ∀ b : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V b))),
        IsWeilTricanonicalSection M ⊤ s →
        toVa s a ∈ p_x.asIdeal →
        algebraMap _ (Localization.AtPrime p_x.asIdeal) (toVa s a) ∈ I_q := by
      intro s hs hs_mem
      obtain ⟨c_s, hc_s⟩ := hExpandVa s hs
      have hev_s : ev_x (toVa s a) = 0 := by rwa [← hev_ker] at hs_mem
      have h_ev_sum : (∑ i : Fin (r₀ + 1), c_s i * ev_x (e'_Va i a)) = 0 := by
        rw [← hev_s, hc_s a, map_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_mul, hev_φ]
      have hsum_c : (∑ i : Fin (r₀ + 1), c_s i * c_val i) = 0 := by
        calc (∑ i : Fin (r₀ + 1), c_s i * (ev_x (e'_Va i a) * (ev_x (e'_Va k a))⁻¹))
            = (∑ i : Fin (r₀ + 1), c_s i * ev_x (e'_Va i a)) * (ev_x (e'_Va k a))⁻¹ := by
              rw [Finset.sum_mul]
              refine Finset.sum_congr rfl (fun i _ => by ring)
          _ = 0 := by rw [h_ev_sum, zero_mul]
      have hsum_φ : (∑ i : Fin (r₀ + 1), φ_Ω_Va a (c_s i) * φ_Ω_Va a (c_val i)) = 0 := by
        calc (∑ i : Fin (r₀ + 1), φ_Ω_Va a (c_s i) * φ_Ω_Va a (c_val i))
            = φ_Ω_Va a (∑ i : Fin (r₀ + 1), c_s i * c_val i) := by
              rw [map_sum]
              refine Finset.sum_congr rfl (fun i _ => (map_mul _ _ _).symm)
          _ = 0 := by rw [hsum_c, map_zero]
      have h_s_num : toVa s a = ∑ i : Fin (r₀ + 1), φ_Ω_Va a (c_s i) * num_fn i := by
        calc toVa s a
            = (∑ i : Fin (r₀ + 1), φ_Ω_Va a (c_s i) * e'_Va i a) -
                (∑ i : Fin (r₀ + 1), φ_Ω_Va a (c_s i) * φ_Ω_Va a (c_val i)) * e'_Va k a := by
              rw [hc_s a, hsum_φ, zero_mul, sub_zero]
          _ = ∑ i : Fin (r₀ + 1), φ_Ω_Va a (c_s i) * num_fn i := by
              rw [Finset.sum_mul, ← Finset.sum_sub_distrib]
              refine Finset.sum_congr rfl (fun i _ => by dsimp only [num_fn]; ring)
      rw [h_s_num, map_sum]
      refine Ideal.sum_mem I_q (fun i _ => ?_)
      rw [map_mul, ← hu_q i, ← mul_assoc]
      exact Ideal.mul_mem_left I_q _ (Ideal.subset_span ⟨i, rfl⟩)

    refine ⟨c_val, hq_mem_mx, ?_⟩
    change m_x ≤ I_q ⊔ m_x ^ 2
    by_cases hx_node : x ∈ Set.range z_node
    · 
      obtain ⟨r, hr⟩ := hx_node
      have hP₀_cl : IsClosed ({P₀ r} : Set (E_norm (α₀ r))) := (hNodes_data.2.1 r).2.1
      have hP₁_cl : IsClosed ({P₁ r} : Set (E_norm (α₁ r))) := (hNodes_data.2.1 r).2.2.1
      have hν₀ : (ν (α₀ r)).base (P₀ r) = x := by rw [← hr]; exact (hNodes_data.2.1 r).2.2.2.1
      have hν₁ : (ν (α₁ r)).base (P₁ r) = x := by rw [← hr]; exact (hNodes_data.2.1 r).2.2.2.2.1
      obtain ⟨p₀, hp₀, _⟩ := hPullPrimes (α₀ r) (P₀ r) hν₀
      obtain ⟨p₁, hp₁, _⟩ := hPullPrimes (α₁ r) (P₁ r) hν₁
      by_cases h₀₁ : α₀ r = α₁ r
      · 
        have hSelfBranch : ∀ (α : Fin (c + 1)) (Q₀ Q₁ : E_norm α)
            (q₀ q₁ : PrimeSpectrum ↑((E_norm α).presheaf.obj
              (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a))))),
            Q₀ ≠ Q₁ →
            IsClosed ({Q₀} : Set (E_norm α)) →
            IsClosed ({Q₁} : Set (E_norm α)) →
            B_self_div α Q₀ = 1 →
            B_self_div α Q₁ = 1 →
            (hAffW α a).fromSpec.base q₀ = Q₀ →
            (hAffW α a).fromSpec.base q₁ = Q₁ →
            ∃ s : ∀ b : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V b))),
              IsWeilTricanonicalSection M ⊤ s ∧
              ((ν α).app (M.V a)).hom (toVa s a) ∈ q₀.asIdeal ∧
              ((ν α).app (M.V a)).hom (toVa s a) ∉ q₀.asIdeal ^ 2 ∧
              ((ν α).app (M.V a)).hom (toVa s a) ∈ q₁.asIdeal ^ 2 := by
          classical
          intro α Q₀ Q₁ q₀ q₁ hQ_ne hQ₀_cl hQ₁_cl hBs₀ hBs₁ hq₀ hq₁
          let δ_Q₁ : E_norm α → ℤ := fun R => if R = Q₁ then 1 else 0
          let E : E_norm α → ℤ := fun R => Δ_div α R - B_self_div α R - δ_Q₁ R
          have hδ_fin : Function.HasFiniteSupport δ_Q₁ := hIndFin Q₁
          have hΔBs_fin : Function.HasFiniteSupport (fun R => Δ_div α R - B_self_div α R) :=
            hSubFin (Δ_div α) (B_self_div α) (hΔ_info α).2.1 (hDiv_fin α).2.1
          have hE_noncl : ∀ R : E_norm α, ¬IsClosed ({R} : Set (E_norm α)) → E R = 0 := by
            intro R hR
            have hBs0 : B_self_div α R = 0 := by
              rcases (hDiv_pt α R).2.1 with ⟨_, hcl, _⟩ | ⟨h0, _⟩
              · exact False.elim (hR hcl)
              · exact h0
            have hRQ : R ≠ Q₁ := fun h => hR (h ▸ hQ₁_cl)
            show Δ_div α R - B_self_div α R - (if R = Q₁ then 1 else 0) = 0
            rw [(hΔ_info α).1 R hR, hBs0, if_neg hRQ]; ring
          have hE_fin : {R : E_norm α | E R ≠ 0}.Finite :=
            hSubFin (fun R => Δ_div α R - B_self_div α R) δ_Q₁ hΔBs_fin hδ_fin
          have hE_deg : (2 : ℤ) * (g_E α : ℤ) ≤ (∑ᶠ R : E_norm α, E R) := by
            have h1 : (∑ᶠ R : E_norm α, E R) =
                (∑ᶠ R : E_norm α, (Δ_div α R - B_self_div α R)) - (∑ᶠ R : E_norm α, δ_Q₁ R) :=
              finsum_sub_distrib hΔBs_fin hδ_fin
            have h2 : (∑ᶠ R : E_norm α, (Δ_div α R - B_self_div α R)) =
                (∑ᶠ R : E_norm α, Δ_div α R) - (∑ᶠ R : E_norm α, B_self_div α R) :=
              finsum_sub_distrib (hΔ_info α).2.1 (hDiv_fin α).2.1
            have h3 : (∑ᶠ R : E_norm α, δ_Q₁ R) = 1 := by
              rw [finsum_eq_single δ_Q₁ Q₁ (fun R hRQ => if_neg hRQ)]
              simp [δ_Q₁]
            have h_deg_α := (hDiv_deg α).2.2
            rw [h1, h2, h3, (hΔ_info α).2.2]
            omega
          obtain ⟨f, hf_pole, hf_Q₀⟩ := hExactOrd α E Q₀ hE_noncl hE_fin hE_deg hQ₀_cl
          have hf_Bs : ∀ R : E_norm α, IsClosed ({R} : Set (E_norm α)) →
              (-(Δ_div α R - B_self_div α R) : WithTop ℤ) ≤ ord α R f := by
            intro R hR
            have h_le : -(Δ_div α R - B_self_div α R) ≤ -(E R) := by
              dsimp only [E, δ_Q₁]
              split_ifs <;> omega
            exact le_trans (WithTop.coe_le_coe.mpr h_le) (hf_pole R hR)
          obtain ⟨s, hs, hsec⟩ := hBr_extBself α f hf_Bs
          have hq₀_cl : IsClosed ({(hAffW α a).fromSpec.base q₀} : Set (E_norm α)) := by rwa [hq₀]
          have hq₁_cl : IsClosed ({(hAffW α a).fromSpec.base q₁} : Set (E_norm α)) := by rwa [hq₁]
          refine ⟨s, hs, ?_, ?_, ?_⟩
          · rw [(hValDict α a q₀ s hq₀_cl hs).1, hq₀, hsec]
            have hEQ₀ : 1 - Δ_div α Q₀ = -(E Q₀) := by
              show 1 - Δ_div α Q₀ = -(Δ_div α Q₀ - B_self_div α Q₀ - (if Q₀ = Q₁ then 1 else 0))
              rw [hBs₀, if_neg hQ_ne]; ring
            rw [hEQ₀]
            exact hf_pole Q₀ hQ₀_cl
          · rw [(hValDict α a q₀ s hq₀_cl hs).2.1, hq₀, hsec]
            have hEQ₀' : 2 - Δ_div α Q₀ = 1 - E Q₀ := by
              show 2 - Δ_div α Q₀ = 1 - (Δ_div α Q₀ - B_self_div α Q₀ - (if Q₀ = Q₁ then 1 else 0))
              rw [hBs₀, if_neg hQ_ne]; ring
            rw [hEQ₀']
            exact hf_Q₀
          · rw [(hValDict α a q₁ s hq₁_cl hs).2.1, hq₁, hsec]
            have hEQ₁ : 2 - Δ_div α Q₁ = -(E Q₁) := by
              show 2 - Δ_div α Q₁ = -(Δ_div α Q₁ - B_self_div α Q₁ - (if Q₁ = Q₁ then 1 else 0))
              rw [hBs₁, if_pos rfl]; ring
            rw [hEQ₁]
            exact hf_pole Q₁ hQ₁_cl
        have hBs_P₀ : B_self_div (α₀ r) (P₀ r) = 1 := by
          rcases (hDiv_pt (α₀ r) (P₀ r)).2.1 with ⟨h1, _⟩ | ⟨_, hnot⟩
          · exact h1
          · exact False.elim (hnot ⟨r, rfl, h₀₁.symm, (hNodes_data.2.1 r).2.2.2.1⟩)
        have hBs_P₁ : B_self_div (α₁ r) (P₁ r) = 1 := by
          rcases (hDiv_pt (α₁ r) (P₁ r)).2.1 with ⟨h1, _⟩ | ⟨_, hnot⟩
          · exact h1
          · exact False.elim (hnot ⟨r, h₀₁, rfl, (hNodes_data.2.1 r).2.2.2.2.1⟩)
        have hSelfPair : ∀ (β₀ β₁ : Fin (c + 1)), β₀ = β₁ →
            ∀ (Q₀ : E_norm β₀) (Q₁ : E_norm β₁)
              (q₀ : PrimeSpectrum ↑((E_norm β₀).presheaf.obj
                (Opposite.op ((TopologicalSpace.Opens.map (ν β₀).base).obj (M.V a)))))
              (q₁ : PrimeSpectrum ↑((E_norm β₁).presheaf.obj
                (Opposite.op ((TopologicalSpace.Opens.map (ν β₁).base).obj (M.V a))))),
            (⟨β₀, Q₀⟩ : Σ γ : Fin (c + 1), E_norm γ) ≠ ⟨β₁, Q₁⟩ →
            IsClosed ({Q₀} : Set (E_norm β₀)) →
            IsClosed ({Q₁} : Set (E_norm β₁)) →
            B_self_div β₀ Q₀ = 1 →
            B_self_div β₁ Q₁ = 1 →
            (hAffW β₀ a).fromSpec.base q₀ = Q₀ →
            (hAffW β₁ a).fromSpec.base q₁ = Q₁ →
            ∃ s₀ s₁ : ∀ b : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V b))),
              IsWeilTricanonicalSection M ⊤ s₀ ∧
              IsWeilTricanonicalSection M ⊤ s₁ ∧
              ((ν β₀).app (M.V a)).hom (toVa s₀ a) ∈ q₀.asIdeal ∧
              ((ν β₀).app (M.V a)).hom (toVa s₀ a) ∉ q₀.asIdeal ^ 2 ∧
              ((ν β₁).app (M.V a)).hom (toVa s₀ a) ∈ q₁.asIdeal ^ 2 ∧
              ((ν β₀).app (M.V a)).hom (toVa s₁ a) ∈ q₀.asIdeal ^ 2 ∧
              ((ν β₁).app (M.V a)).hom (toVa s₁ a) ∈ q₁.asIdeal ∧
              ((ν β₁).app (M.V a)).hom (toVa s₁ a) ∉ q₁.asIdeal ^ 2 := by
          rintro β₀ _ rfl Q₀ Q₁ q₀ q₁ hne hQ₀ hQ₁ hB₀ hB₁ hq₀ hq₁
          have hQ_ne : Q₀ ≠ Q₁ := fun h => hne (congrArg (Sigma.mk β₀) h)
          obtain ⟨s₀, hs₀, h₀0, h₀1, h₀2⟩ :=
            hSelfBranch β₀ Q₀ Q₁ q₀ q₁ hQ_ne hQ₀ hQ₁ hB₀ hB₁ hq₀ hq₁
          obtain ⟨s₁, hs₁, h₁0, h₁1, h₁2⟩ :=
            hSelfBranch β₀ Q₁ Q₀ q₁ q₀ hQ_ne.symm hQ₁ hQ₀ hB₁ hB₀ hq₁ hq₀
          exact ⟨s₀, s₁, hs₀, hs₁, h₀0, h₀1, h₀2, h₁2, h₁0, h₁1⟩
        obtain ⟨s₀, s₁, hs₀, hs₁, hb₀_0, hb₀_n0, hb₀_1, hb₁_0, hb₁_1, hb₁_n1⟩ :=
          hSelfPair (α₀ r) (α₁ r) h₀₁ (P₀ r) (P₁ r) p₀ p₁
            (hNodes_data.2.1 r).2.2.2.2.2.1 hP₀_cl hP₁_cl hBs_P₀ hBs_P₁ hp₀ hp₁
        obtain ⟨hb₀_px, hb₁_px, hm_le⟩ :=
          hCot_nodal a p_x r p₀ p₁ (toVa s₀ a) (toVa s₁ a)
            hr.symm hp₀ hp₁ hb₀_0 hb₀_n0 hb₀_1 hb₁_0 hb₁_1 hb₁_n1
        refine le_trans hm_le (sup_le_sup_right (Ideal.span_le.mpr ?_) _)
        rintro _ (rfl | h_eq)
        · exact hVanSpan s₀ hs₀ hb₀_px
        · rw [Set.mem_singleton_iff] at h_eq
          rw [h_eq]
          exact hVanSpan s₁ hs₁ hb₁_px
      · 
        have hExtBranch : ∀ (α β : Fin (c + 1)), α ≠ β →
            ∀ (P : E_norm α)
              (p_α : PrimeSpectrum ↑((E_norm α).presheaf.obj
                (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)))))
              (p_β : PrimeSpectrum ↑((E_norm β).presheaf.obj
                (Opposite.op ((TopologicalSpace.Opens.map (ν β).base).obj (M.V a))))),
            IsClosed ({P} : Set (E_norm α)) →
            B_div α P = 1 →
            (hAffW α a).fromSpec.base p_α = P →
            ∃ s : ∀ b : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V b))),
              IsWeilTricanonicalSection M ⊤ s ∧
              ((ν α).app (M.V a)).hom (toVa s a) ∈ p_α.asIdeal ∧
              ((ν α).app (M.V a)).hom (toVa s a) ∉ p_α.asIdeal ^ 2 ∧
              ((ν β).app (M.V a)).hom (toVa s a) ∈ p_β.asIdeal ^ 2 := by
          intro α β hne P p_α p_β hP_cl hBP hp_α
          let E : E_norm α → ℤ := fun R => Δ_div α R - B_div α R
          have hE_noncl : ∀ R : E_norm α, ¬IsClosed ({R} : Set (E_norm α)) → E R = 0 := by
            intro R hR
            have hB0 : B_div α R = 0 := by
              rcases (hDiv_pt α R).1 with ⟨_, hcl, _⟩ | ⟨h0, _⟩
              · exact False.elim (hR hcl)
              · exact h0
            show Δ_div α R - B_div α R = 0
            rw [(hΔ_info α).1 R hR, hB0, sub_zero]
          have hE_fin : {R : E_norm α | E R ≠ 0}.Finite :=
            hSubFin (Δ_div α) (B_div α) (hΔ_info α).2.1 (hDiv_fin α).1
          have hE_deg : (2 : ℤ) * (g_E α : ℤ) ≤ (∑ᶠ R : E_norm α, E R) := by
            have h_sub : (∑ᶠ R : E_norm α, E R) =
                (∑ᶠ R : E_norm α, Δ_div α R) - (∑ᶠ R : E_norm α, B_div α R) :=
              finsum_sub_distrib (hΔ_info α).2.1 (hDiv_fin α).1
            have h_deg_α := (hDiv_deg α).2.1
            rw [h_sub, (hΔ_info α).2.2]
            omega
          obtain ⟨f_α, hf_pole, hf_P⟩ := hExactOrd α E P hE_noncl hE_fin hE_deg hP_cl
          obtain ⟨s, hs, hsec_α, hsec_ne, _⟩ := hBr_extB α f_α hf_pole
          have hp_α_cl : IsClosed ({(hAffW α a).fromSpec.base p_α} : Set (E_norm α)) := by
            rwa [hp_α]
          refine ⟨s, hs, ?_, ?_, ?_⟩
          · rw [(hValDict α a p_α s hp_α_cl hs).1, hp_α, hsec_α]
            have hEP : 1 - Δ_div α P = -(E P) := by
              show 1 - Δ_div α P = -(Δ_div α P - B_div α P)
              rw [hBP]; ring
            rw [hEP]
            exact hf_pole P hP_cl
          · rw [(hValDict α a p_α s hp_α_cl hs).2.1, hp_α, hsec_α]
            have hEP' : 2 - Δ_div α P = 1 - E P := by
              show 2 - Δ_div α P = 1 - (Δ_div α P - B_div α P)
              rw [hBP]; ring
            rw [hEP']
            exact hf_P
          · 
            let W_β := (TopologicalSpace.Opens.map (ν β).base).obj (M.V a)
            have hQ_mem : (hAffW β a).fromSpec.base p_β ∈ W_β := by
              change (hAffW β a).fromSpec.base p_β ∈ (W_β : Set (E_norm β))
              rw [← (hAffW β a).range_fromSpec]
              exact ⟨p_β, rfl⟩
            have ha_β : Nonempty ↥W_β := ⟨⟨_, hQ_mem⟩⟩
            obtain ⟨φ_β, _, hφ_β⟩ := (hE_comp β).2.2.2.2.2.2.2.2 W_β (hAffW β a) ha_β
            have h_pull_β := ((hBr_triv β a ha_β (hAffW β a)).2.2 s hs).2 φ_β hφ_β
            have hφ_β_inj := ((hRR_data β).2.2.2.1 W_β (hAffW β a) ha_β φ_β hφ_β).1
            have h_zero : ((ν β).app (M.V a)).hom (toVa s a) = 0 := by
              apply hφ_β_inj
              rw [h_pull_β, hsec_ne β (Ne.symm hne), zero_mul, map_zero]
            rw [h_zero]
            exact Ideal.zero_mem _
        have hB_P₀ : B_div (α₀ r) (P₀ r) = 1 := by
          rcases (hDiv_pt (α₀ r) (P₀ r)).1 with ⟨h1, _⟩ | ⟨_, hnot⟩
          · exact h1
          · exact False.elim (hnot ⟨r, (hNodes_data.2.1 r).2.2.2.1.symm⟩)
        have hB_P₁ : B_div (α₁ r) (P₁ r) = 1 := by
          rcases (hDiv_pt (α₁ r) (P₁ r)).1 with ⟨h1, _⟩ | ⟨_, hnot⟩
          · exact h1
          · exact False.elim (hnot ⟨r, (hNodes_data.2.1 r).2.2.2.2.1.symm⟩)
        obtain ⟨s₀, hs₀, hb₀_0, hb₀_n0, hb₀_1⟩ :=
          hExtBranch (α₀ r) (α₁ r) h₀₁ (P₀ r) p₀ p₁ hP₀_cl hB_P₀ hp₀
        obtain ⟨s₁, hs₁, hb₁_1, hb₁_n1, hb₁_0⟩ :=
          hExtBranch (α₁ r) (α₀ r) (Ne.symm h₀₁) (P₁ r) p₁ p₀ hP₁_cl hB_P₁ hp₁
        obtain ⟨hb₀_px, hb₁_px, hm_le⟩ :=
          hCot_nodal a p_x r p₀ p₁ (toVa s₀ a) (toVa s₁ a)
            hr.symm hp₀ hp₁ hb₀_0 hb₀_n0 hb₀_1 hb₁_0 hb₁_1 hb₁_n1
        refine le_trans hm_le (sup_le_sup_right (Ideal.span_le.mpr ?_) _)
        rintro _ (rfl | h_eq)
        · exact hVanSpan s₀ hs₀ hb₀_px
        · rw [Set.mem_singleton_iff] at h_eq
          rw [h_eq]
          exact hVanSpan s₁ hs₁ hb₁_px
    · 
      classical
      obtain ⟨⟨α, P⟩, hPx, _⟩ := (hNodes_data.2.2.1 x hx_node).2
      dsimp only at hPx
      have hP_cl : IsClosed ({P} : Set (E_norm α)) :=
        ((hE_comp α).2.2.2.2.2.2.1 P).mpr (by rwa [hPx])
      have hBs_P : B_self_div α P = 0 := by
        rcases (hDiv_pt α P).2.1 with ⟨_, _, r, _, _, hnr⟩ | ⟨h0, _⟩
        · rw [hPx] at hnr; exact False.elim (hx_node ⟨r, hnr.symm⟩)
        · exact h0
      obtain ⟨p_P, hp_P, _⟩ := hPullPrimes α P hPx
      let δ_P : E_norm α → ℤ := fun R => if R = P then 1 else 0
      let E : E_norm α → ℤ := fun R => Δ_div α R - B_self_div α R - δ_P R
      have hδ_fin : Function.HasFiniteSupport δ_P := hIndFin P
      have hΔBs_fin : Function.HasFiniteSupport (fun R => Δ_div α R - B_self_div α R) :=
        hSubFin (Δ_div α) (B_self_div α) (hΔ_info α).2.1 (hDiv_fin α).2.1
      have hE_noncl : ∀ R : E_norm α, ¬IsClosed ({R} : Set (E_norm α)) → E R = 0 := by
        intro R hR
        have hBs0 : B_self_div α R = 0 := by
          rcases (hDiv_pt α R).2.1 with ⟨_, hcl, _⟩ | ⟨h0, _⟩
          · exact False.elim (hR hcl)
          · exact h0
        have hRP : R ≠ P := fun h => hR (h ▸ hP_cl)
        show Δ_div α R - B_self_div α R - (if R = P then 1 else 0) = 0
        rw [(hΔ_info α).1 R hR, hBs0, if_neg hRP]; ring
      have hE_fin : {R : E_norm α | E R ≠ 0}.Finite :=
        hSubFin (fun R => Δ_div α R - B_self_div α R) δ_P hΔBs_fin hδ_fin
      have hE_deg : (2 : ℤ) * (g_E α : ℤ) ≤ (∑ᶠ R : E_norm α, E R) := by
        have h1 : (∑ᶠ R : E_norm α, E R) =
            (∑ᶠ R : E_norm α, (Δ_div α R - B_self_div α R)) - (∑ᶠ R : E_norm α, δ_P R) :=
          finsum_sub_distrib hΔBs_fin hδ_fin
        have h2 : (∑ᶠ R : E_norm α, (Δ_div α R - B_self_div α R)) =
            (∑ᶠ R : E_norm α, Δ_div α R) - (∑ᶠ R : E_norm α, B_self_div α R) :=
          finsum_sub_distrib (hΔ_info α).2.1 (hDiv_fin α).2.1
        have h3 : (∑ᶠ R : E_norm α, δ_P R) = 1 := by
          rw [finsum_eq_single δ_P P (fun R hRP => if_neg hRP)]
          simp [δ_P]
        have h_deg_α := (hDiv_deg α).2.2
        rw [h1, h2, h3, (hΔ_info α).2.2]
        omega
      obtain ⟨f_α, hf_pole, hf_P⟩ := hExactOrd α E P hE_noncl hE_fin hE_deg hP_cl
      have hf_Bs : ∀ R : E_norm α, IsClosed ({R} : Set (E_norm α)) →
          (-(Δ_div α R - B_self_div α R) : WithTop ℤ) ≤ ord α R f_α := by
        intro R hR
        have h_le : -(Δ_div α R - B_self_div α R) ≤ -(E R) := by
          dsimp only [E, δ_P]
          split_ifs <;> omega
        exact le_trans (WithTop.coe_le_coe.mpr h_le) (hf_pole R hR)
      obtain ⟨s, hs, hsec⟩ := hBr_extBself α f_α hf_Bs
      have hp_P_cl : IsClosed ({(hAffW α a).fromSpec.base p_P} : Set (E_norm α)) := by rwa [hp_P]
      have hb_in1 : ((ν α).app (M.V a)).hom (toVa s a) ∈ p_P.asIdeal := by
        rw [(hValDict α a p_P s hp_P_cl hs).1, hp_P, hsec]
        have hEP : 1 - Δ_div α P = -(E P) := by
          show 1 - Δ_div α P = -(Δ_div α P - B_self_div α P - (if P = P then 1 else 0))
          rw [hBs_P, if_pos rfl]; ring
        rw [hEP]
        exact hf_pole P hP_cl
      have hb_notin2 : ((ν α).app (M.V a)).hom (toVa s a) ∉ p_P.asIdeal ^ 2 := by
        rw [(hValDict α a p_P s hp_P_cl hs).2.1, hp_P, hsec]
        have hEP' : 2 - Δ_div α P = 1 - E P := by
          show 2 - Δ_div α P = 1 - (Δ_div α P - B_self_div α P - (if P = P then 1 else 0))
          rw [hBs_P, if_pos rfl]; ring
        rw [hEP']
        exact hf_P
      obtain ⟨hb_px, hm_le⟩ :=
        hCot_smooth a p_x α p_P (toVa s a) hx_cl hx_node (by rw [hp_P]; exact hPx) hb_in1 hb_notin2
      exact le_trans hm_le
        (sup_le_sup_right (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (hVanSpan s hs hb_px))) _)

theorem weil_nodal_tricanonical_active_pole_finiteness (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (M : WeilLineBundle C)
    (hAff : ∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a))
    (c δ : ℕ)
    (E_set : Fin (c + 1) → Set C)
    (E_norm : Fin (c + 1) → AlgebraicGeometry.Scheme.{u})
    (p_norm : ∀ α : Fin (c + 1), E_norm α ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (ν : ∀ α : Fin (c + 1), E_norm α ⟶ C)
    (F : Fin (c + 1) → Type u)
