          (β : WeilStrictMonoTuple r (p + 1))
          (hβ : Finset.univ.image β.1 = insert lam (Finset.univ.image ν.1))
          (j₀ : Fin (p + 2)) (hj₀ : β.1 j₀ = lam)
          (hle : U lam ⊓ weilCoverChartInter U ν ≤ weilCoverChartInter U β),
