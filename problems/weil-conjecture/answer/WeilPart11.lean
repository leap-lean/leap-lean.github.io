        right_inv := fun w => by
          ext j
          calc (∑ i : Fin (n₁ + 1), (∑ j' : Fin (n₂ + 1), w j' * colA j' i) * colB i j)
              = ∑ i : Fin (n₁ + 1), ∑ j' : Fin (n₂ + 1), w j' * (colA j' i * colB i j) := by
                refine Finset.sum_congr rfl fun i _ => ?_
                rw [Finset.sum_mul]
                refine Finset.sum_congr rfl fun j' _ => mul_assoc _ _ _
