          split_ifs <;> omega
        exact le_trans (by rw [hCoeNeg, hCoeNeg]
                           exact WithTop.coe_le_coe.mpr h_le_int) (hf P hP_cl)
      have h_exists_diff : ∃ f₀ : F β, f₀ ∈ LQ ∧ f₀ ∉ L' := by
        by_contra h_all
        push Not at h_all
        have h_eq_sub : L' = LQ := le_antisymm hL_le (fun f hf => h_all f hf)
        rw [hDQ_deg] at h_rkQ
        rw [h_eq_sub] at h_rk'
        omega
      obtain ⟨f₀, hf₀_in, hf₀_not⟩ := h_exists_diff
      have hDQ_le_Delta : ∀ P : E_norm β, D_Q P ≤ Δ_div β P := by
        intro P
        change (Δ_div β P - B_div β P) + (if P = Q then 1 else 0) ≤ Δ_div β P
