      intro v hv
      have h1v : (1 : F) * v ∈ E₀_inf := by rwa [one_mul]
      have h := hΦ_eq v 1 A₀.one_mem one_ne_zero h1v
      rw [one_mul] at h
      exact h.trans (hϕ₀_congr (1 * v) v h1v hv (one_mul v))
    let Φ : F →ₗ[↥K₀] ↥K₀ :=
      { toFun := fun u => ⟨Φ_F u, hΦ_K₀ u⟩
        map_add' := by
          intro u₁ u₂
          ext
          change Φ_F (u₁ + u₂) = Φ_F u₁ + Φ_F u₂
          let a₁ := a_ch u₁
          let a₂ := a_ch u₂
          have ha_A₀ : a₁ * a₂ ∈ A₀ := A₀.mul_mem (ha_ch_A₀ u₁) (ha_ch_A₀ u₂)
          have ha_ne : a₁ * a₂ ≠ 0 := mul_ne_zero (ha_ch_ne u₁) (ha_ch_ne u₂)
          obtain ⟨h_u₁', _⟩ := hϕ₀_A₀ a₂ (ha_ch_A₀ u₂) (a₁ * u₁) (ha_ch_mem u₁)
          obtain ⟨h_u₂', _⟩ := hϕ₀_A₀ a₁ (ha_ch_A₀ u₁) (a₂ * u₂) (ha_ch_mem u₂)
          have h_u₁ : (a₁ * a₂) * u₁ ∈ E₀_inf := by
            have heq : (a₁ * a₂) * u₁ = a₂ * (a₁ * u₁) := by ring
            rwa [heq]
          have h_u₂ : (a₁ * a₂) * u₂ ∈ E₀_inf := by
            have heq : (a₁ * a₂) * u₂ = a₁ * (a₂ * u₂) := by ring
            rwa [heq]
          have h_sum : (a₁ * a₂) * (u₁ + u₂) ∈ E₀_inf := by
            rw [mul_add]
            exact E₀_inf.add_mem h_u₁ h_u₂
          apply mul_left_cancel₀ ha_ne
          calc (a₁ * a₂) * Φ_F (u₁ + u₂)
              = ϕ₀ ((a₁ * a₂) * (u₁ + u₂)) h_sum :=
                  hΦ_eq (u₁ + u₂) (a₁ * a₂) ha_A₀ ha_ne h_sum
            _ = ϕ₀ ((a₁ * a₂) * u₁ + (a₁ * a₂) * u₂) (E₀_inf.add_mem h_u₁ h_u₂) :=
                  hϕ₀_congr _ _ h_sum (E₀_inf.add_mem h_u₁ h_u₂) (mul_add _ _ _)
            _ = ϕ₀ ((a₁ * a₂) * u₁) h_u₁ + ϕ₀ ((a₁ * a₂) * u₂) h_u₂ :=
                  hϕ₀_add _ _ h_u₁ h_u₂
            _ = (a₁ * a₂) * (Φ_F u₁ + Φ_F u₂) := by
                  rw [← hΦ_eq u₁ (a₁ * a₂) ha_A₀ ha_ne h_u₁,
                    ← hΦ_eq u₂ (a₁ * a₂) ha_A₀ ha_ne h_u₂, mul_add]
        map_smul' := by
          intro s u
          rw [RingHom.id_apply]
          ext
          change Φ_F (s • u) = (s • (⟨Φ_F u, hΦ_K₀ u⟩ : ↥K₀)).1
          have hsu : (s • u : F) = (s : F) * u := by
            rw [Algebra.smul_def, IntermediateField.algebraMap_apply]
          have hsΦ : (s • (⟨Φ_F u, hΦ_K₀ u⟩ : ↥K₀)).1 = (s : F) * Φ_F u := by
            rw [smul_eq_mul, MulMemClass.coe_mul]
          rw [hsu, hsΦ]
          obtain ⟨p, hp, q, hq, hq_ne, hqs⟩ := hK₀_frac s.1 s.2
          let a := a_ch u
          have haq_A₀ : a * q ∈ A₀ := A₀.mul_mem (ha_ch_A₀ u) hq
          have haq_ne : a * q ≠ 0 := mul_ne_zero (ha_ch_ne u) hq_ne
          obtain ⟨hpau, eq_pau⟩ := hϕ₀_A₀ p hp (a * u) (ha_ch_mem u)
          have h_su_eq : (a * q) * ((s : F) * u) = p * (a * u) := by
            calc (a * q) * ((s : F) * u) = (q * (s : F)) * (a * u) := by ring
              _ = p * (a * u) := by rw [hqs]
          have h_su : (a * q) * ((s : F) * u) ∈ E₀_inf := by
            rwa [h_su_eq]
          apply mul_left_cancel₀ haq_ne
          calc (a * q) * Φ_F ((s : F) * u)
              = ϕ₀ ((a * q) * ((s : F) * u)) h_su :=
                  hΦ_eq ((s : F) * u) (a * q) haq_A₀ haq_ne h_su
            _ = ϕ₀ (p * (a * u)) hpau := hϕ₀_congr _ _ h_su hpau h_su_eq
            _ = p * ϕ₀ (a * u) (ha_ch_mem u) := eq_pau
            _ = (q * (s : F)) * (a * Φ_F u) := by
                  rw [← hqs, hΦ_eq u a (ha_ch_A₀ u) (ha_ch_ne u) (ha_ch_mem u)]
            _ = (a * q) * ((s : F) * Φ_F u) := by ring }
    refine ⟨Φ, hΦ_on_M, ?_⟩
    intro Ψ hΨ
    apply LinearMap.ext
    intro u
    let a := a_ch u
    let a_K : ↥K₀ := ⟨a, hA₀_le_K₀ a (ha_ch_A₀ u)⟩
    have haK_ne : a_K ≠ 0 := by
      intro h0
      exact ha_ch_ne u (congrArg Subtype.val h0)
    have hsmul_eq : (a_K • u : F) = a * u := by
      rw [Algebra.smul_def, IntermediateField.algebraMap_apply]
    have hsmul_mem : a_K • u ∈ E₀_inf := by
      rw [hsmul_eq]
      exact ha_ch_mem u
    have h_eq_K₀ : a_K * Ψ u = a_K * Φ u := by
      calc a_K * Ψ u = Ψ (a_K • u) := by rw [map_smul, smul_eq_mul]
        _ = Φ (a_K • u) := hΨ (a_K • u) hsmul_mem
        _ = a_K * Φ u := by rw [map_smul, smul_eq_mul]
    exact mul_left_cancel₀ haK_ne h_eq_K₀
  
  let eTr : F ≃ₗ[↥K₀] Module.Dual ↥K₀ F :=
    (Algebra.traceForm ↥K₀ F).toDual (traceForm_nondegenerate ↥K₀ F)
  have heTr_symm : ∀ (Φ : Module.Dual ↥K₀ F) (u : F),
      Algebra.trace ↥K₀ F (eTr.symm Φ * u) = Φ u := by
    intro Φ u
    rw [← Algebra.traceForm_apply ↥K₀ (eTr.symm Φ) u]
    exact LinearMap.BilinForm.apply_toDual_symm_apply Φ u
  have hTrace_smul_K₀ : ∀ (s : F) (hs : s ∈ K₀) (w v : F),
      ((Algebra.trace ↥K₀ F (w * (s * v)) : ↥K₀) : F) =
        s * ((Algebra.trace ↥K₀ F (w * v) : ↥K₀) : F) := by
    intro s hs w v
    let s_K : ↥K₀ := ⟨s, hs⟩
    have hmul : w * (s * v) = s_K • (w * v) := by
      rw [Algebra.smul_def, IntermediateField.algebraMap_apply]
      change w * (s * v) = s * (w * v)
      ring
    rw [hmul, LinearMap.map_smul, smul_eq_mul, MulMemClass.coe_mul]
  have hTrace_smul_Ω : ∀ (c : Ω) (z : F),
      ((Algebra.trace ↥K₀ F (c • z) : ↥K₀) : F) =
        c • ((Algebra.trace ↥K₀ F z : ↥K₀) : F) := by
    intro c z
    rw [Algebra.smul_def, Algebra.smul_def]
    have h := hTrace_smul_K₀ (algebraMap Ω F c) (K₀.algebraMap_mem c) 1 z
    simpa only [one_mul] using h
  let S_0inf : Submodule Ω ↥E₀_inf := Submodule.comap E₀_inf.subtype (E₀ ⊔ E_inf)
  let β_tilde : ↥W_dual → (↥E₀_inf →ₗ[Ω] Ω) := fun w =>
    { toFun := fun v => res ((Algebra.trace ↥K₀ F (w.1 * v.1) : ↥K₀) : F)
      map_add' := by
        intro v₁ v₂
        change res ((Algebra.trace ↥K₀ F (w.1 * (v₁.1 + v₂.1)) : ↥K₀) : F) = _
        rw [mul_add, map_add, AddMemClass.coe_add, map_add]
      map_smul' := by
        intro c v
        rw [RingHom.id_apply]
        change res ((Algebra.trace ↥K₀ F (w.1 * (c • v.1)) : ↥K₀) : F) = _
        have hsmul : w.1 * (c • v.1) = c • (w.1 * v.1) := mul_smul_comm c w.1 v.1
