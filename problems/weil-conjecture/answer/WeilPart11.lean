  have hToBasic_char : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      (F : MvPolynomial (Fin (r₀ + 1)) Ω →+* ↑(Y.presheaf.obj (Opposite.op ⊤)))
      (k : Fin (r₀ + 1))
      (hXk : (MvPolynomial.X k : MvPolynomial (Fin (r₀ + 1)) Ω) ∈ 𝒜 1)
      (n : ℕ) (P : MvPolynomial (Fin (r₀ + 1)) Ω) (hP : P ∈ 𝒜 (n • 1)),
      let B := Y.basicOpen (F (MvPolynomial.X k))
      let R_away := CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X k))
      let ψ := ((AlgebraicGeometry.Scheme.ΓSpecIso R_away).inv ≫
        (AlgebraicGeometry.Proj.toBasicOpenOfGlobalSections 𝒜 F rfl zero_lt_one hXk ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X k) hXk zero_lt_one).hom).appTop).hom
      ψ (HomogeneousLocalization.Away.mk 𝒜 hXk n P hP) *
        (B.ι.appTop.hom (F (MvPolynomial.X k))) ^ n =
        B.ι.appTop.hom (F P) := by
