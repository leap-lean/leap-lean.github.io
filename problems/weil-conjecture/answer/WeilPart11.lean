          φ_V (φ_cov x) hφ_V (hφ_cov x)
        have hcy := hResCompat V (W_cov y) hV (hW_cov y) (le_trans hV_le inf_le_right)
          φ_V (φ_cov y) hφ_V (hφ_cov y)
        have hx_val := congrArg (fun g => g.hom (s_cov x)) hcx
        have hy_val := congrArg (fun g => g.hom (s_cov y)) hcy
        dsimp only [CommRingCat.hom_comp, RingHom.comp_apply] at hx_val hy_val
        rw [← E_sm.presheaf.map_comp_apply, ← E_sm.presheaf.map_comp_apply]
        change φ_V.hom ((E_sm.presheaf.map (CategoryTheory.homOfLE
            (le_trans hV_le inf_le_left)).op).hom (s_cov x)) =
          φ_V.hom ((E_sm.presheaf.map (CategoryTheory.homOfLE
            (le_trans hV_le inf_le_right)).op).hom (s_cov y))
        rw [hx_val, hy_val, hs_cov x, hs_cov y]
