                (X₁.presheaf.map (CategoryTheory.homOfLE
                  (inf_le_right : W_ab ≤ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b))).op).hom
                  ((f.app (⊤ ⊓ N₂.V b)).hom (s₂ b))) ∧
        (∀ (A : Type u) [CommRing A]
            (p₁ : X₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
            (p₂ : X₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of A)),
          f ≫ p₂ = p₁ →
          ∀ (k : ℕ) (d : Fin k → A)
            (t₂ : Fin k → ∀ b : Fin N₂.m, ↑(X₂.presheaf.obj (Opposite.op (⊤ ⊓ N₂.V b)))),
            (∀ j : Fin k, IsWeilTricanonicalSection N₂ ⊤ (t₂ j)) →
            ∀ a : Fin N₁.m,
              Φ (fun b => ∑ j : Fin k,
                (X₂.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ N₂.V b ≤ ⊤)).op).hom
                  (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ p₂.appTop).hom (d j)) *
                  t₂ j b) a =
              ∑ j : Fin k,
                (X₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ N₁.V a ≤ ⊤)).op).hom
                  (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ p₁.appTop).hom (d j)) *
                  Φ (t₂ j) a) := by
    intro X₁ X₂ f N₁ N₂ u hu_left hu_right
    classical
    have hEx : ∀ (s₂ : ∀ b : Fin N₂.m, ↑(X₂.presheaf.obj (Opposite.op (⊤ ⊓ N₂.V b)))),
        IsWeilTricanonicalSection N₂ ⊤ s₂ →
        ∀ a : Fin N₁.m,
          ∃ t_a : ↑(X₁.presheaf.obj (Opposite.op (⊤ ⊓ N₁.V a))),
            ∀ b : Fin N₂.m,
              let W_ab : X₁.Opens :=
                (⊤ ⊓ N₁.V a) ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b)
              (X₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_ab ≤ ⊤ ⊓ N₁.V a)).op).hom t_a =
                (u a b).val *
                  (X₁.presheaf.map (CategoryTheory.homOfLE
                    (inf_le_right : W_ab ≤ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b))).op).hom
                    ((f.app (⊤ ⊓ N₂.V b)).hom (s₂ b)) := by
      intro s₂ hs₂ a
      let V : X₁.Opens := ⊤ ⊓ N₁.V a
      let U : ULift.{u} (Fin N₂.m) → X₁.Opens :=
        fun b => V ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b.down)
      let iU : ∀ b : ULift.{u} (Fin N₂.m), U b ⟶ V :=
        fun _ => CategoryTheory.homOfLE inf_le_left
      have hCovU : V ≤ ⨆ b : ULift.{u} (Fin N₂.m), U b := by
        intro p hp
        have hfp : f.base p ∈ (Set.univ : Set X₂) := Set.mem_univ _
        rw [← N₂.hCov, Set.mem_iUnion] at hfp
        obtain ⟨b, hb⟩ := hfp
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨b⟩, ⟨hp, ⟨trivial, hb⟩⟩⟩
      let σ : ∀ b : ULift.{u} (Fin N₂.m), ↑(X₁.presheaf.obj (Opposite.op (U b))) :=
        fun b => (u a b.down).val *
          (X₁.presheaf.map (CategoryTheory.homOfLE
            (inf_le_right : U b ≤ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b.down))).op).hom
            ((f.app (⊤ ⊓ N₂.V b.down)).hom (s₂ b.down))
      have hCompat : TopCat.Presheaf.IsCompatible X₁.presheaf U σ := by
        intro b₁ b₂
        dsimp only [U, σ]
        set b := b₁.down
        set b' := b₂.down
        set W₁ : X₁.Opens := V ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b)
        set W₂ : X₁.Opens := V ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b')
        have hW_sub : W₁ ⊓ W₂ ≤ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ (N₂.V b ⊓ N₂.V b')) := by
          intro p hp
          exact ⟨trivial, hp.1.2.2, hp.2.2.2⟩
        have hs₂_pull := congrArg
          (fun z => (X₁.presheaf.map (CategoryTheory.homOfLE hW_sub).op).hom
            ((f.app (⊤ ⊓ (N₂.V b ⊓ N₂.V b'))).hom z))
          (hs₂ b b')
        simp only [map_mul, map_pow] at hs₂_pull
        have h_s_b : (X₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op).hom
            ((X₁.presheaf.map (CategoryTheory.homOfLE
              (inf_le_right : W₁ ≤ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b))).op).hom
              ((f.app (⊤ ⊓ N₂.V b)).hom (s₂ b))) =
            (X₁.presheaf.map (CategoryTheory.homOfLE hW_sub).op).hom
              ((f.app (⊤ ⊓ (N₂.V b ⊓ N₂.V b'))).hom
                ((X₂.presheaf.map (CategoryTheory.homOfLE (inf_le_inf_left ⊤ inf_le_left)).op).hom (s₂ b))) := by
          rw [res_res, res_app_res f (inf_le_inf_left ⊤ inf_le_left) hW_sub
            (le_trans inf_le_left inf_le_right)]
        have h_s_b' : (X₁.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op).hom
            ((X₁.presheaf.map (CategoryTheory.homOfLE
              (inf_le_right : W₂ ≤ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b'))).op).hom
              ((f.app (⊤ ⊓ N₂.V b')).hom (s₂ b'))) =
            (X₁.presheaf.map (CategoryTheory.homOfLE hW_sub).op).hom
              ((f.app (⊤ ⊓ (N₂.V b ⊓ N₂.V b'))).hom
                ((X₂.presheaf.map (CategoryTheory.homOfLE (inf_le_inf_left ⊤ inf_le_right)).op).hom (s₂ b'))) := by
          rw [res_res, res_app_res f (inf_le_inf_left ⊤ inf_le_right) hW_sub
            (le_trans inf_le_right inf_le_right)]
        have hW_u : W₁ ⊓ W₂ ≤ (TopologicalSpace.Opens.map f.base).obj (N₂.V b ⊓ N₂.V b') :=
          fun _ hp => ⟨hp.1.2.2, hp.2.2.2⟩
        have h_u_bb' : (X₁.presheaf.map (CategoryTheory.homOfLE hW_sub).op).hom
            ((f.app (⊤ ⊓ (N₂.V b ⊓ N₂.V b'))).hom
              ((X₂.presheaf.map (CategoryTheory.homOfLE
                (inf_le_right : ⊤ ⊓ (N₂.V b ⊓ N₂.V b') ≤ N₂.V b ⊓ N₂.V b')).op).hom (N₂.u b b').val)) =
            (X₁.presheaf.map (CategoryTheory.homOfLE hW_u).op).hom
              ((f.app (N₂.V b ⊓ N₂.V b')).hom (N₂.u b b').val) :=
          res_app_res f inf_le_right hW_sub hW_u (N₂.u b b').val
        change (X₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op).hom
            ((u a b).val * _) =
          (X₁.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op).hom
            ((u a b').val * _)
        rw [map_mul, map_mul, h_s_b, h_s_b', hs₂_pull, h_u_bb', ← mul_assoc, ← hu_right a b b']
      obtain ⟨t_a, ht_a, _⟩ := X₁.sheaf.existsUnique_gluing' U V iU hCovU σ hCompat
      exact ⟨t_a, fun b => ht_a ⟨b⟩⟩
    let Φ : (∀ b : Fin N₂.m, ↑(X₂.presheaf.obj (Opposite.op (⊤ ⊓ N₂.V b)))) →
        (∀ a : Fin N₁.m, ↑(X₁.presheaf.obj (Opposite.op (⊤ ⊓ N₁.V a)))) :=
      fun s₂ a => if hs₂ : IsWeilTricanonicalSection N₂ ⊤ s₂ then Classical.choose (hEx s₂ hs₂ a) else 0
    have hΦ_loc : ∀ s₂ (hs₂ : IsWeilTricanonicalSection N₂ ⊤ s₂) (a : Fin N₁.m) (b : Fin N₂.m),
        let W_ab : X₁.Opens := (⊤ ⊓ N₁.V a) ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b)
        (X₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_ab ≤ ⊤ ⊓ N₁.V a)).op).hom (Φ s₂ a) =
          (u a b).val *
            (X₁.presheaf.map (CategoryTheory.homOfLE
              (inf_le_right : W_ab ≤ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b))).op).hom
              ((f.app (⊤ ⊓ N₂.V b)).hom (s₂ b)) := by
      intro s₂ hs₂ a b
      dsimp only [Φ]
      simp only [hs₂, ↓reduceDIte]
      exact Classical.choose_spec (hEx s₂ hs₂ a) b
    have hΦ_tri : ∀ s₂, IsWeilTricanonicalSection N₂ ⊤ s₂ → IsWeilTricanonicalSection N₁ ⊤ (Φ s₂) := by
      intro s₂ hs₂ a a'
      apply hLocalExt f N₂ (⊤ ⊓ (N₁.V a ⊓ N₁.V a'))
      intro b
      set V_aa' : X₁.Opens := ⊤ ⊓ (N₁.V a ⊓ N₁.V a')
      set Z : X₁.Opens := V_aa' ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b)
      set W₁ : X₁.Opens := (⊤ ⊓ N₁.V a) ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b)
      set W₂ : X₁.Opens := (⊤ ⊓ N₁.V a') ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b)
      have hZW₁ : Z ≤ W₁ := fun p hp => ⟨⟨trivial, hp.1.2.1⟩, hp.2⟩
      have hZW₂ : Z ≤ W₂ := fun p hp => ⟨⟨trivial, hp.1.2.2⟩, hp.2⟩
      have hZW : Z ≤ W₁ ⊓ W₂ := le_inf hZW₁ hZW₂
      have hZ_aa' : Z ≤ N₁.V a ⊓ N₁.V a' := le_trans inf_le_left inf_le_right
      rw [res_res X₁ (inf_le_left : Z ≤ V_aa') (inf_le_inf_left ⊤ inf_le_left)
        (le_trans hZW₁ inf_le_left),
        ← res_res X₁ hZW₁ (inf_le_left : W₁ ≤ ⊤ ⊓ N₁.V a) (le_trans hZW₁ inf_le_left),
        hΦ_loc s₂ hs₂ a b, map_mul, res_res X₁ hZW₁ inf_le_right inf_le_right]
      rw [map_mul, map_pow,
        res_res X₁ (inf_le_left : Z ≤ V_aa') (inf_le_right : V_aa' ≤ N₁.V a ⊓ N₁.V a') hZ_aa',
        res_res X₁ (inf_le_left : Z ≤ V_aa') (inf_le_inf_left ⊤ inf_le_right)
          (le_trans hZW₂ inf_le_left),
        ← res_res X₁ hZW₂ (inf_le_left : W₂ ≤ ⊤ ⊓ N₁.V a') (le_trans hZW₂ inf_le_left),
        hΦ_loc s₂ hs₂ a' b, map_mul, res_res X₁ hZW₂ inf_le_right inf_le_right]
      have hu_Z := congrArg (X₁.presheaf.map (CategoryTheory.homOfLE hZW).op).hom (hu_left a a' b)
      simp only [map_mul, map_pow] at hu_Z
      rw [res_res X₁ hZW inf_le_left hZW₁, res_res X₁ hZW _ hZ_aa',
        res_res X₁ hZW inf_le_right hZW₂] at hu_Z
      rw [hu_Z, mul_assoc]
    refine ⟨Φ, hΦ_tri, hΦ_loc, ?_⟩
    intro A _ p₁ p₂ hfp k d t₂ ht₂ a
    let S₂ : ∀ b : Fin N₂.m, ↑(X₂.presheaf.obj (Opposite.op (⊤ ⊓ N₂.V b))) :=
      fun b => ∑ j : Fin k,
        (X₂.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ N₂.V b ≤ ⊤)).op).hom
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ p₂.appTop).hom (d j)) *
          t₂ j b
    have hS₂_tri : IsWeilTricanonicalSection N₂ ⊤ S₂ := by
      intro b b'
      simp only [S₂, map_sum, map_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [res_res X₂ _ _ le_top, res_res X₂ _ _ le_top, ht₂ j b b']
      ring
    apply hLocalExt f N₂ (⊤ ⊓ N₁.V a)
    intro b
    set W_ab : X₁.Opens := (⊤ ⊓ N₁.V a) ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b)
    rw [hΦ_loc S₂ hS₂_tri a b]
    simp only [S₂, map_sum, map_mul, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hΦ_loc (t₂ j) (ht₂ j) a b, res_res X₁ _ _ le_top,
      res_app_res f (inf_le_left : ⊤ ⊓ N₂.V b ≤ ⊤) inf_le_right le_top]
    have hp_top : (f.app ⊤).hom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ p₂.appTop).hom (d j)) =
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ p₁.appTop).hom (d j)) := by
      have hc : p₂.appTop ≫ f.appTop = p₁.appTop := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hfp]
      have hspec : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
          p₂.appTop ≫ f.appTop =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ p₁.appTop := by
        rw [hc]
      exact CategoryTheory.ConcreteCategory.congr_hom hspec (d j)
    change (u a b).val *
        ((X₁.presheaf.map (CategoryTheory.homOfLE le_top).op).hom ((f.app ⊤).hom _) * _) = _
    rw [hp_top]
    ring

  have hGlueInv : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (φ : X₁ ≅ X₂)
      (N₁ : WeilLineBundle X₁) (N₂ : WeilLineBundle X₂)
      (u : ∀ (a : Fin N₁.m) (b : Fin N₂.m),
        (↑(X₁.presheaf.obj (Opposite.op
          ((⊤ ⊓ N₁.V a) ⊓ (TopologicalSpace.Opens.map φ.hom.base).obj (⊤ ⊓ N₂.V b)))))ˣ)
      (v : ∀ (b : Fin N₂.m) (a : Fin N₁.m),
        (↑(X₂.presheaf.obj (Opposite.op
          ((⊤ ⊓ N₂.V b) ⊓ (TopologicalSpace.Opens.map φ.inv.base).obj (⊤ ⊓ N₁.V a)))))ˣ)
      (hu_inv : ∀ (a : Fin N₁.m) (b : Fin N₂.m)
        (h_ab : (⊤ ⊓ N₁.V a) ⊓ (TopologicalSpace.Opens.map φ.hom.base).obj (⊤ ⊓ N₂.V b) ≤
          (TopologicalSpace.Opens.map φ.hom.base).obj
            ((⊤ ⊓ N₂.V b) ⊓ (TopologicalSpace.Opens.map φ.inv.base).obj (⊤ ⊓ N₁.V a))),
        (u a b).val *
          (X₁.presheaf.map (CategoryTheory.homOfLE h_ab).op).hom
            ((φ.hom.app _).hom (v b a).val) = 1)
      (Φ : (∀ b : Fin N₂.m, ↑(X₂.presheaf.obj (Opposite.op (⊤ ⊓ N₂.V b)))) →
        (∀ a : Fin N₁.m, ↑(X₁.presheaf.obj (Opposite.op (⊤ ⊓ N₁.V a)))))
      (Ψ : (∀ a : Fin N₁.m, ↑(X₁.presheaf.obj (Opposite.op (⊤ ⊓ N₁.V a)))) →
        (∀ b : Fin N₂.m, ↑(X₂.presheaf.obj (Opposite.op (⊤ ⊓ N₂.V b))))),
      (∀ s₂, IsWeilTricanonicalSection N₂ ⊤ s₂ →
        ∀ (a : Fin N₁.m) (b : Fin N₂.m),
          let W_ab : X₁.Opens :=
            (⊤ ⊓ N₁.V a) ⊓ (TopologicalSpace.Opens.map φ.hom.base).obj (⊤ ⊓ N₂.V b)
          (X₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_ab ≤ ⊤ ⊓ N₁.V a)).op).hom
              (Φ s₂ a) =
            (u a b).val *
              (X₁.presheaf.map (CategoryTheory.homOfLE
                (inf_le_right : W_ab ≤ (TopologicalSpace.Opens.map φ.hom.base).obj (⊤ ⊓ N₂.V b))).op).hom
                ((φ.hom.app (⊤ ⊓ N₂.V b)).hom (s₂ b))) →
      (∀ s₁, IsWeilTricanonicalSection N₁ ⊤ s₁ → IsWeilTricanonicalSection N₂ ⊤ (Ψ s₁)) →
      (∀ s₁, IsWeilTricanonicalSection N₁ ⊤ s₁ →
        ∀ (b : Fin N₂.m) (a : Fin N₁.m),
          let W_ba : X₂.Opens :=
            (⊤ ⊓ N₂.V b) ⊓ (TopologicalSpace.Opens.map φ.inv.base).obj (⊤ ⊓ N₁.V a)
          (X₂.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_ba ≤ ⊤ ⊓ N₂.V b)).op).hom
              (Ψ s₁ b) =
            (v b a).val *
              (X₂.presheaf.map (CategoryTheory.homOfLE
                (inf_le_right : W_ba ≤ (TopologicalSpace.Opens.map φ.inv.base).obj (⊤ ⊓ N₁.V a))).op).hom
                ((φ.inv.app (⊤ ⊓ N₁.V a)).hom (s₁ a))) →
      ∀ s₁, IsWeilTricanonicalSection N₁ ⊤ s₁ → ∀ a : Fin N₁.m, Φ (Ψ s₁) a = s₁ a := by
    intro X₁ X₂ φ N₁ N₂ u v hu_inv Φ Ψ hΦ_loc hΨ_tri hΨ_loc s₁ hs₁ a
    apply hLocalExt φ.hom N₂ (⊤ ⊓ N₁.V a)
    intro b
    set W_ab : X₁.Opens := (⊤ ⊓ N₁.V a) ⊓ (TopologicalSpace.Opens.map φ.hom.base).obj (⊤ ⊓ N₂.V b)
    set W_ba : X₂.Opens := (⊤ ⊓ N₂.V b) ⊓ (TopologicalSpace.Opens.map φ.inv.base).obj (⊤ ⊓ N₁.V a)
    have h_ab : W_ab ≤ (TopologicalSpace.Opens.map φ.hom.base).obj W_ba := by
      intro p hp
      refine ⟨hp.2, ?_⟩
      have hid_p : (φ.hom ≫ φ.inv).base p = p := by rw [φ.hom_inv_id]; rfl
      change (φ.hom ≫ φ.inv).base p ∈ ⊤ ⊓ N₁.V a
      rw [hid_p]
      exact hp.1
    rw [hΦ_loc (Ψ s₁) (hΨ_tri s₁ hs₁) a b,
      ← res_app_res φ.hom (inf_le_left : W_ba ≤ ⊤ ⊓ N₂.V b) h_ab inf_le_right,
      hΨ_loc s₁ hs₁ b a, map_mul, map_mul,
      res_app_res φ.hom (inf_le_right : W_ba ≤ (TopologicalSpace.Opens.map φ.inv.base).obj (⊤ ⊓ N₁.V a))
        h_ab (le_trans h_ab ((TopologicalSpace.Opens.map φ.hom.base).monotone inf_le_right)),
      res_id_app φ.hom φ.inv φ.hom_inv_id _ (inf_le_left : W_ab ≤ ⊤ ⊓ N₁.V a),
      ← mul_assoc, hu_inv a b h_ab, one_mul]

  
  have hCubeUnits : ∀ {X₁ X₂ Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (fst₁ : X₁ ⟶ Y₁) (fst₂ : X₂ ⟶ Y₂) (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₁)
      (hfg : f ≫ g = 𝟙 X₁)
      (B₁ : WeilLineBundle Y₁) (B₂ : WeilLineBundle Y₂)
      (N₁ : WeilLineBundle X₁) (e₁ : Fin N₁.m ≃ Fin B₁.m)
      (hV₁ : ∀ a : Fin N₁.m, N₁.V a = (TopologicalSpace.Opens.map fst₁.base).obj (B₁.V (e₁ a)))
      (hU₁ : ∀ a a' : Fin N₁.m,
        ∀ hEq : N₁.V a ⊓ N₁.V a' =
            (TopologicalSpace.Opens.map fst₁.base).obj (B₁.V (e₁ a) ⊓ B₁.V (e₁ a')),
          (X₁.presheaf.map (CategoryTheory.homOfLE (le_of_eq hEq.symm)).op).hom (N₁.u a a').val =
            (fst₁.app (B₁.V (e₁ a) ⊓ B₁.V (e₁ a'))).hom (B₁.u (e₁ a) (e₁ a')).val)
      (N₂ : WeilLineBundle X₂) (e₂ : Fin N₂.m ≃ Fin B₂.m)
      (hV₂ : ∀ b : Fin N₂.m, N₂.V b = (TopologicalSpace.Opens.map fst₂.base).obj (B₂.V (e₂ b)))
      (hU₂ : ∀ b b' : Fin N₂.m,
        ∀ hEq : N₂.V b ⊓ N₂.V b' =
            (TopologicalSpace.Opens.map fst₂.base).obj (B₂.V (e₂ b) ⊓ B₂.V (e₂ b')),
          (X₂.presheaf.map (CategoryTheory.homOfLE (le_of_eq hEq.symm)).op).hom (N₂.u b b').val =
            (fst₂.app (B₂.V (e₂ b) ⊓ B₂.V (e₂ b'))).hom (B₂.u (e₂ b) (e₂ b')).val)
      (α₀ : ∀ (a₀ : Fin B₁.m) (b₀ : Fin B₂.m),
        (↑(X₁.presheaf.obj (Opposite.op
          ((TopologicalSpace.Opens.map fst₁.base).obj (B₁.V a₀) ⊓
            (TopologicalSpace.Opens.map (f ≫ fst₂).base).obj (B₂.V b₀)))))ˣ)
      (β₀ : ∀ (b₀ : Fin B₂.m) (a₀ : Fin B₁.m),
        (↑(X₂.presheaf.obj (Opposite.op
          ((TopologicalSpace.Opens.map fst₂.base).obj (B₂.V b₀) ⊓
            (TopologicalSpace.Opens.map (g ≫ fst₁).base).obj (B₁.V a₀)))))ˣ)
      (hL₀ : ∀ (a₀ a₀' : Fin B₁.m) (b₀ : Fin B₂.m),
        let O₁ : X₁.Opens := (TopologicalSpace.Opens.map fst₁.base).obj (B₁.V a₀) ⊓
          (TopologicalSpace.Opens.map (f ≫ fst₂).base).obj (B₂.V b₀)
        let O₂ : X₁.Opens := (TopologicalSpace.Opens.map fst₁.base).obj (B₁.V a₀') ⊓
          (TopologicalSpace.Opens.map (f ≫ fst₂).base).obj (B₂.V b₀)
        let h_u : O₁ ⊓ O₂ ≤ (TopologicalSpace.Opens.map fst₁.base).obj (B₁.V a₀ ⊓ B₁.V a₀') :=
          inf_le_inf inf_le_left inf_le_left
        (X₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : O₁ ⊓ O₂ ≤ O₁)).op).hom
            (α₀ a₀ b₀).val =
          (X₁.presheaf.map (CategoryTheory.homOfLE h_u).op).hom
            ((fst₁.app (B₁.V a₀ ⊓ B₁.V a₀')).hom (B₁.u a₀ a₀').val) *
            (X₁.presheaf.map (CategoryTheory.homOfLE (inf_le_right : O₁ ⊓ O₂ ≤ O₂)).op).hom
              (α₀ a₀' b₀).val)
      (hR₀ : ∀ (a₀ : Fin B₁.m) (b₀ b₀' : Fin B₂.m),
        let O₁ : X₁.Opens := (TopologicalSpace.Opens.map fst₁.base).obj (B₁.V a₀) ⊓
          (TopologicalSpace.Opens.map (f ≫ fst₂).base).obj (B₂.V b₀)
        let O₂ : X₁.Opens := (TopologicalSpace.Opens.map fst₁.base).obj (B₁.V a₀) ⊓
          (TopologicalSpace.Opens.map (f ≫ fst₂).base).obj (B₂.V b₀')
