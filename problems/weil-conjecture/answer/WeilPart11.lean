        have hθ_max : ∀ z : O_x, z ∈ m_x ↔ θ z ∈ 𝔪 := by
          intro z
          change z ∈ IsLocalRing.maximalIdeal O_x ↔ θ z ∈ IsLocalRing.maximalIdeal S_p
          rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
            mem_nonunits_iff]
          exact not_congr ⟨fun hu => hu.map θ.toRingHom,
            fun hu => by simpa using hu.map θ.symm.toRingHom⟩
        have hBridge_T : ∀ (n : ℕ) (P : MvPolynomial (Fin (r₀ + 1)) Ω) (hP : P ∈ 𝒜 (n • 1)),
            res_S (φ_k (HomogeneousLocalization.Away.mk 𝒜 hXk n P hP)) *
              (res_A (e'_Va k a)) ^ n =
            res_A (MvPolynomial.eval₂ (φ_Ω_Va a) (fun i => e'_Va i a) P) := by
          intro n P hP
          obtain ⟨f_a, hf_a, hfC, hfX, hj_a⟩ := hProjM a
          let W_a : C.Opens := ⊤ ⊓ M.V a
          have hWa_j₀ : W_a.ι ≫ j₀ = AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f_a hf_a := by
            dsimp only [j₀]
            have hι : W_a.ι ≫ C.topIso.inv = C.homOfLE (inf_le_left : W_a ≤ ⊤) := by
              rw [← cancel_mono C.topIso.hom, CategoryTheory.Category.assoc, Iso.inv_hom_id,
                CategoryTheory.Category.comp_id, C.topIso_hom, C.homOfLE_ι]
            rw [← CategoryTheory.Category.assoc, hι, hj_a]
          let B_Wa : W_a.toScheme.Opens := W_a.toScheme.basicOpen (f_a X_k)
          have hPre_Wa := AlgebraicGeometry.Proj.fromOfGlobalSections_preimage_basicOpen 𝒜 f_a hf_a zero_lt_one hXk
          have hBW : B_inter ≤ W_a := le_inf le_top hBA_le
          have hB_le_BWa : (⊤ : B_inter.toScheme.Opens) ≤
              (TopologicalSpace.Opens.map (C.homOfLE hBW).base).obj B_Wa := by
            intro z _
            have hEqPre : B_Wa = (TopologicalSpace.Opens.map (W_a.ι ≫ j₀).base).obj D_k := by
              rw [hWa_j₀]; exact hPre_Wa.symm
            rw [hEqPre]
            change j₀.base ((C.homOfLE hBW ≫ W_a.ι).base z) ∈ D_k
            rw [C.homOfLE_ι]
            exact (C.basicOpen_le f_S) z.2
          let ι_B_BWa : B_inter.toScheme ⟶ B_Wa.toScheme :=
            B_inter.toScheme.topIso.inv ≫
              AlgebraicGeometry.Scheme.Hom.resLE (C.homOfLE hBW) B_Wa ⊤ hB_le_BWa
          have hι_BWa : ι_B_BWa ≫ B_Wa.ι = C.homOfLE hBW := by
            dsimp only [ι_B_BWa]
            rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
              ← B_inter.toScheme.topIso_hom, Iso.inv_hom_id_assoc]
          have hSq_Dk : ι_B_BWa ≫
              AlgebraicGeometry.Proj.toBasicOpenOfGlobalSections 𝒜 f_a rfl zero_lt_one hXk =
              C.homOfLE (C.basicOpen_le f_S) ≫ j_k := by
            rw [← AlgebraicGeometry.Proj.fromOfGlobalSections_resLE 𝒜 f_a hf_a zero_lt_one hXk,
              ← cancel_mono D_k.ι]
            calc (ι_B_BWa ≫ AlgebraicGeometry.Scheme.Hom.resLE
                  (AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f_a hf_a) D_k B_Wa _) ≫ D_k.ι
                = ι_B_BWa ≫ (AlgebraicGeometry.Scheme.Hom.resLE
                    (AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f_a hf_a) D_k B_Wa _ ≫ D_k.ι) :=
                      CategoryTheory.Category.assoc _ _ _
              _ = (ι_B_BWa ≫ B_Wa.ι) ≫ AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f_a hf_a := by
                    rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
                      ← CategoryTheory.Category.assoc ι_B_BWa]
              _ = C.homOfLE hBW ≫ (W_a.ι ≫ j₀) := by rw [hι_BWa, ← hWa_j₀]
              _ = (C.homOfLE hBW ≫ W_a.ι) ≫ j₀ := (CategoryTheory.Category.assoc _ _ _).symm
              _ = B_inter.ι ≫ j₀ := by rw [C.homOfLE_ι]
              _ = (C.homOfLE (C.basicOpen_le f_S) ≫ U_k.ι) ≫ j₀ := by rw [C.homOfLE_ι]
              _ = C.homOfLE (C.basicOpen_le f_S) ≫ (U_k.ι ≫ j₀) :=
                    CategoryTheory.Category.assoc _ _ _
              _ = (C.homOfLE (C.basicOpen_le f_S) ≫ j_k) ≫ D_k.ι := by
                    dsimp only [j_k]
                    rw [← AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
          have hc := hToBasic_char f_a k hXk n P hP
          let ρ_B : ↑(B_Wa.toScheme.presheaf.obj (Opposite.op ⊤)) →+* T_inter :=
            (ι_B_BWa.appTop ≫ B_inter.topIso.hom).hom
          have hc_B := congrArg ρ_B hc
          rw [map_mul, map_pow] at hc_B
          have hTerm1 : ρ_B (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_k)).inv ≫
              (AlgebraicGeometry.Proj.toBasicOpenOfGlobalSections 𝒜 f_a rfl zero_lt_one hXk ≫
                isoSpec_Dk.hom).appTop).hom (HomogeneousLocalization.Away.mk 𝒜 hXk n P hP)) =
              res_S (φ_k (HomogeneousLocalization.Away.mk 𝒜 hXk n P hP)) := by
            have hMorEq : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_k)).inv ≫
                ((ι_B_BWa ≫ AlgebraicGeometry.Proj.toBasicOpenOfGlobalSections 𝒜 f_a rfl zero_lt_one hXk) ≫
                  isoSpec_Dk.hom).appTop ≫ B_inter.topIso.hom =
                φ_k_cat ≫ res_S_cat := by
              rw [hSq_Dk]
              dsimp only [φ_k_cat, e_Rk, Iso.trans_hom, Iso.symm_hom, Scheme.Hom.comp_appTop]
              simp only [CategoryTheory.Category.assoc]
              congr 3
              rw [AlgebraicGeometry.Scheme.homOfLE_appTop,
                AlgebraicGeometry.Scheme.Opens.topIso_hom,
                AlgebraicGeometry.Scheme.Opens.topIso_hom]
              erw [← C.presheaf.map_comp, ← C.presheaf.map_comp]
              rfl
            have hApp := congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk 𝒜 hXk n P hP)) hMorEq
            dsimp only [ρ_B, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at hApp ⊢
            exact hApp
          have hEval_Wa : ∀ Q : MvPolynomial (Fin (r₀ + 1)) Ω,
              ρ_B (B_Wa.ι.appTop.hom (f_a Q)) =
                res_A (MvPolynomial.eval₂ (φ_Ω_Va a) (fun i => e'_Va i a) Q) := by
            have hComp_Wa : B_Wa.ι.appTop ≫ ι_B_BWa.appTop ≫ B_inter.topIso.hom =
                W_a.topIso.hom ≫ C.presheaf.map (CategoryTheory.homOfLE hBW).op := by
              rw [← CategoryTheory.Category.assoc, ← Scheme.Hom.comp_appTop, hι_BWa,
                AlgebraicGeometry.Scheme.homOfLE_appTop,
                AlgebraicGeometry.Scheme.Opens.topIso_hom,
                AlgebraicGeometry.Scheme.Opens.topIso_hom]
              erw [← C.presheaf.map_comp, ← C.presheaf.map_comp]
              rfl
            intro Q
            have h1 := congrArg (fun φ => φ.hom (f_a Q)) hComp_Wa
            dsimp only [ρ_B, CommRingCat.hom_comp, RingHom.comp_apply] at h1 ⊢
            rw [h1]
            have hSplit : C.presheaf.map (CategoryTheory.homOfLE hBW).op =
                C.presheaf.map (CategoryTheory.homOfLE (le_inf le_top (le_refl (M.V a)))).op ≫
                  res_A_cat := by
              rw [← C.presheaf.map_comp]; rfl
            rw [hSplit]
            dsimp only [CommRingCat.hom_comp, RingHom.comp_apply]
            congr 1
            let σ_Va : ↑(W_a.toScheme.presheaf.obj (Opposite.op ⊤)) →+* A_a :=
              ((C.presheaf.map (CategoryTheory.homOfLE (le_inf le_top (le_refl (M.V a)))).op).hom).comp
                W_a.topIso.hom.hom
            change (σ_Va.comp f_a) Q = MvPolynomial.eval₂Hom (φ_Ω_Va a) (fun i => e'_Va i a) Q
            congr 1
            apply MvPolynomial.ringHom_ext
            · intro d
              simp only [σ_Va, RingHom.comp_apply, hfC, MvPolynomial.eval₂Hom_C]
              have hInvHom : W_a.topIso.hom.hom (W_a.topIso.inv.hom
                  ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_a ≤ ⊤)).op).hom (φ_Ω d))) =
                  (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_a ≤ ⊤)).op).hom (φ_Ω d) :=
                congrArg (fun φ => φ.hom
                  ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_a ≤ ⊤)).op).hom (φ_Ω d)))
                  W_a.topIso.inv_hom_id
              rw [hInvHom, hφ_compat]
            · intro i
              simp only [σ_Va, RingHom.comp_apply, hfX, MvPolynomial.eval₂Hom_X']
              have hInvHom : W_a.topIso.hom.hom (W_a.topIso.inv.hom (e' i a)) = e' i a :=
                congrArg (fun φ => φ.hom (e' i a)) W_a.topIso.inv_hom_id
              rw [hInvHom]
          rw [hTerm1, hEval_Wa X_k, hEval_Wa P] at hc_B
          simpa [X_k] using hc_B
        obtain ⟨c_val, hc_mem, hc_span⟩ := hCot a p_x k he_not_mem (by rwa [hpx_eq])
        let P_lin : Fin (r₀ + 1) → MvPolynomial (Fin (r₀ + 1)) Ω :=
          fun i => MvPolynomial.X i - c_val i • X_k
        have hP_lin : ∀ i : Fin (r₀ + 1), P_lin i ∈ 𝒜 (1 • 1) := by
          intro i
          simpa using (𝒜 1).sub_mem (MvPolynomial.isHomogeneous_X Ω i)
            ((𝒜 1).smul_mem (c_val i) hXk)
        let r_gen : Fin (r₀ + 1) → R_k :=
          fun i => HomogeneousLocalization.Away.mk 𝒜 hXk 1 (P_lin i) (hP_lin i)
        let gen_Ox : Fin (r₀ + 1) → O_x :=
          fun i => IsLocalization.mk' O_x (e'_Va i a) (⟨e'_Va k a, he_not_mem⟩ : p_x.asIdeal.primeCompl) -
            algebraMap A_a O_x (φ_Ω_Va a (c_val i))
        have hθ_gen : ∀ i : Fin (r₀ + 1),
            algebraMap S_k S_p (φ_k (r_gen i)) = θ (gen_Ox i) := by
          intro i
          have hUnit_ek : IsUnit (θ (algebraMap A_a O_x (e'_Va k a))) :=
            (IsLocalization.map_units O_x (⟨e'_Va k a, he_not_mem⟩ : p_x.asIdeal.primeCompl)).map θ
          apply hUnit_ek.mul_right_cancel
          have hBr := congrArg α_TS (hBridge_T 1 (P_lin i) (hP_lin i))
          have hαS_apply : ∀ s : S_k, α_TS (res_S s) = algebraMap S_k S_p s :=
            fun s => congrFun (congrArg DFunLike.coe hα_TS) s
          rw [map_mul, pow_one, hαS_apply, ← hθ_A, ← hθ_A] at hBr
          rw [hBr, ← map_mul]
          congr 1
          dsimp only [P_lin, gen_Ox, X_k]
          have hSmul : (c_val i • (MvPolynomial.X k : MvPolynomial (Fin (r₀ + 1)) Ω)) =
              MvPolynomial.C (c_val i) * MvPolynomial.X k := Algebra.smul_def _ _
          rw [hSmul]
          simp only [MvPolynomial.eval₂_sub, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C,
            MvPolynomial.eval₂_X, map_sub, map_mul, sub_mul]
          congr 1
          exact (IsLocalization.mk'_spec O_x (e'_Va i a) ⟨e'_Va k a, he_not_mem⟩).symm
        let 𝔭 : Ideal R_p := IsLocalRing.maximalIdeal R_p
        let J : Ideal S_p := Ideal.map ψ_loc 𝔭
        have hr_in_J : ∀ i : Fin (r₀ + 1), θ (gen_Ox i) ∈ J := by
          intro i
          have hIn_𝔪 : algebraMap S_k S_p (φ_k (r_gen i)) ∈ 𝔪 := by
            rw [hθ_gen i]
            exact (hθ_max (gen_Ox i)).mp (hc_mem i)
          have hφr_m₀ : φ_k (r_gen i) ∈ m₀ := by
            rw [← IsLocalization.AtPrime.under_maximalIdeal S_p m₀]
            exact hIn_𝔪
          have hr_p : r_gen i ∈ p := hm₀_over ▸ hφr_m₀
          have hr_𝔭 : algebraMap R_k R_p (r_gen i) ∈ 𝔭 :=
            (IsLocalization.AtPrime.to_map_mem_maximal_iff R_p p (r_gen i)).mpr hr_p
          have hEqMap : θ (gen_Ox i) = ψ_loc (algebraMap R_k R_p (r_gen i)) := by
            rw [← hθ_gen i]
            exact (hψ_loc_eq (r_gen i)).symm
          rw [hEqMap]
          exact Ideal.mem_map_of_mem ψ_loc hr_𝔭
        have h𝔪_le_J_smul : 𝔪 ≤ J ⊔ 𝔪 • 𝔪 := by
          intro w hw
          have hw_Ox : θ.symm w ∈ m_x := by
            rw [hθ_max, RingEquiv.apply_symm_apply]
            exact hw
          have hw_span := hc_span hw_Ox
          have hMapLe : Ideal.map θ.toRingHom
              (Ideal.span (Set.range gen_Ox) ⊔ m_x ^ 2) ≤ J ⊔ 𝔪 ^ 2 := by
            rw [Ideal.map_sup, Ideal.map_pow]
            apply sup_le_sup
            · rw [Ideal.map_span, Ideal.span_le]
              rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
              exact hr_in_J i
            · apply pow_le_pow_left'
              rw [Ideal.map_le_iff_le_comap]
              intro z hz
              exact (hθ_max z).mp hz
          have hw_in : w ∈ Ideal.map θ.toRingHom (Ideal.span (Set.range gen_Ox) ⊔ m_x ^ 2) := by
            have hMem : θ.toRingHom (θ.symm w) ∈
                Ideal.map θ.toRingHom (Ideal.span (Set.range gen_Ox) ⊔ m_x ^ 2) :=
              Ideal.mem_map_of_mem θ.toRingHom hw_span
            change θ (θ.symm w) ∈ _ at hMem
            rwa [RingEquiv.apply_symm_apply] at hMem
          have hw_J2 : w ∈ J ⊔ 𝔪 ^ 2 := hMapLe hw_in
          rwa [pow_two, ← smul_eq_mul] at hw_J2
        have h𝔪_FG : (𝔪 : Submodule S_p S_p).FG := IsNoetherian.noetherian 𝔪
        have h𝔪_le_J : 𝔪 ≤ J :=
          Submodule.le_of_le_smul_of_le_jacobson_bot h𝔪_FG
            (IsLocalRing.maximalIdeal_le_jacobson _) h𝔪_le_J_smul
        let N_im : Submodule R_p S_p := LinearMap.range (Algebra.linearMap R_p S_p)
        have hConst_in_Nim : ∀ d : Ω, θ (algebraMap A_a O_x (φ_Ω_Va a d)) ∈ N_im := by
          intro d
          have hCd : (MvPolynomial.C d : MvPolynomial (Fin (r₀ + 1)) Ω) ∈ 𝒜 (0 • 1) := by
            rw [zero_smul]
            exact MvPolynomial.isHomogeneous_C (Fin (r₀ + 1)) d
          let r_d : R_k := HomogeneousLocalization.Away.mk 𝒜 hXk 0 (MvPolynomial.C d) hCd
          have hBr0 := congrArg α_TS (hBridge_T 0 (MvPolynomial.C d) hCd)
          have hαS_apply : ∀ s : S_k, α_TS (res_S s) = algebraMap S_k S_p s :=
            fun s => congrFun (congrArg DFunLike.coe hα_TS) s
          rw [pow_zero, mul_one, hαS_apply, MvPolynomial.eval₂_C, ← hθ_A] at hBr0
          refine ⟨algebraMap R_k R_p r_d, ?_⟩
          change ψ_loc (algebraMap R_k R_p r_d) = θ (algebraMap A_a O_x (φ_Ω_Va a d))
          rw [hψ_loc_eq r_d, hBr0]
        have hJ_le_smul : ∀ u ∈ J, u ∈ 𝔭 • (⊤ : Submodule R_p S_p) := by
          let M_smul : Submodule R_p S_p := 𝔭 • (⊤ : Submodule R_p S_p)
          let I_smul : Ideal S_p :=
            { carrier := (M_smul : Set S_p)
              add_mem' := fun hx hy => M_smul.add_mem hx hy
              zero_mem' := M_smul.zero_mem
              smul_mem' := by
                intro s u₁ hu₁
                rw [smul_eq_mul]
                change s * u₁ ∈ M_smul
                refine Submodule.smul_induction_on hu₁ ?_ ?_
                · intro r hr y _
                  have hMulSmul : s * (r • y) = r • (s * y) := by
                    change s * (ψ_loc r * y) = ψ_loc r * (s * y)
                    ring
                  rw [hMulSmul]
                  exact Submodule.smul_mem_smul hr trivial
                · intro x₁ x₂ hx₁ hx₂
                  rw [mul_add]
                  exact M_smul.add_mem hx₁ hx₂ }
          have hJ_le_I : J ≤ I_smul := by
            dsimp only [J]
            rw [Ideal.map, Ideal.span_le]
            rintro _ ⟨r, hr, rfl⟩
            show ψ_loc r ∈ M_smul
            have hSmul : ψ_loc r = r • (1 : S_p) := by
              change ψ_loc r = ψ_loc r * 1
              rw [mul_one]
            rw [hSmul]
            exact Submodule.smul_mem_smul hr trivial
          exact fun u hu => hJ_le_I hu
        have hTop_le : (⊤ : Submodule R_p S_p) ≤ N_im ⊔ 𝔭 • (⊤ : Submodule R_p S_p) := by
          intro w _
          have hMax_px : p_x.asIdeal.IsMaximal :=
            AlgebraicGeometry.IsAffineOpen.primeIdealOf_isMaximal_of_isClosed (hAff a) ⟨x, hx_a⟩ hx_closed
          let _ : p_x.asIdeal.IsMaximal := hMax_px
          have hRes_px := hNullstellensatz_C (M.V a) (hAff a) p_x.asIdeal
          obtain ⟨⟨b, ⟨u, hu⟩⟩, hbu⟩ := IsLocalization.surj p_x.asIdeal.primeCompl (θ.symm w)
          obtain ⟨d_b, hdb⟩ := hRes_px b
          obtain ⟨d_u, hdu⟩ := hRes_px u
          have hdu_ne : d_u ≠ 0 := by
            intro h0
            rw [h0, map_zero, sub_zero] at hdu
            exact hu hdu
          let d : Ω := d_b * d_u⁻¹
          have hDiff_mx : θ.symm w - algebraMap A_a O_x (φ_Ω_Va a d) ∈ m_x := by
            have hw_mk : θ.symm w = IsLocalization.mk' O_x b ⟨u, hu⟩ := by
              apply (IsLocalization.map_units O_x (⟨u, hu⟩ : p_x.asIdeal.primeCompl)).mul_right_cancel
              rw [hbu, IsLocalization.mk'_spec]
            rw [hw_mk]
            have hNum_px : b - φ_Ω_Va a d * u ∈ p_x.asIdeal := by
              have hId : b - φ_Ω_Va a d * u =
                  (b - φ_Ω_Va a d_b) - φ_Ω_Va a d * (u - φ_Ω_Va a d_u) := by
                have hdu_inv : d * d_u = d_b := by
                  dsimp only [d]; exact inv_mul_cancel_right₀ hdu_ne d_b
                calc b - φ_Ω_Va a d * u
                    = (b - φ_Ω_Va a d * φ_Ω_Va a d_u) - φ_Ω_Va a d * (u - φ_Ω_Va a d_u) := by ring
                  _ = (b - φ_Ω_Va a (d * d_u)) - φ_Ω_Va a d * (u - φ_Ω_Va a d_u) := by
                        rw [map_mul (φ_Ω_Va a) d d_u]
                  _ = (b - φ_Ω_Va a d_b) - φ_Ω_Va a d * (u - φ_Ω_Va a d_u) := by rw [hdu_inv]
              rw [hId]
              exact p_x.asIdeal.sub_mem hdb (p_x.asIdeal.mul_mem_left _ hdu)
            have hEqMk : IsLocalization.mk' O_x b ⟨u, hu⟩ - algebraMap A_a O_x (φ_Ω_Va a d) =
                algebraMap A_a O_x (b - φ_Ω_Va a d * u) *
                  (IsLocalization.mk' O_x 1 ⟨u, hu⟩) := by
              apply (IsLocalization.map_units O_x (⟨u, hu⟩ : p_x.asIdeal.primeCompl)).mul_right_cancel
              rw [sub_mul, IsLocalization.mk'_spec, mul_assoc, IsLocalization.mk'_spec,
                map_one, mul_one, map_sub, map_mul (algebraMap A_a O_x) (φ_Ω_Va a d) u]
            rw [hEqMk]
            exact m_x.mul_mem_right _
              ((IsLocalization.AtPrime.to_map_mem_maximal_iff O_x p_x.asIdeal _).mpr hNum_px)
          have hDiff_𝔪 : w - θ (algebraMap A_a O_x (φ_Ω_Va a d)) ∈ 𝔪 := by
            have h1 := (hθ_max _).mp hDiff_mx
            rw [map_sub, RingEquiv.apply_symm_apply] at h1
            exact h1
          have hSplitW : w = θ (algebraMap A_a O_x (φ_Ω_Va a d)) +
              (w - θ (algebraMap A_a O_x (φ_Ω_Va a d))) := by abel
          rw [hSplitW]
          exact Submodule.add_mem_sup (hConst_in_Nim d) (hJ_le_smul _ (h𝔪_le_J hDiff_𝔪))
        have hTop_eq : (⊤ : Submodule R_p S_p) ≤ N_im :=
          Submodule.le_of_le_smul_of_le_jacobson_bot hTop_FG
            (IsLocalRing.maximalIdeal_le_jacobson _) hTop_le
        intro y
        exact hTop_eq trivial
    have hj_eq : j = C.topIso.hom ≫ j₀ := by
      dsimp only [j₀]
      rw [Iso.hom_inv_id_assoc]
    rw [hj_eq]
    infer_instance
  
  
  
  have hPart4 : ∃ W₀ W₁ : C.Opens,
      AlgebraicGeometry.IsAffineOpen W₀ ∧ AlgebraicGeometry.IsAffineOpen W₁ ∧ W₀ ⊔ W₁ = ⊤ := by
    have _ : AlgebraicGeometry.IsClosedImmersion j₀ := by
      dsimp only [j₀]; infer_instance
    have _ : AlgebraicGeometry.IsAffineHom j₀ :=
      AlgebraicGeometry.IsClosedImmersion.instIsAffineHom j₀
    have _ : Infinite Ω := IsAlgClosed.instInfinite
    have hAvoid : ∀ (N : ℕ) (w : Fin N → (Fin (r₀ + 1) → Ω)),
        (∀ t : Fin N, w t ≠ 0) →
        ∃ a_coef : Fin (r₀ + 1) → Ω, ∀ t : Fin N, ∑ i : Fin (r₀ + 1), a_coef i * w t i ≠ 0 := by
      intro N w hw
      let ℓ : Fin N → ((Fin (r₀ + 1) → Ω) →ₗ[Ω] Ω) := fun t =>
        { toFun := fun a => ∑ i : Fin (r₀ + 1), a i * w t i
          map_add' := fun a b => by simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
          map_smul' := fun d a => by
            simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, mul_assoc, ← Finset.mul_sum] }
      have hKer_ne_top : ∀ t : Fin N, LinearMap.ker (ℓ t) ≠ ⊤ := by
        intro t hTop
        obtain ⟨i₀, hi₀⟩ := Function.ne_iff.mp (hw t)
        let e_i₀ : Fin (r₀ + 1) → Ω := fun i => if i = i₀ then 1 else 0
        have hMem : e_i₀ ∈ LinearMap.ker (ℓ t) := by
          rw [hTop]; trivial
        rw [LinearMap.mem_ker] at hMem
        change (∑ i : Fin (r₀ + 1), e_i₀ i * w t i) = 0 at hMem
        dsimp only [e_i₀] at hMem
        simp only [ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte] at hMem
        exact hi₀ hMem
      exact Submodule.exists_forall_notMem_of_forall_ne_top (fun t => LinearMap.ker (ℓ t)) hKer_ne_top
    let L_lin : (Fin (r₀ + 1) → Ω) → MvPolynomial (Fin (r₀ + 1)) Ω :=
      fun a_coef => ∑ i : Fin (r₀ + 1), a_coef i • MvPolynomial.X i
    have hL_lin : ∀ a_coef : Fin (r₀ + 1) → Ω, L_lin a_coef ∈ 𝒜 1 :=
      fun a_coef => (𝒜 1).sum_mem fun i _ =>
        (𝒜 1).smul_mem (a_coef i) (MvPolynomial.isHomogeneous_X Ω i)
    let W_lin : (Fin (r₀ + 1) → Ω) → C.Opens :=
      fun a_coef => (TopologicalSpace.Opens.map j₀.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (L_lin a_coef))
    have hAff_Wlin : ∀ a_coef : Fin (r₀ + 1) → Ω, AlgebraicGeometry.IsAffineOpen (W_lin a_coef) :=
      fun a_coef => AlgebraicGeometry.IsAffineHom.isAffine_preimage _
        (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (L_lin a_coef) (hL_lin a_coef) zero_lt_one)
    have hClosedVec : ∀ (x : C), IsClosed ({x} : Set C) →
        ∃ w_x : Fin (r₀ + 1) → Ω, w_x ≠ 0 ∧
          ∀ a_coef : Fin (r₀ + 1) → Ω,
            (∑ i : Fin (r₀ + 1), a_coef i * w_x i) ≠ 0 → x ∈ W_lin a_coef := by
      intro x hx_cl
      have hx_univ : x ∈ (Set.univ : Set C) := Set.mem_univ x
      rw [← M.hCov, Set.mem_iUnion] at hx_univ
      obtain ⟨a, hx_a⟩ := hx_univ
      let A_a := ↑(C.presheaf.obj (Opposite.op (M.V a)))
      let p_x := (hAff a).primeIdealOf ⟨x, hx_a⟩
      have hpx_eq : (hAff a).fromSpec.base p_x = x := (hAff a).fromSpec_primeIdealOf ⟨x, hx_a⟩
      have _ : p_x.asIdeal.IsMaximal :=
        AlgebraicGeometry.IsAffineOpen.primeIdealOf_isMaximal_of_isClosed (hAff a) ⟨x, hx_a⟩ hx_cl
      have hRes_surj := hNullstellensatz_C (M.V a) (hAff a) p_x.asIdeal
      choose w_x hw_x using fun i : Fin (r₀ + 1) => hRes_surj (e'_Va i a)
      have hw_ne : w_x ≠ 0 := by
        intro hw_zero
        apply p_x.isPrime.ne_top
        rw [eq_top_iff]
        intro one_el _
        let res_Va : ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))) →+* A_a :=
          (C.presheaf.map (CategoryTheory.homOfLE (le_inf le_top (le_refl (M.V a)))).op).hom
        have hSpan_Va : Ideal.span (Set.range fun i : Fin (r₀ + 1) => e'_Va i a) = ⊤ := by
          have hMapTop : Ideal.map res_Va ⊤ = ⊤ := Ideal.map_top res_Va
          rw [← hSpan a, Ideal.map_span] at hMapTop
          convert hMapTop using 2
          ext u
          simp only [Set.mem_image, Set.mem_range, exists_exists_eq_and]
          rfl
        have hLe : (⊤ : Ideal A_a) ≤ p_x.asIdeal := by
          rw [← hSpan_Va, Ideal.span_le]
          rintro _ ⟨i, rfl⟩
          have hwi := hw_x i
          have hw0 : w_x i = 0 := congrFun hw_zero i
          rw [hw0, map_zero, sub_zero] at hwi
          exact hwi
        exact hLe trivial
      refine ⟨w_x, hw_ne, fun a_coef hSumNe => ?_⟩
      change j₀.base x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (L_lin a_coef)
      rw [← hpx_eq, hMem_basicOpen_deg1 a p_x (L_lin a_coef) (hL_lin a_coef)]
      intro hMemP
      let δ : Ω := ∑ i : Fin (r₀ + 1), a_coef i * w_x i
      have hEvalL : MvPolynomial.eval₂ (φ_Ω_Va a) (fun i => e'_Va i a) (L_lin a_coef) =
          ∑ i : Fin (r₀ + 1), φ_Ω_Va a (a_coef i) * e'_Va i a := by
        dsimp only [L_lin]
        have hSmul : ∀ i : Fin (r₀ + 1),
            (a_coef i • MvPolynomial.X i : MvPolynomial (Fin (r₀ + 1)) Ω) =
              MvPolynomial.C (a_coef i) * MvPolynomial.X i :=
          fun i => Algebra.smul_def (a_coef i) _
        simp only [hSmul, MvPolynomial.eval₂_sum, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C,
          MvPolynomial.eval₂_X]
      have hDiffMem : φ_Ω_Va a δ ∈ p_x.asIdeal := by
        have hId : φ_Ω_Va a δ =
            MvPolynomial.eval₂ (φ_Ω_Va a) (fun i => e'_Va i a) (L_lin a_coef) -
              ∑ i : Fin (r₀ + 1), φ_Ω_Va a (a_coef i) * (e'_Va i a - φ_Ω_Va a (w_x i)) := by
          rw [hEvalL]
          dsimp only [δ]
          rw [map_sum, ← Finset.sum_sub_distrib]
          apply Finset.sum_congr rfl
          intro i _
          rw [map_mul]
          ring
        rw [hId]
        exact p_x.asIdeal.sub_mem hMemP
          (p_x.asIdeal.sum_mem fun i _ => p_x.asIdeal.mul_mem_left _ (hw_x i))
      have hUnit : IsUnit (φ_Ω_Va a δ) := (IsUnit.mk0 δ hSumNe).map (φ_Ω_Va a)
      exact p_x.isPrime.ne_top (p_x.asIdeal.eq_top_of_isUnit_mem hDiffMem hUnit)
    choose P_comp hP_comp using fun α : Fin (c + 1) => ((hNorm4 α).2.2.1).nonempty
    let x_comp : Fin (c + 1) → C := fun α => (ν α).base (P_comp α)
    have hx_comp_cl : ∀ α : Fin (c + 1), IsClosed ({x_comp α} : Set C) :=
      fun α => ((hNorm4 α).2.1 (P_comp α)).mp (hP_comp α)
    choose w_comp hw_comp_ne hw_comp_in using fun α : Fin (c + 1) =>
      hClosedVec (x_comp α) (hx_comp_cl α)
    obtain ⟨a₀, ha₀⟩ := hAvoid (c + 1) w_comp hw_comp_ne
    let W₀ : C.Opens := W_lin a₀
    have hAff₀ : AlgebraicGeometry.IsAffineOpen W₀ := hAff_Wlin a₀
    have hx_in_W₀ : ∀ α : Fin (c + 1), x_comp α ∈ W₀ :=
      fun α => hw_comp_in α a₀ (ha₀ α)
    let S₀ : Set C := (W₀ : Set C)ᶜ
    have hS₀_closed : IsClosed S₀ := W₀.isOpen.isClosed_compl
    have hT_props : ∀ α : Fin (c + 1),
        ((ν α).base ⁻¹' S₀).Finite ∧
        ∀ P ∈ (ν α).base ⁻¹' S₀, IsClosed ({P} : Set (E_norm α)) := by
      intro α
      have hT_cl : IsClosed ((ν α).base ⁻¹' S₀) := hS₀_closed.preimage (ν α).continuous
      have hT_ne : (ν α).base ⁻¹' S₀ ≠ Set.univ := by
        intro hUniv
        have hIn : P_comp α ∈ (ν α).base ⁻¹' S₀ := by rw [hUniv]; trivial
        exact hIn (hx_in_W₀ α)
      exact (hNorm4 α).2.2.2 ((ν α).base ⁻¹' S₀) hT_cl hT_ne
    have hS₀_eq : S₀ = ⋃ α : Fin (c + 1), (ν α).base '' ((ν α).base ⁻¹' S₀) := by
      ext z
      constructor
      · intro hz
        have hz_univ : z ∈ (Set.univ : Set C) := Set.mem_univ z
        rw [← hE_cov, Set.mem_iUnion] at hz_univ
        obtain ⟨α, hz_α⟩ := hz_univ
        rw [← (hNorm4 α).1] at hz_α
        obtain ⟨P, rfl⟩ := hz_α
        rw [Set.mem_iUnion]
        exact ⟨α, P, hz, rfl⟩
      · intro hz
        rw [Set.mem_iUnion] at hz
        obtain ⟨α, P, hP, rfl⟩ := hz
        exact hP
    have hS₀_fin : S₀.Finite := by
      rw [hS₀_eq]
      exact Set.finite_iUnion fun α => (hT_props α).1.image (ν α).base
    have hS₀_pts_cl : ∀ q ∈ S₀, IsClosed ({q} : Set C) := by
      intro q hq
      rw [hS₀_eq, Set.mem_iUnion] at hq
      obtain ⟨α, P, hP, rfl⟩ := hq
      exact ((hNorm4 α).2.1 P).mp ((hT_props α).2 P hP)
    let e_fin := hS₀_fin.toFinset.equivFin.symm
    let q_pt : Fin hS₀_fin.toFinset.card → C := fun t => (e_fin t).1
    have hq_cl : ∀ t : Fin hS₀_fin.toFinset.card, IsClosed ({q_pt t} : Set C) :=
      fun t => hS₀_pts_cl (q_pt t) (hS₀_fin.mem_toFinset.mp (e_fin t).2)
    choose w_S₀ hw_S₀_ne hw_S₀_in using fun t : Fin hS₀_fin.toFinset.card =>
      hClosedVec (q_pt t) (hq_cl t)
    obtain ⟨a₁, ha₁⟩ := hAvoid hS₀_fin.toFinset.card w_S₀ hw_S₀_ne
    let W₁ : C.Opens := W_lin a₁
    have hAff₁ : AlgebraicGeometry.IsAffineOpen W₁ := hAff_Wlin a₁
    have hSup : W₀ ⊔ W₁ = ⊤ := by
      rw [eq_top_iff]
      intro z _
      by_cases hz : z ∈ W₀
      · exact TopologicalSpace.Opens.mem_sup.mpr (Or.inl hz)
      · have hz_fin : z ∈ hS₀_fin.toFinset := hS₀_fin.mem_toFinset.mpr hz
        let t := hS₀_fin.toFinset.equivFin ⟨z, hz_fin⟩
        have ht_eq : q_pt t = z := by
          dsimp only [q_pt, e_fin, t]
          rw [Equiv.symm_apply_apply]
        have hz_W₁ : z ∈ W₁ := ht_eq ▸ hw_S₀_in t a₁ (ha₁ t)
        exact TopologicalSpace.Opens.mem_sup.mpr (Or.inr hz_W₁)
    exact ⟨W₀, W₁, hAff₀, hAff₁, hSup⟩
  exact ⟨⟨j, hProjM, hCl_j⟩, hPart4⟩

theorem weil_algClosed_stable_curve_log_tricanonical_very_ample (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (M : WeilLineBundle C)
    (hLog : IsGeometricFiberLogCanonical g n τ M) :
    HasFiberTricanonicalProperties g M :=
by
  obtain ⟨c, δ, E_set, E_norm, p_norm, ν, F, instFieldF, instAlgF, η_F,
      z_node, α₀, P₀, α₁, P₁, hNormPkg⟩ :=
    weil_algClosed_nodal_curve_normalization_and_log_bundle Ω C g n τ hStab M hLog
  letI : ∀ α : Fin (c + 1), Field (F α) := instFieldF
  letI : ∀ α : Fin (c + 1), Algebra Ω (F α) := instAlgF
  have hRR : ∀ α : Fin (c + 1),
      HasSmoothCurveRiemannRochPackage Ω (E_norm α) (p_norm α) (F α) (η_F α) := by
    intro α
    have hα := hNormPkg.2.1 α
    exact weil_algClosed_smooth_curve_riemann_roch Ω (E_norm α) (p_norm α)
      hα.1 hα.2.1 hα.2.2.1 (F α) (η_F α) hα.2.2.2.2.2.2.2.1 hα.2.2.2.2.2.2.2.2
  obtain ⟨hH1, hAff, r₀, hr₀, e, he_sec, he_bas, hSepAll⟩ :=
    weil_algClosed_nodal_tricanonical_cohomology_and_separation Ω C g n τ hStab M
      c δ E_set E_norm p_norm ν F η_F z_node α₀ P₀ α₁ P₁ hNormPkg hRR
  have hE_inter : ∀ α β : Fin (c + 1), α ≠ β → (E_set α ∩ E_set β).Finite := by
    intro α β hne
    exact (Set.finite_range z_node).subset (hNormPkg.2.2.2.1.2.2.2.1 α β hne)
  have hNorm_for_proj : ∀ α : Fin (c + 1),
      AlgebraicGeometry.IsIntegral (E_norm α) ∧
      AlgebraicGeometry.IsProper (p_norm α) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (p_norm α) ∧
      AlgebraicGeometry.IsFinite (ν α) ∧
      ν α ≫ g = p_norm α ∧
      Set.range (ν α).base = E_set α ∧
      (∀ P : E_norm α, IsClosed ({P} : Set (E_norm α)) ↔ IsClosed ({(ν α).base P} : Set C)) ∧
      Set.Infinite {P : E_norm α | IsClosed ({P} : Set (E_norm α))} ∧
      (∀ S : Set (E_norm α), IsClosed S → S ≠ Set.univ →
        S.Finite ∧ ∀ P ∈ S, IsClosed ({P} : Set (E_norm α))) := by
    intro α
    have hα := hNormPkg.2.1 α
    have hRRα := hRR α
    exact ⟨hα.1, hα.2.1, hα.2.2.1, hα.2.2.2.1, hα.2.2.2.2.1, hα.2.2.2.2.2.1,
      hα.2.2.2.2.2.2.1, hRRα.1, hRRα.2.1⟩
  have hCover : ∃ W₀ W₁ : C.Opens,
      AlgebraicGeometry.IsAffineOpen W₀ ∧ AlgebraicGeometry.IsAffineOpen W₁ ∧ W₀ ⊔ W₁ = ⊤ :=
    (weil_algClosed_proj_closedImmersion_and_twoChart_cover Ω C g
      hStab.2.2.1 hStab.2.2.2.1 M hAff c E_set
      hNormPkg.1.1 hNormPkg.1.2.2 hE_inter E_norm p_norm ν hNorm_for_proj
      hNormPkg.2.2.2.2.1 r₀ hr₀ e (hSepAll e he_sec he_bas)).2
  refine ⟨hCover, hH1, r₀, hr₀, e, he_sec, he_bas, ?_⟩
  intro e' he'_sec he'_bas
  exact (weil_algClosed_proj_closedImmersion_and_twoChart_cover Ω C g
    hStab.2.2.1 hStab.2.2.2.1 M hAff c E_set
    hNormPkg.1.1 hNormPkg.1.2.2 hE_inter E_norm p_norm ν hNorm_for_proj
    hNormPkg.2.2.2.2.1 r₀ hr₀ e' (hSepAll e' he'_sec he'_bas)).1

theorem weil_affine_pullback_cech_baseChange_and_section_bridge (R : Type u) [CommRing R]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hProp : AlgebraicGeometry.IsProper g)
    (M : WeilLineBundle C)
    (hAffM : ∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a))
    [∀ p : ℕ, Module R (WeilTricanonicalCechCochain M p)]
    (d : ∀ p : ℕ, WeilTricanonicalCechCochain M p →ₗ[R] WeilTricanonicalCechCochain M (p + 1))
    (hSmul : ∀ (p : ℕ) (r : R) (c : WeilTricanonicalCechCochain M p),
      r • c = weilCechSmul g M p r c)
    (hDiff : ∀ (p : ℕ) (c : WeilTricanonicalCechCochain M p),
      d p c = weilTricanonicalCechDiff M p c) :
    (∀ (h : R) (r₀ : ℕ)
       (v : Fin (r₀ + 1) → TensorProduct R (Localization.Away h) (WeilTricanonicalCechCochain M 0)),
      ∃ (e_raw : Fin (r₀ + 1) → ∀ a : Fin M.m,
          ↑((CategoryTheory.Limits.pullback g
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap R (Localization.Away h))))).presheaf.obj
            (Opposite.op
              (⊤ ⊓ (TopologicalSpace.Opens.map
                (CategoryTheory.Limits.pullback.fst g
                  (AlgebraicGeometry.Spec.map
                    (CommRingCat.ofHom (algebraMap R (Localization.Away h))))).base).obj (M.V a))))),
        ∀ (R' : Type u) [CommRing R'] (ψ : Localization.Away h →+* R'),
          (letI : Algebra R R' := (ψ.comp (algebraMap R (Localization.Away h))).toAlgebra
           letI : Algebra (Localization.Away h) R' := ψ.toAlgebra
           letI : IsScalarTower R (Localization.Away h) R' := IsScalarTower.of_algebraMap_eq' rfl
           let v' : Fin (r₀ + 1) → TensorProduct R R' (WeilTricanonicalCechCochain M 0) :=
             fun i => LinearMap.rTensor (WeilTricanonicalCechCochain M 0)
               (IsScalarTower.toAlgHom R (Localization.Away h) R').toLinearMap (v i)
           (∀ i : Fin (r₀ + 1), LinearMap.baseChange R' (d 0) (v' i) = 0) ∧
           (∀ x : TensorProduct R R' (WeilTricanonicalCechCochain M 0),
             LinearMap.baseChange R' (d 0) x = 0 →
             ∃! c : Fin (r₀ + 1) → R', x = ∑ i : Fin (r₀ + 1), c i • v' i)) →
          let u_h := AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap R (Localization.Away h)))
          let u' := AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (ψ.comp (algebraMap R (Localization.Away h))))
          let C' := CategoryTheory.Limits.pullback g u'
          let snd' := CategoryTheory.Limits.pullback.snd g u'
          ∀ (w' : C' ⟶ CategoryTheory.Limits.pullback g u_h),
            w' ≫ CategoryTheory.Limits.pullback.fst g u_h =
              CategoryTheory.Limits.pullback.fst g u' →
            w' ≫ CategoryTheory.Limits.pullback.snd g u_h =
              snd' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) →
            ∀ (M' : WeilLineBundle C') (eIdx : Fin M'.m ≃ Fin M.m)
              (hV : ∀ a : Fin M'.m,
                ⊤ ⊓ M'.V a =
                  (TopologicalSpace.Opens.map w'.base).obj
                    (⊤ ⊓ (TopologicalSpace.Opens.map
                      (CategoryTheory.Limits.pullback.fst g u_h).base).obj (M.V (eIdx a)))),
              (∀ a b : Fin M'.m,
                ∀ hEq : M'.V a ⊓ M'.V b =
                    (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g u').base).obj
                      (M.V (eIdx a) ⊓ M.V (eIdx b)),
                  (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq hEq.symm)).op).hom
                      (M'.u a b).val =
                    ((CategoryTheory.Limits.pullback.fst g u').app
                      (M.V (eIdx a) ⊓ M.V (eIdx b))).hom (M.u (eIdx a) (eIdx b)).val) →
              let e' : Fin (r₀ + 1) → ∀ a : Fin M'.m,
                  ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))) :=
                fun i a =>
                  (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV a))).op).hom
                    ((w'.app _).hom (e_raw i (eIdx a)))
              (∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M' ⊤ (e' i)) ∧
              (∀ s' : ∀ a : Fin M'.m, ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))),
                IsWeilTricanonicalSection M' ⊤ s' →
                ∃! c : Fin (r₀ + 1) → R',
                  ∀ a : Fin M'.m,
                    s' a = ∑ i : Fin (r₀ + 1),
                      (C'.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M'.V a ≤ ⊤)).op).hom
                        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫
                          snd'.appTop).hom (c i)) * e' i a)) ∧
    (∀ (S : Type u) [CommRing S] [Algebra R S],
      let u_S := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S))
      let C_S := CategoryTheory.Limits.pullback g u_S
      ∃ (M_S : WeilLineBundle C_S),
        WeilPullbackLineBundle (CategoryTheory.Limits.pullback.fst g u_S) M M_S ∧
        (∀ a : Fin M_S.m, AlgebraicGeometry.IsAffineOpen (M_S.V a)) ∧
        ((∀ (p : ℕ) (z : WeilTricanonicalCechCochain M_S (p + 1)),
            weilTricanonicalCechDiff M_S (p + 1) z = 0 →
            ∃ b : WeilTricanonicalCechCochain M_S p, weilTricanonicalCechDiff M_S p b = z) →
          ∀ p : ℕ,
            LinearMap.ker (LinearMap.baseChange S (d (p + 1))) ≤
              LinearMap.range (LinearMap.baseChange S (d p))) ∧
        (∀ (r₀ : ℕ)
           (e : Fin (r₀ + 1) → ∀ a : Fin M_S.m, ↑(C_S.presheaf.obj (Opposite.op (⊤ ⊓ M_S.V a)))),
          (∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M_S ⊤ (e i)) →
          (∀ s_sec : ∀ a : Fin M_S.m, ↑(C_S.presheaf.obj (Opposite.op (⊤ ⊓ M_S.V a))),
            IsWeilTricanonicalSection M_S ⊤ s_sec →
            ∃! c : Fin (r₀ + 1) → S,
              ∀ a : Fin M_S.m,
                s_sec a = ∑ i : Fin (r₀ + 1),
                  (C_S.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M_S.V a ≤ ⊤)).op).hom
                    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of S)).inv ≫
                      (CategoryTheory.Limits.pullback.snd g u_S).appTop).hom (c i)) *
                    e i a) →
