      rw [hu_raw i j, hu_raw j k, hu_raw i k,
        res_awayToSection (hj k) rfl hle_ij,
        res_awayToSection (hj i) (by show x₃ = (X_var j * X_var k) * X_var i; ring) hle_jk,
        res_awayToSection (hj j) (by show x₃ = (X_var i * X_var k) * X_var j; ring) hle_ik,
