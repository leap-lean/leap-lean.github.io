            (fun k => hImg0 ▸ Finset.mem_image_of_mem α.1 (Finset.mem_univ k))
        have hs0 := hs_notMem (faceOf α j₀) hNotMem0 α hImg0 j₀ hj₀ hle0
        have hRestZero : ∑ k : Fin (p + 1), (-1) ^ (j₀.succAbove k : ℕ) *
            (Y.presheaf.map (CategoryTheory.homOfLE
              (inf_le_inf_left (U lam) (hFaceOf α (j₀.succAbove k)))).op).hom
              (s (faceOf α (j₀.succAbove k))) = 0 := by
          refine Finset.sum_eq_zero fun k _ => ?_
          obtain ⟨k₀, hk₀⟩ := Fin.exists_succAbove_eq (Fin.succAbove_ne j₀ k).symm
          have hInFace : lam ∈ Finset.univ.image (faceOf α (j₀.succAbove k)).1 := by
            refine Finset.mem_image.mpr ⟨k₀, Finset.mem_univ k₀, ?_⟩
            change α.1 ((j₀.succAbove k).succAbove k₀) = lam
            rw [hk₀, hj₀]
          rw [hs_zero _ hInFace, map_zero, mul_zero]
        rw [hRestZero, add_zero, hs0, map_mul, hMapNegOnePow,
          hMapComp hle0 (inf_le_inf_left (U lam) (hFaceOf α j₀)) inf_le_right,
          ← mul_assoc, ← mul_pow, neg_one_mul, neg_neg, one_pow, one_mul]
      · 
        let S_α : Finset (Fin r) := Finset.univ.image α.1
        let S_γ : Finset (Fin r) := insert lam S_α
        have hS_γ : S_γ.card = p + 3 := by
          rw [Finset.card_insert_of_notMem hMem, hImgCard α]
        let γ : WeilStrictMonoTuple r (p + 2) := embTuple S_γ hS_γ
        have hγ_img : Finset.univ.image γ.1 = S_γ := hEmbImg S_γ hS_γ
        have hInγ : lam ∈ Finset.univ.image γ.1 := by
