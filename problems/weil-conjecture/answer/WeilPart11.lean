    exact congrArg (fun φ => φ.hom ((f.app (M.V a ⊓ M.V a')).hom (M.u a a').val)) hm
  have hAppLE_twoStep : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}}
      (f : X ⟶ Y) (g : Y ⟶ Z) (h : X ⟶ Z),
      f ≫ g = h →
      ∀ (U : Z.Opens) (V : Y.Opens) (W : X.Opens)
