        obtain ⟨⟨_, n, rfl⟩, hn⟩ :=
          IsLocalization.exists_of_eq (M := Submonoid.powers z) h_eq₀
        refine ⟨⟨(e₁ z) ^ n, n, rfl⟩, ?_⟩
        change (e₁ z) ^ n * r₁ = (e₁ z) ^ n * r₂
        have hn' := congrArg e₁ hn
        simp only [map_mul, map_pow, e₁.apply_symm_apply] at hn'
        exact hn'
    let t₀ : ∀ _k₀ j : Fin (N₀ + 1), ↑(P₀.presheaf.obj (Opposite.op (W₀ j))) :=
