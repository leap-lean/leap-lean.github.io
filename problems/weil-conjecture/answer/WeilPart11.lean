        (↑(X₁.presheaf.obj (Opposite.op
          ((⊤ ⊓ N₁.V a) ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b)))))ˣ),
      (∀ (a a' : Fin N₁.m) (b : Fin N₂.m),
        let W₁ : X₁.Opens := (⊤ ⊓ N₁.V a) ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b)
        let W₂ : X₁.Opens := (⊤ ⊓ N₁.V a') ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b)
        let h_u : W₁ ⊓ W₂ ≤ N₁.V a ⊓ N₁.V a' :=
          inf_le_inf (le_trans inf_le_left inf_le_right) (le_trans inf_le_left inf_le_right)
        (X₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op).hom (u a b).val =
          ((X₁.presheaf.map (CategoryTheory.homOfLE h_u).op).hom (N₁.u a a').val) ^ 3 *
            (X₁.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op).hom
              (u a' b).val) →
      (∀ (a : Fin N₁.m) (b b' : Fin N₂.m),
        let W₁ : X₁.Opens := (⊤ ⊓ N₁.V a) ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b)
        let W₂ : X₁.Opens := (⊤ ⊓ N₁.V a) ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b')
        let h_u : W₁ ⊓ W₂ ≤ (TopologicalSpace.Opens.map f.base).obj (N₂.V b ⊓ N₂.V b') :=
          fun _ hp => ⟨hp.1.2.2, hp.2.2.2⟩
        (X₁.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op).hom (u a b').val =
          (X₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op).hom (u a b).val *
            ((X₁.presheaf.map (CategoryTheory.homOfLE h_u).op).hom
              ((f.app (N₂.V b ⊓ N₂.V b')).hom (N₂.u b b').val)) ^ 3) →
      ∃ Φ : (∀ b : Fin N₂.m, ↑(X₂.presheaf.obj (Opposite.op (⊤ ⊓ N₂.V b)))) →
          (∀ a : Fin N₁.m, ↑(X₁.presheaf.obj (Opposite.op (⊤ ⊓ N₁.V a)))),
        (∀ s₂, IsWeilTricanonicalSection N₂ ⊤ s₂ → IsWeilTricanonicalSection N₁ ⊤ (Φ s₂)) ∧
        (∀ s₂, IsWeilTricanonicalSection N₂ ⊤ s₂ →
          ∀ (a : Fin N₁.m) (b : Fin N₂.m),
            let W_ab : X₁.Opens :=
              (⊤ ⊓ N₁.V a) ⊓ (TopologicalSpace.Opens.map f.base).obj (⊤ ⊓ N₂.V b)
