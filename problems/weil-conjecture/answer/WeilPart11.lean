        intro huniv
        rw [huniv, Set.preimage_univ] at hS₀_pre
        exact hZ_univ hS₀_pre.symm
      obtain ⟨hS₀_fin, hS₀_pts⟩ := hA2 S₀ hS₀_cl hS₀_ne
