      rw [heW_πf]
      rfl
    refine ⟨?_, ?_⟩
    · intro hx_not_cl
      refine ⟨hNotCl_eq_η₀ x hx_not_cl, ?_⟩
      have hpz_bot : p_z.asIdeal = ⊥ := by
        ext r
        rw [Ideal.mem_bot]
        constructor
        · intro hr_in
          by_contra hr_ne
          have hφr_ne : φ_W.hom r ≠ 0 :=
            fun h0 => hr_ne (hφW_inj (h0.trans (map_zero φ_W.hom).symm))
          let S_r : Set E_sm := (E_sm.basicOpen r : Set E_sm)ᶜ
          have hSr_cl : IsClosed S_r := (E_sm.basicOpen r).isOpen.isClosed_compl
          have hx_Sr : x ∈ S_r := by
            intro hx_bas
            rw [← hp_z, hSpec_basic W hW r p_z] at hx_bas
            exact hx_bas hr_in
          have hSr_ne : S_r ≠ Set.univ := by
            intro huniv
            let q_ker : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W)) :=
              ⟨RingHom.ker φ_W.hom, RingHom.ker_isPrime φ_W.hom⟩
            exact (huniv ▸ Set.mem_univ (hW.fromSpec.base q_ker))
              ((hSpec_basic W hW r q_ker).mpr hφr_ne)
          exact hx_not_cl ((hA2 S_r hSr_cl hSr_ne).2 x hx_Sr)
        · rintro rfl
          exact p_z.asIdeal.zero_mem
      ext b
      rw [hπz_mem, hpz_bot, Ideal.mem_bot, Ideal.mem_bot]
      constructor
      · intro hσ0
        ext
        have h0 := congrArg φ_W.hom hσ0
        rwa [map_zero, hφ_σW b] at h0
      · rintro rfl
        exact map_zero σ_W
    · intro hx_cl
      have hx_Uf_set : x ∈ (U_f : Set E_sm) := hx_Uf
      rw [hUf_set] at hx_Uf_set
      have hxf : (0 : WithTop ℤ) ≤ ord x f := hx_Uf_set.resolve_left (not_not.mpr hx_cl)
      have hpz_cl : IsClosed ({hW.fromSpec.base p_z} : Set E_sm) := by rwa [hp_z]
      have h_iff : ∀ b : ↥B, b ∈ (π_f.base z).asIdeal ↔ (1 : WithTop ℤ) ≤ ord x (b : F) := by
        intro b
        rw [hπz_mem, hPrimeW p_z hpz_cl (σ_W b), hp_z, hφ_σW b]
      obtain ⟨𝔪_x, h𝔪x_max, h𝔪x_iff, _⟩ := hDVR_max x hx_cl hxf
      have h_eq_𝔪 : (π_f.base z).asIdeal = 𝔪_x := by
        ext b
        exact (h_iff b).trans (h𝔪x_iff b).symm
      rw [h_eq_𝔪]
      exact ⟨hxf, h𝔪x_max, hMaxNeBotB 𝔪_x h𝔪x_max, h𝔪x_iff⟩
  
  have hBij_base : Function.Bijective π_f.base := by
    refine ⟨?_, ?_⟩
    · intro z₁ z₂ hz_eq
      have hId_eq : (π_f.base z₁).asIdeal = (π_f.base z₂).asIdeal :=
        congrArg PrimeSpectrum.asIdeal hz_eq
      apply U_f.ι.isOpenEmbedding.injective
      by_cases h1 : IsClosed ({U_f.ι.base z₁} : Set E_sm)
      · obtain ⟨hxf1, _, hne1, hiff1⟩ := (hBase_ideal z₁).2 h1
        by_cases h2 : IsClosed ({U_f.ι.base z₂} : Set E_sm)
        · obtain ⟨hxf2, _, _, hiff2⟩ := (hBase_ideal z₂).2 h2
          refine hD5 (U_f.ι.base z₁) (U_f.ι.base z₂) h1 h2 hxf1 hxf2 ?_
          intro b
          rw [← hiff1 b, hId_eq, hiff2 b]
        · obtain ⟨_, hbot2⟩ := (hBase_ideal z₂).1 h2
          exact absurd (hId_eq.trans hbot2) hne1
      · obtain ⟨heq1, hbot1⟩ := (hBase_ideal z₁).1 h1
        by_cases h2 : IsClosed ({U_f.ι.base z₂} : Set E_sm)
        · obtain ⟨_, _, hne2, _⟩ := (hBase_ideal z₂).2 h2
          exact absurd (hId_eq.symm.trans hbot1) hne2
        · obtain ⟨heq2, _⟩ := (hBase_ideal z₂).1 h2
          exact heq1.trans heq2.symm
    · intro q
      by_cases hq_bot : q.asIdeal = ⊥
      · have hη₀_range : η₀ ∈ Set.range U_f.ι.base := by
          rw [U_f.range_ι]
          exact hη₀_Uf
        rcases hη₀_range with ⟨z₀, hz₀⟩
        refine ⟨z₀, PrimeSpectrum.ext ?_⟩
        have hnot : ¬IsClosed ({U_f.ι.base z₀} : Set E_sm) := by
          rw [hz₀]
          exact hη₀_not_cl
        rw [((hBase_ideal z₀).1 hnot).2, hq_bot]
