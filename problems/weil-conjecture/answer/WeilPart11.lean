              rw [Finsupp.smul_apply, Finsupp.smul_apply, hb_pos (face k β) h_fk,
                Finsupp.single_eq_same, hF3_face β hβ k h_fk, ← mul_smul, ← mul_smul,
                ← pow_add, hF3_sum β hβ k h_fk]
              have hsign : (-1 : ℤ) ^ ((k : ℕ) + (pos (face k β) h_fk : ℕ) + 1) =
                  -(((-1 : ℤ) ^ (k : ℕ)) * ((-1 : ℤ) ^ (pos (face k β) h_fk : ℕ))) := by
                rw [pow_add, pow_add, pow_one]
                ring
              rw [hsign, neg_smul]
            rw [hsum_eq, Finset.sum_neg_distrib] at hmul
            calc (∑ k : Fin (p + 2), (((-1 : ℤ) ^ (k : ℕ)) • b (face k β)) a)
                = (z β a + -∑ k : Fin (p + 2), (((-1 : ℤ) ^ (k : ℕ)) • b (face k β)) a) +
                    ∑ k : Fin (p + 2), (((-1 : ℤ) ^ (k : ℕ)) • b (face k β)) a := by
                  rw [hmul, zero_add]
              _ = z β a := by abel
        · rw [Finsupp.single_eq_of_ne ha']
          apply Finset.sum_eq_zero
          intro k _
          rw [Finsupp.smul_apply]
          by_cases h_fk : ∀ m : Fin (p + 1), (face k β).1 m ≠ j₀
          · rw [hb_pos (face k β) h_fk, Finsupp.single_eq_of_ne ha', smul_zero]
          · rw [hb_neg (face k β) h_fk, Finsupp.zero_apply, smul_zero]
    let _ : Fintype (WeilStrictMonoTuple (N + 1) (p + 1)) :=
      Fintype.ofEquiv { α : Fin (p + 2) → Fin (N + 1) // StrictMono α } (Equiv.refl _)
    have hValidSum : ∀ {ι : Type} (I : Finset ι)
        (g : ι → WeilStrictMonoTuple (N + 1) p → ((Fin (N + 1) → ℤ) →₀ B)),
        (∀ i ∈ I, IsValidLaurentCochain B N d p (g i)) →
        IsValidLaurentCochain B N d p (∑ i ∈ I, g i) := by
      intro ι I g hg γ a' hInv
      rw [Finset.sum_apply, Finsupp.finsetSum_apply]
      exact Finset.sum_eq_zero fun i hi => hg i hi γ a' hInv
    have hDiffSum : ∀ {ι : Type} (I : Finset ι)
        (g : ι → WeilStrictMonoTuple (N + 1) p → ((Fin (N + 1) → ℤ) →₀ B)),
        weilLaurentCechDiff B N p (∑ i ∈ I, g i) =
          ∑ i ∈ I, weilLaurentCechDiff B N p (g i) := by
      intro ι I g
      funext β
      rw [Finset.sum_apply]
      change (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • ((∑ i ∈ I, g i) (face j β))) =
        ∑ i ∈ I, ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • g i (face j β)
      simp only [Finset.sum_apply, Finset.smul_sum]
      exact Finset.sum_comm
    let P_pos : (Fin (N + 1) → ℤ) → Prop := fun a => ∃ j₀ : Fin (N + 1), 0 ≤ a j₀
    have hDecompCocycle : ∀ (z : WeilStrictMonoTuple (N + 1) (p + 1) → ((Fin (N + 1) → ℤ) →₀ B)),
        IsValidLaurentCochain B N d (p + 1) z →
        weilLaurentCechDiff B N (p + 1) z = 0 →
        let Supp : Finset (Fin (N + 1) → ℤ) := Finset.univ.biUnion (fun β => (z β).support)
        let z_neg : WeilStrictMonoTuple (N + 1) (p + 1) → ((Fin (N + 1) → ℤ) →₀ B) :=
          ∑ a ∈ Supp.filter (fun a => ¬P_pos a), fun β => Finsupp.single a (z β a)
        ∃ b : WeilStrictMonoTuple (N + 1) p → ((Fin (N + 1) → ℤ) →₀ B),
          IsValidLaurentCochain B N d p b ∧
          z = z_neg + weilLaurentCechDiff B N p b := by
      intro z hz_val hz_coc Supp z_neg
      let b_part : (Fin (N + 1) → ℤ) → WeilStrictMonoTuple (N + 1) p → ((Fin (N + 1) → ℤ) →₀ B) :=
        fun a =>
          if ha : P_pos a then
            Classical.choose (hHom z hz_val hz_coc a (Classical.choose ha) (Classical.choose_spec ha))
          else
            0
      let b : WeilStrictMonoTuple (N + 1) p → ((Fin (N + 1) → ℤ) →₀ B) :=
        ∑ a ∈ Supp.filter P_pos, b_part a
      have hb_val : IsValidLaurentCochain B N d p b := by
        dsimp only [b]
        apply hValidSum
        intro a ha_mem
        have ha : P_pos a := (Finset.mem_filter.mp ha_mem).2
        simp only [b_part, ha, ↓reduceDIte]
        exact (Classical.choose_spec
          (hHom z hz_val hz_coc a (Classical.choose ha) (Classical.choose_spec ha))).1
      have hb_diff : weilLaurentCechDiff B N p b =
          ∑ a ∈ Supp.filter P_pos, fun β => Finsupp.single a (z β a) := by
        dsimp only [b]
        rw [hDiffSum]
        refine Finset.sum_congr rfl fun a ha_mem => ?_
        have ha : P_pos a := (Finset.mem_filter.mp ha_mem).2
        simp only [b_part, ha, ↓reduceDIte]
        exact (Classical.choose_spec
          (hHom z hz_val hz_coc a (Classical.choose ha) (Classical.choose_spec ha))).2
      refine ⟨b, hb_val, ?_⟩
      rw [hb_diff]
      funext β
      simp only [z_neg, Pi.add_apply, Finset.sum_apply]
      rw [Finset.sum_filter_not_add_sum_filter Supp P_pos]
      apply Finsupp.ext
      intro a'
      rw [Finsupp.finsetSum_apply]
      by_cases ha' : a' ∈ Supp
      · symm
        rw [Finset.sum_eq_single a']
        · rw [Finsupp.single_eq_same]
        · intro a _ hne
          exact Finsupp.single_eq_of_ne hne.symm
        · intro hmem
          exact False.elim (hmem ha')
      · symm
        rw [Finset.sum_eq_zero]
        · have hnot : a' ∉ (z β).support := fun hm =>
            ha' (Finset.mem_biUnion.mpr ⟨β, Finset.mem_univ β, hm⟩)
          exact (Finsupp.notMem_support_iff.mp hnot).symm
        · intro a ha_mem
          have hne : a' ≠ a := fun hEq => ha' (hEq ▸ ha_mem)
          exact Finsupp.single_eq_of_ne hne
    by_cases hEq : p + 1 = N
    · have hγ_empty : ∀ γ : WeilStrictMonoTuple (N + 1) (p + 2), False := by
        intro γ
        have hcard := Fintype.card_le_of_injective γ.1 γ.2.injective
        simp only [Fintype.card_fin] at hcard
        omega
      let β_top : WeilStrictMonoTuple (N + 1) (p + 1) :=
        ⟨Fin.cast (by omega), fun x y hxy => hxy⟩
      have hβ_uniq : ∀ β : WeilStrictMonoTuple (N + 1) (p + 1), β = β_top := by
        intro β
        apply hTupleEq
        have hcard : (Finset.univ.image β.1).card = Fintype.card (Fin (N + 1)) := by
          rw [Finset.card_image_of_injective _ β.2.injective, Finset.card_univ,
            Fintype.card_fin, Fintype.card_fin]
          omega
        have himg : Finset.univ.image β.1 = Finset.univ := Finset.eq_univ_of_card _ hcard
        have hr1 : Set.range β.1 = Set.univ := by
          have hc := congrArg (fun s : Finset (Fin (N + 1)) => (s : Set (Fin (N + 1)))) himg
          simpa only [Finset.coe_image, Finset.coe_univ, Set.image_univ] using hc
        have hr2 : Set.range β_top.1 = Set.univ := by
          ext j
          simp only [Set.mem_range, Set.mem_univ, iff_true]
          refine ⟨Fin.cast (by omega) j, ?_⟩
          ext
          simp [β_top]
        exact hr1.trans hr2.symm
      let S_neg : Finset (Fin (N + 1) → ℤ) :=
        (Fintype.piFinset fun _ : Fin (N + 1) => Finset.Icc (d + (N : ℤ)) (-1)).filter
          (fun a => ∑ j : Fin (N + 1), a j = d)
      let k : ℕ := Fintype.card ↥S_neg
      let e_neg : Fin k ≃ ↥S_neg := (Fintype.equivFin ↥S_neg).symm
      let gen : Fin k → WeilStrictMonoTuple (N + 1) (p + 1) → ((Fin (N + 1) → ℤ) →₀ B) :=
        fun j _ => Finsupp.single (e_neg j).1 (1 : B)
      refine ⟨k, gen, ?_, ?_⟩
      · intro j
        refine ⟨?_, ?_⟩
        · intro β a' hInv
          rw [hβ_uniq β] at hInv
          have hj_mem := (e_neg j).2
          rw [Finset.mem_filter, Fintype.mem_piFinset] at hj_mem
          have hj_val : IsValidLaurentExp N d β_top (e_neg j).1 := by
            refine ⟨hj_mem.2, fun m hm => False.elim ?_⟩
            apply hm (Fin.cast (by omega) m)
            ext
            simp [β_top]
          have ha'_ne : a' ≠ (e_neg j).1 := fun hEq' => hInv (hEq' ▸ hj_val)
          exact Finsupp.single_eq_of_ne ha'_ne
        · funext γ
          exact False.elim (hγ_empty γ)
      · intro z hz_val hz_coc
        obtain ⟨b, hb_val, hz_eq⟩ := hDecompCocycle z hz_val hz_coc
        let Supp : Finset (Fin (N + 1) → ℤ) := Finset.univ.biUnion (fun β => (z β).support)
        have hSuppNeg : ∀ a ∈ Supp.filter (fun a => ¬P_pos a), a ∈ S_neg := by
          intro a ha_mem
          obtain ⟨ha_supp, ha_not_pos⟩ := Finset.mem_filter.mp ha_mem
          obtain ⟨β₀, _, ha_β₀⟩ := Finset.mem_biUnion.mp ha_supp
          have hne : z β₀ a ≠ 0 := Finsupp.mem_support_iff.mp ha_β₀
          have hExp : IsValidLaurentExp N d β₀ a := by
            by_contra hInv
            exact hne (hz_val β₀ a hInv)
          have ha_le : ∀ j : Fin (N + 1), a j ≤ -1 := by
            intro j
            have hnot : ¬(0 ≤ a j) := fun h0 => ha_not_pos ⟨j, h0⟩
            omega
          rw [Finset.mem_filter, Fintype.mem_piFinset]
          refine ⟨fun j₀ => Finset.mem_Icc.mpr ⟨?_, ha_le j₀⟩, hExp.1⟩
          have h_erase_sum : a j₀ + ∑ j ∈ Finset.univ.erase j₀, a j = d := by
            rw [Finset.add_sum_erase Finset.univ a (Finset.mem_univ j₀), hExp.1]
          have h_erase_le : ∑ j ∈ Finset.univ.erase j₀, a j ≤
              ∑ _j ∈ Finset.univ.erase j₀, (-1 : ℤ) :=
            Finset.sum_le_sum (fun j _ => ha_le j)
          have h_erase_card : (Finset.univ.erase j₀).card = N := by
            rw [Finset.card_erase_of_mem (Finset.mem_univ j₀), Finset.card_univ, Fintype.card_fin]
            omega
          rw [Finset.sum_const, h_erase_card, nsmul_eq_mul] at h_erase_le
          omega
        have hc_eq :
            (∑ j : Fin k, z β_top (e_neg j).1 • gen j) =
            ∑ a ∈ Supp.filter (fun a => ¬P_pos a), fun β => Finsupp.single a (z β a) := by
          funext β
          rw [hβ_uniq β]
          apply Finsupp.ext
          intro a'
          simp only [Finset.sum_apply, Finsupp.finsetSum_apply, Pi.smul_apply,
            Finsupp.smul_apply, gen, smul_eq_mul]
          by_cases ha' : a' ∈ S_neg
          · have ha'_not_pos : ¬P_pos a' := by
              rintro ⟨j₀, hj₀⟩
              have hm := (Finset.mem_filter.mp ha').1
              rw [Fintype.mem_piFinset] at hm
              have h_icc := Finset.mem_Icc.mp (hm j₀)
              omega
            have hlhs : (∑ j : Fin k, z β_top (e_neg j).1 * (Finsupp.single (e_neg j).1 (1 : B)) a') =
                z β_top a' := by
              rw [Finset.sum_eq_single (e_neg.symm ⟨a', ha'⟩)]
              · simp only [Equiv.apply_symm_apply, Finsupp.single_eq_same, mul_one]
              · intro j _ hj
                have hne_a : a' ≠ (e_neg j).1 := by
                  intro hEq'
                  apply hj
                  apply e_neg.injective
                  rw [Equiv.apply_symm_apply]
                  exact Subtype.ext hEq'.symm
                rw [Finsupp.single_eq_of_ne hne_a, mul_zero]
              · intro hmem
                exact False.elim (hmem (Finset.mem_univ _))
            rw [hlhs]
            symm
            by_cases hz0 : z β_top a' = 0
            · rw [hz0]
              apply Finset.sum_eq_zero
              intro a _
              by_cases haa' : a' = a
              · rw [← haa', hz0, Finsupp.single_zero, Finsupp.zero_apply]
              · exact Finsupp.single_eq_of_ne haa'
            · have ha'_mem : a' ∈ Supp.filter (fun a => ¬P_pos a) := by
                rw [Finset.mem_filter]
                refine ⟨Finset.mem_biUnion.mpr ⟨β_top, Finset.mem_univ β_top,
                  Finsupp.mem_support_iff.mpr hz0⟩, ha'_not_pos⟩
              rw [Finset.sum_eq_single a']
              · exact Finsupp.single_eq_same
              · intro a _ hne
                exact Finsupp.single_eq_of_ne hne.symm
              · intro hmem
                exact False.elim (hmem ha'_mem)
          · have hlhs : (∑ j : Fin k,
                z β_top (e_neg j).1 * (Finsupp.single (e_neg j).1 (1 : B)) a') = 0 := by
              apply Finset.sum_eq_zero
              intro j _
              have hne_a : a' ≠ (e_neg j).1 := fun hEq' => ha' (hEq' ▸ (e_neg j).2)
              rw [Finsupp.single_eq_of_ne hne_a, mul_zero]
            have hrhs : (∑ x ∈ Supp.filter (fun a => ¬P_pos a),
                (Finsupp.single x (z β_top x)) a') = 0 := by
              apply Finset.sum_eq_zero
              intro a ha_mem
              have hne_a : a' ≠ a := fun hEq' => ha' (hEq' ▸ hSuppNeg a ha_mem)
              exact Finsupp.single_eq_of_ne hne_a
            rw [hlhs, hrhs]
        refine ⟨fun j => z β_top (e_neg j).1, b, hb_val, ?_⟩
        rw [hc_eq]
        exact hz_eq
    · refine ⟨0, Fin.elim0, fun j => Fin.elim0 j, ?_⟩
      intro z hz_val hz_coc
      obtain ⟨b, hb_val, hz_eq⟩ := hDecompCocycle z hz_val hz_coc
      let Supp : Finset (Fin (N + 1) → ℤ) := Finset.univ.biUnion (fun β => (z β).support)
      refine ⟨Fin.elim0, b, hb_val, ?_⟩
      have hEmptyFilter : Supp.filter (fun a => ¬P_pos a) = ∅ := by
        rw [Finset.filter_eq_empty_iff]
        intro a ha_supp ha_not_pos
        obtain ⟨β, _, ha_β⟩ := Finset.mem_biUnion.mp ha_supp
        have hne : z β a ≠ 0 := Finsupp.mem_support_iff.mp ha_β
        have hExp : IsValidLaurentExp N d β a := by
          by_contra hInv
          exact hne (hz_val β a hInv)
        have hle : p + 2 ≤ N + 1 := by
          have hcard := Fintype.card_le_of_injective β.1 β.2.injective
          simpa only [Fintype.card_fin] using hcard
        have hlt_card : (Finset.univ.image β.1).card < (Finset.univ : Finset (Fin (N + 1))).card := by
          rw [Finset.card_image_of_injective _ β.2.injective, Finset.card_univ,
            Finset.card_univ, Fintype.card_fin, Fintype.card_fin]
          omega
        obtain ⟨j₀, _, hj₀_notMem⟩ := Finset.exists_mem_notMem_of_card_lt_card hlt_card
        have hj₀_om : ∀ l : Fin (p + 2), β.1 l ≠ j₀ := by
          intro l hl
          exact hj₀_notMem (Finset.mem_image.mpr ⟨l, Finset.mem_univ l, hl⟩)
        exact ha_not_pos ⟨j₀, hExp.2 j₀ hj₀_om⟩
      have hz_neg_zero :
          (∑ x ∈ Supp.filter (fun a => ¬P_pos a), fun β => Finsupp.single x (z β x)) = 0 := by
        rw [hEmptyFilter, Finset.sum_empty]
      have hfin0_zero :
          (∑ j : Fin 0,
            (Fin.elim0 j : B) •
              (Fin.elim0 j : WeilStrictMonoTuple (N + 1) (p + 1) → ((Fin (N + 1) → ℤ) →₀ B))) = 0 := by
        simp
      rw [hfin0_zero]
      exact hz_eq.trans (by rw [hz_neg_zero])

theorem weil_proj_neg_twisted_free_sum_cohomology_finite (B : Type u) [CommRing B]
    (N D s : ℕ)
    (E : WeilPresheafModule
      (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) :=
         MvPolynomial.gradedAlgebra
       AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B)))
    (hLaur : ∀ d : ℤ,
      (∃ (k₀ : ℕ) (gen₀ : Fin k₀ → WeilStrictMonoTuple (N + 1) 0 → ((Fin (N + 1) → ℤ) →₀ B)),
        (∀ j : Fin k₀,
          IsValidLaurentCochain B N d 0 (gen₀ j) ∧ weilLaurentCechDiff B N 0 (gen₀ j) = 0) ∧
        ∀ z : WeilStrictMonoTuple (N + 1) 0 → ((Fin (N + 1) → ℤ) →₀ B),
          IsValidLaurentCochain B N d 0 z →
          weilLaurentCechDiff B N 0 z = 0 →
          ∃ c : Fin k₀ → B, z = ∑ j : Fin k₀, c j • gen₀ j) ∧
      (∀ p : ℕ,
        ∃ (k : ℕ) (gen : Fin k → WeilStrictMonoTuple (N + 1) (p + 1) → ((Fin (N + 1) → ℤ) →₀ B)),
          (∀ j : Fin k,
            IsValidLaurentCochain B N d (p + 1) (gen j) ∧
            weilLaurentCechDiff B N (p + 1) (gen j) = 0) ∧
          ∀ z : WeilStrictMonoTuple (N + 1) (p + 1) → ((Fin (N + 1) → ℤ) →₀ B),
            IsValidLaurentCochain B N d (p + 1) z →
            weilLaurentCechDiff B N (p + 1) z = 0 →
            ∃ (c : Fin k → B) (b : WeilStrictMonoTuple (N + 1) p → ((Fin (N + 1) → ℤ) →₀ B)),
              IsValidLaurentCochain B N d p b ∧
              z = (∑ j : Fin k, c j • gen j) + weilLaurentCechDiff B N p b)) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) :=
      MvPolynomial.gradedAlgebra
    let W_std : Fin (N + 1) →
        (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B)).Opens :=
      fun k => AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) (MvPolynomial.X k)
    let π_B : AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B) :=
      AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap B ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B 0)))
    IsWeilProjNegTwistedFreeSum B N D s E →
    HasFiniteWeilModuleCechCohomology π_B W_std E :=
by
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B
  letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let P_B : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
  let W_std : Fin (N + 1) → P_B.Opens :=
    fun k => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X k)
  let π_B : P_B ⟶ AlgebraicGeometry.Spec (CommRingCat.of B) :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B ↥(𝒜 0)))
  change IsWeilProjNegTwistedFreeSum B N D s E → HasFiniteWeilModuleCechCohomology π_B W_std E
  intro hTwist
  
  have hProdHom : ∀ (n : ℕ) (g : Fin n → Fin (N + 1)),
      (∏ l : Fin n, MvPolynomial.X (g l)) ∈ 𝒜 n := by
    intro n
    induction n with
    | zero =>
      intro g
      rw [Fin.prod_univ_zero]
      exact SetLike.one_mem_graded 𝒜
    | succ n ih =>
      intro g
      rw [Fin.prod_univ_succ]
      have hX0 : MvPolynomial.X (g 0) ∈ 𝒜 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X B (g 0))
      have hmul : MvPolynomial.X (g 0) * (∏ i : Fin n, MvPolynomial.X (g i.succ)) ∈
          𝒜 (1 + n) := SetLike.mul_mem_graded hX0 (ih (fun i => g i.succ))
      rwa [Nat.add_comm 1 n] at hmul
  have hChartInter : ∀ (p : ℕ) (α : WeilStrictMonoTuple (N + 1) p),
      weilCoverChartInter W_std α =
        AlgebraicGeometry.Proj.basicOpen 𝒜 (∏ l : Fin (p + 1), MvPolynomial.X (α.1 l)) := by
    have hGen : ∀ (n : ℕ) (g : Fin (n + 1) → Fin (N + 1)),
        Finset.univ.inf' ⟨0, Finset.mem_univ (0 : Fin (n + 1))⟩ (fun l => W_std (g l)) =
          AlgebraicGeometry.Proj.basicOpen 𝒜 (∏ l : Fin (n + 1), MvPolynomial.X (g l)) := by
      intro n
      induction n with
      | zero =>
        intro g
        rw [Fin.prod_univ_one]
        apply le_antisymm
        · exact Finset.inf'_le _ (Finset.mem_univ (0 : Fin 1))
        · refine Finset.le_inf' _ _ fun l _ => ?_
          rw [Fin.eq_zero l]
      | succ n ih =>
        intro g
        have hinf : Finset.univ.inf' ⟨0, Finset.mem_univ (0 : Fin (n + 2))⟩ (fun l => W_std (g l)) =
            W_std (g 0) ⊓
              Finset.univ.inf' ⟨0, Finset.mem_univ (0 : Fin (n + 1))⟩ (fun l => W_std (g l.succ)) := by
          apply le_antisymm
          · refine le_inf (Finset.inf'_le _ (Finset.mem_univ 0)) ?_
            exact Finset.le_inf' _ _ fun l _ => Finset.inf'_le _ (Finset.mem_univ l.succ)
          · refine Finset.le_inf' _ _ fun l _ => ?_
            refine Fin.cases ?_ ?_ l
            · exact inf_le_left
            · intro l'
              exact le_trans inf_le_right (Finset.inf'_le _ (Finset.mem_univ l'))
        rw [hinf, ih (fun l => g l.succ),
