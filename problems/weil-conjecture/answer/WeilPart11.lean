                rw [Finset.sum_mul]
                refine Finset.sum_congr rfl fun i' _ => mul_assoc _ _ _
            _ = ∑ i' : Fin (n₁ + 1), v i' * (∑ j : Fin (n₂ + 1), colB i' j * colA j i) := by
                rw [Finset.sum_comm]
                refine Finset.sum_congr rfl fun i' _ => (Finset.mul_sum _ _ _).symm
