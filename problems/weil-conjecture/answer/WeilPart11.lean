    obtain ⟨φ_p', w₁', w₂', hφp'_snd, hφp'_sec,
        hw₁'_fst, hw₁'_snd, hw₂'_fst, hw₂'_snd, hw_φp'⟩ :=
      hTrans_p φ_p hφp_snd hφp_sec hφp_gen
    have hu_p_eq : u_p' =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_h R_p)) ≫ u_h := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap B_h R_p).comp ρ_h)) = _
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    have hv_p_eq :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_p) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_h R_p)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_h_can) := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ_p_comp]
    let w₁_ph : CategoryTheory.Limits.pullback g₁ u_p' ⟶ CategoryTheory.Limits.pullback g₁ u_h :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g₁ u_p')
        (CategoryTheory.Limits.pullback.snd g₁ u_p' ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_h R_p)))
        (by rw [CategoryTheory.Category.assoc, ← hu_p_eq, CategoryTheory.Limits.pullback.condition])
    let w₂_ph : CategoryTheory.Limits.pullback g₂ u_p' ⟶ CategoryTheory.Limits.pullback g₂ u_h :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g₂ u_p')
        (CategoryTheory.Limits.pullback.snd g₂ u_p' ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_h R_p)))
        (by rw [CategoryTheory.Category.assoc, ← hu_p_eq, CategoryTheory.Limits.pullback.condition])
    have hw₁_comp : w₁' ≫ w₁_ph = w₁_can := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          hw₁'_fst, hw₁_can_fst]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, hw₁'_snd, CategoryTheory.Category.assoc,
          hv_p_eq, hw₁_can_snd]
    have hw₂_comp : w₂' ≫ w₂_ph = w₂_can := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          hw₂'_fst, hw₂_can_fst]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, hw₂'_snd, CategoryTheory.Category.assoc,
          hv_p_eq, hw₂_can_snd]
    obtain ⟨_hV₁_p_w, he₁_p_tri, he₁_p_bas, _hj₁_p_ex, hFunc₁_p⟩ :=
      hUniv₁ R_p ρ_p (algebraMap B_h R_p) rfl w₁_ph
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
    obtain ⟨_hV₂_p_w, he₂_p_tri, he₂_p_bas, _hj₂_p_ex, hFunc₂_p⟩ :=
      hUniv₂ R_p ρ_p (algebraMap B_h R_p) rfl w₂_ph
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
    obtain ⟨hV₁_pL, he₁_pL⟩ :=
      hFunc₁_p L (algebraMap B₀ L) w₁_can w₁' hV₁_L_w hw₁_comp
    obtain ⟨hV₂_pL, he₂_pL⟩ :=
      hFunc₂_p L (algebraMap B₀ L) w₂_can w₂' hV₂_L_w hw₂_comp
    obtain ⟨M_p, hMp, hMp_inv⟩ :=
      hInt_Coc R_p ρ_p ψ_p hψ_p_ρ φ_p' hφp'_snd hφp'_sec
        (M₁_pb R_p ρ_p) (eIdx₁ R_p ρ_p) (hPbM₁ R_p ρ_p).1 (hPbM₁ R_p ρ_p).2
        (M₂_pb R_p ρ_p) (eIdx₂ R_p ρ_p) (hPbM₂ R_p ρ_p).1 (hPbM₂ R_p ρ_p).2
        w₁' w₂' hw₁'_fst hw₁'_snd hw₂'_fst hw₂'_snd hw_φp'
        _ _ hV₁_pL hV₂_pL he₁_p_tri he₁_p_bas he₂_p_tri he₂_p_bas he₁_pL he₂_pL
    intro i j
    exact ⟨hFrac (M.val i j) ⟨M_p.val i j, hMp i j⟩,
      hFrac ((M⁻¹).val i j) ⟨(M_p⁻¹).val i j, hMp_inv i j⟩⟩

theorem weil_log_tricanonical_bundle_and_matrix_criterion (k : Type u) [Field k] [IsAlgClosed k] :
    (∀ (B₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
      AlgebraicGeometry.IsIntegral B₃.left →
      IsProjectiveOverField k B₃ →
      ∀ (C : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ B₃.left) (n : ℕ)
        (τ : Fin n → (B₃.left ⟶ C)),
        IsGeometricStablePointedCurve g n τ →
        HasGLProjBundleAtlas g) ∧
    HasLocalCurveIsoMatrixBridge k :=
by
  obtain ⟨hLogGlobal, hLogPair⟩ := weil_stable_curve_log_canonical_bundle_and_functoriality.{u}
  refine ⟨?_, ?_⟩
  · intro B₃ hIntB₃ hProjB₃ C g n τ hStab
    obtain ⟨N, ι, hCl⟩ := hProjB₃
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have _ : AlgebraicGeometry.IsClosedImmersion ι.left := hCl
    have hProjDef : (weilProjectiveSpaceOver k N).left = AlgebraicGeometry.Proj 𝒜 := rfl
    have hSepB₃ : B₃.left.IsSeparated := by
      rw [AlgebraicGeometry.Scheme.isSeparated_iff]
      have hSepProj : (weilProjectiveSpaceOver k N).left.IsSeparated := by
        rw [hProjDef]; infer_instance
      rw [AlgebraicGeometry.Scheme.isSeparated_iff] at hSepProj
      have hTermEq : CategoryTheory.Limits.terminal.from B₃.left =
          ι.left ≫ CategoryTheory.Limits.terminal.from (weilProjectiveSpaceOver k N).left :=
        CategoryTheory.Limits.terminal.hom_ext _ _
      rw [hTermEq]
      exact CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance hSepProj
    have hAlgFT : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) := by
      classical
      let sX : Finset (MvPolynomial (Fin (N + 1)) k) := Finset.univ.image MvPolynomial.X
      let S_sub : Subalgebra ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) := Algebra.adjoin ↥(𝒜 0) ↑sX
      have h_all : ∀ p : MvPolynomial (Fin (N + 1)) k, p ∈ S_sub := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C c =>
          have hc : MvPolynomial.C c ∈ 𝒜 0 := MvPolynomial.isHomogeneous_C (Fin (N + 1)) c
          exact S_sub.algebraMap_mem ⟨MvPolynomial.C c, hc⟩
        | add p q hp hq => exact S_sub.add_mem hp hq
        | mul_X p i hp =>
          exact S_sub.mul_mem hp
            (Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_univ i))))
      refine ⟨⟨sX, eq_top_iff.mpr fun p _ => h_all p⟩⟩
    have hHomEq : B₃.hom = ι.left ≫ (weilProjectiveSpaceOver k N).hom := (Over.w ι).symm
    have _ : CompactSpace ↥(weilProjectiveSpaceOver k N).left := by
      change CompactSpace ↥(AlgebraicGeometry.Proj 𝒜)
      have _ : AlgebraicGeometry.QuasiCompact (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
        inferInstance
      exact AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace
        (AlgebraicGeometry.Proj.toSpecZero 𝒜)
    have hCompB₃ : CompactSpace ↥B₃.left :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace ι.left
    have _ : AlgebraicGeometry.LocallyOfFiniteType B₃.hom := by
      rw [hHomEq]
      change AlgebraicGeometry.LocallyOfFiniteType
        (ι.left ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))))
      have hC_surj : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
        intro y
        refine ⟨MvPolynomial.constantCoeff y.1, Subtype.ext ?_⟩
        have hy0 : y.1.IsHomogeneous 0 := y.2
        have hy_eq : MvPolynomial.C (MvPolynomial.constantCoeff y.1) = y.1 := by
          ext m
          rw [MvPolynomial.coeff_C]
          split_ifs with hm
          · subst hm; rfl
          · symm
            by_contra hne
            have hdeg := hy0 hne
            simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, Pi.one_apply, mul_one] at hdeg
            apply hm
            symm
            ext i
            by_cases hi : i ∈ m.support
            · exact Nat.eq_zero_of_le_zero
                (hdeg ▸ Finset.single_le_sum (fun _ _ => Nat.zero_le _) hi)
            · exact Finsupp.notMem_support_iff.mp hi
        change (algebraMap k ↥(𝒜 0) (MvPolynomial.constantCoeff y.1)).1 = y.1
        rw [Algebra.algebraMap_eq_smul_one]
        change (MvPolynomial.constantCoeff y.1) • (1 : MvPolynomial (Fin (N + 1)) k) = y.1
        rw [Algebra.smul_def, mul_one]
        exact hy_eq
      have hFT_map : (algebraMap k ↥(𝒜 0)).FiniteType :=
        RingHom.FiniteType.of_surjective _ hC_surj
      have hLftSpec : AlgebraicGeometry.LocallyOfFiniteType
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
        AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr hFT_map
      have hLftProj : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
        inferInstance
      have hLftCl : AlgebraicGeometry.LocallyOfFiniteType ι.left := inferInstance
      exact CategoryTheory.MorphismProperty.comp_mem _ _ _ hLftCl
        (CategoryTheory.MorphismProperty.comp_mem _ _ _ hLftProj hLftSpec)
    have hNoethB₃ : ∀ U : B₃.left.Opens, AlgebraicGeometry.IsAffineOpen U →
        IsNoetherianRing ↑(B₃.left.presheaf.obj (Opposite.op U)) := by
      intro U hU
      have hTopAff : AlgebraicGeometry.IsAffineOpen (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k)).Opens) :=
        AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of k))
      have hFT_U : (B₃.hom.appLE ⊤ U (fun _ _ => trivial)).hom.FiniteType :=
        B₃.hom.finiteType_appLE hTopAff hU (fun _ _ => trivial)
      have _ : IsNoetherianRing ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤)) :=
        isNoetherianRing_of_ringEquiv k
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv
      let _ : Algebra ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤))
          ↑(B₃.left.presheaf.obj (Opposite.op U)) :=
        (B₃.hom.appLE ⊤ U (fun _ _ => trivial)).hom.toAlgebra
      have _ : Algebra.FiniteType
          ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤))
          ↑(B₃.left.presheaf.obj (Opposite.op U)) := hFT_U
      exact Algebra.FiniteType.isNoetherianRing
        ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤))
        ↑(B₃.left.presheaf.obj (Opposite.op U))
    obtain ⟨M, hAffM, hLogFib⟩ := hLogGlobal B₃.left hCompB₃ hSepB₃ hNoethB₃ C g n τ hStab
    refine weil_proj_bundle_atlas_of_relative_very_ample_lineBundle
      B₃.left hIntB₃ hCompB₃ hSepB₃ hNoethB₃ C g
      hStab.2.1 hStab.2.2.1 hStab.2.2.2.1 M hAffM ?_
      (fun R _ _ C_R g_R hFlat hProp hLfp M_R hAffMR hFib =>
        weil_proper_flat_lineBundle_cohomology_baseChange_and_projImmersion
          R C_R g_R hFlat hProp hLfp M_R hAffMR hFib)
    intro Ω _ _ s M_s hPb
    obtain ⟨τ_s, hStab_s, hLog_s⟩ := hLogFib Ω s M_s hPb
    exact weil_algClosed_stable_curve_log_tricanonical_very_ample Ω _ _ n τ_s hStab_s M_s hLog_s
  · refine weil_curve_iso_matrix_bridge_of_functorial_very_ample_lineBundle k ?_
      (fun R _ _ C_R g_R hFlat hProp hLfp M_R hAffMR hFib =>
        weil_proper_flat_lineBundle_cohomology_baseChange_and_projImmersion
          R C_R g_R hFlat hProp hLfp M_R hAffMR hFib)
    intro R _ _ n C₁ C₂ g₁ τ₁ g₂ τ₂ hStab₁ hStab₂
    obtain ⟨M₁, M₂, hAff₁, hAff₂, hLog₁, hLog₂, hCocycle⟩ :=
      hLogPair R n C₁ C₂ g₁ τ₁ g₂ τ₂ hStab₁ hStab₂
    refine ⟨M₁, M₂, hAff₁, hAff₂, ?_, ?_, hCocycle⟩
    · intro Ω _ _ s M_s hPb
      obtain ⟨τ_s, hStab_s, hLog_s⟩ := hLog₁ Ω s M_s hPb
      exact weil_algClosed_stable_curve_log_tricanonical_very_ample Ω _ _ n τ_s hStab_s M_s hLog_s
    · intro Ω _ _ s M_s hPb
      obtain ⟨τ_s, hStab_s, hLog_s⟩ := hLog₂ Ω s M_s hPb
      exact weil_algClosed_stable_curve_log_tricanonical_very_ample Ω _ _ n τ_s hStab_s M_s hLog_s

theorem weil_equichar_dvr_cohen_powerSeries_embedding (k : Type u) [Field k]
    (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Algebra k R]
    (π : R) (hπ : Irreducible π) :
    ∃ (ι : R →+* PowerSeries (AlgebraicClosure (IsLocalRing.ResidueField R))),
      ι π = PowerSeries.X ∧
      IsLocalHom ι ∧
      Function.Injective ι ∧
      ι.FaithfullyFlat :=
by
  
  let K₀ : Type u := ↥(⊥ : Subfield k)
  let j₀ : K₀ →+* k := (⊥ : Subfield k).subtype
  have hj₀_inj : Function.Injective j₀ := (⊥ : Subfield k).subtype_injective
  have hPerf : PerfectField K₀ := by
    rcases CharP.exists' k with h0 | ⟨p, hp, hchar⟩
    · have : CharZero K₀ := (RingHom.charZero_iff hj₀_inj).mpr h0
      exact PerfectField.ofCharZero
    · have : CharP K₀ p := (RingHom.charP_iff j₀ hj₀_inj p).mpr hchar
      let : Fintype K₀ := Subfield.fintypeBot k p
      exact PerfectField.ofFinite
  let : PerfectField K₀ := hPerf
  let κ_R : Type u := IsLocalRing.ResidueField R
  let : Algebra K₀ R := ((algebraMap k R).comp j₀).toAlgebra
  let : Algebra K₀ κ_R := ((IsLocalRing.residue R).comp ((algebraMap k R).comp j₀)).toAlgebra
  let f : R →ₐ[K₀] κ_R := { IsLocalRing.residue R with commutes' := fun _ => rfl }
  have hf_surj : Function.Surjective f := IsLocalRing.residue_surjective

  
  have hFS_gen : ∀ (K L : Type u) [Field K] [PerfectField K] [Field L] [Algebra K L],
      Algebra.FormallySmooth K L := by
    intro K L _ _ _ _
    apply Algebra.FormallySmooth.mk
    · exact Module.Projective.of_free
    · let P : Algebra.Generators K L L := Algebra.Generators.self K L
      have : Algebra.FormallySmooth K P.toExtension.Ring := by
        change Algebra.FormallySmooth K (MvPolynomial L K)
        infer_instance
      rw [← Algebra.Extension.cotangentComplex_injective_iff P.toExtension]
      rw [injective_iff_map_eq_zero]
      intro c hc
      obtain ⟨⟨p, hp⟩, rfl⟩ := Algebra.Extension.Cotangent.mk_surjective c
      let p₀ : MvPolynomial L K := p
      obtain ⟨s, q, hpq⟩ := MvPolynomial.exists_finset_rename p₀
      let E : IntermediateField K L := IntermediateField.adjoin K (↑s : Set L)
      let inc : ↥s → ↥E := fun x => ⟨x.1, IntermediateField.subset_adjoin K (↑s : Set L) x.2⟩
      let p_E : MvPolynomial ↥E K := MvPolynomial.rename inc q
      let φ : MvPolynomial ↥E K →ₐ[K] MvPolynomial L K :=
        MvPolynomial.rename (Subtype.val : ↥E → L)
      have hφ_pE : φ p_E = p₀ := by
        dsimp [φ, p_E]
        rw [MvPolynomial.rename_rename]
        exact hpq.symm
      have : Algebra.EssFiniteType K ↥E :=
        IntermediateField.essFiniteType_iff.mpr (IntermediateField.fg_adjoin_finset s)
      have : Algebra.FormallySmooth K ↥E := Algebra.FormallySmooth.of_perfectField
      let P_E : Algebra.Generators K ↥E ↥E := Algebra.Generators.self K ↥E
      have : Algebra.FormallySmooth K P_E.toExtension.Ring := by
        change Algebra.FormallySmooth K (MvPolynomial ↥E K)
        infer_instance
      have haeval_φ_hom :
          (MvPolynomial.aeval (id : L → L)).comp φ =
            E.val.comp (MvPolynomial.aeval (id : ↥E → ↥E)) := by
        apply MvPolynomial.algHom_ext
        intro x
        simp [φ]
      have haeval_φ : ∀ g : MvPolynomial ↥E K,
          (MvPolynomial.aeval (id : L → L)) (φ g) =
            E.val ((MvPolynomial.aeval (id : ↥E → ↥E)) g) :=
        fun g => AlgHom.congr_fun haeval_φ_hom g
      have hp_val : (MvPolynomial.aeval (id : L → L)) p₀ = 0 :=
        (P.algebraMap_apply p₀).symm.trans (RingHom.mem_ker.mp hp)
      have hinj_Eval : Function.Injective E.val := E.val.injective
      let p_E_ext : P_E.toExtension.Ring := p_E
      have hp_E : p_E_ext ∈ P_E.toExtension.ker := by
        rw [RingHom.mem_ker]
        apply hinj_Eval
        rw [map_zero]
        exact (congrArg E.val (P_E.algebraMap_apply p_E)).trans
          ((haeval_φ p_E).symm.trans (by rw [hφ_pE]; exact hp_val))
      let c_E : P_E.toExtension.Cotangent := Algebra.Extension.Cotangent.mk ⟨p_E_ext, hp_E⟩
      have hc_E_complex : P_E.toExtension.cotangentComplex c_E = 0 := by
        apply P_E.cotangentSpaceBasis.repr.injective
        rw [map_zero]
        ext e
        simp only [Finsupp.zero_apply, ZeroMemClass.coe_zero]
        change E.val ((P_E.cotangentSpaceBasis.repr (P_E.toExtension.cotangentComplex c_E)) e) = 0
        have h1 : (P_E.cotangentSpaceBasis.repr (P_E.toExtension.cotangentComplex c_E)) e =
            (MvPolynomial.aeval (id : ↥E → ↥E)) (MvPolynomial.pderiv e p_E) :=
          P_E.cotangentSpaceBasis_repr_one_tmul p_E_ext e
        have h2 : (P.cotangentSpaceBasis.repr
            (P.toExtension.cotangentComplex (Algebra.Extension.Cotangent.mk ⟨p, hp⟩))) e.1 =
            (MvPolynomial.aeval (id : L → L)) (MvPolynomial.pderiv e.1 p₀) :=
          P.cotangentSpaceBasis_repr_one_tmul p e.1
        rw [h1, ← haeval_φ]
        change (MvPolynomial.aeval (id : L → L))
            ((MvPolynomial.rename (Subtype.val : ↥E → L)) (MvPolynomial.pderiv e p_E)) = 0
        rw [← MvPolynomial.pderiv_rename Subtype.val_injective e p_E]
        change (MvPolynomial.aeval (id : L → L)) (MvPolynomial.pderiv e.1 (φ p_E)) = 0
        rw [hφ_pE, ← h2, hc, map_zero, Finsupp.zero_apply]
      have hInj_E : Function.Injective P_E.toExtension.cotangentComplex :=
        (Algebra.Extension.cotangentComplex_injective_iff P_E.toExtension).mpr
          Algebra.FormallySmooth.subsingleton_h1Cotangent
      have hc_E : c_E = 0 := hInj_E (hc_E_complex.trans (map_zero _).symm)
      let f_ext : P_E.toExtension.Hom P.toExtension :=
        { toRingHom := φ.toRingHom
          toRingHom_algebraMap := fun x => by
            change φ (algebraMap K (MvPolynomial ↥E K) x) =
              algebraMap K (MvPolynomial L K) x
            exact φ.commutes x
          algebraMap_toRingHom := fun x => by
            let x₀ : MvPolynomial ↥E K := x
            exact (P.algebraMap_apply (φ x₀)).trans
              ((haeval_φ x₀).trans (congrArg E.val (P_E.algebraMap_apply x₀).symm)) }
      have h_map_cE :
          (Algebra.Extension.Cotangent.map f_ext) c_E =
            Algebra.Extension.Cotangent.mk ⟨p, hp⟩ :=
        (Algebra.Extension.Cotangent.map_mk f_ext ⟨p_E_ext, hp_E⟩).trans
          (by congr 1; ext; exact hφ_pE)
      rw [hc_E, map_zero] at h_map_cE
      exact h_map_cE.symm
  have : Algebra.FormallySmooth K₀ κ_R := hFS_gen K₀ κ_R

  
  obtain ⟨g_sec, hg_sec⟩ := Algebra.FormallySmooth.exists_kerProj_comp_eq_id f hf_surj
  let I : Ideal R := RingHom.ker f
  let A : Type u := AdicCompletion I R
  let res : A →+* κ_R := (AdicCompletion.kerProj hf_surj).toRingHom
  let σ : κ_R →+* A := g_sec.toRingHom
  have hsec : ∀ x : κ_R, res (σ x) = x := fun x =>
    AlgHom.congr_fun hg_sec x

  
  let ϖ : A := algebraMap R A π
  have hI_eq : I = Ideal.span {π} := by
    rw [← hπ.maximalIdeal_eq]
    ext r
    change (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R)) r = 0 ↔
      r ∈ IsLocalRing.maximalIdeal R
    exact Ideal.Quotient.eq_zero_iff_mem
  have hIn_eq : ∀ n : ℕ, I ^ n = Ideal.span {π ^ n} := fun n => by
    rw [hI_eq, Ideal.span_singleton_pow]
  have hIn_smul : ∀ n : ℕ, (I ^ n : Ideal R) • (⊤ : Submodule R R) = I ^ n := fun n => by
    rw [Ideal.smul_eq_mul, Ideal.mul_top]
  have h_of_eq : ∀ r : R, AdicCompletion.of I R r = algebraMap R A r := by
    intro r
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [AdicCompletion.evalₐ_of, AlgHom.commutes]
    rfl
  have hres_alg : ∀ r : R, res (algebraMap R A r) = f r := by
    intro r
    change (AdicCompletion.kerProj hf_surj) (algebraMap R A r) = f r
    rw [← h_of_eq r, AdicCompletion.kerProj_of]
  have hres_ϖ : res ϖ = 0 := by
    rw [hres_alg]
    have hπ_mem : π ∈ I := by
      rw [hI_eq]
      exact Ideal.mem_span_singleton_self π
    exact hπ_mem
  have hker : ∀ a : A, res a = 0 → ∃ b : A, a = ϖ * b := by
    intro a
    refine AdicCompletion.induction_on I R
      (p := fun x => res x = 0 → ∃ b : A, x = ϖ * b) a (fun s ha => ?_)
    let s_fn : ℕ → R := s.1
    have hs_step : ∀ n : ℕ, s_fn n - s_fn (n + 1) ∈ I ^ n := by
      intro n
      have h := SModEq.sub_mem.mp (s.2 (Nat.le_succ n))
      rwa [hIn_smul] at h
    have hs_diff1 : ∀ n : ℕ, s_fn (n + 1) - s_fn 1 ∈ I := by
      intro n
      have h := SModEq.sub_mem.mp ((s.2 (Nat.succ_le_succ (Nat.zero_le n))).symm)
      rwa [hIn_smul, pow_one] at h
    have hq_ex : ∀ n : ℕ, ∃ q : R, π * q = s_fn (n + 1) - s_fn 1 := by
      intro n
      have hm : s_fn (n + 1) - s_fn 1 ∈ Ideal.span {π} := hI_eq ▸ hs_diff1 n
      obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp hm
      exact ⟨q, hq.symm⟩
    choose q_fun hq_fun using hq_ex
    have hq_cauchy : ∀ n : ℕ, q_fun n ≡ q_fun (n + 1) [SMOD (I ^ n : Ideal R) • (⊤ : Submodule R R)] := by
      intro n
      rw [SModEq.sub_mem, hIn_smul, hIn_eq, Ideal.mem_span_singleton]
      have hmul : π * (q_fun n - q_fun (n + 1)) = s_fn (n + 1) - s_fn (n + 2) := by
        calc π * (q_fun n - q_fun (n + 1))
            = π * q_fun n - π * q_fun (n + 1) := by ring
          _ = (s_fn (n + 1) - s_fn 1) - (s_fn (n + 2) - s_fn 1) := by
              rw [hq_fun n, hq_fun (n + 1)]
          _ = s_fn (n + 1) - s_fn (n + 2) := by ring
      have hmem : s_fn (n + 1) - s_fn (n + 2) ∈ Ideal.span {π ^ (n + 1)} := by
        rw [← hIn_eq]
        exact hs_step (n + 1)
      rw [Ideal.mem_span_singleton] at hmem
      obtain ⟨u, hu⟩ := hmem
      refine ⟨u, ?_⟩
      apply mul_left_cancel₀ hπ.ne_zero
      calc π * (q_fun n - q_fun (n + 1))
          = s_fn (n + 1) - s_fn (n + 2) := hmul
        _ = π ^ (n + 1) * u := hu
        _ = π * (π ^ n * u) := by rw [pow_succ']; ring
    let q_seq : AdicCompletion.AdicCauchySequence I R :=
      AdicCompletion.AdicCauchySequence.mk I R q_fun hq_cauchy
    let b₁ : A := AdicCompletion.mk I R q_seq
    have h_decomp : AdicCompletion.mk I R s = algebraMap R A (s_fn 1) + ϖ * b₁ := by
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [AdicCompletion.evalₐ_mk, map_add, map_mul, AlgHom.commutes]
      dsimp [ϖ, b₁]
      rw [AlgHom.commutes, AdicCompletion.evalₐ_mk, AdicCompletion.AdicCauchySequence.mk_coe]
      change Ideal.Quotient.mk (I ^ n) (s_fn n) =
        Ideal.Quotient.mk (I ^ n) (s_fn 1) +
          Ideal.Quotient.mk (I ^ n) π * Ideal.Quotient.mk (I ^ n) (q_fun n)
      rw [← map_mul, ← map_add]
      have h_eq : s_fn 1 + π * q_fun n = s_fn (n + 1) := by
        rw [hq_fun n]; ring
      rw [h_eq, Ideal.Quotient.eq]
      exact hs_step n
    have hs1_mem : s_fn 1 ∈ Ideal.span {π} := by
      rw [← hI_eq]
      change f (s_fn 1) = 0
      rw [← hres_alg]
      have hres_decomp := congrArg res h_decomp
      rw [ha, map_add, map_mul, hres_ϖ, zero_mul, add_zero] at hres_decomp
      exact hres_decomp.symm
    obtain ⟨q₀, hq₀⟩ := Ideal.mem_span_singleton.mp hs1_mem
    refine ⟨algebraMap R A q₀ + b₁, ?_⟩
    rw [h_decomp, hq₀, map_mul, mul_add]
  have hreg : ∀ b : A, ϖ * b = 0 → b = 0 := by
    intro b
    refine AdicCompletion.induction_on I R
      (p := fun x => ϖ * x = 0 → x = 0) b (fun t hb => ?_)
    let t_fn : ℕ → R := t.1
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [AdicCompletion.evalₐ_mk, map_zero, Ideal.Quotient.eq_zero_iff_mem]
    have h_ev := congrArg (AdicCompletion.evalₐ I (n + 1)) hb
    rw [map_mul, map_zero] at h_ev
    dsimp [ϖ] at h_ev
    rw [AlgHom.commutes, AdicCompletion.evalₐ_mk] at h_ev
    change Ideal.Quotient.mk (I ^ (n + 1)) π * Ideal.Quotient.mk (I ^ (n + 1)) (t_fn (n + 1)) = 0 at h_ev
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, hIn_eq, Ideal.mem_span_singleton] at h_ev
    obtain ⟨v, hv⟩ := h_ev
    have ht_succ : t_fn (n + 1) ∈ I ^ n := by
      rw [hIn_eq, Ideal.mem_span_singleton]
      refine ⟨v, ?_⟩
      apply mul_left_cancel₀ hπ.ne_zero
      calc π * t_fn (n + 1)
          = π ^ (n + 1) * v := hv
        _ = π * (π ^ n * v) := by rw [pow_succ']; ring
    have ht_step : t_fn n - t_fn (n + 1) ∈ I ^ n := by
      have h := SModEq.sub_mem.mp (t.2 (Nat.le_succ n))
      rwa [hIn_smul] at h
    have h_sum : t_fn n = (t_fn n - t_fn (n + 1)) + t_fn (n + 1) := by ring
    change t_fn n ∈ I ^ n
    rw [h_sum]
    exact add_mem ht_step ht_succ

  
  have hδ_ex : ∀ a : A, ∃ b : A, a = σ (res a) + ϖ * b := by
    intro a
    have ha0 : res (a - σ (res a)) = 0 := by
      rw [map_sub, hsec, sub_self]
    obtain ⟨b, hb⟩ := hker (a - σ (res a)) ha0
    refine ⟨b, ?_⟩
    calc a = σ (res a) + (a - σ (res a)) := by ring
      _ = σ (res a) + ϖ * b := by rw [hb]
  choose δ hδ using hδ_ex
  have δ_eq : ∀ (a b : A), a = σ (res a) + ϖ * b → δ a = b := by
    intro a b hab
    have hdiff : ϖ * (δ a - b) = 0 := by
      calc ϖ * (δ a - b)
          = (σ (res a) + ϖ * δ a) - (σ (res a) + ϖ * b) := by ring
        _ = a - a := by rw [← hδ a, ← hab]
        _ = 0 := sub_self a
    exact sub_eq_zero.mp (hreg (δ a - b) hdiff)
  have hδ_zero : δ 0 = 0 := by
    apply δ_eq
    simp
  have hδ_one : δ 1 = 0 := by
    apply δ_eq
    simp
  have hδ_ϖ : δ ϖ = 1 := by
    apply δ_eq
    rw [hres_ϖ, map_zero, zero_add, mul_one]
  have hδ_add : ∀ a b : A, δ (a + b) = δ a + δ b := by
    intro a b
    apply δ_eq
    calc a + b
        = (σ (res a) + ϖ * δ a) + (σ (res b) + ϖ * δ b) := by rw [← hδ a, ← hδ b]
      _ = (σ (res a) + σ (res b)) + ϖ * (δ a + δ b) := by ring
      _ = σ (res (a + b)) + ϖ * (δ a + δ b) := by rw [map_add, map_add]
  have hδ_smul : ∀ (x : κ_R) (b : A), δ (σ x * b) = σ x * δ b := by
    intro x b
    apply δ_eq
    have hres_xb : res (σ x * b) = x * res b := by
      rw [map_mul, hsec]
    rw [hres_xb, map_mul]
    calc σ x * b
        = σ x * (σ (res b) + ϖ * δ b) := by rw [← hδ b]
      _ = σ x * σ (res b) + ϖ * (σ x * δ b) := by ring
  have hδ_mul : ∀ a b : A, δ (a * b) = σ (res a) * δ b + δ a * b := by
    intro a b
    apply δ_eq
    rw [map_mul, map_mul]
    calc a * b
        = (σ (res a) + ϖ * δ a) * b := by rw [← hδ a]
      _ = σ (res a) * b + ϖ * (δ a * b) := by ring
      _ = σ (res a) * (σ (res b) + ϖ * δ b) + ϖ * (δ a * b) := by rw [← hδ b]
      _ = σ (res a) * σ (res b) + ϖ * (σ (res a) * δ b + δ a * b) := by ring
  let c : ℕ → A → κ_R := fun n a => res ((δ^[n]) a)
  have hc_succ : ∀ (n : ℕ) (a : A), c (n + 1) a = c n (δ a) := fun _ _ => rfl
  have hc_zero : ∀ n : ℕ, c n 0 = 0 := by
    intro n
    induction n with
    | zero => exact map_zero res
    | succ n ih => rw [hc_succ, hδ_zero, ih]
  have hc_add : ∀ (n : ℕ) (a b : A), c n (a + b) = c n a + c n b := by
    intro n
    induction n with
    | zero => intro a b; exact map_add res a b
    | succ n ih => intro a b; rw [hc_succ, hδ_add, ih, ← hc_succ, ← hc_succ]
  have hc_smul : ∀ (n : ℕ) (x : κ_R) (b : A), c n (σ x * b) = x * c n b := by
    intro n
    induction n with
    | zero => intro x b; dsimp [c]; rw [map_mul, hsec]
    | succ n ih => intro x b; rw [hc_succ, hδ_smul, ih, ← hc_succ]
  have hc_one : ∀ n : ℕ, c n 1 = if n = 0 then 1 else 0 := by
    intro n
    cases n with
    | zero => simp [c]
    | succ n => rw [hc_succ, hδ_one, hc_zero]; simp
  have hc_mul : ∀ (n : ℕ) (a b : A),
      c n (a * b) = ∑ p ∈ Finset.HasAntidiagonal.antidiagonal n, c p.1 a * c p.2 b := by
    intro n
    induction n with
    | zero =>
      intro a b
      simp [c, map_mul]
    | succ n ih =>
      intro a b
      rw [hc_succ, hδ_mul, hc_add, hc_smul, ← hc_succ, ih (δ a) b]
      rw [Finset.Nat.antidiagonal_succ, Finset.sum_cons, Finset.sum_map]
      congr 1
  let Φ : A →+* PowerSeries κ_R :=
    { toFun := fun a => PowerSeries.mk (fun n => c n a)
      map_one' := by
        ext n
        rw [PowerSeries.coeff_mk, PowerSeries.coeff_one, hc_one]
      map_mul' := by
        intro a b
        ext n
        rw [PowerSeries.coeff_mk, PowerSeries.coeff_mul, hc_mul]
        apply Finset.sum_congr rfl
        intro p _
        rw [PowerSeries.coeff_mk, PowerSeries.coeff_mk]
      map_zero' := by
        ext n
        rw [PowerSeries.coeff_mk, map_zero, hc_zero]
      map_add' := by
        intro a b
        ext n
        rw [PowerSeries.coeff_mk, map_add, PowerSeries.coeff_mk, PowerSeries.coeff_mk, hc_add] }
  have hΦ_ϖ : Φ ϖ = PowerSeries.X := by
    ext n
    dsimp [Φ]
    rw [PowerSeries.coeff_mk, PowerSeries.coeff_X]
    cases n with
    | zero =>
      simp [c, hres_ϖ]
    | succ n =>
      rw [hc_succ, hδ_ϖ, hc_one]
      cases n <;> simp

  
  have hDVR_ff : ∀ (S₀ : Type u) [CommRing S₀] [IsDomain S₀] [IsDiscreteValuationRing S₀]
      (π_S : S₀), Irreducible π_S →
      ∀ (f₀ : R →+* S₀), f₀ π = π_S →
      IsLocalHom f₀ ∧ Function.Injective f₀ ∧ f₀.FaithfullyFlat := by
    intro S₀ _ _ _ π_S hπ_S f₀ hf₀
    have hInj : Function.Injective f₀ := by
      rw [injective_iff_map_eq_zero]
      intro r hr0
      by_contra hr_ne
      obtain ⟨m, u, hu⟩ := IsDiscreteValuationRing.associated_pow_irreducible hr_ne hπ
      have h_map := congrArg f₀ hu
      rw [map_mul, hr0, zero_mul, map_pow, hf₀] at h_map
      exact pow_ne_zero m hπ_S.ne_zero h_map.symm
    have hLocal : IsLocalHom f₀ := by
      refine ⟨fun r hr_unit => ?_⟩
      have hr_ne : r ≠ 0 := by
        rintro rfl
        rw [map_zero] at hr_unit
        exact not_isUnit_zero hr_unit
      obtain ⟨m, u, hu⟩ := IsDiscreteValuationRing.associated_pow_irreducible hr_ne hπ
      have hpow_unit : IsUnit (π_S ^ m) := by
        have h_map := congrArg f₀ hu
        rw [map_mul, map_pow, hf₀] at h_map
        rw [← h_map]
        exact hr_unit.mul (u.isUnit.map f₀)
      cases m with
      | zero =>
        rw [pow_zero] at hu
        exact isUnit_iff_exists_inv.mpr ⟨(u : R), hu⟩
      | succ m =>
        rw [pow_succ'] at hpow_unit
        exact False.elim (hπ_S.not_isUnit (isUnit_of_mul_isUnit_left hpow_unit))
    have hFF : f₀.FaithfullyFlat := by
      let : Algebra R S₀ := f₀.toAlgebra
      have : Module.IsTorsionFree R S₀ :=
        (Module.isTorsionFree_iff_algebraMap_injective (R := R) (A := S₀)).mpr hInj
      have : Module.Flat R S₀ := inferInstance
      have : IsLocalHom (algebraMap R S₀) := hLocal
      have hMFF : Module.FaithfullyFlat R S₀ :=
        Module.FaithfullyFlat.of_flat_of_isLocalHom
      exact (RingHom.faithfullyFlat_algebraMap_iff (R := R) (S := S₀)).mpr hMFF
    exact ⟨hLocal, hInj, hFF⟩

  let Ω : Type u := AlgebraicClosure κ_R
  let ι : R →+* PowerSeries Ω :=
    (PowerSeries.map (algebraMap κ_R Ω)).comp (Φ.comp (algebraMap R A))
  have hι_π : ι π = PowerSeries.X := by
    change (PowerSeries.map (algebraMap κ_R Ω)) (Φ ϖ) = PowerSeries.X
    rw [hΦ_ϖ, PowerSeries.map_X]
  obtain ⟨hLocal, hInj, hFF⟩ :=
    hDVR_ff (PowerSeries Ω) PowerSeries.X PowerSeries.X_irreducible ι hι_π
  exact ⟨ι, hι_π, hLocal, hInj, hFF⟩

theorem weil_dvr_faithfullyFlat_pointed_curve_iso_descent (R RStar : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing RStar] [IsDomain RStar] [IsDiscreteValuationRing RStar]
    (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K]
    (π : R) (hπ : Irreducible π)
    (πStar : RStar) (hπStar : Irreducible πStar)
    (ι : R →+* RStar) (hι_π : ι π = πStar) (hι_ff : ι.FaithfullyFlat)
    (n : ℕ)
    (C₁ C₂ : AlgebraicGeometry.Scheme.{u})
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₁))
    (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₂))
    (hStab₁ : IsGeometricStablePointedCurve g₁ n τ₁)
    (hStab₂ : IsGeometricStablePointedCurve g₂ n τ₂)
    (hSm₁ : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (CategoryTheory.Limits.pullback.snd g₁
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K)))))
    (φ_K : CategoryTheory.Limits.pullback g₁
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))) ≅
      CategoryTheory.Limits.pullback g₂
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))))
    (hφK_snd : φ_K.hom ≫ CategoryTheory.Limits.pullback.snd g₂
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))) =
      CategoryTheory.Limits.pullback.snd g₁
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))))
    (hφK_sec : ∀ j : Fin n,
      ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
          CategoryTheory.Limits.pullback g₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K)))),
        s₁ ≫ CategoryTheory.Limits.pullback.fst g₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ τ₁ j →
        s₁ ≫ CategoryTheory.Limits.pullback.snd g₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) →
        (s₁ ≫ φ_K.hom) ≫ CategoryTheory.Limits.pullback.fst g₂
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ τ₂ j)
    (hExtRStar : ∀ (C₁' C₂' : AlgebraicGeometry.Scheme.{u})
      (g₁' : C₁' ⟶ AlgebraicGeometry.Spec (CommRingCat.of RStar))
      (τ₁' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of RStar) ⟶ C₁'))
      (g₂' : C₂' ⟶ AlgebraicGeometry.Spec (CommRingCat.of RStar))
      (τ₂' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of RStar) ⟶ C₂')),
      IsGeometricStablePointedCurve g₁' n τ₁' →
      IsGeometricStablePointedCurve g₂' n τ₂' →
      AlgebraicGeometry.IsIntegral C₁' →
      AlgebraicGeometry.IsIntegral C₂' →
      let η_K' := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap RStar (FractionRing RStar)))
      AlgebraicGeometry.SmoothOfRelativeDimension 1
        (CategoryTheory.Limits.pullback.snd g₁' η_K') →
      ∀ (φ_K' : CategoryTheory.Limits.pullback g₁' η_K' ≅
          CategoryTheory.Limits.pullback g₂' η_K'),
        φ_K'.hom ≫ CategoryTheory.Limits.pullback.snd g₂' η_K' =
          CategoryTheory.Limits.pullback.snd g₁' η_K' →
        (∀ j : Fin n,
          ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing RStar)) ⟶
              CategoryTheory.Limits.pullback g₁' η_K'),
            s₁ ≫ CategoryTheory.Limits.pullback.fst g₁' η_K' = η_K' ≫ τ₁' j →
            s₁ ≫ CategoryTheory.Limits.pullback.snd g₁' η_K' =
              𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (FractionRing RStar))) →
            (s₁ ≫ φ_K'.hom) ≫ CategoryTheory.Limits.pullback.fst g₂' η_K' =
              η_K' ≫ τ₂' j) →
        ∃ (φ' : C₁' ≅ C₂'),
          φ'.hom ≫ g₂' = g₁' ∧
          (∀ j : Fin n, τ₁' j ≫ φ'.hom = τ₂' j) ∧
          CategoryTheory.Limits.pullback.fst g₁' η_K' ≫ φ'.hom =
            φ_K'.hom ≫ CategoryTheory.Limits.pullback.fst g₂' η_K') :
    ∃ (φ : C₁ ≅ C₂),
      φ.hom ≫ g₂ = g₁ ∧
      (∀ j : Fin n, τ₁ j ≫ φ.hom = τ₂ j) ∧
      CategoryTheory.Limits.pullback.fst g₁
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))) ≫ φ.hom =
        φ_K.hom ≫ CategoryTheory.Limits.pullback.fst g₂
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))) :=
by
  
  have hDvrAwayAndFlatInt :
      ∀ (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
        (L : Type u) [Field L] [Algebra A L] [IsFractionRing A L]
        (ϖ : A), Irreducible ϖ →
        IsLocalization.Away ϖ L ∧
        (let η_L := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A L))
         AlgebraicGeometry.IsOpenImmersion η_L ∧
         AlgebraicGeometry.IsDominant η_L ∧
         ∀ (X : AlgebraicGeometry.Scheme.{u})
           (g : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of A)),
           AlgebraicGeometry.Flat g →
           AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback g η_L) →
           AlgebraicGeometry.IsIntegral X ∧
           AlgebraicGeometry.IsDominant (CategoryTheory.Limits.pullback.fst g η_L) ∧
           AlgebraicGeometry.Scheme.Hom.ker (CategoryTheory.Limits.pullback.fst g η_L) = ⊥) := by
    intro A _ _ _ L _ _ _ ϖ hϖ
    have hϖ_ne : ϖ ≠ 0 := hϖ.ne_zero
    have hinj_AL : Function.Injective (algebraMap A L) := IsFractionRing.injective A L
    have hAway : IsLocalization.Away ϖ L := by
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨_, m, rfl⟩
        have hpow_ne : ϖ ^ m ≠ 0 := pow_ne_zero m hϖ_ne
        have hmap_ne : algebraMap A L (ϖ ^ m) ≠ 0 :=
          fun h => hpow_ne (hinj_AL (h.trans (map_zero _).symm))
        exact IsUnit.mk0 _ hmap_ne
      · intro z
        obtain ⟨⟨a, ⟨b, hb_nzd⟩⟩, hz⟩ := IsLocalization.surj (nonZeroDivisors A) z
        have hb_ne : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_nzd
        obtain ⟨m, u, hbu⟩ := IsDiscreteValuationRing.associated_pow_irreducible hb_ne hϖ
        refine ⟨⟨a * (u : A), ⟨ϖ ^ m, m, rfl⟩⟩, ?_⟩
        dsimp only
        rw [← hbu, map_mul, map_mul, ← mul_assoc, hz]
      · intros x y hxy
