      have hsup_xy : W_cov x ⊓ W_cov y ≤ ⨆ z : ↥(W_cov x ⊓ W_cov y), V z := fun w hw =>
        TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨w, hw⟩, hzV ⟨w, hw⟩⟩
      exact E_sm.sheaf.eq_of_locally_eq' V (W_cov x ⊓ W_cov y)
        (fun z => CategoryTheory.homOfLE (hV_le z)) hsup_xy _ _ heq_V
    obtain ⟨s, hs_glue, _⟩ := E_sm.sheaf.existsUnique_gluing' W_cov U_f
      (fun x => CategoryTheory.homOfLE (hW_le x)) hsup s_cov hcompat
    let s₀_glued : ↑(E_sm.presheaf.obj (Opposite.op U_f)) := s
    let x₀ : ↥U_f := ⟨η₀, hη₀_Uf⟩
    have hs_glue0 : (E_sm.presheaf.map (CategoryTheory.homOfLE (hW_le x₀)).op).hom s₀_glued =
