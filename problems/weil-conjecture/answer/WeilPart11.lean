        fun j => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
      let hFace : ∀ j : Fin 2, weilCoverChartInter U β ≤ weilCoverChartInter U (face j) :=
        fun j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
      change ∑ j : Fin 2, ((-1 : ℤ) ^ (j : ℕ)) • O_Y.res (hFace j) (res0 s (face j)) = 0
      rw [Fin.sum_univ_two, Fin.val_zero, pow_zero, one_smul, Fin.val_one, pow_one, neg_one_smul,
        hRes0_apply, hRes0_apply, O_Y.res_comp, O_Y.res_comp]
