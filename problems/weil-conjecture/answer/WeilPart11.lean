    have hHomogScale : ∀ {R : Type u} [CommRing R]
        (F₁ F₂ : MvPolynomial (Fin (r₀ + 1)) Ω →+* R) (w : R),
        (∀ c : Ω, F₁ (MvPolynomial.C c) = F₂ (MvPolynomial.C c)) →
        (∀ i : Fin (r₀ + 1), F₁ (MvPolynomial.X i) = w * F₂ (MvPolynomial.X i)) →
        ∀ (d : ℕ) {P : MvPolynomial (Fin (r₀ + 1)) Ω}, P ∈ 𝒜 d → F₁ P = w ^ d * F₂ P := by
      intro R _ F₁ F₂ w hC hX d P hP
      rw [MvPolynomial.as_sum P, map_sum, map_sum, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro m hm
      have hm_ne : P.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
      have hdeg : (Finsupp.weight 1) m = d := hP hm_ne
      have hdeg_sum : (∑ i ∈ m.support, m i) = d := by
        simpa [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul] using hdeg
      rw [MvPolynomial.monomial_eq, map_mul, map_mul, hC]
      simp only [Finsupp.prod, map_prod, map_pow, hX, mul_pow, Finset.prod_mul_distrib,
        Finset.prod_pow_eq_pow_sum, hdeg_sum]
      ring
    have hFromGlobal_scale : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
        (F₁ F₂ : MvPolynomial (Fin (r₀ + 1)) Ω →+* ↑(Y.presheaf.obj (Opposite.op ⊤)))
        (hF₁ : Ideal.map F₁ (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤)
        (hF₂ : Ideal.map F₂ (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤)
        (w : ↑(Y.presheaf.obj (Opposite.op ⊤))),
        IsUnit w →
        (∀ c : Ω, F₁ (MvPolynomial.C c) = F₂ (MvPolynomial.C c)) →
        (∀ i : Fin (r₀ + 1), F₁ (MvPolynomial.X i) = w * F₂ (MvPolynomial.X i)) →
        AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 F₁ hF₁ =
