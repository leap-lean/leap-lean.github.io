        exact le_inf (le_trans inf_le_left inf_le_right) inf_le_right
      have hle_ik : AlgebraicGeometry.Proj.basicOpen 𝒜₀ x₃ ≤
          AlgebraicGeometry.Proj.basicOpen 𝒜₀ (X_var i * X_var k) := by
        show AlgebraicGeometry.Proj.basicOpen 𝒜₀ ((X_var i * X_var j) * X_var k) ≤ _
        rw [AlgebraicGeometry.Proj.basicOpen_mul, AlgebraicGeometry.Proj.basicOpen_mul,
          AlgebraicGeometry.Proj.basicOpen_mul]
        exact le_inf (le_trans inf_le_left inf_le_left) inf_le_right
      have h1 : (P₀.presheaf.map (CategoryTheory.homOfLE (le_inf hUi hUj)).op).hom (u₀ i j) =
          (P₀.presheaf.map (CategoryTheory.homOfLE hUx₃).op).hom
            ((P₀.presheaf.map (CategoryTheory.homOfLE hle_ij).op).hom (u_raw i j)) := by
        rw [hMapComp hle_ij hUx₃ (le_trans hUx₃ hle_ij)]
        exact hMapComp _ _ _ _
      have h2 : (P₀.presheaf.map (CategoryTheory.homOfLE (le_inf hUj hUk)).op).hom (u₀ j k) =
          (P₀.presheaf.map (CategoryTheory.homOfLE hUx₃).op).hom
            ((P₀.presheaf.map (CategoryTheory.homOfLE hle_jk).op).hom (u_raw j k)) := by
        rw [hMapComp hle_jk hUx₃ (le_trans hUx₃ hle_jk)]
        exact hMapComp _ _ _ _
      have h3 : (P₀.presheaf.map (CategoryTheory.homOfLE (le_inf hUi hUk)).op).hom (u₀ i k) =
          (P₀.presheaf.map (CategoryTheory.homOfLE hUx₃).op).hom
            ((P₀.presheaf.map (CategoryTheory.homOfLE hle_ik).op).hom (u_raw i k)) := by
        rw [hMapComp hle_ik hUx₃ (le_trans hUx₃ hle_ik)]
        exact hMapComp _ _ _ _
      rw [h1, h2, h3, ← map_mul]
