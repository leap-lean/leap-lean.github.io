            ((TopologicalSpace.Opens.map Z.toSpecΓ.base).obj U_spec) =
          (Z.basicOpen x).ι :=
        AlgebraicGeometry.Scheme.isoOfEq_inv_ι Z (Z.toSpecΓ_preimage_basicOpen x)
