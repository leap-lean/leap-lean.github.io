        exact congrArg (Submodule.Quotient.mk (p := Im_sub W)) (R0_vert.res_smul h a z)
      res_id := fun U x => by
        obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (Im_sub U) x
        change Submodule.Quotient.mk (R0_vert.res (le_refl U) z) = Submodule.Quotient.mk z
        rw [R0_vert.res_id U z]
      res_comp := fun {U W T} h₁ h₂ x => by
        obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (Im_sub U) x
        change Submodule.Quotient.mk (R0_vert.res h₂ (R0_vert.res h₁ z)) =
          Submodule.Quotient.mk (R0_vert.res (le_trans h₂ h₁) z)
        rw [R0_vert.res_comp h₁ h₂ z] }
  have hFinAll : ∀ (U : Z.Opens), AlgebraicGeometry.IsAffineOpen U →
      Module.Finite ↑(Z.presheaf.obj (Opposite.op U)) (R0_vert.sec U) ∧
      (∀ q : ℕ, Module.Finite ↑(Z.presheaf.obj (Opposite.op U)) ((Rsucc_vert q).sec U)) ∧
      Module.Finite ↑(Z.presheaf.obj (Opposite.op U)) (K_1.sec U) ∧
      Module.Finite ↑(Z.presheaf.obj (Opposite.op U)) (Q_1.sec U) := by
    intro U hU
    let B_U := ↑(Z.presheaf.obj (Opposite.op U))
    let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B_U) :=
      MvPolynomial.gradedAlgebra
    let 𝒜_U := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B_U
    let W_U : Fin (N + 1) → (AlgebraicGeometry.Proj 𝒜_U).Opens :=
      fun k => AlgebraicGeometry.Proj.basicOpen 𝒜_U (MvPolynomial.X k)
    let π_U : AlgebraicGeometry.Proj 𝒜_U ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_U) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜_U ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_U ↥(𝒜_U 0)))
    let Z'_U : AlgebraicGeometry.Scheme.{u} :=
      AlgebraicGeometry.Scheme.Opens.toScheme ((TopologicalSpace.Opens.map π.base).obj U)
    obtain ⟨hNoethBU, _hAffInterU, ι_U, hClU, θ_U, hθ_res, hθ_smul⟩ := hBaseU U hU
    have _ : IsNoetherianRing B_U := hNoethBU
    obtain ⟨_hSepU, _hCovU, _hInterU, G_U, hCohGU, e_GU, he_GU_smul, he_GU_res⟩ :=
      h_s3 B_U N Z'_U ι_U hClU
    obtain ⟨⟨k₀, gen₀, hgen₀_ker, hgen₀_span⟩, hSuccU⟩ := hSerre B_U N G_U hCohGU
    let toE : ∀ q : ℕ, WeilModuleCechCochain W_U G_U q → E_sec U q :=
      fun q c β => θ_U q β (e_GU (weilCoverChartInter W_U β) (c β))
    let fromE : ∀ q : ℕ, E_sec U q → WeilModuleCechCochain W_U G_U q :=
      fun q z β => (e_GU (weilCoverChartInter W_U β)).symm ((θ_U q β).symm (z β))
    have hToFrom : ∀ q z, toE q (fromE q z) = z := fun q z => funext fun β => by
      dsimp only [toE, fromE]
      rw [AddEquiv.apply_symm_apply, RingEquiv.apply_symm_apply]
    have hToAdd : ∀ q c₁ c₂, toE q (c₁ + c₂) = toE q c₁ + toE q c₂ :=
      fun q c₁ c₂ => funext fun β => by
        change θ_U q β (e_GU _ (c₁ β + c₂ β)) = _ + _
        rw [map_add, map_add]
    have hToSum : ∀ {ι₀ : Type} (s : Finset ι₀) (q : ℕ)
        (f : ι₀ → WeilModuleCechCochain W_U G_U q),
        toE q (∑ i ∈ s, f i) = ∑ i ∈ s, toE q (f i) := by
      intro ι₀ s q f
      classical
      induction s using Finset.induction_on with
      | empty =>
        funext β
        change θ_U q β (e_GU _ 0) = 0
        rw [map_zero, map_zero]
      | insert a s ha ih =>
        rw [Finset.sum_insert ha, Finset.sum_insert ha, hToAdd, ih]
    have hToSmul : ∀ (q : ℕ) (b : B_U) (c : WeilModuleCechCochain W_U G_U q),
        toE q (weilModuleCechSmul π_U W_U G_U q b c) =
          @SMul.smul _ _ (instModE U q).toSMul b (toE q c) := by
      intro q b c
      funext β
      dsimp only [toE, weilModuleCechSmul]
      rw [he_GU_smul, map_mul, hθ_smul q β b]
      rfl
    have hToDiff : ∀ (q : ℕ) (c : WeilModuleCechCochain W_U G_U q),
        toE (q + 1) (weilModuleCechDiff W_U G_U q c) = dv_sec U q (toE q c) := by
      intro q c
      funext γ
      change θ_U (q + 1) γ (e_GU _ (∑ j : Fin (q + 2), ((-1 : ℤ) ^ (j : ℕ)) • G_U.res _ (c _))) =
        ∑ j : Fin (q + 2), ((-1 : ℤ) ^ (j : ℕ)) • (Z'.presheaf.map _).hom (toE q c _)
      rw [map_sum, map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_zsmul, map_zsmul]
      congr 1
      let face : Fin (q + 2) → WeilStrictMonoTuple (N + 1) q :=
        fun j₀ => ⟨fun k => γ.1 (j₀.succAbove k), γ.2.comp (Fin.strictMono_succAbove j₀)⟩
      let hFaceW : weilCoverChartInter W_U γ ≤ weilCoverChartInter W_U (face j) :=
        Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
      rw [he_GU_res hFaceW ((TopologicalSpace.Opens.map ι_U.base).monotone hFaceW)]
      exact hθ_res q γ (face j) hFaceW _ (e_GU _ (c (face j)))
    have hFin_R0 : Module.Finite B_U (R0_vert.sec U) := by
      have hg₀_ker : ∀ j : Fin k₀, dv_sec U 0 (toE 0 (gen₀ j)) = 0 := by
        intro j
        rw [← hToDiff 0 (gen₀ j), hgen₀_ker j]
        funext γ
        change θ_U 1 γ (e_GU _ 0) = 0
        rw [map_zero, map_zero]
      let g₀_sub : Fin k₀ → R0_vert.sec U := fun j => ⟨toE 0 (gen₀ j), hg₀_ker j⟩
      let φ₀ : (Fin k₀ → B_U) →ₗ[B_U] R0_vert.sec U :=
        { toFun := fun c => ∑ j : Fin k₀, c j • g₀_sub j
          map_add' := fun c₁ c₂ => by simp [add_smul, Finset.sum_add_distrib]
          map_smul' := fun r c => by simp [mul_smul, Finset.smul_sum] }
      apply Module.Finite.of_surjective φ₀
      intro z
      have hz_pre : weilModuleCechDiff W_U G_U 0 (fromE 0 z.1) = 0 := by
        funext γ
        apply (e_GU _).injective
        apply (θ_U 1 γ).injective
        change toE 1 (weilModuleCechDiff W_U G_U 0 (fromE 0 z.1)) γ = θ_U 1 γ (e_GU _ 0)
        rw [hToDiff, hToFrom, map_zero, map_zero]
        have hz0 : dv_sec U 0 z.1 = 0 := z.2
        rw [hz0]
        rfl
      obtain ⟨c, hc⟩ := hgen₀_span (fromE 0 z.1) hz_pre
      refine ⟨c, Subtype.ext ?_⟩
      let _ := instModE U 0
      change (∑ j : Fin k₀, c j • g₀_sub j).1 = z.1
      rw [AddSubmonoidClass.coe_finsetSum]
      have hcE := congrArg (toE 0) hc
      rw [hToFrom, hToSum] at hcE
      rw [hcE]
      exact Finset.sum_congr rfl fun j _ => (hToSmul 0 (c j) (gen₀ j)).symm
    have hFin_Rsucc : ∀ q : ℕ, Module.Finite B_U ((Rsucc_vert q).sec U) := by
      intro q
      obtain ⟨k, gen, hgen_ker, hgen_span⟩ := hSuccU q
      have hg_ker : ∀ j : Fin k, dv_sec U (q + 1) (toE (q + 1) (gen j)) = 0 := by
        intro j
        rw [← hToDiff (q + 1) (gen j), hgen_ker j]
        funext γ
        change θ_U (q + 2) γ (e_GU _ 0) = 0
        rw [map_zero, map_zero]
      let _ := instModE U (q + 1)
      let g_sub : Fin k → ↥(Kq_sub U q) := fun j => ⟨toE (q + 1) (gen j), hg_ker j⟩
      let φ_q : (Fin k → B_U) →ₗ[B_U] (Rsucc_vert q).sec U :=
        { toFun := fun c => ∑ j : Fin k, c j • Submodule.mkQ (Bq_sub U q) (g_sub j)
          map_add' := fun c₁ c₂ => by simp [add_smul, Finset.sum_add_distrib]
          map_smul' := fun r c => by simp [mul_smul, Finset.smul_sum] }
      apply Module.Finite.of_surjective φ_q
      intro x
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (Bq_sub U q) x
      have hz_pre : weilModuleCechDiff W_U G_U (q + 1) (fromE (q + 1) z.1) = 0 := by
        funext γ
        apply (e_GU _).injective
        apply (θ_U (q + 2) γ).injective
        change toE (q + 2) (weilModuleCechDiff W_U G_U (q + 1) (fromE (q + 1) z.1)) γ =
          θ_U (q + 2) γ (e_GU _ 0)
        rw [hToDiff, hToFrom, map_zero, map_zero]
        have hz0 : dv_sec U (q + 1) z.1 = 0 := z.2
        rw [hz0]
        rfl
      obtain ⟨c, b, hzb⟩ := hgen_span (fromE (q + 1) z.1) hz_pre
      refine ⟨c, ?_⟩
      have hφ_eq : φ_q c = Submodule.mkQ (Bq_sub U q) (∑ j : Fin k, c j • g_sub j) := by
        change ∑ j : Fin k, c j • Submodule.mkQ (Bq_sub U q) (g_sub j) = _
        rw [map_sum]
        exact Finset.sum_congr rfl fun j _ => (map_smul (Submodule.mkQ (Bq_sub U q)) (c j) _).symm
      rw [hφ_eq]
      change Submodule.Quotient.mk (∑ j : Fin k, c j • g_sub j) = Submodule.Quotient.mk z
      rw [Submodule.Quotient.eq]
      let _ := instModE U q
      let _ := instModE U (q + 2)
      refine ⟨-(toE q b), ?_⟩
      change dv_lin U q (-(toE q b)) = (∑ j : Fin k, c j • g_sub j).1 - z.1
      rw [map_neg, AddSubmonoidClass.coe_finsetSum]
      have hzbE := congrArg (toE (q + 1)) hzb
      rw [hToFrom, hToAdd, hToSum, hToDiff] at hzbE
      have hSumEq : (∑ j : Fin k, (c j • g_sub j).1) =
          ∑ j : Fin k, toE (q + 1) (weilModuleCechSmul π_U W_U G_U (q + 1) (c j) (gen j)) :=
        Finset.sum_congr rfl fun j _ => (hToSmul (q + 1) (c j) (gen j)).symm
      change -(dv_sec U q (toE q b)) = (∑ j : Fin k, (c j • g_sub j).1) - z.1
      rw [hSumEq, hzbE]
      abel
    have hFin_K1 : Module.Finite B_U (K_1.sec U) := by
      let _ := instModE U 0
      exact Module.Finite.iff_fg.mpr (IsNoetherian.noetherian (LinearMap.ker (η_raw U)))
    have hFin_Q1 : Module.Finite B_U (Q_1.sec U) := by
      have _ : Module.Finite B_U (R0_vert.sec U) := hFin_R0
      exact Module.Finite.of_surjective (Submodule.mkQ (Im_sub U))
        (Submodule.mkQ_surjective (Im_sub U))
    exact ⟨hFin_R0, hFin_Rsucc, hFin_K1, hFin_Q1⟩
  have hBaseAll : ∀ (U W : Z.Opens),
      AlgebraicGeometry.IsAffineOpen U →
      AlgebraicGeometry.IsAffineOpen W →
      ∀ (hWU : W ≤ U),
        letI : Algebra ↑(Z.presheaf.obj (Opposite.op U)) ↑(Z.presheaf.obj (Opposite.op W)) :=
          RingHom.toAlgebra (Z.presheaf.map (CategoryTheory.homOfLE hWU).op).hom
        (∃ (φ : TensorProduct ↑(Z.presheaf.obj (Opposite.op U))
              ↑(Z.presheaf.obj (Opposite.op W)) (R0_vert.sec U) ≃ₗ[
                ↑(Z.presheaf.obj (Opposite.op W))] R0_vert.sec W),
          ∀ b x, φ (TensorProduct.tmul _ b x) = b • R0_vert.res hWU x) ∧
        (∀ q : ℕ,
          ∃ (φ : TensorProduct ↑(Z.presheaf.obj (Opposite.op U))
                ↑(Z.presheaf.obj (Opposite.op W)) ((Rsucc_vert q).sec U) ≃ₗ[
                  ↑(Z.presheaf.obj (Opposite.op W))] (Rsucc_vert q).sec W),
            ∀ b x, φ (TensorProduct.tmul _ b x) = b • (Rsucc_vert q).res hWU x) ∧
        (∃ (φ : TensorProduct ↑(Z.presheaf.obj (Opposite.op U))
              ↑(Z.presheaf.obj (Opposite.op W)) (K_1.sec U) ≃ₗ[
                ↑(Z.presheaf.obj (Opposite.op W))] K_1.sec W),
          ∀ b x, φ (TensorProduct.tmul _ b x) = b • K_1.res hWU x) ∧
        (∃ (φ : TensorProduct ↑(Z.presheaf.obj (Opposite.op U))
              ↑(Z.presheaf.obj (Opposite.op W)) (Q_1.sec U) ≃ₗ[
                ↑(Z.presheaf.obj (Opposite.op W))] Q_1.sec W),
          ∀ b x, φ (TensorProduct.tmul _ b x) = b • Q_1.res hWU x) := by
    intro U W hU hW hWU
    let B_U := ↑(Z.presheaf.obj (Opposite.op U))
    let B_W := ↑(Z.presheaf.obj (Opposite.op W))
    let _ : Algebra B_U B_W :=
      RingHom.toAlgebra (Z.presheaf.map (CategoryTheory.homOfLE hWU).op).hom
    have _ : Module.Flat B_U B_W := hFlatOpen Z U W hU hW hWU
    obtain ⟨hPiBC, hKerBC, hQuotBC⟩ := h_s5 B_U B_W
    have hΦ_E : ∀ q : ℕ,
        letI := instModE U q
        letI := instModE W q
        ∃ (Φ_q : TensorProduct B_U B_W (E_sec U q) ≃ₗ[B_W] E_sec W q),
          ∀ (b : B_W) (c : E_sec U q),
            Φ_q (TensorProduct.tmul B_U b c) = b • E_res hWU q c := by
      intro q
      let _ := instModE U q
      let _ := instModE W q
      have hβ : ∀ β : WeilStrictMonoTuple (N + 1) q,
          let Ω_U := (TopologicalSpace.Opens.map π.base).obj U ⊓ weilCoverChartInter Z'_std β
          let Ω_W := (TopologicalSpace.Opens.map π.base).obj W ⊓ weilCoverChartInter Z'_std β
          letI : Module B_U ↑(Z'.presheaf.obj (Opposite.op Ω_U)) :=
            Module.compHom _ (π.appLE U Ω_U inf_le_left).hom
          letI : Module B_W ↑(Z'.presheaf.obj (Opposite.op Ω_W)) :=
            Module.compHom _ (π.appLE W Ω_W inf_le_left).hom
          ∃ (φ_β : TensorProduct B_U B_W ↑(Z'.presheaf.obj (Opposite.op Ω_U)) ≃ₗ[B_W]
                ↑(Z'.presheaf.obj (Opposite.op Ω_W))),
            ∀ (b : B_W) (x : ↑(Z'.presheaf.obj (Opposite.op Ω_U))),
              φ_β (TensorProduct.tmul B_U b x) =
                (π.appLE W Ω_W inf_le_left).hom b *
                  (Z'.presheaf.map (CategoryTheory.homOfLE
                    (inf_le_inf_right _ ((TopologicalSpace.Opens.map π.base).monotone hWU))).op).hom x := by
        intro β
        let Ω_U := (TopologicalSpace.Opens.map π.base).obj U ⊓ weilCoverChartInter Z'_std β
        let Ω_W := (TopologicalSpace.Opens.map π.base).obj W ⊓ weilCoverChartInter Z'_std β
        have hW_sub_U : (TopologicalSpace.Opens.map π.base).obj W ≤
            (TopologicalSpace.Opens.map π.base).obj U :=
          (TopologicalSpace.Opens.map π.base).monotone hWU
        have hΩ_le : Ω_W ≤ Ω_U := inf_le_inf_right _ hW_sub_U
        have hΩ_eq : Ω_W = (TopologicalSpace.Opens.map π.base).obj W ⊓ Ω_U := by
          dsimp only [Ω_W, Ω_U]
          rw [← inf_assoc, inf_of_le_left hW_sub_U]
        exact hAffPullback Z' Z π U W Ω_U Ω_W hU hW
          (hAff_π_inter U hU q β) (hAff_π_inter W hW q β)
          hWU inf_le_left inf_le_left hΩ_le hΩ_eq
      choose φ_β hφ_β using hβ
      let res_β : ∀ β : WeilStrictMonoTuple (N + 1) q,
          ↑(Z'.presheaf.obj (Opposite.op
            ((TopologicalSpace.Opens.map π.base).obj U ⊓ weilCoverChartInter Z'_std β))) →+
          ↑(Z'.presheaf.obj (Opposite.op
            ((TopologicalSpace.Opens.map π.base).obj W ⊓ weilCoverChartInter Z'_std β))) :=
        fun β =>
          (Z'.presheaf.map (CategoryTheory.homOfLE
            (inf_le_inf_right _ ((TopologicalSpace.Opens.map π.base).monotone hWU))).op).hom.toAddMonoidHom
      obtain ⟨Φ_q, hΦ_q⟩ := @hPiBC (WeilStrictMonoTuple (N + 1) q) inferInstance
        (fun β => ↑(Z'.presheaf.obj (Opposite.op
          ((TopologicalSpace.Opens.map π.base).obj U ⊓ weilCoverChartInter Z'_std β))))
        _
        (fun β => Module.compHom _ (π.appLE U _ inf_le_left).hom)
        (fun β => ↑(Z'.presheaf.obj (Opposite.op
          ((TopologicalSpace.Opens.map π.base).obj W ⊓ weilCoverChartInter Z'_std β))))
        _
        (fun β => Module.compHom _ (π.appLE W _ inf_le_left).hom)
        res_β φ_β hφ_β
      refine ⟨Φ_q, ?_⟩
      intro b c
      funext β
      exact hΦ_q b c β
    choose Φ_E hΦ_E using hΦ_E
    let Φ_OZ : TensorProduct B_U B_W (O_Z.sec U) ≃ₗ[B_W] O_Z.sec W :=
      TensorProduct.AlgebraTensorModule.rid B_U B_W B_W
    have hΦ_OZ : ∀ (b : B_W) (f : O_Z.sec U),
        Φ_OZ (TensorProduct.tmul B_U b f) = b • O_Z.res hWU f := by
      intro b f
      erw [TensorProduct.AlgebraTensorModule.rid_tmul]
      change algebraMap B_U B_W f * b = b * algebraMap B_U B_W f
      exact mul_comm _ _
    have hBC_R0 : ∃ (φ : TensorProduct B_U B_W (R0_vert.sec U) ≃ₗ[B_W] R0_vert.sec W),
        ∀ b x, φ (TensorProduct.tmul B_U b x) = b • R0_vert.res hWU x := by
      let _ := instModE U 0
      let _ := instModE U 1
      let _ := instModE W 0
      let _ := instModE W 1
      obtain ⟨ψ, hψ⟩ := hKerBC (E_sec U 0) (E_sec U 1) (E_sec W 0) (E_sec W 1)
        (dv_lin U 0) (dv_lin W 0) (E_res hWU 0) (E_res hWU 1) (Φ_E 0) (Φ_E 1)
        (fun c => hE_res_dv hWU 0 c) (hΦ_E 0) (hΦ_E 1)
      exact ⟨ψ, fun b x => Subtype.ext (hψ b x)⟩
    have hBC_Rsucc : ∀ q : ℕ,
        ∃ (φ : TensorProduct B_U B_W ((Rsucc_vert q).sec U) ≃ₗ[B_W] (Rsucc_vert q).sec W),
          ∀ b x, φ (TensorProduct.tmul B_U b x) = b • (Rsucc_vert q).res hWU x := by
      intro q
      let _ := instModE U q
      let _ := instModE U (q + 1)
      let _ := instModE U (q + 2)
      let _ := instModE W q
      let _ := instModE W (q + 1)
      let _ := instModE W (q + 2)
      obtain ⟨ψ, hψ⟩ := hQuotBC (E_sec U q) (E_sec U (q + 1)) (E_sec U (q + 2))
        (E_sec W q) (E_sec W (q + 1)) (E_sec W (q + 2))
        (dv_lin U q) (dv_lin U (q + 1)) (dv_lin W q) (dv_lin W (q + 1))
        (E_res hWU q) (E_res hWU (q + 1)) (E_res hWU (q + 2))
        (Φ_E q) (Φ_E (q + 1)) (Φ_E (q + 2))
        (fun c => hE_res_dv hWU q c) (fun c => hE_res_dv hWU (q + 1) c)
        (hΦ_E q) (hΦ_E (q + 1)) (hΦ_E (q + 2))
      refine ⟨ψ, ?_⟩
      intro b x
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (Bq_sub U q) x
      exact hψ b z (ker_res_q hWU q z).2
    have hBC_K1 : ∃ (φ : TensorProduct B_U B_W (K_1.sec U) ≃ₗ[B_W] K_1.sec W),
        ∀ b x, φ (TensorProduct.tmul B_U b x) = b • K_1.res hWU x := by
      let _ := instModE U 0
      let _ := instModE W 0
      obtain ⟨ψ, hψ⟩ := hKerBC (O_Z.sec U) (E_sec U 0) (O_Z.sec W) (E_sec W 0)
        (η_raw U) (η_raw W) (O_Z.res hWU) (E_res hWU 0) Φ_OZ (Φ_E 0)
        (fun f => (hη_res hWU f).symm) hΦ_OZ (hΦ_E 0)
      exact ⟨ψ, fun b x => Subtype.ext (hψ b x)⟩
    have hBC_Q1 : ∃ (φ : TensorProduct B_U B_W (Q_1.sec U) ≃ₗ[B_W] Q_1.sec W),
        ∀ b x, φ (TensorProduct.tmul B_U b x) = b • Q_1.res hWU x := by
      let _ := instModE U 0
      let _ := instModE U 1
      let _ := instModE W 0
      let _ := instModE W 1
      obtain ⟨ψ, hψ⟩ := hQuotBC (O_Z.sec U) (E_sec U 0) (E_sec U 1)
        (O_Z.sec W) (E_sec W 0) (E_sec W 1)
        (η_raw U) (dv_lin U 0) (η_raw W) (dv_lin W 0)
        (O_Z.res hWU) (E_res hWU 0) (E_res hWU 1)
        Φ_OZ (Φ_E 0) (Φ_E 1)
        (fun f => (hη_res hWU f).symm) (fun c => hE_res_dv hWU 0 c)
        hΦ_OZ (hΦ_E 0) (hΦ_E 1)
      refine ⟨ψ, ?_⟩
      intro b x
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (Im_sub U) x
      exact hψ b z (R0_vert.res hWU z).2
    exact ⟨hBC_R0, hBC_Rsucc, hBC_K1, hBC_Q1⟩
  have hVanDense : ∀ U : Z.Opens, AlgebraicGeometry.IsAffineOpen U → U ≤ U_dense →
      (∀ q : ℕ, ∀ x : (Rsucc_vert q).sec U, x = 0) ∧
      (∀ x : K_1.sec U, x = 0) ∧
      (∀ x : Q_1.sec U, x = 0) := by
    intro U hU hU_le
    let W' : Z'.Opens := (TopologicalSpace.Opens.map π.base).obj U
    obtain ⟨hAffW', hBij_πU⟩ := hIsoRes Z' Z π U U_dense hIso_π hU hU_le
    let U'_cov : Fin (N + 1) → Z'.Opens := fun k => W' ⊓ Z'_std k
    have hAffU'_cov : ∀ k : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (U'_cov k) := by
      intro k
      let β_k : WeilStrictMonoTuple (N + 1) 0 :=
        ⟨fun _ => k, fun i j hij => False.elim (by omega)⟩
      have hEq_k : weilCoverChartInter Z'_std β_k = Z'_std k := by
        dsimp only [weilCoverChartInter]
        have hUniv : (Finset.univ : Finset (Fin 1)) = {0} := rfl
        simp only [hUniv, Finset.inf'_singleton]
        rfl
      change AlgebraicGeometry.IsAffineOpen (W' ⊓ Z'_std k)
      rw [← hEq_k]
      exact hAff_π_inter U hU 0 β_k
    have hSupU'_cov : (⨆ k : Fin (N + 1), U'_cov k) = W' := by
      apply le_antisymm
      · exact iSup_le fun _ => inf_le_left
      · intro z hz
        rw [TopologicalSpace.Opens.mem_iSup]
        have hz_top : z ∈ (⊤ : Z'.Opens) := trivial
        rw [← hCovZ'_std, TopologicalSpace.Opens.mem_iSup] at hz_top
        obtain ⟨k, hk⟩ := hz_top
        exact ⟨k, hz, hk⟩
    let O_Z' : WeilPresheafModule Z' :=
      { sec := fun V₀ => ↑(Z'.presheaf.obj (Opposite.op V₀))
        instAddCommGroup := fun _ => inferInstance
        instModule := fun _ => inferInstance
        res := fun h => (Z'.presheaf.map (CategoryTheory.homOfLE h).op).hom.toAddMonoidHom
        res_smul := fun h a x => map_mul (Z'.presheaf.map (CategoryTheory.homOfLE h).op).hom a x
        res_id := fun V₀ x => hMapId Z' V₀ _ x
        res_comp := fun h₁ h₂ x => hMapComp Z' h₁ h₂ _ x }
    obtain ⟨_hDiffRes0, hInjRes0, hSurjKer0, hExactSucc⟩ :=
      hAffGluing hSepZ' W' hAffW' (N + 1) U'_cov (fun _ => inf_le_left)
        hAffU'_cov hSupU'_cov O_Z' ⟨fun _ => AddEquiv.refl _, fun _ _ => rfl⟩
    have hOpen_cov : ∀ (q : ℕ) (β : WeilStrictMonoTuple (N + 1) q),
        W' ⊓ weilCoverChartInter Z'_std β = weilCoverChartInter U'_cov β := by
      intro q β
      suffices ∀ (S₀ : Finset (Fin (q + 1))) (hS₀ : S₀.Nonempty),
          W' ⊓ S₀.inf' hS₀ (fun j => Z'_std (β.1 j)) =
            S₀.inf' hS₀ (fun j => W' ⊓ Z'_std (β.1 j)) from
        this Finset.univ ⟨0, Finset.mem_univ _⟩
      intro S₀
      induction S₀ using Finset.cons_induction with
      | empty => intro hS₀; exact False.elim (Finset.not_nonempty_empty hS₀)
      | cons k₀ s hk₀ ih =>
        intro _
        rcases s.eq_empty_or_nonempty with rfl | hs
        · have h1 : Finset.cons k₀ ∅ hk₀ = {k₀} := rfl
          simp only [h1, Finset.inf'_singleton]
        · rw [Finset.inf'_cons hs, Finset.inf'_cons hs, ← ih hs]
          exact inf_inf_distrib_left _ _ _
    let toCech : ∀ q : ℕ, E_sec U q → WeilModuleCechCochain U'_cov O_Z' q :=
      fun q c β =>
        (Z'.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hOpen_cov q β).symm)).op).hom (c β)
    let fromCech : ∀ q : ℕ, WeilModuleCechCochain U'_cov O_Z' q → E_sec U q :=
      fun q c β =>
        (Z'.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hOpen_cov q β))).op).hom (c β)
    have hFromTo : ∀ q c, fromCech q (toCech q c) = c := fun q c => funext fun β =>
      (hMapComp Z' _ _ (le_refl _) (c β)).trans (hMapId Z' _ (le_refl _) (c β))
    have hToFromC : ∀ q c, toCech q (fromCech q c) = c := fun q c => funext fun β =>
      (hMapComp Z' _ _ (le_refl _) (c β)).trans (hMapId Z' _ (le_refl _) (c β))
    have hToCechDiff : ∀ q c,
        toCech (q + 1) (dv_sec U q c) = weilModuleCechDiff U'_cov O_Z' q (toCech q c) := by
      intro q c
      funext γ
      change (Z'.presheaf.map _).hom (∑ j : Fin (q + 2), _) = ∑ j : Fin (q + 2), _
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_zsmul]
      congr 1
      exact hMapComm Z' _ _ _ _ (c _)
    let res0 : O_Z'.sec W' → WeilModuleCechCochain U'_cov O_Z' 0 :=
      fun s α =>
        O_Z'.res (le_trans (Finset.inf'_le _ (Finset.mem_univ (0 : Fin 1))) inf_le_left) s
    have hη_toCech : ∀ f : O_Z.sec U,
        toCech 0 (η_raw U f) = res0 ((π.app U).hom f) := by
      intro f
      funext β
      let hβ_le : weilCoverChartInter U'_cov β ≤ W' :=
        le_trans (Finset.inf'_le (fun k => U'_cov (β.1 k)) (Finset.mem_univ (0 : Fin 1)))
          inf_le_left
      have hApp : π.app U = π.appLE U W' (le_refl _) :=
        AlgebraicGeometry.Scheme.Hom.app_eq_appLE π
      change (Z'.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hOpen_cov 0 β).symm)).op).hom
          ((π.appLE U (W' ⊓ weilCoverChartInter Z'_std β) inf_le_left).hom f) =
        (Z'.presheaf.map (CategoryTheory.homOfLE hβ_le).op).hom ((π.app U).hom f)
      rw [hApp]
      have h1 := AlgebraicGeometry.Scheme.Hom.appLE_map π
        (inf_le_left : W' ⊓ weilCoverChartInter Z'_std β ≤ W')
        (CategoryTheory.homOfLE (le_of_eq (hOpen_cov 0 β).symm)).op
      have h2 := AlgebraicGeometry.Scheme.Hom.appLE_map π
        (le_refl W')
        (CategoryTheory.homOfLE hβ_le).op
      exact congrArg (fun φ => φ.hom f) (h1.trans h2.symm)
    refine ⟨?_, ?_, ?_⟩
    · intro q x
      let _ := instModE U (q + 1)
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (Bq_sub U q) x
      rw [Submodule.Quotient.mk_eq_zero]
      have hz' : weilModuleCechDiff U'_cov O_Z' (q + 1) (toCech (q + 1) z.1) = 0 := by
        rw [← hToCechDiff (q + 1) z.1]
        have hz0 : dv_sec U (q + 1) z.1 = 0 := z.2
        rw [hz0]
        funext γ
        exact map_zero _
      obtain ⟨b', hb'⟩ := hExactSucc q (toCech (q + 1) z.1) hz'
      refine ⟨fromCech q b', ?_⟩
      change dv_sec U q (fromCech q b') = z.1
      have h1 := congrArg (fromCech (q + 1)) (hToCechDiff q (fromCech q b'))
      rw [hFromTo, hToFromC, hb', hFromTo] at h1
      exact h1
    · intro x
      apply Subtype.ext
      change x.1 = (0 : O_Z.sec U)
      apply hBij_πU.1
      rw [map_zero]
      apply hInjRes0
      change res0 ((π.app U).hom x.1) = res0 0
      have h0 : res0 0 = 0 := funext fun _ => map_zero _
      rw [h0, ← hη_toCech x.1]
      have hx0 : η_raw U x.1 = 0 := x.2
      rw [hx0]
      funext β
      exact map_zero _
    · intro u
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (Im_sub U) u
      rw [Submodule.Quotient.mk_eq_zero]
      have hz' : weilModuleCechDiff U'_cov O_Z' 0 (toCech 0 z.1) = 0 := by
        rw [← hToCechDiff 0 z.1]
        have hz0 : dv_sec U 0 z.1 = 0 := z.2
        rw [hz0]
        funext γ
        exact map_zero _
      obtain ⟨s, hs⟩ := hSurjKer0 (toCech 0 z.1) hz'
      change res0 s = toCech 0 z.1 at hs
      obtain ⟨f, hf⟩ := hBij_πU.2 s
      refine ⟨f, ?_⟩
      change η_raw U f = z.1
      have h1 := hη_toCech f
      rw [hf, hs] at h1
      have h2 := congrArg (fromCech 0) h1
      rwa [hFromTo, hFromTo] at h2
  refine ⟨hSepZ', hCovZ'_std, hZ'_inter, hAff_π_inter,
    ⟨G_R, hFin_GR, e_G, he_G_smul, fun h h' x => he_G_res h h' x⟩,
    ⟨O_Z, R0_vert, K_1, Im_η, Q_1, Rsucc_vert,
      ⟨fun _ => AddEquiv.refl _, fun _ _ _ => rfl, fun _ _ => rfl⟩,
      ⟨fun U hU _ => (hFinAll U hU).1, fun U W hU hW _ hWU => (hBaseAll U W hU hW hWU).1⟩,
      fun q => ⟨fun U hU _ => (hFinAll U hU).2.1 q,
        fun U W hU hW _ hWU => (hBaseAll U W hU hW hWU).2.1 q⟩,
      ⟨fun U hU _ => (hFinAll U hU).2.2.1,
        fun U W hU hW _ hWU => (hBaseAll U W hU hW hWU).2.2.1⟩,
      ⟨fun U hU _ => (hFinAll U hU).2.2.2,
        fun U W hU hW _ hWU => (hBaseAll U W hU hW hWU).2.2.2⟩,
      hVanDense,
      ?_, ?_⟩⟩
  · let i₁ : ∀ U : Z.Opens, K_1.sec U →+ O_Z.sec U :=
      fun U =>
        letI := instModE U 0
        (LinearMap.ker (η_raw U)).subtype.toAddMonoidHom
    let q₁ : ∀ U : Z.Opens, O_Z.sec U →+ Im_η.sec U :=
      fun U => (η_lin U).rangeRestrict.toAddMonoidHom
    let i₂ : ∀ U : Z.Opens, Im_η.sec U →+ R0_vert.sec U :=
      fun U => (LinearMap.range (η_lin U)).subtype.toAddMonoidHom
    let q₂ : ∀ U : Z.Opens, R0_vert.sec U →+ Q_1.sec U :=
      fun U => (Submodule.mkQ (Im_sub U)).toAddMonoidHom
    refine ⟨i₁, q₁, i₂, q₂, ?_, ?_, ?_⟩
    · intro U
      refine ⟨Submodule.subtype_injective _, LinearMap.surjective_rangeRestrict _, ?_,
        Submodule.subtype_injective _, Submodule.mkQ_surjective _, ?_⟩
      · intro f
        change q₁ U f = 0 ↔ f ∈ Set.range (i₁ U)
        constructor
        · intro hf0
          have hf_ker : η_raw U f = 0 := congrArg (fun w : Im_η.sec U => w.1.1) hf0
          exact ⟨⟨f, hf_ker⟩, rfl⟩
        · rintro ⟨x, rfl⟩
          apply Subtype.ext
          apply Subtype.ext
          exact x.2
      · intro z
        change Submodule.Quotient.mk (p := Im_sub U) z = 0 ↔ z ∈ Set.range (i₂ U)
        rw [Submodule.Quotient.mk_eq_zero]
        constructor
        · rintro ⟨f, hf⟩
          refine ⟨⟨z, ⟨f, Subtype.ext hf⟩⟩, rfl⟩
        · rintro ⟨⟨_, ⟨f, hf⟩⟩, rfl⟩
          exact ⟨f, congrArg Subtype.val hf⟩
    · intro U a
      refine ⟨fun x => rfl,
        fun x => map_smul (η_lin U).rangeRestrict a x,
        fun x => rfl,
        fun x => map_smul (Submodule.mkQ (Im_sub U)) a x⟩
    · intro U W h
      refine ⟨fun x => rfl, ?_, fun x => rfl, ?_⟩
      · intro x
        apply Subtype.ext
        apply Subtype.ext
        exact hη_res h x
      · intro x
        rfl
  · refine ⟨⟨fun _ => Equiv.refl _, fun _ _ _ _ => rfl, fun _ _ _ _ => rfl,
      fun _ _ _ => rfl⟩, ?_⟩
    intro q
    let q_Rq : ∀ U : Z.Opens,
        { z : E_sec U (q + 1) // dv_sec U (q + 1) z = 0 } → (Rsucc_vert q).sec U :=
      fun U z =>
        letI := instModE U (q + 1)
        Submodule.Quotient.mk (p := Bq_sub U q) ⟨z.1, z.2⟩
    refine ⟨q_Rq, ?_, ?_, ?_⟩
    · intro U
      let _ := instModE U q
      let _ := instModE U (q + 1)
      refine ⟨?_, ?_, ?_⟩
      · intro x
        obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (Bq_sub U q) x
        exact ⟨⟨z.1, z.2⟩, rfl⟩
      · intro z₁ z₂ _
        rfl
      · intro z
        change Submodule.Quotient.mk (p := Bq_sub U q) ⟨z.1, z.2⟩ = 0 ↔
          ∃ y : E_sec U q, dv_sec U q y = z.1
        rw [Submodule.Quotient.mk_eq_zero]
        rfl
    · intro U a z₁ z₂ hz
      let _ := instModE U (q + 1)
      have hEq : (⟨z₂.1, z₂.2⟩ : ↥(Kq_sub U q)) = a • (⟨z₁.1, z₁.2⟩ : ↥(Kq_sub U q)) :=
        Subtype.ext (funext hz)
      change Submodule.Quotient.mk (p := Bq_sub U q) ⟨z₂.1, z₂.2⟩ =
        a • Submodule.Quotient.mk (p := Bq_sub U q) ⟨z₁.1, z₁.2⟩
      rw [hEq]
      rfl
    · intro U W h zU zW hz
      let _ := instModE U (q + 1)
      let _ := instModE W (q + 1)
      have hEq : ker_res_q h q ⟨zU.1, zU.2⟩ = ⟨zW.1, zW.2⟩ :=
        Subtype.ext (funext fun β => (hz β).symm)
      change Submodule.Quotient.mk (p := Bq_sub W q) (ker_res_q h q ⟨zU.1, zU.2⟩) =
        Submodule.Quotient.mk (p := Bq_sub W q) ⟨zW.1, zW.2⟩
      rw [hEq]

theorem weil_doubleComplex_canonical_truncation_and_ses_finiteness (R : Type u) [CommRing R] [IsNoetherianRing R] :
    ((∀ (A B C : ℕ → Type u)
        [∀ p, AddCommGroup (A p)] [∀ p, Module R (A p)]
        [∀ p, AddCommGroup (B p)] [∀ p, Module R (B p)]
        [∀ p, AddCommGroup (C p)] [∀ p, Module R (C p)]
        (dA : ∀ p : ℕ, A p →ₗ[R] A (p + 1))
        (dB : ∀ p : ℕ, B p →ₗ[R] B (p + 1))
        (dC : ∀ p : ℕ, C p →ₗ[R] C (p + 1))
        (i : ∀ p : ℕ, A p →ₗ[R] B p)
        (q : ∀ p : ℕ, B p →ₗ[R] C p),
        (∀ p x, dA (p + 1) (dA p x) = 0) →
        (∀ p x, dB (p + 1) (dB p x) = 0) →
        (∀ p x, dC (p + 1) (dC p x) = 0) →
        (∀ p, Function.Injective (i p)) →
        (∀ p, Function.Surjective (q p)) →
        (∀ p, Function.Exact (i p) (q p)) →
        (∀ p x, i (p + 1) (dA p x) = dB p (i p x)) →
        (∀ p x, q (p + 1) (dB p x) = dC p (q p x)) →
        Module.Finite R ↥(LinearMap.ker (dC 0)) →
        (∀ p : ℕ, Module.Finite R
          (↥(LinearMap.ker (dC (p + 1))) ⧸
            (LinearMap.range (dC p)).comap (LinearMap.ker (dC (p + 1))).subtype)) →
        ((Module.Finite R ↥(LinearMap.ker (dA 0)) ∧
          ∀ p : ℕ, Module.Finite R
            (↥(LinearMap.ker (dA (p + 1))) ⧸
              (LinearMap.range (dA p)).comap (LinearMap.ker (dA (p + 1))).subtype)) ↔
         (Module.Finite R ↥(LinearMap.ker (dB 0)) ∧
          ∀ p : ℕ, Module.Finite R
            (↥(LinearMap.ker (dB (p + 1))) ⧸
              (LinearMap.range (dB p)).comap (LinearMap.ker (dB (p + 1))).subtype)))) ∧
     (∀ (K_h K_v : ℕ) (E : ℕ → ℕ → Type u)
        [∀ p q, AddCommGroup (E p q)] [∀ p q, Module R (E p q)]
        (d_h : ∀ p q : ℕ, E p q →ₗ[R] E (p + 1) q)
        (d_v : ∀ p q : ℕ, E p q →ₗ[R] E p (q + 1)),
        (∀ p q x, d_h (p + 1) q (d_h p q x) = 0) →
        (∀ p q x, d_v p (q + 1) (d_v p q x) = 0) →
        (∀ p q x, d_h p (q + 1) (d_v p q x) = d_v (p + 1) q (d_h p q x)) →
        (∀ p q, K_h < p → Subsingleton (E p q)) →
        (∀ p q, K_v < q → Subsingleton (E p q)) →
        (∀ p q (z : E (p + 1) q), d_h (p + 1) q z = 0 → ∃ b : E p q, d_h p q b = z) →
        ∀ (dH0 : ∀ q : ℕ, ↥(LinearMap.ker (d_h 0 q)) →ₗ[R] ↥(LinearMap.ker (d_h 0 (q + 1))))
          (dVq : ∀ q p : ℕ,
            (↥(LinearMap.ker (d_v p (q + 1))) ⧸
              (LinearMap.range (d_v p q)).comap (LinearMap.ker (d_v p (q + 1))).subtype) →ₗ[R]
            (↥(LinearMap.ker (d_v (p + 1) (q + 1))) ⧸
              (LinearMap.range (d_v (p + 1) q)).comap
                (LinearMap.ker (d_v (p + 1) (q + 1))).subtype))
          (dV0 : ∀ p : ℕ, ↥(LinearMap.ker (d_v p 0)) →ₗ[R] ↥(LinearMap.ker (d_v (p + 1) 0))),
          (∀ q (x : ↥(LinearMap.ker (d_h 0 q))), (dH0 q x).1 = d_v 0 q x.1) →
          (∀ q p (x : ↥(LinearMap.ker (d_v p (q + 1)))),
            ∃ hx' : d_h p (q + 1) x.1 ∈ LinearMap.ker (d_v (p + 1) (q + 1)),
              dVq q p (Submodule.Quotient.mk x) = Submodule.Quotient.mk ⟨d_h p (q + 1) x.1, hx'⟩) →
          (∀ p (x : ↥(LinearMap.ker (d_v p 0))), (dV0 p x).1 = d_h p 0 x.1) →
          Module.Finite R ↥(LinearMap.ker (dH0 0)) →
          (∀ q : ℕ, Module.Finite R
            (↥(LinearMap.ker (dH0 (q + 1))) ⧸
              (LinearMap.range (dH0 q)).comap (LinearMap.ker (dH0 (q + 1))).subtype)) →
          (∀ q : ℕ,
            Module.Finite R ↥(LinearMap.ker (dVq q 0)) ∧
            ∀ p : ℕ, Module.Finite R
              (↥(LinearMap.ker (dVq q (p + 1))) ⧸
                (LinearMap.range (dVq q p)).comap (LinearMap.ker (dVq q (p + 1))).subtype)) →
          Module.Finite R ↥(LinearMap.ker (dV0 0)) ∧
          ∀ p : ℕ, Module.Finite R
            (↥(LinearMap.ker (dV0 (p + 1))) ⧸
              (LinearMap.range (dV0 p)).comap (LinearMap.ker (dV0 (p + 1))).subtype))) :=
by
  
  
  
  let HasFinCohom : ∀ (K : ℕ → Type u) [∀ p, AddCommGroup (K p)] [∀ p, Module R (K p)]
      (d : ∀ p : ℕ, K p →ₗ[R] K (p + 1)), Prop :=
    fun K _ _ d =>
      Module.Finite R ↥(LinearMap.ker (d 0)) ∧
      ∀ p : ℕ, Module.Finite R
        (↥(LinearMap.ker (d (p + 1))) ⧸
          (LinearMap.range (d p)).comap (LinearMap.ker (d (p + 1))).subtype)
  let coboundary : ∀ (K : ℕ → Type u) [∀ p, AddCommGroup (K p)] [∀ p, Module R (K p)]
      (d : ∀ p : ℕ, K p →ₗ[R] K (p + 1)) (n : ℕ), Submodule R ↥(LinearMap.ker (d n)) :=
    fun K _ _ d n =>
      match n with
      | 0 => ⊥
      | p + 1 => (LinearMap.range (d p)).comap (LinearMap.ker (d (p + 1))).subtype
  let Cohom : ∀ (K : ℕ → Type u) [∀ p, AddCommGroup (K p)] [∀ p, Module R (K p)]
      (d : ∀ p : ℕ, K p →ₗ[R] K (p + 1)) (n : ℕ), Type u :=
    fun K _ _ d n => ↥(LinearMap.ker (d n)) ⧸ coboundary K d n
  have hasFinCohom_iff : ∀ (K : ℕ → Type u) [∀ p, AddCommGroup (K p)] [∀ p, Module R (K p)]
      (d : ∀ p : ℕ, K p →ₗ[R] K (p + 1)),
      HasFinCohom K d ↔ ∀ n : ℕ, Module.Finite R (Cohom K d n) := by
    intro K _ _ d
    let e0 : Cohom K d 0 ≃ₗ[R] ↥(LinearMap.ker (d 0)) :=
      Submodule.quotEquivOfEqBot (coboundary K d 0) rfl
    constructor
    · rintro ⟨h0, hsucc⟩ n
      cases n with
      | zero =>
        haveI := h0
        exact Module.Finite.equiv e0.symm
      | succ p => exact hsucc p
    · intro hall
      refine ⟨?_, fun p => hall (p + 1)⟩
      haveI := hall 0
      exact Module.Finite.equiv e0
  let kerMap : ∀ {X Y : ℕ → Type u}
      [∀ p, AddCommGroup (X p)] [∀ p, Module R (X p)]
      [∀ p, AddCommGroup (Y p)] [∀ p, Module R (Y p)]
      {dX : ∀ p : ℕ, X p →ₗ[R] X (p + 1)} {dY : ∀ p : ℕ, Y p →ₗ[R] Y (p + 1)}
      (φ : ∀ p : ℕ, X p →ₗ[R] Y p)
      (_ : ∀ p x, φ (p + 1) (dX p x) = dY p (φ p x)) (n : ℕ),
      ↥(LinearMap.ker (dX n)) →ₗ[R] ↥(LinearMap.ker (dY n)) :=
    fun {_ _ _ _ _ _ dX dY} φ hcomm n =>
      { toFun := fun x => ⟨φ n x.1, by
          rw [LinearMap.mem_ker, ← hcomm n x.1, LinearMap.mem_ker.mp x.2, map_zero]⟩
        map_add' := fun x y => Subtype.ext (map_add (φ n) x.1 y.1)
        map_smul' := fun r x => Subtype.ext (map_smul (φ n) r x.1) }
  have coboundary_le_comap : ∀ {X Y : ℕ → Type u}
      [∀ p, AddCommGroup (X p)] [∀ p, Module R (X p)]
      [∀ p, AddCommGroup (Y p)] [∀ p, Module R (Y p)]
      {dX : ∀ p : ℕ, X p →ₗ[R] X (p + 1)} {dY : ∀ p : ℕ, Y p →ₗ[R] Y (p + 1)}
      (φ : ∀ p : ℕ, X p →ₗ[R] Y p)
      (hcomm : ∀ p x, φ (p + 1) (dX p x) = dY p (φ p x)) (n : ℕ),
      coboundary X dX n ≤ (coboundary Y dY n).comap (kerMap φ hcomm n) := by
    intro X Y _ _ _ _ dX dY φ hcomm n
    cases n with
    | zero => exact bot_le
    | succ p =>
      rintro x ⟨x₀, hx₀⟩
      exact ⟨φ p x₀, by change dY p (φ p x₀) = φ (p + 1) x.1; rw [← hcomm p x₀, hx₀]; rfl⟩
  let mapCohom : ∀ {X Y : ℕ → Type u}
      [∀ p, AddCommGroup (X p)] [∀ p, Module R (X p)]
      [∀ p, AddCommGroup (Y p)] [∀ p, Module R (Y p)]
      {dX : ∀ p : ℕ, X p →ₗ[R] X (p + 1)} {dY : ∀ p : ℕ, Y p →ₗ[R] Y (p + 1)}
      (φ : ∀ p : ℕ, X p →ₗ[R] Y p)
      (hcomm : ∀ p x, φ (p + 1) (dX p x) = dY p (φ p x)) (n : ℕ),
      Cohom X dX n →ₗ[R] Cohom Y dY n :=
    fun {X Y _ _ _ _ dX dY} φ hcomm n =>
      Submodule.mapQ (coboundary X dX n) (coboundary Y dY n)
        (kerMap φ hcomm n) (coboundary_le_comap φ hcomm n)
  have cohomFin_iff_of_bijective : ∀ {X Y : ℕ → Type u}
      [∀ p, AddCommGroup (X p)] [∀ p, Module R (X p)]
      [∀ p, AddCommGroup (Y p)] [∀ p, Module R (Y p)]
      (dX : ∀ p : ℕ, X p →ₗ[R] X (p + 1)) (dY : ∀ p : ℕ, Y p →ₗ[R] Y (p + 1))
      (φ : ∀ p : ℕ, X p →ₗ[R] Y p),
      (∀ p x, φ (p + 1) (dX p x) = dY p (φ p x)) →
      (∀ p, Function.Bijective (φ p)) →
      (HasFinCohom X dX ↔ HasFinCohom Y dY) := by
    intro X Y _ _ _ _ dX dY φ hcomm hbij
    let e : ∀ p : ℕ, X p ≃ₗ[R] Y p := fun p => LinearEquiv.ofBijective (φ p) (hbij p)
    have hcomm_inv : ∀ p y, (e (p + 1)).symm.toLinearMap (dY p y) =
        dX p ((e p).symm.toLinearMap y) := by
      intro p y
      apply (e (p + 1)).injective
      change e (p + 1) ((e (p + 1)).symm (dY p y)) = φ (p + 1) (dX p ((e p).symm y))
      rw [LinearEquiv.apply_symm_apply, hcomm]
      change dY p y = dY p (e p ((e p).symm y))
      rw [LinearEquiv.apply_symm_apply]
    have hEq : ∀ n : ℕ, Nonempty (Cohom X dX n ≃ₗ[R] Cohom Y dY n) := by
      intro n
      refine ⟨LinearEquiv.ofLinearMap
        (mapCohom φ hcomm n)
        (mapCohom (fun p => (e p).symm.toLinearMap) hcomm_inv n) ?_ ?_⟩
      · ext y
        dsimp only [LinearMap.comp_apply, LinearMap.id_apply, mapCohom]
        rw [Submodule.mkQ_apply, Submodule.mapQ_apply, Submodule.mapQ_apply]
        congr 1
        apply Subtype.ext
        exact (e n).apply_symm_apply y.1
      · ext x
        dsimp only [LinearMap.comp_apply, LinearMap.id_apply, mapCohom]
        rw [Submodule.mkQ_apply, Submodule.mapQ_apply, Submodule.mapQ_apply]
        congr 1
        apply Subtype.ext
        exact (e n).symm_apply_apply x.1
    rw [hasFinCohom_iff, hasFinCohom_iff]
    refine ⟨fun hX n => ?_, fun hY n => ?_⟩
    · obtain ⟨en⟩ := hEq n
      haveI := hX n
      exact Module.Finite.equiv en
    · obtain ⟨en⟩ := hEq n
      haveI := hY n
      exact Module.Finite.equiv en.symm

  
  
  
  have fin_of_exact : ∀ {U V W : Type u}
      [AddCommGroup U] [Module R U] [AddCommGroup V] [Module R V] [AddCommGroup W] [Module R W]
      (f : U →ₗ[R] V) (g : V →ₗ[R] W),
      Function.Exact ⇑f ⇑g → Module.Finite R U → Module.Finite R W → Module.Finite R V := by
    intro U V W _ _ _ _ _ _ f g hEx hU hW
    haveI : Module.Finite R U := hU
    haveI : Module.Finite R W := hW
    have hker : LinearMap.ker g = LinearMap.range f := LinearMap.exact_iff.mp hEx
    haveI : Module.Finite R ↥(LinearMap.ker g) := by
      rw [hker]
      exact Module.Finite.range f
    haveI : Module.Finite R ↥(LinearMap.range g) := inferInstance
    haveI : Module.Finite R (V ⧸ LinearMap.ker g) :=
      Module.Finite.equiv (LinearMap.quotKerEquivRange g).symm
    exact Module.Finite.of_submodule_quotient (LinearMap.ker g)

  have hSES : ∀ (A B C : ℕ → Type u)
      [∀ p, AddCommGroup (A p)] [∀ p, Module R (A p)]
      [∀ p, AddCommGroup (B p)] [∀ p, Module R (B p)]
      [∀ p, AddCommGroup (C p)] [∀ p, Module R (C p)]
      (dA : ∀ p : ℕ, A p →ₗ[R] A (p + 1))
      (dB : ∀ p : ℕ, B p →ₗ[R] B (p + 1))
      (dC : ∀ p : ℕ, C p →ₗ[R] C (p + 1))
      (i : ∀ p : ℕ, A p →ₗ[R] B p)
      (q : ∀ p : ℕ, B p →ₗ[R] C p),
      (∀ p x, dA (p + 1) (dA p x) = 0) →
      (∀ p x, dB (p + 1) (dB p x) = 0) →
      (∀ p x, dC (p + 1) (dC p x) = 0) →
      (∀ p, Function.Injective (i p)) →
      (∀ p, Function.Surjective (q p)) →
      (∀ p, Function.Exact (i p) (q p)) →
      (∀ p x, i (p + 1) (dA p x) = dB p (i p x)) →
      (∀ p x, q (p + 1) (dB p x) = dC p (q p x)) →
      HasFinCohom C dC →
      (HasFinCohom A dA ↔ HasFinCohom B dB) := by
    intro A B C _ _ _ _ _ _ dA dB dC i q _hdA hdB _hdC hi hq hex hcomm_i hcomm_q hFinC
    have hC_all : ∀ n : ℕ, Module.Finite R (Cohom C dC n) :=
      (hasFinCohom_iff C dC).mp hFinC
    let i_star : ∀ n : ℕ, Cohom A dA n →ₗ[R] Cohom B dB n := mapCohom i hcomm_i
    let q_star : ∀ n : ℕ, Cohom B dB n →ₗ[R] Cohom C dC n := mapCohom q hcomm_q
    have hEx_B : ∀ n : ℕ, Function.Exact ⇑(i_star n) ⇑(q_star n) := by
      intro n u
      constructor
      · intro h0
        rcases Submodule.Quotient.mk_surjective _ u with ⟨y, rfl⟩
        dsimp only [q_star, mapCohom] at h0
        rw [Submodule.mapQ_apply, Submodule.Quotient.mk_eq_zero] at h0
        cases n with
        | zero =>
          change kerMap q hcomm_q 0 y ∈ (⊥ : Submodule R _) at h0
          rw [Submodule.mem_bot] at h0
          have hqy : q 0 y.1 = 0 := congrArg Subtype.val h0
          obtain ⟨a, ha_eq⟩ := (hex 0 y.1).mp hqy
          have ha_ker : a ∈ LinearMap.ker (dA 0) := by
            rw [LinearMap.mem_ker]
            apply hi 1
            rw [hcomm_i 0 a, ha_eq, LinearMap.mem_ker.mp y.2, map_zero]
          refine ⟨Submodule.Quotient.mk ⟨a, ha_ker⟩, ?_⟩
          dsimp only [i_star, mapCohom]
          rw [Submodule.mapQ_apply]
          congr 1
          exact Subtype.ext ha_eq
        | succ p =>
          rcases h0 with ⟨c₀, hc₀⟩
          obtain ⟨b₀, rfl⟩ := hq p c₀
          let y' : B (p + 1) := y.1 - dB p b₀
          have hy'_ker : dB (p + 1) y' = 0 := by
            simp only [y', map_sub, LinearMap.mem_ker.mp y.2, hdB p b₀, sub_zero]
          have hqy' : q (p + 1) y' = 0 := by
            dsimp only [y']
            rw [map_sub, hcomm_q p b₀]
            have hc₀' : dC p (q p b₀) = q (p + 1) y.1 := hc₀
            rw [hc₀', sub_self]
          obtain ⟨a, ha_eq⟩ := (hex (p + 1) y').mp hqy'
          have ha_ker : a ∈ LinearMap.ker (dA (p + 1)) := by
            rw [LinearMap.mem_ker]
            apply hi (p + 2)
            rw [hcomm_i (p + 1) a, ha_eq, hy'_ker, map_zero]
          refine ⟨Submodule.Quotient.mk ⟨a, ha_ker⟩, ?_⟩
          dsimp only [i_star, mapCohom]
          rw [Submodule.mapQ_apply, Submodule.Quotient.eq]
          refine ⟨-b₀, ?_⟩
          change dB p (-b₀) = i (p + 1) a - y.1
          rw [map_neg, ha_eq]
          dsimp only [y']
          abel
      · rintro ⟨v, rfl⟩
        rcases Submodule.Quotient.mk_surjective _ v with ⟨x, rfl⟩
        dsimp only [i_star, q_star, mapCohom]
        rw [Submodule.mapQ_apply, Submodule.mapQ_apply, Submodule.Quotient.mk_eq_zero]
        have hqi : kerMap q hcomm_q n (kerMap i hcomm_i n x) = 0 := by
          apply Subtype.ext
          exact (hex n).apply_apply_eq_zero x.1
        rw [hqi]
        exact (coboundary C dC n).zero_mem
    let IsSnake : ∀ (n : ℕ), C n → ↥(LinearMap.ker (dA (n + 1))) → Prop :=
      fun n z a => ∃ b : B n, q n b = z ∧ i (n + 1) a.1 = dB n b
    have snake_exists : ∀ (n : ℕ) (z : ↥(LinearMap.ker (dC n))),
        ∃ a : ↥(LinearMap.ker (dA (n + 1))), IsSnake n z.1 a := by
      intro n z
      obtain ⟨b, hb⟩ := hq n z.1
      have hq_db : q (n + 1) (dB n b) = 0 := by
        rw [hcomm_q n b, hb, LinearMap.mem_ker.mp z.2]
      obtain ⟨a₀, ha₀⟩ := (hex (n + 1) (dB n b)).mp hq_db
      have ha₀_ker : a₀ ∈ LinearMap.ker (dA (n + 1)) := by
        rw [LinearMap.mem_ker]
        apply hi (n + 2)
        rw [hcomm_i (n + 1) a₀, ha₀, hdB n b, map_zero]
      exact ⟨⟨a₀, ha₀_ker⟩, b, hb, ha₀⟩
    have snake_unique : ∀ (n : ℕ) (z : C n)
        (a₁ a₂ : ↥(LinearMap.ker (dA (n + 1)))),
        IsSnake n z a₁ → IsSnake n z a₂ →
        (Submodule.Quotient.mk a₁ : Cohom A dA (n + 1)) = Submodule.Quotient.mk a₂ := by
      rintro n z a₁ a₂ ⟨b₁, hb₁, ha₁⟩ ⟨b₂, hb₂, ha₂⟩
      rw [Submodule.Quotient.eq]
      have hq_sub : q n (b₁ - b₂) = 0 := by rw [map_sub, hb₁, hb₂, sub_self]
      obtain ⟨u, hu⟩ := (hex n (b₁ - b₂)).mp hq_sub
      refine ⟨u, hi (n + 1) ?_⟩
      change i (n + 1) (dA n u) = i (n + 1) (a₁.1 - a₂.1)
      rw [hcomm_i n u, hu, map_sub, map_sub, ha₁, ha₂]
    let δ_raw : ∀ n : ℕ, ↥(LinearMap.ker (dC n)) →ₗ[R] Cohom A dA (n + 1) :=
      fun n =>
        { toFun := fun z => Submodule.Quotient.mk (Classical.choose (snake_exists n z))
          map_add' := fun z₁ z₂ => by
            let a₁ := Classical.choose (snake_exists n z₁)
            let a₂ := Classical.choose (snake_exists n z₂)
            obtain ⟨b₁, hb₁, ha₁⟩ := Classical.choose_spec (snake_exists n z₁)
            obtain ⟨b₂, hb₂, ha₂⟩ := Classical.choose_spec (snake_exists n z₂)
            have hsum : IsSnake n (z₁ + z₂).1 (a₁ + a₂) :=
              ⟨b₁ + b₂, by rw [map_add, hb₁, hb₂]; rfl,
                by change i (n + 1) (a₁.1 + a₂.1) = dB n (b₁ + b₂);
                   rw [map_add, map_add, ha₁, ha₂]⟩
            rw [snake_unique n (z₁ + z₂).1 _ (a₁ + a₂)
              (Classical.choose_spec (snake_exists n (z₁ + z₂))) hsum]
            rfl
          map_smul' := fun r z => by
            let a := Classical.choose (snake_exists n z)
            obtain ⟨b, hb, ha⟩ := Classical.choose_spec (snake_exists n z)
            have hsmul : IsSnake n (r • z).1 (r • a) :=
              ⟨r • b, by rw [map_smul, hb]; rfl,
                by change i (n + 1) (r • a.1) = dB n (r • b);
                   rw [map_smul, map_smul, ha]⟩
            rw [snake_unique n (r • z).1 _ (r • a)
              (Classical.choose_spec (snake_exists n (r • z))) hsmul]
            rfl }
    have hδ_cob : ∀ n : ℕ, coboundary C dC n ≤ LinearMap.ker (δ_raw n) := by
      intro n
      cases n with
      | zero => exact bot_le
      | succ m =>
        rintro z ⟨c₀, hc₀⟩
        obtain ⟨b₀, rfl⟩ := hq m c₀
        rw [LinearMap.mem_ker]
        have hzero : IsSnake (m + 1) z.1 0 :=
          ⟨dB m b₀, by rw [hcomm_q m b₀]; exact hc₀,
            by change i (m + 2) 0 = dB (m + 1) (dB m b₀); rw [map_zero, hdB m b₀]⟩
        exact (snake_unique (m + 1) z.1 _ 0
          (Classical.choose_spec (snake_exists (m + 1) z)) hzero).trans
          (Submodule.Quotient.mk_zero _)
    let δ : ∀ n : ℕ, Cohom C dC n →ₗ[R] Cohom A dA (n + 1) :=
      fun n => Submodule.liftQ (coboundary C dC n) (δ_raw n) (hδ_cob n)
    have hEx_A_succ : ∀ n : ℕ, Function.Exact ⇑(δ n) ⇑(i_star (n + 1)) := by
      intro n u
      constructor
      · intro h0
        rcases Submodule.Quotient.mk_surjective _ u with ⟨a, rfl⟩
        dsimp only [i_star, mapCohom] at h0
        rw [Submodule.mapQ_apply, Submodule.Quotient.mk_eq_zero] at h0
        rcases h0 with ⟨b, hb⟩
        have hc_ker : q n b ∈ LinearMap.ker (dC n) := by
          rw [LinearMap.mem_ker, ← hcomm_q n b]
          have hb' : dB n b = i (n + 1) a.1 := hb
          rw [hb']
          exact (hex (n + 1)).apply_apply_eq_zero a.1
        let z : ↥(LinearMap.ker (dC n)) := ⟨q n b, hc_ker⟩
        refine ⟨Submodule.Quotient.mk z, ?_⟩
        dsimp only [δ]
        rw [Submodule.liftQ_apply]
        exact snake_unique n z.1 _ a
          (Classical.choose_spec (snake_exists n z)) ⟨b, rfl, hb.symm⟩
      · rintro ⟨w, rfl⟩
        rcases Submodule.Quotient.mk_surjective _ w with ⟨z, rfl⟩
        dsimp only [δ]
        rw [Submodule.liftQ_apply]
        let a₀ := Classical.choose (snake_exists n z)
        obtain ⟨b, _hb, ha₀⟩ := Classical.choose_spec (snake_exists n z)
        change i_star (n + 1) (Submodule.Quotient.mk a₀) = 0
        dsimp only [i_star, mapCohom]
        rw [Submodule.mapQ_apply, Submodule.Quotient.mk_eq_zero]
        exact ⟨b, ha₀.symm⟩
    have hEx_A0 : Function.Exact ⇑(0 : Cohom C dC 0 →ₗ[R] Cohom A dA 0) ⇑(i_star 0) := by
      rw [LinearMap.exact_iff, LinearMap.range_zero]
      ext u
      rw [LinearMap.mem_ker, Submodule.mem_bot]
      rcases Submodule.Quotient.mk_surjective _ u with ⟨a, rfl⟩
      constructor
      · intro h0
        dsimp only [i_star, mapCohom] at h0
        rw [Submodule.mapQ_apply, Submodule.Quotient.mk_eq_zero] at h0
        change kerMap i hcomm_i 0 a ∈ (⊥ : Submodule R _) at h0
        rw [Submodule.mem_bot] at h0
        have hia : i 0 a.1 = 0 := congrArg Subtype.val h0
        have ha0 : a = 0 := Subtype.ext (hi 0 (hia.trans (map_zero (i 0)).symm))
        rw [ha0, Submodule.Quotient.mk_zero]
      · intro h0
        rw [h0, map_zero]
    rw [hasFinCohom_iff, hasFinCohom_iff]
    constructor
    · intro hA n
      exact fin_of_exact (i_star n) (q_star n) (hEx_B n) (hA n) (hC_all n)
    · intro hB n
      cases n with
      | zero =>
        exact fin_of_exact (0 : Cohom C dC 0 →ₗ[R] Cohom A dA 0) (i_star 0) hEx_A0
          (hC_all 0) (hB 0)
      | succ m =>
        exact fin_of_exact (δ m) (i_star (m + 1)) (hEx_A_succ m)
          (hC_all m) (hB (m + 1))

  
  
  
  let Tot : (ℕ → ℕ → Type u) → ℕ → Type u :=
    fun E n => ∀ p q : ℕ, PLift (p + q = n) → E p q
  let totDiffH : ∀ (E : ℕ → ℕ → Type u)
      [∀ p q, AddCommGroup (E p q)] [∀ p q, Module R (E p q)]
      (d_h : ∀ p q : ℕ, E p q →ₗ[R] E (p + 1) q) (n : ℕ),
      Tot E n →ₗ[R] Tot E (n + 1) :=
    fun E _ _ d_h n =>
      { toFun := fun f p q hpq =>
          match p with
          | 0 => 0
          | p' + 1 => d_h p' q (f p' q ⟨by have := hpq.down; omega⟩)
        map_add' := fun f₁ f₂ => by
          funext p q hpq
          cases p with
          | zero => exact (add_zero 0).symm
          | succ p' => exact map_add (d_h p' q) _ _
        map_smul' := fun r f => by
          funext p q hpq
          cases p with
          | zero => exact (smul_zero r).symm
          | succ p' => exact map_smul (d_h p' q) r _ }
  let totDiffV : ∀ (E : ℕ → ℕ → Type u)
      [∀ p q, AddCommGroup (E p q)] [∀ p q, Module R (E p q)]
      (d_v : ∀ p q : ℕ, E p q →ₗ[R] E p (q + 1)) (n : ℕ),
      Tot E n →ₗ[R] Tot E (n + 1) :=
    fun E _ _ d_v n =>
      { toFun := fun f p q hpq =>
          match q with
          | 0 => 0
          | q' + 1 => ((-1 : ℤ) ^ p) • d_v p q' (f p q' ⟨by have := hpq.down; omega⟩)
        map_add' := fun f₁ f₂ => by
          funext p q hpq
          cases q with
          | zero => exact (add_zero 0).symm
          | succ q' =>
            change ((-1 : ℤ) ^ p) • d_v p q' (f₁ p q' _ + f₂ p q' _) = _ + _
            rw [map_add, smul_add]
        map_smul' := fun r f => by
          funext p q hpq
          cases q with
          | zero => exact (smul_zero r).symm
          | succ q' =>
            change ((-1 : ℤ) ^ p) • d_v p q' (r • f p q' _) = r • (((-1 : ℤ) ^ p) • _)
            rw [map_smul, smul_comm] }
  let totDiff : ∀ (E : ℕ → ℕ → Type u)
      [∀ p q, AddCommGroup (E p q)] [∀ p q, Module R (E p q)]
      (d_h : ∀ p q : ℕ, E p q →ₗ[R] E (p + 1) q)
      (d_v : ∀ p q : ℕ, E p q →ₗ[R] E p (q + 1)) (n : ℕ),
      Tot E n →ₗ[R] Tot E (n + 1) :=
    fun E _ _ d_h d_v n => totDiffH E d_h n + totDiffV E d_v n

  have totDiff_sq : ∀ (E : ℕ → ℕ → Type u)
      [∀ p q, AddCommGroup (E p q)] [∀ p q, Module R (E p q)]
      (d_h : ∀ p q : ℕ, E p q →ₗ[R] E (p + 1) q)
      (d_v : ∀ p q : ℕ, E p q →ₗ[R] E p (q + 1)),
      (∀ p q x, d_h (p + 1) q (d_h p q x) = 0) →
      (∀ p q x, d_v p (q + 1) (d_v p q x) = 0) →
      (∀ p q x, d_h p (q + 1) (d_v p q x) = d_v (p + 1) q (d_h p q x)) →
      ∀ n f, totDiff E d_h d_v (n + 1) (totDiff E d_h d_v n f) = 0 := by
    intro E _ _ d_h d_v hd_h2 hd_v2 hd_hv n f
    have hHH : totDiffH E d_h (n + 1) (totDiffH E d_h n f) = 0 := by
      funext p q hpq
      match p with
      | 0 => rfl
      | 1 => exact map_zero (d_h 0 q)
      | p'' + 2 => exact hd_h2 p'' q _
    have hVV : totDiffV E d_v (n + 1) (totDiffV E d_v n f) = 0 := by
      funext p q hpq
      match q with
      | 0 => rfl
      | 1 =>
        change ((-1 : ℤ) ^ p) • d_v p 0 0 = 0
        rw [map_zero, smul_zero]
      | q'' + 2 =>
        change ((-1 : ℤ) ^ p) • d_v p (q'' + 1) (((-1 : ℤ) ^ p) • d_v p q'' _) = 0
        rw [map_zsmul, hd_v2 p q'', smul_zero, smul_zero]
    have hHV : totDiffH E d_h (n + 1) (totDiffV E d_v n f) +
        totDiffV E d_v (n + 1) (totDiffH E d_h n f) = 0 := by
      funext p q hpq
      cases p with
      | zero =>
        cases q with
        | zero => exact add_zero 0
        | succ q' =>
          change 0 + ((-1 : ℤ) ^ 0) • d_v 0 q' 0 = 0
          rw [map_zero, smul_zero, add_zero]
      | succ p' =>
        cases q with
        | zero =>
          change d_h p' 0 0 + 0 = 0
          rw [map_zero, add_zero]
        | succ q' =>
          change d_h p' (q' + 1) (((-1 : ℤ) ^ p') • d_v p' q' (f p' q' _)) +
            ((-1 : ℤ) ^ (p' + 1)) • d_v (p' + 1) q' (d_h p' q' (f p' q' _)) = 0
          rw [map_zsmul, hd_hv p' q', ← add_smul]
          have hsign : (-1 : ℤ) ^ p' + (-1 : ℤ) ^ (p' + 1) = 0 := by
            rw [pow_succ]; ring
          rw [hsign, zero_smul]
    simp only [totDiff, LinearMap.add_apply, map_add, hHH, hVV, zero_add, add_zero]
    rw [add_comm (totDiffV E d_v (n + 1) _), hHV]

  have totSwap_fin_iff : ∀ (E : ℕ → ℕ → Type u)
      [∀ p q, AddCommGroup (E p q)] [∀ p q, Module R (E p q)]
      (d_h : ∀ p q : ℕ, E p q →ₗ[R] E (p + 1) q)
      (d_v : ∀ p q : ℕ, E p q →ₗ[R] E p (q + 1)),
      HasFinCohom (Tot E) (totDiff E d_h d_v) ↔
      HasFinCohom (Tot (fun a b => E b a))
        (totDiff (fun a b => E b a) (fun a b => d_v b a) (fun a b => d_h b a)) := by
    intro E _ _ d_h d_v
    let E_sw : ℕ → ℕ → Type u := fun a b => E b a
    let d_h_sw : ∀ a b : ℕ, E_sw a b →ₗ[R] E_sw (a + 1) b := fun a b => d_v b a
    let d_v_sw : ∀ a b : ℕ, E_sw a b →ₗ[R] E_sw a (b + 1) := fun a b => d_h b a
    let swapMap : ∀ n : ℕ, Tot E n →ₗ[R] Tot E_sw n := fun n =>
      { toFun := fun f a b hab => ((-1 : ℤ) ^ (b * a)) • f b a ⟨by have := hab.down; omega⟩
        map_add' := fun f₁ f₂ => funext fun a => funext fun b => funext fun _ => smul_add _ _ _
        map_smul' := fun r f => funext fun a => funext fun b => funext fun _ =>
          smul_comm ((-1 : ℤ) ^ (b * a)) r _ }
    have hSwap_inv : ∀ (n : ℕ) (a b : ℕ) (x : E b a),
        ((-1 : ℤ) ^ (a * b)) • (((-1 : ℤ) ^ (b * a)) • x) = x := by
      intro n a b x
      rw [Nat.mul_comm a b, smul_smul, ← mul_pow]
      norm_num
    have hSwap_bij : ∀ n : ℕ, Function.Bijective (swapMap n) := by
      intro n
      constructor
      · intro f₁ f₂ hf
        funext p q hpq
        have h_at := congrFun (congrFun (congrFun hf q) p) ⟨by have := hpq.down; omega⟩
        have h2 := congrArg (fun z : E p q => ((-1 : ℤ) ^ (q * p)) • z) h_at
        simpa only [swapMap, LinearMap.coe_mk, AddHom.coe_mk, hSwap_inv n q p] using h2
      · intro g
        refine ⟨fun p q hpq => ((-1 : ℤ) ^ (q * p)) • g q p ⟨by have := hpq.down; omega⟩, ?_⟩
        funext a b hab
        change ((-1 : ℤ) ^ (b * a)) • (((-1 : ℤ) ^ (a * b)) • g a b hab) = g a b hab
        rw [Nat.mul_comm b a, smul_smul, ← mul_pow]
        norm_num
    have hSwap_comm : ∀ n f,
        swapMap (n + 1) (totDiff E d_h d_v n f) =
          totDiff E_sw d_h_sw d_v_sw n (swapMap n f) := by
      intro n f
      have h1 : totDiffH E_sw d_h_sw n (swapMap n f) =
          swapMap (n + 1) (totDiffV E d_v n f) := by
        funext a b hab
        cases a with
        | zero =>
          change (0 : E b 0) = ((-1 : ℤ) ^ (b * 0)) • 0
          rw [smul_zero]
        | succ a' =>
          change d_v b a' (((-1 : ℤ) ^ (b * a')) • f b a' _) =
            ((-1 : ℤ) ^ (b * (a' + 1))) • (((-1 : ℤ) ^ b) • d_v b a' (f b a' _))
          rw [map_zsmul, smul_smul, ← pow_add]
          have hexp : b * (a' + 1) + b = b * a' + 2 * b := by ring
          rw [hexp, pow_add, pow_mul]
          norm_num
      have h2 : totDiffV E_sw d_v_sw n (swapMap n f) =
          swapMap (n + 1) (totDiffH E d_h n f) := by
        funext a b hab
        cases b with
        | zero =>
          change (0 : E 0 a) = ((-1 : ℤ) ^ (0 * a)) • 0
          rw [smul_zero]
        | succ b' =>
          change ((-1 : ℤ) ^ a) • d_h b' a (((-1 : ℤ) ^ (b' * a)) • f b' a _) =
            ((-1 : ℤ) ^ ((b' + 1) * a)) • d_h b' a (f b' a _)
          rw [map_zsmul, smul_smul, ← pow_add]
          have hexp : a + b' * a = (b' + 1) * a := by ring
          rw [hexp]
      simp only [totDiff, LinearMap.add_apply, map_add, h1, h2]
      exact add_comm _ _
    exact cohomFin_iff_of_bijective _ _ swapMap hSwap_comm hSwap_bij

  
  
  
  have fin_of_subsingleton : ∀ (M : Type u) [AddCommGroup M] [Module R M],
      Subsingleton M → Module.Finite R M := by
    intro M _ _ hSub
    refine ⟨⟨∅, eq_top_iff.mpr fun x _ => ?_⟩⟩
    rw [hSub.elim x 0]
    exact Submodule.zero_mem _
  let ShiftSeq : ℕ → (ℕ → Type u) → ℕ → Type u :=
    fun s M n => ∀ p : ℕ, PLift (p + s = n) → M p
  let d_Shift : ∀ (s : ℕ) (M : ℕ → Type u)
      [∀ p, AddCommGroup (M p)] [∀ p, Module R (M p)]
      (dM : ∀ p : ℕ, M p →ₗ[R] M (p + 1)) (n : ℕ),
      ShiftSeq s M n →ₗ[R] ShiftSeq s M (n + 1) :=
    fun s M _ _ dM n =>
      { toFun := fun g p hp =>
          match p with
          | 0 => 0
          | p' + 1 => dM p' (g p' ⟨by have := hp.down; omega⟩)
        map_add' := fun g₁ g₂ => by
          funext p hp
          cases p with
          | zero => exact (add_zero 0).symm
          | succ p' => exact map_add (dM p') _ _
        map_smul' := fun r g => by
          funext p hp
          cases p with
          | zero => exact (smul_zero r).symm
          | succ p' => exact map_smul (dM p') r _ }
  have d_Shift_sq : ∀ (s : ℕ) (M : ℕ → Type u)
      [∀ p, AddCommGroup (M p)] [∀ p, Module R (M p)]
      (dM : ∀ p : ℕ, M p →ₗ[R] M (p + 1)),
      (∀ p x, dM (p + 1) (dM p x) = 0) →
      ∀ n g, d_Shift s M dM (n + 1) (d_Shift s M dM n g) = 0 := by
    intro s M _ _ dM hdM2 n g
    funext p hp
    match p with
    | 0 => rfl
    | 1 => exact map_zero (dM 0)
    | p'' + 2 => exact hdM2 p'' _
  have shift_hasFinCohom : ∀ (s : ℕ) (M : ℕ → Type u)
      [∀ p, AddCommGroup (M p)] [∀ p, Module R (M p)]
      (dM : ∀ p : ℕ, M p →ₗ[R] M (p + 1)),
      HasFinCohom M dM → HasFinCohom (ShiftSeq s M) (d_Shift s M dM) := by
    intro s
    induction s with
    | zero =>
      intro M _ _ dM hFinM
      let ev_s0 : ∀ n : ℕ, ShiftSeq 0 M n →ₗ[R] M n := fun n =>
        { toFun := fun g => g n ⟨Nat.add_zero n⟩
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      have hev_bij : ∀ n : ℕ, Function.Bijective (ev_s0 n) := by
        intro n
        constructor
        · intro g₁ g₂ hg
          funext p hp
          have hp_eq : p = n := by have := hp.down; omega
          subst hp_eq
          exact hg
        · intro m
          refine ⟨fun p hp => ?_, ?_⟩
          · exact ((Nat.add_zero p).symm.trans hp.down) ▸ m
          · rfl
      exact (cohomFin_iff_of_bijective (d_Shift 0 M dM) dM ev_s0 (fun _ _ => rfl) hev_bij).mpr hFinM
    | succ s ih =>
      intro M _ _ dM hFinM
      have hFin_s : HasFinCohom (ShiftSeq s M) (d_Shift s M dM) := ih M dM hFinM
      let stepMap : ∀ n : ℕ, ShiftSeq (s + 1) M (n + 1) →ₗ[R] ShiftSeq s M n := fun n =>
        { toFun := fun g p hp => g p ⟨by have := hp.down; omega⟩
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      have hstep_bij : ∀ n : ℕ, Function.Bijective (stepMap n) := by
        intro n
        refine ⟨fun g₁ g₂ hg => funext fun p => funext fun hp =>
          congrFun (congrFun hg p) ⟨by have := hp.down; omega⟩,
          fun h => ⟨fun p hp => h p ⟨by have := hp.down; omega⟩, rfl⟩⟩
      have hShifted : HasFinCohom (fun n => ShiftSeq (s + 1) M (n + 1))
          (fun n => d_Shift (s + 1) M dM (n + 1)) :=
        (cohomFin_iff_of_bijective (fun n => d_Shift (s + 1) M dM (n + 1)) (d_Shift s M dM)
          stepMap (fun _ _ => funext fun p => funext fun _ => by cases p <;> rfl)
          hstep_bij).mpr hFin_s
      haveI hSub0 : Subsingleton (ShiftSeq (s + 1) M 0) :=
        ⟨fun g₁ g₂ => funext fun p => funext fun hp => False.elim (by have := hp.down; omega)⟩
      refine ⟨fin_of_subsingleton _ inferInstance, ?_⟩
      intro m
      cases m with
      | zero =>
        haveI := hShifted.1
        exact Module.Finite.quotient R _
      | succ p => exact hShifted.2 p

  
  
  
  have hVertCollapse : ∀ (K_v : ℕ) (E : ℕ → ℕ → Type u)
      [∀ p q, AddCommGroup (E p q)] [∀ p q, Module R (E p q)]
      (d_h : ∀ p q : ℕ, E p q →ₗ[R] E (p + 1) q)
      (d_v : ∀ p q : ℕ, E p q →ₗ[R] E p (q + 1)),
      (∀ p q x, d_h (p + 1) q (d_h p q x) = 0) →
      (∀ p q x, d_v p (q + 1) (d_v p q x) = 0) →
      (∀ p q x, d_h p (q + 1) (d_v p q x) = d_v (p + 1) q (d_h p q x)) →
      (∀ p q, K_v < q → Subsingleton (E p q)) →
      ∀ (dVq : ∀ q p : ℕ,
          (↥(LinearMap.ker (d_v p (q + 1))) ⧸
            (LinearMap.range (d_v p q)).comap (LinearMap.ker (d_v p (q + 1))).subtype) →ₗ[R]
          (↥(LinearMap.ker (d_v (p + 1) (q + 1))) ⧸
            (LinearMap.range (d_v (p + 1) q)).comap
              (LinearMap.ker (d_v (p + 1) (q + 1))).subtype))
        (dV0 : ∀ p : ℕ, ↥(LinearMap.ker (d_v p 0)) →ₗ[R] ↥(LinearMap.ker (d_v (p + 1) 0))),
        (∀ q p (x : ↥(LinearMap.ker (d_v p (q + 1)))),
          ∃ hx' : d_h p (q + 1) x.1 ∈ LinearMap.ker (d_v (p + 1) (q + 1)),
            dVq q p (Submodule.Quotient.mk x) = Submodule.Quotient.mk ⟨d_h p (q + 1) x.1, hx'⟩) →
        (∀ p (x : ↥(LinearMap.ker (d_v p 0))), (dV0 p x).1 = d_h p 0 x.1) →
        (∀ q : ℕ, HasFinCohom _ (dVq q)) →
        (HasFinCohom (fun p => ↥(LinearMap.ker (d_v p 0))) dV0 ↔
         HasFinCohom (Tot E) (totDiff E d_h d_v)) := by
    intro K_v E _ _ d_h d_v hd_h2 hd_v2 hd_hv hBound_v dVq dV0 hdVq hdV0 hFin_dVq
    let subTotDiff : ∀ (S : ∀ p q : ℕ, Submodule R (E p q))
        (_ : ∀ p q x, x ∈ S p q → d_h p q x ∈ S (p + 1) q)
        (_ : ∀ p q x, x ∈ S p q → d_v p q x ∈ S p (q + 1)) (n : ℕ),
        Tot (fun p q => ↥(S p q)) n →ₗ[R] Tot (fun p q => ↥(S p q)) (n + 1) :=
      fun S hSh hSv n =>
        totDiff (fun p q => ↥(S p q))
          (fun p q =>
            { toFun := fun x => ⟨d_h p q x.1, hSh p q x.1 x.2⟩
              map_add' := fun x y => Subtype.ext (map_add (d_h p q) x.1 y.1)
              map_smul' := fun r x => Subtype.ext (map_smul (d_h p q) r x.1) })
          (fun p q =>
            { toFun := fun x => ⟨d_v p q x.1, hSv p q x.1 x.2⟩
              map_add' := fun x y => Subtype.ext (map_add (d_v p q) x.1 y.1)
              map_smul' := fun r x => Subtype.ext (map_smul (d_v p q) r x.1) })
          n
    have subTotDiff_sq : ∀ (S : ∀ p q : ℕ, Submodule R (E p q))
        (hSh : ∀ p q x, x ∈ S p q → d_h p q x ∈ S (p + 1) q)
        (hSv : ∀ p q x, x ∈ S p q → d_v p q x ∈ S p (q + 1)) (n : ℕ) (f),
        subTotDiff S hSh hSv (n + 1) (subTotDiff S hSh hSv n f) = 0 := by
      intro S hSh hSv n f
      exact totDiff_sq (fun p q => ↥(S p q)) _ _
        (fun p q x => Subtype.ext (hd_h2 p q x.1))
        (fun p q x => Subtype.ext (hd_v2 p q x.1))
        (fun p q x => Subtype.ext (hd_hv p q x.1)) n f
    have subTotDiff_val : ∀ (S : ∀ p q : ℕ, Submodule R (E p q))
        (hSh : ∀ p q x, x ∈ S p q → d_h p q x ∈ S (p + 1) q)
        (hSv : ∀ p q x, x ∈ S p q → d_v p q x ∈ S p (q + 1))
        (n : ℕ) (f : Tot (fun p q => ↥(S p q)) n) (p q : ℕ) (hpq : PLift (p + q = n + 1)),
        (subTotDiff S hSh hSv n f p q hpq).1 =
          totDiff E d_h d_v n (fun a b hab => (f a b hab).1) p q hpq := by
      intro S hSh hSv n f p q hpq
      change (totDiffH _ _ n f p q hpq).1 + (totDiffV _ _ n f p q hpq).1 =
        totDiffH E d_h n (fun a b hab => (f a b hab).1) p q hpq +
          totDiffV E d_v n (fun a b hab => (f a b hab).1) p q hpq
      congr 1
      · cases p <;> rfl
      · cases q <;> rfl
    let inclTot : ∀ {S₁ S₂ : ∀ p q : ℕ, Submodule R (E p q)}
        (hSub : ∀ p q, S₁ p q ≤ S₂ p q) (n : ℕ),
        Tot (fun p q => ↥(S₁ p q)) n →ₗ[R] Tot (fun p q => ↥(S₂ p q)) n :=
      fun {_ _} hSub _ =>
        { toFun := fun f p q hpq => Submodule.inclusion (hSub p q) (f p q hpq)
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
    have inclTot_inj : ∀ {S₁ S₂ : ∀ p q : ℕ, Submodule R (E p q)}
        (hSub : ∀ p q, S₁ p q ≤ S₂ p q) (n : ℕ),
        Function.Injective (inclTot hSub n) := by
      intro S₁ S₂ hSub n f₁ f₂ hf
      funext p q hpq
      apply Subtype.ext
      have h_at := congrFun (congrFun (congrFun hf p) q) hpq
      exact congrArg (Subtype.val : ↥(S₂ p q) → E p q) h_at
    have inclTot_comm : ∀ {S₁ S₂ : ∀ p q : ℕ, Submodule R (E p q)}
        (hSub : ∀ p q, S₁ p q ≤ S₂ p q)
        (hSh₁ : ∀ p q x, x ∈ S₁ p q → d_h p q x ∈ S₁ (p + 1) q)
        (hSv₁ : ∀ p q x, x ∈ S₁ p q → d_v p q x ∈ S₁ p (q + 1))
        (hSh₂ : ∀ p q x, x ∈ S₂ p q → d_h p q x ∈ S₂ (p + 1) q)
        (hSv₂ : ∀ p q x, x ∈ S₂ p q → d_v p q x ∈ S₂ p (q + 1))
        (n : ℕ) (f),
        inclTot hSub (n + 1) (subTotDiff S₁ hSh₁ hSv₁ n f) =
          subTotDiff S₂ hSh₂ hSv₂ n (inclTot hSub n f) := by
      intro S₁ S₂ hSub hSh₁ hSv₁ hSh₂ hSv₂ n f
      funext p q hpq
      apply Subtype.ext
      change (subTotDiff S₁ hSh₁ hSv₁ n f p q hpq).1 =
        (subTotDiff S₂ hSh₂ hSv₂ n (inclTot hSub n f) p q hpq).1
      rw [subTotDiff_val, subTotDiff_val]
      rfl

    let F_sub : ℕ → ∀ p q : ℕ, Submodule R (E p q) :=
      fun k p q => if q < k then ⊤ else if q = k then LinearMap.ker (d_v p q) else ⊥
    have hF_dh : ∀ k p q x, x ∈ F_sub k p q → d_h p q x ∈ F_sub k (p + 1) q := by
      intro k p q x hx
      dsimp only [F_sub] at hx ⊢
      split_ifs at hx ⊢ with hlt heq
      · trivial
      · rw [LinearMap.mem_ker, ← hd_hv p q x, LinearMap.mem_ker.mp hx, map_zero]
      · rw [Submodule.mem_bot] at hx ⊢
        rw [hx, map_zero]
    have hF_dv : ∀ k p q x, x ∈ F_sub k p q → d_v p q x ∈ F_sub k p (q + 1) := by
      intro k p q x hx
      dsimp only [F_sub] at hx ⊢
      split_ifs with hlt1 heq1
      · trivial
      · rw [LinearMap.mem_ker]
        exact hd_v2 p q x
      · rw [Submodule.mem_bot]
        split_ifs at hx with hlt0 heq0
        · omega
        · exact LinearMap.mem_ker.mp hx
        · rw [Submodule.mem_bot] at hx
          rw [hx, map_zero]
    let D_F : ∀ k n : ℕ,
        Tot (fun p q => ↥(F_sub k p q)) n →ₗ[R] Tot (fun p q => ↥(F_sub k p q)) (n + 1) :=
      fun k n => subTotDiff (F_sub k) (hF_dh k) (hF_dv k) n

    
    have hBase0 : HasFinCohom (fun p => ↥(LinearMap.ker (d_v p 0))) dV0 ↔
        HasFinCohom (Tot (fun p q => ↥(F_sub 0 p q))) (D_F 0) := by
      let ev0 : ∀ n : ℕ,
          Tot (fun p q => ↥(F_sub 0 p q)) n →ₗ[R] ↥(LinearMap.ker (d_v n 0)) := fun n =>
        { toFun := fun f => ⟨(f n 0 ⟨Nat.add_zero n⟩).1, by
            simpa [F_sub] using (f n 0 ⟨Nat.add_zero n⟩).2⟩
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      have hev0_bij : ∀ n : ℕ, Function.Bijective (ev0 n) := by
        intro n
        constructor
        · intro f₁ f₂ hf
          funext p q hpq
          apply Subtype.ext
          cases q with
          | zero =>
            have hp_eq : p = n := by have := hpq.down; omega
            subst hp_eq
            exact congrArg Subtype.val hf
          | succ q' =>
            have h1 : (f₁ p (q' + 1) hpq).1 = 0 := by
              simpa [F_sub] using (f₁ p (q' + 1) hpq).2
            have h2 : (f₂ p (q' + 1) hpq).1 = 0 := by
              simpa [F_sub] using (f₂ p (q' + 1) hpq).2
            rw [h1, h2]
        · intro x
          have hx0 : x.1 ∈ F_sub 0 n 0 := by simp [F_sub, x.2]
          let x₀ : ↥(F_sub 0 n 0) := ⟨x.1, hx0⟩
          refine ⟨fun p q _ =>
            if hp : p = n then
              if hq : q = 0 then hp ▸ hq ▸ x₀ else 0
            else 0, ?_⟩
          apply Subtype.ext
          change (if hp : n = n then if hq : 0 = 0 then hp ▸ hq ▸ x₀ else 0 else 0).1 = x.1
          simp only [↓reduceDIte]
          rfl
      have hev0_comm : ∀ n f, ev0 (n + 1) (D_F 0 n f) = dV0 n (ev0 n f) := by
        intro n f
        apply Subtype.ext
        change (D_F 0 n f (n + 1) 0 ⟨Nat.add_zero (n + 1)⟩).1 = (dV0 n (ev0 n f)).1
        rw [hdV0 n (ev0 n f)]
        dsimp only [D_F]
        rw [subTotDiff_val]
        change d_h n 0 (f n 0 _).1 + 0 = d_h n 0 (f n 0 ⟨Nat.add_zero n⟩).1
        rw [add_zero]
      exact (cohomFin_iff_of_bijective (D_F 0) dV0 ev0 hev0_comm hev0_bij).symm

    
    have hTopKv : HasFinCohom (Tot (fun p q => ↥(F_sub K_v p q))) (D_F K_v) ↔
        HasFinCohom (Tot E) (totDiff E d_h d_v) := by
      have hAllMem : ∀ p q (y : E p q), y ∈ F_sub K_v p q := by
        intro p q y
        dsimp only [F_sub]
        split_ifs with hlt heq
        · trivial
        · subst q
          rw [LinearMap.mem_ker]
          haveI := hBound_v p (K_v + 1) (Nat.lt_succ_self K_v)
          exact Subsingleton.elim _ _
        · rw [Submodule.mem_bot]
          haveI := hBound_v p q (by omega)
          exact Subsingleton.elim _ _
      let valMap : ∀ n : ℕ, Tot (fun p q => ↥(F_sub K_v p q)) n →ₗ[R] Tot E n := fun n =>
        { toFun := fun f p q hpq => (f p q hpq).1
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      have hval_bij : ∀ n : ℕ, Function.Bijective (valMap n) := by
        intro n
        refine ⟨fun f₁ f₂ hf => funext fun p => funext fun q => funext fun hpq =>
          Subtype.ext (congrFun (congrFun (congrFun hf p) q) hpq),
          fun g => ⟨fun p q hpq => ⟨g p q hpq, hAllMem p q _⟩, rfl⟩⟩
      have hval_comm : ∀ n f,
          valMap (n + 1) (D_F K_v n f) = totDiff E d_h d_v n (valMap n f) := by
        intro n f
        funext p q hpq
        exact subTotDiff_val (F_sub K_v) (hF_dh K_v) (hF_dv K_v) n f p q hpq
      exact cohomFin_iff_of_bijective (D_F K_v) (totDiff E d_h d_v) valMap hval_comm hval_bij

    
    have hStep : ∀ k : ℕ,
        HasFinCohom (Tot (fun p q => ↥(F_sub k p q))) (D_F k) ↔
        HasFinCohom (Tot (fun p q => ↥(F_sub (k + 1) p q))) (D_F (k + 1)) := by
      intro k
      let M_sub : ∀ p q : ℕ, Submodule R (E p q) := fun p q =>
        match q with
        | 0 => ⊤
        | q' + 1 => if q' < k then ⊤ else if q' = k then LinearMap.range (d_v p q') else ⊥
      have hM_dh : ∀ p q x, x ∈ M_sub p q → d_h p q x ∈ M_sub (p + 1) q := by
        intro p q x hx
        cases q with
        | zero => trivial
        | succ q' =>
          dsimp only [M_sub] at hx ⊢
          split_ifs at hx ⊢ with hlt heq
          · trivial
          · subst heq
            rcases hx with ⟨y, rfl⟩
            exact ⟨d_h p q' y, (hd_hv p q' y).symm⟩
          · rw [Submodule.mem_bot] at hx ⊢
            rw [hx, map_zero]
      have hM_dv : ∀ p q x, x ∈ M_sub p q → d_v p q x ∈ M_sub p (q + 1) := by
        intro p q x hx
        dsimp only [M_sub]
        split_ifs with hlt heq
        · trivial
        · subst heq
          exact ⟨x, rfl⟩
        · rw [Submodule.mem_bot]
          cases q with
          | zero => omega
          | succ q₀ =>
            dsimp only [M_sub] at hx
            split_ifs at hx with hlt0 heq0
            · omega
            · subst heq0
              rcases hx with ⟨y, rfl⟩
              exact hd_v2 p q₀ y
            · rw [Submodule.mem_bot] at hx
              rw [hx, map_zero]
      let d_M : ∀ n : ℕ,
          Tot (fun p q => ↥(M_sub p q)) n →ₗ[R] Tot (fun p q => ↥(M_sub p q)) (n + 1) :=
        fun n => subTotDiff M_sub hM_dh hM_dv n
      have hFk_le_M : ∀ p q, F_sub k p q ≤ M_sub p q := by
        intro p q
        cases q with
        | zero => exact le_top
        | succ q' =>
          dsimp only [F_sub, M_sub]
          split_ifs with h1 h2 h3
          · exact le_top
          · omega
          · omega
          · exact le_top
          · omega
          · omega
          · exact le_top
          · exact bot_le
          · exact bot_le
      have hM_le_Fk1 : ∀ p q, M_sub p q ≤ F_sub (k + 1) p q := by
        intro p q
        cases q with
        | zero =>
          dsimp only [M_sub, F_sub]
          simp only [Nat.zero_lt_succ k, ↓reduceIte, le_top]
        | succ q' =>
          dsimp only [M_sub, F_sub]
          by_cases hlt : q' < k
          · have hlt1 : q' + 1 < k + 1 := by omega
            simp only [hlt, hlt1, ↓reduceIte, le_top]
          · by_cases heq : q' = k
            · subst q'
              have hlt1 : ¬(k + 1 < k + 1) := Nat.lt_irrefl _
              simp only [hlt, hlt1, ↓reduceIte]
              rintro _ ⟨y, rfl⟩
              exact LinearMap.mem_ker.mpr (hd_v2 p k y)
            · simp only [hlt, heq, ↓reduceIte, bot_le]

      
      let Hv_k : ℕ → Type u := fun p =>
        ↥(LinearMap.ker (d_v p (k + 1))) ⧸
          (LinearMap.range (d_v p k)).comap (LinearMap.ker (d_v p (k + 1))).subtype
      have hdVk_sq : ∀ p (z : Hv_k p), dVq k (p + 1) (dVq k p z) = 0 := by
        intro p z
        rcases Submodule.Quotient.mk_surjective _ z with ⟨x, rfl⟩
        obtain ⟨hx', eq1⟩ := hdVq k p x
        obtain ⟨hx'', eq2⟩ := hdVq k (p + 1) ⟨d_h p (k + 1) x.1, hx'⟩
        rw [eq1, eq2]
        have hzero : (⟨d_h (p + 1) (k + 1) (d_h p (k + 1) x.1), hx''⟩ :
            ↥(LinearMap.ker (d_v (p + 2) (k + 1)))) = 0 :=
          Subtype.ext (hd_h2 p (k + 1) x.1)
        rw [hzero, Submodule.Quotient.mk_zero]
      let Q_k : ℕ → Type u := ShiftSeq (k + 1) Hv_k
      let d_Q : ∀ n : ℕ, Q_k n →ₗ[R] Q_k (n + 1) := d_Shift (k + 1) Hv_k (dVq k)
      let ι_M : ∀ n : ℕ,
          Tot (fun p q => ↥(M_sub p q)) n →ₗ[R] Tot (fun p q => ↥(F_sub (k + 1) p q)) n :=
        inclTot hM_le_Fk1
      let π_Q : ∀ n : ℕ, Tot (fun p q => ↥(F_sub (k + 1) p q)) n →ₗ[R] Q_k n := fun n =>
        { toFun := fun f p hp =>
            Submodule.Quotient.mk ⟨(f p (k + 1) hp).1, by
              simpa [F_sub] using (f p (k + 1) hp).2⟩
          map_add' := fun f₁ f₂ => funext fun p => funext fun hp => rfl
          map_smul' := fun r f => funext fun p => funext fun hp => rfl }
      have π_Q_apply : ∀ n f p hp,
          π_Q n f p hp = Submodule.Quotient.mk ⟨(f p (k + 1) hp).1,
            by simpa [F_sub] using (f p (k + 1) hp).2⟩ := fun _ _ _ _ => rfl
      have hπQ_surj : ∀ n : ℕ, Function.Surjective (π_Q n) := by
        intro n g
        choose rep hrep using fun (p : ℕ) (hp : PLift (p + (k + 1) = n)) =>
          Submodule.Quotient.mk_surjective _ (g p hp)
        let repF : ∀ (p : ℕ) (hp : PLift (p + (k + 1) = n)), ↥(F_sub (k + 1) p (k + 1)) :=
          fun p hp => ⟨(rep p hp).1, by simp [F_sub, (rep p hp).2]⟩
        refine ⟨fun p q hpq =>
          if hq : q = k + 1 then
            hq ▸ repF p ⟨by have := hpq.down; omega⟩
          else 0, ?_⟩
        funext p hp
        rw [π_Q_apply]
        have h_eval : (if hq : k + 1 = k + 1 then hq ▸ repF p hp else 0) = repF p hp := by
          simp only [↓reduceDIte]
        have h_sub : (⟨((if hq : k + 1 = k + 1 then hq ▸ repF p hp else 0) :
              ↥(F_sub (k + 1) p (k + 1))).1,
            by simpa [F_sub] using
              ((if hq : k + 1 = k + 1 then hq ▸ repF p hp else 0) :
                ↥(F_sub (k + 1) p (k + 1))).2⟩ :
            ↥(LinearMap.ker (d_v p (k + 1)))) = rep p hp :=
          Subtype.ext (congrArg (Subtype.val : ↥(F_sub (k + 1) p (k + 1)) → E p (k + 1)) h_eval)
        rw [h_sub]
        exact hrep p hp
      have hEx_MQ : ∀ n : ℕ, Function.Exact ⇑(ι_M n) ⇑(π_Q n) := by
        intro n f
        constructor
        · intro h0
          have hmem : ∀ p q (hpq : PLift (p + q = n)), (f p q hpq).1 ∈ M_sub p q := by
            intro p q hpq
            cases q with
            | zero => trivial
            | succ q' =>
              dsimp only [M_sub]
              split_ifs with hlt heq
              · trivial
              · subst q'
                have h_at := congrFun (congrFun h0 p) hpq
                rw [π_Q_apply] at h_at
                change Submodule.Quotient.mk _ = (0 : Hv_k p) at h_at
                rw [Submodule.Quotient.mk_eq_zero] at h_at
                exact h_at
              · rw [Submodule.mem_bot]
                let x_val : E p (q' + 1) := (f p (q' + 1) hpq).1
                have hf2 : x_val ∈ F_sub (k + 1) p (q' + 1) := (f p (q' + 1) hpq).2
                have hbot : F_sub (k + 1) p (q' + 1) = ⊥ := by
                  dsimp only [F_sub]
                  have h1 : ¬(q' + 1 < k + 1) := by omega
                  have h2 : ¬(q' + 1 = k + 1) := by omega
                  simp only [h1, h2, ↓reduceIte]
                rw [hbot, Submodule.mem_bot] at hf2
                exact hf2
          exact ⟨fun p q hpq => ⟨(f p q hpq).1, hmem p q hpq⟩, rfl⟩
        · rintro ⟨g, rfl⟩
          funext p hp
          rw [π_Q_apply]
          change Submodule.Quotient.mk _ = (0 : Hv_k p)
          rw [Submodule.Quotient.mk_eq_zero]
          change (g p (k + 1) hp).1 ∈ LinearMap.range (d_v p k)
          have hg2 : (g p (k + 1) hp).1 ∈ M_sub p (k + 1) := (g p (k + 1) hp).2
          simpa [M_sub] using hg2
      have hπQ_comm : ∀ n f, π_Q (n + 1) (D_F (k + 1) n f) = d_Q n (π_Q n f) := by
        intro n f
        funext p hp
        have hval := subTotDiff_val (F_sub (k + 1)) (hF_dh (k + 1)) (hF_dv (k + 1))
          n f p (k + 1) hp
        let v_el : E p (k + 1) :=
          ((-1 : ℤ) ^ p) • d_v p k (f p k ⟨by have := hp.down; omega⟩).1
        have hv_ker : v_el ∈ LinearMap.ker (d_v p (k + 1)) := by
          rw [LinearMap.mem_ker]
          dsimp only [v_el]
          rw [map_zsmul, hd_v2 p k, smul_zero]
        have hv_zero_mk : (Submodule.Quotient.mk ⟨v_el, hv_ker⟩ : Hv_k p) = 0 := by
          rw [Submodule.Quotient.mk_eq_zero]
          refine ⟨((-1 : ℤ) ^ p) • (f p k ⟨by have := hp.down; omega⟩).1, ?_⟩
          change d_v p k (((-1 : ℤ) ^ p) • (f p k _).1) = v_el
          rw [map_zsmul]
        cases p with
        | zero =>
          have h0_eq : (⟨(D_F (k + 1) n f 0 (k + 1) hp).1,
              by simpa [F_sub] using (D_F (k + 1) n f 0 (k + 1) hp).2⟩ :
              ↥(LinearMap.ker (d_v 0 (k + 1)))) = ⟨v_el, hv_ker⟩ := by
            apply Subtype.ext
            dsimp only [D_F]
            rw [hval]
            exact zero_add v_el
          have hdQ0 : d_Q n (π_Q n f) 0 hp = 0 := rfl
          rw [π_Q_apply, hdQ0, h0_eq, hv_zero_mk]
        | succ p' =>
          let hp' : PLift (p' + (k + 1) = n) := ⟨by have := hp.down; omega⟩
          let x : ↥(LinearMap.ker (d_v p' (k + 1))) :=
            ⟨(f p' (k + 1) hp').1, by simpa [F_sub] using (f p' (k + 1) hp').2⟩
          obtain ⟨hx', heq_dVq⟩ := hdVq k p' x
          have hsum_eq : (⟨(D_F (k + 1) n f (p' + 1) (k + 1) hp).1,
              by simpa [F_sub] using (D_F (k + 1) n f (p' + 1) (k + 1) hp).2⟩ :
              ↥(LinearMap.ker (d_v (p' + 1) (k + 1)))) =
              ⟨d_h p' (k + 1) x.1, hx'⟩ + ⟨v_el, hv_ker⟩ := by
            apply Subtype.ext
            dsimp only [D_F]
            exact hval
          have hdQ_succ : d_Q n (π_Q n f) (p' + 1) hp = dVq k p' (Submodule.Quotient.mk x) := rfl
          rw [π_Q_apply, hdQ_succ, hsum_eq, Submodule.Quotient.mk_add, hv_zero_mk,
            add_zero, heq_dVq]
      have hM_iff_Fk1 : HasFinCohom (Tot (fun p q => ↥(M_sub p q))) d_M ↔
          HasFinCohom (Tot (fun p q => ↥(F_sub (k + 1) p q))) (D_F (k + 1)) :=
        hSES _ _ _ d_M (D_F (k + 1)) d_Q ι_M π_Q
          (subTotDiff_sq M_sub hM_dh hM_dv)
          (subTotDiff_sq (F_sub (k + 1)) (hF_dh (k + 1)) (hF_dv (k + 1)))
          (d_Shift_sq (k + 1) Hv_k (dVq k) hdVk_sq)
          (inclTot_inj hM_le_Fk1) hπQ_surj hEx_MQ
          (inclTot_comm hM_le_Fk1 hM_dh hM_dv (hF_dh (k + 1)) (hF_dv (k + 1)))
          hπQ_comm
          (shift_hasFinCohom (k + 1) Hv_k (dVq k) (hFin_dVq k))

      
      let j_k : ∀ n : ℕ,
          Tot (fun p q => ↥(F_sub k p q)) n →ₗ[R] Tot (fun p q => ↥(M_sub p q)) n :=
        inclTot hFk_le_M
      have hj_comm : ∀ n f, j_k (n + 1) (D_F k n f) = d_M n (j_k n f) :=
        inclTot_comm hFk_le_M (hF_dh k) (hF_dv k) hM_dh hM_dv
      have mem_range_jk : ∀ (n : ℕ) (g : Tot (fun p q => ↥(M_sub p q)) n),
          (∀ p (hp : PLift (p + k = n)), d_v p k (g p k hp).1 = 0) →
          (∀ p (hp : PLift (p + (k + 1) = n)), (g p (k + 1) hp).1 = 0) →
          ∃ f₀ : Tot (fun p q => ↥(F_sub k p q)) n, j_k n f₀ = g := by
        intro n g hk0 hk1
        have hmem : ∀ p q (hpq : PLift (p + q = n)), (g p q hpq).1 ∈ F_sub k p q := by
          intro p q hpq
          dsimp only [F_sub]
          split_ifs with hlt heq
          · trivial
          · subst heq
            rw [LinearMap.mem_ker]
            exact hk0 p hpq
          · rw [Submodule.mem_bot]
            by_cases hqk1 : q = k + 1
            · subst hqk1
              exact hk1 p hpq
            · cases q with
              | zero => omega
              | succ q' =>
                let x_val : E p (q' + 1) := (g p (q' + 1) hpq).1
                have hg2 : x_val ∈ M_sub p (q' + 1) := (g p (q' + 1) hpq).2
                have hbot : M_sub p (q' + 1) = ⊥ := by
                  dsimp only [M_sub]
                  have h1 : ¬(q' < k) := by omega
                  have h2 : ¬(q' = k) := by omega
                  simp only [h1, h2, ↓reduceIte]
                rw [hbot, Submodule.mem_bot] at hg2
                exact hg2
        exact ⟨fun p q hpq => ⟨(g p q hpq).1, hmem p q hpq⟩, rfl⟩

      have boundary_kill_le : ∀ (n : ℕ) (_ : n ≤ k)
          (g : Tot (fun p q => ↥(M_sub p q)) n),
          (∀ p (hp : PLift (p + (k + 1) = n + 1)), (d_M n g p (k + 1) hp).1 = 0) →
          ∃ f₀ : Tot (fun p q => ↥(F_sub k p q)) n, j_k n f₀ = g := by
        intro n hnk g hKill
        apply mem_range_jk n g
        · intro p hp
          have hp0 : p = 0 := by have := hp.down; omega
          have hnk_eq : n = k := by have := hp.down; omega
          subst hp0
          subst hnk_eq
          have h0 := hKill 0 ⟨by omega⟩
          dsimp only [d_M] at h0
          rw [subTotDiff_val] at h0
          change 0 + ((-1 : ℤ) ^ 0) • d_v 0 n (g 0 n hp).1 = 0 at h0
          simpa using h0
        · intro p hp
          exact False.elim (by have := hp.down; omega)

      have boundary_kill_succ : ∀ (m : ℕ)
          (g : Tot (fun p q => ↥(M_sub p q)) (m + 1)),
          (∀ p (hp : PLift (p + (k + 1) = m + 2)), (d_M (m + 1) g p (k + 1) hp).1 = 0) →
          ∃ (u : Tot (fun p q => ↥(M_sub p q)) m)
            (f₀ : Tot (fun p q => ↥(F_sub k p q)) (m + 1)),
            j_k (m + 1) f₀ = g - d_M m u := by
        intro m g hKill
        by_cases hmk : m + 1 ≤ k
        · obtain ⟨f₀, hf₀⟩ := boundary_kill_le (m + 1) hmk g hKill
          exact ⟨0, f₀, by rw [map_zero, sub_zero]; exact hf₀⟩
        · have hkm : k ≤ m := by omega
          let p₁ : ℕ := m - k
          let hp₁ : PLift (p₁ + (k + 1) = m + 1) := ⟨by omega⟩
          have hg_mem : (g p₁ (k + 1) hp₁).1 ∈ LinearMap.range (d_v p₁ k) := by
            have h2 := (g p₁ (k + 1) hp₁).2
            simpa [M_sub] using h2
          obtain ⟨y, hy⟩ := hg_mem
          have hMk_top : ∀ p : ℕ, M_sub p k = ⊤ := by
            intro p
            cases k with
            | zero => rfl
            | succ k' =>
              dsimp only [M_sub]
              simp only [Nat.lt_succ_self k', ↓reduceIte]
          let u : Tot (fun p q => ↥(M_sub p q)) m := fun p q _ =>
            if hp : p = p₁ then
              if hq : q = k then
                hp ▸ hq ▸ ⟨((-1 : ℤ) ^ p₁) • y, by rw [hMk_top]; trivial⟩
              else 0
            else 0
          let g' : Tot (fun p q => ↥(M_sub p q)) (m + 1) := g - d_M m u
          have hg'_k1 : ∀ p (hp : PLift (p + (k + 1) = m + 1)), (g' p (k + 1) hp).1 = 0 := by
            intro p hp
            have hp_eq : p = p₁ := by have := hp.down; omega
            subst hp_eq
            have hdMu : (d_M m u p₁ (k + 1) hp₁).1 = (g p₁ (k + 1) hp₁).1 := by
              dsimp only [d_M]
              rw [subTotDiff_val]
              have hH0_gen : ∀ (p₀ : ℕ) (hp₀ : PLift (p₀ + (k + 1) = m + 1)),
                  p₀ = p₁ →
                  totDiffH E d_h m (fun a b hab => (u a b hab).1) p₀ (k + 1) hp₀ = 0 := by
                intro p₀ hp₀ hp₀_eq
                cases p₀ with
                | zero => rfl
                | succ p' =>
                  let hp' : PLift (p' + (k + 1) = m) := ⟨by have := hp₀.down; omega⟩
                  have hu0 : u p' (k + 1) hp' = 0 := by
                    dsimp only [u]
                    have hne : ¬(p' = p₁) := by omega
                    simp only [hne, ↓reduceDIte]
                  change d_h p' (k + 1) (u p' (k + 1) hp').1 = 0
                  rw [hu0]
                  exact map_zero _
              have hH0 := hH0_gen p₁ hp₁ rfl
              have hu_pk : (u p₁ k ⟨by omega⟩).1 = ((-1 : ℤ) ^ p₁) • y := by
                dsimp only [u]
                simp only [↓reduceDIte]
              change totDiffH E d_h m (fun a b hab => (u a b hab).1) p₁ (k + 1) hp₁ +
                ((-1 : ℤ) ^ p₁) • d_v p₁ k (u p₁ k ⟨by omega⟩).1 = (g p₁ (k + 1) hp₁).1
              rw [hH0, zero_add, hu_pk, map_zsmul, smul_smul, ← mul_pow, hy]
              norm_num
            change (g p₁ (k + 1) hp₁).1 - (d_M m u p₁ (k + 1) hp₁).1 = 0
            rw [hdMu, sub_self]
          have hg'_k0 : ∀ p (hp : PLift (p + k = m + 1)), d_v p k (g' p k hp).1 = 0 := by
            intro p hp
            have hp_eq : p = p₁ + 1 := by have := hp.down; omega
            subst hp_eq
            have hd_eq : d_M (m + 1) g' = d_M (m + 1) g := by
              dsimp only [g']
              rw [map_sub, subTotDiff_sq M_sub hM_dh hM_dv m u, sub_zero]
            have h0 : (d_M (m + 1) g' (p₁ + 1) (k + 1) ⟨by omega⟩).1 = 0 := by
              rw [hd_eq]
              exact hKill (p₁ + 1) ⟨by omega⟩
            dsimp only [d_M] at h0
            rw [subTotDiff_val] at h0
            change d_h p₁ (k + 1) (g' p₁ (k + 1) hp₁).1 +
              ((-1 : ℤ) ^ (p₁ + 1)) • d_v (p₁ + 1) k (g' (p₁ + 1) k hp).1 = 0 at h0
            rw [hg'_k1 p₁ hp₁, map_zero, zero_add] at h0
            have hsmul := congrArg (fun z : E (p₁ + 1) (k + 1) => ((-1 : ℤ) ^ (p₁ + 1)) • z) h0
            simpa only [smul_smul, ← mul_pow, mul_neg, mul_one, neg_neg, one_pow,
              one_smul, smul_zero] using hsmul
          obtain ⟨f₀, hf₀⟩ := mem_range_jk (m + 1) g' hg'_k0 hg'_k1
          exact ⟨u, f₀, hf₀⟩

      have hj_cohom_bij : ∀ n : ℕ, Function.Bijective (mapCohom j_k hj_comm n) := by
        intro n
        constructor
        · intro u₁ u₂ hu
          rw [← sub_eq_zero]
          have h0 : mapCohom j_k hj_comm n (u₁ - u₂) = 0 := by rw [map_sub, hu, sub_self]
          rcases Submodule.Quotient.mk_surjective _ (u₁ - u₂) with ⟨f, hf_eq⟩
          rw [← hf_eq] at h0 ⊢
          dsimp only [mapCohom] at h0
          rw [Submodule.mapQ_apply, Submodule.Quotient.mk_eq_zero] at h0
          rw [Submodule.Quotient.mk_eq_zero]
          cases n with
          | zero =>
            change kerMap j_k hj_comm 0 f ∈ (⊥ : Submodule R _) at h0
            change f ∈ (⊥ : Submodule R _)
            rw [Submodule.mem_bot] at h0 ⊢
            apply Subtype.ext
            apply inclTot_inj hFk_le_M 0
            exact congrArg Subtype.val h0
          | succ m =>
            rcases h0 with ⟨g, hg⟩
            have hg_kill : ∀ p (hp : PLift (p + (k + 1) = m + 1)),
                (d_M m g p (k + 1) hp).1 = 0 := by
              intro p hp
              have h_eq : d_M m g = j_k (m + 1) f.1 := hg
              rw [h_eq]
              let x_val : E p (k + 1) := (f.1 p (k + 1) hp).1
              have hf2 : x_val ∈ F_sub k p (k + 1) := (f.1 p (k + 1) hp).2
              have hbot : F_sub k p (k + 1) = ⊥ := by
                dsimp only [F_sub]
                have h1 : ¬(k + 1 < k) := by omega
                have h2 : ¬(k + 1 = k) := by omega
                simp only [h1, h2, ↓reduceIte]
              rw [hbot, Submodule.mem_bot] at hf2
              exact hf2
            cases m with
            | zero =>
              obtain ⟨f₀, hf₀⟩ := boundary_kill_le 0 (Nat.zero_le k) g hg_kill
              refine ⟨f₀, inclTot_inj hFk_le_M 1 ?_⟩
              change j_k 1 (D_F k 0 f₀) = j_k 1 f.1
              rw [hj_comm 0 f₀, hf₀]
              exact hg
            | succ m' =>
              obtain ⟨u, f₀, hf₀⟩ := boundary_kill_succ m' g hg_kill
              refine ⟨f₀, inclTot_inj hFk_le_M (m' + 2) ?_⟩
              change j_k (m' + 2) (D_F k (m' + 1) f₀) = j_k (m' + 2) f.1
              rw [hj_comm (m' + 1) f₀, hf₀, map_sub,
                subTotDiff_sq M_sub hM_dh hM_dv m' u, sub_zero]
              exact hg
        · intro w
          rcases Submodule.Quotient.mk_surjective _ w with ⟨z, rfl⟩
          have hz_kill : ∀ p (hp : PLift (p + (k + 1) = n + 1)),
              (d_M n z.1 p (k + 1) hp).1 = 0 := by
            intro p hp
            rw [LinearMap.mem_ker.mp z.2]
            rfl
          cases n with
          | zero =>
            obtain ⟨f₀, hf₀⟩ := boundary_kill_le 0 (Nat.zero_le k) z.1 hz_kill
            have hf₀_ker : f₀ ∈ LinearMap.ker (D_F k 0) := by
              rw [LinearMap.mem_ker]
              apply inclTot_inj hFk_le_M 1
              rw [hj_comm 0 f₀, hf₀, LinearMap.mem_ker.mp z.2, map_zero]
            refine ⟨Submodule.Quotient.mk ⟨f₀, hf₀_ker⟩, ?_⟩
            dsimp only [mapCohom]
            rw [Submodule.mapQ_apply]
            congr 1
            exact Subtype.ext hf₀
          | succ m =>
            obtain ⟨u, f₀, hf₀⟩ := boundary_kill_succ m z.1 hz_kill
            have hf₀_ker : f₀ ∈ LinearMap.ker (D_F k (m + 1)) := by
              rw [LinearMap.mem_ker]
              apply inclTot_inj hFk_le_M (m + 2)
              rw [hj_comm (m + 1) f₀, hf₀, map_sub, LinearMap.mem_ker.mp z.2,
                subTotDiff_sq M_sub hM_dh hM_dv m u, sub_self, map_zero]
            refine ⟨Submodule.Quotient.mk ⟨f₀, hf₀_ker⟩, ?_⟩
            dsimp only [mapCohom]
            rw [Submodule.mapQ_apply, Submodule.Quotient.eq]
            refine ⟨-u, ?_⟩
            change d_M m (-u) = j_k (m + 1) f₀ - z.1
            rw [map_neg, hf₀]
            abel

      have hFk_iff_M : HasFinCohom (Tot (fun p q => ↥(F_sub k p q))) (D_F k) ↔
          HasFinCohom (Tot (fun p q => ↥(M_sub p q))) d_M := by
        rw [hasFinCohom_iff, hasFinCohom_iff]
        refine ⟨fun hL n => ?_, fun hR n => ?_⟩
        · haveI := hL n
          exact Module.Finite.equiv (LinearEquiv.ofBijective _ (hj_cohom_bij n))
        · haveI := hR n
          exact Module.Finite.equiv (LinearEquiv.ofBijective _ (hj_cohom_bij n)).symm
      exact hFk_iff_M.trans hM_iff_Fk1

    have hInd : ∀ k : ℕ,
        HasFinCohom (fun p => ↥(LinearMap.ker (d_v p 0))) dV0 ↔
        HasFinCohom (Tot (fun p q => ↥(F_sub k p q))) (D_F k) := by
      intro k
      induction k with
      | zero => exact hBase0
      | succ k ih => exact ih.trans (hStep k)
    exact (hInd K_v).trans hTopKv

  
  
  
