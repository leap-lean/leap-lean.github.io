    have hj2 : ∀ k : Fin (N₀ + 1), X_var k ^ 2 ∈ 𝒜₀ 2 := fun k => by
      simpa [pow_two] using SetLike.mul_mem_graded (hj k) (hj k)
    have hMapComp : ∀ {U₁ U₂ U₃ : P₀.Opens} (h₁₂ : U₂ ≤ U₁) (h₂₃ : U₃ ≤ U₂) (h₁₃ : U₃ ≤ U₁)
        (x : ↑(P₀.presheaf.obj (Opposite.op U₁))),
        (P₀.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom
          ((P₀.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom x) =
        (P₀.presheaf.map (CategoryTheory.homOfLE h₁₃).op).hom x := by
      intro U₁ U₂ U₃ h₁₂ h₂₃ h₁₃ x
      have hHom : (CategoryTheory.homOfLE h₁₂).op ≫ (CategoryTheory.homOfLE h₂₃).op =
