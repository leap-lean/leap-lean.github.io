            Submodule.Quotient.mk ⟨d_h_sw p (q + 1) x.1, hx'⟩ := by
      intro q p x
      have hx' : d_h_sw p (q + 1) x.1 ∈ LinearMap.ker (d_v_sw (p + 1) (q + 1)) := by
        rw [LinearMap.mem_ker]
