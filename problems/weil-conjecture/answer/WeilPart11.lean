            rw [hm_pow]
            exact nd.den.2
          have hne1 : eFS (ψ_poly (f_prod p α ^ m)) ((m : ℤ) • e_ind p α) ≠ 0 := by
            rw [map_pow, hψ_fprod p α, heMon_pow]
            change eFS (AddMonoidAlgebra.single ((m : ℤ) • e_ind p α) 1)
