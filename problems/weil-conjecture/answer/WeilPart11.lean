          (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜_L zero_lt_one (hXk_mem L j))
      have hj_mul := Ideal.mul_mem_left
        (Ideal.map g_ab (HomogeneousIdeal.irrelevant 𝒜_L).toIdeal) (u_top⁻¹).val hj_mem
      rwa [hg_φ_X j, Units.inv_mul_cancel_left] at hj_mul
    have h_post : AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜_L g_ab hg_ab ≫ Φ_L =
        W_ab.ι ≫ (w₁ ≫ j₁') := by
      have h1 : W_ab.ι ≫ (w₁ ≫ j₁') =
          w_ab ≫ AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜_h f₁_h hf₁_h := by
        dsimp only [j₁', j₁_h', w_ab]
        rw [← Category.assoc W_ab.ι w₁, ← AlgebraicGeometry.Scheme.Hom.resLE_comp_ι w₁ hw_ab,
          Category.assoc, ← Category.assoc U₁_a'.ι, hOpen_topIso C₁_h (M₁_h.V (eIdx₁ a)), hj1_a']
      rw [h1]
      apply (hFun (MvPolynomial (Fin (r₀ + 1)) B_h) 𝒜_h MvPolynomial.X (hXk_mem B_h) (hIrrel B_h)).2
        (MvPolynomial (Fin (r₀ + 1)) L) 𝒜_L Ψ_L hΨ_L W_ab.toScheme U₁_a'.toScheme w_ab
        f₁_h hf₁_h g_ab hg_ab
      apply MvPolynomial.ringHom_ext'
      · ext c
        change g_ab (MvPolynomial.map ψ_h (MvPolynomial.C c)) =
          w_ab.appTop.hom (f₁_h (MvPolynomial.C c))
        rw [MvPolynomial.map_C]
        exact hg_w_C c
      · intro j
        change g_ab (MvPolynomial.map ψ_h (MvPolynomial.X j)) =
          w_ab.appTop.hom (f₁_h (MvPolynomial.X j))
        rw [MvPolynomial.map_X]
        exact MvPolynomial.eval₂Hom_X' _ _ j
    have h_unit_eq : AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜_L g_ab hg_ab =
        W_ab.ι ≫ (φ_L.hom ≫ j₂_L') := by
      have h2 : W_ab.ι ≫ (φ_L.hom ≫ j₂_L') =
          φ_ab ≫ AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜_L f₂_L hf₂_L := by
        dsimp only [j₂_L', φ_ab]
        rw [← Category.assoc W_ab.ι φ_L.hom,
          ← AlgebraicGeometry.Scheme.Hom.resLE_comp_ι φ_L.hom inf_le_right,
          Category.assoc, ← Category.assoc V₂_b.ι, hOpen_topIso C₂_L (M₂_L.V b), hj2_b]
      rw [h2]
      apply (hFun (MvPolynomial (Fin (r₀ + 1)) L) 𝒜_L MvPolynomial.X (hXk_mem L) (hIrrel L)).1
        W_ab.toScheme V₂_b.toScheme φ_ab g_ab hg_ab f₂_L hf₂_L u_top
      exact hScale L _ g_ab (φ_ab.appTop.hom.comp f₂_L) u_top.val hg_φ_C hg_φ_X
    simp only [← h_post, h_unit_eq, Category.assoc]
  refine ⟨j₁', j₂', j₂_L', Φ_L, hCl₁, hCl₂, hCl₂_L,
    hOverHom C₁_h snd₁_h M₁_h e₁'_h (j₁_h ≫ α_M.hom) hj₁'_h_proj,
    hOverHom C₂_h snd₂_h M₂_h e₂_h j₂_h hj₂_h_proj, ?_, hComm₂, hComm₁⟩
  
  intro k
  change (TopologicalSpace.Opens.map (AlgebraicGeometry.Proj.map Ψ_L hΨ_L).base).obj
      (AlgebraicGeometry.Proj.basicOpen 𝒜_h (MvPolynomial.X k)) =
    AlgebraicGeometry.Proj.basicOpen 𝒜_L (MvPolynomial.X k)
  rw [AlgebraicGeometry.Proj.map_preimage_basicOpen Ψ_L hΨ_L (MvPolynomial.X k), hΨ_L_X k]

theorem weil_flat_closedImmersion_iso_of_generic_proj_eq (B_h L : Type u) [CommRing B_h] [CommRing L] (ψ_h : B_h →+* L)
    (hψ_inj : Function.Injective ψ_h)
    (r₀ : ℕ)
    (C₁_h C₂_h C₁_L C₂_L : AlgebraicGeometry.Scheme.{u})
    (snd₁_h : C₁_h ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_h))
    (snd₂_h : C₂_h ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_h))
    (snd₁_L : C₁_L ⟶ AlgebraicGeometry.Spec (CommRingCat.of L))
    (snd₂_L : C₂_L ⟶ AlgebraicGeometry.Spec (CommRingCat.of L))
    (hFlat₁ : AlgebraicGeometry.Flat snd₁_h)
    (hFlat₂ : AlgebraicGeometry.Flat snd₂_h)
    (w₁ : C₁_L ⟶ C₁_h)
    (hPb₁ : CategoryTheory.IsPullback w₁ snd₁_L snd₁_h
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_h)))
    (w₂ : C₂_L ⟶ C₂_h)
    (hPb₂ : CategoryTheory.IsPullback w₂ snd₂_L snd₂_h
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_h)))
    (φ_L : C₁_L ≅ C₂_L)
    (j₁' : C₁_h ⟶ (weilProjectiveSpaceOver B_h r₀).left)
    (hCl₁ : AlgebraicGeometry.IsClosedImmersion j₁')
    (j₂' : C₂_h ⟶ (weilProjectiveSpaceOver B_h r₀).left)
    (hCl₂ : AlgebraicGeometry.IsClosedImmersion j₂')
    (j₂_L' : C₂_L ⟶ (weilProjectiveSpaceOver L r₀).left)
    (hCl₂_L : AlgebraicGeometry.IsClosedImmersion j₂_L')
    (Φ_L : (weilProjectiveSpaceOver L r₀).left ⟶ (weilProjectiveSpaceOver B_h r₀).left)
    (hj₁_hom : j₁' ≫ (weilProjectiveSpaceOver B_h r₀).hom = snd₁_h)
    (hj₂_hom : j₂' ≫ (weilProjectiveSpaceOver B_h r₀).hom = snd₂_h)
    (hΦ_open : ∀ k : Fin (r₀ + 1),
      (TopologicalSpace.Opens.map Φ_L.base).obj (weilProjBasicOpen B_h r₀ k) =
        weilProjBasicOpen L r₀ k)
    (hComm₂ : w₂ ≫ j₂' = j₂_L' ≫ Φ_L)
    (hComm₁ : w₁ ≫ j₁' = (φ_L.hom ≫ j₂_L') ≫ Φ_L) :
    ∃ (φ_h : C₁_h ≅ C₂_h),
      φ_h.hom ≫ snd₂_h = snd₁_h ∧
      w₁ ≫ φ_h.hom = φ_L.hom ≫ w₂ :=
by
  have hIncludeRight_inj : ∀ (R : Type u) [CommRing R] (θ : B_h →+* R),
      θ.Flat →
      letI : Algebra B_h L := ψ_h.toAlgebra
      letI : Algebra B_h R := θ.toAlgebra
      Function.Injective
        (Algebra.TensorProduct.includeRight : R →ₐ[B_h] TensorProduct B_h L R) := by
    intro R _ θ hθ_flat
    let _ : Algebra B_h L := ψ_h.toAlgebra
    let _ : Algebra B_h R := θ.toAlgebra
    have hθ_eq : algebraMap B_h R = θ := rfl
    have _ : Module.Flat B_h R := by
      rw [← RingHom.flat_algebraMap_iff, hθ_eq]
      exact hθ_flat
    let f_ψ : B_h →ₗ[B_h] L := Algebra.linearMap B_h L
    have hf_ψ : Function.Injective f_ψ := hψ_inj
    have hrT_inj : Function.Injective (LinearMap.rTensor R f_ψ) :=
      Module.Flat.rTensor_preserves_injective_linearMap f_ψ hf_ψ
    let e_lid : R ≃ₗ[B_h] TensorProduct B_h B_h R := (TensorProduct.lid B_h R).symm
    have hf_ψ_one : f_ψ 1 = 1 := map_one ψ_h
    have h_comp : ∀ r : R,
        LinearMap.rTensor R f_ψ (e_lid r) =
          (Algebra.TensorProduct.includeRight : R →ₐ[B_h] TensorProduct B_h L R) r := by
      intro r
      change LinearMap.rTensor R f_ψ ((TensorProduct.lid B_h R).symm r) = _
      rw [TensorProduct.lid_symm_apply, LinearMap.rTensor_tmul, hf_ψ_one,
        Algebra.TensorProduct.includeRight_apply]
    intro r₁ r₂ hr
    apply e_lid.injective
    apply hrT_inj
    rw [h_comp, h_comp, hr]
  have hKer_eq_bot : ∀ {C_h C_L : AlgebraicGeometry.Scheme.{u}}
      (snd_h : C_h ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_h))
      [AlgebraicGeometry.Flat snd_h]
      (snd_L : C_L ⟶ AlgebraicGeometry.Spec (CommRingCat.of L))
      (w : C_L ⟶ C_h),
      CategoryTheory.IsPullback w snd_L snd_h
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_h)) →
      AlgebraicGeometry.Scheme.Hom.ker w = ⊥ := by
    intro C_h C_L snd_h _ snd_L w hPb
    let v_L : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B_h) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_h)
    have _ : AlgebraicGeometry.IsAffineHom w :=
      AlgebraicGeometry.isAffineHom_isStableUnderBaseChange.of_isPullback hPb.flip inferInstance
    have _ : AlgebraicGeometry.QuasiCompact w := inferInstance
    apply AlgebraicGeometry.Scheme.IdealSheafData.ext
    funext U
    rw [AlgebraicGeometry.Scheme.Hom.ker_apply,
      AlgebraicGeometry.Scheme.IdealSheafData.ideal_bot]
    refine (RingHom.injective_iff_ker_eq_bot (w.app U.1).hom).mp ?_
    let hU : AlgebraicGeometry.IsAffineOpen U.1 := U.2
    let V : C_L.Opens := (TopologicalSpace.Opens.map w.base).obj U.1
    have hV : AlgebraicGeometry.IsAffineOpen V := hU.preimage w
    have h_comm : AlgebraicGeometry.Spec.map (w.app U.1) ≫ hU.fromSpec =
        hV.fromSpec ≫ w := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
      exact hU.SpecMap_appLE_fromSpec w hV le_rfl
    have h_range : (TopologicalSpace.Opens.map w.base).obj hU.fromSpec.opensRange =
        hV.fromSpec.opensRange := by
      rw [hU.opensRange_fromSpec, hV.opensRange_fromSpec]
    have hPb_open : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (w.app U.1)) hV.fromSpec hU.fromSpec w :=
      AlgebraicGeometry.IsOpenImmersion.isPullback
        (AlgebraicGeometry.Spec.map (w.app U.1)) hV.fromSpec hU.fromSpec w
        h_comm.symm h_range
    have hPb_Spec : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (w.app U.1))
        (hV.fromSpec ≫ snd_L) (hU.fromSpec ≫ snd_h) v_L :=
      hPb_open.paste_vert hPb
    let R_cat : CommRingCat.{u} := C_h.presheaf.obj (Opposite.op U.1)
    let R : Type u := ↑R_cat
    let S_cat : CommRingCat.{u} := C_L.presheaf.obj (Opposite.op V)
    let f_R : CommRingCat.of B_h ⟶ R_cat :=
      AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ snd_h)
    let f_L : CommRingCat.of L ⟶ S_cat :=
      AlgebraicGeometry.Spec.preimage (hV.fromSpec ≫ snd_L)
    have hf_R : AlgebraicGeometry.Spec.map f_R = hU.fromSpec ≫ snd_h :=
      AlgebraicGeometry.Spec.map_preimage _
    have hf_L : AlgebraicGeometry.Spec.map f_L = hV.fromSpec ≫ snd_L :=
      AlgebraicGeometry.Spec.map_preimage _
    have hf_R_flat : f_R.hom.Flat := by
      have hFlatSpec : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map f_R) := by
        rw [hf_R]
        infer_instance
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Flat)).mp hFlatSpec
    let _ : Algebra B_h L := ψ_h.toAlgebra
    let _ : Algebra B_h R := f_R.hom.toAlgebra
    have hPb_aff : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map f_L)
        (AlgebraicGeometry.Spec.map (w.app U.1))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_h L)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_h R))) := by
      have hflip := hPb_Spec.flip
      rw [← hf_L, ← hf_R] at hflip
      exact hflip
    have hPb_std := CategoryTheory.IsPullback.of_hasPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_h L)))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_h R)))
    let e_pb := CategoryTheory.IsPullback.isoIsPullback _ _ hPb_aff hPb_std
    let e_tot := e_pb ≪≫ AlgebraicGeometry.pullbackSpecIso B_h L R
    have h_inv_snd : e_tot.inv ≫ AlgebraicGeometry.Spec.map (w.app U.1) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : R →ₐ[B_h] TensorProduct B_h L R).toRingHom) := by
      rw [CategoryTheory.Iso.trans_inv, CategoryTheory.Category.assoc,
        CategoryTheory.IsPullback.isoIsPullback_inv_snd,
        AlgebraicGeometry.pullbackSpecIso_inv_snd]
      rfl
    have h_pre : w.app U.1 ≫ AlgebraicGeometry.Spec.preimage e_tot.inv =
        CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : R →ₐ[B_h] TensorProduct B_h L R).toRingHom := by
      have h := congrArg AlgebraicGeometry.Spec.preimage h_inv_snd
      rwa [AlgebraicGeometry.Spec.preimage_comp,
        AlgebraicGeometry.Spec.preimage_map,
        AlgebraicGeometry.Spec.preimage_map] at h
    have hinj_inc : Function.Injective
        (Algebra.TensorProduct.includeRight : R →ₐ[B_h] TensorProduct B_h L R) :=
      hIncludeRight_inj R f_R.hom hf_R_flat
    intro x₁ x₂ hx
    apply hinj_inc
    have h_eval : ∀ x : R,
        (Algebra.TensorProduct.includeRight : R →ₐ[B_h] TensorProduct B_h L R) x =
          (AlgebraicGeometry.Spec.preimage e_tot.inv).hom ((w.app U.1).hom x) := by
      intro x
      exact (congrArg (fun g => g.hom x) h_pre).symm
    rw [h_eval, h_eval, hx]
  have _ : AlgebraicGeometry.Flat snd₁_h := hFlat₁
  have _ : AlgebraicGeometry.Flat snd₂_h := hFlat₂
  have hw₁ : AlgebraicGeometry.Scheme.Hom.ker w₁ = ⊥ := hKer_eq_bot snd₁_h snd₁_L w₁ hPb₁
  have hw₂ : AlgebraicGeometry.Scheme.Hom.ker w₂ = ⊥ := hKer_eq_bot snd₂_h snd₂_L w₂ hPb₂
  have h_ker : AlgebraicGeometry.Scheme.Hom.ker j₂' = AlgebraicGeometry.Scheme.Hom.ker j₁' := by
    calc AlgebraicGeometry.Scheme.Hom.ker j₂'
        = (⊥ : C₂_h.IdealSheafData).map j₂' :=
          (AlgebraicGeometry.Scheme.IdealSheafData.map_bot j₂').symm
      _ = (AlgebraicGeometry.Scheme.Hom.ker w₂).map j₂' := by rw [hw₂]
      _ = AlgebraicGeometry.Scheme.Hom.ker (w₂ ≫ j₂') :=
          (AlgebraicGeometry.Scheme.Hom.ker_comp w₂ j₂').symm
      _ = AlgebraicGeometry.Scheme.Hom.ker (j₂_L' ≫ Φ_L) := by rw [hComm₂]
      _ = (AlgebraicGeometry.Scheme.Hom.ker j₂_L').map Φ_L :=
          AlgebraicGeometry.Scheme.Hom.ker_comp j₂_L' Φ_L
      _ = ((⊥ : C₂_L.IdealSheafData).map j₂_L').map Φ_L := by
          rw [AlgebraicGeometry.Scheme.IdealSheafData.map_bot]
      _ = ((AlgebraicGeometry.Scheme.Hom.ker φ_L.hom).map j₂_L').map Φ_L := by
          rw [AlgebraicGeometry.Scheme.Hom.ker_eq_bot_of_isIso φ_L.hom]
      _ = (AlgebraicGeometry.Scheme.Hom.ker (φ_L.hom ≫ j₂_L')).map Φ_L := by
          rw [AlgebraicGeometry.Scheme.Hom.ker_comp]
      _ = AlgebraicGeometry.Scheme.Hom.ker ((φ_L.hom ≫ j₂_L') ≫ Φ_L) :=
          (AlgebraicGeometry.Scheme.Hom.ker_comp (φ_L.hom ≫ j₂_L') Φ_L).symm
      _ = AlgebraicGeometry.Scheme.Hom.ker (w₁ ≫ j₁') := by rw [← hComm₁]
      _ = (AlgebraicGeometry.Scheme.Hom.ker w₁).map j₁' :=
          AlgebraicGeometry.Scheme.Hom.ker_comp w₁ j₁'
      _ = (⊥ : C₁_h.IdealSheafData).map j₁' := by rw [hw₁]
      _ = AlgebraicGeometry.Scheme.Hom.ker j₁' :=
          AlgebraicGeometry.Scheme.IdealSheafData.map_bot j₁'
  have _ : AlgebraicGeometry.IsClosedImmersion j₁' := hCl₁
  have _ : AlgebraicGeometry.IsClosedImmersion j₂' := hCl₂
  let f_h : C₁_h ⟶ C₂_h := AlgebraicGeometry.IsClosedImmersion.lift j₂' j₁' (le_of_eq h_ker)
  have _ : CategoryTheory.IsIso f_h :=
    AlgebraicGeometry.IsClosedImmersion.isIso_lift j₂' j₁' h_ker
  let φ_h : C₁_h ≅ C₂_h := CategoryTheory.asIso f_h
  have hfac : φ_h.hom ≫ j₂' = j₁' :=
    AlgebraicGeometry.IsClosedImmersion.lift_fac j₂' j₁' (le_of_eq h_ker)
  refine ⟨φ_h, ?_, ?_⟩
  · calc φ_h.hom ≫ snd₂_h
        = φ_h.hom ≫ (j₂' ≫ (weilProjectiveSpaceOver B_h r₀).hom) := by rw [hj₂_hom]
      _ = (φ_h.hom ≫ j₂') ≫ (weilProjectiveSpaceOver B_h r₀).hom :=
          (CategoryTheory.Category.assoc _ _ _).symm
      _ = j₁' ≫ (weilProjectiveSpaceOver B_h r₀).hom := by rw [hfac]
      _ = snd₁_h := hj₁_hom
  · apply (cancel_mono j₂').mp
    calc (w₁ ≫ φ_h.hom) ≫ j₂'
        = w₁ ≫ (φ_h.hom ≫ j₂') := CategoryTheory.Category.assoc _ _ _
      _ = w₁ ≫ j₁' := by rw [hfac]
      _ = (φ_L.hom ≫ j₂_L') ≫ Φ_L := hComm₁
      _ = φ_L.hom ≫ (j₂_L' ≫ Φ_L) := CategoryTheory.Category.assoc _ _ _
      _ = φ_L.hom ≫ (w₂ ≫ j₂') := by rw [← hComm₂]
      _ = (φ_L.hom ≫ w₂) ≫ j₂' := (CategoryTheory.Category.assoc _ _ _).symm

theorem weil_pullback_pasting_section_ext_and_prime_lift (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [IsNoetherianRing B₀]
    (L : Type u) [Field L] [Algebra B₀ L] [IsFractionRing B₀ L]
    (n : ℕ) (C₁ C₂ : AlgebraicGeometry.Scheme.{u})
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀))
    (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ C₁))
    (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀))
    (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ C₂))
    (hSec₁ : ∀ j : Fin n, τ₁ j ≫ g₁ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of B₀)))
    (hSec₂ : ∀ j : Fin n, τ₂ j ≫ g₂ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of B₀)))
    (hProp₂ : AlgebraicGeometry.IsProper g₂)
    (φ_L : CategoryTheory.Limits.pullback g₁
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ L))) ≅
      CategoryTheory.Limits.pullback g₂
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ L))))
    (hφL_snd : φ_L.hom ≫
        CategoryTheory.Limits.pullback.snd g₂
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ L))) =
      CategoryTheory.Limits.pullback.snd g₁
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ L))))
    (hφL_sec : ∀ j : Fin n,
      ∀ s₁ : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶
          CategoryTheory.Limits.pullback g₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ L))),
        s₁ ≫ CategoryTheory.Limits.pullback.fst g₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ L))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ L)) ≫ τ₁ j →
        s₁ ≫ CategoryTheory.Limits.pullback.snd g₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ L))) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of L)) →
        (s₁ ≫ φ_L.hom) ≫ CategoryTheory.Limits.pullback.fst g₂
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ L))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ L)) ≫ τ₂ j)
    (q : PrimeSpectrum B₀) (h₀ : B₀) (hh₀ : h₀ ∉ q.asIdeal) :
    let η_L := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ L))
    let u_h := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap B₀ (Localization.Away h₀)))
    (∀ (ψ_h : Localization.Away h₀ →+* L),
      ψ_h.comp (algebraMap B₀ (Localization.Away h₀)) = algebraMap B₀ L →
      Function.Injective ψ_h ∧
      ∃ (w₁ : CategoryTheory.Limits.pullback g₁ η_L ⟶ CategoryTheory.Limits.pullback g₁ u_h)
        (w₂ : CategoryTheory.Limits.pullback g₂ η_L ⟶ CategoryTheory.Limits.pullback g₂ u_h),
        w₁ ≫ CategoryTheory.Limits.pullback.fst g₁ u_h =
          CategoryTheory.Limits.pullback.fst g₁ η_L ∧
        w₁ ≫ CategoryTheory.Limits.pullback.snd g₁ u_h =
          CategoryTheory.Limits.pullback.snd g₁ η_L ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_h) ∧
        CategoryTheory.IsPullback w₁ (CategoryTheory.Limits.pullback.snd g₁ η_L)
          (CategoryTheory.Limits.pullback.snd g₁ u_h)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_h)) ∧
        w₂ ≫ CategoryTheory.Limits.pullback.fst g₂ u_h =
          CategoryTheory.Limits.pullback.fst g₂ η_L ∧
        w₂ ≫ CategoryTheory.Limits.pullback.snd g₂ u_h =
          CategoryTheory.Limits.pullback.snd g₂ η_L ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_h) ∧
        CategoryTheory.IsPullback w₂ (CategoryTheory.Limits.pullback.snd g₂ η_L)
          (CategoryTheory.Limits.pullback.snd g₂ u_h)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_h)) ∧
        (∀ (φ_h : CategoryTheory.Limits.pullback g₁ u_h ≅
            CategoryTheory.Limits.pullback g₂ u_h),
          φ_h.hom ≫ CategoryTheory.Limits.pullback.snd g₂ u_h =
            CategoryTheory.Limits.pullback.snd g₁ u_h →
