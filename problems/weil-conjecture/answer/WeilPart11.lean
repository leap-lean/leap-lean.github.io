        (∀ r ∈ S, InGlobalDiv (F_fam r)) →
        InGlobalDiv (∑ r ∈ S, F_fam r) ∧
          diff_fn (∑ r ∈ S, F_fam r) = ∑ r ∈ S, diff_fn (F_fam r) := by
      intro S F_fam
      induction S using Finset.induction_on with
      | empty =>
        intro _
        simp only [Finset.sum_empty]
        exact ⟨hGlobZero, hDiff_zero⟩
      | @insert r₀ S hr₀ ih =>
        intro h_mem
        obtain ⟨hS_gl, hS_eq⟩ := ih (fun r hr => h_mem r (Finset.mem_insert_of_mem hr))
        have hr₀_gl := h_mem r₀ (Finset.mem_insert_self r₀ S)
        rw [Finset.sum_insert hr₀, Finset.sum_insert hr₀]
        exact ⟨hGlobAdd _ _ hr₀_gl hS_gl,
          (hDiff_add_fn _ _ hr₀_gl hS_gl).trans (by rw [hS_eq])⟩
    have hDiff_surj_fn : ∀ w : Fin δ → Ω, ∃ f, InGlobalDiv f ∧ diff_fn f = w := by
      intro w
      let F_fam : Fin δ → ∀ β : Fin (c + 1), F β :=
        fun r β => algebraMap Ω (F β) (w r) * g₀ r β
      have hF_gl : ∀ r ∈ (Finset.univ : Finset (Fin δ)), InGlobalDiv (F_fam r) :=
        fun r _ => hGlobSmul (w r) (g₀ r) (hg₀_gl r)
      obtain ⟨h_sum_gl, h_sum_eq⟩ := hDiff_sum Finset.univ F_fam hF_gl
      refine ⟨∑ r : Fin δ, F_fam r, h_sum_gl, ?_⟩
      funext r'
      rw [h_sum_eq, Finset.sum_apply]
      have h_single : ∀ r : Fin δ, diff_fn (F_fam r) r' = if r' = r then w r else 0 := by
        intro r
        have h_sm := congrFun (hDiff_smul_fn (w r) (g₀ r) (hg₀_gl r)) r'
        simp only [Pi.smul_apply, smul_eq_mul] at h_sm
        rw [h_sm, hDiff_g₀ r r']
        split_ifs <;> ring
      simp_rw [h_single]
      rw [Finset.sum_eq_single r' (fun r _ hr => if_neg (Ne.symm hr))
        (fun h_abs => False.elim (h_abs (Finset.mem_univ r'))), if_pos rfl]
    
    have hNodeIdealMem : ∀ (s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))))
        (hs_sec : IsWeilTricanonicalSection M ⊤ s)
        (r : Fin δ) (a : Fin M.m)
        (p_z : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a)))),
        (hAff a).fromSpec.base p_z = z_node r →
        (toVa s a ∈ p_z.asIdeal ↔
          ev_pt (α₀ r) (P₀ r) (hNodeData r).2.1 (a_node r)
            (by change (ν (α₀ r)).base (P₀ r) ∈ M.V (a_node r)
                rw [(hNodeData r).2.2.2.1]; exact ha_node r)
            (chartLift (α₀ r) (a_node r) (secFunc s (α₀ r))) = 0) := by
      intro s hs_sec r a p_z hp_z
      have hz_in_range : z_node r ∈ Set.range (hAff a).fromSpec.base := ⟨p_z, hp_z⟩
      have hz_a : z_node r ∈ M.V a := by rwa [(hAff a).range_fromSpec] at hz_in_range
      have h_ker := (hPtC (z_node r) (hNodeData r).1).2.2 a p_z
        (hPtInC _ _ _ hz_a) hp_z
      rw [← h_ker, RingHom.mem_ker]
      have h_pull := hEvPullC (α₀ r) (P₀ r) (hNodeData r).2.1 (z_node r) (hNodeData r).1
        (hNodeData r).2.2.2.1 (M.V a) hz_a
        (hPtInE _ _ _ _ (by change (ν (α₀ r)).base (P₀ r) ∈ M.V a; rw [(hNodeData r).2.2.2.1]; exact hz_a))
        (toVa s a)
      rw [← h_pull, hCL_sec s hs_sec (α₀ r) a]
      have h_cov := hEvCLCoc (α₀ r) (P₀ r) (hNodeData r).2.1 r (hNodeData r).2.2.2.1
        a (a_node r) hz_a (ha_node r) (secFunc s (α₀ r)) (hSec_pole s hs_sec (α₀ r))
      change ev_pt (α₀ r) (P₀ r) (hNodeData r).2.1 a
        (by change (ν (α₀ r)).base (P₀ r) ∈ M.V a; rw [(hNodeData r).2.2.2.1]; exact hz_a) _ = 0 ↔ _
      rw [h_cov, mul_eq_zero]
      exact ⟨fun h => h.resolve_left (hUEvNe r a (a_node r) ⟨hz_a, ha_node r⟩),
        fun h => Or.inr h⟩
    
    have hBr3_fn : ∀ r : Fin δ,
        ∃ s_r : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))),
          IsWeilTricanonicalSection M ⊤ s_r ∧
          (∀ (a : Fin M.m) (p_x : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a)))),
            (hAff a).fromSpec.base p_x = z_node r →
            toVa s_r a ∉ p_x.asIdeal) ∧
          (∀ r' : Fin δ, r' ≠ r →
            ∀ (a : Fin M.m) (p_y : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a)))),
              (hAff a).fromSpec.base p_y = z_node r' →
              toVa s_r a ∈ p_y.asIdeal) := by
      intro r
      let f_ind := g₀ r + g₁ r
      have hf_ind_gl : InGlobalDiv f_ind := hGlobAdd _ _ (hg₀_gl r) (hg₁_gl r)
      have hf_ind_ker : diff_fn f_ind = 0 := by
        rw [hDiff_add_fn _ _ (hg₀_gl r) (hg₁_gl r)]
        funext r'
        simp only [Pi.add_apply, Pi.zero_apply, hDiff_g₀ r r', hDiff_g₁ r r']
        split_ifs <;> ring
      obtain ⟨s_r, hs_r_sec, hs_r_func⟩ := (hDiff_ker_fn f_ind hf_ind_gl).mp hf_ind_ker
      refine ⟨s_r, hs_r_sec, ?_, ?_⟩
      · intro a p_x hp_x
        rw [hNodeIdealMem s_r hs_r_sec r a p_x hp_x, hs_r_func (α₀ r)]
        dsimp only [f_ind, Pi.add_apply]
        rw [hCL_add _ _ _ _ (fun P _ hP => hg₀_gl r _ P hP) (fun P _ hP => hg₁_gl r _ P hP),
          map_add, hg₀_br0_self r, hg₁_br0_self r, add_zero]
        exact one_ne_zero
      · intro r' hne a p_y hp_y
        rw [hNodeIdealMem s_r hs_r_sec r' a p_y hp_y, hs_r_func (α₀ r')]
        dsimp only [f_ind, Pi.add_apply]
        rw [hCL_add _ _ _ _ (fun P _ hP => hg₀_gl r _ P hP) (fun P _ hP => hg₁_gl r _ P hP),
          map_add, (hg₀_other r r' hne).1, (hg₁_other r r' hne).1, add_zero]
    
    have hBr4_fn : ∀ (α : Fin (c + 1)) (f_α : F α),
        (∀ P : E_norm α, IsClosed ({P} : Set (E_norm α)) →
          (-(Δ_div α P - B_div α P) : WithTop ℤ) ≤ ord α P f_α) →
        ∃ s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))),
          IsWeilTricanonicalSection M ⊤ s ∧
          secFunc s α = f_α ∧
          (∀ β : Fin (c + 1), β ≠ α → secFunc s β = 0) ∧
          (∀ (r : Fin δ) (a : Fin M.m)
              (p_z : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op (M.V a)))),
            (hAff a).fromSpec.base p_z = z_node r →
            toVa s a ∈ p_z.asIdeal) := by
      intro α f_α hf_α
      have hf_α_Delta : ∀ P : E_norm α, IsClosed ({P} : Set (E_norm α)) →
          (-(Δ_div α P) : WithTop ℤ) ≤ ord α P f_α := by
        intro P hP_cl
        have h_le : -(Δ_div α P) ≤ -(Δ_div α P - B_div α P) := by
          have := hB_nonneg α P; omega
        exact le_trans (by rw [hCoeSub, hCoeNeg, hCoeNeg]
                           exact WithTop.coe_le_coe.mpr h_le) (hf_α P hP_cl)
      let f_tup : ∀ β : Fin (c + 1), F β := fun β => if h : α = β then h ▸ f_α else 0
      have hf_tup_gl : InGlobalDiv f_tup := by
        intro β P hP_cl
        dsimp only [f_tup]
        by_cases h : α = β
        · subst h; simp only [↓reduceDIte]; exact hf_α_Delta P hP_cl
        · simp only [dif_neg h]; exact (mkDivSub β (Δ_div β)).zero_mem P hP_cl
      have hf_tup_ev0 : ∀ (β : Fin (c + 1)) (Q : E_norm β) (hQ_cl : IsClosed ({Q} : Set (E_norm β))),
          B_div β Q = 1 →
          ∀ (a : Fin M.m) (hQ_mem : Q ∈ (TopologicalSpace.Opens.map (ν β).base).obj (M.V a)),
            ev_pt β Q hQ_cl a hQ_mem (chartLift β a (f_tup β)) = 0 := by
        intro β Q hQ_cl hQ_B a hQ_mem
        dsimp only [f_tup]
        by_cases h : α = β
        · subst h
          simp only [↓reduceDIte]
          apply (hCL_vanish α a Q hQ_mem hQ_cl (hPtInE α Q hQ_cl _ hQ_mem) f_α
            (fun P _ hP => hf_α_Delta P hP)).mpr
          have h1 := hf_α Q hQ_cl
          have h_eq : -(Δ_div α Q - B_div α Q) = -(Δ_div α Q) + 1 := by rw [hQ_B]; omega
          rwa [hCoeSub, hCoeNeg, h_eq] at h1
        · simp only [dif_neg h, hCL_zero, map_zero]
      have hf_tup_ker : diff_fn f_tup = 0 := by
        funext r
        dsimp only [diff_fn, Pi.zero_apply]
        rw [hf_tup_ev0 (α₀ r) (P₀ r) (hNodeData r).2.1 (hB_br0 r) (a_node r) (hP0_in_node r),
          hf_tup_ev0 (α₁ r) (P₁ r) (hNodeData r).2.2.1 (hB_br1 r) (a_node r) (hP1_in_node r),
          sub_zero]
      obtain ⟨s, hs_sec, hs_func⟩ := (hDiff_ker_fn f_tup hf_tup_gl).mp hf_tup_ker
      refine ⟨s, hs_sec, ?_, ?_, ?_⟩
      · rw [hs_func α]; exact dif_pos rfl
      · intro β hβ; rw [hs_func β]; exact dif_neg (Ne.symm hβ)
      · intro r a p_z hp_z
        rw [hNodeIdealMem s hs_sec r a p_z hp_z, hs_func (α₀ r)]
        exact hf_tup_ev0 (α₀ r) (P₀ r) (hNodeData r).2.1 (hB_br0 r) (a_node r) (hP0_in_node r)
    
    have hBr5_fn : ∀ (α : Fin (c + 1)) (f_α : F α),
        (∀ P : E_norm α, IsClosed ({P} : Set (E_norm α)) →
          (-(Δ_div α P - B_self_div α P) : WithTop ℤ) ≤ ord α P f_α) →
        ∃ s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))),
          IsWeilTricanonicalSection M ⊤ s ∧
          secFunc s α = f_α := by
      intro α f_α hf_α
      have hBs_nonneg : ∀ P : E_norm α, 0 ≤ B_self_div α P := by
        intro P; rcases (hStabSys.1 α P).2.1 with ⟨h1, _⟩ | ⟨h0, _⟩ <;> omega
      have hf_α_Delta : ∀ P : E_norm α, IsClosed ({P} : Set (E_norm α)) →
          (-(Δ_div α P) : WithTop ℤ) ≤ ord α P f_α := by
        intro P hP_cl
        have h_le : -(Δ_div α P) ≤ -(Δ_div α P - B_self_div α P) := by
          have := hBs_nonneg P; omega
        exact le_trans (by rw [hCoeSub, hCoeNeg, hCoeNeg]
                           exact WithTop.coe_le_coe.mpr h_le) (hf_α P hP_cl)
      let f0 : ∀ β : Fin (c + 1), F β := fun β => if h : α = β then h ▸ f_α else 0
      have hf0_gl : InGlobalDiv f0 := by
        intro β P hP_cl
        dsimp only [f0]
        by_cases h : α = β
        · subst h; simp only [↓reduceDIte]; exact hf_α_Delta P hP_cl
        · simp only [dif_neg h]; exact (mkDivSub β (Δ_div β)).zero_mem P hP_cl
      let corr : Fin δ → ∀ β : Fin (c + 1), F β :=
        fun r =>
          if α₀ r = α ∧ α₁ r ≠ α then
            fun β => algebraMap Ω (F β) (diff_fn f0 r) * g₁ r β
          else if α₀ r ≠ α ∧ α₁ r = α then
            fun β => algebraMap Ω (F β) (-diff_fn f0 r) * g₀ r β
          else 0
      have hcorr_gl : ∀ r ∈ (Finset.univ : Finset (Fin δ)), InGlobalDiv (corr r) := by
        intro r _
        dsimp only [corr]
        split_ifs
        · exact hGlobSmul (diff_fn f0 r) (g₁ r) (hg₁_gl r)
        · exact hGlobSmul (-diff_fn f0 r) (g₀ r) (hg₀_gl r)
        · exact hGlobZero
      obtain ⟨h_sum_gl, h_sum_diff⟩ := hDiff_sum Finset.univ corr hcorr_gl
      let f_ext := f0 + ∑ r : Fin δ, corr r
      have hf_ext_gl : InGlobalDiv f_ext := hGlobAdd _ _ hf0_gl h_sum_gl
      have hcorr_at_α : ∀ r : Fin δ, corr r α = 0 := by
        intro r
        dsimp only [corr]
        split_ifs with h1 h2
        · dsimp only [g₁]; rw [dif_neg h1.2, mul_zero]
        · dsimp only [g₀]; rw [dif_neg h2.1, mul_zero]
        · rfl
      have hf_ext_ker : diff_fn f_ext = 0 := by
        rw [hDiff_add_fn _ _ hf0_gl h_sum_gl, h_sum_diff]
        funext r₀
        simp only [Pi.add_apply, Pi.zero_apply, Finset.sum_apply]
        have h_other_zero : ∀ r : Fin δ, r ≠ r₀ → diff_fn (corr r) r₀ = 0 := by
          intro r hne
          dsimp only [corr]
          split_ifs
          · have h_sm := congrFun (hDiff_smul_fn (diff_fn f0 r) (g₁ r) (hg₁_gl r)) r₀
            simp only [Pi.smul_apply, smul_eq_mul] at h_sm
            rw [h_sm, hDiff_g₁ r r₀, if_neg (Ne.symm hne), mul_zero]
          · have h_sm := congrFun (hDiff_smul_fn (-diff_fn f0 r) (g₀ r) (hg₀_gl r)) r₀
            simp only [Pi.smul_apply, smul_eq_mul] at h_sm
            rw [h_sm, hDiff_g₀ r r₀, if_neg (Ne.symm hne), mul_zero]
          · rw [hDiff_zero]; rfl
        rw [Finset.sum_eq_single r₀ (fun r _ hr => h_other_zero r hr)
          (fun h_abs => False.elim (h_abs (Finset.mem_univ r₀)))]
        dsimp only [corr]
        split_ifs with h1 h2
        · have h_sm := congrFun (hDiff_smul_fn (diff_fn f0 r₀) (g₁ r₀) (hg₁_gl r₀)) r₀
          simp only [Pi.smul_apply, smul_eq_mul] at h_sm
          rw [h_sm, hDiff_g₁ r₀ r₀, if_pos rfl]; ring
        · have h_sm := congrFun (hDiff_smul_fn (-diff_fn f0 r₀) (g₀ r₀) (hg₀_gl r₀)) r₀
          simp only [Pi.smul_apply, smul_eq_mul] at h_sm
          rw [h_sm, hDiff_g₀ r₀ r₀, if_pos rfl]; ring
        · rw [hDiff_zero, Pi.zero_apply, add_zero]
          by_cases h0_eq : α₀ r₀ = α
          · have h1_eq : α₁ r₀ = α := by_contra fun h1_ne => h1 ⟨h0_eq, h1_ne⟩
            have hSelfZero : ∀ (β : Fin (c + 1)) (hβ : β = α)
                (Q : E_norm β) (hQ_cl : IsClosed ({Q} : Set (E_norm β)))
                (hQ_z : (ν β).base Q = z_node r₀)
                (hQ_mem : Q ∈ (TopologicalSpace.Opens.map (ν β).base).obj (M.V (a_node r₀))),
                ev_pt β Q hQ_cl (a_node r₀) hQ_mem (chartLift β (a_node r₀) (f0 β)) = 0 := by
              rintro β rfl Q hQ_cl hQ_z hQ_mem
              have hBs1 : B_self_div β Q = 1 := by
                rcases (hStabSys.1 β Q).2.1 with ⟨hb1, _⟩ | ⟨_, hnot⟩
                · exact hb1
                · exact False.elim (hnot ⟨r₀, h0_eq, h1_eq, hQ_z⟩)
              have h_f0_eq : f0 β = f_α := dif_pos rfl
              rw [h_f0_eq]
              apply (hCL_vanish β (a_node r₀) Q hQ_mem hQ_cl (hPtInE β Q hQ_cl _ hQ_mem) f_α
                (fun P _ hP => hf_α_Delta P hP)).mpr
              have h_ord := hf_α Q hQ_cl
              have h_eq : -(Δ_div β Q - B_self_div β Q) = -(Δ_div β Q) + 1 := by rw [hBs1]; omega
              rwa [hCoeSub, hCoeNeg, h_eq] at h_ord
            dsimp only [diff_fn]
            rw [hSelfZero (α₀ r₀) h0_eq (P₀ r₀) (hNodeData r₀).2.1 (hNodeData r₀).2.2.2.1
                (hP0_in_node r₀),
              hSelfZero (α₁ r₀) h1_eq (P₁ r₀) (hNodeData r₀).2.2.1 (hNodeData r₀).2.2.2.2.1
                (hP1_in_node r₀),
              sub_zero]
          · have h1_ne : α₁ r₀ ≠ α := fun h1_eq => h2 ⟨h0_eq, h1_eq⟩
            dsimp only [diff_fn]
            have hf0_0 : f0 (α₀ r₀) = 0 := dif_neg (Ne.symm h0_eq)
            have hf0_1 : f0 (α₁ r₀) = 0 := dif_neg (Ne.symm h1_ne)
            rw [hf0_0, hf0_1, hCL_zero, hCL_zero, map_zero, map_zero, sub_zero]
      obtain ⟨s, hs_sec, hs_func⟩ := (hDiff_ker_fn f_ext hf_ext_gl).mp hf_ext_ker
      refine ⟨s, hs_sec, ?_⟩
      rw [hs_func α]
      change f0 α + (∑ r : Fin δ, corr r) α = f_α
      rw [Finset.sum_apply, Finset.sum_eq_zero (fun r _ => hcorr_at_α r), add_zero]
      exact dif_pos rfl
    
    have hCovPinch_fn : ∀ (c_coc : ∀ p : Fin M.m × Fin M.m,
          ↑(C.presheaf.obj (Opposite.op (M.V p.1 ⊓ M.V p.2))))
        (t_tilde : ∀ (α : Fin (c + 1)) (a : Fin M.m),
          ↑((E_norm α).presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a))))),
        (∀ (α : Fin (c + 1)) (a b : Fin M.m),
          ((E_norm α).presheaf.map
            (CategoryTheory.homOfLE
              ((TopologicalSpace.Opens.map (ν α).base).monotone
                (inf_le_left : M.V a ⊓ M.V b ≤ M.V a))).op).hom
            (t_tilde α a) -
          (((ν α).app (M.V a ⊓ M.V b)).hom (M.u a b).val) ^ 3 *
            ((E_norm α).presheaf.map
              (CategoryTheory.homOfLE
                ((TopologicalSpace.Opens.map (ν α).base).monotone
                  (inf_le_right : M.V a ⊓ M.V b ≤ M.V b))).op).hom
              (t_tilde α b) =
          ((ν α).app (M.V a ⊓ M.V b)).hom (c_coc (a, b))) →
        ∃ (g_tup : ∀ α : Fin (c + 1), F α)
          (s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (M.V a)))),
          InGlobalDiv g_tup ∧
          ∀ (a : Fin M.m) (α : Fin (c + 1)),
            ((ν α).app (M.V a)).hom (s a) = t_tilde α a - chartLift α a (g_tup α) := by
      intro c_coc t_tilde ht_coc
      let w_ref : Fin δ → Ω := fun r =>
        ev_pt (α₀ r) (P₀ r) (hNodeData r).2.1 (a_node r)
          (by change (ν (α₀ r)).base (P₀ r) ∈ M.V (a_node r)
              rw [(hNodeData r).2.2.2.1]; exact ha_node r)
          (t_tilde (α₀ r) (a_node r)) -
        ev_pt (α₁ r) (P₁ r) (hNodeData r).2.2.1 (a_node r)
          (by change (ν (α₁ r)).base (P₁ r) ∈ M.V (a_node r)
              rw [(hNodeData r).2.2.2.2.1]; exact ha_node r)
          (t_tilde (α₁ r) (a_node r))
      obtain ⟨g_tup, hg_gl, hg_diff⟩ := hDiff_surj_fn w_ref
      have hPinchChart : ∀ a : Fin M.m,
          ∃ s_a : ↑(C.presheaf.obj (Opposite.op (M.V a))),
            ∀ α : Fin (c + 1),
              ((ν α).app (M.V a)).hom s_a = t_tilde α a - chartLift α a (g_tup α) := by
        intro a
        apply hPinch a (fun α => t_tilde α a - chartLift α a (g_tup α))
        intro r hz_a hP₀' hP₁' h_in₀ h_in₁
        have hBrRel : ∀ (α : Fin (c + 1)) (P : E_norm α) (hP : IsClosed ({P} : Set (E_norm α)))
            (hPr : (ν α).base P = z_node r),
            ev_pt α P hP a (by change (ν α).base P ∈ M.V a; rw [hPr]; exact hz_a) (t_tilde α a) -
              (u_ev r a (a_node r) ⟨hz_a, ha_node r⟩) ^ 3 *
                ev_pt α P hP (a_node r)
                  (by change (ν α).base P ∈ M.V (a_node r); rw [hPr]; exact ha_node r)
                  (t_tilde α (a_node r)) =
            weilPointEvalRingHom (pt_C (z_node r) (hNodeData r).1)
              (M.V a ⊓ M.V (a_node r)) (hPtInC _ _ _ ⟨hz_a, ha_node r⟩)
              (c_coc (a, a_node r)) := by
          intro α P hP hPr
          have hP_ab : P ∈ (TopologicalSpace.Opens.map (ν α).base).obj
              (M.V a ⊓ M.V (a_node r)) := by
            change (ν α).base P ∈ M.V a ⊓ M.V (a_node r); rw [hPr]; exact ⟨hz_a, ha_node r⟩
          have h_in_ab := hPtInE α P hP _ hP_ab
          have h_ap := congrArg
            (weilPointEvalRingHom (pt_E α P hP) _ h_in_ab)
            (ht_coc α a (a_node r))
