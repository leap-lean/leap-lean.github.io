          rw [hp1]; exact hp.1
        · have hcomm2 : w₁ ≫ φ'.hom ≫ fst₂' = φ_L.hom ≫ fst₂_L := by
            rw [← CategoryTheory.Category.assoc, hw_φ, CategoryTheory.Category.assoc, hw₂_fst]
          have hp2 : (w₁ ≫ φ'.hom ≫ fst₂').base p = (φ_L.hom ≫ fst₂_L).base p :=
            congrArg (fun k => k.base p) hcomm2
          change (w₁ ≫ φ'.hom ≫ fst₂').base p ∈ M₂.V (eIdx₂_L b)
          rw [hp2]; exact hp.2
      have hb_raw := hCocBase R' L ρ' ρ_L ψ hψ φ' φ_L w₁ w₂
        hφ'_snd hφ'_sec hφL_snd hφL_sec hw₁_fst hw₁_snd hw₂_fst hw₂_snd hw_φ
        (eIdx₁_L a) (eIdx₂_L b) h_w_O
      have hb_cube := congrArg
        (fun z => ((C₁_L.presheaf.map (CategoryTheory.homOfLE (h_le_uL a b)).op).hom z) ^ 3)
        hb_raw
      dsimp only [u_L]
      rw [Units.val_pow_eq_pow_val, map_pow, map_pow]
      change ((C₁_L.presheaf.map (CategoryTheory.homOfLE (h_le_uL a b)).op).hom
          (α_coc L ρ_L φ_L (eIdx₁_L a) (eIdx₂_L b)).val) ^ 3 =
        ((C₁_L.presheaf.map (CategoryTheory.homOfLE h_w).op).hom
          ((w₁.app _).hom ((C₁'.presheaf.map (CategoryTheory.homOfLE h_le').op).hom
            (α_coc R' ρ' φ' (eIdx₁_L a) (eIdx₂_L b)).val))) ^ 3
      rw [res_app_res w₁ h_le' h_w (le_trans (h_le_uL a b) h_w_O),
        ← res_res C₁_L (h_le_uL a b) h_w_O (le_trans (h_le_uL a b) h_w_O)]
      exact hb_cube

    
    have hΦ_base : ∀ (j : Fin (r₁ + 1)) (a : Fin M₁_L.m),
        Φ_L (e₂_L j) a =
          (C₁_L.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV₁_w a))).op).hom
            ((w₁.app (⊤ ⊓ M₁'.V (σ₁ a))).hom (Φ' (e₂' j) (σ₁ a))) := by
      intro j a
      apply hLocalExt φ_L.hom M₂_L (⊤ ⊓ M₁_L.V a)
      intro b
      set W_L : C₁_L.Opens :=
        (⊤ ⊓ M₁_L.V a) ⊓ (TopologicalSpace.Opens.map φ_L.hom.base).obj (⊤ ⊓ M₂_L.V b)
      set W' : C₁'.Opens :=
        (⊤ ⊓ M₁'.V (σ₁ a)) ⊓ (TopologicalSpace.Opens.map φ'.hom.base).obj (⊤ ⊓ M₂'.V (σ₂ b))
      have h_w : W_L ≤ (TopologicalSpace.Opens.map w₁.base).obj W' := by
        intro p hp
        refine ⟨?_, ?_⟩
        · have hp1 : p ∈ ⊤ ⊓ M₁_L.V a := hp.1
          rw [hV₁_w a] at hp1; exact hp1
        · have hp2 : φ_L.hom.base p ∈ ⊤ ⊓ M₂_L.V b := hp.2
          rw [hV₂_w b] at hp2
          have hp_comm : (w₁ ≫ φ'.hom).base p = (φ_L.hom ≫ w₂).base p :=
            congrArg (fun k => k.base p) hw_φ
          change (w₁ ≫ φ'.hom).base p ∈ ⊤ ⊓ M₂'.V (σ₂ b)
          rw [hp_comm]; exact hp2
      have hu_eq : (u_L a b).val =
          (C₁_L.presheaf.map (CategoryTheory.homOfLE h_w).op).hom
            ((w₁.app W').hom (u' (σ₁ a) (σ₂ b)).val) := by
        have h_aux := hu_base_aux a b (eIdx₁' (σ₁ a)) (eIdx₂' (σ₂ b))
          (eIdx₁'.apply_symm_apply (eIdx₁_L a)).symm
          (eIdx₂'.apply_symm_apply (eIdx₂_L b)).symm
          (h_le_u' (σ₁ a) (σ₂ b)) h_w
        dsimp only [u']
        rw [Units.val_pow_eq_pow_val]
        exact h_aux
      rw [hΦL_loc (e₂_L j) (he₂_L_tri j) a b,
        res_res C₁_L (inf_le_left : W_L ≤ ⊤ ⊓ M₁_L.V a) (le_of_eq (hV₁_w a))
          (le_trans h_w ((TopologicalSpace.Opens.map w₁.base).monotone inf_le_left)),
        ← res_app_res w₁ (inf_le_left : W' ≤ ⊤ ⊓ M₁'.V (σ₁ a)) h_w
          (le_trans h_w ((TopologicalSpace.Opens.map w₁.base).monotone inf_le_left)),
        hΦ'_loc (e₂' j) (he₂'_tri j) (σ₁ a) (σ₂ b),
        map_mul, map_mul, ← hu_eq]
      congr 1
      have h_sub1 : W_L ≤ (TopologicalSpace.Opens.map (w₁ ≫ φ'.hom).base).obj (⊤ ⊓ M₂'.V (σ₂ b)) :=
        fun p hp => (h_w hp).2
      have h_sub2 : W_L ≤ (TopologicalSpace.Opens.map (φ_L.hom ≫ w₂).base).obj (⊤ ⊓ M₂'.V (σ₂ b)) := by
        intro p hp
        have hp_comm : (φ_L.hom ≫ w₂).base p = (w₁ ≫ φ'.hom).base p :=
          congrArg (fun k => k.base p) hw_φ.symm
        change (φ_L.hom ≫ w₂).base p ∈ ⊤ ⊓ M₂'.V (σ₂ b)
        rw [hp_comm]; exact h_sub1 hp
      rw [res_app_res w₁ (inf_le_right : W' ≤ (TopologicalSpace.Opens.map φ'.hom.base).obj (⊤ ⊓ M₂'.V (σ₂ b)))
          h_w h_sub1,
        ← res_comp_app w₁ φ'.hom h_sub1 h_sub1,
        res_congr_app hw_φ h_sub1 h_sub2,
        res_comp_app φ_L.hom w₂ h_sub2
          (le_trans inf_le_right ((TopologicalSpace.Opens.map φ_L.hom.base).monotone (le_of_eq (hV₂_w b)))),
        ← res_app_res φ_L.hom (le_of_eq (hV₂_w b)) inf_le_right _,
        ← he₂_w j b]

    
    have hM_eq : ∀ i j : Fin (r₁ + 1), ψ (M'.val i j) = M.val i j := by
      have htop : snd₁'.appTop ≫ w₁.appTop =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).appTop ≫ snd₁_L.appTop := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hw₁_snd,
          AlgebraicGeometry.Scheme.Hom.comp_appTop]
      have hspec : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫
          snd₁'.appTop ≫ w₁.appTop =
          CommRingCat.ofHom ψ ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).inv ≫ snd₁_L.appTop := by
        rw [htop, ← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality_assoc
          (CommRingCat.ofHom ψ) snd₁_L.appTop]
      have hsc_w : ∀ (c : R') (a : Fin M₁_L.m),
          (C₁_L.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV₁_w a))).op).hom
            ((w₁.app (⊤ ⊓ M₁'.V (σ₁ a))).hom
              ((C₁'.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M₁'.V (σ₁ a) ≤ ⊤)).op).hom
                (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫
                  snd₁'.appTop).hom c))) =
          (C₁_L.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M₁_L.V a ≤ ⊤)).op).hom
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).inv ≫
              snd₁_L.appTop).hom (ψ c)) := by
        intro c a
        rw [res_app_res w₁ (inf_le_left : ⊤ ⊓ M₁'.V (σ₁ a) ≤ ⊤) (le_of_eq (hV₁_w a)) le_top]
        congr 1
        exact CategoryTheory.ConcreteCategory.congr_hom hspec c
      intro i j
      have hψ_exp : ∀ a : Fin M₁_L.m,
          Φ_L (e₂_L j) a = ∑ i' : Fin (r₁ + 1),
            (C₁_L.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M₁_L.V a ≤ ⊤)).op).hom
              (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).inv ≫
                snd₁_L.appTop).hom (ψ (A' i' j))) * e₁_L i' a := by
        intro a
        rw [hΦ_base j a, hA'_exp j (σ₁ a), map_sum, map_sum]
        refine Finset.sum_congr rfl fun i' _ => ?_
        rw [map_mul, map_mul, hsc_w (A' i' j) a, ← he₁_w i' a]
      obtain ⟨c₀, _, hc₀_uniq⟩ := he₁_L_bas (Φ_L (e₂_L j)) (hΦL_tri _ (he₂_L_tri j))
      have hcol : (fun i' => ψ (A' i' j)) = (fun i' => A_L i' j) :=
        (hc₀_uniq _ hψ_exp).trans (hc₀_uniq _ (hAL_exp j)).symm
      exact congrFun hcol i

    
    have hmap : Matrix.GeneralLinearGroup.map ψ M' = M := by
      ext i j
      exact hM_eq i j
    have hinv : Matrix.GeneralLinearGroup.map ψ (M'⁻¹) = M⁻¹ := by
      rw [map_inv, hmap]
    refine ⟨M', hM_eq, fun i j => ?_⟩
    exact congrFun (congrFun
      (congrArg (fun u : Matrix.GeneralLinearGroup (Fin (r₁ + 1)) L => u.val) hinv) i) j

theorem weil_lineBundle_projMorphism_gl_and_baseChange_comm (B_h L : Type u) [CommRing B_h] [CommRing L] (ψ_h : B_h →+* L) (r₀ : ℕ)
    (C₁_h C₂_h C₁_L C₂_L : AlgebraicGeometry.Scheme.{u})
    (snd₁_h : C₁_h ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_h))
    (snd₂_h : C₂_h ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_h))
    (snd₁_L : C₁_L ⟶ AlgebraicGeometry.Spec (CommRingCat.of L))
    (snd₂_L : C₂_L ⟶ AlgebraicGeometry.Spec (CommRingCat.of L))
    (w₁ : C₁_L ⟶ C₁_h)
    (hw₁_snd : w₁ ≫ snd₁_h = snd₁_L ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_h))
    (w₂ : C₂_L ⟶ C₂_h)
    (hw₂_snd : w₂ ≫ snd₂_h = snd₂_L ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_h))
    (φ_L : C₁_L ≅ C₂_L)
    (hφL_snd : φ_L.hom ≫ snd₂_L = snd₁_L)
    (M₁_h : WeilLineBundle C₁_h) (M₂_h : WeilLineBundle C₂_h)
    (M₁_L : WeilLineBundle C₁_L) (M₂_L : WeilLineBundle C₂_L)
    (eIdx₁ : Fin M₁_L.m ≃ Fin M₁_h.m)
    (hV₁ : ∀ a : Fin M₁_L.m,
      ⊤ ⊓ M₁_L.V a = (TopologicalSpace.Opens.map w₁.base).obj (⊤ ⊓ M₁_h.V (eIdx₁ a)))
    (eIdx₂ : Fin M₂_L.m ≃ Fin M₂_h.m)
    (hV₂ : ∀ b : Fin M₂_L.m,
      ⊤ ⊓ M₂_L.V b = (TopologicalSpace.Opens.map w₂.base).obj (⊤ ⊓ M₂_h.V (eIdx₂ b)))
    (e₁_h : Fin (r₀ + 1) → ∀ a : Fin M₁_h.m, ↑(C₁_h.presheaf.obj (Opposite.op (⊤ ⊓ M₁_h.V a))))
    (e₂_h : Fin (r₀ + 1) → ∀ b : Fin M₂_h.m, ↑(C₂_h.presheaf.obj (Opposite.op (⊤ ⊓ M₂_h.V b))))
    (e₁_L : Fin (r₀ + 1) → ∀ a : Fin M₁_L.m, ↑(C₁_L.presheaf.obj (Opposite.op (⊤ ⊓ M₁_L.V a))))
    (he₁_L : ∀ (i : Fin (r₀ + 1)) (a : Fin M₁_L.m),
      e₁_L i a =
        (C₁_L.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV₁ a))).op).hom
          ((w₁.app _).hom (e₁_h i (eIdx₁ a))))
    (e₂_L : Fin (r₀ + 1) → ∀ b : Fin M₂_L.m, ↑(C₂_L.presheaf.obj (Opposite.op (⊤ ⊓ M₂_L.V b))))
    (he₂_L : ∀ (j : Fin (r₀ + 1)) (b : Fin M₂_L.m),
      e₂_L j b =
        (C₂_L.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV₂ b))).op).hom
          ((w₂.app _).hom (e₂_h j (eIdx₂ b))))
    (j₁_h : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) B_h) :=
              MvPolynomial.gradedAlgebra
            (⊤ : C₁_h.Opens).toScheme ⟶
              AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) B_h))
    (hj₁_h_proj : IsLineBundleProjMorphism M₁_h ⊤
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B_h)).inv ≫ snd₁_h.appTop).hom
      r₀ e₁_h j₁_h)
    (hj₁_h_cl : AlgebraicGeometry.IsClosedImmersion j₁_h)
    (j₂_h : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) B_h) :=
              MvPolynomial.gradedAlgebra
            (⊤ : C₂_h.Opens).toScheme ⟶
              AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) B_h))
    (hj₂_h_proj : IsLineBundleProjMorphism M₂_h ⊤
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B_h)).inv ≫ snd₂_h.appTop).hom
      r₀ e₂_h j₂_h)
    (hj₂_h_cl : AlgebraicGeometry.IsClosedImmersion j₂_h)
    (j₂_L : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) L) :=
              MvPolynomial.gradedAlgebra
            (⊤ : C₂_L.Opens).toScheme ⟶
              AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) L))
    (hj₂_L_proj : IsLineBundleProjMorphism M₂_L ⊤
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).inv ≫ snd₂_L.appTop).hom
      r₀ e₂_L j₂_L)
    (hj₂_L_cl : AlgebraicGeometry.IsClosedImmersion j₂_L)
    (M₀ : Matrix.GeneralLinearGroup (Fin (r₀ + 1)) B_h)
    (hUnit_L : ∀ (a : Fin M₁_L.m) (b : Fin M₂_L.m),
      let W_ab : C₁_L.Opens :=
        (⊤ ⊓ M₁_L.V a) ⊓ (TopologicalSpace.Opens.map φ_L.hom.base).obj (⊤ ⊓ M₂_L.V b)
      ∃ u_ab : (↑(C₁_L.presheaf.obj (Opposite.op W_ab)))ˣ,
        ∀ j : Fin (r₀ + 1),
          (C₁_L.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : W_ab ≤ ⊤ ⊓ M₁_L.V a)).op).hom
            (∑ i : Fin (r₀ + 1),
              (C₁_L.presheaf.map
                  (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M₁_L.V a ≤ ⊤)).op).hom
                (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).inv ≫
                  snd₁_L.appTop).hom (ψ_h (M₀.val i j))) * e₁_L i a) =
          u_ab.val *
            (C₁_L.presheaf.map
                (CategoryTheory.homOfLE
                  (inf_le_right : W_ab ≤
                    (TopologicalSpace.Opens.map φ_L.hom.base).obj (⊤ ⊓ M₂_L.V b))).op).hom
              ((φ_L.hom.app (⊤ ⊓ M₂_L.V b)).hom (e₂_L j b))) :
    ∃ (j₁' : C₁_h ⟶ (weilProjectiveSpaceOver B_h r₀).left)
      (j₂' : C₂_h ⟶ (weilProjectiveSpaceOver B_h r₀).left)
      (j₂_L' : C₂_L ⟶ (weilProjectiveSpaceOver L r₀).left)
      (Φ_L : (weilProjectiveSpaceOver L r₀).left ⟶ (weilProjectiveSpaceOver B_h r₀).left),
      AlgebraicGeometry.IsClosedImmersion j₁' ∧
      AlgebraicGeometry.IsClosedImmersion j₂' ∧
      AlgebraicGeometry.IsClosedImmersion j₂_L' ∧
      j₁' ≫ (weilProjectiveSpaceOver B_h r₀).hom = snd₁_h ∧
      j₂' ≫ (weilProjectiveSpaceOver B_h r₀).hom = snd₂_h ∧
      (∀ k : Fin (r₀ + 1),
        (TopologicalSpace.Opens.map Φ_L.base).obj (weilProjBasicOpen B_h r₀ k) =
          weilProjBasicOpen L r₀ k) ∧
      w₂ ≫ j₂' = j₂_L' ≫ Φ_L ∧
      w₁ ≫ j₁' = (φ_L.hom ≫ j₂_L') ≫ Φ_L :=
by
  
  have hXk_mem : ∀ (K : Type u) [CommRing K] (k : Fin (r₀ + 1)),
      MvPolynomial.X k ∈ MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) K 1 :=
    fun K _ k => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K k)
  have hIrrel : ∀ (K : Type u) [CommRing K],
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) K) :=
        MvPolynomial.gradedAlgebra
      (HomogeneousIdeal.irrelevant
        (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) K)).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (r₀ + 1) → MvPolynomial (Fin (r₀ + 1)) K)) := by
    intro K _
    let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) K) :=
      MvPolynomial.gradedAlgebra
    intro p hp
    have hp0 : (GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) K) 0) p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff _ p).mp hp
    have hcoeff0 : p.coeff 0 = 0 := by
      have h1 : (MvPolynomial.homogeneousComponent 0 p).coeff 0 =
          ((GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) K) 0) p).coeff 0 := by
        rw [GradedRing.proj_apply]
        exact congrArg (fun q => q.coeff 0) (MvPolynomial.decompose'_apply K 1 p 0).symm
      rw [hp0] at h1
      simpa [MvPolynomial.coeff_homogeneousComponent] using h1
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm_ne : m ≠ 0 := by
      intro h0
      subst h0
      exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
    by_contra h_all
    push Not at h_all
    apply hm_ne
    ext i
    exact h_all i (Set.mem_univ i)
  have hScale : ∀ (A R : Type u) [CommRing A] [CommRing R]
      (f g : MvPolynomial (Fin (r₀ + 1)) A →+* R) (u_val : R),
      (∀ c : A, f (MvPolynomial.C c) = g (MvPolynomial.C c)) →
      (∀ i : Fin (r₀ + 1), f (MvPolynomial.X i) = u_val * g (MvPolynomial.X i)) →
      ∀ (d : ℕ) (p : MvPolynomial (Fin (r₀ + 1)) A),
        p ∈ MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A d →
        f p = u_val ^ d * g p := by
    intro A R _ _ f g u_val hC hX d p hp
    classical
    have hProd : ∀ (m : Fin (r₀ + 1) →₀ ℕ) (s : Finset (Fin (r₀ + 1))),
        f (∏ i ∈ s, MvPolynomial.X i ^ m i) =
          u_val ^ (∑ i ∈ s, m i) * g (∏ i ∈ s, MvPolynomial.X i ^ m i) := by
      intro m s
      induction s using Finset.induction_on with
      | empty => simp
      | insert i s his ih =>
        rw [Finset.prod_insert his, Finset.sum_insert his, map_mul, map_pow, hX i, ih,
          mul_pow, pow_add, map_mul, map_pow]
        ring
    have hp_hom : p.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule d p).mp hp
    conv_lhs => rw [MvPolynomial.as_sum p]
    conv_rhs => rw [MvPolynomial.as_sum p]
    rw [map_sum, map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun m hm => ?_
    have hm_ne : p.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
    have hm_deg : (∑ i ∈ m.support, m i) = d := by
      simpa [Finsupp.weight_apply, Finsupp.sum] using hp_hom hm_ne
    rw [MvPolynomial.monomial_eq, map_mul, map_mul, hC (p.coeff m)]
    change g (MvPolynomial.C (p.coeff m)) * f (∏ i ∈ m.support, MvPolynomial.X i ^ m i) =
      u_val ^ d * (g (MvPolynomial.C (p.coeff m)) * g (∏ i ∈ m.support, MvPolynomial.X i ^ m i))
    rw [hProd m m.support, hm_deg]
    ring
  
  have hFun : ∀ (A_ring : Type u) [CommRing A_ring]
      {σ : Type u} [SetLike σ A_ring] [AddSubgroupClass σ A_ring]
      (𝒜 : ℕ → σ) [GradedRing 𝒜]
      (t : Fin (r₀ + 1) → A_ring)
      (_ht_deg : ∀ i : Fin (r₀ + 1), t i ∈ 𝒜 1)
      (_ht_irrel : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span (Set.range t)),
      (∀ (X₁ X₂ : AlgebraicGeometry.Scheme.{u}) (φ_X : X₁ ⟶ X₂)
        (f₁ : A_ring →+* ↑(X₁.presheaf.obj (Opposite.op ⊤)))
        (hf₁ : Ideal.map f₁ (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤)
        (f₂ : A_ring →+* ↑(X₂.presheaf.obj (Opposite.op ⊤)))
        (hf₂ : Ideal.map f₂ (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤)
        (u_scale : (↑(X₁.presheaf.obj (Opposite.op ⊤)))ˣ),
        (∀ (d : ℕ) (p : A_ring), p ∈ 𝒜 d → f₁ p = u_scale.val ^ d * φ_X.appTop.hom (f₂ p)) →
        AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f₁ hf₁ =
          φ_X ≫ AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f₂ hf₂) ∧
      (∀ (B_ring : Type u) [CommRing B_ring]
        {τ : Type u} [SetLike τ B_ring] [AddSubgroupClass τ B_ring]
        (ℬ : ℕ → τ) [GradedRing ℬ]
        (Ψ : 𝒜 →+*ᵍ ℬ)
        (hΨ : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map Ψ (HomogeneousIdeal.irrelevant 𝒜))
        (Y X : AlgebraicGeometry.Scheme.{u}) (w : Y ⟶ X)
        (f_A : A_ring →+* ↑(X.presheaf.obj (Opposite.op ⊤)))
        (hf_A : Ideal.map f_A (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤)
        (f_B : B_ring →+* ↑(Y.presheaf.obj (Opposite.op ⊤)))
        (hf_B : Ideal.map f_B (HomogeneousIdeal.irrelevant ℬ).toIdeal = ⊤),
        f_B.comp Ψ.toRingHom = w.appTop.hom.comp f_A →
        AlgebraicGeometry.Proj.fromOfGlobalSections ℬ f_B hf_B ≫
          AlgebraicGeometry.Proj.map Ψ hΨ =
        w ≫ AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f_A hf_A) := by
    intro A_ring _ σ _ _ 𝒜 _ t ht_deg ht_irrel
    have hAway_lift : ∀ {R₁ R₂ : CommRingCat.{u}} (φ_r : R₂ ⟶ R₁) (x₁ : R₁) (x₂ : R₂),
        IsUnit (algebraMap R₁ (Localization.Away x₁) (φ_r.hom x₂)) →
        ∃ (τ : Localization.Away x₂ →+* Localization.Away x₁),
          (∀ a : R₂, τ (algebraMap R₂ (Localization.Away x₂) a) =
            algebraMap R₁ (Localization.Away x₁) (φ_r.hom a)) ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₂ (Localization.Away x₂))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ (Localization.Away x₁))) ≫
            AlgebraicGeometry.Spec.map φ_r := by
      intro R₁ R₂ φ_r x₁ x₂ hu
      let g : R₂ →+* Localization.Away x₁ := (algebraMap R₁ (Localization.Away x₁)).comp φ_r.hom
      have hg : IsUnit (g x₂) := hu
      let τ : Localization.Away x₂ →+* Localization.Away x₁ :=
        IsLocalization.Away.lift x₂ (S := Localization.Away x₂) hg
      have hτ_eq : ∀ a : R₂, τ (algebraMap R₂ (Localization.Away x₂) a) =
          algebraMap R₁ (Localization.Away x₁) (φ_r.hom a) :=
        fun a => IsLocalization.Away.lift_eq x₂ hg a
      refine ⟨τ, hτ_eq, ?_⟩
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      exact hτ_eq a
    let M_chart : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (x : ↑(Z.presheaf.obj (Opposite.op ⊤))),
        (Z.basicOpen x).toScheme ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away x)) :=
      fun Z x =>
        (Z.isoOfEq (Z.toSpecΓ_preimage_basicOpen x)).inv ≫
          (Z.toSpecΓ ∣_ PrimeSpectrum.basicOpen x) ≫
          (AlgebraicGeometry.basicOpenIsoSpecAway x).hom
    have hM_fac : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (x : ↑(Z.presheaf.obj (Opposite.op ⊤))),
        M_chart Z x ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (↑(Z.presheaf.obj (Opposite.op ⊤))) (Localization.Away x))) =
        (Z.basicOpen x).ι ≫ Z.toSpecΓ := by
      intro Z x
      let U_spec : (AlgebraicGeometry.Spec (Z.presheaf.obj (Opposite.op ⊤))).Opens :=
        PrimeSpectrum.basicOpen x
      have h1 : (AlgebraicGeometry.basicOpenIsoSpecAway x).hom ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (↑(Z.presheaf.obj (Opposite.op ⊤))) (Localization.Away x))) =
          U_spec.ι := by
        rw [AlgebraicGeometry.basicOpenIsoSpecAway.eq_def,
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac]
      have h2 : (Z.toSpecΓ ∣_ U_spec) ≫ U_spec.ι =
          AlgebraicGeometry.Scheme.Opens.ι
            ((TopologicalSpace.Opens.map Z.toSpecΓ.base).obj U_spec) ≫ Z.toSpecΓ :=
        AlgebraicGeometry.morphismRestrict_ι Z.toSpecΓ U_spec
      have h3 : (Z.isoOfEq (Z.toSpecΓ_preimage_basicOpen x)).inv ≫
          AlgebraicGeometry.Scheme.Opens.ι
            ((TopologicalSpace.Opens.map Z.toSpecΓ.base).obj U_spec) =
          (Z.basicOpen x).ι :=
        AlgebraicGeometry.Scheme.isoOfEq_inv_ι Z (Z.toSpecΓ_preimage_basicOpen x)
      calc
        M_chart Z x ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (↑(Z.presheaf.obj (Opposite.op ⊤))) (Localization.Away x)))
          = (Z.isoOfEq (Z.toSpecΓ_preimage_basicOpen x)).inv ≫
              (Z.toSpecΓ ∣_ U_spec) ≫
              ((AlgebraicGeometry.basicOpenIsoSpecAway x).hom ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap (↑(Z.presheaf.obj (Opposite.op ⊤))) (Localization.Away x)))) := by
              simp only [M_chart, U_spec, Category.assoc]
        _ = (Z.isoOfEq (Z.toSpecΓ_preimage_basicOpen x)).inv ≫
              ((Z.toSpecΓ ∣_ U_spec) ≫ U_spec.ι) := by rw [h1]
        _ = ((Z.isoOfEq (Z.toSpecΓ_preimage_basicOpen x)).inv ≫
              AlgebraicGeometry.Scheme.Opens.ι
                ((TopologicalSpace.Opens.map Z.toSpecΓ.base).obj U_spec)) ≫ Z.toSpecΓ := by
              rw [h2, Category.assoc]
        _ = (Z.basicOpen x).ι ≫ Z.toSpecΓ := by rw [h3]
    have hM_nat : ∀ (Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}) (φ : Z₁ ⟶ Z₂)
        (x₁ : ↑(Z₁.presheaf.obj (Opposite.op ⊤)))
        (x₂ : ↑(Z₂.presheaf.obj (Opposite.op ⊤)))
        (e_open : Z₁.basicOpen x₁ ≤ (TopologicalSpace.Opens.map φ.base).obj (Z₂.basicOpen x₂))
        (τ_φ : Localization.Away x₂ →+* Localization.Away x₁),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_φ) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (↑(Z₂.presheaf.obj (Opposite.op ⊤))) (Localization.Away x₂))) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (↑(Z₁.presheaf.obj (Opposite.op ⊤))) (Localization.Away x₁))) ≫
          AlgebraicGeometry.Spec.map φ.appTop →
        φ.resLE (Z₂.basicOpen x₂) (Z₁.basicOpen x₁) e_open ≫ M_chart Z₂ x₂ =
          M_chart Z₁ x₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_φ) := by
      intro Z₁ Z₂ φ x₁ x₂ e_open τ_φ hτ_comp
      let ι₂ := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (↑(Z₂.presheaf.obj (Opposite.op ⊤))) (Localization.Away x₂)))
      let ι₁ := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (↑(Z₁.presheaf.obj (Opposite.op ⊤))) (Localization.Away x₁)))
      have : AlgebraicGeometry.IsOpenImmersion ι₂ :=
        AlgebraicGeometry.Scheme.isOpenImmersion_SpecMap_localizationAway x₂
      rw [← cancel_mono ι₂]
      calc
        (φ.resLE (Z₂.basicOpen x₂) (Z₁.basicOpen x₁) e_open ≫ M_chart Z₂ x₂) ≫ ι₂
          = φ.resLE (Z₂.basicOpen x₂) (Z₁.basicOpen x₁) e_open ≫ (M_chart Z₂ x₂ ≫ ι₂) := by
              rw [Category.assoc]
        _ = φ.resLE (Z₂.basicOpen x₂) (Z₁.basicOpen x₁) e_open ≫
              (Z₂.basicOpen x₂).ι ≫ Z₂.toSpecΓ := by rw [hM_fac Z₂ x₂]
        _ = (Z₁.basicOpen x₁).ι ≫ φ ≫ Z₂.toSpecΓ := by
              rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι_assoc]
        _ = ((Z₁.basicOpen x₁).ι ≫ Z₁.toSpecΓ) ≫ AlgebraicGeometry.Spec.map φ.appTop := by
              rw [AlgebraicGeometry.Scheme.toSpecΓ_naturality φ, Category.assoc]
        _ = (M_chart Z₁ x₁ ≫ ι₁) ≫ AlgebraicGeometry.Spec.map φ.appTop := by
              rw [← hM_fac Z₁ x₁]
        _ = M_chart Z₁ x₁ ≫ (ι₁ ≫ AlgebraicGeometry.Spec.map φ.appTop) := by
              rw [Category.assoc]
        _ = M_chart Z₁ x₁ ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_φ) ≫ ι₂) := by
              rw [← hτ_comp]
        _ = (M_chart Z₁ x₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_φ)) ≫ ι₂ := by
              rw [← Category.assoc]
    have hFrom_chart : ∀ {G : Type u} [CommRing G] {σG : Type u} [SetLike σG G] [AddSubgroupClass σG G]
        (𝒢 : ℕ → σG) [GradedRing 𝒢] (Z : AlgebraicGeometry.Scheme.{u})
        (f : G →+* ↑(Z.presheaf.obj (Opposite.op ⊤)))
        (hf : Ideal.map f (HomogeneousIdeal.irrelevant 𝒢).toIdeal = ⊤)
        (s : G) (hs : s ∈ 𝒢 1)
        (hy : Submonoid.powers s ≤ Submonoid.comap f (Submonoid.powers (f s))),
        (Z.basicOpen (f s)).ι ≫ AlgebraicGeometry.Proj.fromOfGlobalSections 𝒢 f hf =
          M_chart Z (f s) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              ((IsLocalization.map (Localization.Away (f s)) f hy).comp
                (algebraMap (HomogeneousLocalization.Away 𝒢 s) (Localization.Away s)))) ≫
            AlgebraicGeometry.Proj.awayι 𝒢 s hs zero_lt_one := by
      intro G _ σG _ _ 𝒢 _ Z f hf s hs hy
      have he_le : Z.basicOpen (f s) ≤
          (TopologicalSpace.Opens.map (AlgebraicGeometry.Proj.fromOfGlobalSections 𝒢 f hf).base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒢 s) :=
        le_of_eq (AlgebraicGeometry.Proj.fromOfGlobalSections_preimage_basicOpen 𝒢 f hf zero_lt_one hs).symm
      rw [← AlgebraicGeometry.Scheme.Hom.resLE_comp_ι (AlgebraicGeometry.Proj.fromOfGlobalSections 𝒢 f hf) he_le,
        AlgebraicGeometry.Proj.fromOfGlobalSections_resLE 𝒢 f hf zero_lt_one hs,
        AlgebraicGeometry.Proj.toBasicOpenOfGlobalSections.eq_def]
      simp only [M_chart, Category.assoc, AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
    refine ⟨?_, ?_⟩
    · intro X₁ X₂ φ_X f₁ hf₁ f₂ hf₂ u_scale hScale_gen
      let μ₁ := AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f₁ hf₁
      let μ₂ := AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f₂ hf₂
      have hCovProj : ⨆ i : Fin (r₀ + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (t i) = ⊤ :=
        AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 t ht_irrel
      have hCovX₁ : (⨆ i : Fin (r₀ + 1), X₁.basicOpen (f₁ (t i))) = ⊤ := by
        have h1 : (TopologicalSpace.Opens.map μ₁.base).obj
            (⨆ i : Fin (r₀ + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (t i)) = ⊤ := by
          rw [hCovProj]; rfl
        rw [TopologicalSpace.Opens.map_iSup] at h1
        refine Eq.trans ?_ h1
        refine iSup_congr fun i => ?_
        exact (AlgebraicGeometry.Proj.fromOfGlobalSections_preimage_basicOpen 𝒜 f₁ hf₁
          zero_lt_one (ht_deg i)).symm
      apply AlgebraicGeometry.Scheme.hom_ext_of_forall
      intro z
      have hz : z ∈ (⨆ i : Fin (r₀ + 1), X₁.basicOpen (f₁ (t i))) := by rw [hCovX₁]; trivial
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hz
      let s := t i
      have hs : s ∈ 𝒜 1 := ht_deg i
      let x₁ := f₁ s
      let x₂ := f₂ s
      refine ⟨X₁.basicOpen x₁, hi, ?_⟩
      have hx₁_eq : x₁ = u_scale.val * φ_X.appTop.hom x₂ := by
        have h := hScale_gen 1 s hs
        rwa [pow_one] at h
      have he_open : X₁.basicOpen x₁ ≤ (TopologicalSpace.Opens.map φ_X.base).obj (X₂.basicOpen x₂) := by
        apply le_of_eq
        rw [AlgebraicGeometry.Scheme.preimage_basicOpen_top φ_X x₂, hx₁_eq,
          X₁.basicOpen_mul, X₁.basicOpen_of_isUnit u_scale.isUnit, top_inf_eq]
      have h_unit : IsUnit (algebraMap (↑(X₁.presheaf.obj (Opposite.op ⊤)))
          (Localization.Away x₁) (φ_X.appTop.hom x₂)) := by
        have hx₂_inv : φ_X.appTop.hom x₂ = (u_scale⁻¹).val * x₁ := by
          rw [hx₁_eq, Units.inv_mul_cancel_left]
        rw [hx₂_inv, map_mul]
        exact (IsUnit.map _ u_scale⁻¹.isUnit).mul (IsLocalization.Away.algebraMap_isUnit x₁)
      obtain ⟨τ_φ, hτ_eq, hτ_spec⟩ := hAway_lift φ_X.appTop x₁ x₂ h_unit
      have hy₁ : Submonoid.powers s ≤ Submonoid.comap f₁ (Submonoid.powers x₁) :=
        Submonoid.powers_le.mpr (Submonoid.mem_comap.mpr (Submonoid.mem_powers x₁))
      have hy₂ : Submonoid.powers s ≤ Submonoid.comap f₂ (Submonoid.powers x₂) :=
        Submonoid.powers_le.mpr (Submonoid.mem_comap.mpr (Submonoid.mem_powers x₂))
      let ψ₁ := (IsLocalization.map (Localization.Away x₁) f₁ hy₁).comp
        (algebraMap (HomogeneousLocalization.Away 𝒜 s) (Localization.Away s))
      let ψ₂ := (IsLocalization.map (Localization.Away x₂) f₂ hy₂).comp
        (algebraMap (HomogeneousLocalization.Away 𝒜 s) (Localization.Away s))
      have h_rhs : (X₁.basicOpen x₁).ι ≫ (φ_X ≫ μ₂) =
          M_chart X₁ x₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ_φ.comp ψ₂)) ≫
            AlgebraicGeometry.Proj.awayι 𝒜 s hs zero_lt_one := by
        calc
          (X₁.basicOpen x₁).ι ≫ (φ_X ≫ μ₂)
            = ((X₁.basicOpen x₁).ι ≫ φ_X) ≫ μ₂ := by rw [Category.assoc]
          _ = (φ_X.resLE (X₂.basicOpen x₂) (X₁.basicOpen x₁) he_open ≫ (X₂.basicOpen x₂).ι) ≫ μ₂ := by
                rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
          _ = φ_X.resLE (X₂.basicOpen x₂) (X₁.basicOpen x₁) he_open ≫ ((X₂.basicOpen x₂).ι ≫ μ₂) := by
                rw [Category.assoc]
          _ = φ_X.resLE (X₂.basicOpen x₂) (X₁.basicOpen x₁) he_open ≫
                (M_chart X₂ x₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) ≫
                  AlgebraicGeometry.Proj.awayι 𝒜 s hs zero_lt_one) := by
                rw [hFrom_chart 𝒜 X₂ f₂ hf₂ s hs hy₂]
          _ = (φ_X.resLE (X₂.basicOpen x₂) (X₁.basicOpen x₁) he_open ≫ M_chart X₂ x₂) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) ≫
                AlgebraicGeometry.Proj.awayι 𝒜 s hs zero_lt_one := by
                simp only [Category.assoc]
          _ = (M_chart X₁ x₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_φ)) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) ≫
                AlgebraicGeometry.Proj.awayι 𝒜 s hs zero_lt_one := by
                rw [hM_nat X₁ X₂ φ_X x₁ x₂ he_open τ_φ hτ_spec]
          _ = M_chart X₁ x₁ ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_φ) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂)) ≫
                AlgebraicGeometry.Proj.awayι 𝒜 s hs zero_lt_one := by
                simp only [Category.assoc]
          _ = M_chart X₁ x₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ_φ.comp ψ₂)) ≫
                AlgebraicGeometry.Proj.awayι 𝒜 s hs zero_lt_one := by
                rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rw [hFrom_chart 𝒜 X₁ f₁ hf₁ s hs hy₁, h_rhs]
      have hψ_eq : ψ₁ = τ_φ.comp ψ₂ := by
        apply RingHom.ext
        intro q
        refine Quotient.inductionOn' q (fun nd => ?_)
        change ψ₁ (HomogeneousLocalization.mk nd) = (τ_φ.comp ψ₂) (HomogeneousLocalization.mk nd)
        dsimp only [ψ₁, ψ₂, RingHom.comp_apply]
        rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.val_mk,
          Localization.mk_eq_mk', IsLocalization.map_mk', IsLocalization.map_mk']
        symm
        rw [IsLocalization.eq_mk'_iff_mul_eq]
        have hP : f₁ nd.num.1 = u_scale.val ^ nd.deg * φ_X.appTop.hom (f₂ nd.num.1) :=
          hScale_gen nd.deg nd.num.1 nd.num.2
        have hQ : f₁ nd.den.1 = u_scale.val ^ nd.deg * φ_X.appTop.hom (f₂ nd.den.1) :=
          hScale_gen nd.deg nd.den.1 nd.den.2
        change τ_φ (IsLocalization.mk' (Localization.Away x₂) (f₂ nd.num.1) _) *
            algebraMap _ (Localization.Away x₁) (f₁ nd.den.1) =
          algebraMap _ (Localization.Away x₁) (f₁ nd.num.1)
        rw [hQ, hP, map_mul, map_mul, ← hτ_eq (f₂ nd.den.1), ← hτ_eq (f₂ nd.num.1)]
        calc
          τ_φ (IsLocalization.mk' (Localization.Away x₂) (f₂ nd.num.1) _) *
              (algebraMap _ (Localization.Away x₁) (u_scale.val ^ nd.deg) *
                τ_φ (algebraMap _ (Localization.Away x₂) (f₂ nd.den.1)))
            = algebraMap _ (Localization.Away x₁) (u_scale.val ^ nd.deg) *
                (τ_φ (IsLocalization.mk' (Localization.Away x₂) (f₂ nd.num.1) _) *
                  τ_φ (algebraMap _ (Localization.Away x₂) (f₂ nd.den.1))) := by ring
          _ = algebraMap _ (Localization.Away x₁) (u_scale.val ^ nd.deg) *
                τ_φ (IsLocalization.mk' (Localization.Away x₂) (f₂ nd.num.1) _ *
                  algebraMap _ (Localization.Away x₂) (f₂ nd.den.1)) := by rw [← map_mul]
          _ = algebraMap _ (Localization.Away x₁) (u_scale.val ^ nd.deg) *
                τ_φ (algebraMap _ (Localization.Away x₂) (f₂ nd.num.1)) := by
                rw [IsLocalization.mk'_spec]
      change M_chart X₁ x₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 s hs zero_lt_one = _
      rw [hψ_eq]
    · intro B_ring _ τ _ _ ℬ _ Ψ hΨ Y X w f_A hf_A f_B hf_B hComp
      let μ_B := AlgebraicGeometry.Proj.fromOfGlobalSections ℬ f_B hf_B
      let μ_A := AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f_A hf_A
      have htB_irrel : (HomogeneousIdeal.irrelevant ℬ).toIdeal ≤
          Ideal.span (Set.range (fun i : Fin (r₀ + 1) => Ψ (t i))) := by
        have h1 : (HomogeneousIdeal.irrelevant ℬ).toIdeal ≤
            (HomogeneousIdeal.map Ψ (HomogeneousIdeal.irrelevant 𝒜)).toIdeal := hΨ
        rw [HomogeneousIdeal.toIdeal_map] at h1
        refine le_trans h1 ?_
        refine le_trans (Ideal.map_mono ht_irrel) ?_
        rw [Ideal.map_span, ← Set.range_comp]
        rfl
      have hCovProjB : ⨆ i : Fin (r₀ + 1), AlgebraicGeometry.Proj.basicOpen ℬ (Ψ (t i)) = ⊤ :=
        AlgebraicGeometry.Proj.iSup_basicOpen_eq_top ℬ (fun i => Ψ (t i)) htB_irrel
      have hCovY : (⨆ i : Fin (r₀ + 1), Y.basicOpen (f_B (Ψ (t i)))) = ⊤ := by
        have h1 : (TopologicalSpace.Opens.map μ_B.base).obj
            (⨆ i : Fin (r₀ + 1), AlgebraicGeometry.Proj.basicOpen ℬ (Ψ (t i))) = ⊤ := by
          rw [hCovProjB]; rfl
        rw [TopologicalSpace.Opens.map_iSup] at h1
        refine Eq.trans ?_ h1
        refine iSup_congr fun i => ?_
        exact (AlgebraicGeometry.Proj.fromOfGlobalSections_preimage_basicOpen ℬ f_B hf_B
          zero_lt_one (Ψ.map_mem (ht_deg i))).symm
      apply AlgebraicGeometry.Scheme.hom_ext_of_forall
      intro z
      have hz : z ∈ (⨆ i : Fin (r₀ + 1), Y.basicOpen (f_B (Ψ (t i)))) := by rw [hCovY]; trivial
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hz
      let s_A := t i
      have hs_A : s_A ∈ 𝒜 1 := ht_deg i
      let s_B := Ψ s_A
      have hs_B : s_B ∈ ℬ 1 := Ψ.map_mem hs_A
      let x_A := f_A s_A
      let y_B := f_B s_B
      refine ⟨Y.basicOpen y_B, hi, ?_⟩
      have hApp : ∀ a : A_ring, f_B (Ψ a) = w.appTop.hom (f_A a) :=
        fun a => RingHom.congr_fun hComp a
      have hy_eq : y_B = w.appTop.hom x_A := hApp s_A
      have he_open : Y.basicOpen y_B ≤ (TopologicalSpace.Opens.map w.base).obj (X.basicOpen x_A) := by
        apply le_of_eq
        rw [AlgebraicGeometry.Scheme.preimage_basicOpen_top w x_A, hy_eq]
      have h_unit : IsUnit (algebraMap (↑(Y.presheaf.obj (Opposite.op ⊤)))
          (Localization.Away y_B) (w.appTop.hom x_A)) := by
