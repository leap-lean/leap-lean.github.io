      exact away_mk_eq hx₃ (1 + 1) 1 _ hdeg6 _ _ (by show _ = _ * x₃ ^ (1 + 1); dsimp [x₃]; ring)
    have hT1 : ∀ k₀ : Fin (N₀ + 1), t₀ k₀ k₀ = 1 := by
