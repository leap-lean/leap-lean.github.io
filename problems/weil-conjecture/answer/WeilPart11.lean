    obtain ⟨_hφa_inj, _hφa_Ω, _hφa_range, hφa_prime⟩ := hB2_4 U_a hUa hUa_ne φ_a hφ_a
    have hBasic_sub : E_sm.basicOpen s_a ≤ U_a := E_sm.basicOpen_le s_a
    have h_spec_basic : ∀ p : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op U_a)),
        hUa.fromSpec.base p ∈ (E_sm.basicOpen s_a : Set E_sm) ↔ s_a ∉ p.asIdeal := by
      intro p
      have h1 : p ∈ (TopologicalSpace.Opens.map hUa.fromSpec.base).obj (E_sm.basicOpen s_a) ↔
          p ∈ PrimeSpectrum.basicOpen s_a :=
        SetLike.ext_iff.mp (hUa.fromSpec_preimage_basicOpen s_a) p
      exact h1.trans (PrimeSpectrum.mem_basicOpen s_a p)
    ext z
    constructor
    · intro hz
      have hz_a : z ∈ U_a := hz.1
      have hz_b : z ∈ U_b := hz.2
      have hz_range :
          z ∈ Set.range (hUa.fromSpec.base :
            PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op U_a)) → E_sm) := by
        rw [hUa.range_fromSpec]
        exact hz_a
      rcases hz_range with ⟨p_z, hp_z⟩
      change z ∈ (E_sm.basicOpen s_a : Set E_sm)
      rw [← hp_z, h_spec_basic p_z]
      by_cases hz_cl : IsClosed ({z} : Set E_sm)
      · have hz_cl' : IsClosed ({hUa.fromSpec.base p_z} : Set E_sm) := by rwa [hp_z]
        rw [hφa_prime p_z hz_cl' s_a, hp_z, hsa_eq]
        have hz_a' : z ∈ (U_a : Set E_sm) := hz_a
        have hz_b' : z ∈ (U_b : Set E_sm) := hz_b
        rw [hUa_set] at hz_a'
        rw [hUb_set] at hz_b'
        have hta_nonneg : (0 : WithTop ℤ) ≤ ord z t_a :=
          hz_a'.resolve_left (not_not.mpr hz_cl)
        have htb_nonneg : (0 : WithTop ℤ) ≤ ord z t_b :=
          hz_b'.resolve_left (not_not.mpr hz_cl)
        exact (hOrd_iff z hz_cl hta_nonneg).mpr htb_nonneg
      · intro hsa_in
        have hz_not_basic : z ∉ (E_sm.basicOpen s_a : Set E_sm) := by
          intro hz_in
          rw [← hp_z, h_spec_basic p_z] at hz_in
          exact hz_in hsa_in
        have hCl_univ : closure ({z} : Set E_sm) = Set.univ := by
          by_contra hne
          exact hz_cl ((hA2 (closure ({z} : Set E_sm)) isClosed_closure hne).2 z
            (subset_closure (Set.mem_singleton z)))
        have hUniv_compl : (Set.univ : Set E_sm) ⊆ (E_sm.basicOpen s_a : Set E_sm)ᶜ := by
          rw [← hCl_univ]
          exact closure_minimal (Set.singleton_subset_iff.mpr hz_not_basic)
            (E_sm.basicOpen s_a).isOpen.isClosed_compl
        let q₀ : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op U_a)) :=
          ⟨RingHom.ker φ_a.hom, RingHom.ker_isPrime φ_a.hom⟩
        have hq₀_not_in : s_a ∉ q₀.asIdeal := by
          change φ_a.hom s_a ≠ 0
          rw [hsa_eq]
