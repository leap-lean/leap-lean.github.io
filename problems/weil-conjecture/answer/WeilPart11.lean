            change ∑ j : Fin (N + 1), (m : ℤ) * e_ind p α j = _
            rw [← Finset.mul_sum, he_ind_sum p α]
          omega
        have hval_spec : (HomogeneousLocalization.mk nd).val *
            (algebraMap _ (Localization.Away (f_prod p α)) (f_prod p α)) ^ m =
            algebraMap _ (Localization.Away (f_prod p α)) nd.num.1 := by
          rw [HomogeneousLocalization.val_mk, Localization.mk_eq_mk']
          have hsp := IsLocalization.mk'_spec (Localization.Away (f_prod p α))
            nd.num.1 ⟨nd.den.1, nd.den_mem⟩
          have hden_alg : algebraMap (MvPolynomial (Fin (N + 1)) B)
              (Localization.Away (f_prod p α)) (↑(⟨nd.den.1, nd.den_mem⟩ : Submonoid.powers (f_prod p α))) =
              (algebraMap _ (Localization.Away (f_prod p α)) (f_prod p α)) ^ m := by
            change algebraMap _ _ nd.den.1 = _
            rw [← hm_pow, map_pow]
          rwa [hden_alg] at hsp
        have hτ_val := hτ_α_frac p α m nd.num.1 (HomogeneousLocalization.mk nd).val hval_spec
        change eFS (eMon (shiftVec p α) * τ_α p α (HomogeneousLocalization.mk nd).val) a = 0
        rw [hτ_val, mul_comm (eMon (shiftVec p α)), mul_assoc, heMon_add, heFS_mul_eMon]
        by_contra hne
        obtain ⟨hw_nonneg, hw_sum⟩ :=
          hHomLaur nd.deg nd.num.1 nd.num.2
            (a - (-(m : ℤ) • e_ind p α + shiftVec p α)) hne
        apply hNotVal
        refine ⟨?_, ?_⟩
        · have hsum_shift : ∑ j : Fin (N + 1), shiftVec p α j = -(D : ℤ) := by
            change ∑ j : Fin (N + 1), (-(D : ℤ)) * δ (α.1 0) j = -(D : ℤ)
            rw [← Finset.mul_sum, hδ_sum (α.1 0), mul_one]
          have hsum_e : ∑ j : Fin (N + 1), (-(m : ℤ) • e_ind p α) j =
              -(m : ℤ) * ((p + 1 : ℕ) : ℤ) := by
            change ∑ j : Fin (N + 1), (-(m : ℤ)) * e_ind p α j = _
            rw [← Finset.mul_sum, he_ind_sum p α]
          have hw_expand : ∑ j : Fin (N + 1),
              (a - (-(m : ℤ) • e_ind p α + shiftVec p α)) j =
              (∑ j : Fin (N + 1), a j) - (-(m : ℤ) * ((p + 1 : ℕ) : ℤ) + -(D : ℤ)) := by
            change ∑ j : Fin (N + 1),
              (a j - ((-(m : ℤ) • e_ind p α) j + shiftVec p α j)) = _
            rw [Finset.sum_sub_distrib, Finset.sum_add_distrib, hsum_e, hsum_shift]
