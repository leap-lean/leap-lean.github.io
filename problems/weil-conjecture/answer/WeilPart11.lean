  have hProjCov : (⨆ k : Fin (r₀ + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X k)) = ⊤ := by
    apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜
