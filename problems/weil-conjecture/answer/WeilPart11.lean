            rintro z ⟨y, hy⟩
            refine ⟨E_res h q y, ?_⟩
            change dv_sec W q (E_res h q y) = E_res h (q + 1) z.1
            have hy' : dv_sec U q y = z.1 := hy
            rw [hE_res_dv h q y, hy'])).toAddMonoidHom
      res_smul := fun {U W} h a x => by
        let _ := instModE U (q + 1)
        let _ := instModE W (q + 1)
        obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (Bq_sub U q) x
        have h1 : ker_res_q h q (@SMul.smul _ _ (letI := instModE U (q + 1); inferInstance) a z) =
            @SMul.smul _ _ (letI := instModE W (q + 1); inferInstance)
