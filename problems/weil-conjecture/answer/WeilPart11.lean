            hMapComp hle_j (inf_le_inf_left (U lam) (hFaceOf α j))
              (le_trans hW_γ (hFaceOf γ m_j)),
            hMapComp (hFaceOf γ m_j) hW_γ (le_trans hW_γ (hFaceOf γ m_j))]
          let R_α := ↑(Y.presheaf.obj (Opposite.op W_α))
          have hSign : (-1 : R_α) ^ (i_star : ℕ) * ((-1) ^ (j : ℕ) * (-1) ^ (j_lam : ℕ)) =
              - ((-1 : R_α) ^ (m_j : ℕ)) := by
            rcases lt_or_ge j.castSucc i_star with hj_lt | hi_le
            · have hmj_eq : m_j = j.castSucc := Fin.succAbove_of_castSucc_lt i_star j hj_lt
              have hm_le : m_j ≤ j_lam.castSucc := by
