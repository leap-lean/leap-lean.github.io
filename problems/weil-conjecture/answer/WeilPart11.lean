    have hψ_eq : ψ = ρ.comp φ_away := by
      dsimp only [ψ, ρ, AlgebraicGeometry.Proj.toBasicOpenOfGlobalSections]
      rw [CategoryTheory.Category.assoc, Iso.inv_hom_id, CategoryTheory.Category.comp_id]
      ext m
      change ((AlgebraicGeometry.Scheme.ΓSpecIso R_away).inv ≫
