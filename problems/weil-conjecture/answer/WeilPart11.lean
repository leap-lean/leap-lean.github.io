        (Y.presheaf.map (CategoryTheory.homOfLE h₂).op).hom (c τ₂) := by
      rintro _ _ _ _ _ rfl _ _; rfl
    intro p z_mod hz_mod
    let z : C_Y (p + 1) := toCY (p + 1) z_mod
    have hz : d_Y (p + 1) z = 0 := by
      rw [← hToDiff (p + 1) z_mod, hz_mod, hToZero (p + 2)]
    have hDiffSum : ∀ (C_fam : Fin r → C_Y p) (α : WeilStrictMonoTuple r (p + 1)),
