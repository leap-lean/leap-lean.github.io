      intro p ι I f_i
      classical
      induction I using Finset.induction_on with
      | empty => simp [hΘ_inv_zero]
      | insert i I hi ih => simp [Finset.sum_insert hi, hΘ_inv_add, ih]
    have hΘ_diff : ∀ (p : ℕ) (d : WeilModuleCechCochain V H_C p),
