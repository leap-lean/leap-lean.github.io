    intro U W h q c
    funext γ
    change ∑ j : Fin (q + 2), ((-1 : ℤ) ^ (j : ℕ)) •
        (Z'.presheaf.map _).hom ((Z'.presheaf.map _).hom (c _)) =
      (Z'.presheaf.map _).hom (∑ j : Fin (q + 2), ((-1 : ℤ) ^ (j : ℕ)) •
        (Z'.presheaf.map _).hom (c _))
    rw [map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_zsmul]
    congr 1
    exact hMapComm Z' _ _ _ _ (c _)
