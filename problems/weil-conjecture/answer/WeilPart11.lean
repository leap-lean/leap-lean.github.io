      change HomogeneousLocalization.val (HomogeneousLocalization.Away.mk 𝒜 hXk n P hP) = _
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
    rw [hVal, IsLocalization.map_mk']
