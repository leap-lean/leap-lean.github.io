        TopCat.Sheaf.existsUnique_gluing'.{u} Y.sheaf U W iU (le_of_eq hCov.symm) sf hCompat
      have hy₂ : ∀ a : Fin r, (Y.presheaf.map (iU a).op).hom y₂ = sf a := by
        intro a
        have h_pt := congrArg (e_Y (weilCoverChartInter U (pt0 a))) (congrFun h_eq (pt0 a))
