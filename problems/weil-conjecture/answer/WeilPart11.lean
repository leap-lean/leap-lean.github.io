    let hFace : ∀ j : Fin (p + 2),
        weilCoverChartInter W_std β ≤ weilCoverChartInter W_std (face j) :=
      fun j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
    let ev_l : E.sec (weilCoverChartInter W_std β) →+
        ↑(P_B.presheaf.obj (Opposite.op (weilCoverChartInter W_std β))) :=
      { toFun := fun x => ev (weilCoverChartInter W_std β) (β.1 0) (hα0 (p + 1) β) x l
        map_zero' := by rw [map_zero, Pi.zero_apply]
        map_add' := fun x₁ x₂ => by rw [map_add, Pi.add_apply] }
    let compβ : E.sec (weilCoverChartInter W_std β) →+ ((Fin (N + 1) → ℤ) →₀ B) :=
      (μ (p + 1) β).comp ((Θ_symm (p + 1) β).toAddMonoidHom.comp ev_l)
    change compβ (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • E.res (hFace j) (c (face j))) =
      ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • Φ p c l (face j)
    rw [map_sum]
    simp_rw [map_zsmul]
    rw [Fin.sum_univ_succ
          (f := fun j : Fin (p + 2) => ((-1 : ℤ) ^ (j : ℕ)) • compβ (E.res (hFace j) (c (face j)))),
        Fin.sum_univ_succ
          (f := fun j : Fin (p + 2) => ((-1 : ℤ) ^ (j : ℕ)) • Φ p c l (face j))]
    have hResBridge : ∀ (j : Fin (p + 2)) {e : ℕ} {g : MvPolynomial (Fin (N + 1)) B}
        (hg : g ∈ 𝒜 e) (hx : f_prod (p + 1) β = f_prod p (face j) * g)
        (s_j : ↑(P_B.presheaf.obj (Opposite.op (weilCoverChartInter W_std (face j))))),
        Θ_symm (p + 1) β ((P_B.presheaf.map (CategoryTheory.homOfLE (hFace j)).op).hom s_j) =
          HomogeneousLocalization.awayMap 𝒜 hg hx (Θ_symm p (face j) s_j) := by
      intro j e g hg hx s_j
      let y_j := Θ_symm p (face j) s_j
      have hs_j : s_j = Θ_fwd p (face j) y_j := (hΘ_right p (face j) s_j).symm
      rw [hs_j]
      have hOpen : AlgebraicGeometry.Proj.basicOpen 𝒜 (f_prod (p + 1) β) ≤
          AlgebraicGeometry.Proj.basicOpen 𝒜 (f_prod p (face j)) :=
        le_trans (le_of_eq (hChartInter (p + 1) β).symm)
          (le_trans (hFace j) (le_of_eq (hChartInter p (face j))))
      change (θ_equiv (p + 1) β).symm
        ((P_B.presheaf.map _).hom ((P_B.presheaf.map _).hom
          ((P_B.presheaf.map _).hom ((AlgebraicGeometry.Proj.awayToSection 𝒜 _).hom y_j)))) = _
      rw [hMapComp _ _ (le_trans (hFace j) (le_of_eq (hChartInter p (face j)))),
        hMapComp _ _ hOpen,
        hAwayRes hg hx hOpen y_j,
        hθ_symm_away,
        hΘ_left]
    congr 1
    · 
      simp only [Fin.val_zero, pow_zero, one_smul]
      have h0_idx : (face 0).1 0 = β.1 1 := by
        change β.1 ((0 : Fin (p + 2)).succAbove 0) = β.1 1
        rw [Fin.zero_succAbove]
        rfl
      have hβ1 : weilCoverChartInter W_std β ≤ W_std (β.1 1) :=
        Finset.inf'_le _ (Finset.mem_univ (1 : Fin (p + 2)))
      let hU01 : weilCoverChartInter W_std β ≤
          AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X (β.1 0) * MvPolynomial.X (β.1 1)) :=
        le_trans (le_inf (hα0 (p + 1) β) hβ1)
          (le_of_eq (AlgebraicGeometry.Proj.basicOpen_mul 𝒜
            (MvPolynomial.X (β.1 0)) (MvPolynomial.X (β.1 1))).symm)
      have hev0 : ev (weilCoverChartInter W_std β) (β.1 0) (hα0 (p + 1) β)
          (E.res (hFace 0) (c (face 0))) l =
          ((P_B.presheaf.map (CategoryTheory.homOfLE hU01).op).hom
            (weilProjTransitionElem B N (β.1 0) (β.1 1))) ^ D *
          (P_B.presheaf.map (CategoryTheory.homOfLE (hFace 0)).op).hom
            (ev (weilCoverChartInter W_std (face 0)) ((face 0).1 0) (hα0 p (face 0))
              (c (face 0)) l) := by
        rw [hev_tr (weilCoverChartInter W_std β) (β.1 0) (β.1 1) (hα0 (p + 1) β) hβ1
          (E.res (hFace 0) (c (face 0))) l]
        congr 1
        rw [hEvCongr (weilCoverChartInter W_std β) (β.1 1) ((face 0).1 0) h0_idx.symm hβ1
          (le_trans (hFace 0) (hα0 p (face 0))),
          hev_res ((face 0).1 0) (hα0 p (face 0)) (hFace 0) (c (face 0)) l]
      have hg₀ : MvPolynomial.X (β.1 0) ∈ 𝒜 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X B (β.1 0))
      have hg1_var : MvPolynomial.X (β.1 1) ∈ 𝒜 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X B (β.1 1))
      have h01 : MvPolynomial.X (β.1 0) * MvPolynomial.X (β.1 1) ∈ 𝒜 2 :=
        SetLike.mul_mem_graded hg₀ hg1_var
      have h00 : MvPolynomial.X (β.1 0) ^ 2 ∈ 𝒜 (1 • 2) :=
        (one_nsmul 2).symm ▸ SetLike.pow_mem_graded 2 hg₀
      have hx₀ : f_prod (p + 1) β = f_prod p (face 0) * MvPolynomial.X (β.1 0) := by
        change (∏ i : Fin (p + 2), MvPolynomial.X (β.1 i)) =
          (∏ i : Fin (p + 1), MvPolynomial.X (β.1 ((0 : Fin (p + 2)).succAbove i))) *
            MvPolynomial.X (β.1 0)
        rw [Fin.prod_univ_succ, mul_comm]
        rfl
      let g₁ : MvPolynomial (Fin (N + 1)) B := ∏ i : Fin p, MvPolynomial.X (β.1 i.succ.succ)
      have hg₁ : g₁ ∈ 𝒜 p := hProdHom p (fun i => β.1 i.succ.succ)
      have hx₁ : f_prod (p + 1) β =
          (MvPolynomial.X (β.1 0) * MvPolynomial.X (β.1 1)) * g₁ := by
        change (∏ i : Fin (p + 2), MvPolynomial.X (β.1 i)) = _
        rw [Fin.prod_univ_succ, Fin.prod_univ_succ, mul_assoc]
        rfl
      have hOpen01 : AlgebraicGeometry.Proj.basicOpen 𝒜 (f_prod (p + 1) β) ≤
          AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X (β.1 0) * MvPolynomial.X (β.1 1)) :=
        le_trans (le_of_eq (hChartInter (p + 1) β).symm) hU01
      have hTr_Θ : Θ_symm (p + 1) β
          ((P_B.presheaf.map (CategoryTheory.homOfLE hU01).op).hom
            (weilProjTransitionElem B N (β.1 0) (β.1 1))) =
          HomogeneousLocalization.awayMap 𝒜 hg₁ hx₁
            (HomogeneousLocalization.Away.mk 𝒜 h01 1 (MvPolynomial.X (β.1 0) ^ 2) h00) := by
        change (θ_equiv (p + 1) β).symm
          ((P_B.presheaf.map _).hom ((P_B.presheaf.map _).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜 _).hom
              (HomogeneousLocalization.Away.mk 𝒜 h01 1 (MvPolynomial.X (β.1 0) ^ 2) h00)))) = _
        rw [hMapComp _ _ hOpen01,
          hAwayRes hg₁ hx₁ hOpen01 _,
          hθ_symm_away]
      change μ (p + 1) β (Θ_symm (p + 1) β
        (ev (weilCoverChartInter W_std β) (β.1 0) (hα0 (p + 1) β)
          (E.res (hFace 0) (c (face 0))) l)) = Φ p c l (face 0)
      rw [hev0, map_mul, map_pow, hTr_Θ, hResBridge 0 hg₀ hx₀,
        hμ_zero p β h01 h00 hg₁ hx₁ hg₀ hx₀]
      rfl
    · 
      refine Finset.sum_congr rfl fun k _ => ?_
      congr 1
      have hk_idx : (face k.succ).1 0 = β.1 0 := by
        change β.1 (k.succ.succAbove 0) = β.1 0
        rw [Fin.succ_succAbove_zero]
      have hevk : ev (weilCoverChartInter W_std β) (β.1 0) (hα0 (p + 1) β)
          (E.res (hFace k.succ) (c (face k.succ))) l =
          (P_B.presheaf.map (CategoryTheory.homOfLE (hFace k.succ)).op).hom
            (ev (weilCoverChartInter W_std (face k.succ)) ((face k.succ).1 0)
              (hα0 p (face k.succ)) (c (face k.succ)) l) := by
        rw [hEvCongr (weilCoverChartInter W_std β) (β.1 0) ((face k.succ).1 0) hk_idx.symm
          (hα0 (p + 1) β) (le_trans (hFace k.succ) (hα0 p (face k.succ))),
          hev_res ((face k.succ).1 0) (hα0 p (face k.succ)) (hFace k.succ) (c (face k.succ)) l]
      have hg_k : MvPolynomial.X (β.1 k.succ) ∈ 𝒜 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
          (MvPolynomial.isHomogeneous_X B (β.1 k.succ))
      have hx_k : f_prod (p + 1) β = f_prod p (face k.succ) * MvPolynomial.X (β.1 k.succ) := by
        change (∏ i : Fin (p + 2), MvPolynomial.X (β.1 i)) =
          (∏ i : Fin (p + 1), MvPolynomial.X (β.1 (k.succ.succAbove i))) *
            MvPolynomial.X (β.1 k.succ)
        rw [Fin.prod_univ_succAbove _ k.succ, mul_comm]
      change μ (p + 1) β (Θ_symm (p + 1) β
        (ev (weilCoverChartInter W_std β) (β.1 0) (hα0 (p + 1) β)
          (E.res (hFace k.succ) (c (face k.succ))) l)) = Φ p c l (face k.succ)
      rw [hevk, hResBridge k.succ hg_k hx_k, hμ_succ p β k hg_k hx_k]
      rfl

  
  obtain ⟨⟨k₀, gen₀, hgen₀_ker, hgen₀_span⟩, hLaur_succ⟩ := hLaur (-(D : ℤ))
  have hLaurDiffZero : ∀ q : ℕ, weilLaurentCechDiff B N q 0 = 0 := by
    intro q
    funext β
    change ∑ j : Fin (q + 2), ((-1 : ℤ) ^ (j : ℕ)) • (0 : (Fin (N + 1) → ℤ) →₀ B) = 0
    simp
  have hLiftSingle : ∀ (q : ℕ) (l₀ : Fin s)
      (u : WeilStrictMonoTuple (N + 1) q → ((Fin (N + 1) → ℤ) →₀ B)),
      IsValidLaurentCochain B N (-(D : ℤ)) q u →
      ∃ c : WeilModuleCechCochain W_std E q, Φ q c = Pi.single l₀ u := by
    intro q l₀ u hu
    apply hΦ_surj q (Pi.single l₀ u)
    intro l α a hna
    rw [Pi.single_apply]
    split_ifs with hl
    · subst hl; exact hu α a hna
    · rfl
  refine ⟨?_, ?_⟩
  · 
    let e₀ : Fin (s * k₀) ≃ Fin s × Fin k₀ := finProdFinEquiv.symm
    choose GEN₀ hGEN₀ using fun m : Fin (s * k₀) =>
      hLiftSingle 0 (e₀ m).1 (gen₀ (e₀ m).2) (hgen₀_ker (e₀ m).2).1
    refine ⟨s * k₀, GEN₀, ?_, ?_⟩
    · intro m
      apply hΦ_inj 1
      rw [map_zero]
      funext l
      rw [hΦ_diff 0 (GEN₀ m) l, hGEN₀ m, Pi.zero_apply, Pi.single_apply]
      split_ifs with hl
      · exact (hgen₀_ker (e₀ m).2).2
      · exact hLaurDiffZero 0
    · intro z hz
      have hz_ker : ∀ l : Fin s, weilLaurentCechDiff B N 0 (Φ 0 z l) = 0 := by
        intro l
        rw [← hΦ_diff 0 z l, hz, map_zero, Pi.zero_apply]
      choose c_l hc_l using fun l : Fin s =>
        hgen₀_span (Φ 0 z l) (hΦ_val 0 z l) (hz_ker l)
      refine ⟨fun m => c_l (e₀ m).1 (e₀ m).2, ?_⟩
      apply hΦ_inj 0
      funext l
      rw [map_sum]
      simp only [Finset.sum_apply, hΦ_smul]
      rw [← Equiv.sum_comp finProdFinEquiv
        (fun m => c_l (e₀ m).1 (e₀ m).2 • Φ 0 (GEN₀ m) l)]
      let single₀ : Fin s → (WeilStrictMonoTuple (N + 1) 0 → ((Fin (N + 1) → ℤ) →₀ B)) →
          Fin s → (WeilStrictMonoTuple (N + 1) 0 → ((Fin (N + 1) → ℤ) →₀ B)) := Pi.single
      have hreidx : ∀ x : Fin s × Fin k₀,
          c_l (e₀ (finProdFinEquiv x)).1 (e₀ (finProdFinEquiv x)).2 •
            Φ 0 (GEN₀ (finProdFinEquiv x)) l =
          c_l x.1 x.2 • (single₀ x.1 (gen₀ x.2) l) := by
        intro x
        rw [hGEN₀ (finProdFinEquiv x)]
        have hx : e₀ (finProdFinEquiv x) = x := finProdFinEquiv.symm_apply_apply x
        rw [hx]
      simp_rw [hreidx]
      rw [Fintype.sum_prod_type, Finset.sum_eq_single l]
      · simp only [single₀, Pi.single_eq_same]
        exact hc_l l
      · intro i _ hil
        refine Finset.sum_eq_zero fun j _ => ?_
        have hne : l ≠ i := hil.symm
        simp [single₀, Pi.single_apply, hne]
      · intro hl
        exact absurd (Finset.mem_univ l) hl
  · 
    intro p
    obtain ⟨k, gen, hgen_ker, hgen_span⟩ := hLaur_succ p
    let e : Fin (s * k) ≃ Fin s × Fin k := finProdFinEquiv.symm
    choose GEN hGEN using fun m : Fin (s * k) =>
      hLiftSingle (p + 1) (e m).1 (gen (e m).2) (hgen_ker (e m).2).1
    refine ⟨s * k, GEN, ?_, ?_⟩
    · intro m
      apply hΦ_inj (p + 2)
      rw [map_zero]
      funext l
      rw [hΦ_diff (p + 1) (GEN m) l, hGEN m, Pi.zero_apply, Pi.single_apply]
      split_ifs with hl
      · exact (hgen_ker (e m).2).2
      · exact hLaurDiffZero (p + 1)
    · intro z hz
      have hz_ker : ∀ l : Fin s, weilLaurentCechDiff B N (p + 1) (Φ (p + 1) z l) = 0 := by
        intro l
        rw [← hΦ_diff (p + 1) z l, hz, map_zero, Pi.zero_apply]
      choose c_l b_l hb_val hzb using fun l : Fin s =>
        hgen_span (Φ (p + 1) z l) (hΦ_val (p + 1) z l) (hz_ker l)
      obtain ⟨B_coch, hB_coch⟩ := hΦ_surj p b_l hb_val
      refine ⟨fun m => c_l (e m).1 (e m).2, B_coch, ?_⟩
      apply hΦ_inj (p + 1)
      funext l
      rw [map_add, map_sum, Pi.add_apply, hΦ_diff p B_coch l, hB_coch]
      simp only [Finset.sum_apply, hΦ_smul]
      rw [← Equiv.sum_comp finProdFinEquiv
        (fun m => c_l (e m).1 (e m).2 • Φ (p + 1) (GEN m) l)]
      let single_succ : Fin s →
          (WeilStrictMonoTuple (N + 1) (p + 1) → ((Fin (N + 1) → ℤ) →₀ B)) →
          Fin s → (WeilStrictMonoTuple (N + 1) (p + 1) → ((Fin (N + 1) → ℤ) →₀ B)) := Pi.single
      have hreidx : ∀ x : Fin s × Fin k,
          c_l (e (finProdFinEquiv x)).1 (e (finProdFinEquiv x)).2 •
            Φ (p + 1) (GEN (finProdFinEquiv x)) l =
          c_l x.1 x.2 • (single_succ x.1 (gen x.2) l) := by
        intro x
        rw [hGEN (finProdFinEquiv x)]
        have hx : e (finProdFinEquiv x) = x := finProdFinEquiv.symm_apply_apply x
        rw [hx]
      simp_rw [hreidx]
      rw [Fintype.sum_prod_type, Finset.sum_eq_single l]
      · simp only [single_succ, Pi.single_eq_same]
        exact hzb l
      · intro i _ hil
        refine Finset.sum_eq_zero fun j _ => ?_
        have hne : l ≠ i := hil.symm
        simp [single_succ, Pi.single_apply, hne]
      · intro hl
        exact absurd (Finset.mem_univ l) hl

theorem weil_proj_coherent_twisted_surjection_exact (B : Type u) [CommRing B] [IsNoetherianRing B]
    (N : ℕ)
    (G : WeilPresheafModule
      (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) :=
         MvPolynomial.gradedAlgebra
       AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B))) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) :=
      MvPolynomial.gradedAlgebra
    let W_std : Fin (N + 1) →
        (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B)).Opens :=
      fun k => AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) (MvPolynomial.X k)
    IsWeilCoherentSubChartModule W_std G →
    ∃ (D s : ℕ)
      (K E : WeilPresheafModule
        (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B))),
      IsWeilProjNegTwistedFreeSum B N D s E ∧
      IsWeilCoherentSubChartModule W_std K ∧
      HasWeilSubChartShortExactSeq W_std K E G :=
by
  have hAbstractGraded :
      ∀ {A : Type u} [CommRing A] {σ : Type u} [SetLike σ A] [AddSubgroupClass σ A]
        (𝒜₀ : ℕ → σ) [GradedRing 𝒜₀]
        (N₀ : ℕ) (X_var : Fin (N₀ + 1) → A)
        (hj : ∀ k : Fin (N₀ + 1), X_var k ∈ 𝒜₀ 1)
        (u_raw : ∀ j k : Fin (N₀ + 1),
          ↑((AlgebraicGeometry.Proj 𝒜₀).presheaf.obj
            (Opposite.op (AlgebraicGeometry.Proj.basicOpen 𝒜₀ (X_var j * X_var k)))))
        (_hu_raw : ∀ j k : Fin (N₀ + 1),
          u_raw j k =
            (AlgebraicGeometry.Proj.awayToSection 𝒜₀ (X_var j * X_var k)).hom
              (HomogeneousLocalization.Away.mk 𝒜₀ (SetLike.mul_mem_graded (hj j) (hj k)) 1
                (X_var j ^ 2) ((one_nsmul 2).symm ▸ SetLike.pow_mem_graded 2 (hj j)))),
        let P₀ := AlgebraicGeometry.Proj 𝒜₀
        let W₀ : Fin (N₀ + 1) → P₀.Opens :=
          fun k => AlgebraicGeometry.Proj.basicOpen 𝒜₀ (X_var k)
        let u₀ : ∀ j k : Fin (N₀ + 1), ↑(P₀.presheaf.obj (Opposite.op (W₀ j ⊓ W₀ k))) :=
          fun j k =>
            (P₀.presheaf.map (CategoryTheory.homOfLE
              (le_of_eq (AlgebraicGeometry.Proj.basicOpen_mul 𝒜₀ (X_var j) (X_var k)).symm)).op).hom
              (u_raw j k)
        ∃ (t₀ : ∀ _k₀ j : Fin (N₀ + 1), ↑(P₀.presheaf.obj (Opposite.op (W₀ j)))),
          (∀ k : Fin (N₀ + 1), u₀ k k = 1) ∧
          (∀ (U : P₀.Opens) (j k : Fin (N₀ + 1)) (hUj : U ≤ W₀ j) (hUk : U ≤ W₀ k),
            (P₀.presheaf.map (CategoryTheory.homOfLE (le_inf hUj hUk)).op).hom (u₀ j k) *
              (P₀.presheaf.map (CategoryTheory.homOfLE (le_inf hUk hUj)).op).hom (u₀ k j) = 1) ∧
          (∀ (U : P₀.Opens) (i j k : Fin (N₀ + 1))
              (hUi : U ≤ W₀ i) (hUj : U ≤ W₀ j) (hUk : U ≤ W₀ k),
            (P₀.presheaf.map (CategoryTheory.homOfLE (le_inf hUi hUj)).op).hom (u₀ i j) *
              (P₀.presheaf.map (CategoryTheory.homOfLE (le_inf hUj hUk)).op).hom (u₀ j k) =
              (P₀.presheaf.map (CategoryTheory.homOfLE (le_inf hUi hUk)).op).hom (u₀ i k)) ∧
          (∀ k₀ : Fin (N₀ + 1), t₀ k₀ k₀ = 1) ∧
          (∀ (U : P₀.Opens) (k₀ j : Fin (N₀ + 1)) (hUj : U ≤ W₀ j) (hUk₀ : U ≤ W₀ k₀),
            (P₀.presheaf.map (CategoryTheory.homOfLE hUj).op).hom (t₀ k₀ j) =
              (P₀.presheaf.map (CategoryTheory.homOfLE (le_inf hUk₀ hUj)).op).hom (u₀ k₀ j)) ∧
          (∀ (U : P₀.Opens) (k₀ i j : Fin (N₀ + 1)) (hUi : U ≤ W₀ i) (hUj : U ≤ W₀ j),
            (P₀.presheaf.map (CategoryTheory.homOfLE hUi).op).hom (t₀ k₀ i) =
              (P₀.presheaf.map (CategoryTheory.homOfLE (le_inf hUj hUi)).op).hom (u₀ j i) *
                (P₀.presheaf.map (CategoryTheory.homOfLE hUj).op).hom (t₀ k₀ j)) ∧
          (∀ (k₀ j : Fin (N₀ + 1)),
            letI : Algebra ↑(P₀.presheaf.obj (Opposite.op (W₀ j)))
                ↑(P₀.presheaf.obj (Opposite.op (W₀ j ⊓ W₀ k₀))) :=
              RingHom.toAlgebra
                (P₀.presheaf.map
                  (CategoryTheory.homOfLE (inf_le_left : W₀ j ⊓ W₀ k₀ ≤ W₀ j)).op).hom
            IsLocalization.Away (t₀ k₀ j) ↑(P₀.presheaf.obj (Opposite.op (W₀ j ⊓ W₀ k₀)))) ∧
          (∀ (k₀ i j : Fin (N₀ + 1)),
            let W_ij : P₀.Opens := W₀ i ⊓ W₀ j
            letI : Algebra ↑(P₀.presheaf.obj (Opposite.op W_ij))
                ↑(P₀.presheaf.obj (Opposite.op (W_ij ⊓ W₀ k₀))) :=
              RingHom.toAlgebra
                (P₀.presheaf.map
                  (CategoryTheory.homOfLE (inf_le_left : W_ij ⊓ W₀ k₀ ≤ W_ij)).op).hom
            IsLocalization.Away
              ((P₀.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_ij ≤ W₀ i)).op).hom
                  (t₀ k₀ i) *
                (P₀.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W_ij ≤ W₀ j)).op).hom
                  (t₀ k₀ j))
              ↑(P₀.presheaf.obj (Opposite.op (W_ij ⊓ W₀ k₀)))) := by
    intro A _ σ _ _ 𝒜₀ _ N₀ X_var hj u_raw hu_raw
    dsimp only
    let P₀ := AlgebraicGeometry.Proj 𝒜₀
    let W₀ : Fin (N₀ + 1) → P₀.Opens :=
      fun k => AlgebraicGeometry.Proj.basicOpen 𝒜₀ (X_var k)
    let u₀ : ∀ j k : Fin (N₀ + 1), ↑(P₀.presheaf.obj (Opposite.op (W₀ j ⊓ W₀ k))) :=
      fun j k =>
        (P₀.presheaf.map (CategoryTheory.homOfLE
          (le_of_eq (AlgebraicGeometry.Proj.basicOpen_mul 𝒜₀ (X_var j) (X_var k)).symm)).op).hom
