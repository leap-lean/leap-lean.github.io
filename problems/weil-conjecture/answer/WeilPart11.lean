        φ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso R₂).inv := by
    intro R₁ R₂ φ
    rw [← cancel_mono (AlgebraicGeometry.Scheme.ΓSpecIso R₂).hom,
      CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, Iso.inv_hom_id,
