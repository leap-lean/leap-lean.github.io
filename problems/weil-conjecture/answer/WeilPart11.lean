        refine ⟨z_P, PrimeSpectrum.ext ?_⟩
        have hzP_cl : IsClosed ({U_f.ι.base z_P} : Set E_sm) := by rwa [hz_P]
        obtain ⟨_, _, _, hiff_zP⟩ := (hBase_ideal z_P).2 hzP_cl
        ext b
        rw [hiff_zP b, hz_P, ← hP_iff b]
  have hClMap_base : IsClosedMap π_f.base := by
    intro Z hZ_cl
    by_cases hZ_univ : Z = Set.univ
    · rw [hZ_univ, Set.image_univ_of_surjective hBij_base.2]
