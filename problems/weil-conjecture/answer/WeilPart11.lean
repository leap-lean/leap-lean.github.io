        have _ : Module.Finite R ↥(LinearMap.range h) :=
          Module.Finite.iff_fg.mpr (hNoethD.noetherian (LinearMap.range h))
        have _ : Module.Finite R (B ⧸ LinearMap.ker h) :=
          Module.Finite.equiv (LinearMap.quotKerEquivRange h).symm
        have _ : Module.Finite R ↥(LinearMap.range f) := Module.Finite.range f
        have hNoethRangeF : IsNoetherian R ↥(LinearMap.range f) :=
          isNoetherian_of_isNoetherianRing_of_finite R ↥(LinearMap.range f)
