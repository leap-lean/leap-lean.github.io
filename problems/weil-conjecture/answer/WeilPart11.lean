            ∀ (M₂' : WeilLineBundle C₂') (eIdx₂' : Fin M₂'.m ≃ Fin M₂.m),
              (∀ b : Fin M₂'.m,
                M₂'.V b = (TopologicalSpace.Opens.map fst₂'.base).obj (M₂.V (eIdx₂' b))) →
              (∀ b b' : Fin M₂'.m,
                ∀ hEq : M₂'.V b ⊓ M₂'.V b' =
                    (TopologicalSpace.Opens.map fst₂'.base).obj
                      (M₂.V (eIdx₂' b) ⊓ M₂.V (eIdx₂' b')),
                  (C₂'.presheaf.map (CategoryTheory.homOfLE (le_of_eq hEq.symm)).op).hom
                      (M₂'.u b b').val =
                    (fst₂'.app (M₂.V (eIdx₂' b) ⊓ M₂.V (eIdx₂' b'))).hom
                      (M₂.u (eIdx₂' b) (eIdx₂' b')).val) →
              ∀ (w₁ : C₁_L ⟶ C₁') (w₂ : CategoryTheory.Limits.pullback g₂ η_L ⟶ C₂'),
