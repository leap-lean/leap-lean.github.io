        (n : ℕ) (a : A) (ha : a ∈ 𝒜₀ (n • d)),
        a = f ^ n →
        HomogeneousLocalization.Away.mk 𝒜₀ hf n a ha = 1 := by
      intro d f hf n a ha h_eq
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one, h_eq]
      exact Localization.mk_self (⟨f ^ n, n, rfl⟩ : Submonoid.powers f)
    have away_mk_mul : ∀ {d : ℕ} {f : A} (hf : f ∈ 𝒜₀ d)
        (n₁ n₂ : ℕ) (a₁ : A) (ha₁ : a₁ ∈ 𝒜₀ (n₁ • d))
        (a₂ : A) (ha₂ : a₂ ∈ 𝒜₀ (n₂ • d))
        (ha₁₂ : a₁ * a₂ ∈ 𝒜₀ ((n₁ + n₂) • d)),
        HomogeneousLocalization.Away.mk 𝒜₀ hf n₁ a₁ ha₁ *
          HomogeneousLocalization.Away.mk 𝒜₀ hf n₂ a₂ ha₂ =
          HomogeneousLocalization.Away.mk 𝒜₀ hf (n₁ + n₂) (a₁ * a₂) ha₁₂ := by
      intro d f hf n₁ n₂ a₁ ha₁ a₂ ha₂ ha₁₂
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul]
      refine Localization.mk_eq_mk_iff.mpr (Localization.r_iff_exists.mpr ⟨1, ?_⟩)
      simp only [Submonoid.coe_one, Submonoid.coe_mul, one_mul, pow_add]
