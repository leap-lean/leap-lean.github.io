      rw [hMapComp _ _ (le_refl _), hMapId _ (le_refl _)]
    
    refine ⟨hB1, hB2, hB3, ?_⟩
    let C_Y : ℕ → Type u :=
      fun q => ∀ α : WeilStrictMonoTuple r q, ↑(Y.presheaf.obj (Opposite.op (weilCoverChartInter U α)))
    let faceOf : ∀ {q : ℕ}, WeilStrictMonoTuple r (q + 1) → Fin (q + 2) → WeilStrictMonoTuple r q :=
      fun {_} β j => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
    let hFaceOf : ∀ {q : ℕ} (β : WeilStrictMonoTuple r (q + 1)) (j : Fin (q + 2)),
        weilCoverChartInter U β ≤ weilCoverChartInter U (faceOf β j) :=
      fun {_} _ j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
    let d_Y : ∀ (q : ℕ), C_Y q → C_Y (q + 1) :=
      fun q c β => ∑ j : Fin (q + 2), (-1) ^ (j : ℕ) *
        (Y.presheaf.map (CategoryTheory.homOfLE (hFaceOf β j)).op).hom (c (faceOf β j))
    let toCY : ∀ (q : ℕ), WeilModuleCechCochain U O_Y q → C_Y q :=
      fun _ c α => e_Y _ (c α)
    let fromCY : ∀ (q : ℕ), C_Y q → WeilModuleCechCochain U O_Y q :=
      fun _ c α => (e_Y _).symm (c α)
    have hToFrom : ∀ q c, toCY q (fromCY q c) = c :=
      fun _ c => funext fun α => (e_Y _).apply_symm_apply (c α)
    have hFromTo : ∀ q c, fromCY q (toCY q c) = c :=
      fun _ c => funext fun α => (e_Y _).symm_apply_apply (c α)
    have hToZero : ∀ q, toCY q 0 = 0 :=
      fun _ => funext fun _ => map_zero (e_Y _)
    have hToDiff : ∀ q c, toCY (q + 1) (weilModuleCechDiff U O_Y q c) = d_Y q (toCY q c) := by
      intro q c
      funext β
      change e_Y _ (∑ j : Fin (q + 2), ((-1 : ℤ) ^ (j : ℕ)) • O_Y.res (hFaceOf β j) (c (faceOf β j))) =
        ∑ j : Fin (q + 2), _
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_zsmul, he_Y, zsmul_eq_mul, Int.cast_pow, Int.cast_neg, Int.cast_one]
    have hInterLeW : ∀ {q : ℕ} (τ : WeilStrictMonoTuple r q), weilCoverChartInter U τ ≤ W :=
      fun τ => le_trans (Finset.inf'_le _ (Finset.mem_univ 0)) (hU_le (τ.1 0))
    have hAffInter : ∀ (q : ℕ) (τ : WeilStrictMonoTuple r q),
        AlgebraicGeometry.IsAffineOpen (weilCoverChartInter U τ) :=
      fun q τ => Finset.inf'_induction
        ⟨0, Finset.mem_univ (0 : Fin (q + 1))⟩
        (fun k => U (τ.1 k))
        (fun _ h₁ _ h₂ => h₁.inf h₂)
        (fun k _ => hAffU (τ.1 k))
    
    let A := ↑(Y.presheaf.obj (Opposite.op W))
    have hPOU : ∃ f : Fin r → A,
        (∀ a : Fin r, Y.basicOpen (f a) ≤ U a) ∧
        (∀ K : ℕ, ∃ h : Fin r → A, ∑ a : Fin r, h a * (f a) ^ K = 1) := by
      let I : Fin r → Ideal A := fun a =>
        { carrier := { x : A | Y.basicOpen x ≤ U a }
          zero_mem' := by
            change Y.basicOpen (0 : A) ≤ U a
            rw [Y.basicOpen_zero]
            exact bot_le
          add_mem' := fun {x y} hx hy => (Y.basicOpen_add_le x y).trans (sup_le hx hy)
          smul_mem' := fun c {x} hx => by
            change Y.basicOpen (c * x) ≤ U a
            rw [Y.basicOpen_mul]
            exact inf_le_right.trans hx }
      let S : Set A := ⋃ a : Fin r, (I a : Set A)
      have hWLe : W ≤ ⨆ x : S, Y.basicOpen (x : A) := by
        intro pt hptW
        have hptCov : pt ∈ (⨆ a : Fin r, U a) := hCov.symm ▸ hptW
        obtain ⟨a, hpta⟩ := TopologicalSpace.Opens.mem_iSup.mp hptCov
        obtain ⟨g, hg_le, hptg⟩ := hW.exists_basicOpen_le (⟨pt, hpta⟩ : ↥(U a)) hptW
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨g, Set.mem_iUnion.mpr ⟨a, hg_le⟩⟩, hptg⟩
      have hSpanS : Ideal.span S = (⊤ : Ideal A) :=
        (hW.self_le_iSup_basicOpen_iff (s := S)).mp hWLe
      have hSpanLe : Ideal.span S ≤ ⨆ a ∈ (Finset.univ : Finset (Fin r)), I a := by
        refine Ideal.span_le.mpr fun x hx => ?_
        obtain ⟨a, hxa⟩ := Set.mem_iUnion.mp hx
        exact SetLike.le_def.mp (le_iSup₂_of_le a (Finset.mem_univ a) (le_refl (I a))) hxa
      have hOneMem : (1 : A) ∈ ⨆ a ∈ (Finset.univ : Finset (Fin r)), I a :=
        hSpanLe (by rw [hSpanS]; trivial)
      obtain ⟨μ, hμ⟩ := (Submodule.mem_iSup_finset_iff_exists_sum I (1 : A)).mp hOneMem
      let f : Fin r → A := fun a => (μ a).1
      refine ⟨f, fun a => (μ a).2, fun K => ?_⟩
      have hf_span : Ideal.span (Set.range f) = (⊤ : Ideal A) := by
        rw [Ideal.eq_top_iff_one]
        exact (Submodule.mem_span_range_iff_exists_fun A).mpr
          ⟨fun _ => 1, by simp only [one_smul, f]; exact hμ⟩
      have hPowTop : Ideal.span (Set.range (fun a : Fin r => (f a) ^ K)) = (⊤ : Ideal A) := by
        have h1 := Ideal.span_pow_eq_top (Set.range f) hf_span K
        rwa [← Set.range_comp] at h1
      have hOnePow : (1 : A) ∈ Ideal.span (Set.range (fun a : Fin r => (f a) ^ K)) := by
        rw [hPowTop]; trivial
      obtain ⟨h, hh⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hOnePow
      exact ⟨h, by simpa only [smul_eq_mul] using hh⟩
    
    let embTuple : ∀ {q : ℕ} (S : Finset (Fin r)), S.card = q + 1 → WeilStrictMonoTuple r q :=
      fun S hS => ⟨fun k => S.orderEmbOfFin hS k, (S.orderEmbOfFin hS).strictMono⟩
    have hEmbUnique : ∀ {q : ℕ} (τ : WeilStrictMonoTuple r q) (S : Finset (Fin r))
        (hS : S.card = q + 1), (∀ k : Fin (q + 1), τ.1 k ∈ S) → τ = embTuple S hS :=
      fun τ S hS hmem => Subtype.ext (Finset.orderEmbOfFin_unique hS hmem τ.2)
    have hImgCard : ∀ {q : ℕ} (τ : WeilStrictMonoTuple r q),
        (Finset.univ.image τ.1).card = q + 1 := by
      intro q τ
      rw [Finset.card_image_of_injective _ τ.2.injective, Finset.card_fin]
    have hEmbImg : ∀ {q : ℕ} (S : Finset (Fin r)) (hS : S.card = q + 1),
        Finset.univ.image (embTuple S hS).1 = S := by
      intro q S hS
      apply Finset.eq_of_subset_of_card_le
        (Finset.image_subset_iff.mpr fun k _ => Finset.orderEmbOfFin_mem S hS k)
      rw [hImgCard (embTuple S hS), hS]
    have hFaceImg : ∀ {q : ℕ} (τ : WeilStrictMonoTuple r (q + 1)) (j : Fin (q + 2)),
        Finset.univ.image (faceOf τ j).1 = (Finset.univ.image τ.1).erase (τ.1 j) := by
      intro q τ j
      ext x
      simp only [Finset.mem_image, Finset.mem_univ, true_and, Finset.mem_erase, ne_eq]
      constructor
      · rintro ⟨k, rfl⟩
        exact ⟨τ.2.injective.ne (Fin.succAbove_ne j k), j.succAbove k, rfl⟩
      · rintro ⟨hne, m, rfl⟩
        have hm : m ≠ j := fun h => hne (congrArg τ.1 h)
        obtain ⟨k, rfl⟩ := Fin.exists_succAbove_eq hm
        exact ⟨k, rfl⟩
    have hInterInsLe : ∀ {q : ℕ} (lam : Fin r) (τ : WeilStrictMonoTuple r q)
        (β : WeilStrictMonoTuple r (q + 1)),
        (∀ k : Fin (q + 2), β.1 k ∈ insert lam (Finset.univ.image τ.1)) →
        U lam ⊓ weilCoverChartInter U τ ≤ weilCoverChartInter U β := by
      intro q lam τ β hmem
      refine Finset.le_inf' _ _ fun k _ => ?_
      rcases Finset.mem_insert.mp (hmem k) with hlam | hτ
      · rw [hlam]; exact inf_le_left
      · rcases Finset.mem_image.mp hτ with ⟨i, _, hi⟩
        rw [← hi]; exact inf_le_right.trans (Finset.inf'_le _ (Finset.mem_univ i))
    have hEvalCongr : ∀ {q : ℕ} (c : C_Y q) {V₀ : Y.Opens}
        {τ₁ τ₂ : WeilStrictMonoTuple r q} (hEq : τ₁ = τ₂)
        (h₁ : V₀ ≤ weilCoverChartInter U τ₁) (h₂ : V₀ ≤ weilCoverChartInter U τ₂),
