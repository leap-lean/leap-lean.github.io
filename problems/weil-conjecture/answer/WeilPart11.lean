  have hPart2 : Function.Injective j.base ∧ AlgebraicGeometry.IsFinite j := by
    have _ : AlgebraicGeometry.IsProper j₀ :=
      CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance hProp_j
    have hClosed_j₀ : IsClosedMap j₀.base := j₀.isClosedMap
    have hFromSpec_appLE : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
