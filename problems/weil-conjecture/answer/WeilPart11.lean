        rw [hxk]
        exact A₀.mul_mem (A₀.algebraMap_mem _) (A₀.pow_mem hx_A₀ k.toNat)
      · have hzero : f_k k = 0 := hlam_E0 ℓ _ _ (hShift0 (-k - 1) v (by omega) hv0)
        rw [hzero, map_zero, zero_mul]
        exact A₀.zero_mem
    · intro v hv_inf
      have hv : v ∈ E₀_inf := hEinf_le hv_inf
      rw [heTr_symm (Φ_of ℓ) v, hΦ_of_eq ℓ v hv]
      let f_k : ℤ → Ω := fun k => lam_of ℓ ⟨x ^ (-k - 1) * v, hShift (-k - 1) v hv⟩
      have hSupp : Function.support (fun k : ℤ => algebraMap Ω F (f_k k) * x ^ k) ⊆
          ↑(hlam_fin ℓ v hv).toFinset := by
        intro k hk
        rw [Finset.mem_coe, Set.Finite.mem_toFinset, Function.mem_support]
        rw [Function.mem_support] at hk
        intro h0
        change f_k k = 0 at h0
        apply hk
        rw [h0, map_zero, zero_mul]
      rw [finsum_eq_sum_of_support_subset _ hSupp, Finset.mul_sum]
      refine A_inf.sum_mem ?_
      intro k _
      by_cases hk_le : k ≤ -2
      · let n : ℕ := (-k - 2).toNat
        have hx_term : x ^ 2 * (algebraMap Ω F (f_k k) * x ^ k) =
            algebraMap Ω F (f_k k) * (x⁻¹) ^ n := by
          have hzpow : x ^ (2 : ℤ) * x ^ k = (x⁻¹) ^ (n : ℤ) := by
            rw [← zpow_add₀ hx_ne, inv_zpow, ← zpow_neg]
            congr 1
            dsimp only [n]
            omega
          calc x ^ 2 * (algebraMap Ω F (f_k k) * x ^ k)
              = algebraMap Ω F (f_k k) * (x ^ (2 : ℤ) * x ^ k) := by
                  have hx2 : x ^ (2 : ℤ) = x ^ 2 := by norm_cast
                  rw [hx2]; ring
            _ = algebraMap Ω F (f_k k) * (x⁻¹) ^ (n : ℤ) := by rw [hzpow]
            _ = algebraMap Ω F (f_k k) * (x⁻¹) ^ n := by rw [zpow_natCast]
        rw [hx_term]
        exact A_inf.mul_mem (A_inf.algebraMap_mem _) (A_inf.pow_mem hx_inv_Ainf n)
      · have hzero : f_k k = 0 := hlam_Einf ℓ _ _ (hShiftInf (-k - 1) v (by omega) hv_inf)
        rw [hzero, map_zero, zero_mul, mul_zero]
        exact A_inf.zero_mem
  let fwd : Module.Dual Ω (↥E₀_inf ⧸ S_0inf) → ↥W_dual :=
    fun ℓ => ⟨eTr.symm (Φ_of ℓ), hw_mem ℓ⟩
  have h_bwd_fwd : ∀ ℓ : Module.Dual Ω (↥E₀_inf ⧸ S_0inf), bwd (fwd ℓ) = ℓ := by
    intro ℓ
    apply LinearMap.ext
    intro q
    refine Submodule.Quotient.induction_on S_0inf q fun v => ?_
    change (S_0inf.liftQ (β_tilde (fwd ℓ)) (hβ_ker (fwd ℓ))) (Submodule.Quotient.mk v) =
      ℓ (Submodule.Quotient.mk v)
    rw [Submodule.liftQ_apply]
    change res ((Algebra.trace ↥K₀ F (eTr.symm (Φ_of ℓ) * v.1) : ↥K₀) : F) =
      ℓ (S_0inf.mkQ v)
    rw [heTr_symm (Φ_of ℓ) v.1, hΦ_of_eq ℓ v.1 v.2]
    let f_k : ℤ → Ω := fun k => lam_of ℓ ⟨x ^ (-k - 1) * v.1, hShift (-k - 1) v.1 v.2⟩
    let S_f : Finset ℤ := (hlam_fin ℓ v.1 v.2).toFinset
    have hSupp : Function.support (fun k : ℤ => algebraMap Ω F (f_k k) * x ^ k) ⊆ ↑S_f := by
      intro k hk
      rw [Finset.mem_coe, Set.Finite.mem_toFinset, Function.mem_support]
      rw [Function.mem_support] at hk
      intro h0
      change f_k k = 0 at h0
      apply hk
      rw [h0, map_zero, zero_mul]
    rw [finsum_eq_sum_of_support_subset _ hSupp, map_sum]
    have hterm_res : ∀ k : ℤ, res (algebraMap Ω F (f_k k) * x ^ k) =
        if k = -1 then f_k k else 0 := fun k => hres_mon (f_k k) k
    simp_rw [hterm_res]
    have hf_neg1 : f_k (-1) = ℓ (S_0inf.mkQ v) := by
      dsimp only [f_k, lam_of]
      have hx_val : x ^ (-(-1 : ℤ) - 1) * v.1 = v.1 := by
        have h0 : (-(-1 : ℤ) - 1) = 0 := by omega
        rw [h0, zpow_zero, one_mul]
      have hsub : (⟨x ^ (-(-1 : ℤ) - 1) * v.1, hShift (-(-1 : ℤ) - 1) v.1 v.2⟩ : ↥E₀_inf) = v :=
        Subtype.ext hx_val
      rw [hsub]
      rfl
    by_cases hmem : (-1 : ℤ) ∈ S_f
    · rw [← Finset.add_sum_erase _ _ hmem, if_pos rfl]
      have hrest : (∑ k ∈ S_f.erase (-1), if k = -1 then f_k k else 0) = 0 := by
        refine Finset.sum_eq_zero ?_
        intro k hk
        rw [if_neg (Finset.ne_of_mem_erase hk)]
      rw [hrest, add_zero, hf_neg1]
    · have hall0 : (∑ k ∈ S_f, if k = -1 then f_k k else 0) = 0 := by
        refine Finset.sum_eq_zero ?_
        intro k hk
        rw [if_neg (fun hEq : k = -1 => hmem (hEq ▸ hk))]
      have hf0 : f_k (-1) = 0 := by
        by_contra hne
        exact hmem ((hlam_fin ℓ v.1 v.2).mem_toFinset.mpr (Function.mem_support.mpr hne))
      rw [hall0, ← hf_neg1, hf0]
  have h_fwd_bwd : ∀ w : ↥W_dual, fwd (bwd w) = w := by
    intro w
    let ℓ := bwd w
    let Ψ_w : F →ₗ[↥K₀] ↥K₀ := eTr w.1
    have hΨ_apply : ∀ u : F, Ψ_w u = Algebra.trace ↥K₀ F (w.1 * u) := by
      intro u
      dsimp only [Ψ_w, eTr]
      rw [LinearMap.BilinForm.toDual_def, Algebra.traceForm_apply]
    have hΨ_eq_Φ : ∀ v ∈ E₀_inf, Ψ_w v = Φ_of ℓ v := by
      intro v hv
      ext
      obtain ⟨N₁, _, hN₁, _⟩ := hTrunc v hv
      have hxN_v : x ^ N₁ * v ∈ E₀ := by
        rw [← zpow_natCast]
        exact hN₁ (N₁ : ℤ) le_rfl
      have hNh_A₀ : x ^ N₁ * ((Ψ_w v : ↥K₀) : F) ∈ A₀ := by
        rw [hΨ_apply v, ← hTrace_smul_K₀ (x ^ N₁) (K₀.toSubalgebra.pow_mem hx_K₀ N₁) w.1 v]
        exact ((hW_dual w.1).mp w.2).1 (x ^ N₁ * v) hxN_v
      have hRecon := (hres_sum ((Ψ_w v : ↥K₀) : F) ⟨N₁, hNh_A₀⟩).2
      rw [hΦ_of_eq ℓ v hv, ← hRecon]
      congr 1
      funext k
      have hlam_k : lam_of ℓ ⟨x ^ (-k - 1) * v, hShift (-k - 1) v hv⟩ =
          res (x ^ (-k - 1) * ((Ψ_w v : ↥K₀) : F)) := by
        change (S_0inf.liftQ (β_tilde w) (hβ_ker w))
          (Submodule.Quotient.mk ⟨x ^ (-k - 1) * v, hShift (-k - 1) v hv⟩) = _
        rw [Submodule.liftQ_apply]
        change res ((Algebra.trace ↥K₀ F (w.1 * (x ^ (-k - 1) * v)) : ↥K₀) : F) = _
        rw [hTrace_smul_K₀ (x ^ (-k - 1)) (K₀.pow_mem hx_K₀ (-k - 1)) w.1 v, hΨ_apply v]
      rw [hlam_k]
    have hΨ_eq : Ψ_w = Φ_of ℓ := hΦ_of_uniq ℓ Ψ_w hΨ_eq_Φ
    ext
    change eTr.symm (Φ_of ℓ) = w.1
    rw [← hΨ_eq]
    exact eTr.symm_apply_apply w.1
  exact ⟨({ toLinearMap := bwd
            invFun := fwd
            left_inv := h_fwd_bwd
            right_inv := h_bwd_fwd } : ↥W_dual ≃ₗ[Ω]
              Module.Dual Ω (↥E₀_inf ⧸ S_0inf)).symm⟩

theorem weil_dedekind_chart_fiber_crt_and_semilocal_reduction (Ω X F : Type u) [Field Ω] [IsAlgClosed Ω] [Field F] [Algebra Ω F]
    (IsPlace : X → Prop) (ord : X → F → WithTop ℤ)
    (hVal : IsCurvePlaceValuation Ω X F IsPlace ord)
    (t : F) (hChart : IsDedekindChartForCoord Ω X F IsPlace ord t)
    (K₀ : IntermediateField Ω F) (hK₀ : K₀ = IntermediateField.adjoin Ω ({t} : Set F))
    [FiniteDimensional ↥K₀ F] [Algebra.IsSeparable ↥K₀ F]
    (D : X → ℤ) (hD_fin : {P : X | D P ≠ 0}.Finite) :
    (∀ h : ↥K₀, (h : F) ∈ Algebra.adjoin Ω ({t} : Set F) ↔
      ∀ c : Ω, (h : F) ∈ weilRatLocalSet Ω F t c) ∧
    (∀ P : X, IsPlace P → (0 : WithTop ℤ) ≤ ord P t →
      ∃ c : Ω, (1 : WithTop ℤ) ≤ ord P (t - algebraMap Ω F c)) ∧
    ∀ c : Ω,
      let R_c := weilRatLocalSet Ω F t c
      let M_c := weilSemilocalIntSet Ω X F IsPlace ord t c
      let E_t := {v : F | ∀ P : X, IsPlace P → (0 : WithTop ℤ) ≤ ord P t →
        (-(D P) : WithTop ℤ) ≤ ord P v}
      ∃ (r : ℕ) (P_br : Fin r → X) (e_br : Fin r → ℕ) (c_br : Fin r → Ω)
        (s_gen : Finset F) (u_D z : F),
        1 ≤ r ∧
        Function.Injective P_br ∧
        Set.range P_br = {P : X | IsPlace P ∧ (1 : WithTop ℤ) ≤ ord P (t - algebraMap Ω F c)} ∧
        (∀ k : Fin r, 1 ≤ e_br k ∧ ord (P_br k) (t - algebraMap Ω F c) = (e_br k : WithTop ℤ)) ∧
        Function.Injective c_br ∧
        (↑s_gen : Set F) ⊆ M_c ∧
        (∀ v ∈ M_c, ∃ coeff : F → F,
          (∀ g ∈ s_gen, coeff g ∈ R_c) ∧ v = ∑ g ∈ s_gen, coeff g * g) ∧
        (∀ u : F, ∃ a : Polynomial Ω, a ≠ 0 ∧ Polynomial.aeval t a * u ∈ M_c) ∧
        u_D ≠ 0 ∧
        (∀ k : Fin r, ord (P_br k) u_D = (-(D (P_br k)) : WithTop ℤ)) ∧
        (∀ w : F,
          (∀ v ∈ E_t, ((Algebra.trace ↥K₀ F (w * v) : ↥K₀) : F) ∈ R_c) ↔
          (∀ b ∈ M_c, ((Algebra.trace ↥K₀ F ((w * u_D) * b) : ↥K₀) : F) ∈ R_c)) ∧
        z ∈ M_c ∧
        IsIntegral ↥K₀ z ∧
        (∀ k : Fin r, ord (P_br k) (z - algebraMap Ω F (c_br k)) = (1 : WithTop ℤ)) :=
by
  classical
  let At : Subalgebra Ω F := Algebra.adjoin Ω ({t} : Set F)
  let Bt : Subalgebra ↥At F := integralClosure (↥At) F
  let Lt : IntermediateField Ω F := IntermediateField.adjoin Ω ({t} : Set F)
  have hinj_t : Function.Injective (Polynomial.aeval t : Polynomial Ω →ₐ[Ω] F) :=
    transcendental_iff_injective.mp hChart.1
  have hAt_iff : ∀ u : F, u ∈ At ↔ ∃ P : Polynomial Ω, Polynomial.aeval t P = u := by
    intro u
    change u ∈ Algebra.adjoin Ω ({t} : Set F) ↔ _
    rw [Algebra.adjoin_singleton_eq_range_aeval]
    exact (Polynomial.aeval t : Polynomial Ω →ₐ[Ω] F).mem_range
  have hCoeNeg : ∀ m : ℤ, (-(m : WithTop ℤ)) = ((-m : ℤ) : WithTop ℤ) := fun _ => rfl
  
  have hOrd0 : ∀ P : X, IsPlace P → ord P 0 = ⊤ :=
    fun P hP => ((hVal.1 P hP).1 0).mpr rfl
  have hOrd1 : ∀ P : X, IsPlace P → ord P 1 = (0 : WithTop ℤ) := by
    intro P hP
    have h1 : (1 : F) = algebraMap Ω F 1 := (map_one (algebraMap Ω F)).symm
    rw [h1]
    exact (hVal.1 P hP).2.2.2.1 1 one_ne_zero
  have hOrdNeg1 : ∀ P : X, IsPlace P → ord P (-1) = (0 : WithTop ℤ) := by
    intro P hP
    have hm1 : (-1 : F) = algebraMap Ω F (-1) := by rw [map_neg, map_one]
    rw [hm1]
    exact (hVal.1 P hP).2.2.2.1 (-1) (neg_ne_zero.mpr one_ne_zero)
  have hOrdNeg : ∀ P : X, IsPlace P → ∀ x : F, ord P (-x) = ord P x := by
    intro P hP x
    have hEq : -x = (-1) * x := by ring
    rw [hEq, (hVal.1 P hP).2.1, hOrdNeg1 P hP, zero_add]
  have hOrdSub : ∀ P : X, IsPlace P → ∀ x y : F, min (ord P x) (ord P y) ≤ ord P (x - y) := by
    intro P hP x y
    rw [sub_eq_add_neg, ← hOrdNeg P hP y]
    exact (hVal.1 P hP).2.2.1 x (-y)
  have hOrdAlgNonneg : ∀ P : X, IsPlace P → ∀ α : Ω, (0 : WithTop ℤ) ≤ ord P (algebraMap Ω F α) := by
    intro P hP α
    by_cases hα : α = 0
    · rw [hα, map_zero, hOrd0 P hP]
      exact le_top
    · rw [(hVal.1 P hP).2.2.2.1 α hα]
  have hOrdAddLt : ∀ P : X, IsPlace P → ∀ x y : F, ord P x < ord P y → ord P (x + y) = ord P x := by
    intro P hP x y hlt
    have hle : ord P x ≤ ord P (x + y) := by
      have hmin : min (ord P x) (ord P y) = ord P x := min_eq_left (le_of_lt hlt)
      rw [← hmin]
      exact (hVal.1 P hP).2.2.1 x y
    apply le_antisymm _ hle
    by_contra hnot
    have hgt : ord P x < ord P (x + y) := lt_of_not_ge hnot
    have hsub : min (ord P (x + y)) (ord P y) ≤ ord P x := by
      have hEq : x = (x + y) - y := by ring
      conv_rhs => rw [hEq]
      exact hOrdSub P hP (x + y) y
    exact not_le_of_gt (lt_min hgt hlt) hsub
  have hOrdCoordNonneg : ∀ (α : Ω) (P : X),
      IsPlace P → (1 : WithTop ℤ) ≤ ord P (t - algebraMap Ω F α) → (0 : WithTop ℤ) ≤ ord P t := by
    intro α P hP htc
    have hEq : t = (t - algebraMap Ω F α) + algebraMap Ω F α := (sub_add_cancel t _).symm
    rw [hEq]
    refine le_trans ?_ ((hVal.1 P hP).2.2.1 _ _)
    exact le_min (le_trans (WithTop.coe_le_coe.mpr (by omega : (0 : ℤ) ≤ 1)) htc)
      (hOrdAlgNonneg P hP α)
  have hOrdShiftNonneg : ∀ (α : Ω) (P : X),
      IsPlace P → (0 : WithTop ℤ) ≤ ord P t → (0 : WithTop ℤ) ≤ ord P (t - algebraMap Ω F α) := by
    intro α P hP ht
    exact le_trans (le_min ht (hOrdAlgNonneg P hP α)) (hOrdSub P hP t (algebraMap Ω F α))
  have hOrdInt : ∀ P : X, IsPlace P → ∀ x : F, x ≠ 0 → ∃ m : ℤ, ord P x = (m : WithTop ℤ) := by
    intro P hP x hx
    have hne : ord P x ≠ ⊤ := mt ((hVal.1 P hP).1 x).mp hx
    obtain ⟨m, hm⟩ := WithTop.ne_top_iff_exists.mp hne
    exact ⟨m, hm.symm⟩
  have hOrdInv : ∀ P : X, IsPlace P → ∀ (x : F) (m : ℤ),
      x ≠ 0 → ord P x = (m : WithTop ℤ) → ord P x⁻¹ = ((-m : ℤ) : WithTop ℤ) := by
    intro P hP x m hx hxm
    obtain ⟨m', hm'⟩ := hOrdInt P hP x⁻¹ (inv_ne_zero hx)
    have hprod := (hVal.1 P hP).2.1 x x⁻¹
    rw [mul_inv_cancel₀ hx, hOrd1 P hP, hxm, hm', ← WithTop.coe_add, ← WithTop.coe_zero,
      WithTop.coe_inj] at hprod
    have hm_eq : m' = -m := by omega
    rw [hm', hm_eq]
  have hOrdPowEq : ∀ P : X, IsPlace P → ∀ (x : F) (m : ℤ) (n : ℕ),
      ord P x = (m : WithTop ℤ) → ord P (x ^ n) = (((n : ℤ) * m : ℤ) : WithTop ℤ) := by
    intro P hP x m n hxm
    induction n with
    | zero =>
      simp [hOrd1 P hP]
    | succ n ih =>
      rw [pow_succ, (hVal.1 P hP).2.1, ih, hxm, ← WithTop.coe_add]
      congr 1
      push_cast
      ring
  have hOrdZpowEq : ∀ P : X, IsPlace P → ∀ (x : F) (m k : ℤ),
      x ≠ 0 → ord P x = (m : WithTop ℤ) → ord P (x ^ k) = ((k * m : ℤ) : WithTop ℤ) := by
    intro P hP x m k hx hxm
    cases k with
    | ofNat n =>
      rw [Int.ofNat_eq_natCast, zpow_natCast]
      exact hOrdPowEq P hP x m n hxm
    | negSucc n =>
      rw [zpow_negSucc]
      have hxn_ne : x ^ (n + 1) ≠ 0 := pow_ne_zero (n + 1) hx
      have hxn_ord := hOrdPowEq P hP x m (n + 1) hxm
      rw [hOrdInv P hP (x ^ (n + 1)) (((n + 1 : ℕ) : ℤ) * m) hxn_ne hxn_ord]
      congr 1
      push_cast [Int.negSucc_eq]
      ring
  have hOrdPowNonneg : ∀ P : X, IsPlace P → ∀ (x : F) (n : ℕ),
      (0 : WithTop ℤ) ≤ ord P x → (0 : WithTop ℤ) ≤ ord P (x ^ n) := by
    intro P hP x n hx
    induction n with
    | zero => rw [pow_zero, hOrd1 P hP]
    | succ n ih =>
      rw [pow_succ, (hVal.1 P hP).2.1]
      exact add_nonneg ih hx
  have hOrdPowGe : ∀ P : X, IsPlace P → ∀ (x : F) (n : ℕ),
      (1 : WithTop ℤ) ≤ ord P x → ((n : ℤ) : WithTop ℤ) ≤ ord P (x ^ n) := by
    intro P hP x n hx
    induction n with
    | zero =>
      rw [pow_zero, hOrd1 P hP]
      rfl
    | succ n ih =>
      rw [pow_succ, (hVal.1 P hP).2.1]
      have hcast : (((n + 1 : ℕ) : ℤ) : WithTop ℤ) = ((n : ℤ) : WithTop ℤ) + (1 : WithTop ℤ) := by
        rw [← WithTop.coe_one, ← WithTop.coe_add]
        push_cast
        rfl
      rw [hcast]
      exact add_le_add ih hx
  have hOrdProdNonnegX : ∀ (s : Finset X) (f : X → F) (P : X),
      IsPlace P → (∀ i ∈ s, (0 : WithTop ℤ) ≤ ord P (f i)) →
      (0 : WithTop ℤ) ≤ ord P (∏ i ∈ s, f i) := by
    intro s f P hP hf
    induction s using Finset.induction_on with
    | empty => rw [Finset.prod_empty, hOrd1 P hP]
    | @insert a s ha ih =>
      rw [Finset.prod_insert ha, (hVal.1 P hP).2.1]
      exact add_nonneg (hf a (Finset.mem_insert_self a s))
        (ih fun i hi => hf i (Finset.mem_insert_of_mem hi))
  have hOrdProdNonnegFin : ∀ {m : ℕ} (s : Finset (Fin m)) (f : Fin m → F) (P : X),
      IsPlace P → (∀ i ∈ s, (0 : WithTop ℤ) ≤ ord P (f i)) →
      (0 : WithTop ℤ) ≤ ord P (∏ i ∈ s, f i) := by
    intro m s f P hP hf
    induction s using Finset.induction_on with
    | empty => rw [Finset.prod_empty, hOrd1 P hP]
    | @insert a s ha ih =>
      rw [Finset.prod_insert ha, (hVal.1 P hP).2.1]
      exact add_nonneg (hf a (Finset.mem_insert_self a s))
        (ih fun i hi => hf i (Finset.mem_insert_of_mem hi))
  have hOrdProdZeroFin : ∀ {m : ℕ} (s : Finset (Fin m)) (f : Fin m → F) (P : X),
      IsPlace P → (∀ i ∈ s, ord P (f i) = (0 : WithTop ℤ)) →
      ord P (∏ i ∈ s, f i) = (0 : WithTop ℤ) := by
    intro m s f P hP hf
    induction s using Finset.induction_on with
    | empty => rw [Finset.prod_empty, hOrd1 P hP]
    | @insert a s ha ih =>
      rw [Finset.prod_insert ha, (hVal.1 P hP).2.1, hf a (Finset.mem_insert_self a s),
        ih fun i hi => hf i (Finset.mem_insert_of_mem hi), zero_add]
  have hOrdSumGeFin : ∀ {m : ℕ} (s : Finset (Fin m)) (f : Fin m → F) (P : X) (d : WithTop ℤ),
      IsPlace P → (∀ i ∈ s, d ≤ ord P (f i)) → d ≤ ord P (∑ i ∈ s, f i) := by
    intro m s f P d hP hf
    induction s using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty, hOrd0 P hP]
      exact le_top
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact le_trans (le_min (hf a (Finset.mem_insert_self a s))
        (ih fun i hi => hf i (Finset.mem_insert_of_mem hi))) ((hVal.1 P hP).2.2.1 _ _)
  
  have hClearBound : ∀ (c : Ω) (B_bound : X → ℤ),
      {P : X | B_bound P ≠ 0}.Finite →
      ∀ y : F,
        ∃ a : Polynomial Ω,
          a ≠ 0 ∧
          (∀ R : X, IsPlace R → (0 : WithTop ℤ) ≤ ord R t →
            (B_bound R : WithTop ℤ) ≤ ord R (Polynomial.aeval t a * y)) ∧
          ((∀ P : X, IsPlace P → (1 : WithTop ℤ) ≤ ord P (t - algebraMap Ω F c) →
              (B_bound P : WithTop ℤ) ≤ ord P y) →
            Polynomial.eval c a ≠ 0) := by
    intro c B_bound hB_fin y
    by_cases hy : y = 0
    · subst hy
      refine ⟨1, one_ne_zero, ?_, fun _ => by simp⟩
      intro R hR _
      rw [mul_zero, hOrd0 R hR]
