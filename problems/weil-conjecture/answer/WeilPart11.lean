      have hPre₁ := AlgebraicGeometry.Proj.fromOfGlobalSections_preimage_basicOpen 𝒜 F₁ hF₁ zero_lt_one hXk
      have hPre₂ := AlgebraicGeometry.Proj.fromOfGlobalSections_preimage_basicOpen 𝒜 F₂ hF₂ zero_lt_one hXk
