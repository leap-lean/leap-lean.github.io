        exact ⟨by simpa [zpow_one] using hShift 1 v hv, hϕ₀_x v hv⟩
      · intro c v hv
        exact ⟨by rw [← Algebra.smul_def]; exact E₀_inf.smul_mem c hv, hϕ₀_smul_Ω c v hv⟩
      · intro a₁ a₂ _ _ ih₁ ih₂ v hv
        obtain ⟨h₁, eq₁⟩ := ih₁ v hv
        obtain ⟨h₂, eq₂⟩ := ih₂ v hv
        have h₁₂ : (a₁ + a₂) * v ∈ E₀_inf := by
          rw [add_mul]
