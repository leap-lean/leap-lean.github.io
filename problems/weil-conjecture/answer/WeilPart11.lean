          ((LinearMap.baseChange R' (LinearMap.ker (d_S 0)).subtype).codRestrict
            (LinearMap.ker (LinearMap.baseChange R' (d_S 0))) (fun w => by
              have hw_mem : LinearMap.lTensor R' (LinearMap.ker (d_S 0)).subtype w ∈
                  LinearMap.range (LinearMap.lTensor R' (LinearMap.ker (d_S 0)).subtype) := ⟨w, rfl⟩
              rw [hRange_R', LinearMap.mem_ker] at hw_mem
              rw [LinearMap.mem_ker, LinearMap.baseChange_eq_ltensor, LinearMap.baseChange_eq_ltensor]
              exact hw_mem))
          ⟨fun x y hxy => hInj_R' (congrArg Subtype.val hxy),
           fun y => by
             have hy : y.1 ∈ LinearMap.ker (LinearMap.lTensor R' (d_S 0)) := by
               rw [LinearMap.mem_ker, ← LinearMap.baseChange_eq_ltensor]
               exact y.2
             rw [← hRange_R', LinearMap.mem_range] at hy
             obtain ⟨w, hw⟩ := hy
             refine ⟨w, Subtype.ext ?_⟩
             change LinearMap.baseChange R' (LinearMap.ker (d_S 0)).subtype w = y.1
             rwa [LinearMap.baseChange_eq_ltensor]⟩
      let e_0 : TensorProduct S R' (K_S 0) ≃ₗ[R'] TensorProduct R R' (K 0) :=
        TensorProduct.AlgebraTensorModule.cancelBaseChange R S R' R' (K 0)
      let e_1 : TensorProduct S R' (K_S 1) ≃ₗ[R'] TensorProduct R R' (K 1) :=
        TensorProduct.AlgebraTensorModule.cancelBaseChange R S R' R' (K 1)
      let E_0 : ↥(LinearMap.ker (LinearMap.baseChange R' (d_S 0))) ≃ₗ[R']
          ↥(LinearMap.ker (LinearMap.baseChange R' (d 0))) :=
        LinearEquiv.ofBijective
          ((e_0.toLinearMap.comp
            (LinearMap.ker (LinearMap.baseChange R' (d_S 0))).subtype).codRestrict
            (LinearMap.ker (LinearMap.baseChange R' (d 0))) (fun z => by
              rw [LinearMap.mem_ker]
              change LinearMap.baseChange R' (d 0) (e_0 z.1) = 0
              rw [← hCancelBC S R' 0 z.1, z.2, map_zero]))
          ⟨fun x y hxy => Subtype.ext (e_0.injective (congrArg Subtype.val hxy)),
           fun y => ⟨⟨e_0.symm y.1, by
             rw [LinearMap.mem_ker]
             apply e_1.injective
             rw [hCancelBC S R' 0, LinearEquiv.apply_symm_apply, y.2, map_zero]⟩,
             Subtype.ext (e_0.apply_symm_apply y.1)⟩⟩
      let b_R' : Module.Basis (Fin (r₀ + 1)) R' (TensorProduct S R' ↥(LinearMap.ker (d_S 0))) :=
        Module.Basis.baseChange R' b_S
      let Ψ_R' : (Fin (r₀ + 1) → R') ≃ₗ[R']
          ↥(LinearMap.ker (LinearMap.baseChange R' (d 0))) :=
        b_R'.equivFun.symm.trans (Θ_R'.trans E_0)
      have hΨ_val : ∀ c : Fin (r₀ + 1) → R',
          (Ψ_R' c).1 = ∑ i : Fin (r₀ + 1), c i • v' i := by
        intro c
        change (E_0 (Θ_R' (b_R'.equivFun.symm c))).1 = _
        rw [Module.Basis.equivFun_symm_apply, map_sum, map_sum, AddSubmonoidClass.coe_finsetSum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [LinearEquiv.map_smul, LinearEquiv.map_smul, SetLike.val_smul]
        congr 1
        dsimp only [b_R']
        rw [Module.Basis.baseChange_apply, hb_S_apply i]
        change (TensorProduct.AlgebraTensorModule.cancelBaseChange R S R' R' (K 0))
          ((1 : R') ⊗ₜ[S] ((1 : S) ⊗ₜ[R] (u i).1)) = v' i
        rw [hv'_eq i, TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul, one_smul]
      intro x hx
      obtain ⟨c, hc, huniq⟩ := Ψ_R'.bijective.existsUnique ⟨x, hx⟩
      refine ⟨c, ?_, ?_⟩
      · have h1 := congrArg Subtype.val hc
        rw [hΨ_val c] at h1
        exact h1.symm
      · intro c' hc'
        apply huniq
        apply Subtype.ext
        rw [hΨ_val c']
        exact hc'.symm
  exact ⟨h, hh, fun i => (1 : Localization.Away h) ⊗ₜ[R] (u i).1,
    hStage34 (Localization.Away h)⟩

theorem weil_proj_mvPoly_fromOfGlobalSections_functoriality_and_baseChange (r₀ : ℕ) :
    (∀ (A : Type u) [CommRing A],
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A) :=
        MvPolynomial.gradedAlgebra
      ∀ (X₁ X₂ : AlgebraicGeometry.Scheme.{u}) (φ_X : X₁ ⟶ X₂)
        (f₁ : MvPolynomial (Fin (r₀ + 1)) A →+* ↑(X₁.presheaf.obj (Opposite.op ⊤)))
        (hf₁ : Ideal.map f₁
          (HomogeneousIdeal.irrelevant
            (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) A)).toIdeal = ⊤)
        (f₂ : MvPolynomial (Fin (r₀ + 1)) A →+* ↑(X₂.presheaf.obj (Opposite.op ⊤)))
