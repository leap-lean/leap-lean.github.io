              rw [hResSmul, hx_i, heZ_smul, map_mul, ← hNatApp, hMul_smulBU]
              exact (hLiftSmulEq _ _ _ _ rfl).symm }
        else ⊥
    have hSuppFZ : IsWeilSupportedOn V F_Z S :=
      (hProperSupp S F_Z hCohFZ (fun U _ => hAnnFZ U)).1
    have hR_I : ∀ {U W : C.Opens} (hU : IsSubChartAff U) (hW : IsSubChartAff W)
        (hWU : W ≤ U) (z : F_Z.sec U),
        z ∈ N_I_aff U hU → F_Z.res hWU z ∈ N_I_aff W hW := by
      intro U W hU hW hWU z hz
      by_cases hActW : ((W : Set ↥C) ∩ (S : Set ↥C)).Nonempty
      · have hActU : ((U : Set ↥C) ∩ (S : Set ↥C)).Nonempty :=
          let ⟨y, hyW, hyS⟩ := hActW; ⟨y, hWU hyW, hyS⟩
        dsimp only [N_I_aff] at hz ⊢
        rw [dif_pos hActU] at hz
        rw [dif_pos hActW]
        intro idx
        obtain ⟨x_i, hx_i⟩ := hz idx
        refine ⟨F₀.res hWU x_i, ?_⟩
        have hSubInter : W ⊓ U_ne ≤ U ⊓ U_ne := inf_le_inf_right U_ne hWU
        rw [F₀.res_comp hWU (inf_le_left : W ⊓ U_ne ≤ W),
          ← F₀.res_comp (inf_le_left : U ⊓ U_ne ≤ U) hSubInter, hx_i,
          hSmulBU_res (hAffInter U U_ne hU.1 hActUne.1.1)
            (hAffInter W U_ne hW.1 hActUne.1.1) hSubInter,
          F₀.res_comp (inf_le_right : U ⊓ U_ne ≤ U_ne) hSubInter]
        congr 1
        rw [heZ_res hWU ((TopologicalSpace.Opens.map ι_Z.base).monotone hWU) z]
        change (Z.presheaf.map _ ≫ Z.presheaf.map _).hom (e_Z U z) =
          (Z.presheaf.map _ ≫ Z.presheaf.map _).hom (e_Z U z)
        rw [← Z.presheaf.map_comp, ← Z.presheaf.map_comp, ← op_comp, ← op_comp,
          CategoryTheory.homOfLE_comp, CategoryTheory.homOfLE_comp]
      · dsimp only [N_I_aff]
        rw [dif_neg hActW, Submodule.mem_bot]
        have hDisjW : Disjoint (W : Set ↥C) (S : Set ↥C) :=
          Set.not_nonempty_iff_eq_empty.mp hActW |> Set.disjoint_iff_inter_eq_empty.mpr
        exact hSuppFZ W hW.1 hW.2 hDisjW _
    have hClearW₀ : ∀ (U : C.Opens) (hActU : IsActive U),
        ∃ (d_A : ↑(C.presheaf.obj (Opposite.op U))) (w_U : Fin d → F₀.sec U),
          (ι_Z.app U).hom d_A ≠ 0 ∧
          ∀ idx : Fin d,
            F₀.res (inf_le_left : U ⊓ U_ne ≤ U) (w_U idx) =
              ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U ⊓ U_ne ≤ U)).op).hom d_A) •
                F₀.res (inf_le_right : U ⊓ U_ne ≤ U_ne) (w₀ idx) := by
      intro U hActU
      let W_U := U ⊓ U_ne
      have hActWU : IsActive W_U := hInterActive U U_ne hActU hActUne
      let A_U := ↑(C.presheaf.obj (Opposite.op U))
      let A_WU := ↑(C.presheaf.obj (Opposite.op W_U))
      let r_UWU : A_U →+* A_WU :=
        (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_U ≤ U)).op).hom
      letI : Algebra A_U A_WU := RingHom.toAlgebra r_UWU
      haveI : IsDomain ↑(Z.presheaf.obj (Opposite.op (U_Z_fn U))) := hDomainB U hActU
      obtain ⟨φ_UWU, hφ_UWU⟩ := hCohF₀.2 U W_U hActU.1.1 hActWU.1.1 hActU.1.2 inf_le_left
      obtain ⟨_, s_U, hsU_ne, hClearB⟩ := hBirat hActU hActWU inf_le_left
      have hEachIdx : ∀ idx : Fin d,
          ∃ (m_i : ℕ) (w_Ui : F₀.sec U),
            F₀.res (inf_le_left : W_U ≤ U) w_Ui =
              smulBU hActWU.1.1 (rZ_fn (inf_le_left : W_U ≤ U) (s_U ^ m_i))
                (F₀.res (inf_le_right : W_U ≤ U_ne) (w₀ idx)) := by
        intro idx
        have hInSpan : ∀ t : TensorProduct A_U A_WU (F₀.sec U),
            ∃ (m_t : ℕ) (w_t : F₀.sec U),
              F₀.res (inf_le_left : W_U ≤ U) w_t =
                smulBU hActWU.1.1 (rZ_fn (inf_le_left : W_U ≤ U) (s_U ^ m_t)) (φ_UWU t) := by
          intro t
          induction t using TensorProduct.induction_on with
          | zero =>
            exact ⟨0, 0, by rw [map_zero, map_zero, hSmulBU_zero]⟩
          | tmul b_W x_U =>
            obtain ⟨m_b, a_b, h_mb⟩ := hClearB ((ι_Z.app W_U).hom b_W)
            refine ⟨m_b, liftA U hActU.1.1 a_b • x_U, ?_⟩
            rw [hResSmul, hφ_UWU]
            change r_UWU (liftA U hActU.1.1 a_b) • F₀.res (inf_le_left : W_U ≤ U) x_U =
              liftA W_U hActWU.1.1 (rZ_fn (inf_le_left : W_U ≤ U) (s_U ^ m_b)) •
                (b_W • F₀.res (inf_le_left : W_U ≤ U) x_U)
            rw [← mul_smul]
            have hker : r_UWU (liftA U hActU.1.1 a_b) -
                liftA W_U hActWU.1.1 (rZ_fn (inf_le_left : W_U ≤ U) (s_U ^ m_b)) * b_W ∈
                RingHom.ker (ι_Z.app W_U).hom := by
              rw [RingHom.mem_ker, map_sub, map_mul, hNatApp, hliftA, hliftA, h_mb, sub_self]
            have hdiff := hAnnF₀ W_U _ hker (F₀.res (inf_le_left : W_U ≤ U) x_U)
            rwa [sub_smul, sub_eq_zero] at hdiff
          | add t₁ t₂ ht₁ ht₂ =>
            obtain ⟨m₁, w₁, hw₁⟩ := ht₁
            obtain ⟨m₂, w₂, hw₂⟩ := ht₂
            refine ⟨m₁ + m₂,
              liftA U hActU.1.1 (s_U ^ m₂) • w₁ + liftA U hActU.1.1 (s_U ^ m₁) • w₂, ?_⟩
            rw [map_add, map_add,
              show liftA U hActU.1.1 (s_U ^ m₂) • w₁ = smulBU hActU.1.1 (s_U ^ m₂) w₁ from rfl,
              show liftA U hActU.1.1 (s_U ^ m₁) • w₂ = smulBU hActU.1.1 (s_U ^ m₁) w₂ from rfl,
              hSmulBU_res hActU.1.1 hActWU.1.1, hSmulBU_res hActU.1.1 hActWU.1.1, hw₁, hw₂,
              ← hMul_smulBU, ← hMul_smulBU, ← map_mul, ← map_mul, ← pow_add, ← pow_add,
              add_comm m₂ m₁, ← hSmulBU_add]
        obtain ⟨m_i, w_Ui, hw_Ui⟩ := hInSpan (φ_UWU.symm (F₀.res inf_le_right (w₀ idx)))
        rw [LinearEquiv.apply_symm_apply] at hw_Ui
        exact ⟨m_i, w_Ui, hw_Ui⟩
      choose m_fn w_fn hw_fn using hEachIdx
      let M_tot : ℕ := Finset.univ.sup m_fn
      let d_A : A_U := liftA U hActU.1.1 (s_U ^ M_tot)
      have hdA_ne : (ι_Z.app U).hom d_A ≠ 0 := by
        rw [hliftA]; exact pow_ne_zero M_tot hsU_ne
      refine ⟨d_A, fun idx => smulBU hActU.1.1 (s_U ^ (M_tot - m_fn idx)) (w_fn idx), hdA_ne, ?_⟩
      intro idx
      have hle_i : m_fn idx ≤ M_tot := Finset.le_sup (Finset.mem_univ idx)
      dsimp only
      rw [hSmulBU_res hActU.1.1 hActWU.1.1, hw_fn idx, ← hMul_smulBU, ← map_mul,
        ← pow_add, Nat.sub_add_cancel hle_i]
      exact hLiftSmulEq hActWU.1.1 _ (r_UWU d_A) _
        (by rw [hNatApp, hliftA])
    have hBC_I : ∀ {U W : C.Opens} (hU : IsSubChartAff U) (hW : IsSubChartAff W) (hWU : W ≤ U),
        N_I_aff W hW ≤ Submodule.span ↑(C.presheaf.obj (Opposite.op W))
          (F_Z.res hWU '' (N_I_aff U hU : Set (F_Z.sec U))) := by
      intro U W hU hW hWU
      by_cases hActW : ((W : Set ↥C) ∩ (S : Set ↥C)).Nonempty
      · have hActU : ((U : Set ↥C) ∩ (S : Set ↥C)).Nonempty :=
          let ⟨y, hyW, hyS⟩ := hActW; ⟨y, hWU hyW, hyS⟩
        let A_U := ↑(C.presheaf.obj (Opposite.op U))
        let A_W := ↑(C.presheaf.obj (Opposite.op W))
        let r_UW : A_U →+* A_W := (C.presheaf.map (CategoryTheory.homOfLE hWU).op).hom
        letI : Algebra A_U A_W := RingHom.toAlgebra r_UW
        haveI : Module.Flat A_U A_W := hFlatRes hU.1 hW.1 hWU
        obtain ⟨d_A, w_U, hdA_ne, hw_U⟩ := hClearW₀ U ⟨hU, hActU⟩
        let d_W : A_W := r_UW d_A
        let w_W : Fin d → F₀.sec W := fun idx => F₀.res hWU (w_U idx)
        have hdW_ne : (ι_Z.app W).hom d_W ≠ 0 := by
          rw [hNatApp]
          exact fun h0 => hdA_ne ((hBirat ⟨hU, hActU⟩ ⟨hW, hActW⟩ hWU).1
            (h0.trans (map_zero _).symm))
        have hw_W : ∀ idx : Fin d,
            F₀.res (inf_le_left : W ⊓ U_ne ≤ W) (w_W idx) =
              ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W ⊓ U_ne ≤ W)).op).hom d_W) •
                F₀.res (inf_le_right : W ⊓ U_ne ≤ U_ne) (w₀ idx) := by
          intro idx
          have hSub : W ⊓ U_ne ≤ U ⊓ U_ne := inf_le_inf_right U_ne hWU
          rw [F₀.res_comp hWU (inf_le_left : W ⊓ U_ne ≤ W),
            ← F₀.res_comp (inf_le_left : U ⊓ U_ne ≤ U) hSub, hw_U idx,
            hResSmul, F₀.res_comp (inf_le_right : U ⊓ U_ne ≤ U_ne) hSub]
          congr 1
          change (C.presheaf.map _ ≫ C.presheaf.map _).hom d_A =
            (C.presheaf.map _ ≫ C.presheaf.map _).hom d_A
          rw [← C.presheaf.map_comp, ← C.presheaf.map_comp, ← op_comp, ← op_comp,
            CategoryTheory.homOfLE_comp, CategoryTheory.homOfLE_comp]
        have hKerChar : ∀ (T : C.Opens) (hT : IsSubChartAff T)
            (hActT : ((T : Set ↥C) ∩ (S : Set ↥C)).Nonempty)
            (d_T : ↑(C.presheaf.obj (Opposite.op T))) (w_T : Fin d → F₀.sec T),
            (ι_Z.app T).hom d_T ≠ 0 →
            (∀ idx : Fin d,
              F₀.res (inf_le_left : T ⊓ U_ne ≤ T) (w_T idx) =
                ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : T ⊓ U_ne ≤ T)).op).hom d_T) •
                  F₀.res (inf_le_right : T ⊓ U_ne ≤ U_ne) (w₀ idx)) →
            ∀ z : F_Z.sec T,
              z ∈ N_I_aff T hT ↔
                ∀ idx : Fin d, ∃ x_i : F₀.sec T,
                  d_T • x_i = smulBU hT.1 (e_Z T z) (w_T idx) := by
          intro T hT hActT d_T w_T hdT_ne hw_T z
          have hActWT : IsActive (T ⊓ U_ne) := hInterActive T U_ne ⟨hT, hActT⟩ hActUne
          let r_TW : ↑(C.presheaf.obj (Opposite.op T)) →+*
              ↑(C.presheaf.obj (Opposite.op (T ⊓ U_ne))) :=
            (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : T ⊓ U_ne ≤ T)).op).hom
          have hrdT_ne : (ι_Z.app (T ⊓ U_ne)).hom (r_TW d_T) ≠ 0 := by
            rw [hNatApp]
            exact fun h0 => hdT_ne ((hBirat ⟨hT, hActT⟩ hActWT inf_le_left).1
              (h0.trans (map_zero _).symm))
          dsimp only [N_I_aff]
          rw [dif_pos hActT]
          refine forall_congr' fun idx => exists_congr fun x_i => ?_
          constructor
          · intro hx_i
            apply hResInjActive ⟨hT, hActT⟩ hActWT inf_le_left
            rw [hResSmul, hx_i, hSmulBU_res hT.1 hActWT.1.1, hw_T idx]
            change r_TW d_T • (liftA _ hActWT.1.1 _ • _) =
              liftA _ hActWT.1.1 _ • (r_TW d_T • _)
            exact smul_comm _ _ _
          · intro hdx
            have hres := congrArg (F₀.res (inf_le_left : T ⊓ U_ne ≤ T)) hdx
            rw [hResSmul, hSmulBU_res hT.1 hActWT.1.1, hw_T idx] at hres
            have hsub : r_TW d_T •
                (F₀.res (inf_le_left : T ⊓ U_ne ≤ T) x_i -
                  smulBU hActWT.1.1 (rZ_fn (inf_le_left : T ⊓ U_ne ≤ T) (e_Z T z))
                    (F₀.res (inf_le_right : T ⊓ U_ne ≤ U_ne) (w₀ idx))) = 0 := by
              rw [smul_sub, hres]
              change liftA _ hActWT.1.1 _ • (r_TW d_T • _) -
                r_TW d_T • (liftA _ hActWT.1.1 _ • _) = 0
              rw [smul_comm, sub_self]
            exact sub_eq_zero.mp (hTF_F₀ (T ⊓ U_ne) hActWT (r_TW d_T) _ hrdT_ne hsub)
        let D_U : Submodule A_U (F₀.sec U) :=
          LinearMap.range (LinearMap.lsmul A_U (F₀.sec U) d_A)
        let D_W : Submodule A_W (F₀.sec W) :=
          LinearMap.range (LinearMap.lsmul A_W (F₀.sec W) d_W)
        let Λ_U : F_Z.sec U →ₗ[A_U] (Fin d → (F₀.sec U ⧸ D_U)) :=
          { toFun := fun z idx => Submodule.mkQ D_U (smulBU hU.1 (e_Z U z) (w_U idx))
            map_add' := fun z₁ z₂ => funext fun idx => by
              dsimp only [Pi.add_apply]
              rw [map_add, hAdd_smulBU, map_add]
            map_smul' := fun a z => funext fun idx => by
              dsimp only [RingHom.id_apply, Pi.smul_apply]
              rw [heZ_smul, hMul_smulBU]
              dsimp only [smulBU]
              rw [hLiftSmulEq hU.1 _ a _ rfl, LinearMap.map_smul] }
        have hExactΛ : Function.Exact (N_I_aff U hU).subtype Λ_U := by
          intro z
          rw [← LinearMap.mem_ker]
          have hker_iff : z ∈ LinearMap.ker Λ_U ↔ z ∈ N_I_aff U hU := by
            rw [LinearMap.mem_ker, funext_iff, hKerChar U hU hActU d_A w_U hdA_ne hw_U z]
            refine forall_congr' fun idx => ?_
            change Submodule.Quotient.mk (p := D_U) _ = 0 ↔ _
            rw [Submodule.Quotient.mk_eq_zero]
            rfl
          rw [hker_iff]
          exact ⟨fun hz => ⟨⟨z, hz⟩, rfl⟩, fun ⟨y, hy⟩ => hy ▸ y.2⟩
        have hExactTen := Module.Flat.lTensor_exact A_W hExactΛ
        obtain ⟨φ_Z, hφ_Z⟩ := hCohFZ.2 U W hU.1 hW.1 hU.2 hWU
        obtain ⟨φ₀, hφ₀⟩ := hCohF₀.2 U W hU.1 hW.1 hU.2 hWU
        let p_Q : TensorProduct A_U A_W (F₀.sec U) →ₗ[A_W]
            TensorProduct A_U A_W (F₀.sec U ⧸ D_U) :=
          TensorProduct.AlgebraTensorModule.lTensor A_W A_W (Submodule.mkQ D_U)
        have hDW_ker : D_W ≤ LinearMap.ker (p_Q.comp φ₀.symm.toLinearMap) := by
          rintro _ ⟨y, rfl⟩
          obtain ⟨t, rfl⟩ := φ₀.surjective y
          change p_Q (φ₀.symm (d_W • φ₀ t)) = 0
          rw [← LinearEquiv.map_smul, LinearEquiv.symm_apply_apply]
          induction t using TensorProduct.induction_on with
          | zero => simp
          | tmul b x =>
            change p_Q (TensorProduct.tmul A_U (d_W * b) x) = 0
            have hdb : d_W * b = d_A • b := by
              change r_UW d_A * b = r_UW d_A * b; rfl
            have hdAx : Submodule.mkQ D_U (d_A • x) = 0 :=
              (Submodule.Quotient.mk_eq_zero D_U).mpr ⟨x, rfl⟩
            rw [hdb, TensorProduct.smul_tmul, TensorProduct.AlgebraTensorModule.lTensor_tmul,
              hdAx, TensorProduct.tmul_zero]
          | add t₁ t₂ ht₁ ht₂ =>
            rw [smul_add, map_add, ht₁, ht₂, add_zero]
        let g_D : (F₀.sec W ⧸ D_W) →ₗ[A_W] TensorProduct A_U A_W (F₀.sec U ⧸ D_U) :=
          Submodule.liftQ D_W (p_Q.comp φ₀.symm.toLinearMap) hDW_ker
        intro z_W hz_W
        have hz_W_char := (hKerChar W hW hActW d_W w_W hdW_ne hw_W z_W).mp hz_W
        have ht_ker : LinearMap.lTensor A_W Λ_U (φ_Z.symm z_W) = 0 := by
          have hProj0 : ∀ idx : Fin d,
              LinearMap.lTensor A_W (LinearMap.proj idx)
                (LinearMap.lTensor A_W Λ_U (φ_Z.symm z_W)) = 0 := by
            intro idx
            rw [← LinearMap.comp_apply, ← LinearMap.lTensor_comp]
            have hCompEq : ∀ t : TensorProduct A_U A_W (F_Z.sec U),
                LinearMap.lTensor A_W ((LinearMap.proj idx).comp Λ_U) t =
                  g_D (Submodule.mkQ D_W (smulBU hW.1 (e_Z W (φ_Z t)) (w_W idx))) := by
              intro t
              induction t using TensorProduct.induction_on with
              | zero => simp [hZero_smulBU]
              | tmul b z =>
                rw [hφ_Z, heZ_smul, hMul_smulBU,
                  show smulBU hW.1 ((ι_Z.app W).hom b) (smulBU hW.1 (e_Z W (F_Z.res hWU z)) (w_W idx)) =
                    b • smulBU hW.1 (e_Z W (F_Z.res hWU z)) (w_W idx) from
                    hLiftSmulEq hW.1 _ b _ rfl,
                  heZ_res hWU ((TopologicalSpace.Opens.map ι_Z.base).monotone hWU) z,
                  ← hSmulBU_res hU.1 hW.1 hWU (e_Z U z) (w_U idx), ← hφ₀]
                change _ = p_Q (φ₀.symm (φ₀ (TensorProduct.tmul A_U b _)))
                rw [LinearEquiv.symm_apply_apply]
                rfl
              | add t₁ t₂ ht₁ ht₂ =>
                rw [map_add, ht₁, ht₂, map_add, map_add, hAdd_smulBU, map_add, map_add]
            rw [hCompEq (φ_Z.symm z_W), LinearEquiv.apply_symm_apply]
            obtain ⟨x_i, hx_i⟩ := hz_W_char idx
            have hdWx : Submodule.mkQ D_W (d_W • x_i) = 0 :=
              (Submodule.Quotient.mk_eq_zero D_W).mpr ⟨x_i, rfl⟩
            rw [← hx_i, hdWx, map_zero]
          have hPiReconstruct : ∀ u : TensorProduct A_U A_W (Fin d → (F₀.sec U ⧸ D_U)),
              u = ∑ idx : Fin d,
                LinearMap.lTensor A_W (LinearMap.single A_U (fun _ : Fin d => F₀.sec U ⧸ D_U) idx)
                  (LinearMap.lTensor A_W (LinearMap.proj idx) u) := by
            intro u
            induction u using TensorProduct.induction_on with
            | zero => simp
            | tmul b f_u =>
              simp only [LinearMap.lTensor_tmul, LinearMap.proj_apply, LinearMap.single_apply]
              rw [← TensorProduct.tmul_sum, Finset.univ_sum_single f_u]
            | add u₁ u₂ hu₁ hu₂ =>
              conv_lhs => rw [hu₁, hu₂]
              rw [← Finset.sum_add_distrib]
              refine Finset.sum_congr rfl fun idx _ => ?_
              rw [map_add, map_add]
          rw [hPiReconstruct (LinearMap.lTensor A_W Λ_U (φ_Z.symm z_W))]
          refine Finset.sum_eq_zero fun idx _ => ?_
          rw [hProj0 idx, map_zero]
        obtain ⟨u, hu⟩ := (hExactTen (φ_Z.symm z_W)).mp ht_ker
        have hz_eq : z_W = φ_Z (LinearMap.lTensor A_W (N_I_aff U hU).subtype u) := by
          rw [hu, LinearEquiv.apply_symm_apply]
        have hSpanI : ∀ w : TensorProduct A_U A_W ↥(N_I_aff U hU),
            φ_Z (LinearMap.lTensor A_W (N_I_aff U hU).subtype w) ∈
              Submodule.span A_W (F_Z.res hWU '' (N_I_aff U hU : Set (F_Z.sec U))) := by
          intro w
          induction w using TensorProduct.induction_on with
          | zero => rw [map_zero, map_zero]; exact Submodule.zero_mem _
          | tmul b y =>
            change φ_Z (TensorProduct.tmul A_U b y.1) ∈ _
            rw [hφ_Z]
            exact Submodule.smul_mem _ b (Submodule.subset_span ⟨y.1, y.2, rfl⟩)
          | add u₁ u₂ hu₁ hu₂ =>
            rw [map_add, map_add]; exact Submodule.add_mem _ hu₁ hu₂
        rw [hz_eq]
        exact hSpanI u
      · dsimp only [N_I_aff]
        rw [dif_neg hActW]
        exact bot_le
    obtain ⟨N_I, I_mod, Q_Z, i_I, q_I, hNI_eq, _, _, hCohI, hCohQZ,
      hiI_res, hqI_res, hiI_inj, hiI_range, hqI_surj, hqI_ker⟩ :=
      hSubQuot F_Z hCohFZ N_I_aff hR_I hBC_I
    have hAnnQZ : ∀ (U : C.Opens), IsSubChartAff U →
        ∀ a ∈ RingHom.ker ((ι_Z.app U).hom), ∀ y : Q_Z.sec U, a • y = 0 := by
      intro U _ a ha y
      obtain ⟨z, rfl⟩ := hqI_surj U y
      rw [← LinearMap.map_smul, hAnnFZ U a ha z, map_zero]
    have hVanQZ_Une : ∀ y : Q_Z.sec U_ne, y = 0 := by
      intro y
      obtain ⟨z, rfl⟩ := hqI_surj U_ne y
      rw [← LinearMap.mem_ker, hqI_ker U_ne, hNI_eq U_ne hActUne.1]
      dsimp only [N_I_aff]
      rw [dif_pos hActUne.2]
      intro idx
      refine ⟨smulBU hActUne.1.1 (e_Z U_ne z) (w₀ idx), ?_⟩
      have hInfEq : (inf_le_left : U_ne ⊓ U_ne ≤ U_ne) = (inf_le_right : U_ne ⊓ U_ne ≤ U_ne) :=
        rfl
      rw [hSmulBU_res hActUne.1.1 (hAffInter U_ne U_ne hActUne.1.1 hActUne.1.1), hInfEq]
    obtain ⟨S'₁, hS'₁_lt, hSuppQZ⟩ :=
      (hProperSupp S Q_Z hCohQZ hAnnQZ).2 U_ne hActUne.1 hActUne.2 hVanQZ_Une
    have hFinQZ : HasFiniteWeilModuleCechCohomology g V Q_Z :=
      hSmaller S'₁ hS'₁_lt Q_Z hCohQZ hSuppQZ
    have hFinI : HasFiniteWeilModuleCechCohomology g V I_mod :=
      (hSES (fun _ => True) (fun _ => trivial) I_mod F_Z Q_Z
        (fun U _ => (i_I U).toAddMonoidHom) (fun U _ => (q_I U).toAddMonoidHom)
        (fun U _ a y => (i_I U).map_smul a y) (fun U _ a z => (q_I U).map_smul a z)
        (fun _ _ h y => hiI_res h y) (fun _ _ h z => hqI_res h z)
        (fun U _ => hiI_inj U) (fun U _ => hqI_surj U)
        (fun U _ z => by
          change q_I U z = 0 ↔ ∃ y, i_I U y = z
          rw [← LinearMap.mem_ker, hqI_ker, ← hiI_range, LinearMap.mem_range])).2
        hFZ_fin hFinQZ
    let I_sum : ℕ → WeilPresheafModule C := fun k =>
      { sec := fun U => Fin k → I_mod.sec U
        instAddCommGroup := fun U => inferInstance
        instModule := fun U => inferInstance
        res := fun {_ _} hWU =>
          { toFun := fun v j => I_mod.res hWU (v j)
            map_zero' := funext fun _ => map_zero _
            map_add' := fun v₁ v₂ => funext fun j => map_add _ (v₁ j) (v₂ j) }
        res_smul := fun hWU a v => funext fun j => hResSmul I_mod hWU a (v j)
        res_id := fun U v => funext fun j => I_mod.res_id U (v j)
        res_comp := fun h₁ h₂ v => funext fun j => I_mod.res_comp h₁ h₂ (v j) }
    have hFinIsum : ∀ k : ℕ, HasFiniteWeilModuleCechCohomology g V (I_sum k) := by
      intro k
      induction k with
      | zero =>
        exact hZero (I_sum 0) (fun _ _ v => funext fun j => Fin.elim0 j)
      | succ k ih =>
        refine (hSES (fun _ => True) (fun _ => trivial) I_mod (I_sum (k + 1)) (I_sum k)
          (fun U _ => (LinearMap.single ↑(C.presheaf.obj (Opposite.op U))
            (fun _ : Fin (k + 1) => I_mod.sec U) 0).toAddMonoidHom)
          (fun _ _ =>
            { toFun := fun v j => v j.succ
              map_zero' := rfl
              map_add' := fun _ _ => rfl })
          (fun U _ a x => funext fun j => by
            change Pi.single (M := fun _ : Fin (k + 1) => I_mod.sec U) 0 (a • x) j =
              a • Pi.single (M := fun _ : Fin (k + 1) => I_mod.sec U) 0 x j
            by_cases hj : j = 0 <;> simp [Pi.single_apply, hj])
          (fun _ _ _ _ => rfl)
          (fun {U W} _ _ h x => funext fun j => by
            change Pi.single (M := fun _ : Fin (k + 1) => I_mod.sec W) 0 (I_mod.res h x) j =
              I_mod.res h (Pi.single (M := fun _ : Fin (k + 1) => I_mod.sec U) 0 x j)
            by_cases hj : j = 0 <;> simp [Pi.single_apply, hj])
          (fun _ _ _ _ => rfl)
          (fun U _ => @Pi.single_injective (Fin (k + 1)) (fun _ => I_mod.sec U) _ _ 0)
          (fun U _ w => ⟨Fin.cons (α := fun _ => I_mod.sec U) 0 w, funext fun j =>
            Fin.cons_succ (α := fun _ => I_mod.sec U) 0 w j⟩)
          (fun U _ v => by
            constructor
            · intro hv
              refine ⟨v 0, funext fun j => ?_⟩
              refine Fin.cases ?_ ?_ j
              · simp [Pi.single_eq_same]
              · intro j'
                have hj' := congrFun hv j'
                change Pi.single (M := fun _ : Fin (k + 1) => I_mod.sec U) 0 (v 0) j'.succ =
                  v j'.succ
                rw [Pi.single_eq_of_ne (Fin.succ_ne_zero j')]
                exact hj'.symm
            · rintro ⟨x, rfl⟩
              funext j
              exact Pi.single_eq_of_ne (M := fun _ : Fin (k + 1) => I_mod.sec U)
                (Fin.succ_ne_zero j) x)).1 hFinI ih
    have hSuppF₀ : IsWeilSupportedOn V F₀ S :=
      (hProperSupp S F₀ hCohF₀ (fun U _ => hAnnF₀ U)).1
    have hPhiWitness : ∀ (U : C.Opens) (hU : IsSubChartAff U)
        (hAct : ((U : Set ↥C) ∩ (S : Set ↥C)).Nonempty) (idx : Fin d) (z : I_mod.sec U),
        ∃ x_i : F₀.sec U,
          F₀.res (inf_le_left : U ⊓ U_ne ≤ U) x_i =
            smulBU (hAffInter U U_ne hU.1 hActUne.1.1)
              (rZ_fn (inf_le_left : U ⊓ U_ne ≤ U) (e_Z U (i_I U z)))
              (F₀.res (inf_le_right : U ⊓ U_ne ≤ U_ne) (w₀ idx)) := by
      intro U hU hAct idx z
      have hz_mem : i_I U z ∈ N_I_aff U hU := by
        rw [← hNI_eq U hU, ← hiI_range U]
        exact LinearMap.mem_range_self (i_I U) z
      dsimp only [N_I_aff] at hz_mem
      rw [dif_pos hAct] at hz_mem
      exact hz_mem idx
    let φ_comp_fn : ∀ (U : C.Opens) (hU : IsSubChartAff U)
        (_ : ((U : Set ↥C) ∩ (S : Set ↥C)).Nonempty) (idx : Fin d),
        I_mod.sec U → F₀.sec U :=
      fun U hU hAct idx z => Classical.choose (hPhiWitness U hU hAct idx z)
    have hφ_comp_spec : ∀ (U : C.Opens) (hU : IsSubChartAff U)
        (hAct : ((U : Set ↥C) ∩ (S : Set ↥C)).Nonempty) (idx : Fin d) (z : I_mod.sec U),
        F₀.res (inf_le_left : U ⊓ U_ne ≤ U) (φ_comp_fn U hU hAct idx z) =
          smulBU (hAffInter U U_ne hU.1 hActUne.1.1)
            (rZ_fn (inf_le_left : U ⊓ U_ne ≤ U) (e_Z U (i_I U z)))
            (F₀.res (inf_le_right : U ⊓ U_ne ≤ U_ne) (w₀ idx)) :=
      fun U hU hAct idx z => Classical.choose_spec (hPhiWitness U hU hAct idx z)
    let Φ_aff : ∀ (U : C.Opens) (hU : IsSubChartAff U),
        (I_sum d).sec U →ₗ[↑(C.presheaf.obj (Opposite.op U))] F₀.sec U :=
      fun U hU =>
        if hAct : ((U : Set ↥C) ∩ (S : Set ↥C)).Nonempty then
          { toFun := fun v => ∑ idx : Fin d, φ_comp_fn U hU hAct idx (v idx)
            map_add' := fun v₁ v₂ => by
              rw [← Finset.sum_add_distrib]
              refine Finset.sum_congr rfl fun idx _ => ?_
              apply hResInjActive ⟨hU, hAct⟩ (hInterActive U U_ne ⟨hU, hAct⟩ hActUne) inf_le_left
              rw [map_add, hφ_comp_spec U hU hAct, hφ_comp_spec U hU hAct, hφ_comp_spec U hU hAct]
              have hv_add : (v₁ + v₂) idx = v₁ idx + v₂ idx := rfl
              rw [hv_add, map_add, map_add, map_add, hAdd_smulBU]
            map_smul' := fun a v => by
              dsimp only [RingHom.id_apply]
              rw [Finset.smul_sum]
              refine Finset.sum_congr rfl fun idx _ => ?_
              apply hResInjActive ⟨hU, hAct⟩ (hInterActive U U_ne ⟨hU, hAct⟩ hActUne) inf_le_left
              rw [hResSmul, hφ_comp_spec U hU hAct, hφ_comp_spec U hU hAct]
              have hv_smul : (a • v) idx = a • v idx := rfl
              rw [hv_smul, LinearMap.map_smul, heZ_smul, map_mul,
                ← hNatApp (inf_le_left : U ⊓ U_ne ≤ U) a, hMul_smulBU]
              exact hLiftSmulEq (hAffInter U U_ne hU.1 hActUne.1.1) _
                ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U ⊓ U_ne ≤ U)).op).hom a)
                _ rfl }
        else 0
    have hΦ_res : ∀ {U W : C.Opens} (hU : IsSubChartAff U) (hW : IsSubChartAff W)
        (hWU : W ≤ U) (v : (I_sum d).sec U),
        F₀.res hWU (Φ_aff U hU v) = Φ_aff W hW ((I_sum d).res hWU v) := by
      intro U W hU hW hWU v
      by_cases hActW : ((W : Set ↥C) ∩ (S : Set ↥C)).Nonempty
      · have hActU : ((U : Set ↥C) ∩ (S : Set ↥C)).Nonempty :=
          let ⟨y, hyW, hyS⟩ := hActW; ⟨y, hWU hyW, hyS⟩
        dsimp only [Φ_aff]
        rw [dif_pos hActU, dif_pos hActW]
        dsimp only [LinearMap.coe_mk, AddHom.coe_mk]
        rw [map_sum]
        refine Finset.sum_congr rfl fun idx _ => ?_
        apply hResInjActive ⟨hW, hActW⟩ (hInterActive W U_ne ⟨hW, hActW⟩ hActUne) inf_le_left
        have hSub : W ⊓ U_ne ≤ U ⊓ U_ne := inf_le_inf_right U_ne hWU
        rw [hφ_comp_spec W hW hActW, F₀.res_comp hWU (inf_le_left : W ⊓ U_ne ≤ W),
          ← F₀.res_comp (inf_le_left : U ⊓ U_ne ≤ U) hSub, hφ_comp_spec U hU hActU,
          hSmulBU_res (hAffInter U U_ne hU.1 hActUne.1.1)
            (hAffInter W U_ne hW.1 hActUne.1.1) hSub,
          F₀.res_comp (inf_le_right : U ⊓ U_ne ≤ U_ne) hSub]
        congr 1
        let hSubZ : U_Z_fn (W ⊓ U_ne) ≤ U_Z_fn (U ⊓ U_ne) :=
          (TopologicalSpace.Opens.map ι_Z.base).monotone hSub
        let hUZ_le : U_Z_fn (U ⊓ U_ne) ≤ U_Z_fn U :=
          (TopologicalSpace.Opens.map ι_Z.base).monotone (inf_le_left : U ⊓ U_ne ≤ U)
        let hWZ_le : U_Z_fn (W ⊓ U_ne) ≤ U_Z_fn W :=
          (TopologicalSpace.Opens.map ι_Z.base).monotone (inf_le_left : W ⊓ U_ne ≤ W)
        let hWUZ_le : U_Z_fn W ≤ U_Z_fn U :=
          (TopologicalSpace.Opens.map ι_Z.base).monotone hWU
        have hres_idx : ((I_sum d).res hWU v) idx = I_mod.res hWU (v idx) := rfl
        rw [hres_idx, hiI_res hWU, heZ_res hWU hWUZ_le]
        change (Z.presheaf.map (CategoryTheory.homOfLE hUZ_le).op ≫
            Z.presheaf.map (CategoryTheory.homOfLE hSubZ).op).hom (e_Z U (i_I U (v idx))) =
          (Z.presheaf.map (CategoryTheory.homOfLE hWUZ_le).op ≫
            Z.presheaf.map (CategoryTheory.homOfLE hWZ_le).op).hom (e_Z U (i_I U (v idx)))
        rw [← Z.presheaf.map_comp, ← Z.presheaf.map_comp, ← op_comp, ← op_comp,
          CategoryTheory.homOfLE_comp, CategoryTheory.homOfLE_comp]
      · dsimp only [Φ_aff]
        rw [dif_neg hActW, LinearMap.zero_apply]
        have hDisjW : Disjoint (W : Set ↥C) (S : Set ↥C) :=
          Set.not_nonempty_iff_eq_empty.mp hActW |> Set.disjoint_iff_inter_eq_empty.mpr
        exact hSuppF₀ W hW.1 hW.2 hDisjW _
    have hΦ_inj : ∀ (U : C.Opens) (hU : IsSubChartAff U),
        Function.Injective (Φ_aff U hU) := by
      intro U hU
      rw [← LinearMap.ker_eq_bot, eq_bot_iff]
      intro v hv
      rw [Submodule.mem_bot]
      rw [LinearMap.mem_ker] at hv
      by_cases hActU : ((U : Set ↥C) ∩ (S : Set ↥C)).Nonempty
      · have hActWU : IsActive (U ⊓ U_ne) := hInterActive U U_ne ⟨hU, hActU⟩ hActUne
        haveI : IsDomain ↑(Z.presheaf.obj (Opposite.op (U_Z_fn (U ⊓ U_ne)))) :=
          hDomainB (U ⊓ U_ne) hActWU
        dsimp only [Φ_aff] at hv
        rw [dif_pos hActU] at hv
        have hres0 := congrArg (F₀.res (inf_le_left : U ⊓ U_ne ≤ U)) hv
        rw [map_zero, LinearMap.coe_mk, AddHom.coe_mk, map_sum] at hres0
        have hsumW : (∑ idx : Fin d,
            smulBU hActWU.1.1
              (rZ_fn (inf_le_left : U ⊓ U_ne ≤ U) (e_Z U (i_I U (v idx))))
              (F₀.res (inf_le_right : U ⊓ U_ne ≤ U_ne) (w₀ idx))) = 0 := by
          rw [← hres0]
          exact Finset.sum_congr rfl fun idx _ => (hφ_comp_spec U hU hActU idx (v idx)).symm
        obtain ⟨hrZ_ne_inj, s_ne, hs_ne_ne, hClear_ne⟩ :=
          hBirat hActUne hActWU (inf_le_right : U ⊓ U_ne ≤ U_ne)
        choose m_v c_v hc_v using fun idx : Fin d =>
          hClear_ne (rZ_fn (inf_le_left : U ⊓ U_ne ≤ U) (e_Z U (i_I U (v idx))))
        let M_v : ℕ := Finset.univ.sup m_v
        let c'_v : Fin d → B_ne := fun idx => s_ne ^ (M_v - m_v idx) * c_v idx
        have hc'_eq : ∀ idx : Fin d,
            rZ_fn (inf_le_right : U ⊓ U_ne ≤ U_ne) (c'_v idx) =
              rZ_fn (inf_le_right : U ⊓ U_ne ≤ U_ne) (s_ne ^ M_v) *
                rZ_fn (inf_le_left : U ⊓ U_ne ≤ U) (e_Z U (i_I U (v idx))) := by
          intro idx
          have hle : m_v idx ≤ M_v := Finset.le_sup (f := m_v) (Finset.mem_univ idx)
          dsimp only [c'_v]
          rw [map_mul, ← hc_v idx, ← mul_assoc, ← map_mul, ← pow_add, Nat.sub_add_cancel hle]
        have hSumUne : (∑ idx : Fin d, smulBU hActUne.1.1 (c'_v idx) (w₀ idx)) = 0 := by
          apply hResInjActive hActUne hActWU inf_le_right
          rw [map_zero, map_sum]
          have hScaled : smulBU hActWU.1.1 (rZ_fn (inf_le_right : U ⊓ U_ne ≤ U_ne) (s_ne ^ M_v))
              (∑ idx : Fin d,
                smulBU hActWU.1.1
                  (rZ_fn (inf_le_left : U ⊓ U_ne ≤ U) (e_Z U (i_I U (v idx))))
                  (F₀.res (inf_le_right : U ⊓ U_ne ≤ U_ne) (w₀ idx))) = 0 := by
            rw [hsumW, hSmulBU_zero]
          rw [← hScaled, hSmulBU_sum hActWU.1.1]
          refine Finset.sum_congr rfl fun idx _ => ?_
          rw [hSmulBU_res hActUne.1.1 hActWU.1.1, hc'_eq idx, hMul_smulBU]
        have hc'_zero := hw₀_LI c'_v hSumUne
        have hsM_ne : rZ_fn (inf_le_right : U ⊓ U_ne ≤ U_ne) (s_ne ^ M_v) ≠ 0 :=
          fun h0 => pow_ne_zero M_v hs_ne_ne (hrZ_ne_inj (h0.trans (map_zero _).symm))
        funext idx
        change v idx = 0
        have hprod0 : rZ_fn (inf_le_right : U ⊓ U_ne ≤ U_ne) (s_ne ^ M_v) *
            rZ_fn (inf_le_left : U ⊓ U_ne ≤ U) (e_Z U (i_I U (v idx))) = 0 := by
          rw [← hc'_eq idx, hc'_zero idx, map_zero]
        have hrZ_zero : rZ_fn (inf_le_left : U ⊓ U_ne ≤ U) (e_Z U (i_I U (v idx))) = 0 :=
          (mul_eq_zero.mp hprod0).resolve_left hsM_ne
        have heZ_zero : e_Z U (i_I U (v idx)) = 0 :=
          (hBirat ⟨hU, hActU⟩ hActWU inf_le_left).1 (hrZ_zero.trans (map_zero _).symm)
        exact hiI_inj U (by rw [map_zero]; exact (e_Z U).injective (heZ_zero.trans (map_zero _).symm))
      · funext idx
        change v idx = 0
        apply hiI_inj U
        rw [map_zero]
        have hmem : i_I U (v idx) ∈ N_I_aff U hU := by
          rw [← hNI_eq U hU, ← hiI_range U]
          exact LinearMap.mem_range_self (i_I U) (v idx)
        dsimp only [N_I_aff] at hmem
        rwa [dif_neg hActU, Submodule.mem_bot] at hmem
    let N_Φ_aff : ∀ (U : C.Opens), IsSubChartAff U →
        Submodule ↑(C.presheaf.obj (Opposite.op U)) (F₀.sec U) :=
      fun U hU => LinearMap.range (Φ_aff U hU)
    have hR_Φ : ∀ {U W : C.Opens} (hU : IsSubChartAff U) (hW : IsSubChartAff W)
        (hWU : W ≤ U) (x : F₀.sec U),
        x ∈ N_Φ_aff U hU → F₀.res hWU x ∈ N_Φ_aff W hW := by
      rintro U W hU hW hWU _ ⟨v, rfl⟩
      exact ⟨(I_sum d).res hWU v, (hΦ_res hU hW hWU v).symm⟩
    have hBC_Φ : ∀ {U W : C.Opens} (hU : IsSubChartAff U) (hW : IsSubChartAff W) (hWU : W ≤ U),
        N_Φ_aff W hW ≤ Submodule.span ↑(C.presheaf.obj (Opposite.op W))
          (F₀.res hWU '' (N_Φ_aff U hU : Set (F₀.sec U))) := by
      rintro U W hU hW hWU _ ⟨v_W, rfl⟩
      let A_U := ↑(C.presheaf.obj (Opposite.op U))
      let A_W := ↑(C.presheaf.obj (Opposite.op W))
      letI : Algebra A_U A_W :=
        RingHom.toAlgebra (C.presheaf.map (CategoryTheory.homOfLE hWU).op).hom
      obtain ⟨φ_I, hφ_I⟩ := hCohI.2 U W hU.1 hW.1 hU.2 hWU
      have hv_sum : v_W = ∑ idx : Fin d, Pi.single idx (v_W idx) :=
        (Finset.univ_sum_single v_W).symm
      rw [hv_sum, map_sum]
      refine Submodule.sum_mem _ fun idx _ => ?_
      have hInSpan : ∀ t : TensorProduct A_U A_W (I_mod.sec U),
          Φ_aff W hW (Pi.single idx (φ_I t)) ∈
            Submodule.span A_W (F₀.res hWU '' (N_Φ_aff U hU : Set (F₀.sec U))) := by
        intro t
        induction t using TensorProduct.induction_on with
        | zero => rw [map_zero, Pi.single_zero, map_zero]; exact Submodule.zero_mem _
        | tmul b z =>
          rw [hφ_I]
          have hSingle : (Pi.single idx (b • I_mod.res hWU z) : (I_sum d).sec W) =
              b • (I_sum d).res hWU (Pi.single idx z) := by
            funext j
            change Pi.single (M := fun _ : Fin d => I_mod.sec W) idx (b • I_mod.res hWU z) j =
              b • I_mod.res hWU (Pi.single (M := fun _ : Fin d => I_mod.sec U) idx z j)
            by_cases hj : j = idx <;> simp [Pi.single_apply, hj]
          rw [hSingle, LinearMap.map_smul, ← hΦ_res hU hW hWU]
          exact Submodule.smul_mem _ b
            (Submodule.subset_span ⟨Φ_aff U hU (Pi.single idx z), ⟨_, rfl⟩, rfl⟩)
        | add t₁ t₂ ht₁ ht₂ =>
          rw [map_add, Pi.single_add, map_add]
          exact Submodule.add_mem _ ht₁ ht₂
      have hh := hInSpan (φ_I.symm (v_W idx))
      rwa [LinearEquiv.apply_symm_apply] at hh
    obtain ⟨N_Φ, imPhi, Q_coker, i_Φ, q_Φ, hNΦ_eq, _, _, hCohIm, hCohQcoker,
      hiΦ_res, hqΦ_res, hiΦ_inj, hiΦ_range, hqΦ_surj, hqΦ_ker⟩ :=
      hSubQuot F₀ hCohF₀ N_Φ_aff hR_Φ hBC_Φ
    let zeroMod : WeilPresheafModule C :=
      { sec := fun _ => PUnit.{u + 1}
        instAddCommGroup := fun _ => inferInstance
        instModule := fun _ => inferInstance
        res := fun _ => 0
        res_smul := fun _ _ _ => rfl
        res_id := fun _ _ => rfl
        res_comp := fun _ _ _ => rfl }
    have hFinZero : HasFiniteWeilModuleCechCohomology g V zeroMod :=
      hZero zeroMod (fun _ _ _ => rfl)
    let iso_imPhi : ∀ (U : C.Opens) (hU : IsSubChartAff U),
        (I_sum d).sec U ≃ₗ[↑(C.presheaf.obj (Opposite.op U))] imPhi.sec U :=
      fun U hU =>
        ((LinearEquiv.ofInjective (Φ_aff U hU) (hΦ_inj U hU)).trans
          (LinearEquiv.ofEq _ _ ((hNΦ_eq U hU).symm.trans (hiΦ_range U).symm))).trans
          (LinearEquiv.ofInjective (i_Φ U) (hiΦ_inj U)).symm
    have hiso_imPhi_comp : ∀ (U : C.Opens) (hU : IsSubChartAff U) (v : (I_sum d).sec U),
        i_Φ U (iso_imPhi U hU v) = Φ_aff U hU v := by
      intro U hU v
      let e_i := LinearEquiv.ofInjective (i_Φ U) (hiΦ_inj U)
      let w_mid : ↥(LinearMap.range (i_Φ U)) :=
        (LinearEquiv.ofEq _ _ ((hNΦ_eq U hU).symm.trans (hiΦ_range U).symm))
          (LinearEquiv.ofInjective (Φ_aff U hU) (hΦ_inj U hU) v)
      have he_i : e_i (e_i.symm w_mid) = w_mid := e_i.apply_symm_apply w_mid
      exact congrArg Subtype.val he_i
    have hFinImPhi : HasFiniteWeilModuleCechCohomology g V imPhi :=
      (hSES IsSubChartAff (fun α => hChartS α) (I_sum d) imPhi zeroMod
        (fun U hU => (iso_imPhi U hU).toLinearMap.toAddMonoidHom)
        (fun _ _ => 0)
        (fun U hU a v => (iso_imPhi U hU).map_smul a v)
        (fun _ _ _ _ => rfl)
        (fun {U W} hU hW h v => by
          apply hiΦ_inj W
          change i_Φ W (iso_imPhi W hW ((I_sum d).res h v)) = i_Φ W (imPhi.res h (iso_imPhi U hU v))
          rw [hiso_imPhi_comp W hW, hiΦ_res h, hiso_imPhi_comp U hU, hΦ_res hU hW h v])
        (fun _ _ _ _ => rfl)
        (fun U hU => (iso_imPhi U hU).injective)
        (fun _ _ u => ⟨0, Subsingleton.elim _ u⟩)
        (fun U hU x => ⟨fun _ => ⟨(iso_imPhi U hU).symm x, LinearEquiv.apply_symm_apply _ x⟩,
          fun _ => rfl⟩)).1 (hFinIsum d) hFinZero
    have hAnnQcoker : ∀ (U : C.Opens), IsSubChartAff U →
        ∀ a ∈ RingHom.ker ((ι_Z.app U).hom), ∀ y : Q_coker.sec U, a • y = 0 := by
      intro U _ a ha y
      obtain ⟨x, rfl⟩ := hqΦ_surj U y
      rw [← LinearMap.map_smul, hAnnF₀ U a ha x, map_zero]
    have hw₀_in_NΦ : ∀ idx : Fin d, w₀ idx ∈ N_Φ_aff U_ne hActUne.1 := by
      intro idx
      have hz₁_mem : (e_Z U_ne).symm 1 ∈ N_I U_ne := by
        rw [hNI_eq U_ne hActUne.1]
        dsimp only [N_I_aff]
        rw [dif_pos hActUne.2]
        intro j
        refine ⟨w₀ j, ?_⟩
        rw [AddEquiv.apply_symm_apply, map_one, hOne_smulBU]
      rw [← hiI_range U_ne] at hz₁_mem
      obtain ⟨z₁_I, hz₁_I⟩ := hz₁_mem
      refine ⟨Pi.single (M := fun _ : Fin d => I_mod.sec U_ne) idx z₁_I, ?_⟩
      dsimp only [Φ_aff]
      rw [dif_pos hActUne.2]
      dsimp only [LinearMap.coe_mk, AddHom.coe_mk]
      apply hResInjActive hActUne (hInterActive U_ne U_ne hActUne hActUne) inf_le_left
      rw [map_sum]
      have hSumSingle : (∑ j : Fin d,
          F₀.res (inf_le_left : U_ne ⊓ U_ne ≤ U_ne)
            (φ_comp_fn U_ne hActUne.1 hActUne.2 j
              (Pi.single (M := fun _ : Fin d => I_mod.sec U_ne) idx z₁_I j))) =
          F₀.res (inf_le_left : U_ne ⊓ U_ne ≤ U_ne) (w₀ idx) := by
        rw [Finset.sum_eq_single idx]
        · rw [hφ_comp_spec U_ne hActUne.1 hActUne.2, Pi.single_eq_same, hz₁_I,
            AddEquiv.apply_symm_apply, map_one, hOne_smulBU]
        · intro j _ hj
          rw [hφ_comp_spec U_ne hActUne.1 hActUne.2, Pi.single_eq_of_ne hj,
            map_zero, map_zero, map_zero, hZero_smulBU]
        · intro hAbs; exact absurd (Finset.mem_univ idx) hAbs
      exact hSumSingle
    have hKillQcokerUne : ∃ c_tilde : A_ne,
        (ι_Z.app U_ne).hom c_tilde ≠ 0 ∧ ∀ u : Q_coker.sec U_ne, c_tilde • u = 0 := by
      haveI : Module.Finite A_ne (F₀.sec U_ne) := hCohF₀.1 U_ne hActUne.1.1 hActUne.1.2
      obtain ⟨k_g, ψ_g, hψ_g⟩ := Module.Finite.exists_fin' A_ne (F₀.sec U_ne)
      choose c_g μ_g hc_g using fun l : Fin k_g => hw₀_Span (ψ_g (Pi.single l 1))
      let c_prod : B_ne := ∏ l : Fin k_g, c_g l
      have hc_prod_ne : c_prod ≠ 0 := Finset.prod_ne_zero_iff.mpr fun l _ => (hc_g l).1
      let c_tilde : A_ne := liftA U_ne hActUne.1.1 c_prod
      refine ⟨c_tilde, by rw [hliftA]; exact hc_prod_ne, fun u => ?_⟩
      obtain ⟨y, rfl⟩ := hqΦ_surj U_ne u
      rw [← LinearMap.map_smul, ← LinearMap.mem_ker, hqΦ_ker U_ne, hNΦ_eq U_ne hActUne.1]
      obtain ⟨a_coef, rfl⟩ := hψ_g y
      have ha_eq : ψ_g a_coef = ∑ l : Fin k_g, a_coef l • ψ_g (Pi.single l 1) := by
        conv_lhs => rw [← Finset.univ_sum_single a_coef, map_sum]
        refine Finset.sum_congr rfl fun l _ => ?_
        have hsingle : Pi.single l (a_coef l) = a_coef l • (Pi.single l (1 : A_ne) : Fin k_g → A_ne) := by
          ext l'; simp [Pi.single_apply]
        rw [hsingle, LinearMap.map_smul]
      rw [ha_eq, Finset.smul_sum]
      refine Submodule.sum_mem _ fun l _ => ?_
      rw [smul_comm c_tilde (a_coef l)]
      refine Submodule.smul_mem _ (a_coef l) ?_
      have hdvd : c_g l ∣ c_prod := Finset.dvd_prod_of_mem c_g (Finset.mem_univ l)
      obtain ⟨q_l, hq_l⟩ := hdvd
      change smulBU hActUne.1.1 c_prod (ψ_g (Pi.single l 1)) ∈ N_Φ_aff U_ne hActUne.1
      have hrew : smulBU hActUne.1.1 c_prod (ψ_g (Pi.single l 1)) =
          liftA U_ne hActUne.1.1 q_l •
            ∑ idx : Fin d, liftA U_ne hActUne.1.1 (μ_g l idx) • w₀ idx := by
        rw [hq_l, mul_comm, hMul_smulBU, (hc_g l).2]
      rw [hrew]
      exact Submodule.smul_mem _ _
        (Submodule.sum_mem _ fun idx _ => Submodule.smul_mem _ _ (hw₀_in_NΦ idx))
    obtain ⟨c_tilde, hc_tilde_ne, hc_tilde_kill⟩ := hKillQcokerUne
    let W₁ := C.basicOpen c_tilde
    have hW₁_le : W₁ ≤ U_ne := C.basicOpen_le c_tilde
    have hW₁_sub : IsSubChartAff W₁ :=
      ⟨hActUne.1.1.basicOpen c_tilde,
        let ⟨a, ha⟩ := hActUne.1.2; ⟨a, le_trans hW₁_le ha⟩⟩
    have hW₁_ne : ((W₁ : Set ↥C) ∩ (S : Set ↥C)).Nonempty := by
      let c_Z := (ι_Z.app U_ne).hom c_tilde
      have hAffUneZ : AlgebraicGeometry.IsAffineOpen (U_Z_fn U_ne) := hUZ_aff U_ne hActUne.1.1
      haveI : IsLocalization.Away c_Z ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen c_Z))) :=
        hAffUneZ.isLocalization_basicOpen c_Z
      have hcZ_nzd : Submonoid.powers c_Z ≤ nonZeroDivisors B_ne :=
        Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hc_tilde_ne)
      have hInjLoc : Function.Injective
          (algebraMap B_ne ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen c_Z)))) :=
        IsLocalization.injective _ hcZ_nzd
      have hNontriv : Nontrivial ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen c_Z))) :=
        ⟨⟨0, 1, fun h01 => zero_ne_one
          (hInjLoc ((map_zero _).trans (h01.trans (map_one _).symm)))⟩⟩
      have hAffBZ : AlgebraicGeometry.IsAffineOpen (Z.basicOpen c_Z) := hAffUneZ.basicOpen c_Z
      have hNonempZ : Nonempty ↥(Z.basicOpen c_Z) := by
        by_contra hEmp
        have hEmpSpec : IsEmpty (PrimeSpectrum ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen c_Z)))) :=
          ⟨fun p => hEmp ⟨hAffBZ.isoSpec.inv.base p⟩⟩
        have : Subsingleton ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen c_Z))) :=
          PrimeSpectrum.isEmpty_iff_subsingleton.mp hEmpSpec
        exact false_of_nontrivial_of_subsingleton ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen c_Z)))
      obtain ⟨z₀, hz₀⟩ := hNonempZ
      have hz₀_pre : z₀ ∈ (TopologicalSpace.Opens.map ι_Z.base).obj W₁ := by
        rwa [ι_Z.preimage_basicOpen c_tilde]
      exact ⟨ι_Z.base z₀, hz₀_pre, by rw [← hRangeS]; exact ⟨z₀, rfl⟩⟩
    have hVanQcokerW₁ : ∀ y : Q_coker.sec W₁, y = 0 := by
      intro y
      let A_W₁ := ↑(C.presheaf.obj (Opposite.op W₁))
      let r_W₁ : A_ne →+* A_W₁ := (C.presheaf.map (CategoryTheory.homOfLE hW₁_le).op).hom
      letI : Algebra A_ne A_W₁ := RingHom.toAlgebra r_W₁
      haveI : IsLocalization.Away c_tilde A_W₁ := hActUne.1.1.isLocalization_basicOpen c_tilde
      obtain ⟨u_unit, hu_unit⟩ :=
        IsLocalization.map_units A_W₁
          (⟨c_tilde, Submonoid.mem_powers c_tilde⟩ : Submonoid.powers c_tilde)
      have hu_eq : (u_unit : A_W₁) = r_W₁ c_tilde := hu_unit
      obtain ⟨φ_Q, hφ_Q⟩ := hCohQcoker.2 U_ne W₁ hActUne.1.1 hW₁_sub.1 hActUne.1.2 hW₁_le
      have hKillW₁ : r_W₁ c_tilde • y = 0 := by
        obtain ⟨t, rfl⟩ := φ_Q.surjective y
        induction t using TensorProduct.induction_on with
        | zero => rw [map_zero, smul_zero]
        | tmul b u =>
          rw [hφ_Q, smul_comm, ← hResSmul, hc_tilde_kill u, map_zero, smul_zero]
        | add t₁ t₂ ht₁ ht₂ =>
          rw [map_add, smul_add, ht₁, ht₂, add_zero]
      calc y = (1 : A_W₁) • y := (one_smul _ _).symm
        _ = (↑u_unit⁻¹ * ↑u_unit : A_W₁) • y := by rw [Units.inv_mul]
        _ = (↑u_unit⁻¹ : A_W₁) • (r_W₁ c_tilde • y) := by rw [hu_eq, mul_smul]
        _ = 0 := by rw [hKillW₁, smul_zero]
    obtain ⟨S'₂, hS'₂_lt, hSuppQcoker⟩ :=
      (hProperSupp S Q_coker hCohQcoker hAnnQcoker).2 W₁ hW₁_sub hW₁_ne hVanQcokerW₁
    have hFinQcoker : HasFiniteWeilModuleCechCohomology g V Q_coker :=
      hSmaller S'₂ hS'₂_lt Q_coker hCohQcoker hSuppQcoker
    exact (hSES (fun _ => True) (fun _ => trivial) imPhi F₀ Q_coker
      (fun U _ => (i_Φ U).toAddMonoidHom) (fun U _ => (q_Φ U).toAddMonoidHom)
      (fun U _ a y => (i_Φ U).map_smul a y) (fun U _ a x => (q_Φ U).map_smul a x)
      (fun _ _ h y => hiΦ_res h y) (fun _ _ h x => hqΦ_res h x)
      (fun U _ => hiΦ_inj U) (fun U _ => hqΦ_surj U)
      (fun U _ x => by
        change q_Φ U x = 0 ↔ ∃ y, i_Φ U y = x
        rw [← LinearMap.mem_ker, hqΦ_ker, ← hiΦ_range, LinearMap.mem_range])).1
      hFinImPhi hFinQcoker
  obtain ⟨hZero, hSES⟩ := hPart1
  obtain ⟨hAffInter, hChartS, hNoethU, hFlatRes, hSubQuot, hProperSupp, hPillar2⟩ := hPart2
  have hExt : ∀ (F₁ F₂ F₃ : WeilPresheafModule C)
      (i : ∀ U : C.Opens, F₁.sec U →+ F₂.sec U)
      (q : ∀ U : C.Opens, F₂.sec U →+ F₃.sec U),
      (∀ U (a : ↑(C.presheaf.obj (Opposite.op U))) x, i U (a • x) = a • i U x) →
      (∀ U (a : ↑(C.presheaf.obj (Opposite.op U))) x, q U (a • x) = a • q U x) →
      (∀ {U W : C.Opens} (h : W ≤ U) x, i W (F₁.res h x) = F₂.res h (i U x)) →
      (∀ {U W : C.Opens} (h : W ≤ U) x, q W (F₂.res h x) = F₃.res h (q U x)) →
      (∀ U, Function.Injective (i U)) →
      (∀ U, Function.Surjective (q U)) →
      (∀ U x, q U x = 0 ↔ ∃ y, i U y = x) →
      HasFiniteWeilModuleCechCohomology g V F₁ →
      HasFiniteWeilModuleCechCohomology g V F₃ →
      HasFiniteWeilModuleCechCohomology g V F₂ :=
    fun F₁ F₂ F₃ i q hi_s hq_s hi_r hq_r hi_inj hq_surj h_ex =>
      (hSES (fun _ => True) (fun _ => trivial) F₁ F₂ F₃
        (fun U _ => i U) (fun U _ => q U)
        (fun U _ => hi_s U) (fun U _ => hq_s U)
        (fun _ _ => hi_r) (fun _ _ => hq_r)
        (fun U _ => hi_inj U) (fun U _ => hq_surj U)
        (fun U _ => h_ex U)).1
  refine hPillar2 S hZero hExt hSmaller ?_ F hCohF hSuppF
  rintro ⟨hNeS, hIrrS⟩ F₀ hCohF₀ hAnnF₀
  obtain ⟨F_Z, hFZ_struct, hFZ_fin⟩ := hIrredStruct ⟨hNeS, hIrrS⟩
  obtain ⟨_, hExistsUne, hInterActive, hDomainB, hBirat, hPillar3⟩ :=
    hPart3 hNeS hIrrS hAffInter hNoethU hFlatRes hSubQuot hProperSupp
  exact hPillar3 hExt hSmaller
    (fun F₁ hCohF₁ hAnnF₁ hTF_F₁ =>
      hPart4 hAffInter hChartS hNoethU hFlatRes hSubQuot hProperSupp
        hZero hSES hExistsUne hInterActive hDomainB hBirat
        F_Z hFZ_struct hFZ_fin F₁ hCohF₁ hAnnF₁ hTF_F₁)
    F₀ hCohF₀ hAnnF₀

theorem weil_proper_noetherian_lineBundle_cech_cohomology_finite (hChow : ∀ (R₀ : Type u) [CommRing R₀] [IsNoetherianRing R₀]
      (Z : AlgebraicGeometry.Scheme.{u})
      (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀)),
      AlgebraicGeometry.IsIntegral Z →
      AlgebraicGeometry.IsProper g_Z →
      ∃ (U_dense : Z.Opens) (N : ℕ) (Z' : AlgebraicGeometry.Scheme.{u})
        (π : Z' ⟶ Z)
        (ι_proj : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₀) :=
                    MvPolynomial.gradedAlgebra
                  Z' ⟶ AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₀)),
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₀) :=
          MvPolynomial.gradedAlgebra
        Nonempty ↥U_dense ∧
        AlgebraicGeometry.IsAffineOpen U_dense ∧
        AlgebraicGeometry.IsProper π ∧
        CategoryTheory.IsIso (π ∣_ U_dense) ∧
        AlgebraicGeometry.IsClosedImmersion ι_proj ∧
        π ≫ g_Z =
          ι_proj ≫
            AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₀) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (algebraMap R₀ ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R₀ 0))))
    (R : Type u) [CommRing R] [IsNoetherianRing R]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hProp : AlgebraicGeometry.IsProper g)
    (M : WeilLineBundle C)
    (hAffM : ∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a)) :
    (∃ (k₀ : ℕ) (gen₀ : Fin k₀ → WeilTricanonicalCechCochain M 0),
      (∀ j : Fin k₀, weilTricanonicalCechDiff M 0 (gen₀ j) = 0) ∧
      ∀ z : WeilTricanonicalCechCochain M 0,
        weilTricanonicalCechDiff M 0 z = 0 →
        ∃ c : Fin k₀ → R,
          z = ∑ j : Fin k₀, weilCechSmul g M 0 (c j) (gen₀ j)) ∧
    (∀ p : ℕ,
      ∃ (k : ℕ) (gen : Fin k → WeilTricanonicalCechCochain M (p + 1)),
        (∀ j : Fin k, weilTricanonicalCechDiff M (p + 1) (gen j) = 0) ∧
        ∀ z : WeilTricanonicalCechCochain M (p + 1),
          weilTricanonicalCechDiff M (p + 1) z = 0 →
          ∃ (c : Fin k → R) (b : WeilTricanonicalCechCochain M p),
            z = (∑ j : Fin k, weilCechSmul g M (p + 1) (c j) (gen j)) +
              weilTricanonicalCechDiff M p b) :=
by
  have : AlgebraicGeometry.IsProper g := hProp
  have : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Spec (CommRingCat.of R)) :=
    AlgebraicGeometry.isLocallyNoetherian_Spec.mpr ‹IsNoetherianRing R›
  have : AlgebraicGeometry.IsLocallyNoetherian C :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian g
  have : CompactSpace ↥C :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace g
  have : AlgebraicGeometry.IsNoetherian C := AlgebraicGeometry.IsNoetherian.mk
  have : TopologicalSpace.NoetherianSpace ↥C := AlgebraicGeometry.IsNoetherian.noetherianSpace
  have hMapComp : ∀ {U₁ U₂ U₃ : C.Opens} (h₁₂ : U₂ ≤ U₁) (h₂₃ : U₃ ≤ U₂) (h₁₃ : U₃ ≤ U₁)
      (x : ↑(C.presheaf.obj (Opposite.op U₁))),
      (C.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom
        ((C.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom x) =
      (C.presheaf.map (CategoryTheory.homOfLE h₁₃).op).hom x := by
    intro U₁ U₂ U₃ h₁₂ h₂₃ h₁₃ x
    have hHom : (CategoryTheory.homOfLE h₁₂).op ≫ (CategoryTheory.homOfLE h₂₃).op =
        (CategoryTheory.homOfLE h₁₃).op := by
      rw [← op_comp, CategoryTheory.homOfLE_comp]
    calc (C.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom
           ((C.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom x)
        = (C.presheaf.map (CategoryTheory.homOfLE h₁₂).op ≫
             C.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom x := rfl
      _ = (C.presheaf.map (CategoryTheory.homOfLE h₁₃).op).hom x := by
           rw [← C.presheaf.map_comp, hHom]
  have hMapId : ∀ (U₁ : C.Opens) (h₁₁ : U₁ ≤ U₁) (x : ↑(C.presheaf.obj (Opposite.op U₁))),
      (C.presheaf.map (CategoryTheory.homOfLE h₁₁).op).hom x = x := by
    intro U₁ h₁₁ x
    have hHom : CategoryTheory.homOfLE h₁₁ = 𝟙 U₁ := Subsingleton.elim _ _
    rw [hHom, op_id, C.presheaf.map_id]
    rfl
  let tricanAddSub : ∀ U : C.Opens,
      AddSubgroup (∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (U ⊓ M.V a)))) :=
    fun U =>
      { carrier := { s | IsWeilTricanonicalSection M U s }
        zero_mem' := by
          intro a b
          change (C.presheaf.map _).hom 0 = _ * (C.presheaf.map _).hom 0
          rw [map_zero, map_zero, mul_zero]
        add_mem' := by
          intro s₁ s₂ hs₁ hs₂ a b
          change (C.presheaf.map _).hom (s₁ a + s₂ a) =
            _ * (C.presheaf.map _).hom (s₁ b + s₂ b)
          rw [map_add, map_add, hs₁ a b, hs₂ a b, mul_add]
        neg_mem' := by
          intro s hs a b
          change (C.presheaf.map _).hom (-s a) = _ * (C.presheaf.map _).hom (-s b)
          rw [map_neg, map_neg, hs a b, mul_neg] }
  let smulTrican : ∀ (U : C.Opens),
      ↑(C.presheaf.obj (Opposite.op U)) → ↥(tricanAddSub U) → ↥(tricanAddSub U) :=
    fun U r s =>
      ⟨fun a =>
        (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U ⊓ M.V a ≤ U)).op).hom r * s.1 a,
        by
          intro a b
          dsimp only
          rw [map_mul, map_mul,
            hMapComp (inf_le_left : U ⊓ M.V a ≤ U) (inf_le_inf_left U inf_le_left)
              (inf_le_left : U ⊓ (M.V a ⊓ M.V b) ≤ U),
            hMapComp (inf_le_left : U ⊓ M.V b ≤ U) (inf_le_inf_left U inf_le_right)
              (inf_le_left : U ⊓ (M.V a ⊓ M.V b) ≤ U),
            s.2 a b]
          ring⟩
  let instModTrican : ∀ (U : C.Opens),
      Module ↑(C.presheaf.obj (Opposite.op U)) ↥(tricanAddSub U) :=
    fun U =>
      { smul := smulTrican U
        one_smul := fun s => Subtype.ext (funext fun a => by
          change (C.presheaf.map _).hom 1 * s.1 a = s.1 a
          rw [map_one, one_mul])
        mul_smul := fun r₁ r₂ s => Subtype.ext (funext fun a => by
          change (C.presheaf.map _).hom (r₁ * r₂) * s.1 a =
            (C.presheaf.map _).hom r₁ * ((C.presheaf.map _).hom r₂ * s.1 a)
          rw [map_mul, mul_assoc])
        smul_zero := fun r => Subtype.ext (funext fun a => by
          change (C.presheaf.map _).hom r * 0 = 0
          rw [mul_zero])
        smul_add := fun r s₁ s₂ => Subtype.ext (funext fun a => by
          change (C.presheaf.map _).hom r * (s₁.1 a + s₂.1 a) =
            (C.presheaf.map _).hom r * s₁.1 a + (C.presheaf.map _).hom r * s₂.1 a
          rw [mul_add])
        add_smul := fun r₁ r₂ s => Subtype.ext (funext fun a => by
          change (C.presheaf.map _).hom (r₁ + r₂) * s.1 a =
            (C.presheaf.map _).hom r₁ * s.1 a + (C.presheaf.map _).hom r₂ * s.1 a
          rw [map_add, add_mul])
        zero_smul := fun s => Subtype.ext (funext fun a => by
          change (C.presheaf.map _).hom 0 * s.1 a = 0
          rw [map_zero, zero_mul]) }
  let resTrican : ∀ {U W : C.Opens}, W ≤ U → (↥(tricanAddSub U) →+ ↥(tricanAddSub W)) :=
    fun {U W} hWU =>
      { toFun := fun s =>
          ⟨fun a =>
            (C.presheaf.map (CategoryTheory.homOfLE (inf_le_inf_right (M.V a) hWU)).op).hom
              (s.1 a),
            by
              intro a b
              dsimp only
              have h_ab : W ⊓ (M.V a ⊓ M.V b) ≤ U ⊓ (M.V a ⊓ M.V b) :=
                inf_le_inf_right _ hWU
              have hs_ab := congrArg
                (C.presheaf.map (CategoryTheory.homOfLE h_ab).op).hom (s.2 a b)
              rw [map_mul, map_pow] at hs_ab
              rw [hMapComp (inf_le_inf_right (M.V a) hWU) (inf_le_inf_left W inf_le_left)
                  (le_trans h_ab (inf_le_inf_left U inf_le_left)),
                hMapComp (inf_le_inf_right (M.V b) hWU) (inf_le_inf_left W inf_le_right)
                  (le_trans h_ab (inf_le_inf_left U inf_le_right))]
              rw [← hMapComp (inf_le_inf_left U inf_le_left) h_ab
                  (le_trans h_ab (inf_le_inf_left U inf_le_left)),
                ← hMapComp (inf_le_inf_left U inf_le_right) h_ab
                  (le_trans h_ab (inf_le_inf_left U inf_le_right)),
                ← hMapComp (inf_le_right : U ⊓ (M.V a ⊓ M.V b) ≤ M.V a ⊓ M.V b) h_ab
                  (inf_le_right : W ⊓ (M.V a ⊓ M.V b) ≤ M.V a ⊓ M.V b)]
              exact hs_ab⟩
        map_zero' := Subtype.ext (funext fun a => by
          change (C.presheaf.map _).hom 0 = 0
          rw [map_zero])
        map_add' := fun s₁ s₂ => Subtype.ext (funext fun a => by
          change (C.presheaf.map _).hom (s₁.1 a + s₂.1 a) = _ + _
          rw [map_add]) }
  let F_M : WeilPresheafModule C :=
    { sec := fun U => ↥(tricanAddSub U)
      instAddCommGroup := fun U => inferInstance
      instModule := instModTrican
      res := fun h => resTrican h
      res_smul := fun {U W} h r s => Subtype.ext (funext fun a => by
        change (C.presheaf.map _).hom ((C.presheaf.map _).hom r * s.1 a) =
          (C.presheaf.map _).hom ((C.presheaf.map _).hom r) * (C.presheaf.map _).hom (s.1 a)
        rw [map_mul,
          hMapComp (inf_le_left : U ⊓ M.V a ≤ U) (inf_le_inf_right (M.V a) h)
            (le_trans (inf_le_left : W ⊓ M.V a ≤ W) h),
          hMapComp h (inf_le_left : W ⊓ M.V a ≤ W)
            (le_trans (inf_le_left : W ⊓ M.V a ≤ W) h)])
      res_id := fun U s => Subtype.ext (funext fun a => by
        exact hMapId (U ⊓ M.V a) _ (s.1 a))
      res_comp := fun {U W T} h₁ h₂ s => Subtype.ext (funext fun a => by
        exact hMapComp _ _ _ (s.1 a)) }
  let evLin : ∀ (U : C.Opens) (a₀ : Fin M.m) (_ : U ≤ M.V a₀),
      F_M.sec U →ₗ[↑(C.presheaf.obj (Opposite.op U))] ↑(C.presheaf.obj (Opposite.op U)) :=
    fun U a₀ hUa₀ =>
      { toFun := fun s =>
          (C.presheaf.map (CategoryTheory.homOfLE (le_inf (le_refl U) hUa₀)).op).hom (s.1 a₀)
        map_add' := fun s₁ s₂ => by
          change (C.presheaf.map _).hom (s₁.1 a₀ + s₂.1 a₀) = _ + _
          rw [map_add]
        map_smul' := fun r s => by
          change (C.presheaf.map _).hom ((C.presheaf.map _).hom r * s.1 a₀) = r • _
          rw [map_mul, hMapComp _ _ (le_refl U), hMapId U (le_refl U) r, smul_eq_mul] }
  let trivLin : ∀ (U : C.Opens) (a₀ : Fin M.m) (_ : U ≤ M.V a₀),
      ↑(C.presheaf.obj (Opposite.op U)) →ₗ[↑(C.presheaf.obj (Opposite.op U))] F_M.sec U :=
    fun U a₀ hUa₀ =>
      { toFun := fun x =>
          ⟨fun b =>
            ((C.presheaf.map (CategoryTheory.homOfLE
              (le_inf (inf_le_right : U ⊓ M.V b ≤ M.V b)
                (le_trans (inf_le_left : U ⊓ M.V b ≤ U) hUa₀))).op).hom
              (M.u b a₀).val) ^ 3 *
              (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U ⊓ M.V b ≤ U)).op).hom x,
            by
              intro a b
              dsimp only
              have hT : U ⊓ (M.V a ⊓ M.V b) ≤ M.V a ⊓ M.V b ⊓ M.V a₀ :=
                le_inf inf_le_right (le_trans inf_le_left hUa₀)
              have hcoc := congrArg
                (fun y => ((C.presheaf.map (CategoryTheory.homOfLE hT).op).hom y) ^ 3)
                (M.u_cocycle a b a₀)
              rw [map_mul, mul_pow,
                hMapComp _ _ (inf_le_right : U ⊓ (M.V a ⊓ M.V b) ≤ M.V a ⊓ M.V b),
                hMapComp _ _ (le_inf (le_trans inf_le_right inf_le_right)
                  (le_trans inf_le_left hUa₀)),
                hMapComp _ _ (le_inf (le_trans inf_le_right inf_le_left)
                  (le_trans inf_le_left hUa₀))] at hcoc
              rw [map_mul, map_pow, map_mul, map_pow,
                hMapComp _ _ (le_inf (le_trans inf_le_right inf_le_left)
                  (le_trans inf_le_left hUa₀)),
                hMapComp _ _ (inf_le_left : U ⊓ (M.V a ⊓ M.V b) ≤ U),
                hMapComp _ _ (le_inf (le_trans inf_le_right inf_le_right)
                  (le_trans inf_le_left hUa₀)),
                hMapComp (inf_le_left : U ⊓ M.V b ≤ U) _
                  (inf_le_left : U ⊓ (M.V a ⊓ M.V b) ≤ U),
                ← hcoc, mul_assoc]⟩
        map_add' := fun x₁ x₂ => Subtype.ext (funext fun b => by
          change _ * (C.presheaf.map _).hom (x₁ + x₂) = _ * _ + _ * _
          rw [map_add, mul_add])
        map_smul' := fun r x => Subtype.ext (funext fun b => by
          change _ * (C.presheaf.map _).hom (r • x) =
            (C.presheaf.map _).hom r * (_ * (C.presheaf.map _).hom x)
          rw [smul_eq_mul, map_mul]
          ring) }
  let evEquiv : ∀ (U : C.Opens) (a₀ : Fin M.m) (hUa₀ : U ≤ M.V a₀),
      F_M.sec U ≃ₗ[↑(C.presheaf.obj (Opposite.op U))] ↑(C.presheaf.obj (Opposite.op U)) :=
    fun U a₀ hUa₀ =>
      LinearEquiv.ofLinearMap (evLin U a₀ hUa₀) (trivLin U a₀ hUa₀)
        (LinearMap.ext fun x => by
          change (C.presheaf.map _).hom (((C.presheaf.map _).hom (M.u a₀ a₀).val) ^ 3 *
            (C.presheaf.map _).hom x) = x
          rw [M.u_refl a₀, map_one, one_pow, one_mul, hMapComp _ _ (le_refl U),
            hMapId U (le_refl U) x])
        (LinearMap.ext fun s => Subtype.ext (funext fun b => by
          change ((C.presheaf.map _).hom (M.u b a₀).val) ^ 3 *
            (C.presheaf.map _).hom ((C.presheaf.map _).hom (s.1 a₀)) = s.1 b
          have h_ub : U ⊓ M.V b ≤ U ⊓ (M.V b ⊓ M.V a₀) :=
            le_inf inf_le_left (le_inf inf_le_right (le_trans inf_le_left hUa₀))
          have hsb := congrArg
            (C.presheaf.map (CategoryTheory.homOfLE h_ub).op).hom (s.2 b a₀)
          rw [map_mul, map_pow,
            hMapComp _ _ (le_refl (U ⊓ M.V b)),
            hMapId (U ⊓ M.V b) _ (s.1 b),
            hMapComp _ _ (le_inf (inf_le_right : U ⊓ M.V b ≤ M.V b)
              (le_trans (inf_le_left : U ⊓ M.V b ≤ U) hUa₀)),
            hMapComp _ _ (le_trans (inf_le_left : U ⊓ M.V b ≤ U) (le_inf (le_refl U) hUa₀))] at hsb
          rw [hMapComp (le_inf (le_refl U) hUa₀) (inf_le_left : U ⊓ M.V b ≤ U)
            (le_trans (inf_le_left : U ⊓ M.V b ≤ U) (le_inf (le_refl U) hUa₀))]
          exact hsb.symm))
  have hEvRes : ∀ {U W : C.Opens} (hWU : W ≤ U) (a₀ : Fin M.m) (hUa₀ : U ≤ M.V a₀)
      (s : F_M.sec U),
      evEquiv W a₀ (le_trans hWU hUa₀) (F_M.res hWU s) =
        (C.presheaf.map (CategoryTheory.homOfLE hWU).op).hom (evEquiv U a₀ hUa₀ s) := by
    intro U W hWU a₀ hUa₀ s
    change (C.presheaf.map _).hom ((C.presheaf.map _).hom (s.1 a₀)) =
      (C.presheaf.map _).hom ((C.presheaf.map _).hom (s.1 a₀))
    rw [hMapComp _ _ (le_trans hWU (le_inf (le_refl U) hUa₀)),
      hMapComp _ _ (le_trans hWU (le_inf (le_refl U) hUa₀))]
  have hCohM : IsWeilCoherentSubChartModule M.V F_M := by
    refine ⟨?_, ?_⟩
    · intro U _ ⟨a₀, hUa₀⟩
      have : Module.Finite ↑(C.presheaf.obj (Opposite.op U)) ↑(C.presheaf.obj (Opposite.op U)) :=
        Module.Finite.self _
      exact Module.Finite.equiv (evEquiv U a₀ hUa₀).symm
    · intro U W _ _ ⟨a₀, hUa₀⟩ hWU
      let A_U := ↑(C.presheaf.obj (Opposite.op U))
      let A_W := ↑(C.presheaf.obj (Opposite.op W))
      let _ : Algebra A_U A_W :=
        RingHom.toAlgebra (C.presheaf.map (CategoryTheory.homOfLE hWU).op).hom
      have hWa₀ : W ≤ M.V a₀ := le_trans hWU hUa₀
      let eU := evEquiv U a₀ hUa₀
      let eW := evEquiv W a₀ hWa₀
      let e₁ : TensorProduct A_U A_W (F_M.sec U) ≃ₗ[A_W] TensorProduct A_U A_W A_U :=
        LinearEquiv.ofLinearMap
          (TensorProduct.AlgebraTensorModule.lTensor A_W A_W eU.toLinearMap)
          (TensorProduct.AlgebraTensorModule.lTensor A_W A_W eU.symm.toLinearMap)
          (by ext; simp)
          (by ext; simp)
      let φ : TensorProduct A_U A_W (F_M.sec U) ≃ₗ[A_W] F_M.sec W :=
        (e₁.trans (TensorProduct.AlgebraTensorModule.rid A_U A_W A_W)).trans eW.symm
      refine ⟨φ, fun b x => ?_⟩
      apply eW.injective
      have hlhs : eW (φ (TensorProduct.tmul A_U b x)) =
          (C.presheaf.map (CategoryTheory.homOfLE hWU).op).hom (eU x) * b := by
        change eW (eW.symm ((TensorProduct.AlgebraTensorModule.rid A_U A_W A_W)
          ((TensorProduct.AlgebraTensorModule.lTensor A_W A_W eU.toLinearMap)
            (TensorProduct.tmul A_U b x)))) = _
        rw [LinearEquiv.apply_symm_apply, TensorProduct.AlgebraTensorModule.lTensor_tmul,
          TensorProduct.AlgebraTensorModule.rid_tmul]
        rfl
      have hrhs : eW (b • F_M.res hWU x) =
          b * (C.presheaf.map (CategoryTheory.homOfLE hWU).op).hom (eU x) := by
        rw [LinearEquiv.map_smul, smul_eq_mul, hEvRes hWU a₀ hUa₀ x]
      rw [hlhs, hrhs, mul_comm]
  have hSuppM : IsWeilSupportedOn M.V F_M ⊤ := by
    intro U hU ⟨a₀, hUa₀⟩ hDisj x
    have hEmpSpec : IsEmpty (PrimeSpectrum ↑(C.presheaf.obj (Opposite.op U))) := by
      refine ⟨fun p => ?_⟩
      let y : ↥U := hU.isoSpec.inv.base p
      exact Set.disjoint_left.mp hDisj y.2 trivial
    have : Subsingleton ↑(C.presheaf.obj (Opposite.op U)) :=
      PrimeSpectrum.isEmpty_iff_subsingleton.mp hEmpSpec
    exact (evEquiv U a₀ hUa₀).injective (Subsingleton.elim _ _)
  let hα0 : ∀ {p : ℕ} (α : WeilStrictMonoTuple M.m p),
      weilCoverChartInter M.V α ≤ M.V (α.1 0) :=
    fun α => Finset.inf'_le _ (Finset.mem_univ (0 : Fin (_ + 1)))
  let Ψ : ∀ (p : ℕ), WeilModuleCechCochain M.V F_M p → WeilTricanonicalCechCochain M p :=
    fun p s α => evEquiv (weilCoverChartInter M.V α) (α.1 0) (hα0 α) (s α)
  let Ψ_inv : ∀ (p : ℕ), WeilTricanonicalCechCochain M p → WeilModuleCechCochain M.V F_M p :=
    fun p c α => (evEquiv (weilCoverChartInter M.V α) (α.1 0) (hα0 α)).symm (c α)
  have hΨ_right : ∀ (p : ℕ) (c : WeilTricanonicalCechCochain M p), Ψ p (Ψ_inv p c) = c := by
    intro p c
    funext α
    exact LinearEquiv.apply_symm_apply _ (c α)
  have hΨ_left : ∀ (p : ℕ) (s : WeilModuleCechCochain M.V F_M p), Ψ_inv p (Ψ p s) = s := by
    intro p s
    funext α
    exact LinearEquiv.symm_apply_apply _ (s α)
  have hΨ_zero : ∀ (p : ℕ), Ψ p 0 = 0 := by
    intro p
    funext α
    exact map_zero (evEquiv (weilCoverChartInter M.V α) (α.1 0) (hα0 α))
  have hΨ_add : ∀ (p : ℕ) (s₁ s₂ : WeilModuleCechCochain M.V F_M p),
      Ψ p (s₁ + s₂) = Ψ p s₁ + Ψ p s₂ := by
    intro p s₁ s₂
    funext α
    exact map_add (evEquiv (weilCoverChartInter M.V α) (α.1 0) (hα0 α)) (s₁ α) (s₂ α)
  have hΨ_sum : ∀ (p : ℕ) {ι : Type} (I : Finset ι) (f : ι → WeilModuleCechCochain M.V F_M p),
      Ψ p (∑ i ∈ I, f i) = ∑ i ∈ I, Ψ p (f i) := by
    intro p ι I f
    classical
    induction I using Finset.induction_on with
    | empty => simp [hΨ_zero]
    | insert i I hi ih => simp [Finset.sum_insert hi, hΨ_add, ih]
  have hΨ_smul : ∀ (p : ℕ) (r : R) (s : WeilModuleCechCochain M.V F_M p),
      Ψ p (weilModuleCechSmul g M.V F_M p r s) = weilCechSmul g M p r (Ψ p s) := by
    intro p r s
    funext α
    let r_α : ↑(C.presheaf.obj (Opposite.op (weilCoverChartInter M.V α))) :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
        g.appLE ⊤ (weilCoverChartInter M.V α) (fun _ _ => trivial)).hom r)
    have h_eq : evEquiv (weilCoverChartInter M.V α) (α.1 0) (hα0 α) (r_α • s α) =
        r_α * evEquiv (weilCoverChartInter M.V α) (α.1 0) (hα0 α) (s α) := by
      rw [LinearEquiv.map_smul, smul_eq_mul]
    exact h_eq
  have hΨ_diff : ∀ (p : ℕ) (s : WeilModuleCechCochain M.V F_M p),
      Ψ (p + 1) (weilModuleCechDiff M.V F_M p s) = weilTricanonicalCechDiff M p (Ψ p s) := by
    intro p s
    funext β
    let face : Fin (p + 2) → WeilStrictMonoTuple M.m p :=
      fun j => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
    let hFace : ∀ j : Fin (p + 2),
        weilCoverChartInter M.V β ≤ weilCoverChartInter M.V (face j) :=
      fun j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
    let evβ := evEquiv (weilCoverChartInter M.V β) (β.1 0) (hα0 β)
    change evβ (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • F_M.res (hFace j) (s (face j))) =
      weilTricanonicalCechDiff M p (Ψ p s) β
    rw [Fin.sum_univ_succ, map_add, map_sum]
    congr 1
    · simp only [Fin.val_zero, pow_zero, one_smul]
      let x0 : ↑(C.presheaf.obj (Opposite.op (weilCoverChartInter M.V (face 0)))) :=
        evEquiv (weilCoverChartInter M.V (face 0)) ((face 0).1 0) (hα0 (face 0)) (s (face 0))
      have hs0 : s (face 0) =
          (evEquiv (weilCoverChartInter M.V (face 0)) ((face 0).1 0) (hα0 (face 0))).symm x0 :=
        (LinearEquiv.symm_apply_apply _ (s (face 0))).symm
      have hFace0_idx : (face 0).1 0 = β.1 1 := by
        change β.1 (Fin.succAbove 0 0) = β.1 1
        rw [Fin.zero_succAbove]
        rfl
      have h01 : weilCoverChartInter M.V β ≤ M.V (β.1 0) ⊓ M.V (β.1 1) :=
        le_inf (Finset.inf'_le _ (Finset.mem_univ (0 : Fin (p + 2))))
          (Finset.inf'_le _ (Finset.mem_univ (1 : Fin (p + 2))))
      have hTerm0 :
          evβ (F_M.res (hFace 0) (s (face 0))) =
          ((C.presheaf.map (CategoryTheory.homOfLE h01).op).hom (M.u (β.1 0) (β.1 1)).val) ^ 3 *
            (C.presheaf.map (CategoryTheory.homOfLE (hFace 0)).op).hom x0 := by
        change (C.presheaf.map (CategoryTheory.homOfLE (le_inf (le_refl _) (hα0 β))).op).hom
          ((C.presheaf.map (CategoryTheory.homOfLE
            (inf_le_inf_right (M.V (β.1 0)) (hFace 0))).op).hom ((s (face 0)).1 (β.1 0))) = _
        rw [hs0]
        change (C.presheaf.map (CategoryTheory.homOfLE (le_inf (le_refl _) (hα0 β))).op).hom
          ((C.presheaf.map (CategoryTheory.homOfLE
            (inf_le_inf_right (M.V (β.1 0)) (hFace 0))).op).hom
            (((C.presheaf.map (CategoryTheory.homOfLE
                (le_inf inf_le_right (le_trans inf_le_left (hα0 (face 0))))).op).hom
                (M.u (β.1 0) ((face 0).1 0)).val) ^ 3 *
              (C.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom x0)) = _
        rw [map_mul, map_pow, map_mul, map_pow]
        have h_u_gen : ∀ (a₁ a₂ : Fin M.m) (ha : a₁ = a₂)
            (h_f0 : weilCoverChartInter M.V (face 0) ≤ M.V a₁)
            (h_01 : weilCoverChartInter M.V β ≤ M.V (β.1 0) ⊓ M.V a₂),
            (C.presheaf.map (CategoryTheory.homOfLE (le_inf (le_refl _) (hα0 β))).op).hom
              ((C.presheaf.map (CategoryTheory.homOfLE
                (inf_le_inf_right (M.V (β.1 0)) (hFace 0))).op).hom
                ((C.presheaf.map (CategoryTheory.homOfLE
                  (le_inf inf_le_right (le_trans inf_le_left h_f0))).op).hom
                  (M.u (β.1 0) a₁).val)) =
            (C.presheaf.map (CategoryTheory.homOfLE h_01).op).hom (M.u (β.1 0) a₂).val := by
          intro a₁ a₂ ha h_f0 h_01
          subst ha
          rw [hMapComp (le_inf inf_le_right (le_trans inf_le_left h_f0))
              (inf_le_inf_right (M.V (β.1 0)) (hFace 0))
              (le_inf inf_le_right (le_trans inf_le_left (le_trans (hFace 0) h_f0))),
            hMapComp _ (le_inf (le_refl _) (hα0 β)) h_01]
        rw [h_u_gen ((face 0).1 0) (β.1 1) hFace0_idx (hα0 (face 0)) h01,
          hMapComp inf_le_left (inf_le_inf_right (M.V (β.1 0)) (hFace 0))
            (le_trans inf_le_left (hFace 0)),
          hMapComp (le_trans inf_le_left (hFace 0)) (le_inf (le_refl _) (hα0 β)) (hFace 0)]
      exact hTerm0
    · refine Finset.sum_congr rfl fun k _ => ?_
      rw [map_zsmul, zsmul_eq_mul]
      let xk : ↑(C.presheaf.obj (Opposite.op (weilCoverChartInter M.V (face k.succ)))) :=
        evEquiv (weilCoverChartInter M.V (face k.succ)) ((face k.succ).1 0) (hα0 (face k.succ))
          (s (face k.succ))
      have hIdx : (face k.succ).1 0 = β.1 0 := by
        change β.1 (k.succ.succAbove 0) = β.1 0
        rw [Fin.succ_succAbove_zero]
      have hEvCongrIdx : ∀ (U : C.Opens) (a₁ a₂ : Fin M.m) (ha : a₁ = a₂)
          (h₁ : U ≤ M.V a₁) (h₂ : U ≤ M.V a₂) (t : F_M.sec U),
          evEquiv U a₁ h₁ t = evEquiv U a₂ h₂ t := by
        intro U a₁ a₂ ha h₁ h₂ t
        subst ha
        rfl
      have hVal : evβ (F_M.res (hFace k.succ) (s (face k.succ))) =
          (C.presheaf.map (CategoryTheory.homOfLE (hFace k.succ)).op).hom xk := by
        rw [← hEvRes (hFace k.succ) ((face k.succ).1 0) (hα0 (face k.succ)) (s (face k.succ))]
        exact hEvCongrIdx (weilCoverChartInter M.V β) (β.1 0) ((face k.succ).1 0) hIdx.symm
          (hα0 β) (le_trans (hFace k.succ) (hα0 (face k.succ)))
          (F_M.res (hFace k.succ) (s (face k.succ)))
      rw [hVal, Fin.val_succ, Int.cast_pow, Int.cast_neg, Int.cast_one]
      rfl
  have hMain : ∀ (S : TopologicalSpace.Closeds ↥C) (F : WeilPresheafModule C),
      IsWeilCoherentSubChartModule M.V F →
      IsWeilSupportedOn M.V F S →
      HasFiniteWeilModuleCechCohomology g M.V F := by
    intro S
    refine WellFoundedLT.induction
      (motive := fun S₁ => ∀ (F : WeilPresheafModule C),
        IsWeilCoherentSubChartModule M.V F →
        IsWeilSupportedOn M.V F S₁ →
        HasFiniteWeilModuleCechCohomology g M.V F) S ?_
    intro S₁ ih F hCohF hSuppF
    refine weil_noetherian_coherent_devissage_step R C g hProp M.m M.V hAffM M.hCov S₁ ih ?_ F
      hCohF hSuppF
    rintro ⟨hNe, hIrr⟩
    exact weil_chow_integral_structureSheaf_cohomology_from_proper_support hChow
      (fun B _ _ N G hCohG => weil_serre_proj_coherent_cech_cohomology_finite B N G hCohG)
      R C g hProp M.m M.V hAffM M.hCov S₁ hNe hIrr ih
  obtain ⟨⟨k₀, gen₀, hgen₀_ker, hgen₀_span⟩, hSucc⟩ := hMain ⊤ F_M hCohM hSuppM
  refine ⟨⟨k₀, fun j => Ψ 0 (gen₀ j), ?_, ?_⟩, ?_⟩
  · intro j
    rw [← hΨ_diff 0 (gen₀ j), hgen₀_ker j, hΨ_zero 1]
  · intro z hz
    have hz_mod : weilModuleCechDiff M.V F_M 0 (Ψ_inv 0 z) = 0 := by
      have h1 : Ψ 1 (weilModuleCechDiff M.V F_M 0 (Ψ_inv 0 z)) = Ψ 1 0 := by
        rw [hΨ_diff 0, hΨ_right 0 z, hz, hΨ_zero 1]
      calc weilModuleCechDiff M.V F_M 0 (Ψ_inv 0 z)
          = Ψ_inv 1 (Ψ 1 (weilModuleCechDiff M.V F_M 0 (Ψ_inv 0 z))) := (hΨ_left 1 _).symm
        _ = Ψ_inv 1 (Ψ 1 0) := by rw [h1]
        _ = 0 := hΨ_left 1 0
    obtain ⟨c, hc⟩ := hgen₀_span (Ψ_inv 0 z) hz_mod
    refine ⟨c, ?_⟩
    calc z
        = Ψ 0 (Ψ_inv 0 z) := (hΨ_right 0 z).symm
      _ = Ψ 0 (∑ j : Fin k₀, weilModuleCechSmul g M.V F_M 0 (c j) (gen₀ j)) := by rw [hc]
      _ = ∑ j : Fin k₀, weilCechSmul g M 0 (c j) (Ψ 0 (gen₀ j)) := by
          rw [hΨ_sum]
          exact Finset.sum_congr rfl fun j _ => hΨ_smul 0 (c j) (gen₀ j)
  · intro p
    obtain ⟨k, gen, hgen_ker, hgen_span⟩ := hSucc p
    refine ⟨k, fun j => Ψ (p + 1) (gen j), ?_, ?_⟩
    · intro j
      rw [← hΨ_diff (p + 1) (gen j), hgen_ker j, hΨ_zero (p + 2)]
    · intro z hz
      have hz_mod : weilModuleCechDiff M.V F_M (p + 1) (Ψ_inv (p + 1) z) = 0 := by
        have h1 : Ψ (p + 2) (weilModuleCechDiff M.V F_M (p + 1) (Ψ_inv (p + 1) z)) =
            Ψ (p + 2) 0 := by
          rw [hΨ_diff (p + 1), hΨ_right (p + 1) z, hz, hΨ_zero (p + 2)]
        calc weilModuleCechDiff M.V F_M (p + 1) (Ψ_inv (p + 1) z)
            = Ψ_inv (p + 2) (Ψ (p + 2)
                (weilModuleCechDiff M.V F_M (p + 1) (Ψ_inv (p + 1) z))) :=
              (hΨ_left (p + 2) _).symm
          _ = Ψ_inv (p + 2) (Ψ (p + 2) 0) := by rw [h1]
          _ = 0 := hΨ_left (p + 2) 0
      obtain ⟨c, b₀, hzb₀⟩ := hgen_span (Ψ_inv (p + 1) z) hz_mod
      refine ⟨c, Ψ p b₀, ?_⟩
      calc z
          = Ψ (p + 1) (Ψ_inv (p + 1) z) := (hΨ_right (p + 1) z).symm
        _ = Ψ (p + 1) ((∑ j : Fin k, weilModuleCechSmul g M.V F_M (p + 1) (c j) (gen j)) +
              weilModuleCechDiff M.V F_M p b₀) := by rw [hzb₀]
        _ = (∑ j : Fin k, weilCechSmul g M (p + 1) (c j) (Ψ (p + 1) (gen j))) +
              weilTricanonicalCechDiff M p (Ψ p b₀) := by
            rw [hΨ_add, hΨ_sum, hΨ_diff]
            congr 1
            exact Finset.sum_congr rfl fun j _ => hΨ_smul (p + 1) (c j) (gen j)

theorem weil_flat_cochain_noetherian_nakayama_universal_free_baseChange (R : Type u) [CommRing R] [IsNoetherianRing R]
    (q : PrimeSpectrum R)
    (m r₀ : ℕ)
    (K : ℕ → Type u)
    [∀ p, AddCommGroup (K p)]
    [∀ p, Module R (K p)]
    (d : ∀ p : ℕ, K p →ₗ[R] K (p + 1))
    (hd2 : ∀ p x, d (p + 1) (d p x) = 0)
    (hBound : ∀ p, m ≤ p → Subsingleton (K p))
    (hFlat : ∀ p, Module.Flat R (K p))
    (hFin0 : Module.Finite R ↥(LinearMap.ker (d 0)))
    (hFinSucc : ∀ p : ℕ, Module.Finite R
      (↥(LinearMap.ker (d (p + 1))) ⧸
        (LinearMap.range (d p)).comap (LinearMap.ker (d (p + 1))).subtype))
    (hVan : ∀ p : ℕ,
      LinearMap.ker (LinearMap.baseChange q.asIdeal.ResidueField (d (p + 1))) ≤
        LinearMap.range (LinearMap.baseChange q.asIdeal.ResidueField (d p)))
    (hDim : Nonempty
      ((Fin (r₀ + 1) → q.asIdeal.ResidueField) ≃ₗ[q.asIdeal.ResidueField]
        ↥(LinearMap.ker (LinearMap.baseChange q.asIdeal.ResidueField (d 0))))) :
    ∃ (h : R) (_ : h ∉ q.asIdeal)
      (v : Fin (r₀ + 1) → TensorProduct R (Localization.Away h) (K 0)),
      ∀ (R' : Type u) [CommRing R'] [Algebra R R'] [Algebra (Localization.Away h) R']
        [IsScalarTower R (Localization.Away h) R'],
        let v' : Fin (r₀ + 1) → TensorProduct R R' (K 0) :=
          fun i => LinearMap.rTensor (K 0)
            (IsScalarTower.toAlgHom R (Localization.Away h) R').toLinearMap (v i)
        (∀ i : Fin (r₀ + 1), LinearMap.baseChange R' (d 0) (v' i) = 0) ∧
        (∀ x : TensorProduct R R' (K 0), LinearMap.baseChange R' (d 0) x = 0 →
          ∃! c : Fin (r₀ + 1) → R', x = ∑ i : Fin (r₀ + 1), c i • v' i) :=
by
  
  
  
  have hSubTensorR : ∀ (R₀ : Type u) [CommRing R₀] (W M : Type u)
      [AddCommGroup W] [Module R₀ W] [AddCommGroup M] [Module R₀ M],
      Subsingleton M → Subsingleton (TensorProduct R₀ W M) := by
    intro R₀ _ W M _ _ _ _ hSub
    have hz : ∀ z : TensorProduct R₀ W M, z = 0 := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => rfl
      | tmul w x => rw [Subsingleton.elim x 0, TensorProduct.tmul_zero]
      | add _ _ h1 h2 => rw [h1, h2, add_zero]
    exact ⟨fun x y => (hz x).trans (hz y).symm⟩
  have hFlatOfSub : ∀ (S₀ : Type u) [CommRing S₀] (M : Type u)
      [AddCommGroup M] [Module S₀ M], Subsingleton M → Module.Flat S₀ M := by
    intro S₀ _ M _ _ hSub
    rw [Module.Flat.iff_rTensor_injective']
    intro I
    have : Subsingleton (TensorProduct S₀ ↥I M) := hSubTensorR S₀ ↥I M hSub
    exact Function.injective_of_subsingleton _
  have hFlatKer : ∀ (S₀ : Type u) [CommRing S₀] (N P : Type u)
      [AddCommGroup N] [Module S₀ N] [Module.Flat S₀ N]
      [AddCommGroup P] [Module S₀ P] [Module.Flat S₀ P]
      (f : N →ₗ[S₀] P), Function.Surjective f →
      Module.Flat S₀ ↥(LinearMap.ker f) ∧
      ∀ (W : Type u) [AddCommGroup W] [Module S₀ W],
        Function.Injective (LinearMap.lTensor W (LinearMap.ker f).subtype) ∧
        LinearMap.range (LinearMap.lTensor W (LinearMap.ker f).subtype) =
          LinearMap.ker (LinearMap.lTensor W f) := by
    intro S₀ _ N P _ _ _ _ _ _ f hf
    have hW : ∀ (W : Type u) [AddCommGroup W] [Module S₀ W],
        Function.Injective (LinearMap.lTensor W (LinearMap.ker f).subtype) ∧
        LinearMap.range (LinearMap.lTensor W (LinearMap.ker f).subtype) =
          LinearMap.ker (LinearMap.lTensor W f) := by
      intro W _ _
      let e := (f.kerLTensorEquivOfSurjective hf W).symm
      have hcomp : LinearMap.lTensor W (LinearMap.ker f).subtype =
          (LinearMap.ker (LinearMap.lTensor W f)).subtype.comp e.toLinearMap := by
        apply TensorProduct.ext'
        intro w y
        exact (LinearMap.tensorKerEquivOfSurjective_symm_tmul f hf W w y).symm
      refine ⟨?_, ?_⟩
      · rw [hcomp]
        exact Subtype.val_injective.comp e.injective
      · ext x
        rw [hcomp, LinearMap.mem_range]
        constructor
        · rintro ⟨z, rfl⟩
          exact (e z).2
        · intro hx
          exact ⟨e.symm ⟨x, hx⟩, by simp⟩
    refine ⟨?_, hW⟩
    rw [Module.Flat.iff_rTensor_injective']
    intro I
    have hN_inj : Function.Injective (LinearMap.rTensor N I.subtype) :=
      Module.Flat.iff_rTensor_injective'.mp inferInstance I
    have hg_eq : (LinearMap.lTensor S₀ (LinearMap.ker f).subtype).comp
          (LinearMap.rTensor ↥(LinearMap.ker f) I.subtype) =
        (LinearMap.rTensor N I.subtype).comp
          (LinearMap.lTensor ↥I (LinearMap.ker f).subtype) := by
      apply TensorProduct.ext'
      intro x y
      rfl
    have hg_inj : Function.Injective
        ((LinearMap.lTensor S₀ (LinearMap.ker f).subtype).comp
          (LinearMap.rTensor ↥(LinearMap.ker f) I.subtype)) := by
      rw [hg_eq]
      exact hN_inj.comp (hW ↥I).1
    exact Function.Injective.of_comp hg_inj
  have hStepFlatKer : ∀ (S₀ : Type u) [CommRing S₀] (C₀ C₁ : Type u)
      [AddCommGroup C₀] [Module S₀ C₀] [Module.Flat S₀ C₀]
      [AddCommGroup C₁] [Module S₀ C₁]
      (δ₀ : C₀ →ₗ[S₀] C₁),
      Module.Flat S₀ ↥(LinearMap.range δ₀) →
      Module.Flat S₀ ↥(LinearMap.ker δ₀) ∧
      ∀ (W : Type u) [AddCommGroup W] [Module S₀ W],
        Function.Injective (LinearMap.lTensor W (LinearMap.range δ₀).subtype) →
        Function.Injective (LinearMap.lTensor W (LinearMap.ker δ₀).subtype) ∧
        LinearMap.range (LinearMap.lTensor W (LinearMap.ker δ₀).subtype) =
          LinearMap.ker (LinearMap.lTensor W δ₀) := by
    intro S₀ _ C₀ C₁ _ _ _ _ _ δ₀ hFlatRange
    have : Module.Flat S₀ ↥(LinearMap.range δ₀) := hFlatRange
    obtain ⟨hFK, hWK⟩ :=
      hFlatKer S₀ C₀ ↥(LinearMap.range δ₀) δ₀.rangeRestrict (LinearMap.surjective_rangeRestrict δ₀)
    have hker_eq : LinearMap.ker δ₀.rangeRestrict = LinearMap.ker δ₀ :=
      LinearMap.ker_rangeRestrict δ₀
    refine ⟨hker_eq ▸ hFK, ?_⟩
    intro W _ _ hInjRange
    obtain ⟨hInjK, hRangeK⟩ := hWK W
    have hInjK' : Function.Injective (LinearMap.lTensor W (LinearMap.ker δ₀).subtype) :=
      hker_eq ▸ hInjK
    have hRangeK' : LinearMap.range (LinearMap.lTensor W (LinearMap.ker δ₀).subtype) =
        LinearMap.ker (LinearMap.lTensor W δ₀.rangeRestrict) :=
      hker_eq ▸ hRangeK
    refine ⟨hInjK', hRangeK'.trans ?_⟩
    ext x
    rw [LinearMap.mem_ker, LinearMap.mem_ker]
    have hfac : LinearMap.lTensor W δ₀ x =
        LinearMap.lTensor W (LinearMap.range δ₀).subtype
          (LinearMap.lTensor W δ₀.rangeRestrict x) := by
      conv_lhs => rw [← LinearMap.subtype_comp_rangeRestrict δ₀]
      rw [LinearMap.lTensor_comp]
      rfl
    rw [hfac]
    exact ⟨fun hx => by rw [hx, map_zero],
      fun hx => hInjRange (hx.trans (map_zero _).symm)⟩
  have hCancelBC : ∀ (S₀ R₁ : Type u) [CommRing S₀] [Algebra R S₀]
      [CommRing R₁] [Algebra R R₁] [Algebra S₀ R₁] [IsScalarTower R S₀ R₁]
      (p : ℕ) (z : TensorProduct S₀ R₁ (TensorProduct R S₀ (K p))),
      (TensorProduct.AlgebraTensorModule.cancelBaseChange R S₀ R₁ R₁ (K (p + 1)))
          (LinearMap.baseChange R₁ (LinearMap.baseChange S₀ (d p)) z) =
        LinearMap.baseChange R₁ (d p)
          ((TensorProduct.AlgebraTensorModule.cancelBaseChange R S₀ R₁ R₁ (K p)) z) := by
    intro S₀ R₁ _ _ _ _ _ _ p z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul r₁ y =>
      induction y using TensorProduct.induction_on with
      | zero => simp
      | tmul s₀ x =>
        simp [LinearMap.baseChange_tmul, TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul]
      | add _ _ h1 h2 =>
        rw [TensorProduct.tmul_add, map_add, map_add, map_add, map_add, h1, h2]
    | add _ _ h1 h2 =>
      rw [map_add, map_add, map_add, map_add, h1, h2]

  
  
  
  let S_q : Submonoid R := q.asIdeal.primeCompl
  let B_subR : ∀ p : ℕ, Submodule R ↥(LinearMap.ker (d (p + 1))) :=
    fun p => (LinearMap.range (d p)).comap (LinearMap.ker (d (p + 1))).subtype
  have hStage1 : ∀ (A : Type u) [CommRing A] [Algebra R A]
      [IsLocalization S_q A] [IsLocalRing A],
      (∀ p : ℕ,
        LinearMap.ker (LinearMap.baseChange (IsLocalRing.ResidueField A) (d (p + 1))) ≤
          LinearMap.range (LinearMap.baseChange (IsLocalRing.ResidueField A) (d p))) →
      Nonempty
        ((Fin (r₀ + 1) → IsLocalRing.ResidueField A) ≃ₗ[IsLocalRing.ResidueField A]
          ↥(LinearMap.ker (LinearMap.baseChange (IsLocalRing.ResidueField A) (d 0)))) →
      (∀ p : ℕ, LinearMap.ker (LinearMap.baseChange A (d (p + 1))) ≤
        LinearMap.range (LinearMap.baseChange A (d p))) ∧
      ∃ (u : Fin (r₀ + 1) → ↥(LinearMap.ker (d 0))),
        (∀ z : TensorProduct R A (K 0), LinearMap.baseChange A (d 0) z = 0 →
          ∃ c : Fin (r₀ + 1) → A, z = ∑ i : Fin (r₀ + 1), c i • ((1 : A) ⊗ₜ[R] (u i).1)) ∧
        (∀ c : Fin (r₀ + 1) → A,
          ∑ i : Fin (r₀ + 1), c i • ((1 : A) ⊗ₜ[R] (u i).1) = 0 → c = 0) := by
    intro A _ _ _ _ hVan_loc hDim_loc
    let κ : Type u := IsLocalRing.ResidueField A
    have : Module.Flat R A := IsLocalization.flat A S_q
    have hFlat_A : ∀ p : ℕ, Module.Flat A (TensorProduct R A (K p)) :=
      fun p => Module.Flat.baseChange R A (K p)
    let d_A : ∀ p : ℕ, TensorProduct R A (K p) →ₗ[A] TensorProduct R A (K (p + 1)) :=
      fun p => LinearMap.baseChange A (d p)
    letI : ∀ p : ℕ, AddCommGroup ↥(LinearMap.ker (d_A p)) :=
      fun p => (LinearMap.ker (d_A p)).addCommGroup
    have hd2_A : ∀ p (z : TensorProduct R A (K p)), d_A (p + 1) (d_A p z) = 0 := by
      intro p z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a x => simp [d_A, LinearMap.baseChange_tmul, hd2]
      | add _ _ h1 h2 => rw [map_add, map_add, h1, h2, add_zero]
    have hBZ_le_A : ∀ p : ℕ, LinearMap.range (d_A p) ≤ LinearMap.ker (d_A (p + 1)) := by
      intro p y
      rintro ⟨x, rfl⟩
      exact hd2_A p x
    have hBound_A : ∀ p : ℕ, m ≤ p → Subsingleton (TensorProduct R A (K p)) :=
      fun p hp => hSubTensorR R A (K p) (hBound p hp)
    let e_κ : ∀ p : ℕ, TensorProduct A κ (TensorProduct R A (K p)) ≃ₗ[κ]
        TensorProduct R κ (K p) :=
      fun p => TensorProduct.AlgebraTensorModule.cancelBaseChange R A κ κ (K p)
    have hVan_A : ∀ p : ℕ,
        LinearMap.ker (LinearMap.baseChange κ (d_A (p + 1))) ≤
          LinearMap.range (LinearMap.baseChange κ (d_A p)) := by
      intro p z hz
      rw [LinearMap.mem_ker] at hz
      have hz' : LinearMap.baseChange κ (d (p + 1)) (e_κ (p + 1) z) = 0 := by
        rw [← hCancelBC A κ (p + 1) z, hz, map_zero]
      obtain ⟨w, hw⟩ := hVan_loc p hz'
      refine ⟨(e_κ p).symm w, (e_κ (p + 1)).injective ?_⟩
      rw [hCancelBC A κ p, LinearEquiv.apply_symm_apply, hw]
    have hDim_A : Nonempty
        ((Fin (r₀ + 1) → κ) ≃ₗ[κ] ↥(LinearMap.ker (LinearMap.baseChange κ (d_A 0)))) := by
      obtain ⟨e_dim⟩ := hDim_loc
      let e_ker0 : ↥(LinearMap.ker (LinearMap.baseChange κ (d_A 0))) ≃ₗ[κ]
          ↥(LinearMap.ker (LinearMap.baseChange κ (d 0))) :=
        LinearEquiv.ofBijective
          (((e_κ 0).toLinearMap.comp (LinearMap.ker (LinearMap.baseChange κ (d_A 0))).subtype).codRestrict
            (LinearMap.ker (LinearMap.baseChange κ (d 0))) (fun z => by
              rw [LinearMap.mem_ker]
              change LinearMap.baseChange κ (d 0) (e_κ 0 z.1) = 0
              rw [← hCancelBC A κ 0 z.1, z.2, map_zero]))
          ⟨fun x y hxy => Subtype.ext ((e_κ 0).injective (congrArg Subtype.val hxy)),
           fun y => ⟨⟨(e_κ 0).symm y.1, by
             rw [LinearMap.mem_ker]
             apply (e_κ 1).injective
             rw [hCancelBC A κ 0, LinearEquiv.apply_symm_apply, y.2, map_zero]⟩,
             Subtype.ext ((e_κ 0).apply_symm_apply y.1)⟩⟩
      exact ⟨e_dim.trans e_ker0.symm⟩
    have hFin0_A : Module.Finite A ↥(LinearMap.ker (d_A 0)) := by
      have : Module.Finite A (TensorProduct R A ↥(LinearMap.ker (d 0))) :=
        Module.Finite.base_change R A ↥(LinearMap.ker (d 0))
      exact Module.Finite.equiv (LinearMap.tensorKerEquiv A A (d 0))
    let B_subA : ∀ p : ℕ, Submodule A ↥(LinearMap.ker (d_A (p + 1))) :=
      fun p => (LinearMap.range (d_A p)).comap (LinearMap.ker (d_A (p + 1))).subtype
    have hFinSucc_A : ∀ p : ℕ, Module.Finite A (↥(LinearMap.ker (d_A (p + 1))) ⧸ B_subA p) := by
      intro p
      have : Module.Finite R (↥(LinearMap.ker (d (p + 1))) ⧸ B_subR p) := hFinSucc p
      have : Module.Finite A (TensorProduct R A (↥(LinearMap.ker (d (p + 1))) ⧸ B_subR p)) :=
        Module.Finite.base_change R A (↥(LinearMap.ker (d (p + 1))) ⧸ B_subR p)
      let toZA_p : ↥(LinearMap.ker (d (p + 1))) →ₗ[R] ↥(LinearMap.ker (d_A (p + 1))) :=
        { toFun := fun z => ⟨(1 : A) ⊗ₜ[R] z.1, by
            rw [LinearMap.mem_ker]
            change LinearMap.baseChange A (d (p + 1)) ((1 : A) ⊗ₜ[R] z.1) = 0
            rw [LinearMap.baseChange_tmul, z.2, TensorProduct.tmul_zero]⟩
          map_add' := fun z₁ z₂ => Subtype.ext (TensorProduct.tmul_add (1 : A) z₁.1 z₂.1)
          map_smul' := fun r z => Subtype.ext (TensorProduct.tmul_smul r (1 : A) z.1) }
      let ι_p : ↥(LinearMap.ker (d (p + 1))) →ₗ[R]
          (↥(LinearMap.ker (d_A (p + 1))) ⧸ B_subA p) :=
        ((Submodule.mkQ (B_subA p)).restrictScalars R).comp toZA_p
      have hι_ker : B_subR p ≤ LinearMap.ker ι_p := by
        intro z hz
        rw [Submodule.mem_comap, LinearMap.mem_range] at hz
        obtain ⟨w, hw⟩ := hz
        rw [LinearMap.mem_ker]
        change Submodule.mkQ (B_subA p) (toZA_p z) = 0
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap,
          LinearMap.mem_range]
        exact ⟨(1 : A) ⊗ₜ[R] w, by simp [toZA_p, d_A, LinearMap.baseChange_tmul, hw]⟩
      let bar_p := Submodule.liftQ (B_subR p) ι_p hι_ker
      let Ψ_p := LinearMap.liftBaseChange A bar_p
      apply Module.Finite.of_surjective Ψ_p
      intro q_el
      obtain ⟨ζ, rfl⟩ := Submodule.Quotient.mk_surjective (B_subA p) q_el
      let τ_p : TensorProduct R A ↥(LinearMap.ker (d (p + 1))) ≃ₗ[A]
          ↥(LinearMap.ker (d_A (p + 1))) :=
        LinearMap.tensorKerEquiv A A (d (p + 1))
      let ξ := τ_p.symm ζ
      refine ⟨LinearMap.lTensor A (Submodule.mkQ (B_subR p)) ξ, ?_⟩
      have h_eq : ∀ u_el : TensorProduct R A ↥(LinearMap.ker (d (p + 1))),
          Ψ_p (LinearMap.lTensor A (Submodule.mkQ (B_subR p)) u_el) =
            Submodule.mkQ (B_subA p) (τ_p u_el) := by
        intro u_el
        induction u_el using TensorProduct.induction_on with
        | zero => rw [map_zero, map_zero, map_zero, map_zero]
        | tmul a z =>
          change a • bar_p (Submodule.Quotient.mk z) =
            Submodule.mkQ (B_subA p) (τ_p (a ⊗ₜ[R] z))
          rw [Submodule.liftQ_apply]
          change a • Submodule.mkQ (B_subA p) (toZA_p z) = _
          rw [← LinearMap.map_smul]
          congr 1
          apply Subtype.ext
          change (a • toZA_p z).1 = (τ_p (a ⊗ₜ[R] z)).1
          rw [SetLike.val_smul]
          change a • ((1 : A) ⊗ₜ[R] z.1) = a ⊗ₜ[R] z.1
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        | add _ _ h1 h2 =>
          rw [map_add, map_add, map_add, map_add, h1, h2]
      dsimp only [ξ]
      rw [h_eq, LinearEquiv.apply_symm_apply]
      rfl
    have hPeel_A : ∀ n k : ℕ, m ≤ k + n →
        Module.Flat A ↥(LinearMap.ker (d_A k)) ∧
        (Function.Injective (LinearMap.lTensor κ (LinearMap.ker (d_A k)).subtype) ∧
          LinearMap.range (LinearMap.lTensor κ (LinearMap.ker (d_A k)).subtype) =
            LinearMap.ker (LinearMap.lTensor κ (d_A k))) ∧
        LinearMap.ker (d_A (k + 1)) ≤ LinearMap.range (d_A k) := by
      intro n
      induction n with
      | zero =>
        intro k hk
        have hk0 : m ≤ k := by simpa using hk
