              dsimp only [N_num, qv]
              simp only [map_sub, map_mul]
          _ = u_deriv j * dv := (hu_deriv_mul j).symm
          _ = (qv * qv) * u_deriv j := by rw [hdv_eq, mul_comm]
      rw [h_scalar, ← smul_smul]
    have h_inv := congrArg (dv⁻¹ • ·) h_dv_smul
    rw [smul_smul, smul_smul, inv_mul_cancel₀ hdv_ne, one_smul, one_smul] at h_inv
    exact h_inv
  have hOrdU0 : ord P (u_deriv 0) = (0 : WithTop ℤ) := by
    have hOrdP0 : ord P (Polynomial.aeval t (P_num 0)) = ((e : ℤ) : WithTop ℤ) := by
      rw [← hHQ_eq 0, hMul, hOrdH0, hOrdAevalEqZero (Q_den 0) (hQ_den_c 0), add_zero]
    have hP0_c : Polynomial.eval c (P_num 0) = 0 := by
      by_contra hne
      have h0 := hOrdAevalEqZero (P_num 0) hne
      rw [hOrdP0] at h0
      have he0 : (e : ℤ) = 0 := WithTop.coe_inj.mp h0
      omega
    have hP0'_c : Polynomial.eval c (Polynomial.derivative (P_num 0)) ≠ 0 := by
      intro h0'
      let T : Polynomial Ω := Polynomial.taylor c (P_num 0)
      have hT_dvd : Polynomial.X ^ 2 ∣ T := by
        rw [Polynomial.X_pow_dvd_iff]
        intro m hm
        interval_cases m
        · dsimp only [T]
          rw [Polynomial.taylor_coeff_zero]
          exact hP0_c
        · dsimp only [T]
          rw [Polynomial.taylor_coeff_one]
          exact h0'
      obtain ⟨H₁, hT_eq⟩ := hT_dvd
      have hP0_back : P_num 0 = (Polynomial.taylor (-c)) T := by
        dsimp only [T]
        rw [Polynomial.taylor_taylor, neg_add_cancel, Polynomial.taylor_zero]
      rw [hT_eq, Polynomial.taylor_apply, Polynomial.mul_comp, Polynomial.pow_comp,
        Polynomial.X_comp] at hP0_back
      have hXnc : Polynomial.X + Polynomial.C (-c) = Polynomial.X - Polynomial.C c := by
        rw [Polynomial.C_neg, sub_eq_add_neg]
      rw [hXnc] at hP0_back
      set H₀ : Polynomial Ω := H₁.comp (Polynomial.X - Polynomial.C c)
      have hAevalP0 : Polynomial.aeval t (P_num 0) = τ_c * (τ_c * Polynomial.aeval t H₀) := by
        rw [hP0_back]
        simp only [map_mul, map_pow, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
        dsimp only [τ_c]
        ring
      have hOrdGe2e : (((2 * e : ℕ) : ℤ) : WithTop ℤ) ≤ ord P (Polynomial.aeval t (P_num 0)) := by
        rw [hAevalP0, hMul, hMul, htc]
        have h1 : ((e : ℤ) : WithTop ℤ) ≤ ((e : ℤ) : WithTop ℤ) + ord P (Polynomial.aeval t H₀) := by
          conv_lhs => rw [← add_zero ((e : ℤ) : WithTop ℤ)]
          exact add_le_add le_rfl (hOrdAevalNonneg H₀)
        have h2 : ((e : ℤ) : WithTop ℤ) + ((e : ℤ) : WithTop ℤ) ≤
            ((e : ℤ) : WithTop ℤ) + (((e : ℤ) : WithTop ℤ) + ord P (Polynomial.aeval t H₀)) :=
          add_le_add le_rfl h1
        refine le_trans ?_ h2
        rw [← WithTop.coe_add]
        exact WithTop.coe_le_coe.mpr (by omega)
      rw [hOrdP0] at hOrdGe2e
      have h_contra : ((2 * e : ℕ) : ℤ) ≤ (e : ℤ) := WithTop.coe_le_coe.mp hOrdGe2e
      omega
    have hN0_c : Polynomial.eval c (N_num 0) ≠ 0 := by
      dsimp only [N_num]
      rw [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_mul, hP0_c, zero_mul, sub_zero]
      exact mul_ne_zero hP0'_c (hQ_den_c 0)
    have hOrdN0 : ord P (Polynomial.aeval t (N_num 0)) = (0 : WithTop ℤ) :=
      hOrdAevalEqZero (N_num 0) hN0_c
    have hOrdD0 : ord P (Polynomial.aeval t (D_den 0)) = (0 : WithTop ℤ) :=
      hOrdAevalEqZero (D_den 0) (hD_den_c 0)
    calc ord P (u_deriv 0)
        = ord P (u_deriv 0) + (0 : WithTop ℤ) := (add_zero _).symm
      _ = ord P (u_deriv 0) + ord P (Polynomial.aeval t (D_den 0)) := by rw [hOrdD0]
      _ = ord P (u_deriv 0 * Polynomial.aeval t (D_den 0)) := (hMul _ _).symm
      _ = ord P (Polynomial.aeval t (N_num 0)) := by rw [hu_deriv_mul 0]
      _ = (0 : WithTop ℤ) := hOrdN0
  set η_k : F := ∑ j ∈ Finset.range (d + 1), z_k ^ j * u_deriv j
  have hOrdEta : ord P η_k = (0 : WithTop ℤ) := by
    dsimp only [η_k]
    have h0_mem : 0 ∈ Finset.range (d + 1) := Finset.mem_range.mpr (Nat.zero_lt_succ d)
    rw [← Finset.add_sum_erase _ _ h0_mem, pow_zero, one_mul, hAddEq]
    · exact hOrdU0
    · rw [hOrdU0]
      refine lt_of_lt_of_le (WithTop.coe_lt_coe.mpr (by omega : (0 : ℤ) < 1)) ?_
      refine hSumGe _ _ ((1 : ℤ) : WithTop ℤ) fun j hj => ?_
      have hj_ne_0 : j ≠ 0 := (Finset.mem_erase.mp hj).1
      rw [hMul, hOrdZkPow j]
      have h1 : ((j : ℤ) : WithTop ℤ) ≤ ((j : ℤ) : WithTop ℤ) + ord P (u_deriv j) := by
        conv_lhs => rw [← add_zero ((j : ℤ) : WithTop ℤ)]
        exact add_le_add le_rfl (hRcNonneg _ (hu_deriv_mem j))
      exact le_trans (WithTop.coe_le_coe.mpr (by omega : (1 : ℤ) ≤ (j : ℤ))) h1
  have hChainZero :
      (Polynomial.eval z (Polynomial.derivative G) + η_k * δ k) • D_K z_k = 0 := by
    have hEvalH : ∑ j ∈ Finset.range (d + 1), H.coeff j * z_k ^ j = 0 := by
      rw [← hH_deg, ← Polynomial.eval_eq_sum_range, hH_root]
    have hD0 : D_K (∑ j ∈ Finset.range (d + 1), H.coeff j * z_k ^ j) = 0 := by
      rw [hEvalH, map_zero]
    rw [map_sum] at hD0
    have hLeibSum :
        (∑ j ∈ Finset.range (d + 1), D_K (H.coeff j * z_k ^ j)) =
        (∑ j ∈ Finset.range (d + 1), H.coeff j • D_K (z_k ^ j)) +
        (∑ j ∈ Finset.range (d + 1), z_k ^ j • D_K (H.coeff j)) := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun j _ => D_K.leibniz (H.coeff j) (z_k ^ j)
    rw [hLeibSum] at hD0
    have hSum1 :
        (∑ j ∈ Finset.range (d + 1), H.coeff j • D_K (z_k ^ j)) =
        Polynomial.eval z (Polynomial.derivative G) • D_K z_k := by
      rw [Finset.sum_range_succ', pow_zero, D_K.map_one_eq_zero, smul_zero, add_zero]
      have hTerm1 : ∀ i : ℕ,
          H.coeff (i + 1) • D_K (z_k ^ (i + 1)) =
          ((Polynomial.derivative H).coeff i * z_k ^ i) • D_K z_k := by
        intro i
        rw [D_K.leibniz_pow z_k (i + 1), Nat.add_sub_cancel,
          ← Nat.cast_smul_eq_nsmul F (i + 1), Nat.cast_add, Nat.cast_one,
          smul_smul, smul_smul, Polynomial.coeff_derivative H i]
      simp_rw [hTerm1, ← Finset.sum_smul]
      have hH_deg_ne : H.natDegree ≠ 0 := by omega
      have hDerivDeg : (Polynomial.derivative H).natDegree < d := by
        rw [← hH_deg]
        exact Polynomial.natDegree_derivative_lt hH_deg_ne
      rw [← Polynomial.eval_eq_sum_range' hDerivDeg z_k, hH_deriv]
    have hSum2 :
        (∑ j ∈ Finset.range (d + 1), z_k ^ j • D_K (H.coeff j)) =
        (η_k * δ k) • D_K z_k := by
      have hTerm2 : ∀ j : ℕ,
          z_k ^ j • D_K (H.coeff j) = ((z_k ^ j * u_deriv j) * δ k) • D_K z_k := by
        intro j
        rw [hDH_coeff j, hdt_eq k, smul_smul, smul_smul]
      simp_rw [hTerm2, ← Finset.sum_smul, ← Finset.sum_mul]
      rfl
    rw [hSum1, hSum2, ← add_smul] at hD0
    exact hD0
  have hScalarZero : Polynomial.eval z (Polynomial.derivative G) + η_k * δ k = 0 := by
    by_contra hne
    have h1 := congrArg ((Polynomial.eval z (Polynomial.derivative G) + η_k * δ k)⁻¹ • ·) hChainZero
    rw [smul_smul, inv_mul_cancel₀ hne, one_smul, smul_zero] at h1
    exact hdz_ne k h1
  have hG'_eq : Polynomial.eval z (Polynomial.derivative G) = -(η_k * δ k) :=
    eq_neg_of_add_eq_zero_left hScalarZero
  rw [hG'_eq, hOrdNeg, hMul, hOrdEta, zero_add]

theorem weil_dedekind_laurent_trace_codifferent_serre_duality (Ω X F : Type u) [Field Ω] [IsAlgClosed Ω] [Field F] [Algebra Ω F]
    (IsPlace : X → Prop) (ord : X → F → WithTop ℤ) (x_sep : F) (K_div : X → ℤ)
    (hDed : IsSmoothCurveDedekindValuationData Ω X F IsPlace ord x_sep K_div)
    (D : X → ℤ)
    (hD_nc : ∀ P : X, ¬IsPlace P → D P = 0)
    (hD_fin : {P : X | D P ≠ 0}.Finite)
    (E₀ E_inf E₀_inf L_D L_KD : Submodule Ω F)
    (hSpaces : IsTwoChartDivisorSpaces Ω X F IsPlace ord x_sep D E₀ E_inf E₀_inf L_D)
    (hLKD : ∀ v : F, v ∈ L_KD ↔
      ∀ P : X, IsPlace P → ((-(K_div P - D P) : ℤ) : WithTop ℤ) ≤ ord P v)
    (hFinH1 : FiniteDimensional Ω (↥E₀_inf ⧸ Submodule.comap E₀_inf.subtype (E₀ ⊔ E_inf))) :
    FiniteDimensional Ω ↥L_KD ∧
    Module.finrank Ω (↥E₀_inf ⧸ Submodule.comap E₀_inf.subtype (E₀ ⊔ E_inf)) =
      Module.finrank Ω ↥L_KD :=
by
  rcases hDed with ⟨_hInfPl, hValPt, hPrinFin, hx_diff, hChart0, hChartInf, _hK_nc, _hK_fin, hK_diff⟩
  have hVal : IsCurvePlaceValuation Ω X F IsPlace ord := ⟨hValPt, hPrinFin⟩
  have hx_ne : x_sep ≠ 0 := by
    intro h0
    apply hx_diff
    rw [h0, map_zero]
  have hOrd1 : ∀ P : X, IsPlace P → ord P 1 = (0 : WithTop ℤ) := by
    intro P hP
    have h1 : (1 : F) = algebraMap Ω F 1 := (map_one (algebraMap Ω F)).symm
    rw [h1]
    exact (hValPt P hP).2.2.2.1 1 one_ne_zero
  have hOrdNeg1 : ∀ P : X, IsPlace P → ord P (-1) = (0 : WithTop ℤ) := by
    intro P hP
    have hm1 : (-1 : F) = algebraMap Ω F (-1) := by rw [map_neg, map_one]
    rw [hm1]
    exact (hValPt P hP).2.2.2.1 (-1) (neg_ne_zero.mpr one_ne_zero)
  have hOrdCoordNonneg : ∀ (t : F) (c : Ω) (P : X),
      IsPlace P → (1 : WithTop ℤ) ≤ ord P (t - algebraMap Ω F c) →
      (0 : WithTop ℤ) ≤ ord P t := by
    intro t c P hP htc
    have hEq : t = (t - algebraMap Ω F c) + algebraMap Ω F c := (sub_add_cancel t _).symm
    rw [hEq]
    refine le_trans ?_ ((hValPt P hP).2.2.1 (t - algebraMap Ω F c) (algebraMap Ω F c))
    refine le_min (le_trans (WithTop.coe_le_coe.mpr (by omega : (0 : ℤ) ≤ 1)) htc) ?_
    by_cases hc : c = 0
    · rw [hc, map_zero, ((hValPt P hP).1 0).mpr rfl]
      exact le_top
    · rw [(hValPt P hP).2.2.2.1 c hc]
  let K₀ : IntermediateField Ω F := IntermediateField.adjoin Ω ({x_sep} : Set F)
  have _ : FiniteDimensional ↥K₀ F := hChart0.2.1.1
  have _ : Algebra.IsSeparable ↥K₀ F := hChart0.2.1.2
  have hx_mem_K₀ : x_sep ∈ K₀ := IntermediateField.mem_adjoin_simple_self Ω x_sep
  have hK₀_inv : K₀ = IntermediateField.adjoin Ω ({x_sep⁻¹} : Set F) := by
    apply le_antisymm
    · rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
      have hx_ii : (x_sep⁻¹)⁻¹ ∈ IntermediateField.adjoin Ω ({x_sep⁻¹} : Set F) :=
        IntermediateField.inv_mem _ (IntermediateField.mem_adjoin_simple_self Ω x_sep⁻¹)
      rwa [inv_inv] at hx_ii
    · rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
      exact IntermediateField.inv_mem K₀ hx_mem_K₀
  have hSingleChart : ∀ (t : F) (hChart_t : IsDedekindChartForCoord Ω X F IsPlace ord t)
      (hK₀_t : K₀ = IntermediateField.adjoin Ω ({t} : Set F))
      (K_t : X → ℤ)
      (hDiff_t : ∀ P : X, IsPlace P → (0 : WithTop ℤ) ≤ ord P t →
        ∀ t_P : F, ord P t_P = (1 : WithTop ℤ) →
          KaehlerDifferential.D Ω F t_P ≠ 0 ∧
          ∃ δ_P : F, δ_P ≠ 0 ∧ ord P δ_P = (K_t P : WithTop ℤ) ∧
            KaehlerDifferential.D Ω F t = δ_P • KaehlerDifferential.D Ω F t_P)
      (w : F),
      (∀ v : F, (∀ P : X, IsPlace P → (0 : WithTop ℤ) ≤ ord P t → (-(D P) : WithTop ℤ) ≤ ord P v) →
        ((Algebra.trace ↥K₀ F (w * v) : ↥K₀) : F) ∈ Algebra.adjoin Ω ({t} : Set F)) ↔
      (∀ P : X, IsPlace P → (0 : WithTop ℤ) ≤ ord P t →
        ((-(K_t P - D P) : ℤ) : WithTop ℤ) ≤ ord P w) := by
    intro t hChart_t hK₀_t K_t hDiff_t w
    obtain ⟨hLocGlob, hHasCoord, hFiber⟩ :=
      weil_dedekind_chart_fiber_crt_and_semilocal_reduction
        Ω X F IsPlace ord hVal t hChart_t K₀ hK₀_t D hD_fin
    have hAt_c : ∀ c : Ω,
        (∀ v : F, (∀ P : X, IsPlace P → (0 : WithTop ℤ) ≤ ord P t → (-(D P) : WithTop ℤ) ≤ ord P v) →
          ((Algebra.trace ↥K₀ F (w * v) : ↥K₀) : F) ∈ weilRatLocalSet Ω F t c) ↔
        (∀ P : X, IsPlace P → (1 : WithTop ℤ) ≤ ord P (t - algebraMap Ω F c) →
          ((-(K_t P - D P) : ℤ) : WithTop ℤ) ≤ ord P w) := by
      intro c
      obtain ⟨r, P_br, e_br, c_br, s_gen, u_D, z, hr, hP_inj, hP_range, he_br, hc_inj,
          hs_sub, hs_span, hClear, _hu_ne, hu_ord, hu_tr, hz_mem, hz_int, hz_ord⟩ := hFiber c
      have hP_fiber : ∀ k : Fin r,
          IsPlace (P_br k) ∧ (1 : WithTop ℤ) ≤ ord (P_br k) (t - algebraMap Ω F c) := by
        intro k
        have hk : P_br k ∈ Set.range P_br := ⟨k, rfl⟩
        rwa [hP_range] at hk
      have hP_pl : ∀ k : Fin r, IsPlace (P_br k) := fun k => (hP_fiber k).1
      have hMc_iff : ∀ b : F,
          b ∈ weilSemilocalIntSet Ω X F IsPlace ord t c ↔
          ∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) b := by
        intro b
        constructor
        · intro hb k
          exact hb (P_br k) (hP_fiber k).1 (hP_fiber k).2
        · intro hb P hP htc
          have hPin : P ∈ Set.range P_br := by
            rw [hP_range]
            exact ⟨hP, htc⟩
          rcases hPin with ⟨k, rfl⟩
          exact hb k
      have hs_sub' : (↑s_gen : Set F) ⊆ {v : F | ∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) v} :=
        fun g hg => (hMc_iff g).mp (hs_sub hg)
      have hs_span' : ∀ v : F, (∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) v) →
          ∃ coeff : F → F, (∀ g ∈ s_gen, coeff g ∈ weilRatLocalSet Ω F t c) ∧
            v = ∑ g ∈ s_gen, coeff g * g :=
        fun v hv => hs_span v ((hMc_iff v).mpr hv)
      have hClear' : ∀ u : F, ∃ a : Polynomial Ω, a ≠ 0 ∧
          ∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) (Polynomial.aeval t a * u) := by
        intro u
        obtain ⟨a, ha_ne, ha_mem⟩ := hClear u
        exact ⟨a, ha_ne, (hMc_iff (Polynomial.aeval t a * u)).mp ha_mem⟩
      have hz_mem' : ∀ k : Fin r, (0 : WithTop ℤ) ≤ ord (P_br k) z :=
        (hMc_iff z).mp hz_mem
      obtain ⟨G, hG_monic, hG_deg, hd_sum, hG_coeff, hG_root, hG_deriv_ne, hG_tr, hG_mod⟩ :=
        weil_semilocal_monogenic_powerBasis_traceDual_and_residue_factor
          Ω X F IsPlace ord hVal t hChart_t.1 K₀ hK₀_t c r hr P_br hP_inj hP_pl e_br he_br
          c_br hc_inj s_gen z hs_sub' hs_span' hClear' hz_mem' hz_int hz_ord
      have hDiff_br : ∀ k : Fin r,
          KaehlerDifferential.D Ω F (z - algebraMap Ω F (c_br k)) ≠ 0 ∧
          ∃ δ_P : F, δ_P ≠ 0 ∧ ord (P_br k) δ_P = (K_t (P_br k) : WithTop ℤ) ∧
            KaehlerDifferential.D Ω F t =
              δ_P • KaehlerDifferential.D Ω F (z - algebraMap Ω F (c_br k)) := by
        intro k
        exact hDiff_t (P_br k) (hP_pl k)
          (hOrdCoordNonneg t c (P_br k) (hP_pl k) (hP_fiber k).2)
          (z - algebraMap Ω F (c_br k)) (hz_ord k)
      have hdz_ne : ∀ k : Fin r, KaehlerDifferential.D Ω F (z - algebraMap Ω F (c_br k)) ≠ 0 :=
        fun k => (hDiff_br k).1
      choose δ hδ_ne hδ_ord hdt_eq using fun k : Fin r => (hDiff_br k).2
      have hOrdG' : ∀ k : Fin r,
          ord (P_br k) (Polynomial.eval z (Polynomial.derivative G)) = ord (P_br k) (δ k) :=
        weil_taylor_shifted_kaehler_codifferent_ord_eq
          Ω X F IsPlace ord hVal t hChart_t.1 c r P_br hP_pl e_br he_br c_br hc_inj z hz_ord
          (Module.finrank ↥K₀ F) hd_sum G hG_monic hG_deg hG_coeff hG_root hG_deriv_ne hG_mod
          δ hδ_ne hdz_ne hdt_eq
      have hStep1 :
          (∀ v : F, (∀ P : X, IsPlace P → (0 : WithTop ℤ) ≤ ord P t → (-(D P) : WithTop ℤ) ≤ ord P v) →
            ((Algebra.trace ↥K₀ F (w * v) : ↥K₀) : F) ∈ weilRatLocalSet Ω F t c) ↔
          (∀ k : Fin r,
            (0 : WithTop ℤ) ≤
              ord (P_br k) (Polynomial.eval z (Polynomial.derivative G) * (w * u_D))) := by
        refine (hu_tr w).trans ?_
        refine Iff.trans ?_ (hG_tr (w * u_D))
        constructor
        · intro h b hb
          exact h b ((hMc_iff b).mpr hb)
        · intro h b hb
          exact h b ((hMc_iff b).mp hb)
      rw [hStep1]
      have hBranchIff : ∀ k : Fin r,
          ((0 : WithTop ℤ) ≤
            ord (P_br k) (Polynomial.eval z (Polynomial.derivative G) * (w * u_D))) ↔
          (((-(K_t (P_br k) - D (P_br k)) : ℤ) : WithTop ℤ) ≤ ord (P_br k) w) := by
        intro k
        have hMul := (hValPt (P_br k) (hP_pl k)).2.1
        rw [hMul, hMul w u_D, hOrdG' k, hδ_ord k, hu_ord k]
        cases h_ow : ord (P_br k) w with
        | top =>
          simp
        | coe m =>
          norm_cast
          omega
      constructor
      · intro hAll P hP htc
        have hPin : P ∈ Set.range P_br := by
          rw [hP_range]
          exact ⟨hP, htc⟩
        rcases hPin with ⟨k, rfl⟩
        exact (hBranchIff k).mp (hAll k)
      · intro hAll k
        exact (hBranchIff k).mpr (hAll (P_br k) (hP_fiber k).1 (hP_fiber k).2)
    constructor
    · intro hGlobal P hP ht_nonneg
      obtain ⟨c, htc⟩ := hHasCoord P hP ht_nonneg
      refine (hAt_c c).mp ?_ P hP htc
      intro v hv
      exact (hLocGlob (Algebra.trace ↥K₀ F (w * v))).mp (hGlobal v hv) c
    · intro hOrdAll v hv
      rw [hLocGlob]
      intro c
      exact (hAt_c c).mpr (fun P hP htc => hOrdAll P hP (hOrdCoordNonneg t c P hP htc)) v hv
  have hChart0_iff : ∀ w : F,
      (∀ v ∈ E₀, ((Algebra.trace ↥K₀ F (w * v) : ↥K₀) : F) ∈ Algebra.adjoin Ω ({x_sep} : Set F)) ↔
      (∀ P : X, IsPlace P → (0 : WithTop ℤ) ≤ ord P x_sep →
        ((-(K_div P - D P) : ℤ) : WithTop ℤ) ≤ ord P w) := by
    intro w
    refine Iff.trans ?_
      (hSingleChart x_sep hChart0 rfl K_div (fun P hP _ t_P ht_P => hK_diff P hP t_P ht_P) w)
    constructor
    · intro h v hv
      exact h v ((hSpaces.1 v).mpr hv)
    · intro h v hv
      exact h v ((hSpaces.1 v).mp hv)
  have hDx_inv : KaehlerDifferential.D Ω F x_sep⁻¹ =
      (-(x_sep⁻¹ * x_sep⁻¹)) • KaehlerDifferential.D Ω F x_sep := by
    have hLeib : KaehlerDifferential.D Ω F (x_sep * x_sep⁻¹) =
        x_sep • KaehlerDifferential.D Ω F x_sep⁻¹ +
        x_sep⁻¹ • KaehlerDifferential.D Ω F x_sep :=
      (KaehlerDifferential.D Ω F).leibniz x_sep x_sep⁻¹
    rw [mul_inv_cancel₀ hx_ne, Derivation.map_one_eq_zero] at hLeib
    have hNeg : x_sep • KaehlerDifferential.D Ω F x_sep⁻¹ =
        -(x_sep⁻¹ • KaehlerDifferential.D Ω F x_sep) :=
      eq_neg_of_add_eq_zero_left hLeib.symm
    have hSmul := congrArg (fun η => x_sep⁻¹ • η) hNeg
    rw [smul_smul, inv_mul_cancel₀ hx_ne, one_smul, smul_neg, smul_smul, ← neg_smul] at hSmul
    exact hSmul
  have hOrdX_int : ∀ P : X, IsPlace P → ∃ m : ℤ, ord P x_sep = (m : WithTop ℤ) := by
    intro P hP
    have h_ne_top : ord P x_sep ≠ ⊤ := mt ((hValPt P hP).1 x_sep).mp hx_ne
    obtain ⟨m, hm⟩ := WithTop.ne_top_iff_exists.mp h_ne_top
    exact ⟨m, hm.symm⟩
  classical
  let m_x : X → ℤ := fun P => if hP : IsPlace P then Classical.choose (hOrdX_int P hP) else 0
  have hm_x_spec : ∀ P : X, IsPlace P → ord P x_sep = (m_x P : WithTop ℤ) := by
    intro P hP
    dsimp only [m_x]
    simp only [hP, ↓reduceDIte]
    exact Classical.choose_spec (hOrdX_int P hP)
  have hm_x_inv : ∀ P : X, IsPlace P → ord P x_sep⁻¹ = ((-m_x P : ℤ) : WithTop ℤ) := by
    intro P hP
    have h_inv_ne : x_sep⁻¹ ≠ 0 := inv_ne_zero hx_ne
    have h_ne_top : ord P x_sep⁻¹ ≠ ⊤ := mt ((hValPt P hP).1 x_sep⁻¹).mp h_inv_ne
    obtain ⟨m', hm'⟩ := WithTop.ne_top_iff_exists.mp h_ne_top
    have hProd : ord P (x_sep * x_sep⁻¹) = ord P x_sep + ord P x_sep⁻¹ :=
      (hValPt P hP).2.1 x_sep x_sep⁻¹
    rw [mul_inv_cancel₀ hx_ne, hOrd1 P hP, hm_x_spec P hP, ← hm',
      ← WithTop.coe_add, ← WithTop.coe_zero, WithTop.coe_inj] at hProd
    have hm'_eq : m' = -m_x P := by omega
    rw [← hm', hm'_eq]
  let K_inf : X → ℤ := fun P => -2 * m_x P + K_div P
  have hDiff_inf : ∀ P : X, IsPlace P → (0 : WithTop ℤ) ≤ ord P x_sep⁻¹ →
      ∀ t_P : F, ord P t_P = (1 : WithTop ℤ) →
        KaehlerDifferential.D Ω F t_P ≠ 0 ∧
        ∃ δ_P : F, δ_P ≠ 0 ∧ ord P δ_P = (K_inf P : WithTop ℤ) ∧
          KaehlerDifferential.D Ω F x_sep⁻¹ = δ_P • KaehlerDifferential.D Ω F t_P := by
    intro P hP _ t_P ht_P
    obtain ⟨hdt_ne, δ₀, hδ₀_ne, hδ₀_ord, hδ₀_eq⟩ := hK_diff P hP t_P ht_P
    refine ⟨hdt_ne, -(x_sep⁻¹ * x_sep⁻¹) * δ₀, ?_, ?_, ?_⟩
    · exact mul_ne_zero (neg_ne_zero.mpr (mul_ne_zero (inv_ne_zero hx_ne) (inv_ne_zero hx_ne))) hδ₀_ne
    · have hMul := (hValPt P hP).2.1
      have hNegEq : -(x_sep⁻¹ * x_sep⁻¹) * δ₀ = (-1) * (x_sep⁻¹ * (x_sep⁻¹ * δ₀)) := by ring
      rw [hNegEq, hMul, hMul, hMul, hOrdNeg1 P hP, hm_x_inv P hP, hδ₀_ord]
      rw [← WithTop.coe_add, ← WithTop.coe_add, ← WithTop.coe_zero, ← WithTop.coe_add]
      congr 1
      dsimp only [K_inf]
      omega
    · rw [hDx_inv, hδ₀_eq, smul_smul]
  have hChartInf_iff : ∀ w : F,
      (∀ v ∈ E_inf, x_sep ^ 2 * ((Algebra.trace ↥K₀ F (w * v) : ↥K₀) : F) ∈
        Algebra.adjoin Ω ({x_sep⁻¹} : Set F)) ↔
      (∀ P : X, IsPlace P → ord P x_sep ≤ (0 : WithTop ℤ) →
        ((-(K_div P - D P) : ℤ) : WithTop ℤ) ≤ ord P w) := by
    intro w
    let s₂ : ↥K₀ := ⟨x_sep ^ 2, K₀.pow_mem hx_mem_K₀ 2⟩
    have hTraceMul : ∀ v : F,
        x_sep ^ 2 * ((Algebra.trace ↥K₀ F (w * v) : ↥K₀) : F) =
        ((Algebra.trace ↥K₀ F ((x_sep ^ 2 * w) * v) : ↥K₀) : F) := by
      intro v
      have hs₂_coe : (s₂ : F) = x_sep ^ 2 := by simp [s₂]
      have hSmul : (x_sep ^ 2 * w) * v = s₂ • (w * v) := by
        rw [Algebra.smul_def, IntermediateField.algebraMap_apply, hs₂_coe, mul_assoc]
      rw [hSmul, LinearMap.map_smul, smul_eq_mul, MulMemClass.coe_mul, hs₂_coe]
    have hOrdSign : ∀ P : X, IsPlace P →
        ((0 : WithTop ℤ) ≤ ord P x_sep⁻¹ ↔ ord P x_sep ≤ (0 : WithTop ℤ)) := by
      intro P hP
      rw [hm_x_inv P hP, hm_x_spec P hP, ← WithTop.coe_zero,
        WithTop.coe_le_coe, WithTop.coe_le_coe]
      omega
    have hSingle := hSingleChart x_sep⁻¹ hChartInf hK₀_inv K_inf hDiff_inf (x_sep ^ 2 * w)
    have hOrdShift : ∀ P : X, IsPlace P →
        (((-(K_inf P - D P) : ℤ) : WithTop ℤ) ≤ ord P (x_sep ^ 2 * w) ↔
          ((-(K_div P - D P) : ℤ) : WithTop ℤ) ≤ ord P w) := by
      intro P hP
      have hMul := (hValPt P hP).2.1
      have hSq : x_sep ^ 2 * w = x_sep * (x_sep * w) := by ring
      rw [hSq, hMul, hMul, hm_x_spec P hP]
      cases h_ow : ord P w with
      | top =>
        simp
      | coe m =>
        rw [← WithTop.coe_add, ← WithTop.coe_add, WithTop.coe_le_coe, WithTop.coe_le_coe]
        dsimp only [K_inf]
        omega
    constructor
    · intro h P hP hx_nonpos
      apply (hOrdShift P hP).mp
      refine hSingle.mp ?_ P hP ((hOrdSign P hP).mpr hx_nonpos)
      intro v hv
      rw [← hTraceMul v]
      exact h v ((hSpaces.2.1 v).mpr fun Q hQ hQ_le => hv Q hQ ((hOrdSign Q hQ).mpr hQ_le))
    · intro h v hv
      rw [hTraceMul v]
      refine hSingle.mpr ?_ v (fun Q hQ hQ_ge =>
        (hSpaces.2.1 v).mp hv Q hQ ((hOrdSign Q hQ).mp hQ_ge))
      intro P hP hx_inv_nonneg
      exact (hOrdShift P hP).mpr (h P hP ((hOrdSign P hP).mp hx_inv_nonneg))
  have hLKD_trace : ∀ w : F, w ∈ L_KD ↔
      (∀ v ∈ E₀, ((Algebra.trace ↥K₀ F (w * v) : ↥K₀) : F) ∈ Algebra.adjoin Ω ({x_sep} : Set F)) ∧
      (∀ v ∈ E_inf, x_sep ^ 2 * ((Algebra.trace ↥K₀ F (w * v) : ↥K₀) : F) ∈
        Algebra.adjoin Ω ({x_sep⁻¹} : Set F)) := by
    intro w
    rw [hLKD w, hChart0_iff w, hChartInf_iff w]
    constructor
    · intro hAll
      exact ⟨fun P hP _ => hAll P hP, fun P hP _ => hAll P hP⟩
    · rintro ⟨h0, hInf⟩ P hP
      rcases le_total (0 : WithTop ℤ) (ord P x_sep) with hge | hle
      · exact h0 P hP hge
      · exact hInf P hP hle
  obtain ⟨e_dual⟩ :=
    weil_twoChart_laurent_dual_equiv_trace_subspace
      Ω X F IsPlace ord hVal x_sep hChart0.1 K₀ rfl D hD_fin E₀ E_inf E₀_inf L_D
      hSpaces L_KD hLKD_trace
  have _ : FiniteDimensional Ω
      (Module.Dual Ω (↥E₀_inf ⧸ Submodule.comap E₀_inf.subtype (E₀ ⊔ E_inf))) :=
    Subspace.instModuleDualFiniteDimensional
  have hFinLKD : FiniteDimensional Ω ↥L_KD := Module.Finite.equiv e_dual
  refine ⟨hFinLKD, ?_⟩
  rw [← Subspace.dual_finrank_eq, e_dual.finrank_eq]

theorem weil_algClosed_smooth_curve_riemann_roch (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (E_sm : AlgebraicGeometry.Scheme.{u})
    (p_sm : E_sm ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (hInt : AlgebraicGeometry.IsIntegral E_sm)
    (hProp : AlgebraicGeometry.IsProper p_sm)
    (hSm : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_sm)
    (F : Type u) [Field F] [Algebra Ω F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ E_sm)
    (hη_comm : η_F ≫ p_sm = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω F)))
    (hFunc : IsSchemeFunctionField E_sm F η_F) :
    HasSmoothCurveRiemannRochPackage Ω E_sm p_sm F η_F :=
by
  obtain ⟨ord, x_sep, K_div, hLoc⟩ :=
    weil_algClosed_smooth_curve_local_dvr_and_kaehler Ω E_sm p_sm hInt hProp hSm F η_F
      hη_comm hFunc
  rcases hLoc with
    ⟨hA1, hA2, hValFull, hPrinFin, hB2, hx_sep, _hKaehlerSep, hK_nc, hK_fin, hK_chart, hK_free⟩
  have hPolePkg :=
    weil_algClosed_smooth_curve_separable_pole_chart_and_p1_iso Ω E_sm p_sm hInt hProp F η_F
      hη_comm hFunc ord x_sep K_div
      ⟨hA1, hA2, hValFull, hPrinFin, hB2, hx_sep, _hKaehlerSep, hK_nc, hK_fin, hK_chart, hK_free⟩
  rcases hPolePkg with ⟨hPole, hP1⟩
  have hx_ne : x_sep ≠ 0 := by
    intro hx0
    apply hx_sep
    rw [hx0, map_zero]
  have hx_inv_diff : KaehlerDifferential.D Ω F x_sep⁻¹ ≠ 0 := by
    intro h0
    have h1 : KaehlerDifferential.D Ω F (x_sep * x_sep⁻¹) =
        x_sep • KaehlerDifferential.D Ω F x_sep⁻¹ +
          x_sep⁻¹ • KaehlerDifferential.D Ω F x_sep :=
      (KaehlerDifferential.D Ω F).leibniz x_sep x_sep⁻¹
    rw [mul_inv_cancel₀ hx_ne, Derivation.map_one_eq_zero, h0, smul_zero, zero_add] at h1
    have h2 : x_sep • (x_sep⁻¹ • KaehlerDifferential.D Ω F x_sep) = 0 := by
      rw [← h1, smul_zero]
    rw [smul_smul, mul_inv_cancel₀ hx_ne, one_smul] at h2
    exact hx_sep h2
  let IsPlace : ↥E_sm → Prop := fun P => IsClosed ({P} : Set E_sm)
  have hDed : IsSmoothCurveDedekindValuationData Ω ↥E_sm F IsPlace ord x_sep K_div := by
    refine ⟨hA1, ?_, hPrinFin, hx_sep, (hPole x_sep hx_sep).1, (hPole x_sep⁻¹ hx_inv_diff).1,
      hK_nc, hK_fin, hK_free⟩
    intro P hP
    have hVP := hValFull P hP
    exact ⟨hVP.1, hVP.2.1, hVP.2.2.1, hVP.2.2.2.1, hVP.2.2.2.2.2.1, hVP.2.2.2.2.2.2⟩
  obtain ⟨g_E, hEuler, hPrin, hCech⟩ :=
    weil_dedekind_two_chart_euler_char_and_principal_deg_zero Ω ↥E_sm F IsPlace ord x_sep
      K_div hDed
  let mkSub : (↥E_sm → Prop) → (↥E_sm → ℤ) → Submodule Ω F :=
    fun Cond D =>
      { carrier := {v : F | ∀ P : ↥E_sm, IsPlace P → Cond P → (-(D P) : WithTop ℤ) ≤ ord P v}
        zero_mem' := by
          intro P hP _
          rw [((hValFull P hP).1 0).mpr rfl]
          exact le_top
        add_mem' := by
          intro v₁ v₂ hv₁ hv₂ P hP hC
          exact le_trans (le_min (hv₁ P hP hC) (hv₂ P hP hC)) ((hValFull P hP).2.2.1 v₁ v₂)
        smul_mem' := by
          intro c v hv P hP hC
          by_cases hc : c = 0
          · rw [hc, zero_smul, ((hValFull P hP).1 0).mpr rfl]
            exact le_top
          · rw [Algebra.smul_def, (hValFull P hP).2.1, (hValFull P hP).2.2.2.1 c hc, zero_add]
            exact hv P hP hC }
  let E₀ : (↥E_sm → ℤ) → Submodule Ω F :=
    fun D => mkSub (fun P => (0 : WithTop ℤ) ≤ ord P x_sep) D
  let E_inf : (↥E_sm → ℤ) → Submodule Ω F :=
    fun D => mkSub (fun P => ord P x_sep ≤ (0 : WithTop ℤ)) D
  let E₀_inf : (↥E_sm → ℤ) → Submodule Ω F :=
    fun D => mkSub (fun P => ord P x_sep = (0 : WithTop ℤ)) D
  let L_sub : (↥E_sm → ℤ) → Submodule Ω F :=
    fun D => mkSub (fun _ => True) D
  have hSpacesSub : ∀ D : ↥E_sm → ℤ,
      IsTwoChartDivisorSpaces Ω ↥E_sm F IsPlace ord x_sep D
        (E₀ D) (E_inf D) (E₀_inf D) (L_sub D) := by
    intro D
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro v; rfl
    · intro v; rfl
    · intro v; rfl
    · intro v
      change (∀ P : ↥E_sm, IsPlace P → True → (-(D P) : WithTop ℤ) ≤ ord P v) ↔
        (∀ P : ↥E_sm, IsPlace P → (-(D P) : WithTop ℤ) ≤ ord P v)
      simp
  let D₀ : ↥E_sm → ℤ := fun _ => 0
  have hD₀_nc : ∀ P : ↥E_sm, ¬IsPlace P → D₀ P = 0 := fun _ _ => rfl
  have hD₀_fin : {P : ↥E_sm | D₀ P ≠ 0}.Finite := by
    convert Set.finite_empty
    ext P
    simp [D₀]
  obtain ⟨hFinL0, hFinH1_0, _hEuler0, hZeroBase⟩ :=
    hEuler D₀ hD₀_nc hD₀_fin (E₀ D₀) (E_inf D₀) (E₀_inf D₀) (L_sub D₀) (hSpacesSub D₀)
  obtain ⟨hRankL0, hRankH1_0⟩ := hZeroBase (fun _ => rfl)
  have hL_K_mem : ∀ v : F,
      v ∈ L_sub K_div ↔
        ∀ P : ↥E_sm, IsPlace P → ((-(K_div P - D₀ P) : ℤ) : WithTop ℤ) ≤ ord P v := by
    intro v
    dsimp only [D₀]
    simp only [sub_zero]
    exact (hSpacesSub K_div).2.2.2 v
  have hDual0 :=
    weil_dedekind_laurent_trace_codifferent_serre_duality Ω ↥E_sm F IsPlace ord x_sep K_div hDed
      D₀ hD₀_nc hD₀_fin (E₀ D₀) (E_inf D₀) (E₀_inf D₀) (L_sub D₀) (L_sub K_div)
      (hSpacesSub D₀) hL_K_mem hFinH1_0
  have hRankLK : Module.finrank Ω ↥(L_sub K_div) = g_E := by
    rw [← hDual0.2, hRankH1_0]
  obtain ⟨_hFinLK, hFinH1_K, hEulerK, _⟩ :=
    hEuler K_div hK_nc hK_fin (E₀ K_div) (E_inf K_div) (E₀_inf K_div) (L_sub K_div)
      (hSpacesSub K_div)
  have hL_0_mem : ∀ v : F,
      v ∈ L_sub D₀ ↔
        ∀ P : ↥E_sm, IsPlace P → ((-(K_div P - K_div P) : ℤ) : WithTop ℤ) ≤ ord P v := by
    intro v
    simp only [sub_self]
    exact (hSpacesSub D₀).2.2.2 v
  have hDualK :=
    weil_dedekind_laurent_trace_codifferent_serre_duality Ω ↥E_sm F IsPlace ord x_sep K_div hDed
      K_div hK_nc hK_fin (E₀ K_div) (E_inf K_div) (E₀_inf K_div) (L_sub K_div) (L_sub D₀)
      (hSpacesSub K_div) hL_0_mem hFinH1_K
  have hRankH1_K :
      Module.finrank Ω
        (↥(E₀_inf K_div) ⧸ Submodule.comap (E₀_inf K_div).subtype (E₀ K_div ⊔ E_inf K_div)) = 1 := by
    rw [hDualK.2, hRankL0]
  have hDegK : (∑ᶠ P : E_sm, K_div P) = (2 : ℤ) * (g_E : ℤ) - 2 := by
    rw [hRankLK, hRankH1_K] at hEulerK
    omega
  have hNonspecial : ∀ (D : E_sm → ℤ),
      (∀ P : E_sm, ¬IsClosed ({P} : Set E_sm) → D P = 0) →
      {P : E_sm | D P ≠ 0}.Finite →
      (2 : ℤ) * (g_E : ℤ) - 2 < (∑ᶠ P : E_sm, D P) →
      Module.finrank Ω
        (↥(E₀_inf D) ⧸ Submodule.comap (E₀_inf D).subtype (E₀ D ⊔ E_inf D)) = 0 := by
    intro D hD_nc hD_fin hD_deg
    obtain ⟨_, hFinH1_D, _, _⟩ :=
      hEuler D hD_nc hD_fin (E₀ D) (E_inf D) (E₀_inf D) (L_sub D) (hSpacesSub D)
    let KD : ↥E_sm → ℤ := fun P => K_div P - D P
    have hL_KD_mem : ∀ v : F,
        v ∈ L_sub KD ↔
          ∀ P : ↥E_sm, IsPlace P → ((-(K_div P - D P) : ℤ) : WithTop ℤ) ≤ ord P v :=
      fun v => (hSpacesSub KD).2.2.2 v
    have hDualD :=
      weil_dedekind_laurent_trace_codifferent_serre_duality Ω ↥E_sm F IsPlace ord x_sep K_div hDed
        D hD_nc hD_fin (E₀ D) (E_inf D) (E₀_inf D) (L_sub D) (L_sub KD)
        (hSpacesSub D) hL_KD_mem hFinH1_D
    have hSubsing : Subsingleton ↥(L_sub KD) := by
      refine Subsingleton.intro ?_
      rintro ⟨v₁, hv₁⟩ ⟨v₂, hv₂⟩
      ext
      by_contra hne
      have hv_ne : v₁ - v₂ ≠ 0 := sub_ne_zero.mpr hne
      have hv_mem : v₁ - v₂ ∈ L_sub KD := (L_sub KD).sub_mem hv₁ hv₂
      obtain ⟨hv_ord_fin, d_v, hdv_nc, hdv_ord, hdv_sum⟩ := hPrin (v₁ - v₂) hv_ne
      have hdv_fin : {P : ↥E_sm | d_v P ≠ 0}.Finite := by
        refine hv_ord_fin.subset ?_
        intro P hP_ne
        have hP_cl : IsPlace P := by
          by_contra hnot
          exact hP_ne (hdv_nc P hnot)
        refine ⟨hP_cl, ?_⟩
        rw [hdv_ord P hP_cl]
        exact WithTop.coe_ne_zero.mpr hP_ne
      classical
      let hFinAll := hD_fin.union (hK_fin.union hdv_fin)
      let S_all : Finset ↥E_sm := hFinAll.toFinset
      have hSuppD : Function.support D ⊆ ↑S_all := fun P hP =>
        Finset.mem_coe.mpr (hFinAll.mem_toFinset.mpr (Or.inl hP))
      have hSuppK : Function.support K_div ⊆ ↑S_all := fun P hP =>
        Finset.mem_coe.mpr (hFinAll.mem_toFinset.mpr (Or.inr (Or.inl hP)))
      have hSuppdv : Function.support d_v ⊆ ↑S_all := fun P hP =>
        Finset.mem_coe.mpr (hFinAll.mem_toFinset.mpr (Or.inr (Or.inr hP)))
      have h_le_pt : ∀ P : ↥E_sm, D P ≤ K_div P + d_v P := by
        intro P
        by_cases hP : IsPlace P
        · have h_ord_le : (-(K_div P - D P) : WithTop ℤ) ≤ (d_v P : WithTop ℤ) := by
            rw [← hdv_ord P hP]
            exact (hL_KD_mem (v₁ - v₂)).mp hv_mem P hP
          have h_int_le : -(K_div P - D P) ≤ d_v P := WithTop.coe_le_coe.mp h_ord_le
          omega
        · rw [hD_nc P hP, hK_nc P hP, hdv_nc P hP]
          omega
      have hSumD : (∑ᶠ P : E_sm, D P) = ∑ P ∈ S_all, D P :=
        finsum_eq_sum_of_support_subset D hSuppD
      have hSumK : (∑ᶠ P : E_sm, K_div P) = ∑ P ∈ S_all, K_div P :=
        finsum_eq_sum_of_support_subset K_div hSuppK
      have hSumdv : (∑ᶠ P : E_sm, d_v P) = ∑ P ∈ S_all, d_v P :=
        finsum_eq_sum_of_support_subset d_v hSuppdv
      have hSumLe : ∑ P ∈ S_all, D P ≤ ∑ P ∈ S_all, K_div P + ∑ P ∈ S_all, d_v P := by
        rw [← Finset.sum_add_distrib]
        exact Finset.sum_le_sum fun P _ => h_le_pt P
      rw [← hSumD, ← hSumK, ← hSumdv, hDegK, hdv_sum, add_zero] at hSumLe
      omega
    rw [hDualD.2]
    have : Subsingleton ↥(L_sub KD) := hSubsing
    exact Module.finrank_zero_of_subsingleton
  have hB6_1 : ∀ (D : E_sm → ℤ),
      (∀ P : E_sm, ¬IsClosed ({P} : Set E_sm) → D P = 0) →
      {P : E_sm | D P ≠ 0}.Finite →
      (2 : ℤ) * (g_E : ℤ) - 2 < (∑ᶠ P : E_sm, D P) →
      ∀ (L_D : Submodule Ω F),
        (∀ f : F, f ∈ L_D ↔
          ∀ P : E_sm, IsClosed ({P} : Set E_sm) → (-(D P) : WithTop ℤ) ≤ ord P f) →
        FiniteDimensional Ω ↥L_D ∧
          (Module.finrank Ω ↥L_D : ℤ) = (∑ᶠ P : E_sm, D P) + 1 - (g_E : ℤ) := by
    intro D hD_nc hD_fin hD_deg L_D hLD
    have hSp : IsTwoChartDivisorSpaces Ω ↥E_sm F IsPlace ord x_sep D
        (E₀ D) (E_inf D) (E₀_inf D) L_D :=
      ⟨(hSpacesSub D).1, (hSpacesSub D).2.1, (hSpacesSub D).2.2.1, hLD⟩
    obtain ⟨hFinLD, _, hEulerD, _⟩ :=
      hEuler D hD_nc hD_fin (E₀ D) (E_inf D) (E₀_inf D) L_D hSp
    have hH1_zero := hNonspecial D hD_nc hD_fin hD_deg
    rw [hH1_zero] at hEulerD
    refine ⟨hFinLD, ?_⟩
    omega
  refine ⟨hA1, hA2, ord, g_E, x_sep, K_div, ?_, hB2, hx_sep, hK_nc, hK_fin, hDegK, hK_chart,
    ?_, hPrin, ?_, ?_⟩
  · intro P hP
    have hVP := hValFull P hP
    exact ⟨hVP.1, hVP.2.1, hVP.2.2.1, hVP.2.2.2.1, hVP.2.2.2.2.1⟩
  · intro hg₀
    obtain ⟨P₀, hP₀⟩ := hA1.nonempty
    classical
    let D₁ : ↥E_sm → ℤ := fun P => if P = P₀ then 1 else 0
    have hD₁_nc : ∀ P : E_sm, ¬IsClosed ({P} : Set E_sm) → D₁ P = 0 := by
      intro P hP
      have hne : P ≠ P₀ := fun hEq => hP (hEq ▸ hP₀)
      simp [D₁, hne]
    have hD₁_fin : {P : E_sm | D₁ P ≠ 0}.Finite := by
      refine (Set.finite_singleton P₀).subset ?_
      intro P hP
      rw [Set.mem_singleton_iff]
      by_contra hne
      exact hP (by simp [D₁, hne])
    have hD₁_sum : (∑ᶠ P : E_sm, D₁ P) = 1 := by
      have hSupp1 : Function.support D₁ ⊆ ↑({P₀} : Finset ↥E_sm) := by
        intro P hP
        rw [Finset.coe_singleton, Set.mem_singleton_iff]
        by_contra hne
        exact hP (by simp [D₁, hne])
      rw [finsum_eq_sum_of_support_subset D₁ hSupp1, Finset.sum_singleton]
      simp [D₁]
    have hD₁_deg : (2 : ℤ) * (g_E : ℤ) - 2 < (∑ᶠ P : E_sm, D₁ P) := by
      rw [hg₀, hD₁_sum]
      omega
    obtain ⟨_, hRankD₁_int⟩ :=
      hB6_1 D₁ hD₁_nc hD₁_fin hD₁_deg (L_sub D₁) (hSpacesSub D₁).2.2.2
    have hRankD₁ : Module.finrank Ω ↥(L_sub D₁) = 2 := by
      rw [hg₀, hD₁_sum] at hRankD₁_int
      omega
    have hSubLe : L_sub D₀ ≤ L_sub D₁ := by
      intro v hv P hP _
      have hv0 : (0 : WithTop ℤ) ≤ ord P v := (hSpacesSub D₀).2.2.2 v |>.mp hv P hP
      have hD₁_nonneg : (-(D₁ P) : WithTop ℤ) ≤ (0 : WithTop ℤ) := by
        rw [← WithTop.coe_zero]
        exact WithTop.coe_le_coe.mpr (by dsimp [D₁]; split_ifs <;> omega)
      exact le_trans hD₁_nonneg hv0
    have hSubNe : L_sub D₀ ≠ L_sub D₁ := by
      intro hEq
      have hEqRank := congrArg (fun S : Submodule Ω F => Module.finrank Ω ↥S) hEq
      rw [hRankL0, hRankD₁] at hEqRank
      omega
    obtain ⟨f, hf_in, hf_not⟩ := SetLike.exists_of_lt (lt_of_le_of_ne hSubLe hSubNe)
    have hf_other : ∀ P : E_sm, IsClosed ({P} : Set E_sm) → P ≠ P₀ → (0 : WithTop ℤ) ≤ ord P f := by
      intro P hP hne
      have hfP := (hSpacesSub D₁).2.2.2 f |>.mp hf_in P hP
      simpa [D₁, hne] using hfP
    have hf_ge_neg1 : (-1 : WithTop ℤ) ≤ ord P₀ f := by
      have hfP₀ := (hSpacesSub D₁).2.2.2 f |>.mp hf_in P₀ hP₀
      simpa [D₁] using hfP₀
    have hf_not_nonneg : ¬ ((0 : WithTop ℤ) ≤ ord P₀ f) := by
      intro hf0
      apply hf_not
      rw [(hSpacesSub D₀).2.2.2]
      intro P hP
      by_cases hEq : P = P₀
      · subst hEq; simpa [D₀] using hf0
      · simpa [D₀] using hf_other P hP hEq
    have hf_ord_eq : ord P₀ f = (-1 : WithTop ℤ) := by
      cases h_ord : ord P₀ f with
      | top =>
        exfalso
        apply hf_not_nonneg
        rw [h_ord]
        exact le_top
      | coe k =>
        rw [h_ord] at hf_ge_neg1 hf_not_nonneg
        have hk1 : (-1 : ℤ) ≤ k := WithTop.coe_le_coe.mp hf_ge_neg1
        have hk2 : ¬ ((0 : ℤ) ≤ k) := fun hk => hf_not_nonneg (WithTop.coe_le_coe.mpr hk)
        have hk_eq : k = -1 := by omega
        rw [hk_eq]
        rfl
    exact hP1 P₀ f hP₀ hf_ord_eq hf_other
  · intro D hD_nc hD_fin hD_deg
    refine ⟨hB6_1 D hD_nc hD_fin hD_deg, ?_⟩
    intro m_cov W_cov _hAffCov hCovUniv c_F hc_diag hc_ov hc_cocycle
    have hH1_zero := hNonspecial D hD_nc hD_fin hD_deg
    refine hCech D hD_nc hD_fin (E₀ D) (E_inf D) (E₀_inf D) (L_sub D) (hSpacesSub D) hH1_zero
      m_cov (fun a => Nonempty ↥(W_cov a)) (fun a => (W_cov a : Set E_sm)) ?_ ?_
      c_F hc_diag ?_ hc_cocycle
    · intro P _hP
      have hP_univ : P ∈ (⋃ a : Fin m_cov, (W_cov a : Set E_sm)) := by
        rw [hCovUniv]
        exact Set.mem_univ P
      rcases Set.mem_iUnion.mp hP_univ with ⟨a, ha⟩
      exact ⟨a, ⟨⟨P, ha⟩⟩, ha⟩
    · intro a ⟨⟨x₀, hx₀⟩⟩
      have hClosedCompl : IsClosed ((W_cov a : Set E_sm)ᶜ) := (W_cov a).isOpen.isClosed_compl
      have hNeUniv : ((W_cov a : Set E_sm)ᶜ) ≠ Set.univ := by
        intro hUniv
        have hx₀_compl : x₀ ∈ ((W_cov a : Set E_sm)ᶜ) := by
          rw [hUniv]
          exact Set.mem_univ x₀
        exact hx₀_compl hx₀
      exact (hA2 _ hClosedCompl hNeUniv).1.subset fun P hP => hP.2
    · intro a b ha hb P hP_inter hP_cl
      exact hc_ov a b ha hb P hP_inter hP_cl
  · intro f hf
    exact (hPole f hf).2

theorem weil_nodal_pointed_stability_degree_bounds (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (M : WeilLineBundle C)
    (c δ : ℕ)
    (E_set : Fin (c + 1) → Set C)
    (E_norm : Fin (c + 1) → AlgebraicGeometry.Scheme.{u})
    (p_norm : ∀ α : Fin (c + 1), E_norm α ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (ν : ∀ α : Fin (c + 1), E_norm α ⟶ C)
    (F : Fin (c + 1) → Type u)
    [∀ α : Fin (c + 1), Field (F α)]
    [∀ α : Fin (c + 1), Algebra Ω (F α)]
    (η_F : ∀ α : Fin (c + 1), AlgebraicGeometry.Spec (CommRingCat.of (F α)) ⟶ E_norm α)
    (z_node : Fin δ → C)
    (α₀ : Fin δ → Fin (c + 1)) (P₀ : ∀ r : Fin δ, E_norm (α₀ r))
    (α₁ : Fin δ → Fin (c + 1)) (P₁ : ∀ r : Fin δ, E_norm (α₁ r))
    (hNormPkg : IsNodalCurveLogNormalizationPackage g n τ M c δ E_set E_norm p_norm ν F η_F
      z_node α₀ P₀ α₁ P₁)
    (g_E : Fin (c + 1) → ℕ)
    (hGenusZero : ∀ α : Fin (c + 1),
      g_E α = 0 →
      ∃ isoP1 : E_norm α ≅ (weilProjectiveSpaceOver Ω 1).left,
        isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom = p_norm α) :
    ∃ (B_div B_self_div D_div : ∀ α : Fin (c + 1), E_norm α → ℤ),
      IsNodalStabilityDivisorSystem g n τ c δ E_norm ν z_node α₀ α₁ g_E
        B_div B_self_div D_div :=
by
  classical
  have hn3 : 3 ≤ n := hStab.1
  have hτ_disj : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ i).base) (Set.range (τ j).base) :=
    hStab.2.2.2.2.2.2.1
  have hE_range : Set.range E_set = irreducibleComponents ↥C := hNormPkg.1.2.1
  have hE_univ : (⋃ α : Fin (c + 1), E_set α) = Set.univ := hNormPkg.1.2.2
  have hNorm_comp := hNormPkg.2.1
  have hClosedImm_ν := hNormPkg.2.2.1
  have hz_inj : Function.Injective z_node := hNormPkg.2.2.2.1.1
  have hz_br := hNormPkg.2.2.2.1.2.1
  have hSmooth_lift := hNormPkg.2.2.2.1.2.2.1
  have hE_inter := hNormPkg.2.2.2.1.2.2.2.1
  have hτ_smooth := hNormPkg.2.2.2.1.2.2.2.2

  
  let B_div : ∀ α : Fin (c + 1), E_norm α → ℤ :=
    fun α P => if (ν α).base P ∈ Set.range z_node then 1 else 0
  let B_self_div : ∀ α : Fin (c + 1), E_norm α → ℤ :=
    fun α P => if ∃ r : Fin δ, α₀ r = α ∧ α₁ r = α ∧ (ν α).base P = z_node r then 1 else 0
  let D_div : ∀ α : Fin (c + 1), E_norm α → ℤ :=
    fun α P => if ∃ j : Fin n, (ν α).base P ∈ Set.range (τ j).base then 1 else 0
  let s_self : Fin (c + 1) → ℕ :=
    fun α => (Finset.univ.filter (fun r : Fin δ => α₀ r = α ∧ α₁ r = α)).card
  let s_ext : Fin (c + 1) → ℕ :=
    fun α => (Finset.univ.filter (fun r : Fin δ =>
      (α₀ r = α ∧ α₁ r ≠ α) ∨ (α₀ r ≠ α ∧ α₁ r = α))).card
  let m_mark : Fin (c + 1) → ℕ :=
    fun α => (Finset.univ.filter (fun j : Fin n => Set.range (τ j).base ⊆ E_set α)).card

  
  have hClause1 : ∀ (α : Fin (c + 1)) (P : E_norm α),
      ((B_div α P = 1 ∧ IsClosed ({P} : Set (E_norm α)) ∧
          (ν α).base P ∈ Set.range z_node) ∨
        (B_div α P = 0 ∧ (ν α).base P ∉ Set.range z_node)) ∧
      ((B_self_div α P = 1 ∧ IsClosed ({P} : Set (E_norm α)) ∧
          ∃ r : Fin δ, α₀ r = α ∧ α₁ r = α ∧ (ν α).base P = z_node r) ∨
        (B_self_div α P = 0 ∧
          ¬∃ r : Fin δ, α₀ r = α ∧ α₁ r = α ∧ (ν α).base P = z_node r)) ∧
      ((D_div α P = 1 ∧ IsClosed ({P} : Set (E_norm α)) ∧
          ∃ j : Fin n, (ν α).base P ∈ Set.range (τ j).base) ∨
        (D_div α P = 0 ∧ ∀ j : Fin n, (ν α).base P ∉ Set.range (τ j).base)) ∧
      B_self_div α P ≤ B_div α P ∧
      (B_div α P = 0 ∨ D_div α P = 0) := by
    intro α P
    have hCl_iff : IsClosed ({P} : Set (E_norm α)) ↔ IsClosed ({(ν α).base P} : Set C) :=
      (hNorm_comp α).2.2.2.2.2.2.1 P
    have hB : (B_div α P = 1 ∧ IsClosed ({P} : Set (E_norm α)) ∧
          (ν α).base P ∈ Set.range z_node) ∨
        (B_div α P = 0 ∧ (ν α).base P ∉ Set.range z_node) := by
      by_cases hmem : (ν α).base P ∈ Set.range z_node
      · left
        have hb1 : B_div α P = 1 := by
          dsimp only [B_div]; split_ifs <;> first | rfl | contradiction
        rcases hmem with ⟨r, hr⟩
        refine ⟨hb1, hCl_iff.mpr ?_, ⟨r, hr⟩⟩
        rw [← hr]
        exact (hz_br r).1
      · right
        refine ⟨?_, hmem⟩
        dsimp only [B_div]; split_ifs <;> first | rfl | contradiction
    have hB_self : (B_self_div α P = 1 ∧ IsClosed ({P} : Set (E_norm α)) ∧
          ∃ r : Fin δ, α₀ r = α ∧ α₁ r = α ∧ (ν α).base P = z_node r) ∨
        (B_self_div α P = 0 ∧
          ¬∃ r : Fin δ, α₀ r = α ∧ α₁ r = α ∧ (ν α).base P = z_node r) := by
      by_cases hself : ∃ r : Fin δ, α₀ r = α ∧ α₁ r = α ∧ (ν α).base P = z_node r
      · left
        have hbs1 : B_self_div α P = 1 := by
          dsimp only [B_self_div]; split_ifs <;> first | rfl | contradiction
        rcases hself with ⟨r, h0, h1, hr⟩
        refine ⟨hbs1, hCl_iff.mpr ?_, ⟨r, h0, h1, hr⟩⟩
        rw [hr]
        exact (hz_br r).1
      · right
        refine ⟨?_, hself⟩
        dsimp only [B_self_div]; split_ifs <;> first | rfl | contradiction
    have hD : (D_div α P = 1 ∧ IsClosed ({P} : Set (E_norm α)) ∧
          ∃ j : Fin n, (ν α).base P ∈ Set.range (τ j).base) ∨
        (D_div α P = 0 ∧ ∀ j : Fin n, (ν α).base P ∉ Set.range (τ j).base) := by
      by_cases hmark : ∃ j : Fin n, (ν α).base P ∈ Set.range (τ j).base
      · left
        have hd1 : D_div α P = 1 := by
          dsimp only [D_div]; split_ifs <;> first | rfl | contradiction
        rcases hmark with ⟨j, ⟨q, hq⟩⟩
        refine ⟨hd1, hCl_iff.mpr ?_, ⟨j, ⟨q, hq⟩⟩⟩
        rw [← hq]
        exact (hτ_smooth j q).1
      · right
        refine ⟨?_, fun j hj => hmark ⟨j, hj⟩⟩
        dsimp only [D_div]; split_ifs <;> first | rfl | contradiction
    have h_le : B_self_div α P ≤ B_div α P := by
      rcases hB_self with ⟨h1, _, ⟨r, _, _, hr⟩⟩ | ⟨h0, _⟩
      · have hmem : (ν α).base P ∈ Set.range z_node := ⟨r, hr.symm⟩
        rcases hB with ⟨hb1, _⟩ | ⟨_, hnot⟩
        · omega
        · exact False.elim (hnot hmem)
      · rcases hB with ⟨hb1, _⟩ | ⟨hb0, _⟩ <;> omega
    have h_disj : B_div α P = 0 ∨ D_div α P = 0 := by
      rcases hD with ⟨_, _, ⟨j, ⟨q, hq⟩⟩⟩ | ⟨hd0, _⟩
      · left
        have hnot : (ν α).base P ∉ Set.range z_node := by
          rw [← hq]
          exact (hτ_smooth j q).2
        rcases hB with ⟨_, _, hmem⟩ | ⟨hb0, _⟩
        · exact False.elim (hnot hmem)
        · exact hb0
      · right; exact hd0
    exact ⟨hB, hB_self, hD, h_le, h_disj⟩

  
  let sigmaSndEq : ∀ (α : Fin (c + 1)) (p : Σ β : Fin (c + 1), E_norm β),
      p.1 = α → E_norm α :=
    fun _ ⟨_, Q⟩ h => h ▸ Q
  have hSigmaSndEq : ∀ (α : Fin (c + 1)) (p : Σ β : Fin (c + 1), E_norm β) (h : p.1 = α),
      (⟨α, sigmaSndEq α p h⟩ : Σ β : Fin (c + 1), E_norm β) = p := by
    rintro α ⟨β, Q⟩ h
    dsimp at h
    subst h
    rfl

  have hSigmaFinsum : ∀ {ι : Type} [Fintype ι]
      (Φ : ι → Σ β : Fin (c + 1), E_norm β),
      Function.Injective Φ →
      ∀ (α : Fin (c + 1)) (pred : E_norm α → Prop) (f : E_norm α → ℤ),
        (∀ P : E_norm α, pred P ↔ ∃ i : ι, Φ i = ⟨α, P⟩) →
        (∀ P : E_norm α, pred P → f P = 1) →
        (∀ P : E_norm α, ¬pred P → f P = 0) →
        {P : E_norm α | f P ≠ 0}.Finite ∧
          (∑ᶠ P : E_norm α, f P) =
            ((Finset.univ.filter (fun i : ι => (Φ i).1 = α)).card : ℤ) := by
    intro ι _ Φ hΦ_inj α pred f hpred hf1 hf0
    let S_ι : Finset ι := Finset.univ.filter (fun i : ι => (Φ i).1 = α)
    let lift_α : ↥S_ι → E_norm α :=
      fun x => sigmaSndEq α (Φ x.1) (Finset.mem_filter.mp x.2).2
    have h_lift_sigma : ∀ x : ↥S_ι,
        (⟨α, lift_α x⟩ : Σ β : Fin (c + 1), E_norm β) = Φ x.1 :=
      fun x => hSigmaSndEq α (Φ x.1) (Finset.mem_filter.mp x.2).2
    have hinj_lift : Function.Injective lift_α := by
      intro x y hxy
      apply Subtype.ext
      apply hΦ_inj
      rw [← h_lift_sigma x, ← h_lift_sigma y, hxy]
    let s_P : Finset (E_norm α) := Finset.univ.map ⟨lift_α, hinj_lift⟩
    have hmem_sP : ∀ P : E_norm α, P ∈ s_P ↔ pred P := by
      intro P
      constructor
      · intro hP
        rcases Finset.mem_map.mp hP with ⟨x, _, rfl⟩
        exact (hpred (lift_α x)).mpr ⟨x.1, (h_lift_sigma x).symm⟩
      · intro hP
        rcases (hpred P).mp hP with ⟨i, hi_eq⟩
        have hi_mem : i ∈ S_ι :=
          Finset.mem_filter.mpr ⟨Finset.mem_univ i, congrArg Sigma.fst hi_eq⟩
        refine Finset.mem_map.mpr ⟨⟨i, hi_mem⟩, Finset.mem_univ _, ?_⟩
        exact eq_of_heq (Sigma.mk.inj_iff.mp ((h_lift_sigma ⟨i, hi_mem⟩).trans hi_eq)).2
    have h_supp : Function.support f ⊆ (s_P : Set (E_norm α)) := by
      intro P hP
      rw [Finset.mem_coe, hmem_sP]
      by_contra hnot
      exact hP (hf0 P hnot)
    refine ⟨s_P.finite_toSet.subset h_supp, ?_⟩
    rw [finsum_eq_sum_of_support_subset f h_supp]
    have hsum1 : ∑ P ∈ s_P, f P = ∑ _P ∈ s_P, (1 : ℤ) := by
      apply Finset.sum_congr rfl
      intro P hP
      exact hf1 P ((hmem_sP P).mp hP)
    rw [hsum1, Finset.sum_const, nsmul_eq_mul, mul_one]
    have hcard_eq : s_P.card = S_ι.card := by
      rw [Finset.card_map, Finset.card_univ, Fintype.card_coe]
    exact congrArg Nat.cast hcard_eq

  let nu_sigma : (Σ β : Fin (c + 1), E_norm β) → C := fun p => (ν p.1).base p.2

  
  let Φ_br : Fin δ × Bool → Σ β : Fin (c + 1), E_norm β :=
    fun p => cond p.2 ⟨α₁ p.1, P₁ p.1⟩ ⟨α₀ p.1, P₀ p.1⟩
  have hΦ_br_img : ∀ p : Fin δ × Bool, nu_sigma (Φ_br p) = z_node p.1 := by
    rintro ⟨r, b⟩
    cases b
    · exact (hz_br r).2.2.2.1
    · exact (hz_br r).2.2.2.2.1
  have hΦ_br_inj : Function.Injective Φ_br := by
    rintro ⟨r₁, b₁⟩ ⟨r₂, b₂⟩ h
    have hr : z_node r₁ = z_node r₂ := by
      rw [← hΦ_br_img (r₁, b₁), ← hΦ_br_img (r₂, b₂), h]
    have hr_eq : r₁ = r₂ := hz_inj hr
    subst hr_eq
    cases b₁ <;> cases b₂
    · rfl
    · exact False.elim ((hz_br r₁).2.2.2.2.2.1 h)
    · exact False.elim ((hz_br r₁).2.2.2.2.2.1 h.symm)
    · rfl
  have hB_pred : ∀ (α : Fin (c + 1)) (P : E_norm α),
      (ν α).base P ∈ Set.range z_node ↔ ∃ p : Fin δ × Bool, Φ_br p = ⟨α, P⟩ := by
    intro α P
    constructor
    · rintro ⟨r, hr⟩
      rcases (hz_br r).2.2.2.2.2.2 α P hr.symm with h0 | h1
      · exact ⟨(r, false), h0.symm⟩
      · exact ⟨(r, true), h1.symm⟩
    · rintro ⟨⟨r, b⟩, hp⟩
      exact ⟨r, (hΦ_br_img (r, b)).symm.trans (congrArg nu_sigma hp)⟩

  have hΦ_br_fiber_card : ∀ α : Fin (c + 1),
      (Finset.univ.filter (fun p : Fin δ × Bool => (Φ_br p).1 = α)).card =
        2 * s_self α + s_ext α := by
    intro α
    let S₀ : Finset (Fin δ) := Finset.univ.filter (fun r : Fin δ => α₀ r = α)
    let S₁ : Finset (Fin δ) := Finset.univ.filter (fun r : Fin δ => α₁ r = α)
    let F₀ : Finset (Fin δ × Bool) :=
      S₀.map ⟨fun r => (r, false), fun _ _ h => (Prod.mk.inj h).1⟩
    let F₁ : Finset (Fin δ × Bool) :=
      S₁.map ⟨fun r => (r, true), fun _ _ h => (Prod.mk.inj h).1⟩
    have hF_disj : Disjoint F₀ F₁ := by
      rw [Finset.disjoint_left]
      intro p hp0 hp1
      rcases Finset.mem_map.mp hp0 with ⟨r0, _, rfl⟩
      rcases Finset.mem_map.mp hp1 with ⟨r1, _, h1⟩
      exact Bool.noConfusion (Prod.mk.inj h1).2
    have hF_eq : Finset.univ.filter (fun p : Fin δ × Bool => (Φ_br p).1 = α) = F₀ ∪ F₁ := by
      ext ⟨r, b⟩
      cases b
      · simp only [Φ_br, Bool.cond_false, Finset.mem_filter, Finset.mem_univ, true_and,
          Finset.mem_union, F₀, F₁, Finset.mem_map, S₀, S₁]
        constructor
        · intro h; left; exact ⟨r, h, rfl⟩
        · rintro (⟨a, ha, hpair⟩ | ⟨a, _, hpair⟩)
          · have har : a = r := (Prod.mk.inj hpair).1
            rwa [← har]
          · exact Bool.noConfusion (Prod.mk.inj hpair).2
      · simp only [Φ_br, Bool.cond_true, Finset.mem_filter, Finset.mem_univ, true_and,
          Finset.mem_union, F₀, F₁, Finset.mem_map, S₀, S₁]
        constructor
        · intro h; right; exact ⟨r, h, rfl⟩
        · rintro (⟨a, _, hpair⟩ | ⟨a, ha, hpair⟩)
          · exact Bool.noConfusion (Prod.mk.inj hpair).2
          · have har : a = r := (Prod.mk.inj hpair).1
            rwa [← har]
    have hcard_F : (Finset.univ.filter (fun p : Fin δ × Bool => (Φ_br p).1 = α)).card =
        S₀.card + S₁.card := by
      rw [hF_eq, Finset.card_union_of_disjoint hF_disj, Finset.card_map, Finset.card_map]
    let A_both := Finset.univ.filter (fun r : Fin δ => α₀ r = α ∧ α₁ r = α)
    let A_01 := Finset.univ.filter (fun r : Fin δ => α₀ r = α ∧ α₁ r ≠ α)
    let A_10 := Finset.univ.filter (fun r : Fin δ => α₀ r ≠ α ∧ α₁ r = α)
    have hS0_eq : S₀ = A_both ∪ A_01 := by
      ext r; simp only [S₀, A_both, A_01, Finset.mem_filter, Finset.mem_union, Finset.mem_univ,
        true_and]; tauto
    have hS1_eq : S₁ = A_both ∪ A_10 := by
      ext r; simp only [S₁, A_both, A_10, Finset.mem_filter, Finset.mem_union, Finset.mem_univ,
        true_and]; tauto
    have hExt_eq : Finset.univ.filter (fun r : Fin δ =>
        (α₀ r = α ∧ α₁ r ≠ α) ∨ (α₀ r ≠ α ∧ α₁ r = α)) = A_01 ∪ A_10 := by
      ext r; simp only [A_01, A_10, Finset.mem_filter, Finset.mem_union, Finset.mem_univ,
        true_and]
    have hd0 : Disjoint A_both A_01 := by
      rw [Finset.disjoint_filter]; intro r _ h1 h2; exact h2.2 h1.2
    have hd1 : Disjoint A_both A_10 := by
      rw [Finset.disjoint_filter]; intro r _ h1 h2; exact h2.1 h1.1
    have hd_ext : Disjoint A_01 A_10 := by
      rw [Finset.disjoint_filter]; intro r _ h1 h2; exact h2.1 h1.1
    have hc0 : S₀.card = s_self α + A_01.card := by
      rw [hS0_eq, Finset.card_union_of_disjoint hd0]
    have hc1 : S₁.card = s_self α + A_10.card := by
      rw [hS1_eq, Finset.card_union_of_disjoint hd1]
    have hc_ext : s_ext α = A_01.card + A_10.card := by
      change (Finset.univ.filter _).card = _
      rw [hExt_eq, Finset.card_union_of_disjoint hd_ext]
    omega

  have hSumB_nat : ∑ α : Fin (c + 1), (2 * s_self α + s_ext α) = 2 * δ := by
    have h1 : ∑ α : Fin (c + 1), (2 * s_self α + s_ext α) =
        ∑ α ∈ (Finset.univ : Finset (Fin (c + 1))),
          (Finset.univ.filter (fun p : Fin δ × Bool => (Φ_br p).1 = α)).card := by
      apply Finset.sum_congr rfl
      intro α _
      exact (hΦ_br_fiber_card α).symm
    rw [h1, ← Finset.card_eq_sum_card_fiberwise
      (f := fun p : Fin δ × Bool => (Φ_br p).1)
      (s := Finset.univ) (t := Finset.univ) (fun _ _ => Finset.mem_univ _)]
    simp [Fintype.card_prod, Nat.mul_comm]

  
  let ι_self := {r : Fin δ // α₀ r = α₁ r} × Bool
  let Φ_self : ι_self → Σ β : Fin (c + 1), E_norm β := fun p => Φ_br (p.1.1, p.2)
  have hΦ_self_inj : Function.Injective Φ_self := by
    rintro ⟨⟨r₁, hr₁⟩, b₁⟩ ⟨⟨r₂, hr₂⟩, b₂⟩ h
    have hpair := hΦ_br_inj h
    cases Prod.mk.inj hpair with
    | intro h_r h_b =>
      subst h_r; subst h_b; rfl
  have hB_self_pred : ∀ (α : Fin (c + 1)) (P : E_norm α),
      (∃ r : Fin δ, α₀ r = α ∧ α₁ r = α ∧ (ν α).base P = z_node r) ↔
        ∃ p : ι_self, Φ_self p = ⟨α, P⟩ := by
    intro α P
    constructor
    · rintro ⟨r, h0, h1, hP⟩
      have hr : α₀ r = α₁ r := h0.trans h1.symm
      rcases (hz_br r).2.2.2.2.2.2 α P hP with hb0 | hb1
      · exact ⟨(⟨r, hr⟩, false), hb0.symm⟩
      · exact ⟨(⟨r, hr⟩, true), hb1.symm⟩
    · rintro ⟨⟨⟨r, hr⟩, b⟩, hp⟩
      have hP : (ν α).base P = z_node r :=
        (congrArg nu_sigma hp.symm).trans (hΦ_br_img (r, b))
      have hfst : (Φ_br (r, b)).1 = α := congrArg Sigma.fst hp
      cases b
      · dsimp [Φ_br] at hfst
        exact ⟨r, hfst, hr.symm.trans hfst, hP⟩
      · dsimp [Φ_br] at hfst
        exact ⟨r, hr.trans hfst, hfst, hP⟩

  have hΦ_self_fiber_card : ∀ α : Fin (c + 1),
      (Finset.univ.filter (fun p : ι_self => (Φ_self p).1 = α)).card = 2 * s_self α := by
    intro α
    let A_both := Finset.univ.filter (fun r : Fin δ => α₀ r = α ∧ α₁ r = α)
    let embF : ↥A_both ↪ ι_self :=
      ⟨fun x => (⟨x.1, (Finset.mem_filter.mp x.2).2.1.trans
          (Finset.mem_filter.mp x.2).2.2.symm⟩, false),
        by intro x y h; exact Subtype.ext (Subtype.mk.inj (Prod.mk.inj h).1)⟩
    let embT : ↥A_both ↪ ι_self :=
      ⟨fun x => (⟨x.1, (Finset.mem_filter.mp x.2).2.1.trans
          (Finset.mem_filter.mp x.2).2.2.symm⟩, true),
        by intro x y h; exact Subtype.ext (Subtype.mk.inj (Prod.mk.inj h).1)⟩
    let GF : Finset ι_self := Finset.univ.map embF
    let GT : Finset ι_self := Finset.univ.map embT
    have hG_disj : Disjoint GF GT := by
      rw [Finset.disjoint_left]
      intro p hpF hpT
      rcases Finset.mem_map.mp hpF with ⟨x, _, rfl⟩
      rcases Finset.mem_map.mp hpT with ⟨y, _, hy⟩
      exact Bool.noConfusion (Prod.mk.inj hy).2
    have hG_eq : Finset.univ.filter (fun p : ι_self => (Φ_self p).1 = α) = GF ∪ GT := by
      ext ⟨⟨r, hr⟩, b⟩
      cases b
      · simp only [Φ_self, Φ_br, Bool.cond_false, Finset.mem_filter, Finset.mem_univ, true_and,
          Finset.mem_union, GF, GT, Finset.mem_map, embF, embT]
        constructor
        · intro h0
          left
          have hmem : r ∈ A_both :=
            Finset.mem_filter.mpr ⟨Finset.mem_univ r, h0, hr.symm.trans h0⟩
          exact ⟨⟨r, hmem⟩, rfl⟩
        · rintro (⟨x, hx⟩ | ⟨x, hx⟩)
          · have hrx : x.1 = r := Subtype.mk.inj (Prod.mk.inj hx).1
            rw [← hrx]
            exact (Finset.mem_filter.mp x.2).2.1
          · exact Bool.noConfusion (Prod.mk.inj hx).2
      · simp only [Φ_self, Φ_br, Bool.cond_true, Finset.mem_filter, Finset.mem_univ, true_and,
          Finset.mem_union, GF, GT, Finset.mem_map, embF, embT]
        constructor
        · intro h1
          right
          have hmem : r ∈ A_both :=
            Finset.mem_filter.mpr ⟨Finset.mem_univ r, hr.trans h1, h1⟩
          exact ⟨⟨r, hmem⟩, rfl⟩
        · rintro (⟨x, hx⟩ | ⟨x, hx⟩)
          · exact Bool.noConfusion (Prod.mk.inj hx).2
          · have hrx : x.1 = r := Subtype.mk.inj (Prod.mk.inj hx).1
            rw [← hrx]
            exact (Finset.mem_filter.mp x.2).2.2
    rw [hG_eq, Finset.card_union_of_disjoint hG_disj, Finset.card_map, Finset.card_map,
      Finset.card_univ, Fintype.card_coe]
    change A_both.card + A_both.card = 2 * s_self α
    change s_self α + s_self α = 2 * s_self α
    omega

  
  let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := default
  have hRangeτ : ∀ j : Fin n, Set.range (τ j).base = {(τ j).base pt₀} := by
    intro j
    ext x
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨q, rfl⟩
      rw [Unique.eq_default q]
    · rintro rfl
      exact ⟨pt₀, rfl⟩
  have hU_mk : ∀ j : Fin n,
      ∃! pair : Σ α : Fin (c + 1), E_norm α, (ν pair.1).base pair.2 = (τ j).base pt₀ :=
    fun j => (hSmooth_lift ((τ j).base pt₀) (hτ_smooth j pt₀).2).2
  let Ψ_mk : Fin n → Σ α : Fin (c + 1), E_norm α := fun j => Classical.choose (hU_mk j)
  have hΨ_spec : ∀ j : Fin n, nu_sigma (Ψ_mk j) = (τ j).base pt₀ :=
    fun j => (Classical.choose_spec (hU_mk j)).1
  have hΨ_uniq : ∀ (j : Fin n) (pair : Σ α : Fin (c + 1), E_norm α),
      nu_sigma pair = (τ j).base pt₀ → pair = Ψ_mk j :=
    fun j pair hp => (Classical.choose_spec (hU_mk j)).2 pair hp
  have hΨ_inj : Function.Injective Ψ_mk := by
    intro i j hij
    by_contra hne
    have hpt : (τ i).base pt₀ = (τ j).base pt₀ := by
      rw [← hΨ_spec i, ← hΨ_spec j, hij]
    exact Set.disjoint_left.mp (hτ_disj hne) ⟨pt₀, rfl⟩ ⟨pt₀, hpt.symm⟩
  have hD_pred : ∀ (α : Fin (c + 1)) (P : E_norm α),
      (∃ j : Fin n, (ν α).base P ∈ Set.range (τ j).base) ↔
        ∃ j : Fin n, Ψ_mk j = ⟨α, P⟩ := by
    intro α P
    constructor
    · rintro ⟨j, hj⟩
      rw [hRangeτ j, Set.mem_singleton_iff] at hj
      exact ⟨j, (hΨ_uniq j ⟨α, P⟩ hj).symm⟩
    · rintro ⟨j, hj⟩
      refine ⟨j, ?_⟩
      rw [hRangeτ j, Set.mem_singleton_iff]
      exact (congrArg nu_sigma hj).symm.trans (hΨ_spec j)
  have hΨ_fst_iff : ∀ (α : Fin (c + 1)) (j : Fin n),
      (Ψ_mk j).1 = α ↔ Set.range (τ j).base ⊆ E_set α := by
    intro α j
    rw [hRangeτ j, Set.singleton_subset_iff]
    constructor
    · intro hα
      rw [← hα, ← (hNorm_comp (Ψ_mk j).1).2.2.2.2.2.1, ← hΨ_spec j]
      exact ⟨(Ψ_mk j).2, rfl⟩
    · intro hmem
      by_contra hne
      have hmemΨ : (τ j).base pt₀ ∈ E_set (Ψ_mk j).1 := by
        rw [← (hNorm_comp (Ψ_mk j).1).2.2.2.2.2.1, ← hΨ_spec j]
        exact ⟨(Ψ_mk j).2, rfl⟩
      exact (hτ_smooth j pt₀).2 (hE_inter (Ψ_mk j).1 α hne ⟨hmemΨ, hmem⟩)
  have hΨ_fiber_card : ∀ α : Fin (c + 1),
      (Finset.univ.filter (fun j : Fin n => (Ψ_mk j).1 = α)).card = m_mark α := by
    intro α
    apply congrArg Finset.card
    ext j
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, hΨ_fst_iff α j]
  have hSumM_nat : ∑ α : Fin (c + 1), m_mark α = n := by
    have h1 : ∑ α : Fin (c + 1), m_mark α =
        ∑ α ∈ (Finset.univ : Finset (Fin (c + 1))),
          (Finset.univ.filter (fun j : Fin n => (Ψ_mk j).1 = α)).card := by
      apply Finset.sum_congr rfl
      intro α _
      exact (hΨ_fiber_card α).symm
    rw [h1, ← Finset.card_eq_sum_card_fiberwise
      (f := fun j : Fin n => (Ψ_mk j).1)
      (s := Finset.univ) (t := Finset.univ) (fun _ _ => Finset.mem_univ _)]
    simp

  
  have hB_eval : ∀ α : Fin (c + 1),
      {P : E_norm α | B_div α P ≠ 0}.Finite ∧
        (∑ᶠ P : E_norm α, B_div α P) = (2 : ℤ) * (s_self α : ℤ) + (s_ext α : ℤ) := by
    intro α
    obtain ⟨hfin, hsum⟩ := hSigmaFinsum Φ_br hΦ_br_inj α
      (fun P => (ν α).base P ∈ Set.range z_node) (B_div α)
      (hB_pred α)
      (fun P h => by
        rcases (hClause1 α P).1 with ⟨hb1, _⟩ | ⟨_, hnot⟩
        · exact hb1
        · exact False.elim (hnot h))
      (fun P h => by
        rcases (hClause1 α P).1 with ⟨_, _, hmem⟩ | ⟨hb0, _⟩
        · exact False.elim (h hmem)
        · exact hb0)
    refine ⟨hfin, ?_⟩
    rw [hsum, hΦ_br_fiber_card α]
    push_cast
    ring
  have hB_self_eval : ∀ α : Fin (c + 1),
      {P : E_norm α | B_self_div α P ≠ 0}.Finite ∧
        (∑ᶠ P : E_norm α, B_self_div α P) = (2 : ℤ) * (s_self α : ℤ) := by
    intro α
    obtain ⟨hfin, hsum⟩ := hSigmaFinsum Φ_self hΦ_self_inj α
      (fun P => ∃ r : Fin δ, α₀ r = α ∧ α₁ r = α ∧ (ν α).base P = z_node r) (B_self_div α)
      (hB_self_pred α)
      (fun P h => by
        rcases (hClause1 α P).2.1 with ⟨hbs1, _⟩ | ⟨_, hnot⟩
        · exact hbs1
        · exact False.elim (hnot h))
      (fun P h => by
        rcases (hClause1 α P).2.1 with ⟨_, _, hmem⟩ | ⟨hbs0, _⟩
        · exact False.elim (h hmem)
        · exact hbs0)
    refine ⟨hfin, ?_⟩
    rw [hsum, hΦ_self_fiber_card α]
    push_cast
    ring
  have hD_eval : ∀ α : Fin (c + 1),
      {P : E_norm α | D_div α P ≠ 0}.Finite ∧
        (∑ᶠ P : E_norm α, D_div α P) = (m_mark α : ℤ) := by
    intro α
    obtain ⟨hfin, hsum⟩ := hSigmaFinsum Ψ_mk hΨ_inj α
      (fun P => ∃ j : Fin n, (ν α).base P ∈ Set.range (τ j).base) (D_div α)
      (hD_pred α)
      (fun P h => by
        rcases (hClause1 α P).2.2.1 with ⟨hd1, _⟩ | ⟨_, hnot⟩
        · exact hd1
        · rcases h with ⟨j, hj⟩
          exact False.elim (hnot j hj))
      (fun P h => by
        rcases (hClause1 α P).2.2.1 with ⟨_, _, hmem⟩ | ⟨hd0, _⟩
        · exact False.elim (h hmem)
        · exact hd0)
    refine ⟨hfin, ?_⟩
    rw [hsum, hΨ_fiber_card α]

  
  let s_id : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of Ω) := 𝟙 _
  let P_pb := CategoryTheory.Limits.pullback g s_id
  have hPb : CategoryTheory.IsPullback (𝟙 C) g g s_id :=
    CategoryTheory.IsPullback.of_id_fst
  let isoPb : C ≅ P_pb := hPb.isoPullback
  let e_pb : ↥C ≃ₜ ↥P_pb := AlgebraicGeometry.Scheme.homeoOfIso isoPb
  have hStab_id := hStab.2.2.2.2.2.2.2.2 Ω s_id
  have : ConnectedSpace ↥P_pb := hStab_id.1
  have : ConnectedSpace ↥C :=
    e_pb.symm.surjective.connectedSpace e_pb.symm.continuous

  have hClosedE : ∀ α : Fin (c + 1), IsClosed (E_set α) := by
    intro α
    apply isClosed_of_mem_irreducibleComponents
    rw [← hE_range]
    exact ⟨α, rfl⟩
  have hNonemptyE : ∀ α : Fin (c + 1), (E_set α).Nonempty := by
    intro α
    have hInt : AlgebraicGeometry.IsIntegral (E_norm α) := (hNorm_comp α).1
    have hIrred : IrreducibleSpace ↥(E_norm α) :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral (E_norm α) hInt
    obtain ⟨P⟩ := hIrred.toNonempty
    rw [← (hNorm_comp α).2.2.2.2.2.1]
    exact ⟨(ν α).base P, P, rfl⟩
  have hNodeMemComp : ∀ (α : Fin (c + 1)) (r : Fin δ),
      z_node r ∈ E_set α → α = α₀ r ∨ α = α₁ r := by
    intro α r hz
    rw [← (hNorm_comp α).2.2.2.2.2.1] at hz
    rcases hz with ⟨P, hP⟩
    rcases (hz_br r).2.2.2.2.2.2 α P hP with h0 | h1
    · left; exact congrArg Sigma.fst h0
    · right; exact congrArg Sigma.fst h1
  have hInterNodeEdge : ∀ (α β : Fin (c + 1)) (x : C),
      α ≠ β → x ∈ E_set α → x ∈ E_set β →
      ∃ r : Fin δ, z_node r = x ∧
        ((α₀ r = α ∧ α₁ r = β) ∨ (α₀ r = β ∧ α₁ r = α)) := by
    intro α β x hne hxα hxβ
    rcases hE_inter α β hne ⟨hxα, hxβ⟩ with ⟨r, hr⟩
    refine ⟨r, hr, ?_⟩
    have hα := hNodeMemComp α r (hr.symm ▸ hxα)
    have hβ := hNodeMemComp β r (hr.symm ▸ hxβ)
    rcases hα with rfl | rfl <;> rcases hβ with rfl | rfl
    · exact False.elim (hne rfl)
    · left; exact ⟨rfl, rfl⟩
    · right; exact ⟨rfl, rfl⟩
    · exact False.elim (hne rfl)

  have hCut : ∀ (S : Finset (Fin (c + 1))),
      S.Nonempty → Sᶜ.Nonempty →
      ∃ α ∈ S, ∃ β ∈ Sᶜ, ∃ r : Fin δ,
        (α₀ r = α ∧ α₁ r = β) ∨ (α₀ r = β ∧ α₁ r = α) := by
    intro S hS hSc
    let U₁ : Set C := ⋃ α ∈ S, E_set α
    let U₂ : Set C := ⋃ β ∈ Sᶜ, E_set β
    have hCl1 : IsClosed U₁ := isClosed_biUnion_finset (fun α _ => hClosedE α)
    have hCl2 : IsClosed U₂ := isClosed_biUnion_finset (fun β _ => hClosedE β)
    have hUnion : U₁ ∪ U₂ = Set.univ := by
      ext x
      simp only [Set.mem_union, Set.mem_univ, iff_true]
      have hx_univ : x ∈ ⋃ γ : Fin (c + 1), E_set γ := by rw [hE_univ]; trivial
      rcases Set.mem_iUnion.mp hx_univ with ⟨γ, hγ⟩
      by_cases hγS : γ ∈ S
      · left; exact Set.mem_biUnion hγS hγ
      · right; exact Set.mem_biUnion (Finset.mem_compl.mpr hγS) hγ
    have hInterNe : (U₁ ∩ U₂).Nonempty := by
      by_contra hNotNe
      have hU1_eq_compl : U₁ = U₂ᶜ := by
        ext x
        constructor
        · intro hx1 hx2
          exact hNotNe ⟨x, hx1, hx2⟩
        · intro hx2
          have hx_or : x ∈ U₁ ∪ U₂ := by rw [hUnion]; trivial
          exact hx_or.resolve_right hx2
      have hOpen1 : IsOpen U₁ := by
        rw [hU1_eq_compl]
        exact hCl2.isOpen_compl
      have hClop1 : IsClopen U₁ := ⟨hCl1, hOpen1⟩
      rcases isClopen_iff.mp hClop1 with hEmpty | hUniv
      · rcases hS with ⟨α, hα⟩
        rcases hNonemptyE α with ⟨x, hx⟩
        have hxU1 : x ∈ U₁ := Set.mem_biUnion hα hx
        rw [hEmpty] at hxU1
        exact hxU1
      · rcases hSc with ⟨β, hβ⟩
        rcases hNonemptyE β with ⟨y, hy⟩
        have hyU2 : y ∈ U₂ := Set.mem_biUnion hβ hy
        have hyU1 : y ∈ U₁ := by rw [hUniv]; trivial
        exact hNotNe ⟨y, hyU1, hyU2⟩
    rcases hInterNe with ⟨x, hx1, hx2⟩
    rcases Set.mem_iUnion₂.mp hx1 with ⟨α, hα, hxα⟩
    rcases Set.mem_iUnion₂.mp hx2 with ⟨β, hβ, hxβ⟩
    have hne : α ≠ β := by
      intro heq
      subst heq
      exact (Finset.mem_compl.mp hβ) hα
    rcases hInterNodeEdge α β x hne hxα hxβ with ⟨r, _, hr⟩
    exact ⟨α, hα, β, hβ, r, hr⟩

  have hs_ext_pos : 0 < c → ∀ α : Fin (c + 1), 1 ≤ s_ext α := by
    intro hc α
    let S : Finset (Fin (c + 1)) := {α}
    have hS : S.Nonempty := ⟨α, Finset.mem_singleton_self α⟩
    have hSc : Sᶜ.Nonempty := by
      let γ₀ : Fin (c + 1) := ⟨0, by omega⟩
      let γ₁ : Fin (c + 1) := ⟨1, by omega⟩
      by_cases h0 : γ₀ = α
      · refine ⟨γ₁, Finset.mem_compl.mpr ?_⟩
        rw [Finset.mem_singleton]
        intro h1
        have hval : (0 : ℕ) = 1 := congrArg Fin.val (h0.trans h1.symm)
        omega
      · exact ⟨γ₀, Finset.mem_compl.mpr (Finset.mem_singleton.not.mpr h0)⟩
    rcases hCut S hS hSc with ⟨α', hα', β, hβ, r, hr⟩
    rw [Finset.mem_singleton] at hα'
    rw [hα'] at hr
    have hβ_ne : β ≠ α := fun h => (Finset.mem_compl.mp hβ) (Finset.mem_singleton.mpr h)
    refine Finset.card_pos.mpr ⟨r, Finset.mem_filter.mpr ⟨Finset.mem_univ r, ?_⟩⟩
    rcases hr with ⟨h0, h1⟩ | ⟨h0, h1⟩
    · left; exact ⟨h0, h1.trans_ne hβ_ne⟩
    · right; exact ⟨h0.trans_ne hβ_ne, h1⟩

  have hSpanTree : ∀ k : ℕ, k ≤ c →
      ∃ (S : Finset (Fin (c + 1))) (R : Finset (Fin δ)),
        S.card = k + 1 ∧ R.card = k ∧ ∀ r ∈ R, α₀ r ∈ S ∧ α₁ r ∈ S := by
    intro k
    induction k with
    | zero =>
      intro _
      exact ⟨{0}, ∅, by simp, by simp, by simp⟩
    | succ k ih =>
      intro hk1
      obtain ⟨S, R, hScard, hRcard, hSR⟩ := ih (by omega)
      have hS_ne : S.Nonempty := Finset.card_pos.mp (by omega)
      have hSc_ne : Sᶜ.Nonempty := by
        have hcompl := Finset.card_add_card_compl S
        rw [Fintype.card_fin] at hcompl
        exact Finset.card_pos.mp (by omega)
      rcases hCut S hS_ne hSc_ne with ⟨α, hα, β, hβ_compl, r, hr⟩
      have hβ_not : β ∉ S := Finset.mem_compl.mp hβ_compl
      have hr_not : r ∉ R := by
        intro hrR
        have hboth := hSR r hrR
        rcases hr with ⟨_, h1⟩ | ⟨h0, _⟩
        · exact hβ_not (h1 ▸ hboth.2)
        · exact hβ_not (h0 ▸ hboth.1)
      refine ⟨insert β S, insert r R, ?_, ?_, ?_⟩
      · rw [Finset.card_insert_of_notMem hβ_not, hScard]
      · rw [Finset.card_insert_of_notMem hr_not, hRcard]
      · intro r' hr'
        rcases Finset.mem_insert.mp hr' with rfl | hr'R
        · rcases hr with ⟨h0, h1⟩ | ⟨h0, h1⟩
          · exact ⟨h0 ▸ Finset.mem_insert_of_mem hα, h1 ▸ Finset.mem_insert_self β S⟩
          · exact ⟨h0 ▸ Finset.mem_insert_self β S, h1 ▸ Finset.mem_insert_of_mem hα⟩
        · exact ⟨Finset.mem_insert_of_mem (hSR r' hr'R).1,
            Finset.mem_insert_of_mem (hSR r' hr'R).2⟩

  have hc_le_δ : c ≤ δ := by
    obtain ⟨_, R, _, hRcard, _⟩ := hSpanTree c (le_refl c)
    have hle := Finset.card_le_univ R
    rw [hRcard, Fintype.card_fin] at hle
    exact hle

  
  have hHomeoIrred : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y]
      (h : X ≃ₜ Y) {V : Set X},
      V ∈ irreducibleComponents X → h '' V ∈ irreducibleComponents Y := by
    intro X Y _ _ h V hV
    refine ⟨hV.1.image h h.continuous.continuousOn, ?_⟩
    intro U hU hVU
    have h1 : h.symm '' U ⊆ V :=
      hV.2 (hU.image h.symm h.symm.continuous.continuousOn) (by
        intro x hx
        exact ⟨h x, hVU ⟨x, hx, rfl⟩, h.symm_apply_apply x⟩)
    intro y hy
    exact ⟨h.symm y, h1 ⟨y, hy, rfl⟩, h.apply_symm_apply y⟩

  have hinv_eq : isoPb.inv = CategoryTheory.Limits.pullback.fst g s_id := by
    have h := hPb.isoPullback_inv_fst
    rw [CategoryTheory.Category.comp_id] at h
    exact h
  have he_symm_apply : ∀ q : ↥P_pb,
      e_pb.symm q = (CategoryTheory.Limits.pullback.fst g s_id).base q := by
    intro q
    change (AlgebraicGeometry.Scheme.homeoOfIso isoPb).symm q = _
    rw [AlgebraicGeometry.Scheme.homeoOfIso_symm, AlgebraicGeometry.Scheme.homeoOfIso_apply]
    change isoPb.inv.base q = _
    rw [hinv_eq]

  have hP1_stab : ∀ α : Fin (c + 1),
      g_E α = 0 → s_self α = 0 → 3 ≤ s_ext α + m_mark α := by
    intro α hg0 hs0
    have hNoSelf : ∀ r : Fin δ, ¬(α₀ r = α ∧ α₁ r = α) := by
      intro r hr
      have hmem : r ∈ Finset.univ.filter (fun r' : Fin δ => α₀ r' = α ∧ α₁ r' = α) :=
        Finset.mem_filter.mpr ⟨Finset.mem_univ r, hr⟩
      have hpos : 0 < s_self α := Finset.card_pos.mpr ⟨r, hmem⟩
      omega
    have : AlgebraicGeometry.IsClosedImmersion (ν α) := hClosedImm_ν α hNoSelf
    have : AlgebraicGeometry.IsClosedImmersion isoPb.hom := inferInstance
    let E_pb : Set ↥P_pb := e_pb '' (E_set α)
    let ιE : E_norm α ⟶ P_pb := ν α ≫ isoPb.hom
    have hE_pb_mem : E_pb ∈ irreducibleComponents ↥P_pb := by
      apply hHomeoIrred e_pb
      rw [← hE_range]
      exact ⟨α, rfl⟩
    have hCl_ιE : AlgebraicGeometry.IsClosedImmersion ιE :=
      AlgebraicGeometry.IsClosedImmersion.comp (ν α) isoPb.hom
    have hInt_E : AlgebraicGeometry.IsIntegral (E_norm α) := (hNorm_comp α).1
    have hRange_ιE : Set.range ιE.base = E_pb := by
      ext q
      simp only [Set.mem_range, Set.mem_image, E_pb, ← (hNorm_comp α).2.2.2.2.2.1]
      constructor
      · rintro ⟨P, rfl⟩
        refine ⟨(ν α).base P, ⟨P, rfl⟩, ?_⟩
        rw [AlgebraicGeometry.Scheme.homeoOfIso_apply]
        exact (AlgebraicGeometry.Scheme.Hom.comp_apply (ν α) isoPb.hom P).symm
      · rintro ⟨x, ⟨P, rfl⟩, rfl⟩
        refine ⟨P, ?_⟩
        rw [AlgebraicGeometry.Scheme.homeoOfIso_apply]
        exact AlgebraicGeometry.Scheme.Hom.comp_apply (ν α) isoPb.hom P
    obtain ⟨isoP1, hisoP1⟩ := hGenusZero α hg0
    have hIsoP1_pb : ιE ≫ CategoryTheory.Limits.pullback.snd g s_id =
        isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom := by
      change (ν α ≫ isoPb.hom) ≫ CategoryTheory.Limits.pullback.snd g s_id = _
      rw [CategoryTheory.Category.assoc, hPb.isoPullback_hom_snd,
        (hNorm_comp α).2.2.2.2.1, hisoP1]
    obtain ⟨q₁, q₂, q₃, hq12, hq13, hq23, hq1E, hq2E, hq3E, hq_prop⟩ :=
      hStab_id.2.2 E_pb (E_norm α) ιE hE_pb_mem hCl_ιE hInt_E hRange_ιE ⟨isoP1, hIsoP1_pb⟩
    let q_fn : Fin 3 → ↥P_pb := ![q₁, q₂, q₃]
    let x_fn : Fin 3 → C := fun k => e_pb.symm (q_fn k)
    have hx_inj : Function.Injective x_fn := by
      intro k₁ k₂ hk
      have hqk : q_fn k₁ = q_fn k₂ := e_pb.symm.injective hk
      fin_cases k₁ <;> fin_cases k₂ <;> simp_all [q_fn]
    have hq_in_3 : ∀ k : Fin 3, q_fn k ∈ ({q₁, q₂, q₃} : Set ↥P_pb) := by
      intro k; fin_cases k <;> simp [q_fn]
    have hx_in_E : ∀ k : Fin 3, x_fn k ∈ E_set α := by
      intro k
      have hqE : q_fn k ∈ E_pb := by
        fin_cases k <;> simp [q_fn, hq1E, hq2E, hq3E]
      rcases hqE with ⟨x, hx, hxe⟩
      change e_pb.symm (q_fn k) ∈ E_set α
      rw [← hxe, e_pb.symm_apply_apply]
      exact hx
    let S_ext_fin := Finset.univ.filter (fun r : Fin δ =>
      (α₀ r = α ∧ α₁ r ≠ α) ∨ (α₀ r ≠ α ∧ α₁ r = α))
    let M_fin := Finset.univ.filter (fun j : Fin n => Set.range (τ j).base ⊆ E_set α)
    let val_fn : ↥S_ext_fin ⊕ ↥M_fin → C :=
      Sum.elim (fun r => z_node r.1) (fun j => (τ j.1).base pt₀)
    have hex_u : ∀ k : Fin 3, ∃ u : ↥S_ext_fin ⊕ ↥M_fin, val_fn u = x_fn k := by
      intro k
      rcases hq_prop (q_fn k) (hq_in_3 k) with ⟨E', hE'_mem, hE'_ne, hq_in_E'⟩ | ⟨j, hj_mem⟩
      · have hE'_C : e_pb.symm '' E' ∈ Set.range E_set := by
          rw [hE_range]
          exact hHomeoIrred e_pb.symm hE'_mem
        rcases hE'_C with ⟨β, hβ_eq⟩
        have hβ_ne : β ≠ α := by
          intro hβα
          subst hβα
          apply hE'_ne
          ext y
          constructor
          · intro hy
            refine ⟨e_pb.symm y, ?_, e_pb.apply_symm_apply y⟩
            rw [hβ_eq]
            exact ⟨y, hy, rfl⟩
          · rintro ⟨x, hx, rfl⟩
            rw [hβ_eq] at hx
            rcases hx with ⟨y, hy, hxy⟩
            have hy_eq : e_pb x = y := by
              rw [← hxy, e_pb.apply_symm_apply]
            rwa [hy_eq]
        have hx_in_β : x_fn k ∈ E_set β := by
          rw [hβ_eq]
          exact ⟨q_fn k, hq_in_E', rfl⟩
        rcases hInterNodeEdge α β (x_fn k) hβ_ne.symm (hx_in_E k) hx_in_β with ⟨r, hr_eq, hr_br⟩
        have hr_mem : r ∈ S_ext_fin := by
          refine Finset.mem_filter.mpr ⟨Finset.mem_univ r, ?_⟩
          rcases hr_br with ⟨h0, h1⟩ | ⟨h0, h1⟩
          · left; exact ⟨h0, h1.trans_ne hβ_ne⟩
          · right; exact ⟨h0.trans_ne hβ_ne, h1⟩
        exact ⟨Sum.inl ⟨r, hr_mem⟩, hr_eq⟩
      · rw [← he_symm_apply (q_fn k), hRangeτ j, Set.mem_singleton_iff] at hj_mem
        have hj_in_M : j ∈ M_fin := by
          refine Finset.mem_filter.mpr ⟨Finset.mem_univ j, ?_⟩
          rw [hRangeτ j, Set.singleton_subset_iff, ← hj_mem]
          exact hx_in_E k
        exact ⟨Sum.inr ⟨j, hj_in_M⟩, hj_mem.symm⟩
    choose φ hφ using hex_u
    have hφ_inj : Function.Injective φ := by
      intro k₁ k₂ h
      apply hx_inj
      rw [← hφ k₁, ← hφ k₂, h]
    have hcard := Fintype.card_le_of_injective φ hφ_inj
    rw [Fintype.card_fin, Fintype.card_sum, Fintype.card_coe, Fintype.card_coe] at hcard
    exact hcard

  
  refine ⟨B_div, B_self_div, D_div, hClause1,
    fun α => ⟨(hB_eval α).1, (hB_self_eval α).1, (hD_eval α).1⟩, ?_, ?_⟩
  · 
    intro α
    dsimp only
    rw [(hB_eval α).2, (hB_self_eval α).2, (hD_eval α).2]
    by_cases hc : c = 0
    · have hm_eq_n : m_mark α = n := by
        rw [← hSumM_nat]
        symm
        apply Finset.sum_eq_single α
        · intro β _ hβα
          exact False.elim (hβα (Fin.ext (by omega)))
        · intro hnot
          exact False.elim (hnot (Finset.mem_univ α))
      omega
    · have hc_pos : 0 < c := Nat.pos_of_ne_zero hc
      have hse1 : 1 ≤ s_ext α := hs_ext_pos hc_pos α
      by_cases hg0 : g_E α = 0
      · by_cases hs0 : s_self α = 0
        · have h3 := hP1_stab α hg0 hs0
          omega
        · omega
      · omega
  · 
    let b_nat : Fin (c + 1) → ℕ := fun α => 2 * s_self α + s_ext α
    have hterm : ∀ α : Fin (c + 1),
        3 * ((2 : ℤ) * (g_E α : ℤ) - 2 +
          (∑ᶠ P : E_norm α, B_div α P) + (∑ᶠ P : E_norm α, D_div α P)) +
          1 - (g_E α : ℤ) =
        5 * (g_E α : ℤ) - 5 + 3 * (b_nat α : ℤ) + 3 * (m_mark α : ℤ) := by
      intro α
      rw [(hB_eval α).2, (hD_eval α).2]
      dsimp only [b_nat]
      push_cast
      ring
    have hsum_rw :
        (∑ α : Fin (c + 1),
          (3 * ((2 : ℤ) * (g_E α : ℤ) - 2 +
            (∑ᶠ P : E_norm α, B_div α P) + (∑ᶠ P : E_norm α, D_div α P)) +
            1 - (g_E α : ℤ))) =
        5 * (∑ α : Fin (c + 1), (g_E α : ℤ)) - 5 * ((c : ℤ) + 1) +
          3 * (∑ α : Fin (c + 1), (b_nat α : ℤ)) +
          3 * (∑ α : Fin (c + 1), (m_mark α : ℤ)) := by
      have h1 : (∑ α : Fin (c + 1),
          (3 * ((2 : ℤ) * (g_E α : ℤ) - 2 +
            (∑ᶠ P : E_norm α, B_div α P) + (∑ᶠ P : E_norm α, D_div α P)) +
            1 - (g_E α : ℤ))) =
          ∑ α : Fin (c + 1),
            (5 * (g_E α : ℤ) - 5 + 3 * (b_nat α : ℤ) + 3 * (m_mark α : ℤ)) :=
        Finset.sum_congr rfl (fun α _ => hterm α)
      rw [h1, Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.sum_sub_distrib,
        ← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum, Finset.sum_const,
        Finset.card_univ, Fintype.card_fin]
      push_cast
      ring
    have hsum_b : (∑ α : Fin (c + 1), (b_nat α : ℤ)) = 2 * (δ : ℤ) := by
      rw [← Nat.cast_sum]
      exact (congrArg Nat.cast hSumB_nat).trans (by push_cast; ring)
    have hsum_m : (∑ α : Fin (c + 1), (m_mark α : ℤ)) = (n : ℤ) := by
      rw [← Nat.cast_sum]
      exact congrArg Nat.cast hSumM_nat
    have hsum_g_nonneg : (0 : ℤ) ≤ ∑ α : Fin (c + 1), (g_E α : ℤ) :=
      Finset.sum_nonneg (fun α _ => Nat.cast_nonneg _)
    rw [hsum_rw, hsum_b, hsum_m]
    omega

theorem weil_nodal_tricanonical_divisor_bridge_and_cech (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (M : WeilLineBundle C)
    (c δ : ℕ)
    (E_set : Fin (c + 1) → Set C)
    (E_norm : Fin (c + 1) → AlgebraicGeometry.Scheme.{u})
    (p_norm : ∀ α : Fin (c + 1), E_norm α ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (ν : ∀ α : Fin (c + 1), E_norm α ⟶ C)
    (F : Fin (c + 1) → Type u)
    [∀ α : Fin (c + 1), Field (F α)]
    [∀ α : Fin (c + 1), Algebra Ω (F α)]
    (η_F : ∀ α : Fin (c + 1), AlgebraicGeometry.Spec (CommRingCat.of (F α)) ⟶ E_norm α)
    (z_node : Fin δ → C)
    (α₀ : Fin δ → Fin (c + 1)) (P₀ : ∀ r : Fin δ, E_norm (α₀ r))
    (α₁ : Fin δ → Fin (c + 1)) (P₁ : ∀ r : Fin δ, E_norm (α₁ r))
    (hNormPkg : IsNodalCurveLogNormalizationPackage g n τ M c δ E_set E_norm p_norm ν F η_F
      z_node α₀ P₀ α₁ P₁)
    (ord : ∀ α : Fin (c + 1), E_norm α → F α → WithTop ℤ)
    (g_E : Fin (c + 1) → ℕ)
    (x_sep : ∀ α : Fin (c + 1), F α)
    (K_div : ∀ α : Fin (c + 1), E_norm α → ℤ)
    (hRR_data : ∀ α : Fin (c + 1),
      IsSmoothCurveRRData Ω (E_norm α) (p_norm α) (F α) (η_F α)
        (ord α) (g_E α) (x_sep α) (K_div α))
    (B_div B_self_div D_div : ∀ α : Fin (c + 1), E_norm α → ℤ)
    (hStabSys : IsNodalStabilityDivisorSystem g n τ c δ E_norm ν z_node α₀ α₁ g_E
      B_div B_self_div D_div) :
    (∀ c_coc : ∀ p : Fin M.m × Fin M.m, ↑(C.presheaf.obj (Opposite.op (M.V p.1 ⊓ M.V p.2))),
      (∀ a : Fin M.m, c_coc (a, a) = 0) →
      (∀ a b d : Fin M.m,
        let w₁ : M.V a ⊓ M.V b ⊓ M.V d ⟶ M.V a ⊓ M.V b := CategoryTheory.homOfLE inf_le_left
        let w₂ : M.V a ⊓ M.V b ⊓ M.V d ⟶ M.V b ⊓ M.V d :=
          CategoryTheory.homOfLE (inf_le_inf inf_le_right (le_refl _))
        let w₃ : M.V a ⊓ M.V b ⊓ M.V d ⟶ M.V a ⊓ M.V d :=
          CategoryTheory.homOfLE (inf_le_inf inf_le_left (le_refl _))
        (C.presheaf.map w₁.op).hom (c_coc (a, b)) +
          ((C.presheaf.map w₁.op).hom (M.u a b).val) ^ 3 *
            (C.presheaf.map w₂.op).hom (c_coc (b, d)) =
          (C.presheaf.map w₃.op).hom (c_coc (a, d))) →
      ∃ s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (M.V a))),
        ∀ a b : Fin M.m,
          c_coc (a, b) =
            (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : M.V a ⊓ M.V b ≤ M.V a)).op).hom (s a) -
              (M.u a b).val ^ 3 *
                (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : M.V a ⊓ M.V b ≤ M.V b)).op).hom (s b)) ∧
    ∃ (hAff : ∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a))
      (r₀ : ℕ) (_ : 3 ≤ r₀)
      (e : Fin (r₀ + 1) → ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))))
      (lam_triv : ∀ (α : Fin (c + 1)) (a : Fin M.m),
        Nonempty ↥((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)) → F α)
      (secFunc : (∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a)))) →
        ∀ α : Fin (c + 1), F α),
      (∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M ⊤ (e i)) ∧
      (∀ s : ∀ a : Fin M.m, ↑(C.presheaf.obj (Opposite.op (⊤ ⊓ M.V a))),
        IsWeilTricanonicalSection M ⊤ s →
        ∃! c_coef : Fin (r₀ + 1) → Ω,
          ∀ a : Fin M.m,
            s a = ∑ i : Fin (r₀ + 1),
              (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M.V a ≤ ⊤)).op).hom
                (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ g.appTop).hom (c_coef i)) *
                e i a) ∧
      HasNodalTricanonicalDivisorBridge Ω C g M hAff c δ E_norm ν F η_F z_node
        ord K_div B_div B_self_div D_div lam_triv secFunc :=
by
  classical
  obtain ⟨hAff, hAffW, hAffW_ov, pt_C, pt_E, hPtC, hPtE, hPinch, _, _, Ψ_log, hΨ_ov, hΨ_val⟩ :=
    hNormPkg.2.2.2.2.2
  have hProdInj := hNormPkg.2.2.2.2.1
  have hNodeInj := hNormPkg.2.2.2.1.1
  have hNodeData := hNormPkg.2.2.2.1.2.1
  
  have hEmptySub : ∀ (X : AlgebraicGeometry.Scheme.{u}) (U : X.Opens),
      ¬Nonempty ↥U → Subsingleton ↑(X.presheaf.obj (Opposite.op U)) := by
    intro X U hU
    have h_eq : (⨆ i : Empty, (Empty.elim i : X.Opens)) = U := by
      apply SetLike.coe_injective; ext x
      simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion, IsEmpty.exists_iff, false_iff]
      exact fun hx => hU ⟨x, hx⟩
    obtain ⟨s₀, _, hs₀_uniq⟩ :=
      X.sheaf.existsUnique_gluing (fun i : Empty => (Empty.elim i : X.Opens))
        (fun i : Empty => Empty.elim i) (fun i => i.elim)
    have h_sub : Subsingleton ↑(X.presheaf.obj (Opposite.op (⨆ i : Empty, (Empty.elim i : X.Opens)))) :=
      ⟨fun x y => (hs₀_uniq x (fun i => i.elim)).trans (hs₀_uniq y (fun i => i.elim)).symm⟩
    rwa [h_eq] at h_sub
  have hGenMem : ∀ (α : Fin (c + 1)) (U : (E_norm α).Opens),
      AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
      (η_F α).base (⊥ : PrimeSpectrum (F α)) ∈ U := by
    intro α U hU hNe
    obtain ⟨φ_U, _, hφU⟩ := (hNormPkg.2.1 α).2.2.2.2.2.2.2.2 U hU hNe
    have h_pt : hU.fromSpec.base ((AlgebraicGeometry.Spec.map φ_U).base (⊥ : PrimeSpectrum (F α))) =
        (η_F α).base (⊥ : PrimeSpectrum (F α)) := by
      rw [← hφU]; rfl
    have h_in : (η_F α).base (⊥ : PrimeSpectrum (F α)) ∈ Set.range hU.fromSpec.base :=
      ⟨_, h_pt⟩
    rwa [hU.range_fromSpec] at h_in
  have hPhiAlign : ∀ (α : Fin (c + 1)) (U V : (E_norm α).Opens)
