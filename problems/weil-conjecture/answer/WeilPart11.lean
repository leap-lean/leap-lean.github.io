  let lam_of : Module.Dual Ω (↥E₀_inf ⧸ S_0inf) → (↥E₀_inf →ₗ[Ω] Ω) :=
    fun ℓ => ℓ.comp S_0inf.mkQ
  have hlam_E0 : ∀ (ℓ : Module.Dual Ω (↥E₀_inf ⧸ S_0inf)) (v : F) (hv : v ∈ E₀_inf),
