          fun j => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
        let hFace : ∀ j : Fin (s + 2), W ⊓ weilChartInter L β ≤ W ⊓ weilChartInter L (face j) :=
          fun j => inf_le_inf_left W
            (Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k))))
        ((X.presheaf.map (CategoryTheory.homOfLE h01).op).hom (L.u (β.1 0) (β.1 1)).val) ^ 3 *
          (X.presheaf.map (CategoryTheory.homOfLE (hFace 0)).op).hom (c (face 0)) +
        ∑ k : Fin (s + 1),
          (-1) ^ ((k : ℕ) + 1) *
            (X.presheaf.map (CategoryTheory.homOfLE (hFace k.succ)).op).hom (c (face k.succ))
