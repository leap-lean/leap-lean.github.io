          Submodule.inclusion hex
        have _ : Module.Finite R ↥(LinearMap.range inc) :=
          Module.Finite.iff_fg.mpr (hNoethRangeF.noetherian (LinearMap.range inc))
        have _ : Module.Finite R ↥(LinearMap.ker h) :=
          Module.Finite.equiv (LinearEquiv.ofInjective inc (Submodule.inclusion_injective hex)).symm
        exact Module.Finite.of_submodule_quotient (LinearMap.ker h)
      refine ⟨?_, ?_⟩
      · intro hF₁ hF₃
        rw [hFinIff] at hF₁ hF₃ ⊢
        intro n
        exact hNoethExact (i_H n) (q_H n) (hex_i_q n) (hF₁ n) (hF₃ n)
      · intro hF₂ hF₃
        rw [hFinIff] at hF₂ hF₃ ⊢
        intro n
        cases n with
        | zero =>
          have _ := hF₂ 0
          have hNoeth₂ : IsNoetherian R (H_mod F₂ 0) :=
            isNoetherian_of_isNoetherianRing_of_finite R (H_mod F₂ 0)
          have _ : Module.Finite R ↥(LinearMap.range (i_H 0)) :=
            Module.Finite.iff_fg.mpr (hNoeth₂.noetherian (LinearMap.range (i_H 0)))
          exact Module.Finite.equiv (LinearEquiv.ofInjective (i_H 0) hi0_inj).symm
        | succ p =>
          exact hNoethExact (δ_H p) (i_H (p + 1)) (hex_δ_i p) (hF₃ p) (hF₂ (p + 1))
