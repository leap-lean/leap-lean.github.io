            hInterInsLe lam (faceOf α j) (faceOf γ m_j)
              (fun k => hImg_j ▸ Finset.mem_image_of_mem _ (Finset.mem_univ k))
          rw [hs_notMem (faceOf α j) hNotMem_j (faceOf γ m_j) hImg_j j_lam hj_lam_val hle_j,
