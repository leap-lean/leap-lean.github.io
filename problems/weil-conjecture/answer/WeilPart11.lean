    have hΘ_left : ∀ (p : ℕ) (d : WeilModuleCechCochain V H_C p), Θ_inv p (Θ p d) = d := by
      intro p d
      funext α
      dsimp only [Θ, Θ_inv]
      rw [H_Z.res_comp, H_Z.res_id, AddEquiv.symm_apply_apply]
    have hΘ_right : ∀ (p : ℕ) (c : WeilModuleCechCochain V_Z H_Z p), Θ p (Θ_inv p c) = c := by
      intro p c
      funext α
      dsimp only [Θ, Θ_inv]
      rw [AddEquiv.apply_symm_apply, H_Z.res_comp, H_Z.res_id]
    have hΘ_zero : ∀ p : ℕ, Θ p 0 = 0 := by
      intro p; funext α; dsimp only [Θ]; change H_Z.res _ (e _ 0) = 0; rw [map_zero, map_zero]
    have hΘ_add : ∀ (p : ℕ) (d₁ d₂ : WeilModuleCechCochain V H_C p),
