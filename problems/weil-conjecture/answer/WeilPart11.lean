      res_id := fun U x => Subtype.ext (O_Z.res_id U x.1)
      res_comp := fun h₁ h₂ x => Subtype.ext (O_Z.res_comp h₁ h₂ x.1) }
  let Im_η : WeilPresheafModule Z :=
    { sec := fun U => ↥(LinearMap.range (η_lin U))
