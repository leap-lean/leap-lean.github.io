            rfl
          refine LinearMap.ext fun y => ?_
          change Φ_fwd (α_inv (ψ_Z.symm y)) = y
          have hy := congrArg
            (fun f : TensorProduct B_U B_W (H_Z.sec U_Z) →ₗ[B_U] H_Z.sec W_Z => f (ψ_Z.symm y))
            hCompEq
          change Φ_fwd (α_inv (ψ_Z.symm y)) = ψ_Z (ψ_Z.symm y) at hy
          rw [hy, LinearEquiv.apply_symm_apply]
        exact ⟨LinearEquiv.ofLinearMap Φ_fwd Φ_inv hRightInv hLeftInv, hΦ_fwd_tmul⟩
    · 
      intro U hU _ hDisj x
      let U_Z := (TopologicalSpace.Opens.map ι_Z.base).obj U
      have hUZ : AlgebraicGeometry.IsAffineOpen U_Z :=
        AlgebraicGeometry.IsAffineHom.isAffine_preimage U hU
      exact hVanZ U_Z hUZ (hDisjLe U hDisj) x
    · 
      exact (hPushCechIff H_Z H_C (fun _ => AddEquiv.refl _)
        (fun _ _ _ => rfl) (fun _ _ => rfl)).mp
  exact ⟨hIntZ, hPropZ, hAffVZ, hCovVZ, hConj5, hConj6⟩

theorem weil_affineOpen_structureSheaf_cech_gluing_and_vanishing : (∀ (X : AlgebraicGeometry.Scheme.{u}) (r : ℕ) (U : Fin r → X.Opens)
      (F : WeilPresheafModule X) (p : ℕ) (c : WeilModuleCechCochain U F p),
      weilModuleCechDiff U F (p + 1) (weilModuleCechDiff U F p c) = 0) ∧
    (∀ (Y : AlgebraicGeometry.Scheme.{u}),
      Y.IsSeparated →
      ∀ (W : Y.Opens),
        AlgebraicGeometry.IsAffineOpen W →
        ∀ (r : ℕ) (U : Fin r → Y.Opens) (hU_le : ∀ a : Fin r, U a ≤ W),
          (∀ a : Fin r, AlgebraicGeometry.IsAffineOpen (U a)) →
          (⨆ a : Fin r, U a) = W →
          ∀ (O_Y : WeilPresheafModule Y),
            (∃ e_Y : ∀ V₀ : Y.Opens, O_Y.sec V₀ ≃+ ↑(Y.presheaf.obj (Opposite.op V₀)),
              ∀ {V₁ V₂ : Y.Opens} (h : V₂ ≤ V₁) (x : O_Y.sec V₁),
                e_Y V₂ (O_Y.res h x) =
                  (Y.presheaf.map (CategoryTheory.homOfLE h).op).hom (e_Y V₁ x)) →
            let res0 : O_Y.sec W → WeilModuleCechCochain U O_Y 0 :=
              fun s α =>
                O_Y.res (le_trans (Finset.inf'_le _ (Finset.mem_univ (0 : Fin 1))) (hU_le (α.1 0))) s
            (∀ s : O_Y.sec W, weilModuleCechDiff U O_Y 0 (res0 s) = 0) ∧
            Function.Injective res0 ∧
            (∀ z : WeilModuleCechCochain U O_Y 0,
              weilModuleCechDiff U O_Y 0 z = 0 → ∃ s : O_Y.sec W, res0 s = z) ∧
            (∀ (p : ℕ) (z : WeilModuleCechCochain U O_Y (p + 1)),
              weilModuleCechDiff U O_Y (p + 1) z = 0 →
              ∃ b : WeilModuleCechCochain U O_Y p, weilModuleCechDiff U O_Y p b = z)) :=
by
  have hSuccAbove : ∀ {n : ℕ} (i₀ j₀ : Fin (n + 1)) (k : Fin n),
      j₀ ≤ i₀ → i₀.succ.succAbove (j₀.succAbove k) = j₀.castSucc.succAbove (i₀.succAbove k) := by
    intro n i₀ j₀ k hij
    rcases lt_or_ge k.castSucc j₀ with hkj | hjk
    · have hki : k.castSucc < i₀ := lt_of_lt_of_le hkj hij
      rw [Fin.succAbove_of_castSucc_lt _ _ hkj, Fin.succAbove_of_castSucc_lt _ _ hki,
        Fin.succAbove_of_castSucc_lt _ _ (Fin.castSucc_lt_castSucc_iff.mpr hkj),
        Fin.succAbove_of_castSucc_lt _ _
          (lt_trans (Fin.castSucc_lt_castSucc_iff.mpr hki) i₀.castSucc_lt_succ)]
    · rcases lt_or_ge k.castSucc i₀ with hki | hik
      · rw [Fin.succAbove_of_le_castSucc _ _ hjk, Fin.succAbove_of_castSucc_lt _ _ hki,
          Fin.succAbove_of_le_castSucc _ _ (Fin.castSucc_le_castSucc_iff.mpr hjk),
          Fin.succAbove_of_castSucc_lt _ _ (Fin.succ_lt_succ_iff.mpr hki)]
        ext; simp
      · rw [Fin.succAbove_of_le_castSucc _ _ hjk, Fin.succAbove_of_le_castSucc _ _ hik,
          Fin.succAbove_of_le_castSucc _ _ (Fin.succ_le_succ_iff.mpr hik),
          Fin.succAbove_of_le_castSucc _ _
            (le_trans (Fin.castSucc_le_castSucc_iff.mpr hjk)
              (le_of_lt (Fin.castSucc_lt_castSucc_iff.mpr k.castSucc_lt_succ)))]
  refine ⟨?_, ?_⟩
  · 
    intro X r U F p c
    funext γ
    rw [Pi.zero_apply]
    let face₁ : Fin (p + 3) → WeilStrictMonoTuple r (p + 1) :=
      fun i => ⟨fun k => γ.1 (i.succAbove k), γ.2.comp (Fin.strictMono_succAbove i)⟩
    let hFace₁ : ∀ i : Fin (p + 3), weilCoverChartInter U γ ≤ weilCoverChartInter U (face₁ i) :=
      fun i => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (i.succAbove k)))
    let face₀ : ∀ β : WeilStrictMonoTuple r (p + 1), Fin (p + 2) → WeilStrictMonoTuple r p :=
      fun β j => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
    let hFace₀ : ∀ (β : WeilStrictMonoTuple r (p + 1)) (j : Fin (p + 2)),
        weilCoverChartInter U β ≤ weilCoverChartInter U (face₀ β j) :=
      fun _ j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
    let T : Fin (p + 3) × Fin (p + 2) → F.sec (weilCoverChartInter U γ) :=
      fun x => ((-1 : ℤ) ^ ((x.1 : ℕ) + (x.2 : ℕ))) •
        F.res (le_trans (hFace₁ x.1) (hFace₀ (face₁ x.1) x.2)) (c (face₀ (face₁ x.1) x.2))
    have hExpand : weilModuleCechDiff U F (p + 1) (weilModuleCechDiff U F p c) γ =
        ∑ x ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin (p + 3) × Fin (p + 2))), T x := by
      change ∑ i : Fin (p + 3), ((-1 : ℤ) ^ (i : ℕ)) •
          F.res (hFace₁ i)
            (∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
              F.res (hFace₀ (face₁ i) j) (c (face₀ (face₁ i) j))) = _
      trans (∑ i : Fin (p + 3), ∑ j : Fin (p + 2), T (i, j))
      · refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_sum, Finset.smul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_zsmul, F.res_comp, smul_smul, ← pow_add]
      · rw [← Finset.sum_product']
    have hResCongr : ∀ {α₁ α₂ : WeilStrictMonoTuple r p} (hα : α₁ = α₂)
        (h₁ : weilCoverChartInter U γ ≤ weilCoverChartInter U α₁)
        (h₂ : weilCoverChartInter U γ ≤ weilCoverChartInter U α₂),
        F.res h₁ (c α₁) = F.res h₂ (c α₂) := by
      rintro _ _ rfl _ _; rfl
    rw [hExpand, ← Finset.sum_filter_add_sum_filter_not _
      (fun x : Fin (p + 3) × Fin (p + 2) => (x.2 : ℕ) < (x.1 : ℕ))]
    have hBij : ∑ x ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin (p + 3) × Fin (p + 2))).filter
          (fun x => (x.2 : ℕ) < (x.1 : ℕ)), T x =
        ∑ y ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin (p + 3) × Fin (p + 2))).filter
          (fun y => ¬ (y.2 : ℕ) < (y.1 : ℕ)), - T y := by
      refine Finset.sum_bij
        (fun x hx => (x.2.castSucc, ⟨x.1.1 - 1, by
          simp only [Finset.mem_filter] at hx
          omega⟩))
        (fun x hx => by
          simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_univ, true_and,
            Fin.val_castSucc] at hx ⊢
          omega)
        (fun x₁ hx₁ x₂ hx₂ hEq => by
          simp only [Finset.mem_filter] at hx₁ hx₂
          ext <;> simp only [Prod.mk.injEq, Fin.ext_iff, Fin.val_castSucc] at hEq <;> omega)
        (fun y hy => by
          simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_univ, true_and] at hy
          refine ⟨(y.2.succ, ⟨y.1.1, by omega⟩), ?_, ?_⟩
          · simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_univ, true_and,
              Fin.val_succ]
            omega
          · ext <;> simp)
        (fun x hx => by
          simp only [Finset.mem_filter] at hx
          let i₀ : Fin (p + 2) := ⟨x.1.1 - 1, by omega⟩
          let j₀ : Fin (p + 2) := x.2
          have hij : j₀ ≤ i₀ := by
            simp only [Fin.le_iff_val_le_val, i₀, j₀]
            omega
          have hx1_eq : x.1 = i₀.succ := by
            ext; simp [i₀]; omega
          have hFaceEq : face₀ (face₁ x.1) x.2 = face₀ (face₁ j₀.castSucc) i₀ := by
            rw [hx1_eq]
            refine Subtype.ext (funext fun k => ?_)
            exact congrArg γ.1 (hSuccAbove i₀ j₀ k hij)
          dsimp only [T]
          rw [hResCongr hFaceEq _ _]
          have hexp : (x.1 : ℕ) + (x.2 : ℕ) = ((x.2.castSucc : ℕ) + (i₀ : ℕ)) + 1 := by
            simp only [Fin.val_castSucc, i₀]
            omega
          rw [hexp, pow_succ, mul_neg_one, neg_zsmul])
    rw [hBij, ← Finset.sum_add_distrib]
    exact Finset.sum_eq_zero fun _ _ => neg_add_cancel _
  · 
    intro Y hSep W hW r U hU_le hAffU hCov O_Y ⟨e_Y, he_Y⟩ res0
    classical
    have : Y.IsSeparated := hSep
    have hMapComp : ∀ {V₁ V₂ V₃ : Y.Opens} (h₁₂ : V₂ ≤ V₁) (h₂₃ : V₃ ≤ V₂) (h₁₃ : V₃ ≤ V₁)
        (x : ↑(Y.presheaf.obj (Opposite.op V₁))),
        (Y.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom
          ((Y.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom x) =
        (Y.presheaf.map (CategoryTheory.homOfLE h₁₃).op).hom x := by
      intro V₁ V₂ V₃ h₁₂ h₂₃ h₁₃ x
      have hHom : (CategoryTheory.homOfLE h₁₂).op ≫ (CategoryTheory.homOfLE h₂₃).op =
          (CategoryTheory.homOfLE h₁₃).op := by
        rw [← op_comp, CategoryTheory.homOfLE_comp]
      calc (Y.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom
             ((Y.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom x)
          = (Y.presheaf.map (CategoryTheory.homOfLE h₁₂).op ≫
               Y.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom x := rfl
        _ = (Y.presheaf.map (CategoryTheory.homOfLE h₁₃).op).hom x := by
             rw [← Y.presheaf.map_comp, hHom]
    have hMapId : ∀ (V₁ : Y.Opens) (h₁₁ : V₁ ≤ V₁) (x : ↑(Y.presheaf.obj (Opposite.op V₁))),
        (Y.presheaf.map (CategoryTheory.homOfLE h₁₁).op).hom x = x := by
      intro V₁ h₁₁ x
      have hHom : CategoryTheory.homOfLE h₁₁ = 𝟙 V₁ := Subsingleton.elim _ _
      rw [hHom, op_id, Y.presheaf.map_id]
      rfl
    have hMapNegOnePow : ∀ {V₁ V₂ : Y.Opens}
        (f_hom : Y.presheaf.obj (Opposite.op V₁) ⟶ Y.presheaf.obj (Opposite.op V₂))
        (n : ℕ), f_hom.hom ((-1) ^ n) = (-1) ^ n := by
      intro V₁ V₂ f_hom n
      rw [map_pow, map_neg, map_one]
    
    have hFin01 : ∀ k : Fin (0 + 1), k = 0 :=
      fun k => Fin.ext (Nat.lt_one_iff.mp k.2)
    have h0LeW : ∀ α : WeilStrictMonoTuple r 0, weilCoverChartInter U α ≤ W :=
      fun α => (Finset.inf'_le (fun k => U (α.1 k)) (Finset.mem_univ (0 : Fin (0 + 1)))).trans
        (hU_le (α.1 0))
