            fun U => AlgebraicGeometry.IsAffineOpen U ∧ ∃ a : Fin m, U ≤ V a
          ∀ (H : WeilPresheafModule C), IsWeilCoherentSubChartModule V H →
            ∀ (N_aff : ∀ (U : C.Opens), IsSubChartAff U →
                Submodule ↑(C.presheaf.obj (Opposite.op U)) (H.sec U)),
              (∀ {U W : C.Opens} (hU : IsSubChartAff U) (hW : IsSubChartAff W)
                (hWU : W ≤ U) (x : H.sec U),
                x ∈ N_aff U hU → H.res hWU x ∈ N_aff W hW) →
              (∀ {U W : C.Opens} (hU : IsSubChartAff U) (hW : IsSubChartAff W) (hWU : W ≤ U),
                N_aff W hW ≤ Submodule.span ↑(C.presheaf.obj (Opposite.op W))
                  (H.res hWU '' (N_aff U hU : Set (H.sec U)))) →
              ∃ (N : ∀ U : C.Opens, Submodule ↑(C.presheaf.obj (Opposite.op U)) (H.sec U))
                (H_sub H_quot : WeilPresheafModule C)
                (i : ∀ U : C.Opens,
                  H_sub.sec U →ₗ[↑(C.presheaf.obj (Opposite.op U))] H.sec U)
                (q : ∀ U : C.Opens,
                  H.sec U →ₗ[↑(C.presheaf.obj (Opposite.op U))] H_quot.sec U),
                (∀ (U : C.Opens) (hU : IsSubChartAff U), N U = N_aff U hU) ∧
                (∀ (U : C.Opens) (x : H.sec U),
                  x ∈ N U ↔ ∀ (W : C.Opens) (hW : IsSubChartAff W) (hWU : W ≤ U),
                    H.res hWU x ∈ N_aff W hW) ∧
                (∀ {U W : C.Opens} (hWU : W ≤ U) (x : H.sec U),
                  x ∈ N U → H.res hWU x ∈ N W) ∧
                IsWeilCoherentSubChartModule V H_sub ∧
                IsWeilCoherentSubChartModule V H_quot ∧
                (∀ {U W : C.Opens} (hWU : W ≤ U) (y : H_sub.sec U),
                  i W (H_sub.res hWU y) = H.res hWU (i U y)) ∧
                (∀ {U W : C.Opens} (hWU : W ≤ U) (x : H.sec U),
                  q W (H.res hWU x) = H_quot.res hWU (q U x)) ∧
                (∀ U : C.Opens, Function.Injective (i U)) ∧
                (∀ U : C.Opens, LinearMap.range (i U) = N U) ∧
                (∀ U : C.Opens, Function.Surjective (q U)) ∧
                (∀ U : C.Opens, LinearMap.ker (q U) = N U))
        (hProperSupp :
          let IsSubChartAff : C.Opens → Prop :=
            fun U => AlgebraicGeometry.IsAffineOpen U ∧ ∃ a : Fin m, U ≤ V a
          ∀ (S₀ : TopologicalSpace.Closeds ↥C) (Q : WeilPresheafModule C),
            IsWeilCoherentSubChartModule V Q →
            (∀ (U : C.Opens), IsSubChartAff U →
              ∀ a ∈ RingHom.ker
                (((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal S₀).subschemeι.app U).hom),
                ∀ y : Q.sec U, a • y = 0) →
            IsWeilSupportedOn V Q S₀ ∧
            (∀ (W₀ : C.Opens), IsSubChartAff W₀ →
              ((W₀ : Set ↥C) ∩ (S₀ : Set ↥C)).Nonempty →
              (∀ y : Q.sec W₀, y = 0) →
              ∃ S'₀ : TopologicalSpace.Closeds ↥C, S'₀ < S₀ ∧ IsWeilSupportedOn V Q S'₀))
        (hZero : ∀ (F : WeilPresheafModule C),
          (∀ (p : ℕ) (α : WeilStrictMonoTuple m p) (x : F.sec (weilCoverChartInter V α)), x = 0) →
          HasFiniteWeilModuleCechCohomology g V F)
        (hSES : ∀ (P : C.Opens → Prop)
           (_hPV : ∀ {p : ℕ} (α : WeilStrictMonoTuple m p), P (weilCoverChartInter V α))
           (F₁ F₂ F₃ : WeilPresheafModule C)
           (i : ∀ (U : C.Opens), P U → F₁.sec U →+ F₂.sec U)
           (q : ∀ (U : C.Opens), P U → F₂.sec U →+ F₃.sec U),
          (∀ (U : C.Opens) (hU : P U) (a : ↑(C.presheaf.obj (Opposite.op U))) (x : F₁.sec U),
            i U hU (a • x) = a • i U hU x) →
          (∀ (U : C.Opens) (hU : P U) (a : ↑(C.presheaf.obj (Opposite.op U))) (x : F₂.sec U),
            q U hU (a • x) = a • q U hU x) →
          (∀ {U W : C.Opens} (hU : P U) (hW : P W) (h : W ≤ U) (x : F₁.sec U),
            i W hW (F₁.res h x) = F₂.res h (i U hU x)) →
          (∀ {U W : C.Opens} (hU : P U) (hW : P W) (h : W ≤ U) (x : F₂.sec U),
            q W hW (F₂.res h x) = F₃.res h (q U hU x)) →
          (∀ (U : C.Opens) (hU : P U), Function.Injective (i U hU)) →
          (∀ (U : C.Opens) (hU : P U), Function.Surjective (q U hU)) →
          (∀ (U : C.Opens) (hU : P U) (x : F₂.sec U),
            q U hU x = 0 ↔ ∃ y : F₁.sec U, i U hU y = x) →
          (HasFiniteWeilModuleCechCohomology g V F₁ →
            HasFiniteWeilModuleCechCohomology g V F₃ →
            HasFiniteWeilModuleCechCohomology g V F₂) ∧
          (HasFiniteWeilModuleCechCohomology g V F₂ →
            HasFiniteWeilModuleCechCohomology g V F₃ →
            HasFiniteWeilModuleCechCohomology g V F₁))
        (hExistsUne :
          let IsSubChartAff : C.Opens → Prop :=
            fun U => AlgebraicGeometry.IsAffineOpen U ∧ ∃ a : Fin m, U ≤ V a
          ∃ U_ne : C.Opens, IsSubChartAff U_ne ∧ ((U_ne : Set ↥C) ∩ (S : Set ↥C)).Nonempty)
        (hInterActive :
          let IsSubChartAff : C.Opens → Prop :=
            fun U => AlgebraicGeometry.IsAffineOpen U ∧ ∃ a : Fin m, U ≤ V a
          let IsActive : C.Opens → Prop :=
            fun U => IsSubChartAff U ∧ ((U : Set ↥C) ∩ (S : Set ↥C)).Nonempty
          ∀ U₁ U₂ : C.Opens, IsActive U₁ → IsActive U₂ → IsActive (U₁ ⊓ U₂))
        (hDomainB :
          let IsSubChartAff : C.Opens → Prop :=
            fun U => AlgebraicGeometry.IsAffineOpen U ∧ ∃ a : Fin m, U ≤ V a
          let IsActive : C.Opens → Prop :=
            fun U => IsSubChartAff U ∧ ((U : Set ↥C) ∩ (S : Set ↥C)).Nonempty
          let I_S := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal S
          ∀ U : C.Opens, IsActive U →
            IsDomain ↑(I_S.subscheme.presheaf.obj
              (Opposite.op ((TopologicalSpace.Opens.map I_S.subschemeι.base).obj U))))
        (hBirat :
          let IsSubChartAff : C.Opens → Prop :=
            fun U => AlgebraicGeometry.IsAffineOpen U ∧ ∃ a : Fin m, U ≤ V a
          let IsActive : C.Opens → Prop :=
            fun U => IsSubChartAff U ∧ ((U : Set ↥C) ∩ (S : Set ↥C)).Nonempty
          let I_S := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal S
          let Z := I_S.subscheme
          let ι_Z := I_S.subschemeι
          ∀ {U W : C.Opens}, IsActive U → IsActive W → ∀ (hWU : W ≤ U),
            let rZ := (Z.presheaf.map (CategoryTheory.homOfLE
              (show (TopologicalSpace.Opens.map ι_Z.base).obj W ≤
                  (TopologicalSpace.Opens.map ι_Z.base).obj U from
                fun _ hz => hWU hz)).op).hom
            Function.Injective rZ ∧
            ∃ s : ↑(Z.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map ι_Z.base).obj U))),
              s ≠ 0 ∧ ∀ b_W : ↑(Z.presheaf.obj
                  (Opposite.op ((TopologicalSpace.Opens.map ι_Z.base).obj W))),
                ∃ (k : ℕ) (a₁ : ↑(Z.presheaf.obj
                    (Opposite.op ((TopologicalSpace.Opens.map ι_Z.base).obj U)))),
                  rZ (s ^ k) * b_W = rZ a₁)
        (F_Z : WeilPresheafModule C)
        (hFZ_struct : IsWeilClosedSubschemeStructureModule
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal S) F_Z)
        (hFZ_fin : HasFiniteWeilModuleCechCohomology g V F_Z)
        (F₀ : WeilPresheafModule C)
        (hCohF₀ : IsWeilCoherentSubChartModule V F₀)
        (hAnnF₀ : ∀ (U : C.Opens),
          ∀ a ∈ RingHom.ker
            (((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal S).subschemeι.app U).hom),
            ∀ x : F₀.sec U, a • x = 0)
        (hTF_F₀ :
          let IsSubChartAff : C.Opens → Prop :=
            fun U => AlgebraicGeometry.IsAffineOpen U ∧ ∃ a : Fin m, U ≤ V a
          ∀ (U : C.Opens), (IsSubChartAff U ∧ ((U : Set ↥C) ∩ (S : Set ↥C)).Nonempty) →
            ∀ (r : ↑(C.presheaf.obj (Opposite.op U))) (x : F₀.sec U),
              ((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal S).subschemeι.app U).hom r ≠ 0 →
              r • x = 0 → x = 0),
        HasFiniteWeilModuleCechCohomology g V F₀ := by
    clear hPart1 hPart2 hPart3 hProp hAffV hCovV hIrredStruct F hCohF hSuppF
    intro hAffInter hChartS _hNoethU hFlatRes hSubQuot hProperSupp hZero hSES
      hExistsUne hInterActive hDomainB hBirat F_Z hFZ_struct hFZ_fin F₀ hCohF₀ hAnnF₀ hTF_F₀
    let IsSubChartAff : C.Opens → Prop :=
      fun U => AlgebraicGeometry.IsAffineOpen U ∧ ∃ a : Fin m, U ≤ V a
    let IsActive : C.Opens → Prop :=
      fun U => IsSubChartAff U ∧ ((U : Set ↥C) ∩ (S : Set ↥C)).Nonempty
    let I_S := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal S
    let Z := I_S.subscheme
    let ι_Z := I_S.subschemeι
    have hResSmul : ∀ (F : WeilPresheafModule C) {U W : C.Opens} (h : W ≤ U)
        (a : ↑(C.presheaf.obj (Opposite.op U))) (x : F.sec U),
        F.res h (a • x) = ((C.presheaf.map (CategoryTheory.homOfLE h).op).hom a) • F.res h x :=
      fun F _ _ h a x => F.res_smul h a x
    have hRangeS : Set.range ι_Z.base = (S : Set ↥C) :=
      (I_S.range_subschemeι).trans
        (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal S)
    have hUZ_aff : ∀ U : C.Opens, AlgebraicGeometry.IsAffineOpen U →
        AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map ι_Z.base).obj U) :=
      fun U hU => (AlgebraicGeometry.isAffineHom_iff ι_Z).mp inferInstance U hU
    let U_Z_fn : C.Opens → Z.Opens := fun U => (TopologicalSpace.Opens.map ι_Z.base).obj U
    let rZ_fn : ∀ {U W : C.Opens}, W ≤ U →
        (↑(Z.presheaf.obj (Opposite.op (U_Z_fn U))) →+*
          ↑(Z.presheaf.obj (Opposite.op (U_Z_fn W)))) :=
      fun {_ _} hWU =>
        (Z.presheaf.map (CategoryTheory.homOfLE
          ((TopologicalSpace.Opens.map ι_Z.base).monotone hWU)).op).hom
    have hNatApp : ∀ {U W : C.Opens} (hWU : W ≤ U) (a : ↑(C.presheaf.obj (Opposite.op U))),
        (ι_Z.app W).hom ((C.presheaf.map (CategoryTheory.homOfLE hWU).op).hom a) =
          rZ_fn hWU ((ι_Z.app U).hom a) :=
      fun hWU a => congrArg (fun f => f.hom a) (ι_Z.naturality (CategoryTheory.homOfLE hWU).op)
    let liftA : ∀ (U : C.Opens), AlgebraicGeometry.IsAffineOpen U →
        ↑(Z.presheaf.obj (Opposite.op (U_Z_fn U))) → ↑(C.presheaf.obj (Opposite.op U)) :=
      fun U hU b => Classical.choose (I_S.subschemeι_app_surjective ⟨U, hU⟩ b)
    have hliftA : ∀ (U : C.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
        (b : ↑(Z.presheaf.obj (Opposite.op (U_Z_fn U)))),
        (ι_Z.app U).hom (liftA U hU b) = b :=
      fun U hU b => Classical.choose_spec (I_S.subschemeι_app_surjective ⟨U, hU⟩ b)
    have hLiftSmulEq : ∀ {U : C.Opens} (hU : AlgebraicGeometry.IsAffineOpen U)
        (b : ↑(Z.presheaf.obj (Opposite.op (U_Z_fn U))))
        (a : ↑(C.presheaf.obj (Opposite.op U))) (x : F₀.sec U),
        (ι_Z.app U).hom a = b → liftA U hU b • x = a • x := by
      intro U hU b a x hab
      have hker : liftA U hU b - a ∈ RingHom.ker (ι_Z.app U).hom := by
        rw [RingHom.mem_ker, map_sub, hliftA, hab, sub_self]
      have hdiff := hAnnF₀ U _ hker x
      rwa [sub_smul, sub_eq_zero] at hdiff
    have hResInjActive : ∀ {U W : C.Opens}, IsActive U → IsActive W → ∀ (hWU : W ≤ U),
        Function.Injective (F₀.res hWU) := by
      intro U W hActU hActW hWU
      have hZeroKer : ∀ x : F₀.sec U, F₀.res hWU x = 0 → x = 0 := by
        intro x hx0
        obtain ⟨y₀, hy₀W, hy₀S⟩ := hActW.2
        rw [← hRangeS] at hy₀S
        obtain ⟨z₀, rfl⟩ := hy₀S
        have hAffUZ : AlgebraicGeometry.IsAffineOpen (U_Z_fn U) := hUZ_aff U hActU.1.1
        obtain ⟨f, hf_le, hz₀_f⟩ :=
          hAffUZ.exists_basicOpen_le (⟨z₀, hy₀W⟩ : ↥(U_Z_fn W)) (hWU hy₀W)
        have hf_ne : f ≠ 0 := by
          intro hf0; rw [hf0, AlgebraicGeometry.Scheme.basicOpen_zero] at hz₀_f; exact hz₀_f
        let f_A := liftA U hActU.1.1 f
        have hf_A : (ι_Z.app U).hom f_A = f := hliftA U hActU.1.1 f
        let W'₀ := C.basicOpen f_A
        have hW'₀_le : W'₀ ≤ U := C.basicOpen_le f_A
        have hW'₀_aff : AlgebraicGeometry.IsAffineOpen W'₀ := hActU.1.1.basicOpen f_A
        have hW'₀_sub : IsSubChartAff W'₀ :=
          ⟨hW'₀_aff, let ⟨a, ha⟩ := hActU.1.2; ⟨a, le_trans hW'₀_le ha⟩⟩
        let W'' := W ⊓ W'₀
        have hW''_aff : AlgebraicGeometry.IsAffineOpen W'' := hAffInter W W'₀ hActW.1.1 hW'₀_aff
        have hPreW'₀ : U_Z_fn W'₀ = Z.basicOpen f := by
          change (TopologicalSpace.Opens.map ι_Z.base).obj (C.basicOpen f_A) = Z.basicOpen f
          rw [ι_Z.preimage_basicOpen f_A, hf_A]
        have hEqZ'' : U_Z_fn W'' = U_Z_fn W'₀ := by
          ext z
          change (z ∈ U_Z_fn W ∧ z ∈ U_Z_fn W'₀) ↔ z ∈ U_Z_fn W'₀
          refine ⟨And.right, fun hz => ⟨?_, hz⟩⟩
          rw [hPreW'₀] at hz
          exact hf_le hz
        have hResW''0 : F₀.res (inf_le_right : W'' ≤ W'₀) (F₀.res hW'₀_le x) = 0 := by
          rw [F₀.res_comp, ← F₀.res_comp hWU (inf_le_left : W'' ≤ W), hx0, map_zero]
        let A_W'₀ := ↑(C.presheaf.obj (Opposite.op W'₀))
        let A_W'' := ↑(C.presheaf.obj (Opposite.op W''))
        let r_0'' : A_W'₀ →+* A_W'' :=
          (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W'' ≤ W'₀)).op).hom
        letI : Algebra A_W'₀ A_W'' := RingHom.toAlgebra r_0''
        let invZ'' : ↑(Z.presheaf.obj (Opposite.op (U_Z_fn W''))) →+*
            ↑(Z.presheaf.obj (Opposite.op (U_Z_fn W'₀))) :=
          (Z.presheaf.map (CategoryTheory.homOfLE (le_of_eq hEqZ''.symm)).op).hom
        have hNat0'' : ∀ a₀ : A_W'₀,
            invZ'' ((ι_Z.app W'').hom (r_0'' a₀)) = (ι_Z.app W'₀).hom a₀ := by
          intro a₀
          rw [hNatApp (inf_le_right : W'' ≤ W'₀) a₀]
          have hSub0'' : U_Z_fn W'' ≤ U_Z_fn W'₀ := fun _ hz => hz.2
          have hHomId :
              CategoryTheory.homOfLE (le_of_eq hEqZ''.symm) ≫ CategoryTheory.homOfLE hSub0'' =
                𝟙 (U_Z_fn W'₀) := Subsingleton.elim _ _
          change (Z.presheaf.map (CategoryTheory.homOfLE hSub0'').op ≫
            Z.presheaf.map (CategoryTheory.homOfLE (le_of_eq hEqZ''.symm)).op).hom
            ((ι_Z.app W'₀).hom a₀) = _
          rw [← Z.presheaf.map_comp, ← op_comp, hHomId, op_id, Z.presheaf.map_id]
          rfl
        let ψ_bilin : A_W'' →ₗ[A_W'₀] (F₀.sec W'₀ →ₗ[A_W'₀] F₀.sec W'₀) :=
          { toFun := fun a'' =>
              { toFun := fun y => liftA W'₀ hW'₀_aff (invZ'' ((ι_Z.app W'').hom a'')) • y
                map_add' := fun y₁ y₂ => smul_add _ y₁ y₂
                map_smul' := fun a₀ y => smul_comm _ a₀ y }
            map_add' := fun a₁ a₂ => LinearMap.ext fun y => by
              dsimp only [LinearMap.add_apply, LinearMap.coe_mk, AddHom.coe_mk]
              rw [map_add, map_add,
                hLiftSmulEq hW'₀_aff _
                  (liftA W'₀ hW'₀_aff (invZ'' ((ι_Z.app W'').hom a₁)) +
                    liftA W'₀ hW'₀_aff (invZ'' ((ι_Z.app W'').hom a₂))) y
                  (by rw [map_add, hliftA, hliftA]),
                add_smul]
            map_smul' := fun a₀ a'' => LinearMap.ext fun y => by
              dsimp only [RingHom.id_apply]
              change liftA W'₀ hW'₀_aff (invZ'' ((ι_Z.app W'').hom (r_0'' a₀ * a''))) • y =
                a₀ • (liftA W'₀ hW'₀_aff (invZ'' ((ι_Z.app W'').hom a'')) • y)
              rw [map_mul, map_mul, hNat0'',
                hLiftSmulEq hW'₀_aff _
                  (a₀ * liftA W'₀ hW'₀_aff (invZ'' ((ι_Z.app W'').hom a''))) y
                  (by rw [map_mul, hliftA]),
                mul_smul] }
        let Ψ'' : TensorProduct A_W'₀ A_W'' (F₀.sec W'₀) →ₗ[A_W'₀] F₀.sec W'₀ :=
          TensorProduct.lift ψ_bilin
        obtain ⟨φ'', hφ''⟩ := hCohF₀.2 W'₀ W'' hW'₀_aff hW''_aff hW'₀_sub.2 inf_le_right
        have h1x' : TensorProduct.tmul A_W'₀ (1 : A_W'') (F₀.res hW'₀_le x) = 0 := by
          apply φ''.injective
          rw [map_zero, hφ'', hResW''0, smul_zero]
        have hxW'₀ : F₀.res hW'₀_le x = 0 := by
          calc F₀.res hW'₀_le x
              = (1 : A_W'₀) • F₀.res hW'₀_le x := (one_smul _ _).symm
            _ = liftA W'₀ hW'₀_aff 1 • F₀.res hW'₀_le x :=
                (hLiftSmulEq hW'₀_aff 1 1 _ (map_one _)).symm
            _ = Ψ'' (TensorProduct.tmul A_W'₀ (1 : A_W'') (F₀.res hW'₀_le x)) := by
                rw [TensorProduct.lift.tmul]
                dsimp only [ψ_bilin, LinearMap.coe_mk, AddHom.coe_mk]
                rw [map_one, map_one]
            _ = 0 := by rw [h1x', map_zero]
        let A_U := ↑(C.presheaf.obj (Opposite.op U))
        letI : Algebra A_U A_W'₀ :=
          RingHom.toAlgebra (C.presheaf.map (CategoryTheory.homOfLE hW'₀_le).op).hom
        haveI : IsLocalization.Away f_A A_W'₀ := hActU.1.1.isLocalization_basicOpen f_A
        obtain ⟨φ_0, hφ_0⟩ := hCohF₀.2 U W'₀ hActU.1.1 hW'₀_aff hActU.1.2 hW'₀_le
        have h1x : TensorProduct.tmul A_U (1 : A_W'₀) x = 0 := by
          apply φ_0.injective
          rw [map_zero, hφ_0, hxW'₀, smul_zero]
        haveI : IsLocalizedModule (Submonoid.powers f_A)
            (TensorProduct.mk A_U A_W'₀ (F₀.sec U) 1) :=
          IsLocalization.tensorProduct_isLocalizedModule (Submonoid.powers f_A) A_W'₀
        obtain ⟨⟨_, ⟨k, rfl⟩⟩, hfk⟩ :=
          (IsLocalizedModule.eq_zero_iff (Submonoid.powers f_A)
            (TensorProduct.mk A_U A_W'₀ (F₀.sec U) 1)).mp h1x
        haveI : IsDomain ↑(Z.presheaf.obj (Opposite.op (U_Z_fn U))) := hDomainB U hActU
        have hfk_ne : (ι_Z.app U).hom (f_A ^ k) ≠ 0 := by
          rw [map_pow, hf_A]; exact pow_ne_zero k hf_ne
        exact hTF_F₀ U hActU (f_A ^ k) x hfk_ne hfk
      intro x₁ x₂ hEq
      exact sub_eq_zero.mp (hZeroKer (x₁ - x₂) (by rw [map_sub, hEq, sub_self]))
    obtain ⟨e_Z, heZ_smul, heZ_res⟩ := hFZ_struct
    have hAnnFZ : ∀ (U : C.Opens), ∀ a ∈ RingHom.ker ((ι_Z.app U).hom),
        ∀ z : F_Z.sec U, a • z = 0 := by
      intro U a ha z
      apply (e_Z U).injective
      rw [map_zero, heZ_smul, show (ι_Z.app U).hom a = 0 from ha, zero_mul]
    have hCohFZ : IsWeilCoherentSubChartModule V F_Z := by
      refine ⟨?_, ?_⟩
      · intro U hU_aff _
        let A_U := ↑(C.presheaf.obj (Opposite.op U))
        let z₁ : F_Z.sec U := (e_Z U).symm 1
        let ψ₁ : (Fin 1 → A_U) →ₗ[A_U] F_Z.sec U :=
          Fintype.linearCombination A_U (fun _ => z₁)
        apply Module.Finite.of_surjective ψ₁
        intro z
        obtain ⟨a, ha⟩ := I_S.subschemeι_app_surjective ⟨U, hU_aff⟩ (e_Z U z)
        refine ⟨fun _ => a, ?_⟩
        apply (e_Z U).injective
        change e_Z U (∑ _ : Fin 1, a • z₁) = e_Z U z
