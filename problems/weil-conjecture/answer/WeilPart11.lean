  let push : WeilPresheafModule Z → WeilPresheafModule C := fun H_Z =>
    { sec := fun U => H_Z.sec ((TopologicalSpace.Opens.map ι_Z.base).obj U)
      instAddCommGroup := fun U => H_Z.instAddCommGroup _
      instModule := fun U =>
        Module.compHom (H_Z.sec ((TopologicalSpace.Opens.map ι_Z.base).obj U)) (ι_Z.app U).hom
      res := fun {U W} h => H_Z.res ((TopologicalSpace.Opens.map ι_Z.base).monotone h)
      res_smul := fun {U W} h a x => by
        let h' : (TopologicalSpace.Opens.map ι_Z.base).obj W ≤
            (TopologicalSpace.Opens.map ι_Z.base).obj U :=
          (TopologicalSpace.Opens.map ι_Z.base).monotone h
