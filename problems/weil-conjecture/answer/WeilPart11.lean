    have h2 := AlgebraicGeometry.Scheme.Hom.map_appLE π
      (inf_le_left : (TopologicalSpace.Opens.map π.base).obj W ⊓ weilCoverChartInter Z'_std β ≤ _)
      (CategoryTheory.homOfLE h).op
    exact congrArg (fun φ => φ.hom f) (h1.trans h2.symm)
  let η_lin : ∀ U : Z.Opens,
      O_Z.sec U →ₗ[↑(Z.presheaf.obj (Opposite.op U))] R0_vert.sec U :=
    fun U =>
      letI := instModE U 0
      (η_raw U).codRestrict (K0_sub U) (h_dv_η U)
  let K_1 : WeilPresheafModule Z :=
    { sec := fun U =>
        letI := instModE U 0
        ↥(LinearMap.ker (η_raw U))
      instAddCommGroup := fun _ => inferInstance
      instModule := fun _ => inferInstance
      res := fun {U W} h =>
        { toFun := fun x => ⟨O_Z.res h x.1, by
