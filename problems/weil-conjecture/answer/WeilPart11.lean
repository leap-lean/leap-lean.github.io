    let x := F X_k
    let U_ps : (AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op ⊤))).Opens :=
      PrimeSpectrum.basicOpen x
    let hEqOpen : (TopologicalSpace.Opens.map Y.toSpecΓ.base).obj U_ps = B :=
      AlgebraicGeometry.Scheme.toSpecΓ_preimage_basicOpen Y x
    let μ_x : B.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away x)) :=
      (Y.isoOfEq hEqOpen).inv ≫ (Y.toSpecΓ ∣_ U_ps) ≫
        (AlgebraicGeometry.basicOpenIsoSpecAway x).hom
