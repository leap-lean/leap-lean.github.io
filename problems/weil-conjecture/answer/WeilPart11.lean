      intro C_fam α
      simp only [d_Y, map_sum, Finset.mul_sum]
      rw [Finset.sum_comm]
    have hDiffWMul : ∀ (g : A) (c : C_Y p) (α : WeilStrictMonoTuple r (p + 1)),
