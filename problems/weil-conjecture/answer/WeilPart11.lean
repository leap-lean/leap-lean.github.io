      @Submodule ↑(Z.presheaf.obj (Opposite.op U)) (E_sec U 0) _ _ (instModE U 0) :=
    fun U =>
      letI := instModE U 0
      letI := instModE U 1
      LinearMap.ker (dv_lin U 0)
  let R0_vert : WeilPresheafModule Z :=
    { sec := fun U => ↥(K0_sub U)
      instAddCommGroup := fun U =>
        letI := instModE U 0
        inferInstance
      instModule := fun U =>
        letI := instModE U 0
        inferInstance
