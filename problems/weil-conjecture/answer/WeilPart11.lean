          AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away x)) :=
      fun Z x =>
        (Z.isoOfEq (Z.toSpecΓ_preimage_basicOpen x)).inv ≫
          (Z.toSpecΓ ∣_ PrimeSpectrum.basicOpen x) ≫
          (AlgebraicGeometry.basicOpenIsoSpecAway x).hom
    have hM_fac : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (x : ↑(Z.presheaf.obj (Opposite.op ⊤))),
