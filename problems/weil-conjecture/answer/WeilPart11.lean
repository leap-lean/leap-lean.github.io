      obtain ⟨W₁, hW₁, hPre₁⟩ := hInd.isOpen_iff.mp hU₁
      obtain ⟨W₂, hW₂, hPre₂⟩ := hInd.isOpen_iff.mp hU₂
      have hSW₁ : ((S : Set ↥C) ∩ W₁).Nonempty :=
        ⟨ι_Z.base z₁, hRange ▸ ⟨z₁, rfl⟩, by rw [← hPre₁] at hz₁; exact hz₁⟩
      have hSW₂ : ((S : Set ↥C) ∩ W₂).Nonempty :=
        ⟨ι_Z.base z₂, hRange ▸ ⟨z₂, rfl⟩, by rw [← hPre₂] at hz₂; exact hz₂⟩
      obtain ⟨y, hyS, hyW₁, hyW₂⟩ := hIrredS.isPreirreducible W₁ W₂ hW₁ hW₂ hSW₁ hSW₂
      rw [← hRange] at hyS
      obtain ⟨z, rfl⟩ := hyS
      exact ⟨z, trivial, ⟨by rw [← hPre₁]; exact hyW₁, by rw [← hPre₂]; exact hyW₂⟩⟩
