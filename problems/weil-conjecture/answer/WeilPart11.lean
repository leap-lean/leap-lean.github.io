        intro P hP_cl
        have h_le : -(Δ_div β P) ≤ -(D_Q P) := by have := hDQ_le_Delta P; omega
        exact le_trans (by rw [hCoeNeg, hCoeNeg]
                           exact WithTop.coe_le_coe.mpr h_le) (hf₀_in P hP_cl)
      have hf₀_not_Q : ¬(((-(Δ_div β Q) + 1 : ℤ) : WithTop ℤ) ≤ ord β Q f₀) := by
        intro h_ge
        apply hf₀_not
        intro P hP_cl
        by_cases hPQ : P = Q
        · subst hPQ
          have h_eq : -(D' P) = -(Δ_div β P) + 1 := by
            change -(Δ_div β P - B_div β P) = _; rw [hQ_B]; omega
          rw [hCoeNeg, h_eq]; exact h_ge
        · have h_eq : D_Q P = D' P := by change D' P + _ = _; rw [if_neg hPQ, add_zero]
          have h1 := hf₀_in P hP_cl
          rwa [h_eq] at h1
      let v₀ : Ω := ev_pt β Q hQ_cl a hQ_mem (chartLift β a f₀)
      have hv₀_ne : v₀ ≠ 0 := by
        intro hv0
        exact hf₀_not_Q ((hCL_vanish β a Q hQ_mem hQ_cl (hPtInE β Q hQ_cl _ hQ_mem) f₀
          (fun P _ hP => hf₀_Delta P hP)).mp hv0)
      let h : F β := algebraMap Ω (F β) v₀⁻¹ * f₀
      have hh_LQ : h ∈ LQ := by
        have h1 := LQ.smul_mem v₀⁻¹ hf₀_in
        rwa [Algebra.smul_def] at h1
      have hh_Delta : ∀ P : E_norm β, IsClosed ({P} : Set (E_norm β)) →
          (-(Δ_div β P) : WithTop ℤ) ≤ ord β P h := by
        have h1 := (mkDivSub β (Δ_div β)).smul_mem v₀⁻¹ hf₀_Delta
        rwa [Algebra.smul_def] at h1
      refine ⟨h, hh_Delta, ?_, ?_⟩
      · change ev_pt β Q hQ_cl a hQ_mem (chartLift β a (algebraMap Ω (F β) v₀⁻¹ * f₀)) = 1
        rw [hCL_smul β a v₀⁻¹ f₀ (fun P _ hP => hf₀_Delta P hP), map_mul,
          hEvalScalar (p_norm β) (pt_E β Q hQ_cl) (hPtE β Q hQ_cl).1 _ _ v₀⁻¹]
        exact inv_mul_cancel₀ hv₀_ne
      · intro Q' hQ'_cl hQ'_B hQ'_ne a' hQ'_mem
        apply (hCL_vanish β a' Q' hQ'_mem hQ'_cl (hPtInE β Q' hQ'_cl _ hQ'_mem) h
