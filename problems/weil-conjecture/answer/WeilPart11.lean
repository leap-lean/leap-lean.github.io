      exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f hU hV e
    have hInj_closed : ∀ x y : C,
        IsClosed ({x} : Set C) → IsClosed ({y} : Set C) → j₀.base x = j₀.base y → x = y := by
      intro x y hx hy hj_xy
      by_contra hne
      have hx_univ : x ∈ (Set.univ : Set C) := Set.mem_univ x
      rw [← M.hCov, Set.mem_iUnion] at hx_univ
      obtain ⟨a_x, hx_mem⟩ := hx_univ
      have hy_univ : y ∈ (Set.univ : Set C) := Set.mem_univ y
      rw [← M.hCov, Set.mem_iUnion] at hy_univ
      obtain ⟨a_y, hy_mem⟩ := hy_univ
      let p_x := (hAff a_x).primeIdealOf ⟨x, hx_mem⟩
      let p_y := (hAff a_y).primeIdealOf ⟨y, hy_mem⟩
      have hpx_eq : (hAff a_x).fromSpec.base p_x = x :=
        (hAff a_x).fromSpec_primeIdealOf ⟨x, hx_mem⟩
      have hpy_eq : (hAff a_y).fromSpec.base p_y = y :=
