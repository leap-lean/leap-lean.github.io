  let K : ℕ := Finset.univ.sup N_fam
  obtain ⟨h, hh⟩ := hf_pow K
  let b : WeilTricanonicalCechCochain L p := fun ν =>
    ∑ lam : Fin L.m,
      (X.presheaf.map (CategoryTheory.homOfLE (le_top : weilChartInter L ν ≤ ⊤)).op).hom
        (h lam * (f lam) ^ (K - N_fam lam)) * y_fam lam ν
  refine ⟨b, funext fun α => ?_⟩
  dsimp only [b]
  rw [hDiffSum]
  have hEach : ∀ lam : Fin L.m,
      weilTricanonicalCechDiff L p
        (fun ν => (X.presheaf.map (CategoryTheory.homOfLE (le_top : weilChartInter L ν ≤ ⊤)).op).hom
          (h lam * (f lam) ^ (K - N_fam lam)) * y_fam lam ν) α =
      (X.presheaf.map (CategoryTheory.homOfLE (le_top : weilChartInter L α ≤ ⊤)).op).hom
        (h lam * (f lam) ^ K) * z α := by
    intro lam
    rw [hDiffTopMul, hy_fam lam α, ← mul_assoc, ← map_mul, mul_assoc, ← pow_add,
      Nat.sub_add_cancel (Finset.le_sup (Finset.mem_univ lam))]
  calc ∑ lam : Fin L.m,
        weilTricanonicalCechDiff L p
          (fun ν => (X.presheaf.map (CategoryTheory.homOfLE (le_top : weilChartInter L ν ≤ ⊤)).op).hom
            (h lam * (f lam) ^ (K - N_fam lam)) * y_fam lam ν) α
      = ∑ lam : Fin L.m,
          (X.presheaf.map (CategoryTheory.homOfLE (le_top : weilChartInter L α ≤ ⊤)).op).hom
            (h lam * (f lam) ^ K) * z α :=
        Finset.sum_congr rfl fun lam _ => hEach lam
    _ = ((X.presheaf.map (CategoryTheory.homOfLE (le_top : weilChartInter L α ≤ ⊤)).op).hom
          (∑ lam : Fin L.m, h lam * (f lam) ^ K)) * z α := by
        rw [← Finset.sum_mul, map_sum]
    _ = z α := by
        rw [hh, map_one, one_mul]

theorem weil_twoChart_fiber_tricanonical_cech_vanishing (hAffVan : ∀ (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine Y]
      (N : WeilLineBundle Y),
      (∀ a : Fin N.m, AlgebraicGeometry.IsAffineOpen (N.V a)) →
      ∀ (p : ℕ) (z : WeilTricanonicalCechCochain N (p + 1)),
        weilTricanonicalCechDiff N (p + 1) z = 0 →
        ∃ b : WeilTricanonicalCechCochain N p, weilTricanonicalCechDiff N p b = z)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : AlgebraicGeometry.Scheme.{u})
    (f : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (hPropF : AlgebraicGeometry.IsProper f)
    (L : WeilLineBundle X)
    (hAffL : ∀ a : Fin L.m, AlgebraicGeometry.IsAffineOpen (L.V a))
    (hFibL : HasFiberTricanonicalProperties f L)
    (p : ℕ) (z : WeilTricanonicalCechCochain L (p + 1))
    (hz : weilTricanonicalCechDiff L (p + 1) z = 0) :
    ∃ b : WeilTricanonicalCechCochain L p, weilTricanonicalCechDiff L p b = z :=
by
  have hResComp : ∀ {U₁ U₂ U₃ : X.Opens} (h₁₂ : U₁ ≤ U₂) (h₂₃ : U₂ ≤ U₃)
      (x : ↑(X.presheaf.obj (Opposite.op U₃))),
      (X.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom
        ((X.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom x) =
      (X.presheaf.map (CategoryTheory.homOfLE (le_trans h₁₂ h₂₃)).op).hom x := by
    intro U₁ U₂ U₃ h₁₂ h₂₃ x
    change (X.presheaf.map (CategoryTheory.homOfLE h₂₃).op ≫
      X.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom x = _
    rw [← X.presheaf.map_comp]
    rfl
  have hResRefl : ∀ {U : X.Opens} (h : U ≤ U) (x : ↑(X.presheaf.obj (Opposite.op U))),
      (X.presheaf.map (CategoryTheory.homOfLE h).op).hom x = x := by
    intro U h x
    have hid : (CategoryTheory.homOfLE h).op = 𝟙 (Opposite.op U) := Subsingleton.elim _ _
    rw [hid, X.presheaf.map_id]
    rfl
  cases p with
  | zero =>
    have hEvalZ : ∀ {W : X.Opens} {α₁ α₂ : WeilStrictMonoTuple L.m 1} (hEq : α₁ = α₂)
        (h₁ : W ≤ weilChartInter L α₁) (h₂ : W ≤ weilChartInter L α₂),
        (X.presheaf.map (CategoryTheory.homOfLE h₁).op).hom (z α₁) =
        (X.presheaf.map (CategoryTheory.homOfLE h₂).op).hom (z α₂) := by
      intro W α₁ α₂ hEq h₁ h₂
      subst hEq; rfl
    let pairTuple : ∀ (a b : Fin L.m), a < b → WeilStrictMonoTuple L.m 1 :=
      fun a b hab =>
        ⟨fun k => if k = 0 then a else b, fun i j hij => by
          fin_cases i <;> fin_cases j <;> simp at hij ⊢
          exact hab⟩
    have hLePair : ∀ (a b : Fin L.m) (hab : a < b),
        L.V a ⊓ L.V b ≤ weilChartInter L (pairTuple a b hab) := by
      intro a b hab
      refine Finset.le_inf' _ _ fun k _ => ?_
      fin_cases k
      · exact inf_le_left
      · exact inf_le_right
    let c_coc : ∀ p : Fin L.m × Fin L.m, ↑(X.presheaf.obj (Opposite.op (L.V p.1 ⊓ L.V p.2))) :=
      fun p =>
        if hab : p.1 < p.2 then
          (X.presheaf.map (CategoryTheory.homOfLE (hLePair p.1 p.2 hab)).op).hom
            (z (pairTuple p.1 p.2 hab))
        else if hba : p.2 < p.1 then
          - (L.u p.1 p.2).val ^ 3 *
            (X.presheaf.map (CategoryTheory.homOfLE
              (le_trans (le_inf inf_le_right inf_le_left : L.V p.1 ⊓ L.V p.2 ≤ L.V p.2 ⊓ L.V p.1)
                (hLePair p.2 p.1 hba))).op).hom (z (pairTuple p.2 p.1 hba))
        else
          0
    have hc_aa : ∀ a : Fin L.m, c_coc (a, a) = 0 := by
      intro a
      dsimp [c_coc]
      rw [dif_neg (lt_irrefl a), dif_neg (lt_irrefl a)]
    let wOpen : ∀ (W : X.Opens) (a b : Fin L.m), W ≤ L.V a → W ≤ L.V b →
        ↑(X.presheaf.obj (Opposite.op W)) :=
      fun W a b ha hb =>
        ((X.presheaf.map (CategoryTheory.homOfLE (le_inf ha hb)).op).hom (L.u a b).val) ^ 3
    let cOpen : ∀ (W : X.Opens) (a b : Fin L.m), W ≤ L.V a → W ≤ L.V b →
        ↑(X.presheaf.obj (Opposite.op W)) :=
      fun W a b ha hb =>
        (X.presheaf.map (CategoryTheory.homOfLE (le_inf ha hb)).op).hom (c_coc (a, b))
    have hw_refl : ∀ (W : X.Opens) (a : Fin L.m) (ha : W ≤ L.V a),
        wOpen W a a ha ha = 1 := by
      intro W a ha
      dsimp [wOpen]
      rw [L.u_refl a, map_one, one_pow]
    have hw_cocycle : ∀ (W : X.Opens) (a b d : Fin L.m)
        (ha : W ≤ L.V a) (hb : W ≤ L.V b) (hd : W ≤ L.V d),
        wOpen W a b ha hb * wOpen W b d hb hd = wOpen W a d ha hd := by
      intro W a b d ha hb hd
      have hc := congrArg
        ((X.presheaf.map (CategoryTheory.homOfLE (le_inf (le_inf ha hb) hd)).op).hom)
        (L.u_cocycle a b d)
      rw [map_mul, hResComp, hResComp, hResComp] at hc
      dsimp [wOpen]
      rw [← mul_pow, hc]
    have hw_inv : ∀ (W : X.Opens) (a b : Fin L.m) (ha : W ≤ L.V a) (hb : W ≤ L.V b),
        wOpen W a b ha hb * wOpen W b a hb ha = 1 :=
      fun W a b ha hb => (hw_cocycle W a b a ha hb ha).trans (hw_refl W a ha)
    have hc_diag : ∀ (W : X.Opens) (a : Fin L.m) (ha : W ≤ L.V a),
        cOpen W a a ha ha = 0 := by
      intro W a ha
      dsimp [cOpen]
      rw [hc_aa a, map_zero]
    have hc_pos : ∀ (W : X.Opens) (a b : Fin L.m) (ha : W ≤ L.V a) (hb : W ≤ L.V b)
        (hab : a < b) (hWp : W ≤ weilChartInter L (pairTuple a b hab)),
        cOpen W a b ha hb =
          (X.presheaf.map (CategoryTheory.homOfLE hWp).op).hom (z (pairTuple a b hab)) := by
      intro W a b ha hb hab hWp
      dsimp [cOpen, c_coc]
      rw [dif_pos hab, hResComp]
    have hc_neg : ∀ (W : X.Opens) (a b : Fin L.m) (ha : W ≤ L.V a) (hb : W ≤ L.V b)
        (hba : b < a),
        cOpen W a b ha hb = - wOpen W a b ha hb * cOpen W b a hb ha := by
      intro W a b ha hb hba
      have hnot : ¬ a < b := asymm hba
      dsimp [cOpen, c_coc]
      rw [dif_neg hnot, dif_pos hba, dif_pos hba, map_mul, map_neg, map_pow, hResComp, hResComp]
    have hc_skew : ∀ (W : X.Opens) (a b : Fin L.m) (ha : W ≤ L.V a) (hb : W ≤ L.V b),
        wOpen W a b ha hb * cOpen W b a hb ha = - cOpen W a b ha hb := by
      intro W a b ha hb
      rcases lt_trichotomy a b with hab | rfl | hba
      · rw [hc_neg W b a hb ha hab]
        calc wOpen W a b ha hb * (- wOpen W b a hb ha * cOpen W a b ha hb)
            = - (wOpen W a b ha hb * wOpen W b a hb ha) * cOpen W a b ha hb := by ring
          _ = - 1 * cOpen W a b ha hb := by rw [hw_inv W a b ha hb]
          _ = - cOpen W a b ha hb := by ring
      · rw [hc_diag W a ha, mul_zero, neg_zero]
      · rw [hc_neg W a b ha hb hba]
        ring
    have hStrict : ∀ (W : X.Opens) (a b d : Fin L.m)
        (ha : W ≤ L.V a) (hb : W ≤ L.V b) (hd : W ≤ L.V d),
        a < b → b < d →
        cOpen W a b ha hb + wOpen W a b ha hb * cOpen W b d hb hd = cOpen W a d ha hd := by
      intro W a b d ha hb hd hab hbd
      have had : a < d := lt_trans hab hbd
      let γ : WeilStrictMonoTuple L.m 2 :=
        ⟨fun k => if k = 0 then a else if k = 1 then b else d, fun i j hij => by
          fin_cases i <;> fin_cases j <;> simp at hij ⊢
          · exact hab
          · exact had
          · exact hbd⟩
      have hWγ : W ≤ weilChartInter L γ := by
        refine Finset.le_inf' _ _ fun k _ => ?_
        fin_cases k
        · exact ha
        · exact hb
        · exact hd
      let face : Fin 3 → WeilStrictMonoTuple L.m 1 :=
        fun j => ⟨fun k => γ.1 (j.succAbove k), γ.2.comp (Fin.strictMono_succAbove j)⟩
      have hFace : ∀ j : Fin 3, weilChartInter L γ ≤ weilChartInter L (face j) :=
        fun j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
      have hf0 : face 0 = pairTuple b d hbd := by ext k; fin_cases k <;> rfl
      have hf1 : face 1 = pairTuple a d had := by ext k; fin_cases k <;> rfl
      have hf2 : face 2 = pairTuple a b hab := by ext k; fin_cases k <;> rfl
      have hzγ := congrArg ((X.presheaf.map (CategoryTheory.homOfLE hWγ).op).hom) (congrFun hz γ)
      dsimp only [weilTricanonicalCechDiff, Pi.zero_apply] at hzγ
      rw [Fin.sum_univ_two] at hzγ
      simp only [map_zero, map_add, map_mul, map_pow, map_neg, map_one, hResComp] at hzγ
      have h0 : (X.presheaf.map (CategoryTheory.homOfLE (le_trans hWγ (hFace 0))).op).hom
          (z (face 0)) = cOpen W b d hb hd :=
        (hEvalZ hf0 _ (le_trans (le_inf hb hd) (hLePair b d hbd))).trans
          (hc_pos W b d hb hd hbd _).symm
      have h1 : (X.presheaf.map (CategoryTheory.homOfLE (le_trans hWγ (hFace 1))).op).hom
          (z (face 1)) = cOpen W a d ha hd :=
        (hEvalZ hf1 _ (le_trans (le_inf ha hd) (hLePair a d had))).trans
          (hc_pos W a d ha hd had _).symm
      have h2 : (X.presheaf.map (CategoryTheory.homOfLE (le_trans hWγ (hFace 2))).op).hom
          (z (face 2)) = cOpen W a b ha hb :=
        (hEvalZ hf2 _ (le_trans (le_inf ha hb) (hLePair a b hab))).trans
          (hc_pos W a b ha hb hab _).symm
      have hw01 : ((X.presheaf.map (CategoryTheory.homOfLE
          (le_trans hWγ (le_inf (Finset.inf'_le _ (Finset.mem_univ (0 : Fin 3)))
            (Finset.inf'_le _ (Finset.mem_univ (1 : Fin 3)))))).op).hom
          (L.u (γ.1 0) (γ.1 1)).val) ^ 3 = wOpen W a b ha hb := rfl
      change _ ^ 3 * (X.presheaf.map (CategoryTheory.homOfLE (le_trans hWγ (hFace 0))).op).hom
          (z (face 0)) +
        ((-1) ^ ((0 : ℕ) + 1) *
          (X.presheaf.map (CategoryTheory.homOfLE (le_trans hWγ (hFace 1))).op).hom (z (face 1)) +
         (-1) ^ ((1 : ℕ) + 1) *
          (X.presheaf.map (CategoryTheory.homOfLE (le_trans hWγ (hFace 2))).op).hom (z (face 2))) = 0
        at hzγ
      rw [hw01, h0, h1, h2] at hzγ
      linear_combination hzγ
    have hSwapBD : ∀ (W : X.Opens) (a b d : Fin L.m)
        (ha : W ≤ L.V a) (hb : W ≤ L.V b) (hd : W ≤ L.V d),
        cOpen W a d ha hd + wOpen W a d ha hd * cOpen W d b hd hb = cOpen W a b ha hb →
        cOpen W a b ha hb + wOpen W a b ha hb * cOpen W b d hb hd = cOpen W a d ha hd := by
      intro W a b d ha hb hd h
      rw [← hw_cocycle W a b d ha hb hd, mul_assoc, hc_skew W b d hb hd] at h
      linear_combination -h
    have hSwapAB : ∀ (W : X.Opens) (a b d : Fin L.m)
        (ha : W ≤ L.V a) (hb : W ≤ L.V b) (hd : W ≤ L.V d),
        cOpen W b a hb ha + wOpen W b a hb ha * cOpen W a d ha hd = cOpen W b d hb hd →
        cOpen W a b ha hb + wOpen W a b ha hb * cOpen W b d hb hd = cOpen W a d ha hd := by
      intro W a b d ha hb hd h
      have hm := congrArg (fun x => wOpen W a b ha hb * x) h
      rw [mul_add, hc_skew W a b ha hb, ← mul_assoc, hw_inv W a b ha hb, one_mul] at hm
      linear_combination -hm
    have hc_coc : ∀ a b d : Fin L.m,
        let w₁ : L.V a ⊓ L.V b ⊓ L.V d ⟶ L.V a ⊓ L.V b := CategoryTheory.homOfLE inf_le_left
        let w₂ : L.V a ⊓ L.V b ⊓ L.V d ⟶ L.V b ⊓ L.V d :=
          CategoryTheory.homOfLE (inf_le_inf inf_le_right (le_refl _))
        let w₃ : L.V a ⊓ L.V b ⊓ L.V d ⟶ L.V a ⊓ L.V d :=
          CategoryTheory.homOfLE (inf_le_inf inf_le_left (le_refl _))
        (X.presheaf.map w₁.op).hom (c_coc (a, b)) +
          ((X.presheaf.map w₁.op).hom (L.u a b).val) ^ 3 *
            (X.presheaf.map w₂.op).hom (c_coc (b, d)) =
          (X.presheaf.map w₃.op).hom (c_coc (a, d)) := by
      intro a b d
      let W : X.Opens := L.V a ⊓ L.V b ⊓ L.V d
      have ha : W ≤ L.V a := le_trans inf_le_left inf_le_left
      have hb : W ≤ L.V b := le_trans inf_le_left inf_le_right
      have hd : W ≤ L.V d := inf_le_right
      change cOpen W a b ha hb + wOpen W a b ha hb * cOpen W b d hb hd = cOpen W a d ha hd
      rcases lt_trichotomy a b with hab | rfl | hba
      · rcases lt_trichotomy b d with hbd | rfl | hdb
        · exact hStrict W a b d ha hb hd hab hbd
        · rw [hc_diag W b hb, mul_zero, add_zero]
        · rcases lt_trichotomy a d with had | rfl | hda
          · exact hSwapBD W a b d ha hb hd (hStrict W a d b ha hd hb had hdb)
          · rw [hc_skew W a b ha hb, hc_diag W a ha, add_neg_cancel]
          · exact hSwapBD W a b d ha hb hd (hSwapAB W a d b ha hd hb (hStrict W d a b hd ha hb hda hab))
      · rw [hc_diag W a ha, hw_refl W a ha, one_mul, zero_add]
      · rcases lt_trichotomy b d with hbd | rfl | hdb
        · rcases lt_trichotomy a d with had | rfl | hda
          · exact hSwapAB W a b d ha hb hd (hStrict W b a d hb ha hd hba had)
          · rw [hc_skew W a b ha hb, hc_diag W a ha, add_neg_cancel]
          · exact hSwapAB W a b d ha hb hd (hSwapBD W b a d hb ha hd (hStrict W b d a hb hd ha hbd hda))
        · rw [hc_diag W b hb, mul_zero, add_zero]
        · exact hSwapBD W a b d ha hb hd
            (hSwapAB W a d b ha hd hb (hSwapBD W d a b hd ha hb (hStrict W d b a hd hb ha hdb hba)))
    obtain ⟨s, hs⟩ := hFibL.2.1 c_coc hc_aa hc_coc
    let b : WeilTricanonicalCechCochain L 0 := fun α =>
      - (X.presheaf.map (CategoryTheory.homOfLE
        (Finset.inf'_le (fun k => L.V (α.1 k)) (Finset.mem_univ (0 : Fin 1)))).op).hom (s (α.1 0))
    refine ⟨b, ?_⟩
    funext β
    have had : β.1 0 < β.1 1 := β.2 (by decide : (0 : Fin 2) < 1)
    have hβ_eq : pairTuple (β.1 0) (β.1 1) had = β := by
      ext k; fin_cases k <;> rfl
    have hβ0 : weilChartInter L β ≤ L.V (β.1 0) :=
      Finset.inf'_le (fun k => L.V (β.1 k)) (Finset.mem_univ (0 : Fin 2))
    have hβ1 : weilChartInter L β ≤ L.V (β.1 1) :=
      Finset.inf'_le (fun k => L.V (β.1 k)) (Finset.mem_univ (1 : Fin 2))
    have hβ_le : weilChartInter L β ≤ L.V (β.1 0) ⊓ L.V (β.1 1) := le_inf hβ0 hβ1
    have hs_ad := congrArg ((X.presheaf.map (CategoryTheory.homOfLE hβ_le).op).hom)
      (hs (β.1 0) (β.1 1))
    dsimp [c_coc] at hs_ad
    rw [dif_pos had, map_sub, map_mul, map_pow, hResComp, hResComp, hResComp] at hs_ad
    have hEvalβ : (X.presheaf.map (CategoryTheory.homOfLE
        (le_trans hβ_le (hLePair (β.1 0) (β.1 1) had))).op).hom
        (z (pairTuple (β.1 0) (β.1 1) had)) = z β :=
      (hEvalZ hβ_eq _ (le_refl _)).trans (hResRefl (le_refl _) (z β))
    rw [hEvalβ] at hs_ad
    let faceβ : Fin 2 → WeilStrictMonoTuple L.m 0 :=
      fun j => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
    let hFaceβ : ∀ j : Fin 2, weilChartInter L β ≤ weilChartInter L (faceβ j) :=
      fun j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
    have hb0 : (X.presheaf.map (CategoryTheory.homOfLE (hFaceβ 0)).op).hom (b (faceβ 0)) =
        - (X.presheaf.map (CategoryTheory.homOfLE hβ1).op).hom (s (β.1 1)) :=
      (map_neg ((X.presheaf.map (CategoryTheory.homOfLE (hFaceβ 0)).op).hom) _).trans
        (congrArg Neg.neg (hResComp _ _ _))
    have hb1 : (X.presheaf.map (CategoryTheory.homOfLE (hFaceβ 1)).op).hom (b (faceβ 1)) =
        - (X.presheaf.map (CategoryTheory.homOfLE hβ0).op).hom (s (β.1 0)) :=
      (map_neg ((X.presheaf.map (CategoryTheory.homOfLE (hFaceβ 1)).op).hom) _).trans
        (congrArg Neg.neg (hResComp _ _ _))
    change ((X.presheaf.map (CategoryTheory.homOfLE hβ_le).op).hom (L.u (β.1 0) (β.1 1)).val) ^ 3 *
        (X.presheaf.map (CategoryTheory.homOfLE (hFaceβ 0)).op).hom (b (faceβ 0)) +
      ∑ k : Fin 1, (-1) ^ ((k : ℕ) + 1) *
        (X.presheaf.map (CategoryTheory.homOfLE (hFaceβ k.succ)).op).hom (b (faceβ k.succ)) = z β
    rw [Fin.sum_univ_one]
    have hDiffEq :
        ((X.presheaf.map (CategoryTheory.homOfLE hβ_le).op).hom (L.u (β.1 0) (β.1 1)).val) ^ 3 *
          (X.presheaf.map (CategoryTheory.homOfLE (hFaceβ 0)).op).hom (b (faceβ 0)) +
        (-1) ^ ((0 : ℕ) + 1) *
          (X.presheaf.map (CategoryTheory.homOfLE (hFaceβ 1)).op).hom (b (faceβ 1)) =
        ((X.presheaf.map (CategoryTheory.homOfLE hβ_le).op).hom (L.u (β.1 0) (β.1 1)).val) ^ 3 *
          (- (X.presheaf.map (CategoryTheory.homOfLE hβ1).op).hom (s (β.1 1))) +
        (-1) ^ ((0 : ℕ) + 1) *
          (- (X.presheaf.map (CategoryTheory.homOfLE hβ0).op).hom (s (β.1 0))) :=
      congrArg₂ (· + ·) (congrArg (_ * ·) hb0) (congrArg (_ * ·) hb1)
    change ((X.presheaf.map (CategoryTheory.homOfLE hβ_le).op).hom (L.u (β.1 0) (β.1 1)).val) ^ 3 *
        (X.presheaf.map (CategoryTheory.homOfLE (hFaceβ 0)).op).hom (b (faceβ 0)) +
      (-1) ^ ((0 : ℕ) + 1) *
        (X.presheaf.map (CategoryTheory.homOfLE (hFaceβ 1)).op).hom (b (faceβ 1)) = z β
    linear_combination hDiffEq - hs_ad
  | succ q =>
    have hSepX : X.IsSeparated := by
      rw [AlgebraicGeometry.Scheme.isSeparated_iff]
      have : AlgebraicGeometry.IsProper f := hPropF
      have hTerm : CategoryTheory.Limits.terminal.from X =
          f ≫ CategoryTheory.Limits.terminal.from (AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
        CategoryTheory.Limits.terminal.hom_ext _ _
      rw [hTerm]
