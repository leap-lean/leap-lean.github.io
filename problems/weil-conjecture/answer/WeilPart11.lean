      intro U k₀ i j hUi hUj
      let x₂ : A := X_var i * X_var j
      have hx₂ : x₂ ∈ 𝒜₀ 2 := SetLike.mul_mem_graded (hj i) (hj j)
      have h1_mem : (1 : A) ∈ 𝒜₀ 0 := SetLike.one_mem_graded 𝒜₀
      have hUx₂ : U ≤ AlgebraicGeometry.Proj.basicOpen 𝒜₀ x₂ :=
        le_trans (le_inf hUi hUj)
          (le_of_eq (AlgebraicGeometry.Proj.basicOpen_mul 𝒜₀ (X_var i) (X_var j)).symm)
      have hle_i : AlgebraicGeometry.Proj.basicOpen 𝒜₀ x₂ ≤ W₀ i := by
        show AlgebraicGeometry.Proj.basicOpen 𝒜₀ (X_var i * X_var j) ≤ _
        rw [AlgebraicGeometry.Proj.basicOpen_mul]
        exact inf_le_left
      have hle_j : AlgebraicGeometry.Proj.basicOpen 𝒜₀ x₂ ≤ W₀ j := by
        show AlgebraicGeometry.Proj.basicOpen 𝒜₀ (X_var i * X_var j) ≤ _
        rw [AlgebraicGeometry.Proj.basicOpen_mul]
        exact inf_le_right
