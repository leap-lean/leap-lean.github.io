        rcases Finset.mem_image.mp hInγ with ⟨i_star, _, hi_star⟩
        let W_α : Y.Opens := U lam ⊓ weilCoverChartInter U α
        have hW_γ : W_α ≤ weilCoverChartInter U γ :=
