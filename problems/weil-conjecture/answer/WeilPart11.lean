        rw [← LinearMap.ker_eq_bot, eq_bot_iff]
        intro u₁ hu₁
        obtain ⟨z₁, rfl⟩ := Submodule.Quotient.mk_surjective (B_sub F₁ 0) u₁
        change Submodule.Quotient.mk (i_ker 0 z₁) = 0 at hu₁
        rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_bot] at hu₁
        have hz₁_val : i_c 0 z₁.1 = i_c 0 0 := by
          rw [map_zero]
          exact congrArg Subtype.val hu₁
        have hz₁ : z₁ = 0 := Subtype.ext (hi_c_inj 0 hz₁_val)
        rw [hz₁]
        exact Submodule.zero_mem _
