      (e₂ : Fin (n₂ + 1) → ∀ a : Idx, S_a a),
      (∀ i : Fin (n₁ + 1), P (e₁ i)) →
      (∀ s, P s → ∃! c : Fin (n₁ + 1) → Ω, ∀ a, s a = ∑ i, ι a (c i) * e₁ i a) →
      (∀ j : Fin (n₂ + 1), P (e₂ j)) →
      (∀ s, P s → ∃! c : Fin (n₂ + 1) → Ω, ∀ a, s a = ∑ j, ι a (c j) * e₂ j a) →
      n₂ = n₁ := by
    intro Ω _ Idx S_a _ P ι n₁ n₂ e₁ e₂ he₁_P he₁_bas he₂_P he₂_bas
    classical
    choose colA hcolA using fun j : Fin (n₂ + 1) => (he₁_bas (e₂ j) (he₂_P j)).exists
    choose colB hcolB using fun i : Fin (n₁ + 1) => (he₂_bas (e₁ i) (he₁_P i)).exists
    have hBA : ∀ i' i : Fin (n₁ + 1),
        (∑ j : Fin (n₂ + 1), colB i' j * colA j i) = if i = i' then 1 else 0 := by
      intro i' i
      have h1 : ∀ a : Idx,
          e₁ i' a = ∑ k : Fin (n₁ + 1),
            ι a (∑ j : Fin (n₂ + 1), colB i' j * colA j k) * e₁ k a := by
        intro a
        calc e₁ i' a
            = ∑ j : Fin (n₂ + 1), ι a (colB i' j) * e₂ j a := hcolB i' a
          _ = ∑ j : Fin (n₂ + 1), ι a (colB i' j) *
                (∑ k : Fin (n₁ + 1), ι a (colA j k) * e₁ k a) := by
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [hcolA j a]
          _ = ∑ j : Fin (n₂ + 1), ∑ k : Fin (n₁ + 1),
                (ι a (colB i' j) * ι a (colA j k)) * e₁ k a := by
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl fun k _ => by ring
          _ = ∑ k : Fin (n₁ + 1), ∑ j : Fin (n₂ + 1),
                ι a (colB i' j * colA j k) * e₁ k a := by
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun j _ => ?_
              rw [map_mul]
          _ = ∑ k : Fin (n₁ + 1),
                ι a (∑ j : Fin (n₂ + 1), colB i' j * colA j k) * e₁ k a := by
              refine Finset.sum_congr rfl fun k _ => ?_
              rw [map_sum, Finset.sum_mul]
      have h2 : ∀ a : Idx,
          e₁ i' a = ∑ k : Fin (n₁ + 1),
            ι a (if k = i' then (1 : Ω) else 0) * e₁ k a := by
        intro a
        symm
        calc (∑ k : Fin (n₁ + 1), ι a (if k = i' then (1 : Ω) else 0) * e₁ k a)
            = ∑ k : Fin (n₁ + 1), if k = i' then e₁ k a else 0 := by
              refine Finset.sum_congr rfl fun k _ => ?_
              split_ifs <;> simp
          _ = e₁ i' a := by simp
      exact congrFun ((he₁_bas (e₁ i') (he₁_P i')).unique h1 h2) i
    have hAB : ∀ j' j : Fin (n₂ + 1),
        (∑ i : Fin (n₁ + 1), colA j' i * colB i j) = if j = j' then 1 else 0 := by
      intro j' j
      have h1 : ∀ a : Idx,
          e₂ j' a = ∑ k : Fin (n₂ + 1),
            ι a (∑ i : Fin (n₁ + 1), colA j' i * colB i k) * e₂ k a := by
        intro a
        calc e₂ j' a
            = ∑ i : Fin (n₁ + 1), ι a (colA j' i) * e₁ i a := hcolA j' a
          _ = ∑ i : Fin (n₁ + 1), ι a (colA j' i) *
                (∑ k : Fin (n₂ + 1), ι a (colB i k) * e₂ k a) := by
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [hcolB i a]
          _ = ∑ i : Fin (n₁ + 1), ∑ k : Fin (n₂ + 1),
                (ι a (colA j' i) * ι a (colB i k)) * e₂ k a := by
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl fun k _ => by ring
          _ = ∑ k : Fin (n₂ + 1), ∑ i : Fin (n₁ + 1),
                ι a (colA j' i * colB i k) * e₂ k a := by
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun i _ => ?_
              rw [map_mul]
          _ = ∑ k : Fin (n₂ + 1),
                ι a (∑ i : Fin (n₁ + 1), colA j' i * colB i k) * e₂ k a := by
              refine Finset.sum_congr rfl fun k _ => ?_
              rw [map_sum, Finset.sum_mul]
      have h2 : ∀ a : Idx,
          e₂ j' a = ∑ k : Fin (n₂ + 1),
            ι a (if k = j' then (1 : Ω) else 0) * e₂ k a := by
        intro a
        symm
        calc (∑ k : Fin (n₂ + 1), ι a (if k = j' then (1 : Ω) else 0) * e₂ k a)
            = ∑ k : Fin (n₂ + 1), if k = j' then e₂ k a else 0 := by
              refine Finset.sum_congr rfl fun k _ => ?_
              split_ifs <;> simp
          _ = e₂ j' a := by simp
      exact congrFun ((he₂_bas (e₂ j') (he₂_P j')).unique h1 h2) j
    let L₁ : (Fin (n₁ + 1) → Ω) →ₗ[Ω] (Fin (n₂ + 1) → Ω) :=
      { toFun := fun v j => ∑ i : Fin (n₁ + 1), v i * colB i j
        map_add' := fun v₁ v₂ => by ext j; simp [add_mul, Finset.sum_add_distrib]
        map_smul' := fun c v => by ext j; simp [smul_eq_mul, mul_assoc, Finset.mul_sum] }
    let L₂ : (Fin (n₂ + 1) → Ω) →ₗ[Ω] (Fin (n₁ + 1) → Ω) :=
      { toFun := fun w i => ∑ j : Fin (n₂ + 1), w j * colA j i
        map_add' := fun w₁ w₂ => by ext i; simp [add_mul, Finset.sum_add_distrib]
        map_smul' := fun c w => by ext i; simp [smul_eq_mul, mul_assoc, Finset.mul_sum] }
