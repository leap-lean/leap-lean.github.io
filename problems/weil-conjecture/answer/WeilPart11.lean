          (Z.presheaf.map (CategoryTheory.homOfLE h').op).hom ((ι_Z.app U).hom a) •
            H_Z.res h' x at hsm
        change H_Z.res h' ((ι_Z.app U).hom a • x) =
          ((ι_Z.app W).hom ((C.presheaf.map (CategoryTheory.homOfLE h).op).hom a)) • H_Z.res h' x
        rw [hsm, ← hNatι h a]
