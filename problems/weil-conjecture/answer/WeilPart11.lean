                (Finset.inf'_le _ (Finset.mem_univ (1 : Fin (s + 2))))))
        have hBase : (X.presheaf.map (CategoryTheory.homOfLE (hMono W h01_LW)).op).hom
            (ePresheaf W (L_W.V (β.1 0) ⊓ L_W.V (β.1 1)) (L_W.u (β.1 0) (β.1 1)).val) =
            (X.presheaf.map (CategoryTheory.homOfLE h01_X).op).hom
              (L.u (β.1 0) (β.1 1)).val :=
          (congrArg ((X.presheaf.map (CategoryTheory.homOfLE (hMono W h01_LW)).op).hom)
            (hIotaToX W (L.V (β.1 0) ⊓ L.V (β.1 1)) (L.u (β.1 0) (β.1 1)).val)).trans
            (hResComp _ _ _)
        exact congrArg (fun u => u ^ 3 * _ + _) hBase
      refine ⟨?_, ?_⟩
      · intro r c
        rw [← hΨΦ (r + 2) (openDiff W (r + 1) (openDiff W r c)),
          ← hIntertwine (r + 1) (openDiff W r c),
          ← hIntertwine r c,
          hd2_gen L_W r (Φ r c)]
        funext α
        change (X.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hImgInter (r + 2) α).symm)).op).hom
          (ePresheaf W (weilChartInter L_W α) 0) = 0
        rw [map_zero, map_zero]
      · intro hW r z_W hz_W
        have : AlgebraicGeometry.IsAffine W.toScheme := hW
        have hAffLW : ∀ a : Fin L_W.m, AlgebraicGeometry.IsAffineOpen (L_W.V a) := by
          intro a
          apply (W.ι.isAffineOpen_iff_of_isOpenImmersion).mp
          rw [hImgO W (L.V a)]
          exact hW.inf (hAffL a)
        have hz_LW : weilTricanonicalCechDiff L_W (r + 1) (Φ (r + 1) z_W) = 0 := by
          rw [hIntertwine (r + 1) z_W, hz_W]
          funext α
          change (ePresheaf W (weilChartInter L_W α)).symm
            ((X.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hImgInter (r + 2) α))).op).hom 0) = 0
          rw [map_zero, map_zero]
        obtain ⟨b', hb'⟩ := hAffVan W.toScheme L_W hAffLW r (Φ (r + 1) z_W) hz_LW
        refine ⟨Ψ r b', ?_⟩
        rw [← hΨΦ (r + 1) (openDiff W r (Ψ r b')), ← hIntertwine r (Ψ r b'),
          hΦΨ r b', hb', hΨΦ (r + 1) z_W]
    
    let resGlob : ∀ (W : X.Opens) (s : ℕ), WeilTricanonicalCechCochain L s → openCochain W s :=
      fun W s c α => (X.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (c α)
    have hResGlobDiff : ∀ (W : X.Opens) (s : ℕ) (c : WeilTricanonicalCechCochain L s),
        openDiff W s (resGlob W s c) = resGlob W (s + 1) (weilTricanonicalCechDiff L s c) := by
      intro W s c
      funext β
      dsimp only [resGlob, openDiff, weilTricanonicalCechDiff]
      simp only [map_add, map_mul, map_pow, map_sum, map_neg, map_one, hResComp]
    let resOpen : ∀ {W' W : X.Opens}, W' ≤ W → ∀ (s : ℕ), openCochain W s → openCochain W' s :=
      fun hWW s c α =>
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_inf_right _ hWW)).op).hom (c α)
    have hResOpenDiff : ∀ {W' W : X.Opens} (hWW : W' ≤ W) (s : ℕ) (c : openCochain W s),
        openDiff W' s (resOpen hWW s c) = resOpen hWW (s + 1) (openDiff W s c) := by
      intro W' W hWW s c
      funext β
      dsimp only [resOpen, openDiff]
      simp only [map_add, map_mul, map_pow, map_sum, map_neg, map_one, hResComp]
    have hResOpenGlob : ∀ {W' W : X.Opens} (hWW : W' ≤ W) (s : ℕ)
        (c : WeilTricanonicalCechCochain L s),
        resOpen hWW s (resGlob W s c) = resGlob W' s c := by
      intro W' W hWW s c
      funext α
      dsimp only [resOpen, resGlob]
      rw [hResComp]
    have hResOpenSub : ∀ {W' W : X.Opens} (hWW : W' ≤ W) (s : ℕ)
        (c₁ c₂ : openCochain W s),
        resOpen hWW s (c₁ - c₂) = resOpen hWW s c₁ - resOpen hWW s c₂ := by
      intro W' W hWW s c₁ c₂
      funext α
      dsimp only [resOpen, Pi.sub_apply]
      exact map_sub _ _ _
    
    let z₀ : openCochain W₀ (q + 2) := resGlob W₀ (q + 2) z
    let z₁ : openCochain W₁ (q + 2) := resGlob W₁ (q + 2) z
    have hz₀ : openDiff W₀ (q + 2) z₀ = 0 := by
      dsimp only [z₀]
      rw [hResGlobDiff, hz]
      funext α
      dsimp only [resGlob, Pi.zero_apply]
      exact map_zero _
    have hz₁ : openDiff W₁ (q + 2) z₁ = 0 := by
      dsimp only [z₁]
      rw [hResGlobDiff, hz]
      funext α
      dsimp only [resGlob, Pi.zero_apply]
      exact map_zero _
    obtain ⟨b₀, hb₀⟩ := (hOpenPkg W₀).2 hW₀ (q + 1) z₀ hz₀
    obtain ⟨b₁, hb₁⟩ := (hOpenPkg W₁).2 hW₁ (q + 1) z₁ hz₁
    let δ : openCochain W₀₁ (q + 1) :=
      resOpen (inf_le_left : W₀₁ ≤ W₀) (q + 1) b₀ -
        resOpen (inf_le_right : W₀₁ ≤ W₁) (q + 1) b₁
    have hδ : openDiff W₀₁ (q + 1) δ = 0 := by
      dsimp only [δ]
      rw [hOpenSub,
        hResOpenDiff (inf_le_left : W₀₁ ≤ W₀),
        hResOpenDiff (inf_le_right : W₀₁ ≤ W₁),
        hb₀, hb₁]
      dsimp only [z₀, z₁]
      rw [hResOpenGlob (inf_le_left : W₀₁ ≤ W₀),
        hResOpenGlob (inf_le_right : W₀₁ ≤ W₁),
        sub_self]
    obtain ⟨u, hu⟩ := (hOpenPkg W₀₁).2 hW₀₁ q δ hδ
    choose u₀ u₁ hu_split using fun ν : WeilStrictMonoTuple L.m q =>
      hSecSurj (weilChartInter L ν) (hAffInter q ν) (u ν)
    have hu_eq : resOpen (inf_le_left : W₀₁ ≤ W₀) q u₀ -
        resOpen (inf_le_right : W₀₁ ≤ W₁) q u₁ = u :=
      funext hu_split
    let b_tilde₀ : openCochain W₀ (q + 1) := b₀ - openDiff W₀ q u₀
    let b_tilde₁ : openCochain W₁ (q + 1) := b₁ - openDiff W₁ q u₁
    have hb_tilde_ov : resOpen (inf_le_left : W₀₁ ≤ W₀) (q + 1) b_tilde₀ -
        resOpen (inf_le_right : W₀₁ ≤ W₁) (q + 1) b_tilde₁ = 0 := by
      dsimp only [b_tilde₀, b_tilde₁]
      rw [hResOpenSub (inf_le_left : W₀₁ ≤ W₀),
        hResOpenSub (inf_le_right : W₀₁ ≤ W₁),
        ← hResOpenDiff (inf_le_left : W₀₁ ≤ W₀),
        ← hResOpenDiff (inf_le_right : W₀₁ ≤ W₁)]
      calc (resOpen (inf_le_left : W₀₁ ≤ W₀) (q + 1) b₀ -
            openDiff W₀₁ q (resOpen (inf_le_left : W₀₁ ≤ W₀) q u₀)) -
          (resOpen (inf_le_right : W₀₁ ≤ W₁) (q + 1) b₁ -
            openDiff W₀₁ q (resOpen (inf_le_right : W₀₁ ≤ W₁) q u₁))
          = δ - (openDiff W₀₁ q (resOpen (inf_le_left : W₀₁ ≤ W₀) q u₀) -
              openDiff W₀₁ q (resOpen (inf_le_right : W₀₁ ≤ W₁) q u₁)) := by
            dsimp only [δ]; abel
        _ = δ - openDiff W₀₁ q (resOpen (inf_le_left : W₀₁ ≤ W₀) q u₀ -
              resOpen (inf_le_right : W₀₁ ≤ W₁) q u₁) := by
            rw [← hOpenSub]
        _ = δ - δ := by rw [hu_eq, hu]
        _ = 0 := sub_self _
    choose b hb_W₀ hb_W₁ using fun α : WeilStrictMonoTuple L.m (q + 1) =>
      hSecGlue (weilChartInter L α) (b_tilde₀ α) (b_tilde₁ α)
        (sub_eq_zero.mp (congrFun hb_tilde_ov α))
    have hb_res₀ : resGlob W₀ (q + 1) b = b_tilde₀ := funext hb_W₀
    have hb_res₁ : resGlob W₁ (q + 1) b = b_tilde₁ := funext hb_W₁
    have hDiff_W₀ : resGlob W₀ (q + 2) (weilTricanonicalCechDiff L (q + 1) b) = z₀ := by
      rw [← hResGlobDiff, hb_res₀]
      dsimp only [b_tilde₀]
      rw [hOpenSub, hb₀, (hOpenPkg W₀).1 q u₀, sub_zero]
    have hDiff_W₁ : resGlob W₁ (q + 2) (weilTricanonicalCechDiff L (q + 1) b) = z₁ := by
      rw [← hResGlobDiff, hb_res₁]
      dsimp only [b_tilde₁]
      rw [hOpenSub, hb₁, (hOpenPkg W₁).1 q u₁, sub_zero]
    refine ⟨b, funext fun β => ?_⟩
    exact hSecInj (weilChartInter L β) (weilTricanonicalCechDiff L (q + 1) b β) (z β)
      (congrFun hDiff_W₀ β) (congrFun hDiff_W₁ β)

theorem weil_cech_cochain_flat_baseChange_and_fiber_vanishing (R : Type u) [CommRing R]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hFlat : AlgebraicGeometry.Flat g)
    (hProp : AlgebraicGeometry.IsProper g)
    (M : WeilLineBundle C)
    (hAffM : ∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a))
    (hFib : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (M_s : WeilLineBundle (CategoryTheory.Limits.pullback g s)),
      WeilPullbackLineBundle (CategoryTheory.Limits.pullback.fst g s) M M_s →
      HasFiberTricanonicalProperties (CategoryTheory.Limits.pullback.snd g s) M_s) :
    ∃ (instMod : ∀ p : ℕ, Module R (WeilTricanonicalCechCochain M p)),
      letI : ∀ p : ℕ, Module R (WeilTricanonicalCechCochain M p) := instMod
      ∃ (d : ∀ p : ℕ, WeilTricanonicalCechCochain M p →ₗ[R] WeilTricanonicalCechCochain M (p + 1)),
        (∀ (p : ℕ) (r : R) (c : WeilTricanonicalCechCochain M p),
          r • c = weilCechSmul g M p r c) ∧
        (∀ (p : ℕ) (c : WeilTricanonicalCechCochain M p),
          d p c = weilTricanonicalCechDiff M p c) ∧
        (∀ (p : ℕ) (c : WeilTricanonicalCechCochain M p),
          d (p + 1) (d p c) = 0) ∧
        (∀ p : ℕ, M.m ≤ p → Subsingleton (WeilTricanonicalCechCochain M p)) ∧
        (∀ p : ℕ, Module.Flat R (WeilTricanonicalCechCochain M p)) ∧
        (∀ (h : R) (r₀ : ℕ)
           (v : Fin (r₀ + 1) → TensorProduct R (Localization.Away h) (WeilTricanonicalCechCochain M 0)),
          ∃ (e_raw : Fin (r₀ + 1) → ∀ a : Fin M.m,
              ↑((CategoryTheory.Limits.pullback g
                  (AlgebraicGeometry.Spec.map
                    (CommRingCat.ofHom (algebraMap R (Localization.Away h))))).presheaf.obj
                (Opposite.op
                  (⊤ ⊓ (TopologicalSpace.Opens.map
                    (CategoryTheory.Limits.pullback.fst g
                      (AlgebraicGeometry.Spec.map
                        (CommRingCat.ofHom (algebraMap R (Localization.Away h))))).base).obj (M.V a))))),
            ∀ (R' : Type u) [CommRing R'] (ψ : Localization.Away h →+* R'),
              (letI : Algebra R R' := (ψ.comp (algebraMap R (Localization.Away h))).toAlgebra
               letI : Algebra (Localization.Away h) R' := ψ.toAlgebra
               letI : IsScalarTower R (Localization.Away h) R' := IsScalarTower.of_algebraMap_eq' rfl
               let v' : Fin (r₀ + 1) → TensorProduct R R' (WeilTricanonicalCechCochain M 0) :=
                 fun i => LinearMap.rTensor (WeilTricanonicalCechCochain M 0)
                   (IsScalarTower.toAlgHom R (Localization.Away h) R').toLinearMap (v i)
               (∀ i : Fin (r₀ + 1), LinearMap.baseChange R' (d 0) (v' i) = 0) ∧
               (∀ x : TensorProduct R R' (WeilTricanonicalCechCochain M 0),
                 LinearMap.baseChange R' (d 0) x = 0 →
                 ∃! c : Fin (r₀ + 1) → R', x = ∑ i : Fin (r₀ + 1), c i • v' i)) →
              let u_h := AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap R (Localization.Away h)))
              let u' := AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (ψ.comp (algebraMap R (Localization.Away h))))
              let C' := CategoryTheory.Limits.pullback g u'
              let snd' := CategoryTheory.Limits.pullback.snd g u'
              ∀ (w' : C' ⟶ CategoryTheory.Limits.pullback g u_h),
                w' ≫ CategoryTheory.Limits.pullback.fst g u_h =
                  CategoryTheory.Limits.pullback.fst g u' →
                w' ≫ CategoryTheory.Limits.pullback.snd g u_h =
                  snd' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) →
                ∀ (M' : WeilLineBundle C') (eIdx : Fin M'.m ≃ Fin M.m)
                  (hV : ∀ a : Fin M'.m,
                    ⊤ ⊓ M'.V a =
                      (TopologicalSpace.Opens.map w'.base).obj
                        (⊤ ⊓ (TopologicalSpace.Opens.map
                          (CategoryTheory.Limits.pullback.fst g u_h).base).obj (M.V (eIdx a)))),
                  (∀ a b : Fin M'.m,
                    ∀ hEq : M'.V a ⊓ M'.V b =
                        (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g u').base).obj
                          (M.V (eIdx a) ⊓ M.V (eIdx b)),
                      (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq hEq.symm)).op).hom
                          (M'.u a b).val =
                        ((CategoryTheory.Limits.pullback.fst g u').app
                          (M.V (eIdx a) ⊓ M.V (eIdx b))).hom (M.u (eIdx a) (eIdx b)).val) →
                  let e' : Fin (r₀ + 1) → ∀ a : Fin M'.m,
                      ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))) :=
                    fun i a =>
                      (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV a))).op).hom
                        ((w'.app _).hom (e_raw i (eIdx a)))
                  (∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M' ⊤ (e' i)) ∧
                  (∀ s' : ∀ a : Fin M'.m, ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))),
                    IsWeilTricanonicalSection M' ⊤ s' →
                    ∃! c : Fin (r₀ + 1) → R',
                      ∀ a : Fin M'.m,
                        s' a = ∑ i : Fin (r₀ + 1),
                          (C'.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M'.V a ≤ ⊤)).op).hom
                            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫
                              snd'.appTop).hom (c i)) * e' i a)) ∧
        (∀ q : PrimeSpectrum R,
          ∃ (r₀ : ℕ) (_ : 3 ≤ r₀),
            (∀ p : ℕ,
              LinearMap.ker (LinearMap.baseChange q.asIdeal.ResidueField (d (p + 1))) ≤
                LinearMap.range (LinearMap.baseChange q.asIdeal.ResidueField (d p))) ∧
            Nonempty
              ((Fin (r₀ + 1) → q.asIdeal.ResidueField) ≃ₗ[q.asIdeal.ResidueField]
                ↥(LinearMap.ker (LinearMap.baseChange q.asIdeal.ResidueField (d 0))))) :=
by
  let φ_open : ∀ U : C.Opens, R →+* ↑(C.presheaf.obj (Opposite.op U)) :=
    fun U =>
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
        g.appLE ⊤ U (fun _ _ => trivial)).hom
  have hφ_res : ∀ {W V : C.Opens} (hWV : W ≤ V) (r : R),
      (C.presheaf.map (CategoryTheory.homOfLE hWV).op).hom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
          g.appLE ⊤ V (fun _ _ => trivial)).hom r) =
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
        g.appLE ⊤ W (fun _ _ => trivial)).hom r := by
    intro W V hWV r
    have hcomp : g.appLE ⊤ V (fun _ _ => trivial) ≫
        C.presheaf.map (CategoryTheory.homOfLE hWV).op =
        g.appLE ⊤ W (fun _ _ => trivial) := by
      simp only [AlgebraicGeometry.Scheme.Hom.appLE, CategoryTheory.Category.assoc,
        ← C.presheaf.map_comp]
      rfl
    change (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
      g.appLE ⊤ V (fun _ _ => trivial)) ≫ C.presheaf.map (CategoryTheory.homOfLE hWV).op).hom r = _
    rw [CategoryTheory.Category.assoc, hcomp]
  let instAlgInter : ∀ (p : ℕ) (α : WeilStrictMonoTuple M.m p),
      Algebra R ↑(C.presheaf.obj (Opposite.op (weilChartInter M α))) :=
    fun p α => (φ_open (weilChartInter M α)).toAlgebra
  let instModInter : ∀ (p : ℕ) (α : WeilStrictMonoTuple M.m p),
      Module R ↑(C.presheaf.obj (Opposite.op (weilChartInter M α))) :=
    fun p α => @Algebra.toModule R _ _ _ (instAlgInter p α)
  let instMod : ∀ p : ℕ, Module R (WeilTricanonicalCechCochain M p) :=
    fun p => @Pi.module (WeilStrictMonoTuple M.m p) _ R _ _ (instModInter p)
  let _ : ∀ p : ℕ, Module R (WeilTricanonicalCechCochain M p) := instMod
  have hSmul : ∀ (p : ℕ) (r : R) (c : WeilTricanonicalCechCochain M p),
      r • c = weilCechSmul g M p r c := fun _ _ _ => rfl
  let d : ∀ p : ℕ, WeilTricanonicalCechCochain M p →ₗ[R] WeilTricanonicalCechCochain M (p + 1) :=
    fun p =>
      { toFun := weilTricanonicalCechDiff M p
        map_add' := fun c₁ c₂ => by
          funext β
          simp only [weilTricanonicalCechDiff, Pi.add_apply, map_add, mul_add,
            Finset.sum_add_distrib]
          abel
        map_smul' := fun r c => by
          funext β
          change weilTricanonicalCechDiff M p (weilCechSmul g M p r c) β =
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
              g.appLE ⊤ (weilChartInter M β) (fun _ _ => trivial)).hom r) *
              weilTricanonicalCechDiff M p c β
          simp only [weilTricanonicalCechDiff, weilCechSmul, map_mul, hφ_res, mul_add,
            Finset.mul_sum]
          congr 1
          · ring
          · refine Finset.sum_congr rfl fun k _ => ?_
            ring }
  have hDiff : ∀ (p : ℕ) (c : WeilTricanonicalCechCochain M p),
      d p c = weilTricanonicalCechDiff M p c := fun _ _ => rfl
  have hSuccAbove : ∀ {n : ℕ} (i₀ j₀ : Fin (n + 1)) (k : Fin n),
      i₀ ≤ j₀ → j₀.succ.succAbove (i₀.succAbove k) = i₀.castSucc.succAbove (j₀.succAbove k) := by
    intro n i₀ j₀ k hij
    rcases lt_or_ge k.castSucc i₀ with hki | hik
    · have hkj : k.castSucc < j₀ := lt_of_lt_of_le hki hij
      rw [Fin.succAbove_of_castSucc_lt _ _ hki, Fin.succAbove_of_castSucc_lt _ _ hkj,
        Fin.succAbove_of_castSucc_lt _ _ (Fin.castSucc_lt_castSucc_iff.mpr hki),
        Fin.succAbove_of_castSucc_lt _ _
          (lt_trans (Fin.castSucc_lt_castSucc_iff.mpr hkj) j₀.castSucc_lt_succ)]
    · rcases lt_or_ge k.castSucc j₀ with hkj | hjk
      · rw [Fin.succAbove_of_le_castSucc _ _ hik, Fin.succAbove_of_castSucc_lt _ _ hkj,
          Fin.succAbove_of_le_castSucc _ _ (Fin.castSucc_le_castSucc_iff.mpr hik),
          Fin.succAbove_of_castSucc_lt _ _ (Fin.succ_lt_succ_iff.mpr hkj)]
        ext; simp
      · rw [Fin.succAbove_of_le_castSucc _ _ hik, Fin.succAbove_of_le_castSucc _ _ hjk,
          Fin.succAbove_of_le_castSucc _ _ (Fin.succ_le_succ_iff.mpr hjk),
          Fin.succAbove_of_le_castSucc _ _
            (le_trans (Fin.castSucc_le_castSucc_iff.mpr hik)
              (le_of_lt (Fin.castSucc_lt_castSucc_iff.mpr k.castSucc_lt_succ)))]
  have hResComp : ∀ {U₁ U₂ U₃ : C.Opens} (h₁₂ : U₁ ≤ U₂) (h₂₃ : U₂ ≤ U₃)
      (x : ↑(C.presheaf.obj (Opposite.op U₃))),
      (C.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom
        ((C.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom x) =
      (C.presheaf.map (CategoryTheory.homOfLE (le_trans h₁₂ h₂₃)).op).hom x := by
    intro U₁ U₂ U₃ h₁₂ h₂₃ x
    change (C.presheaf.map (CategoryTheory.homOfLE h₂₃).op ≫
      C.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom x = _
    rw [← C.presheaf.map_comp]
    rfl
  have hd2 : ∀ (p : ℕ) (c : WeilTricanonicalCechCochain M p), d (p + 1) (d p c) = 0 := by
    intro p c
    funext γ
    change weilTricanonicalCechDiff M (p + 1) (weilTricanonicalCechDiff M p c) γ = 0
    let face₁ : Fin (p + 3) → WeilStrictMonoTuple M.m (p + 1) :=
      fun j => ⟨fun k => γ.1 (j.succAbove k), γ.2.comp (Fin.strictMono_succAbove j)⟩
    let face₀ : ∀ β : WeilStrictMonoTuple M.m (p + 1), Fin (p + 2) → WeilStrictMonoTuple M.m p :=
      fun β i => ⟨fun k => β.1 (i.succAbove k), β.2.comp (Fin.strictMono_succAbove i)⟩
    let hFace₁ : ∀ j : Fin (p + 3), weilChartInter M γ ≤ weilChartInter M (face₁ j) :=
      fun j => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (j.succAbove k)))
    let hFace₀ : ∀ (β : WeilStrictMonoTuple M.m (p + 1)) (i : Fin (p + 2)),
        weilChartInter M β ≤ weilChartInter M (face₀ β i) :=
      fun β i => Finset.le_inf' _ _ (fun k _ => Finset.inf'_le _ (Finset.mem_univ (i.succAbove k)))
    let hγ : ∀ a b : Fin (p + 3), weilChartInter M γ ≤ M.V (γ.1 a) ⊓ M.V (γ.1 b) :=
      fun a b => le_inf (Finset.inf'_le _ (Finset.mem_univ a))
        (Finset.inf'_le _ (Finset.mem_univ b))
    let w : Fin (p + 3) → Fin (p + 3) → ↑(C.presheaf.obj (Opposite.op (weilChartInter M γ))) :=
      fun a b => ((C.presheaf.map (CategoryTheory.homOfLE (hγ a b)).op).hom
        (M.u (γ.1 a) (γ.1 b)).val) ^ 3
    let T : Fin (p + 3) → Fin (p + 2) → ↑(C.presheaf.obj (Opposite.op (weilChartInter M γ))) :=
      fun j i => (C.presheaf.map (CategoryTheory.homOfLE
        (le_trans (hFace₁ j) (hFace₀ (face₁ j) i))).op).hom (c (face₀ (face₁ j) i))
    have hUEq : ∀ {a₁ b₁ a₂ b₂ : Fin M.m} (ha : a₁ = a₂) (hb : b₁ = b₂)
        (h₁ : weilChartInter M γ ≤ M.V a₁ ⊓ M.V b₁)
        (h₂ : weilChartInter M γ ≤ M.V a₂ ⊓ M.V b₂),
        (C.presheaf.map (CategoryTheory.homOfLE h₁).op).hom (M.u a₁ b₁).val =
        (C.presheaf.map (CategoryTheory.homOfLE h₂).op).hom (M.u a₂ b₂).val := by
      intro a₁ b₁ a₂ b₂ ha hb h₁ h₂
      subst ha; subst hb; rfl
    have hEvalEq : ∀ {α₁ α₂ : WeilStrictMonoTuple M.m p} (hEq : α₁ = α₂)
        (h₁ : weilChartInter M γ ≤ weilChartInter M α₁)
        (h₂ : weilChartInter M γ ≤ weilChartInter M α₂),
        (C.presheaf.map (CategoryTheory.homOfLE h₁).op).hom (c α₁) =
        (C.presheaf.map (CategoryTheory.homOfLE h₂).op).hom (c α₂) := by
      intro α₁ α₂ hEq h₁ h₂
      subst hEq; rfl
    have hTEq : ∀ (i₀ j₀ : Fin (p + 2)), i₀ ≤ j₀ →
        T j₀.succ i₀ = T i₀.castSucc j₀ := by
      intro i₀ j₀ hij
      refine hEvalEq (Subtype.ext (funext fun k => ?_)) _ _
      exact congrArg γ.1 (hSuccAbove i₀ j₀ k hij)
    have hw_cocycle : w 0 1 * w 1 2 = w 0 2 := by
      let h012 : weilChartInter M γ ≤ M.V (γ.1 0) ⊓ M.V (γ.1 1) ⊓ M.V (γ.1 2) :=
        le_inf (hγ 0 1) (Finset.inf'_le _ (Finset.mem_univ 2))
      have hc := congrArg
        ((C.presheaf.map (CategoryTheory.homOfLE h012).op).hom)
        (M.u_cocycle (γ.1 0) (γ.1 1) (γ.1 2))
      rw [map_mul, hResComp, hResComp, hResComp] at hc
      dsimp only [w]
      rw [← mul_pow, hc]
    have hMapNegOnePow : ∀ {U₁ U₂ : C.Opens}
        (f : C.presheaf.obj (Opposite.op U₁) ⟶ C.presheaf.obj (Opposite.op U₂))
        (n : ℕ), f.hom ((-1) ^ n) = (-1) ^ n := by
      intro U₁ U₂ f n
      rw [map_pow, map_neg, map_one]
    have hOuter0 :
        (C.presheaf.map (CategoryTheory.homOfLE (hFace₁ 0)).op).hom
          (weilTricanonicalCechDiff M p c (face₁ 0)) =
        w 1 2 * T 0 0 + ∑ r : Fin (p + 1), (-1) ^ ((r : ℕ) + 1) * T 0 r.succ := by
      simp only [weilTricanonicalCechDiff, map_add, map_mul, map_pow, map_sum, hMapNegOnePow, hResComp]
      rw [hUEq (rfl : (face₁ 0).1 0 = γ.1 1) (rfl : (face₁ 0).1 1 = γ.1 2) _ (hγ 1 2)]
      rfl
    have hOuter1 :
        (C.presheaf.map (CategoryTheory.homOfLE (hFace₁ 1)).op).hom
          (weilTricanonicalCechDiff M p c (face₁ 1)) =
        w 0 2 * T 1 0 + ∑ r : Fin (p + 1), (-1) ^ ((r : ℕ) + 1) * T 1 r.succ := by
      simp only [weilTricanonicalCechDiff, map_add, map_mul, map_pow, map_sum, hMapNegOnePow, hResComp]
      rw [hUEq (rfl : (face₁ 1).1 0 = γ.1 0) (rfl : (face₁ 1).1 1 = γ.1 2) _ (hγ 0 2)]
      rfl
    have hOuterSucc2 : ∀ r : Fin (p + 1),
        (C.presheaf.map (CategoryTheory.homOfLE (hFace₁ r.succ.succ)).op).hom
          (weilTricanonicalCechDiff M p c (face₁ r.succ.succ)) =
        w 0 1 * T r.succ.succ 0 + (-1 : _) * T r.succ.succ 1 +
          ∑ s : Fin p, (-1) ^ ((s : ℕ) + 2) * T r.succ.succ s.succ.succ := by
      intro r
      simp only [weilTricanonicalCechDiff, map_add, map_mul, map_pow, map_sum, hMapNegOnePow, hResComp]
      have ha : (face₁ r.succ.succ).1 0 = γ.1 0 := by
        change γ.1 (r.succ.succ.succAbove 0) = γ.1 0
        have h0lt : (0 : Fin (p + 2)).castSucc < r.succ.succ := by
          rw [Fin.castSucc_zero]
          exact Fin.succ_pos _
        rw [Fin.succAbove_of_castSucc_lt _ _ h0lt]
        rfl
      have hb : (face₁ r.succ.succ).1 1 = γ.1 1 := by
        change γ.1 (r.succ.succ.succAbove 1) = γ.1 1
        have h1lt : (1 : Fin (p + 2)).castSucc < r.succ.succ := by
          change (0 : Fin (p + 1)).succ.castSucc < r.succ.succ
          rw [← Fin.succ_castSucc]
          exact Fin.succ_lt_succ_iff.mpr (by rw [Fin.castSucc_zero]; exact Fin.succ_pos _)
        rw [Fin.succAbove_of_castSucc_lt _ _ h1lt]
        rfl
      rw [hUEq ha hb _ (hγ 0 1), Fin.sum_univ_succ]
      change w 0 1 * T r.succ.succ 0 +
        ((-1) ^ ((0 : ℕ) + 1) * T r.succ.succ 1 +
          ∑ s : Fin p, (-1) ^ ((s.succ : ℕ) + 1) * T r.succ.succ s.succ.succ) = _
      simp only [zero_add, pow_one, Fin.val_succ, add_assoc]
    change w 0 1 * (C.presheaf.map (CategoryTheory.homOfLE (hFace₁ 0)).op).hom
        (weilTricanonicalCechDiff M p c (face₁ 0)) +
      ∑ k : Fin (p + 2), (-1) ^ ((k : ℕ) + 1) *
        (C.presheaf.map (CategoryTheory.homOfLE (hFace₁ k.succ)).op).hom
          (weilTricanonicalCechDiff M p c (face₁ k.succ)) = 0
    rw [Fin.sum_univ_succ]
    change w 0 1 * (C.presheaf.map (CategoryTheory.homOfLE (hFace₁ 0)).op).hom
        (weilTricanonicalCechDiff M p c (face₁ 0)) +
      ((-1) ^ ((0 : ℕ) + 1) *
        (C.presheaf.map (CategoryTheory.homOfLE (hFace₁ 1)).op).hom
          (weilTricanonicalCechDiff M p c (face₁ 1)) +
      ∑ r : Fin (p + 1), (-1) ^ ((r.succ : ℕ) + 1) *
        (C.presheaf.map (CategoryTheory.homOfLE (hFace₁ r.succ.succ)).op).hom
          (weilTricanonicalCechDiff M p c (face₁ r.succ.succ))) = 0
    rw [hOuter0, hOuter1]
    have hSumR : (∑ r : Fin (p + 1), (-1) ^ ((r.succ : ℕ) + 1) *
        (C.presheaf.map (CategoryTheory.homOfLE (hFace₁ r.succ.succ)).op).hom
          (weilTricanonicalCechDiff M p c (face₁ r.succ.succ))) =
        (∑ r : Fin (p + 1), (-1) ^ ((r : ℕ) + 2) * (w 0 1 * T 0 r.succ)) +
        (∑ r : Fin (p + 1), (-1) ^ ((r : ℕ) + 2) * ((-1 : _) * T 1 r.succ)) +
        ∑ r : Fin (p + 1), ∑ s : Fin p,
          (-1) ^ ((r : ℕ) + 2) * ((-1) ^ ((s : ℕ) + 2) * T r.succ.succ s.succ.succ) := by
      trans (∑ r : Fin (p + 1),
        ((-1) ^ ((r : ℕ) + 2) * (w 0 1 * T 0 r.succ) +
         (-1) ^ ((r : ℕ) + 2) * ((-1 : _) * T 1 r.succ) +
         ∑ s : Fin p, (-1) ^ ((r : ℕ) + 2) * ((-1) ^ ((s : ℕ) + 2) * T r.succ.succ s.succ.succ)))
      · refine Finset.sum_congr rfl fun r _ => ?_
        have h1_le : (1 : Fin (p + 2)) ≤ r.succ := Fin.succ_le_succ_iff.mpr (Fin.zero_le r)
        have hT0r : T r.succ.succ 0 = T 0 r.succ := hTEq 0 r.succ (Fin.zero_le _)
        have hT1r : T r.succ.succ 1 = T 1 r.succ := hTEq 1 r.succ h1_le
        rw [hOuterSucc2 r, hT0r, hT1r]
        simp only [Fin.val_succ, mul_add, Finset.mul_sum, add_assoc]
      · rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
    have hT10 : T 1 0 = T 0 0 := hTEq 0 0 (le_refl _)
    rw [hSumR, hT10]
    have hCancel01 : w 0 1 * (w 1 2 * T 0 0 + ∑ r : Fin (p + 1), (-1) ^ ((r : ℕ) + 1) * T 0 r.succ) +
        ((-1) ^ ((0 : ℕ) + 1) * (w 0 2 * T 0 0 + ∑ r : Fin (p + 1), (-1) ^ ((r : ℕ) + 1) * T 1 r.succ) +
        ((∑ r : Fin (p + 1), (-1) ^ ((r : ℕ) + 2) * (w 0 1 * T 0 r.succ)) +
         (∑ r : Fin (p + 1), (-1) ^ ((r : ℕ) + 2) * ((-1 : _) * T 1 r.succ)) +
         ∑ r : Fin (p + 1), ∑ s : Fin p,
           (-1) ^ ((r : ℕ) + 2) * ((-1) ^ ((s : ℕ) + 2) * T r.succ.succ s.succ.succ))) =
        ∑ r : Fin (p + 1), ∑ s : Fin p,
          (-1) ^ ((r : ℕ) + 2) * ((-1) ^ ((s : ℕ) + 2) * T r.succ.succ s.succ.succ) := by
      have hc1 : w 0 1 * ∑ r : Fin (p + 1), (-1) ^ ((r : ℕ) + 1) * T 0 r.succ +
          ∑ r : Fin (p + 1), (-1) ^ ((r : ℕ) + 2) * (w 0 1 * T 0 r.succ) = 0 := by
        rw [Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_eq_zero fun r _ => ?_
        rw [pow_succ (-1 : _) ((r : ℕ) + 1)]
        ring
      have hc2 : (-1 : _) * ∑ r : Fin (p + 1), (-1) ^ ((r : ℕ) + 1) * T 1 r.succ +
          ∑ r : Fin (p + 1), (-1) ^ ((r : ℕ) + 2) * ((-1 : _) * T 1 r.succ) = 0 := by
        rw [Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_eq_zero fun r _ => ?_
        rw [pow_succ (-1 : _) ((r : ℕ) + 1)]
        ring
      have hw0 : w 0 1 * (w 1 2 * T 0 0) = w 0 2 * T 0 0 := by
        rw [← mul_assoc, hw_cocycle]
      simp only [zero_add, pow_one, mul_add, hw0]
      linear_combination hc1 + hc2
    rw [hCancel01, ← Finset.sum_product']
    let term : Fin (p + 1) × Fin p → ↑(C.presheaf.obj (Opposite.op (weilChartInter M γ))) :=
      fun x => (-1) ^ ((x.1 : ℕ) + 2) * ((-1) ^ ((x.2 : ℕ) + 2) * T x.1.succ.succ x.2.succ.succ)
    change ∑ x ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin (p + 1) × Fin p)), term x = 0
    rw [← Finset.sum_filter_add_sum_filter_not _ (fun x : Fin (p + 1) × Fin p => (x.1 : ℕ) ≤ (x.2 : ℕ))]
    have hBij : ∑ x ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin (p + 1) × Fin p)).filter
          (fun x => ¬ (x.1 : ℕ) ≤ (x.2 : ℕ)), term x =
        ∑ y ∈ (Finset.univ ×ˢ Finset.univ : Finset (Fin (p + 1) × Fin p)).filter
          (fun y => (y.1 : ℕ) ≤ (y.2 : ℕ)), - term y := by
      refine Finset.sum_bij
        (fun x hx => (⟨x.2.1, Nat.lt_succ_of_lt x.2.2⟩,
          ⟨x.1.1 - 1, by
            simp only [Finset.mem_filter, not_le] at hx
            omega⟩))
        (fun x hx => by
          simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_univ, true_and, not_le] at hx ⊢
          omega)
        (fun x₁ hx₁ x₂ hx₂ hEq => by
          simp only [Finset.mem_filter, not_le] at hx₁ hx₂
          ext <;> simp only [Prod.mk.injEq, Fin.mk.injEq] at hEq <;> omega)
        (fun y hy => by
          simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_univ, true_and] at hy
          refine ⟨(y.2.succ, ⟨y.1.1, lt_of_le_of_lt hy y.2.2⟩), ?_, ?_⟩
          · simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_univ, true_and,
              Fin.val_succ, not_le]
            omega
          · ext <;> simp)
        (fun x hx => by
          simp only [Finset.mem_filter, not_le] at hx
          let i₀ : Fin (p + 2) := ⟨x.2.1 + 2, by omega⟩
          let j₀ : Fin (p + 2) := ⟨x.1.1 + 1, by omega⟩
          have hij : i₀ ≤ j₀ := by
            simp only [Fin.le_iff_val_le_val, i₀, j₀]
            omega
          have hj_eq : j₀.succ = x.1.succ.succ := by
            ext; simp [j₀]
          have hi_eq : i₀ = x.2.succ.succ := by
            ext; simp [i₀]
          have hic_eq : i₀.castSucc = (⟨x.2.1, Nat.lt_succ_of_lt x.2.2⟩ : Fin (p + 1)).succ.succ := by
            ext; simp [i₀]
          have hj0_eq : j₀ = (⟨x.1.1 - 1, by omega⟩ : Fin p).succ.succ := by
            ext; simp [j₀]; omega
          have hT : T x.1.succ.succ x.2.succ.succ =
              T (⟨x.2.1, Nat.lt_succ_of_lt x.2.2⟩ : Fin (p + 1)).succ.succ
                (⟨x.1.1 - 1, by omega⟩ : Fin p).succ.succ := by
            rw [← hj_eq, ← hi_eq, ← hic_eq, ← hj0_eq]
            exact hTEq i₀ j₀ hij
          dsimp only [term]
          rw [hT]
          have hexp : (x.1 : ℕ) + 2 = ((x.1 : ℕ) - 1 + 2) + 1 := by omega
          rw [hexp, pow_succ (-1 : _) ((x.1 : ℕ) - 1 + 2)]
          ring)
    rw [hBij, ← Finset.sum_add_distrib]
    exact Finset.sum_eq_zero fun _ _ => add_neg_cancel _
  have hBound : ∀ p : ℕ, M.m ≤ p → Subsingleton (WeilTricanonicalCechCochain M p) := by
    intro p hp
    have : IsEmpty (WeilStrictMonoTuple M.m p) :=
      ⟨fun α => by
        have hle : Fintype.card (Fin (p + 1)) ≤ Fintype.card (Fin M.m) :=
          Fintype.card_le_of_injective α.1 α.2.injective
        simp only [Fintype.card_fin] at hle
        omega⟩
    infer_instance
  have hSepC : C.IsSeparated := by
    rw [AlgebraicGeometry.Scheme.isSeparated_iff]
    have : AlgebraicGeometry.IsProper g := hProp
    have hTerm : CategoryTheory.Limits.terminal.from C =
        g ≫ CategoryTheory.Limits.terminal.from (AlgebraicGeometry.Spec (CommRingCat.of R)) :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    rw [hTerm]
    exact CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance inferInstance
  have hAffInter : ∀ (p : ℕ) (α : WeilStrictMonoTuple M.m p),
      AlgebraicGeometry.IsAffineOpen (weilChartInter M α) := by
    intro p α
    have : C.IsSeparated := hSepC
    exact Finset.inf'_induction
      ⟨0, Finset.mem_univ (0 : Fin (p + 1))⟩
      (fun k => M.V (α.1 k))
      (fun U₁ hU₁ U₂ hU₂ => hU₁.inf hU₂)
      (fun k _ => hAffM (α.1 k))
  have hFlatK : ∀ p : ℕ, Module.Flat R (WeilTricanonicalCechCochain M p) := by
    intro p
    have : ∀ α : WeilStrictMonoTuple M.m p,
        Module.Flat R ↑(C.presheaf.obj (Opposite.op (weilChartInter M α))) := by
      intro α
      let _ : Algebra R ↑(C.presheaf.obj (Opposite.op (weilChartInter M α))) := instAlgInter p α
      rw [← RingHom.flat_algebraMap_iff]
      have hFlatApp : (g.appLE ⊤ (weilChartInter M α) (fun _ _ => trivial)).hom.Flat :=
        AlgebraicGeometry.HasRingHomProperty.appLE @AlgebraicGeometry.Flat g hFlat
          ⟨⊤, AlgebraicGeometry.isAffineOpen_top _⟩
          ⟨weilChartInter M α, hAffInter p α⟩
          (fun _ _ => trivial)
      have hBijIso : Function.Bijective
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).symm.commRingCatIsoToRingEquiv.bijective
      have hFlatInv : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom).Flat :=
        RingHom.Flat.of_bijective hBijIso
      exact RingHom.Flat.comp hFlatInv hFlatApp
    exact Module.Flat.of_linearEquiv
      (DirectSum.linearEquivFunOnFintype R (WeilStrictMonoTuple M.m p)
        (fun α => ↑(C.presheaf.obj (Opposite.op (weilChartInter M α))))).symm
  have hFieldDescent : ∀ (K : ℕ → Type u) [∀ p, AddCommGroup (K p)] [∀ p, Module R (K p)]
      (d_K : ∀ p : ℕ, K p →ₗ[R] K (p + 1)),
      (∀ (p : ℕ) (c : K p), d_K (p + 1) (d_K p c) = 0) →
      ∀ (κ Ω : Type u) [Field κ] [Field Ω] [Algebra R κ] [Algebra R Ω]
        [Algebra κ Ω] [IsScalarTower R κ Ω] (r₀ : ℕ),
        (∀ p : ℕ,
          LinearMap.ker (LinearMap.baseChange Ω (d_K (p + 1))) ≤
            LinearMap.range (LinearMap.baseChange Ω (d_K p))) →
        Nonempty ((Fin (r₀ + 1) → Ω) ≃ₗ[Ω] ↥(LinearMap.ker (LinearMap.baseChange Ω (d_K 0)))) →
        (∀ p : ℕ,
          LinearMap.ker (LinearMap.baseChange κ (d_K (p + 1))) ≤
            LinearMap.range (LinearMap.baseChange κ (d_K p))) ∧
        Nonempty ((Fin (r₀ + 1) → κ) ≃ₗ[κ] ↥(LinearMap.ker (LinearMap.baseChange κ (d_K 0)))) := by
    intro K _ _ d_K hd_K2 κ Ω _ _ _ _ _ _ r₀ hVan_Ω hDim_Ω
    let A : ∀ p : ℕ,
        TensorProduct κ Ω (TensorProduct R κ (K p)) ≃ₗ[Ω] TensorProduct R Ω (K p) :=
      fun p => TensorProduct.AlgebraTensorModule.cancelBaseChange R κ Ω Ω (K p)
    have hIntertwine : ∀ (p : ℕ) (z : TensorProduct κ Ω (TensorProduct R κ (K p))),
        A (p + 1) (LinearMap.baseChange Ω (LinearMap.baseChange κ (d_K p)) z) =
          LinearMap.baseChange Ω (d_K p) (A p z) := by
      intro p z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | add x y hx hy => rw [map_add, map_add, map_add, map_add, hx, hy]
      | tmul ω y =>
        induction y using TensorProduct.induction_on with
        | zero => simp
        | add y₁ y₂ hy₁ hy₂ =>
          rw [TensorProduct.tmul_add, map_add, map_add, map_add, map_add, hy₁, hy₂]
        | tmul a m =>
          simp [A, TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul]
    have hdκ2 : ∀ (p : ℕ) (y : TensorProduct R κ (K p)),
        LinearMap.baseChange κ (d_K (p + 1)) (LinearMap.baseChange κ (d_K p) y) = 0 := by
      intro p y
      induction y using TensorProduct.induction_on with
      | zero => simp
      | add y₁ y₂ hy₁ hy₂ => rw [map_add, map_add, hy₁, hy₂, add_zero]
      | tmul a m => simp [hd_K2]
    have hBaseEqLTensor : ∀ {M₁ M₂ : Type u} [AddCommMonoid M₁] [Module κ M₁]
        [AddCommMonoid M₂] [Module κ M₂] (f : M₁ →ₗ[κ] M₂),
        (⇑(LinearMap.baseChange Ω f) : TensorProduct κ Ω M₁ → TensorProduct κ Ω M₂) =
          ⇑(LinearMap.lTensor Ω f) := by
      intro M₁ M₂ _ _ _ _ f
      funext z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | add x y hx hy => rw [map_add, map_add, hx, hy]
      | tmul ω m => rfl
    refine ⟨?_, ?_⟩
    · intro p
      let f_κ := LinearMap.baseChange κ (d_K p)
      let g_κ := LinearMap.baseChange κ (d_K (p + 1))
      have hEx_Ω : Function.Exact ⇑(LinearMap.lTensor Ω f_κ) ⇑(LinearMap.lTensor Ω g_κ) := by
        rw [← hBaseEqLTensor f_κ, ← hBaseEqLTensor g_κ]
        intro z
        constructor
        · intro hz
          have hz' : A (p + 1) z ∈ LinearMap.ker (LinearMap.baseChange Ω (d_K (p + 1))) := by
            rw [LinearMap.mem_ker, ← hIntertwine (p + 1) z, hz, map_zero]
          obtain ⟨u, hu⟩ := hVan_Ω p hz'
          refine ⟨(A p).symm u, ?_⟩
          apply (A (p + 1)).injective
          rw [hIntertwine p, LinearEquiv.apply_symm_apply, hu]
        · rintro ⟨w, rfl⟩
          have hcomp0 : LinearMap.baseChange Ω g_κ (LinearMap.baseChange Ω f_κ w) = 0 := by
            induction w using TensorProduct.induction_on with
            | zero => simp
            | add y₁ y₂ hy₁ hy₂ => rw [map_add, map_add, hy₁, hy₂, add_zero]
            | tmul ω m => simp [f_κ, g_κ, hdκ2]
          exact hcomp0
      have hEx_κ : Function.Exact ⇑f_κ ⇑g_κ :=
        (Module.FaithfullyFlat.lTensor_exact_iff_exact κ Ω f_κ g_κ).mp hEx_Ω
      intro x hx
      exact (hEx_κ x).mp hx
    · obtain ⟨e_Ω⟩ := hDim_Ω
      let d₀_κ : TensorProduct R κ (K 0) →ₗ[κ] TensorProduct R κ (K 1) :=
        LinearMap.baseChange κ (d_K 0)
      have : Module.Free κ ↥(LinearMap.ker d₀_κ) :=
        Module.Free.of_divisionRing κ ↥(LinearMap.ker d₀_κ)
      let ι := Module.Free.ChooseBasisIndex κ ↥(LinearMap.ker d₀_κ)
      let b_κ : Module.Basis ι κ ↥(LinearMap.ker d₀_κ) :=
        Module.Free.chooseBasis κ ↥(LinearMap.ker d₀_κ)
      let j_κ : (ι →₀ κ) →ₗ[κ] TensorProduct R κ (K 0) :=
        (LinearMap.ker d₀_κ).subtype.comp b_κ.repr.symm.toLinearMap
      have hj_inj : Function.Injective ⇑j_κ :=
        Subtype.val_injective.comp b_κ.repr.symm.injective
      have hInj_lT : Function.Injective ⇑(LinearMap.baseChange Ω j_κ) := by
        rw [hBaseEqLTensor j_κ]
        exact Module.Flat.lTensor_preserves_injective_linearMap j_κ hj_inj
      have hEx0_κ : Function.Exact ⇑j_κ ⇑d₀_κ := by
        intro x
        constructor
        · intro hx
          refine ⟨b_κ.repr ⟨x, hx⟩, ?_⟩
          change ((LinearMap.ker d₀_κ).subtype (b_κ.repr.symm (b_κ.repr ⟨x, hx⟩))) = x
          rw [LinearEquiv.symm_apply_apply]
          rfl
        · rintro ⟨w, rfl⟩
          exact (b_κ.repr.symm w).2
      have hEx0_Ω : Function.Exact ⇑(LinearMap.baseChange Ω j_κ) ⇑(LinearMap.baseChange Ω d₀_κ) := by
        rw [hBaseEqLTensor j_κ, hBaseEqLTensor d₀_κ]
        exact Module.Flat.lTensor_exact Ω hEx0_κ
      let j₀ : TensorProduct κ Ω (ι →₀ κ) →ₗ[Ω] TensorProduct R Ω (K 0) :=
        (A 0).toLinearMap.comp (LinearMap.baseChange Ω j_κ)
      have hInj_j₀ : Function.Injective j₀ := (A 0).injective.comp hInj_lT
      have hRange_j₀ : LinearMap.range j₀ = LinearMap.ker (LinearMap.baseChange Ω (d_K 0)) := by
        ext y
        simp only [LinearMap.mem_range, LinearMap.mem_ker, j₀, LinearMap.comp_apply,
          LinearEquiv.coe_coe]
        constructor
        · rintro ⟨w, rfl⟩
          rw [← hIntertwine 0]
          have hz0 : LinearMap.baseChange Ω d₀_κ (LinearMap.baseChange Ω j_κ w) = 0 :=
            (hEx0_Ω _).mpr ⟨w, rfl⟩
          rw [hz0, map_zero]
        · intro hy
          have hz0 : LinearMap.baseChange Ω d₀_κ ((A 0).symm y) = 0 := by
            apply (A 1).injective
            rw [map_zero, hIntertwine 0, LinearEquiv.apply_symm_apply, hy]
          obtain ⟨w, hw⟩ := (hEx0_Ω ((A 0).symm y)).mp hz0
          refine ⟨w, ?_⟩
          rw [hw, LinearEquiv.apply_symm_apply]
      let E₀ : TensorProduct κ Ω (ι →₀ κ) ≃ₗ[Ω]
          ↥(LinearMap.ker (LinearMap.baseChange Ω (d_K 0))) :=
        (LinearEquiv.ofInjective j₀ hInj_j₀).trans (LinearEquiv.ofEq _ _ hRange_j₀)
      let b_std : Module.Basis ι κ (ι →₀ κ) := Finsupp.basisSingleOne
      let b₁ := (b_std.baseChange Ω).map (E₀.trans e_Ω.symm)
      let b₂ := Pi.basisFun Ω (Fin (r₀ + 1))
      let e_ι := Module.Basis.indexEquiv b₁ b₂
      exact ⟨((b_κ.reindex e_ι).equivFun).symm⟩
  obtain ⟨hBridge, hPull⟩ :=
    weil_affine_pullback_cech_baseChange_and_section_bridge R C g hProp M hAffM d hSmul hDiff
  refine ⟨instMod, d, hSmul, hDiff, hd2, hBound, hFlatK, hBridge, ?_⟩
  intro q
  let κ : Type u := q.asIdeal.ResidueField
  let Ω : Type u := AlgebraicClosure κ
  let s_Ω := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R Ω))
  obtain ⟨M_Ω, hPb_Ω, hAff_MΩ, hVan_trans, hDim_trans⟩ := hPull Ω
  have hFib_Ω : HasFiberTricanonicalProperties (CategoryTheory.Limits.pullback.snd g s_Ω) M_Ω :=
    hFib Ω s_Ω M_Ω hPb_Ω
  have hProp_Ω : AlgebraicGeometry.IsProper (CategoryTheory.Limits.pullback.snd g s_Ω) := by
    have : AlgebraicGeometry.IsProper g := hProp
    infer_instance
  have hVan_Ω : ∀ p : ℕ,
      LinearMap.ker (LinearMap.baseChange Ω (d (p + 1))) ≤
        LinearMap.range (LinearMap.baseChange Ω (d p)) :=
    hVan_trans fun p z hz =>
      weil_twoChart_fiber_tricanonical_cech_vanishing
        (fun Y _ N hN => weil_isAffine_twisted_cech_higher_cohomology_vanishing Y N hN)
        Ω (CategoryTheory.Limits.pullback g s_Ω) (CategoryTheory.Limits.pullback.snd g s_Ω)
        hProp_Ω M_Ω hAff_MΩ hFib_Ω p z hz
  obtain ⟨r₀, hr₀, e, he_sec, he_bas, _⟩ := hFib_Ω.2.2
  have hDim_Ω : Nonempty
      ((Fin (r₀ + 1) → Ω) ≃ₗ[Ω] ↥(LinearMap.ker (LinearMap.baseChange Ω (d 0)))) :=
    hDim_trans r₀ e he_sec he_bas
  obtain ⟨hVan_κ, hDim_κ⟩ :=
    hFieldDescent (WeilTricanonicalCechCochain M) d hd2 κ Ω r₀ hVan_Ω hDim_Ω
  exact ⟨r₀, hr₀, hVan_κ, hDim_κ⟩

theorem weil_noetherian_integral_proper_chow_modification (R : Type u) [CommRing R] [IsNoetherianRing R]
    (Z : AlgebraicGeometry.Scheme.{u})
    (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hIntZ : AlgebraicGeometry.IsIntegral Z)
    (hPropZ : AlgebraicGeometry.IsProper g_Z) :
    ∃ (U_dense : Z.Opens) (N : ℕ) (Z' : AlgebraicGeometry.Scheme.{u})
      (π : Z' ⟶ Z)
      (ι_proj : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) :=
                  MvPolynomial.gradedAlgebra
                Z' ⟶ AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) :=
        MvPolynomial.gradedAlgebra
      Nonempty ↥U_dense ∧
      AlgebraicGeometry.IsAffineOpen U_dense ∧
      AlgebraicGeometry.IsProper π ∧
      CategoryTheory.IsIso (π ∣_ U_dense) ∧
      AlgebraicGeometry.IsClosedImmersion ι_proj ∧
      π ≫ g_Z =
        ι_proj ≫
          AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0))) :=
by
  have _ := ‹IsNoetherianRing R›
  have hPart12 : Z.IsSeparated ∧
      ∃ (r : ℕ) (_ : 0 < r)
        (U : Fin r → Z.Opens)
        (_ : ⨆ j : Fin r, U j = ⊤)
        (_ : ∀ j : Fin r, AlgebraicGeometry.IsAffineOpen (U j))
        (n : Fin r → ℕ)
        (f : ∀ j : Fin r, Fin (n j) → ↑(Z.presheaf.obj (Opposite.op (U j))))
        (_ : ∀ j : Fin r, Function.Surjective (MvPolynomial.eval₂Hom
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE g_Z ⊤ (U j) le_top).hom) (f j)))
        (U_dense : Z.Opens)
        (hU_le : ∀ j : Fin r, U_dense ≤ U j)
        (_ : Nonempty ↥U_dense)
        (_ : AlgebraicGeometry.IsAffineOpen U_dense)
        (N : ℕ)
        (Φ : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) :=
               MvPolynomial.gradedAlgebra
             U_dense.toScheme ⟶
               AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)),
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) :=
          MvPolynomial.gradedAlgebra
        let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
        ∃ (D : Fin (N + 1) → (AlgebraicGeometry.Proj 𝒜).Opens)
          (z : Fin (N + 1) → ∀ (γ : Fin (N + 1)),
            ↑((AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op (D γ))))
          (IsZeroAt : Fin r → Fin (N + 1) → Prop),
          (Φ ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0))) =
              U_dense.ι ≫ g_Z) ∧
          (⨆ γ : Fin (N + 1), D γ = ⊤) ∧
          (∀ γ : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D γ)) ∧
          (∀ β γ : Fin (N + 1), (AlgebraicGeometry.Proj 𝒜).basicOpen (z β γ) ≤ D β) ∧
          (∀ (j₀ : Fin r) (γ : Fin (N + 1)),
            ∃ (β : Fin (N + 1)) (u : ↑(Z.presheaf.obj (Opposite.op (U j₀)))),
              IsZeroAt j₀ β ∧
              ((AlgebraicGeometry.Scheme.Hom.app Φ (D γ)).hom (z β γ)) *
                ((AlgebraicGeometry.Scheme.Hom.appLE U_dense.ι (U j₀)
                  ((TopologicalSpace.Opens.map Φ.base).obj (D γ))
                  (fun x _ => hU_le j₀ x.2)).hom u) = 1) ∧
          (∀ (j : Fin r) (β : Fin (N + 1)),
            IsZeroAt j β →
            ∀ m : Fin (n j),
              ∃ β_m : Fin (N + 1),
                (AlgebraicGeometry.Scheme.Hom.app Φ (D β)).hom (z β_m β) =
                  (AlgebraicGeometry.Scheme.Hom.appLE U_dense.ι (U j)
                    ((TopologicalSpace.Opens.map Φ.base).obj (D β))
                    (fun x _ => hU_le j x.2)).hom (f j m)) := by
    have : AlgebraicGeometry.IsIntegral Z := hIntZ
    have : AlgebraicGeometry.IsProper g_Z := hPropZ
    let S_R := AlgebraicGeometry.Spec (CommRingCat.of R)
    have hSpecNat : ∀ {A B : CommRingCat.{u}} (φ : A ⟶ B),
        (AlgebraicGeometry.Scheme.ΓSpecIso A).inv ≫ (AlgebraicGeometry.Spec.map φ).appTop =
          φ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso B).inv := by
      intro A B φ
      rw [Iso.eq_comp_inv, Category.assoc, AlgebraicGeometry.Scheme.ΓSpecIso_naturality,
        Iso.inv_hom_id_assoc]

    
    have hSepZ : Z.IsSeparated := by
      rw [AlgebraicGeometry.Scheme.isSeparated_iff]
      have hSepSR : S_R.IsSeparated := inferInstance
      rw [AlgebraicGeometry.Scheme.isSeparated_iff] at hSepSR
      have hTerm : CategoryTheory.Limits.terminal.from Z =
          g_Z ≫ CategoryTheory.Limits.terminal.from S_R :=
        CategoryTheory.Limits.terminal.hom_ext _ _
      rw [hTerm]
      exact CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance hSepSR
    have : Z.IsSeparated := hSepZ

    
    have : IrreducibleSpace ↥Z := AlgebraicGeometry.irreducibleSpace_of_isIntegral Z
    have hNonemptyZ : Nonempty ↥Z := IrreducibleSpace.toNonempty
    have : CompactSpace ↥Z := AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace g_Z
    have hAff_at : ∀ z : ↥Z, ∃ W : Z.Opens, AlgebraicGeometry.IsAffineOpen W ∧ z ∈ W := by
      intro z
      obtain ⟨W, hW, hzW, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤) trivial
      exact ⟨W, hW, hzW⟩
    choose W_z hAffWz hzWz using hAff_at
    obtain ⟨s, hs_cov⟩ := isCompact_univ.elim_finite_subcover
      (fun z : ↥Z => (W_z z : Set ↥Z))
      (fun z => (W_z z).isOpen)
      (fun z _ => Set.mem_iUnion.mpr ⟨z, hzWz z⟩)
    let r : ℕ := s.card
    let e_s : ↥s ≃ Fin r := s.equivFin
    let U : Fin r → Z.Opens := fun j => W_z (e_s.symm j).1
    have hAffU : ∀ j : Fin r, AlgebraicGeometry.IsAffineOpen (U j) :=
      fun j => hAffWz (e_s.symm j).1
    have hNonU : ∀ j : Fin r, Nonempty ↥(U j) :=
      fun j => ⟨⟨(e_s.symm j).1, hzWz (e_s.symm j).1⟩⟩
    have hCovU : ⨆ j : Fin r, U j = ⊤ := by
      apply le_antisymm le_top
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hx := hs_cov (Set.mem_univ x)
      rw [Set.mem_iUnion₂] at hx
      obtain ⟨z, hzs, hxz⟩ := hx
      exact ⟨e_s ⟨z, hzs⟩, by simpa [U] using hxz⟩
    have hr : 0 < r := by
      obtain ⟨z₀⟩ := hNonemptyZ
      have hz₀ : z₀ ∈ (⊤ : Z.Opens) := trivial
      rw [← hCovU, TopologicalSpace.Opens.mem_iSup] at hz₀
      obtain ⟨j₀, -⟩ := hz₀
      exact Fin.pos j₀

    
    have hGen_ex : ∀ j : Fin r, ∃ (n_j : ℕ)
        (f_j : Fin n_j → ↑(Z.presheaf.obj (Opposite.op (U j)))),
        Function.Surjective (MvPolynomial.eval₂Hom
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE g_Z ⊤ (U j) le_top).hom) f_j) := by
      intro j
      have hFT_mor : (g_Z.appLE ⊤ (U j) le_top).hom.FiniteType :=
        g_Z.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top S_R) (hAffU j) le_top
      let κ_j : R →+* ↑(Z.presheaf.obj (Opposite.op (U j))) :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
          g_Z.appLE ⊤ (U j) le_top).hom)
      have hSurj_iso : Function.Surjective
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).symm.commRingCatIsoToRingEquiv.surjective
      have hFT_iso : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom.FiniteType :=
        RingHom.FiniteType.of_surjective _ hSurj_iso
      have hFT_κ : κ_j.FiniteType := hFT_mor.comp hFT_iso
      let _ : Algebra R ↑(Z.presheaf.obj (Opposite.op (U j))) := κ_j.toAlgebra
      have hAlgFT : Algebra.FiniteType R ↑(Z.presheaf.obj (Opposite.op (U j))) := hFT_κ
      obtain ⟨n_j, ψ_j, hSurj_ψ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hAlgFT
      refine ⟨n_j, fun m => ψ_j (MvPolynomial.X m), ?_⟩
      have hEq_hom : ψ_j.toRingHom = MvPolynomial.eval₂Hom κ_j (fun m => ψ_j (MvPolynomial.X m)) := by
        apply MvPolynomial.ringHom_ext'
        · ext c
          change ψ_j (MvPolynomial.C c) =
            MvPolynomial.eval₂Hom κ_j (fun m => ψ_j (MvPolynomial.X m)) (MvPolynomial.C c)
          rw [MvPolynomial.eval₂Hom_C]
          exact ψ_j.commutes c
        · intro m
          simp
      rw [← hEq_hom]
      exact hSurj_ψ
    choose n f hGen using hGen_ex

    
    let U_dense : Z.Opens := ⨅ j : Fin r, U j
    have hU_le : ∀ j : Fin r, U_dense ≤ U j := fun j => iInf_le U j
    have hInf_prop : ∀ (m : ℕ) (V : Fin (m + 1) → Z.Opens),
        (∀ j, Nonempty ↥(V j)) → (∀ j, AlgebraicGeometry.IsAffineOpen (V j)) →
        Nonempty ↥(⨅ j : Fin (m + 1), V j) ∧
          AlgebraicGeometry.IsAffineOpen (⨅ j : Fin (m + 1), V j) := by
      intro m
      induction m with
      | zero =>
        intro V hV_ne hV_aff
        have hEq : (⨅ j : Fin 1, V j) = V 0 := ciInf_unique
        rw [hEq]
        exact ⟨hV_ne 0, hV_aff 0⟩
      | succ m ih =>
        intro V hV_ne hV_aff
        let V_rest : Z.Opens := ⨅ j : Fin (m + 1), V j.succ
        have hEq : (⨅ j : Fin (m + 2), V j) = V 0 ⊓ V_rest := by
          refine le_antisymm (le_inf (iInf_le V 0) (le_iInf fun j => iInf_le V j.succ)) ?_
          exact le_iInf (Fin.cases inf_le_left fun j => inf_le_right.trans (iInf_le _ j))
        rw [hEq]
        obtain ⟨hNe_rest, hAff_rest⟩ :=
          ih (fun j => V j.succ) (fun j => hV_ne j.succ) (fun j => hV_aff j.succ)
        obtain ⟨⟨x₀, hx₀⟩⟩ := hV_ne 0
        obtain ⟨⟨x₁, hx₁⟩⟩ := hNe_rest
        have hx₁' : x₁ ∈ (V_rest : Set ↥Z) := hx₁
        obtain ⟨y, -, hy₀, hy₁⟩ :=
          (@PreirreducibleSpace.isPreirreducible_univ ↥Z _ _)
            (V 0 : Set ↥Z) (V_rest : Set ↥Z)
            (V 0).isOpen V_rest.isOpen
            ⟨x₀, trivial, hx₀⟩ ⟨x₁, trivial, hx₁'⟩
        exact ⟨⟨⟨y, hy₀, hy₁⟩⟩, (hV_aff 0).inf hAff_rest⟩
    obtain ⟨m_r, hm_r⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hr)
    have hInf_congr : U_dense = ⨅ j : Fin (m_r + 1), U ((finCongr hm_r.symm) j) :=
      ((finCongr hm_r.symm).iInf_congr fun _ => rfl).symm
    obtain ⟨hU_nonempty, hAffU_dense⟩ :
        Nonempty ↥U_dense ∧ AlgebraicGeometry.IsAffineOpen U_dense := by
      rw [hInf_congr]
      exact hInf_prop m_r (fun j => U ((finCongr hm_r.symm) j))
        (fun j => hNonU _) (fun j => hAffU _)

    
    classical
    let f_tilde : ∀ j : Fin r, Fin (n j + 1) → ↑(Z.presheaf.obj (Opposite.op (U j))) :=
      fun j => Fin.cases 1 (f j)
    let M_prod : ℕ := ∏ j : Fin r, (n j + 1)
    have hM_pos : 1 ≤ M_prod := Finset.one_le_prod fun j _ => Nat.succ_pos (n j)
    let N : ℕ := M_prod - 1
    have hNM : N + 1 = M_prod := Nat.sub_add_cancel hM_pos
    have hCard : N + 1 = Fintype.card (∀ j : Fin r, Fin (n j + 1)) := by
      rw [hNM, Fintype.card_pi]
      simp [M_prod]
    let e : Fin (N + 1) ≃ (∀ j : Fin r, Fin (n j + 1)) :=
      (finCongr hCard).trans (Fintype.equivFin (∀ j : Fin r, Fin (n j + 1))).symm
    let IsZeroAt : Fin r → Fin (N + 1) → Prop := fun j β => (e β) j = 0
    let i₀ : Fin (N + 1) := e.symm (fun _ => 0)
    let R_U0 : CommRingCat.{u} := U_dense.toScheme.presheaf.obj (Opposite.op ⊤)
    let ρ : ∀ j : Fin r, ↑(Z.presheaf.obj (Opposite.op (U j))) →+* ↑R_U0 :=
      fun j => (U_dense.ι.appLE (U j) ⊤ (fun x _ => hU_le j x.2)).hom
    let κ₀ : R →+* ↑R_U0 :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
        (U_dense.ι ≫ g_Z).appTop).hom)
    let g_sec : Fin (N + 1) → ↑R_U0 :=
      fun i => ∏ j : Fin r, ρ j (f_tilde j ((e i) j))
    have hg_i₀ : g_sec i₀ = 1 := by
      simp only [g_sec, i₀, Equiv.apply_symm_apply, f_tilde, Fin.cases_zero, map_one,
        Finset.prod_const_one]

    
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let X_var : Fin (N + 1) → MvPolynomial (Fin (N + 1)) R := MvPolynomial.X
    have hX : ∀ α : Fin (N + 1), X_var α ∈ 𝒜 1 :=
      fun α => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R α)
    let ψ : MvPolynomial (Fin (N + 1)) R →+* ↑R_U0 := MvPolynomial.eval₂Hom κ₀ g_sec
    have hUnit₀ : IsUnit (ψ (X_var i₀)) := by
      change IsUnit (MvPolynomial.eval₂Hom κ₀ g_sec (MvPolynomial.X i₀))
      rw [MvPolynomial.eval₂Hom_X', hg_i₀]
      exact isUnit_one
    let valRingHom : HomogeneousLocalization.Away 𝒜 (X_var i₀) →+* Localization.Away (X_var i₀) :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }
    let φ₀ : HomogeneousLocalization.Away 𝒜 (X_var i₀) →+* ↑R_U0 :=
      (IsLocalization.Away.lift (X_var i₀) hUnit₀).comp valRingHom
    let φ₀_mor : CommRingCat.of (HomogeneousLocalization.Away 𝒜 (X_var i₀)) ⟶ R_U0 :=
      CommRingCat.ofHom φ₀
    let Φ_aff : U_dense.toScheme ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (X_var i₀))) :=
      U_dense.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map φ₀_mor
    let away_i₀ := AlgebraicGeometry.Proj.awayι 𝒜 (X_var i₀) (hX i₀) zero_lt_one
    let Φ : U_dense.toScheme ⟶ AlgebraicGeometry.Proj 𝒜 := Φ_aff ≫ away_i₀
    have hΦ : Φ ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0))) =
          U_dense.ι ≫ g_Z := by
      have hRing_Φ :
          (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)) ≫
            CommRingCat.ofHom
              (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (X_var i₀))) ≫
            φ₀_mor) =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
            (U_dense.ι ≫ g_Z).appTop := by
        ext c
        change (IsLocalization.Away.lift (X_var i₀) hUnit₀)
          (((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (X_var i₀)))
            (algebraMap R ↥(𝒜 0) c)).val) = κ₀ c
        have h_coe : (algebraMap R ↥(𝒜 0) c).1 = MvPolynomial.C c := by
          rw [Algebra.algebraMap_eq_smul_one]
          change c • (1 : MvPolynomial (Fin (N + 1)) R) = MvPolynomial.C c
          rw [Algebra.smul_def, mul_one]
          rfl
        have hval_c : ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (X_var i₀)))
            (algebraMap R ↥(𝒜 0) c)).val =
            algebraMap (MvPolynomial (Fin (N + 1)) R) (Localization.Away (X_var i₀))
              (MvPolynomial.C c) := by
          change (HomogeneousLocalization.mk
            { deg := 0
              num := algebraMap R ↥(𝒜 0) c
              den := ⟨1, SetLike.GradedOne.one_mem⟩
              den_mem := Submonoid.one_mem (Submonoid.powers (X_var i₀)) } :
            HomogeneousLocalization.Away 𝒜 (X_var i₀)).val = _
          rw [HomogeneousLocalization.val_mk]
          dsimp only
          rw [h_coe]
          exact @Localization.mk_one_eq_algebraMap (MvPolynomial (Fin (N + 1)) R) _
            (Submonoid.powers (X_var i₀)) (MvPolynomial.C c)
        rw [hval_c, IsLocalization.Away.lift_eq]
        exact MvPolynomial.eval₂Hom_C κ₀ g_sec c
      calc Φ ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))
          = U_dense.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map φ₀_mor ≫
              (away_i₀ ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))) := by
              dsimp only [Φ, Φ_aff]
              simp only [Category.assoc]
        _ = U_dense.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map φ₀_mor ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (X_var i₀)))) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0))) := by
              rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc]
        _ = U_dense.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)) ≫
                CommRingCat.ofHom
                  (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (X_var i₀))) ≫
                φ₀_mor) := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
                Category.assoc]
        _ = U_dense.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
                (U_dense.ι ≫ g_Z).appTop) := by
              rw [hRing_Φ]
        _ = (U_dense.ι ≫ g_Z) ≫ S_R.toSpecΓ ≫
              AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv := by
              rw [AlgebraicGeometry.Spec.map_comp,
                ← AlgebraicGeometry.Scheme.toSpecΓ_naturality_assoc]
        _ = U_dense.ι ≫ g_Z := by
              rw [AlgebraicGeometry.toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]

    
    let D : Fin (N + 1) → (AlgebraicGeometry.Proj 𝒜).Opens :=
      fun γ => AlgebraicGeometry.Proj.basicOpen 𝒜 (X_var γ)
    have hAffD : ∀ γ : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D γ) :=
      fun γ => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (X_var γ) (hX γ) zero_lt_one
    have hCovD : ⨆ γ : Fin (N + 1), D γ = ⊤ := by
      apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 X_var
      · intro γ
        exact ⟨1, hX γ⟩
      · suffices ∀ p : MvPolynomial (Fin (N + 1)) R,
            p ∈ Algebra.adjoin ↥(𝒜 0) (Set.range X_var) by
          rw [eq_top_iff]
          intro p _
          exact this p
        intro p
        induction p using MvPolynomial.induction_on with
        | C c =>
          have hc : MvPolynomial.C c ∈ 𝒜 0 :=
            (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr
              (MvPolynomial.isHomogeneous_C (Fin (N + 1)) c)
          exact Subalgebra.algebraMap_mem (Algebra.adjoin ↥(𝒜 0) (Set.range X_var))
            (⟨MvPolynomial.C c, hc⟩ : ↥(𝒜 0))
        | add p q hp hq => exact Subalgebra.add_mem _ hp hq
        | mul_X p γ hp =>
          exact Subalgebra.mul_mem _ hp (Algebra.subset_adjoin (Set.mem_range_self γ))

    let R_loc : Fin (N + 1) → CommRingCat.{u} :=
      fun γ => CommRingCat.of (HomogeneousLocalization.Away 𝒜 (X_var γ))
    let R_D : Fin (N + 1) → CommRingCat.{u} :=
      fun γ => (AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op (D γ))
    let iso_D : ∀ γ : Fin (N + 1), (D γ).toScheme ≅ AlgebraicGeometry.Spec (R_loc γ) :=
      fun γ => AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (X_var γ) (hX γ) zero_lt_one
    let e_Spec : ∀ γ : Fin (N + 1),
        AlgebraicGeometry.Spec (R_loc γ) ≅ AlgebraicGeometry.Spec (R_D γ) :=
      fun γ => (iso_D γ).symm ≪≫ (hAffD γ).isoSpec
    let α_hom : ∀ γ : Fin (N + 1), R_loc γ ⟶ R_D γ :=
      fun γ => (AlgebraicGeometry.Scheme.ΓSpecIso (R_loc γ)).inv ≫
        (e_Spec γ).inv.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (R_D γ)).hom
    let α_inv : ∀ γ : Fin (N + 1), R_D γ ⟶ R_loc γ :=
      fun γ => (AlgebraicGeometry.Scheme.ΓSpecIso (R_D γ)).inv ≫
        (e_Spec γ).hom.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (R_loc γ)).hom
    have hα_hom_inv : ∀ γ : Fin (N + 1), α_hom γ ≫ α_inv γ = 𝟙 (R_loc γ) := by
      intro γ
      dsimp only [α_hom, α_inv]
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
      have h_app : (e_Spec γ).inv.appTop ≫ (e_Spec γ).hom.appTop = 𝟙 _ := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, Iso.hom_inv_id]
        rfl
      rw [← Category.assoc ((e_Spec γ).inv.appTop), h_app, Category.id_comp, Iso.inv_hom_id]
    have hSpec_α_inv : ∀ γ : Fin (N + 1),
        AlgebraicGeometry.Spec.map (α_inv γ) = (e_Spec γ).hom := by
      intro γ
      calc AlgebraicGeometry.Spec.map (α_inv γ)
          = ((AlgebraicGeometry.Spec (R_loc γ)).toSpecΓ ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (R_loc γ)).inv) ≫
              AlgebraicGeometry.Spec.map (α_inv γ) := by
              rw [AlgebraicGeometry.toSpecΓ_SpecMap_ΓSpecIso_inv, Category.id_comp]
        _ = (AlgebraicGeometry.Spec (R_loc γ)).toSpecΓ ≫
              AlgebraicGeometry.Spec.map
                ((AlgebraicGeometry.Scheme.ΓSpecIso (R_D γ)).inv ≫ (e_Spec γ).hom.appTop) := by
              rw [Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
              congr 1
              dsimp only [α_inv]
              simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
        _ = (e_Spec γ).hom ≫ (AlgebraicGeometry.Spec (R_D γ)).toSpecΓ ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (R_D γ)).inv := by
              rw [AlgebraicGeometry.Spec.map_comp,
                ← AlgebraicGeometry.Scheme.toSpecΓ_naturality_assoc]
        _ = (e_Spec γ).hom := by
              rw [AlgebraicGeometry.toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
    have hAway_fromSpec : ∀ γ : Fin (N + 1),
        AlgebraicGeometry.Spec.map (α_inv γ) ≫ (hAffD γ).fromSpec =
          AlgebraicGeometry.Proj.awayι 𝒜 (X_var γ) (hX γ) zero_lt_one := by
      intro γ
      rw [hSpec_α_inv γ]
      dsimp only [e_Spec, Iso.trans_hom, Iso.symm_hom, iso_D, D]
      rw [Category.assoc, ← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι,
        Iso.hom_inv_id_assoc, AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]

    let q_elem : Fin (N + 1) → ∀ (γ : Fin (N + 1)), HomogeneousLocalization.Away 𝒜 (X_var γ) :=
      fun β γ => HomogeneousLocalization.Away.isLocalizationElem (hX γ) (hX β)
    let z : Fin (N + 1) → ∀ (γ : Fin (N + 1)),
        ↑((AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op (D γ))) :=
      fun β γ => (α_hom γ).hom (q_elem β γ)
    have hα_inv_z : ∀ β γ : Fin (N + 1), (α_inv γ).hom (z β γ) = q_elem β γ := by
      intro β γ
      change (α_hom γ ≫ α_inv γ).hom (q_elem β γ) = q_elem β γ
      rw [hα_hom_inv γ]
      rfl

    have hz_basic : ∀ β γ : Fin (N + 1), (AlgebraicGeometry.Proj 𝒜).basicOpen (z β γ) ≤ D β := by
      intro β γ y hy
      have hyD : y ∈ D γ := (AlgebraicGeometry.Proj 𝒜).basicOpen_le (z β γ) hy
      let away_γ := AlgebraicGeometry.Proj.awayι 𝒜 (X_var γ) (hX γ) zero_lt_one
      have hy_range : y ∈ away_γ.opensRange := by
        rwa [AlgebraicGeometry.Proj.opensRange_awayι]
      obtain ⟨p, rfl⟩ := hy_range
      have hp_pre : p ∈ away_γ ⁻¹ᵁ (AlgebraicGeometry.Proj 𝒜).basicOpen (z β γ) := hy
      have hPre_eq : away_γ ⁻¹ᵁ (AlgebraicGeometry.Proj 𝒜).basicOpen (z β γ) =
          PrimeSpectrum.basicOpen (q_elem β γ) := by
        dsimp only [away_γ]
        rw [← hAway_fromSpec γ]
        change (AlgebraicGeometry.Spec.map (α_inv γ)) ⁻¹ᵁ
          ((hAffD γ).fromSpec ⁻¹ᵁ (AlgebraicGeometry.Proj 𝒜).basicOpen (z β γ)) = _
        rw [AlgebraicGeometry.Scheme.preimage_basicOpen, (hAffD γ).basicOpen_fromSpec_app,
          ← hα_inv_z β γ]
        exact PrimeSpectrum.comap_basicOpen (α_inv γ).hom (z β γ)
      rw [hPre_eq,
        ← AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX γ) zero_lt_one (hX β) zero_lt_one]
        at hp_pre
      exact hp_pre

    
    have hφ₀_q : ∀ β : Fin (N + 1), φ₀ (q_elem β i₀) = g_sec β := by
      intro β
      change (IsLocalization.Away.lift (X_var i₀) hUnit₀) (q_elem β i₀).val = g_sec β
      have hval_q : (q_elem β i₀).val =
          IsLocalization.mk' (Localization.Away (X_var i₀)) (X_var β)
            ⟨X_var i₀, Submonoid.mem_powers (X_var i₀)⟩ := by
        simp only [q_elem, HomogeneousLocalization.Away.isLocalizationElem,
          HomogeneousLocalization.Away.val_mk, pow_one, Localization.mk_eq_mk']
      rw [hval_q]
      apply (IsLocalization.lift_mk'_spec _ (X_var β) (g_sec β)
        ⟨X_var i₀, Submonoid.mem_powers (X_var i₀)⟩).mpr
      change ψ (X_var β) = ψ (X_var i₀) * g_sec β
      have hψ_β : ψ (X_var β) = g_sec β := MvPolynomial.eval₂Hom_X' κ₀ g_sec β
      have hψ_0 : ψ (X_var i₀) = g_sec i₀ := MvPolynomial.eval₂Hom_X' κ₀ g_sec i₀
      rw [hψ_β, hψ_0, hg_i₀, one_mul]

    have hRatio : ∀ (β γ : Fin (N + 1)),
        let W_γ : U_dense.toScheme.Opens := (TopologicalSpace.Opens.map Φ.base).obj (D γ)
        ((AlgebraicGeometry.Scheme.Hom.app Φ (D γ)).hom (z β γ)) *
          ((U_dense.toScheme.presheaf.map (CategoryTheory.homOfLE le_top).op).hom (g_sec γ)) =
          (U_dense.toScheme.presheaf.map (CategoryTheory.homOfLE le_top).op).hom (g_sec β) ∧
        ((AlgebraicGeometry.Scheme.Hom.app Φ (D γ)).hom (z i₀ γ)) *
          ((U_dense.toScheme.presheaf.map (CategoryTheory.homOfLE le_top).op).hom (g_sec γ)) = 1 := by
      intro β γ
      dsimp only
      let W_γ : U_dense.toScheme.Opens := (TopologicalSpace.Opens.map Φ.base).obj (D γ)
      have hX_mul : X_var i₀ * X_var γ ∈ 𝒜 2 :=
        SetLike.GradedMonoid.toGradedMul.mul_mem (hX i₀) (hX γ)
      let R_mul : CommRingCat.{u} :=
        CommRingCat.of (HomogeneousLocalization.Away 𝒜 (X_var i₀ * X_var γ))
      let away_mul := AlgebraicGeometry.Proj.awayι 𝒜 (X_var i₀ * X_var γ) hX_mul (by decide)
      have hRange_γ : Set.range (W_γ.ι ≫ Φ).base ⊆ Set.range away_mul.base := by
        rintro _ ⟨w, rfl⟩
        change (W_γ.ι ≫ Φ).base w ∈ away_mul.opensRange
        rw [AlgebraicGeometry.Proj.opensRange_awayι, AlgebraicGeometry.Proj.basicOpen_mul]
        refine ⟨?_, w.2⟩
        have hw0 : Φ.base w.1 ∈ away_i₀.opensRange := ⟨Φ_aff.base w.1, rfl⟩
        rwa [AlgebraicGeometry.Proj.opensRange_awayι] at hw0
      let ψ_γ : W_γ.toScheme ⟶ AlgebraicGeometry.Spec R_mul :=
        AlgebraicGeometry.IsOpenImmersion.lift away_mul (W_γ.ι ≫ Φ) hRange_γ
      have hψ_fac : ψ_γ ≫ away_mul = W_γ.ι ≫ Φ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac away_mul (W_γ.ι ≫ Φ) hRange_γ
      let am₁ := HomogeneousLocalization.awayMap 𝒜 (hX γ)
        (rfl : X_var i₀ * X_var γ = X_var i₀ * X_var γ)
      let am₂ := HomogeneousLocalization.awayMap 𝒜 (hX i₀)
        (mul_comm (X_var i₀) (X_var γ))
      have h_am₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom am₁) ≫ away_i₀ = away_mul :=
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX i₀) zero_lt_one (hX γ) rfl
      have h_am₂ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom am₂) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 (X_var γ) (hX γ) zero_lt_one = away_mul :=
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX γ) zero_lt_one (hX i₀)
          (mul_comm (X_var i₀) (X_var γ))
      have h_eq₁ : ψ_γ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom am₁) = W_γ.ι ≫ Φ_aff := by
        rw [← cancel_mono away_i₀, Category.assoc, h_am₁, hψ_fac]
        rfl
      let g_map : W_γ.toScheme ⟶ AlgebraicGeometry.Spec (R_D γ) :=
        ψ_γ ≫ AlgebraicGeometry.Spec.map (α_inv γ ≫ CommRingCat.ofHom am₂)
      have h_eq₂ : g_map ≫ (hAffD γ).fromSpec = W_γ.ι ≫ Φ := by
        dsimp only [g_map]
        rw [AlgebraicGeometry.Spec.map_comp, Category.assoc, Category.assoc, hAway_fromSpec γ,
          h_am₂, hψ_fac]
      let θ_γ : R_mul ⟶ U_dense.toScheme.presheaf.obj (Opposite.op W_γ) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso R_mul).inv ≫ ψ_γ.appTop ≫ W_γ.topIso.hom

      have hθ_am₂ : ∀ α_idx : Fin (N + 1),
          θ_γ.hom (am₂ (q_elem α_idx γ)) = (Φ.app (D γ)).hom (z α_idx γ) := by
        intro α_idx
        have h_le1 : (⊤ : W_γ.toScheme.Opens) ≤ (W_γ.ι ≫ Φ) ⁻¹ᵁ D γ := fun x _ => x.2
        have h_le_fs : (⊤ : (AlgebraicGeometry.Spec (R_D γ)).Opens) ≤
            (hAffD γ).fromSpec ⁻¹ᵁ D γ := by
          intro p _
          rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
          exact ((hAffD γ).isoSpec.inv.base p).2
        have h_le2' : (⊤ : W_γ.toScheme.Opens) ≤ g_map ⁻¹ᵁ ((hAffD γ).fromSpec ⁻¹ᵁ D γ) :=
          fun p hp => h_le_fs hp
        have h_le2 : (⊤ : W_γ.toScheme.Opens) ≤ (g_map ≫ (hAffD γ).fromSpec) ⁻¹ᵁ D γ := h_le2'
        have h_appLE_congr : ∀ (k : W_γ.toScheme ⟶ AlgebraicGeometry.Proj 𝒜)
            (hk : k = W_γ.ι ≫ Φ) (ek : (⊤ : W_γ.toScheme.Opens) ≤ k ⁻¹ᵁ D γ),
            k.appLE (D γ) ⊤ ek = (W_γ.ι ≫ Φ).appLE (D γ) ⊤ h_le1 := by
          rintro _ rfl _
          rfl
        have h_both := h_appLE_congr (g_map ≫ (hAffD γ).fromSpec) h_eq₂ h_le2
        have h_rhs : (W_γ.ι ≫ Φ).appLE (D γ) ⊤ h_le1 ≫ W_γ.topIso.hom = Φ.app (D γ) := by
          rw [AlgebraicGeometry.Scheme.Hom.comp_appLE, Category.assoc]
          have h_id : W_γ.ι.appLE W_γ ⊤ (fun x _ => x.2) ≫ W_γ.topIso.hom = 𝟙 _ := by
            simp only [AlgebraicGeometry.Scheme.Opens.topIso_hom,
              AlgebraicGeometry.Scheme.Hom.appLE, AlgebraicGeometry.Scheme.Opens.ι_app]
            refine (Category.assoc _ _ _).trans ?_
            refine (congrArg (_ ≫ ·) (U_dense.toScheme.presheaf.map_comp _ _).symm).trans ?_
            refine (U_dense.toScheme.presheaf.map_comp _ _).symm.trans ?_
            exact (congrArg U_dense.toScheme.presheaf.map (Subsingleton.elim _ _)).trans
              (U_dense.toScheme.presheaf.map_id _)
          exact (congrArg (Φ.app (D γ) ≫ ·) h_id).trans (Category.comp_id _)
        have h_lhs : (g_map ≫ (hAffD γ).fromSpec).appLE (D γ) ⊤ h_le2 =
            (AlgebraicGeometry.Scheme.ΓSpecIso (R_D γ)).inv ≫ g_map.appTop := by
          rw [AlgebraicGeometry.Scheme.Hom.comp_appLE, (hAffD γ).fromSpec_app_self, Category.assoc]
          congr 1
          have h_map := AlgebraicGeometry.Scheme.Hom.map_appLE g_map h_le2'
            (eqToHom (le_antisymm le_top h_le_fs)).op
          refine h_map.trans ?_
          unfold AlgebraicGeometry.Scheme.Hom.appLE AlgebraicGeometry.Scheme.Hom.appTop
          exact (congrArg (g_map.app ⊤ ≫ W_γ.toScheme.presheaf.map ·)
            (Subsingleton.elim _ (𝟙 _))).trans
            ((congrArg (g_map.app ⊤ ≫ ·) (W_γ.toScheme.presheaf.map_id _)).trans
              (Category.comp_id _))
        have h_mor_eq : (AlgebraicGeometry.Scheme.ΓSpecIso (R_D γ)).inv ≫
            g_map.appTop ≫ W_γ.topIso.hom = Φ.app (D γ) := by
          rw [← Category.assoc, ← h_lhs, h_both, h_rhs]
        have h_nat : (AlgebraicGeometry.Scheme.ΓSpecIso (R_D γ)).inv ≫ g_map.appTop =
            α_inv γ ≫ CommRingCat.ofHom am₂ ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso R_mul).inv ≫ ψ_γ.appTop := by
          dsimp only [g_map]
          rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
            ← Category.assoc _ _ ψ_γ.appTop, hSpecNat]
          simp only [Category.assoc]
        have h_eval := congrArg (fun m => m.hom (z α_idx γ)) h_mor_eq
        rw [← Category.assoc, h_nat] at h_eval
        change θ_γ.hom (am₂ ((α_inv γ).hom (z α_idx γ))) =
          (Φ.app (D γ)).hom (z α_idx γ) at h_eval
        rwa [hα_inv_z α_idx γ] at h_eval

      have hθ_am₁ : ∀ α_idx : Fin (N + 1),
          θ_γ.hom (am₁ (q_elem α_idx i₀)) =
            (U_dense.toScheme.presheaf.map (CategoryTheory.homOfLE le_top).op).hom (g_sec α_idx) := by
        intro α_idx
        have h_nat1 : CommRingCat.ofHom am₁ ≫ θ_γ =
            φ₀_mor ≫ W_γ.ι.appTop ≫ W_γ.topIso.hom := by
          dsimp only [θ_γ]
          have h2 : (AlgebraicGeometry.Scheme.ΓSpecIso (R_loc i₀)).inv ≫ Φ_aff.appTop = φ₀_mor := by
            dsimp only [Φ_aff]
            rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
              AlgebraicGeometry.Scheme.toSpecΓ_appTop,
              ← Category.assoc, hSpecNat, Category.assoc, Iso.inv_hom_id, Category.comp_id]
          calc CommRingCat.ofHom am₁ ≫
                ((AlgebraicGeometry.Scheme.ΓSpecIso R_mul).inv ≫ ψ_γ.appTop ≫ W_γ.topIso.hom)
              = (CommRingCat.ofHom am₁ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso R_mul).inv) ≫
                  ψ_γ.appTop ≫ W_γ.topIso.hom := by simp only [Category.assoc]
            _ = (AlgebraicGeometry.Scheme.ΓSpecIso (R_loc i₀)).inv ≫
                  (ψ_γ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom am₁)).appTop ≫
                  W_γ.topIso.hom := by
                  rw [← hSpecNat, Category.assoc,
                    ← AlgebraicGeometry.Scheme.Hom.comp_appTop_assoc]
            _ = ((AlgebraicGeometry.Scheme.ΓSpecIso (R_loc i₀)).inv ≫ Φ_aff.appTop) ≫
                  W_γ.ι.appTop ≫ W_γ.topIso.hom := by
                  rw [h_eq₁, AlgebraicGeometry.Scheme.Hom.comp_appTop_assoc, Category.assoc]
            _ = φ₀_mor ≫ W_γ.ι.appTop ≫ W_γ.topIso.hom := by rw [h2]
        have h_res : W_γ.ι.appTop ≫ W_γ.topIso.hom =
            U_dense.toScheme.presheaf.map (CategoryTheory.homOfLE le_top).op := by
          simp only [AlgebraicGeometry.Scheme.Opens.topIso_hom,
            AlgebraicGeometry.Scheme.Hom.appTop, AlgebraicGeometry.Scheme.Opens.ι_app]
          exact (U_dense.toScheme.presheaf.map_comp _ _).symm.trans
            (congrArg U_dense.toScheme.presheaf.map (Subsingleton.elim _ _))
        rw [h_res] at h_nat1
        have h_eval := congrArg (fun m => m.hom (q_elem α_idx i₀)) h_nat1
        change θ_γ.hom (am₁ (q_elem α_idx i₀)) =
          (U_dense.toScheme.presheaf.map (CategoryTheory.homOfLE le_top).op).hom
            (φ₀ (q_elem α_idx i₀)) at h_eval
        rwa [hφ₀_q α_idx] at h_eval

      have hAlg1 : am₂ (q_elem β γ) * am₁ (q_elem γ i₀) = am₁ (q_elem β i₀) := by
        dsimp only [q_elem, am₁, am₂]
        rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_mul]
        simp only [HomogeneousLocalization.Away.isLocalizationElem,
          HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
          pow_one, Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        exact ⟨1, by simp; ring⟩
      have hAlg2 : am₂ (q_elem i₀ γ) * am₁ (q_elem γ i₀) = 1 := by
        dsimp only [q_elem, am₁, am₂]
        rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_mul,
          HomogeneousLocalization.val_one]
        simp only [HomogeneousLocalization.Away.isLocalizationElem,
          HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
          pow_one, Localization.mk_mul, ← Localization.mk_one,
          Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        exact ⟨1, by simp; ring⟩
      constructor
      · rw [← hθ_am₂ β, ← hθ_am₁ γ, ← hθ_am₁ β, ← map_mul, hAlg1]
      · rw [← hθ_am₂ i₀, ← hθ_am₁ γ, ← map_mul, hAlg2, map_one]

    have hRingShift : ∀ {S_r : Type u} [CommRing S_r] (a b c d e_v : S_r),
        a * d = e_v → c * d = 1 → e_v * b = d → a * b = 1 := by
      intro S_r _ a b c d e_v h1 h2 h3
      calc a * b = a * b * (c * d) := by rw [h2, mul_one]
        _ = (a * d * b) * c := by ring
        _ = d * c := by rw [h1, h3]
        _ = c * d := mul_comm _ _
        _ = 1 := h2

    have hRingRecov : ∀ {S_r : Type u} [CommRing S_r] (a b c d e_v : S_r),
        a * d = e_v → c * d = 1 → e_v = d * b → a = b := by
      intro S_r _ a b c d e_v h1 h2 h3
      calc a = a * (c * d) := by rw [h2, mul_one]
        _ = (a * d) * c := by ring
        _ = (d * b) * c := by rw [h1, h3]
        _ = b * (c * d) := by ring
        _ = b := by rw [h2, mul_one]

    have hShift : ∀ (j₀ : Fin r) (γ : Fin (N + 1)),
        ∃ (β : Fin (N + 1)) (u : ↑(Z.presheaf.obj (Opposite.op (U j₀)))),
          IsZeroAt j₀ β ∧
          ((AlgebraicGeometry.Scheme.Hom.app Φ (D γ)).hom (z β γ)) *
            ((AlgebraicGeometry.Scheme.Hom.appLE U_dense.ι (U j₀)
              ((TopologicalSpace.Opens.map Φ.base).obj (D γ))
              (fun x _ => hU_le j₀ x.2)).hom u) = 1 := by
      intro j₀ γ
      let β : Fin (N + 1) := e.symm (Function.update (e γ) j₀ 0)
      let u : ↑(Z.presheaf.obj (Opposite.op (U j₀))) := f_tilde j₀ ((e γ) j₀)
      have hZβ : IsZeroAt j₀ β := by
        simp [IsZeroAt, β]
      refine ⟨β, u, hZβ, ?_⟩
      have hg_rel : g_sec β * ρ j₀ u = g_sec γ := by
        dsimp only [g_sec, u]
        rw [← Finset.prod_erase_mul Finset.univ _ (Finset.mem_univ j₀),
          ← Finset.prod_erase_mul Finset.univ (fun j => ρ j (f_tilde j ((e γ) j)))
            (Finset.mem_univ j₀)]
        have h_eq_erase : ∏ x ∈ Finset.univ.erase j₀, ρ x (f_tilde x ((e β) x)) =
            ∏ x ∈ Finset.univ.erase j₀, ρ x (f_tilde x ((e γ) x)) := by
          refine Finset.prod_congr rfl fun x hx => ?_
          have hne : x ≠ j₀ := Finset.ne_of_mem_erase hx
          simp [β, hne]
        have h_at_j₀ : ρ j₀ (f_tilde j₀ ((e β) j₀)) = 1 := by
          simp [β, f_tilde]
        rw [h_eq_erase, h_at_j₀, mul_one]
      let W_γ : U_dense.toScheme.Opens := (TopologicalSpace.Opens.map Φ.base).obj (D γ)
      let res_W := (U_dense.toScheme.presheaf.map (CategoryTheory.homOfLE (le_top : W_γ ≤ ⊤)).op).hom
      have h_res_u : res_W (ρ j₀ u) =
          (AlgebraicGeometry.Scheme.Hom.appLE U_dense.ι (U j₀) W_γ
            (fun x _ => hU_le j₀ x.2)).hom u := by
        dsimp only [res_W, ρ]
        have h_mor : U_dense.ι.appLE (U j₀) ⊤ (fun x _ => hU_le j₀ x.2) ≫
            U_dense.toScheme.presheaf.map (CategoryTheory.homOfLE (le_top : W_γ ≤ ⊤)).op =
            U_dense.ι.appLE (U j₀) W_γ (fun x _ => hU_le j₀ x.2) := by
          unfold AlgebraicGeometry.Scheme.Hom.appLE
          rw [Category.assoc, ← Functor.map_comp]
          rfl
        exact congrArg (fun m => m.hom u) h_mor
      obtain ⟨hR1, hR2⟩ := hRatio β γ
      rw [← h_res_u]
      exact hRingShift _ _ _ _ _ hR1 hR2 (by rw [← map_mul, hg_rel])

    have hRecov : ∀ (j : Fin r) (β : Fin (N + 1)),
        IsZeroAt j β →
        ∀ m : Fin (n j),
          ∃ β_m : Fin (N + 1),
            (AlgebraicGeometry.Scheme.Hom.app Φ (D β)).hom (z β_m β) =
              (AlgebraicGeometry.Scheme.Hom.appLE U_dense.ι (U j)
                ((TopologicalSpace.Opens.map Φ.base).obj (D β))
                (fun x _ => hU_le j x.2)).hom (f j m) := by
      intro j β hZβ m
      let β_m : Fin (N + 1) := e.symm (Function.update (e β) j m.succ)
      refine ⟨β_m, ?_⟩
      have hg_rel : g_sec β_m = g_sec β * ρ j (f j m) := by
        dsimp only [g_sec]
        rw [← Finset.prod_erase_mul Finset.univ _ (Finset.mem_univ j),
          ← Finset.prod_erase_mul Finset.univ (fun k => ρ k (f_tilde k ((e β) k)))
            (Finset.mem_univ j)]
        have h_eq_erase : ∏ k ∈ Finset.univ.erase j, ρ k (f_tilde k ((e β_m) k)) =
            ∏ k ∈ Finset.univ.erase j, ρ k (f_tilde k ((e β) k)) := by
          refine Finset.prod_congr rfl fun k hk => ?_
          have hne : k ≠ j := Finset.ne_of_mem_erase hk
          simp [β_m, hne]
        have h_at_j_m : ρ j (f_tilde j ((e β_m) j)) = ρ j (f j m) := by
          simp [β_m, f_tilde]
        have h_at_j_0 : ρ j (f_tilde j ((e β) j)) = 1 := by
          have h0 : (e β) j = 0 := hZβ
          simp [h0, f_tilde]
        rw [h_eq_erase, h_at_j_m, h_at_j_0, mul_one]
      let W_β : U_dense.toScheme.Opens := (TopologicalSpace.Opens.map Φ.base).obj (D β)
      let res_W := (U_dense.toScheme.presheaf.map (CategoryTheory.homOfLE (le_top : W_β ≤ ⊤)).op).hom
      have h_res_f : res_W (ρ j (f j m)) =
          (AlgebraicGeometry.Scheme.Hom.appLE U_dense.ι (U j) W_β
            (fun x _ => hU_le j x.2)).hom (f j m) := by
        dsimp only [res_W, ρ]
        have h_mor : U_dense.ι.appLE (U j) ⊤ (fun x _ => hU_le j x.2) ≫
            U_dense.toScheme.presheaf.map (CategoryTheory.homOfLE (le_top : W_β ≤ ⊤)).op =
            U_dense.ι.appLE (U j) W_β (fun x _ => hU_le j x.2) := by
          unfold AlgebraicGeometry.Scheme.Hom.appLE
          rw [Category.assoc, ← Functor.map_comp]
          rfl
        exact congrArg (fun m_hom => m_hom.hom (f j m)) h_mor
      obtain ⟨hR1, hR2⟩ := hRatio β_m β
      rw [← h_res_f]
      exact hRingRecov _ _ _ _ _ hR1 hR2 (by rw [hg_rel, map_mul])

    exact ⟨hSepZ, r, hr, U, hCovU, hAffU, n, f, hGen, U_dense, hU_le, hU_nonempty, hAffU_dense,
      N, Φ, D, z, IsZeroAt, hΦ, hCovD, hAffD, hz_basic, hShift, hRecov⟩

  obtain ⟨hSepZ, r, _hr, U, hCovU, hAffU, n, f, hGen, U_dense, hU_le, hU_nonempty, hAffU_dense,
    N, Φ, D, z, IsZeroAt, hΦ, hCovD, hAffD, hz_basic, hShift, hRecov⟩ := hPart12

  have hPart34 : ∃ (Z' : AlgebraicGeometry.Scheme.{u})
      (π : Z' ⟶ Z)
      (ι_proj : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) :=
                  MvPolynomial.gradedAlgebra
                Z' ⟶ AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) :=
        MvPolynomial.gradedAlgebra
      AlgebraicGeometry.IsProper π ∧
      CategoryTheory.IsIso (π ∣_ U_dense) ∧
      AlgebraicGeometry.IsClosedImmersion ι_proj ∧
      π ≫ g_Z =
        ι_proj ≫
          AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0))) := by
    have : AlgebraicGeometry.IsIntegral Z := hIntZ
    have : AlgebraicGeometry.IsProper g_Z := hPropZ
    have : Z.IsSeparated := hSepZ
    let S_R := AlgebraicGeometry.Spec (CommRingCat.of R)
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let π_Proj : AlgebraicGeometry.Proj 𝒜 ⟶ S_R :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))

    have hSpecNat : ∀ {A B : CommRingCat.{u}} (φ : A ⟶ B),
        (AlgebraicGeometry.Scheme.ΓSpecIso A).inv ≫ (AlgebraicGeometry.Spec.map φ).appTop =
          φ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso B).inv := by
      intro A B φ
      rw [Iso.eq_comp_inv, Category.assoc, AlgebraicGeometry.Scheme.ΓSpecIso_naturality,
        Iso.inv_hom_id_assoc]

    have hCompAppLE : ∀ {X_1 X_2 X_3 : AlgebraicGeometry.Scheme.{u}}
        (f_1 : X_1 ⟶ X_2) (f_2 : X_2 ⟶ X_3)
        (U_3 : X_3.Opens) (U_2 : X_2.Opens) (U_1 : X_1.Opens)
        (e_2 : U_2 ≤ f_2 ⁻¹ᵁ U_3) (e_1 : U_1 ≤ f_1 ⁻¹ᵁ U_2)
        (e_13 : U_1 ≤ (f_1 ≫ f_2) ⁻¹ᵁ U_3),
        f_2.appLE U_3 U_2 e_2 ≫ f_1.appLE U_2 U_1 e_1 = (f_1 ≫ f_2).appLE U_3 U_1 e_13 := by
      intro X_1 X_2 X_3 f_1 f_2 U_3 U_2 U_1 e_2 e_1 e_13
      have e_13' : U_1 ≤ f_1 ⁻¹ᵁ (f_2 ⁻¹ᵁ U_3) := e_13
      have h_lhs : f_2.appLE U_3 U_2 e_2 ≫ f_1.appLE U_2 U_1 e_1 =
          f_2.app U_3 ≫ f_1.app (f_2 ⁻¹ᵁ U_3) ≫
            X_1.presheaf.map (CategoryTheory.homOfLE e_13').op := by
        unfold AlgebraicGeometry.Scheme.Hom.appLE
        rw [Category.assoc, ← Category.assoc (X_2.presheaf.map _), f_1.naturality,
          Category.assoc]
        congr 2
        exact (X_1.presheaf.map_comp _ _).symm.trans
          (congrArg X_1.presheaf.map (Subsingleton.elim _ _))
      exact h_lhs.trans (by rfl)

    have hCongrAppLE : ∀ {X_1 X_2 : AlgebraicGeometry.Scheme.{u}}
        {f_1 f_2 : X_1 ⟶ X_2} (h_eq : f_1 = f_2)
        (U_2 : X_2.Opens) (U_1 : X_1.Opens)
        (e_1 : U_1 ≤ f_1 ⁻¹ᵁ U_2) (e_2 : U_1 ≤ f_2 ⁻¹ᵁ U_2),
        f_1.appLE U_2 U_1 e_1 = f_2.appLE U_2 U_1 e_2 := by
      rintro _ _ _ _ rfl _ _ _ _
      rfl

    
    have hPropProj : AlgebraicGeometry.IsProper π_Proj := by
      have hBij_alg : Function.Bijective (algebraMap R ↥(𝒜 0)) := by
        have hC_coe : ∀ c : R, (algebraMap R ↥(𝒜 0) c).1 = MvPolynomial.C c := by
          intro c
          rw [Algebra.algebraMap_eq_smul_one]
          change c • (1 : MvPolynomial (Fin (N + 1)) R) = MvPolynomial.C c
          rw [Algebra.smul_def, mul_one]
          rfl
        constructor
        · intro c₁ c₂ hEq
          have hEq1 : (algebraMap R ↥(𝒜 0) c₁).1 = (algebraMap R ↥(𝒜 0) c₂).1 :=
            congrArg Subtype.val hEq
          rw [hC_coe, hC_coe] at hEq1
          simpa using congrArg MvPolynomial.constantCoeff hEq1
        · intro y
          refine ⟨MvPolynomial.constantCoeff y.1, Subtype.ext ?_⟩
          rw [hC_coe]
          ext m
          rw [MvPolynomial.coeff_C]
          split_ifs with hm
          · subst hm; rfl
          · symm
            by_contra hne
            have hy0 : y.1.IsHomogeneous 0 := y.2
            have hdeg := hy0 hne
            simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, Pi.one_apply,
              mul_one] at hdeg
            apply hm
            symm
            ext i
            by_cases hi : i ∈ m.support
            · exact Nat.eq_zero_of_le_zero
                (hdeg ▸ Finset.single_le_sum (fun _ _ => Nat.zero_le _) hi)
            · exact Finsupp.notMem_support_iff.mp hi
      have _ : CategoryTheory.IsIso
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))) :=
        AlgebraicGeometry.isIso_SpecMap_iff.mpr hBij_alg
      have _ : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) := by
        classical
        let sX : Finset (MvPolynomial (Fin (N + 1)) R) := Finset.univ.image MvPolynomial.X
        let S_sub : Subalgebra ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
          Algebra.adjoin ↥(𝒜 0) ↑sX
        have h_all : ∀ p : MvPolynomial (Fin (N + 1)) R, p ∈ S_sub := by
          intro p
          induction p using MvPolynomial.induction_on with
          | C c =>
            have hc : MvPolynomial.C c ∈ 𝒜 0 :=
              (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr
                (MvPolynomial.isHomogeneous_C (Fin (N + 1)) c)
            exact S_sub.algebraMap_mem ⟨MvPolynomial.C c, hc⟩
          | add p q hp hq => exact S_sub.add_mem hp hq
          | mul_X p i hp =>
            exact S_sub.mul_mem hp
              (Algebra.subset_adjoin
                (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_univ i))))
        exact ⟨⟨sX, eq_top_iff.mpr fun p _ => h_all p⟩⟩
      exact CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance inferInstance

    
    have : AlgebraicGeometry.IsProper π_Proj := hPropProj
    let W_prod := CategoryTheory.Limits.pullback g_Z π_Proj
    let fst := CategoryTheory.Limits.pullback.fst g_Z π_Proj
    let snd := CategoryTheory.Limits.pullback.snd g_Z π_Proj
    let δ : U_dense.toScheme ⟶ W_prod :=
      CategoryTheory.Limits.pullback.lift U_dense.ι Φ hΦ.symm
    have : AlgebraicGeometry.IsAffine U_dense.toScheme := hAffU_dense
    have : AlgebraicGeometry.IsProper fst :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback g_Z π_Proj).flip hPropProj
    have : AlgebraicGeometry.IsProper snd :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback g_Z π_Proj) hPropZ
    have : AlgebraicGeometry.IsProper (fst ≫ g_Z) :=
      CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance hPropZ
    have hQC_comp : AlgebraicGeometry.QuasiCompact (δ ≫ (fst ≫ g_Z)) := by
      have hEq : δ ≫ (fst ≫ g_Z) = U_dense.ι ≫ g_Z := by
        rw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
      rw [hEq]
      infer_instance
    have : AlgebraicGeometry.QuasiCompact δ :=
      @AlgebraicGeometry.QuasiCompact.of_comp _ _ _ δ (fst ≫ g_Z) hQC_comp inferInstance

    
    let Z' := δ.image
    let ι_Z' := δ.imageι
    let π : Z' ⟶ Z := ι_Z' ≫ fst
    let ι_proj : Z' ⟶ AlgebraicGeometry.Proj 𝒜 := ι_Z' ≫ snd
    let ν : U_dense.toScheme ⟶ Z' := δ.toImage
    have hComm : π ≫ g_Z = ι_proj ≫ π_Proj := by
      dsimp only [π, ι_proj, fst, snd]
      rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.condition]
    have hν_π : ν ≫ π = U_dense.ι := by
      dsimp only [ν, π, ι_Z']
      rw [← Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι,
        CategoryTheory.Limits.pullback.lift_fst]
    have hν_proj : ν ≫ ι_proj = Φ := by
      dsimp only [ν, ι_proj, ι_Z']
      rw [← Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι,
        CategoryTheory.Limits.pullback.lift_snd]
    have hCl_lift : AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.lift π ι_proj hComm) := by
      have hLift_eq : CategoryTheory.Limits.pullback.lift π ι_proj hComm = ι_Z' := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · dsimp only [π, fst]; rw [CategoryTheory.Limits.pullback.lift_fst]
        · dsimp only [ι_proj, snd]; rw [CategoryTheory.Limits.pullback.lift_snd]
      rw [hLift_eq]
      infer_instance
    have hProp_π : AlgebraicGeometry.IsProper π :=
      CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance inferInstance
    have hProp_proj : AlgebraicGeometry.IsProper ι_proj :=
      CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance inferInstance
    have hDom_ν : AlgebraicGeometry.IsDominant ν := inferInstance

    have : Nonempty ↥U_dense.toScheme := hU_nonempty
    have hIntU : AlgebraicGeometry.IsIntegral U_dense.toScheme :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion U_dense.ι
    have : IrreducibleSpace ↥U_dense.toScheme :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral U_dense.toScheme
    have hIrredZ' : IrreducibleSpace ↥Z' := by
      refine { toPreirreducibleSpace := ⟨?_⟩, toNonempty := Nonempty.map ν.base hU_nonempty }
      have h1 := (@PreirreducibleSpace.isPreirreducible_univ ↥U_dense.toScheme _ _).image ν.base
        ν.continuous.continuousOn
      rw [Set.image_univ] at h1
      have h2 := h1.closure
      rwa [hDom_ν.denseRange.closure_range] at h2
    have hRedZ' : AlgebraicGeometry.IsReduced Z' := by
      change AlgebraicGeometry.IsReduced δ.ker.subscheme
      have hCoverRed : ∀ W : (δ.ker.subschemeCover.openCover).I₀,
          AlgebraicGeometry.IsReduced ((δ.ker.subschemeCover.openCover).X W) := by
        intro W
        change AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec (δ.ker.subschemeCover.X W))
        rw [AlgebraicGeometry.affine_isReduced_iff]
        change _root_.IsReduced (↑(W_prod.presheaf.obj (Opposite.op W.1)) ⧸ δ.ker.ideal W)
        rw [δ.ker_apply W]
        have : _root_.IsReduced ↑(U_dense.toScheme.presheaf.obj (Opposite.op (δ ⁻¹ᵁ W.1))) :=
          AlgebraicGeometry.IsReduced.component_reduced (δ ⁻¹ᵁ W.1)
        exact isReduced_of_injective (RingHom.kerLift (δ.app W.1).hom)
          (RingHom.kerLift_injective (δ.app W.1).hom)
      exact @AlgebraicGeometry.IsReduced.of_openCover δ.ker.subscheme
        δ.ker.subschemeCover.openCover hCoverRed
    have hIntZ' : AlgebraicGeometry.IsIntegral Z' :=
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Z'

    
    have hIsoAndOpen : CategoryTheory.IsIso (π ∣_ U_dense) ∧
        AlgebraicGeometry.IsOpenImmersion ν := by
      let V_U : Z'.Opens := π ⁻¹ᵁ U_dense
      let f₀ : V_U.toScheme ⟶ U_dense.toScheme := π ∣_ U_dense
      have hRange_ν : Set.range ν.base ⊆ Set.range V_U.ι.base := by
        rintro _ ⟨u, rfl⟩
        have hu : ν.base u ∈ V_U := by
          change (ν ≫ π).base u ∈ U_dense
          rw [hν_π]
          exact u.2
        exact ⟨⟨ν.base u, hu⟩, rfl⟩
      let s₀ : U_dense.toScheme ⟶ V_U.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift V_U.ι ν hRange_ν
      have hs₀_ι : s₀ ≫ V_U.ι = ν :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac V_U.ι ν hRange_ν
      have hs₀_f₀ : s₀ ≫ f₀ = 𝟙 U_dense.toScheme := by
        rw [← cancel_mono U_dense.ι, Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          ← Category.assoc, hs₀_ι, hν_π, Category.id_comp]
      have hDom_s₀ : AlgebraicGeometry.IsDominant s₀ := by
        constructor
        change Dense (Set.range s₀.base)
        rw [dense_iff_inter_open]
        intro O hO hOne
        have hO_img : IsOpen (V_U.ι.base '' O) := V_U.ι.isOpenEmbedding.isOpenMap O hO
        obtain ⟨y, hyO_img, ⟨u, hy_ν⟩⟩ :=
          hDom_ν.denseRange.inter_open_nonempty (V_U.ι.base '' O) hO_img (hOne.image V_U.ι.base)
        rw [← hs₀_ι] at hy_ν
        rcases hyO_img with ⟨v, hvO, rfl⟩
        have hv_eq : s₀.base u = v := V_U.ι.isOpenEmbedding.injective hy_ν
        exact ⟨v, hvO, u, hv_eq⟩
      have : Nonempty ↥V_U.toScheme := Nonempty.map s₀.base hU_nonempty
      have : AlgebraicGeometry.IsIntegral V_U.toScheme :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion V_U.ι
      have : V_U.toScheme.IsSeparated := by
        rw [AlgebraicGeometry.Scheme.isSeparated_iff]
        have hSepZ_mor : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from Z) :=
          (AlgebraicGeometry.Scheme.isSeparated_iff Z).mp hSepZ
        have hTerm : CategoryTheory.Limits.terminal.from V_U.toScheme =
            V_U.ι ≫ π ≫ CategoryTheory.Limits.terminal.from Z :=
          CategoryTheory.Limits.terminal.hom_ext _ _
        rw [hTerm]
        exact CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance
          (CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance hSepZ_mor)
      have hf₀_s₀ : f₀ ≫ s₀ = 𝟙 V_U.toScheme := by
        apply AlgebraicGeometry.ext_of_isDominant s₀
        rw [← Category.assoc, hs₀_f₀, Category.id_comp, Category.comp_id]
      have hIso_f₀ : CategoryTheory.IsIso f₀ := ⟨⟨s₀, hf₀_s₀, hs₀_f₀⟩⟩
      have _ : CategoryTheory.IsIso s₀ := ⟨⟨f₀, hs₀_f₀, hf₀_s₀⟩⟩
      have hOpen : AlgebraicGeometry.IsOpenImmersion ν := by
        rw [← hs₀_ι]
        exact CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance inferInstance
      exact ⟨hIso_f₀, hOpen⟩
    obtain ⟨hIso_U, hOpen_ν⟩ := hIsoAndOpen

    
    have hStep4 : ∀ (P : AlgebraicGeometry.Scheme.{u})
        (π_P : P ⟶ S_R)
        (Φ_P : U_dense.toScheme ⟶ P)
        (D_P : Fin (N + 1) → P.Opens)
        (_ : ⨆ γ : Fin (N + 1), D_P γ = ⊤)
        (hAffDP : ∀ γ : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D_P γ))
        (z_P : Fin (N + 1) → ∀ (γ : Fin (N + 1)), ↑(P.presheaf.obj (Opposite.op (D_P γ))))
        (_ : ∀ β γ : Fin (N + 1), P.basicOpen (z_P β γ) ≤ D_P β)
        (_ : ∀ (j₀ : Fin r) (γ : Fin (N + 1)),
          ∃ (β : Fin (N + 1)) (u : ↑(Z.presheaf.obj (Opposite.op (U j₀)))),
            IsZeroAt j₀ β ∧
            ((AlgebraicGeometry.Scheme.Hom.app Φ_P (D_P γ)).hom (z_P β γ)) *
              ((AlgebraicGeometry.Scheme.Hom.appLE U_dense.ι (U j₀)
                ((TopologicalSpace.Opens.map Φ_P.base).obj (D_P γ))
                (fun x _ => hU_le j₀ x.2)).hom u) = 1)
        (_ : ∀ (j : Fin r) (β : Fin (N + 1)),
          IsZeroAt j β →
          ∀ m : Fin (n j),
            ∃ β_m : Fin (N + 1),
              (AlgebraicGeometry.Scheme.Hom.app Φ_P (D_P β)).hom (z_P β_m β) =
                (AlgebraicGeometry.Scheme.Hom.appLE U_dense.ι (U j)
                  ((TopologicalSpace.Opens.map Φ_P.base).obj (D_P β))
                  (fun x _ => hU_le j x.2)).hom (f j m))
        (ι_P : Z' ⟶ P)
        (hComm_P : π ≫ g_Z = ι_P ≫ π_P)
        (_ : AlgebraicGeometry.IsProper ι_P)
        (_ : ν ≫ ι_P = Φ_P)
        (_ : AlgebraicGeometry.IsClosedImmersion
          (CategoryTheory.Limits.pullback.lift π ι_P hComm_P)),
        AlgebraicGeometry.IsClosedImmersion ι_P := by
      intro P π_P Φ_P D_P hCovDP hAffDP z_P hzP hShiftP hRecovP ι_P hComm_P
        hProp_ιP hν_ιP hCl_liftP
      have : AlgebraicGeometry.IsProper ι_P := hProp_ιP
      have : AlgebraicGeometry.IsOpenImmersion ν := hOpen_ν
      have : AlgebraicGeometry.IsClosedImmersion
          (CategoryTheory.Limits.pullback.lift π ι_P hComm_P) := hCl_liftP

      
      have hSecInj : ∀ (X_int W_sub : AlgebraicGeometry.Scheme.{u})
          (j_open : W_sub ⟶ X_int) [AlgebraicGeometry.IsIntegral X_int]
          [AlgebraicGeometry.IsOpenImmersion j_open]
          (Ω : X_int.Opens),
          Nonempty ↥(j_open ⁻¹ᵁ Ω) →
          Function.Injective (j_open.app Ω).hom := by
        intro X_int W_sub j_open _ _ Ω ⟨u₀, hu₀⟩ a₁ a₂ hEq
        have h_germ := congrArg
          (W_sub.presheaf.germ (j_open ⁻¹ᵁ Ω) u₀ hu₀).hom hEq
        have h_nat₁ := congrArg (fun f => f.hom a₁) (j_open.germ_stalkMap Ω u₀ hu₀)
        have h_nat₂ := congrArg (fun f => f.hom a₂) (j_open.germ_stalkMap Ω u₀ hu₀)
        change (j_open.app Ω ≫ W_sub.presheaf.germ (j_open ⁻¹ᵁ Ω) u₀ hu₀).hom a₁ =
          (j_open.app Ω ≫ W_sub.presheaf.germ (j_open ⁻¹ᵁ Ω) u₀ hu₀).hom a₂ at h_germ
        rw [← h_nat₁, ← h_nat₂] at h_germ
        have _ : CategoryTheory.IsIso (j_open.stalkMap u₀) := inferInstance
        have h_germ_eq : (X_int.presheaf.germ Ω (j_open.base u₀) hu₀).hom a₁ =
            (X_int.presheaf.germ Ω (j_open.base u₀) hu₀).hom a₂ := by
          have h_cancel := congrArg (inv (j_open.stalkMap u₀)).hom h_germ
          change ((X_int.presheaf.germ Ω (j_open.base u₀) hu₀) ≫
            ((j_open.stalkMap u₀) ≫ inv (j_open.stalkMap u₀))).hom a₁ =
            ((X_int.presheaf.germ Ω (j_open.base u₀) hu₀) ≫
              ((j_open.stalkMap u₀) ≫ inv (j_open.stalkMap u₀))).hom a₂ at h_cancel
          rwa [CategoryTheory.IsIso.hom_inv_id, Category.comp_id] at h_cancel
        exact AlgebraicGeometry.germ_injective_of_isIntegral X_int (j_open.base u₀) hu₀ h_germ_eq

      
      have hExt_Spec : ∀ {X_dom : AlgebraicGeometry.Scheme.{u}} {R_t : CommRingCat.{u}}
          {m₁ m₂ : X_dom ⟶ AlgebraicGeometry.Spec R_t},
          (AlgebraicGeometry.Scheme.ΓSpecIso R_t).inv ≫ m₁.appTop =
            (AlgebraicGeometry.Scheme.ΓSpecIso R_t).inv ≫ m₂.appTop →
          m₁ = m₂ := by
        intro X_dom R_t m₁ m₂ hApp
        have h_id : ∀ m : X_dom ⟶ AlgebraicGeometry.Spec R_t,
            X_dom.toSpecΓ ≫
              AlgebraicGeometry.Spec.map
                ((AlgebraicGeometry.Scheme.ΓSpecIso R_t).inv ≫ m.appTop) = m := by
          intro m
          rw [AlgebraicGeometry.Spec.map_comp,
            ← AlgebraicGeometry.Scheme.toSpecΓ_naturality_assoc,
            AlgebraicGeometry.toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
        rw [← h_id m₁, ← h_id m₂, hApp]

      
      have hFromSpec_appTop : ∀ {Y_sch : AlgebraicGeometry.Scheme.{u}} (W_op : Y_sch.Opens)
          (hW : AlgebraicGeometry.IsAffineOpen W_op),
          hW.fromSpec.appTop =
            Y_sch.presheaf.map (CategoryTheory.homOfLE (le_top : W_op ≤ ⊤)).op ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (Y_sch.presheaf.obj (Opposite.op W_op))).inv := by
        intro Y_sch W_op hW
        have h_fs_top : hW.fromSpec ⁻¹ᵁ W_op = ⊤ := by
          apply le_antisymm le_top
          intro p _
          rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
          exact (hW.isoSpec.inv.base p).2
        have h_nat := hW.fromSpec.naturality (CategoryTheory.homOfLE (le_top : W_op ≤ ⊤)).op
        rw [hW.fromSpec_app_self] at h_nat
        have h_nat' : (Y_sch.presheaf.map (CategoryTheory.homOfLE (le_top : W_op ≤ ⊤)).op ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (Y_sch.presheaf.obj (Opposite.op W_op))).inv) ≫
            (AlgebraicGeometry.Spec (Y_sch.presheaf.obj (Opposite.op W_op))).presheaf.map
              (eqToHom h_fs_top).op =
            hW.fromSpec.appTop ≫
            (AlgebraicGeometry.Spec (Y_sch.presheaf.obj (Opposite.op W_op))).presheaf.map
              (eqToHom h_fs_top).op := by
          refine (Category.assoc _ _ _).trans (h_nat.trans ?_)
          exact congrArg
            (hW.fromSpec.appTop ≫
              (AlgebraicGeometry.Spec (Y_sch.presheaf.obj (Opposite.op W_op))).presheaf.map ·)
            (Subsingleton.elim _ _)
        exact ((cancel_mono
          ((AlgebraicGeometry.Spec (Y_sch.presheaf.obj (Opposite.op W_op))).presheaf.map
            (eqToHom h_fs_top).op)).mp h_nat').symm

      
      let W_bad : P.Opens :=
        ⟨(Set.range ι_P.base)ᶜ, ι_P.isClosedMap.isClosed_range.isOpen_compl⟩
      let ZeroIdx := { β : Fin (N + 1) // ∃ j : Fin r, IsZeroAt j β }
      let Wcov : Option ZeroIdx → P.Opens :=
        fun idx => Option.casesOn idx W_bad (fun β => D_P β.1)
      have hSupW : ⨆ idx : Option ZeroIdx, Wcov idx = ⊤ := by
        apply le_antisymm le_top
        intro y_P _
        rw [TopologicalSpace.Opens.mem_iSup]
        by_cases hy : y_P ∈ Set.range ι_P.base
        · rcases hy with ⟨x, rfl⟩
          have hxU : π.base x ∈ (⊤ : Z.Opens) := trivial
          rw [← hCovU, TopologicalSpace.Opens.mem_iSup] at hxU
          obtain ⟨j₀, hxj₀⟩ := hxU
          have hxD : ι_P.base x ∈ (⊤ : P.Opens) := trivial
          rw [← hCovDP, TopologicalSpace.Opens.mem_iSup] at hxD
          obtain ⟨γ, hxγ⟩ := hxD
          obtain ⟨β, u, hZβ, hUnitEq⟩ := hShiftP j₀ γ
          refine ⟨some ⟨β, ⟨j₀, hZβ⟩⟩, ?_⟩
          dsimp only [Wcov]
          let Ω_V : Z'.Opens := π ⁻¹ᵁ U j₀ ⊓ ι_P ⁻¹ᵁ D_P γ
          have hx_Ω : x ∈ Ω_V := ⟨hxj₀, hxγ⟩
          have hΩ_ne : (Ω_V : Set ↥Z').Nonempty := ⟨x, hx_Ω⟩
          obtain ⟨w_pt, hw_in_Ω, ⟨u₀, hu₀_eq⟩⟩ :=
            hDom_ν.denseRange.inter_open_nonempty Ω_V Ω_V.isOpen hΩ_ne
          have hu₀_mem : u₀ ∈ ν ⁻¹ᵁ Ω_V := by
            change ν.base u₀ ∈ Ω_V
            rwa [hu₀_eq]
          let a_V : ↑(Z'.presheaf.obj (Opposite.op Ω_V)) :=
            (ι_P.appLE (D_P γ) Ω_V inf_le_right).hom (z_P β γ)
          let b_V : ↑(Z'.presheaf.obj (Opposite.op Ω_V)) :=
            (π.appLE (U j₀) Ω_V inf_le_left).hom u
          have h_prod_one : a_V * b_V = 1 := by
            apply hSecInj Z' U_dense.toScheme ν Ω_V ⟨u₀, hu₀_mem⟩
            rw [map_mul, map_one]
            let Ω_U : U_dense.toScheme.Opens := ν ⁻¹ᵁ Ω_V
            have h_le_Φ : Ω_U ≤ Φ_P ⁻¹ᵁ D_P γ := by
              intro w hw
              change Φ_P.base w ∈ D_P γ
              rw [← hν_ιP]
              exact hw.2
            have ha_U : (ν.app Ω_V).hom a_V =
                (U_dense.toScheme.presheaf.map (CategoryTheory.homOfLE h_le_Φ).op).hom
                  ((Φ_P.app (D_P γ)).hom (z_P β γ)) := by
              have h_mor : ι_P.appLE (D_P γ) Ω_V inf_le_right ≫ ν.app Ω_V =
                  Φ_P.app (D_P γ) ≫
                    U_dense.toScheme.presheaf.map (CategoryTheory.homOfLE h_le_Φ).op := by
                rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE ν]
                exact (hCompAppLE ν ι_P (D_P γ) Ω_V Ω_U inf_le_right le_rfl
                  (fun _ hw => hw.2)).trans (hCongrAppLE hν_ιP (D_P γ) Ω_U _ h_le_Φ)
              exact congrArg (fun m => m.hom (z_P β γ)) h_mor
            have hb_U : (ν.app Ω_V).hom b_V =
                (U_dense.toScheme.presheaf.map (CategoryTheory.homOfLE h_le_Φ).op).hom
                  ((U_dense.ι.appLE (U j₀) (Φ_P ⁻¹ᵁ D_P γ)
                    (fun w _ => hU_le j₀ w.2)).hom u) := by
              have h_mor : π.appLE (U j₀) Ω_V inf_le_left ≫ ν.app Ω_V =
                  U_dense.ι.appLE (U j₀) (Φ_P ⁻¹ᵁ D_P γ) (fun w _ => hU_le j₀ w.2) ≫
                    U_dense.toScheme.presheaf.map (CategoryTheory.homOfLE h_le_Φ).op := by
                rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE ν]
                refine (hCompAppLE ν π (U j₀) Ω_V Ω_U inf_le_left le_rfl
                  (fun _ hw => hw.1)).trans ?_
                refine (hCongrAppLE hν_π (U j₀) Ω_U _ (fun w _ => hU_le j₀ w.2)).trans ?_
                unfold AlgebraicGeometry.Scheme.Hom.appLE
                rw [Category.assoc, ← Functor.map_comp]
                rfl
              exact congrArg (fun m => m.hom u) h_mor
            rw [ha_U, hb_U, ← map_mul, hUnitEq, map_one]
          have hUnit_germ : IsUnit
              ((Z'.presheaf.germ (ι_P ⁻¹ᵁ D_P γ) x hxγ).hom ((ι_P.app (D_P γ)).hom (z_P β γ))) := by
            have h_res_germ : (Z'.presheaf.germ Ω_V x hx_Ω).hom a_V =
                (Z'.presheaf.germ (ι_P ⁻¹ᵁ D_P γ) x hxγ).hom
                  ((ι_P.app (D_P γ)).hom (z_P β γ)) := by
              dsimp only [a_V, AlgebraicGeometry.Scheme.Hom.appLE]
              change (Z'.presheaf.map (CategoryTheory.homOfLE inf_le_right).op ≫
                Z'.presheaf.germ Ω_V x hx_Ω).hom ((ι_P.app (D_P γ)).hom (z_P β γ)) = _
              rw [Z'.presheaf.germ_res]
            rw [← h_res_germ]
            exact IsUnit.of_mul_eq_one ((Z'.presheaf.germ Ω_V x hx_Ω).hom b_V)
              (by rw [← map_mul, h_prod_one, map_one])
          have hx_basic : x ∈ Z'.basicOpen ((ι_P.app (D_P γ)).hom (z_P β γ)) :=
            (Z'.mem_basicOpen _ x hxγ).mpr hUnit_germ
          rw [← AlgebraicGeometry.Scheme.preimage_basicOpen] at hx_basic
          exact hzP β γ hx_basic
        · exact ⟨none, hy⟩

      
      rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := @AlgebraicGeometry.IsClosedImmersion) Wcov hSupW]
      intro idx
      cases idx with
      | none =>
        dsimp only [Wcov]
        have : IsEmpty ↥(ι_P ⁻¹ᵁ W_bad).toScheme := ⟨fun ⟨x, hx⟩ => hx ⟨x, rfl⟩⟩
        infer_instance
      | some β_sub =>
        rcases β_sub with ⟨β, ⟨j, hZβ⟩⟩
        dsimp only [Wcov]
        let V_β : Z'.Opens := ι_P ⁻¹ᵁ D_P β
        rcases isEmpty_or_nonempty ↥V_β with hEmpty | hNonemptyV
        · have : IsEmpty ↥V_β.toScheme := hEmpty
          infer_instance
        · have : Nonempty ↥V_β.toScheme := hNonemptyV
          have hIntVβ : AlgebraicGeometry.IsIntegral V_β.toScheme :=
            AlgebraicGeometry.isIntegral_of_isOpenImmersion V_β.ι
          let U_β : U_dense.toScheme.Opens := Φ_P ⁻¹ᵁ D_P β
          have hUβ_eq : U_β = ν ⁻¹ᵁ V_β := by
            ext u
            change Φ_P.base u ∈ D_P β ↔ ι_P.base (ν.base u) ∈ D_P β
            rw [← hν_ιP]
            rfl
          obtain ⟨v₀_pt⟩ := hNonemptyV
          obtain ⟨w_pt, hw_in_V, ⟨u_β, hu_β_eq⟩⟩ :=
            hDom_ν.denseRange.inter_open_nonempty V_β V_β.isOpen ⟨v₀_pt.1, v₀_pt.2⟩
          have hu_β_mem : u_β ∈ U_β := by
            rw [hUβ_eq]
            change ν.base u_β ∈ V_β
            rwa [hu_β_eq]
          let s_β : U_β.toScheme ⟶ V_β.toScheme := ν.resLE V_β U_β (le_of_eq hUβ_eq)
          have hsβ_ι : s_β ≫ V_β.ι = U_β.ι ≫ ν := ν.resLE_comp_ι (le_of_eq hUβ_eq)
          have hOpen_sβ : AlgebraicGeometry.IsOpenImmersion s_β := by
            have : AlgebraicGeometry.IsOpenImmersion (s_β ≫ V_β.ι) := by
              rw [hsβ_ι]
              exact CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance inferInstance
            exact AlgebraicGeometry.IsOpenImmersion.of_comp s_β V_β.ι
          have hDom_sβ : AlgebraicGeometry.IsDominant s_β := by
            constructor
            change Dense (Set.range s_β.base)
            rw [dense_iff_inter_open]
            intro O hO hOne
            have hO_img : IsOpen (V_β.ι.base '' O) := V_β.ι.isOpenEmbedding.isOpenMap O hO
            obtain ⟨y, hyO, ⟨u', hu'_eq⟩⟩ :=
              hDom_ν.denseRange.inter_open_nonempty (V_β.ι.base '' O) hO_img
                (hOne.image V_β.ι.base)
            rcases hyO with ⟨v', hv'O, rfl⟩
            have hu'_in : u' ∈ U_β := by
              rw [hUβ_eq]
              change ν.base u' ∈ V_β
              rw [hu'_eq]
              exact v'.2
            have hs_eq : (s_β ≫ V_β.ι).base ⟨u', hu'_in⟩ = V_β.ι.base v' := by
              rw [hsβ_ι]
              exact hu'_eq
            exact ⟨v', hv'O, ⟨u', hu'_in⟩, V_β.ι.isOpenEmbedding.injective hs_eq⟩

          
          let R_Aj : CommRingCat.{u} := Z.presheaf.obj (Opposite.op (U j))
          let κ_j : R →+* ↑R_Aj :=
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
              g_Z.appLE ⊤ (U j) le_top).hom)
          let σ_j : MvPolynomial (Fin (n j)) R →+* ↑R_Aj := MvPolynomial.eval₂Hom κ_j (f j)
          let R_Pβ : CommRingCat.{u} := P.presheaf.obj (Opposite.op (D_P β))
          let κ_Pβ : R →+* ↑R_Pβ :=
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
              π_P.appLE ⊤ (D_P β) le_top).hom)
          choose β_m hβ_m using hRecovP j β hZβ
          let τ_β : MvPolynomial (Fin (n j)) R →+* ↑R_Pβ :=
            MvPolynomial.eval₂Hom κ_Pβ (fun m => z_P (β_m m) β)
          let I_β : Ideal ↑R_Pβ := Ideal.map τ_β (RingHom.ker σ_j)
          let Q_β := ↑R_Pβ ⧸ I_β
          let mk_β : ↑R_Pβ →+* Q_β := Ideal.Quotient.mk I_β
          have hKer_le : RingHom.ker σ_j ≤ RingHom.ker (mk_β.comp τ_β) := by
            intro p_poly hp
            rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
            exact Ideal.mem_map_of_mem τ_β hp
          let θ_β : ↑R_Aj →+* Q_β :=
            (Ideal.Quotient.lift (RingHom.ker σ_j) (mk_β.comp τ_β) hKer_le).comp
              (RingHom.quotientKerEquivOfSurjective (hGen j)).symm.toRingHom
          have hθ_σ : θ_β.comp σ_j = mk_β.comp τ_β := by
            apply RingHom.ext
            intro p_poly
            change (Ideal.Quotient.lift (RingHom.ker σ_j) (mk_β.comp τ_β) hKer_le)
              ((RingHom.quotientKerEquivOfSurjective (hGen j)).symm (σ_j p_poly)) =
              mk_β (τ_β p_poly)
            have h_symm : (RingHom.quotientKerEquivOfSurjective (hGen j)).symm (σ_j p_poly) =
                Ideal.Quotient.mk (RingHom.ker σ_j) p_poly := by
              apply (RingHom.quotientKerEquivOfSurjective (hGen j)).injective
              rw [RingEquiv.apply_symm_apply]
              rfl
            rw [h_symm]
            rfl
          let C_β := AlgebraicGeometry.Spec (CommRingCat.of Q_β)
          let mk_β_mor : R_Pβ ⟶ CommRingCat.of Q_β := CommRingCat.ofHom mk_β
          let θ_β_mor : R_Aj ⟶ CommRingCat.of Q_β := CommRingCat.ofHom θ_β
          let ι_C : C_β ⟶ (D_P β).toScheme :=
            AlgebraicGeometry.Spec.map mk_β_mor ≫ (hAffDP β).isoSpec.inv
          have hCl_ιC : AlgebraicGeometry.IsClosedImmersion ι_C := by
            have : AlgebraicGeometry.IsClosedImmersion
                (AlgebraicGeometry.Spec.map mk_β_mor) :=
              AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
                mk_β_mor Ideal.Quotient.mk_surjective
            exact AlgebraicGeometry.IsClosedImmersion.comp _ _
          let ψ_β : C_β ⟶ Z :=
            AlgebraicGeometry.Spec.map θ_β_mor ≫ (hAffU j).fromSpec
          have hComm_Cβ : ψ_β ≫ g_Z = ι_C ≫ (D_P β).ι ≫ π_P := by
            have h_ιC_from : ι_C ≫ (D_P β).ι =
                AlgebraicGeometry.Spec.map mk_β_mor ≫ (hAffDP β).fromSpec := by
              dsimp only [ι_C]
              rw [Category.assoc, AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
            rw [← Category.assoc ι_C, h_ιC_from]
            apply hExt_Spec
            have h_lhs : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
                (ψ_β ≫ g_Z).appTop =
                CommRingCat.ofHom (θ_β.comp κ_j) ≫
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Q_β)).inv := by
              dsimp only [ψ_β]
              rw [Category.assoc, AlgebraicGeometry.Scheme.Hom.comp_appTop,
                AlgebraicGeometry.Scheme.Hom.comp_appTop, hFromSpec_appTop (U j) (hAffU j)]
              have h_nat := hSpecNat θ_β_mor
              ext c
              have h_nat_c := congrArg (fun m => m.hom
                ((g_Z.appLE ⊤ (U j) le_top).hom
                  ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom c))) h_nat
              exact h_nat_c
            have h_rhs : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
                ((AlgebraicGeometry.Spec.map mk_β_mor ≫
                  (hAffDP β).fromSpec) ≫ π_P).appTop =
                CommRingCat.ofHom (mk_β.comp κ_Pβ) ≫
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Q_β)).inv := by
              rw [Category.assoc, AlgebraicGeometry.Scheme.Hom.comp_appTop,
                AlgebraicGeometry.Scheme.Hom.comp_appTop, hFromSpec_appTop (D_P β) (hAffDP β)]
              have h_nat := hSpecNat mk_β_mor
              ext c
              have h_nat_c := congrArg (fun m => m.hom
                ((π_P.appLE ⊤ (D_P β) le_top).hom
                  ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom c))) h_nat
              exact h_nat_c
            have h_κ_eq : θ_β.comp κ_j = mk_β.comp κ_Pβ := by
              ext c
              have h_eval := congrArg (fun φ => φ (MvPolynomial.C c)) hθ_σ
              simpa [σ_j, τ_β] using h_eval
            rw [h_lhs, h_rhs, h_κ_eq]

          
          let f_β : V_β.toScheme ⟶ (D_P β).toScheme := ι_P ∣_ D_P β
          let R_Vβ : CommRingCat.{u} := V_β.toScheme.presheaf.obj (Opposite.op ⊤)
          let R_Uβ : CommRingCat.{u} := U_β.toScheme.presheaf.obj (Opposite.op ⊤)
          let ρ_mor : R_Pβ ⟶ R_Vβ :=
            (AlgebraicGeometry.Scheme.ΓSpecIso R_Pβ).inv ≫
              (f_β ≫ (hAffDP β).isoSpec.hom).appTop
          let ρ_β : ↑R_Pβ →+* ↑R_Vβ := ρ_mor.hom
          let res_Uβ_mor : R_Aj ⟶ R_Uβ :=
            U_dense.ι.appLE (U j) U_β (fun w _ => hU_le j w.2) ≫ U_β.topIso.inv

          have hChartApp : ∀ {Y_sch : AlgebraicGeometry.Scheme.{u}} (W_op : Y_sch.Opens)
              (hW : AlgebraicGeometry.IsAffineOpen W_op)
              (h_a : U_dense.toScheme ⟶ Y_sch)
              (hle_a : U_β ≤ h_a ⁻¹ᵁ W_op)
              (g_a : U_β.toScheme ⟶ AlgebraicGeometry.Spec (Y_sch.presheaf.obj (Opposite.op W_op))),
              g_a ≫ hW.fromSpec = U_β.ι ≫ h_a →
              (AlgebraicGeometry.Scheme.ΓSpecIso (Y_sch.presheaf.obj (Opposite.op W_op))).inv ≫
                g_a.appTop =
                h_a.appLE W_op U_β hle_a ≫ U_β.topIso.inv := by
            intro Y_sch W_op hW h_a hle_a g_a hg_eq
            have h_le_u : (⊤ : U_β.toScheme.Opens) ≤ (U_β.ι ≫ h_a) ⁻¹ᵁ W_op :=
              fun w _ => hle_a w.2
            have h_le_fs : (⊤ : (AlgebraicGeometry.Spec (Y_sch.presheaf.obj (Opposite.op W_op))).Opens) ≤
                hW.fromSpec ⁻¹ᵁ W_op := by
              intro p _
              rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
              exact (hW.isoSpec.inv.base p).2
            have h_le_g' : (⊤ : U_β.toScheme.Opens) ≤ g_a ⁻¹ᵁ (hW.fromSpec ⁻¹ᵁ W_op) :=
              fun p hp => h_le_fs hp
            have h_le_g : (⊤ : U_β.toScheme.Opens) ≤ (g_a ≫ hW.fromSpec) ⁻¹ᵁ W_op := h_le_g'
            have h_both := hCongrAppLE hg_eq W_op ⊤ h_le_g h_le_u
            have h_rhs_u : (U_β.ι ≫ h_a).appLE W_op ⊤ h_le_u =
                h_a.appLE W_op U_β hle_a ≫ U_β.topIso.inv := by
              rw [AlgebraicGeometry.Scheme.Hom.comp_appLE]
              have h_sub : U_β.ι.appLE (h_a ⁻¹ᵁ W_op) ⊤ (fun w _ => hle_a w.2) =
                  U_dense.toScheme.presheaf.map (CategoryTheory.homOfLE hle_a).op ≫
                    U_β.topIso.inv := by
                simp only [AlgebraicGeometry.Scheme.Opens.topIso_inv,
                  AlgebraicGeometry.Scheme.Hom.appLE, AlgebraicGeometry.Scheme.Opens.ι_app]
                exact (U_dense.toScheme.presheaf.map_comp _ _).symm.trans
                  ((congrArg U_dense.toScheme.presheaf.map (Subsingleton.elim _ _)).trans
                    (U_dense.toScheme.presheaf.map_comp _ _))
              exact (congrArg (h_a.app W_op ≫ ·) h_sub).trans (Category.assoc _ _ _).symm
            have h_lhs_u : (g_a ≫ hW.fromSpec).appLE W_op ⊤ h_le_g =
                (AlgebraicGeometry.Scheme.ΓSpecIso (Y_sch.presheaf.obj (Opposite.op W_op))).inv ≫
                  g_a.appTop := by
              rw [AlgebraicGeometry.Scheme.Hom.comp_appLE, hW.fromSpec_app_self, Category.assoc]
              congr 1
              have h_map := AlgebraicGeometry.Scheme.Hom.map_appLE g_a h_le_g'
                (eqToHom (le_antisymm le_top h_le_fs)).op
              refine h_map.trans ?_
              unfold AlgebraicGeometry.Scheme.Hom.appLE AlgebraicGeometry.Scheme.Hom.appTop
              exact (congrArg (g_a.app ⊤ ≫ U_β.toScheme.presheaf.map ·)
                (Subsingleton.elim _ (𝟙 _))).trans
                ((congrArg (g_a.app ⊤ ≫ ·) (U_β.toScheme.presheaf.map_id _)).trans
                  (Category.comp_id _))
            rw [← h_lhs_u, h_both, h_rhs_u]

          have hsβ_ρ : ρ_mor ≫ s_β.appTop = Φ_P.app (D_P β) ≫ U_β.topIso.inv := by
            have h_comp : (s_β ≫ f_β ≫ (hAffDP β).isoSpec.hom) ≫ (hAffDP β).fromSpec =
                U_β.ι ≫ Φ_P := by
              rw [Category.assoc, Category.assoc, ← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι,
                Iso.hom_inv_id_assoc, AlgebraicGeometry.morphismRestrict_ι, ← Category.assoc,
                hsβ_ι, Category.assoc, hν_ιP]
            have h_eq_mor := hChartApp (D_P β) (hAffDP β) Φ_P le_rfl
              (s_β ≫ f_β ≫ (hAffDP β).isoSpec.hom) h_comp
            rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, ← Category.assoc] at h_eq_mor
            refine h_eq_mor.trans ?_
            rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE Φ_P]

          have hΦ_πP : Φ_P ≫ π_P = U_dense.ι ≫ g_Z := by
            rw [← hν_ιP, Category.assoc, ← hComm_P, ← Category.assoc, hν_π]
          have hPoly_bridge : (s_β.appTop.hom.comp ρ_β).comp τ_β =
              res_Uβ_mor.hom.comp σ_j := by
            have h_sr : s_β.appTop.hom.comp ρ_β = (Φ_P.app (D_P β) ≫ U_β.topIso.inv).hom := by
              ext x
              exact congrArg (fun m => m.hom x) hsβ_ρ
            rw [h_sr]
            apply MvPolynomial.ringHom_ext'
            · ext c
              change (Φ_P.app (D_P β) ≫ U_β.topIso.inv).hom (τ_β (MvPolynomial.C c)) =
                res_Uβ_mor.hom (σ_j (MvPolynomial.C c))
              simp only [τ_β, σ_j, MvPolynomial.eval₂Hom_C]
              dsimp only [κ_Pβ, κ_j, res_Uβ_mor]
              have h_c_eq : π_P.appLE ⊤ (D_P β) le_top ≫ Φ_P.app (D_P β) =
                  g_Z.appLE ⊤ (U j) le_top ≫
                    U_dense.ι.appLE (U j) U_β (fun w _ => hU_le j w.2) := by
                rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE Φ_P,
                  hCompAppLE Φ_P π_P ⊤ (D_P β) U_β le_top le_rfl le_top,
                  hCompAppLE U_dense.ι g_Z ⊤ (U j) U_β le_top (fun w _ => hU_le j w.2) le_top,
                  hCongrAppLE hΦ_πP ⊤ U_β le_top le_top]
              change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
                (π_P.appLE ⊤ (D_P β) le_top ≫ Φ_P.app (D_P β)) ≫ U_β.topIso.inv).hom c =
                ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
                  (g_Z.appLE ⊤ (U j) le_top ≫
                    U_dense.ι.appLE (U j) U_β (fun w _ => hU_le j w.2)) ≫
                    U_β.topIso.inv).hom c
              rw [h_c_eq]
            · intro m
              change U_β.topIso.inv.hom ((Φ_P.app (D_P β)).hom (τ_β (MvPolynomial.X m))) =
                U_β.topIso.inv.hom
                  ((U_dense.ι.appLE (U j) U_β (fun w _ => hU_le j w.2)).hom
                    (σ_j (MvPolynomial.X m)))
              simp only [τ_β, σ_j, MvPolynomial.eval₂Hom_X']
              rw [hβ_m m]

          have hIβ_ker : I_β ≤ RingHom.ker ρ_β := by
            rw [Ideal.map_le_iff_le_comap]
            intro p_poly hp
            rw [Ideal.mem_comap, RingHom.mem_ker]
            have h_u_top : (⟨u_β, hu_β_mem⟩ : ↥U_β.toScheme) ∈
                s_β ⁻¹ᵁ (⊤ : V_β.toScheme.Opens) := trivial
            apply hSecInj V_β.toScheme U_β.toScheme s_β ⊤ ⟨⟨u_β, hu_β_mem⟩, h_u_top⟩
            rw [map_zero]
            change ((s_β.appTop.hom.comp ρ_β).comp τ_β) p_poly = 0
            rw [hPoly_bridge]
            change res_Uβ_mor.hom (σ_j p_poly) = 0
            have hp0 : σ_j p_poly = 0 := hp
            rw [hp0, map_zero]

          let ρ_bar : Q_β →+* ↑R_Vβ := Ideal.Quotient.lift I_β ρ_β hIβ_ker
          have hρ_bar_mk : ρ_bar.comp mk_β = ρ_β := Ideal.Quotient.lift_comp_mk I_β ρ_β hIβ_ker
          let ρ_bar_mor : CommRingCat.of Q_β ⟶ R_Vβ := CommRingCat.ofHom ρ_bar
          let q_β : V_β.toScheme ⟶ C_β :=
            V_β.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map ρ_bar_mor
          have hqβ_ιC : q_β ≫ ι_C = f_β := by
            dsimp only [q_β, ι_C]
            rw [← Category.assoc _ _ (hAffDP β).isoSpec.inv, Iso.comp_inv_eq]
            rw [Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
            have h_mor : mk_β_mor ≫ ρ_bar_mor = ρ_mor := by
              ext x
              exact congrArg (fun φ => φ x) hρ_bar_mk
            rw [h_mor]
            dsimp only [ρ_mor]
            rw [AlgebraicGeometry.Spec.map_comp,
              ← AlgebraicGeometry.Scheme.toSpecΓ_naturality_assoc,
              AlgebraicGeometry.toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]

          
          have hqβ_ψβ : q_β ≫ ψ_β = V_β.ι ≫ π := by
            apply AlgebraicGeometry.ext_of_isDominant s_β
            let g_lhs : U_β.toScheme ⟶ AlgebraicGeometry.Spec R_Aj :=
              s_β ≫ q_β ≫ AlgebraicGeometry.Spec.map θ_β_mor
            let g_rhs : U_β.toScheme ⟶ AlgebraicGeometry.Spec R_Aj :=
              U_β.ι ≫ Z.homOfLE (hU_le j) ≫ (hAffU j).isoSpec.hom
            have hg_rhs_fs : g_rhs ≫ (hAffU j).fromSpec = U_β.ι ≫ U_dense.ι := by
              dsimp only [g_rhs]
              rw [Category.assoc, Category.assoc, ← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι,
                Iso.hom_inv_id_assoc, Z.homOfLE_ι]
            have h_rhs_eq : s_β ≫ V_β.ι ≫ π = g_rhs ≫ (hAffU j).fromSpec := by
              rw [hg_rhs_fs, ← Category.assoc s_β, hsβ_ι, Category.assoc, hν_π]
            have h_lhs_eq : s_β ≫ q_β ≫ ψ_β = g_lhs ≫ (hAffU j).fromSpec := by
              dsimp only [g_lhs, ψ_β]
              simp only [Category.assoc]
            rw [h_lhs_eq, h_rhs_eq]
            congr 1
            apply hExt_Spec
            have h_app_rhs : (AlgebraicGeometry.Scheme.ΓSpecIso R_Aj).inv ≫ g_rhs.appTop =
                res_Uβ_mor :=
              hChartApp (U j) (hAffU j) U_dense.ι (fun w _ => hU_le j w.2) g_rhs hg_rhs_fs
            have h_app_lhs : (AlgebraicGeometry.Scheme.ΓSpecIso R_Aj).inv ≫ g_lhs.appTop =
                θ_β_mor ≫ ρ_bar_mor ≫ s_β.appTop := by
              dsimp only [g_lhs]
              have h2 : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Q_β)).inv ≫
                  q_β.appTop = ρ_bar_mor := by
                dsimp only [q_β]
                rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
                  AlgebraicGeometry.Scheme.toSpecΓ_appTop,
                  ← Category.assoc, hSpecNat, Category.assoc, Iso.inv_hom_id, Category.comp_id]
              calc (AlgebraicGeometry.Scheme.ΓSpecIso R_Aj).inv ≫
                    (s_β ≫ q_β ≫ AlgebraicGeometry.Spec.map θ_β_mor).appTop
                  = ((AlgebraicGeometry.Scheme.ΓSpecIso R_Aj).inv ≫
                      (AlgebraicGeometry.Spec.map θ_β_mor).appTop) ≫
                      q_β.appTop ≫ s_β.appTop := by
                      simp only [AlgebraicGeometry.Scheme.Hom.comp_appTop, Category.assoc]
                _ = θ_β_mor ≫
                      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Q_β)).inv ≫
                        q_β.appTop) ≫ s_β.appTop := by
                      rw [hSpecNat θ_β_mor]
                      simp only [Category.assoc]
                _ = θ_β_mor ≫ ρ_bar_mor ≫ s_β.appTop := by rw [h2]
            rw [h_app_lhs, h_app_rhs]
            ext a_el
            obtain ⟨p_poly, rfl⟩ := hGen j a_el
            change s_β.appTop.hom (ρ_bar (θ_β (σ_j p_poly))) = res_Uβ_mor.hom (σ_j p_poly)
            have h_θp : θ_β (σ_j p_poly) = mk_β (τ_β p_poly) :=
              congrArg (fun φ => φ p_poly) hθ_σ
            have h_ρp : ρ_bar (mk_β (τ_β p_poly)) = ρ_β (τ_β p_poly) :=
              congrArg (fun φ => φ (τ_β p_poly)) hρ_bar_mk
            rw [h_θp, h_ρp]
            exact congrArg (fun φ => φ p_poly) hPoly_bridge

          
          let W_P := CategoryTheory.Limits.pullback g_Z π_P
          let fst_P := CategoryTheory.Limits.pullback.fst g_Z π_P
          let snd_P := CategoryTheory.Limits.pullback.snd g_Z π_P
          let ι_lift : Z' ⟶ W_P := CategoryTheory.Limits.pullback.lift π ι_P hComm_P
          let W_Z : W_P.Opens := snd_P ⁻¹ᵁ D_P β
          let γ_C : C_β ⟶ W_P :=
            CategoryTheory.Limits.pullback.lift ψ_β (ι_C ≫ (D_P β).ι)
              (by rw [Category.assoc]; exact hComm_Cβ)
          have hRange_C : Set.range γ_C.base ⊆ Set.range W_Z.ι.base := by
            rintro _ ⟨c_pt, rfl⟩
            have hc : γ_C.base c_pt ∈ W_Z := by
              change (γ_C ≫ snd_P).base c_pt ∈ D_P β
              rw [CategoryTheory.Limits.pullback.lift_snd]
              exact (ι_C.base c_pt).2
            exact ⟨⟨γ_C.base c_pt, hc⟩, rfl⟩
          let Ψ_β : C_β ⟶ W_Z.toScheme :=
            AlgebraicGeometry.IsOpenImmersion.lift W_Z.ι γ_C hRange_C
          have hΨ_ι : Ψ_β ≫ W_Z.ι = γ_C :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac W_Z.ι γ_C hRange_C
          have hΨ_snd : Ψ_β ≫ (snd_P ∣_ D_P β) = ι_C := by
            rw [← cancel_mono (D_P β).ι, Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
              ← Category.assoc, hΨ_ι, CategoryTheory.Limits.pullback.lift_snd]
          have : AlgebraicGeometry.IsSeparated Ψ_β := by
            have : AlgebraicGeometry.IsSeparated (Ψ_β ≫ (snd_P ∣_ D_P β)) := by
              rw [hΨ_snd]
              infer_instance
            exact AlgebraicGeometry.IsSeparated.of_comp Ψ_β (snd_P ∣_ D_P β)
          have hV_eq : V_β = ι_lift ⁻¹ᵁ W_Z := by
            ext x
            change ι_P.base x ∈ D_P β ↔ (ι_lift ≫ snd_P).base x ∈ D_P β
            rw [CategoryTheory.Limits.pullback.lift_snd]
          have hq_Ψ : q_β ≫ Ψ_β = (Z'.isoOfEq hV_eq).hom ≫ (ι_lift ∣_ W_Z) := by
            rw [← cancel_mono W_Z.ι, Category.assoc q_β, hΨ_ι,
              Category.assoc (Z'.isoOfEq hV_eq).hom, AlgebraicGeometry.morphismRestrict_ι,
              ← Category.assoc (Z'.isoOfEq hV_eq).hom, AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
            apply CategoryTheory.Limits.pullback.hom_ext
            · dsimp only [γ_C, ι_lift, fst_P]
              rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hqβ_ψβ,
                Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
            · dsimp only [γ_C, ι_lift, snd_P]
              rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, ← Category.assoc,
                hqβ_ιC, AlgebraicGeometry.morphismRestrict_ι,
                Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
          have : AlgebraicGeometry.IsClosedImmersion (q_β ≫ Ψ_β) := by
            rw [hq_Ψ]
            exact AlgebraicGeometry.IsClosedImmersion.comp _ _
          have : AlgebraicGeometry.IsClosedImmersion q_β :=
            AlgebraicGeometry.IsClosedImmersion.of_comp q_β Ψ_β
          change AlgebraicGeometry.IsClosedImmersion f_β
          rw [← hqβ_ιC]
          exact AlgebraicGeometry.IsClosedImmersion.comp _ _

    exact ⟨Z', π, ι_proj, hProp_π, hIso_U,
      hStep4 (AlgebraicGeometry.Proj 𝒜) π_Proj Φ D hCovD hAffD z hz_basic hShift hRecov
        ι_proj hComm hProp_proj hν_proj hCl_lift,
      hComm⟩

  obtain ⟨Z', π, ι_proj, hProp_π, hIso_U, hCl_proj, hComm⟩ := hPart34
  exact ⟨U_dense, N, Z', π, ι_proj, hU_nonempty, hAffU_dense, hProp_π, hIso_U, hCl_proj, hComm⟩

theorem weil_laurent_monomial_cech_cohomology_finite (B : Type u) [CommRing B] (N : ℕ) (d : ℤ) :
    (∃ (k₀ : ℕ) (gen₀ : Fin k₀ → WeilStrictMonoTuple (N + 1) 0 → ((Fin (N + 1) → ℤ) →₀ B)),
      (∀ j : Fin k₀,
        IsValidLaurentCochain B N d 0 (gen₀ j) ∧ weilLaurentCechDiff B N 0 (gen₀ j) = 0) ∧
      ∀ z : WeilStrictMonoTuple (N + 1) 0 → ((Fin (N + 1) → ℤ) →₀ B),
        IsValidLaurentCochain B N d 0 z →
        weilLaurentCechDiff B N 0 z = 0 →
        ∃ c : Fin k₀ → B, z = ∑ j : Fin k₀, c j • gen₀ j) ∧
    (∀ p : ℕ,
      ∃ (k : ℕ) (gen : Fin k → WeilStrictMonoTuple (N + 1) (p + 1) → ((Fin (N + 1) → ℤ) →₀ B)),
        (∀ j : Fin k,
          IsValidLaurentCochain B N d (p + 1) (gen j) ∧
          weilLaurentCechDiff B N (p + 1) (gen j) = 0) ∧
        ∀ z : WeilStrictMonoTuple (N + 1) (p + 1) → ((Fin (N + 1) → ℤ) →₀ B),
          IsValidLaurentCochain B N d (p + 1) z →
          weilLaurentCechDiff B N (p + 1) z = 0 →
          ∃ (c : Fin k → B) (b : WeilStrictMonoTuple (N + 1) p → ((Fin (N + 1) → ℤ) →₀ B)),
            IsValidLaurentCochain B N d p b ∧
            z = (∑ j : Fin k, c j • gen j) + weilLaurentCechDiff B N p b) :=
by
  classical
  let face : ∀ {m r : ℕ}, Fin (r + 2) → WeilStrictMonoTuple m (r + 1) → WeilStrictMonoTuple m r :=
    fun j β => ⟨fun k => β.1 (j.succAbove k), β.2.comp (Fin.strictMono_succAbove j)⟩
  have hTupleEq : ∀ {m r : ℕ} (α₁ α₂ : WeilStrictMonoTuple m r),
      Set.range α₁.1 = Set.range α₂.1 → α₁ = α₂ := by
    intro m r α₁ α₂ hRange
    exact Subtype.ext ((StrictMono.range_inj_of_wellFoundedLT α₁.2 α₂.2).mp hRange)
  have hFaceRange : ∀ {m r : ℕ} (u : Fin (r + 2)) (β : WeilStrictMonoTuple m (r + 1)),
      Set.range (face u β).1 = Set.range β.1 \ {β.1 u} := by
    intro m r u β
    ext x
    simp only [Set.mem_range, Set.mem_sdiff, Set.mem_singleton_iff]
    constructor
    · rintro ⟨k, rfl⟩
      refine ⟨⟨u.succAbove k, rfl⟩, ?_⟩
      intro hEq
      exact Fin.succAbove_ne u k (β.2.injective hEq)
    · rintro ⟨⟨w, rfl⟩, hNe⟩
      have hwu : w ≠ u := fun h => hNe (congrArg β.1 h)
      obtain ⟨k, hk⟩ := Fin.exists_succAbove_eq hwu
      exact ⟨k, congrArg β.1 hk⟩
  have hFin1Eq0 : ∀ l : Fin (0 + 1), l = 0 := fun l =>
    Fin.ext (by have := l.isLt; rw [Fin.val_zero]; omega)
  refine ⟨?_, ?_⟩
  · cases N with
    | zero =>
      let α₀ : WeilStrictMonoTuple 1 0 :=
        ⟨fun _ => 0, fun x y hxy => by
          have hx := x.isLt
          have hy := y.isLt
          have hlt : (x : ℕ) < (y : ℕ) := hxy
          omega⟩
      have hα_uniq : ∀ α : WeilStrictMonoTuple 1 0, α = α₀ := by
        intro α
        apply Subtype.ext
        funext l
        exact hFin1Eq0 (α.1 l)
      have hβ_empty : ∀ β : WeilStrictMonoTuple 1 1, False := by
        intro β
        have hlt : (β.1 0 : ℕ) < (β.1 1 : ℕ) := β.2 (by decide : (0 : Fin 2) < 1)
        have h0 := (β.1 0).isLt
        have h1 := (β.1 1).isLt
        omega
      let a₀ : Fin 1 → ℤ := fun _ => d
      have ha₀_valid : ∀ α : WeilStrictMonoTuple 1 0, IsValidLaurentExp 0 d α a₀ := by
        intro α
        refine ⟨by simp [a₀], ?_⟩
        intro j hj
        exact False.elim (hj 0 ((hFin1Eq0 (α.1 0)).trans (hFin1Eq0 j).symm))
