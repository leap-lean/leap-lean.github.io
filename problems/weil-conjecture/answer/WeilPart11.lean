                  exact Finset.sum_congr rfl fun j _ => hΘ_smul (p + 1) (c j) (gen j)
    · rintro ⟨⟨k₀, gen₀, hgen₀_ker, hgen₀_span⟩, hSucc⟩
      refine ⟨⟨k₀, fun j => Θ_inv 0 (gen₀ j), ?_, ?_⟩, ?_⟩
      · intro j; rw [← hΘ_inv_diff 0 (gen₀ j), hgen₀_ker j, hΘ_inv_zero 1]
