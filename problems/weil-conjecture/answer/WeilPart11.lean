              fun i a =>
                (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV a))).op).hom
                  ((w'.app _).hom (e_raw i (eIdx a)))
            (∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M' ⊤ (e' i)) ∧
            (∀ s' : ∀ a : Fin M'.m, ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))),
              IsWeilTricanonicalSection M' ⊤ s' →
              ∃! c : Fin (r₀ + 1) → R',
                ∀ a : Fin M'.m,
                  s' a = ∑ i : Fin (r₀ + 1),
                    (C'.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M'.V a ≤ ⊤)).op).hom
                      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫
                        snd'.appTop).hom (c i)) * e' i a) ∧
            ∃ (j' : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) R') :=
                      MvPolynomial.gradedAlgebra
                    (⊤ : C'.Opens).toScheme ⟶
                      AlgebraicGeometry.Proj
                        (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) R')),
              IsLineBundleProjMorphism M' ⊤
                ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫ snd'.appTop).hom
                r₀ e' j' ∧
              AlgebraicGeometry.IsClosedImmersion j') →
      ∀ (ι : Localization.Away h_raw →+* B_h),
        ι.comp (algebraMap R (Localization.Away h_raw)) = ρ_h →
        let u_h := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_h)
        let M_pb : ∀ (R' : Type u) [CommRing R'] (ρ' : R →+* R'),
            WeilLineBundle (CategoryTheory.Limits.pullback g
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ'))) :=
          fun R' _ ρ' =>
            pullBundle (CategoryTheory.Limits.pullback.fst g
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ'))) M
        let eIdx : ∀ (R' : Type u) [CommRing R'] (ρ' : R →+* R'),
            Fin (M_pb R' ρ').m ≃ Fin M.m :=
          fun _ _ _ => Equiv.refl (Fin M.m)
        let M_h := M_pb B_h ρ_h
        ∃ (e_h : Fin (r₀ + 1) → ∀ a : Fin M_h.m,
            ↑((CategoryTheory.Limits.pullback g u_h).presheaf.obj (Opposite.op (⊤ ⊓ M_h.V a)))),
          ∀ (R' : Type u) [CommRing R'] (ρ' : R →+* R') (ψ : B_h →+* R'),
            ψ.comp ρ_h = ρ' →
            let u' := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ')
            let C' := CategoryTheory.Limits.pullback g u'
            let snd' := CategoryTheory.Limits.pullback.snd g u'
            let M' := M_pb R' ρ'
            let eIdx_h : Fin M'.m ≃ Fin M_h.m := (eIdx R' ρ').trans (eIdx B_h ρ_h).symm
            ∀ (w : C' ⟶ CategoryTheory.Limits.pullback g u_h),
              w ≫ CategoryTheory.Limits.pullback.fst g u_h =
                CategoryTheory.Limits.pullback.fst g u' →
              w ≫ CategoryTheory.Limits.pullback.snd g u_h =
                snd' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) →
              ∃ (hV_w : ∀ a : Fin M'.m,
                  ⊤ ⊓ M'.V a =
                    (TopologicalSpace.Opens.map w.base).obj (⊤ ⊓ M_h.V (eIdx_h a))),
                let e' : Fin (r₀ + 1) → ∀ a : Fin M'.m,
                    ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))) :=
                  fun i a =>
                    (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV_w a))).op).hom
                      ((w.app _).hom (e_h i (eIdx_h a)))
                (∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M' ⊤ (e' i)) ∧
                (∀ s' : ∀ a : Fin M'.m, ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))),
                  IsWeilTricanonicalSection M' ⊤ s' →
                  ∃! c : Fin (r₀ + 1) → R',
                    ∀ a : Fin M'.m,
                      s' a = ∑ i : Fin (r₀ + 1),
                        (C'.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M'.V a ≤ ⊤)).op).hom
                          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫
                            snd'.appTop).hom (c i)) * e' i a) ∧
                (∃ (j' : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) R') :=
                           MvPolynomial.gradedAlgebra
                         (⊤ : C'.Opens).toScheme ⟶
                           AlgebraicGeometry.Proj
                             (MvPolynomial.homogeneousSubmodule (Fin (r₀ + 1)) R')),
                  IsLineBundleProjMorphism M' ⊤
                    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫ snd'.appTop).hom
                    r₀ e' j' ∧
                  AlgebraicGeometry.IsClosedImmersion j') ∧
                (∀ (R'' : Type u) [CommRing R''] (ρ'' : R →+* R'')
                  (w'' : CategoryTheory.Limits.pullback g
                      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ'')) ⟶
                    CategoryTheory.Limits.pullback g u_h)
                  (w₁₂ : CategoryTheory.Limits.pullback g
                      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ'')) ⟶ C')
                  (hV_w'' : ∀ a : Fin (M_pb R'' ρ'').m,
                    ⊤ ⊓ (M_pb R'' ρ'').V a =
                      (TopologicalSpace.Opens.map w''.base).obj
                        (⊤ ⊓ M_h.V (((eIdx R'' ρ'').trans (eIdx B_h ρ_h).symm) a))),
                  w₁₂ ≫ w = w'' →
                  ∃ (hV₁₂ : ∀ a : Fin (M_pb R'' ρ'').m,
                      ⊤ ⊓ (M_pb R'' ρ'').V a =
                        (TopologicalSpace.Opens.map w₁₂.base).obj
                          (⊤ ⊓ M'.V (((eIdx R'' ρ'').trans (eIdx R' ρ').symm) a))),
                    ∀ (i : Fin (r₀ + 1)) (a : Fin (M_pb R'' ρ'').m),
                      ((CategoryTheory.Limits.pullback g
                          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ''))).presheaf.map
                        (CategoryTheory.homOfLE (le_of_eq (hV_w'' a))).op).hom
                          ((w''.app _).hom (e_h i (((eIdx R'' ρ'').trans (eIdx B_h ρ_h).symm) a))) =
                      ((CategoryTheory.Limits.pullback g
                          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ''))).presheaf.map
                        (CategoryTheory.homOfLE (le_of_eq (hV₁₂ a))).op).hom
                          ((w₁₂.app _).hom (e' i (((eIdx R'' ρ'').trans (eIdx R' ρ').symm) a)))) := by
    intro C g M h_raw r₀ e_raw hUniv_raw ι hι
    let ρ_raw : R →+* Localization.Away h_raw := algebraMap R (Localization.Away h_raw)
    let u_raw := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_raw)
    let u_h := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_h)
    let M_pb : ∀ (R' : Type u) [CommRing R'] (ρ' : R →+* R'),
        WeilLineBundle (CategoryTheory.Limits.pullback g
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ'))) :=
      fun R' _ ρ' =>
        pullBundle (CategoryTheory.Limits.pullback.fst g
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ'))) M
    let M_h := M_pb B_h ρ_h
    have hu_h : u_h = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι) ≫ u_raw := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_h) = _
      rw [← hι, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    let w_h : CategoryTheory.Limits.pullback g u_h ⟶ CategoryTheory.Limits.pullback g u_raw :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g u_h)
        (CategoryTheory.Limits.pullback.snd g u_h ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι))
        (by rw [CategoryTheory.Category.assoc, ← hu_h, CategoryTheory.Limits.pullback.condition])
    have hw_h_fst : w_h ≫ CategoryTheory.Limits.pullback.fst g u_raw =
        CategoryTheory.Limits.pullback.fst g u_h :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hw_h_snd : w_h ≫ CategoryTheory.Limits.pullback.snd g u_raw =
        CategoryTheory.Limits.pullback.snd g u_h ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι) :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hV_h0 : ∀ a : Fin M.m,
        ⊤ ⊓ M_h.V a =
          (TopologicalSpace.Opens.map w_h.base).obj
            (⊤ ⊓ (TopologicalSpace.Opens.map
              (CategoryTheory.Limits.pullback.fst g u_raw).base).obj (M.V a)) := by
      intro a
      ext x
      change True ∧ x ∈ (TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.fst g u_h).base).obj (M.V a) ↔
        True ∧ w_h.base x ∈ (TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.fst g u_raw).base).obj (M.V a)
      simp only [true_and]
      rw [← hw_h_fst, AlgebraicGeometry.Scheme.Hom.comp_base]
      rfl
    let e_h : Fin (r₀ + 1) → ∀ a : Fin M_h.m,
        ↑((CategoryTheory.Limits.pullback g u_h).presheaf.obj (Opposite.op (⊤ ⊓ M_h.V a))) :=
      fun i a =>
        ((CategoryTheory.Limits.pullback g u_h).presheaf.map
          (CategoryTheory.homOfLE (le_of_eq (hV_h0 a))).op).hom
          ((w_h.app _).hom (e_raw i a))
    refine ⟨e_h, ?_⟩
    intro R' _ ρ' ψ hψ
    let ψ_raw : Localization.Away h_raw →+* R' := ψ.comp ι
    have h_comp : ψ_raw.comp ρ_raw = ρ' := by
      change (ψ.comp ι).comp ρ_raw = ρ'
      rw [RingHom.comp_assoc, hι, hψ]
    clear hψ
    subst h_comp
    intro u' C' snd' M' eIdx_h w hw_fst hw_snd
    have hV_w : ∀ a : Fin M'.m,
        ⊤ ⊓ M'.V a =
          (TopologicalSpace.Opens.map w.base).obj (⊤ ⊓ M_h.V a) := by
      intro a
      ext x
      change True ∧ x ∈ (TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.fst g u').base).obj (M.V a) ↔
        True ∧ w.base x ∈ (TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.fst g u_h).base).obj (M.V a)
      simp only [true_and]
      rw [← hw_fst, AlgebraicGeometry.Scheme.Hom.comp_base]
      rfl
    let w' : C' ⟶ CategoryTheory.Limits.pullback g u_raw := w ≫ w_h
    have hw'_fst : w' ≫ CategoryTheory.Limits.pullback.fst g u_raw =
        CategoryTheory.Limits.pullback.fst g u' := by
      change (w ≫ w_h) ≫ _ = _
      rw [CategoryTheory.Category.assoc, hw_h_fst, hw_fst]
    have hw'_snd : w' ≫ CategoryTheory.Limits.pullback.snd g u_raw =
        snd' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_raw) := by
      change (w ≫ w_h) ≫ _ = _
      rw [CategoryTheory.Category.assoc, hw_h_snd, ← CategoryTheory.Category.assoc, hw_snd,
        CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hV_BC : ∀ a : Fin M'.m,
        ⊤ ⊓ M'.V a =
          (TopologicalSpace.Opens.map w'.base).obj
            (⊤ ⊓ (TopologicalSpace.Opens.map
              (CategoryTheory.Limits.pullback.fst g u_raw).base).obj (M.V a)) := by
      intro a
      ext x
      change True ∧ x ∈ (TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.fst g u').base).obj (M.V a) ↔
        True ∧ w'.base x ∈ (TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.fst g u_raw).base).obj (M.V a)
      simp only [true_and]
      rw [← hw'_fst, AlgebraicGeometry.Scheme.Hom.comp_base]
      rfl
    obtain ⟨hTri_BC, hBas_BC, j', hj'_proj, hj'_cl⟩ :=
      hUniv_raw R' ψ_raw w' hw'_fst hw'_snd M' (Equiv.refl (Fin M.m)) hV_BC
        (hPbCompat (CategoryTheory.Limits.pullback.fst g u') M).2
    refine ⟨hV_w, ?_⟩
    let e'_w : Fin (r₀ + 1) → ∀ a : Fin M'.m,
        ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))) :=
      fun i a =>
        (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV_w a))).op).hom
          ((w.app _).hom (e_h i a))
    let e'_BC : Fin (r₀ + 1) → ∀ a : Fin M'.m,
        ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))) :=
      fun i a =>
        (C'.presheaf.map (CategoryTheory.homOfLE (le_of_eq (hV_BC a))).op).hom
          ((w'.app _).hom (e_raw i a))
    have he_eq : e'_w = e'_BC := by
      funext i a
      exact hAppLE_twoStep w w_h w' rfl _ _ _
        (le_of_eq (hV_h0 a)) (le_of_eq (hV_w a)) (le_of_eq (hV_BC a)) (e_raw i a)
    refine ⟨?_, ?_, ?_, ?_⟩
    · change ∀ i : Fin (r₀ + 1), IsWeilTricanonicalSection M' ⊤ (e'_w i)
      rw [he_eq]
      exact hTri_BC
    · change ∀ s' : ∀ a : Fin M'.m, ↑(C'.presheaf.obj (Opposite.op (⊤ ⊓ M'.V a))),
        IsWeilTricanonicalSection M' ⊤ s' →
        ∃! c : Fin (r₀ + 1) → R',
          ∀ a : Fin M'.m,
            s' a = ∑ i : Fin (r₀ + 1),
              (C'.presheaf.map (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M'.V a ≤ ⊤)).op).hom
                (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫
                  snd'.appTop).hom (c i)) * e'_w i a
      rw [he_eq]
      exact hBas_BC
    · refine ⟨j', ?_, hj'_cl⟩
      change IsLineBundleProjMorphism M' ⊤
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫ snd'.appTop).hom
        r₀ e'_w j'
      rw [he_eq]
      exact hj'_proj
    · intro R'' _ ρ'' w'' w₁₂ hV_w'' hw₁₂
      have hV₁₂ : ∀ a : Fin (M_pb R'' ρ'').m,
          ⊤ ⊓ (M_pb R'' ρ'').V a =
            (TopologicalSpace.Opens.map w₁₂.base).obj (⊤ ⊓ M'.V a) := by
        intro a
        calc ⊤ ⊓ (M_pb R'' ρ'').V a
            = (TopologicalSpace.Opens.map w''.base).obj (⊤ ⊓ M_h.V a) := hV_w'' a
          _ = (TopologicalSpace.Opens.map w₁₂.base).obj
                ((TopologicalSpace.Opens.map w.base).obj (⊤ ⊓ M_h.V a)) := by
              rw [← hw₁₂]
              ext x
              simp only [TopologicalSpace.Opens.map_coe, Set.mem_preimage,
                AlgebraicGeometry.Scheme.Hom.comp_base]
              rfl
          _ = (TopologicalSpace.Opens.map w₁₂.base).obj (⊤ ⊓ M'.V a) := by
              rw [← hV_w a]
      refine ⟨hV₁₂, fun i a => ?_⟩
      exact (hAppLE_twoStep w₁₂ w w'' hw₁₂ _ _ _
        (le_of_eq (hV_w a)) (le_of_eq (hV₁₂ a)) (le_of_eq (hV_w'' a)) (e_h i a)).symm
  obtain ⟨e₁_h, hUniv₁⟩ :=
    hSingleCurve C₁ g₁ M₁ h₁ r₁ e₁_raw hUniv₁_raw ι₁ hι₁
  obtain ⟨e₂_h, hUniv₂⟩ :=
    hSingleCurve C₂ g₂ M₂ h₂ r₂ e₂_raw hUniv₂_raw ι₂ hι₂
  exact ⟨h₀, hh₀, r₁, r₂, M₁_pb, eIdx₁, M₂_pb, eIdx₂, hr₁, hr₂,
    fun R' _ ρ' => hPbCompat _ M₁,
    fun R' _ ρ' => hPbCompat _ M₂,
    e₁_h, e₂_h, hUniv₁, hUniv₂⟩

theorem weil_cocycle_section_pullback_and_basis_matrix (R : Type u) [CommRing R] (n : ℕ)
    (C₁ C₂ : AlgebraicGeometry.Scheme.{u})
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₁))
    (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₂))
    (M₁ : WeilLineBundle C₁) (M₂ : WeilLineBundle C₂)
    (hCoc : HasPointedCurveIsoCocycle g₁ τ₁ g₂ τ₂ M₁ M₂)
    (L : Type u) [Field L] (ρ_L : R →+* L)
    (φ_L : CategoryTheory.Limits.pullback g₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L)) ≅
      CategoryTheory.Limits.pullback g₂ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L)))
    (hφL_snd : φ_L.hom ≫
        CategoryTheory.Limits.pullback.snd g₂ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L)) =
      CategoryTheory.Limits.pullback.snd g₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L)))
    (hφL_sec : ∀ j : Fin n,
      ∀ s₁ : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶
          CategoryTheory.Limits.pullback g₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L)),
        s₁ ≫ CategoryTheory.Limits.pullback.fst g₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L) ≫ τ₁ j →
        s₁ ≫ CategoryTheory.Limits.pullback.snd g₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L)) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of L)) →
        (s₁ ≫ φ_L.hom) ≫ CategoryTheory.Limits.pullback.fst g₂
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L) ≫ τ₂ j)
    (M₁_L : WeilLineBundle
      (CategoryTheory.Limits.pullback g₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))))
    (eIdx₁_L : Fin M₁_L.m ≃ Fin M₁.m)
    (hV₁_L : ∀ a : Fin M₁_L.m,
      M₁_L.V a =
        (TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.fst g₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).base).obj
          (M₁.V (eIdx₁_L a)))
    (hU₁_L : ∀ a a' : Fin M₁_L.m,
      ∀ hEq : M₁_L.V a ⊓ M₁_L.V a' =
          (TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.fst g₁
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).base).obj
            (M₁.V (eIdx₁_L a) ⊓ M₁.V (eIdx₁_L a')),
        ((CategoryTheory.Limits.pullback g₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).presheaf.map
          (CategoryTheory.homOfLE (le_of_eq hEq.symm)).op).hom (M₁_L.u a a').val =
          ((CategoryTheory.Limits.pullback.fst g₁
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).app
            (M₁.V (eIdx₁_L a) ⊓ M₁.V (eIdx₁_L a'))).hom
            (M₁.u (eIdx₁_L a) (eIdx₁_L a')).val)
    (M₂_L : WeilLineBundle
      (CategoryTheory.Limits.pullback g₂ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))))
    (eIdx₂_L : Fin M₂_L.m ≃ Fin M₂.m)
    (hV₂_L : ∀ b : Fin M₂_L.m,
      M₂_L.V b =
        (TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.fst g₂
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).base).obj
          (M₂.V (eIdx₂_L b)))
    (hU₂_L : ∀ b b' : Fin M₂_L.m,
      ∀ hEq : M₂_L.V b ⊓ M₂_L.V b' =
          (TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.fst g₂
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).base).obj
            (M₂.V (eIdx₂_L b) ⊓ M₂.V (eIdx₂_L b')),
        ((CategoryTheory.Limits.pullback g₂
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).presheaf.map
          (CategoryTheory.homOfLE (le_of_eq hEq.symm)).op).hom (M₂_L.u b b').val =
          ((CategoryTheory.Limits.pullback.fst g₂
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).app
            (M₂.V (eIdx₂_L b) ⊓ M₂.V (eIdx₂_L b'))).hom
            (M₂.u (eIdx₂_L b) (eIdx₂_L b')).val)
    (r₁ r₂ : ℕ)
    (e₁_L : Fin (r₁ + 1) → ∀ a : Fin M₁_L.m,
      ↑((CategoryTheory.Limits.pullback g₁
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).presheaf.obj
        (Opposite.op (⊤ ⊓ M₁_L.V a))))
    (he₁_L_tri : ∀ i : Fin (r₁ + 1), IsWeilTricanonicalSection M₁_L ⊤ (e₁_L i))
    (he₁_L_bas : ∀ s : ∀ a : Fin M₁_L.m,
        ↑((CategoryTheory.Limits.pullback g₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).presheaf.obj
          (Opposite.op (⊤ ⊓ M₁_L.V a))),
      IsWeilTricanonicalSection M₁_L ⊤ s →
      ∃! c : Fin (r₁ + 1) → L,
        ∀ a : Fin M₁_L.m,
          s a = ∑ i : Fin (r₁ + 1),
            ((CategoryTheory.Limits.pullback g₁
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M₁_L.V a ≤ ⊤)).op).hom
              (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).inv ≫
                (CategoryTheory.Limits.pullback.snd g₁
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).appTop).hom (c i)) *
              e₁_L i a)
    (e₂_L : Fin (r₂ + 1) → ∀ b : Fin M₂_L.m,
      ↑((CategoryTheory.Limits.pullback g₂
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).presheaf.obj
        (Opposite.op (⊤ ⊓ M₂_L.V b))))
    (he₂_L_tri : ∀ j : Fin (r₂ + 1), IsWeilTricanonicalSection M₂_L ⊤ (e₂_L j))
    (he₂_L_bas : ∀ s : ∀ b : Fin M₂_L.m,
        ↑((CategoryTheory.Limits.pullback g₂
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).presheaf.obj
          (Opposite.op (⊤ ⊓ M₂_L.V b))),
      IsWeilTricanonicalSection M₂_L ⊤ s →
      ∃! c : Fin (r₂ + 1) → L,
        ∀ b : Fin M₂_L.m,
          s b = ∑ j : Fin (r₂ + 1),
            ((CategoryTheory.Limits.pullback g₂
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M₂_L.V b ≤ ⊤)).op).hom
              (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).inv ≫
                (CategoryTheory.Limits.pullback.snd g₂
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L))).appTop).hom (c j)) *
              e₂_L j b) :
    let η_L := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_L)
    let C₁_L := CategoryTheory.Limits.pullback g₁ η_L
    let snd₁_L := CategoryTheory.Limits.pullback.snd g₁ η_L
    ∃ (h_r : r₁ = r₂) (M : Matrix.GeneralLinearGroup (Fin (r₁ + 1)) L),
      (∀ (a : Fin M₁_L.m) (b : Fin M₂_L.m),
        let W_ab : C₁_L.Opens :=
          (⊤ ⊓ M₁_L.V a) ⊓ (TopologicalSpace.Opens.map φ_L.hom.base).obj (⊤ ⊓ M₂_L.V b)
        ∃ u_ab : (↑(C₁_L.presheaf.obj (Opposite.op W_ab)))ˣ,
          ∀ j : Fin (r₁ + 1),
            (C₁_L.presheaf.map
                (CategoryTheory.homOfLE (inf_le_left : W_ab ≤ ⊤ ⊓ M₁_L.V a)).op).hom
              (∑ i : Fin (r₁ + 1),
                (C₁_L.presheaf.map
                    (CategoryTheory.homOfLE (inf_le_left : ⊤ ⊓ M₁_L.V a ≤ ⊤)).op).hom
                  (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).inv ≫
                    snd₁_L.appTop).hom (M.val i j)) * e₁_L i a) =
            u_ab.val *
              (C₁_L.presheaf.map
                  (CategoryTheory.homOfLE
                    (inf_le_right : W_ab ≤
                      (TopologicalSpace.Opens.map φ_L.hom.base).obj (⊤ ⊓ M₂_L.V b))).op).hom
                ((φ_L.hom.app (⊤ ⊓ M₂_L.V b)).hom
                  (e₂_L (Fin.cast (congrArg (· + 1) h_r) j) b))) ∧
      (∀ (R' : Type u) [CommRing R'] [IsNoetherianRing R'] (ρ' : R →+* R') (ψ : R' →+* L),
        ψ.comp ρ' = ρ_L →
        let u' := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ')
        let C₁' := CategoryTheory.Limits.pullback g₁ u'
        let C₂' := CategoryTheory.Limits.pullback g₂ u'
        let fst₁' := CategoryTheory.Limits.pullback.fst g₁ u'
        let snd₁' := CategoryTheory.Limits.pullback.snd g₁ u'
        let fst₂' := CategoryTheory.Limits.pullback.fst g₂ u'
        let snd₂' := CategoryTheory.Limits.pullback.snd g₂ u'
        ∀ (φ' : C₁' ≅ C₂'),
          φ'.hom ≫ snd₂' = snd₁' →
          (∀ j : Fin n, ∀ s₁ : AlgebraicGeometry.Spec (CommRingCat.of R') ⟶ C₁',
            s₁ ≫ fst₁' = u' ≫ τ₁ j →
            s₁ ≫ snd₁' = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R')) →
            (s₁ ≫ φ'.hom) ≫ fst₂' = u' ≫ τ₂ j) →
          ∀ (M₁' : WeilLineBundle C₁') (eIdx₁' : Fin M₁'.m ≃ Fin M₁.m),
            (∀ a : Fin M₁'.m,
              M₁'.V a = (TopologicalSpace.Opens.map fst₁'.base).obj (M₁.V (eIdx₁' a))) →
            (∀ a a' : Fin M₁'.m,
              ∀ hEq : M₁'.V a ⊓ M₁'.V a' =
                  (TopologicalSpace.Opens.map fst₁'.base).obj (M₁.V (eIdx₁' a) ⊓ M₁.V (eIdx₁' a')),
