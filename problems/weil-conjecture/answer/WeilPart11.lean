            = Polynomial.aeval t (Polynomial.derivative (P_num j)) * qv -
                (H.coeff j * qv) * Polynomial.aeval t (Polynomial.derivative (Q_den j)) := by ring
          _ = Polynomial.aeval t (Polynomial.derivative (P_num j)) * qv -
                Polynomial.aeval t (P_num j) * Polynomial.aeval t (Polynomial.derivative (Q_den j)) := by
              rw [hHQ_eq j]
