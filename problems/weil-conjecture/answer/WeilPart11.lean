      res_id := fun U x => Subtype.ext (hE_res_id U 0 x.1)
      res_comp := fun h₁ h₂ x => Subtype.ext (hE_res_comp h₁ h₂ 0 x.1) }
  let Kq_sub : ∀ (U : Z.Opens) (q : ℕ),
      @Submodule ↑(Z.presheaf.obj (Opposite.op U)) (E_sec U (q + 1)) _ _ (instModE U (q + 1)) :=
    fun U q =>
      letI := instModE U (q + 1)
      letI := instModE U (q + 2)
      LinearMap.ker (dv_lin U (q + 1))
  let Bq_sub : ∀ (U : Z.Opens) (q : ℕ),
      @Submodule ↑(Z.presheaf.obj (Opposite.op U)) ↥(Kq_sub U q) _ _
