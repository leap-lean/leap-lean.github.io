      intro U j k hUj hUk
      have hjk : X_var j * X_var k ∈ 𝒜₀ 2 := SetLike.mul_mem_graded (hj j) (hj k)
      have h1_mem : (1 : A) ∈ 𝒜₀ 0 := SetLike.one_mem_graded 𝒜₀
      have hx_kj : X_var j * X_var k = (X_var k * X_var j) * 1 := by ring
      have hU_jk : U ≤ AlgebraicGeometry.Proj.basicOpen 𝒜₀ (X_var j * X_var k) :=
