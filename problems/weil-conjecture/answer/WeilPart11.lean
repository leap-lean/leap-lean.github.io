          obtain ⟨⟨r, t⟩, hsurj_y⟩ := IsLocalization.surj p_z.asIdeal.primeCompl y
          have hy_eq : ι_R y * φ_W.hom t.1 = φ_W.hom r := by
            have hv := congrArg ι_R hsurj_y
            simpa only [map_mul, ι_R, IsLocalization.lift_eq] using hv
          have hPz_W : hW.fromSpec.base p_z ∈ W := by
            have hmem : hW.fromSpec.base p_z ∈ Set.range hW.fromSpec.base := ⟨p_z, rfl⟩
            rwa [hW.range_fromSpec] at hmem
          have hPz_cl : IsClosed ({hW.fromSpec.base p_z} : Set E_sm) := by rwa [hPz_eq]
          have hr_ord : (0 : WithTop ℤ) ≤ ord (hW.fromSpec.base p_z) (φ_W.hom r) :=
            (hRangeW (φ_W.hom r)).mp ⟨r, rfl⟩ _ hPz_W hPz_cl
          have ht_ord0 : (0 : WithTop ℤ) ≤ ord (hW.fromSpec.base p_z) (φ_W.hom t.1) :=
            (hRangeW (φ_W.hom t.1)).mp ⟨t.1, rfl⟩ _ hPz_W hPz_cl
          have ht_not1 : ¬((1 : WithTop ℤ) ≤ ord (hW.fromSpec.base p_z) (φ_W.hom t.1)) :=
            fun h1 => t.2 ((hPrimeW p_z hPz_cl t.1).mpr h1)
          have ht_zero : ord (hW.fromSpec.base p_z) (φ_W.hom t.1) = (0 : WithTop ℤ) :=
            (hOrd_unit _ hPz_cl _ ht_ord0 ht_not1).2.1
          have hy_ord : (0 : WithTop ℤ) ≤ ord (U_f.ι.base (e_W.base p_z)) (ι_R y) := by
            rw [← hPz_eq]
            have hmul : ord (hW.fromSpec.base p_z) (ι_R y * φ_W.hom t.1) =
                ord (hW.fromSpec.base p_z) (ι_R y) := by
              rw [(hVal _ hPz_cl).2.1, ht_zero, add_zero]
            rwa [← hy_eq, hmul] at hr_ord
          obtain ⟨a, s, hs_not, hsy⟩ := (hOrd_frac (ι_R y)).mp hy_ord
          rw [← hq_𝔪] at hs_not
          let s_sub : q.asIdeal.primeCompl := ⟨s, hs_not⟩
          let u : Localization.AtPrime q.asIdeal :=
            IsLocalization.mk' (Localization.AtPrime q.asIdeal) a s_sub
          have hspec := congrArg ι_B
            (IsLocalization.mk'_spec' (Localization.AtPrime q.asIdeal) a s_sub)
          simp only [map_mul, ι_B, IsLocalization.lift_eq] at hspec
          change (s : F) * ι_B u = (a : F) at hspec
          have hs0 : (s : F) ≠ 0 := by
            intro h0
            have hs0' : s = 0 := Subtype.ext h0
            exact hs_not (by rw [hs0']; exact q.asIdeal.zero_mem)
          exact ⟨u, mul_left_cancel₀ hs0 (hspec.trans hsy.symm)⟩
        · obtain ⟨_, hq_bot⟩ := (hBase_ideal (e_W.base p_z)).1 hcl
          have hq_bot' : q.asIdeal = ⊥ := by rwa [hq_eq_π]
          obtain ⟨a, s, hs_nzd, hdiv⟩ := IsFractionRing.div_surjective (A := ↥B) (ι_R y)
          change (a : F) / (s : F) = ι_R y at hdiv
          have hs_ne : s ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hs_nzd
          have hs_not : s ∉ q.asIdeal := by
            rw [hq_bot', Ideal.mem_bot]
            exact hs_ne
          let s_sub : q.asIdeal.primeCompl := ⟨s, hs_not⟩
          let u : Localization.AtPrime q.asIdeal :=
            IsLocalization.mk' (Localization.AtPrime q.asIdeal) a s_sub
          have hspec := congrArg ι_B
            (IsLocalization.mk'_spec' (Localization.AtPrime q.asIdeal) a s_sub)
          simp only [map_mul, ι_B, IsLocalization.lift_eq] at hspec
          change (s : F) * ι_B u = (a : F) at hspec
          have hsF_ne : (s : F) ≠ 0 := fun h0 => hs_ne (Subtype.ext h0)
          refine ⟨u, ?_⟩
          rw [← hdiv, eq_div_iff hsF_ne, mul_comm]
          exact hspec
    let e_arr := AlgebraicGeometry.Scheme.arrowStalkMapSpecIso (CommRingCat.ofHom σ_W) p_z
    have hIso_gloc : CategoryTheory.IsIso (CommRingCat.ofHom g_loc) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective _).mpr hg_bij
    have hIso_spec : CategoryTheory.IsIso
        ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_W)).stalkMap p_z) :=
      ((CategoryTheory.MorphismProperty.isomorphisms CommRingCat).arrow_mk_iso_iff e_arr).mpr
        hIso_gloc
    have hOpen_eW : AlgebraicGeometry.IsOpenImmersion e_W := inferInstance
    have hIso_eW : CategoryTheory.IsIso (e_W.stalkMap p_z) := inferInstance
    have hIso_prod : CategoryTheory.IsIso (π_f.stalkMap (e_W.base p_z) ≫ e_W.stalkMap p_z) := by
      rw [← AlgebraicGeometry.Scheme.Hom.stalkMap_comp e_W π_f p_z,
        AlgebraicGeometry.Scheme.Hom.stalkMap_congr_hom (e_W ≫ π_f)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_W)) heW_πf p_z]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _
        (CategoryTheory.Iso.isIso_hom _) hIso_spec
    exact CategoryTheory.IsIso.of_isIso_comp_right (π_f.stalkMap (e_W.base p_z))
      (e_W.stalkMap p_z)
  have hIso_πf : CategoryTheory.IsIso π_f :=
    (AlgebraicGeometry.isIso_iff_isIso_stalkMap π_f).mpr ⟨hIsoBase, hIsoStalk⟩
  have hAff_Uf : AlgebraicGeometry.IsAffineOpen U_f :=
    AlgebraicGeometry.IsAffine.of_isIso π_f
  exact ⟨U_f, hAff_Uf, hUf_set, hUf_ne⟩

theorem weil_twoChart_polyEquiv_iso_projectiveLine (Ω : Type u) [Field Ω]
    (hAffProj : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen Ω 1 a))
    (c_proj : ∀ a : Fin (1 + 1),
      Ω →+* ↑((weilProjectiveSpaceOver Ω 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen Ω 1 a))))
    (t_proj : ∀ a : Fin (1 + 1), Fin (1 + 1) →
      ↑((weilProjectiveSpaceOver Ω 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen Ω 1 a))))
    (hCoord : IsCommRingProjCoordSystem Ω 1 hAffProj c_proj t_proj)
    (X : AlgebraicGeometry.Scheme.{u})
    (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (V₀ V₁ : X.Opens)
    (hV₀ : AlgebraicGeometry.IsAffineOpen V₀)
    (hV₁ : AlgebraicGeometry.IsAffineOpen V₁)
    (hCov : V₀ ⊔ V₁ = ⊤)
    (s₀ : ↑(X.presheaf.obj (Opposite.op V₀)))
    (s₁ : ↑(X.presheaf.obj (Opposite.op V₁)))
    (hInter₀ : V₀ ⊓ V₁ = X.basicOpen s₀)
    (hInter₁ : V₀ ⊓ V₁ = X.basicOpen s₁)
    (hRecip : (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom s₀ *
      (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom s₁ = 1)
    (hBij₀ : Function.Bijective (Polynomial.eval₂RingHom
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        p_X.appLE ⊤ V₀ le_top).hom) s₀))
    (hBij₁ : Function.Bijective (Polynomial.eval₂RingHom
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        p_X.appLE ⊤ V₁ le_top).hom) s₁)) :
    ∃ isoP1 : X ≅ (weilProjectiveSpaceOver Ω 1).left,
      isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom = p_X :=
by
  
  have hFromSpecBase : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
      (p_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      {W : Z.Opens} (hW : AlgebraicGeometry.IsAffineOpen W),
      hW.fromSpec ≫ p_Z =
        AlgebraicGeometry.Spec.map
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            p_Z.appLE ⊤ W le_top) := by
    intro Z p_Z W hW
    let SΩ := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    have hTop : AlgebraicGeometry.IsAffineOpen (⊤ : SΩ.Opens) :=
      AlgebraicGeometry.isAffineOpen_top SΩ
    have h1 := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p_Z hTop hW
      (le_top : W ≤ (TopologicalSpace.Opens.map p_Z.base).obj ⊤)
    rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top] at h1
    have hIso : SΩ.isoSpec.inv =
        AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv := by
      rw [AlgebraicGeometry.Scheme.isoSpec_Spec]
      rfl
    rw [hIso, ← AlgebraicGeometry.Spec.map_comp] at h1
    exact h1.symm
  have hBaseResCompat : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
      (p_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      {W₀ W₁ : Z.Opens}
      (hW₀ : AlgebraicGeometry.IsAffineOpen W₀)
      (hW₁ : AlgebraicGeometry.IsAffineOpen W₁)
      (hW₀₁ : AlgebraicGeometry.IsAffineOpen (W₀ ⊓ W₁)),
      ((Z.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀ ⊓ W₁ ≤ W₀)).op).hom).comp
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            p_Z.appLE ⊤ W₀ le_top).hom) =
        ((Z.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₀ ⊓ W₁ ≤ W₁)).op).hom).comp
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            p_Z.appLE ⊤ W₁ le_top).hom) := by
    intro Z p_Z W₀ W₁ hW₀ hW₁ hW₀₁
    have h0 :
        AlgebraicGeometry.Spec.map
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
              p_Z.appLE ⊤ W₀ le_top) ≫
            Z.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀ ⊓ W₁ ≤ W₀)).op) =
          hW₀₁.fromSpec ≫ p_Z := by
      calc AlgebraicGeometry.Spec.map
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                p_Z.appLE ⊤ W₀ le_top) ≫
              Z.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀ ⊓ W₁ ≤ W₀)).op)
          = AlgebraicGeometry.Spec.map
              (Z.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀ ⊓ W₁ ≤ W₀)).op) ≫
            AlgebraicGeometry.Spec.map
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                p_Z.appLE ⊤ W₀ le_top) :=
            AlgebraicGeometry.Spec.map_comp _ _
        _ = (AlgebraicGeometry.Spec.map
              (Z.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀ ⊓ W₁ ≤ W₀)).op) ≫
              hW₀.fromSpec) ≫ p_Z := by
            rw [← hFromSpecBase p_Z hW₀, Category.assoc]
        _ = hW₀₁.fromSpec ≫ p_Z := by
            rw [hW₀.map_fromSpec hW₀₁ (CategoryTheory.homOfLE inf_le_left).op]
    have h1 :
        AlgebraicGeometry.Spec.map
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
              p_Z.appLE ⊤ W₁ le_top) ≫
            Z.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₀ ⊓ W₁ ≤ W₁)).op) =
          hW₀₁.fromSpec ≫ p_Z := by
      calc AlgebraicGeometry.Spec.map
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                p_Z.appLE ⊤ W₁ le_top) ≫
              Z.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₀ ⊓ W₁ ≤ W₁)).op)
          = AlgebraicGeometry.Spec.map
              (Z.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₀ ⊓ W₁ ≤ W₁)).op) ≫
            AlgebraicGeometry.Spec.map
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                p_Z.appLE ⊤ W₁ le_top) :=
            AlgebraicGeometry.Spec.map_comp _ _
        _ = (AlgebraicGeometry.Spec.map
              (Z.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₀ ⊓ W₁ ≤ W₁)).op) ≫
              hW₁.fromSpec) ≫ p_Z := by
            rw [← hFromSpecBase p_Z hW₁, Category.assoc]
        _ = hW₀₁.fromSpec ≫ p_Z := by
            rw [hW₁.map_fromSpec hW₀₁ (CategoryTheory.homOfLE inf_le_right).op]
    exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective (h0.trans h1.symm))
  
  have hFin2Cases : ∀ b : Fin (1 + 1), b = 0 ∨ b = 1 := by
    rintro ⟨val, hlt⟩
    match val with
    | 0 => exact Or.inl rfl
    | 1 => exact Or.inr rfl
    | n + 2 => omega
  rcases hCoord with
    ⟨_hProper, hSup, hFromSpec, _hMvEquiv, ht_diag, hClosure, hUniv, hBasic, _hc_res, ht_cocycle⟩
  have hCovProj : weilProjBasicOpen Ω 1 0 ⊔ weilProjBasicOpen Ω 1 1 = ⊤ := by
    apply eq_top_iff.mpr
    intro y hy
    rw [← hSup, TopologicalSpace.Opens.mem_iSup] at hy
    rcases hy with ⟨a, ha⟩
    rcases hFin2Cases a with rfl | rfl
    · exact Or.inl ha
    · exact Or.inr ha
  have hInterProj₀ :
      weilProjBasicOpen Ω 1 0 ⊓ weilProjBasicOpen Ω 1 1 =
        (weilProjectiveSpaceOver Ω 1).left.basicOpen (t_proj 0 1) :=
    (hBasic 0 1).symm
  have hInterProj₁ :
      weilProjBasicOpen Ω 1 0 ⊓ weilProjBasicOpen Ω 1 1 =
        (weilProjectiveSpaceOver Ω 1).left.basicOpen (t_proj 1 0) :=
    (inf_comm _ _).trans (hBasic 1 0).symm
  have hRecipProj :
      ((weilProjectiveSpaceOver Ω 1).left.presheaf.map
          (CategoryTheory.homOfLE
            (inf_le_left : weilProjBasicOpen Ω 1 0 ⊓ weilProjBasicOpen Ω 1 1 ≤
              weilProjBasicOpen Ω 1 0)).op).hom (t_proj 0 1) *
        ((weilProjectiveSpaceOver Ω 1).left.presheaf.map
          (CategoryTheory.homOfLE
            (inf_le_right : weilProjBasicOpen Ω 1 0 ⊓ weilProjBasicOpen Ω 1 1 ≤
              weilProjBasicOpen Ω 1 1)).op).hom (t_proj 1 0) = 1 := by
    have hcoc := ht_cocycle 0 1 0
    rw [ht_diag 0, map_one, mul_comm] at hcoc
    exact hcoc
  have hc_proj_eq : ∀ a : Fin (1 + 1),
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        (weilProjectiveSpaceOver Ω 1).hom.appLE ⊤ (weilProjBasicOpen Ω 1 a) le_top).hom) =
        c_proj a := by
    intro a
    have hSpecEq :
        AlgebraicGeometry.Spec.map
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            (weilProjectiveSpaceOver Ω 1).hom.appLE ⊤ (weilProjBasicOpen Ω 1 a) le_top) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_proj a)) := by
      rw [← hFromSpecBase (weilProjectiveSpaceOver Ω 1).hom (hAffProj a), hFromSpec a]
    exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hSpecEq)
  have hBijProjChart : ∀ (a a' : Fin (1 + 1)), a' ≠ a →
      (∀ b : Fin (1 + 1), b = a ∨ b = a') →
      Function.Bijective (Polynomial.eval₂RingHom (c_proj a) (t_proj a a')) := by
    intro a a' ha' hExhaust
    let β_a := Polynomial.eval₂RingHom (c_proj a) (t_proj a a')
    let v : Fin (1 + 1) → Polynomial Ω := fun b => if b = a then 1 else Polynomial.X
    obtain ⟨ψ, hψ_c, hψ_t⟩ := hUniv a (Polynomial Ω) Polynomial.C v (by simp [v])
    have hLeftInv : ψ.comp β_a = RingHom.id (Polynomial Ω) := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        simp only [RingHom.comp_apply, RingHom.id_apply, β_a, Polynomial.coe_eval₂RingHom,
          Polynomial.eval₂_C]
        exact RingHom.congr_fun hψ_c c
      · simp [β_a, hψ_t a', v, ha']
    have hRightInv : β_a.comp ψ = RingHom.id _ := by
      let E := (β_a.comp ψ).eqLocus (RingHom.id _)
      have hSub : Set.range (c_proj a) ∪ Set.range (t_proj a) ⊆ (E : Set _) := by
        rintro z (⟨c, rfl⟩ | ⟨b, rfl⟩)
        · show β_a (ψ (c_proj a c)) = c_proj a c
          have hc : ψ (c_proj a c) = Polynomial.C c := RingHom.congr_fun hψ_c c
          rw [hc]
          simp [β_a]
        · show β_a (ψ (t_proj a b)) = t_proj a b
          rcases hExhaust b with hb | hb
          · rw [hb, ht_diag a, map_one, map_one]
          · rw [hb, hψ_t a']
            simp [v, ha', β_a]
      have hTopLE : (⊤ : Subring _) ≤ E := hClosure a ▸ Subring.closure_le.mpr hSub
      apply RingHom.ext
      intro z
      exact hTopLE (Subring.mem_top z)
    refine ⟨Function.LeftInverse.injective (fun p => RingHom.congr_fun hLeftInv p),
      Function.RightInverse.surjective (fun z => RingHom.congr_fun hRightInv z)⟩
  have hBijProj₀ : Function.Bijective (Polynomial.eval₂RingHom
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        (weilProjectiveSpaceOver Ω 1).hom.appLE ⊤ (weilProjBasicOpen Ω 1 0) le_top).hom)
      (t_proj 0 1)) := by
    rw [hc_proj_eq 0]
    exact hBijProjChart 0 1 (by decide) hFin2Cases
  have hBijProj₁ : Function.Bijective (Polynomial.eval₂RingHom
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        (weilProjectiveSpaceOver Ω 1).hom.appLE ⊤ (weilProjBasicOpen Ω 1 1) le_top).hom)
      (t_proj 1 0)) := by
    rw [hc_proj_eq 1]
    exact hBijProjChart 1 0 (by decide) (fun b => (hFin2Cases b).symm)
  
  have hOverlapHom : ∀ {R₀ R₁ R₀₁ S₀ S₁ S₀₁ : Type u}
      [CommRing R₀] [CommRing R₁] [CommRing R₀₁]
      [CommRing S₀] [CommRing S₁] [CommRing S₀₁]
      (cR₀ : Ω →+* R₀) (cR₁ : Ω →+* R₁)
      (cS₀ : Ω →+* S₀) (cS₁ : Ω →+* S₁)
      (resR₀ : R₀ →+* R₀₁) (resR₁ : R₁ →+* R₀₁)
      (resS₀ : S₀ →+* S₀₁) (resS₁ : S₁ →+* S₀₁)
      (uR₀ : R₀) (uR₁ : R₁) (uS₀ : S₀) (uS₁ : S₁)
      (θ₀ : S₀ →+* R₀) (θ₁ : S₁ →+* R₁),
      resR₀.comp cR₀ = resR₁.comp cR₁ →
      resS₀.comp cS₀ = resS₁.comp cS₁ →
      resR₀ uR₀ * resR₁ uR₁ = 1 →
      resS₀ uS₀ * resS₁ uS₁ = 1 →
      @IsLocalization.Away S₀ _ uS₀ S₀₁ _ resS₀.toAlgebra →
      @IsLocalization.Away S₁ _ uS₁ S₀₁ _ resS₁.toAlgebra →
      Function.Surjective (Polynomial.eval₂RingHom cS₀ uS₀) →
      θ₀.comp cS₀ = cR₀ → θ₀ uS₀ = uR₀ →
      θ₁.comp cS₁ = cR₁ → θ₁ uS₁ = uR₁ →
      ∃ ψ₀₁ : S₀₁ →+* R₀₁,
        ψ₀₁.comp resS₀ = resR₀.comp θ₀ ∧ ψ₀₁.comp resS₁ = resR₁.comp θ₁ := by
    intro R₀ R₁ R₀₁ S₀ S₁ S₀₁ _ _ _ _ _ _
      cR₀ cR₁ cS₀ cS₁ resR₀ resR₁ resS₀ resS₁ uR₀ uR₁ uS₀ uS₁ θ₀ θ₁
      hResR hResS hRecipR' hRecipS' hLoc₀ hLoc₁ hSurj₀ hθ₀_c hθ₀_u hθ₁_c hθ₁_u
    have hg₀ : IsUnit ((resR₀.comp θ₀) uS₀) := by
      refine IsUnit.of_mul_eq_one (resR₁ uR₁) ?_
      simp only [RingHom.comp_apply, hθ₀_u, hRecipR']
    have hg₁ : IsUnit ((resR₁.comp θ₁) uS₁) := by
      refine IsUnit.of_mul_eq_one (resR₀ uR₀) ?_
      simp only [RingHom.comp_apply, hθ₁_u]
      rw [mul_comm, hRecipR']
    let ψ₀ : S₀₁ →+* R₀₁ :=
      letI : Algebra S₀ S₀₁ := resS₀.toAlgebra
      letI : IsLocalization.Away uS₀ S₀₁ := hLoc₀
      IsLocalization.Away.lift uS₀ (g := resR₀.comp θ₀) hg₀
    have hψ₀ : ψ₀.comp resS₀ = resR₀.comp θ₀ := by
      let _ : Algebra S₀ S₀₁ := resS₀.toAlgebra
      let _ : IsLocalization.Away uS₀ S₀₁ := hLoc₀
      ext x
      exact IsLocalization.Away.lift_eq uS₀ hg₀ x
    let ψ₁ : S₀₁ →+* R₀₁ :=
      letI : Algebra S₁ S₀₁ := resS₁.toAlgebra
      letI : IsLocalization.Away uS₁ S₀₁ := hLoc₁
      IsLocalization.Away.lift uS₁ (g := resR₁.comp θ₁) hg₁
    have hψ₁ : ψ₁.comp resS₁ = resR₁.comp θ₁ := by
      let _ : Algebra S₁ S₀₁ := resS₁.toAlgebra
      let _ : IsLocalization.Away uS₁ S₀₁ := hLoc₁
      ext x
      exact IsLocalization.Away.lift_eq uS₁ hg₁ x
    have hψ_eq : ψ₀ = ψ₁ := by
      let _ : Algebra S₀ S₀₁ := resS₀.toAlgebra
      let _ : IsLocalization.Away uS₀ S₀₁ := hLoc₀
      apply IsLocalization.ringHom_ext (Submonoid.powers uS₀)
      change ψ₀.comp resS₀ = ψ₁.comp resS₀
      let β₀ := Polynomial.eval₂RingHom cS₀ uS₀
      have hCompPoly : (ψ₀.comp resS₀).comp β₀ = (ψ₁.comp resS₀).comp β₀ := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          simp only [RingHom.comp_apply, β₀, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          have hc0 : θ₀ (cS₀ c) = cR₀ c := RingHom.congr_fun hθ₀_c c
          have hc1 : θ₁ (cS₁ c) = cR₁ c := RingHom.congr_fun hθ₁_c c
          have hrcS : resS₀ (cS₀ c) = resS₁ (cS₁ c) := RingHom.congr_fun hResS c
          have hrcR : resR₀ (cR₀ c) = resR₁ (cR₁ c) := RingHom.congr_fun hResR c
          have hψ0c : ψ₀ (resS₀ (cS₀ c)) = resR₀ (θ₀ (cS₀ c)) := RingHom.congr_fun hψ₀ (cS₀ c)
          have hψ1c : ψ₁ (resS₁ (cS₁ c)) = resR₁ (θ₁ (cS₁ c)) := RingHom.congr_fun hψ₁ (cS₁ c)
          rw [hψ0c, hc0, hrcR, hrcS, hψ1c, hc1]
        · simp only [RingHom.comp_apply, β₀, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          have h0 : ψ₀ (resS₀ uS₀) = resR₀ uR₀ := by
            have hψ0u : ψ₀ (resS₀ uS₀) = resR₀ (θ₀ uS₀) := RingHom.congr_fun hψ₀ uS₀
            rw [hψ0u, hθ₀_u]
          have h1_u1 : ψ₁ (resS₁ uS₁) = resR₁ uR₁ := by
            have hψ1u : ψ₁ (resS₁ uS₁) = resR₁ (θ₁ uS₁) := RingHom.congr_fun hψ₁ uS₁
            rw [hψ1u, hθ₁_u]
          have h1_mul : ψ₁ (resS₀ uS₀) * resR₁ uR₁ = 1 := by
            rw [← h1_u1, ← map_mul, hRecipS', map_one]
          have h1 : ψ₁ (resS₀ uS₀) = resR₀ uR₀ := by
            calc ψ₁ (resS₀ uS₀)
                = ψ₁ (resS₀ uS₀) * 1 := (mul_one _).symm
              _ = ψ₁ (resS₀ uS₀) * (resR₀ uR₀ * resR₁ uR₁) := by rw [hRecipR']
              _ = (ψ₁ (resS₀ uS₀) * resR₁ uR₁) * resR₀ uR₀ := by ring
              _ = 1 * resR₀ uR₀ := by rw [h1_mul]
              _ = resR₀ uR₀ := one_mul _
          exact h0.trans h1.symm
      apply RingHom.ext
      intro y
      obtain ⟨P, rfl⟩ := hSurj₀ y
      exact RingHom.congr_fun hCompPoly P
    exact ⟨ψ₀, hψ₀, hψ_eq ▸ hψ₁⟩
  
  have hGlueTwoChart : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}}
      (p₁ : Z₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (p₂ : Z₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      {U₀ U₁ : Z₁.Opens}
      (hU₀ : AlgebraicGeometry.IsAffineOpen U₀)
      (hU₁ : AlgebraicGeometry.IsAffineOpen U₁)
      (hU₀₁ : AlgebraicGeometry.IsAffineOpen (U₀ ⊓ U₁))
      (hCovZ₁ : U₀ ⊔ U₁ = ⊤)
      {W₀ W₁ : Z₂.Opens}
      (hW₀ : AlgebraicGeometry.IsAffineOpen W₀)
      (hW₁ : AlgebraicGeometry.IsAffineOpen W₁)
      (hW₀₁ : AlgebraicGeometry.IsAffineOpen (W₀ ⊓ W₁))
      (θ₀ : ↑(Z₂.presheaf.obj (Opposite.op W₀)) →+* ↑(Z₁.presheaf.obj (Opposite.op U₀)))
      (θ₁ : ↑(Z₂.presheaf.obj (Opposite.op W₁)) →+* ↑(Z₁.presheaf.obj (Opposite.op U₁)))
      (ψ₀₁ : ↑(Z₂.presheaf.obj (Opposite.op (W₀ ⊓ W₁))) →+*
        ↑(Z₁.presheaf.obj (Opposite.op (U₀ ⊓ U₁)))),
      ψ₀₁.comp ((Z₂.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀ ⊓ W₁ ≤ W₀)).op).hom) =
        ((Z₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op).hom).comp θ₀ →
      ψ₀₁.comp ((Z₂.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W₀ ⊓ W₁ ≤ W₁)).op).hom) =
        ((Z₁.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op).hom).comp θ₁ →
      θ₀.comp (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          p₂.appLE ⊤ W₀ le_top).hom) =
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          p₁.appLE ⊤ U₀ le_top).hom →
      θ₁.comp (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          p₂.appLE ⊤ W₁ le_top).hom) =
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          p₁.appLE ⊤ U₁ le_top).hom →
      ∃ Φ : Z₁ ⟶ Z₂,
        U₀.ι ≫ Φ =
          hU₀.isoSpec.hom ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom θ₀ :
                Z₂.presheaf.obj (Opposite.op W₀) ⟶ Z₁.presheaf.obj (Opposite.op U₀)) ≫
            hW₀.fromSpec ∧
        U₁.ι ≫ Φ =
          hU₁.isoSpec.hom ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom θ₁ :
                Z₂.presheaf.obj (Opposite.op W₁) ⟶ Z₁.presheaf.obj (Opposite.op U₁)) ≫
            hW₁.fromSpec ∧
        Φ ≫ p₂ = p₁ := by
    intro Z₁ Z₂ p₁ p₂ U₀ U₁ hU₀ hU₁ hU₀₁ hCovZ₁ W₀ W₁ hW₀ hW₁ hW₀₁
      θ₀ θ₁ ψ₀₁ hCompat₀ hCompat₁ hBase₀ hBase₁
    let fθ₀ : Z₂.presheaf.obj (Opposite.op W₀) ⟶ Z₁.presheaf.obj (Opposite.op U₀) :=
      CommRingCat.ofHom θ₀
    let fθ₁ : Z₂.presheaf.obj (Opposite.op W₁) ⟶ Z₁.presheaf.obj (Opposite.op U₁) :=
      CommRingCat.ofHom θ₁
    let fψ₀₁ : Z₂.presheaf.obj (Opposite.op (W₀ ⊓ W₁)) ⟶ Z₁.presheaf.obj (Opposite.op (U₀ ⊓ U₁)) :=
      CommRingCat.ofHom ψ₀₁
    let g₀ : U₀.toScheme ⟶ Z₂ :=
      hU₀.isoSpec.hom ≫ AlgebraicGeometry.Spec.map fθ₀ ≫ hW₀.fromSpec
    let g₁ : U₁.toScheme ⟶ Z₂ :=
      hU₁.isoSpec.hom ≫ AlgebraicGeometry.Spec.map fθ₁ ≫ hW₁.fromSpec
    let g₀₁ : (U₀ ⊓ U₁).toScheme ⟶ Z₂ :=
      hU₀₁.isoSpec.hom ≫ AlgebraicGeometry.Spec.map fψ₀₁ ≫ hW₀₁.fromSpec
    let u₀ : (U₀ ⊓ U₁).toScheme ⟶ U₀.toScheme := Z₁.homOfLE inf_le_left
    let u₁ : (U₀ ⊓ U₁).toScheme ⟶ U₁.toScheme := Z₁.homOfLE inf_le_right
    have hHomOfLEIsoSpec : ∀ {A' A : Z₁.Opens}
        (hA' : AlgebraicGeometry.IsAffineOpen A')
        (hA : AlgebraicGeometry.IsAffineOpen A) (hle : A' ≤ A),
        Z₁.homOfLE hle ≫ hA.isoSpec.hom =
          hA'.isoSpec.hom ≫
            AlgebraicGeometry.Spec.map (Z₁.presheaf.map (CategoryTheory.homOfLE hle).op) := by
      intro A' A hA' hA hle
      rw [← cancel_epi hA'.isoSpec.inv, ← cancel_mono hA.fromSpec]
      have hLHS : (hA'.isoSpec.inv ≫ Z₁.homOfLE hle ≫ hA.isoSpec.hom) ≫ hA.fromSpec =
          hA'.fromSpec := by
        rw [← hA.isoSpec_inv_ι, Category.assoc, Category.assoc,
          Iso.hom_inv_id_assoc, Z₁.homOfLE_ι, hA'.isoSpec_inv_ι]
      have hRHS : (hA'.isoSpec.inv ≫ hA'.isoSpec.hom ≫
          AlgebraicGeometry.Spec.map (Z₁.presheaf.map (CategoryTheory.homOfLE hle).op)) ≫
            hA.fromSpec = hA'.fromSpec := by
        rw [Iso.inv_hom_id_assoc, hA.map_fromSpec hA' (CategoryTheory.homOfLE hle).op]
      exact hLHS.trans hRHS.symm
    have hu₀_g₀ : u₀ ≫ g₀ = g₀₁ := by
      have hCommCat₀ :
          fθ₀ ≫ Z₁.presheaf.map (CategoryTheory.homOfLE inf_le_left).op =
            Z₂.presheaf.map (CategoryTheory.homOfLE inf_le_left).op ≫ fψ₀₁ :=
        CommRingCat.Hom.ext hCompat₀.symm
      calc u₀ ≫ g₀
          = (Z₁.homOfLE inf_le_left ≫ hU₀.isoSpec.hom) ≫
              AlgebraicGeometry.Spec.map fθ₀ ≫ hW₀.fromSpec := by
            simp only [u₀, g₀, Category.assoc]
        _ = hU₀₁.isoSpec.hom ≫
              (AlgebraicGeometry.Spec.map
                  (Z₁.presheaf.map (CategoryTheory.homOfLE inf_le_left).op) ≫
                AlgebraicGeometry.Spec.map fθ₀) ≫ hW₀.fromSpec := by
            rw [hHomOfLEIsoSpec hU₀₁ hU₀ inf_le_left, Category.assoc, Category.assoc]
        _ = hU₀₁.isoSpec.hom ≫
              AlgebraicGeometry.Spec.map
                (fθ₀ ≫ Z₁.presheaf.map (CategoryTheory.homOfLE inf_le_left).op) ≫
                hW₀.fromSpec := by
            rw [← AlgebraicGeometry.Spec.map_comp]
        _ = hU₀₁.isoSpec.hom ≫
              AlgebraicGeometry.Spec.map
                (Z₂.presheaf.map (CategoryTheory.homOfLE inf_le_left).op ≫ fψ₀₁) ≫
                hW₀.fromSpec := by
            rw [hCommCat₀]
        _ = hU₀₁.isoSpec.hom ≫ AlgebraicGeometry.Spec.map fψ₀₁ ≫
              (AlgebraicGeometry.Spec.map
                (Z₂.presheaf.map (CategoryTheory.homOfLE inf_le_left).op) ≫
                  hW₀.fromSpec) := by
            rw [AlgebraicGeometry.Spec.map_comp, Category.assoc]
        _ = g₀₁ := by
            rw [hW₀.map_fromSpec hW₀₁ (CategoryTheory.homOfLE inf_le_left).op]
    have hu₁_g₁ : u₁ ≫ g₁ = g₀₁ := by
      have hCommCat₁ :
          fθ₁ ≫ Z₁.presheaf.map (CategoryTheory.homOfLE inf_le_right).op =
            Z₂.presheaf.map (CategoryTheory.homOfLE inf_le_right).op ≫ fψ₀₁ :=
        CommRingCat.Hom.ext hCompat₁.symm
      calc u₁ ≫ g₁
          = (Z₁.homOfLE inf_le_right ≫ hU₁.isoSpec.hom) ≫
              AlgebraicGeometry.Spec.map fθ₁ ≫ hW₁.fromSpec := by
            simp only [u₁, g₁, Category.assoc]
        _ = hU₀₁.isoSpec.hom ≫
              (AlgebraicGeometry.Spec.map
                  (Z₁.presheaf.map (CategoryTheory.homOfLE inf_le_right).op) ≫
                AlgebraicGeometry.Spec.map fθ₁) ≫ hW₁.fromSpec := by
            rw [hHomOfLEIsoSpec hU₀₁ hU₁ inf_le_right, Category.assoc, Category.assoc]
        _ = hU₀₁.isoSpec.hom ≫
              AlgebraicGeometry.Spec.map
                (fθ₁ ≫ Z₁.presheaf.map (CategoryTheory.homOfLE inf_le_right).op) ≫
                hW₁.fromSpec := by
            rw [← AlgebraicGeometry.Spec.map_comp]
        _ = hU₀₁.isoSpec.hom ≫
              AlgebraicGeometry.Spec.map
                (Z₂.presheaf.map (CategoryTheory.homOfLE inf_le_right).op ≫ fψ₀₁) ≫
                hW₁.fromSpec := by
            rw [hCommCat₁]
        _ = hU₀₁.isoSpec.hom ≫ AlgebraicGeometry.Spec.map fψ₀₁ ≫
              (AlgebraicGeometry.Spec.map
                (Z₂.presheaf.map (CategoryTheory.homOfLE inf_le_right).op) ≫
                  hW₁.fromSpec) := by
            rw [AlgebraicGeometry.Spec.map_comp, Category.assoc]
        _ = g₀₁ := by
            rw [hW₁.map_fromSpec hW₀₁ (CategoryTheory.homOfLE inf_le_right).op]
    have hu_eq : u₀ ≫ g₀ = u₁ ≫ g₁ := hu₀_g₀.trans hu₁_g₁.symm
    have hPB₀₁ : CategoryTheory.IsPullback u₀ u₁ U₀.ι U₁.ι := by
      apply @AlgebraicGeometry.IsOpenImmersion.isPullback
        (U₀ ⊓ U₁).toScheme U₀.toScheme U₁.toScheme Z₁ u₀ u₁ U₀.ι U₁.ι
      · dsimp only [u₀, u₁]
        rw [Z₁.homOfLE_ι, Z₁.homOfLE_ι]
      · dsimp only [u₁]
        rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι,
          AlgebraicGeometry.Scheme.opensRange_homOfLE]
        ext z
        change U₁.ι.base z ∈ U₀ ↔ U₁.ι.base z ∈ U₀ ∧ U₁.ι.base z ∈ U₁
        have hz₁ : U₁.ι.base z ∈ U₁ := by
          have hmem : U₁.ι.base z ∈ U₁.ι.opensRange := ⟨z, rfl⟩
          rwa [AlgebraicGeometry.Scheme.Opens.opensRange_ι U₁] at hmem
        exact ⟨fun hz₀ => ⟨hz₀, hz₁⟩, fun h => h.1⟩
    let U_vec : Fin 2 → Z₁.Opens := Fin.cases U₀ (fun _ => U₁)
    let g_vec : ∀ i : Fin 2, (U_vec i).toScheme ⟶ Z₂ := Fin.cases g₀ (fun _ => g₁)
    have hSupZ₁ : (⨆ i : Fin 2, U_vec i) = ⊤ := by
      apply eq_top_iff.mpr
      intro z hz
      rw [← hCovZ₁] at hz
      rw [TopologicalSpace.Opens.mem_iSup]
      rcases hz with hz₀ | hz₁
      · exact ⟨0, hz₀⟩
      · exact ⟨1, hz₁⟩
    let 𝒰 : Z₁.OpenCover :=
      Z₁.openCoverOfIsOpenCover U_vec (TopologicalSpace.IsOpenCover.mk hSupZ₁)
    have hGlue : ∀ i j : Fin 2,
        CategoryTheory.Limits.pullback.fst (𝒰.f i) (𝒰.f j) ≫ g_vec i =
          CategoryTheory.Limits.pullback.snd (𝒰.f i) (𝒰.f j) ≫ g_vec j := by
      rw [Fin.forall_fin_two]
      refine ⟨?_, ?_⟩
      · rw [Fin.forall_fin_two]
        refine ⟨?_, ?_⟩
        · have hEqProj :
              CategoryTheory.Limits.pullback.fst U₀.ι U₀.ι =
                CategoryTheory.Limits.pullback.snd U₀.ι U₀.ι := by
            rw [← cancel_mono U₀.ι]
            exact CategoryTheory.Limits.pullback.condition
          change CategoryTheory.Limits.pullback.fst U₀.ι U₀.ι ≫ g₀ =
            CategoryTheory.Limits.pullback.snd U₀.ι U₀.ι ≫ g₀
