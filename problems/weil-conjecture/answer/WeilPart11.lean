            hnat w₁ w₁' (M.u a b).val
          have h2 : (X.presheaf.map w₂'.op).hom ((φ.app (M.V b ⊓ M.V c)).hom (M.u b c).val) =
              (φ.app (M.V a ⊓ M.V b ⊓ M.V c)).hom ((C.presheaf.map w₂.op).hom (M.u b c).val) :=
            hnat w₂ w₂' (M.u b c).val
          have h3 : (X.presheaf.map w₃'.op).hom ((φ.app (M.V a ⊓ M.V c)).hom (M.u a c).val) =
              (φ.app (M.V a ⊓ M.V b ⊓ M.V c)).hom ((C.presheaf.map w₃.op).hom (M.u a c).val) :=
            hnat w₃ w₃' (M.u a c).val
