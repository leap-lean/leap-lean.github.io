  have hAlg :
      ∃ μ : ∀ (p : ℕ) (α : WeilStrictMonoTuple (N + 1) p),
          HomogeneousLocalization.Away 𝒜
            (∏ l : Fin (p + 1), MvPolynomial.X (α.1 l)) →+
            ((Fin (N + 1) → ℤ) →₀ B),
        (∀ p α, Function.Injective (μ p α)) ∧
        (∀ p α y a, ¬IsValidLaurentExp N (-(D : ℤ)) α a → μ p α y a = 0) ∧
        (∀ p α (g : (Fin (N + 1) → ℤ) →₀ B),
          (∀ a, ¬IsValidLaurentExp N (-(D : ℤ)) α a → g a = 0) →
          ∃ y, μ p α y = g) ∧
        (∀ p α (r : B) y,
          μ p α
            (HomogeneousLocalization.fromZeroRingHom 𝒜
              (Submonoid.powers (∏ l : Fin (p + 1), MvPolynomial.X (α.1 l)))
              (algebraMap B ↥(𝒜 0) r) * y) =
            r • μ p α y) ∧
        (∀ (p : ℕ) (β : WeilStrictMonoTuple (N + 1) (p + 1)) (k : Fin (p + 1)),
          let α : WeilStrictMonoTuple (N + 1) p :=
            ⟨fun i => β.1 (k.succ.succAbove i), β.2.comp (Fin.strictMono_succAbove k.succ)⟩
          ∀ {e : ℕ} {g : MvPolynomial (Fin (N + 1)) B} (hg : g ∈ 𝒜 e)
            (hx : (∏ i : Fin (p + 2), MvPolynomial.X (β.1 i)) =
              (∏ i : Fin (p + 1), MvPolynomial.X (α.1 i)) * g)
            (y : HomogeneousLocalization.Away 𝒜
              (∏ i : Fin (p + 1), MvPolynomial.X (α.1 i))),
            μ (p + 1) β (HomogeneousLocalization.awayMap 𝒜 hg hx y) = μ p α y) ∧
        (∀ (p : ℕ) (β : WeilStrictMonoTuple (N + 1) (p + 1)),
          let α₀ : WeilStrictMonoTuple (N + 1) p :=
            ⟨fun i => β.1 ((0 : Fin (p + 2)).succAbove i),
              β.2.comp (Fin.strictMono_succAbove 0)⟩
          ∀ (h01 : MvPolynomial.X (β.1 0) * MvPolynomial.X (β.1 1) ∈ 𝒜 2)
            (h00 : MvPolynomial.X (β.1 0) ^ 2 ∈ 𝒜 (1 • 2))
            {e₁ : ℕ} {g₁ : MvPolynomial (Fin (N + 1)) B} (hg₁ : g₁ ∈ 𝒜 e₁)
            (hx₁ : (∏ i : Fin (p + 2), MvPolynomial.X (β.1 i)) =
              (MvPolynomial.X (β.1 0) * MvPolynomial.X (β.1 1)) * g₁)
            {e₀ : ℕ} {g₀ : MvPolynomial (Fin (N + 1)) B} (hg₀ : g₀ ∈ 𝒜 e₀)
            (hx₀ : (∏ i : Fin (p + 2), MvPolynomial.X (β.1 i)) =
              (∏ i : Fin (p + 1), MvPolynomial.X (α₀.1 i)) * g₀)
            (y : HomogeneousLocalization.Away 𝒜
              (∏ i : Fin (p + 1), MvPolynomial.X (α₀.1 i))),
            μ (p + 1) β
              ((HomogeneousLocalization.awayMap 𝒜 hg₁ hx₁
                  (HomogeneousLocalization.Away.mk 𝒜 h01 1
                    (MvPolynomial.X (β.1 0) ^ 2) h00)) ^ D *
                HomogeneousLocalization.awayMap 𝒜 hg₀ hx₀ y) =
              μ p α₀ y) := by
    let ℒ_B := AddMonoidAlgebra B (Fin (N + 1) → ℤ)
    let eFS : AddMonoidAlgebra B (Fin (N + 1) → ℤ) ≃ₗ[B] ((Fin (N + 1) → ℤ) →₀ B) :=
      { toFun := fun x => x.coeff
        invFun := fun g => ⟨g⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    have heFS_single : ∀ (a : Fin (N + 1) → ℤ) (b : B),
        eFS (AddMonoidAlgebra.single a b) = Finsupp.single a b :=
      fun _ _ => rfl
    let eMon : (Fin (N + 1) → ℤ) → ℒ_B := fun v => AddMonoidAlgebra.single v 1
    have heMon_zero : eMon 0 = 1 := AddMonoidAlgebra.one_def.symm
    have heMon_add : ∀ v₁ v₂ : Fin (N + 1) → ℤ, eMon v₁ * eMon v₂ = eMon (v₁ + v₂) := by
      intro v₁ v₂
      change AddMonoidAlgebra.single v₁ 1 * AddMonoidAlgebra.single v₂ 1 = _
      rw [AddMonoidAlgebra.single_mul_single, one_mul]
    have heMon_pow : ∀ (v : Fin (N + 1) → ℤ) (n : ℕ), (eMon v) ^ n = eMon ((n : ℤ) • v) := by
      intro v n
      induction n with
      | zero => simp [heMon_zero]
      | succ n ih =>
        rw [pow_succ, ih, heMon_add]
        congr 1
        ext j
        simp [Nat.cast_add, add_mul]
    let uMon : (Fin (N + 1) → ℤ) → ℒ_Bˣ := fun v =>
      ⟨eMon v, eMon (-v),
        by rw [heMon_add, add_neg_cancel, heMon_zero],
        by rw [heMon_add, neg_add_cancel, heMon_zero]⟩
    have heFS_mul_eMon : ∀ (x : ℒ_B) (g a : Fin (N + 1) → ℤ),
        eFS (x * eMon g) a = eFS x (a - g) := by
      intro x g a
      obtain ⟨f, rfl⟩ := eFS.symm.surjective x
      rw [LinearEquiv.apply_symm_apply]
      refine Finsupp.induction f ?_ ?_
      · simp
      · intro m c f' _ _ ih
        rw [map_add, add_mul, map_add, Finsupp.add_apply, Finsupp.add_apply, ih]
        congr 1
        have hsymm : eFS.symm (Finsupp.single m c) = AddMonoidAlgebra.single m c :=
          eFS.injective (by rw [LinearEquiv.apply_symm_apply, heFS_single])
        rw [hsymm]
        change eFS (AddMonoidAlgebra.single m c * AddMonoidAlgebra.single g 1) a = _
        rw [AddMonoidAlgebra.single_mul_single, mul_one, heFS_single,
          Finsupp.single_apply, Finsupp.single_apply]
        by_cases hmg : m + g = a
        · have hm : m = a - g := eq_sub_iff_add_eq.mpr hmg
          simp [hmg, hm]
        · have hm : m ≠ a - g := fun h => hmg (eq_sub_iff_add_eq.mp h)
          simp [hmg, hm]
    let δ : Fin (N + 1) → Fin (N + 1) → ℤ := fun j => Pi.single j 1
    have hδ_sum : ∀ j₀ : Fin (N + 1), ∑ j : Fin (N + 1), δ j₀ j = 1 := by
      intro j₀
      rw [Finset.sum_eq_single j₀]
      · simp [δ]
      · intro j _ hj
        simp [δ, Pi.single_apply, hj]
      · intro h
        exact absurd (Finset.mem_univ j₀) h
    let ψ_poly : MvPolynomial (Fin (N + 1)) B →ₐ[B] ℒ_B :=
      MvPolynomial.aeval (fun j => eMon (δ j))
    let natCastVec : (Fin (N + 1) →₀ ℕ) → Fin (N + 1) → ℤ := fun d j => (d j : ℤ)
    have hψ_monomial : ∀ (d : Fin (N + 1) →₀ ℕ) (c : B),
        ψ_poly (MvPolynomial.monomial d c) = AddMonoidAlgebra.single (natCastVec d) c := by
      intro d c
      refine Finsupp.induction d ?_ ?_
      · rw [MvPolynomial.monomial_zero', MvPolynomial.aeval_C, Algebra.algebraMap_eq_smul_one,
          AddMonoidAlgebra.one_def, AddMonoidAlgebra.smul_single', mul_one]
        have h0 : natCastVec 0 = 0 := by
          ext j
          change (((0 : Fin (N + 1) →₀ ℕ) j : ℕ) : ℤ) = 0
          simp
        rw [h0]
      · intro j n d' _ _ ih
        have hmon : MvPolynomial.monomial (Finsupp.single j n + d') c =
            MvPolynomial.X j ^ n * MvPolynomial.monomial d' c := by
          rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul, one_mul]
        rw [hmon, map_mul, map_pow, MvPolynomial.aeval_X, heMon_pow, ih]
        change AddMonoidAlgebra.single ((n : ℤ) • δ j) 1 *
          AddMonoidAlgebra.single (natCastVec d') c = _
        rw [AddMonoidAlgebra.single_mul_single, one_mul]
        congr 1
        ext k
        change (n : ℤ) * δ j k + (d' k : ℤ) =
          (((Finsupp.single j n + d') k : ℕ) : ℤ)
        dsimp only [δ]
        rw [Finsupp.add_apply, Nat.cast_add, Finsupp.single_apply, Pi.single_apply]
        by_cases hjk : j = k
        · subst hjk; simp
        · have hkj : k ≠ j := fun h => hjk h.symm
          simp [hjk, hkj]
    have hψ_inj : Function.Injective ψ_poly := by
      let backVec : (Fin (N + 1) → ℤ) → (Fin (N + 1) →₀ ℕ) :=
        fun w => Finsupp.equivFunOnFinite.symm (fun j => (w j).toNat)
      let π_back : ((Fin (N + 1) → ℤ) →₀ B) →+ MvPolynomial (Fin (N + 1)) B :=
        Finsupp.liftAddHom (fun w => (MvPolynomial.monomial (backVec w)).toAddMonoidHom)
      have hleft : ∀ P : MvPolynomial (Fin (N + 1)) B, π_back (eFS (ψ_poly P)) = P := by
        intro P
        refine MvPolynomial.induction_on' P ?_ ?_
        · intro d c
          rw [hψ_monomial, heFS_single, Finsupp.liftAddHom_apply_single]
          have hbv : backVec (natCastVec d) = d := by
            ext j
            change ((d j : ℤ)).toNat = d j
            exact Int.toNat_natCast (d j)
          rw [hbv]
          rfl
        · intro p q hp hq
          rw [map_add, map_add, map_add, hp, hq]
      intro P₁ P₂ h
      calc P₁ = π_back (eFS (ψ_poly P₁)) := (hleft P₁).symm
        _ = π_back (eFS (ψ_poly P₂)) := by rw [h]
        _ = P₂ := hleft P₂
    have hHomLaur : ∀ (n : ℕ) (P : MvPolynomial (Fin (N + 1)) B),
        P ∈ 𝒜 n →
        ∀ w : Fin (N + 1) → ℤ, eFS (ψ_poly P) w ≠ 0 →
          (∀ j : Fin (N + 1), 0 ≤ w j) ∧ (∑ j : Fin (N + 1), w j = (n : ℤ)) := by
      have hComp : ∀ (n : ℕ) (Q : MvPolynomial (Fin (N + 1)) B) (w : Fin (N + 1) → ℤ),
          eFS (ψ_poly (MvPolynomial.homogeneousComponent n Q)) w ≠ 0 →
          (∀ j : Fin (N + 1), 0 ≤ w j) ∧ (∑ j : Fin (N + 1), w j = (n : ℤ)) := by
        intro n Q
        refine MvPolynomial.induction_on' Q ?_ ?_
        · intro d c w hw
          have hmem : MvPolynomial.monomial d c ∈ 𝒜 (Finsupp.degree d) :=
            (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
              (MvPolynomial.isHomogeneous_monomial c rfl)
          rw [MvPolynomial.homogeneousComponent_of_mem hmem] at hw
          split_ifs at hw with hnd
          · rw [hψ_monomial, heFS_single, Finsupp.single_apply] at hw
            have hdw : natCastVec d = w := by
              by_contra hne
              simp [hne] at hw
            rw [← hdw]
            refine ⟨fun j => Nat.cast_nonneg (d j), ?_⟩
            subst hnd
            rw [Finsupp.degree_eq_sum]
            simp [natCastVec]
          · simp at hw
        · intro p q hp hq w hw
          rw [map_add, map_add, map_add, Finsupp.add_apply] at hw
          by_cases hpw : eFS (ψ_poly (MvPolynomial.homogeneousComponent n p)) w ≠ 0
          · exact hp w hpw
          · push_neg at hpw
            rw [hpw, zero_add] at hw
            exact hq w hw
      intro n P hP w hw
      have hP_eq : MvPolynomial.homogeneousComponent n P = P := by
        rw [MvPolynomial.homogeneousComponent_of_mem hP, if_pos rfl]
      rw [← hP_eq] at hw
      exact hComp n P w hw
    have hLocLift : ∀ (f : MvPolynomial (Fin (N + 1)) B) (v : Fin (N + 1) → ℤ),
        ψ_poly f = eMon v →
        ∃ τ : Localization.Away f →+* ℒ_B,
          (∀ P : MvPolynomial (Fin (N + 1)) B,
            τ (algebraMap _ (Localization.Away f) P) = ψ_poly P) ∧
          Function.Injective τ ∧
          (∀ (m : ℕ) (P : MvPolynomial (Fin (N + 1)) B) (z : Localization.Away f),
            z * (algebraMap _ (Localization.Away f) f) ^ m =
              algebraMap _ (Localization.Away f) P →
            τ z = ψ_poly P * eMon (-(m : ℤ) • v)) := by
      intro f v hfv
      have hu : IsUnit (ψ_poly.toRingHom f) := by
        change IsUnit (ψ_poly f)
        rw [hfv]
        exact (uMon v).isUnit
      have hex : ∃ τ : Localization.Away f →+* ℒ_B,
          ∀ P, τ (algebraMap _ (Localization.Away f) P) = ψ_poly P :=
        ⟨IsLocalization.Away.lift f hu, fun P => IsLocalization.Away.lift_eq f hu P⟩
      obtain ⟨τ, hτ⟩ := hex
      have hfrac : ∀ (m : ℕ) (P : MvPolynomial (Fin (N + 1)) B) (z : Localization.Away f),
          z * (algebraMap _ (Localization.Away f) f) ^ m =
            algebraMap _ (Localization.Away f) P →
          τ z = ψ_poly P * eMon (-(m : ℤ) • v) := by
        intro m P z hz
        have h1 := congrArg τ hz
        rw [map_mul, map_pow, hτ f, hτ P, hfv, heMon_pow] at h1
        calc τ z
            = τ z * (eMon ((m : ℤ) • v) * eMon (-(m : ℤ) • v)) := by
                rw [neg_smul, heMon_add, add_neg_cancel, heMon_zero, mul_one]
          _ = (τ z * eMon ((m : ℤ) • v)) * eMon (-(m : ℤ) • v) := by rw [mul_assoc]
          _ = ψ_poly P * eMon (-(m : ℤ) • v) := by rw [h1]
      refine ⟨τ, hτ, ?_, hfrac⟩
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨m, P, hsurj⟩ := IsLocalization.Away.surj f z
      have hP0 : ψ_poly P = 0 := by
        have h1 := congrArg τ hsurj
        rw [map_mul, hz, zero_mul, hτ P] at h1
        exact h1.symm
      have hP : P = 0 := hψ_inj (hP0.trans (map_zero ψ_poly).symm)
      rw [hP, map_zero] at hsurj
      obtain ⟨u_f, hu_f⟩ :=
        (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away f) f).pow m
      rw [← hu_f] at hsurj
      calc z = z * (u_f.val * (u_f⁻¹).val) := by rw [Units.mul_inv, mul_one]
        _ = (z * u_f.val) * (u_f⁻¹).val := by rw [mul_assoc]
        _ = 0 := by rw [hsurj, zero_mul]
    have hAwayTau : ∀ {f g x : MvPolynomial (Fin (N + 1)) B} {e : ℕ}
        (hg : g ∈ 𝒜 e) (hx : x = f * g)
        (v : Fin (N + 1) → ℤ) (hfv : ψ_poly f = eMon v)
        (τ_f : Localization.Away f →+* ℒ_B)
        (hτ_f_frac : ∀ (m : ℕ) (P : MvPolynomial (Fin (N + 1)) B) (z : Localization.Away f),
          z * (algebraMap (MvPolynomial (Fin (N + 1)) B) (Localization.Away f) f) ^ m =
            algebraMap (MvPolynomial (Fin (N + 1)) B) (Localization.Away f) P →
          τ_f z = ψ_poly P * eMon (-(m : ℤ) • v))
        (τ_x : Localization.Away x →+* ℒ_B)
        (hτ_x_eq : ∀ P : MvPolynomial (Fin (N + 1)) B,
          τ_x (algebraMap (MvPolynomial (Fin (N + 1)) B) (Localization.Away x) P) = ψ_poly P)
        (y : HomogeneousLocalization.Away 𝒜 f),
        τ_x (HomogeneousLocalization.awayMap 𝒜 hg hx y).val = τ_f y.val := by
      intro f g x e hg hx v hfv τ_f hτ_f_frac τ_x hτ_x_eq y
      obtain ⟨m, P, hsurj⟩ := IsLocalization.Away.surj f y.val
      have hval := HomogeneousLocalization.val_awayMap 𝒜 hg hx y
      have hsurj_x : (HomogeneousLocalization.awayMap 𝒜 hg hx y).val *
          (algebraMap _ (Localization.Away x) f) ^ m =
          algebraMap _ (Localization.Away x) P := by
        rw [hval]
        have hgen : ∀ (hu_x : IsUnit (algebraMap (MvPolynomial (Fin (N + 1)) B)
              (Localization (Submonoid.powers x)) f)),
            (Localization.awayLift
              (algebraMap (MvPolynomial (Fin (N + 1)) B) (Localization (Submonoid.powers x)))
              f hu_x) y.val *
              (algebraMap _ (Localization.Away x) f) ^ m =
              algebraMap _ (Localization.Away x) P := by
          intro hu_x
          let φ_lift := Localization.awayLift
            (algebraMap (MvPolynomial (Fin (N + 1)) B) (Localization (Submonoid.powers x))) f hu_x
          have h1 := congrArg φ_lift hsurj
          rw [map_mul, map_pow, IsLocalization.Away.lift_eq f hu_x f,
            IsLocalization.Away.lift_eq f hu_x P] at h1
          exact h1
        exact hgen _
      have hx1 := congrArg τ_x hsurj_x
      rw [map_mul, map_pow, hτ_x_eq f, hτ_x_eq P, hfv, heMon_pow] at hx1
      rw [hτ_f_frac m P y.val hsurj]
      calc τ_x (HomogeneousLocalization.awayMap 𝒜 hg hx y).val
          = τ_x (HomogeneousLocalization.awayMap 𝒜 hg hx y).val *
              (eMon ((m : ℤ) • v) * eMon (-(m : ℤ) • v)) := by
                rw [neg_smul, heMon_add, add_neg_cancel, heMon_zero, mul_one]
        _ = (τ_x (HomogeneousLocalization.awayMap 𝒜 hg hx y).val *
              eMon ((m : ℤ) • v)) * eMon (-(m : ℤ) • v) := by rw [mul_assoc]
        _ = ψ_poly P * eMon (-(m : ℤ) • v) := by rw [hx1]
    let f_prod : ∀ (p : ℕ), WeilStrictMonoTuple (N + 1) p → MvPolynomial (Fin (N + 1)) B :=
      fun p α => ∏ l : Fin (p + 1), MvPolynomial.X (α.1 l)
    let e_ind : ∀ (p : ℕ), WeilStrictMonoTuple (N + 1) p → Fin (N + 1) → ℤ :=
      fun p α => ∑ l : Fin (p + 1), δ (α.1 l)
    have hψ_fprod : ∀ (p : ℕ) (α : WeilStrictMonoTuple (N + 1) p),
        ψ_poly (f_prod p α) = eMon (e_ind p α) := by
      have hGen : ∀ (n : ℕ) (g : Fin n → Fin (N + 1)),
          ψ_poly (∏ l : Fin n, MvPolynomial.X (g l)) = eMon (∑ l : Fin n, δ (g l)) := by
        intro n
        induction n with
        | zero =>
          intro g
          rw [Fin.prod_univ_zero, Fin.sum_univ_zero, map_one, heMon_zero]
        | succ n ih =>
          intro g
          rw [Fin.prod_univ_succ, Fin.sum_univ_succ, map_mul, MvPolynomial.aeval_X,
            ih (fun i => g i.succ), heMon_add]
      intro p α
      exact hGen (p + 1) α.1
    have he_ind_mem : ∀ (p : ℕ) (α : WeilStrictMonoTuple (N + 1) p) (l₀ : Fin (p + 1)),
        e_ind p α (α.1 l₀) = 1 := by
      intro p α l₀
      change (∑ l : Fin (p + 1), δ (α.1 l)) (α.1 l₀) = 1
      rw [Finset.sum_apply, Finset.sum_eq_single l₀]
      · simp [δ]
      · intro l _ hl
        have hne : α.1 l ≠ α.1 l₀ := fun h => hl (α.2.injective h)
        simp [δ, Pi.single_apply, hne]
      · intro h
        exact absurd (Finset.mem_univ l₀) h
    have he_ind_not_mem : ∀ (p : ℕ) (α : WeilStrictMonoTuple (N + 1) p) (j : Fin (N + 1)),
        (∀ l : Fin (p + 1), α.1 l ≠ j) → e_ind p α j = 0 := by
      intro p α j hj
      change (∑ l : Fin (p + 1), δ (α.1 l)) j = 0
      rw [Finset.sum_apply]
      refine Finset.sum_eq_zero fun l _ => ?_
      have hne : α.1 l ≠ j := hj l
      simp [δ, Pi.single_apply, hne]
    have he_ind_sum : ∀ (p : ℕ) (α : WeilStrictMonoTuple (N + 1) p),
        ∑ j : Fin (N + 1), e_ind p α j = ((p + 1 : ℕ) : ℤ) := by
      intro p α
      have h_app : ∀ j : Fin (N + 1), e_ind p α j = ∑ l : Fin (p + 1), δ (α.1 l) j :=
        fun j => Finset.sum_apply j Finset.univ (fun l => δ (α.1 l))
      simp_rw [h_app]
      rw [Finset.sum_comm]
      simp [hδ_sum]
    choose τ_α hτ_α_eq hτ_α_inj hτ_α_frac using fun (p : ℕ) (α : WeilStrictMonoTuple (N + 1) p) =>
      hLocLift (f_prod p α) (e_ind p α) (hψ_fprod p α)
    let shiftVec : ∀ (p : ℕ), WeilStrictMonoTuple (N + 1) p → Fin (N + 1) → ℤ :=
      fun _ α => -(D : ℤ) • δ (α.1 0)
    let μ : ∀ (p : ℕ) (α : WeilStrictMonoTuple (N + 1) p),
        HomogeneousLocalization.Away 𝒜 (f_prod p α) →+ ((Fin (N + 1) → ℤ) →₀ B) :=
      fun p α =>
        { toFun := fun y => eFS (eMon (shiftVec p α) * τ_α p α y.val)
          map_zero' := by
            rw [HomogeneousLocalization.val_zero, map_zero, mul_zero, map_zero]
          map_add' := fun y₁ y₂ => by
            rw [HomogeneousLocalization.val_add, map_add, mul_add, map_add] }
    refine ⟨μ, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · 
      intro p α y₁ y₂ h
      have h1 : eMon (shiftVec p α) * τ_α p α y₁.val =
          eMon (shiftVec p α) * τ_α p α y₂.val := eFS.injective h
      have h2 : τ_α p α y₁.val = τ_α p α y₂.val := by
        calc τ_α p α y₁.val
            = (eMon (-shiftVec p α) * eMon (shiftVec p α)) * τ_α p α y₁.val := by
                rw [heMon_add, neg_add_cancel, heMon_zero, one_mul]
          _ = eMon (-shiftVec p α) * (eMon (shiftVec p α) * τ_α p α y₁.val) := by rw [mul_assoc]
          _ = eMon (-shiftVec p α) * (eMon (shiftVec p α) * τ_α p α y₂.val) := by rw [h1]
          _ = (eMon (-shiftVec p α) * eMon (shiftVec p α)) * τ_α p α y₂.val := by rw [← mul_assoc]
          _ = τ_α p α y₂.val := by rw [heMon_add, neg_add_cancel, heMon_zero, one_mul]
      exact HomogeneousLocalization.val_injective _ (hτ_α_inj p α h2)
    · 
      intro p α y a hNotVal
      by_cases hSub : Subsingleton B
      · exact @Subsingleton.elim B hSub _ 0
      · haveI : Nontrivial B := not_subsingleton_iff_nontrivial.mp hSub
        obtain ⟨nd, rfl⟩ := HomogeneousLocalization.mk_surjective y
        obtain ⟨m, hm_eq⟩ := nd.den_mem
        have hm_pow : f_prod p α ^ m = nd.den.1 := hm_eq
        have hdeg_eq : (nd.deg : ℤ) = (m : ℤ) * ((p + 1 : ℕ) : ℤ) := by
