        letI := instModE U (q + 1)
        inferInstance
      instModule := fun U =>
        letI := instModE U (q + 1)
        inferInstance
      res := fun {U W} h =>
        letI := instModE U (q + 1)
        letI := instModE W (q + 1)
        (Submodule.mapQ ((Bq_sub U q).restrictScalars ℤ) ((Bq_sub W q).restrictScalars ℤ)
