            - ((-1) ^ (i_star.succAbove j : ℕ) *
                (Y.presheaf.map (CategoryTheory.homOfLE hW_γ).op).hom
                  ((Y.presheaf.map (CategoryTheory.homOfLE
                    (hFaceOf γ (i_star.succAbove j))).op).hom
                    (z (faceOf γ (i_star.succAbove j))))) := by
          intro j
          let m_j : Fin (p + 3) := i_star.succAbove j
          have hγ_mj : γ.1 m_j = α.1 j := by
            change (faceOf γ i_star).1 j = α.1 j
            rw [hFace_i]
          have hαj_ne_lam : α.1 j ≠ lam :=
            fun hEq => hMem (hEq ▸ Finset.mem_image_of_mem α.1 (Finset.mem_univ j))
