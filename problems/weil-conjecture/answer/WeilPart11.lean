          res_comp := fun h₁ h₂ y => Subtype.ext (H.res_comp h₁ h₂ y.1) }
      let res_quot : ∀ {U W : C.Opens} (hWU : W ≤ U),
          (H.sec U ⧸ N U) →+ (H.sec W ⧸ N W) :=
        fun {U W} hWU =>
          QuotientAddGroup.lift (N U).toAddSubgroup
            ((Submodule.mkQ (N W)).toAddMonoidHom.comp (H.res hWU))
            (fun x hx => by
              change Submodule.Quotient.mk (p := N W) (H.res hWU x) = 0
              rw [Submodule.Quotient.mk_eq_zero]
              exact hN_res hWU x hx)
      let H_quot : WeilPresheafModule C :=
        { sec := fun U => H.sec U ⧸ N U
          instAddCommGroup := fun U => inferInstance
          instModule := fun U => inferInstance
          res := fun hWU => res_quot hWU
          res_smul := fun {U W} hWU a u => by
            obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective (N U) u
            change Submodule.Quotient.mk (p := N W) (H.res hWU (a • x)) =
              (C.presheaf.map (CategoryTheory.homOfLE hWU).op).hom a •
                Submodule.Quotient.mk (p := N W) (H.res hWU x)
            rw [hResSmul]
            rfl
          res_id := fun U u => by
            obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective (N U) u
            change Submodule.Quotient.mk (p := N U) (H.res (le_refl U) x) = _
            rw [H.res_id]
          res_comp := fun {U W T} h₁ h₂ u => by
            obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective (N U) u
            change Submodule.Quotient.mk (p := N T) (H.res h₂ (H.res h₁ x)) = _
            rw [H.res_comp]
            rfl }
      have hCohSub : IsWeilCoherentSubChartModule V H_sub := by
        refine ⟨?_, ?_⟩
        · intro U hU_aff ha
          have _ : IsNoetherianRing ↑(C.presheaf.obj (Opposite.op U)) := hNoethU U hU_aff
          have _ : Module.Finite ↑(C.presheaf.obj (Opposite.op U)) (H.sec U) :=
            hCohH.1 U hU_aff ha
          have hNoethM : IsNoetherian ↑(C.presheaf.obj (Opposite.op U)) (H.sec U) :=
            isNoetherian_of_isNoetherianRing_of_finite _ _
          exact Module.Finite.iff_fg.mpr (hNoethM.noetherian (N U))
        · intro U W hU_aff hW_aff ha hWU
          have hU : IsSubChartAff U := ⟨hU_aff, ha⟩
          have hW : IsSubChartAff W := ⟨hW_aff, let ⟨a, ha'⟩ := ha; ⟨a, le_trans hWU ha'⟩⟩
          let A_U := ↑(C.presheaf.obj (Opposite.op U))
          let A_W := ↑(C.presheaf.obj (Opposite.op W))
          letI : Algebra A_U A_W :=
            RingHom.toAlgebra (C.presheaf.map (CategoryTheory.homOfLE hWU).op).hom
          haveI : Module.Flat A_U A_W := hFlatRes hU_aff hW_aff hWU
          obtain ⟨φ, hφ⟩ := hCohH.2 U W hU_aff hW_aff ha hWU
          let lSub : TensorProduct A_U A_W ↥(N U) →ₗ[A_W] TensorProduct A_U A_W (H.sec U) :=
            TensorProduct.AlgebraTensorModule.lTensor A_W A_W (N U).subtype
          have hlSub_eq : (lSub : TensorProduct A_U A_W ↥(N U) → TensorProduct A_U A_W (H.sec U)) =
              LinearMap.lTensor A_W (N U).subtype := by
            ext t
            induction t using TensorProduct.induction_on with
            | zero => simp
            | tmul b y => rfl
            | add x y hx hy =>
              change lSub (x + y) = LinearMap.lTensor A_W (N U).subtype (x + y)
              rw [map_add, map_add, hx, hy]
          have hlSub_inj : Function.Injective lSub := by
            rw [hlSub_eq]
            exact Module.Flat.lTensor_preserves_injective_linearMap
              (N U).subtype (Submodule.subtype_injective _)
          let ψ : TensorProduct A_U A_W ↥(N U) →ₗ[A_W] H.sec W := φ.toLinearMap.comp lSub
          have hψ_inj : Function.Injective ψ := φ.injective.comp hlSub_inj
          have hψ_range : LinearMap.range ψ = N W := by
            apply le_antisymm
            · rintro _ ⟨t, rfl⟩
              induction t using TensorProduct.induction_on with
              | zero => rw [map_zero]; exact (N W).zero_mem
              | tmul b y =>
                change φ (TensorProduct.tmul A_U b y.1) ∈ N W
                rw [hφ]
                exact (N W).smul_mem b (hN_res hWU y.1 y.2)
              | add t₁ t₂ ht₁ ht₂ =>
                rw [map_add]; exact (N W).add_mem ht₁ ht₂
            · rw [hN_eq W hW]
              refine le_trans (hBC_aff hU hW hWU) ?_
              rw [Submodule.span_le]
              rintro _ ⟨x, hx, rfl⟩
              have hxN : x ∈ N U := by rwa [hN_eq U hU]
              refine ⟨TensorProduct.tmul A_U 1 ⟨x, hxN⟩, ?_⟩
              change φ (TensorProduct.tmul A_U 1 x) = H.res hWU x
              rw [hφ, one_smul]
          let φ_sub : TensorProduct A_U A_W ↥(N U) ≃ₗ[A_W] ↥(N W) :=
            (LinearEquiv.ofInjective ψ hψ_inj).trans (LinearEquiv.ofEq _ _ hψ_range)
          refine ⟨φ_sub, fun b y => Subtype.ext ?_⟩
          change φ (TensorProduct.tmul A_U b y.1) = b • H.res hWU y.1
          exact hφ b y.1
      have hCohQuot : IsWeilCoherentSubChartModule V H_quot := by
        refine ⟨?_, ?_⟩
        · intro U hU_aff ha
          have _ : Module.Finite ↑(C.presheaf.obj (Opposite.op U)) (H.sec U) :=
            hCohH.1 U hU_aff ha
          exact Module.Finite.of_surjective (Submodule.mkQ (N U)) (Submodule.mkQ_surjective _)
        · intro U W hU_aff hW_aff ha hWU
          have hU : IsSubChartAff U := ⟨hU_aff, ha⟩
          have hW : IsSubChartAff W := ⟨hW_aff, let ⟨a, ha'⟩ := ha; ⟨a, le_trans hWU ha'⟩⟩
          let A_U := ↑(C.presheaf.obj (Opposite.op U))
          let A_W := ↑(C.presheaf.obj (Opposite.op W))
          letI : Algebra A_U A_W :=
            RingHom.toAlgebra (C.presheaf.map (CategoryTheory.homOfLE hWU).op).hom
          obtain ⟨φ, hφ⟩ := hCohH.2 U W hU_aff hW_aff ha hWU
          letI : Module A_U (H_quot.sec W) :=
            Module.compHom (H_quot.sec W) (algebraMap A_U A_W)
          haveI : IsScalarTower A_U A_W (H_quot.sec W) := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
          let r_quot : H_quot.sec U →ₗ[A_U] H_quot.sec W :=
            { toFun := H_quot.res hWU
              map_add' := map_add _
              map_smul' := fun a u => H_quot.res_smul hWU a u }
          let f_bilin : A_W →ₗ[A_W] (H_quot.sec U →ₗ[A_U] H_quot.sec W) :=
            { toFun := fun b =>
                { toFun := fun u => b • r_quot u
                  map_add' := fun u₁ u₂ => by rw [map_add, smul_add]
                  map_smul' := fun a u => by
                    dsimp only [RingHom.id_apply]
                    rw [LinearMap.map_smul]
                    change b • (algebraMap A_U A_W a • r_quot u) =
                      algebraMap A_U A_W a • (b • r_quot u)
                    rw [smul_smul, mul_comm, ← smul_smul] }
              map_add' := fun b₁ b₂ => LinearMap.ext fun u => add_smul b₁ b₂ (r_quot u)
              map_smul' := fun b₁ b₂ => LinearMap.ext fun u => mul_smul b₁ b₂ (r_quot u) }
          let f_quot : TensorProduct A_U A_W (H_quot.sec U) →ₗ[A_W] H_quot.sec W :=
            TensorProduct.AlgebraTensorModule.lift f_bilin
          let p₁ : TensorProduct A_U A_W (H.sec U) →ₗ[A_W]
              TensorProduct A_U A_W (H_quot.sec U) :=
            TensorProduct.AlgebraTensorModule.lTensor A_W A_W (Submodule.mkQ (N U))
          have hKerLift : N W ≤ LinearMap.ker (p₁.comp φ.symm.toLinearMap) := by
            rw [hN_eq W hW]
            refine le_trans (hBC_aff hU hW hWU) ?_
            rw [Submodule.span_le]
            rintro _ ⟨x, hx, rfl⟩
            have hxN : x ∈ N U := by rwa [hN_eq U hU]
            have hφx : φ.symm (H.res hWU x) = TensorProduct.tmul A_U 1 x := by
              apply φ.injective
              rw [LinearEquiv.apply_symm_apply, hφ, one_smul]
            change p₁ (φ.symm (H.res hWU x)) = 0
            rw [hφx, TensorProduct.AlgebraTensorModule.lTensor_tmul,
              Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero (N U)).mpr hxN,
              TensorProduct.tmul_zero]
          let g_quot : H_quot.sec W →ₗ[A_W] TensorProduct A_U A_W (H_quot.sec U) :=
            Submodule.liftQ (N W) (p₁.comp φ.symm.toLinearMap) hKerLift
          refine ⟨LinearEquiv.ofLinearMap f_quot g_quot ?_ ?_, fun b u => rfl⟩
          · apply LinearMap.ext
            intro w
            obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective (N W) w
            obtain ⟨t, rfl⟩ := φ.surjective y
            change f_quot (p₁ (φ.symm (φ t))) = Submodule.mkQ (N W) (φ t)
            rw [LinearEquiv.symm_apply_apply]
            induction t using TensorProduct.induction_on with
            | zero => simp
            | tmul b x =>
              change b • Submodule.Quotient.mk (p := N W) (H.res hWU x) =
                Submodule.Quotient.mk (p := N W) (φ (TensorProduct.tmul A_U b x))
              rw [hφ]
              rfl
            | add t₁ t₂ ht₁ ht₂ =>
              rw [map_add, map_add, ht₁, ht₂, ← map_add, ← map_add]
          · apply LinearMap.ext
            intro t
            induction t using TensorProduct.induction_on with
            | zero => simp
            | tmul b u =>
              obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective (N U) u
              change g_quot (b • Submodule.Quotient.mk (p := N W) (H.res hWU x)) =
                TensorProduct.tmul A_U b (Submodule.Quotient.mk (p := N U) x)
              have hmk : b • Submodule.Quotient.mk (p := N W) (H.res hWU x) =
                  Submodule.Quotient.mk (p := N W) (φ (TensorProduct.tmul A_U b x)) := by
                rw [hφ]; rfl
              rw [hmk]
              change p₁ (φ.symm (φ (TensorProduct.tmul A_U b x))) = _
              rw [LinearEquiv.symm_apply_apply]
              rfl
            | add t₁ t₂ ht₁ ht₂ =>
              change g_quot (f_quot t₁) = t₁ at ht₁
              change g_quot (f_quot t₂) = t₂ at ht₂
              change g_quot (f_quot (t₁ + t₂)) = t₁ + t₂
              rw [map_add, map_add, ht₁, ht₂]
      refine ⟨N, H_sub, H_quot,
        fun U => (N U).subtype,
        fun U => Submodule.mkQ (N U),
        hN_eq, fun _ _ => Iff.rfl, hN_res, hCohSub, hCohQuot,
        fun _ _ => rfl,
        fun hWU x => rfl,
        fun U => Submodule.subtype_injective (N U),
        fun U => Submodule.range_subtype (N U),
        fun U => Submodule.mkQ_surjective (N U),
        fun U => Submodule.ker_mkQ (N U)⟩
    have hProperSupp : ∀ (S₀ : TopologicalSpace.Closeds ↥C) (Q : WeilPresheafModule C),
        IsWeilCoherentSubChartModule V Q →
        (∀ (U : C.Opens), IsSubChartAff U →
          ∀ a ∈ RingHom.ker
            (((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal S₀).subschemeι.app U).hom),
            ∀ y : Q.sec U, a • y = 0) →
        IsWeilSupportedOn V Q S₀ ∧
        (∀ (W₀ : C.Opens), IsSubChartAff W₀ →
          ((W₀ : Set ↥C) ∩ (S₀ : Set ↥C)).Nonempty →
          (∀ y : Q.sec W₀, y = 0) →
          ∃ S'₀ : TopologicalSpace.Closeds ↥C, S'₀ < S₀ ∧ IsWeilSupportedOn V Q S'₀) := by
      intro S₀ Q hCohQ hAnnQ
      let I₀ := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal S₀
      let Z₀ := I₀.subscheme
      let ι₀ := I₀.subschemeι
      have hRange₀ : Set.range ι₀.base = (S₀ : Set ↥C) :=
        (I₀.range_subschemeι).trans (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal S₀)
      have hSuppFull : IsWeilSupportedOn V Q S₀ := by
        intro U hU_aff ha hDisj y
        have hU : IsSubChartAff U := ⟨hU_aff, ha⟩
        let U_Z := (TopologicalSpace.Opens.map ι₀.base).obj U
        have hUZ_aff : AlgebraicGeometry.IsAffineOpen U_Z :=
          (AlgebraicGeometry.isAffineHom_iff ι₀).mp inferInstance U hU_aff
        have hEmpSpec : IsEmpty (PrimeSpectrum ↑(Z₀.presheaf.obj (Opposite.op U_Z))) :=
          ⟨fun p =>
            let z := hUZ_aff.isoSpec.inv.base p
            Set.disjoint_left.mp hDisj z.2 (by rw [← hRange₀]; exact ⟨z.1, rfl⟩)⟩
        have : Subsingleton ↑(Z₀.presheaf.obj (Opposite.op U_Z)) :=
          PrimeSpectrum.isEmpty_iff_subsingleton.mp hEmpSpec
        have h1 : (1 : ↑(C.presheaf.obj (Opposite.op U))) ∈ RingHom.ker ((ι₀.app U).hom) :=
          Subsingleton.elim _ _
        calc y = (1 : ↑(C.presheaf.obj (Opposite.op U))) • y := (one_smul _ y).symm
          _ = 0 := hAnnQ U hU 1 h1 y
      refine ⟨hSuppFull, ?_⟩
      intro W₀ hW₀ hNe₀ hVan₀
      let S'₀ : TopologicalSpace.Closeds ↥C :=
        S₀ ⊓ ⟨(W₀ : Set ↥C)ᶜ, W₀.2.isClosed_compl⟩
      have hlt : S'₀ < S₀ := by
        refine lt_of_le_of_ne inf_le_left ?_
        intro hEq
        obtain ⟨x₀, hxW₀, hxS₀⟩ := hNe₀
        have hxS'₀ : x₀ ∈ (S'₀ : Set ↥C) := by rw [hEq]; exact hxS₀
        exact hxS'₀.2 hxW₀
      refine ⟨S'₀, hlt, ?_⟩
      intro U hU_aff ha hDisj q_el
      have hU : IsSubChartAff U := ⟨hU_aff, ha⟩
      let W := U ⊓ W₀
      have hW_aff : AlgebraicGeometry.IsAffineOpen W := hAffInter U W₀ hU_aff hW₀.1
      obtain ⟨φ₀, _⟩ := hCohQ.2 W₀ W hW₀.1 hW_aff hW₀.2 inf_le_right
      have hVanW : ∀ z : Q.sec W, z = 0 := by
        intro z
        obtain ⟨t, rfl⟩ := φ₀.surjective z
        induction t using TensorProduct.induction_on with
        | zero => exact map_zero _
        | tmul b y => rw [hVan₀ y, TensorProduct.tmul_zero, map_zero]
        | add t₁ t₂ ht₁ ht₂ => rw [map_add, ht₁, ht₂, add_zero]
      let U_Z := (TopologicalSpace.Opens.map ι₀.base).obj U
      let W_Z := (TopologicalSpace.Opens.map ι₀.base).obj W
      have hEqZ : W_Z = U_Z := by
        ext z
        refine ⟨fun hz => hz.1, fun hzU => ⟨hzU, ?_⟩⟩
        have hzS : ι₀.base z ∈ (S₀ : Set ↥C) := by rw [← hRange₀]; exact ⟨z, rfl⟩
        by_contra hzNotW₀
        exact Set.disjoint_left.mp hDisj hzU ⟨hzS, hzNotW₀⟩
      let A_U := ↑(C.presheaf.obj (Opposite.op U))
      let A_W := ↑(C.presheaf.obj (Opposite.op W))
      let B_U := ↑(Z₀.presheaf.obj (Opposite.op U_Z))
      let B_W := ↑(Z₀.presheaf.obj (Opposite.op W_Z))
      let r_UW : A_U →+* A_W := (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W ≤ U)).op).hom
      letI : Algebra A_U A_W := RingHom.toAlgebra r_UW
      let invZ : B_W →+* B_U :=
        (Z₀.presheaf.map (CategoryTheory.homOfLE (le_of_eq hEqZ.symm)).op).hom
      have hNatUW : ∀ a_U : A_U,
          invZ ((ι₀.app W).hom (r_UW a_U)) = (ι₀.app U).hom a_U := by
        intro a_U
        have hNat := congrArg (fun f => f.hom a_U)
          (ι₀.naturality (CategoryTheory.homOfLE (inf_le_left : W ≤ U)).op)
        change invZ ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W ≤ U)).op ≫
          ι₀.app W).hom a_U) = _
        rw [hNat]
        change (Z₀.presheaf.map _ ≫ Z₀.presheaf.map _).hom ((ι₀.app U).hom a_U) = _
        rw [← Z₀.presheaf.map_comp, ← op_comp,
          Subsingleton.elim
            (CategoryTheory.homOfLE (le_of_eq hEqZ.symm) ≫
              (TopologicalSpace.Opens.map ι₀.base).map (CategoryTheory.homOfLE inf_le_left).op.unop)
            (𝟙 U_Z),
          op_id, Z₀.presheaf.map_id]
        rfl
      have hSurjU : Function.Surjective (ι₀.app U).hom :=
        I₀.subschemeι_app_surjective ⟨U, hU_aff⟩
      let liftA : B_U → A_U := fun b => Classical.choose (hSurjU b)
      have hliftA : ∀ b : B_U, (ι₀.app U).hom (liftA b) = b :=
        fun b => Classical.choose_spec (hSurjU b)
      let smulB : B_U → Q.sec U → Q.sec U := fun b x => liftA b • x
      have hSmulB_eq : ∀ (b : B_U) (a : A_U) (x : Q.sec U),
          (ι₀.app U).hom a = b → smulB b x = a • x := by
        intro b a x hab
        have hker : liftA b - a ∈ RingHom.ker (ι₀.app U).hom := by
          rw [RingHom.mem_ker, map_sub, hliftA, hab, sub_self]
        have hsub := hAnnQ U hU (liftA b - a) hker x
        rw [sub_smul, sub_eq_zero] at hsub
        exact hsub
      let ψ_bilin : A_W →ₗ[A_U] (Q.sec U →ₗ[A_U] Q.sec U) :=
        { toFun := fun a_W =>
            { toFun := fun x => smulB (invZ ((ι₀.app W).hom a_W)) x
              map_add' := fun x₁ x₂ => smul_add _ x₁ x₂
              map_smul' := fun a_U x => smul_comm _ a_U x }
          map_add' := fun a₁ a₂ => LinearMap.ext fun x => by
            dsimp only [LinearMap.add_apply, LinearMap.coe_mk, AddHom.coe_mk]
            rw [map_add, map_add,
              hSmulB_eq _ (liftA (invZ ((ι₀.app W).hom a₁)) + liftA (invZ ((ι₀.app W).hom a₂))) x
                (by rw [map_add, hliftA, hliftA]),
              add_smul]
          map_smul' := fun a_U a_W => LinearMap.ext fun x => by
            dsimp only [RingHom.id_apply]
            change smulB (invZ ((ι₀.app W).hom (r_UW a_U * a_W))) x =
              a_U • smulB (invZ ((ι₀.app W).hom a_W)) x
            rw [map_mul, map_mul, hNatUW,
              hSmulB_eq _ (a_U * liftA (invZ ((ι₀.app W).hom a_W))) x
                (by rw [map_mul, hliftA]),
              mul_smul] }
      let Ψ : TensorProduct A_U A_W (Q.sec U) →ₗ[A_U] Q.sec U := TensorProduct.lift ψ_bilin
      obtain ⟨φ_WU, _⟩ := hCohQ.2 U W hU_aff hW_aff ha inf_le_left
      have h1q : (TensorProduct.tmul A_U (1 : A_W) q_el) = 0 :=
        φ_WU.injective (by rw [map_zero]; exact hVanW _)
      calc q_el
          = smulB 1 q_el := (one_smul _ q_el).symm.trans (hSmulB_eq 1 1 q_el (map_one _)).symm
        _ = Ψ (TensorProduct.tmul A_U (1 : A_W) q_el) := by
            change smulB 1 q_el = smulB (invZ ((ι₀.app W).hom 1)) q_el
            rw [map_one, map_one]
        _ = 0 := by rw [h1q, map_zero]
    refine ⟨hAffInter, hChartS, hNoethU, hFlatRes, hSubQuot, hProperSupp, ?_⟩
    intro S hZero hExt hSmaller hIrredAnn F hCohF hSuppF
    have hIdealSplit : ∀ (I : C.IdealSheafData) (H : WeilPresheafModule C),
        IsWeilCoherentSubChartModule V H →
        ∃ (H_sub H_quot : WeilPresheafModule C)
          (i : ∀ U : C.Opens, H_sub.sec U →ₗ[↑(C.presheaf.obj (Opposite.op U))] H.sec U)
          (q : ∀ U : C.Opens, H.sec U →ₗ[↑(C.presheaf.obj (Opposite.op U))] H_quot.sec U),
          IsWeilCoherentSubChartModule V H_sub ∧
          IsWeilCoherentSubChartModule V H_quot ∧
          (∀ {U W : C.Opens} (hWU : W ≤ U) (y : H_sub.sec U),
            i W (H_sub.res hWU y) = H.res hWU (i U y)) ∧
          (∀ {U W : C.Opens} (hWU : W ≤ U) (x : H.sec U),
            q W (H.res hWU x) = H_quot.res hWU (q U x)) ∧
          (∀ U : C.Opens, Function.Injective (i U)) ∧
          (∀ U : C.Opens, Function.Surjective (q U)) ∧
          (∀ (U : C.Opens) (x : H.sec U), q U x = 0 ↔ ∃ y, i U y = x) ∧
          (∀ (U : C.Opens) (hU : IsSubChartAff U),
            LinearMap.range (i U) =
              (RingHom.ker ((I.subschemeι.app U).hom)) • (⊤ : Submodule _ (H.sec U))) ∧
          (∀ (U : C.Opens),
            ∀ a ∈ RingHom.ker ((I.subschemeι.app U).hom),
              ∀ z : H_quot.sec U, a • z = 0) := by
      intro I H hCohH
      let J_id : ∀ U : C.Opens, Ideal ↑(C.presheaf.obj (Opposite.op U)) :=
        fun U => RingHom.ker ((I.subschemeι.app U).hom)
      have hJ_res : ∀ {U W : C.Opens} (hWU : W ≤ U) (a : ↑(C.presheaf.obj (Opposite.op U))),
          a ∈ J_id U → (C.presheaf.map (CategoryTheory.homOfLE hWU).op).hom a ∈ J_id W := by
        intro U W hWU a ha
        rw [RingHom.mem_ker] at ha ⊢
