                rw [Finset.sum_comm]
                refine Finset.sum_congr rfl fun j' _ => (Finset.mul_sum _ _ _).symm
            _ = ∑ j' : Fin (n₂ + 1), w j' * (if j = j' then 1 else 0) := by
                refine Finset.sum_congr rfl fun j' _ => by rw [hAB j' j]
            _ = w j := by simp }
