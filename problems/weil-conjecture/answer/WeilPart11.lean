        have hx₀_basic : hUa.fromSpec.base q₀ ∈ (E_sm.basicOpen s_a : Set E_sm) :=
          (h_spec_basic q₀).mpr hq₀_not_in
        exact hUniv_compl (Set.mem_univ _) hx₀_basic
    · intro hz_basic
      have hz_a : z ∈ U_a := hBasic_sub hz_basic
      refine ⟨hz_a, ?_⟩
      have hz_range :
          z ∈ Set.range (hUa.fromSpec.base :
            PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op U_a)) → E_sm) := by
        rw [hUa.range_fromSpec]
        exact hz_a
      rcases hz_range with ⟨p_z, hp_z⟩
      have hz_basic' : hUa.fromSpec.base p_z ∈ (E_sm.basicOpen s_a : Set E_sm) := by
        rwa [hp_z]
      have hsa_not_in : s_a ∉ p_z.asIdeal := (h_spec_basic p_z).mp hz_basic'
      change z ∈ (U_b : Set E_sm)
      rw [hUb_set]
      by_cases hz_cl : IsClosed ({z} : Set E_sm)
      · right
        have hz_cl' : IsClosed ({hUa.fromSpec.base p_z} : Set E_sm) := by rwa [hp_z]
        have h_not_ge1 : ¬((1 : WithTop ℤ) ≤ ord z t_a) := by
          intro hge1
          apply hsa_not_in
          rw [hφa_prime p_z hz_cl' s_a, hp_z, hsa_eq]
          exact hge1
        have hz_a' : z ∈ (U_a : Set E_sm) := hz_a
        rw [hUa_set] at hz_a'
        have hta_nonneg : (0 : WithTop ℤ) ≤ ord z t_a :=
          hz_a'.resolve_left (not_not.mpr hz_cl)
        exact (hOrd_iff z hz_cl hta_nonneg).mp h_not_ge1
      · exact Or.inl hz_cl
  have hInter₀ : U₀ ⊓ U₁ = E_sm.basicOpen s₀ :=
    hBasicEq f f⁻¹ U₀ U₁ hU₀ hU₀_ne hU₀_set hU₁_set φ₀ hφ₀ s₀ hf_ne hψ₀_X hOrd_zero_fwd
  have hInter₁ : U₀ ⊓ U₁ = E_sm.basicOpen s₁ := by
    rw [inf_comm]
    exact hBasicEq f⁻¹ f U₁ U₀ hU₁ hU₁_ne hU₁_set hU₀_set φ₁ hφ₁ s₁ hfinv_ne hψ₁_X hOrd_zero_rev
  let U₀₁ : E_sm.Opens := U₀ ⊓ U₁
  have hU₀₁ : AlgebraicGeometry.IsAffineOpen U₀₁ := by
    change AlgebraicGeometry.IsAffineOpen (U₀ ⊓ U₁)
    rw [hInter₀]
    exact hU₀.basicOpen s₀
  have hU₀₁_ne : Nonempty ↥U₀₁ := by
    let q₀ : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op U₀)) :=
      ⟨RingHom.ker φ₀.hom, RingHom.ker_isPrime φ₀.hom⟩
    have hq₀_in : q₀ ∈ PrimeSpectrum.basicOpen s₀ := by
      rw [PrimeSpectrum.mem_basicOpen]
      change φ₀.hom s₀ ≠ 0
      rw [hψ₀_X]
      exact hf_ne
    have hx₀_basic : hU₀.fromSpec.base q₀ ∈ E_sm.basicOpen s₀ :=
      (SetLike.ext_iff.mp (hU₀.fromSpec_preimage_basicOpen s₀) q₀).mpr hq₀_in
    have hx₀_U₀₁ : hU₀.fromSpec.base q₀ ∈ U₀₁ := by
      change hU₀.fromSpec.base q₀ ∈ U₀ ⊓ U₁
      rwa [hInter₀]
    exact ⟨⟨hU₀.fromSpec.base q₀, hx₀_U₀₁⟩⟩
  obtain ⟨φ₀₁, _hFrac₀₁, hφ₀₁⟩ := hFunc U₀₁ hU₀₁ hU₀₁_ne
  have hφ₀₁_inj : Function.Injective φ₀₁.hom :=
    (hB2 U₀₁ hU₀₁ hU₀₁_ne φ₀₁ hφ₀₁).1
  have hResCompat : ∀ (W : E_sm.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
      (hle : U₀₁ ≤ W)
      (φ_W : E_sm.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
      AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec = η_F →
      E_sm.presheaf.map (CategoryTheory.homOfLE hle).op ≫ φ₀₁ = φ_W := by
    intro W hW hle φ_W hφ_W
    apply AlgebraicGeometry.Spec.map_injective
    rw [← cancel_mono hW.fromSpec, AlgebraicGeometry.Spec.map_comp, Category.assoc,
      hW.map_fromSpec hU₀₁ (CategoryTheory.homOfLE hle).op, hφ₀₁, hφ_W]
  have hRecip :
      (E_sm.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op).hom s₀ *
        (E_sm.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op).hom s₁ = 1 := by
    apply hφ₀₁_inj
    rw [map_mul, map_one]
    have h0_eq := congrArg (fun g => g.hom s₀)
      (hResCompat U₀ hU₀ (inf_le_left : U₀₁ ≤ U₀) φ₀ hφ₀)
    have h1_eq := congrArg (fun g => g.hom s₁)
      (hResCompat U₁ hU₁ (inf_le_right : U₀₁ ≤ U₁) φ₁ hφ₁)
    dsimp only [CommRingCat.hom_comp, RingHom.comp_apply] at h0_eq h1_eq
    rw [h0_eq, h1_eq, hψ₀_X, hψ₁_X, mul_inv_cancel₀ hf_ne]
  exact weil_twoChart_polyEquiv_iso_projectiveLine Ω
    (hAff_proj Ω 1) (c_proj Ω 1) (t_proj Ω 1) (hCoord_proj Ω 1)
    E_sm p_sm U₀ U₁ hU₀ hU₁ hCov s₀ s₁ hInter₀ hInter₁ hRecip hBij₀ hBij₁

theorem weil_dedekind_two_chart_euler_char_and_principal_deg_zero (Ω X F : Type u) [Field Ω] [IsAlgClosed Ω] [Field F] [Algebra Ω F]
    (IsPlace : X → Prop) (ord : X → F → WithTop ℤ) (x_sep : F) (K_div : X → ℤ)
    (hDed : IsSmoothCurveDedekindValuationData Ω X F IsPlace ord x_sep K_div) :
    ∃ g_E : ℕ,
      (∀ (D : X → ℤ),
        (∀ P : X, ¬IsPlace P → D P = 0) →
        {P : X | D P ≠ 0}.Finite →
        ∀ (E₀ E_inf E₀_inf L_D : Submodule Ω F),
          IsTwoChartDivisorSpaces Ω X F IsPlace ord x_sep D E₀ E_inf E₀_inf L_D →
          FiniteDimensional Ω ↥L_D ∧
          FiniteDimensional Ω (↥E₀_inf ⧸ Submodule.comap E₀_inf.subtype (E₀ ⊔ E_inf)) ∧
          (Module.finrank Ω ↥L_D : ℤ) -
            (Module.finrank Ω (↥E₀_inf ⧸ Submodule.comap E₀_inf.subtype (E₀ ⊔ E_inf)) : ℤ) =
            (∑ᶠ P : X, D P) + 1 - (g_E : ℤ) ∧
          ((∀ P : X, D P = 0) →
            Module.finrank Ω ↥L_D = 1 ∧
            Module.finrank Ω (↥E₀_inf ⧸ Submodule.comap E₀_inf.subtype (E₀ ⊔ E_inf)) = g_E)) ∧
      (∀ f : F, f ≠ 0 →
        {P : X | IsPlace P ∧ ord P f ≠ 0}.Finite ∧
        ∃ d_f : X → ℤ,
          (∀ P : X, ¬IsPlace P → d_f P = 0) ∧
          (∀ P : X, IsPlace P → ord P f = (d_f P : WithTop ℤ)) ∧
          (∑ᶠ P : X, d_f P) = 0) ∧
      (∀ (D : X → ℤ),
        (∀ P : X, ¬IsPlace P → D P = 0) →
        {P : X | D P ≠ 0}.Finite →
        ∀ (E₀ E_inf E₀_inf L_D : Submodule Ω F),
          IsTwoChartDivisorSpaces Ω X F IsPlace ord x_sep D E₀ E_inf E₀_inf L_D →
          Module.finrank Ω (↥E₀_inf ⧸ Submodule.comap E₀_inf.subtype (E₀ ⊔ E_inf)) = 0 →
          ∀ (m_cov : ℕ) (IsActive : Fin m_cov → Prop) (W_set : Fin m_cov → Set X),
            (∀ P : X, IsPlace P → ∃ a : Fin m_cov, IsActive a ∧ P ∈ W_set a) →
            (∀ a : Fin m_cov, IsActive a → {P : X | IsPlace P ∧ P ∉ W_set a}.Finite) →
            ∀ (c_F : Fin m_cov → Fin m_cov → F),
              (∀ a : Fin m_cov, IsActive a → c_F a a = 0) →
              (∀ a b : Fin m_cov, IsActive a → IsActive b →
                ∀ P : X, P ∈ W_set a ∩ W_set b → IsPlace P →
                  (-(D P) : WithTop ℤ) ≤ ord P (c_F a b)) →
              (∀ a b d : Fin m_cov, IsActive a → IsActive b → IsActive d →
                c_F a b + c_F b d = c_F a d) →
              ∃ f_F : Fin m_cov → F,
                (∀ a : Fin m_cov, IsActive a →
                  ∀ P : X, P ∈ W_set a → IsPlace P →
                    (-(D P) : WithTop ℤ) ≤ ord P (f_F a)) ∧
                (∀ a b : Fin m_cov, IsActive a → IsActive b →
                  c_F a b = f_F a - f_F b)) :=
by
  classical
  
  
  
  have hSubquotChain : ∀ {W : Type u} [AddCommGroup W] [Module Ω W]
      (A₁ A₂ A₃ : Submodule Ω W), A₁ ≤ A₂ → A₂ ≤ A₃ →
      ((FiniteDimensional Ω (↥A₃ ⧸ Submodule.comap A₃.subtype A₁) ↔
        (FiniteDimensional Ω (↥A₂ ⧸ Submodule.comap A₂.subtype A₁) ∧
          FiniteDimensional Ω (↥A₃ ⧸ Submodule.comap A₃.subtype A₂))) ∧
       (FiniteDimensional Ω (↥A₂ ⧸ Submodule.comap A₂.subtype A₁) →
        FiniteDimensional Ω (↥A₃ ⧸ Submodule.comap A₃.subtype A₂) →
        Module.finrank Ω (↥A₃ ⧸ Submodule.comap A₃.subtype A₁) =
          Module.finrank Ω (↥A₂ ⧸ Submodule.comap A₂.subtype A₁) +
          Module.finrank Ω (↥A₃ ⧸ Submodule.comap A₃.subtype A₂))) := by
    intro W _ _ A₁ A₂ A₃ h12 h23
    let C₁ : Submodule Ω ↥A₃ := Submodule.comap A₃.subtype A₁
    let C₂ : Submodule Ω ↥A₃ := Submodule.comap A₃.subtype A₂
    have hC12 : C₁ ≤ C₂ := fun z hz => h12 hz
    let N : Submodule Ω (↥A₃ ⧸ C₁) := Submodule.map C₁.mkQ C₂
    let e_quot : ((↥A₃ ⧸ C₁) ⧸ N) ≃ₗ[Ω] (↥A₃ ⧸ C₂) :=
      Submodule.quotientQuotientEquivQuotient C₁ C₂ hC12
    let f : ↥A₂ →ₗ[Ω] (↥A₃ ⧸ C₁) := C₁.mkQ.comp (Submodule.inclusion h23)
    have hker : LinearMap.ker f = Submodule.comap A₂.subtype A₁ := by
      ext y
      simp only [f, LinearMap.mem_ker, LinearMap.comp_apply, Submodule.mkQ_apply,
        Submodule.Quotient.mk_eq_zero, C₁, Submodule.mem_comap, Submodule.subtype_apply,
        Submodule.inclusion_apply]
    have hrange : LinearMap.range f = N := by
      ext t
      constructor
      · rintro ⟨y, rfl⟩
        exact ⟨Submodule.inclusion h23 y, y.2, rfl⟩
      · rintro ⟨z, hz, rfl⟩
        exact ⟨⟨z.1, hz⟩, rfl⟩
    let e_sub : (↥A₂ ⧸ Submodule.comap A₂.subtype A₁) ≃ₗ[Ω] ↥N :=
      (Submodule.quotEquivOfEq _ _ hker.symm).trans
        (f.quotKerEquivRange.trans (LinearEquiv.ofEq _ _ hrange))
    have hFD_iff : FiniteDimensional Ω (↥A₃ ⧸ C₁) ↔
        (FiniteDimensional Ω (↥A₂ ⧸ Submodule.comap A₂.subtype A₁) ∧
          FiniteDimensional Ω (↥A₃ ⧸ C₂)) := by
      constructor
      · intro hFD
        have _ : FiniteDimensional Ω ↥N := inferInstance
        have _ : FiniteDimensional Ω ((↥A₃ ⧸ C₁) ⧸ N) := inferInstance
        exact ⟨Module.Finite.equiv e_sub.symm, Module.Finite.equiv e_quot⟩
      · rintro ⟨hFD₁, hFD₂⟩
        have _ : Module.Finite Ω ↥N := Module.Finite.equiv e_sub
        have _ : Module.Finite Ω ((↥A₃ ⧸ C₁) ⧸ N) := Module.Finite.equiv e_quot.symm
        exact Module.Finite.of_submodule_quotient N
    refine ⟨hFD_iff, ?_⟩
    intro hFD₁ hFD₂
    have _ : FiniteDimensional Ω (↥A₃ ⧸ C₁) := hFD_iff.mpr ⟨hFD₁, hFD₂⟩
    have hAdd := Submodule.finrank_quotient_add_finrank N
    rw [e_quot.finrank_eq, e_sub.symm.finrank_eq] at hAdd
    dsimp only [C₁, C₂] at hAdd
    omega

  have hDiamond : ∀ {U V : Type u} [AddCommGroup U] [Module Ω U] [AddCommGroup V] [Module Ω V]
      (A A' : Submodule Ω U) (B B' : Submodule Ω V) (φ : U →ₗ[Ω] V),
      A ≤ A' → B ≤ B' →
      Submodule.map φ A ≤ B → Submodule.map φ A' ≤ B' →
      FiniteDimensional Ω (↥A' ⧸ Submodule.comap A'.subtype A) →
      FiniteDimensional Ω (↥B' ⧸ Submodule.comap B'.subtype B) →
      let K := A ⊓ LinearMap.ker φ
      let K' := A' ⊓ LinearMap.ker φ
      let C := ↥B ⧸ Submodule.comap B.subtype (Submodule.map φ A)
      let C' := ↥B' ⧸ Submodule.comap B'.subtype (Submodule.map φ A')
      (FiniteDimensional Ω ↥K ↔ FiniteDimensional Ω ↥K') ∧
      (FiniteDimensional Ω C ↔ FiniteDimensional Ω C') ∧
      (FiniteDimensional Ω ↥K → FiniteDimensional Ω C →
        (Module.finrank Ω ↥K' : ℤ) - (Module.finrank Ω C' : ℤ) =
          (Module.finrank Ω ↥K : ℤ) - (Module.finrank Ω C : ℤ) +
          (Module.finrank Ω (↥A' ⧸ Submodule.comap A'.subtype A) : ℤ) -
          (Module.finrank Ω (↥B' ⧸ Submodule.comap B'.subtype B) : ℤ)) := by
    intro U V _ _ _ _ A A' B B' φ hAA' hBB' hφA hφA' hFDA hFDB K K' C C'
    have hKK' : K ≤ K' := inf_le_inf_right _ hAA'
    let I := Submodule.map φ A
    let I' := Submodule.map φ A'
    have hII' : I ≤ I' := Submodule.map_mono hAA'
    have hSup_le : K' ⊔ A ≤ A' := sup_le inf_le_left hAA'
    have hChainA := hSubquotChain A (K' ⊔ A) A' le_sup_right hSup_le
    obtain ⟨hFD_KA_sup, hFD_A'_sup⟩ := hChainA.1.mp hFDA
    have hRankA := hChainA.2 hFD_KA_sup hFD_A'_sup
    have hComapK : Submodule.comap K'.subtype K =
        Submodule.comap K'.subtype K' ⊓ Submodule.comap K'.subtype A := by
      ext x
      simp only [K, K', Submodule.mem_comap, Submodule.subtype_apply, Submodule.mem_inf]
      exact ⟨fun ⟨h1, _⟩ => ⟨x.2, h1⟩, fun ⟨⟨_, h2⟩, h3⟩ => ⟨h3, h2⟩⟩
    let e_KA : (↥K' ⧸ Submodule.comap K'.subtype K) ≃ₗ[Ω]
        (↥(K' ⊔ A) ⧸ Submodule.comap (K' ⊔ A).subtype A) :=
      (Submodule.quotEquivOfEq _ _ hComapK).trans
        (LinearMap.quotientInfEquivSupQuotient K' A)
    have hFD_QK : FiniteDimensional Ω (↥K' ⧸ Submodule.comap K'.subtype K) :=
      Module.Finite.equiv e_KA.symm
    let N_K : Submodule Ω ↥K' := Submodule.comap K'.subtype K
    let e_NK : ↥K ≃ₗ[Ω] ↥N_K :=
      { toFun := fun x => ⟨Submodule.inclusion hKK' x, x.2⟩
        invFun := fun y => ⟨y.1.1, y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    have hFD_K_iff : FiniteDimensional Ω ↥K ↔ FiniteDimensional Ω ↥K' := by
      constructor
      · intro hFDK
        have _ : Module.Finite Ω ↥N_K := Module.Finite.equiv e_NK
        have _ : Module.Finite Ω (↥K' ⧸ N_K) := hFD_QK
        exact Module.Finite.of_submodule_quotient N_K
      · intro hFDK'
        have _ : FiniteDimensional Ω ↥N_K := inferInstance
        exact Module.Finite.equiv e_NK.symm
    let g_I : ↥A' →ₗ[Ω] (↥I' ⧸ Submodule.comap I'.subtype I) :=
      { toFun := fun x => Submodule.Quotient.mk ⟨φ x.1, ⟨x.1, x.2, rfl⟩⟩
        map_add' := fun x y => by
          rw [← Submodule.Quotient.mk_add]
          congr 1
          ext
          exact map_add φ x.1 y.1
        map_smul' := fun c x => by
          rw [RingHom.id_apply, ← Submodule.Quotient.mk_smul]
          congr 1
          ext
          exact map_smul φ c x.1 }
    have hg_surj : Function.Surjective g_I := by
      intro q
      obtain ⟨⟨v, ⟨u, hu, rfl⟩⟩, rfl⟩ := Submodule.Quotient.mk_surjective _ q
      exact ⟨⟨u, hu⟩, rfl⟩
    have hg_ker : LinearMap.ker g_I = Submodule.comap A'.subtype (K' ⊔ A) := by
      ext x
      simp only [g_I, LinearMap.mem_ker, LinearMap.coe_mk, AddHom.coe_mk,
        Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, Submodule.subtype_apply, I,
        Submodule.mem_map]
      constructor
      · rintro ⟨a, ha, hφeq⟩
        have hk' : x.1 - a ∈ K' := by
          refine ⟨A'.sub_mem x.2 (hAA' ha), ?_⟩
          change φ (x.1 - a) = 0
          rw [map_sub, hφeq, sub_self]
        have hsum : (x.1 - a) + a = x.1 := sub_add_cancel x.1 a
        rw [← hsum]
        exact Submodule.add_mem_sup hk' ha
      · intro hx_sup
        rcases Submodule.mem_sup.mp hx_sup with ⟨k', hk', a, ha, hsum⟩
        refine ⟨a, ha, ?_⟩
        have hk'0 : φ k' = 0 := hk'.2
        rw [← hsum, map_add, hk'0, zero_add]
    let e_QI : (↥A' ⧸ Submodule.comap A'.subtype (K' ⊔ A)) ≃ₗ[Ω]
        (↥I' ⧸ Submodule.comap I'.subtype I) :=
      (Submodule.quotEquivOfEq _ _ hg_ker.symm).trans
        (LinearMap.quotKerEquivOfSurjective g_I hg_surj)
    have hFD_QI : FiniteDimensional Ω (↥I' ⧸ Submodule.comap I'.subtype I) :=
      Module.Finite.equiv e_QI
    let M := B ⊔ I'
    have hM_le_B' : M ≤ B' := sup_le hBB' hφA'
    have hChainBM := hSubquotChain B M B' le_sup_left hM_le_B'
    obtain ⟨hFD_MB, hFD_B'M⟩ := hChainBM.1.mp hFDB
    have hRankB := hChainBM.2 hFD_MB hFD_B'M
    have hChainIBM := hSubquotChain I B M hφA le_sup_left
    have hChainII'M := hSubquotChain I I' M hII' le_sup_right
    have hChainI'MB' := hSubquotChain I' M B' le_sup_right hM_le_B'
    have hFD_C_iff : FiniteDimensional Ω C ↔ FiniteDimensional Ω C' := by
      change FiniteDimensional Ω (↥B ⧸ Submodule.comap B.subtype I) ↔
        FiniteDimensional Ω (↥B' ⧸ Submodule.comap B'.subtype I')
      constructor
      · intro hFDC
        have hFD_MI : FiniteDimensional Ω (↥M ⧸ Submodule.comap M.subtype I) :=
          hChainIBM.1.mpr ⟨hFDC, hFD_MB⟩
        have hFD_MI' : FiniteDimensional Ω (↥M ⧸ Submodule.comap M.subtype I') :=
          (hChainII'M.1.mp hFD_MI).2
        exact hChainI'MB'.1.mpr ⟨hFD_MI', hFD_B'M⟩
      · intro hFDC'
        have hFD_MI' : FiniteDimensional Ω (↥M ⧸ Submodule.comap M.subtype I') :=
          (hChainI'MB'.1.mp hFDC').1
        have hFD_MI : FiniteDimensional Ω (↥M ⧸ Submodule.comap M.subtype I) :=
          hChainII'M.1.mpr ⟨hFD_QI, hFD_MI'⟩
        exact (hChainIBM.1.mp hFD_MI).1
    refine ⟨hFD_K_iff, hFD_C_iff, ?_⟩
    intro hFDK hFDC
    have _ : FiniteDimensional Ω ↥K' := hFD_K_iff.mp hFDK
    have hRankK := Submodule.finrank_quotient_add_finrank N_K
    rw [e_NK.symm.finrank_eq] at hRankK
    dsimp only [N_K] at hRankK
    rw [← e_KA.finrank_eq, e_QI.finrank_eq] at hRankA
    have hFD_MI : FiniteDimensional Ω (↥M ⧸ Submodule.comap M.subtype I) :=
      hChainIBM.1.mpr ⟨hFDC, hFD_MB⟩
    have hFD_MI' : FiniteDimensional Ω (↥M ⧸ Submodule.comap M.subtype I') :=
      (hChainII'M.1.mp hFD_MI).2
    have hRankIBM := hChainIBM.2 hFDC hFD_MB
    have hRankII'M := hChainII'M.2 hFD_QI hFD_MI'
    have hRankI'MB' := hChainI'MB'.2 hFD_MI' hFD_B'M
    dsimp only [C, C']
    change (Module.finrank Ω ↥K' : ℤ) -
        (Module.finrank Ω (↥B' ⧸ Submodule.comap B'.subtype I') : ℤ) =
      (Module.finrank Ω ↥K : ℤ) -
        (Module.finrank Ω (↥B ⧸ Submodule.comap B.subtype I) : ℤ) +
        (Module.finrank Ω (↥A' ⧸ Submodule.comap A'.subtype A) : ℤ) -
        (Module.finrank Ω (↥B' ⧸ Submodule.comap B'.subtype B) : ℤ)
    omega

  
  
  
  have hOrdZero : ∀ P : X, IsPlace P → ord P 0 = ⊤ :=
    fun P hP => ((hDed.2.1 P hP).1 0).mpr rfl
  have hOrdOne : ∀ P : X, IsPlace P → ord P 1 = 0 := by
    intro P hP
    have h1 := (hDed.2.1 P hP).2.2.2.1 1 one_ne_zero
    rwa [map_one] at h1
  have hOrdNegOne : ∀ P : X, IsPlace P → ord P (-1) = 0 := by
    intro P hP
    have h1 := (hDed.2.1 P hP).2.2.2.1 (-1) (neg_ne_zero.mpr one_ne_zero)
    rwa [map_neg, map_one] at h1
  have hOrdNeg : ∀ P : X, IsPlace P → ∀ v : F, ord P (-v) = ord P v := by
    intro P hP v
    have hEq : -v = (-1 : F) * v := by ring
    rw [hEq, (hDed.2.1 P hP).2.1, hOrdNegOne P hP, zero_add]
  have hOrdSub : ∀ P : X, IsPlace P → ∀ u v : F, min (ord P u) (ord P v) ≤ ord P (u - v) := by
    intro P hP u v
    rw [sub_eq_add_neg, ← hOrdNeg P hP v]
    exact (hDed.2.1 P hP).2.2.1 u (-v)
  have hOrdAlgNonneg : ∀ P : X, IsPlace P → ∀ c : Ω,
      (0 : WithTop ℤ) ≤ ord P (algebraMap Ω F c) := by
    intro P hP c
    by_cases hc : c = 0
    · rw [hc, map_zero, hOrdZero P hP]; exact le_top
    · rw [(hDed.2.1 P hP).2.2.2.1 c hc]
  let ordZ : ∀ (P : X), IsPlace P → ∀ (v : F), v ≠ 0 → ℤ :=
    fun P hP v hv => (ord P v).untop (((hDed.2.1 P hP).1 v).not.mpr hv)
  have hOrdZ : ∀ (P : X) (hP : IsPlace P) (v : F) (hv : v ≠ 0),
      ord P v = (ordZ P hP v hv : WithTop ℤ) :=
    fun P hP v hv => (WithTop.coe_untop _ (((hDed.2.1 P hP).1 v).not.mpr hv)).symm
  have hOrdInv : ∀ (P : X) (hP : IsPlace P) (v : F) (hv : v ≠ 0),
      ord P v⁻¹ = ((-(ordZ P hP v hv) : ℤ) : WithTop ℤ) := by
    intro P hP v hv
    have hv_inv : v⁻¹ ≠ 0 := inv_ne_zero hv
    have hmul : ord P v + ord P v⁻¹ = 0 := by
      rw [← (hDed.2.1 P hP).2.1, mul_inv_cancel₀ hv, hOrdOne P hP]
    rw [hOrdZ P hP v hv, hOrdZ P hP v⁻¹ hv_inv, ← WithTop.coe_add, ← WithTop.coe_zero,
      WithTop.coe_inj] at hmul
    rw [hOrdZ P hP v⁻¹ hv_inv]
    congr 1
    omega
  have hOrdPow : ∀ (P : X) (hP : IsPlace P) (v : F) (hv : v ≠ 0) (n : ℕ),
      ord P (v ^ n) = (((n : ℤ) * ordZ P hP v hv : ℤ) : WithTop ℤ) := by
    intro P hP v hv n
    induction n with
    | zero => simp [hOrdOne P hP]
    | succ n ih =>
      rw [pow_succ, (hDed.2.1 P hP).2.1, ih, hOrdZ P hP v hv, ← WithTop.coe_add]
      congr 1
      push_cast
      ring
  have hOrdZPow : ∀ (P : X) (hP : IsPlace P) (v : F) (hv : v ≠ 0) (m : ℤ),
      ord P (v ^ m) = ((m * ordZ P hP v hv : ℤ) : WithTop ℤ) := by
    intro P hP v hv m
    cases m with
    | ofNat n =>
      rw [Int.ofNat_eq_natCast, zpow_natCast, hOrdPow P hP v hv n]
    | negSucc n =>
      rw [zpow_negSucc, hOrdInv P hP (v ^ (n + 1)) (pow_ne_zero _ hv)]
      have hpow := hOrdPow P hP v hv (n + 1)
      rw [hOrdZ P hP (v ^ (n + 1)) (pow_ne_zero _ hv), WithTop.coe_inj] at hpow
      rw [hpow, Int.negSucc_eq]
      congr 1
      push_cast
      ring
  have hOrdPowNonneg : ∀ (P : X) (hP : IsPlace P) (s : F),
      (0 : WithTop ℤ) ≤ ord P s → ∀ n : ℕ, (0 : WithTop ℤ) ≤ ord P (s ^ n) := by
    intro P hP s hs n
    induction n with
    | zero => rw [pow_zero, hOrdOne P hP]
    | succ n ih =>
      rw [pow_succ, (hDed.2.1 P hP).2.1]
      simpa using add_le_add ih hs
  have hOrdPowGe : ∀ (P : X) (hP : IsPlace P) (s : F),
      (1 : WithTop ℤ) ≤ ord P s → ∀ n : ℕ, ((n : ℤ) : WithTop ℤ) ≤ ord P (s ^ n) := by
    intro P hP s hs n
    induction n with
    | zero => rw [pow_zero, hOrdOne P hP]; rfl
    | succ n ih =>
      rw [pow_succ, (hDed.2.1 P hP).2.1]
      have hle : ((n : ℤ) : WithTop ℤ) + ((1 : ℤ) : WithTop ℤ) ≤ ord P (s ^ n) + ord P s :=
        add_le_add ih hs
      rw [← WithTop.coe_add] at hle
      simpa [Nat.cast_add] using hle
  have hOrdProdZero : ∀ (P : X) (hP : IsPlace P) {α : Type u} (S : Finset α) (g : α → F),
      (∀ i ∈ S, ord P (g i) = 0) → ord P (∏ i ∈ S, g i) = 0 := by
    intro P hP α S g hg
    induction S using Finset.cons_induction with
    | empty => rw [Finset.prod_empty, hOrdOne P hP]
    | cons a s has ih =>
      rw [Finset.prod_cons, (hDed.2.1 P hP).2.1, hg a (Finset.mem_cons_self a s),
        ih (fun i hi => hg i (Finset.mem_cons_of_mem hi)), add_zero]
  have hOrdProdNonneg : ∀ (P : X) (hP : IsPlace P) {α : Type u} (S : Finset α) (g : α → F),
      (∀ i ∈ S, (0 : WithTop ℤ) ≤ ord P (g i)) → (0 : WithTop ℤ) ≤ ord P (∏ i ∈ S, g i) := by
    intro P hP α S g hg
    induction S using Finset.cons_induction with
    | empty => rw [Finset.prod_empty, hOrdOne P hP]
    | cons a s has ih =>
      rw [Finset.prod_cons, (hDed.2.1 P hP).2.1]
      simpa using add_le_add (hg a (Finset.mem_cons_self a s))
        (ih (fun i hi => hg i (Finset.mem_cons_of_mem hi)))
  have hCoeNeg : ∀ a : ℤ, (-(a : WithTop ℤ)) = ((-a : ℤ) : WithTop ℤ) := fun _ => rfl
  have hOrdSumGe : ∀ (P : X) (hP : IsPlace P) {α : Type} (S : Finset α) (g : α → F)
      (c : WithTop ℤ),
      (∀ i ∈ S, c ≤ ord P (g i)) → c ≤ ord P (∑ i ∈ S, g i) := by
    intro P hP α S g c hg
    induction S using Finset.cons_induction with
    | empty => rw [Finset.sum_empty, hOrdZero P hP]; exact le_top
    | cons a s has ih =>
      rw [Finset.sum_cons]
      exact le_trans (le_min (hg a (Finset.mem_cons_self a s))
        (ih (fun i hi => hg i (Finset.mem_cons_of_mem hi))))
        ((hDed.2.1 P hP).2.2.1 (g a) (∑ i ∈ s, g i))

  have hx_ne : x_sep ≠ 0 := by
    intro hx0
    apply hDed.2.2.2.1
    rw [hx0, map_zero]
  have hy_ne : x_sep⁻¹ ≠ 0 := inv_ne_zero hx_ne
  have hOrdY_iff : ∀ P : X, IsPlace P →
      ((0 : WithTop ℤ) ≤ ord P x_sep⁻¹ ↔ ord P x_sep ≤ (0 : WithTop ℤ)) := by
    intro P hP
    rw [hOrdInv P hP x_sep hx_ne, hOrdZ P hP x_sep hx_ne, ← WithTop.coe_zero,
      WithTop.coe_le_coe, WithTop.coe_le_coe]
    omega

  have hChart0 := hDed.2.2.2.2.1
  have hChartInf := hDed.2.2.2.2.2.1

  have hSepElem : ∀ (t : F), IsDedekindChartForCoord Ω X F IsPlace ord t →
      ∀ (P Q : X), IsPlace P → IsPlace Q →
        (0 : WithTop ℤ) ≤ ord P t → (0 : WithTop ℤ) ≤ ord Q t → Q ≠ P →
        ∃ s : ↥(integralClosure (↥(Algebra.adjoin Ω ({t} : Set F))) F),
          (1 : WithTop ℤ) ≤ ord Q (s : F) ∧ ord P (s : F) = 0 := by
    intro t hCt P Q hP hQ hPt hQt hQP
    let At := Algebra.adjoin Ω ({t} : Set F)
    let Bt := integralClosure (↥At) F
    have hNotEq : ¬ (∀ b : ↥Bt, (1 : WithTop ℤ) ≤ ord Q (b : F) ↔
        (1 : WithTop ℤ) ≤ ord P (b : F)) :=
      fun hall => hQP (hCt.2.2.2.2 Q P hQ hP hQt hPt hall)
    push Not at hNotEq
    obtain ⟨b, hb_diff⟩ := hNotEq
    have hZeroOfNotOne : ∀ (R : X) (hR : IsPlace R) (u : F),
        (0 : WithTop ℤ) ≤ ord R u → ¬ ((1 : WithTop ℤ) ≤ ord R u) → ord R u = 0 := by
      intro R hR u hu0 hu1
      have hu_ne : u ≠ 0 := by
        intro hu_z
        exact hu1 (by rw [hu_z, hOrdZero R hR]; exact le_top)
      rw [hOrdZ R hR u hu_ne] at hu0 hu1 ⊢
      rw [← WithTop.coe_zero] at hu0 ⊢
      replace hu0 := WithTop.coe_le_coe.mp hu0
      have hu1' : ¬ ((1 : ℤ) ≤ ordZ R hR u hu_ne) :=
        fun h => hu1 (WithTop.coe_le_coe.mpr h)
      rw [WithTop.coe_inj]
      omega
    rcases hb_diff with ⟨hbQ, hbP⟩ | ⟨hbQ, hbP⟩
    · refine ⟨b, hbQ, hZeroOfNotOne P hP (b : F)
        (hCt.2.2.1 (b : F) |>.mp b.2 P hP hPt) (not_le.mpr hbP)⟩
    · have hbQ_not : ¬ ((1 : WithTop ℤ) ≤ ord Q (b : F)) := not_le.mpr hbQ
      have hbQ0 : (0 : WithTop ℤ) ≤ ord Q (b : F) := hCt.2.2.1 (b : F) |>.mp b.2 Q hQ hQt
      obtain ⟨c, hcQ⟩ := (hDed.2.1 Q hQ).2.2.2.2.2 (b : F) hbQ0
      have hc_ne : c ≠ 0 := by
        intro hc0
        rw [hc0, map_zero, sub_zero] at hcQ
        exact hbQ_not hcQ
      have hc_Bt : algebraMap Ω F c ∈ Bt :=
        (hCt.2.2.1 _).mpr fun R hR _ => hOrdAlgNonneg R hR c
      let s : ↥Bt := ⟨(b : F) - algebraMap Ω F c, Bt.sub_mem b.2 hc_Bt⟩
      refine ⟨s, hcQ, hZeroOfNotOne P hP (s : F) (hCt.2.2.1 (s : F) |>.mp s.2 P hP hPt) ?_⟩
      intro hsP1
      have hEq : -(algebraMap Ω F c) = (s : F) - (b : F) := by
        change -(algebraMap Ω F c) = ((b : F) - algebraMap Ω F c) - (b : F)
        ring
      have h0 : ord P (-(algebraMap Ω F c)) = 0 := by
        rw [hOrdNeg P hP, (hDed.2.1 P hP).2.2.2.1 c hc_ne]
      have hmin : (1 : WithTop ℤ) ≤ ord P (-(algebraMap Ω F c)) := by
        rw [hEq]
        exact le_trans (le_min hsP1 hbP) (hOrdSub P hP (s : F) (b : F))
      rw [h0] at hmin
      exact absurd (WithTop.coe_le_coe.mp hmin) (by omega)

  
  
  
  let mkSub : (X → Prop) → (X → ℤ) → Submodule Ω F :=
    fun Cond D =>
      { carrier := {v : F | ∀ P : X, IsPlace P → Cond P → (-(D P) : WithTop ℤ) ≤ ord P v}
        zero_mem' := fun P hP _ => by rw [hOrdZero P hP]; exact le_top
        add_mem' := fun {v₁ v₂} hv₁ hv₂ P hP hC =>
          le_trans (le_min (hv₁ P hP hC) (hv₂ P hP hC)) ((hDed.2.1 P hP).2.2.1 v₁ v₂)
        smul_mem' := fun c {v} hv P hP hC => by
          by_cases hc : c = 0
          · rw [hc, zero_smul, hOrdZero P hP]; exact le_top
          · rw [Algebra.smul_def, (hDed.2.1 P hP).2.1, (hDed.2.1 P hP).2.2.2.1 c hc, zero_add]
            exact hv P hP hC }
  let E₀_c : (X → ℤ) → Submodule Ω F := fun D => mkSub (fun P => (0 : WithTop ℤ) ≤ ord P x_sep) D
  let E_inf_c : (X → ℤ) → Submodule Ω F := fun D => mkSub (fun P => ord P x_sep ≤ (0 : WithTop ℤ)) D
  let E₀_inf_c : (X → ℤ) → Submodule Ω F := fun D => mkSub (fun P => ord P x_sep = (0 : WithTop ℤ)) D
  let L_c : (X → ℤ) → Submodule Ω F := fun D => mkSub (fun _ => True) D
  let D_zero : X → ℤ := fun _ => 0

  have hZeroBase :
      FiniteDimensional Ω ↥(L_c D_zero) ∧
      Module.finrank Ω ↥(L_c D_zero) = 1 ∧
      FiniteDimensional Ω (↥(E₀_inf_c D_zero) ⧸
        Submodule.comap (E₀_inf_c D_zero).subtype (E₀_c D_zero ⊔ E_inf_c D_zero)) := by
    let x := x_sep
    let y := x_sep⁻¹
    have hxy : x * y = 1 := mul_inv_cancel₀ hx_ne
    let A₀ := Algebra.adjoin Ω ({x} : Set F)
    let B₀ := integralClosure (↥A₀) F
    let L_x := IntermediateField.adjoin Ω ({x} : Set F)
    let A_inf := Algebra.adjoin Ω ({y} : Set F)
    let B_inf := integralClosure (↥A_inf) F
    let L_y := IntermediateField.adjoin Ω ({y} : Set F)

    have hinj_x : Function.Injective (Polynomial.aeval x : Polynomial Ω →ₐ[Ω] F) :=
      transcendental_iff_injective.mp hChart0.1
    have heq_x : (Polynomial.aeval x : Polynomial Ω →ₐ[Ω] F).range = A₀ :=
      (Algebra.adjoin_singleton_eq_range_aeval Ω x).symm
    let e_x : Polynomial Ω ≃ₐ[Ω] ↥A₀ :=
      (AlgEquiv.ofInjective (Polynomial.aeval x) hinj_x).trans (Subalgebra.equivOfEq _ _ heq_x)
    have _ : IsIntegrallyClosed ↥A₀ := IsIntegrallyClosed.of_equiv e_x.toRingEquiv
    have _ : IsNoetherianRing ↥A₀ := isNoetherianRing_of_ringEquiv (Polynomial Ω) e_x.toRingEquiv

    have hinj_y : Function.Injective (Polynomial.aeval y : Polynomial Ω →ₐ[Ω] F) :=
      transcendental_iff_injective.mp hChartInf.1
    have heq_y : (Polynomial.aeval y : Polynomial Ω →ₐ[Ω] F).range = A_inf :=
      (Algebra.adjoin_singleton_eq_range_aeval Ω y).symm
    let e_y : Polynomial Ω ≃ₐ[Ω] ↥A_inf :=
      (AlgEquiv.ofInjective (Polynomial.aeval y) hinj_y).trans (Subalgebra.equivOfEq _ _ heq_y)
    have _ : IsIntegrallyClosed ↥A_inf := IsIntegrallyClosed.of_equiv e_y.toRingEquiv
    have _ : IsNoetherianRing ↥A_inf :=
      isNoetherianRing_of_ringEquiv (Polynomial Ω) e_y.toRingEquiv

    have hLxLy : L_x = L_y := by
      apply le_antisymm
      · rw [IntermediateField.adjoin_simple_le_iff]
        have hy_in : y ∈ L_y := IntermediateField.mem_adjoin_simple_self Ω y
        have hy_inv : y⁻¹ ∈ L_y := L_y.inv_mem hy_in
        rwa [inv_inv] at hy_inv
      · rw [IntermediateField.adjoin_simple_le_iff]
        exact L_x.inv_mem (IntermediateField.mem_adjoin_simple_self Ω x)

    have hInterA : ∀ z : F, z ∈ A₀ → z ∈ A_inf → ∃ c : Ω, algebraMap Ω F c = z := by
      intro z hz0 hzInf
      rw [← heq_x] at hz0
      rw [← heq_y] at hzInf
      obtain ⟨P, hP_eq⟩ := hz0
      obtain ⟨Q, hQ_eq⟩ := hzInf
      change Polynomial.aeval x P = z at hP_eq
      change Polynomial.aeval y Q = z at hQ_eq
      let m := Q.natDegree
      let R : Polynomial Ω :=
        ∑ j ∈ Finset.range (m + 1), Polynomial.C (Q.coeff j) * Polynomial.X ^ (m - j)
      have hEvalEq : Polynomial.aeval x (Polynomial.X ^ m * P) = Polynomial.aeval x R := by
        rw [map_mul, map_pow, Polynomial.aeval_X, hP_eq, ← hQ_eq,
          Polynomial.aeval_eq_sum_range, Finset.mul_sum]
        simp only [R, map_sum, map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X]
        refine Finset.sum_congr rfl fun j hj => ?_
        have hj_le : j ≤ m := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
        rw [Algebra.smul_def]
        have hxmy : x ^ m * y ^ j = x ^ (m - j) := by
          have hm_split : m = (m - j) + j := (Nat.sub_add_cancel hj_le).symm
          calc x ^ m * y ^ j
              = (x ^ (m - j) * x ^ j) * y ^ j := by rw [← pow_add, ← hm_split]
            _ = x ^ (m - j) * (x * y) ^ j := by rw [mul_assoc, ← mul_pow]
            _ = x ^ (m - j) := by rw [hxy, one_pow, mul_one]
        calc x ^ m * (algebraMap Ω F (Q.coeff j) * y ^ j)
            = algebraMap Ω F (Q.coeff j) * (x ^ m * y ^ j) := by ring
          _ = algebraMap Ω F (Q.coeff j) * x ^ (m - j) := by rw [hxmy]
      have hPolyEq : Polynomial.X ^ m * P = R := hinj_x hEvalEq
      let c₀ : Ω := P.coeff 0
      have hP_const : P = Polynomial.C c₀ := by
        ext k
        rw [Polynomial.coeff_C]
        split_ifs with hk0
        · subst hk0; rfl
        · have hk_pos : 1 ≤ k := Nat.one_le_iff_ne_zero.mpr hk0
          have hCoeff := congrArg (fun p : Polynomial Ω => p.coeff (k + m)) hPolyEq
          rw [Polynomial.coeff_X_pow_mul] at hCoeff
          rw [hCoeff]
          simp only [R, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
          refine Finset.sum_eq_zero fun j _ => ?_
          have hne : ¬ (k + m = m - j) := by omega
          simp [hne]
      refine ⟨c₀, ?_⟩
      rw [← hP_eq, hP_const, Polynomial.aeval_C]

    let _ : Algebra ↥A₀ ↥L_x :=
      IntermediateField.algebraAdjoinAdjoin.instAlgebraSubtypeMemSubalgebraAdjoinAdjoin Ω ({x} : Set F)
    have _ : IsFractionRing ↥A₀ ↥L_x :=
      IntermediateField.algebraAdjoinAdjoin.instIsFractionRingSubtypeMemSubalgebraAdjoinAdjoin Ω ({x} : Set F)
    have _ : IsScalarTower ↥A₀ ↥L_x F := IsScalarTower.of_algebraMap_eq' rfl

    let _ : Algebra ↥A_inf ↥L_y :=
      IntermediateField.algebraAdjoinAdjoin.instAlgebraSubtypeMemSubalgebraAdjoinAdjoin Ω ({y} : Set F)
    have _ : IsFractionRing ↥A_inf ↥L_y :=
      IntermediateField.algebraAdjoinAdjoin.instIsFractionRingSubtypeMemSubalgebraAdjoinAdjoin Ω ({y} : Set F)
    have _ : IsScalarTower ↥A_inf ↥L_y F := IsScalarTower.of_algebraMap_eq' rfl

    have hL0_eq_Ω : ∀ v : F, v ∈ L_c D_zero ↔ ∃ c : Ω, algebraMap Ω F c = v := by
      intro v
      constructor
      · intro hv
        have hv_ord : ∀ P : X, IsPlace P → (0 : WithTop ℤ) ≤ ord P v := by
          intro P hP
          simpa [D_zero] using hv P hP trivial
        have hv0 : v ∈ B₀ := (hChart0.2.2.1 v).mpr fun P hP _ => hv_ord P hP
        have hvInf : v ∈ B_inf := (hChartInf.2.2.1 v).mpr fun P hP _ => hv_ord P hP
        have hmp_x : minpoly ↥L_x v = (minpoly ↥A₀ v).map (algebraMap ↥A₀ ↥L_x) :=
          minpoly.isIntegrallyClosed_eq_field_fractions' (K := ↥L_x) hv0
        have hmp_y : minpoly ↥L_y v = (minpoly ↥A_inf v).map (algebraMap ↥A_inf ↥L_y) :=
          minpoly.isIntegrallyClosed_eq_field_fractions' (K := ↥L_y) hvInf
        let e_L : ↥L_x ≃ₐ[Ω] ↥L_y := IntermediateField.equivOfEq hLxLy
        let q_y : Polynomial ↥L_y := (minpoly ↥L_x v).map e_L.toRingHom
        have hv_Lx : IsIntegral ↥L_x v := IsIntegral.tower_top (R := ↥A₀) hv0
        have hv_Ly : IsIntegral ↥L_y v := IsIntegral.tower_top (R := ↥A_inf) hvInf
        have hMx_monic : (minpoly ↥L_x v).Monic := minpoly.monic hv_Lx
        have hMy_monic : (minpoly ↥L_y v).Monic := minpoly.monic hv_Ly
        have hqy_monic : q_y.Monic := hMx_monic.map e_L.toRingHom
        have hcomp_y : (algebraMap ↥L_y F).comp e_L.toRingHom = algebraMap ↥L_x F :=
          RingHom.ext fun _ => rfl
        have hqy_eval : Polynomial.aeval v q_y = 0 := by
          change Polynomial.eval₂ (algebraMap ↥L_y F) v ((minpoly ↥L_x v).map e_L.toRingHom) = 0
          rw [Polynomial.eval₂_map, hcomp_y]
          exact minpoly.aeval ↥L_x v
        have hdvd_y : minpoly ↥L_y v ∣ q_y := minpoly.dvd ↥L_y v hqy_eval
        let q_x : Polynomial ↥L_x := (minpoly ↥L_y v).map e_L.symm.toRingHom
        have hqx_monic : q_x.Monic := hMy_monic.map e_L.symm.toRingHom
        have hcomp_x : (algebraMap ↥L_x F).comp e_L.symm.toRingHom = algebraMap ↥L_y F :=
          RingHom.ext fun _ => rfl
        have hqx_eval : Polynomial.aeval v q_x = 0 := by
          change Polynomial.eval₂ (algebraMap ↥L_x F) v
            ((minpoly ↥L_y v).map e_L.symm.toRingHom) = 0
          rw [Polynomial.eval₂_map, hcomp_x]
          exact minpoly.aeval ↥L_y v
        have hdvd_x : minpoly ↥L_x v ∣ q_x := minpoly.dvd ↥L_x v hqx_eval
        have hdeg_le : q_y.natDegree ≤ (minpoly ↥L_y v).natDegree := by
          rw [Polynomial.natDegree_map_eq_of_injective e_L.toRingHom.injective (minpoly ↥L_x v)]
          exact le_trans (Polynomial.natDegree_le_of_dvd hdvd_x hqx_monic.ne_zero)
            (le_of_eq (Polynomial.natDegree_map_eq_of_injective
              e_L.symm.toRingHom.injective (minpoly ↥L_y v)))
        have hMy_eq_qy : minpoly ↥L_y v = q_y :=
          (Polynomial.eq_of_monic_of_dvd_of_natDegree_le hMy_monic hqy_monic hdvd_y hdeg_le).symm
        have hCoeffInΩ : ∀ i : ℕ, ∃ c : Ω, algebraMap Ω F c = ((minpoly ↥L_x v).coeff i : F) := by
          intro i
          have hInA0 : ((minpoly ↥L_x v).coeff i : F) ∈ A₀ := by
            rw [hmp_x, Polynomial.coeff_map]
            exact ((minpoly ↥A₀ v).coeff i).2
          have hInAinf : ((minpoly ↥L_x v).coeff i : F) ∈ A_inf := by
            have hEqF : ((minpoly ↥L_y v).coeff i : F) = (q_y.coeff i : F) :=
              congrArg (fun p : Polynomial ↥L_y => (p.coeff i : F)) hMy_eq_qy
            have hqy_c : (q_y.coeff i : F) = ((minpoly ↥L_x v).coeff i : F) := by
              simp only [q_y, Polynomial.coeff_map]; rfl
            rw [← hqy_c, ← hEqF, hmp_y, Polynomial.coeff_map]
            exact ((minpoly ↥A_inf v).coeff i).2
          exact hInterA _ hInA0 hInAinf
        choose c_fn hc_fn using hCoeffInΩ
        let M_L := minpoly ↥L_x v
        let M_Ω : Polynomial Ω :=
          ∑ i ∈ Finset.range (M_L.natDegree + 1), Polynomial.C (c_fn i) * Polynomial.X ^ i
        have hMapM : M_Ω.map (algebraMap Ω ↥L_x) = M_L := by
          ext k
          rw [Polynomial.coeff_map]
          change algebraMap Ω F (M_Ω.coeff k) = (M_L.coeff k : F)
          simp only [M_Ω, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
          by_cases hk : k ≤ M_L.natDegree
          · rw [Finset.sum_eq_single k]
            · simp [hc_fn k, M_L]
            · intro j _ hjk
              have hne : ¬ (k = j) := hjk.symm
              simp [hne]
            · intro hnot; exact absurd (Finset.mem_range.mpr (Nat.lt_succ_of_le hk)) hnot
          · rw [Finset.sum_eq_zero, map_zero,
              Polynomial.coeff_eq_zero_of_natDegree_lt (Nat.lt_of_not_ge hk),
              ZeroMemClass.coe_zero]
            intro j hj
            have hj_le : j ≤ M_L.natDegree := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
            have hne : ¬ (k = j) := by omega
            simp [hne]
        have hMΩ_monic : M_Ω.Monic := by
          have hinj_ΩL : Function.Injective (algebraMap Ω ↥L_x) := (algebraMap Ω ↥L_x).injective
          have hdeg_eq : M_L.natDegree = M_Ω.natDegree := by
            rw [← hMapM]
            exact Polynomial.natDegree_map_eq_of_injective hinj_ΩL M_Ω
          apply hinj_ΩL
          rw [map_one, Polynomial.leadingCoeff, ← hdeg_eq, ← Polynomial.coeff_map, hMapM]
          exact hMx_monic.leadingCoeff
        have hMΩ_eval : Polynomial.aeval v M_Ω = 0 := by
          have hcomp_ΩL : (algebraMap ↥L_x F).comp (algebraMap Ω ↥L_x) = algebraMap Ω F :=
            RingHom.ext fun _ => rfl
          change Polynomial.eval₂ (algebraMap Ω F) v M_Ω = 0
          rw [← hcomp_ΩL, ← Polynomial.eval₂_map, hMapM]
          exact minpoly.aeval ↥L_x v
        have hv_int : IsIntegral Ω v := ⟨M_Ω, hMΩ_monic, hMΩ_eval⟩
        let K_alg := algebraicClosure Ω F
        have hvK : v ∈ K_alg := mem_algebraicClosure_iff'.mpr hv_int
        obtain ⟨c, hc⟩ :=
          (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := Ω) (K := ↥K_alg)).2 ⟨v, hvK⟩
        exact ⟨c, congrArg Subtype.val hc⟩
      · rintro ⟨c, rfl⟩ P hP _
        simpa [D_zero] using hOrdAlgNonneg P hP c

    let f_L0 : Ω →ₗ[Ω] ↥(L_c D_zero) :=
      { toFun := fun c => ⟨algebraMap Ω F c, (hL0_eq_Ω _).mpr ⟨c, rfl⟩⟩
        map_add' := fun a b => by ext; exact map_add (algebraMap Ω F) a b
        map_smul' := fun a b => by
          ext
          simp [Algebra.smul_def, map_mul] }
    let e_L0 : Ω ≃ₗ[Ω] ↥(L_c D_zero) :=
      LinearEquiv.ofBijective f_L0
        ⟨fun a b hab => (algebraMap Ω F).injective (congrArg Subtype.val hab),
         fun ⟨v, hv⟩ => by
           obtain ⟨c, rfl⟩ := (hL0_eq_Ω v).mp hv
           exact ⟨c, rfl⟩⟩
    have hFD_L0 : FiniteDimensional Ω ↥(L_c D_zero) := Module.Finite.equiv e_L0
    have hRank_L0 : Module.finrank Ω ↥(L_c D_zero) = 1 := by
      rw [← e_L0.finrank_eq, Module.finrank_self Ω]

    
    have _ : FiniteDimensional ↥L_y F := hChartInf.2.1.1
    have _ : Algebra.IsSeparable ↥L_y F := hChartInf.2.1.2
    have _ : Module.Finite ↥A_inf ↥B_inf :=
      IsIntegralClosure.finite ↥A_inf ↥L_y F ↥B_inf
    have hFinTop : Module.Finite ↥A_inf ↥(⊤ : Submodule ↥A_inf ↥B_inf) :=
      Module.Finite.equiv (Submodule.topEquiv (R := ↥A_inf) (M := ↥B_inf)).symm
    obtain ⟨S_gen, hS_gen⟩ := Module.Finite.iff_fg.mp hFinTop

    have hZ0_fin : {P : X | IsPlace P ∧ (1 : WithTop ℤ) ≤ ord P x}.Finite := by
      refine (hDed.2.2.1 x hx_ne).subset fun P ⟨hP, h1⟩ => ⟨hP, ?_⟩
      intro h0
      rw [h0] at h1
      exact absurd (WithTop.coe_le_coe.mp h1) (by omega)
    let F₀ : Finset X := hZ0_fin.toFinset
    let poleBound0 : ↥B_inf → X → ℕ := fun w P =>
      if hP : IsPlace P then
        if hw : (w : F) = 0 then 0 else (-ordZ P hP (w : F) hw).toNat
      else 0
    let N : ℕ := 1 + S_gen.sup (fun w => F₀.sup (fun P => poleBound0 w P))

    have hx_B0 : x ∈ B₀ := (hChart0.2.2.1 x).mpr fun _ _ hPx => hPx
    have hy_Binf : y ∈ B_inf := (hChartInf.2.2.1 y).mpr fun _ _ hPy => hPy

    have hxN_in_B0 : ∀ w ∈ S_gen, ∀ d : ℕ, N ≤ d → x ^ d * (w : F) ∈ E₀_c D_zero := by
      intro w hw_mem d hd P hP hPx0
      simp only [D_zero, WithTop.coe_zero, neg_zero]
      have hxN_B0 : x ^ N * (w : F) ∈ B₀ := by
        rw [hChart0.2.2.1]
        intro Q hQ hQx0
        by_cases hw0 : (w : F) = 0
        · rw [hw0, mul_zero, hOrdZero Q hQ]; exact le_top
        · by_cases hQx1 : (1 : WithTop ℤ) ≤ ord Q x
          · have hQ_in : Q ∈ F₀ := hZ0_fin.mem_toFinset.mpr ⟨hQ, hQx1⟩
            have hpb_le : poleBound0 w Q ≤ N := by
              have h1 : poleBound0 w Q ≤ F₀.sup (fun P => poleBound0 w P) :=
                Finset.le_sup (f := fun P => poleBound0 w P) hQ_in
              have h2 : F₀.sup (fun P => poleBound0 w P) ≤
                  S_gen.sup (fun w' => F₀.sup (fun P => poleBound0 w' P)) :=
                Finset.le_sup (f := fun w' => F₀.sup (fun P => poleBound0 w' P)) hw_mem
              omega
            have hpb_eq : poleBound0 w Q = (-ordZ Q hQ (w : F) hw0).toNat := by
              simp only [poleBound0, hQ, hw0, ↓reduceDIte]
            rw [(hDed.2.1 Q hQ).2.1, hOrdZ Q hQ (w : F) hw0]
            have hge1 : ((N : ℤ) : WithTop ℤ) ≤ ord Q (x ^ N) :=
              hOrdPowGe Q hQ x hQx1 N
            have hge2 : ((N : ℤ) + ordZ Q hQ (w : F) hw0 : WithTop ℤ) ≤
                ord Q (x ^ N) + (ordZ Q hQ (w : F) hw0 : WithTop ℤ) :=
              add_le_add hge1 le_rfl
            refine le_trans ?_ hge2
            rw [← WithTop.coe_add, ← WithTop.coe_zero, WithTop.coe_le_coe]
            omega
          · have hQx_eq0 : ord Q x = 0 := by
              rw [hOrdZ Q hQ x hx_ne] at hQx0 hQx1 ⊢
              rw [← WithTop.coe_zero] at hQx0 ⊢
              replace hQx0 := WithTop.coe_le_coe.mp hQx0
              have hQx1' : ¬ ((1 : ℤ) ≤ ordZ Q hQ x hx_ne) :=
                fun h => hQx1 (WithTop.coe_le_coe.mpr h)
              rw [WithTop.coe_inj]; omega
            have hQy0 : (0 : WithTop ℤ) ≤ ord Q y := (hOrdY_iff Q hQ).mpr (le_of_eq hQx_eq0)
            have hwQ0 : (0 : WithTop ℤ) ≤ ord Q (w : F) :=
              (hChartInf.2.2.1 (w : F)).mp w.2 Q hQ hQy0
            rw [(hDed.2.1 Q hQ).2.1]
            simpa using add_le_add (hOrdPowNonneg Q hQ x (le_of_eq hQx_eq0.symm) N) hwQ0
      have hd_eq : x ^ d * (w : F) = x ^ (d - N) * (x ^ N * (w : F)) := by
        rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hd]
      have h_in_B0 : x ^ d * (w : F) ∈ B₀ := by
        rw [hd_eq]
        exact B₀.mul_mem (B₀.pow_mem hx_B0 _) hxN_B0
      exact (hChart0.2.2.1 _).mp h_in_B0 P hP hPx0

    have hyk_in_Einf : ∀ w : ↥B_inf, ∀ k : ℕ, y ^ k * (w : F) ∈ E_inf_c D_zero := by
      intro w k P hP hPx_le0
      simp only [D_zero, WithTop.coe_zero, neg_zero]
      have h_in_Binf : y ^ k * (w : F) ∈ B_inf :=
        B_inf.mul_mem (B_inf.pow_mem hy_Binf k) w.2
      exact (hChartInf.2.2.1 _).mp h_in_Binf P hP ((hOrdY_iff P hP).mpr hPx_le0)

    have hTerm_in_E0inf : ∀ (w : ↥B_inf) (a b : ℕ),
        x ^ a * (y ^ b * (w : F)) ∈ E₀_inf_c D_zero := by
      intro w a b P hP hPx0
      simp only [D_zero, WithTop.coe_zero, neg_zero]
      have hPy0 : (0 : WithTop ℤ) ≤ ord P y := (hOrdY_iff P hP).mpr (le_of_eq hPx0)
      have hw0 : (0 : WithTop ℤ) ≤ ord P (w : F) :=
        (hChartInf.2.2.1 (w : F)).mp w.2 P hP hPy0
      rw [(hDed.2.1 P hP).2.1, (hDed.2.1 P hP).2.1]
      have hxa0 : (0 : WithTop ℤ) ≤ ord P (x ^ a) :=
        hOrdPowNonneg P hP x (le_of_eq hPx0.symm) a
      have hyb0 : (0 : WithTop ℤ) ≤ ord P (y ^ b) :=
        hOrdPowNonneg P hP y hPy0 b
      simpa using add_le_add hxa0 (add_le_add hyb0 hw0)

    let ℬ₀ : Finset ↥(E₀_inf_c D_zero) :=
      S_gen.biUnion fun w =>
        (Finset.range (N - 1)).image fun r =>
          ⟨x ^ (r + 1) * (w : F), by simpa [pow_zero, one_mul] using hTerm_in_E0inf w (r + 1) 0⟩

    have hZinf_fin : {P : X | IsPlace P ∧ (1 : WithTop ℤ) ≤ ord P y}.Finite := by
      refine (hDed.2.2.1 y hy_ne).subset fun P ⟨hP, h1⟩ => ⟨hP, ?_⟩
      intro h0
      rw [h0] at h1
      exact absurd (WithTop.coe_le_coe.mp h1) (by omega)
    let F_inf : Finset X := hZinf_fin.toFinset

    let C₀ := Submodule.comap (E₀_inf_c D_zero).subtype (E₀_c D_zero ⊔ E_inf_c D_zero)
    let H1_0 := ↥(E₀_inf_c D_zero) ⧸ C₀
    let S_span : Finset H1_0 := ℬ₀.image C₀.mkQ

    have hSpanTop : (⊤ : Submodule Ω H1_0) ≤ Submodule.span Ω (S_span : Set H1_0) := by
      intro q _
      obtain ⟨⟨v, hv⟩, rfl⟩ := Submodule.Quotient.mk_surjective C₀ q
      let M : ℕ := if hv0 : v = 0 then 0 else
        F_inf.sup fun P => if hP : IsPlace P then (-ordZ P hP v hv0).toNat else 0
      have hyMv_Binf : y ^ M * v ∈ B_inf := by
        rw [hChartInf.2.2.1]
        intro P hP hPy0
        by_cases hv0 : v = 0
        · rw [hv0, mul_zero, hOrdZero P hP]; exact le_top
        · by_cases hPy1 : (1 : WithTop ℤ) ≤ ord P y
          · have hP_in : P ∈ F_inf := hZinf_fin.mem_toFinset.mpr ⟨hP, hPy1⟩
            have hM_ge : (-ordZ P hP v hv0).toNat ≤ M := by
              have hle := Finset.le_sup
                (f := fun Q => if hQ : IsPlace Q then (-ordZ Q hQ v hv0).toNat else 0) hP_in
              simpa [M, hv0, hP] using hle
            rw [(hDed.2.1 P hP).2.1, hOrdZ P hP v hv0]
            have hge := add_le_add (hOrdPowGe P hP y hPy1 M)
              (le_rfl : (ordZ P hP v hv0 : WithTop ℤ) ≤ _)
            refine le_trans ?_ hge
            rw [← WithTop.coe_add, ← WithTop.coe_zero, WithTop.coe_le_coe]
            omega
          · have hPy_eq0 : ord P y = 0 := by
              rw [hOrdZ P hP y hy_ne] at hPy0 hPy1 ⊢
              rw [← WithTop.coe_zero] at hPy0 ⊢
              replace hPy0 := WithTop.coe_le_coe.mp hPy0
              have hPy1' : ¬ ((1 : ℤ) ≤ ordZ P hP y hy_ne) :=
                fun h => hPy1 (WithTop.coe_le_coe.mpr h)
              rw [WithTop.coe_inj]; omega
            have hPx_eq0 : ord P x = 0 := by
              rw [hOrdInv P hP x hx_ne, ← WithTop.coe_zero, WithTop.coe_inj] at hPy_eq0
              rw [hOrdZ P hP x hx_ne, ← WithTop.coe_zero, WithTop.coe_inj]
              omega
            have hvP0 : (0 : WithTop ℤ) ≤ ord P v := by
              simpa [D_zero] using hv P hP hPx_eq0
            rw [(hDed.2.1 P hP).2.1]
            simpa using add_le_add (hOrdPowNonneg P hP y (le_of_eq hPy_eq0.symm) M) hvP0
      have h_in_top : (⟨y ^ M * v, hyMv_Binf⟩ : ↥B_inf) ∈
          Submodule.span ↥A_inf (S_gen : Set ↥B_inf) := by
        rw [hS_gen]; trivial
      obtain ⟨a_coef, _, ha_sum⟩ := Submodule.mem_span_finset.mp h_in_top
      have ha_in_Ainf : ∀ w : ↥B_inf, ∃ Q_w : Polynomial Ω,
          Polynomial.aeval y Q_w = (a_coef w : F) := by
        intro w
        have hmem : (a_coef w : F) ∈ (Polynomial.aeval y : Polynomial Ω →ₐ[Ω] F).range := by
          rw [heq_y]; exact (a_coef w).2
        exact hmem
      choose Q_fn hQ_fn using ha_in_Ainf
      have hv_decomp : (⟨v, hv⟩ : ↥(E₀_inf_c D_zero)) =
          ∑ w ∈ S_gen, ∑ k ∈ Finset.range ((Q_fn w).natDegree + 1),
            ((Q_fn w).coeff k) •
              (⟨x ^ M * (y ^ k * (w : F)), hTerm_in_E0inf w M k⟩ : ↥(E₀_inf_c D_zero)) := by
        ext
        push_cast
        have hyMv_eq : y ^ M * v = ∑ w ∈ S_gen, (a_coef w : F) * (w : F) := by
          have hval := congrArg (Subtype.val : ↥B_inf → F) ha_sum.symm
          simpa [Algebra.smul_def] using hval
        calc v = (x * y) ^ M * v := by rw [hxy, one_pow, one_mul]
          _ = x ^ M * (y ^ M * v) := by rw [mul_pow, mul_assoc]
          _ = x ^ M * ∑ w ∈ S_gen, (a_coef w : F) * (w : F) := by rw [hyMv_eq]
          _ = ∑ w ∈ S_gen, x ^ M * ((Polynomial.aeval y (Q_fn w)) * (w : F)) := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl fun w _ => by rw [hQ_fn w]
          _ = ∑ w ∈ S_gen, ∑ k ∈ Finset.range ((Q_fn w).natDegree + 1),
              ((Q_fn w).coeff k) • (x ^ M * (y ^ k * (w : F))) := by
              refine Finset.sum_congr rfl fun w _ => ?_
              rw [Polynomial.aeval_eq_sum_range, Finset.sum_mul, Finset.mul_sum]
              refine Finset.sum_congr rfl fun k _ => ?_
              simp only [Algebra.smul_def]
              ring
      change C₀.mkQ ⟨v, hv⟩ ∈ Submodule.span Ω (S_span : Set H1_0)
      rw [hv_decomp, map_sum]
      refine Submodule.sum_mem _ fun w hw_mem => ?_
      rw [map_sum]
      refine Submodule.sum_mem _ fun k _ => ?_
      rw [map_smul]
      refine Submodule.smul_mem _ _ ?_
      by_cases hMk : M ≤ k
      · have h_eq : x ^ M * (y ^ k * (w : F)) = y ^ (k - M) * (w : F) := by
          have hk_split : k = M + (k - M) := (Nat.add_sub_of_le hMk).symm
          calc x ^ M * (y ^ k * (w : F))
              = (x ^ M * (y ^ M * y ^ (k - M))) * (w : F) := by
                rw [← pow_add, ← hk_split, mul_assoc]
            _ = ((x * y) ^ M * y ^ (k - M)) * (w : F) := by rw [← mul_assoc, ← mul_pow]
            _ = y ^ (k - M) * (w : F) := by rw [hxy, one_pow, one_mul]
        have hzero : C₀.mkQ ⟨x ^ M * (y ^ k * (w : F)), hTerm_in_E0inf w M k⟩ = 0 := by
          rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
          change x ^ M * (y ^ k * (w : F)) ∈ E₀_c D_zero ⊔ E_inf_c D_zero
          rw [h_eq]
          exact Submodule.mem_sup_right (hyk_in_Einf w (k - M))
        rw [hzero]
        exact Submodule.zero_mem _
      · have hk_lt : k < M := Nat.lt_of_not_ge hMk
        let d := M - k
        have h_eq : x ^ M * (y ^ k * (w : F)) = x ^ d * (w : F) := by
          have hM_split : M = d + k := (Nat.sub_add_cancel (le_of_lt hk_lt)).symm
          calc x ^ M * (y ^ k * (w : F))
              = ((x ^ d * x ^ k) * y ^ k) * (w : F) := by
                rw [← pow_add, ← hM_split, mul_assoc]
            _ = (x ^ d * (x * y) ^ k) * (w : F) := by rw [mul_assoc (x ^ d), ← mul_pow]
            _ = x ^ d * (w : F) := by rw [hxy, one_pow, mul_one]
        by_cases hdN : N ≤ d
        · have hzero : C₀.mkQ ⟨x ^ M * (y ^ k * (w : F)), hTerm_in_E0inf w M k⟩ = 0 := by
            rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
            change x ^ M * (y ^ k * (w : F)) ∈ E₀_c D_zero ⊔ E_inf_c D_zero
            rw [h_eq]
            exact Submodule.mem_sup_left (hxN_in_B0 w hw_mem d hdN)
          rw [hzero]
          exact Submodule.zero_mem _
        · have hd_lt : d < N := Nat.lt_of_not_ge hdN
          let r := d - 1
          have hr_mem : r ∈ Finset.range (N - 1) := Finset.mem_range.mpr (by omega)
          have hr_eq : r + 1 = d := by omega
          have h_in_B0 : (⟨x ^ M * (y ^ k * (w : F)), hTerm_in_E0inf w M k⟩ :
              ↥(E₀_inf_c D_zero)) ∈ ℬ₀ := by
            refine Finset.mem_biUnion.mpr ⟨w, hw_mem, Finset.mem_image.mpr ⟨r, hr_mem, ?_⟩⟩
            ext
            simp [hr_eq, h_eq]
          exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem C₀.mkQ h_in_B0))

    have hFG_H1 : (⊤ : Submodule Ω H1_0).FG :=
      ⟨S_span, le_antisymm le_top hSpanTop⟩
    have _ : Module.Finite Ω ↥(⊤ : Submodule Ω H1_0) := Module.Finite.iff_fg.mpr hFG_H1
    exact ⟨hFD_L0, hRank_L0, Module.Finite.equiv (Submodule.topEquiv (R := Ω) (M := H1_0))⟩

  
  
  
  let g_E : ℕ := Module.finrank Ω
    (↥(E₀_inf_c D_zero) ⧸ Submodule.comap (E₀_inf_c D_zero).subtype (E₀_c D_zero ⊔ E_inf_c D_zero))

  have hChartWitness : ∀ (t : F), IsDedekindChartForCoord Ω X F IsPlace ord t →
      ∀ (D : X → ℤ) (P₀ : X),
        {P : X | D P ≠ 0}.Finite → IsPlace P₀ → (0 : WithTop ℤ) ≤ ord P₀ t →
        ∃ v_t : F,
          ord P₀ v_t = ((-D P₀ - 1 : ℤ) : WithTop ℤ) ∧
          ∀ Q : X, IsPlace Q → (0 : WithTop ℤ) ≤ ord Q t → Q ≠ P₀ →
            (-(D Q) : WithTop ℤ) ≤ ord Q v_t := by
    intro t hCt D P₀ hD_fin hP₀ hP₀t
    let Bt := integralClosure (↥(Algebra.adjoin Ω ({t} : Set F))) F
    obtain ⟨ϖ, hϖ⟩ := (hDed.2.1 P₀ hP₀).2.2.2.2.1
    have hϖ_ne : ϖ ≠ 0 := by
      intro h0
      rw [h0, hOrdZero P₀ hP₀] at hϖ
      exact WithTop.top_ne_coe hϖ
    let w₀ : F := ϖ ^ (-D P₀ - 1 : ℤ)
    have hw₀_ne : w₀ ≠ 0 := zpow_ne_zero _ hϖ_ne
    have hϖ_Z : ordZ P₀ hP₀ ϖ hϖ_ne = 1 := by
      have h := hOrdZ P₀ hP₀ ϖ hϖ_ne
      rw [hϖ] at h
      exact WithTop.coe_inj.mp h.symm
    have hw₀_P₀ : ord P₀ w₀ = ((-D P₀ - 1 : ℤ) : WithTop ℤ) := by
      rw [hOrdZPow P₀ hP₀ ϖ hϖ_ne (-D P₀ - 1), hϖ_Z, mul_one]
    have hSbad_fin : {Q : X | IsPlace Q ∧ (0 : WithTop ℤ) ≤ ord Q t ∧ Q ≠ P₀ ∧
        (ord Q w₀ ≠ 0 ∨ D Q ≠ 0)}.Finite := by
      refine ((hDed.2.2.1 w₀ hw₀_ne).union hD_fin).subset ?_
      rintro Q ⟨hQ, _, _, h_or⟩
      rcases h_or with hwQ | hDQ
      · exact Or.inl ⟨hQ, hwQ⟩
      · exact Or.inr hDQ
    let F_bad : Finset X := hSbad_fin.toFinset
    have hSepChoice : ∀ Q : X, Q ∈ F_bad →
        ∃ s : ↥Bt, (1 : WithTop ℤ) ≤ ord Q (s : F) ∧ ord P₀ (s : F) = 0 := by
      intro Q hQ_mem
      obtain ⟨hQ, hQt, hQP₀, _⟩ := hSbad_fin.mem_toFinset.mp hQ_mem
      exact hSepElem t hCt P₀ Q hP₀ hQ hP₀t hQt hQP₀
    let s_fn : X → F := fun Q =>
      if hQ_mem : Q ∈ F_bad then ((Classical.choose (hSepChoice Q hQ_mem) : ↥Bt) : F) else 1
    let N_fn : X → ℕ := fun Q =>
      if hQ : IsPlace Q then (-D Q - ordZ Q hQ w₀ hw₀_ne).toNat else 0
    let v_t : F := (∏ Q ∈ F_bad, (s_fn Q) ^ (N_fn Q)) * w₀
    refine ⟨v_t, ?_, ?_⟩
    · rw [(hDed.2.1 P₀ hP₀).2.1, hw₀_P₀]
      have hProd0 : ord P₀ (∏ Q ∈ F_bad, (s_fn Q) ^ (N_fn Q)) = 0 := by
        refine hOrdProdZero P₀ hP₀ F_bad _ fun Q hQ_mem => ?_
        have hsP₀ : ord P₀ (s_fn Q) = 0 := by
          simp only [s_fn, hQ_mem, ↓reduceDIte]
          exact (Classical.choose_spec (hSepChoice Q hQ_mem)).2
        have hs_ne : s_fn Q ≠ 0 := by
          intro h0; rw [h0, hOrdZero P₀ hP₀] at hsP₀; exact WithTop.top_ne_coe hsP₀
        have hsZ : ordZ P₀ hP₀ (s_fn Q) hs_ne = 0 := by
          have h := hOrdZ P₀ hP₀ (s_fn Q) hs_ne
          rw [hsP₀, ← WithTop.coe_zero] at h
          exact WithTop.coe_inj.mp h.symm
        rw [hOrdPow P₀ hP₀ (s_fn Q) hs_ne (N_fn Q), hsZ, mul_zero, WithTop.coe_zero]
      rw [hProd0, zero_add]
    · intro Q hQ hQt hQP₀
      have hs_nonneg : ∀ R ∈ F_bad, (0 : WithTop ℤ) ≤ ord Q ((s_fn R) ^ (N_fn R)) := by
        intro R hR_mem
        apply hOrdPowNonneg Q hQ
        simp only [s_fn, hR_mem, ↓reduceDIte]
        exact (hCt.2.2.1 _).mp (Classical.choose (hSepChoice R hR_mem)).2 Q hQ hQt
      by_cases hQ_mem : Q ∈ F_bad
      · dsimp only [v_t]
        rw [← Finset.mul_prod_erase F_bad (fun R => (s_fn R) ^ (N_fn R)) hQ_mem,
          (hDed.2.1 Q hQ).2.1, (hDed.2.1 Q hQ).2.1, hOrdZ Q hQ w₀ hw₀_ne]
        have hsQ1 : (1 : WithTop ℤ) ≤ ord Q (s_fn Q) := by
          simp only [s_fn, hQ_mem, ↓reduceDIte]
          exact (Classical.choose_spec (hSepChoice Q hQ_mem)).1
        have hge1 : ((N_fn Q : ℤ) : WithTop ℤ) ≤ ord Q ((s_fn Q) ^ (N_fn Q)) :=
          hOrdPowGe Q hQ (s_fn Q) hsQ1 (N_fn Q)
        have hge2 : (0 : WithTop ℤ) ≤ ord Q (∏ R ∈ F_bad.erase Q, (s_fn R) ^ (N_fn R)) :=
          hOrdProdNonneg Q hQ _ _ fun R hR => hs_nonneg R (Finset.mem_of_mem_erase hR)
        have hge_tot : (((N_fn Q : ℤ) + ordZ Q hQ w₀ hw₀_ne : ℤ) : WithTop ℤ) ≤
            (ord Q ((s_fn Q) ^ (N_fn Q)) + ord Q (∏ R ∈ F_bad.erase Q, (s_fn R) ^ (N_fn R))) +
              (ordZ Q hQ w₀ hw₀_ne : WithTop ℤ) := by
          have h12 : ((N_fn Q : ℤ) : WithTop ℤ) ≤
              ord Q ((s_fn Q) ^ (N_fn Q)) + ord Q (∏ R ∈ F_bad.erase Q, (s_fn R) ^ (N_fn R)) := by
            simpa using add_le_add hge1 hge2
          rw [WithTop.coe_add]
          exact add_le_add h12 le_rfl
        refine le_trans ?_ hge_tot
        rw [hCoeNeg, WithTop.coe_le_coe]
        have hN_eq : N_fn Q = (-D Q - ordZ Q hQ w₀ hw₀_ne).toNat := by simp [N_fn, hQ]
        omega
      · have hNotOr : ¬ (ord Q w₀ ≠ 0 ∨ D Q ≠ 0) :=
          fun hor => hQ_mem (hSbad_fin.mem_toFinset.mpr ⟨hQ, hQt, hQP₀, hor⟩)
        push Not at hNotOr
        obtain ⟨hwQ0, hDQ0⟩ := hNotOr
        rw [hDQ0, WithTop.coe_zero, neg_zero, (hDed.2.1 Q hQ).2.1, hwQ0, add_zero]
        exact hOrdProdNonneg Q hQ F_bad _ hs_nonneg

  have hLocalQuot : ∀ (Cond : X → Prop) (D D' : X → ℤ) (P₀ : X),
      IsPlace P₀ → (∀ P : X, P ≠ P₀ → D' P = D P) → D' P₀ = D P₀ + 1 →
      ((¬ Cond P₀ →
        FiniteDimensional Ω (↥(mkSub Cond D') ⧸ Submodule.comap (mkSub Cond D').subtype (mkSub Cond D)) ∧
        Module.finrank Ω (↥(mkSub Cond D') ⧸ Submodule.comap (mkSub Cond D').subtype (mkSub Cond D)) = 0) ∧
       (Cond P₀ →
        (∃ v₀ ∈ mkSub Cond D', ord P₀ v₀ = ((-D P₀ - 1 : ℤ) : WithTop ℤ)) →
        FiniteDimensional Ω (↥(mkSub Cond D') ⧸ Submodule.comap (mkSub Cond D').subtype (mkSub Cond D)) ∧
        Module.finrank Ω (↥(mkSub Cond D') ⧸ Submodule.comap (mkSub Cond D').subtype (mkSub Cond D)) = 1)) := by
    intro Cond D D' P₀ hP₀ hD_off hD_at
    let M := mkSub Cond D
    let M' := mkSub Cond D'
    constructor
    · intro hNotC
      have hEqSub : Submodule.comap M'.subtype M = ⊤ := by
        rw [eq_top_iff]
        intro ⟨v, hv⟩ _ P hP hC
        have hne : P ≠ P₀ := fun hEq => hNotC (hEq ▸ hC)
        rw [← hD_off P hne]
        exact hv P hP hC
      have _ : Subsingleton (↥M' ⧸ Submodule.comap M'.subtype M) :=
        Submodule.Quotient.subsingleton_iff.mpr hEqSub
      exact ⟨inferInstance, Module.finrank_zero_of_subsingleton⟩
    · rintro hCP₀ ⟨v₀, hv₀_mem, hv₀_ord⟩
      have hv₀_ne : v₀ ≠ 0 := by
        intro h0; rw [h0, hOrdZero P₀ hP₀] at hv₀_ord; exact WithTop.top_ne_coe hv₀_ord
      have hv₀_Z : ordZ P₀ hP₀ v₀ hv₀_ne = -D P₀ - 1 := by
        have h := hOrdZ P₀ hP₀ v₀ hv₀_ne
        rw [hv₀_ord] at h
        exact WithTop.coe_inj.mp h.symm
      have hv₀_not_M : v₀ ∉ M := by
        intro hvM
        have hle := hvM P₀ hP₀ hCP₀
        rw [hv₀_ord, hCoeNeg, WithTop.coe_le_coe] at hle
        omega
      let N := Submodule.comap M'.subtype M
      let q₀ : ↥M' ⧸ N := N.mkQ ⟨v₀, hv₀_mem⟩
      let e_quot : Ω ≃ₗ[Ω] (↥M' ⧸ N) :=
        LinearEquiv.ofBijective (LinearMap.toSpanSingleton Ω (↥M' ⧸ N) q₀)
          ⟨by
            intro a b hab
            have hdiff : (a - b) • q₀ = 0 := by
              rw [sub_smul, sub_eq_zero]; exact hab
            change (a - b) • N.mkQ ⟨v₀, hv₀_mem⟩ = 0 at hdiff
            rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hdiff
            have hsmul_M : (a - b) • v₀ ∈ M := hdiff
            by_contra hne
            have hne' : a - b ≠ 0 := sub_ne_zero.mpr hne
            have hv₀_in : v₀ ∈ M := by
              have h := M.smul_mem (a - b)⁻¹ hsmul_M
              rwa [inv_smul_smul₀ hne'] at h
            exact hv₀_not_M hv₀_in,
           by
            intro q
            obtain ⟨⟨v, hv⟩, rfl⟩ := Submodule.Quotient.mk_surjective N q
            have hv_div0 : (0 : WithTop ℤ) ≤ ord P₀ (v * v₀⁻¹) := by
              rw [(hDed.2.1 P₀ hP₀).2.1, hOrdInv P₀ hP₀ v₀ hv₀_ne, hv₀_Z]
              have hvP₀ := hv P₀ hP₀ hCP₀
              rw [hD_at, hCoeNeg] at hvP₀
              have hge := add_le_add hvP₀ (le_rfl : ((-(-D P₀ - 1) : ℤ) : WithTop ℤ) ≤ _)
              refine le_trans ?_ hge
              rw [← WithTop.coe_add, ← WithTop.coe_zero, WithTop.coe_le_coe]
              omega
            obtain ⟨c, hc⟩ := (hDed.2.1 P₀ hP₀).2.2.2.2.2 (v * v₀⁻¹) hv_div0
            have hdiff_M : v - c • v₀ ∈ M := by
              intro P hP hC
              by_cases hEq : P = P₀
              · subst hEq
                have hmul : (v * v₀⁻¹ - algebraMap Ω F c) * v₀ = v - c • v₀ := by
                  rw [sub_mul, inv_mul_cancel_right₀ hv₀_ne, Algebra.smul_def]
                rw [← hmul, (hDed.2.1 P hP).2.1, hv₀_ord]
                have hge := add_le_add hc (le_rfl : ((-D P - 1 : ℤ) : WithTop ℤ) ≤ _)
                refine le_trans ?_ hge
                rw [hCoeNeg, ← WithTop.coe_one, ← WithTop.coe_add, WithTop.coe_le_coe]
                omega
              · rw [← hD_off P hEq]
                exact (M'.sub_mem hv (M'.smul_mem c hv₀_mem)) P hP hC
            refine ⟨c, ?_⟩
            change c • N.mkQ ⟨v₀, hv₀_mem⟩ = Submodule.Quotient.mk ⟨v, hv⟩
            rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.eq]
            change c • v₀ - v ∈ M
            have hneg := M.neg_mem hdiff_M
            rwa [neg_sub] at hneg⟩
      exact ⟨Module.Finite.equiv e_quot, by rw [← e_quot.finrank_eq, Module.finrank_self Ω]⟩

  have hStepEuler : ∀ (D D' : X → ℤ) (P₀ : X),
      {P : X | D P ≠ 0}.Finite → IsPlace P₀ →
      (∀ P : X, P ≠ P₀ → D' P = D P) → D' P₀ = D P₀ + 1 →
      let H1 := fun Δ => ↥(E₀_inf_c Δ) ⧸ Submodule.comap (E₀_inf_c Δ).subtype (E₀_c Δ ⊔ E_inf_c Δ)
      ((FiniteDimensional Ω ↥(L_c D) ∧ FiniteDimensional Ω (H1 D)) ↔
        (FiniteDimensional Ω ↥(L_c D') ∧ FiniteDimensional Ω (H1 D'))) ∧
      (FiniteDimensional Ω ↥(L_c D) → FiniteDimensional Ω (H1 D) →
        (Module.finrank Ω ↥(L_c D') : ℤ) - (Module.finrank Ω (H1 D') : ℤ) =
          (Module.finrank Ω ↥(L_c D) : ℤ) - (Module.finrank Ω (H1 D) : ℤ) + 1) := by
    intro D D' P₀ hD_fin hP₀ hD_off hD_at H1
    have hLeD : ∀ P : X, (-(D' P) : WithTop ℤ) ≤ (-(D P) : WithTop ℤ) := by
      intro P
      by_cases hEq : P = P₀
      · subst hEq
        rw [hD_at, hCoeNeg, hCoeNeg, WithTop.coe_le_coe]
        omega
      · rw [hD_off P hEq]
    have hSub0 : E₀_c D ≤ E₀_c D' := fun v hv P hP hC => le_trans (hLeD P) (hv P hP hC)
    have hSubInf : E_inf_c D ≤ E_inf_c D' := fun v hv P hP hC => le_trans (hLeD P) (hv P hP hC)
    have hSub0Inf : E₀_inf_c D ≤ E₀_inf_c D' := fun v hv P hP hC => le_trans (hLeD P) (hv P hP hC)

    have hTriple :
        FiniteDimensional Ω (↥(E₀_c D') ⧸ Submodule.comap (E₀_c D').subtype (E₀_c D)) ∧
        FiniteDimensional Ω (↥(E_inf_c D') ⧸ Submodule.comap (E_inf_c D').subtype (E_inf_c D)) ∧
        FiniteDimensional Ω (↥(E₀_inf_c D') ⧸ Submodule.comap (E₀_inf_c D').subtype (E₀_inf_c D)) ∧
        (Module.finrank Ω (↥(E₀_c D') ⧸ Submodule.comap (E₀_c D').subtype (E₀_c D)) : ℤ) +
          (Module.finrank Ω (↥(E_inf_c D') ⧸ Submodule.comap (E_inf_c D').subtype (E_inf_c D)) : ℤ) -
          (Module.finrank Ω (↥(E₀_inf_c D') ⧸ Submodule.comap (E₀_inf_c D').subtype (E₀_inf_c D)) : ℤ) = 1 := by
      let m₀ : ℤ := ordZ P₀ hP₀ x_sep hx_ne
      have hm₀_ord : ord P₀ x_sep = (m₀ : WithTop ℤ) := hOrdZ P₀ hP₀ x_sep hx_ne
      have hMemD' : ∀ (Cond : X → Prop) (v : F),
          ord P₀ v = ((-D P₀ - 1 : ℤ) : WithTop ℤ) →
          (∀ Q : X, IsPlace Q → Cond Q → Q ≠ P₀ → (-(D Q) : WithTop ℤ) ≤ ord Q v) →
          v ∈ mkSub Cond D' := by
        intro Cond v hvP₀ hvOff Q hQ hC
        by_cases hEq : Q = P₀
        · subst hEq
          rw [hvP₀, hD_at, hCoeNeg, WithTop.coe_le_coe]
          omega
        · rw [hD_off Q hEq]; exact hvOff Q hQ hC hEq
      rcases lt_trichotomy m₀ 0 with hm_neg | hm_zero | hm_pos
      · 
        have hNot0 : ¬ ((0 : WithTop ℤ) ≤ ord P₀ x_sep) := by
          rw [hm₀_ord, ← WithTop.coe_zero, WithTop.coe_le_coe]; omega
        have hLe0 : ord P₀ x_sep ≤ (0 : WithTop ℤ) := by
          rw [hm₀_ord, ← WithTop.coe_zero, WithTop.coe_le_coe]; omega
        have hNe0 : ¬ (ord P₀ x_sep = (0 : WithTop ℤ)) := by
          rw [hm₀_ord, ← WithTop.coe_zero, WithTop.coe_inj]; omega
        obtain ⟨hFD0, hR0⟩ :=
          (hLocalQuot (fun P => (0 : WithTop ℤ) ≤ ord P x_sep) D D' P₀ hP₀ hD_off hD_at).1 hNot0
        obtain ⟨hFD0inf, hR0inf⟩ :=
          (hLocalQuot (fun P => ord P x_sep = (0 : WithTop ℤ)) D D' P₀ hP₀ hD_off hD_at).1 hNe0
        obtain ⟨v_y, hv_y_P₀, hv_y_off⟩ :=
          hChartWitness x_sep⁻¹ hChartInf D P₀ hD_fin hP₀ ((hOrdY_iff P₀ hP₀).mpr hLe0)
        have hv_y_in : v_y ∈ E_inf_c D' :=
          hMemD' (fun P => ord P x_sep ≤ (0 : WithTop ℤ)) v_y hv_y_P₀
            fun Q hQ hC hne => hv_y_off Q hQ ((hOrdY_iff Q hQ).mpr hC) hne
        obtain ⟨hFDinf, hRinf⟩ :=
          (hLocalQuot (fun P => ord P x_sep ≤ (0 : WithTop ℤ)) D D' P₀ hP₀ hD_off hD_at).2
            hLe0 ⟨v_y, hv_y_in, hv_y_P₀⟩
        exact ⟨hFD0, hFDinf, hFD0inf, by rw [hR0, hRinf, hR0inf]; omega⟩
      · 
        have hEq0 : ord P₀ x_sep = (0 : WithTop ℤ) := by rw [hm₀_ord, hm_zero, WithTop.coe_zero]
        have hGe0 : (0 : WithTop ℤ) ≤ ord P₀ x_sep := le_of_eq hEq0.symm
        have hLe0 : ord P₀ x_sep ≤ (0 : WithTop ℤ) := le_of_eq hEq0
        obtain ⟨v_x, hv_x_P₀, hv_x_off⟩ := hChartWitness x_sep hChart0 D P₀ hD_fin hP₀ hGe0
        obtain ⟨v_y, hv_y_P₀, hv_y_off⟩ :=
          hChartWitness x_sep⁻¹ hChartInf D P₀ hD_fin hP₀ ((hOrdY_iff P₀ hP₀).mpr hLe0)
        have hv_x_in0 : v_x ∈ E₀_c D' :=
          hMemD' (fun P => (0 : WithTop ℤ) ≤ ord P x_sep) v_x hv_x_P₀ hv_x_off
        have hv_x_in0inf : v_x ∈ E₀_inf_c D' :=
          hMemD' (fun P => ord P x_sep = (0 : WithTop ℤ)) v_x hv_x_P₀
            fun Q hQ hC hne => hv_x_off Q hQ (le_of_eq hC.symm) hne
        have hv_y_in : v_y ∈ E_inf_c D' :=
          hMemD' (fun P => ord P x_sep ≤ (0 : WithTop ℤ)) v_y hv_y_P₀
            fun Q hQ hC hne => hv_y_off Q hQ ((hOrdY_iff Q hQ).mpr hC) hne
        obtain ⟨hFD0, hR0⟩ :=
          (hLocalQuot (fun P => (0 : WithTop ℤ) ≤ ord P x_sep) D D' P₀ hP₀ hD_off hD_at).2
            hGe0 ⟨v_x, hv_x_in0, hv_x_P₀⟩
        obtain ⟨hFDinf, hRinf⟩ :=
          (hLocalQuot (fun P => ord P x_sep ≤ (0 : WithTop ℤ)) D D' P₀ hP₀ hD_off hD_at).2
            hLe0 ⟨v_y, hv_y_in, hv_y_P₀⟩
        obtain ⟨hFD0inf, hR0inf⟩ :=
          (hLocalQuot (fun P => ord P x_sep = (0 : WithTop ℤ)) D D' P₀ hP₀ hD_off hD_at).2
            hEq0 ⟨v_x, hv_x_in0inf, hv_x_P₀⟩
        exact ⟨hFD0, hFDinf, hFD0inf, by rw [hR0, hRinf, hR0inf]; omega⟩
      · 
        have hGe0 : (0 : WithTop ℤ) ≤ ord P₀ x_sep := by
          rw [hm₀_ord, ← WithTop.coe_zero, WithTop.coe_le_coe]; omega
        have hNotLe0 : ¬ (ord P₀ x_sep ≤ (0 : WithTop ℤ)) := by
          rw [hm₀_ord, ← WithTop.coe_zero, WithTop.coe_le_coe]; omega
        have hNe0 : ¬ (ord P₀ x_sep = (0 : WithTop ℤ)) := by
          rw [hm₀_ord, ← WithTop.coe_zero, WithTop.coe_inj]; omega
        obtain ⟨v_x, hv_x_P₀, hv_x_off⟩ := hChartWitness x_sep hChart0 D P₀ hD_fin hP₀ hGe0
        have hv_x_in0 : v_x ∈ E₀_c D' :=
          hMemD' (fun P => (0 : WithTop ℤ) ≤ ord P x_sep) v_x hv_x_P₀ hv_x_off
        obtain ⟨hFD0, hR0⟩ :=
          (hLocalQuot (fun P => (0 : WithTop ℤ) ≤ ord P x_sep) D D' P₀ hP₀ hD_off hD_at).2
            hGe0 ⟨v_x, hv_x_in0, hv_x_P₀⟩
        obtain ⟨hFDinf, hRinf⟩ :=
          (hLocalQuot (fun P => ord P x_sep ≤ (0 : WithTop ℤ)) D D' P₀ hP₀ hD_off hD_at).1 hNotLe0
        obtain ⟨hFD0inf, hR0inf⟩ :=
          (hLocalQuot (fun P => ord P x_sep = (0 : WithTop ℤ)) D D' P₀ hP₀ hD_off hD_at).1 hNe0
        exact ⟨hFD0, hFDinf, hFD0inf, by rw [hR0, hRinf, hR0inf]; omega⟩

    obtain ⟨hFD_Q0, hFD_Qinf, hFD_Q0inf, hRankSum⟩ := hTriple

    let φ : (F × F) →ₗ[Ω] F := LinearMap.fst Ω F F - LinearMap.snd Ω F F
    let A_sub : (X → ℤ) → Submodule Ω (F × F) := fun Δ => (E₀_c Δ).prod (E_inf_c Δ)
    have hAA' : A_sub D ≤ A_sub D' := Submodule.prod_mono hSub0 hSubInf
    have hMapEq : ∀ Δ : X → ℤ, Submodule.map φ (A_sub Δ) = E₀_c Δ ⊔ E_inf_c Δ := by
      intro Δ
      apply le_antisymm
      · rintro _ ⟨⟨u₀, u_inf⟩, ⟨hu₀, hu_inf⟩, rfl⟩
        change u₀ - u_inf ∈ E₀_c Δ ⊔ E_inf_c Δ
        rw [sub_eq_add_neg]
        exact Submodule.add_mem_sup hu₀ ((E_inf_c Δ).neg_mem hu_inf)
      · refine sup_le ?_ ?_
        · intro u₀ hu₀
          exact ⟨(u₀, 0), ⟨hu₀, (E_inf_c Δ).zero_mem⟩, sub_zero u₀⟩
        · intro u_inf hu_inf
          exact ⟨(0, -u_inf), ⟨(E₀_c Δ).zero_mem, (E_inf_c Δ).neg_mem hu_inf⟩, by simp [φ]⟩
    have hMapLeB : ∀ Δ : X → ℤ, Submodule.map φ (A_sub Δ) ≤ E₀_inf_c Δ := by
      intro Δ
      rw [hMapEq Δ]
      refine sup_le ?_ ?_
      · exact fun v hv P hP hEq0 => hv P hP (le_of_eq hEq0.symm)
      · exact fun v hv P hP hEq0 => hv P hP (le_of_eq hEq0)

    let Q0 := ↥(E₀_c D') ⧸ Submodule.comap (E₀_c D').subtype (E₀_c D)
    let Qinf := ↥(E_inf_c D') ⧸ Submodule.comap (E_inf_c D').subtype (E_inf_c D)
    let f_prod : ↥(A_sub D') →ₗ[Ω] Q0 × Qinf :=
      { toFun := fun p =>
          ((Submodule.comap (E₀_c D').subtype (E₀_c D)).mkQ ⟨p.1.1, p.2.1⟩,
           (Submodule.comap (E_inf_c D').subtype (E_inf_c D)).mkQ ⟨p.1.2, p.2.2⟩)
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    have hf_prod_surj : Function.Surjective f_prod := by
      rintro ⟨q₁, q₂⟩
      obtain ⟨⟨u₁, hu₁⟩, rfl⟩ := Submodule.Quotient.mk_surjective _ q₁
      obtain ⟨⟨u₂, hu₂⟩, rfl⟩ := Submodule.Quotient.mk_surjective _ q₂
      exact ⟨⟨(u₁, u₂), ⟨hu₁, hu₂⟩⟩, rfl⟩
    have hf_prod_ker : LinearMap.ker f_prod = Submodule.comap (A_sub D').subtype (A_sub D) := by
      ext p
      rw [LinearMap.mem_ker, Prod.ext_iff]
      change (Submodule.comap (E₀_c D').subtype (E₀_c D)).mkQ ⟨p.1.1, p.2.1⟩ = 0 ∧
          (Submodule.comap (E_inf_c D').subtype (E_inf_c D)).mkQ ⟨p.1.2, p.2.2⟩ = 0 ↔
        p.1.1 ∈ E₀_c D ∧ p.1.2 ∈ E_inf_c D
      rw [Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
        Submodule.Quotient.mk_eq_zero]
      rfl
    let e_QA : (↥(A_sub D') ⧸ Submodule.comap (A_sub D').subtype (A_sub D)) ≃ₗ[Ω] Q0 × Qinf :=
      (Submodule.quotEquivOfEq _ _ hf_prod_ker.symm).trans
        (LinearMap.quotKerEquivOfSurjective f_prod hf_prod_surj)
    have hFD_QA : FiniteDimensional Ω (↥(A_sub D') ⧸ Submodule.comap (A_sub D').subtype (A_sub D)) := by
      have _ : Module.Finite Ω Q0 := hFD_Q0
      have _ : Module.Finite Ω Qinf := hFD_Qinf
      exact Module.Finite.equiv e_QA.symm
    have hRank_QA : Module.finrank Ω
        (↥(A_sub D') ⧸ Submodule.comap (A_sub D').subtype (A_sub D)) =
        Module.finrank Ω Q0 + Module.finrank Ω Qinf := by
      have _ : Module.Finite Ω Q0 := hFD_Q0
      have _ : Module.Finite Ω Qinf := hFD_Qinf
      rw [e_QA.finrank_eq, Module.finrank_prod]

    let e_ker : ∀ Δ : X → ℤ, ↥(L_c Δ) ≃ₗ[Ω] ↥(A_sub Δ ⊓ LinearMap.ker φ) := fun Δ =>
      { toFun := fun v =>
          ⟨(v.1, v.1), ⟨⟨fun P hP _ => v.2 P hP trivial, fun P hP _ => v.2 P hP trivial⟩,
            sub_self v.1⟩⟩
        invFun := fun p =>
          ⟨p.1.1, fun P hP _ => by
            rcases le_total (0 : WithTop ℤ) (ord P x_sep) with hge | hle
            · exact p.2.1.1 P hP hge
            · have hp_sub : p.1.1 - p.1.2 = 0 := p.2.2
              rw [sub_eq_zero.mp hp_sub]
              exact p.2.1.2 P hP hle⟩
        left_inv := fun _ => rfl
        right_inv := fun p => by
          have hp_sub : p.1.1 - p.1.2 = 0 := p.2.2
          ext
          · rfl
          · exact sub_eq_zero.mp hp_sub
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }

    have hDia := hDiamond (A_sub D) (A_sub D') (E₀_inf_c D) (E₀_inf_c D') φ
      hAA' hSub0Inf (hMapLeB D) (hMapLeB D') hFD_QA hFD_Q0inf
    dsimp only at hDia
    rw [hMapEq D, hMapEq D'] at hDia
    obtain ⟨hFD_K_iff, hFD_C_iff, hIdxEq⟩ := hDia
    have hFD_L_iff : FiniteDimensional Ω ↥(L_c D) ↔ FiniteDimensional Ω ↥(L_c D') := by
      constructor
      · intro h
        have _ : Module.Finite Ω ↥(L_c D) := h
        have _ : Module.Finite Ω ↥(A_sub D ⊓ LinearMap.ker φ) := Module.Finite.equiv (e_ker D)
        have _ : Module.Finite Ω ↥(A_sub D' ⊓ LinearMap.ker φ) := hFD_K_iff.mp ‹_›
        exact Module.Finite.equiv (e_ker D').symm
      · intro h
        have _ : Module.Finite Ω ↥(L_c D') := h
        have _ : Module.Finite Ω ↥(A_sub D' ⊓ LinearMap.ker φ) := Module.Finite.equiv (e_ker D')
        have _ : Module.Finite Ω ↥(A_sub D ⊓ LinearMap.ker φ) := hFD_K_iff.mpr ‹_›
        exact Module.Finite.equiv (e_ker D).symm
    refine ⟨and_congr hFD_L_iff hFD_C_iff, ?_⟩
    intro hFD_LD hFD_H1D
    have hFD_KD : FiniteDimensional Ω ↥(A_sub D ⊓ LinearMap.ker φ) :=
      Module.Finite.equiv (e_ker D)
    have hEq := hIdxEq hFD_KD hFD_H1D
    rw [← (e_ker D).finrank_eq, ← (e_ker D').finrank_eq, hRank_QA] at hEq
    dsimp only [Q0, Qinf] at hEq
    dsimp only [H1]
    omega

  
  
  
  have hFinsumStep : ∀ (D D' : X → ℤ) (P₀ : X),
      {P : X | D P ≠ 0}.Finite → (∀ P : X, P ≠ P₀ → D' P = D P) → D' P₀ = D P₀ + 1 →
      (∑ᶠ P : X, D' P) = (∑ᶠ P : X, D P) + 1 := by
    intro D D' P₀ hD_fin hD_off hD_at
    let S : Finset X := insert P₀ hD_fin.toFinset
    have hP₀_in : P₀ ∈ S := Finset.mem_insert_self P₀ _
    have hSuppD : Function.support D ⊆ (S : Set X) := fun P hP =>
      Finset.mem_coe.mpr (Finset.mem_insert_of_mem (hD_fin.mem_toFinset.mpr hP))
    have hSuppD' : Function.support D' ⊆ (S : Set X) := by
      intro P hP
      rw [Finset.mem_coe]
      by_cases hEq : P = P₀
      · subst hEq; exact hP₀_in
      · rw [Function.mem_support, hD_off P hEq] at hP
        exact Finset.mem_insert_of_mem (hD_fin.mem_toFinset.mpr hP)
    have hD'_eq : D' = Function.update D P₀ (D P₀ + 1) := by
      ext P
      by_cases hEq : P = P₀
      · subst hEq; simp [hD_at]
      · simp [Function.update, hEq, hD_off P hEq]
    rw [finsum_eq_sum_of_support_subset D hSuppD, finsum_eq_sum_of_support_subset D' hSuppD',
      hD'_eq, Finset.sum_update_of_mem hP₀_in, Finset.sdiff_singleton_eq_erase]
    have hErase := Finset.add_sum_erase S D hP₀_in
    omega

  have hClaim1_ind : ∀ (n : ℕ) (D : X → ℤ),
      (∀ P : X, ¬IsPlace P → D P = 0) →
      ∀ (hFin : {P : X | D P ≠ 0}.Finite),
        (∑ P ∈ hFin.toFinset, (D P).natAbs) = n →
        FiniteDimensional Ω ↥(L_c D) ∧
        FiniteDimensional Ω
          (↥(E₀_inf_c D) ⧸ Submodule.comap (E₀_inf_c D).subtype (E₀_c D ⊔ E_inf_c D)) ∧
        (Module.finrank Ω ↥(L_c D) : ℤ) -
          (Module.finrank Ω
            (↥(E₀_inf_c D) ⧸ Submodule.comap (E₀_inf_c D).subtype (E₀_c D ⊔ E_inf_c D)) : ℤ) =
          (∑ᶠ P : X, D P) + 1 - (g_E : ℤ) := by
    intro n
    induction n with
    | zero =>
      intro D _ hFin hSum0
      have hD_eq0 : D = D_zero := by
        ext P
        change D P = 0
        by_contra hne
        have h_in : P ∈ hFin.toFinset := hFin.mem_toFinset.mpr hne
        have hle := Finset.single_le_sum (f := fun Q => (D Q).natAbs)
          (fun _ _ => Nat.zero_le _) h_in
        rw [hSum0] at hle
        exact hne (Int.natAbs_eq_zero.mp (Nat.eq_zero_of_le_zero hle))
      subst hD_eq0
      refine ⟨hZeroBase.1, hZeroBase.2.2, ?_⟩
      have hSumZero : (∑ᶠ P : X, D_zero P) = 0 := finsum_zero
      rw [hZeroBase.2.1, hSumZero]
      change (1 : ℤ) - (g_E : ℤ) = 0 + 1 - (g_E : ℤ)
      omega
    | succ n ih =>
      intro D hD_nc hFin hSumSucc
      have hNonempty : hFin.toFinset.Nonempty := by
        by_contra hemp
        rw [Finset.not_nonempty_iff_eq_empty.mp hemp, Finset.sum_empty] at hSumSucc
        omega
      obtain ⟨P₀, hP₀_mem⟩ := hNonempty
      have hDP₀_ne : D P₀ ≠ 0 := hFin.mem_toFinset.mp hP₀_mem
      have hP₀ : IsPlace P₀ := by
        by_contra hnot
        exact hDP₀_ne (hD_nc P₀ hnot)
      by_cases hPos : 0 < D P₀
      · let D_prev : X → ℤ := Function.update D P₀ (D P₀ - 1)
        have hPrev_nc : ∀ P : X, ¬IsPlace P → D_prev P = 0 := by
          intro P hnot
          by_cases hEq : P = P₀
          · exact absurd (hEq ▸ hP₀) hnot
          · simp [D_prev, hEq, hD_nc P hnot]
        have hPrev_fin : {P : X | D_prev P ≠ 0}.Finite := by
          refine hFin.subset fun P hP => ?_
          by_cases hEq : P = P₀
          · subst hEq; exact hDP₀_ne
          · simpa [D_prev, hEq] using hP
        have hPrev_sum : (∑ P ∈ hPrev_fin.toFinset, (D_prev P).natAbs) = n := by
          have hSub : hPrev_fin.toFinset ⊆ hFin.toFinset := by
            intro P hP
            rw [Set.Finite.mem_toFinset] at hP ⊢
            by_cases hEq : P = P₀
            · subst hEq; exact hDP₀_ne
            · simpa [D_prev, hEq] using hP
          have hSumEq : ∑ P ∈ hPrev_fin.toFinset, (D_prev P).natAbs =
              ∑ P ∈ hFin.toFinset, (D_prev P).natAbs :=
            Finset.sum_subset hSub fun P _ hnot =>
              Int.natAbs_eq_zero.mpr (not_not.mp fun hne => hnot (hPrev_fin.mem_toFinset.mpr hne))
          rw [hSumEq]
          have hUpd := Finset.sum_update_of_mem (s := hFin.toFinset)
            (f := fun P => (D P).natAbs) hP₀_mem ((D P₀ - 1).natAbs)
          rw [Finset.sdiff_singleton_eq_erase] at hUpd
          have hCongr : ∑ P ∈ hFin.toFinset, (D_prev P).natAbs =
              ∑ P ∈ hFin.toFinset, Function.update (fun Q => (D Q).natAbs) P₀
                ((D P₀ - 1).natAbs) P := by
            refine Finset.sum_congr rfl fun P _ => ?_
            by_cases hEq : P = P₀ <;> simp [D_prev, Function.update, hEq]
          have hErase := Finset.add_sum_erase hFin.toFinset (fun Q => (D Q).natAbs) hP₀_mem
          rw [hCongr, hUpd]
          omega
        obtain ⟨hFD_Lprev, hFD_H1prev, hEuler_prev⟩ := ih D_prev hPrev_nc hPrev_fin hPrev_sum
        have hOff : ∀ P : X, P ≠ P₀ → D P = D_prev P := fun P hne => by simp [D_prev, hne]
        have hAt : D P₀ = D_prev P₀ + 1 := by simp [D_prev]
        have hStep := hStepEuler D_prev D P₀ hPrev_fin hP₀ hOff hAt
        obtain ⟨hFD_LD, hFD_H1D⟩ := hStep.1.mp ⟨hFD_Lprev, hFD_H1prev⟩
        have hEulerStep := hStep.2 hFD_Lprev hFD_H1prev
        dsimp only at hEulerStep
        have hFsum := hFinsumStep D_prev D P₀ hPrev_fin hOff hAt
        exact ⟨hFD_LD, hFD_H1D, by omega⟩
      · have hNeg : D P₀ < 0 := lt_of_le_of_ne (le_of_not_gt hPos) hDP₀_ne
        let D_next : X → ℤ := Function.update D P₀ (D P₀ + 1)
        have hNext_nc : ∀ P : X, ¬IsPlace P → D_next P = 0 := by
          intro P hnot
          by_cases hEq : P = P₀
          · exact absurd (hEq ▸ hP₀) hnot
          · simp [D_next, hEq, hD_nc P hnot]
        have hNext_fin : {P : X | D_next P ≠ 0}.Finite := by
          refine hFin.subset fun P hP => ?_
          by_cases hEq : P = P₀
          · subst hEq; exact hDP₀_ne
          · simpa [D_next, hEq] using hP
        have hNext_sum : (∑ P ∈ hNext_fin.toFinset, (D_next P).natAbs) = n := by
          have hSub : hNext_fin.toFinset ⊆ hFin.toFinset := by
            intro P hP
            rw [Set.Finite.mem_toFinset] at hP ⊢
            by_cases hEq : P = P₀
            · subst hEq; exact hDP₀_ne
            · simpa [D_next, hEq] using hP
          have hSumEq : ∑ P ∈ hNext_fin.toFinset, (D_next P).natAbs =
              ∑ P ∈ hFin.toFinset, (D_next P).natAbs :=
            Finset.sum_subset hSub fun P _ hnot =>
              Int.natAbs_eq_zero.mpr (not_not.mp fun hne => hnot (hNext_fin.mem_toFinset.mpr hne))
          rw [hSumEq]
          have hUpd := Finset.sum_update_of_mem (s := hFin.toFinset)
            (f := fun P => (D P).natAbs) hP₀_mem ((D P₀ + 1).natAbs)
          rw [Finset.sdiff_singleton_eq_erase] at hUpd
          have hCongr : ∑ P ∈ hFin.toFinset, (D_next P).natAbs =
              ∑ P ∈ hFin.toFinset, Function.update (fun Q => (D Q).natAbs) P₀
                ((D P₀ + 1).natAbs) P := by
            refine Finset.sum_congr rfl fun P _ => ?_
            by_cases hEq : P = P₀ <;> simp [D_next, Function.update, hEq]
          have hErase := Finset.add_sum_erase hFin.toFinset (fun Q => (D Q).natAbs) hP₀_mem
          rw [hCongr, hUpd]
          omega
        obtain ⟨hFD_Lnext, hFD_H1next, hEuler_next⟩ := ih D_next hNext_nc hNext_fin hNext_sum
        have hOff : ∀ P : X, P ≠ P₀ → D_next P = D P := fun P hne => by simp [D_next, hne]
        have hAt : D_next P₀ = D P₀ + 1 := by simp [D_next]
        have hStep := hStepEuler D D_next P₀ hFin hP₀ hOff hAt
        obtain ⟨hFD_LD, hFD_H1D⟩ := hStep.1.mpr ⟨hFD_Lnext, hFD_H1next⟩
        have hEulerStep := hStep.2 hFD_LD hFD_H1D
        dsimp only at hEulerStep
        have hFsum := hFinsumStep D D_next P₀ hFin hOff hAt
        exact ⟨hFD_LD, hFD_H1D, by omega⟩

  have hClaim1 : ∀ (D : X → ℤ),
      (∀ P : X, ¬IsPlace P → D P = 0) →
      {P : X | D P ≠ 0}.Finite →
      ∀ (E₀ E_inf E₀_inf L_D : Submodule Ω F),
        IsTwoChartDivisorSpaces Ω X F IsPlace ord x_sep D E₀ E_inf E₀_inf L_D →
        FiniteDimensional Ω ↥L_D ∧
        FiniteDimensional Ω (↥E₀_inf ⧸ Submodule.comap E₀_inf.subtype (E₀ ⊔ E_inf)) ∧
        (Module.finrank Ω ↥L_D : ℤ) -
          (Module.finrank Ω (↥E₀_inf ⧸ Submodule.comap E₀_inf.subtype (E₀ ⊔ E_inf)) : ℤ) =
          (∑ᶠ P : X, D P) + 1 - (g_E : ℤ) ∧
        ((∀ P : X, D P = 0) →
          Module.finrank Ω ↥L_D = 1 ∧
          Module.finrank Ω (↥E₀_inf ⧸ Submodule.comap E₀_inf.subtype (E₀ ⊔ E_inf)) = g_E) := by
    intro D hD_nc hD_fin E₀ E_inf E₀_inf L_D hSp
    have hEq0 : E₀ = E₀_c D := Submodule.ext fun v => hSp.1 v
    have hEqInf : E_inf = E_inf_c D := Submodule.ext fun v => hSp.2.1 v
    have hEq0Inf : E₀_inf = E₀_inf_c D := Submodule.ext fun v => hSp.2.2.1 v
    have hEqL : L_D = L_c D := Submodule.ext fun v =>
      (hSp.2.2.2 v).trans ⟨fun h P hP _ => h P hP, fun h P hP => h P hP trivial⟩
    subst hEq0; subst hEqInf; subst hEq0Inf; subst hEqL
    obtain ⟨hFD_L, hFD_H1, hEuler⟩ :=
      hClaim1_ind (∑ P ∈ hD_fin.toFinset, (D P).natAbs) D hD_nc hD_fin rfl
    refine ⟨hFD_L, hFD_H1, hEuler, ?_⟩
    intro hD0
    have hDeq : D = D_zero := funext hD0
    subst hDeq
    exact ⟨hZeroBase.2.1, rfl⟩

  
  have hClaim2 : ∀ f : F, f ≠ 0 →
      {P : X | IsPlace P ∧ ord P f ≠ 0}.Finite ∧
      ∃ d_f : X → ℤ,
        (∀ P : X, ¬IsPlace P → d_f P = 0) ∧
        (∀ P : X, IsPlace P → ord P f = (d_f P : WithTop ℤ)) ∧
        (∑ᶠ P : X, d_f P) = 0 := by
    intro f hf
    have hFinOrd := hDed.2.2.1 f hf
    let d_f : X → ℤ := fun P => if hP : IsPlace P then ordZ P hP f hf else 0
    have hdf_nc : ∀ P : X, ¬IsPlace P → d_f P = 0 := by
      intro P hnot; simp [d_f, hnot]
    have hdf_ord : ∀ P : X, IsPlace P → ord P f = (d_f P : WithTop ℤ) := by
      intro P hP
      simp only [d_f, hP, ↓reduceDIte]
      exact hOrdZ P hP f hf
    have hdf_fin : {P : X | d_f P ≠ 0}.Finite := by
      refine hFinOrd.subset fun P hne => ?_
      have hP : IsPlace P := by
        by_contra hnot; exact hne (hdf_nc P hnot)
      refine ⟨hP, ?_⟩
      rw [hdf_ord P hP]
      exact WithTop.coe_ne_zero.mpr hne
    refine ⟨hFinOrd, d_f, hdf_nc, hdf_ord, ?_⟩
    let μ : F ≃ₗ[Ω] F :=
      { toFun := fun v => f⁻¹ * v
        invFun := fun u => f * u
        left_inv := fun v => mul_inv_cancel_left₀ hf v
        right_inv := fun u => inv_mul_cancel_left₀ hf u
        map_add' := fun a b => mul_add f⁻¹ a b
        map_smul' := fun c v => by
          simp only [RingHom.id_apply, Algebra.smul_def]
          ring }
    have hMapSub : ∀ Cond : X → Prop,
        Submodule.map μ.toLinearMap (mkSub Cond D_zero) = mkSub Cond d_f := by
      intro Cond
      ext u
      simp only [Submodule.mem_map]
      constructor
      · rintro ⟨v, hv, rfl⟩ P hP hC
        change (-(d_f P) : WithTop ℤ) ≤ ord P (f⁻¹ * v)
        rw [(hDed.2.1 P hP).2.1, hOrdInv P hP f hf]
        have hdf_eq : d_f P = ordZ P hP f hf := by simp [d_f, hP]
        have hvP : (0 : WithTop ℤ) ≤ ord P v := by simpa [D_zero] using hv P hP hC
        rw [hdf_eq, hCoeNeg]
        simpa using add_le_add (le_rfl : ((-(ordZ P hP f hf) : ℤ) : WithTop ℤ) ≤ _) hvP
      · intro hu
        refine ⟨f * u, ?_, inv_mul_cancel_left₀ hf u⟩
        intro P hP hC
        simp only [D_zero, WithTop.coe_zero, neg_zero]
        rw [(hDed.2.1 P hP).2.1, hdf_ord P hP]
        have huP := hu P hP hC
        rw [hCoeNeg] at huP
        have hge := add_le_add (le_rfl : (d_f P : WithTop ℤ) ≤ _) huP
        simpa [← WithTop.coe_add] using hge
    let e_Ldf : ↥(L_c D_zero) ≃ₗ[Ω] ↥(L_c d_f) := μ.ofSubmodules _ _ (hMapSub _)
    let e_0inf_df : ↥(E₀_inf_c D_zero) ≃ₗ[Ω] ↥(E₀_inf_c d_f) := μ.ofSubmodules _ _ (hMapSub _)
    have hMapSup : Submodule.map e_0inf_df.toLinearMap
        (Submodule.comap (E₀_inf_c D_zero).subtype (E₀_c D_zero ⊔ E_inf_c D_zero)) =
        Submodule.comap (E₀_inf_c d_f).subtype (E₀_c d_f ⊔ E_inf_c d_f) := by
      have hSupEq : Submodule.map μ.toLinearMap (E₀_c D_zero ⊔ E_inf_c D_zero) =
          E₀_c d_f ⊔ E_inf_c d_f := by
        rw [Submodule.map_sup, hMapSub, hMapSub]
      ext y
      simp only [Submodule.mem_map, Submodule.mem_comap, Submodule.subtype_apply]
      constructor
      · rintro ⟨x, hx, rfl⟩
        rw [← hSupEq]
        exact ⟨x.1, hx, rfl⟩
      · intro hy
        rw [← hSupEq] at hy
        obtain ⟨z, hz, hμz⟩ := hy
        have hz_eq : z = f * y.1 := by
          change f⁻¹ * z = y.1 at hμz
          calc z = f * (f⁻¹ * z) := (mul_inv_cancel_left₀ hf z).symm
            _ = f * y.1 := by rw [hμz]
        refine ⟨e_0inf_df.symm y, ?_, e_0inf_df.apply_symm_apply y⟩
        change f * y.1 ∈ E₀_c D_zero ⊔ E_inf_c D_zero
        rwa [← hz_eq]
    let e_H1_df :
        (↥(E₀_inf_c D_zero) ⧸
          Submodule.comap (E₀_inf_c D_zero).subtype (E₀_c D_zero ⊔ E_inf_c D_zero)) ≃ₗ[Ω]
        (↥(E₀_inf_c d_f) ⧸
          Submodule.comap (E₀_inf_c d_f).subtype (E₀_c d_f ⊔ E_inf_c d_f)) :=
      Submodule.Quotient.equiv _ _ e_0inf_df hMapSup
    obtain ⟨_, _, hEuler_df⟩ :=
      hClaim1_ind (∑ P ∈ hdf_fin.toFinset, (d_f P).natAbs) d_f hdf_nc hdf_fin rfl
    rw [← e_Ldf.finrank_eq, ← e_H1_df.finrank_eq, hZeroBase.2.1] at hEuler_df
    change (1 : ℤ) - (g_E : ℤ) = (∑ᶠ P : X, d_f P) + 1 - (g_E : ℤ) at hEuler_df
    omega

  
  
  
  have hSupPartition : ∀ {R : Type u} [CommRing R] {α : Type} [DecidableEq α]
      (S : Finset α) (J : α → Ideal R) (z : R),
      z ∈ S.sup J → ∃ r : α → R, (∀ b ∈ S, r b ∈ J b) ∧ (∑ b ∈ S, r b) = z := by
    intro R _ α _ S J
    induction S using Finset.cons_induction with
    | empty =>
      intro z hz
      rw [Finset.sup_empty, Ideal.mem_bot] at hz
      exact ⟨fun _ => 0, fun _ h => by simp at h, by simp [hz]⟩
    | cons a s has ih =>
      intro z hz
      rw [Finset.sup_cons, Submodule.mem_sup] at hz
      obtain ⟨y, hy, w, hw, rfl⟩ := hz
      obtain ⟨r', hr'_mem, hr'_sum⟩ := ih w hw
      refine ⟨Function.update r' a y, ?_, ?_⟩
      · intro b hb
        rcases Finset.mem_cons.mp hb with rfl | hbs
        · simp [hy]
        · have hne : b ≠ a := fun hEq => has (hEq ▸ hbs)
          simp [Function.update, hne, hr'_mem b hbs]
      · rw [Finset.sum_cons, Function.update_self]
        have hSumEq : ∑ b ∈ s, Function.update r' a y b = ∑ b ∈ s, r' b :=
          Finset.sum_congr rfl fun b hbs => by
            have hne : b ≠ a := fun hEq => has (hEq ▸ hbs)
            simp [Function.update, hne]
        rw [hSumEq, hr'_sum]

  have hClaim3 : ∀ (D : X → ℤ),
      (∀ P : X, ¬IsPlace P → D P = 0) →
      {P : X | D P ≠ 0}.Finite →
      ∀ (E₀ E_inf E₀_inf L_D : Submodule Ω F),
        IsTwoChartDivisorSpaces Ω X F IsPlace ord x_sep D E₀ E_inf E₀_inf L_D →
        Module.finrank Ω (↥E₀_inf ⧸ Submodule.comap E₀_inf.subtype (E₀ ⊔ E_inf)) = 0 →
        ∀ (m_cov : ℕ) (IsActive : Fin m_cov → Prop) (W_set : Fin m_cov → Set X),
          (∀ P : X, IsPlace P → ∃ a : Fin m_cov, IsActive a ∧ P ∈ W_set a) →
          (∀ a : Fin m_cov, IsActive a → {P : X | IsPlace P ∧ P ∉ W_set a}.Finite) →
          ∀ (c_F : Fin m_cov → Fin m_cov → F),
            (∀ a : Fin m_cov, IsActive a → c_F a a = 0) →
            (∀ a b : Fin m_cov, IsActive a → IsActive b →
              ∀ P : X, P ∈ W_set a ∩ W_set b → IsPlace P →
                (-(D P) : WithTop ℤ) ≤ ord P (c_F a b)) →
            (∀ a b d : Fin m_cov, IsActive a → IsActive b → IsActive d →
              c_F a b + c_F b d = c_F a d) →
            ∃ f_F : Fin m_cov → F,
              (∀ a : Fin m_cov, IsActive a →
                ∀ P : X, P ∈ W_set a → IsPlace P →
                  (-(D P) : WithTop ℤ) ≤ ord P (f_F a)) ∧
              (∀ a b : Fin m_cov, IsActive a → IsActive b →
                c_F a b = f_F a - f_F b) := by
    intro D hD_nc hD_fin E₀ E_inf E₀_inf L_D hSp hRank0
      m_cov IsActive W_set hCov hFinCompl c_F _hc_diag hc_ov hc_cocycle
    obtain ⟨_, hFD_H1, _, _⟩ := hClaim1 D hD_nc hD_fin E₀ E_inf E₀_inf L_D hSp
    have hSurj : ∀ z : F, z ∈ E₀_inf → z ∈ E₀ ⊔ E_inf := by
      intro z hz
      have hAllZero : ∀ q : ↥E₀_inf ⧸ Submodule.comap E₀_inf.subtype (E₀ ⊔ E_inf), q = 0 :=
        @finrank_zero_iff_forall_zero Ω _ _ _ _ hFD_H1 |>.mp hRank0
      have hq0 := hAllZero (Submodule.Quotient.mk ⟨z, hz⟩)
      exact (Submodule.Quotient.mk_eq_zero
        (Submodule.comap E₀_inf.subtype (E₀ ⊔ E_inf))).mp hq0

    let I_act : Finset (Fin m_cov) := Finset.univ.filter IsActive

    have hSingleChart : ∀ (t : F), IsDedekindChartForCoord Ω X F IsPlace ord t →
        ∃ u_t : Fin m_cov → F,
          (∀ a : Fin m_cov, IsActive a →
            ∀ P : X, P ∈ W_set a → IsPlace P → (0 : WithTop ℤ) ≤ ord P t →
              (-(D P) : WithTop ℤ) ≤ ord P (u_t a)) ∧
          (∀ a a' : Fin m_cov, IsActive a → IsActive a' →
            u_t a - u_t a' = c_F a a') := by
      intro t hCt
      let Bt := integralClosure (↥(Algebra.adjoin Ω ({t} : Set F))) F
      let Z_set : Fin m_cov → Finset X := fun b =>
        if hb : IsActive b then
          (hFinCompl b hb).toFinset.filter (fun Q => (0 : WithTop ℤ) ≤ ord Q t)
        else ∅
      have hZ_mem : ∀ (b : Fin m_cov) (Q : X),
          Q ∈ Z_set b ↔ IsActive b ∧ IsPlace Q ∧ Q ∉ W_set b ∧ (0 : WithTop ℤ) ≤ ord Q t := by
        intro b Q
        by_cases hb : IsActive b
        · simp [Z_set, hb, and_assoc]
        · simp [Z_set, hb]
      let δ_t : Fin m_cov → Fin m_cov → X → ℕ := fun a b Q =>
        if hQ : IsPlace Q then
          if hc : c_F a b = 0 then 0 else (-D Q - ordZ Q hQ (c_F a b) hc).toNat
        else 0
      let M_t : ℕ :=
        1 + (I_act ×ˢ I_act).sup (fun p => (Z_set p.2).sup (fun Q => δ_t p.1 p.2 Q))
      let J_id : Fin m_cov → Ideal ↥Bt := fun b =>
        { carrier := {h : ↥Bt | ∀ Q ∈ Z_set b, ((M_t : ℤ) : WithTop ℤ) ≤ ord Q (h : F)}
          zero_mem' := fun Q hQ_in => by
            obtain ⟨_, hQ, _, _⟩ := (hZ_mem b Q).mp hQ_in
            change ((M_t : ℤ) : WithTop ℤ) ≤ ord Q (0 : F)
            rw [hOrdZero Q hQ]; exact le_top
          add_mem' := fun {h₁ h₂} hh₁ hh₂ Q hQ_in => by
            obtain ⟨_, hQ, _, _⟩ := (hZ_mem b Q).mp hQ_in
            exact le_trans (le_min (hh₁ Q hQ_in) (hh₂ Q hQ_in))
              ((hDed.2.1 Q hQ).2.2.1 (h₁ : F) (h₂ : F))
          smul_mem' := fun r {h} hh Q hQ_in => by
            obtain ⟨_, hQ, _, hQt⟩ := (hZ_mem b Q).mp hQ_in
            change ((M_t : ℤ) : WithTop ℤ) ≤ ord Q ((r : F) * (h : F))
            rw [(hDed.2.1 Q hQ).2.1]
            have hr0 : (0 : WithTop ℤ) ≤ ord Q (r : F) := (hCt.2.2.1 (r : F)).mp r.2 Q hQ hQt
            simpa using add_le_add hr0 (hh Q hQ_in) }
      have hSupTop : I_act.sup J_id = ⊤ := by
        by_contra hNeTop
        obtain ⟨𝔪, h𝔪_max, hSup_le⟩ := Ideal.exists_le_maximal (I_act.sup J_id) hNeTop
        obtain ⟨P, hP, hPt, h𝔪_iff⟩ := hCt.2.2.2.1 𝔪 h𝔪_max
        obtain ⟨b₀, hb₀, hPb₀⟩ := hCov P hP
        have hb₀_in : b₀ ∈ I_act := Finset.mem_filter.mpr ⟨Finset.mem_univ b₀, hb₀⟩
        have hSepZ : ∀ Q : X, Q ∈ Z_set b₀ →
            ∃ s : ↥Bt, (1 : WithTop ℤ) ≤ ord Q (s : F) ∧ ord P (s : F) = 0 := by
          intro Q hQ_in
          obtain ⟨_, hQ, hQnotW, hQt⟩ := (hZ_mem b₀ Q).mp hQ_in
          have hQP : Q ≠ P := fun hEq => hQnotW (hEq ▸ hPb₀)
          exact hSepElem t hCt P Q hP hQ hPt hQt hQP
        let sZ : X → ↥Bt := fun Q =>
          if hQ_in : Q ∈ Z_set b₀ then Classical.choose (hSepZ Q hQ_in) else 1
        let h₀ : ↥Bt := ∏ Q ∈ Z_set b₀, (sZ Q) ^ M_t
        have hh₀_in_J : h₀ ∈ J_id b₀ := by
          intro Q hQ_in
          obtain ⟨_, hQ, _, hQt⟩ := (hZ_mem b₀ Q).mp hQ_in
          have hVal : (h₀ : F) = ∏ R ∈ Z_set b₀, ((sZ R : F) ^ M_t) := by
            simp [h₀]
          rw [hVal, ← Finset.mul_prod_erase (Z_set b₀) (fun R => (sZ R : F) ^ M_t) hQ_in,
            (hDed.2.1 Q hQ).2.1]
          have hsQ1 : (1 : WithTop ℤ) ≤ ord Q (sZ Q : F) := by
            simp only [sZ, hQ_in, ↓reduceDIte]
            exact (Classical.choose_spec (hSepZ Q hQ_in)).1
          have hge1 : ((M_t : ℤ) : WithTop ℤ) ≤ ord Q ((sZ Q : F) ^ M_t) :=
            hOrdPowGe Q hQ (sZ Q : F) hsQ1 M_t
          have hge2 : (0 : WithTop ℤ) ≤ ord Q (∏ R ∈ (Z_set b₀).erase Q, (sZ R : F) ^ M_t) :=
            hOrdProdNonneg Q hQ _ _ fun R _ =>
              hOrdPowNonneg Q hQ _ ((hCt.2.2.1 _).mp (sZ R).2 Q hQ hQt) M_t
          simpa using add_le_add hge1 hge2
        have hh₀_in_𝔪 : h₀ ∈ 𝔪 :=
          hSup_le (Finset.le_sup (f := J_id) hb₀_in hh₀_in_J)
        have hOrdP1 : (1 : WithTop ℤ) ≤ ord P (h₀ : F) := (h𝔪_iff h₀).mp hh₀_in_𝔪
        have hOrdP0 : ord P (h₀ : F) = 0 := by
          have hVal : (h₀ : F) = ∏ Q ∈ Z_set b₀, ((sZ Q : F) ^ M_t) := by simp [h₀]
          rw [hVal]
          refine hOrdProdZero P hP _ _ fun Q hQ_in => ?_
          have hsP0 : ord P (sZ Q : F) = 0 := by
            simp only [sZ, hQ_in, ↓reduceDIte]
            exact (Classical.choose_spec (hSepZ Q hQ_in)).2
          have hs_ne : (sZ Q : F) ≠ 0 := by
            intro h0; rw [h0, hOrdZero P hP] at hsP0; exact WithTop.top_ne_coe hsP0
          have hsZ0 : ordZ P hP (sZ Q : F) hs_ne = 0 := by
            have h := hOrdZ P hP (sZ Q : F) hs_ne
            rw [hsP0, ← WithTop.coe_zero] at h
            exact WithTop.coe_inj.mp h.symm
          rw [hOrdPow P hP (sZ Q : F) hs_ne M_t, hsZ0, mul_zero, WithTop.coe_zero]
        rw [hOrdP0] at hOrdP1
        exact absurd (WithTop.coe_le_coe.mp hOrdP1) (by omega)
      have hOneIn : (1 : ↥Bt) ∈ I_act.sup J_id := by rw [hSupTop]; trivial
      obtain ⟨r_t, hr_mem, hr_sum⟩ := hSupPartition I_act J_id 1 hOneIn
      have hr_sum_F : (∑ b ∈ I_act, (r_t b : F)) = 1 := by
        have h := congrArg (Subtype.val : ↥Bt → F) hr_sum
        simpa using h
      let u_t : Fin m_cov → F := fun a => ∑ b ∈ I_act, (r_t b : F) * c_F a b
      refine ⟨u_t, ?_, ?_⟩
      · intro a ha P hPa hP hPt
        have ha_in : a ∈ I_act := Finset.mem_filter.mpr ⟨Finset.mem_univ a, ha⟩
        refine hOrdSumGe P hP I_act _ _ fun b hb_in => ?_
        have hb : IsActive b := (Finset.mem_filter.mp hb_in).2
        by_cases hPb : P ∈ W_set b
        · rw [(hDed.2.1 P hP).2.1]
          have hr0 : (0 : WithTop ℤ) ≤ ord P (r_t b : F) :=
            (hCt.2.2.1 _).mp (r_t b).2 P hP hPt
          have hc_ge := hc_ov a b ha hb P ⟨hPa, hPb⟩ hP
          simpa using add_le_add hr0 hc_ge
        · have hPZ : P ∈ Z_set b := (hZ_mem b P).mpr ⟨hb, hP, hPb, hPt⟩
          by_cases hc0 : c_F a b = 0
          · rw [hc0, mul_zero, hOrdZero P hP]; exact le_top
          · rw [(hDed.2.1 P hP).2.1, hOrdZ P hP (c_F a b) hc0]
            have hr_ge : ((M_t : ℤ) : WithTop ℤ) ≤ ord P (r_t b : F) :=
              hr_mem b hb_in P hPZ
            have hδ_le : δ_t a b P ≤ M_t := by
              have hab_in : (a, b) ∈ I_act ×ˢ I_act := Finset.mem_product.mpr ⟨ha_in, hb_in⟩
              have h1 : δ_t a b P ≤ (Z_set b).sup (fun Q => δ_t a b Q) :=
                Finset.le_sup (f := fun Q => δ_t a b Q) hPZ
              have h2 : (Z_set b).sup (fun Q => δ_t a b Q) ≤
                  (I_act ×ˢ I_act).sup (fun p => (Z_set p.2).sup (fun Q => δ_t p.1 p.2 Q)) :=
                Finset.le_sup (f := fun p : Fin m_cov × Fin m_cov =>
                  (Z_set p.2).sup (fun Q => δ_t p.1 p.2 Q)) hab_in
              omega
            have hδ_eq : δ_t a b P = (-D P - ordZ P hP (c_F a b) hc0).toNat := by
              simp [δ_t, hP, hc0]
            have hge := add_le_add hr_ge (le_rfl : (ordZ P hP (c_F a b) hc0 : WithTop ℤ) ≤ _)
            refine le_trans ?_ hge
            rw [hCoeNeg, ← WithTop.coe_add, WithTop.coe_le_coe]
            omega
      · intro a a' ha ha'
        calc u_t a - u_t a'
            = ∑ b ∈ I_act, (r_t b : F) * (c_F a b - c_F a' b) := by
              simp only [u_t, ← Finset.sum_sub_distrib, mul_sub]
          _ = ∑ b ∈ I_act, (r_t b : F) * c_F a a' := by
              refine Finset.sum_congr rfl fun b hb_in => ?_
              have hb : IsActive b := (Finset.mem_filter.mp hb_in).2
              have hcoc := hc_cocycle a a' b ha ha' hb
              congr 1
              linear_combination -hcoc
          _ = (∑ b ∈ I_act, (r_t b : F)) * c_F a a' := (Finset.sum_mul _ _ _).symm
          _ = c_F a a' := by rw [hr_sum_F, one_mul]

    obtain ⟨u₀, hu₀_reg, hu₀_diff⟩ := hSingleChart x_sep hChart0
    obtain ⟨u_inf, hu_inf_reg, hu_inf_diff⟩ := hSingleChart x_sep⁻¹ hChartInf
    obtain ⟨P_base, hP_base⟩ := hDed.1.nonempty
    obtain ⟨a₀, ha₀, _⟩ := hCov P_base hP_base
    let z : F := u₀ a₀ - u_inf a₀
    have hz_eq : ∀ a : Fin m_cov, IsActive a → u₀ a - u_inf a = z := by
      intro a ha
      have h1 := hu₀_diff a a₀ ha ha₀
      have h2 := hu_inf_diff a a₀ ha ha₀
      dsimp only [z]
      linear_combination h1 - h2
    have hz_in : z ∈ E₀_inf := by
      rw [hSp.2.2.1]
      intro P hP hPx0
      obtain ⟨a, ha, hPa⟩ := hCov P hP
      rw [← hz_eq a ha]
      have hge0 := hu₀_reg a ha P hPa hP (le_of_eq hPx0.symm)
      have hge_inf := hu_inf_reg a ha P hPa hP ((hOrdY_iff P hP).mpr (le_of_eq hPx0))
      exact le_trans (le_min hge0 hge_inf) (hOrdSub P hP (u₀ a) (u_inf a))
    rcases Submodule.mem_sup.mp (hSurj z hz_in) with ⟨z₀, hz₀, z_inf', hz_inf', hz_sum⟩
    let z_inf : F := -z_inf'
    have hz_inf : z_inf ∈ E_inf := E_inf.neg_mem hz_inf'
    let f_F : Fin m_cov → F := fun a => if IsActive a then u₀ a - z₀ else 0
    refine ⟨f_F, ?_, ?_⟩
    · intro a ha P hPa hP
      simp only [f_F, ha, ↓reduceIte]
      rcases le_total (0 : WithTop ℤ) (ord P x_sep) with hPx_ge | hPx_le
      · have h1 := hu₀_reg a ha P hPa hP hPx_ge
        have h2 := (hSp.1 z₀).mp hz₀ P hP hPx_ge
        exact le_trans (le_min h1 h2) (hOrdSub P hP (u₀ a) z₀)
      · have hf_eq : u₀ a - z₀ = u_inf a - z_inf := by
          have ha_eq := hz_eq a ha
          dsimp only [z_inf]
          linear_combination ha_eq - hz_sum
        rw [hf_eq]
        have h1 := hu_inf_reg a ha P hPa hP ((hOrdY_iff P hP).mpr hPx_le)
        have h2 := (hSp.2.1 z_inf).mp hz_inf P hP hPx_le
        exact le_trans (le_min h1 h2) (hOrdSub P hP (u_inf a) z_inf)
    · intro a b ha hb
      simp only [f_F, ha, hb, ↓reduceIte]
      have hsub : (u₀ a - z₀) - (u₀ b - z₀) = u₀ a - u₀ b := by ring
      rw [hsub, hu₀_diff a b ha hb]

  exact ⟨g_E, hClaim1, hClaim2, hClaim3⟩

theorem weil_twoChart_laurent_dual_equiv_trace_subspace (Ω X F : Type u) [Field Ω] [Field F] [Algebra Ω F]
    (IsPlace : X → Prop) (ord : X → F → WithTop ℤ)
    (hVal : IsCurvePlaceValuation Ω X F IsPlace ord)
    (x : F) (hx_tr : Transcendental Ω x)
    (K₀ : IntermediateField Ω F) (hK₀ : K₀ = IntermediateField.adjoin Ω ({x} : Set F))
    [FiniteDimensional ↥K₀ F] [Algebra.IsSeparable ↥K₀ F]
    (D : X → ℤ) (hD_fin : {P : X | D P ≠ 0}.Finite)
    (E₀ E_inf E₀_inf L_D : Submodule Ω F)
    (hSpaces : IsTwoChartDivisorSpaces Ω X F IsPlace ord x D E₀ E_inf E₀_inf L_D)
    (W_dual : Submodule Ω F)
    (hW_dual : ∀ w : F, w ∈ W_dual ↔
      (∀ v ∈ E₀, ((Algebra.trace ↥K₀ F (w * v) : ↥K₀) : F) ∈ Algebra.adjoin Ω ({x} : Set F)) ∧
      (∀ v ∈ E_inf, x ^ 2 * ((Algebra.trace ↥K₀ F (w * v) : ↥K₀) : F) ∈
        Algebra.adjoin Ω ({x⁻¹} : Set F))) :
    Nonempty (Module.Dual Ω (↥E₀_inf ⧸ Submodule.comap E₀_inf.subtype (E₀ ⊔ E_inf)) ≃ₗ[Ω] ↥W_dual) :=
by
  classical
  let A₀ : Subalgebra Ω F := Algebra.adjoin Ω ({x} : Set F)
  let A_inf : Subalgebra Ω F := Algebra.adjoin Ω ({x⁻¹} : Set F)
  have hinj_aeval : Function.Injective (Polynomial.aeval x : Polynomial Ω →ₐ[Ω] F) :=
    transcendental_iff_injective.mp hx_tr
  have hx_ne : x ≠ 0 := by
    intro hx0
    apply Polynomial.X_ne_zero (R := Ω)
    apply hinj_aeval
    rw [Polynomial.aeval_X, map_zero, hx0]
  have hx_A₀ : x ∈ A₀ := Algebra.subset_adjoin (Set.mem_singleton x)
  have hx_inv_Ainf : x⁻¹ ∈ A_inf := Algebra.subset_adjoin (Set.mem_singleton x⁻¹)
  have hx_K₀ : x ∈ K₀ := by
    rw [hK₀]
    exact IntermediateField.mem_adjoin_simple_self Ω x
  have hA₀_le_K₀ : ∀ a ∈ A₀, a ∈ K₀ := by
    have hle : A₀ ≤ K₀.toSubalgebra :=
