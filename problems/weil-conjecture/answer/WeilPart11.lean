import WeilPart10
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_separable_coord_dedekind_and_simple_pole_algebra (Ω X F : Type u)
    [Field Ω] [Field F] [Algebra Ω F]
    (IsPlace : X → Prop) (ord : X → F → WithTop ℤ)
    (hVal : ∀ P : X, IsPlace P →
      (∀ a : F, ord P a = ⊤ ↔ a = 0) ∧
      (∀ x y : F, ord P (x * y) = ord P x + ord P y) ∧
      (∀ x y : F, min (ord P x) (ord P y) ≤ ord P (x + y)) ∧
      (∀ c : Ω, c ≠ 0 → ord P (algebraMap Ω F c) = 0)) :
    (∀ f : F, Transcendental Ω f →
      (let Lf := IntermediateField.adjoin Ω ({f} : Set F)
       FiniteDimensional ↥Lf F ∧ Algebra.IsSeparable ↥Lf F) →
      let Af := Algebra.adjoin Ω ({f} : Set F)
      let Bf := integralClosure (↥Af) F
      IsDedekindDomain ↥Bf ∧
      ¬IsField ↥Bf ∧
      IsFractionRing ↥Bf F ∧
      (∃ e_poly : Polynomial Ω →+* ↥Bf,
        (∀ c : Ω, (e_poly (Polynomial.C c) : F) = algebraMap Ω F c) ∧
        (e_poly Polynomial.X : F) = f ∧
        e_poly.Finite) ∧
      (∀ v : F, v ∈ Bf → ∀ P : X, IsPlace P →
        (0 : WithTop ℤ) ≤ ord P f → (0 : WithTop ℤ) ≤ ord P v)) ∧
    (∀ (P₀ : X) (f : F),
      IsPlace P₀ →
      ord P₀ f = (-1 : WithTop ℤ) →
      (∀ P : X, IsPlace P → P ≠ P₀ → (0 : WithTop ℤ) ≤ ord P f) →
      (∀ v : F, (0 : WithTop ℤ) ≤ ord P₀ v →
        ∃ c : Ω, (1 : WithTop ℤ) ≤ ord P₀ (v - algebraMap Ω F c)) →
      Transcendental Ω f →
      Transcendental Ω f⁻¹ →
      (let Lfinv := IntermediateField.adjoin Ω ({f⁻¹} : Set F)
       FiniteDimensional ↥Lfinv F ∧ Algebra.IsSeparable ↥Lfinv F) →
      (∀ v : F,
        (∀ P : X, IsPlace P → (0 : WithTop ℤ) ≤ ord P f⁻¹ → (0 : WithTop ℤ) ≤ ord P v) →
        v ∈ integralClosure ↥(Algebra.adjoin Ω ({f⁻¹} : Set F)) F) →
      (∀ v ∈ integralClosure ↥(Algebra.adjoin Ω ({f} : Set F)) F,
        ∃ p : Polynomial Ω, Polynomial.aeval f p = v) ∧
      (∀ v ∈ integralClosure ↥(Algebra.adjoin Ω ({f⁻¹} : Set F)) F,
        ∃ p : Polynomial Ω, Polynomial.aeval f⁻¹ p = v)) :=
by
  let mkEquiv : ∀ (t : F), Transcendental Ω t →
      (Polynomial Ω ≃ₐ[Ω] ↥(Algebra.adjoin Ω ({t} : Set F))) :=
    fun t ht =>
      (AlgEquiv.ofInjective (Polynomial.aeval t) (transcendental_iff_injective.mp ht)).trans
        (Subalgebra.equivOfEq _ _ (Algebra.adjoin_singleton_eq_range_aeval Ω t).symm)
  have hEquiv_val : ∀ (t : F) (ht : Transcendental Ω t) (p : Polynomial Ω),
      (mkEquiv t ht p : F) = Polynomial.aeval t p := by
    intro t ht p
    simp [mkEquiv]
  have hAt_props : ∀ (t : F), Transcendental Ω t →
      IsPrincipalIdealRing ↥(Algebra.adjoin Ω ({t} : Set F)) ∧
      IsIntegrallyClosed ↥(Algebra.adjoin Ω ({t} : Set F)) := by
    intro t ht
    let e_At := mkEquiv t ht
    refine ⟨IsPrincipalIdealRing.of_surjective e_At.toRingEquiv.toRingHom e_At.toRingEquiv.surjective,
      IsIntegrallyClosed.of_equiv e_At.toRingEquiv⟩
  have hFin_Bf : ∀ (t : F), Transcendental Ω t →
      (let Lt := IntermediateField.adjoin Ω ({t} : Set F)
       FiniteDimensional ↥Lt F ∧ Algebra.IsSeparable ↥Lt F) →
      Module.Finite ↥(Algebra.adjoin Ω ({t} : Set F))
        ↥(integralClosure ↥(Algebra.adjoin Ω ({t} : Set F)) F) := by
    intro t ht ht_sep
    let At := Algebra.adjoin Ω ({t} : Set F)
    let Lt := IntermediateField.adjoin Ω ({t} : Set F)
    let Bt := integralClosure (↥At) F
    obtain ⟨hPIR_At, hIC_At⟩ := hAt_props t ht
    have : IsPrincipalIdealRing ↥At := hPIR_At
    have : IsIntegrallyClosed ↥At := hIC_At
    have : FiniteDimensional ↥Lt F := ht_sep.1
    have : Algebra.IsSeparable ↥Lt F := ht_sep.2
    let _ : Algebra ↥At ↥Lt :=
      IntermediateField.algebraAdjoinAdjoin.instAlgebraSubtypeMemSubalgebraAdjoinAdjoin Ω ({t} : Set F)
    have : IsFractionRing ↥At ↥Lt :=
      IntermediateField.algebraAdjoinAdjoin.instIsFractionRingSubtypeMemSubalgebraAdjoinAdjoin Ω ({t} : Set F)
    have : IsScalarTower ↥At ↥Lt F := IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact IsIntegralClosure.finite ↥At ↥Lt F ↥Bt
  have hPart1 : ∀ f : F, Transcendental Ω f →
      (let Lf := IntermediateField.adjoin Ω ({f} : Set F)
       FiniteDimensional ↥Lf F ∧ Algebra.IsSeparable ↥Lf F) →
      let Af := Algebra.adjoin Ω ({f} : Set F)
      let Bf := integralClosure (↥Af) F
      IsDedekindDomain ↥Bf ∧
      ¬IsField ↥Bf ∧
      IsFractionRing ↥Bf F ∧
      (∃ e_poly : Polynomial Ω →+* ↥Bf,
        (∀ c : Ω, (e_poly (Polynomial.C c) : F) = algebraMap Ω F c) ∧
        (e_poly Polynomial.X : F) = f ∧
        e_poly.Finite) ∧
      (∀ v : F, v ∈ Bf → ∀ P : X, IsPlace P →
        (0 : WithTop ℤ) ≤ ord P f → (0 : WithTop ℤ) ≤ ord P v) := by
    intro f hf_tr hf_sep
    let Af := Algebra.adjoin Ω ({f} : Set F)
    let Lf := IntermediateField.adjoin Ω ({f} : Set F)
    let Bf := integralClosure (↥Af) F
    let e_Af := mkEquiv f hf_tr
    obtain ⟨hPIR_Af, hIC_Af⟩ := hAt_props f hf_tr
    have : IsPrincipalIdealRing ↥Af := hPIR_Af
    have : IsIntegrallyClosed ↥Af := hIC_Af
    have : FiniteDimensional ↥Lf F := hf_sep.1
    have : Algebra.IsSeparable ↥Lf F := hf_sep.2
    let _ : Algebra ↥Af ↥Lf :=
      IntermediateField.algebraAdjoinAdjoin.instAlgebraSubtypeMemSubalgebraAdjoinAdjoin Ω ({f} : Set F)
    have : IsFractionRing ↥Af ↥Lf :=
      IntermediateField.algebraAdjoinAdjoin.instIsFractionRingSubtypeMemSubalgebraAdjoinAdjoin Ω ({f} : Set F)
    have : IsScalarTower ↥Af ↥Lf F := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hModFin : Module.Finite ↥Af ↥Bf := hFin_Bf f hf_tr hf_sep
    have hDed_Bf : IsDedekindDomain ↥Bf := integralClosure.isDedekindDomain ↥Af ↥Lf F
    have hFrac_Bf : IsFractionRing ↥Bf F :=
      integralClosure.isFractionRing_of_finite_extension (A := ↥Af) ↥Lf F
    have hNotField_Bf : ¬IsField ↥Bf := by
      intro hField_Bf
      have : Module.Finite ↥Af ↥Bf := hModFin
      have : Algebra.IsIntegral ↥Af ↥Bf := Algebra.IsIntegral.of_finite ↥Af ↥Bf
      have hinj_Af_Bf : Function.Injective (algebraMap ↥Af ↥Bf) := by
        intro a₁ a₂ hEq
        apply Subtype.ext
        exact congrArg (fun b : ↥Bf => (b : F)) hEq
      have hField_Af : IsField ↥Af := isField_of_isIntegral_of_isField hinj_Af_Bf hField_Bf
      have hField_Poly : IsField (Polynomial Ω) :=
        MulEquiv.isField hField_Af e_Af.toRingEquiv.toMulEquiv
      exact Polynomial.not_isField Ω hField_Poly
    have hPolyPkg : ∃ e_poly : Polynomial Ω →+* ↥Bf,
        (∀ c : Ω, (e_poly (Polynomial.C c) : F) = algebraMap Ω F c) ∧
        (e_poly Polynomial.X : F) = f ∧
        e_poly.Finite := by
      let e_poly : Polynomial Ω →+* ↥Bf := (algebraMap ↥Af ↥Bf).comp e_Af.toRingEquiv.toRingHom
      refine ⟨e_poly, ?_, ?_, ?_⟩
      · intro c
        change (algebraMap ↥Af ↥Bf (e_Af (Polynomial.C c)) : F) = algebraMap Ω F c
        change (e_Af (Polynomial.C c) : F) = algebraMap Ω F c
        rw [hEquiv_val f hf_tr (Polynomial.C c), Polynomial.aeval_C]
      · change (algebraMap ↥Af ↥Bf (e_Af Polynomial.X) : F) = f
        change (e_Af Polynomial.X : F) = f
        rw [hEquiv_val f hf_tr Polynomial.X, Polynomial.aeval_X]
      · obtain ⟨s, hs⟩ := Module.finite_def.mp hModFin
        let _ : Algebra (Polynomial Ω) ↥Bf := e_poly.toAlgebra
        refine Module.finite_def.mpr ⟨s, Submodule.eq_top_iff'.mpr ?_⟩
        intro b
        have hb : b ∈ Submodule.span ↥Af (s : Set ↥Bf) := hs ▸ Submodule.mem_top
        induction hb using Submodule.span_induction with
        | mem x hx => exact Submodule.subset_span hx
        | zero => exact Submodule.zero_mem _
        | add x y _ _ hx hy => exact Submodule.add_mem _ hx hy
        | smul a y _ hy =>
          let P : Polynomial Ω := e_Af.symm a
          have hsmul_eq : a • y = e_poly P * y := by
            apply Subtype.ext
            change (a : F) * (y : F) = (e_Af P : F) * (y : F)
            rw [e_Af.apply_symm_apply]
          rw [hsmul_eq]
          exact Submodule.smul_mem (Submodule.span (Polynomial Ω) (s : Set ↥Bf)) P hy
    have hVal_Bf : ∀ v : F, v ∈ Bf → ∀ P : X, IsPlace P →
        (0 : WithTop ℤ) ≤ ord P f → (0 : WithTop ℤ) ≤ ord P v := by
      intro v hv P hP hfP
      obtain ⟨hZero, hMul, hAdd, hConst⟩ := hVal P hP
      have hOrd0 : ord P 0 = ⊤ := (hZero 0).mpr rfl
      have hOrd1 : ord P 1 = 0 := by
        rw [← map_one (algebraMap Ω F)]
        exact hConst 1 one_ne_zero
      have hOrdNeg : ∀ x : F, ord P (-x) = ord P x := by
        intro x
        have hx : -x = algebraMap Ω F (-1) * x := by simp
        rw [hx, hMul, hConst (-1) (neg_ne_zero.mpr one_ne_zero), zero_add]
      have hOrdSum : ∀ (B : WithTop ℤ) (I : Finset ℕ) (g_fn : ℕ → F),
          (∀ i ∈ I, B ≤ ord P (g_fn i)) → B ≤ ord P (∑ i ∈ I, g_fn i) := by
        intro B I g_fn
        induction I using Finset.induction_on with
        | empty =>
          intro _
          rw [Finset.sum_empty, hOrd0]
          exact le_top
        | @insert i s hi ih =>
          intro h_le
          rw [Finset.sum_insert hi]
          exact le_trans
            (le_min (h_le i (Finset.mem_insert_self i s))
              (ih fun j hj => h_le j (Finset.mem_insert_of_mem hj)))
            (hAdd _ _)
      have hOrd_Af : ∀ a : F, a ∈ Af → (0 : WithTop ℤ) ≤ ord P a := by
        intro a ha
        induction ha using Algebra.adjoin_induction with
        | mem x hx =>
          rw [Set.mem_singleton_iff.mp hx]
          exact hfP
        | algebraMap c =>
          by_cases hc : c = 0
          · rw [hc, map_zero, hOrd0]
            exact le_top
          · rw [hConst c hc]
        | add x y _ _ hx hy =>
          exact le_trans (le_min hx hy) (hAdd x y)
        | mul x y _ _ hx hy =>
          rw [hMul x y]
          exact add_nonneg hx hy
      obtain ⟨p, hp_monic, hp_eval⟩ := hv
      let n := p.natDegree
      have hn_pos : 1 ≤ n := by
        by_contra hn0
        have hn_eq : n = 0 := by omega
        have hp1 : p = 1 := Polynomial.eq_one_of_monic_natDegree_zero hp_monic hn_eq
        rw [hp1, Polynomial.eval₂_one] at hp_eval
        exact one_ne_zero hp_eval
      by_contra h_neg
      cases h_ord_v : ord P v with
      | top =>
        apply h_neg
        rw [h_ord_v]
        exact le_top
      | coe k =>
        rw [h_ord_v] at h_neg
        have hk : k < 0 := by
          have hk' : ¬((0 : ℤ) ≤ k) := fun h0 => h_neg (WithTop.coe_le_coe.mpr h0)
          omega
        have hOrdPow : ∀ m : ℕ, ord P (v ^ m) = (((m : ℤ) * k : ℤ) : WithTop ℤ) := by
          intro m
          induction m with
          | zero =>
            rw [pow_zero, hOrd1]
            simp
          | succ m ih =>
            rw [pow_succ, hMul, ih, h_ord_v, ← WithTop.coe_add]
            congr 1
            push_cast
            ring
        have hSumEval : (∑ i ∈ Finset.range n, (p.coeff i : F) * v ^ i) + v ^ n = 0 := by
          have h1 := Polynomial.eval₂_eq_sum_range (algebraMap ↥Af F) v (p := p)
          change p.eval₂ (algebraMap ↥Af F) v =
            ∑ i ∈ Finset.range (n + 1), (p.coeff i : F) * v ^ i at h1
          rw [hp_eval, Finset.sum_range_succ, hp_monic.coeff_natDegree] at h1
          simpa using h1.symm
        have hvn_eq : v ^ n = -(∑ i ∈ Finset.range n, (p.coeff i : F) * v ^ i) :=
          eq_neg_of_add_eq_zero_right hSumEval
        let B : WithTop ℤ := ((((n - 1 : ℕ) : ℤ) * k : ℤ) : WithTop ℤ)
        have hB_le : B ≤ ord P (v ^ n) := by
          rw [hvn_eq, hOrdNeg]
          apply hOrdSum B (Finset.range n) (fun i => (p.coeff i : F) * v ^ i)
          intro i hi
          have hi_lt : i < n := Finset.mem_range.mp hi
          have hik : ((n - 1 : ℕ) : ℤ) * k ≤ (i : ℤ) * k :=
            mul_le_mul_of_nonpos_right (by omega) (by omega)
          have h_ci : (0 : WithTop ℤ) ≤ ord P (p.coeff i : F) :=
            hOrd_Af (p.coeff i : F) (p.coeff i).2
          calc B
              ≤ (((i : ℤ) * k : ℤ) : WithTop ℤ) := WithTop.coe_le_coe.mpr hik
            _ = (0 : WithTop ℤ) + ord P (v ^ i) := by rw [zero_add, hOrdPow i]
            _ ≤ ord P (p.coeff i : F) + ord P (v ^ i) := add_le_add h_ci le_rfl
            _ = ord P ((p.coeff i : F) * v ^ i) := (hMul _ _).symm
        rw [hOrdPow n] at hB_le
        have h_int_le : ((n - 1 : ℕ) : ℤ) * k ≤ (n : ℤ) * k := WithTop.coe_le_coe.mp hB_le
        have h_sub : ((n - 1 : ℕ) : ℤ) = (n : ℤ) - 1 := by omega
        rw [h_sub] at h_int_le
        have : (0 : ℤ) ≤ k := by nlinarith
        omega
    exact ⟨hDed_Bf, hNotField_Bf, hFrac_Bf, hPolyPkg, hVal_Bf⟩
  refine ⟨hPart1, ?_⟩
  intro P₀ f hP₀ hOrdP₀ hOrdOther hResP₀ hf_tr hg_tr hg_sep hBg_mem
  let g : F := f⁻¹
  let Af := Algebra.adjoin Ω ({f} : Set F)
  let Ag := Algebra.adjoin Ω ({g} : Set F)
  let Bf := integralClosure (↥Af) F
  let Bg := integralClosure (↥Ag) F
  let Lf := IntermediateField.adjoin Ω ({f} : Set F)
  have hf_ne : f ≠ 0 := by
    intro hf0
    have htop : ord P₀ f = ⊤ := ((hVal P₀ hP₀).1 f).mpr hf0
    rw [hOrdP₀] at htop
    exact WithTop.coe_ne_top htop
  have hg_ne : g ≠ 0 := inv_ne_zero hf_ne
  have hOrdP₀_1 : ord P₀ 1 = (0 : WithTop ℤ) := by
    rw [← map_one (algebraMap Ω F)]
    exact (hVal P₀ hP₀).2.2.2 1 one_ne_zero
  have hOrdP₀_g : ord P₀ g = (1 : WithTop ℤ) := by
    have hsum : ord P₀ f + ord P₀ g = (0 : WithTop ℤ) := by
      rw [← (hVal P₀ hP₀).2.1 f g, mul_inv_cancel₀ hf_ne, hOrdP₀_1]
    rw [hOrdP₀] at hsum
    cases h_ord_g : ord P₀ g with
    | top =>
      exfalso
      exact hg_ne (((hVal P₀ hP₀).1 g).mp h_ord_g)
    | coe m =>
      rw [h_ord_g] at hsum
      change ((-1 : ℤ) : WithTop ℤ) + (m : WithTop ℤ) = ((0 : ℤ) : WithTop ℤ) at hsum
      rw [← WithTop.coe_add, WithTop.coe_eq_coe] at hsum
      have hm : m = 1 := by omega
      rw [hm]
      rfl
  obtain ⟨_, _, hFrac_Bg, _, hBg_ord⟩ := hPart1 g hg_tr hg_sep
  have hModFin_Bg : Module.Finite ↥Ag ↥Bg := hFin_Bf g hg_tr hg_sep
  obtain ⟨_, hIC_Af⟩ := hAt_props f hf_tr
  obtain ⟨_, hIC_Ag⟩ := hAt_props g hg_tr
  let e_Ag := mkEquiv g hg_tr
  have hResDiv : ∀ b : ↥Bg, ∃ (c : Ω) (w : ↥Bg),
      (b : F) = algebraMap Ω F c + g * (w : F) := by
    intro b
    have hg_nonneg_P₀ : (0 : WithTop ℤ) ≤ ord P₀ g := by
      rw [hOrdP₀_g]
      exact WithTop.coe_le_coe.mpr (by omega)
    have hb_nonneg_P₀ : (0 : WithTop ℤ) ≤ ord P₀ (b : F) :=
      hBg_ord (b : F) b.2 P₀ hP₀ hg_nonneg_P₀
    obtain ⟨c, hc⟩ := hResP₀ (b : F) hb_nonneg_P₀
    let w_F : F := ((b : F) - algebraMap Ω F c) * f
    have hw_mem : w_F ∈ Bg := by
      apply hBg_mem w_F
      intro P hP hgP
      by_cases hPP₀ : P = P₀
      · subst hPP₀
        change (0 : WithTop ℤ) ≤ ord P (((b : F) - algebraMap Ω F c) * f)
        rw [(hVal P hP).2.1, hOrdP₀]
        have h0_eq : (0 : WithTop ℤ) = (1 : WithTop ℤ) + (-1 : WithTop ℤ) := rfl
        rw [h0_eq]
        exact add_le_add hc le_rfl
      · have hc_Ag : algebraMap Ω F c ∈ Ag := Ag.algebraMap_mem c
        have hc_Bg : algebraMap Ω F c ∈ Bg := Bg.algebraMap_mem ⟨algebraMap Ω F c, hc_Ag⟩
        have hsub_Bg : (b : F) - algebraMap Ω F c ∈ Bg := Bg.sub_mem b.2 hc_Bg
        have hsub_ord : (0 : WithTop ℤ) ≤ ord P ((b : F) - algebraMap Ω F c) :=
          hBg_ord _ hsub_Bg P hP hgP
        have hf_ord : (0 : WithTop ℤ) ≤ ord P f := hOrdOther P hP hPP₀
        change (0 : WithTop ℤ) ≤ ord P (((b : F) - algebraMap Ω F c) * f)
        rw [(hVal P hP).2.1]
        exact add_nonneg hsub_ord hf_ord
    refine ⟨c, ⟨w_F, hw_mem⟩, ?_⟩
    change (b : F) = algebraMap Ω F c + f⁻¹ * (((b : F) - algebraMap Ω F c) * f)
    have hmul : f⁻¹ * (((b : F) - algebraMap Ω F c) * f) =
        ((b : F) - algebraMap Ω F c) * (f⁻¹ * f) := by ring
    rw [hmul, inv_mul_cancel₀ hf_ne, mul_one, add_sub_cancel]
  let g_Ag : ↥Ag := ⟨g, Algebra.subset_adjoin (Set.mem_singleton g)⟩
  let I : Ideal ↥Ag := Ideal.span {g_Ag}
  let N : Submodule ↥Ag ↥Bg := Submodule.span ↥Ag {(1 : ↥Bg)}
  have hTop_le : (⊤ : Submodule ↥Ag ↥Bg) ≤ N ⊔ I • (⊤ : Submodule ↥Ag ↥Bg) := by
    intro b _
    obtain ⟨c, w, hbw⟩ := hResDiv b
    let c_Ag : ↥Ag := ⟨algebraMap Ω F c, Ag.algebraMap_mem c⟩
    have hb_eq : b = c_Ag • (1 : ↥Bg) + g_Ag • w := by
      apply Subtype.ext
      change (b : F) = (c_Ag : F) * 1 + (g_Ag : F) * (w : F)
      rw [mul_one]
      exact hbw
    rw [hb_eq]
    exact Submodule.add_mem_sup
      (Submodule.smul_mem N c_Ag (Submodule.mem_span_singleton_self (1 : ↥Bg)))
      (Submodule.smul_mem_smul (Ideal.mem_span_singleton_self g_Ag) Submodule.mem_top)
  have hFG_top : (⊤ : Submodule ↥Ag ↥Bg).FG := by
    have : Module.Finite ↥Ag ↥Bg := hModFin_Bg
    exact Module.Finite.fg_top
  obtain ⟨r, hr_I, hr_N⟩ :=
    Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup hFG_top le_rfl hTop_le
  have hr_ne : (r : F) ≠ 0 := by
    obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp hr_I
    have hr_eq : r = 1 + g_Ag * q := eq_add_of_sub_eq' hq
    have he_X : e_Ag Polynomial.X = g_Ag := by
      apply Subtype.ext
      rw [hEquiv_val g hg_tr Polynomial.X, Polynomial.aeval_X]
    have hsymm_g : e_Ag.symm g_Ag = Polynomial.X := by
      rw [← he_X, e_Ag.symm_apply_apply]
    have hsymm_r : e_Ag.symm r = 1 + Polynomial.X * e_Ag.symm q := by
      rw [hr_eq, map_add, map_one, map_mul, hsymm_g]
    have heval0 : Polynomial.eval 0 (e_Ag.symm r) = 1 := by
      rw [hsymm_r]
      simp
    intro hr0
    have hr_zero : r = 0 := Subtype.ext hr0
    rw [hr_zero, map_zero, Polynomial.eval_zero] at heval0
    exact one_ne_zero heval0.symm
  have hr_clear : ∀ b : ↥Bg, ∃ a : ↥Ag, (r : F) * (b : F) = (a : F) := by
    intro b
    have hrb : r • b ∈ N := hr_N ⟨b, Submodule.mem_top, rfl⟩
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hrb
    refine ⟨a, ?_⟩
    have ha_F : ((a • (1 : ↥Bg) : ↥Bg) : F) = ((r • b : ↥Bg) : F) := congrArg Subtype.val ha
    change (a : F) * 1 = (r : F) * (b : F) at ha_F
    rw [mul_one] at ha_F
    exact ha_F.symm
  have : FaithfulSMul ↥Ag F :=
    (faithfulSMul_iff_algebraMap_injective ↥Ag F).mpr Subtype.val_injective
  have : FaithfulSMul ↥Af F :=
    (faithfulSMul_iff_algebraMap_injective ↥Af F).mpr Subtype.val_injective
  have hDiv_Ag : ∀ z : F, ∃ a₁ a₂ : ↥Ag, z = (a₁ : F) / (a₂ : F) := by
    intro z
    have : IsFractionRing ↥Bg F := hFrac_Bg
    obtain ⟨b₁, b₂, _, hbz⟩ := IsFractionRing.div_surjective (A := ↥Bg) z
    obtain ⟨a₁, ha₁⟩ := hr_clear b₁
    obtain ⟨a₂, ha₂⟩ := hr_clear b₂
    refine ⟨a₁, a₂, ?_⟩
    rw [← ha₁, ← ha₂, mul_div_mul_left (b₁ : F) (b₂ : F) hr_ne]
    exact hbz.symm
  have hFrac_Ag : IsFractionRing ↥Ag F := IsFractionRing.of_field ↥Ag F hDiv_Ag
  have hg_in_Lf : g ∈ Lf :=
    Lf.inv_mem (IntermediateField.mem_adjoin_simple_self Ω f)
  have hAg_le_Lf : Ag ≤ Lf.toSubalgebra :=
    Algebra.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hg_in_Lf)
  have hz_Lf : ∀ z : F, z ∈ Lf := by
    intro z
    obtain ⟨a₁, a₂, hz_eq⟩ := hDiv_Ag z
    rw [hz_eq]
    exact Lf.div_mem (hAg_le_Lf a₁.2) (hAg_le_Lf a₂.2)
  have hDiv_Af : ∀ z : F, ∃ u₁ u₂ : ↥Af, z = (u₁ : F) / (u₂ : F) := by
    intro z
    let _ : Algebra ↥Af ↥Lf :=
      IntermediateField.algebraAdjoinAdjoin.instAlgebraSubtypeMemSubalgebraAdjoinAdjoin Ω ({f} : Set F)
    have : IsFractionRing ↥Af ↥Lf :=
      IntermediateField.algebraAdjoinAdjoin.instIsFractionRingSubtypeMemSubalgebraAdjoinAdjoin Ω ({f} : Set F)
    let z_Lf : ↥Lf := ⟨z, hz_Lf z⟩
    obtain ⟨u₁, u₂, _, huz⟩ := IsFractionRing.div_surjective (A := ↥Af) z_Lf
    refine ⟨u₁, u₂, ?_⟩
    have huz_F : ((algebraMap ↥Af ↥Lf u₁ / algebraMap ↥Af ↥Lf u₂ : ↥Lf) : F) = (z_Lf : F) :=
      congrArg Subtype.val huz
    exact huz_F.symm
  have hFrac_Af : IsFractionRing ↥Af F := IsFractionRing.of_field ↥Af F hDiv_Af
  refine ⟨?_, ?_⟩
  · intro v hv
    obtain ⟨a, ha⟩ := (@IsIntegrallyClosed.isIntegral_iff ↥Af _ F _ _ hFrac_Af hIC_Af v).mp hv
    have hv_Af : v ∈ Algebra.adjoin Ω ({f} : Set F) := ha ▸ a.2
    rw [Algebra.adjoin_singleton_eq_range_aeval Ω f] at hv_Af
    exact hv_Af
  · intro v hv
    obtain ⟨a, ha⟩ := (@IsIntegrallyClosed.isIntegral_iff ↥Ag _ F _ _ hFrac_Ag hIC_Ag v).mp hv
    have hv_Ag : v ∈ Algebra.adjoin Ω ({f⁻¹} : Set F) := ha ▸ a.2
    rw [Algebra.adjoin_singleton_eq_range_aeval Ω f⁻¹] at hv_Ag
    exact hv_Ag

theorem weil_proper_curve_dedekind_subring_open_isAffine_iso (Ω : Type u) [Field Ω]
    (E_sm : AlgebraicGeometry.Scheme.{u})
    (p_sm : E_sm ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (hInt : AlgebraicGeometry.IsIntegral E_sm)
    (hProp : AlgebraicGeometry.IsProper p_sm)
    (F : Type u) [Field F] [Algebra Ω F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ E_sm)
    (hη_comm : η_F ≫ p_sm = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω F)))
    (hFunc : IsSchemeFunctionField E_sm F η_F)
    (ord : E_sm → F → WithTop ℤ)
    (hA1 : Set.Infinite {P : E_sm | IsClosed ({P} : Set E_sm)})
    (hA2 : ∀ S : Set E_sm, IsClosed S → S ≠ Set.univ →
      S.Finite ∧ ∀ P ∈ S, IsClosed ({P} : Set E_sm))
    (hVal : ∀ P : E_sm, IsClosed ({P} : Set E_sm) →
      (∀ a : F, ord P a = ⊤ ↔ a = 0) ∧
      (∀ x y : F, ord P (x * y) = ord P x + ord P y) ∧
      (∀ x y : F, min (ord P x) (ord P y) ≤ ord P (x + y)) ∧
      (∀ c : Ω, c ≠ 0 → ord P (algebraMap Ω F c) = 0) ∧
      (∃ ϖ : F, ord P ϖ = (1 : WithTop ℤ)) ∧
      (∀ v : F, (0 : WithTop ℤ) ≤ ord P v →
        ∃ c : Ω, (1 : WithTop ℤ) ≤ ord P (v - algebraMap Ω F c)))
    (hPrinFin : ∀ g : F, g ≠ 0 → {P : E_sm | IsClosed ({P} : Set E_sm) ∧ ord P g ≠ 0}.Finite)
    (hB2 : ∀ (W : E_sm.Opens) (hW : AlgebraicGeometry.IsAffineOpen W),
      Nonempty ↥W →
      ∀ (φ_W : E_sm.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
        AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec = η_F →
        Function.Injective φ_W.hom ∧
        (∀ c : Ω,
          φ_W.hom (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            p_sm.appLE ⊤ W le_top).hom c) = algebraMap Ω F c) ∧
        (∀ g : F,
          g ∈ Set.range φ_W.hom ↔
            ∀ P : E_sm, P ∈ W → IsClosed ({P} : Set E_sm) → (0 : WithTop ℤ) ≤ ord P g) ∧
        (∀ p_P : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W)),
          IsClosed ({hW.fromSpec.base p_P} : Set E_sm) →
          ∀ b : ↑(E_sm.presheaf.obj (Opposite.op W)),
            b ∈ p_P.asIdeal ↔ (1 : WithTop ℤ) ≤ ord (hW.fromSpec.base p_P) (φ_W.hom b)))
    (f : F) (hf_tr : Transcendental Ω f)
    (B : Subring F)
    (hDedB : IsDedekindDomain ↥B)
    (hNotFieldB : ¬IsField ↥B)
    (hFracB : IsFractionRing ↥B F)
    (hf_B : f ∈ B)
    (hΩ_B : ∀ c : Ω, algebraMap Ω F c ∈ B)
    (hB_ord : ∀ b ∈ B, ∀ P : E_sm, IsClosed ({P} : Set E_sm) →
      (0 : WithTop ℤ) ≤ ord P f → (0 : WithTop ℤ) ≤ ord P b) :
    (∀ v : F,
      v ∈ B ↔ ∀ P : E_sm, IsClosed ({P} : Set E_sm) →
        (0 : WithTop ℤ) ≤ ord P f → (0 : WithTop ℤ) ≤ ord P v) ∧
    (∀ 𝔪 : Ideal ↥B, 𝔪.IsMaximal →
      ∃ P : E_sm, IsClosed ({P} : Set E_sm) ∧ (0 : WithTop ℤ) ≤ ord P f ∧
        ∀ b : ↥B, b ∈ 𝔪 ↔ (1 : WithTop ℤ) ≤ ord P (b : F)) ∧
    (∀ P Q : E_sm, IsClosed ({P} : Set E_sm) → IsClosed ({Q} : Set E_sm) →
      (0 : WithTop ℤ) ≤ ord P f → (0 : WithTop ℤ) ≤ ord Q f →
      (∀ b : ↥B, (1 : WithTop ℤ) ≤ ord P (b : F) ↔ (1 : WithTop ℤ) ≤ ord Q (b : F)) →
      P = Q) ∧
    (∃ (U_f : E_sm.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_f),
      (U_f : Set E_sm) = {z : E_sm | ¬IsClosed ({z} : Set E_sm) ∨ (0 : WithTop ℤ) ≤ ord z f} ∧
      Nonempty ↥U_f) :=
by
  have : IsDedekindDomain ↥B := hDedB
  have : IsFractionRing ↥B F := hFracB
  have : AlgebraicGeometry.IsProper p_sm := hProp
  have hIrred : IrreducibleSpace ↥E_sm :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral E_sm
  have hf_ne : f ≠ 0 := by
    intro hf0
    have hinj := transcendental_iff_injective.mp hf_tr
    have h0 : Polynomial.aeval f (Polynomial.X : Polynomial Ω) =
        Polynomial.aeval f (0 : Polynomial Ω) := by
      simp [hf0]
    exact Polynomial.X_ne_zero (hinj h0)
  
  have hOrd_zero : ∀ P : E_sm, IsClosed ({P} : Set E_sm) → ord P 0 = ⊤ :=
    fun P hP => ((hVal P hP).1 0).mpr rfl
  have hOrd_ne_top : ∀ P : E_sm, IsClosed ({P} : Set E_sm) → ∀ x : F, x ≠ 0 → ord P x ≠ ⊤ :=
    fun P hP x hx ht => hx (((hVal P hP).1 x).mp ht)
  have hOrd_one : ∀ P : E_sm, IsClosed ({P} : Set E_sm) → ord P 1 = (0 : WithTop ℤ) := by
    intro P hP
    rw [← map_one (algebraMap Ω F)]
    exact (hVal P hP).2.2.2.1 1 one_ne_zero
  have hOrd_inv_sum : ∀ P : E_sm, IsClosed ({P} : Set E_sm) →
      ∀ x : F, x ≠ 0 → ord P x + ord P x⁻¹ = (0 : WithTop ℤ) := by
    intro P hP x hx
    rw [← (hVal P hP).2.1 x x⁻¹, mul_inv_cancel₀ hx, hOrd_one P hP]
  have hOrd_unit : ∀ P : E_sm, IsClosed ({P} : Set E_sm) →
      ∀ x : F, (0 : WithTop ℤ) ≤ ord P x → ¬((1 : WithTop ℤ) ≤ ord P x) →
        x ≠ 0 ∧ ord P x = (0 : WithTop ℤ) ∧ ord P x⁻¹ = (0 : WithTop ℤ) := by
    intro P hP x hx0 hx1
    have hx_ne : x ≠ 0 := by
      intro h0
      apply hx1
      rw [h0, hOrd_zero P hP]
      exact le_top
    refine ⟨hx_ne, ?_⟩
    cases h1 : ord P x with
    | top => exact absurd h1 (hOrd_ne_top P hP x hx_ne)
    | coe a =>
      cases h2 : ord P x⁻¹ with
      | top => exact absurd h2 (hOrd_ne_top P hP x⁻¹ (inv_ne_zero hx_ne))
      | coe b =>
        have hsum := hOrd_inv_sum P hP x hx_ne
        rw [h1] at hx0 hx1
        rw [h1, h2] at hsum
        change ((0 : ℤ) : WithTop ℤ) ≤ (a : WithTop ℤ) at hx0
        change ¬(((1 : ℤ) : WithTop ℤ) ≤ (a : WithTop ℤ)) at hx1
        change (a : WithTop ℤ) + (b : WithTop ℤ) = ((0 : ℤ) : WithTop ℤ) at hsum
        rw [WithTop.coe_le_coe] at hx0 hx1
        rw [← WithTop.coe_add, WithTop.coe_eq_coe] at hsum
        have ha : a = 0 := by omega
        have hb : b = 0 := by omega
        subst ha hb
        exact ⟨rfl, rfl⟩
  have hOrd_neg_inv : ∀ P : E_sm, IsClosed ({P} : Set E_sm) →
      ∀ x : F, ¬((0 : WithTop ℤ) ≤ ord P x) → x ≠ 0 ∧ (1 : WithTop ℤ) ≤ ord P x⁻¹ := by
    intro P hP x hx_neg
    have hx_ne : x ≠ 0 := by
      intro h0
      apply hx_neg
      rw [h0, hOrd_zero P hP]
      exact le_top
    refine ⟨hx_ne, ?_⟩
    cases h1 : ord P x with
    | top => exact absurd h1 (hOrd_ne_top P hP x hx_ne)
    | coe a =>
      cases h2 : ord P x⁻¹ with
      | top => exact absurd h2 (hOrd_ne_top P hP x⁻¹ (inv_ne_zero hx_ne))
      | coe b =>
        have hsum := hOrd_inv_sum P hP x hx_ne
        rw [h1] at hx_neg
        rw [h1, h2] at hsum
        change ¬(((0 : ℤ) : WithTop ℤ) ≤ (a : WithTop ℤ)) at hx_neg
        change (a : WithTop ℤ) + (b : WithTop ℤ) = ((0 : ℤ) : WithTop ℤ) at hsum
        rw [WithTop.coe_le_coe] at hx_neg
        rw [← WithTop.coe_add, WithTop.coe_eq_coe] at hsum
        change ((1 : ℤ) : WithTop ℤ) ≤ (b : WithTop ℤ)
        rw [WithTop.coe_le_coe]
        omega
  have hOrd_inv_nonneg_iff : ∀ P : E_sm, IsClosed ({P} : Set E_sm) →
      ∀ x : F, x ≠ 0 → (0 : WithTop ℤ) ≤ ord P x →
        ((0 : WithTop ℤ) ≤ ord P x⁻¹ ↔ ¬((1 : WithTop ℤ) ≤ ord P x)) := by
    intro P hP x hx_ne hx0
    cases h1 : ord P x with
    | top => exact absurd h1 (hOrd_ne_top P hP x hx_ne)
    | coe a =>
      cases h2 : ord P x⁻¹ with
      | top => exact absurd h2 (hOrd_ne_top P hP x⁻¹ (inv_ne_zero hx_ne))
      | coe b =>
        have hsum := hOrd_inv_sum P hP x hx_ne
        rw [h1] at hx0
        rw [h1, h2] at hsum
        change ((0 : ℤ) : WithTop ℤ) ≤ (a : WithTop ℤ) at hx0
        change (a : WithTop ℤ) + (b : WithTop ℤ) = ((0 : ℤ) : WithTop ℤ) at hsum
        rw [WithTop.coe_le_coe] at hx0
        rw [← WithTop.coe_add, WithTop.coe_eq_coe] at hsum
        change ((0 : ℤ) : WithTop ℤ) ≤ (b : WithTop ℤ) ↔
          ¬(((1 : ℤ) : WithTop ℤ) ≤ (a : WithTop ℤ))
        rw [WithTop.coe_le_coe, WithTop.coe_le_coe]
        omega
  have hOrd_unif_inv : ∀ P : E_sm, IsClosed ({P} : Set E_sm) →
      ∀ ϖ : F, ord P ϖ = (1 : WithTop ℤ) → ¬((0 : WithTop ℤ) ≤ ord P ϖ⁻¹) := by
    intro P hP ϖ hϖ
    have hϖ_ne : ϖ ≠ 0 := by
      intro h0
      rw [h0, hOrd_zero P hP] at hϖ
      exact WithTop.coe_ne_top hϖ.symm
    rw [hOrd_inv_nonneg_iff P hP ϖ hϖ_ne (by rw [hϖ]; exact WithTop.coe_le_coe.mpr (by omega))]
    rw [hϖ]
    exact not_not.mpr (le_refl _)
  
  let η₀ : E_sm := genericPoint ↥E_sm
  have hη₀_cl_univ : closure ({η₀} : Set E_sm) = Set.univ := (genericPoint_spec ↥E_sm).def
  have hη₀_not_cl : ¬IsClosed ({η₀} : Set E_sm) := by
    intro hcl
    have huniv : ({η₀} : Set E_sm) = Set.univ := by
      rw [← hcl.closure_eq, hη₀_cl_univ]
    have hfin : {P : E_sm | IsClosed ({P} : Set E_sm)}.Finite := by
      refine (Set.finite_singleton η₀).subset ?_
      intro P _
      rw [huniv]
      exact Set.mem_univ P
    exact hA1 hfin
  have hNotCl_eq_η₀ : ∀ z : E_sm, ¬IsClosed ({z} : Set E_sm) → z = η₀ := by
    intro z hz
    have hcl_univ : closure ({z} : Set E_sm) = Set.univ := by
      by_contra hne
      exact hz ((hA2 (closure ({z} : Set E_sm)) isClosed_closure hne).2 z
        (subset_closure (Set.mem_singleton z)))
    exact IsGenericPoint.eq hcl_univ (genericPoint_spec ↥E_sm)
  have hAffNbhd : ∀ (U : E_sm.Opens) (x : E_sm), x ∈ U →
      ∃ (W : E_sm.Opens) (_ : AlgebraicGeometry.IsAffineOpen W), x ∈ W ∧ W ≤ U := by
    intro U x hx
    rcases TopologicalSpace.Opens.isBasis_iff_nbhd.mp E_sm.isBasis_affineOpens hx with
      ⟨W, hW, hxW, hW_le⟩
    exact ⟨W, hW, hxW, hW_le⟩
  have hη₀_mem_open : ∀ V : E_sm.Opens, Nonempty ↥V → η₀ ∈ V := by
    intro V ⟨⟨x, hx⟩⟩
    by_contra hnot
    have hsub : (Set.univ : Set E_sm) ⊆ (V : Set E_sm)ᶜ := by
      rw [← hη₀_cl_univ]
      exact closure_minimal (Set.singleton_subset_iff.mpr hnot) V.isOpen.isClosed_compl
    exact hsub (Set.mem_univ x) hx
  have hSpec_basic : ∀ (W : E_sm.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
      (a : ↑(E_sm.presheaf.obj (Opposite.op W)))
      (p : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W))),
      hW.fromSpec.base p ∈ (E_sm.basicOpen a : Set E_sm) ↔ a ∉ p.asIdeal := by
    intro W hW a p
    exact (SetLike.ext_iff.mp (hW.fromSpec_preimage_basicOpen a) p).trans
      (PrimeSpectrum.mem_basicOpen a p)
  have hResCompat : ∀ (W' W : E_sm.Opens) (hW' : AlgebraicGeometry.IsAffineOpen W')
      (hW : AlgebraicGeometry.IsAffineOpen W) (hle : W' ≤ W)
      (φ' : E_sm.presheaf.obj (Opposite.op W') ⟶ CommRingCat.of F)
      (φ_W : E_sm.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
      AlgebraicGeometry.Spec.map φ' ≫ hW'.fromSpec = η_F →
      AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec = η_F →
      E_sm.presheaf.map (CategoryTheory.homOfLE hle).op ≫ φ' = φ_W := by
    intro W' W hW' hW hle φ' φ_W hφ' hφ_W
    apply AlgebraicGeometry.Spec.map_injective
    rw [← cancel_mono hW.fromSpec, AlgebraicGeometry.Spec.map_comp, Category.assoc,
      hW.map_fromSpec hW' (CategoryTheory.homOfLE hle).op, hφ', hφ_W]
  
  have hMaxNeBotB : ∀ 𝔪 : Ideal ↥B, 𝔪.IsMaximal → 𝔪 ≠ ⊥ := by
    intro 𝔪 h𝔪 hbot
    apply hNotFieldB
    refine ⟨⟨0, 1, zero_ne_one⟩, mul_comm, ?_⟩
    intro a ha
    have ha_not : a ∉ 𝔪 := by
      rw [hbot, Ideal.mem_bot]
      exact ha
    have hlt : 𝔪 < 𝔪 ⊔ Ideal.span ({a} : Set ↥B) := by
      refine lt_of_le_of_ne le_sup_left ?_
      intro heq
      apply ha_not
      rw [heq]
      exact Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton a))
    have htop : 𝔪 ⊔ Ideal.span ({a} : Set ↥B) = ⊤ := by
      by_contra hne_top
      exact ne_of_lt hlt (h𝔪.eq_of_le hne_top le_sup_left)
    rw [hbot, bot_sup_eq] at htop
    have h1 : (1 : ↥B) ∈ Ideal.span ({a} : Set ↥B) := by rw [htop]; trivial
    rcases Ideal.mem_span_singleton.mp h1 with ⟨b, hb⟩
    exact ⟨b, hb.symm⟩
  have hMakeVal : ∀ (𝔪 : Ideal ↥B), 𝔪.IsMaximal →
      ∃ (V : ValuationSubring F),
        IsLocalRing.maximalIdeal ↥V ≠ ⊥ ∧
        (∀ c : Ω, algebraMap Ω F c ∈ V) ∧
        (∀ w : F, w ∈ V ↔ ∃ (a s : ↥B), s ∉ 𝔪 ∧ (s : F) * w = (a : F)) ∧
        (∀ (b : ↥B) (hb : (b : F) ∈ V),
          (⟨(b : F), hb⟩ : ↥V) ∈ IsLocalRing.maximalIdeal ↥V ↔ b ∈ 𝔪) := by
    intro 𝔪 h𝔪
    have : 𝔪.IsMaximal := h𝔪
    have : 𝔪.IsPrime := h𝔪.isPrime
    have hne : 𝔪 ≠ ⊥ := hMaxNeBotB 𝔪 h𝔪
    let hS : 𝔪.primeCompl ≤ nonZeroDivisors ↥B := Ideal.primeCompl_le_nonZeroDivisors 𝔪
    let R_sub : Subalgebra ↥B F := Localization.subalgebra.ofField F 𝔪.primeCompl hS
    have : IsLocalization 𝔪.primeCompl ↥R_sub :=
      Localization.subalgebra.isLocalization_ofField F 𝔪.primeCompl hS
    have : IsFractionRing ↥R_sub F :=
      Localization.subalgebra.isFractionRing_ofField F 𝔪.primeCompl hS
    have : IsDiscreteValuationRing ↥R_sub :=
      IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain ↥B hne ↥R_sub
    have h_or : ∀ x : F, x ∈ R_sub.toSubring ∨ x⁻¹ ∈ R_sub.toSubring := by
      intro x
      obtain ⟨u, v, hv, hdiv⟩ := IsFractionRing.div_surjective (A := ↥R_sub) x
      change (u : F) / (v : F) = x at hdiv
      have hv_ne : (v : F) ≠ 0 := by
        have hv0 : v ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hv
        exact fun h => hv0 (Subtype.ext h)
      rcases (ValuationRing.iff_dvd_total.mp (inferInstance : ValuationRing ↥R_sub)).total v u with
        ⟨q, hq⟩ | ⟨q, hq⟩
      · left
        have hx_eq : x = (q : F) := by
          rw [← hdiv, hq]
          change ((v : F) * (q : F)) / (v : F) = (q : F)
          exact mul_div_cancel_left₀ (q : F) hv_ne
        rw [hx_eq]
        exact q.2
      · by_cases hu0 : (u : F) = 0
        · left
          have hx0 : x = 0 := by rw [← hdiv, hu0, zero_div]
          rw [hx0]
          exact R_sub.toSubring.zero_mem
        · right
          have hxinv : x⁻¹ = (q : F) := by
            rw [← hdiv, inv_div, hq]
            change ((u : F) * (q : F)) / (u : F) = (q : F)
            exact mul_div_cancel_left₀ (q : F) hu0
          rw [hxinv]
          exact q.2
    let V : ValuationSubring F := ValuationSubring.ofSubring R_sub.toSubring h_or
    refine ⟨V, ?_, ?_, ?_, ?_⟩
    · intro hbot
      change IsLocalRing.maximalIdeal ↥R_sub = ⊥ at hbot
      obtain ⟨m₀, hm₀_mem, hm₀_ne⟩ := (Submodule.ne_bot_iff 𝔪).mp hne
      have hm_max : algebraMap ↥B ↥R_sub m₀ ∈ IsLocalRing.maximalIdeal ↥R_sub :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff ↥R_sub 𝔪 m₀).mpr hm₀_mem
      rw [hbot, Ideal.mem_bot] at hm_max
      apply hm₀_ne
      have hm_val : (m₀ : F) = 0 := congrArg (Subtype.val : ↥R_sub → F) hm_max
      exact Subtype.ext hm_val
    · intro c
      exact (algebraMap ↥B ↥R_sub ⟨algebraMap Ω F c, hΩ_B c⟩).2
    · intro w
      constructor
      · intro hw
        obtain ⟨⟨a, s⟩, hsurj⟩ := IsLocalization.surj 𝔪.primeCompl (⟨w, hw⟩ : ↥R_sub)
        refine ⟨a, s.1, s.2, ?_⟩
        have hval := congrArg Subtype.val hsurj
        change w * (s.1 : F) = (a : F) at hval
        rwa [mul_comm] at hval
      · rintro ⟨a, s, hs, hsw⟩
        have hs0 : (s : F) ≠ 0 := by
          intro h0
          apply hs
          have h_eq : s = 0 := Subtype.ext h0
          rw [h_eq]
          exact 𝔪.zero_mem
        let s_sub : 𝔪.primeCompl := ⟨s, hs⟩
        let q : ↥R_sub := IsLocalization.mk' ↥R_sub a s_sub
        have hspec := congrArg Subtype.val (IsLocalization.mk'_spec' ↥R_sub a s_sub)
        change (s : F) * (q : F) = (a : F) at hspec
        have hw_eq : w = (q : F) := mul_left_cancel₀ hs0 (hsw.trans hspec.symm)
        rw [hw_eq]
        exact q.2
    · intro b hb
      exact IsLocalization.AtPrime.to_map_mem_maximal_iff ↥R_sub 𝔪 b
  have hDVR_max : ∀ P : E_sm, IsClosed ({P} : Set E_sm) → (0 : WithTop ℤ) ≤ ord P f →
      ∃ (𝔪 : Ideal ↥B),
        𝔪.IsMaximal ∧
        (∀ b : ↥B, b ∈ 𝔪 ↔ (1 : WithTop ℤ) ≤ ord P (b : F)) ∧
        (∀ w : F, (0 : WithTop ℤ) ≤ ord P w ↔ ∃ (a s : ↥B), s ∉ 𝔪 ∧ (s : F) * w = (a : F)) := by
    intro P hP hPf
    let 𝔪 : Ideal ↥B :=
      { carrier := {b : ↥B | (1 : WithTop ℤ) ≤ ord P (b : F)}
        zero_mem' := by
          change (1 : WithTop ℤ) ≤ ord P 0
          rw [hOrd_zero P hP]
          exact le_top
        add_mem' := by
          intro a b ha hb
          exact le_trans (le_min ha hb) ((hVal P hP).2.2.1 (a : F) (b : F))
        smul_mem' := by
          intro r b hb
          change (1 : WithTop ℤ) ≤ ord P ((r : F) * (b : F))
          rw [(hVal P hP).2.1]
          have hr : (0 : WithTop ℤ) ≤ ord P (r : F) := hB_ord r.1 r.2 P hP hPf
          simpa using add_le_add hr hb }
    have h𝔪_iff : ∀ b : ↥B, b ∈ 𝔪 ↔ (1 : WithTop ℤ) ≤ ord P (b : F) := fun _ => Iff.rfl
    have h𝔪_prime : 𝔪.IsPrime := by
      refine ⟨?_, ?_⟩
      · intro htop
        have h1 : (1 : ↥B) ∈ 𝔪 := by rw [htop]; trivial
        rw [h𝔪_iff, Subring.coe_one, hOrd_one P hP] at h1
        exact absurd h1 (by decide)
      · intro a b hab
        by_contra hnot
        push Not at hnot
        rcases hnot with ⟨ha, hb⟩
        rw [h𝔪_iff] at ha hb hab
        have ha0 := (hOrd_unit P hP (a : F) (hB_ord a.1 a.2 P hP hPf) ha).2.1
        have hb0 := (hOrd_unit P hP (b : F) (hB_ord b.1 b.2 P hP hPf) hb).2.1
        change (1 : WithTop ℤ) ≤ ord P ((a : F) * (b : F)) at hab
        rw [(hVal P hP).2.1, ha0, hb0, zero_add] at hab
        exact absurd hab (by decide)
    have h𝔪_ne_bot : 𝔪 ≠ ⊥ := by
      obtain ⟨c₀, hc₀⟩ := (hVal P hP).2.2.2.2.2 f hPf
      let b₀ : ↥B := ⟨f - algebraMap Ω F c₀, B.sub_mem hf_B (hΩ_B c₀)⟩
      have hb₀_mem : b₀ ∈ 𝔪 := hc₀
      intro hbot
      rw [hbot, Ideal.mem_bot] at hb₀_mem
      have hfeq : f - algebraMap Ω F c₀ = 0 := congrArg Subtype.val hb₀_mem
      have hinj := transcendental_iff_injective.mp hf_tr
      have hpoly : Polynomial.aeval f (Polynomial.X - Polynomial.C c₀ : Polynomial Ω) =
          Polynomial.aeval f (0 : Polynomial Ω) := by
        simp [hfeq]
      exact Polynomial.X_sub_C_ne_zero c₀ (hinj hpoly)
    have : 𝔪.IsPrime := h𝔪_prime
    have h𝔪_max : 𝔪.IsMaximal := Ring.DimensionLEOne.maximalOfPrime h𝔪_ne_bot h𝔪_prime
    have : 𝔪.IsMaximal := h𝔪_max
    refine ⟨𝔪, h𝔪_max, h𝔪_iff, ?_⟩
    have hFrac_to_ord : ∀ w : F, (∃ a s : ↥B, s ∉ 𝔪 ∧ (s : F) * w = (a : F)) →
        (0 : WithTop ℤ) ≤ ord P w := by
      rintro w ⟨a, s, hs, hsw⟩
      have hs0 := (hOrd_unit P hP (s : F) (hB_ord s.1 s.2 P hP hPf)
        (fun h => hs ((h𝔪_iff s).mpr h))).2.1
      have ha0 : (0 : WithTop ℤ) ≤ ord P (a : F) := hB_ord a.1 a.2 P hP hPf
      have hmul : ord P ((s : F) * w) = ord P w := by
        rw [(hVal P hP).2.1, hs0, zero_add]
      rwa [← hsw, hmul] at ha0
    let hS : 𝔪.primeCompl ≤ nonZeroDivisors ↥B := Ideal.primeCompl_le_nonZeroDivisors 𝔪
    let R_sub : Subalgebra ↥B F := Localization.subalgebra.ofField F 𝔪.primeCompl hS
    have : IsLocalization 𝔪.primeCompl ↥R_sub :=
      Localization.subalgebra.isLocalization_ofField F 𝔪.primeCompl hS
    have : IsFractionRing ↥R_sub F :=
      Localization.subalgebra.isFractionRing_ofField F 𝔪.primeCompl hS
    have : IsDiscreteValuationRing ↥R_sub :=
      IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain ↥B h𝔪_ne_bot ↥R_sub
    have hR_to_frac : ∀ r : ↥R_sub, ∃ a s : ↥B, s ∉ 𝔪 ∧ (s : F) * (r : F) = (a : F) := by
      intro r
      obtain ⟨⟨a, s⟩, hsurj⟩ := IsLocalization.surj 𝔪.primeCompl r
      refine ⟨a, s.1, s.2, ?_⟩
      have hval := congrArg Subtype.val hsurj
      change (r : F) * (s.1 : F) = (a : F) at hval
      rwa [mul_comm] at hval
    have hR_ord : ∀ r : ↥R_sub, (0 : WithTop ℤ) ≤ ord P (r : F) :=
      fun r => hFrac_to_ord (r : F) (hR_to_frac r)
    obtain ⟨V, _, _, hV_frac, _⟩ := hMakeVal 𝔪 h𝔪_max
    have hVR_iff : ∀ w : F, w ∈ V ↔ w ∈ R_sub.toSubring := by
      intro w
      rw [hV_frac]
      constructor
      · rintro ⟨a, s, hs, hsw⟩
        have hs0 : (s : F) ≠ 0 := by
          intro h0
          apply hs
          have h_eq : s = 0 := Subtype.ext h0
          rw [h_eq]
          exact 𝔪.zero_mem
        let s_sub : 𝔪.primeCompl := ⟨s, hs⟩
        let q : ↥R_sub := IsLocalization.mk' ↥R_sub a s_sub
        have hspec := congrArg Subtype.val (IsLocalization.mk'_spec' ↥R_sub a s_sub)
        change (s : F) * (q : F) = (a : F) at hspec
        have hw_eq : w = (q : F) := mul_left_cancel₀ hs0 (hsw.trans hspec.symm)
        rw [hw_eq]
        exact q.2
      · intro hw
        exact hR_to_frac ⟨w, hw⟩
    intro w
    constructor
    · intro hw_ord
      rw [← hV_frac]
      by_contra hw_not_V
      have hw_ne : w ≠ 0 := by
        intro h0
        rw [h0] at hw_not_V
        exact hw_not_V V.zero_mem
      have hwinv_V : w⁻¹ ∈ V := (V.mem_or_inv_mem w).resolve_left hw_not_V
      have hwinv_R : w⁻¹ ∈ R_sub.toSubring := (hVR_iff w⁻¹).mp hwinv_V
      let u₀ : ↥R_sub := ⟨w⁻¹, hwinv_R⟩
      have hu₀_ne : u₀ ≠ 0 := fun h => inv_ne_zero hw_ne (congrArg Subtype.val h)
      have hu₀_not_unit : ¬IsUnit u₀ := by
        rintro ⟨e, he⟩
        apply hw_not_V
        rw [hVR_iff]
        have hmul : w⁻¹ * ((↑(e⁻¹) : ↥R_sub) : F) = 1 := by
          have h1 : u₀ * ↑(e⁻¹) = 1 := by rw [← he, Units.mul_inv]
          exact congrArg Subtype.val h1
        have hw_eq : w = ((↑(e⁻¹) : ↥R_sub) : F) := by
          calc w = w * (w⁻¹ * ((↑(e⁻¹) : ↥R_sub) : F)) := by rw [hmul, mul_one]
            _ = (w * w⁻¹) * ((↑(e⁻¹) : ↥R_sub) : F) := by ring
            _ = ((↑(e⁻¹) : ↥R_sub) : F) := by rw [mul_inv_cancel₀ hw_ne, one_mul]
        rw [hw_eq]
        exact (↑(e⁻¹) : ↥R_sub).2
      obtain ⟨π₀, hπ₀_irr⟩ := IsDiscreteValuationRing.exists_irreducible ↥R_sub
      obtain ⟨n, e₀, he₀⟩ := IsDiscreteValuationRing.associated_pow_irreducible hu₀_ne hπ₀_irr
      have hn_ne : n ≠ 0 := by
        intro hn0
        subst hn0
        rw [pow_zero] at he₀
        exact hu₀_not_unit (isUnit_iff_exists_inv.mpr ⟨↑e₀, he₀⟩)
      obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn_ne
      have hu₀_eq : u₀ = π₀ * (π₀ ^ k * ↑(e₀⁻¹)) := by
        calc u₀ = (u₀ * ↑e₀) * ↑(e₀⁻¹) := by simp
          _ = π₀ ^ (k + 1) * ↑(e₀⁻¹) := by rw [he₀]
          _ = π₀ * (π₀ ^ k * ↑(e₀⁻¹)) := by rw [pow_succ']; ring
      have hπ₀F_ne : (π₀ : F) ≠ 0 := fun h => hπ₀_irr.ne_zero (Subtype.ext h)
      have hπ₀_inv_eq : (π₀ : F)⁻¹ = w * ((π₀ ^ k * ↑(e₀⁻¹) : ↥R_sub) : F) := by
        apply inv_eq_of_mul_eq_one_right
        have hu_val : w⁻¹ = (π₀ : F) * ((π₀ ^ k * ↑(e₀⁻¹) : ↥R_sub) : F) :=
          congrArg Subtype.val hu₀_eq
        calc (π₀ : F) * (w * ((π₀ ^ k * ↑(e₀⁻¹) : ↥R_sub) : F))
            = w * ((π₀ : F) * ((π₀ ^ k * ↑(e₀⁻¹) : ↥R_sub) : F)) := by ring
          _ = w * w⁻¹ := by rw [← hu_val]
          _ = 1 := mul_inv_cancel₀ hw_ne
      have hπ₀_inv_ord : (0 : WithTop ℤ) ≤ ord P (π₀ : F)⁻¹ := by
        rw [hπ₀_inv_eq, (hVal P hP).2.1]
        simpa using add_le_add hw_ord (hR_ord (π₀ ^ k * ↑(e₀⁻¹)))
      have hπ₀_pow_ord : ∀ m : ℕ, (0 : WithTop ℤ) ≤ ord P (((π₀ : F)⁻¹) ^ m) := by
        intro m
        induction m with
        | zero =>
          rw [pow_zero, hOrd_one P hP]
        | succ m ih =>
          rw [pow_succ, (hVal P hP).2.1]
          simpa using add_le_add ih hπ₀_inv_ord
      obtain ⟨ϖ, hϖ⟩ := (hVal P hP).2.2.2.2.1
      obtain ⟨x, y, hy, hdiv⟩ := IsFractionRing.div_surjective (A := ↥R_sub) ϖ⁻¹
      change (x : F) / (y : F) = ϖ⁻¹ at hdiv
      have hy_ne : y ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hy
      have hyF_ne : (y : F) ≠ 0 := fun h => hy_ne (Subtype.ext h)
      obtain ⟨m, e_y, hey⟩ := IsDiscreteValuationRing.associated_pow_irreducible hy_ne hπ₀_irr
      have hey_val : (y : F) * ((↑e_y : ↥R_sub) : F) = (π₀ : F) ^ m :=
        congrArg Subtype.val hey
      have hπ_cancel : (π₀ : F) ^ m * ((π₀ : F)⁻¹) ^ m = 1 := by
        rw [← mul_pow, mul_inv_cancel₀ hπ₀F_ne, one_pow]
      have hϖ_inv_eq : ϖ⁻¹ = ((x * ↑e_y : ↥R_sub) : F) * (((π₀ : F)⁻¹) ^ m) := by
        calc ϖ⁻¹
            = ((x : F) / (y : F)) * ((π₀ : F) ^ m * (((π₀ : F)⁻¹) ^ m)) := by
              rw [hdiv, hπ_cancel, mul_one]
          _ = ((x : F) / (y : F)) * (((y : F) * ((↑e_y : ↥R_sub) : F)) * (((π₀ : F)⁻¹) ^ m)) := by
              rw [hey_val]
          _ = (((y : F) * (x : F)) / (y : F)) * ((↑e_y : ↥R_sub) : F) * (((π₀ : F)⁻¹) ^ m) := by
              ring
          _ = ((x * ↑e_y : ↥R_sub) : F) * (((π₀ : F)⁻¹) ^ m) := by
              rw [mul_div_cancel_left₀ (x : F) hyF_ne]
              rfl
      have hϖ_inv_ord : (0 : WithTop ℤ) ≤ ord P ϖ⁻¹ := by
        rw [hϖ_inv_eq, (hVal P hP).2.1]
        simpa using add_le_add (hR_ord (x * ↑e_y)) (hπ₀_pow_ord m)
      exact hOrd_unif_inv P hP ϖ hϖ hϖ_inv_ord
    · exact hFrac_to_ord w
  
  have hValCenter : ∀ (V : ValuationSubring F),
      IsLocalRing.maximalIdeal ↥V ≠ ⊥ →
      (∀ c : Ω, algebraMap Ω F c ∈ V) →
      (∃ P : E_sm, IsClosed ({P} : Set E_sm) ∧
        (∀ w : F, w ∈ V ↔ (0 : WithTop ℤ) ≤ ord P w) ∧
        (∀ v : ↥V, v ∈ IsLocalRing.maximalIdeal ↥V ↔ (1 : WithTop ℤ) ≤ ord P (v : F))) ∧
      (∀ P Q : E_sm, IsClosed ({P} : Set E_sm) → IsClosed ({Q} : Set E_sm) →
        (∀ w : F, w ∈ V ↔ (0 : WithTop ℤ) ≤ ord P w) →
        (∀ w : F, w ∈ V ↔ (0 : WithTop ℤ) ≤ ord Q w) → P = Q) := by
    intro V hMaxNeBot hΩ_V
    let j_ΩV : Ω →+* ↥V := (algebraMap Ω F).codRestrict V.toSubring hΩ_V
    let i₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V F))
    let i₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_ΩV)
    have hcomm : η_F ≫ p_sm = i₁ ≫ i₂ := by
      rw [hη_comm, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    let sq : AlgebraicGeometry.ValuativeCommSq p_sm :=
      AlgebraicGeometry.ValuativeCommSq.mk ↥V F η_F i₂ ⟨hcomm⟩
    have hUC : AlgebraicGeometry.UniversallyClosed p_sm := inferInstance
    rw [AlgebraicGeometry.universallyClosed_eq_universallySpecializing,
      ← AlgebraicGeometry.ValuativeCriterion.Existence.eq] at hUC
    have hUniq : AlgebraicGeometry.ValuativeCriterion.Uniqueness p_sm :=
      AlgebraicGeometry.IsSeparated.valuativeCriterion p_sm
    obtain ⟨⟨γ, hγ_η, hγ_p⟩⟩ := (hUC.1 sq).exists_lift
    have hγ_uniq : ∀ γ' : AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ E_sm,
        i₁ ≫ γ' = η_F → γ' ≫ p_sm = i₂ → γ' = γ := by
      intro γ' h1' h2'
      have hSub : Subsingleton sq.commSq.LiftStruct := hUniq sq
      exact congrArg CategoryTheory.CommSq.LiftStruct.l
        (Subsingleton.elim ⟨γ', h1', h2'⟩ ⟨γ, hγ_η, hγ_p⟩)
    let q_max : PrimeSpectrum ↥V :=
      ⟨IsLocalRing.maximalIdeal ↥V, (IsLocalRing.maximalIdeal.isMaximal ↥V).isPrime⟩
    let P : E_sm := γ.base q_max
    have hLocLift : ∀ (W : E_sm.Opens) (hW : AlgebraicGeometry.IsAffineOpen W),
        P ∈ W →
        ∃ (τ_W : ↑(E_sm.presheaf.obj (Opposite.op W)) →+* ↥V),
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_W) ≫ hW.fromSpec = γ ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap ↥V F).comp τ_W)) ≫
            hW.fromSpec = η_F ∧
          hW.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_W)).base q_max) = P := by
      intro W hW hPW
      have hRange : Set.range γ.base ⊆ Set.range hW.fromSpec.base := by
        rw [hW.range_fromSpec]
        rintro _ ⟨q, rfl⟩
        by_contra hq_not
        have hle : q.asIdeal ≤ q_max.asIdeal := IsLocalRing.le_maximalIdeal q.isPrime.ne_top
        have hqmax_cl : q_max ∈ closure ({q} : Set (PrimeSpectrum ↥V)) :=
          (PrimeSpectrum.le_iff_mem_closure q q_max).mp hle
        have hClPre : IsClosed (γ.base ⁻¹' ((W : Set E_sm)ᶜ)) :=
          W.isOpen.isClosed_compl.preimage γ.continuous
        have hSubCl : closure ({q} : Set (PrimeSpectrum ↥V)) ⊆ γ.base ⁻¹' ((W : Set E_sm)ᶜ) :=
          closure_minimal (Set.singleton_subset_iff.mpr hq_not) hClPre
        exact hSubCl hqmax_cl hPW
      let g_W := AlgebraicGeometry.IsOpenImmersion.lift hW.fromSpec γ hRange
      have hg_W : g_W ≫ hW.fromSpec = γ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hW.fromSpec γ hRange
      let τ_W : ↑(E_sm.presheaf.obj (Opposite.op W)) →+* ↥V :=
        (AlgebraicGeometry.Spec.preimage g_W).hom
      have hSpec_τ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_W) = g_W :=
        AlgebraicGeometry.Spec.map_preimage g_W
      refine ⟨τ_W, by rw [hSpec_τ, hg_W], ?_, ?_⟩
      · have hcomp_τ : CommRingCat.ofHom ((algebraMap ↥V F).comp τ_W) =
            CommRingCat.ofHom τ_W ≫ CommRingCat.ofHom (algebraMap ↥V F) := rfl
        rw [hcomp_τ, AlgebraicGeometry.Spec.map_comp, Category.assoc, hSpec_τ, hg_W, hγ_η]
      · change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_W) ≫ hW.fromSpec).base q_max = P
        rw [hSpec_τ, hg_W]
    have hP_cl : IsClosed ({P} : Set E_sm) := by
      obtain ⟨W₀, hW₀, hPW₀, _⟩ := hAffNbhd ⊤ P trivial
      obtain ⟨τ₀, _, hφ₀, hp₀⟩ := hLocLift W₀ hW₀ hPW₀
      let φ₀ : E_sm.presheaf.obj (Opposite.op W₀) ⟶ CommRingCat.of F :=
        CommRingCat.ofHom ((algebraMap ↥V F).comp τ₀)
      obtain ⟨φ'₀, hFrac'₀, hφ'₀⟩ := hFunc W₀ hW₀ ⟨⟨P, hPW₀⟩⟩
      have hφ_eq : φ'₀ = φ₀ := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [← cancel_mono hW₀.fromSpec, hφ'₀, hφ₀]
      rw [hφ_eq] at hFrac'₀
      let _ : Algebra ↑(E_sm.presheaf.obj (Opposite.op W₀)) F := φ₀.hom.toAlgebra
      have : IsFractionRing ↑(E_sm.presheaf.obj (Opposite.op W₀)) F := hFrac'₀
      obtain ⟨v₀, hv₀_mem, hv₀_ne⟩ :=
        (Submodule.ne_bot_iff (IsLocalRing.maximalIdeal ↥V)).mp hMaxNeBot
      have hv₀F_ne : (v₀ : F) ≠ 0 := fun h => hv₀_ne (Subtype.ext h)
      obtain ⟨a, s, _, hdiv⟩ :=
        IsFractionRing.div_surjective (A := ↑(E_sm.presheaf.obj (Opposite.op W₀))) (v₀ : F)
      change φ₀.hom a / φ₀.hom s = (v₀ : F) at hdiv
      have hφa_ne : φ₀.hom a ≠ 0 := by
        intro h0
        rw [h0, zero_div] at hdiv
        exact hv₀F_ne hdiv.symm
      have hφs_ne : φ₀.hom s ≠ 0 := by
        intro h0
        rw [h0, div_zero] at hdiv
        exact hv₀F_ne hdiv.symm
      have hφ_mul : φ₀.hom a = (v₀ : F) * φ₀.hom s := (div_eq_iff hφs_ne).mp hdiv
      have hτ_mul : τ₀ a = v₀ * τ₀ s := Subtype.ext hφ_mul
      let p₀ := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀)).base q_max
      have ha_p₀ : a ∈ p₀.asIdeal := by
        change τ₀ a ∈ q_max.asIdeal
        rw [hτ_mul]
        exact Ideal.mul_mem_right _ _ hv₀_mem
      let S : Set E_sm := (E_sm.basicOpen a : Set E_sm)ᶜ
      have hS_cl : IsClosed S := (E_sm.basicOpen a).isOpen.isClosed_compl
      have hP_in_S : P ∈ S := by
        intro hP_bas
        rw [← hp₀, hSpec_basic W₀ hW₀ a p₀] at hP_bas
        exact hP_bas ha_p₀
      have hS_ne : S ≠ Set.univ := by
        intro huniv
        let q_ker : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W₀)) :=
          ⟨RingHom.ker φ₀.hom, RingHom.ker_isPrime φ₀.hom⟩
        have hq_bas : hW₀.fromSpec.base q_ker ∈ (E_sm.basicOpen a : Set E_sm) :=
          (hSpec_basic W₀ hW₀ a q_ker).mpr hφa_ne
        have hq_S : hW₀.fromSpec.base q_ker ∈ S := by
          rw [huniv]
          exact Set.mem_univ _
        exact hq_S hq_bas
      exact (hA2 S hS_cl hS_ne).2 P hP_in_S
    have hAvoidChart : ∀ g : F, g ≠ 0 →
        ∃ (W : E_sm.Opens) (_ : AlgebraicGeometry.IsAffineOpen W),
          P ∈ W ∧ ∀ Q : E_sm, Q ∈ W → IsClosed ({Q} : Set E_sm) → Q ≠ P →
            ord Q g = (0 : WithTop ℤ) := by
      intro g hg
      let Z_g : Set E_sm := {Q : E_sm | Q ≠ P ∧ IsClosed ({Q} : Set E_sm) ∧ ord Q g ≠ 0}
      have hZg_fin : Z_g.Finite := (hPrinFin g hg).subset fun Q hQ => hQ.2
      have hZg_eq : Z_g = ⋃ Q ∈ Z_g, ({Q} : Set E_sm) := by
        ext x
        simp
      have hZg_cl : IsClosed Z_g := by
        rw [hZg_eq]
        exact hZg_fin.isClosed_biUnion fun Q hQ => hQ.2.1
