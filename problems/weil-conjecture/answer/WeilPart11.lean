                    e₂_L j b =
                      ((CategoryTheory.Limits.pullback g₂ η_L).presheaf.map
                        (CategoryTheory.homOfLE (le_of_eq (hV₂_w b))).op).hom
                        ((w₂.app _).hom (e₂' j ((eIdx₂_L.trans eIdx₂'.symm) b)))) →
                  ∃ M' : Matrix.GeneralLinearGroup (Fin (r₁ + 1)) R',
