          change Submodule.Quotient.mk (i_ker (p + 1) ⟨y₁, hy₁_ker⟩) = Submodule.Quotient.mk z₂
          rw [Submodule.Quotient.eq]
          refine ⟨-b₂, ?_⟩
          rw [map_neg]
          change -(d_lin F₂ p b₂) = i_c (p + 1) y₁ - z₂.1
          rw [hy₁]
