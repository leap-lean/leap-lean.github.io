        have hz_univ : z ∈ (Set.univ : Set C) := Set.mem_univ z
        rw [← M.hCov, Set.mem_iUnion] at hz_univ
        obtain ⟨a, hz_a⟩ := hz_univ
        let W_αa : (E_norm α).Opens := (TopologicalSpace.Opens.map (ν α).base).obj (M.V a)
