        (hle : AlgebraicGeometry.Proj.basicOpen 𝒜₀ x ≤ AlgebraicGeometry.Proj.basicOpen 𝒜₀ f)
        (z : HomogeneousLocalization.Away 𝒜₀ f),
        (P₀.presheaf.map (CategoryTheory.homOfLE hle).op).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜₀ f).hom z) =
        (AlgebraicGeometry.Proj.awayToSection 𝒜₀ x).hom
          (HomogeneousLocalization.awayMap 𝒜₀ hg hx z) := by
      intro f m' g hg x hx hle z
      have hcomm := congrArg (fun φ => φ.hom z)
        (AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜₀ hg hx).symm
      rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
        RingHom.comp_apply, RingHom.comp_apply] at hcomm
      exact hcomm
    have isoToEquiv_apply : ∀ {R S : CommRingCat.{u}} (i : R ≅ S) (x : R),
        i.commRingCatIsoToRingEquiv x = i.hom.hom x :=
      fun _ _ => rfl
    have isLoc_transport : ∀ {R₀ S₀ R' S' : Type u} [CommRing R₀] [CommRing S₀] [Algebra R₀ S₀]
        (z : R₀) [IsLocalization.Away z S₀] [CommRing R'] [CommRing S']
        (e₁ : R₀ ≃+* R') (e₂ : S₀ ≃+* S') (ρ : R' →+* S'),
        (∀ r : R₀, ρ (e₁ r) = e₂ (algebraMap R₀ S₀ r)) →
        @IsLocalization.Away R' _ (e₁ z) S' _ ρ.toAlgebra := by
      intro R₀ S₀ R' S' _ _ _ z _ _ _ e₁ e₂ ρ hcomm
      let _ : Algebra R' S' := ρ.toAlgebra
      have halg : ∀ r : R₀, algebraMap R' S' (e₁ r) = e₂ (algebraMap R₀ S₀ r) := hcomm
      refine
        { map_units := ?_
          surj := ?_
          exists_of_eq := ?_ }
      · rintro ⟨_, n, rfl⟩
        change IsUnit (algebraMap R' S' ((e₁ z) ^ n))
        rw [← map_pow, halg (z ^ n)]
        exact (IsLocalization.map_units S₀ (⟨z ^ n, n, rfl⟩ : Submonoid.powers z)).map e₂.toMonoidHom
      · intro s'
        obtain ⟨⟨x₀, ⟨_, n, rfl⟩⟩, hx₀⟩ := IsLocalization.surj (Submonoid.powers z) (e₂.symm s')
        refine ⟨⟨e₁ x₀, ⟨(e₁ z) ^ n, n, rfl⟩⟩, ?_⟩
        change s' * algebraMap R' S' ((e₁ z) ^ n) = algebraMap R' S' (e₁ x₀)
        rw [← map_pow, halg (z ^ n), halg x₀]
        have hmul := congrArg e₂ hx₀
        rw [map_mul, e₂.apply_symm_apply] at hmul
        exact hmul
      · intro r₁ r₂ h_eq
        have h_eq₀ : algebraMap R₀ S₀ (e₁.symm r₁) = algebraMap R₀ S₀ (e₁.symm r₂) := by
          apply e₂.injective
          rw [← halg, ← halg, e₁.apply_symm_apply, e₁.apply_symm_apply]
