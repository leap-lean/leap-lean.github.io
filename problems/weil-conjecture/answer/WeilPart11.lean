  let ker_res_q : ∀ {U W : Z.Opens} (h : W ≤ U) (q : ℕ), ↥(Kq_sub U q) →+ ↥(Kq_sub W q) :=
    fun {U W} h q =>
      { toFun := fun z => ⟨E_res h (q + 1) z.1, by
          change dv_sec W (q + 1) (E_res h (q + 1) z.1) = 0
          rw [hE_res_dv h (q + 1) z.1]
          have hz0 : dv_sec U (q + 1) z.1 = 0 := z.2
          rw [hz0, map_zero]⟩
        map_zero' := Subtype.ext (map_zero (E_res h (q + 1)))
        map_add' := fun z₁ z₂ => Subtype.ext (map_add (E_res h (q + 1)) z₁.1 z₂.1) }
  let Rsucc_vert : ℕ → WeilPresheafModule Z := fun q =>
    { sec := fun U =>
        letI := instModE U (q + 1)
        ↥(Kq_sub U q) ⧸ Bq_sub U q
