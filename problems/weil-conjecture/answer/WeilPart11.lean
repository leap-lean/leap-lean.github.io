        S.presheaf.map (CategoryTheory.homOfLE h₂).op).hom x = _
    rw [← S.presheaf.map_comp, hComp]
  have hMapComm : ∀ (S : AlgebraicGeometry.Scheme.{u}) {U₀ V₀ V₁ T₀ : S.Opens}
      (h₁ : V₀ ≤ U₀) (h₂ : T₀ ≤ V₀) (h₁' : V₁ ≤ U₀) (h₂' : T₀ ≤ V₁)
      (x : ↑(S.presheaf.obj (Opposite.op U₀))),
      (S.presheaf.map (CategoryTheory.homOfLE h₂).op).hom
        ((S.presheaf.map (CategoryTheory.homOfLE h₁).op).hom x) =
      (S.presheaf.map (CategoryTheory.homOfLE h₂').op).hom
        ((S.presheaf.map (CategoryTheory.homOfLE h₁').op).hom x) := by
    intro S U₀ V₀ V₁ T₀ h₁ h₂ h₁' h₂' x
    exact (hMapComp S h₁ h₂ (le_trans h₂ h₁) x).trans
      (hMapComp S h₁' h₂' (le_trans h₂ h₁) x).symm
  let O_Z : WeilPresheafModule Z :=
    { sec := fun U => ↑(Z.presheaf.obj (Opposite.op U))
      instAddCommGroup := fun _ => inferInstance
      instModule := fun _ => inferInstance
      res := fun h => (Z.presheaf.map (CategoryTheory.homOfLE h).op).hom.toAddMonoidHom
      res_smul := fun h a x => map_mul (Z.presheaf.map (CategoryTheory.homOfLE h).op).hom a x
      res_id := fun U x => hMapId Z U (le_refl U) x
      res_comp := fun h₁ h₂ x => hMapComp Z h₁ h₂ (le_trans h₂ h₁) x }
  let E_sec : Z.Opens → ℕ → Type u := fun U q =>
    ∀ β : WeilStrictMonoTuple (N + 1) q,
      ↑(Z'.presheaf.obj (Opposite.op
        ((TopologicalSpace.Opens.map π.base).obj U ⊓ weilCoverChartInter Z'_std β)))
  let dv_sec : ∀ (U : Z.Opens) (q : ℕ), E_sec U q → E_sec U (q + 1) :=
    fun U q c γ =>
      let face : Fin (q + 2) → WeilStrictMonoTuple (N + 1) q :=
        fun j => ⟨fun k => γ.1 (j.succAbove k), γ.2.comp (Fin.strictMono_succAbove j)⟩
      let hFace : ∀ j : Fin (q + 2),
          (TopologicalSpace.Opens.map π.base).obj U ⊓ weilCoverChartInter Z'_std γ ≤
            (TopologicalSpace.Opens.map π.base).obj U ⊓
              weilCoverChartInter Z'_std (face j) :=
        fun j => inf_le_inf_left _
          (Finset.le_inf' _ _ (fun k _ =>
            Finset.inf'_le _ (Finset.mem_univ (j.succAbove k))))
      ∑ j : Fin (q + 2), ((-1 : ℤ) ^ (j : ℕ)) •
        (Z'.presheaf.map (CategoryTheory.homOfLE (hFace j)).op).hom (c (face j))
  let instModE : ∀ (U : Z.Opens) (q : ℕ),
      Module ↑(Z.presheaf.obj (Opposite.op U)) (E_sec U q) :=
    fun U q =>
      @Pi.module _ _ _ _ _ fun β =>
        Module.compHom _
          (π.appLE U
            ((TopologicalSpace.Opens.map π.base).obj U ⊓ weilCoverChartInter Z'_std β)
            inf_le_left).hom
  let dv_lin : ∀ (U : Z.Opens) (q : ℕ),
      @LinearMap _ _ _ _ (RingHom.id ↑(Z.presheaf.obj (Opposite.op U)))
        (E_sec U q) (E_sec U (q + 1)) _ _ (instModE U q) (instModE U (q + 1)) :=
    fun U q =>
      letI := instModE U q
      letI := instModE U (q + 1)
      { toFun := dv_sec U q
        map_add' := fun c₁ c₂ => funext fun γ => by
          let face : Fin (q + 2) → WeilStrictMonoTuple (N + 1) q :=
            fun j => ⟨fun k => γ.1 (j.succAbove k), γ.2.comp (Fin.strictMono_succAbove j)⟩
          let hFace : ∀ j : Fin (q + 2),
              (TopologicalSpace.Opens.map π.base).obj U ⊓ weilCoverChartInter Z'_std γ ≤
                (TopologicalSpace.Opens.map π.base).obj U ⊓
                  weilCoverChartInter Z'_std (face j) :=
            fun j => inf_le_inf_left _
              (Finset.le_inf' _ _ (fun k _ =>
                Finset.inf'_le _ (Finset.mem_univ (j.succAbove k))))
          change ∑ j : Fin (q + 2), ((-1 : ℤ) ^ (j : ℕ)) •
              (Z'.presheaf.map (CategoryTheory.homOfLE (hFace j)).op).hom
                (c₁ (face j) + c₂ (face j)) =
            (∑ j : Fin (q + 2), ((-1 : ℤ) ^ (j : ℕ)) •
              (Z'.presheaf.map (CategoryTheory.homOfLE (hFace j)).op).hom (c₁ (face j))) +
            (∑ j : Fin (q + 2), ((-1 : ℤ) ^ (j : ℕ)) •
              (Z'.presheaf.map (CategoryTheory.homOfLE (hFace j)).op).hom (c₂ (face j)))
          rw [← Finset.sum_add_distrib]
          exact Finset.sum_congr rfl fun j _ => by rw [map_add, zsmul_add]
        map_smul' := fun a c => funext fun γ => by
          let face : Fin (q + 2) → WeilStrictMonoTuple (N + 1) q :=
            fun j => ⟨fun k => γ.1 (j.succAbove k), γ.2.comp (Fin.strictMono_succAbove j)⟩
          let hFace : ∀ j : Fin (q + 2),
              (TopologicalSpace.Opens.map π.base).obj U ⊓ weilCoverChartInter Z'_std γ ≤
                (TopologicalSpace.Opens.map π.base).obj U ⊓
                  weilCoverChartInter Z'_std (face j) :=
            fun j => inf_le_inf_left _
              (Finset.le_inf' _ _ (fun k _ =>
                Finset.inf'_le _ (Finset.mem_univ (j.succAbove k))))
          change ∑ j : Fin (q + 2), ((-1 : ℤ) ^ (j : ℕ)) •
              (Z'.presheaf.map (CategoryTheory.homOfLE (hFace j)).op).hom
                ((π.appLE U ((TopologicalSpace.Opens.map π.base).obj U ⊓
                  weilCoverChartInter Z'_std (face j)) inf_le_left).hom a * c (face j)) =
            (π.appLE U ((TopologicalSpace.Opens.map π.base).obj U ⊓
              weilCoverChartInter Z'_std γ) inf_le_left).hom a *
            ∑ j : Fin (q + 2), ((-1 : ℤ) ^ (j : ℕ)) •
              (Z'.presheaf.map (CategoryTheory.homOfLE (hFace j)).op).hom (c (face j))
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [map_mul]
          have hApp := congrArg (fun φ => φ.hom a)
            (AlgebraicGeometry.Scheme.Hom.appLE_map π
              (inf_le_left : (TopologicalSpace.Opens.map π.base).obj U ⊓
                weilCoverChartInter Z'_std (face j) ≤ _)
              (CategoryTheory.homOfLE (hFace j)).op)
          change ((-1 : ℤ) ^ (j : ℕ)) • (_ * _) = _
          erw [hApp]
          rw [zsmul_eq_mul, zsmul_eq_mul]
          ring }
  let E_res : ∀ {U W : Z.Opens} (h : W ≤ U) (q : ℕ), E_sec U q →+ E_sec W q :=
    fun {U W} h q =>
      { toFun := fun c β =>
          (Z'.presheaf.map (CategoryTheory.homOfLE
            (inf_le_inf_right _ ((TopologicalSpace.Opens.map π.base).monotone h))).op).hom (c β)
        map_zero' := funext fun β => map_zero _
        map_add' := fun c₁ c₂ => funext fun β => map_add _ (c₁ β) (c₂ β) }
  have hE_res_id : ∀ (U : Z.Opens) (q : ℕ) (c : E_sec U q), E_res (le_refl U) q c = c := by
    intro U q c
    funext β
    exact hMapId Z' _ _ (c β)
  have hE_res_comp : ∀ {U W T : Z.Opens} (h₁ : W ≤ U) (h₂ : T ≤ W) (q : ℕ) (c : E_sec U q),
      E_res h₂ q (E_res h₁ q c) = E_res (le_trans h₂ h₁) q c := by
    intro U W T h₁ h₂ q c
    funext β
    exact hMapComp Z' _ _ _ (c β)
  have hE_res_smul : ∀ {U W : Z.Opens} (h : W ≤ U) (q : ℕ)
      (a : ↑(Z.presheaf.obj (Opposite.op U))) (c : E_sec U q),
      E_res h q (@SMul.smul _ _ (instModE U q).toSMul a c) =
        @SMul.smul _ _ (instModE W q).toSMul
          ((Z.presheaf.map (CategoryTheory.homOfLE h).op).hom a) (E_res h q c) := by
    intro U W h q a c
    funext β
    change (Z'.presheaf.map _).hom ((π.appLE U _ inf_le_left).hom a * c β) =
      (π.appLE W _ inf_le_left).hom
        ((Z.presheaf.map (CategoryTheory.homOfLE h).op).hom a) * E_res h q c β
    rw [map_mul]
    congr 1
    have h1 := AlgebraicGeometry.Scheme.Hom.appLE_map π
      (inf_le_left : (TopologicalSpace.Opens.map π.base).obj U ⊓ weilCoverChartInter Z'_std β ≤ _)
      (CategoryTheory.homOfLE
        (inf_le_inf_right _ ((TopologicalSpace.Opens.map π.base).monotone h))).op
    have h2 := AlgebraicGeometry.Scheme.Hom.map_appLE π
      (inf_le_left : (TopologicalSpace.Opens.map π.base).obj W ⊓ weilCoverChartInter Z'_std β ≤ _)
      (CategoryTheory.homOfLE h).op
    exact congrArg (fun φ => φ.hom a) (h1.trans h2.symm)
  have hE_res_dv : ∀ {U W : Z.Opens} (h : W ≤ U) (q : ℕ) (c : E_sec U q),
