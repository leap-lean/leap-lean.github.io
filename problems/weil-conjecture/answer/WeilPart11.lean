      · intro a₁ a₂ _ _ ih₁ ih₂ v hv
        obtain ⟨h₂, eq₂⟩ := ih₂ v hv
        obtain ⟨h₁₂, eq₁₂⟩ := ih₁ (a₂ * v) h₂
        have hmul : (a₁ * a₂) * v ∈ E₀_inf := by
          rwa [mul_assoc]
        refine ⟨hmul, ?_⟩
        rw [hϕ₀_congr _ _ hmul h₁₂ (mul_assoc a₁ a₂ v), eq₁₂, eq₂, mul_assoc]
    let a_ch : F → F := fun u => Classical.choose (hClear u)
    have ha_ch_A₀ : ∀ u : F, a_ch u ∈ A₀ :=
      fun u => (Classical.choose_spec (hClear u)).1
    have ha_ch_ne : ∀ u : F, a_ch u ≠ 0 :=
      fun u => (Classical.choose_spec (hClear u)).2.1
    have ha_ch_mem : ∀ u : F, a_ch u * u ∈ E₀_inf :=
      fun u => (Classical.choose_spec (hClear u)).2.2
    let Φ_F : F → F := fun u => (a_ch u)⁻¹ * ϕ₀ (a_ch u * u) (ha_ch_mem u)
    have hΦ_eq : ∀ (u a : F), a ∈ A₀ → a ≠ 0 → ∀ (hau : a * u ∈ E₀_inf),
        a * Φ_F u = ϕ₀ (a * u) hau := by
      intro u a ha ha_ne hau
      obtain ⟨h1, eq1⟩ := hϕ₀_A₀ a ha (a_ch u * u) (ha_ch_mem u)
      obtain ⟨h2, eq2⟩ := hϕ₀_A₀ (a_ch u) (ha_ch_A₀ u) (a * u) hau
