    let helper_pullWeilBundle : ∀ {C' C₀ : AlgebraicGeometry.Scheme.{u}}
        (φ : C' ⟶ C₀) (M₀ : WeilLineBundle C₀), WeilLineBundle C' :=
      fun {C' C₀} φ M₀ =>
        { m := M₀.m
          V := fun a => φ ⁻¹ᵁ M₀.V a
          hCov := by
            ext y
            simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
            have hy : φ.base y ∈ (Set.univ : Set ↥C₀) := Set.mem_univ _
            rw [← M₀.hCov, Set.mem_iUnion] at hy
            exact hy
          u := fun a b => Units.map (φ.app (M₀.V a ⊓ M₀.V b)).hom.toMonoidHom (M₀.u a b)
          u_refl := fun a => by
            change (φ.app (M₀.V a ⊓ M₀.V a)).hom (M₀.u a a).val = 1
            rw [M₀.u_refl a, map_one]
          u_cocycle := fun a b c => by
            let w₁_C : M₀.V a ⊓ M₀.V b ⊓ M₀.V c ⟶ M₀.V a ⊓ M₀.V b := CategoryTheory.homOfLE inf_le_left
            let w₂_C : M₀.V a ⊓ M₀.V b ⊓ M₀.V c ⟶ M₀.V b ⊓ M₀.V c :=
              CategoryTheory.homOfLE (inf_le_inf inf_le_right (le_refl _))
            let w₃_C : M₀.V a ⊓ M₀.V b ⊓ M₀.V c ⟶ M₀.V a ⊓ M₀.V c :=
              CategoryTheory.homOfLE (inf_le_inf inf_le_left (le_refl _))
            have hnat₁ := congrArg (fun k : C₀.presheaf.obj _ ⟶ C'.presheaf.obj _ => k.hom (M₀.u a b).val)
              (φ.naturality w₁_C.op)
            have hnat₂ := congrArg (fun k : C₀.presheaf.obj _ ⟶ C'.presheaf.obj _ => k.hom (M₀.u b c).val)
              (φ.naturality w₂_C.op)
            have hnat₃ := congrArg (fun k : C₀.presheaf.obj _ ⟶ C'.presheaf.obj _ => k.hom (M₀.u a c).val)
              (φ.naturality w₃_C.op)
            dsimp only [CommRingCat.hom_comp, RingHom.comp_apply] at hnat₁ hnat₂ hnat₃
            change (φ.app (M₀.V a ⊓ M₀.V b ⊓ M₀.V c)).hom ((C₀.presheaf.map w₁_C.op).hom (M₀.u a b).val) =
              (C'.presheaf.map ((TopologicalSpace.Opens.map φ.base).map w₁_C).op).hom
                ((φ.app (M₀.V a ⊓ M₀.V b)).hom (M₀.u a b).val) at hnat₁
            change (φ.app (M₀.V a ⊓ M₀.V b ⊓ M₀.V c)).hom ((C₀.presheaf.map w₂_C.op).hom (M₀.u b c).val) =
              (C'.presheaf.map ((TopologicalSpace.Opens.map φ.base).map w₂_C).op).hom
                ((φ.app (M₀.V b ⊓ M₀.V c)).hom (M₀.u b c).val) at hnat₂
            change (φ.app (M₀.V a ⊓ M₀.V b ⊓ M₀.V c)).hom ((C₀.presheaf.map w₃_C.op).hom (M₀.u a c).val) =
              (C'.presheaf.map ((TopologicalSpace.Opens.map φ.base).map w₃_C).op).hom
                ((φ.app (M₀.V a ⊓ M₀.V c)).hom (M₀.u a c).val) at hnat₃
            change (C'.presheaf.map ((TopologicalSpace.Opens.map φ.base).map w₁_C).op).hom
                ((φ.app (M₀.V a ⊓ M₀.V b)).hom (M₀.u a b).val) *
              (C'.presheaf.map ((TopologicalSpace.Opens.map φ.base).map w₂_C).op).hom
                ((φ.app (M₀.V b ⊓ M₀.V c)).hom (M₀.u b c).val) =
