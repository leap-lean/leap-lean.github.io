    rw [D_K.map_aeval (Q_den j) t, D_K.map_aeval (P_num j) t] at hLeib
    have h_qv_smul : qv • D_K (H.coeff j) =
        (Polynomial.aeval t (Polynomial.derivative (P_num j)) -
