  let pullBundle : ∀ {C X : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ C),
      WeilLineBundle C → WeilLineBundle X := fun {C X} f M =>
    { m := M.m
      V := fun a => (TopologicalSpace.Opens.map f.base).obj (M.V a)
      hCov := by
        apply Set.eq_univ_iff_forall.mpr
        intro x
        have hx : f.base x ∈ (⋃ a : Fin M.m, (M.V a : Set C)) := by
          rw [M.hCov]
          exact Set.mem_univ _
        obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hx
        exact Set.mem_iUnion.mpr ⟨a, ha⟩
      u := fun a b =>
        Units.map ((f.app (M.V a ⊓ M.V b)).hom.toMonoidHom) (M.u a b)
      u_refl := fun a => by
        change (f.app (M.V a ⊓ M.V a)).hom (M.u a a).val = 1
        rw [M.u_refl a, map_one]
      u_cocycle := fun a b c => by
        have hNat : ∀ {U U' : C.Opens} (h : U ≤ U')
            (z : ↑(C.presheaf.obj (Opposite.op U'))),
            (X.presheaf.map (CategoryTheory.homOfLE
                ((TopologicalSpace.Opens.map f.base).monotone h)).op).hom
              ((f.app U').hom z) =
              (f.app U).hom ((C.presheaf.map (CategoryTheory.homOfLE h).op).hom z) := by
          intro U U' h z
          have h_nat := (f.naturality (CategoryTheory.homOfLE h).op).symm
          exact congrArg (fun φ => φ.hom z) h_nat
        have e1 := hNat (U := M.V a ⊓ M.V b ⊓ M.V c) (U' := M.V a ⊓ M.V b)
          inf_le_left (M.u a b).val
        have e2 := hNat (U := M.V a ⊓ M.V b ⊓ M.V c) (U' := M.V b ⊓ M.V c)
          (inf_le_inf inf_le_right (le_refl _)) (M.u b c).val
        have e3 := hNat (U := M.V a ⊓ M.V b ⊓ M.V c) (U' := M.V a ⊓ M.V c)
          (inf_le_inf inf_le_left (le_refl _)) (M.u a c).val
        exact (congrArg₂ (· * ·) e1 e2).trans ((map_mul _ _ _).symm.trans
          ((congrArg _ (M.u_cocycle a b c)).trans e3.symm)) }
