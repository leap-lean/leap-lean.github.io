          Y.presheaf.map (CategoryTheory.homOfLE (le_top : B ≤ ⊤)).op ≫ B.topIso.inv := by
        rw [Iso.eq_comp_inv, AlgebraicGeometry.Scheme.Opens.ι_appTop,
