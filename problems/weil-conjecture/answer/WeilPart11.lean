        _ = Θ_inv p (Θ p (Θ_inv p c₁ + Θ_inv p c₂)) := by rw [← hΘ_add]
        _ = Θ_inv p c₁ + Θ_inv p c₂ := hΘ_left p _
    have hΘ_inv_sum : ∀ (p : ℕ) {ι : Type} (I : Finset ι)
        (f_i : ι → WeilModuleCechCochain V_Z H_Z p),
