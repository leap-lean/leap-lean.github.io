    let ρ : Localization.Away x →+* ↑(B.toScheme.presheaf.obj (Opposite.op ⊤)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Localization.Away x))).inv ≫
        μ_x.appTop).hom
    have hρ_alg : ∀ s : ↑(Y.presheaf.obj (Opposite.op ⊤)),
        ρ (algebraMap _ (Localization.Away x) s) = B.ι.appTop.hom s := by
      intro s
      have h1 := congrArg (fun m =>
        ((AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op ⊤))).inv ≫ m.appTop).hom s) hμ_ι
      dsimp only [Scheme.Hom.comp_appTop] at h1
      rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
        hSpecMap_inv, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.toSpecΓ_appTop, Iso.inv_hom_id,
        CategoryTheory.Category.id_comp] at h1
