    intro U W h f
    funext β
    change (Z'.presheaf.map _).hom ((π.appLE U _ inf_le_left).hom f) =
      (π.appLE W _ inf_le_left).hom ((Z.presheaf.map (CategoryTheory.homOfLE h).op).hom f)
    have h1 := AlgebraicGeometry.Scheme.Hom.appLE_map π
      (inf_le_left : (TopologicalSpace.Opens.map π.base).obj U ⊓ weilCoverChartInter Z'_std β ≤ _)
      (CategoryTheory.homOfLE
