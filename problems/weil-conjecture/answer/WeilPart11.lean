        exact PrimeSpectrum.isRadical_vanishingIdeal _
      have _ : _root_.IsReduced (↑(C.presheaf.obj (Opposite.op U.1)) ⧸ I_S.ideal U) :=
        (Ideal.isRadical_iff_quotient_reduced (I_S.ideal U)).mp hRad
