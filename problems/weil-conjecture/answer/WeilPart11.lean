        res0 s α = O_Y.res (h0LeW α) s :=
      fun _ _ => rfl
    let pt0 : Fin r → WeilStrictMonoTuple r 0 :=
      fun a => ⟨fun _ => a, fun i j hij =>
        False.elim (lt_irrefl i ((hFin01 j).trans (hFin01 i).symm ▸ hij))⟩
    have hα0_eq : ∀ α : WeilStrictMonoTuple r 0, α = pt0 (α.1 0) :=
