    have hq_eq_π : q = π_f.base (e_W.base p_z) := by
      change PrimeSpectrum.comap σ_W p_z = (e_W ≫ π_f).base p_z
      rw [heW_πf]
      rfl
    have hg_bij : Function.Bijective g_loc := by
      refine ⟨?_, ?_⟩
      · intro u₁ u₂ hu
