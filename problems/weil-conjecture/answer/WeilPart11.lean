          Subtype.ext (hE_res_smul h (q + 1) a z.1)
        exact congrArg (Submodule.Quotient.mk (p := Bq_sub W q)) h1
      res_id := fun U x => by
        let _ := instModE U (q + 1)
        obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (Bq_sub U q) x
        change Submodule.Quotient.mk (ker_res_q (le_refl U) q z) = Submodule.Quotient.mk z
        congr 1
        exact Subtype.ext (hE_res_id U (q + 1) z.1)
      res_comp := fun {U W T} h₁ h₂ x => by
        let _ := instModE U (q + 1)
        let _ := instModE W (q + 1)
        let _ := instModE T (q + 1)
        obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (Bq_sub U q) x
        change Submodule.Quotient.mk (ker_res_q h₂ q (ker_res_q h₁ q z)) =
          Submodule.Quotient.mk (ker_res_q (le_trans h₂ h₁) q z)
        congr 1
        exact Subtype.ext (hE_res_comp h₁ h₂ (q + 1) z.1) }
  let η_raw : ∀ U : Z.Opens,
      @LinearMap _ _ _ _ (RingHom.id ↑(Z.presheaf.obj (Opposite.op U)))
        (O_Z.sec U) (E_sec U 0) _ _ inferInstance (instModE U 0) :=
    fun U =>
      letI := instModE U 0
      { toFun := fun f β =>
          (π.appLE U
            ((TopologicalSpace.Opens.map π.base).obj U ⊓ weilCoverChartInter Z'_std β)
            inf_le_left).hom f
        map_add' := fun f₁ f₂ => funext fun β => map_add _ f₁ f₂
        map_smul' := fun a f => funext fun β => map_mul _ a f }
  have h_dv_η : ∀ (U : Z.Opens) (f : O_Z.sec U), dv_sec U 0 (η_raw U f) = 0 := by
    intro U f
    funext γ
    let face : Fin 2 → WeilStrictMonoTuple (N + 1) 0 :=
      fun j => ⟨fun k => γ.1 (j.succAbove k), γ.2.comp (Fin.strictMono_succAbove j)⟩
    let hFace : ∀ j : Fin 2,
        (TopologicalSpace.Opens.map π.base).obj U ⊓ weilCoverChartInter Z'_std γ ≤
          (TopologicalSpace.Opens.map π.base).obj U ⊓
            weilCoverChartInter Z'_std (face j) :=
      fun j => inf_le_inf_left _
        (Finset.le_inf' _ _ (fun k _ =>
          Finset.inf'_le _ (Finset.mem_univ (j.succAbove k))))
    change ∑ j : Fin 2, ((-1 : ℤ) ^ (j : ℕ)) •
        (Z'.presheaf.map (CategoryTheory.homOfLE (hFace j)).op).hom
          ((π.appLE U ((TopologicalSpace.Opens.map π.base).obj U ⊓
            weilCoverChartInter Z'_std (face j)) inf_le_left).hom f) = 0
    rw [Fin.sum_univ_two]
    have h0 := congrArg (fun φ => φ.hom f)
      (AlgebraicGeometry.Scheme.Hom.appLE_map π
        (inf_le_left : (TopologicalSpace.Opens.map π.base).obj U ⊓
          weilCoverChartInter Z'_std (face 0) ≤ _)
        (CategoryTheory.homOfLE (hFace 0)).op)
    have h1 := congrArg (fun φ => φ.hom f)
      (AlgebraicGeometry.Scheme.Hom.appLE_map π
        (inf_le_left : (TopologicalSpace.Opens.map π.base).obj U ⊓
          weilCoverChartInter Z'_std (face 1) ≤ _)
        (CategoryTheory.homOfLE (hFace 1)).op)
    simp only [Fin.val_zero, pow_zero, one_zsmul, Fin.val_one, pow_one, neg_one_zsmul]
    change _ + -(_ : _) = 0
    erw [h0, h1, add_neg_cancel]
  have hη_res : ∀ {U W : Z.Opens} (h : W ≤ U) (f : O_Z.sec U),
