        map := fun f => AddCommGrpCat.ofHom (Finsupp.mapDomain.addMonoidHom (fun g => f.unop ≫ g))
        map_id := fun V => by
          apply AddCommGrpCat.ext
          intro z
          change Finsupp.mapDomain (fun g : Opposite.unop V ⟶ Y => 𝟙 _ ≫ g) z = z
          simp only [Category.id_comp]
          exact Finsupp.mapDomain_id
        map_comp := fun f₁ f₂ => by
          apply AddCommGrpCat.ext
          intro z
          change Finsupp.mapDomain (fun g => (f₂.unop ≫ f₁.unop) ≫ g) z =
            Finsupp.mapDomain (fun g => f₂.unop ≫ g) (Finsupp.mapDomain (fun g => f₁.unop ≫ g) z)
