      have h_sp_B : sp_m.comp (@algebraMap B₀ (TensorProduct R₁ R₃ (B₁ m)) _ _ (alg_Bk m)) = ψ_m m := by
        ext b
        change (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₃ Ω) (AlgHom.id R₁ (B₁ m)))
