        Matrix.mulVec_zero] at hR_app
      exact hR_app
    have hx_vec0 : C_bar.mulVec x = 0 := by
      rw [hy0, Matrix.mulVec_zero, add_zero] at h_sum0
      exact h_sum0
    have h_lin0 : (Finset.univ.sum fun r : Fin R_dim => x r • b_ker r) = 0 := by
