        ((congrArg (fun f => ℋ.obj.map f.op) e.inv_hom_id).trans (ℋ.obj.map_id _))
    have h2 : ℋ.obj.map e.inv.op ≫ ℋ.obj.map e.hom.op = 𝟙 _ :=
      (ℋ.obj.map_comp _ _).symm.trans
