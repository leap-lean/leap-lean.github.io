      have hclear_in_B₀ : ∀ x : Pt, x.1 ∈ U₀ → 0 ≤ div_fn (Additive.ofMul u_clear) x := by
        intro x hx_in
        have hcv : div_fn (Additive.ofMul u_clear) x =
