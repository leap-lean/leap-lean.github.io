    have : Finite ↥T_prime := (hFinD d hd).to_subtype
    let emb : ↥S_fib → ↥T_prime := fun y =>
      let hy := y.2.choose
      ⟨(hV₀.primeIdealOf ⟨y.1.1, hy⟩).asIdeal,
        (hV₀.primeIdealOf ⟨y.1.1, hy⟩).isPrime, by
          have hgerm_eq :=
            congrArg PrimeSpectrum.asIdeal (hV₀.primeIdealOf_eq_map_closedPoint ⟨y.1.1, hy⟩)
