            mul_nonneg (Int.natCast_nonneg M_clear) hhs_ge0
          omega
      obtain ⟨q_sp, hq_sp⟩ := (hIntB₀ u_clear).mp hclear_in_B₀
      change germB₀ q_sp = (u_clear : K) at hq_sp
      have hmq_B₀ : h_s ^ M_clear * F_c = gen_s * q_sp := by
        apply hInjGerm
        change germB₀ (h_s ^ M_clear * F_c) = germB₀ (gen_s * q_sp)
        rw [map_mul, map_pow, map_mul, hF_eq, hq_sp]
        have hinv : germB₀ gen_s * ↑(Units.mk0 (germB₀ gen_s) hgen_ne)⁻¹ = 1 :=
          Units.mul_inv (Units.mk0 (germB₀ gen_s) hgen_ne)
        change germB₀ h_s ^ M_clear * (u_F : K) =
          germB₀ gen_s * (germB₀ h_s ^ M_clear *
            ((u_F : K) * ↑(Units.mk0 (germB₀ gen_s) hgen_ne)⁻¹))
        calc
          germB₀ h_s ^ M_clear * (u_F : K)
              = germB₀ h_s ^ M_clear * (u_F : K) * 1 := (mul_one _).symm
          _ = germB₀ h_s ^ M_clear * (u_F : K) *
                (germB₀ gen_s * ↑(Units.mk0 (germB₀ gen_s) hgen_ne)⁻¹) := by rw [hinv]
          _ = germB₀ gen_s * (germB₀ h_s ^ M_clear *
                ((u_F : K) * ↑(Units.mk0 (germB₀ gen_s) hgen_ne)⁻¹)) := by ring
      have hmq_R : (Algebra.TensorProduct.map (AlgHom.id k B₀) ev_s H) ^ M_clear *
          (Finset.univ.sum fun ν : Fin N_V => v_bas ν ⊗ₜ[k] c ν) =
          (Algebra.TensorProduct.map (AlgHom.id k B₀) ev_s
            (W_num * Finset.univ.prod u_neg)) *
            (Algebra.TensorProduct.rid k k B₀).symm q_sp := by
        apply (Algebra.TensorProduct.rid k k B₀).injective
        rw [map_mul, map_pow, map_mul, (Algebra.TensorProduct.rid k k B₀).apply_symm_apply]
        have hrid_H : (Algebra.TensorProduct.rid k k B₀)
            (Algebra.TensorProduct.map (AlgHom.id k B₀) ev_s H) = h_s := rfl
        have hrid_Fc : (Algebra.TensorProduct.rid k k B₀)
            (Finset.univ.sum fun ν : Fin N_V => v_bas ν ⊗ₜ[k] c ν) = F_c := by
          rw [map_sum]
          refine Finset.sum_congr rfl fun ν _ => ?_
          rw [Algebra.TensorProduct.rid_tmul, Algebra.smul_def]; rfl
        have hrid_gen : (Algebra.TensorProduct.rid k k B₀)
            (Algebra.TensorProduct.map (AlgHom.id k B₀) ev_s
              (W_num * Finset.univ.prod u_neg)) = gen_s := by
          change ev_R (W_num * Finset.univ.prod u_neg) = w_s * Finset.univ.prod u_neg_s
          rw [map_mul, map_prod]
          congr 1; exact Finset.prod_congr rfl fun j _ => hevR_uneg j
        rw [hrid_H, hrid_Fc, hrid_gen]
        exact hmq_B₀
      have hmul0 : (Θ_A.map ev_s).mulVec c = 0 := by
        exact (hBase k ev_s c).mpr
          ((hLocSpanSelf _ _ _).mpr ⟨M_clear, (Algebra.TensorProduct.rid k k B₀).symm q_sp, hmq_R⟩)
      refine ⟨c, hc_ne, hmul0, ?_⟩
      exact hF_eq.symm
  
  have hDualEq : ∀ (w : DualNumber k),
      w = TrivSqZeroExt.inl w.fst + DualNumber.eps * TrivSqZeroExt.inl w.snd := by
    intro w
    apply TrivSqZeroExt.ext
