  have hLocSpanSelf : ∀ {R : Type u} [CommRing R] (h x g : R),
      algebraMap R (Localization.Away h) x ∈
        Ideal.span ({algebraMap R (Localization.Away h) g} : Set (Localization.Away h)) ↔
        ∃ (m : ℕ) (q : R), h ^ m * x = g * q := by
    intro R _ h x g
    rw [Ideal.mem_span_singleton]
    constructor
    · rintro ⟨z, hz⟩
      obtain ⟨⟨q, ⟨_, m, rfl⟩⟩, hzq⟩ := IsLocalization.surj (Submonoid.powers h) z
      dsimp only at hzq
      have h1 : algebraMap R (Localization.Away h) (x * h ^ m) =
          algebraMap R (Localization.Away h) (g * q) := by
        rw [map_mul, hz, mul_assoc, hzq, ← map_mul]
      obtain ⟨⟨_, m', rfl⟩, hm'⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers h) _).mp h1
      dsimp only at hm'
      refine ⟨m' + m, h ^ m' * q, ?_⟩
      calc
        h ^ (m' + m) * x = h ^ m' * (x * h ^ m) := by ring
        _ = h ^ m' * (g * q) := hm'
        _ = g * (h ^ m' * q) := by ring
    · rintro ⟨m, q, hmq⟩
      refine ⟨algebraMap R (Localization.Away h) q *
          (IsLocalization.Away.invSelf (S := Localization.Away h) h) ^ m, ?_⟩
      have hinv : algebraMap R (Localization.Away h) h *
          IsLocalization.Away.invSelf (S := Localization.Away h) h = 1 :=
        IsLocalization.Away.mul_invSelf h
      have hpow : algebraMap R (Localization.Away h) (h ^ m) *
          (IsLocalization.Away.invSelf (S := Localization.Away h) h) ^ m = 1 := by
        rw [map_pow, ← mul_pow, hinv, one_pow]
      calc
        algebraMap R (Localization.Away h) x
            = algebraMap R (Localization.Away h) x * 1 := (mul_one _).symm
        _ = algebraMap R (Localization.Away h) x *
              (algebraMap R (Localization.Away h) (h ^ m) *
                (IsLocalization.Away.invSelf (S := Localization.Away h) h) ^ m) := by
              rw [hpow]
        _ = algebraMap R (Localization.Away h) (h ^ m * x) *
              (IsLocalization.Away.invSelf (S := Localization.Away h) h) ^ m := by
              rw [map_mul]; ring
        _ = algebraMap R (Localization.Away h) (g * q) *
              (IsLocalization.Away.invSelf (S := Localization.Away h) h) ^ m := by
              rw [hmq]
        _ = algebraMap R (Localization.Away h) g *
              (algebraMap R (Localization.Away h) q *
                (IsLocalization.Away.invSelf (S := Localization.Away h) h) ^ m) := by
              rw [map_mul, mul_assoc]
