        rw [← hι_tr f_ij]
        exact h_img_unit.map (ι j).toRingHom.toMonoidHom
    have hLocA : IsLocalRing A := by
      apply IsLocalRing.of_nonunits_add
      intro a b ha hb
      rw [mem_nonunits_iff] at ha hb ⊢
      rw [h_unit_iff, not_not] at ha hb ⊢
      exact Ideal.add_mem _ ha hb
    let _ : IsLocalRing A := hLocA
    have hKerA : IsLocalRing.maximalIdeal A = RingHom.ker (algebraMap A Ω) := by
      ext a
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, h_unit_iff, not_not]
    exact ⟨ℐ, instCat, inferInstance, R_obj, instComm, instAlg, instEt, pt, @tr,
      A, instCommA, hLocA, instAlgR₀A, instAlgAΩ, inferInstance, ι,
      hpt_R₀, (fun _ => rfl), (fun _ _ => rfl), (fun f => f.2.1), (fun f => f.2.2),
      hKerA, hι_pt, @hι_tr, hSurj, hEq, hPres⟩

  
  have h_pillar3 :
      (∀ (B : Type u) [CommRing B] (ψ_B : B →+* Ω)
          (d : ℕ) (g : Fin d → MvPolynomial (Fin d) B) (ω : Fin d → Ω),
        (∀ k : Fin d, MvPolynomial.eval₂ ψ_B ω (g k) = 0) →
        MvPolynomial.eval₂ ψ_B ω
          (Matrix.det (Matrix.of fun k l : Fin d => MvPolynomial.pderiv l (g k))) ≠ 0 →
        ∃ (S : Type u) (_ : CommRing S) (_ : Algebra B S) (_ : Algebra.Etale B S)
          (ψ_S : S →+* Ω) (s : Fin d → S),
          ψ_S.comp (algebraMap B S) = ψ_B ∧
          (∀ k : Fin d, MvPolynomial.eval₂ (algebraMap B S) s (g k) = 0) ∧
          (∀ l : Fin d, ψ_S (s l) = ω l)) ∧
      (∀ (A : Type u) [CommRing A] [IsLocalRing A] [Algebra A Ω],
        IsLocalRing.maximalIdeal A = RingHom.ker (algebraMap A Ω) →
        (∀ (q : Polynomial A) (ω₀ : Ω),
          q.Monic →
          Polynomial.eval₂ (algebraMap A Ω) ω₀ q = 0 →
          Polynomial.eval₂ (algebraMap A Ω) ω₀ q.derivative ≠ 0 →
          ∃ a : A, q.eval a = 0) →
        IsSepClosed (IsLocalRing.ResidueField A)) := by
    refine ⟨?_, ?_⟩
    · intro B _ ψ_B d g ω hg0 hdet
      let I_g : Ideal (MvPolynomial (Fin d) B) := Ideal.span (Set.range g)
      let Q_B : Type u := MvPolynomial (Fin d) B ⧸ I_g
      let ev_Ω : MvPolynomial (Fin d) B →+* Ω := MvPolynomial.eval₂Hom ψ_B ω
      have h_ker : ∀ p ∈ I_g, ev_Ω p = 0 := by
        intro p hp
        have h_le : I_g ≤ RingHom.ker ev_Ω := by
          rw [Ideal.span_le]
          rintro _ ⟨k, rfl⟩
          exact hg0 k
        exact h_le hp
      let ψ_Q : Q_B →+* Ω := Ideal.Quotient.lift I_g ev_Ω h_ker
      let P : Algebra.PreSubmersivePresentation B Q_B (Fin d) (Fin d) :=
        Algebra.PreSubmersivePresentation.naive (v := g) id Function.injective_id
      have h_mat : P.jacobiMatrix =
          (Matrix.of fun k l : Fin d => MvPolynomial.pderiv l (g k)).transpose := by
        ext l k
        rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
        rfl
      have h_jac_val : ψ_Q P.jacobian =
          MvPolynomial.eval₂ ψ_B ω
            (Matrix.det (Matrix.of fun k l : Fin d => MvPolynomial.pderiv l (g k))) := by
        rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, h_mat,
          Matrix.det_transpose]
        rfl
      have hJ_unit : IsUnit (ψ_Q P.jacobian) := IsUnit.mk0 _ (h_jac_val.symm ▸ hdet)
      let S : Type u := Localization.Away P.jacobian
      let Q_loc : Algebra.PreSubmersivePresentation Q_B S Unit Unit :=
        Algebra.PreSubmersivePresentation.localizationAway S P.jacobian
      let P_tot : Algebra.PreSubmersivePresentation B S (Unit ⊕ Fin d) (Unit ⊕ Fin d) :=
        Q_loc.comp P
      have hUnit_J : IsUnit (algebraMap Q_B S P.jacobian) :=
        IsLocalization.Away.algebraMap_isUnit (S := S) P.jacobian
      have hUnit_tot : IsUnit P_tot.jacobian := by
        rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
          Algebra.PreSubmersivePresentation.localizationAway_jacobian, Algebra.smul_def]
        exact hUnit_J.mul hUnit_J
      let P_sub : Algebra.SubmersivePresentation B S (Unit ⊕ Fin d) (Unit ⊕ Fin d) :=
        { P_tot with jacobian_isUnit := hUnit_tot }
      have h_dim : P_sub.dimension = 0 := Nat.sub_self _
      have : Algebra.IsStandardSmoothOfRelativeDimension 0 B S :=
        P_sub.isStandardSmoothOfRelativeDimension h_dim
      have hEt_BS : Algebra.Etale B S := inferInstance
      let ψ_S : S →+* Ω := IsLocalization.Away.lift P.jacobian hJ_unit
      let φ_poly : MvPolynomial (Fin d) B →+* S :=
        (algebraMap Q_B S).comp (Ideal.Quotient.mk I_g)
      let s : Fin d → S := fun l => φ_poly (MvPolynomial.X l)
      refine ⟨S, inferInstance, inferInstance, hEt_BS, ψ_S, s, ?_, ?_, ?_⟩
      · refine RingHom.ext fun b => ?_
        change ψ_S (algebraMap Q_B S (Ideal.Quotient.mk I_g (MvPolynomial.C b))) = ψ_B b
        rw [IsLocalization.Away.lift_eq P.jacobian hJ_unit]
        exact MvPolynomial.eval₂_C ψ_B ω b
      · intro k
        have h_eval_eq : ∀ p : MvPolynomial (Fin d) B,
            MvPolynomial.eval₂ (algebraMap B S) s p = φ_poly p := by
          intro p
          induction p using MvPolynomial.induction_on' with
          | monomial m b =>
            rw [MvPolynomial.eval₂_monomial]
            have hb : algebraMap B S b = φ_poly (MvPolynomial.C b) := rfl
            rw [hb, MvPolynomial.monomial_eq, map_mul, map_finsuppProd]
            congr 1
            refine Finsupp.prod_congr fun l _ => ?_
            rw [map_pow]
          | add p₁ p₂ hp₁ hp₂ =>
            rw [MvPolynomial.eval₂_add, hp₁, hp₂, map_add]
        rw [h_eval_eq (g k)]
        change algebraMap Q_B S (Ideal.Quotient.mk I_g (g k)) = 0
        have h_mem : g k ∈ I_g := Ideal.subset_span (⟨k, rfl⟩ : g k ∈ Set.range g)
        rw [(Ideal.Quotient.eq_zero_iff_mem).mpr h_mem, map_zero]
      · intro l
        change ψ_S (algebraMap Q_B S (Ideal.Quotient.mk I_g (MvPolynomial.X l))) = ω l
        rw [IsLocalization.Away.lift_eq P.jacobian hJ_unit]
        exact MvPolynomial.eval₂_X ψ_B ω l
    · intro A _ _ _ hKerA hRoot1
      let κ_A := IsLocalRing.ResidueField A
      let ι_κ : κ_A →+* Ω :=
        Ideal.Quotient.lift (IsLocalRing.maximalIdeal A) (algebraMap A Ω)
          (fun a ha => by rwa [hKerA, RingHom.mem_ker] at ha)
      have hι_res : ι_κ.comp (IsLocalRing.residue A) = algebraMap A Ω :=
        RingHom.ext fun _ => rfl
      refine IsSepClosed.mk ?_
      suffices h_ind : ∀ (n : ℕ) (p_bar : Polynomial κ_A),
          p_bar.natDegree = n → p_bar.Separable → p_bar.Splits by
        intro p_bar hp_sep
        exact h_ind p_bar.natDegree p_bar rfl hp_sep
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro p_bar hp_deg hp_sep
        by_cases hn : n ≤ 1
        · exact Polynomial.Splits.of_natDegree_le_one (hp_deg ▸ hn)
        · have hp_ne : p_bar ≠ 0 := by
            intro h0
            rw [h0, Polynomial.natDegree_zero] at hp_deg
            omega
          let c : κ_A := p_bar.leadingCoeff
          have hc_ne : c ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hp_ne
          let q_bar : Polynomial κ_A := Polynomial.C c⁻¹ * p_bar
          have hp_eq : p_bar = Polynomial.C c * q_bar := by
            dsimp [q_bar]
            rw [← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hc_ne, Polynomial.C_1, one_mul]
          have hq_monic : q_bar.Monic := by
            rw [Polynomial.Monic, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C]
            exact inv_mul_cancel₀ hc_ne
          have hq_deg : q_bar.natDegree = n := by
            rw [hp_eq, Polynomial.natDegree_C_mul hc_ne] at hp_deg
            exact hp_deg
          have hq_sep : q_bar.Separable := by
            rw [hp_eq] at hp_sep
            exact Polynomial.Separable.of_mul_right hp_sep
          let lift_elem : κ_A → A := Function.surjInv IsLocalRing.residue_surjective
          have h_lift : ∀ x : κ_A, IsLocalRing.residue A (lift_elem x) = x :=
            Function.surjInv_eq IsLocalRing.residue_surjective
          let q : Polynomial A :=
            Polynomial.X ^ n +
              ∑ m ∈ Finset.range n, Polynomial.C (lift_elem (q_bar.coeff m)) * Polynomial.X ^ m
          have hq_coeff_gt : ∀ k : ℕ, n < k → q.coeff k = 0 := by
            intro k hk
            dsimp [q]
            rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, if_neg (by omega), zero_add,
              Polynomial.finsetSum_coeff]
            refine Finset.sum_eq_zero fun m hm => ?_
            rw [Finset.mem_range] at hm
            rw [Polynomial.coeff_C_mul_X_pow, if_neg (by omega)]
          have hq_coeff_n : q.coeff n = 1 := by
            dsimp [q]
            rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, if_pos rfl,
              Polynomial.finsetSum_coeff]
            have h_sum0 : (∑ m ∈ Finset.range n,
                (Polynomial.C (lift_elem (q_bar.coeff m)) * Polynomial.X ^ m).coeff n) = 0 := by
              refine Finset.sum_eq_zero fun m hm => ?_
              rw [Finset.mem_range] at hm
              rw [Polynomial.coeff_C_mul_X_pow, if_neg (by omega)]
            rw [h_sum0, add_zero]
          have hq_coeff_lt : ∀ k : ℕ, k < n → q.coeff k = lift_elem (q_bar.coeff k) := by
            intro k hk
            dsimp [q]
            rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, if_neg (by omega), zero_add,
              Polynomial.finsetSum_coeff, Finset.sum_eq_single k]
            · rw [Polynomial.coeff_C_mul_X_pow, if_pos rfl]
            · intro m _ hmk
              rw [Polynomial.coeff_C_mul_X_pow, if_neg hmk.symm]
            · intro hk_mem
              exact False.elim (hk_mem (Finset.mem_range.mpr hk))
          have hq_natDeg : q.natDegree = n := by
            apply Polynomial.natDegree_eq_of_le_of_coeff_ne_zero
            · rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
              exact hq_coeff_gt
            · rw [hq_coeff_n]
              exact one_ne_zero
          have hq_A_monic : q.Monic := by
            rw [Polynomial.Monic, Polynomial.leadingCoeff, hq_natDeg, hq_coeff_n]
          have hq_map_res : q.map (IsLocalRing.residue A) = q_bar := by
            ext k
            rw [Polynomial.coeff_map]
            rcases lt_trichotomy k n with hlt | rfl | hgt
            · rw [hq_coeff_lt k hlt, h_lift]
            · rw [hq_coeff_n, map_one, ← hq_deg]
              exact hq_monic.leadingCoeff.symm
            · rw [hq_coeff_gt k hgt, map_zero,
                Polynomial.coeff_eq_zero_of_natDegree_lt (hq_deg ▸ hgt)]
          have hq_map_Ω : q.map (algebraMap A Ω) = q_bar.map ι_κ := by
            rw [← hι_res, ← Polynomial.map_map, hq_map_res]
          have hq_Ω_deg_ne : (q_bar.map ι_κ).degree ≠ 0 := by
            rw [hq_monic.degree_map ι_κ, Polynomial.degree_eq_natDegree hq_monic.ne_zero, hq_deg]
            intro h0
            have : n = 0 := WithBot.coe_eq_zero.mp h0
            omega
          obtain ⟨ω₀, hω₀_root⟩ := IsAlgClosed.exists_root (q_bar.map ι_κ) hq_Ω_deg_ne
          have hq_ev0 : Polynomial.eval₂ (algebraMap A Ω) ω₀ q = 0 := by
            rw [← Polynomial.eval_map, hq_map_Ω]
            exact hω₀_root
          have hq_Ω_sep : (q_bar.map ι_κ).Separable := hq_sep.map
          obtain ⟨u, v, huv⟩ := hq_Ω_sep
          have hq_deriv_ne : Polynomial.eval₂ (algebraMap A Ω) ω₀ q.derivative ≠ 0 := by
            rw [← Polynomial.eval_map, ← Polynomial.derivative_map, hq_map_Ω]
            intro h_der0
            have h_ev1 := congrArg (Polynomial.eval ω₀) huv
            rw [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_mul,
              Polynomial.IsRoot.def.mp hω₀_root, h_der0, mul_zero, mul_zero, add_zero,
              Polynomial.eval_one] at h_ev1
            exact zero_ne_one h_ev1
          obtain ⟨a, ha_root⟩ := hRoot1 q ω₀ hq_A_monic hq_ev0 hq_deriv_ne
          let a_bar : κ_A := IsLocalRing.residue A a
          have ha_bar_root : q_bar.IsRoot a_bar := by
            rw [Polynomial.IsRoot.def, ← hq_map_res, Polynomial.eval_map]
            have h_hom := Polynomial.hom_eval₂ q (RingHom.id A) (IsLocalRing.residue A) a
            rw [RingHom.comp_id] at h_hom
            change Polynomial.eval₂ (IsLocalRing.residue A) ((IsLocalRing.residue A) a) q = 0
            rw [← h_hom, Polynomial.eval₂_id, ha_root, map_zero]
          obtain ⟨r_bar, hr_bar⟩ := Polynomial.dvd_iff_isRoot.mpr ha_bar_root
          have hr_ne : r_bar ≠ 0 := by
            intro hr0
            rw [hr0, mul_zero] at hr_bar
            exact hq_monic.ne_zero hr_bar
          have hX_ne : (Polynomial.X - Polynomial.C a_bar : Polynomial κ_A) ≠ 0 :=
            (Polynomial.monic_X_sub_C a_bar).ne_zero
          have hr_deg : r_bar.natDegree < n := by
            have h_deg_sum : n = 1 + r_bar.natDegree := by
              rw [← hq_deg, hr_bar, Polynomial.natDegree_mul hX_ne hr_ne,
                Polynomial.natDegree_X_sub_C]
            omega
          have hr_sep : r_bar.Separable := by
            rw [hr_bar] at hq_sep
            exact Polynomial.Separable.of_mul_right hq_sep
          have hr_splits : r_bar.Splits := ih r_bar.natDegree hr_deg r_bar rfl hr_sep
          have hq_splits : q_bar.Splits := by
            rw [hr_bar]
            exact Polynomial.Splits.mul (Polynomial.Splits.X_sub_C a_bar) hr_splits
          rw [hp_eq]
          exact Polynomial.Splits.mul (Polynomial.Splits.C c) hq_splits

  
  have h_pillar4 :
      ∀ (R₁ A M : Type u) [CommRing R₁] [CommRing A] [Algebra R₁ A] [CommRing M] [Algebra R₁ M]
        (J : Type u) [CategoryTheory.SmallCategory J] [CategoryTheory.IsFiltered J]
        (R_stage : J → Type u) [∀ j, CommRing (R_stage j)] [∀ j, Algebra R₁ (R_stage j)]
        (tr : ∀ {j₁ j₂ : J}, (j₁ ⟶ j₂) → (R_stage j₁ →ₐ[R₁] R_stage j₂))
        (ι : ∀ j : J, R_stage j →ₐ[R₁] A),
        (∀ j : J, tr (CategoryTheory.CategoryStruct.id j) = AlgHom.id R₁ (R_stage j)) →
        (∀ {j₁ j₂ j₃ : J} (f : j₁ ⟶ j₂) (g : j₂ ⟶ j₃),
          tr (CategoryTheory.CategoryStruct.comp f g) = (tr g).comp (tr f)) →
        (∀ {j₁ j₂ : J} (f : j₁ ⟶ j₂), (ι j₂).comp (tr f) = ι j₁) →
        (∀ a : A, ∃ (j : J) (r : R_stage j), ι j r = a) →
        (∀ (j : J) (r₁ r₂ : R_stage j),
          ι j r₁ = ι j r₂ → ∃ (k : J) (f : j ⟶ k), tr f r₁ = tr f r₂) →
        (∀ (r : ℕ) (e_A : Fin r → TensorProduct R₁ A M),
          CompleteOrthogonalIdempotents e_A →
          ∃ (k : J) (e_k : Fin r → TensorProduct R₁ (R_stage k) M),
            CompleteOrthogonalIdempotents e_k ∧
            ∀ m : Fin r,
              Algebra.TensorProduct.map (ι k) (AlgHom.id R₁ M) (e_k m) = e_A m) ∧
        (∀ (B₀ W₀ : Type u) [CommRing B₀] [CommRing W₀] [Algebra B₀ W₀]
            [Algebra.FinitePresentation B₀ W₀]
            (b_hom : B₀ →+* M) (α_A : W₀ →+* TensorProduct R₁ A M) (j₀ : J),
          α_A.comp (algebraMap B₀ W₀) =
            (Algebra.TensorProduct.includeRight : M →ₐ[R₁] TensorProduct R₁ A M).toRingHom.comp b_hom →
          ∃ (k : J) (_ : j₀ ⟶ k) (α_k : W₀ →+* TensorProduct R₁ (R_stage k) M),
            α_k.comp (algebraMap B₀ W₀) =
              (Algebra.TensorProduct.includeRight :
                M →ₐ[R₁] TensorProduct R₁ (R_stage k) M).toRingHom.comp b_hom ∧
            (Algebra.TensorProduct.map (ι k) (AlgHom.id R₁ M)).toRingHom.comp α_k = α_A) ∧
        (∀ (j₀ : J) (x : TensorProduct R₁ (R_stage j₀) M),
          Algebra.TensorProduct.map (ι j₀) (AlgHom.id R₁ M) x = 0 →
          ∃ (k : J) (u : j₀ ⟶ k),
            Algebra.TensorProduct.map (tr u) (AlgHom.id R₁ M) x = 0) := by
    intro R₁ A M _ _ _ _ _ J _ _ R_stage _ _ tr ι htr_id htr_comp hι_tr hSurj hEq
    let G_M : CategoryTheory.Functor J CommRingCat.{u} :=
      { obj := fun j => CommRingCat.of (TensorProduct R₁ (R_stage j) M)
        map := fun f =>
          CommRingCat.ofHom (Algebra.TensorProduct.map (tr f) (AlgHom.id R₁ M)).toRingHom
        map_id := fun j =>
          CommRingCat.hom_ext (RingHom.ext fun z => by
            change (Algebra.TensorProduct.map (tr (CategoryTheory.CategoryStruct.id j))
              (AlgHom.id R₁ M)) z = z
            rw [htr_id, Algebra.TensorProduct.map_id]
            rfl)
        map_comp := fun f g =>
          CommRingCat.hom_ext (RingHom.ext fun z => by
            change (Algebra.TensorProduct.map (tr (f ≫ g)) (AlgHom.id R₁ M)) z =
              (Algebra.TensorProduct.map (tr g) (AlgHom.id R₁ M))
                ((Algebra.TensorProduct.map (tr f) (AlgHom.id R₁ M)) z)
            rw [htr_comp, ← AlgHom.comp_id (AlgHom.id R₁ M), Algebra.TensorProduct.map_comp]
            rfl) }
    let q_M := CommRingCat.FilteredColimits.colimitCocone G_M
    let hq_M := CommRingCat.FilteredColimits.colimitCoconeIsColimit G_M
    let Q : Type u := q_M.pt
    letI : CommRing Q := inferInstanceAs (CommRing q_M.pt)
    let c_M : CategoryTheory.Limits.Cocone G_M :=
      { pt := CommRingCat.of (TensorProduct R₁ A M)
        ι :=
          { app := fun j =>
              CommRingCat.ofHom (Algebra.TensorProduct.map (ι j) (AlgHom.id R₁ M)).toRingHom
            naturality := fun {j₁ j₂} f =>
              CommRingCat.hom_ext (RingHom.ext fun z => by
                change (Algebra.TensorProduct.map (ι j₂) (AlgHom.id R₁ M))
                  ((Algebra.TensorProduct.map (tr f) (AlgHom.id R₁ M)) z) =
                  (Algebra.TensorProduct.map (ι j₁) (AlgHom.id R₁ M)) z
                rw [← AlgHom.comp_apply, ← Algebra.TensorProduct.map_comp, hι_tr, AlgHom.id_comp]) } }
    let Φ_hom : q_M.pt ⟶ c_M.pt := hq_M.desc c_M
    let j_arb : J := Classical.choice CategoryTheory.IsFiltered.nonempty
    letI : Algebra R₁ Q :=
      ((CommRingCat.Hom.hom (q_M.ι.app j_arb)).comp
        (algebraMap R₁ (TensorProduct R₁ (R_stage j_arb) M))).toAlgebra
    have hQ_incR : ∀ (j : J) (m : M),
        CommRingCat.Hom.hom (q_M.ι.app j) ((1 : R_stage j) ⊗ₜ[R₁] m) =
        CommRingCat.Hom.hom (q_M.ι.app j_arb) ((1 : R_stage j_arb) ⊗ₜ[R₁] m) := by
      intro j m
      let k : J := CategoryTheory.IsFiltered.max j_arb j
      let u₀ : j_arb ⟶ k := CategoryTheory.IsFiltered.leftToMax j_arb j
      let u₁ : j ⟶ k := CategoryTheory.IsFiltered.rightToMax j_arb j
      have hw₀ := congrArg (fun φ => CommRingCat.Hom.hom φ ((1 : R_stage j_arb) ⊗ₜ[R₁] m)) (q_M.w u₀).symm
      have hw₁ := congrArg (fun φ => CommRingCat.Hom.hom φ ((1 : R_stage j) ⊗ₜ[R₁] m)) (q_M.w u₁).symm
      have hu₀ : CommRingCat.Hom.hom (G_M.map u₀) ((1 : R_stage j_arb) ⊗ₜ[R₁] m) =
          (1 : R_stage k) ⊗ₜ[R₁] m := by
        change (tr u₀ 1) ⊗ₜ[R₁] m = 1 ⊗ₜ[R₁] m
        rw [map_one]
      have hu₁ : CommRingCat.Hom.hom (G_M.map u₁) ((1 : R_stage j) ⊗ₜ[R₁] m) =
          (1 : R_stage k) ⊗ₜ[R₁] m := by
        change (tr u₁ 1) ⊗ₜ[R₁] m = 1 ⊗ₜ[R₁] m
        rw [map_one]
      have h_eq₁ : CommRingCat.Hom.hom (q_M.ι.app j) ((1 : R_stage j) ⊗ₜ[R₁] m) =
          CommRingCat.Hom.hom (q_M.ι.app k) ((1 : R_stage k) ⊗ₜ[R₁] m) :=
        hw₁.trans (congrArg (CommRingCat.Hom.hom (q_M.ι.app k)) hu₁)
      have h_eq₀ : CommRingCat.Hom.hom (q_M.ι.app j_arb) ((1 : R_stage j_arb) ⊗ₜ[R₁] m) =
          CommRingCat.Hom.hom (q_M.ι.app k) ((1 : R_stage k) ⊗ₜ[R₁] m) :=
        hw₀.trans (congrArg (CommRingCat.Hom.hom (q_M.ι.app k)) hu₀)
      exact h_eq₁.trans h_eq₀.symm
    have h_alg_tmul : ∀ (j : J) (r₁ : R₁),
        algebraMap R₁ (TensorProduct R₁ (R_stage j) M) r₁ =
          (1 : R_stage j) ⊗ₜ[R₁] algebraMap R₁ M r₁ := by
      intro j r₁
      rw [Algebra.algebraMap_eq_smul_one, Algebra.TensorProduct.one_def,
        TensorProduct.smul_tmul', TensorProduct.smul_tmul, ← Algebra.algebraMap_eq_smul_one]
    let γ : ∀ j : J, R_stage j →ₐ[R₁] Q := fun j =>
      { (CommRingCat.Hom.hom (q_M.ι.app j)).comp
          (Algebra.TensorProduct.includeLeft :
            R_stage j →ₐ[R₁] TensorProduct R₁ (R_stage j) M).toRingHom with
        commutes' := fun r₁ => by
          change CommRingCat.Hom.hom (q_M.ι.app j) (algebraMap R₁ (R_stage j) r₁ ⊗ₜ[R₁] 1) =
            CommRingCat.Hom.hom (q_M.ι.app j_arb)
              (algebraMap R₁ (TensorProduct R₁ (R_stage j_arb) M) r₁)
          have h_left : (algebraMap R₁ (R_stage j) r₁ ⊗ₜ[R₁] (1 : M)) =
              (1 : R_stage j) ⊗ₜ[R₁] algebraMap R₁ M r₁ := by
            rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul,
              ← Algebra.algebraMap_eq_smul_one]
          rw [h_left, h_alg_tmul j_arb r₁]
          exact hQ_incR j (algebraMap R₁ M r₁) }
    have hγ_tr : ∀ {j₁ j₂ : J} (f : j₁ ⟶ j₂) (r : R_stage j₁),
        γ j₂ (tr f r) = γ j₁ r := by
      intro j₁ j₂ f r
      have hw := congrArg (fun φ => CommRingCat.Hom.hom φ (r ⊗ₜ[R₁] (1 : M))) (q_M.w f)
      exact hw
    have hγ_wd : ∀ (j₁ j₂ : J) (r₁ : R_stage j₁) (r₂ : R_stage j₂),
        ι j₁ r₁ = ι j₂ r₂ → γ j₁ r₁ = γ j₂ r₂ := by
      intro j₁ j₂ r₁ r₂ h_eq
      let m : J := CategoryTheory.IsFiltered.max j₁ j₂
      let u₁ : j₁ ⟶ m := CategoryTheory.IsFiltered.leftToMax j₁ j₂
      let u₂ : j₂ ⟶ m := CategoryTheory.IsFiltered.rightToMax j₁ j₂
      have h_eq_m : ι m (tr u₁ r₁) = ι m (tr u₂ r₂) := by
        have h1 : ι m (tr u₁ r₁) = ι j₁ r₁ := AlgHom.congr_fun (hι_tr u₁) r₁
        have h2 : ι m (tr u₂ r₂) = ι j₂ r₂ := AlgHom.congr_fun (hι_tr u₂) r₂
        rw [h1, h2, h_eq]
      obtain ⟨k, f, hf⟩ := hEq m (tr u₁ r₁) (tr u₂ r₂) h_eq_m
      calc
        γ j₁ r₁ = γ m (tr u₁ r₁) := (hγ_tr u₁ r₁).symm
        _ = γ k (tr f (tr u₁ r₁)) := (hγ_tr f _).symm
        _ = γ k (tr f (tr u₂ r₂)) := by rw [hf]
        _ = γ m (tr u₂ r₂) := hγ_tr f _
        _ = γ j₂ r₂ := hγ_tr u₂ r₂
    let α_L_fun : A → Q := fun a =>
      γ (Classical.choose (hSurj a)) (Classical.choose (Classical.choose_spec (hSurj a)))
    have hα_L_eq : ∀ (j : J) (r : R_stage j), α_L_fun (ι j r) = γ j r := by
      intro j r
      exact hγ_wd _ j _ r
        (Classical.choose_spec (Classical.choose_spec (hSurj (ι j r))))
    let α_L : A →ₐ[R₁] Q :=
      { toFun := α_L_fun
        map_one' := by
          rw [← (ι j_arb).map_one, hα_L_eq, map_one]
        map_mul' := fun a b => by
          obtain ⟨j₁, r₁, rfl⟩ := hSurj a
          obtain ⟨j₂, r₂, rfl⟩ := hSurj b
          let m : J := CategoryTheory.IsFiltered.max j₁ j₂
          let u₁ : j₁ ⟶ m := CategoryTheory.IsFiltered.leftToMax j₁ j₂
          let u₂ : j₂ ⟶ m := CategoryTheory.IsFiltered.rightToMax j₁ j₂
          have h1 : ι j₁ r₁ = ι m (tr u₁ r₁) := (AlgHom.congr_fun (hι_tr u₁) r₁).symm
          have h2 : ι j₂ r₂ = ι m (tr u₂ r₂) := (AlgHom.congr_fun (hι_tr u₂) r₂).symm
          rw [h1, h2, ← map_mul, hα_L_eq, hα_L_eq, hα_L_eq, map_mul]
        map_zero' := by
          rw [← (ι j_arb).map_zero, hα_L_eq, map_zero]
        map_add' := fun a b => by
          obtain ⟨j₁, r₁, rfl⟩ := hSurj a
          obtain ⟨j₂, r₂, rfl⟩ := hSurj b
          let m : J := CategoryTheory.IsFiltered.max j₁ j₂
          let u₁ : j₁ ⟶ m := CategoryTheory.IsFiltered.leftToMax j₁ j₂
          let u₂ : j₂ ⟶ m := CategoryTheory.IsFiltered.rightToMax j₁ j₂
          have h1 : ι j₁ r₁ = ι m (tr u₁ r₁) := (AlgHom.congr_fun (hι_tr u₁) r₁).symm
          have h2 : ι j₂ r₂ = ι m (tr u₂ r₂) := (AlgHom.congr_fun (hι_tr u₂) r₂).symm
          rw [h1, h2, ← map_add, hα_L_eq, hα_L_eq, hα_L_eq, map_add]
        commutes' := fun r₁ => by
          rw [← (ι j_arb).commutes r₁, hα_L_eq, (γ j_arb).commutes r₁] }
    let α_R : M →ₐ[R₁] Q :=
      { (CommRingCat.Hom.hom (q_M.ι.app j_arb)).comp
          (Algebra.TensorProduct.includeRight :
            M →ₐ[R₁] TensorProduct R₁ (R_stage j_arb) M).toRingHom with
        commutes' := fun r₁ => by
          change CommRingCat.Hom.hom (q_M.ι.app j_arb) ((1 : R_stage j_arb) ⊗ₜ[R₁] algebraMap R₁ M r₁) =
            CommRingCat.Hom.hom (q_M.ι.app j_arb)
              (algebraMap R₁ (TensorProduct R₁ (R_stage j_arb) M) r₁)
          rw [h_alg_tmul j_arb r₁] }
    let Ψ_alg : TensorProduct R₁ A M →ₐ[R₁] Q :=
      Algebra.TensorProduct.lift α_L α_R (fun _ _ => Commute.all _ _)
    let Ψ_hom : c_M.pt ⟶ q_M.pt := CommRingCat.ofHom Ψ_alg.toRingHom
    have hΨ_leg : ∀ (j : J) (z : TensorProduct R₁ (R_stage j) M),
        Ψ_alg (CommRingCat.Hom.hom (c_M.ι.app j) z) = CommRingCat.Hom.hom (q_M.ι.app j) z := by
      intro j z
      induction z using TensorProduct.inductionOn with
      | tmul r m =>
        change Ψ_alg ((ι j r) ⊗ₜ[R₁] m) = CommRingCat.Hom.hom (q_M.ι.app j) (r ⊗ₜ[R₁] m)
        rw [Algebra.TensorProduct.lift_tmul]
        have hL : α_L (ι j r) = CommRingCat.Hom.hom (q_M.ι.app j) (r ⊗ₜ[R₁] 1) := hα_L_eq j r
        have hR : α_R m = CommRingCat.Hom.hom (q_M.ι.app j) (1 ⊗ₜ[R₁] m) := (hQ_incR j m).symm
        rw [hL, hR, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      | add z₁ z₂ hz₁ hz₂ =>
        rw [map_add, map_add, hz₁, hz₂, map_add]
    have hΦΨ : Φ_hom ≫ Ψ_hom = 𝟙 q_M.pt := by
      apply hq_M.hom_ext
      intro j
      rw [← CategoryTheory.Category.assoc, hq_M.fac c_M j, CategoryTheory.Category.comp_id]
      exact CommRingCat.hom_ext (RingHom.ext fun z => hΨ_leg j z)
    have hΨΦ : Ψ_hom ≫ Φ_hom = 𝟙 c_M.pt := by
      refine CommRingCat.hom_ext (RingHom.ext fun w => ?_)
      induction w using TensorProduct.inductionOn with
      | tmul a m =>
        obtain ⟨j, r, rfl⟩ := hSurj a
        have h_c : ((ι j r) ⊗ₜ[R₁] m : TensorProduct R₁ A M) =
            CommRingCat.Hom.hom (c_M.ι.app j) (r ⊗ₜ[R₁] m) := rfl
        change CommRingCat.Hom.hom Φ_hom (Ψ_alg ((ι j r) ⊗ₜ[R₁] m)) = (ι j r) ⊗ₜ[R₁] m
        rw [h_c, hΨ_leg j (r ⊗ₜ[R₁] m)]
        exact congrArg (fun φ => CommRingCat.Hom.hom φ (r ⊗ₜ[R₁] m)) (hq_M.fac c_M j)
      | add w₁ w₂ hw₁ hw₂ =>
        change CommRingCat.Hom.hom (Ψ_hom ≫ Φ_hom) (w₁ + w₂) = w₁ + w₂
        rw [map_add]
        exact congrArg₂ (· + ·) hw₁ hw₂
    let e_cocone : q_M ≅ c_M :=
      CategoryTheory.Limits.Cocone.ext
        { hom := Φ_hom, inv := Ψ_hom, hom_inv_id := hΦΨ, inv_hom_id := hΨΦ }
        (fun j => hq_M.fac c_M j)
    let hc_M : CategoryTheory.Limits.IsColimit c_M :=
      CategoryTheory.Limits.IsColimit.ofIsoColimit hq_M e_cocone
    let ht_M := CategoryTheory.Limits.isColimitOfPreserves (CategoryTheory.forget CommRingCat.{u}) hc_M
    have hZero : ∀ (j₀ : J) (x : TensorProduct R₁ (R_stage j₀) M),
        Algebra.TensorProduct.map (ι j₀) (AlgHom.id R₁ M) x = 0 →
        ∃ (k : J) (u : j₀ ⟶ k),
          Algebra.TensorProduct.map (tr u) (AlgHom.id R₁ M) x = 0 := by
      intro j₀ x hx
      have hx' : (CategoryTheory.forget CommRingCat.{u}).map (c_M.ι.app j₀) x =
          (CategoryTheory.forget CommRingCat.{u}).map (c_M.ι.app j₀) 0 := by
        change Algebra.TensorProduct.map (ι j₀) (AlgHom.id R₁ M) x =
          Algebra.TensorProduct.map (ι j₀) (AlgHom.id R₁ M) 0
        rw [hx, map_zero]
      obtain ⟨k, u, v, huv⟩ :=
        (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff
          (G_M ⋙ CategoryTheory.forget CommRingCat.{u}) ht_M).mp hx'
      refine ⟨k, u, ?_⟩
      have hv0 : (CategoryTheory.forget CommRingCat.{u}).map (G_M.map v) 0 = 0 :=
        map_zero (Algebra.TensorProduct.map (tr v) (AlgHom.id R₁ M))
      exact huv.trans hv0
    have hZero_fin : ∀ {α : Type} [DecidableEq α] (s : Finset α) (k₀ : J)
        (y : α → TensorProduct R₁ (R_stage k₀) M),
        (∀ a ∈ s, Algebra.TensorProduct.map (ι k₀) (AlgHom.id R₁ M) (y a) = 0) →
        ∃ (k : J) (u : k₀ ⟶ k),
          ∀ a ∈ s, Algebra.TensorProduct.map (tr u) (AlgHom.id R₁ M) (y a) = 0 := by
      intro α _ s
      induction s using Finset.induction_on with
      | empty =>
        intro k₀ _ _
        exact ⟨k₀, 𝟙 k₀, fun _ h => False.elim (Finset.notMem_empty _ h)⟩
      | @insert a₀ s ha₀ ih =>
        intro k₀ y hy
        obtain ⟨k₁, u₁, hu₁⟩ := ih k₀ y (fun a ha => hy a (Finset.mem_insert_of_mem ha))
        let y_a₁ := Algebra.TensorProduct.map (tr u₁) (AlgHom.id R₁ M) (y a₀)
        have hy_a₁ : Algebra.TensorProduct.map (ι k₁) (AlgHom.id R₁ M) y_a₁ = 0 := by
          dsimp [y_a₁]
          rw [← AlgHom.comp_apply, ← Algebra.TensorProduct.map_comp, hι_tr u₁, AlgHom.id_comp]
          exact hy a₀ (Finset.mem_insert_self a₀ s)
        obtain ⟨k, u₂, hu₂⟩ := hZero k₁ y_a₁ hy_a₁
        refine ⟨k, u₁ ≫ u₂, fun a ha => ?_⟩
        rw [htr_comp, ← AlgHom.comp_id (AlgHom.id R₁ M),
          Algebra.TensorProduct.map_comp, AlgHom.comp_apply]
        rcases Finset.mem_insert.mp ha with rfl | ha_s
        · exact hu₂
        · rw [hu₁ a ha_s, map_zero]
    refine ⟨?_, ?_, hZero⟩
    · intro r e_A he_A
      have h_surj_M : ∀ m : Fin r,
          ∃ (j : J) (x : TensorProduct R₁ (R_stage j) M),
            Algebra.TensorProduct.map (ι j) (AlgHom.id R₁ M) x = e_A m :=
        fun m => CategoryTheory.Limits.Types.jointly_surjective_of_isColimit ht_M (e_A m)
      let idx : Fin r → J := fun m => Classical.choose (h_surj_M m)
      let x₀ : ∀ m : Fin r, TensorProduct R₁ (R_stage (idx m)) M :=
        fun m => Classical.choose (Classical.choose_spec (h_surj_M m))
      have hx₀ : ∀ m : Fin r,
          Algebra.TensorProduct.map (ι (idx m)) (AlgHom.id R₁ M) (x₀ m) = e_A m :=
        fun m => Classical.choose_spec (Classical.choose_spec (h_surj_M m))
      let O_set : Finset J := Finset.univ.image idx
      let k₀ : J := CategoryTheory.IsFiltered.sup O_set ∅
      let f_m : ∀ m : Fin r, idx m ⟶ k₀ := fun m =>
        CategoryTheory.IsFiltered.toSup O_set ∅ (Finset.mem_image_of_mem idx (Finset.mem_univ m))
      let e₀ : Fin r → TensorProduct R₁ (R_stage k₀) M := fun m =>
        Algebra.TensorProduct.map (tr (f_m m)) (AlgHom.id R₁ M) (x₀ m)
      have he₀_map : ∀ m : Fin r,
          Algebra.TensorProduct.map (ι k₀) (AlgHom.id R₁ M) (e₀ m) = e_A m := by
        intro m
        dsimp [e₀]
        rw [← AlgHom.comp_apply, ← Algebra.TensorProduct.map_comp, hι_tr (f_m m),
          AlgHom.id_comp, hx₀ m]
      let eq_fam : (Fin r × Fin r) ⊕ Unit → TensorProduct R₁ (R_stage k₀) M := fun p =>
        match p with
        | Sum.inl (m₁, m₂) => if m₁ = m₂ then e₀ m₁ * e₀ m₁ - e₀ m₁ else e₀ m₁ * e₀ m₂
        | Sum.inr () => (∑ m : Fin r, e₀ m) - 1
      have heq_zero : ∀ p ∈ (Finset.univ : Finset ((Fin r × Fin r) ⊕ Unit)),
          Algebra.TensorProduct.map (ι k₀) (AlgHom.id R₁ M) (eq_fam p) = 0 := by
        rintro (⟨m₁, m₂⟩ | ⟨⟨⟩⟩) _
        · dsimp [eq_fam]
          split_ifs with hm
          · subst hm
            rw [map_sub, map_mul, he₀_map, sub_eq_zero]
            exact he_A.idem m₁
          · rw [map_mul, he₀_map, he₀_map]
            exact he_A.ortho hm
        · dsimp [eq_fam]
          rw [map_sub, map_sum, map_one]
          simp_rw [he₀_map]
          rw [he_A.complete, sub_self]
      obtain ⟨k, u, hu⟩ := hZero_fin Finset.univ k₀ eq_fam heq_zero
      let e_k : Fin r → TensorProduct R₁ (R_stage k) M := fun m =>
        Algebra.TensorProduct.map (tr u) (AlgHom.id R₁ M) (e₀ m)
      refine ⟨k, e_k, ?_, ?_⟩
      · refine { idem := ?_, ortho := ?_, complete := ?_ }
        · intro m
          have h_m := hu (Sum.inl (m, m)) (Finset.mem_univ _)
          dsimp [eq_fam] at h_m
          rw [if_pos rfl, map_sub, map_mul] at h_m
          exact sub_eq_zero.mp h_m
        · intro m₁ m₂ hm
          have h_m := hu (Sum.inl (m₁, m₂)) (Finset.mem_univ _)
          dsimp [eq_fam] at h_m
          rw [if_neg hm, map_mul] at h_m
          exact h_m
        · have h_sum := hu (Sum.inr ()) (Finset.mem_univ _)
          dsimp [eq_fam] at h_sum
          rw [map_sub, map_sum, map_one] at h_sum
          exact sub_eq_zero.mp h_sum
      · intro m
        dsimp [e_k]
        rw [← AlgHom.comp_apply, ← Algebra.TensorProduct.map_comp, hι_tr u,
          AlgHom.id_comp, he₀_map m]
    · intro B₀ W₀ _ _ _ _ b_hom α_A j₀ hα_B₀
      let α_nat : (CategoryTheory.Functor.const J).obj (CommRingCat.of B₀) ⟶ G_M :=
        { app := fun j =>
            CommRingCat.ofHom
              ((Algebra.TensorProduct.includeRight :
                M →ₐ[R₁] TensorProduct R₁ (R_stage j) M).toRingHom.comp b_hom)
          naturality := fun {j₁ j₂} f =>
            CommRingCat.hom_ext (RingHom.ext fun b => by
              change (1 : R_stage j₂) ⊗ₜ[R₁] b_hom b =
                (tr f 1) ⊗ₜ[R₁] b_hom b
              rw [map_one]) }
      let f_BW : CommRingCat.of B₀ ⟶ CommRingCat.of W₀ :=
        CommRingCat.ofHom (algebraMap B₀ W₀)
      have h_fp : (CommRingCat.Hom.hom f_BW).FinitePresentation :=
        RingHom.finitePresentation_algebraMap.mpr inferInstance
      have h_comm_all : ∀ j : J,
          f_BW ≫ CommRingCat.ofHom α_A = α_nat.app j ≫ c_M.ι.app j := by
        intro j
        refine CommRingCat.hom_ext (RingHom.ext fun b => ?_)
        have hb := RingHom.congr_fun hα_B₀ b
        change α_A (algebraMap B₀ W₀ b) = ((ι j) 1) ⊗ₜ[R₁] b_hom b
        rw [map_one]
        exact hb
      obtain ⟨k₁, g_k₁, hg_B₀, hg_A⟩ :=
        RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit
          (CommRingCat.of B₀) G_M α_nat f_BW c_M hc_M h_fp (CommRingCat.ofHom α_A) h_comm_all
      let k : J := CategoryTheory.IsFiltered.max j₀ k₁
      let u : j₀ ⟶ k := CategoryTheory.IsFiltered.leftToMax j₀ k₁
      let v : k₁ ⟶ k := CategoryTheory.IsFiltered.rightToMax j₀ k₁
      let α_k : W₀ →+* TensorProduct R₁ (R_stage k) M :=
        (CommRingCat.Hom.hom (G_M.map v)).comp (CommRingCat.Hom.hom g_k₁)
      refine ⟨k, u, α_k, ?_, ?_⟩
      · have h1 : f_BW ≫ (g_k₁ ≫ G_M.map v) = α_nat.app k := by
          rw [← CategoryTheory.Category.assoc, hg_B₀]
          exact (α_nat.naturality v).symm
        exact RingHom.ext fun b => congrArg (fun φ => CommRingCat.Hom.hom φ b) h1
      · have h2 : (g_k₁ ≫ G_M.map v) ≫ c_M.ι.app k = CommRingCat.ofHom α_A := by
          rw [CategoryTheory.Category.assoc, c_M.w v, hg_A]
        exact RingHom.ext fun w => congrArg (fun φ => CommRingCat.Hom.hom φ w) h2

  
  obtain ⟨ℐ, instCatℐ, instFiltℐ, R_obj, instCommObj, instAlgObj, instEtObj,
    pt, tr, A, instCommA, hLocA, instAlgR₀A, instAlgAΩ, instTowerR₀AΩ, ι,
    hpt_R₀, htr_id, htr_comp, htr_et, htr_pt, hKerA, hι_pt, hι_tr, hSurj, hEq, hPres⟩ :=
    h_pillar2
  letI := instCatℐ
  letI := instFiltℐ
  letI := instCommObj
  letI := instAlgObj
  letI := instEtObj
  letI := instCommA
  letI := hLocA
  letI := instAlgR₀A
  letI := instAlgAΩ
  letI := instTowerR₀AΩ
  obtain ⟨hJac_nbhd, hSep_of_root1⟩ := h_pillar3

  
  have hJac_Ω : ∀ (d : ℕ) (g : Fin d → MvPolynomial (Fin d) A) (ω : Fin d → Ω),
      (∀ k : Fin d, MvPolynomial.eval₂ (algebraMap A Ω) ω (g k) = 0) →
      MvPolynomial.eval₂ (algebraMap A Ω) ω
        (Matrix.det (Matrix.of fun k l : Fin d => MvPolynomial.pderiv l (g k))) ≠ 0 →
      ∃ z : Fin d → A,
        (∀ k : Fin d, MvPolynomial.eval z (g k) = 0) ∧
        (∀ l : Fin d, algebraMap A Ω (z l) = ω l) := by
    intro d g ω hg0 hdet
    have h_poly_lift : ∀ p : MvPolynomial (Fin d) A,
        ∃ (i : ℐ) (q : MvPolynomial (Fin d) (R_obj i)),
          MvPolynomial.map (ι i).toRingHom q = p := by
      intro p
      induction p using MvPolynomial.induction_on' with
      | monomial m a =>
        obtain ⟨i, r, rfl⟩ := hSurj a
