        map_id := fun A => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro q
          obtain ⟨a, rfl⟩ := QuotientAddGroup.mk_surjective q
          rfl
        map_comp := fun {A B C} f g => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro q
          obtain ⟨a, rfl⟩ := QuotientAddGroup.mk_surjective q
          rfl }
