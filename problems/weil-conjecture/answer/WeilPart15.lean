    obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Gal(L'/F))
    letI hCG : CommGroup Gal(L'/F) :=
      { (inferInstance : Group Gal(L'/F)) with
        mul_comm := fun σ τ => by
          obtain ⟨a, rfl⟩ := hg σ
          obtain ⟨b, rfl⟩ := hg τ
          rw [← zpow_add, ← zpow_add, add_comm] }
    rcases Nat.even_or_odd m_deg with hm_even | hm_odd
    · haveI : NeZero m_deg := ⟨by omega⟩
      let SC_ev := Rep.FiniteCyclicGroup.normHomCompSub A g
      let e_ev := Rep.FiniteCyclicGroup.groupCohomologyIsoEven A g hg m_deg hm_even
      have hSC_ex : SC_ev.Exact := by
        rw [CategoryTheory.ShortComplex.moduleCat_exact_iff]
        intro x hx
