          have hRHS : (Scheme.ΓSpecIso T_cat).hom.hom (P_ring.map m_B.op (x_fam (f_p p) (hf_p p))) =
              TensorProduct.tmul A (1 : C) (b_sec p) := by
            have hcat : (π_B ≫ (hWp p).fromSpec).appTop ≫ (Scheme.ΓSpecIso T_cat).hom =
