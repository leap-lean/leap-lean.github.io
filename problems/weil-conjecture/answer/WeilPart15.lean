      _ = j (r₀ ^ n₂ * s₀) := by rw [map_mul, map_pow]
  have _ : IsLocalization 𝔮'.primeCompl (Localization.AtPrime q) :=
    { map_units := fun ⟨y, hy⟩ =>
        IsLocalization.map_units (Localization.AtPrime q) (⟨j y, hy⟩ : q.primeCompl)
      surj := fun z => by
        obtain ⟨⟨w, ⟨v, hv⟩⟩, hzv⟩ := IsLocalization.surj q.primeCompl z
        obtain ⟨N₁, s_w, hsw⟩ := hClear w
        obtain ⟨N₂, s_v, hsv⟩ := hClear v
        have hsv_not_q : j (s_v * r₀ ^ N₁) ∉ q := by
