      have he_Bm_one : e_Bm = 1 := by
        have h_sum : IsUnit ((1 - e_Bm) + e_Bm) := by
          rw [sub_add_cancel]
          exact isUnit_one
        have he_mul : e_Bm * (1 - e_Bm) = 0 := by
          rw [mul_sub, mul_one, he_Bm_idem, sub_self]
        rcases IsLocalRing.isUnit_or_isUnit_of_isUnit_add h_sum with hu1 | hu2
        · exfalso
          have he0 : e_Bm = 0 := by
            rcases hu1 with ⟨u, hu⟩
            calc
              e_Bm = e_Bm * 1 := (mul_one e_Bm).symm
              _ = e_Bm * (↑u * ↑u⁻¹) := by rw [Units.mul_inv]
              _ = (e_Bm * (1 - e_Bm)) * ↑u⁻¹ := by rw [← hu, mul_assoc]
              _ = 0 := by rw [he_mul, zero_mul]
          have he_A0 : e_A_W = 0 := ψ_m.injective (he0.trans (map_zero ψ_m).symm)
          have h10 : (1 : TensorProduct R₁ Ω (B₁ m)) = 0 := by
            rw [← he_A_Ω, he_A0, map_zero]
          have hmem1 : (1 : TensorProduct R₁ Ω (B₁ m)) ∈
              IsLocalRing.maximalIdeal (TensorProduct R₁ Ω (B₁ m)) := by
            rw [h10]
            exact Ideal.zero_mem _
          exact (IsLocalRing.mem_maximalIdeal 1).mp hmem1 isUnit_one
        · rcases hu2 with ⟨u, hu⟩
          have h1 : 1 - e_Bm = 0 := by
            calc
              1 - e_Bm = 1 * (1 - e_Bm) := (one_mul _).symm
              _ = (↑u⁻¹ * ↑u) * (1 - e_Bm) := by rw [Units.inv_mul]
              _ = ↑u⁻¹ * (e_Bm * (1 - e_Bm)) := by rw [hu, mul_assoc]
              _ = 0 := by rw [he_mul, mul_zero]
          exact (sub_eq_zero.mp h1).symm
      have he_A1 : e_A_W = 1 := ψ_m.injective (he_Bm_one.trans (map_one ψ_m).symm)
      have hx_A0 : Algebra.TensorProduct.map φ₂ (AlgHom.id R₁ (B₁ m)) x = 0 := by
        dsimp [x]
        rw [map_sub, map_one]
        exact sub_eq_zero.mpr he_A1.symm
      obtain ⟨R₃, _, _, _, _, _, _, _, _, hx_R₃⟩ := hφ₂_zero x hx_A0
      refine ⟨R₃, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
        inferInstance, inferInstance, inferInstance, ?_⟩
      let sp₂₃ := Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₂ R₃) (AlgHom.id R₁ (B₁ m))
      have he_R₃ : sp₂₃ e_W = 1 := by
        have hx0 : sp₂₃ (1 - e_W) = 0 := hx_R₃
        rw [map_sub, map_one, sub_eq_zero] at hx0
        exact hx0.symm
      ext w
      have hw := congrArg sp₂₃ (h_diff_kill w)
      rw [map_mul, map_sub, map_zero, he_R₃, mul_one, sub_eq_zero] at hw
      exact hw

theorem weil_etale_affine_geom_point_pbc_of_alg_descent (hArt : ∀ (Ω C₀ : Type u) [Field Ω] [IsAlgClosed Ω] [CommRing C₀] [Algebra Ω C₀]
      [Module.Finite Ω C₀],
      ∃ (r : ℕ) (Q : Fin r → Type u) (_ : ∀ m, CommRing (Q m)) (_ : ∀ m, Algebra Ω (Q m))
        (_ : C₀ ≃ₐ[Ω] (∀ m : Fin r, Q m)),
        ∀ m : Fin r, WeilLocalRingEtaleSectionLifting (Q m))
    (hDesc : ∀ (R₀ B₀ Ω : Type u) [CommRing R₀] [CommRing B₀] [Algebra R₀ B₀]
      [Module.Finite R₀ B₀] [Field Ω] [IsAlgClosed Ω] [Algebra R₀ Ω],
      WeilPointedEtaleClopenSplittingAndDescent R₀ B₀ Ω) :
    (∀ (Ω C₀ : Type u) [Field Ω] [IsAlgClosed Ω] [CommRing C₀] [Algebra Ω C₀]
      [Module.Finite Ω C₀],
      WeilEtalePushforwardPreservesEpi
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω C₀)))) ∧
    (∀ (R₀ B₀ Ω : Type u) [CommRing R₀] [CommRing B₀] [Algebra R₀ B₀]
      [Module.Finite R₀ B₀] [Field Ω] [IsAlgClosed Ω] [Algebra R₀ Ω],
      let C₀ := TensorProduct R₀ Ω B₀
      let f_aff := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₀))
      let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ Ω))
      let f₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeft : Ω →ₐ[R₀] C₀).toRingHom)
      let g'₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : B₀ →ₐ[R₀] C₀).toRingHom)
      ∀ (hpb₀ : CategoryTheory.IsPullback g'₀ f₀ f_aff s₀),
        WeilEtaleSquareDegreeZeroPBC f_aff s₀ f₀ g'₀ hpb₀) :=
by
  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  
  
  
  have h_etale_term : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S)) := by
    intro S
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom) trivial) ?_
    intro U m
    apply (AlgebraicGeometry.Scheme.Etale.forget S).map_injective
    apply CategoryTheory.Over.OverMorphism.ext
    exact (CategoryTheory.Category.comp_id m.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w m)

  have h_mem_etale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S W R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) S
      inferInstance inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)).trans hiff

  have h_cont : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂),
      (weilCompEtaleSitePullback h).IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology := by
    intro W₁ W₂ h
    have _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_h : CategoryTheory.Functor W₂.Etale W₁.Etale := weilCompEtaleSitePullback h
    have hT₂ := h_etale_term W₂
    have _ : CategoryTheory.Limits.HasTerminal W₂.Etale := hT₂.hasTerminal
    have _ : CategoryTheory.Limits.HasPullbacks W₂.Etale :=
      CategoryTheory.MorphismProperty.Over.hasPullbacks (@AlgebraicGeometry.Etale) W₂
    have _ : CategoryTheory.Limits.HasFiniteLimits W₂.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have _ : CategoryTheory.Limits.PreservesFiniteLimits B_h :=
      CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback
        (@AlgebraicGeometry.Etale) h
    have _ : CategoryTheory.RepresentablyFlat B_h :=
      CategoryTheory.flat_of_preservesFiniteLimits B_h
    have hCompat : CategoryTheory.CompatiblePreserving W₁.smallEtaleTopology B_h :=
      CategoryTheory.compatiblePreservingOfFlat W₁.smallEtaleTopology B_h
    have hCover : CategoryTheory.CoverPreserving W₂.smallEtaleTopology W₁.smallEtaleTopology B_h := by
      constructor
      intro U S hS
      have hS' := (h_mem_etale W₂ U S).mp hS
      refine (h_mem_etale W₁ (B_h.obj U) _).mpr ?_
      intro z
      let fst_U : (B_h.obj U).left ⟶ U.left := CategoryTheory.Limits.pullback.fst U.hom h
      obtain ⟨Y, f, y, hfS, hfEt, hy⟩ := hS' (fst_U.base z)
      have h_outer : CategoryTheory.IsPullback
          ((B_h.map f).left ≫ CategoryTheory.Limits.pullback.snd U.hom h)
          (CategoryTheory.Limits.pullback.fst Y.hom h) h (f.left ≫ U.hom) := by
        have hw₁ : (B_h.map f).left ≫ CategoryTheory.Limits.pullback.snd U.hom h =
            CategoryTheory.Limits.pullback.snd Y.hom h :=
          CategoryTheory.MorphismProperty.Over.w (B_h.map f)
        have hw₂ : f.left ≫ U.hom = Y.hom := CategoryTheory.MorphismProperty.Over.w f
        rw [hw₁, hw₂]
        exact (CategoryTheory.IsPullback.of_hasPullback Y.hom h).flip
      have h_comm_left : (B_h.map f).left ≫ fst_U =
          CategoryTheory.Limits.pullback.fst Y.hom h ≫ f.left := by
        dsimp [B_h, weilCompEtaleSitePullback, fst_U, CategoryTheory.MorphismProperty.Over.pullback]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h_right : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.snd U.hom h) fst_U h U.hom :=
        (CategoryTheory.IsPullback.of_hasPullback U.hom h).flip
      have hp_left : CategoryTheory.IsPullback
          (B_h.map f).left (CategoryTheory.Limits.pullback.fst Y.hom h) fst_U f.left :=
        CategoryTheory.IsPullback.of_right h_outer h_comm_left h_right
      let e_pb := hp_left.isoPullback
      obtain ⟨p, hp_fst, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hy.symm
      refine ⟨B_h.obj Y, B_h.map f, e_pb.inv.base p, ?_, ?_, ?_⟩
      · exact ⟨Y, f, 𝟙 (B_h.obj Y), hfS, (CategoryTheory.Category.id_comp _).symm⟩
      · exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hp_left.flip hfEt
      · have heq : e_pb.inv ≫ (B_h.map f).left =
            CategoryTheory.Limits.pullback.fst fst_U f.left := by
          rw [CategoryTheory.Iso.inv_comp_eq]
          exact (CategoryTheory.IsPullback.isoPullback_hom_fst hp_left).symm
        calc
          (B_h.map f).left.base (e_pb.inv.base p) = (e_pb.inv ≫ (B_h.map f).left).base p := rfl
          _ = (CategoryTheory.Limits.pullback.fst fst_U f.left).base p := by rw [heq]
          _ = z := hp_fst
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCover

  
  
  
  have h_local_top : ∀ (Q : Type u) [CommRing Q],
      WeilLocalRingEtaleSectionLifting Q →
      let Y := AlgebraicGeometry.Spec (CommRingCat.of Q)
      let T_Y : Y.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id Y)
      ∀ R ∈ Y.smallEtaleTopology T_Y, R = ⊤ := by
    intro Q _ hLiftPkg Y T_Y R hR
    rcases hLiftPkg with ⟨hLocQ, hLiftQ⟩
    have _ : IsLocalRing Q := hLocQ
    let z₀ : ↥Y := IsLocalRing.closedPoint Q
    obtain ⟨V, v, w₀, hvR, _, hvw₀⟩ := (h_mem_etale Y T_Y R).mp hR z₀
    have hv_eq : v.left = V.hom :=
      (CategoryTheory.Category.comp_id v.left).symm.trans (CategoryTheory.MorphismProperty.Over.w v)
    have hVw₀ : V.hom.base w₀ = z₀ := by rw [← hv_eq]; exact hvw₀
    obtain ⟨E_cat, j_W, hj_open, ⟨q₀, hq₀⟩, -⟩ :=
      AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
        (U := (⊤ : V.left.Opens)) (x := w₀) trivial
    have _ : AlgebraicGeometry.IsOpenImmersion j_W := hj_open
    have hEt_comp : AlgebraicGeometry.Etale (j_W ≫ V.hom) :=
      CategoryTheory.MorphismProperty.comp_mem _ j_W V.hom inferInstance V.prop
    let φ_cat : CommRingCat.of Q ⟶ E_cat :=
      (AlgebraicGeometry.Spec.fullyFaithful.preimage (j_W ≫ V.hom)).unop
    have hφ_map : AlgebraicGeometry.Spec.map φ_cat = j_W ≫ V.hom :=
      AlgebraicGeometry.Spec.fullyFaithful.map_preimage (j_W ≫ V.hom)
    have hφ_et : φ_cat.hom.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (by rw [hφ_map]; exact hEt_comp)
    let E : Type u := ↑E_cat
    let _ : Algebra Q E := φ_cat.hom.toAlgebra
    have hAlgEt : Algebra.Etale Q E := RingHom.etale_algebraMap.mp hφ_et
    have h_comap : Ideal.comap (algebraMap Q E) q₀.asIdeal = IsLocalRing.maximalIdeal Q := by
      change ((AlgebraicGeometry.Spec.map φ_cat).base q₀).asIdeal = IsLocalRing.maximalIdeal Q
      rw [hφ_map]
      change (V.hom.base (j_W.base q₀)).asIdeal = IsLocalRing.maximalIdeal Q
      rw [hq₀, hVw₀]
      rfl
    obtain ⟨σ_alg⟩ := @hLiftQ E _ _ hAlgEt ⟨q₀.asIdeal, q₀.isPrime, h_comap⟩
    let σ_cat : E_cat ⟶ CommRingCat.of Q := CommRingCat.ofHom σ_alg.toRingHom
    have hφσ : φ_cat ≫ σ_cat = 𝟙 (CommRingCat.of Q) := by
      ext r
      exact σ_alg.commutes r
    let σ : Y ⟶ V.left := AlgebraicGeometry.Spec.map σ_cat ≫ j_W
    have hσV : σ ≫ V.hom = 𝟙 Y := by
      dsimp [σ]
      rw [CategoryTheory.Category.assoc, ← hφ_map, ← AlgebraicGeometry.Spec.map_comp, hφσ,
        AlgebraicGeometry.Spec.map_id]
    have hEt_σ : AlgebraicGeometry.Etale σ :=
      CategoryTheory.MorphismProperty.of_postcomp
        (W := @AlgebraicGeometry.Etale)
        (W' := @AlgebraicGeometry.LocallyOfFiniteType ⊓ @AlgebraicGeometry.FormallyUnramified)
        σ V.hom ⟨inferInstance, inferInstance⟩
        (by rw [hσV]; infer_instance)
    let σ_et : T_Y ⟶ V := CategoryTheory.MorphismProperty.Over.homMk σ hσV trivial
    have hσv : σ_et ≫ v = 𝟙 T_Y := by
      apply (AlgebraicGeometry.Scheme.Etale.forget Y).map_injective
      apply CategoryTheory.Over.OverMorphism.ext
      change σ ≫ v.left = 𝟙 Y
      rw [hv_eq]
      exact hσV
    have hid : R.arrows (𝟙 T_Y) := by
      rw [← hσv]
      exact R.downward_closed hvR σ_et
    exact CategoryTheory.Sieve.id_mem_iff_eq_top.mp hid

  have h_sky_sheaf : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      (∀ R ∈ Y.smallEtaleTopology (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id Y)),
        R = ⊤) →
      ∀ (M : AddCommGrpCat.{u}),
        CategoryTheory.Presheaf.IsSheaf Y.smallEtaleTopology
          (weilEtaleTerminalSkyscraperPresheaf Y M) := by
    intro Y hTop M
    let T_Y : Y.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id Y)
    rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
    intro U S hS
    have hτ_mem : ∀ τ : (T_Y ⟶ U), S.arrows τ := by
      intro τ
      have hpb : S.pullback τ = ⊤ := hTop (S.pullback τ) (Y.smallEtaleTopology.pullback_stable τ hS)
      have hid : (S.pullback τ).arrows (𝟙 T_Y) := by rw [hpb]; trivial
      simpa [CategoryTheory.Sieve.pullback_apply] using hid
    let mkObj : ∀ τ : (T_Y ⟶ U), S.arrows.category :=
      fun τ => ⟨CategoryTheory.Over.mk τ, hτ_mem τ⟩
    refine ⟨{
      lift := fun s => CategoryTheory.Limits.Pi.lift (fun τ : (T_Y ⟶ S.arrows.cocone.pt) =>
        s.π.app (Opposite.op (mkObj τ)) ≫
          CategoryTheory.Limits.Pi.π (fun _ : (T_Y ⟶ T_Y) => M) (𝟙 T_Y))
      fac := fun s j => by
        apply CategoryTheory.Limits.Pi.hom_ext
        intro ρ
        let mor : mkObj (ρ ≫ j.unop.obj.hom) ⟶ j.unop :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk ρ rfl)
        have hw := s.w mor.op
        have hcomp := congrArg
          (fun k => k ≫ CategoryTheory.Limits.Pi.π (fun _ : (T_Y ⟶ T_Y) => M) (𝟙 T_Y)) hw
        change (s.π.app j ≫ CategoryTheory.Limits.Pi.lift (fun τ₁ : T_Y ⟶ T_Y =>
            CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ j.unop.obj.left => M) (τ₁ ≫ ρ))) ≫
            CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ T_Y => M) (𝟙 T_Y) =
          s.π.app (Opposite.op (mkObj (ρ ≫ j.unop.obj.hom))) ≫
            CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ T_Y => M) (𝟙 T_Y) at hcomp
        rw [CategoryTheory.Category.assoc] at hcomp
        simp only [CategoryTheory.Limits.limit.lift_π, CategoryTheory.Limits.Fan.mk_pt,
          CategoryTheory.Limits.Fan.mk_π_app, CategoryTheory.Category.id_comp] at hcomp
        change (CategoryTheory.Limits.Pi.lift (fun τ : T_Y ⟶ S.arrows.cocone.pt =>
            s.π.app (Opposite.op (mkObj τ)) ≫
              CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ T_Y => M) (𝟙 T_Y)) ≫
          CategoryTheory.Limits.Pi.lift (fun τ : T_Y ⟶ j.unop.obj.left =>
            CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ S.arrows.cocone.pt => M)
              (τ ≫ j.unop.obj.hom))) ≫
          CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ j.unop.obj.left => M) ρ =
          s.π.app j ≫ CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ j.unop.obj.left => M) ρ
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.limit.lift_π,
          CategoryTheory.Limits.Fan.mk_pt, CategoryTheory.Limits.Fan.mk_π_app]
        exact hcomp.symm
      uniq := fun s m hm => by
        apply CategoryTheory.Limits.Pi.hom_ext
        intro τ
        have hmτ := congrArg
          (fun k => k ≫ CategoryTheory.Limits.Pi.π (fun _ : (T_Y ⟶ T_Y) => M) (𝟙 T_Y))
          (hm (Opposite.op (mkObj τ)))
        change m ≫ ((CategoryTheory.Limits.Pi.lift fun τ₁ : T_Y ⟶ T_Y =>
            CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ S.arrows.cocone.pt => M) (τ₁ ≫ τ)) ≫
            CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ T_Y => M) (𝟙 T_Y)) =
          s.π.app (Opposite.op (mkObj τ)) ≫
            CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ T_Y => M) (𝟙 T_Y) at hmτ
        simp only [CategoryTheory.Limits.limit.lift_π, CategoryTheory.Limits.Fan.mk_pt,
          CategoryTheory.Limits.Fan.mk_π_app, CategoryTheory.Category.id_comp] at hmτ ⊢
        exact hmτ
    }⟩

  have h_sky_equiv : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      {M : AddCommGrpCat.{u}}
      (hS : CategoryTheory.Presheaf.IsSheaf Y.smallEtaleTopology
        (weilEtaleTerminalSkyscraperPresheaf Y M))
      (G : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
      let T_Y : Y.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id Y)
      (∀ (φ : G.obj.obj (Opposite.op T_Y) ⟶ M) (W : Y.Etale) (τ : T_Y ⟶ W),
        (weilAffGeomPbcSkyFromEv hS G φ).hom.app (Opposite.op W) ≫
          CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ W => M) τ = G.obj.map τ.op ≫ φ) ∧
      (∀ (φ : G.obj.obj (Opposite.op T_Y) ⟶ M),
        (weilAffGeomPbcSkyFromEv hS G φ).hom.app (Opposite.op T_Y) ≫
          CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ T_Y => M) (𝟙 T_Y) = φ) ∧
      (∀ (ψ : G ⟶ ⟨weilEtaleTerminalSkyscraperPresheaf Y M, hS⟩),
        weilAffGeomPbcSkyFromEv hS G (ψ.hom.app (Opposite.op T_Y) ≫
          CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ T_Y => M) (𝟙 T_Y)) = ψ) := by
    intro Y M hS G T_Y
    refine ⟨?_, ?_, ?_⟩
    · intro φ W τ
      change CategoryTheory.Limits.Pi.lift (fun τ' : T_Y ⟶ W => G.obj.map τ'.op ≫ φ) ≫
        CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ W => M) τ = G.obj.map τ.op ≫ φ
      simp only [CategoryTheory.Limits.limit.lift_π, CategoryTheory.Limits.Fan.mk_pt,
        CategoryTheory.Limits.Fan.mk_π_app]
    · intro φ
      change CategoryTheory.Limits.Pi.lift (fun τ' : T_Y ⟶ T_Y => G.obj.map τ'.op ≫ φ) ≫
        CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ T_Y => M) (𝟙 T_Y) = φ
      simp only [CategoryTheory.Limits.limit.lift_π, CategoryTheory.Limits.Fan.mk_pt,
        CategoryTheory.Limits.Fan.mk_π_app, op_id, G.obj.map_id, CategoryTheory.Category.id_comp]
    · intro ψ
      apply CategoryTheory.Sheaf.hom_ext
      ext W : 2
      rcases W with ⟨W⟩
      apply CategoryTheory.Limits.Pi.hom_ext
      intro τ
      change CategoryTheory.Limits.Pi.lift (fun τ' : T_Y ⟶ W => G.obj.map τ'.op ≫
          (ψ.hom.app (Opposite.op T_Y) ≫
            CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ T_Y => M) (𝟙 T_Y))) ≫
        CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ W => M) τ =
        ψ.hom.app (Opposite.op W) ≫ CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ W => M) τ
      simp only [CategoryTheory.Limits.limit.lift_π, CategoryTheory.Limits.Fan.mk_pt,
        CategoryTheory.Limits.Fan.mk_π_app]
      have hnat := ψ.hom.naturality τ.op
      rw [← CategoryTheory.Category.assoc, hnat, CategoryTheory.Category.assoc]
      change ψ.hom.app (Opposite.op W) ≫
        (CategoryTheory.Limits.Pi.lift (fun τ' : T_Y ⟶ T_Y =>
          CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ W => M) (τ' ≫ τ)) ≫
          CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ T_Y => M) (𝟙 T_Y)) = _
      simp only [CategoryTheory.Limits.limit.lift_π, CategoryTheory.Limits.Fan.mk_pt,
        CategoryTheory.Limits.Fan.mk_π_app, CategoryTheory.Category.id_comp]

  have h_local_epi : ∀ (Q : Type u) [CommRing Q],
      WeilLocalRingEtaleSectionLifting Q →
      let Y := AlgebraicGeometry.Spec (CommRingCat.of Q)
      let T_Y : Y.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id Y)
      ∀ {G₁ G₂ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
        (α : G₁ ⟶ G₂) [CategoryTheory.Epi α],
        CategoryTheory.Epi (α.hom.app (Opposite.op T_Y)) := by
    intro Q _ hLiftQ Y T_Y G₁ G₂ α _
    have hTop := h_local_top Q hLiftQ
    refine ⟨fun {M} g₁ g₂ hg => ?_⟩
    have hS := h_sky_sheaf Y hTop M
    have heq_sh : α ≫ weilAffGeomPbcSkyFromEv hS G₂ g₁ = α ≫ weilAffGeomPbcSkyFromEv hS G₂ g₂ := by
      rw [← (h_sky_equiv hS G₁).2.2 (α ≫ weilAffGeomPbcSkyFromEv hS G₂ g₁),
          ← (h_sky_equiv hS G₁).2.2 (α ≫ weilAffGeomPbcSkyFromEv hS G₂ g₂)]
      congr 1
      change (α.hom.app (Opposite.op T_Y) ≫ (weilAffGeomPbcSkyFromEv hS G₂ g₁).hom.app (Opposite.op T_Y)) ≫ _ =
        (α.hom.app (Opposite.op T_Y) ≫ (weilAffGeomPbcSkyFromEv hS G₂ g₂).hom.app (Opposite.op T_Y)) ≫ _
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        (h_sky_equiv hS G₂).2.1 g₁, (h_sky_equiv hS G₂).2.1 g₂, hg]
    have h_cancel := (CategoryTheory.cancel_epi α).mp heq_sh
    have h_g₁ := (h_sky_equiv hS G₂).2.1 g₁
    have h_g₂ := (h_sky_equiv hS G₂).2.1 g₂
    exact h_g₁.symm.trans ((congrArg (fun k : G₂ ⟶ ⟨weilEtaleTerminalSkyscraperPresheaf Y M, hS⟩ =>
      k.hom.app (Opposite.op T_Y) ≫ CategoryTheory.Limits.Pi.π (fun _ : T_Y ⟶ T_Y => M) (𝟙 T_Y)) h_cancel).trans h_g₂)

  have h_algClosed_pkg : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      let S₀ := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let T₀ : S₀.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S₀)
      WeilLocalRingEtaleSectionLifting Ω ∧
      (∀ {H₁ H₂ : CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}} (β : H₁ ⟶ H₂),
        CategoryTheory.Epi (β.hom.app (Opposite.op T₀)) → CategoryTheory.Epi β) ∧
      (∀ {H₁ H₂ : CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}} (β : H₁ ⟶ H₂),
        (∀ (M : AddCommGrpCat.{u})
          (hS : CategoryTheory.Presheaf.IsSheaf S₀.smallEtaleTopology
            (weilEtaleTerminalSkyscraperPresheaf S₀ M)),
          Function.Bijective (fun ψ : H₂ ⟶ ⟨weilEtaleTerminalSkyscraperPresheaf S₀ M, hS⟩ => β ≫ ψ)) →
        CategoryTheory.IsIso β) := by
    intro Ω _ _ S₀ T₀
    have h_pt_hit : ∀ (E : Type u) [CommRing E] [Algebra Ω E] [Algebra.Etale Ω E]
        (q : Ideal E) [q.IsPrime],
        ∃ σ : E →ₐ[Ω] Ω, Ideal.comap σ.toRingHom (⊥ : Ideal Ω) = q := by
      intro E _ _ _ q _
      let Sq := Localization.AtPrime q
      let κΩ := IsLocalRing.ResidueField Ω
      let κSq := IsLocalRing.ResidueField Sq
      have _ : Module.Finite Ω κΩ :=
        Module.Finite.of_surjective (Algebra.linearMap Ω κΩ) Ideal.Quotient.mk_surjective
      have _ : Module.Finite Ω κSq := Module.Finite.trans κΩ κSq
      have _ : Algebra.IsIntegral Ω κSq := Algebra.IsIntegral.of_finite Ω κSq
      have hbij_κ : Function.Bijective (algebraMap Ω κSq) :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral
      let e_κ : Ω ≃ₐ[Ω] κSq := AlgEquiv.ofBijective (Algebra.ofId Ω κSq) hbij_κ
      let to_κSq : E →ₐ[Ω] κSq :=
        { toRingHom := (IsLocalRing.residue Sq).comp (algebraMap E Sq)
          commutes' := fun c => by
            change IsLocalRing.residue Sq (algebraMap E Sq (algebraMap Ω E c)) = algebraMap Ω κSq c
            rw [← IsScalarTower.algebraMap_apply Ω E Sq]
            rfl }
      let σ : E →ₐ[Ω] Ω := e_κ.symm.toAlgHom.comp to_κSq
      have h_max : Ideal.comap (algebraMap E Sq) (IsLocalRing.maximalIdeal Sq) = q :=
        IsLocalization.AtPrime.under_maximalIdeal Sq q
      refine ⟨σ, ?_⟩
      ext x
      simp only [Ideal.mem_comap, Ideal.mem_bot]
      change e_κ.symm (IsLocalRing.residue Sq (algebraMap E Sq x)) = 0 ↔ x ∈ q
      rw [map_eq_zero_iff e_κ.symm e_κ.symm.injective]
      change Ideal.Quotient.mk (IsLocalRing.maximalIdeal Sq) (algebraMap E Sq x) = 0 ↔ x ∈ q
      rw [Ideal.Quotient.eq_zero_iff_mem, ← Ideal.mem_comap, h_max]
    have hLiftΩ : WeilLocalRingEtaleSectionLifting Ω := by
      refine ⟨inferInstance, fun E _ _ _ ⟨q, hq_prime, _⟩ => ?_⟩
      have _ : q.IsPrime := hq_prime
      obtain ⟨σ, _⟩ := h_pt_hit E q
      exact ⟨σ⟩
    have h_cov_S₀ : ∀ (U : S₀.Etale),
        ∃ (τ : ↥U.left → (T₀ ⟶ U)),
          CategoryTheory.Sieve.generate
            (CategoryTheory.Presieve.ofArrows (fun _ : ↥U.left => T₀) τ) ∈
            S₀.smallEtaleTopology U := by
      intro U
      have h_ex : ∀ x : ↥U.left, ∃ τ : T₀ ⟶ U,
          AlgebraicGeometry.Etale τ.left ∧ ∃ y : ↥S₀, τ.left.base y = x := by
        intro x
        obtain ⟨E_cat, j_W, hj_open, ⟨q₀, hq₀⟩, -⟩ :=
          AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
            (U := (⊤ : U.left.Opens)) (x := x) trivial
        have _ : AlgebraicGeometry.IsOpenImmersion j_W := hj_open
        have hEt_comp : AlgebraicGeometry.Etale (j_W ≫ U.hom) :=
          CategoryTheory.MorphismProperty.comp_mem _ j_W U.hom inferInstance U.prop
        let φ_cat : CommRingCat.of Ω ⟶ E_cat :=
          (AlgebraicGeometry.Spec.fullyFaithful.preimage (j_W ≫ U.hom)).unop
        have hφ_map : AlgebraicGeometry.Spec.map φ_cat = j_W ≫ U.hom :=
          AlgebraicGeometry.Spec.fullyFaithful.map_preimage (j_W ≫ U.hom)
        have hφ_et : φ_cat.hom.Etale :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
            (by rw [hφ_map]; exact hEt_comp)
        let E : Type u := ↑E_cat
        let _ : Algebra Ω E := φ_cat.hom.toAlgebra
        have _ : Algebra.Etale Ω E := RingHom.etale_algebraMap.mp hφ_et
        have _ : q₀.asIdeal.IsPrime := q₀.isPrime
        obtain ⟨σ_alg, hσ_ker⟩ := h_pt_hit E q₀.asIdeal
        let σ_cat : E_cat ⟶ CommRingCat.of Ω := CommRingCat.ofHom σ_alg.toRingHom
        have hφσ : φ_cat ≫ σ_cat = 𝟙 (CommRingCat.of Ω) := by
          ext c
          exact σ_alg.commutes c
        let σ : S₀ ⟶ U.left := AlgebraicGeometry.Spec.map σ_cat ≫ j_W
        have hσU : σ ≫ U.hom = 𝟙 S₀ := by
          dsimp [σ]
          rw [CategoryTheory.Category.assoc, ← hφ_map, ← AlgebraicGeometry.Spec.map_comp, hφσ,
            AlgebraicGeometry.Spec.map_id]
        have hEt_σ : AlgebraicGeometry.Etale σ :=
          CategoryTheory.MorphismProperty.of_postcomp
            (W := @AlgebraicGeometry.Etale)
            (W' := @AlgebraicGeometry.LocallyOfFiniteType ⊓ @AlgebraicGeometry.FormallyUnramified)
            σ U.hom ⟨inferInstance, inferInstance⟩
            (by rw [hσU]; infer_instance)
        let τ_x : T₀ ⟶ U := CategoryTheory.MorphismProperty.Over.homMk σ hσU trivial
        let y₀ : ↥S₀ := IsLocalRing.closedPoint Ω
        have hy₀_bot : y₀.asIdeal = (⊥ : Ideal Ω) := by
          rw [eq_bot_iff]
          intro c hc
          by_contra hc0
          exact y₀.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem y₀.asIdeal hc (IsUnit.mk0 c hc0))
        have hy₀ : τ_x.left.base y₀ = x := by
          change j_W.base ((AlgebraicGeometry.Spec.map σ_cat).base y₀) = x
          have hq_eq : (AlgebraicGeometry.Spec.map σ_cat).base y₀ = q₀ := by
            apply PrimeSpectrum.ext
            change Ideal.comap σ_alg.toRingHom y₀.asIdeal = q₀.asIdeal
            rw [hy₀_bot, hσ_ker]
          rw [hq_eq, hq₀]
        exact ⟨τ_x, hEt_σ, y₀, hy₀⟩
      choose τ hEt_τ y_τ hy_τ using h_ex
      refine ⟨τ, (h_mem_etale S₀ U _).mpr ?_⟩
      intro x
      exact ⟨T₀, τ x, y_τ x, ⟨T₀, 𝟙 T₀, τ x, ⟨x⟩, CategoryTheory.Category.id_comp _⟩,
        hEt_τ x, hy_τ x⟩
    have h_faithful : ∀ {H₁ H₂ : CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}}
        (φ₁ φ₂ : H₁ ⟶ H₂),
        φ₁.hom.app (Opposite.op T₀) = φ₂.hom.app (Opposite.op T₀) → φ₁ = φ₂ := by
      intro H₁ H₂ φ₁ φ₂ h_eq
      apply CategoryTheory.Sheaf.hom_ext
      ext U_op : 2
      rcases U_op with ⟨U⟩
      obtain ⟨τ, hS_U⟩ := h_cov_S₀ U
      refine CategoryTheory.Presheaf.IsSheaf.hom_ext H₂.property
        (⟨_, hS_U⟩ : S₀.smallEtaleTopology.Cover U) _ _ ?_
      intro I
      rcases I.hf with ⟨Z, g, u, ⟨x⟩, hgu⟩
      have h_id : I.f = g ≫ τ x := hgu.symm
      rw [h_id, op_comp, H₂.obj.map_comp, ← CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc, ← φ₁.hom.naturality (τ x).op,
        ← φ₂.hom.naturality (τ x).op, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, h_eq]
    have h_refl_epi : ∀ {H₁ H₂ : CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}}
        (β : H₁ ⟶ H₂),
        CategoryTheory.Epi (β.hom.app (Opposite.op T₀)) → CategoryTheory.Epi β := by
      intro H₁ H₂ β hEpi₀
      refine ⟨fun {H₃} γ₁ γ₂ hγ => h_faithful γ₁ γ₂ ?_⟩
      have hγ₀ : β.hom.app (Opposite.op T₀) ≫ γ₁.hom.app (Opposite.op T₀) =
          β.hom.app (Opposite.op T₀) ≫ γ₂.hom.app (Opposite.op T₀) :=
        congrArg (fun k : H₁ ⟶ H₃ => k.hom.app (Opposite.op T₀)) hγ
      exact (CategoryTheory.cancel_epi (β.hom.app (Opposite.op T₀))).mp hγ₀
    have h_refl_mono : ∀ {H₁ H₂ : CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}}
        (β : H₁ ⟶ H₂),
        CategoryTheory.Mono (β.hom.app (Opposite.op T₀)) → CategoryTheory.Mono β := by
      intro H₁ H₂ β hMono₀
      refine ⟨fun {H₀} γ₁ γ₂ hγ => h_faithful γ₁ γ₂ ?_⟩
      have hγ₀ : γ₁.hom.app (Opposite.op T₀) ≫ β.hom.app (Opposite.op T₀) =
          γ₂.hom.app (Opposite.op T₀) ≫ β.hom.app (Opposite.op T₀) :=
        congrArg (fun k : H₀ ⟶ H₂ => k.hom.app (Opposite.op T₀)) hγ
      exact (CategoryTheory.cancel_mono (β.hom.app (Opposite.op T₀))).mp hγ₀
    have h_refl_iso : ∀ {H₁ H₂ : CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}}
        (β : H₁ ⟶ H₂),
        CategoryTheory.IsIso (β.hom.app (Opposite.op T₀)) → CategoryTheory.IsIso β := by
      intro H₁ H₂ β hIso₀
      let _ : CategoryTheory.Abelian (CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}) :=
        inferInstance
      have _ : CategoryTheory.Mono β := h_refl_mono β inferInstance
      have _ : CategoryTheory.Epi β := h_refl_epi β inferInstance
      exact CategoryTheory.isIso_of_mono_of_epi β
    refine ⟨hLiftΩ, @h_refl_epi, ?_⟩
    intro H₁ H₂ β hBijSky
    apply CategoryTheory.isIso_of_coyoneda_map_bijective
    intro T
    have hTop₀ := h_local_top Ω hLiftΩ
    let M_T := T.obj.obj (Opposite.op T₀)
    have hS_T := h_sky_sheaf S₀ hTop₀ M_T
    let η_T : T ⟶ ⟨weilEtaleTerminalSkyscraperPresheaf S₀ M_T, hS_T⟩ :=
      weilAffGeomPbcSkyFromEv hS_T T (𝟙 M_T)
    have hT₀_term := h_etale_term S₀
    have hIso_η₀ : CategoryTheory.IsIso (η_T.hom.app (Opposite.op T₀)) := by
      let π_id := CategoryTheory.Limits.Pi.π (fun _ : T₀ ⟶ T₀ => M_T) (𝟙 T₀)
      refine ⟨⟨π_id, (h_sky_equiv hS_T T).2.1 (𝟙 M_T), ?_⟩⟩
      apply CategoryTheory.Limits.Pi.hom_ext
      intro τ
      have hτ : τ = 𝟙 T₀ := hT₀_term.hom_ext τ (𝟙 T₀)
      subst hτ
      rw [CategoryTheory.Category.assoc, (h_sky_equiv hS_T T).2.1 (𝟙 M_T),
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    have _ : CategoryTheory.IsIso η_T := h_refl_iso η_T hIso_η₀
    let e_η := CategoryTheory.asIso η_T
    have hBij_M := hBijSky M_T hS_T
    constructor
    · intro ξ₁ ξ₂ hξ
      dsimp only at hξ
      have h_eq : β ≫ (ξ₁ ≫ e_η.hom) = β ≫ (ξ₂ ≫ e_η.hom) := by
        rw [← CategoryTheory.Category.assoc, hξ, CategoryTheory.Category.assoc]
      have h_eq' := hBij_M.1 h_eq
      exact (CategoryTheory.Iso.cancel_iso_hom_right ξ₁ ξ₂ e_η).mp h_eq'
    · intro ξ
      obtain ⟨ψ, hψ⟩ := hBij_M.2 (ξ ≫ e_η.hom)
      dsimp only at hψ
      refine ⟨ψ ≫ e_η.inv, ?_⟩
      change β ≫ (ψ ≫ e_η.inv) = ξ
      rw [← CategoryTheory.Category.assoc, hψ, CategoryTheory.Category.assoc,
        e_η.hom_inv_id, CategoryTheory.Category.comp_id]

  
  
  
  have h_slice_cont : ∀ {Y X : AlgebraicGeometry.Scheme.{u}} (ι : Y ⟶ X)
      (hEt : AlgebraicGeometry.Etale ι),
      (weilAffGeomPbcSliceMap hEt).IsContinuous Y.smallEtaleTopology X.smallEtaleTopology := by
    intro Y X ι hEt
    let L_ι : CategoryTheory.Functor Y.Etale X.Etale := weilAffGeomPbcSliceMap hEt
    have hCompat : CategoryTheory.CompatiblePreserving X.smallEtaleTopology L_ι := by
      refine CategoryTheory.CompatiblePreserving.mk ?_
      intro ℱ Z T x hx Y₁ Y₂ W_X f₁ f₂ g₁ g₂ hg₁ hg₂ hcomm
      let f₁_left : W_X.left ⟶ Y₁.left := f₁.left
      let f₂_left : W_X.left ⟶ Y₂.left := f₂.left
      have hEt_WY : AlgebraicGeometry.Etale (f₁_left ≫ Y₁.hom) := by
        have hcomp : (f₁_left ≫ Y₁.hom) ≫ ι = W_X.hom :=
          (CategoryTheory.Category.assoc _ _ _).trans (CategoryTheory.MorphismProperty.Over.w f₁)
        exact CategoryTheory.MorphismProperty.of_postcomp
          (W := @AlgebraicGeometry.Etale)
          (W' := @AlgebraicGeometry.LocallyOfFiniteType ⊓ @AlgebraicGeometry.FormallyUnramified)
          (f₁_left ≫ Y₁.hom) ι ⟨inferInstance, inferInstance⟩
          (by rw [hcomp]; exact W_X.prop)
      let W_Y : Y.Etale := AlgebraicGeometry.Scheme.Etale.mk (f₁_left ≫ Y₁.hom)
      let e_W : W_X ≅ L_ι.obj W_Y :=
        CategoryTheory.MorphismProperty.Over.isoMk (CategoryTheory.Iso.refl W_X.left)
          ((CategoryTheory.Category.id_comp ((L_ι.obj W_Y).hom)).trans
            ((CategoryTheory.Category.assoc f₁_left Y₁.hom ι).trans
              (CategoryTheory.MorphismProperty.Over.w f₁)))
      let f'₁ : W_Y ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk f₁_left rfl trivial
      have hw₂ : f₂_left ≫ Y₂.hom = W_Y.hom := by
        have hg₁_w : g₁.left ≫ Z.hom = Y₁.hom := CategoryTheory.MorphismProperty.Over.w g₁
        have hg₂_w : g₂.left ≫ Z.hom = Y₂.hom := CategoryTheory.MorphismProperty.Over.w g₂
        have hcomm_left : f₁_left ≫ g₁.left = f₂_left ≫ g₂.left :=
          congrArg CategoryTheory.CommaMorphism.left
            (congrArg (AlgebraicGeometry.Scheme.Etale.forget X).map hcomm)
        change f₂_left ≫ Y₂.hom = f₁_left ≫ Y₁.hom
        rw [← hg₂_w, ← CategoryTheory.Category.assoc, ← hcomm_left,
          CategoryTheory.Category.assoc, hg₁_w]
      let f'₂ : W_Y ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk f₂_left hw₂ trivial
      have hcomm' : f'₁ ≫ g₁ = f'₂ ≫ g₂ := by
        apply (AlgebraicGeometry.Scheme.Etale.forget Y).map_injective
        apply CategoryTheory.Over.OverMorphism.ext
        change f₁.left ≫ (L_ι.map g₁).left = f₂.left ≫ (L_ι.map g₂).left
        exact congrArg CategoryTheory.CommaMorphism.left
          (congrArg (AlgebraicGeometry.Scheme.Etale.forget X).map hcomm)
      have hf₁_eq : f₁ = e_W.hom ≫ L_ι.map f'₁ := by
        apply (AlgebraicGeometry.Scheme.Etale.forget X).map_injective
        apply CategoryTheory.Over.OverMorphism.ext
        exact (CategoryTheory.Category.id_comp f₁.left).symm
      have hf₂_eq : f₂ = e_W.hom ≫ L_ι.map f'₂ := by
        apply (AlgebraicGeometry.Scheme.Etale.forget X).map_injective
        apply CategoryTheory.Over.OverMorphism.ext
        exact (CategoryTheory.Category.id_comp f₂.left).symm
      have h_compat_Y := hx f'₁ f'₂ hg₁ hg₂ hcomm'
      rw [hf₁_eq, hf₂_eq, op_comp, op_comp, ℱ.obj.map_comp, ℱ.obj.map_comp]
      exact congrArg (ℱ.obj.map e_W.hom.op) h_compat_Y
    have hCover : CategoryTheory.CoverPreserving Y.smallEtaleTopology X.smallEtaleTopology L_ι := by
      constructor
      intro U S hS
      have hS' := (h_mem_etale Y U S).mp hS
      refine (h_mem_etale X (L_ι.obj U) _).mpr ?_
      intro x
      let x' : ↥U.left := x
      obtain ⟨V, f, y, hfS, hfEt, hy⟩ := hS' x'
      let y' : ↥(L_ι.obj V).left := y
      exact ⟨L_ι.obj V, L_ι.map f, y',
        ⟨V, f, 𝟙 (L_ι.obj V), hfS, (CategoryTheory.Category.id_comp _).symm⟩,
        hfEt, hy⟩
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCover

  have h_slice_adj : ∀ {Y X : AlgebraicGeometry.Scheme.{u}} (ι : Y ⟶ X)
      (hEt : AlgebraicGeometry.Etale ι),
      let L_ι : CategoryTheory.Functor Y.Etale X.Etale := weilAffGeomPbcSliceMap hEt
      let B_ι : CategoryTheory.Functor X.Etale Y.Etale := weilCompEtaleSitePullback ι
      letI : L_ι.IsContinuous Y.smallEtaleTopology X.smallEtaleTopology := h_slice_cont ι hEt
      ∀ [B_ι.IsContinuous X.smallEtaleTopology Y.smallEtaleTopology],
        let j_star := L_ι.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology X.smallEtaleTopology
        let pf_ι := B_ι.sheafPushforwardContinuous AddCommGrpCat.{u}
          X.smallEtaleTopology Y.smallEtaleTopology
        (∀ {G₁ G₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
          (α : G₁ ⟶ G₂) [CategoryTheory.Epi α], CategoryTheory.Epi (j_star.map α)) ∧
        (∀ (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
          (H : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
          ∃ equiv_ι : (j_star.obj G ⟶ H) ≃ (G ⟶ pf_ι.obj H),
            ∀ (φ : j_star.obj G ⟶ H) (V : X.Etale),
              (equiv_ι φ).hom.app (Opposite.op V) =
                G.obj.map (Opposite.op
                  (CategoryTheory.MorphismProperty.Over.homMk
                    (CategoryTheory.Limits.pullback.fst V.hom ι :
                      (L_ι.obj (B_ι.obj V)).left ⟶ V.left)
                    CategoryTheory.Limits.pullback.condition trivial : L_ι.obj (B_ι.obj V) ⟶ V)) ≫
                  φ.hom.app (Opposite.op (B_ι.obj V))) := by
    intro Y X ι hEt L_ι B_ι _
    have _ : L_ι.IsContinuous Y.smallEtaleTopology X.smallEtaleTopology := h_slice_cont ι hEt
    let j_star := L_ι.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y.smallEtaleTopology X.smallEtaleTopology
    let pf_ι := B_ι.sheafPushforwardContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology Y.smallEtaleTopology
    have _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) ι :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) ι :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    have _ : (⊤ : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}).HasOfPostcompProperty ⊤ :=
      ⟨fun _ _ _ _ => trivial⟩
    let adj_site : L_ι ⊣ B_ι :=
      CategoryTheory.MorphismProperty.Over.mapPullbackAdj
        (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
        ⊤ ι hEt trivial
    let adj_pre := adj_site.op.whiskerLeft AddCommGrpCat.{u}
    let to_pf : ∀ {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        {H : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}},
        (j_star.obj G ⟶ H) → (G ⟶ pf_ι.obj H) :=
      fun {G H} φ =>
        CategoryTheory.ObjectProperty.homMk ((adj_pre.homEquiv G.obj H.obj) φ.hom)
    let from_pf : ∀ {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        {H : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}},
        (G ⟶ pf_ι.obj H) → (j_star.obj G ⟶ H) :=
      fun {G H} ψ =>
        CategoryTheory.ObjectProperty.homMk ((adj_pre.homEquiv G.obj H.obj).symm ψ.hom)
    have h_left : ∀ {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        {H : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
        (φ : j_star.obj G ⟶ H), from_pf (to_pf φ) = φ := by
      intro G H φ
      apply CategoryTheory.Sheaf.hom_ext
      exact (adj_pre.homEquiv G.obj H.obj).symm_apply_apply φ.hom
    have h_right : ∀ {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        {H : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
        (ψ : G ⟶ pf_ι.obj H), to_pf (from_pf ψ) = ψ := by
      intro G H ψ
      apply CategoryTheory.Sheaf.hom_ext
      exact (adj_pre.homEquiv G.obj H.obj).apply_symm_apply ψ.hom
    refine ⟨?_, ?_⟩
    · intro G₁ G₂ α _
      refine ⟨fun {H} φ₁ φ₂ hφ => ?_⟩
      have h_eq : α ≫ to_pf φ₁ = α ≫ to_pf φ₂ := by
        apply CategoryTheory.Sheaf.hom_ext
        ext V : 2
        rcases V with ⟨V⟩
        have h1 : α.hom.app (Opposite.op (L_ι.obj (B_ι.obj V))) ≫
            φ₁.hom.app (Opposite.op (B_ι.obj V)) =
          α.hom.app (Opposite.op (L_ι.obj (B_ι.obj V))) ≫
            φ₂.hom.app (Opposite.op (B_ι.obj V)) :=
          congrArg (fun k : j_star.obj G₁ ⟶ H => k.hom.app (Opposite.op (B_ι.obj V))) hφ
        have h_nat : α.hom.app (Opposite.op V) ≫ G₂.obj.map (adj_site.counit.app V).op =
            G₁.obj.map (adj_site.counit.app V).op ≫ α.hom.app (Opposite.op (L_ι.obj (B_ι.obj V))) :=
          (α.hom.naturality (adj_site.counit.app V).op).symm
        change α.hom.app (Opposite.op V) ≫
            ((G₂.obj.map (adj_site.counit.app V).op ≫ 𝟙 _) ≫ φ₁.hom.app (Opposite.op (B_ι.obj V))) =
          α.hom.app (Opposite.op V) ≫
            ((G₂.obj.map (adj_site.counit.app V).op ≫ 𝟙 _) ≫ φ₂.hom.app (Opposite.op (B_ι.obj V)))
        simp only [CategoryTheory.Category.comp_id]
        exact (CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ φ₁.hom.app (Opposite.op (B_ι.obj V))) h_nat).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (G₁.obj.map (adj_site.counit.app V).op ≫ ·) h1).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ φ₂.hom.app (Opposite.op (B_ι.obj V))) h_nat.symm).trans
                    (CategoryTheory.Category.assoc _ _ _))))))
      have h_cancel := (CategoryTheory.cancel_epi α).mp h_eq
      rw [← h_left φ₁, ← h_left φ₂, h_cancel]
    · intro G H
      refine ⟨{ toFun := to_pf, invFun := from_pf, left_inv := h_left, right_inv := h_right },
        fun φ V => ?_⟩
      change (G.obj.map (adj_site.counit.app V).op ≫ 𝟙 _) ≫ φ.hom.app (Opposite.op (B_ι.obj V)) = _
      rw [CategoryTheory.Category.comp_id,
        CategoryTheory.MorphismProperty.Over.mapPullbackAdj_counit_app
          (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
          ⊤ ι hEt trivial V]
      rfl

  have h_clopen_etale : ∀ (B₀ D : Type u) [CommRing B₀] [CommRing D] [Algebra B₀ D]
      [Algebra.Etale B₀ D] {r : ℕ} (D_f : Fin r → Type u) [∀ m, CommRing (D_f m)]
      (e : D ≃+* (∀ m : Fin r, D_f m)) (m : Fin r),
      let π_m : D →+* D_f m := (Pi.evalRingHom D_f m).comp e.toRingHom
      π_m.Etale ∧ (π_m.comp (algebraMap B₀ D)).Etale := by
    intro B₀ D _ _ _ _ r D_f _ e m π_m
    let r_m : D := e.symm (Pi.single m 1)
    let _ : Algebra D (D_f m) := π_m.toAlgebra
    have h_loc : IsLocalization.Away r_m (D_f m) := by
      refine IsLocalization.Away.mk r_m ?_ ?_ ?_
      · change IsUnit (e (e.symm (Pi.single m 1)) m)
        rw [e.apply_symm_apply, Pi.single_eq_same]
        exact isUnit_one
      · intro s
        refine ⟨0, e.symm (Pi.single m s), ?_⟩
        rw [pow_zero, mul_one]
        change s = e (e.symm (Pi.single m s)) m
        rw [e.apply_symm_apply, Pi.single_eq_same]
      · intro a b hab
        refine ⟨1, ?_⟩
        rw [pow_one]
        apply e.injective
        ext k
        simp only [map_mul, r_m, e.apply_symm_apply, Pi.mul_apply]
        by_cases hkm : k = m
        · subst hkm
          rw [Pi.single_eq_same, one_mul, one_mul]
          exact hab
        · rw [Pi.single_eq_of_ne hkm, zero_mul, zero_mul]
    have hEt_D : Algebra.Etale D (D_f m) :=
      @Algebra.Etale.of_isLocalizationAway D (D_f m) _ _ _ r_m h_loc
    have hπ_et : π_m.Etale := RingHom.etale_algebraMap.mpr hEt_D
    let _ : Algebra B₀ (D_f m) := (π_m.comp (algebraMap B₀ D)).toAlgebra
    have _ : IsScalarTower B₀ D (D_f m) := IsScalarTower.of_algebraMap_eq' rfl
    have hEt_B₀ : Algebra.Etale B₀ (D_f m) := @Algebra.Etale.comp B₀ D (D_f m) _ _ _ _ _ _ _ _ _
    exact ⟨hπ_et, RingHom.etale_algebraMap.mpr hEt_B₀⟩

  have h_clopen_sheaf : ∀ (B₀ D : Type u) [CommRing B₀] [CommRing D] [Algebra B₀ D]
      [Algebra.Etale B₀ D] {r : ℕ} (D_f : Fin r → Type u) [∀ m, CommRing (D_f m)]
      (e : D ≃+* (∀ m : Fin r, D_f m)),
      let S_B := AlgebraicGeometry.Spec (CommRingCat.of B₀)
      let π : ∀ m : Fin r, D →+* D_f m := fun m => (Pi.evalRingHom D_f m).comp e.toRingHom
      let V_D : S_B.Etale := weilAffGeomPbcEtObj B₀ D
      let V_m : ∀ m : Fin r, S_B.Etale := fun m =>
        CategoryTheory.MorphismProperty.Over.mk
          (P := (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
          ⊤
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((π m).comp (algebraMap B₀ D))))
          ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
            (h_clopen_etale B₀ D D_f e m).2)
      let v_m : ∀ m : Fin r, V_m m ⟶ V_D := fun m =>
        CategoryTheory.MorphismProperty.Over.homMk
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π m)))
          ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
            (congrArg AlgebraicGeometry.Spec.map (CommRingCat.ofHom_comp _ _).symm))
          trivial
      ∀ (F : CategoryTheory.Sheaf S_B.smallEtaleTopology AddCommGrpCat.{u}),
        Function.Bijective
          (fun (t : ↥(F.obj.obj (Opposite.op V_D))) (m : Fin r) =>
            (F.obj.map (Opposite.op (v_m m))) t) := by
    intro B₀ D _ _ _ _ r D_f _ e S_B π V_D V_m v_m F
    have h_surj : ∀ m : Fin r, Function.Surjective (π m) := by
      intro m s
      exact ⟨e.symm (Pi.single m s), by simp [π]⟩
    have h_mono : ∀ m : Fin r, CategoryTheory.Mono (v_m m) := by
      intro m
      have _ : AlgebraicGeometry.IsClosedImmersion (v_m m).left :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
          (CommRingCat.ofHom (π m)) (h_surj m)
      refine ⟨fun {W} g₁ g₂ hg => ?_⟩
      apply (AlgebraicGeometry.Scheme.Etale.forget S_B).map_injective
      apply CategoryTheory.Over.OverMorphism.ext
      have hg_left : g₁.left ≫ (v_m m).left = g₂.left ≫ (v_m m).left :=
        congrArg CategoryTheory.CommaMorphism.left
          (congrArg (AlgebraicGeometry.Scheme.Etale.forget S_B).map hg)
      exact (CategoryTheory.cancel_mono (v_m m).left).mp hg_left
    let r_idem : Fin r → D := fun m => e.symm (Pi.single m 1)
    have h_sum_idem : ∑ m : Fin r, r_idem m = 1 := by
      apply e.injective
      rw [map_sum, map_one]
      ext k
      have h_dep := congrFun (Finset.univ_sum_single (1 : ∀ m : Fin r, D_f m)) k
      simp only [Finset.sum_apply, r_idem, e.apply_symm_apply] at h_dep ⊢
      exact h_dep
    let S_cov : CategoryTheory.Sieve V_D :=
      CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows V_m v_m)
    have hS_cov : S_cov ∈ S_B.smallEtaleTopology V_D := by
      refine (h_mem_etale S_B V_D S_cov).mpr ?_
      intro p
      have _ : p.asIdeal.IsPrime := p.isPrime
      have hp_one : (1 : D) ∉ p.asIdeal :=
        fun h1 => p.isPrime.ne_top ((Ideal.eq_top_iff_one p.asIdeal).mpr h1)
      have h_ex_m : ∃ m : Fin r, r_idem m ∉ p.asIdeal := by
        by_contra! h_all
        apply hp_one
        rw [← h_sum_idem]
        exact Ideal.sum_mem p.asIdeal (fun m _ => h_all m)
      obtain ⟨m, hm_not⟩ := h_ex_m
      have h_ker_le : RingHom.ker (π m) ≤ p.asIdeal := by
        intro x hx
        have h_mul : r_idem m * x = 0 := by
          apply e.injective
          ext k
          simp only [map_mul, map_zero, r_idem, e.apply_symm_apply, Pi.mul_apply, Pi.zero_apply]
          by_cases hkm : k = m
          · subst hkm
            rw [Pi.single_eq_same, one_mul]
            exact hx
          · rw [Pi.single_eq_of_ne hkm, zero_mul]
        have h_mem : r_idem m * x ∈ p.asIdeal := by rw [h_mul]; exact p.asIdeal.zero_mem
        exact (p.isPrime.mem_or_mem h_mem).resolve_left hm_not
      let q_id : Ideal (D_f m) := Ideal.map (π m) p.asIdeal
      have hq_prime : q_id.IsPrime := Ideal.map_isPrime_of_surjective (h_surj m) h_ker_le
      have hq_comap : Ideal.comap (π m) q_id = p.asIdeal := by
        dsimp [q_id]
        rw [Ideal.comap_map_of_surjective (π m) (h_surj m) p.asIdeal]
        exact sup_eq_left.mpr h_ker_le
      let q_pt : ↥(V_m m).left := ⟨q_id, hq_prime⟩
      refine ⟨V_m m, v_m m, q_pt,
        ⟨V_m m, 𝟙 _, v_m m, ⟨m⟩, (CategoryTheory.Category.id_comp _).symm⟩,
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
          (h_clopen_etale B₀ D D_f e m).1,
        PrimeSpectrum.ext hq_comap⟩
    have h_empty_zero : ∀ (W : S_B.Etale), IsEmpty ↥W.left →
        CategoryTheory.Limits.IsZero (F.obj.obj (Opposite.op W)) := by
      intro W hEmp
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      have h_bot : (⊥ : CategoryTheory.Sieve W) ∈ S_B.smallEtaleTopology W :=
        (h_mem_etale S_B W ⊥).mpr (fun x => IsEmpty.elim hEmp x)
      exact CategoryTheory.Presheaf.IsSheaf.hom_ext F.property
        (⟨⊥, h_bot⟩ : S_B.smallEtaleTopology.Cover W) _ _ (fun I => False.elim I.hf)
    have h_disj : ∀ {W : S_B.Etale} {m₁ m₂ : Fin r} (h₁ : W ⟶ V_m m₁) (h₂ : W ⟶ V_m m₂),
        m₁ ≠ m₂ → h₁ ≫ v_m m₁ = h₂ ≫ v_m m₂ → IsEmpty ↥W.left := by
      intro W m₁ m₂ h₁ h₂ hne hcomm
      refine ⟨fun w => ?_⟩
      let q₁ : ↥(V_m m₁).left := h₁.left.base w
      let q₂ : ↥(V_m m₂).left := h₂.left.base w
      have hp_eq : (v_m m₁).left.base q₁ = (v_m m₂).left.base q₂ := by
        change (h₁.left ≫ (v_m m₁).left).base w = (h₂.left ≫ (v_m m₂).left).base w
        have h_left : h₁.left ≫ (v_m m₁).left = h₂.left ≫ (v_m m₂).left :=
          congrArg CategoryTheory.CommaMorphism.left
            (congrArg (AlgebraicGeometry.Scheme.Etale.forget S_B).map hcomm)
        rw [h_left]
      have h_in₂ : (π m₂) (r_idem m₁) ∈ q₂.asIdeal := by
        have h0 : (π m₂) (r_idem m₁) = 0 := by
          change (e (e.symm (Pi.single m₁ 1))) m₂ = 0
          rw [e.apply_symm_apply, Pi.single_eq_of_ne hne.symm]
        rw [h0]
        exact q₂.asIdeal.zero_mem
      have h_in_p : r_idem m₁ ∈ ((v_m m₁).left.base q₁).asIdeal := by
        rw [hp_eq]
        exact h_in₂
      have h_in₁ : (1 : D_f m₁) ∈ q₁.asIdeal := by
        have h1 : (π m₁) (r_idem m₁) = 1 := by
          change (e (e.symm (Pi.single m₁ 1))) m₁ = 1
          rw [e.apply_symm_apply, Pi.single_eq_same]
        rw [← h1]
        exact h_in_p
      exact q₁.isPrime.ne_top ((Ideal.eq_top_iff_one q₁.asIdeal).mpr h_in₁)
    let P_prod : AddCommGrpCat.{u} :=
      AddCommGrpCat.of (∀ m : Fin r, ↥(F.obj.obj (Opposite.op (V_m m))))
    let π_prod : ∀ m : Fin r, P_prod ⟶ F.obj.obj (Opposite.op (V_m m)) := fun m =>
      AddCommGrpCat.ofHom (Pi.evalAddMonoidHom (fun k => ↥(F.obj.obj (Opposite.op (V_m k)))) m)
    let Φ_hom : F.obj.obj (Opposite.op V_D) ⟶ P_prod :=
      AddCommGrpCat.ofHom (AddMonoidHom.pi (fun m => (F.obj.map (Opposite.op (v_m m))).hom))
    have h_branch_eq : ∀ {W : S_B.Etale} {m₁ m₂ : Fin r}
        (g₁ : W ⟶ V_m m₁) (g₂ : W ⟶ V_m m₂),
        g₁ ≫ v_m m₁ = g₂ ≫ v_m m₂ →
        π_prod m₁ ≫ F.obj.map g₁.op = π_prod m₂ ≫ F.obj.map g₂.op := by
      intro W m₁ m₂ g₁ g₂ hg
      by_cases hm : m₁ = m₂
      · subst hm
        have _ := h_mono m₁
        have hg_eq : g₁ = g₂ := (CategoryTheory.cancel_mono (v_m m₁)).mp hg
        subst hg_eq
        rfl
      · exact (h_empty_zero W (h_disj g₁ g₂ hm hg)).eq_of_tgt _ _
    have h_ex_branch : ∀ (I : S_cov.arrows.category),
        ∃ (m : Fin r) (g : I.obj.left ⟶ V_m m), g ≫ v_m m = I.obj.hom := by
      intro I
      rcases I.property with ⟨Z, g, u, ⟨m⟩, hgu⟩
      exact ⟨m, g, hgu⟩
    choose m_br g_br hg_br using h_ex_branch
    let hLim := Classical.choice
      ((CategoryTheory.Presheaf.isSheaf_iff_isLimit _ _).mp F.property S_cov hS_cov)
    let κ : CategoryTheory.Limits.Cone (S_cov.arrows.diagram.op ⋙ F.obj) :=
      { pt := P_prod
        π :=
          { app := fun j => π_prod (m_br j.unop) ≫ F.obj.map (g_br j.unop).op
            naturality := fun {j₁ j₂} mor => by
              rcases j₁ with ⟨I₁⟩
              rcases j₂ with ⟨I₂⟩
              rcases mor with ⟨u_mor⟩
              dsimp
              rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, ← F.obj.map_comp,
                ← op_comp]
              apply h_branch_eq
              rw [CategoryTheory.Category.assoc, hg_br I₁, hg_br I₂]
              exact (CategoryTheory.Over.w u_mor.hom).symm } }
    let c_lim := F.obj.mapCone S_cov.arrows.cocone.op
    let Φ_c : c_lim.pt ⟶ P_prod := Φ_hom
    let Ψ_hom : P_prod ⟶ c_lim.pt := hLim.lift κ
    have h_ΨΦ : Ψ_hom ≫ Φ_c = 𝟙 P_prod := by
      apply AddCommGrpCat.ext
      intro z
      funext m
      let I_m : S_cov.arrows.category :=
        ⟨CategoryTheory.Over.mk (v_m m),
          ⟨V_m m, 𝟙 _, v_m m, ⟨m⟩, (CategoryTheory.Category.id_comp _).symm⟩⟩
      have h_fac := hLim.fac κ (Opposite.op I_m)
      have h_br := h_branch_eq (g_br I_m) (𝟙 (V_m m))
        ((hg_br I_m).trans (CategoryTheory.Category.id_comp (v_m m)).symm)
      have h_eq_m : Ψ_hom ≫ c_lim.π.app (Opposite.op I_m) = π_prod m := by
        calc
          Ψ_hom ≫ c_lim.π.app (Opposite.op I_m) = κ.π.app (Opposite.op I_m) := h_fac
          _ = π_prod (m_br I_m) ≫ F.obj.map (g_br I_m).op := rfl
          _ = π_prod m ≫ F.obj.map (𝟙 (V_m m)).op := h_br
          _ = π_prod m := by rw [op_id, F.obj.map_id, CategoryTheory.Category.comp_id]
      exact ConcreteCategory.congr_hom h_eq_m z
    have h_ΦΨ : Φ_c ≫ Ψ_hom = 𝟙 c_lim.pt := by
      refine hLim.hom_ext (fun j => ?_)
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hLim.fac κ j]
      rcases j with ⟨I⟩
      have h_eq_I : F.obj.map (v_m (m_br I)).op ≫ F.obj.map (g_br I).op =
          F.obj.map I.obj.hom.op :=
        (F.obj.map_comp _ _).symm.trans (congrArg F.obj.map (congrArg Opposite.op (hg_br I)))
      exact h_eq_I
    constructor
    · intro t₁ t₂ ht
      have h_eq : Φ_hom t₁ = Φ_hom t₂ := ht
      have h1 := ConcreteCategory.congr_hom h_ΦΨ t₁
      have h2 := ConcreteCategory.congr_hom h_ΦΨ t₂
      change Ψ_hom (Φ_hom t₁) = t₁ at h1
      change Ψ_hom (Φ_hom t₂) = t₂ at h2
      rw [← h1, ← h2, h_eq]
    · intro z
      refine ⟨Ψ_hom z, ?_⟩
      exact ConcreteCategory.congr_hom h_ΨΦ z

  
  
  
  have h_pillar_4 :
      (∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂)
        [(weilCompEtaleSitePullback h).IsContinuous W₂.smallEtaleTopology W₁.smallEtaleTopology],
        ((weilCompEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
          W₂.smallEtaleTopology W₁.smallEtaleTopology).IsRightAdjoint) ∧
