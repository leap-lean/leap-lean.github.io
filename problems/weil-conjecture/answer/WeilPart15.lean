        (ψ.base : ↥(AlgebraicGeometry.Spec (U.left.presheaf.obj (Opposite.op V₀))) → ↥C.left))
        (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f_U hW₀ hV₀ e)) pt_m
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply] at hSpec_m
    let p_m : ↥(AlgebraicGeometry.Spec (C.left.presheaf.obj (Opposite.op W₀))) :=
      (AlgebraicGeometry.Spec.map (f_U.appLE W₀ V₀ e)).base pt_m
    have hpm_ne : p_m.asIdeal ≠ ⊥ := by
