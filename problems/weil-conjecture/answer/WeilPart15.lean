      change (n • ULift.up.{u} (1 : ℤ)).down = n
      simp
    have hu_hom_inv : u_hom ≫ u_inv = 𝟙 (AddCommGrpCat.free.obj PUnit.{u + 1}) := by
      apply (AddCommGrpCat.adj.homEquiv PUnit.{u + 1} (AddCommGrpCat.free.obj PUnit.{u + 1})).injective
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
      ext ⟨⟩
      change u_inv (u_hom gen₀) = gen₀
      rw [hu_gen]
      exact one_zsmul gen₀
    let e_ℤ : AddCommGrpCat.free.obj PUnit.{u + 1} ≅ Z_ulift :=
      { hom := u_hom, inv := u_inv, hom_inv_id := hu_hom_inv, inv_hom_id := hu_inv_hom }
    let φ_pre : (CategoryTheory.yoneda.obj T_Y).comp AddCommGrpCat.free ≅
        (CategoryTheory.Functor.const (Opposite Y.Etale)).obj Z_ulift :=
      CategoryTheory.NatIso.ofComponents
        (fun W => (AddCommGrpCat.free.mapIso (e_yon W)) ≪≫ e_ℤ)
        (fun {W₁ W₂} φ => by
          have hmap : (CategoryTheory.yoneda.obj T_Y).map φ ≫ (e_yon W₂).hom = (e_yon W₁).hom := by
            ext
          simp only [CategoryTheory.Functor.comp_map, CategoryTheory.Functor.const_obj_map,
            CategoryTheory.Iso.trans_hom, CategoryTheory.Functor.mapIso_hom]
          rw [← CategoryTheory.Category.assoc, ← AddCommGrpCat.free.map_comp, hmap]
          exact (CategoryTheory.Category.comp_id _).symm)
    let φ_ℤ := (CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).mapIso φ_pre
    let to_H : (((ℱ.cohomologyPresheaf i).obj (Opposite.op T_Y)) : Type u) →+ ℱ.H i :=
      (CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.inv).precomp ℱ (Nat.zero_add i)
    let inv_H : ℱ.H i →+ (((ℱ.cohomologyPresheaf i).obj (Opposite.op T_Y)) : Type u) :=
      (CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.hom).precomp ℱ (Nat.zero_add i)
    have h_left : ∀ x, inv_H (to_H x) = x := by
      intro x
      let x' : CategoryTheory.Abelian.Ext
        ((CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
          ((CategoryTheory.yoneda.obj T_Y).comp AddCommGrpCat.free)) ℱ i := x
      exact (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc φ_ℤ.hom φ_ℤ.inv x').trans
        ((congrArg (fun g => (CategoryTheory.Abelian.Ext.mk₀ g).comp x' (Nat.zero_add i))
          φ_ℤ.hom_inv_id).trans (CategoryTheory.Abelian.Ext.mk₀_id_comp x'))
    have h_right : ∀ y, to_H (inv_H y) = y := by
      intro y
      let y' : CategoryTheory.Abelian.Ext
        ((CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
          ((CategoryTheory.Functor.const (Opposite Y.Etale)).obj Z_ulift)) ℱ i := y
      exact (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc φ_ℤ.inv φ_ℤ.hom y').trans
        ((congrArg (fun g => (CategoryTheory.Abelian.Ext.mk₀ g).comp y' (Nat.zero_add i))
          φ_ℤ.inv_hom_id).trans (CategoryTheory.Abelian.Ext.mk₀_id_comp y'))
    let e₂ : (((ℱ.cohomologyPresheaf i).obj (Opposite.op T_Y)) : Type u) ≃+ ℱ.H i :=
      { toFun := to_H
        invFun := inv_H
        left_inv := h_left
        right_inv := h_right
        map_add' := map_add to_H }
    exact ⟨e₁.trans e₂⟩

  
  refine ⟨⟨hTors_F, ?_⟩, ?_⟩
  · 
    intro Z iZ _ hIntZ
    have : AlgebraicGeometry.IsIntegral Z := hIntZ
    obtain ⟨z₀⟩ := AlgebraicGeometry.IsIntegral.nonempty (X := Z)
    let U : Z.Opens := ⊤
    have hU : Nonempty U := ⟨⟨z₀, trivial⟩⟩
    let V : AlgebraicGeometry.Scheme.{u} := (U : AlgebraicGeometry.Scheme.{u})
    let p : V ⟶ (U : AlgebraicGeometry.Scheme.{u}) := CategoryTheory.CategoryStruct.id V
    refine ⟨U, hU, V, p, A_ℓ, inferInstance, inferInstance, inferInstance, hFin_Aℓ, hTors_Aℓ, ?_⟩
    exact h_s2_const V X.left (p ≫ (U.ι ≫ iZ)) A_ℓ
  · 
    intro hConst
    obtain ⟨U, hU, V, p, A, -, hEt_p, hSurj_p, hFin_A, -, hq⟩ :=
      hConst.2 S₀ (CategoryTheory.CategoryStruct.id S₀) inferInstance hInt_S₀
    let q : V ⟶ S₀ := p ≫ (U.ι ≫ CategoryTheory.CategoryStruct.id S₀)
    have : AlgebraicGeometry.Etale p := hEt_p
    have : AlgebraicGeometry.Surjective p := hSurj_p
    have : AlgebraicGeometry.Etale (U.ι ≫ CategoryTheory.CategoryStruct.id S₀) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) U.ι
        (CategoryTheory.CategoryStruct.id S₀) inferInstance inferInstance
    have : AlgebraicGeometry.Etale q :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) p
        (U.ι ≫ CategoryTheory.CategoryStruct.id S₀) inferInstance inferInstance
    have : AlgebraicGeometry.Surjective q := by
      refine ⟨fun s => ?_⟩
      obtain ⟨v₀, -⟩ := p.surjective hU.some
      exact ⟨v₀, Subsingleton.elim _ _⟩
    obtain ⟨σ, hσq⟩ := hSec_S₀ V q
    let G := weilEtaleHigherDirectImage X.hom i F
    obtain ⟨e_G⟩ := h_s2_ret q σ hσq G A hq
    let e_GT₀ : G.obj.obj (Opposite.op T₀) ≅
        (((CategoryTheory.constantSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}).obj A).obj.obj
          (Opposite.op T₀)) :=
      ((CategoryTheory.sheafSections S₀.smallEtaleTopology AddCommGrpCat.{u}).obj
        (Opposite.op T₀)).mapIso e_G
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) X.hom :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale)
        X.hom :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_X : CategoryTheory.Functor S₀.Etale X.left.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ X.hom
    let P_X : CategoryTheory.Functor (Opposite S₀.Etale) AddCommGrpCat.{u} :=
      B_X.op.comp (F.cohomologyPresheaf i)
    obtain ⟨e_P⟩ := h_s4 S₀.smallEtaleTopology T₀ hTop_T₀ P_X
    obtain ⟨e_A⟩ := h_s4 S₀.smallEtaleTopology T₀ hTop_T₀
      ((CategoryTheory.Functor.const (Opposite S₀.Etale)).obj A)
    obtain ⟨e_H⟩ := h_s5 X.left S₀ X.hom F
    let e_mid : (P_X.obj (Opposite.op T₀) : Type u) ≃+ (A : Type u) :=
      isoToAddEquiv (e_P.trans (e_GT₀.trans e_A.symm))
    let e_tot : weilEtaleTorsionH X.left ℓ i ≃ (A : Type u) :=
      e_H.symm.toEquiv.trans e_mid.toEquiv
    exact Finite.of_equiv (A : Type u) e_tot.symm

theorem weil_etale_kummer_mod_prime_short_exact (k : Type u) [Field k] [IsAlgClosed k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0) :
    CategoryTheory.Presheaf.IsSheaf X.left.smallEtaleTopology (weilEtaleGmPresheaf X.left) ∧
    ∃ (ι_kum : weilEtaleTorsionSheaf X.left ℓ ⟶ weilEtaleGmSheaf X.left)
      (p_kum : weilEtaleGmSheaf X.left ⟶ weilEtaleGmSheaf X.left)
      (h0 : ι_kum ≫ p_kum = 0),
      p_kum = ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf X.left) ∧
      (CategoryTheory.ShortComplex.mk ι_kum p_kum h0).ShortExact :=
by
  classical
  
  have hGm : CategoryTheory.Presheaf.IsSheaf X.left.smallEtaleTopology
      (weilEtaleGmPresheaf X.left) := by
    let S : AlgebraicGeometry.Scheme.{u} := X.left
    have hAmitsur : ∀ (A : Type u) [CommRing A] (ι : Type u) [Fintype ι] [DecidableEq ι]
        (B : ι → Type u) [∀ i, CommRing (B i)] [∀ i, Algebra A (B i)] [∀ i, Module.Flat A (B i)],
        (∀ p : PrimeSpectrum A, ∃ (i : ι) (q : PrimeSpectrum (B i)),
          PrimeSpectrum.comap (algebraMap A (B i)) q = p) →
        (∀ (C : Type u) [CommRing C] [Algebra A C] (c₁ c₂ : C),
          (∀ i : ι, TensorProduct.tmul A c₁ (1 : B i) = TensorProduct.tmul A c₂ (1 : B i)) →
          c₁ = c₂) ∧
        (∀ b : (i : ι) → B i,
          (∀ i j : ι, TensorProduct.tmul A (b i) (1 : B j) = TensorProduct.tmul A (1 : B i) (b j)) →
          ∃ a : A, ∀ i : ι, algebraMap A (B i) a = b i) := by
      intro A _ ι _ _ B _ _ _ hSurj
      let P : Type u := (i : ι) → B i
      have hFlatDS : Module.Flat A (DirectSum ι B) := Module.Flat.directSum
      have hFlatP : Module.Flat A P :=
        @Module.Flat.of_linearEquiv A (DirectSum ι B) P _ _ _ _ _ hFlatDS
          (DirectSum.linearEquivFunOnFintype A ι B).symm
      have hComapSurj : Function.Surjective (PrimeSpectrum.comap (algebraMap A P)) := by
        intro p
        obtain ⟨i, q, hq⟩ := hSurj p
        refine ⟨PrimeSpectrum.comap (Pi.evalRingHom B i) q, ?_⟩
        have hcomp : (Pi.evalRingHom B i).comp (algebraMap A P) = algebraMap A (B i) :=
          RingHom.ext fun _ => rfl
        rw [← PrimeSpectrum.comap_comp_apply, hcomp, hq]
      have hFF : Module.FaithfullyFlat A P :=
        @Module.FaithfullyFlat.of_comap_surjective A P _ _ _ hFlatP hComapSurj
      refine ⟨?_, ?_⟩
      · intro C _ _ c₁ c₂ hc
        let x : C := c₁ - c₂
        have hx_i : ∀ i : ι, TensorProduct.tmul A x (1 : B i) = 0 := by
          intro i
          dsimp [x]
          rw [TensorProduct.sub_tmul, hc i, sub_self]
        let e_pi := Algebra.TensorProduct.piRight A A C B
        have hx_P : TensorProduct.tmul A x (1 : P) = 0 := by
          apply e_pi.injective
          rw [map_zero]
          funext i
          exact hx_i i
        let l12 : A →ₗ[A] A := LinearMap.id
        let l23 : A →ₗ[A] C := LinearMap.toSpanSingleton A C x
        have hl23_zero : LinearMap.rTensor P l23 = 0 := by
          apply TensorProduct.ext'
          intro a p
          change TensorProduct.tmul A (a • x) p = 0
          have hmul : TensorProduct.tmul A (a • x) p =
              (TensorProduct.tmul A (algebraMap A C a) (1 : P)) *
                (TensorProduct.tmul A x (1 : P)) *
                (TensorProduct.tmul A (1 : C) p) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
              ← Algebra.smul_def, mul_one, mul_one, one_mul]
          rw [hmul, hx_P, mul_zero, zero_mul]
        have hex_r : Function.Exact (LinearMap.rTensor P l12) (LinearMap.rTensor P l23) := by
          intro z
          rw [hl23_zero, LinearMap.rTensor_id]
          exact ⟨fun _ => ⟨z, rfl⟩, fun _ => rfl⟩
        have hex : Function.Exact l12 l23 :=
          Module.FaithfullyFlat.rTensor_reflects_exact A P l12 l23 hex_r
        have hx0 : x = 0 := by
          have h1 : l23 1 = 0 := (hex 1).mpr ⟨1, rfl⟩
          simpa [l23] using h1
        exact sub_eq_zero.mp hx0
      · intro b hb
        let l12 : A →ₗ[A] P := Algebra.linearMap A P
        let l23 : P →ₗ[A] TensorProduct A P P :=
          Algebra.TensorProduct.includeLeft.toLinearMap -
            Algebra.TensorProduct.includeRight.toLinearMap
        have hcomp0 : l23.comp l12 = 0 := by
          apply LinearMap.ext
          intro a
          change TensorProduct.tmul A (algebraMap A P a) (1 : P) -
            TensorProduct.tmul A (1 : P) (algebraMap A P a) = 0
          rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, sub_self]
        let μ : TensorProduct A P P →ₗ[A] TensorProduct A A P :=
          (TensorProduct.mk A A P 1).comp (LinearMap.mul' A P)
        let h₁ : TensorProduct A (TensorProduct A P P) P →ₗ[A] TensorProduct A P P :=
          (LinearMap.lTensor P (LinearMap.mul' A P)).comp
            (TensorProduct.assoc A P P P).toLinearMap
        have h_homotopy : ∀ w : TensorProduct A P P,
            h₁ (LinearMap.rTensor P l23 w) + LinearMap.rTensor P l12 (μ w) = w := by
          intro w
          induction w using TensorProduct.induction_on with
          | zero => simp
          | tmul x y =>
            change h₁ (TensorProduct.tmul A
                (TensorProduct.tmul A x (1 : P) - TensorProduct.tmul A (1 : P) x) y) +
              TensorProduct.tmul A (algebraMap A P 1) (x * y) = TensorProduct.tmul A x y
            rw [TensorProduct.sub_tmul, map_sub, map_one]
            change TensorProduct.tmul A x (1 * y) - TensorProduct.tmul A (1 : P) (x * y) +
              TensorProduct.tmul A (1 : P) (x * y) = TensorProduct.tmul A x y
            rw [one_mul, sub_add_cancel]
          | add u v ihu ihv =>
            rw [map_add, map_add, map_add, map_add, add_add_add_comm, ihu, ihv]
        have hex_r : Function.Exact (LinearMap.rTensor P l12) (LinearMap.rTensor P l23) := by
          intro w
          constructor
          · intro hw
            refine ⟨μ w, ?_⟩
            have hh := h_homotopy w
            rw [hw, map_zero, zero_add] at hh
            exact hh
          · rintro ⟨u, rfl⟩
            change ((LinearMap.rTensor P l23).comp (LinearMap.rTensor P l12)) u = 0
            rw [← LinearMap.rTensor_comp, hcomp0, LinearMap.rTensor_zero, LinearMap.zero_apply]
        have hex : Function.Exact l12 l23 :=
          Module.FaithfullyFlat.rTensor_reflects_exact A P l12 l23 hex_r
        have hb0 : l23 b = 0 := by
          apply (Algebra.TensorProduct.piRight A A P B).injective
          rw [map_zero]
          funext j
          change TensorProduct.tmul A b (1 : B j) - TensorProduct.tmul A (1 : P) (b j) = 0
          apply (TensorProduct.comm A P (B j)).injective
          rw [map_zero, map_sub]
          change TensorProduct.tmul A (1 : B j) b - TensorProduct.tmul A (b j) (1 : P) = 0
          apply (Algebra.TensorProduct.piRight A A (B j) B).injective
          rw [map_zero, map_sub]
          funext i
          change TensorProduct.tmul A (1 : B j) (b i) - TensorProduct.tmul A (b j) (1 : B i) = 0
          apply (TensorProduct.comm A (B j) (B i)).injective
          rw [map_zero, map_sub]
          change TensorProduct.tmul A (b i) (1 : B j) - TensorProduct.tmul A (1 : B i) (b j) = 0
          exact sub_eq_zero.mpr (hb i j)
        obtain ⟨a, ha⟩ := (hex b).mp hb0
        exact ⟨a, fun i => congrFun ha i⟩
    let P_et : MorphismProperty Scheme.{u} := @AlgebraicGeometry.Etale
    have hMult : MorphismProperty.IsMultiplicative P_et := inferInstance
    have := hMult.toIsStableUnderComposition
    have hsec_ext : ∀ (Y : Scheme.{u}) (W : Y.Opens)
        (a b : ↑(Y.presheaf.obj (Opposite.op W))),
        (∀ (y : ↥Y) (hy : y ∈ W),
          (Y.presheaf.germ W y hy).hom a = (Y.presheaf.germ W y hy).hom b) →
        a = b :=
      fun Y W a b h => TopCat.Presheaf.section_ext Y.sheaf W a b h
    have hEtale_fromSpec : ∀ {Y : Scheme.{u}} {W : Y.Opens} (hW : IsAffineOpen W),
        AlgebraicGeometry.Etale hW.fromSpec := by
      intro Y W hW
      rw [← hW.isoSpec_inv_ι]
      exact MorphismProperty.comp_mem P_et _ _
        (MorphismProperty.of_isIso P_et hW.isoSpec.inv)
        (inferInstance : AlgebraicGeometry.Etale W.ι)
    have hpresheaf_comp_apply : ∀ {Y : Scheme.{u}} {W₁ W₂ W₃ : Y.Opens}
        (i₁ : W₁ ⟶ W₂) (i₂ : W₂ ⟶ W₃) (s : ↑(Y.presheaf.obj (Opposite.op W₃))),
        (Y.presheaf.map i₁.op).hom ((Y.presheaf.map i₂.op).hom s) =
          (Y.presheaf.map (i₁ ≫ i₂).op).hom s :=
      fun {Y} _ _ _ i₁ i₂ s =>
        congrArg (fun φ : Y.presheaf.obj _ ⟶ Y.presheaf.obj _ => φ.hom s)
          (Y.presheaf.map_comp i₂.op i₁.op).symm
    have hFromSpec_appTop : ∀ {Y : Scheme.{u}} {W : Y.Opens} (hW : IsAffineOpen W)
        (z : ↑(Y.presheaf.obj (Opposite.op ⊤))),
        ((Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op W))).hom).hom (hW.fromSpec.appTop.hom z) =
          (Y.presheaf.map (homOfLE le_top).op).hom z := by
      intro Y W hW z
      have hinv_hom : hW.isoSpec.inv.appTop ≫ hW.isoSpec.hom.appTop = 𝟙 _ := by
        rw [← Scheme.Hom.comp_appTop, Iso.hom_inv_id, Scheme.Hom.id_appTop]
      rw [hW.isoSpec_hom_appTop] at hinv_hom
      have hinv_Γ : hW.isoSpec.inv.appTop ≫
          (Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op W))).hom = W.topIso.hom := by
        have h1 := congrArg (· ≫ W.topIso.hom) hinv_hom
        change (hW.isoSpec.inv.appTop ≫
            (Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op W))).hom ≫ W.topIso.inv) ≫
          W.topIso.hom = 𝟙 _ ≫ W.topIso.hom at h1
        rw [Category.assoc, Category.assoc, Iso.inv_hom_id, Category.comp_id, Category.id_comp] at h1
        exact h1
      have hcat1 : hW.fromSpec.appTop ≫
          (Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op W))).hom =
          W.ι.appTop ≫ W.topIso.hom := by
        rw [← hW.isoSpec_inv_ι, Scheme.Hom.comp_appTop, Category.assoc, hinv_Γ]
      have hz1 : ((Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op W))).hom).hom
          (hW.fromSpec.appTop.hom z) = W.topIso.hom.hom (W.ι.appTop.hom z) :=
        congrArg (fun φ : Y.presheaf.obj (Opposite.op ⊤) ⟶ _ => φ.hom z) hcat1
      have hz2a := congrArg (fun φ => φ.hom (W.ι.appTop.hom z)) (Scheme.Opens.topIso_hom W)
      have hz2b := congrArg (fun φ => φ.hom z) (Scheme.Opens.ι_appTop (U := W))
      have hz3 := hz2a.trans (congrArg (Y.presheaf.map _).hom hz2b)
      exact hz1.trans (hz3.trans (hpresheaf_comp_apply _ _ z))
    have happLE_res_top : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z) {V : Z.Opens} {W : Y.Opens}
        (hWV : W ≤ (TopologicalSpace.Opens.map f.base).obj V)
        (z : ↑(Z.presheaf.obj (Opposite.op ⊤))),
        (f.appLE V W hWV).hom ((Z.presheaf.map (homOfLE le_top).op).hom z) =
          (Y.presheaf.map (homOfLE le_top).op).hom (f.appTop.hom z) := by
      intro Y Z f V W hWV z
      apply hsec_ext Y W
      intro y hy
      change (Y.presheaf.germ W y hy).hom
          ((Y.presheaf.map (homOfLE hWV).op).hom
            ((f.app V).hom ((Z.presheaf.map (homOfLE le_top).op).hom z))) =
        (Y.presheaf.germ W y hy).hom ((Y.presheaf.map (homOfLE le_top).op).hom (f.appTop.hom z))
      have hg₁ := TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE hWV) y hy
        ((f.app V).hom ((Z.presheaf.map (homOfLE le_top).op).hom z))
      have hg₂ := f.germ_stalkMap_apply V y (hWV hy)
        ((Z.presheaf.map (homOfLE le_top).op).hom z)
      have hg₃ := TopCat.Presheaf.germ_res_apply Z.presheaf (homOfLE (le_top : V ≤ ⊤))
        (f.base y) (hWV hy) z
      have hg₄ := f.germ_stalkMap_apply ⊤ y trivial z
      have hg₅ := TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE (le_top : W ≤ ⊤)) y hy
        (f.appTop.hom z)
      exact hg₁.trans (hg₂.symm.trans ((congrArg (Scheme.Hom.stalkMap f y).hom hg₃).trans
        (hg₄.trans hg₅.symm)))
    have happLE_res_LE : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z) {V₀ V₁ : Z.Opens} {W : Y.Opens}
        (hVV : V₀ ≤ V₁)
        (hWV₀ : W ≤ (TopologicalSpace.Opens.map f.base).obj V₀)
        (z : ↑(Z.presheaf.obj (Opposite.op V₁))),
        (f.appLE V₀ W hWV₀).hom ((Z.presheaf.map (homOfLE hVV).op).hom z) =
          (f.appLE V₁ W (le_trans hWV₀ ((TopologicalSpace.Opens.map f.base).monotone hVV))).hom z := by
      intro Y Z f V₀ V₁ W hVV hWV₀ z
      apply hsec_ext Y W
      intro y hy
      have hy₀ : f.base y ∈ V₀ := hWV₀ hy
      have hy₁ : f.base y ∈ V₁ := hVV hy₀
      change (Y.presheaf.germ W y hy).hom
          ((Y.presheaf.map (homOfLE hWV₀).op).hom
            ((f.app V₀).hom ((Z.presheaf.map (homOfLE hVV).op).hom z))) =
        (Y.presheaf.germ W y hy).hom
          ((Y.presheaf.map (homOfLE _).op).hom ((f.app V₁).hom z))
      have hg₁ := TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE hWV₀) y hy
        ((f.app V₀).hom ((Z.presheaf.map (homOfLE hVV).op).hom z))
      have hg₂ := f.germ_stalkMap_apply V₀ y hy₀ ((Z.presheaf.map (homOfLE hVV).op).hom z)
      have hg₃ := TopCat.Presheaf.germ_res_apply Z.presheaf (homOfLE hVV) (f.base y) hy₀ z
      have hg₄ := f.germ_stalkMap_apply V₁ y hy₁ z
      have hg₅ := TopCat.Presheaf.germ_res_apply Y.presheaf
