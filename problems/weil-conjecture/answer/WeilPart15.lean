        app := fun U =>
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.Limits.pullback.fst U.hom (𝟙 Z))
            (CategoryTheory.Limits.pullback.condition.trans (CategoryTheory.Category.comp_id _))
