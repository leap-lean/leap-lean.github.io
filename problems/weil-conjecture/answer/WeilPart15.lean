        map_id := fun P => NatTrans.ext (funext fun opT => by
          by_cases h : Φ opT.unop
          · dsimp
            simp only [dif_pos h, Category.id_comp, eqToHom_trans]
            exact eqToHom_refl _ _
          · exact ((Limits.isZero_zero A).of_iso (eqToIso (dif_neg h))).eq_of_src _ _)
