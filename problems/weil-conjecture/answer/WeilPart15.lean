        have htu_eq : Units.mk0 (germB₀ t) ht' = Units.mk0 (germB₀ t) ht_ne := Units.ext rfl
        have hΔ_pole : div_fn (Additive.ofMul (Units.mk0 (germB₀ Δ_pos_s) hΔ_pos_s)) x =
            (K_pos : ℤ) * div_fn (Additive.ofMul (Units.mk0 (germB₀ t) ht_ne)) x :=
