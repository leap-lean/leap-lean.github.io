        have h₂' : u₂ ^ (q ^ (n₁ + n₂)) = (ω₂ ^ (q ^ n₁)) ⊗ₜ[A] (1 : κ_B) := by
          rw [Nat.add_comm n₁ n₂, pow_add, pow_mul, h₂, Algebra.TensorProduct.tmul_pow, one_pow]
        rw [h₁', h₂', TensorProduct.add_tmul]
