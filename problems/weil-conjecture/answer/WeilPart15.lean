theorem weil_pbc_canonical_calculus_and_extraction (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ {X S S' X' : AlgebraicGeometry.Scheme.{u}}
        (f : X ⟶ S) (g : S' ⟶ S) (f' : X' ⟶ S') (g' : X' ⟶ X),
      WeilCanonicalModPrimePBC ℓ f →
      CategoryTheory.IsPullback g' f' f g →
      ∀ (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
        (F' : CategoryTheory.Sheaf X'.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id F = 0 →
        WeilIsEtaleSheafPullback g' F F' →
        ∀ (q : ℕ),
          WeilIsEtaleSheafPullback g
            (weilEtaleHigherDirectImage f q F)
            (weilEtaleHigherDirectImage f' q F')) ∧
    (∀ {X Y S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (h : Y ⟶ S),
      WeilCanonicalModPrimePBC ℓ f →
      WeilCanonicalModPrimePBC ℓ h →
      WeilCanonicalModPrimePBC ℓ (f ≫ h)) ∧
    (∀ {X_tilde X S : AlgebraicGeometry.Scheme.{u}} (π : X_tilde ⟶ X) (f : X ⟶ S),
      AlgebraicGeometry.Surjective π →
      WeilCanonicalModPrimePBC ℓ π →
      WeilCanonicalModPrimePBC ℓ (π ≫ f) →
      WeilCanonicalModPrimePBC ℓ f) ∧
    (∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S),
      (∀ (U : S.Opens), AlgebraicGeometry.IsAffineOpen U → WeilCanonicalModPrimePBC ℓ (f ∣_ U)) →
      WeilCanonicalModPrimePBC ℓ f) ∧
    (∀ {X₁ S₁ X₂ S₂ : AlgebraicGeometry.Scheme.{u}}
        (f₁ : X₁ ⟶ S₁) (f₂ : X₂ ⟶ S₂) (eX : X₁ ≅ X₂) (eS : S₁ ≅ S₂),
      eX.hom ≫ f₂ = f₁ ≫ eS.hom →
      WeilCanonicalModPrimePBC ℓ f₂ →
      WeilCanonicalModPrimePBC ℓ f₁) :=
by
  have : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
