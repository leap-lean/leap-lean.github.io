      have _ : IsScalarTower R₃₃ R₄ Ω := hTow₃₃₄Ω
      have _ : IsScalarTower R₁ R₄ Ω := hTow₁₄Ω
      have _ : Algebra.Etale R₁ R₄ := Algebra.Etale.comp R₁ R₃₃ R₄
      let j₁ : R₃ →ₐ[R₁] R₄ := (IsScalarTower.toAlgHom R₁ R₃₃ R₄).comp i₁
      let j₂ : R'₃ →ₐ[R₁] R₄ := (IsScalarTower.toAlgHom R₁ R₃₃ R₄).comp i₂
      have hj₁_Ω : (algebraMap R₄ Ω).comp j₁.toRingHom = algebraMap R₃ Ω := by
        ext x
        change algebraMap R₄ Ω (algebraMap R₃₃ R₄ (i₁ x)) = algebraMap R₃ Ω x
        rw [← IsScalarTower.algebraMap_apply R₃₃ R₄ Ω]
        exact congrFun (congrArg DFunLike.coe hi₁_Ω) x
      have hj₂_Ω : (algebraMap R₄ Ω).comp j₂.toRingHom = algebraMap R'₃ Ω := by
        ext x
        change algebraMap R₄ Ω (algebraMap R₃₃ R₄ (i₂ x)) = algebraMap R'₃ Ω x
        rw [← IsScalarTower.algebraMap_apply R₃₃ R₄ Ω]
        exact congrFun (congrArg DFunLike.coe hi₂_Ω) x
      have h_push_eq : (Algebra.TensorProduct.map j₁ (AlgHom.id R₁ (B₁ m))).toRingHom.comp α_tilde =
          (Algebra.TensorProduct.map j₂ (AlgHom.id R₁ (B₁ m))).toRingHom.comp α'_tilde := by
        have hm₁ : Algebra.TensorProduct.map j₁ (AlgHom.id R₁ (B₁ m)) =
            (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₃₃ R₄) (AlgHom.id R₁ (B₁ m))).comp
              (Algebra.TensorProduct.map i₁ (AlgHom.id R₁ (B₁ m))) := by
          rw [← Algebra.TensorProduct.map_comp, AlgHom.comp_id]
        have hm₂ : Algebra.TensorProduct.map j₂ (AlgHom.id R₁ (B₁ m)) =
            (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₃₃ R₄) (AlgHom.id R₁ (B₁ m))).comp
              (Algebra.TensorProduct.map i₂ (AlgHom.id R₁ (B₁ m))) := by
          rw [← Algebra.TensorProduct.map_comp, AlgHom.comp_id]
        calc
          (Algebra.TensorProduct.map j₁ (AlgHom.id R₁ (B₁ m))).toRingHom.comp α_tilde
            = ((Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₃₃ R₄) (AlgHom.id R₁ (B₁ m))).comp
                (Algebra.TensorProduct.map i₁ (AlgHom.id R₁ (B₁ m)))).toRingHom.comp α_tilde := by
              rw [hm₁]
          _ = (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₃₃ R₄) (AlgHom.id R₁ (B₁ m))).toRingHom.comp α₁ := rfl
          _ = (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₃₃ R₄) (AlgHom.id R₁ (B₁ m))).toRingHom.comp α₂ := h_eq₄
          _ = ((Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₃₃ R₄) (AlgHom.id R₁ (B₁ m))).comp
                (Algebra.TensorProduct.map i₂ (AlgHom.id R₁ (B₁ m)))).toRingHom.comp α'_tilde := rfl
          _ = (Algebra.TensorProduct.map j₂ (AlgHom.id R₁ (B₁ m))).toRingHom.comp α'_tilde := by
