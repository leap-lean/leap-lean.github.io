    have hNatCokernel : ∀ {C₀ : Type (u + 1)} [Category.{u, u + 1} C₀]
        {F₁ F₂ F₃ : C₀ ⥤ AddCommGrpCat.{u}} (f₁ : F₁ ⟶ F₂) (g₁ : F₂ ⟶ F₃) (h0 : f₁ ≫ g₁ = 0),
