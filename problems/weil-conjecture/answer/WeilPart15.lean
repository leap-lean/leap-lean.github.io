import WeilPart14
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_descent_isFinite_and_proper_surjective_of_model (F : Type u) [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper X.hom]
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))))
    (φ_bar : W ⟶ weilBaseChangeOver F (AlgebraicClosure F) X)
    (U_bar : (weilBaseChangeOver F (AlgebraicClosure F) X).left.Opens)
    (hProp_bar : AlgebraicGeometry.IsProper φ_bar.left)
    (hSurj_bar : AlgebraicGeometry.Surjective φ_bar.left)
    (hU_bar : Nonempty U_bar)
    (hFin_bar : AlgebraicGeometry.IsFinite (φ_bar.left ∣_ U_bar))
    (hSurjU_bar : AlgebraicGeometry.Surjective (φ_bar.left ∣_ U_bar))
    (L : IntermediateField F (AlgebraicClosure F))
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L)))
    (φ : Y ⟶ weilBaseChangeOver F ↥L X)
    (U : (weilBaseChangeOver F ↥L X).left.Opens)
    (hProjY : IsProjectiveOverField ↥L Y)
    (hMod : IsBaseChangeAlterationModel F X W φ_bar U_bar L Y φ U) :
    AlgebraicGeometry.IsProper Y.hom ∧
    AlgebraicGeometry.IsProper φ.left ∧
    AlgebraicGeometry.Surjective φ.left ∧
    Nonempty U ∧
    AlgebraicGeometry.IsFinite (φ.left ∣_ U) ∧
    AlgebraicGeometry.Surjective (φ.left ∣_ U) :=
by
  have _ := hProp_bar
  have hAffDescent : ∀ (E K : Type u) [Field E] [Field K] [Algebra E K]
      (Z Z_K : AlgebraicGeometry.Scheme.{u})
      (g : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of E))
      (g_K : Z_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
      (p : Z_K ⟶ Z)
      [CompactSpace ↥Z]
      [AlgebraicGeometry.IsSeparated g]
      [AlgebraicGeometry.IsAffine Z_K],
      CategoryTheory.IsPullback p g_K g
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E K))) →
      AlgebraicGeometry.IsAffine Z := by
    intro E K _ _ _ Z Z_K g g_K p _ _ _ hp
    have hMapCompZ : ∀ {W₁ W₂ W₃ : Z.Opens} (h₁ : W₁ ≤ W₂) (h₂ : W₂ ≤ W₃) (h₃ : W₁ ≤ W₃)
        (x : ↑(Z.presheaf.obj (Opposite.op W₃))),
        (Z.presheaf.map (homOfLE h₁).op).hom ((Z.presheaf.map (homOfLE h₂).op).hom x) =
          (Z.presheaf.map (homOfLE h₃).op).hom x := by
      intro W₁ W₂ W₃ h₁ h₂ h₃ x
      have h : Z.presheaf.map (homOfLE h₂).op ≫ Z.presheaf.map (homOfLE h₁).op =
          Z.presheaf.map (homOfLE h₃).op := by
        rw [← Z.presheaf.map_comp]
        exact congrArg Z.presheaf.map (Subsingleton.elim _ _)
      exact congrArg (fun φ => φ.hom x) h
    have hMapCompZK : ∀ {V₁ V₂ V₃ : Z_K.Opens} (h₁ : V₁ ≤ V₂) (h₂ : V₂ ≤ V₃) (h₃ : V₁ ≤ V₃)
        (x : ↑(Z_K.presheaf.obj (Opposite.op V₃))),
        (Z_K.presheaf.map (homOfLE h₁).op).hom ((Z_K.presheaf.map (homOfLE h₂).op).hom x) =
          (Z_K.presheaf.map (homOfLE h₃).op).hom x := by
      intro V₁ V₂ V₃ h₁ h₂ h₃ x
      have h : Z_K.presheaf.map (homOfLE h₂).op ≫ Z_K.presheaf.map (homOfLE h₁).op =
          Z_K.presheaf.map (homOfLE h₃).op := by
        rw [← Z_K.presheaf.map_comp]
        exact congrArg Z_K.presheaf.map (Subsingleton.elim _ _)
      exact congrArg (fun φ => φ.hom x) h
    have hMapIdZ : ∀ {W : Z.Opens} (h : W ≤ W) (x : ↑(Z.presheaf.obj (Opposite.op W))),
        (Z.presheaf.map (homOfLE h).op).hom x = x := by
      intro W h x
      have hid : (homOfLE h).op = 𝟙 (Opposite.op W) := Subsingleton.elim _ _
      rw [hid, Z.presheaf.map_id]
      rfl
    have hMapIdZK : ∀ {V : Z_K.Opens} (h : V ≤ V) (x : ↑(Z_K.presheaf.obj (Opposite.op V))),
        (Z_K.presheaf.map (homOfLE h).op).hom x = x := by
      intro V h x
      have hid : (homOfLE h).op = 𝟙 (Opposite.op V) := Subsingleton.elim _ _
      rw [hid, Z_K.presheaf.map_id]
      rfl
    have hMap3IdZK : ∀ {V₀ V₁ V₂ : Z_K.Opens}
        (u₁ : Opposite.op V₀ ⟶ Opposite.op V₁)
        (u₂ : Opposite.op V₁ ⟶ Opposite.op V₂)
        (u₃ : Opposite.op V₂ ⟶ Opposite.op V₀),
        Z_K.presheaf.map u₁ ≫ Z_K.presheaf.map u₂ ≫ Z_K.presheaf.map u₃ =
          𝟙 (Z_K.presheaf.obj (Opposite.op V₀)) := by
      intro V₀ V₁ V₂ u₁ u₂ u₃
      rw [← Z_K.presheaf.map_comp, ← Z_K.presheaf.map_comp]
      rw [Subsingleton.elim (u₁ ≫ u₂ ≫ u₃) (𝟙 (Opposite.op V₀)), Z_K.presheaf.map_id]
    let s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of E) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E K))
    let α_E : CommRingCat.of E ⟶ Γ(Z, ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of E)).inv ≫ g.appTop
    let α_K : CommRingCat.of K ⟶ Γ(Z_K, ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ g_K.appTop
    have hs_nat : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of E)).inv ≫ s.appTop =
        CommRingCat.ofHom (algebraMap E K) ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
      rw [← CategoryTheory.cancel_mono (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.comp_id,
        AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (algebraMap E K)),
        ← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
        CategoryTheory.Category.id_comp]
    have hα_comm : α_E ≫ p.appTop = CommRingCat.ofHom (algebraMap E K) ≫ α_K := by
      have hpw : g.appTop ≫ p.appTop = s.appTop ≫ g_K.appTop := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hp.w,
          AlgebraicGeometry.Scheme.Hom.comp_appTop]
      calc
        α_E ≫ p.appTop =
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of E)).inv ≫ (g.appTop ≫ p.appTop) := by
          dsimp only [α_E]
          rw [CategoryTheory.Category.assoc]
        _ = ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of E)).inv ≫ s.appTop) ≫
              g_K.appTop := by
          rw [hpw, CategoryTheory.Category.assoc]
        _ = CommRingCat.ofHom (algebraMap E K) ≫ α_K := by
          rw [hs_nat, CategoryTheory.Category.assoc]
    letI instAlgEZ : ∀ W : Z.Opens, Algebra E ↑(Z.presheaf.obj (Opposite.op W)) :=
      fun W => ((α_E ≫ Z.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom).toAlgebra
    letI instAlgKZK : ∀ V : Z_K.Opens, Algebra K ↑(Z_K.presheaf.obj (Opposite.op V)) :=
      fun V => ((α_K ≫ Z_K.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom).toAlgebra
    letI instAlgEZK : ∀ V : Z_K.Opens, Algebra E ↑(Z_K.presheaf.obj (Opposite.op V)) :=
      fun V => (((α_K ≫ Z_K.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom).comp
        (algebraMap E K)).toAlgebra
    haveI instTowerZK : ∀ V : Z_K.Opens, IsScalarTower E K ↑(Z_K.presheaf.obj (Opposite.op V)) :=
      fun _ => IsScalarTower.of_algebraMap_eq' rfl
    let ψ : ∀ W : Z.Opens,
        ↑(Z.presheaf.obj (Opposite.op W)) →ₐ[E]
          ↑(Z_K.presheaf.obj (Opposite.op (p ⁻¹ᵁ W))) := fun W =>
      { toRingHom := (p.app W).hom
        commutes' := fun c => by
          have hnat := congrArg (fun φ => φ.hom (α_E.hom c))
            (AlgebraicGeometry.Scheme.Hom.naturality p (homOfLE (le_top : W ≤ ⊤)).op)
          have hcomm_c := congrArg (fun φ => φ.hom c) hα_comm
          dsimp at hnat hcomm_c ⊢
          calc
            (p.app W).hom ((Z.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom (α_E.hom c))
              = (Z_K.presheaf.map ((TopologicalSpace.Opens.map p.base).map
                  (homOfLE (le_top : W ≤ ⊤))).op).hom (p.appTop.hom (α_E.hom c)) := hnat
            _ = (Z_K.presheaf.map ((TopologicalSpace.Opens.map p.base).map
                  (homOfLE (le_top : W ≤ ⊤))).op).hom (α_K.hom (algebraMap E K c)) := by
                rw [hcomm_c]
            _ = (Z_K.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ W ≤ ⊤)).op).hom
                  (α_K.hom (algebraMap E K c)) := rfl }
    let Φ : ∀ W : Z.Opens,
        TensorProduct E K ↑(Z.presheaf.obj (Opposite.op W)) →ₐ[K]
          ↑(Z_K.presheaf.obj (Opposite.op (p ⁻¹ᵁ W))) :=
      fun W => Algebra.TensorProduct.lift (Algebra.ofId K _) (ψ W) (fun _ _ => mul_comm _ _)
    have hΦ_tmul : ∀ (W : Z.Opens) (c : K) (r : ↑(Z.presheaf.obj (Opposite.op W))),
        Φ W (c ⊗ₜ[E] r) = algebraMap K ↑(Z_K.presheaf.obj (Opposite.op (p ⁻¹ᵁ W))) c *
          (p.app W).hom r :=
      fun W c r => Algebra.TensorProduct.lift_tmul (Algebra.ofId K _) (ψ W) (fun _ _ => mul_comm _ _) c r
    let ψ_top : ↑(Z.presheaf.obj (Opposite.op ⊤)) →ₐ[E]
        ↑(Z_K.presheaf.obj (Opposite.op ⊤)) :=
      { toRingHom := p.appTop.hom
        commutes' := fun c => by
          have hc := congrArg (fun φ => φ.hom c) hα_comm
          dsimp at hc ⊢
          change p.appTop.hom ((Z.presheaf.map (homOfLE le_top).op).hom (α_E.hom c)) =
            (Z_K.presheaf.map (homOfLE le_top).op).hom (α_K.hom (algebraMap E K c))
          rw [hMapIdZ le_top, hMapIdZK le_top]
          exact hc }
    let Φ_top : TensorProduct E K ↑(Z.presheaf.obj (Opposite.op ⊤)) →ₐ[K]
        ↑(Z_K.presheaf.obj (Opposite.op ⊤)) :=
      Algebra.TensorProduct.lift (Algebra.ofId K _) ψ_top (fun _ _ => mul_comm _ _)
    have hΦtop_tmul : ∀ (c : K) (r : ↑(Z.presheaf.obj (Opposite.op ⊤))),
        Φ_top (c ⊗ₜ[E] r) = algebraMap K ↑(Z_K.presheaf.obj (Opposite.op ⊤)) c *
          p.appTop.hom r :=
      fun c r => Algebra.TensorProduct.lift_tmul (Algebra.ofId K _) ψ_top (fun _ _ => mul_comm _ _) c r
    have hAffOpen : ∀ (W : Z.Opens), AlgebraicGeometry.IsAffineOpen W →
        Function.Bijective (Φ W) := by
      intro W hW
      let W_K : Z_K.Opens := p ⁻¹ᵁ W
      have hpW_app : W.topIso.inv ≫ (p ∣_ W).appTop ≫ W_K.topIso.hom = p.app W := by
        ext r
        have h1 := AlgebraicGeometry.Scheme.Opens.topIso_inv W
        have h2 := AlgebraicGeometry.morphismRestrict_appTop p W
        have h3 := AlgebraicGeometry.Scheme.Opens.topIso_hom W_K
        have hlhs : (W.topIso.inv ≫ (p ∣_ W).appTop ≫ W_K.topIso.hom).hom r =
            W_K.topIso.hom.hom (((p ∣_ W).appTop).hom (W.topIso.inv.hom r)) := rfl
        rw [hlhs, h1, h2, h3]
        change (Z_K.presheaf.map _).hom ((Z_K.presheaf.map _).hom
          ((Z.presheaf.map (eqToHom W.ι_image_top).op ≫ p.app (W.ι ''ᵁ ⊤)).hom r)) =
          (p.app W).hom r
        rw [AlgebraicGeometry.Scheme.Hom.naturality p (eqToHom W.ι_image_top).op]
        exact congrArg (fun φ => φ.hom ((p.app W).hom r)) (hMap3IdZK _ _ _)
      haveI : CategoryTheory.IsIso (W : AlgebraicGeometry.Scheme.{u}).toSpecΓ :=
        @AlgebraicGeometry.IsAffine.affine (W : AlgebraicGeometry.Scheme.{u}) hW
      let eW_top : AlgebraicGeometry.Spec Γ((W : AlgebraicGeometry.Scheme.{u}), ⊤) ≅
          AlgebraicGeometry.Spec (Z.presheaf.obj (Opposite.op W)) :=
        { hom := AlgebraicGeometry.Spec.map W.topIso.inv
          inv := AlgebraicGeometry.Spec.map W.topIso.hom
          hom_inv_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Iso.hom_inv_id,
              AlgebraicGeometry.Spec.map_id]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Iso.inv_hom_id,
              AlgebraicGeometry.Spec.map_id] }
      let eW_scheme : (W : AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (Z.presheaf.obj (Opposite.op W)) :=
        CategoryTheory.asIso (W : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≪≫ eW_top
      have heW_hom : eW_scheme.hom =
          (W : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫ AlgebraicGeometry.Spec.map W.topIso.inv :=
        rfl
      have hgW_eq : eW_scheme.hom ≫
          AlgebraicGeometry.Spec.map (α_E ≫ Z.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op) =
          W.ι ≫ g := by
        have hres : Z.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op ≫ W.topIso.inv = W.ι.appTop := by
          rw [AlgebraicGeometry.Scheme.Opens.topIso_inv, AlgebraicGeometry.Scheme.Opens.ι_appTop]
          exact (Z.presheaf.map_comp _ _).symm.trans
            (congrArg Z.presheaf.map (Subsingleton.elim _ _))
        have hmap : (α_E ≫ Z.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op) ≫ W.topIso.inv =
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of E)).inv ≫ (W.ι ≫ g).appTop := by
          rw [CategoryTheory.Category.assoc, hres, AlgebraicGeometry.Scheme.Hom.comp_appTop,
            CategoryTheory.Category.assoc]
        calc
          eW_scheme.hom ≫
              AlgebraicGeometry.Spec.map (α_E ≫ Z.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op)
            = (W : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫ AlgebraicGeometry.Spec.map
                ((α_E ≫ Z.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op) ≫ W.topIso.inv) := by
              rw [heW_hom, CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
          _ = ((W : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
                AlgebraicGeometry.Spec.map (W.ι ≫ g).appTop) ≫
                AlgebraicGeometry.Spec.map
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of E)).inv := by
              rw [hmap, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
          _ = (W.ι ≫ g) ≫ (AlgebraicGeometry.Spec (CommRingCat.of E)).toSpecΓ ≫
                AlgebraicGeometry.Spec.map
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of E)).inv := by
              rw [← AlgebraicGeometry.Scheme.toSpecΓ_naturality (W.ι ≫ g),
                CategoryTheory.Category.assoc]
          _ = W.ι ≫ g := by
              rw [← AlgebraicGeometry.SpecMap_ΓSpecIso_hom (CommRingCat.of E),
                ← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Iso.inv_hom_id,
                AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.comp_id]
      have hpW : CategoryTheory.IsPullback (p ∣_ W) (W_K.ι ≫ g_K) (W.ι ≫ g) s :=
        (AlgebraicGeometry.isPullback_morphismRestrict p W).paste_vert hp
      have hpW_spec : CategoryTheory.IsPullback ((p ∣_ W) ≫ eW_scheme.hom) (W_K.ι ≫ g_K)
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap E ↑(Z.presheaf.obj (Opposite.op W))))) s := by
        refine hpW.of_iso (CategoryTheory.Iso.refl _) eW_scheme
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (CategoryTheory.Category.id_comp _).symm
          (CategoryTheory.Category.id_comp _).symm
          ((CategoryTheory.Category.comp_id _).trans hgW_eq.symm)
          ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)
      let inlW_hom : K →+* TensorProduct E K ↑(Z.presheaf.obj (Opposite.op W)) :=
        Algebra.TensorProduct.includeLeftRingHom
      let inrW_alg : ↑(Z.presheaf.obj (Opposite.op W)) →ₐ[E]
          TensorProduct E K ↑(Z.presheaf.obj (Opposite.op W)) :=
        Algebra.TensorProduct.includeRight
      let inlW : CommRingCat.of K ⟶
          CommRingCat.of (TensorProduct E K ↑(Z.presheaf.obj (Opposite.op W))) :=
        CommRingCat.ofHom inlW_hom
      let inrW : Z.presheaf.obj (Opposite.op W) ⟶
          CommRingCat.of (TensorProduct E K ↑(Z.presheaf.obj (Opposite.op W))) :=
        CommRingCat.ofHom inrW_alg.toRingHom
      have hPushW : CategoryTheory.IsPushout
          (CommRingCat.ofHom (algebraMap E ↑(Z.presheaf.obj (Opposite.op W))))
          (CommRingCat.ofHom (algebraMap E K)) inrW inlW :=
        (CommRingCat.isPushout_tensorProduct E K ↑(Z.presheaf.obj (Opposite.op W))).flip
      have hpTensor : CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map inrW)
          (AlgebraicGeometry.Spec.map inlW)
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap E ↑(Z.presheaf.obj (Opposite.op W))))) s :=
        AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ inrW inlW hPushW
      let e_WK : (W_K : AlgebraicGeometry.Scheme.{u}) ≅ AlgebraicGeometry.Spec
          (CommRingCat.of (TensorProduct E K ↑(Z.presheaf.obj (Opposite.op W)))) :=
        hpW_spec.isoPullback ≪≫ hpTensor.isoPullback.symm
      have heWK_fst : e_WK.hom ≫ AlgebraicGeometry.Spec.map inrW =
          (p ∣_ W) ≫ eW_scheme.hom := by
        simp [e_WK]
      have heWK_snd : e_WK.hom ≫ AlgebraicGeometry.Spec.map inlW = W_K.ι ≫ g_K := by
        simp [e_WK]
      let e_appTop : Γ(AlgebraicGeometry.Spec
          (CommRingCat.of (TensorProduct E K ↑(Z.presheaf.obj (Opposite.op W)))), ⊤) ≅
          Γ((W_K : AlgebraicGeometry.Scheme.{u}), ⊤) :=
        { hom := e_WK.hom.appTop
          inv := e_WK.inv.appTop
          hom_inv_id := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_WK.inv_hom_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_WK.hom_inv_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop] }
      let e_ring : CommRingCat.of (TensorProduct E K ↑(Z.presheaf.obj (Opposite.op W))) ≅
          Z_K.presheaf.obj (Opposite.op W_K) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso
          (CommRingCat.of (TensorProduct E K ↑(Z.presheaf.obj (Opposite.op W))))).symm ≪≫
          e_appTop ≪≫ W_K.topIso
      have he_left : inlW ≫ e_ring.hom =
          α_K ≫ Z_K.presheaf.map (homOfLE (le_top : W_K ≤ ⊤)).op := by
        have hnat : inlW ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso
              (CommRingCat.of (TensorProduct E K ↑(Z.presheaf.obj (Opposite.op W))))).inv =
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
              (AlgebraicGeometry.Spec.map inlW).appTop := by
          rw [← CategoryTheory.cancel_mono
            (AlgebraicGeometry.Scheme.ΓSpecIso
              (CommRingCat.of (TensorProduct E K ↑(Z.presheaf.obj (Opposite.op W))))).hom]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.comp_id,
            AlgebraicGeometry.Scheme.ΓSpecIso_naturality, ← CategoryTheory.Category.assoc,
            CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp]
        have hresK : W_K.ι.appTop ≫ W_K.topIso.hom =
            Z_K.presheaf.map (homOfLE (le_top : W_K ≤ ⊤)).op := by
          rw [AlgebraicGeometry.Scheme.Opens.ι_appTop, AlgebraicGeometry.Scheme.Opens.topIso_hom]
          exact (Z_K.presheaf.map_comp _ _).symm.trans
            (congrArg Z_K.presheaf.map (Subsingleton.elim _ _))
        calc
          inlW ≫ e_ring.hom
            = (inlW ≫ (AlgebraicGeometry.Scheme.ΓSpecIso _).inv) ≫
                e_WK.hom.appTop ≫ W_K.topIso.hom := by
              dsimp only [e_ring, e_appTop, CategoryTheory.Iso.trans_hom,
                CategoryTheory.Iso.symm_hom]
              simp only [CategoryTheory.Category.assoc]
          _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
                ((AlgebraicGeometry.Spec.map inlW).appTop ≫ e_WK.hom.appTop) ≫ W_K.topIso.hom := by
              rw [hnat, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
          _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
                (W_K.ι ≫ g_K).appTop ≫ W_K.topIso.hom := by
              rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, heWK_snd]
          _ = α_K ≫ (W_K.ι.appTop ≫ W_K.topIso.hom) := by
              rw [AlgebraicGeometry.Scheme.Hom.comp_appTop]
              dsimp only [α_K]
              simp only [CategoryTheory.Category.assoc]
          _ = α_K ≫ Z_K.presheaf.map (homOfLE (le_top : W_K ≤ ⊤)).op := by
              rw [hresK]
      have he_right : inrW ≫ e_ring.hom = p.app W := by
        have hnat : inrW ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso
              (CommRingCat.of (TensorProduct E K ↑(Z.presheaf.obj (Opposite.op W))))).inv =
