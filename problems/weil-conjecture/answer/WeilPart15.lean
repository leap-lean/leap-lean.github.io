        S.ShortExact := by
      intro H _ S hinj hsurj hex
      have hmono : CategoryTheory.Mono S.f := (Rep.mono_iff_injective S.f).mpr hinj
      have hepi : CategoryTheory.Epi S.g := (Rep.epi_iff_surjective S.g).mpr hsurj
