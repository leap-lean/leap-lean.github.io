          exact (h.left.base y).2
        rw [← hb, hy y]
      · have := hEmpty_sub Y (not_nonempty_iff.mp hY)
        exact Subsingleton.elim _ _
    have hψ_unique : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left ↥A)
