        refine ⟨⟨s_t, hst_not_q⟩, hj_inj ?_⟩
        dsimp only
        calc
          j (s_t * x₁) = (t * j r₀ ^ N) * j x₁ := by rw [map_mul, ← hst]
          _ = j r₀ ^ N * (t * j x₁) := by ring
          _ = j r₀ ^ N * (t * j x₂) := by rw [htx]
          _ = (t * j r₀ ^ N) * j x₂ := by ring
          _ = j (s_t * x₂) := by rw [hst, map_mul] }
  obtain ⟨s, e, he, hLocD⟩ := hHenselB ↥S'
  rcases he with ⟨horth, hcomplete⟩
  have hex_j₀ : ∃ j₀ : Fin s, e j₀ ∉ 𝔮' := by
    by_contra h_all
    have h_mem : ∀ i : Fin s, e i ∈ 𝔮' := fun i =>
