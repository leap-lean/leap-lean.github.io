      fun _ _ _ => MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)
    let j_obj : (W.toScheme.Etaleᵒᵖ ⥤ A) → (Z.Etaleᵒᵖ ⥤ A) := fun P =>
      { obj := fun opT => if h : Φ opT.unop then P.obj (Opposite.op (liftObj opT.unop h)) else (0 : A)
        map := fun {opT₂ opT₁} f =>
          if h₂ : Φ opT₂.unop then
