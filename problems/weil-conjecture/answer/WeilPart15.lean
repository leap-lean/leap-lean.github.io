          let g_V' := δ_pre V'.toScheme hSE_V' 0
          have h0_V' : f_V' ≫ g_V' = 0 :=
            NatTrans.ext (funext fun opW =>
              (fun {S₀ : ShortComplex AddCommGrpCat.{u}} (_ : S₀.Exact) => S₀.zero)
                (Abelian.Ext.covariant_sequence_exact₃'
                  (R_sh_of V'.toScheme opW.unop) hSE_V' 0 1 rfl))
          have hEpi_X' : ∀ (opW : V'.toScheme.Etaleᵒᵖ), Epi (AddCommGrpCat.ofHom
              (hSE.extClass.postcomp (R_sh_of X' (E_V'.obj opW.unop)) (rfl : 0 + 1 = 1))) := by
            intro opW
            rw [AddCommGrpCat.epi_iff_surjective]
            intro x₁
            have hz : x₁.comp (Abelian.Ext.mk₀ SC.f) (Nat.add_zero 1) = 0 :=
              Abelian.Ext.eq_zero_of_injective _
            exact Abelian.Ext.covariant_sequence_exact₁ (R_sh_of X' (E_V'.obj opW.unop)) hSE x₁ hz rfl
          have hEpi_V' : ∀ (opW : V'.toScheme.Etaleᵒᵖ), Epi (AddCommGrpCat.ofHom
              (hSE_V'.extClass.postcomp (R_sh_of V'.toScheme opW.unop) (rfl : 0 + 1 = 1))) := by
            intro opW
            rw [AddCommGrpCat.epi_iff_surjective]
            intro x₁
            have : Injective SC_V'.X₂ := hInj_JV'
            have hz : x₁.comp (Abelian.Ext.mk₀ SC_V'.f) (Nat.add_zero 1) = 0 :=
              Abelian.Ext.eq_zero_of_injective _
            exact Abelian.Ext.covariant_sequence_exact₁ (R_sh_of V'.toScheme opW.unop) hSE_V' x₁ hz rfl
          let hc_X' : ∀ opW, Limits.IsColimit
              (Limits.CokernelCofork.ofπ ((R_EV'.map g_X').app opW)
                (congrArg (fun α => α.app opW) h0_X')) := fun opW => by
            have := hEpi_X' opW
            exact (Abelian.Ext.covariant_sequence_exact₃'
              (R_sh_of X' (E_V'.obj opW.unop)) hSE 0 1 rfl).gIsCokernel
          let hc_V' : ∀ opW, Limits.IsColimit
              (Limits.CokernelCofork.ofπ (g_V'.app opW)
                (congrArg (fun α => α.app opW) h0_V')) := fun opW => by
            have := hEpi_V' opW
            exact (Abelian.Ext.covariant_sequence_exact₃'
              (R_sh_of V'.toScheme opW.unop) hSE_V' 0 1 rfl).gIsCokernel
          obtain ⟨e_cok₁⟩ := hNatCokernel (R_EV'.map f_X') (R_EV'.map g_X') h0_X' hEpi_X' hc_X'
          obtain ⟨e_cok₂⟩ := hNatCokernel f_V' g_V' h0_V' hEpi_V' hc_V'
          let e_mid := Limits.cokernel.mapIso (R_EV'.map f_X') f_V'
            (τ₀.app SC.X₂) (τ₀.app SC.X₃) (τ₀.hom.naturality SC.g)
          exact ⟨e_cok₁.symm ≪≫ e_mid ≪≫ e_cok₂⟩
        | succ k =>
          have : IsIso (δ_pre X' hSE (k + 1)) := hConnIso X' hSE k
          have : Injective SC_V'.X₂ := hInj_JV'
          have : IsIso (δ_pre V'.toScheme hSE_V' (k + 1)) := hConnIso V'.toScheme hSE_V' k
          obtain ⟨e_ih⟩ := ih SC.X₃
          exact ⟨R_EV'.mapIso (asIso (δ_pre X' hSE (k + 1))).symm ≪≫ e_ih ≪≫
            asIso (δ_pre V'.toScheme hSE_V' (k + 1))⟩
    obtain ⟨e_coh⟩ := hCohIso q G'
    let P_X' := Sheaf.cohomologyPresheaf G' q
    let P_V' := Sheaf.cohomologyPresheaf (res_V'.obj G') q
    let e_EB_pre : E_U'.op ⋙ (B_f'.op ⋙ P_X') ≅ B_f'U.op ⋙ (E_V'.op ⋙ P_X') :=
      NatIso.ofComponents
        (fun opT =>
          { hom := P_X'.map (e_EB.hom.app opT.unop).op
            inv := P_X'.map (e_EB.inv.app opT.unop).op
            hom_inv_id := by
              rw [← P_X'.map_comp]
              have h1 : (e_EB.hom.app opT.unop).op ≫ (e_EB.inv.app opT.unop).op =
                  𝟙 (Opposite.op (B_f'.obj (E_U'.obj opT.unop))) :=
                Opposite.unop_injective (Iso.inv_hom_id_app e_EB opT.unop)
              exact (congrArg P_X'.map h1).trans (P_X'.map_id _)
            inv_hom_id := by
              rw [← P_X'.map_comp]
              have h1 : (e_EB.inv.app opT.unop).op ≫ (e_EB.hom.app opT.unop).op =
                  𝟙 (Opposite.op (E_V'.obj (B_f'U.obj opT.unop))) :=
                Opposite.unop_injective (Iso.hom_inv_id_app e_EB opT.unop)
              exact (congrArg P_X'.map h1).trans (P_X'.map_id _) })
        (fun {opT₁ opT₂} v => by
          change P_X'.map (B_f'.map (E_U'.map v.unop)).op ≫ P_X'.map (e_EB.hom.app opT₂.unop).op =
            P_X'.map (e_EB.hom.app opT₁.unop).op ≫ P_X'.map (E_V'.map (B_f'U.map v.unop)).op
          rw [← P_X'.map_comp, ← P_X'.map_comp]
          exact congrArg P_X'.map (congrArg Quiver.Hom.op (e_EB.hom.naturality v.unop).symm))
    let e_pre : E_U'.op ⋙ (B_f'.op ⋙ P_X') ≅ B_f'U.op ⋙ P_V' :=
      e_EB_pre ≪≫ Functor.isoWhiskerLeft B_f'U.op e_coh
    exact ⟨σ_sh.app (B_f'.op ⋙ P_X') ≪≫
      (presheafToSheaf U'.toScheme.smallEtaleTopology AddCommGrpCat.{u}).mapIso e_pre⟩

  
  have hMateComp : ∀ {C₁ C₂ C₃ : Type (u + 1)}
      [Category.{u + 1, u + 1} C₁] [Category.{u + 1, u + 1} C₂] [Category.{u + 1, u + 1} C₃]
      {L₁₂ : C₁ ⥤ C₃} {R₁₂ : C₃ ⥤ C₁} (adj₁₂ : L₁₂ ⊣ R₁₂)
      {L₂ : C₁ ⥤ C₂} {R₂ : C₂ ⥤ C₁} (adj₂ : L₂ ⊣ R₂)
      {L₁ : C₂ ⥤ C₃} {R₁ : C₃ ⥤ C₂} (adj₁ : L₁ ⊣ R₁)
      (α : R₁₂ ≅ R₁ ⋙ R₂) (X₀ : C₁) (Z₀ : C₃) (φ : L₁.obj (L₂.obj X₀) ⟶ Z₀),
      let lam : L₁₂ ≅ L₂ ⋙ L₁ := adj₁₂.leftAdjointUniq ((adj₂.comp adj₁).ofNatIsoRight α.symm)
      adj₁₂.homEquiv X₀ Z₀ (lam.hom.app X₀ ≫ φ) =
        adj₂.homEquiv X₀ (R₁.obj Z₀) (adj₁.homEquiv (L₂.obj X₀) Z₀ φ) ≫ α.inv.app Z₀ := by
    intro C₁ C₂ C₃ _ _ _ L₁₂ R₁₂ adj₁₂ L₂ R₂ adj₂ L₁ R₁ adj₁ α X₀ Z₀ φ lam
    have h1 := adj₁₂.homEquiv_naturality_right (lam.hom.app X₀) φ
    have h2 := Adjunction.homEquiv_leftAdjointUniq_hom_app adj₁₂
      ((adj₂.comp adj₁).ofNatIsoRight α.symm) X₀
    rw [h1, h2]
    dsimp [Adjunction.ofNatIsoRight]
    rw [Category.assoc, ← α.inv.naturality φ]
    simp only [Adjunction.homEquiv_unit, Adjunction.comp_unit_app, Functor.comp_map,
      Functor.map_comp, Category.assoc]

  let P_et : MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    fun ⦃_ _⦄ h₀ => AlgebraicGeometry.Etale h₀
  have : P_et.IsStableUnderComposition :=
    { comp_mem := fun _ _ hf hg => by
        haveI : AlgebraicGeometry.Etale _ := hf
        haveI : AlgebraicGeometry.Etale _ := hg
        exact inferInstance }
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f₀ : Z₁ ⟶ Z₂), P_et.HasPullbacksAlong f₀ :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f₀ : Z₁ ⟶ Z₂),
      P_et.IsStableUnderBaseChangeAlong f₀ :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Etale) hp hg)

  have h_comp_hom : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}} (f₁ : X₁ ⟶ X₂) (f₂ : X₂ ⟶ X₃)
      (A₀ : MorphismProperty.Over P_et ⊤ X₃),
      (((MorphismProperty.Over.pullbackComp f₁ f₂).hom.app A₀).left ≫
        Limits.pullback.fst ((MorphismProperty.Over.pullback P_et ⊤ f₂).obj A₀).hom f₁) ≫
        Limits.pullback.fst A₀.hom f₂ =
      Limits.pullback.fst A₀.hom (f₁ ≫ f₂) :=
    fun f₁ f₂ A₀ => (Category.assoc _ _ _).trans
      (MorphismProperty.Over.pullbackComp_left_fst_fst f₁ f₂ A₀)

  have h_comp_inv : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}} (f₁ : X₁ ⟶ X₂) (f₂ : X₂ ⟶ X₃)
      (A₀ : MorphismProperty.Over P_et ⊤ X₃),
      ((MorphismProperty.Over.pullbackComp f₁ f₂).inv.app A₀).left ≫
        Limits.pullback.fst A₀.hom (f₁ ≫ f₂) =
      Limits.pullback.fst ((MorphismProperty.Over.pullback P_et ⊤ f₂).obj A₀).hom f₁ ≫
        Limits.pullback.fst A₀.hom f₂ :=
    fun f₁ f₂ A₀ =>
      let e := (MorphismProperty.Over.pullbackComp (P := P_et) (Q := ⊤) f₁ f₂).app A₀
      let fst₁ := Limits.pullback.fst ((MorphismProperty.Over.pullback P_et ⊤ f₂).obj A₀).hom f₁
      let fst₂ := Limits.pullback.fst A₀.hom f₂
      have h_inv : e.inv.left ≫ e.hom.left = 𝟙 _ := congrArg (fun k => k.left) e.inv_hom_id
      (congrArg (e.inv.left ≫ ·) (h_comp_hom f₁ f₂ A₀).symm).trans
        (((Category.assoc e.inv.left (e.hom.left ≫ fst₁) fst₂).symm).trans
          (congrArg (· ≫ fst₂)
            (((Category.assoc e.inv.left e.hom.left fst₁).symm).trans
              ((congrArg (· ≫ fst₁) h_inv).trans (Category.id_comp fst₁)))))

  have h_congr_hom : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} {f₁ f₂ : X₁ ⟶ X₂} (h : f₁ = f₂)
      (A₀ : MorphismProperty.Over P_et ⊤ X₂),
      ((MorphismProperty.Over.pullbackCongr h).hom.app A₀).left ≫
        Limits.pullback.fst A₀.hom f₂ =
      Limits.pullback.fst A₀.hom f₁ :=
    fun h A₀ => MorphismProperty.Over.pullbackCongr_hom_app_left_fst h A₀

  have h_congr_inv : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} {f₁ f₂ : X₁ ⟶ X₂} (h : f₁ = f₂)
      (A₀ : MorphismProperty.Over P_et ⊤ X₂),
      ((MorphismProperty.Over.pullbackCongr h).inv.app A₀).left ≫
        Limits.pullback.fst A₀.hom f₁ =
      Limits.pullback.fst A₀.hom f₂ :=
    fun {_ _ _ f₂} h A₀ =>
      let e := (MorphismProperty.Over.pullbackCongr (P := P_et) (Q := ⊤) h).app A₀
      let fst₂ := Limits.pullback.fst A₀.hom f₂
      have h_inv : e.inv.left ≫ e.hom.left = 𝟙 _ := congrArg (fun k => k.left) e.inv_hom_id
      (congrArg (e.inv.left ≫ ·) (h_congr_hom h A₀).symm).trans
        (((Category.assoc e.inv.left e.hom.left fst₂).symm).trans
          ((congrArg (· ≫ fst₂) h_inv).trans (Category.id_comp fst₂)))

  have h_map_fst : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f₀ : X₁ ⟶ X₂)
      {A₀ B₀ : MorphismProperty.Over P_et ⊤ X₂} (u : A₀ ⟶ B₀),
      ((MorphismProperty.Over.pullback P_et ⊤ f₀).map u).left ≫
        Limits.pullback.fst B₀.hom f₀ =
      Limits.pullback.fst A₀.hom f₀ ≫ u.left := by
    intro X₁ X₂ f₀ A₀ B₀ u
    exact (congrArg (· ≫ Limits.pullback.fst B₀.hom f₀)
      (MorphismProperty.Over.pullback_map_left P_et ⊤ f₀ u)).trans
      (Limits.pullback.lift_fst _ _ _)

  have h_efun_inv : ∀ {X₁ S₁ S₂ X₂ : AlgebraicGeometry.Scheme.{u}}
      (p₀ : X₁ ⟶ S₁) (p₁ : X₂ ⟶ S₂) (q₀ : S₂ ⟶ S₁) (q'₀ : X₂ ⟶ X₁)
      (hw : q'₀ ≫ p₀ = p₁ ≫ q₀) (A₀ : MorphismProperty.Over P_et ⊤ S₁),
      ((((MorphismProperty.Over.pullbackComp (P := P_et) (Q := ⊤) q'₀ p₀).symm ≪≫
          MorphismProperty.Over.pullbackCongr hw ≪≫
          MorphismProperty.Over.pullbackComp p₁ q₀).inv.app A₀).left ≫
        Limits.pullback.fst ((MorphismProperty.Over.pullback P_et ⊤ p₀).obj A₀).hom q'₀) ≫
        Limits.pullback.fst A₀.hom p₀ =
      Limits.pullback.fst ((MorphismProperty.Over.pullback P_et ⊤ q₀).obj A₀).hom p₁ ≫
        Limits.pullback.fst A₀.hom q₀ :=
    fun p₀ p₁ q₀ q'₀ hw A₀ =>
      let a := ((MorphismProperty.Over.pullbackComp (P := P_et) (Q := ⊤) p₁ q₀).inv.app A₀).left
      let b := ((MorphismProperty.Over.pullbackCongr (P := P_et) (Q := ⊤) hw).inv.app A₀).left
      let c := ((MorphismProperty.Over.pullbackComp (P := P_et) (Q := ⊤) q'₀ p₀).hom.app A₀).left
      let x := Limits.pullback.fst ((MorphismProperty.Over.pullback P_et ⊤ p₀).obj A₀).hom q'₀
      let y := Limits.pullback.fst A₀.hom p₀
      (congrArg (fun k => (k ≫ x) ≫ y) (Category.assoc a b c)).trans
        ((Category.assoc (a ≫ b ≫ c) x y).trans
          ((Category.assoc a (b ≫ c) (x ≫ y)).trans
            ((congrArg (a ≫ ·)
              ((Category.assoc b c (x ≫ y)).trans
                ((congrArg (b ≫ ·)
                  (MorphismProperty.Over.pullbackComp_left_fst_fst q'₀ p₀ A₀)).trans
                  (h_congr_inv hw A₀)))).trans
              (h_comp_inv p₁ q₀ A₀))))

  have h_qfun_hom : ∀ {S₁ S₂ S₃ : AlgebraicGeometry.Scheme.{u}}
      (q₁ : S₃ ⟶ S₂) (q₂ : S₂ ⟶ S₁) (q_tot : S₃ ⟶ S₁) (hq : q₁ ≫ q₂ = q_tot)
      (A₀ : MorphismProperty.Over P_et ⊤ S₁),
      (((MorphismProperty.Over.pullbackCongr (P := P_et) (Q := ⊤) hq.symm ≪≫
          MorphismProperty.Over.pullbackComp q₁ q₂).hom.app A₀).left ≫
        Limits.pullback.fst ((MorphismProperty.Over.pullback P_et ⊤ q₂).obj A₀).hom q₁) ≫
        Limits.pullback.fst A₀.hom q₂ =
      Limits.pullback.fst A₀.hom q_tot :=
    fun q₁ q₂ q_tot hq A₀ =>
      let u := ((MorphismProperty.Over.pullbackCongr (P := P_et) (Q := ⊤) hq.symm).hom.app A₀).left
      let v := ((MorphismProperty.Over.pullbackComp (P := P_et) (Q := ⊤) q₁ q₂).hom.app A₀).left
      let f₁ := Limits.pullback.fst ((MorphismProperty.Over.pullback P_et ⊤ q₂).obj A₀).hom q₁
      let f₂ := Limits.pullback.fst A₀.hom q₂
      (Category.assoc (u ≫ v) f₁ f₂).trans
        ((Category.assoc u v (f₁ ≫ f₂)).trans
          ((congrArg (u ≫ ·)
            (MorphismProperty.Over.pullbackComp_left_fst_fst q₁ q₂ A₀)).trans
            (h_congr_hom hq.symm A₀)))

  have hCubeLeft : ∀ {X₀ S₀ S₁ X₁ S₂ X₂ : AlgebraicGeometry.Scheme.{u}}
      (p₀ : X₀ ⟶ S₀) (p₁ : X₁ ⟶ S₁) (p₂ : X₂ ⟶ S₂)
      (q₂ : S₁ ⟶ S₀) (q₁ : S₂ ⟶ S₁) (q_tot : S₂ ⟶ S₀)
      (q'₂ : X₁ ⟶ X₀) (q'₁ : X₂ ⟶ X₁) (q'_tot : X₂ ⟶ X₀)
      (hq : q₁ ≫ q₂ = q_tot) (hq' : q'₁ ≫ q'₂ = q'_tot)
      (hw₁ : q'₁ ≫ p₁ = p₂ ≫ q₁) (hw₂ : q'₂ ≫ p₀ = p₁ ≫ q₂) (hw_tot : q'_tot ≫ p₀ = p₂ ≫ q_tot)
      (T : MorphismProperty.Over P_et ⊤ S₀),
      let B_p₀ := MorphismProperty.Over.pullback P_et ⊤ p₀
      let B_p₁ := MorphismProperty.Over.pullback P_et ⊤ p₁
      let B_p₂ := MorphismProperty.Over.pullback P_et ⊤ p₂
      let B_q₂ := MorphismProperty.Over.pullback P_et ⊤ q₂
      let B_q₁ := MorphismProperty.Over.pullback P_et ⊤ q₁
      let B_qtot := MorphismProperty.Over.pullback P_et ⊤ q_tot
      let B_q'₂ := MorphismProperty.Over.pullback P_et ⊤ q'₂
      let B_q'₁ := MorphismProperty.Over.pullback P_et ⊤ q'₁
      let e_fun₂ : B_p₀.comp B_q'₂ ≅ B_q₂.comp B_p₁ :=
        (MorphismProperty.Over.pullbackComp q'₂ p₀).symm ≪≫
          MorphismProperty.Over.pullbackCongr hw₂ ≪≫
          MorphismProperty.Over.pullbackComp p₁ q₂
      let e_fun₁ : B_p₁.comp B_q'₁ ≅ B_q₁.comp B_p₂ :=
        (MorphismProperty.Over.pullbackComp q'₁ p₁).symm ≪≫
          MorphismProperty.Over.pullbackCongr hw₁ ≪≫
          MorphismProperty.Over.pullbackComp p₂ q₁
      let e_fun_tot : B_p₀.comp (MorphismProperty.Over.pullback P_et ⊤ q'_tot) ≅ B_qtot.comp B_p₂ :=
        (MorphismProperty.Over.pullbackComp q'_tot p₀).symm ≪≫
          MorphismProperty.Over.pullbackCongr hw_tot ≪≫
          MorphismProperty.Over.pullbackComp p₂ q_tot
      let e_q_fun : B_qtot ≅ B_q₂.comp B_q₁ :=
        MorphismProperty.Over.pullbackCongr hq.symm ≪≫ MorphismProperty.Over.pullbackComp q₁ q₂
      let e_q'_fun : MorphismProperty.Over.pullback P_et ⊤ q'_tot ≅ B_q'₂.comp B_q'₁ :=
        MorphismProperty.Over.pullbackCongr hq'.symm ≪≫ MorphismProperty.Over.pullbackComp q'₁ q'₂
      e_fun_tot.inv.app T ≫ e_q'_fun.hom.app (B_p₀.obj T) =
        B_p₂.map (e_q_fun.hom.app T) ≫ e_fun₁.inv.app (B_q₂.obj T) ≫
          B_q'₁.map (e_fun₂.inv.app T) := by
    intro X₀ S₀ S₁ X₁ S₂ X₂ p₀ p₁ p₂ q₂ q₁ q_tot q'₂ q'₁ q'_tot
      hq hq' hw₁ hw₂ hw_tot T B_p₀ B_p₁ B_p₂ B_q₂ B_q₁ B_qtot B_q'₂ B_q'₁
      e_fun₂ e_fun₁ e_fun_tot e_q_fun e_q'_fun
    let D₃ := B_p₀.obj T
    let D₂ := B_q'₂.obj D₃
    let D₁ := B_q'₁.obj D₂
    let S_src := B_p₂.obj (B_qtot.obj T)
    let ψ_L : S_src ⟶ D₁ := e_fun_tot.inv.app T ≫ e_q'_fun.hom.app D₃
    let ψ_R : S_src ⟶ D₁ :=
      B_p₂.map (e_q_fun.hom.app T) ≫ e_fun₁.inv.app (B_q₂.obj T) ≫ B_q'₁.map (e_fun₂.inv.app T)
    change ψ_L = ψ_R
    have hwL : ψ_L.left ≫ D₁.hom = S_src.hom := MorphismProperty.Over.w ψ_L
    have hwR : ψ_R.left ≫ D₁.hom = S_src.hom := MorphismProperty.Over.w ψ_R
    have h_mid : ∀ (w : S_src.left ⟶ D₁.left), w ≫ D₁.hom = S_src.hom →
        (w ≫ Limits.pullback.fst D₂.hom q'₁) ≫ D₂.hom = S_src.hom ≫ q'₁ :=
      fun w hw => (Category.assoc _ _ _).trans
        ((congrArg (w ≫ ·) Limits.pullback.condition).trans
          ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ q'₁) hw)))
    have h_top : ∀ (w : S_src.left ⟶ D₁.left), w ≫ D₁.hom = S_src.hom →
        ((w ≫ Limits.pullback.fst D₂.hom q'₁) ≫ Limits.pullback.fst D₃.hom q'₂) ≫ D₃.hom =
          (S_src.hom ≫ q'₁) ≫ q'₂ :=
      fun w hw => (Category.assoc _ _ _).trans
        ((congrArg ((w ≫ Limits.pullback.fst D₂.hom q'₁) ≫ ·) Limits.pullback.condition).trans
          ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ q'₂) (h_mid w hw))))
    apply MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
    apply Limits.pullback.hom_ext
    · apply Limits.pullback.hom_ext
      · apply Limits.pullback.hom_ext
        · let f₁ := Limits.pullback.fst D₂.hom q'₁
          let f₂ := Limits.pullback.fst D₃.hom q'₂
          let f₃ := Limits.pullback.fst T.hom p₀
          let aL := (e_fun_tot.inv.app T).left
          let bL := (e_q'_fun.hom.app D₃).left
          have hLHS : (((aL ≫ bL) ≫ f₁) ≫ f₂) ≫ f₃ =
              Limits.pullback.fst (B_qtot.obj T).hom p₂ ≫ Limits.pullback.fst T.hom q_tot :=
            (congrArg (· ≫ f₃)
              ((congrArg (· ≫ f₂) (Category.assoc aL bL f₁)).trans
                ((Category.assoc aL (bL ≫ f₁) f₂).trans
                  (congrArg (aL ≫ ·) (h_qfun_hom q'₁ q'₂ q'_tot hq' D₃))))).trans
              (h_efun_inv p₀ p₂ q_tot q'_tot hw_tot T)
          let r₁ := (B_p₂.map (e_q_fun.hom.app T)).left
          let r₂ := (e_fun₁.inv.app (B_q₂.obj T)).left
          let r₃ := (B_q'₁.map (e_fun₂.inv.app T)).left
          let g₁ := Limits.pullback.fst (B_p₁.obj (B_q₂.obj T)).hom q'₁
          let h₁ := Limits.pullback.fst (B_q₂.obj T).hom p₁
          let h₂ := Limits.pullback.fst T.hom q₂
          let k₁ := Limits.pullback.fst (B_q₁.obj (B_q₂.obj T)).hom p₂
          let k₂ := Limits.pullback.fst (B_q₂.obj T).hom q₁
          let m₁ := Limits.pullback.fst (B_qtot.obj T).hom p₂
          have s₃ : ((r₃ ≫ f₁) ≫ f₂) ≫ f₃ = g₁ ≫ (h₁ ≫ h₂) :=
            (congrArg (fun x => (x ≫ f₂) ≫ f₃) (h_map_fst q'₁ (e_fun₂.inv.app T))).trans
              ((congrArg (· ≫ f₃) (Category.assoc g₁ (e_fun₂.inv.app T).left f₂)).trans
                ((Category.assoc g₁ ((e_fun₂.inv.app T).left ≫ f₂) f₃).trans
                  (congrArg (g₁ ≫ ·) (h_efun_inv p₀ p₁ q₂ q'₂ hw₂ T))))
          have s₂ : (((r₂ ≫ r₃) ≫ f₁) ≫ f₂) ≫ f₃ = (k₁ ≫ k₂) ≫ h₂ :=
            (congrArg (fun x => (x ≫ f₂) ≫ f₃) (Category.assoc r₂ r₃ f₁)).trans
              ((congrArg (· ≫ f₃) (Category.assoc r₂ (r₃ ≫ f₁) f₂)).trans
                ((Category.assoc r₂ ((r₃ ≫ f₁) ≫ f₂) f₃).trans
                  ((congrArg (r₂ ≫ ·) s₃).trans
                    (((Category.assoc r₂ g₁ (h₁ ≫ h₂)).symm).trans
                      (((Category.assoc (r₂ ≫ g₁) h₁ h₂).symm).trans
                        (congrArg (· ≫ h₂) (h_efun_inv p₁ p₂ q₁ q'₁ hw₁ (B_q₂.obj T))))))))
          have hRHS : (((r₁ ≫ (r₂ ≫ r₃)) ≫ f₁) ≫ f₂) ≫ f₃ =
              m₁ ≫ Limits.pullback.fst T.hom q_tot :=
            (congrArg (fun x => (x ≫ f₂) ≫ f₃) (Category.assoc r₁ (r₂ ≫ r₃) f₁)).trans
              ((congrArg (· ≫ f₃) (Category.assoc r₁ ((r₂ ≫ r₃) ≫ f₁) f₂)).trans
                ((Category.assoc r₁ (((r₂ ≫ r₃) ≫ f₁) ≫ f₂) f₃).trans
                  ((congrArg (r₁ ≫ ·) s₂).trans
                    (((Category.assoc r₁ (k₁ ≫ k₂) h₂).symm).trans
                      ((congrArg (· ≫ h₂)
                        (((Category.assoc r₁ k₁ k₂).symm).trans
                          ((congrArg (· ≫ k₂) (h_map_fst p₂ (e_q_fun.hom.app T))).trans
                            (Category.assoc m₁ (e_q_fun.hom.app T).left k₂)))).trans
                        ((Category.assoc m₁ ((e_q_fun.hom.app T).left ≫ k₂) h₂).trans
                          (congrArg (m₁ ≫ ·) (h_qfun_hom q₁ q₂ q_tot hq T))))))))
          exact hLHS.trans hRHS.symm
        · exact (h_top ψ_L.left hwL).trans (h_top ψ_R.left hwR).symm
      · exact (h_mid ψ_L.left hwL).trans (h_mid ψ_R.left hwR).symm
    · exact hwL.trans hwR.symm

  have hOpenSiteLeft : ∀ {Y₀ Z₀ : AlgebraicGeometry.Scheme.{u}} (p : Y₀ ⟶ Z₀) (W₀ : Z₀.Opens)
      (hPW : P_et W₀.ι) (hPV : P_et (p ⁻¹ᵁ W₀).ι)
      (T : MorphismProperty.Over P_et ⊤ W₀.toScheme),
      let V_W : Y₀.Opens := p ⁻¹ᵁ W₀
      let p_W : V_W.toScheme ⟶ W₀.toScheme := p ∣_ W₀
      let hpb_W : IsPullback V_W.ι p_W p W₀.ι :=
        (AlgebraicGeometry.isPullback_morphismRestrict p W₀).flip
      let B_p := MorphismProperty.Over.pullback P_et ⊤ p
      let B_W := MorphismProperty.Over.pullback P_et ⊤ W₀.ι
      let B_pW := MorphismProperty.Over.pullback P_et ⊤ p_W
      let B_VW := MorphismProperty.Over.pullback P_et ⊤ V_W.ι
      let E_W := MorphismProperty.Over.map (P := P_et) ⊤ hPW
      let E_VW := MorphismProperty.Over.map (P := P_et) ⊤ hPV
      let adj_site_W := MorphismProperty.Over.mapPullbackAdj P_et ⊤ W₀.ι hPW trivial
      let adj_site_VW := MorphismProperty.Over.mapPullbackAdj P_et ⊤ V_W.ι hPV trivial
      let e_fun_W : B_p.comp B_VW ≅ B_W.comp B_pW :=
        (MorphismProperty.Over.pullbackComp V_W.ι p).symm ≪≫
          MorphismProperty.Over.pullbackCongr hpb_W.w ≪≫
          MorphismProperty.Over.pullbackComp p_W W₀.ι
      let hpb_TW : IsPullback (Limits.pullback.fst T.hom p_W)
          (Limits.pullback.snd T.hom p_W ≫ V_W.ι) (T.hom ≫ W₀.ι) p :=
        (IsPullback.of_hasPullback T.hom p_W).paste_vert
          (AlgebraicGeometry.isPullback_morphismRestrict p W₀)
      let iso_TW : E_VW.obj (B_pW.obj T) ≅ B_p.obj (E_W.obj T) :=
        MorphismProperty.Over.isoMk hpb_TW.isoPullback hpb_TW.isoPullback_hom_snd
      E_VW.map (B_pW.map (adj_site_W.unit.app T)) ≫
          E_VW.map (e_fun_W.inv.app (E_W.obj T)) ≫
          adj_site_VW.counit.app (B_p.obj (E_W.obj T)) =
        iso_TW.hom := by
    intro Y₀ Z₀ p W₀ hPW hPV T V_W p_W hpb_W B_p B_W B_pW B_VW E_W E_VW
      adj_site_W adj_site_VW e_fun_W hpb_TW iso_TW
    let φ_T : E_VW.obj (B_pW.obj T) ⟶ B_p.obj (E_W.obj T) :=
      E_VW.map (B_pW.map (adj_site_W.unit.app T)) ≫
        E_VW.map (e_fun_W.inv.app (E_W.obj T)) ≫
        adj_site_VW.counit.app (B_p.obj (E_W.obj T))
    change φ_T = iso_TW.hom
    apply MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
    have hwφ : φ_T.left ≫ (B_p.obj (E_W.obj T)).hom = (E_VW.obj (B_pW.obj T)).hom :=
      MorphismProperty.Over.w φ_T
    apply Limits.pullback.hom_ext
    · have hu_fst : (adj_site_W.unit.app T).left ≫ Limits.pullback.fst (E_W.obj T).hom W₀.ι =
          𝟙 T.left :=
        (congrArg (fun k : T ⟶ B_W.obj (E_W.obj T) =>
            k.left ≫ Limits.pullback.fst (E_W.obj T).hom W₀.ι)
          (MorphismProperty.Over.mapPullbackAdj_unit_app P_et ⊤ W₀.ι hPW trivial T)).trans
          (Limits.pullback.lift_fst _ _ _)
      have hc_left : (adj_site_VW.counit.app (B_p.obj (E_W.obj T))).left =
          Limits.pullback.fst (B_p.obj (E_W.obj T)).hom V_W.ι :=
        congrArg (fun k => k.left)
          (MorphismProperty.Over.mapPullbackAdj_counit_app P_et ⊤ V_W.ι hPV trivial
            (B_p.obj (E_W.obj T)))
      let a₁ := (B_pW.map (adj_site_W.unit.app T)).left
      let a₂ := (e_fun_W.inv.app (E_W.obj T)).left
      let a₃ := (adj_site_VW.counit.app (B_p.obj (E_W.obj T))).left
      let f_p := Limits.pullback.fst (E_W.obj T).hom p
      let g_pW := Limits.pullback.fst (B_W.obj (E_W.obj T)).hom p_W
      let g_W := Limits.pullback.fst (E_W.obj T).hom W₀.ι
      exact (Category.assoc a₁ (a₂ ≫ a₃) f_p).trans
        ((congrArg (a₁ ≫ ·)
          (((Category.assoc a₂ a₃ f_p).symm).trans
            ((congrArg (fun x => (a₂ ≫ x) ≫ f_p) hc_left).trans
              (h_efun_inv p p_W W₀.ι V_W.ι hpb_W.w (E_W.obj T))))).trans
          (((Category.assoc a₁ g_pW g_W).symm).trans
            ((congrArg (· ≫ g_W) (h_map_fst p_W (adj_site_W.unit.app T))).trans
              ((Category.assoc (Limits.pullback.fst T.hom p_W) (adj_site_W.unit.app T).left g_W).trans
                ((congrArg (Limits.pullback.fst T.hom p_W ≫ ·) hu_fst).trans
                  ((Category.comp_id _).trans hpb_TW.isoPullback_hom_fst.symm))))))
    · exact hwφ.trans hpb_TW.isoPullback_hom_snd.symm

  have hHorizPaste : ∀ {X₀ S₀ S₁ X₁ S₂ X₂ : AlgebraicGeometry.Scheme.{u}}
      (p₀ : X₀ ⟶ S₀) (p₁ : X₁ ⟶ S₁) (p₂ : X₂ ⟶ S₂)
      (q₂ : S₁ ⟶ S₀) (q₁ : S₂ ⟶ S₁) (q_tot : S₂ ⟶ S₀)
      (q'₂ : X₁ ⟶ X₀) (q'₁ : X₂ ⟶ X₁) (q'_tot : X₂ ⟶ X₀)
      (hq : q₁ ≫ q₂ = q_tot) (hq' : q'₁ ≫ q'₂ = q'_tot)
      (hpb₁ : IsPullback q'₁ p₂ p₁ q₁)
      (hpb₂ : IsPullback q'₂ p₁ p₀ q₂)
      (hpb_tot : IsPullback q'_tot p₂ p₀ q_tot),
      let B_p₀ : Functor S₀.Etale X₀.Etale :=
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ p₀
      let B_p₁ : Functor S₁.Etale X₁.Etale :=
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ p₁
      let B_p₂ : Functor S₂.Etale X₂.Etale :=
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ p₂
      let B_q₂ : Functor S₀.Etale S₁.Etale :=
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ q₂
      let B_q₁ : Functor S₁.Etale S₂.Etale :=
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ q₁
      let B_qtot : Functor S₀.Etale S₂.Etale :=
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ q_tot
      let B_q'₂ : Functor X₀.Etale X₁.Etale :=
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ q'₂
      let B_q'₁ : Functor X₁.Etale X₂.Etale :=
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ q'₁
      let B_q'tot : Functor X₀.Etale X₂.Etale :=
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ q'_tot
      ∀ [B_p₀.IsContinuous S₀.smallEtaleTopology X₀.smallEtaleTopology]
        [B_p₁.IsContinuous S₁.smallEtaleTopology X₁.smallEtaleTopology]
        [B_p₂.IsContinuous S₂.smallEtaleTopology X₂.smallEtaleTopology]
        [B_q₂.IsContinuous S₀.smallEtaleTopology S₁.smallEtaleTopology]
        [B_q₁.IsContinuous S₁.smallEtaleTopology S₂.smallEtaleTopology]
        [B_qtot.IsContinuous S₀.smallEtaleTopology S₂.smallEtaleTopology]
        [B_q'₂.IsContinuous X₀.smallEtaleTopology X₁.smallEtaleTopology]
        [B_q'₁.IsContinuous X₁.smallEtaleTopology X₂.smallEtaleTopology]
        [B_q'tot.IsContinuous X₀.smallEtaleTopology X₂.smallEtaleTopology],
        let pf_p₀ := B_p₀.sheafPushforwardContinuous AddCommGrpCat.{u}
          S₀.smallEtaleTopology X₀.smallEtaleTopology
        let pf_p₁ := B_p₁.sheafPushforwardContinuous AddCommGrpCat.{u}
          S₁.smallEtaleTopology X₁.smallEtaleTopology
        let pf_p₂ := B_p₂.sheafPushforwardContinuous AddCommGrpCat.{u}
          S₂.smallEtaleTopology X₂.smallEtaleTopology
        let pf_q₂ := B_q₂.sheafPushforwardContinuous AddCommGrpCat.{u}
          S₀.smallEtaleTopology S₁.smallEtaleTopology
        let pf_q₁ := B_q₁.sheafPushforwardContinuous AddCommGrpCat.{u}
          S₁.smallEtaleTopology S₂.smallEtaleTopology
        let pf_qtot := B_qtot.sheafPushforwardContinuous AddCommGrpCat.{u}
          S₀.smallEtaleTopology S₂.smallEtaleTopology
        let pf_q'₂ := B_q'₂.sheafPushforwardContinuous AddCommGrpCat.{u}
          X₀.smallEtaleTopology X₁.smallEtaleTopology
        let pf_q'₁ := B_q'₁.sheafPushforwardContinuous AddCommGrpCat.{u}
          X₁.smallEtaleTopology X₂.smallEtaleTopology
        let pf_q'tot := B_q'tot.sheafPushforwardContinuous AddCommGrpCat.{u}
          X₀.smallEtaleTopology X₂.smallEtaleTopology
        ∀ [pf_q₂.IsRightAdjoint] [pf_q₁.IsRightAdjoint] [pf_qtot.IsRightAdjoint]
          [pf_q'₂.IsRightAdjoint] [pf_q'₁.IsRightAdjoint] [pf_q'tot.IsRightAdjoint]
          (F₀ : Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
          let pb_q₁ := B_q₁.sheafPullback AddCommGrpCat.{u}
            S₁.smallEtaleTopology S₂.smallEtaleTopology
          let pb_q'₂ := B_q'₂.sheafPullback AddCommGrpCat.{u}
            X₀.smallEtaleTopology X₁.smallEtaleTopology
          let pb_q'₁ := B_q'₁.sheafPullback AddCommGrpCat.{u}
            X₁.smallEtaleTopology X₂.smallEtaleTopology
          let pb_q'tot := B_q'tot.sheafPullback AddCommGrpCat.{u}
            X₀.smallEtaleTopology X₂.smallEtaleTopology
          let adj_q₂ := B_q₂.sheafAdjunctionContinuous AddCommGrpCat.{u}
            S₀.smallEtaleTopology S₁.smallEtaleTopology
          let adj_q₁ := B_q₁.sheafAdjunctionContinuous AddCommGrpCat.{u}
            S₁.smallEtaleTopology S₂.smallEtaleTopology
          let adj_qtot := B_qtot.sheafAdjunctionContinuous AddCommGrpCat.{u}
            S₀.smallEtaleTopology S₂.smallEtaleTopology
          let adj_q'₂ := B_q'₂.sheafAdjunctionContinuous AddCommGrpCat.{u}
            X₀.smallEtaleTopology X₁.smallEtaleTopology
          let adj_q'₁ := B_q'₁.sheafAdjunctionContinuous AddCommGrpCat.{u}
            X₁.smallEtaleTopology X₂.smallEtaleTopology
          let adj_q'tot := B_q'tot.sheafAdjunctionContinuous AddCommGrpCat.{u}
            X₀.smallEtaleTopology X₂.smallEtaleTopology
          letI := Functor.isContinuous_comp B_p₀ B_q'₂ S₀.smallEtaleTopology
            X₀.smallEtaleTopology X₁.smallEtaleTopology
          letI := Functor.isContinuous_comp B_q₂ B_p₁ S₀.smallEtaleTopology
            S₁.smallEtaleTopology X₁.smallEtaleTopology
          letI := Functor.isContinuous_comp B_p₁ B_q'₁ S₁.smallEtaleTopology
            X₁.smallEtaleTopology X₂.smallEtaleTopology
          letI := Functor.isContinuous_comp B_q₁ B_p₂ S₁.smallEtaleTopology
            S₂.smallEtaleTopology X₂.smallEtaleTopology
          letI := Functor.isContinuous_comp B_p₀ B_q'tot S₀.smallEtaleTopology
            X₀.smallEtaleTopology X₂.smallEtaleTopology
          letI := Functor.isContinuous_comp B_qtot B_p₂ S₀.smallEtaleTopology
            S₂.smallEtaleTopology X₂.smallEtaleTopology
          let e_fun₂ : B_p₀.comp B_q'₂ ≅ B_q₂.comp B_p₁ :=
            (MorphismProperty.Over.pullbackComp q'₂ p₀).symm ≪≫
              MorphismProperty.Over.pullbackCongr hpb₂.w ≪≫
              MorphismProperty.Over.pullbackComp p₁ q₂
          let e_fun₁ : B_p₁.comp B_q'₁ ≅ B_q₁.comp B_p₂ :=
            (MorphismProperty.Over.pullbackComp q'₁ p₁).symm ≪≫
              MorphismProperty.Over.pullbackCongr hpb₁.w ≪≫
              MorphismProperty.Over.pullbackComp p₂ q₁
          let e_fun_tot : B_p₀.comp B_q'tot ≅ B_qtot.comp B_p₂ :=
            (MorphismProperty.Over.pullbackComp q'_tot p₀).symm ≪≫
              MorphismProperty.Over.pullbackCongr hpb_tot.w ≪≫
              MorphismProperty.Over.pullbackComp p₂ q_tot
          let e_pf₂ := Functor.sheafPushforwardContinuousIso e_fun₂ AddCommGrpCat.{u}
            S₀.smallEtaleTopology X₁.smallEtaleTopology
          let e_pf₁ := Functor.sheafPushforwardContinuousIso e_fun₁ AddCommGrpCat.{u}
            S₁.smallEtaleTopology X₂.smallEtaleTopology
          let e_pf_tot := Functor.sheafPushforwardContinuousIso e_fun_tot AddCommGrpCat.{u}
            S₀.smallEtaleTopology X₂.smallEtaleTopology
          let bc₂ := (adj_q₂.homEquiv (pf_p₀.obj F₀) (pf_p₁.obj (pb_q'₂.obj F₀))).symm
            (pf_p₀.map (adj_q'₂.unit.app F₀) ≫ e_pf₂.hom.app (pb_q'₂.obj F₀))
          let bc₁ := (adj_q₁.homEquiv (pf_p₁.obj (pb_q'₂.obj F₀)) (pf_p₂.obj (pb_q'₁.obj (pb_q'₂.obj F₀)))).symm
            (pf_p₁.map (adj_q'₁.unit.app (pb_q'₂.obj F₀)) ≫ e_pf₁.hom.app (pb_q'₁.obj (pb_q'₂.obj F₀)))
          let bc_tot := (adj_qtot.homEquiv (pf_p₀.obj F₀) (pf_p₂.obj (pb_q'tot.obj F₀))).symm
            (pf_p₀.map (adj_q'tot.unit.app F₀) ≫ e_pf_tot.hom.app (pb_q'tot.obj F₀))
          (IsIso bc₂ → IsIso bc₁ → IsIso bc_tot) ∧
          (IsIso bc_tot → IsIso bc₁ → IsIso (pb_q₁.map bc₂)) := by
    intro X₀ S₀ S₁ X₁ S₂ X₂ p₀ p₁ p₂ q₂ q₁ q_tot q'₂ q'₁ q'_tot hq hq'
      hpb₁ hpb₂ hpb_tot B_p₀ B_p₁ B_p₂ B_q₂ B_q₁ B_qtot B_q'₂ B_q'₁ B_q'tot _ _ _ _ _ _ _ _ _
      pf_p₀ pf_p₁ pf_p₂ pf_q₂ pf_q₁ pf_qtot pf_q'₂ pf_q'₁ pf_q'tot _ _ _ _ _ _ F₀
      pb_q₁ pb_q'₂ pb_q'₁ pb_q'tot adj_q₂ adj_q₁ adj_qtot adj_q'₂ adj_q'₁ adj_q'tot
      e_fun₂ e_fun₁ e_fun_tot e_pf₂ e_pf₁ e_pf_tot bc₂ bc₁ bc_tot
    have := Functor.isContinuous_comp B_q₂ B_q₁ S₀.smallEtaleTopology
      S₁.smallEtaleTopology S₂.smallEtaleTopology
    have := Functor.isContinuous_comp B_q'₂ B_q'₁ X₀.smallEtaleTopology
      X₁.smallEtaleTopology X₂.smallEtaleTopology
    have := Functor.isContinuous_comp B_p₀ B_q'₂ S₀.smallEtaleTopology
      X₀.smallEtaleTopology X₁.smallEtaleTopology
    have := Functor.isContinuous_comp B_q₂ B_p₁ S₀.smallEtaleTopology
      S₁.smallEtaleTopology X₁.smallEtaleTopology
    have := Functor.isContinuous_comp B_p₁ B_q'₁ S₁.smallEtaleTopology
      X₁.smallEtaleTopology X₂.smallEtaleTopology
    have := Functor.isContinuous_comp B_q₁ B_p₂ S₁.smallEtaleTopology
      S₂.smallEtaleTopology X₂.smallEtaleTopology
    have := Functor.isContinuous_comp B_p₀ B_q'tot S₀.smallEtaleTopology
      X₀.smallEtaleTopology X₂.smallEtaleTopology
    have := Functor.isContinuous_comp B_qtot B_p₂ S₀.smallEtaleTopology
      S₂.smallEtaleTopology X₂.smallEtaleTopology
    let e_q_fun : B_qtot ≅ B_q₂.comp B_q₁ :=
      MorphismProperty.Over.pullbackCongr hq.symm ≪≫ MorphismProperty.Over.pullbackComp q₁ q₂
    let α_q : pf_qtot ≅ pf_q₁ ⋙ pf_q₂ :=
      Functor.sheafPushforwardContinuousIso e_q_fun AddCommGrpCat.{u}
        S₀.smallEtaleTopology S₂.smallEtaleTopology ≪≫
      (Functor.sheafPushforwardContinuousComp B_q₂ B_q₁ AddCommGrpCat.{u}
        S₀.smallEtaleTopology S₁.smallEtaleTopology S₂.smallEtaleTopology).symm
    let e_q'_fun : B_q'tot ≅ B_q'₂.comp B_q'₁ :=
      MorphismProperty.Over.pullbackCongr hq'.symm ≪≫ MorphismProperty.Over.pullbackComp q'₁ q'₂
    let α_q' : pf_q'tot ≅ pf_q'₁ ⋙ pf_q'₂ :=
      Functor.sheafPushforwardContinuousIso e_q'_fun AddCommGrpCat.{u}
        X₀.smallEtaleTopology X₂.smallEtaleTopology ≪≫
      (Functor.sheafPushforwardContinuousComp B_q'₂ B_q'₁ AddCommGrpCat.{u}
        X₀.smallEtaleTopology X₁.smallEtaleTopology X₂.smallEtaleTopology).symm
    let lam_q := adj_qtot.leftAdjointUniq ((adj_q₂.comp adj_q₁).ofNatIsoRight α_q.symm)
    let lam_q' := adj_q'tot.leftAdjointUniq ((adj_q'₂.comp adj_q'₁).ofNatIsoRight α_q'.symm)
    let e_L := lam_q.app (pf_p₀.obj F₀)
    let e_R := pf_p₂.mapIso (lam_q'.symm.app F₀)
    suffices h_eq : bc_tot = e_L.hom ≫ pb_q₁.map bc₂ ≫ bc₁ ≫ e_R.hom by
      refine ⟨fun _ _ => ?_, fun h_tot _ => ?_⟩
      · rw [h_eq]
