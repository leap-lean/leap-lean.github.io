      Presheaf.isSheaf_comp_of_isSheaf J F_ℓ.obj (forget AddCommGrpCat.{u}) F_ℓ.property
    have hEmpty_sub : ∀ (Z : S.Etale), IsEmpty ↥Z.left → Subsingleton ↥(F_ℓ.obj.obj (Opposite.op Z)) := by
      intro Z hZ_emp
      have hbot : (⊥ : Sieve Z) ∈ J Z :=
        (hMemJ Z ⊥).mpr fun z => IsEmpty.elim hZ_emp z
      constructor
      intro u₁ u₂
      exact (hF_type.isSheafFor _ hbot).isSeparatedFor.ext fun Y g hg => False.elim hg
    let levelV : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left ↥A), ↥A → U.left.Opens :=
      fun U s a => ⟨s ⁻¹' {a}, s.isLocallyConstant {a}⟩
    let levelW : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left ↥A), ↥A → S.Etale :=
      fun U s a => MorphismProperty.Over.mk ⊤ ((levelV U s a).ι ≫ U.hom)
        (MorphismProperty.comp_mem P_et _ _ inferInstance U.prop)
    let levelJ : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left ↥A) (a : ↥A), levelW U s a ⟶ U :=
      fun U s a => MorphismProperty.Over.homMk (levelV U s a).ι rfl
    have hLevel_mem : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left ↥A),
        Sieve.ofArrows (levelW U s) (levelJ U s) ∈ J U := by
      intro U s
      rw [hMemJ]
      intro x
      refine ⟨levelW U s (s x), levelJ U s (s x), ⟨x, rfl⟩,
        Sieve.ofArrows_mk (levelW U s) (levelJ U s) (s x), ?_, rfl⟩
      change AlgebraicGeometry.Etale (levelV U s (s x)).ι
      infer_instance
    have hArrow_unpack : ∀ {U Y : S.Etale} {s : LocallyConstant ↥U.left ↥A} {f : Y ⟶ U},
