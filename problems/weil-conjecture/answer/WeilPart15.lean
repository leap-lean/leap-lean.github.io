              eqToHom (dif_pos (hΦ_mono f.unop h₂) :
                (if h : Φ opT₁.unop then P.obj (Opposite.op (liftObj opT₁.unop h)) else (0 : A)) =
                  P.obj (Opposite.op (liftObj opT₁.unop (hΦ_mono f.unop h₂)))).symm
          else 0
        map_id := fun opT => by
          by_cases h : Φ opT.unop
          · simp only [dif_pos h]
            have hid : (liftMap (𝟙 opT).unop h).op = 𝟙 (Opposite.op (liftObj opT.unop h)) :=
