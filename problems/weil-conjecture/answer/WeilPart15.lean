          smul_add := fun c a₁ a₂ => nsmul_add a₁ a₂ c.down.val
          add_smul := fun c₁ c₂ a => by
            change (c₁.down + c₂.down).val • a = c₁.down.val • a + c₂.down.val • a
            have hdiv := Nat.div_add_mod (c₁.down.val + c₂.down.val) ℓ
            rw [ZMod.val_add, ← add_nsmul]
            conv_rhs => rw [← hdiv]
            rw [add_nsmul, mul_comm ℓ _, mul_nsmul, hA, zero_add]
          zero_smul := fun a => by
            change (0 : ZMod ℓ).val • a = 0
            rw [ZMod.val_zero, zero_nsmul] }
    letI modQuot : ∀ (A : AddCommGrpCat.{u}),
        Module R_ℓ (↥A ⧸ (nsmulAddMonoidHom ℓ : ↥A →+ ↥A).range) :=
      fun A => mkEllMod _ (fun q => by
        obtain ⟨a, rfl⟩ :=
          QuotientAddGroup.mk'_surjective (nsmulAddMonoidHom ℓ : ↥A →+ ↥A).range q
        rw [← map_nsmul]
        exact (QuotientAddGroup.eq_zero_iff _).mpr ⟨a, rfl⟩)
