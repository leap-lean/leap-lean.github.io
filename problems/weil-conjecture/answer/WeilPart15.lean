      let k_iso : CategoryTheory.Limits.kernel (L₁.map d) ≅
          CategoryTheory.Limits.kernel (L₂.map d) :=
        CategoryTheory.Limits.kernel.mapIso (L₁.map d) (L₂.map d)
          (CategoryTheory.asIso (bc₀ A)) (CategoryTheory.asIso (bc₀ B))
