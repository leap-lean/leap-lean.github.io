              change σ (τ u.val) = u.val
              rw [hτ, hσ]
            one_mem' := rfl
            inv_mem' := fun {σ} hσ => by
              change σ⁻¹ u.val = u.val
              have h1 : σ⁻¹ (σ u.val) = σ⁻¹ u.val := congrArg (fun y => σ⁻¹ y) hσ
              have h2 : (σ⁻¹ * σ) u.val = σ⁻¹ u.val := h1
