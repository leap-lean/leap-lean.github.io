  let D := ↑(U.left.presheaf.obj (Opposite.op V₀))
  let res_mor := U.left.presheaf.map (CategoryTheory.homOfLE (U.left.basicOpen_le g_sep)).op
  let _ : Algebra B₁ D := res_mor.hom.toAlgebra
  have : IsLocalization.Away g_sep D := hV₁.isLocalization_basicOpen g_sep
  have happ_eq : (U.hom.appLE W₀ V₀ e).hom = (algebraMap B₁ D).comp φ₁ := by
    have hcomp :=
