    have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero
    letI : NeZero ℓ := ⟨hℓ_ne⟩
    let ν : ZMod ℓ → k := fun j => (ζ : k) ^ j.val
    have hν_zero : ν 0 = 1 := by simp [ν]
    have hν_add : ∀ i j : ZMod ℓ, ν (i + j) = ν i * ν j := by
      intro i j
      have hdiv := Nat.div_add_mod (i.val + j.val) ℓ
      dsimp [ν]
      rw [ZMod.val_add]
      calc
        (ζ : k) ^ ((i.val + j.val) % ℓ)
          = ((ζ : k) ^ ℓ) ^ ((i.val + j.val) / ℓ) * (ζ : k) ^ ((i.val + j.val) % ℓ) := by
              rw [hζ.pow_eq_one, one_pow, one_mul]
        _ = (ζ : k) ^ (ℓ * ((i.val + j.val) / ℓ) + (i.val + j.val) % ℓ) := by
              rw [pow_add, pow_mul]
        _ = (ζ : k) ^ (i.val + j.val) := by rw [hdiv]
        _ = (ζ : k) ^ i.val * (ζ : k) ^ j.val := pow_add _ _ _
