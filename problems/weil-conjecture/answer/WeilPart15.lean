        have hXs_out : weilCurveDivSum C.left X_s x = 0 := hDivSum_out X_s U₀ x hx_s hx_out
        have hYs_out : weilCurveDivSum C.left Y_s x = 0 := hDivSum_out Y_s U₀ x hy_s hx_out
        have := hu_ineq x
        omega
      rcases hF_span with ⟨c, rfl⟩
      let F_c : B₀ := Finset.univ.sum fun ν : Fin N_V => φ_k (c ν) * v_bas ν
      have hc_ne : c ≠ 0 := by
        intro hc0
        apply hF_ne
