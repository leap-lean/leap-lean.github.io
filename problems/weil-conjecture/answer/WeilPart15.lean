            (CategoryTheory.Limits.pullback.snd (𝒰.f p₁.1 ≫ f) (𝒱.f p₁.2 ≫ g)).base a₁
          let x₂ : ↥(𝒰.X p₂.1) :=
            (CategoryTheory.Limits.pullback.fst (𝒰.f p₂.1 ≫ f) (𝒱.f p₂.2 ≫ g)).base a₂
          let y₂ : ↥(𝒱.X p₂.2) :=
            (CategoryTheory.Limits.pullback.snd (𝒰.f p₂.1 ≫ f) (𝒱.f p₂.2 ≫ g)).base a₂
          obtain ⟨x_star, hx_star₁, hx_star₂⟩ :=
            nonempty_preirreducible_inter (𝒰.f p₁.1).opensRange.isOpen (𝒰.f p₂.1).opensRange.isOpen
              ⟨(𝒰.f p₁.1).base x₁, AlgebraicGeometry.Scheme.Hom.mem_opensRange.mpr ⟨x₁, rfl⟩⟩
              ⟨(𝒰.f p₂.1).base x₂, AlgebraicGeometry.Scheme.Hom.mem_opensRange.mpr ⟨x₂, rfl⟩⟩
          obtain ⟨y_star, hy_star₁, hy_star₂⟩ :=
            nonempty_preirreducible_inter (𝒱.f p₁.2).opensRange.isOpen (𝒱.f p₂.2).opensRange.isOpen
              ⟨(𝒱.f p₁.2).base y₁, AlgebraicGeometry.Scheme.Hom.mem_opensRange.mpr ⟨y₁, rfl⟩⟩
              ⟨(𝒱.f p₂.2).base y₂, AlgebraicGeometry.Scheme.Hom.mem_opensRange.mpr ⟨y₂, rfl⟩⟩
          obtain ⟨w_star, hw_fst, hw_snd⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
              (f := f) (g := g) x_star y_star (Subsingleton.elim _ _)
          have hRange_W : ∀ p : 𝒲.I₀,
              Set.range ⇑(𝒲.f p) =
                ⇑(CategoryTheory.Limits.pullback.fst f g) ⁻¹' Set.range ⇑(𝒰.f p.1) ∩
                ⇑(CategoryTheory.Limits.pullback.snd f g) ⁻¹' Set.range ⇑(𝒱.f p.2) :=
            fun p =>
              (congrArg (fun h : 𝒲.X p ⟶ P => Set.range ⇑h)
                (AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight_f 𝒰 𝒱 f g p)).trans
                (AlgebraicGeometry.Scheme.Pullback.range_map _ _ _ _ _ _ _ _ _)
          obtain ⟨ux₁, hux₁⟩ := AlgebraicGeometry.Scheme.Hom.mem_opensRange.mp hx_star₁
          obtain ⟨vy₁, hvy₁⟩ := AlgebraicGeometry.Scheme.Hom.mem_opensRange.mp hy_star₁
          obtain ⟨ux₂, hux₂⟩ := AlgebraicGeometry.Scheme.Hom.mem_opensRange.mp hx_star₂
          obtain ⟨vy₂, hvy₂⟩ := AlgebraicGeometry.Scheme.Hom.mem_opensRange.mp hy_star₂
          have hw_in₁ : w_star ∈ Set.range ⇑(𝒲.f p₁) := by
            rw [hRange_W p₁]
            exact ⟨⟨ux₁, hux₁.trans hw_fst.symm⟩, ⟨vy₁, hvy₁.trans hw_snd.symm⟩⟩
          have hw_in₂ : w_star ∈ (𝒲.f p₂).opensRange := by
            apply AlgebraicGeometry.Scheme.Hom.mem_opensRange.mpr
            change w_star ∈ Set.range ⇑(𝒲.f p₂)
            rw [hRange_W p₂]
            exact ⟨⟨ux₂, hux₂.trans hw_fst.symm⟩, ⟨vy₂, hvy₂.trans hw_snd.symm⟩⟩
          obtain ⟨c₁, hc₁⟩ := hw_in₁
          obtain ⟨d₁, hd₁_O₁, hd₁_W₂⟩ :=
            nonempty_preirreducible_inter
              (hO₁.preimage (𝒲.f p₁).continuous)
              ((𝒲.f p₂).opensRange.isOpen.preimage (𝒲.f p₁).continuous)
              ⟨a₁, by change (𝒲.f p₁).base a₁ ∈ O₁; rwa [ha₁]⟩
              ⟨c₁, by change ⇑(𝒲.f p₁) c₁ ∈ (𝒲.f p₂).opensRange; rwa [hc₁]⟩
          obtain ⟨d₂, hd₂⟩ := AlgebraicGeometry.Scheme.Hom.mem_opensRange.mp hd₁_W₂
          obtain ⟨e₂, he₂_O₁, he₂_O₂⟩ :=
            nonempty_preirreducible_inter
              (hO₁.preimage (𝒲.f p₂).continuous)
              (hO₂.preimage (𝒲.f p₂).continuous)
              ⟨d₂, by change (𝒲.f p₂).base d₂ ∈ O₁; rw [hd₂]; exact hd₁_O₁⟩
              ⟨a₂, by change (𝒲.f p₂).base a₂ ∈ O₂; rwa [ha₂]⟩
          exact ⟨(𝒲.f p₂).base e₂, Set.mem_univ _, he₂_O₁, he₂_O₂⟩ }
    have : IrreducibleSpace ↥P := ⟨⟨w₀⟩⟩
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced P
  
  have hPropC : AlgebraicGeometry.IsProper C.hom := by
    rcases hProjC with ⟨N, ι, hClosed_ι⟩
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let α₀ : k →+* ↥(𝒜 0) := algebraMap k ↥(𝒜 0)
    have hα₀_bij : Function.Bijective α₀ := by
      constructor
      · intro c₁ c₂ hc
        have hc_val : (α₀ c₁).1 = (α₀ c₂).1 := congrArg Subtype.val hc
        exact MvPolynomial.C_injective (Fin (N + 1)) k hc_val
      · rintro ⟨p, hp⟩
        have hp' : p ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := hp
        rw [MvPolynomial.homogeneousSubmodule_zero] at hp'
        obtain ⟨c, rfl⟩ := Submodule.mem_one.mp hp'
        exact ⟨c, Subtype.ext rfl⟩
    let e₀ : k ≃+* ↥(𝒜 0) := RingEquiv.ofBijective α₀ hα₀_bij
    have : CategoryTheory.IsIso (CommRingCat.ofHom α₀) :=
      ⟨⟨CommRingCat.ofHom e₀.symm.toRingHom,
        CommRingCat.hom_ext (RingHom.ext e₀.symm_apply_apply),
        CommRingCat.hom_ext (RingHom.ext e₀.apply_symm_apply)⟩⟩
    have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀)) :=
      inferInstance
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      IsScalarTower.of_algebraMap_eq (R := k) (S := ↥(𝒜 0)) (A := MvPolynomial (Fin (N + 1)) k)
        fun _ => rfl
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      inferInstance
    have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed_ι
    rw [← CategoryTheory.Over.w ι]
    infer_instance
