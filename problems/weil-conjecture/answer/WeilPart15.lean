    intro r hr
    obtain ⟨g_r, _, hfst_z, hsnd_z, hRange_r⟩ := hSliceHom r hr
    exact ⟨g_r.base, g_r.continuous, hfst_z, hsnd_z, hRange_r⟩
  
  let Δ_C : C.left ⟶ CategoryTheory.Limits.pullback C.hom C.hom :=
    CategoryTheory.Limits.pullback.diagonal C.hom
  have : AlgebraicGeometry.IsClosedImmersion Δ_C :=
    AlgebraicGeometry.IsSeparated.isClosedImmersion_diagonal (f := C.hom)
  have hClosed_Δ : IsClosed (Set.range Δ_C.base) := by
    simpa only [Set.image_univ] using Δ_C.isClosedMap Set.univ isClosed_univ
  let Φ_pair : Fin d → Fin d → (P_d.left ⟶ CategoryTheory.Limits.pullback C.hom C.hom) :=
    fun i j => CategoryTheory.Limits.pullback.lift
      (weilCurvePowProj k C d i) (weilCurvePowProj k C d j)
      ((hProjComm i).trans (hProjComm j).symm)
  let U_dist : Set ↥P_d.left :=
    ⋂ i : Fin d, ⋂ j : Fin d,
      if i ≠ j then ((Φ_pair i j).base ⁻¹' Set.range Δ_C.base)ᶜ else Set.univ
  have hOpenDist : IsOpen U_dist := by
    apply isOpen_iInter_of_finite
    intro i
    apply isOpen_iInter_of_finite
    intro j
    split_ifs
    · exact (hClosed_Δ.preimage (Φ_pair i j).continuous).isOpen_compl
    · exact isOpen_univ
  have hMemDist : ∀ (z : ↥P_d.left) (Q : Fin d → Pt),
      weilCurvePowMatchesTuple k C z Q →
      (z ∈ U_dist ↔ ∀ i j : Fin d, i ≠ j → Q i ≠ Q j) := by
    intro z Q hzQ
    constructor
    · intro hz_in i j hij hQeq
      obtain ⟨σ_z, ⟨hσ_comp, hσ_pt⟩, _⟩ := hUniqueSec P_d.left P_d.hom z hzQ.1
      have hsec_i : (σ_z ≫ weilCurvePowProj k C d i) ≫ C.hom = 𝟙 S_k := by
        rw [CategoryTheory.Category.assoc, hProjComm i, hσ_comp]
      have hsec_j : (σ_z ≫ weilCurvePowProj k C d j) ≫ C.hom = 𝟙 S_k := by
        rw [CategoryTheory.Category.assoc, hProjComm j, hσ_comp]
      have hpt_i : (σ_z ≫ weilCurvePowProj k C d i).base p₀ = (Q i).1 := by
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hσ_pt, hzQ.2 i]
      have hpt_j : (σ_z ≫ weilCurvePowProj k C d j).base p₀ = (Q i).1 := by
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hσ_pt, hzQ.2 j, hQeq]
      have hπ_eq : σ_z ≫ weilCurvePowProj k C d i = σ_z ≫ weilCurvePowProj k C d j :=
        hSecInj C.left C.hom _ _ hsec_i hsec_j (hpt_i.trans hpt_j.symm)
      have hΦ_Δ : σ_z ≫ Φ_pair i j = (σ_z ≫ weilCurvePowProj k C d i) ≫ Δ_C := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
            CategoryTheory.Category.comp_id]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
            CategoryTheory.Category.comp_id, hπ_eq]
      have hmem_ij := Set.mem_iInter.mp (Set.mem_iInter.mp hz_in i) j
      have hnot_mem : z ∉ (Φ_pair i j).base ⁻¹' Set.range Δ_C.base := by
        split_ifs at hmem_ij
        exact hmem_ij
      apply hnot_mem
      refine ⟨(σ_z ≫ weilCurvePowProj k C d i).base p₀, ?_⟩
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, ← hΦ_Δ,
        AlgebraicGeometry.Scheme.Hom.comp_apply, hσ_pt]
    · intro hQne
      rw [Set.mem_iInter]
      intro i
      rw [Set.mem_iInter]
      intro j
      split_ifs with hij
      · rintro ⟨c, hc⟩
        have hc_fst : (CategoryTheory.Limits.pullback.fst C.hom C.hom).base (Δ_C.base c) =
            (CategoryTheory.Limits.pullback.fst C.hom C.hom).base ((Φ_pair i j).base z) :=
          congrArg (CategoryTheory.Limits.pullback.fst C.hom C.hom).base hc
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
          CategoryTheory.Limits.pullback.diagonal_fst,
          ← AlgebraicGeometry.Scheme.Hom.comp_apply,
          CategoryTheory.Limits.pullback.lift_fst, hzQ.2 i] at hc_fst
        have hc_i : c = (Q i).1 := hc_fst
        have hc_snd : (CategoryTheory.Limits.pullback.snd C.hom C.hom).base (Δ_C.base c) =
            (CategoryTheory.Limits.pullback.snd C.hom C.hom).base ((Φ_pair i j).base z) :=
          congrArg (CategoryTheory.Limits.pullback.snd C.hom C.hom).base hc
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
          CategoryTheory.Limits.pullback.diagonal_snd,
          ← AlgebraicGeometry.Scheme.Hom.comp_apply,
          CategoryTheory.Limits.pullback.lift_snd, hzQ.2 j] at hc_snd
        have hc_j : c = (Q j).1 := hc_snd
        exact hQne i j hij (Subtype.ext (hc_i.symm.trans hc_j))
      · exact Set.mem_univ z
  let Q_inj : Fin d → Pt := fun i => Infinite.natEmbedding Pt i.val
  obtain ⟨z_inj, hz_inj, _⟩ := hTupleToPt Q_inj
  have hNeDist : U_dist.Nonempty := by
    refine ⟨z_inj, (hMemDist z_inj Q_inj hz_inj).mpr ?_⟩
    intro i j hij
    exact (Infinite.natEmbedding Pt).injective.ne (Fin.val_ne_of_ne hij)
  exact ⟨hIntP, hPropP, hCompP, hNoethP, hDimP, hDenseP, hDensePP,
    hPtToTuple, hTupleToPt, hClosedPP, hPairPP, hSlice,
    ⟨U_dist, hOpenDist, hNeDist, hMemDist⟩⟩

theorem weil_curve_pow_affine_cube_and_dualNumber_rigidity (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (d : ℕ) (U₀ : C.left.Opens) (hU₀ : AlgebraicGeometry.IsAffineOpen U₀)
    (_hU₀_ne : Nonempty ↥(U₀ : AlgebraicGeometry.Scheme.{u})) :
    let P_d := weilCurvePowOver k C d
    let PP := CategoryTheory.Limits.pullback P_d.hom P_d.hom
    let Pt := { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }
    let B₀ := ↑(C.left.presheaf.obj (Opposite.op U₀))
    let φ_k : k →+* B₀ :=
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
        (CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp U₀.ι C.hom).appTop
          (U₀.topIso).hom)).hom
    (∃ (V₁ : P_d.left.Opens) (hV₁ : AlgebraicGeometry.IsAffineOpen V₁)
       (ψ₁ : k →+* ↑(P_d.left.presheaf.obj (Opposite.op V₁)))
       (q_coord : Fin d → (B₀ →+* ↑(P_d.left.presheaf.obj (Opposite.op V₁)))),
      (V₁ : Set ↥P_d.left) =
        { z : ↥P_d.left | ∀ j : Fin d, (weilCurvePowProj k C d j).base z ∈ U₀ } ∧
      IsDomain ↑(P_d.left.presheaf.obj (Opposite.op V₁)) ∧
      ψ₁.FiniteType ∧
      (∀ j : Fin d, (q_coord j).comp φ_k = ψ₁) ∧
      (∀ (z : ↥V₁) (Q : Fin d → Pt),
        weilCurvePowMatchesTuple k C z.1 Q →
        ∃ ev_z : ↑(P_d.left.presheaf.obj (Opposite.op V₁)) →+* k,
          ev_z.comp ψ₁ = RingHom.id k ∧
          RingHom.ker ev_z = (hV₁.primeIdealOf z).asIdeal ∧
          ∀ j : Fin d,
            ∃ hQj : (Q j).1 ∈ U₀,
              RingHom.ker (ev_z.comp (q_coord j)) = (hU₀.primeIdealOf ⟨(Q j).1, hQj⟩).asIdeal) ∧
      (∀ (z_star : ↥V₁) (Q_star : Fin d → Pt)
         (ev_star : ↑(P_d.left.presheaf.obj (Opposite.op V₁)) →+* k)
         (g_et z_et : Fin d → B₀)
         (Φ₁ Φ₂ : ↑(P_d.left.presheaf.obj (Opposite.op V₁)) →+* DualNumber k),
        weilCurvePowMatchesTuple k C z_star.1 Q_star →
        ev_star.comp ψ₁ = RingHom.id k →
        RingHom.ker ev_star = (hV₁.primeIdealOf z_star).asIdeal →
        (∀ j : Fin d, (Q_star j).1 ∈ C.left.basicOpen (g_et j) ∧
          (Polynomial.eval₂RingHom
            ((algebraMap B₀ (Localization.Away (g_et j))).comp φ_k)
            (algebraMap B₀ (Localization.Away (g_et j)) (z_et j))).Etale) →
        Φ₁.comp ψ₁ = TrivSqZeroExt.inlHom k k →
        Φ₂.comp ψ₁ = TrivSqZeroExt.inlHom k k →
        (∀ a, (Φ₁ a).fst = ev_star a ∧ (Φ₂ a).fst = ev_star a) →
        (∀ j : Fin d, Φ₁ (q_coord j (z_et j)) = Φ₂ (q_coord j (z_et j))) →
        Φ₁ = Φ₂)) ∧
    (∃ (V₂ : PP.Opens) (hV₂ : AlgebraicGeometry.IsAffineOpen V₂)
       (ψ₂ : k →+* ↑(PP.presheaf.obj (Opposite.op V₂)))
       (q_fst q_snd : Fin d → (B₀ →+* ↑(PP.presheaf.obj (Opposite.op V₂)))),
      (V₂ : Set ↥PP) =
        { w : ↥PP |
          (∀ j : Fin d,
            (weilCurvePowProj k C d j).base
              ((CategoryTheory.Limits.pullback.fst P_d.hom P_d.hom).base w) ∈ U₀) ∧
          (∀ j : Fin d,
            (weilCurvePowProj k C d j).base
              ((CategoryTheory.Limits.pullback.snd P_d.hom P_d.hom).base w) ∈ U₀) } ∧
      IsDomain ↑(PP.presheaf.obj (Opposite.op V₂)) ∧
      ψ₂.FiniteType ∧
      (∀ j : Fin d, (q_fst j).comp φ_k = ψ₂ ∧ (q_snd j).comp φ_k = ψ₂) ∧
      (∀ (w : ↥V₂) (Q R : Fin d → Pt),
        weilCurvePowMatchesTuple k C
          ((CategoryTheory.Limits.pullback.fst P_d.hom P_d.hom).base w.1) Q →
        weilCurvePowMatchesTuple k C
          ((CategoryTheory.Limits.pullback.snd P_d.hom P_d.hom).base w.1) R →
        ∃ ev_w : ↑(PP.presheaf.obj (Opposite.op V₂)) →+* k,
          ev_w.comp ψ₂ = RingHom.id k ∧
          RingHom.ker ev_w = (hV₂.primeIdealOf w).asIdeal ∧
          (∀ j : Fin d,
            ∃ hQj : (Q j).1 ∈ U₀,
              RingHom.ker (ev_w.comp (q_fst j)) = (hU₀.primeIdealOf ⟨(Q j).1, hQj⟩).asIdeal) ∧
