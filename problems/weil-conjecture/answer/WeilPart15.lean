    let C_0 : CategoryTheory.Functor AddCommGrpCat.{u} (ModuleCat.{u, u} R_ℓ) :=
      { obj := fun A => ModuleCat.of R_ℓ ↥(nsmulAddMonoidHom ℓ : ↥A →+ ↥A).ker
        map := fun {A B} f =>
