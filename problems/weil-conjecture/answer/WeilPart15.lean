    exact hGenD q hq hc
  · intro m hm hm_ne
    let pt_m : ↥(AlgebraicGeometry.Spec (U.left.presheaf.obj (Opposite.op V₀))) := ⟨m, hm.isPrime⟩
    let y₀ : ↥U.left := hV₀.fromSpec.base pt_m
    have hy₀ : y₀ ∈ V₀ := by
