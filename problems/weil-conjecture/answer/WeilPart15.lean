      obtain ⟨R₃, hCR₃, hAlg₁₃, hAlg₂₃, hTow₁₂₃, hEt₂₃, hAlg₃Ω, _, hTow₁₃Ω, α_tilde, hα_B, hα_sp⟩ :=
        (h2bc m).1 R₁ W₀ α₀ hα₀
      let _ : CommRing R₃ := hCR₃
      let _ : Algebra R₁ R₃ := hAlg₁₃
      have _ : Algebra.Etale R₁ R₃ :=
