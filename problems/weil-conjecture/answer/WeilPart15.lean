    rw [AddMonoidHom.finsetSum_apply, AddMonoidHom.finsetSum_apply, map_sum]
    apply Finset.sum_congr rfl
    intro j _
    rw [AddMonoidHom.smul_apply, AddMonoidHom.smul_apply, map_zsmul]
