      fun U s Y _ hf =>
        (F_ℓ.obj.map (hT.from Y).op).hom (η.hom (hArrow_unpack hf).choose)
    have hLevelFam : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left ↥A),
        (levelFam U s).Compatible := by
      intro U s Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      dsimp [levelFam]
      let a₁ : ↥A := (hArrow_unpack hf₁).choose
      let a₂ : ↥A := (hArrow_unpack hf₂).choose
      change ((F_ℓ.obj.map (hT.from Y₁).op ≫ F_ℓ.obj.map g₁.op).hom) (η.hom a₁) =
        ((F_ℓ.obj.map (hT.from Y₂).op ≫ F_ℓ.obj.map g₂.op).hom) (η.hom a₂)
