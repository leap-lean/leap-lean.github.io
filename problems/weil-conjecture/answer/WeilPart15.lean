      unfold Localization.awayMap IsLocalization.Away.map
      exact IsLocalization.map_eq _ r₀
    have hmap_s : Localization.awayMap j r₀ (algebraMap ↥S' (Localization.Away r₀) s₀) =
        algebraMap W (Localization.Away (j r₀)) (j s₀) := by
      unfold Localization.awayMap IsLocalization.Away.map
      exact IsLocalization.map_eq _ s₀
    have h_loc_eq : algebraMap W (Localization.Away (j r₀)) (w * j r₀ ^ n₁) =
