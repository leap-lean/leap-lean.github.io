      have h_push₁_B : ((Algebra.TensorProduct.map j₁ (AlgHom.id R₁ (B₁ m))).toRingHom.comp α_tilde).comp (algebraMap B₀ W₀) =
          (Algebra.TensorProduct.includeRight : B₁ m →ₐ[R₁] TensorProduct R₁ R₄ (B₁ m)).toRingHom.comp (b₁_hom m) := by
        rw [RingHom.comp_assoc, hα_B, ← RingHom.comp_assoc]
        congr 1
        ext bm
        change (Algebra.TensorProduct.map j₁ (AlgHom.id R₁ (B₁ m))) (1 ⊗ₜ[R₁] bm) = 1 ⊗ₜ[R₁] bm
        rw [Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply]
      have h_push₂_B : ((Algebra.TensorProduct.map j₂ (AlgHom.id R₁ (B₁ m))).toRingHom.comp α'_tilde).comp (algebraMap B₀ W₀) =
          (Algebra.TensorProduct.includeRight : B₁ m →ₐ[R₁] TensorProduct R₁ R₄ (B₁ m)).toRingHom.comp (b₁_hom m) := by
        rw [RingHom.comp_assoc, hα'_B, ← RingHom.comp_assoc]
        congr 1
        ext bm
        change (Algebra.TensorProduct.map j₂ (AlgHom.id R₁ (B₁ m))) (1 ⊗ₜ[R₁] bm) = 1 ⊗ₜ[R₁] bm
        rw [Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply]
      have h_eval_congr : ∀ (β₁ β₂ : W₀ →+* TensorProduct R₁ R₄ (B₁ m))
