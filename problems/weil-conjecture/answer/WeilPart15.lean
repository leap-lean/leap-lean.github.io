      obtain ⟨n, ω, hω⟩ := hPow_res (π_res x)
      let u₀ : C := ω ⊗ₜ[A] (1 : B)
      have hπ_u₀ : π_res u₀ = ω ⊗ₜ[A] (1 : κ_B) := by
        dsimp [π_res, u₀]
        rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one]
      let ν : C := x ^ (q ^ n) - u₀
      have hπ_ν : π_res ν = 0 := by
