theorem weil_curve_chart_principal_range_valuation_and_crt_uniformizers (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (k_to_K : k →+* ↑C.left.functionField)
    (div_fn : Additive (Units ↑C.left.functionField) →+
      ({ x : ↥C.left // IsClosed ({x} : Set ↥C.left) } →₀ ℤ))
    (_hRange : div_fn.range = weilCurvePrincipalSubgroup C.left)
    (U₀ : C.left.Opens) (_hU₀_ne : Nonempty ↥(U₀ : AlgebraicGeometry.Scheme.{u}))
    (hAff_U₀ : AlgebraicGeometry.IsAffineOpen U₀) :
    let Pt := { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }
    let K := ↑C.left.functionField
    let B₀ := ↑(C.left.presheaf.obj (Opposite.op U₀))
    let germB₀ : B₀ →+* K := (C.left.germToFunctionField U₀).hom
    let φ_k : k →+* B₀ :=
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
        (CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp U₀.ι C.hom).appTop
          (U₀.topIso).hom)).hom
    ∀ (t : B₀) (ht_ne : germB₀ t ≠ 0) (n : ℕ) (_hn : 1 ≤ n) (b : Fin n → B₀),
      germB₀.comp φ_k = k_to_K →
      (∀ (u₁ u₂ : Units K) (h : (u₁ : K) + (u₂ : K) ≠ 0) (x : Pt),
        min (div_fn (Additive.ofMul u₁) x) (div_fn (Additive.ofMul u₂) x) ≤
          div_fn (Additive.ofMul (Units.mk0 ((u₁ : K) + (u₂ : K)) h)) x) →
      (∀ c : Units k, div_fn (Additive.ofMul (Units.map k_to_K.toMonoidHom c)) = 0) →
      (∀ x : Pt,
        let Rx := ↑(C.left.presheaf.stalk x.1)
        let mx := IsLocalRing.maximalIdeal Rx
        IsDiscreteValuationRing Rx ∧
        (∀ u : Units K,
          (0 ≤ div_fn (Additive.ofMul u) x ↔ ∃ r : Rx, algebraMap Rx K r = (u : K)) ∧
          (1 ≤ div_fn (Additive.ofMul u) x ↔ ∃ r ∈ mx, algebraMap Rx K r = (u : K)))) →
      (∀ x : Pt, x.1 ∉ U₀ → div_fn (Additive.ofMul (Units.mk0 _ ht_ne)) x < 0) →
      Function.Bijective (fun c : Fin n → Polynomial k =>
        Finset.univ.sum fun i : Fin n => Polynomial.eval₂RingHom φ_k t (c i) * b i) →
      (∀ x : Pt, x.1 ∈ U₀ →
        ∃ (g_x z_x : B₀),
          x.1 ∈ C.left.basicOpen g_x ∧
          (Polynomial.eval₂RingHom
            ((algebraMap B₀ (Localization.Away g_x)).comp φ_k)
            (algebraMap B₀ (Localization.Away g_x) z_x)).Etale) →
      IsDomain B₀ ∧
      Function.Injective germB₀ ∧
      (∀ 𝔪 : Ideal B₀, 𝔪.IsMaximal →
        ∃ (x : Pt) (hx : x.1 ∈ U₀) (ev_x : B₀ →+* k),
          (hAff_U₀.primeIdealOf ⟨x.1, hx⟩).asIdeal = 𝔪 ∧
          ev_x.comp φ_k = RingHom.id k ∧
          RingHom.ker ev_x = 𝔪) ∧
      (∀ (x : Pt) (hx : x.1 ∈ U₀),
        ∃ ev_x : B₀ →+* k,
          ev_x.comp φ_k = RingHom.id k ∧
          RingHom.ker ev_x = (hAff_U₀.primeIdealOf ⟨x.1, hx⟩).asIdeal ∧
          ∃ (π_x : B₀) (hπ : germB₀ π_x ≠ 0),
            div_fn (Additive.ofMul (Units.mk0 _ hπ)) x = 1) ∧
      (∀ (F : B₀) (hF : germB₀ F ≠ 0) (x : Pt) (hx : x.1 ∈ U₀),
        0 ≤ div_fn (Additive.ofMul (Units.mk0 _ hF)) x ∧
        (1 ≤ div_fn (Additive.ofMul (Units.mk0 _ hF)) x ↔
          F ∈ (hAff_U₀.primeIdealOf ⟨x.1, hx⟩).asIdeal)) ∧
      (∀ u : Units K,
        (∀ x : Pt, x.1 ∈ U₀ → 0 ≤ div_fn (Additive.ofMul u) x) ↔
          ∃ F : B₀, germB₀ F = (u : K)) ∧
      (∀ (K_pos : ℕ) (c : Fin K_pos → k),
        let Δ_k : B₀ := Finset.univ.prod fun i : Fin K_pos => t - φ_k (c i)
        ∃ hΔ : germB₀ Δ_k ≠ 0,
          ∀ x : Pt, x.1 ∉ U₀ →
            div_fn (Additive.ofMul (Units.mk0 _ hΔ)) x =
              (K_pos : ℤ) * div_fn (Additive.ofMul (Units.mk0 _ ht_ne)) x) ∧
      (∀ (Δ_bar : B₀) (_hΔ_ne : Δ_bar ≠ 0) (x : Pt) (hx : x.1 ∈ U₀) (g_x z_x : B₀),
        let 𝔪_x := (hAff_U₀.primeIdealOf ⟨x.1, hx⟩).asIdeal
        x.1 ∈ C.left.basicOpen g_x →
        (Polynomial.eval₂RingHom
          ((algebraMap B₀ (Localization.Away g_x)).comp φ_k)
          (algebraMap B₀ (Localization.Away g_x) z_x)).Etale →
        ∃ z_tilde : B₀,
          z_tilde - z_x ∈ 𝔪_x ^ 2 ∧
          ∀ ev_x : B₀ →+* k,
            ev_x.comp φ_k = RingHom.id k →
            RingHom.ker ev_x = 𝔪_x →
            let u_x := z_tilde - φ_k (ev_x z_tilde)
            𝔪_x = Ideal.span ({u_x} : Set B₀) ⊔ Ideal.span ({Δ_bar} : Set B₀) • 𝔪_x) :=
by
  classical
  intro Pt K B₀ germB₀ φ_k t ht_ne n _hn b hgk hUltra hConst hStalk ht_pole hb_bij _hEtale
  have _hU₀_ne' : Nonempty ↥U₀ := _hU₀_ne
  
  
  
  have hDomB₀ : IsDomain B₀ := AlgebraicGeometry.IsIntegral.component_integral U₀
  have : IsDomain B₀ := hDomB₀
  have hInjGerm : Function.Injective germB₀ :=
    AlgebraicGeometry.Scheme.germToFunctionField_injective C.left U₀
  have hFracB₀ : IsFractionRing B₀ K :=
    AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen C.left U₀ hAff_U₀

  let ψ_t : Polynomial k →+* B₀ := Polynomial.eval₂RingHom φ_k t
  have hExNonzeroOfNeBot : ∀ (I : Ideal B₀), I ≠ ⊥ → ∃ x ∈ I, x ≠ 0 := by
    intro I hI
    by_contra hall
    push Not at hall
    apply hI
    ext x
    simp only [Ideal.mem_bot]
    exact ⟨fun hx => hall x hx, fun hx => hx.symm ▸ I.zero_mem⟩

  have hPolyPkg :
      IsNoetherianRing B₀ ∧
      (∀ a : k, t - φ_k a ≠ 0) ∧
      (∀ (𝔭 : Ideal B₀), 𝔭.IsPrime → 𝔭 ≠ ⊥ → 𝔭.IsMaximal) ∧
      (∀ 𝔪 : Ideal B₀, 𝔪.IsMaximal →
        𝔪 ≠ ⊥ ∧ ∃ ev : B₀ →+* k, ev.comp φ_k = RingHom.id k ∧ RingHom.ker ev = 𝔪) := by
    let alg_poly : Algebra (Polynomial k) B₀ := ψ_t.toAlgebra
    letI : Algebra (Polynomial k) B₀ := alg_poly
    have hb_bij_alg : Function.Bijective (fun c : Fin n → Polynomial k =>
        Finset.univ.sum fun i : Fin n => algebraMap (Polynomial k) B₀ (c i) * b i) := hb_bij
    let e_poly : (Fin n → Polynomial k) ≃ₗ[Polynomial k] B₀ :=
      weilPicSurj_polyBasisEquiv b hb_bij_alg
    have : Module.Finite (Polynomial k) B₀ := Module.Finite.equiv e_poly
    have hNoeth : IsNoetherianRing B₀ := IsNoetherianRing.of_finite (Polynomial k) B₀
    have : Algebra.IsIntegral (Polynomial k) B₀ :=
      Algebra.IsIntegral.of_finite (Polynomial k) B₀
    have hψ_int : ψ_t.IsIntegral := Algebra.isIntegral_def.mp inferInstance
    have hψ_inj : Function.Injective ψ_t := by
      let i₀ : Fin n := ⟨0, _hn⟩
      intro p₁ p₂ hp
      have h_eq_sum :
          (Finset.univ.sum fun i : Fin n =>
            ψ_t (if i = i₀ then p₁ else 0) * b i) =
          (Finset.univ.sum fun i : Fin n =>
            ψ_t (if i = i₀ then p₂ else 0) * b i) := by
        refine Finset.sum_congr rfl fun i _ => ?_
        split_ifs with hi
        · rw [hp]
        · rfl
      have hc := hb_bij.1 h_eq_sum
      simpa using congrFun hc i₀
    have hLinNe : ∀ a : k, t - φ_k a ≠ 0 := by
      intro a h0
      have hx : ψ_t (Polynomial.X - Polynomial.C a) = 0 := by
        simpa [ψ_t] using h0
      exact Polynomial.X_sub_C_ne_zero a (hψ_inj (hx.trans (map_zero ψ_t).symm))
    have hPrimeMax : ∀ (𝔭 : Ideal B₀), 𝔭.IsPrime → 𝔭 ≠ ⊥ → 𝔭.IsMaximal := by
      intro 𝔭 h𝔭 h𝔭_ne
      have : 𝔭.IsPrime := h𝔭
      obtain ⟨x, hx_mem, hx_ne⟩ := hExNonzeroOfNeBot 𝔭 h𝔭_ne
      have h_under_ne : Ideal.under (Polynomial k) 𝔭 ≠ ⊥ :=
        Ideal.under_ne_bot_of_integral_mem hx_ne hx_mem (Algebra.IsIntegral.isIntegral x)
      have h_comap_max : (Ideal.comap ψ_t 𝔭).IsMaximal :=
        IsPrime.to_maximal_ideal h_under_ne
      exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap ψ_t hψ_int 𝔭 h_comap_max
    refine ⟨hNoeth, hLinNe, hPrimeMax, ?_⟩
    intro 𝔪 h𝔪
    have : 𝔪.IsMaximal := h𝔪
    have h𝔪_ne : 𝔪 ≠ ⊥ := by
      intro hbot
      have h_comap_max : (Ideal.comap ψ_t 𝔪).IsMaximal :=
        Ideal.isMaximal_comap_of_isIntegral_of_isMaximal ψ_t hψ_int 𝔪
      have h_comap_bot : Ideal.comap ψ_t 𝔪 = ⊥ := by
        rw [hbot]
        ext p
        simp only [Ideal.mem_comap, Ideal.mem_bot]
        exact ⟨fun h => hψ_inj (h.trans (map_zero ψ_t).symm), fun h => by rw [h, map_zero]⟩
      rw [h_comap_bot] at h_comap_max
      have hX_not : (Polynomial.X : Polynomial k) ∉ (⊥ : Ideal (Polynomial k)) := by
        rw [Ideal.mem_bot]
        exact Polynomial.X_ne_zero
      have h1 : (1 : Polynomial k) ∈ Ideal.span ({Polynomial.X} : Set (Polynomial k)) :=
        (Ideal.isMaximal_iff.mp h_comap_max).2
          (Ideal.span ({Polynomial.X} : Set (Polynomial k))) Polynomial.X
          bot_le hX_not (Ideal.subset_span (Set.mem_singleton _))
      rw [Ideal.mem_span_singleton] at h1
      rcases h1 with ⟨q, hq⟩
      have hev := congrArg (Polynomial.eval (0 : k)) hq
      simp at hev
    refine ⟨h𝔪_ne, ?_⟩
    obtain ⟨x₀, hx₀_mem, hx₀_ne⟩ := hExNonzeroOfNeBot 𝔪 h𝔪_ne
    have h𝔮_ne : Ideal.under (Polynomial k) 𝔪 ≠ ⊥ :=
      Ideal.under_ne_bot_of_integral_mem hx₀_ne hx₀_mem (Algebra.IsIntegral.isIntegral x₀)
    have hex_p₀ : ∃ p₀ ∈ Ideal.under (Polynomial k) 𝔪, p₀ ≠ 0 := by
      by_contra hall
      push Not at hall
      apply h𝔮_ne
      ext p
      simp only [Ideal.mem_bot]
      exact ⟨fun hp => hall p hp, fun hp => hp.symm ▸ (Ideal.under (Polynomial k) 𝔪).zero_mem⟩
    obtain ⟨p₀, hp₀_mem, hp₀_ne⟩ := hex_p₀
    let L := B₀ ⧸ 𝔪
    letI : Field L := Ideal.Quotient.field 𝔪
    let q_m : B₀ →+* L := Ideal.Quotient.mk 𝔪
    let alg_kL : Algebra k L := (q_m.comp φ_k).toAlgebra
    letI : Algebra k L := alg_kL
    have hqt_alg : IsAlgebraic k (q_m t) := by
      refine ⟨p₀, hp₀_ne, ?_⟩
      change Polynomial.eval₂ (q_m.comp φ_k) (q_m t) p₀ = 0
      rw [← Polynomial.hom_eval₂ p₀ φ_k q_m t]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hp₀_mem
    have hqt_int : IsIntegral k (q_m t) := hqt_alg.isIntegral
    let A_int : Subalgebra k L := integralClosure k L
    let t_int : ↥A_int := ⟨q_m t, hqt_int⟩
    let ev_int : Polynomial k →+* ↥A_int := (Polynomial.aeval t_int).toRingHom
    have hev_int_comp : (algebraMap ↥A_int L).comp ev_int = q_m.comp ψ_t := by
      apply Polynomial.ringHom_ext'
      · ext c
        have h1 : (((algebraMap ↥A_int L).comp ev_int).comp Polynomial.C) c =
            algebraMap k L c := by
          change (algebraMap ↥A_int L) (ev_int (Polynomial.C c)) = algebraMap k L c
          have hC : ev_int (Polynomial.C c) = algebraMap k ↥A_int c :=
            Polynomial.aeval_C t_int c
          rw [hC]
          rfl
        have h2 : ((q_m.comp ψ_t).comp Polynomial.C) c = q_m (φ_k c) := by
          change q_m (Polynomial.eval₂ φ_k t (Polynomial.C c)) = q_m (φ_k c)
          rw [Polynomial.eval₂_C]
        rw [h1, h2]
        rfl
      · change (algebraMap ↥A_int L) (ev_int Polynomial.X) =
          q_m (Polynomial.eval₂ φ_k t Polynomial.X)
        have hX : ev_int Polynomial.X = t_int := Polynomial.aeval_X t_int
        rw [hX, Polynomial.eval₂_X]
        rfl
    have : Algebra.IsIntegral k ↥A_int := ⟨integralClosure.isIntegral⟩
    have hL_int : Algebra.IsIntegral k L := by
      constructor
      intro y
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨P, hP_monic, hP_ev⟩ := hψ_int x
      have hy_A : IsIntegral ↥A_int (q_m x) := by
        refine ⟨P.map ev_int, hP_monic.map ev_int, ?_⟩
        rw [Polynomial.eval₂_map, hev_int_comp, ← Polynomial.hom_eval₂ P ψ_t q_m x,
          hP_ev, map_zero]
      exact isIntegral_trans _ hy_A
    have hbij : Function.Bijective (algebraMap k L) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k) (K := L)
    let e_L : k ≃+* L := RingEquiv.ofBijective (algebraMap k L) hbij
    let ev : B₀ →+* k := e_L.symm.toRingHom.comp q_m
    have hev_id : ev.comp φ_k = RingHom.id k := by
      ext c
      change e_L.symm (e_L c) = c
      exact e_L.symm_apply_apply c
    have hev_ker : RingHom.ker ev = 𝔪 := by
      ext x
      simp only [RingHom.mem_ker, ev, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe,
        RingHom.coe_coe, map_eq_zero]
      exact Ideal.Quotient.eq_zero_iff_mem
    exact ⟨ev, hev_id, hev_ker⟩

  rcases hPolyPkg with ⟨hNoethB₀, hLinNe, hPrimeMax, hMaxEval⟩
  have : IsNoetherianRing B₀ := hNoethB₀

  
  
  
  have hSubSpec : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := by
    change Subsingleton (PrimeSpectrum k)
    refine ⟨fun p q => PrimeSpectrum.ext (Ideal.ext fun x => ?_)⟩
    by_cases hx : x = 0
    · subst hx; simp
    · have hp : x ∉ p.asIdeal := fun hm =>
        p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem p.asIdeal hm (IsUnit.mk0 x hx))
      have hq : x ∉ q.asIdeal := fun hm =>
        q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q.asIdeal hm (IsUnit.mk0 x hx))
      exact iff_of_false hp hq
  have : JacobsonSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := by
    refine ⟨fun {Z} hZ => ?_⟩
    have hall : Z ∩ closedPoints ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) = Z := by
      ext pt
      simp only [Set.mem_inter_iff, mem_closedPoints_iff, and_iff_left_iff_imp]
      intro _
      have huniv : ({pt} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of k))) = Set.univ :=
        Set.eq_univ_of_forall fun pt' => @Subsingleton.elim _ hSubSpec pt' pt
      rw [huniv]
      exact isClosed_univ
    rw [hall, hZ.closure_eq]
  have : AlgebraicGeometry.Smooth C.hom :=
    AlgebraicGeometry.SmoothOfRelativeDimension.smooth 1 C.hom
  have : JacobsonSpace ↥C.left :=
    AlgebraicGeometry.LocallyOfFiniteType.jacobsonSpace C.hom

  let e_U : ↥U₀ ≃ₜ PrimeSpectrum B₀ :=
    AlgebraicGeometry.Scheme.homeoOfIso hAff_U₀.isoSpec

  have hMaxToPt : ∀ 𝔪 : Ideal B₀, 𝔪.IsMaximal →
      ∃ (x : Pt) (hx : x.1 ∈ U₀), (hAff_U₀.primeIdealOf ⟨x.1, hx⟩).asIdeal = 𝔪 := by
    intro 𝔪 h𝔪
    let p : PrimeSpectrum B₀ := ⟨𝔪, h𝔪.isPrime⟩
    have hp_cl : IsClosed ({p} : Set (PrimeSpectrum B₀)) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal p).mpr h𝔪
    let y_U : ↥U₀ := e_U.symm p
    have hyU_cl : IsClosed ({y_U} : Set ↥U₀) := by
      have hpre : e_U ⁻¹' ({p} : Set (PrimeSpectrum B₀)) = {y_U} := by
        ext z
        simp only [Set.mem_preimage, Set.mem_singleton_iff, y_U]
        exact ⟨fun h => by rw [← h, e_U.symm_apply_apply], fun h => by rw [h, e_U.apply_symm_apply]⟩
      rw [← hpre]
      exact hp_cl.preimage e_U.continuous
    have hy_cl : IsClosed ({y_U.1} : Set ↥C.left) := by
      apply isClosed_singleton_of_isLocallyClosed_singleton
      have h_pre_cl : (Subtype.val : ↥U₀ → ↥C.left) ⁻¹' closure ({y_U.1} : Set ↥C.left) =
          ({y_U} : Set ↥U₀) := by
        have hind := Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image ({y_U} : Set ↥U₀)
        rw [Set.image_singleton, hyU_cl.closure_eq] at hind
        exact hind.symm
      have heq_inter : ({y_U.1} : Set ↥C.left) =
          (U₀ : Set ↥C.left) ∩ closure ({y_U.1} : Set ↥C.left) := by
        apply Set.Subset.antisymm
        · rintro _ rfl
          exact ⟨y_U.2, subset_closure (Set.mem_singleton _)⟩
        · rintro z ⟨hz_U, hz_cl⟩
          have hz_in : (⟨z, hz_U⟩ : ↥U₀) ∈
              (Subtype.val : ↥U₀ → ↥C.left) ⁻¹' closure ({y_U.1} : Set ↥C.left) := hz_cl
          rw [h_pre_cl, Set.mem_singleton_iff] at hz_in
          exact congrArg Subtype.val hz_in
      rw [heq_inter]
      exact U₀.isOpen.isLocallyClosed.inter isClosed_closure.isLocallyClosed
    refine ⟨⟨y_U.1, hy_cl⟩, y_U.2, ?_⟩
    have heq_p : hAff_U₀.primeIdealOf y_U = p := e_U.apply_symm_apply p
    exact congrArg PrimeSpectrum.asIdeal heq_p

  have hPtBridge : ∀ (x : Pt) (hx : x.1 ∈ U₀),
      let 𝔪_x := (hAff_U₀.primeIdealOf ⟨x.1, hx⟩).asIdeal
      let Rx := ↑(C.left.presheaf.stalk x.1)
      let mx := IsLocalRing.maximalIdeal Rx
      𝔪_x.IsMaximal ∧
      (∀ g : B₀, x.1 ∈ C.left.basicOpen g ↔ g ∉ 𝔪_x) ∧
      ∃ ι_x : B₀ →+* Rx,
        (∀ F : B₀, algebraMap Rx K (ι_x F) = germB₀ F) ∧
        (∀ F : B₀, ι_x F ∈ mx ↔ F ∈ 𝔪_x) ∧
        (∀ r : Rx, ∃ b s : B₀, s ∉ 𝔪_x ∧ r * ι_x s = ι_x b) := by
    intro x hx 𝔪_x Rx mx
    let x_U : ↥U₀ := ⟨x.1, hx⟩
    have hxU_cl : IsClosed ({x_U} : Set ↥U₀) := by
      have hpre : (Subtype.val : ↥U₀ → ↥C.left) ⁻¹' ({x.1} : Set ↥C.left) = {x_U} := by
        ext z
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        exact ⟨fun h => Subtype.ext h, fun h => congrArg Subtype.val h⟩
      rw [← hpre]
      exact x.2.preimage continuous_subtype_val
    have hp_cl : IsClosed ({e_U x_U} : Set (PrimeSpectrum B₀)) := by
      have himg : e_U '' ({x_U} : Set ↥U₀) = {e_U x_U} := Set.image_singleton
      rw [← himg]
      exact e_U.isClosedMap _ hxU_cl
    have h𝔪_max : 𝔪_x.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal (hAff_U₀.primeIdealOf x_U)).mp hp_cl
    have hBasic : ∀ g : B₀, x.1 ∈ C.left.basicOpen g ↔ g ∉ 𝔪_x := by
      intro g
      have hfx : hAff_U₀.fromSpec.base (hAff_U₀.primeIdealOf x_U) = x.1 :=
        hAff_U₀.fromSpec_primeIdealOf x_U
      rw [← hfx]
      change hAff_U₀.primeIdealOf x_U ∈ hAff_U₀.fromSpec ⁻¹ᵁ C.left.basicOpen g ↔ _
      rw [AlgebraicGeometry.Scheme.preimage_basicOpen, hAff_U₀.basicOpen_fromSpec_app g]
      exact PrimeSpectrum.mem_basicOpen g (hAff_U₀.primeIdealOf x_U)
    refine ⟨h𝔪_max, hBasic, ?_⟩
    let alg_stalk : Algebra B₀ Rx := TopCat.Presheaf.algebra_section_stalk C.left.presheaf x_U
    letI : Algebra B₀ Rx := alg_stalk
    have : IsLocalization.AtPrime Rx 𝔪_x := hAff_U₀.isLocalization_stalk x_U
    let ι_x : B₀ →+* Rx := algebraMap B₀ Rx
    have hι_eq_germ : ι_x = (C.left.presheaf.germ U₀ x.1 hx).hom :=
      TopCat.Presheaf.stalk_open_algebraMap C.left.presheaf x_U
    refine ⟨ι_x, ?_, ?_, ?_⟩
    · intro F
      rw [hι_eq_germ]
      exact C.left.algebraMap_germ_eq_germToFunctionField hx F
    · intro F
      exact IsLocalization.AtPrime.to_map_mem_maximal_iff Rx 𝔪_x F
    · intro r
      obtain ⟨⟨b, s⟩, hrs⟩ := IsLocalization.surj 𝔪_x.primeCompl r
      exact ⟨b, s.1, s.2, hrs⟩

  
  
  
  have hDVRPkg :
      (∀ (x : Pt) (r : ↑(C.left.presheaf.stalk x.1)) (hr : algebraMap _ K r ≠ 0),
        Ideal.span ({r} : Set ↑(C.left.presheaf.stalk x.1)) =
          IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk x.1) →
        div_fn (Additive.ofMul (Units.mk0 (algebraMap _ K r) hr)) x = 1) ∧
      (∀ (u_t : Units K) (x : Pt),
        div_fn (Additive.ofMul u_t) x < 0 →
        ∀ (K_pos : ℕ) (c : Fin K_pos → k)
          (hc_ne : ∀ i : Fin K_pos, (u_t : K) - k_to_K (c i) ≠ 0),
          let u_prod : Units K :=
            Finset.univ.prod fun i : Fin K_pos => Units.mk0 ((u_t : K) - k_to_K (c i)) (hc_ne i)
          div_fn (Additive.ofMul u_prod) x =
            (K_pos : ℤ) * div_fn (Additive.ofMul u_t) x) := by
    let R : Pt → Type u := fun y => ↑(C.left.presheaf.stalk y.1)
    have : ∀ y : Pt, IsDiscreteValuationRing (R y) := fun y => (hStalk y).1
    have hStrictPow : ∀ y : Pt,
        StrictAnti (fun m : ℕ => (IsLocalRing.maximalIdeal (R y)) ^ m) := by
      intro y
      set my := IsLocalRing.maximalIdeal (R y)
      let ϖ : R y := Submodule.IsPrincipal.generator my
      have hspan_ϖ : Ideal.span ({ϖ} : Set (R y)) = my :=
        Submodule.IsPrincipal.span_singleton_generator my
      have hmy_ne_bot : my ≠ ⊥ := IsDiscreteValuationRing.not_a_field'
      have hϖ_ne : ϖ ≠ 0 := by
        intro h0
        apply hmy_ne_bot
        rw [← hspan_ϖ, h0, Set.singleton_zero, Ideal.span_zero]
      have hϖ_not_unit : ¬ IsUnit ϖ := by
        intro hu
        have htop : my = ⊤ := by
          rw [← hspan_ϖ, Ideal.span_singleton_eq_top]
          exact hu
        exact (IsLocalRing.maximalIdeal.isMaximal (R y)).ne_top htop
      refine strictAnti_nat_of_succ_lt fun m => ?_
      refine lt_of_le_of_ne (Ideal.pow_le_pow_right (Nat.le_succ m)) ?_
      intro heq
      have hmem : ϖ ^ m ∈ my ^ (m + 1) := by
        rw [heq, ← hspan_ϖ, Ideal.span_singleton_pow]
        exact Ideal.subset_span (Set.mem_singleton _)
      rw [← hspan_ϖ, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hmem
      rcases hmem with ⟨q, hq⟩
      have hpow_ne : ϖ ^ m ≠ 0 := pow_ne_zero m hϖ_ne
      have hmul1 : ϖ ^ m * (ϖ * q) = ϖ ^ m * 1 := by
        calc
          ϖ ^ m * (ϖ * q) = ϖ ^ (m + 1) * q := by rw [pow_succ, mul_assoc]
          _ = ϖ ^ m := hq.symm
          _ = ϖ ^ m * 1 := (mul_one _).symm
      have h1 : ϖ * q = 1 := mul_left_cancel₀ hpow_ne hmul1
      exact hϖ_not_unit ⟨⟨ϖ, q, h1, mul_comm ϖ q ▸ h1⟩, rfl⟩

    have hExWit : ∀ (y : Pt) (u : Units K),
        ∃ (a b : R y) (na nb : ℕ),
          a ≠ 0 ∧ b ≠ 0 ∧
          algebraMap (R y) K a = (u : K) * algebraMap (R y) K b ∧
          Ideal.span ({a} : Set (R y)) = (IsLocalRing.maximalIdeal (R y)) ^ na ∧
          Ideal.span ({b} : Set (R y)) = (IsLocalRing.maximalIdeal (R y)) ^ nb := by
      intro y u
      obtain ⟨a, b, hb_mem, hab⟩ := IsFractionRing.div_surjective (A := R y) (u : K)
      have hb_ne : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_mem
      have hb_K_ne : algebraMap (R y) K b ≠ 0 :=
        fun h0 => hb_ne (IsFractionRing.injective (R y) K (h0.trans (map_zero _).symm))
      have hab_mul : algebraMap (R y) K a = (u : K) * algebraMap (R y) K b :=
        (div_eq_iff hb_K_ne).mp hab
      have ha_ne : a ≠ 0 := by
        intro h0
        rw [h0, map_zero] at hab_mul
        exact mul_ne_zero u.ne_zero hb_K_ne hab_mul.symm
      have ha_span_ne : Ideal.span ({a} : Set (R y)) ≠ ⊥ := by
        simp [ha_ne]
      have hb_span_ne : Ideal.span ({b} : Set (R y)) ≠ ⊥ := by
        simp [hb_ne]
      obtain ⟨na, hna⟩ := exists_maximalIdeal_pow_eq_of_principal (R y) inferInstance _ ha_span_ne
      obtain ⟨nb, hnb⟩ := exists_maximalIdeal_pow_eq_of_principal (R y) inferInstance _ hb_span_ne
      exact ⟨a, b, na, nb, ha_ne, hb_ne, hab_mul, hna, hnb⟩

    have hWitUniq : ∀ (y : Pt) (u : Units K)
        (a₁ b₁ : R y) (na₁ nb₁ : ℕ) (a₂ b₂ : R y) (na₂ nb₂ : ℕ),
        a₁ ≠ 0 → b₁ ≠ 0 →
        algebraMap (R y) K a₁ = (u : K) * algebraMap (R y) K b₁ →
        Ideal.span ({a₁} : Set (R y)) = (IsLocalRing.maximalIdeal (R y)) ^ na₁ →
        Ideal.span ({b₁} : Set (R y)) = (IsLocalRing.maximalIdeal (R y)) ^ nb₁ →
        a₂ ≠ 0 → b₂ ≠ 0 →
        algebraMap (R y) K a₂ = (u : K) * algebraMap (R y) K b₂ →
        Ideal.span ({a₂} : Set (R y)) = (IsLocalRing.maximalIdeal (R y)) ^ na₂ →
        Ideal.span ({b₂} : Set (R y)) = (IsLocalRing.maximalIdeal (R y)) ^ nb₂ →
        (na₁ : ℤ) - (nb₁ : ℤ) = (na₂ : ℤ) - (nb₂ : ℤ) := by
      intro y u a₁ b₁ na₁ nb₁ a₂ b₂ na₂ nb₂ _ _ h1 ha1 hb1 _ _ h2 ha2 hb2
      have hmul_eq : a₁ * b₂ = a₂ * b₁ := by
        apply IsFractionRing.injective (R y) K
        rw [map_mul, map_mul, h1, h2]
        ring
      have hpow_eq :
          (IsLocalRing.maximalIdeal (R y)) ^ (na₁ + nb₂) =
            (IsLocalRing.maximalIdeal (R y)) ^ (na₂ + nb₁) := by
        calc
          (IsLocalRing.maximalIdeal (R y)) ^ (na₁ + nb₂) =
              (IsLocalRing.maximalIdeal (R y)) ^ na₁ *
                (IsLocalRing.maximalIdeal (R y)) ^ nb₂ := pow_add _ na₁ nb₂
          _ = Ideal.span ({a₁} : Set (R y)) * Ideal.span ({b₂} : Set (R y)) := by rw [← ha1, ← hb2]
          _ = Ideal.span ({a₁ * b₂} : Set (R y)) := Ideal.span_singleton_mul_span_singleton a₁ b₂
          _ = Ideal.span ({a₂ * b₁} : Set (R y)) := by rw [hmul_eq]
          _ = Ideal.span ({a₂} : Set (R y)) * Ideal.span ({b₁} : Set (R y)) :=
            (Ideal.span_singleton_mul_span_singleton a₂ b₁).symm
          _ = (IsLocalRing.maximalIdeal (R y)) ^ na₂ *
                (IsLocalRing.maximalIdeal (R y)) ^ nb₁ := by rw [ha2, hb1]
          _ = (IsLocalRing.maximalIdeal (R y)) ^ (na₂ + nb₁) := (pow_add _ na₂ nb₁).symm
      have hnat_eq : na₁ + nb₂ = na₂ + nb₁ := (hStrictPow y).injective hpow_eq
      omega

    let v0 : Pt → Units K → ℤ := fun y u =>
      let hw := hExWit y u
      let na := hw.choose_spec.choose_spec.choose
      let nb := hw.choose_spec.choose_spec.choose_spec.choose
      (na : ℤ) - (nb : ℤ)
    have hv0_eq : ∀ (y : Pt) (u : Units K) (a b : R y) (na nb : ℕ),
        a ≠ 0 → b ≠ 0 →
        algebraMap (R y) K a = (u : K) * algebraMap (R y) K b →
        Ideal.span ({a} : Set (R y)) = (IsLocalRing.maximalIdeal (R y)) ^ na →
        Ideal.span ({b} : Set (R y)) = (IsLocalRing.maximalIdeal (R y)) ^ nb →
        v0 y u = (na : ℤ) - (nb : ℤ) := by
      intro y u a b na nb ha hb hm hna hnb
      let hw := hExWit y u
      obtain ⟨ha0, hb0, hm0, hna0, hnb0⟩ := hw.choose_spec.choose_spec.choose_spec.choose_spec
      exact hWitUniq y u _ _ _ _ a b na nb ha0 hb0 hm0 hna0 hnb0 ha hb hm hna hnb

    let v_std : Pt → (Additive (Units K) →+ ℤ) := fun y =>
      { toFun := fun a => v0 y (Additive.toMul a)
        map_zero' := by
          change v0 y 1 = 0
          have h1 : Ideal.span ({(1 : R y)} : Set (R y)) = (IsLocalRing.maximalIdeal (R y)) ^ 0 := by
            simp
          rw [hv0_eq y 1 1 1 0 0 one_ne_zero one_ne_zero (by simp) h1 h1]
          rfl
        map_add' := fun x₁ x₂ => by
          let u₁ := Additive.toMul x₁
          let u₂ := Additive.toMul x₂
          obtain ⟨a₁, b₁, na₁, nb₁, ha₁, hb₁, hm₁, hna₁, hnb₁⟩ := hExWit y u₁
          obtain ⟨a₂, b₂, na₂, nb₂, ha₂, hb₂, hm₂, hna₂, hnb₂⟩ := hExWit y u₂
          change v0 y (u₁ * u₂) = v0 y u₁ + v0 y u₂
          rw [hv0_eq y u₁ a₁ b₁ na₁ nb₁ ha₁ hb₁ hm₁ hna₁ hnb₁,
            hv0_eq y u₂ a₂ b₂ na₂ nb₂ ha₂ hb₂ hm₂ hna₂ hnb₂]
          have hspan_a : Ideal.span ({a₁ * a₂} : Set (R y)) =
              (IsLocalRing.maximalIdeal (R y)) ^ (na₁ + na₂) := by
            rw [← Ideal.span_singleton_mul_span_singleton, hna₁, hna₂, ← pow_add]
          have hspan_b : Ideal.span ({b₁ * b₂} : Set (R y)) =
              (IsLocalRing.maximalIdeal (R y)) ^ (nb₁ + nb₂) := by
            rw [← Ideal.span_singleton_mul_span_singleton, hnb₁, hnb₂, ← pow_add]
          have hmul_ab : algebraMap (R y) K (a₁ * a₂) =
              ((u₁ * u₂ : Units K) : K) * algebraMap (R y) K (b₁ * b₂) := by
            rw [map_mul, map_mul, hm₁, hm₂, Units.val_mul]
            ring
          rw [hv0_eq y (u₁ * u₂) (a₁ * a₂) (b₁ * b₂) (na₁ + na₂) (nb₁ + nb₂)
            (mul_ne_zero ha₁ ha₂) (mul_ne_zero hb₁ hb₂) hmul_ab hspan_a hspan_b]
          push_cast
          ring }

    have hZeroImpliesZero : ∀ (y : Pt) (g : Additive (Units K)),
        v_std y g = 0 → div_fn g y = 0 := by
      have hNonneg : ∀ (y : Pt) (u : Units K),
          v_std y (Additive.ofMul u) = 0 → 0 ≤ div_fn (Additive.ofMul u) y := by
        intro y u hv
        obtain ⟨a, b, na, nb, ha, hb, hm, hna, hnb⟩ := hExWit y u
        have hv' : v0 y u = 0 := hv
        rw [hv0_eq y u a b na nb ha hb hm hna hnb] at hv'
        have hnab : na = nb := by omega
        have hspan_eq : Ideal.span ({a} : Set (R y)) = Ideal.span ({b} : Set (R y)) := by
          rw [hna, hnb, hnab]
        have ha_mem : a ∈ Ideal.span ({b} : Set (R y)) := by
          rw [← hspan_eq]; exact Ideal.subset_span (Set.mem_singleton a)
        rw [Ideal.mem_span_singleton] at ha_mem
        rcases ha_mem with ⟨r, hr⟩
        have hbK : algebraMap (R y) K b ≠ 0 :=
          fun h0 => hb (IsFractionRing.injective (R y) K (h0.trans (map_zero _).symm))
        have hrK : algebraMap (R y) K r = (u : K) := by
          apply mul_left_cancel₀ hbK
          calc
            algebraMap (R y) K b * algebraMap (R y) K r = algebraMap (R y) K (b * r) :=
              (map_mul _ b r).symm
            _ = algebraMap (R y) K a := by rw [hr]
            _ = (u : K) * algebraMap (R y) K b := hm
            _ = algebraMap (R y) K b * (u : K) := mul_comm _ _
        exact ((hStalk y).2 u).1.mpr ⟨r, hrK⟩
      intro y g hg
      let u := Additive.toMul g
      have h1 : 0 ≤ div_fn (Additive.ofMul u) y := hNonneg y u hg
      have hg_neg : v_std y (Additive.ofMul u⁻¹) = 0 := by
        rw [ofMul_inv, map_neg, show Additive.ofMul u = g from rfl, hg, neg_zero]
      have h2 : 0 ≤ div_fn (Additive.ofMul u⁻¹) y := hNonneg y u⁻¹ hg_neg
      rw [ofMul_inv, map_neg, Finsupp.neg_apply] at h2
      change 0 ≤ div_fn g y at h1
      change 0 ≤ -div_fn g y at h2
      omega

    let ϖ_pt : ∀ y : Pt, R y := fun y =>
      Submodule.IsPrincipal.generator (IsLocalRing.maximalIdeal (R y))
    have hϖ_span : ∀ y : Pt,
        Ideal.span ({ϖ_pt y} : Set (R y)) = IsLocalRing.maximalIdeal (R y) :=
      fun y => Submodule.IsPrincipal.span_singleton_generator _
    have hϖ_ne : ∀ y : Pt, ϖ_pt y ≠ 0 := by
      intro y h0
      apply @IsDiscreteValuationRing.not_a_field' (R y) _ _ _
      rw [← hϖ_span y, h0, Set.singleton_zero, Ideal.span_zero]
    have hϖ_K_ne : ∀ y : Pt, algebraMap (R y) K (ϖ_pt y) ≠ 0 :=
      fun y h0 => hϖ_ne y (IsFractionRing.injective (R y) K (h0.trans (map_zero _).symm))
    let u_ϖ : ∀ y : Pt, Units K := fun y => Units.mk0 (algebraMap (R y) K (ϖ_pt y)) (hϖ_K_ne y)

    have hv_std_ϖ : ∀ y : Pt, v_std y (Additive.ofMul (u_ϖ y)) = 1 := by
      intro y
      change v0 y (u_ϖ y) = 1
      have hsp1 : Ideal.span ({ϖ_pt y} : Set (R y)) = (IsLocalRing.maximalIdeal (R y)) ^ 1 := by
        rw [pow_one, hϖ_span y]
      have hsp0 : Ideal.span ({(1 : R y)} : Set (R y)) = (IsLocalRing.maximalIdeal (R y)) ^ 0 := by
        simp
      rw [hv0_eq y (u_ϖ y) (ϖ_pt y) 1 1 0 (hϖ_ne y) one_ne_zero (by simp [u_ϖ]) hsp1 hsp0]
      rfl

    let c_scale : Pt → ℤ := fun y => div_fn (Additive.ofMul (u_ϖ y)) y
    have hc_ge1 : ∀ y : Pt, 1 ≤ c_scale y := by
      intro y
      refine ((hStalk y).2 (u_ϖ y)).2.mpr ⟨ϖ_pt y, ?_, rfl⟩
      rw [← hϖ_span y]
      exact Ideal.subset_span (Set.mem_singleton _)

    have hScaleLaw : ∀ (y : Pt) (g : Additive (Units K)),
        div_fn g y = c_scale y * v_std y g := by
      intro y g
      let m : ℤ := v_std y g
      let w : Additive (Units K) := g - m • Additive.ofMul (u_ϖ y)
      have hvw : v_std y w = 0 := by
        dsimp [w]
        rw [map_sub, map_zsmul, hv_std_ϖ y, smul_eq_mul, mul_one, sub_self]
      have hdw : div_fn w y = 0 := hZeroImpliesZero y w hvw
      have hg_eq : g = w + m • Additive.ofMul (u_ϖ y) := by
        dsimp [w]; abel
      calc
        div_fn g y = div_fn (w + m • Additive.ofMul (u_ϖ y)) y := by rw [← hg_eq]
        _ = div_fn w y + m * c_scale y := by
          rw [map_add, map_zsmul, Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul]
        _ = c_scale y * v_std y g := by rw [hdw, zero_add, mul_comm]

    have hc_eq1 : ∀ x : Pt, c_scale x = 1 := by
      intro x
      let f : Units K := u_ϖ x
      have hsupp : ∀ y : Pt, v_std y (Additive.ofMul f) ≠ 0 →
          y ∈ (div_fn (Additive.ofMul f)).support := by
        intro y hne
        rw [Finsupp.mem_support_iff, hScaleLaw y (Additive.ofMul f)]
        have hc_ne : c_scale y ≠ 0 := by have := hc_ge1 y; omega
        exact mul_ne_zero hc_ne hne
      let D_f : Pt →₀ ℤ :=
        Finsupp.onFinset (div_fn (Additive.ofMul f)).support
          (fun y => v_std y (Additive.ofMul f)) hsupp
      have hDf_mem : D_f ∈ weilCurvePrincipalSubgroup C.left := by
        apply AddSubgroup.subset_closure
        refine ⟨f, fun y => ?_⟩
        obtain ⟨a, b, na, nb, ha, hb, hm, hna, hnb⟩ := hExWit y f
        refine ⟨a, b, na, nb, ha, hb, hm, hna, hnb, ?_⟩
        change v_std y (Additive.ofMul f) = (na : ℤ) - (nb : ℤ)
        exact hv0_eq y f a b na nb ha hb hm hna hnb
      rw [← _hRange] at hDf_mem
      rcases hDf_mem with ⟨g_add, hg_add⟩
      have h_at_x : div_fn g_add x = D_f x := congrArg (fun D : Pt →₀ ℤ => D x) hg_add
      have hDf_x : D_f x = 1 := hv_std_ϖ x
      rw [hScaleLaw x g_add, hDf_x] at h_at_x
      have hcx_ge1 : 1 ≤ c_scale x := hc_ge1 x
      have hv_pos : 1 ≤ v_std x g_add := by
        by_contra hv_le
        have hv_nonpos : v_std x g_add ≤ 0 := by omega
        have hprod_nonpos : c_scale x * v_std x g_add ≤ 0 :=
          mul_nonpos_of_nonneg_of_nonpos (by omega) hv_nonpos
        omega
      by_contra hne1
      have hcx_ge2 : 2 ≤ c_scale x := by omega
      have hprod_ge2 : 2 * 1 ≤ c_scale x * v_std x g_add :=
        mul_le_mul hcx_ge2 hv_pos (by omega) (by omega)
      omega

    refine ⟨?_, ?_⟩
    · intro x r hr hr_span
      let u_r := Units.mk0 (algebraMap (R x) K r) hr
      have hr_ne : r ≠ 0 := fun h0 => hr (by rw [h0, map_zero])
      have hsp1 : Ideal.span ({r} : Set (R x)) = (IsLocalRing.maximalIdeal (R x)) ^ 1 := by
        rw [pow_one]; exact hr_span
      have hsp0 : Ideal.span ({(1 : R x)} : Set (R x)) = (IsLocalRing.maximalIdeal (R x)) ^ 0 := by
        simp
      rw [hScaleLaw x (Additive.ofMul u_r), hc_eq1 x, one_mul]
      exact hv0_eq x u_r r 1 1 0 hr_ne one_ne_zero (by simp [u_r]) hsp1 hsp0
    · intro u_t x hut_neg K_pos
      have hShift : ∀ (a : k) (ha_ne : (u_t : K) - k_to_K a ≠ 0),
          div_fn (Additive.ofMul (Units.mk0 ((u_t : K) - k_to_K a) ha_ne)) x =
            div_fn (Additive.ofMul u_t) x := by
        intro a ha_ne
        let u_ta := Units.mk0 ((u_t : K) - k_to_K a) ha_ne
        change div_fn (Additive.ofMul u_ta) x = div_fn (Additive.ofMul u_t) x
        by_cases ha0 : a = 0
        · have hu_eq : u_ta = u_t := by
            ext; simp [u_ta, ha0]
          rw [hu_eq]
        · let c_neg : Units k := Units.mk0 (-a) (neg_ne_zero.mpr ha0)
          let w_neg : Units K := Units.map k_to_K.toMonoidHom c_neg
          have hw_neg_div : div_fn (Additive.ofMul w_neg) x = 0 := by
            rw [hConst c_neg]; rfl
          have hsum1_ne : (u_t : K) + (w_neg : K) ≠ 0 := by
            change (u_t : K) + k_to_K (-a) ≠ 0
            rwa [map_neg, ← sub_eq_add_neg]
          have hu1_eq : Units.mk0 ((u_t : K) + (w_neg : K)) hsum1_ne = u_ta := by
            ext
            change (u_t : K) + k_to_K (-a) = (u_t : K) - k_to_K a
            rw [map_neg, sub_eq_add_neg]
          have hle1 := hUltra u_t w_neg hsum1_ne x
          rw [hw_neg_div, hu1_eq] at hle1
          have hmin1 : min (div_fn (Additive.ofMul u_t) x) 0 = div_fn (Additive.ofMul u_t) x :=
            min_eq_left (by omega)
          rw [hmin1] at hle1
          let c_pos : Units k := Units.mk0 a ha0
          let w_pos : Units K := Units.map k_to_K.toMonoidHom c_pos
          have hw_pos_div : div_fn (Additive.ofMul w_pos) x = 0 := by
            rw [hConst c_pos]; rfl
          have hsum2_ne : (u_ta : K) + (w_pos : K) ≠ 0 := by
            change ((u_t : K) - k_to_K a) + k_to_K a ≠ 0
            rw [sub_add_cancel]
            exact u_t.ne_zero
          have hu2_eq : Units.mk0 ((u_ta : K) + (w_pos : K)) hsum2_ne = u_t := by
            ext
            change ((u_t : K) - k_to_K a) + k_to_K a = (u_t : K)
            exact sub_add_cancel _ _
          have hle2 := hUltra u_ta w_pos hsum2_ne x
          rw [hw_pos_div, hu2_eq] at hle2
          have hta_neg : div_fn (Additive.ofMul u_ta) x < 0 := by
            by_contra hge0
            have hmin2 : min (div_fn (Additive.ofMul u_ta) x) 0 = 0 := min_eq_right (by omega)
            rw [hmin2] at hle2
            omega
          have hmin2 : min (div_fn (Additive.ofMul u_ta) x) 0 = div_fn (Additive.ofMul u_ta) x :=
            min_eq_left (by omega)
          rw [hmin2] at hle2
          omega
      induction K_pos with
      | zero =>
        intro c hc_ne
        simp only [Finset.univ_eq_empty, Finset.prod_empty, ofMul_one, map_zero,
          Finsupp.zero_apply, Nat.cast_zero, zero_mul]
      | succ m ih =>
        intro c hc_ne
        let f_u : Fin (m + 1) → Units K :=
          fun i => Units.mk0 ((u_t : K) - k_to_K (c i)) (hc_ne i)
        change div_fn (Additive.ofMul (Finset.univ.prod f_u)) x = _
        rw [Fin.prod_univ_succ, ofMul_mul, map_add, Finsupp.add_apply,
          hShift (c 0) (hc_ne 0),
          ih (fun i => c i.succ) (fun i => hc_ne i.succ)]
        push_cast
        ring

  rcases hDVRPkg with ⟨hUnifVal1, hPoleProd⟩

  
  
  
  have hEtaleLocalSpan :
      ∀ (𝔪_x : Ideal B₀) [𝔪_x.IsMaximal]
        (ev_x : B₀ →+* k)
        (_hev_id : ev_x.comp φ_k = RingHom.id k)
        (_hev_ker : RingHom.ker ev_x = 𝔪_x)
        (g_x z_x z_tilde : B₀),
        g_x ∉ 𝔪_x →
        (Polynomial.eval₂RingHom
          ((algebraMap B₀ (Localization.Away g_x)).comp φ_k)
          (algebraMap B₀ (Localization.Away g_x) z_x)).Etale →
        z_tilde - z_x ∈ 𝔪_x ^ 2 →
        let u_x := z_tilde - φ_k (ev_x z_tilde)
        ∀ a ∈ 𝔪_x, ∃ s q : B₀, s ∉ 𝔪_x ∧ s * a = u_x * q := by
    intro 𝔪_x h𝔪_max ev_x hev_id hev_ker g_x z_x z_tilde hgx_not hzx_et hzt_sq u_x
    let R_loc := Localization.AtPrime 𝔪_x
    have : IsNoetherianRing R_loc :=
      IsLocalization.isNoetherianRing 𝔪_x.primeCompl R_loc inferInstance
    let ι_loc : B₀ →+* R_loc := algebraMap B₀ R_loc
    let 𝔪_loc : Ideal R_loc := IsLocalRing.maximalIdeal R_loc
    have hmap_𝔪 : Ideal.map ι_loc 𝔪_x = 𝔪_loc :=
      IsLocalization.AtPrime.map_eq_maximalIdeal 𝔪_x R_loc
    let π₀ : B₀ := z_x - φ_k (ev_x z_x)
    let J : Ideal R_loc := Ideal.span ({ι_loc π₀} : Set R_loc) ⊔ 𝔪_loc ^ 2
    let Q₂ := R_loc ⧸ J
    let q₂ : R_loc →+* Q₂ := Ideal.Quotient.mk J
    let I_bar : Ideal Q₂ := Ideal.map q₂ 𝔪_loc
    have hIbar_sq : I_bar ^ 2 = ⊥ := by
      dsimp [I_bar]
      rw [← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker]
      intro w hw
      rw [RingHom.mem_ker]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr ((le_sup_right : 𝔪_loc ^ 2 ≤ J) hw)
    let S_gx := Localization.Away g_x
    let f_et : Polynomial k →+* S_gx :=
      Polynomial.eval₂RingHom ((algebraMap B₀ S_gx).comp φ_k) (algebraMap B₀ S_gx z_x)
    let alg_et : Algebra (Polynomial k) S_gx := f_et.toAlgebra
    letI : Algebra (Polynomial k) S_gx := alg_et
    have : Algebra.Etale (Polynomial k) S_gx := RingHom.Etale.toAlgebra hzx_et
    let loc_away : S_gx →+* R_loc :=
      IsLocalization.Away.lift g_x
        (IsLocalization.map_units R_loc (⟨g_x, hgx_not⟩ : 𝔪_x.primeCompl))
    have hgx_ev : ev_x g_x ≠ 0 := by
      intro h0
      apply hgx_not
      rw [← hev_ker]
      exact h0
    let ev_away : S_gx →+* k := IsLocalization.Away.lift g_x (IsUnit.mk0 (ev_x g_x) hgx_ev)
    let ψ₁_hom : S_gx →+* Q₂ := q₂.comp loc_away
    let ψ₂_hom : S_gx →+* Q₂ := (q₂.comp (ι_loc.comp φ_k)).comp ev_away
    have h_fet_eq : ψ₁_hom.comp f_et = ψ₂_hom.comp f_et := by
      apply Polynomial.ringHom_ext'
      · ext c
        have hfC : f_et (Polynomial.C c) = algebraMap B₀ S_gx (φ_k c) :=
          Polynomial.eval₂_C _ _
        have hc_ev : ev_x (φ_k c) = c := congrArg (fun g : k →+* k => g c) hev_id
        change q₂ (loc_away (f_et (Polynomial.C c))) =
          q₂ (ι_loc (φ_k (ev_away (f_et (Polynomial.C c)))))
        rw [hfC]
        have hL1 : loc_away (algebraMap B₀ S_gx (φ_k c)) = ι_loc (φ_k c) :=
          IsLocalization.Away.lift_eq g_x _ (φ_k c)
        have hL2 : ev_away (algebraMap B₀ S_gx (φ_k c)) = ev_x (φ_k c) :=
          IsLocalization.Away.lift_eq g_x _ (φ_k c)
        rw [hL1, hL2, hc_ev]
      · have hfX : f_et Polynomial.X = algebraMap B₀ S_gx z_x :=
          Polynomial.eval₂_X _ _
        change q₂ (loc_away (f_et Polynomial.X)) =
          q₂ (ι_loc (φ_k (ev_away (f_et Polynomial.X))))
        rw [hfX]
        have hL1 : loc_away (algebraMap B₀ S_gx z_x) = ι_loc z_x :=
          IsLocalization.Away.lift_eq g_x _ z_x
        have hL2 : ev_away (algebraMap B₀ S_gx z_x) = ev_x z_x :=
          IsLocalization.Away.lift_eq g_x _ z_x
        rw [hL1, hL2]
        apply sub_eq_zero.mp
        rw [← map_sub, ← map_sub]
        apply Ideal.Quotient.eq_zero_iff_mem.mpr
        exact (le_sup_left : Ideal.span ({ι_loc π₀} : Set R_loc) ≤ J)
          (Ideal.subset_span (Set.mem_singleton (ι_loc π₀)))
    let alg_Q₂ : Algebra (Polynomial k) Q₂ := (ψ₁_hom.comp f_et).toAlgebra
    letI : Algebra (Polynomial k) Q₂ := alg_Q₂
    let Ψ₁ : S_gx →ₐ[Polynomial k] Q₂ :=
      { ψ₁_hom with commutes' := fun _ => rfl }
    let Ψ₂ : S_gx →ₐ[Polynomial k] Q₂ :=
      { ψ₂_hom with commutes' := fun p => congrArg (fun g : Polynomial k →+* Q₂ => g p) h_fet_eq.symm }
    have hmod_Ibar :
        (Ideal.Quotient.mkₐ (Polynomial k) I_bar).comp Ψ₁ =
          (Ideal.Quotient.mkₐ (Polynomial k) I_bar).comp Ψ₂ := by
      apply AlgHom.coe_ringHom_injective
      apply IsLocalization.ringHom_ext (Submonoid.powers g_x)
      ext r
      change Ideal.Quotient.mk I_bar (ψ₁_hom (algebraMap B₀ S_gx r)) =
        Ideal.Quotient.mk I_bar (ψ₂_hom (algebraMap B₀ S_gx r))
      simp only [ψ₁_hom, ψ₂_hom, RingHom.comp_apply, loc_away, ev_away, IsLocalization.Away.lift_eq]
      apply Ideal.Quotient.eq.mpr
      rw [← map_sub, ← map_sub]
      apply Ideal.mem_map_of_mem q₂
      rw [← hmap_𝔪]
      apply Ideal.mem_map_of_mem ι_loc
      rw [← hev_ker, RingHom.mem_ker, map_sub]
      have hφ_ev : ev_x (φ_k (ev_x r)) = ev_x r :=
        congrArg (fun g : k →+* k => g (ev_x r)) hev_id
      rw [hφ_ev, sub_self]
    have hΨ_eq : Ψ₁ = Ψ₂ := Algebra.FormallyUnramified.comp_injective I_bar hIbar_sq hmod_Ibar
    have h𝔪_le_J : 𝔪_loc ≤ J := by
      rw [← hmap_𝔪, Ideal.map_le_iff_le_comap]
      intro m hm
      rw [Ideal.mem_comap, ← Ideal.Quotient.eq_zero_iff_mem]
      have hm_ev : ev_x m = 0 := by rwa [← hev_ker] at hm
      have h1 : Ψ₁ (algebraMap B₀ S_gx m) = Ψ₂ (algebraMap B₀ S_gx m) :=
        congrArg (fun Φ : S_gx →ₐ[Polynomial k] Q₂ => Φ (algebraMap B₀ S_gx m)) hΨ_eq
      change q₂ (loc_away (algebraMap B₀ S_gx m)) =
        q₂ (ι_loc (φ_k (ev_away (algebraMap B₀ S_gx m)))) at h1
      rw [IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq, hm_ev, map_zero, map_zero,
        map_zero] at h1
      exact h1
    have hev_zt_eq : ev_x z_tilde = ev_x z_x := by
      have hmem : z_tilde - z_x ∈ RingHom.ker ev_x := by
        rw [hev_ker]
        exact Ideal.pow_le_self (by decide : 2 ≠ 0) hzt_sq
      rw [RingHom.mem_ker, map_sub] at hmem
      exact sub_eq_zero.mp hmem
    have hu_sub_π₀ : u_x - π₀ = z_tilde - z_x := by
      dsimp [u_x, π₀]
      rw [hev_zt_eq]
      ring
    have hπ₀_mem : ι_loc π₀ ∈ Ideal.span ({ι_loc u_x} : Set R_loc) ⊔ 𝔪_loc ^ 2 := by
      have hπ_b0 : π₀ = u_x - (z_tilde - z_x) := by
        rw [← hu_sub_π₀]; ring
      have hπ_eq : ι_loc π₀ = ι_loc u_x - ι_loc (z_tilde - z_x) := by
        rw [hπ_b0, map_sub]
      rw [hπ_eq]
      refine Submodule.sub_mem _ ?_ ?_
      · exact (le_sup_left : Ideal.span ({ι_loc u_x} : Set R_loc) ≤
          Ideal.span ({ι_loc u_x} : Set R_loc) ⊔ 𝔪_loc ^ 2)
          (Ideal.subset_span (Set.mem_singleton _))
      · refine (le_sup_right : 𝔪_loc ^ 2 ≤
          Ideal.span ({ι_loc u_x} : Set R_loc) ⊔ 𝔪_loc ^ 2) ?_
        rw [← hmap_𝔪, ← Ideal.map_pow]
        exact Ideal.mem_map_of_mem ι_loc hzt_sq
    have hJ_le : J ≤ Ideal.span ({ι_loc u_x} : Set R_loc) ⊔ 𝔪_loc • 𝔪_loc := by
      have hsq : 𝔪_loc ^ 2 = 𝔪_loc • 𝔪_loc := by rw [pow_two, Ideal.smul_eq_mul]
      rw [← hsq]
      exact sup_le (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπ₀_mem)) le_sup_right
    have hNak_in : 𝔪_loc ≤ Ideal.span ({ι_loc u_x} : Set R_loc) ⊔ 𝔪_loc • 𝔪_loc :=
      h𝔪_le_J.trans hJ_le
    have h𝔪_le_span : 𝔪_loc ≤ Ideal.span ({ι_loc u_x} : Set R_loc) :=
      Submodule.le_of_le_smul_of_le_jacobson_bot
        (Ideal.FG.of_isNoetherianRing 𝔪_loc)
        (IsLocalRing.maximalIdeal_le_jacobson ⊥)
        hNak_in
    intro a ha
    have ha_span : ι_loc a ∈ Ideal.span ({ι_loc u_x} : Set R_loc) := by
      apply h𝔪_le_span
      rw [← hmap_𝔪]
      exact Ideal.mem_map_of_mem ι_loc ha
    rw [Ideal.mem_span_singleton] at ha_span
    rcases ha_span with ⟨r_q, hr_q⟩
    obtain ⟨⟨q₁, s₁⟩, hs₁_eq⟩ := IsLocalization.surj 𝔪_x.primeCompl r_q
    have hloc_eq : ι_loc (s₁.1 * a) = ι_loc (u_x * q₁) := by
      calc
        ι_loc (s₁.1 * a) = ι_loc a * ι_loc s₁.1 := by rw [map_mul, mul_comm]
        _ = (ι_loc u_x * r_q) * ι_loc s₁.1 := by rw [hr_q]
        _ = ι_loc u_x * (r_q * ι_loc s₁.1) := mul_assoc _ _ _
        _ = ι_loc u_x * ι_loc q₁ := by rw [hs₁_eq]
        _ = ι_loc (u_x * q₁) := (map_mul _ _ _).symm
    obtain ⟨s₂, hs₂_eq⟩ := (IsLocalization.eq_iff_exists 𝔪_x.primeCompl R_loc).mp hloc_eq
    refine ⟨(s₂ * s₁).1, s₂.1 * q₁, (s₂ * s₁).2, ?_⟩
    calc
      (s₂.1 * s₁.1) * a = s₂.1 * (s₁.1 * a) := mul_assoc _ _ _
      _ = s₂.1 * (u_x * q₁) := hs₂_eq
      _ = u_x * (s₂.1 * q₁) := by ring

  
  
  
