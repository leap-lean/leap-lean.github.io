               W₀ →+* TensorProduct R₁ R₃ (B₁ m))),
            (let _ : CommRing L.1 := L.2.1
             let _ : Algebra R₁ L.1 := L.2.2.1
             let _ : Algebra L.1 Ω := L.2.2.2.2.1
             let _ : IsScalarTower R₁ L.1 Ω := L.2.2.2.2.2.1.down
             L.2.2.2.2.2.2.comp (algebraMap B₀ W₀) =
               (Algebra.TensorProduct.includeRight : B₁ m →ₐ[R₁] TensorProduct R₁ L.1 (B₁ m)).toRingHom.comp (b₁_hom m) ∧
             (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ L.1 Ω) (AlgHom.id R₁ (B₁ m))).toRingHom.comp
               L.2.2.2.2.2.2 = α₀) := by
        intro m W₀ _ _ _ α₀ hα₀
        obtain ⟨R₃, hCR₃, hAlg₁₃, hAlg₂₃, hTow₁₂₃, hEt₂₃, hAlg₃Ω, _, hTow₁₃Ω, α_tilde, hB, hSp⟩ :=
          (h2bc m).1 R₁ W₀ α₀ hα₀
        have hEt₁₃ : @Algebra.Etale R₁ R₃ _ hCR₃ hAlg₁₃ :=
          @Algebra.Etale.comp R₁ R₁ R₃ _ _ (Algebra.id R₁) hCR₃ hAlg₁₃ hAlg₂₃ hTow₁₂₃
