        funext i
        have hi : i = 0 := Fin.eq_zero i
        subst hi
        apply Subtype.ext
        exact (congrArg (m₀ ≫ ·) hπ00).trans (CategoryTheory.Category.comp_id m₀)
    | succ q ih =>
      constructor
      · intro m₁ m₂ hm
        have hm_fst : m₁.1 ≫ fst_q q = m₂.1 ≫ fst_q q := by
          have hsub : (⟨m₁.1 ≫ fst_q q, by rw [CategoryTheory.Category.assoc, hFstH q, m₁.2]⟩ :
              { m : T ⟶ Z_q q // m ≫ h_q q = g_U }) =
              ⟨m₂.1 ≫ fst_q q, by rw [CategoryTheory.Category.assoc, hFstH q, m₂.2]⟩ := by
            apply ih.1
            funext j
            apply Subtype.ext
            have hj := congrArg Subtype.val (congrFun hm j.castSucc)
            dsimp only at hj ⊢
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              ← hStepCast q j]
            exact hj
          exact congrArg Subtype.val hsub
        have hm_snd : m₁.1 ≫ π_q (q + 1) (Fin.last (q + 1)) =
            m₂.1 ≫ π_q (q + 1) (Fin.last (q + 1)) :=
          congrArg Subtype.val (congrFun hm (Fin.last (q + 1)))
        exact Subtype.ext ((hStepPB q).hom_ext hm_fst hm_snd)
      · intro k
        obtain ⟨m_prev, hm_prev⟩ := ih.2 (fun j => k j.castSucc)
        have hcond : m_prev.1 ≫ h_q q = (k (Fin.last (q + 1))).1 ≫ w₀ :=
          m_prev.2.trans (k (Fin.last (q + 1))).2.symm
        let l : T ⟶ Z_q (q + 1) := (hStepPB q).lift m_prev.1 (k (Fin.last (q + 1))).1 hcond
        have hl_fst : l ≫ fst_q q = m_prev.1 := (hStepPB q).lift_fst _ _ _
        have hl_snd : l ≫ π_q (q + 1) (Fin.last (q + 1)) = (k (Fin.last (q + 1))).1 :=
          (hStepPB q).lift_snd _ _ _
        have hl_h : l ≫ h_q (q + 1) = g_U := by
          rw [← hFstH q, ← CategoryTheory.Category.assoc, hl_fst, m_prev.2]
        refine ⟨⟨l, hl_h⟩, ?_⟩
        funext i
        refine Fin.lastCases ?_ ?_ i
        · exact Subtype.ext hl_snd
        · intro j
          apply Subtype.ext
          dsimp only
          rw [hStepCast q j, ← CategoryTheory.Category.assoc, hl_fst]
          exact congrArg Subtype.val (congrFun hm_prev j)
  have hUniv : ∀ (q : ℕ) (S : Type u) [CommRing S] [Algebra A S],
      Function.Bijective (fun (f : R q →ₐ[A] S) (i : Fin (q + 1)) => f.comp (ι q i)) := by
    intro q S _ _
    let S_cat : CommRingCat.{u} := CommRingCat.of S
    let toRing : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
        (AlgebraicGeometry.Spec S_cat ⟶ Y) → (Y.presheaf.obj (Opposite.op ⊤) ⟶ S_cat) :=
      fun Y m => m.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso S_cat).hom
    let ofRing : ∀ (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine Y],
        (Y.presheaf.obj (Opposite.op ⊤) ⟶ S_cat) → (AlgebraicGeometry.Spec S_cat ⟶ Y) :=
      fun Y _ ψ => AlgebraicGeometry.Spec.map ψ ≫ Y.isoSpec.inv
    have hToOf : ∀ (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine Y]
        (ψ : Y.presheaf.obj (Opposite.op ⊤) ⟶ S_cat),
        toRing Y (ofRing Y ψ) = ψ := by
      intro Y _ ψ
      have hinv_app : Y.isoSpec.inv.appTop =
          (AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op ⊤))).inv := by
        have hid : Y.toSpecΓ.appTop ≫ Y.isoSpec.inv.appTop = 𝟙 _ := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop,
            AlgebraicGeometry.Scheme.isoSpec_inv_toSpecΓ,
            AlgebraicGeometry.Scheme.Hom.id_appTop]
        rw [AlgebraicGeometry.Scheme.toSpecΓ_appTop] at hid
        have h2 := congrArg
          ((AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op ⊤))).inv ≫ ·) hid
        simpa using h2
      dsimp only [toRing, ofRing]
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Category.assoc, hinv_app,
        AlgebraicGeometry.Scheme.ΓSpecIso_naturality ψ, CategoryTheory.Iso.inv_hom_id_assoc]
    have hOfTo : ∀ (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine Y]
        (m : AlgebraicGeometry.Spec S_cat ⟶ Y),
        ofRing Y (toRing Y m) = m := by
      intro Y _ m
      dsimp only [toRing, ofRing]
      rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.isoSpec_inv_naturality m,
        AlgebraicGeometry.SpecMap_ΓSpecIso_hom S_cat,
        ← AlgebraicGeometry.Scheme.isoSpec_hom, CategoryTheory.Iso.hom_inv_id_assoc]
    have hToComp : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
        (m : AlgebraicGeometry.Spec S_cat ⟶ Y₁) (u : Y₁ ⟶ Y₂),
        toRing Y₂ (m ≫ u) = u.appTop ≫ toRing Y₁ m := by
      intro Y₁ Y₂ m u
      dsimp only [toRing]
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Category.assoc]
    let φ_AS : R_A ⟶ S_cat := CommRingCat.ofHom (algebraMap A S)
    let g_U : AlgebraicGeometry.Spec S_cat ⟶ U₀ := ofRing U₀ φ_AS
    have hg_U : toRing U₀ g_U = φ_AS := hToOf U₀ φ_AS
    let algEquivOver : ∀ (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine Y]
        (p_Y : Y ⟶ U₀),
        (letI : Algebra A ↑(Y.presheaf.obj (Opposite.op ⊤)) := p_Y.appTop.hom.toAlgebra
         (↑(Y.presheaf.obj (Opposite.op ⊤)) →ₐ[A] S) ≃
           { m : AlgebraicGeometry.Spec S_cat ⟶ Y // m ≫ p_Y = g_U }) := by
      intro Y _ p_Y
      letI : Algebra A ↑(Y.presheaf.obj (Opposite.op ⊤)) := p_Y.appTop.hom.toAlgebra
      refine
        { toFun := fun f =>
            ⟨ofRing Y (CommRingCat.ofHom f.toRingHom), by
              have heq : toRing U₀ (ofRing Y (CommRingCat.ofHom f.toRingHom) ≫ p_Y) =
                  toRing U₀ g_U := by
                rw [hToComp, hToOf, hg_U]
                ext a
                exact f.commutes a
              have h1 := congrArg (ofRing U₀) heq
              rwa [hOfTo, hOfTo] at h1⟩
          invFun := fun m =>
            { toRingHom := (toRing Y m.1).hom
              commutes' := fun a => by
                have heq : p_Y.appTop ≫ toRing Y m.1 = φ_AS := by
                  rw [← hToComp, m.2, hg_U]
                exact congrArg (fun ψ : R_A ⟶ S_cat => ψ.hom a) heq }
          left_inv := fun f => by
            ext x
            exact congrArg (fun ψ : Y.presheaf.obj (Opposite.op ⊤) ⟶ S_cat => ψ.hom x)
              (hToOf Y (CommRingCat.ofHom f.toRingHom))
          right_inv := fun m => Subtype.ext (hOfTo Y m.1) }
    haveI : AlgebraicGeometry.IsAffine (Z_q q) := hZ_aff q
    let E_Z : (R q →ₐ[A] S) ≃ { m : AlgebraicGeometry.Spec S_cat ⟶ Z_q q // m ≫ h_q q = g_U } :=
      algEquivOver (Z_q q) (h_q q)
    let E_W : (B →ₐ[A] S) ≃ { k : AlgebraicGeometry.Spec S_cat ⟶ W₀ // k ≫ w₀ = g_U } :=
      algEquivOver W₀ w₀
    let Θ := fun (m : { m : AlgebraicGeometry.Spec S_cat ⟶ Z_q q // m ≫ h_q q = g_U })
        (i : Fin (q + 1)) =>
      (⟨m.1 ≫ π_q q i, by rw [CategoryTheory.Category.assoc, hProjW q i, m.2]⟩ :
        { k : AlgebraicGeometry.Spec S_cat ⟶ W₀ // k ≫ w₀ = g_U })
    have hΘ_bij : Function.Bijective Θ := hSchCopow q (AlgebraicGeometry.Spec S_cat) g_U
    have hConj : (fun (f : R q →ₐ[A] S) (i : Fin (q + 1)) => f.comp (ι q i)) =
        fun f i => E_W.symm (Θ (E_Z f) i) := by
      funext f i
      ext b
      change f ((π_q q i).appTop.hom b) =
        (toRing W₀ (ofRing (Z_q q) (CommRingCat.ofHom f.toRingHom) ≫ π_q q i)).hom b
      rw [hToComp, hToOf]
      rfl
    rw [hConj]
    exact ((Equiv.piCongrRight fun _ => E_W.symm).bijective.comp hΘ_bij).comp E_Z.bijective
  have hFaceCompat : ∀ (q : ℕ) (j : Fin (q + 2)) (i : Fin (q + 1)),
      (δ q j).comp (ι q i) = ι (q + 1) (j.succAbove i) := by
    intro q j i
    ext b
    have happ : (π_q q i).appTop ≫ (Φ.map (weilEtaleCechFace w q j)).appTop =
        (π_q (q + 1) (j.succAbove i)).appTop := by
      dsimp only [π_q]
      rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, ← Φ.map_comp, hFaceProj q j i]
    exact congrArg (fun φ : R_B ⟶ R_cat (q + 1) => φ.hom b) happ
  have hDiffCompat : ∀ (q : ℕ) (u : Additive (Units (R q))),
      weilEtaleCechDiff (weilEtaleKPresheaf X) w q (e_q q u) =
        e_q (q + 1) (Finset.univ.sum fun j : Fin (q + 2) =>
          (-1 : ℤ) ^ (j : ℕ) •
            MonoidHom.toAdditive (Units.map (δ q j).toRingHom.toMonoidHom) u) := by
    intro q u
    dsimp [e_q, weilEtaleCechDiff]
    rw [AddMonoidHom.finsetSum_apply]
    apply Finset.sum_congr rfl
    intro j _
    rw [AddMonoidHom.smul_apply]
    rfl
  exact ⟨A, B, inferInstance, inferInstance, hAlgKA, hAlgAB, R, inferInstance, hAlgAR,
    ι, δ, e_q, hEtKA, hEtAB, hSurjComap, hUniv, hFaceCompat, hDiffCompat⟩

theorem weil_etale_copower_galois_splitting_reduction (K A B : Type u) [Field K] [CommRing A] [CommRing B] [Algebra K A] [Algebra A B]
    (hEtA : Algebra.Etale K A) (hEtB : Algebra.Etale A B)
    (hSurj : Function.Surjective (PrimeSpectrum.comap (algebraMap A B)))
    (R : ℕ → Type u) [∀ q : ℕ, CommRing (R q)] [∀ q : ℕ, Algebra A (R q)]
    (ι : ∀ q : ℕ, Fin (q + 1) → (B →ₐ[A] R q))
    (δ : ∀ q : ℕ, Fin (q + 2) → (R q →ₐ[A] R (q + 1)))
    (hUniv : ∀ (q : ℕ) (S : Type u) [CommRing S] [Algebra A S],
      Function.Bijective (fun (f : R q →ₐ[A] S) (i : Fin (q + 1)) => f.comp (ι q i)))
    (hFace : ∀ (q : ℕ) (j : Fin (q + 2)) (i : Fin (q + 1)),
      (δ q j).comp (ι q i) = ι (q + 1) (j.succAbove i))
    (p : ℕ)
    (hSplitVan : ∀ (E L : Type u) [Field E] [Field L]
      [Algebra K E] [FiniteDimensional K E]
      [Algebra E L] [FiniteDimensional E L] [IsGalois E L]
      (X : Type u) [Fintype X] [Nonempty X] [MulAction Gal(L/E) X]
      (c_X : (Fin (p + 2) → X) → Additive Lˣ),
      (∀ (g : Gal(L/E)) (α : Fin (p + 2) → X),
        MonoidHom.toAdditive (Units.map g.toRingHom.toMonoidHom) (c_X (fun i => g⁻¹ • α i)) =
          c_X α) →
      (∀ α : Fin (p + 3) → X,
        (Finset.univ.sum fun j : Fin (p + 3) => (-1 : ℤ) ^ (j : ℕ) • c_X (α ∘ j.succAbove)) = 0) →
      ∃ b_X : (Fin (p + 1) → X) → Additive Lˣ,
        (∀ (g : Gal(L/E)) (α : Fin (p + 1) → X),
          MonoidHom.toAdditive (Units.map g.toRingHom.toMonoidHom) (b_X (fun i => g⁻¹ • α i)) =
            b_X α) ∧
        (∀ α : Fin (p + 2) → X,
          (Finset.univ.sum fun j : Fin (p + 2) => (-1 : ℤ) ^ (j : ℕ) • b_X (α ∘ j.succAbove)) =
            c_X α))
    (c : Additive (Units (R (p + 1)))) :
    (Finset.univ.sum fun j : Fin ((p + 1) + 2) =>
      (-1 : ℤ) ^ (j : ℕ) • MonoidHom.toAdditive (Units.map (δ (p + 1) j).toRingHom.toMonoidHom) c) = 0 →
    ∃ b : Additive (Units (R p)),
      (Finset.univ.sum fun j : Fin (p + 2) =>
        (-1 : ℤ) ^ (j : ℕ) • MonoidHom.toAdditive (Units.map (δ p j).toRingHom.toMonoidHom) b) = c :=
by
  classical
  intro hc
  
  have hEtSplit : ∀ (F₀ C₀ : Type u) [Field F₀] [CommRing C₀] [Algebra F₀ C₀],
      Algebra.Etale F₀ C₀ →
      ∃ (r : ℕ) (𝔪 : Fin r → Ideal C₀) (_ : ∀ a : Fin r, (𝔪 a).IsMaximal),
        letI : ∀ a : Fin r, Field (C₀ ⧸ 𝔪 a) := fun a => Ideal.Quotient.field (𝔪 a)
        (∀ a : Fin r, FiniteDimensional F₀ (C₀ ⧸ 𝔪 a)) ∧
        (∀ a : Fin r, Algebra.IsSeparable F₀ (C₀ ⧸ 𝔪 a)) ∧
        Function.Bijective (fun (x : C₀) (a : Fin r) => Ideal.Quotient.mk (𝔪 a) x) := by
    intro F₀ C₀ _ _ _ hEt₀
    obtain ⟨I, hFinI, Ci, hFieldCi, hAlgCi, e_I, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod F₀ C₀).mp hEt₀
    letI : Finite I := hFinI
    letI : ∀ i : I, Field (Ci i) := hFieldCi
    letI : ∀ i : I, Algebra F₀ (Ci i) := hAlgCi
    obtain ⟨r, ⟨eqv_symm⟩⟩ := Finite.exists_equiv_fin I
    let eqv : Fin r ≃ I := eqv_symm.symm
    let π : ∀ a : Fin r, C₀ →ₐ[F₀] Ci (eqv a) :=
      fun a => (Pi.evalAlgHom F₀ Ci (eqv a)).comp e_I.toAlgHom
    have hπ_surj : ∀ a : Fin r, Function.Surjective (π a) := by
      intro a y
      refine ⟨e_I.symm (Function.update 0 (eqv a) y), ?_⟩
      change e_I (e_I.symm (Function.update 0 (eqv a) y)) (eqv a) = y
      rw [e_I.apply_symm_apply, Function.update_self]
    let 𝔪 : Fin r → Ideal C₀ := fun a => RingHom.ker (π a)
    have hMax : ∀ a : Fin r, (𝔪 a).IsMaximal :=
      fun a => RingHom.ker_isMaximal_of_surjective (π a).toRingHom (hπ_surj a)
    letI : ∀ a : Fin r, Field (C₀ ⧸ 𝔪 a) := fun a => Ideal.Quotient.field (𝔪 a)
    let bar_π : ∀ a : Fin r, (C₀ ⧸ 𝔪 a) ≃ₐ[F₀] Ci (eqv a) :=
      fun a => Ideal.quotientKerAlgEquivOfSurjective (hπ_surj a)
    have hbar_mk : ∀ (a : Fin r) (x : C₀),
        bar_π a (Ideal.Quotient.mk (𝔪 a) x) = e_I x (eqv a) :=
      fun a x => Ideal.quotientKerAlgEquivOfSurjective_mk (hπ_surj a) x
    refine ⟨r, 𝔪, hMax, ?_, ?_, ?_⟩
    · intro a
      haveI : Module.Finite F₀ (Ci (eqv a)) := (hFinSep (eqv a)).1
      exact Module.Finite.equiv (bar_π a).symm.toLinearEquiv
    · intro a
      haveI : Algebra.IsSeparable F₀ (Ci (eqv a)) := (hFinSep (eqv a)).2
      exact AlgEquiv.Algebra.isSeparable (bar_π a).symm
    · constructor
      · intro x y hxy
        apply e_I.injective
        ext i
        have ha := congrFun hxy (eqv.symm i)
        have h1 := congrArg (bar_π (eqv.symm i)) ha
        rw [hbar_mk, hbar_mk, eqv.apply_symm_apply] at h1
        exact h1
      · intro w
        let v : ∀ i : I, Ci i := (Equiv.piCongrLeft Ci eqv) (fun a => bar_π a (w a))
        refine ⟨e_I.symm v, ?_⟩
        ext a
        apply (bar_π a).injective
        rw [hbar_mk, e_I.apply_symm_apply]
        exact Equiv.piCongrLeft_apply_apply Ci eqv (fun b => bar_π b (w b)) a

  
  have hCopowDim : ∀ (E B' : Type u) [Field E] [CommRing B'] [Algebra E B'] [FiniteDimensional E B']
      (R' : ℕ → Type u) [∀ q : ℕ, CommRing (R' q)] [∀ q : ℕ, Algebra E (R' q)]
      (ι' : ∀ q : ℕ, Fin (q + 1) → (B' →ₐ[E] R' q)),
      (∀ (q : ℕ) (S : Type u) [CommRing S] [Algebra E S],
        Function.Bijective (fun (f : R' q →ₐ[E] S) (i : Fin (q + 1)) => f.comp (ι' q i))) →
      ∀ q : ℕ, FiniteDimensional E (R' q) ∧ Module.finrank E (R' q) = (Module.finrank E B') ^ (q + 1) := by
    intro E B' _ _ _ _ R' _ _ ι' hUniv' q
    induction q with
    | zero =>
      let ψ₀ : B' →ₐ[E] R' 0 := ι' 0 0
      obtain ⟨φ₀, hφ₀⟩ := (hUniv' 0 B').2 (fun _ => AlgHom.id E B')
      have hφψ : φ₀.comp ψ₀ = AlgHom.id E B' := congrFun hφ₀ 0
      have hψφ : ψ₀.comp φ₀ = AlgHom.id E (R' 0) := by
        apply (hUniv' 0 (R' 0)).1
        funext i
        have hi : i = 0 := Fin.ext (Nat.lt_one_iff.mp i.isLt)
        rw [hi]
        change (ψ₀.comp φ₀).comp ψ₀ = (AlgHom.id E (R' 0)).comp ψ₀
        rw [AlgHom.comp_assoc, hφψ, AlgHom.comp_id, AlgHom.id_comp]
      let e₀ : R' 0 ≃ₐ[E] B' := AlgEquiv.ofAlgHom φ₀ ψ₀ hφψ hψφ
      refine ⟨Module.Finite.equiv e₀.symm.toLinearEquiv, ?_⟩
      rw [e₀.toLinearEquiv.finrank_eq, pow_one]
    | succ q ih =>
      letI : FiniteDimensional E (R' q) := ih.1
      let T : Type u := TensorProduct E (R' q) B'
      obtain ⟨α_q, hα_q⟩ := (hUniv' q (R' (q + 1))).2 (fun i => ι' (q + 1) i.castSucc)
      have hα_i : ∀ i : Fin (q + 1), α_q.comp (ι' q i) = ι' (q + 1) i.castSucc :=
        congrFun hα_q
      let β_q : B' →ₐ[E] R' (q + 1) := ι' (q + 1) (Fin.last (q + 1))
      let ψ : T →ₐ[E] R' (q + 1) := Algebra.TensorProduct.productMap α_q β_q
      have hψ_left : ψ.comp Algebra.TensorProduct.includeLeft = α_q :=
        Algebra.TensorProduct.productMap_left α_q β_q
      have hψ_right : ψ.comp Algebra.TensorProduct.includeRight = β_q :=
        Algebra.TensorProduct.productMap_right α_q β_q
      let τ : Fin (q + 2) → (B' →ₐ[E] T) :=
        Fin.lastCases Algebra.TensorProduct.includeRight
          (fun i => (Algebra.TensorProduct.includeLeft : R' q →ₐ[E] T).comp (ι' q i))
      obtain ⟨φ, hφ⟩ := (hUniv' (q + 1) T).2 τ
      have hφ_k : ∀ k : Fin (q + 2), φ.comp (ι' (q + 1) k) = τ k :=
        congrFun hφ
      have hψφ : ψ.comp φ = AlgHom.id E (R' (q + 1)) := by
        apply (hUniv' (q + 1) (R' (q + 1))).1
        funext k
        refine Fin.lastCases ?_ ?_ k
        · change (ψ.comp φ).comp (ι' (q + 1) (Fin.last (q + 1))) =
            (AlgHom.id E (R' (q + 1))).comp (ι' (q + 1) (Fin.last (q + 1)))
          rw [AlgHom.comp_assoc, hφ_k (Fin.last (q + 1)), AlgHom.id_comp]
          dsimp only [τ]
          rw [Fin.lastCases_last, hψ_right]
        · intro i
          change (ψ.comp φ).comp (ι' (q + 1) i.castSucc) =
            (AlgHom.id E (R' (q + 1))).comp (ι' (q + 1) i.castSucc)
          rw [AlgHom.comp_assoc, hφ_k i.castSucc, AlgHom.id_comp]
          dsimp only [τ]
          rw [Fin.lastCases_castSucc, ← AlgHom.comp_assoc, hψ_left, hα_i i]
      have hφ_α : φ.comp α_q = (Algebra.TensorProduct.includeLeft : R' q →ₐ[E] T) := by
        apply (hUniv' q T).1
        funext i
        dsimp only
        rw [AlgHom.comp_assoc, hα_i i, hφ_k i.castSucc]
        dsimp only [τ]
        rw [Fin.lastCases_castSucc]
      have hφ_β : φ.comp β_q = (Algebra.TensorProduct.includeRight : B' →ₐ[E] T) := by
        dsimp only [β_q]
        rw [hφ_k (Fin.last (q + 1))]
        dsimp only [τ]
        rw [Fin.lastCases_last]
      have hφψ : φ.comp ψ = AlgHom.id E T := by
        apply Algebra.TensorProduct.ext'
        intro x b
        change φ (Algebra.TensorProduct.productMap α_q β_q (x ⊗ₜ[E] b)) = x ⊗ₜ[E] b
        rw [Algebra.TensorProduct.productMap_apply_tmul, map_mul,
          show φ (α_q x) = (φ.comp α_q) x from rfl,
          show φ (β_q b) = (φ.comp β_q) b from rfl,
          hφ_α, hφ_β]
        change (x ⊗ₜ[E] (1 : B')) * ((1 : R' q) ⊗ₜ[E] b) = x ⊗ₜ[E] b
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      let e_succ : R' (q + 1) ≃ₐ[E] T := AlgEquiv.ofAlgHom φ ψ hφψ hψφ
      refine ⟨Module.Finite.equiv e_succ.symm.toLinearEquiv, ?_⟩
      rw [e_succ.toLinearEquiv.finrank_eq, Module.finrank_tensorProduct, ih.2, ← pow_succ]

  
  have hDedekindDescent : ∀ (E L M Y : Type u) [Field E] [Field L]
      [Algebra E L] [FiniteDimensional E L] [IsGalois E L]
      [CommRing M] [Algebra E M] [FiniteDimensional E M]
      [Fintype Y] [MulAction Gal(L/E) Y]
      (ev : Y → (M →ₐ[E] L)),
      Function.Injective ev →
      Fintype.card Y = Module.finrank E M →
      (∀ (g : Gal(L/E)) (y : Y) (m : M), g (ev (g⁻¹ • y) m) = ev y m) →
      Function.Injective (fun (u : Additive Mˣ) (y : Y) =>
        MonoidHom.toAdditive (Units.map (ev y).toRingHom.toMonoidHom) u) ∧
      (∀ (u : Additive Mˣ) (g : Gal(L/E)) (y : Y),
        MonoidHom.toAdditive (Units.map g.toRingHom.toMonoidHom)
          (MonoidHom.toAdditive (Units.map (ev (g⁻¹ • y)).toRingHom.toMonoidHom) u) =
        MonoidHom.toAdditive (Units.map (ev y).toRingHom.toMonoidHom) u) ∧
      (∀ u_Y : Y → Additive Lˣ,
        (∀ (g : Gal(L/E)) (y : Y),
          MonoidHom.toAdditive (Units.map g.toRingHom.toMonoidHom) (u_Y (g⁻¹ • y)) = u_Y y) →
        ∃ u : Additive Mˣ,
          (fun y : Y => MonoidHom.toAdditive (Units.map (ev y).toRingHom.toMonoidHom) u) = u_Y) := by
    intro E L M Y _ _ _ _ _ _ _ _ _ _ ev hev hcard hequiv
    let bM₀ := Module.Free.chooseBasis E M
    have hcard_idx : Fintype.card (Module.Free.ChooseBasisIndex E M) = Fintype.card Y :=
      (Module.finrank_eq_card_chooseBasisIndex E M).symm.trans hcard.symm
    let bM : Module.Basis Y E M := bM₀.reindex (Fintype.equivOfCardEq hcard_idx)
    let B : Matrix Y Y L := fun y₁ y₂ => ev y₁ (bM y₂)
    have hLI : LinearIndependent L (fun y₁ : Y => (ev y₁).toLinearMap) :=
      (linearIndependent_algHom_toLinearMap E M L).comp ev hev
    have hVecInj : Function.Injective (fun v : Y → L => Matrix.vecMul v B) := by
      intro c₁ c₂ hc
      dsimp only at hc
      have hc0 : Matrix.vecMul (c₁ - c₂) B = 0 := by
        rw [Matrix.sub_vecMul, hc, sub_self]
      have hΛ : (∑ y₁ : Y, (c₁ - c₂) y₁ • (ev y₁).toLinearMap) = 0 := by
        apply bM.ext
        intro y₂
        rw [LinearMap.sum_apply, LinearMap.zero_apply]
        simp only [LinearMap.smul_apply, AlgHom.toLinearMap_apply, smul_eq_mul]
        exact congrFun hc0 y₂
      have hsub0 : ∀ y₁ : Y, (c₁ - c₂) y₁ = 0 :=
        Fintype.linearIndependent_iff.mp hLI (c₁ - c₂) hΛ
      ext y₁
      exact sub_eq_zero.mp (hsub0 y₁)
    have hIsUnitB : IsUnit B := Matrix.vecMul_injective_iff_isUnit.mp hVecInj
    have hMulVecInj : Function.Injective B.mulVec := Matrix.mulVec_injective_iff_isUnit.mpr hIsUnitB
    have hLinInj : Function.Injective (Matrix.mulVecLin B) := hMulVecInj
    have hMulVecSurj : Function.Surjective B.mulVec :=
      LinearMap.injective_iff_surjective.mp hLinInj
    let evalRing : M →+* (Y → L) := Pi.ringHom (fun y => (ev y).toRingHom)
    have heval_eq : ∀ m : M, evalRing m = B.mulVec (fun y₂ => algebraMap E L (bM.repr m y₂)) := by
      intro m
      ext y₁
      change ev y₁ m = ∑ y₂ : Y, ev y₁ (bM y₂) * algebraMap E L (bM.repr m y₂)
      conv_lhs => rw [← bM.sum_repr m]
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro y₂ _
      rw [Algebra.smul_def, map_mul, AlgHom.commutes, mul_comm]
    have heval_inj : Function.Injective evalRing := by
      intro m₁ m₂ hm
      rw [heval_eq m₁, heval_eq m₂] at hm
      have hrepr_L := hMulVecInj hm
      apply bM.repr.injective
      ext y₂
      exact (algebraMap E L).injective (congrFun hrepr_L y₂)
    have hRingDesc : ∀ f : Y → L,
        (∀ (g : Gal(L/E)) (y₁ : Y), g (f (g⁻¹ • y₁)) = f y₁) →
        ∃ m : M, evalRing m = f := by
      intro f hf
      obtain ⟨x, hx⟩ := hMulVecSurj f
      have hx_fixed : ∀ (y₂ : Y) (g : Gal(L/E)), g (x y₂) = x y₂ := by
        intro y₂ g
        have hmul_eq : B.mulVec (fun y => g (x y)) = B.mulVec x := by
          ext y₁
          change (∑ y : Y, ev y₁ (bM y) * g (x y)) = (B.mulVec x) y₁
          have hstep : (∑ y : Y, ev y₁ (bM y) * g (x y)) =
              g (∑ y : Y, ev (g⁻¹ • y₁) (bM y) * x y) := by
            rw [map_sum]
            apply Finset.sum_congr rfl
            intro y _
            rw [map_mul, hequiv g y₁ (bM y)]
          rw [hstep]
          change g ((B.mulVec x) (g⁻¹ • y₁)) = (B.mulVec x) y₁
          rw [hx, hf g y₁]
        exact congrFun (hMulVecInj hmul_eq) y₂
      have hx_mem : ∀ y₂ : Y, x y₂ ∈ Set.range (algebraMap E L) :=
        fun y₂ => (IsGalois.mem_range_algebraMap_iff_fixed (x y₂)).mpr (hx_fixed y₂)
      choose e he using hx_mem
      let m : M := bM.equivFun.symm e
      refine ⟨m, ?_⟩
      rw [heval_eq m]
      have hm_repr : (fun y₂ : Y => algebraMap E L (bM.repr m y₂)) = x := by
        ext y₂
        change algebraMap E L (bM.equivFun m y₂) = x y₂
        rw [bM.equivFun.apply_symm_apply, he y₂]
      rw [hm_repr, hx]
    refine ⟨?_, ?_, ?_⟩
    · intro u₁ u₂ hu
      have hm : evalRing u₁.toMul.val = evalRing u₂.toMul.val := by
        ext y
        exact congrArg (fun z : Additive Lˣ => z.toMul.val) (congrFun hu y)
      exact Additive.toMul.injective (Units.ext (heval_inj hm))
    · intro u g y
      apply Additive.toMul.injective
      apply Units.ext
      exact hequiv g y u.toMul.val
    · intro u_Y hu_Y
      let f_pos : Y → L := fun y => (u_Y y).toMul.val
      let f_inv : Y → L := fun y => (u_Y y).toMul.inv
      have hf_pos : ∀ (g : Gal(L/E)) (y : Y), g (f_pos (g⁻¹ • y)) = f_pos y := by
        intro g y
        exact congrArg (fun z : Additive Lˣ => z.toMul.val) (hu_Y g y)
      have hf_inv : ∀ (g : Gal(L/E)) (y : Y), g (f_inv (g⁻¹ • y)) = f_inv y := by
        intro g y
        exact congrArg (fun z : Additive Lˣ => z.toMul.inv) (hu_Y g y)
      obtain ⟨m_pos, hm_pos⟩ := hRingDesc f_pos hf_pos
      obtain ⟨m_inv, hm_inv⟩ := hRingDesc f_inv hf_inv
      have hmul1 : m_pos * m_inv = 1 := by
        apply heval_inj
        rw [map_mul, map_one, hm_pos, hm_inv]
        ext y
        exact (u_Y y).toMul.val_inv
      have hmul2 : m_inv * m_pos = 1 := by
        apply heval_inj
        rw [map_mul, map_one, hm_inv, hm_pos]
        ext y
        exact (u_Y y).toMul.inv_val
      refine ⟨Additive.ofMul ⟨m_pos, m_inv, hmul1, hmul2⟩, ?_⟩
      funext y
      apply Additive.toMul.injective
      apply Units.ext
      exact congrFun hm_pos y

  
  have hSingleField : ∀ (E B' : Type u) [Field E] [CommRing B']
      [Algebra K E] [FiniteDimensional K E] [Algebra E B'],
      Algebra.Etale E B' → [Nontrivial B'] →
      ∀ (R' : ℕ → Type u) [∀ q : ℕ, CommRing (R' q)] [∀ q : ℕ, Algebra E (R' q)]
        (ι' : ∀ q : ℕ, Fin (q + 1) → (B' →ₐ[E] R' q))
        (δ' : ∀ q : ℕ, Fin (q + 2) → (R' q →ₐ[E] R' (q + 1))),
        (∀ (q : ℕ) (S : Type u) [CommRing S] [Algebra E S],
          Function.Bijective (fun (f : R' q →ₐ[E] S) (i : Fin (q + 1)) => f.comp (ι' q i))) →
        (∀ (q : ℕ) (j : Fin (q + 2)) (i : Fin (q + 1)),
          (δ' q j).comp (ι' q i) = ι' (q + 1) (j.succAbove i)) →
        ∀ (c' : Additive (Units (R' (p + 1)))),
          (Finset.univ.sum fun j : Fin ((p + 1) + 2) =>
            (-1 : ℤ) ^ (j : ℕ) •
              MonoidHom.toAdditive (Units.map (δ' (p + 1) j).toRingHom.toMonoidHom) c') = 0 →
          ∃ b' : Additive (Units (R' p)),
            (Finset.univ.sum fun j : Fin (p + 2) =>
              (-1 : ℤ) ^ (j : ℕ) •
                MonoidHom.toAdditive (Units.map (δ' p j).toRingHom.toMonoidHom) b') = c' := by
    intro E B' _ _ _ _ _ hEtB' _ R' _ _ ι' δ' hUniv' hFace' c' hc'
    obtain ⟨s, 𝔪B, hMaxB, hFinF, hSepF, hBijB⟩ := hEtSplit E B' hEtB'
    let F : Fin s → Type u := fun β => B' ⧸ 𝔪B β
    letI : ∀ β : Fin s, Field (F β) := fun β => Ideal.Quotient.field (𝔪B β)
    letI : ∀ β : Fin s, FiniteDimensional E (F β) := hFinF
    letI : ∀ β : Fin s, Algebra.IsSeparable E (F β) := hSepF
    let e_B' : B' ≃ₐ[E] (∀ β : Fin s, F β) :=
      AlgEquiv.ofBijective (Pi.algHom E F (fun β => Ideal.Quotient.mkₐ E (𝔪B β))) hBijB
    letI : FiniteDimensional E B' := Module.Finite.equiv e_B'.symm.toLinearEquiv
    have hfinrank_B' : Module.finrank E B' = ∑ β : Fin s, Module.finrank E (F β) := by
      rw [e_B'.toLinearEquiv.finrank_eq, Module.finrank_pi_fintype E]
    let pb : ∀ β : Fin s, PowerBasis E (F β) :=
      fun β => Field.powerBasisOfFiniteOfSeparable E (F β)
    let q_poly : Fin s → Polynomial E := fun β => minpoly E (pb β).gen
    have hq_prop : ∀ β : Fin s,
        (q_poly β).Monic ∧ Irreducible (q_poly β) ∧ (q_poly β).Separable := by
      intro β
      have hint : IsIntegral E (pb β).gen := Algebra.IsIntegral.isIntegral (pb β).gen
      exact ⟨minpoly.monic hint, minpoly.irreducible hint,
        Algebra.IsSeparable.isSeparable E (pb β).gen⟩
    let S_min : Finset (Polynomial E) := Finset.univ.image q_poly
    have hS_prop : ∀ f ∈ S_min, f.Monic ∧ Irreducible f ∧ f.Separable := by
      intro f hf
      obtain ⟨β, _, rfl⟩ := Finset.mem_image.mp hf
      exact hq_prop β
    let P : Polynomial E := ∏ f ∈ S_min, f
    have hP_monic : P.Monic :=
      Polynomial.monic_prod_of_monic S_min (fun f => f) (fun f hf => (hS_prop f hf).1)
    have hP_sep : P.Separable := by
      apply Polynomial.separable_prod'
      · intro f hf g hg hfg
        have hf_irr := (hS_prop f hf).2.1
        have hg_irr := (hS_prop g hg).2.1
        rw [Irreducible.coprime_iff_not_dvd hf_irr]
        intro hdvd
        have hdvd' : g ∣ f := Irreducible.dvd_symm hf_irr hg_irr hdvd
        exact hfg (Polynomial.eq_of_monic_of_associated (hS_prop f hf).1 (hS_prop g hg).1
          (associated_of_dvd_dvd hdvd hdvd'))
      · intro f hf
        exact (hS_prop f hf).2.2
    let L : Type u := P.SplittingField
    haveI : FiniteDimensional E L := Polynomial.IsSplittingField.finiteDimensional L P
    haveI : IsGalois E L := IsGalois.of_separable_splitting_field hP_sep
    have hP_splits : (P.map (algebraMap E L)).Splits := Polynomial.IsSplittingField.splits L P
    have hP_map_ne : P.map (algebraMap E L) ≠ 0 := (hP_monic.map (algebraMap E L)).ne_zero
    have hq_splits : ∀ β : Fin s, ((q_poly β).map (algebraMap E L)).Splits := by
      intro β
      have hmem : q_poly β ∈ S_min := Finset.mem_image_of_mem q_poly (Finset.mem_univ β)
      have hdvd : q_poly β ∣ P := Finset.dvd_prod_of_mem (fun f => f) hmem
      exact Polynomial.Splits.of_dvd hP_splits hP_map_ne (Polynomial.map_dvd (algebraMap E L) hdvd)
    
    let P_alg : Type u := ∀ β : Fin s, F β
    let Γ : (Σ β : Fin s, (F β →ₐ[E] L)) → (P_alg →ₐ[E] L) :=
      fun p_hom => p_hom.2.comp (Pi.evalAlgHom E F p_hom.1)
    have hΓ_bij : Function.Bijective Γ := by
      constructor
      · rintro ⟨β₁, φ₁⟩ ⟨β₂, φ₂⟩ h_eq
        by_cases hβ : β₁ = β₂
        · subst hβ
          congr 1
          ext x
          have hx : φ₁ (Pi.single β₁ x β₁) = φ₂ (Pi.single β₁ x β₁) :=
            congrArg (fun ψ : P_alg →ₐ[E] L => ψ (Pi.single β₁ x)) h_eq
          rwa [Pi.single_eq_same] at hx
        · exfalso
          have h1 : φ₁ (Pi.single β₁ 1 β₁) = φ₂ (Pi.single β₁ 1 β₂) :=
            congrArg (fun ψ : P_alg →ₐ[E] L => ψ (Pi.single β₁ 1)) h_eq
          rw [Pi.single_eq_same, map_one, Pi.single_eq_of_ne (Ne.symm hβ), map_zero] at h1
          exact one_ne_zero h1
      · intro ψ
        have hsum1 : (∑ β : Fin s, Pi.single β (1 : F β)) = (1 : P_alg) := by
          ext γ
          rw [Finset.sum_apply, Pi.one_apply, Finset.sum_eq_single γ]
          · exact Pi.single_eq_same γ (1 : F γ)
          · intro β _ hβγ
            exact Pi.single_eq_of_ne (Ne.symm hβγ) (1 : F β)
          · intro hγ
            exact False.elim (hγ (Finset.mem_univ γ))
        have hψ_sum : (∑ β : Fin s, ψ (Pi.single β 1)) = 1 := by
          rw [← map_sum, hsum1, map_one]
        have hex_ne : ∃ β₀ : Fin s, ψ (Pi.single β₀ 1) ≠ 0 := by
          by_contra hall
          push_neg at hall
          rw [Finset.sum_eq_zero (fun β _ => hall β)] at hψ_sum
          exact one_ne_zero hψ_sum.symm
        obtain ⟨β₀, hβ₀_ne⟩ := hex_ne
        have hidem : (Pi.single β₀ (1 : F β₀) : P_alg) * Pi.single β₀ 1 = Pi.single β₀ 1 := by
          ext γ
          rw [Pi.mul_apply]
          by_cases h : γ = β₀
          · subst h; rw [Pi.single_eq_same, mul_one]
          · rw [Pi.single_eq_of_ne h, mul_zero]
        have hψ_idem : ψ (Pi.single β₀ 1) = 1 := by
          apply mul_left_cancel₀ hβ₀_ne
          rw [← map_mul, hidem, mul_one]
        have hψ_proj : ∀ f : P_alg, ψ f = ψ (Pi.single β₀ (f β₀)) := by
          intro f
          have hmul_f : (Pi.single β₀ (1 : F β₀) : P_alg) * f = Pi.single β₀ (f β₀) := by
            ext γ
            rw [Pi.mul_apply]
            by_cases h : γ = β₀
            · subst h; rw [Pi.single_eq_same, Pi.single_eq_same, one_mul]
            · rw [Pi.single_eq_of_ne h, Pi.single_eq_of_ne h, zero_mul]
          rw [← hmul_f, map_mul, hψ_idem, one_mul]
        let φ₀ : F β₀ →ₐ[E] L :=
          { toFun := fun x => ψ (Pi.single β₀ x)
            map_one' := hψ_idem
            map_mul' := fun x y => by
              have hxy : (Pi.single β₀ (x * y) : P_alg) = Pi.single β₀ x * Pi.single β₀ y := by
                ext γ
                rw [Pi.mul_apply]
                by_cases h : γ = β₀
                · subst h; rw [Pi.single_eq_same, Pi.single_eq_same, Pi.single_eq_same]
                · rw [Pi.single_eq_of_ne h, Pi.single_eq_of_ne h, Pi.single_eq_of_ne h, zero_mul]
              rw [hxy, map_mul]
            map_zero' := by
              have hz : (Pi.single β₀ (0 : F β₀) : P_alg) = 0 := Pi.single_zero β₀
              rw [hz, map_zero]
            map_add' := fun x y => by
              rw [Pi.single_add, map_add]
            commutes' := fun e => by
              have he : (Pi.single β₀ (algebraMap E (F β₀) e) : P_alg) =
                  algebraMap E P_alg e * Pi.single β₀ 1 := by
                ext γ
                rw [Pi.mul_apply, Pi.algebraMap_apply]
                by_cases h : γ = β₀
                · subst h; rw [Pi.single_eq_same, Pi.single_eq_same, mul_one]
                · rw [Pi.single_eq_of_ne h, Pi.single_eq_of_ne h, mul_zero]
              rw [he, map_mul, AlgHom.commutes, hψ_idem, mul_one] }
        refine ⟨⟨β₀, φ₀⟩, ?_⟩
        ext f
        exact (hψ_proj f).symm
    letI : ∀ β : Fin s, Fintype (F β →ₐ[E] L) := fun β => PowerBasis.AlgHom.fintype (pb β)
    let X : Type u := (B' →ₐ[E] L)
    let e_X_sig : (Σ β : Fin s, (F β →ₐ[E] L)) ≃ X :=
      (Equiv.ofBijective Γ hΓ_bij).trans
        { toFun := fun ψ => ψ.comp e_B'.toAlgHom
          invFun := fun σ => σ.comp e_B'.symm.toAlgHom
          left_inv := fun ψ => by ext f; simp
          right_inv := fun σ => by ext b; simp }
    letI : Fintype X := Fintype.ofEquiv (Σ β : Fin s, (F β →ₐ[E] L)) e_X_sig
    have hcardX : Fintype.card X = Module.finrank E B' := by
      rw [← Fintype.card_congr e_X_sig, Fintype.card_sigma, hfinrank_B']
      apply Finset.sum_congr rfl
      intro β _
      rw [AlgHom.card_of_powerBasis (pb β) (Algebra.IsSeparable.isSeparable E (pb β).gen)
        (hq_splits β), PowerBasis.finrank]
    have hposB' : 0 < Module.finrank E B' := Module.finrank_pos
    haveI : Nonempty X := Fintype.card_pos_iff.mp (hcardX.symm ▸ hposB')
    letI : MulAction Gal(L/E) X :=
      { smul := fun g σ => g.toAlgHom.comp σ
        one_smul := fun σ => by ext b; rfl
        mul_smul := fun g₁ g₂ σ => by ext b; rfl }
    let Y : ℕ → Type u := fun q => Fin (q + 1) → X
    let copowEquiv : ∀ q : ℕ, (R' q →ₐ[E] L) ≃ Y q :=
      fun q => Equiv.ofBijective _ (hUniv' q L)
    let ev : ∀ q : ℕ, Y q → (R' q →ₐ[E] L) := fun q => (copowEquiv q).symm
    have hev_comp : ∀ (q : ℕ) (α : Y q) (i : Fin (q + 1)),
        (ev q α).comp (ι' q i) = α i :=
      fun q α i => congrFun ((copowEquiv q).apply_symm_apply α) i
    have hequiv : ∀ (q : ℕ) (g : Gal(L/E)) (α : Y q) (m : R' q),
        g (ev q (g⁻¹ • α) m) = ev q α m := by
      intro q g α m
      have h_alg : g.toAlgHom.comp (ev q (g⁻¹ • α)) = ev q α := by
        apply (hUniv' q L).1
        funext i
        dsimp only
        rw [AlgHom.comp_assoc, hev_comp q (g⁻¹ • α) i, hev_comp q α i]
        ext b
        change g (g⁻¹ (α i b)) = α i b
        exact g.apply_symm_apply (α i b)
      exact AlgHom.congr_fun h_alg m
    have hEvFace : ∀ (q : ℕ) (j : Fin (q + 2)) (α : Y (q + 1)),
        (ev (q + 1) α).comp (δ' q j) = ev q (α ∘ j.succAbove) := by
      intro q j α
      apply (hUniv' q L).1
      funext i
      dsimp only
      rw [AlgHom.comp_assoc, hFace' q j i, hev_comp (q + 1) α (j.succAbove i),
        hev_comp q (α ∘ j.succAbove) i]
      rfl
    let evalUHom : ∀ (q : ℕ), Y q → (Additive (R' q)ˣ →+ Additive Lˣ) :=
      fun q α => MonoidHom.toAdditive (Units.map (ev q α).toRingHom.toMonoidHom)
    have hIntertwine : ∀ (q : ℕ) (u : Additive (R' q)ˣ) (α : Y (q + 1)),
        evalUHom (q + 1) α
          (Finset.univ.sum fun j : Fin (q + 2) =>
            (-1 : ℤ) ^ (j : ℕ) •
              MonoidHom.toAdditive (Units.map (δ' q j).toRingHom.toMonoidHom) u) =
        Finset.univ.sum fun j : Fin (q + 2) =>
          (-1 : ℤ) ^ (j : ℕ) • evalUHom q (α ∘ j.succAbove) u := by
      intro q u α
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro j _
      rw [map_zsmul]
      congr 1
      apply Additive.toMul.injective
      apply Units.ext
      exact AlgHom.congr_fun (hEvFace q j α) u.toMul.val
    have hcardY : ∀ q : ℕ, Fintype.card (Y q) = Module.finrank E (R' q) := by
      intro q
      change Fintype.card (Fin (q + 1) → X) = Module.finrank E (R' q)
      rw [Fintype.card_fun, Fintype.card_fin, hcardX, (hCopowDim E B' R' ι' hUniv' q).2]
    letI : ∀ q : ℕ, FiniteDimensional E (R' q) := fun q => (hCopowDim E B' R' ι' hUniv' q).1
    obtain ⟨_, hc_inv, _⟩ := hDedekindDescent E L (R' (p + 1)) (Y (p + 1))
      (ev (p + 1)) (copowEquiv (p + 1)).symm.injective (hcardY (p + 1)) (hequiv (p + 1))
    obtain ⟨_, _, hb_desc⟩ := hDedekindDescent E L (R' p) (Y p)
      (ev p) (copowEquiv p).symm.injective (hcardY p) (hequiv p)
    obtain ⟨heval_inj_p1, _, _⟩ := hDedekindDescent E L (R' (p + 1)) (Y (p + 1))
      (ev (p + 1)) (copowEquiv (p + 1)).symm.injective (hcardY (p + 1)) (hequiv (p + 1))
    let c_X : (Fin (p + 2) → X) → Additive Lˣ := fun α => evalUHom (p + 1) α c'
    have hc_X_inv : ∀ (g : Gal(L/E)) (α : Fin (p + 2) → X),
        MonoidHom.toAdditive (Units.map g.toRingHom.toMonoidHom) (c_X (fun i => g⁻¹ • α i)) =
          c_X α :=
      fun g α => hc_inv c' g α
    have hc_X_cocycle : ∀ α : Fin (p + 3) → X,
        (Finset.univ.sum fun j : Fin (p + 3) => (-1 : ℤ) ^ (j : ℕ) • c_X (α ∘ j.succAbove)) = 0 := by
      intro α
      rw [← hIntertwine (p + 1) c' α, hc', map_zero]
    obtain ⟨b_X, hb_X_inv, hb_X_cob⟩ := hSplitVan E L X c_X hc_X_inv hc_X_cocycle
    obtain ⟨b', hb'⟩ := hb_desc b_X hb_X_inv
    refine ⟨b', heval_inj_p1 ?_⟩
    funext α
    change evalUHom (p + 1) α _ = c_X α
    rw [hIntertwine p b' α]
    have hb'_eval : ∀ β : Y p, evalUHom p β b' = b_X β := congrFun hb'
    simp_rw [hb'_eval]
    exact hb_X_cob α

  
  obtain ⟨r, 𝔪A, hMaxA, hFinE, _, hBijA⟩ := hEtSplit K A hEtA
  let E_f : Fin r → Type u := fun a => A ⧸ 𝔪A a
  letI : ∀ a : Fin r, Field (E_f a) := fun a => Ideal.Quotient.field (𝔪A a)
  letI : ∀ a : Fin r, FiniteDimensional K (E_f a) := hFinE
  let e_A : A ≃ₐ[A] (∀ a : Fin r, E_f a) :=
    AlgEquiv.ofBijective (Algebra.ofId A (∀ a : Fin r, E_f a)) hBijA
  haveI : Algebra.Etale A B := hEtB
  let B_f : Fin r → Type u := fun a => TensorProduct A (E_f a) B
  let R_f : Fin r → ℕ → Type u := fun a q => TensorProduct A (E_f a) (R q)
  let ι_f : ∀ (a : Fin r) (q : ℕ), Fin (q + 1) → (B_f a →ₐ[E_f a] R_f a q) :=
    fun a q i => Algebra.TensorProduct.map (AlgHom.id (E_f a) (E_f a)) (ι q i)
  let δ_f : ∀ (a : Fin r) (q : ℕ), Fin (q + 2) → (R_f a q →ₐ[E_f a] R_f a (q + 1)) :=
    fun a q j => Algebra.TensorProduct.map (AlgHom.id (E_f a) (E_f a)) (δ q j)
  have hNontriv_f : ∀ a : Fin r, Nontrivial (B_f a) := by
    intro a
    haveI : (𝔪A a).IsMaximal := hMaxA a
    let p_a : PrimeSpectrum A := ⟨𝔪A a, inferInstance⟩
    obtain ⟨q_B, hq_B⟩ := hSurj p_a
    have hcomap : Ideal.comap (algebraMap A B) q_B.asIdeal = 𝔪A a :=
      congrArg PrimeSpectrum.asIdeal hq_B
    let D : Type u := B ⧸ q_B.asIdeal
    haveI : IsDomain D := (Ideal.Quotient.isDomain_iff_prime q_B.asIdeal).mpr q_B.isPrime
    let ψ₂ : B →ₐ[A] D := Ideal.Quotient.mkₐ A q_B.asIdeal
    let ψ₁ : E_f a →ₐ[A] D :=
      Ideal.Quotient.liftₐ (𝔪A a) (Algebra.ofId A D) (by
        intro x hx
        rw [← hcomap, Ideal.mem_comap] at hx
        change Ideal.Quotient.mk q_B.asIdeal (algebraMap A B x) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hx)
    exact (Algebra.TensorProduct.productMap ψ₁ ψ₂).toRingHom.domain_nontrivial
  have hUniv_f : ∀ (a : Fin r) (q : ℕ) (S : Type u) [CommRing S] [Algebra (E_f a) S],
      Function.Bijective (fun (f : R_f a q →ₐ[E_f a] S) (i : Fin (q + 1)) => f.comp (ι_f a q i)) := by
    intro a q S _ _
    letI : Algebra A S := ((algebraMap (E_f a) S).comp (algebraMap A (E_f a))).toAlgebra
    haveI : IsScalarTower A (E_f a) S := IsScalarTower.of_algebraMap_eq' rfl
    let adjEquiv : ∀ (M : Type u) [CommRing M] [Algebra A M],
        (TensorProduct A (E_f a) M →ₐ[E_f a] S) ≃ (M →ₐ[A] S) := fun M _ _ =>
      { toFun := fun F => (F.restrictScalars A).comp Algebra.TensorProduct.includeRight
        invFun := fun g =>
          Algebra.TensorProduct.lift (Algebra.ofId (E_f a) S) g (fun _ _ => Commute.all _ _)
        left_inv := fun F => by
          dsimp only
          apply Algebra.TensorProduct.ext
          · exact Algebra.ext_id S _ _
          · exact Algebra.TensorProduct.lift_comp_includeRight _ _ _
        right_inv := fun g => by
          dsimp only
          exact Algebra.TensorProduct.lift_comp_includeRight _ _ _ }
    have hcomp_eq : (fun (F : R_f a q →ₐ[E_f a] S) (i : Fin (q + 1)) => F.comp (ι_f a q i)) =
        (Equiv.piCongrRight (fun _ => (adjEquiv B).symm)) ∘
        (fun (g : R q →ₐ[A] S) (i : Fin (q + 1)) => g.comp (ι q i)) ∘
        (adjEquiv (R q)) := by
      funext F i
      apply (adjEquiv B).injective
      change adjEquiv B (F.comp (ι_f a q i)) =
        adjEquiv B ((adjEquiv B).symm ((adjEquiv (R q) F).comp (ι q i)))
      rw [(adjEquiv B).apply_symm_apply]
      ext b
      change F ((Algebra.TensorProduct.map (AlgHom.id (E_f a) (E_f a)) (ι q i)) (1 ⊗ₜ[A] b)) =
        F (1 ⊗ₜ[A] ι q i b)
      rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
    rw [hcomp_eq]
    exact (Equiv.piCongrRight (fun _ => (adjEquiv B).symm)).bijective.comp
      ((hUniv q S).comp (adjEquiv (R q)).bijective)
  have hFace_f : ∀ (a : Fin r) (q : ℕ) (j : Fin (q + 2)) (i : Fin (q + 1)),
      (δ_f a q j).comp (ι_f a q i) = ι_f a (q + 1) (j.succAbove i) := by
    intro a q j i
    dsimp only [ι_f, δ_f]
    rw [← Algebra.TensorProduct.map_comp, AlgHom.id_comp, hFace q j i]
  
  let θ : ∀ q : ℕ, R q ≃ₐ[A] (∀ a : Fin r, R_f a q) := fun q =>
    (Algebra.TensorProduct.rid A A (R q)).symm.trans
      ((Algebra.TensorProduct.congr AlgEquiv.refl e_A).trans
        ((Algebra.TensorProduct.piRight A A (R q) E_f).trans
          (AlgEquiv.piCongrRight (fun a => Algebra.TensorProduct.comm A (R q) (E_f a)))))
  let π_R : ∀ (q : ℕ) (a : Fin r), R q →+* R_f a q :=
    fun q a => (Algebra.TensorProduct.includeRight : R q →ₐ[A] R_f a q).toRingHom
  have hθ_apply : ∀ (q : ℕ) (x : R q) (a : Fin r), θ q x a = π_R q a x := by
    intro q x a
    change (Algebra.TensorProduct.comm A (R q) (E_f a))
      ((Algebra.TensorProduct.piRight A A (R q) E_f)
        ((Algebra.TensorProduct.congr AlgEquiv.refl e_A) (x ⊗ₜ[A] (1 : A))) a) =
      (1 : E_f a) ⊗ₜ[A] x
    have h1 : (Algebra.TensorProduct.congr (AlgEquiv.refl : R q ≃ₐ[A] R q) e_A)
        (x ⊗ₜ[A] (1 : A)) = x ⊗ₜ[A] (1 : ∀ b : Fin r, E_f b) := by
      simp
    rw [h1, Algebra.TensorProduct.piRight_tmul]
    rfl
  let uEquiv : ∀ q : ℕ, (R q)ˣ ≃* (∀ a : Fin r, (R_f a q)ˣ) :=
    fun q => (Units.mapEquiv (θ q).toRingEquiv.toMulEquiv).trans MulEquiv.piUnits
  let φ_add : ∀ (q : ℕ) (a : Fin r), Additive (R q)ˣ →+ Additive (R_f a q)ˣ :=
    fun q a => MonoidHom.toAdditive (Units.map (π_R q a).toMonoidHom)
  have huEquiv_apply : ∀ (q : ℕ) (u : Additive (R q)ˣ) (a : Fin r),
      uEquiv q u.toMul a = (φ_add q a u).toMul := by
    intro q u a
    apply Units.ext
    exact hθ_apply q u.toMul.val a
  have hφ_inj : ∀ q : ℕ, Function.Injective (fun (u : Additive (R q)ˣ) (a : Fin r) => φ_add q a u) := by
    intro q u₁ u₂ hu
    apply Additive.toMul.injective
    apply (uEquiv q).injective
    funext a
    rw [huEquiv_apply, huEquiv_apply]
    exact congrArg Additive.toMul (congrFun hu a)
  have hφ_δ : ∀ (q : ℕ) (j : Fin (q + 2)) (a : Fin r) (u : Additive (R q)ˣ),
      MonoidHom.toAdditive (Units.map (δ_f a q j).toRingHom.toMonoidHom) (φ_add q a u) =
        φ_add (q + 1) a (MonoidHom.toAdditive (Units.map (δ q j).toRingHom.toMonoidHom) u) := by
    intro q j a u
    apply Additive.toMul.injective
    apply Units.ext
    change (Algebra.TensorProduct.map (AlgHom.id (E_f a) (E_f a)) (δ q j))
      ((1 : E_f a) ⊗ₜ[A] u.toMul.val) = (1 : E_f a) ⊗ₜ[A] (δ q j u.toMul.val)
    rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
  have hex_b_a : ∀ a : Fin r, ∃ b_a : Additive (Units (R_f a p)),
      (Finset.univ.sum fun j : Fin (p + 2) =>
        (-1 : ℤ) ^ (j : ℕ) •
          MonoidHom.toAdditive (Units.map (δ_f a p j).toRingHom.toMonoidHom) b_a) =
      φ_add (p + 1) a c := by
    intro a
    haveI : Nontrivial (B_f a) := hNontriv_f a
    have hc_a : (Finset.univ.sum fun j : Fin ((p + 1) + 2) =>
        (-1 : ℤ) ^ (j : ℕ) •
          MonoidHom.toAdditive (Units.map (δ_f a (p + 1) j).toRingHom.toMonoidHom)
            (φ_add (p + 1) a c)) = 0 := by
      have h0 : φ_add (p + 2) a
          (Finset.univ.sum fun j : Fin ((p + 1) + 2) =>
            (-1 : ℤ) ^ (j : ℕ) •
              MonoidHom.toAdditive (Units.map (δ (p + 1) j).toRingHom.toMonoidHom) c) = 0 := by
        rw [hc, map_zero]
      rw [map_sum] at h0
      rw [← h0]
      apply Finset.sum_congr rfl
      intro j _
      rw [map_zsmul, hφ_δ (p + 1) j a c]
    exact hSingleField (E_f a) (B_f a) inferInstance (R_f a) (ι_f a) (δ_f a)
      (hUniv_f a) (hFace_f a) (φ_add (p + 1) a c) hc_a
  choose b_a hb_a using hex_b_a
  let b : Additive (Units (R p)) :=
    Additive.ofMul ((uEquiv p).symm (fun a => (b_a a).toMul))
  have hb_proj : ∀ a : Fin r, φ_add p a b = b_a a := by
    intro a
    apply Additive.toMul.injective
    rw [← huEquiv_apply p b a]
    change uEquiv p ((uEquiv p).symm (fun a' => (b_a a').toMul)) a = (b_a a).toMul
    rw [(uEquiv p).apply_symm_apply]
  refine ⟨b, hφ_inj (p + 1) ?_⟩
  funext a
  dsimp only
  rw [map_sum]
  have hsum_eq : (Finset.univ.sum fun j : Fin (p + 2) =>
      φ_add (p + 1) a ((-1 : ℤ) ^ (j : ℕ) •
        MonoidHom.toAdditive (Units.map (δ p j).toRingHom.toMonoidHom) b)) =
    Finset.univ.sum fun j : Fin (p + 2) =>
      (-1 : ℤ) ^ (j : ℕ) •
        MonoidHom.toAdditive (Units.map (δ_f a p j).toRingHom.toMonoidHom) (b_a a) := by
    apply Finset.sum_congr rfl
    intro j _
    rw [map_zsmul, ← hφ_δ p j a b, hb_proj a]
  rw [hsum_eq, hb_a a]

theorem weil_galois_semilinear_simplicial_cech_vanishing (E L : Type u) [Field E] [Field L] [Algebra E L] [FiniteDimensional E L] [IsGalois E L]
    (hGalSub : ∀ (F : IntermediateField E L) (n : ℕ),
      1 ≤ n → Subsingleton ↥(groupCohomology (weilGalUnitsRep (↥F) L) n))
    (X : Type u) [Fintype X] [Nonempty X] [MulAction Gal(L/E) X]
    (p : ℕ)
    (c : (Fin (p + 2) → X) → Additive Lˣ)
    (hc_inv : ∀ (g : Gal(L/E)) (α : Fin (p + 2) → X),
      MonoidHom.toAdditive (Units.map g.toRingHom.toMonoidHom) (c (fun i => g⁻¹ • α i)) = c α)
    (hc_cocycle : ∀ α : Fin (p + 3) → X,
      (Finset.univ.sum fun j : Fin (p + 3) => (-1 : ℤ) ^ (j : ℕ) • c (α ∘ j.succAbove)) = 0) :
    ∃ b : (Fin (p + 1) → X) → Additive Lˣ,
      (∀ (g : Gal(L/E)) (α : Fin (p + 1) → X),
        MonoidHom.toAdditive (Units.map g.toRingHom.toMonoidHom) (b (fun i => g⁻¹ • α i)) = b α) ∧
      (∀ α : Fin (p + 2) → X,
        (Finset.univ.sum fun j : Fin (p + 2) => (-1 : ℤ) ^ (j : ℕ) • b (α ∘ j.succAbove)) = c α) :=
by
  classical
  let R : Type u := ULift.{u} ℤ
  let G : Type u := Gal(L/E)
  let M₀ : Rep.{u, u, u} R G := weilGalUnitsRep E L

  have rep_ext : ∀ {H : Type u} [Group H] {A B : Rep.{u, u, u} R H} {u₁ u₂ : A ⟶ B},
      (∀ x : ↥A, u₁.hom x = u₂.hom x) → u₁ = u₂ := by
    intro H _ A B u₁ u₂ h
    let l₁ := @Representation.IntertwiningMap.toLinearMap R H A.V B.V _ _
      A.hV1.toAddCommMonoid B.hV1.toAddCommMonoid A.hV2 B.hV2 A.ρ B.ρ u₁.hom
    let l₂ := @Representation.IntertwiningMap.toLinearMap R H A.V B.V _ _
      A.hV1.toAddCommMonoid B.hV1.toAddCommMonoid A.hV2 B.hV2 A.ρ B.ρ u₂.hom
    ext1
    exact @Representation.IntertwiningMap.ext R H A.V B.V _ _ A.hV1.toAddCommMonoid
      B.hV1.toAddCommMonoid A.hV2 B.hV2 A.ρ B.ρ u₁.hom u₂.hom
      (@LinearMap.ext R R A.V B.V _ _ A.hV1.toAddCommMonoid
        B.hV1.toAddCommMonoid A.hV2 B.hV2 (RingHom.id R) l₁ l₂ fun x => h x)

  
  have hRes : ∀ (S : Subgroup G) (n : ℕ),
      1 ≤ n → Subsingleton ↥(groupCohomology (Rep.res S.subtype M₀) n) := by
    intro S n hn
    let F_S : IntermediateField E L := IntermediateField.fixedField S
    let A_F : Rep.{u, u, u} R Gal(L/↥F_S) := weilGalUnitsRep (↥F_S) L
    let B_S : Rep.{u, u, u} R ↥S := Rep.res S.subtype M₀
    let f_S : ↥S →* Gal(L/↥F_S) :=
      { toFun := fun s =>
          { s.1.toRingEquiv with
            commutes' := fun x => (IntermediateField.mem_fixedField_iff S x.1).mp x.2 s.1 s.2 }
        map_one' := by ext y; rfl
        map_mul' := fun _ _ => by ext y; rfl }
    let g_S : Gal(L/↥F_S) →* ↥S :=
      { toFun := fun τ =>
          ⟨{ τ.toRingEquiv with
              commutes' := fun e => by
                have he : algebraMap E L e = algebraMap (↥F_S) L (algebraMap E (↥F_S) e) :=
                  IsScalarTower.algebraMap_apply E (↥F_S) L e
                rw [he]
                exact τ.commutes (algebraMap E (↥F_S) e) },
            by
              rw [← IntermediateField.fixingSubgroup_fixedField S,
                IntermediateField.mem_fixingSubgroup_iff]
              intro y hy
              exact τ.commutes ⟨y, hy⟩⟩
        map_one' := by ext y; rfl
        map_mul' := fun _ _ => by ext y; rfl }
    let φ : Rep.res g_S B_S ⟶ A_F :=
      Rep.ofHom
        { toLinearMap := LinearMap.id
          isIntertwining' := fun _ => LinearMap.ext fun _ => rfl }
    let ψ : Rep.res f_S A_F ⟶ B_S :=
      Rep.ofHom
        { toLinearMap := LinearMap.id
          isIntertwining' := fun _ => LinearMap.ext fun _ => rfl }
    have h_comp_rep : ((Rep.resFunctor f_S).map φ) ≫ ψ = 𝟙 B_S :=
      rep_ext fun _ => rfl
    have h_map_comp :
        groupCohomology.map g_S φ n ≫ groupCohomology.map f_S ψ n =
          𝟙 (groupCohomology B_S n) := by
      have h1 := groupCohomology.map_comp g_S f_S φ ψ n
      rw [← h1, h_comp_rep]
      exact groupCohomology.map_id n
    have hSubA : Subsingleton ↥(groupCohomology A_F n) := hGalSub F_S n hn
    refine ⟨fun x₁ x₂ => ?_⟩
    have hx : (CategoryTheory.ConcreteCategory.hom (groupCohomology.map g_S φ n)) x₁ =
        (CategoryTheory.ConcreteCategory.hom (groupCohomology.map g_S φ n)) x₂ :=
      hSubA.elim _ _
    have h_eq1 := congrArg (fun m : groupCohomology B_S n ⟶ groupCohomology B_S n =>
      (CategoryTheory.ConcreteCategory.hom m) x₁) h_map_comp
    have h_eq2 := congrArg (fun m : groupCohomology B_S n ⟶ groupCohomology B_S n =>
      (CategoryTheory.ConcreteCategory.hom m) x₂) h_map_comp
    simp only [CategoryTheory.hom_comp, CategoryTheory.hom_id, Function.comp_apply, id_eq]
      at h_eq1 h_eq2
    exact h_eq1.symm.trans ((congrArg _ hx).trans h_eq2)

  have hH_M₀ : ∀ (n : ℕ), 1 ≤ n → Subsingleton ↥(groupCohomology M₀ n) := by
    intro n hn
    let S_top : Subgroup G := ⊤
    let u_top : G →* ↥S_top :=
      { toFun := fun g => ⟨g, Subgroup.mem_top g⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl }
    let φ_top : Rep.res S_top.subtype M₀ ⟶ Rep.res S_top.subtype M₀ := 𝟙 _
    let ψ_top : Rep.res u_top (Rep.res S_top.subtype M₀) ⟶ M₀ :=
      Rep.ofHom
        { toLinearMap := LinearMap.id
          isIntertwining' := fun _ => LinearMap.ext fun _ => rfl }
    have h_comp_top : ((Rep.resFunctor u_top).map φ_top) ≫ ψ_top = 𝟙 M₀ :=
      rep_ext fun _ => rfl
    have h_map_top :
        groupCohomology.map S_top.subtype φ_top n ≫ groupCohomology.map u_top ψ_top n =
          𝟙 (groupCohomology M₀ n) := by
      have h1 := groupCohomology.map_comp S_top.subtype u_top φ_top ψ_top n
      rw [← h1, h_comp_top]
      exact groupCohomology.map_id n
    have hSubTop : Subsingleton ↥(groupCohomology (Rep.res S_top.subtype M₀) n) :=
      hRes S_top n hn
    refine ⟨fun x₁ x₂ => ?_⟩
    have hx : (CategoryTheory.ConcreteCategory.hom (groupCohomology.map S_top.subtype φ_top n)) x₁ =
        (CategoryTheory.ConcreteCategory.hom (groupCohomology.map S_top.subtype φ_top n)) x₂ :=
      hSubTop.elim _ _
    have h_eq1 := congrArg (fun m : groupCohomology M₀ n ⟶ groupCohomology M₀ n =>
      (CategoryTheory.ConcreteCategory.hom m) x₁) h_map_top
    have h_eq2 := congrArg (fun m : groupCohomology M₀ n ⟶ groupCohomology M₀ n =>
      (CategoryTheory.ConcreteCategory.hom m) x₂) h_map_top
    simp only [CategoryTheory.hom_comp, CategoryTheory.hom_id, Function.comp_apply, id_eq]
      at h_eq1 h_eq2
    exact h_eq1.symm.trans ((congrArg _ hx).trans h_eq2)

  
  let funRep : ∀ (Z : Type u) [MulAction G Z], Rep.{u, u, u} R G := fun Z _ =>
    Rep.of
      { toFun := fun g =>
          { toFun := fun (f : Z → ↥M₀) z => M₀.ρ g (f (g⁻¹ • z))
            map_add' := fun f₁ f₂ => funext fun z => map_add (M₀.ρ g) _ _
            map_smul' := fun r f => funext fun z => map_smul (M₀.ρ g) r _ }
        map_one' := LinearMap.ext fun (f : Z → ↥M₀) => funext fun z => by
          change M₀.ρ (1 : G) (f ((1 : G)⁻¹ • z)) = f z
          rw [inv_one, one_smul, map_one]
          rfl
        map_mul' := fun g₁ g₂ => LinearMap.ext fun (f : Z → ↥M₀) => funext fun z => by
          change M₀.ρ (g₁ * g₂) (f ((g₁ * g₂)⁻¹ • z)) = M₀.ρ g₁ (M₀.ρ g₂ (f (g₂⁻¹ • (g₁⁻¹ • z))))
          rw [mul_inv_rev, mul_smul, map_mul]
          rfl }

  have hH_fun : ∀ (m : ℕ) (Z : Type u) [Fintype Z] [MulAction G Z],
      Fintype.card Z = m → ∀ (n : ℕ), 1 ≤ n → Subsingleton ↥(groupCohomology (funRep Z) n) := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
      intro Z _ _ hm n hn
      by_cases hEmp : IsEmpty Z
      · have h_zero_id : (0 : funRep Z ⟶ funRep Z) = 𝟙 (funRep Z) :=
          rep_ext fun _ => funext fun z => IsEmpty.elim hEmp z
        have h_id_zero :
            (0 : groupCohomology (funRep Z) n ⟶ groupCohomology (funRep Z) n) =
              𝟙 (groupCohomology (funRep Z) n) := by
          have h1 : (groupCohomology.functor R G n).map (0 : funRep Z ⟶ funRep Z) = 0 :=
            (groupCohomology.functor R G n).map_zero _ _
          have h2 : (groupCohomology.functor R G n).map (0 : funRep Z ⟶ funRep Z) =
              groupCohomology.map (MonoidHom.id G) (0 : funRep Z ⟶ funRep Z) n :=
            groupCohomology.functor_map R G n (0 : funRep Z ⟶ funRep Z)
          rw [h2, h_zero_id, groupCohomology.map_id] at h1
          exact h1.symm
        refine ⟨fun x₁ x₂ => ?_⟩
        have hx0 : ∀ x : ↥(groupCohomology (funRep Z) n), x = 0 := fun x => by
          have h := congrArg (fun φ : groupCohomology (funRep Z) n ⟶ groupCohomology (funRep Z) n =>
            (ModuleCat.Hom.hom φ) x) h_id_zero.symm
          rwa [ModuleCat.hom_id, LinearMap.id_apply, ModuleCat.hom_zero, LinearMap.zero_apply] at h
        rw [hx0 x₁, hx0 x₂]
      · obtain ⟨z₀⟩ : Nonempty Z := not_isEmpty_iff.mp hEmp
        have horb_smul : ∀ (g : G) (z : Z),
            g • z ∈ MulAction.orbit G z₀ ↔ z ∈ MulAction.orbit G z₀ := by
          intro g z
          rw [MulAction.mem_orbit_iff, MulAction.mem_orbit_iff]
          constructor
          · rintro ⟨k, hk⟩
            refine ⟨g⁻¹ * k, ?_⟩
            rw [mul_smul, hk, inv_smul_smul]
          · rintro ⟨k, rfl⟩
            exact ⟨g * k, mul_smul g k z₀⟩
        let O_set : Type u := { z : Z // z ∈ MulAction.orbit G z₀ }
        let R_set : Type u := { z : Z // z ∉ MulAction.orbit G z₀ }
        letI : MulAction G O_set :=
          { smul := fun g y => ⟨g • y.1, (horb_smul g y.1).mpr y.2⟩
            one_smul := fun y => Subtype.ext (one_smul G y.1)
            mul_smul := fun g₁ g₂ y => Subtype.ext (mul_smul g₁ g₂ y.1) }
        letI : MulAction G R_set :=
          { smul := fun g y => ⟨g • y.1, fun h => y.2 ((horb_smul g y.1).mp h)⟩
            one_smul := fun y => Subtype.ext (one_smul G y.1)
            mul_smul := fun g₁ g₂ y => Subtype.ext (mul_smul g₁ g₂ y.1) }
        have hcard_R : Fintype.card R_set < m := by
          rw [← hm]
          exact Fintype.card_subtype_lt (not_not.mpr (MulAction.mem_orbit_self z₀))
        have hSubR : Subsingleton ↥(groupCohomology (funRep R_set) n) :=
          ih (Fintype.card R_set) hcard_R R_set rfl n hn
        
        let S : Subgroup G := MulAction.stabilizer G z₀
        let A_S : Rep.{u, u, u} R ↥S := Rep.res S.subtype M₀
        let C_S : Rep.{u, u, u} R G := Rep.coind.{u, u, u, u} S.subtype A_S
        have hs_inv_fix : ∀ s : ↥S, s.1⁻¹ • z₀ = z₀ := fun s => by
          have hs : s.1 • z₀ = z₀ := MulAction.mem_stabilizer_iff.mp s.2
          calc
            s.1⁻¹ • z₀ = s.1⁻¹ • (s.1 • z₀) := by rw [hs]
            _ = z₀ := inv_smul_smul s.1 z₀
        have hy_ex : ∀ y : O_set, ∃ k : G, k • z₀ = y.1 :=
          fun y => MulAction.mem_orbit_iff.mp y.2
        let θ_fun : ↥(funRep O_set) → ↥C_S := fun f =>
          ⟨fun g => M₀.ρ g (f ⟨g⁻¹ • z₀, MulAction.mem_orbit_iff.mpr ⟨g⁻¹, rfl⟩⟩), by
            rw [Representation.mem_coindV]
            intro s g
            have hpt : (⟨(S.subtype s * g)⁻¹ • z₀,
                  MulAction.mem_orbit_iff.mpr ⟨(S.subtype s * g)⁻¹, rfl⟩⟩ : O_set) =
                ⟨g⁻¹ • z₀, MulAction.mem_orbit_iff.mpr ⟨g⁻¹, rfl⟩⟩ := by
              apply Subtype.ext
              dsimp [Subgroup.subtype]
              rw [mul_inv_rev, mul_smul, hs_inv_fix s]
            rw [hpt]
            change M₀.ρ (s.1 * g) (f ⟨g⁻¹ • z₀, _⟩) =
              M₀.ρ s.1 (M₀.ρ g (f ⟨g⁻¹ • z₀, _⟩))
            rw [map_mul]
            rfl⟩
        let θ_hom : funRep O_set ⟶ C_S :=
          Rep.ofHom
            { toFun := θ_fun
              map_add' := fun f₁ f₂ => Subtype.ext (funext fun g => (M₀.ρ g).map_add' _ _)
              map_smul' := fun r f => Subtype.ext (funext fun g => (M₀.ρ g).map_smul' r _)
              isIntertwining' := fun g₀ => LinearMap.ext fun f => Subtype.ext (funext fun g => by
                have h_coind : ((C_S.ρ g₀) (θ_fun f)).1 g = (θ_fun f).1 (g * g₀) := by
                  change (((Representation.coind S.subtype A_S.ρ) g₀) (θ_fun f)).1 g = _
                  rw [Representation.coind_apply]
                  rfl
                change (θ_fun ((funRep O_set).ρ g₀ f)).1 g = ((C_S.ρ g₀) (θ_fun f)).1 g
                rw [h_coind]
                dsimp [θ_fun]
                have hpt : (⟨g₀⁻¹ • (g⁻¹ • z₀),
                      (horb_smul g₀⁻¹ (g⁻¹ • z₀)).mpr (MulAction.mem_orbit_iff.mpr ⟨g⁻¹, rfl⟩)⟩ : O_set) =
                    ⟨(g * g₀)⁻¹ • z₀, MulAction.mem_orbit_iff.mpr ⟨(g * g₀)⁻¹, rfl⟩⟩ := by
                  apply Subtype.ext
                  change g₀⁻¹ • (g⁻¹ • z₀) = (g * g₀)⁻¹ • z₀
                  rw [mul_inv_rev, mul_smul]
                change M₀.ρ g (M₀.ρ g₀ (f ⟨g₀⁻¹ • (g⁻¹ • z₀), _⟩)) =
                  M₀.ρ (g * g₀) (f ⟨(g * g₀)⁻¹ • z₀, _⟩)
                rw [hpt, map_mul]
                rfl) }
        let θ_inv_fun : ↥C_S → ↥(funRep O_set) := fun ψ y =>
          M₀.ρ (hy_ex y).choose (ψ.1 (hy_ex y).choose⁻¹)
        have hθ_coset : ∀ (ψ : ↥C_S) (y : O_set) (k : G),
            k • z₀ = y.1 → M₀.ρ k (ψ.1 k⁻¹) = θ_inv_fun ψ y := by
          intro ψ y k hk
          let k₀ := (hy_ex y).choose
          have hk₀ : k₀ • z₀ = y.1 := (hy_ex y).choose_spec
          have hs_mem : k⁻¹ * k₀ ∈ S := by
            rw [MulAction.mem_stabilizer_iff, mul_smul, hk₀, inv_smul_eq_iff, hk]
          have hψ := (Representation.mem_coindV S.subtype A_S.ρ ψ.1).mp ψ.2 ⟨k⁻¹ * k₀, hs_mem⟩ k₀⁻¹
          have hmul1 : S.subtype ⟨k⁻¹ * k₀, hs_mem⟩ * k₀⁻¹ = k⁻¹ := by
            change (k⁻¹ * k₀) * k₀⁻¹ = k⁻¹
            group
          rw [hmul1] at hψ
          change M₀.ρ k (ψ.1 k⁻¹) = M₀.ρ k₀ (ψ.1 k₀⁻¹)
          rw [hψ]
          change (M₀.ρ k * M₀.ρ (k⁻¹ * k₀)) (ψ.1 k₀⁻¹) = M₀.ρ k₀ (ψ.1 k₀⁻¹)
          rw [← map_mul]
          have hmul2 : k * (k⁻¹ * k₀) = k₀ := by group
          rw [hmul2]
        let θ_inv : C_S ⟶ funRep O_set :=
          Rep.ofHom
            { toFun := θ_inv_fun
              map_add' := fun ψ₁ ψ₂ => funext fun y => map_add (M₀.ρ (hy_ex y).choose) _ _
              map_smul' := fun r ψ => funext fun y => map_smul (M₀.ρ (hy_ex y).choose) r _
              isIntertwining' := fun g₀ => LinearMap.ext fun ψ => funext fun y => by
                let y' : O_set := g₀⁻¹ • y
                let k₀ : G := (hy_ex y).choose
                have hk₀ : k₀ • z₀ = y.1 := (hy_ex y).choose_spec
                have h_coind : ((C_S.ρ g₀) ψ).1 k₀⁻¹ = ψ.1 (k₀⁻¹ * g₀) := by
                  change (((Representation.coind S.subtype A_S.ρ) g₀) ψ).1 k₀⁻¹ = _
                  rw [Representation.coind_apply]
                  rfl
                have hk0_g0 : (g₀⁻¹ * k₀) • z₀ = y'.1 := by
                  change (g₀⁻¹ * k₀) • z₀ = g₀⁻¹ • y.1
                  rw [mul_smul, hk₀]
                have hc' := hθ_coset ψ y' (g₀⁻¹ * k₀) hk0_g0
                have hinv_eq : (g₀⁻¹ * k₀)⁻¹ = k₀⁻¹ * g₀ := by group
                rw [hinv_eq] at hc'
                change M₀.ρ k₀ (((C_S.ρ g₀) ψ).1 k₀⁻¹) = M₀.ρ g₀ (θ_inv_fun ψ y')
                rw [h_coind, ← hc']
                change M₀.ρ k₀ (ψ.1 (k₀⁻¹ * g₀)) =
                  (M₀.ρ g₀ * M₀.ρ (g₀⁻¹ * k₀)) (ψ.1 (k₀⁻¹ * g₀))
                rw [← map_mul]
                have hm : g₀ * (g₀⁻¹ * k₀) = k₀ := by group
                rw [hm] }
        let iso_O : funRep O_set ≅ C_S :=
          { hom := θ_hom
            inv := θ_inv
            hom_inv_id := rep_ext fun f => funext fun y => by
              let k₀ : G := (hy_ex y).choose
              change (M₀.ρ k₀ * M₀.ρ k₀⁻¹) (f ⟨(k₀⁻¹)⁻¹ • z₀, _⟩) = f y
              rw [← map_mul, mul_inv_cancel, map_one]
              change f ⟨(k₀⁻¹)⁻¹ • z₀, _⟩ = f y
              congr 1
              apply Subtype.ext
              rw [inv_inv]
              exact (hy_ex y).choose_spec
            inv_hom_id := rep_ext fun ψ => Subtype.ext (funext fun g => by
              let y_g : O_set := ⟨g⁻¹ • z₀, MulAction.mem_orbit_iff.mpr ⟨g⁻¹, rfl⟩⟩
              change M₀.ρ g (θ_inv_fun ψ y_g) = ψ.1 g
              rw [← hθ_coset ψ y_g g⁻¹ rfl, inv_inv]
              change (M₀.ρ g * M₀.ρ g⁻¹) (ψ.1 g) = ψ.1 g
              rw [← map_mul, mul_inv_cancel, map_one]
              rfl) }
        have hSubAS : Subsingleton ↥(groupCohomology A_S n) := hRes S n hn
        have hSubO : Subsingleton ↥(groupCohomology (funRep O_set) n) := by
          let iso_H : groupCohomology (funRep O_set) n ≅ groupCohomology A_S n :=
            ((groupCohomology.functor R G n).mapIso iso_O).trans (groupCohomology.coindIso A_S n)
          refine ⟨fun x₁ x₂ => ?_⟩
          have hx : (CategoryTheory.ConcreteCategory.hom iso_H.hom) x₁ =
              (CategoryTheory.ConcreteCategory.hom iso_H.hom) x₂ :=
            hSubAS.elim _ _
          have h1 := congrArg (fun m : groupCohomology (funRep O_set) n ⟶ groupCohomology (funRep O_set) n =>
            (CategoryTheory.ConcreteCategory.hom m) x₁) iso_H.hom_inv_id
          have h2 := congrArg (fun m : groupCohomology (funRep O_set) n ⟶ groupCohomology (funRep O_set) n =>
            (CategoryTheory.ConcreteCategory.hom m) x₂) iso_H.hom_inv_id
          simp only [CategoryTheory.hom_comp, CategoryTheory.hom_id, Function.comp_apply, id_eq]
            at h1 h2
          exact h1.symm.trans ((congrArg _ hx).trans h2)
        
        let i_O : funRep O_set ⟶ funRep Z :=
          Rep.ofHom
            { toFun := fun f z => if hz : z ∈ MulAction.orbit G z₀ then f ⟨z, hz⟩ else 0
              map_add' := fun f₁ f₂ => funext fun z => by
                by_cases hz : z ∈ MulAction.orbit G z₀ <;> simp [hz]
              map_smul' := fun r f => funext fun z => by
                by_cases hz : z ∈ MulAction.orbit G z₀ <;> simp [hz]
              isIntertwining' := fun g => LinearMap.ext fun f => funext fun z => by
                dsimp [funRep]
                by_cases hz : z ∈ MulAction.orbit G z₀
                · have hz' : g⁻¹ • z ∈ MulAction.orbit G z₀ := (horb_smul g⁻¹ z).mpr hz
                  rw [dif_pos hz, dif_pos hz']
                  rfl
                · have hz' : g⁻¹ • z ∉ MulAction.orbit G z₀ := fun h => hz ((horb_smul g⁻¹ z).mp h)
                  rw [dif_neg hz, dif_neg hz', map_zero] }
        let p_R : funRep Z ⟶ funRep R_set :=
          Rep.ofHom
            { toFun := fun f y => f y.1
              map_add' := fun _ _ => rfl
              map_smul' := fun _ _ => rfl
              isIntertwining' := fun _ => rfl }
        have hi_pc : i_O ≫ p_R = 0 :=
          rep_ext fun _ => funext fun y => dif_neg y.2
        let SC_Z : CategoryTheory.ShortComplex (Rep.{u, u, u} R G) :=
          CategoryTheory.ShortComplex.mk i_O p_R hi_pc
        have : CategoryTheory.Mono SC_Z.f := by
          dsimp [SC_Z]
          rw [Rep.mono_iff_injective]
          intro f₁ f₂ hf
          funext y
          have hy := congrFun hf y.1
          dsimp [i_O] at hy
          rwa [dif_pos y.2, dif_pos y.2] at hy
        have : CategoryTheory.Epi SC_Z.g := by
          dsimp [SC_Z]
          rw [Rep.epi_iff_surjective]
          intro q
          refine ⟨fun z => if hz : z ∈ MulAction.orbit G z₀ then 0 else q ⟨z, hz⟩, ?_⟩
          funext y
          exact dif_neg y.2
        let p_O : funRep Z ⟶ funRep O_set :=
          Rep.ofHom
            { toFun := fun f y => f y.1
              map_add' := fun _ _ => rfl
              map_smul' := fun _ _ => rfl
              isIntertwining' := fun _ => rfl }
        let lift_Z : ∀ {W : Rep.{u, u, u} R G} (k : W ⟶ funRep Z),
            k ≫ p_R = 0 → (W ⟶ funRep O_set) := fun k _ => k ≫ p_O
        have hfac_Z : ∀ {W : Rep.{u, u, u} R G} (k : W ⟶ funRep Z) (hk : k ≫ p_R = 0),
            lift_Z k hk ≫ i_O = k := by
          intro W k hk
          apply rep_ext
          intro w
          funext z
          change (if hz : z ∈ MulAction.orbit G z₀ then k.hom w z else 0) = k.hom w z
          by_cases hz : z ∈ MulAction.orbit G z₀
          · exact dif_pos hz
          · rw [dif_neg hz]
            have hk0 : (k ≫ p_R).hom w ⟨z, hz⟩ = 0 :=
              congrFun (congrArg (fun φ : W ⟶ funRep R_set => φ.hom w) hk) ⟨z, hz⟩
            exact hk0.symm
        have hKer_Z : CategoryTheory.Limits.IsLimit
            (CategoryTheory.Limits.KernelFork.ofι SC_Z.f SC_Z.zero) :=
          CategoryTheory.Limits.KernelFork.IsLimit.ofι SC_Z.f SC_Z.zero
            (fun k hk => lift_Z k hk)
            (fun k hk => hfac_Z k hk)
            (fun k hk m hm => (cancel_mono SC_Z.f).mp (hm.trans (hfac_Z k hk).symm))
        have hSE_Z : SC_Z.ShortExact :=
          { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel SC_Z hKer_Z }
        have hex₂ := groupCohomology.mapShortComplex₂_exact hSE_Z n
        rw [CategoryTheory.ShortComplex.moduleCat_exact_iff] at hex₂
        have hSubX1 : Subsingleton ↥(groupCohomology.mapShortComplex₂ SC_Z n).X₁ := hSubO
        have hSubX3 : Subsingleton ↥(groupCohomology.mapShortComplex₂ SC_Z n).X₃ := hSubR
        refine ⟨fun x₁ x₂ => ?_⟩
        have hx0 : ∀ x : ↥(groupCohomology.mapShortComplex₂ SC_Z n).X₂, x = 0 := fun x => by
          have hg0 : (CategoryTheory.ConcreteCategory.hom
            (groupCohomology.mapShortComplex₂ SC_Z n).g) x = 0 := hSubX3.elim _ _
          obtain ⟨u, hu⟩ := hex₂ x hg0
          have hu0 : u = 0 := hSubX1.elim _ _
          rw [← hu, hu0, map_zero]
        exact (hx0 x₁).trans (hx0 x₂).symm

  
  obtain ⟨x₀⟩ : Nonempty X := inferInstance
  have h_val_succAbove : ∀ {m : ℕ} (r : Fin (m + 1)) (k : Fin m),
      (r.succAbove k).1 = if k.1 < r.1 then k.1 else k.1 + 1 := by
    intro m r k
    by_cases h : k.1 < r.1
    · have hk : k.castSucc < r := h
      rw [if_pos h, Fin.succAbove_of_castSucc_lt r k hk]
      rfl
    · have hk : r ≤ k.castSucc := Nat.le_of_not_lt h
      rw [if_neg h, Fin.succAbove_of_le_castSucc r k hk]
      rfl

  have h_diff_sq : ∀ (q : ℕ) (f : (Fin (q + 1) → X) → ↥M₀) (β : Fin (q + 3) → X),
      (Finset.univ.sum fun j : Fin (q + 3) => (-1 : ℤ) ^ (j : ℕ) •
        (Finset.univ.sum fun i : Fin (q + 2) => (-1 : ℤ) ^ (i : ℕ) •
          f ((β ∘ j.succAbove) ∘ i.succAbove))) = 0 := by
    intro q f β
    have h_prod :
        (Finset.univ.sum fun j : Fin (q + 3) => (-1 : ℤ) ^ (j : ℕ) •
          (Finset.univ.sum fun i : Fin (q + 2) => (-1 : ℤ) ^ (i : ℕ) •
            f ((β ∘ j.succAbove) ∘ i.succAbove))) =
        ∑ p ∈ (Finset.univ : Finset (Fin (q + 3) × Fin (q + 2))),
          ((-1 : ℤ) ^ (p.1.1 + p.2.1)) • f ((β ∘ p.1.succAbove) ∘ p.2.succAbove) := by
      have h_inner : ∀ j : Fin (q + 3),
          (-1 : ℤ) ^ (j : ℕ) •
            (Finset.univ.sum fun i : Fin (q + 2) => (-1 : ℤ) ^ (i : ℕ) •
              f ((β ∘ j.succAbove) ∘ i.succAbove)) =
          Finset.univ.sum fun i : Fin (q + 2) =>
            ((-1 : ℤ) ^ (j.1 + i.1)) • f ((β ∘ j.succAbove) ∘ i.succAbove) := by
        intro j
        rw [Finset.smul_sum]
        apply Finset.sum_congr rfl
        intro i _
        rw [smul_smul, ← pow_add]
      simp_rw [h_inner]
      rw [← Finset.sum_product']
      rfl
    rw [h_prod]
    let τ : Fin (q + 3) × Fin (q + 2) → Fin (q + 3) × Fin (q + 2) := fun p =>
      if h : p.1.1 ≤ p.2.1 then
        (⟨p.2.1 + 1, by omega⟩, ⟨p.1.1, by omega⟩)
      else
        (⟨p.2.1, by omega⟩, ⟨p.1.1 - 1, by omega⟩)
    apply Finset.sum_involution (fun p _ => τ p)
    · intro p _
      have h_coface : (β ∘ p.1.succAbove) ∘ p.2.succAbove =
          (β ∘ (τ p).1.succAbove) ∘ (τ p).2.succAbove := by
        funext m
        dsimp [τ]
        congr 1
        apply Fin.ext
        split_ifs <;> simp only [h_val_succAbove] <;> split_ifs <;> omega
      rw [h_coface]
      dsimp [τ]
      split_ifs with hle
      · have hexp : (p.2.1 + 1) + p.1.1 = (p.1.1 + p.2.1) + 1 := by omega
        rw [hexp, pow_succ, mul_neg_one, neg_zsmul, add_neg_cancel]
      · have hexp : p.1.1 + p.2.1 = (p.2.1 + (p.1.1 - 1)) + 1 := by omega
        rw [hexp, pow_succ, mul_neg_one, neg_zsmul, neg_add_cancel]
    · intro p _ _ hfix
      by_cases hle : p.1.1 ≤ p.2.1
      · have h1 : (τ p).1.1 = p.1.1 := congrArg (fun x => x.1.1) hfix
        simp only [τ, dif_pos hle] at h1
        omega
      · have h1 : (τ p).1.1 = p.1.1 := congrArg (fun x => x.1.1) hfix
        simp only [τ, dif_neg hle] at h1
        omega
    · intro p _
      exact Finset.mem_univ _
    · intro p _
      dsimp [τ]
      by_cases hle : p.1.1 ≤ p.2.1
      · rw [dif_pos hle]
        have h2 : ¬ (p.2.1 + 1 ≤ p.1.1) := by omega
        rw [dif_neg h2]
        ext <;> dsimp <;> omega
      · rw [dif_neg hle]
        have h2 : p.2.1 ≤ p.1.1 - 1 := by omega
        rw [dif_pos h2]
        ext <;> dsimp <;> omega

  have h_cone_exact : ∀ (q : ℕ) (f : (Fin (q + 2) → X) → ↥M₀),
      (∀ β : Fin (q + 3) → X,
        (Finset.univ.sum fun j : Fin (q + 3) => (-1 : ℤ) ^ (j : ℕ) • f (β ∘ j.succAbove)) = 0) →
      ∃ g : (Fin (q + 1) → X) → ↥M₀,
        ∀ α : Fin (q + 2) → X,
          (Finset.univ.sum fun j : Fin (q + 2) => (-1 : ℤ) ^ (j : ℕ) • g (α ∘ j.succAbove)) = f α := by
    intro q f hf
    refine ⟨fun γ => f (Fin.cons x₀ γ), fun α => ?_⟩
    have h0 := hf (Fin.cons x₀ α)
    rw [Fin.sum_univ_succ] at h0
    have h_head : ((Fin.cons x₀ α) ∘ (0 : Fin (q + 3)).succAbove) = α := by
      funext m
      dsimp only [Function.comp_apply]
      rw [Fin.succAbove_zero, Fin.cons_succ]
    have h_tail : ∀ k : Fin (q + 2),
        (-1 : ℤ) ^ (k.succ : ℕ) • f ((Fin.cons x₀ α) ∘ k.succ.succAbove) =
          - ((-1 : ℤ) ^ (k : ℕ) • f (Fin.cons x₀ (α ∘ k.succAbove))) := by
      intro k
      have h_comp : (Fin.cons x₀ α) ∘ k.succ.succAbove = Fin.cons x₀ (α ∘ k.succAbove) := by
        funext m
        refine Fin.cases ?_ ?_ m
        · dsimp only [Function.comp_apply]
          have hlt : (0 : Fin (q + 2)).castSucc < k.succ := Nat.zero_lt_succ k.1
          rw [Fin.succAbove_of_castSucc_lt k.succ 0 hlt]
          rfl
        · intro r
          dsimp only [Function.comp_apply]
          rw [Fin.succ_succAbove_succ, Fin.cons_succ, Fin.cons_succ]
          rfl
      rw [h_comp, Fin.val_succ, pow_succ, mul_neg_one, neg_zsmul]
    simp only [Fin.val_zero, pow_zero, one_smul, h_head, h_tail, Finset.sum_neg_distrib] at h0
    exact (sub_eq_zero.mp (by rwa [sub_eq_add_neg])).symm

  
  let M : ℕ → Rep.{u, u, u} R G := fun q => funRep (Fin (q + 1) → X)
  let D : ∀ q : ℕ, M q ⟶ M (q + 1) := fun q =>
    Rep.ofHom
      { toFun := fun f α =>
          Finset.univ.sum fun j : Fin (q + 2) => (-1 : ℤ) ^ (j : ℕ) • f (α ∘ j.succAbove)
        map_add' := fun f₁ f₂ => funext fun α => by
          simp only [Pi.add_apply, smul_add, Finset.sum_add_distrib]
        map_smul' := fun r f => funext fun α => by
          dsimp
          rw [Finset.smul_sum]
          apply Finset.sum_congr rfl
          intro j _
          exact smul_comm ((-1 : ℤ) ^ (j : ℕ)) r (f (α ∘ j.succAbove))
        isIntertwining' := fun g => LinearMap.ext fun f => funext fun α => by
          change (Finset.univ.sum fun j : Fin (q + 2) =>
              (-1 : ℤ) ^ (j : ℕ) • M₀.ρ g (f (g⁻¹ • (α ∘ j.succAbove)))) =
            M₀.ρ g (Finset.univ.sum fun j : Fin (q + 2) =>
              (-1 : ℤ) ^ (j : ℕ) • f ((g⁻¹ • α) ∘ j.succAbove))
          rw [map_sum]
          apply Finset.sum_congr rfl
          intro j _
          rw [map_zsmul]
          rfl }

  let Z_sub : ∀ q : ℕ, Submodule R ↥(M q) := fun q => LinearMap.ker (D q).hom.toLinearMap
  have hZ_inv : ∀ (q : ℕ) (g : G) (f : ↥(M q)),
      f ∈ Z_sub q → (M q).ρ g f ∈ Z_sub q := by
    intro q g f hf
    rw [LinearMap.mem_ker] at hf ⊢
    have hint := LinearMap.congr_fun ((D q).hom.isIntertwining' g) f
    simp only [LinearMap.comp_apply] at hint
    rw [hint, hf, map_zero]

  let Z_rep : ℕ → Rep.{u, u, u} R G := fun q =>
    Rep.of
      { toFun := fun g => ((M q).ρ g).restrict (hZ_inv q g)
        map_one' := LinearMap.ext fun x => Subtype.ext (by simp)
        map_mul' := fun g₁ g₂ => LinearMap.ext fun x => Subtype.ext (by simp) }

  
  have hε_ker : ∀ u : ↥M₀, (fun _ : Fin 1 → X => u) ∈ Z_sub 0 := by
    intro u
    rw [LinearMap.mem_ker]
    funext α
    change (Finset.univ.sum fun j : Fin 2 => (-1 : ℤ) ^ (j : ℕ) • u) = 0
    rw [Fin.sum_univ_two]
    simp

  let ε_Z_hom : M₀ ⟶ Z_rep 0 :=
    Rep.ofHom
      { toFun := fun u => ⟨fun _ => u, hε_ker u⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        isIntertwining' := fun _ => LinearMap.ext fun _ => Subtype.ext rfl }

  let ε_Z_inv : Z_rep 0 ⟶ M₀ :=
    Rep.ofHom
      { toFun := fun f => f.1 (fun _ => x₀)
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        isIntertwining' := fun g => LinearMap.ext fun f => by
          have hf0 : ∀ γ : Fin 1 → X, f.1 γ = f.1 (fun _ => x₀) := by
            intro γ
            have h0 : (D 0).hom f.1 (Fin.cons x₀ γ) = 0 := congrFun f.2 (Fin.cons x₀ γ)
            change (Finset.univ.sum fun j : Fin 2 =>
              (-1 : ℤ) ^ (j : ℕ) • f.1 ((Fin.cons x₀ γ) ∘ j.succAbove)) = 0 at h0
            rw [Fin.sum_univ_two] at h0
            have hj0 : (Fin.cons x₀ γ) ∘ (0 : Fin 2).succAbove = γ := by
              funext m
              rw [Subsingleton.elim m 0]
              rfl
            have hj1 : (Fin.cons x₀ γ) ∘ (1 : Fin 2).succAbove = (fun _ => x₀) := by
              funext m
              rw [Subsingleton.elim m 0]
              rfl
            simp only [Fin.val_zero, pow_zero, one_smul, Fin.val_one, pow_one, neg_one_smul,
              hj0, hj1] at h0
            exact sub_eq_zero.mp (by rwa [sub_eq_add_neg])
          change M₀.ρ g (f.1 (g⁻¹ • fun _ => x₀)) = M₀.ρ g (f.1 (fun _ => x₀))
          rw [hf0 (g⁻¹ • fun _ => x₀)] }

  let iso₀ : M₀ ≅ Z_rep 0 :=
    { hom := ε_Z_hom
      inv := ε_Z_inv
      hom_inv_id := rep_ext fun _ => rfl
      inv_hom_id := rep_ext fun f => Subtype.ext (funext fun γ => by
        have h0 : (D 0).hom f.1 (Fin.cons x₀ γ) = 0 := congrFun f.2 (Fin.cons x₀ γ)
        change (Finset.univ.sum fun j : Fin 2 =>
          (-1 : ℤ) ^ (j : ℕ) • f.1 ((Fin.cons x₀ γ) ∘ j.succAbove)) = 0 at h0
        rw [Fin.sum_univ_two] at h0
        have hj0 : (Fin.cons x₀ γ) ∘ (0 : Fin 2).succAbove = γ := by
          funext m; rw [Subsingleton.elim m 0]; rfl
        have hj1 : (Fin.cons x₀ γ) ∘ (1 : Fin 2).succAbove = (fun _ => x₀) := by
          funext m; rw [Subsingleton.elim m 0]; rfl
        simp only [Fin.val_zero, pow_zero, one_smul, Fin.val_one, pow_one, neg_one_smul,
          hj0, hj1] at h0
        exact (sub_eq_zero.mp (by rwa [sub_eq_add_neg])).symm) }

  
  let ι_Z : ∀ q : ℕ, Z_rep q ⟶ M q := fun q =>
    Rep.ofHom
      { toLinearMap := (Z_sub q).subtype
        isIntertwining' := fun _ => rfl }

  have hD_mem_Z : ∀ (q : ℕ) (f : ↥(M q)), (D q).hom f ∈ Z_sub (q + 1) := by
    intro q f
    rw [LinearMap.mem_ker]
    funext β
    exact h_diff_sq q f β

  let π_Z : ∀ q : ℕ, M q ⟶ Z_rep (q + 1) := fun q =>
    Rep.ofHom
      { toFun := fun f => ⟨(D q).hom f, hD_mem_Z q f⟩
        map_add' := fun f₁ f₂ => Subtype.ext (map_add (D q).hom f₁ f₂)
        map_smul' := fun r f => Subtype.ext (map_smul (D q).hom r f)
        isIntertwining' := fun g => LinearMap.ext fun f =>
          Subtype.ext (LinearMap.congr_fun ((D q).hom.isIntertwining' g) f) }

  have hιπ : ∀ q : ℕ, ι_Z q ≫ π_Z q = 0 :=
    fun q => rep_ext fun x => Subtype.ext x.2

  let SC : ∀ q : ℕ, CategoryTheory.ShortComplex (Rep.{u, u, u} R G) := fun q =>
    CategoryTheory.ShortComplex.mk (ι_Z q) (π_Z q) (hιπ q)

  have hSE : ∀ q : ℕ, (SC q).ShortExact := by
    intro q
    have : CategoryTheory.Mono (SC q).f := by
      dsimp [SC]
      rw [Rep.mono_iff_injective]
      exact Subtype.val_injective
    have : CategoryTheory.Epi (SC q).g := by
      dsimp [SC]
      rw [Rep.epi_iff_surjective]
      intro z
      obtain ⟨g, hg⟩ := h_cone_exact q z.1 (fun β => congrFun z.2 β)
      exact ⟨g, Subtype.ext (funext hg)⟩
    let lift_q : ∀ {W : Rep.{u, u, u} R G} (k : W ⟶ M q),
        k ≫ π_Z q = 0 → (W ⟶ Z_rep q) := fun {W} k hk =>
      let l_k := @Representation.IntertwiningMap.toLinearMap R G W.V (M q).V _ _
        W.hV1.toAddCommMonoid (M q).hV1.toAddCommMonoid W.hV2 (M q).hV2 W.ρ (M q).ρ k.hom
      let hl_k := @Representation.IntertwiningMap.isIntertwining' R G W.V (M q).V _ _
        W.hV1.toAddCommMonoid (M q).hV1.toAddCommMonoid W.hV2 (M q).hV2 W.ρ (M q).ρ k.hom
      let lin_k := @LinearMap.codRestrict R R W.V (M q).V _ _
        W.hV1.toAddCommMonoid (M q).hV1.toAddCommMonoid W.hV2 (M q).hV2 (RingHom.id R)
        (Z_sub q) l_k fun w => by
          rw [LinearMap.mem_ker]
          exact congrArg Subtype.val
            (congrArg (fun φ : W ⟶ Z_rep (q + 1) => φ.hom w) hk)
      @Rep.ofHom R G _ _ W.V (Z_rep q).V W.hV1 (Z_rep q).hV1
        W.hV2 (Z_rep q).hV2 W.ρ (Z_rep q).ρ
        (@Representation.IntertwiningMap.mk R G W.V (Z_rep q).V _ _
          W.hV1.toAddCommMonoid (Z_rep q).hV1.toAddCommMonoid
          W.hV2 (Z_rep q).hV2 W.ρ (Z_rep q).ρ lin_k fun g =>
          @LinearMap.ext R R W.V (Z_rep q).V _ _
            W.hV1.toAddCommMonoid (Z_rep q).hV1.toAddCommMonoid
            W.hV2 (Z_rep q).hV2 (RingHom.id R) _ _ fun w =>
            Subtype.ext (@LinearMap.congr_fun R R W.V (M q).V _ _
              W.hV1.toAddCommMonoid (M q).hV1.toAddCommMonoid
              W.hV2 (M q).hV2 (RingHom.id R) _ _ (hl_k g) w))
    have hfac_q : ∀ {W : Rep.{u, u, u} R G} (k : W ⟶ M q) (hk : k ≫ π_Z q = 0),
        lift_q k hk ≫ ι_Z q = k :=
      fun k _ => rep_ext fun _ => rfl
    have hKer_q : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι (SC q).f (SC q).zero) :=
      CategoryTheory.Limits.KernelFork.IsLimit.ofι (SC q).f (SC q).zero
        (fun k hk => lift_q k hk)
        (fun k hk => hfac_q k hk)
        (fun k hk m hm => (cancel_mono (SC q).f).mp (hm.trans (hfac_q k hk).symm))
    exact { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel (SC q) hKer_q }

  
  have hH_Z : ∀ (q n : ℕ), 1 ≤ n → Subsingleton ↥(groupCohomology (Z_rep q) n) := by
    intro q
    induction q with
    | zero =>
      intro n hn
      have hSubM0 : Subsingleton ↥(groupCohomology M₀ n) := hH_M₀ n hn
      let iso_H0 : groupCohomology (Z_rep 0) n ≅ groupCohomology M₀ n :=
        (groupCohomology.functor R G n).mapIso iso₀.symm
      refine ⟨fun x₁ x₂ => ?_⟩
      have hx : (CategoryTheory.ConcreteCategory.hom iso_H0.hom) x₁ =
          (CategoryTheory.ConcreteCategory.hom iso_H0.hom) x₂ :=
        hSubM0.elim _ _
      have h1 := congrArg (fun m : groupCohomology (Z_rep 0) n ⟶ groupCohomology (Z_rep 0) n =>
        (CategoryTheory.ConcreteCategory.hom m) x₁) iso_H0.hom_inv_id
      have h2 := congrArg (fun m : groupCohomology (Z_rep 0) n ⟶ groupCohomology (Z_rep 0) n =>
        (CategoryTheory.ConcreteCategory.hom m) x₂) iso_H0.hom_inv_id
      simp only [CategoryTheory.hom_comp, CategoryTheory.hom_id, Function.comp_apply, id_eq]
        at h1 h2
      exact h1.symm.trans ((congrArg _ hx).trans h2)
    | succ q ih =>
      intro n hn
      have hSubMq : Subsingleton ↥(groupCohomology.mapShortComplex₃ (hSE q)
          (rfl : n + 1 = n + 1)).X₁ :=
        hH_fun (Fintype.card (Fin (q + 1) → X)) (Fin (q + 1) → X) rfl n hn
      have hSubZq : Subsingleton ↥(groupCohomology.mapShortComplex₃ (hSE q)
          (rfl : n + 1 = n + 1)).X₃ :=
        ih (n + 1) (by omega)
      have hex₃ := groupCohomology.mapShortComplex₃_exact (hSE q) (rfl : n + 1 = n + 1)
      rw [CategoryTheory.ShortComplex.moduleCat_exact_iff] at hex₃
      refine ⟨fun x₁ x₂ => ?_⟩
      have hx0 : ∀ x : ↥(groupCohomology.mapShortComplex₃ (hSE q)
          (rfl : n + 1 = n + 1)).X₂, x = 0 := fun x => by
        have hg0 : (CategoryTheory.ConcreteCategory.hom (groupCohomology.mapShortComplex₃ (hSE q)
          (rfl : n + 1 = n + 1)).g) x = 0 := hSubZq.elim _ _
        obtain ⟨u, hu⟩ := hex₃ x hg0
        have hu0 : u = 0 := hSubMq.elim _ _
        rw [← hu, hu0, map_zero]
      exact (hx0 x₁).trans (hx0 x₂).symm

  
  have hSubZp1 : Subsingleton ↥(groupCohomology.mapShortComplex₃ (hSE p)
      (rfl : 0 + 1 = 1)).X₃ := hH_Z p 1 le_rfl
  have hex₀ := groupCohomology.mapShortComplex₃_exact (hSE p) (rfl : 0 + 1 = 1)
  rw [CategoryTheory.ShortComplex.moduleCat_exact_iff] at hex₀

  let c_M : ↥(M (p + 1)) := c
  have hc_mem_Z : c_M ∈ Z_sub (p + 1) := by
    rw [LinearMap.mem_ker]
    exact funext hc_cocycle
  let c_Z : ↥(Z_rep (p + 1)) := ⟨c_M, hc_mem_Z⟩
  have hc_Z_inv : c_Z ∈ (Z_rep (p + 1)).ρ.invariants := by
    rw [Representation.mem_invariants]
    intro g
    apply Subtype.ext
    funext α
    exact hc_inv g α
  let c_inv : ↥(Z_rep (p + 1)).ρ.invariants := ⟨c_Z, hc_Z_inv⟩
  let z₀_H : ↥(groupCohomology.mapShortComplex₃ (hSE p) (rfl : 0 + 1 = 1)).X₂ :=
    (CategoryTheory.ConcreteCategory.hom (groupCohomology.H0Iso (Z_rep (p + 1))).inv) c_inv
  have hz₀_δ : (CategoryTheory.ConcreteCategory.hom (groupCohomology.mapShortComplex₃ (hSE p)
      (rfl : 0 + 1 = 1)).g) z₀_H = 0 :=
    hSubZp1.elim _ _
  obtain ⟨y₀_H, hy₀_H⟩ := hex₀ z₀_H hz₀_δ
  let y₀_M : ↥(groupCohomology (M p) 0) := y₀_H
  let b_inv : ↥(M p).ρ.invariants :=
    (CategoryTheory.ConcreteCategory.hom (groupCohomology.H0Iso (M p)).hom) y₀_M

  have hy₀_map :
      (CategoryTheory.ConcreteCategory.hom
        (groupCohomology.map (MonoidHom.id G) (π_Z p) 0)) y₀_M = z₀_H := by
    have hf_eq : (groupCohomology.mapShortComplex₃ (hSE p) (rfl : 0 + 1 = 1)).f =
        groupCohomology.map (MonoidHom.id G) (π_Z p) 0 :=
      groupCohomology.functor_map R G 0 (π_Z p)
    exact (congrArg (fun φ : groupCohomology (M p) 0 ⟶ groupCohomology (Z_rep (p + 1)) 0 =>
      (CategoryTheory.ConcreteCategory.hom φ) y₀_M) hf_eq.symm).trans hy₀_H

  have h_comm := congrArg
    (fun φ : groupCohomology (M p) 0 ⟶ ModuleCat.of R ↥(Z_rep (p + 1)).ρ.invariants =>
      (CategoryTheory.ConcreteCategory.hom φ) y₀_M)
    (groupCohomology.map_id_comp_H0Iso_hom (π_Z p))
  simp only [CategoryTheory.hom_comp, Function.comp_apply] at h_comm
  rw [hy₀_map] at h_comm
  have hz₀_cancel : (CategoryTheory.ConcreteCategory.hom
      (groupCohomology.H0Iso (Z_rep (p + 1))).hom) z₀_H = c_inv := by
    have hc_id := congrArg
      (fun φ : ModuleCat.of R ↥(Z_rep (p + 1)).ρ.invariants ⟶
          ModuleCat.of R ↥(Z_rep (p + 1)).ρ.invariants =>
        (CategoryTheory.ConcreteCategory.hom φ) c_inv)
      (groupCohomology.H0Iso (Z_rep (p + 1))).inv_hom_id
    simpa only [CategoryTheory.hom_comp, CategoryTheory.hom_id, Function.comp_apply, id_eq]
      using hc_id
  rw [hz₀_cancel] at h_comm

  refine ⟨b_inv.1, ?_, ?_⟩
  · intro g α
    have hb_g := (Representation.mem_invariants (M p).ρ b_inv.1).mp b_inv.2 g
    exact congrFun hb_g α
  · intro α
    have hb_D : (D p).hom b_inv.1 = c := congrArg (fun u => u.1.1) h_comm.symm
    exact congrFun hb_D α

theorem weil_etale_curve_generic_gm_cech_vanishing (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left] [C.left.IsSeparated]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (hGal : ∀ (E L : Type u) [Field E] [Field L]
      [Algebra (FractionRing (Polynomial k)) E]
      [FiniteDimensional (FractionRing (Polynomial k)) E]
      [Algebra E L] [FiniteDimensional E L] [IsGalois E L]
      (n : ℕ), 1 ≤ n → Subsingleton ↥(groupCohomology (weilGalUnitsRep E L) n))
    (U W : C.left.Etale) [CompactSpace ↥U.left] [U.left.IsSeparated]
    [AlgebraicGeometry.IsAffine W.left]
    (w : W ⟶ U) [AlgebraicGeometry.Surjective w.left] (p : ℕ)
    (c : ↥((weilEtaleKPresheaf C.left).obj (Opposite.op (weilEtaleCechObj w (p + 1))))) :
    weilEtaleCechDiff (weilEtaleKPresheaf C.left) w (p + 1) c = 0 →
    ∃ b : ↥((weilEtaleKPresheaf C.left).obj (Opposite.op (weilEtaleCechObj w p))),
      weilEtaleCechDiff (weilEtaleKPresheaf C.left) w p b = c :=
by
  intro hc
  letI : IrreducibleSpace ↥C.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C.left
  let K₀ := FractionRing (Polynomial k)
  let K := ↑C.left.functionField
  obtain ⟨ψ₀, hFinK⟩ := weil_smooth_curve_functionField_finite_over_ratFunc k C
  letI : Algebra K₀ K := ψ₀.toAlgebra
  haveI : FiniteDimensional K₀ K := hFinK
  obtain ⟨A, B, hCA, hCB, hAlgKA, hAlgAB, R, hCR, hAlgAR, ι, δ, e_q,
    hEtA, hEtB, hSurj, hUniv, hFace, hDiff⟩ :=
    weil_etale_generic_fiber_affine_copower_package C.left U W w
  letI : CommRing A := hCA
  letI : CommRing B := hCB
  letI : Algebra K A := hAlgKA
  letI : Algebra A B := hAlgAB
  letI : ∀ q : ℕ, CommRing (R q) := hCR
  letI : ∀ q : ℕ, Algebra A (R q) := hAlgAR
  let c' : Additive (Units (R (p + 1))) := (e_q (p + 1)).symm c
  have hc' : (Finset.univ.sum fun j : Fin ((p + 1) + 2) =>
      (-1 : ℤ) ^ (j : ℕ) •
        MonoidHom.toAdditive (Units.map (δ (p + 1) j).toRingHom.toMonoidHom) c') = 0 := by
    apply (e_q (p + 1 + 1)).injective
    rw [map_zero, ← hDiff (p + 1) c', (e_q (p + 1)).apply_symm_apply, hc]
  have hSplit : ∀ (E L : Type u) [Field E] [Field L]
      [Algebra K E] [FiniteDimensional K E]
      [Algebra E L] [FiniteDimensional E L] [IsGalois E L]
      (X : Type u) [Fintype X] [Nonempty X] [MulAction Gal(L/E) X]
      (c_X : (Fin (p + 2) → X) → Additive Lˣ),
      (∀ (g : Gal(L/E)) (α : Fin (p + 2) → X),
        MonoidHom.toAdditive (Units.map g.toRingHom.toMonoidHom) (c_X (fun i => g⁻¹ • α i)) =
          c_X α) →
      (∀ α : Fin (p + 3) → X,
        (Finset.univ.sum fun j : Fin (p + 3) => (-1 : ℤ) ^ (j : ℕ) • c_X (α ∘ j.succAbove)) = 0) →
      ∃ b_X : (Fin (p + 1) → X) → Additive Lˣ,
        (∀ (g : Gal(L/E)) (α : Fin (p + 1) → X),
          MonoidHom.toAdditive (Units.map g.toRingHom.toMonoidHom) (b_X (fun i => g⁻¹ • α i)) =
            b_X α) ∧
        (∀ α : Fin (p + 2) → X,
          (Finset.univ.sum fun j : Fin (p + 2) => (-1 : ℤ) ^ (j : ℕ) • b_X (α ∘ j.succAbove)) =
            c_X α) := by
    intro E L _ _ _ _ _ _ _ X _ _ _ c_X hc_inv hc_cocycle
    apply weil_galois_semilinear_simplicial_cech_vanishing E L ?_ X p c_X hc_inv hc_cocycle
    intro F n hn
    letI : Algebra K₀ E := ((algebraMap K E).comp (algebraMap K₀ K)).toAlgebra
    haveI : IsScalarTower K₀ K E := IsScalarTower.of_algebraMap_eq' rfl
    haveI : FiniteDimensional K₀ E := Module.Finite.trans K E
    haveI : FiniteDimensional E ↥F := FiniteDimensional.left E ↥F L
    letI : Algebra K₀ ↥F := ((algebraMap E ↥F).comp (algebraMap K₀ E)).toAlgebra
    haveI : IsScalarTower K₀ E ↥F := IsScalarTower.of_algebraMap_eq' rfl
    haveI : FiniteDimensional K₀ ↥F := Module.Finite.trans E ↥F
    exact hGal (↥F) L n hn
  obtain ⟨b', hb'⟩ :=
    weil_etale_copower_galois_splitting_reduction K A B hEtA hEtB hSurj R ι δ hUniv hFace
      p hSplit c' hc'
  refine ⟨e_q p b', ?_⟩
  rw [hDiff p b', hb']
  exact (e_q (p + 1)).apply_symm_apply c

theorem weil_etale_smooth_proj_curve_gm_cohomology_and_divisor_iso (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    (hProjC : IsProjectiveOverField k C)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ x : (weilEtaleGmSheaf C.left).H 0, ∃ y : (weilEtaleGmSheaf C.left).H 0, ℓ • y = x) ∧
    Nonempty ((weilEtaleGmSheaf C.left).H 1 ≃+ weilCurveClGroup C.left) ∧
    (∀ q : ℕ, 2 ≤ q → Subsingleton ((weilEtaleGmSheaf C.left).H q)) :=
by
  classical
  have hCSep : CompactSpace ↥C.left ∧ C.left.IsSeparated := by
    rcases hProjC with ⟨N, ι_proj, hCl_ι⟩
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c x.1 p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    let p_proj : (weilProjectiveSpaceOver k N).left ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥(𝒜 0)) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜
    have : AlgebraicGeometry.IsProper p_proj :=
      AlgebraicGeometry.Proj.instIsProperToSpecZeroOfFiniteTypeSubtypeMemOfNatNat 𝒜
    have : CompactSpace ↥(weilProjectiveSpaceOver k N).left :=
