    let P_pt := AlgebraicGeometry.Scheme.geometricFiber k
    let R_q := CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q)
    have hR_mem : R_q ∈ AlgebraicGeometry.Scheme.etaleTopology S₀ :=
      CategoryTheory.Precoverage.generate_mem_toGrothendieck
        ((AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff (@AlgebraicGeometry.Etale) q).mpr
