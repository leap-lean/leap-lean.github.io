      obtain ⟨F, hF_eq⟩ := (hIntB₀ u_F).mp huF_in_B₀
      change germB₀ F = (u_F : K) at hF_eq
      have hF_ne : germB₀ F ≠ 0 := by rw [hF_eq]; exact u_F.ne_zero
      have hF_span : ∃ c : Fin N_V → k,
          F = Finset.univ.sum fun ν : Fin N_V => φ_k (c ν) * v_bas ν := by
        apply (hv_iff F).mpr
        intro x hF' ht' hx_out
        have huF_x : div_fn (Additive.ofMul (Units.mk0 (germB₀ F) hF')) x =
