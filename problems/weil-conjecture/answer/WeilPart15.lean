            have hp2 : germB₀ (gen_s * q_sp) ≠ 0 := hmq_B₀ ▸ hp1
            have hL := hVal_mul _ _ (hhs_pow_ne m_sp) hFc hp1 x
            have hR := hVal_mul _ _ hgen_ne hqsp_ne hp2 x
            have hU : Units.mk0 _ hp1 = Units.mk0 _ hp2 := Units.ext (congrArg germB₀ hmq_B₀)
            rw [hhs_pow_val0 m_sp, zero_add] at hL
            rw [← hL, ← hR, hU]
          have hqsp_ge0 : 0 ≤ div_fn (Additive.ofMul (Units.mk0 (germB₀ q_sp) hqsp_ne)) x :=
            (hValB₀ q_sp hqsp_ne x hx_in).1
          omega
      · 
        have hXs_out : weilCurveDivSum C.left X_s x = 0 := hDivSum_out X_s U₀ x hx_s hx_in
        have hYs_out : weilCurveDivSum C.left Y_s x = 0 := hDivSum_out Y_s U₀ x hy_s hx_in
        have hFc_pole : (K_pos : ℤ) * div_fn (Additive.ofMul (Units.mk0 (germB₀ t) ht_ne)) x ≤
            div_fn (Additive.ofMul (Units.mk0 (germB₀ F_c) hFc)) x :=
          (hv_iff F_c).mp ⟨c, rfl⟩ x hFc ht_ne hx_in
        have hΔ_pole : div_fn (Additive.ofMul (Units.mk0 (germB₀ Δ_pos_s) hΔ_pos_s)) x =
            (K_pos : ℤ) * div_fn (Additive.ofMul (Units.mk0 (germB₀ t) ht_ne)) x :=
          hΔ_pos_pole x hx_in
        omega
    
    · intro u hu_ineq
      let w_s : B₀ := ev_R W_num
      let gen_s : B₀ := w_s * Finset.univ.prod u_neg_s
      have hUW_s : (Finset.univ.prod u_pos_s) * w_s = h_s ^ m_W * Δ_pos_s := by
        have := congrArg ev_R hUW
        rw [map_mul, map_prod, map_mul, map_pow, hevR_Δpos] at this
        convert this using 2
        exact Finset.prod_congr rfl fun i _ => (hevR_upos i).symm
      obtain ⟨hLocP₀, hLocN₀⟩ := hLocal_all (X_s ⟨0, hK_pos⟩) (hx_s ⟨0, hK_pos⟩)
        (hhs_not_pos ⟨0, hK_pos⟩)
      have hprod_up_ne : germB₀ (Finset.univ.prod u_pos_s) ≠ 0 := by
        rw [map_prod]; exact Finset.prod_ne_zero_iff.mpr fun i _ => (hLocP₀ i).choose
      have hprod_un_ne : germB₀ (Finset.univ.prod u_neg_s) ≠ 0 := by
        rw [map_prod]; exact Finset.prod_ne_zero_iff.mpr fun j _ => (hLocN₀ j).choose
      have hws_ne : germB₀ w_s ≠ 0 := by
        intro h0
        have hRHS_ne : germB₀ (h_s ^ m_W * Δ_pos_s) ≠ 0 := by
