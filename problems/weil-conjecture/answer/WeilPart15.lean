      let x₀ : TensorProduct R₁ (R_stage u₀) M :=
        Algebra.TensorProduct.map θ₂_symm_R₁ (AlgHom.id R₁ M) x
      have h_ι_symm : (ι_J u₀).comp θ₂_symm_R₁ = φ₂ := AlgHom.ext fun _ => rfl
      have hx₀ : Algebra.TensorProduct.map (ι_J u₀) (AlgHom.id R₁ M) x₀ = 0 := by
        dsimp [x₀]
        rw [← AlgHom.comp_apply, ← Algebra.TensorProduct.map_comp, h_ι_symm,
          AlgHom.id_comp, hx]
      obtain ⟨u, g, hg0⟩ := hZero_4 u₀ x₀ hx₀
      let R₃ : Type u := R_stage u
      haveI : IsScalarTower R₁ R₂ R₃ := hTowerR₁R₂St u
      haveI : Algebra.Etale R₂ R₃ := hEtR₂St u
      letI : Algebra R₃ Ω := (pt u.right).toAlgebra
      haveI : IsScalarTower R₂ R₃ Ω :=
        IsScalarTower.of_algebraMap_eq fun y => (hpt_u_R₂ u y).symm
      haveI : IsScalarTower R₁ R₃ Ω :=
        IsScalarTower.of_algebraMap_eq fun r₁ => by
          change algebraMap R₁ Ω r₁ = pt u.right (algebraMap R₂ R₃ (algebraMap R₁ R₂ r₁))
          rw [hpt_u_R₂ u (algebraMap R₁ R₂ r₁), IsScalarTower.algebraMap_apply R₁ R₂ Ω]
      have h_toAlg_R₂R₃ :
          IsScalarTower.toAlgHom R₁ R₂ R₃ = (tr_J g).comp θ₂_symm_R₁ := by
        refine AlgHom.ext fun y => ?_
        change tr u.hom (θ₂.symm y) = tr g.right (θ₂.symm y)
        have hw : (𝟙 j₂) ≫ g.right = u.hom := CategoryTheory.Under.w g
        rw [CategoryTheory.Category.id_comp] at hw
        rw [← hw]
      refine ⟨R₃, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
        inferInstance, inferInstance, inferInstance, ?_⟩
      rw [h_toAlg_R₂R₃, ← AlgHom.comp_id (AlgHom.id R₁ M),
        Algebra.TensorProduct.map_comp, AlgHom.comp_apply]
      exact hg0

  
  refine ⟨A, inferInstance, inferInstance, inferInstance, inferInstance,
    ⟨hLocA, hKerA, hSepA⟩, ?_, ?_, ?_, ?_⟩
  · 
    intro d g z₀ hg hdet
    let ω : Fin d → Ω := fun l => algebraMap A Ω (z₀ l)
    have h_ev_hom : ∀ p : MvPolynomial (Fin d) A,
        MvPolynomial.eval₂ (algebraMap A Ω) ω p = algebraMap A Ω (MvPolynomial.eval z₀ p) := by
      intro p
      induction p using MvPolynomial.induction_on' with
      | monomial m a =>
        rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval_monomial, map_mul, map_finsuppProd]
        congr 1
        refine Finsupp.prod_congr fun l _ => (map_pow (algebraMap A Ω) (z₀ l) _).symm
      | add p₁ p₂ hp₁ hp₂ =>
        rw [MvPolynomial.eval₂_add, MvPolynomial.eval_add, map_add, hp₁, hp₂]
    have hg0 : ∀ k : Fin d, MvPolynomial.eval₂ (algebraMap A Ω) ω (g k) = 0 := by
      intro k
      rw [h_ev_hom]
      exact hg k
    have hdet0 : MvPolynomial.eval₂ (algebraMap A Ω) ω
        (Matrix.det (Matrix.of fun k l : Fin d => MvPolynomial.pderiv l (g k))) ≠ 0 := by
      rw [h_ev_hom]
      exact hdet
    obtain ⟨z, hz0, hz_pt⟩ := hJac_Ω d g ω hg0 hdet0
    refine ⟨z, hz0, fun l => ?_⟩
    rw [RingHom.mem_ker, map_sub, hz_pt l]
    exact sub_self (ω l)
  · 
    intro B₀ _ _ r e_A he_A
    obtain ⟨hIdem_4, _, _⟩ :=
      h_pillar4 R₀ A B₀ ℐ R_obj (@tr) ι htr_id (@htr_comp) (@hι_tr) hSurj hEq
    obtain ⟨k, e_k, he_k, he_map⟩ := hIdem_4 r e_A he_A
    let R₁ : Type u := R_obj k
    letI : Algebra R₁ A := (ι k).toRingHom.toAlgebra
    haveI : IsScalarTower R₀ R₁ A :=
      IsScalarTower.of_algebraMap_eq fun r₀ => ((ι k).commutes r₀).symm
    letI : Algebra R₁ Ω := (pt k).toAlgebra
    haveI : IsScalarTower R₁ A Ω :=
      IsScalarTower.of_algebraMap_eq fun r₁ => (RingHom.congr_fun (hι_pt k) r₁).symm
    haveI : IsScalarTower R₀ R₁ Ω :=
      IsScalarTower.of_algebraMap_eq fun r₀ => (RingHom.congr_fun (hpt_R₀ k) r₀).symm
    have h_toAlg : IsScalarTower.toAlgHom R₀ R₁ A = ι k := AlgHom.ext fun _ => rfl
    refine ⟨R₁, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      inferInstance, inferInstance, inferInstance, e_k, he_k, fun m => ?_⟩
    rw [h_toAlg]
    exact he_map m
  · 
    intro R₁ _ _ _ _ _ _ _ _ R₂ _ _ _ _ _ M _ _ B₀ W₀ _ _ _ _ b_hom α_A hα_B₀
    exact (h_rel R₁ R₂ M).1 B₀ W₀ b_hom α_A hα_B₀
  · 
    intro R₁ _ _ _ _ _ _ _ _ R₂ _ _ _ _ _ M _ _
    exact (h_rel R₁ R₂ M).2

theorem weil_jacobian_local_finite_alg_decomposition (A D : Type u) [CommRing A] [IsLocalRing A] [CommRing D] [Algebra A D] [Module.Finite A D]
    (hJac : ∀ (d : ℕ) (g : Fin d → MvPolynomial (Fin d) A) (z₀ : Fin d → A),
      (∀ k : Fin d, MvPolynomial.eval z₀ (g k) ∈ IsLocalRing.maximalIdeal A) →
      IsUnit (IsLocalRing.residue A
        (MvPolynomial.eval z₀
          (Matrix.det (Matrix.of fun k l : Fin d => MvPolynomial.pderiv l (g k))))) →
      ∃ z : Fin d → A,
        (∀ k : Fin d, MvPolynomial.eval z (g k) = 0) ∧
        (∀ l : Fin d, z l - z₀ l ∈ IsLocalRing.maximalIdeal A)) :
    ∃ (r : ℕ) (e : Fin r → D),
      CompleteOrthogonalIdempotents e ∧
      ∀ m : Fin r, IsLocalRing (D ⧸ Ideal.span {1 - e m}) :=
by
  classical
  let 𝔪_A : Ideal A := IsLocalRing.maximalIdeal A
  let κ_A : Type u := IsLocalRing.ResidueField A
  let ρ : A →+* κ_A := IsLocalRing.residue A
  
  have h_nakayama : ∀ (M : Type u) [AddCommGroup M] [Module A M],
      (⊤ : Submodule A M).FG →
      (⊤ : Submodule A M) ≤ 𝔪_A • (⊤ : Submodule A M) →
      Subsingleton M := by
    intro M _ _ hFG hle
    have hjac : 𝔪_A ≤ (⊥ : Ideal A).jacobson :=
      le_of_eq (IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal A) bot_ne_top).symm
    have hle' : (⊤ : Submodule A M) ≤ ⊥ ⊔ 𝔪_A • (⊤ : Submodule A M) := by
      rwa [bot_sup_eq]
    have hbot : (⊤ : Submodule A M) ≤ ⊥ :=
      Submodule.le_of_le_smul_of_le_jacobson_bot hFG hjac hle'
    refine subsingleton_iff.mpr fun x y => ?_
    have hx : x = 0 := (Submodule.mem_bot A).mp (hbot Submodule.mem_top)
    have hy : y = 0 := (Submodule.mem_bot A).mp (hbot Submodule.mem_top)
    rw [hx, hy]
  
  have h_mul_mem_smul_top : ∀ {R : Type u} [CommRing R] [Algebra A R] (w x : R),
      x ∈ 𝔪_A • (⊤ : Submodule A R) → w * x ∈ 𝔪_A • (⊤ : Submodule A R) := by
    intro R _ _ w x hx
    refine Submodule.smul_induction_on hx ?_ ?_
    · intro r hr y _
      rw [mul_smul_comm]
      exact Submodule.smul_mem_smul hr Submodule.mem_top
    · intro x₁ x₂ hx₁ hx₂
      rw [mul_add]
      exact add_mem hx₁ hx₂
  
  let monicPoly : ∀ {R : Type u} [CommRing R] (n : ℕ), (Fin n → R) → Polynomial R :=
    fun {R} _ n c => Polynomial.X ^ n + ∑ i : Fin n, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ)
  have h_monicPoly_coeff : ∀ {R : Type u} [CommRing R] (n : ℕ) (c : Fin n → R) (m : ℕ),
      (monicPoly n c).coeff m =
        (if m = n then 1 else 0) + ∑ i : Fin n, if (i : ℕ) = m then c i else 0 := by
    intro R _ n c m
    simp only [monicPoly, Polynomial.coeff_add, Polynomial.coeff_X_pow,
      Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, mul_ite, mul_one, mul_zero]
    congr 1
    refine Finset.sum_congr rfl fun i _ => ?_
    by_cases h : m = (i : ℕ)
    · simp [h]
    · have h' : (i : ℕ) ≠ m := Ne.symm h
      simp [h, h']
  have h_coeff_lt : ∀ {R : Type u} [CommRing R] (n : ℕ) (c : Fin n → R) (m : ℕ) (hm : m < n),
      (monicPoly n c).coeff m = c ⟨m, hm⟩ := by
    intro R _ n c m hm
    rw [h_monicPoly_coeff]
    have hmn : m ≠ n := by omega
    have hsum : (∑ i : Fin n, if (i : ℕ) = m then c i else 0) =
        ∑ i : Fin n, if i = ⟨m, hm⟩ then c i else 0 := by
      refine Finset.sum_congr rfl fun i _ => ?_
      simp [Fin.ext_iff]
    simp [hmn, hsum]
  have h_coeff_eq : ∀ {R : Type u} [CommRing R] (n : ℕ) (c : Fin n → R),
      (monicPoly n c).coeff n = 1 := by
    intro R _ n c
    rw [h_monicPoly_coeff]
    have hsum : (∑ i : Fin n, if (i : ℕ) = n then c i else 0) = 0 := by
      refine Finset.sum_eq_zero fun i _ => ?_
      have hi : (i : ℕ) ≠ n := Nat.ne_of_lt i.2
      simp [hi]
    simp [hsum]
  have h_coeff_gt : ∀ {R : Type u} [CommRing R] (n : ℕ) (c : Fin n → R) (m : ℕ),
      n < m → (monicPoly n c).coeff m = 0 := by
    intro R _ n c m hm
    rw [h_monicPoly_coeff]
    have hmn : m ≠ n := by omega
    have hsum : (∑ i : Fin n, if (i : ℕ) = m then c i else 0) = 0 := by
      refine Finset.sum_eq_zero fun i _ => ?_
      have hi : (i : ℕ) ≠ m := by omega
      simp [hi]
    simp [hmn, hsum]
  have h_monicPoly_deg : ∀ {R : Type u} [CommRing R] [Nontrivial R] (n : ℕ) (c : Fin n → R),
      (monicPoly n c).natDegree = n := by
    intro R _ _ n c
    refine le_antisymm
      (Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun m hm => h_coeff_gt n c m hm)
      (Polynomial.le_natDegree_of_ne_zero ?_)
    rw [h_coeff_eq]
    exact one_ne_zero
  have h_monicPoly_monic : ∀ {R : Type u} [CommRing R] [Nontrivial R] (n : ℕ) (c : Fin n → R),
      (monicPoly n c).Monic := by
    intro R _ _ n c
    rw [Polynomial.Monic, Polynomial.leadingCoeff, h_monicPoly_deg]
    exact h_coeff_eq n c
  have h_monicPoly_map : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (n : ℕ)
      (c : Fin n → R), (monicPoly n c).map φ = monicPoly n (fun i => φ (c i)) := by
    intro R S _ _ φ n c
    simp [monicPoly, Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X,
      Polynomial.map_sum, Polynomial.map_mul, Polynomial.map_C]
  have h_monicPoly_zero : ∀ {R : Type u} [CommRing R] (n : ℕ),
      monicPoly n (0 : Fin n → R) = Polynomial.X ^ n := by
    intro R _ n
    simp [monicPoly]
  have h_monicPoly_self : ∀ {R : Type u} [CommRing R] (Q : Polynomial R),
      Q.Monic → monicPoly Q.natDegree (fun i : Fin Q.natDegree => Q.coeff (i : ℕ)) = Q := by
    intro R _ Q hQ
    ext m
    rcases lt_trichotomy m Q.natDegree with hm | rfl | hm
    · rw [h_coeff_lt Q.natDegree _ m hm]
    · rw [h_coeff_eq, ← Polynomial.leadingCoeff, hQ.leadingCoeff]
    · rw [h_coeff_gt Q.natDegree _ m hm, Polynomial.coeff_eq_zero_of_natDegree_lt hm]
  have hPolyLift : ∀ (P : Polynomial A), P.Monic →
      ∀ (a : ℕ) (G₀ : Polynomial κ_A),
        G₀.Monic → G₀.eval 0 ≠ 0 → P.map ρ = Polynomial.X ^ a * G₀ →
        ∃ F₁ G₁ : Polynomial A,
          F₁.Monic ∧ G₁.Monic ∧ F₁ * G₁ = P ∧ IsCoprime F₁ G₁ ∧
          F₁.map ρ = Polynomial.X ^ a ∧ G₁.map ρ = G₀ := by
    intro P hP a G₀ hG₀_monic hG₀_zero hP_bar
    cases a with
    | zero =>
      refine ⟨1, P, Polynomial.monic_one, hP, one_mul P, isCoprime_one_left, ?_, ?_⟩
      · simp
      · simpa using hP_bar
    | succ a' =>
      let a := a' + 1
      have ha_pos : 1 ≤ a := Nat.succ_le_succ (Nat.zero_le a')
      let b := G₀.natDegree
      let d := a + b
      have hP_deg : P.natDegree = d := by
        have h1 : (P.map ρ).natDegree = P.natDegree := hP.natDegree_map ρ
        rw [← h1, hP_bar, (Polynomial.monic_X_pow a).natDegree_mul hG₀_monic,
          Polynomial.natDegree_X_pow]
      let y₀ : Fin b → A := fun j => (IsLocalRing.residue_surjective (G₀.coeff (j : ℕ))).choose
      have hy₀ : ∀ j : Fin b, ρ (y₀ j) = G₀.coeff (j : ℕ) :=
        fun j => (IsLocalRing.residue_surjective (G₀.coeff (j : ℕ))).choose_spec
      let z₀ : Fin d → A := Fin.addCases (fun _ : Fin a => (0 : A)) y₀
      
      let g_coeff_mv : ℕ → MvPolynomial (Fin d) A := fun r =>
        if hr : r < b then MvPolynomial.X (Fin.natAdd a ⟨r, hr⟩)
        else if r = b then 1
        else 0
      have h_eval_g_coeff : ∀ (z : Fin d → A) (r : ℕ),
          MvPolynomial.eval z (g_coeff_mv r) =
            (monicPoly b (fun j => z (Fin.natAdd a j))).coeff r := by
        intro z r
        dsimp only [g_coeff_mv]
        split_ifs with hr hrb
        · rw [MvPolynomial.eval_X, h_coeff_lt b _ r hr]
        · subst hrb
          rw [map_one, h_coeff_eq]
        · rw [map_zero, h_coeff_gt b _ r (by omega)]
      let x_mv : Fin a → MvPolynomial (Fin d) A := fun q => MvPolynomial.X (Fin.castAdd b q)
      let H_mv : Fin a → Fin d → MvPolynomial (Fin d) A := fun q k =>
        if (q : ℕ) ≤ (k : ℕ) then g_coeff_mv ((k : ℕ) - (q : ℕ)) else 0
      let g : Fin d → MvPolynomial (Fin d) A := fun k =>
        (if a ≤ (k : ℕ) then MvPolynomial.X k else 0) +
          (∑ q : Fin a, x_mv q * H_mv q k) -
          MvPolynomial.C (P.coeff (k : ℕ))
      have h_eval_H : ∀ (z : Fin d → A) (q : Fin a) (k : Fin d),
          MvPolynomial.eval z (H_mv q k) =
            (Polynomial.X ^ (q : ℕ) * monicPoly b (fun j => z (Fin.natAdd a j))).coeff (k : ℕ) := by
        intro z q k
        dsimp [H_mv]
        rw [Polynomial.coeff_X_pow_mul']
        split_ifs with hqk
        · exact h_eval_g_coeff z ((k : ℕ) - (q : ℕ))
        · exact map_zero _
      have h_eval_g : ∀ (z : Fin d → A) (k : Fin d),
          MvPolynomial.eval z (g k) =
            (monicPoly a (fun q => z (Fin.castAdd b q)) *
              monicPoly b (fun j => z (Fin.natAdd a j))).coeff (k : ℕ) - P.coeff (k : ℕ) := by
        intro z k
        let F_z := monicPoly a (fun q => z (Fin.castAdd b q))
        let G_z := monicPoly b (fun j => z (Fin.natAdd a j))
        have hFG_coeff : (F_z * G_z).coeff (k : ℕ) =
            (if a ≤ (k : ℕ) then z k else 0) +
              ∑ q : Fin a, z (Fin.castAdd b q) * (Polynomial.X ^ (q : ℕ) * G_z).coeff (k : ℕ) := by
          have hF_mul : F_z * G_z = Polynomial.X ^ a * G_z +
              ∑ q : Fin a, Polynomial.C (z (Fin.castAdd b q)) * (Polynomial.X ^ (q : ℕ) * G_z) := by
            dsimp [F_z, monicPoly]
            rw [add_mul, Finset.sum_mul]
            congr 1
            refine Finset.sum_congr rfl fun q _ => mul_assoc _ _ _
          rw [hF_mul, Polynomial.coeff_add, Polynomial.coeff_X_pow_mul', Polynomial.finsetSum_coeff]
          congr 1
          · split_ifs with hk
            · have hlt : (k : ℕ) - a < b := by omega
              rw [h_coeff_lt b _ ((k : ℕ) - a) hlt]
              congr 1
              ext
              dsimp [Fin.natAdd]
              omega
            · rfl
          · refine Finset.sum_congr rfl fun q _ => Polynomial.coeff_C_mul _
        dsimp [g, x_mv]
        rw [map_sub, map_add, map_sum, MvPolynomial.eval_C, hFG_coeff]
        congr 1
        congr 1
        · split_ifs with hk
          · exact MvPolynomial.eval_X _
          · exact map_zero _
        · refine Finset.sum_congr rfl fun q _ => ?_
          rw [map_mul, MvPolynomial.eval_X, h_eval_H z q k]
      let ψ : MvPolynomial (Fin d) A →+* κ_A := ρ.comp (MvPolynomial.eval z₀)
      have hψ_x : ∀ q : Fin a, ψ (x_mv q) = 0 := by
        intro q
        simp [ψ, x_mv, z₀, Fin.addCases_left]
      have hGz₀_map : (monicPoly b (fun j => z₀ (Fin.natAdd a j))).map ρ = G₀ := by
        rw [h_monicPoly_map]
        have hy0' : (fun j : Fin b => ρ (z₀ (Fin.natAdd a j))) =
            fun j : Fin b => G₀.coeff (j : ℕ) := by
          ext j; simp [z₀, Fin.addCases_right, hy₀]
        rw [hy0']
        exact h_monicPoly_self G₀ hG₀_monic
      have hψ_H : ∀ (q : Fin a) (k : Fin d),
          ψ (H_mv q k) = (Polynomial.X ^ (q : ℕ) * G₀).coeff (k : ℕ) := by
        intro q k
        change ρ (MvPolynomial.eval z₀ (H_mv q k)) = _
        rw [h_eval_H z₀ q k, ← Polynomial.coeff_map, Polynomial.map_mul,
          Polynomial.map_pow, Polynomial.map_X, hGz₀_map]
      have hg_init : ∀ k : Fin d, MvPolynomial.eval z₀ (g k) ∈ IsLocalRing.maximalIdeal A := by
        intro k
        rw [← IsLocalRing.ker_residue, RingHom.mem_ker]
        change ρ (MvPolynomial.eval z₀ (g k)) = 0
        rw [h_eval_g z₀ k, map_sub, ← Polynomial.coeff_map, ← Polynomial.coeff_map, hP_bar,
          Polynomial.map_mul, h_monicPoly_map, hGz₀_map]
        have hx0 : (fun q : Fin a => ρ (z₀ (Fin.castAdd b q))) = 0 := by
          ext q; simp [z₀, Fin.addCases_left]
        rw [hx0, h_monicPoly_zero, sub_self]
      let J_mat : Matrix (Fin d) (Fin d) (MvPolynomial (Fin d) A) :=
        Matrix.of fun k l : Fin d => MvPolynomial.pderiv l (g k)
      let M₀ : Matrix (Fin d) (Fin d) κ_A := ψ.mapMatrix J_mat
      have hM₀_entry : ∀ k l : Fin d,
          M₀ k l = (if a ≤ (k : ℕ) then (if k = l then (1 : κ_A) else 0) else 0) +
            ∑ q : Fin a, ψ (MvPolynomial.pderiv l (x_mv q)) *
              (Polynomial.X ^ (q : ℕ) * G₀).coeff (k : ℕ) := by
        intro k l
        change ψ (MvPolynomial.pderiv l (g k)) = _
        dsimp [g]
        rw [map_sub, MvPolynomial.pderiv_C, sub_zero, map_add, map_sum, map_add, map_sum]
        congr 1
        · by_cases hk : a ≤ (k : ℕ)
          · simp only [hk, ↓reduceIte, MvPolynomial.pderiv_X, Pi.single_apply]
            by_cases hkl : k = l <;> simp [hkl]
          · simp only [hk, ↓reduceIte, map_zero]
        · refine Finset.sum_congr rfl fun q _ => ?_
          rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul,
            hψ_x q, zero_mul, zero_add, hψ_H q k, mul_comm]
      have hM₀_castAdd : ∀ (k : Fin d) (q₀ : Fin a),
          M₀ k (Fin.castAdd b q₀) = (Polynomial.X ^ (q₀ : ℕ) * G₀).coeff (k : ℕ) := by
        intro k q₀
        rw [hM₀_entry]
        have h1 : (if a ≤ (k : ℕ) then (if k = Fin.castAdd b q₀ then (1 : κ_A) else 0) else 0) = 0 := by
          split_ifs with hk hkl
          · exfalso
            have hk_eq : (k : ℕ) = (q₀ : ℕ) := congrArg Fin.val hkl
            omega
          · rfl
          · rfl
        have h2 : (∑ q : Fin a, ψ (MvPolynomial.pderiv (Fin.castAdd b q₀) (x_mv q)) *
            (Polynomial.X ^ (q : ℕ) * G₀).coeff (k : ℕ)) =
            ∑ q : Fin a, if q = q₀ then (Polynomial.X ^ (q : ℕ) * G₀).coeff (k : ℕ) else 0 := by
          refine Finset.sum_congr rfl fun q _ => ?_
          dsimp [x_mv]
          rw [MvPolynomial.pderiv_X, Pi.single_apply]
          by_cases hqq : q = q₀
          · subst hqq; simp
          · have hne : Fin.castAdd b q ≠ Fin.castAdd b q₀ :=
              fun hc => hqq (Fin.castAdd_injective a b hc)
            simp [hqq, hne]
        rw [h1, zero_add, h2, Finset.sum_ite_eq' Finset.univ q₀]
        simp
      have hM₀_natAdd : ∀ (k : Fin d) (j₀ : Fin b),
          M₀ k (Fin.natAdd a j₀) = if k = Fin.natAdd a j₀ then 1 else 0 := by
        intro k j₀
        rw [hM₀_entry]
        have hsum : (∑ q : Fin a, ψ (MvPolynomial.pderiv (Fin.natAdd a j₀) (x_mv q)) *
            (Polynomial.X ^ (q : ℕ) * G₀).coeff (k : ℕ)) = 0 := by
          refine Finset.sum_eq_zero fun q _ => ?_
          dsimp [x_mv]
          rw [MvPolynomial.pderiv_X, Pi.single_apply]
          have hne : Fin.castAdd b q ≠ Fin.natAdd a j₀ := by
            intro hc
            have hv : (q : ℕ) = a + (j₀ : ℕ) := congrArg Fin.val hc
            omega
          simp [hne]
        rw [hsum, add_zero]
        by_cases hkl : k = Fin.natAdd a j₀
        · subst hkl
          simp [Fin.natAdd]
        · simp [hkl]
      have hM₀_tri : M₀.IsLowerTriangular := by
        intro k l hkl
        revert hkl
        refine Fin.addCases (fun q₀ => ?_) (fun j₀ => ?_) l
        · intro hlt
          rw [hM₀_castAdd, Polynomial.coeff_X_pow_mul']
          have hnot : ¬ ((q₀ : ℕ) ≤ (k : ℕ)) := by
            change (k : ℕ) < (q₀ : ℕ) at hlt
            omega
          simp [hnot]
        · intro hlt
          rw [hM₀_natAdd]
          have hne : k ≠ Fin.natAdd a j₀ := ne_of_lt hlt
          simp [hne]
      have hdet_M₀ : M₀.det = (G₀.eval 0) ^ a := by
        have hG₀_c0 : G₀.coeff 0 = G₀.eval 0 := by
          refine Polynomial.induction_on G₀ (fun c => by simp) (fun p q hp hq => by simp [hp, hq]) ?_
          intro n c _
          rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
          simp
        rw [Matrix.det_of_isLowerTriangular M₀ hM₀_tri, Fin.prod_univ_add]
        have hp1 : (∏ q₀ : Fin a, M₀ (Fin.castAdd b q₀) (Fin.castAdd b q₀)) = (G₀.eval 0) ^ a := by
          have hdiag1 : ∀ q₀ : Fin a, M₀ (Fin.castAdd b q₀) (Fin.castAdd b q₀) = G₀.eval 0 := by
            intro q₀
            rw [hM₀_castAdd, Polynomial.coeff_X_pow_mul']
            change (if (q₀ : ℕ) ≤ (q₀ : ℕ) then G₀.coeff ((q₀ : ℕ) - (q₀ : ℕ)) else 0) = G₀.eval 0
            simp [hG₀_c0]
          simp [hdiag1]
        have hp2 : (∏ j₀ : Fin b, M₀ (Fin.natAdd a j₀) (Fin.natAdd a j₀)) = 1 := by
          have hdiag2 : ∀ j₀ : Fin b, M₀ (Fin.natAdd a j₀) (Fin.natAdd a j₀) = 1 := by
            intro j₀
            rw [hM₀_natAdd]
            simp
          simp [hdiag2]
        rw [hp1, hp2, mul_one]
      have hdet_unit : IsUnit (IsLocalRing.residue A (MvPolynomial.eval z₀ J_mat.det)) := by
        have heq : IsLocalRing.residue A (MvPolynomial.eval z₀ J_mat.det) = M₀.det :=
          RingHom.map_det ψ J_mat
        rw [heq, hdet_M₀]
        exact IsUnit.mk0 _ (pow_ne_zero a hG₀_zero)
      obtain ⟨z, hz_zero, hz_mod⟩ := hJac d g z₀ hg_init hdet_unit
      let F₁ : Polynomial A := monicPoly a (fun q => z (Fin.castAdd b q))
      let G₁ : Polynomial A := monicPoly b (fun j => z (Fin.natAdd a j))
      have hF₁_monic : F₁.Monic := h_monicPoly_monic a _
      have hG₁_monic : G₁.Monic := h_monicPoly_monic b _
      have hFG_eq : F₁ * G₁ = P := by
        have hFG_monic : (F₁ * G₁).Monic := hF₁_monic.mul hG₁_monic
        have hFG_deg : (F₁ * G₁).natDegree = d := by
          rw [hF₁_monic.natDegree_mul hG₁_monic, h_monicPoly_deg, h_monicPoly_deg]
        ext m
        rcases lt_trichotomy m d with hm | rfl | hm
        · have h0 := hz_zero ⟨m, hm⟩
          rw [h_eval_g z ⟨m, hm⟩] at h0
          exact sub_eq_zero.mp h0
        · rw [← hFG_deg, ← Polynomial.leadingCoeff, hFG_monic.leadingCoeff,
            hFG_deg, ← hP_deg, ← Polynomial.leadingCoeff, hP.leadingCoeff]
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (hFG_deg ▸ hm),
            Polynomial.coeff_eq_zero_of_natDegree_lt (hP_deg ▸ hm)]
      have hF₁_map : F₁.map ρ = Polynomial.X ^ a := by
        dsimp [F₁]
        rw [h_monicPoly_map]
        have hx_res : (fun q : Fin a => ρ (z (Fin.castAdd b q))) = 0 := by
          ext q
          have hmem := hz_mod (Fin.castAdd b q)
          rw [← IsLocalRing.ker_residue, RingHom.mem_ker, map_sub] at hmem
          have hz0_q : z₀ (Fin.castAdd b q) = 0 := by simp [z₀, Fin.addCases_left]
          rw [hz0_q, map_zero, sub_zero] at hmem
          exact hmem
        rw [hx_res, h_monicPoly_zero]
      have hG₁_map : G₁.map ρ = G₀ := by
        dsimp [G₁]
        rw [h_monicPoly_map]
        have hy_res : (fun j : Fin b => ρ (z (Fin.natAdd a j))) =
            fun j : Fin b => G₀.coeff (j : ℕ) := by
          ext j
          have hmem := hz_mod (Fin.natAdd a j)
          rw [← IsLocalRing.ker_residue, RingHom.mem_ker, map_sub] at hmem
          have hz0_j : z₀ (Fin.natAdd a j) = y₀ j := by simp [z₀, Fin.addCases_right]
          rw [hz0_j] at hmem
          change ρ (z (Fin.natAdd a j)) - ρ (y₀ j) = 0 at hmem
          rw [hy₀ j] at hmem
          exact sub_eq_zero.mp hmem
        rw [hy_res]
        exact h_monicPoly_self G₀ hG₀_monic
      
      have hCoprime : IsCoprime F₁ G₁ := by
        have hndvd : ¬ (Polynomial.X ∣ G₀) := by
          rintro ⟨H, hH⟩
          apply hG₀_zero
          rw [hH, Polynomial.eval_mul, Polynomial.eval_X, zero_mul]
        have hcop_bar : IsCoprime (Polynomial.X ^ a) G₀ :=
          ((Polynomial.irreducible_X.coprime_iff_not_dvd).mpr hndvd).pow_left
        obtain ⟨u_bar, v_bar, huv_bar⟩ := hcop_bar
        obtain ⟨u₀, hu₀⟩ := Polynomial.map_surjective ρ IsLocalRing.residue_surjective u_bar
        obtain ⟨v₀, hv₀⟩ := Polynomial.map_surjective ρ IsLocalRing.residue_surjective v_bar
        let J : Ideal (Polynomial A) := Ideal.span {F₁, G₁}
        let M_quo : Type u := Polynomial A ⧸ J
        let π_J : Polynomial A →ₐ[A] M_quo := Ideal.Quotient.mkₐ A J
        have hπ_F₁ : π_J F₁ = 0 := by
          change Ideal.Quotient.mk J F₁ = 0
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
        have hπ_G₁ : π_J G₁ = 0 := by
          change Ideal.Quotient.mk J G₁ = 0
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
        have hF₁_deg : F₁.natDegree = a := h_monicPoly_deg a _
        have hF₁_ne_one : F₁ ≠ 1 := by
          intro h1
          rw [h1, Polynomial.natDegree_one] at hF₁_deg
          omega
        have hFG_M : (⊤ : Submodule A M_quo).FG := by
          let S_fin : Finset M_quo := Finset.univ.image (fun i : Fin a => π_J (Polynomial.X ^ (i : ℕ)))
          refine Submodule.fg_def.mpr ⟨(S_fin : Set M_quo), S_fin.finite_toSet, ?_⟩
          refine le_antisymm le_top ?_
          intro w _
          obtain ⟨Q, rfl⟩ := Ideal.Quotient.mk_surjective w
          change π_J Q ∈ Submodule.span A (S_fin : Set M_quo)
          have hdiv := Polynomial.modByMonic_add_div Q F₁
          let R_rem := Q %ₘ F₁
          have hQ_eq : π_J Q = π_J R_rem := by
            rw [← hdiv, map_add, map_mul, hπ_F₁, zero_mul, add_zero]
          have hR_sum : R_rem = ∑ i : Fin a, R_rem.coeff (i : ℕ) • Polynomial.X ^ (i : ℕ) := by
            ext m
            simp only [Polynomial.finsetSum_coeff, Polynomial.coeff_smul, Polynomial.coeff_X_pow,
              smul_eq_mul, mul_ite, mul_one, mul_zero]
            by_cases hm : m < a
            · let m_fin : Fin a := ⟨m, hm⟩
              have hs : (∑ x : Fin a, if m = (x : ℕ) then R_rem.coeff (x : ℕ) else 0) =
                  ∑ x : Fin a, if x = m_fin then R_rem.coeff m else 0 := by
                refine Finset.sum_congr rfl fun x _ => ?_
                by_cases hxe : x = m_fin
                · subst hxe; simp [m_fin]
                · have hmx : m ≠ (x : ℕ) := fun hc => hxe (Fin.ext hc.symm)
                  simp [hxe, hmx]
              rw [hs, Finset.sum_ite_eq' Finset.univ m_fin]
              simp
            · have hs0 : (∑ x : Fin a, if m = (x : ℕ) then R_rem.coeff (x : ℕ) else 0) = 0 := by
                refine Finset.sum_eq_zero fun x _ => ?_
                have hxne : m ≠ (x : ℕ) := by omega
                simp [hxne]
              rw [hs0]
              by_cases hR0 : R_rem = 0
              · simp [hR0]
              · have hlt_rem : R_rem.natDegree < a := by
                  rw [← hF₁_deg]
                  exact Polynomial.natDegree_modByMonic_lt Q hF₁_monic hF₁_ne_one
                exact Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
          rw [hQ_eq, hR_sum, map_sum]
          refine sum_mem fun i _ => ?_
          rw [map_smul]
          refine Submodule.smul_mem _ _ (Submodule.subset_span ?_)
          exact Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_univ i))
        have hle_M : (⊤ : Submodule A M_quo) ≤ 𝔪_A • (⊤ : Submodule A M_quo) := by
          let Δ : Polynomial A := 1 - (u₀ * F₁ + v₀ * G₁)
          have hΔ_map : Δ.map ρ = 0 := by
            dsimp [Δ]
            rw [Polynomial.map_sub, Polynomial.map_one, Polynomial.map_add,
              Polynomial.map_mul, Polynomial.map_mul, hu₀, hv₀, hF₁_map, hG₁_map, huv_bar, sub_self]
          have hΔ_π : π_J Δ = 1 := by
            dsimp [Δ]
            rw [map_sub, map_one, map_add, map_mul, map_mul, hπ_F₁, hπ_G₁,
              mul_zero, mul_zero, add_zero, sub_zero]
          have h1_mem : (1 : M_quo) ∈ 𝔪_A • (⊤ : Submodule A M_quo) := by
            rw [← hΔ_π, Polynomial.as_sum_support_C_mul_X_pow Δ, map_sum]
            refine sum_mem fun n _ => ?_
            have hsmul : Polynomial.C (Δ.coeff n) * Polynomial.X ^ n =
                (Δ.coeff n) • (Polynomial.X ^ n : Polynomial A) := by
              rw [Algebra.smul_def, Polynomial.algebraMap_eq]
            rw [hsmul, map_smul]
            have hc_mem : Δ.coeff n ∈ 𝔪_A := by
              change Δ.coeff n ∈ IsLocalRing.maximalIdeal A
              rw [← IsLocalRing.ker_residue, RingHom.mem_ker]
              change ρ (Δ.coeff n) = 0
              rw [← Polynomial.coeff_map, hΔ_map, Polynomial.coeff_zero]
            exact Submodule.smul_mem_smul hc_mem Submodule.mem_top
          intro w _
          simpa using h_mul_mem_smul_top w 1 h1_mem
        haveI : Subsingleton M_quo := h_nakayama M_quo hFG_M hle_M
        have h1_zero : Ideal.Quotient.mk J (1 : Polynomial A) = 0 := Subsingleton.elim _ _
        have h1_J : (1 : Polynomial A) ∈ J := Ideal.Quotient.eq_zero_iff_mem.mp h1_zero
        exact Ideal.mem_span_pair.mp h1_J
      exact ⟨F₁, G₁, hF₁_monic, hG₁_monic, hFG_eq, hCoprime, hF₁_map, hG₁_map⟩
  
  have hSingleLift : ∀ (D' : Type u) [CommRing D'] [Algebra A D'] [Module.Finite A D']
      (e_bar₀ : D' ⧸ Ideal.map (algebraMap A D') 𝔪_A),
      IsIdempotentElem e_bar₀ →
      ∃ e : D', IsIdempotentElem e ∧
        Ideal.Quotient.mk (Ideal.map (algebraMap A D') 𝔪_A) e = e_bar₀ := by
    intro D' _ _ _ e_bar₀ he_bar₀
    let I_D' : Ideal D' := Ideal.map (algebraMap A D') 𝔪_A
    let π_D' : D' →+* (D' ⧸ I_D') := Ideal.Quotient.mk I_D'
    let φ_bar : κ_A →+* (D' ⧸ I_D') :=
      Ideal.Quotient.lift 𝔪_A (π_D'.comp (algebraMap A D')) fun a ha =>
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha)
    let ev : Polynomial κ_A →+* (D' ⧸ I_D') := Polynomial.eval₂RingHom φ_bar e_bar₀
    obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective e_bar₀
    have h_ev_aeval : ∀ Q : Polynomial A, π_D' (Polynomial.aeval c Q) = ev (Q.map ρ) := by
      intro Q
      change π_D' (Polynomial.eval₂ (algebraMap A D') c Q) =
        Polynomial.eval₂ φ_bar e_bar₀ (Q.map ρ)
      rw [Polynomial.hom_eval₂, Polynomial.eval₂_map, hc]
      rfl
    have hAlgInt : Algebra.IsIntegral A D' := Algebra.IsIntegral.of_finite A D'
    have hc_int : IsIntegral A c := hAlgInt.isIntegral c
    obtain ⟨P, hP, hPc⟩ := hc_int
    have hPc_aeval : Polynomial.aeval c P = 0 := hPc
    let P_bar : Polynomial κ_A := P.map ρ
    have hP_bar_monic : P_bar.Monic := hP.map ρ
    have h_ev_P : ev P_bar = 0 := by
      dsimp [P_bar]
      rw [← h_ev_aeval P, hPc_aeval, map_zero]
    obtain ⟨G₀, hP_bar_eq₀, hndvd₀⟩ :=
      Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd P_bar hP_bar_monic.ne_zero 0
    have hX_sub : (Polynomial.X - Polynomial.C (0 : κ_A)) = Polynomial.X := by simp
    rw [hX_sub] at hP_bar_eq₀ hndvd₀
    generalize P_bar.rootMultiplicity 0 = a at hP_bar_eq₀
    have hP_bar_eq : P.map ρ = Polynomial.X ^ a * G₀ := hP_bar_eq₀
    have hG₀_zero : G₀.eval 0 ≠ 0 := by
      intro h0
      apply hndvd₀
      rw [← hX_sub]
      exact Polynomial.dvd_iff_isRoot.mpr h0
    have hG₀_monic : G₀.Monic := by
      rw [Polynomial.Monic]
      have hlc : (P.map ρ).leadingCoeff = 1 := hP_bar_monic.leadingCoeff
      rw [hP_bar_eq, Polynomial.leadingCoeff_mul, (Polynomial.monic_X_pow a).leadingCoeff,
        one_mul] at hlc
      exact hlc
    have he_ortho_self : e_bar₀ * (1 - e_bar₀) = 0 := by
      rw [mul_sub, mul_one, he_bar₀.eq, sub_self]
    rcases a with _ | a'
    · have hP_G₀ : P.map ρ = G₀ := by simpa using hP_bar_eq
      have hev_G₀ : ev G₀ = 0 := by
        rw [← hP_G₀]
        exact h_ev_P
      have hdvd_G₀ : Polynomial.X - Polynomial.C (0 : κ_A) ∣ G₀ - Polynomial.C (G₀.eval 0) := by
        rw [Polynomial.dvd_iff_isRoot, Polynomial.IsRoot.def, Polynomial.eval_sub,
          Polynomial.eval_C, sub_self]
      rw [hX_sub] at hdvd_G₀
      obtain ⟨Q₀, hQ₀⟩ := hdvd_G₀
      have hG₀_decomp : G₀ = Polynomial.C (G₀.eval 0) + Polynomial.X * Q₀ :=
        eq_add_of_sub_eq' hQ₀
      have hev_decomp : φ_bar (G₀.eval 0) + e_bar₀ * ev Q₀ = 0 := by
        have h1 := hev_G₀
        rw [hG₀_decomp, map_add, map_mul] at h1
        simpa [ev] using h1
      have hmul0 : φ_bar (G₀.eval 0) * (1 - e_bar₀) = 0 := by
        have h1 : (φ_bar (G₀.eval 0) + e_bar₀ * ev Q₀) * (1 - e_bar₀) = 0 := by
          rw [hev_decomp, zero_mul]
        have h2 : (e_bar₀ * ev Q₀) * (1 - e_bar₀) = (e_bar₀ * (1 - e_bar₀)) * ev Q₀ := by ring
        rw [add_mul, h2, he_ortho_self, zero_mul, add_zero] at h1
        exact h1
      have h1_sub : 1 - e_bar₀ = 0 := by
        calc
          1 - e_bar₀ = φ_bar ((G₀.eval 0)⁻¹ * G₀.eval 0) * (1 - e_bar₀) := by
            rw [inv_mul_cancel₀ hG₀_zero, map_one, one_mul]
          _ = φ_bar (G₀.eval 0)⁻¹ * (φ_bar (G₀.eval 0) * (1 - e_bar₀)) := by
            rw [map_mul, mul_assoc]
          _ = 0 := by rw [hmul0, mul_zero]
      refine ⟨1, IsIdempotentElem.one, ?_⟩
      rw [map_one]
      exact sub_eq_zero.mp h1_sub
    · obtain ⟨F₁, G₁, _, _, hFG, hCop, hF₁_map, hG₁_map⟩ :=
        hPolyLift P hP (a' + 1) G₀ hG₀_monic hG₀_zero hP_bar_eq
      obtain ⟨U, V, hUV⟩ := hCop
      let e : D' := Polynomial.aeval c (U * F₁)
      have h1_sub_e : 1 - e = Polynomial.aeval c (V * G₁) := by
        have hVG : V * G₁ = 1 - U * F₁ := eq_sub_of_add_eq' hUV
        dsimp [e]
        rw [hVG, map_sub, map_one]
      have he_idem : IsIdempotentElem e := by
        have hprod : e * (1 - e) = 0 := by
          rw [h1_sub_e]
          dsimp [e]
          rw [← map_mul]
          have hmul_poly : (U * F₁) * (V * G₁) = (U * V) * (F₁ * G₁) := by ring
          rw [hmul_poly, hFG, map_mul, hPc_aeval, mul_zero]
        rw [IsIdempotentElem]
        rw [mul_sub, mul_one] at hprod
        exact (sub_eq_zero.mp hprod).symm
      have he_res : π_D' e = e_bar₀ := by
        have he_pow : e_bar₀ ^ (a' + 1) = e_bar₀ := he_bar₀.pow_succ_eq a'
        have hπe : π_D' e = ev (U.map ρ) * e_bar₀ := by
          dsimp [e]
          rw [h_ev_aeval, Polynomial.map_mul, map_mul, hF₁_map, map_pow]
          have hX_ev : ev Polynomial.X = e_bar₀ := by simp [ev]
          rw [hX_ev, he_pow]
        have hπ1e : 1 - π_D' e = ev (V.map ρ) * ev G₀ := by
          rw [← map_one π_D', ← map_sub, h1_sub_e, h_ev_aeval, Polynomial.map_mul,
            map_mul, hG₁_map]
        have he0_G0 : e_bar₀ * ev G₀ = 0 := by
          have h1 : ev (P.map ρ) = 0 := h_ev_P
          rw [hP_bar_eq, map_mul, map_pow] at h1
          have hX_ev : ev Polynomial.X = e_bar₀ := by simp [ev]
          rwa [hX_ev, he_pow] at h1
        have hp1 : π_D' e * (1 - e_bar₀) = 0 := by
          rw [hπe, mul_assoc, he_ortho_self, mul_zero]
        have hp2 : (1 - π_D' e) * e_bar₀ = 0 := by
          rw [hπ1e]
          calc
            ev (V.map ρ) * ev G₀ * e_bar₀ = ev (V.map ρ) * (e_bar₀ * ev G₀) := by ring
            _ = 0 := by rw [he0_G0, mul_zero]
        rw [mul_sub, mul_one] at hp1
        rw [sub_mul, one_mul] at hp2
        exact (sub_eq_zero.mp hp1).trans (sub_eq_zero.mp hp2).symm
      exact ⟨e, he_idem, he_res⟩
  
  have hCompleteLift : ∀ (r : ℕ) (D' : Type u) [CommRing D'] [Algebra A D'] [Module.Finite A D']
      (e_bar : Fin r → D' ⧸ Ideal.map (algebraMap A D') 𝔪_A),
      CompleteOrthogonalIdempotents e_bar →
      ∃ e : Fin r → D', CompleteOrthogonalIdempotents e ∧
        ∀ m : Fin r, Ideal.Quotient.mk (Ideal.map (algebraMap A D') 𝔪_A) (e m) = e_bar m := by
    intro r
    induction r with
    | zero =>
      intro D' _ _ _ e_bar he_bar
      let I_D' : Ideal D' := Ideal.map (algebraMap A D') 𝔪_A
      have h01 : (0 : D' ⧸ I_D') = 1 := by
        simpa using he_bar.complete
      have h1_mem : (1 : D') ∈ I_D' := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_one, ← h01]
      have hI_le : ∀ x ∈ I_D', x ∈ 𝔪_A • (⊤ : Submodule A D') := by
        intro x hx
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
        · rintro _ ⟨a, ha, rfl⟩
          rw [Algebra.algebraMap_eq_smul_one]
          exact Submodule.smul_mem_smul ha Submodule.mem_top
        · exact zero_mem _
        · intro y₁ y₂ _ _ hy₁ hy₂
          exact add_mem hy₁ hy₂
        · intro d y _ hy
          exact h_mul_mem_smul_top d y hy
      have hle_top : (⊤ : Submodule A D') ≤ 𝔪_A • (⊤ : Submodule A D') := by
        intro d _
        have hd_mem : d ∈ I_D' := by
          simpa using I_D'.mul_mem_left d h1_mem
        exact hI_le d hd_mem
      haveI : Subsingleton D' := h_nakayama D' Module.Finite.fg_top hle_top
      exact ⟨Fin.elim0, CompleteOrthogonalIdempotents.of_subsingleton, fun m => m.elim0⟩
    | succ k ih =>
      intro D' _ _ _ e_bar he_bar
      rcases he_bar with ⟨⟨he_bar_idem, he_bar_ortho⟩, he_bar_comp⟩
      let I_D' : Ideal D' := Ideal.map (algebraMap A D') 𝔪_A
      let π_D' : D' →+* (D' ⧸ I_D') := Ideal.Quotient.mk I_D'
      obtain ⟨e₀, he₀, hπ_e₀⟩ := hSingleLift D' (e_bar 0) (he_bar_idem 0)
      let Q₀ : Type u := D' ⧸ Ideal.span {e₀}
      haveI : Module.Finite A Q₀ :=
        Module.Finite.of_surjective
          (Ideal.Quotient.mkₐ A (Ideal.span {e₀})).toLinearMap Ideal.Quotient.mk_surjective
      let π₀ : D' →+* Q₀ := Ideal.Quotient.mk (Ideal.span {e₀})
      let I_Q₀ : Ideal Q₀ := Ideal.map (algebraMap A Q₀) 𝔪_A
      let π_Q₀ : Q₀ →+* (Q₀ ⧸ I_Q₀) := Ideal.Quotient.mk I_Q₀
      have hI_ker : I_D' ≤ RingHom.ker (π_Q₀.comp π₀) := by
        rw [Ideal.map_le_iff_le_comap]
        intro a ha
        rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply]
        have hcomm : π₀ (algebraMap A D' a) = algebraMap A Q₀ a := rfl
        rw [hcomm]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha)
      let ψ_bar : (D' ⧸ I_D') →+* (Q₀ ⧸ I_Q₀) :=
        Ideal.Quotient.lift I_D' (π_Q₀.comp π₀) hI_ker
      have hψ_e₀ : ψ_bar (e_bar 0) = 0 := by
        rw [← hπ_e₀]
        change π_Q₀ (π₀ e₀) = 0
        have hp0 : π₀ e₀ = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self e₀)
        rw [hp0, map_zero]
      let e'_bar : Fin k → (Q₀ ⧸ I_Q₀) := fun i => ψ_bar (e_bar i.succ)
      have he'_bar : CompleteOrthogonalIdempotents e'_bar := by
        refine CompleteOrthogonalIdempotents.mk ⟨?_, ?_⟩ ?_
        · intro i
          dsimp [e'_bar]
          rw [IsIdempotentElem, ← map_mul, (he_bar_idem i.succ).eq]
        · intro i j hij
          dsimp [e'_bar]
          rw [← map_mul, he_bar_ortho (Fin.succ_injective _ |>.ne hij), map_zero]
        · have hsum_succ := congrArg ψ_bar he_bar_comp
          rw [Fin.sum_univ_succ, map_add, hψ_e₀, zero_add, map_sum, map_one] at hsum_succ
          exact hsum_succ
      obtain ⟨e', he', he'_lift⟩ := ih Q₀ e'_bar he'_bar
      rcases he' with ⟨⟨he'_idem, he'_ortho⟩, he'_comp⟩
      let d_pre : Fin k → D' := fun i => (Ideal.Quotient.mk_surjective (e' i)).choose
      have hd_pre : ∀ i : Fin k, π₀ (d_pre i) = e' i :=
        fun i => (Ideal.Quotient.mk_surjective (e' i)).choose_spec
      have hann : ∀ u : D', π₀ u = 0 → (1 - e₀) * u = 0 := by
        intro u hu
        have hmem : u ∈ Ideal.span {e₀} := Ideal.Quotient.eq_zero_iff_mem.mp hu
        obtain ⟨z, rfl⟩ := Ideal.mem_span_singleton.mp hmem
        calc
          (1 - e₀) * (e₀ * z) = (e₀ - e₀ * e₀) * z := by ring
          _ = 0 := by rw [he₀.eq, sub_self, zero_mul]
      have h1_e₀_idem : (1 - e₀) * (1 - e₀) = 1 - e₀ := by
        calc
          (1 - e₀) * (1 - e₀) = 1 - e₀ - (e₀ - e₀ * e₀) := by ring
          _ = 1 - e₀ := by rw [he₀.eq, sub_self, sub_zero]
      let e : Fin (k + 1) → D' := Fin.cases e₀ (fun i => (1 - e₀) * d_pre i)
      have he_coidem : CompleteOrthogonalIdempotents e := by
        refine CompleteOrthogonalIdempotents.mk ⟨?_, ?_⟩ ?_
        · intro m
          refine Fin.cases ?_ (fun i => ?_) m
          · exact he₀
          · dsimp [e]
            rw [IsIdempotentElem]
            apply sub_eq_zero.mp
            have hrew : (1 - e₀) * d_pre i * ((1 - e₀) * d_pre i) - (1 - e₀) * d_pre i =
                ((1 - e₀) * (1 - e₀)) * (d_pre i * d_pre i) - (1 - e₀) * d_pre i := by ring
            rw [hrew, h1_e₀_idem, ← mul_sub]
            refine hann _ ?_
            rw [map_sub, map_mul, hd_pre i, (he'_idem i).eq, sub_self]
        · intro m₁ m₂ hm
          revert hm
          refine Fin.cases ?_ (fun i => ?_) m₁
          · refine Fin.cases (fun h00 => (h00 rfl).elim) (fun j _ => ?_) m₂
            dsimp [e]
            calc
              e₀ * ((1 - e₀) * d_pre j) = (e₀ - e₀ * e₀) * d_pre j := by ring
              _ = 0 := by rw [he₀.eq, sub_self, zero_mul]
          · refine Fin.cases (fun _ => ?_) (fun j hne => ?_) m₂
            · dsimp [e]
              calc
                (1 - e₀) * d_pre i * e₀ = (e₀ - e₀ * e₀) * d_pre i := by ring
                _ = 0 := by rw [he₀.eq, sub_self, zero_mul]
            · have hij : i ≠ j := fun h => hne (congrArg Fin.succ h)
              dsimp [e]
              have hrew : (1 - e₀) * d_pre i * ((1 - e₀) * d_pre j) =
                  ((1 - e₀) * (1 - e₀)) * (d_pre i * d_pre j) := by ring
              rw [hrew, h1_e₀_idem]
              refine hann _ ?_
              rw [map_mul, hd_pre i, hd_pre j, he'_ortho hij]
        · rw [Fin.sum_univ_succ]
          dsimp [e]
          rw [← Finset.mul_sum]
          apply sub_eq_zero.mp
          have hrew : e₀ + (1 - e₀) * (∑ i : Fin k, d_pre i) - 1 =
              (1 - e₀) * ((∑ i : Fin k, d_pre i) - 1) := by ring
          rw [hrew]
          refine hann _ ?_
          rw [map_sub, map_sum, map_one]
          have hs : (∑ i : Fin k, π₀ (d_pre i)) = ∑ i : Fin k, e' i :=
            Finset.sum_congr rfl fun i _ => hd_pre i
          rw [hs, he'_comp, sub_self]
      have he_lift : ∀ m : Fin (k + 1), π_D' (e m) = e_bar m := by
        intro m
        refine Fin.cases hπ_e₀ (fun i => ?_) m
        dsimp [e]
        obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective (e_bar i.succ)
        have hker_ds : π₀ (d_pre i - s) ∈ I_Q₀ := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_sub, hd_pre i, he'_lift i]
          have hψ_s : ψ_bar (e_bar i.succ) = π_Q₀ (π₀ s) := by
            rw [← hs]
            rfl
          rw [← hψ_s]
          exact sub_self _
        have hmap_eq : I_Q₀ = Ideal.map π₀ I_D' := by
          dsimp [I_Q₀, I_D']
          rw [Ideal.map_map]
          rfl
        rw [hmap_eq] at hker_ds
        obtain ⟨y, hy_mem, hy_eq⟩ :=
          (Ideal.mem_map_iff_of_surjective π₀ Ideal.Quotient.mk_surjective).mp hker_ds
        have hann_y : (1 - e₀) * (d_pre i - s - y) = 0 := by
          refine hann _ ?_
          rw [map_sub, hy_eq, sub_self]
        have h_eq_d : (1 - e₀) * d_pre i = (1 - e₀) * s + (1 - e₀) * y := by
          have h1 : (1 - e₀) * d_pre i - ((1 - e₀) * s + (1 - e₀) * y) =
              (1 - e₀) * (d_pre i - s - y) := by ring
          exact sub_eq_zero.mp (h1.trans hann_y)
        have hπ_y : π_D' y = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hy_mem
        have hortho_0i : e_bar 0 * e_bar i.succ = 0 :=
          he_bar_ortho (Fin.succ_ne_zero i).symm
        rw [h_eq_d, map_add, map_mul, map_mul, hπ_y, mul_zero, add_zero,
          map_sub, map_one, hπ_e₀, hs, sub_mul, one_mul, hortho_0i, sub_zero]
      exact ⟨e, he_coidem, he_lift⟩
  
  let I_D : Ideal D := Ideal.map (algebraMap A D) 𝔪_A
  let D_bar : Type u := D ⧸ I_D
  let π_D : D →+* D_bar := Ideal.Quotient.mk I_D
  letI : Ideal.IsMaximal 𝔪_A := IsLocalRing.maximalIdeal.isMaximal A
  let F_A : Type u := A ⧸ 𝔪_A
  letI : Field F_A := Ideal.Quotient.field 𝔪_A
  let φ_FA : F_A →+* D_bar :=
    Ideal.Quotient.lift 𝔪_A (π_D.comp (algebraMap A D)) fun a ha =>
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha)
  letI : Algebra F_A D_bar := φ_FA.toAlgebra
  haveI : IsScalarTower A F_A D_bar := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : Module.Finite A D_bar :=
    Module.Finite.of_surjective (Ideal.Quotient.mkₐ A I_D).toLinearMap Ideal.Quotient.mk_surjective
  haveI : Module.Finite F_A D_bar := Module.Finite.of_restrictScalars_finite A F_A D_bar
  haveI : IsArtinianRing D_bar := IsArtinianRing.of_finite F_A D_bar
  letI : Fintype (MaximalSpectrum D_bar) := Fintype.ofFinite (MaximalSpectrum D_bar)
  let Φ₀ : (D_bar ⧸ nilradical D_bar) ≃+* ∀ J : MaximalSpectrum D_bar, D_bar ⧸ J.asIdeal :=
    (IsArtinianRing.quotNilradicalEquivPi D_bar).toRingEquiv
  let q_nil : D_bar →+* (D_bar ⧸ nilradical D_bar) := Ideal.Quotient.mk (nilradical D_bar)
  let e_pi : MaximalSpectrum D_bar → (∀ J : MaximalSpectrum D_bar, D_bar ⧸ J.asIdeal) :=
    fun J => Pi.single J 1
  have he_pi : CompleteOrthogonalIdempotents e_pi :=
    CompleteOrthogonalIdempotents.single fun J : MaximalSpectrum D_bar => D_bar ⧸ J.asIdeal
  have he_nil : CompleteOrthogonalIdempotents (⇑Φ₀.symm.toRingHom ∘ e_pi) :=
    CompleteOrthogonalIdempotents.map Φ₀.symm.toRingHom he_pi
  have hker_nil : ∀ x ∈ RingHom.ker q_nil, IsNilpotent x := by
    intro x hx
    rw [Ideal.mk_ker] at hx
    exact hx
  have hrange_nil : ∀ J : MaximalSpectrum D_bar, (⇑Φ₀.symm.toRingHom ∘ e_pi) J ∈ q_nil.range :=
    fun J => Ideal.Quotient.mk_surjective _
  obtain ⟨e_spec, he_spec, he_spec_eq⟩ :=
    CompleteOrthogonalIdempotents.lift_of_isNilpotent_ker q_nil hker_nil he_nil hrange_nil
  have hΦ₀_espec : ∀ J : MaximalSpectrum D_bar, Φ₀ (q_nil (e_spec J)) = Pi.single J 1 := by
    intro J
    have hJ := congrFun he_spec_eq J
    dsimp [e_pi] at hJ
    rw [hJ]
    exact Φ₀.apply_symm_apply _
  have hLoc_spec : ∀ J : MaximalSpectrum D_bar,
      IsLocalRing (D_bar ⧸ Ideal.span {1 - e_spec J}) := by
    intro J
    let Q_J : Type u := D_bar ⧸ Ideal.span {1 - e_spec J}
    letI : Ideal.IsMaximal J.asIdeal := J.isMaximal
    let F_J : Type u := D_bar ⧸ J.asIdeal
    letI : Field F_J := Ideal.Quotient.field J.asIdeal
    let π_J : D_bar →+* F_J :=
      (Pi.evalRingHom (fun K : MaximalSpectrum D_bar => D_bar ⧸ K.asIdeal) J).comp
        (Φ₀.toRingHom.comp q_nil)
    have hπ_J_surj : Function.Surjective π_J := by
      intro y
      obtain ⟨w, hw⟩ := Φ₀.surjective (Pi.single J y)
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective w
      refine ⟨x, ?_⟩
      change Φ₀ (q_nil x) J = y
      rw [hw, Pi.single_eq_same]
    have hπ_J_ker : Ideal.span {1 - e_spec J} ≤ RingHom.ker π_J := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, map_sub, map_one]
      have h1 : π_J (e_spec J) = 1 := by
        change Φ₀ (q_nil (e_spec J)) J = 1
        rw [hΦ₀_espec J, Pi.single_eq_same]
      rw [h1, sub_self]
    let π_bar_J : Q_J →+* F_J := Ideal.Quotient.lift _ π_J hπ_J_ker
    have hπ_bar_surj : Function.Surjective π_bar_J := by
      intro y
      obtain ⟨x, rfl⟩ := hπ_J_surj y
      exact ⟨Ideal.Quotient.mk _ x, rfl⟩
    haveI : Nontrivial Q_J := π_bar_J.domain_nontrivial
    have hker_nil_J : ∀ u : Q_J, π_bar_J u = 0 → IsNilpotent u := by
      intro u hu
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective u
      have hx0 : Φ₀ (q_nil x) J = 0 := hu
      have hprod_zero : Φ₀ (q_nil (e_spec J * x)) = 0 := by
        ext K
        rw [map_mul, map_mul, Pi.mul_apply, hΦ₀_espec J, Pi.zero_apply]
        by_cases hKJ : K = J
        · subst hKJ; rw [hx0, mul_zero]
        · rw [Pi.single_eq_of_ne hKJ, zero_mul]
      have hq_zero : q_nil (e_spec J * x) = 0 :=
        Φ₀.injective (hprod_zero.trans (map_zero Φ₀).symm)
      have hnil_Dbar : IsNilpotent (e_spec J * x) := Ideal.Quotient.eq_zero_iff_mem.mp hq_zero
      have hmk_eq : Ideal.Quotient.mk (Ideal.span {1 - e_spec J}) x =
          Ideal.Quotient.mk (Ideal.span {1 - e_spec J}) (e_spec J * x) := by
        apply sub_eq_zero.mp
        rw [← map_sub]
        have hsub : x - e_spec J * x = (1 - e_spec J) * x := by ring
        rw [hsub]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr
          (Ideal.mul_mem_right x _ (Ideal.mem_span_singleton_self _))
      rw [hmk_eq]
      exact hnil_Dbar.map (Ideal.Quotient.mk (Ideal.span {1 - e_spec J}))
    refine IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun u => ?_
    by_cases hu0 : π_bar_J u = 0
    · exact Or.inr (hker_nil_J u hu0).isUnit_one_sub
    · obtain ⟨v, hv⟩ := hπ_bar_surj (π_bar_J u)⁻¹
      have h1_uv : π_bar_J (1 - u * v) = 0 := by
        rw [map_sub, map_one, map_mul, hv, mul_inv_cancel₀ hu0, sub_self]
      have hu_v : IsUnit (u * v) := by
        have h1 := (hker_nil_J (1 - u * v) h1_uv).isUnit_one_sub
        rwa [sub_sub_cancel] at h1
      exact Or.inl (isUnit_of_mul_isUnit_left hu_v)
  obtain ⟨r, ⟨σ_fin⟩⟩ := Finite.exists_equiv_fin (MaximalSpectrum D_bar)
  let σ : Fin r ≃ MaximalSpectrum D_bar := σ_fin.symm
  let e_bar : Fin r → D_bar := fun m => e_spec (σ m)
  have he_bar : CompleteOrthogonalIdempotents e_bar := by
    rcases he_spec with ⟨⟨h_idem, h_ortho⟩, h_comp⟩
    refine CompleteOrthogonalIdempotents.mk ⟨?_, ?_⟩ ?_
    · intro m; exact h_idem (σ m)
    · intro m₁ m₂ hm; exact h_ortho (σ.injective.ne hm)
    · dsimp [e_bar]
      rw [Equiv.sum_comp σ]
      exact h_comp
  
  obtain ⟨e, he, he_lift⟩ := hCompleteLift r D e_bar he_bar
  
  refine ⟨r, e, he, fun m => ?_⟩
  let B_m : Type u := D ⧸ Ideal.span {1 - e m}
  let Q_bar_m : Type u := D_bar ⧸ Ideal.span {1 - e_bar m}
  haveI : IsLocalRing Q_bar_m := hLoc_spec (σ m)
  haveI : Module.Finite A B_m :=
    Module.Finite.of_surjective
      (Ideal.Quotient.mkₐ A (Ideal.span {1 - e m})).toLinearMap Ideal.Quotient.mk_surjective
  have hInt_Bm : (algebraMap A B_m).IsIntegral :=
    Algebra.isIntegral_def.mp (Algebra.IsIntegral.of_finite A B_m)
  let mk_B : D →+* B_m := Ideal.Quotient.mk (Ideal.span {1 - e m})
  let q_m : D_bar →+* Q_bar_m := Ideal.Quotient.mk (Ideal.span {1 - e_bar m})
  have hf_ker : Ideal.span {1 - e m} ≤ RingHom.ker (q_m.comp π_D) := by
    rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, RingHom.comp_apply,
      map_sub, map_one, he_lift m]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
  let f_m : B_m →+* Q_bar_m := Ideal.Quotient.lift _ (q_m.comp π_D) hf_ker
  have hf_surj : Function.Surjective f_m := by
    intro w
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective w
    obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact ⟨mk_B d, rfl⟩
  have h_unit_reflect : ∀ b : B_m, IsUnit (f_m b) → IsUnit b := by
    intro b hu
    by_contra hnb
    obtain ⟨c, hc⟩ := hf_surj (↑(hu.unit⁻¹) : Q_bar_m)
    have hf_one : f_m (1 - b * c) = 0 := by
      rw [map_sub, map_one, map_mul, hc, IsUnit.mul_val_inv, sub_self]
    obtain ⟨d, hd⟩ := Ideal.Quotient.mk_surjective (1 - b * c)
    have hq_d : q_m (π_D d) = 0 := by
      change f_m (mk_B d) = 0
      rw [hd, hf_one]
    have hmem_bar : π_D d ∈ Ideal.span {1 - e_bar m} :=
      Ideal.Quotient.eq_zero_iff_mem.mp hq_d
    obtain ⟨y_bar, hy_bar⟩ := Ideal.mem_span_singleton.mp hmem_bar
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y_bar
    have hdiff_ID : d - (1 - e m) * z ∈ I_D := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change π_D (d - (1 - e m) * z) = 0
      rw [map_sub, map_mul, map_sub, map_one, he_lift m, ← hy_bar, sub_self]
    have h1_bc_mem : 1 - b * c ∈ Ideal.map (algebraMap A B_m) 𝔪_A := by
      have hmk_diff : mk_B (d - (1 - e m) * z) = 1 - b * c := by
        rw [map_sub, map_mul, hd]
        have hmk0 : mk_B (1 - e m) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
        rw [hmk0, zero_mul, sub_zero]
      rw [← hmk_diff]
      have hmap_Bm : Ideal.map (algebraMap A B_m) 𝔪_A = Ideal.map mk_B I_D := by
        dsimp [I_D]
        rw [Ideal.map_map]
        rfl
      rw [hmap_Bm]
      exact Ideal.mem_map_of_mem mk_B hdiff_ID
    have hspan_ne_top : Ideal.span ({b} : Set B_m) ≠ ⊤ :=
      mt Ideal.span_singleton_eq_top.mp hnb
    obtain ⟨𝔐, h𝔐_max, hb_le⟩ := Ideal.exists_le_maximal _ hspan_ne_top
    have hb_mem : b ∈ 𝔐 := hb_le (Ideal.mem_span_singleton_self b)
    have hcomap_max : (Ideal.comap (algebraMap A B_m) 𝔐).IsMaximal :=
      @Ideal.isMaximal_comap_of_isIntegral_of_isMaximal A B_m _ _ (algebraMap A B_m) hInt_Bm 𝔐 h𝔐_max
    have hcomap_eq : Ideal.comap (algebraMap A B_m) 𝔐 = 𝔪_A :=
      (IsLocalRing.isMaximal_iff A).mp hcomap_max
    have hmap_le : Ideal.map (algebraMap A B_m) 𝔪_A ≤ 𝔐 :=
      Ideal.map_le_iff_le_comap.mpr (le_of_eq hcomap_eq.symm)
    have h1_mem_M : (1 : B_m) ∈ 𝔐 := by
      have h1 : 1 - b * c ∈ 𝔐 := hmap_le h1_bc_mem
      have h2 : b * c ∈ 𝔐 := 𝔐.mul_mem_right c hb_mem
      simpa using add_mem h1 h2
    exact h𝔐_max.ne_top ((Ideal.eq_top_iff_one 𝔐).mpr h1_mem_M)
  haveI : Nontrivial B_m := f_m.domain_nontrivial
  refine IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun b => ?_
  rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (f_m b) with h1 | h2
  · exact Or.inl (h_unit_reflect b h1)
  · rw [← map_one f_m, ← map_sub] at h2
    exact Or.inr (h_unit_reflect (1 - b) h2)

theorem weil_sepClosed_local_alg_fiber_and_zmt_etale_section (A B Ω : Type u) [CommRing A] [IsLocalRing A]
    [CommRing B] [IsLocalRing B] [Algebra A B] [Module.Finite A B]
    [Field Ω] [Algebra A Ω]
    (hKerA : IsLocalRing.maximalIdeal A = RingHom.ker (algebraMap A Ω))
    (hSepA : IsSepClosed (IsLocalRing.ResidueField A))
    (hHenselB : ∀ (S' : Type u) [CommRing S'] [Algebra B S'] [Module.Finite B S'],
      ∃ (s : ℕ) (e : Fin s → S'),
        CompleteOrthogonalIdempotents e ∧
        ∀ j : Fin s, IsLocalRing (S' ⧸ Ideal.span {1 - e j})) :
    IsLocalRing (TensorProduct A Ω B) ∧
    (∀ (W : Type u) [CommRing W] [Algebra B W] [Algebra.Etale B W]
      (β₀ : W →+* TensorProduct A Ω B),
      β₀.comp (algebraMap B W) =
        (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A Ω B).toRingHom →
      ∃ (σ : W →ₐ[B] B),
        (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A Ω B).toRingHom.comp σ.toRingHom = β₀) :=
by
  classical
  let 𝔪_A : Ideal A := IsLocalRing.maximalIdeal A
  let 𝔪_B : Ideal B := IsLocalRing.maximalIdeal B
  let κ_A : Type u := IsLocalRing.ResidueField A
  let κ_B : Type u := IsLocalRing.ResidueField B
  have _ : Algebra.IsIntegral A B := Algebra.IsIntegral.of_finite A B
  have hMaxComapAB : (Ideal.comap (algebraMap A B) 𝔪_B).IsMaximal := by
    apply Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap A B)
      (Algebra.isIntegral_def.mp inferInstance)
  have hComapAB : Ideal.comap (algebraMap A B) 𝔪_B = 𝔪_A :=
    IsLocalRing.eq_maximalIdeal hMaxComapAB
  have _ : IsLocalHom (algebraMap A B) :=
    ⟨fun a ha => by
      rw [← IsLocalRing.notMem_maximalIdeal] at ha ⊢
      intro ha_mem
      apply ha
      change a ∈ 𝔪_A at ha_mem
      rw [← hComapAB] at ha_mem
      exact ha_mem⟩
