      rw [(F_L X'₀).map_comp, (F_L X'₀).map_comp, CategoryTheory.Category.assoc]
      rfl
    have h3 : w₃ ≫ p_g'₀ ≫ p_f₀ = q_gf := h_comp_hom g'₀ f₀ U
    have h2 : w₂ ≫ q_gf = q_fg := h_congr_inv hw U
    have h1 : w₁ ≫ q_fg = p_f'₀ ≫ p_g₀ := h_comp_inv f'₀ g₀ U
    change w_lhs ≫ p_g'₀ ≫ p_f₀ = p_f'₀ ≫ p_g₀
    calc w_lhs ≫ p_g'₀ ≫ p_f₀
      _ = w₁ ≫ w₂ ≫ (w₃ ≫ p_g'₀ ≫ p_f₀) := by rw [h_decomp]; simp only [CategoryTheory.Category.assoc]
      _ = w₁ ≫ (w₂ ≫ q_gf) := by rw [h3]
      _ = w₁ ≫ q_fg := by rw [h2]
      _ = p_f'₀ ≫ p_g₀ := h1

  have hOverPasteAlign : ∀ {𝒯 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒯]
      [CategoryTheory.Limits.HasPullbacks 𝒯] (P : CategoryTheory.MorphismProperty 𝒯)
      (h_pb : ∀ {Y₁ Y₂ : 𝒯} (h : Y₁ ⟶ Y₂), P.HasPullbacksAlong h)
      (h_bc : ∀ {Y₁ Y₂ : 𝒯} (h : Y₁ ⟶ Y₂), P.IsStableUnderBaseChangeAlong h)
      {X₀ S₀ S'₀ X'₀ S''₀ X''₀ : 𝒯}
      (f₀ : X₀ ⟶ S₀) (g₁ : S'₀ ⟶ S₀) (f'₀ : X'₀ ⟶ S'₀) (g'₁ : X'₀ ⟶ X₀)
      (g₂ : S''₀ ⟶ S'₀) (f''₀ : X''₀ ⟶ S''₀) (g'₂ : X''₀ ⟶ X'₀)
      (hw₁ : g'₁ ≫ f₀ = f'₀ ≫ g₁) (hw₂ : g'₂ ≫ f'₀ = f''₀ ≫ g₂)
      (hw₁₂ : (g'₂ ≫ g'₁) ≫ f₀ = f''₀ ≫ (g₂ ≫ g₁))
      (U : P.Over ⊤ S₀),
      letI := @h_pb
      letI := @h_bc
      let B_f₀ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ f₀
      let B_g₁ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ g₁
      let B_f'₀ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ f'₀
      let B_g'₁ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ g'₁
      let B_g₂ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ g₂
      let B_f''₀ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ f''₀
      let B_g'₂ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ g'₂
      let B_g₁₂ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ (g₂ ≫ g₁)
      let B_g'₁₂ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ (g'₂ ≫ g'₁)
      let e₁ : B_f₀ ⋙ B_g'₁ ≅ B_g₁ ⋙ B_f'₀ :=
        (CategoryTheory.MorphismProperty.Over.pullbackComp g'₁ f₀).symm ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackCongr hw₁ ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackComp f'₀ g₁
      let e₂ : B_f'₀ ⋙ B_g'₂ ≅ B_g₂ ⋙ B_f''₀ :=
        (CategoryTheory.MorphismProperty.Over.pullbackComp g'₂ f'₀).symm ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackCongr hw₂ ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackComp f''₀ g₂
      let e₁₂ : B_f₀ ⋙ B_g'₁₂ ≅ B_g₁₂ ⋙ B_f''₀ :=
        (CategoryTheory.MorphismProperty.Over.pullbackComp (g'₂ ≫ g'₁) f₀).symm ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackCongr hw₁₂ ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackComp f''₀ (g₂ ≫ g₁)
      let c_g := CategoryTheory.MorphismProperty.Over.pullbackComp (P := P) (Q := ⊤) g₂ g₁
      let c_g' := CategoryTheory.MorphismProperty.Over.pullbackComp (P := P) (Q := ⊤) g'₂ g'₁
      e₁₂.inv.app U ≫ c_g'.hom.app (B_f₀.obj U) =
        B_f''₀.map (c_g.hom.app U) ≫ e₂.inv.app (B_g₁.obj U) ≫ B_g'₂.map (e₁.inv.app U) := by
    intro 𝒯 _ _ P h_pb h_bc X₀ S₀ S'₀ X'₀ S''₀ X''₀ f₀ g₁ f'₀ g'₁ g₂ f''₀ g'₂ hw₁ hw₂ hw₁₂ U
    letI := @h_pb
    letI := @h_bc
    let B_f₀ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ f₀
    let B_g₁ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ g₁
    let B_f'₀ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ f'₀
    let B_g'₁ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ g'₁
    let B_g₂ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ g₂
    let B_f''₀ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ f''₀
    let B_g'₂ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ g'₂
    let B_g₁₂ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ (g₂ ≫ g₁)
    let B_g'₁₂ := CategoryTheory.MorphismProperty.Over.pullback P ⊤ (g'₂ ≫ g'₁)
    let e₁ : B_f₀ ⋙ B_g'₁ ≅ B_g₁ ⋙ B_f'₀ :=
      (CategoryTheory.MorphismProperty.Over.pullbackComp g'₁ f₀).symm ≪≫
        CategoryTheory.MorphismProperty.Over.pullbackCongr hw₁ ≪≫
        CategoryTheory.MorphismProperty.Over.pullbackComp f'₀ g₁
    let e₂ : B_f'₀ ⋙ B_g'₂ ≅ B_g₂ ⋙ B_f''₀ :=
      (CategoryTheory.MorphismProperty.Over.pullbackComp g'₂ f'₀).symm ≪≫
        CategoryTheory.MorphismProperty.Over.pullbackCongr hw₂ ≪≫
        CategoryTheory.MorphismProperty.Over.pullbackComp f''₀ g₂
    let e₁₂ : B_f₀ ⋙ B_g'₁₂ ≅ B_g₁₂ ⋙ B_f''₀ :=
      (CategoryTheory.MorphismProperty.Over.pullbackComp (g'₂ ≫ g'₁) f₀).symm ≪≫
        CategoryTheory.MorphismProperty.Over.pullbackCongr hw₁₂ ≪≫
        CategoryTheory.MorphismProperty.Over.pullbackComp f''₀ (g₂ ≫ g₁)
    let c_g := CategoryTheory.MorphismProperty.Over.pullbackComp (P := P) (Q := ⊤) g₂ g₁
    let c_g' := CategoryTheory.MorphismProperty.Over.pullbackComp (P := P) (Q := ⊤) g'₂ g'₁
    let lhs := e₁₂.inv.app U ≫ c_g'.hom.app (B_f₀.obj U)
    let rhs := B_f''₀.map (c_g.hom.app U) ≫ e₂.inv.app (B_g₁.obj U) ≫ B_g'₂.map (e₁.inv.app U)
    change lhs = rhs
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · let F_L : ∀ Z : 𝒯, P.Over ⊤ Z ⥤ 𝒯 := fun Z =>
        CategoryTheory.MorphismProperty.Over.forget P ⊤ Z ⋙ CategoryTheory.Over.forget Z
      let Y_src : 𝒯 := CategoryTheory.Limits.pullback (B_g₁₂.obj U).hom f''₀
      let X₁ : 𝒯 := CategoryTheory.Limits.pullback U.hom f₀
      let X₂ : 𝒯 := CategoryTheory.Limits.pullback (B_f₀.obj U).hom g'₁
      let X₃ : 𝒯 := CategoryTheory.Limits.pullback (B_g'₁.obj (B_f₀.obj U)).hom g'₂
      let l_hom : Y_src ⟶ X₃ := lhs.left
      let r_hom : Y_src ⟶ X₃ := rhs.left
      let p₁ : X₁ ⟶ U.left := CategoryTheory.Limits.pullback.fst U.hom f₀
      let p₂ : X₂ ⟶ X₁ := CategoryTheory.Limits.pullback.fst (B_f₀.obj U).hom g'₁
      let p₃ : X₃ ⟶ X₂ := CategoryTheory.Limits.pullback.fst (B_g'₁.obj (B_f₀.obj U)).hom g'₂
      let s₁ : X₁ ⟶ X₀ := CategoryTheory.Limits.pullback.snd U.hom f₀
      let s₂ : X₂ ⟶ X'₀ := CategoryTheory.Limits.pullback.snd (B_f₀.obj U).hom g'₁
      let s₃ : X₃ ⟶ X''₀ := CategoryTheory.Limits.pullback.snd (B_g'₁.obj (B_f₀.obj U)).hom g'₂
      have hw_eq : l_hom ≫ s₃ = r_hom ≫ s₃ :=
        (CategoryTheory.MorphismProperty.Over.w lhs).trans
          (CategoryTheory.MorphismProperty.Over.w rhs).symm
      let Z₁₂ : 𝒯 := CategoryTheory.Limits.pullback (B_f₀.obj U).hom (g'₂ ≫ g'₁)
      let u₁ : Y_src ⟶ Z₁₂ := (e₁₂.inv.app U).left
      let u₂ : Z₁₂ ⟶ X₃ := (c_g'.hom.app (B_f₀.obj U)).left
      let t_tgt : Y_src ⟶ U.left :=
        CategoryTheory.Limits.pullback.fst (B_g₁₂.obj U).hom f''₀ ≫
          CategoryTheory.Limits.pullback.fst U.hom (g₂ ≫ g₁)
      have hL : ((l_hom ≫ p₃) ≫ p₂) ≫ p₁ = t_tgt := by
        have h_lhs : l_hom = u₁ ≫ u₂ := (F_L X''₀).map_comp _ _
        let q₁₂ : Z₁₂ ⟶ X₁ := CategoryTheory.Limits.pullback.fst (B_f₀.obj U).hom (g'₂ ≫ g'₁)
        have hc_g' : u₂ ≫ p₃ ≫ p₂ = q₁₂ :=
          CategoryTheory.MorphismProperty.Over.pullbackComp_left_fst_fst
            (P := P) (Q := ⊤) g'₂ g'₁ (B_f₀.obj U)
        have h12 : u₁ ≫ q₁₂ ≫ p₁ = t_tgt :=
          hSqFst P h_pb h_bc f₀ (g₂ ≫ g₁) f''₀ (g'₂ ≫ g'₁) hw₁₂ U
        calc ((l_hom ≫ p₃) ≫ p₂) ≫ p₁
          _ = u₁ ≫ (u₂ ≫ p₃ ≫ p₂) ≫ p₁ := by rw [h_lhs]; simp only [CategoryTheory.Category.assoc]
          _ = u₁ ≫ q₁₂ ≫ p₁ := by rw [hc_g']
          _ = t_tgt := h12
      have hR : ((r_hom ≫ p₃) ≫ p₂) ≫ p₁ = t_tgt := by
        let M₁ : 𝒯 := CategoryTheory.Limits.pullback (B_g₂.obj (B_g₁.obj U)).hom f''₀
        let M₂ : 𝒯 := CategoryTheory.Limits.pullback (B_f'₀.obj (B_g₁.obj U)).hom g'₂
        let N₁ : 𝒯 := CategoryTheory.Limits.pullback (B_g₁.obj U).hom f'₀
        let K₁ : 𝒯 := CategoryTheory.Limits.pullback U.hom g₁
        let K₂ : 𝒯 := CategoryTheory.Limits.pullback (B_g₁.obj U).hom g₂
        let K₁₂ : 𝒯 := CategoryTheory.Limits.pullback U.hom (g₂ ≫ g₁)
        let v₁ : Y_src ⟶ M₁ := (B_f''₀.map (c_g.hom.app U)).left
        let v₂ : M₁ ⟶ M₂ := (e₂.inv.app (B_g₁.obj U)).left
        let v₃ : M₂ ⟶ X₃ := (B_g'₂.map (e₁.inv.app U)).left
        let e₁_inv : N₁ ⟶ X₂ := (e₁.inv.app U).left
        let cg_hom : K₁₂ ⟶ K₂ := (c_g.hom.app U).left
        let q₃ : M₂ ⟶ N₁ := CategoryTheory.Limits.pullback.fst (B_f'₀.obj (B_g₁.obj U)).hom g'₂
        let q₂ : N₁ ⟶ K₁ := CategoryTheory.Limits.pullback.fst (B_g₁.obj U).hom f'₀
        let r₁ : K₁ ⟶ U.left := CategoryTheory.Limits.pullback.fst U.hom g₁
        let r₂ : M₁ ⟶ K₂ := CategoryTheory.Limits.pullback.fst (B_g₂.obj (B_g₁.obj U)).hom f''₀
        let k₂ : K₂ ⟶ K₁ := CategoryTheory.Limits.pullback.fst (B_g₁.obj U).hom g₂
        let r₀ : Y_src ⟶ K₁₂ := CategoryTheory.Limits.pullback.fst (B_g₁₂.obj U).hom f''₀
        let k₁₂ : K₁₂ ⟶ U.left := CategoryTheory.Limits.pullback.fst U.hom (g₂ ≫ g₁)
        have h_rhs : r_hom = v₁ ≫ v₂ ≫ v₃ := by
          change (F_L X''₀).map rhs = _
          dsimp only [rhs]
          rw [(F_L X''₀).map_comp, (F_L X''₀).map_comp]
          rfl
        have hm₁ : v₃ ≫ p₃ = q₃ ≫ e₁_inv := by
          dsimp [v₃, p₃, q₃, e₁_inv, B_g'₂]
          erw [CategoryTheory.MorphismProperty.Over.pullback_map_left,
            CategoryTheory.Limits.pullback.lift_fst]
          rfl
        have hm₂ : v₁ ≫ r₂ = r₀ ≫ cg_hom := by
          dsimp [v₁, r₂, r₀, cg_hom, B_f''₀]
          erw [CategoryTheory.MorphismProperty.Over.pullback_map_left,
            CategoryTheory.Limits.pullback.lift_fst]
          rfl
        have h1 : e₁_inv ≫ p₂ ≫ p₁ = q₂ ≫ r₁ :=
          hSqFst P h_pb h_bc f₀ g₁ f'₀ g'₁ hw₁ U
        have h2 : v₂ ≫ q₃ ≫ q₂ = r₂ ≫ k₂ :=
          hSqFst P h_pb h_bc f'₀ g₂ f''₀ g'₂ hw₂ (B_g₁.obj U)
        have hc_g : cg_hom ≫ k₂ ≫ r₁ = k₁₂ :=
          CategoryTheory.MorphismProperty.Over.pullbackComp_left_fst_fst
            (P := P) (Q := ⊤) g₂ g₁ U
        calc ((r_hom ≫ p₃) ≫ p₂) ≫ p₁
          _ = v₁ ≫ v₂ ≫ (v₃ ≫ p₃) ≫ p₂ ≫ p₁ := by rw [h_rhs]; simp only [CategoryTheory.Category.assoc]
          _ = v₁ ≫ v₂ ≫ q₃ ≫ (e₁_inv ≫ p₂ ≫ p₁) := by rw [hm₁]; simp only [CategoryTheory.Category.assoc]
          _ = v₁ ≫ (v₂ ≫ q₃ ≫ q₂) ≫ r₁ := by rw [h1]; simp only [CategoryTheory.Category.assoc]
          _ = (v₁ ≫ r₂) ≫ k₂ ≫ r₁ := by rw [h2]; simp only [CategoryTheory.Category.assoc]
          _ = r₀ ≫ (cg_hom ≫ k₂ ≫ r₁) := by rw [hm₂]; simp only [CategoryTheory.Category.assoc]
          _ = r₀ ≫ k₁₂ := by rw [hc_g]
          _ = t_tgt := rfl
      have h_s3 : ((l_hom ≫ p₃) ≫ p₂) ≫ s₁ = ((r_hom ≫ p₃) ≫ p₂) ≫ s₁ := by
        have hc₁ : p₂ ≫ s₁ = s₂ ≫ g'₁ := CategoryTheory.Limits.pullback.condition
        have hc₂ : p₃ ≫ s₂ = s₃ ≫ g'₂ := CategoryTheory.Limits.pullback.condition
        simp only [CategoryTheory.Category.assoc]
        rw [hc₁, ← CategoryTheory.Category.assoc (f := p₃), hc₂,
          CategoryTheory.Category.assoc (f := s₃), ← CategoryTheory.Category.assoc (f := l_hom),
          hw_eq, CategoryTheory.Category.assoc (f := r_hom),
          ← CategoryTheory.Category.assoc (f := s₃), ← hc₂,
          CategoryTheory.Category.assoc (f := p₃), ← hc₁]
      have h_s2 : (l_hom ≫ p₃) ≫ s₂ = (r_hom ≫ p₃) ≫ s₂ := by
        have hc₂ : p₃ ≫ s₂ = s₃ ≫ g'₂ := CategoryTheory.Limits.pullback.condition
        rw [CategoryTheory.Category.assoc, hc₂, ← CategoryTheory.Category.assoc, hw_eq,
          CategoryTheory.Category.assoc, ← hc₂, ← CategoryTheory.Category.assoc]
      change l_hom = r_hom
      apply CategoryTheory.Limits.pullback.hom_ext
      · apply CategoryTheory.Limits.pullback.hom_ext
        · apply CategoryTheory.Limits.pullback.hom_ext
          · exact hL.trans hR.symm
          · exact h_s3
        · exact h_s2
      · exact hw_eq
    · exact Subsingleton.elim _ _

  have hBcPasteAbs : ∀ {𝒞_X 𝒞_S 𝒞_S' 𝒞_X' 𝒞_S'' 𝒞_X'' : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞_X]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞_S]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞_S']
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞_X']
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞_S'' ]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞_X'']
      (pf_f : 𝒞_X ⥤ 𝒞_S) (pf_f' : 𝒞_X' ⥤ 𝒞_S') (pf_f'' : 𝒞_X'' ⥤ 𝒞_S'')
      (pf_g₁ : 𝒞_S' ⥤ 𝒞_S) (pf_g₂ : 𝒞_S'' ⥤ 𝒞_S') (pf_g₁₂ : 𝒞_S'' ⥤ 𝒞_S)
      (pf_g'₁ : 𝒞_X' ⥤ 𝒞_X) (pf_g'₂ : 𝒞_X'' ⥤ 𝒞_X') (pf_g'₁₂ : 𝒞_X'' ⥤ 𝒞_X)
      (pb_g₁ : 𝒞_S ⥤ 𝒞_S') (pb_g₂ : 𝒞_S' ⥤ 𝒞_S'') (pb_g₁₂ : 𝒞_S ⥤ 𝒞_S'')
      (pb_g'₁ : 𝒞_X ⥤ 𝒞_X') (pb_g'₂ : 𝒞_X' ⥤ 𝒞_X'') (pb_g'₁₂ : 𝒞_X ⥤ 𝒞_X'')
      (adj_g₁ : pb_g₁ ⊣ pf_g₁) (adj_g₂ : pb_g₂ ⊣ pf_g₂) (adj_g₁₂ : pb_g₁₂ ⊣ pf_g₁₂)
      (adj_g'₁ : pb_g'₁ ⊣ pf_g'₁) (adj_g'₂ : pb_g'₂ ⊣ pf_g'₂) (adj_g'₁₂ : pb_g'₁₂ ⊣ pf_g'₁₂)
      (e_pf₁ : pf_g'₁ ⋙ pf_f ≅ pf_f' ⋙ pf_g₁)
      (e_pf₂ : pf_g'₂ ⋙ pf_f' ≅ pf_f'' ⋙ pf_g₂)
      (e_pf₁₂ : pf_g'₁₂ ⋙ pf_f ≅ pf_f'' ⋙ pf_g₁₂)
      (e_pf_g : pf_g₂ ⋙ pf_g₁ ≅ pf_g₁₂)
      (e_pf_g' : pf_g'₂ ⋙ pf_g'₁ ≅ pf_g'₁₂)
      (F : 𝒞_X),
      (pf_f.map (e_pf_g'.hom.app (pb_g'₂.obj (pb_g'₁.obj F))) ≫
          e_pf₁₂.hom.app (pb_g'₂.obj (pb_g'₁.obj F)) =
        e_pf₁.hom.app (pf_g'₂.obj (pb_g'₂.obj (pb_g'₁.obj F))) ≫
          pf_g₁.map (e_pf₂.hom.app (pb_g'₂.obj (pb_g'₁.obj F))) ≫
          e_pf_g.hom.app (pf_f''.obj (pb_g'₂.obj (pb_g'₁.obj F)))) →
      let F₁ := pb_g'₁.obj F
      let F₂ := pb_g'₂.obj F₁
      let bc₁ := (adj_g₁.homEquiv (pf_f.obj F) (pf_f'.obj F₁)).symm
        (pf_f.map (adj_g'₁.unit.app F) ≫ e_pf₁.hom.app F₁)
      let bc₂ := (adj_g₂.homEquiv (pf_f'.obj F₁) (pf_f''.obj F₂)).symm
        (pf_f'.map (adj_g'₂.unit.app F₁) ≫ e_pf₂.hom.app F₂)
      let bc₁₂ := (adj_g₁₂.homEquiv (pf_f.obj F) (pf_f''.obj (pb_g'₁₂.obj F))).symm
        (pf_f.map (adj_g'₁₂.unit.app F) ≫ e_pf₁₂.hom.app (pb_g'₁₂.obj F))
      let adj_g_comp := (adj_g₁.comp adj_g₂).ofNatIsoRight e_pf_g
      let adj_g'_comp := (adj_g'₁.comp adj_g'₂).ofNatIsoRight e_pf_g'
      let e_L := CategoryTheory.Adjunction.leftAdjointUniq adj_g₁₂ adj_g_comp
      let e_R := CategoryTheory.Adjunction.leftAdjointUniq adj_g'₁₂ adj_g'_comp
      bc₁₂ ≫ pf_f''.map (e_R.hom.app F) =
        e_L.hom.app (pf_f.obj F) ≫ pb_g₂.map bc₁ ≫ bc₂ := by
    intro 𝒞_X 𝒞_S 𝒞_S' 𝒞_X' 𝒞_S'' 𝒞_X'' _ _ _ _ _ _
      pf_f pf_f' pf_f'' pf_g₁ pf_g₂ pf_g₁₂ pf_g'₁ pf_g'₂ pf_g'₁₂
      pb_g₁ pb_g₂ pb_g₁₂ pb_g'₁ pb_g'₂ pb_g'₁₂
      adj_g₁ adj_g₂ adj_g₁₂ adj_g'₁ adj_g'₂ adj_g'₁₂
      e_pf₁ e_pf₂ e_pf₁₂ e_pf_g e_pf_g' F h_align
    let F₁ := pb_g'₁.obj F
    let F₂ := pb_g'₂.obj F₁
    let bc₁ := (adj_g₁.homEquiv (pf_f.obj F) (pf_f'.obj F₁)).symm
      (pf_f.map (adj_g'₁.unit.app F) ≫ e_pf₁.hom.app F₁)
    let bc₂ := (adj_g₂.homEquiv (pf_f'.obj F₁) (pf_f''.obj F₂)).symm
