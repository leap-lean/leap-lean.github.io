  let SC₀ : CategoryTheory.ShortComplex
      (CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}) :=
    CategoryTheory.ShortComplex.mk ι_LG p_G h0_LG
  have hKernel : CategoryTheory.Limits.IsLimit
      (CategoryTheory.Limits.KernelFork.ofι SC₀.f SC₀.zero) := by
    refine CategoryTheory.Limits.KernelFork.IsLimit.ofι SC₀.f SC₀.zero
      (fun {K} τ hτ => lift_hom τ hτ)
      (fun {K} τ hτ => ?_)
      (fun {K} τ hτ m hm => ?_)
    · ext U : 3
      apply AddCommGrpCat.ext
      intro x
      exact (hLift_ex τ hτ U x).choose_spec
    · ext U : 3
      apply AddCommGrpCat.ext
      intro x
      apply hΦ_inj (Fgt.obj (Opposite.unop U)).left (π_et (Opposite.unop U))
      have hm_app : Φ (Fgt.obj (Opposite.unop U)).left (π_et (Opposite.unop U))
          ((m.hom.app U).hom x) = (τ.hom.app U).hom x :=
        congrArg (fun g : K ⟶ G_sh => (g.hom.app U).hom x) hm
      exact hm_app.trans (hLift_ex τ hτ U x).choose_spec.symm
  have hExact₀ : SC₀.Exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel SC₀ hKernel
  have hEpi : CategoryTheory.Epi p_G := by
    constructor
    intro K α β hαβ
    have hK_type : CategoryTheory.Presheaf.IsSheaf X.left.smallEtaleTopology
        (K.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf X.left.smallEtaleTopology K.obj
        (CategoryTheory.forget AddCommGrpCat.{u}) K.property
    ext U : 3
    apply AddCommGrpCat.ext
    intro u
    obtain ⟨R, hR, hRoot⟩ := h_s5 (Opposite.unop U) u
    apply (hK_type.isSheafFor _ hR).isSeparatedFor.ext
    intro Z h hh
    obtain ⟨w, hw⟩ := hRoot h hh
    change (K.obj.map h.op).hom ((α.hom.app U).hom u) =
      (K.obj.map h.op).hom ((β.hom.app U).hom u)
    have hα_nat : (K.obj.map h.op).hom ((α.hom.app U).hom u) =
        (α.hom.app (Opposite.op Z)).hom (((G_sh.obj.map h.op).hom) u) :=
      (congrArg (fun g : G_sh.obj.obj U ⟶ K.obj.obj (Opposite.op Z) => g.hom u)
        (α.hom.naturality h.op)).symm
    have hβ_nat : (K.obj.map h.op).hom ((β.hom.app U).hom u) =
        (β.hom.app (Opposite.op Z)).hom (((G_sh.obj.map h.op).hom) u) :=
      (congrArg (fun g : G_sh.obj.obj U ⟶ K.obj.obj (Opposite.op Z) => g.hom u)
        (β.hom.naturality h.op)).symm
    have hαw : (α.hom.app (Opposite.op Z)).hom (((G_sh.obj.map h.op).hom) u) =
        ((p_G ≫ α).hom.app (Opposite.op Z)).hom w :=
      congrArg (α.hom.app (Opposite.op Z)).hom
        (hw.symm.trans (hp_G_app (Opposite.op Z) w).symm)
    have hβw : (β.hom.app (Opposite.op Z)).hom (((G_sh.obj.map h.op).hom) u) =
        ((p_G ≫ β).hom.app (Opposite.op Z)).hom w :=
      congrArg (β.hom.app (Opposite.op Z)).hom
        (hw.symm.trans (hp_G_app (Opposite.op Z) w).symm)
    exact (hα_nat.trans hαw).trans
      ((congrArg (fun g : G_sh ⟶ K => (g.hom.app (Opposite.op Z)).hom w) hαβ).trans
        (hβw.symm.trans hβ_nat.symm))
  have hSE₀ : SC₀.ShortExact :=
    { exact := hExact₀, mono_f := hMono, epi_g := hEpi }
  let ι_kum : weilEtaleTorsionSheaf X.left ℓ ⟶ weilEtaleGmSheaf X.left :=
    e_L.hom ≫ ι_LG ≫ e_G.hom
  let p_kum : weilEtaleGmSheaf X.left ⟶ weilEtaleGmSheaf X.left :=
    ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf X.left)
  have hp_comm : e_G.hom ≫ p_kum = p_G ≫ e_G.hom := by
    change e_G.hom ≫ (ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf X.left)) =
      (ℓ • CategoryTheory.CategoryStruct.id G_sh) ≫ e_G.hom
    rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Preadditive.nsmul_comp,
      CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
  have h0 : ι_kum ≫ p_kum = 0 := by
    change (e_L.hom ≫ ι_LG ≫ e_G.hom) ≫ p_kum = 0
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hp_comm,
      ← CategoryTheory.Category.assoc ι_LG p_G e_G.hom, h0_LG,
      CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
  refine ⟨ι_kum, p_kum, h0, rfl, ?_⟩
  let isoSC : SC₀ ≅ CategoryTheory.ShortComplex.mk ι_kum p_kum h0 :=
    CategoryTheory.ShortComplex.isoMk e_L.symm e_G e_G
      (e_L.inv_hom_id_assoc (ι_LG ≫ e_G.hom))
      hp_comm
  exact (CategoryTheory.ShortComplex.shortExact_iff_of_iso isoSC).mp hSE₀

theorem weil_etale_gm_isSheaf_and_proj_H0_divisible : (∀ X : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilEtaleGmPresheaf X)) ∧
    ∀ (k : Type u) [Field k] [IsAlgClosed k]
      (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C.left]
      (hProjC : IsProjectiveOverField k C)
      (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
      (x : (weilEtaleGmSheaf C.left).H 0),
      ∃ y : (weilEtaleGmSheaf C.left).H 0, ℓ • y = x :=
by
  classical
  
  have hAmitsur : ∀ (A : Type u) [CommRing A]
      (ι : Type u) [Fintype ι] [DecidableEq ι]
      (B : ι → Type u) [∀ i, CommRing (B i)] [∀ i, Algebra A (B i)],
      (∀ i : ι, Module.Flat A (B i)) →
      (∀ p : PrimeSpectrum A, ∃ (i : ι) (q : PrimeSpectrum (B i)),
        PrimeSpectrum.comap (algebraMap A (B i)) q = p) →
      (∀ (C : Type u) [CommRing C] [Algebra A C] (c₁ c₂ : C),
        (∀ i : ι, TensorProduct.tmul A (1 : B i) c₁ = TensorProduct.tmul A (1 : B i) c₂) →
        c₁ = c₂) ∧
      (∀ (b : ∀ i : ι, B i),
        (∀ i j : ι, TensorProduct.tmul A (b i) (1 : B j) = TensorProduct.tmul A (1 : B i) (b j)) →
        ∃ a : A, ∀ i : ι, algebraMap A (B i) a = b i) := by
    intro A _ ι _ _ B _ _ hFlat hSurj
    letI : ∀ i : ι, Module.Flat A (B i) := hFlat
    let P : Type u := ∀ i : ι, B i
    have hFlatDS : Module.Flat A (DirectSum ι B) := Module.Flat.directSum
    letI : Module.Flat A P :=
      Module.Flat.of_linearEquiv (DirectSum.linearEquivFunOnFintype A ι B).symm
    have hComapSurj : Function.Surjective (PrimeSpectrum.comap (algebraMap A P)) := by
      intro p
      obtain ⟨i, q, hq⟩ := hSurj p
      refine ⟨PrimeSpectrum.comap (Pi.evalRingHom B i) q, ?_⟩
      rw [← hq]
      ext x
      rfl
    letI : Module.FaithfullyFlat A P := Module.FaithfullyFlat.of_comap_surjective hComapSurj
    have hPiSum : ∀ x : P, x = ∑ i : ι, LinearMap.single A B i (x i) := by
      intro x
      ext j
      rw [Finset.sum_apply, Finset.sum_eq_single j]
      · change x j = Pi.single j (x j) j
        exact (Pi.single_eq_same j (x j)).symm
      · intro i _ hij
        change Pi.single i (x i) j = 0
        exact Pi.single_eq_of_ne hij.symm (x i)
      · intro hj
        exact False.elim (hj (Finset.mem_univ j))
    refine ⟨?_, ?_⟩
    · intro C _ _ c₁ c₂ hc
      apply Module.FaithfullyFlat.tensorProduct_mk_injective (A := A) (B := P) C
      change (1 : P) ⊗ₜ[A] c₁ = (1 : P) ⊗ₜ[A] c₂
      rw [hPiSum (1 : P), TensorProduct.sum_tmul, TensorProduct.sum_tmul]
      apply Finset.sum_congr rfl
      intro i _
      change (LinearMap.rTensor C (LinearMap.single A B i)) ((1 : B i) ⊗ₜ[A] c₁) =
        (LinearMap.rTensor C (LinearMap.single A B i)) ((1 : B i) ⊗ₜ[A] c₂)
      rw [hc i]
    · intro b hb
      let l12 : A →ₗ[A] P := Algebra.linearMap A P
      let l23 : P →ₗ[A] TensorProduct A P P :=
        { toFun := fun x => x ⊗ₜ[A] (1 : P) - (1 : P) ⊗ₜ[A] x
          map_add' := fun x y => by
            rw [TensorProduct.add_tmul, TensorProduct.tmul_add, sub_add_sub_comm]
          map_smul' := fun a x => by
            dsimp
            rw [smul_sub, TensorProduct.smul_tmul', TensorProduct.tmul_smul] }
      have hl_comp : ∀ a : A, l23 (l12 a) = 0 := by
        intro a
        change (algebraMap A P a) ⊗ₜ[A] (1 : P) - (1 : P) ⊗ₜ[A] (algebraMap A P a) = 0
        rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, sub_self]
      let μ : TensorProduct A P P →ₗ[A] TensorProduct A A P :=
        (TensorProduct.mk A A P (1 : A)).comp (LinearMap.mul' A P)
      let h₁ : TensorProduct A (TensorProduct A P P) P →ₗ[A] TensorProduct A P P :=
        (LinearMap.lTensor P (LinearMap.mul' A P)).comp
          (TensorProduct.assoc A P P P).toLinearMap
      let K : TensorProduct A P P →ₗ[A] TensorProduct A P P :=
        h₁.comp (LinearMap.rTensor P l23) + (LinearMap.rTensor P l12).comp μ
      have hK_id : K = LinearMap.id := by
        apply TensorProduct.ext'
        intro x y
        change h₁ ((LinearMap.rTensor P l23) (x ⊗ₜ[A] y)) +
          (LinearMap.rTensor P l12) (μ (x ⊗ₜ[A] y)) = x ⊗ₜ[A] y
        have hr1 : (LinearMap.rTensor P l23) (x ⊗ₜ[A] y) =
            (x ⊗ₜ[A] (1 : P)) ⊗ₜ[A] y - ((1 : P) ⊗ₜ[A] x) ⊗ₜ[A] y := by
          change l23 x ⊗ₜ[A] y = _
          dsimp [l23]
          exact TensorProduct.sub_tmul _ _ y
        have hh1 : h₁ (((x ⊗ₜ[A] (1 : P)) ⊗ₜ[A] y) - (((1 : P) ⊗ₜ[A] x) ⊗ₜ[A] y)) =
            x ⊗ₜ[A] y - (1 : P) ⊗ₜ[A] (x * y) := by
          rw [map_sub]
          have ht1 : h₁ ((x ⊗ₜ[A] (1 : P)) ⊗ₜ[A] y) = x ⊗ₜ[A] ((1 : P) * y) := rfl
          have ht2 : h₁ (((1 : P) ⊗ₜ[A] x) ⊗ₜ[A] y) = (1 : P) ⊗ₜ[A] (x * y) := rfl
          rw [ht1, ht2, one_mul]
        have hm1 : (LinearMap.rTensor P l12) (μ (x ⊗ₜ[A] y)) = (1 : P) ⊗ₜ[A] (x * y) := by
          change (algebraMap A P 1) ⊗ₜ[A] (x * y) = _
          rw [map_one]
        rw [hr1, hh1, hm1, sub_add_cancel]
      have hExact_r : Function.Exact (LinearMap.rTensor P l12) (LinearMap.rTensor P l23) := by
        intro z
        constructor
        · intro hz
          refine ⟨μ z, ?_⟩
          have hKz := congrArg (fun f : TensorProduct A P P →ₗ[A] TensorProduct A P P => f z) hK_id
          dsimp [K] at hKz
          rw [hz, map_zero, zero_add] at hKz
          exact hKz
        · rintro ⟨w, rfl⟩
          have hcomp0 : (LinearMap.rTensor P l23).comp (LinearMap.rTensor P l12) = 0 := by
            rw [← LinearMap.rTensor_comp]
            have hl0 : l23.comp l12 = 0 := LinearMap.ext hl_comp
            rw [hl0, LinearMap.rTensor_zero]
          exact congrArg (fun f => f w) hcomp0
      have hExact : Function.Exact l12 l23 :=
        Module.FaithfullyFlat.rTensor_reflects_exact A P l12 l23 hExact_r
      have hb0 : l23 b = 0 := by
        change b ⊗ₜ[A] (1 : P) - (1 : P) ⊗ₜ[A] b = 0
        rw [sub_eq_zero]
        conv_lhs => rw [hPiSum b, hPiSum (1 : P)]
        conv_rhs => rw [hPiSum (1 : P), hPiSum b]
        rw [TensorProduct.sum_tmul, TensorProduct.sum_tmul]
        apply Finset.sum_congr rfl
        intro i _
        rw [TensorProduct.tmul_sum, TensorProduct.tmul_sum]
        apply Finset.sum_congr rfl
        intro j _
        change (TensorProduct.map (LinearMap.single A B i) (LinearMap.single A B j))
            ((b i) ⊗ₜ[A] (1 : B j)) =
          (TensorProduct.map (LinearMap.single A B i) (LinearMap.single A B j))
            ((1 : B i) ⊗ₜ[A] (b j))
        rw [hb i j]
      obtain ⟨a, ha⟩ := (hExact b).mp hb0
      exact ⟨a, fun i => congrFun ha i⟩

  
  have hTopIso_ι : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Opens),
      V.ι.appTop ≫ V.topIso.hom =
        Z.presheaf.map (CategoryTheory.homOfLE (le_top : V ≤ ⊤)).op := by
    intro Z V
    rw [AlgebraicGeometry.Scheme.Opens.ι_appTop, AlgebraicGeometry.Scheme.Opens.topIso_hom]
    erw [← CategoryTheory.Functor.map_comp]
    congr 1

  have hTopIso_homOfLE : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {U V : Z.Opens} (e : U ≤ V),
      (Z.homOfLE e).appTop ≫ U.topIso.hom =
        V.topIso.hom ≫ Z.presheaf.map (CategoryTheory.homOfLE e).op := by
    intro Z U V e
    rw [AlgebraicGeometry.Scheme.homOfLE_appTop, AlgebraicGeometry.Scheme.Opens.topIso_hom,
      AlgebraicGeometry.Scheme.Opens.topIso_hom]
    erw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp]
    congr 1

  have hGlobalEqOfCover : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {ι_c : Type u}
      (V : ι_c → Z.Opens) (_ : iSup V = ⊤)
      (s₁ s₂ : ↑(Z.presheaf.obj (Opposite.op ⊤))),
      (∀ i : ι_c, (V i).ι.appTop.hom s₁ = (V i).ι.appTop.hom s₂) →
      s₁ = s₂ := by
    intro Z ι_c V hcov s₁ s₂ hs
    apply TopCat.Sheaf.eq_of_locally_eq' Z.sheaf V ⊤
      (fun i => CategoryTheory.homOfLE (le_top : V i ≤ ⊤)) (by rw [hcov])
    intro i
    have h1 : (V i).topIso.hom.hom ((V i).ι.appTop.hom s₁) =
        (Z.presheaf.map (CategoryTheory.homOfLE (le_top : V i ≤ ⊤)).op).hom s₁ :=
      congrArg (fun φ => φ.hom s₁) (hTopIso_ι Z (V i))
    have h2 : (V i).topIso.hom.hom ((V i).ι.appTop.hom s₂) =
        (Z.presheaf.map (CategoryTheory.homOfLE (le_top : V i ≤ ⊤)).op).hom s₂ :=
      congrArg (fun φ => φ.hom s₂) (hTopIso_ι Z (V i))
    change (Z.presheaf.map (CategoryTheory.homOfLE (le_top : V i ≤ ⊤)).op).hom s₁ =
      (Z.presheaf.map (CategoryTheory.homOfLE (le_top : V i ≤ ⊤)).op).hom s₂
    rw [← h1, ← h2, hs i]

  have hIsoSpecInvAppTop : ∀ (V : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine V],
      V.isoSpec.inv.appTop =
        (AlgebraicGeometry.Scheme.ΓSpecIso (V.presheaf.obj (Opposite.op ⊤))).inv := by
    intro V _
    have hhom : V.isoSpec.hom.appTop =
        (AlgebraicGeometry.Scheme.ΓSpecIso (V.presheaf.obj (Opposite.op ⊤))).hom :=
      AlgebraicGeometry.Scheme.toSpecΓ_appTop V
    have hid : V.isoSpec.hom.appTop ≫ V.isoSpec.inv.appTop = 𝟙 _ := by
      rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, V.isoSpec.inv_hom_id,
        AlgebraicGeometry.Scheme.Hom.id_appTop]
    rw [hhom] at hid
    calc
      V.isoSpec.inv.appTop =
          (AlgebraicGeometry.Scheme.ΓSpecIso _).inv ≫
            ((AlgebraicGeometry.Scheme.ΓSpecIso _).hom ≫ V.isoSpec.inv.appTop) := by
        rw [CategoryTheory.Iso.inv_hom_id_assoc]
      _ = (AlgebraicGeometry.Scheme.ΓSpecIso _).inv ≫ 𝟙 _ := by rw [hid]
      _ = (AlgebraicGeometry.Scheme.ΓSpecIso _).inv := CategoryTheory.Category.comp_id _

  
  have hGmSheaf : ∀ X : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilEtaleGmPresheaf X) := by
    intro X
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    let J := X.smallEtaleTopology
    have hMult : CategoryTheory.MorphismProperty.IsMultiplicative P_et := inferInstance
    have := hMult.toContainsIdentities
    have := hMult.toIsStableUnderComposition
    have hMemJ : ∀ (W : X.Etale) (S : CategoryTheory.Sieve W),
        S ∈ J W ↔ ∀ x : ↥W.left, ∃ (Y : X.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          S.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
      intro W S
      have hJ_eq :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) X le_rfl
      exact (Eq.to_iff (congrArg
        (fun G : CategoryTheory.GrothendieckTopology (P_et.Over ⊤ X) => S ∈ G W) hJ_eq)).trans
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) W S)

    let Fgt := AlgebraicGeometry.Scheme.Etale.forget X
    let G_ring : CategoryTheory.Functor (Opposite X.Etale) CommRingCat.{u} :=
      { obj := fun U => ((Fgt.obj (Opposite.unop U)).left).presheaf.obj (Opposite.op ⊤)
        map := fun f => ((Fgt.map (Opposite.unop f)).left).appTop
        map_id := fun U =>
          (congrArg AlgebraicGeometry.Scheme.Hom.appTop
            (congrArg CategoryTheory.CommaMorphism.left (Fgt.map_id (Opposite.unop U)))).trans
            AlgebraicGeometry.Scheme.Hom.id_appTop
        map_comp := fun f g =>
          (congrArg AlgebraicGeometry.Scheme.Hom.appTop
            (congrArg CategoryTheory.CommaMorphism.left
              (Fgt.map_comp (Opposite.unop g) (Opposite.unop f)))).trans
            (AlgebraicGeometry.Scheme.Hom.comp_appTop _ _) }
    let P_ring : CategoryTheory.Functor (Opposite X.Etale) (Type u) :=
      G_ring ⋙ CategoryTheory.forget CommRingCat.{u}

    
    have hAffinePullbackTensor : ∀ {W V₁ V₂ : X.Etale}
        [AlgebraicGeometry.IsAffine W.left]
        [AlgebraicGeometry.IsAffine V₁.left]
        [AlgebraicGeometry.IsAffine V₂.left]
        {S : CategoryTheory.Sieve W}
        (s_fam : CategoryTheory.Presieve.FamilyOfElements P_ring S.arrows)
        (_ : s_fam.Compatible)
        (u₁ : V₁ ⟶ W) (hu₁ : S.arrows u₁)
        (u₂ : V₂ ⟶ W) (hu₂ : S.arrows u₂),
        let A := ↑(W.left.presheaf.obj (Opposite.op ⊤))
        let R₁ := ↑(V₁.left.presheaf.obj (Opposite.op ⊤))
        let R₂ := ↑(V₂.left.presheaf.obj (Opposite.op ⊤))
        letI : Algebra A R₁ := u₁.left.appTop.hom.toAlgebra
        letI : Algebra A R₂ := u₂.left.appTop.hom.toAlgebra
        TensorProduct.tmul A (s_fam u₁ hu₁ : R₁) (1 : R₂) =
          TensorProduct.tmul A (1 : R₁) (s_fam u₂ hu₂ : R₂) := by
      intro W V₁ V₂ _ _ _ S s_fam hs_compat u₁ hu₁ u₂ hu₂
      let A := ↑(W.left.presheaf.obj (Opposite.op ⊤))
      let R₁ := ↑(V₁.left.presheaf.obj (Opposite.op ⊤))
      let R₂ := ↑(V₂.left.presheaf.obj (Opposite.op ⊤))
      letI : Algebra A R₁ := u₁.left.appTop.hom.toAlgebra
      letI : Algebra A R₂ := u₂.left.appTop.hom.toAlgebra
      have hu₂_et : AlgebraicGeometry.Etale u₂.left :=
        CategoryTheory.MorphismProperty.of_postcomp P_et u₂.left W.hom W.prop
          (by have hw : u₂.left ≫ W.hom = V₂.hom := CategoryTheory.MorphismProperty.Over.w u₂
              exact hw.symm ▸ V₂.prop)
      have hp₁_et : P_et (CategoryTheory.Limits.pullback.fst u₁.left u₂.left) := inferInstance
      let Z_pb : X.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.Limits.pullback.fst u₁.left u₂.left ≫ V₁.hom)
          (CategoryTheory.MorphismProperty.comp_mem P_et _ _ hp₁_et V₁.prop)
      let π₁ : Z_pb ⟶ V₁ :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.fst u₁.left u₂.left) rfl
      let π₂ : Z_pb ⟶ V₂ :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.snd u₁.left u₂.left)
          (by have hw₁ : u₁.left ≫ W.hom = V₁.hom := CategoryTheory.MorphismProperty.Over.w u₁
              have hw₂ : u₂.left ≫ W.hom = V₂.hom := CategoryTheory.MorphismProperty.Over.w u₂
              exact (congrArg (CategoryTheory.Limits.pullback.snd u₁.left u₂.left ≫ ·) hw₂.symm).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ W.hom) CategoryTheory.Limits.pullback.condition.symm).trans
                    ((CategoryTheory.Category.assoc _ _ _).trans (congrArg _ hw₁)))))
      have hcomm_pb : π₁ ≫ u₁ = π₂ ≫ u₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
      have hpb_eq : (CategoryTheory.Limits.pullback.fst u₁.left u₂.left).appTop.hom (s_fam u₁ hu₁) =
          (CategoryTheory.Limits.pullback.snd u₁.left u₂.left).appTop.hom (s_fam u₂ hu₂) :=
        hs_compat π₁ π₂ hu₁ hu₂ hcomm_pb
      let T := TensorProduct A R₁ R₂
      let inl : V₁.left.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of T :=
        CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
      let inr : V₂.left.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of T :=
        CommRingCat.ofHom (Algebra.TensorProduct.includeRight : R₂ →ₐ[A] T).toRingHom
      have hin : u₁.left.appTop ≫ inl = u₂.left.appTop ≫ inr := by
        ext a
        change (algebraMap A R₁ a) ⊗ₜ[A] (1 : R₂) = (1 : R₁) ⊗ₜ[A] (algebraMap A R₂ a)
        rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
          TensorProduct.smul_tmul]
      let q₁ : AlgebraicGeometry.Spec (CommRingCat.of T) ⟶ V₁.left :=
        AlgebraicGeometry.Spec.map inl ≫ V₁.left.isoSpec.inv
      let q₂ : AlgebraicGeometry.Spec (CommRingCat.of T) ⟶ V₂.left :=
        AlgebraicGeometry.Spec.map inr ≫ V₂.left.isoSpec.inv
      have hq : q₁ ≫ u₁.left = q₂ ≫ u₂.left := by
        dsimp [q₁, q₂]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Scheme.isoSpec_inv_naturality u₁.left,
          ← AlgebraicGeometry.Scheme.isoSpec_inv_naturality u₂.left,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp, hin]
      let ψ : AlgebraicGeometry.Spec (CommRingCat.of T) ⟶
          CategoryTheory.Limits.pullback u₁.left u₂.left :=
        CategoryTheory.Limits.pullback.lift q₁ q₂ hq
      have hq₁_app : q₁.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of T)).hom =
          inl := by
        have hq₁_def : q₁.appTop =
            V₁.left.isoSpec.inv.appTop ≫ (AlgebraicGeometry.Spec.map inl).appTop :=
          AlgebraicGeometry.Scheme.Hom.comp_appTop
            (AlgebraicGeometry.Spec.map inl) V₁.left.isoSpec.inv
        rw [hq₁_def, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.ΓSpecIso_naturality inl, hIsoSpecInvAppTop V₁.left,
          CategoryTheory.Iso.inv_hom_id_assoc]
      have hq₂_app : q₂.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of T)).hom =
          inr := by
        have hq₂_def : q₂.appTop =
            V₂.left.isoSpec.inv.appTop ≫ (AlgebraicGeometry.Spec.map inr).appTop :=
          AlgebraicGeometry.Scheme.Hom.comp_appTop
            (AlgebraicGeometry.Spec.map inr) V₂.left.isoSpec.inv
        rw [hq₂_def, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.ΓSpecIso_naturality inr, hIsoSpecInvAppTop V₂.left,
          CategoryTheory.Iso.inv_hom_id_assoc]
      have hLHS : inl.hom (s_fam u₁ hu₁) =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of T)).hom.hom
            (ψ.appTop.hom ((CategoryTheory.Limits.pullback.fst u₁.left u₂.left).appTop.hom
              (s_fam u₁ hu₁))) := by
        rw [← hq₁_app]
        have hlift1 : ψ ≫ CategoryTheory.Limits.pullback.fst u₁.left u₂.left = q₁ :=
          CategoryTheory.Limits.pullback.lift_fst q₁ q₂ hq
        rw [← hlift1, AlgebraicGeometry.Scheme.Hom.comp_appTop]
        rfl
      have hRHS : inr.hom (s_fam u₂ hu₂) =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of T)).hom.hom
            (ψ.appTop.hom ((CategoryTheory.Limits.pullback.snd u₁.left u₂.left).appTop.hom
              (s_fam u₂ hu₂))) := by
        rw [← hq₂_app]
        have hlift2 : ψ ≫ CategoryTheory.Limits.pullback.snd u₁.left u₂.left = q₂ :=
          CategoryTheory.Limits.pullback.lift_snd q₁ q₂ hq
        rw [← hlift2, AlgebraicGeometry.Scheme.Hom.comp_appTop]
        rfl
      change inl.hom (s_fam u₁ hu₁) = inr.hom (s_fam u₂ hu₂)
      rw [hLHS, hRHS, hpb_eq]

    
    have hAffineRingSheaf : ∀ (W : X.Etale) [AlgebraicGeometry.IsAffine W.left]
        (S : CategoryTheory.Sieve W) (_ : S ∈ J W),
        CategoryTheory.Presieve.IsSheafFor P_ring S.arrows := by
      intro W _ S hS s_fam hs_compat
      have hS_mem := (hMemJ W S).mp hS
      choose Y_x f_x y_x hf_x het_x hy_x using hS_mem
      have hAff_mem : ∀ x : ↥W.left, ∃ U' : (Y_x x).left.affineOpens, y_x x ∈ U'.1 := by
        intro x
        have htop : y_x x ∈ (⊤ : (Y_x x).left.Opens) := trivial
        rwa [← AlgebraicGeometry.iSup_affineOpens_eq_top (Y_x x).left,
          TopologicalSpace.Opens.mem_iSup] at htop
      choose U'_x hy'_x using hAff_mem
      let Z_x : ↥W.left → X.Etale := fun x =>
        CategoryTheory.MorphismProperty.Over.mk ⊤ ((U'_x x).1.ι ≫ (Y_x x).hom)
          (CategoryTheory.MorphismProperty.comp_mem P_et _ _ inferInstance (Y_x x).prop)
      let j_x : ∀ x : ↥W.left, Z_x x ⟶ Y_x x := fun x =>
        CategoryTheory.MorphismProperty.Over.homMk (U'_x x).1.ι rfl
      let h_x : ∀ x : ↥W.left, Z_x x ⟶ W := fun x => j_x x ≫ f_x x
      have hh_mem : ∀ x : ↥W.left, S.arrows (h_x x) :=
        fun x => S.downward_closed (hf_x x) (j_x x)
      have hh_et : ∀ x : ↥W.left, AlgebraicGeometry.Etale (h_x x).left := by
        intro x
        have : AlgebraicGeometry.Etale (f_x x).left := het_x x
        change P_et ((U'_x x).1.ι ≫ (f_x x).left)
        exact CategoryTheory.MorphismProperty.comp_mem P_et _ _ inferInstance (het_x x)
      have hnhds : ∀ x : ↥W.left, Set.range (h_x x).left.base ∈ nhds x := by
        intro x
        have : AlgebraicGeometry.Etale (h_x x).left := hh_et x
        apply IsOpen.mem_nhds (h_x x).left.isOpenMap.isOpen_range
        exact ⟨⟨y_x x, hy'_x x⟩, hy_x x⟩
      obtain ⟨F, hF_cov⟩ :=
        CompactSpace.elim_nhds_subcover (fun x : ↥W.left => Set.range (h_x x).left.base) hnhds
      let A := ↑(W.left.presheaf.obj (Opposite.op ⊤))
      let ι := { x : ↥W.left // x ∈ F }
      let B : ι → Type u := fun i => ↑((Z_x i.1).left.presheaf.obj (Opposite.op ⊤))
      letI : ∀ i : ι, CommRing (B i) := fun i => inferInstance
      letI : ∀ i : ι, Algebra A (B i) := fun i => ((h_x i.1).left.appTop.hom).toAlgebra
      have hZ_aff : ∀ i : ι, AlgebraicGeometry.IsAffine (Z_x i.1).left := by
        intro i
        change AlgebraicGeometry.IsAffine ((U'_x i.1).1 : AlgebraicGeometry.Scheme.{u})
        infer_instance
      have hFlat : ∀ i : ι, Module.Flat A (B i) := by
        intro i
        haveI : AlgebraicGeometry.IsAffine (Z_x i.1).left := hZ_aff i
        haveI : AlgebraicGeometry.Etale (h_x i.1).left := hh_et i.1
        have hSpec_eq : AlgebraicGeometry.Spec.map (h_x i.1).left.appTop =
            (Z_x i.1).left.isoSpec.inv ≫ (h_x i.1).left ≫ W.left.isoSpec.hom := by
          rw [← CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Scheme.isoSpec_inv_naturality (h_x i.1).left,
            CategoryTheory.Category.assoc, W.left.isoSpec.inv_hom_id,
            CategoryTheory.Category.comp_id]
        have hSpec_flat : AlgebraicGeometry.Flat
            (AlgebraicGeometry.Spec.map (h_x i.1).left.appTop) := by
          rw [hSpec_eq]
          infer_instance
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.Flat)).mp hSpec_flat
      have hSurj : ∀ p : PrimeSpectrum A, ∃ (i : ι) (q : PrimeSpectrum (B i)),
          PrimeSpectrum.comap (algebraMap A (B i)) q = p := by
        intro p
        let w₀ : ↥W.left := W.left.isoSpec.inv.base p
        have hw₀ : w₀ ∈ ⋃ x ∈ F, Set.range (h_x x).left.base := by
          rw [hF_cov]
          trivial
        rw [Set.mem_iUnion₂] at hw₀
        obtain ⟨x, hxF, z₀, hz₀⟩ := hw₀
        let i : ι := ⟨x, hxF⟩
        haveI : AlgebraicGeometry.IsAffine (Z_x i.1).left := hZ_aff i
        let q : PrimeSpectrum (B i) := (Z_x i.1).left.isoSpec.hom.base z₀
        refine ⟨i, q, ?_⟩
        change PrimeSpectrum.comap ((h_x i.1).left.appTop).hom q = p
        rw [← AlgebraicGeometry.Spec.map_apply ((h_x i.1).left.appTop) q]
        have hnat := AlgebraicGeometry.Scheme.isoSpec_hom_naturality (h_x i.1).left
        have h1 : (AlgebraicGeometry.Spec.map (h_x i.1).left.appTop).base q =
            W.left.isoSpec.hom.base ((h_x i.1).left.base z₀) := by
          dsimp [q]
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hnat,
            AlgebraicGeometry.Scheme.Hom.comp_apply]
        rw [h1, hz₀]
        exact congrArg (fun k => k.base p) W.left.isoSpec.inv_hom_id
      obtain ⟨hInjA, hDescA⟩ := hAmitsur A ι B hFlat hSurj
      let b : ∀ i : ι, B i := fun i => s_fam (h_x i.1) (hh_mem i.1)
      have hb_cocycle : ∀ i j : ι,
          TensorProduct.tmul A (b i) (1 : B j) = TensorProduct.tmul A (1 : B i) (b j) := by
        intro i j
        haveI : AlgebraicGeometry.IsAffine (Z_x i.1).left := hZ_aff i
        haveI : AlgebraicGeometry.IsAffine (Z_x j.1).left := hZ_aff j
        exact hAffinePullbackTensor s_fam hs_compat (h_x i.1) (hh_mem i.1) (h_x j.1) (hh_mem j.1)
      obtain ⟨a, ha⟩ := hDescA b hb_cocycle
      refine ⟨a, ?_, ?_⟩
      · intro Y g hg
        apply hGlobalEqOfCover Y.left (fun U'' : Y.left.affineOpens => U''.1)
          (AlgebraicGeometry.iSup_affineOpens_eq_top Y.left)
        intro U''
        let Y'' : X.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (U''.1.ι ≫ Y.hom)
            (CategoryTheory.MorphismProperty.comp_mem P_et _ _ inferInstance Y.prop)
        haveI : AlgebraicGeometry.IsAffine Y''.left := by
          change AlgebraicGeometry.IsAffine (U''.1 : AlgebraicGeometry.Scheme.{u})
          infer_instance
        let j'' : Y'' ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk U''.1.ι rfl
        let g'' : Y'' ⟶ W := j'' ≫ g
        have hg'' : S.arrows g'' := S.downward_closed hg j''
        have hs_j : U''.1.ι.appTop.hom (s_fam g hg) = s_fam g'' hg'' := by
          have hc := hs_compat j'' (𝟙 Y'') hg hg'' (CategoryTheory.Category.id_comp g'').symm
          have hid_s : (P_ring.map (𝟙 Y'').op) (s_fam g'' hg'') = s_fam g'' hg'' := by
            rw [op_id, P_ring.map_id]
            rfl
          exact hc.trans hid_s
        have ha_j : U''.1.ι.appTop.hom (g.left.appTop.hom a) = g''.left.appTop.hom a :=
          (congrArg (fun φ => φ.hom a)
            (AlgebraicGeometry.Scheme.Hom.comp_appTop U''.1.ι g.left)).symm
        change U''.1.ι.appTop.hom (g.left.appTop.hom a) = U''.1.ι.appTop.hom (s_fam g hg)
        rw [ha_j, hs_j]
        let C := ↑(Y''.left.presheaf.obj (Opposite.op ⊤))
        letI : Algebra A C := g''.left.appTop.hom.toAlgebra
        let c₂ : C := s_fam g'' hg''
        change g''.left.appTop.hom a = c₂
        apply hInjA C
        intro i
        haveI : AlgebraicGeometry.IsAffine (Z_x i.1).left := hZ_aff i
        have h_ov : TensorProduct.tmul A (b i) (1 : C) =
            TensorProduct.tmul A (1 : B i) c₂ :=
          hAffinePullbackTensor s_fam hs_compat (h_x i.1) (hh_mem i.1) g'' hg''
        have h_alg : TensorProduct.tmul A (b i) (1 : C) =
            TensorProduct.tmul A (1 : B i) (g''.left.appTop.hom a : C) := by
          rw [← ha i]
          change (algebraMap A (B i) a) ⊗ₜ[A] (1 : C) = (1 : B i) ⊗ₜ[A] (algebraMap A C a)
          rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
            TensorProduct.smul_tmul]
        exact h_alg.symm.trans h_ov
      · intro a' ha'
        let a'_A : A := a'
        change a'_A = a
        apply hInjA A
        intro i
        have ha'_i : algebraMap A (B i) a'_A = b i := ha' (h_x i.1) (hh_mem i.1)
        have h1 : TensorProduct.tmul A (1 : B i) a'_A = TensorProduct.tmul A (b i) (1 : A) := by
          rw [← ha'_i, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, smul_eq_mul,
            mul_one]
        have h2 : TensorProduct.tmul A (1 : B i) a = TensorProduct.tmul A (b i) (1 : A) := by
          rw [← ha i, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, smul_eq_mul,
            mul_one]
        exact h1.trans h2.symm

    
    have hRingSheaf : CategoryTheory.Presieve.IsSheaf J P_ring := by
      intro U R hR s_fam hs_compat
      let W_of : U.left.Opens → X.Etale := fun V =>
        CategoryTheory.MorphismProperty.Over.mk ⊤ (V.ι ≫ U.hom)
          (CategoryTheory.MorphismProperty.comp_mem P_et _ _ inferInstance U.prop)
      let j_of : ∀ V : U.left.Opens, W_of V ⟶ U := fun V =>
        CategoryTheory.MorphismProperty.Over.homMk V.ι rfl
      let R_of : ∀ V : U.left.Opens, CategoryTheory.Sieve (W_of V) :=
        fun V => R.pullback (j_of V)
      have hR_of : ∀ V : U.left.Opens, R_of V ∈ J (W_of V) :=
        fun V => J.pullback_stable (j_of V) hR
      let s_of : ∀ V : U.left.Opens,
          CategoryTheory.Presieve.FamilyOfElements P_ring (R_of V).arrows :=
        fun V Y f hf => s_fam (f ≫ j_of V) hf
      have hs_of : ∀ V : U.left.Opens, (s_of V).Compatible := by
        intro V Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
        exact hs_compat g₁ g₂ hf₁ hf₂
          ((CategoryTheory.Category.assoc g₁ f₁ (j_of V)).symm.trans
            ((congrArg (· ≫ j_of V) hcomm).trans (CategoryTheory.Category.assoc g₂ f₂ (j_of V))))
      have hAffW : ∀ V : U.left.affineOpens, AlgebraicGeometry.IsAffine (W_of V.1).left := by
        intro V
        change AlgebraicGeometry.IsAffine (V.1 : AlgebraicGeometry.Scheme.{u})
        infer_instance
      let a_top : ∀ V : U.left.affineOpens, ↑((W_of V.1).left.presheaf.obj (Opposite.op ⊤)) :=
        fun V =>
          letI := hAffW V
          (hAffineRingSheaf (W_of V.1) (R_of V.1) (hR_of V.1)).amalgamate
            (s_of V.1) (hs_of V.1)
      have ha_top_glue : ∀ (V : U.left.affineOpens) {Y : X.Etale} (f : Y ⟶ W_of V.1)
          (hf : (R_of V.1).arrows f),
          f.left.appTop.hom (a_top V) = s_of V.1 f hf := by
        intro V Y f hf
        letI := hAffW V
        exact (hAffineRingSheaf (W_of V.1) (R_of V.1) (hR_of V.1)).valid_glue
          (hs_of V.1) f hf
      have ha_top_uniq : ∀ (V : U.left.affineOpens)
          (t : ↑((W_of V.1).left.presheaf.obj (Opposite.op ⊤))),
          (∀ {Y : X.Etale} (f : Y ⟶ W_of V.1) (hf : (R_of V.1).arrows f),
            f.left.appTop.hom t = s_of V.1 f hf) →
          t = a_top V := by
        intro V t ht
        letI := hAffW V
        exact (hAffineRingSheaf (W_of V.1) (R_of V.1) (hR_of V.1)).isSeparatedFor.ext
          fun Y f hf => (ht f hf).trans (ha_top_glue V f hf).symm
      let sf : ∀ V : U.left.affineOpens, ↑(U.left.presheaf.obj (Opposite.op V.1)) :=
        fun V => V.1.topIso.hom.hom (a_top V)
      have hsf_compat : TopCat.Presheaf.IsCompatible U.left.presheaf
          (fun V : U.left.affineOpens => V.1) sf := by
        intro V₁ V₂
        let ι_inter := { W : U.left.affineOpens // W.1 ≤ V₁.1 ⊓ V₂.1 }
        have hle_inter : V₁.1 ⊓ V₂.1 ≤ ⨆ W : ι_inter, W.1.1 := by
          intro x hx
          rw [TopologicalSpace.Opens.mem_iSup]
          obtain ⟨_, ⟨V₃, hV₃_aff, rfl⟩, hx₃, hsub₃⟩ :=
            TopologicalSpace.IsTopologicalBasis.exists_subset_of_mem_open
              (AlgebraicGeometry.Scheme.isBasis_affineOpens U.left) hx (V₁.1 ⊓ V₂.1).isOpen
          exact ⟨⟨⟨V₃, hV₃_aff⟩, hsub₃⟩, hx₃⟩
        apply TopCat.Sheaf.eq_of_locally_eq' U.left.sheaf
          (fun W : ι_inter => W.1.1) (V₁.1 ⊓ V₂.1)
          (fun W => CategoryTheory.homOfLE W.2) hle_inter
        intro ⟨V₃, h₃⟩
        have h₃₁ : V₃.1 ≤ V₁.1 := h₃.trans inf_le_left
        have h₃₂ : V₃.1 ≤ V₂.1 := h₃.trans inf_le_right
        have hres_eq : ∀ (V₀ : U.left.affineOpens) (h₀ : V₃.1 ≤ V₀.1),
            (U.left.presheaf.map (CategoryTheory.homOfLE h₀).op).hom (sf V₀) = sf V₃ := by
          intro V₀ h₀
          let ι₀ : W_of V₃.1 ⟶ W_of V₀.1 :=
            CategoryTheory.MorphismProperty.Over.homMk (U.left.homOfLE h₀)
              (by change (U.left.homOfLE h₀ ≫ V₀.1.ι) ≫ U.hom = V₃.1.ι ≫ U.hom
                  rw [U.left.homOfLE_ι h₀])
          have hι_j : ι₀ ≫ j_of V₀.1 = j_of V₃.1 :=
            CategoryTheory.MorphismProperty.Over.Hom.ext (U.left.homOfLE_ι h₀)
          have h_app_eq : (U.left.homOfLE h₀).appTop.hom (a_top V₀) = a_top V₃ := by
            apply ha_top_uniq V₃
            intro Y f hf
            have hf₀ : (R_of V₀.1).arrows (f ≫ ι₀) := by
              change R.arrows ((f ≫ ι₀) ≫ j_of V₀.1)
              rw [CategoryTheory.Category.assoc, hι_j]
              exact hf
            have hc1 : f.left.appTop.hom ((U.left.homOfLE h₀).appTop.hom (a_top V₀)) =
                (f ≫ ι₀).left.appTop.hom (a_top V₀) :=
              (congrArg (fun φ => φ.hom (a_top V₀))
                (AlgebraicGeometry.Scheme.Hom.comp_appTop f.left (U.left.homOfLE h₀))).symm
            have hc2 : s_of V₀.1 (f ≫ ι₀) hf₀ = s_of V₃.1 f hf := by
              dsimp [s_of]
              congr 1
              rw [CategoryTheory.Category.assoc, hι_j]
            exact hc1.trans ((ha_top_glue V₀ (f ≫ ι₀) hf₀).trans hc2)
          have hcomm_iso : V₃.1.topIso.hom.hom ((U.left.homOfLE h₀).appTop.hom (a_top V₀)) =
              (U.left.presheaf.map (CategoryTheory.homOfLE h₀).op).hom
                (V₀.1.topIso.hom.hom (a_top V₀)) :=
            congrArg (fun φ => φ.hom (a_top V₀)) (hTopIso_homOfLE U.left h₀)
          dsimp [sf]
          rw [← hcomm_iso, h_app_eq]
        have hcomp₁ : (U.left.presheaf.map (CategoryTheory.homOfLE h₃).op).hom
            ((U.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (sf V₁)) =
            (U.left.presheaf.map (CategoryTheory.homOfLE h₃₁).op).hom (sf V₁) :=
          (congrArg (fun φ => φ.hom (sf V₁))
            (U.left.presheaf.map_comp
              (CategoryTheory.homOfLE inf_le_left).op
              (CategoryTheory.homOfLE h₃).op)).symm
        have hcomp₂ : (U.left.presheaf.map (CategoryTheory.homOfLE h₃).op).hom
            ((U.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (sf V₂)) =
            (U.left.presheaf.map (CategoryTheory.homOfLE h₃₂).op).hom (sf V₂) :=
          (congrArg (fun φ => φ.hom (sf V₂))
            (U.left.presheaf.map_comp
              (CategoryTheory.homOfLE inf_le_right).op
              (CategoryTheory.homOfLE h₃).op)).symm
        change (U.left.presheaf.map (CategoryTheory.homOfLE h₃).op).hom
            ((U.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (sf V₁)) =
          (U.left.presheaf.map (CategoryTheory.homOfLE h₃).op).hom
            ((U.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (sf V₂))
        rw [hcomp₁, hcomp₂, hres_eq V₁ h₃₁, hres_eq V₂ h₃₂]
      obtain ⟨s_sup, hs_sup, _⟩ :=
        TopCat.Sheaf.existsUnique_gluing U.left.sheaf
          (fun V : U.left.affineOpens => V.1) sf hsf_compat
      have hcovU : (⨆ V : U.left.affineOpens, V.1) = ⊤ :=
        AlgebraicGeometry.iSup_affineOpens_eq_top U.left
      let a_U : ↑(U.left.presheaf.obj (Opposite.op ⊤)) :=
        (U.left.presheaf.map (CategoryTheory.eqToHom hcovU.symm).op).hom s_sup
      have ha_U_V : ∀ V : U.left.affineOpens, V.1.ι.appTop.hom a_U = a_top V := by
        intro V
        have hmap_eq : U.left.presheaf.map (CategoryTheory.eqToHom hcovU.symm).op ≫
            U.left.presheaf.map (CategoryTheory.homOfLE (le_top : V.1 ≤ ⊤)).op =
            U.left.presheaf.map
              (CategoryTheory.homOfLE (le_iSup (fun W : U.left.affineOpens => W.1) V)).op := by
          rw [← CategoryTheory.Functor.map_comp]
          congr 1
        have h1 : V.1.topIso.hom.hom (V.1.ι.appTop.hom a_U) = sf V := by
          have h_iot : V.1.topIso.hom.hom (V.1.ι.appTop.hom a_U) =
              (U.left.presheaf.map (CategoryTheory.homOfLE (le_top : V.1 ≤ ⊤)).op).hom a_U :=
            congrArg (fun φ => φ.hom a_U) (hTopIso_ι U.left V.1)
          have h_map :
              (U.left.presheaf.map (CategoryTheory.homOfLE (le_top : V.1 ≤ ⊤)).op).hom a_U =
              (U.left.presheaf.map
                (CategoryTheory.homOfLE (le_iSup (fun W : U.left.affineOpens => W.1) V)).op).hom
                s_sup :=
            congrArg (fun φ => φ.hom s_sup) hmap_eq
          exact h_iot.trans (h_map.trans (hs_sup V))
        have ht1 : V.1.ι.appTop.hom a_U =
            V.1.topIso.inv.hom (V.1.topIso.hom.hom (V.1.ι.appTop.hom a_U)) :=
          (congrArg (fun φ => φ.hom (V.1.ι.appTop.hom a_U)) V.1.topIso.hom_inv_id).symm
        have ht2 : V.1.topIso.inv.hom (V.1.topIso.hom.hom (V.1.ι.appTop.hom a_U)) =
            V.1.topIso.inv.hom (sf V) :=
          congrArg V.1.topIso.inv.hom h1
        have ht3 : V.1.topIso.inv.hom (sf V) = a_top V :=
          congrArg (fun φ => φ.hom (a_top V)) V.1.topIso.hom_inv_id
        exact ht1.trans (ht2.trans ht3)
      refine ⟨a_U, ?_, ?_⟩
      · intro Y f hf
        let O_V : U.left.affineOpens → Y.left.Opens :=
          fun V => (TopologicalSpace.Opens.map f.left.base).obj V.1
        have hcovY : (⨆ V : U.left.affineOpens, O_V V) = ⊤ := by
          rw [eq_top_iff]
          intro y _
          rw [TopologicalSpace.Opens.mem_iSup]
          have hy_top : f.left.base y ∈ (⊤ : U.left.Opens) := trivial
          rw [← hcovU, TopologicalSpace.Opens.mem_iSup] at hy_top
          exact hy_top
        apply hGlobalEqOfCover Y.left O_V hcovY
        intro V
        have hrange : Set.range ((O_V V).ι ≫ f.left).base ⊆ Set.range V.1.ι.base := by
          rintro _ ⟨y, rfl⟩
          exact ⟨⟨f.left.base y.1, y.2⟩, rfl⟩
        let f_V : (O_V V).toScheme ⟶ V.1.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift V.1.ι ((O_V V).ι ≫ f.left) hrange
        have hf_V : f_V ≫ V.1.ι = (O_V V).ι ≫ f.left :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac V.1.ι ((O_V V).ι ≫ f.left) hrange
        let Y_V : X.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ ((O_V V).ι ≫ Y.hom)
            (CategoryTheory.MorphismProperty.comp_mem P_et _ _ inferInstance Y.prop)
        let i_V : Y_V ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk (O_V V).ι rfl
        let g_V : Y_V ⟶ W_of V.1 :=
          CategoryTheory.MorphismProperty.Over.homMk f_V
            (by change f_V ≫ V.1.ι ≫ U.hom = (O_V V).ι ≫ Y.hom
                rw [← CategoryTheory.Category.assoc, hf_V, CategoryTheory.Category.assoc,
                  CategoryTheory.MorphismProperty.Over.w f])
        have hg_j : g_V ≫ j_of V.1 = i_V ≫ f :=
          CategoryTheory.MorphismProperty.Over.Hom.ext hf_V
        have hi_f : R.arrows (i_V ≫ f) := R.downward_closed hf i_V
        have hg_R : (R_of V.1).arrows g_V := by
          change R.arrows (g_V ≫ j_of V.1)
          rw [hg_j]
          exact hi_f
        have hLHS : (O_V V).ι.appTop.hom (f.left.appTop.hom a_U) =
            s_fam (g_V ≫ j_of V.1) hg_R := by
          have hc1 : (O_V V).ι.appTop.hom (f.left.appTop.hom a_U) =
              ((O_V V).ι ≫ f.left).appTop.hom a_U :=
            (congrArg (fun φ => φ.hom a_U)
              (AlgebraicGeometry.Scheme.Hom.comp_appTop (O_V V).ι f.left)).symm
          have hc2 : ((O_V V).ι ≫ f.left).appTop.hom a_U = (f_V ≫ V.1.ι).appTop.hom a_U := by
            rw [hf_V]
          have hc3 : (f_V ≫ V.1.ι).appTop.hom a_U = f_V.appTop.hom (V.1.ι.appTop.hom a_U) :=
            congrArg (fun φ => φ.hom a_U)
              (AlgebraicGeometry.Scheme.Hom.comp_appTop f_V V.1.ι)
          have hc4 : f_V.appTop.hom (V.1.ι.appTop.hom a_U) = f_V.appTop.hom (a_top V) :=
            congrArg f_V.appTop.hom (ha_U_V V)
          exact hc1.trans (hc2.trans (hc3.trans (hc4.trans (ha_top_glue V g_V hg_R))))
        have hRHS : (O_V V).ι.appTop.hom (s_fam f hf) = s_fam (i_V ≫ f) hi_f := by
          have hc := hs_compat i_V (𝟙 Y_V) hf hi_f
            (CategoryTheory.Category.id_comp (i_V ≫ f)).symm
          have hid_s : (P_ring.map (𝟙 Y_V).op) (s_fam (i_V ≫ f) hi_f) =
              s_fam (i_V ≫ f) hi_f := by
            rw [op_id, P_ring.map_id]
            rfl
          exact hc.trans hid_s
        change (O_V V).ι.appTop.hom (f.left.appTop.hom a_U) =
          (O_V V).ι.appTop.hom (s_fam f hf)
        rw [hLHS, hRHS]
        congr 1
      · intro a' ha'
        let a'_U : ↑(U.left.presheaf.obj (Opposite.op ⊤)) := a'
        change a'_U = a_U
        apply hGlobalEqOfCover U.left (fun V : U.left.affineOpens => V.1) hcovU
        intro V
        rw [ha_U_V V]
        apply ha_top_uniq V
        intro Y f hf
        have hc1 : f.left.appTop.hom (V.1.ι.appTop.hom a'_U) =
            (f ≫ j_of V.1).left.appTop.hom a'_U :=
          (congrArg (fun φ => φ.hom a'_U)
            (AlgebraicGeometry.Scheme.Hom.comp_appTop f.left V.1.ι)).symm
        exact hc1.trans (ha' (f ≫ j_of V.1) hf)

    
    apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J (weilEtaleGmPresheaf X)
      (CategoryTheory.forget AddCommGrpCat.{u})
    rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
    intro U R hR u_fam hu_compat
    have hR_gen : CategoryTheory.Sieve.generate R.arrows ∈ J U := by
      rwa [CategoryTheory.Sieve.generate_sieve]
    let u_at : ∀ {Y : X.Etale} (f : Y ⟶ U), R.arrows f →
        Units ↑(Y.left.presheaf.obj (Opposite.op ⊤)) :=
      fun {Y} f hf =>
        @Additive.toMul (Units ↑(Y.left.presheaf.obj (Opposite.op ⊤))) (u_fam f hf)
    let a_fam : CategoryTheory.Presieve.FamilyOfElements P_ring R.arrows :=
      fun Y f hf => (u_at f hf).val
    let b_fam : CategoryTheory.Presieve.FamilyOfElements P_ring R.arrows :=
      fun Y f hf => (u_at f hf).inv
    have ha_compat : a_fam.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      have hu_eq : Units.map g₁.left.appTop.hom.toMonoidHom (u_at f₁ hf₁) =
          Units.map g₂.left.appTop.hom.toMonoidHom (u_at f₂ hf₂) :=
        congrArg (@Additive.toMul (Units ↑(Z.left.presheaf.obj (Opposite.op ⊤))))
          (hu_compat g₁ g₂ hf₁ hf₂ hcomm)
      exact congrArg Units.val hu_eq
    have hb_compat : b_fam.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      have hu_eq : Units.map g₁.left.appTop.hom.toMonoidHom (u_at f₁ hf₁) =
          Units.map g₂.left.appTop.hom.toMonoidHom (u_at f₂ hf₂) :=
        congrArg (@Additive.toMul (Units ↑(Z.left.presheaf.obj (Opposite.op ⊤))))
          (hu_compat g₁ g₂ hf₁ hf₂ hcomm)
      exact congrArg Units.inv hu_eq
    let a : ↑(U.left.presheaf.obj (Opposite.op ⊤)) :=
      (hRingSheaf.isSheafFor R.arrows hR_gen).amalgamate a_fam ha_compat
    let b : ↑(U.left.presheaf.obj (Opposite.op ⊤)) :=
      (hRingSheaf.isSheafFor R.arrows hR_gen).amalgamate b_fam hb_compat
    have ha_glue : ∀ {Y : X.Etale} (f : Y ⟶ U) (hf : R.arrows f),
        f.left.appTop.hom a = a_fam f hf :=
      fun f hf => (hRingSheaf.isSheafFor R.arrows hR_gen).valid_glue ha_compat f hf
    have hb_glue : ∀ {Y : X.Etale} (f : Y ⟶ U) (hf : R.arrows f),
        f.left.appTop.hom b = b_fam f hf :=
      fun f hf => (hRingSheaf.isSheafFor R.arrows hR_gen).valid_glue hb_compat f hf
    have hab : a * b = 1 := by
      apply (hRingSheaf.isSheafFor R.arrows hR_gen).isSeparatedFor.ext
      intro Y f hf
      change f.left.appTop.hom (a * b) = f.left.appTop.hom 1
      rw [map_mul, map_one, ha_glue f hf, hb_glue f hf]
      exact (u_at f hf).val_inv
    have hba : b * a = 1 := (mul_comm b a).trans hab
    let u₀ : Additive (Units ↑(U.left.presheaf.obj (Opposite.op ⊤))) :=
      Additive.ofMul ⟨a, b, hab, hba⟩
    refine ⟨u₀, ?_, ?_⟩
    · intro Y f hf
      apply (@Additive.toMul (Units ↑(Y.left.presheaf.obj (Opposite.op ⊤)))).injective
      apply Units.ext
      exact ha_glue f hf
    · intro u' hu'
      apply (@Additive.toMul (Units ↑(U.left.presheaf.obj (Opposite.op ⊤)))).injective
      apply Units.ext
      apply (hRingSheaf.isSheafFor R.arrows hR_gen).isSeparatedFor.ext
      intro Y f hf
      have hu'_f : Units.map f.left.appTop.hom.toMonoidHom
          (@Additive.toMul (Units ↑(U.left.presheaf.obj (Opposite.op ⊤))) u') =
          u_at f hf :=
        congrArg (@Additive.toMul (Units ↑(Y.left.presheaf.obj (Opposite.op ⊤)))) (hu' f hf)
      exact (congrArg Units.val hu'_f).trans (ha_glue f hf).symm

  
  refine ⟨hGmSheaf, ?_⟩
  intro k _ _ C _ hProjC ℓ _ x
  
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have hMult : CategoryTheory.MorphismProperty.IsMultiplicative P_et := inferInstance
  have := hMult.toContainsIdentities
  let J_C := C.left.smallEtaleTopology
  let T_C : C.left.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (CategoryTheory.CategoryStruct.id C.left)
      (CategoryTheory.MorphismProperty.id_mem P_et C.left)
  have hT_C : CategoryTheory.Limits.IsTerminal T_C :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom))
      (fun U g => CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.comp_id g.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w g)))
  let P_gm := weilEtaleGmPresheaf C.left
  let F_gm := weilEtaleGmSheaf C.left
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let adj_C := CategoryTheory.constantSheafAdj J_C AddCommGrpCat.{u} hT_C
  let e₁ : F_gm.H 0 ≃+ (((CategoryTheory.constantSheaf J_C AddCommGrpCat.{u}).obj Aℤ) ⟶ F_gm) :=
    CategoryTheory.Abelian.Ext.addEquiv₀
  let e₂ : (((CategoryTheory.constantSheaf J_C AddCommGrpCat.{u}).obj Aℤ) ⟶ F_gm) ≃+
      (Aℤ ⟶ F_gm.obj.obj (Opposite.op T_C)) :=
    { adj_C.homEquiv Aℤ F_gm with
      map_add' := fun φ₁ φ₂ => by
        change adj_C.unit.app Aℤ ≫ (φ₁ + φ₂).hom.app (Opposite.op T_C) =
          adj_C.unit.app Aℤ ≫ φ₁.hom.app (Opposite.op T_C) +
            adj_C.unit.app Aℤ ≫ φ₂.hom.app (Opposite.op T_C)
        have happ : (φ₁ + φ₂).hom.app (Opposite.op T_C) =
            φ₁.hom.app (Opposite.op T_C) + φ₂.hom.app (Opposite.op T_C) := rfl
        rw [happ, CategoryTheory.Preadditive.comp_add] }
  let G₀ := F_gm.obj.obj (Opposite.op T_C)
  let e₃ : (Aℤ ⟶ G₀) ≃+ ↥G₀ :=
    { toFun := fun f => f.hom (ULift.up (1 : ℤ))
      invFun := fun m => AddCommGrpCat.ofHom
        { toFun := fun n => n.down • m
          map_zero' := zero_zsmul m
          map_add' := fun a b => add_zsmul m a.down b.down }
      left_inv := fun f => by
        apply AddCommGrpCat.ext
        rintro ⟨n⟩
        change n • f.hom (ULift.up (1 : ℤ)) = f.hom (ULift.up n)
        have hn : (ULift.up n : ULift.{u} ℤ) = n • (ULift.up (1 : ℤ) : ULift.{u} ℤ) :=
          ULift.ext _ _ (by simp)
        rw [hn, map_zsmul]
      right_inv := fun m => one_zsmul m
      map_add' := fun f₁ f₂ => rfl }
  let iso_gm : P_gm ≅ F_gm.obj := CategoryTheory.isoSheafify J_C (hGmSheaf C.left)
  let α_T := iso_gm.app (Opposite.op T_C)
  let e₄ : ↥G₀ ≃+ Additive (Units ↑(C.left.presheaf.obj (Opposite.op ⊤))) :=
    { toFun := α_T.inv.hom
      invFun := α_T.hom.hom
      left_inv := fun m => congrArg (fun φ => φ.hom m) α_T.inv_hom_id
      right_inv := fun m => congrArg (fun φ => φ.hom m) α_T.hom_inv_id
      map_add' := α_T.inv.hom.map_add }
  let e_H0 : F_gm.H 0 ≃+ Additive (Units ↑(C.left.presheaf.obj (Opposite.op ⊤))) :=
    ((e₁.trans e₂).trans e₃).trans e₄

  
  rcases hProjC with ⟨N, ι_proj, hCl_ι⟩
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
  letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
    ⟨fun c a p => smul_mul_assoc c a.1 p⟩
  have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
    Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
  let p_proj : (weilProjectiveSpaceOver k N).left ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥(𝒜 0)) :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜
  have : AlgebraicGeometry.IsProper p_proj :=
    AlgebraicGeometry.Proj.instIsProperToSpecZeroOfFiniteTypeSubtypeMemOfNatNat 𝒜
  have : AlgebraicGeometry.IsClosedImmersion ι_proj.left := hCl_ι
  let g_zero : C.left ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(𝒜 0)) :=
    ι_proj.left ≫ p_proj
  have hg_int : g_zero.appTop.hom.IsIntegral :=
    AlgebraicGeometry.isIntegral_appTop_of_universallyClosed g_zero
  let α₀ : k →+* ↥(𝒜 0) := algebraMap k ↥(𝒜 0)
  have hα₀_surj : Function.Surjective α₀ := by
    intro f
    refine ⟨MvPolynomial.constantCoeff f.1, ?_⟩
    apply Subtype.ext
    have hf_deg : f.1.totalDegree = 0 :=
      (MvPolynomial.totalDegree_zero_iff_isHomogeneous (Fin (N + 1))).mpr f.2
    have hf_C : f.1 = MvPolynomial.C (MvPolynomial.constantCoeff f.1) := by
      rw [MvPolynomial.constantCoeff_eq]
      exact MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp hf_deg
    exact hf_C.symm
  have hα₀_int : α₀.IsIntegral := RingHom.isIntegral_of_surjective α₀ hα₀_surj
  let β₀ : ↥(𝒜 0) →+* ↑((AlgebraicGeometry.Spec (CommRingCat.of ↥(𝒜 0))).presheaf.obj (Opposite.op ⊤)) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥(𝒜 0))).inv.hom
  have hβ₀_surj : Function.Surjective β₀ := by
    intro s
    refine ⟨(AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥(𝒜 0))).hom.hom s, ?_⟩
    exact congrArg (fun φ => φ.hom s)
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥(𝒜 0))).hom_inv_id
  have hβ₀_int : β₀.IsIntegral := RingHom.isIntegral_of_surjective β₀ hβ₀_surj
  let φ_k : k →+* ↑(C.left.presheaf.obj (Opposite.op ⊤)) :=
    g_zero.appTop.hom.comp (β₀.comp α₀)
  have hφ_int : φ_k.IsIntegral :=
    RingHom.IsIntegral.trans (β₀.comp α₀) g_zero.appTop.hom
      (RingHom.IsIntegral.trans α₀ β₀ hα₀_int hβ₀_int) hg_int
  have hφ_bij : Function.Bijective φ_k :=
    IsAlgClosed.ringHom_bijective_of_isIntegral φ_k hφ_int
  let e_ring : k ≃+* ↑(C.left.presheaf.obj (Opposite.op ⊤)) :=
    RingEquiv.ofBijective φ_k hφ_bij

  
  let e_units : Additive (Units k) ≃+ Additive (Units ↑(C.left.presheaf.obj (Opposite.op ⊤))) :=
    MulEquiv.toAdditive (Units.mapEquiv e_ring.toMulEquiv)
  let e_tot : Additive (Units k) ≃+ (weilEtaleGmSheaf C.left).H 0 :=
    e_units.trans e_H0.symm
  let u : Units k := Additive.toMul (e_tot.symm x)
  have hPrime : Nat.Prime ℓ := Fact.out
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (u : k) hPrime.pos
  have hz_ne : z ≠ 0 := by
    intro hz0
    apply Units.ne_zero u
    rw [← hz, hz0, zero_pow hPrime.ne_zero]
  let v : Units k := Units.mk0 z hz_ne
  have hv_pow : v ^ ℓ = u := Units.ext hz
  have hv_smul : ℓ • Additive.ofMul v = e_tot.symm x := by
    rw [← ofMul_pow, hv_pow]
    rfl
  refine ⟨e_tot (Additive.ofMul v), ?_⟩
  rw [← map_nsmul, hv_smul, e_tot.apply_symm_apply]

theorem weil_etale_qc_sep_cech_vanishing_implies_H_subsingleton (X : AlgebraicGeometry.Scheme.{u}) [CompactSpace ↥X] [X.IsSeparated]
    (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
    (hCech : ∀ (U W : X.Etale) [CompactSpace ↥U.left] [U.left.IsSeparated]
        [AlgebraicGeometry.IsAffine W.left] (w : W ⟶ U) [AlgebraicGeometry.Surjective w.left]
        (p : ℕ) (c : ↥(F.obj.obj (Opposite.op (weilEtaleCechObj w (p + 1))))),
      weilEtaleCechDiff F.obj w (p + 1) c = 0 →
      ∃ b : ↥(F.obj.obj (Opposite.op (weilEtaleCechObj w p))),
        weilEtaleCechDiff F.obj w p b = c)
    (q : ℕ) (hq : 1 ≤ q) :
    Subsingleton (F.H q) :=
by
  classical
  let P_et : MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
  let J := X.smallEtaleTopology
  let ℤ_u := AddCommGrpCat.of (ULift.{u} ℤ)
  have hMult : MorphismProperty.IsMultiplicative P_et := inferInstance
  have := hMult.toContainsIdentities
  have := hMult.toIsStableUnderComposition

  
  
  
  have hProjLast : ∀ {W U : X.Etale} (w : W ⟶ U) (p : ℕ),
      weilEtaleCechProj w (p + 1) (Fin.last (p + 1)) =
        Limits.pullback.snd (weilEtaleCechHom w p) w := by
    intro W U w p
    dsimp only [weilEtaleCechProj, weilEtaleCechProjSub]
    rw [Fin.lastCases_last]

  have hProjCast : ∀ {W U : X.Etale} (w : W ⟶ U) (p : ℕ) (j : Fin (p + 1)),
      weilEtaleCechProj w (p + 1) j.castSucc =
        Limits.pullback.fst (weilEtaleCechHom w p) w ≫ weilEtaleCechProj w p j := by
    intro W U w p j
    dsimp only [weilEtaleCechProj, weilEtaleCechProjSub]
    rw [Fin.lastCases_castSucc]
    rfl

  have hLiftProj : ∀ {W U Z : X.Etale} (w : W ⟶ U) (h : Z ⟶ U) (p : ℕ)
      (g : Fin (p + 1) → (Z ⟶ W)) (hg : ∀ i, g i ≫ w = h) (i : Fin (p + 1)),
      (weilEtaleCechLiftSub w h p g hg).1 ≫ weilEtaleCechProj w p i = g i := by
    intro W U Z w h p
    induction p with
    | zero =>
      intro g hg i
      have hi : i = 0 := Fin.eq_zero i
      subst hi
      change g 0 ≫ 𝟙 W = g 0
      exact Category.comp_id (g 0)
    | succ p ih =>
      intro g hg i
      refine Fin.lastCases ?_ ?_ i
      · exact (congrArg ((weilEtaleCechLiftSub w h (p + 1) g hg).1 ≫ ·) (hProjLast w p)).trans
          (Limits.pullback.lift_snd _ _ _)
      · intro j
        exact (congrArg ((weilEtaleCechLiftSub w h (p + 1) g hg).1 ≫ ·) (hProjCast w p j)).trans
          ((Limits.pullback.lift_fst_assoc _ _ _ _).trans
            (ih (fun k => g k.castSucc) (fun k => hg k.castSucc) j))

  have hCechExt : ∀ {W U Z : X.Etale} (w : W ⟶ U) (p : ℕ)
      {l₁ l₂ : Z ⟶ weilEtaleCechObj w p},
      (∀ i : Fin (p + 1), l₁ ≫ weilEtaleCechProj w p i = l₂ ≫ weilEtaleCechProj w p i) →
      l₁ = l₂ := by
    intro W U Z w p
    induction p with
    | zero =>
      intro (l₁ : Z ⟶ W) (l₂ : Z ⟶ W) h
      have h0 : l₁ ≫ 𝟙 W = l₂ ≫ 𝟙 W := h 0
      rwa [Category.comp_id, Category.comp_id] at h0
    | succ p ih =>
      intro (l₁ : Z ⟶ Limits.pullback (weilEtaleCechHom w p) w)
            (l₂ : Z ⟶ Limits.pullback (weilEtaleCechHom w p) w) h
      refine Limits.pullback.hom_ext (ih fun j => ?_) ?_
      · exact (Category.assoc _ _ _).trans
          (((congrArg (l₁ ≫ ·) (hProjCast w p j)).symm.trans (h j.castSucc)).trans
            ((congrArg (l₂ ≫ ·) (hProjCast w p j)).trans (Category.assoc _ _ _).symm))
      · exact ((congrArg (l₁ ≫ ·) (hProjLast w p)).symm.trans (h (Fin.last (p + 1)))).trans
          (congrArg (l₂ ≫ ·) (hProjLast w p))

  have hFaceProj : ∀ {W U : X.Etale} (w : W ⟶ U) (p : ℕ) (j : Fin (p + 2)) (i : Fin (p + 1)),
      weilEtaleCechFace w p j ≫ weilEtaleCechProj w p i =
        weilEtaleCechProj w (p + 1) (j.succAbove i) := by
    intro W U w p j i
    exact hLiftProj w (weilEtaleCechHom w (p + 1)) p _ _ i

  have hFaceHom : ∀ {W U : X.Etale} (w : W ⟶ U) (p : ℕ) (j : Fin (p + 2)),
      weilEtaleCechFace w p j ≫ weilEtaleCechHom w p = weilEtaleCechHom w (p + 1) := by
    intro W U w p j
    exact (weilEtaleCechLiftSub w (weilEtaleCechHom w (p + 1)) p
      (fun i => weilEtaleCechProj w (p + 1) (j.succAbove i))
      (fun i => (weilEtaleCechProjSub w (p + 1) (j.succAbove i)).2)).2

  have hFace0_zero : ∀ {W U : X.Etale} (w : W ⟶ U),
      weilEtaleCechFace w 0 0 = Limits.pullback.snd w w := by
    intro W U w
    apply hCechExt w 0
    intro i
    have hi : i = 0 := Fin.eq_zero i
    subst hi
    rw [hFaceProj, show (0 : Fin 2).succAbove (0 : Fin 1) = Fin.last 1 from rfl, hProjLast]
    change Limits.pullback.snd w w = Limits.pullback.snd w w ≫ 𝟙 W
    exact (Category.comp_id _).symm

  have hFace0_one : ∀ {W U : X.Etale} (w : W ⟶ U),
      weilEtaleCechFace w 0 1 = Limits.pullback.fst w w := by
    intro W U w
    apply hCechExt w 0
    intro i
    have hi : i = 0 := Fin.eq_zero i
    subst hi
    rw [hFaceProj, show (1 : Fin 2).succAbove (0 : Fin 1) = (0 : Fin 1).castSucc from rfl, hProjCast]
    rfl

  have hDiff0_raw : ∀ (P : Functor (Opposite X.Etale) AddCommGrpCat.{u}) {W U : X.Etale}
      (w : W ⟶ U) (x : ↥(P.obj (Opposite.op (weilEtaleCechObj w 0)))),
      weilEtaleCechDiff P w 0 x =
        (P.map (weilEtaleCechFace w 0 0).op).hom x -
          (P.map (weilEtaleCechFace w 0 1).op).hom x := by
    intro P W U w x
    dsimp [weilEtaleCechDiff]
    rw [Fin.sum_univ_two, AddMonoidHom.add_apply, AddMonoidHom.smul_apply, AddMonoidHom.smul_apply]
    have hp0 : (-1 : ℤ) ^ ((0 : Fin 2) : ℕ) = 1 := rfl
    have hp1 : (-1 : ℤ) ^ ((1 : Fin 2) : ℕ) = -1 := rfl
    rw [hp0, hp1, one_zsmul, neg_one_zsmul, sub_eq_add_neg]

  have hDiff0 : ∀ (P : Functor (Opposite X.Etale) AddCommGrpCat.{u}) {W U : X.Etale}
      (w : W ⟶ U) (x : ↥(P.obj (Opposite.op W))),
      weilEtaleCechDiff P w 0 x =
        (P.map (weilEtaleCechFace w 0 0).op).hom x -
          (P.map (weilEtaleCechFace w 0 1).op).hom x :=
    fun P {_ _} w x => hDiff0_raw P w x

  have hFaceSimp : ∀ {W U : X.Etale} (w : W ⟶ U) (p : ℕ) (i j : Fin (p + 2)),
      (i : ℕ) ≤ (j : ℕ) →
      weilEtaleCechFace w (p + 1) j.succ ≫ weilEtaleCechFace w p i =
        weilEtaleCechFace w (p + 1) i.castSucc ≫ weilEtaleCechFace w p j := by
    intro W U w p i j hij
    apply hCechExt w p
    intro r
    rw [Category.assoc, hFaceProj, hFaceProj, Category.assoc, hFaceProj, hFaceProj]
    congr 1
    apply Fin.ext
    dsimp only [Fin.succAbove]
    split_ifs <;> simp only [Fin.lt_def, Fin.val_succ, Fin.val_castSucc] at * <;> omega

  have hDiffSq : ∀ (P : Functor (Opposite X.Etale) AddCommGrpCat.{u}) {W U : X.Etale}
      (w : W ⟶ U) (p : ℕ) (x : ↥(P.obj (Opposite.op (weilEtaleCechObj w p)))),
      weilEtaleCechDiff P w (p + 1) (weilEtaleCechDiff P w p x) = 0 := by
    intro P W U w p x
    have hexpand : weilEtaleCechDiff P w (p + 1) (weilEtaleCechDiff P w p x) =
        ∑ k : Fin (p + 3), ∑ i : Fin (p + 2),
          ((-1 : ℤ) ^ (k : ℕ) * (-1 : ℤ) ^ (i : ℕ)) •
            (P.map (weilEtaleCechFace w (p + 1) k ≫ weilEtaleCechFace w p i).op).hom x := by
      dsimp [weilEtaleCechDiff]
      rw [AddMonoidHom.finsetSum_apply]
      apply Finset.sum_congr rfl
      intro k _
      rw [AddMonoidHom.smul_apply, AddMonoidHom.finsetSum_apply, map_sum, Finset.smul_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [AddMonoidHom.smul_apply, map_zsmul, smul_smul]
      congr 1
      change ((P.map (weilEtaleCechFace w p i).op ≫ P.map (weilEtaleCechFace w (p + 1) k).op).hom) x = _
      rw [← P.map_comp, ← op_comp]
    rw [hexpand, ← Fintype.sum_prod_type']
    let inv : Fin (p + 3) × Fin (p + 2) → Fin (p + 3) × Fin (p + 2) :=
      fun q =>
        if (q.2 : ℕ) < (q.1 : ℕ) then
          (q.2.castSucc, ⟨(q.1 : ℕ) - 1, by omega⟩)
        else
          (q.2.succ, ⟨min (q.1 : ℕ) (p + 1), by omega⟩)
    exact Finset.sum_involution (fun q _ => inv q)
      (fun ⟨k, i⟩ _ => by
        dsimp only [inv]
        split_ifs with h
        · let j : Fin (p + 2) := ⟨(k : ℕ) - 1, by omega⟩
          change ((-1 : ℤ) ^ (k : ℕ) * (-1 : ℤ) ^ (i : ℕ)) •
              (P.map (weilEtaleCechFace w (p + 1) k ≫ weilEtaleCechFace w p i).op).hom x +
            ((-1 : ℤ) ^ (i.castSucc : ℕ) * (-1 : ℤ) ^ (j : ℕ)) •
              (P.map (weilEtaleCechFace w (p + 1) i.castSucc ≫ weilEtaleCechFace w p j).op).hom x = 0
          have hk : j.succ = k := by ext; dsimp [j]; omega
          have hij : (i : ℕ) ≤ (j : ℕ) := by dsimp [j]; omega
          rw [← hk, hFaceSimp w p i j hij, ← add_zsmul]
          have hsign : (-1 : ℤ) ^ (j.succ : ℕ) * (-1 : ℤ) ^ (i : ℕ) +
              (-1 : ℤ) ^ (i.castSucc : ℕ) * (-1 : ℤ) ^ (j : ℕ) = 0 := by
            simp only [Fin.val_succ, Fin.val_castSucc, pow_succ]
            ring
          rw [hsign, zero_zsmul]
        · let i' : Fin (p + 2) := ⟨min (k : ℕ) (p + 1), by omega⟩
