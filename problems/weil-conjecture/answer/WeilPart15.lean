    have hProp2 : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) := inferInstance
    have hProp3 : AlgebraicGeometry.IsProper (AlgebraicGeometry.Spec.map f₀) := inferInstance
    have hComp : Y.hom = ι.left ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
