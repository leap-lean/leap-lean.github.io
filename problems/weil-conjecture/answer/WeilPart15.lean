        Algebra.IsSeparable.isIntegral (IsLocalRing.ResidueField Ω) y
      obtain ⟨P_pol, hP_monic, hP_eval⟩ := hy_int
      have h_bij : Function.Bijective (IsLocalRing.residue Ω) :=
        ⟨RingHom.injective _, Ideal.Quotient.mk_surjective⟩
      let e_res : Ω ≃+* IsLocalRing.ResidueField Ω := RingEquiv.ofBijective _ h_bij
      let Q_pol : Polynomial Ω := P_pol.map e_res.symm.toRingHom
      have hQ_monic : Q_pol.Monic := hP_monic.map _
      have hQ_map : Q_pol.map (IsLocalRing.residue Ω) = P_pol := by
        dsimp [Q_pol]
        rw [Polynomial.map_map]
        have h_id : (IsLocalRing.residue Ω).comp
            (e_res.symm : IsLocalRing.ResidueField Ω →+* Ω) = RingHom.id _ := by
          ext z; exact e_res.apply_symm_apply z
        rw [h_id, Polynomial.map_id]
