      map_add' := fun _ _ => rfl }
  let ev₀ : ∀ F : CategoryTheory.Sheaf J AddCommGrpCat.{u},
      F.H 0 ≃+ ↥(F.obj.obj (Opposite.op T_X)) := fun F =>
    CategoryTheory.Abelian.Ext.addEquiv₀.trans
      ((e_adj F).trans (e_Z (F.obj.obj (Opposite.op T_X))))
  have hev_nat : ∀ {F₁ F₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (φ : F₁ ⟶ F₂) (x : F₁.H 0),
      ev₀ F₂ (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ (Nat.add_zero 0)) x) =
        (φ.hom.app (Opposite.op T_X)).hom (ev₀ F₁ x) := by
    intro F₁ F₂ φ x
    let f : Fℤ ⟶ F₁ := CategoryTheory.Abelian.Ext.addEquiv₀ x
    have hx : CategoryTheory.Abelian.Ext.mk₀ f = x :=
      CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x
    have hpost : ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ (Nat.add_zero 0)) x =
        CategoryTheory.Abelian.Ext.mk₀ (f ≫ φ) := by
      change x.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0) = _
      rw [← hx, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    have hmk_eq : CategoryTheory.Abelian.Ext.mk₀ (f ≫ φ) =
        CategoryTheory.Abelian.Ext.addEquiv₀.symm (f ≫ φ) := by
      have hsymm := CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply
        (CategoryTheory.Abelian.Ext.addEquiv₀.symm (f ≫ φ))
      rwa [CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply] at hsymm
    have hadd_fφ : CategoryTheory.Abelian.Ext.addEquiv₀
        (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ (Nat.add_zero 0)) x) = f ≫ φ := by
      rw [hpost, hmk_eq, CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply]
    have hnat_adj : adj.homEquiv Aℤ F₂ (f ≫ φ) =
        adj.homEquiv Aℤ F₁ f ≫ φ.hom.app (Opposite.op T_X) :=
      adj.homEquiv_naturality_right f φ
    change (adj.homEquiv Aℤ F₂
        (CategoryTheory.Abelian.Ext.addEquiv₀
          (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ (Nat.add_zero 0)) x))).hom
        (ULift.up (1 : ℤ)) =
      (φ.hom.app (Opposite.op T_X)).hom ((adj.homEquiv Aℤ F₁ f).hom (ULift.up (1 : ℤ)))
    rw [hadd_fφ, hnat_adj]
    rfl
  let p₀ : (weilEtaleKSheaf X).H 0 →+ G.H 0 :=
    (CategoryTheory.Abelian.Ext.mk₀ δ).postcomp Fℤ (Nat.add_zero 0)
  let K_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨weilEtaleKPresheaf X, hK⟩
  let e_sh : K_sh ≅ weilEtaleKSheaf X := CategoryTheory.sheafificationIso K_sh
  let H_pre : AddSubgroup ↥(G.obj.obj (Opposite.op T_X)) :=
    (δ_pre.app (Opposite.op T_X)).hom.range
  let q_hom : G.H 0 →+ (↥(G.obj.obj (Opposite.op T_X)) ⧸ H_pre) :=
    (QuotientAddGroup.mk' H_pre).comp (ev₀ G).toAddMonoidHom
