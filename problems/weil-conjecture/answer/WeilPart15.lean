                      (Opposite.unop_injective (adj_site.unit.naturality v.unop).symm)).trans
                      (Q.map_comp _ _)) }
            naturality := fun {Q₁ Q₂} β => NatTrans.ext (funext fun _ => (β.naturality _).symm) }
        left_triangle := NatTrans.ext (funext fun P => NatTrans.ext (funext fun opY =>
          (Category.id_comp _).trans ((P.map_comp _ _).symm.trans
            ((congrArg P.map
              (Opposite.unop_injective (adj_site.left_triangle_components opY.unop))).trans
              (P.map_id _)))))
        right_triangle := NatTrans.ext (funext fun Q => NatTrans.ext (funext fun opT =>
          (Category.id_comp _).trans ((Q.map_comp _ _).symm.trans
            ((congrArg Q.map
              (Opposite.unop_injective (adj_site.right_triangle_components opT.unop))).trans
              (Q.map_id _))))) }
    let adj_res : res_W ⊣ pf_W := Adjunction.mkOfUnitCounit
      { unit :=
          { app := fun F => { hom := adj_pre.unit.app F.obj }
            naturality := fun {F₁ F₂} α => Sheaf.hom_ext (adj_pre.unit.naturality α.hom) }
        counit :=
          { app := fun H => { hom := adj_pre.counit.app H.obj }
            naturality := fun {H₁ H₂} β => Sheaf.hom_ext (adj_pre.counit.naturality β.hom) }
        left_triangle := NatTrans.ext (funext fun F => Sheaf.hom_ext
          (adj_pre.left_triangle_components F.obj))
        right_triangle := NatTrans.ext (funext fun H => Sheaf.hom_ext
          (adj_pre.right_triangle_components H.obj)) }
    exact ⟨adj_pre, adj_res, fun _ _ => rfl, fun _ _ => rfl⟩

  have hOpenIso : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (W : Z.Opens),
      let E_W : Functor W.toScheme.Etale Z.Etale :=
        MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤
          (inferInstance : AlgebraicGeometry.Etale W.ι)
      let B_W : Functor Z.Etale W.toScheme.Etale :=
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ W.ι
      letI : E_W.IsContinuous W.toScheme.smallEtaleTopology Z.smallEtaleTopology := hOpenCont W
      ∀ [hc_B : B_W.IsContinuous Z.smallEtaleTopology W.toScheme.smallEtaleTopology]
        [hr_B : (B_W.sheafPushforwardContinuous AddCommGrpCat.{u}
          Z.smallEtaleTopology W.toScheme.smallEtaleTopology).IsRightAdjoint],
        let res_W := E_W.sheafPushforwardContinuous AddCommGrpCat.{u}
          W.toScheme.smallEtaleTopology Z.smallEtaleTopology
        Limits.PreservesFiniteColimits res_W ∧
        res_W.Additive ∧
        Nonempty (res_W ≅ B_W.sheafPullback AddCommGrpCat.{u}
          Z.smallEtaleTopology W.toScheme.smallEtaleTopology) := by
    intro Z W E_W B_W hc_B hr_B res_W
    have : E_W.IsContinuous W.toScheme.smallEtaleTopology Z.smallEtaleTopology := hOpenCont W
    obtain ⟨_, adj_res, _, _⟩ := hOpenAdj W
    have : (B_W.sheafPushforwardContinuous AddCommGrpCat.{u}
        Z.smallEtaleTopology W.toScheme.smallEtaleTopology).Additive :=
      { map_add := fun {_ _ _ _} => Sheaf.hom_ext (NatTrans.ext (funext fun _ => rfl)) }
    have : Limits.PreservesColimitsOfSize.{0, 0} res_W := adj_res.leftAdjoint_preservesColimits
    exact ⟨⟨fun _ _ _ => inferInstance⟩, adj_res.left_adjoint_additive,
      ⟨adj_res.leftAdjointUniq (B_W.sheafAdjunctionContinuous AddCommGrpCat.{u}
        Z.smallEtaleTopology W.toScheme.smallEtaleTopology)⟩⟩

  
  have hConserv : ∀ {S' S₀ : AlgebraicGeometry.Scheme.{u}} (g : S' ⟶ S₀),
      (∀ (H : Sheaf S'.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ (U : S₀.Opens), AlgebraicGeometry.IsAffineOpen U →
          let U' : S'.Opens := g ⁻¹ᵁ U
          let E_U' : Functor U'.toScheme.Etale S'.Etale :=
            MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤
              (inferInstance : AlgebraicGeometry.Etale U'.ι)
          letI : E_U'.IsContinuous U'.toScheme.smallEtaleTopology S'.smallEtaleTopology :=
            hOpenCont U'
          Limits.IsZero ((E_U'.sheafPushforwardContinuous AddCommGrpCat.{u}
            U'.toScheme.smallEtaleTopology S'.smallEtaleTopology).obj H)) →
        Limits.IsZero H) ∧
      (∀ {G₁ G₂ : Sheaf S'.smallEtaleTopology AddCommGrpCat.{u}} (φ : G₁ ⟶ G₂),
        (∀ (U : S₀.Opens), AlgebraicGeometry.IsAffineOpen U →
          let U' : S'.Opens := g ⁻¹ᵁ U
          let E_U' : Functor U'.toScheme.Etale S'.Etale :=
            MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤
              (inferInstance : AlgebraicGeometry.Etale U'.ι)
          letI : E_U'.IsContinuous U'.toScheme.smallEtaleTopology S'.smallEtaleTopology :=
            hOpenCont U'
          IsIso ((E_U'.sheafPushforwardContinuous AddCommGrpCat.{u}
            U'.toScheme.smallEtaleTopology S'.smallEtaleTopology).map φ)) →
        IsIso φ) := by
    intro S' S₀ g
    have hZero : ∀ (H : Sheaf S'.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ (U : S₀.Opens), AlgebraicGeometry.IsAffineOpen U →
          let U' : S'.Opens := g ⁻¹ᵁ U
          let E_U' : Functor U'.toScheme.Etale S'.Etale :=
            MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤
              (inferInstance : AlgebraicGeometry.Etale U'.ι)
          letI : E_U'.IsContinuous U'.toScheme.smallEtaleTopology S'.smallEtaleTopology :=
            hOpenCont U'
          Limits.IsZero ((E_U'.sheafPushforwardContinuous AddCommGrpCat.{u}
            U'.toScheme.smallEtaleTopology S'.smallEtaleTopology).obj H)) →
        Limits.IsZero H := by
      intro H hH
      rw [Limits.IsZero.iff_id_eq_zero]
      apply Sheaf.hom_ext
      ext opW s
      let W := opW.unop
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let φ_s : Aℤ ⟶ H.obj.obj (Opposite.op W) :=
        AddCommGrpCat.ofHom
          { toFun := fun n => n.down • s
            map_zero' := zero_zsmul s
            map_add' := fun a b => add_zsmul s a.down b.down }
      let R : Sieve W :=
        { arrows := fun Y u => φ_s ≫ H.obj.map u.op = 0
          downward_closed := fun {Y Z} {u} hu v => by
            dsimp at hu ⊢
            rw [H.obj.map_comp, ← Category.assoc, hu, Limits.zero_comp] }
      have hMemEt : R ∈ S'.smallEtaleTopology W ↔
          ∀ (x : ↥W.left), ∃ (V : S'.Etale) (u : V ⟶ W) (v : ↥V.left),
            R.arrows u ∧ AlgebraicGeometry.Etale u.left ∧ u.left.base v = x := by
        change R ∈ Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) S' W ↔ _
        rw [Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S' (le_refl _)]
        exact Scheme.mem_toGrothendieck_smallPretopology W R
      have hR_mem : R ∈ S'.smallEtaleTopology W := by
        refine hMemEt.mpr fun x => ?_
        obtain ⟨U, hU, hxU, _⟩ :=
          @AlgebraicGeometry.exists_isAffineOpen_mem_and_subset S₀ (g.base (W.hom.base x)) ⊤ trivial
        let U' : S'.Opens := g ⁻¹ᵁ U
        let W₀ : W.left.Opens := W.hom ⁻¹ᵁ U'
        have hxW₀ : x ∈ W₀ := hxU
        have h_comm : (W.hom ∣_ U') ≫ U'.ι = W₀.ι ≫ W.hom :=
          AlgebraicGeometry.morphismRestrict_ι W.hom U'
        have hEt₀ : AlgebraicGeometry.Etale (W.hom ∣_ U') := by
          have : AlgebraicGeometry.Etale W.hom := W.prop
          have hEt_comp : AlgebraicGeometry.Etale (W₀.ι ≫ W.hom) := inferInstance
          have : AlgebraicGeometry.Etale ((W.hom ∣_ U') ≫ U'.ι) := h_comm.symm ▸ hEt_comp
          exact AlgebraicGeometry.Etale.of_comp (W.hom ∣_ U') U'.ι
        let E_U' : Functor U'.toScheme.Etale S'.Etale :=
          MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤
            (inferInstance : AlgebraicGeometry.Etale U'.ι)
        haveI : E_U'.IsContinuous U'.toScheme.smallEtaleTopology S'.smallEtaleTopology :=
          hOpenCont U'
        let Y₀ : U'.toScheme.Etale := MorphismProperty.Over.mk ⊤ (W.hom ∣_ U') hEt₀
        let u_x : E_U'.obj Y₀ ⟶ W := MorphismProperty.Over.homMk W₀.ι h_comm.symm trivial
        have hZ_sec : Limits.IsZero (H.obj.obj (Opposite.op (E_U'.obj Y₀))) :=
          ((sheafToPresheaf U'.toScheme.smallEtaleTopology AddCommGrpCat.{u} ⋙
            (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op Y₀)).map_isZero (hH U hU))
        exact ⟨E_U'.obj Y₀, u_x, ⟨x, hxW₀⟩, hZ_sec.eq_of_tgt _ _, inferInstance, rfl⟩
      have hφ₀ : φ_s = 0 :=
        (H.cond Aℤ R hR_mem).isSeparatedFor.ext fun Y u hu => by
          dsimp [coyoneda]
          exact hu.trans (Limits.zero_comp).symm
      change s = 0
      have hs1 : φ_s (ULift.up 1) = s := one_zsmul s
      rw [← hs1, hφ₀]
      rfl
    refine ⟨hZero, fun {G₁ G₂} φ hφ => ?_⟩
    have hKer : Limits.IsZero (Limits.kernel φ) := by
      refine hZero _ fun U hU => ?_
      let U' : S'.Opens := g ⁻¹ᵁ U
      let E_U' : Functor U'.toScheme.Etale S'.Etale :=
        MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤
          (inferInstance : AlgebraicGeometry.Etale U'.ι)
      haveI : E_U'.IsContinuous U'.toScheme.smallEtaleTopology S'.smallEtaleTopology :=
        hOpenCont U'
      obtain ⟨hc_BU', hr_BU', _⟩ := hSite U'.ι
      letI := hc_BU'; letI := hr_BU'
      obtain ⟨hLim_U', _⟩ := hExtByZero U' AddCommGrpCat.{u}
      obtain ⟨_, hAdd_U', _⟩ := hOpenIso U'
      let res_U' := E_U'.sheafPushforwardContinuous AddCommGrpCat.{u}
        U'.toScheme.smallEtaleTopology S'.smallEtaleTopology
      have : IsIso (res_U'.map φ) := hφ U hU
      exact (Limits.isZero_kernel_of_mono (res_U'.map φ)).of_iso
        (asIso (Limits.kernelComparison φ res_U'))
    have hCok : Limits.IsZero (Limits.cokernel φ) := by
      refine hZero _ fun U hU => ?_
      let U' : S'.Opens := g ⁻¹ᵁ U
      let E_U' : Functor U'.toScheme.Etale S'.Etale :=
        MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤
          (inferInstance : AlgebraicGeometry.Etale U'.ι)
      haveI : E_U'.IsContinuous U'.toScheme.smallEtaleTopology S'.smallEtaleTopology :=
        hOpenCont U'
      obtain ⟨hc_BU', hr_BU', _⟩ := hSite U'.ι
      letI := hc_BU'; letI := hr_BU'
      obtain ⟨hColim_U', hAdd_U', _⟩ := hOpenIso U'
      let res_U' := E_U'.sheafPushforwardContinuous AddCommGrpCat.{u}
        U'.toScheme.smallEtaleTopology S'.smallEtaleTopology
      have : IsIso (res_U'.map φ) := hφ U hU
      exact (Limits.isZero_cokernel_of_epi (res_U'.map φ)).of_iso
        (asIso (Limits.cokernelComparison φ res_U')).symm
    have : Mono φ := (Preadditive.mono_iff_isZero_kernel φ).mpr hKer
    have : Epi φ := (Preadditive.epi_iff_isZero_cokernel φ).mpr hCok
    exact Balanced.isIso_of_mono_of_epi φ

  
  have hModRes : ∀ {X' X₀ : AlgebraicGeometry.Scheme.{u}} (g' : X' ⟶ X₀)
      (V : X₀.Opens) (V' : X'.Opens) (g'_U : V'.toScheme ⟶ V.toScheme),
      g'_U ≫ V.ι = V'.ι ≫ g' →
      let B_g' : Functor X₀.Etale X'.Etale :=
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g'
      let B_g'U : Functor V.toScheme.Etale V'.toScheme.Etale :=
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g'_U
      let E_V' : Functor V'.toScheme.Etale X'.Etale :=
        MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤
          (inferInstance : AlgebraicGeometry.Etale V'.ι)
      letI : E_V'.IsContinuous V'.toScheme.smallEtaleTopology X'.smallEtaleTopology :=
        hOpenCont V'
      ∀ [hc_g' : B_g'.IsContinuous X₀.smallEtaleTopology X'.smallEtaleTopology]
        [hr_g' : (B_g'.sheafPushforwardContinuous AddCommGrpCat.{u}
          X₀.smallEtaleTopology X'.smallEtaleTopology).IsRightAdjoint]
        [hc_g'U : B_g'U.IsContinuous V.toScheme.smallEtaleTopology V'.toScheme.smallEtaleTopology]
        [hr_g'U : (B_g'U.sheafPushforwardContinuous AddCommGrpCat.{u}
          V.toScheme.smallEtaleTopology V'.toScheme.smallEtaleTopology).IsRightAdjoint]
        (I : Sheaf X₀.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))) [Injective I],
        ∃ (I_V : Sheaf V.toScheme.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))))
          (_ : Injective I_V),
          Nonempty (((E_V'.sheafPushforwardContinuous AddCommGrpCat.{u}
              V'.toScheme.smallEtaleTopology X'.smallEtaleTopology).obj
            ((B_g'.sheafPullback AddCommGrpCat.{u}
              X₀.smallEtaleTopology X'.smallEtaleTopology).obj
              ((CategoryTheory.Sheaf.composeAndSheafify X₀.smallEtaleTopology
                (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
                  AddCommGrpCat.{u})).obj I))) ≅
            ((B_g'U.sheafPullback AddCommGrpCat.{u}
              V.toScheme.smallEtaleTopology V'.toScheme.smallEtaleTopology).obj
              ((CategoryTheory.Sheaf.composeAndSheafify V.toScheme.smallEtaleTopology
                (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
                  AddCommGrpCat.{u})).obj I_V))) := by
    intro X' X₀ g' V V' g'_U hg'_U B_g' B_g'U E_V' hc_g' hr_g' hc_g'U hr_g'U I _
    let R_ℓ := ULift.{u, 0} (ZMod ℓ)
    let Fgt := CategoryTheory.forget₂ (ModuleCat.{u, u} R_ℓ) AddCommGrpCat.{u}
    let U_sh := fun (Y : AlgebraicGeometry.Scheme.{u}) =>
      CategoryTheory.Sheaf.composeAndSheafify Y.smallEtaleTopology Fgt
    have : E_V'.IsContinuous V'.toScheme.smallEtaleTopology X'.smallEtaleTopology :=
      hOpenCont V'
    let E_V : Functor V.toScheme.Etale X₀.Etale :=
      MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤
        (inferInstance : AlgebraicGeometry.Etale V.ι)
    have : E_V.IsContinuous V.toScheme.smallEtaleTopology X₀.smallEtaleTopology := hOpenCont V
    let E_V_mod := E_V.sheafPushforwardContinuous
      (ModuleCat.{u, u} R_ℓ) V.toScheme.smallEtaleTopology X₀.smallEtaleTopology
    let I_V := E_V_mod.obj I
    have hInj_IV : Injective I_V := (hExtByZero V (ModuleCat.{u, u} R_ℓ)).2 I
    let ext_Z : ModuleCat.{u, 0} ℤ ⥤ ModuleCat.{u, u} R_ℓ :=
      ModuleCat.extendScalars (Int.castRingHom R_ℓ)
    let res_Z : ModuleCat.{u, u} R_ℓ ⥤ ModuleCat.{u, 0} ℤ :=
      ModuleCat.restrictScalars (Int.castRingHom R_ℓ)
    let adj_ext : ext_Z ⊣ res_Z :=
      ModuleCat.extendRestrictScalarsAdj (Int.castRingHom R_ℓ)
    let e_Z := (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
    let iso_fgt : res_Z ⋙ CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u} ≅ Fgt :=
      NatIso.ofComponents (fun _ => Iso.refl _) (fun _ =>
        (Category.comp_id _).trans (Category.id_comp _).symm)
    let adj_fgt : (e_Z.inverse ⋙ ext_Z) ⊣ Fgt :=
      (e_Z.symm.toAdjunction.comp adj_ext).ofNatIsoRight iso_fgt
    have hSheafFgt : ∀ (Y : AlgebraicGeometry.Scheme.{u})
        (M : Sheaf Y.smallEtaleTopology (ModuleCat.{u, u} R_ℓ)),
        Presheaf.IsSheaf Y.smallEtaleTopology (M.obj ⋙ Fgt) := by
      intro Y M E
      let iso_coy : (M.obj ⋙ Fgt) ⋙ coyoneda.obj (Opposite.op E) ≅
          M.obj ⋙ coyoneda.obj (Opposite.op ((e_Z.inverse ⋙ ext_Z).obj E)) :=
        NatIso.ofComponents
          (fun opT => (adj_fgt.homEquiv E (M.obj.obj opT)).symm.toIso)
          (fun {opT₁ opT₂} u => by
            ext φ
            exact adj_fgt.homEquiv_naturality_right_symm φ (M.obj.map u))
      exact Presieve.isSheaf_iso Y.smallEtaleTopology iso_coy.symm (M.cond _)
    let S_IX : Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u} := ⟨I.obj ⋙ Fgt, hSheafFgt X₀ I⟩
    let S_IV : Sheaf V.toScheme.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨I_V.obj ⋙ Fgt, hSheafFgt V.toScheme I_V⟩
    let e_UX : (U_sh X₀).obj I ≅ S_IX :=
      (CategoryTheory.sheafificationIso S_IX).symm
    let e_UV : (U_sh V.toScheme).obj I_V ≅ S_IV :=
      (CategoryTheory.sheafificationIso S_IV).symm
    let res_V := E_V.sheafPushforwardContinuous
      AddCommGrpCat.{u} V.toScheme.smallEtaleTopology X₀.smallEtaleTopology
    let res_V' := E_V'.sheafPushforwardContinuous
      AddCommGrpCat.{u} V'.toScheme.smallEtaleTopology X'.smallEtaleTopology
    let e_def : res_V.obj S_IX ≅ S_IV :=
      { hom := { hom := 𝟙 _ }
        inv := { hom := 𝟙 _ }
        hom_inv_id := Sheaf.hom_ext (Category.id_comp _)
        inv_hom_id := Sheaf.hom_ext (Category.id_comp _) }
    let e_mod : res_V.obj ((U_sh X₀).obj I) ≅ (U_sh V.toScheme).obj I_V :=
      res_V.mapIso e_UX ≪≫ e_def ≪≫ e_UV.symm
    obtain ⟨hc_BV, hr_BV, _⟩ := hSite V.ι
    obtain ⟨hc_BV', hr_BV', _⟩ := hSite V'.ι
    letI := hc_BV; letI := hr_BV; letI := hc_BV'; letI := hr_BV'
    obtain ⟨_, _, ⟨θ_V⟩⟩ := hOpenIso V
    obtain ⟨_, _, ⟨θ_V'⟩⟩ := hOpenIso V'
    let B_V : Functor X₀.Etale V.toScheme.Etale :=
      MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ V.ι
    let B_V' : Functor X'.Etale V'.toScheme.Etale :=
      MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ V'.ι
    let pb_V := B_V.sheafPullback AddCommGrpCat.{u} X₀.smallEtaleTopology V.toScheme.smallEtaleTopology
    let pb_V' := B_V'.sheafPullback AddCommGrpCat.{u} X'.smallEtaleTopology V'.toScheme.smallEtaleTopology
    let pb_g' := B_g'.sheafPullback AddCommGrpCat.{u} X₀.smallEtaleTopology X'.smallEtaleTopology
    let pb_g'U := B_g'U.sheafPullback AddCommGrpCat.{u}
      V.toScheme.smallEtaleTopology V'.toScheme.smallEtaleTopology
    let adj_V := B_V.sheafAdjunctionContinuous AddCommGrpCat.{u}
      X₀.smallEtaleTopology V.toScheme.smallEtaleTopology
    let adj_V' := B_V'.sheafAdjunctionContinuous AddCommGrpCat.{u}
      X'.smallEtaleTopology V'.toScheme.smallEtaleTopology
    let adj_g' := B_g'.sheafAdjunctionContinuous AddCommGrpCat.{u}
      X₀.smallEtaleTopology X'.smallEtaleTopology
    let adj_g'U := B_g'U.sheafAdjunctionContinuous AddCommGrpCat.{u}
      V.toScheme.smallEtaleTopology V'.toScheme.smallEtaleTopology
    have : (B_g'.comp B_V').IsContinuous X₀.smallEtaleTopology V'.toScheme.smallEtaleTopology :=
      Functor.isContinuous_comp B_g' B_V' X₀.smallEtaleTopology X'.smallEtaleTopology
        V'.toScheme.smallEtaleTopology
    have : (B_V.comp B_g'U).IsContinuous X₀.smallEtaleTopology V'.toScheme.smallEtaleTopology :=
      Functor.isContinuous_comp B_V B_g'U X₀.smallEtaleTopology V.toScheme.smallEtaleTopology
        V'.toScheme.smallEtaleTopology
    let e_fun : B_g'.comp B_V' ≅ B_V.comp B_g'U :=
      (MorphismProperty.Over.pullbackComp V'.ι g').symm ≪≫
        MorphismProperty.Over.pullbackCongr hg'_U.symm ≪≫
        MorphismProperty.Over.pullbackComp g'_U V.ι
    let e_pf := (Functor.sheafPushforwardContinuousComp B_g' B_V' AddCommGrpCat.{u}
        X₀.smallEtaleTopology X'.smallEtaleTopology V'.toScheme.smallEtaleTopology) ≪≫
      Functor.sheafPushforwardContinuousIso e_fun AddCommGrpCat.{u}
        X₀.smallEtaleTopology V'.toScheme.smallEtaleTopology ≪≫
      (Functor.sheafPushforwardContinuousComp B_V B_g'U AddCommGrpCat.{u}
        X₀.smallEtaleTopology V.toScheme.smallEtaleTopology V'.toScheme.smallEtaleTopology).symm
    let e_pb : pb_g' ⋙ pb_V' ≅ pb_V ⋙ pb_g'U :=
      ((adj_g'.comp adj_V').ofNatIsoRight e_pf).leftAdjointUniq (adj_V.comp adj_g'U)
    refine ⟨I_V, hInj_IV, ⟨?_⟩⟩
    exact θ_V'.app (pb_g'.obj ((U_sh X₀).obj I)) ≪≫
      e_pb.app ((U_sh X₀).obj I) ≪≫
      pb_g'U.mapIso (θ_V.symm.app ((U_sh X₀).obj I) ≪≫ e_mod)

  
  have hDegZero : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      Nonempty (Sheaf.cohomologyPresheafFunctor Y.smallEtaleTopology 0 ≅
        sheafToPresheaf Y.smallEtaleTopology AddCommGrpCat.{u}) := by
    intro Y
    let J := Y.smallEtaleTopology
    let P_free : Y.Etale → (Y.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) :=
      fun T => yoneda.obj T ⋙ AddCommGrpCat.free
    let R_sh : Y.Etale → Sheaf J AddCommGrpCat.{u} :=
      fun T => (presheafToSheaf J AddCommGrpCat.{u}).obj (P_free T)
    let r_map : ∀ {T₁ T₂ : Y.Etale}, (T₂ ⟶ T₁) → (R_sh T₂ ⟶ R_sh T₁) :=
      fun u => (presheafToSheaf J AddCommGrpCat.{u}).map
        (Functor.whiskerRight (yoneda.map u) AddCommGrpCat.free)
    let equiv_hom : ∀ (T : Y.Etale) (G : Sheaf J AddCommGrpCat.{u}),
        (R_sh T ⟶ G) ≃ ↥(G.obj.obj (Opposite.op T)) :=
      fun T G =>
        ((sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv (P_free T) G).trans
          (((AddCommGrpCat.adj.whiskerRight Y.Etaleᵒᵖ).homEquiv (yoneda.obj T) G.obj).trans
            yonedaEquiv)
    let z_univ : ∀ (T : Y.Etale), ↥((R_sh T).obj.obj (Opposite.op T)) :=
      fun T => equiv_hom T (R_sh T) (𝟙 (R_sh T))
    have h_eval : ∀ (T : Y.Etale) {G : Sheaf J AddCommGrpCat.{u}} (φ : R_sh T ⟶ G),
        equiv_hom T G φ = φ.hom.app (Opposite.op T) (z_univ T) := by
      intro T G φ
      have h1 := (sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv_naturality_right
        (X := P_free T) (𝟙 (R_sh T)) φ
      rw [Category.id_comp] at h1
      let α₀ := (sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv (P_free T) (R_sh T) (𝟙 (R_sh T))
      have h2 := (AddCommGrpCat.adj.whiskerRight Y.Etaleᵒᵖ).homEquiv_naturality_right
        (X := yoneda.obj T) α₀ ((sheafToPresheaf J AddCommGrpCat.{u}).map φ)
      dsimp [equiv_hom, z_univ]
      rw [h1]
      exact congrArg yonedaEquiv h2
    have h_rmap_z : ∀ {T₁ T₂ : Y.Etale} (u : T₂ ⟶ T₁),
        (r_map u).hom.app (Opposite.op T₂) (z_univ T₂) =
          (R_sh T₁).obj.map u.op (z_univ T₁) := by
      intro T₁ T₂ u
      rw [← h_eval T₂ (r_map u)]
      let F_free := (Functor.whiskeringRight Y.Etaleᵒᵖ (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
      have h1 := (congrArg ((sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv
          (F_free.obj (yoneda.obj T₂)) (R_sh T₁)) (Category.comp_id _).symm).trans
        ((sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv_naturality_left
          (F_free.map (yoneda.map u)) (𝟙 (R_sh T₁)))
      let α₁ := (sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv (P_free T₁) (R_sh T₁) (𝟙 (R_sh T₁))
      have h2 := (AddCommGrpCat.adj.whiskerRight Y.Etaleᵒᵖ).homEquiv_naturality_left
        (yoneda.map u) α₁
      let β₁ := (AddCommGrpCat.adj.whiskerRight Y.Etaleᵒᵖ).homEquiv (yoneda.obj T₁) (R_sh T₁).obj α₁
      have h12 : yonedaEquiv (((AddCommGrpCat.adj.whiskerRight Y.Etaleᵒᵖ).homEquiv
          (yoneda.obj T₂) (R_sh T₁).obj)
          ((sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv (P_free T₂) (R_sh T₁) (r_map u))) =
          yonedaEquiv (yoneda.map u ≫ β₁) :=
        congrArg yonedaEquiv ((congrArg ((AddCommGrpCat.adj.whiskerRight Y.Etaleᵒᵖ).homEquiv
          (yoneda.obj T₂) (R_sh T₁).obj) h1).trans h2)
      dsimp [equiv_hom, z_univ]
      rw [h12]
      change β₁.app (Opposite.op T₂) (𝟙 T₂ ≫ u) = ((R_sh T₁).obj.map u.op) (β₁.app (Opposite.op T₁) (𝟙 T₁))
      have hnat := congrArg (fun k => k (𝟙 T₁)) (β₁.naturality u.op)
      dsimp [yoneda] at hnat
      rw [Category.comp_id] at hnat
      rw [Category.id_comp]
      exact hnat
    let addEquiv_TG : ∀ (T : Y.Etale) (G : Sheaf J AddCommGrpCat.{u}),
        Abelian.Ext (R_sh T) G 0 ≃+ ↥(G.obj.obj (Opposite.op T)) :=
      fun T G =>
        Abelian.Ext.addEquiv₀.trans
          { equiv_hom T G with
