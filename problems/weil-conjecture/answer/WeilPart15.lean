      let _ : Algebra R₃ Ω := hAlg₃Ω
      have _ : IsScalarTower R₁ R₃ Ω := hTow₁₃Ω
      let alg₀₃ : Algebra R₀ R₃ := Algebra.compHom R₃ (algebraMap R₀ R₁)
      have h_tow₀₁₃ : @IsScalarTower R₀ R₁ R₃ _ _ alg₀₃.toSMul := IsScalarTower.of_algebraMap_eq' rfl
      have h_et₀₃ : @Algebra.Etale R₀ R₃ _ _ alg₀₃ :=
        @Algebra.Etale.comp R₀ R₁ R₃ _ _ _ _ alg₀₃ _ h_tow₀₁₃ _ _
      let idx₃ : PkgIdx := ⟨R₃, inferInstance, alg₀₃, inferInstance, ⟨h_tow₀₁₃⟩, ⟨h_et₀₃⟩⟩
      let P₃ := pkg_fn idx₃
      have hP₃ := h_pkg_spec idx₃
      have hφ₃ : (algebraMap R₃ Ω).comp (@algebraMap R₀ R₃ _ _ alg₀₃) = algebraMap R₀ Ω := by
        ext r₀
        change algebraMap R₃ Ω (algebraMap R₁ R₃ (algebraMap R₀ R₁ r₀)) = algebraMap R₀ Ω r₀
        rw [← IsScalarTower.algebraMap_apply R₁ R₃ Ω, ← IsScalarTower.algebraMap_apply R₀ R₁ Ω]
