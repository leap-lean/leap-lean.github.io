    exact ⟨LinearEquiv.ofBijective ψ ⟨hψ_inj, hψ_surj⟩⟩
  have h_single : ∀ (u₀ : R_tilde) (μ : R_tilde →ₐ[A₁] A₁),
      RingHom.ker μ.toRingHom = Ideal.span ({u₀} : Set R_tilde) →
      Nonempty ((Fin 1 → A₁) ≃ₗ[A₁] (R_tilde ⧸ Ideal.span ({u₀} : Set R_tilde))) := by
    intro u₀ μ hker
    let I₀ : Ideal R_tilde := Ideal.span ({u₀} : Set R_tilde)
    let ι_lin : (Fin 1 → A₁) →ₗ[A₁] R_tilde :=
      { toFun := fun c => algebraMap A₁ R_tilde (c 0)
        map_add' := fun c₁ c₂ => map_add _ _ _
        map_smul' := fun r c => by
          simp only [Pi.smul_apply, smul_eq_mul, map_mul, RingHom.id_apply, Algebra.smul_def] }
    let φ : (Fin 1 → A₁) →ₗ[A₁] (R_tilde ⧸ I₀) := (mk_a I₀).comp ι_lin
    have hφ_inj : Function.Injective φ := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro c hc
      rw [LinearMap.mem_ker] at hc
      change mk_a I₀ (algebraMap A₁ R_tilde (c 0)) = 0 at hc
      rw [hmk_a I₀, Ideal.Quotient.eq_zero_iff_mem] at hc
      dsimp only [I₀] at hc
      rw [← hker, RingHom.mem_ker] at hc
      have hc0 : c 0 = 0 := by
        have hcomm : μ.toRingHom (algebraMap A₁ R_tilde (c 0)) = c 0 := μ.commutes (c 0)
        exact hcomm.symm.trans hc
      ext idx
      rw [Fin.eq_zero idx]
      exact hc0
    have hφ_surj : Function.Surjective φ := by
      intro y_bar
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y_bar
      refine ⟨fun _ => μ r, ?_⟩
      change mk_a I₀ (algebraMap A₁ R_tilde (μ r)) = Ideal.Quotient.mk I₀ r
      rw [hmk_a I₀]
      apply Ideal.Quotient.eq.mpr
      dsimp only [I₀]
      rw [← hker, RingHom.mem_ker, map_sub]
      have hcomm : μ.toRingHom (algebraMap A₁ R_tilde (μ r)) = μ r := μ.commutes (μ r)
      exact sub_eq_zero.mpr hcomm
    exact ⟨LinearEquiv.ofBijective φ ⟨hφ_inj, hφ_surj⟩⟩
  have h_prod_free : ∀ (m : ℕ) (u : Fin m → R_tilde),
      (∀ i : Fin m, u i ≠ 0 ∧
        ∃ μ_i : R_tilde →ₐ[A₁] A₁,
          RingHom.ker μ_i.toRingHom = Ideal.span ({u i} : Set R_tilde)) →
      Nonempty ((Fin m → A₁) ≃ₗ[A₁]
        (R_tilde ⧸ Ideal.span ({Finset.univ.prod u} : Set R_tilde))) := by
    intro m
    induction m with
    | zero =>
      intro u _
      let I_u : Ideal R_tilde := Ideal.span ({Finset.univ.prod u} : Set R_tilde)
      let z_map : (Fin 0 → A₁) →ₗ[A₁] (R_tilde ⧸ I_u) := 0
      have hz_inj : Function.Injective z_map := by
        intro c₁ c₂ _
        ext i
        exact Fin.elim0 i
      have hz_surj : Function.Surjective z_map := by
        intro y_bar
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y_bar
        refine ⟨0, ?_⟩
        change (0 : R_tilde ⧸ I_u) = Ideal.Quotient.mk I_u r
        symm
        rw [Ideal.Quotient.eq_zero_iff_mem]
        dsimp only [I_u]
        rw [Finset.univ_eq_empty, Finset.prod_empty, Ideal.mem_span_singleton]
        exact ⟨r, (one_mul r).symm⟩
      exact ⟨LinearEquiv.ofBijective z_map ⟨hz_inj, hz_surj⟩⟩
    | succ m ih =>
      intro u hu
      let u_tail : Fin m → R_tilde := fun i => u i.succ
      obtain ⟨e_tail⟩ := ih u_tail (fun i => hu i.succ)
      obtain ⟨μ₀, hμ₀⟩ := (hu 0).2
      obtain ⟨e_head⟩ := h_single (u 0) μ₀ hμ₀
      obtain ⟨e_step⟩ := h_split (u 0) (Finset.univ.prod u_tail) (hu 0).1 1 e_head
      have h_span_eq : Ideal.span ({u 0 * Finset.univ.prod u_tail} : Set R_tilde) =
          Ideal.span ({Finset.univ.prod u} : Set R_tilde) := by
        rw [Fin.prod_univ_succ]
      let e_quot : (R_tilde ⧸ Ideal.span ({u 0 * Finset.univ.prod u_tail} : Set R_tilde)) ≃ₗ[A₁]
          (R_tilde ⧸ Ideal.span ({Finset.univ.prod u} : Set R_tilde)) :=
        (Submodule.quotEquivOfEq _ _ h_span_eq).restrictScalars A₁
      exact ⟨(((κ m 1).symm.trans (e_tail.prodCongr (LinearEquiv.refl A₁ (Fin 1 → A₁)))).trans
        e_step).trans e_quot⟩
  obtain ⟨e_pos⟩ := h_prod_free K_pos u_pos h_pos
  obtain ⟨e_neg⟩ := h_prod_free K_neg u_neg h_neg
  have hf_pos_ne : Finset.univ.prod u_pos ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun i _ => (h_pos i).1
  have hf_neg_ne : Finset.univ.prod u_neg ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun j _ => (h_neg j).1
  let I_Δ : Ideal R_tilde := Ideal.span ({Δ_pos} : Set R_tilde)
  let s_Δ : (Fin (n * K_pos) → A₁) →ₗ[A₁] R_tilde :=
    { toFun := fun c => Finset.univ.sum fun idx : Fin (n * K_pos) =>
        algebraMap A₁ R_tilde (c idx) * bas_Δ idx
      map_add' := fun c₁ c₂ => by
        simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
      map_smul' := fun r c => by
