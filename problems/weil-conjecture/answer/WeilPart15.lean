  have hSecAlgClosed : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      {P : AlgebraicGeometry.Scheme.{u}}
      (q : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      [AlgebraicGeometry.Etale q] (p₀ : ↥P),
      ∃ (s_P : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ P),
        s_P ≫ q = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ∧
        s_P.base (⊥ : PrimeSpectrum Ω) = p₀ := by
    intro Ω _ _ P q _ p₀
    obtain ⟨W, hW_aff, hp₀W, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := p₀) (U := (⊤ : P.Opens)) trivial
    haveI : AlgebraicGeometry.IsAffine W.toScheme := hW_aff
    let R : Type u := ↑(W.toScheme.presheaf.obj (Opposite.op ⊤))
    let q_R : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
      W.toScheme.isoSpec.inv ≫ W.ι ≫ q
    haveI : AlgebraicGeometry.Etale q_R := inferInstance
    let φ_cat := AlgebraicGeometry.Spec.preimage q_R
    letI : Algebra Ω R := φ_cat.hom.toAlgebra
    have h_map_qR : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω R)) = q_R :=
      AlgebraicGeometry.Spec.map_preimage q_R
    have h_et_alg : (algebraMap Ω R).Etale := by
      have h_spec : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω R))) := by
        rw [h_map_qR]; infer_instance
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale)).mp h_spec
    haveI : Algebra.Etale Ω R := RingHom.etale_algebraMap.mp h_et_alg
    let x₀ : PrimeSpectrum R := W.toScheme.isoSpec.hom.base ⟨p₀, hp₀W⟩
    let p_id : Ideal R := x₀.asIdeal
    haveI : p_id.IsPrime := x₀.isPrime
    let A := Localization.AtPrime p_id
    haveI : Algebra.EssFiniteType R A := inferInstance
    haveI : Algebra.FormallyUnramified R A := inferInstance
    haveI : Algebra.EssFiniteType Ω A := Algebra.EssFiniteType.comp Ω R A
    haveI : Algebra.FormallyUnramified Ω A := Algebra.FormallyUnramified.comp Ω R A
    haveI : IsLocalHom (algebraMap Ω A) := by
      constructor
      intro c hc
      by_contra hc_nu
      have hc0 : c = 0 := by
        by_contra hne
        exact hc_nu (IsUnit.mk0 c hne)
      subst hc0
      rw [map_zero] at hc
      exact not_isUnit_zero hc
