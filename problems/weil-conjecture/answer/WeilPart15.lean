    exact Functor.isContinuous_of_coverPreserving hCompat hCov

  
  have hExtByZero : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (W : Z.Opens)
      (A : Type (u + 1)) [Category.{u, u + 1} A] [Abelian A]
      [HasSheafify W.toScheme.smallEtaleTopology A] [HasSheafify Z.smallEtaleTopology A],
      let E_W : CategoryTheory.Functor W.toScheme.Etale Z.Etale :=
        CategoryTheory.MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤
