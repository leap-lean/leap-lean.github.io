      (∀ z : ↥V, ∃ (c : k) (hc : φ_k c ∈ V),
        z - ⟨φ_k c, hc⟩ ∈ IsLocalRing.maximalIdeal ↥V) ∧
      (∀ r : ↑(X.presheaf.stalk x.1), (e_x r : K) = algebraMap _ K r) ∧
      (∀ z : K, z ∈ V ↔ ∃ r : ↑(X.presheaf.stalk x.1), algebraMap _ K r = z) := by
    intro x
    obtain ⟨V_x, hV_x, hxV, f_x, hf_x_et, hf_x_germ⟩ := hChart x.1
    let S_x : Type u := ↑(X.presheaf.obj (Opposite.op V_x))
    let R_x : Type u := ↑(X.presheaf.stalk x.1)
    have : Nonempty ↥V_x.toScheme := ⟨⟨x.1, hxV⟩⟩
    have : IsDomain S_x := AlgebraicGeometry.IsIntegral.component_integral V_x
    let _ : Algebra k S_x := (f_x.comp Polynomial.C).toAlgebra
    let _ : Algebra S_x R_x := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x.1, hxV⟩
    let q_pt : PrimeSpectrum S_x := hV_x.primeIdealOf ⟨x.1, hxV⟩
    have hq_cl : IsClosed ({q_pt} : Set (PrimeSpectrum S_x)) := by
      have h_pre : (hV_x.fromSpec.base ⁻¹' ({x.1} : Set ↥X)) = ({q_pt} : Set (PrimeSpectrum S_x)) := by
        ext p
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        refine ⟨fun hp => hV_x.fromSpec.isOpenEmbedding.injective
          (hp.trans (hV_x.fromSpec_primeIdealOf ⟨x.1, hxV⟩).symm),
          fun hp => hp ▸ hV_x.fromSpec_primeIdealOf ⟨x.1, hxV⟩⟩
      rw [← h_pre]
      exact x.2.preimage hV_x.fromSpec.continuous
    have hq_max : q_pt.asIdeal.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_pt).mp hq_cl
    have : IsLocalization.AtPrime R_x q_pt.asIdeal := hV_x.isLocalization_stalk ⟨x.1, hxV⟩
    obtain ⟨hDVR_Rx, hRes_Rx⟩ :=
      @h_alg_s3 S_x _ _ _ f_x rfl hf_x_et q_pt.asIdeal hq_max R_x _ _ _ _ _
    obtain ⟨V, e_x, hV_ne, hDVR_V, he_x_coe, hV_mem⟩ := (h_alg_s4 K).1 R_x
    have hk_mem : ∀ c : k, φ_k c ∈ V :=
      fun c => (hV_mem (φ_k c)).mpr ⟨(γ_pt x.1).hom c, hγ_stalk x.1 c⟩
    refine ⟨V, e_x, hk_mem, hV_ne, hDVR_V, ?_, he_x_coe, hV_mem⟩
    intro z
    obtain ⟨c, hc_res⟩ := hRes_Rx (e_x.symm z)
    refine ⟨c, hk_mem c, ?_⟩
    have he_c : e_x (algebraMap S_x R_x (algebraMap k S_x c)) = ⟨φ_k c, hk_mem c⟩ := by
      apply Subtype.ext
      rw [he_x_coe]
      have h_germ : algebraMap S_x R_x (algebraMap k S_x c) = (γ_pt x.1).hom c :=
        hf_x_germ x.1 hxV c
      rw [h_germ, hγ_stalk x.1 c]
    have h_diff : z - ⟨φ_k c, hk_mem c⟩ =
        e_x (e_x.symm z - algebraMap S_x R_x (algebraMap k S_x c)) := by
      rw [map_sub, e_x.apply_symm_apply, he_c]
    rw [h_diff]
    have h_max_map : (Ideal.map e_x.toRingHom (IsLocalRing.maximalIdeal R_x)).IsMaximal :=
      Ideal.map_isMaximal_of_equiv e_x
    have h_eq_max : Ideal.map e_x.toRingHom (IsLocalRing.maximalIdeal R_x) =
        IsLocalRing.maximalIdeal ↥V :=
      (IsLocalRing.isMaximal_iff ↥V).mp h_max_map
    rw [← h_eq_max]
    exact Ideal.mem_map_of_mem e_x.toRingHom hc_res
  choose V_pt e_pt hk_pt hV_ne_pt hDVR_pt hRes_pt he_coe_pt hV_mem_pt using hClosedPtData
  have hV_inj : Function.Injective V_pt := by
    intro x y hVxy
    apply Subtype.ext
    let W₀ : ValuationSubring K := V_pt x
    let e₁ : ↑(X.presheaf.stalk x.1) ≃+* ↥W₀ := e_pt x
    let e₂ : ↑(X.presheaf.stalk y.1) ≃+* ↥W₀ :=
      (e_pt y).trans (RingEquiv.subringCongr (congrArg ValuationSubring.toSubring hVxy.symm))
    have he₂_coe : ∀ r : ↑(X.presheaf.stalk y.1), (e₂ r : K) = algebraMap _ K r :=
      fun r => he_coe_pt y r
    let k_to_W₀ : k →+* ↥W₀ := φ_k.codRestrict W₀.toSubring (hk_pt x)
    have h_sq_comm : CategoryTheory.CommSq (X.fromSpecStalk η)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W₀ K)))
        C.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom k_to_W₀)) := by
      have h_rhs : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W₀ K)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom k_to_W₀) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_k) := by
        rw [← AlgebraicGeometry.Spec.map_comp]
        rfl
      exact ⟨(hId_B η).trans h_rhs.symm⟩
    let sq : AlgebraicGeometry.ValuativeCommSq C.hom :=
      AlgebraicGeometry.ValuativeCommSq.mk ↥W₀ K (X.fromSpecStalk η)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom k_to_W₀)) h_sq_comm
    let mkLift : ∀ (z : ↥X) (ez : ↑(X.presheaf.stalk z) ≃+* ↥W₀),
        (∀ r : ↑(X.presheaf.stalk z), (ez r : K) = algebraMap _ K r) →
        sq.commSq.LiftStruct := fun z ez hez =>
      { l := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ez.toRingHom) ≫ X.fromSpecStalk z
        fac_left := by
          have h_comp : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W₀ K)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ez.toRingHom) =
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ez.toRingHom ≫ CommRingCat.ofHom (algebraMap ↥W₀ K)) :=
            (AlgebraicGeometry.Spec.map_comp _ _).symm
          have h_ez_K : CommRingCat.ofHom ez.toRingHom ≫ CommRingCat.ofHom (algebraMap ↥W₀ K) =
              X.presheaf.stalkSpecializes (h_spec z) := by
            ext r
            exact hez r
          calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W₀ K)) ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ez.toRingHom) ≫ X.fromSpecStalk z)
              = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W₀ K)) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom ez.toRingHom)) ≫
                  X.fromSpecStalk z := (Category.assoc _ _ _).symm
            _ = AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom ez.toRingHom ≫ CommRingCat.ofHom (algebraMap ↥W₀ K)) ≫
                  X.fromSpecStalk z := congrArg (· ≫ X.fromSpecStalk z) h_comp
            _ = AlgebraicGeometry.Spec.map (X.presheaf.stalkSpecializes (h_spec z)) ≫
                  X.fromSpecStalk z :=
                congrArg (fun g => AlgebraicGeometry.Spec.map g ≫ X.fromSpecStalk z) h_ez_K
            _ = X.fromSpecStalk η := hId_A z
        fac_right := by
          change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ez.toRingHom) ≫ X.fromSpecStalk z) ≫
            C.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom k_to_W₀)
          rw [Category.assoc, hId_B z, ← AlgebraicGeometry.Spec.map_comp]
          congr 1
          ext c
          change (ez ((γ_pt z).hom c) : K) = φ_k c
          rw [hez, hγ_stalk z c] }
    have hUniq : Subsingleton sq.commSq.LiftStruct :=
      AlgebraicGeometry.IsSeparated.valuativeCriterion C.hom sq
    have hl_eq : (mkLift x.1 e₁ (he_coe_pt x)).l = (mkLift y.1 e₂ he₂_coe).l :=
      congrArg CategoryTheory.CommSq.LiftStruct.l (hUniq.elim _ _)
    let m₀ := IsLocalRing.closedPoint ↥W₀
    have h_eval : ∀ (z : ↥X) (ez : ↑(X.presheaf.stalk z) ≃+* ↥W₀),
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ez.toRingHom) ≫ X.fromSpecStalk z).base m₀ = z := by
      intro z ez
      have hm_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ez.toRingHom)).base m₀ =
          IsLocalRing.closedPoint ↑(X.presheaf.stalk z) := by
        apply PrimeSpectrum.ext
        have : (Ideal.comap ez.toRingHom (IsLocalRing.maximalIdeal ↥W₀)).IsMaximal :=
          Ideal.comap_isMaximal_of_surjective ez.toRingHom ez.surjective
        exact IsLocalRing.eq_maximalIdeal this
      change (X.fromSpecStalk z).base
        ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ez.toRingHom)).base m₀) = z
      rw [hm_eq]
      exact X.fromSpecStalk_closedPoint
    calc x.1 = (mkLift x.1 e₁ (he_coe_pt x)).l.base m₀ := (h_eval x.1 e₁).symm
      _ = (mkLift y.1 e₂ he₂_coe).l.base m₀ :=
          congrArg (fun g : AlgebraicGeometry.Spec (CommRingCat.of ↥W₀) ⟶ X => g.base m₀) hl_eq
      _ = y.1 := h_eval y.1 e₂
  have hV_surj : ∀ W : ValuationSubring K, (∀ c : k, φ_k c ∈ W) → W ≠ ⊤ → ∃ x : Pt, V_pt x = W := by
    intro W hWk hW_ne
    let k_to_W : k →+* ↥W := φ_k.codRestrict W.toSubring hWk
    have h_sq_comm : CategoryTheory.CommSq (X.fromSpecStalk η)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W K)))
        C.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom k_to_W)) := by
      have h_rhs : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W K)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom k_to_W) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_k) := by
        rw [← AlgebraicGeometry.Spec.map_comp]
        rfl
      exact ⟨(hId_B η).trans h_rhs.symm⟩
    let sq : AlgebraicGeometry.ValuativeCommSq C.hom :=
      AlgebraicGeometry.ValuativeCommSq.mk ↥W K (X.fromSpecStalk η)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom k_to_W)) h_sq_comm
    have hu : AlgebraicGeometry.UniversallyClosed C.hom := inferInstance
    have hEx : AlgebraicGeometry.ValuativeCriterion.Existence C.hom := by
      rw [AlgebraicGeometry.universallyClosed_eq_universallySpecializing] at hu
      rw [AlgebraicGeometry.ValuativeCriterion.Existence.eq]
      exact hu.1
    have hLift : sq.commSq.HasLift := hEx sq
    let L_lift : sq.commSq.LiftStruct := Classical.choice hLift.exists_lift
    let ψ : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X := L_lift.l
    have h_top : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W K)) ≫ ψ =
        X.fromSpecStalk η :=
      L_lift.fac_left
    let m_W := IsLocalRing.closedPoint ↥W
    let x₀ : ↥X := ψ.base m_W
    obtain ⟨U, hU, hx₀U, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x₀) (U := ⊤)
        (TopologicalSpace.Opens.mem_top x₀)
    have : AlgebraicGeometry.IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
    have h_range : Set.range ψ.base ⊆ Set.range hU.fromSpec.base := by
      rw [hU.range_fromSpec]
      rintro _ ⟨q, rfl⟩
      let q_ps : PrimeSpectrum ↥W := q
      let m_ps : PrimeSpectrum ↥W := m_W
      have hq_le : q_ps ≤ m_ps := IsLocalRing.le_maximalIdeal q_ps.isPrime.ne_top
      have hq_spec : q ⤳ m_W := (PrimeSpectrum.le_iff_specializes q_ps m_ps).mp hq_le
      exact Specializes.mem_open (hq_spec.map ψ.continuous) U.isOpen hx₀U
    let ψ_U := AlgebraicGeometry.IsOpenImmersion.lift hU.fromSpec ψ h_range
    have hψ_fac : ψ_U ≫ hU.fromSpec = ψ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hU.fromSpec ψ h_range
    let α_cat : X.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of ↥W :=
      AlgebraicGeometry.Spec.preimage ψ_U
    have hα_fac : AlgebraicGeometry.Spec.map α_cat ≫ hU.fromSpec = ψ := by
      rw [AlgebraicGeometry.Spec.map_preimage]
      exact hψ_fac
    let R_U : Type u := ↑(X.presheaf.obj (Opposite.op U))
    have : Nonempty ↥U.toScheme := ⟨⟨x₀, hx₀U⟩⟩
    have : IsDomain R_U := AlgebraicGeometry.IsIntegral.component_integral U
    have : IsFractionRing R_U K := AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen X U hU
    have hηU : η ∈ U := Specializes.mem_open (h_spec x₀) U.isOpen hx₀U
    have hα_K : ∀ r : R_U, (α_cat.hom r : K) = algebraMap R_U K r := by
      have h_eta_eq : X.fromSpecStalk η =
          AlgebraicGeometry.Spec.map (X.presheaf.germ U η hηU) ≫ hU.fromSpec := by
        rw [← hU.fromSpecStalk_eq_fromSpecStalk hηU]
        rfl
      have h_map_comp : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W K)) ≫
          AlgebraicGeometry.Spec.map α_cat =
          AlgebraicGeometry.Spec.map (α_cat ≫ CommRingCat.ofHom (algebraMap ↥W K)) :=
        (AlgebraicGeometry.Spec.map_comp _ _).symm
      have h1 : AlgebraicGeometry.Spec.map (α_cat ≫ CommRingCat.ofHom (algebraMap ↥W K)) ≫ hU.fromSpec =
          AlgebraicGeometry.Spec.map (X.presheaf.germ U η hηU) ≫ hU.fromSpec := by
        calc AlgebraicGeometry.Spec.map (α_cat ≫ CommRingCat.ofHom (algebraMap ↥W K)) ≫ hU.fromSpec
            = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W K)) ≫
                AlgebraicGeometry.Spec.map α_cat) ≫ hU.fromSpec :=
              congrArg (· ≫ hU.fromSpec) h_map_comp.symm
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W K)) ≫
                (AlgebraicGeometry.Spec.map α_cat ≫ hU.fromSpec) := Category.assoc _ _ _
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W K)) ≫ ψ :=
              congrArg _ hα_fac
          _ = X.fromSpecStalk η := h_top
          _ = AlgebraicGeometry.Spec.map (X.presheaf.germ U η hηU) ≫ hU.fromSpec := h_eta_eq
      have h2 := AlgebraicGeometry.Spec.map_injective ((cancel_mono hU.fromSpec).mp h1)
      intro r
      exact congrArg (fun g => g.hom r) h2
    let p_U : PrimeSpectrum R_U := (AlgebraicGeometry.Spec.map α_cat).base m_W
    have hp_from : hU.fromSpec.base p_U = x₀ := by
      change (AlgebraicGeometry.Spec.map α_cat ≫ hU.fromSpec).base m_W = ψ.base m_W
      rw [hα_fac]
    have hp_ideal : p_U.asIdeal = Ideal.comap α_cat.hom (IsLocalRing.maximalIdeal ↥W) := rfl
    have hp_ne_bot : p_U.asIdeal ≠ ⊥ := by
      intro hp_bot
      apply hW_ne
      ext z
      simp only [ValuationSubring.mem_top, iff_true]
      obtain ⟨⟨r, s⟩, hzs⟩ := IsLocalization.surj (nonZeroDivisors R_U) z
      dsimp only at hzs
      have hs_ne : (s : R_U) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have hKs_ne : algebraMap R_U K (s : R_U) ≠ 0 :=
        (map_ne_zero_iff (algebraMap R_U K) (IsFractionRing.injective R_U K)).mpr hs_ne
      have hs_not_p : (s : R_U) ∉ p_U.asIdeal := by
        rw [hp_bot, Ideal.mem_bot]
        exact hs_ne
      rw [hp_ideal, Ideal.mem_comap] at hs_not_p
      have hu_s : IsUnit (α_cat.hom (s : R_U)) := IsLocalRing.notMem_maximalIdeal.mp hs_not_p
      obtain ⟨w, hw⟩ := isUnit_iff_exists_inv.mp hu_s
      have hKs_inv : (algebraMap R_U K (s : R_U))⁻¹ = (w : K) := by
        apply mul_left_cancel₀ hKs_ne
        rw [mul_inv_cancel₀ hKs_ne, ← hα_K (s : R_U)]
        exact (congrArg Subtype.val hw).symm
      have hz_eq : z = (α_cat.hom r : K) * (w : K) := by
        apply mul_right_cancel₀ hKs_ne
        rw [← hKs_inv, mul_assoc, inv_mul_cancel₀ hKs_ne, mul_one, hα_K r, hzs]
      rw [hz_eq]
      exact W.toSubring.mul_mem (α_cat.hom r).2 w.2
    have hx₀_cl : IsClosed ({x₀} : Set ↥X) := by
      rw [← hp_from]
      exact hPrimeClosed U hU p_U hp_ne_bot
    let x : Pt := ⟨x₀, hx₀_cl⟩
    refine ⟨x, ?_⟩
    have hp_eq : hU.primeIdealOf ⟨x₀, hx₀U⟩ = p_U :=
      hU.fromSpec.isOpenEmbedding.injective
        ((hU.fromSpec_primeIdealOf ⟨x₀, hx₀U⟩).trans hp_from.symm)
    let _ : Algebra R_U ↑(X.presheaf.stalk x₀) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x₀, hx₀U⟩
    have : IsLocalization.AtPrime ↑(X.presheaf.stalk x₀) (hU.primeIdealOf ⟨x₀, hx₀U⟩).asIdeal :=
      hU.isLocalization_stalk ⟨x₀, hx₀U⟩
    have h_units : ∀ t : (hU.primeIdealOf ⟨x₀, hx₀U⟩).asIdeal.primeCompl,
        IsUnit (α_cat.hom (t : R_U)) := by
      intro t
      have ht_not : (t : R_U) ∉ p_U.asIdeal := by
        rw [← hp_eq]
        exact t.2
      rw [hp_ideal, Ideal.mem_comap] at ht_not
      exact IsLocalRing.notMem_maximalIdeal.mp ht_not
    let β : ↑(X.presheaf.stalk x₀) →+* ↥W := IsLocalization.lift h_units
    have hβ_K : (W.toSubring.subtype).comp β = algebraMap ↑(X.presheaf.stalk x₀) K := by
      apply IsLocalization.ringHom_ext (hU.primeIdealOf ⟨x₀, hx₀U⟩).asIdeal.primeCompl
      ext r
      change (IsLocalization.lift h_units (algebraMap R_U ↑(X.presheaf.stalk x₀) r) : K) =
        algebraMap ↑(X.presheaf.stalk x₀) K (algebraMap R_U ↑(X.presheaf.stalk x₀) r)
      rw [IsLocalization.lift_eq, hα_K r]
      change (X.germToFunctionField U).hom r =
        ((X.presheaf.germ U x₀ hx₀U) ≫ X.presheaf.stalkSpecializes (h_spec x₀)).hom r
      rw [TopCat.Presheaf.germ_stalkSpecializes]
    have hVW : V_pt x ≤ W := by
      intro z hz
      obtain ⟨r, rfl⟩ := (hV_mem_pt x z).mp hz
      have hr_eq : algebraMap ↑(X.presheaf.stalk x₀) K r = (β r : K) :=
        (RingHom.congr_fun hβ_K r).symm
      rw [hr_eq]
      exact (β r).2
    exact (h_alg_s4 K).2 (V_pt x) W (hDVR_pt x) hVW hW_ne
  refine ⟨φ_k, P₀, t₀, n₀, b₀, V_pt, ht₀_tr, hb₀_span, hV_inj, ?_, hV_surj⟩
  intro x
  exact ⟨hk_pt x, hV_ne_pt x, hDVR_pt x, hRes_pt x, e_pt x, he_coe_pt x⟩

theorem weil_algClosed_dvr_places_positive_sum_eq_finrank (k : Type u) [Field k] [IsAlgClosed k]
    (K : Type u) [Field K] [Algebra k K]
    (Pt : Type u) (V_pt : Pt → ValuationSubring K)
    (hInj : Function.Injective V_pt)
    (hDVR : ∀ x : Pt,
      (∀ c : k, algebraMap k K c ∈ V_pt x) ∧ V_pt x ≠ ⊤ ∧ IsDiscreteValuationRing ↥(V_pt x))
    (hSurj : ∀ W : ValuationSubring K, (∀ c : k, algebraMap k K c ∈ W) → W ≠ ⊤ → ∃ x : Pt, V_pt x = W)
    (f : K) (hf_tr : Transcendental k f)
    (hFinDim : FiniteDimensional ↥(IntermediateField.adjoin k ({f} : Set K)) K)
    (hFinInt : Module.Finite ↥(Algebra.adjoin k ({f} : Set K))
      ↥(integralClosure ↥(Algebra.adjoin k ({f} : Set K)) K)) :
    ∃ D_pos : Pt →₀ ℕ,
      (∀ (x : Pt) (hf : f ∈ V_pt x),
        Ideal.span ({(⟨f, hf⟩ : ↥(V_pt x))} : Set ↥(V_pt x)) =
          (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ (D_pos x)) ∧
      (∀ x : Pt, f ∉ V_pt x → D_pos x = 0) ∧
      (D_pos.sum fun _ n => n) =
        Module.finrank ↥(IntermediateField.adjoin k ({f} : Set K)) K :=
by
  classical
  
  let A := ↥(Algebra.adjoin k ({f} : Set K))
  let F := ↥(IntermediateField.adjoin k ({f} : Set K))
  let B := ↥(integralClosure A K)
  let f_A : A := ⟨f, Algebra.self_mem_adjoin_singleton k f⟩
  let p₀ : Ideal A := Ideal.span ({f_A} : Set A)
  have hf_ne : f ≠ 0 := by
    intro h0
    apply hf_tr
    refine ⟨Polynomial.X, Polynomial.X_ne_zero, ?_⟩
    simp [h0]
  have hf_A_ne : f_A ≠ 0 := fun h0 => hf_ne (congrArg Subtype.val h0)
  have hp₀_ne : p₀ ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hf_A_ne
  have hf_aeval_inj : Function.Injective (Polynomial.aeval f : Polynomial k →ₐ[k] K) := by
    intro g₁ g₂ hg
    by_contra hne
    apply hf_tr
    refine ⟨g₁ - g₂, sub_ne_zero.mpr hne, ?_⟩
    rw [map_sub, hg, sub_self]
  let e_poly : Polynomial k ≃ₐ[k] A :=
    (AlgEquiv.ofInjective (Polynomial.aeval f) hf_aeval_inj).trans
      (Subalgebra.equivOfEq _ _ (Algebra.adjoin_singleton_eq_range_aeval k f).symm)
  have he_poly_X : e_poly Polynomial.X = f_A := Subtype.ext (Polynomial.aeval_X f)
  haveI : IsPrincipalIdealRing A :=
    IsPrincipalIdealRing.of_surjective e_poly.toRingHom e_poly.surjective
  haveI : IsDedekindDomain A := inferInstance
  let ε : A →ₐ[k] k := (Polynomial.aeval (0 : k)).comp e_poly.symm.toAlgHom
  have hε_comm : ∀ c : k, ε (algebraMap k A c) = c := ε.commutes
  have hε_surj : Function.Surjective ε.toRingHom := fun c => ⟨algebraMap k A c, hε_comm c⟩
  have hε_ker : RingHom.ker ε.toRingHom = p₀ := by
    ext a
    rw [RingHom.mem_ker, Ideal.mem_span_singleton]
    change Polynomial.aeval (0 : k) (e_poly.symm a) = 0 ↔ f_A ∣ a
    rw [Polynomial.aeval_def, Polynomial.eval₂_at_zero, Algebra.algebraMap_self,
      RingHom.id_apply, ← Polynomial.X_dvd_iff, ← map_dvd_iff e_poly,
      he_poly_X, e_poly.apply_symm_apply]
  let e_quot : (A ⧸ p₀) ≃+* k :=
    (Ideal.quotEquivOfEq hε_ker.symm).trans
      (RingHom.quotientKerEquivOfSurjective hε_surj)
  have he_quot_mk : ∀ a : A, e_quot (Ideal.Quotient.mk p₀ a) = ε a := fun _ => rfl
  have hField_quot : _root_.IsField (A ⧸ p₀) :=
    { exists_pair_ne := ⟨0, 1, fun h =>
        zero_ne_one (α := k) (by rw [← map_zero e_quot, ← map_one e_quot, h])⟩
      mul_comm := mul_comm
      mul_inv_cancel := fun {x} hx =>
        ⟨e_quot.symm (e_quot x)⁻¹, by
          apply e_quot.injective
          rw [map_mul, e_quot.apply_symm_apply, map_one]
          exact mul_inv_cancel₀ (fun h0 => hx (e_quot.injective (h0.trans e_quot.map_zero.symm)))⟩ }
  haveI : p₀.IsMaximal := (Ideal.Quotient.maximal_ideal_iff_isField_quotient p₀).mpr hField_quot
  have he_quot_alg : ∀ c : k, e_quot (algebraMap k (A ⧸ p₀) c) = c := by
    intro c
    change e_quot (Ideal.Quotient.mk p₀ (algebraMap k A c)) = c
    rw [he_quot_mk, hε_comm]
  have hRes : Function.Bijective (algebraMap k (A ⧸ p₀)) := by
    refine ⟨fun c₁ c₂ h => ?_, fun z => ⟨e_quot z, ?_⟩⟩
    · have := congrArg e_quot h
      rwa [he_quot_alg, he_quot_alg] at this
    · apply e_quot.injective
      rw [he_quot_alg]

  
  letI : Algebra A F :=
    IntermediateField.algebraAdjoinAdjoin.instAlgebraSubtypeMemSubalgebraAdjoinAdjoin k ({f} : Set K)
  haveI : IsFractionRing A F :=
    IntermediateField.algebraAdjoinAdjoin.instIsFractionRingSubtypeMemSubalgebraAdjoinAdjoin k ({f} : Set K)
  haveI : IsScalarTower A F K :=
    IsScalarTower.of_algebraMap_eq (R := A) (S := F) (A := K) (fun _ => rfl)
  haveI : IsScalarTower A B K :=
    IsScalarTower.of_algebraMap_eq (R := A) (S := B) (A := K) (fun _ => rfl)
  haveI : IsFractionRing B K := IsIntegralClosure.isFractionRing_of_finite_extension A F K B
  haveI : _root_.IsNoetherian A B := isNoetherian_of_isNoetherianRing_of_finite A B
  haveI : IsNoetherianRing B := isNoetherianRing_iff.mpr (isNoetherian_of_tower A inferInstance)
  haveI : IsIntegrallyClosed B := integralClosure.isIntegrallyClosedOfFiniteExtension F
  haveI : IsDedekindDomain B :=
    (isDedekindDomain_iff B K).mpr
      ⟨inferInstance, inferInstance, inferInstance, fun hx => IsIntegrallyClosed.isIntegral_iff.mp hx⟩
  haveI : Algebra.IsIntegral A B := Algebra.IsIntegral.of_finite A B
  have hAB_inj : Function.Injective (algebraMap A B) := by
    intro a₁ a₂ h
    apply Subtype.ext
    calc (a₁ : K) = algebraMap A K a₁ := rfl
      _ = algebraMap B K (algebraMap A B a₁) := IsScalarTower.algebraMap_apply A B K a₁
      _ = algebraMap B K (algebraMap A B a₂) := by rw [h]
      _ = algebraMap A K a₂ := (IsScalarTower.algebraMap_apply A B K a₂).symm
      _ = (a₂ : K) := rfl
  haveI : Module.IsTorsionFree A B := Module.isTorsionFree_iff_algebraMap_injective.mpr hAB_inj

  
  have hB_val : ∀ (W : ValuationSubring K),
      (∀ c : k, algebraMap k K c ∈ W) → f ∈ W → ∀ b : B, (b : K) ∈ W := by
    intro W hc hfW b
    let S_W : Subalgebra k K :=
      { W.toSubring with algebraMap_mem' := hc }
    have hA_le : Algebra.adjoin k ({f} : Set K) ≤ S_W :=
      Algebra.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hfW)
    let ι_AW : A →+* ↥W :=
      { toFun := fun a => ⟨a.1, hA_le a.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hcomp_AW : (algebraMap ↥W K).comp ι_AW = algebraMap A K := RingHom.ext (fun _ => rfl)
    obtain ⟨P_int, hMon, hEv⟩ := b.2
    have hb_W : _root_.IsIntegral ↥W (b : K) := by
      refine ⟨P_int.map ι_AW, hMon.map ι_AW, ?_⟩
      rw [Polynomial.eval₂_map, hcomp_AW]
      exact hEv
    obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := K)).mp hb_W
    exact hy ▸ y.2

  
  let S_P : Finset (Ideal B) := IsDedekindDomain.primesOverFinset p₀ B
  have hGlobalSum : (∑ P ∈ S_P, p₀.ramificationIdx' P) = Module.finrank F K := by
    have hSum := Ideal.sum_ramification_inertia B F K hp₀_ne
    rw [← hSum]
    refine Finset.sum_congr rfl (fun P hP_mem => ?_)
    have hP_over_set : P ∈ p₀.primesOver B :=
      (IsDedekindDomain.mem_primesOverFinset_iff hp₀_ne B).mp hP_mem
    haveI : P.IsPrime := hP_over_set.1
    haveI : P.LiesOver p₀ := hP_over_set.2
    have hInert : p₀.inertiaDeg' P = 1 := by
      letI : Algebra (A ⧸ p₀) (B ⧸ P) := Ideal.Quotient.algebraOfLiesOver P p₀
      letI : Module (A ⧸ p₀) (B ⧸ P) := Algebra.toModule
      rw [Ideal.inertiaDeg'_algebraMap]
      haveI : Nontrivial (A ⧸ p₀) :=
        ⟨⟨0, 1, fun h => zero_ne_one (α := k) (by rw [← map_zero e_quot, ← map_one e_quot, h])⟩⟩
      haveI : IsDomain (B ⧸ P) := Ideal.Quotient.isDomain P
      haveI : Module.Finite (A ⧸ p₀) (B ⧸ P) := module_finite_of_liesOver P p₀
      haveI : Algebra.IsIntegral (A ⧸ p₀) (B ⧸ P) := Algebra.IsIntegral.of_finite (A ⧸ p₀) (B ⧸ P)
      let e_k : k ≃+* (A ⧸ p₀) := RingEquiv.ofBijective (algebraMap k (A ⧸ p₀)) hRes
      let φ : k →+* (B ⧸ P) := (algebraMap (A ⧸ p₀) (B ⧸ P)).comp e_k.toRingHom
      have hφ_comp : φ.comp e_k.symm.toRingHom = algebraMap (A ⧸ p₀) (B ⧸ P) := by
        ext x
        simp [φ]
      have hφ_int : φ.IsIntegral := by
        intro z
        obtain ⟨q, hq_mon, hq_ev⟩ := Algebra.IsIntegral.isIntegral (R := A ⧸ p₀) z
        refine ⟨q.map e_k.symm.toRingHom, hq_mon.map e_k.symm.toRingHom, ?_⟩
        rw [Polynomial.eval₂_map, hφ_comp]
        exact hq_ev
      have hφ_bij : Function.Bijective φ :=
        IsAlgClosed.ringHom_bijective_of_isIntegral (k := k) (K := B ⧸ P) φ hφ_int
      have hBij_quot : Function.Bijective (algebraMap (A ⧸ p₀) (B ⧸ P)) := by
        have heq : (algebraMap (A ⧸ p₀) (B ⧸ P) : (A ⧸ p₀) → (B ⧸ P)) = φ ∘ e_k.symm := by
          ext x
          simp [φ]
        rw [heq]
        exact hφ_bij.comp e_k.symm.bijective
      let e_lin : (A ⧸ p₀) ≃ₗ[A ⧸ p₀] (B ⧸ P) :=
        LinearEquiv.ofBijective (Algebra.linearMap (A ⧸ p₀) (B ⧸ P)) hBij_quot
      rw [← e_lin.finrank_eq, Module.finrank_self]
    rw [hInert, mul_one]

  
  let f_B : B := algebraMap A B f_A
  have hf_B_ne : f_B ≠ 0 := fun h0 => hf_A_ne (hAB_inj (h0.trans (map_zero _).symm))
  have hMapProd : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] (φ : R₁ →+* R₂)
      {ι : Type u} (T : Finset ι) (g : ι → Ideal R₁),
      Ideal.map φ (∏ i ∈ T, g i) = ∏ i ∈ T, Ideal.map φ (g i) := by
    intro R₁ R₂ _ _ φ ι T g
    induction T using Finset.induction_on with
    | empty =>
      rw [Finset.prod_empty, Finset.prod_empty, Ideal.one_eq_top, Ideal.one_eq_top, eq_top_iff]
      rintro x -
      have h1 : (1 : R₂) ∈ Ideal.map φ ⊤ := map_one φ ▸ Ideal.mem_map_of_mem φ trivial
      simpa using Ideal.mul_mem_left _ x h1
    | @insert i T hi ih =>
      rw [Finset.prod_insert hi, Finset.prod_insert hi, Ideal.map_mul, ih]
  have hLocalSpan : ∀ (P : Ideal B) (hP : P.IsPrime) (hOver : P.LiesOver p₀)
      (R_P : Type u) [CommRing R_P] [IsDomain R_P] [IsDiscreteValuationRing R_P]
      (alg : Algebra B R_P) (_ : @IsLocalization.AtPrime B _ R_P _ alg P hP),
      Ideal.span ({@algebraMap B R_P _ _ alg f_B} : Set R_P) =
        (IsLocalRing.maximalIdeal R_P) ^ (p₀.ramificationIdx' P) := by
    intro P hP hOver R_P _ _ _ alg hAtPrime
    haveI : P.IsPrime := hP
    haveI : P.LiesOver p₀ := hOver
    letI : Algebra B R_P := alg
    haveI : IsLocalization.AtPrime R_P P := hAtPrime
    have hp₀_ne_zero : p₀ ≠ 0 := by rwa [Submodule.zero_eq_bot]
    have hFact := Ideal.map_algebraMap_eq_finsetProd_pow (R := B) (S := A) hp₀_ne_zero
    have hLHS : Ideal.map (algebraMap B R_P) (Ideal.map (algebraMap A B) p₀) =
        Ideal.span ({algebraMap B R_P f_B} : Set R_P) := by
      dsimp [p₀, f_B]
      rw [Ideal.map_span, Set.image_singleton, Ideal.map_span, Set.image_singleton]
    have hP_in : P ∈ (p₀.primesOver B).toFinset :=
      Set.mem_toFinset.mpr ⟨hP, hOver⟩
    have hSpan_e : Ideal.span ({algebraMap B R_P f_B} : Set R_P) =
        (IsLocalRing.maximalIdeal R_P) ^ (P.ramificationIdx A) := by
      have hApp := congrArg (Ideal.map (algebraMap B R_P)) hFact
      rw [hLHS, hMapProd] at hApp
      rw [hApp, Finset.prod_eq_single P]
      · rw [Ideal.map_pow, IsLocalization.AtPrime.map_eq_maximalIdeal P R_P]
      · intro Q hQ_in hQP
        have hQ_over : Q ∈ p₀.primesOver B := Set.mem_toFinset.mp hQ_in
        haveI : Q.IsPrime := hQ_over.1
        have hQ_lies : Q.LiesOver p₀ := hQ_over.2
        have hfB_Q : f_B ∈ Q := by
          have hfA_Q : f_A ∈ Q.under A := by
            rw [← hQ_lies.over]
            exact Ideal.subset_span (Set.mem_singleton f_A)
          exact hfA_Q
        have hQ_ne : Q ≠ ⊥ := by
          intro hbot
          rw [hbot, Ideal.mem_bot] at hfB_Q
          exact hf_B_ne hfB_Q
        have hQ_max : Q.IsMaximal := Ring.DimensionLEOne.maximalOfPrime hQ_ne inferInstance
        have hNotLe : ¬(Q ≤ P) := by
          intro hle
          exact hQP (hQ_max.eq_of_le hP.ne_top hle)
        obtain ⟨s, hsQ, hsNotP⟩ := Set.not_subset.mp hNotLe
        have hsUnit : IsUnit (algebraMap B R_P s) :=
          IsLocalization.map_units R_P (⟨s, hsNotP⟩ : P.primeCompl)
        have hsMem : algebraMap B R_P s ∈ Ideal.map (algebraMap B R_P) Q :=
          Ideal.mem_map_of_mem (algebraMap B R_P) hsQ
        have hMapTop : Ideal.map (algebraMap B R_P) Q = ⊤ :=
          Ideal.eq_top_of_isUnit_mem _ hsMem hsUnit
        rw [Ideal.map_pow, hMapTop, ← Ideal.one_eq_top, one_pow]
      · intro hAbs
        exact False.elim (hAbs hP_in)
    have hRamEq : p₀.ramificationIdx' P = P.ramificationIdx A := by
      apply Ideal.ramificationIdx'_spec
      · rw [hFact, ← Finset.mul_prod_erase ((p₀.primesOver B).toFinset) _ hP_in]
        exact Ideal.mul_le_left
      · intro hLe_succ
        have hMapLe := Ideal.map_mono (f := algebraMap B R_P) hLe_succ
        rw [hLHS, hSpan_e, Ideal.map_pow,
          IsLocalization.AtPrime.map_eq_maximalIdeal P R_P] at hMapLe
        let 𝔪 := IsLocalRing.maximalIdeal R_P
        let π : R_P := Submodule.IsPrincipal.generator 𝔪
        have hπ_span : Ideal.span ({π} : Set R_P) = 𝔪 :=
          Submodule.IsPrincipal.span_singleton_generator 𝔪
        have h𝔪_ne_bot : 𝔪 ≠ ⊥ := IsDiscreteValuationRing.not_a_field'
        have h𝔪_ne_top : 𝔪 ≠ ⊤ := (IsLocalRing.maximalIdeal.isMaximal R_P).ne_top
        have hπ_ne_zero : π ≠ 0 := by
          intro h0
          apply h𝔪_ne_bot
          rw [← hπ_span, h0, Set.singleton_zero, Ideal.span_zero]
        have hπ_not_unit : ¬IsUnit π := by
          intro hu
          apply h𝔪_ne_top
          rw [← hπ_span, Ideal.span_singleton_eq_top.mpr hu]
        change 𝔪 ^ (P.ramificationIdx A) ≤ 𝔪 ^ (P.ramificationIdx A + 1) at hMapLe
        rw [← hπ_span, Ideal.span_singleton_pow, Ideal.span_singleton_pow] at hMapLe
        have hmem : π ^ (P.ramificationIdx A) ∈
            Ideal.span ({π ^ (P.ramificationIdx A + 1)} : Set R_P) :=
          hMapLe (Ideal.subset_span (Set.mem_singleton _))
        rw [Ideal.mem_span_singleton] at hmem
        obtain ⟨r, hr⟩ := hmem
        have h1 : π ^ (P.ramificationIdx A) * 1 = π ^ (P.ramificationIdx A) * (π * r) := by
          calc π ^ (P.ramificationIdx A) * 1 = π ^ (P.ramificationIdx A) := mul_one _
            _ = π ^ (P.ramificationIdx A + 1) * r := hr
            _ = π ^ (P.ramificationIdx A) * (π * r) := by rw [pow_succ]; ring
        have h_unit : 1 = π * r :=
          mul_left_cancel₀ (pow_ne_zero (P.ramificationIdx A) hπ_ne_zero) h1
        exact hπ_not_unit (IsUnit.of_mul_eq_one r h_unit.symm)
    rw [hRamEq]
    exact hSpan_e

  
  let L_of : ∀ (Q : Ideal B) [Q.IsPrime], Subalgebra B K := fun Q _ =>
    Localization.subalgebra.ofField K Q.primeCompl
      (fun s hs => mem_nonZeroDivisors_of_ne_zero (fun h0 => hs (h0 ▸ Q.zero_mem)))
  have hW_cond : ∀ (Q : Ideal B) [Q.IsPrime], Q ≠ ⊥ →
      ∀ z : K, z ∈ (L_of Q).toSubring ∨ z⁻¹ ∈ (L_of Q).toSubring := by
    intro Q _ hQ_ne z
    let L := L_of Q
    haveI : IsLocalization.AtPrime ↥L Q :=
      Localization.subalgebra.isLocalization_ofField K Q.primeCompl _
    haveI : IsFractionRing ↥L K :=
      Localization.subalgebra.isFractionRing_ofField K Q.primeCompl _
    have hDVR_L : IsDiscreteValuationRing ↥L :=
      IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain B hQ_ne ↥L
    have hVal_L : ValuationRing ↥L := @of_isDiscreteValuationRing ↥L _ _ hDVR_L
    obtain ⟨u, v, hv, huv⟩ := IsFractionRing.div_surjective (A := ↥L) z
    change (u : K) / (v : K) = z at huv
    have hv_ne_L : v ≠ 0 := nonZeroDivisors.ne_zero hv
    have hv_ne_K : (v : K) ≠ 0 := fun h0 => hv_ne_L (Subtype.ext h0)
    rcases @ValuationRing.cond ↥L _ hVal_L.toPreValuationRing u v with ⟨c, hc | hc⟩
    · by_cases hu0 : (u : K) = 0
      · left
        have hz0 : z = 0 := by rw [← huv, hu0, zero_div]
        rw [hz0]
        exact (L_of Q).toSubring.zero_mem
      · right
        have hcK : (v : K) = (u : K) * (c : K) := (congrArg Subtype.val hc).symm
        have hz_inv : z⁻¹ = (c : K) := by
          rw [← huv, inv_div, hcK, mul_div_cancel_left₀ (c : K) hu0]
        rw [hz_inv]
        exact c.2
    · left
      have hcK : (u : K) = (v : K) * (c : K) := (congrArg Subtype.val hc).symm
      have hz : z = (c : K) := by
        rw [← huv, hcK, mul_div_cancel_left₀ (c : K) hv_ne_K]
      rw [hz]
      exact c.2
  let W_of : ∀ (Q : Ideal B) [Q.IsPrime], Q ≠ ⊥ → ValuationSubring K :=
    fun Q _ hQ_ne => ValuationSubring.ofSubring (L_of Q).toSubring (hW_cond Q hQ_ne)
  have hW_k : ∀ (Q : Ideal B) [Q.IsPrime] (hQ_ne : Q ≠ ⊥) (c : k),
      algebraMap k K c ∈ W_of Q hQ_ne := by
    intro Q _ hQ_ne c
    change algebraMap k K c ∈ (L_of Q).toSubring
    let c_B : B := algebraMap A B (algebraMap k A c)
    have hc_eq : algebraMap k K c = ((algebraMap B ↥(L_of Q) c_B) : K) := by
      calc algebraMap k K c
          = algebraMap A K (algebraMap k A c) := rfl
        _ = algebraMap B K c_B := (IsScalarTower.algebraMap_apply A B K (algebraMap k A c)).symm
        _ = ((algebraMap B ↥(L_of Q) c_B) : K) :=
            (IsScalarTower.algebraMap_apply B ↥(L_of Q) K c_B).symm
    rw [hc_eq]
    exact (algebraMap B ↥(L_of Q) c_B).2
  have hW_ne_top : ∀ (Q : Ideal B) [Q.IsPrime] (hQ_ne : Q ≠ ⊥), W_of Q hQ_ne ≠ ⊤ := by
    intro Q _ hQ_ne htop
    let L := L_of Q
    haveI : IsLocalization.AtPrime ↥L Q :=
      Localization.subalgebra.isLocalization_ofField K Q.primeCompl _
    haveI : IsLocalRing ↥L := IsLocalization.AtPrime.isLocalRing ↥L Q
    have hex_b : ∃ b ∈ Q, b ≠ 0 := by
      by_contra h_all
      push_neg at h_all
      exact hQ_ne ((Submodule.eq_bot_iff Q).mpr h_all)
    obtain ⟨b, hb_mem, hb_ne⟩ := hex_b
    let m : ↥L := algebraMap B ↥L b
    have hm_mem : m ∈ IsLocalRing.maximalIdeal ↥L := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal Q ↥L]
      exact Ideal.mem_map_of_mem (algebraMap B ↥L) hb_mem
    have hm_ne_K : (m : K) ≠ 0 := fun h0 => hb_ne (Subtype.ext h0)
    have hm_inv_W : (m : K)⁻¹ ∈ W_of Q hQ_ne := by
      rw [htop]
      trivial
    let minv_L : ↥L := ⟨(m : K)⁻¹, hm_inv_W⟩
    have hmul1 : m * minv_L = 1 := Subtype.ext (mul_inv_cancel₀ hm_ne_K)
    have hm_unit : IsUnit m := IsUnit.of_mul_eq_one minv_L hmul1
    exact IsLocalRing.notMem_maximalIdeal.mpr hm_unit hm_mem

  have hP_data : ∀ P : ↥S_P, P.1.IsPrime ∧ P.1.LiesOver p₀ ∧ P.1 ≠ ⊥ := by
    intro P
    have hP_over : P.1 ∈ p₀.primesOver B :=
      (IsDedekindDomain.mem_primesOverFinset_iff hp₀_ne B).mp P.2
    refine ⟨hP_over.1, hP_over.2, ?_⟩
    intro hbot
    have hfA_P : f_A ∈ P.1.under A := by
      rw [← hP_over.2.over]
      exact Ideal.subset_span (Set.mem_singleton f_A)
    have hfB_P : f_B ∈ P.1 := hfA_P
    rw [hbot, Ideal.mem_bot] at hfB_P
    exact hf_B_ne hfB_P

  let ptOf : ↥S_P → Pt := fun P =>
    letI : P.1.IsPrime := (hP_data P).1
    (hSurj (W_of P.1 (hP_data P).2.2) (hW_k P.1 (hP_data P).2.2) (hW_ne_top P.1 (hP_data P).2.2)).choose

  have hPt_V : ∀ P : ↥S_P,
      letI : P.1.IsPrime := (hP_data P).1
      V_pt (ptOf P) = W_of P.1 (hP_data P).2.2 := fun P =>
    letI : P.1.IsPrime := (hP_data P).1
    (hSurj (W_of P.1 (hP_data P).2.2) (hW_k P.1 (hP_data P).2.2) (hW_ne_top P.1 (hP_data P).2.2)).choose_spec

  have hPtLoc : ∀ P : ↥S_P,
      ∃ (hP : P.1.IsPrime)
        (hOver : P.1.LiesOver p₀)
        (hf_in : f ∈ V_pt (ptOf P))
        (alg : Algebra B ↥(V_pt (ptOf P))),
        (⟨f, hf_in⟩ : ↥(V_pt (ptOf P))) ∈ IsLocalRing.maximalIdeal ↥(V_pt (ptOf P)) ∧
        (∀ b : B, ((@algebraMap B ↥(V_pt (ptOf P)) _ _ alg b) : K) = algebraMap B K b) ∧
        @IsLocalization.AtPrime B _ ↥(V_pt (ptOf P)) _ alg P.1 hP := by
    intro P
    haveI hP : P.1.IsPrime := (hP_data P).1
    have hOver : P.1.LiesOver p₀ := (hP_data P).2.1
    let L := L_of P.1
    haveI : IsLocalization.AtPrime ↥L P.1 :=
      Localization.subalgebra.isLocalization_ofField K P.1.primeCompl _
    have hSub_eq : L.toSubring = (V_pt (ptOf P)).toSubring := by
      have hV := hPt_V P
      exact (congrArg ValuationSubring.toSubring hV).symm
    have hMem_iff : ∀ z : K, z ∈ L ↔ z ∈ V_pt (ptOf P) := by
      intro z
      change z ∈ L.toSubring ↔ z ∈ (V_pt (ptOf P)).toSubring
      rw [hSub_eq]
    let e_ring : ↥L ≃+* ↥(V_pt (ptOf P)) :=
      { toFun := fun z => ⟨z.1, (hMem_iff z.1).mp z.2⟩
        invFun := fun z => ⟨z.1, (hMem_iff z.1).mpr z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl }
    have he_coe : ∀ z : ↥L, (e_ring z : K) = (z : K) := fun _ => rfl
    let alg : Algebra B ↥(V_pt (ptOf P)) :=
      (e_ring.toRingHom.comp (algebraMap B ↥L)).toAlgebra
    letI : Algebra B ↥(V_pt (ptOf P)) := alg
    let e_alg : ↥L ≃ₐ[B] ↥(V_pt (ptOf P)) :=
      { e_ring with commutes' := fun _ => rfl }
    haveI hAtPrime : IsLocalization.AtPrime ↥(V_pt (ptOf P)) P.1 :=
      IsLocalization.isLocalization_of_algEquiv P.1.primeCompl e_alg
    haveI : IsDiscreteValuationRing ↥(V_pt (ptOf P)) := (hDVR (ptOf P)).2.2
    have halg_coe : ∀ b : B, ((algebraMap B ↥(V_pt (ptOf P)) b) : K) = algebraMap B K b := by
      intro b
      change (e_ring (algebraMap B ↥L b) : K) = algebraMap B K b
      rw [he_coe]
      exact IsScalarTower.algebraMap_apply B ↥L K b
    have hfB_coe : algebraMap B K f_B = f := IsScalarTower.algebraMap_apply A B K f_A
    have hf_in : f ∈ V_pt (ptOf P) := by
      rw [← hfB_coe, ← halg_coe f_B]
      exact (algebraMap B ↥(V_pt (ptOf P)) f_B).2
    have hfB_P : f_B ∈ P.1 := by
      have hfA_P : f_A ∈ P.1.under A := by
        rw [← hOver.over]
        exact Ideal.subset_span (Set.mem_singleton f_A)
      exact hfA_P
    have hf_max : (⟨f, hf_in⟩ : ↥(V_pt (ptOf P))) ∈ IsLocalRing.maximalIdeal ↥(V_pt (ptOf P)) := by
      have helem : (⟨f, hf_in⟩ : ↥(V_pt (ptOf P))) = algebraMap B ↥(V_pt (ptOf P)) f_B := by
        apply Subtype.ext
        change f = ((algebraMap B ↥(V_pt (ptOf P)) f_B) : K)
        rw [halg_coe, hfB_coe]
      rw [helem, ← IsLocalization.AtPrime.map_eq_maximalIdeal P.1 ↥(V_pt (ptOf P))]
      exact Ideal.mem_map_of_mem (algebraMap B ↥(V_pt (ptOf P))) hfB_P
    exact ⟨hP, hOver, hf_in, alg, hf_max, halg_coe, hAtPrime⟩

  have hPtInj : Function.Injective ptOf := by
    intro P₁ P₂ hEq
    by_contra hNe
    have hNe_val : P₁.1 ≠ P₂.1 := fun h => hNe (Subtype.ext h)
    have hP₁ : P₁.1.IsPrime := (hP_data P₁).1
    have hP₁_ne : P₁.1 ≠ ⊥ := (hP_data P₁).2.2
    have hP₂ : P₂.1.IsPrime := (hP_data P₂).1
    have hP₂_ne : P₂.1 ≠ ⊥ := (hP_data P₂).2.2
    have hMax₁ : P₁.1.IsMaximal := Ring.DimensionLEOne.maximalOfPrime hP₁_ne hP₁
    have hNotLe : ¬(P₁.1 ≤ P₂.1) := fun hle => hNe_val (hMax₁.eq_of_le hP₂.ne_top hle)
    obtain ⟨s, hs₁, hs₂⟩ := Set.not_subset.mp hNotLe
    let L₁ : Subalgebra B K := @L_of P₁.1 hP₁
    let L₂ : Subalgebra B K := @L_of P₂.1 hP₂
    have hSub₁₂ : L₁.toSubring = L₂.toSubring := by
      have hV₁ : V_pt (ptOf P₁) = @W_of P₁.1 hP₁ hP₁_ne := hPt_V P₁
      have hV₂ : V_pt (ptOf P₂) = @W_of P₂.1 hP₂ hP₂_ne := hPt_V P₂
      have hW₁₂ : @W_of P₁.1 hP₁ hP₁_ne = @W_of P₂.1 hP₂ hP₂_ne :=
        hV₁.symm.trans ((congrArg V_pt hEq).trans hV₂)
      exact congrArg ValuationSubring.toSubring hW₁₂
    have hs_unit₂ : IsUnit (algebraMap B ↥L₂ s) := by
      haveI : P₂.1.IsPrime := hP₂
      haveI : IsLocalization.AtPrime ↥L₂ P₂.1 :=
        Localization.subalgebra.isLocalization_ofField K P₂.1.primeCompl _
      exact IsLocalization.map_units ↥L₂ (⟨s, hs₂⟩ : P₂.1.primeCompl)
    obtain ⟨v₂, hv₂⟩ := hs_unit₂.exists_right_inv
    have hv₁_mem : (v₂ : K) ∈ L₁ := by
      change (v₂ : K) ∈ L₁.toSubring
      rw [hSub₁₂]
      exact v₂.2
    let v₁ : ↥L₁ := ⟨(v₂ : K), hv₁_mem⟩
    have hs_mul₁ : algebraMap B ↥L₁ s * v₁ = 1 :=
      Subtype.ext (congrArg (Subtype.val : ↥L₂ → K) hv₂)
    have hs_unit₁ : IsUnit (algebraMap B ↥L₁ s) :=
      IsUnit.of_mul_eq_one v₁ hs_mul₁
    haveI : P₁.1.IsPrime := hP₁
    haveI : IsLocalization.AtPrime ↥L₁ P₁.1 :=
      Localization.subalgebra.isLocalization_ofField K P₁.1.primeCompl _
    haveI : IsLocalRing ↥L₁ := IsLocalization.AtPrime.isLocalRing ↥L₁ P₁.1
    have hs_max₁ : algebraMap B ↥L₁ s ∈ IsLocalRing.maximalIdeal ↥L₁ := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal P₁.1 ↥L₁]
      exact Ideal.mem_map_of_mem (algebraMap B ↥L₁) hs₁
    exact IsLocalRing.notMem_maximalIdeal.mpr hs_unit₁ hs_max₁

  have hPtSurj : ∀ (x : Pt) (hf : f ∈ V_pt x),
      (⟨f, hf⟩ : ↥(V_pt x)) ∈ IsLocalRing.maximalIdeal ↥(V_pt x) →
      ∃ P : ↥S_P, ptOf P = x := by
    intro x hf hf_max
    haveI : IsDiscreteValuationRing ↥(V_pt x) := (hDVR x).2.2
    let ι_Bx : B →+* ↥(V_pt x) :=
      { toFun := fun b => ⟨(b : K), hB_val (V_pt x) (hDVR x).1 hf b⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let Q : Ideal B := Ideal.comap ι_Bx (IsLocalRing.maximalIdeal ↥(V_pt x))
    haveI : Q.IsPrime := Ideal.IsPrime.comap ι_Bx
    have hfB_x : ι_Bx f_B = ⟨f, hf⟩ := Subtype.ext (IsScalarTower.algebraMap_apply A B K f_A)
    have hfB_Q : f_B ∈ Q := by
      change ι_Bx f_B ∈ IsLocalRing.maximalIdeal ↥(V_pt x)
      rwa [hfB_x]
    have hQ_ne : Q ≠ ⊥ := by
      intro hbot
      rw [hbot, Ideal.mem_bot] at hfB_Q
      exact hf_B_ne hfB_Q
    have hp₀_le_under : p₀ ≤ Q.under A := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      exact hfB_Q
    have hUnder_prime : (Q.under A).IsPrime := Ideal.IsPrime.under A Q
    have hQ_over : Q.LiesOver p₀ :=
      ⟨(Ideal.IsMaximal.eq_of_le inferInstance hUnder_prime.ne_top hp₀_le_under)⟩
    have hQ_mem : Q ∈ S_P :=
      (IsDedekindDomain.mem_primesOverFinset_iff hp₀_ne B).mpr ⟨inferInstance, hQ_over⟩
    let P : ↥S_P := ⟨Q, hQ_mem⟩
    refine ⟨P, ?_⟩
    let L_Q := L_of Q
    haveI : IsLocalization.AtPrime ↥L_Q Q :=
      Localization.subalgebra.isLocalization_ofField K Q.primeCompl _
    let W_Q := W_of Q hQ_ne
    have h_sub : W_Q.toSubring ≤ (V_pt x).toSubring := by
      intro y hy
      let z : ↥L_Q := ⟨y, hy⟩
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj Q.primeCompl z
      have hs_not_max : ι_Bx s.1 ∉ IsLocalRing.maximalIdeal ↥(V_pt x) := s.2
      have hs_unit : IsUnit (ι_Bx s.1) := IsLocalRing.notMem_maximalIdeal.mp hs_not_max
      obtain ⟨v, hv⟩ := hs_unit.exists_right_inv
      have hvK : ((s.1 : B) : K) * (v : K) = 1 := congrArg Subtype.val hv
      have hbsK : y * ((s.1 : B) : K) = (b : K) := congrArg Subtype.val hbs
      have hy_eq : y = ((ι_Bx b * v : ↥(V_pt x)) : K) := by
        calc y = y * 1 := (mul_one y).symm
          _ = y * (((s.1 : B) : K) * (v : K)) := by rw [hvK]
          _ = (y * ((s.1 : B) : K)) * (v : K) := (mul_assoc _ _ _).symm
          _ = (b : K) * (v : K) := by rw [hbsK]
          _ = ((ι_Bx b * v : ↥(V_pt x)) : K) := rfl
      rw [hy_eq]
      exact (ι_Bx b * v).2
    have h_loc_hom : _root_.IsLocalHom (Subring.inclusion h_sub) := by
      refine ⟨fun u hu => ?_⟩
      let u_L : ↥L_Q := ⟨u.1, u.2⟩
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj Q.primeCompl u_L
      have hs_unit_x : IsUnit (ι_Bx s.1) := IsLocalRing.notMem_maximalIdeal.mp s.2
      have hb_eq_x : ι_Bx b = Subring.inclusion h_sub u * ι_Bx s.1 :=
        Subtype.ext (congrArg Subtype.val hbs).symm
      have hb_unit_x : IsUnit (ι_Bx b) := by
        rw [hb_eq_x]
        exact hu.mul hs_unit_x
      have hb_not_Q : b ∉ Q := IsLocalRing.notMem_maximalIdeal.mpr hb_unit_x
      have hb_unit_L : IsUnit (algebraMap B ↥L_Q b) :=
        IsLocalization.map_units ↥L_Q (⟨b, hb_not_Q⟩ : Q.primeCompl)
      rw [← hbs] at hb_unit_L
      exact isUnit_of_mul_isUnit_left hb_unit_L
    have h_le_loc : W_Q.toLocalSubring ≤ (V_pt x).toLocalSubring :=
      LocalSubring.le_def.mpr ⟨h_sub, h_loc_hom⟩
    have h_eq_loc : W_Q.toLocalSubring = (V_pt x).toLocalSubring :=
      (ValuationSubring.isMax_toLocalSubring W_Q).eq_of_le h_le_loc
    have h_eq_W : W_Q = V_pt x := ValuationSubring.toLocalSubring_injective h_eq_loc
    apply hInj
    have hPV : V_pt (ptOf P) = W_Q := hPt_V P
    exact hPV.trans h_eq_W

  
  let D_pos : Pt →₀ ℕ :=
    Finset.univ.sum (fun P : ↥S_P => Finsupp.single (ptOf P) (p₀.ramificationIdx' P.1))
  refine ⟨D_pos, ?_, ?_, ?_⟩
  · 
    intro x hf
    haveI : IsDiscreteValuationRing ↥(V_pt x) := (hDVR x).2.2
    by_cases hf_max : (⟨f, hf⟩ : ↥(V_pt x)) ∈ IsLocalRing.maximalIdeal ↥(V_pt x)
    · obtain ⟨P, hPx⟩ := hPtSurj x hf hf_max
      subst hPx
      have hD_val : D_pos (ptOf P) = p₀.ramificationIdx' P.1 := by
        dsimp [D_pos]
        rw [Finsupp.finsetSum_apply, Finset.sum_eq_single P]
        · exact Finsupp.single_eq_same
        · intro Q _ hQP
          exact Finsupp.single_eq_of_ne (fun hEq => hQP (hPtInj hEq.symm))
        · intro hAbs
          exact False.elim (hAbs (Finset.mem_univ P))
      obtain ⟨hP, hOver, _, alg, _, hcoe, hAtPrime⟩ := hPtLoc P
      have hSpan := hLocalSpan P.1 hP hOver ↥(V_pt (ptOf P)) alg hAtPrime
      have hElem : @algebraMap B ↥(V_pt (ptOf P)) _ _ alg f_B = (⟨f, hf⟩ : ↥(V_pt (ptOf P))) := by
        apply Subtype.ext
        rw [hcoe f_B]
        exact IsScalarTower.algebraMap_apply A B K f_A
      rw [hElem] at hSpan
      rw [hD_val]
      exact hSpan
    · have hD_zero : D_pos x = 0 := by
        dsimp [D_pos]
        rw [Finsupp.finsetSum_apply]
        apply Finset.sum_eq_zero
        intro Q _
        apply Finsupp.single_eq_of_ne
        intro hEq
        obtain ⟨_, _, hfQ, _, hfQ_max, _, _⟩ := hPtLoc Q
        subst hEq
        exact hf_max hfQ_max
      have hf_unit : IsUnit (⟨f, hf⟩ : ↥(V_pt x)) :=
        IsLocalRing.notMem_maximalIdeal.mp hf_max
      rw [hD_zero, pow_zero, Ideal.one_eq_top]
      exact Ideal.span_singleton_eq_top.mpr hf_unit
  · 
    intro x hf_not
    dsimp [D_pos]
    rw [Finsupp.finsetSum_apply]
    apply Finset.sum_eq_zero
    intro Q _
    apply Finsupp.single_eq_of_ne
    intro hEq
    obtain ⟨_, _, hfQ, _, _, _, _⟩ := hPtLoc Q
    rw [← hEq] at hfQ
    exact hf_not hfQ
  · 
    dsimp [D_pos]
    rw [← Finsupp.sum_finsetSum_index (by simp) (fun _ _ _ => rfl)]
    have hSingle : ∀ P : ↥S_P,
        (Finsupp.single (ptOf P) (p₀.ramificationIdx' P.1)).sum (fun _ n => n) =
          p₀.ramificationIdx' P.1 :=
      fun _ => Finsupp.sum_single_index rfl
    simp_rw [hSingle]
    rw [Finset.sum_attach S_P (fun P => p₀.ramificationIdx' P)]
    exact hGlobalSum

theorem weil_algClosed_riemann_subspace_effective_rep (k : Type u) [Field k] [IsAlgClosed k]
    (K : Type u) [Field K] [Algebra k K]
    (Pt : Type u) (P₀ : Pt) (V_pt : Pt → ValuationSubring K)
    (t : Units K)
    (divK : Units K → (Pt →₀ ℤ))
    (ht_tr : Transcendental k (t : K))
    (ht_fin : FiniteDimensional ↥(IntermediateField.adjoin k ({(t : K)} : Set K)) K)
    (hB0_fin : Module.Finite ↥(Algebra.adjoin k ({(t : K)} : Set K))
      ↥(integralClosure ↥(Algebra.adjoin k ({(t : K)} : Set K)) K))
    (hV : ∀ x : Pt,
      (∀ c : k, algebraMap k K c ∈ V_pt x) ∧
      V_pt x ≠ ⊤ ∧
      IsDiscreteValuationRing ↥(V_pt x) ∧
      (∀ z : ↥(V_pt x), ∃ (c : k) (hc : algebraMap k K c ∈ V_pt x),
        z - ⟨algebraMap k K c, hc⟩ ∈ IsLocalRing.maximalIdeal ↥(V_pt x)))
    (hDvrQuot : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Algebra k R],
      (∀ z : R, ∃ c : k, z - algebraMap k R c ∈ IsLocalRing.maximalIdeal R) →
      ∀ m : ℕ,
        FiniteDimensional k (R ⧸ (IsLocalRing.maximalIdeal R) ^ m) ∧
        Module.finrank k (R ⧸ (IsLocalRing.maximalIdeal R) ^ m) ≤ m)
    (hdiv_mul : ∀ u v : Units K, divK (u * v) = divK u + divK v)
    (hdiv_inv : ∀ u : Units K, divK u⁻¹ = -divK u)
    (hdiv_sum : ∀ u : Units K, (divK u).sum (fun _ m => m) = 0)
    (hdiv_nonneg : ∀ (u : Units K) (x : Pt), (u : K) ∈ V_pt x ↔ 0 ≤ divK u x)
    (hdiv_pow : ∀ (u : Units K) (x : Pt) (m : ℕ) (hu : (u : K) ∈ V_pt x),
      (⟨(u : K), hu⟩ : ↥(V_pt x)) ∈ (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ m ↔
        (m : ℤ) ≤ divK u x)
    (hdeg_t : ((divK t).sum fun _ m => if 0 < m then m else 0) =
      (Module.finrank ↥(IntermediateField.adjoin k ({(t : K)} : Set K)) K : ℤ)) :
    ∃ M : ℕ, ∀ D : Pt →₀ ℤ, D.sum (fun _ m => m) = 0 →
      ∃ (g : Units K) (Q : Fin M → Pt),
        D + divK g =
          (Finset.univ.sum fun j : Fin M => Finsupp.single (Q j) (1 : ℤ)) -
            Finsupp.single P₀ (M : ℤ) :=
by
  classical
  let F₀ : IntermediateField k K := IntermediateField.adjoin k ({(t : K)} : Set K)
  let A₀ : Subalgebra k K := Algebra.adjoin k ({(t : K)} : Set K)
  let B₀ : Subalgebra ↥A₀ K := integralClosure ↥A₀ K
  have : FiniteDimensional ↥F₀ K := ht_fin
  have : Module.Finite ↥A₀ ↥B₀ := hB0_fin
  let n : ℕ := Module.finrank ↥F₀ K
  have hn_pos : 1 ≤ n := Module.finrank_pos
  let u_inv : K := ((t⁻¹ : Units K) : K)
  have hu_inv_mul : u_inv * (t : K) = 1 := t.inv_mul
  have ht_mul_u_inv : (t : K) * u_inv = 1 := t.mul_inv
  let A₁ : Subalgebra k K := Algebra.adjoin k ({u_inv} : Set K)

  
  have hMonicEvalSum : ∀ {R_alg : Type u} [CommRing R_alg] [Algebra R_alg K]
      (P : Polynomial R_alg) (z : K),
      P.Monic → Polynomial.eval₂ (algebraMap R_alg K) z P = 0 →
      z ^ P.natDegree +
        ∑ s : Fin P.natDegree, algebraMap R_alg K (P.coeff (s : ℕ)) * z ^ (s : ℕ) = 0 := by
    intro R_alg _ _ P z hMon hEv
    have hsum_eq : (∑ s : Fin P.natDegree, Polynomial.eval₂ (algebraMap R_alg K) z
        (Polynomial.C (P.coeff (s : ℕ)) * Polynomial.X ^ (s : ℕ))) =
        ∑ s : Fin P.natDegree, algebraMap R_alg K (P.coeff (s : ℕ)) * z ^ (s : ℕ) := by
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
    have hEv' : Polynomial.eval₂ (algebraMap R_alg K) z
        (Polynomial.X ^ P.natDegree +
          ∑ i ∈ Finset.range P.natDegree, Polynomial.C (P.coeff i) * Polynomial.X ^ i) = 0 := by
      rw [← hMon.as_sum]
      exact hEv
    rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finset_sum,
      ← Fin.sum_univ_eq_sum_range
        (fun i => Polynomial.eval₂ (algebraMap R_alg K) z
          (Polynomial.C (P.coeff i) * Polynomial.X ^ i)) P.natDegree, hsum_eq] at hEv'
    exact hEv'

  have hMemIntOfSum : ∀ {R_alg : Type u} [CommRing R_alg] [Algebra R_alg K]
      (m : ℕ) (q : Fin m → R_alg) (z : K),
      z ^ m + ∑ s : Fin m, algebraMap R_alg K (q s) * z ^ (s : ℕ) = 0 →
      _root_.IsIntegral R_alg z := by
    intro R_alg _ _ m q z hSum
    refine ⟨Polynomial.X ^ m + ∑ s : Fin m, Polynomial.C (q s) * Polynomial.X ^ (s : ℕ),
      Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt q), ?_⟩
    have hsum_eq : (∑ s : Fin m, Polynomial.eval₂ (algebraMap R_alg K) z
        (Polynomial.C (q s) * Polynomial.X ^ (s : ℕ))) =
        ∑ s : Fin m, algebraMap R_alg K (q s) * z ^ (s : ℕ) := by
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
    rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finset_sum, hsum_eq, hSum]

  
  
  
  have h_s1 : ∃ (R : ℕ) (e : Fin n → K),
      (∀ j : Fin n, e j ∈ B₀ ∧ u_inv ^ R * e j ∈ integralClosure ↥A₁ K) ∧
      (∀ (L : ℕ) (c : Fin n → Fin L → k),
        (∑ j : Fin n,
          (∑ l : Fin L, algebraMap k K (c j l) * (t : K) ^ (l : ℕ)) * e j) = 0 →
        c = 0) := by
    have haeval_inj : Function.Injective (Polynomial.aeval (t : K) : Polynomial k →ₐ[k] K) := by
      intro p₁ p₂ hp
      have hsub : Polynomial.aeval (t : K) (p₁ - p₂) = 0 := by rw [map_sub, hp, sub_self]
      by_contra hne
      exact ht_tr ⟨p₁ - p₂, sub_ne_zero.mpr hne, hsub⟩
    let e_poly : Polynomial k ≃ₐ[k] ↥A₀ :=
      (AlgEquiv.ofInjective (Polynomial.aeval (t : K)) haeval_inj).trans
        (Subalgebra.equivOfEq _ _ (Algebra.adjoin_singleton_eq_range_aeval k (t : K)).symm)
    have he_poly_coe : ∀ p : Polynomial k, (e_poly p : K) = Polynomial.aeval (t : K) p :=
      fun _ => rfl
    have : IsPrincipalIdealRing ↥A₀ :=
      IsPrincipalIdealRing.of_surjective e_poly.toRingHom e_poly.surjective
    have : Module.IsTorsionFree ↥A₀ ↥B₀ := by
      rw [Module.isTorsionFree_iff_smul_eq_zero]
      intro a b hab
      have hmul : (a : K) * (b : K) = 0 := by
        have hval : ((a • b : ↥B₀) : K) = 0 := congrArg Subtype.val hab
        simpa [Algebra.smul_def] using hval
      rcases mul_eq_zero.mp hmul with ha | hb
      · exact Or.inl (Subtype.ext ha)
      · exact Or.inr (Subtype.ext hb)
    have : Module.Free ↥A₀ ↥B₀ := inferInstance
    let ι := Module.Free.ChooseBasisIndex ↥A₀ ↥B₀
    let b : Module.Basis ι ↥A₀ ↥B₀ := Module.Free.chooseBasis ↥A₀ ↥B₀

    have hA₀_sub_F₀ : ∀ a : ↥A₀, (a : K) ∈ F₀ := by
      have hle : A₀ ≤ F₀.toSubalgebra := by
        rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
        exact IntermediateField.mem_adjoin_simple_self k (t : K)
      exact fun a => hle a.2

    have hF₀_rat : ∀ y ∈ F₀, ∃ a s : ↥A₀, s ≠ 0 ∧ y = (a : K) * (s : K)⁻¹ := by
      let L_rat : IntermediateField k K :=
        { carrier := { y : K | ∃ a s : ↥A₀, s ≠ 0 ∧ y = (a : K) * (s : K)⁻¹ }
          add_mem' := by
            rintro _ _ ⟨a₁, s₁, hs₁, rfl⟩ ⟨a₂, s₂, hs₂, rfl⟩
            have h₁ : (s₁ : K) ≠ 0 := fun h => hs₁ (Subtype.ext h)
            have h₂ : (s₂ : K) ≠ 0 := fun h => hs₂ (Subtype.ext h)
            refine ⟨a₁ * s₂ + a₂ * s₁, s₁ * s₂, mul_ne_zero hs₁ hs₂, ?_⟩
            push_cast
            field_simp [h₁, h₂]
          zero_mem' := ⟨0, 1, one_ne_zero, by simp⟩
          mul_mem' := by
            rintro _ _ ⟨a₁, s₁, hs₁, rfl⟩ ⟨a₂, s₂, hs₂, rfl⟩
            refine ⟨a₁ * a₂, s₁ * s₂, mul_ne_zero hs₁ hs₂, ?_⟩
            push_cast
            ring
          one_mem' := ⟨1, 1, one_ne_zero, by simp⟩
          inv_mem' := by
            rintro _ ⟨a, s, hs, rfl⟩
            by_cases ha : a = 0
            · subst ha
              exact ⟨0, 1, one_ne_zero, by simp⟩
            · refine ⟨s, a, ha, ?_⟩
              rw [mul_inv_rev, inv_inv, mul_comm]
          algebraMap_mem' := fun c => ⟨algebraMap k ↥A₀ c, 1, one_ne_zero, by simp⟩ }
      have hle : F₀ ≤ L_rat := by
        rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
        exact ⟨⟨(t : K), Algebra.self_mem_adjoin_singleton k (t : K)⟩, 1, one_ne_zero, by simp⟩
      exact fun y hy => hle hy

    let v : ι → K := fun i => (b i : K)
    have hv_ind : LinearIndependent ↥F₀ v := by
      rw [Fintype.linearIndependent_iff]
      intro c hc i
      choose a_c s_c hs_ne hc_eq using fun j : ι => hF₀_rat (c j).1 (c j).2
      let S : ↥A₀ := ∏ j : ι, s_c j
      let p : ι → ↥A₀ := fun j => a_c j * ∏ r ∈ Finset.univ.erase j, s_c r
      have hp_eq : ∀ j : ι, (p j : K) = (c j : K) * (S : K) := by
        intro j
        have hsj : (s_c j : K) ≠ 0 := fun h => hs_ne j (Subtype.ext h)
        have hprod : s_c j * (∏ r ∈ Finset.univ.erase j, s_c r) = S :=
          Finset.mul_prod_erase Finset.univ s_c (Finset.mem_univ j)
        calc (p j : K)
            = (a_c j : K) * ((s_c j : K)⁻¹ * ((s_c j : K) *
                ((∏ r ∈ Finset.univ.erase j, s_c r : ↥A₀) : K))) := by
              rw [inv_mul_cancel_left₀ hsj]; rfl
          _ = (c j : K) * (S : K) := by
              rw [← mul_assoc, ← hc_eq j]
              congr 1
              exact congrArg Subtype.val hprod
      have hsum_B0 : ∑ j : ι, p j • b j = 0 := by
        apply Subtype.ext
        change B₀.val (∑ j : ι, p j • b j) = B₀.val 0
        rw [map_sum, map_zero]
        have h1 : (∑ j : ι, B₀.val (p j • b j)) =
            (∑ j : ι, (c j : K) * v j) * (S : K) := by
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun j _ => ?_
          change (p j : K) * (b j : K) = (c j : K) * (b j : K) * (S : K)
          rw [hp_eq j]
          ring
        have hc' : ∑ j : ι, (c j : K) * v j = 0 := by simpa [Algebra.smul_def] using hc
        rw [h1, hc', zero_mul]
      have hp0 : p i = 0 := Fintype.linearIndependent_iff.mp b.linearIndependent p hsum_B0 i
      have herase_ne : (∏ r ∈ Finset.univ.erase i, s_c r) ≠ 0 :=
        Finset.prod_ne_zero_iff.mpr fun r _ => hs_ne r
      have ha0 : a_c i = 0 := (mul_eq_zero.mp hp0).resolve_right herase_ne
      apply Subtype.ext
      rw [hc_eq i, ha0]
      simp

    have hv_span : ⊤ ≤ Submodule.span ↥F₀ (Set.range v) := by
      rintro z -
      have hz_int : _root_.IsIntegral ↥F₀ z := Algebra.IsIntegral.isIntegral z
      let P : Polynomial ↥F₀ := minpoly ↥F₀ z
      let m : ℕ := P.natDegree
      have hP_sum : z ^ m + ∑ s : Fin m, (P.coeff (s : ℕ) : K) * z ^ (s : ℕ) = 0 :=
        hMonicEvalSum P z (minpoly.monic hz_int) (minpoly.aeval ↥F₀ z)
      choose a_p d_p hd_ne hp_rat using fun s : Fin m =>
        hF₀_rat (P.coeff (s : ℕ)).1 (P.coeff (s : ℕ)).2
      let S : ↥A₀ := ∏ r : Fin m, d_p r
      have hS_ne : S ≠ 0 := Finset.prod_ne_zero_iff.mpr fun r _ => hd_ne r
      have hSK_ne : (S : K) ≠ 0 := fun h => hS_ne (Subtype.ext h)
      let p_s : Fin m → ↥A₀ := fun s => a_p s * ∏ r ∈ Finset.univ.erase s, d_p r
      have hps_eq : ∀ s : Fin m, (p_s s : K) = (P.coeff (s : ℕ) : K) * (S : K) := by
        intro s
        have hds : (d_p s : K) ≠ 0 := fun h => hd_ne s (Subtype.ext h)
        have hprod : d_p s * (∏ r ∈ Finset.univ.erase s, d_p r) = S :=
          Finset.mul_prod_erase Finset.univ d_p (Finset.mem_univ s)
        calc (p_s s : K)
            = (a_p s : K) * ((d_p s : K)⁻¹ * ((d_p s : K) *
                ((∏ r ∈ Finset.univ.erase s, d_p r : ↥A₀) : K))) := by
              rw [inv_mul_cancel_left₀ hds]; rfl
          _ = (P.coeff (s : ℕ) : K) * (S : K) := by
              rw [← mul_assoc, ← hp_rat s]
              congr 1
              exact congrArg Subtype.val hprod
      let q_s : Fin m → ↥A₀ := fun s => p_s s * S ^ (m - 1 - (s : ℕ))
      have hSz_sum : ((S : K) * z) ^ m +
          ∑ s : Fin m, (q_s s : K) * ((S : K) * z) ^ (s : ℕ) = 0 := by
        have hmul0 : (S : K) ^ m *
            (z ^ m + ∑ s : Fin m, (P.coeff (s : ℕ) : K) * z ^ (s : ℕ)) = 0 := by
          rw [hP_sum, mul_zero]
        rw [mul_add, ← mul_pow, Finset.mul_sum] at hmul0
        convert hmul0 using 2
        refine Finset.sum_congr rfl fun s _ => ?_
        have hm_split : m = (m - 1 - (s : ℕ)) + 1 + (s : ℕ) := by omega
        have hpowS : (S : K) ^ m =
            (S : K) ^ (m - 1 - (s : ℕ)) * (S : K) * (S : K) ^ (s : ℕ) := by
          conv_lhs => rw [hm_split]
          rw [pow_add, pow_add, pow_one]
        change ((p_s s : K) * (S : K) ^ (m - 1 - (s : ℕ))) * ((S : K) * z) ^ (s : ℕ) = _
        rw [hps_eq s, mul_pow, hpowS]
        ring
      let w : ↥B₀ := ⟨(S : K) * z, hMemIntOfSum m q_s ((S : K) * z) hSz_sum⟩
      have hw_eq : (∑ i : ι, ((b.repr w i : ↥A₀) : K) * v i) = (S : K) * z := by
        have hrepr := congrArg Subtype.val (b.sum_repr w)
        simpa [v, Algebra.smul_def] using hrepr
      have hz_eq : z = ∑ i : ι,
          ((⟨(b.repr w i : K), hA₀_sub_F₀ (b.repr w i)⟩ *
            (⟨(S : K), hA₀_sub_F₀ S⟩ : ↥F₀)⁻¹ : ↥F₀) • v i) := by
        apply mul_left_cancel₀ hSK_ne
        calc (S : K) * z
            = ∑ i : ι, ((b.repr w i : ↥A₀) : K) * v i := hw_eq.symm
          _ = ∑ i : ι, (S : K) * (((b.repr w i : K) * (S : K)⁻¹) * v i) := by
              refine Finset.sum_congr rfl fun i _ => ?_
              calc ((b.repr w i : ↥A₀) : K) * v i
                  = (((S : K) * (S : K)⁻¹) * (b.repr w i : K)) * v i := by
                    rw [mul_inv_cancel₀ hSK_ne, one_mul]
                _ = (S : K) * (((b.repr w i : K) * (S : K)⁻¹) * v i) := by ring
          _ = (S : K) * ∑ i : ι,
              ((⟨(b.repr w i : K), hA₀_sub_F₀ (b.repr w i)⟩ *
                (⟨(S : K), hA₀_sub_F₀ S⟩ : ↥F₀)⁻¹ : ↥F₀) • v i) := by
              rw [Finset.mul_sum]
              rfl
      rw [hz_eq]
      exact Submodule.sum_mem _ fun i _ =>
        Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_range_self i))

    let b_K : Module.Basis ι ↥F₀ K := Module.Basis.mk hv_ind hv_span
    have hcard : Fintype.card ι = n := (Module.finrank_eq_card_basis b_K).symm
    let e_B0 : Module.Basis (Fin n) ↥A₀ ↥B₀ := b.reindex (Fintype.equivFinOfCardEq hcard)
    let e : Fin n → K := fun j => (e_B0 j : K)

    choose P_e hPe_mon hPe_ev using fun j : Fin n => (e_B0 j).2
    let a_poly : ∀ j : Fin n, Fin (P_e j).natDegree → Polynomial k :=
      fun j s => e_poly.symm ((P_e j).coeff (s : ℕ))
    let r_deg : Fin n → ℕ :=
      fun j => Finset.univ.sup fun s : Fin (P_e j).natDegree => (a_poly j s).natDegree
    let R : ℕ := Finset.univ.sup r_deg

    refine ⟨R, e, ?_, ?_⟩
    · intro j
      refine ⟨(e_B0 j).2, ?_⟩
      let m_j : ℕ := (P_e j).natDegree
      have he_sum : (e j) ^ m_j +
          ∑ s : Fin m_j, ((P_e j).coeff (s : ℕ) : K) * (e j) ^ (s : ℕ) = 0 :=
        hMonicEvalSum (P_e j) (e j) (hPe_mon j) (hPe_ev j)
      have hb_mem : ∀ s : Fin m_j,
          u_inv ^ (R * (m_j - (s : ℕ))) * ((P_e j).coeff (s : ℕ) : K) ∈ A₁ := by
        intro s
        let N_s : ℕ := R * (m_j - (s : ℕ))
        have hdeg_le : (a_poly j s).natDegree ≤ N_s := by
          have h1 : (a_poly j s).natDegree ≤ r_deg j :=
            Finset.le_sup (f := fun s' : Fin m_j => (a_poly j s').natDegree) (Finset.mem_univ s)
          have h2 : r_deg j ≤ R := Finset.le_sup (f := r_deg) (Finset.mem_univ j)
          have h3 : 1 ≤ m_j - (s : ℕ) := by omega
          calc (a_poly j s).natDegree ≤ R := le_trans h1 h2
            _ = R * 1 := (mul_one R).symm
            _ ≤ R * (m_j - (s : ℕ)) := Nat.mul_le_mul_left R h3
        have ha_eq : ((P_e j).coeff (s : ℕ) : K) = Polynomial.aeval (t : K) (a_poly j s) := by
          rw [← he_poly_coe (a_poly j s), e_poly.apply_symm_apply]
        rw [ha_eq, Polynomial.aeval_eq_sum_range' (Nat.lt_succ_of_le hdeg_le), Finset.mul_sum]
        refine A₁.sum_mem fun l hl => ?_
        have hl_le : l ≤ N_s := Nat.lt_succ_iff.mp (Finset.mem_range.mp hl)
        have hN_split : N_s = (N_s - l) + l := by omega
        rw [Algebra.smul_def]
        have h_pow_cancel : u_inv ^ N_s * (algebraMap k K ((a_poly j s).coeff l) * (t : K) ^ l) =
            algebraMap k K ((a_poly j s).coeff l) * u_inv ^ (N_s - l) := by
          have hpowN : u_inv ^ N_s = u_inv ^ (N_s - l) * u_inv ^ l := by
            rw [← pow_add, ← hN_split]
          calc u_inv ^ N_s * (algebraMap k K ((a_poly j s).coeff l) * (t : K) ^ l)
              = algebraMap k K ((a_poly j s).coeff l) * u_inv ^ (N_s - l) * (u_inv ^ l * (t : K) ^ l) := by
                rw [hpowN]
                ring
            _ = algebraMap k K ((a_poly j s).coeff l) * u_inv ^ (N_s - l) := by
                rw [← mul_pow, hu_inv_mul, one_pow, mul_one]
        rw [h_pow_cancel]
        exact A₁.mul_mem (A₁.algebraMap_mem _)
          (A₁.pow_mem (Algebra.self_mem_adjoin_singleton k u_inv) _)
      let b_s : Fin m_j → ↥A₁ := fun s => ⟨_, hb_mem s⟩
      let z_j : K := u_inv ^ R * e j
      have hz_sum : z_j ^ m_j + ∑ s : Fin m_j, (b_s s : K) * z_j ^ (s : ℕ) = 0 := by
        have hmul0 : u_inv ^ (R * m_j) *
            ((e j) ^ m_j + ∑ s : Fin m_j, ((P_e j).coeff (s : ℕ) : K) * (e j) ^ (s : ℕ)) = 0 := by
          rw [he_sum, mul_zero]
        rw [mul_add, pow_mul, ← mul_pow, Finset.mul_sum] at hmul0
        convert hmul0 using 2
        refine Finset.sum_congr rfl fun s _ => ?_
        have hR_split : R * m_j = R * (m_j - (s : ℕ)) + R * (s : ℕ) := by
          rw [← Nat.mul_add]
          congr 1
          omega
        change (u_inv ^ (R * (m_j - (s : ℕ))) * ((P_e j).coeff (s : ℕ) : K)) *
            (u_inv ^ R * e j) ^ (s : ℕ) =
          (u_inv ^ R) ^ m_j * (((P_e j).coeff (s : ℕ) : K) * (e j) ^ (s : ℕ))
        rw [← pow_mul, mul_pow, ← pow_mul, hR_split, pow_add]
        ring
      exact hMemIntOfSum m_j b_s z_j hz_sum
    · intro L c hc_sum
      let p_c : Fin n → Polynomial k :=
        fun j => ∑ l : Fin L, Polynomial.monomial (l : ℕ) (c j l)
      have h_B0_zero : ∑ j : Fin n, e_poly (p_c j) • e_B0 j = 0 := by
        apply Subtype.ext
        change B₀.val (∑ j : Fin n, e_poly (p_c j) • e_B0 j) = B₀.val 0
        rw [map_sum, map_zero]
        have heq : (∑ j : Fin n, B₀.val (e_poly (p_c j) • e_B0 j)) =
            ∑ j : Fin n, (∑ l : Fin L, algebraMap k K (c j l) * (t : K) ^ (l : ℕ)) * e j := by
          refine Finset.sum_congr rfl fun j _ => ?_
          change (e_poly (p_c j) : K) * e j = _
          rw [he_poly_coe]
          congr 1
          simp only [p_c, map_sum, Polynomial.aeval_monomial, Algebra.smul_def]
        rw [heq, hc_sum]
      have hp_zero : ∀ j : Fin n, p_c j = 0 := fun j =>
        e_poly.injective
          ((Fintype.linearIndependent_iff.mp e_B0.linearIndependent
            (fun i => e_poly (p_c i)) h_B0_zero j).trans (map_zero e_poly).symm)
      funext j l
      have hcoeff : (p_c j).coeff (l : ℕ) = 0 := by rw [hp_zero j, Polynomial.coeff_zero]
      simp only [p_c, Polynomial.finset_sum_coeff, Polynomial.coeff_monomial] at hcoeff
      rw [Finset.sum_eq_single l] at hcoeff
      · simpa using hcoeff
      · intro l' _ hl'
        have hval_ne : (l' : ℕ) ≠ (l : ℕ) := fun h => hl' (Fin.ext h)
        simp [hval_ne]
      · intro h_abs
        exact False.elim (h_abs (Finset.mem_univ l))

  obtain ⟨R, e, he_mem, he_indep⟩ := h_s1
  let M : ℕ := n * R + 1
  have hM_pos : 1 ≤ M := Nat.le_add_left 1 (n * R)

  
  
  
  let degDiv : (Pt →₀ ℤ) →+ ℤ :=
    { toFun := fun E => E.sum (fun _ m => m)
      map_zero' := Finsupp.sum_zero_index
      map_add' := fun E₁ E₂ => Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl) }

  have hdiv_one : divK 1 = 0 := by
    have h1 := hdiv_mul 1 1
    rw [mul_one] at h1
    calc divK 1 = (divK 1 + divK 1) - divK 1 := by abel
      _ = divK 1 - divK 1 := by rw [← h1]
      _ = 0 := sub_self _

  have hdiv_unit_pow : ∀ (v : Units K) (m : ℕ), divK (v ^ m) = m • divK v := by
    intro v m
    induction m with
    | zero => rw [pow_zero, zero_nsmul, hdiv_one]
    | succ m ih => rw [pow_succ', hdiv_mul, ih, succ_nsmul']

  have hdiv_prod : ∀ (S : Finset Pt) (f : Pt → Units K),
      divK (∏ x ∈ S, f x) = ∑ x ∈ S, divK (f x) := by
    intro S f
    refine Finset.induction_on S ?_ ?_
    · rw [Finset.prod_empty, Finset.sum_empty, hdiv_one]
    · intro x s hx ih
      rw [Finset.prod_insert hx, Finset.sum_insert hx, hdiv_mul, ih]

  let D_infty : Pt →₀ ℤ :=
    (divK t).mapRange (fun m : ℤ => if m < 0 then -m else 0) (by simp)

  have hD_infty_deg : degDiv D_infty = (n : ℤ) := by
    change ((divK t).mapRange (fun m : ℤ => if m < 0 then -m else 0) (by simp)).sum
      (fun _ m => m) = (n : ℤ)
    rw [Finsupp.sum_mapRange_index (fun _ => rfl)]
    have hpos : ∑ x ∈ (divK t).support, (if 0 < divK t x then divK t x else 0) = (n : ℤ) :=
      hdeg_t
    have hsum0 : ∑ x ∈ (divK t).support, divK t x = 0 := hdiv_sum t
    have hsplit : (∑ x ∈ (divK t).support, (if 0 < divK t x then divK t x else 0)) =
        (∑ x ∈ (divK t).support, divK t x) +
        (∑ x ∈ (divK t).support, (if divK t x < 0 then -divK t x else 0)) := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun x _ => ?_
      omega
    change ∑ x ∈ (divK t).support, (if divK t x < 0 then -divK t x else 0) = (n : ℤ)
    omega

  
  have hValInt : ∀ (W : ValuationSubring K) (A : Subalgebra k K),
      (∀ a : ↥A, (a : K) ∈ W) → ∀ z : ↥(integralClosure ↥A K), (z : K) ∈ W := by
    intro W A hAW z
    by_cases hz : (z : K) ∈ W
    · exact hz
    · have hz_ne : (z : K) ≠ 0 := fun h0 => hz (h0 ▸ zero_mem W)
      have hz_inv : (z : K)⁻¹ ∈ W :=
        (ValuationSubring.mem_or_inv_mem W (z : K)).resolve_left hz
      obtain ⟨P, hP_mon, hP_ev⟩ := z.2
      let m : ℕ := P.natDegree
      have hP_sum : (z : K) ^ m +
          ∑ s : Fin m, (P.coeff (s : ℕ) : K) * (z : K) ^ (s : ℕ) = 0 :=
        hMonicEvalSum P (z : K) hP_mon hP_ev
      have hm_pos : 1 ≤ m := by
        by_contra hm0
        have hm_eq : m = 0 := by omega
        have hsum0 : (z : K) ^ 0 +
            ∑ s : Fin 0, (P.coeff (s : ℕ) : K) * (z : K) ^ (s : ℕ) = 0 :=
          hm_eq ▸ hP_sum
        simp at hsum0
      have hmul_inv : (z : K) +
          ∑ s : Fin m, (P.coeff (s : ℕ) : K) * ((z : K)⁻¹) ^ (m - 1 - (s : ℕ)) = 0 := by
        have h0 : ((z : K) ^ m +
            ∑ s : Fin m, (P.coeff (s : ℕ) : K) * (z : K) ^ (s : ℕ)) *
            ((z : K)⁻¹) ^ (m - 1) = 0 := by
          rw [hP_sum, zero_mul]
        rw [add_mul, Finset.sum_mul] at h0
        have h_first : (z : K) ^ m * ((z : K)⁻¹) ^ (m - 1) = (z : K) := by
          have hm1 : (m - 1) + 1 = m := by omega
          calc (z : K) ^ m * ((z : K)⁻¹) ^ (m - 1)
              = ((z : K) ^ (m - 1) * (z : K)) * ((z : K)⁻¹) ^ (m - 1) := by
                rw [← pow_succ, hm1]
            _ = ((z : K) * (z : K)⁻¹) ^ (m - 1) * (z : K) := by
                rw [mul_pow]
                ring
            _ = (z : K) := by
                rw [mul_inv_cancel₀ hz_ne, one_pow, one_mul]
        have h_rest : (∑ s : Fin m,
              ((P.coeff (s : ℕ) : K) * (z : K) ^ (s : ℕ)) * ((z : K)⁻¹) ^ (m - 1)) =
            ∑ s : Fin m, (P.coeff (s : ℕ) : K) * ((z : K)⁻¹) ^ (m - 1 - (s : ℕ)) := by
          refine Finset.sum_congr rfl fun s _ => ?_
          have hs_eq : (s : ℕ) + (m - 1 - (s : ℕ)) = m - 1 := by omega
          calc ((P.coeff (s : ℕ) : K) * (z : K) ^ (s : ℕ)) * ((z : K)⁻¹) ^ (m - 1)
              = ((P.coeff (s : ℕ) : K) * (z : K) ^ (s : ℕ)) *
                  (((z : K)⁻¹) ^ (s : ℕ) * ((z : K)⁻¹) ^ (m - 1 - (s : ℕ))) := by
                rw [← pow_add, hs_eq]
            _ = (P.coeff (s : ℕ) : K) * ((z : K) * (z : K)⁻¹) ^ (s : ℕ) *
                  ((z : K)⁻¹) ^ (m - 1 - (s : ℕ)) := by
                rw [mul_pow]
                ring
            _ = (P.coeff (s : ℕ) : K) * ((z : K)⁻¹) ^ (m - 1 - (s : ℕ)) := by
                rw [mul_inv_cancel₀ hz_ne, one_pow, mul_one]
        rw [h_first, h_rest] at h0
        exact h0
      have hz_eq : (z : K) =
          -∑ s : Fin m, (P.coeff (s : ℕ) : K) * ((z : K)⁻¹) ^ (m - 1 - (s : ℕ)) :=
        eq_neg_of_add_eq_zero_left hmul_inv
      rw [hz_eq]
      exact neg_mem (sum_mem fun s _ => mul_mem (hAW (P.coeff (s : ℕ))) (pow_mem hz_inv _))

  
  
  
  have h_s4 : ∀ (m : ℕ) (E : Pt →₀ ℤ),
      (∀ x : Pt, 0 ≤ E x) → degDiv E = (m : ℤ) →
      ∃ Q : Fin m → Pt, E = ∑ j : Fin m, Finsupp.single (Q j) (1 : ℤ) := by
    intro m
    induction m with
    | zero =>
      intro E hE_nonneg hE_deg
      have hE_zero : E = 0 := by
        by_contra hne
        obtain ⟨x₀, hx₀⟩ := Finsupp.support_nonempty_iff.mpr hne
        have hx₀_ne : E x₀ ≠ 0 := Finsupp.mem_support_iff.mp hx₀
        have hx₀_pos : 1 ≤ E x₀ := by have := hE_nonneg x₀; omega
        have hle : E x₀ ≤ ∑ x ∈ E.support, E x :=
          Finset.single_le_sum (fun x _ => hE_nonneg x) hx₀
        have hsum0 : ∑ x ∈ E.support, E x = 0 := by simpa [degDiv, Finsupp.sum] using hE_deg
        omega
      refine ⟨Fin.elim0, ?_⟩
      simp [hE_zero]
    | succ m ih =>
      intro E hE_nonneg hE_deg
      have hE_ne : E ≠ 0 := by
        intro h0
        rw [h0, map_zero] at hE_deg
        omega
      obtain ⟨x₀, hx₀⟩ := Finsupp.support_nonempty_iff.mpr hE_ne
      have hx₀_ne : E x₀ ≠ 0 := Finsupp.mem_support_iff.mp hx₀
      have hx₀_pos : 1 ≤ E x₀ := by have := hE_nonneg x₀; omega
      let E' : Pt →₀ ℤ := E - Finsupp.single x₀ (1 : ℤ)
      have hE'_nonneg : ∀ x : Pt, 0 ≤ E' x := by
        intro x
        simp only [E', Finsupp.sub_apply, Finsupp.single_apply]
        split_ifs with hx
        · subst hx; omega
        · have := hE_nonneg x; omega
      have hE'_deg : degDiv E' = (m : ℤ) := by
        have hsingle : degDiv (Finsupp.single x₀ (1 : ℤ)) = 1 := by
          change (Finsupp.single x₀ (1 : ℤ)).sum (fun _ n => n) = 1
          exact Finsupp.sum_single_index rfl
        have hsub : degDiv E' = degDiv E - degDiv (Finsupp.single x₀ (1 : ℤ)) :=
          map_sub degDiv E _
        rw [hsub, hE_deg, hsingle]
        omega
      obtain ⟨Q', hQ'⟩ := ih E' hE'_nonneg hE'_deg
      let Q_next : Fin (m + 1) → Pt := Fin.cons x₀ Q'
      refine ⟨Q_next, ?_⟩
      rw [Fin.sum_univ_succ]
      have h0_eq : Q_next 0 = x₀ := rfl
      have htail : (∑ i : Fin m, Finsupp.single (Q_next i.succ) (1 : ℤ)) =
          ∑ i : Fin m, Finsupp.single (Q' i) (1 : ℤ) :=
        Finset.sum_congr rfl fun i _ => by
          have hs : Q_next i.succ = Q' i := @Fin.cons_succ m (fun _ => Pt) x₀ Q' i
          rw [hs]
      rw [h0_eq, htail, ← hQ']
      dsimp [E']
      abel

  
  
  
  refine ⟨M, fun D hD_deg0 => ?_⟩
  let D₁ : Pt →₀ ℤ := D + Finsupp.single P₀ (M : ℤ)
  have hD₁_deg : degDiv D₁ = (M : ℤ) := by
    have hsingle : degDiv (Finsupp.single P₀ (M : ℤ)) = (M : ℤ) := by
      change (Finsupp.single P₀ (M : ℤ)).sum (fun _ n => n) = (M : ℤ)
      exact Finsupp.sum_single_index rfl
    change degDiv (D + Finsupp.single P₀ (M : ℤ)) = (M : ℤ)
    rw [map_add, show degDiv D = 0 from hD_deg0, hsingle, zero_add]

  
  have hLinNe : ∀ c : k, (t : K) - algebraMap k K c ≠ 0 := by
    intro c h0
    have hev : Polynomial.aeval (t : K) (Polynomial.X - Polynomial.C c) = 0 := by
      simp [h0]
    exact ht_tr ⟨Polynomial.X - Polynomial.C c, Polynomial.X_sub_C_ne_zero c, hev⟩

  let u_of : Pt → Units K := fun x =>
    if htx : (t : K) ∈ V_pt x then
      Units.mk0 ((t : K) - algebraMap k K ((hV x).2.2.2 ⟨(t : K), htx⟩).choose)
        (hLinNe ((hV x).2.2.2 ⟨(t : K), htx⟩).choose)
    else 1

  have hu_of_laws : ∀ (x : Pt), (t : K) ∈ V_pt x →
      (1 : ℤ) ≤ divK (u_of x) x ∧
      (∀ z : Pt, (t : K) ∈ V_pt z → 0 ≤ divK (u_of x) z) ∧
      (∀ y : Pt, (t : K) ∉ V_pt y → divK (u_of x) y = divK t y) := by
    intro x htx
    let c_x : k := ((hV x).2.2.2 ⟨(t : K), htx⟩).choose
    let hc_x : algebraMap k K c_x ∈ V_pt x := ((hV x).2.2.2 ⟨(t : K), htx⟩).choose_spec.choose
    have hm_x : (⟨(t : K), htx⟩ : ↥(V_pt x)) - ⟨algebraMap k K c_x, hc_x⟩ ∈
        IsLocalRing.maximalIdeal ↥(V_pt x) :=
      ((hV x).2.2.2 ⟨(t : K), htx⟩).choose_spec.choose_spec
    have hu_eq : u_of x = Units.mk0 ((t : K) - algebraMap k K c_x) (hLinNe c_x) := by
      dsimp [u_of, c_x]
      rw [dif_pos htx]
    have hu_val : ((u_of x : Units K) : K) = (t : K) - algebraMap k K c_x := by
      rw [hu_eq]; rfl
    refine ⟨?_, ?_, ?_⟩
    · have hu_mem : ((u_of x : Units K) : K) ∈ V_pt x := by
        rw [hu_val]
        exact sub_mem htx hc_x
      have hsub_eq : (⟨((u_of x : Units K) : K), hu_mem⟩ : ↥(V_pt x)) =
          ⟨(t : K), htx⟩ - ⟨algebraMap k K c_x, hc_x⟩ :=
        Subtype.ext hu_val
      have hpow1 : (⟨((u_of x : Units K) : K), hu_mem⟩ : ↥(V_pt x)) ∈
          (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ 1 := by
        rw [pow_one, hsub_eq]
        exact hm_x
      exact (hdiv_pow (u_of x) x 1 hu_mem).mp hpow1
    · intro z htz
      have hu_mem_z : ((u_of x : Units K) : K) ∈ V_pt z := by
        rw [hu_val]
        exact sub_mem htz ((hV z).1 c_x)
      exact (hdiv_nonneg (u_of x) z).mp hu_mem_z
    · intro y hty
      have htinv_y : u_inv ∈ V_pt y := by
        dsimp [u_inv]
        rw [Units.val_inv_eq_inv_val]
        exact (ValuationSubring.mem_or_inv_mem (V_pt y) (t : K)).resolve_left hty
      have hdiv_ty_neg : divK t y < 0 := by
        have hnot := (hdiv_nonneg t y).not.mp hty
        omega
      have htinv_pos : (1 : ℤ) ≤ divK t⁻¹ y := by
        rw [hdiv_inv t, Finsupp.neg_apply]
        omega
      have htinv_max : (⟨u_inv, htinv_y⟩ : ↥(V_pt y)) ∈ IsLocalRing.maximalIdeal ↥(V_pt y) := by
        rw [← pow_one (IsLocalRing.maximalIdeal ↥(V_pt y))]
        exact (hdiv_pow t⁻¹ y 1 htinv_y).mpr htinv_pos
      let w_val : K := 1 - algebraMap k K c_x * u_inv
      have htw_mul : (t : K) * w_val = ((u_of x : Units K) : K) := by
        rw [hu_val]
        dsimp [w_val]
        calc (t : K) * (1 - algebraMap k K c_x * u_inv)
            = (t : K) - algebraMap k K c_x * ((t : K) * u_inv) := by ring
          _ = (t : K) - algebraMap k K c_x := by rw [ht_mul_u_inv, mul_one]
      have hw_ne : w_val ≠ 0 := by
        intro hw0
        apply (u_of x).ne_zero
        rw [← htw_mul, hw0, mul_zero]
      let w_unit : Units K := Units.mk0 w_val hw_ne
      have hu_prod : u_of x = t * w_unit := Units.ext htw_mul.symm
      have hw_mem : (w_unit : K) ∈ V_pt y :=
        sub_mem (one_mem (V_pt y)) (mul_mem ((hV y).1 c_x) htinv_y)
      have hw_nonneg : 0 ≤ divK w_unit y := (hdiv_nonneg w_unit y).mp hw_mem
      have hw_lt1 : ¬((1 : ℤ) ≤ divK w_unit y) := by
        intro hw_ge1
        have hw_max : (⟨(w_unit : K), hw_mem⟩ : ↥(V_pt y)) ∈
            IsLocalRing.maximalIdeal ↥(V_pt y) := by
          rw [← pow_one (IsLocalRing.maximalIdeal ↥(V_pt y))]
          exact (hdiv_pow w_unit y 1 hw_mem).mpr hw_ge1
        have hprod_max : (⟨algebraMap k K c_x, (hV y).1 c_x⟩ : ↥(V_pt y)) *
            ⟨u_inv, htinv_y⟩ ∈ IsLocalRing.maximalIdeal ↥(V_pt y) :=
          Ideal.mul_mem_left _ _ htinv_max
        have hone_eq : (⟨(w_unit : K), hw_mem⟩ : ↥(V_pt y)) +
            ⟨algebraMap k K c_x, (hV y).1 c_x⟩ * ⟨u_inv, htinv_y⟩ = 1 := by
          apply Subtype.ext
          change (1 - algebraMap k K c_x * u_inv) + algebraMap k K c_x * u_inv = 1
          ring
        have hone_mem : (1 : ↥(V_pt y)) ∈ IsLocalRing.maximalIdeal ↥(V_pt y) := by
          rw [← hone_eq]
          exact Ideal.add_mem _ hw_max hprod_max
        exact (IsLocalRing.maximalIdeal.isMaximal ↥(V_pt y)).ne_top
          ((Ideal.eq_top_iff_one _).mpr hone_mem)
      have hw_zero : divK w_unit y = 0 := by omega
      rw [hu_prod, hdiv_mul, Finsupp.add_apply, hw_zero, add_zero]

  
  let S_fin : Finset Pt := D₁.support.filter fun x => 0 < D₁ x ∧ (t : K) ∈ V_pt x
  let u : Units K := ∏ x ∈ S_fin, (u_of x) ^ (D₁ x).toNat
  let d : ℕ := R + ∑ w ∈ D₁.support, (D₁ w).toNat
  let G : Pt →₀ ℤ := d • D_infty - (D₁ - divK u)

  have hd_ge : R + 1 ≤ d := by
    have hM_le_sum : (M : ℤ) ≤ ((∑ w ∈ D₁.support, (D₁ w).toNat : ℕ) : ℤ) := by
      rw [← hD₁_deg, Nat.cast_sum]
      exact Finset.sum_le_sum fun w _ => Int.self_le_toNat (D₁ w)
    have hM_nat : M ≤ ∑ w ∈ D₁.support, (D₁ w).toNat := Nat.cast_le.mp hM_le_sum
    dsimp [d]
    omega

  have hd_le : R ≤ d := by omega

  have hdiv_u_apply : ∀ z : Pt,
      divK u z = ∑ x ∈ S_fin, ((D₁ x).toNat : ℤ) * divK (u_of x) z := by
    intro z
    dsimp [u]
    rw [hdiv_prod, Finsupp.finsetSum_apply]
    refine Finset.sum_congr rfl fun x _ => ?_
    rw [hdiv_unit_pow, Finsupp.smul_apply, nsmul_eq_mul]

  have hG_nonneg : ∀ z : Pt, 0 ≤ G z := by
    intro z
    simp only [G, D_infty, Finsupp.sub_apply, Finsupp.smul_apply, Finsupp.mapRange_apply,
      nsmul_eq_mul]
    by_cases htz : (t : K) ∈ V_pt z
    · have htz_nonneg : 0 ≤ divK t z := (hdiv_nonneg t z).mp htz
      have htz_not_lt : ¬(divK t z < 0) := by omega
      rw [if_neg htz_not_lt, mul_zero, zero_sub, neg_nonneg, sub_nonpos]
      rw [hdiv_u_apply z]
      have hterm_nonneg : ∀ x ∈ S_fin, 0 ≤ ((D₁ x).toNat : ℤ) * divK (u_of x) z := by
        intro x hx
        have htx : (t : K) ∈ V_pt x := (Finset.mem_filter.mp hx).2.2
        exact mul_nonneg (Nat.cast_nonneg _) ((hu_of_laws x htx).2.1 z htz)
      by_cases hDz : 0 < D₁ z
      · have hz_supp : z ∈ D₁.support := Finsupp.mem_support_iff.mpr (by omega)
        have hz_S : z ∈ S_fin := Finset.mem_filter.mpr ⟨hz_supp, hDz, htz⟩
        have hsingle_le : ((D₁ z).toNat : ℤ) * divK (u_of z) z ≤
            ∑ x ∈ S_fin, ((D₁ x).toNat : ℤ) * divK (u_of x) z :=
          Finset.single_le_sum hterm_nonneg hz_S
        have huz_ge1 : (1 : ℤ) ≤ divK (u_of z) z := (hu_of_laws z htz).1
        have hDz_toNat : ((D₁ z).toNat : ℤ) = D₁ z := Int.toNat_of_nonneg (by omega)
        calc D₁ z = ((D₁ z).toNat : ℤ) * 1 := by rw [hDz_toNat, mul_one]
          _ ≤ ((D₁ z).toNat : ℤ) * divK (u_of z) z :=
              mul_le_mul_of_nonneg_left huz_ge1 (Nat.cast_nonneg _)
          _ ≤ ∑ x ∈ S_fin, ((D₁ x).toNat : ℤ) * divK (u_of x) z := hsingle_le
      · exact le_trans (by omega : D₁ z ≤ 0) (Finset.sum_nonneg hterm_nonneg)
    · have htz_lt : divK t z < 0 := by
        have hnot := (hdiv_nonneg t z).not.mp htz
        omega
      rw [if_pos htz_lt]
      have hdiv_uz : divK u z =
          -(((∑ x ∈ S_fin, (D₁ x).toNat : ℕ) : ℤ) * (-divK t z)) := by
        rw [hdiv_u_apply z, Nat.cast_sum, Finset.sum_mul, ← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl fun x hx => ?_
        have htx : (t : K) ∈ V_pt x := (Finset.mem_filter.mp hx).2.2
        rw [(hu_of_laws x htx).2.2 z htz]
        ring
      have hsum_le_d : (D₁ z).toNat + ∑ x ∈ S_fin, (D₁ x).toNat ≤ d := by
        have hsub_supp : S_fin ⊆ D₁.support := Finset.filter_subset _ _
        have hle_all : (D₁ z).toNat + ∑ x ∈ S_fin, (D₁ x).toNat ≤
            ∑ w ∈ D₁.support, (D₁ w).toNat := by
          by_cases hz_supp : z ∈ D₁.support
          · have hz_not_S : z ∉ S_fin := fun hzS => htz (Finset.mem_filter.mp hzS).2.2
            have h_ins : (D₁ z).toNat + ∑ x ∈ S_fin, (D₁ x).toNat =
                ∑ w ∈ insert z S_fin, (D₁ w).toNat :=
              (Finset.sum_insert (f := fun w => (D₁ w).toNat) hz_not_S).symm
            rw [h_ins]
            exact Finset.sum_le_sum_of_subset
              (Finset.insert_subset_iff.mpr ⟨hz_supp, hsub_supp⟩)
          · have hDz0 : D₁ z = 0 := Finsupp.notMem_support_iff.mp hz_supp
            rw [hDz0, Int.toNat_zero, zero_add]
            exact Finset.sum_le_sum_of_subset hsub_supp
        dsimp [d]
        omega
      have hDz_le : D₁ z ≤ ((D₁ z).toNat : ℤ) * (-divK t z) := by
        calc D₁ z ≤ ((D₁ z).toNat : ℤ) := Int.self_le_toNat (D₁ z)
          _ = ((D₁ z).toNat : ℤ) * 1 := (mul_one _).symm
          _ ≤ ((D₁ z).toNat : ℤ) * (-divK t z) :=
              mul_le_mul_of_nonneg_left (by omega : (1 : ℤ) ≤ -divK t z) (Nat.cast_nonneg _)
      have hK_le_d : (((D₁ z).toNat + ∑ x ∈ S_fin, (D₁ x).toNat : ℕ) : ℤ) * (-divK t z) ≤
          (d : ℤ) * (-divK t z) :=
        mul_le_mul_of_nonneg_right (Nat.cast_le.mpr hsum_le_d) (by omega)
      rw [hdiv_uz]
      rw [Nat.cast_add, add_mul] at hK_le_d
      linarith

  have hG_deg : degDiv G = (d : ℤ) * (n : ℤ) - (M : ℤ) := by
    change degDiv (d • D_infty - (D₁ - divK u)) = (d : ℤ) * (n : ℤ) - (M : ℤ)
    rw [map_sub, map_nsmul, map_sub, hD_infty_deg, hD₁_deg,
      show degDiv (divK u) = 0 from hdiv_sum u, nsmul_eq_mul, sub_zero]

  
  
  
  let L_len : ℕ := d - R + 1
  let W_dom : Type u := Fin n → Fin L_len → k
  have hW_dom_fr : Module.finrank k W_dom = n * L_len := by
    dsimp [W_dom]
    rw [Module.finrank_pi_fintype k]
    simp [Module.finrank_fin_fun, Finset.sum_const, smul_eq_mul]

  let ι_d : W_dom →ₗ[k] K :=
    { toFun := fun c =>
        ∑ j : Fin n,
          (∑ l : Fin L_len, algebraMap k K (c j l) * (t : K) ^ (l : ℕ)) * e j
      map_add' := fun c₁ c₂ => by
        change (∑ j : Fin n,
          (∑ l : Fin L_len, algebraMap k K (c₁ j l + c₂ j l) * (t : K) ^ (l : ℕ)) * e j) = _
        simp only [map_add, add_mul, Finset.sum_add_distrib]
      map_smul' := fun r c => by
        have h_lhs : ∀ (j : Fin n) (l : Fin L_len), (r • c) j l = r * c j l := fun _ _ => rfl
        simp_rw [h_lhs, RingHom.id_apply, Algebra.smul_def]
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [← mul_assoc, Finset.mul_sum]
        congr 1
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [map_mul]
        ring }

  have hι_inj : Function.Injective ι_d := by
    intro c₁ c₂ h_eq
    have hsub : ι_d (c₁ - c₂) = 0 := by rw [map_sub, h_eq, sub_self]
    exact sub_eq_zero.mp (he_indep L_len (c₁ - c₂) hsub)

  have hι_mem_fin : ∀ (c : W_dom) (x : Pt), (t : K) ∈ V_pt x → ι_d c ∈ V_pt x := by
    intro c x htx
    let V_alg : Subalgebra k K :=
      { (V_pt x).toSubring with algebraMap_mem' := (hV x).1 }
    have hA₀_sub : ∀ a : ↥A₀, (a : K) ∈ V_pt x := by
      have hle : A₀ ≤ V_alg := by
        rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
        exact htx
      exact fun a => hle a.2
    change (∑ j : Fin n,
      (∑ l : Fin L_len, algebraMap k K (c j l) * (t : K) ^ (l : ℕ)) * e j) ∈ V_pt x
    refine sum_mem fun j _ => ?_
    have hej_x : e j ∈ V_pt x := hValInt (V_pt x) A₀ hA₀_sub ⟨e j, (he_mem j).1⟩
    refine mul_mem ?_ hej_x
    exact sum_mem fun l _ =>
      mul_mem ((hV x).1 (c j l)) (pow_mem htx _)

  have hι_mem_inf : ∀ (c : W_dom) (x : Pt), (t : K) ∉ V_pt x →
      u_inv ^ d * ι_d c ∈ V_pt x := by
    intro c x htx
    have hu_inv_x : u_inv ∈ V_pt x := by
      dsimp [u_inv]
      rw [Units.val_inv_eq_inv_val]
      exact (ValuationSubring.mem_or_inv_mem (V_pt x) (t : K)).resolve_left htx
    let V_alg : Subalgebra k K :=
      { (V_pt x).toSubring with algebraMap_mem' := (hV x).1 }
    have hA₁_sub : ∀ a : ↥A₁, (a : K) ∈ V_pt x := by
      have hle : A₁ ≤ V_alg := by
        rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
        exact hu_inv_x
      exact fun a => hle a.2
    change u_inv ^ d * (∑ j : Fin n,
      (∑ l : Fin L_len, algebraMap k K (c j l) * (t : K) ^ (l : ℕ)) * e j) ∈ V_pt x
    rw [Finset.mul_sum]
    refine sum_mem fun j _ => ?_
    have hej_x : u_inv ^ R * e j ∈ V_pt x :=
      hValInt (V_pt x) A₁ hA₁_sub ⟨u_inv ^ R * e j, (he_mem j).2⟩
    rw [← mul_assoc, Finset.mul_sum, Finset.sum_mul]
    refine sum_mem fun l _ => ?_
    have hl_le : (l : ℕ) ≤ d - R := by have := l.2; omega
    have hd_split : (d - R - (l : ℕ)) + (l : ℕ) + R = d := by omega
    have hpow_d : u_inv ^ d = u_inv ^ (d - R - (l : ℕ)) * u_inv ^ (l : ℕ) * u_inv ^ R := by
      rw [← pow_add, ← pow_add, hd_split]
    have hterm : u_inv ^ d * (algebraMap k K (c j l) * (t : K) ^ (l : ℕ)) * e j =
        algebraMap k K (c j l) * u_inv ^ (d - R - (l : ℕ)) * (u_inv ^ R * e j) := by
      calc u_inv ^ d * (algebraMap k K (c j l) * (t : K) ^ (l : ℕ)) * e j
          = algebraMap k K (c j l) * u_inv ^ (d - R - (l : ℕ)) *
              (u_inv ^ (l : ℕ) * (t : K) ^ (l : ℕ)) * (u_inv ^ R * e j) := by
            rw [hpow_d]
            ring
        _ = algebraMap k K (c j l) * u_inv ^ (d - R - (l : ℕ)) * (u_inv ^ R * e j) := by
            rw [← mul_pow, hu_inv_mul, one_pow, mul_one]
    rw [hterm]
    exact mul_mem (mul_mem ((hV x).1 (c j l)) (pow_mem hu_inv_x _)) hej_x

  let _ : ∀ x : Pt, Algebra k ↥(V_pt x) := fun x =>
    ((algebraMap k K).codRestrict (V_pt x).toSubring (hV x).1).toAlgebra

  have hQ_dvr : ∀ x : Pt,
      FiniteDimensional k (↥(V_pt x) ⧸ (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ (G x).toNat) ∧
      Module.finrank k (↥(V_pt x) ⧸ (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ (G x).toNat) ≤
        (G x).toNat := by
    intro x
    have : IsDiscreteValuationRing ↥(V_pt x) := (hV x).2.2.1
    apply hDvrQuot ↥(V_pt x)
    intro z
    obtain ⟨c, hc, hz⟩ := (hV x).2.2.2 z
    exact ⟨c, hz⟩

  have : ∀ x : Pt,
      FiniteDimensional k (↥(V_pt x) ⧸ (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ (G x).toNat) :=
    fun x => (hQ_dvr x).1

  let liftV : ∀ x : Pt, W_dom →ₗ[k] ↥(V_pt x) := fun x =>
    { toFun := fun c =>
        if htx : (t : K) ∈ V_pt x then ⟨ι_d c, hι_mem_fin c x htx⟩
        else ⟨u_inv ^ d * ι_d c, hι_mem_inf c x htx⟩
      map_add' := fun c₁ c₂ => by
        split_ifs <;> apply Subtype.ext <;> simp [map_add, mul_add]
      map_smul' := fun r c => by
        split_ifs
        · rw [Algebra.smul_def]
          apply Subtype.ext
          change ι_d (r • c) = algebraMap k K r * ι_d c
          rw [ι_d.map_smul, Algebra.smul_def]
        · rw [Algebra.smul_def]
          apply Subtype.ext
          change u_inv ^ d * ι_d (r • c) = algebraMap k K r * (u_inv ^ d * ι_d c)
          rw [ι_d.map_smul, Algebra.smul_def]
          ring }

  let ψ_x : ∀ x : Pt,
      W_dom →ₗ[k] (↥(V_pt x) ⧸ (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ (G x).toNat) :=
    fun x =>
      (Ideal.Quotient.mkₐ k ((IsLocalRing.maximalIdeal ↥(V_pt x)) ^ (G x).toNat)).toLinearMap.comp
        (liftV x)

  let W_cod : Type u :=
    ∀ x : ↥G.support, (↥(V_pt x.1) ⧸ (IsLocalRing.maximalIdeal ↥(V_pt x.1)) ^ (G x.1).toNat)
  have : FiniteDimensional k W_cod := inferInstance
  let Ψ : W_dom →ₗ[k] W_cod := LinearMap.pi fun x : ↥G.support => ψ_x x.1

  have hfr_cod_lt : Module.finrank k W_cod < Module.finrank k W_dom := by
    have hcod_le : Module.finrank k W_cod ≤ ∑ x ∈ G.support, (G x).toNat := by
      calc Module.finrank k W_cod
          = ∑ x : ↥G.support,
              Module.finrank k
                (↥(V_pt x.1) ⧸ (IsLocalRing.maximalIdeal ↥(V_pt x.1)) ^ (G x.1).toNat) :=
            Module.finrank_pi_fintype k
        _ ≤ ∑ x : ↥G.support, (G x.1).toNat :=
            Finset.sum_le_sum fun x _ => (hQ_dvr x.1).2
        _ = ∑ x ∈ G.support, (G x).toNat :=
            Finset.sum_coe_sort G.support (fun y => (G y).toNat)
    have hsum_G_eq : ((∑ x ∈ G.support, (G x).toNat : ℕ) : ℤ) = degDiv G := by
      change ((∑ x ∈ G.support, (G x).toNat : ℕ) : ℤ) = ∑ x ∈ G.support, G x
      rw [Nat.cast_sum]
      exact Finset.sum_congr rfl fun x _ => Int.toNat_of_nonneg (hG_nonneg x)
    have hG_lt_dom : degDiv G < ((n * L_len : ℕ) : ℤ) := by
      rw [hG_deg]
      let k_diff : ℕ := d - R
      have hd_eq : d = R + k_diff := (Nat.add_sub_of_le hd_le).symm
      have hL_eq : L_len = k_diff + 1 := rfl
      have hM_eq : M = n * R + 1 := rfl
      rw [hd_eq, hL_eq, hM_eq]
      push_cast
      have hn_int : (1 : ℤ) ≤ (n : ℤ) := Nat.one_le_cast.mpr hn_pos
      linarith
    have hcast_lt : ((Module.finrank k W_cod : ℕ) : ℤ) < ((Module.finrank k W_dom : ℕ) : ℤ) := by
      rw [hW_dom_fr]
      exact lt_of_le_of_lt (hsum_G_eq ▸ Nat.cast_le.mpr hcod_le) hG_lt_dom
    exact Nat.cast_lt.mp hcast_lt

  have hker_pos : 0 < Module.finrank k ↥Ψ.ker := by
    have h_rn := LinearMap.finrank_range_add_finrank_ker Ψ
    have h_range_le : Module.finrank k ↥Ψ.range ≤ Module.finrank k W_cod :=
      Submodule.finrank_le Ψ.range
    omega

  obtain ⟨c_ker, hc_ker_ne⟩ := (Module.finrank_pos_iff_exists_ne_zero (R := k) (M := ↥Ψ.ker)).mp hker_pos
  let c₀ : W_dom := c_ker.1
  have hc₀_ne : c₀ ≠ 0 := fun h0 => hc_ker_ne (Subtype.ext h0)
  have hΨ_c₀ : Ψ c₀ = 0 := c_ker.2
  have hι_c₀_ne : ι_d c₀ ≠ 0 := fun h0 => hc₀_ne (hι_inj (by rw [h0, map_zero]))
  let h : Units K := Units.mk0 (ι_d c₀) hι_c₀_ne

  have hh_bound : ∀ x : Pt, G x ≤ divK h x + (d : ℤ) * D_infty x := by
    intro x
    have hGx_toNat : ((G x).toNat : ℤ) = G x := Int.toNat_of_nonneg (hG_nonneg x)
    by_cases htx : (t : K) ∈ V_pt x
    · have htz_nonneg : 0 ≤ divK t x := (hdiv_nonneg t x).mp htx
      have hD_inf_0 : D_infty x = 0 := by
        simp only [D_infty, Finsupp.mapRange_apply]
        split_ifs <;> omega
      rw [hD_inf_0, mul_zero, add_zero]
      have hh_mem : (h : K) ∈ V_pt x := hι_mem_fin c₀ x htx
      by_cases hx_supp : x ∈ G.support
      · have hψ0 : ψ_x x c₀ = 0 := congrArg (fun f : W_cod => f ⟨x, hx_supp⟩) hΨ_c₀
        have hlift_eq : liftV x c₀ = ⟨(h : K), hh_mem⟩ := by
          apply Subtype.ext
          simp [liftV, dif_pos htx, h]
        have hquot0 : Ideal.Quotient.mk ((IsLocalRing.maximalIdeal ↥(V_pt x)) ^ (G x).toNat)
            (⟨(h : K), hh_mem⟩ : ↥(V_pt x)) = 0 := by
          rw [← hlift_eq]
          exact hψ0
        have hmem_pow : (⟨(h : K), hh_mem⟩ : ↥(V_pt x)) ∈
            (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ (G x).toNat :=
          Ideal.Quotient.eq_zero_iff_mem.mp hquot0
        have hle := (hdiv_pow h x (G x).toNat hh_mem).mp hmem_pow
        omega
      · have hGx0 : G x = 0 := Finsupp.notMem_support_iff.mp hx_supp
        rw [hGx0]
        exact (hdiv_nonneg h x).mp hh_mem
    · have htx_lt : divK t x < 0 := by
        have hnot := (hdiv_nonneg t x).not.mp htx
        omega
      have hD_inf_eq : D_infty x = -divK t x := by
        simp only [D_infty, Finsupp.mapRange_apply, if_pos htx_lt]
      let w_h : Units K := (t⁻¹) ^ d * h
      have hw_h_div : divK w_h x = divK h x + (d : ℤ) * D_infty x := by
        dsimp [w_h]
        rw [hdiv_mul, hdiv_unit_pow, hdiv_inv, Finsupp.add_apply, Finsupp.smul_apply,
          Finsupp.neg_apply, nsmul_eq_mul, hD_inf_eq]
        ring
      have hw_h_val : (w_h : K) = u_inv ^ d * ι_d c₀ := rfl
      have hw_mem : (w_h : K) ∈ V_pt x := by
        rw [hw_h_val]
        exact hι_mem_inf c₀ x htx
      rw [← hw_h_div]
      by_cases hx_supp : x ∈ G.support
      · have hψ0 : ψ_x x c₀ = 0 := congrArg (fun f : W_cod => f ⟨x, hx_supp⟩) hΨ_c₀
        have hlift_eq : liftV x c₀ = ⟨(w_h : K), hw_mem⟩ := by
          apply Subtype.ext
          simp [liftV, dif_neg htx, hw_h_val]
        have hquot0 : Ideal.Quotient.mk ((IsLocalRing.maximalIdeal ↥(V_pt x)) ^ (G x).toNat)
            (⟨(w_h : K), hw_mem⟩ : ↥(V_pt x)) = 0 := by
          rw [← hlift_eq]
          exact hψ0
        have hmem_pow : (⟨(w_h : K), hw_mem⟩ : ↥(V_pt x)) ∈
            (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ (G x).toNat :=
          Ideal.Quotient.eq_zero_iff_mem.mp hquot0
        have hle := (hdiv_pow w_h x (G x).toNat hw_mem).mp hmem_pow
        omega
      · have hGx0 : G x = 0 := Finsupp.notMem_support_iff.mp hx_supp
        rw [hGx0]
        exact (hdiv_nonneg w_h x).mp hw_mem

  
  
  
  let g : Units K := h * u⁻¹
  let E : Pt →₀ ℤ := D₁ + divK g

  have hE_nonneg : ∀ x : Pt, 0 ≤ E x := by
    intro x
    have hGx := hh_bound x
    have hG_def : G x = (d : ℤ) * D_infty x - (D₁ x - divK u x) := by
      simp [G, Finsupp.sub_apply, Finsupp.smul_apply, nsmul_eq_mul]
    have hg_div : divK g x = divK h x - divK u x := by
      dsimp [g]
      rw [hdiv_mul, hdiv_inv, Finsupp.add_apply, Finsupp.neg_apply, sub_eq_add_neg]
    have hEx : E x = D₁ x + divK g x := Finsupp.add_apply D₁ (divK g) x
    omega

  have hE_deg : degDiv E = (M : ℤ) := by
    change degDiv (D₁ + divK g) = (M : ℤ)
    rw [map_add, hD₁_deg, show degDiv (divK g) = 0 from hdiv_sum g, add_zero]

  obtain ⟨Q, hQ⟩ := h_s4 M E hE_nonneg hE_deg
  refine ⟨g, Q, ?_⟩
  have hE_eq : D + divK g = E - Finsupp.single P₀ (M : ℤ) := by
    dsimp [E, D₁]
    abel
  rw [hE_eq, hQ]

theorem weil_smooth_proj_curve_principal_deg_zero_and_riemann_surj (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    (hProjC : IsProjectiveOverField k C)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom] :
    ∃ (deg_Cl : weilCurveClGroup C.left →+ ℤ)
      (P₀ : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) })
      (M : ℕ),
      (∀ D : ({ x : ↥C.left // IsClosed ({x} : Set ↥C.left) } →₀ ℤ),
        deg_Cl (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C.left) D) =
          D.sum (fun _ n => n)) ∧
      deg_Cl (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C.left) (Finsupp.single P₀ 1)) = 1 ∧
      ∀ c : weilCurveClGroup C.left, deg_Cl c = 0 →
        ∃ Q : Fin M → { x : ↥C.left // IsClosed ({x} : Set ↥C.left) },
          QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C.left)
            ((Finset.univ.sum fun j : Fin M => Finsupp.single (Q j) (1 : ℤ)) -
              Finsupp.single P₀ (M : ℤ)) = c :=
by
  classical
  
  have hPropC : AlgebraicGeometry.IsProper C.hom := by
    obtain ⟨N, ι, hCl⟩ := hProjC
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hCl
    rw [← CategoryTheory.Over.w ι]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have h1_mem : (1 : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜 0 := by
      change (1 : MvPolynomial (Fin (N + 1)) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one]
      exact ⟨1, map_one _⟩
    have : Nontrivial ↥(𝒜 0) :=
      ⟨⟨⟨0, Submodule.zero_mem _⟩, ⟨1, h1_mem⟩, fun h => zero_ne_one (congrArg Subtype.val h)⟩⟩
    have hBij0 : Function.Bijective (algebraMap k ↥(𝒜 0)) := by
      refine ⟨(algebraMap k ↥(𝒜 0)).injective, fun z => ?_⟩
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    let e0 : k ≃+* ↥(𝒜 0) := RingEquiv.ofBijective (algebraMap k ↥(𝒜 0)) hBij0
    have : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) :=
      ⟨⟨CommRingCat.ofHom e0.symm.toRingHom,
        CommRingCat.Hom.ext (RingHom.ext e0.symm_apply_apply),
        CommRingCat.Hom.ext (RingHom.ext e0.apply_symm_apply)⟩⟩
    have : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      inferInstance
    have : AlgebraicGeometry.IsProper
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      inferInstance
    have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    infer_instance

  have : AlgebraicGeometry.IsProper C.hom := hPropC
  have hDim : topologicalKrullDim C.left = (1 : WithBot ℕ∞) :=
    weil_smooth_integral_krullDim_over_field k 1 C inferInstance

  
  let Pt : Type u := { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }
  obtain ⟨φ_k, P₀, t₀, n₀, b₀, V_pt, ht₀_inj, hb₀_span, hV_inj, hV_dvr, hV_surj⟩ :=
    weil_smooth_proj_curve_closedPt_valuation_bijection k C hDim

  let _ : Algebra k ↑C.left.functionField := φ_k.toAlgebra

  have ht₀_tr : Transcendental k t₀ := by
    intro hAlg
    obtain ⟨p, hp_ne, hp_ev⟩ := hAlg
    exact hp_ne (ht₀_inj p hp_ev)

  
  
  let E₀ : IntermediateField k ↑C.left.functionField :=
    IntermediateField.adjoin k ({t₀} : Set ↑C.left.functionField)
  have haeval_mem_adjoin : ∀ (y : ↑C.left.functionField) (p : Polynomial k),
      Polynomial.aeval y p ∈ IntermediateField.adjoin k ({y} : Set ↑C.left.functionField) := by
    intro y p
    exact Polynomial.induction_on' p
      (fun p₁ p₂ h₁ h₂ => by
        rw [map_add]
        exact (IntermediateField.adjoin k ({y} : Set ↑C.left.functionField)).add_mem h₁ h₂)
      (fun n a => by
        rw [Polynomial.aeval_monomial]
        exact (IntermediateField.adjoin k ({y} : Set ↑C.left.functionField)).mul_mem
          ((IntermediateField.adjoin k ({y} : Set ↑C.left.functionField)).algebraMap_mem a)
          (Subsemiring.pow_mem
            (IntermediateField.adjoin k ({y} : Set ↑C.left.functionField)).toSubsemiring
            (IntermediateField.mem_adjoin_simple_self k y) n))

  have hFinE₀ : FiniteDimensional ↥E₀ ↑C.left.functionField := by
    let Φ₀ : (Fin n₀ → ↥E₀) →ₗ[↥E₀] ↑C.left.functionField :=
      { toFun := fun c => ∑ i : Fin n₀, (c i : ↑C.left.functionField) * b₀ i
        map_add' := fun c₁ c₂ => by
          change (∑ i : Fin n₀,
              ((c₁ i : ↑C.left.functionField) + (c₂ i : ↑C.left.functionField)) * b₀ i) =
            (∑ i : Fin n₀, (c₁ i : ↑C.left.functionField) * b₀ i) +
              ∑ i : Fin n₀, (c₂ i : ↑C.left.functionField) * b₀ i
          simp only [add_mul, Finset.sum_add_distrib]
        map_smul' := fun r c => by
          change (∑ i : Fin n₀,
              ((r : ↑C.left.functionField) * (c i : ↑C.left.functionField)) * b₀ i) =
            (r : ↑C.left.functionField) *
              ∑ i : Fin n₀, (c i : ↑C.left.functionField) * b₀ i
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl (fun i _ => mul_assoc _ _ _) }
    have hΦ₀_surj : Function.Surjective Φ₀ := by
      intro z
      obtain ⟨p, q, hq_ne, hzq⟩ := hb₀_span z
      have hq_ev_ne : Polynomial.aeval t₀ q ≠ 0 := fun h0 => hq_ne (ht₀_inj q h0)
      have hq_mem : Polynomial.aeval t₀ q ∈ E₀ := haeval_mem_adjoin t₀ q
      refine ⟨fun i => ⟨Polynomial.aeval t₀ (p i), haeval_mem_adjoin t₀ (p i)⟩ *
          (⟨Polynomial.aeval t₀ q, hq_mem⟩ : ↥E₀)⁻¹, ?_⟩
      change (∑ i : Fin n₀,
        (Polynomial.aeval t₀ (p i) * (Polynomial.aeval t₀ q)⁻¹) * b₀ i) = z
      apply mul_right_cancel₀ hq_ev_ne
      calc (∑ i : Fin n₀, (Polynomial.aeval t₀ (p i) * (Polynomial.aeval t₀ q)⁻¹) * b₀ i) *
            Polynomial.aeval t₀ q
          = ∑ i : Fin n₀, Polynomial.aeval t₀ (p i) * b₀ i *
              ((Polynomial.aeval t₀ q)⁻¹ * Polynomial.aeval t₀ q) := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl (fun i _ => by ring)
        _ = ∑ i : Fin n₀, Polynomial.aeval t₀ (p i) * b₀ i := by
            simp [inv_mul_cancel₀ hq_ev_ne]
        _ = z * Polynomial.aeval t₀ q := hzq.symm
    exact Module.Finite.of_surjective Φ₀ hΦ₀_surj

  have hRatE₀ : ∀ y ∈ E₀, ∃ p q : Polynomial k,
      q ≠ 0 ∧ y = Polynomial.aeval t₀ p * (Polynomial.aeval t₀ q)⁻¹ := by
    let L_rat : IntermediateField k ↑C.left.functionField :=
      { carrier := { y : ↑C.left.functionField | ∃ p q : Polynomial k,
          q ≠ 0 ∧ y = Polynomial.aeval t₀ p * (Polynomial.aeval t₀ q)⁻¹ }
        add_mem' := by
          rintro _ _ ⟨p₁, q₁, hq₁, rfl⟩ ⟨p₂, q₂, hq₂, rfl⟩
          have h₁ : Polynomial.aeval t₀ q₁ ≠ 0 := fun h => hq₁ (ht₀_inj q₁ h)
          have h₂ : Polynomial.aeval t₀ q₂ ≠ 0 := fun h => hq₂ (ht₀_inj q₂ h)
          refine ⟨p₁ * q₂ + p₂ * q₁, q₁ * q₂, mul_ne_zero hq₁ hq₂, ?_⟩
          simp only [map_add, map_mul]
          apply mul_right_cancel₀ (mul_ne_zero h₁ h₂)
          rw [mul_assoc (_ + _), inv_mul_cancel₀ (mul_ne_zero h₁ h₂), mul_one, add_mul]
          have ht1 : Polynomial.aeval t₀ p₁ * (Polynomial.aeval t₀ q₁)⁻¹ *
              (Polynomial.aeval t₀ q₁ * Polynomial.aeval t₀ q₂) =
              Polynomial.aeval t₀ p₁ * Polynomial.aeval t₀ q₂ *
                ((Polynomial.aeval t₀ q₁)⁻¹ * Polynomial.aeval t₀ q₁) := by ring
          have ht2 : Polynomial.aeval t₀ p₂ * (Polynomial.aeval t₀ q₂)⁻¹ *
              (Polynomial.aeval t₀ q₁ * Polynomial.aeval t₀ q₂) =
              Polynomial.aeval t₀ p₂ * Polynomial.aeval t₀ q₁ *
                ((Polynomial.aeval t₀ q₂)⁻¹ * Polynomial.aeval t₀ q₂) := by ring
          rw [ht1, ht2, inv_mul_cancel₀ h₁, inv_mul_cancel₀ h₂, mul_one, mul_one]
        zero_mem' := ⟨0, 1, one_ne_zero, by simp⟩
        mul_mem' := by
          rintro _ _ ⟨p₁, q₁, hq₁, rfl⟩ ⟨p₂, q₂, hq₂, rfl⟩
          refine ⟨p₁ * p₂, q₁ * q₂, mul_ne_zero hq₁ hq₂, ?_⟩
          simp only [map_mul, mul_inv]
          ring
        one_mem' := ⟨1, 1, one_ne_zero, by simp⟩
        inv_mem' := by
          rintro _ ⟨p, q, hq, rfl⟩
          by_cases hp : p = 0
          · subst hp
            exact ⟨0, 1, one_ne_zero, by simp⟩
          · refine ⟨q, p, hp, ?_⟩
            rw [mul_inv_rev, inv_inv, mul_comm]
        algebraMap_mem' := fun c => ⟨Polynomial.C c, 1, one_ne_zero, by simp⟩ }
    have h_le : E₀ ≤ L_rat := by
      rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
      exact ⟨Polynomial.X, 1, one_ne_zero, by simp⟩
    intro y hy
    exact h_le hy

  
  have hPolyFrobSpan : ∀ (p e : ℕ) [ExpChar k p],
      ∃ (m : ℕ) (u : Fin m → Polynomial k),
        ∀ g : Polynomial k, ∃ q : Fin m → Polynomial k,
          g = ∑ j : Fin m, (q j) ^ (p ^ e) * u j := by
    intro p e _
    let Q : ℕ := p ^ e
    have hQ : 0 < Q := pow_pos (expChar_pos k p) e
    have : PerfectField k := IsAlgClosed.perfectField k
    have : PerfectRing k p := PerfectField.toPerfectRing p
    let φ_frob : k ≃+* k := iterateFrobeniusEquiv k p e
    refine ⟨Q, fun r => Polynomial.X ^ (r : ℕ), ?_⟩
    intro g
    refine Polynomial.induction_on' g ?_ ?_
    · rintro g₁ g₂ ⟨q₁, rfl⟩ ⟨q₂, rfl⟩
      have : ExpChar (Polynomial k) p :=
        expChar_of_injective_algebraMap Polynomial.C_injective p
      refine ⟨fun j => q₁ j + q₂ j, ?_⟩
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [add_pow_expChar_pow, add_mul]
    · intro n a
      let r_idx : Fin Q := ⟨n % Q, Nat.mod_lt n hQ⟩
      let q_single : Polynomial k := Polynomial.monomial (n / Q) (φ_frob.symm a)
      refine ⟨fun j => if j = r_idx then q_single else 0, ?_⟩
      rw [Finset.sum_eq_single r_idx]
      · simp only [↓reduceIte, q_single, r_idx]
        have ha : (φ_frob.symm a) ^ Q = a := by
          change φ_frob (φ_frob.symm a) = a
          exact φ_frob.apply_symm_apply a
        rw [Polynomial.monomial_pow, Polynomial.X_pow_eq_monomial,
          Polynomial.monomial_mul_monomial, mul_one, mul_comm (n / Q) Q,
          Nat.div_add_mod n Q, ha]
      · intro j _ hj
        dsimp only
        split_ifs with h_eq
        · exact False.elim (hj h_eq)
        · rw [zero_pow hQ.ne', zero_mul]
      · intro h_abs
        exact False.elim (h_abs (Finset.mem_univ r_idx))

  have hFrobFinite : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
      [IsNoetherianRing R] (F : Type u) [Field F] [Algebra R F] [IsFractionRing R F]
      (L : Type u) [Field L] [Algebra R L] [Algebra F L] [IsScalarTower R F L]
      [FiniteDimensional F L] (p : ℕ) [ExpChar R p],
      (∀ e : ℕ, ∃ (m : ℕ) (u : Fin m → R),
        ∀ r : R, ∃ q : Fin m → R, r = ∑ j : Fin m, (q j) ^ (p ^ e) * u j) →
      Module.Finite R ↥(integralClosure R L) := by
    intro R _ _ _ _ F _ _ _ L _ _ _ _ _ p _ hSpan
    let M_sep : IntermediateField F L := separableClosure F L
    have hFinM : Module.Finite R ↥(integralClosure R ↥M_sep) :=
      IsIntegralClosure.finite R F ↥M_sep ↥(integralClosure R ↥M_sep)
    obtain ⟨n_s, f_surj, hf_surj⟩ :=
      @Module.Finite.exists_fin' R ↥(integralClosure R ↥M_sep) _ _ _ hFinM
    have hRM_inj : Function.Injective (algebraMap R ↥M_sep) := by
      rw [IsScalarTower.algebraMap_eq R F ↥M_sep]
      exact (RingHom.injective (algebraMap F ↥M_sep)).comp (IsFractionRing.injective R F)
    have hRL_inj : Function.Injective (algebraMap R L) := by
      rw [IsScalarTower.algebraMap_eq R F L]
      exact (RingHom.injective (algebraMap F L)).comp (IsFractionRing.injective R F)
    have : ExpChar ↥M_sep p := expChar_of_injective_algebraMap hRM_inj p
    have : ExpChar L p := expChar_of_injective_algebraMap hRL_inj p
    have hTowerRML : IsScalarTower R ↥M_sep L := by
      refine IsScalarTower.of_algebraMap_eq (fun r => ?_)
      rw [IsScalarTower.algebraMap_apply R F L r,
        IsScalarTower.algebraMap_apply F ↥M_sep L (algebraMap R F r),
        ← IsScalarTower.algebraMap_apply R F ↥M_sep r]
    let e : ℕ := IsPurelyInseparable.exponent ↥M_sep L
    let Φ_R : R →+* R := iterateFrobenius R p e
    let Φ_LM : L →+* ↥M_sep := IsPurelyInseparable.iterateFrobenius ↥M_sep L p (le_refl e)
    have h_comm : (algebraMap R ↥M_sep).comp Φ_R = Φ_LM.comp (algebraMap R L) := by
      ext r
      simp only [RingHom.comp_apply]
      rw [@IsScalarTower.algebraMap_apply R ↥M_sep L _ _ _ _ _ _ hTowerRML r,
        IsPurelyInseparable.iterateFrobenius_algebraMap L p (le_refl e) (algebraMap R ↥M_sep r),
        ← map_pow, iterateFrobenius_def]
    obtain ⟨m_s, u, hu⟩ := hSpan e
    have h_f_smul : ∀ (s : R) (c : Fin n_s → R), f_surj (s • c) = s • f_surj c :=
      f_surj.map_smul
    let instTw : Module R ↥(integralClosure R ↥M_sep) :=
      Module.compHom ↥(integralClosure R ↥M_sep) Φ_R
    let F_span :=
      @LinearMap.mk R R _ _ (RingHom.id R) (Fin m_s × Fin n_s → R) ↥(integralClosure R ↥M_sep)
        _ _ _ instTw
        { toFun := fun α => f_surj (fun l => ∑ j : Fin m_s, Φ_R (α (j, l)) * u j)
          map_add' := fun α₁ α₂ => by
            have h_eq : (fun l => ∑ j : Fin m_s, Φ_R ((α₁ + α₂) (j, l)) * u j) =
                (fun l => ∑ j : Fin m_s, Φ_R (α₁ (j, l)) * u j) +
                (fun l => ∑ j : Fin m_s, Φ_R (α₂ (j, l)) * u j) := by
              ext l
              simp only [Pi.add_apply, map_add, right_distrib, Finset.sum_add_distrib]
            rw [h_eq, map_add] }
        (fun r α => by
          have h_eq : (fun l => ∑ j : Fin m_s, Φ_R ((r • α) (j, l)) * u j) =
              Φ_R r • (fun l => ∑ j : Fin m_s, Φ_R (α (j, l)) * u j) := by
            ext l
            simp only [Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc, Finset.mul_sum]
          exact (congrArg f_surj h_eq).trans
            (h_f_smul (Φ_R r) (fun l => ∑ j : Fin m_s, Φ_R (α (j, l)) * u j)))
    have hF_surj : Function.Surjective F_span := by
      intro w
      obtain ⟨c, rfl⟩ := hf_surj w
      choose q hq using fun l => hu (c l)
      refine ⟨fun idx => q idx.2 idx.1, ?_⟩
      change f_surj (fun l => ∑ j : Fin m_s, Φ_R (q l j) * u j) = f_surj c
      congr 1
      ext l
      simpa only [Φ_R, iterateFrobenius_def] using (hq l).symm
    have hFinTw : @Module.Finite R ↥(integralClosure R ↥M_sep) _ _ instTw :=
      @Module.Finite.of_surjective R (Fin m_s × Fin n_s → R) _ _ _ R
        ↥(integralClosure R ↥M_sep) _ _ instTw (RingHom.id R) inferInstance F_span hF_surj
    have hNoethTw : @IsNoetherian R ↥(integralClosure R ↥M_sep) _ _ instTw :=
      @isNoetherian_of_isNoetherianRing_of_finite R ↥(integralClosure R ↥M_sep) _ _ instTw _ hFinTw
    let ψ :=
      @LinearMap.mk R R _ _ (RingHom.id R) ↥(integralClosure R L) ↥(integralClosure R ↥M_sep)
        _ _ _ instTw
        { toFun := fun z => ⟨Φ_LM z.1, _root_.IsIntegral.map_of_comp_eq Φ_R Φ_LM h_comm z.2⟩
          map_add' := fun z₁ z₂ => Subtype.ext (map_add Φ_LM z₁.1 z₂.1) }
        (fun r z => Subtype.ext (by
          change Φ_LM ((r • z : ↥(integralClosure R L)).1) =
            (Φ_R r • (⟨Φ_LM z.1, _⟩ : ↥(integralClosure R ↥M_sep))).1
          have h1 : (r • z : ↥(integralClosure R L)).1 = algebraMap R L r * z.1 :=
            Algebra.smul_def r z.1
          have h2 : ∀ w : ↥(integralClosure R ↥M_sep),
              (Φ_R r • w).1 = algebraMap R ↥M_sep (Φ_R r) * w.1 :=
            fun w => Algebra.smul_def (Φ_R r) w.1
          rw [h1, map_mul, h2]
          have hc := RingHom.congr_fun h_comm r
          simp only [RingHom.comp_apply] at hc
          rw [hc]))
    have hInj_ψ : Function.Injective ψ := by
      intro z₁ z₂ hz
      exact Subtype.ext (Φ_LM.injective (congrArg Subtype.val hz))
    exact @Module.Finite.of_injective R R ↥(integralClosure R L) ↥(integralClosure R ↥M_sep)
      _ _ _ _ _ instTw hNoethTw (RingHom.id R) (RingHom.id R)
      RingHomInvPair.ids RingHomInvPair.ids ψ hInj_ψ

  have hTrdeg1 : ∀ f : ↑C.left.functionField,
      f ∉ Set.range (algebraMap k ↑C.left.functionField) →
      Transcendental k f ∧
      FiniteDimensional ↥(IntermediateField.adjoin k ({f} : Set ↑C.left.functionField))
        ↑C.left.functionField ∧
      Module.Finite ↥(Algebra.adjoin k ({f} : Set ↑C.left.functionField))
        ↥(integralClosure ↥(Algebra.adjoin k ({f} : Set ↑C.left.functionField))
          ↑C.left.functionField) ∧
      IntermediateField.adjoin k ({f} : Set ↑C.left.functionField) =
        IntermediateField.adjoin k ({f⁻¹} : Set ↑C.left.functionField) := by
    intro f hf_not_k
    have hf_tr : Transcendental k f := by
      intro hAlg
      have hf_int : _root_.IsIntegral k f := IsAlgebraic.isIntegral hAlg
      let P_min := minpoly k f
      have hIrr : Irreducible P_min := minpoly.irreducible hf_int
      have hMon : P_min.Monic := minpoly.monic hf_int
      have hDeg : P_min.degree = 1 := IsAlgClosed.degree_eq_one_of_irreducible k hIrr
      have hForm := Polynomial.eq_X_add_C_of_degree_le_one hDeg.le
      have hNatDeg : P_min.natDegree = 1 := Polynomial.natDegree_eq_of_degree_eq_some hDeg
      have hCoeff1 : P_min.coeff 1 = 1 := by
        rw [← hNatDeg]
        exact hMon.leadingCoeff
      have hEv : Polynomial.aeval f P_min = 0 := minpoly.aeval k f
      rw [hForm, hCoeff1] at hEv
      simp only [map_one, one_mul, map_add, Polynomial.aeval_X, Polynomial.aeval_C] at hEv
      exact hf_not_k ⟨-P_min.coeff 0, by rw [map_neg, neg_eq_iff_add_eq_zero, add_comm]; exact hEv⟩

    have hf_inv_eq :
        IntermediateField.adjoin k ({f} : Set ↑C.left.functionField) =
          IntermediateField.adjoin k ({f⁻¹} : Set ↑C.left.functionField) := by
      apply le_antisymm <;> rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
      · have h_mem : (f⁻¹)⁻¹ ∈
            IntermediateField.adjoin k ({f⁻¹} : Set ↑C.left.functionField) :=
          (IntermediateField.adjoin k ({f⁻¹} : Set ↑C.left.functionField)).inv_mem
            (IntermediateField.mem_adjoin_simple_self k f⁻¹)
        rwa [inv_inv] at h_mem
      · exact (IntermediateField.adjoin k ({f} : Set ↑C.left.functionField)).inv_mem
          (IntermediateField.mem_adjoin_simple_self k f)

    let E_f : IntermediateField k ↑C.left.functionField :=
      IntermediateField.adjoin k ({f} : Set ↑C.left.functionField)
    have hFinDim_f : FiniteDimensional ↥E_f ↑C.left.functionField := by
      let N := Module.finrank ↥E₀ ↑C.left.functionField
      let v : Fin (N + 1) → ↑C.left.functionField := fun j => f ^ (j : ℕ)
      have hv_dep : ¬LinearIndependent ↥E₀ v := by
        intro h_ind
        have h_le := h_ind.fintype_card_le_finrank
        simp only [Fintype.card_fin] at h_le
        omega
      obtain ⟨s_dep, g_dep, hg_sum, j₀, hj₀_s, hgj₀_ne⟩ := not_linearIndependent_iff.mp hv_dep
      let c : Fin (N + 1) → ↥E₀ := fun j => if j ∈ s_dep then g_dep j else 0
      have hc_sum : ∑ j : Fin (N + 1), (c j : ↑C.left.functionField) * f ^ (j : ℕ) = 0 := by
        have h_sub : s_dep ⊆ Finset.univ := Finset.subset_univ s_dep
        have h_eq : ∑ j : Fin (N + 1), (c j : ↑C.left.functionField) * f ^ (j : ℕ) =
            ∑ j ∈ s_dep, (g_dep j : ↑C.left.functionField) * f ^ (j : ℕ) := by
          rw [← Finset.sum_subset h_sub]
          · refine Finset.sum_congr rfl (fun j hj => by simp [c, hj])
          · intro j _ hj
            simp [c, hj]
        rw [h_eq]
        exact hg_sum
      have hcj₀_ne : (c j₀ : ↑C.left.functionField) ≠ 0 := by
        simp only [c, hj₀_s, ↓reduceIte]
        exact fun h => hgj₀_ne (Subtype.ext h)
      choose p_c q_c hq_c_ne hc_rat using fun j : Fin (N + 1) => hRatE₀ (c j).1 (c j).2
      let Q_all : Polynomial k := ∏ i : Fin (N + 1), q_c i
      have hQ_all_ne : Q_all ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i _ => hq_c_ne i
      have hQ_all_ev : Polynomial.aeval t₀ Q_all ≠ 0 := fun h0 => hQ_all_ne (ht₀_inj Q_all h0)
      let P_j : Fin (N + 1) → Polynomial k :=
        fun j => p_c j * ∏ i ∈ Finset.univ.erase j, q_c i
      have hPj_ev : ∀ j : Fin (N + 1),
          Polynomial.aeval t₀ (P_j j) =
            (c j : ↑C.left.functionField) * Polynomial.aeval t₀ Q_all := by
        intro j
        have h_prod : q_c j * (∏ i ∈ Finset.univ.erase j, q_c i) = Q_all :=
          Finset.mul_prod_erase Finset.univ q_c (Finset.mem_univ j)
        have hqj_ev : Polynomial.aeval t₀ (q_c j) ≠ 0 := fun h0 => hq_c_ne j (ht₀_inj (q_c j) h0)
        calc Polynomial.aeval t₀ (P_j j)
            = Polynomial.aeval t₀ (p_c j) *
                ((Polynomial.aeval t₀ (q_c j))⁻¹ *
                  (Polynomial.aeval t₀ (q_c j) *
                    Polynomial.aeval t₀ (∏ i ∈ Finset.univ.erase j, q_c i))) := by
              rw [inv_mul_cancel_left₀ hqj_ev, ← map_mul]
          _ = (c j : ↑C.left.functionField) * Polynomial.aeval t₀ Q_all := by
              rw [← map_mul, h_prod, ← mul_assoc, ← hc_rat j]
      have hPj₀_ne : P_j j₀ ≠ 0 := by
        intro h0
        have hev0 : Polynomial.aeval t₀ (P_j j₀) = 0 := by rw [h0, map_zero]
        rw [hPj_ev j₀] at hev0
        exact mul_ne_zero hcj₀_ne hQ_all_ev hev0
      have hPj_sum : ∑ j : Fin (N + 1), Polynomial.aeval t₀ (P_j j) * f ^ (j : ℕ) = 0 := by
        calc ∑ j : Fin (N + 1), Polynomial.aeval t₀ (P_j j) * f ^ (j : ℕ)
            = (∑ j : Fin (N + 1), (c j : ↑C.left.functionField) * f ^ (j : ℕ)) *
                Polynomial.aeval t₀ Q_all := by
              rw [Finset.sum_mul]
              refine Finset.sum_congr rfl (fun j _ => by rw [hPj_ev j]; ring)
          _ = 0 := by rw [hc_sum, zero_mul]
      obtain ⟨d₀, hd₀_ne⟩ : ∃ d₀ : ℕ, (P_j j₀).coeff d₀ ≠ 0 := by
        by_contra h_all
        exact hPj₀_ne (Polynomial.ext fun d => not_not.mp (fun h => h_all ⟨d, h⟩))
      let B : ℕ := max d₀ (Finset.univ.sup fun j : Fin (N + 1) => (P_j j).natDegree)
      let R_d : ℕ → Polynomial k :=
        fun d => ∑ j : Fin (N + 1), Polynomial.monomial (j : ℕ) ((P_j j).coeff d)
      have hRd₀_ne : R_d d₀ ≠ 0 := by
        intro h0
        have hc0 : (R_d d₀).coeff (j₀ : ℕ) = 0 := by rw [h0, Polynomial.coeff_zero]
        simp only [R_d, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial] at hc0
        rw [Finset.sum_eq_single j₀] at hc0
        · simp only [↓reduceIte] at hc0
          exact hd₀_ne hc0
        · intro j _ hj
          have hval : (j : ℕ) ≠ (j₀ : ℕ) := fun hv => hj (Fin.ext hv)
          simp [hval]
        · intro h_abs
          exact False.elim (h_abs (Finset.mem_univ j₀))
      have hRd₀_ev_ne : Polynomial.aeval f (R_d d₀) ≠ 0 := by
        intro h0
        exact hf_tr ⟨R_d d₀, hRd₀_ne, h0⟩
      let Q_t : Polynomial ↥E_f :=
        ∑ d ∈ Finset.range (B + 1),
          Polynomial.monomial d ⟨Polynomial.aeval f (R_d d), haeval_mem_adjoin f (R_d d)⟩
      have hQt_ne : Q_t ≠ 0 := by
        intro h0
        have hc0 : Q_t.coeff d₀ = 0 := by rw [h0, Polynomial.coeff_zero]
        simp only [Q_t, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial] at hc0
        have hd₀_mem : d₀ ∈ Finset.range (B + 1) :=
          Finset.mem_range.mpr (Nat.lt_succ_of_le (le_max_left _ _))
        rw [Finset.sum_eq_single d₀] at hc0
        · simp only [↓reduceIte] at hc0
          exact hRd₀_ev_ne (congrArg Subtype.val hc0)
        · intro d _ hd
          simp [hd]
        · intro h_abs
          exact False.elim (h_abs hd₀_mem)
      have hQt_ev : Polynomial.aeval t₀ Q_t = 0 := by
        simp only [Q_t, map_sum, Polynomial.aeval_monomial]
        have h_swap :
            (∑ x ∈ Finset.range (B + 1),
              algebraMap (↥E_f) ↑C.left.functionField
                ⟨Polynomial.aeval f (R_d x), haeval_mem_adjoin f (R_d x)⟩ * t₀ ^ x) =
            ∑ j : Fin (N + 1),
              (∑ x ∈ Finset.range (B + 1),
                algebraMap k ↑C.left.functionField ((P_j j).coeff x) * t₀ ^ x) * f ^ (j : ℕ) := by
          calc (∑ x ∈ Finset.range (B + 1), Polynomial.aeval f (R_d x) * t₀ ^ x)
              = ∑ x ∈ Finset.range (B + 1),
                  ∑ j : Fin (N + 1),
                    (algebraMap k ↑C.left.functionField ((P_j j).coeff x) * t₀ ^ x) *
                      f ^ (j : ℕ) := by
                refine Finset.sum_congr rfl (fun x _ => ?_)
                simp only [R_d, map_sum, Polynomial.aeval_monomial]
                rw [Finset.sum_mul]
                exact Finset.sum_congr rfl (fun j _ => by ring)
            _ = ∑ j : Fin (N + 1),
                  (∑ x ∈ Finset.range (B + 1),
                    algebraMap k ↑C.left.functionField ((P_j j).coeff x) * t₀ ^ x) *
                      f ^ (j : ℕ) := by
                rw [Finset.sum_comm]
                refine Finset.sum_congr rfl (fun j _ => (Finset.sum_mul _ _ _).symm)
        rw [h_swap]
        have h_poly_eq : ∀ j : Fin (N + 1),
            (∑ x ∈ Finset.range (B + 1),
              algebraMap k ↑C.left.functionField ((P_j j).coeff x) * t₀ ^ x) =
              Polynomial.aeval t₀ (P_j j) := by
          intro j
          have hdeg_le : (P_j j).natDegree ≤ B :=
            le_trans (Finset.le_sup (f := fun i => (P_j i).natDegree) (Finset.mem_univ j))
              (le_max_right _ _)
          rw [Polynomial.aeval_eq_sum_range' (Nat.lt_succ_of_le hdeg_le)]
          refine Finset.sum_congr rfl (fun x _ => by rw [Algebra.smul_def])
        simp_rw [h_poly_eq]
        exact hPj_sum
      have ht₀_alg : IsAlgebraic ↥E_f t₀ := ⟨Q_t, hQt_ne, hQt_ev⟩
      let E_ft : IntermediateField ↥E_f ↑C.left.functionField :=
        IntermediateField.adjoin ↥E_f ({t₀} : Set ↑C.left.functionField)
      have : FiniteDimensional ↥E_f ↥E_ft :=
        IntermediateField.adjoin.finiteDimensional (IsAlgebraic.isIntegral ht₀_alg)
      have hE₀_sub : ∀ y ∈ E₀, y ∈ E_ft := by
        have h_le : E₀ ≤ E_ft.restrictScalars k := by
          rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
          exact IntermediateField.mem_adjoin_simple_self ↥E_f t₀
        intro y hy
        exact h_le hy
      have : FiniteDimensional ↥E_ft ↑C.left.functionField := by
        obtain ⟨m₀, u₀, hu₀⟩ := @Module.Finite.exists_fin' ↥E₀ ↑C.left.functionField _ _ _ hFinE₀
        let Φ_ft : (Fin m₀ → ↥E_ft) →ₗ[↥E_ft] ↑C.left.functionField :=
          { toFun := fun α => ∑ i : Fin m₀, (α i : ↑C.left.functionField) * u₀ (Pi.single i 1)
            map_add' := fun α₁ α₂ => by
              change (∑ i : Fin m₀,
                  ((α₁ i : ↑C.left.functionField) + (α₂ i : ↑C.left.functionField)) *
                    u₀ (Pi.single i 1)) =
                (∑ i : Fin m₀, (α₁ i : ↑C.left.functionField) * u₀ (Pi.single i 1)) +
                  ∑ i : Fin m₀, (α₂ i : ↑C.left.functionField) * u₀ (Pi.single i 1)
              simp only [add_mul, Finset.sum_add_distrib]
            map_smul' := fun r α => by
              change (∑ i : Fin m₀,
                  ((r : ↑C.left.functionField) * (α i : ↑C.left.functionField)) *
                    u₀ (Pi.single i 1)) =
                (r : ↑C.left.functionField) *
                  ∑ i : Fin m₀, (α i : ↑C.left.functionField) * u₀ (Pi.single i 1)
              rw [Finset.mul_sum]
              exact Finset.sum_congr rfl (fun i _ => mul_assoc _ _ _) }
        have hΦ_ft_surj : Function.Surjective Φ_ft := by
          intro z
          obtain ⟨c₀, rfl⟩ := hu₀ z
          refine ⟨fun i => ⟨(c₀ i).1, hE₀_sub (c₀ i).1 (c₀ i).2⟩, ?_⟩
          change (∑ i : Fin m₀, (c₀ i : ↑C.left.functionField) * u₀ (Pi.single i 1)) = u₀ c₀
          have hc₀_eq : c₀ = ∑ i : Fin m₀, c₀ i • Pi.single i (1 : ↥E₀) := by
            ext j
            simp [Pi.single_apply]
          conv_rhs => rw [hc₀_eq, map_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [u₀.map_smul]
          rfl
        exact Module.Finite.of_surjective Φ_ft hΦ_ft_surj
      exact Module.Finite.trans ↥E_ft ↑C.left.functionField

    have hFinInt_f : Module.Finite ↥(Algebra.adjoin k ({f} : Set ↑C.left.functionField))
        ↥(integralClosure ↥(Algebra.adjoin k ({f} : Set ↑C.left.functionField))
          ↑C.left.functionField) := by
      let A_f := ↥(Algebra.adjoin k ({f} : Set ↑C.left.functionField))
      have hf_aeval_inj :
          Function.Injective (Polynomial.aeval f : Polynomial k →ₐ[k] ↑C.left.functionField) := by
        intro p₁ p₂ hp
        have hsub : Polynomial.aeval f (p₁ - p₂) = 0 := by rw [map_sub, hp, sub_self]
        by_contra hne
        exact hf_tr ⟨p₁ - p₂, sub_ne_zero.mpr hne, hsub⟩
      let e_range : Polynomial k ≃ₐ[k] ↥(Polynomial.aeval f).range :=
        AlgEquiv.ofInjective (Polynomial.aeval f) hf_aeval_inj
      let e_poly : Polynomial k ≃ₐ[k] A_f :=
        e_range.trans (Subalgebra.equivOfEq _ _ (Algebra.adjoin_singleton_eq_range_aeval k f).symm)
      have he_poly_coe :
          ∀ g : Polynomial k, (e_poly g : ↑C.left.functionField) = Polynomial.aeval f g :=
        fun _ => rfl
      let _ : Algebra (Polynomial k) ↑C.left.functionField :=
        (Polynomial.aeval f).toRingHom.toAlgebra
      have hPK_inj : Function.Injective (algebraMap (Polynomial k) ↑C.left.functionField) :=
        hf_aeval_inj
      have : FaithfulSMul (Polynomial k) ↑C.left.functionField :=
        (faithfulSMul_iff_algebraMap_injective (Polynomial k) ↑C.left.functionField).mpr hPK_inj
      let F_P := FractionRing (Polynomial k)
      let _ : Algebra F_P ↑C.left.functionField :=
        FractionRing.liftAlgebra (Polynomial k) ↑C.left.functionField
      have : IsScalarTower (Polynomial k) F_P ↑C.left.functionField :=
        FractionRing.isScalarTower_liftAlgebra (Polynomial k) ↑C.left.functionField
      have hEf_in_FP : ∀ y ∈ E_f, ∃ w : F_P, algebraMap F_P ↑C.left.functionField w = y := by
        let L_FP : IntermediateField k ↑C.left.functionField :=
          { carrier := Set.range (algebraMap F_P ↑C.left.functionField)
            add_mem' := by rintro _ _ ⟨w₁, rfl⟩ ⟨w₂, rfl⟩; exact ⟨w₁ + w₂, map_add _ _ _⟩
            zero_mem' := ⟨0, map_zero _⟩
            mul_mem' := by rintro _ _ ⟨w₁, rfl⟩ ⟨w₂, rfl⟩; exact ⟨w₁ * w₂, map_mul _ _ _⟩
            one_mem' := ⟨1, map_one _⟩
            inv_mem' := by rintro _ ⟨w, rfl⟩; exact ⟨w⁻¹, map_inv₀ _ _⟩
            algebraMap_mem' := fun c =>
              ⟨algebraMap (Polynomial k) F_P (Polynomial.C c), by
                rw [← IsScalarTower.algebraMap_apply (Polynomial k) F_P ↑C.left.functionField]
                exact Polynomial.aeval_C f c⟩ }
        have h_le : E_f ≤ L_FP := by
          rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
          refine ⟨algebraMap (Polynomial k) F_P Polynomial.X, ?_⟩
          rw [← IsScalarTower.algebraMap_apply (Polynomial k) F_P ↑C.left.functionField]
          exact Polynomial.aeval_X f
        intro y hy
        exact h_le hy
      have : FiniteDimensional F_P ↑C.left.functionField := by
        obtain ⟨m₁, u₁, hu₁⟩ :=
          @Module.Finite.exists_fin' ↥E_f ↑C.left.functionField _ _ _ hFinDim_f
        let Φ_FP : (Fin m₁ → F_P) →ₗ[F_P] ↑C.left.functionField :=
          { toFun := fun α =>
              ∑ i : Fin m₁, algebraMap F_P ↑C.left.functionField (α i) * u₁ (Pi.single i 1)
            map_add' := fun α₁ α₂ => by
              simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
            map_smul' := fun r α => by
              simp only [Pi.smul_apply, smul_eq_mul, map_mul, RingHom.id_apply, Algebra.smul_def,
                mul_assoc, Finset.mul_sum] }
        have hΦ_FP_surj : Function.Surjective Φ_FP := by
          intro z
          obtain ⟨c₁, rfl⟩ := hu₁ z
          choose w₁ hw₁ using fun i : Fin m₁ => hEf_in_FP (c₁ i).1 (c₁ i).2
          refine ⟨w₁, ?_⟩
          change (∑ i : Fin m₁,
            algebraMap F_P ↑C.left.functionField (w₁ i) * u₁ (Pi.single i 1)) = u₁ c₁
          simp_rw [hw₁]
          have hc₁_eq : c₁ = ∑ i : Fin m₁, c₁ i • Pi.single i (1 : ↥E_f) := by
            ext j
            simp [Pi.single_apply]
          conv_rhs => rw [hc₁_eq, map_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [u₁.map_smul]
          rfl
        exact Module.Finite.of_surjective Φ_FP hΦ_FP_surj
      obtain ⟨p_char, _⟩ := ExpChar.exists k
      have : ExpChar (Polynomial k) p_char :=
        expChar_of_injective_algebraMap Polynomial.C_injective p_char
      have hFin_P : Module.Finite (Polynomial k)
          ↥(integralClosure (Polynomial k) ↑C.left.functionField) :=
        hFrobFinite (Polynomial k) F_P ↑C.left.functionField p_char
          (fun e => hPolyFrobSpan p_char e)
      have hComp_eq :
          (algebraMap A_f ↑C.left.functionField).comp e_poly.toRingHom =
            (RingHom.id ↑C.left.functionField).comp
              (algebraMap (Polynomial k) ↑C.left.functionField) := by
        apply RingHom.ext
        intro g
        exact he_poly_coe g
      have hComp_symm :
          (algebraMap (Polynomial k) ↑C.left.functionField).comp e_poly.symm.toRingHom =
            (RingHom.id ↑C.left.functionField).comp (algebraMap A_f ↑C.left.functionField) := by
        apply RingHom.ext
        intro a
        change (e_poly (e_poly.symm a) : ↑C.left.functionField) = (a : ↑C.left.functionField)
        rw [e_poly.apply_symm_apply]
      let τ_int : ↥(integralClosure (Polynomial k) ↑C.left.functionField) →ₛₗ[e_poly.toRingHom]
          ↥(integralClosure A_f ↑C.left.functionField) :=
        { toFun := fun z =>
            ⟨z.1, _root_.IsIntegral.map_of_comp_eq e_poly.toRingHom
              (RingHom.id ↑C.left.functionField) hComp_eq z.2⟩
          map_add' := fun z₁ z₂ => Subtype.ext rfl
          map_smul' := fun g z => Subtype.ext (by
            change (g • z : ↥(integralClosure (Polynomial k) ↑C.left.functionField)).1 =
              (e_poly g • (⟨z.1, _⟩ : ↥(integralClosure A_f ↑C.left.functionField))).1
            rw [Algebra.smul_def, Algebra.smul_def]
            rfl) }
      have hτ_surj : Function.Surjective τ_int := by
        intro w
        refine ⟨⟨w.1, _root_.IsIntegral.map_of_comp_eq e_poly.symm.toRingHom
          (RingHom.id ↑C.left.functionField) hComp_symm w.2⟩, Subtype.ext rfl⟩
      have : RingHomSurjective e_poly.toRingHom := ⟨e_poly.surjective⟩
      exact @Module.Finite.of_surjective (Polynomial k)
        ↥(integralClosure (Polynomial k) ↑C.left.functionField) _ _ _ A_f
        ↥(integralClosure A_f ↑C.left.functionField) _ _ _ e_poly.toRingHom inferInstance
        τ_int hτ_surj

    exact ⟨hf_tr, hFinDim_f, hFinInt_f, hf_inv_eq⟩

  have hDvrQuot : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Algebra k R],
      (∀ z : R, ∃ c : k, z - algebraMap k R c ∈ IsLocalRing.maximalIdeal R) →
      ∀ m : ℕ,
        FiniteDimensional k (R ⧸ (IsLocalRing.maximalIdeal R) ^ m) ∧
        Module.finrank k (R ⧸ (IsLocalRing.maximalIdeal R) ^ m) ≤ m := by
    intro R _ _ _ _ hRes m
    let 𝔪 := IsLocalRing.maximalIdeal R
    let π : R := Submodule.IsPrincipal.generator 𝔪
    have hπ_span : Ideal.span ({π} : Set R) = 𝔪 :=
      Submodule.IsPrincipal.span_singleton_generator 𝔪
    have hπ_mem : π ∈ 𝔪 := by
      rw [← hπ_span]
      exact Ideal.subset_span (Set.mem_singleton π)
    have h_approx : ∀ (r : ℕ) (z : R), ∃ c : Fin r → k,
        z - ∑ j : Fin r, algebraMap k R (c j) * π ^ (j : ℕ) ∈ 𝔪 ^ r := by
      intro r
      induction r with
      | zero =>
        intro z
        refine ⟨Fin.elim0, ?_⟩
        rw [pow_zero, Ideal.one_eq_top]
        trivial
      | succ r ih =>
        intro z
        obtain ⟨c₀, hc₀⟩ := hRes z
        change z - algebraMap k R c₀ ∈ 𝔪 at hc₀
        rw [← hπ_span, Ideal.mem_span_singleton] at hc₀
        obtain ⟨z₁, hz₁⟩ := hc₀
        obtain ⟨c', hc'⟩ := ih z₁
        let c_next : Fin (r + 1) → k := Fin.cons c₀ c'
        refine ⟨c_next, ?_⟩
        rw [Fin.sum_univ_succ]
        have hc0_eq : c_next 0 = c₀ := rfl
        have hcs_eq : ∀ i : Fin r, c_next i.succ = c' i :=
          fun i => @Fin.cons_succ r (fun _ => k) c₀ c' i
        rw [hc0_eq, Fin.val_zero, pow_zero, mul_one]
        have h_diff : z - (algebraMap k R c₀ +
            ∑ i : Fin r, algebraMap k R (c_next i.succ) * π ^ (i.succ : ℕ)) =
            π * (z₁ - ∑ i : Fin r, algebraMap k R (c' i) * π ^ (i : ℕ)) := by
          have h_sum_eq :
              (∑ i : Fin r, algebraMap k R (c_next i.succ) * π ^ (i.succ : ℕ)) =
                π * ∑ i : Fin r, algebraMap k R (c' i) * π ^ (i : ℕ) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [hcs_eq i, Fin.val_succ, pow_succ]
            ring
          rw [h_sum_eq]
          linear_combination hz₁
        rw [h_diff, pow_succ']
        exact Ideal.mul_mem_mul hπ_mem hc'
    let s_m : Fin m → (R ⧸ 𝔪 ^ m) := fun j => Ideal.Quotient.mk (𝔪 ^ m) (π ^ (j : ℕ))
    let Φ_quot : (Fin m → k) →ₗ[k] (R ⧸ 𝔪 ^ m) :=
      { toFun := fun c => ∑ j : Fin m, c j • s_m j
        map_add' := fun c₁ c₂ => by
          simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
        map_smul' := fun r c => by
          simp only [Pi.smul_apply, smul_eq_mul, mul_smul, RingHom.id_apply, Finset.smul_sum] }
    have hΦ_quot_surj : Function.Surjective Φ_quot := by
      intro x
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨c, hc⟩ := h_approx m z
      refine ⟨c, ?_⟩
      have h0 : Ideal.Quotient.mk (𝔪 ^ m)
          (z - ∑ j : Fin m, algebraMap k R (c j) * π ^ (j : ℕ)) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hc
      rw [map_sub, sub_eq_zero, map_sum] at h0
      rw [h0]
      change (∑ j : Fin m, c j • s_m j) = _
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_mul, Algebra.smul_def]
      rfl
    have h_span_top : Submodule.span k (Set.range s_m) = ⊤ := by
      rw [eq_top_iff]
      rintro x -
      obtain ⟨c, rfl⟩ := hΦ_quot_surj x
      change (∑ j : Fin m, c j • s_m j) ∈ Submodule.span k (Set.range s_m)
      exact Submodule.sum_mem (Submodule.span k (Set.range s_m)) fun j _ =>
        Submodule.smul_mem (Submodule.span k (Set.range s_m)) (c j)
          (Submodule.subset_span (Set.mem_range_self j))
    have hFin_quot : FiniteDimensional k (R ⧸ 𝔪 ^ m) :=
      Module.Finite.of_surjective Φ_quot hΦ_quot_surj
    have h_card : Module.finrank k (R ⧸ 𝔪 ^ m) ≤ m := by
      calc Module.finrank k (R ⧸ 𝔪 ^ m)
          = Module.finrank k ↥(⊤ : Submodule k (R ⧸ 𝔪 ^ m)) :=
            (LinearEquiv.finrank_eq Submodule.topEquiv.symm)
        _ = Module.finrank k ↥(Submodule.span k (Set.range s_m)) := by rw [h_span_top]
        _ ≤ (Set.range s_m).toFinset.card := finrank_span_le_card (Set.range s_m)
        _ = (Finset.univ.image s_m).card := by congr 1; ext; simp
        _ ≤ (Finset.univ : Finset (Fin m)).card := Finset.card_image_le
        _ = m := Finset.card_fin m
    exact ⟨hFin_quot, h_card⟩

  
  have hDvrStrictAnti : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R],
      StrictAnti (fun n : ℕ => (IsLocalRing.maximalIdeal R) ^ n) := by
    intro R _ _ _
    let 𝔪 := IsLocalRing.maximalIdeal R
    let π : R := Submodule.IsPrincipal.generator 𝔪
    have hπ_span : Ideal.span ({π} : Set R) = 𝔪 :=
      Submodule.IsPrincipal.span_singleton_generator 𝔪
    have h𝔪_ne_bot : 𝔪 ≠ ⊥ := IsDiscreteValuationRing.not_a_field'
    have h𝔪_ne_top : 𝔪 ≠ ⊤ := (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    have hπ_ne_zero : π ≠ 0 := by
      intro h0
      apply h𝔪_ne_bot
      rw [← hπ_span, h0, Set.singleton_zero, Ideal.span_zero]
    have hπ_not_unit : ¬IsUnit π := by
      intro hu
      apply h𝔪_ne_top
      rw [← hπ_span, Ideal.span_singleton_eq_top.mpr hu]
    refine strictAnti_nat_of_succ_lt (fun n => ?_)
    have hle : 𝔪 ^ (n + 1) ≤ 𝔪 ^ n := Ideal.pow_le_pow_right (Nat.le_succ n)
    refine lt_of_le_of_ne hle (fun heq => ?_)
    change 𝔪 ^ (n + 1) = 𝔪 ^ n at heq
    rw [← hπ_span, Ideal.span_singleton_pow, Ideal.span_singleton_pow] at heq
    have hmem : π ^ n ∈ Ideal.span ({π ^ (n + 1)} : Set R) := by
      rw [heq]
      exact Ideal.subset_span (Set.mem_singleton _)
    rw [Ideal.mem_span_singleton] at hmem
    obtain ⟨r, hr⟩ := hmem
    have h1 : π ^ n * 1 = π ^ n * (π * r) := by
      calc π ^ n * 1 = π ^ n := mul_one _
        _ = π ^ (n + 1) * r := hr
        _ = π ^ n * (π * r) := by rw [pow_succ]; ring
    have h_unit : 1 = π * r := mul_left_cancel₀ (pow_ne_zero n hπ_ne_zero) h1
    exact hπ_not_unit (IsUnit.of_mul_eq_one r h_unit.symm)

  have hDvrSimple : ∀ x : Pt,
      (∀ c : k, algebraMap k ↑C.left.functionField c ∈ V_pt x) ∧
        V_pt x ≠ ⊤ ∧ IsDiscreteValuationRing ↥(V_pt x) :=
    fun x => ⟨(hV_dvr x).1, (hV_dvr x).2.1, (hV_dvr x).2.2.1⟩

  have hu_inv_mem_range_iff : ∀ u : Units ↑C.left.functionField,
      ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) ∈
        Set.range (algebraMap k ↑C.left.functionField) ↔
        (u : ↑C.left.functionField) ∈ Set.range (algebraMap k ↑C.left.functionField) := by
    have h_imp : ∀ v : Units ↑C.left.functionField,
        (v : ↑C.left.functionField) ∈ Set.range (algebraMap k ↑C.left.functionField) →
          ((v⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) ∈
            Set.range (algebraMap k ↑C.left.functionField) := by
      rintro v ⟨c, hc⟩
      refine ⟨c⁻¹, ?_⟩
      rw [map_inv₀, hc, Units.val_inv_eq_inv_val]
    exact fun u => ⟨fun h => by simpa using h_imp u⁻¹ h, h_imp u⟩

  let D_pos_of : ∀ (f : ↑C.left.functionField),
      f ∉ Set.range (algebraMap k ↑C.left.functionField) → (Pt →₀ ℕ) :=
    fun f hf =>
      (weil_algClosed_dvr_places_positive_sum_eq_finrank k ↑C.left.functionField Pt V_pt
        hV_inj hDvrSimple hV_surj f
        (hTrdeg1 f hf).1 (hTrdeg1 f hf).2.1 (hTrdeg1 f hf).2.2.1).choose

  have hD_pos_spec : ∀ (f : ↑C.left.functionField)
      (hf : f ∉ Set.range (algebraMap k ↑C.left.functionField)),
      (∀ (x : Pt) (hfx : f ∈ V_pt x),
        Ideal.span ({(⟨f, hfx⟩ : ↥(V_pt x))} : Set ↥(V_pt x)) =
          (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ (D_pos_of f hf x)) ∧
      (∀ x : Pt, f ∉ V_pt x → D_pos_of f hf x = 0) ∧
      (D_pos_of f hf).sum (fun _ n => n) =
        Module.finrank ↥(IntermediateField.adjoin k ({f} : Set ↑C.left.functionField))
          ↑C.left.functionField :=
    fun f hf =>
      (weil_algClosed_dvr_places_positive_sum_eq_finrank k ↑C.left.functionField Pt V_pt
        hV_inj hDvrSimple hV_surj f
        (hTrdeg1 f hf).1 (hTrdeg1 f hf).2.1 (hTrdeg1 f hf).2.2.1).choose_spec

  let divK : Units ↑C.left.functionField → (Pt →₀ ℤ) := fun u =>
    if hu_k : (u : ↑C.left.functionField) ∈ Set.range (algebraMap k ↑C.left.functionField) then 0
    else
      have hu_inv_k :
          ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) ∉
            Set.range (algebraMap k ↑C.left.functionField) :=
        mt (hu_inv_mem_range_iff u).mp hu_k
      (D_pos_of (u : ↑C.left.functionField) hu_k).mapRange (Nat.cast : ℕ → ℤ) Nat.cast_zero -
        (D_pos_of ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) hu_inv_k).mapRange
          (Nat.cast : ℕ → ℤ) Nat.cast_zero

  have hdivK_const : ∀ (u : Units ↑C.left.functionField),
      (u : ↑C.left.functionField) ∈ Set.range (algebraMap k ↑C.left.functionField) →
        divK u = 0 := by
    intro u hu_k
    dsimp only [divK]
    split_ifs
    rfl

  have hdivK_nonconst : ∀ (u : Units ↑C.left.functionField)
      (hu_k : (u : ↑C.left.functionField) ∉ Set.range (algebraMap k ↑C.left.functionField)),
      divK u =
        (D_pos_of (u : ↑C.left.functionField) hu_k).mapRange (Nat.cast : ℕ → ℤ) Nat.cast_zero -
          (D_pos_of ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)
            (mt (hu_inv_mem_range_iff u).mp hu_k)).mapRange (Nat.cast : ℕ → ℤ) Nat.cast_zero := by
    intro u hu_k
    dsimp only [divK]
    split_ifs
    rfl

  have hdiv_mem_pos_and_span : ∀ (u : Units ↑C.left.functionField) (x : Pt)
      (hu : (u : ↑C.left.functionField) ∈ V_pt x),
      0 ≤ divK u x ∧
      Ideal.span ({(⟨(u : ↑C.left.functionField), hu⟩ : ↥(V_pt x))} : Set ↥(V_pt x)) =
        (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ (divK u x).toNat := by
    intro u x hu
    have : IsDiscreteValuationRing ↥(V_pt x) := (hV_dvr x).2.2.1
    have hSA := hDvrStrictAnti ↥(V_pt x)
    by_cases hu_k : (u : ↑C.left.functionField) ∈ Set.range (algebraMap k ↑C.left.functionField)
    · have hdiv0 : divK u = 0 := hdivK_const u hu_k
      obtain ⟨c, hc⟩ := hu_k
      have hcinv_mem : ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) ∈ V_pt x := by
        rw [Units.val_inv_eq_inv_val, ← hc, ← map_inv₀]
        exact (hV_dvr x).1 c⁻¹
      have hunit : IsUnit (⟨(u : ↑C.left.functionField), hu⟩ : ↥(V_pt x)) :=
        IsUnit.of_mul_eq_one ⟨((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField), hcinv_mem⟩
          (Subtype.ext (u.mul_inv))
      rw [hdiv0, Finsupp.zero_apply]
      refine ⟨le_rfl, ?_⟩
      simp only [Int.toNat_zero, pow_zero, Ideal.one_eq_top]
      exact Ideal.span_singleton_eq_top.mpr hunit
    · let hu_inv_k :
          ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) ∉
            Set.range (algebraMap k ↑C.left.functionField) :=
        mt (hu_inv_mem_range_iff u).mp hu_k
      have hdiv_eq : divK u x =
          (D_pos_of (u : ↑C.left.functionField) hu_k x : ℤ) -
            (D_pos_of ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)
              hu_inv_k x : ℤ) := by
        rw [hdivK_nonconst u hu_k, Finsupp.sub_apply, Finsupp.mapRange_apply,
          Finsupp.mapRange_apply]
      have h_inv_zero :
          D_pos_of ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) hu_inv_k x = 0 := by
        by_cases hu_inv : ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) ∈ V_pt x
        · have hunit :
              IsUnit (⟨((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField), hu_inv⟩ :
                ↥(V_pt x)) :=
            IsUnit.of_mul_eq_one ⟨(u : ↑C.left.functionField), hu⟩ (Subtype.ext (u.inv_mul))
          have hspan1 :=
            (hD_pos_spec ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)
              hu_inv_k).1 x hu_inv
          rw [Ideal.span_singleton_eq_top.mpr hunit, ← Ideal.one_eq_top,
            ← pow_zero (IsLocalRing.maximalIdeal ↥(V_pt x))] at hspan1
          exact (hSA.injective hspan1).symm
        · exact (hD_pos_spec ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)
            hu_inv_k).2.1 x hu_inv
      rw [h_inv_zero, Nat.cast_zero, sub_zero] at hdiv_eq
      rw [hdiv_eq]
      refine ⟨Nat.cast_nonneg _, ?_⟩
      rw [Int.toNat_natCast]
      exact (hD_pos_spec (u : ↑C.left.functionField) hu_k).1 x hu

  have hdiv_not_mem_neg : ∀ (u : Units ↑C.left.functionField) (x : Pt),
      (u : ↑C.left.functionField) ∉ V_pt x → divK u x < 0 := by
    intro u x hu_not
    have : IsDiscreteValuationRing ↥(V_pt x) := (hV_dvr x).2.2.1
    have hu_k : (u : ↑C.left.functionField) ∉ Set.range (algebraMap k ↑C.left.functionField) := by
      rintro ⟨c, hc⟩
      exact hu_not (hc ▸ (hV_dvr x).1 c)
    let hu_inv_k :
        ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) ∉
          Set.range (algebraMap k ↑C.left.functionField) :=
      mt (hu_inv_mem_range_iff u).mp hu_k
    have hu_inv_mem : ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) ∈ V_pt x := by
      rw [Units.val_inv_eq_inv_val]
      rcases ValuationSubring.mem_or_inv_mem (V_pt x) (u : ↑C.left.functionField) with h | h
      · exact False.elim (hu_not h)
      · exact h
    have h_pos_zero : D_pos_of (u : ↑C.left.functionField) hu_k x = 0 :=
      (hD_pos_spec (u : ↑C.left.functionField) hu_k).2.1 x hu_not
    have h_inv_pos :
        0 < D_pos_of ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) hu_inv_k x := by
      by_contra h_le
      have h0 :
          D_pos_of ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) hu_inv_k x = 0 :=
        Nat.eq_zero_of_not_pos h_le
      have hspan :=
        (hD_pos_spec ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)
          hu_inv_k).1 x hu_inv_mem
      rw [h0, pow_zero, Ideal.one_eq_top, Ideal.span_singleton_eq_top] at hspan
      obtain ⟨v, hv⟩ := hspan.exists_right_inv
      have hv_eq : (v : ↑C.left.functionField) = (u : ↑C.left.functionField) := by
        apply mul_left_cancel₀ (u⁻¹).ne_zero
        calc ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) *
              (v : ↑C.left.functionField)
            = ((⟨((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField), hu_inv_mem⟩ * v :
                ↥(V_pt x)) : ↑C.left.functionField) := rfl
          _ = 1 := congrArg Subtype.val hv
          _ = ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) *
                (u : ↑C.left.functionField) := (u.inv_mul).symm
      exact hu_not (hv_eq ▸ v.2)
    have hdiv_eq : divK u x =
        (D_pos_of (u : ↑C.left.functionField) hu_k x : ℤ) -
          (D_pos_of ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)
            hu_inv_k x : ℤ) := by
      rw [hdivK_nonconst u hu_k, Finsupp.sub_apply, Finsupp.mapRange_apply,
        Finsupp.mapRange_apply]
    rw [hdiv_eq, h_pos_zero]
    omega

  have hLocalWitness : ∀ (u : Units ↑C.left.functionField) (x : Pt),
      ∃ (a b : ↥(V_pt x)) (na nb : ℕ),
        a ≠ 0 ∧ b ≠ 0 ∧
        (a : ↑C.left.functionField) = (u : ↑C.left.functionField) * (b : ↑C.left.functionField) ∧
        Ideal.span ({a} : Set ↥(V_pt x)) = (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ na ∧
        Ideal.span ({b} : Set ↥(V_pt x)) = (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ nb ∧
        divK u x = (na : ℤ) - (nb : ℤ) := by
    intro u x
    by_cases hu : (u : ↑C.left.functionField) ∈ V_pt x
    · obtain ⟨h_nonneg, h_span⟩ := hdiv_mem_pos_and_span u x hu
      refine ⟨⟨(u : ↑C.left.functionField), hu⟩, 1, (divK u x).toNat, 0,
        ?_, one_ne_zero, ?_, h_span, ?_, ?_⟩
      · exact fun h0 => u.ne_zero (congrArg Subtype.val h0)
      · simp
      · rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_one]
      · omega
    · have hu_inv : ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) ∈ V_pt x := by
        rw [Units.val_inv_eq_inv_val]
        rcases ValuationSubring.mem_or_inv_mem (V_pt x) (u : ↑C.left.functionField) with h | h
        · exact False.elim (hu h)
        · exact h
      have hu_k : (u : ↑C.left.functionField) ∉ Set.range (algebraMap k ↑C.left.functionField) := by
        rintro ⟨c, hc⟩
        exact hu (hc ▸ (hV_dvr x).1 c)
      let hu_inv_k :
          ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) ∉
            Set.range (algebraMap k ↑C.left.functionField) :=
        mt (hu_inv_mem_range_iff u).mp hu_k
      have h_pos_zero : D_pos_of (u : ↑C.left.functionField) hu_k x = 0 :=
        (hD_pos_spec (u : ↑C.left.functionField) hu_k).2.1 x hu
      refine ⟨1, ⟨((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField), hu_inv⟩, 0,
        D_pos_of ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) hu_inv_k x,
        one_ne_zero, fun h0 => (u⁻¹).ne_zero (congrArg Subtype.val h0),
        (u.mul_inv).symm,
        by rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_one],
        (hD_pos_spec ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)
          hu_inv_k).1 x hu_inv, ?_⟩
      rw [hdivK_nonconst u hu_k, Finsupp.sub_apply, Finsupp.mapRange_apply,
        Finsupp.mapRange_apply, h_pos_zero]

  have hLocalUnique : ∀ (u : Units ↑C.left.functionField) (x : Pt)
      (a b : ↥(V_pt x)) (na nb : ℕ),
      a ≠ 0 → b ≠ 0 →
      (a : ↑C.left.functionField) = (u : ↑C.left.functionField) * (b : ↑C.left.functionField) →
      Ideal.span ({a} : Set ↥(V_pt x)) = (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ na →
      Ideal.span ({b} : Set ↥(V_pt x)) = (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ nb →
      divK u x = (na : ℤ) - (nb : ℤ) := by
    intro u x a b na nb _ _ hab hspan_a hspan_b
    have : IsDiscreteValuationRing ↥(V_pt x) := (hV_dvr x).2.2.1
    obtain ⟨a₀, b₀, na₀, nb₀, _, _, hab₀, hspan_a₀, hspan_b₀, hdiv₀⟩ := hLocalWitness u x
    have hmul_eq : a * b₀ = a₀ * b := by
      apply Subtype.ext
      change (a : ↑C.left.functionField) * (b₀ : ↑C.left.functionField) =
        (a₀ : ↑C.left.functionField) * (b : ↑C.left.functionField)
      rw [hab, hab₀]
      ring
    have hpow_eq :
        (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ (na + nb₀) =
          (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ (na₀ + nb) := by
      rw [pow_add, pow_add, ← hspan_a, ← hspan_b₀, ← hspan_a₀, ← hspan_b,
        Ideal.span_singleton_mul_span_singleton, Ideal.span_singleton_mul_span_singleton, hmul_eq]
    have hnat_eq : na + nb₀ = na₀ + nb := (hDvrStrictAnti ↥(V_pt x)).injective hpow_eq
    omega

  have hdiv_mul : ∀ u v : Units ↑C.left.functionField, divK (u * v) = divK u + divK v := by
    intro u v
    ext x
    obtain ⟨au, bu, nau, nbu, hau, hbu, hab_u, hsa_u, hsb_u, hdu⟩ := hLocalWitness u x
    obtain ⟨av, bv, nav, nbv, hav, hbv, hab_v, hsa_v, hsb_v, hdv⟩ := hLocalWitness v x
    have : IsDiscreteValuationRing ↥(V_pt x) := (hV_dvr x).2.2.1
    have h_uv : divK (u * v) x = ((nau + nav : ℕ) : ℤ) - ((nbu + nbv : ℕ) : ℤ) := by
      refine hLocalUnique (u * v) x (au * av) (bu * bv) (nau + nav) (nbu + nbv)
        (mul_ne_zero hau hav) (mul_ne_zero hbu hbv) ?_ ?_ ?_
      · change (au : ↑C.left.functionField) * (av : ↑C.left.functionField) =
          ((u : ↑C.left.functionField) * (v : ↑C.left.functionField)) *
            ((bu : ↑C.left.functionField) * (bv : ↑C.left.functionField))
        rw [hab_u, hab_v]
        ring
      · rw [← Ideal.span_singleton_mul_span_singleton, hsa_u, hsa_v, ← pow_add]
      · rw [← Ideal.span_singleton_mul_span_singleton, hsb_u, hsb_v, ← pow_add]
    rw [Finsupp.add_apply, h_uv, hdu, hdv]
    omega

  have hdiv_inv : ∀ u : Units ↑C.left.functionField, divK u⁻¹ = -divK u := by
    intro u
    ext x
    obtain ⟨au, bu, nau, nbu, hau, hbu, hab_u, hsa_u, hsb_u, hdu⟩ := hLocalWitness u x
    have h_inv : divK u⁻¹ x = (nbu : ℤ) - (nau : ℤ) := by
      refine hLocalUnique u⁻¹ x bu au nbu nau hbu hau ?_ hsb_u hsa_u
      calc (bu : ↑C.left.functionField)
          = ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) *
              ((u : ↑C.left.functionField) * (bu : ↑C.left.functionField)) := by
            rw [← mul_assoc, u.inv_mul, one_mul]
        _ = ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) *
              (au : ↑C.left.functionField) := by rw [← hab_u]
    rw [Finsupp.neg_apply, h_inv, hdu]
    omega

  have hdiv_nonneg : ∀ (u : Units ↑C.left.functionField) (x : Pt),
      (u : ↑C.left.functionField) ∈ V_pt x ↔ 0 ≤ divK u x := by
    intro u x
    refine ⟨fun hu => (hdiv_mem_pos_and_span u x hu).1, fun h_nonneg => ?_⟩
    by_contra hu_not
    have h_neg := hdiv_not_mem_neg u x hu_not
    omega

  have hdiv_pow : ∀ (u : Units ↑C.left.functionField) (x : Pt) (m : ℕ)
      (hu : (u : ↑C.left.functionField) ∈ V_pt x),
      (⟨(u : ↑C.left.functionField), hu⟩ : ↥(V_pt x)) ∈
        (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ m ↔
        (m : ℤ) ≤ divK u x := by
    intro u x m hu
    have : IsDiscreteValuationRing ↥(V_pt x) := (hV_dvr x).2.2.1
    obtain ⟨h_nonneg, h_span⟩ := hdiv_mem_pos_and_span u x hu
    have hSA := hDvrStrictAnti ↥(V_pt x)
    rw [← Ideal.span_singleton_le_iff_mem, h_span, hSA.le_iff_ge]
    omega

  let degDiv : (Pt →₀ ℤ) →+ ℤ :=
    { toFun := fun D => D.sum (fun _ n => n)
      map_zero' := Finsupp.sum_zero_index
      map_add' := fun D₁ D₂ => Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl) }

  have hdiv_sum : ∀ u : Units ↑C.left.functionField, (divK u).sum (fun _ m => m) = 0 := by
    intro u
    change degDiv (divK u) = 0
    by_cases hu_k : (u : ↑C.left.functionField) ∈ Set.range (algebraMap k ↑C.left.functionField)
    · rw [hdivK_const u hu_k, map_zero]
    · let hu_inv_k :
          ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) ∉
            Set.range (algebraMap k ↑C.left.functionField) :=
        mt (hu_inv_mem_range_iff u).mp hu_k
      rw [hdivK_nonconst u hu_k, map_sub]
      change ((D_pos_of (u : ↑C.left.functionField) hu_k).mapRange
          (Nat.cast : ℕ → ℤ) Nat.cast_zero).sum (fun _ m => m) -
        ((D_pos_of ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)
          hu_inv_k).mapRange (Nat.cast : ℕ → ℤ) Nat.cast_zero).sum (fun _ m => m) = 0
      rw [Finsupp.sum_mapRange_index (fun _ => rfl), Finsupp.sum_mapRange_index (fun _ => rfl)]
      have h_sum1 :
          ((D_pos_of (u : ↑C.left.functionField) hu_k).sum fun _ b => (b : ℤ)) =
            Nat.cast ((D_pos_of (u : ↑C.left.functionField) hu_k).sum fun _ b => b) := by
        simp [Finsupp.sum]
      have h_sum2 :
          ((D_pos_of ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)
              hu_inv_k).sum fun _ b => (b : ℤ)) =
            Nat.cast ((D_pos_of ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)
              hu_inv_k).sum fun _ b => b) := by
        simp [Finsupp.sum]
      rw [h_sum1, h_sum2, (hD_pos_spec (u : ↑C.left.functionField) hu_k).2.2,
        (hD_pos_spec ((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)
          hu_inv_k).2.2]
      have h_field_eq :
          IntermediateField.adjoin k ({(u : ↑C.left.functionField)} : Set ↑C.left.functionField) =
            IntermediateField.adjoin k
              ({((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)} :
                Set ↑C.left.functionField) := by
        rw [Units.val_inv_eq_inv_val]
        exact (hTrdeg1 (u : ↑C.left.functionField) hu_k).2.2.2
      have h_fr_eq :
          Module.finrank
              ↥(IntermediateField.adjoin k
                ({(u : ↑C.left.functionField)} : Set ↑C.left.functionField))
              ↑C.left.functionField =
            Module.finrank
              ↥(IntermediateField.adjoin k
                ({((u⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)} :
                  Set ↑C.left.functionField))
              ↑C.left.functionField := by
        rw [h_field_eq]
      rw [h_fr_eq, sub_self]

  
  have hMapMaxIdeal : ∀ {R₁ R₂ : Type u} [CommRing R₁] [IsLocalRing R₁]
      [CommRing R₂] [IsLocalRing R₂] (e : R₁ ≃+* R₂),
      Ideal.map e.toRingHom (IsLocalRing.maximalIdeal R₁) = IsLocalRing.maximalIdeal R₂ := by
    intro R₁ R₂ _ _ _ _ e
    have hMax : (Ideal.map e (IsLocalRing.maximalIdeal R₁)).IsMaximal :=
      Ideal.map_isMaximal_of_equiv e
    exact (IsLocalRing.isMaximal_iff R₂).mp hMax

  have hComapMapEquiv : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] (e : R₁ ≃+* R₂)
      (I : Ideal R₁), Ideal.comap e.toRingHom (Ideal.map e.toRingHom I) = I := by
    intro R₁ R₂ _ _ e I
    ext r
    simp only [Ideal.mem_comap]
    refine ⟨fun hr => ?_, fun hr => Ideal.mem_map_of_mem e.toRingHom hr⟩
    obtain ⟨s, hs, hse⟩ := (Ideal.mem_map_iff_of_surjective e.toRingHom e.surjective).mp hr
    have hsr : s = r := e.injective hse
    rwa [← hsr]

  have hMapEquivInj : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] (e : R₁ ≃+* R₂)
      {I J : Ideal R₁}, Ideal.map e.toRingHom I = Ideal.map e.toRingHom J → I = J := by
    intro R₁ R₂ _ _ e I J hIJ
    rw [← hComapMapEquiv e I, hIJ, hComapMapEquiv e J]

  have hdiv_mem_prin : ∀ u : Units ↑C.left.functionField,
      divK u ∈ weilCurvePrincipalSubgroup C.left := by
    intro u
    apply AddSubgroup.subset_closure
    refine ⟨u, fun x => ?_⟩
    have : IsDiscreteValuationRing ↥(V_pt x) := (hV_dvr x).2.2.1
    obtain ⟨e_x, he_x⟩ := (hV_dvr x).2.2.2.2
    have : IsLocalRing ↑(C.left.presheaf.stalk x.1) :=
      IsLocalRing.of_surjective' e_x.symm.toRingHom e_x.symm.surjective
    obtain ⟨a, b, na, nb, ha, hb, hab, hsa, hsb, hdu⟩ := hLocalWitness u x
    refine ⟨e_x.symm a, e_x.symm b, na, nb,
      by simpa using ha, by simpa using hb, ?_, ?_, ?_, hdu⟩
    · have ha' : algebraMap _ ↑C.left.functionField (e_x.symm a) = (a : ↑C.left.functionField) := by
        rw [← he_x (e_x.symm a), e_x.apply_symm_apply]
      have hb' : algebraMap _ ↑C.left.functionField (e_x.symm b) = (b : ↑C.left.functionField) := by
        rw [← he_x (e_x.symm b), e_x.apply_symm_apply]
      rw [ha', hb', hab]
    · apply hMapEquivInj e_x
      rw [Ideal.map_span, Set.image_singleton, Ideal.map_pow, hMapMaxIdeal e_x]
      have he_a : e_x.toRingHom (e_x.symm a) = a := e_x.apply_symm_apply a
      rw [he_a, hsa]
    · apply hMapEquivInj e_x
      rw [Ideal.map_span, Set.image_singleton, Ideal.map_pow, hMapMaxIdeal e_x]
      have he_b : e_x.toRingHom (e_x.symm b) = b := e_x.apply_symm_apply b
      rw [he_b, hsb]

  have hPrin_le_ker : weilCurvePrincipalSubgroup C.left ≤ degDiv.ker := by
    rw [weilCurvePrincipalSubgroup, AddSubgroup.closure_le]
    rintro D ⟨f, hf⟩
    have hD_eq : D = divK f := by
      ext x
      obtain ⟨e_x, he_x⟩ := (hV_dvr x).2.2.2.2
      have : IsDiscreteValuationRing ↥(V_pt x) := (hV_dvr x).2.2.1
      have : IsLocalRing ↑(C.left.presheaf.stalk x.1) :=
        IsLocalRing.of_surjective' e_x.symm.toRingHom e_x.symm.surjective
      obtain ⟨aR, bR, na, nb, haR, hbR, habR, hsaR, hsbR, hDx⟩ := hf x
      have h_div_fx : divK f x = (na : ℤ) - (nb : ℤ) := by
        refine hLocalUnique f x (e_x aR) (e_x bR) na nb
          (by simpa using haR) (by simpa using hbR) ?_ ?_ ?_
        · rw [he_x aR, he_x bR, habR]
        · have h1 := congrArg (Ideal.map e_x.toRingHom) hsaR
          rw [Ideal.map_span, Set.image_singleton, Ideal.map_pow, hMapMaxIdeal e_x] at h1
          exact h1
        · have h1 := congrArg (Ideal.map e_x.toRingHom) hsbR
          rw [Ideal.map_span, Set.image_singleton, Ideal.map_pow, hMapMaxIdeal e_x] at h1
          exact h1
      rw [hDx, h_div_fx]
    rw [SetLike.mem_coe, AddMonoidHom.mem_ker, hD_eq]
    exact hdiv_sum f

  let deg_Cl : weilCurveClGroup C.left →+ ℤ :=
    QuotientAddGroup.lift (weilCurvePrincipalSubgroup C.left) degDiv hPrin_le_ker

  have hdeg_Cl_mk : ∀ D : (Pt →₀ ℤ),
      deg_Cl (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C.left) D) =
        D.sum (fun _ n => n) := fun _ => rfl

  have hdeg_P₀ :
      deg_Cl (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C.left)
        (Finsupp.single P₀ 1)) = 1 := by
    rw [hdeg_Cl_mk]
    exact Finsupp.sum_single_index rfl

  
  have ht₀_not_k : t₀ ∉ Set.range (algebraMap k ↑C.left.functionField) := by
    rintro ⟨c, hc⟩
    exact ht₀_tr ⟨Polynomial.X - Polynomial.C c, Polynomial.X_sub_C_ne_zero c, by
      rw [map_sub, Polynomial.aeval_X, Polynomial.aeval_C, hc, sub_self]⟩

  have ht₀_ne : t₀ ≠ 0 := by
    intro h0
    exact ht₀_not_k ⟨0, by simp [h0]⟩

  let t_unit : Units ↑C.left.functionField := Units.mk0 t₀ ht₀_ne

  have ht_pos_sum : ((divK t_unit).sum fun _ m => if 0 < m then m else 0) =
      (Module.finrank
        ↥(IntermediateField.adjoin k
          ({(t_unit : ↑C.left.functionField)} : Set ↑C.left.functionField))
        ↑C.left.functionField : ℤ) := by
    have ht_not_k :
        (t_unit : ↑C.left.functionField) ∉ Set.range (algebraMap k ↑C.left.functionField) :=
      ht₀_not_k
    let ht_inv_not_k :
        ((t_unit⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) ∉
          Set.range (algebraMap k ↑C.left.functionField) :=
      mt (hu_inv_mem_range_iff t_unit).mp ht_not_k
    have h_pos_part : (divK t_unit).mapRange (fun m => if 0 < m then m else 0) (by simp) =
        (D_pos_of (t_unit : ↑C.left.functionField) ht_not_k).mapRange
          (Nat.cast : ℕ → ℤ) Nat.cast_zero := by
      ext x
      simp only [Finsupp.mapRange_apply]
      have hdiv_x : divK t_unit x =
          (D_pos_of (t_unit : ↑C.left.functionField) ht_not_k x : ℤ) -
            (D_pos_of ((t_unit⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)
              ht_inv_not_k x : ℤ) := by
        rw [hdivK_nonconst t_unit ht_not_k, Finsupp.sub_apply, Finsupp.mapRange_apply,
          Finsupp.mapRange_apply]
      by_cases hx_mem : (t_unit : ↑C.left.functionField) ∈ V_pt x
      · have h_inv_0 :
            D_pos_of ((t_unit⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)
              ht_inv_not_k x = 0 := by
          have : IsDiscreteValuationRing ↥(V_pt x) := (hV_dvr x).2.2.1
          by_cases hx_inv : ((t_unit⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField) ∈
              V_pt x
          · have hunit :
                IsUnit (⟨((t_unit⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField),
                  hx_inv⟩ : ↥(V_pt x)) :=
              IsUnit.of_mul_eq_one ⟨(t_unit : ↑C.left.functionField), hx_mem⟩
                (Subtype.ext (t_unit.inv_mul))
            have hspan :=
              (hD_pos_spec ((t_unit⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)
                ht_inv_not_k).1 x hx_inv
            rw [Ideal.span_singleton_eq_top.mpr hunit, ← Ideal.one_eq_top,
              ← pow_zero (IsLocalRing.maximalIdeal ↥(V_pt x))] at hspan
            exact ((hDvrStrictAnti ↥(V_pt x)).injective hspan).symm
          · exact (hD_pos_spec ((t_unit⁻¹ : Units ↑C.left.functionField) : ↑C.left.functionField)
              ht_inv_not_k).2.1 x hx_inv
        rw [hdiv_x, h_inv_0, Nat.cast_zero, sub_zero]
        split_ifs with hpos
        · rfl
        · omega
      · have h_neg := hdiv_not_mem_neg t_unit x hx_mem
        have h_pos_0 : D_pos_of (t_unit : ↑C.left.functionField) ht_not_k x = 0 :=
          (hD_pos_spec (t_unit : ↑C.left.functionField) ht_not_k).2.1 x hx_mem
        split_ifs with hpos
        · omega
        · rw [h_pos_0, Nat.cast_zero]
    have h_lhs : ((divK t_unit).sum fun _ m => if 0 < m then m else 0) =
        ((divK t_unit).mapRange (fun m => if 0 < m then m else 0) (by simp)).sum
          (fun _ m => m) :=
      (@Finsupp.sum_mapRange_index Pt ℤ ℤ ℤ _ _ _
        (fun m => if 0 < m then m else 0) (by simp) (divK t_unit)
        (fun _ m => m) (fun _ => rfl)).symm
    rw [h_lhs, h_pos_part, Finsupp.sum_mapRange_index (fun _ => rfl)]
    have h_cast :
        ((D_pos_of (t_unit : ↑C.left.functionField) ht_not_k).sum fun _ b => (b : ℤ)) =
          Nat.cast ((D_pos_of (t_unit : ↑C.left.functionField) ht_not_k).sum fun _ b => b) := by
      simp [Finsupp.sum]
    rw [h_cast, (hD_pos_spec (t_unit : ↑C.left.functionField) ht_not_k).2.2]

  have hV_for_s5 : ∀ x : Pt,
      (∀ c : k, algebraMap k ↑C.left.functionField c ∈ V_pt x) ∧
      V_pt x ≠ ⊤ ∧
      IsDiscreteValuationRing ↥(V_pt x) ∧
      (∀ z : ↥(V_pt x),
        ∃ (c : k) (hc : algebraMap k ↑C.left.functionField c ∈ V_pt x),
          z - ⟨algebraMap k ↑C.left.functionField c, hc⟩ ∈
            IsLocalRing.maximalIdeal ↥(V_pt x)) :=
    fun x => ⟨(hV_dvr x).1, (hV_dvr x).2.1, (hV_dvr x).2.2.1, (hV_dvr x).2.2.2.1⟩

  obtain ⟨M, hRiemannM⟩ :=
    weil_algClosed_riemann_subspace_effective_rep k ↑C.left.functionField Pt P₀ V_pt t_unit divK
      (hTrdeg1 (t_unit : ↑C.left.functionField) ht₀_not_k).1
      (hTrdeg1 (t_unit : ↑C.left.functionField) ht₀_not_k).2.1
      (hTrdeg1 (t_unit : ↑C.left.functionField) ht₀_not_k).2.2.1
      hV_for_s5 hDvrQuot hdiv_mul hdiv_inv hdiv_sum hdiv_nonneg hdiv_pow ht_pos_sum

  refine ⟨deg_Cl, P₀, M, hdeg_Cl_mk, hdeg_P₀, ?_⟩
  intro c hc0
  obtain ⟨D, rfl⟩ := QuotientAddGroup.mk'_surjective (weilCurvePrincipalSubgroup C.left) c
  have hD_deg0 : D.sum (fun _ n => n) = 0 := hc0
  obtain ⟨g, Q, hgQ⟩ := hRiemannM D hD_deg0
  refine ⟨Q, ?_⟩
  rw [← hgQ, map_add]
  have hg_zero :
      QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C.left) (divK g) = 0 :=
    (QuotientAddGroup.eq_zero_iff (divK g)).mpr (hdiv_mem_prin g)
  rw [hg_zero, add_zero]

theorem weil_proj_curve_dual_hyperplane_cover_stalkReg_and_global_const (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    (_hProjC : IsProjectiveOverField k C)
    (_hDimC : topologicalKrullDim C.left = (1 : WithBot ℕ∞))
    (_hDimOpen : ∀ U : C.left.Opens, Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}) →
      topologicalKrullDim ↥(U : AlgebraicGeometry.Scheme.{u}) = (1 : WithBot ℕ∞)) :
    let Pt := { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }
    let K := ↑C.left.functionField
    AlgebraicGeometry.IsProper C.hom ∧
    (∃ k_to_K : k →+* K,
      (∀ (U : C.left.Opens) [Nonempty ↥(U : AlgebraicGeometry.Scheme.{u})],
        (C.left.germToFunctionField U).hom.comp
          ((CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp U.ι C.hom).appTop
              (U.topIso).hom)).hom) = k_to_K) ∧
      (∀ (U : C.left.Opens) [Nonempty ↥(U : AlgebraicGeometry.Scheme.{u})],
        AlgebraicGeometry.IsAffineOpen U →
        ∀ z : K,
          (∃ g : ↑(C.left.presheaf.obj (Opposite.op U)),
            (C.left.germToFunctionField U).hom g = z) ↔
          (∀ x : Pt, x.1 ∈ U →
            ∃ r : ↑(C.left.presheaf.stalk x.1), algebraMap _ K r = z)) ∧
      (∀ z : K,
        Set.Finite { x : Pt | ¬ ∃ r : ↑(C.left.presheaf.stalk x.1), algebraMap _ K r = z }) ∧
      (∀ z : K,
        (∀ x : Pt, ∃ r : ↑(C.left.presheaf.stalk x.1), algebraMap _ K r = z) ↔
          z ∈ Set.range k_to_K) ∧
      (∀ S_pts : Finset Pt,
        ∃ (U₀ U₁ : C.left.Opens)
          (_ : Nonempty ↥(U₀ : AlgebraicGeometry.Scheme.{u}))
          (_ : Nonempty ↥(U₁ : AlgebraicGeometry.Scheme.{u}))
          (t : ↑(C.left.presheaf.obj (Opposite.op U₀)))
          (s : ↑(C.left.presheaf.obj (Opposite.op U₁))),
          AlgebraicGeometry.IsAffineOpen U₀ ∧
          AlgebraicGeometry.IsAffineOpen U₁ ∧
          (∀ x ∈ S_pts, x.1 ∈ U₀) ∧
          U₀ ⊔ U₁ = ⊤ ∧
          (∃ z₀ : Pt, z₀.1 ∉ U₀) ∧
          (∃ z₁ : Pt, z₁.1 ∉ U₁) ∧
          (C.left.germToFunctionField U₀).hom t *
            (C.left.germToFunctionField U₁).hom s = 1 ∧
          C.left.basicOpen t = U₀ ⊓ U₁ ∧
          C.left.basicOpen s = U₁ ⊓ U₀ ∧
          ((CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp U₀.ι C.hom).appTop
              (U₀.topIso).hom)).hom).FiniteType ∧
          ((CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp U₁.ι C.hom).appTop
              (U₁.topIso).hom)).hom).FiniteType ∧
          (∀ (b₀ : ↑(C.left.presheaf.obj (Opposite.op U₀)))
             (b₁ : ↑(C.left.presheaf.obj (Opposite.op U₁))),
            (C.left.germToFunctionField U₀).hom b₀ =
              (C.left.germToFunctionField U₁).hom b₁ →
            ∃ c : k, b₀ = ((CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
              (CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp U₀.ι C.hom).appTop
                (U₀.topIso).hom)).hom) c))) :=
by
  classical
  intro Pt K
  rcases _hProjC with ⟨N, ι, hCl⟩
  have : IsClosedImmersion ι.left := hCl
  have : IsProper ι.left := inferInstance
  have : IsAffineHom ι.left := inferInstance
  have : Infinite k := inferInstance
  have hPillar2 :
      let P_over := weilProjectiveSpaceOver k N
      AlgebraicGeometry.IsProper P_over.hom ∧
      ∃ H : { c : Fin (N + 1) → k // c ≠ 0 } → P_over.left.Opens,
        (∀ v, AlgebraicGeometry.IsAffineOpen (H v)) ∧
        (∀ S : Finset ↥P_over.left,
          ∃ v : { c : Fin (N + 1) → k // c ≠ 0 }, ∀ p ∈ S, p ∈ H v) ∧
        (∀ v₀ v₁ : { c : Fin (N + 1) → k // c ≠ 0 },
          ∃ (T₀ : ↑(P_over.left.presheaf.obj (Opposite.op (H v₀))))
            (S₁ : ↑(P_over.left.presheaf.obj (Opposite.op (H v₁)))),
            P_over.left.basicOpen T₀ = H v₀ ⊓ H v₁ ∧
            P_over.left.basicOpen S₁ = H v₁ ⊓ H v₀ ∧
            (P_over.left.presheaf.map
                (CategoryTheory.homOfLE (inf_le_left : H v₀ ⊓ H v₁ ≤ H v₀)).op).hom T₀ *
              (P_over.left.presheaf.map
                (CategoryTheory.homOfLE (inf_le_right : H v₀ ⊓ H v₁ ≤ H v₁)).op).hom S₁ = 1) := by
    intro P_over
    let R := MvPolynomial (Fin (N + 1)) k
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : Algebra.FiniteType ↥(𝒜 0) R := by
      refine ⟨Finset.univ.image (MvPolynomial.X : Fin (N + 1) → R), ?_⟩
      rw [eq_top_iff]
      intro p _
      induction p using MvPolynomial.induction_on with
      | C c =>
        have hc_eq : MvPolynomial.C c = algebraMap ↥(𝒜 0) R (algebraMap k ↥(𝒜 0) c) := rfl
        rw [hc_eq]
        exact Subalgebra.algebraMap_mem _ _
      | add p₁ p₂ hp₁ hp₂ =>
        exact Subalgebra.add_mem _ (hp₁ trivial) (hp₂ trivial)
      | mul_X q j hq =>
        refine Subalgebra.mul_mem _ (hq trivial) (Algebra.subset_adjoin ?_)
        simp
    have : IsProper (Proj.toSpecZero 𝒜) := inferInstance
    have hbij_0 : Function.Bijective (algebraMap k ↥(𝒜 0)) := by
      constructor
      · intro c₁ c₂ hc
        apply (algebraMap k R).injective
        exact congrArg Subtype.val hc
      · rintro ⟨f, hf⟩
        have hf1 : f ∈ (1 : Submodule k R) := by
          rwa [← MvPolynomial.homogeneousSubmodule_zero (Fin (N + 1)) (R := k)]
        obtain ⟨c, hc⟩ := Submodule.mem_one.mp hf1
        exact ⟨c, Subtype.ext hc⟩
    let e0 : k ≃+* ↥(𝒜 0) := RingEquiv.ofBijective (algebraMap k ↥(𝒜 0)) hbij_0
    have he0_hom : CommRingCat.ofHom (algebraMap k ↥(𝒜 0)) = e0.toCommRingCatIso.hom := rfl
    have : IsIso (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) := by
      rw [he0_hom]
      infer_instance
    have : IsProper (Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) := inferInstance
    have hPropP : IsProper P_over.hom := by
      dsimp [P_over, weilProjectiveSpaceOver]
      infer_instance
    refine ⟨hPropP, ?_⟩
    dsimp only [P_over, weilProjectiveSpaceOver, Over.mk_left]
    let F : { c : Fin (N + 1) → k // c ≠ 0 } → R :=
      fun v => ∑ j : Fin (N + 1), MvPolynomial.C (v.1 j) * MvPolynomial.X j
    have hF_deg : ∀ v : { c : Fin (N + 1) → k // c ≠ 0 }, F v ∈ 𝒜 1 := by
      intro v
      dsimp [F]
      refine Submodule.sum_mem (𝒜 1) fun j _ => ?_
      rw [MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_C_mul_X (v.1 j) j
    let H : { c : Fin (N + 1) → k // c ≠ 0 } → (Proj 𝒜).Opens :=
      fun v => Proj.basicOpen 𝒜 (F v)
    have hAffH : ∀ v, IsAffineOpen (H v) :=
      fun v => Proj.isAffineOpen_basicOpen 𝒜 (F v) (hF_deg v) Nat.one_pos
    have hNotAllX : ∀ p : ProjectiveSpectrum 𝒜,
        ¬ (∀ j : Fin (N + 1), MvPolynomial.X j ∈ p.asHomogeneousIdeal.toIdeal) := by
      intro p hAllX
      apply p.not_irrelevant_le
      intro f hf
      have hf_proj : (GradedRing.proj 𝒜 0) f = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 f).mp hf
      have hf_hc0 : MvPolynomial.homogeneousComponent 0 f = 0 := by
        rw [GradedRing.proj_apply] at hf_proj
        exact (MvPolynomial.decomposition.decompose'_apply f 0).symm.trans hf_proj
      rw [← MvPolynomial.sum_homogeneousComponent f]
      refine p.asHomogeneousIdeal.toIdeal.sum_mem fun i _ => ?_
      by_cases hi0 : i = 0
      · subst hi0
        rw [hf_hc0]
        exact p.asHomogeneousIdeal.toIdeal.zero_mem
      · rw [MvPolynomial.homogeneousComponent_apply]
        refine p.asHomogeneousIdeal.toIdeal.sum_mem fun d hd => ?_
        simp only [Finset.mem_filter] at hd
        have hd_ne : d ≠ 0 := by
          intro hd0
          subst hd0
          exact hi0 (by simpa using hd.2.symm)
        have hex_j : ∃ j₀ : Fin (N + 1), d j₀ ≠ 0 := by
          by_contra hall
          have hall' : ∀ j₀ : Fin (N + 1), d j₀ = 0 := fun j₀ => not_not.mp (not_exists.mp hall j₀)
          exact hd_ne (Finsupp.ext hall')
        obtain ⟨j₀, hj₀⟩ := hex_j
        have hj₀_ge : 1 ≤ d j₀ := Nat.one_le_iff_ne_zero.mpr hj₀
        let d' : Fin (N + 1) →₀ ℕ := d - Finsupp.single j₀ 1
        have hd_split : d' + Finsupp.single j₀ 1 = d := by
          ext j
          simp only [d', Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_apply]
          split_ifs with h
          · subst h; omega
          · omega
        have hmon_eq : MvPolynomial.monomial d (f.coeff d) =
            MvPolynomial.monomial d' (f.coeff d) * MvPolynomial.X j₀ := by
          rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, hd_split, mul_one]
        rw [hmon_eq]
        exact p.asHomogeneousIdeal.toIdeal.mul_mem_left _ (hAllX j₀)
    have hAvoidH : ∀ S : Finset ↥(Proj 𝒜),
        ∃ v : { c : Fin (N + 1) → k // c ≠ 0 }, ∀ p ∈ S, p ∈ H v := by
      intro S
      let μ : k → (Fin (N + 1) → k) := fun α j => α ^ (j : ℕ)
      have hμ_ne : ∀ α : k, μ α ≠ 0 := by
        intro α h0
        have h1 : (1 : k) = 0 := by simpa [μ] using congrFun h0 (0 : Fin (N + 1))
        exact one_ne_zero h1
      let Bad : ProjectiveSpectrum 𝒜 → Set k :=
        fun p => { α : k | F ⟨μ α, hμ_ne α⟩ ∈ p.asHomogeneousIdeal.toIdeal }
      have hBad_fin : ∀ p : ProjectiveSpectrum 𝒜, (Bad p).Finite := by
        intro p
        by_contra hInf_not
        have hInf : (Bad p).Infinite := hInf_not
        obtain ⟨B, hB_sub, hB_card⟩ := hInf.exists_subset_card_eq (N + 1)
        let eB : Fin (N + 1) ≃ ↥B :=
          (Fintype.equivFinOfCardEq (by simp [hB_card])).symm
        let α_vec : Fin (N + 1) → k := fun r => (eB r).1
        have hα_inj : Function.Injective α_vec := Subtype.coe_injective.comp eB.injective
        let M : Matrix (Fin (N + 1)) (Fin (N + 1)) k := Matrix.vandermonde α_vec
        have hdet_ne : M.det ≠ 0 := Matrix.det_vandermonde_ne_zero_iff.mpr hα_inj
        have hMinv : M⁻¹ * M = 1 := Matrix.nonsing_inv_mul M (isUnit_iff_ne_zero.mpr hdet_ne)
        let q : R →+* (R ⧸ p.asHomogeneousIdeal.toIdeal) :=
          Ideal.Quotient.mk p.asHomogeneousIdeal.toIdeal
        let ψ : k →+* (R ⧸ p.asHomogeneousIdeal.toIdeal) := q.comp MvPolynomial.C
        have hRow0 : ∀ r : Fin (N + 1),
            ∑ m : Fin (N + 1), ψ (M r m) * q (MvPolynomial.X m) = 0 := by
          intro r
          have hmem : α_vec r ∈ Bad p := hB_sub (eB r).2
          have hq0 : q (F ⟨μ (α_vec r), hμ_ne (α_vec r)⟩) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr hmem
          dsimp [F, μ, M] at hq0 ⊢
          rw [map_sum] at hq0
          rw [← hq0]
          refine Finset.sum_congr rfl fun m _ => ?_
          exact (map_mul q _ _).symm
        apply hNotAllX p
        intro j
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        change q (MvPolynomial.X j) = 0
        have hXj : q (MvPolynomial.X j) =
            ∑ m : Fin (N + 1), ψ ((1 : Matrix (Fin (N + 1)) (Fin (N + 1)) k) j m) *
              q (MvPolynomial.X m) := by
          simp [Matrix.one_apply]
        rw [hXj, ← hMinv]
        have hsum_swap :
            (∑ m : Fin (N + 1), ψ ((M⁻¹ * M) j m) * q (MvPolynomial.X m)) =
              ∑ r : Fin (N + 1), ψ (M⁻¹ j r) *
                (∑ m : Fin (N + 1), ψ (M r m) * q (MvPolynomial.X m)) := by
          simp only [Matrix.mul_apply, map_sum, map_mul, Finset.sum_mul, Finset.mul_sum, mul_assoc]
          exact Finset.sum_comm
        rw [hsum_swap]
        simp [hRow0]
      let Bad_S : Set k := ⋃ p ∈ S, Bad p
      have hBadS_fin : Bad_S.Finite := S.finite_toSet.biUnion fun p _ => hBad_fin p
      obtain ⟨α₀, hα₀⟩ := hBadS_fin.exists_notMem
      refine ⟨⟨μ α₀, hμ_ne α₀⟩, ?_⟩
      intro p hp
      have hnot_bad : α₀ ∉ Bad p := fun h => hα₀ (Set.mem_iUnion₂.mpr ⟨p, hp, h⟩)
      exact (ProjectiveSpectrum.mem_basicOpen 𝒜 (F ⟨μ α₀, hμ_ne α₀⟩) p).mpr hnot_bad
    have h1_smul : (1 : ℕ) • (1 : ℕ) = 1 := one_smul ℕ 1
    let mkSec : ∀ (u₀ u₁ : { c : Fin (N + 1) → k // c ≠ 0 }),
        ↑((Proj 𝒜).presheaf.obj (Opposite.op (H u₀))) :=
      fun u₀ u₁ =>
        (Proj.awayToSection 𝒜 (F u₀)).hom
          (HomogeneousLocalization.Away.mk 𝒜 (hF_deg u₀) 1 (F u₁) (h1_smul.symm ▸ hF_deg u₁))
    have hMulPair : ∀ (u₀ u₁ : { c : Fin (N + 1) → k // c ≠ 0 }),
        ((Proj 𝒜).presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : H u₀ ⊓ H u₁ ≤ H u₀)).op).hom (mkSec u₀ u₁) *
          ((Proj 𝒜).presheaf.map
            (CategoryTheory.homOfLE (inf_le_right : H u₀ ⊓ H u₁ ≤ H u₁)).op).hom (mkSec u₁ u₀) = 1 := by
      intro u₀ u₁
      let F₀ := F u₀
      let F₁ := F u₁
      have hF₀ : F₀ ∈ 𝒜 1 := hF_deg u₀
      have hF₁ : F₁ ∈ 𝒜 1 := hF_deg u₁
      let τ₀ : HomogeneousLocalization.Away 𝒜 F₀ :=
        HomogeneousLocalization.Away.mk 𝒜 hF₀ 1 F₁ (h1_smul.symm ▸ hF₁)
      let σ₁ : HomogeneousLocalization.Away 𝒜 F₁ :=
        HomogeneousLocalization.Away.mk 𝒜 hF₁ 1 F₀ (h1_smul.symm ▸ hF₀)
      have h_mul_open : H u₀ ⊓ H u₁ ≤ Proj.basicOpen 𝒜 (F₀ * F₁) :=
        le_of_eq (Proj.basicOpen_mul 𝒜 F₀ F₁).symm
      have h_away₀ := Proj.awayMap_awayToSection 𝒜 hF₁ (rfl : F₀ * F₁ = F₀ * F₁)
      have h_away₁ := Proj.awayMap_awayToSection 𝒜 hF₀ (mul_comm F₀ F₁ : F₀ * F₁ = F₁ * F₀)
      have h_prod_loc :
          HomogeneousLocalization.awayMap 𝒜 hF₁ (rfl : F₀ * F₁ = F₀ * F₁) τ₀ *
            HomogeneousLocalization.awayMap 𝒜 hF₀ (mul_comm F₀ F₁) σ₁ = 1 := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_one]
        dsimp [τ₀, σ₁]
        rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
          HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
          Localization.mk_mul, ← Localization.mk_one, Localization.mk_eq_mk_iff,
          Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [Submonoid.coe_one, Submonoid.coe_mul]
        ring
      have h_sec_mul :
          (Proj.awayToSection 𝒜 (F₀ * F₁)).hom
              (HomogeneousLocalization.awayMap 𝒜 hF₁ (rfl : F₀ * F₁ = F₀ * F₁) τ₀) *
            (Proj.awayToSection 𝒜 (F₀ * F₁)).hom
              (HomogeneousLocalization.awayMap 𝒜 hF₀ (mul_comm F₀ F₁) σ₁) = 1 := by
        rw [← map_mul, h_prod_loc, map_one]
      have h_res₀ :
          ((Proj 𝒜).presheaf.map (CategoryTheory.homOfLE h_mul_open).op).hom
            ((Proj.awayToSection 𝒜 (F₀ * F₁)).hom
              (HomogeneousLocalization.awayMap 𝒜 hF₁ (rfl : F₀ * F₁ = F₀ * F₁) τ₀)) =
          ((Proj 𝒜).presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : H u₀ ⊓ H u₁ ≤ H u₀)).op).hom (mkSec u₀ u₁) := by
        have h_away₀' :
            CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜 hF₁ (rfl : F₀ * F₁ = F₀ * F₁)) ≫
              Proj.awayToSection 𝒜 (F₀ * F₁) ≫
              (Proj 𝒜).presheaf.map (CategoryTheory.homOfLE h_mul_open).op =
            Proj.awayToSection 𝒜 F₀ ≫
              (Proj 𝒜).presheaf.map (CategoryTheory.homOfLE (inf_le_left : H u₀ ⊓ H u₁ ≤ H u₀)).op := by
          rw [← Category.assoc, h_away₀, Category.assoc, ← (Proj 𝒜).presheaf.map_comp]
          exact congrArg (Proj.awayToSection 𝒜 F₀ ≫ (Proj 𝒜).presheaf.map ·) (Subsingleton.elim _ _)
        exact congrArg (fun g => g.hom τ₀) h_away₀'
      have h_res₁ :
          ((Proj 𝒜).presheaf.map (CategoryTheory.homOfLE h_mul_open).op).hom
