      ext c
      exact hmk_a I_Δ _
    rwa [hfun]
  let e_Δ : (Fin (n * K_pos) → A₁) ≃ₗ[A₁] (R_tilde ⧸ I_Δ) :=
    LinearEquiv.ofBijective φ_Δ hφ_Δ_bij
  let I_W : Ideal R_tilde := Ideal.span ({W_plus} : Set R_tilde)
  let I_g : Ideal R_tilde := Ideal.span ({g_gen} : Set R_tilde)
  let Q_W := R_tilde ⧸ I_W
  let Q := R_tilde ⧸ I_g
  obtain ⟨e_W_pos⟩ := h_split (Finset.univ.prod u_pos) W_plus hf_pos_ne K_pos e_pos
  have h_span_Δ : Ideal.span ({Finset.univ.prod u_pos * W_plus} : Set R_tilde) = I_Δ := by
    rw [hUW]
  let α_pos : (Q_W × (Fin K_pos → A₁)) ≃ₗ[A₁] (Fin (n * K_pos) → A₁) :=
    (e_W_pos.trans ((Submodule.quotEquivOfEq _ _ h_span_Δ).restrictScalars A₁)).trans e_Δ.symm
  obtain ⟨e_W_neg⟩ := h_split (Finset.univ.prod u_neg) W_plus hf_neg_ne K_neg e_neg
  have h_span_g : Ideal.span ({Finset.univ.prod u_neg * W_plus} : Set R_tilde) = I_g := by
    dsimp only [I_g]
    rw [hg_span, mul_comm]
  let α_neg : (Q_W × (Fin K_neg → A₁)) ≃ₗ[A₁] Q :=
    e_W_neg.trans ((Submodule.quotEquivOfEq _ _ h_span_g).restrictScalars A₁)
  let N_tot : ℕ := R_dim + K_pos
  have h_dim_eq : N_tot = n * K_pos + K_neg := by
    dsimp only [N_tot, R_dim]
    calc
      (n - 1) * K_pos + K_neg + K_pos = ((n - 1) + 1) * K_pos + K_neg := by ring
      _ = n * K_pos + K_neg := by rw [Nat.sub_add_cancel _hn]
  let E_raw : (Q × (Fin K_pos → A₁)) ≃ₗ[A₁] (Fin (n * K_pos + K_neg) → A₁) :=
    (((((α_neg.symm.prodCongr (LinearEquiv.refl A₁ (Fin K_pos → A₁))).trans
      (LinearEquiv.prodAssoc A₁ Q_W (Fin K_neg → A₁) (Fin K_pos → A₁))).trans
      ((LinearEquiv.refl A₁ Q_W).prodCongr
        (LinearEquiv.prodComm A₁ (Fin K_neg → A₁) (Fin K_pos → A₁)))).trans
      (LinearEquiv.prodAssoc A₁ Q_W (Fin K_pos → A₁) (Fin K_neg → A₁)).symm).trans
      (α_pos.prodCongr (LinearEquiv.refl A₁ (Fin K_neg → A₁)))).trans
      (κ (n * K_pos) K_neg)
  let E₁ : (Q × (Fin K_pos → A₁)) ≃ₗ[A₁] (Fin N_tot → A₁) :=
    E_raw.trans (LinearEquiv.funCongrLeft A₁ A₁ (Fin.castOrderIso h_dim_eq).toEquiv)
  let J : Matrix (Fin N_tot) (Fin K_pos) A₁ :=
    Matrix.of fun i l => E₁ (0, Pi.single l 1) i
  let R : Matrix (Fin K_pos) (Fin N_tot) A₁ :=
    Matrix.of fun l i => (E₁.symm (Pi.single i 1)).2 l
  have hJ_mulVec : ∀ y : Fin K_pos → A₁, J.mulVec y = E₁ (0, y) := by
    intro y
    let inr_E : (Fin K_pos → A₁) →ₗ[A₁] (Fin N_tot → A₁) :=
      E₁.toLinearMap.comp (LinearMap.inr A₁ Q (Fin K_pos → A₁))
    have hy : E₁ (0, y) = inr_E (Finset.univ.sum fun l : Fin K_pos => y l • Pi.single l 1) := by
      rw [h_pi_sum K_pos y]
      rfl
    rw [hy, map_sum]
    ext i
    simp only [Matrix.mulVec, dotProduct, J, Matrix.of_apply, Finset.sum_apply, LinearMap.map_smul,
      Pi.smul_apply, smul_eq_mul, inr_E, LinearMap.comp_apply, LinearMap.inr_apply,
      LinearEquiv.coe_coe, mul_comm]
  have hR_mulVec : ∀ v : Fin N_tot → A₁, R.mulVec v = (E₁.symm v).2 := by
    intro v
    let snd_E : (Fin N_tot → A₁) →ₗ[A₁] (Fin K_pos → A₁) :=
      (LinearMap.snd A₁ Q (Fin K_pos → A₁)).comp E₁.symm.toLinearMap
    have hv : (E₁.symm v).2 = snd_E (Finset.univ.sum fun i : Fin N_tot => v i • Pi.single i 1) := by
      rw [h_pi_sum N_tot v]
      rfl
    rw [hv, map_sum]
    ext l
    simp only [Matrix.mulVec, dotProduct, R, Matrix.of_apply, Finset.sum_apply, LinearMap.map_smul,
      Pi.smul_apply, smul_eq_mul, snd_E, LinearMap.comp_apply, LinearMap.snd_apply,
      LinearEquiv.coe_coe, mul_comm]
  have hRJ : R * J = 1 := by
    ext l₁ l₂
    have hcol : (fun i : Fin N_tot => J i l₂) = E₁ (0, Pi.single l₂ 1) := rfl
    change (R.mulVec (fun i : Fin N_tot => J i l₂)) l₁ =
      (1 : Matrix (Fin K_pos) (Fin K_pos) A₁) l₁ l₂
    rw [hcol, hR_mulVec, E₁.symm_apply_apply]
    simp [Pi.single_apply, Matrix.one_apply]
  let J_bar : Matrix (Fin N_tot) (Fin K_pos) k := J.map ev₁
  let R_bar : Matrix (Fin K_pos) (Fin N_tot) k := R.map ev₁
  have hRJ_bar : R_bar * J_bar = 1 := by
    dsimp only [R_bar, J_bar]
    rw [← Matrix.map_mul, hRJ]
    ext l₁ l₂
    simp [Matrix.one_apply]
  let f_bar : (Fin N_tot → k) →ₗ[k] (Fin K_pos → k) := Matrix.mulVecLin R_bar
  have hf_range : LinearMap.range f_bar = ⊤ := by
    rw [LinearMap.range_eq_top]
    intro y
