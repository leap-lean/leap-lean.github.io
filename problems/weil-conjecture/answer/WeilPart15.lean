          ((hClosed_Wtr r₀).inter (hOpenDist.isClosed_compl.preimage fstPP.continuous))
      have hr₀_not_Zbad : ∀ r₀ : ClPtP, r₀.1 ∉ Z_bad r₀ := by
        intro r₀ hmem
        rcases hmem with ⟨w_pre, ⟨hw_pre_W, hw_pre_nd⟩, hw_pre_snd⟩
        let BadFib : Set ↥(CategoryTheory.Limits.pullback P.hom P.hom) :=
          (W_tr r₀ ∩ fstPP.base ⁻¹' U_distᶜ) ∩ sndPP.base ⁻¹' {r₀.1}
        have hClosed_BadFib : IsClosed BadFib :=
          ((hClosed_Wtr r₀).inter (hOpenDist.isClosed_compl.preimage fstPP.continuous)).inter
            (r₀.2.preimage sndPP.continuous)
        obtain ⟨w_bad, ⟨⟨⟨hw_W, hw_nd⟩, hw_snd⟩, _⟩, hw_bad_cl⟩ :=
          hDensePP BadFib Set.univ hClosed_BadFib isOpen_univ
            ⟨w_pre, ⟨⟨hw_pre_W, hw_pre_nd⟩, hw_pre_snd⟩, trivial⟩
        obtain ⟨hz_bad_cl, _⟩ := (hClosedPP w_bad).mp hw_bad_cl
        obtain ⟨Q_bad, hQ_bad⟩ := hPtToTuple (fstPP.base w_bad) hz_bad_cl
        have hw_bad_R : weilCurvePowMatchesTuple k C (sndPP.base w_bad) (R_tup r₀) := by
          have hs : sndPP.base w_bad = r₀.1 := hw_snd
          exact hs.symm ▸ hR_tup r₀
        have hmk_bad : mkCl (weilCurveDivSum C.left Q_bad) =
            mkCl (weilCurveDivSum C.left Q_ref) := by
          have h1 := (hMem_Wtr r₀ w_bad Q_bad (R_tup r₀) hQ_bad hw_bad_R).mp hw_W
          rw [one_smul] at h1
          have hadd_eq : weilCurveDivSum C.left (R_tup r₀) + D_tr r₀ =
              weilCurveDivSum C.left Q_ref := by
            dsimp [D_tr]
            abel
          rwa [hadd_eq] at h1
        have hDiv_eq : weilCurveDivSum C.left Q_bad = weilCurveDivSum C.left Q_ref := by
          have h_sub_eq : (⟨weilCurveDivSum C.left Q_bad, hEff_divSum Q_bad, hmk_bad⟩ :
              { E' : Pt →₀ ℤ // (∀ x, 0 ≤ E' x) ∧
                mkCl E' = mkCl (weilCurveDivSum C.left Q_ref) }) =
            ⟨weilCurveDivSum C.left Q_ref, hEff_divSum Q_ref, rfl⟩ :=
            @Subsingleton.elim _ hSub_ref _ _
          exact congrArg Subtype.val h_sub_eq
        have hNotInj : ¬ (∀ i j : Fin d₀, i ≠ j → Q_bad i ≠ Q_bad j) :=
          fun hinj => hw_nd ((hMem_dist (fstPP.base w_bad) Q_bad hQ_bad).mpr hinj)
        push_neg at hNotInj
        rcases hNotInj with ⟨i₀, j₀, hij_ne, hij_eq⟩
        let p_col : Pt := Q_bad i₀
        have hge2 : (2 : ℤ) ≤ weilCurveDivSum C.left Q_bad p_col := by
          dsimp [weilCurveDivSum]
          rw [Finsupp.finsetSum_apply]
          have hsub : ({i₀, j₀} : Finset (Fin d₀)) ⊆ Finset.univ := Finset.subset_univ _
          have hle := Finset.sum_le_sum_of_subset_of_nonneg
            (f := fun j : Fin d₀ => Finsupp.single (Q_bad j) (1 : ℤ) p_col) hsub
            (fun idx _ _ => by
              rw [Finsupp.single_apply]
              split_ifs <;> omega)
          have hpair : (∑ k ∈ ({i₀, j₀} : Finset (Fin d₀)),
              Finsupp.single (Q_bad k) (1 : ℤ) p_col) = 2 := by
            rw [Finset.sum_pair hij_ne]
            have hj₀ : Q_bad j₀ = p_col := hij_eq.symm
            simp [p_col, hj₀]
          omega
        have hle1 : weilCurveDivSum C.left Q_ref p_col ≤ 1 := by
          dsimp [weilCurveDivSum]
          rw [Finsupp.finsetSum_apply]
          let S_col : Finset (Fin d₀) := Finset.univ.filter (fun k => Q_ref k = p_col)
          have hsum_card : (∑ k : Fin d₀, Finsupp.single (Q_ref k) (1 : ℤ) p_col) =
              (S_col.card : ℤ) := by
            have hite : ∀ k : Fin d₀, Finsupp.single (Q_ref k) (1 : ℤ) p_col =
                if Q_ref k = p_col then (1 : ℤ) else 0 :=
              fun k => Finsupp.single_apply
            simp_rw [hite]
            rw [← Finset.sum_filter]
            simp [S_col]
          have hcard_le1 : S_col.card ≤ 1 := by
            rw [Finset.card_le_one_iff]
            intro a b ha hb
            simp only [S_col, Finset.mem_filter, Finset.mem_univ, true_and] at ha hb
            by_contra hab
            exact hInj_ref a b hab (ha.trans hb.symm)
          rw [hsum_card]
          omega
        rw [hDiv_eq] at hge2
        omega
      let V_tr : ClPtP → Set ↥P.left := fun r₀ => U_tr r₀ ∩ (Z_bad r₀)ᶜ
      have hOpen_Vtr : ∀ r₀ : ClPtP, IsOpen (V_tr r₀) :=
        fun r₀ => (hOpen_Utr r₀).inter (hClosed_Zbad r₀).isOpen_compl
      have hCover_univ : (Set.univ : Set ↥P.left) ⊆ ⋃ r₀ : ClPtP, V_tr r₀ := by
        intro x _
        by_contra hx_not
        let U_all : Set ↥P.left := ⋃ r₀ : ClPtP, V_tr r₀
        have hClosed_compl : IsClosed U_allᶜ := (isOpen_iUnion hOpen_Vtr).isClosed_compl
        obtain ⟨z, ⟨hz_not, _⟩, hz_cl⟩ :=
          hDenseP U_allᶜ Set.univ hClosed_compl isOpen_univ ⟨x, hx_not, trivial⟩
        apply hz_not
        exact Set.mem_iUnion.mpr ⟨⟨z, hz_cl⟩, hr₀_Utr ⟨z, hz_cl⟩, hr₀_not_Zbad ⟨z, hz_cl⟩⟩
      obtain ⟨I_cov, hSubcov⟩ := isCompact_univ.elim_finite_subcover V_tr hOpen_Vtr hCover_univ
      have hDeg_ℓDtr : ∀ r₀ : ClPtP, deg_Cl (ℓ • mkCl (D_tr r₀)) = 0 := by
        intro r₀
        rw [map_nsmul, hDeg_Dtr r₀, nsmul_zero]
      let R_star : ClPtP → (Fin d₀ → Pt) :=
        fun r₀ => (hSurj_d₀ (ℓ • mkCl (D_tr r₀)) (hDeg_ℓDtr r₀)).choose
      have hR_star : ∀ r₀ : ClPtP, Φ d₀ (R_star r₀) = ℓ • mkCl (D_tr r₀) :=
        fun r₀ => (hSurj_d₀ (ℓ • mkCl (D_tr r₀)) (hDeg_ℓDtr r₀)).choose_spec
      let F_tr : ClPtP → Set ↥P.left := fun r₀ => (hKummerIso ℓ hℓ P₀ (R_star r₀)).choose
      have hMem_Ftr : ∀ (r₀ : ClPtP) (z : ↥P.left) (Q : Fin d₀ → Pt),
          weilCurvePowMatchesTuple k C z Q →
          (z ∈ F_tr r₀ ↔
            ℓ • mkCl (weilCurveDivSum C.left Q) =
              mkCl (weilCurveDivSum C.left (R_star r₀) + D_fix_ℓ)) :=
        fun r₀ => (hKummerIso ℓ hℓ P₀ (R_star r₀)).choose_spec.2.1
      have hIso_Ftr : ∀ (r₀ : ClPtP) (z_star : ↥P.left) (Q_star : Fin d₀ → Pt),
          weilCurvePowMatchesTuple k C z_star Q_star →
          z_star ∈ F_tr r₀ →
          (∀ i j : Fin d₀, i ≠ j → Q_star i ≠ Q_star j) →
          weilCurveEffSubsingleton C.left (weilCurveDivSum C.left Q_star) →
          ∃ W : Set ↥P.left, IsOpen W ∧ z_star ∈ W ∧ F_tr r₀ ∩ W = {z_star} :=
        fun r₀ => (hKummerIso ℓ hℓ P₀ (R_star r₀)).choose_spec.2.2
      let S_tr : ClPtP → Set ↥P.left :=
        fun r₀ => { z : ↥P.left | z ∈ F_tr r₀ ∩ U_good ∧ IsClosed ({z} : Set ↥P.left) }
      have hFin_Str : ∀ r₀ : ClPtP, Finite ↥(S_tr r₀) := by
        intro r₀
        apply hDiscFin (S_tr r₀)
        intro z ⟨⟨hz_F, hz_good⟩, hz_cl⟩
        obtain ⟨Q, hQ⟩ := hPtToTuple z hz_cl
        have hQ_inj : ∀ i j : Fin d₀, i ≠ j → Q i ≠ Q j :=
          (hMem_dist z Q hQ).mp hz_good.2
        have hQ_sub : weilCurveEffSubsingleton C.left (weilCurveDivSum C.left Q) := by
          have := (hMem_uniq₀ z Q hQ).mp hz_good.1
          simpa only [add_zero] using this
        obtain ⟨W₁, hOpen_W₁, hz_W₁, hIso_W₁⟩ := hIso_Ftr r₀ z Q hQ hz_F hQ_inj hQ_sub
        refine ⟨W₁, hOpen_W₁, hz_W₁, ?_⟩
        ext y
        simp only [Set.mem_inter_iff, Set.mem_singleton_iff]
        constructor
        · rintro ⟨⟨⟨hy_F, _⟩, _⟩, hy_W₁⟩
          have : y ∈ F_tr r₀ ∩ W₁ := ⟨hy_F, hy_W₁⟩
          rwa [hIso_W₁, Set.mem_singleton_iff] at this
        · rintro rfl
          exact ⟨⟨⟨hz_F, hz_good⟩, hz_cl⟩, hz_W₁⟩
      haveI : ∀ m : ↥I_cov, Finite ↥(S_tr m.1) := fun m => hFin_Str m.1
      let Tors₀ := { c : Cl // deg_Cl c = 0 ∧ ℓ • c = 0 }
      let R_of : Tors₀ → (Fin d₀ → Pt) := fun t => (hSurj_d₀ t.1 t.2.1).choose
      have hR_of : ∀ t : Tors₀, Φ d₀ (R_of t) = t.1 :=
        fun t => (hSurj_d₀ t.1 t.2.1).choose_spec
      let z_of : Tors₀ → ↥P.left := fun t => (hTupleToPt (R_of t)).choose
      have hz_of : ∀ t : Tors₀, weilCurvePowMatchesTuple k C (z_of t) (R_of t) :=
        fun t => (hTupleToPt (R_of t)).choose_spec.1
      have hex_cov : ∀ t : Tors₀, ∃ m : ↥I_cov, z_of t ∈ V_tr m.1 := by
        intro t
        have hmem := hSubcov (Set.mem_univ (z_of t))
        simp only [Set.mem_iUnion, exists_prop] at hmem
        rcases hmem with ⟨r₀, hr₀_in, hz_in⟩
        exact ⟨⟨r₀, hr₀_in⟩, hz_in⟩
      let m_of : Tors₀ → ↥I_cov := fun t => (hex_cov t).choose
      have hm_of : ∀ t : Tors₀, z_of t ∈ V_tr (m_of t).1 :=
        fun t => (hex_cov t).choose_spec
      let c_trans : Tors₀ → Cl := fun t =>
        mkCl (weilCurveDivSum C.left (R_of t) + D_tr (m_of t).1 - Finsupp.single P₀ (d₀ : ℤ))
      have hc_trans_deg : ∀ t : Tors₀, deg_Cl (c_trans t) = 0 := by
        intro t
        dsimp [c_trans]
        rw [map_sub, map_sub, map_add, map_add, hDeg_divSum, hDeg_Dtr, hdeg, hSum_single]
        ring
      let Q_trans : Tors₀ → (Fin d₀ → Pt) :=
        fun t => (hSurj_d₀ (c_trans t) (hc_trans_deg t)).choose
      have hQ_trans_eq : ∀ t : Tors₀,
          mkCl (weilCurveDivSum C.left (Q_trans t)) =
            mkCl (weilCurveDivSum C.left (R_of t) + D_tr (m_of t).1) := by
        intro t
        have hΦ_eq : Φ d₀ (Q_trans t) = c_trans t :=
          (hSurj_d₀ (c_trans t) (hc_trans_deg t)).choose_spec
        dsimp [Φ, c_trans] at hΦ_eq
        rw [map_sub, map_sub] at hΦ_eq
        exact sub_left_inj.mp hΦ_eq
      let z_trans : Tors₀ → ↥P.left := fun t => (hTupleToPt (Q_trans t)).choose
      have hz_trans : ∀ t : Tors₀, weilCurvePowMatchesTuple k C (z_trans t) (Q_trans t) :=
        fun t => (hTupleToPt (Q_trans t)).choose_spec.1
      have hz_trans_mem : ∀ t : Tors₀, z_trans t ∈ S_tr (m_of t).1 := by
        intro t
        refine ⟨⟨?_, ?_, ?_⟩, (hz_trans t).1⟩
        · rw [hMem_Ftr (m_of t).1 (z_trans t) (Q_trans t) (hz_trans t)]
          rw [hQ_trans_eq t, map_add, ← natCast_zsmul, zsmul_add, natCast_zsmul, natCast_zsmul]
          have hℓR : ℓ • mkCl (weilCurveDivSum C.left (R_of t)) =
              ℓ • mkCl (Finsupp.single P₀ (d₀ : ℤ)) := by
            have ht0 : ℓ • Φ d₀ (R_of t) = 0 := by
              rw [hR_of t]
              exact t.2.2
            dsimp [Φ] at ht0
            rw [map_sub, ← natCast_zsmul, zsmul_sub, natCast_zsmul, natCast_zsmul] at ht0
            exact sub_eq_zero.mp ht0
          have hRstar_eq : mkCl (weilCurveDivSum C.left (R_star (m_of t).1) + D_fix_ℓ) =
              ℓ • mkCl (Finsupp.single P₀ (d₀ : ℤ)) + ℓ • mkCl (D_tr (m_of t).1) := by
            have hs := hR_star (m_of t).1
            dsimp [Φ] at hs
            rw [map_sub] at hs
            rw [map_add, ← hD_fix_ℓ_eq, map_sub, map_zsmul, natCast_zsmul]
            have hs' : mkCl (weilCurveDivSum C.left (R_star (m_of t).1)) =
                ℓ • mkCl (D_tr (m_of t).1) + mkCl (Finsupp.single P₀ (d₀ : ℤ)) :=
              sub_eq_iff_eq_add.mp hs
            rw [hs']
            abel
          rw [hℓR, hRstar_eq]
        · rw [hMem_uniq₀ (z_trans t) (Q_trans t) (hz_trans t), add_zero]
          have hsub_src : weilCurveEffSubsingleton C.left
              (weilCurveDivSum C.left (R_of t) + D_tr (m_of t).1) :=
            (hMem_Utr (m_of t).1 (z_of t) (R_of t) (hz_of t)).mp (hm_of t).1
          exact hSub_of_mkCl_eq _ _ (hQ_trans_eq t).symm hsub_src
        · by_contra hz_nd
          obtain ⟨w_t, ⟨_, hw_fst, hw_snd⟩, _⟩ :=
            hPairPP (z_trans t) (z_of t) (hz_trans t).1 (hz_of t).1
          apply (hm_of t).2
          refine ⟨w_t, ⟨?_, ?_⟩, hw_snd⟩
          · have hw_Q : weilCurvePowMatchesTuple k C (fstPP.base w_t) (Q_trans t) :=
              hw_fst.symm ▸ hz_trans t
            have hw_R : weilCurvePowMatchesTuple k C (sndPP.base w_t) (R_of t) :=
              hw_snd.symm ▸ hz_of t
            rw [hMem_Wtr (m_of t).1 w_t (Q_trans t) (R_of t) hw_Q hw_R, one_smul]
            exact hQ_trans_eq t
          · change fstPP.base w_t ∉ U_dist
            rwa [hw_fst]
      let emb : Tors₀ → Σ m : ↥I_cov, ↥(S_tr m.1) :=
        fun t => ⟨m_of t, ⟨z_trans t, hz_trans_mem t⟩⟩
      have hemb_inj : Function.Injective emb := by
        intro t₁ t₂ h
        have hm_eq : m_of t₁ = m_of t₂ := congrArg Sigma.fst h
        have hz_eq : z_trans t₁ = z_trans t₂ :=
          congrArg (fun p : Σ m : ↥I_cov, ↥(S_tr m.1) => p.2.1) h
        have hQ_eq : Q_trans t₁ = Q_trans t₂ :=
          hTupleUnique (hz_eq ▸ hz_trans t₁) (hz_trans t₂)
        have hmk_R_eq : mkCl (weilCurveDivSum C.left (R_of t₁)) =
            mkCl (weilCurveDivSum C.left (R_of t₂)) := by
          have h1 := hQ_trans_eq t₁
          have h2 := hQ_trans_eq t₂
          rw [hQ_eq, hm_eq] at h1
          have h12 : mkCl (weilCurveDivSum C.left (R_of t₁) + D_tr (m_of t₂).1) =
              mkCl (weilCurveDivSum C.left (R_of t₂) + D_tr (m_of t₂).1) :=
            h1.symm.trans h2
          rw [map_add, map_add] at h12
          exact add_right_cancel h12
        apply Subtype.ext
        rw [← hR_of t₁, ← hR_of t₂]
        dsimp [Φ]
        rw [map_sub, map_sub, hmk_R_eq]
      exact Finite.of_injective emb hemb_inj

theorem weil_etale_smooth_proj_curve_mod_prime_cohomology (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntC : AlgebraicGeometry.IsIntegral C.left)
    (hProjC : IsProjectiveOverField k C)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0) :
    (∀ q : ℕ, Finite (weilEtaleTorsionH C.left ℓ q)) ∧
    (∀ q : ℕ, 3 ≤ q → Subsingleton (weilEtaleTorsionH C.left ℓ q)) ∧
    Nat.card (weilEtaleTorsionH C.left ℓ 0) = ℓ ∧
    Nat.card (weilEtaleTorsionH C.left ℓ 2) = ℓ :=
by
  classical
  have : AlgebraicGeometry.IsIntegral C.left := hIntC
  have hPrime : Nat.Prime ℓ := Fact.out
  have : NeZero ℓ := ⟨hPrime.ne_zero⟩
  
  have : IrreducibleSpace ↥C.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C.left
  have : ConnectedSpace ↥C.left := IrreducibleSpace.connectedSpace ↥C.left
  have hCard0 : Nat.card (weilEtaleTorsionH C.left ℓ 0) = ℓ := by
    generalize hS_eq : C.left = S
    have : ConnectedSpace ↥S := hS_eq ▸ inferInstance
    let P_et : MorphismProperty Scheme.{u} := @AlgebraicGeometry.Etale
    let J := S.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let A := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    let F_ℓ := weilEtaleTorsionSheaf S ℓ
    have hMult : MorphismProperty.IsMultiplicative P_et := inferInstance
    have := hMult.toContainsIdentities
    have := hMult.toIsStableUnderComposition
    have hMemJ : ∀ (U : S.Etale) (R : Sieve U),
        R ∈ J U ↔ ∀ x : ↥U.left, ∃ (Y : S.Etale) (f : Y ⟶ U) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
      intro U R
      have hJ_eq :=
        Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) S le_rfl
      exact (Eq.to_iff (congrArg (fun G : GrothendieckTopology (P_et.Over ⊤ S) => R ∈ G U) hJ_eq)).trans
        (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U R)
    let T_S : S.Etale :=
      MorphismProperty.Over.mk ⊤ (𝟙 S) (MorphismProperty.id_mem P_et S)
    have hT : Limits.IsTerminal T_S :=
      Limits.IsTerminal.ofUniqueHom
        (fun U => MorphismProperty.Over.homMk U.hom (Category.comp_id U.hom))
        (fun U g => MorphismProperty.Over.Hom.ext
          ((Category.comp_id g.left).symm.trans (MorphismProperty.Over.w g)))
    let L_pre : (S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
      { obj := fun U => AddCommGrpCat.of (LocallyConstant ↥((Opposite.unop U).left) ↥A)
        map := fun f =>
          AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom ((Opposite.unop f).left.base.hom))
        map_id := fun U => by
          apply AddCommGrpCat.ext
          intro g
          ext x
          rfl
        map_comp := fun f₁ f₂ => by
          apply AddCommGrpCat.ext
          intro g
          ext x
          rfl }
    have hL_sheaf : Presheaf.IsSheaf J L_pre := by
      apply Presheaf.isSheaf_of_isSheaf_comp J L_pre (forget AddCommGrpCat.{u})
      rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
      intro U R hR
      have hR_mem : ∀ x : ↥U.left, ∃ (Y : S.Etale) (f : Y ⟶ U) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x :=
        (hMemJ U R).mp hR
      intro x_fam hx_compat
      let x_lc : ∀ {Y : S.Etale} (f : Y ⟶ U), R.arrows f → LocallyConstant ↥Y.left ↥A :=
        fun f hf => x_fam f hf
      have hoverlap : ∀ {Y₁ Y₂ : S.Etale} (f₁ : Y₁ ⟶ U) (f₂ : Y₂ ⟶ U)
          (hf₁ : R.arrows f₁) (hf₂ : R.arrows f₂) (y₁ : ↥Y₁.left) (y₂ : ↥Y₂.left),
          f₁.left.base y₁ = f₂.left.base y₂ →
          (x_lc f₁ hf₁) y₁ = (x_lc f₂ hf₂) y₂ := by
        intro Y₁ Y₂ f₁ f₂ hf₁ hf₂ y₁ y₂ hy
        have hf₂_et : AlgebraicGeometry.Etale f₂.left :=
          MorphismProperty.of_postcomp P_et f₂.left U.hom U.prop
            (by have hw : f₂.left ≫ U.hom = Y₂.hom := MorphismProperty.Over.w f₂
                exact hw.symm ▸ Y₂.prop)
        have hp₁_et : P_et (Limits.pullback.fst f₁.left f₂.left) := inferInstance
        let Z_pb : S.Etale :=
          MorphismProperty.Over.mk ⊤ (Limits.pullback.fst f₁.left f₂.left ≫ Y₁.hom)
            (MorphismProperty.comp_mem P_et _ _ hp₁_et Y₁.prop)
        let g₁ : Z_pb ⟶ Y₁ := MorphismProperty.Over.homMk (Limits.pullback.fst f₁.left f₂.left) rfl
        let g₂ : Z_pb ⟶ Y₂ := MorphismProperty.Over.homMk (Limits.pullback.snd f₁.left f₂.left)
          (by have hw₁ : f₁.left ≫ U.hom = Y₁.hom := MorphismProperty.Over.w f₁
              have hw₂ : f₂.left ≫ U.hom = Y₂.hom := MorphismProperty.Over.w f₂
              exact (congrArg (Limits.pullback.snd f₁.left f₂.left ≫ ·) hw₂.symm).trans
