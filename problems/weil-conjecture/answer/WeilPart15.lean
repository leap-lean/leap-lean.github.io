            ext f c
            change ((I.ρ g₀) f.1).1 (sec c) = f.1.1 (sec (c * QuotientGroup.mk g₀))
            have hmk : (QuotientGroup.mk (sec c * g₀) : G ⧸ N_sub) = c * QuotientGroup.mk g₀ := by
              rw [QuotientGroup.mk_mul, hsec_mk c]
            have heq := h_inv_sec f (sec c * g₀)
            rw [hmk] at heq
            exact heq.symm⟩
          inv := Rep.ofHom ⟨fromCQ_lin, fun q₀ => by
            refine _root_.Quotient.inductionOn' q₀ (fun g₀ => ?_)
            ext ψ g
            change ψ.1 (QuotientGroup.mk (g * g₀)) = ψ.1 (QuotientGroup.mk g * QuotientGroup.mk g₀)
            rw [QuotientGroup.mk_mul]⟩
          hom_inv_id := by
            apply hom_ext_rep
            intro f
            ext g
            exact h_inv_sec f g
          inv_hom_id := by
            apply hom_ext_rep
            intro ψ
            ext c
            change ψ.1 (QuotientGroup.mk (sec c)) = ψ.1 c
            rw [hsec_mk c] }
      have hIQ_zero : ∀ m : ℕ,
          CategoryTheory.Limits.IsZero (groupCohomology (I.quotientToInvariants N_sub) (m + 1)) := by
        intro m
        haveI : Subsingleton ↥B_Q :=
          ⟨fun ⟨x, hx⟩ ⟨y, hy⟩ => Subtype.ext ((Subgroup.mem_bot.mp hx).trans (Subgroup.mem_bot.mp hy).symm)⟩
        have hCQ : CategoryTheory.Limits.IsZero (groupCohomology C_Q (m + 1)) :=
          (isZero_groupCohomology_succ_of_subsingleton W₀ m).of_iso
            (groupCohomology.coindIso W₀ (m + 1))
        exact hCQ.of_iso ((groupCohomology.functor R₀ (G ⧸ N_sub) (m + 1)).mapIso e_IQ)
      let SC_N : CategoryTheory.ShortComplex (Rep R₀ ↥N_sub) := SC.map (Rep.resFunctor N_sub.subtype)
      have hSC_N : SC_N.ShortExact := rep_shortExact SC_N hα_inj hπ_surj hSC_ex_elem
      have hQN : ∀ i : ℕ, 1 ≤ i → Subsingleton ↥(groupCohomology (Rep.res N_sub.subtype Q) i) := by
        intro i hi
        obtain ⟨m, rfl⟩ : ∃ m : ℕ, m + 1 = i := ⟨i - 1, by omega⟩
        let S3 := groupCohomology.mapShortComplex₃ hSC_N (i := m + 1) (j := m + 2) rfl
        have hS3_ex : S3.Exact := groupCohomology.mapShortComplex₃_exact hSC_N rfl
        haveI : Subsingleton ↥S3.X₁ := ModuleCat.isZero_iff_subsingleton.mp (hIN_zero m)
        haveI : Subsingleton ↥S3.X₃ := hN' (m + 2) (by omega)
        refine ⟨fun a b => ?_⟩
        suffices h0 : ∀ x : ↥S3.X₂, x = 0 by rw [h0 a, h0 b]
        intro x
        have hx_ker : S3.g.hom x = 0 := Subsingleton.elim _ _
        obtain ⟨y, hy⟩ := (CategoryTheory.ShortComplex.moduleCat_exact_iff S3).mp hS3_ex x hx_ker
        have hy0 : y = 0 := Subsingleton.elim _ _
        rw [← hy, hy0, map_zero]
      let FQ := Rep.quotientToInvariantsFunctor R₀ N_sub
      have hFQ_zero : FQ.map α ≫ FQ.map π = 0 := by
        apply hom_ext_rep
        intro x
        apply Subtype.ext
        change π.hom (α.hom x.1) = 0
        exact (Submodule.Quotient.mk_eq_zero W_sub).mpr ⟨x.1, rfl⟩
      let SC_Q : CategoryTheory.ShortComplex (Rep R₀ (G ⧸ N_sub)) :=
        CategoryTheory.ShortComplex.mk (FQ.map α) (FQ.map π) hFQ_zero
      have hSC_Q_inj : Function.Injective ⇑SC_Q.f.hom := by
        intro u₁ u₂ hu
        apply Subtype.ext
        exact hα_inj (congrArg Subtype.val hu)
      have hSC_Q_ex : ∀ x : ↑SC_Q.X₂, SC_Q.g.hom x = 0 → ∃ y : ↑SC_Q.X₁, SC_Q.f.hom y = x := by
        intro x hx
        have hx0 : π.hom x.1 = 0 := congrArg Subtype.val hx
        obtain ⟨m, hm⟩ := hSC_ex_elem x.1 hx0
        have hm_inv : m ∈ Representation.invariants (MonoidHom.comp M'.ρ N_sub.subtype) := by
          intro g_n
          apply hα_inj
          have hcomm : α.hom ((M'.ρ g_n.1) m) = (I.ρ g_n.1) (α.hom m) := by
            ext g
            change (M'.ρ g) ((M'.ρ g_n.1) m) = (M'.ρ (g * g_n.1)) m
            rw [map_mul]
            rfl
          change α.hom ((M'.ρ g_n.1) m) = α.hom m
          rw [hcomm, hm]
          exact x.2 g_n
        exact ⟨⟨m, hm_inv⟩, Subtype.ext hm⟩
      have hSC_Q_surj : Function.Surjective ⇑SC_Q.g.hom := by
        intro q
        obtain ⟨x, hx⟩ := hπ_surj q.1
        have hdiff : ∀ g_n : ↥N_sub, ∃ m : ↑M', α.hom m = (I.ρ g_n.1) x - x := by
          intro g_n
          apply hSC_ex_elem
          change π.hom ((I.ρ g_n.1) x - x) = 0
          rw [map_sub]
          have hπ_eq : π.hom ((I.ρ g_n.1) x) = (Q.ρ g_n.1) (π.hom x) :=
            congrArg (fun f => f x) (π.hom.isIntertwining' g_n.1)
          have hqn : (Q.ρ g_n.1) q.1 = q.1 := q.2 g_n
          rw [hπ_eq, hx, hqn, sub_self]
        choose fn hfn using hdiff
        have hfn_coc : fn ∈ groupCohomology.cocycles₁ (Rep.res N_sub.subtype M') := by
          rw [groupCohomology.mem_cocycles₁_iff]
          intro n₁ n₂
          apply hα_inj
          rw [map_add]
          have hcomm : α.hom (((Rep.res N_sub.subtype M').ρ n₁) (fn n₂)) =
              (I.ρ n₁.1) (α.hom (fn n₂)) := by
            ext g
            change (M'.ρ g) ((M'.ρ n₁.1) (fn n₂)) = (M'.ρ (g * n₁.1)) (fn n₂)
            rw [map_mul]
            rfl
          rw [hcomm, hfn (n₁ * n₂), hfn n₂, hfn n₁, map_sub, Subgroup.coe_mul, map_mul]
          change (I.ρ n₁.1) ((I.ρ n₂.1) x) - x =
            ((I.ρ n₁.1) ((I.ρ n₂.1) x) - (I.ρ n₁.1) x) + ((I.ρ n₁.1) x - x)
          abel
        haveI : Subsingleton ↥(groupCohomology (Rep.res N_sub.subtype M') 1) := hN' 1 le_rfl
        let c_fn : ↥(groupCohomology.cocycles₁ (Rep.res N_sub.subtype M')) := ⟨fn, hfn_coc⟩
        have hπ1_zero :
            (CategoryTheory.ConcreteCategory.hom (groupCohomology.H1π (Rep.res N_sub.subtype M')))
              c_fn = 0 :=
          Subsingleton.elim _ _
        obtain ⟨m₀, hm₀⟩ := (groupCohomology.H1π_eq_zero_iff c_fn).mp hπ1_zero
        let x' : ↑I := x - α.hom m₀
        have hx'_inv : x' ∈ Representation.invariants (MonoidHom.comp I.ρ N_sub.subtype) := by
          intro g_n
          dsimp [x']
          have hcomm : (I.ρ g_n.1) (α.hom m₀) = α.hom ((M'.ρ g_n.1) m₀) := by
            ext g
            change (M'.ρ (g * g_n.1)) m₀ = (M'.ρ g) ((M'.ρ g_n.1) m₀)
            rw [map_mul]
            rfl
          have hm₀_n : (M'.ρ g_n.1) m₀ - m₀ = fn g_n := congrFun hm₀ g_n
          have hα_m₀ : α.hom ((M'.ρ g_n.1) m₀) - α.hom m₀ = (I.ρ g_n.1) x - x := by
            rw [← map_sub, hm₀_n, hfn g_n]
          rw [map_sub, hcomm]
          exact sub_eq_sub_iff_sub_eq_sub.mpr hα_m₀.symm
        refine ⟨⟨x', hx'_inv⟩, Subtype.ext ?_⟩
        change π.hom (x - α.hom m₀) = q.1
        have hα0 : π.hom (α.hom m₀) = 0 :=
          (Submodule.Quotient.mk_eq_zero W_sub).mpr ⟨m₀, rfl⟩
        rw [map_sub, hx, hα0, sub_zero]
      have hSC_Q : SC_Q.ShortExact := rep_shortExact SC_Q hSC_Q_inj hSC_Q_surj hSC_Q_ex
      have hQQ : ∀ j : ℕ, 1 ≤ j → Subsingleton ↥(groupCohomology (Q.quotientToInvariants N_sub) j) := by
        intro j hj
        obtain ⟨m, rfl⟩ : ∃ m : ℕ, m + 1 = j := ⟨j - 1, by omega⟩
        let S3 := groupCohomology.mapShortComplex₃ hSC_Q (i := m + 1) (j := m + 2) rfl
        have hS3_ex : S3.Exact := groupCohomology.mapShortComplex₃_exact hSC_Q rfl
        haveI : Subsingleton ↥S3.X₁ := ModuleCat.isZero_iff_subsingleton.mp (hIQ_zero m)
        haveI : Subsingleton ↥S3.X₃ := hQ' (m + 2) (by omega)
        refine ⟨fun a b => ?_⟩
        suffices h0 : ∀ x : ↥S3.X₂, x = 0 by rw [h0 a, h0 b]
        intro x
        have hx_ker : S3.g.hom x = 0 := Subsingleton.elim _ _
        obtain ⟨y, hy⟩ := (CategoryTheory.ShortComplex.moduleCat_exact_iff S3).mp hS3_ex x hx_ker
        have hy0 : y = 0 := Subsingleton.elim _ _
        rw [← hy, hy0, map_zero]
      have hQ_goal : CategoryTheory.Limits.IsZero (groupCohomology Q (idx_k + 1)) := ih Q hQN hQQ
      haveI : CategoryTheory.IsIso (groupCohomology.δ hSC (idx_k + 1) (idx_k + 2) rfl) :=
        groupCohomology.isIso_δ_of_isZero hSC (idx_k + 1) (hI_zero idx_k) (hI_zero (idx_k + 1))
      exact hQ_goal.of_iso (CategoryTheory.asIso (groupCohomology.δ hSC (idx_k + 1) (idx_k + 2) rfl)).symm
  
  have subsingleton_of_equiv : ∀ {R₀ G₁ G₂ : Type u} [CommRing R₀] [Group G₁] [Group G₂]
      (M₁ : Rep R₀ G₁) (M₂ : Rep R₀ G₂)
      (eG : G₁ ≃* G₂) (eV : ↑M₁ ≃ₗ[R₀] ↑M₂),
      (∀ (g : G₁) (v : ↑M₁), eV ((M₁.ρ g) v) = (M₂.ρ (eG g)) (eV v)) →
      ∀ (m : ℕ), Subsingleton ↥(groupCohomology M₂ m) → Subsingleton ↥(groupCohomology M₁ m) := by
    intro R₀ G₁ G₂ _ _ _ M₁ M₂ eG eV heq m hsub
    have map_eq_id : ∀ (f : G₁ →* G₁) (hf : ∀ g, f g = g)
        (θ : Rep.res f M₁ ⟶ M₁)
        (hθ : ∀ v : ↑M₁, θ.hom v = v),
        groupCohomology.map f θ m = CategoryTheory.CategoryStruct.id (groupCohomology M₁ m) := by
      intro f hf θ hθ
      have hf_id : f = MonoidHom.id G₁ := MonoidHom.ext hf
      subst hf_id
      have hθ_id : θ = CategoryTheory.CategoryStruct.id M₁ := by
        apply (CategoryTheory.forget₂ (Rep R₀ G₁) (ModuleCat R₀)).map_injective
        exact ModuleCat.hom_ext (LinearMap.ext hθ)
      rw [hθ_id, groupCohomology.map_id]
    let φ : Rep.res eG.toMonoidHom M₂ ⟶ M₁ :=
      Rep.ofHom ⟨eV.symm.toLinearMap, fun g => by
        ext w
        apply eV.injective
        change eV (eV.symm ((M₂.ρ (eG g)) w)) = eV ((M₁.ρ g) (eV.symm w))
        rw [eV.apply_symm_apply, heq, eV.apply_symm_apply]⟩
    let ψ : Rep.res eG.symm.toMonoidHom M₁ ⟶ M₂ :=
      Rep.ofHom ⟨eV.toLinearMap, fun h => by
        ext v
        simpa using heq (eG.symm h) v⟩
    let m₁ := groupCohomology.map eG.toMonoidHom φ m
    let m₂ := groupCohomology.map eG.symm.toMonoidHom ψ m
    have hm_comp : m₂ ≫ m₁ = CategoryTheory.CategoryStruct.id (groupCohomology M₁ m) := by
      rw [← groupCohomology.map_comp]
      exact map_eq_id _ eG.symm_apply_apply _ (fun v => by
        change eV.symm (eV v) = v
        exact eV.symm_apply_apply v)
    refine ⟨fun x y => ?_⟩
    have hmx : m₁.hom (m₂.hom x) = x := congrArg (fun fn => fn.hom x) hm_comp
    have hmy : m₁.hom (m₂.hom y) = y := congrArg (fun fn => fn.hom y) hm_comp
    rw [← hmx, ← hmy, Subsingleton.elim (m₂.hom x) (m₂.hom y)]
  have cores_annihilates_gen : ∀ {R₀ G₀ : Type u} [CommRing R₀] [Group G₀] [Fintype G₀]
      (M₀ : Rep R₀ G₀) (S : Subgroup G₀),
      Subsingleton ↥(groupCohomology (Rep.res S.subtype M₀) n) →
      ∀ c : ↥(groupCohomology M₀ n), S.index • c = 0 := by
    intro R₀ G₀ _ _ _ M₀ S hsub_S c
    let A_S := Rep.res S.subtype M₀
    let C_S := Rep.coind S.subtype A_S
    let α_lin : ↑M₀ →ₗ[R₀] ↑C_S :=
      { toFun := fun v =>
          ⟨fun g => (M₀.ρ g) v, fun s g => by
            change (M₀.ρ (s.1 * g)) v = (M₀.ρ s.1) ((M₀.ρ g) v)
            rw [map_mul]
            rfl⟩
        map_add' := fun v₁ v₂ => by ext g; exact map_add (M₀.ρ g) v₁ v₂
        map_smul' := fun r v => by ext g; exact LinearMap.map_smul (M₀.ρ g) r v }
    let α_S : M₀ ⟶ C_S := Rep.ofHom ⟨α_lin, fun g₀ => by
      ext v g
      change (M₀.ρ g) ((M₀.ρ g₀) v) = (M₀.ρ (g * g₀)) v
      rw [map_mul]
      rfl⟩
    let relS : Setoid G₀ :=
      { r := fun g₁ g₂ => ∃ s : ↥S, s.1 * g₂ = g₁
        iseqv :=
          { refl := fun g => ⟨1, one_mul g⟩
            symm := fun ⟨s, hs⟩ => ⟨s⁻¹, by rw [← hs, Subgroup.coe_inv, inv_mul_cancel_left]⟩
            trans := fun ⟨s₁, hs₁⟩ ⟨s₂, hs₂⟩ =>
              ⟨s₁ * s₂, by rw [Subgroup.coe_mul, mul_assoc, hs₂, hs₁]⟩ } }
    letI : DecidableRel relS.r := Classical.decRel _
    let e_coset : _root_.Quotient relS ≃ G₀ ⧸ S :=
      { toFun := _root_.Quotient.lift (fun g => (QuotientGroup.mk g⁻¹ : G₀ ⧸ S)) (by
          intro g₁ g₂ ⟨s, hs⟩
          rw [QuotientGroup.eq]
          change (g₁⁻¹)⁻¹ * g₂⁻¹ ∈ S
          rw [inv_inv, ← hs, mul_inv_cancel_right]
          exact s.2)
        invFun := _root_.Quotient.lift (fun g => (⟦g⁻¹⟧ : _root_.Quotient relS)) (by
          intro g₁ g₂ hrel
          apply _root_.Quotient.sound
          have hmem : g₁⁻¹ * g₂ ∈ S := QuotientGroup.leftRel_apply.mp hrel
          exact ⟨⟨g₁⁻¹ * g₂, hmem⟩, mul_inv_cancel_right g₁⁻¹ g₂⟩)
        left_inv := fun q => _root_.Quotient.inductionOn' q (fun g => by simp)
        right_inv := fun q => _root_.Quotient.inductionOn' q (fun g => by simp) }
    have hcard_coset : Fintype.card (_root_.Quotient relS) = S.index := by
      rw [Subgroup.index_eq_card, ← Nat.card_eq_fintype_card, Nat.card_congr e_coset]
    let term : ↑C_S → _root_.Quotient relS → ↑M₀ := fun f =>
      _root_.Quotient.lift (fun g => (M₀.ρ g⁻¹) (f.1 g)) (by
        intro g₁ g₂ ⟨s, hs⟩
        have hf_s : f.1 (s.1 * g₂) = (M₀.ρ s.1) (f.1 g₂) := f.2 s g₂
        rw [← hs, hf_s, mul_inv_rev, ← Module.End.mul_apply, ← map_mul, mul_assoc,
          inv_mul_cancel, mul_one])
    let β_lin : ↑C_S →ₗ[R₀] ↑M₀ :=
      { toFun := fun f => ∑ q : _root_.Quotient relS, term f q
        map_add' := fun f₁ f₂ => by
          rw [← Finset.sum_add_distrib]
          apply Finset.sum_congr rfl
          intro q _
          exact _root_.Quotient.inductionOn' q (fun g => map_add (M₀.ρ g⁻¹) (f₁.1 g) (f₂.1 g))
        map_smul' := fun r f => by
          dsimp
          rw [Finset.smul_sum]
          apply Finset.sum_congr rfl
          intro q _
          exact _root_.Quotient.inductionOn' q (fun g => LinearMap.map_smul (M₀.ρ g⁻¹) r (f.1 g)) }
    let β_S : C_S ⟶ M₀ := Rep.ofHom ⟨β_lin, fun g₀ => by
      ext f
      dsimp [β_lin]
      let perm_g₀ : _root_.Quotient relS ≃ _root_.Quotient relS :=
        { toFun := _root_.Quotient.lift (fun g => (⟦g * g₀⟧ : _root_.Quotient relS)) (by
            intro g₁ g₂ ⟨s, hs⟩
            apply _root_.Quotient.sound
            exact ⟨s, by rw [← mul_assoc, hs]⟩)
          invFun := _root_.Quotient.lift (fun g => (⟦g * g₀⁻¹⟧ : _root_.Quotient relS)) (by
            intro g₁ g₂ ⟨s, hs⟩
            apply _root_.Quotient.sound
            exact ⟨s, by rw [← mul_assoc, hs]⟩)
          left_inv := fun q => _root_.Quotient.inductionOn' q (fun g => by simp [mul_assoc])
          right_inv := fun q => _root_.Quotient.inductionOn' q (fun g => by simp [mul_assoc]) }
      rw [map_sum]
      symm
      rw [← Equiv.sum_comp perm_g₀]
      apply Finset.sum_congr rfl
      intro q _
      refine _root_.Quotient.inductionOn' q (fun g => ?_)
      change (M₀.ρ g₀) ((M₀.ρ (g * g₀)⁻¹) (f.1 (g * g₀))) = (M₀.ρ g⁻¹) (f.1 (g * g₀))
      rw [← Module.End.mul_apply, ← map_mul, mul_inv_rev, ← mul_assoc, mul_inv_cancel, one_mul]⟩
    have hcomp_idx : α_S ≫ β_S = S.index • CategoryTheory.CategoryStruct.id M₀ := by
      apply (CategoryTheory.forget₂ (Rep R₀ G₀) (ModuleCat R₀)).map_injective
      apply ModuleCat.hom_ext
      ext v
      change (∑ q : _root_.Quotient relS, term (α_lin v) q) = S.index • v
      have hterm_v : ∀ q : _root_.Quotient relS, term (α_lin v) q = v := by
        intro q
        refine _root_.Quotient.inductionOn' q (fun g => ?_)
        change (M₀.ρ g⁻¹) ((M₀.ρ g) v) = v
        rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one, Module.End.one_apply]
      simp_rw [hterm_v]
      rw [Finset.sum_const, Finset.card_univ, hcard_coset]
    have hFn_comp :
        ((groupCohomology.cochainsFunctor R₀ G₀ ⋙
            HomologicalComplex.homologyFunctor (ModuleCat R₀) (ComplexShape.up ℕ) n).map α_S) ≫
          ((groupCohomology.cochainsFunctor R₀ G₀ ⋙
            HomologicalComplex.homologyFunctor (ModuleCat R₀) (ComplexShape.up ℕ) n).map β_S) =
        S.index • CategoryTheory.CategoryStruct.id
          ((groupCohomology.cochainsFunctor R₀ G₀ ⋙
            HomologicalComplex.homologyFunctor (ModuleCat R₀) (ComplexShape.up ℕ) n).obj M₀) := by
      rw [← (groupCohomology.cochainsFunctor R₀ G₀ ⋙
          HomologicalComplex.homologyFunctor (ModuleCat R₀) (ComplexShape.up ℕ) n).map_comp,
        hcomp_idx, CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    have hSub_CS : Subsingleton ↥(groupCohomology C_S n) := by
      have hZero_AS : CategoryTheory.Limits.IsZero (groupCohomology A_S n) :=
        ModuleCat.isZero_iff_subsingleton.mpr hsub_S
      exact ModuleCat.isZero_iff_subsingleton.mp
        (hZero_AS.of_iso (groupCohomology.coindIso A_S n))
    haveI : Subsingleton
        ↥((groupCohomology.cochainsFunctor R₀ G₀ ⋙
          HomologicalComplex.homologyFunctor (ModuleCat R₀) (ComplexShape.up ℕ) n).obj C_S) :=
      show Subsingleton ↥(groupCohomology C_S n) from hSub_CS
    let c' : ↥((groupCohomology.cochainsFunctor R₀ G₀ ⋙
        HomologicalComplex.homologyFunctor (ModuleCat R₀) (ComplexShape.up ℕ) n).obj M₀) := c
    have hαc : ((groupCohomology.cochainsFunctor R₀ G₀ ⋙
        HomologicalComplex.homologyFunctor (ModuleCat R₀) (ComplexShape.up ℕ) n).map α_S).hom c' = 0 :=
      Subsingleton.elim _ _
    have hidx := congrArg (fun fn => fn.hom c') hFn_comp
    change ((groupCohomology.cochainsFunctor R₀ G₀ ⋙
        HomologicalComplex.homologyFunctor (ModuleCat R₀) (ComplexShape.up ℕ) n).map β_S).hom
        (((groupCohomology.cochainsFunctor R₀ G₀ ⋙
          HomologicalComplex.homologyFunctor (ModuleCat R₀) (ComplexShape.up ℕ) n).map α_S).hom c') =
        S.index • c at hidx
    rw [hαc, map_zero] at hidx
    exact hidx.symm
  let K₀ := FractionRing (Polynomial k)
  let R := ULift.{u} ℤ
  have res_subsingleton : ∀ {F' L' : Type u} [Field F'] [Field L']
      [Algebra F' L'] [FiniteDimensional F' L'] [IsGalois F' L']
      (H : Subgroup Gal(L'/F')) (m : ℕ),
      Subsingleton ↥(groupCohomology (weilGalUnitsRep ↥(IntermediateField.fixedField H) L') m) →
      Subsingleton ↥(groupCohomology (Rep.res H.subtype (weilGalUnitsRep F' L')) m) := by
    intro F' L' _ _ _ _ _ H m hsub
    let F'' := IntermediateField.fixedField H
    let eH : ↥H ≃* Gal(L'/↥F'') :=
      (MulEquiv.subgroupCongr (IntermediateField.fixingSubgroup_fixedField H).symm).trans
        (IntermediateField.fixingSubgroupEquiv F'')
    exact @subsingleton_of_equiv R _ _ _ _ _
      (Rep.res H.subtype (weilGalUnitsRep F' L'))
      (weilGalUnitsRep ↥F'' L')
      eH (LinearEquiv.refl R (Additive (L')ˣ))
      (fun _ _ => rfl) m hsub
  have quot_subsingleton : ∀ {F' L' : Type u} [Field F'] [Field L']
      [Algebra F' L'] [FiniteDimensional F' L'] [IsGalois F' L']
      (H : Subgroup Gal(L'/F')) [H.Normal] (m : ℕ),
      Subsingleton ↥(groupCohomology (weilGalUnitsRep F' ↥(IntermediateField.fixedField H)) m) →
      Subsingleton ↥(groupCohomology ((weilGalUnitsRep F' L').quotientToInvariants H) m) := by
    intro F' L' _ _ _ _ _ H _ m hsub
    let F'' := IntermediateField.fixedField H
    let M₁ := (weilGalUnitsRep F' L').quotientToInvariants H
    let M₂ := weilGalUnitsRep F' ↥F''
    let eQ : Gal(L'/F') ⧸ H ≃* Gal(↥F''/F') := IsGalois.normalAutEquivQuotient H
    have hu_mem : ∀ y : ↑M₁, (Additive.toMul (y.1 : Additive (L')ˣ)).val ∈ F'' := by
      intro y
      rw [IntermediateField.mem_fixedField_iff]
      intro h hh
      have hy := y.2 ⟨h, hh⟩
      exact congrArg (fun z : Additive (L')ˣ => (Additive.toMul z).val) hy
    let toF''_mul : ↑M₁ → (↥F'')ˣ := fun y =>
      let u : (L')ˣ := Additive.toMul (y.1 : Additive (L')ˣ)
      have hu : u.val ∈ F'' := hu_mem y
      have hu_inv : (u⁻¹).val ∈ F'' := by
        have h1 : (u⁻¹).val = (u.val)⁻¹ := Units.val_inv_eq_inv_val u
        rw [h1]
        exact F''.inv_mem hu
      ⟨⟨u.val, hu⟩, ⟨(u⁻¹).val, hu_inv⟩, Subtype.ext u.val_inv, Subtype.ext u.inv_val⟩
    let fromF''_mul : (↥F'')ˣ → ↑M₁ := fun v =>
      ⟨(Additive.ofMul (Units.map (algebraMap ↥F'' L').toMonoidHom v) : Additive (L')ˣ),
       fun h => by
        change (Additive.ofMul (Units.map h.1.toRingHom.toMonoidHom
          (Units.map (algebraMap ↥F'' L').toMonoidHom v)) : Additive (L')ˣ) = _
        congr 1
        ext
        exact (IntermediateField.mem_fixedField_iff H _).mp v.val.2 h.1 h.2⟩
    have hto_add : ∀ x y : ↑M₁, toF''_mul (x + y) = toF''_mul x * toF''_mul y := by
      intro x y
      ext
      rfl
    let eV : @LinearEquiv R R _ _ (RingHom.id R) (RingHom.id R) _ _
        M₁.V M₂.V M₁.hV1.toAddCommMonoid M₂.hV1.toAddCommMonoid M₁.hV2 M₂.hV2 :=
      @LinearEquiv.mk R R _ _ (RingHom.id R) (RingHom.id R) _ _
        M₁.V M₂.V M₁.hV1.toAddCommMonoid M₂.hV1.toAddCommMonoid M₁.hV2 M₂.hV2
        (@LinearMap.mk R R _ _ (RingHom.id R) M₁.V M₂.V
          M₁.hV1.toAddCommMonoid M₂.hV1.toAddCommMonoid M₁.hV2 M₂.hV2
          { toFun := fun y => (Additive.ofMul (toF''_mul y) : Additive (↥F'')ˣ)
            map_add' := fun x y => by
              change Additive.ofMul (toF''_mul (x + y)) =
                Additive.ofMul (toF''_mul x) + Additive.ofMul (toF''_mul y)
              rw [hto_add, ofMul_mul] }
          (fun r y => by
            let toAddHom : ↑M₁ →+ Additive (↥F'')ˣ :=
              { toFun := fun z => Additive.ofMul (toF''_mul z)
                map_zero' := by
                  change Additive.ofMul (toF''_mul 0) = 0
                  have h0 : toF''_mul 0 = 1 := by ext; rfl
                  rw [h0, ofMul_one]
                map_add' := fun x y => by
                  change Additive.ofMul (toF''_mul (x + y)) = _
                  rw [hto_add, ofMul_mul] }
            exact map_zsmul toAddHom r.down y))
        (fun w => fromF''_mul (Additive.toMul (w : Additive (↥F'')ˣ)))
        (fun y => by ext1; rfl)
        (fun w => by
          have h1 : toF''_mul (fromF''_mul (Additive.toMul (w : Additive (↥F'')ˣ))) =
              Additive.toMul (w : Additive (↥F'')ˣ) := by
            ext
            rfl
          exact congrArg (fun u => (Additive.ofMul u : Additive (↥F'')ˣ)) h1)
    refine @subsingleton_of_equiv R _ _ _ _ _ M₁ M₂ eQ eV (fun q y => ?_) m hsub
    refine _root_.Quotient.inductionOn' q (fun σ => ?_)
    change (Additive.ofMul (toF''_mul ((M₁.ρ (QuotientGroup.mk σ)) y)) : Additive (↥F'')ˣ) =
      (Additive.ofMul (Units.map (eQ (QuotientGroup.mk σ)).toRingHom.toMonoidHom (toF''_mul y)) :
        Additive (↥F'')ˣ)
    congr 1
    ext
    change σ (Additive.toMul (y.1 : Additive (L')ˣ)).val =
      ((eQ (QuotientGroup.mk σ)) ⟨(Additive.toMul (y.1 : Additive (L')ˣ)).val, hu_mem y⟩ : L')
    dsimp [eQ]
    rw [IsGalois.normalAutEquivQuotient_apply]
    exact (AlgEquiv.restrictNormal_commutes σ ↥F''
      ⟨(Additive.toMul (y.1 : Additive (L')ˣ)).val, hu_mem y⟩).symm
  have pGroup_vanishing : ∀ (p : ℕ) [Fact (Nat.Prime p)] (c : ℕ)
      (F' L' : Type u) [Field F'] [Field L']
      [Algebra K₀ F'] [FiniteDimensional K₀ F']
      [Algebra F' L'] [FiniteDimensional F' L'] [IsGalois F' L'],
      IsPGroup p Gal(L'/F') → Nat.card Gal(L'/F') = c →
      ∀ (m : ℕ), 1 ≤ m → Subsingleton ↥(groupCohomology (weilGalUnitsRep F' L') m) := by
    intro p hp_fact c
    induction c using Nat.strong_induction_on with
    | h c ih =>
      intro F' L' _ _ _ _ _ _ _ hPG hc m hm
      by_cases hc_le : c ≤ 1
      · haveI : Subsingleton Gal(L'/F') := by
          rw [← Finite.card_le_one_iff_subsingleton, hc]
          exact hc_le
        obtain ⟨idx_k, rfl⟩ : ∃ idx_k : ℕ, idx_k + 1 = m := ⟨m - 1, by omega⟩
        exact ModuleCat.isZero_iff_subsingleton.mp
          (isZero_groupCohomology_succ_of_subsingleton (weilGalUnitsRep F' L') idx_k)
      · have hc_gt : 1 < Nat.card Gal(L'/F') := by omega
        haveI : Nontrivial Gal(L'/F') := Finite.one_lt_card_iff_nontrivial.mp hc_gt
        let Z_G := Subgroup.center Gal(L'/F')
        haveI : Nontrivial ↥Z_G := hPG.center_nontrivial
        have hPZ : IsPGroup p ↥Z_G := hPG.to_subgroup Z_G
        obtain ⟨k_exp, hk_exp⟩ := IsPGroup.iff_card.mp hPZ
        have hk_ne : k_exp ≠ 0 := by
          rintro rfl
          have hgt : 1 < Nat.card ↥Z_G := Finite.one_lt_card
          rw [hk_exp, pow_zero] at hgt
          omega
        have hdvd_Z : p ∣ Fintype.card ↥Z_G := by
          rw [← Nat.card_eq_fintype_card, hk_exp]
          exact dvd_pow_self p hk_ne
        obtain ⟨z, hz_ord⟩ := exists_prime_orderOf_dvd_card p hdvd_Z
        let N_sub : Subgroup Gal(L'/F') := Subgroup.zpowers z.1
        haveI hN_norm : N_sub.Normal := by
          refine ⟨fun g_n hgn g => ?_⟩
          obtain ⟨a, rfl⟩ := Subgroup.mem_zpowers_iff.mp hgn
          refine Subgroup.mem_zpowers_iff.mpr ⟨a, ?_⟩
          have hconj_z : (MulAut.conj g) z.1 = z.1 := by
            change g * z.1 * g⁻¹ = z.1
            rw [Subgroup.mem_center_iff.mp z.2 g, mul_inv_cancel_right]
          symm
          change ((MulAut.conj g) (z.1 ^ a) : Gal(L'/F')) = z.1 ^ a
          rw [map_zpow, hconj_z]
        let F'' := IntermediateField.fixedField N_sub
        letI : Algebra K₀ ↥F'' :=
          RingHom.toAlgebra ((algebraMap F' ↥F'').comp (algebraMap K₀ F'))
        letI : IsScalarTower K₀ F' ↥F'' := IsScalarTower.of_algebraMap_eq' rfl
        haveI : FiniteDimensional K₀ ↥F'' := Module.Finite.trans F' ↥F''
        haveI : IsGalois F' ↥F'' := IsGalois.of_fixedField_normal_subgroup N_sub
        let eN : ↥N_sub ≃* Gal(L'/↥F'') :=
          (MulEquiv.subgroupCongr (IntermediateField.fixingSubgroup_fixedField N_sub).symm).trans
            (IntermediateField.fixingSubgroupEquiv F'')
        haveI : IsCyclic Gal(L'/↥F'') := by
          refine ⟨⟨eN ⟨z.1, Subgroup.mem_zpowers z.1⟩, fun σ => ?_⟩⟩
          obtain ⟨⟨x, hx⟩, rfl⟩ := eN.surjective σ
          obtain ⟨a, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
          refine Subgroup.mem_zpowers_iff.mpr ⟨a, ?_⟩
          have hpow : (⟨z.1 ^ a, hx⟩ : ↥N_sub) = ⟨z.1, Subgroup.mem_zpowers z.1⟩ ^ a := rfl
          rw [hpow, map_zpow]
        have hN_van : ∀ i : ℕ, 1 ≤ i →
            Subsingleton ↥(groupCohomology (Rep.res N_sub.subtype (weilGalUnitsRep F' L')) i) :=
          fun i hi => res_subsingleton N_sub i (hCyc_k ↥F'' L' i hi)
        let eQ : Gal(L'/F') ⧸ N_sub ≃* Gal(↥F''/F') := IsGalois.normalAutEquivQuotient N_sub
        have hcard_N : Nat.card ↥N_sub = p := by
          rw [Nat.card_zpowers, Subgroup.orderOf_coe z, hz_ord]
        have hcard_prod : Nat.card Gal(L'/F') = Nat.card (Gal(L'/F') ⧸ N_sub) * Nat.card ↥N_sub :=
          Subgroup.card_eq_card_quotient_mul_card_subgroup N_sub
        have hcard_Q : Nat.card Gal(↥F''/F') = Nat.card (Gal(L'/F') ⧸ N_sub) :=
          Nat.card_congr eQ.symm.toEquiv
        have hcard_lt : Nat.card Gal(↥F''/F') < c := by
          have hp2 : 2 ≤ p := hp_fact.out.two_le
          have hpos_Q : 0 < Nat.card (Gal(L'/F') ⧸ N_sub) := Nat.card_pos
          rw [hcard_Q, ← hc, hcard_prod, hcard_N]
          nlinarith
        have hPG_Q : IsPGroup p Gal(↥F''/F') :=
          (hPG.to_quotient N_sub).of_surjective eQ.toMonoidHom eQ.surjective
        have hQ_van : ∀ j : ℕ, 1 ≤ j →
            Subsingleton ↥(groupCohomology ((weilGalUnitsRep F' L').quotientToInvariants N_sub) j) :=
          fun j hj => quot_subsingleton N_sub j
            (ih (Nat.card Gal(↥F''/F')) hcard_lt F' ↥F'' hPG_Q rfl j hj)
        exact s5_lhs_gen R Gal(L'/F') N_sub (weilGalUnitsRep F' L') hN_van hQ_van m hm
  let G := Gal(L/E)
  let M := weilGalUnitsRep E L
  refine ⟨fun c₁ c₂ => ?_⟩
  suffices h0 : ∀ c : ↥(groupCohomology M n), c = 0 by rw [h0 c₁, h0 c₂]
  intro c
  have hbot_sub : Subsingleton ↥(groupCohomology (Rep.res (⊥ : Subgroup G).subtype M) n) := by
    haveI : Subsingleton ↥(⊥ : Subgroup G) :=
      ⟨fun ⟨x, hx⟩ ⟨y, hy⟩ => Subtype.ext ((Subgroup.mem_bot.mp hx).trans (Subgroup.mem_bot.mp hy).symm)⟩
    obtain ⟨idx_k, rfl⟩ : ∃ idx_k : ℕ, idx_k + 1 = n := ⟨n - 1, by omega⟩
    exact ModuleCat.isZero_iff_subsingleton.mp
      (isZero_groupCohomology_succ_of_subsingleton (Rep.res (⊥ : Subgroup G).subtype M) idx_k)
  have hcard_c : Nat.card G • c = 0 := by
    have h1 := @cores_annihilates_gen R G _ _ _ M ⊥ hbot_sub c
    rwa [Subgroup.index_bot] at h1
  let d_ord := addOrderOf c
  have hd_dvd_G : d_ord ∣ Nat.card G := addOrderOf_dvd_of_nsmul_eq_zero hcard_c
  have hd_pos : 0 < d_ord := Nat.pos_of_dvd_of_pos hd_dvd_G Nat.card_pos
  have hd_eq_1 : d_ord = 1 := by
    by_contra hd_ne
    let p := Nat.minFac d_ord
    have hp_prime : Nat.Prime p := Nat.minFac_prime hd_ne
    letI : Fact (Nat.Prime p) := ⟨hp_prime⟩
    have hp_dvd_d : p ∣ d_ord := Nat.minFac_dvd d_ord
    let P_syl : Sylow p G := Classical.arbitrary (Sylow p G)
    let F_P := IntermediateField.fixedField (P_syl : Subgroup G)
    letI : Algebra K₀ ↥F_P :=
      RingHom.toAlgebra ((algebraMap E ↥F_P).comp (algebraMap K₀ E))
    letI : IsScalarTower K₀ E ↥F_P := IsScalarTower.of_algebraMap_eq' rfl
    haveI : FiniteDimensional K₀ ↥F_P := Module.Finite.trans E ↥F_P
    let eP : ↥(P_syl : Subgroup G) ≃* Gal(L/↥F_P) :=
      (MulEquiv.subgroupCongr (IntermediateField.fixingSubgroup_fixedField (P_syl : Subgroup G)).symm).trans
        (IntermediateField.fixingSubgroupEquiv F_P)
    have hPG_P : IsPGroup p Gal(L/↥F_P) :=
      P_syl.isPGroup'.of_surjective eP.toMonoidHom eP.surjective
    have hP_sub : Subsingleton ↥(groupCohomology (Rep.res (P_syl : Subgroup G).subtype M) n) :=
      res_subsingleton (P_syl : Subgroup G) n
        (pGroup_vanishing p (Nat.card Gal(L/↥F_P)) ↥F_P L hPG_P rfl n hn)
    have hP_idx_c : (P_syl : Subgroup G).index • c = 0 :=
      @cores_annihilates_gen R G _ _ _ M (P_syl : Subgroup G) hP_sub c
    have hd_dvd_idx : d_ord ∣ (P_syl : Subgroup G).index :=
      addOrderOf_dvd_of_nsmul_eq_zero hP_idx_c
    exact P_syl.not_dvd_index (dvd_trans hp_dvd_d hd_dvd_idx)
  simpa using ((addOrderOf_eq_iff zero_lt_one).mp hd_eq_1).1

theorem weil_smooth_curve_functionField_finite_over_ratFunc (k : Type u) [Field k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom] :
    letI : IrreducibleSpace ↥C.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C.left
    ∃ ψ₀ : FractionRing (Polynomial k) →+* ↑C.left.functionField,
      letI : Algebra (FractionRing (Polynomial k)) (↑C.left.functionField) := ψ₀.toAlgebra
      FiniteDimensional (FractionRing (Polynomial k)) (↑C.left.functionField) :=
by
  letI : IrreducibleSpace ↥C.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C.left
  obtain ⟨x₀⟩ : Nonempty ↥C.left := AlgebraicGeometry.IsIntegral.nonempty
  obtain ⟨U_k, hU_k, V, hV, hx₀, e, h_std⟩ :=
    (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 C.hom).mp inferInstance x₀
  let B_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let R₀ := ↑(B_k.presheaf.obj (Opposite.op U_k))
  let S := ↑(C.left.presheaf.obj (Opposite.op V))
  obtain ⟨g_mv, -, hg_mv⟩ := h_std.exists_etale_mvPolynomial
  have hy₀ : C.hom.base x₀ ∈ U_k := e hx₀
  have hU_top : U_k = ⊤ := by
    rw [_root_.eq_top_iff]
    intro p _
    rw [Subsingleton.elim p (C.hom.base x₀)]
    exact hy₀
  let iso_k : CommRingCat.of k ≅ B_k.presheaf.obj (Opposite.op U_k) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm ≪≫
      B_k.presheaf.mapIso (CategoryTheory.eqToIso hU_top).op
  let e_k : k ≃+* R₀ := iso_k.commRingCatIsoToRingEquiv
  let P_k := Polynomial k
  let e_poly : P_k ≃+* MvPolynomial (Fin 1) R₀ :=
    (Polynomial.mapEquiv e_k).trans
      ((Polynomial.mapEquiv (MvPolynomial.isEmptyRingEquiv R₀ (Fin 0)).symm).trans
        (MvPolynomial.finSuccEquiv R₀ 0).symm.toRingEquiv)
  let g : P_k →+* S := g_mv.comp e_poly.toRingHom
  have he_et : e_poly.toRingHom.Etale := RingHom.Etale.of_bijective e_poly.bijective
  have hg_et : g.Etale := RingHom.Etale.stableUnderComposition e_poly.toRingHom g_mv he_et hg_mv
  letI : Algebra P_k S := g.toAlgebra
  haveI : Algebra.Etale P_k S := (RingHom.etale_algebraMap (R := P_k) (S := S)).mp hg_et
  haveI : Nonempty ↥(V : AlgebraicGeometry.Scheme) := ⟨⟨x₀, hx₀⟩⟩
  haveI : IsDomain S := AlgebraicGeometry.IsIntegral.component_integral V
  let K := ↑C.left.functionField
  haveI : IsFractionRing S K :=
    AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen C.left V hV
  haveI : Module.IsTorsionFree P_k S := Module.Flat.isTorsionFree
  haveI : FaithfulSMul P_k S := Module.IsTorsionFree.to_faithfulSMul
  have hg_inj : Function.Injective g :=
    (faithfulSMul_iff_algebraMap_injective P_k S).mp inferInstance
  let φ_S : S →+* K := algebraMap S K
  have hφ_inj : Function.Injective φ_S := IsFractionRing.injective S K
  let K₀ := FractionRing P_k
  let f_PK : P_k →+* K := φ_S.comp g
  have h_unit : ∀ y : ↥(nonZeroDivisors P_k), IsUnit (f_PK y) := by
    intro y
    apply IsUnit.mk0
    intro h0
    apply mem_nonZeroDivisors_iff_ne_zero.mp y.2
    apply hg_inj
    rw [map_zero]
    apply hφ_inj
    rw [map_zero]
    exact h0
  let ψ₀ : K₀ →+* K := IsLocalization.lift h_unit
  refine ⟨ψ₀, ?_⟩
  letI : Algebra K₀ K := ψ₀.toAlgebra
  letI : Algebra P_k K := f_PK.toAlgebra
  haveI : IsScalarTower P_k K₀ K :=
    IsScalarTower.of_algebraMap_eq fun p => (IsLocalization.lift_eq h_unit p).symm
  let T := TensorProduct P_k K₀ S
  haveI : Algebra.Etale K₀ T := Algebra.Etale.baseChange P_k S K₀
  haveI : FiniteDimensional K₀ T := by
    obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hAi⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K₀ T).mp inferInstance
    letI : Finite I := hFinI
    letI : ∀ i, Field (Ai i) := hFieldAi
    letI : ∀ i, Algebra K₀ (Ai i) := hAlgAi
    haveI : ∀ i, Module.Finite K₀ (Ai i) := fun i => (hAi i).1
    exact Module.Finite.equiv e_prod.symm.toLinearEquiv
  let T' := TensorProduct P_k S K₀
  let M_S := Algebra.algebraMapSubmonoid S (nonZeroDivisors P_k)
  haveI : IsLocalization M_S T' := IsLocalization.tensor (S := S) K₀ (nonZeroDivisors P_k)
  have hM_S : M_S ≤ nonZeroDivisors S := by
    rintro s ⟨p, hp, rfl⟩
    apply mem_nonZeroDivisors_of_ne_zero
    intro hs0
    apply mem_nonZeroDivisors_iff_ne_zero.mp hp
    apply hg_inj
    rw [map_zero]
    exact hs0
  haveI : IsDomain T' := IsLocalization.isDomain_of_le_nonZeroDivisors T' hM_S
  haveI : IsDomain T :=
    MulEquiv.isDomain T' (Algebra.TensorProduct.comm P_k K₀ S).toRingEquiv.toMulEquiv
  let φ_alg : S →ₐ[P_k] K :=
    { φ_S with commutes' := fun _ => rfl }
  let μ : T →ₐ[K₀] K :=
    Algebra.TensorProduct.lift (Algebra.ofId K₀ K) φ_alg (fun _ _ => Commute.all _ _)
  have hμ_inj : Function.Injective μ := by
    rw [_root_.injective_iff_map_eq_zero]
    intro z hz0
    by_contra hz
    obtain ⟨w, hzw⟩ := FiniteDimensional.exists_mul_eq_one K₀ hz
    have h1 : (1 : K) = 0 := by
      calc
        (1 : K) = μ 1 := (map_one μ).symm
        _ = μ (z * w) := by rw [hzw]
        _ = μ z * μ w := map_mul μ z w
        _ = 0 * μ w := by rw [hz0]
        _ = 0 := zero_mul _
    exact one_ne_zero h1
  have hμ_surj : Function.Surjective μ := by
    intro y
    obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective S y
    let z_b : T := (1 : K₀) ⊗ₜ[P_k] b
    have hμ_zb : μ z_b = φ_S b := by
      dsimp [μ, z_b]
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
    have hφb_ne : φ_S b ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
    have hzb_ne : z_b ≠ 0 := by
      intro h0
      apply hφb_ne
      rw [← hμ_zb, h0, map_zero]
    obtain ⟨w, hzw⟩ := FiniteDimensional.exists_mul_eq_one K₀ hzb_ne
    have hμw : μ w = (φ_S b)⁻¹ := by
      apply eq_inv_of_mul_eq_one_right
      calc
        φ_S b * μ w = μ z_b * μ w := by rw [hμ_zb]
        _ = μ (z_b * w) := (map_mul μ z_b w).symm
        _ = μ 1 := by rw [hzw]
        _ = 1 := map_one μ
    refine ⟨((1 : K₀) ⊗ₜ[P_k] a) * w, ?_⟩
    have hμ_za : μ ((1 : K₀) ⊗ₜ[P_k] a) = φ_S a := by
      dsimp [μ]
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
    rw [map_mul, hμ_za, hμw, ← div_eq_mul_inv]
    exact hab
  let e_μ : T ≃ₐ[K₀] K := AlgEquiv.ofBijective μ ⟨hμ_inj, hμ_surj⟩
  exact Module.Finite.equiv e_μ.toLinearEquiv

theorem weil_etale_generic_fiber_affine_copower_package (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral X] [X.IsSeparated]
    (U W : X.Etale) [CompactSpace ↥U.left] [U.left.IsSeparated]
    [AlgebraicGeometry.IsAffine W.left]
