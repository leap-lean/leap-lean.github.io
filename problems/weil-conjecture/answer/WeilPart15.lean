  have hSelfTensorEval : ∀ (A₁ A₂ : Type u) [CommRing A₁] [CommRing A₂]
      (ψ₁ : k →+* A₁),
      letI : Algebra k A₁ := ψ₁.toAlgebra
      ∀ (ι₁ ι₂ : A₁ →+* A₂) (θ : TensorProduct k A₁ A₁ ≃+* A₂)
        (ev₁ ev₂ : A₁ →+* k) (𝔭 : Ideal A₂),
        (∀ a : A₁, θ (a ⊗ₜ[k] (1 : A₁)) = ι₁ a) →
        (∀ b : A₁, θ ((1 : A₁) ⊗ₜ[k] b) = ι₂ b) →
        𝔭.IsPrime →
        ev₁.comp ψ₁ = RingHom.id k →
        ev₂.comp ψ₁ = RingHom.id k →
        Ideal.comap ι₁ 𝔭 = RingHom.ker ev₁ →
        Ideal.comap ι₂ 𝔭 = RingHom.ker ev₂ →
        ∃ ev_w : A₂ →+* k,
          ev_w.comp (ι₁.comp ψ₁) = RingHom.id k ∧
          ev_w.comp ι₁ = ev₁ ∧
          ev_w.comp ι₂ = ev₂ ∧
          RingHom.ker ev_w = 𝔭 := by
    intro A₁ A₂ _ _ ψ₁
    let _ : Algebra k A₁ := ψ₁.toAlgebra
    intro ι₁ ι₂ θ ev₁ ev₂ 𝔭 hθ₁ hθ₂ h𝔭 hev₁_id hev₂_id hcomap₁ hcomap₂
    let ev₁_alg : A₁ →ₐ[k] k :=
      { ev₁ with commutes' := fun c => congrArg (fun g : k →+* k => g c) hev₁_id }
    let ev₂_alg : A₁ →ₐ[k] k :=
      { ev₂ with commutes' := fun c => congrArg (fun g : k →+* k => g c) hev₂_id }
    let ev_tp : TensorProduct k A₁ A₁ →ₐ[k] k :=
      Algebra.TensorProduct.productMap ev₁_alg ev₂_alg
    let ev_w : A₂ →+* k := ev_tp.toRingHom.comp θ.symm.toRingHom
    let ψ₂ : k →+* A₂ := ι₁.comp ψ₁
    have hevw_ι₁ : ev_w.comp ι₁ = ev₁ := by
      ext a
      change ev_tp (θ.symm (ι₁ a)) = ev₁ a
      rw [← hθ₁ a, θ.symm_apply_apply]
      change ev₁ a * ev₂ 1 = ev₁ a
      rw [map_one, mul_one]
    have hevw_ι₂ : ev_w.comp ι₂ = ev₂ := by
      ext b
      change ev_tp (θ.symm (ι₂ b)) = ev₂ b
      rw [← hθ₂ b, θ.symm_apply_apply]
      change ev₁ 1 * ev₂ b = ev₂ b
      rw [map_one, one_mul]
    have hevw_id : ev_w.comp ψ₂ = RingHom.id k := by
      rw [← RingHom.comp_assoc, hevw_ι₁, hev₁_id]
    have hι₂_ψ : ι₂.comp ψ₁ = ψ₂ := by
      ext c
      have hc : ψ₁ c = c • (1 : A₁) := by
        change algebraMap k A₁ c = c • (1 : A₁)
        rw [Algebra.smul_def, mul_one]
      change ι₂ (ψ₁ c) = ι₁ (ψ₁ c)
      rw [hc, ← hθ₂, ← hθ₁, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
    have hmem₁ : ∀ a : A₁, ι₁ a - ψ₂ (ev₁ a) ∈ 𝔭 := by
      intro a
      have ha : a - ψ₁ (ev₁ a) ∈ Ideal.comap ι₁ 𝔭 := by
        rw [hcomap₁, RingHom.mem_ker, map_sub]
        have hc : ev₁ (ψ₁ (ev₁ a)) = ev₁ a := congrArg (fun g : k →+* k => g (ev₁ a)) hev₁_id
        rw [hc, sub_self]
      simpa [ψ₂, map_sub] using ha
    have hmem₂ : ∀ b : A₁, ι₂ b - ψ₂ (ev₂ b) ∈ 𝔭 := by
      intro b
      have hb : b - ψ₁ (ev₂ b) ∈ Ideal.comap ι₂ 𝔭 := by
        rw [hcomap₂, RingHom.mem_ker, map_sub]
        have hc : ev₂ (ψ₁ (ev₂ b)) = ev₂ b := congrArg (fun g : k →+* k => g (ev₂ b)) hev₂_id
        rw [hc, sub_self]
      have hψ₂_eq : ι₂ (ψ₁ (ev₂ b)) = ψ₂ (ev₂ b) :=
        congrArg (fun g : k →+* A₂ => g (ev₂ b)) hι₂_ψ
      have hb' : ι₂ (b - ψ₁ (ev₂ b)) ∈ 𝔭 := hb
      rwa [map_sub, hψ₂_eq] at hb'
    have hmod : ∀ t : TensorProduct k A₁ A₁, θ t - ψ₂ (ev_tp t) ∈ 𝔭 := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul a b =>
        have hmul : θ (a ⊗ₜ[k] b) = ι₁ a * ι₂ b := by
          have ht : (a ⊗ₜ[k] (1 : A₁)) * ((1 : A₁) ⊗ₜ[k] b) = a ⊗ₜ[k] b := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [← ht, map_mul, hθ₁, hθ₂]
        have hev : ψ₂ (ev_tp (a ⊗ₜ[k] b)) = ψ₂ (ev₁ a) * ψ₂ (ev₂ b) := by
          change ψ₂ (ev₁ a * ev₂ b) = _
          rw [map_mul]
        rw [hmul, hev]
        have hid : ι₁ a * ι₂ b - ψ₂ (ev₁ a) * ψ₂ (ev₂ b) =
            (ι₁ a - ψ₂ (ev₁ a)) * ι₂ b + ψ₂ (ev₁ a) * (ι₂ b - ψ₂ (ev₂ b)) := by ring
        rw [hid]
        exact 𝔭.add_mem (𝔭.mul_mem_right _ (hmem₁ a)) (𝔭.mul_mem_left _ (hmem₂ b))
      | add x y ihx ihy =>
        have hadd : θ (x + y) - ψ₂ (ev_tp (x + y)) =
            (θ x - ψ₂ (ev_tp x)) + (θ y - ψ₂ (ev_tp y)) := by
          rw [map_add, map_add, map_add]
          ring
        rw [hadd]
        exact 𝔭.add_mem ihx ihy
    have hker_le : RingHom.ker ev_w ≤ 𝔭 := by
      intro u hu
      rw [RingHom.mem_ker] at hu
      have ht := hmod (θ.symm u)
      have hev0 : ev_tp (θ.symm u) = 0 := hu
      rw [θ.apply_symm_apply, hev0, map_zero, sub_zero] at ht
      exact ht
    have hevw_surj : Function.Surjective ev_w := fun c =>
      ⟨ψ₂ c, congrArg (fun g : k →+* k => g c) hevw_id⟩
    have hker_max : (RingHom.ker ev_w).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective ev_w hevw_surj
    exact ⟨ev_w, hevw_id, hevw_ι₁, hevw_ι₂, hker_max.eq_of_le h𝔭.ne_top hker_le⟩
  
  have hOpaqueEtaleDual : ∀ (S : Type u) [CommRing S] (f_et : Polynomial k →+* S)
      (Ψ₁ Ψ₂ : S →+* DualNumber k),
      f_et.Etale →
      Ψ₁.comp f_et = Ψ₂.comp f_et →
      (∀ s : S, (Ψ₁ s).fst = (Ψ₂ s).fst) →
      Ψ₁ = Ψ₂ := by
    intro S _ f_et Ψ₁ Ψ₂ hf_et hcomp hfst
    let _ : Algebra (Polynomial k) S := f_et.toAlgebra
    let _ : Algebra (Polynomial k) (DualNumber k) := (Ψ₁.comp f_et).toAlgebra
    have hf_ur : f_et.FormallyUnramified :=
      ((RingHom.etale_iff_formallyUnramified_and_smooth f_et).mp hf_et).1
    have : Algebra.FormallyUnramified (Polynomial k) S :=
      RingHom.formallyUnramified_algebraMap.mp hf_ur
    let Ψ₁_alg : S →ₐ[Polynomial k] DualNumber k :=
      { Ψ₁ with commutes' := fun _ => rfl }
    let Ψ₂_alg : S →ₐ[Polynomial k] DualNumber k :=
      { Ψ₂ with commutes' := fun p => congrArg (fun g : Polynomial k →+* DualNumber k => g p) hcomp.symm }
    let I_ε : Ideal (DualNumber k) := Ideal.span ({DualNumber.eps} : Set (DualNumber k))
    have hI_sq : I_ε ^ 2 = ⊥ := by
      dsimp [I_ε]
      rw [Ideal.span_singleton_pow, sq, DualNumber.eps_mul_eps, Ideal.span_singleton_eq_bot]
    have hq_eq : (Ideal.Quotient.mkₐ (Polynomial k) I_ε).comp Ψ₁_alg =
        (Ideal.Quotient.mkₐ (Polynomial k) I_ε).comp Ψ₂_alg := by
      ext s
      change Ideal.Quotient.mk I_ε (Ψ₁ s) = Ideal.Quotient.mk I_ε (Ψ₂ s)
      rw [Ideal.Quotient.eq, Ideal.mem_span_singleton]
      refine ⟨TrivSqZeroExt.inl (Ψ₁ s - Ψ₂ s).snd, ?_⟩
      apply TrivSqZeroExt.ext
      · simp [hfst s]
      · simp [DualNumber.fst_eps, DualNumber.snd_eps]
    have halg_eq : Ψ₁_alg = Ψ₂_alg :=
      Algebra.FormallyUnramified.comp_injective I_ε hI_sq hq_eq
    apply RingHom.ext
    intro s
    exact congrArg (fun φ : S →ₐ[Polynomial k] DualNumber k => φ s) halg_eq
  have hDualCoord : ∀ (ev : B₀ →+* k) (g z : B₀) (α₁ α₂ : B₀ →+* DualNumber k),
      ev g ≠ 0 →
      (Polynomial.eval₂RingHom
        ((algebraMap B₀ (Localization.Away g)).comp φ_k)
        (algebraMap B₀ (Localization.Away g) z)).Etale →
      α₁.comp φ_k = TrivSqZeroExt.inlHom k k →
      α₂.comp φ_k = TrivSqZeroExt.inlHom k k →
      (∀ b : B₀, (α₁ b).fst = ev b ∧ (α₂ b).fst = ev b) →
      α₁ z = α₂ z →
      α₁ = α₂ := by
    intro ev g z α₁ α₂ hne hf_et hα₁_k hα₂_k hfst hz
    have hu_ev : IsUnit (ev g) := IsUnit.mk0 (ev g) hne
    have hu₁ : IsUnit (α₁ g) := TrivSqZeroExt.isUnit_iff_isUnit_fst.mpr ((hfst g).1.symm ▸ hu_ev)
    have hu₂ : IsUnit (α₂ g) := TrivSqZeroExt.isUnit_iff_isUnit_fst.mpr ((hfst g).2.symm ▸ hu_ev)
    let Ψ₁ : Localization.Away g →+* DualNumber k := IsLocalization.Away.lift g hu₁
    let Ψ₂ : Localization.Away g →+* DualNumber k := IsLocalization.Away.lift g hu₂
    let fstR : DualNumber k →+* k := (TrivSqZeroExt.fstHom k k k).toRingHom
    have hfst_loc : fstR.comp Ψ₁ = fstR.comp Ψ₂ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers g)
      ext b
      change (Ψ₁ (algebraMap B₀ (Localization.Away g) b)).fst =
        (Ψ₂ (algebraMap B₀ (Localization.Away g) b)).fst
      rw [IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq, (hfst b).1, (hfst b).2]
    let f_et : Polynomial k →+* Localization.Away g :=
      Polynomial.eval₂RingHom
        ((algebraMap B₀ (Localization.Away g)).comp φ_k)
        (algebraMap B₀ (Localization.Away g) z)
    have hcomp_et : Ψ₁.comp f_et = Ψ₂.comp f_et := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change Ψ₁ (f_et (Polynomial.C c)) = Ψ₂ (f_et (Polynomial.C c))
        dsimp [f_et]
        rw [Polynomial.eval₂_C, RingHom.comp_apply,
          IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq]
        exact (congrArg (fun φ : k →+* DualNumber k => φ c) hα₁_k).trans
          (congrArg (fun φ : k →+* DualNumber k => φ c) hα₂_k).symm
      · change Ψ₁ (f_et Polynomial.X) = Ψ₂ (f_et Polynomial.X)
        dsimp [f_et]
        rw [Polynomial.eval₂_X,
          IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq, hz]
    have hΨ_eq : Ψ₁ = Ψ₂ := hOpaqueEtaleDual (Localization.Away g) f_et Ψ₁ Ψ₂ hf_et hcomp_et
      (fun s => congrArg (fun φ : Localization.Away g →+* k => φ s) hfst_loc)
    apply RingHom.ext
    intro b
    rw [← IsLocalization.Away.lift_eq (S := Localization.Away g) g hu₁ b,
