            rw [TensorProduct.smul_tmul, ← Algebra.algebraMap_eq_smul_one]
            rfl
          rw [h1 a'_V, h1 a_V, hi]
      let a_sec : ∀ V : U.left.affineOpens, ↑(U.left.presheaf.obj (Opposite.op V.1)) :=
        fun V => (hLocal V).choose
      have ha_sec_spec : ∀ (V : U.left.affineOpens) {Y' : S.Etale} (g : Y' ⟶ U) (hg : R.arrows g)
