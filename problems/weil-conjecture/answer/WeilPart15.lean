          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.Limits.pullback.lift (𝟙 U.left) U.hom (by simp))
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
        naturality := fun U₁ U₂ u => by
          apply CategoryTheory.MorphismProperty.Comma.Hom.ext
          · let map_u : CategoryTheory.Limits.pullback U₁.hom (𝟙 Z) ⟶
