      (fun {G₁ G₂} ψ => NatTrans.ext (funext fun opT => AddCommGrpCat.ext fun x => by
        dsimp [iso_TG, addEquiv_TG]
        change equiv_hom opT.unop G₂ (Abelian.Ext.homEquiv₀
            (x.comp (Abelian.Ext.mk₀ ψ) (Nat.add_zero 0))) =
          ψ.hom.app opT (equiv_hom opT.unop G₁ (Abelian.Ext.homEquiv₀ x))
        have hx : Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ x) = x :=
          Abelian.Ext.homEquiv₀.symm_apply_apply x
        have hcomp : Abelian.Ext.homEquiv₀ (x.comp (Abelian.Ext.mk₀ ψ) (Nat.add_zero 0)) =
            Abelian.Ext.homEquiv₀ x ≫ ψ := by
          conv_lhs => rw [← hx, Abelian.Ext.mk₀_comp_mk₀]
          exact Abelian.Ext.homEquiv₀.apply_symm_apply _
        rw [hcomp, h_eval, h_eval]
        rfl))⟩

  have hOpenHDI : ∀ {X' S' : AlgebraicGeometry.Scheme.{u}} (f' : X' ⟶ S') (U' : S'.Opens)
