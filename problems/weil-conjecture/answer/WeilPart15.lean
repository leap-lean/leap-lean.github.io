    let e_ring := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).commRingCatIsoToRingEquiv
    have : IsDomain ↑(S₀.presheaf.obj (Opposite.op ⊤)) := e_ring.toMulEquiv.isDomain k
    exact AlgebraicGeometry.isIntegral_of_isAffine_of_isDomain S₀
