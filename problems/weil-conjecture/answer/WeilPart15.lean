        have hu₀0 : u₀ = 0 := by dsimp [u₀]; rw [hω0, TensorProduct.zero_tmul]
        have hx_pow_nil : IsNilpotent (x ^ (q ^ n)) := by
          have hxeq : x ^ (q ^ n) = ν := by dsimp [ν]; rw [hu₀0, sub_zero]
          rwa [hxeq]
