    · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
      exact hs_qR
    · change (W.toScheme.isoSpec.inv ≫ W.ι).base (s_spec.base (⊥ : PrimeSpectrum Ω)) = p₀
      rw [hs_base]
