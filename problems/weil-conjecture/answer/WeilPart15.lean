    rw [AddMonoidHom.mem_ker, hmk]
    constructor
    · rintro ⟨s, hs⟩
      let s' : ↥((weilEtaleKSheaf X).obj.obj (Opposite.op T_X)) :=
        (e_sh.hom.hom.app (Opposite.op T_X)).hom s
