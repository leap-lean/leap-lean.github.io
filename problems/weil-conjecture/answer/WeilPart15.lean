          rw [← hc]
          exact IsLocalRing.ResidueField.map_residue (algebraMap A B) a
        refine ⟨n, algebraMap A Ω a * ω₀ ^ (q ^ n), ?_⟩
        rw [Algebra.TensorProduct.tmul_pow, hz_pow,
