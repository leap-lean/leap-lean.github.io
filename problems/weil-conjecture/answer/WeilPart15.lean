    (QuotientAddGroup.quotientKerEquivOfSurjective q_hom hq_surj)⟩

theorem weil_etale_separated_locFinite_closedFiber_sheaf (k : Type u) [Field k]
    (S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType S.hom] [S.left.IsSeparated] :
    ∃ (Div_sh : CategoryTheory.Sheaf S.left.smallEtaleTopology AddCommGrpCat.{u})
      (valDiv : ∀ U : S.left.Etale,
        ↥(Div_sh.obj.obj (Opposite.op U)) →+
          ({ y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥S.left) } → ℤ)),
      (∀ U : S.left.Etale, Function.Injective (valDiv U)) ∧
      (∀ U : S.left.Etale,
        Set.range (valDiv U) =
          { D | ∀ u : ↥U.left, ∃ V : U.left.Opens, u ∈ V ∧
            { y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥S.left) } |
              y.1 ∈ V ∧ D y ≠ 0 }.Finite }) ∧
      (∀ U : S.left.Etale,
        CompactSpace ↥U.left → Set.range (valDiv U) = { D | { y | D y ≠ 0 }.Finite }) ∧
      (∀ {U₁ U₂ : S.left.Etale} (g : U₁ ⟶ U₂)
          (d : ↥(Div_sh.obj.obj (Opposite.op U₂)))
          (y₁ : { y : ↥U₁.left // IsClosed ({U₁.hom.base y} : Set ↥S.left) }),
        valDiv U₁ ((Div_sh.obj.map g.op).hom d) y₁ =
          valDiv U₂ d ⟨g.left.base y₁.1, by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.MorphismProperty.Over.w g]
            exact y₁.2⟩) :=
by
  classical
  let X : AlgebraicGeometry.Scheme.{u} := S.left
  let Pt : X.Etale → Type u := fun U =>
    { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥X) }
  let mapPt : ∀ {U₁ U₂ : X.Etale} (g : U₁ ⟶ U₂), Pt U₁ → Pt U₂ :=
    fun {U₁ U₂} g y₁ =>
      ⟨g.left.base y₁.1, by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.MorphismProperty.Over.w g]
        exact y₁.2⟩
  let D_loc : ∀ U : X.Etale, AddSubgroup (Pt U → ℤ) := fun U =>
    { carrier := { D | ∀ u : ↥U.left, ∃ V : U.left.Opens, u ∈ V ∧
        { y : Pt U | y.1 ∈ V ∧ D y ≠ 0 }.Finite }
      zero_mem' := fun u => ⟨⊤, trivial, Set.finite_empty.subset fun y ⟨_, h⟩ => h rfl⟩
      add_mem' := fun {D₁ D₂} h₁ h₂ u => by
        obtain ⟨V₁, hu₁, hf₁⟩ := h₁ u
        obtain ⟨V₂, hu₂, hf₂⟩ := h₂ u
        refine ⟨V₁ ⊓ V₂, ⟨hu₁, hu₂⟩, (hf₁.union hf₂).subset ?_⟩
        intro y ⟨hyV, hne⟩
        by_cases hD₁ : D₁ y = 0
        · right
          refine ⟨hyV.2, fun hD₂ => hne ?_⟩
          change D₁ y + D₂ y = 0
          rw [hD₁, hD₂, add_zero]
        · left
          exact ⟨hyV.1, hD₁⟩
      neg_mem' := fun {D} h u => by
        obtain ⟨V, hu, hf⟩ := h u
        refine ⟨V, hu, hf.subset ?_⟩
        intro y ⟨hyV, hne⟩
        refine ⟨hyV, fun h0 => hne ?_⟩
        change -D y = 0
        rw [h0, neg_zero] }
  have hFibFin : ∀ (U : X.Etale) (V : U.left.Opens),
      AlgebraicGeometry.IsAffineOpen V →
      ∀ x : ↥X, { y : ↥U.left | y ∈ V ∧ U.hom.base y = x }.Finite := by
    intro U V hV x
    obtain ⟨W, hW, hxW, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (trivial : x ∈ (⊤ : X.Opens))
    let f_V : V.toScheme ⟶ X := V.ι ≫ U.hom
    have : AlgebraicGeometry.IsAffine V.toScheme := hV
    let t_X := CategoryTheory.Limits.terminal.from X
    have : AlgebraicGeometry.IsAffineHom (f_V ≫ t_X) :=
      AlgebraicGeometry.isAffineHom_of_isAffine _
    have : AlgebraicGeometry.IsSeparated t_X :=
      (inferInstance : X.IsSeparated).isSeparated_terminal_from
    have : AlgebraicGeometry.IsAffineHom f_V :=
      @AlgebraicGeometry.IsAffineHom.of_comp _ _ _ f_V t_X ‹_› ‹_›
    let V_W : V.toScheme.Opens := (TopologicalSpace.Opens.map f_V.base).obj W
    have hVW : AlgebraicGeometry.IsAffineOpen V_W := hW.preimage f_V
    have : AlgebraicGeometry.Etale U.hom := U.prop
    have : AlgebraicGeometry.Etale f_V := inferInstance
    let A : Type u := ↑(X.presheaf.obj (Opposite.op W))
    let B : Type u := ↑(V.toScheme.presheaf.obj (Opposite.op V_W))
    let φ_mor := f_V.appLE W V_W le_rfl
    let φ : A →+* B := φ_mor.hom
    have hFU : φ.FormallyUnramified :=
      AlgebraicGeometry.FormallyUnramified.formallyUnramified_appLE f_V hW hVW le_rfl
    have hFT : φ.FiniteType :=
      AlgebraicGeometry.LocallyOfFiniteType.finiteType_appLE f_V hW hVW le_rfl
    let : Algebra A B := φ.toAlgebra
    have : Algebra.FormallyUnramified A B := hFU
    have : Algebra.FiniteType A B := hFT
    have : Algebra.QuasiFinite A B := inferInstance
    have hx_range : x ∈ Set.range ⇑hW.fromSpec.base := by
      rw [hW.range_fromSpec]
      exact hxW
    obtain ⟨p_x, hp_x⟩ := hx_range
    have hS₀ : (PrimeSpectrum.comap (algebraMap A B) ⁻¹' {p_x}).Finite :=
      Algebra.QuasiFinite.finite_comap_preimage_singleton (R := A) (S := B) p_x
    let ι_B : PrimeSpectrum B → ↥U.left := fun q => (hVW.fromSpec ≫ V.ι).base q
    refine (hS₀.image ι_B).subset ?_
    rintro y ⟨hyV, hyx⟩
    have hy_range : y ∈ Set.range ⇑V.ι.base := by
      rw [V.range_ι]
      exact hyV
    obtain ⟨v, hv⟩ := hy_range
    have hfV_v : f_V.base v = x := by
      change (V.ι ≫ U.hom).base v = x
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hv, hyx]
    have hv_W : v ∈ (V_W : Set ↥V.toScheme) := by
      change f_V.base v ∈ (W : Set ↥X)
      rw [hfV_v]
      exact hxW
    have hv_range : v ∈ Set.range ⇑hVW.fromSpec.base := by
      rw [hVW.range_fromSpec]
      exact hv_W
    obtain ⟨q, hq⟩ := hv_range
    refine ⟨q, ?_, ?_⟩
    · change PrimeSpectrum.comap φ q = p_x
      have : AlgebraicGeometry.IsOpenImmersion hW.fromSpec := hW.isOpenImmersion_fromSpec
      apply hW.fromSpec.isOpenEmbedding.injective
      have hmap_q : (AlgebraicGeometry.Spec.map φ_mor).base q = PrimeSpectrum.comap φ q := by
        rw [AlgebraicGeometry.Spec.map_base]
        rfl
      have hsq :=
        congrArg (fun m : AlgebraicGeometry.Spec (V.toScheme.presheaf.obj (Opposite.op V_W)) ⟶ X =>
          m.base q) (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f_V hW hVW le_rfl)
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply,
        hmap_q] at hsq
      rw [hsq, hq, hfV_v, ← hp_x]
    · change (hVW.fromSpec ≫ V.ι).base q = y
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hq, hv]
  have hPullLoc : ∀ {U₁ U₂ : X.Etale} (g : U₁ ⟶ U₂) (D : Pt U₂ → ℤ),
      D ∈ D_loc U₂ → (fun y₁ => D (mapPt g y₁)) ∈ D_loc U₁ := by
    intro U₁ U₂ g D hD u₁
    obtain ⟨V₂, hu₂, hF₂⟩ := hD (g.left.base u₁)
    have hu₁_pre : u₁ ∈ (TopologicalSpace.Opens.map g.left.base).obj V₂ := hu₂
    obtain ⟨V₁, hV₁, hu₁, hV₁_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hu₁_pre
    let F₂ : Set (Pt U₂) := { y₂ : Pt U₂ | y₂.1 ∈ V₂ ∧ D y₂ ≠ 0 }
    let X₀ : Set ↥X := (fun y₂ : Pt U₂ => U₂.hom.base y₂.1) '' F₂
    have hX₀ : X₀.Finite := hF₂.image _
    have hSub : ∀ x : ↥X, { y₁ : Pt U₁ | y₁.1 ∈ V₁ ∧ U₁.hom.base y₁.1 = x }.Finite := by
      intro x
      exact (hFibFin U₁ V₁ hV₁ x).preimage Subtype.val_injective.injOn
    refine ⟨V₁, hu₁, (hX₀.biUnion fun x _ => hSub x).subset ?_⟩
    rintro y₁ ⟨hy₁V, hne⟩
    refine Set.mem_biUnion ?_ ⟨hy₁V, rfl⟩
    refine ⟨mapPt g y₁, ⟨hV₁_sub hy₁V, hne⟩, ?_⟩
    dsimp [mapPt]
    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.MorphismProperty.Over.w g]
  let Div_pre : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
    { obj := fun U => AddCommGrpCat.of ↥(D_loc (Opposite.unop U))
      map := fun {U₂ U₁} g => AddCommGrpCat.ofHom
        { toFun := fun d => ⟨fun y₁ => d.1 (mapPt (Opposite.unop g) y₁),
            hPullLoc (Opposite.unop g) d.1 d.2⟩
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      map_id := fun U => by
        apply AddCommGrpCat.ext
        intro d
        rfl
      map_comp := fun f₁ f₂ => by
        apply AddCommGrpCat.ext
        intro d
        rfl }
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  let J := X.smallEtaleTopology
  have hMemJ : ∀ (U : X.Etale) (R : CategoryTheory.Sieve U),
      R ∈ J U ↔ ∀ x : ↥U.left, ∃ (Y : X.Etale) (f : Y ⟶ U) (y : ↥Y.left),
        R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro U R
    have hJ_eq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) X le_rfl
    exact (Eq.to_iff (congrArg
      (fun G : CategoryTheory.GrothendieckTopology (P_et.Over ⊤ X) => R ∈ G U) hJ_eq)).trans
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U R)
  have hSheaf : CategoryTheory.Presheaf.IsSheaf J Div_pre := by
    apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J Div_pre
      (CategoryTheory.forget AddCommGrpCat.{u})
    rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
    intro U R hR x_fam hx_compat
    have hR_mem : ∀ x : ↥U.left, ∃ (Y : X.Etale) (f : Y ⟶ U) (y : ↥Y.left),
        R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x :=
      (hMemJ U R).mp hR
    let d_fam : ∀ {Y : X.Etale} (f : Y ⟶ U), R.arrows f → ↥(D_loc Y) :=
      fun f hf => x_fam f hf
    have hoverlap : ∀ {Y₁ Y₂ : X.Etale} (f₁ : Y₁ ⟶ U) (f₂ : Y₂ ⟶ U)
        (hf₁ : R.arrows f₁) (hf₂ : R.arrows f₂) (y₁ : Pt Y₁) (y₂ : Pt Y₂),
        f₁.left.base y₁.1 = f₂.left.base y₂.1 →
        (d_fam f₁ hf₁).1 y₁ = (d_fam f₂ hf₂).1 y₂ := by
      intro Y₁ Y₂ f₁ f₂ hf₁ hf₂ y₁ y₂ hy
      have hf₂_et : AlgebraicGeometry.Etale f₂.left :=
        CategoryTheory.MorphismProperty.of_postcomp P_et f₂.left U.hom U.prop
          (by
            have hw : f₂.left ≫ U.hom = Y₂.hom := CategoryTheory.MorphismProperty.Over.w f₂
            exact hw.symm ▸ Y₂.prop)
      have hp₁_et : P_et (CategoryTheory.Limits.pullback.fst f₁.left f₂.left) := inferInstance
      let Z_pb : X.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.Limits.pullback.fst f₁.left f₂.left ≫ Y₁.hom)
          (CategoryTheory.MorphismProperty.comp_mem P_et _ _ hp₁_et Y₁.prop)
      let g₁ : Z_pb ⟶ Y₁ :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.fst f₁.left f₂.left) rfl
      let g₂ : Z_pb ⟶ Y₂ :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.snd f₁.left f₂.left)
          (by
            have hw₁ : f₁.left ≫ U.hom = Y₁.hom := CategoryTheory.MorphismProperty.Over.w f₁
            have hw₂ : f₂.left ≫ U.hom = Y₂.hom := CategoryTheory.MorphismProperty.Over.w f₂
            exact (congrArg (CategoryTheory.Limits.pullback.snd f₁.left f₂.left ≫ ·) hw₂.symm).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ U.hom) CategoryTheory.Limits.pullback.condition.symm).trans
                  ((CategoryTheory.Category.assoc _ _ _).trans (congrArg _ hw₁)))))
      have hcomm : g₁ ≫ f₁ = g₂ ≫ f₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
      obtain ⟨z, hz₁, hz₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁.1 y₂.1 hy
      let z_pt : Pt Z_pb := ⟨z, by
        change IsClosed ({(CategoryTheory.Limits.pullback.fst f₁.left f₂.left ≫ Y₁.hom).base z} : Set ↥X)
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hz₁]
        exact y₁.2⟩
      have hcomp := hx_compat g₁ g₂ hf₁ hf₂ hcomm
      have hz_eq : (d_fam f₁ hf₁).1 (mapPt g₁ z_pt) = (d_fam f₂ hf₂).1 (mapPt g₂ z_pt) :=
        congrFun (congrArg Subtype.val hcomp) z_pt
      have hg₁ : mapPt g₁ z_pt = y₁ := Subtype.ext hz₁
      have hg₂ : mapPt g₂ z_pt = y₂ := Subtype.ext hz₂
      rw [hg₁, hg₂] at hz_eq
      exact hz_eq
    choose Y_x f_x y_x hf_x het_x hy_x using hR_mem
    let liftPt : ∀ u : Pt U, Pt (Y_x u.1) := fun u =>
      ⟨y_x u.1, by
        rw [← CategoryTheory.MorphismProperty.Over.w (f_x u.1),
          AlgebraicGeometry.Scheme.Hom.comp_apply, hy_x u.1]
        exact u.2⟩
    let D_glue : Pt U → ℤ := fun u => (d_fam (f_x u.1) (hf_x u.1)).1 (liftPt u)
    have hD_pull : ∀ {Y : X.Etale} (f : Y ⟶ U) (hf : R.arrows f) (y : Pt Y),
        D_glue (mapPt f y) = (d_fam f hf).1 y := by
      intro Y f hf y
      exact hoverlap (f_x (f.left.base y.1)) f (hf_x _) hf (liftPt (mapPt f y)) y
        (hy_x (f.left.base y.1))
    have hD_loc : D_glue ∈ D_loc U := by
      intro u
      obtain ⟨V_Y, hyV, hFY⟩ := (d_fam (f_x u) (hf_x u)).2 (y_x u)
      have : AlgebraicGeometry.Etale (f_x u).left := het_x u
      let V_U : U.left.Opens :=
        ⟨(f_x u).left.base '' (V_Y : Set ↥(Y_x u).left),
          (f_x u).left.isOpenMap _ V_Y.isOpen⟩
      have huV : u ∈ V_U := ⟨y_x u, hyV, hy_x u⟩
      refine ⟨V_U, huV, (hFY.image (mapPt (f_x u))).subset ?_⟩
      rintro y ⟨⟨w, hwV, hwy⟩, hne⟩
      let w_pt : Pt (Y_x u) := ⟨w, by
        rw [← CategoryTheory.MorphismProperty.Over.w (f_x u),
          AlgebraicGeometry.Scheme.Hom.comp_apply, hwy]
        exact y.2⟩
      have hw_map : mapPt (f_x u) w_pt = y := Subtype.ext hwy
      refine ⟨w_pt, ⟨hwV, ?_⟩, hw_map⟩
      rw [← hD_pull (f_x u) (hf_x u) w_pt, hw_map]
      exact hne
    refine ⟨(⟨D_glue, hD_loc⟩ : ↥(D_loc U)), ?_, ?_⟩
    · intro Y f hf
      exact Subtype.ext (funext fun y => hD_pull f hf y)
    · intro t ht
      let t_sub : ↥(D_loc U) := t
      apply Subtype.ext
      funext u
      have htu : ((Div_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u}).map (f_x u.1).op) t =
          x_fam (f_x u.1) (hf_x u.1) :=
        ht (f_x u.1) (hf_x u.1)
      have htu_pt : t_sub.1 (mapPt (f_x u.1) (liftPt u)) = D_glue u :=
        congrFun (congrArg Subtype.val htu) (liftPt u)
      have hmap_lift : mapPt (f_x u.1) (liftPt u) = u := Subtype.ext (hy_x u.1)
      rw [hmap_lift] at htu_pt
      exact htu_pt
  let Div_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨Div_pre, hSheaf⟩
  let valDiv : ∀ U : X.Etale, ↥(Div_sh.obj.obj (Opposite.op U)) →+ (Pt U → ℤ) :=
    fun U => (D_loc U).subtype
  have hRangeLoc : ∀ U : X.Etale,
      Set.range (valDiv U) =
        { D | ∀ u : ↥U.left, ∃ V : U.left.Opens, u ∈ V ∧
          { y : Pt U | y.1 ∈ V ∧ D y ≠ 0 }.Finite } := by
    intro U
    ext D
    exact ⟨by rintro ⟨d, rfl⟩; exact d.2, fun hD => ⟨⟨D, hD⟩, rfl⟩⟩
  refine ⟨Div_sh, valDiv, fun U => Subtype.val_injective, hRangeLoc, ?_, ?_⟩
  · intro U hComp
    rw [hRangeLoc U]
    ext D
    constructor
    · intro hloc
      choose V hu hfin using hloc
      obtain ⟨t, ht⟩ := (@isCompact_univ ↥U.left _ hComp).elim_finite_subcover
        (fun u => (V u : Set ↥U.left)) (fun u => (V u).isOpen)
        (fun u _ => Set.mem_iUnion.mpr ⟨u, hu u⟩)
      refine (t.finite_toSet.biUnion fun u _ => hfin u).subset ?_
      intro y hy
      have hy_univ : y.1 ∈ (Set.univ : Set ↥U.left) := trivial
      have hy_mem := ht hy_univ
      simp only [Set.mem_iUnion] at hy_mem
      obtain ⟨u, hut, hyVu⟩ := hy_mem
      exact Set.mem_biUnion hut ⟨hyVu, hy⟩
    · intro hFin u
      exact ⟨⊤, trivial, hFin.subset fun y hy => hy.2⟩
  · intro U₁ U₂ g d y₁
    rfl

theorem weil_smooth_curve_etale_stalk_dvr_and_domain_chart (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (hDim : topologicalKrullDim C.left = (1 : WithBot ℕ∞)) :
    (∀ x : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) },
      StrictAnti (fun n : ℕ => IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk x.1) ^ n)) ∧
    (∀ (U : C.left.Etale)
        (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) }),
      ∃ hDom : IsDomain ↑(U.left.presheaf.stalk y.1),
        @IsDiscreteValuationRing ↑(U.left.presheaf.stalk y.1) _ hDom) ∧
    (∀ {U₁ U₂ : C.left.Etale} (g : U₁ ⟶ U₂)
        (y₁ : { y : ↥U₁.left // IsClosed ({U₁.hom.base y} : Set ↥C.left) }),
      let y₂ : { y : ↥U₂.left // IsClosed ({U₂.hom.base y} : Set ↥C.left) } :=
        ⟨g.left.base y₁.1, by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.MorphismProperty.Over.w g]
          exact y₁.2⟩
      Function.Injective (g.left.stalkMap y₁.1).hom ∧
      ∀ n : ℕ,
        Ideal.map (g.left.stalkMap y₁.1).hom
          (IsLocalRing.maximalIdeal ↑(U₂.left.presheaf.stalk y₂.1) ^ n) =
        IsLocalRing.maximalIdeal ↑(U₁.left.presheaf.stalk y₁.1) ^ n) ∧
    (∀ (U : C.left.Etale) (u₀ : ↥U.left),
      ∃ (W₀ : C.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen W₀)
        (V₀ : U.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen V₀) (_ : u₀ ∈ V₀)
        (e : V₀ ≤ (TopologicalSpace.Opens.map U.hom.base).obj W₀),
        IsDomain ↑(U.left.presheaf.obj (Opposite.op V₀)) ∧
        Function.Injective (U.hom.appLE W₀ V₀ e).hom ∧
        (∀ q : Ideal ↑(U.left.presheaf.obj (Opposite.op V₀)),
          q.IsPrime → Ideal.comap (U.hom.appLE W₀ V₀ e).hom q = ⊥ → q = ⊥) ∧
        (∀ m : Ideal ↑(U.left.presheaf.obj (Opposite.op V₀)),
          m.IsMaximal → m ≠ ⊥ →
          ∃ (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) }) (hy : y.1 ∈ V₀),
            Ideal.comap (U.left.presheaf.germ V₀ y.1 hy).hom
              (IsLocalRing.maximalIdeal ↑(U.left.presheaf.stalk y.1)) = m) ∧
        (∀ y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) },
          IsOpen ((V₀ : Set ↥U.left) \ {y.1})) ∧
        (∀ d : ↑(U.left.presheaf.obj (Opposite.op V₀)),
          d ≠ 0 →
          { y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) } |
            ∃ hy : y.1 ∈ V₀,
              (U.left.presheaf.germ V₀ y.1 hy).hom d ∈
                IsLocalRing.maximalIdeal ↑(U.left.presheaf.stalk y.1) }.Finite)) :=
by
  classical
  have : IrreducibleSpace ↥C.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C.left
  let η : ↥C.left := genericPoint ↥C.left

  
  have hCl_iff : ∀ x : ↥C.left, IsClosed ({x} : Set ↥C.left) ↔ x ≠ η := by
    intro x
    constructor
    · intro hCl hx_eq
      rw [hx_eq] at hCl
      have huniv : ({η} : Set ↥C.left) = Set.univ := by
        rw [← hCl.closure_eq]
        exact (genericPoint_spec ↥C.left).def
      have hall : ∀ z : ↥C.left, z = η :=
        fun z => Set.mem_singleton_iff.mp (huniv.symm ▸ Set.mem_univ z)
      let topIC : TopologicalSpace.IrreducibleCloseds ↥C.left :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥C.left, isClosed_univ⟩
      have hUniq : Unique (TopologicalSpace.IrreducibleCloseds ↥C.left) :=
        { default := topIC
          uniq := fun F => by
            obtain ⟨z, hz⟩ := F.isIrreducible.nonempty
            have hηF : η ∈ F.carrier := hall z ▸ hz
            have hsub : (Set.univ : Set ↥C.left) ⊆ F.carrier := by
              rw [← (genericPoint_spec ↥C.left).def]
              exact F.isClosed.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hηF)
            ext y
            exact ⟨fun _ => Set.mem_univ y, fun hy => hsub hy⟩ }
      have h0 : topologicalKrullDim C.left = 0 :=
        @Order.krullDim_eq_zero_of_unique (TopologicalSpace.IrreducibleCloseds ↥C.left) _ hUniq
      rw [hDim] at h0
      exact one_ne_zero h0
    · intro hx_ne
      have h_cl_ne_univ : closure ({x} : Set ↥C.left) ≠ Set.univ := by
        intro h_eq
        have h1 : x ⤳ η := specializes_iff_mem_closure.mpr (h_eq.symm ▸ Set.mem_univ η)
        have h2 : η ⤳ x :=
          specializes_iff_mem_closure.mpr ((genericPoint_spec ↥C.left).def.symm ▸ Set.mem_univ x)
        exact hx_ne ((inseparable_iff_specializes_and.mpr ⟨h1, h2⟩).eq)
      by_contra h_not_cl
      have h_ne_cl : ({x} : Set ↥C.left) ≠ closure ({x} : Set ↥C.left) :=
        fun heq => h_not_cl (heq ▸ isClosed_closure)
      have hex_z : ∃ z : ↥C.left, z ∈ closure ({x} : Set ↥C.left) ∧ z ≠ x := by
        by_contra h_all
        push Not at h_all
        apply h_ne_cl
        ext z
        simp only [Set.mem_singleton_iff]
        exact ⟨fun h => by rw [h]; exact subset_closure (Set.mem_singleton x), h_all z⟩
      obtain ⟨z, hz_mem, hz_ne⟩ := hex_z
      have h_cl_sub : closure ({z} : Set ↥C.left) ⊆ closure ({x} : Set ↥C.left) :=
        closure_minimal (Set.singleton_subset_iff.mpr hz_mem) isClosed_closure
      have h_cl_ne : closure ({z} : Set ↥C.left) ≠ closure ({x} : Set ↥C.left) := by
        intro heq
        have h1 : z ⤳ x :=
          specializes_iff_mem_closure.mpr (heq.symm ▸ subset_closure (Set.mem_singleton x))
        have h2 : x ⤳ z := specializes_iff_mem_closure.mpr hz_mem
        exact hz_ne ((inseparable_iff_specializes_and.mpr ⟨h1, h2⟩).eq)
      let F₀ : TopologicalSpace.IrreducibleCloseds ↥C.left :=
        ⟨closure ({z} : Set ↥C.left), isIrreducible_singleton.closure, isClosed_closure⟩
      let F₁ : TopologicalSpace.IrreducibleCloseds ↥C.left :=
        ⟨closure ({x} : Set ↥C.left), isIrreducible_singleton.closure, isClosed_closure⟩
      let F₂ : TopologicalSpace.IrreducibleCloseds ↥C.left :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥C.left, isClosed_univ⟩
      have hF01 : F₀ < F₁ := lt_of_le_of_ne h_cl_sub (fun h => h_cl_ne (congrArg SetLike.coe h))
      have hF12 : F₁ < F₂ :=
        lt_of_le_of_ne (Set.subset_univ _) (fun h => h_cl_ne_univ (congrArg SetLike.coe h))
      let s : LTSeries (TopologicalSpace.IrreducibleCloseds ↥C.left) :=
        { length := 2
          toFun := ![F₀, F₁, F₂]
          step := fun i => by
            fin_cases i
            · exact hF01
            · exact hF12 }
      have hlen : (s.length : WithBot ℕ∞) ≤ topologicalKrullDim C.left :=
        Order.LTSeries.length_le_krullDim s
      rw [hDim] at hlen
      change ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) at hlen
      norm_cast at hlen

  have hAff_prime : ∀ (W : C.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
      (p : ↥(AlgebraicGeometry.Spec (C.left.presheaf.obj (Opposite.op W)))),
      (IsClosed ({hW.fromSpec.base p} : Set ↥C.left) ↔ p.asIdeal ≠ ⊥) ∧
      (p.asIdeal ≠ ⊥ → p.asIdeal.IsMaximal) := by
    intro W hW p
    have hx_p : hW.fromSpec.base p ∈ W := by
      change hW.fromSpec p ∈ (W : Set ↥C.left)
      rw [← hW.range_fromSpec]
      exact ⟨p, rfl⟩
    have hW_ne : Nonempty ↥(W : TopologicalSpace.Opens ↥C.left) := ⟨⟨hW.fromSpec.base p, hx_p⟩⟩
    have : IsDomain ↑(C.left.presheaf.obj (Opposite.op W)) :=
      @AlgebraicGeometry.IsIntegral.component_integral C.left _ W hW_ne
    have : IrreducibleSpace ↥(AlgebraicGeometry.Spec (C.left.presheaf.obj (Opposite.op W))) :=
      PrimeSpectrum.irreducibleSpace
    have hW_inj : Function.Injective hW.fromSpec.base :=
      hW.isOpenImmersion_fromSpec.base_open.injective
    have hbot_p : (⊥ : Ideal ↑(C.left.presheaf.obj (Opposite.op W))).IsPrime :=
      ⟨bot_ne_top, fun {a b} hab => by
        rw [Ideal.mem_bot] at hab
        simpa only [Ideal.mem_bot] using mul_eq_zero.mp hab⟩
    let p₀ : ↥(AlgebraicGeometry.Spec (C.left.presheaf.obj (Opposite.op W))) :=
      ⟨⊥, hbot_p⟩
    let gW : ↥(AlgebraicGeometry.Spec (C.left.presheaf.obj (Opposite.op W))) :=
      genericPoint ↥(AlgebraicGeometry.Spec (C.left.presheaf.obj (Opposite.op W)))
    have hgW_eq : gW = p₀ := by
      have h1 : gW ⤳ p₀ :=
        specializes_iff_mem_closure.mpr
          ((genericPoint_spec ↥(AlgebraicGeometry.Spec (C.left.presheaf.obj (Opposite.op W)))).def.symm ▸
            Set.mem_univ p₀)
      have h2 : p₀ ⤳ gW :=
        (PrimeSpectrum.le_iff_specializes
          (p₀ : PrimeSpectrum ↑(C.left.presheaf.obj (Opposite.op W)))
          (gW : PrimeSpectrum ↑(C.left.presheaf.obj (Opposite.op W)))).mp
          (bot_le : p₀.asIdeal ≤ gW.asIdeal)
      exact (inseparable_iff_specializes_and.mpr ⟨h1, h2⟩).eq
    have hfrom_p₀ : hW.fromSpec.base p₀ = η := by
      have hgen := @AlgebraicGeometry.IsAffineOpen.primeIdealOf_genericPoint C.left _ W hW hW_ne
      change hW.primeIdealOf ⟨η, _⟩ = gW at hgen
      rw [hgW_eq] at hgen
      rw [← hgen]
      exact hW.fromSpec_primeIdealOf _
    have hiff : IsClosed ({hW.fromSpec.base p} : Set ↥C.left) ↔ p.asIdeal ≠ ⊥ := by
      rw [hCl_iff, ← hfrom_p₀]
      refine not_iff_not.mpr ?_
      constructor
      · intro h_eq
        exact congrArg PrimeSpectrum.asIdeal (hW_inj h_eq)
      · intro h_bot
        exact congrArg hW.fromSpec.base (PrimeSpectrum.ext h_bot)
    refine ⟨hiff, fun hp_ne => ?_⟩
    have hCl_xp : IsClosed ({hW.fromSpec.base p} : Set ↥C.left) := hiff.mpr hp_ne
    have hCl_pre : IsClosed
        (hW.fromSpec.base ⁻¹' ({hW.fromSpec.base p} : Set ↥C.left)) :=
      hCl_xp.preimage hW.fromSpec.continuous
    have hpre : hW.fromSpec.base ⁻¹' ({hW.fromSpec.base p} : Set ↥C.left) =
        ({p} : Set ↥(AlgebraicGeometry.Spec (C.left.presheaf.obj (Opposite.op W)))) := by
      ext q
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      exact ⟨fun h => hW_inj h, fun h => congrArg hW.fromSpec.base h⟩
    rw [hpre] at hCl_pre
    exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal
      (p : PrimeSpectrum ↑(C.left.presheaf.obj (Opposite.op W)))).mp hCl_pre

  
  have hLocalPrincipalToDVR : ∀ (R₂ : Type u) [CommRing R₂] [IsLocalRing R₂] [IsNoetherianRing R₂]
      (π₂ : R₂), π₂ ≠ 0 →
      IsLocalRing.maximalIdeal R₂ = Ideal.span ({π₂} : Set R₂) →
      (∀ z : R₂, π₂ * z = 0 → z = 0) →
      ∃ hDom₂ : IsDomain R₂, @IsDiscreteValuationRing R₂ _ hDom₂ := by
    intro R₂ _ _ _ π₂ hπ₂_ne hmax_span hnzd
    have hnzd_pow : ∀ (n : ℕ) (z : R₂), π₂ ^ n * z = 0 → z = 0 := by
      intro n
      induction n with
      | zero =>
        intro z hz
        simpa using hz
      | succ n ih =>
        intro z hz
        rw [pow_succ, mul_assoc] at hz
        exact hnzd z (ih (π₂ * z) hz)
    have hkrull : (⨅ i : ℕ, IsLocalRing.maximalIdeal R₂ ^ i) = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal R₂)
        (IsLocalRing.maximalIdeal.isMaximal R₂).ne_top
    have hunit_not_mem : ∀ (n : ℕ) (u : R₂), IsUnit u →
        π₂ ^ n * u ∉ IsLocalRing.maximalIdeal R₂ ^ (n + 1) := by
      intro n u hu hmem
      rw [hmax_span, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hmem
      obtain ⟨w, hw⟩ := hmem
      have h0 : π₂ ^ n * (u - w * π₂) = 0 := by
        calc
          π₂ ^ n * (u - w * π₂) = π₂ ^ n * u - w * π₂ ^ (n + 1) := by rw [pow_succ]; ring
          _ = 0 := sub_eq_zero.mpr hw.symm
      have hu_eq : u = w * π₂ := sub_eq_zero.mp (hnzd_pow n _ h0)
      have hu_mem : u ∈ IsLocalRing.maximalIdeal R₂ := by
        rw [hmax_span, Ideal.mem_span_singleton']
        exact ⟨w, hu_eq.symm⟩
      exact (IsLocalRing.notMem_maximalIdeal.mpr hu) hu_mem
    have hdecomp : ∀ x : R₂, x ≠ 0 → ∃ (n : ℕ) (u : R₂), IsUnit u ∧ x = π₂ ^ n * u := by
      intro x hx
      have hx_not_bot : x ∉ (⊥ : Ideal R₂) := by
        simp [hx]
      rw [← hkrull, Ideal.mem_iInf] at hx_not_bot
      push Not at hx_not_bot
      obtain ⟨N, hN⟩ := hx_not_bot
      have hN_ne : N ≠ 0 := by
        intro h0
        rw [h0, pow_zero, Ideal.one_eq_top] at hN
        exact hN Submodule.mem_top
      have hex_n : ∃ n : ℕ, x ∉ IsLocalRing.maximalIdeal R₂ ^ (n + 1) :=
        ⟨N - 1, by rwa [Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hN_ne)]⟩
      let n₀ := Nat.find hex_n
      have hn₀_spec : x ∉ IsLocalRing.maximalIdeal R₂ ^ (n₀ + 1) := Nat.find_spec hex_n
      have hn₀_mem : x ∈ IsLocalRing.maximalIdeal R₂ ^ n₀ := by
        rcases Nat.eq_zero_or_pos n₀ with h0 | hpos
        · rw [h0, pow_zero, Ideal.one_eq_top]
          exact Submodule.mem_top
        · obtain ⟨m, hm⟩ : ∃ m : ℕ, m + 1 = n₀ := ⟨n₀ - 1, Nat.sub_add_cancel hpos⟩
          have hlt : m < n₀ := by omega
          have hmin := Nat.find_min hex_n hlt
          rw [hm] at hmin
          exact not_not.mp hmin
      rw [hmax_span, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hn₀_mem
      obtain ⟨u, hu⟩ := hn₀_mem
      have hx_eq : x = π₂ ^ n₀ * u := by rw [← hu, mul_comm]
      have hu_unit : IsUnit u := by
        apply IsLocalRing.notMem_maximalIdeal.mp
        intro hu_mem
        rw [hmax_span, Ideal.mem_span_singleton'] at hu_mem
        obtain ⟨v, hv⟩ := hu_mem
        have hx_in : x ∈ Ideal.span ({π₂} : Set R₂) ^ (n₀ + 1) := by
          rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton']
          refine ⟨v, ?_⟩
          rw [hx_eq, ← hv, pow_succ]
          ring
        rw [← hmax_span] at hx_in
        exact hn₀_spec hx_in
      exact ⟨n₀, u, hu_unit, hx_eq⟩
    have : NoZeroDivisors R₂ :=
      ⟨fun {x y} hxy => by
        by_contra hne
        push Not at hne
        obtain ⟨n, u, hu, rfl⟩ := hdecomp x hne.1
        obtain ⟨m, v, hv, rfl⟩ := hdecomp y hne.2
        have hmul : π₂ ^ (n + m) * (u * v) = 0 := by
          calc
            π₂ ^ (n + m) * (u * v) = (π₂ ^ n * u) * (π₂ ^ m * v) := by rw [pow_add]; ring
            _ = 0 := hxy
        have huv0 : u * v = 0 := hnzd_pow (n + m) (u * v) hmul
        exact (hu.mul hv).ne_zero huv0⟩
    have hDom₂ : IsDomain R₂ := NoZeroDivisors.to_isDomain R₂
    have hPIR : IsPrincipalIdealRing R₂ :=
      ⟨fun I => by
        by_cases hI : I = ⊥
        · rw [hI]
          exact ⟨0, by simp⟩
        · have hex_y₀ : ∃ y₀ ∈ I, y₀ ≠ 0 := by
            by_contra hall
            push Not at hall
            exact hI (eq_bot_iff.mpr fun y hy => Ideal.mem_bot.mpr (hall y hy))
          obtain ⟨y₀, hy₀I, hy₀_ne⟩ := hex_y₀
          obtain ⟨k₀, v₀, hv₀, hy₀_eq⟩ := hdecomp y₀ hy₀_ne
          have hex_I : ∃ n : ℕ, ∃ x ∈ I, x ∉ IsLocalRing.maximalIdeal R₂ ^ (n + 1) :=
            ⟨k₀, y₀, hy₀I, hy₀_eq ▸ hunit_not_mem k₀ v₀ hv₀⟩
          let m₀ := Nat.find hex_I
          obtain ⟨x₀, hx₀I, hx₀_not⟩ := Nat.find_spec hex_I
          have hx₀_mem : x₀ ∈ IsLocalRing.maximalIdeal R₂ ^ m₀ := by
            rcases Nat.eq_zero_or_pos m₀ with h0 | hpos
            · rw [h0, pow_zero, Ideal.one_eq_top]
              exact Submodule.mem_top
            · obtain ⟨k, hk⟩ : ∃ k : ℕ, k + 1 = m₀ := ⟨m₀ - 1, Nat.sub_add_cancel hpos⟩
              have hlt : k < m₀ := by omega
              have hmin := Nat.find_min hex_I hlt
              push Not at hmin
              rw [← hk]
              exact hmin x₀ hx₀I
          rw [hmax_span, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hx₀_mem
          obtain ⟨u₀, hu₀⟩ := hx₀_mem
          have hu₀_unit : IsUnit u₀ := by
            apply IsLocalRing.notMem_maximalIdeal.mp
            intro hu_mem
            rw [hmax_span, Ideal.mem_span_singleton'] at hu_mem
            obtain ⟨w, hw⟩ := hu_mem
            have hx₀_in : x₀ ∈ Ideal.span ({π₂} : Set R₂) ^ (m₀ + 1) := by
              rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton']
              refine ⟨w, ?_⟩
              rw [← hu₀, ← hw, pow_succ]
              ring
            rw [← hmax_span] at hx₀_in
            exact hx₀_not hx₀_in
          obtain ⟨u₀_u, rfl⟩ := hu₀_unit
          have hgen_mem : π₂ ^ m₀ ∈ I := by
            have h1 : (↑u₀_u⁻¹ : R₂) * x₀ ∈ I := I.mul_mem_left _ hx₀I
            rwa [← hu₀, ← mul_assoc, Units.inv_mul, one_mul] at h1
          refine ⟨π₂ ^ m₀, le_antisymm ?_ (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hgen_mem))⟩
          intro y hyI
          by_cases hy0 : y = 0
          · rw [hy0]
            exact Ideal.zero_mem _
          · obtain ⟨k, v, hv, rfl⟩ := hdecomp y hy0
            have hm₀_le : m₀ ≤ k :=
              Nat.find_min' hex_I ⟨π₂ ^ k * v, hyI, hunit_not_mem k v hv⟩
            rw [Ideal.mem_span_singleton']
            refine ⟨π₂ ^ (k - m₀) * v, ?_⟩
            calc
              π₂ ^ (k - m₀) * v * π₂ ^ m₀ = π₂ ^ (k - m₀ + m₀) * v := by ring
              _ = π₂ ^ k * v := by rw [Nat.sub_add_cancel hm₀_le]⟩
    have hmax_ne_bot : IsLocalRing.maximalIdeal R₂ ≠ ⊥ := by
      intro hbot
      apply hπ₂_ne
      have hmem : π₂ ∈ IsLocalRing.maximalIdeal R₂ := by
        rw [hmax_span]
        exact Ideal.subset_span (Set.mem_singleton π₂)
      rwa [hbot, Ideal.mem_bot] at hmem
    exact ⟨hDom₂, @IsDiscreteValuationRing.mk R₂ _ hDom₂ hPIR _ hmax_ne_bot⟩

  
  have hChart_C : ∀ x₀ : ↥C.left,
      ∃ (W₀ : C.left.Opens) (hW₀ : AlgebraicGeometry.IsAffineOpen W₀),
        x₀ ∈ W₀ ∧
        IsDomain ↑(C.left.presheaf.obj (Opposite.op W₀)) ∧
        IsNoetherianRing ↑(C.left.presheaf.obj (Opposite.op W₀)) ∧
        ∃ f₀ : Polynomial k →+* ↑(C.left.presheaf.obj (Opposite.op W₀)), f₀.Etale := by
    intro x₀
    obtain ⟨U_k, _, W₀, hW₀, hx₀, e_k, hStd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 C.hom).mp inferInstance x₀
    have hUk : U_k = ⊤ := by
      ext u
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      rw [Subsingleton.elim u (C.hom.base x₀)]
      exact e_k hx₀
    subst hUk
    have hW₀_ne : Nonempty ↥(W₀ : TopologicalSpace.Opens ↥C.left) := ⟨⟨x₀, hx₀⟩⟩
    let A₀ := ↑(C.left.presheaf.obj (Opposite.op W₀))
    have hDomA₀ : IsDomain A₀ := @AlgebraicGeometry.IsIntegral.component_integral C.left _ W₀ hW₀_ne
    obtain ⟨g_mv, _, hg_et⟩ := hStd.exists_etale_mvPolynomial
    let isoΓ := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm
    let e_k_ring : k ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤)) :=
      { toFun := isoΓ.hom.hom
        invFun := isoΓ.inv.hom
        left_inv := fun c => congrArg (fun φ => φ.hom c) isoΓ.hom_inv_id
        right_inv := fun c => congrArg (fun φ => φ.hom c) isoΓ.inv_hom_id
        map_mul' := map_mul _
        map_add' := map_add _ }
    let iso_poly : Polynomial k ≃+*
        MvPolynomial (Fin 1) ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤)) :=
      (MvPolynomial.uniqueAlgEquiv k (Fin 1)).symm.toRingEquiv.trans
        (MvPolynomial.mapEquiv (Fin 1) e_k_ring)
    let f₀ : Polynomial k →+* A₀ := g_mv.comp iso_poly.toRingHom
    have hf₀_et : f₀.Etale := RingHom.Etale.respectsIso.right g_mv iso_poly hg_et
    let _ : Algebra (Polynomial k) A₀ := f₀.toAlgebra
    let _ : Algebra k A₀ := (f₀.comp Polynomial.C).toAlgebra
    have : IsScalarTower k (Polynomial k) A₀ := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.Etale (Polynomial k) A₀ := hf₀_et.toAlgebra
    have : Algebra.FiniteType k A₀ :=
      Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType k (Polynomial k)) inferInstance
    have hNoethA₀ : IsNoetherianRing A₀ := Algebra.FiniteType.isNoetherianRing k A₀
    exact ⟨W₀, hW₀, hx₀, hDomA₀, hNoethA₀, f₀, hf₀_et⟩

  
  have hBase_stalk : ∀ x : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) },
      IsDiscreteValuationRing ↑(C.left.presheaf.stalk x.1) ∧
      StrictAnti (fun n : ℕ => IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk x.1) ^ n) := by
    intro x
    obtain ⟨W₀, hW₀, hxW, hDomA₀, hNoethA₀, f₀, hf₀_et⟩ := hChart_C x.1
    let A₀ := ↑(C.left.presheaf.obj (Opposite.op W₀))
    have : IsDomain A₀ := hDomA₀
    have : IsNoetherianRing A₀ := hNoethA₀
    let Rx := ↑(C.left.presheaf.stalk x.1)
    let p_x : ↥(AlgebraicGeometry.Spec (C.left.presheaf.obj (Opposite.op W₀))) :=
      hW₀.primeIdealOf ⟨x.1, hxW⟩
    have hfrom_px : hW₀.fromSpec.base p_x = x.1 := hW₀.fromSpec_primeIdealOf ⟨x.1, hxW⟩
    have hp_ne : p_x.asIdeal ≠ ⊥ := (hAff_prime W₀ hW₀ p_x).1.mp (hfrom_px.symm ▸ x.2)
    let m : Ideal A₀ := p_x.asIdeal
    have : m.IsMaximal := (hAff_prime W₀ hW₀ p_x).2 hp_ne
    let _ : Algebra A₀ Rx := TopCat.Presheaf.algebra_section_stalk C.left.presheaf ⟨x.1, hxW⟩
    have : IsLocalization.AtPrime Rx m := hW₀.isLocalization_stalk ⟨x.1, hxW⟩
    have : IsNoetherianRing Rx := IsLocalization.isNoetherianRing m.primeCompl Rx hNoethA₀
    let P₀ := Polynomial k
    let _ : Algebra P₀ A₀ := f₀.toAlgebra
    let _ : Algebra k A₀ := (f₀.comp Polynomial.C).toAlgebra
    have : IsScalarTower k P₀ A₀ := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.Etale P₀ A₀ := hf₀_et.toAlgebra
    have : Algebra.FiniteType k A₀ :=
      Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType k P₀) inferInstance
    let L := A₀ ⧸ m
    let _ : Field L := Ideal.Quotient.field m
    have : Algebra.FiniteType k L :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k m) (Ideal.Quotient.mkₐ_surjective k m)
    obtain ⟨n_mv, ψ_mv, hψ_surj⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k) (S := L)).mp inferInstance
    have hker_max : (RingHom.ker ψ_mv.toRingHom).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective ψ_mv.toRingHom hψ_surj
    obtain ⟨v_pt, hv_ker⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp hker_max
    obtain ⟨Q_x, hQ_x⟩ := hψ_surj (Ideal.Quotient.mk m (f₀ Polynomial.X))
    let c : k := MvPolynomial.aeval v_pt Q_x
    have hc_mem : Q_x - MvPolynomial.C c ∈ RingHom.ker ψ_mv.toRingHom := by
      rw [hv_ker, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      simp [c]
    have hc_eq : Ideal.Quotient.mk m (f₀ Polynomial.X) = Ideal.Quotient.mk m (f₀ (Polynomial.C c)) := by
      have h1 : ψ_mv Q_x - ψ_mv (MvPolynomial.C c) = 0 := by
        rw [← map_sub]
        exact hc_mem
      rw [← hQ_x, sub_eq_zero.mp h1]
      exact ψ_mv.commutes c
    let π_P : P₀ := Polynomial.X - Polynomial.C c
    let p₀ : Ideal P₀ := Ideal.comap f₀ m
    have hp₀_prime : p₀.IsPrime := Ideal.IsPrime.comap f₀
    have hπ_mem : π_P ∈ p₀ := by
      change f₀ (Polynomial.X - Polynomial.C c) ∈ m
      rw [map_sub, ← Ideal.Quotient.eq]
      exact hc_eq
    have hp₀_max : (Ideal.span ({π_P} : Set P₀)).IsMaximal :=
      PrincipalIdealRing.isMaximal_of_irreducible (Polynomial.irreducible_X_sub_C c)
    have hp₀_span : p₀ = Ideal.span ({π_P} : Set P₀) :=
      (hp₀_max.eq_of_le hp₀_prime.ne_top
        (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπ_mem))).symm
    let R₀ := Localization.AtPrime p₀
    have hmax_R₀ : IsLocalRing.maximalIdeal R₀ = Ideal.span ({algebraMap P₀ R₀ π_P} : Set R₀) := by
      calc
        IsLocalRing.maximalIdeal R₀ = Ideal.map (algebraMap P₀ R₀) p₀ :=
          (IsLocalization.AtPrime.map_eq_maximalIdeal p₀ R₀).symm
        _ = Ideal.map (algebraMap P₀ R₀) (Ideal.span ({π_P} : Set P₀)) :=
          congrArg (Ideal.map (algebraMap P₀ R₀)) hp₀_span
        _ = Ideal.span ({algebraMap P₀ R₀ π_P} : Set R₀) := by
          rw [Ideal.map_span, Set.image_singleton]
    let _ : Algebra P₀ Rx := ((algebraMap A₀ Rx).comp f₀).toAlgebra
    have : IsScalarTower P₀ A₀ Rx := IsScalarTower.of_algebraMap_eq' rfl
    have hcomap_Rx : Ideal.comap (algebraMap P₀ Rx) (IsLocalRing.maximalIdeal Rx) = p₀ := by
      have hA : Ideal.comap (algebraMap A₀ Rx) (IsLocalRing.maximalIdeal Rx) = m :=
        IsLocalization.AtPrime.under_maximalIdeal Rx m
      change Ideal.comap ((algebraMap A₀ Rx).comp f₀) (IsLocalRing.maximalIdeal Rx) = p₀
      rw [← Ideal.comap_comap, hA]
    have hunit_P₀ : ∀ s : p₀.primeCompl, IsUnit (algebraMap P₀ Rx s.1) := by
      intro s
      apply IsLocalRing.notMem_maximalIdeal.mp
      intro hmem
      have hmem' : s.1 ∈ Ideal.comap (algebraMap P₀ Rx) (IsLocalRing.maximalIdeal Rx) := hmem
      rw [hcomap_Rx] at hmem'
      exact s.2 hmem'
    let ψ₀ : R₀ →+* Rx := IsLocalization.lift hunit_P₀
    let _ : Algebra R₀ Rx := ψ₀.toAlgebra
    have : IsScalarTower P₀ R₀ Rx :=
      IsScalarTower.of_algebraMap_eq'
        (RingHom.ext fun p => (IsLocalization.lift_eq hunit_P₀ p).symm)
    have : IsLocalHom ψ₀ :=
      ⟨fun z hz => by
        obtain ⟨⟨p, s⟩, hps⟩ := IsLocalization.surj p₀.primeCompl z
        have hmul_u : IsUnit (ψ₀ (z * algebraMap P₀ R₀ s.1)) := by
          rw [map_mul, IsLocalization.lift_eq hunit_P₀ s.1]
          exact hz.mul (hunit_P₀ s)
        rw [hps] at hmul_u
        change IsUnit (ψ₀ (algebraMap P₀ R₀ p)) at hmul_u
        rw [IsLocalization.lift_eq hunit_P₀ p] at hmul_u
        have hp_not : p ∉ p₀ := by
          intro hp_mem
          have hp_max : algebraMap P₀ Rx p ∈ IsLocalRing.maximalIdeal Rx := by
            change p ∈ Ideal.comap (algebraMap P₀ Rx) (IsLocalRing.maximalIdeal Rx)
            rw [hcomap_Rx]
            exact hp_mem
          exact (IsLocalRing.notMem_maximalIdeal.mpr hmul_u) hp_max
        have hp_u_R₀ : IsUnit (algebraMap P₀ R₀ p) :=
          IsLocalization.map_units R₀ (⟨p, hp_not⟩ : p₀.primeCompl)
        rw [← hps] at hp_u_R₀
        exact isUnit_of_mul_isUnit_left hp_u_R₀⟩
    have : Algebra.FormallyUnramified A₀ Rx :=
      Algebra.FormallyUnramified.of_isLocalization m.primeCompl
    have : Algebra.FormallyUnramified P₀ Rx :=
      Algebra.FormallyUnramified.comp P₀ A₀ Rx
    have : Algebra.FormallyUnramified R₀ Rx :=
      Algebra.FormallyUnramified.localization_base p₀.primeCompl
    have : Algebra.EssFiniteType P₀ A₀ := Algebra.EssFiniteType.of_finiteType P₀ A₀
    have : Algebra.EssFiniteType A₀ Rx := Algebra.EssFiniteType.of_isLocalization Rx m.primeCompl
    have : Algebra.EssFiniteType P₀ Rx := Algebra.EssFiniteType.comp P₀ A₀ Rx
    have : Algebra.EssFiniteType R₀ Rx := Algebra.EssFiniteType.of_comp P₀ R₀ Rx
    let π_x : Rx := algebraMap P₀ Rx π_P
    have hmax_Rx : IsLocalRing.maximalIdeal Rx = Ideal.span ({π_x} : Set Rx) := by
      rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := R₀) (S := Rx), hmax_R₀,
        Ideal.map_span, Set.image_singleton]
      congr 1
      ext r
      simp only [Set.mem_singleton_iff]
      change r = ψ₀ (algebraMap P₀ R₀ π_P) ↔ r = π_x
      rw [IsLocalization.lift_eq hunit_P₀ π_P]
    have hle_nzd : m.primeCompl ≤ nonZeroDivisors A₀ := by
      intro s hs
      exact mem_nonZeroDivisors_iff_ne_zero.mpr (fun h0 => hs (h0 ▸ m.zero_mem))
    have hinj_A₀ : Function.Injective (algebraMap A₀ Rx) :=
      IsLocalization.injective Rx hle_nzd
    have hex_a₀ : ∃ a₀ ∈ m, a₀ ≠ 0 := by
      by_contra hall
      push Not at hall
      exact hp_ne (eq_bot_iff.mpr fun a ha => Ideal.mem_bot.mpr (hall a ha))
    obtain ⟨a₀, ha₀_m, ha₀_ne⟩ := hex_a₀
    have hmax_ne_bot : IsLocalRing.maximalIdeal Rx ≠ ⊥ := by
      intro hbot
      apply ha₀_ne
      apply hinj_A₀
      rw [map_zero]
      have hmem : algebraMap A₀ Rx a₀ ∈ IsLocalRing.maximalIdeal Rx := by
        rw [← IsLocalization.AtPrime.map_eq_maximalIdeal m Rx]
        exact Ideal.mem_map_of_mem _ ha₀_m
      rwa [hbot, Ideal.mem_bot] at hmem
    have hπ_ne : π_x ≠ 0 := by
      intro h0
      apply hmax_ne_bot
      rw [hmax_Rx, h0, Ideal.span_singleton_eq_bot]
    obtain ⟨hDomRx', hDVRRx'⟩ :=
      hLocalPrincipalToDVR Rx π_x hπ_ne hmax_Rx
        (fun z hz => (mul_eq_zero.mp hz).resolve_left hπ_ne)
    have hDVRRx : IsDiscreteValuationRing Rx :=
      Subsingleton.elim hDomRx' (inferInstance : IsDomain Rx) ▸ hDVRRx'
    refine ⟨hDVRRx, strictAnti_nat_of_succ_lt (fun n => ?_)⟩
    refine lt_of_le_of_ne (Ideal.pow_le_pow_right (Nat.le_succ n)) ?_
    intro heq
    have hmem_pow : π_x ^ n ∈ IsLocalRing.maximalIdeal Rx ^ (n + 1) := by
      rw [heq, hmax_Rx, Ideal.span_singleton_pow]
      exact Ideal.subset_span (Set.mem_singleton _)
    rw [hmax_Rx, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hmem_pow
    obtain ⟨r, hr⟩ := hmem_pow
    have h0 : (r * π_x - 1) * π_x ^ n = 0 := by
      calc
        (r * π_x - 1) * π_x ^ n = r * π_x ^ (n + 1) - π_x ^ n := by rw [pow_succ]; ring
        _ = 0 := sub_eq_zero.mpr hr
    have hr1 : π_x * r = 1 := by
      rw [mul_comm]
      exact sub_eq_zero.mp ((mul_eq_zero.mp h0).resolve_right (pow_ne_zero n hπ_ne))
    have hπ_unit : IsUnit π_x := isUnit_iff_exists_inv.mpr ⟨r, hr1⟩
    have hπ_in_max : π_x ∈ IsLocalRing.maximalIdeal Rx := by
      rw [hmax_Rx]
      exact Ideal.subset_span (Set.mem_singleton _)
    exact (IsLocalRing.notMem_maximalIdeal.mpr hπ_unit) hπ_in_max

  
  have hLocalTransfer : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂]
      [IsLocalRing R₁] [IsLocalRing R₂] (φ : R₁ →+* R₂) [IsLocalHom φ],
      φ.Flat → φ.FormallyUnramified → φ.EssFiniteType →
      (IsField R₁ → IsField R₂) ∧
      (∀ [hDom₁ : IsDomain R₁], @IsDiscreteValuationRing R₁ _ hDom₁ →
        Function.Injective φ ∧
        (∀ n : ℕ, Ideal.map φ (IsLocalRing.maximalIdeal R₁ ^ n) =
          IsLocalRing.maximalIdeal R₂ ^ n) ∧
        (∃ hDom₂ : IsDomain R₂, @IsDiscreteValuationRing R₂ _ hDom₂)) := by
    intro R₁ R₂ _ _ _ _ φ _ hFlat hUnram hEss
    let _ : Algebra R₁ R₂ := φ.toAlgebra
    have : Module.Flat R₁ R₂ := hFlat
    have : Algebra.FormallyUnramified R₁ R₂ := hUnram
    have : Algebra.EssFiniteType R₁ R₂ := hEss
    have : IsLocalHom (algebraMap R₁ R₂) := ‹IsLocalHom φ›
    have h_max : Ideal.map φ (IsLocalRing.maximalIdeal R₁) = IsLocalRing.maximalIdeal R₂ :=
      Algebra.FormallyUnramified.map_maximalIdeal (R := R₁) (S := R₂)
    constructor
    · intro hF₁
      have hm₁_bot : IsLocalRing.maximalIdeal R₁ = ⊥ := by
        rw [eq_bot_iff]
        intro x hx
        by_contra hx0
        have hu : IsUnit x := isUnit_iff_exists_inv.mpr (hF₁.mul_inv_cancel hx0)
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu) hx
      have hm₂_bot : IsLocalRing.maximalIdeal R₂ = ⊥ := by
        rw [← h_max, hm₁_bot, Ideal.map_bot]
      refine { exists_pair_ne := ⟨0, 1, zero_ne_one⟩, mul_comm := mul_comm, mul_inv_cancel := ?_ }
      intro y hy
      have hy_not : y ∉ IsLocalRing.maximalIdeal R₂ := by
        rw [hm₂_bot, Ideal.mem_bot]
        exact hy
      exact isUnit_iff_exists_inv.mp (IsLocalRing.notMem_maximalIdeal.mp hy_not)
    · intro hDom₁ hDVR₁
      have : IsDomain R₁ := hDom₁
      have : IsDiscreteValuationRing R₁ := hDVR₁
      have : IsNoetherianRing R₂ := Algebra.EssFiniteType.isNoetherianRing R₁ R₂
      have : Module.IsTorsionFree R₁ R₂ := Module.Flat.isTorsionFree
      have hpow : ∀ n : ℕ, Ideal.map φ (IsLocalRing.maximalIdeal R₁ ^ n) =
          IsLocalRing.maximalIdeal R₂ ^ n := by
        intro n
        rw [Ideal.map_pow, h_max]
      have hinj : Function.Injective φ := by
        rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
        intro r hr
        by_contra hr0
        have hsmul : r • (1 : R₂) = 0 := by
          change φ r * 1 = 0
          rw [mul_one]
          exact hr
        exact one_ne_zero ((smul_eq_zero_iff_right hr0).mp hsmul)
      let π₁ : R₁ := Submodule.IsPrincipal.generator (IsLocalRing.maximalIdeal R₁)
      have hspan₁ : Ideal.span ({π₁} : Set R₁) = IsLocalRing.maximalIdeal R₁ :=
        Submodule.IsPrincipal.span_singleton_generator (IsLocalRing.maximalIdeal R₁)
      have hπ₁_ne : π₁ ≠ 0 := by
        intro h0
        apply IsDiscreteValuationRing.not_a_field' (R := R₁)
        rw [← hspan₁, h0, Ideal.span_singleton_eq_bot]
      let π₂ : R₂ := φ π₁
      have hπ₂_ne : π₂ ≠ 0 := fun h0 => hπ₁_ne (hinj (h0.trans (map_zero φ).symm))
      have hspan₂ : IsLocalRing.maximalIdeal R₂ = Ideal.span ({π₂} : Set R₂) := by
        rw [← h_max, ← hspan₁, Ideal.map_span, Set.image_singleton]
      have hnzd₂ : ∀ z : R₂, π₂ * z = 0 → z = 0 := by
        intro z hz
        have hsmul : π₁ • z = 0 := hz
        exact (smul_eq_zero_iff_right hπ₁_ne).mp hsmul
      exact ⟨hinj, hpow, hLocalPrincipalToDVR R₂ π₂ hπ₂_ne hspan₂ hnzd₂⟩

  
  have hEtale_dvr : ∀ (U : C.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) }),
      ∃ hDom : IsDomain ↑(U.left.presheaf.stalk y.1),
        @IsDiscreteValuationRing ↑(U.left.presheaf.stalk y.1) _ hDom := by
    intro U y
    let f_U : U.left ⟶ C.left := U.hom
    have : AlgebraicGeometry.Etale f_U := U.prop
    let x_C : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) } := ⟨f_U.base y.1, y.2⟩
    have : IsDiscreteValuationRing ↑(C.left.presheaf.stalk (f_U.base y.1)) :=
      (hBase_stalk x_C).1
    exact ((hLocalTransfer (f_U.stalkMap y.1).hom
      (AlgebraicGeometry.Flat.stalkMap f_U y.1)
      (AlgebraicGeometry.FormallyUnramified.stalkMap f_U y.1)
      (AlgebraicGeometry.LocallyOfFiniteType.stalkMap f_U y.1)).2 inferInstance).2.2

  have hEtale_gen_field : ∀ (U : C.left.Etale) (z : ↥U.left),
      U.hom.base z = η → IsField ↑(U.left.presheaf.stalk z) := by
    intro U z hz
    let f_U : U.left ⟶ C.left := U.hom
    have : AlgebraicGeometry.Etale f_U := U.prop
    have hIso := C.left.presheaf.stalkCongr (Inseparable.of_eq (hz : f_U.base z = η))
    let e_stalk : ↑(C.left.presheaf.stalk (f_U.base z)) ≃* ↑C.left.functionField :=
      { toFun := hIso.hom.hom
        invFun := hIso.inv.hom
        left_inv := fun a => congrArg (fun φ => φ.hom a) hIso.hom_inv_id
        right_inv := fun a => congrArg (fun φ => φ.hom a) hIso.inv_hom_id
        map_mul' := map_mul _ }
    have hField_base : IsField ↑(C.left.presheaf.stalk (f_U.base z)) :=
      MulEquiv.isField (Field.toIsField ↑C.left.functionField) e_stalk
    exact (hLocalTransfer (f_U.stalkMap z).hom
      (AlgebraicGeometry.Flat.stalkMap f_U z)
      (AlgebraicGeometry.FormallyUnramified.stalkMap f_U z)
      (AlgebraicGeometry.LocallyOfFiniteType.stalkMap f_U z)).1 hField_base

  
  have hConj3 : ∀ {U₁ U₂ : C.left.Etale} (g : U₁ ⟶ U₂)
      (y₁ : { y : ↥U₁.left // IsClosed ({U₁.hom.base y} : Set ↥C.left) }),
      let y₂ : { y : ↥U₂.left // IsClosed ({U₂.hom.base y} : Set ↥C.left) } :=
        ⟨g.left.base y₁.1, by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.MorphismProperty.Over.w g]
          exact y₁.2⟩
      Function.Injective (g.left.stalkMap y₁.1).hom ∧
      ∀ n : ℕ,
        Ideal.map (g.left.stalkMap y₁.1).hom
          (IsLocalRing.maximalIdeal ↑(U₂.left.presheaf.stalk y₂.1) ^ n) =
        IsLocalRing.maximalIdeal ↑(U₁.left.presheaf.stalk y₁.1) ^ n := by
    intro U₁ U₂ g y₁ y₂
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    let f₂ : U₂.left ⟶ C.left := U₂.hom
    have hg_et : AlgebraicGeometry.Etale g.left :=
      CategoryTheory.MorphismProperty.of_postcomp P_et g.left f₂ U₂.prop
        (by
          have hw : g.left ≫ U₂.hom = U₁.hom := CategoryTheory.MorphismProperty.Over.w g
          exact hw.symm ▸ U₁.prop)
    have : AlgebraicGeometry.Etale g.left := hg_et
    obtain ⟨hDom₂, hDVR₂⟩ := hEtale_dvr U₂ y₂
    have htr := @(hLocalTransfer (g.left.stalkMap y₁.1).hom
      (AlgebraicGeometry.Flat.stalkMap g.left y₁.1)
      (AlgebraicGeometry.FormallyUnramified.stalkMap g.left y₁.1)
      (AlgebraicGeometry.LocallyOfFiniteType.stalkMap g.left y₁.1)).2 hDom₂ hDVR₂
    exact ⟨htr.1, htr.2.1⟩

  
  have hAwayPackage : ∀ (A₀ B₁ : Type u) [CommRing A₀] [IsDomain A₀]
      [CommRing B₁] [IsNoetherianRing B₁] (φ₁ : A₀ →+* B₁),
      (∀ (q : Ideal B₁) [q.IsPrime],
        (Ideal.comap φ₁ q = ⊥ → IsField (Localization.AtPrime q)) ∧
        (Ideal.comap φ₁ q ≠ ⊥ →
          ∃ hDom : IsDomain (Localization.AtPrime q),
            @IsDiscreteValuationRing (Localization.AtPrime q) _ hDom)) →
      ∀ (q₀ : Ideal B₁) [q₀.IsPrime],
      ∃ g_sep : B₁, g_sep ∉ q₀ ∧
        ∀ (D : Type u) [CommRing D] [Algebra B₁ D] [IsLocalization.Away g_sep D],
          let φ : A₀ →+* D := (algebraMap B₁ D).comp φ₁
          IsDomain D ∧
          Function.Injective φ ∧
          (∀ q : Ideal D, q.IsPrime → Ideal.comap φ q = ⊥ → q = ⊥) ∧
          (∀ q : Ideal D, q.IsPrime → q ≠ ⊥ → q.IsMaximal) ∧
          (∀ d : D, d ≠ 0 → { q : Ideal D | q.IsPrime ∧ d ∈ q }.Finite) := by
    intro A₀ B₁ _ _ _ _ φ₁ hStalk q₀ _
    have hDom_loc : ∀ (q : Ideal B₁) [q.IsPrime], IsDomain (Localization.AtPrime q) := by
      intro q _
      by_cases hc : Ideal.comap φ₁ q = ⊥
      · let _ : Field (Localization.AtPrime q) := ((hStalk q).1 hc).toField
        exact inferInstance
      · exact ((hStalk q).2 hc).choose
    have hRed : ∀ (x : B₁) (n : ℕ), x ^ n = 0 → x = 0 := by
      intro x n hxn
      let J : Ideal B₁ :=
        { carrier := { s : B₁ | s * x = 0 }
          add_mem' := fun {a b} ha hb => by dsimp at *; rw [add_mul, ha, hb, add_zero]
          zero_mem' := by simp
          smul_mem' := fun c {a} ha => by dsimp at *; rw [mul_assoc, ha, mul_zero] }
      by_cases hJ : J = ⊤
      · have h1 : (1 : B₁) ∈ J := hJ.symm ▸ Submodule.mem_top
        simpa [J] using h1
      · obtain ⟨m, hm_max, hJm⟩ := Ideal.exists_le_maximal J hJ
        have : m.IsPrime := hm_max.isPrime
        have : IsDomain (Localization.AtPrime m) := hDom_loc m
        have hdom_pow : ∀ (z : Localization.AtPrime m) (k : ℕ), z ^ k = 0 → z = 0 := by
          intro z k
          induction k with
          | zero =>
            intro h0
            rw [pow_zero] at h0
            exact False.elim (one_ne_zero h0)
          | succ k ih =>
            intro h0
            rw [pow_succ] at h0
            rcases mul_eq_zero.mp h0 with h1 | h2
            · exact ih h1
            · exact h2
        have hloc0 : algebraMap B₁ (Localization.AtPrime m) x = 0 := by
          apply hdom_pow _ n
          rw [← map_pow, hxn, map_zero]
        obtain ⟨s, hs⟩ := (IsLocalization.map_eq_zero_iff m.primeCompl _ x).mp hloc0
        exact False.elim (s.2 (hJm hs))
    let P_min : ∀ (q : Ideal B₁) [q.IsPrime], Ideal B₁ :=
      fun q _ => RingHom.ker (algebraMap B₁ (Localization.AtPrime q))
    have hPmin_prime : ∀ (q : Ideal B₁) [q.IsPrime], (P_min q).IsPrime := by
      intro q _
      have : IsDomain (Localization.AtPrime q) := hDom_loc q
      exact RingHom.ker_isPrime _
    have hPmin_le : ∀ (q : Ideal B₁) [q.IsPrime] (p' : Ideal B₁),
        p'.IsPrime → p' ≤ q → P_min q ≤ p' := by
      intro q _ p' hp' hp'_le b hb
      obtain ⟨s, hs⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl _ b).mp hb
      have hmul : s.1 * b ∈ p' := hs ▸ p'.zero_mem
      exact (hp'.mem_or_mem hmul).resolve_left (fun hs_p' => s.2 (hp'_le hs_p'))
    have hPmin_mem : ∀ (q : Ideal B₁) [hq : q.IsPrime], P_min q ∈ minimalPrimes B₁ := by
      intro q hq
      rw [minimalPrimes_eq_minimals]
      exact ⟨hPmin_prime q, fun p' hp' hp'_le =>
        hPmin_le q p' hp' (le_trans hp'_le (hPmin_le q q hq le_rfl))⟩
    have hPmin_uniq : ∀ (q : Ideal B₁) [q.IsPrime] (p : Ideal B₁),
        p ∈ minimalPrimes B₁ → p ≤ q → p = P_min q := by
      intro q _ p hp hp_le
      rw [minimalPrimes_eq_minimals] at hp
      have hle : P_min q ≤ p := hPmin_le q p hp.1 hp_le
      exact le_antisymm (hp.2 (hPmin_prime q) hle) hle
    let p₀ : Ideal B₁ := P_min q₀
    have hp₀_prime : p₀.IsPrime := hPmin_prime q₀
    have hp₀_le_q₀ : p₀ ≤ q₀ := hPmin_le q₀ q₀ inferInstance le_rfl
    have hp₀_min : p₀ ∈ minimalPrimes B₁ := hPmin_mem q₀
    have hFin_other : (minimalPrimes B₁ \ {p₀}).Finite :=
      (minimalPrimes.finite_of_isNoetherianRing B₁).sdiff
    let F : Finset (Ideal B₁) := hFin_other.toFinset
    have hex_g : ∀ p : Ideal B₁, p ∈ F → ∃ g : B₁, g ∈ p ∧ g ∉ q₀ := by
      intro p hpF
      have hp_mem : p ∈ minimalPrimes B₁ ∧ p ≠ p₀ := by
        simpa [F, Set.mem_sdiff, Set.mem_singleton_iff] using hpF
      have hnot_le : ¬ (p ≤ q₀) := fun hle => hp_mem.2 (hPmin_uniq q₀ p hp_mem.1 hle)
      exact Set.not_subset.mp hnot_le
    let g_fn : { p : Ideal B₁ // p ∈ F } → B₁ := fun p => (hex_g p.1 p.2).choose
    have hg_fn : ∀ p : { p : Ideal B₁ // p ∈ F }, g_fn p ∈ p.1 ∧ g_fn p ∉ q₀ :=
      fun p => (hex_g p.1 p.2).choose_spec
    let g_sep : B₁ := ∏ p ∈ F.attach, g_fn p
    have hg_sep_not_q₀ : g_sep ∉ q₀ :=
      q₀.primeCompl.prod_mem (fun p _ => (hg_fn p).2)
    have hg_sep_not_p₀ : g_sep ∉ p₀ := fun h => hg_sep_not_q₀ (hp₀_le_q₀ h)
    have h_ann : ∀ b : B₁, b ∈ p₀ ↔ g_sep * b = 0 := by
      intro b
      constructor
      · intro hb
        have hmem_nil : g_sep * b ∈ nilradical B₁ := by
          rw [nilradical_eq_sInf, Ideal.mem_sInf]
          intro q hq
          have : q.IsPrime := hq
          by_cases h_eq : P_min q = p₀
          · have hbq : b ∈ q := hPmin_le q q hq le_rfl (h_eq.symm ▸ hb)
            exact q.mul_mem_left g_sep hbq
          · have hmemF : P_min q ∈ F := by
              rw [Set.Finite.mem_toFinset]
              exact ⟨hPmin_mem q, h_eq⟩
            let pt_F : { p : Ideal B₁ // p ∈ F } := ⟨P_min q, hmemF⟩
            have hdvd : g_fn pt_F ∣ g_sep :=
              Finset.dvd_prod_of_mem g_fn (Finset.mem_attach F pt_F)
            obtain ⟨c_d, hc_d⟩ := hdvd
            have hgf_q : g_fn pt_F ∈ q :=
              hPmin_le q q hq le_rfl (hg_fn pt_F).1
            rw [hc_d, mul_assoc]
            exact q.mul_mem_right _ hgf_q
        obtain ⟨n, hn⟩ := mem_nilradical.mp hmem_nil
        exact hRed (g_sep * b) n hn
      · intro h0
        have hmem : g_sep * b ∈ p₀ := h0 ▸ p₀.zero_mem
        exact (hp₀_prime.mem_or_mem hmem).resolve_left hg_sep_not_p₀
    refine ⟨g_sep, hg_sep_not_q₀, ?_⟩
    intro D _ _ _
    let M : Submonoid B₁ := Submonoid.powers g_sep
    let ι : B₁ →+* D := algebraMap B₁ D
    let φ : A₀ →+* D := ι.comp φ₁
    have hker_ι : RingHom.ker ι = p₀ := by
      ext b
      rw [RingHom.mem_ker, IsLocalization.map_eq_zero_iff M D b]
      constructor
      · rintro ⟨⟨_, ⟨k, rfl⟩⟩, hk⟩
        have hmem : g_sep ^ k * b ∈ p₀ := hk ▸ p₀.zero_mem
        exact (hp₀_prime.mem_or_mem hmem).resolve_left (p₀.primeCompl.pow_mem hg_sep_not_p₀ k)
      · intro hb
        exact ⟨⟨g_sep, Submonoid.mem_powers g_sep⟩, (h_ann b).mp hb⟩
    have hNontriv_D : Nontrivial D := by
      refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
      have h1_ker : (1 : B₁) ∈ RingHom.ker ι := by
        rw [RingHom.mem_ker, map_one]
        exact h01.symm
      rw [hker_ι] at h1_ker
      exact hp₀_prime.ne_top ((Ideal.eq_top_iff_one p₀).mpr h1_ker)
    have hDom_D : IsDomain D := by
      have : Nontrivial D := hNontriv_D
      have : NoZeroDivisors D :=
        ⟨fun {z₁ z₂} hz => by
          obtain ⟨⟨b₁, s₁⟩, hb₁⟩ := IsLocalization.surj M z₁
          obtain ⟨⟨b₂, s₂⟩, hb₂⟩ := IsLocalization.surj M z₂
          have hb12 : ι (b₁ * b₂) = 0 := by
            rw [map_mul, ← hb₁, ← hb₂]
            calc
              (z₁ * ι s₁.1) * (z₂ * ι s₂.1) = (z₁ * z₂) * (ι s₁.1 * ι s₂.1) := by ring
              _ = 0 := by rw [hz, zero_mul]
          have hmem_p₀ : b₁ * b₂ ∈ p₀ := by
            rw [← hker_ι, RingHom.mem_ker]
            exact hb12
          rcases hp₀_prime.mem_or_mem hmem_p₀ with h1 | h2
          · left
            have hι1 : ι b₁ = 0 := by
              rw [← RingHom.mem_ker, hker_ι]
              exact h1
            rw [hι1] at hb₁
            exact (IsLocalization.map_units D s₁).mul_left_eq_zero.mp hb₁
          · right
            have hι2 : ι b₂ = 0 := by
              rw [← RingHom.mem_ker, hker_ι]
              exact h2
            rw [hι2] at hb₂
            exact (IsLocalization.map_units D s₂).mul_left_eq_zero.mp hb₂⟩
      exact NoZeroDivisors.to_isDomain D
    have : IsDomain D := hDom_D
    have hField_forces_p₀ : ∀ (q₁ : Ideal B₁) [q₁.IsPrime],
        p₀ ≤ q₁ → IsField (Localization.AtPrime q₁) → q₁ = p₀ := by
      intro q₁ _ hp₀_q₁ hFq₁
      have hPmin_eq : P_min q₁ = p₀ := (hPmin_uniq q₁ p₀ hp₀_min hp₀_q₁).symm
      have hm_bot : IsLocalRing.maximalIdeal (Localization.AtPrime q₁) = ⊥ := by
        rw [eq_bot_iff]
        intro x hx
        by_contra hx0
        exact (IsLocalRing.notMem_maximalIdeal.mpr
          (isUnit_iff_exists_inv.mpr (hFq₁.mul_inv_cancel hx0))) hx
      apply le_antisymm _ hp₀_q₁
      intro b hb
      rw [← hPmin_eq]
      change algebraMap B₁ (Localization.AtPrime q₁) b = 0
      rw [← Ideal.mem_bot, ← hm_bot, ← IsLocalization.AtPrime.map_eq_maximalIdeal q₁]
      exact Ideal.mem_map_of_mem _ hb
    have hGen_D : ∀ q : Ideal D, q.IsPrime → Ideal.comap φ q = ⊥ → q = ⊥ := by
      intro q hq hcomap
      let q₁ : Ideal B₁ := Ideal.comap ι q
      have : q₁.IsPrime := hq.comap ι
      have hp₀_q₁ : p₀ ≤ q₁ := by
        rw [← hker_ι]
        intro b hb
        change ι b ∈ q
        rw [RingHom.mem_ker.mp hb]
        exact q.zero_mem
      have hcomap_q₁ : Ideal.comap φ₁ q₁ = ⊥ := by
        rw [Ideal.comap_comap]
        exact hcomap
      have hq₁_eq : q₁ = p₀ := hField_forces_p₀ q₁ hp₀_q₁ ((hStalk q₁).1 hcomap_q₁)
      have hmap_q₁ : Ideal.map ι q₁ = q := IsLocalization.map_under M D q
      rw [← hmap_q₁, hq₁_eq, ← hker_ι, eq_bot_iff]
      exact Ideal.map_le_iff_le_comap.mpr (fun b hb => hb)
    have hInj_φ : Function.Injective φ := by
      have hp₀_self : P_min p₀ = p₀ := (hPmin_uniq p₀ p₀ hp₀_min le_rfl).symm
      have hp₀_comap : Ideal.comap φ₁ p₀ = ⊥ := by
        by_contra hc
        obtain ⟨hDom_p₀, hDVR_p₀⟩ := (hStalk p₀).2 hc
        have : IsDomain (Localization.AtPrime p₀) := hDom_p₀
        have : IsDiscreteValuationRing (Localization.AtPrime p₀) := hDVR_p₀
        apply IsDiscreteValuationRing.not_a_field' (R := Localization.AtPrime p₀)
        rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p₀, eq_bot_iff]
        refine Ideal.map_le_iff_le_comap.mpr ?_
        intro b hb
        change b ∈ P_min p₀
        rwa [hp₀_self]
      rw [RingHom.injective_iff_ker_eq_bot]
      change Ideal.comap (ι.comp φ₁) ⊥ = ⊥
      rw [← Ideal.comap_comap]
      change Ideal.comap φ₁ (RingHom.ker ι) = ⊥
      rw [hker_ι, hp₀_comap]
    have hMax_D : ∀ q : Ideal D, q.IsPrime → q ≠ ⊥ → q.IsMaximal := by
      intro q hq hq_ne
      obtain ⟨m, hm_max, hqm⟩ := Ideal.exists_le_maximal q hq.ne_top
      have hm_ne : m ≠ ⊥ := fun hm0 => hq_ne (le_bot_iff.mp (hm0 ▸ hqm))
      have : m.IsPrime := hm_max.isPrime
      let q₁ : Ideal B₁ := Ideal.comap ι q
      let m₁ : Ideal B₁ := Ideal.comap ι m
      have : q₁.IsPrime := hq.comap ι
      have : m₁.IsPrime := hm_max.isPrime.comap ι
      have hq₁_le_m₁ : q₁ ≤ m₁ := Ideal.comap_mono hqm
      have hp₀_m₁ : p₀ ≤ m₁ := by
        rw [← hker_ι]
        intro b hb
        change ι b ∈ m
        rw [RingHom.mem_ker.mp hb]
        exact m.zero_mem
      have hPmin_m₁ : P_min m₁ = p₀ := (hPmin_uniq m₁ p₀ hp₀_min hp₀_m₁).symm
      have hm₁_comap_ne : Ideal.comap φ₁ m₁ ≠ ⊥ := by
        rw [Ideal.comap_comap]
        exact fun hc => hm_ne (hGen_D m hm_max.isPrime hc)
      obtain ⟨hDom_m₁, hDVR_m₁⟩ := (hStalk m₁).2 hm₁_comap_ne
      let R_m := Localization.AtPrime m₁
      have : IsDomain R_m := hDom_m₁
      have : IsDiscreteValuationRing R_m := hDVR_m₁
      let α : B₁ →+* R_m := algebraMap B₁ R_m
      let Q : Ideal R_m := Ideal.map α q₁
      have hdisj : Disjoint (m₁.primeCompl : Set B₁) (q₁ : Set B₁) :=
        Set.disjoint_left.mpr (fun s hs_not hs_q₁ => hs_not (hq₁_le_m₁ hs_q₁))
      have : Q.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint m₁.primeCompl R_m q₁ ‹_› hdisj
      have hcomap_Q : Ideal.comap α Q = q₁ :=
        IsLocalization.under_map_of_isPrime_disjoint m₁.primeCompl R_m ‹_› hdisj
      have hQ_ne : Q ≠ ⊥ := by
        intro hQ0
        apply hq_ne
        have hq₁_le_p₀ : q₁ ≤ p₀ := by
          rw [← hcomap_Q, hQ0, ← hPmin_m₁]
          exact le_rfl
        rw [← IsLocalization.map_under M D q, eq_bot_iff]
        exact Ideal.map_le_iff_le_comap.mpr (le_trans hq₁_le_p₀ (hker_ι.symm ▸ le_rfl))
      have hQ_max : Q.IsMaximal := IsPrime.to_maximal_ideal hQ_ne
      have hQ_eq : Q = IsLocalRing.maximalIdeal R_m := IsLocalRing.eq_maximalIdeal hQ_max
      have hq₁_eq_m₁ : q₁ = m₁ := by
        rw [← hcomap_Q, hQ_eq]
        exact IsLocalization.AtPrime.under_maximalIdeal R_m m₁
      have hq_eq_m : q = m := by
        rw [← IsLocalization.map_under M D q, ← IsLocalization.map_under M D m]
        exact congrArg (Ideal.map ι) hq₁_eq_m₁
      exact hq_eq_m ▸ hm_max
    have hFin_D : ∀ d : D, d ≠ 0 → { q : Ideal D | q.IsPrime ∧ d ∈ q }.Finite := by
      intro d hd
      have : IsNoetherianRing D := IsLocalization.isNoetherianRing M D inferInstance
      let I_d : Ideal D := Ideal.span ({d} : Set D)
      let Q_d := D ⧸ I_d
      let π_d : D →+* Q_d := Ideal.Quotient.mk I_d
      have hπ_surj : Function.Surjective π_d := Ideal.Quotient.mk_surjective
      let S := { q : Ideal D | q.IsPrime ∧ d ∈ q }
      have himg_sub : (Ideal.map π_d) '' S ⊆ minimalPrimes Q_d := by
        rintro _ ⟨q, ⟨hq_p, hdq⟩, rfl⟩
        have : q.IsPrime := hq_p
        have hker_le : RingHom.ker π_d ≤ q := by
          rw [Ideal.mk_ker]
          exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hdq)
        have hqbar_p : (Ideal.map π_d q).IsPrime :=
          Ideal.map_isPrime_of_surjective hπ_surj hker_le
        rw [minimalPrimes_eq_minimals]
        refine ⟨hqbar_p, fun P' hP' hP'_le => ?_⟩
        let q' : Ideal D := Ideal.comap π_d P'
        have hq'_p : q'.IsPrime := hP'.comap π_d
        have hd_q' : d ∈ q' := by
          change π_d d ∈ P'
          have h0 : π_d d = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton d))
          rw [h0]
          exact P'.zero_mem
        have hq'_ne : q' ≠ ⊥ := fun h0 => hd (Ideal.mem_bot.mp (h0 ▸ hd_q'))
        have hq'_max : q'.IsMaximal := hMax_D q' hq'_p hq'_ne
        have hq'_le_q : q' ≤ q := by
          calc
            q' ≤ Ideal.comap π_d (Ideal.map π_d q) := Ideal.comap_mono hP'_le
            _ = q ⊔ RingHom.ker π_d := Ideal.comap_map_of_surjective' π_d hπ_surj q
            _ = q := sup_eq_left.mpr hker_le
        have hq'_eq : q' = q := hq'_max.eq_of_le hq_p.ne_top hq'_le_q
        rw [← hq'_eq, Ideal.map_comap_of_surjective π_d hπ_surj P']
      have hinj_S : Set.InjOn (Ideal.map π_d) S := by
        intro q₁ hq₁ q₂ hq₂ heq
        have hk₁ : RingHom.ker π_d ≤ q₁ := by
          rw [Ideal.mk_ker]
          exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hq₁.2)
        have hk₂ : RingHom.ker π_d ≤ q₂ := by
          rw [Ideal.mk_ker]
          exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hq₂.2)
        have hc := congrArg (Ideal.comap π_d) heq
        rw [Ideal.comap_map_of_surjective' π_d hπ_surj q₁,
          Ideal.comap_map_of_surjective' π_d hπ_surj q₂,
          sup_eq_left.mpr hk₁, sup_eq_left.mpr hk₂] at hc
        exact hc
      exact Set.Finite.of_finite_image
        ((minimalPrimes.finite_of_isNoetherianRing Q_d).subset himg_sub) hinj_S
    exact ⟨hDom_D, hInj_φ, hGen_D, hMax_D, hFin_D⟩

  
  refine ⟨fun x => (hBase_stalk x).2, hEtale_dvr, @hConj3, ?_⟩
  intro U u₀
  let f_U : U.left ⟶ C.left := U.hom
  have : AlgebraicGeometry.Etale f_U := U.prop
  obtain ⟨W₀, hW₀, hx₀, hDomA₀, hNoethA₀, _, _⟩ := hChart_C (f_U.base u₀)
  let A₀ := ↑(C.left.presheaf.obj (Opposite.op W₀))
  have : IsDomain A₀ := hDomA₀
  have : IsNoetherianRing A₀ := hNoethA₀
  obtain ⟨V₁, hV₁, hu₀₁, he₁_sub⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
      (x := u₀) (U := (TopologicalSpace.Opens.map f_U.base).obj W₀) hx₀
  have e₁ : V₁ ≤ (TopologicalSpace.Opens.map f_U.base).obj W₀ := he₁_sub
  let B₁ := ↑(U.left.presheaf.obj (Opposite.op V₁))
  let φ₁ : A₀ →+* B₁ := (f_U.appLE W₀ V₁ e₁).hom
  have hφ₁_ft : φ₁.FiniteType :=
    AlgebraicGeometry.HasRingHomProperty.appLE
      (@AlgebraicGeometry.LocallyOfFiniteType) f_U
      (inferInstance : AlgebraicGeometry.LocallyOfFiniteType f_U) ⟨W₀, hW₀⟩ ⟨V₁, hV₁⟩ e₁
  let _ : Algebra A₀ B₁ := φ₁.toAlgebra
  have : Algebra.FiniteType A₀ B₁ := hφ₁_ft
  have : IsNoetherianRing B₁ := Algebra.FiniteType.isNoetherianRing A₀ B₁
  have hV₁_inj : Function.Injective hV₁.fromSpec.base :=
    hV₁.isOpenImmersion_fromSpec.base_open.injective
  have hStalk_B₁ : ∀ (q : Ideal B₁) [q.IsPrime],
      (Ideal.comap φ₁ q = ⊥ → IsField (Localization.AtPrime q)) ∧
      (Ideal.comap φ₁ q ≠ ⊥ →
        ∃ hDom : IsDomain (Localization.AtPrime q),
          @IsDiscreteValuationRing (Localization.AtPrime q) _ hDom) := by
    intro q hq
    let pt_q : ↥(AlgebraicGeometry.Spec (U.left.presheaf.obj (Opposite.op V₁))) := ⟨q, hq⟩
    let z : ↥U.left := hV₁.fromSpec.base pt_q
    have hz : z ∈ V₁ := by
      change hV₁.fromSpec pt_q ∈ (V₁ : Set ↥U.left)
      rw [← hV₁.range_fromSpec]
      exact ⟨pt_q, rfl⟩
    have hpt_eq : hV₁.primeIdealOf ⟨z, hz⟩ = pt_q :=
      hV₁_inj (hV₁.fromSpec_primeIdealOf ⟨z, hz⟩)
    let R_z := ↑(U.left.presheaf.stalk z)
    let _ : Algebra B₁ R_z := TopCat.Presheaf.algebra_section_stalk U.left.presheaf ⟨z, hz⟩
    have hLoc_z : IsLocalization.AtPrime R_z q := by
      have hLoc₀ := hV₁.isLocalization_stalk ⟨z, hz⟩
      rw [hpt_eq] at hLoc₀
      exact hLoc₀
    have : IsLocalization.AtPrime R_z q := hLoc_z
    let e_q : Localization.AtPrime q ≃+* R_z :=
      (IsLocalization.algEquiv q.primeCompl (Localization.AtPrime q) R_z).toRingEquiv
    have hSpec_comm :=
      congrFun (congrArg (fun ψ : AlgebraicGeometry.Spec (U.left.presheaf.obj (Opposite.op V₁)) ⟶ C.left =>
        (ψ.base : ↥(AlgebraicGeometry.Spec (U.left.presheaf.obj (Opposite.op V₁))) → ↥C.left))
        (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f_U hW₀ hV₁ e₁)) pt_q
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply] at hSpec_comm
    let p_W : ↥(AlgebraicGeometry.Spec (C.left.presheaf.obj (Opposite.op W₀))) :=
      (AlgebraicGeometry.Spec.map (f_U.appLE W₀ V₁ e₁)).base pt_q
    have hpW_ideal : p_W.asIdeal = Ideal.comap φ₁ q := rfl
    have hfz_eq : f_U.base z = hW₀.fromSpec.base p_W := hSpec_comm.symm
    constructor
    · intro hc_bot
      have hnot_cl : ¬ IsClosed ({f_U.base z} : Set ↥C.left) := by
        rw [hfz_eq, (hAff_prime W₀ hW₀ p_W).1, hpW_ideal]
        exact not_not.mpr hc_bot
      have hz_η : U.hom.base z = η :=
        not_not.mp ((not_iff_not.mpr (hCl_iff (f_U.base z))).mp hnot_cl)
      exact MulEquiv.isField (hEtale_gen_field U z hz_η) e_q.toMulEquiv
    · intro hc_ne
      have hz_cl : IsClosed ({U.hom.base z} : Set ↥C.left) := by
        change IsClosed ({f_U.base z} : Set ↥C.left)
        rw [hfz_eq, (hAff_prime W₀ hW₀ p_W).1, hpW_ideal]
        exact hc_ne
      obtain ⟨hDom_z, hDVR_z⟩ := hEtale_dvr U ⟨z, hz_cl⟩
      have : IsDomain R_z := hDom_z
      have : IsDiscreteValuationRing R_z := hDVR_z
      have hDom_loc : IsDomain (Localization.AtPrime q) := e_q.toMulEquiv.isDomain R_z
      have : IsDomain (Localization.AtPrime q) := hDom_loc
      have hPIR_loc : IsPrincipalIdealRing (Localization.AtPrime q) :=
        IsPrincipalIdealRing.of_surjective e_q.symm.toRingHom e_q.symm.surjective
      have hmax_ne : IsLocalRing.maximalIdeal (Localization.AtPrime q) ≠ ⊥ := by
        intro hbot
        apply IsDiscreteValuationRing.not_a_field' (R := R_z)
        rw [eq_bot_iff]
        intro r hr
        rw [Ideal.mem_bot]
        have hr' : e_q.symm r ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
          by_contra hnot
          have hu : IsUnit (e_q.symm r) := IsLocalRing.notMem_maximalIdeal.mp hnot
          have hu_r : IsUnit r := by
            rw [← e_q.apply_symm_apply r]
            exact hu.map e_q
          exact (IsLocalRing.notMem_maximalIdeal.mpr hu_r) hr
        rw [hbot, Ideal.mem_bot] at hr'
        exact e_q.symm.injective (hr'.trans (map_zero _).symm)
      exact ⟨hDom_loc, @IsDiscreteValuationRing.mk _ _ hDom_loc hPIR_loc _ hmax_ne⟩

  let q₀ : Ideal B₁ := (hV₁.primeIdealOf ⟨u₀, hu₀₁⟩).asIdeal
  obtain ⟨g_sep, hg_sep, hAway_g⟩ := hAwayPackage A₀ B₁ φ₁ hStalk_B₁ q₀
