    let mkSkyPresheaf : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
        {J : CategoryTheory.GrothendieckTopology 𝒞}
        (Φ : CategoryTheory.GrothendieckTopology.Point.{u} J)
        (M : AddCommGrpCat.{u}), 𝒞ᵒᵖ ⥤ AddCommGrpCat.{u} :=
      fun Φ M => {
        obj := fun U => AddCommGrpCat.of (Φ.fiber.obj U.unop → ↥M)
        map := fun {U₁ U₂} u => AddCommGrpCat.ofHom {
          toFun := fun g τ => g (Φ.fiber.map u.unop τ)
          map_zero' := rfl
          map_add' := fun _ _ => rfl
        }
        map_id := fun U => by
          ext g τ
          change g (Φ.fiber.map (𝟙 U.unop) τ) = g τ
          rw [Φ.fiber.map_id]
          rfl
        map_comp := fun f g => by
          ext h τ
          change h (Φ.fiber.map (g.unop ≫ f.unop) τ) = h (Φ.fiber.map f.unop (Φ.fiber.map g.unop τ))
          rw [Φ.fiber.map_comp]
          rfl
      }
    have mkSky_isSheaf : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
        {J : CategoryTheory.GrothendieckTopology 𝒞}
        (Φ : CategoryTheory.GrothendieckTopology.Point.{u} J)
        (M : AddCommGrpCat.{u}),
        CategoryTheory.Presheaf.IsSheaf J (mkSkyPresheaf Φ M) := by
      intro 𝒞 _ J Φ M E V S_cov hS_cov x hx
      let P := mkSkyPresheaf Φ M
      haveI : CategoryTheory.IsCofiltered Φ.fiber.Elements := Φ.isCofiltered
      have h_wd : ∀ {W₁ W₂ : 𝒞} {f₁ : W₁ ⟶ V} {f₂ : W₂ ⟶ V}
          (hf₁ : S_cov.arrows f₁) (hf₂ : S_cov.arrows f₂)
          (τ₁ : Φ.fiber.obj W₁) (τ₂ : Φ.fiber.obj W₂) (τ : Φ.fiber.obj V),
          Φ.fiber.map f₁ τ₁ = τ → Φ.fiber.map f₂ τ₂ = τ →
          ∀ (e : ↥E), ((x f₁ hf₁).hom e) τ₁ = ((x f₂ hf₂).hom e) τ₂ := by
        intro W₁ W₂ f₁ f₂ hf₁ hf₂ τ₁ τ₂ τ h₁ h₂ e
        let o₁ : Φ.fiber.Elements := Φ.fiber.elementsMk W₁ τ₁
        let o₂ : Φ.fiber.Elements := Φ.fiber.elementsMk W₂ τ₂
        let o₀ : Φ.fiber.Elements := Φ.fiber.elementsMk V τ
        let m₁ : o₁ ⟶ o₀ := ⟨f₁, h₁⟩
        let m₂ : o₂ ⟶ o₀ := ⟨f₂, h₂⟩
        let Z₀ := CategoryTheory.IsCofiltered.min o₁ o₂
        let p₁ : Z₀ ⟶ o₁ := CategoryTheory.IsCofiltered.minToLeft o₁ o₂
        let p₂ : Z₀ ⟶ o₂ := CategoryTheory.IsCofiltered.minToRight o₁ o₂
        let Z₁ := CategoryTheory.IsCofiltered.eq (p₁ ≫ m₁) (p₂ ≫ m₂)
        let q : Z₁ ⟶ Z₀ := CategoryTheory.IsCofiltered.eqHom (p₁ ≫ m₁) (p₂ ≫ m₂)
        have hq_eq : q ≫ p₁ ≫ m₁ = q ≫ p₂ ≫ m₂ :=
          CategoryTheory.IsCofiltered.eq_condition (p₁ ≫ m₁) (p₂ ≫ m₂)
        let k₁ : Z₁ ⟶ o₁ := q ≫ p₁
        let k₂ : Z₁ ⟶ o₂ := q ≫ p₂
        have hk_comm : k₁.1 ≫ f₁ = k₂.1 ≫ f₂ := by
          have h1 := congrArg (fun u => u.1) hq_eq
          dsimp [k₁, k₂, m₁, m₂] at h1 ⊢
          simpa only [CategoryTheory.Category.assoc] using h1
        have h_compat := hx k₁.1 k₂.1 hf₁ hf₂ hk_comm
        have h_eval := congrArg (fun (φ : E ⟶ P.obj (Opposite.op Z₁.1)) => (φ.hom e) Z₁.2) h_compat
        dsimp [P, mkSkyPresheaf] at h_eval
        rwa [k₁.2, k₂.2] at h_eval
      have h_lift : ∀ τ : Φ.fiber.obj V,
          ∃ (W : 𝒞) (f : W ⟶ V) (_ : S_cov.arrows f) (τ' : Φ.fiber.obj W),
            Φ.fiber.map f τ' = τ := fun τ => Φ.jointly_surjective S_cov hS_cov τ
      let amalg : E ⟶ P.obj (Opposite.op V) := AddCommGrpCat.ofHom {
        toFun := fun e τ =>
          let l := h_lift τ
          ((x l.choose_spec.choose l.choose_spec.choose_spec.choose).hom e)
            l.choose_spec.choose_spec.choose_spec.choose
        map_zero' := by
          funext τ
          exact congrFun (map_zero _) _
        map_add' := fun e₁ e₂ => by
          funext τ
          exact congrFun (map_add _ e₁ e₂) _
      }
      refine ⟨amalg, ?_, ?_⟩
      · intro W f hf
        change (_ : E ⟶ P.obj (Opposite.op W)) = _
        ext e τ_W
        let τ := Φ.fiber.map f τ_W
        let l := h_lift τ
        exact h_wd l.choose_spec.choose_spec.choose hf
          l.choose_spec.choose_spec.choose_spec.choose τ_W τ
          l.choose_spec.choose_spec.choose_spec.choose_spec rfl e
      · intro g hg
        change (_ : E ⟶ P.obj (Opposite.op V)) = _
        ext e τ
        let l := h_lift τ
        let W := l.choose
        let f := l.choose_spec.choose
        let hf := l.choose_spec.choose_spec.choose
        let τ' := l.choose_spec.choose_spec.choose_spec.choose
        have hτ' : Φ.fiber.map f τ' = τ := l.choose_spec.choose_spec.choose_spec.choose_spec
        have hg_f := congrArg (fun (φ : E ⟶ P.obj (Opposite.op W)) => (φ.hom e) τ') (hg f hf)
        dsimp [P, mkSkyPresheaf] at hg_f
        rw [hτ'] at hg_f
        exact hg_f
    let mkSkyFunctor : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
        {J : CategoryTheory.GrothendieckTopology 𝒞}
        (Φ : CategoryTheory.GrothendieckTopology.Point.{u} J),
        AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
      fun Φ => {
        obj := fun M => ⟨mkSkyPresheaf Φ M, mkSky_isSheaf Φ M⟩
        map := fun {M₁ M₂} φ => {
          hom := {
            app := fun U => AddCommGrpCat.ofHom {
              toFun := fun g τ => φ.hom (g τ)
              map_zero' := by funext _; exact map_zero φ.hom
              map_add' := fun g₁ g₂ => by funext τ; exact map_add φ.hom (g₁ τ) (g₂ τ)
            }
            naturality := fun _ _ _ => rfl
          }
        }
        map_id := fun _ => by apply CategoryTheory.Sheaf.hom_ext; rfl
        map_comp := fun _ _ => by apply CategoryTheory.Sheaf.hom_ext; rfl
      }
    have hSkyAdj : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
        {J : CategoryTheory.GrothendieckTopology 𝒞}
        (Φ : CategoryTheory.GrothendieckTopology.Point.{u} J),
        Nonempty (Φ.sheafFiber (A := AddCommGrpCat.{u}) ⊣ mkSkyFunctor Φ) := by
      intro 𝒞 _ J Φ
      let SF := Φ.sheafFiber (A := AddCommGrpCat.{u})
      let Sky := mkSkyFunctor Φ
      refine ⟨CategoryTheory.Adjunction.mkOfUnitCounit {
        unit := {
          app := fun H => {
            hom := {
              app := fun U => AddCommGrpCat.ofHom {
                toFun := fun s τ => Φ.toPresheafFiber U.unop τ H.obj s
                map_zero' := by funext τ; exact map_zero _
                map_add' := fun s₁ s₂ => by funext τ; exact map_add _ s₁ s₂
              }
              naturality := fun U₁ U₂ u => by
                ext s
                funext τ
                dsimp [Sky, mkSkyFunctor, mkSkyPresheaf]
                have hw := Φ.toPresheafFiber_w u.unop τ H.obj
                exact congrArg (fun k => k.hom s) hw
            }
          }
          naturality := fun H₁ H₂ ψ => by
            apply CategoryTheory.Sheaf.hom_ext
            ext U s
            funext τ
            dsimp [SF, Sky, mkSkyFunctor, mkSkyPresheaf,
              CategoryTheory.GrothendieckTopology.Point.sheafFiber]
            have hn := Φ.toPresheafFiber_naturality ψ.hom U.unop τ
            exact (congrArg (fun k => k.hom s) hn).symm
        }
        counit := {
          app := fun M =>
            Φ.presheafFiberDesc (P := (Sky.obj M).obj) (T := M)
              (fun U τ => AddCommGrpCat.ofHom {
                toFun := fun g => g τ
                map_zero' := rfl
                map_add' := fun _ _ => rfl
              })
              (fun U₁ U₂ u τ => rfl)
          naturality := fun M₁ M₂ ψ => by
            apply Φ.presheafFiber_hom_ext
            intro U τ
            dsimp [SF, CategoryTheory.GrothendieckTopology.Point.sheafFiber]
            have hn := Φ.toPresheafFiber_naturality (Sky.map ψ).hom U τ
            have hd₁ := Φ.toPresheafFiber_presheafFiberDesc (P := (Sky.obj M₁).obj) (T := M₁)
              (fun V τ' => AddCommGrpCat.ofHom {
                toFun := fun h => h τ'
                map_zero' := rfl
                map_add' := fun _ _ => rfl
              })
              (fun _ _ _ _ => rfl) U τ
            have hd₂ := Φ.toPresheafFiber_presheafFiberDesc (P := (Sky.obj M₂).obj) (T := M₂)
              (fun V τ' => AddCommGrpCat.ofHom {
                toFun := fun h => h τ'
                map_zero' := rfl
                map_add' := fun _ _ => rfl
              })
              (fun _ _ _ _ => rfl) U τ
            rw [← CategoryTheory.Category.assoc, hn, CategoryTheory.Category.assoc,
              hd₂, ← CategoryTheory.Category.assoc, hd₁]
            apply ConcreteCategory.hom_ext
            intro g
            rfl
        }
        left_triangle := by
          apply CategoryTheory.NatTrans.ext
          funext H
          apply Φ.presheafFiber_hom_ext
          intro U τ
          dsimp [SF, CategoryTheory.GrothendieckTopology.Point.sheafFiber]
          let η_H : H.obj ⟶ (Sky.obj (SF.obj H)).obj :=
            { app := fun V => AddCommGrpCat.ofHom {
                toFun := fun s τ' => Φ.toPresheafFiber V.unop τ' H.obj s
                map_zero' := by funext _; exact map_zero _
                map_add' := fun s₁ s₂ => by funext _; exact map_add _ s₁ s₂
              }
              naturality := fun V₁ V₂ u => by
                apply ConcreteCategory.hom_ext
                intro s
                funext τ'
                exact congrArg (fun k => k.hom s) (Φ.toPresheafFiber_w u.unop τ' H.obj) }
          have hn := Φ.toPresheafFiber_naturality η_H U τ
          have hd := Φ.toPresheafFiber_presheafFiberDesc
            (P := (Sky.obj (SF.obj H)).obj) (T := SF.obj H)
            (fun V τ' => AddCommGrpCat.ofHom {
              toFun := fun h => h τ'
              map_zero' := rfl
              map_add' := fun _ _ => rfl
            })
            (fun _ _ _ _ => rfl) U τ
          erw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp,
            ← CategoryTheory.Category.assoc, hn, CategoryTheory.Category.assoc, hd]
          apply ConcreteCategory.hom_ext
          intro s
          rfl
        right_triangle := by
          apply CategoryTheory.NatTrans.ext
          funext M
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext U
          apply ConcreteCategory.hom_ext
          intro g
          funext τ
          dsimp [SF, Sky, mkSkyFunctor, mkSkyPresheaf,
            CategoryTheory.GrothendieckTopology.Point.sheafFiber]
          have hd := Φ.toPresheafFiber_presheafFiberDesc (P := (Sky.obj M).obj) (T := M)
            (fun V τ' => AddCommGrpCat.ofHom {
              toFun := fun h => h τ'
              map_zero' := rfl
              map_add' := fun _ _ => rfl
            })
            (fun _ _ _ _ => rfl) U.unop τ
          exact congrArg (fun k => k.hom g) hd
      }⟩

    
    have mkGeomPoint : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (Z : AlgebraicGeometry.Scheme.{u})
        (B' : CategoryTheory.Functor Z.Etale
          (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Etale)
        [CategoryTheory.Limits.PreservesFiniteLimits B']
        (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z)
        (π_U : ∀ U : Z.Etale, (B'.obj U).left ⟶ U.left)
        (hB'_pb : ∀ U : Z.Etale, CategoryTheory.IsPullback (π_U U) (B'.obj U).hom U.hom w)
        (hB'_nat : ∀ {U₁ U₂ : Z.Etale} (u : U₁ ⟶ U₂),
          (B'.map u).left ≫ π_U U₂ = π_U U₁ ≫ u.left),
        let S₀ := AlgebraicGeometry.Spec (CommRingCat.of Ω)
        let T₀ : S₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 S₀) inferInstance
        let F_pt : Z.Etale ⥤ Type u := B' ⋙ CategoryTheory.coyoneda.obj (Opposite.op T₀)
        CategoryTheory.IsCofiltered F_pt.Elements ∧
        CategoryTheory.InitiallySmall.{u} F_pt.Elements ∧
        (∀ {U : Z.Etale}, ∀ R ∈ Z.smallEtaleTopology U, ∀ x : F_pt.obj U,
          ∃ (V : Z.Etale) (f : V ⟶ U) (_ : R.arrows f) (y : F_pt.obj V),
            F_pt.map f y = x) := by
      intro Ω _ _ Z B' _ w π_U hB'_pb hB'_nat
      let S₀ := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let T₀ : S₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 S₀) inferInstance
      let F_pt : Z.Etale ⥤ Type u := B' ⋙ CategoryTheory.coyoneda.obj (Opposite.op T₀)
      haveI : CategoryTheory.Limits.PreservesFiniteLimits F_pt := inferInstance
      haveI : CategoryTheory.IsCofiltered F_pt.Elements :=
        CategoryTheory.Functor.isCofiltered_elements F_pt
      have _ : Subsingleton ↥S₀ := by
        change Subsingleton (PrimeSpectrum Ω)
        infer_instance
      have h_init : CategoryTheory.InitiallySmall.{u} F_pt.Elements := by
        let e_sm := CategoryTheory.equivSmallModel.{u} Z.AffineEtale
        let ι_Z : CategoryTheory.Functor Z.AffineEtale Z.Etale :=
          AlgebraicGeometry.Scheme.AffineEtale.Spec Z
        let G_Z := e_sm.inverse ⋙ ι_Z
        let Idx : Type u := Σ (m : CategoryTheory.SmallModel.{u} Z.AffineEtale), F_pt.obj (G_Z.obj m)
        let idx_fn : Idx → F_pt.Elements := fun p => F_pt.elementsMk (G_Z.obj p.1) p.2
        rw [CategoryTheory.initiallySmall_iff_exists_small_weakly_initial_set]
        refine ⟨Set.range idx_fn, small_range idx_fn, ?_⟩
        intro el
        let U : Z.Etale := el.1
        let τ : T₀ ⟶ B'.obj U := el.2
        have hpb_U := hB'_pb U
        let u_S : S₀ ⟶ U.left := τ.left ≫ π_U U
        have hu_w : u_S ≫ U.hom = w := by
          dsimp [u_S]
          erw [CategoryTheory.Category.assoc, hpb_U.w, ← CategoryTheory.Category.assoc,
            CategoryTheory.MorphismProperty.Over.w τ, CategoryTheory.Category.id_comp]
          try rfl
        obtain ⟨W, hW_aff, hxW, -⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
            (x := u_S.base (⊥ : PrimeSpectrum Ω)) (U := (⊤ : U.left.Opens)) trivial
        haveI : AlgebraicGeometry.IsAffine W.toScheme := hW_aff
        have h_range : Set.range u_S.base ⊆ Set.range W.ι.base := by
          rintro _ ⟨pt, rfl⟩
          have hpt : pt = (⊥ : PrimeSpectrum Ω) := Subsingleton.elim _ _
          rw [hpt, AlgebraicGeometry.Scheme.Opens.range_ι]
          exact hxW
        let u_W : S₀ ⟶ W.toScheme := AlgebraicGeometry.IsOpenImmersion.lift W.ι u_S h_range
        have hu_W : u_W ≫ W.ι = u_S := AlgebraicGeometry.IsOpenImmersion.lift_fac W.ι u_S h_range
        let R_W : CommRingCat.{u} := W.toScheme.presheaf.obj (Opposite.op ⊤)
        let j_W : AlgebraicGeometry.Spec R_W ⟶ U.left := W.toScheme.isoSpec.inv ≫ W.ι
        haveI : AlgebraicGeometry.Etale j_W := inferInstance
        haveI : AlgebraicGeometry.Etale (j_W ≫ U.hom) := by
          haveI : AlgebraicGeometry.Etale U.hom := U.prop
          infer_instance
        let A_W : Z.AffineEtale :=
          CategoryTheory.MorphismProperty.CostructuredArrow.mk
            (P := @AlgebraicGeometry.Etale) (Q := ⊤)
            (F := AlgebraicGeometry.Scheme.Spec) (X := Z) (A := Opposite.op R_W)
            (j_W ≫ U.hom) inferInstance
        let m : CategoryTheory.SmallModel.{u} Z.AffineEtale := e_sm.functor.obj A_W
        let iso_ov : G_Z.obj m ≅ ι_Z.obj A_W := ι_Z.mapIso (e_sm.unitIso.app A_W).symm
        let F_left_Z : Z.Etale ⥤ AlgebraicGeometry.Scheme.{u} :=
          CategoryTheory.MorphismProperty.Over.forget (@AlgebraicGeometry.Etale) ⊤ Z ⋙
            CategoryTheory.Over.forget Z
        let iso_left : (G_Z.obj m).left ≅ AlgebraicGeometry.Spec R_W := F_left_Z.mapIso iso_ov
        let f_W : ι_Z.obj A_W ⟶ U := CategoryTheory.MorphismProperty.Over.homMk j_W rfl trivial
        let f_m : G_Z.obj m ⟶ U := iso_ov.hom ≫ f_W
        let u_m : S₀ ⟶ (G_Z.obj m).left := u_W ≫ W.toScheme.isoSpec.hom ≫ iso_left.inv
        have hu_m_f : u_m ≫ f_m.left = u_S := by
          have h1 : iso_left.inv ≫ f_m.left = j_W := by
            change iso_left.inv ≫ iso_left.hom ≫ j_W = j_W
            exact iso_left.inv_hom_id_assoc j_W
          dsimp [u_m]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, h1]
          dsimp [j_W]
          rw [← CategoryTheory.Category.assoc (f := W.toScheme.isoSpec.hom),
            W.toScheme.isoSpec.hom_inv_id, CategoryTheory.Category.id_comp, hu_W]
        have hu_m_hom : u_m ≫ (G_Z.obj m).hom = 𝟙 S₀ ≫ w := by
          erw [CategoryTheory.Category.id_comp, ← CategoryTheory.MorphismProperty.Over.w f_m,
            ← CategoryTheory.Category.assoc, hu_m_f, hu_w]
          try rfl
        have hpb_m := hB'_pb (G_Z.obj m)
        let τ_m_left : S₀ ⟶ (B'.obj (G_Z.obj m)).left :=
          hpb_m.lift u_m (𝟙 S₀) hu_m_hom
        let τ_m : T₀ ⟶ B'.obj (G_Z.obj m) :=
          CategoryTheory.MorphismProperty.Over.homMk τ_m_left (hpb_m.lift_snd _ _ _) trivial
        have h_map_τ : F_pt.map f_m τ_m = τ := by
          change τ_m ≫ B'.map f_m = τ
          apply CategoryTheory.MorphismProperty.Comma.Hom.ext
          · apply hpb_U.hom_ext
            · change (τ_m_left ≫ (B'.map f_m).left) ≫ π_U U = τ.left ≫ π_U U
              rw [CategoryTheory.Category.assoc, hB'_nat f_m, ← CategoryTheory.Category.assoc,
                hpb_m.lift_fst, hu_m_f]
              rfl
            · erw [CategoryTheory.MorphismProperty.Comma.comp_left, CategoryTheory.Category.assoc,
                CategoryTheory.MorphismProperty.Over.w (B'.map f_m),
                CategoryTheory.MorphismProperty.Over.w τ_m,
                CategoryTheory.MorphismProperty.Over.w τ]
          · exact Subsingleton.elim _ _
        exact ⟨idx_fn ⟨m, τ_m⟩, ⟨⟨m, τ_m⟩, rfl⟩, ⟨⟨f_m, h_map_τ⟩⟩⟩
      refine ⟨inferInstance, h_init, ?_⟩
      intro U R hR τ
      rw [h_mem_etale] at hR
      have hpb_U := hB'_pb U
      let u_S : S₀ ⟶ U.left := τ.left ≫ π_U U
      have hu_w : u_S ≫ U.hom = w := by
        dsimp [u_S]
        erw [CategoryTheory.Category.assoc, hpb_U.w, ← CategoryTheory.Category.assoc,
          CategoryTheory.MorphismProperty.Over.w τ, CategoryTheory.Category.id_comp]
        try rfl
      obtain ⟨V, f_a, v₀, hfR, hfEt, hfv⟩ := hR (u_S.base (⊥ : PrimeSpectrum Ω))
      haveI : AlgebraicGeometry.Etale f_a.left := hfEt
      let q_P := CategoryTheory.Limits.pullback.snd f_a.left u_S
      haveI : AlgebraicGeometry.Etale q_P := inferInstance
      obtain ⟨p₀, _, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := f_a.left) (g := u_S) v₀ (⊥ : PrimeSpectrum Ω) hfv
      obtain ⟨s_P, hs_q, _⟩ := hSecAlgClosed Ω q_P p₀
      let u_V : S₀ ⟶ V.left := s_P ≫ CategoryTheory.Limits.pullback.fst f_a.left u_S
      have hu_V_fa : u_V ≫ f_a.left = u_S := by
        dsimp [u_V]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
        change s_P ≫ q_P ≫ u_S = u_S
        rw [← CategoryTheory.Category.assoc, hs_q, CategoryTheory.Category.id_comp]
      have hu_V_hom : u_V ≫ V.hom = 𝟙 S₀ ≫ w := by
        erw [CategoryTheory.Category.id_comp, ← CategoryTheory.MorphismProperty.Over.w f_a,
          ← CategoryTheory.Category.assoc, hu_V_fa, hu_w]
        try rfl
      have hpb_V := hB'_pb V
      let τ_V : T₀ ⟶ B'.obj V :=
        CategoryTheory.MorphismProperty.Over.homMk
          (hpb_V.lift u_V (𝟙 S₀) hu_V_hom) (hpb_V.lift_snd _ _ _) trivial
      have h_map_τ : F_pt.map f_a τ_V = τ := by
        change τ_V ≫ B'.map f_a = τ
        apply CategoryTheory.MorphismProperty.Comma.Hom.ext
        · apply hpb_U.hom_ext
          · change (hpb_V.lift u_V (𝟙 S₀) hu_V_hom ≫ (B'.map f_a).left) ≫ π_U U = τ.left ≫ π_U U
            rw [CategoryTheory.Category.assoc, hB'_nat f_a, ← CategoryTheory.Category.assoc,
              hpb_V.lift_fst, hu_V_fa]
            rfl
          · erw [CategoryTheory.MorphismProperty.Comma.comp_left, CategoryTheory.Category.assoc,
              CategoryTheory.MorphismProperty.Over.w (B'.map f_a),
              CategoryTheory.MorphismProperty.Over.w τ_V,
              CategoryTheory.MorphismProperty.Over.w τ]
        · exact Subsingleton.elim _ _
      exact ⟨V, f_a, hfR, τ_V, h_map_τ⟩

    
    have hPointIso : ∀ (y : ↥Y),
        let Ω_y : Type u := AlgebraicClosure ↥(Y.residueField y)
        let S_y : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of Ω_y)
        let y_bar : S_y ⟶ Y :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(Y.residueField y) Ω_y)) ≫
            Y.fromSpecResidueField y
        let T₀ : S_y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 S_y) inferInstance
        let B_y : CategoryTheory.Functor Y.Etale S_y.Etale :=
          CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ y_bar
        let pb_y := @CategoryTheory.Functor.sheafPullback _ _ _ _ B_y AddCommGrpCat.{u} _
          Y.smallEtaleTopology S_y.smallEtaleTopology (hc_y y) (hra_y y)
        ∃ (Φ_y : CategoryTheory.GrothendieckTopology.Point.{u} Y.smallEtaleTopology)
          (Φ₀ : CategoryTheory.GrothendieckTopology.Point.{u} S_y.smallEtaleTopology),
          Φ₀.fiber = CategoryTheory.coyoneda.obj (Opposite.op T₀) ∧
          Φ_y.fiber = B_y ⋙ CategoryTheory.coyoneda.obj (Opposite.op T₀) ∧
          Nonempty (pb_y ⋙ Φ₀.sheafFiber (A := AddCommGrpCat.{u}) ≅
            Φ_y.sheafFiber (A := AddCommGrpCat.{u})) := by
      intro y
      let Ω_y : Type u := AlgebraicClosure ↥(Y.residueField y)
      let S_y : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of Ω_y)
      let y_bar : S_y ⟶ Y :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(Y.residueField y) Ω_y)) ≫
          Y.fromSpecResidueField y
      let B_y : CategoryTheory.Functor Y.Etale S_y.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ y_bar
      let T₀ : S_y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 S_y) inferInstance
      haveI : CategoryTheory.Limits.PreservesFiniteLimits B_y :=
        CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback
          (@AlgebraicGeometry.Etale) y_bar
      have hpb_id_sq : ∀ {W₀ Z₀ : AlgebraicGeometry.Scheme.{u}} (p : W₀ ⟶ Z₀),
          CategoryTheory.IsPullback (𝟙 W₀) p p (𝟙 Z₀) :=
        fun p => CategoryTheory.IsPullback.of_horiz_isIso
          ⟨by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]⟩
      obtain ⟨hcof₀, hsm₀, hsurj₀⟩ := mkGeomPoint Ω_y S_y (𝟭 S_y.Etale) (𝟙 S_y)
        (fun U => 𝟙 U.left)
        (fun U => hpb_id_sq U.hom)
        (fun u => by change u.left ≫ 𝟙 _ = 𝟙 _ ≫ u.left; rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      obtain ⟨hcof_y, hsm_y, hsurj_y⟩ := mkGeomPoint Ω_y Y B_y y_bar
        (fun U => CategoryTheory.Limits.pullback.fst U.hom y_bar)
        (fun U => CategoryTheory.IsPullback.of_hasPullback U.hom y_bar)
        (fun u => by
          dsimp [B_y]
          erw [CategoryTheory.MorphismProperty.Over.pullback_map_left,
            CategoryTheory.Limits.pullback.lift_fst]
          rfl)
      let Φ₀ : CategoryTheory.GrothendieckTopology.Point.{u} S_y.smallEtaleTopology :=
        @CategoryTheory.GrothendieckTopology.Point.mk _ _ S_y.smallEtaleTopology
          (CategoryTheory.coyoneda.obj (Opposite.op T₀)) hcof₀ hsm₀ @hsurj₀
      let Φ_y : CategoryTheory.GrothendieckTopology.Point.{u} Y.smallEtaleTopology :=
        @CategoryTheory.GrothendieckTopology.Point.mk _ _ Y.smallEtaleTopology
          (B_y ⋙ CategoryTheory.coyoneda.obj (Opposite.op T₀)) hcof_y hsm_y @hsurj_y
      letI : B_y.IsContinuous Y.smallEtaleTopology S_y.smallEtaleTopology := hc_y y
      let pf_y := B_y.sheafPushforwardContinuous AddCommGrpCat.{u}
        Y.smallEtaleTopology S_y.smallEtaleTopology
      letI : pf_y.IsRightAdjoint := hra_y y
      let pb_y := B_y.sheafPullback AddCommGrpCat.{u}
        Y.smallEtaleTopology S_y.smallEtaleTopology
      let adj_y := B_y.sheafAdjunctionContinuous AddCommGrpCat.{u}
        Y.smallEtaleTopology S_y.smallEtaleTopology
      obtain ⟨adj_sky₀⟩ := hSkyAdj Φ₀
      obtain ⟨adj_sky_y⟩ := hSkyAdj Φ_y
      let iso_sky : mkSkyFunctor Φ₀ ⋙ pf_y ≅ mkSkyFunctor Φ_y :=
        CategoryTheory.NatIso.ofComponents (fun M => CategoryTheory.Iso.refl _)
          (fun _ => by apply CategoryTheory.Sheaf.hom_ext; rfl)
      let adj_comp := (adj_y.comp adj_sky₀).ofNatIsoRight iso_sky
      refine ⟨Φ_y, Φ₀, rfl, rfl,
        ⟨CategoryTheory.Adjunction.leftAdjointUniq adj_comp adj_sky_y⟩⟩

    
    have hJointZero : ∀ (K : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ y : ↥Y,
          CategoryTheory.Limits.IsZero
            ((hPointIso y).choose.sheafFiber (A := AddCommGrpCat.{u}) |>.obj K)) →
        CategoryTheory.Limits.IsZero K := by
      intro K hK_zero
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext V_op
      ext s
      let V := V_op.unop
      suffices hs : s = 0 by rw [hs, map_zero, map_zero]
      have h_stalk_vanish : ∀ z : ↥V.left,
          ∃ (U_z : Y.Etale) (f_z : U_z ⟶ V) (w_z : ↥U_z.left),
            AlgebraicGeometry.Etale f_z.left ∧
            f_z.left.base w_z = z ∧
            K.obj.map (Opposite.op f_z) s = 0 := by
        intro z
        let y : ↥Y := V.hom.base z
        let Ω_y : Type u := AlgebraicClosure ↥(Y.residueField y)
        let S_y : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of Ω_y)
        let y_bar : S_y ⟶ Y :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(Y.residueField y) Ω_y)) ≫
            Y.fromSpecResidueField y
        let T₀ : S_y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 S_y) inferInstance
        let B_y : CategoryTheory.Functor Y.Etale S_y.Etale :=
          CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ y_bar
        let Φ_y := (hPointIso y).choose
        have hΦ_fib : Φ_y.fiber = B_y ⋙ CategoryTheory.coyoneda.obj (Opposite.op T₀) :=
          (hPointIso y).choose_spec.choose_spec.2.1
        have hy_base : y_bar.base (⊥ : PrimeSpectrum Ω_y) = y := by
          dsimp [y_bar]
          change (Y.fromSpecResidueField y).base _ = y
          simp
        haveI : AlgebraicGeometry.Etale V.hom := V.prop
        let q_P := CategoryTheory.Limits.pullback.snd V.hom y_bar
        haveI : AlgebraicGeometry.Etale q_P := inferInstance
        obtain ⟨p₀, hp₀_fst, _⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
            (f := V.hom) (g := y_bar) z (⊥ : PrimeSpectrum Ω_y) hy_base.symm
        obtain ⟨s_P, hs_q, hs_base⟩ := hSecAlgClosed Ω_y q_P p₀
        let z_bar : S_y ⟶ V.left := s_P ≫ CategoryTheory.Limits.pullback.fst V.hom y_bar
        have hz_hom : z_bar ≫ V.hom = 𝟙 S_y ≫ y_bar := by
          dsimp [z_bar]
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.condition]
          change s_P ≫ q_P ≫ y_bar = y_bar
          rw [← CategoryTheory.Category.assoc, hs_q, CategoryTheory.Category.id_comp]
        have hz_base : z_bar.base (⊥ : PrimeSpectrum Ω_y) = z := by
          change (CategoryTheory.Limits.pullback.fst V.hom y_bar).base
            (s_P.base (⊥ : PrimeSpectrum Ω_y)) = z
          rw [hs_base, hp₀_fst]
        let τ₀ : T₀ ⟶ B_y.obj V :=
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.Limits.pullback.lift z_bar (𝟙 S_y) hz_hom)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
        let τ_z : Φ_y.fiber.obj V := Eq.mp (congrArg (fun F => F.obj V) hΦ_fib.symm) τ₀
        have h_zero_K : CategoryTheory.Limits.IsZero
            ((Φ_y.sheafFiber (A := AddCommGrpCat.{u})).obj K) := hK_zero y
        have h_eq_zero : Φ_y.toPresheafFiber V τ_z K.obj s =
            Φ_y.toPresheafFiber V τ_z K.obj 0 :=
          (congrArg (fun (φ : K.obj.obj (Opposite.op V) ⟶ _) => φ.hom s)
            (h_zero_K.eq_of_tgt (Φ_y.toPresheafFiber V τ_z K.obj) 0)).trans
            (map_zero (Φ_y.toPresheafFiber V τ_z K.obj).hom).symm
        rw [Φ_y.toPresheafFiber_eq_iff' V τ_z s 0] at h_eq_zero
        obtain ⟨U_z, f_z, τ'_z, h_map_τ, h_map_s⟩ := h_eq_zero
        rw [map_zero] at h_map_s
        have hf_et : AlgebraicGeometry.Etale f_z.left := by
          haveI : AlgebraicGeometry.Etale (f_z.left ≫ V.hom) := by
            erw [CategoryTheory.MorphismProperty.Over.w f_z]
            exact U_z.prop
          exact CategoryTheory.MorphismProperty.of_postcomp (W' := @AlgebraicGeometry.Etale)
            (@AlgebraicGeometry.Etale) f_z.left V.hom inferInstance inferInstance
        let τ'₀ : T₀ ⟶ B_y.obj U_z := Eq.mp (congrArg (fun F => F.obj U_z) hΦ_fib) τ'_z
        have h_τ_comm : τ'₀ ≫ B_y.map f_z = τ₀ := by
          have h_fib_comm : ∀ (F₁ F₂ : Y.Etale ⥤ Type u) (hF : F₁ = F₂)
              (a : F₁.obj U_z) (b : F₂.obj V),
              F₁.map f_z a = Eq.mp (congrArg (fun F => F.obj V) hF.symm) b →
              F₂.map f_z (Eq.mp (congrArg (fun F => F.obj U_z) hF) a) = b := by
            rintro F₁ _ rfl a b h
            exact h
          exact h_fib_comm Φ_y.fiber (B_y ⋙ CategoryTheory.coyoneda.obj (Opposite.op T₀))
            hΦ_fib τ'_z τ₀ h_map_τ
        have h_left_comm : (τ'₀.left ≫ CategoryTheory.Limits.pullback.fst U_z.hom y_bar) ≫ f_z.left = z_bar := by
          have h1 := congrArg (fun (k : T₀ ⟶ B_y.obj V) =>
            k.left ≫ CategoryTheory.Limits.pullback.fst V.hom y_bar) h_τ_comm
          dsimp [τ₀, B_y] at h1
          erw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
            CategoryTheory.MorphismProperty.Over.pullback_map_left,
            CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.assoc] at h1
          exact h1
        let w_z : ↥U_z.left :=
          (τ'₀.left ≫ CategoryTheory.Limits.pullback.fst U_z.hom y_bar).base (⊥ : PrimeSpectrum Ω_y)
        have hw_z : f_z.left.base w_z = z :=
          (congrArg (fun k => k.base (⊥ : PrimeSpectrum Ω_y)) h_left_comm).trans hz_base
        exact ⟨U_z, f_z, w_z, hf_et, hw_z, h_map_s⟩
      let U_fam : ↥V.left → Y.Etale := fun z => (h_stalk_vanish z).choose
      let f_fam : ∀ z : ↥V.left, U_fam z ⟶ V := fun z => (h_stalk_vanish z).choose_spec.choose
      let S_cov : CategoryTheory.Sieve V :=
        CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows U_fam f_fam)
      have hS_mem : S_cov ∈ Y.smallEtaleTopology V := by
        rw [h_mem_etale]
        intro z
        obtain ⟨w_z, hf_et, hw_z, _⟩ := (h_stalk_vanish z).choose_spec.choose_spec
        exact ⟨U_fam z, f_fam z, w_z,
          ⟨U_fam z, 𝟙 _, f_fam z, CategoryTheory.Presieve.ofArrows.mk z,
            CategoryTheory.Category.id_comp _⟩,
          hf_et, hw_z⟩
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let g_s : Aℤ ⟶ K.obj.obj (Opposite.op V) := AddCommGrpCat.ofHom {
        toFun := fun n => n.down • s
        map_zero' := zero_zsmul s
        map_add' := fun a b => add_zsmul s a.down b.down
      }
      let g_0 : Aℤ ⟶ K.obj.obj (Opposite.op V) := 0
      have h_sep := (K.2 Aℤ S_cov hS_mem).isSeparatedFor
      have h_g_eq : g_s = g_0 := by
        apply h_sep.ext
        rintro W u ⟨U₀, w₀, z_arrow, ⟨z⟩, rfl⟩
        let f_op : Opposite.op V ⟶ Opposite.op (U_fam z) := (f_fam z).op
        let w_op : Opposite.op (U_fam z) ⟶ Opposite.op W := w₀.op
        change g_s ≫ K.obj.map (f_op ≫ w_op) = g_0 ≫ K.obj.map (f_op ≫ w_op)
        ext ⟨n⟩
        change K.obj.map (f_op ≫ w_op) (n • s) = K.obj.map (f_op ≫ w_op) 0
        rw [map_zero, K.obj.map_comp]
        change K.obj.map w_op (K.obj.map f_op (n • s)) = 0
        rw [map_zsmul]
        have hs0 : K.obj.map f_op s = 0 :=
          (h_stalk_vanish z).choose_spec.choose_spec.choose_spec.2.2
        rw [hs0, smul_zero, map_zero]
      have h_eval := congrArg (fun (g : Aℤ ⟶ K.obj.obj (Opposite.op V)) => g.hom (ULift.up 1)) h_g_eq
      dsimp [g_s, g_0] at h_eval
      rwa [one_zsmul] at h_eval

    have hEpiRefl : (∀ (y : ↥Y),
          let Ω_y : Type u := AlgebraicClosure ↥(Y.residueField y)
          let S_y : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of Ω_y)
          let y_bar : S_y ⟶ Y :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(Y.residueField y) Ω_y)) ≫
              Y.fromSpecResidueField y
          let B_y : CategoryTheory.Functor Y.Etale S_y.Etale :=
            CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ y_bar
          CategoryTheory.Epi ((@CategoryTheory.Functor.sheafPullback _ _ _ _ B_y AddCommGrpCat.{u} _
            Y.smallEtaleTopology S_y.smallEtaleTopology (hc_y y) (hra_y y)).map φ)) →
        CategoryTheory.Epi φ := by
      intro h_all_epi
      rw [CategoryTheory.Preadditive.epi_iff_isZero_cokernel]
      apply hJointZero (CategoryTheory.Limits.cokernel φ)
      intro y
      let Φ_y := (hPointIso y).choose
      let Φ₀ := (hPointIso y).choose_spec.choose
      obtain ⟨θ_y⟩ := (hPointIso y).choose_spec.choose_spec.2.2
      let SF_y := Φ_y.sheafFiber (A := AddCommGrpCat.{u})
      let SF₀ := Φ₀.sheafFiber (A := AddCommGrpCat.{u})
      obtain ⟨adj_sky₀⟩ := hSkyAdj Φ₀
      haveI : SF₀.IsLeftAdjoint := adj_sky₀.isLeftAdjoint
      haveI := h_all_epi y
      haveI : CategoryTheory.Epi (SF₀.map ((@CategoryTheory.Functor.sheafPullback _ _ _ _ _ AddCommGrpCat.{u} _
        Y.smallEtaleTopology _ (hc_y y) (hra_y y)).map φ)) := inferInstance
      have h_nat := θ_y.inv.naturality φ
      dsimp at h_nat
      have h_eq : SF_y.map φ = θ_y.inv.app H₁ ≫
          SF₀.map ((@CategoryTheory.Functor.sheafPullback _ _ _ _ _ AddCommGrpCat.{u} _
            Y.smallEtaleTopology _ (hc_y y) (hra_y y)).map φ) ≫
          θ_y.hom.app H₂ := by
        rw [← CategoryTheory.Category.assoc, ← h_nat, CategoryTheory.Category.assoc,
          θ_y.inv_hom_id_app, CategoryTheory.Category.comp_id]
      haveI : CategoryTheory.Epi (SF_y.map φ) := by rw [h_eq]; infer_instance
      have h_zero_cok : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel (SF_y.map φ)) :=
        CategoryTheory.Limits.isZero_cokernel_of_epi (SF_y.map φ)
      haveI : CategoryTheory.Limits.PreservesFiniteColimits SF_y := inferInstance
      haveI : CategoryTheory.IsIso (CategoryTheory.Limits.cokernelComparison φ SF_y) := inferInstance
      exact h_zero_cok.of_iso (CategoryTheory.asIso (CategoryTheory.Limits.cokernelComparison φ SF_y)).symm

    refine ⟨hEpiRefl, ?_⟩
    intro h_all_iso
    haveI : CategoryTheory.Epi φ := hEpiRefl (fun y => by haveI := h_all_iso y; infer_instance)
    haveI : CategoryTheory.Mono φ := by
      rw [CategoryTheory.Preadditive.mono_iff_isZero_kernel]
      apply hJointZero (CategoryTheory.Limits.kernel φ)
      intro y
      let Φ_y := (hPointIso y).choose
      let Φ₀ := (hPointIso y).choose_spec.choose
      obtain ⟨θ_y⟩ := (hPointIso y).choose_spec.choose_spec.2.2
      let SF_y := Φ_y.sheafFiber (A := AddCommGrpCat.{u})
      let SF₀ := Φ₀.sheafFiber (A := AddCommGrpCat.{u})
      haveI := h_all_iso y
      have h_nat := θ_y.inv.naturality φ
      dsimp at h_nat
      have h_eq : SF_y.map φ = θ_y.inv.app H₁ ≫
          SF₀.map ((@CategoryTheory.Functor.sheafPullback _ _ _ _ _ AddCommGrpCat.{u} _
            Y.smallEtaleTopology _ (hc_y y) (hra_y y)).map φ) ≫
          θ_y.hom.app H₂ := by
        rw [← CategoryTheory.Category.assoc, ← h_nat, CategoryTheory.Category.assoc,
          θ_y.inv_hom_id_app, CategoryTheory.Category.comp_id]
      haveI : CategoryTheory.IsIso (SF_y.map φ) := by rw [h_eq]; infer_instance
      have h_zero_ker : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel (SF_y.map φ)) :=
        CategoryTheory.Limits.isZero_kernel_of_mono (SF_y.map φ)
      haveI : CategoryTheory.Limits.PreservesFiniteLimits SF_y := inferInstance
      haveI : CategoryTheory.IsIso (CategoryTheory.Limits.kernelComparison φ SF_y) := inferInstance
      exact h_zero_ker.of_iso (CategoryTheory.asIso (CategoryTheory.Limits.kernelComparison φ SF_y))
    exact CategoryTheory.isIso_of_mono_of_epi φ
  
  
  
  have hPBC_congr : ∀ {Z T T' Z' : AlgebraicGeometry.Scheme.{u}}
      {h : Z ⟶ T} {k₁ k₂ : T' ⟶ T} {h' : Z' ⟶ T'} {k'₁ k'₂ : Z' ⟶ Z}
      (hk : k₁ = k₂) (hk' : k'₁ = k'₂)
      (hp₁ : CategoryTheory.IsPullback k'₁ h' h k₁)
      (hp₂ : CategoryTheory.IsPullback k'₂ h' h k₂),
      WeilEtaleSquareDegreeZeroPBC h k₁ h' k'₁ hp₁ →
      WeilEtaleSquareDegreeZeroPBC h k₂ h' k'₂ hp₂ := by
    intro Z T T' Z' h k₁ k₂ h' k'₁ k'₂ hk hk' hp₁ hp₂ hPBC
    subst hk; subst hk'
    exact hPBC

  have hArtScheme : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      {Z₀ : AlgebraicGeometry.Scheme.{u}}
      (h₀ : Z₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      [AlgebraicGeometry.IsFinite h₀],
      WeilEtalePushforwardPreservesEpi h₀ := by
    intro Ω _ _ Z₀ h₀ _
    haveI : AlgebraicGeometry.IsAffine Z₀ := AlgebraicGeometry.isAffine_of_isAffineHom h₀
    let C₀ : Type u := ↑(Z₀.presheaf.obj (Opposite.op ⊤))
    let f_raw : AlgebraicGeometry.Spec (CommRingCat.of C₀) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
      Z₀.isoSpec.inv ≫ h₀
    letI : Algebra Ω C₀ := (AlgebraicGeometry.Spec.preimage f_raw).hom.toAlgebra
    have h_map_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω C₀)) = f_raw :=
      AlgebraicGeometry.Spec.map_preimage f_raw
    haveI : AlgebraicGeometry.IsFinite f_raw := inferInstance
    have h_fin_alg : (algebraMap Ω C₀).Finite := by
      have h_spec : AlgebraicGeometry.IsFinite
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω C₀))) := by
        rw [h_map_eq]; infer_instance
      exact (AlgebraicGeometry.IsFinite.SpecMap_iff _).mp h_spec
    haveI : Module.Finite Ω C₀ := RingHom.finite_algebraMap.mp h_fin_alg
    have h_epi_aff := hArtEpi Ω C₀
    have h_fac : Z₀.isoSpec.hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω C₀)) = h₀ := by
      rw [h_map_eq]
      dsimp [f_raw]
      exact Z₀.isoSpec.hom_inv_id_assoc h₀
    rw [← h_fac]
    exact hIsoEpi Z₀.isoSpec _ h_epi_aff

  have hGeomPBC : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      {Z T Z₀ : AlgebraicGeometry.Scheme.{u}}
      (h : Z ⟶ T) [AlgebraicGeometry.IsFinite h]
      (t_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ T)
      (h₀ : Z₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (g'₀ : Z₀ ⟶ Z)
      (hpb_t : CategoryTheory.IsPullback g'₀ h₀ h t_bar),
      WeilEtaleSquareDegreeZeroPBC h t_bar h₀ g'₀ hpb_t := by
    intro Ω _ _ Z T Z₀ h _ t_bar h₀ g'₀ hpb_t
    let S₀ := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    obtain ⟨U₀, hU₀_aff, htU₀, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := t_bar.base (⊥ : PrimeSpectrum Ω)) (U := (⊤ : T.Opens)) trivial
    haveI : AlgebraicGeometry.IsAffine U₀.toScheme := hU₀_aff
    have h_range : Set.range t_bar.base ⊆ Set.range U₀.ι.base := by
      rintro _ ⟨pt, rfl⟩
      have hpt : pt = (⊥ : PrimeSpectrum Ω) := Subsingleton.elim _ _
      rw [hpt, AlgebraicGeometry.Scheme.Opens.range_ι]
      exact htU₀
    let t_U : S₀ ⟶ U₀.toScheme := AlgebraicGeometry.IsOpenImmersion.lift U₀.ι t_bar h_range
    have ht_U : t_U ≫ U₀.ι = t_bar := AlgebraicGeometry.IsOpenImmersion.lift_fac U₀.ι t_bar h_range
    let Z_U := (h ⁻¹ᵁ U₀).toScheme
    let h_U : Z_U ⟶ U₀.toScheme := h ∣_ U₀
    have hpb_res : CategoryTheory.IsPullback (h ⁻¹ᵁ U₀).ι h_U h U₀.ι :=
      (AlgebraicGeometry.isPullback_morphismRestrict h U₀).flip
    haveI : AlgebraicGeometry.IsFinite h_U := inferInstance
    haveI : AlgebraicGeometry.IsAffine Z_U := AlgebraicGeometry.isAffine_of_isAffineHom h_U
    let R₀ : Type u := ↑(U₀.toScheme.presheaf.obj (Opposite.op ⊤))
    let B₀ : Type u := ↑(Z_U.presheaf.obj (Opposite.op ⊤))
    let f_aff_raw : AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      Z_U.isoSpec.inv ≫ h_U ≫ U₀.toScheme.isoSpec.hom
    letI : Algebra R₀ B₀ := (AlgebraicGeometry.Spec.preimage f_aff_raw).hom.toAlgebra
    let f_aff := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₀))
    have hf_aff_eq : f_aff = f_aff_raw := AlgebraicGeometry.Spec.map_preimage f_aff_raw
    haveI : AlgebraicGeometry.IsFinite f_aff_raw := inferInstance
    have h_fin_RB : (algebraMap R₀ B₀).Finite := by
      have h_spec : AlgebraicGeometry.IsFinite f_aff := by rw [hf_aff_eq]; infer_instance
      exact (AlgebraicGeometry.IsFinite.SpecMap_iff _).mp h_spec
    haveI : Module.Finite R₀ B₀ := RingHom.finite_algebraMap.mp h_fin_RB
    let s₀_raw : S₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      t_U ≫ U₀.toScheme.isoSpec.hom
    letI : Algebra R₀ Ω := (AlgebraicGeometry.Spec.preimage s₀_raw).hom.toAlgebra
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ Ω))
    have hs₀_eq : s₀ = s₀_raw := AlgebraicGeometry.Spec.map_preimage s₀_raw
    let j₀ : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ T := U₀.toScheme.isoSpec.inv ≫ U₀.ι
    let j'₀ : AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ Z := Z_U.isoSpec.inv ≫ (h ⁻¹ᵁ U₀).ι
    haveI : AlgebraicGeometry.IsOpenImmersion j₀ := inferInstance
    have hpb_iso_aff : CategoryTheory.IsPullback Z_U.isoSpec.inv f_aff h_U U₀.toScheme.isoSpec.inv := by
      refine CategoryTheory.IsPullback.of_horiz_isIso ⟨?_⟩
      rw [hf_aff_eq]
      dsimp [f_aff_raw]
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
        CategoryTheory.Category.comp_id]
    have hpb_right : CategoryTheory.IsPullback j'₀ f_aff h j₀ :=
      hpb_iso_aff.paste_horiz hpb_res
    have hPBC_right : WeilEtaleSquareDegreeZeroPBC h j₀ f_aff j'₀ hpb_right :=
      hS4 h j₀ f_aff j'₀ hpb_right
    let C₀ := TensorProduct R₀ Ω B₀
    let f₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeLeft : Ω →ₐ[R₀] C₀).toRingHom)
    let g'₀_aff := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : B₀ →ₐ[R₀] C₀).toRingHom)
    have h_incL : Algebra.TensorProduct.includeLeftRingHom =
        (Algebra.TensorProduct.includeLeft : Ω →ₐ[R₀] C₀).toRingHom :=
      RingHom.ext (fun _ => rfl)
    have h_push : CategoryTheory.IsPushout
        (CommRingCat.ofHom (algebraMap R₀ Ω))
        (CommRingCat.ofHom (algebraMap R₀ B₀))
        (CommRingCat.ofHom (Algebra.TensorProduct.includeLeft : Ω →ₐ[R₀] C₀).toRingHom)
        (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : B₀ →ₐ[R₀] C₀).toRingHom) := by
      rw [← h_incL]
      exact CommRingCat.isPushout_tensorProduct R₀ Ω B₀
    have hpb₀ : CategoryTheory.IsPullback g'₀_aff f₀ f_aff s₀ :=
      AlgebraicGeometry.Scheme.Spec.map_isPullback h_push.op
    have hPBC₀ : WeilEtaleSquareDegreeZeroPBC f_aff s₀ f₀ g'₀_aff hpb₀ :=
      hAffGeom R₀ B₀ Ω hpb₀
    have hPBC_pasted := (hS3_paste_and_cancel h j₀ f_aff j'₀ s₀ f₀ g'₀_aff hpb_right hpb₀).1
      hPBC_right hPBC₀
    have hs_j₀ : s₀ ≫ j₀ = t_bar := by
      rw [hs₀_eq]
      dsimp [s₀_raw, j₀]
      rw [CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc (f := U₀.toScheme.isoSpec.hom),
        U₀.toScheme.isoSpec.hom_inv_id, CategoryTheory.Category.id_comp, ht_U]
    have hpb_mid : CategoryTheory.IsPullback (g'₀_aff ≫ j'₀) f₀ h t_bar := by
      rw [← hs_j₀]
      exact hpb₀.paste_horiz hpb_right
    have hPBC_mid : WeilEtaleSquareDegreeZeroPBC h t_bar f₀ (g'₀_aff ≫ j'₀) hpb_mid :=
      hPBC_congr hs_j₀ rfl (hpb₀.paste_horiz hpb_right) hpb_mid hPBC_pasted
    let e_cone := hpb_t.isoIsPullback _ _ hpb_mid
    have he_fst : e_cone.hom ≫ (g'₀_aff ≫ j'₀) = g'₀ :=
      CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hpb_t hpb_mid
    have he_snd : e_cone.hom ≫ f₀ = h₀ :=
      CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hpb_t hpb_mid
    have hpb_cone : CategoryTheory.IsPullback e_cone.hom h₀ f₀ (𝟙 S₀) :=
      CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [he_snd, CategoryTheory.Category.comp_id]⟩
    have hPBC_cone : WeilEtaleSquareDegreeZeroPBC f₀ (𝟙 S₀) h₀ e_cone.hom hpb_cone :=
      hS4 f₀ (𝟙 S₀) h₀ e_cone.hom hpb_cone
    have hPBC_tot := (hS3_paste_and_cancel h t_bar f₀ (g'₀_aff ≫ j'₀) (𝟙 S₀) h₀ e_cone.hom
      hpb_mid hpb_cone).1 hPBC_mid hPBC_cone
    exact hPBC_congr (CategoryTheory.Category.id_comp t_bar) he_fst
      (hpb_cone.paste_horiz hpb_mid) hpb_t hPBC_tot

  
  haveI : AlgebraicGeometry.IsFinite f' :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb
      (inferInstance : AlgebraicGeometry.IsFinite f)
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  obtain ⟨hc_f, _⟩ := h_hc_hra f
  obtain ⟨hc_g, hra_g⟩ := h_hc_hra g
  obtain ⟨hc_f', _⟩ := h_hc_hra f'
  obtain ⟨hc_g', hra_g'⟩ := h_hc_hra g'
  let hc_s' : ∀ (s' : ↥S'),
      let Ω_s' : Type u := AlgebraicClosure ↥(S'.residueField s')
      let S_s' : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of Ω_s')
      let s'_bar : S_s' ⟶ S' :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(S'.residueField s') Ω_s')) ≫
          S'.fromSpecResidueField s'
      let B_s' : CategoryTheory.Functor S'.Etale S_s'.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ s'_bar
      B_s'.IsContinuous S'.smallEtaleTopology S_s'.smallEtaleTopology :=
    fun s' => (h_hc_hra _).1
  let hra_s' : ∀ (s' : ↥S'),
      let Ω_s' : Type u := AlgebraicClosure ↥(S'.residueField s')
      let S_s' : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of Ω_s')
      let s'_bar : S_s' ⟶ S' :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(S'.residueField s') Ω_s')) ≫
          S'.fromSpecResidueField s'
      let B_s' : CategoryTheory.Functor S'.Etale S_s'.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ s'_bar
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B_s' AddCommGrpCat.{u} _
        S'.smallEtaleTopology S_s'.smallEtaleTopology (hc_s' s')).IsRightAdjoint :=
    fun s' => (h_hc_hra _).2
  letI := hc_f; letI := hc_g; letI := hc_f'; letI := hc_g'
  letI := hra_g; letI := hra_g'
  refine ⟨⟨hc_f', fun G₁ G₂ α hα => ?_⟩, ⟨hc_f, hc_g, hc_f', hc_g', hra_g, hra_g', fun F => ?_⟩⟩
  · haveI : CategoryTheory.Epi α := hα
    let B_f' : CategoryTheory.Functor S'.Etale X'.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f'
    let pf_f' := B_f'.sheafPushforwardContinuous AddCommGrpCat.{u}
      S'.smallEtaleTopology X'.smallEtaleTopology
    apply (hS5 S' (pf_f'.map α) hc_s' hra_s').1
    intro s'
    let Ω_s' : Type u := AlgebraicClosure ↥(S'.residueField s')
    let S_s' : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of Ω_s')
    let s'_bar : S_s' ⟶ S' :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(S'.residueField s') Ω_s')) ≫
        S'.fromSpecResidueField s'
    let g'_s := CategoryTheory.Limits.pullback.fst f' s'_bar
    let f'_s := CategoryTheory.Limits.pullback.snd f' s'_bar
    have hpb_s : CategoryTheory.IsPullback g'_s f'_s f' s'_bar :=
      CategoryTheory.IsPullback.of_hasPullback f' s'_bar
    haveI : AlgebraicGeometry.IsFinite f'_s := inferInstance
    exact hS3_nat f' s'_bar f'_s g'_s hpb_s
      (hGeomPBC Ω_s' f' s'_bar f'_s g'_s hpb_s)
      (hArtScheme Ω_s' f'_s)
      hc_f' (hc_s' s') (hra_s' s') G₁ G₂ α
  · let B_f : CategoryTheory.Functor S.Etale X.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let B_g : CategoryTheory.Functor S.Etale S'.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g
    let B_f' : CategoryTheory.Functor S'.Etale X'.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f'
    let B_g' : CategoryTheory.Functor X.Etale X'.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g'
    let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u} S.smallEtaleTopology X.smallEtaleTopology
    let pf_f' := B_f'.sheafPushforwardContinuous AddCommGrpCat.{u} S'.smallEtaleTopology X'.smallEtaleTopology
    let pb_g' := B_g'.sheafPullback AddCommGrpCat.{u} X.smallEtaleTopology X'.smallEtaleTopology
    let adj_g := B_g.sheafAdjunctionContinuous AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
    let adj_g' := B_g'.sheafAdjunctionContinuous AddCommGrpCat.{u} X.smallEtaleTopology X'.smallEtaleTopology
    let e_fun : B_f ⋙ B_g' ≅ B_g ⋙ B_f' :=
      (CategoryTheory.MorphismProperty.Over.pullbackComp g' f).symm ≪≫
        CategoryTheory.MorphismProperty.Over.pullbackCongr hpb.w ≪≫
        CategoryTheory.MorphismProperty.Over.pullbackComp f' g
    letI : (B_f ⋙ B_g').IsContinuous S.smallEtaleTopology X'.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp B_f B_g'
        S.smallEtaleTopology X.smallEtaleTopology X'.smallEtaleTopology
    letI : (B_g ⋙ B_f').IsContinuous S.smallEtaleTopology X'.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp B_g B_f'
        S.smallEtaleTopology S'.smallEtaleTopology X'.smallEtaleTopology
    let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousIso e_fun AddCommGrpCat.{u}
      S.smallEtaleTopology X'.smallEtaleTopology
    let bc_fg := (adj_g.homEquiv (pf_f.obj F) (pf_f'.obj (pb_g'.obj F))).symm
      (pf_f.map (adj_g'.unit.app F) ≫ e_pf.hom.app (pb_g'.obj F))
    apply (hS5 S' bc_fg hc_s' hra_s').2
    intro s'
    let Ω_s' : Type u := AlgebraicClosure ↥(S'.residueField s')
    let S_s' : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of Ω_s')
    let s'_bar : S_s' ⟶ S' :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(S'.residueField s') Ω_s')) ≫
        S'.fromSpecResidueField s'
    let g'_s := CategoryTheory.Limits.pullback.fst f' s'_bar
    let f'_s := CategoryTheory.Limits.pullback.snd f' s'_bar
    have hpb_s : CategoryTheory.IsPullback g'_s f'_s f' s'_bar :=
      CategoryTheory.IsPullback.of_hasPullback f' s'_bar
    exact (hS3_paste_and_cancel f g f' g' s'_bar f'_s g'_s hpb hpb_s).2
      (hGeomPBC Ω_s' f' s'_bar f'_s g'_s hpb_s)
      (hGeomPBC Ω_s' f (s'_bar ≫ g) f'_s (g'_s ≫ g') (hpb_s.paste_horiz hpb))
      hc_f hc_g hc_f' hc_g' (hc_s' s') hra_g hra_g' (hra_s' s') F

theorem weil_pointed_etale_strictly_local_envelope (R₀ Ω : Type u) [CommRing R₀] [Field Ω] [IsAlgClosed Ω] [Algebra R₀ Ω] :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra R₀ A) (_ : Algebra A Ω)
      (_ : IsScalarTower R₀ A Ω),
      WeilIsPointedEtaleStrictlyLocalEnvelope R₀ Ω A :=
by
  classical
  
  have h_pillar1 :
      (∀ (S : Type u) [CommRing S] [Algebra R₀ S] [Algebra.Etale R₀ S],
        ∃ (n : ℕ) (I : Ideal (MvPolynomial (Fin n) R₀))
          (_ : Algebra.Etale R₀ (MvPolynomial (Fin n) R₀ ⧸ I)),
          Nonempty ((MvPolynomial (Fin n) R₀ ⧸ I) ≃ₐ[R₀] S)) ∧
      (∀ (S₁ S₂ : Type u)
          [CommRing S₁] [Algebra R₀ S₁] [Algebra.Etale R₀ S₁]
          [CommRing S₂] [Algebra R₀ S₂] [Algebra.Etale R₀ S₂]
          (ψ₂ : S₂ →+* Ω) (u₁ u₂ : S₁ →ₐ[R₀] S₂),
        ψ₂.comp u₁.toRingHom = ψ₂.comp u₂.toRingHom →
        ∃ (S₃ : Type u) (_ : CommRing S₃) (_ : Algebra R₀ S₃) (_ : Algebra.Etale R₀ S₃)
          (v : S₂ →ₐ[R₀] S₃) (ψ₃ : S₃ →+* Ω),
          v.toRingHom.Etale ∧
          ψ₃.comp v.toRingHom = ψ₂ ∧
          v.comp u₁ = v.comp u₂) ∧
      (∀ (S A : Type u)
          [CommRing S] [Algebra R₀ S] [Algebra.Etale R₀ S]
          [CommRing A] [IsLocalRing A] [Algebra R₀ A] [Algebra A Ω],
        IsLocalRing.maximalIdeal A = RingHom.ker (algebraMap A Ω) →
        ∀ (φ₁ φ₂ : S →ₐ[R₀] A),
          (algebraMap A Ω).comp φ₁.toRingHom = (algebraMap A Ω).comp φ₂.toRingHom →
          φ₁ = φ₂) := by
    have h_diag : ∀ (S T : Type u)
        [CommRing S] [Algebra R₀ S] [Algebra.Etale R₀ S]
        [CommRing T] [Algebra R₀ T]
        (ψ : T →+* Ω) (w₁ w₂ : S →ₐ[R₀] T),
        ψ.comp w₁.toRingHom = ψ.comp w₂.toRingHom →
        ∃ e : T, ψ e = 1 ∧ ∀ s : S, (w₁ s - w₂ s) * e = 0 := by
      intro S T _ _ _ _ _ ψ w₁ w₂ hψ
      obtain ⟨t, ht_kill, ht_mul⟩ :=
        (Algebra.FormallyUnramified.iff_exists_tensorProduct (R := R₀) (S := S)).mp inferInstance
      let pm : TensorProduct R₀ S S →ₐ[R₀] T :=
        Algebra.TensorProduct.lift w₂ w₁ (fun _ _ => Commute.all _ _)
      refine ⟨pm t, ?_, ?_⟩
      · have h_ev : ∀ z : TensorProduct R₀ S S,
            ψ (pm z) = ψ (w₁ (Algebra.TensorProduct.lmul' R₀ z)) := by
          intro z
          induction z using TensorProduct.inductionOn with
          | tmul s₁ s₂ =>
            have hs₁ : ψ (w₂ s₁) = ψ (w₁ s₁) := (RingHom.congr_fun hψ s₁).symm
            rw [Algebra.TensorProduct.lift_tmul, map_mul, hs₁,
              Algebra.TensorProduct.lmul'_apply_tmul, map_mul, map_mul]
          | add z₁ z₂ hz₁ hz₂ =>
            rw [map_add, map_add, hz₁, hz₂, map_add, map_add, map_add]
        rw [h_ev t, ht_mul, map_one, map_one]
      · intro s
        have h_pm_sub : pm ((1 : S) ⊗ₜ[R₀] s - s ⊗ₜ[R₀] (1 : S)) = w₁ s - w₂ s := by
          rw [map_sub, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul,
            map_one, map_one, one_mul, mul_one]
        calc
          (w₁ s - w₂ s) * pm t = pm ((1 : S) ⊗ₜ[R₀] s - s ⊗ₜ[R₀] (1 : S)) * pm t := by
            rw [h_pm_sub]
          _ = pm (((1 : S) ⊗ₜ[R₀] s - s ⊗ₜ[R₀] (1 : S)) * t) := (map_mul pm _ t).symm
          _ = pm 0 := by rw [ht_kill s]
          _ = 0 := map_zero pm
    refine ⟨?_, ?_, ?_⟩
    · intro S _ _ _
      have hFT : Algebra.FiniteType R₀ S := inferInstance
      obtain ⟨n, f, hf_surj⟩ := (Algebra.FiniteType.iff_quotient_mvPolynomial'').mp hFT
      let I : Ideal (MvPolynomial (Fin n) R₀) := RingHom.ker f.toRingHom
      let f_bar : (MvPolynomial (Fin n) R₀ ⧸ I) →ₐ[R₀] S :=
        Ideal.Quotient.liftₐ I f (fun _ hx => hx)
      have h_bij : Function.Bijective f_bar := by
        refine ⟨?_, ?_⟩
        · intro x y hxy
          obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
          obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective y
          apply (Ideal.Quotient.eq).mpr
          change f (p - q) = 0
          rw [map_sub, sub_eq_zero]
          exact hxy
        · intro s
          obtain ⟨p, rfl⟩ := hf_surj s
          exact ⟨Ideal.Quotient.mk I p, rfl⟩
