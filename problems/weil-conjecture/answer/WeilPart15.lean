      {A₀ A₁ A₂ A₃ A₄ A₅ W₀ B₄ R_sch B₃ T_pt : 𝒞}
      (m₁ : A₀ ⟶ A₁) (m₂ : A₁ ⟶ A₂) (m₃ : A₂ ⟶ A₃) (m₄ : A₃ ⟶ A₄) (m₅ : A₄ ⟶ A₅)
