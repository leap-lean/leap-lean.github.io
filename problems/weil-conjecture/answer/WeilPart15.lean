    have hℓ_prime : Nat.Prime ℓ := Fact.out
    have : NeZero ℓ := ⟨hℓ_prime.ne_zero⟩
    have : Fact (1 < ℓ) := ⟨hℓ_prime.one_lt⟩
    have hRℓ_cast_zero : (ℓ : R_ℓ) = 0 := ULift.ext _ _ (CharP.cast_eq_zero (ZMod ℓ) ℓ)
    have hRℓ_natCast_val : ∀ c : R_ℓ, (c.down.val : R_ℓ) = c :=
      fun c => ULift.ext _ _ (ZMod.natCast_zmod_val c.down)
    have hMod_smul : ∀ (V : ModuleCat.{u, u} R_ℓ) (c : R_ℓ) (v : V), c • v = c.down.val • v := by
      intro V c v
      conv_lhs => rw [← hRℓ_natCast_val c]
      exact Nat.cast_smul_eq_nsmul R_ℓ c.down.val v
    have hMod_tor : ∀ (V : ModuleCat.{u, u} R_ℓ) (v : V), ℓ • v = 0 := by
      intro V v
      rw [← Nat.cast_smul_eq_nsmul R_ℓ ℓ v, hRℓ_cast_zero, zero_smul]
    let mkEllMod : ∀ (A : Type u) [AddCommGroup A], (∀ a : A, ℓ • a = 0) → Module R_ℓ A :=
      fun A _ hA =>
        { smul := fun c a => c.down.val • a
          one_smul := fun a => by
            change (1 : ZMod ℓ).val • a = a
            rw [ZMod.val_one, one_nsmul]
          mul_smul := fun c₁ c₂ a => by
            change (c₁.down * c₂.down).val • a = c₁.down.val • (c₂.down.val • a)
            have hdiv := Nat.div_add_mod (c₁.down.val * c₂.down.val) ℓ
            rw [ZMod.val_mul]
            have hmul : (c₁.down.val * c₂.down.val) • a =
                ((c₁.down.val * c₂.down.val) % ℓ) • a := by
              conv_lhs => rw [← hdiv]
              rw [add_nsmul, mul_comm ℓ _, mul_nsmul, hA, zero_add]
            rw [← hmul, mul_comm, mul_nsmul]
