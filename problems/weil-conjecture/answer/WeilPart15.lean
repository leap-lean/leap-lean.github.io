      rw [Finset.prod_cons, Finset.prod_cons, Finset.sum_cons]
      refine ⟨?_, ?_⟩
      · rw [TrivSqZeroExt.fst_mul, map_mul, ih_fst]
      · rw [dlogB_mul hfa ht_ne, ih_dlog]
  have hPi_dlog := dlogB_prod Finset.univ (fun j : Fin d => (Ψ (factor_D j)) ^ ℓ) (by
    intro j _
    rw [(dlogB_pow (Ψ (factor_D j)) (by rw [hfac_fst]; exact hπ_ne j) ℓ).1, hfac_fst]
    exact pow_ne_zero ℓ (hπ_ne j))
  have hPi_fst_K : germB₀ (Finset.univ.prod fun j : Fin d => (Ψ (factor_D j)) ^ ℓ).fst =
      Finset.univ.prod (fun j : Fin d => (germB₀ (π_q j)) ^ ℓ) := by
    rw [hPi_dlog.1]
    refine Finset.prod_congr rfl fun j _ => ?_
    rw [TrivSqZeroExt.fst_pow, map_pow, hfac_fst]
  have hPi_fst_ne : germB₀ (Finset.univ.prod fun j : Fin d => (Ψ (factor_D j)) ^ ℓ).fst ≠ 0 := by
    rw [hPi_fst_K]
    exact Finset.prod_ne_zero_iff.mpr fun j _ => pow_ne_zero ℓ (hπ_ne j)
  have hClear_fst_K : (germB₀ h₀) ^ M_exp * germB₀ F₀ =
      (germB₀ w'_0 * Finset.univ.prod (fun j : Fin d => (germB₀ (π_q j)) ^ ℓ)) * germB₀ N₀ := by
    have h1 := congrArg (fun z : DualNumber B₀ => germB₀ z.fst) hClear_B
    simpa only [TrivSqZeroExt.fst_mul, TrivSqZeroExt.fst_inl, hFG_fst, map_mul, map_pow,
      hPi_fst_K] using h1
  have hLHS_K_ne : (germB₀ h₀) ^ M_exp * germB₀ F₀ ≠ 0 :=
    mul_ne_zero (pow_ne_zero M_exp hh₀) hF₀
  have hRHS_K_ne :
      (germB₀ w'_0 * Finset.univ.prod (fun j : Fin d => (germB₀ (π_q j)) ^ ℓ)) * germB₀ N₀ ≠ 0 :=
    hClear_fst_K ▸ hLHS_K_ne
  have hN₀ : germB₀ N₀ ≠ 0 := right_ne_zero_of_mul hRHS_K_ne
  have hw'_K_ne : germB₀ w'_0 ≠ 0 := left_ne_zero_of_mul (left_ne_zero_of_mul hRHS_K_ne)
  have hProd_K : (Finset.univ.prod fun i : Fin K_pos => germB₀ (u_pos₀ i)) *
      ((germB₀ h₀) ^ M_exp * germB₀ F₀) =
      (germB₀ h₀) ^ (2 * m_W) * germB₀ Δ_pos₀ *
        (Finset.univ.prod fun j : Fin d => (germB₀ (π_q j)) ^ ℓ) * germB₀ N₀ := by
    have hUw'_K : (Finset.univ.prod fun i : Fin K_pos => germB₀ (u_pos₀ i)) * germB₀ w'_0 =
        (germB₀ h₀) ^ (2 * m_W) * germB₀ Δ_pos₀ := by
      have := congrArg germB₀ hUw'_fst
      simpa only [U_pos_prod, map_mul, map_prod, map_pow] using this
    calc
      (Finset.univ.prod fun i : Fin K_pos => germB₀ (u_pos₀ i)) *
          ((germB₀ h₀) ^ M_exp * germB₀ F₀) =
        ((Finset.univ.prod fun i : Fin K_pos => germB₀ (u_pos₀ i)) * germB₀ w'_0) *
          (Finset.univ.prod fun j : Fin d => (germB₀ (π_q j)) ^ ℓ) * germB₀ N₀ := by
        rw [hClear_fst_K]; ring
      _ = (germB₀ h₀) ^ (2 * m_W) * germB₀ Δ_pos₀ *
            (Finset.univ.prod fun j : Fin d => (germB₀ (π_q j)) ^ ℓ) * germB₀ N₀ := by
        rw [hUw'_K]
  let α_pert : Fin d → k := fun j => (ℓ : k) * c_pert j
  have hFrac_K : germB₀ G / germB₀ F₀ =
      germB₀ N₁ / germB₀ N₀ -
        Finset.univ.sum (fun j : Fin d => k_to_K (α_pert j) / germB₀ (π_q j)) := by
    have hdlog_eq := congrArg dlogB hClear_B
    have hdlog_lhs : dlogB (TrivSqZeroExt.inl (h₀ ^ M_exp) * FG_B) = germB₀ G / germB₀ F₀ := by
      rw [dlogB_mul (by simp only [TrivSqZeroExt.fst_inl, map_pow]; exact pow_ne_zero _ hh₀)
        (by rw [hFG_fst]; exact hF₀), dlogB_inl, zero_add]
      simp only [dlogB, hFG_fst, hFG_snd]
    have hdlog_rhs : dlogB ((TrivSqZeroExt.inl w'_0 *
        Finset.univ.prod (fun j : Fin d => (Ψ (factor_D j)) ^ ℓ)) * N_B) =
        germB₀ N₁ / germB₀ N₀ -
          Finset.univ.sum (fun j : Fin d => k_to_K (α_pert j) / germB₀ (π_q j)) := by
      have hwPi_ne : germB₀ (TrivSqZeroExt.inl w'_0 *
          Finset.univ.prod (fun j : Fin d => (Ψ (factor_D j)) ^ ℓ)).fst ≠ 0 := by
        rw [TrivSqZeroExt.fst_mul, TrivSqZeroExt.fst_inl, map_mul]
        exact mul_ne_zero hw'_K_ne hPi_fst_ne
      rw [dlogB_mul hwPi_ne hN₀, dlogB_mul (by simpa using hw'_K_ne) hPi_fst_ne,
        dlogB_inl, zero_add, hPi_dlog.2]
      have hsum_eq : (Finset.univ.sum fun j : Fin d => dlogB ((Ψ (factor_D j)) ^ ℓ)) =
          - Finset.univ.sum (fun j : Fin d => k_to_K (α_pert j) / germB₀ (π_q j)) := by
        rw [← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [(dlogB_pow (Ψ (factor_D j)) (by rw [hfac_fst]; exact hπ_ne j) ℓ).2]
        simp only [dlogB, hfac_fst, hfac_snd, map_neg, hgk_apply, α_pert, map_mul, map_natCast]
        ring
      rw [hsum_eq]
      change - (Finset.univ.sum fun j : Fin d => k_to_K (α_pert j) / germB₀ (π_q j)) +
        germB₀ N₁ / germB₀ N₀ = _
      ring
    rw [hdlog_lhs, hdlog_rhs] at hdlog_eq
    exact hdlog_eq
  
  let vK : ∀ (z : K), z ≠ 0 → Pt → ℤ :=
    fun z hz x => div_fn (Additive.ofMul (Units.mk0 z hz)) x
  have vK_congr : ∀ {z₁ z₂ : K} (h₁ : z₁ ≠ 0) (h₂ : z₂ ≠ 0) (x : Pt),
      z₁ = z₂ → vK z₁ h₁ x = vK z₂ h₂ x := by
    rintro z _ _ _ _ rfl
    rfl
  have vK_one : ∀ x : Pt, vK 1 one_ne_zero x = 0 := by
    intro x
    have h1 : Units.mk0 (1 : K) one_ne_zero = 1 := Units.ext rfl
    change div_fn (Additive.ofMul (Units.mk0 (1 : K) one_ne_zero)) x = 0
    rw [h1]
    change div_fn 0 x = 0
    rw [map_zero, Finsupp.zero_apply]
  have vK_mul : ∀ {a b : K} (ha : a ≠ 0) (hb : b ≠ 0) (x : Pt),
      vK (a * b) (mul_ne_zero ha hb) x = vK a ha x + vK b hb x := by
    intro a b ha hb x
    have hm : Units.mk0 (a * b) (mul_ne_zero ha hb) = Units.mk0 a ha * Units.mk0 b hb :=
      Units.ext rfl
    change div_fn (Additive.ofMul (Units.mk0 (a * b) (mul_ne_zero ha hb))) x = _
    rw [hm]
    change div_fn (Additive.ofMul (Units.mk0 a ha) + Additive.ofMul (Units.mk0 b hb)) x = _
    rw [map_add, Finsupp.add_apply]
  have vK_div : ∀ {a b : K} (ha : a ≠ 0) (hb : b ≠ 0) (x : Pt),
      vK (a / b) (div_ne_zero ha hb) x = vK a ha x - vK b hb x := by
    intro a b ha hb x
    have hmul : vK ((a / b) * b) (mul_ne_zero (div_ne_zero ha hb) hb) x =
        vK (a / b) (div_ne_zero ha hb) x + vK b hb x :=
      vK_mul (div_ne_zero ha hb) hb x
    have heq : vK ((a / b) * b) (mul_ne_zero (div_ne_zero ha hb) hb) x = vK a ha x :=
      vK_congr _ ha x (div_mul_cancel₀ a hb)
    omega
  have vK_pow : ∀ {a : K} (ha : a ≠ 0) (n : ℕ) (x : Pt),
      vK (a ^ n) (pow_ne_zero n ha) x = (n : ℤ) * vK a ha x := by
    intro a ha n x
    induction n with
    | zero =>
      simpa only [pow_zero, Nat.cast_zero, zero_mul] using vK_one x
    | succ n ih =>
      have hp : vK (a ^ (n + 1)) (pow_ne_zero (n + 1) ha) x =
          vK (a ^ n * a) (mul_ne_zero (pow_ne_zero n ha) ha) x :=
        vK_congr _ _ x (pow_succ a n)
      rw [hp, vK_mul (pow_ne_zero n ha) ha x, ih]
      push_cast
      ring
  have vK_prod : ∀ {ι : Type} [DecidableEq ι] (s : Finset ι) (f : ι → K)
      (hf : ∀ i ∈ s, f i ≠ 0) (x : Pt),
      vK (s.prod f) (Finset.prod_ne_zero_iff.mpr hf) x =
        s.sum (fun i => if hi : i ∈ s then vK (f i) (hf i hi) x else 0) := by
    intro ι _ s f hf x
    refine Finset.cons_induction ?_ ?_ s hf
    · intro _
      simpa only [Finset.prod_empty, Finset.sum_empty] using vK_one x
    · intro a t hat ih hft
      have hfa : f a ≠ 0 := hft a (Finset.mem_cons_self a t)
      have hft' : ∀ i ∈ t, f i ≠ 0 := fun i hi => hft i (Finset.mem_cons_of_mem hi)
      have hprod_eq : vK ((Finset.cons a t hat).prod f) (Finset.prod_ne_zero_iff.mpr hft) x =
          vK (f a * t.prod f) (mul_ne_zero hfa (Finset.prod_ne_zero_iff.mpr hft')) x :=
        vK_congr _ _ x (Finset.prod_cons hat)
      rw [hprod_eq, vK_mul hfa (Finset.prod_ne_zero_iff.mpr hft') x, ih hft', Finset.sum_cons]
      rw [dif_pos (Finset.mem_cons_self a t)]
      congr 1
      refine Finset.sum_congr rfl fun i hi => ?_
      rw [dif_pos hi, dif_pos (Finset.mem_cons_of_mem hi)]
  have vK_B₀_zero_of_not_mem : ∀ (F : B₀) (hF : germB₀ F ≠ 0) (x : Pt) (hx : x.1 ∈ U₀),
      F ∉ (hAff_U₀.primeIdealOf ⟨x.1, hx⟩).asIdeal → vK (germB₀ F) hF x = 0 := by
    intro F hF x hx hnot
    have hv := hValB₀ F hF x hx
    have hnot1 : ¬ (1 ≤ vK (germB₀ F) hF x) := fun h1 => hnot (hv.2.mp h1)
    have h0 : 0 ≤ vK (germB₀ F) hF x := hv.1
    omega
  let S_good : Set Pt :=
    { x : Pt | ∃ hx : x.1 ∈ U₀, h₀ ∉ (hAff_U₀.primeIdealOf ⟨x.1, hx⟩).asIdeal }
  have hq_good : ∀ j : Fin d, Q_star j ∈ S_good :=
    fun j => ⟨_hq_in j, hh₀_not_Q j⟩
  have hN₀_val_zero : ∀ x : Pt, x ∈ S_good → vK (germB₀ N₀) hN₀ x = 0 := by
    rintro x ⟨hx, hh₀_not⟩
    have hv_h₀ : vK (germB₀ h₀) hh₀ x = 0 :=
      vK_B₀_zero_of_not_mem h₀ hh₀ x hx hh₀_not
    have hloc_x := hLoc x hx hh₀_not
    have hv_U : vK (Finset.univ.prod fun i : Fin K_pos => germB₀ (u_pos₀ i))
        (Finset.prod_ne_zero_iff.mpr fun i _ => hu_ne i) x =
        (weilCurveDivSum C.left X_pos) x := by
      rw [vK_prod Finset.univ (fun i : Fin K_pos => germB₀ (u_pos₀ i))
        (fun i _ => hu_ne i) x]
      dsimp only [weilCurveDivSum]
      rw [Finsupp.finsetSum_apply]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [dif_pos (Finset.mem_univ i), Finsupp.single_apply]
      obtain ⟨_, h1, h0⟩ := hloc_x.1 i
      by_cases hxi : X_pos i = x
      · rw [if_pos hxi]
        exact h1 hxi.symm
      · rw [if_neg hxi]
        exact h0 (Ne.symm hxi)
    have hv_Pi : vK (Finset.univ.prod fun j : Fin d => (germB₀ (π_q j)) ^ ℓ)
        (Finset.prod_ne_zero_iff.mpr fun j _ => pow_ne_zero ℓ (hπ_ne j)) x =
        (ℓ : ℤ) * (weilCurveDivSum C.left Q_star) x := by
      rw [vK_prod Finset.univ (fun j : Fin d => (germB₀ (π_q j)) ^ ℓ)
        (fun j _ => pow_ne_zero ℓ (hπ_ne j)) x]
      dsimp only [weilCurveDivSum]
      rw [Finsupp.finsetSum_apply, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [dif_pos (Finset.mem_univ j), vK_pow (hπ_ne j) ℓ x, Finsupp.single_apply]
      obtain ⟨_, h1, h0⟩ := hloc_x.2 j
      by_cases hxj : Q_star j = x
      · have hv1 : vK (germB₀ (π_q j)) (hπ_ne j) x = 1 := h1 hxj.symm
        rw [if_pos hxj, hv1]
      · have hv0 : vK (germB₀ (π_q j)) (hπ_ne j) x = 0 := h0 (Ne.symm hxj)
        rw [if_neg hxj, hv0]
    have hU_ne_K : (Finset.univ.prod fun i : Fin K_pos => germB₀ (u_pos₀ i)) ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr fun i _ => hu_ne i
    have hPi_ne_K : (Finset.univ.prod fun j : Fin d => (germB₀ (π_q j)) ^ ℓ) ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr fun j _ => pow_ne_zero ℓ (hπ_ne j)
    have hLHS_v : vK ((Finset.univ.prod fun i : Fin K_pos => germB₀ (u_pos₀ i)) *
        ((germB₀ h₀) ^ M_exp * germB₀ F₀)) (mul_ne_zero hU_ne_K hLHS_K_ne) x =
        (weilCurveDivSum C.left X_pos) x + vK (germB₀ F₀) hF₀ x := by
      rw [vK_mul hU_ne_K hLHS_K_ne x, vK_mul (pow_ne_zero M_exp hh₀) hF₀ x,
        vK_pow hh₀ M_exp x, hv_h₀, hv_U]
      omega
    have hh2_ne : (germB₀ h₀) ^ (2 * m_W) ≠ 0 := pow_ne_zero (2 * m_W) hh₀
    have hh2Δ_ne : (germB₀ h₀) ^ (2 * m_W) * germB₀ Δ_pos₀ ≠ 0 := mul_ne_zero hh2_ne hΔ_pos₀
    have hh2ΔPi_ne : (germB₀ h₀) ^ (2 * m_W) * germB₀ Δ_pos₀ *
        (Finset.univ.prod fun j : Fin d => (germB₀ (π_q j)) ^ ℓ) ≠ 0 :=
      mul_ne_zero hh2Δ_ne hPi_ne_K
    have hRHS_v : vK ((germB₀ h₀) ^ (2 * m_W) * germB₀ Δ_pos₀ *
        (Finset.univ.prod fun j : Fin d => (germB₀ (π_q j)) ^ ℓ) * germB₀ N₀)
        (mul_ne_zero hh2ΔPi_ne hN₀) x =
        vK (germB₀ Δ_pos₀) hΔ_pos₀ x + (ℓ : ℤ) * (weilCurveDivSum C.left Q_star) x +
          vK (germB₀ N₀) hN₀ x := by
      rw [vK_mul hh2ΔPi_ne hN₀ x, vK_mul hh2Δ_ne hPi_ne_K x, vK_mul hh2_ne hΔ_pos₀ x,
        vK_pow hh₀ (2 * m_W) x, hv_h₀, hv_Pi]
      omega
    have hv_eq : vK ((Finset.univ.prod fun i : Fin K_pos => germB₀ (u_pos₀ i)) *
        ((germB₀ h₀) ^ M_exp * germB₀ F₀)) (mul_ne_zero hU_ne_K hLHS_K_ne) x =
        vK ((germB₀ h₀) ^ (2 * m_W) * germB₀ Δ_pos₀ *
          (Finset.univ.prod fun j : Fin d => (germB₀ (π_q j)) ^ ℓ) * germB₀ N₀)
          (mul_ne_zero hh2ΔPi_ne hN₀) x :=
      vK_congr _ _ x hProd_K
    have hF₀_x : vK (germB₀ F₀) hF₀ x - vK (germB₀ Δ_pos₀) hΔ_pos₀ x =
        (ℓ : ℤ) * (weilCurveDivSum C.left Q_star) x - (weilCurveDivSum C.left X_pos) x :=
      hF₀_div x
    omega
  
  let ValGe : Pt → ℤ → K → Prop := fun x m z => ∀ hz : z ≠ 0, m ≤ vK z hz x
  have valGe_zero : ∀ (x : Pt) (m : ℤ), ValGe x m 0 :=
    fun _ _ hz => False.elim (hz rfl)
  have valGe_mono : ∀ {x : Pt} {m₁ m₂ : ℤ} {z : K},
      m₁ ≤ m₂ → ValGe x m₂ z → ValGe x m₁ z :=
    fun hm h hz => le_trans hm (h hz)
  have valGe_add : ∀ {x : Pt} {m : ℤ} {z₁ z₂ : K},
      ValGe x m z₁ → ValGe x m z₂ → ValGe x m (z₁ + z₂) := by
    intro x m z₁ z₂ h₁ h₂
    by_cases hz₁ : z₁ = 0
    · subst hz₁; rw [zero_add]; exact h₂
    · by_cases hz₂ : z₂ = 0
      · subst hz₂; rw [add_zero]; exact h₁
      · intro hsum
        exact le_trans (le_min (h₁ hz₁) (h₂ hz₂))
          (hUltra (Units.mk0 z₁ hz₁) (Units.mk0 z₂ hz₂) hsum x)
  have vK_const : ∀ (c : k) (hc : c ≠ 0) (x : Pt),
      vK (k_to_K c) (hk_ne hc) x = 0 := by
    intro c hc x
    have hu : Units.mk0 (k_to_K c) (hk_ne hc) =
        Units.map k_to_K.toMonoidHom (Units.mk0 c hc) := Units.ext rfl
    simp only [vK, hu, hConst (Units.mk0 c hc), Finsupp.zero_apply]
  have valGe_const : ∀ (c : k) (x : Pt), ValGe x 0 (k_to_K c) := by
    intro c x
    by_cases hc : c = 0
    · subst hc; rw [map_zero]; exact valGe_zero x 0
    · intro _; rw [vK_const c hc x]
  have valGe_neg : ∀ {x : Pt} {m : ℤ} {z : K}, ValGe x m z → ValGe x m (-z) := by
    intro x m z hz hnz
    have hz_ne : z ≠ 0 := neg_ne_zero.mp hnz
    have hm1 : (-1 : k) ≠ 0 := neg_ne_zero.mpr one_ne_zero
    have hkm1 : k_to_K (-1 : k) ≠ 0 := hk_ne hm1
    have hmul_eq : -z = k_to_K (-1 : k) * z := by
      rw [map_neg, map_one, neg_one_mul]
    have hv_eq : vK (-z) hnz x = vK (k_to_K (-1 : k) * z) (mul_ne_zero hkm1 hz_ne) x :=
      vK_congr _ _ x hmul_eq
    rw [hv_eq, vK_mul hkm1 hz_ne x, vK_const (-1) hm1 x, zero_add]
    exact hz hz_ne
  have valGe_sub : ∀ {x : Pt} {m : ℤ} {z₁ z₂ : K},
      ValGe x m z₁ → ValGe x m z₂ → ValGe x m (z₁ - z₂) := by
    intro x m z₁ z₂ h₁ h₂
    rw [sub_eq_add_neg]
    exact valGe_add h₁ (valGe_neg h₂)
  have valGe_sum : ∀ {ι : Type} [DecidableEq ι] (s : Finset ι) (f : ι → K) (x : Pt) (m : ℤ),
      (∀ i ∈ s, ValGe x m (f i)) → ValGe x m (s.sum f) := by
    intro ι _ s f x m hf
    refine Finset.cons_induction ?_ ?_ s hf
    · intro _
      simpa only [Finset.sum_empty] using valGe_zero x m
    · intro a t hat ih hft
      rw [Finset.sum_cons]
      exact valGe_add (hft a (Finset.mem_cons_self a t))
        (ih fun i hi => hft i (Finset.mem_cons_of_mem hi))
  have vK_const_div : ∀ (c : k) (hc : c ≠ 0) {b : K} (hb : b ≠ 0) (x : Pt),
      vK (k_to_K c / b) (div_ne_zero (hk_ne hc) hb) x = - vK b hb x := by
    intro c hc b hb x
    rw [vK_div (hk_ne hc) hb x, vK_const c hc x, zero_sub]
  have valGe_const_div : ∀ (c : k) {b : K} (hb : b ≠ 0) (x : Pt),
      ValGe x (- vK b hb x) (k_to_K c / b) := by
    intro c b hb x
    by_cases hc : c = 0
    · subst hc; rw [map_zero, zero_div]; exact valGe_zero x _
    · intro _; rw [vK_const_div c hc hb x]
  let z_lhs : K := germB₀ G / germB₀ F₀
  let z_rem : K := germB₀ N₁ / germB₀ N₀
  have hrem_in : ∀ x : Pt, x ∈ S_good → ValGe x 0 z_rem := by
    intro x hx_good hr
    have hN₁ : germB₀ N₁ ≠ 0 := by
      intro h0
      apply hr
      dsimp only [z_rem]
      rw [h0, zero_div]
    have ⟨hx_U, _⟩ := hx_good
    have hv_rem : vK z_rem hr x = vK (germB₀ N₁) hN₁ x - vK (germB₀ N₀) hN₀ x :=
      vK_div hN₁ hN₀ x
    have hv_N₁ : 0 ≤ vK (germB₀ N₁) hN₁ x := (hValB₀ N₁ hN₁ x hx_U).1
    have hv_N₀ : vK (germB₀ N₀) hN₀ x = 0 := hN₀_val_zero x hx_good
    omega
  have hlhs_out : ∀ x : Pt, x ∉ S_good → ValGe x 0 z_lhs := by
    intro x hx_not_good hz
    have hG : germB₀ G ≠ 0 := by
      intro h0
      apply hz
      dsimp only [z_lhs]
      rw [h0, zero_div]
    have hv_lhs : vK z_lhs hz x = vK (germB₀ G) hG x - vK (germB₀ F₀) hF₀ x :=
      vK_div hG hF₀ x
    by_cases hx_U : x.1 ∈ U₀
    · have hh₀_in : h₀ ∈ (hAff_U₀.primeIdealOf ⟨x.1, hx_U⟩).asIdeal := by
        by_contra hh₀_not
        exact hx_not_good ⟨hx_U, hh₀_not⟩
      let Px := (hAff_U₀.primeIdealOf ⟨x.1, hx_U⟩).asIdeal
      have hPx_prime : Px.IsPrime := (hAff_U₀.primeIdealOf ⟨x.1, hx_U⟩).isPrime
      have hprod_not : Δ_pos₀ * Δ_neg₀ ∉ Px := h_avoid Px hPx_prime hh₀_in
      have hΔpos_not : Δ_pos₀ ∉ Px := fun hm => hprod_not (Px.mul_mem_right Δ_neg₀ hm)
      have hΔneg_not : Δ_neg₀ ∉ Px := fun hm => hprod_not (Px.mul_mem_left Δ_pos₀ hm)
      have hv_Δ : vK (germB₀ Δ_pos₀) hΔ_pos₀ x = 0 :=
        vK_B₀_zero_of_not_mem Δ_pos₀ hΔ_pos₀ x hx_U hΔpos_not
      have hX_zero : (weilCurveDivSum C.left X_pos) x = 0 := by
        dsimp only [weilCurveDivSum]
        rw [Finsupp.finsetSum_apply]
        refine Finset.sum_eq_zero fun i _ => ?_
        rw [Finsupp.single_apply, if_neg]
        intro hxi
        have hval_eq : (X_pos i).1 = x.1 := congrArg Subtype.val hxi
        have hsub_eq : (⟨(X_pos i).1, _hx_in i⟩ : ↥U₀) = ⟨x.1, hx_U⟩ := Subtype.ext hval_eq
        have hmem_x : Δ_pos₀ ∈ (hAff_U₀.primeIdealOf ⟨x.1, hx_U⟩).asIdeal := by
          rw [← hsub_eq]
          exact hΔ_pos_mem i
        exact hΔpos_not hmem_x
      have hQ_zero : (weilCurveDivSum C.left Q_star) x = 0 := by
        dsimp only [weilCurveDivSum]
        rw [Finsupp.finsetSum_apply]
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [Finsupp.single_apply, if_neg]
        intro hxj
        have hval_eq : (Q_star j).1 = x.1 := congrArg Subtype.val hxj
        have hsub_eq : (⟨(Q_star j).1, _hq_in j⟩ : ↥U₀) = ⟨x.1, hx_U⟩ := Subtype.ext hval_eq
        have hmem_x : Δ_neg₀ ∈ (hAff_U₀.primeIdealOf ⟨x.1, hx_U⟩).asIdeal := by
          rw [← hsub_eq]
          exact hΔ_neg_mem j
        exact hΔneg_not hmem_x
      have hF₀_x := hF₀_div x
      change vK (germB₀ F₀) hF₀ x - vK (germB₀ Δ_pos₀) hΔ_pos₀ x = _ at hF₀_x
      rw [hQ_zero, hX_zero, mul_zero] at hF₀_x
      have hv_G : 0 ≤ vK (germB₀ G) hG x := (hValB₀ G hG x hx_U).1
      omega
    · have hX_zero : (weilCurveDivSum C.left X_pos) x = 0 := by
        dsimp only [weilCurveDivSum]
        rw [Finsupp.finsetSum_apply]
        refine Finset.sum_eq_zero fun i _ => ?_
        rw [Finsupp.single_apply, if_neg]
        intro hxi
        exact hx_U (hxi ▸ _hx_in i)
      have hQ_zero : (weilCurveDivSum C.left Q_star) x = 0 := by
        dsimp only [weilCurveDivSum]
        rw [Finsupp.finsetSum_apply]
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [Finsupp.single_apply, if_neg]
        intro hxj
        exact hx_U (hxj ▸ _hq_in j)
      have hF₀_x := hF₀_div x
      change vK (germB₀ F₀) hF₀ x - vK (germB₀ Δ_pos₀) hΔ_pos₀ x = _ at hF₀_x
      rw [hQ_zero, hX_zero, mul_zero] at hF₀_x
      have hv_G : vK (germB₀ Δ_pos₀) hΔ_pos₀ x ≤ vK (germB₀ G) hG x :=
        hG_pole x hG hx_U
      omega
  let D_Q : Pt →₀ ℤ := weilCurveDivSum C.left Q_star
  have hDQ_nonneg : ∀ x : Pt, 0 ≤ D_Q x := by
    intro x
    dsimp only [D_Q, weilCurveDivSum]
    rw [Finsupp.finsetSum_apply]
    refine Finset.sum_nonneg fun j _ => ?_
    rw [Finsupp.single_apply]
    split_ifs <;> omega
  have hDQ_zero_of_ne : ∀ x : Pt, (∀ j : Fin d, x ≠ Q_star j) → D_Q x = 0 := by
    intro x hne
    dsimp only [D_Q, weilCurveDivSum]
    rw [Finsupp.finsetSum_apply]
    refine Finset.sum_eq_zero fun j _ => ?_
    rw [Finsupp.single_apply, if_neg (Ne.symm (hne j))]
  have hDQ_at_Q : ∀ j₀ : Fin d, D_Q (Q_star j₀) = 1 := by
    intro j₀
    dsimp only [D_Q, weilCurveDivSum]
    rw [Finsupp.finsetSum_apply]
    have hsum : (Finset.univ.sum fun j : Fin d => (Finsupp.single (Q_star j) (1 : ℤ)) (Q_star j₀)) =
        Finset.univ.sum fun j : Fin d => if j = j₀ then (1 : ℤ) else 0 := by
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Finsupp.single_apply]
      by_cases hjj₀ : j = j₀
      · subst hjj₀; simp
      · rw [if_neg (_hDist j j₀ hjj₀), if_neg hjj₀]
    rw [hsum]
    simp
  have hlhs_pole_bound : ∀ x : Pt, ValGe x (- D_Q x) z_lhs := by
    intro x
    by_cases hx_good : x ∈ S_good
    · have ⟨hx_U, hh₀_not⟩ := hx_good
      have hloc_x := hLoc x hx_U hh₀_not
      by_cases hex : ∃ j₀ : Fin d, x = Q_star j₀
      · obtain ⟨j₀, rfl⟩ := hex
        rw [hDQ_at_Q j₀]
        change ValGe (Q_star j₀) (-1) z_lhs
        rw [show z_lhs = z_rem - Finset.univ.sum
          (fun j : Fin d => k_to_K (α_pert j) / germB₀ (π_q j)) from hFrac_K]
        refine valGe_sub (valGe_mono (by omega) (hrem_in (Q_star j₀) hx_good)) ?_
        refine valGe_sum Finset.univ _ (Q_star j₀) (-1) fun j _ => ?_
        obtain ⟨_, h1, h0⟩ := hloc_x.2 j
        have hv_le : vK (germB₀ (π_q j)) (hπ_ne j) (Q_star j₀) ≤ 1 := by
          by_cases hjj₀ : Q_star j₀ = Q_star j
          · have hv1 : vK (germB₀ (π_q j)) (hπ_ne j) (Q_star j₀) = 1 := h1 hjj₀
            omega
          · have hv0 : vK (germB₀ (π_q j)) (hπ_ne j) (Q_star j₀) = 0 := h0 hjj₀
            omega
        exact valGe_mono (by omega) (valGe_const_div (α_pert j) (hπ_ne j) (Q_star j₀))
      · push_neg at hex
        rw [hDQ_zero_of_ne x hex, neg_zero]
        rw [show z_lhs = z_rem - Finset.univ.sum
          (fun j : Fin d => k_to_K (α_pert j) / germB₀ (π_q j)) from hFrac_K]
        refine valGe_sub (hrem_in x hx_good) ?_
        refine valGe_sum Finset.univ _ x 0 fun j _ => ?_
        obtain ⟨_, _, h0⟩ := hloc_x.2 j
        have hv0 : vK (germB₀ (π_q j)) (hπ_ne j) x = 0 := h0 (hex j)
        have hdiv := valGe_const_div (α_pert j) (hπ_ne j) x
        rwa [hv0, neg_zero] at hdiv
    · have hne : ∀ j : Fin d, x ≠ Q_star j := by
        intro j hxj
        exact hx_good (hxj ▸ hq_good j)
      rw [hDQ_zero_of_ne x hne, neg_zero]
      exact hlhs_out x hx_good
  have hConst_lhs : ∃ c_h : k, z_lhs = k_to_K c_h := by
    by_cases hz : z_lhs = 0
    · exact ⟨0, by rw [hz, map_zero]⟩
    · obtain ⟨c_h, hc_h⟩ := _hEffSub (Units.mk0 z_lhs hz) 1
        (fun x => by
          have hb := hlhs_pole_bound x hz
          change 0 ≤ vK z_lhs hz x + D_Q x
          omega)
        (fun x => by
          have h0 : div_fn (Additive.ofMul (1 : Units K)) x = 0 := by
            change div_fn 0 x = 0
            rw [map_zero, Finsupp.zero_apply]
          rw [h0, zero_add]
          exact hDQ_nonneg x)
      refine ⟨c_h, ?_⟩
      simpa only [Units.val_mk0, Units.val_one, mul_one] using hc_h
  obtain ⟨c_h, hc_h⟩ := hConst_lhs
  intro j₀
  let x₀ : Pt := Q_star j₀
  let term : Fin d → K := fun j => k_to_K (α_pert j) / germB₀ (π_q j)
  have h_isolate : term j₀ = (z_rem - k_to_K c_h) - (Finset.univ.erase j₀).sum term := by
    have hsum_split : Finset.univ.sum term = (Finset.univ.erase j₀).sum term + term j₀ :=
      (Finset.sum_erase_add Finset.univ term (Finset.mem_univ j₀)).symm
    have h1 : k_to_K c_h = z_rem - ((Finset.univ.erase j₀).sum term + term j₀) := by
      rw [← hc_h, ← hsum_split]
      exact hFrac_K
    linear_combination h1
  have hVal_term_j₀ : ValGe x₀ 0 (term j₀) := by
    rw [h_isolate]
    refine valGe_sub (valGe_sub (hrem_in x₀ (hq_good j₀)) (valGe_const c_h x₀)) ?_
    refine valGe_sum (Finset.univ.erase j₀) term x₀ 0 fun j hj => ?_
    have hjj₀ : j ≠ j₀ := Finset.ne_of_mem_erase hj
    have hx₀_ne : x₀ ≠ Q_star j := _hDist j₀ j (Ne.symm hjj₀)
    obtain ⟨_, _, h0⟩ := ((hLoc x₀ (_hq_in j₀) (hh₀_not_Q j₀)).2 j)
    have hv0 : vK (germB₀ (π_q j)) (hπ_ne j) x₀ = 0 := h0 hx₀_ne
    have hdiv := valGe_const_div (α_pert j) (hπ_ne j) x₀
    rwa [hv0, neg_zero] at hdiv
  by_contra hc_ne
  have hα_ne : α_pert j₀ ≠ 0 := mul_ne_zero _hℓ hc_ne
  have hterm_ne : term j₀ ≠ 0 :=
    div_ne_zero (hk_ne hα_ne) (hπ_ne j₀)
  have h_ge0 : 0 ≤ vK (term j₀) hterm_ne x₀ := hVal_term_j₀ hterm_ne
  obtain ⟨_, h1, _⟩ := (hLoc x₀ (_hq_in j₀) (hh₀_not_Q j₀)).2 j₀
  have hv1 : vK (germB₀ (π_q j₀)) (hπ_ne j₀) x₀ = 1 := h1 rfl
  have h_eq_neg1 : vK (term j₀) hterm_ne x₀ = -1 := by
    dsimp only [term]
    rw [vK_const_div (α_pert j₀) hα_ne (hπ_ne j₀) x₀, hv1]
  omega

theorem weil_curve_pow_determinantal_loci_and_kummer_isolated (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    (hProjC : IsProjectiveOverField k C)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (d : ℕ) (hd : 1 ≤ d)
    (hChart : WeilCurveDivisorAndAffineChartHolds k C)
    (hDeg0 : ∀ D ∈ weilCurvePrincipalSubgroup C.left, D.sum (fun _ n => n) = 0) :
    let P_d := weilCurvePowOver k C d
    let Pt := { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }
    let mkCl := QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C.left)
    (∀ D₀ : Pt →₀ ℤ, D₀.sum (fun _ n => n) = 0 →
      ∃ U_uniq : Set ↥P_d.left, IsOpen U_uniq ∧
        ∀ (z : ↥P_d.left) (Q : Fin d → Pt),
          weilCurvePowMatchesTuple k C z Q →
          (z ∈ U_uniq ↔ weilCurveEffSubsingleton C.left (weilCurveDivSum C.left Q + D₀))) ∧
    (∀ (m : ℕ), 1 ≤ m → ∀ D_fix : Pt →₀ ℤ,
      D_fix.sum (fun _ n => n) = (((m - 1) * d : ℕ) : ℤ) →
      ∃ Z_rel : Set ↥(CategoryTheory.Limits.pullback P_d.hom P_d.hom), IsClosed Z_rel ∧
        ∀ (w : ↥(CategoryTheory.Limits.pullback P_d.hom P_d.hom)) (Q R : Fin d → Pt),
          weilCurvePowMatchesTuple k C
            ((CategoryTheory.Limits.pullback.fst P_d.hom P_d.hom).base w) Q →
          weilCurvePowMatchesTuple k C
            ((CategoryTheory.Limits.pullback.snd P_d.hom P_d.hom).base w) R →
          (w ∈ Z_rel ↔
            m • mkCl (weilCurveDivSum C.left Q) =
              mkCl (weilCurveDivSum C.left R + D_fix))) ∧
    (∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : k) ≠ 0 →
      ∀ (P₀ : Pt) (R_star : Fin d → Pt),
      ∃ F_R : Set ↥P_d.left, IsClosed F_R ∧
        (∀ (z : ↥P_d.left) (Q : Fin d → Pt),
          weilCurvePowMatchesTuple k C z Q →
          (z ∈ F_R ↔
            ℓ • mkCl (weilCurveDivSum C.left Q) =
              mkCl (weilCurveDivSum C.left R_star +
                Finsupp.single P₀ (((ℓ - 1) * d : ℕ) : ℤ)))) ∧
        (∀ (z_star : ↥P_d.left) (Q_star : Fin d → Pt),
          weilCurvePowMatchesTuple k C z_star Q_star →
          z_star ∈ F_R →
          (∀ i j : Fin d, i ≠ j → Q_star i ≠ Q_star j) →
          weilCurveEffSubsingleton C.left (weilCurveDivSum C.left Q_star) →
          ∃ W : Set ↥P_d.left, IsOpen W ∧ z_star ∈ W ∧ F_R ∩ W = {z_star})) :=
by
  classical
  intro P_d Pt mkCl
  let K := ↑C.left.functionField
  let PP := CategoryTheory.Limits.pullback P_d.hom P_d.hom
  let fstPP := CategoryTheory.Limits.pullback.fst P_d.hom P_d.hom
  let sndPP := CategoryTheory.Limits.pullback.snd P_d.hom P_d.hom
  obtain ⟨k_to_K, div_fn, hRange, hUltra, hConst, hStalk, hEffIff, hExistsChart⟩ := hChart
  obtain ⟨hMinorsField, hDualLift, hNakIso⟩ :=
    weil_determinantal_minor_rank_and_dualNumber_isolation k
  
  have hSum_zero : (0 : Pt →₀ ℤ).sum (fun _ n => n) = 0 := Finsupp.sum_zero_index
  have hSum_single : ∀ (x : Pt) (m : ℤ), (Finsupp.single x m).sum (fun _ n => n) = m :=
    fun _ _ => Finsupp.sum_single_index rfl
  have hSum_add : ∀ (D₁ D₂ : Pt →₀ ℤ),
      (D₁ + D₂).sum (fun _ n => n) = D₁.sum (fun _ n => n) + D₂.sum (fun _ n => n) :=
    fun D₁ D₂ => Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl)
  have hSum_neg : ∀ (D : Pt →₀ ℤ), (-D).sum (fun _ n => n) = -D.sum (fun _ n => n) := by
    intro D
    have h0 : (D + (-D)).sum (fun _ n => n) = 0 := by rw [add_neg_cancel, hSum_zero]
    rw [hSum_add] at h0
    omega
  have hSum_sub : ∀ (D₁ D₂ : Pt →₀ ℤ),
      (D₁ - D₂).sum (fun _ n => n) = D₁.sum (fun _ n => n) - D₂.sum (fun _ n => n) := by
    intro D₁ D₂
    rw [sub_eq_add_neg, hSum_add, hSum_neg, sub_eq_add_neg]
  have hSum_divSum : ∀ {m : ℕ} (Q : Fin m → Pt),
      (weilCurveDivSum C.left Q).sum (fun _ n => n) = (m : ℤ) := by
    intro m
    induction m with
    | zero =>
      intro Q
      simp [weilCurveDivSum]
    | succ m ih =>
      intro Q
      dsimp [weilCurveDivSum]
      rw [Fin.sum_univ_succ, hSum_add, hSum_single]
      have := ih (fun i => Q i.succ)
      dsimp [weilCurveDivSum] at this
      rw [this]
      push_cast
      ring
  have hEff_divSum : ∀ {m : ℕ} (Q : Fin m → Pt) (x : Pt), 0 ≤ weilCurveDivSum C.left Q x := by
    intro m Q x
    dsimp [weilCurveDivSum]
    rw [Finsupp.finsetSum_apply]
    refine Finset.sum_nonneg fun j _ => ?_
    simp only [Finsupp.single_apply]
    split_ifs <;> omega
  have hDivSum_out : ∀ {m : ℕ} (Q : Fin m → Pt) (U₀ : C.left.Opens) (x : Pt),
      (∀ j : Fin m, (Q j).1 ∈ U₀) → x.1 ∉ U₀ → weilCurveDivSum C.left Q x = 0 := by
    intro m Q U₀ x hQ hx
    dsimp [weilCurveDivSum]
    rw [Finsupp.finsetSum_apply]
    refine Finset.sum_eq_zero fun j _ => ?_
    rw [Finsupp.single_apply, if_neg]
    intro hEq
    exact hx (hEq ▸ hQ j)
  have hDivSum_append : ∀ {a b : ℕ} (Q₁ : Fin a → Pt) (Q₂ : Fin b → Pt),
      weilCurveDivSum C.left (Fin.append Q₁ Q₂) =
        weilCurveDivSum C.left Q₁ + weilCurveDivSum C.left Q₂ := by
    intro a b Q₁ Q₂
    dsimp [weilCurveDivSum]
    rw [Fin.sum_univ_add]
    simp [Fin.append_left, Fin.append_right]
  have hDivSum_const : ∀ (m : ℕ) (P₀ : Pt),
      weilCurveDivSum C.left (fun _ : Fin m => P₀) = Finsupp.single P₀ (m : ℤ) := by
    intro m P₀
    ext x
    simp only [weilCurveDivSum, Finsupp.finsetSum_apply, Finsupp.single_apply]
    split_ifs with h
    · simp
    · simp
  have hDivSum_prod : ∀ {a b : ℕ} (Q : Fin a → Pt),
      weilCurveDivSum C.left (fun idx : Fin (a * b) => Q (finProdFinEquiv.symm idx).1) =
        b • weilCurveDivSum C.left Q := by
    intro a b Q
    ext x
    simp only [weilCurveDivSum, Finsupp.finsetSum_apply, Finsupp.coe_smul, Pi.smul_apply,
      nsmul_eq_mul]
    have hsum := Equiv.sum_comp finProdFinEquiv.symm
      (fun p : Fin a × Fin b => (Finsupp.single (Q p.1) (1 : ℤ)) x)
    change (∑ idx : Fin (a * b), (Finsupp.single (Q (finProdFinEquiv.symm idx).1) (1 : ℤ)) x) = _
    rw [hsum, Fintype.sum_prod_type]
    simp only [Finset.sum_const, Finset.card_fin, nsmul_eq_mul, Finset.mul_sum]
  have hZero_of_nonneg_deg0 : ∀ E : Pt →₀ ℤ,
      (∀ x, 0 ≤ E x) → E.sum (fun _ n => n) = 0 → E = 0 := by
    intro E hpos hsum
    ext x
    simp only [Finsupp.coe_zero, Pi.zero_apply]
    by_contra hx
    have hx_mem : x ∈ E.support := Finsupp.mem_support_iff.mpr hx
    have hx_le : E x ≤ E.sum (fun _ m => m) := by
      change E x ≤ ∑ y ∈ E.support, E y
      exact Finset.single_le_sum (fun y _ => hpos y) hx_mem
    have := hpos x
    omega
  have hEffEnum : ∀ (M : ℕ) (E : Pt →₀ ℤ),
      (∀ x, 0 ≤ E x) → E.sum (fun _ m => m) = (M : ℤ) →
      ∃ T : Fin M → Pt, weilCurveDivSum C.left T = E := by
    intro M
    induction M with
    | zero =>
      intro E hpos hsum
      refine ⟨Fin.elim0, ?_⟩
      simp [weilCurveDivSum, hZero_of_nonneg_deg0 E hpos hsum]
    | succ M ih =>
      intro E hpos hsum
      have hE_ne : E ≠ 0 := by
        intro h0; rw [h0, hSum_zero] at hsum; omega
      obtain ⟨x₀, hx₀⟩ : ∃ x₀ : Pt, E x₀ ≠ 0 := by
        by_contra hall; push_neg at hall; exact hE_ne (Finsupp.ext hall)
      let E' : Pt →₀ ℤ := E - Finsupp.single x₀ 1
      have hpos' : ∀ x : Pt, 0 ≤ E' x := by
        intro x
        simp only [E', Finsupp.coe_sub, Pi.sub_apply, Finsupp.single_apply]
        split_ifs with h
        · subst h; have := hpos x₀; omega
        · have := hpos x; omega
      have hsum' : E'.sum (fun _ m => m) = (M : ℤ) := by
        dsimp [E']
        rw [hSum_sub, hsum, hSum_single]; push_cast; ring
      obtain ⟨T', hT'⟩ := ih E' hpos' hsum'
      refine ⟨Fin.cases x₀ T', ?_⟩
      dsimp [weilCurveDivSum] at hT' ⊢
      rw [Fin.sum_univ_succ]
      simp only [Fin.cases_zero, Fin.cases_succ]
      rw [hT']; dsimp [E']; abel
  have hSplitDiv : ∀ D : Pt →₀ ℤ,
      ∃ (M_pos M_neg : ℕ) (T_pos : Fin M_pos → Pt) (T_neg : Fin M_neg → Pt),
        D = weilCurveDivSum C.left T_pos - weilCurveDivSum C.left T_neg ∧
        (M_pos : ℤ) - (M_neg : ℤ) = D.sum (fun _ n => n) := by
    intro D
    let D_pos : Pt →₀ ℤ := D.mapRange (fun n => max n 0) (max_self 0)
    let D_neg : Pt →₀ ℤ := D.mapRange (fun n => max (-n) 0) (by simp)
    have hD_eq : D = D_pos - D_neg := by
      ext x
      simp only [D_pos, D_neg, Finsupp.mapRange_apply, Finsupp.coe_sub, Pi.sub_apply]
      omega
    have hpos_p : ∀ x, 0 ≤ D_pos x := fun x => le_max_right _ 0
    have hpos_n : ∀ x, 0 ≤ D_neg x := fun x => le_max_right _ 0
    have hsum_p_nn : 0 ≤ D_pos.sum (fun _ n => n) :=
      Finset.sum_nonneg fun x _ => hpos_p x
    have hsum_n_nn : 0 ≤ D_neg.sum (fun _ n => n) :=
      Finset.sum_nonneg fun x _ => hpos_n x
    let M_pos : ℕ := Int.toNat (D_pos.sum (fun _ n => n))
    let M_neg : ℕ := Int.toNat (D_neg.sum (fun _ n => n))
