      inv_tp ≫ iR = f_aff_fst →
      m₄ ≫ (f₄ ≫ f_aff_fst) = f₃ ≫ s₀_fst →
      m₃ ≫ f₃ = f₂ ≫ sec_left →
      sec_left ≫ s₀_fst = φ'_map →
      m₂ ≫ f₂ = f₀_hom →
      ((m₁ ≫ (m₂ ≫ (m₃ ≫ (m₄ ≫ m₅)))) ≫ d₀) ≫ iR = m₁ ≫ (f₀_hom ≫ φ'_map) := by
    intro 𝒞 _ A₀ A₁ A₂ A₃ A₄ A₅ W₀ B₄ R_sch B₃ T_pt
      m₁ m₂ m₃ m₄ m₅ d₀ iR f₄ inv_tp f_aff_fst f₃ s₀_fst f₂ sec_left f₀_hom φ'_map
      hs₅ hs_tp hs₄ hs₃ hs_sec hs₂
