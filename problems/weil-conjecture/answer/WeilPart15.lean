        have hun_ne : ∀ j : Fin K_neg, germB₀ (u_neg_s j) ≠ 0 :=
          fun j => (hLocN j).choose
        have hhs_pow_ne : germB₀ (h_s ^ m_W) ≠ 0 := by
          rw [map_pow]; exact pow_ne_zero m_W hhs_ne
        have hhs_pow_val0 : div_fn (Additive.ofMul (Units.mk0 _ hhs_pow_ne)) x = 0 := by
          have hu_eq : Units.mk0 (germB₀ (h_s ^ m_W)) hhs_pow_ne =
              (Units.mk0 (germB₀ h_s) hhs_ne) ^ m_W := Units.ext (map_pow germB₀ h_s m_W)
          rw [hu_eq, ofMul_pow, map_nsmul, Finsupp.smul_apply,
            hVal_zero_of_not_mem h_s hhs_ne x hx_in hhs_mem, smul_zero]
        have hval_up_sum : div_fn (Additive.ofMul (Units.mk0 _ hprod_up_ne)) x =
            weilCurveDivSum C.left X_s x := by
          rw [hVal_prod u_pos_s hup_ne hprod_up_ne x]
          dsimp [weilCurveDivSum]; rw [Finsupp.finsetSum_apply]
          refine Finset.sum_congr rfl fun i _ => ?_
          simp only [Finsupp.single_apply]
          split_ifs with hEq
          · exact (hLocP i).choose_spec.1 (Eq.symm hEq)
          · exact (hLocP i).choose_spec.2 (Ne.symm hEq)
        have hval_un_sum : div_fn (Additive.ofMul (Units.mk0 _ hprod_un_ne)) x =
            weilCurveDivSum C.left Y_s x := by
          rw [hVal_prod u_neg_s hun_ne hprod_un_ne x]
          dsimp [weilCurveDivSum]; rw [Finsupp.finsetSum_apply]
          refine Finset.sum_congr rfl fun j _ => ?_
          simp only [Finsupp.single_apply]
          split_ifs with hEq
          · exact (hLocN j).choose_spec.1 (Eq.symm hEq)
          · exact (hLocN j).choose_spec.2 (Ne.symm hEq)
        have hp1 : germB₀ ((Finset.univ.prod u_pos_s) * w_s) ≠ 0 := by
          rw [map_mul]; exact mul_ne_zero hprod_up_ne hws_ne
        have hp2 : germB₀ (h_s ^ m_W * Δ_pos_s) ≠ 0 := hUW_s ▸ hp1
        have hUW_val : weilCurveDivSum C.left X_s x +
            div_fn (Additive.ofMul (Units.mk0 (germB₀ w_s) hws_ne)) x =
            div_fn (Additive.ofMul (Units.mk0 (germB₀ Δ_pos_s) hΔ_pos_s)) x := by
          have hL := hVal_mul _ _ hprod_up_ne hws_ne hp1 x
          have hR := hVal_mul _ _ hhs_pow_ne hΔ_pos_s hp2 x
          have hU : Units.mk0 _ hp1 = Units.mk0 _ hp2 := Units.ext (congrArg germB₀ hUW_s)
          rw [hval_up_sum] at hL; rw [hhs_pow_val0, zero_add] at hR
