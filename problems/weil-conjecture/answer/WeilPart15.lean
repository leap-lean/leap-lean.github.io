            have hu_sub_1 : u_x - 1 ∈ 𝔪 := by
              have hbad := hzt_bad y
              have heq_u : u_x - 1 = z_tilde - (φ_k (ev₀ z_x) + 1) := by
                dsimp [u_x]
                rw [hevx_zt]
                ring
              rw [heq_u]
              exact hbad
            have hu_not_𝔪 : u_x ∉ 𝔪 := by
              intro hu_in
              have h1 : (1 : B₀) ∈ 𝔪 := by
                have := 𝔪.sub_mem hu_in hu_sub_1
                simpa using this
              exact h𝔪_m.ne_top (Ideal.eq_top_of_isUnit_mem 𝔪 h1 isUnit_one)
            have hu_in_Ja : u_x ∈ J_a := by
              change u_x * a ∈ RHS
              exact (le_sup_left : Ideal.span ({u_x} : Set B₀) ≤ RHS)
                (Ideal.mem_span_singleton.mpr ⟨a, rfl⟩)
            exact hu_not_𝔪 (hJa_le hu_in_Ja)
          · have hΔ_in_Ja : Δ_bar ∈ J_a := by
              change Δ_bar * a ∈ RHS
              refine (le_sup_right : Ideal.span ({Δ_bar} : Set B₀) • 𝔪_x ≤ RHS) ?_
              rw [Ideal.smul_eq_mul]
              exact Ideal.mul_mem_mul (Ideal.subset_span (Set.mem_singleton Δ_bar)) ha
            exact hΔ_in (hJa_le hΔ_in_Ja)
      have h1 : (1 : B₀) ∈ J_a := by rw [hJa_top]; trivial
      change 1 * a ∈ RHS at h1
      rwa [one_mul] at h1
    · refine sup_le (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hu_in_𝔪x)) ?_
      rw [Ideal.smul_eq_mul, Ideal.mul_le]
      intro r _ m hm
      exact 𝔪_x.mul_mem_left r hm

theorem weil_poly_free_tensor_domain_and_monic_quotient (k : Type u) [Field k] [IsAlgClosed k]
    (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [Algebra k B₀]
    (t : B₀) (n : ℕ) (_hn : 1 ≤ n) (b : Fin n → B₀)
    (_hb : Function.Bijective (fun c : Fin n → Polynomial k =>
      Finset.univ.sum fun i : Fin n => Polynomial.aeval t (c i) * b i)) :
    (∀ (S : Type u) [CommRing S] [IsDomain S] [Algebra k S],
      IsDomain (TensorProduct k B₀ S) ∧
      ∀ s₀ : S, t ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] s₀ ≠ 0) ∧
    (∀ (S : Type u) [CommRing S] [Algebra k S] (p : B₀ →ₐ[k] S),
      RingHom.ker (Algebra.TensorProduct.productMap p (AlgHom.id k S)).toRingHom =
        Ideal.span ({t ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p t} ∪
          Set.range (fun i : Fin n => b i ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p (b i)))) ∧
    (∀ (S : Type u) [CommRing S] [Algebra k S] (m : ℕ) (α : Fin m → S),
      let Δ_S : TensorProduct k B₀ S :=
        Finset.univ.prod fun l : Fin m => t ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] α l
      Function.Bijective (fun c : Fin (n * m) → S =>
        Ideal.Quotient.mk (Ideal.span ({Δ_S} : Set (TensorProduct k B₀ S)))
          (Finset.univ.sum fun idx : Fin (n * m) =>
            (t ^ ((finProdFinEquiv.symm idx).2 : ℕ) * b (finProdFinEquiv.symm idx).1) ⊗ₜ[k] c idx))) :=
by
  classical
  let E₀_lin : (Fin n → Polynomial k) →ₗ[k] B₀ :=
    { toFun := fun c => Finset.univ.sum fun i : Fin n => Polynomial.aeval t (c i) * b i
      map_add' := fun c₁ c₂ => by
        simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
      map_smul' := fun r c => by
        simp only [Pi.smul_apply, map_smul, smul_mul_assoc, Finset.smul_sum, RingHom.id_apply] }
  let e₀ : (Fin n → Polynomial k) ≃ₗ[k] B₀ := LinearEquiv.ofBijective E₀_lin _hb
  have he₀_monom : ∀ (i₀ : Fin n) (d : ℕ),
      e₀.symm (t ^ d * b i₀) = Pi.single i₀ (Polynomial.X ^ d) := by
    intro i₀ d
    apply e₀.injective
    rw [e₀.apply_symm_apply]
    symm
    let c₀ : Fin n → Polynomial k := Pi.single i₀ (Polynomial.X ^ d)
    change (Finset.univ.sum fun i : Fin n => Polynomial.aeval t (c₀ i) * b i) = t ^ d * b i₀
    rw [Finset.sum_eq_single i₀]
    · simp [c₀, Pi.single_eq_same]
    · intro i _ hne
      simp [c₀, Pi.single_eq_of_ne hne]
    · intro h_abs
      exact absurd (Finset.mem_univ i₀) h_abs
  have hPolyTensor : ∀ (S : Type u) [CommRing S] [Algebra k S],
      Function.Bijective (fun f : Fin n → Polynomial S =>
        Finset.univ.sum fun i : Fin n =>
          Polynomial.eval₂
            (Algebra.TensorProduct.includeRight : S →ₐ[k] TensorProduct k B₀ S).toRingHom
            (t ⊗ₜ[k] (1 : S)) (f i) * (b i ⊗ₜ[k] (1 : S))) ∧
      (Nontrivial S → ∀ s₀ : S, t ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] s₀ ≠ 0) := by
    intro S _ _
    let ι_S : S →+* TensorProduct k B₀ S :=
      (Algebra.TensorProduct.includeRight : S →ₐ[k] TensorProduct k B₀ S).toRingHom
    let ι_B : B₀ →+* TensorProduct k B₀ S :=
      (Algebra.TensorProduct.includeLeft : B₀ →ₐ[k] TensorProduct k B₀ S).toRingHom
    let Ψ_add : (Fin n → Polynomial S) →+ TensorProduct k B₀ S :=
      { toFun := fun f => Finset.univ.sum fun i : Fin n =>
          Polynomial.eval₂ ι_S (t ⊗ₜ[k] (1 : S)) (f i) * (b i ⊗ₜ[k] (1 : S))
        map_zero' := by simp [Polynomial.eval₂_zero]
        map_add' := fun f₁ f₂ => by
          simp only [Pi.add_apply, Polynomial.eval₂_add, add_mul, Finset.sum_add_distrib] }
    let β : B₀ →ₗ[k] S →ₗ[k] (Fin n → Polynomial S) :=
      { toFun := fun x =>
          { toFun := fun s i =>
              Polynomial.C s * ((e₀.symm x i).map (algebraMap k S))
            map_add' := fun s₁ s₂ => by
              ext i
              simp [map_add, add_mul]
            map_smul' := fun r s => by
              ext i d
              simp only [Pi.smul_apply, RingHom.id_apply, Polynomial.coeff_smul,
                Polynomial.coeff_C_mul, Polynomial.coeff_map]
              rw [Algebra.smul_def, Algebra.smul_def]
              ring }
        map_add' := fun x₁ x₂ => by
          ext s i
          simp [map_add, Polynomial.map_add, mul_add]
        map_smul' := fun r x => by
          ext s i d
          simp only [LinearMap.smul_apply, Pi.smul_apply, RingHom.id_apply]
          dsimp only [LinearMap.coe_mk, AddHom.coe_mk]
          rw [e₀.symm.map_smul]
          simp only [Pi.smul_apply, Polynomial.coeff_smul, Polynomial.coeff_C_mul,
            Polynomial.coeff_map, smul_eq_mul, map_mul]
          rw [Algebra.smul_def]
          ring }
    let Φ_S : TensorProduct k B₀ S →ₗ[k] (Fin n → Polynomial S) := TensorProduct.lift β
    have hcomp_k : ι_S.comp (algebraMap k S) = ι_B.comp (algebraMap k B₀) := by
      ext r
      simp only [RingHom.comp_apply, ι_S, ι_B, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      exact ((Algebra.TensorProduct.includeRight : S →ₐ[k] TensorProduct k B₀ S).commutes r).trans
        ((Algebra.TensorProduct.includeLeft : B₀ →ₐ[k] TensorProduct k B₀ S).commutes r).symm
    have hΨΦ : ∀ z : TensorProduct k B₀ S, Ψ_add (Φ_S z) = z := by
      intro z
      refine TensorProduct.induction_on (motive := fun w => Ψ_add (Φ_S w) = w) z ?_ ?_ ?_
      · rw [map_zero, map_zero]
      · intro x s
        rw [show Φ_S (x ⊗ₜ[k] s) = β x s from TensorProduct.lift.tmul x s]
        change (Finset.univ.sum fun i : Fin n =>
          Polynomial.eval₂ ι_S (t ⊗ₜ[k] (1 : S))
            (Polynomial.C s * ((e₀.symm x i).map (algebraMap k S))) *
            (b i ⊗ₜ[k] (1 : S))) = x ⊗ₜ[k] s
        have hterm : ∀ i : Fin n,
            Polynomial.eval₂ ι_S (t ⊗ₜ[k] (1 : S))
              (Polynomial.C s * ((e₀.symm x i).map (algebraMap k S))) *
              (b i ⊗ₜ[k] (1 : S)) =
            (Polynomial.aeval t (e₀.symm x i) * b i) ⊗ₜ[k] s := by
          intro i
          rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_map, hcomp_k]
          have hev : Polynomial.eval₂ (ι_B.comp (algebraMap k B₀)) (t ⊗ₜ[k] (1 : S)) (e₀.symm x i) =
              (Polynomial.aeval t (e₀.symm x i)) ⊗ₜ[k] (1 : S) := by
            change Polynomial.eval₂ (ι_B.comp (algebraMap k B₀)) (ι_B t) (e₀.symm x i) =
              ι_B (Polynomial.eval₂ (algebraMap k B₀) t (e₀.symm x i))
            exact (Polynomial.hom_eval₂ (e₀.symm x i) (algebraMap k B₀) ι_B t).symm
          rw [hev]
          change (((1 : B₀) ⊗ₜ[k] s) * ((Polynomial.aeval t (e₀.symm x i)) ⊗ₜ[k] (1 : S))) *
            (b i ⊗ₜ[k] (1 : S)) = _
          simp only [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
        simp_rw [hterm]
        rw [← TensorProduct.sum_tmul]
        have hex : (Finset.univ.sum fun i : Fin n => Polynomial.aeval t (e₀.symm x i) * b i) = x :=
          e₀.apply_symm_apply x
        rw [hex]
      · intro z₁ z₂ hz₁ hz₂
        rw [map_add, map_add, hz₁, hz₂]
    have hΦΨ_single : ∀ (i₀ : Fin n) (P : Polynomial S),
        Φ_S (Ψ_add (Pi.single i₀ P)) = Pi.single i₀ P := by
      intro i₀ P
      refine Polynomial.induction_on' P ?_ ?_
      · intro p q hp hq
        rw [Pi.single_add, map_add, map_add, hp, hq]
      · intro d s
        let f_mon : Fin n → Polynomial S := Pi.single i₀ (Polynomial.monomial d s)
        change Φ_S (Ψ_add f_mon) = f_mon
        have hΨ_mon : Ψ_add f_mon = (t ^ d * b i₀) ⊗ₜ[k] s := by
          change (Finset.univ.sum fun i : Fin n =>
            Polynomial.eval₂ ι_S (t ⊗ₜ[k] (1 : S)) (f_mon i) * (b i ⊗ₜ[k] (1 : S))) = _
          rw [Finset.sum_eq_single i₀]
          · dsimp only [f_mon]
            rw [Pi.single_eq_same, Polynomial.eval₂_monomial]
            change (((1 : B₀) ⊗ₜ[k] s) * (t ⊗ₜ[k] (1 : S)) ^ d) * (b i₀ ⊗ₜ[k] (1 : S)) = _
            rw [Algebra.TensorProduct.tmul_pow, one_pow]
            simp only [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
          · intro i _ hne
            simp [f_mon, Pi.single_eq_of_ne hne]
          · intro h_abs
            exact absurd (Finset.mem_univ i₀) h_abs
        rw [hΨ_mon, show Φ_S ((t ^ d * b i₀) ⊗ₜ[k] s) = β (t ^ d * b i₀) s from
          TensorProduct.lift.tmul _ _]
        funext j
        change Polynomial.C s * ((e₀.symm (t ^ d * b i₀) j).map (algebraMap k S)) = f_mon j
        rw [he₀_monom i₀ d]
        by_cases hj : j = i₀
        · subst hj
          simp [f_mon, Pi.single_eq_same, Polynomial.C_mul_X_pow_eq_monomial]
        · simp [f_mon, Pi.single_eq_of_ne hj]
    have hΦΨ : ∀ f : Fin n → Polynomial S, Φ_S (Ψ_add f) = f := by
      intro f
      rw [← Finset.univ_sum_single f, map_sum, map_sum]
      exact Finset.sum_congr rfl fun i₀ _ => hΦΨ_single i₀ (f i₀)
    have hΨ_bij : Function.Bijective Ψ_add :=
      ⟨Function.LeftInverse.injective hΦΨ, Function.RightInverse.surjective hΨΦ⟩
    refine ⟨hΨ_bij, fun hNontriv s₀ hlin0 => ?_⟩
    letI : Nontrivial S := hNontriv
    let i₀ : Fin n := ⟨0, _hn⟩
    let f₀ : Fin n → Polynomial S := Pi.single i₀ (Polynomial.X - Polynomial.C s₀)
    have hf₀_ne : f₀ ≠ 0 := by
      intro h0
      have hc1 : (f₀ i₀).coeff 1 = ((0 : Fin n → Polynomial S) i₀).coeff 1 :=
        congrArg (fun g : Fin n → Polynomial S => (g i₀).coeff 1) h0
      simp [f₀, Pi.single_eq_same] at hc1
    have hΨ_f₀ : Ψ_add f₀ =
        (t ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] s₀) * (b i₀ ⊗ₜ[k] (1 : S)) := by
      change (Finset.univ.sum fun i : Fin n =>
        Polynomial.eval₂ ι_S (t ⊗ₜ[k] (1 : S)) (f₀ i) * (b i ⊗ₜ[k] (1 : S))) = _
      rw [Finset.sum_eq_single i₀]
      · simp [f₀, Pi.single_eq_same, Polynomial.eval₂_sub, Polynomial.eval₂_X,
          Polynomial.eval₂_C, ι_S]
      · intro i _ hne
        simp [f₀, Pi.single_eq_of_ne hne]
      · intro h_abs
        exact absurd (Finset.mem_univ i₀) h_abs
    have hΨ_f₀_zero : Ψ_add f₀ = Ψ_add 0 := by
      rw [hΨ_f₀, hlin0, zero_mul, map_zero]
    exact hf₀_ne (hΨ_bij.1 hΨ_f₀_zero)
  let G : Set B₀ := {t} ∪ Set.range b
  have hAdjoin_top : Algebra.adjoin k G = ⊤ := by
    rw [eq_top_iff]
    intro x _
    obtain ⟨c, rfl⟩ := _hb.2 x
    have ht_mem : t ∈ Algebra.adjoin k G := Algebra.subset_adjoin (Or.inl rfl)
    have hb_mem : ∀ i : Fin n, b i ∈ Algebra.adjoin k G :=
      fun i => Algebra.subset_adjoin (Or.inr ⟨i, rfl⟩)
    have haeval_mem : ∀ P : Polynomial k, Polynomial.aeval t P ∈ Algebra.adjoin k G := by
      intro P
      refine Polynomial.induction_on' P ?_ ?_
      · intro p q hp hq
        rw [map_add]
        exact (Algebra.adjoin k G).add_mem hp hq
      · intro d a
        rw [Polynomial.aeval_monomial]
        exact (Algebra.adjoin k G).mul_mem ((Algebra.adjoin k G).algebraMap_mem a)
          ((Algebra.adjoin k G).pow_mem ht_mem d)
    exact (Algebra.adjoin k G).sum_mem fun i _ =>
      (Algebra.adjoin k G).mul_mem (haeval_mem (c i)) (hb_mem i)
  have hG_fin : G.Finite := (Set.finite_singleton t).union (Set.finite_range b)
  haveI hFT_B₀ : Algebra.FiniteType k B₀ :=
    ⟨⟨hG_fin.toFinset, by rw [Set.Finite.coe_toFinset, hAdjoin_top]⟩⟩
  have hKerSpan : ∀ (S : Type u) [CommRing S] [Algebra k S] (p : B₀ →ₐ[k] S),
      RingHom.ker (Algebra.TensorProduct.productMap p (AlgHom.id k S)).toRingHom =
        Ideal.span ({t ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p t} ∪
          Set.range (fun i : Fin n => b i ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p (b i))) := by
    intro S _ _ p
    let μ_p := Algebra.TensorProduct.productMap p (AlgHom.id k S)
    let J_p : Ideal (TensorProduct k B₀ S) :=
      Ideal.span ({t ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p t} ∪
        Set.range (fun i : Fin n => b i ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p (b i)))
    apply le_antisymm
    · let A_p : Subalgebra k B₀ :=
        { carrier := {x : B₀ | x ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p x ∈ J_p}
          mul_mem' := by
            intro x y hx hy
            change (x * y) ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p (x * y) ∈ J_p
            have hsplit : (x * y) ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p (x * y) =
                (x ⊗ₜ[k] (1 : S)) * (y ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p y) +
                ((1 : B₀) ⊗ₜ[k] p y) * (x ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p x) := by
              rw [map_mul, mul_sub, mul_sub]
              simp only [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
              rw [mul_comm (p y) (p x)]
              abel
            rw [hsplit]
            exact J_p.add_mem (J_p.mul_mem_left _ hy) (J_p.mul_mem_left _ hx)
          one_mem' := by
            change (1 : B₀) ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p 1 ∈ J_p
            rw [map_one, sub_self]
            exact J_p.zero_mem
          add_mem' := by
            intro x y hx hy
            change (x + y) ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p (x + y) ∈ J_p
            have hsplit : (x + y) ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p (x + y) =
                (x ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p x) +
                (y ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p y) := by
              rw [TensorProduct.add_tmul, map_add, TensorProduct.tmul_add]
              abel
            rw [hsplit]
            exact J_p.add_mem hx hy
          zero_mem' := by
            change (0 : B₀) ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p 0 ∈ J_p
            simp [J_p.zero_mem]
          algebraMap_mem' := by
            intro r
            change (algebraMap k B₀ r) ⊗ₜ[k] (1 : S) -
              (1 : B₀) ⊗ₜ[k] p (algebraMap k B₀ r) ∈ J_p
            rw [p.commutes r, Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
              TensorProduct.smul_tmul, sub_self]
            exact J_p.zero_mem }
      have hG_le : G ≤ (A_p : Set B₀) := by
        rintro x (rfl | ⟨i, rfl⟩)
        · exact Ideal.subset_span (Or.inl rfl)
        · exact Ideal.subset_span (Or.inr ⟨i, rfl⟩)
      have hA_top : A_p = ⊤ := eq_top_iff.mpr (hAdjoin_top ▸ Algebra.adjoin_le hG_le)
      have hx_mem : ∀ x : B₀, x ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p x ∈ J_p := by
        intro x
        have hx_top : x ∈ (⊤ : Subalgebra k B₀) := Algebra.mem_top
        rw [← hA_top] at hx_top
        exact hx_top
      have hz_mem : ∀ z : TensorProduct k B₀ S, z - (1 : B₀) ⊗ₜ[k] μ_p z ∈ J_p := by
        intro z
        refine TensorProduct.induction_on
          (motive := fun w => w - (1 : B₀) ⊗ₜ[k] μ_p w ∈ J_p) z ?_ ?_ ?_
        · rw [map_zero, TensorProduct.tmul_zero, sub_self]
          exact J_p.zero_mem
        · intro x s
          have hpure : x ⊗ₜ[k] s - (1 : B₀) ⊗ₜ[k] μ_p (x ⊗ₜ[k] s) =
              ((1 : B₀) ⊗ₜ[k] s) * (x ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p x) := by
            rw [mul_sub]
            simp only [μ_p, Algebra.TensorProduct.productMap_apply_tmul, AlgHom.id_apply,
              Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one, mul_comm s (p x)]
          rw [hpure]
          exact J_p.mul_mem_left _ (hx_mem x)
        · intro z₁ z₂ hz₁ hz₂
          have hadd : (z₁ + z₂) - (1 : B₀) ⊗ₜ[k] μ_p (z₁ + z₂) =
              (z₁ - (1 : B₀) ⊗ₜ[k] μ_p z₁) + (z₂ - (1 : B₀) ⊗ₜ[k] μ_p z₂) := by
            rw [map_add, TensorProduct.tmul_add]
            abel
          rw [hadd]
          exact J_p.add_mem hz₁ hz₂
      intro r hr
      rw [RingHom.mem_ker] at hr
      have hr0 : μ_p r = 0 := hr
      have hmem := hz_mem r
      rwa [hr0, TensorProduct.tmul_zero, sub_zero] at hmem
    · rw [Ideal.span_le]
      rintro g (rfl | ⟨i, rfl⟩) <;>
      · rw [SetLike.mem_coe, RingHom.mem_ker]
        change μ_p _ = 0
        simp [μ_p, Algebra.TensorProduct.productMap_apply_tmul]
  have hSepPt : ∀ x : B₀, x ≠ 0 → ∃ φ : B₀ →ₐ[k] k, φ x ≠ 0 := by
    intro x hx
    let B_x := Localization.Away x
    have hpow_nzd : Submonoid.powers x ≤ nonZeroDivisors B₀ := by
      rintro _ ⟨m, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero m hx)
    letI : IsDomain B_x := IsLocalization.isDomain_localization hpow_nzd
    haveI : Algebra.FinitePresentation B₀ B_x := IsLocalization.Away.finitePresentation x
    haveI hFT_Bx0 : Algebra.FiniteType B₀ B_x := Algebra.FiniteType.of_finitePresentation
    haveI : Algebra.FiniteType k B_x := Algebra.FiniteType.trans hFT_B₀ hFT_Bx0
    obtain ⟨𝔪, h𝔪_max⟩ := Ideal.exists_maximal B_x
    letI : 𝔪.IsMaximal := h𝔪_max
    let L := B_x ⧸ 𝔪
    letI : Field L := Ideal.Quotient.field 𝔪
    let q_k : B_x →ₐ[k] L := Ideal.Quotient.mkₐ k 𝔪
    have hq_surj : Function.Surjective q_k := Ideal.Quotient.mk_surjective
    haveI : Algebra.FiniteType k L := Algebra.FiniteType.of_surjective q_k hq_surj
    haveI : Module.Finite k L := finite_of_finite_type_of_isJacobsonRing k L
    haveI : Algebra.IsIntegral k L := Algebra.IsIntegral.of_finite k L
    have hbij_L : Function.Bijective (Algebra.ofId k L) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k) (K := L)
    let e_L : k ≃ₐ[k] L := AlgEquiv.ofBijective (Algebra.ofId k L) hbij_L
    let ψ : B_x →ₐ[k] k := e_L.symm.toAlgHom.comp q_k
    let φ : B₀ →ₐ[k] k := ψ.comp (IsScalarTower.toAlgHom k B₀ B_x)
    refine ⟨φ, ?_⟩
    have hinv := congrArg ψ (IsLocalization.Away.mul_invSelf x)
    rw [map_mul, map_one] at hinv
    exact left_ne_zero_of_mul_eq_one hinv
  have hIsDomain : ∀ (S : Type u) [CommRing S] [IsDomain S] [Algebra k S],
      IsDomain (TensorProduct k B₀ S) := by
    intro S _ _ _
    let ι := Module.Free.ChooseBasisIndex k S
    let bS : Module.Basis ι k S := Module.Free.chooseBasis k S
    let B_tp : Module.Basis ι B₀ (TensorProduct k B₀ S) :=
      Algebra.TensorProduct.basis B₀ bS
    have hExpand : ∀ z : TensorProduct k B₀ S,
        z = (B_tp.repr z).support.sum fun j => (B_tp.repr z j) ⊗ₜ[k] bS j := by
      intro z
      conv_lhs => rw [← B_tp.linearCombination_repr z, Finsupp.linearCombination_apply,
        Finsupp.sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Algebra.TensorProduct.basis_apply, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    have hCoeffEval : ∀ (φ : B₀ →ₐ[k] k) (z : TensorProduct k B₀ S) (j₀ : ι),
        j₀ ∈ (B_tp.repr z).support →
        let φ_S : TensorProduct k B₀ S →ₐ[k] S :=
          Algebra.TensorProduct.productMap ((Algebra.ofId k S).comp φ) (AlgHom.id k S)
        bS.repr (φ_S z) j₀ = φ (B_tp.repr z j₀) := by
      intro φ z j₀ hj₀ φ_S
      have hφz : φ_S z = (B_tp.repr z).support.sum fun j => φ (B_tp.repr z j) • bS j := by
        conv_lhs => rw [hExpand z]
        rw [map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        simp only [φ_S, Algebra.TensorProduct.productMap_apply_tmul, AlgHom.comp_apply,
          Algebra.ofId_apply, AlgHom.id_apply, Algebra.smul_def]
      rw [hφz, map_sum, Finsupp.finsetSum_apply]
      rw [Finset.sum_eq_single j₀]
      · rw [map_smul, Finsupp.smul_apply, bS.repr_self, Finsupp.single_eq_same,
          smul_eq_mul, mul_one]
      · intro j _ hne
        simp [bS.repr_self, Ne.symm hne]
      · intro h_abs
        exact absurd hj₀ h_abs
    haveI : Nontrivial (TensorProduct k B₀ S) := by
      obtain ⟨φ₀, -⟩ := hSepPt 1 one_ne_zero
      let φ₀_S : TensorProduct k B₀ S →ₐ[k] S :=
        Algebra.TensorProduct.productMap ((Algebra.ofId k S).comp φ₀) (AlgHom.id k S)
      refine ⟨⟨1, 0, fun h10 => ?_⟩⟩
      have hS10 : (1 : S) = 0 := by
        rw [← map_one φ₀_S, h10, map_zero]
      exact one_ne_zero hS10
    haveI : NoZeroDivisors (TensorProduct k B₀ S) := by
      refine ⟨fun {u v} huv => ?_⟩
      by_contra h_not
      push_neg at h_not
      rcases h_not with ⟨hu, hv⟩
      have hu_repr : B_tp.repr u ≠ 0 :=
        fun h0 => hu (B_tp.repr.injective (h0.trans (map_zero _).symm))
      have hv_repr : B_tp.repr v ≠ 0 :=
        fun h0 => hv (B_tp.repr.injective (h0.trans (map_zero _).symm))
      obtain ⟨j₁, hj₁⟩ := Finsupp.support_nonempty_iff.mpr hu_repr
      obtain ⟨j₂, hj₂⟩ := Finsupp.support_nonempty_iff.mpr hv_repr
      have hx₁ : B_tp.repr u j₁ ≠ 0 := Finsupp.mem_support_iff.mp hj₁
      have hy₂ : B_tp.repr v j₂ ≠ 0 := Finsupp.mem_support_iff.mp hj₂
      obtain ⟨φ, hφ_prod⟩ := hSepPt (B_tp.repr u j₁ * B_tp.repr v j₂) (mul_ne_zero hx₁ hy₂)
      rw [map_mul] at hφ_prod
      have hφx₁ : φ (B_tp.repr u j₁) ≠ 0 := left_ne_zero_of_mul hφ_prod
      have hφy₂ : φ (B_tp.repr v j₂) ≠ 0 := right_ne_zero_of_mul hφ_prod
      let φ_S : TensorProduct k B₀ S →ₐ[k] S :=
        Algebra.TensorProduct.productMap ((Algebra.ofId k S).comp φ) (AlgHom.id k S)
      have hφu_ne : φ_S u ≠ 0 := by
        intro h0
        apply hφx₁
        rw [← hCoeffEval φ u j₁ hj₁, h0, map_zero, Finsupp.zero_apply]
      have hφv_ne : φ_S v ≠ 0 := by
        intro h0
        apply hφy₂
        rw [← hCoeffEval φ v j₂ hj₂, h0, map_zero, Finsupp.zero_apply]
      have hφuv : φ_S u * φ_S v = 0 := by
        rw [← map_mul, huv, map_zero]
      exact mul_ne_zero hφu_ne hφv_ne hφuv
    exact NoZeroDivisors.to_isDomain (TensorProduct k B₀ S)
  have hMonicBij : ∀ (S : Type u) [CommRing S] [Algebra k S] (m : ℕ) (α : Fin m → S),
      let Δ_S : TensorProduct k B₀ S :=
        Finset.univ.prod fun l : Fin m => t ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] α l
      Function.Bijective (fun c : Fin (n * m) → S =>
        Ideal.Quotient.mk (Ideal.span ({Δ_S} : Set (TensorProduct k B₀ S)))
          (Finset.univ.sum fun idx : Fin (n * m) =>
            (t ^ ((finProdFinEquiv.symm idx).2 : ℕ) * b (finProdFinEquiv.symm idx).1) ⊗ₜ[k] c idx)) := by
    intro S _ _ m α Δ_S
    let R := TensorProduct k B₀ S
    let ι_S : S →+* R := (Algebra.TensorProduct.includeRight : S →ₐ[k] R).toRingHom
    let τ : R := t ⊗ₜ[k] (1 : S)
    let β_i : Fin n → R := fun i => b i ⊗ₜ[k] (1 : S)
    let Ψ : (Fin n → Polynomial S) → R := fun f =>
      Finset.univ.sum fun i : Fin n => Polynomial.eval₂ ι_S τ (f i) * β_i i
    have hΨ : Function.Bijective Ψ := (hPolyTensor S).1
    let I_Δ : Ideal R := Ideal.span ({Δ_S} : Set R)
    by_cases hS : Nontrivial S
    · letI : Nontrivial S := hS
      let M : Polynomial S := Finset.univ.prod fun l : Fin m =>
        Polynomial.X - Polynomial.C (α l)
      have hM_monic : M.Monic :=
        Polynomial.monic_prod_of_monic Finset.univ _ (fun l _ => Polynomial.monic_X_sub_C (α l))
      have hM_natDeg : M.natDegree = m := by
        dsimp only [M]
        rw [Polynomial.natDegree_prod_of_monic Finset.univ _
          (fun l _ => Polynomial.monic_X_sub_C (α l))]
        simp
      have hM_deg : M.degree = (m : WithBot ℕ) := by
        rw [Polynomial.degree_eq_natDegree hM_monic.ne_zero, hM_natDeg]
      have hM_eval : Polynomial.eval₂ ι_S τ M = Δ_S := by
        dsimp only [M, Δ_S, τ, ι_S]
        rw [Polynomial.eval₂_finsetProd]
        refine Finset.prod_congr rfl fun l _ => ?_
        simp [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
      have hΨ_sub : ∀ f g : Fin n → Polynomial S, Ψ (f - g) = Ψ f - Ψ g := by
        intro f g
        simp only [Ψ, Pi.sub_apply, Polynomial.eval₂_sub, sub_mul, Finset.sum_sub_distrib]
      have hΨ_mul : ∀ (P : Polynomial S) (g : Fin n → Polynomial S),
          Ψ (fun i => P * g i) = Polynomial.eval₂ ι_S τ P * Ψ g := by
        intro P g
        dsimp only [Ψ]
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Polynomial.eval₂_mul, mul_assoc]
      have hMem_iff : ∀ f : Fin n → Polynomial S,
           Ψ f ∈ I_Δ ↔ ∀ i : Fin n, f i %ₘ M = 0 := by
        intro f
        rw [Ideal.mem_span_singleton]
        constructor
        · rintro ⟨r, hr⟩
          obtain ⟨g, rfl⟩ := hΨ.2 r
          rw [← hM_eval, ← hΨ_mul] at hr
          have hfg := hΨ.1 hr
          intro i
          rw [Polynomial.modByMonic_eq_zero_iff_dvd hM_monic]
          exact ⟨g i, congrFun hfg i⟩
        · intro hmod
          have hdvd : ∀ i : Fin n, ∃ q : Polynomial S, f i = M * q := fun i =>
            (Polynomial.modByMonic_eq_zero_iff_dvd hM_monic).mp (hmod i)
          choose g hg using hdvd
          refine ⟨Ψ g, ?_⟩
          rw [← hM_eval, ← hΨ_mul]
          congr 1
          funext i
          exact hg i
      let f_c : (Fin (n * m) → S) → (Fin n → Polynomial S) := fun c i =>
        Finset.univ.sum fun d : Fin m =>
          Polynomial.monomial (d : ℕ) (c (finProdFinEquiv (i, d)))
      have hΨ_fc : ∀ c : Fin (n * m) → S,
          Ψ (f_c c) = Finset.univ.sum fun idx : Fin (n * m) =>
            (t ^ ((finProdFinEquiv.symm idx).2 : ℕ) * b (finProdFinEquiv.symm idx).1) ⊗ₜ[k]
              c idx := by
        intro c
        have hsum_eq := (Equiv.sum_comp finProdFinEquiv.symm (fun p : Fin n × Fin m =>
          (t ^ (p.2 : ℕ) * b p.1) ⊗ₜ[k] c (finProdFinEquiv p))).symm
        simp only [Equiv.apply_symm_apply] at hsum_eq
        rw [← hsum_eq, Fintype.sum_prod_type]
        dsimp only [Ψ, f_c]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Polynomial.eval₂_finsetSum, Finset.sum_mul]
        refine Finset.sum_congr rfl fun d _ => ?_
        rw [Polynomial.eval₂_monomial]
        change (((1 : B₀) ⊗ₜ[k] c (finProdFinEquiv (i, d))) *
          (t ⊗ₜ[k] (1 : S)) ^ (d : ℕ)) * (b i ⊗ₜ[k] (1 : S)) = _
        rw [Algebra.TensorProduct.tmul_pow, one_pow]
        simp only [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
      have hfc_coeff_lt : ∀ (c : Fin (n * m) → S) (i : Fin n) (k₀ : ℕ) (hk₀ : k₀ < m),
          (f_c c i).coeff k₀ = c (finProdFinEquiv (i, ⟨k₀, hk₀⟩)) := by
        intro c i k₀ hk₀
        dsimp only [f_c]
        rw [Polynomial.finsetSum_coeff, Finset.sum_eq_single ⟨k₀, hk₀⟩]
        · simp
        · intro d _ hne
          have hval_ne : (d : ℕ) ≠ k₀ := fun hv => hne (Fin.ext hv)
          simp [Polynomial.coeff_monomial, hval_ne]
        · intro h_abs
          exact absurd (Finset.mem_univ _) h_abs
      have hfc_coeff_ge : ∀ (c : Fin (n * m) → S) (i : Fin n) (k₀ : ℕ),
          m ≤ k₀ → (f_c c i).coeff k₀ = 0 := by
        intro c i k₀ hk₀
        dsimp only [f_c]
        rw [Polynomial.finsetSum_coeff]
        refine Finset.sum_eq_zero fun d _ => ?_
        have hval_ne : (d : ℕ) ≠ k₀ := Nat.ne_of_lt (lt_of_lt_of_le d.isLt hk₀)
        simp [Polynomial.coeff_monomial, hval_ne]
      have hfc_mod : ∀ (c : Fin (n * m) → S) (i : Fin n), (f_c c i) %ₘ M = f_c c i := by
        intro c i
        rw [Polynomial.modByMonic_eq_self_iff hM_monic, hM_deg,
          Polynomial.degree_lt_iff_coeff_zero]
        exact hfc_coeff_ge c i
      have hfc_sub : ∀ (c₁ c₂ : Fin (n * m) → S), f_c (c₁ - c₂) = f_c c₁ - f_c c₂ := by
        intro c₁ c₂
        ext i k₀
        simp only [f_c, Pi.sub_apply, Polynomial.coeff_sub, Polynomial.finsetSum_coeff,
          Polynomial.coeff_monomial]
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun d _ => ?_
        split_ifs <;> simp
      constructor
      · intro c₁ c₂ hc_eq
        dsimp only at hc_eq
        rw [← hΨ_fc c₁, ← hΨ_fc c₂] at hc_eq
        have hsub_mem : Ψ (f_c (c₁ - c₂)) ∈ I_Δ := by
          rw [hfc_sub, hΨ_sub]
          exact Ideal.Quotient.eq.mp hc_eq
        have hmod0 := (hMem_iff (f_c (c₁ - c₂))).mp hsub_mem
        have hfc0 : ∀ i : Fin n, f_c (c₁ - c₂) i = 0 := by
          intro i
          rw [← hfc_mod (c₁ - c₂) i, hmod0 i]
        ext idx
        let p := finProdFinEquiv.symm idx
        have hp : finProdFinEquiv p = idx := finProdFinEquiv.apply_symm_apply idx
        have h0 : (c₁ - c₂) idx = 0 := by
          rw [← hp, ← hfc_coeff_lt (c₁ - c₂) p.1 p.2.1 p.2.2, hfc0 p.1,
             Polynomial.coeff_zero]
        exact sub_eq_zero.mp h0
      · intro y
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
        obtain ⟨f, rfl⟩ := hΨ.2 r
        let c : Fin (n * m) → S := fun idx =>
          (f (finProdFinEquiv.symm idx).1 %ₘ M).coeff ((finProdFinEquiv.symm idx).2 : ℕ)
        have hfc_eq_mod : ∀ i : Fin n, f_c c i = f i %ₘ M := by
          intro i
          ext k₀
          by_cases hk₀ : k₀ < m
          · rw [hfc_coeff_lt c i k₀ hk₀]
            dsimp only [c]
            rw [Equiv.symm_apply_apply]
          · have hge : m ≤ k₀ := Nat.le_of_not_lt hk₀
            rw [hfc_coeff_ge c i k₀ hge]
            have hdeg_lt : (f i %ₘ M).degree < (m : WithBot ℕ) := by
              rw [← hM_deg]
              exact Polynomial.degree_modByMonic_lt (f i) hM_monic
            exact ((Polynomial.degree_lt_iff_coeff_zero _ m).mp hdeg_lt k₀ hge).symm
        refine ⟨c, ?_⟩
        dsimp only
        rw [← hΨ_fc c]
        apply Ideal.Quotient.eq.mpr
        rw [← hΨ_sub]
        have hdiff_mod : ∀ i : Fin n, (f_c c - f) i %ₘ M = 0 := by
          intro i
          rw [Pi.sub_apply, hfc_eq_mod i, Polynomial.modByMonic_eq_zero_iff_dvd hM_monic]
          refine ⟨-(f i /ₘ M), ?_⟩
          have hdiv := Polynomial.modByMonic_add_div (f i) M
          calc
            f i %ₘ M - f i = f i %ₘ M - (f i %ₘ M + M * (f i /ₘ M)) := by
              conv_lhs => rhs; rw [← hdiv]
            _ = M * -(f i /ₘ M) := by ring
        exact (hMem_iff (f_c c - f)).mpr hdiff_mod
    · haveI : Subsingleton S := not_nontrivial_iff_subsingleton.mp hS
      haveI : Subsingleton (Polynomial S) :=
        ⟨fun p q => Polynomial.ext fun d => Subsingleton.elim _ _⟩
      haveI : Subsingleton R :=
        ⟨fun r₁ r₂ => by
          obtain ⟨f₁, rfl⟩ := hΨ.2 r₁
          obtain ⟨f₂, rfl⟩ := hΨ.2 r₂
          exact congrArg Ψ (Subsingleton.elim f₁ f₂)⟩
      haveI : Subsingleton (R ⧸ I_Δ) :=
        ⟨fun y₁ y₂ => by
          obtain ⟨r₁, rfl⟩ := Ideal.Quotient.mk_surjective y₁
          obtain ⟨r₂, rfl⟩ := Ideal.Quotient.mk_surjective y₂
          exact congrArg (Ideal.Quotient.mk I_Δ) (Subsingleton.elim r₁ r₂)⟩
      exact ⟨fun c₁ c₂ _ => Subsingleton.elim c₁ c₂, fun y => ⟨0, Subsingleton.elim _ _⟩⟩
  refine ⟨fun S _ _ _ => ⟨hIsDomain S, (hPolyTensor S).2 inferInstance⟩, hKerSpan, hMonicBij⟩

theorem weil_two_stage_nakayama_graph_principalization (k : Type u) [Field k]
    (B₀ : Type u) [CommRing B₀] [Algebra k B₀]
    (t : B₀) (n : ℕ) (b : Fin n → B₀)
    (A₀ : Type u) [CommRing A₀] [Algebra k A₀]
    (ev₀ : A₀ →ₐ[k] k)
    (K_pos K_neg : ℕ)
    (p_pos : Fin K_pos → (B₀ →ₐ[k] A₀))
    (q_neg : Fin K_neg → (B₀ →ₐ[k] A₀))
    (z_pos : Fin K_pos → B₀)
    (z_neg : Fin K_neg → B₀) :
    (∀ (S : Type u) [CommRing S] [Algebra k S] (p : B₀ →ₐ[k] S),
      RingHom.ker (Algebra.TensorProduct.productMap p (AlgHom.id k S)).toRingHom =
        Ideal.span ({t ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p t} ∪
          Set.range (fun i : Fin n => b i ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p (b i)))) →
    (let Δ_pos₀ : TensorProduct k B₀ A₀ :=
       Finset.univ.prod fun i : Fin K_pos => t ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] p_pos i t
     let Δ_neg₀ : TensorProduct k B₀ A₀ :=
       Finset.univ.prod fun j : Fin K_neg => t ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] q_neg j t
     ∀ r : TensorProduct k B₀ A₀,
       ∃ (q : TensorProduct k B₀ A₀) (c : Fin (n * (K_pos + K_neg)) → A₀),
         r = (Δ_pos₀ * Δ_neg₀) * q +
           Finset.univ.sum fun idx : Fin (n * (K_pos + K_neg)) =>
             (t ^ ((finProdFinEquiv.symm idx).2 : ℕ) * b (finProdFinEquiv.symm idx).1) ⊗ₜ[k] c idx) →
    (let Δ_bar : B₀ :=
       (Finset.univ.prod fun i : Fin K_pos => t - algebraMap k B₀ (ev₀ (p_pos i t))) *
       (Finset.univ.prod fun j : Fin K_neg => t - algebraMap k B₀ (ev₀ (q_neg j t)))
     (∀ i : Fin K_pos,
       let 𝔪_i := RingHom.ker (ev₀.comp (p_pos i)).toRingHom
       let u_i := z_pos i - algebraMap k B₀ (ev₀ (p_pos i (z_pos i)))
       𝔪_i = Ideal.span ({u_i} : Set B₀) ⊔ Ideal.span ({Δ_bar} : Set B₀) • 𝔪_i) ∧
     (∀ j : Fin K_neg,
       let 𝔫_j := RingHom.ker (ev₀.comp (q_neg j)).toRingHom
       let v_j := z_neg j - algebraMap k B₀ (ev₀ (q_neg j (z_neg j)))
       𝔫_j = Ideal.span ({v_j} : Set B₀) ⊔ Ideal.span ({Δ_bar} : Set B₀) • 𝔫_j)) →
    ∃ (a₁ : A₀),
      ev₀ a₁ = 1 ∧
      let A₁ := Localization.Away a₁
      let R₁ := TensorProduct k B₀ A₁
      let ι₁ : A₀ →ₐ[k] A₁ := IsScalarTower.toAlgHom k A₀ A₁
      let p₁ : Fin K_pos → (B₀ →ₐ[k] A₁) := fun i => ι₁.comp (p_pos i)
      let q₁ : Fin K_neg → (B₀ →ₐ[k] A₁) := fun j => ι₁.comp (q_neg j)
      let μ_pos₁ : Fin K_pos → (R₁ →ₐ[k] A₁) := fun i =>
        Algebra.TensorProduct.productMap (p₁ i) (AlgHom.id k A₁)
      let μ_neg₁ : Fin K_neg → (R₁ →ₐ[k] A₁) := fun j =>
        Algebra.TensorProduct.productMap (q₁ j) (AlgHom.id k A₁)
      let Δ_pos₁ : R₁ := Finset.univ.prod fun i : Fin K_pos =>
        t ⊗ₜ[k] (1 : A₁) - (1 : B₀) ⊗ₜ[k] (p₁ i t)
      let Δ_neg₁ : R₁ := Finset.univ.prod fun j : Fin K_neg =>
        t ⊗ₜ[k] (1 : A₁) - (1 : B₀) ⊗ₜ[k] (q₁ j t)
      let u_pos₁ : Fin K_pos → R₁ := fun i =>
        z_pos i ⊗ₜ[k] (1 : A₁) - (1 : B₀) ⊗ₜ[k] (p₁ i (z_pos i))
      let u_neg₁ : Fin K_neg → R₁ := fun j =>
        z_neg j ⊗ₜ[k] (1 : A₁) - (1 : B₀) ⊗ₜ[k] (q₁ j (z_neg j))
      ∃ (H₁ : R₁),
        H₁ - 1 ∈ Ideal.span ({Δ_pos₁ * Δ_neg₁} : Set R₁) ∧
        (∀ (i : Fin K_pos) (r : R₁),
          r ∈ RingHom.ker (μ_pos₁ i).toRingHom → H₁ * r ∈ Ideal.span ({u_pos₁ i} : Set R₁)) ∧
        (∀ (j : Fin K_neg) (r : R₁),
          r ∈ RingHom.ker (μ_neg₁ j).toRingHom → H₁ * r ∈ Ideal.span ({u_neg₁ j} : Set R₁)) :=
by
  intro hKerSpan hRem₀ hBaseNak
  classical
  rcases hBaseNak with ⟨h_pos₀, h_neg₀⟩
  let Δ_pos₀ : TensorProduct k B₀ A₀ :=
    Finset.univ.prod fun i : Fin K_pos => t ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] p_pos i t
  let Δ_neg₀ : TensorProduct k B₀ A₀ :=
    Finset.univ.prod fun j : Fin K_neg => t ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] q_neg j t
  let Δ_tot₀ : TensorProduct k B₀ A₀ := Δ_pos₀ * Δ_neg₀
  let Δ_bar : B₀ :=
    (Finset.univ.prod fun i : Fin K_pos => t - algebraMap k B₀ (ev₀ (p_pos i t))) *
    (Finset.univ.prod fun j : Fin K_neg => t - algebraMap k B₀ (ev₀ (q_neg j t)))
  
  have hSpanSmulLe : ∀ {R : Type u} [CommRing R] (d : R) (J : Ideal R),
      Ideal.span ({d} : Set R) • J ≤ J := by
    intro R _ d J
    exact Submodule.smul_le.mpr fun s _ y hy => J.mul_mem_left s hy
  have hMemSpanSmul : ∀ {R : Type u} [CommRing R] (d : R) (J : Ideal R) {w : R},
      w ∈ Ideal.span ({d} : Set R) • J → ∃ y ∈ J, w = d * y := by
    intro R _ d J w hw
    have hle : Ideal.span ({d} : Set R) • J ≤ Submodule.map (LinearMap.mulLeft R d) J := by
      refine Submodule.smul_le.mpr fun s hs y hy => ?_
      rcases Ideal.mem_span_singleton.mp hs with ⟨q, rfl⟩
      exact Submodule.mem_map.mpr ⟨q * y, J.mul_mem_left q hy, by dsimp; ring⟩
    rcases Submodule.mem_map.mp (hle hw) with ⟨y, hy, hyw⟩
    exact ⟨y, hy, hyw.symm⟩
  
  let g_gen : ∀ (S : Type u) [CommRing S] [Algebra k S],
      (B₀ →ₐ[k] S) → Fin (n + 1) → TensorProduct k B₀ S :=
    fun S _ _ p => Fin.cases
      (t ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p t)
      (fun α => b α ⊗ₜ[k] (1 : S) - (1 : B₀) ⊗ₜ[k] p (b α))
  have hKerGen : ∀ (S : Type u) [CommRing S] [Algebra k S] (p : B₀ →ₐ[k] S),
      RingHom.ker (Algebra.TensorProduct.productMap p (AlgHom.id k S)).toRingHom =
        Ideal.span (Set.range (g_gen S p)) := by
    intro S _ _ p
    rw [hKerSpan S p]
    congr 1
    ext x
    constructor
    · rintro (h0 | ⟨α, rfl⟩)
      · rw [Set.mem_singleton_iff] at h0
        subst h0
        exact ⟨0, by simp [g_gen]⟩
      · exact ⟨Fin.succ α, by simp [g_gen]⟩
    · rintro ⟨β, rfl⟩
      refine Fin.cases ?_ ?_ β
      · exact Or.inl (by simp [g_gen])
      · intro α
        exact Or.inr ⟨α, by simp [g_gen]⟩
  have hg_gen_mem : ∀ (S : Type u) [CommRing S] [Algebra k S] (p : B₀ →ₐ[k] S) (β : Fin (n + 1)),
      g_gen S p β ∈ RingHom.ker (Algebra.TensorProduct.productMap p (AlgHom.id k S)).toRingHom := by
    intro S _ _ p β
    rw [hKerGen S p]
    exact Ideal.subset_span ⟨β, rfl⟩
  
  have hStage1 : ∀ (p : B₀ →ₐ[k] A₀) (z : B₀),
      (let 𝔪_p := RingHom.ker (ev₀.comp p).toRingHom
       let u_bar := z - algebraMap k B₀ (ev₀ (p z))
       𝔪_p = Ideal.span ({u_bar} : Set B₀) ⊔ Ideal.span ({Δ_bar} : Set B₀) • 𝔪_p) →
      ∃ a_p : A₀,
        ev₀ a_p = 1 ∧
        let μ₀ : TensorProduct k B₀ A₀ →ₐ[k] A₀ :=
          Algebra.TensorProduct.productMap p (AlgHom.id k A₀)
        let I₀ : Ideal (TensorProduct k B₀ A₀) := RingHom.ker μ₀.toRingHom
        let u₀ : TensorProduct k B₀ A₀ := z ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] p z
        let L₀ : Ideal (TensorProduct k B₀ A₀) :=
          Ideal.span ({u₀} : Set (TensorProduct k B₀ A₀)) ⊔
            Ideal.span ({Δ_tot₀} : Set (TensorProduct k B₀ A₀)) • I₀
        ∀ r ∈ I₀, ((1 : B₀) ⊗ₜ[k] a_p) * r ∈ L₀ := by
    intro p z hBase_p
    let 𝔪_p : Ideal B₀ := RingHom.ker (ev₀.comp p).toRingHom
    let u_bar : B₀ := z - algebraMap k B₀ (ev₀ (p z))
    let μ₀ : TensorProduct k B₀ A₀ →ₐ[k] A₀ :=
      Algebra.TensorProduct.productMap p (AlgHom.id k A₀)
    let I₀ : Ideal (TensorProduct k B₀ A₀) := RingHom.ker μ₀.toRingHom
    let u₀ : TensorProduct k B₀ A₀ := z ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] p z
    let L₀ : Ideal (TensorProduct k B₀ A₀) :=
      Ideal.span ({u₀} : Set (TensorProduct k B₀ A₀)) ⊔
        Ideal.span ({Δ_tot₀} : Set (TensorProduct k B₀ A₀)) • I₀
    have hu₀_mem : u₀ ∈ I₀ := by
      rw [RingHom.mem_ker]
      change μ₀ (z ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] p z) = 0
      simp [μ₀, Algebra.TensorProduct.productMap_apply_tmul]
    have hL₀_le : L₀ ≤ I₀ :=
      sup_le (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hu₀_mem)) (hSpanSmulLe Δ_tot₀ I₀)
    let Q_p := TensorProduct k B₀ A₀ ⧸ L₀
    let mk_L : TensorProduct k B₀ A₀ →+* Q_p := Ideal.Quotient.mk L₀
    let ρ_p : A₀ →+* Q_p :=
      mk_L.comp (Algebra.TensorProduct.includeRight : A₀ →ₐ[k] TensorProduct k B₀ A₀).toRingHom
    letI : Algebra A₀ Q_p := ρ_p.toAlgebra
    have hsmul_mk : ∀ (a : A₀) (r : TensorProduct k B₀ A₀),
        a • mk_L r = mk_L (((1 : B₀) ⊗ₜ[k] a) * r) := by
      intro a r
      rw [Algebra.smul_def]
      change mk_L ((1 : B₀) ⊗ₜ[k] a) * mk_L r = mk_L (((1 : B₀) ⊗ₜ[k] a) * r)
      exact (map_mul mk_L _ _).symm
    let Ī_p : Submodule A₀ Q_p :=
      { carrier := { q : Q_p | ∃ r ∈ I₀, mk_L r = q }
        zero_mem' := ⟨0, I₀.zero_mem, map_zero mk_L⟩
        add_mem' := by
          rintro _ _ ⟨r₁, hr₁, rfl⟩ ⟨r₂, hr₂, rfl⟩
          exact ⟨r₁ + r₂, I₀.add_mem hr₁ hr₂, map_add mk_L r₁ r₂⟩
        smul_mem' := by
          rintro a _ ⟨r, hr, rfl⟩
          exact ⟨((1 : B₀) ⊗ₜ[k] a) * r, I₀.mul_mem_left _ hr, (hsmul_mk a r).symm⟩ }
    
    let M_rem := n * (K_pos + K_neg)
    let e_rem : Fin M_rem → B₀ := fun idx =>
      t ^ ((finProdFinEquiv.symm idx).2 : ℕ) * b (finProdFinEquiv.symm idx).1
    let w_gen : Fin M_rem × Fin (n + 1) → Q_p := fun pair =>
      mk_L ((e_rem pair.1 ⊗ₜ[k] (1 : A₀)) * g_gen A₀ p pair.2)
    have hSpan_Ī : Submodule.span A₀ (Set.range w_gen) = Ī_p := by
      apply le_antisymm
      · rw [Submodule.span_le]
        rintro _ ⟨⟨idx, β⟩, rfl⟩
        exact ⟨(e_rem idx ⊗ₜ[k] (1 : A₀)) * g_gen A₀ p β,
          I₀.mul_mem_left _ (hg_gen_mem A₀ p β), rfl⟩
      · rintro _ ⟨r, hr, rfl⟩
        have hr_span : r ∈ Submodule.span (TensorProduct k B₀ A₀) (Set.range (g_gen A₀ p)) := by
          change r ∈ Ideal.span (Set.range (g_gen A₀ p))
          rwa [← hKerGen A₀ p]
        obtain ⟨f, hf⟩ :=
          (Submodule.mem_span_range_iff_exists_fun (TensorProduct k B₀ A₀)).mp hr_span
        rw [← hf]
        simp only [smul_eq_mul, map_sum]
        refine Submodule.sum_mem _ fun β _ => ?_
        obtain ⟨q_rem, c_rem, hfβ⟩ := hRem₀ (f β)
        have hfβ' : f β = Δ_tot₀ * q_rem +
            Finset.univ.sum fun idx : Fin M_rem => e_rem idx ⊗ₜ[k] c_rem idx := hfβ
        rw [hfβ', add_mul, map_add, Finset.sum_mul, map_sum]
        have hzero : mk_L ((Δ_tot₀ * q_rem) * g_gen A₀ p β) = 0 := by
          rw [mul_assoc, Ideal.Quotient.eq_zero_iff_mem]
          exact Submodule.mem_sup_right (Submodule.smul_mem_smul
            (Ideal.subset_span (Set.mem_singleton Δ_tot₀))
            (I₀.mul_mem_left q_rem (hg_gen_mem A₀ p β)))
        rw [hzero, zero_add]
        refine Submodule.sum_mem _ fun idx _ => ?_
        have hterm : (e_rem idx ⊗ₜ[k] c_rem idx) * g_gen A₀ p β =
            ((1 : B₀) ⊗ₜ[k] c_rem idx) * ((e_rem idx ⊗ₜ[k] (1 : A₀)) * g_gen A₀ p β) := by
          rw [← mul_assoc]
          congr 1
          simp only [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
        rw [hterm, ← hsmul_mk]
        exact Submodule.smul_mem _ (c_rem idx) (Submodule.subset_span ⟨(idx, β), rfl⟩)
    have hFG : Ī_p.FG := by
      rw [← hSpan_Ī]
      exact Submodule.fg_span (Set.finite_range w_gen)
    
    let 𝔪_A : Ideal A₀ := RingHom.ker ev₀.toRingHom
    let π₀ : TensorProduct k B₀ A₀ →ₐ[k] B₀ :=
      Algebra.TensorProduct.productMap (AlgHom.id k B₀) ((Algebra.ofId k B₀).comp ev₀)
    have hπ₀_tmul : ∀ (x : B₀) (a : A₀), π₀ (x ⊗ₜ[k] a) = x * algebraMap k B₀ (ev₀ a) := by
      intro x a
      simp [π₀, Algebra.TensorProduct.productMap_apply_tmul]
    have hπ₀_u₀ : π₀ u₀ = u_bar := by
      dsimp only [u₀, u_bar]
      rw [map_sub, hπ₀_tmul, hπ₀_tmul, map_one, map_one, mul_one, one_mul]
    have hπ₀_Δ : π₀ Δ_tot₀ = Δ_bar := by
      dsimp only [Δ_tot₀, Δ_pos₀, Δ_neg₀, Δ_bar]
      rw [map_mul, map_prod, map_prod]
      congr 1
      · refine Finset.prod_congr rfl fun i _ => ?_
        rw [map_sub, hπ₀_tmul, hπ₀_tmul, map_one, map_one, mul_one, one_mul]
      · refine Finset.prod_congr rfl fun j _ => ?_
        rw [map_sub, hπ₀_tmul, hπ₀_tmul, map_one, map_one, mul_one, one_mul]
    have hev_π₀_hom : (ev₀.comp p).comp π₀ = ev₀.comp μ₀ := by
      apply Algebra.TensorProduct.ext
      · ext x
        simp [π₀, μ₀, Algebra.TensorProduct.productMap_apply_tmul]
      · ext a
        simp [π₀, μ₀, Algebra.TensorProduct.productMap_apply_tmul]
    have hev_π₀ : ∀ w : TensorProduct k B₀ A₀, ev₀ (p (π₀ w)) = ev₀ (μ₀ w) := fun w =>
      congrArg (fun f : TensorProduct k B₀ A₀ →ₐ[k] k => f w) hev_π₀_hom
    let Ψ_p : TensorProduct k B₀ A₀ → TensorProduct k B₀ A₀ := fun w =>
      (w - π₀ w ⊗ₜ[k] (1 : A₀)) - (1 : B₀) ⊗ₜ[k] μ₀ (w - π₀ w ⊗ₜ[k] (1 : A₀))
    have hΨ_add : ∀ w₁ w₂ : TensorProduct k B₀ A₀, Ψ_p (w₁ + w₂) = Ψ_p w₁ + Ψ_p w₂ := by
      intro w₁ w₂
      dsimp only [Ψ_p]
      rw [map_add, TensorProduct.add_tmul]
      have hsub : w₁ + w₂ - (π₀ w₁ ⊗ₜ[k] (1 : A₀) + π₀ w₂ ⊗ₜ[k] (1 : A₀)) =
          (w₁ - π₀ w₁ ⊗ₜ[k] (1 : A₀)) + (w₂ - π₀ w₂ ⊗ₜ[k] (1 : A₀)) := by abel
      rw [hsub, map_add, TensorProduct.tmul_add]
      abel
    have hΨ_mem : ∀ w : TensorProduct k B₀ A₀, mk_L (Ψ_p w) ∈ 𝔪_A • Ī_p := by
      intro w
      refine TensorProduct.inductionOn (motive := fun w => mk_L (Ψ_p w) ∈ 𝔪_A • Ī_p) w ?_ ?_
      · intro x a
        have hπ_smul : π₀ (x ⊗ₜ[k] a) ⊗ₜ[k] (1 : A₀) = x ⊗ₜ[k] algebraMap k A₀ (ev₀ a) := by
          have h1 : π₀ (x ⊗ₜ[k] a) = ev₀ a • x := by
            rw [hπ₀_tmul, Algebra.smul_def, mul_comm]
          rw [h1, TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        let m_a : A₀ := a - algebraMap k A₀ (ev₀ a)
        have hm_a : m_a ∈ 𝔪_A := by
          rw [RingHom.mem_ker]
          change ev₀ (a - algebraMap k A₀ (ev₀ a)) = 0
          simp
        have hdiff : x ⊗ₜ[k] a - π₀ (x ⊗ₜ[k] a) ⊗ₜ[k] (1 : A₀) = x ⊗ₜ[k] m_a := by
          rw [hπ_smul, ← TensorProduct.tmul_sub]
        have hΨ_tmul : Ψ_p (x ⊗ₜ[k] a) =
            ((1 : B₀) ⊗ₜ[k] m_a) * (x ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] p x) := by
          dsimp only [Ψ_p]
          rw [hdiff]
          have hμ_xm : μ₀ (x ⊗ₜ[k] m_a) = m_a * p x := by
            dsimp only [μ₀]
            rw [Algebra.TensorProduct.productMap_apply_tmul, AlgHom.id_apply, mul_comm]
          rw [hμ_xm, mul_sub]
          simp only [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
        have hx_mem : x ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] p x ∈ I₀ := by
          rw [RingHom.mem_ker]
          change μ₀ (x ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] p x) = 0
          simp [μ₀, Algebra.TensorProduct.productMap_apply_tmul]
        rw [hΨ_tmul, ← hsmul_mk]
        exact Submodule.smul_mem_smul hm_a ⟨_, hx_mem, rfl⟩
      · intro w₁ w₂ hw₁ hw₂
        rw [hΨ_add, map_add]
        exact Submodule.add_mem _ hw₁ hw₂
    have hIncl : Ī_p ≤ (⊥ : Submodule A₀ Q_p) ⊔ 𝔪_A • Ī_p := by
      rintro _ ⟨r, hr, rfl⟩
      have hμ_r : μ₀ r = 0 := hr
      have hπ_r_mem : π₀ r ∈ 𝔪_p := by
        rw [RingHom.mem_ker]
        change ev₀ (p (π₀ r)) = 0
        rw [hev_π₀, hμ_r, map_zero]
      have hBase_eq : 𝔪_p = Ideal.span ({u_bar} : Set B₀) ⊔ Ideal.span ({Δ_bar} : Set B₀) • 𝔪_p :=
        hBase_p
      rw [hBase_eq, Submodule.mem_sup] at hπ_r_mem
      rcases hπ_r_mem with ⟨s₁, hs₁, s₂, hs₂, hs_eq⟩
      rcases Ideal.mem_span_singleton.mp hs₁ with ⟨q₀, rfl⟩
      rcases hMemSpanSmul Δ_bar 𝔪_p hs₂ with ⟨y_bar, hy_bar, rfl⟩
      let y_lift : TensorProduct k B₀ A₀ := y_bar ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] p y_bar
      have hy_lift_mem : y_lift ∈ I₀ := by
        rw [RingHom.mem_ker]
        change μ₀ (y_bar ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] p y_bar) = 0
        simp [μ₀, Algebra.TensorProduct.productMap_apply_tmul]
      let r_tilde : TensorProduct k B₀ A₀ := u₀ * (q₀ ⊗ₜ[k] (1 : A₀)) + Δ_tot₀ * y_lift
      have hr_tilde_L₀ : r_tilde ∈ L₀ := by
        refine Submodule.add_mem_sup ?_ ?_
        · exact Ideal.mem_span_singleton.mpr ⟨q₀ ⊗ₜ[k] (1 : A₀), rfl⟩
        · exact Submodule.smul_mem_smul
            (Ideal.subset_span (Set.mem_singleton Δ_tot₀)) hy_lift_mem
      have hπ_y : π₀ y_lift = y_bar := by
        have hy_ev : ev₀ (p y_bar) = 0 := hy_bar
        dsimp only [y_lift]
        rw [map_sub, hπ₀_tmul, hπ₀_tmul, map_one, map_one, hy_ev, map_zero, mul_one, mul_zero,
          sub_zero]
      have hπ_tilde : π₀ r_tilde = π₀ r := by
        dsimp only [r_tilde]
        rw [map_add, map_mul, map_mul, hπ₀_u₀, hπ₀_tmul, map_one, map_one, mul_one, hπ₀_Δ, hπ_y,
          hs_eq]
      let d : TensorProduct k B₀ A₀ := r - r_tilde
      have hmk_d : mk_L d = mk_L r := by
        dsimp only [d]
        rw [map_sub, Ideal.Quotient.eq_zero_iff_mem.mpr hr_tilde_L₀, sub_zero]
      have hμ_d : μ₀ d = 0 := I₀.sub_mem hr (hL₀_le hr_tilde_L₀)
      have hπ_d : π₀ d = 0 := by
        dsimp only [d]
        rw [map_sub, hπ_tilde, sub_self]
      have hΨ_d : Ψ_p d = d := by
        dsimp only [Ψ_p]
        rw [hπ_d, TensorProduct.zero_tmul, sub_zero, hμ_d, TensorProduct.tmul_zero, sub_zero]
      rw [← hmk_d, ← hΨ_d]
      exact Submodule.mem_sup_right (hΨ_mem d)
    obtain ⟨a_p, ha_p_mem, ha_p_kill⟩ :=
      Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup hFG le_rfl hIncl
    have ha_p_ev : ev₀ a_p = 1 := by
      have h0 : ev₀ (a_p - 1) = 0 := ha_p_mem
      rwa [map_sub, map_one, sub_eq_zero] at h0
    refine ⟨a_p, ha_p_ev, fun r hr => ?_⟩
    have hzero_q : a_p • mk_L r = 0 :=
      (Submodule.mem_bot A₀).mp
        (ha_p_kill (Submodule.smul_mem_pointwise_smul (mk_L r) a_p Ī_p ⟨r, hr, rfl⟩))
    rw [hsmul_mk] at hzero_q
    exact Ideal.Quotient.eq_zero_iff_mem.mp hzero_q
  
  choose a_pos ha_pos_ev ha_pos_abs using fun i : Fin K_pos => hStage1 (p_pos i) (z_pos i) (h_pos₀ i)
  choose a_neg ha_neg_ev ha_neg_abs using fun j : Fin K_neg => hStage1 (q_neg j) (z_neg j) (h_neg₀ j)
  let a₁ : A₀ := (Finset.univ.prod a_pos) * (Finset.univ.prod a_neg)
  have ha₁_ev : ev₀ a₁ = 1 := by
    dsimp only [a₁]
    rw [map_mul, map_prod, map_prod]
    simp [ha_pos_ev, ha_neg_ev]
  refine ⟨a₁, ha₁_ev, ?_⟩
  let ι₁ : A₀ →ₐ[k] Localization.Away a₁ := IsScalarTower.toAlgHom k A₀ (Localization.Away a₁)
  let p₁ : Fin K_pos → (B₀ →ₐ[k] Localization.Away a₁) := fun i => ι₁.comp (p_pos i)
  let q₁ : Fin K_neg → (B₀ →ₐ[k] Localization.Away a₁) := fun j => ι₁.comp (q_neg j)
  let Δ_pos₁ : TensorProduct k B₀ (Localization.Away a₁) := Finset.univ.prod fun i : Fin K_pos =>
    t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (p₁ i t)
  let Δ_neg₁ : TensorProduct k B₀ (Localization.Away a₁) := Finset.univ.prod fun j : Fin K_neg =>
    t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (q₁ j t)
  let Δ_tot₁ : TensorProduct k B₀ (Localization.Away a₁) := Δ_pos₁ * Δ_neg₁
  let Φ₁ : TensorProduct k B₀ A₀ →ₐ[k] TensorProduct k B₀ (Localization.Away a₁) :=
    Algebra.TensorProduct.map (AlgHom.id k B₀) ι₁
  have hΦ₁_Δ : Φ₁ Δ_tot₀ = Δ_tot₁ := by
    dsimp only [Δ_tot₀, Δ_pos₀, Δ_neg₀, Δ_tot₁, Δ_pos₁, Δ_neg₁]
    rw [map_mul, map_prod, map_prod]
    congr 1
    · refine Finset.prod_congr rfl fun i _ => ?_
      simp [Φ₁, p₁, Algebra.TensorProduct.map_tmul]
    · refine Finset.prod_congr rfl fun j _ => ?_
      simp [Φ₁, q₁, Algebra.TensorProduct.map_tmul]
  let inv_a₁ : Localization.Away a₁ :=
    IsLocalization.Away.invSelf (S := Localization.Away a₁) a₁
  have hmul_inv_a₁ :
      ((1 : B₀) ⊗ₜ[k] inv_a₁) * ((1 : B₀) ⊗ₜ[k] ι₁ a₁) =
        (1 : TensorProduct k B₀ (Localization.Away a₁)) := by
    have h_a₁ : inv_a₁ * ι₁ a₁ = 1 := by
      rw [mul_comm, IsScalarTower.toAlgHom_apply k A₀ (Localization.Away a₁) a₁]
      exact IsLocalization.Away.mul_invSelf (S := Localization.Away a₁) a₁
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, h_a₁]
    rfl
  
  have hStage2 : ∀ (p₀ : B₀ →ₐ[k] A₀) (z : B₀),
      (let μ₀ : TensorProduct k B₀ A₀ →ₐ[k] A₀ :=
         Algebra.TensorProduct.productMap p₀ (AlgHom.id k A₀)
       let I₀ : Ideal (TensorProduct k B₀ A₀) := RingHom.ker μ₀.toRingHom
       let u₀ : TensorProduct k B₀ A₀ := z ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] p₀ z
       let L₀ : Ideal (TensorProduct k B₀ A₀) :=
         Ideal.span ({u₀} : Set (TensorProduct k B₀ A₀)) ⊔
           Ideal.span ({Δ_tot₀} : Set (TensorProduct k B₀ A₀)) • I₀
       ∀ r₀ ∈ I₀, ((1 : B₀) ⊗ₜ[k] a₁) * r₀ ∈ L₀) →
      let p_loc : B₀ →ₐ[k] Localization.Away a₁ := ι₁.comp p₀
      let μ_loc : TensorProduct k B₀ (Localization.Away a₁) →ₐ[k] Localization.Away a₁ :=
        Algebra.TensorProduct.productMap p_loc (AlgHom.id k (Localization.Away a₁))
      let u_loc : TensorProduct k B₀ (Localization.Away a₁) :=
        z ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] p_loc z
      ∃ h_loc : TensorProduct k B₀ (Localization.Away a₁),
        h_loc - 1 ∈ Ideal.span ({Δ_tot₁} : Set (TensorProduct k B₀ (Localization.Away a₁))) ∧
        ∀ r ∈ RingHom.ker μ_loc.toRingHom,
          h_loc * r ∈ Ideal.span ({u_loc} : Set (TensorProduct k B₀ (Localization.Away a₁))) := by
    intro p₀ z ha₁_abs
    let μ₀ : TensorProduct k B₀ A₀ →ₐ[k] A₀ :=
      Algebra.TensorProduct.productMap p₀ (AlgHom.id k A₀)
    let I₀ : Ideal (TensorProduct k B₀ A₀) := RingHom.ker μ₀.toRingHom
    let u₀ : TensorProduct k B₀ A₀ := z ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] p₀ z
    let L₀ : Ideal (TensorProduct k B₀ A₀) :=
      Ideal.span ({u₀} : Set (TensorProduct k B₀ A₀)) ⊔
        Ideal.span ({Δ_tot₀} : Set (TensorProduct k B₀ A₀)) • I₀
    let p_loc : B₀ →ₐ[k] Localization.Away a₁ := ι₁.comp p₀
    let μ_loc : TensorProduct k B₀ (Localization.Away a₁) →ₐ[k] Localization.Away a₁ :=
      Algebra.TensorProduct.productMap p_loc (AlgHom.id k (Localization.Away a₁))
    let I_loc : Ideal (TensorProduct k B₀ (Localization.Away a₁)) := RingHom.ker μ_loc.toRingHom
    let u_loc : TensorProduct k B₀ (Localization.Away a₁) :=
      z ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] p_loc z
    let L_loc : Ideal (TensorProduct k B₀ (Localization.Away a₁)) :=
      Ideal.span ({u_loc} : Set (TensorProduct k B₀ (Localization.Away a₁))) ⊔
        Ideal.span ({Δ_tot₁} : Set (TensorProduct k B₀ (Localization.Away a₁))) • I_loc
    have hΦ₁_u : Φ₁ u₀ = u_loc := by
      dsimp only [u₀, u_loc, p_loc, Φ₁]
      simp [Algebra.TensorProduct.map_tmul]
    have hμ_comp : μ_loc.comp Φ₁ = ι₁.comp μ₀ := by
      apply Algebra.TensorProduct.ext
      · ext x
        simp [μ_loc, p_loc, Φ₁, μ₀, Algebra.TensorProduct.productMap_apply_tmul]
      · ext a
        simp [μ_loc, Φ₁, μ₀, Algebra.TensorProduct.productMap_apply_tmul]
    have hΦ₁_I : ∀ {r₀ : TensorProduct k B₀ A₀}, r₀ ∈ I₀ → Φ₁ r₀ ∈ I_loc := by
      intro r₀ hr₀
      rw [RingHom.mem_ker]
      have h0 : μ₀ r₀ = 0 := hr₀
      have h1 := congrArg (fun f : TensorProduct k B₀ A₀ →ₐ[k] Localization.Away a₁ => f r₀) hμ_comp
      dsimp only [AlgHom.comp_apply] at h1
      change μ_loc (Φ₁ r₀) = 0
      rw [h1, h0, map_zero]
    have hΦ₁_L : ∀ {w₀ : TensorProduct k B₀ A₀}, w₀ ∈ L₀ → Φ₁ w₀ ∈ L_loc := by
      intro w₀ hw₀
      rw [Submodule.mem_sup] at hw₀
      rcases hw₀ with ⟨s₁, hs₁, s₂, hs₂, rfl⟩
      rcases Ideal.mem_span_singleton.mp hs₁ with ⟨q₀, rfl⟩
      rcases hMemSpanSmul Δ_tot₀ I₀ hs₂ with ⟨y₀, hy₀, rfl⟩
      rw [map_add, map_mul, map_mul, hΦ₁_u, hΦ₁_Δ]
      refine Submodule.add_mem_sup ?_ ?_
      · exact Ideal.mem_span_singleton.mpr ⟨Φ₁ q₀, rfl⟩
      · exact Submodule.smul_mem_smul
          (Ideal.subset_span (Set.mem_singleton Δ_tot₁)) (hΦ₁_I hy₀)
    have hΦ₁_gen : ∀ β : Fin (n + 1), Φ₁ (g_gen A₀ p₀ β) = g_gen (Localization.Away a₁) p_loc β := by
      intro β
      refine Fin.cases ?_ ?_ β
      · simp [g_gen, Φ₁, p_loc, Algebra.TensorProduct.map_tmul]
      · intro α
        simp [g_gen, Φ₁, p_loc, Algebra.TensorProduct.map_tmul]
    have hgen_L : ∀ β : Fin (n + 1), g_gen (Localization.Away a₁) p_loc β ∈ L_loc := by
      intro β
      have h0 : ((1 : B₀) ⊗ₜ[k] a₁) * g_gen A₀ p₀ β ∈ L₀ :=
        ha₁_abs (g_gen A₀ p₀ β) (hg_gen_mem A₀ p₀ β)
      have h1 : Φ₁ (((1 : B₀) ⊗ₜ[k] a₁) * g_gen A₀ p₀ β) ∈ L_loc := hΦ₁_L h0
      rw [map_mul, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, hΦ₁_gen] at h1
      have h2 :
          ((1 : B₀) ⊗ₜ[k] inv_a₁) *
              (((1 : B₀) ⊗ₜ[k] ι₁ a₁) * g_gen (Localization.Away a₁) p_loc β) ∈ L_loc :=
        L_loc.mul_mem_left _ h1
      rwa [← mul_assoc, hmul_inv_a₁, one_mul] at h2
    have hFG_loc : I_loc.FG := by
      change (I_loc : Submodule (TensorProduct k B₀ (Localization.Away a₁))
        (TensorProduct k B₀ (Localization.Away a₁))).FG
      have hI_eq :
          (I_loc : Submodule (TensorProduct k B₀ (Localization.Away a₁))
            (TensorProduct k B₀ (Localization.Away a₁))) =
            Submodule.span (TensorProduct k B₀ (Localization.Away a₁))
              (Set.range (g_gen (Localization.Away a₁) p_loc)) :=
        hKerGen (Localization.Away a₁) p_loc
      rw [hI_eq]
      exact Submodule.fg_span (Set.finite_range (g_gen (Localization.Away a₁) p_loc))
    have hIncl_loc : I_loc ≤ L_loc := by
      dsimp only [I_loc, μ_loc]
      rw [hKerGen (Localization.Away a₁) p_loc, Ideal.span_le]
      rintro _ ⟨β, rfl⟩
      exact hgen_L β
    obtain ⟨h_loc, hh_mem, hh_kill⟩ :=
      Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup hFG_loc le_rfl hIncl_loc
    refine ⟨h_loc, hh_mem, fun r hr => ?_⟩
    exact hh_kill (Submodule.smul_mem_pointwise_smul r h_loc I_loc hr)
  
  have ha₁_pos : ∀ i : Fin K_pos,
      let μ₀ := Algebra.TensorProduct.productMap (p_pos i) (AlgHom.id k A₀)
      let I₀ := RingHom.ker μ₀.toRingHom
      let u₀ := z_pos i ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] p_pos i (z_pos i)
      let L₀ :=
        Ideal.span ({u₀} : Set (TensorProduct k B₀ A₀)) ⊔
          Ideal.span ({Δ_tot₀} : Set (TensorProduct k B₀ A₀)) • I₀
      ∀ r₀ ∈ I₀, ((1 : B₀) ⊗ₜ[k] a₁) * r₀ ∈ L₀ := by
    intro i
    dsimp only
    intro r₀ hr₀
    have hdvd : a_pos i ∣ a₁ :=
      dvd_mul_of_dvd_left (Finset.dvd_prod_of_mem a_pos (Finset.mem_univ i)) _
    rcases hdvd with ⟨c_i, hc_i⟩
    have hmul : ((1 : B₀) ⊗ₜ[k] a₁) * r₀ =
        ((1 : B₀) ⊗ₜ[k] c_i) * (((1 : B₀) ⊗ₜ[k] a_pos i) * r₀) := by
      rw [hc_i, ← mul_assoc]
      congr 1
      simp only [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm (a_pos i) c_i]
    rw [hmul]
    exact Ideal.mul_mem_left _ _ (ha_pos_abs i r₀ hr₀)
  have ha₁_neg : ∀ j : Fin K_neg,
      let μ₀ := Algebra.TensorProduct.productMap (q_neg j) (AlgHom.id k A₀)
      let I₀ := RingHom.ker μ₀.toRingHom
      let u₀ := z_neg j ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] q_neg j (z_neg j)
      let L₀ :=
        Ideal.span ({u₀} : Set (TensorProduct k B₀ A₀)) ⊔
          Ideal.span ({Δ_tot₀} : Set (TensorProduct k B₀ A₀)) • I₀
      ∀ r₀ ∈ I₀, ((1 : B₀) ⊗ₜ[k] a₁) * r₀ ∈ L₀ := by
    intro j
    dsimp only
    intro r₀ hr₀
    have hdvd : a_neg j ∣ a₁ :=
      dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem a_neg (Finset.mem_univ j)) _
    rcases hdvd with ⟨c_j, hc_j⟩
    have hmul : ((1 : B₀) ⊗ₜ[k] a₁) * r₀ =
        ((1 : B₀) ⊗ₜ[k] c_j) * (((1 : B₀) ⊗ₜ[k] a_neg j) * r₀) := by
      rw [hc_j, ← mul_assoc]
      congr 1
      simp only [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm (a_neg j) c_j]
    rw [hmul]
    exact Ideal.mul_mem_left _ _ (ha_neg_abs j r₀ hr₀)
  choose h_pos hh_pos_mod hh_pos_kill using fun i : Fin K_pos =>
    hStage2 (p_pos i) (z_pos i) (ha₁_pos i)
  choose h_neg hh_neg_mod hh_neg_kill using fun j : Fin K_neg =>
    hStage2 (q_neg j) (z_neg j) (ha₁_neg j)
  let H₁ : TensorProduct k B₀ (Localization.Away a₁) :=
    (Finset.univ.prod h_pos) * (Finset.univ.prod h_neg)
  let J_Δ : Ideal (TensorProduct k B₀ (Localization.Away a₁)) :=
    Ideal.span ({Δ_tot₁} : Set (TensorProduct k B₀ (Localization.Away a₁)))
  refine ⟨H₁, ?_, ?_, ?_⟩
  · have hpos_mk : ∀ i : Fin K_pos, Ideal.Quotient.mk J_Δ (h_pos i) = 1 := by
      intro i
      rw [← map_one (Ideal.Quotient.mk J_Δ)]
      exact Ideal.Quotient.eq.mpr (hh_pos_mod i)
    have hneg_mk : ∀ j : Fin K_neg, Ideal.Quotient.mk J_Δ (h_neg j) = 1 := by
      intro j
      rw [← map_one (Ideal.Quotient.mk J_Δ)]
      exact Ideal.Quotient.eq.mpr (hh_neg_mod j)
    change H₁ - 1 ∈ J_Δ
    apply Ideal.Quotient.eq.mp
    dsimp only [H₁]
    rw [map_mul, map_prod, map_prod, map_one]
    simp only [hpos_mk, hneg_mk, Finset.prod_const_one, mul_one]
  · intro i r hr
    have hdvd : h_pos i ∣ H₁ :=
      dvd_mul_of_dvd_left (Finset.dvd_prod_of_mem h_pos (Finset.mem_univ i)) _
    rcases hdvd with ⟨q_i, hq_i⟩
    have hmul : H₁ * r = q_i * (h_pos i * r) := by
      rw [hq_i]
      ring
    rw [hmul]
    exact Ideal.mul_mem_left _ _ (hh_pos_kill i r hr)
  · intro j r hr
    have hdvd : h_neg j ∣ H₁ :=
      dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem h_neg (Finset.mem_univ j)) _
    rcases hdvd with ⟨q_j, hq_j⟩
    have hmul : H₁ * r = q_j * (h_neg j * r) := by
      rw [hq_j]
      ring
    rw [hmul]
    exact Ideal.mul_mem_left _ _ (hh_neg_kill j r hr)

theorem weil_domain_split_quotient_cramer_free_basis (k : Type u) [Field k]
    (A₁ : Type u) [CommRing A₁] [Algebra k A₁] (ev₁ : A₁ →ₐ[k] k)
    (R_tilde : Type u) [CommRing R_tilde] [IsDomain R_tilde] [Algebra A₁ R_tilde]
    (n K_pos K_neg : ℕ) (_hn : 1 ≤ n)
    (u_pos : Fin K_pos → R_tilde)
    (u_neg : Fin K_neg → R_tilde)
    (Δ_pos W_plus g_gen : R_tilde)
    (bas_Δ : Fin (n * K_pos) → R_tilde) :
    (∀ i : Fin K_pos, u_pos i ≠ 0 ∧
      ∃ μ_i : R_tilde →ₐ[A₁] A₁,
        RingHom.ker μ_i.toRingHom = Ideal.span ({u_pos i} : Set R_tilde)) →
    (∀ j : Fin K_neg, u_neg j ≠ 0 ∧
      ∃ ν_j : R_tilde →ₐ[A₁] A₁,
        RingHom.ker ν_j.toRingHom = Ideal.span ({u_neg j} : Set R_tilde)) →
    (Finset.univ.prod u_pos) * W_plus = Δ_pos →
    Ideal.span ({g_gen} : Set R_tilde) =
      Ideal.span ({W_plus * Finset.univ.prod u_neg} : Set R_tilde) →
    Function.Bijective (fun c : Fin (n * K_pos) → A₁ =>
      Ideal.Quotient.mk (Ideal.span ({Δ_pos} : Set R_tilde))
        (Finset.univ.sum fun idx : Fin (n * K_pos) =>
          algebraMap A₁ R_tilde (c idx) * bas_Δ idx)) →
    let R_dim := (n - 1) * K_pos + K_neg
    ∃ (s_det : A₁) (ω : Fin R_dim → R_tilde) (Φ : R_tilde →ₗ[A₁] (Fin R_dim → A₁)),
      ev₁ s_det ≠ 0 ∧
      (∀ w : R_tilde, Φ (g_gen * w) = 0) ∧
      (∀ r₁ r₂ : Fin R_dim, Φ (ω r₁) r₂ = if r₁ = r₂ then s_det else 0) ∧
      (∀ z : R_tilde,
        algebraMap A₁ R_tilde s_det * z -
          (Finset.univ.sum fun r : Fin R_dim => algebraMap A₁ R_tilde (Φ z r) * ω r) ∈
          Ideal.span ({g_gen} : Set R_tilde)) :=
by
  classical
  intro h_pos h_neg hUW hg_span hBij_Δ R_dim
  have h_pi_sum : ∀ (m : ℕ) (v : Fin m → A₁),
      (Finset.univ.sum fun i : Fin m => v i • Pi.single i (1 : A₁)) = v := by
    intro m v
    ext j
    simp [Finset.sum_apply, Pi.single_apply]
  let mk_a : ∀ I : Ideal R_tilde, R_tilde →ₗ[A₁] (R_tilde ⧸ I) :=
    fun I => (Ideal.Quotient.mkₐ A₁ I).toLinearMap
  have hmk_a : ∀ (I : Ideal R_tilde) (x : R_tilde), mk_a I x = Ideal.Quotient.mk I x :=
    fun I x => congrFun (Ideal.Quotient.mkₐ_eq_mk A₁ I) x
  let κ : ∀ (a b : ℕ), ((Fin a → A₁) × (Fin b → A₁)) ≃ₗ[A₁] (Fin (a + b) → A₁) :=
    fun a b =>
      { toFun := fun p j => Fin.addCases p.1 p.2 j
        map_add' := fun p₁ p₂ => by
          ext j
          refine Fin.addCases (fun i => ?_) (fun l => ?_) j <;> simp
        map_smul' := fun r p => by
          ext j
          refine Fin.addCases (fun i => ?_) (fun l => ?_) j <;> simp
        invFun := fun v => (fun i => v (Fin.castAdd b i), fun l => v (Fin.natAdd a l))
        left_inv := fun p => Prod.ext (funext fun i => by simp) (funext fun l => by simp)
        right_inv := fun v => by
          ext j
          refine Fin.addCases (fun i => ?_) (fun l => ?_) j <;> simp }
  have h_split : ∀ (f g : R_tilde) (_hf : f ≠ 0) (a : ℕ)
      (_e_f : (Fin a → A₁) ≃ₗ[A₁] (R_tilde ⧸ Ideal.span ({f} : Set R_tilde))),
      Nonempty (((R_tilde ⧸ Ideal.span ({g} : Set R_tilde)) × (Fin a → A₁)) ≃ₗ[A₁]
        (R_tilde ⧸ Ideal.span ({f * g} : Set R_tilde))) := by
    intro f g hf a e_f
    let I_f : Ideal R_tilde := Ideal.span ({f} : Set R_tilde)
    let I_g : Ideal R_tilde := Ideal.span ({g} : Set R_tilde)
    let I_fg : Ideal R_tilde := Ideal.span ({f * g} : Set R_tilde)
    choose s hs using fun l : Fin a =>
      Ideal.Quotient.mk_surjective (I := I_f) (e_f (Pi.single l 1))
    let s_sum : (Fin a → A₁) →ₗ[A₁] R_tilde :=
      { toFun := fun c => Finset.univ.sum fun l : Fin a => algebraMap A₁ R_tilde (c l) * s l
        map_add' := fun c₁ c₂ => by
          simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
        map_smul' := fun r c => by
          simp only [Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc, Finset.mul_sum,
            RingHom.id_apply, Algebra.smul_def] }
    have hs_single : ∀ l : Fin a, s_sum (Pi.single l 1) = s l := by
      intro l
      change (Finset.univ.sum fun j : Fin a =>
        algebraMap A₁ R_tilde ((Pi.single l (1 : A₁) : Fin a → A₁) j) * s j) = s l
      simp [Pi.single_apply]
    have hs_ef : ∀ c : Fin a → A₁, Ideal.Quotient.mk I_f (s_sum c) = e_f c := by
      intro c
      rw [← hmk_a I_f]
      calc
        ((mk_a I_f).comp s_sum) c
            = ((mk_a I_f).comp s_sum)
                (Finset.univ.sum fun l : Fin a => c l • Pi.single l (1 : A₁)) := by
              rw [h_pi_sum a c]
        _ = Finset.univ.sum fun l : Fin a =>
              c l • (((mk_a I_f).comp s_sum) (Pi.single l (1 : A₁))) := by
              rw [map_sum]
              exact Finset.sum_congr rfl fun l _ => map_smul _ _ _
        _ = Finset.univ.sum fun l : Fin a => c l • e_f (Pi.single l (1 : A₁)) := by
              refine Finset.sum_congr rfl fun l _ => ?_
              rw [LinearMap.comp_apply, hs_single l, hmk_a I_f, hs l]
        _ = e_f (Finset.univ.sum fun l : Fin a => c l • Pi.single l (1 : A₁)) := by
              rw [map_sum]
              exact Finset.sum_congr rfl fun l _ => (e_f.map_smul _ _).symm
        _ = e_f c := by rw [h_pi_sum a c]
    have h_le : I_g ≤ Submodule.comap (LinearMap.mulLeft R_tilde f) I_fg := by
      intro x hx
      rw [Submodule.mem_comap, LinearMap.mulLeft_apply]
      rw [Ideal.mem_span_singleton] at hx ⊢
      rcases hx with ⟨q, rfl⟩
      exact ⟨q, (mul_assoc f g q).symm⟩
    let θ₁ : (R_tilde ⧸ I_g) →ₗ[A₁] (R_tilde ⧸ I_fg) :=
      (Submodule.mapQ I_g I_fg (LinearMap.mulLeft R_tilde f) h_le).restrictScalars A₁
    have hθ₁ : ∀ x : R_tilde, θ₁ (Ideal.Quotient.mk I_g x) = Ideal.Quotient.mk I_fg (f * x) := by
      intro x
      change (Submodule.mapQ I_g I_fg (LinearMap.mulLeft R_tilde f) h_le)
        (Ideal.Quotient.mk I_g x) = Ideal.Quotient.mk I_fg (f * x)
      rw [← Ideal.Quotient.mk_eq_mk, ← Ideal.Quotient.mk_eq_mk]
      exact Submodule.mapQ_apply I_g I_fg (LinearMap.mulLeft R_tilde f) x
    let θ₂ : (Fin a → A₁) →ₗ[A₁] (R_tilde ⧸ I_fg) := (mk_a I_fg).comp s_sum
    let ψ : ((R_tilde ⧸ I_g) × (Fin a → A₁)) →ₗ[A₁] (R_tilde ⧸ I_fg) :=
      LinearMap.coprod θ₁ θ₂
    have hψ_apply : ∀ (x : R_tilde) (c : Fin a → A₁),
        ψ (Ideal.Quotient.mk I_g x, c) = Ideal.Quotient.mk I_fg (f * x + s_sum c) := by
      intro x c
      change θ₁ (Ideal.Quotient.mk I_g x) + mk_a I_fg (s_sum c) = _
      rw [hθ₁ x, hmk_a I_fg, ← map_add]
    have hψ_inj : Function.Injective ψ := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      rintro ⟨q_x, c⟩ hp
      rw [LinearMap.mem_ker] at hp
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective q_x
      rw [hψ_apply x c, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at hp
      rcases hp with ⟨q, hq⟩
      have hc_mem : s_sum c ∈ I_f := by
        rw [Ideal.mem_span_singleton]
        refine ⟨g * q - x, ?_⟩
        calc
          s_sum c = (f * x + s_sum c) - f * x := by ring
          _ = (f * g) * q - f * x := by rw [hq]
          _ = f * (g * q - x) := by ring
      have hef0 : e_f c = 0 := by
        rw [← hs_ef c, Ideal.Quotient.eq_zero_iff_mem]
        exact hc_mem
      have hc0 : c = 0 := e_f.injective (hef0.trans e_f.map_zero.symm)
      subst hc0
      rw [map_zero, add_zero] at hq
      have h_mul0 : f * (x - g * q) = 0 := by
        calc
          f * (x - g * q) = f * x - (f * g) * q := by ring
          _ = 0 := sub_eq_zero.mpr hq
      have hx_eq : x - g * q = 0 := (mul_eq_zero.mp h_mul0).resolve_left hf
      have hx_mem : x ∈ I_g := by
        rw [Ideal.mem_span_singleton]
        exact ⟨q, sub_eq_zero.mp hx_eq⟩
      have hqx0 : Ideal.Quotient.mk I_g x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hx_mem
      exact Prod.ext hqx0 rfl
    have hψ_surj : Function.Surjective ψ := by
      intro y_bar
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y_bar
      let c : Fin a → A₁ := e_f.symm (Ideal.Quotient.mk I_f y)
      have hc_mod : Ideal.Quotient.mk I_f y = Ideal.Quotient.mk I_f (s_sum c) := by
        rw [hs_ef c]
        exact (e_f.apply_symm_apply _).symm
