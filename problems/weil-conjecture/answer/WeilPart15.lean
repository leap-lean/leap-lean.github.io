      rwa [map_sub, map_one, map_mul, map_mul, hevR_Δpos, hevR_Δneg] at this
    have hhs_not_pos : ∀ i : Fin K_pos,
        h_s ∉ (hAff_U₀.primeIdealOf ⟨(X_s i).1, hx_s i⟩).asIdeal := by
      intro i hmem
      let 𝔪 := (hAff_U₀.primeIdealOf ⟨(X_s i).1, hx_s i⟩).asIdeal
      have hprod_mem : Δ_pos_s * Δ_neg_s ∈ 𝔪 := Ideal.mul_mem_right _ 𝔪 (hΔpos_mem i)
      have hsub_mem : h_s - 1 ∈ 𝔪 := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hprod_mem) hhs_mod
      have h1_mem : (1 : B₀) ∈ 𝔪 := by
        have := 𝔪.sub_mem hmem hsub_mem
        simpa using this
      exact (hAff_U₀.primeIdealOf ⟨(X_s i).1, hx_s i⟩).isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem 𝔪 h1_mem isUnit_one)
    have hhs_not_neg : ∀ j : Fin K_neg,
        h_s ∉ (hAff_U₀.primeIdealOf ⟨(Y_s j).1, hy_s j⟩).asIdeal := by
      intro j hmem
      let 𝔪 := (hAff_U₀.primeIdealOf ⟨(Y_s j).1, hy_s j⟩).asIdeal
      have hprod_mem : Δ_pos_s * Δ_neg_s ∈ 𝔪 := Ideal.mul_mem_left 𝔪 _ (hΔneg_mem j)
      have hsub_mem : h_s - 1 ∈ 𝔪 := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hprod_mem) hhs_mod
      have h1_mem : (1 : B₀) ∈ 𝔪 := by
        have := 𝔪.sub_mem hmem hsub_mem
        simpa using this
      exact (hAff_U₀.primeIdealOf ⟨(Y_s j).1, hy_s j⟩).isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem 𝔪 h1_mem isUnit_one)
    have hhs_ne : germB₀ h_s ≠ 0 := by
      intro h0
      have hhs0 : h_s = 0 := hInjGerm (h0.trans (map_zero germB₀).symm)
      exact hhs_not_pos ⟨0, hK_pos⟩ (hhs0 ▸ Ideal.zero_mem _)
    have hVal_zero_of_not_mem : ∀ (F : B₀) (hF : germB₀ F ≠ 0) (x : Pt) (hx : x.1 ∈ U₀),
        F ∉ (hAff_U₀.primeIdealOf ⟨x.1, hx⟩).asIdeal →
        div_fn (Additive.ofMul (Units.mk0 _ hF)) x = 0 := by
      intro F hF x hx hnot
      obtain ⟨hge0, hge1_iff⟩ := hValB₀ F hF x hx
      change 0 ≤ div_fn (Additive.ofMul (Units.mk0 (germB₀ F) hF)) x at hge0
      have hlt1 : ¬ (1 ≤ div_fn (Additive.ofMul (Units.mk0 (germB₀ F) hF)) x) :=
        mt hge1_iff.mp hnot
      omega
    have hVal_mul : ∀ (F₁ F₂ : B₀) (h₁ : germB₀ F₁ ≠ 0) (h₂ : germB₀ F₂ ≠ 0)
        (h₁₂ : germB₀ (F₁ * F₂) ≠ 0) (x : Pt),
        div_fn (Additive.ofMul (Units.mk0 _ h₁₂)) x =
          div_fn (Additive.ofMul (Units.mk0 _ h₁)) x +
            div_fn (Additive.ofMul (Units.mk0 _ h₂)) x := by
      intro F₁ F₂ h₁ h₂ h₁₂ x
      have hu_eq : Units.mk0 (germB₀ (F₁ * F₂)) h₁₂ =
          Units.mk0 (germB₀ F₁) h₁ * Units.mk0 (germB₀ F₂) h₂ :=
        Units.ext (map_mul germB₀ F₁ F₂)
      rw [hu_eq, ofMul_mul, map_add, Finsupp.add_apply]
    have hVal_prod : ∀ {m : ℕ} (f : Fin m → B₀)
        (hf : ∀ i : Fin m, germB₀ (f i) ≠ 0)
        (hprod : germB₀ (Finset.univ.prod f) ≠ 0) (x : Pt),
        div_fn (Additive.ofMul (Units.mk0 _ hprod)) x =
          ∑ i : Fin m, div_fn (Additive.ofMul (Units.mk0 (germB₀ (f i)) (hf i))) x := by
      intro m
      induction m with
      | zero =>
        intro f _ hprod x
        have hu1 : Units.mk0 (germB₀ (Finset.univ.prod f)) hprod = 1 :=
          Units.ext (by simp)
        rw [hu1]
        change div_fn 0 x = ∑ i : Fin 0, _
        rw [map_zero, Finsupp.zero_apply]
        simp
      | succ m ih =>
        intro f hf hprod x
        let f' : Fin m → B₀ := fun i => f i.succ
        have hf' : ∀ i : Fin m, germB₀ (f' i) ≠ 0 := fun i => hf i.succ
        have hprods : germB₀ (Finset.univ.prod f') ≠ 0 := by
          intro h0
          apply hprod
          rw [Fin.prod_univ_succ, map_mul, h0, mul_zero]
        have hprod_eq : germB₀ (f 0 * Finset.univ.prod f') ≠ 0 := by
          rwa [← Fin.prod_univ_succ]
        have hU : Units.mk0 (germB₀ (Finset.univ.prod f)) hprod =
            Units.mk0 (germB₀ (f 0 * Finset.univ.prod f')) hprod_eq :=
          Units.ext (by simp [f', Fin.prod_univ_succ])
        rw [hU, hVal_mul (f 0) (Finset.univ.prod f') (hf 0) hprods hprod_eq x,
          ih f' hf' hprods x, Fin.sum_univ_succ]
    
    have hGenLocalVal : ∀ (p_f : B₀ →ₐ[k] A) (z_f : B₀) (X_f : Pt) (hx_f : X_f.1 ∈ U₀),
        RingHom.ker (ev_s.comp p_f).toRingHom = (hAff_U₀.primeIdealOf ⟨X_f.1, hx_f⟩).asIdeal →
        (∀ r : R_A,
          r ∈ RingHom.ker (Algebra.TensorProduct.productMap p_f (AlgHom.id k A)).toRingHom →
          H * r ∈ Ideal.span ({z_f ⊗ₜ[k] (1 : A) - (1 : B₀) ⊗ₜ[k] p_f z_f} : Set R_A)) →
        let u_f : B₀ := z_f - φ_k (ev_s (p_f z_f))
        ∀ (x : Pt) (hx : x.1 ∈ U₀),
          h_s ∉ (hAff_U₀.primeIdealOf ⟨x.1, hx⟩).asIdeal →
          ∃ hu : germB₀ u_f ≠ 0,
            (x = X_f → div_fn (Additive.ofMul (Units.mk0 _ hu)) x = 1) ∧
            (x ≠ X_f → div_fn (Additive.ofMul (Units.mk0 _ hu)) x = 0) := by
      intro p_f z_f X_f hx_f hker_f hH_f u_f x hx hhs_x
      let 𝔪_f := (hAff_U₀.primeIdealOf ⟨X_f.1, hx_f⟩).asIdeal
      have hKillMem : ∀ g ∈ 𝔪_f, h_s * g ∈ Ideal.span ({u_f} : Set B₀) := by
        intro g hg
        change g ∈ (hAff_U₀.primeIdealOf ⟨X_f.1, hx_f⟩).asIdeal at hg
        rw [← hker_f, RingHom.mem_ker] at hg
        let r_g : R_A := g ⊗ₜ[k] (1 : A) - (1 : B₀) ⊗ₜ[k] p_f g
        have hr_ker : r_g ∈
            RingHom.ker (Algebra.TensorProduct.productMap p_f (AlgHom.id k A)).toRingHom := by
          rw [RingHom.mem_ker]
          change (Algebra.TensorProduct.productMap p_f (AlgHom.id k A)) r_g = 0
          simp [r_g]
        have hspan := hH_f r_g hr_ker
        rw [Ideal.mem_span_singleton] at hspan ⊢
        rcases hspan with ⟨q_r, hq_r⟩
        refine ⟨ev_R q_r, ?_⟩
        have hev := congrArg ev_R hq_r
        rw [map_mul, map_mul, hevR_sub_const, hevR_sub_const] at hev
        have hg0 : ev_s (p_f g) = 0 := hg
        rw [hg0, map_zero, sub_zero] at hev
        exact hev
      obtain ⟨ev_f, hev_f_id, hev_f_ker, π_f, hπ_f, hval_π⟩ := hUnifB₀ X_f hx_f
      have hπ_mem : π_f ∈ 𝔪_f :=
        (hValB₀ π_f hπ_f X_f hx_f).2.mp (by omega)
      have hπ_div : h_s * π_f ∈ Ideal.span ({u_f} : Set B₀) := hKillMem π_f hπ_mem
      rw [Ideal.mem_span_singleton] at hπ_div
      rcases hπ_div with ⟨q_π, hq_π⟩
      have hhs_π_ne : germB₀ (h_s * π_f) ≠ 0 := by
        rw [map_mul]; exact mul_ne_zero hhs_ne hπ_f
      have hu_ne : germB₀ u_f ≠ 0 := by
        intro h0
        apply hhs_π_ne
        rw [hq_π, map_mul, h0, zero_mul]
      have hq_ne : germB₀ q_π ≠ 0 := by
        intro h0
        apply hhs_π_ne
        rw [hq_π, map_mul, h0, mul_zero]
      refine ⟨hu_ne, ?_, ?_⟩
      · intro hx_eq
        subst hx_eq
        have hu_mem : u_f ∈ 𝔪_f := by
          change u_f ∈ (hAff_U₀.primeIdealOf ⟨x.1, hx_f⟩).asIdeal
          rw [← hker_f, RingHom.mem_ker]
          change ev_s (p_f (z_f - φ_k (ev_s (p_f z_f)))) = 0
          rw [map_sub, map_sub]
          have hcomm : p_f (φ_k (ev_s (p_f z_f))) = algebraMap k A (ev_s (p_f z_f)) :=
            p_f.commutes (ev_s (p_f z_f))
          rw [hcomm, ev_s.commutes]
          simp
        have hu_ge1 : 1 ≤ div_fn (Additive.ofMul (Units.mk0 (germB₀ u_f) hu_ne)) x :=
          (hValB₀ u_f hu_ne x hx_f).2.mpr hu_mem
        have hq_ge0 : 0 ≤ div_fn (Additive.ofMul (Units.mk0 (germB₀ q_π) hq_ne)) x :=
          (hValB₀ q_π hq_ne x hx_f).1
        have hhs_val0 : div_fn (Additive.ofMul (Units.mk0 (germB₀ h_s) hhs_ne)) x = 0 :=
          hVal_zero_of_not_mem h_s hhs_ne x hx hhs_x
        change div_fn (Additive.ofMul (Units.mk0 (germB₀ π_f) hπ_f)) x = 1 at hval_π
        have hmul_eq : div_fn (Additive.ofMul (Units.mk0 (germB₀ h_s) hhs_ne)) x +
            div_fn (Additive.ofMul (Units.mk0 (germB₀ π_f) hπ_f)) x =
            div_fn (Additive.ofMul (Units.mk0 (germB₀ u_f) hu_ne)) x +
              div_fn (Additive.ofMul (Units.mk0 (germB₀ q_π) hq_ne)) x := by
          have hprod_uq : germB₀ (u_f * q_π) ≠ 0 := hq_π ▸ hhs_π_ne
          have hL := hVal_mul h_s π_f hhs_ne hπ_f hhs_π_ne x
          have hR := hVal_mul u_f q_π hu_ne hq_ne hprod_uq x
          have hU : Units.mk0 (germB₀ (h_s * π_f)) hhs_π_ne =
              Units.mk0 (germB₀ (u_f * q_π)) hprod_uq :=
            Units.ext (congrArg germB₀ hq_π)
          rw [← hL, ← hR, hU]
        omega
      · intro hx_ne
        let 𝔪_x := (hAff_U₀.primeIdealOf ⟨x.1, hx⟩).asIdeal
        have h𝔪_f_max : 𝔪_f.IsMaximal := by
          dsimp only [𝔪_f]
          rw [← hev_f_ker, Ideal.isMaximal_iff]
          refine ⟨fun h1 => one_ne_zero (α := k) (by rw [RingHom.mem_ker, map_one] at h1; exact h1),
            fun J y hle hy_not hyJ => ?_⟩
          have hy_ne : ev_f y ≠ 0 := hy_not
          have hc : y * φ_k (ev_f y)⁻¹ - 1 ∈ RingHom.ker ev_f := by
            rw [RingHom.mem_ker, map_sub, map_mul, map_one]
            have hφ : ev_f (φ_k (ev_f y)⁻¹) = (ev_f y)⁻¹ :=
              congrArg (fun φ : k →+* k => φ (ev_f y)⁻¹) hev_f_id
            rw [hφ, mul_inv_cancel₀ hy_ne, sub_self]
          have h1 : (y * φ_k (ev_f y)⁻¹) - (y * φ_k (ev_f y)⁻¹ - 1) ∈ J :=
            J.sub_mem (J.mul_mem_right _ hyJ) (hle hc)
          simpa using h1
        have hnot_le : ¬ (𝔪_f ≤ 𝔪_x) := by
          intro hle
          have heq : 𝔪_f = 𝔪_x :=
            h𝔪_f_max.eq_of_le (hAff_U₀.primeIdealOf ⟨x.1, hx⟩).isPrime.ne_top hle
          have hp_eq : hAff_U₀.primeIdealOf ⟨X_f.1, hx_f⟩ = hAff_U₀.primeIdealOf ⟨x.1, hx⟩ :=
            PrimeSpectrum.ext heq
          have hx1_eq : X_f.1 = x.1 := by
            have := congrArg hAff_U₀.fromSpec.base hp_eq
            rwa [hAff_U₀.fromSpec_primeIdealOf, hAff_U₀.fromSpec_primeIdealOf] at this
          exact hx_ne (Subtype.ext hx1_eq.symm)
        obtain ⟨g₀, hg₀_f, hg₀_not_x⟩ := Set.not_subset.mp hnot_le
        have hg₀_div := hKillMem g₀ hg₀_f
        have hu_not_x : u_f ∉ 𝔪_x := by
          intro hu_in
          have hprod_in : h_s * g₀ ∈ 𝔪_x :=
            Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hu_in) hg₀_div
          rcases (hAff_U₀.primeIdealOf ⟨x.1, hx⟩).isPrime.mem_or_mem hprod_in with hh | hg
          · exact hhs_x hh
          · exact hg₀_not_x hg
        exact hVal_zero_of_not_mem u_f hu_ne x hx hu_not_x
    have hLocal_all : ∀ (x : Pt) (hx : x.1 ∈ U₀),
        h_s ∉ (hAff_U₀.primeIdealOf ⟨x.1, hx⟩).asIdeal →
        (∀ i : Fin K_pos, ∃ hu : germB₀ (u_pos_s i) ≠ 0,
          (x = X_s i → div_fn (Additive.ofMul (Units.mk0 _ hu)) x = 1) ∧
          (x ≠ X_s i → div_fn (Additive.ofMul (Units.mk0 _ hu)) x = 0)) ∧
        (∀ j : Fin K_neg, ∃ hv : germB₀ (u_neg_s j) ≠ 0,
          (x = Y_s j → div_fn (Additive.ofMul (Units.mk0 _ hv)) x = 1) ∧
          (x ≠ Y_s j → div_fn (Additive.ofMul (Units.mk0 _ hv)) x = 0)) := by
      intro x hx hhs_x
      exact ⟨fun i => hGenLocalVal (p_A i) (z_pos i) (X_s i) (hx_s i) (hker_pos i) (hH_pos i) x hx hhs_x,
             fun j => hGenLocalVal (q_A j) (z_neg j) (Y_s j) (hy_s j) (hker_neg j) (hH_neg j) x hx hhs_x⟩
    obtain ⟨hΔ_pos_s, hΔ_pos_pole⟩ := hPoleΔ K_pos (fun i => ev_s (p_A i t))
    refine ⟨hΔpos_mem, hΔneg_mem, hhs_mod, hLocal_all, hΔ_pos_s, ?_, ?_⟩
    
    · intro c hc_ne hker_c
      let F_c : B₀ := Finset.univ.sum fun ν : Fin N_V => φ_k (c ν) * v_bas ν
      have hFc_ne0 : F_c ≠ 0 := by
        intro h0
        apply hc_ne
        apply hv_inj
        simpa [F_c] using h0
      have hFc : germB₀ F_c ≠ 0 := fun h0 => hFc_ne0 (hInjGerm (h0.trans (map_zero germB₀).symm))
      refine ⟨hFc, ?_⟩
      
      let w_s : B₀ := ev_R W_num
      let gen_s : B₀ := w_s * Finset.univ.prod u_neg_s
      have hBase_k := (hBase k ev_s c).mp hker_c
      
      let ridB : TensorProduct k B₀ k ≃ₐ[k] B₀ := Algebra.TensorProduct.rid k k B₀
      let ψ_R_k : R_A →ₐ[k] TensorProduct k B₀ k :=
        Algebra.TensorProduct.map (AlgHom.id k B₀) ev_s
      have hrid_H : ridB (ψ_R_k H) = h_s := rfl
      have hrid_gen : ridB (ψ_R_k (W_num * Finset.univ.prod u_neg)) = gen_s := by
        change ev_R (W_num * Finset.univ.prod u_neg) = w_s * Finset.univ.prod u_neg_s
        rw [map_mul, map_prod]
        congr 1
        exact Finset.prod_congr rfl fun j _ => hevR_uneg j
      have hrid_Fc : ridB (Finset.univ.sum fun ν : Fin N_V => v_bas ν ⊗ₜ[k] c ν) = F_c := by
        rw [map_sum]
        refine Finset.sum_congr rfl fun ν _ => ?_
        rw [Algebra.TensorProduct.rid_tmul, Algebra.smul_def]
        rfl
      obtain ⟨m_sp, q_R, hmq_R⟩ := (hLocSpanSelf (ψ_R_k H) _ _).mp hBase_k
      have hmq_B₀ : h_s ^ m_sp * F_c = gen_s * ridB q_R := by
        have := congrArg ridB hmq_R
        rwa [map_mul, map_pow, hrid_H, hrid_Fc, map_mul, hrid_gen] at this
      let q_sp : B₀ := ridB q_R
      have hUW_s : (Finset.univ.prod u_pos_s) * w_s = h_s ^ m_W * Δ_pos_s := by
        have := congrArg ev_R hUW
        rw [map_mul, map_prod, map_mul, map_pow, hevR_Δpos] at this
        convert this using 2
        exact Finset.prod_congr rfl fun i _ => (hevR_upos i).symm
      intro x
      have hu_diff : div_fn (Additive.ofMul
          (Units.mk0 (germB₀ F_c) hFc * (Units.mk0 (germB₀ Δ_pos_s) hΔ_pos_s)⁻¹)) x =
          div_fn (Additive.ofMul (Units.mk0 (germB₀ F_c) hFc)) x -
            div_fn (Additive.ofMul (Units.mk0 (germB₀ Δ_pos_s) hΔ_pos_s)) x := by
        rw [ofMul_mul, map_add, ofMul_inv, map_neg, Finsupp.add_apply, Finsupp.neg_apply,
          sub_eq_add_neg]
      rw [hu_diff]
      by_cases hx_in : x.1 ∈ U₀
      · let 𝔪_x := (hAff_U₀.primeIdealOf ⟨x.1, hx_in⟩).asIdeal
        by_cases hhs_mem : h_s ∈ 𝔪_x
        · 
          have hprod_not : Δ_pos_s * Δ_neg_s ∉ 𝔪_x := by
            intro hp
            have hsub : h_s - 1 ∈ 𝔪_x :=
              Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hp) hhs_mod
            have h1 : (1 : B₀) ∈ 𝔪_x := by simpa using 𝔪_x.sub_mem hhs_mem hsub
            exact (hAff_U₀.primeIdealOf ⟨x.1, hx_in⟩).isPrime.ne_top
              (Ideal.eq_top_of_isUnit_mem 𝔪_x h1 isUnit_one)
          have hΔp_not : Δ_pos_s ∉ 𝔪_x := fun hm => hprod_not (Ideal.mul_mem_right _ 𝔪_x hm)
          have hΔp_val0 : div_fn (Additive.ofMul (Units.mk0 _ hΔ_pos_s)) x = 0 :=
            hVal_zero_of_not_mem Δ_pos_s hΔ_pos_s x hx_in hΔp_not
          have hXs_zero : weilCurveDivSum C.left X_s x = 0 := by
            dsimp [weilCurveDivSum]
            rw [Finsupp.finsetSum_apply]
            refine Finset.sum_eq_zero fun i _ => ?_
            rw [Finsupp.single_apply, if_neg]
            intro hEq; subst hEq; exact hhs_not_pos i hhs_mem
          have hYs_zero : weilCurveDivSum C.left Y_s x = 0 := by
            dsimp [weilCurveDivSum]
            rw [Finsupp.finsetSum_apply]
            refine Finset.sum_eq_zero fun j _ => ?_
            rw [Finsupp.single_apply, if_neg]
            intro hEq; subst hEq; exact hhs_not_neg j hhs_mem
          have hFc_ge0 : 0 ≤ div_fn (Additive.ofMul (Units.mk0 (germB₀ F_c) hFc)) x :=
            (hValB₀ F_c hFc x hx_in).1
          change div_fn (Additive.ofMul (Units.mk0 (germB₀ Δ_pos_s) hΔ_pos_s)) x = 0 at hΔp_val0
          omega
        · 
          obtain ⟨hLocP, hLocN⟩ := hLocal_all x hx_in hhs_mem
          have hup_ne : ∀ i : Fin K_pos, germB₀ (u_pos_s i) ≠ 0 :=
            fun i => (hLocP i).choose
          have hun_ne : ∀ j : Fin K_neg, germB₀ (u_neg_s j) ≠ 0 :=
            fun j => (hLocN j).choose
          have hprod_up_ne : germB₀ (Finset.univ.prod u_pos_s) ≠ 0 := by
            rw [map_prod]; exact Finset.prod_ne_zero_iff.mpr fun i _ => hup_ne i
          have hprod_un_ne : germB₀ (Finset.univ.prod u_neg_s) ≠ 0 := by
            rw [map_prod]; exact Finset.prod_ne_zero_iff.mpr fun j _ => hun_ne j
          have hhs_pow_ne : ∀ m : ℕ, germB₀ (h_s ^ m) ≠ 0 := by
            intro m; rw [map_pow]; exact pow_ne_zero m hhs_ne
          have hhs_val0 : div_fn (Additive.ofMul (Units.mk0 _ hhs_ne)) x = 0 :=
            hVal_zero_of_not_mem h_s hhs_ne x hx_in hhs_mem
          have hhs_pow_val0 : ∀ m : ℕ,
              div_fn (Additive.ofMul (Units.mk0 _ (hhs_pow_ne m))) x = 0 := by
            intro m
            have hu_eq : Units.mk0 (germB₀ (h_s ^ m)) (hhs_pow_ne m) =
                (Units.mk0 (germB₀ h_s) hhs_ne) ^ m := Units.ext (map_pow germB₀ h_s m)
            rw [hu_eq, ofMul_pow, map_nsmul, Finsupp.smul_apply, hhs_val0, smul_zero]
          have hws_ne : germB₀ w_s ≠ 0 := by
            intro h0
            have hRHS_ne : germB₀ (h_s ^ m_W * Δ_pos_s) ≠ 0 := by
              rw [map_mul]; exact mul_ne_zero (hhs_pow_ne m_W) hΔ_pos_s
            apply hRHS_ne
            rw [← hUW_s, map_mul, h0, mul_zero]
          have hgen_ne : germB₀ gen_s ≠ 0 := by
            dsimp [gen_s]; rw [map_mul]; exact mul_ne_zero hws_ne hprod_un_ne
          have hqsp_ne : germB₀ q_sp ≠ 0 := by
            intro h0
            have hLHS_ne : germB₀ (h_s ^ m_sp * F_c) ≠ 0 := by
