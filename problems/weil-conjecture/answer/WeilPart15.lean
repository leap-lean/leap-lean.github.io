  let D : Type u := ↥S' ⧸ I₀
  have _ : IsLocalRing D := hLocD j₀
  have _ : Module.Finite B D :=
    Module.Finite.of_surjective (Ideal.Quotient.mkₐ B I₀).toLinearMap Ideal.Quotient.mk_surjective
  let _ : Field (↥S' ⧸ 𝔮') := Ideal.Quotient.field 𝔮'
  have hI₀_le : I₀ ≤ 𝔮' := by
    rw [Ideal.span_le, Set.singleton_subset_iff]
    exact h_one_sub_mem
  let q_max : D →+* (↥S' ⧸ 𝔮') :=
    Ideal.Quotient.lift I₀ (Ideal.Quotient.mk 𝔮')
      (fun x hx => Ideal.Quotient.eq_zero_iff_mem.mpr (hI₀_le hx))
  have hq_max_surj : Function.Surjective q_max := fun z => by
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
    exact ⟨Ideal.Quotient.mk I₀ x, rfl⟩
  have hKerMaxD : RingHom.ker q_max = IsLocalRing.maximalIdeal D :=
    IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective q_max hq_max_surj)
  have _ : IsLocalization 𝔮'.primeCompl D :=
    { map_units := fun ⟨y, hy⟩ => by
        rw [← IsLocalRing.notMem_maximalIdeal, ← hKerMaxD, RingHom.mem_ker]
        change Ideal.Quotient.mk 𝔮' y ≠ 0
        rwa [Ne, Ideal.Quotient.eq_zero_iff_mem]
      surj := fun z => by
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
        refine ⟨⟨x, 1⟩, ?_⟩
        change Ideal.Quotient.mk I₀ x * algebraMap ↥S' D (1 : ↥S') = algebraMap ↥S' D x
        rw [map_one, mul_one]
        rfl
      exists_of_eq := fun {x₁ x₂} hx => by
        have hsub : x₁ - x₂ ∈ I₀ :=
          Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_sub]; exact sub_eq_zero.mpr hx)
        obtain ⟨u, hu⟩ := Ideal.mem_span_singleton.mp hsub
        refine ⟨⟨e j₀, he_j₀⟩, ?_⟩
        dsimp only
        apply sub_eq_zero.mp
        calc
          e j₀ * x₁ - e j₀ * x₂ = e j₀ * (x₁ - x₂) := (mul_sub (e j₀) x₁ x₂).symm
          _ = e j₀ * ((1 - e j₀) * u) := by rw [hu]
          _ = (e j₀ - e j₀ * e j₀) * u := by ring
          _ = 0 := by rw [h_idem_j₀, sub_self, zero_mul] }
  let e_loc : D ≃ₐ[B] Localization.AtPrime q :=
    (IsLocalization.algEquiv 𝔮'.primeCompl D (Localization.AtPrime q)).restrictScalars B
  have _ : Module.Flat W (Localization.AtPrime q) :=
    IsLocalization.flat (Localization.AtPrime q) q.primeCompl
  have _ : Module.Flat B (Localization.AtPrime q) := Module.Flat.trans B W (Localization.AtPrime q)
  have _ : Module.Flat B D := Module.Flat.of_linearEquiv e_loc.toLinearEquiv
  have _ : Algebra.FormallyUnramified B D := Algebra.FormallyUnramified.of_equiv e_loc.symm
  have _ : Algebra.IsIntegral B D := Algebra.IsIntegral.of_finite B D
  have hMaxComapBD : (Ideal.comap (algebraMap B D) (IsLocalRing.maximalIdeal D)).IsMaximal := by
    apply Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap B D)
      (Algebra.isIntegral_def.mp inferInstance)
  have hComapBD : Ideal.comap (algebraMap B D) (IsLocalRing.maximalIdeal D) = 𝔪_B :=
    IsLocalRing.eq_maximalIdeal hMaxComapBD
  have _ : IsLocalHom (algebraMap B D) :=
    ⟨fun b hb => by
      rw [← IsLocalRing.notMem_maximalIdeal] at hb ⊢
      intro hb_mem
      apply hb
      change b ∈ 𝔪_B at hb_mem
      rw [← hComapBD] at hb_mem
      exact hb_mem⟩
  have _ : Module.FaithfullyFlat B D := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hInjBD : Function.Injective (algebraMap B D) :=
    RingHom.FaithfullyFlat.injective (RingHom.faithfullyFlat_algebraMap_iff.mpr inferInstance)
  obtain ⟨hSepExtBD, hMapMaxBD⟩ :=
    (Algebra.FormallyUnramified.iff_map_maximalIdeal_eq (R := B) (S := D)).mp inferInstance
  have _ : Algebra.IsSeparable κ_B (IsLocalRing.ResidueField D) := hSepExtBD
  have _ : IsSepClosed κ_B := hSepB
  have hSurjResBD : Function.Surjective (algebraMap κ_B (IsLocalRing.ResidueField D)) :=
    IsSepClosed.algebraMap_surjective κ_B (IsLocalRing.ResidueField D)
  let N_sub : Submodule B D := LinearMap.range (Algebra.linearMap B D)
  have hTop_le_sup : (⊤ : Submodule B D) ≤ N_sub ⊔ 𝔪_B • (⊤ : Submodule B D) := by
    intro d _
    obtain ⟨b_res, hb_res⟩ := hSurjResBD (IsLocalRing.residue D d)
    obtain ⟨b₀, rfl⟩ := IsLocalRing.residue_surjective b_res
    have hres_eq : IsLocalRing.residue D (algebraMap B D b₀) = IsLocalRing.residue D d :=
      (IsLocalRing.ResidueField.map_residue (algebraMap B D) b₀).symm.trans hb_res
    have hdiff_max : d - algebraMap B D b₀ ∈ IsLocalRing.maximalIdeal D := by
      rw [← IsLocalRing.ker_residue, RingHom.mem_ker, map_sub, hres_eq, sub_self]
    rw [← hMapMaxBD] at hdiff_max
    have hdiff_smul : d - algebraMap B D b₀ ∈ 𝔪_B • (⊤ : Submodule B D) := by
      rw [Ideal.smul_top_eq_map]
      exact hdiff_max
    exact Submodule.mem_sup.mpr
      ⟨algebraMap B D b₀, ⟨b₀, rfl⟩, d - algebraMap B D b₀, hdiff_smul, add_sub_cancel _ _⟩
  have hTop_fg : (⊤ : Submodule B D).FG := Module.Finite.iff_fg.mp inferInstance
  have hmB_jac : 𝔪_B ≤ (⊥ : Ideal B).jacobson :=
    (IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal B) bot_ne_top).ge
  have hTop_le_N : (⊤ : Submodule B D) ≤ N_sub :=
    Submodule.le_of_le_smul_of_le_jacobson_bot hTop_fg hmB_jac hTop_le_sup
  have hSurjBD : Function.Surjective (algebraMap B D) := fun d => hTop_le_N Submodule.mem_top
  let e_BD : B ≃ₐ[B] D := AlgEquiv.ofBijective (Algebra.ofId B D) ⟨hInjBD, hSurjBD⟩
  let σ : W →ₐ[B] B :=
    e_BD.symm.toAlgHom.comp
      (e_loc.symm.toAlgHom.comp (IsScalarTower.toAlgHom B W (Localization.AtPrime q)))
  refine ⟨σ, ?_⟩
  have _ : IsArtinianRing C := IsArtinianRing.of_finite Ω C
  have hNilMaxC : IsNilpotent (IsLocalRing.maximalIdeal C) :=
    IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal C) bot_ne_top ▸
      IsArtinianRing.isNilpotent_jacobson_bot
  let f_res : C →+* IsLocalRing.ResidueField C := IsLocalRing.residue C
  have hNilKer : IsNilpotent (RingHom.ker f_res) := by
    rw [IsLocalRing.ker_residue]
    exact hNilMaxC
  let _ : Algebra B C := ι_B.toRingHom.toAlgebra
  let g₁ : W →ₐ[B] C := (Algebra.ofId B C).comp σ
  let g₂ : W →ₐ[B] C := { β₀ with commutes' := fun b => RingHom.congr_fun hβ₀ b }
  have hg_eq : g₁ = g₂ := Algebra.FormallyUnramified.ext' f_res hNilKer g₁ g₂ fun w => by
    have hloc_eq : algebraMap W (Localization.AtPrime q) (w - algebraMap B W (σ w)) =
        algebraMap W (Localization.AtPrime q) 0 := by
      rw [map_sub, map_zero, ← IsScalarTower.algebraMap_apply B W (Localization.AtPrime q) (σ w)]
      have h_eloc : algebraMap B (Localization.AtPrime q) (σ w) = e_loc (e_BD (σ w)) :=
        (e_loc.commutes (σ w)).symm
      rw [h_eloc]
      dsimp [σ]
      rw [e_BD.apply_symm_apply, e_loc.apply_symm_apply]
      exact sub_self _
    obtain ⟨⟨c, hc⟩, hcw⟩ :=
      (IsLocalization.eq_iff_exists q.primeCompl (Localization.AtPrime q)).mp hloc_eq
    dsimp only at hcw
    rw [mul_zero] at hcw
    have hw_mem_q : w - algebraMap B W (σ w) ∈ q :=
      (hq_prime.mem_or_mem (hcw ▸ q.zero_mem)).resolve_left hc
    have hβ_mem : β₀ (w - algebraMap B W (σ w)) ∈ RingHom.ker f_res := by
      rw [IsLocalRing.ker_residue]
      exact hw_mem_q
    rw [RingHom.mem_ker, map_sub, map_sub, sub_eq_zero] at hβ_mem
    have hβ_σ : β₀ (algebraMap B W (σ w)) = g₁ w := RingHom.congr_fun hβ₀ (σ w)
    rw [hβ_σ] at hβ_mem
    exact hβ_mem.symm
  ext w
  exact AlgHom.congr_fun hg_eq w

theorem weil_finite_alg_pointed_etale_decomposition_and_descent : (∀ (Ω C₀ : Type u) [Field Ω] [IsAlgClosed Ω] [CommRing C₀] [Algebra Ω C₀]
      [Module.Finite Ω C₀],
      ∃ (r : ℕ) (Q : Fin r → Type u) (_ : ∀ m, CommRing (Q m)) (_ : ∀ m, Algebra Ω (Q m))
        (_ : C₀ ≃ₐ[Ω] (∀ m : Fin r, Q m)),
        ∀ m : Fin r, WeilLocalRingEtaleSectionLifting (Q m)) ∧
    (∀ (R₀ B₀ Ω : Type u) [CommRing R₀] [CommRing B₀] [Algebra R₀ B₀]
      [Module.Finite R₀ B₀] [Field Ω] [IsAlgClosed Ω] [Algebra R₀ Ω],
      WeilPointedEtaleClopenSplittingAndDescent R₀ B₀ Ω) :=
by
  have hArt_loc : ∀ (Ω Q : Type u) [Field Ω] [IsAlgClosed Ω] [CommRing Q] [Algebra Ω Q]
      [Module.Finite Ω Q] [IsLocalRing Q],
      WeilLocalRingEtaleSectionLifting Q := by
    intro Ω Q _ _ _ _ _ _
    refine ⟨inferInstance, ?_⟩
    intro E _ _ _ ⟨q, hq_prime, hq_over⟩
    let 𝔪_Q : Ideal Q := IsLocalRing.maximalIdeal Q
    have : IsArtinianRing Q := IsArtinianRing.of_finite Ω Q
    have h_jac : Ideal.jacobson (⊥ : Ideal Q) = 𝔪_Q :=
      IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal Q) bot_ne_top
    have hNil : IsNilpotent 𝔪_Q := h_jac ▸ IsArtinianRing.isNilpotent_jacobson_bot
    have : Ideal.IsMaximal 𝔪_Q := IsLocalRing.maximalIdeal.isMaximal Q
    let _ : Field (Q ⧸ 𝔪_Q) := Ideal.Quotient.field 𝔪_Q
    have : Module.Finite Ω (Q ⧸ 𝔪_Q) :=
      Module.Finite.of_surjective (Ideal.Quotient.mkₐ Ω 𝔪_Q).toLinearMap Ideal.Quotient.mk_surjective
    have : Algebra.IsIntegral Ω (Q ⧸ 𝔪_Q) := Algebra.IsIntegral.of_finite Ω (Q ⧸ 𝔪_Q)
    have hbij_Q : Function.Bijective (algebraMap Ω (Q ⧸ 𝔪_Q)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e_Q : Ω ≃+* (Q ⧸ 𝔪_Q) := RingEquiv.ofBijective (algebraMap Ω (Q ⧸ 𝔪_Q)) hbij_Q
    have : q.IsPrime := hq_prime
    have : q.LiesOver 𝔪_Q := ⟨hq_over.symm⟩
    let locMap : Localization.AtPrime 𝔪_Q →+* Localization.AtPrime q :=
      Localization.localRingHom 𝔪_Q q (algebraMap Q E) hq_over.symm
    let _ : Algebra (Localization.AtPrime 𝔪_Q) (Localization.AtPrime q) := locMap.toAlgebra
    have : IsScalarTower Q (Localization.AtPrime 𝔪_Q) (Localization.AtPrime q) :=
      IsScalarTower.of_algebraMap_eq fun x =>
        (Localization.localRingHom_to_map 𝔪_Q q (algebraMap Q E) hq_over.symm x).symm
    have : Module.Finite 𝔪_Q.ResidueField q.ResidueField :=
      Algebra.instFiniteResidueFieldOfQuasiFiniteAt 𝔪_Q q
    let e_res : Ω ≃+* 𝔪_Q.ResidueField :=
      e_Q.trans (RingEquiv.ofBijective (algebraMap (Q ⧸ 𝔪_Q) 𝔪_Q.ResidueField)
        (Ideal.bijective_algebraMap_quotient_residueField 𝔪_Q))
    let φ_Ω_q : Ω →+* q.ResidueField :=
      (algebraMap 𝔪_Q.ResidueField q.ResidueField).comp e_res.toRingHom
    have hInt_res : (algebraMap 𝔪_Q.ResidueField q.ResidueField).IsIntegral :=
      Algebra.isIntegral_def.mp (Algebra.IsIntegral.of_finite 𝔪_Q.ResidueField q.ResidueField)
    have hInt_e : e_res.toRingHom.IsIntegral :=
      RingHom.isIntegral_of_surjective e_res.toRingHom e_res.surjective
    have hbij_q : Function.Bijective φ_Ω_q :=
      IsAlgClosed.ringHom_bijective_of_isIntegral φ_Ω_q
        (RingHom.IsIntegral.trans _ _ hInt_e hInt_res)
    let e_q : Ω ≃+* q.ResidueField := RingEquiv.ofBijective φ_Ω_q hbij_q
    let f_bar_hom : E →+* (Q ⧸ 𝔪_Q) :=
      e_Q.toRingHom.comp (e_q.symm.toRingHom.comp (algebraMap E q.ResidueField))
    have hf_comm : ∀ x : Q, f_bar_hom (algebraMap Q E x) = Ideal.Quotient.mk 𝔪_Q x := by
      intro x
      let ω : Ω := e_Q.symm (Ideal.Quotient.mk 𝔪_Q x)
      have hω_mk : Ideal.Quotient.mk 𝔪_Q (algebraMap Ω Q ω) = Ideal.Quotient.mk 𝔪_Q x := by
        change algebraMap Ω (Q ⧸ 𝔪_Q) ω = Ideal.Quotient.mk 𝔪_Q x
        exact e_Q.apply_symm_apply (Ideal.Quotient.mk 𝔪_Q x)
      have hsub_m : x - algebraMap Ω Q ω ∈ 𝔪_Q := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hω_mk, sub_self]
      have hsub_q : algebraMap Q E (x - algebraMap Ω Q ω) ∈ q := by
        rwa [← Ideal.mem_comap, hq_over]
      have hsub_zero : algebraMap E q.ResidueField (algebraMap Q E (x - algebraMap Ω Q ω)) = 0 :=
        (Ideal.Quotient.eq_zero_iff_mem).mpr
          (IsLocalization.AtPrime.map_eq_maximalIdeal q (Localization.AtPrime q) ▸
            Ideal.mem_map_of_mem _ hsub_q)
      have h_eq_x : algebraMap E q.ResidueField (algebraMap Q E x) =
          algebraMap E q.ResidueField (algebraMap Q E (algebraMap Ω Q ω)) := by
        rw [map_sub, map_sub, sub_eq_zero] at hsub_zero
        exact hsub_zero
      have h_eq_ω : algebraMap E q.ResidueField (algebraMap Q E (algebraMap Ω Q ω)) = e_q ω := by
        have h1 : e_q ω = algebraMap 𝔪_Q.ResidueField q.ResidueField
            (algebraMap Q 𝔪_Q.ResidueField (algebraMap Ω Q ω)) := by
          change algebraMap 𝔪_Q.ResidueField q.ResidueField
            (algebraMap (Q ⧸ 𝔪_Q) 𝔪_Q.ResidueField (algebraMap Ω (Q ⧸ 𝔪_Q) ω)) = _
          rw [IsScalarTower.algebraMap_apply Ω Q (Q ⧸ 𝔪_Q) ω,
            ← IsScalarTower.algebraMap_apply Q (Q ⧸ 𝔪_Q) 𝔪_Q.ResidueField]
        rw [h1]
        change IsLocalRing.residue (Localization.AtPrime q)
            (algebraMap E (Localization.AtPrime q) (algebraMap Q E (algebraMap Ω Q ω))) =
          IsLocalRing.ResidueField.map locMap
            (IsLocalRing.residue (Localization.AtPrime 𝔪_Q)
              (algebraMap Q (Localization.AtPrime 𝔪_Q) (algebraMap Ω Q ω)))
        rw [IsLocalRing.ResidueField.map_residue]
        congr 1
        exact (Localization.localRingHom_to_map 𝔪_Q q (algebraMap Q E) hq_over.symm _).symm
      change e_Q (e_q.symm (algebraMap E q.ResidueField (algebraMap Q E x))) =
        Ideal.Quotient.mk 𝔪_Q x
      rw [h_eq_x, h_eq_ω, e_q.symm_apply_apply]
      exact e_Q.apply_symm_apply (Ideal.Quotient.mk 𝔪_Q x)
    let f_bar : E →ₐ[Q] (Q ⧸ 𝔪_Q) := { f_bar_hom with commutes' := hf_comm }
    exact ⟨Algebra.FormallySmooth.lift 𝔪_Q hNil f_bar⟩
  refine ⟨?_, ?_⟩
  · intro Ω C₀ _ _ _ _ _
    have hJac_Ω : ∀ (d : ℕ) (g : Fin d → MvPolynomial (Fin d) Ω) (z₀ : Fin d → Ω),
        (∀ k : Fin d, MvPolynomial.eval z₀ (g k) ∈ IsLocalRing.maximalIdeal Ω) →
        IsUnit (IsLocalRing.residue Ω
          (MvPolynomial.eval z₀
            (Matrix.det (Matrix.of fun k l : Fin d => MvPolynomial.pderiv l (g k))))) →
        ∃ z : Fin d → Ω,
          (∀ k : Fin d, MvPolynomial.eval z (g k) = 0) ∧
          (∀ l : Fin d, z l - z₀ l ∈ IsLocalRing.maximalIdeal Ω) := by
      intro d g z₀ hg _
      refine ⟨z₀, fun k => ?_, fun l => ?_⟩
      · by_contra hne
        exact (IsLocalRing.mem_maximalIdeal (MvPolynomial.eval z₀ (g k))).mp (hg k)
          (IsUnit.mk0 _ hne)
      · rw [sub_self]
        exact Ideal.zero_mem _
    obtain ⟨r, e, he, hLoc⟩ := weil_jacobian_local_finite_alg_decomposition Ω C₀ hJac_Ω
    let Q : Fin r → Type u := fun m => C₀ ⧸ Ideal.span {1 - e m}
    let φ_split : C₀ →ₐ[Ω] (∀ m : Fin r, Q m) :=
      AlgHom.pi (fun m => Ideal.Quotient.mkₐ Ω (Ideal.span {1 - e m}))
    have hbij_split : Function.Bijective φ_split :=
      CompleteOrthogonalIdempotents.bijective_pi he
    refine ⟨r, Q, inferInstance, inferInstance, AlgEquiv.ofBijective φ_split hbij_split, ?_⟩
    intro m
    have : IsLocalRing (Q m) := hLoc m
    have : Module.Finite Ω (Q m) :=
      Module.Finite.of_surjective
        (Ideal.Quotient.mkₐ Ω (Ideal.span {1 - e m})).toLinearMap
        Ideal.Quotient.mk_surjective
    exact hArt_loc Ω (Q m)
  · intro R₀ B₀ Ω _ _ _ _ _ _ _
    obtain ⟨A, _, _, _, _, ⟨⟨hLocA, hKerA, hSepA⟩, hJacA, hIdem_desc, hFP_desc, hZero_desc⟩⟩ :=
      weil_pointed_etale_strictly_local_envelope R₀ Ω
    have : IsLocalRing A := hLocA
    have hJacA' : ∀ (d : ℕ) (g : Fin d → MvPolynomial (Fin d) A) (z₀ : Fin d → A),
        (∀ k : Fin d, MvPolynomial.eval z₀ (g k) ∈ IsLocalRing.maximalIdeal A) →
        IsUnit (IsLocalRing.residue A
          (MvPolynomial.eval z₀
            (Matrix.det (Matrix.of fun k l : Fin d => MvPolynomial.pderiv l (g k))))) →
        ∃ z : Fin d → A,
          (∀ k : Fin d, MvPolynomial.eval z (g k) = 0) ∧
          (∀ l : Fin d, z l - z₀ l ∈ IsLocalRing.maximalIdeal A) := by
      intro d g z₀ hg hdet
      have hg' : ∀ k : Fin d, MvPolynomial.eval z₀ (g k) ∈ RingHom.ker (algebraMap A Ω) := by
        intro k
        rw [← hKerA]
        exact hg k
      have hdet' : MvPolynomial.eval z₀
          (Matrix.det (Matrix.of fun k l : Fin d => MvPolynomial.pderiv l (g k))) ∉
            RingHom.ker (algebraMap A Ω) := by
        rw [← hKerA]
        intro hmem
        have hzero : IsLocalRing.residue A
            (MvPolynomial.eval z₀
              (Matrix.det (Matrix.of fun k l : Fin d => MvPolynomial.pderiv l (g k)))) = 0 :=
          (Ideal.Quotient.eq_zero_iff_mem).mpr hmem
        exact hdet.ne_zero hzero
      obtain ⟨z, hz0, hz_diff⟩ := hJacA d g z₀ hg' hdet'
      refine ⟨z, hz0, fun l => ?_⟩
      rw [hKerA]
      exact hz_diff l
    obtain ⟨r, e_A, he_A, hLoc_Bm⟩ :=
      weil_jacobian_local_finite_alg_decomposition A (TensorProduct R₀ A B₀) hJacA'
    obtain ⟨R₁, _, _, _, _, _, _, _, _, e₁, he₁, he₁_eq⟩ :=
      hIdem_desc B₀ r e_A he_A
    let B₁ : Fin r → Type u := fun m => TensorProduct R₀ R₁ B₀ ⧸ Ideal.span {1 - e₁ m}
    let φ_split₁ : TensorProduct R₀ R₁ B₀ →ₐ[R₁] (∀ m : Fin r, B₁ m) :=
      AlgHom.pi (fun m => Ideal.Quotient.mkₐ R₁ (Ideal.span {1 - e₁ m}))
    let e_split₁ : TensorProduct R₀ R₁ B₀ ≃ₐ[R₁] (∀ m : Fin r, B₁ m) :=
      AlgEquiv.ofBijective φ_split₁ (CompleteOrthogonalIdempotents.bijective_pi he₁)
    refine ⟨R₁, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      r, B₁, inferInstance, inferInstance, e_split₁, ?_⟩
    intro b₁_hom m
    let I₁ : Ideal (TensorProduct R₀ R₁ B₀) := Ideal.span {1 - e₁ m}
    let I_A : Ideal (TensorProduct R₀ A B₀) := Ideal.span {1 - e_A m}
    let B_m : Type u := TensorProduct R₀ A B₀ ⧸ I_A
    have : IsLocalRing B_m := hLoc_Bm m
    have : Module.Finite A B_m :=
      Module.Finite.of_surjective (Ideal.Quotient.mkₐ A I_A).toLinearMap
        Ideal.Quotient.mk_surjective
    let b₁_hom_m : B₀ →+* B₁ m := b₁_hom m
    let j_R₁_A : TensorProduct R₀ R₁ B₀ →+* TensorProduct R₀ A B₀ :=
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₀ R₁ A) (AlgHom.id R₀ B₀)).toRingHom
    have hj_ker : I₁ ≤ Ideal.comap j_R₁_A I_A := by
      rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, map_sub, map_one]
      change 1 - Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₀ R₁ A) (AlgHom.id R₀ B₀) (e₁ m) ∈ I_A
      rw [he₁_eq m]
      exact Ideal.mem_span_singleton_self (1 - e_A m)
    let q_m : B₁ m →+* B_m :=
      Ideal.Quotient.lift I₁ ((Ideal.Quotient.mk I_A).comp j_R₁_A)
