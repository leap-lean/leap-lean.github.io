      have hz' : (B.map g).left.base z' = z :=
        (AlgebraicGeometry.Scheme.Hom.comp_apply h_pb.isoPullback.inv (B.map g).left p).symm.trans
          ((congrArg (fun k => k.base p) h_pb.isoPullback_inv_snd).trans hp_snd)
      exact ⟨B.obj W, B.map g, z',
        CategoryTheory.Sieve.image_mem_functorPushforward B R hgR, hBg_et, hz'⟩
    have hCont : B.IsContinuous X.smallEtaleTopology X₀.smallEtaleTopology :=
      @CategoryTheory.Functor.isContinuous_of_coverPreserving _ _ _ _ B
        X.smallEtaleTopology X₀.smallEtaleTopology hCompat hCov
    have hB_sheaf : CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology
        (B.op ⋙ weilEtaleGmPresheaf X₀) :=
      @CategoryTheory.Functor.op_comp_isSheaf _ _ _ _ B _ _
        X.smallEtaleTopology X₀.smallEtaleTopology hCont
        ⟨weilEtaleGmPresheaf X₀, hGmSheaf X₀⟩
    let e_K : B.op ⋙ weilEtaleGmPresheaf X₀ ≅ weilEtaleKPresheaf X :=
      CategoryTheory.NatIso.ofComponents
        (fun _ => CategoryTheory.Iso.refl _)
        (fun m => (CategoryTheory.Category.comp_id _).trans
          (CategoryTheory.Category.id_comp _).symm)
    exact (CategoryTheory.Presheaf.isSheaf_of_iso_iff e_K).mp hB_sheaf
  refine ⟨hKSheaf, ?_⟩
  intro hK G δ_pre T_X δ
  have hT_X : CategoryTheory.Limits.IsTerminal T_X :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom))
      (fun U g => CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.comp_id g.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w g)))
  let J := X.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
  let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_X
  let e_adj : ∀ F : CategoryTheory.Sheaf J AddCommGrpCat.{u},
      (Fℤ ⟶ F) ≃+ (Aℤ ⟶ F.obj.obj (Opposite.op T_X)) := fun F =>
    { adj.homEquiv Aℤ F with
      map_add' := fun f₁ f₂ => by
        change adj.homEquiv Aℤ F (f₁ + f₂) = adj.homEquiv Aℤ F f₁ + adj.homEquiv Aℤ F f₂
        rw [adj.homEquiv_unit, adj.homEquiv_unit, adj.homEquiv_unit]
        apply AddCommGrpCat.ext
        intro n
        rfl }
  let e_Z : ∀ M : AddCommGrpCat.{u}, (Aℤ ⟶ M) ≃+ ↥M := fun M =>
    { toFun := fun g => g.hom (ULift.up (1 : ℤ))
      invFun := fun m => AddCommGrpCat.ofHom
        { toFun := fun n => n.down • m
          map_zero' := zero_zsmul m
          map_add' := fun a b => add_zsmul m a.down b.down }
      left_inv := fun g => by
        apply AddCommGrpCat.ext
        rintro ⟨n⟩
        change n • g.hom (ULift.up (1 : ℤ)) = g.hom (ULift.up n)
        have hn : (ULift.up n : ULift.{u} ℤ) = n • (ULift.up (1 : ℤ) : ULift.{u} ℤ) :=
          ULift.ext _ _ (by simp)
        rw [hn, map_zsmul]
