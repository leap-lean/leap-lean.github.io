        have hgen_v := hVal_mul w_s (Finset.univ.prod u_neg_s) hws_ne hprod_un_ne hgen_ne x
        rw [hval_un_sum] at hgen_v
        dsimp only [gen_s]
        omega
      let u_F : Units K := u * Units.mk0 (germB₀ Δ_pos_s) hΔ_pos_s
      have huF_in_B₀ : ∀ x : Pt, x.1 ∈ U₀ → 0 ≤ div_fn (Additive.ofMul u_F) x := by
        intro x hx_in
        have huF_v : div_fn (Additive.ofMul u_F) x =
            div_fn (Additive.ofMul u) x +
              div_fn (Additive.ofMul (Units.mk0 (germB₀ Δ_pos_s) hΔ_pos_s)) x := by
          change div_fn (Additive.ofMul (u * Units.mk0 (germB₀ Δ_pos_s) hΔ_pos_s)) x = _
