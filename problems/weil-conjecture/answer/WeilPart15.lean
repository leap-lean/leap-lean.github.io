        have hu_fixed : u.val ∈ IntermediateField.fixedField (⊤ : Subgroup Gal(L'/F)) := by
          rw [IntermediateField.mem_fixedField_iff]
          intro σ _
          exact htop_le (Subgroup.mem_top σ)
