    have hex_aff : ∀ x : ↥U₀, ∃ V : U₀.affineOpens, x ∈ V.1 := by
      intro x
      have htop : (⨆ V : U₀.affineOpens, (V : U₀.Opens)) = ⊤ :=
        AlgebraicGeometry.iSup_affineOpens_eq_top U₀
      have hx_top : x ∈ (⊤ : U₀.Opens) := trivial
      rw [← htop, TopologicalSpace.Opens.mem_iSup] at hx_top
      exact hx_top
    choose V_x hVx using hex_aff
    let R_x : ↥U₀ → CommRingCat.{u} := fun x => U₀.presheaf.obj (Opposite.op (V_x x).1)
    let ψ_x : ∀ x : ↥U₀, Spec (R_x x) ⟶ U₀ := fun x => (V_x x).2.isoSpec.inv ≫ (V_x x).1.ι
    have hψ_et : ∀ x : ↥U₀, AlgebraicGeometry.Etale (ψ_x x) := fun x =>
      MorphismProperty.comp_mem P_et _ _
        (MorphismProperty.of_isIso P_et ((V_x x).2.isoSpec.inv))
        (inferInstance : AlgebraicGeometry.Etale (V_x x).1.ι)
    let p_x : ∀ x : ↥U₀, ↥(Spec (R_x x)) := fun x => (V_x x).2.isoSpec.hom.base ⟨x, hVx x⟩
    have hpx : ∀ x : ↥U₀, (ψ_x x).base (p_x x) = x := by
      intro x
      dsimp [ψ_x, p_x]
      have hiso : ((V_x x).2.isoSpec.hom ≫ (V_x x).2.isoSpec.inv).base ⟨x, hVx x⟩ = ⟨x, hVx x⟩ := by
        rw [Iso.hom_inv_id]
        rfl
      exact congrArg Subtype.val hiso
    let σ_x : ∀ x : ↥U₀, k →+* ↑(R_x x) := fun x =>
      ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        (ψ_x x ≫ U.hom ≫ πS).appTop ≫
        (Scheme.ΓSpecIso (R_x x)).hom).hom
    let u_tilde : ∀ x : ↥U₀, Units ↑(R_x x) := fun x =>
      Units.map ((ψ_x x).appTop ≫ (Scheme.ΓSpecIso (R_x x)).hom).hom.toMonoidHom u₁
    have hKummer_x : ∀ x : ↥U₀,
        ∃ (B : Type u) (_ : CommRing B) (α : ↑(R_x x) →+* B) (w : Units B),
          α.Etale ∧
          Function.Surjective (PrimeSpectrum.comap α) ∧
          w ^ ℓ = Units.map α.toMonoidHom (u_tilde x) :=
      fun x => hAff (↑(R_x x)) (σ_x x) (u_tilde x)
    choose B_x instRingBx α_x w_x hα_et hα_surj hw_x using hKummer_x
    letI : ∀ x : ↥U₀, CommRing (B_x x) := instRingBx
    let α_cat : ∀ x : ↥U₀, R_x x ⟶ CommRingCat.of (B_x x) :=
      fun x => CommRingCat.ofHom (α_x x)
    let π_x : ∀ x : ↥U₀, Spec (CommRingCat.of (B_x x)) ⟶ Spec (R_x x) :=
      fun x => Spec.map (α_cat x)
    have hπ_et : ∀ x : ↥U₀, AlgebraicGeometry.Etale (π_x x) := fun x =>
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr (hα_et x)
    have hex_qx : ∀ x : ↥U₀, ∃ q : ↥(Spec (CommRingCat.of (B_x x))), (π_x x).base q = p_x x :=
      fun x => hα_surj x (p_x x)
    choose q_x hqx using hex_qx
    let k_sch : ∀ x : ↥U₀, Spec (CommRingCat.of (B_x x)) ⟶ U₀ :=
      fun x => π_x x ≫ ψ_x x
    have hk_et : ∀ x : ↥U₀, AlgebraicGeometry.Etale (k_sch x) :=
      fun x => MorphismProperty.comp_mem P_et _ _ (hπ_et x) (hψ_et x)
    let Y_x : ↥U₀ → S.Etale := fun x =>
      MorphismProperty.Over.mk ⊤ (k_sch x ≫ U.hom)
        (MorphismProperty.comp_mem P_et _ _ (hk_et x) U.prop)
    let k_mor : ∀ x : ↥U₀, Y_x x ⟶ U :=
      fun x => MorphismProperty.Over.homMk (k_sch x) rfl
    let R : Sieve U := Sieve.ofArrows Y_x k_mor
    refine ⟨R, ?_, ?_⟩
    · rw [hMemJ]
      intro x
      refine ⟨Y_x x, k_mor x, q_x x, Sieve.ofArrows_mk Y_x k_mor x, hk_et x, ?_⟩
      change (ψ_x x).base ((π_x x).base (q_x x)) = x
      rw [hqx x, hpx x]
    · intro Z h hh
      rcases hh with ⟨_, m, _, ⟨x⟩, rfl⟩
      let w_hat : Units ↑((Spec (CommRingCat.of (B_x x))).presheaf.obj (Opposite.op ⊤)) :=
        Units.map (Scheme.ΓSpecIso (CommRingCat.of (B_x x))).inv.hom.toMonoidHom (w_x x)
      have hw_hat_pow : w_hat ^ ℓ = Units.map (k_sch x).appTop.hom.toMonoidHom u₁ := by
        have hnat : (Scheme.ΓSpecIso (R_x x)).hom ≫ α_cat x ≫
            (Scheme.ΓSpecIso (CommRingCat.of (B_x x))).inv = (π_x x).appTop := by
          rw [← Category.assoc, ← Scheme.ΓSpecIso_naturality (α_cat x), Category.assoc,
            Iso.hom_inv_id, Category.comp_id]
        have hring : (((ψ_x x).appTop ≫ (Scheme.ΓSpecIso (R_x x)).hom) ≫ α_cat x) ≫
            (Scheme.ΓSpecIso (CommRingCat.of (B_x x))).inv = (k_sch x).appTop := by
          rw [Category.assoc, Category.assoc, hnat]
          exact (Scheme.Hom.comp_appTop (π_x x) (ψ_x x)).symm
        dsimp [w_hat]
        rw [← map_pow, hw_x x]
        apply Units.ext
        exact congrArg (fun φ : U₀.presheaf.obj (Opposite.op ⊤) ⟶ _ => φ.hom (u₁ : _)) hring
      let w_Yx : ↑((weilEtaleGmPresheaf S).obj (Opposite.op (Y_x x))) := Additive.ofMul w_hat
      have hw_Yx : ℓ • w_Yx = ((weilEtaleGmPresheaf S).map (k_mor x).op).hom u := by
        change ℓ • Additive.ofMul w_hat =
          Additive.ofMul (Units.map (k_sch x).appTop.hom.toMonoidHom u₁)
        rw [← ofMul_pow, hw_hat_pow]
      refine ⟨((weilEtaleGmPresheaf S).map m.op).hom w_Yx, ?_⟩
      rw [← map_nsmul, hw_Yx, op_comp, (weilEtaleGmPresheaf S).map_comp]
      rfl
  
  obtain ⟨hL, ⟨e_L⟩⟩ := h_s3
  let L_sh : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u} := ⟨_, hL⟩
  let G_sh : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u} :=
    ⟨weilEtaleGmPresheaf X.left, hGm⟩
  let e_G : G_sh ≅ weilEtaleGmSheaf X.left := CategoryTheory.sheafificationIso G_sh
  obtain ⟨Φ, hΦ_nat, hΦ_inj, hΦ_ker⟩ := h_s4
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget X.left
  let π_et : ∀ U : X.left.Etale, (Fgt.obj U).left ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    fun U => (Fgt.obj U).hom ≫ X.hom
  let ι_LG : L_sh ⟶ G_sh :=
    { hom :=
        { app := fun U => AddCommGrpCat.ofHom
            (Φ (Fgt.obj (Opposite.unop U)).left (π_et (Opposite.unop U)))
          naturality := fun U₁ U₂ f => by
            apply AddCommGrpCat.ext
            intro s
            have hw : (Fgt.map (Opposite.unop f)).left ≫ π_et (Opposite.unop U₁) =
                π_et (Opposite.unop U₂) := by
              change (Opposite.unop f).left ≫ ((Opposite.unop U₁).hom ≫ X.hom) =
                (Opposite.unop U₂).hom ≫ X.hom
              rw [← CategoryTheory.Category.assoc,
                CategoryTheory.MorphismProperty.Over.w (Opposite.unop f)]
            exact (congrArg (fun π => Φ (Fgt.obj (Opposite.unop U₂)).left π
              (s.comap (Opposite.unop f).left.base.hom)) hw.symm).trans
              (hΦ_nat (Fgt.map (Opposite.unop f)).left (π_et (Opposite.unop U₁)) s) } }
  let p_G : G_sh ⟶ G_sh := ℓ • CategoryTheory.CategoryStruct.id G_sh
  have hp_G_app : ∀ (U : Opposite X.left.Etale) (u : ↑(G_sh.obj.obj U)),
      (p_G.hom.app U).hom u = ℓ • u := by
    intro U u
    have hnsmul : ∀ (n : ℕ),
        ((n • CategoryTheory.CategoryStruct.id G_sh).hom.app U).hom u = n • u := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [succ_nsmul, CategoryTheory.Sheaf.Hom.add_app, AddCommGrpCat.hom_add,
          AddMonoidHom.add_apply, ih, succ_nsmul]
        rfl
    exact hnsmul ℓ
  have h0_LG : ι_LG ≫ p_G = 0 := by
    ext U : 3
    apply AddCommGrpCat.ext
    intro s
    change (p_G.hom.app U).hom ((ι_LG.hom.app U).hom s) = 0
    rw [hp_G_app U]
    exact (hΦ_ker (Fgt.obj (Opposite.unop U)).left (π_et (Opposite.unop U)) _).mpr ⟨s, rfl⟩
  have hMono : CategoryTheory.Mono ι_LG := by
    constructor
    intro K α β hαβ
    ext U : 3
    apply AddCommGrpCat.ext
    intro x
    apply hΦ_inj (Fgt.obj (Opposite.unop U)).left (π_et (Opposite.unop U))
    exact congrArg (fun g : K ⟶ G_sh => (g.hom.app U).hom x) hαβ
  have hLift_ex : ∀ {K : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}}
      (τ : K ⟶ G_sh), τ ≫ p_G = 0 →
      ∀ (U : Opposite X.left.Etale) (x : ↑(K.obj.obj U)),
        ∃ s : LocallyConstant ↥(Opposite.unop U).left (ULift.{u, 0} (ZMod ℓ)),
          Φ (Fgt.obj (Opposite.unop U)).left (π_et (Opposite.unop U)) s = (τ.hom.app U).hom x := by
    intro K τ hτ U x
    apply (hΦ_ker (Fgt.obj (Opposite.unop U)).left (π_et (Opposite.unop U)) _).mp
    have h0_x : ((τ ≫ p_G).hom.app U).hom x = 0 :=
      congrArg (fun g : K ⟶ G_sh => (g.hom.app U).hom x) hτ
    have hcomp_x : ((τ ≫ p_G).hom.app U).hom x = (p_G.hom.app U).hom ((τ.hom.app U).hom x) := rfl
    exact (hp_G_app U ((τ.hom.app U).hom x)).symm.trans (hcomp_x.symm.trans h0_x)
  let lift_hom : ∀ {K : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}}
      (τ : K ⟶ G_sh), τ ≫ p_G = 0 → (K ⟶ L_sh) :=
    fun {K} τ hτ =>
      { hom :=
          { app := fun U => AddCommGrpCat.ofHom
              { toFun := fun x => (hLift_ex τ hτ U x).choose
                map_zero' := by
                  apply hΦ_inj (Fgt.obj (Opposite.unop U)).left (π_et (Opposite.unop U))
                  exact ((hLift_ex τ hτ U 0).choose_spec.trans (map_zero _)).trans
                    (map_zero _).symm
                map_add' := fun x y => by
                  apply hΦ_inj (Fgt.obj (Opposite.unop U)).left (π_et (Opposite.unop U))
                  have hxy := (hLift_ex τ hτ U (x + y)).choose_spec.trans (map_add _ x y)
                  have hx := (hLift_ex τ hτ U x).choose_spec
                  have hy := (hLift_ex τ hτ U y).choose_spec
                  exact hxy.trans ((congrArg₂ (· + ·) hx.symm hy.symm).trans (map_add _ _ _).symm) }
            naturality := fun U₁ U₂ f => by
              apply AddCommGrpCat.ext
              intro x
              apply hΦ_inj (Fgt.obj (Opposite.unop U₂)).left (π_et (Opposite.unop U₂))
              have hLHS : Φ (Fgt.obj (Opposite.unop U₂)).left (π_et (Opposite.unop U₂))
                  ((hLift_ex τ hτ U₂ ((K.obj.map f).hom x)).choose) =
                  (τ.hom.app U₂).hom ((K.obj.map f).hom x) :=
                (hLift_ex τ hτ U₂ ((K.obj.map f).hom x)).choose_spec
              have hw : (Fgt.map (Opposite.unop f)).left ≫ π_et (Opposite.unop U₁) =
                  π_et (Opposite.unop U₂) := by
                change (Opposite.unop f).left ≫ ((Opposite.unop U₁).hom ≫ X.hom) =
                  (Opposite.unop U₂).hom ≫ X.hom
                rw [← CategoryTheory.Category.assoc,
                  CategoryTheory.MorphismProperty.Over.w (Opposite.unop f)]
              have hRHS : Φ (Fgt.obj (Opposite.unop U₂)).left (π_et (Opposite.unop U₂))
                  (((hLift_ex τ hτ U₁ x).choose).comap (Opposite.unop f).left.base.hom) =
                  ((G_sh.obj.map f).hom) ((τ.hom.app U₁).hom x) := by
                have h1 := (congrArg (fun π => Φ (Fgt.obj (Opposite.unop U₂)).left π
                  (((hLift_ex τ hτ U₁ x).choose).comap (Opposite.unop f).left.base.hom)) hw.symm).trans
                  (hΦ_nat (Fgt.map (Opposite.unop f)).left (π_et (Opposite.unop U₁))
                    ((hLift_ex τ hτ U₁ x).choose))
                exact h1.trans (congrArg ((G_sh.obj.map f).hom) (hLift_ex τ hτ U₁ x).choose_spec)
              have hτ_nat : (τ.hom.app U₂).hom ((K.obj.map f).hom x) =
                  ((G_sh.obj.map f).hom) ((τ.hom.app U₁).hom x) :=
                congrArg (fun g : K.obj.obj U₁ ⟶ G_sh.obj.obj U₂ => g.hom x) (τ.hom.naturality f)
