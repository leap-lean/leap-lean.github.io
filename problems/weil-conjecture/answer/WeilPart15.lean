  have hTensorDomain : ∀ (A B : Type u) [CommRing A] [IsDomain A] [Algebra k A]
      [Algebra.FiniteType k A] [CommRing B] [IsDomain B] [Algebra k B],
      IsDomain (TensorProduct k A B) := by
    intro A B _ _ _ _ _ _ _
    obtain ⟨φ₀⟩ := hEvalAlg A
    let Ψ : (A →ₐ[k] k) → (TensorProduct k A B →ₐ[k] B) :=
      fun φ => (Algebra.TensorProduct.lid k B).toAlgHom.comp
        (Algebra.TensorProduct.map φ (AlgHom.id k B))
    have : Nontrivial (TensorProduct k A B) := by
      refine ⟨⟨1, 0, fun h10 => ?_⟩⟩
      have hB : (1 : B) = 0 := by
        calc
          (1 : B) = Ψ φ₀ 1 := (map_one (Ψ φ₀)).symm
          _ = Ψ φ₀ 0 := congrArg (Ψ φ₀) h10
          _ = 0 := map_zero (Ψ φ₀)
      exact one_ne_zero hB
    let b := Module.Free.chooseBasis k B
    let ι := Module.Free.ChooseBasisIndex k B
    let Φ : TensorProduct k A B ≃ₗ[k] (ι →₀ A) :=
      (LinearEquiv.lTensor A b.repr).trans
        ((TensorProduct.finsuppRight k k A k ι).trans
          (Finsupp.mapRange.linearEquiv (TensorProduct.rid k A)))
    have hEvalCoord : ∀ (φ : A →ₐ[k] k) (w : TensorProduct k A B) (i : ι),
        b.repr (Ψ φ w) i = φ (Φ w i) := by
      intro φ w i
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul a y =>
        have hLHS : b.repr (Ψ φ (a ⊗ₜ[k] y)) i = φ a * b.repr y i := by
          dsimp [Ψ]
          rw [map_smul, Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul]
        have hRHS : φ (Φ (a ⊗ₜ[k] y) i) = b.repr y i * φ a := by
          dsimp [Φ]
          rw [Finsupp.mapRange.linearEquiv_apply,
            Finsupp.mapRange_apply, TensorProduct.finsuppRight_apply_tmul_apply,
            TensorProduct.rid_tmul, map_smul, smul_eq_mul]
        rw [hLHS, hRHS, mul_comm]
      | add x y ihx ihy =>
        simp only [map_add, Finsupp.coe_add, Pi.add_apply, ihx, ihy]
    have : NoZeroDivisors (TensorProduct k A B) := by
      refine ⟨fun {u v} huv => ?_⟩
      by_contra hnot
      have hu : u ≠ 0 := fun hu0 => hnot (Or.inl hu0)
      have hv : v ≠ 0 := fun hv0 => hnot (Or.inr hv0)
      have hΦu : Φ u ≠ 0 := fun h0 => hu (Φ.injective (h0.trans (map_zero Φ).symm))
      have hΦv : Φ v ≠ 0 := fun h0 => hv (Φ.injective (h0.trans (map_zero Φ).symm))
      obtain ⟨i₁, hi₁⟩ : ∃ i₁ : ι, Φ u i₁ ≠ 0 := by
        by_contra hall
        exact hΦu (Finsupp.ext fun i => not_not.mp fun hi => hall ⟨i, hi⟩)
      obtain ⟨i₂, hi₂⟩ : ∃ i₂ : ι, Φ v i₂ ≠ 0 := by
        by_contra hall
        exact hΦv (Finsupp.ext fun i => not_not.mp fun hi => hall ⟨i, hi⟩)
      let a₁ : A := Φ u i₁
      let a₂ : A := Φ v i₂
      have ha₁₂ : a₁ * a₂ ≠ 0 := mul_ne_zero hi₁ hi₂
      have hle_nzd : Submonoid.powers (a₁ * a₂) ≤ nonZeroDivisors A := by
        rintro _ ⟨n, rfl⟩
        exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n ha₁₂)
      let A' := Localization.Away (a₁ * a₂)
      have : IsDomain A' := IsLocalization.isDomain_localization hle_nzd
      have : Algebra.FinitePresentation A A' :=
        IsLocalization.Away.finitePresentation (a₁ * a₂)
      have : Algebra.FiniteType k A' :=
        Algebra.FiniteType.trans (R := k) (S := A) (A := A') inferInstance inferInstance
      obtain ⟨φ'⟩ := hEvalAlg A'
      let φ : A →ₐ[k] k := φ'.comp (IsScalarTower.toAlgHom k A A')
      have hunit_A' : IsUnit (algebraMap A A' (a₁ * a₂)) :=
        IsLocalization.Away.algebraMap_isUnit (a₁ * a₂)
      have hunit_k : IsUnit (φ (a₁ * a₂)) := by
        change IsUnit (φ'.toRingHom (algebraMap A A' (a₁ * a₂)))
        exact hunit_A'.map φ'.toRingHom
      have hφ_ne : φ a₁ * φ a₂ ≠ 0 := by
        rw [← map_mul]
        exact hunit_k.ne_zero
      have hΨu : Ψ φ u ≠ 0 := by
        intro h0
        have hc : b.repr (Ψ φ u) i₁ = 0 := by rw [h0, map_zero, Finsupp.coe_zero, Pi.zero_apply]
        rw [hEvalCoord φ u i₁] at hc
        exact hφ_ne (by rw [hc, zero_mul])
      have hΨv : Ψ φ v ≠ 0 := by
        intro h0
        have hc : b.repr (Ψ φ v) i₂ = 0 := by rw [h0, map_zero, Finsupp.coe_zero, Pi.zero_apply]
        rw [hEvalCoord φ v i₂] at hc
        exact hφ_ne (by rw [hc, mul_zero])
      have hΨuv : Ψ φ u * Ψ φ v = 0 := by
        rw [← map_mul, huv, map_zero]
      exact mul_ne_zero hΨu hΨv hΨuv
    exact ((noZeroDivisors_iff_isDomain_or_subsingleton (TensorProduct k A B)).mp inferInstance)
      |>.resolve_right (not_subsingleton _)
