      let ψ : D_res →ₐ[A] C ⧸ J := Algebra.TensorProduct.lift ψ₁ ψ₂ (fun _ _ => Commute.all _ _)
      have hψ_comp : ∀ x : C, ψ (π_res x) = q_J x := by
