theorem weil_geometricallyIrreducible_of_algClosure_pullback (E : Type u) [Field E]
    (k : Type u) [Field k] [IsAlgClosed k] [Algebra E k] [Algebra.IsAlgebraic E k]
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E)))
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntW : AlgebraicGeometry.IsIntegral W.left)
    (p_W : W.left ⟶ Y.left)
    (hpW : CategoryTheory.IsPullback p_W W.hom Y.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E k)))) :
    AlgebraicGeometry.GeometricallyIrreducible Y.hom :=
by
  have irred_of_surj : ∀ {α β : Type u} [TopologicalSpace α] [TopologicalSpace β]
      [IrreducibleSpace α] (φ : α → β), Continuous φ → Function.Surjective φ →
      IrreducibleSpace β := by
    intro α β _ _ _ φ hcont hsurj
    rw [irreducibleSpace_def]
    have h1 : IsIrreducible (φ '' Set.univ) :=
      (IrreducibleSpace.isIrreducible_univ (X := α)).image φ hcont.continuousOn
    rw [Set.image_univ, Set.range_eq_univ.mpr hsurj] at h1
    exact h1
  
  have hDom : ∀ (K A : Type u) [Field K] [Algebra k K] [CommRing A] [IsDomain A] [Algebra k A],
      IsDomain (TensorProduct k K A) := by
    intro K A _ _ _ _ _
    have : Nontrivial (TensorProduct k K A) :=
      Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain k K A
        (RingHom.injective (algebraMap k K)) (RingHom.injective (algebraMap k A))
    have : NoZeroDivisors (TensorProduct k K A) := by
      refine ⟨fun {x y} hxy => ?_⟩
      by_contra hne
      rw [not_or] at hne
      rcases hne with ⟨hx, hy⟩
      let ι := Module.Basis.ofVectorSpaceIndex k A
      let b : Module.Basis ι k A := Module.Basis.ofVectorSpace k A
      let bK : Module.Basis ι K (TensorProduct k K A) := b.baseChange K
      let c : ι →₀ K := bK.repr x
      let d : ι →₀ K := bK.repr y
      have hc : c ≠ 0 := fun hc0 => hx (bK.repr.injective (hc0.trans (map_zero _).symm))
      have hd : d ≠ 0 := fun hd0 => hy (bK.repr.injective (hd0.trans (map_zero _).symm))
      obtain ⟨i₀, hi₀⟩ := Finsupp.support_nonempty_iff.mpr hc
      obtain ⟨j₀, hj₀⟩ := Finsupp.support_nonempty_iff.mpr hd
      have hc₀ : c i₀ ≠ 0 := Finsupp.mem_support_iff.mp hi₀
      have hd₀ : d j₀ ≠ 0 := Finsupp.mem_support_iff.mp hj₀
      have hx_sum : ∑ i ∈ c.support.attach, TensorProduct.tmul k (c i.1) (b i.1) = x := by
        rw [Finset.sum_attach c.support (fun i => TensorProduct.tmul k (c i) (b i))]
        conv_rhs => rw [← bK.linearCombination_repr x]
        change ∑ i ∈ c.support, TensorProduct.tmul k (c i) (b i) =
          (Finsupp.linearCombination K bK) c
        rw [Finsupp.linearCombination_apply, Finsupp.sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        dsimp only [bK]
        rw [Module.Basis.baseChange_apply (S := K) b i,
          TensorProduct.smul_tmul' (c i) (1 : K) (b i), smul_eq_mul, mul_one]
      have hy_sum : ∑ j ∈ d.support.attach, TensorProduct.tmul k (d j.1) (b j.1) = y := by
        rw [Finset.sum_attach d.support (fun j => TensorProduct.tmul k (d j) (b j))]
        conv_rhs => rw [← bK.linearCombination_repr y]
        change ∑ j ∈ d.support, TensorProduct.tmul k (d j) (b j) =
          (Finsupp.linearCombination K bK) d
        rw [Finsupp.linearCombination_apply, Finsupp.sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        dsimp only [bK]
        rw [Module.Basis.baseChange_apply (S := K) b j,
          TensorProduct.smul_tmul' (d j) (1 : K) (b j), smul_eq_mul, mul_one]
      let u : K := c i₀ * d j₀
      have hu : u ≠ 0 := mul_ne_zero hc₀ hd₀
      let σ : Type u := (↥c.support ⊕ ↥d.support) ⊕ Unit
      let ω : σ → K := Sum.elim (Sum.elim (fun i => c i.1) (fun j => d j.1)) (fun _ => u⁻¹)
      let ev : MvPolynomial σ k →ₐ[k] K := MvPolynomial.aeval ω
      let R₀ : Subalgebra k K := ev.range
      let f₀ : MvPolynomial σ k →ₐ[k] ↥R₀ := ev.rangeRestrict
      have hf₀ : Function.Surjective f₀ := AlgHom.rangeRestrict_surjective ev
      let J : Ideal (MvPolynomial σ k) := RingHom.ker f₀
      have hJ_prime : J.IsPrime := RingHom.ker_isPrime f₀
      obtain ⟨𝔪, h𝔪_max, hJ𝔪⟩ := Ideal.exists_le_maximal J hJ_prime.ne_top
      obtain ⟨t, ht⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (K := k)).mp h𝔪_max
      have hker : ∀ p ∈ J, (MvPolynomial.aeval t) p = 0 := by
        intro p hp
        have hp𝔪 : p ∈ MvPolynomial.vanishingIdeal k {t} := ht ▸ hJ𝔪 hp
        exact (MvPolynomial.mem_vanishingIdeal_singleton_iff t p).mp hp𝔪
      let χ : ↥R₀ →ₐ[k] k :=
        (Ideal.Quotient.liftₐ J (MvPolynomial.aeval t) hker).comp
          (Ideal.quotientKerAlgEquivOfSurjective hf₀).symm.toAlgHom
      let cR : ↥c.support → ↥R₀ := fun i => f₀ (MvPolynomial.X (Sum.inl (Sum.inl i)))
      let dR : ↥d.support → ↥R₀ := fun j => f₀ (MvPolynomial.X (Sum.inl (Sum.inr j)))
      let uR_inv : ↥R₀ := f₀ (MvPolynomial.X (Sum.inr ()))
      have hcR : ∀ i : ↥c.support, (cR i : K) = c i.1 := fun i => by
        change ev (MvPolynomial.X (Sum.inl (Sum.inl i))) = c i.1
        simp [ev, ω]
      have hdR : ∀ j : ↥d.support, (dR j : K) = d j.1 := fun j => by
        change ev (MvPolynomial.X (Sum.inl (Sum.inr j))) = d j.1
        simp [ev, ω]
      have huR : (uR_inv : K) = u⁻¹ := by
        change ev (MvPolynomial.X (Sum.inr ())) = u⁻¹
        simp [ev, ω]
      let i_star : ↥c.support := ⟨i₀, hi₀⟩
      let j_star : ↥d.support := ⟨j₀, hj₀⟩
      have h_unit_R₀ : cR i_star * dR j_star * uR_inv = 1 := by
        apply Subtype.ext
        push_cast
        rw [hcR i_star, hdR j_star, huR]
        exact mul_inv_cancel₀ hu
      have h_unit_k : χ (cR i_star) * χ (dR j_star) * χ uR_inv = 1 := by
        simpa only [map_mul, map_one] using congrArg χ h_unit_R₀
      have hχc : χ (cR i_star) ≠ 0 := by
        intro h0
        rw [h0, zero_mul, zero_mul] at h_unit_k
        exact zero_ne_one h_unit_k
      have hχd : χ (dR j_star) ≠ 0 := by
        intro h0
        rw [h0, mul_zero, zero_mul] at h_unit_k
        exact zero_ne_one h_unit_k
      let xR : TensorProduct k ↥R₀ A :=
        ∑ i ∈ c.support.attach, TensorProduct.tmul k (cR i) (b i.1)
      let yR : TensorProduct k ↥R₀ A :=
        ∑ j ∈ d.support.attach, TensorProduct.tmul k (dR j) (b j.1)
      let ι_R₀ : TensorProduct k ↥R₀ A →ₐ[k] TensorProduct k K A :=
        Algebra.TensorProduct.map R₀.val (AlgHom.id k A)
      have hι_x : ι_R₀ xR = x := by
        rw [← hx_sum, map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        simp [ι_R₀, hcR i]
      have hι_y : ι_R₀ yR = y := by
        rw [← hy_sum, map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        simp [ι_R₀, hdR j]
      have hι_eq : ι_R₀.toLinearMap = LinearMap.rTensor A R₀.val.toLinearMap := by
        ext r a
        rfl
      have hι_inj : Function.Injective ι_R₀ := by
        change Function.Injective ι_R₀.toLinearMap
        rw [hι_eq]
        exact Module.Flat.rTensor_preserves_injective_linearMap
          R₀.val.toLinearMap Subtype.val_injective
      have hxRyR : xR * yR = 0 := hι_inj (by rw [map_mul, hι_x, hι_y, hxy, map_zero])
      let Ψ : TensorProduct k ↥R₀ A →ₐ[k] A :=
        (Algebra.TensorProduct.lid k A).toAlgHom.comp
          (Algebra.TensorProduct.map χ (AlgHom.id k A))
      have hΨ_prod : Ψ xR * Ψ yR = 0 := by
        rw [← map_mul, hxRyR, map_zero]
      rcases mul_eq_zero.mp hΨ_prod with hΨx | hΨy
      · apply hχc
        have hrepr : b.repr (Ψ xR) i₀ = χ (cR i_star) := by
          have hΨx_eq : Ψ xR = ∑ i ∈ c.support.attach, χ (cR i) • b i.1 := by
            rw [map_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            simp [Ψ]
          rw [hΨx_eq, map_sum, Finsupp.coe_finsetSum, Finset.sum_apply]
          rw [Finset.sum_eq_single i_star]
          · simp [i_star]
          · intro i _ hi_ne
            have hi0 : i.1 ≠ i₀ := fun hval => hi_ne (Subtype.ext hval)
            simp [hi0]
          · intro hi_not_mem
            exact absurd (Finset.mem_attach _ i_star) hi_not_mem
        rw [← hrepr, hΨx, map_zero, Finsupp.zero_apply]
      · apply hχd
        have hrepr : b.repr (Ψ yR) j₀ = χ (dR j_star) := by
          have hΨy_eq : Ψ yR = ∑ j ∈ d.support.attach, χ (dR j) • b j.1 := by
            rw [map_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            simp [Ψ]
          rw [hΨy_eq, map_sum, Finsupp.coe_finsetSum, Finset.sum_apply]
          rw [Finset.sum_eq_single j_star]
          · simp [j_star]
          · intro j _ hj_ne
            have hj0 : j.1 ≠ j₀ := fun hval => hj_ne (Subtype.ext hval)
            simp [hj0]
          · intro hj_not_mem
            exact absurd (Finset.mem_attach _ j_star) hj_not_mem
        rw [← hrepr, hΨy, map_zero, Finsupp.zero_apply]
    exact NoZeroDivisors.to_isDomain (TensorProduct k K A)
  
  have : AlgebraicGeometry.IsIntegral W.left := hIntW
  have hIrredW : IrreducibleSpace ↥W.left :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral W.left hIntW
  have hW : AlgebraicGeometry.GeometricallyIrreducible W.hom := by
    rw [AlgebraicGeometry.geometricallyIrreducible_iff,
      AlgebraicGeometry.geometrically_iff_of_commRing_of_isClosedUnderIsomorphisms]
    intro K _ _
    let g_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k K))
    let P := CategoryTheory.Limits.pullback W.hom g_K
    change IrreducibleSpace ↥P
    let 𝒜 := W.left.affineOpenCover
    have hOpen𝒜 : ∀ j : 𝒜.I₀, AlgebraicGeometry.IsOpenImmersion (𝒜.f j) :=
      fun j => by dsimp [𝒜]; infer_instance
    let U : ↥W.left → P.Opens := fun w =>
      ⟨(CategoryTheory.Limits.pullback.fst W.hom g_K) ⁻¹' Set.range (𝒜.f (𝒜.idx w)),
        (hOpen𝒜 (𝒜.idx w)).base_open.isOpen_range.preimage
          (CategoryTheory.Limits.pullback.fst W.hom g_K).continuous⟩
    have hpair : Pairwise (Function.onFun (fun x1 x2 => ¬Disjoint x1 x2) U) := by
      intro w₁ w₂ _
      change ¬Disjoint (U w₁) (U w₂)
      rw [disjoint_iff]
      intro hbot
      let O₁ : Set ↥W.left := Set.range (𝒜.f (𝒜.idx w₁))
      let O₂ : Set ↥W.left := Set.range (𝒜.f (𝒜.idx w₂))
      have hO₁_open : IsOpen O₁ := (hOpen𝒜 (𝒜.idx w₁)).base_open.isOpen_range
      have hO₂_open : IsOpen O₂ := (hOpen𝒜 (𝒜.idx w₂)).base_open.isOpen_range
      obtain ⟨w_star, _, hw₁, hw₂⟩ :=
        (@IrreducibleSpace.isIrreducible_univ ↥W.left _ hIrredW).isPreirreducible
          O₁ O₂ hO₁_open hO₂_open ⟨w₁, trivial, 𝒜.covers w₁⟩ ⟨w₂, trivial, 𝒜.covers w₂⟩
      obtain ⟨y₀⟩ : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := inferInstance
      obtain ⟨z_star, hz_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := W.hom) (g := g_K) w_star y₀ (Subsingleton.elim _ _)
      have hz₁ : z_star ∈ U w₁ := by
        change (CategoryTheory.Limits.pullback.fst W.hom g_K) z_star ∈ O₁
        rwa [hz_fst]
      have hz₂ : z_star ∈ U w₂ := by
        change (CategoryTheory.Limits.pullback.fst W.hom g_K) z_star ∈ O₂
        rwa [hz_fst]
      have hz_bot : z_star ∈ (⊥ : P.Opens) := hbot ▸ TopologicalSpace.Opens.mem_inf.mpr ⟨hz₁, hz₂⟩
      exact Set.notMem_empty z_star hz_bot
    have hcov : TopologicalSpace.IsOpenCover U := by
      refine TopologicalSpace.IsOpenCover.mk ?_
      rw [eq_top_iff]
      intro z _
      rw [TopologicalSpace.Opens.mem_iSup]
      refine ⟨(CategoryTheory.Limits.pullback.fst W.hom g_K) z, ?_⟩
      exact 𝒜.covers ((CategoryTheory.Limits.pullback.fst W.hom g_K) z)
    have hpre : ∀ w : ↥W.left, PreirreducibleSpace ↥(U w) := by
      intro w
      let j := 𝒜.idx w
      let R_w : CommRingCat.{u} := 𝒜.X j
      obtain ⟨x₀, _⟩ := 𝒜.covers w
      have : Nonempty ↥(AlgebraicGeometry.Spec R_w) := ⟨x₀⟩
      have : AlgebraicGeometry.IsOpenImmersion (𝒜.f j) := hOpen𝒜 j
      have : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec R_w) :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion (𝒜.f j)
      have : IsDomain R_w := (AlgebraicGeometry.affine_isIntegral_iff R_w).mp inferInstance
      obtain ⟨φ, hφ⟩ := AlgebraicGeometry.Spec.map_surjective (𝒜.f j ≫ W.hom)
      let alg_w : Algebra k R_w := φ.hom.toAlgebra
      have hφ_eq : AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (@algebraMap k R_w _ _ alg_w)) = 𝒜.f j ≫ W.hom := hφ
      have hDom_w : @IsDomain (TensorProduct k K R_w)
          (@Algebra.TensorProduct.instSemiring k K R_w _ _ _ _ alg_w) :=
        @hDom K R_w _ _ _ _ alg_w
      let V_j := CategoryTheory.Limits.pullback (𝒜.f j ≫ W.hom) g_K
      let fj : V_j ⟶ P :=
        CategoryTheory.Limits.pullback.map (𝒜.f j ≫ W.hom) g_K W.hom g_K
          (𝒜.f j) (𝟙 _) (𝟙 _) (CategoryTheory.Category.comp_id _)
          ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)
      have hrange_j : Set.range fj = ((U w : P.Opens) : Set ↥P) := by
        dsimp only [fj]
        rw [AlgebraicGeometry.Scheme.Pullback.range_map]
        have hid : Set.range ⇑(𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K))) = Set.univ := by
          ext y
          exact ⟨fun _ => trivial, fun _ => ⟨y, rfl⟩⟩
        rw [hid, Set.preimage_univ, Set.inter_univ]
        rfl
      let T_w : CommRingCat.{u} :=
        @CommRingCat.of (TensorProduct k K R_w)
          (@Algebra.TensorProduct.instCommRing k K R_w _ _ _ _ alg_w)
      have hDom_T : IsDomain T_w := hDom_w
      have hIrredSpec : IrreducibleSpace ↥(AlgebraicGeometry.Spec T_w) :=
        @AlgebraicGeometry.irreducibleSpace_of_isIntegral _
          ((AlgebraicGeometry.affine_isIntegral_iff T_w).mpr hDom_T)
      let e_j : V_j ≅ AlgebraicGeometry.Spec T_w :=
        CategoryTheory.Limits.pullback.congrHom hφ_eq.symm rfl ≪≫
          CategoryTheory.Limits.pullbackSymmetry _ _ ≪≫
          @AlgebraicGeometry.pullbackSpecIso k K R_w _ _ _ _ alg_w
      have hIrredVj : IrreducibleSpace ↥V_j :=
        @irred_of_surj _ _ _ _ hIrredSpec e_j.inv e_j.inv.continuous e_j.inv.surjective
      have hirr_Uw : IsIrreducible ((U w : P.Opens) : Set ↥P) := by
        rw [← hrange_j, ← Set.image_univ]
        exact (@IrreducibleSpace.isIrreducible_univ ↥V_j _ hIrredVj).image
          fj fj.continuous.continuousOn
      exact ((isIrreducible_iff_irreducibleSpace).mp hirr_Uw).toPreirreducibleSpace
    have : PreirreducibleSpace ↥P := PreirreducibleSpace.of_isOpenCover hpair hcov hpre
    exact ⟨inferInstance⟩
  
  rw [AlgebraicGeometry.geometricallyIrreducible_iff,
    AlgebraicGeometry.geometrically_iff_of_commRing_of_isClosedUnderIsomorphisms]
  intro K _ _
  let s_EK := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E K))
  let P_K := CategoryTheory.Limits.pullback Y.hom s_EK
  change IrreducibleSpace ↥P_K
  let Ω : Type u := AlgebraicClosure K
  let σ : k →ₐ[E] Ω := IsAlgClosed.lift
  let s_kΩ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom)
  let s_KΩ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K Ω))
  let s_EΩ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E Ω))
  have hs1 : s_kΩ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E k)) = s_EΩ := by
    dsimp [s_kΩ, s_EΩ]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, σ.comp_algebraMap]
  have hs2 : s_KΩ ≫ s_EK = s_EΩ := by
    dsimp [s_KΩ, s_EK, s_EΩ]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← IsScalarTower.algebraMap_eq E K Ω]
  have : IrreducibleSpace ↥(CategoryTheory.Limits.pullback W.hom s_kΩ) :=
    AlgebraicGeometry.pullback_of_geometrically
      ((AlgebraicGeometry.geometricallyIrreducible_iff W.hom).mp hW) Ω s_kΩ
  have hp1 : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst W.hom s_kΩ ≫ p_W)
      (CategoryTheory.Limits.pullback.snd W.hom s_kΩ)
      Y.hom s_EΩ := by
    have h := (CategoryTheory.IsPullback.of_hasPullback W.hom s_kΩ).paste_horiz hpW
    rwa [hs1] at h
  have : IrreducibleSpace ↥(CategoryTheory.Limits.pullback Y.hom s_EΩ) :=
    irred_of_surj hp1.isoPullback.hom hp1.isoPullback.hom.continuous hp1.isoPullback.hom.surjective
  let P' := CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd Y.hom s_EK) s_KΩ
  let q : P' ⟶ P_K :=
    CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd Y.hom s_EK) s_KΩ
  have hp2 : CategoryTheory.IsPullback
      (q ≫ CategoryTheory.Limits.pullback.fst Y.hom s_EK)
      (CategoryTheory.Limits.pullback.snd (CategoryTheory.Limits.pullback.snd Y.hom s_EK) s_KΩ)
      Y.hom s_EΩ := by
    have h := (CategoryTheory.IsPullback.of_hasPullback
      (CategoryTheory.Limits.pullback.snd Y.hom s_EK) s_KΩ).paste_horiz
      (CategoryTheory.IsPullback.of_hasPullback Y.hom s_EK)
    rwa [hs2] at h
  have : IrreducibleSpace ↥P' :=
    irred_of_surj hp2.isoPullback.inv hp2.isoPullback.inv.continuous hp2.isoPullback.inv.surjective
  have : AlgebraicGeometry.Surjective s_KΩ := ⟨Function.surjective_to_subsingleton _⟩
  exact irred_of_surj q q.continuous q.surjective

theorem weil_enlarge_field_smooth_and_etale_of_model (F : Type u) [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper X.hom]
    (d : ℕ)
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))))
    [AlgebraicGeometry.SmoothOfRelativeDimension d W.hom]
    (φ_bar : W ⟶ weilBaseChangeOver F (AlgebraicClosure F) X)
    (U_bar : (weilBaseChangeOver F (AlgebraicClosure F) X).left.Opens)
    (hEt_bar : AlgebraicGeometry.Etale (φ_bar.left ∣_ U_bar))
    (L₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F ↥L₀]
    (Y₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₀)))
    (φ₀ : Y₀ ⟶ weilBaseChangeOver F ↥L₀ X)
    (U₀ : (weilBaseChangeOver F ↥L₀ X).left.Opens)
    (hPropY₀ : AlgebraicGeometry.IsProper Y₀.hom)
    (hFin₀ : AlgebraicGeometry.IsFinite (φ₀.left ∣_ U₀))
    (hMod₀ : IsBaseChangeAlterationModel F X W φ_bar U_bar L₀ Y₀ φ₀ U₀) :
    ∃ (L₁ : IntermediateField F (AlgebraicClosure F))
      (hLE : L₀ ≤ L₁)
      (_ : FiniteDimensional F ↥L₁),
      letI : Algebra ↥L₀ ↥L₁ := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
      ∃ (φ₁ : weilBaseChangeOver ↥L₀ ↥L₁ Y₀ ⟶ weilBaseChangeOver F ↥L₁ X)
        (U₁ : (weilBaseChangeOver F ↥L₁ X).left.Opens),
        IsBaseChangeAlterationModel F X W φ_bar U_bar L₁ (weilBaseChangeOver ↥L₀ ↥L₁ Y₀) φ₁ U₁ ∧
        AlgebraicGeometry.SmoothOfRelativeDimension d (weilBaseChangeOver ↥L₀ ↥L₁ Y₀).hom ∧
        AlgebraicGeometry.Etale (φ₁.left ∣_ U₁) :=
by
  have hAlgCore :
      let k := AlgebraicClosure F
      (∀ (L₀ : IntermediateField F k) [FiniteDimensional F ↥L₀]
         (R : Type u) [CommRing R] [Algebra ↥L₀ R] [Algebra.FiniteType ↥L₀ R],
         RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension d)
           (algebraMap k (TensorProduct ↥L₀ k R)) →
         ∃ (L_sm : IntermediateField F k) (_ : L₀ ≤ L_sm) (_ : FiniteDimensional F ↥L_sm),
           ∀ (L₁ : IntermediateField F k) (hLE₁ : L₀ ≤ L₁), L_sm ≤ L₁ →
             letI : Algebra ↥L₀ ↥L₁ := (IntermediateField.inclusion hLE₁).toRingHom.toAlgebra
             RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension d)
               (algebraMap ↥L₁ (TensorProduct ↥L₀ ↥L₁ R))) ∧
      (∀ (L₀ : IntermediateField F k) [FiniteDimensional F ↥L₀]
         (P Q : Type u) [CommRing P] [CommRing Q] [Algebra ↥L₀ P] [Algebra ↥L₀ Q]
         [Algebra P Q] [IsScalarTower ↥L₀ P Q]
         [Algebra.FiniteType ↥L₀ P] [Algebra.FiniteType ↥L₀ Q],
         RingHom.Etale (Algebra.TensorProduct.map (AlgHom.id k k)
           (IsScalarTower.toAlgHom ↥L₀ P Q)).toRingHom →
         ∃ (L_et : IntermediateField F k) (_ : L₀ ≤ L_et) (_ : FiniteDimensional F ↥L_et),
           ∀ (L₁ : IntermediateField F k) (hLE₁ : L₀ ≤ L₁), L_et ≤ L₁ →
             letI : Algebra ↥L₀ ↥L₁ := (IntermediateField.inclusion hLE₁).toRingHom.toAlgebra
             RingHom.Etale (Algebra.TensorProduct.map (AlgHom.id ↥L₁ ↥L₁)
               (IsScalarTower.toAlgHom ↥L₀ P Q)).toRingHom) := by
    intro k
    have hAdjoinFinset : ∀ (E : IntermediateField F k) [FiniteDimensional F ↥E] (S : Finset k),
        ∃ (E' : IntermediateField F k), E ≤ E' ∧ FiniteDimensional F ↥E' ∧ (S : Set k) ⊆ E' := by
      intro E _ S
      let E₂ : IntermediateField F k := IntermediateField.adjoin F (S : Set k)
      haveI : Finite ↑(S : Set k) := S.finite_toSet
      haveI : FiniteDimensional F ↥E₂ :=
        IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x
      let E' : IntermediateField F k := E ⊔ E₂
      haveI : FiniteDimensional F ↥E' := IntermediateField.finiteDimensional_sup E E₂
      exact ⟨E', le_sup_left, inferInstance, fun x hx =>
        (le_sup_right : E₂ ≤ E') (IntermediateField.subset_adjoin F (S : Set k) hx)⟩
    have hTensorInj : ∀ (K₀ K₁ K₂ R : Type u) [Field K₀] [Field K₁] [Field K₂] [CommRing R]
        [Algebra K₀ K₁] [Algebra K₀ K₂] [Algebra K₁ K₂] [IsScalarTower K₀ K₁ K₂] [Algebra K₀ R],
        Function.Injective (Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom K₀ K₁ K₂) (AlgHom.id K₀ R)) := by
      intro K₀ K₁ K₂ R _ _ _ _ _ _ _ _ _
      let e := Algebra.TensorProduct.cancelBaseChange K₀ K₁ K₂ K₂ R
      let m := TensorProduct.mk K₁ K₂ (TensorProduct K₀ K₁ R) 1
      have hm : Function.Injective m :=
        Module.FaithfullyFlat.tensorProduct_mk_injective (TensorProduct K₀ K₁ R)
      have hcomp : ∀ x : TensorProduct K₀ K₁ R,
          e (m x) = Algebra.TensorProduct.map (IsScalarTower.toAlgHom K₀ K₁ K₂) (AlgHom.id K₀ R) x := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp [m]
        | tmul a r => simp [m, e, Algebra.smul_def]
        | add x y hx hy => simp only [map_add, hx, hy]
      intro x y hxy
      exact hm (e.injective (by rw [hcomp, hcomp, hxy]))
    have hTensorSupport : ∀ (E : IntermediateField F k) [FiniteDimensional F ↥E]
        (R : Type u) [CommRing R] [Algebra ↥E R]
        {ι : Type u} [Finite ι] (z : ι → TensorProduct ↥E k R),
        ∃ (E' : IntermediateField F k) (hEE' : E ≤ E') (_ : FiniteDimensional F ↥E'),
          letI : Algebra ↥E ↥E' := (IntermediateField.inclusion hEE').toRingHom.toAlgebra
          haveI : IsScalarTower ↥E ↥E' k := IsScalarTower.of_algebraMap_eq fun _ => rfl
          ∀ i : ι, ∃ w : TensorProduct ↥E ↥E' R,
            Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥E ↥E' k) (AlgHom.id ↥E R) w = z i := by
      intro E _ R _ _ ι _ z
      have hSingle : ∀ x : TensorProduct ↥E k R,
          ∃ S : Finset k, ∀ (L : IntermediateField F k) (hEL : E ≤ L), (S : Set k) ⊆ L →
            letI : Algebra ↥E ↥L := (IntermediateField.inclusion hEL).toRingHom.toAlgebra
            haveI : IsScalarTower ↥E ↥L k := IsScalarTower.of_algebraMap_eq fun _ => rfl
            ∃ w : TensorProduct ↥E ↥L R,
              Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥E ↥L k) (AlgHom.id ↥E R) w = x := by
        intro x
        classical
        induction x using TensorProduct.induction_on with
        | zero =>
          exact ⟨∅, fun L hEL _ => ⟨0, map_zero _⟩⟩
        | tmul c r =>
          refine ⟨{c}, fun L hEL hS => ?_⟩
          letI : Algebra ↥E ↥L := (IntermediateField.inclusion hEL).toRingHom.toAlgebra
          haveI : IsScalarTower ↥E ↥L k := IsScalarTower.of_algebraMap_eq fun _ => rfl
          exact ⟨TensorProduct.tmul ↥E (⟨c, hS (Finset.mem_singleton_self c)⟩ : ↥L) r, rfl⟩
        | add x₁ x₂ ih₁ ih₂ =>
          obtain ⟨S₁, h₁⟩ := ih₁
          obtain ⟨S₂, h₂⟩ := ih₂
          refine ⟨S₁ ∪ S₂, fun L hEL hS => ?_⟩
          letI : Algebra ↥E ↥L := (IntermediateField.inclusion hEL).toRingHom.toAlgebra
          haveI : IsScalarTower ↥E ↥L k := IsScalarTower.of_algebraMap_eq fun _ => rfl
          obtain ⟨w₁, hw₁⟩ := h₁ L hEL (Set.Subset.trans Finset.subset_union_left hS)
          obtain ⟨w₂, hw₂⟩ := h₂ L hEL (Set.Subset.trans Finset.subset_union_right hS)
          exact ⟨w₁ + w₂, by rw [map_add, hw₁, hw₂]⟩
      classical
      cases nonempty_fintype ι
      choose S hS using fun i => hSingle (z i)
      obtain ⟨E', hEE', hFDE', hSub⟩ := hAdjoinFinset E (Finset.univ.biUnion S)
      refine ⟨E', hEE', hFDE', ?_⟩
      letI : Algebra ↥E ↥E' := (IntermediateField.inclusion hEE').toRingHom.toAlgebra
      haveI : IsScalarTower ↥E ↥E' k := IsScalarTower.of_algebraMap_eq fun _ => rfl
      intro i
      exact hS i E' hEE' (fun c hc => hSub (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, hc⟩))
    have hTensorCancelMiddle : ∀ (K R₀ B Ω : Type u) [CommRing K] [CommRing R₀] [CommRing B] [CommRing Ω]
        [Algebra K R₀] [Algebra K B] [Algebra R₀ B] [IsScalarTower K R₀ B] [Algebra K Ω],
        letI : Algebra R₀ (TensorProduct K Ω R₀) := Algebra.TensorProduct.rightAlgebra
        ∃ e : TensorProduct K Ω B ≃ₐ[Ω] TensorProduct R₀ (TensorProduct K Ω R₀) B,
          ∀ (ω : Ω) (b : B), e (ω ⊗ₜ[K] b) = (ω ⊗ₜ[K] (1 : R₀)) ⊗ₜ[R₀] b := by
      intro K R₀ B Ω _ _ _ _ _ _ _ _ _
      let PΩ := TensorProduct K Ω R₀
      letI : Algebra R₀ PΩ := Algebra.TensorProduct.rightAlgebra
      haveI : IsScalarTower K R₀ PΩ := IsScalarTower.of_algebraMap_eq fun x => by
        change algebraMap K PΩ x = (1 : Ω) ⊗ₜ[K] algebraMap K R₀ x
        exact ((Algebra.TensorProduct.includeRight : R₀ →ₐ[K] PΩ).commutes x).symm
      let RHS := TensorProduct R₀ PΩ B
      let fwd : TensorProduct K Ω B →ₐ[Ω] RHS :=
        Algebra.TensorProduct.lift (Algebra.ofId Ω RHS)
          ((Algebra.TensorProduct.includeRight : B →ₐ[R₀] RHS).restrictScalars K)
          (fun _ _ => Commute.all _ _)
      let bwd_PΩ : PΩ →ₐ[K] TensorProduct K Ω B :=
        Algebra.TensorProduct.map (AlgHom.id K Ω) (IsScalarTower.toAlgHom K R₀ B)
      letI algR₀_LHS : Algebra R₀ (TensorProduct K Ω B) :=
        ((Algebra.TensorProduct.includeRight : B →ₐ[K] TensorProduct K Ω B).toRingHom.comp
          (algebraMap R₀ B)).toAlgebra
      let bwd_PΩ_R₀ : PΩ →ₐ[R₀] TensorProduct K Ω B :=
        { bwd_PΩ with commutes' := fun _ => rfl }
      let bwd_B_R₀ : B →ₐ[R₀] TensorProduct K Ω B :=
        { (Algebra.TensorProduct.includeRight : B →ₐ[K] TensorProduct K Ω B) with
          commutes' := fun _ => rfl }
      let bwd : RHS →ₐ[R₀] TensorProduct K Ω B :=
        Algebra.TensorProduct.lift bwd_PΩ_R₀ bwd_B_R₀ (fun _ _ => Commute.all _ _)
      have hbwd_fwd : ∀ x : TensorProduct K Ω B, bwd (fwd x) = x := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul ω b =>
          change bwd (algebraMap Ω RHS ω * ((1 : PΩ) ⊗ₜ[R₀] b)) = ω ⊗ₜ[K] b
          have h1 : algebraMap Ω RHS ω * ((1 : PΩ) ⊗ₜ[R₀] b) = (ω ⊗ₜ[K] (1 : R₀)) ⊗ₜ[R₀] b := by
            change ((ω ⊗ₜ[K] (1 : R₀)) ⊗ₜ[R₀] (1 : B)) * ((1 : PΩ) ⊗ₜ[R₀] b) = _
            simp
          rw [h1]
          change bwd_PΩ (ω ⊗ₜ[K] (1 : R₀)) * ((1 : Ω) ⊗ₜ[K] b) = ω ⊗ₜ[K] b
          rw [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.tmul_mul_tmul]
          simp
        | add x y hx hy => simp only [map_add, hx, hy]
      have hfwd_bwd : ∀ y : RHS, fwd (bwd y) = y := by
        intro y
        induction y using TensorProduct.induction_on with
        | zero => simp
        | tmul p b =>
          induction p using TensorProduct.induction_on with
          | zero => simp
          | tmul ω r₀ =>
            change fwd (bwd_PΩ (ω ⊗ₜ[K] r₀) * ((1 : Ω) ⊗ₜ[K] b)) = (ω ⊗ₜ[K] r₀) ⊗ₜ[R₀] b
            have hp : bwd_PΩ (ω ⊗ₜ[K] r₀) * ((1 : Ω) ⊗ₜ[K] b) = ω ⊗ₜ[K] (algebraMap R₀ B r₀ * b) := by
              rw [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.tmul_mul_tmul]
              simp
            rw [hp]
            have hfwd_app : fwd (ω ⊗ₜ[K] (algebraMap R₀ B r₀ * b)) =
                algebraMap Ω RHS ω * ((1 : PΩ) ⊗ₜ[R₀] (r₀ • b)) := by
              rw [← Algebra.smul_def r₀ b]
              exact Algebra.TensorProduct.lift_tmul (Algebra.ofId Ω RHS)
                ((Algebra.TensorProduct.includeRight : B →ₐ[R₀] RHS).restrictScalars K) _ ω (r₀ • b)
            rw [hfwd_app, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
            have hr₀ : (r₀ • (1 : PΩ)) = (1 : Ω) ⊗ₜ[K] r₀ := by
              rw [Algebra.smul_def, mul_one]; rfl
            rw [hr₀]
            change ((ω ⊗ₜ[K] (1 : R₀)) ⊗ₜ[R₀] (1 : B)) * (((1 : Ω) ⊗ₜ[K] r₀) ⊗ₜ[R₀] b) = _
            simp
          | add p₁ p₂ hp₁ hp₂ =>
            rw [TensorProduct.add_tmul, map_add, map_add, hp₁, hp₂]
        | add y₁ y₂ hy₁ hy₂ => simp only [map_add, hy₁, hy₂]
      let e_ring : TensorProduct K Ω B ≃+* RHS :=
        { fwd.toRingHom with
          invFun := bwd
          left_inv := hbwd_fwd
          right_inv := hfwd_bwd }
      refine ⟨AlgEquiv.ofRingEquiv (f := e_ring) (fun ω => fwd.commutes ω), fun ω b => ?_⟩
      change ((ω ⊗ₜ[K] (1 : R₀)) ⊗ₜ[R₀] (1 : B)) * ((1 : PΩ) ⊗ₜ[R₀] b) = _
      simp
    have hDescentAlgEquiv : ∀ (E : IntermediateField F k) [FiniteDimensional F ↥E]
        (C D : Type u) [CommRing C] [CommRing D] [Algebra ↥E C] [Algebra ↥E D]
        [Algebra.FiniteType ↥E C] [Algebra.FiniteType ↥E D]
        (e : TensorProduct ↥E k C ≃ₐ[k] TensorProduct ↥E k D),
        ∃ (L' : IntermediateField F k) (hEL' : E ≤ L') (_ : FiniteDimensional F ↥L'),
          letI : Algebra ↥E ↥L' := (IntermediateField.inclusion hEL').toRingHom.toAlgebra
          haveI : IsScalarTower ↥E ↥L' k := IsScalarTower.of_algebraMap_eq fun _ => rfl
          ∃ (α : TensorProduct ↥E ↥L' C ≃ₐ[↥L'] TensorProduct ↥E ↥L' D),
            ∀ x : TensorProduct ↥E ↥L' C,
              Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥E ↥L' k) (AlgHom.id ↥E D) (α x) =
                e (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥E ↥L' k) (AlgHom.id ↥E C) x) := by
      intro E _ C D _ _ _ _ _ _ e
      obtain ⟨nC, ΦC, hΦC⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹Algebra.FiniteType ↥E C›
      obtain ⟨nD, ΦD, hΦD⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹Algebra.FiniteType ↥E D›
      obtain ⟨L₁, hEL₁, hFD₁, hy₁⟩ := hTensorSupport E D
        (fun a : ULift.{u} (Fin nC) => e (Algebra.TensorProduct.includeRight (ΦC (MvPolynomial.X a.down))))
      obtain ⟨L₂, hEL₂, hFD₂, hz₂⟩ := hTensorSupport E C
        (fun b : ULift.{u} (Fin nD) => e.symm (Algebra.TensorProduct.includeRight (ΦD (MvPolynomial.X b.down))))
      let L' : IntermediateField F k := L₁ ⊔ L₂
      have hEL' : E ≤ L' := le_trans hEL₁ le_sup_left
      haveI : FiniteDimensional F ↥L₁ := hFD₁
      haveI : FiniteDimensional F ↥L₂ := hFD₂
      haveI : FiniteDimensional F ↥L' := IntermediateField.finiteDimensional_sup L₁ L₂
      letI : Algebra ↥E ↥L₁ := (IntermediateField.inclusion hEL₁).toRingHom.toAlgebra
      letI : Algebra ↥E ↥L₂ := (IntermediateField.inclusion hEL₂).toRingHom.toAlgebra
      letI : Algebra ↥E ↥L' := (IntermediateField.inclusion hEL').toRingHom.toAlgebra
      letI : Algebra ↥L₁ ↥L' := (IntermediateField.inclusion (le_sup_left : L₁ ≤ L')).toRingHom.toAlgebra
      letI : Algebra ↥L₂ ↥L' := (IntermediateField.inclusion (le_sup_right : L₂ ≤ L')).toRingHom.toAlgebra
      haveI : IsScalarTower ↥E ↥L₁ ↥L' := IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : IsScalarTower ↥E ↥L₂ ↥L' := IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : IsScalarTower ↥E ↥L₁ k := IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : IsScalarTower ↥E ↥L₂ k := IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : IsScalarTower ↥E ↥L' k := IsScalarTower.of_algebraMap_eq fun _ => rfl
      have hy' : ∀ a : Fin nC, ∃ y : TensorProduct ↥E ↥L' D,
          Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥E ↥L' k) (AlgHom.id ↥E D) y =
            e (Algebra.TensorProduct.includeRight (ΦC (MvPolynomial.X a))) := by
        intro a
        obtain ⟨y₁, hy₁a⟩ := hy₁ ⟨a⟩
        refine ⟨Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥E ↥L₁ ↥L') (AlgHom.id ↥E D) y₁, ?_⟩
        rw [← hy₁a]; clear hy₁a
        induction y₁ using TensorProduct.induction_on with
        | zero => simp
        | tmul l d₀ => rfl
        | add u v hu hv => simp only [map_add, hu, hv]
      have hz' : ∀ b : Fin nD, ∃ z : TensorProduct ↥E ↥L' C,
          Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥E ↥L' k) (AlgHom.id ↥E C) z =
            e.symm (Algebra.TensorProduct.includeRight (ΦD (MvPolynomial.X b))) := by
        intro b
        obtain ⟨z₂, hz₂b⟩ := hz₂ ⟨b⟩
        refine ⟨Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥E ↥L₂ ↥L') (AlgHom.id ↥E C) z₂, ?_⟩
        rw [← hz₂b]; clear hz₂b
        induction z₂ using TensorProduct.induction_on with
        | zero => simp
        | tmul l c₀ => rfl
        | add u v hu hv => simp only [map_add, hu, hv]
      choose yL hyL using hy'
      choose zL hzL using hz'
      have hLiftHom : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra ↥E A] [Algebra ↥E B]
          (n : ℕ) (Φ : MvPolynomial (Fin n) ↥E →ₐ[↥E] A) (hΦ : Function.Surjective Φ)
          (f_k : TensorProduct ↥E k A →ₐ[k] TensorProduct ↥E k B)
          (w : Fin n → TensorProduct ↥E ↥L' B)
          (hw : ∀ a : Fin n, Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥E ↥L' k) (AlgHom.id ↥E B) (w a) =
            f_k (Algebra.TensorProduct.includeRight (Φ (MvPolynomial.X a)))),
          ∃ (ψ : TensorProduct ↥E ↥L' A →ₐ[↥L'] TensorProduct ↥E ↥L' B),
            ∀ x : TensorProduct ↥E ↥L' A,
              Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥E ↥L' k) (AlgHom.id ↥E B) (ψ x) =
                f_k (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥E ↥L' k) (AlgHom.id ↥E A) x) := by
        intro A B _ _ _ _ n Φ hΦ f_k w hw
        let ιA := Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥E ↥L' k) (AlgHom.id ↥E A)
        let ιB := Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥E ↥L' k) (AlgHom.id ↥E B)
        have hInjB : Function.Injective ιB := hTensorInj ↥E ↥L' k B
        let θ : MvPolynomial (Fin n) ↥E →ₐ[↥E] TensorProduct ↥E ↥L' B := MvPolynomial.aeval w
        have hθ_comp : ιB.comp θ = ((f_k.restrictScalars ↥E).comp Algebra.TensorProduct.includeRight).comp Φ := by
          apply MvPolynomial.algHom_ext
          intro a
          change ιB (MvPolynomial.aeval w (MvPolynomial.X a)) =
            f_k (Algebra.TensorProduct.includeRight (Φ (MvPolynomial.X a)))
          rw [MvPolynomial.aeval_X]
          exact hw a
        have hθ : ∀ P, ιB (θ P) = f_k (Algebra.TensorProduct.includeRight (Φ P)) :=
          fun P => AlgHom.congr_fun hθ_comp P
        let sec := Function.surjInv hΦ
        have hsec : ∀ P, θ (sec (Φ P)) = θ P := by
          intro P
          apply hInjB
          rw [hθ, hθ, Function.surjInv_eq hΦ (Φ P)]
        let ψ₀ : A →ₐ[↥E] TensorProduct ↥E ↥L' B :=
          { toFun := fun a => θ (sec a)
            map_one' := by rw [← map_one Φ, hsec, map_one θ]
            map_mul' := fun x y => by
              obtain ⟨px, rfl⟩ := hΦ x; obtain ⟨py, rfl⟩ := hΦ y
              rw [← map_mul, hsec, hsec, hsec, map_mul]
            map_zero' := by rw [← map_zero Φ, hsec, map_zero θ]
            map_add' := fun x y => by
              obtain ⟨px, rfl⟩ := hΦ x; obtain ⟨py, rfl⟩ := hΦ y
              rw [← map_add, hsec, hsec, hsec, map_add]
            commutes' := fun r => by
              rw [← Φ.commutes r, hsec, θ.commutes r] }
        have hψ₀ : ∀ a : A, ιB (ψ₀ a) = f_k (Algebra.TensorProduct.includeRight a) := by
          intro a
          obtain ⟨p, rfl⟩ := hΦ a
          change ιB (θ (sec (Φ p))) = _
          rw [hsec, hθ]
        let ψ : TensorProduct ↥E ↥L' A →ₐ[↥L'] TensorProduct ↥E ↥L' B :=
          Algebra.TensorProduct.lift (Algebra.ofId ↥L' (TensorProduct ↥E ↥L' B)) ψ₀ (fun _ _ => Commute.all _ _)
        refine ⟨ψ, ?_⟩
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul l a =>
          have hl : ψ (l ⊗ₜ[↥E] a) = algebraMap ↥L' (TensorProduct ↥E ↥L' B) l * ψ₀ a :=
            Algebra.TensorProduct.lift_tmul (Algebra.ofId ↥L' _) ψ₀ _ l a
          rw [hl, map_mul, hψ₀ a]
          have h1 : ιB (algebraMap ↥L' (TensorProduct ↥E ↥L' B) l) =
              algebraMap k (TensorProduct ↥E k B) (algebraMap ↥L' k l) := rfl
          have h2 : ιA (l ⊗ₜ[↥E] a) =
              algebraMap k (TensorProduct ↥E k A) (algebraMap ↥L' k l) *
                Algebra.TensorProduct.includeRight a := by
            change (algebraMap ↥L' k l) ⊗ₜ[↥E] a = ((algebraMap ↥L' k l) ⊗ₜ[↥E] (1 : A)) * ((1 : k) ⊗ₜ[↥E] a)
            simp
          rw [h1, h2, map_mul, f_k.commutes]
        | add x₁ x₂ ih₁ ih₂ =>
          simp only [map_add, ih₁, ih₂]
      obtain ⟨α₁, hα₁⟩ := hLiftHom C D nC ΦC hΦC e.toAlgHom yL hyL
      obtain ⟨β₁, hβ₁⟩ := hLiftHom D C nD ΦD hΦD e.symm.toAlgHom zL hzL
      have hInjC : Function.Injective (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥E ↥L' k) (AlgHom.id ↥E C)) :=
        hTensorInj ↥E ↥L' k C
      have hInjD : Function.Injective (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥E ↥L' k) (AlgHom.id ↥E D)) :=
        hTensorInj ↥E ↥L' k D
      have hβα : β₁.comp α₁ = AlgHom.id ↥L' _ := by
        ext x; apply hInjC; simp [hβ₁, hα₁]
      have hαβ : α₁.comp β₁ = AlgHom.id ↥L' _ := by
        ext y; apply hInjD; simp [hα₁, hβ₁]
      exact ⟨L', hEL', inferInstance, AlgEquiv.ofAlgHom α₁ β₁ hαβ hβα, hα₁⟩
    have hEnlargeStdSmooth : ∀ (E : IntermediateField F k) [FiniteDimensional F ↥E]
        (S : Type u) [CommRing S] [Algebra ↥E S] [Algebra.FiniteType ↥E S],
        Algebra.IsStandardSmoothOfRelativeDimension d k (TensorProduct ↥E k S) →
        ∃ (L' : IntermediateField F k) (hEL' : E ≤ L') (_ : FiniteDimensional F ↥L'),
          letI : Algebra ↥E ↥L' := (IntermediateField.inclusion hEL').toRingHom.toAlgebra
