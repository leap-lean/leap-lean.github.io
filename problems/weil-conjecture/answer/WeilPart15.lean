    let ψ_fun : ∀ (U : S.Etale), LocallyConstant ↥U.left ↥A → ↥(F_ℓ.obj.obj (Opposite.op U)) :=
      fun U s => (hF_type.isSheafFor _ (hLevel_mem U s)).amalgamate (levelFam U s) (hLevelFam U s)
    have hψ_spec : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left ↥A)
