      hom_inv_id := by
        apply CategoryTheory.NatTrans.ext
        funext U
        apply CategoryTheory.MorphismProperty.Comma.Hom.ext
        · change CategoryTheory.Limits.pullback.fst U.hom (𝟙 Z) ≫
              CategoryTheory.Limits.pullback.lift (𝟙 U.left) U.hom (by simp) =
            𝟙 (CategoryTheory.Limits.pullback U.hom (𝟙 Z))
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
            exact (CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm
