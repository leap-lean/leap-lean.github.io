            rw [hcomp, P.map_comp]
            simp only [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
          · exact ((Limits.isZero_zero A).of_iso (eqToIso (dif_neg h₃))).eq_of_src _ _ }
    let j_pre : (W.toScheme.Etaleᵒᵖ ⥤ A) ⥤ (Z.Etaleᵒᵖ ⥤ A) :=
