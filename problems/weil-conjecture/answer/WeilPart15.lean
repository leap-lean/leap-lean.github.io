        have htu_pt : t_lc ((f_x u).left.base (y_x u)) = s_fun u :=
          congrFun (congrArg DFunLike.coe htu) (y_x u)
        exact (congrArg t_lc (hy_x u)).symm.trans htu_pt
    let L_sh : Sheaf J AddCommGrpCat.{u} := ⟨L_pre, hL_sheaf⟩
    let adj := constantSheafAdj J AddCommGrpCat.{u} hT
    let η : A ⟶ F_ℓ.obj.obj (Opposite.op T_S) := adj.unit.app A
    let c_hom : A ⟶ L_sh.obj.obj (Opposite.op T_S) :=
      AddCommGrpCat.ofHom (LocallyConstant.constAddMonoidHom (X := ↥T_S.left) (Y := ↥A))
    let Φ : F_ℓ ⟶ L_sh := (adj.homEquiv A L_sh).symm c_hom
    have hηΦ : η ≫ Φ.hom.app (Opposite.op T_S) = c_hom := by
      change adj.homEquiv A L_sh Φ = c_hom
      exact (adj.homEquiv A L_sh).apply_symm_apply c_hom
