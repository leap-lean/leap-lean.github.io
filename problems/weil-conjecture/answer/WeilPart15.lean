      (ℋ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      {M₀ : AddCommGrpCat.{u}} {V₁ V₂ : Z.Etale} (e : V₁ ≅ V₂),
      (∀ (φ : ℋ.obj.obj (Opposite.op V₂) ⟶ M₀),
        ℋ.obj.map e.hom.op ≫ (ℋ.obj.map e.inv.op ≫ φ) = φ) ∧
      (∀ (ψ : ℋ.obj.obj (Opposite.op V₁) ⟶ M₀),
