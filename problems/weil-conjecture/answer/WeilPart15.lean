        let v_x : R_obj i →ₐ[R₀] S_x := IsScalarTower.toAlgHom R₀ (R_obj i) S_x
        have hv_et : v_x.toRingHom.Etale := RingHom.etale_algebraMap.mpr hEt_loc
        have h_symm_et : θ.symm.toRingHom.Etale := RingHom.Etale.of_bijective θ.symm.bijective
        let f_ij : i ⟶ j :=
          ⟨θ.symm.toAlgHom.comp v_x,
            RingHom.Etale.stableUnderComposition _ _ hv_et h_symm_et,
            RingHom.ext fun y => by
              change pt j (θ.symm (algebraMap (R_obj i) S_x y)) = pt i y
              rw [hpt_j]
              change ψ_x (θ (θ.symm (algebraMap (R_obj i) S_x y))) = pt i y
              rw [θ.apply_symm_apply]
