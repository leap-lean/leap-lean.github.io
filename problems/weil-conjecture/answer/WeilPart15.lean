          have hz₂ : (g₂ ≫ f₂).left.base z = (levelV U s a₂).ι.base ((g₂ ≫ h₂).left.base z) :=
            congrArg (fun k : Y₂ ⟶ U => k.left.base (g₂.left.base z)) hh₂
