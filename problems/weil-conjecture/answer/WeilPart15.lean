          ↑(u_sch.presheaf.stalk pt_yz.1) _ _ hloc_yz hp_le
      let ga := (U.left.presheaf.germ V₀ y_z.1 hy_V₀).hom a₀
      have hga0 : e_stalk U V₀ y_z.1 hy_V₀ ga ≠ 0 := fun h0 =>
        ha₀_ne (hInj_germ ((e_stalk U V₀ y_z.1 hy_V₀).injective (h0.trans (map_zero _).symm) |>.trans
          (map_zero _).symm))
      let u_ev := Units.map
        (evRing (W_open U V₀) y_z'.1 (hDVR_et (W_open U V₀) y_z').choose
          (hInj_stalk (W_open U V₀) y_z')).toMonoidHom u_a
      have hsa_ev : u_ev.val * algebraMap _ _ (1 : ↑((W_open U V₀).left.presheaf.stalk y_z'.1)) =
          algebraMap _ _ (e_stalk U V₀ y_z.1 hy_V₀ ga) := by
        rw [map_one, mul_one]
        exact hev_open U V₀ y_z hy_V₀ a₀
      have hdiv_sa : div_val (W_open U V₀) s_a y_z' = ord_at (W_open U V₀) y_z' (Additive.ofMul u_ev) := by
        change ord_at (W_open U V₀) y_z'
          (MonoidHom.toAdditive (Units.map _) (eK (W_open U V₀) s_a)) = _
        rw [(eK (W_open U V₀)).apply_symm_apply]
        rfl
      by_cases hy_eq : y_z = y₀
      · let y₀' : { w : ↥(W_open U V₀).left // IsClosed ({(W_open U V₀).hom.base w} : Set ↥X) } :=
          ⟨⟨u₀, hu₀⟩, hu_cl⟩
        have hyz'_eq : y_z' = y₀' :=
          Subtype.ext (Subtype.ext
            (congrArg (fun p : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥X) } => p.1) hy_eq))
        have : IsDomain ↑((W_open U V₀).left.presheaf.stalk y₀'.1) :=
          (hDVR_et (W_open U V₀) y₀').choose
        have : IsDiscreteValuationRing ↑((W_open U V₀).left.presheaf.stalk y₀'.1) :=
          (hDVR_et (W_open U V₀) y₀').choose_spec
        let ga₀ := (U.left.presheaf.germ V₀ u₀ hu₀).hom a₀
        have hInj_germ₀ : Function.Injective (u_sch.presheaf.germ v_open pt₀.1 pt₀.2).hom :=
          @IsLocalization.injective _ _ (hV₀_sch.primeIdealOf pt₀).asIdeal.primeCompl
            ↑(u_sch.presheaf.stalk pt₀.1) _ _ hloc₀
            (fun _ hx => mem_nonZeroDivisors_iff_ne_zero.mpr fun h0 =>
              hx (h0 ▸ (hV₀_sch.primeIdealOf pt₀).asIdeal.zero_mem))
        have hga₀0 : e_stalk U V₀ u₀ hu₀ ga₀ ≠ 0 := fun h0 =>
          ha₀_ne (hInj_germ₀ ((e_stalk U V₀ u₀ hu₀).injective (h0.trans (map_zero _).symm) |>.trans
            (map_zero _).symm))
        let u_ev₀ := Units.map
          (evRing (W_open U V₀) y₀'.1 (hDVR_et (W_open U V₀) y₀').choose
            (hInj_stalk (W_open U V₀) y₀')).toMonoidHom u_a
        have hsa_ev₀ : u_ev₀.val *
            algebraMap _ _ (1 : ↑((W_open U V₀).left.presheaf.stalk y₀'.1)) =
            algebraMap _ _ (e_stalk U V₀ u₀ hu₀ ga₀) := by
          rw [map_one, mul_one]
          exact hev_open U V₀ y₀ hu₀ a₀
        have hdiv_sa₀ : div_val (W_open U V₀) s_a y₀' =
            ord_at (W_open U V₀) y₀' (Additive.ofMul u_ev₀) := by
          change ord_at (W_open U V₀) y₀'
            (MonoidHom.toAdditive (Units.map _) (eK (W_open U V₀) s_a)) = _
          rw [(eK (W_open U V₀)).apply_symm_apply]
          rfl
        have hspan' : Ideal.span ({e_stalk U V₀ u₀ hu₀ ga₀} :
            Set ↑((W_open U V₀).left.presheaf.stalk y₀'.1)) =
            IsLocalRing.maximalIdeal ↑((W_open U V₀).left.presheaf.stalk y₀'.1) :=
          he_span_max U V₀ y₀ hu₀ ga₀ ha₀_span
        have h1 := ((ord_pkg (W_open U V₀) y₀').choose_spec.2.2.1 u_ev₀
          (e_stalk U V₀ u₀ hu₀ ga₀) 1 hga₀0 one_ne_zero hsa_ev₀).2.2 hspan' rfl
        have hD_eq : D_div y_z = m₀ := congrArg D_div hy_eq
        change m₀ * div_val (W_open U V₀) s_a y_z' = D_div y_z
        rw [hyz'_eq, hdiv_sa₀, h1, mul_one, hD_eq]
      · have hnot_bad : y_z ∉ F_bad := by
          intro hmem
          have h := Set.mem_iInter₂.mp hy_Obad y_z hmem
          exact h.2 rfl
        have hnot_FD : y_z ∉ F_D := fun hFD => hnot_bad ⟨Or.inl hFD, hy_eq⟩
        have hnot_Fa : y_z ∉ F_a := fun hFa => hnot_bad ⟨Or.inr hFa, hy_eq⟩
        have hD0 : D_div y_z = 0 := by
          by_contra hne
          exact hnot_FD ⟨hy_fin, hne⟩
        have hga_nm : e_stalk U V₀ y_z.1 hy_V₀ ga ∉
            IsLocalRing.maximalIdeal ↑((W_open U V₀).left.presheaf.stalk y_z'.1) := by
          have hm_iff := he_mem_max U V₀ y_z hy_V₀ ga
          dsimp only at hm_iff
          rw [hm_iff]
          exact fun hmem => hnot_Fa ⟨hy_V₀, hmem⟩
        have h1_nm : (1 : ↑((W_open U V₀).left.presheaf.stalk y_z'.1)) ∉
            IsLocalRing.maximalIdeal ↑((W_open U V₀).left.presheaf.stalk y_z'.1) := by
          rw [IsLocalRing.notMem_maximalIdeal]
          exact isUnit_one
        have h0 := ((ord_pkg (W_open U V₀) y_z').choose_spec.2.2.1 u_ev
          (e_stalk U V₀ y_z.1 hy_V₀ ga) 1 hga0 one_ne_zero hsa_ev).2.1 hga_nm h1_nm
        rw [hdiv_sa, h0, mul_zero, hD0]
    · let O_D : Set ↥U.left := ⋂ y ∈ F_D, ((V₀ : Set ↥U.left) \ {y.1})
      have hO_D : IsOpen O_D := hF_D.isOpen_biInter fun y _ => hOpenCompl y
      have hu₀_OD : u₀ ∈ O_D := by
        rw [Set.mem_iInter₂]
        intro y _
        refine ⟨hu₀, fun heq => hu_cl (heq ▸ y.2)⟩
      let V : U.left.Opens :=
        ⟨((V₀ : Set ↥U.left) ∩ (V_fin : Set ↥U.left)) ∩ O_D,
          (V₀.isOpen.inter V_fin.isOpen).inter hO_D⟩
      refine ⟨V, ⟨⟨hu₀, hu_fin⟩, hu₀_OD⟩, ?_⟩
      intro W_V j_V
      refine ⟨0, fun z => ?_⟩
      rw [map_zero, Pi.zero_apply]
      let y_z : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥X) } :=
        ⟨j_V.left.base z.1, by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.MorphismProperty.Over.w j_V]
          exact z.2⟩
      have hy_fin : y_z.1 ∈ V_fin := z.1.2.1.2
      have hy_OD : y_z.1 ∈ O_D := z.1.2.2
      symm
      by_contra hne
      have h := Set.mem_iInter₂.mp hy_OD y_z ⟨hy_fin, hne⟩
      exact h.2 rfl
  · have hTC_both : ∀ (s : ↥((weilEtaleKPresheaf X).obj (Opposite.op T_C)))
        (f : Units ↑X.functionField),
        e_TC (Additive.toMul (eK T_C s)) = f →
        ∀ x : { x : ↥X // IsClosed ({x} : Set ↥X) },
          let Rx := ↑(X.presheaf.stalk x.1)
          let mx := IsLocalRing.maximalIdeal Rx
          ∃ (a b : Rx) (na nb : ℕ),
            a ≠ 0 ∧ b ≠ 0 ∧
            algebraMap Rx ↑X.functionField a =
              (f : ↑X.functionField) * algebraMap Rx ↑X.functionField b ∧
            Ideal.span ({a} : Set Rx) = mx ^ na ∧
            Ideal.span ({b} : Set Rx) = mx ^ nb ∧
            div_val T_C s ⟨x.1, x.2⟩ = (na : ℤ) - (nb : ℤ) := by
      intro s f hsf x Rx mx
      let x_TC : { y : ↥T_C.left // IsClosed ({T_C.hom.base y} : Set ↥X) } := ⟨x.1, x.2⟩
      have : IsDomain Rx := (hDVR_et T_C x_TC).choose
      have : IsDiscreteValuationRing Rx := (hDVR_et T_C x_TC).choose_spec
      obtain ⟨a, b, na, nb, ha, hb, hab, hsa, hsb, _⟩ :=
        (hOrdDVR Rx ↑X.functionField).choose_spec.1 f
      obtain ⟨φ_tx, hφ_alg, hφ_ev⟩ :=
        hTC_ev x.1 (hDVR_et T_C x_TC).choose (hInj_stalk T_C x_TC)
      let u_raw := Additive.toMul (eK T_C s)
      let u_x : Units (FractionRing Rx) := Units.map
        (evRing T_C x.1 (hDVR_et T_C x_TC).choose (hInj_stalk T_C x_TC)).toMonoidHom u_raw
      have hab_frac : algebraMap Rx (FractionRing Rx) a =
          (u_x : FractionRing Rx) * algebraMap Rx (FractionRing Rx) b := by
        have h := congrArg φ_tx hab
        rw [hφ_alg a, map_mul, hφ_alg b] at h
        have hu_eq : (u_x : FractionRing Rx) = φ_tx (f : ↑X.functionField) := by
          have hev := congrArg Units.val (hφ_ev u_raw)
          rw [hsf] at hev
          exact hev
        rw [hu_eq]
        exact h
      have hord_x := (ord_pkg T_C x_TC).choose_spec.2.1 u_x a b na nb ha hb hab_frac hsa hsb
      exact ⟨a, b, na, nb, ha, hb, hab, hsa, hsb, hord_x⟩
    exact ⟨fun s => ⟨e_TC (Additive.toMul (eK T_C s)), hTC_both s _ rfl⟩,
      fun f => ⟨(eK T_C).symm (Additive.ofMul (e_TC.symm f)),
        hTC_both _ f (by simp)⟩⟩

theorem weil_etale_curve_weil_divisor_short_exact (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left] [CompactSpace ↥C.left] [C.left.IsSeparated]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (hGmSheaf : ∀ X : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilEtaleGmPresheaf X)) :
    CategoryTheory.Presheaf.IsSheaf C.left.smallEtaleTopology (weilEtaleKPresheaf C.left) ∧
    ∃ (Div_sh : CategoryTheory.Sheaf C.left.smallEtaleTopology AddCommGrpCat.{u})
      (ι_gm : weilEtaleGmSheaf C.left ⟶ weilEtaleKSheaf C.left)
      (div_mor : weilEtaleKSheaf C.left ⟶ Div_sh)
      (h0 : ι_gm ≫ div_mor = 0)
      (valDiv : ∀ U : C.left.Etale,
        ↥(Div_sh.obj.obj (Opposite.op U)) →+
          ({ y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) } → ℤ)),
      (CategoryTheory.ShortComplex.mk ι_gm div_mor h0).ShortExact ∧
      (∀ U : C.left.Etale,
        Function.Injective (valDiv U) ∧
        (CompactSpace ↥U.left → Set.range (valDiv U) = { D | { y | D y ≠ 0 }.Finite })) ∧
      (∀ {U₁ U₂ : C.left.Etale} (g : U₁ ⟶ U₂)
          (d : ↥(Div_sh.obj.obj (Opposite.op U₂)))
          (y₁ : { y : ↥U₁.left // IsClosed ({U₁.hom.base y} : Set ↥C.left) }),
        valDiv U₁ ((Div_sh.obj.map g.op).hom d) y₁ =
          valDiv U₂ d ⟨g.left.base y₁.1, by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.MorphismProperty.Over.w g]
            exact y₁.2⟩) ∧
      Nonempty ((Div_sh.H 0 ⧸
        ((CategoryTheory.Abelian.Ext.mk₀ div_mor).postcomp
          ((CategoryTheory.constantSheaf C.left.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ)))
          (Nat.add_zero 0)).range) ≃+ weilCurveClGroup C.left) :=
by
  classical
  have : AlgebraicGeometry.LocallyOfFiniteType C.hom := by
    have hcov := (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 C.hom).mp inferInstance
    choose U_x _ V_x hV_x hx_mem e_x h_x using hcov
    let V_aff : ↥C.left → C.left.affineOpens := fun x => ⟨V_x x, hV_x x⟩
    have hV_top : (⨆ x : ↥C.left, (V_aff x).1) = ⊤ :=
      eq_top_iff.mpr fun x _ => le_iSup (fun y : ↥C.left => (V_aff y).1) x (hx_mem x)
    refine AlgebraicGeometry.HasRingHomProperty.of_iSup_eq_top
      (P := @AlgebraicGeometry.LocallyOfFiniteType) V_aff hV_top fun x => ?_
    have hU_top : U_x x = ⊤ := by
      ext u
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      rw [Subsingleton.elim u (C.hom.base x)]
      exact e_x x (hx_mem x)
    exact (AlgebraicGeometry.Scheme.Hom.appLE_congr C.hom (e_x x) hU_top rfl
      (fun φ => φ.hom.FiniteType)).mp
      (RingHom.FiniteType.of_finitePresentation
        (RingHom.smooth_def.mp (h_x x).isStandardSmooth.smooth).2)
  have hDim : topologicalKrullDim C.left = (1 : WithBot ℕ∞) := by
    simpa using weil_smooth_integral_krullDim_over_field k 1 C inferInstance
  obtain ⟨hKSheaf, hH0Quot⟩ := weil_etale_generic_gm_isSheaf_and_H0_quot C.left hGmSheaf
  obtain ⟨Div_sh, valDiv, hValInj, hValRangeLoc, hValRangeComp, hValNat⟩ :=
    weil_etale_separated_locFinite_closedFiber_sheaf k C
  obtain ⟨hStrict_C, hDVR_et, hUnram, hChart⟩ :=
    weil_smooth_curve_etale_stalk_dvr_and_domain_chart k C hDim
  obtain ⟨ι_pre, div_val, hDivNat, hDivLoc, hDivEx, hDivSurj, hTC_fwd, hTC_bwd⟩ :=
    weil_etale_curve_generic_divisor_presheaf_exact k C hDVR_et hUnram hChart
  refine ⟨hKSheaf, ?_⟩
  have hmem_div : ∀ (U : C.left.Etale)
      (s : ↥((weilEtaleKPresheaf C.left).obj (Opposite.op U))),
      div_val U s ∈ Set.range (valDiv U) := by
    intro U s
    rw [hValRangeLoc U]
    exact hDivLoc U s
  let div_pre_fun : ∀ (U : C.left.Etale),
      ↥((weilEtaleKPresheaf C.left).obj (Opposite.op U)) →
        ↥(Div_sh.obj.obj (Opposite.op U)) :=
    fun U s => (hmem_div U s).choose
  have hdiv_pre_spec : ∀ (U : C.left.Etale)
      (s : ↥((weilEtaleKPresheaf C.left).obj (Opposite.op U))),
      valDiv U (div_pre_fun U s) = div_val U s :=
    fun U s => (hmem_div U s).choose_spec
  let div_pre_hom : ∀ (U : C.left.Etale),
      ↥((weilEtaleKPresheaf C.left).obj (Opposite.op U)) →+
        ↥(Div_sh.obj.obj (Opposite.op U)) :=
    fun U =>
      { toFun := div_pre_fun U
        map_zero' := hValInj U (by rw [hdiv_pre_spec, map_zero, map_zero])
        map_add' := fun s₁ s₂ =>
          hValInj U (by rw [hdiv_pre_spec, map_add, map_add, hdiv_pre_spec, hdiv_pre_spec]) }
  let div_pre : weilEtaleKPresheaf C.left ⟶ Div_sh.obj :=
    { app := fun U => AddCommGrpCat.ofHom (div_pre_hom (Opposite.unop U))
      naturality := fun U₂ U₁ f => by
        apply AddCommGrpCat.ext
        intro s
        apply hValInj (Opposite.unop U₁)
        ext y₁
        change valDiv (Opposite.unop U₁)
            (div_pre_fun (Opposite.unop U₁)
              (((weilEtaleKPresheaf C.left).map (Opposite.unop f).op).hom s)) y₁ =
          valDiv (Opposite.unop U₁)
            ((Div_sh.obj.map (Opposite.unop f).op).hom
              (div_pre_fun (Opposite.unop U₂) s)) y₁
        rw [hdiv_pre_spec, hDivNat (Opposite.unop f) s y₁,
          hValNat (Opposite.unop f) (div_pre_fun (Opposite.unop U₂) s) y₁, hdiv_pre_spec] }
  let J := C.left.smallEtaleTopology
  let G_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
    ⟨weilEtaleGmPresheaf C.left, hGmSheaf C.left⟩
  let K_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
    ⟨weilEtaleKPresheaf C.left, hKSheaf⟩
  let ι_sh : G_sh ⟶ K_sh := { hom := ι_pre }
  let div_sh : K_sh ⟶ Div_sh := { hom := div_pre }
  have h0_sh : ι_sh ≫ div_sh = 0 := by
    apply CategoryTheory.Sheaf.hom_ext
    ext U : 2
    apply AddCommGrpCat.ext
    intro u
    apply hValInj (Opposite.unop U)
    change valDiv (Opposite.unop U)
        (div_pre_fun (Opposite.unop U) ((ι_pre.app (Opposite.op (Opposite.unop U))).hom u)) =
      valDiv (Opposite.unop U) 0
    rw [hdiv_pre_spec, (hDivEx (Opposite.unop U)).2.1 u, map_zero]
  have : CategoryTheory.Mono ι_sh := by
    refine ⟨fun {W'} α₁ α₂ hα => ?_⟩
    apply CategoryTheory.Sheaf.hom_ext
    ext U : 2
    apply AddCommGrpCat.ext
    intro w
    apply (hDivEx (Opposite.unop U)).1
    exact congrArg (fun φ : W' ⟶ K_sh => (φ.hom.app U).hom w) hα
  have hmem_lift : ∀ {W' : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (k_mor : W' ⟶ K_sh), k_mor ≫ div_sh = 0 →
      ∀ (U : C.left.Etale) (w : ↥(W'.obj.obj (Opposite.op U))),
        (k_mor.hom.app (Opposite.op U)).hom w ∈
          Set.range (ι_pre.app (Opposite.op U)).hom := by
    intro W' k_mor hk U w
    apply (hDivEx U).2.2
    have hk0 : div_pre_fun U ((k_mor.hom.app (Opposite.op U)).hom w) = 0 :=
      congrArg (fun φ : W' ⟶ Div_sh => (φ.hom.app (Opposite.op U)).hom w) hk
    rw [← hdiv_pre_spec U, hk0, map_zero]
  let lift_sh : ∀ {W' : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (k_mor : W' ⟶ K_sh), k_mor ≫ div_sh = 0 → (W' ⟶ G_sh) := fun {W'} k_mor hk =>
    let lift_fun : ∀ (U : C.left.Etale),
        ↥(W'.obj.obj (Opposite.op U)) →
          ↥((weilEtaleGmPresheaf C.left).obj (Opposite.op U)) :=
      fun U w => (hmem_lift k_mor hk U w).choose
    have hlift_spec : ∀ (U : C.left.Etale) (w : ↥(W'.obj.obj (Opposite.op U))),
        (ι_pre.app (Opposite.op U)).hom (lift_fun U w) =
          (k_mor.hom.app (Opposite.op U)).hom w :=
      fun U w => (hmem_lift k_mor hk U w).choose_spec
    let lift_hom : ∀ (U : C.left.Etale),
        ↥(W'.obj.obj (Opposite.op U)) →+
          ↥((weilEtaleGmPresheaf C.left).obj (Opposite.op U)) := fun U =>
      { toFun := lift_fun U
        map_zero' := (hDivEx U).1 (by rw [hlift_spec U 0, map_zero, map_zero])
        map_add' := fun w₁ w₂ => (hDivEx U).1 (by
          rw [hlift_spec U (w₁ + w₂), map_add, map_add, hlift_spec U w₁, hlift_spec U w₂]) }
    { hom :=
        { app := fun U => AddCommGrpCat.ofHom (lift_hom (Opposite.unop U))
          naturality := fun U₂ U₁ f => by
            let V₁ := Opposite.unop U₁
            let V₂ := Opposite.unop U₂
            let g : V₁ ⟶ V₂ := Opposite.unop f
            apply AddCommGrpCat.ext
            intro w
            apply (hDivEx V₁).1
            have h₁ := congrArg (fun ψ => ψ.hom (lift_fun V₂ w)) (ι_pre.naturality g.op)
            have h₂ := congrArg (fun ψ => ψ.hom w) (k_mor.hom.naturality g.op)
            change (ι_pre.app (Opposite.op V₁)).hom
                (((weilEtaleGmPresheaf C.left).map g.op).hom (lift_fun V₂ w)) =
              ((weilEtaleKPresheaf C.left).map g.op).hom
                ((ι_pre.app (Opposite.op V₂)).hom (lift_fun V₂ w)) at h₁
            change (k_mor.hom.app (Opposite.op V₁)).hom ((W'.obj.map g.op).hom w) =
              ((weilEtaleKPresheaf C.left).map g.op).hom
                ((k_mor.hom.app (Opposite.op V₂)).hom w) at h₂
            change (ι_pre.app (Opposite.op V₁)).hom (lift_fun V₁ ((W'.obj.map g.op).hom w)) =
              (ι_pre.app (Opposite.op V₁)).hom
                (((weilEtaleGmPresheaf C.left).map g.op).hom (lift_fun V₂ w))
            rw [hlift_spec V₁, h₂, h₁, hlift_spec V₂] } }
  have hlift_fac : ∀ {W' : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (k_mor : W' ⟶ K_sh) (hk : k_mor ≫ div_sh = 0),
      lift_sh k_mor hk ≫ ι_sh = k_mor := by
    intro W' k_mor hk
    apply CategoryTheory.Sheaf.hom_ext
    ext U : 2
    apply AddCommGrpCat.ext
    intro w
    exact (hmem_lift k_mor hk (Opposite.unop U) w).choose_spec
  have hExact_sh : (CategoryTheory.ShortComplex.mk ι_sh div_sh h0_sh).Exact := by
    apply CategoryTheory.ShortComplex.exact_of_f_is_kernel
    exact CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
      (fun k_mor hk => lift_sh k_mor hk)
      (fun k_mor hk => hlift_fac k_mor hk)
      (fun k_mor hk m hm => (cancel_mono ι_sh).mp (hm.trans (hlift_fac k_mor hk).symm))
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have hMemJ : ∀ (U : C.left.Etale) (R : CategoryTheory.Sieve U),
      R ∈ J U ↔ ∀ x : ↥U.left, ∃ (Y : C.left.Etale) (f : Y ⟶ U) (y : ↥Y.left),
        R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro U R
    have hJ_eq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) C.left le_rfl
    exact (Eq.to_iff
      (congrArg (fun G : CategoryTheory.GrothendieckTopology (P_et.Over ⊤ C.left) => R ∈ G U) hJ_eq)).trans
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U R)
  have : CategoryTheory.Epi div_sh := by
    refine ⟨fun {F} α₁ α₂ hα => ?_⟩
    have hF_type : CategoryTheory.Presheaf.IsSheaf J
        (F.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J F.obj
        (CategoryTheory.forget AddCommGrpCat.{u}) F.property
    apply CategoryTheory.Sheaf.hom_ext
    ext U_op : 2
    let U := Opposite.unop U_op
    apply AddCommGrpCat.ext
    intro d
    have hd_loc : ∀ u : ↥U.left, ∃ V : U.left.Opens, u ∈ V ∧
        { y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) } |
          y.1 ∈ V ∧ valDiv U d y ≠ 0 }.Finite := by
      have hd_mem : valDiv U d ∈ Set.range (valDiv U) := ⟨d, rfl⟩
      rwa [hValRangeLoc U] at hd_mem
    have hex_u := hDivSurj U (valDiv U d) hd_loc
    choose V_u hu_mem s_u hs_u using hex_u
    let W_u : ↥U.left → C.left.Etale := fun u =>
      CategoryTheory.MorphismProperty.Over.mk ⊤ ((V_u u).ι ≫ U.hom)
        (by have : AlgebraicGeometry.Etale U.hom := U.prop; infer_instance)
    let j_u : ∀ u : ↥U.left, W_u u ⟶ U := fun u =>
      CategoryTheory.MorphismProperty.Over.homMk (V_u u).ι rfl
    have hR_U : CategoryTheory.Sieve.ofArrows W_u j_u ∈ J U := by
      rw [hMemJ]
      intro x
      refine ⟨W_u x, j_u x, ⟨x, hu_mem x⟩,
        CategoryTheory.Sieve.ofArrows_mk W_u j_u x, ?_, rfl⟩
      change AlgebraicGeometry.Etale (V_u x).ι
      infer_instance
    apply (hF_type.isSheafFor _ hR_U).isSeparatedFor.ext
    intro Y f hf
    rcases hf with ⟨_, h, _, ⟨u⟩, rfl⟩
    have hd_pull : (Div_sh.obj.map (j_u u).op).hom d = div_pre_fun (W_u u) (s_u u) := by
      apply hValInj (W_u u)
      ext y
      rw [hValNat (j_u u) d y, hdiv_pre_spec (W_u u) (s_u u), hs_u u y]
    have hcalc : ∀ (α : Div_sh ⟶ F),
        ((F.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}).map (h ≫ j_u u).op)
          ((α.hom.app (Opposite.op U)).hom d) =
        (F.obj.map h.op).hom (((div_sh ≫ α).hom.app (Opposite.op (W_u u))).hom (s_u u)) := by
      intro α
      change ((α.hom.app (Opposite.op U) ≫ F.obj.map (h ≫ j_u u).op).hom) d = _
      rw [op_comp, F.obj.map_comp, ← CategoryTheory.Category.assoc,
        ← α.hom.naturality (j_u u).op]
      change (F.obj.map h.op).hom
        ((α.hom.app (Opposite.op (W_u u))).hom ((Div_sh.obj.map (j_u u).op).hom d)) = _
      rw [hd_pull]
      rfl
    change ((F.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}).map (h ≫ j_u u).op)
        ((α₁.hom.app (Opposite.op U)).hom d) =
      ((F.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}).map (h ≫ j_u u).op)
        ((α₂.hom.app (Opposite.op U)).hom d)
    rw [hcalc α₁, hcalc α₂, hα]
  have hSE_sh : (CategoryTheory.ShortComplex.mk ι_sh div_sh h0_sh).ShortExact :=
    { exact := hExact_sh }
  let e_G : G_sh ≅ weilEtaleGmSheaf C.left := CategoryTheory.sheafificationIso G_sh
  let e_K : K_sh ≅ weilEtaleKSheaf C.left := CategoryTheory.sheafificationIso K_sh
  let ι_gm : weilEtaleGmSheaf C.left ⟶ weilEtaleKSheaf C.left :=
    e_G.inv ≫ ι_sh ≫ e_K.hom
  let div_mor : weilEtaleKSheaf C.left ⟶ Div_sh :=
    e_K.inv ≫ div_sh
  have h0 : ι_gm ≫ div_mor = 0 := by
    dsimp [ι_gm, div_mor]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      e_K.hom_inv_id_assoc, ← CategoryTheory.Category.assoc e_G.inv ι_sh div_sh,
      CategoryTheory.Category.assoc, h0_sh, CategoryTheory.Limits.comp_zero]
  let isoSC : CategoryTheory.ShortComplex.mk ι_sh div_sh h0_sh ≅
      CategoryTheory.ShortComplex.mk ι_gm div_mor h0 :=
    CategoryTheory.ShortComplex.isoMk e_G e_K (CategoryTheory.Iso.refl Div_sh)
      (by dsimp [ι_gm]; rw [e_G.hom_inv_id_assoc])
      (by dsimp [div_mor]; rw [CategoryTheory.Category.comp_id, e_K.hom_inv_id_assoc])
  have hSE : (CategoryTheory.ShortComplex.mk ι_gm div_mor h0).ShortExact :=
    (CategoryTheory.ShortComplex.shortExact_iff_of_iso isoSC).mp hSE_sh
  refine ⟨Div_sh, ι_gm, div_mor, h0, valDiv, hSE,
    fun U => ⟨hValInj U, hValRangeComp U⟩, fun g d y₁ => hValNat g d y₁, ?_⟩
  obtain ⟨e_H0⟩ := hH0Quot hKSheaf Div_sh div_pre
  let T_C : C.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
    (CategoryTheory.CategoryStruct.id C.left)
    (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id C.left))
  let Pt := { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }
  have hRange_TC : Set.range (valDiv T_C) = { D : Pt → ℤ | { x | D x ≠ 0 }.Finite } :=
    hValRangeComp T_C (inferInstance : CompactSpace ↥C.left)
  have hd_fin : ∀ d : ↥(Div_sh.obj.obj (Opposite.op T_C)),
      { x : Pt | valDiv T_C d x ≠ 0 }.Finite := by
    intro d
    have hmem : valDiv T_C d ∈ Set.range (valDiv T_C) := ⟨d, rfl⟩
    rwa [hRange_TC] at hmem
  have hF_mem : ∀ F : Pt →₀ ℤ, (⇑F : Pt → ℤ) ∈ Set.range (valDiv T_C) := by
    intro F
    rw [hRange_TC]
    exact F.hasFiniteSupport
  let e_fin : ↥(Div_sh.obj.obj (Opposite.op T_C)) ≃+ (Pt →₀ ℤ) :=
    { toFun := fun d => Finsupp.ofSupportFinite (valDiv T_C d) (hd_fin d)
      invFun := fun F => (hF_mem F).choose
      left_inv := fun d => hValInj T_C (by
        rw [(hF_mem _).choose_spec]
        rfl)
      right_inv := fun F => Finsupp.ext fun x => congrFun (hF_mem F).choose_spec x
      map_add' := fun d₁ d₂ => Finsupp.ext fun x => by
        change valDiv T_C (d₁ + d₂) x = valDiv T_C d₁ x + valDiv T_C d₂ x
        rw [map_add]
        rfl }
  let H_im : AddSubgroup (Pt →₀ ℤ) :=
    AddSubgroup.map e_fin.toAddMonoidHom (div_pre.app (Opposite.op T_C)).hom.range
  let S_gen : Set (Pt →₀ ℤ) :=
    { D : Pt →₀ ℤ |
      ∃ f : Units ↑C.left.functionField,
        ∀ x : Pt,
          let Rx := ↑(C.left.presheaf.stalk x.1)
          let mx := IsLocalRing.maximalIdeal Rx
          ∃ (a b : Rx) (na nb : ℕ),
            a ≠ 0 ∧ b ≠ 0 ∧
            algebraMap Rx ↑C.left.functionField a =
              (f : ↑C.left.functionField) * algebraMap Rx ↑C.left.functionField b ∧
            Ideal.span ({a} : Set Rx) = mx ^ na ∧
            Ideal.span ({b} : Set Rx) = mx ^ nb ∧
            D x = (na : ℤ) - (nb : ℤ) }
  have hS_eq : S_gen = (H_im : Set (Pt →₀ ℤ)) := by
    ext D
    constructor
    · rintro ⟨f, hf⟩
      obtain ⟨s, hs⟩ := hTC_bwd f
      refine ⟨(div_pre.app (Opposite.op T_C)).hom s, ⟨s, rfl⟩, Finsupp.ext fun x => ?_⟩
      change valDiv T_C (div_pre_fun T_C s) x = D x
      rw [hdiv_pre_spec T_C s]
      obtain ⟨a, b, na, nb, _, _, hab, hspan_a, hspan_b, hDx⟩ := hf x
      obtain ⟨a', b', na', nb', _, _, hab', hspan_a', hspan_b', hsx⟩ := hs x
      let Rx := ↑(C.left.presheaf.stalk x.1)
      let mx := IsLocalRing.maximalIdeal Rx
      let K := ↑C.left.functionField
      obtain ⟨hDomRx, _⟩ := hDVR_et T_C ⟨x.1, x.2⟩
      have : IsDomain Rx := hDomRx
      have hab_K : algebraMap Rx K (a * b') = algebraMap Rx K (a' * b) := by
        rw [map_mul, map_mul, hab, hab']
        ring
      have hab_Rx : a * b' = a' * b := IsFractionRing.injective Rx K hab_K
      have hpow_eq : mx ^ (na + nb') = mx ^ (na' + nb) := by
        rw [pow_add, pow_add, ← hspan_a, ← hspan_b', ← hspan_a', ← hspan_b,
          Ideal.span_singleton_mul_span_singleton, Ideal.span_singleton_mul_span_singleton, hab_Rx]
      have hnat_eq : na + nb' = na' + nb := (hStrict_C x).injective hpow_eq
      change div_val T_C s ⟨x.1, x.2⟩ = D x
      rw [hsx, hDx]
      omega
    · rintro ⟨_, ⟨s, rfl⟩, rfl⟩
      obtain ⟨f, hf⟩ := hTC_fwd s
      refine ⟨f, fun x => ?_⟩
      obtain ⟨a, b, na, nb, ha, hb, hab, hspan_a, hspan_b, hsx⟩ := hf x
      refine ⟨a, b, na, nb, ha, hb, hab, hspan_a, hspan_b, ?_⟩
      change valDiv T_C (div_pre_fun T_C s) x = (na : ℤ) - (nb : ℤ)
      rw [hdiv_pre_spec T_C s]
      exact hsx
  have hPrin_eq : weilCurvePrincipalSubgroup C.left = H_im := by
    change AddSubgroup.closure S_gen = H_im
    rw [hS_eq, AddSubgroup.closure_eq]
  let q_hom : ↥(Div_sh.obj.obj (Opposite.op T_C)) →+ ((Pt →₀ ℤ) ⧸ H_im) :=
    (QuotientAddGroup.mk' H_im).comp e_fin.toAddMonoidHom
  have hq_surj : Function.Surjective q_hom :=
    (QuotientAddGroup.mk'_surjective H_im).comp e_fin.surjective
  have hq_ker : q_hom.ker = (div_pre.app (Opposite.op T_C)).hom.range := by
    ext d
    have hmk : q_hom d = 0 ↔ e_fin d ∈ H_im := by
      change QuotientAddGroup.mk' H_im (e_fin d) = 0 ↔ e_fin d ∈ H_im
      rw [← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk']
    rw [AddMonoidHom.mem_ker, hmk]
    constructor
    · rintro ⟨d', hd', h_eq⟩
      exact e_fin.injective h_eq ▸ hd'
    · intro hd
      exact ⟨d, hd, rfl⟩
  let e_Q1 : (↥(Div_sh.obj.obj (Opposite.op T_C)) ⧸ (div_pre.app (Opposite.op T_C)).hom.range) ≃+
      ((Pt →₀ ℤ) ⧸ H_im) :=
    (QuotientAddGroup.quotientAddEquivOfEq hq_ker.symm).trans
      (QuotientAddGroup.quotientKerEquivOfSurjective q_hom hq_surj)
  let e_Q2 : ((Pt →₀ ℤ) ⧸ H_im) ≃+ weilCurveClGroup C.left :=
    QuotientAddGroup.quotientAddEquivOfEq hPrin_eq.symm
  exact ⟨e_H0.trans (e_Q1.trans e_Q2)⟩

theorem weil_etale_curve_divisor_finsupp_cech_vanishing (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (U W : C.left.Etale) [CompactSpace ↥U.left] [U.left.IsSeparated]
    [AlgebraicGeometry.IsAffine W.left]
    (w : W ⟶ U) [AlgebraicGeometry.Surjective w.left] (p : ℕ) :
    CompactSpace ↥(weilEtaleCechObj w p).left ∧
    ∀ (c : { y : ↥(weilEtaleCechObj w (p + 1)).left //
        IsClosed ({(weilEtaleCechObj w (p + 1)).hom.base y} : Set ↥C.left) } → ℤ),
      { y | c y ≠ 0 }.Finite →
      (∀ z : { y : ↥(weilEtaleCechObj w (p + 2)).left //
          IsClosed ({(weilEtaleCechObj w (p + 2)).hom.base y} : Set ↥C.left) },
        (Finset.univ.sum fun j : Fin (p + 3) =>
          (-1 : ℤ) ^ (j : ℕ) *
            c ⟨(weilEtaleCechFace w (p + 1) j).left.base z.1, by
              rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
                CategoryTheory.MorphismProperty.Over.w (weilEtaleCechFace w (p + 1) j)]
              exact z.2⟩) = 0) →
      ∃ b : { y : ↥(weilEtaleCechObj w p).left //
          IsClosed ({(weilEtaleCechObj w p).hom.base y} : Set ↥C.left) } → ℤ,
        { y | b y ≠ 0 }.Finite ∧
        ∀ y : { y : ↥(weilEtaleCechObj w (p + 1)).left //
            IsClosed ({(weilEtaleCechObj w (p + 1)).hom.base y} : Set ↥C.left) },
          (Finset.univ.sum fun j : Fin (p + 2) =>
            (-1 : ℤ) ^ (j : ℕ) *
              b ⟨(weilEtaleCechFace w p j).left.base y.1, by
                rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
                  CategoryTheory.MorphismProperty.Over.w (weilEtaleCechFace w p j)]
                exact y.2⟩) = c y :=
by
  classical
  
  let t_U : U.left ⟶ CategoryTheory.Limits.terminal AlgebraicGeometry.Scheme.{u} :=
    CategoryTheory.Limits.terminal.from U.left
  haveI : AlgebraicGeometry.IsSeparated t_U :=
    (inferInstance : U.left.IsSeparated).isSeparated_terminal_from
  haveI : AlgebraicGeometry.IsAffineHom (w.left ≫ t_U) :=
    AlgebraicGeometry.isAffineHom_of_isAffine (w.left ≫ t_U)
  haveI : AlgebraicGeometry.IsAffineHom w.left :=
    AlgebraicGeometry.IsAffineHom.of_comp w.left t_U
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have hMultEt : P_et.IsMultiplicative := inferInstance
  haveI : P_et.ContainsIdentities := hMultEt.toContainsIdentities
  haveI : P_et.IsStableUnderComposition := hMultEt.toIsStableUnderComposition
  haveI : P_et.IsStableUnderBaseChange := inferInstance
  haveI : P_et.HasOfPostcompProperty P_et := inferInstance
  have hPresEt : CategoryTheory.Limits.PreservesFiniteLimits
      (CategoryTheory.MorphismProperty.Over.forget P_et ⊤ C.left) :=
    CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopOverForget P_et C.left
  let F_et : C.left.Etale ⥤ AlgebraicGeometry.Scheme.{u} :=
    AlgebraicGeometry.Scheme.Etale.forget C.left ⋙ CategoryTheory.Over.forget C.left
  haveI : CategoryTheory.Limits.PreservesLimitsOfShape CategoryTheory.Limits.WalkingCospan
      (AlgebraicGeometry.Scheme.Etale.forget C.left) :=
    hPresEt.preservesFiniteLimits CategoryTheory.Limits.WalkingCospan
  haveI : CategoryTheory.Limits.PreservesLimitsOfShape CategoryTheory.Limits.WalkingCospan
      (CategoryTheory.Over.forget C.left) :=
    CategoryTheory.Over.preservesLimitsOfShape_forget_of_isConnected
  haveI : CategoryTheory.Limits.PreservesLimitsOfShape CategoryTheory.Limits.WalkingCospan F_et :=
    CategoryTheory.Limits.comp_preservesLimitsOfShape _ _
  have hPB_cech : ∀ q : ℕ,
      CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w q) w).left
        (CategoryTheory.Limits.pullback.snd (weilEtaleCechHom w q) w).left
        (weilEtaleCechHom w q).left w.left :=
    fun q => (CategoryTheory.IsPullback.of_hasPullback (weilEtaleCechHom w q) w).map F_et
  have hAff : ∀ q : ℕ, AlgebraicGeometry.IsAffine (weilEtaleCechObj w q).left := by
    intro q
    induction q with
    | zero =>
      change AlgebraicGeometry.IsAffine W.left
      infer_instance
    | succ q ih =>
      letI : AlgebraicGeometry.IsAffine (weilEtaleCechObj w q).left := ih
      haveI : AlgebraicGeometry.IsAffine
          (CategoryTheory.Limits.pullback (weilEtaleCechHom w q).left w.left) :=
        inferInstance
      change AlgebraicGeometry.IsAffine (CategoryTheory.Limits.pullback (weilEtaleCechHom w q) w).left
      haveI : CategoryTheory.IsIso (hPB_cech q).isoPullback.hom :=
        CategoryTheory.Iso.isIso_hom (hPB_cech q).isoPullback
      exact AlgebraicGeometry.IsAffine.of_isIso (hPB_cech q).isoPullback.hom
  haveI : AlgebraicGeometry.IsAffine (weilEtaleCechObj w p).left := hAff p
  refine ⟨AlgebraicGeometry.Scheme.compactSpace_of_isAffine _, ?_⟩

  
  have hLiftProj : ∀ {Z : C.left.Etale} (h : Z ⟶ U) (q : ℕ) (g : Fin (q + 1) → (Z ⟶ W))
      (hg : ∀ i, g i ≫ w = h) (i : Fin (q + 1)),
      (weilEtaleCechLiftSub w h q g hg).1 ≫ weilEtaleCechProj w q i = g i := by
    intro Z h q
    induction q with
    | zero =>
      intro g hg i
      have hi : i = 0 := Fin.eq_zero i
      subst hi
      change g 0 ≫ CategoryTheory.CategoryStruct.id W = g 0
      exact CategoryTheory.Category.comp_id (g 0)
    | succ q ih =>
      intro g hg i
      refine Fin.lastCases ?_ ?_ i
      · simp only [weilEtaleCechLiftSub, weilEtaleCechProj, weilEtaleCechProjSub,
          Fin.lastCases_last]
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _
      · intro r
        simp only [weilEtaleCechLiftSub, weilEtaleCechProj, weilEtaleCechProjSub,
          Fin.lastCases_castSucc]
        exact (CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans
          (ih (fun m => g m.castSucc) (fun m => hg m.castSucc) r)
  have hFaceHom : ∀ (q : ℕ) (j : Fin (q + 2)),
      weilEtaleCechFace w q j ≫ weilEtaleCechHom w q = weilEtaleCechHom w (q + 1) :=
    fun q j => (weilEtaleCechLiftSub w (weilEtaleCechHom w (q + 1)) q
      (fun i => weilEtaleCechProj w (q + 1) (j.succAbove i))
      (fun i => (weilEtaleCechProjSub w (q + 1) (j.succAbove i)).2)).2
  have hFaceProj : ∀ (q : ℕ) (j : Fin (q + 2)) (i : Fin (q + 1)),
      weilEtaleCechFace w q j ≫ weilEtaleCechProj w q i =
        weilEtaleCechProj w (q + 1) (j.succAbove i) :=
    fun q j i => hLiftProj (weilEtaleCechHom w (q + 1)) q
      (fun r => weilEtaleCechProj w (q + 1) (j.succAbove r))
      (fun r => (weilEtaleCechProjSub w (q + 1) (j.succAbove r)).2) i

  
  haveI : AlgebraicGeometry.Etale U.hom := U.prop
  haveI : AlgebraicGeometry.Etale (U.hom : U.left ⟶ C.left) := U.prop
  haveI : AlgebraicGeometry.Etale W.hom := W.prop
  have hw_et : AlgebraicGeometry.Etale w.left :=
    CategoryTheory.MorphismProperty.of_postcomp P_et w.left U.hom U.prop
      (by rw [CategoryTheory.MorphismProperty.Over.w w]; exact W.prop)
  haveI : AlgebraicGeometry.Etale w.left := hw_et
  haveI : AlgebraicGeometry.Etale (w.left : W.left ⟶ U.left) := hw_et
  haveI : AlgebraicGeometry.Smooth C.hom :=
    (inferInstance : AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom).smooth
  haveI : AlgebraicGeometry.LocallyOfFiniteType C.hom := inferInstance
  haveI : JacobsonSpace ↥C.left := AlgebraicGeometry.LocallyOfFiniteType.jacobsonSpace C.hom
  haveI : JacobsonSpace ↥U.left :=
    AlgebraicGeometry.LocallyOfFiniteType.jacobsonSpace (U.hom ≫ C.hom)
  haveI : JacobsonSpace ↥W.left :=
    AlgebraicGeometry.LocallyOfFiniteType.jacobsonSpace (W.hom ≫ C.hom)

  have hDiscreteFiber : ∀ (Y₀ X₀ : AlgebraicGeometry.Scheme.{u}) (g : Y₀ ⟶ X₀)
      [AlgebraicGeometry.Etale g] (x₀ : ↥X₀),
      _root_.IsDiscrete (⇑g.base ⁻¹' ({x₀} : Set ↥X₀)) := by
    intro Y₀ X₀ g _ x₀
    rw [isDiscrete_iff_discreteTopology, discreteTopology_iff_isOpen_singleton]
    rintro ⟨y₀, hy₀ : g.base y₀ = x₀⟩
    have hx_top : x₀ ∈ (⊤ : X₀.Opens) := trivial
    obtain ⟨U₀, hU₀, hx₀, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hx_top
    have hy_pre : y₀ ∈ (TopologicalSpace.Opens.map g.base).obj U₀ := by
      change g.base y₀ ∈ U₀
      rwa [hy₀]
    obtain ⟨V₀, hV₀, hyV₀, hVU⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hy_pre
    let φ := (g.appLE U₀ V₀ hVU).hom
    letI : Algebra ↑(X₀.presheaf.obj (Opposite.op U₀)) ↑(Y₀.presheaf.obj (Opposite.op V₀)) :=
      φ.toAlgebra
    have hFU : φ.FormallyUnramified := g.formallyUnramified_appLE hU₀ hV₀ hVU
    have hFT : φ.FiniteType := g.finiteType_appLE hU₀ hV₀ hVU
    haveI : Algebra.FormallyUnramified ↑(X₀.presheaf.obj (Opposite.op U₀))
        ↑(Y₀.presheaf.obj (Opposite.op V₀)) := hFU
    haveI : Algebra.FiniteType ↑(X₀.presheaf.obj (Opposite.op U₀))
        ↑(Y₀.presheaf.obj (Opposite.op V₀)) := hFT
    haveI : Algebra.QuasiFinite ↑(X₀.presheaf.obj (Opposite.op U₀))
        ↑(Y₀.presheaf.obj (Opposite.op V₀)) :=
      ⟨fun P _ => Algebra.FormallyUnramified.finite_of_free P.ResidueField (P.Fiber _)⟩
    let p₀ := hU₀.primeIdealOf ⟨x₀, hx₀⟩
    let q₀ := hV₀.primeIdealOf ⟨y₀, hyV₀⟩
    have hcomp_spec := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec g hU₀ hV₀ hVU
    have hcomap : ∀ q : ↥(AlgebraicGeometry.Spec (Y₀.presheaf.obj (Opposite.op V₀))),
        hU₀.fromSpec.base (PrimeSpectrum.comap φ q) = g.base (hV₀.fromSpec.base q) := by
      intro q
      exact congrArg (fun m => m.base q) hcomp_spec
    have hq₀ : PrimeSpectrum.comap φ q₀ = p₀ := by
      apply hU₀.fromSpec.isOpenEmbedding.injective
      rw [hcomap q₀, hV₀.fromSpec_primeIdealOf ⟨y₀, hyV₀⟩, hU₀.fromSpec_primeIdealOf ⟨x₀, hx₀⟩]
      exact hy₀
    have hdisc_spec : _root_.IsDiscrete (PrimeSpectrum.comap φ ⁻¹' ({p₀} : Set _)) :=
      Algebra.QuasiFinite.isDiscrete_comap_preimage_singleton p₀
    rw [isDiscrete_iff_discreteTopology, discreteTopology_iff_isOpen_singleton] at hdisc_spec
    obtain ⟨O_spec, hO_spec, hO_eq⟩ := isOpen_induced_iff.mp (hdisc_spec ⟨q₀, hq₀⟩)
    rw [isOpen_induced_iff]
    refine ⟨hV₀.fromSpec.base '' O_spec, hV₀.fromSpec.isOpenEmbedding.isOpenMap O_spec hO_spec, ?_⟩
    ext ⟨y', hy' : g.base y' = x₀⟩
    simp only [Set.mem_preimage, Set.mem_image, Set.mem_singleton_iff]
    constructor
    · rintro ⟨q', hq'O, rfl⟩
      apply Subtype.ext
      have hq'_p : PrimeSpectrum.comap φ q' = p₀ := by
        apply hU₀.fromSpec.isOpenEmbedding.injective
        rw [hcomap q', hU₀.fromSpec_primeIdealOf ⟨x₀, hx₀⟩]
        exact hy'
      have hq'_mem : (⟨q', hq'_p⟩ : ↥(PrimeSpectrum.comap φ ⁻¹' {p₀})) ∈
          (Subtype.val ⁻¹' O_spec : Set ↥(PrimeSpectrum.comap φ ⁻¹' {p₀})) := hq'O
      rw [hO_eq, Set.mem_singleton_iff] at hq'_mem
      have hq'_eq : q' = q₀ := congrArg Subtype.val hq'_mem
      change hV₀.fromSpec.base q' = y₀
      rw [hq'_eq]
      exact hV₀.fromSpec_primeIdealOf ⟨y₀, hyV₀⟩
    · intro hy'_eq
      have hy'_val : y' = y₀ := congrArg Subtype.val hy'_eq
      rw [hy'_val]
      refine ⟨q₀, ?_, hV₀.fromSpec_primeIdealOf ⟨y₀, hyV₀⟩⟩
      have hq₀_mem : (⟨q₀, hq₀⟩ : ↥(PrimeSpectrum.comap φ ⁻¹' {p₀})) ∈
          ({⟨q₀, hq₀⟩} : Set ↥(PrimeSpectrum.comap φ ⁻¹' {p₀})) := rfl
      rwa [← hO_eq] at hq₀_mem

  have hClosedLift : ∀ (Y₀ X₀ : AlgebraicGeometry.Scheme.{u}) (g : Y₀ ⟶ X₀)
      [AlgebraicGeometry.Etale g] [JacobsonSpace ↥Y₀] (y₀ : ↥Y₀),
      IsClosed ({g.base y₀} : Set ↥X₀) → IsClosed ({y₀} : Set ↥Y₀) := by
    intro Y₀ X₀ g _ _ y₀ hx_cl
    let s : Set ↥Y₀ := ⇑g.base ⁻¹' {g.base y₀}
    have hs_cl : IsClosed s := hx_cl.preimage g.base.hom.continuous
    have hs_disc : DiscreteTopology ↥s :=
      isDiscrete_iff_discreteTopology.mp (hDiscreteFiber Y₀ X₀ g (g.base y₀))
    have hy₀_s : y₀ ∈ s := rfl
    obtain ⟨O, hO, hO_eq⟩ :=
      isOpen_induced_iff.mp (isOpen_discrete ({⟨y₀, hy₀_s⟩} : Set ↥s))
    apply isClosed_singleton_of_isLocallyClosed_singleton
    refine ⟨O, s, hO, hs_cl, ?_⟩
    ext y'
    simp only [Set.mem_singleton_iff, Set.mem_inter_iff]
    constructor
    · intro hy'
      rw [hy']
      have hm : (⟨y₀, hy₀_s⟩ : ↥s) ∈ ({⟨y₀, hy₀_s⟩} : Set ↥s) := rfl
      rw [← hO_eq] at hm
      exact ⟨hm, hy₀_s⟩
    · rintro ⟨hy'O, hy's⟩
      have hm : (⟨y', hy's⟩ : ↥s) ∈ (Subtype.val ⁻¹' O : Set ↥s) := hy'O
      rw [hO_eq, Set.mem_singleton_iff] at hm
      exact congrArg Subtype.val hm

  have hFinFiber : ∀ (z : ↥U.left), IsClosed ({U.hom.base z} : Set ↥C.left) →
      { v : ↥W.left | w.left.base v = z }.Finite := by
    intro z hz_C
    haveI : CompactSpace ↥W.left := AlgebraicGeometry.Scheme.compactSpace_of_isAffine W.left
    have hz_cl : IsClosed ({z} : Set ↥U.left) := hClosedLift U.left C.left U.hom z hz_C
    have hs_cl : IsClosed (⇑w.left.base ⁻¹' ({z} : Set ↥U.left)) :=
      hz_cl.preimage w.left.base.hom.continuous
    exact hs_cl.isCompact.finite (hDiscreteFiber W.left U.left w.left z)

  have hResIso : ∀ (z : ↥U.left), IsClosed ({U.hom.base z} : Set ↥C.left) →
      ∀ (v : ↥W.left), w.left.base v = z → CategoryTheory.IsIso (w.left.residueFieldMap v) := by
    intro z hz_C v hv
    have hz_cl : IsClosed ({z} : Set ↥U.left) := hClosedLift U.left C.left U.hom z hz_C
    have hv_cl : IsClosed ({v} : Set ↥W.left) := by
      have hv_z : IsClosed ({w.left.base v} : Set ↥U.left) := by rwa [hv]
      exact hClosedLift W.left U.left w.left v hv_z
    haveI : AlgebraicGeometry.LocallyOfFiniteType (U.left.fromSpecResidueField z) :=
      AlgebraicGeometry.isClosed_singleton_iff_locallyOfFiniteType.mp hz_cl
    haveI : AlgebraicGeometry.LocallyOfFiniteType (W.left.fromSpecResidueField v) :=
      AlgebraicGeometry.isClosed_singleton_iff_locallyOfFiniteType.mp hv_cl
    let f_z : AlgebraicGeometry.Spec (U.left.residueField z) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      U.left.fromSpecResidueField z ≫ U.hom ≫ C.hom
    haveI : AlgebraicGeometry.IsFinite f_z :=
      AlgebraicGeometry.isFinite_iff_locallyOfFiniteType_of_jacobsonSpace.mpr inferInstance
    have hf_z_int : f_z.appTop.hom.IsIntegral :=
      AlgebraicGeometry.isIntegral_appTop_of_universallyClosed f_z
    let e_k := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)
    let e_z := AlgebraicGeometry.Scheme.ΓSpecIso (U.left.residueField z)
    let ψ_k : k →+* ↑(U.left.residueField z) :=
      (e_z.hom.hom.comp f_z.appTop.hom).comp e_k.inv.hom
    have hψ_k_int : ψ_k.IsIntegral := by
      have h1 : e_k.inv.hom.IsIntegral :=
        RingHom.isIntegral_of_surjective _ (e_k.commRingCatIsoToRingEquiv.symm.surjective)
      have h2 : e_z.hom.hom.IsIntegral :=
        RingHom.isIntegral_of_surjective _ (e_z.commRingCatIsoToRingEquiv.surjective)
      exact RingHom.IsIntegral.trans _ _ h1 (RingHom.IsIntegral.trans _ _ hf_z_int h2)
    have hψ_k_bij : Function.Bijective ψ_k :=
      IsAlgClosed.ringHom_bijective_of_isIntegral ψ_k hψ_k_int
    haveI : IsAlgClosed ↑(U.left.residueField z) :=
      IsAlgClosed.of_ringEquiv k ↑(U.left.residueField z) (RingEquiv.ofBijective ψ_k hψ_k_bij)
    have hSpec_v : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (w.left.residueFieldMap v) ≫
          U.left.fromSpecResidueField (w.left.base v)) := by
      rw [AlgebraicGeometry.Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
      haveI : AlgebraicGeometry.LocallyOfFiniteType
          (U.left.fromSpecResidueField (w.left.base v)) := by
        rwa [hv]
      infer_instance
    haveI : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (w.left.residueFieldMap v)) :=
      AlgebraicGeometry.locallyOfFiniteType_of_comp
        (AlgebraicGeometry.Spec.map (w.left.residueFieldMap v))
        (U.left.fromSpecResidueField (w.left.base v))
    haveI : AlgebraicGeometry.IsFinite
        (AlgebraicGeometry.Spec.map (w.left.residueFieldMap v)) :=
      AlgebraicGeometry.isFinite_iff_locallyOfFiniteType_of_jacobsonSpace.mpr inferInstance
    have h_v_fin : (w.left.residueFieldMap v).hom.Finite :=
      (AlgebraicGeometry.IsFinite.SpecMap_iff (w.left.residueFieldMap v)).mp inferInstance
    haveI : IsAlgClosed ↑(U.left.residueField (w.left.base v)) := by rwa [hv]
    have h_v_bij : Function.Bijective (w.left.residueFieldMap v).hom :=
      IsAlgClosed.ringHom_bijective_of_isIntegral _ h_v_fin.to_isIntegral
    exact (RingEquiv.ofBijective _ h_v_bij).toCommRingCatIso.isIso_hom

  
  have hUniquePB : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (f : Y ⟶ U.left)
      (z : ↥U.left) (hz : IsClosed ({U.hom.base z} : Set ↥C.left))
      (y₀ : ↥Y) (v : ↥W.left),
      f.base y₀ = z → w.left.base v = z →
      ∀ u₁ u₂ : ↥(CategoryTheory.Limits.pullback f w.left),
        (CategoryTheory.Limits.pullback.fst f w.left).base u₁ = y₀ →
        (CategoryTheory.Limits.pullback.snd f w.left).base u₁ = v →
        (CategoryTheory.Limits.pullback.fst f w.left).base u₂ = y₀ →
        (CategoryTheory.Limits.pullback.snd f w.left).base u₂ = v →
        u₁ = u₂ := by
    intro Y f z hz y₀ v hy₀ hv u₁ u₂ hu₁_f hu₁_s hu₂_f hu₂_s
    let p₁ := AlgebraicGeometry.Scheme.Pullback.carrierEquiv u₁
    let p₂ := AlgebraicGeometry.Scheme.Pullback.carrierEquiv u₂
    have hu₁_eq : AlgebraicGeometry.Scheme.Pullback.carrierEquiv.symm p₁ = u₁ :=
      AlgebraicGeometry.Scheme.Pullback.carrierEquiv.symm_apply_apply u₁
    have hu₂_eq : AlgebraicGeometry.Scheme.Pullback.carrierEquiv.symm p₂ = u₂ :=
      AlgebraicGeometry.Scheme.Pullback.carrierEquiv.symm_apply_apply u₂
    have hT₁_x : p₁.1.x = y₀ := by
      rw [← AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_fst p₁.1 p₁.2, hu₁_eq]
      exact hu₁_f
    have hT₁_y : p₁.1.y = v := by
      rw [← AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_snd p₁.1 p₁.2, hu₁_eq]
      exact hu₁_s
    have hT₂_x : p₂.1.x = y₀ := by
      rw [← AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_fst p₂.1 p₂.2, hu₂_eq]
      exact hu₂_f
    have hT₂_y : p₂.1.y = v := by
      rw [← AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_snd p₂.1 p₂.2, hu₂_eq]
      exact hu₂_s
    rcases p₁ with ⟨⟨x₁, y₁, s₁, hx₁, hy₁⟩, pt₁⟩
    rcases p₂ with ⟨⟨x₂, y₂, s₂, hx₂, hy₂⟩, pt₂⟩
    dsimp at hT₁_x hT₁_y hT₂_x hT₂_y
    cases hT₁_x
    cases hT₁_y
    cases hT₂_x
    cases hT₂_y
    have hs_eq : s₁ = s₂ := hx₁.symm.trans hx₂
    cases hs_eq
    let T₀ : AlgebraicGeometry.Scheme.Pullback.Triplet f w.left := ⟨_, _, _, hx₁, hy₁⟩
    have hv' : w.left.base T₀.y = z := hv
    haveI : CategoryTheory.IsIso (w.left.residueFieldMap T₀.y) := hResIso z hz T₀.y hv'
    haveI : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map T₀.tensorInl) :=
      T₀.isPullback_SpecMap_tensor.isIso_fst_of_isIso
    let e_spec := CategoryTheory.asIso (AlgebraicGeometry.Spec.map T₀.tensorInl)
    have hpt : pt₁ = pt₂ := by
      have hbase : e_spec.hom.base pt₁ = e_spec.hom.base pt₂ := Subsingleton.elim _ _
      exact (congrArg (fun m => m.base pt₁) e_spec.hom_inv_id).symm.trans
        ((congrArg (fun x => e_spec.inv.base x) hbase).trans
          (congrArg (fun m => m.base pt₂) e_spec.hom_inv_id))
    cases hpt
    exact hu₁_eq.symm.trans hu₂_eq

  have hCechInj : ∀ (z : ↥U.left) (hz : IsClosed ({U.hom.base z} : Set ↥C.left))
      (q : ℕ) (y₁ y₂ : ↥(weilEtaleCechObj w q).left),
      (weilEtaleCechHom w q).left.base y₁ = z →
      (weilEtaleCechHom w q).left.base y₂ = z →
      (∀ i : Fin (q + 1),
        (weilEtaleCechProj w q i).left.base y₁ = (weilEtaleCechProj w q i).left.base y₂) →
      y₁ = y₂ := by
    intro z hz q
    induction q with
    | zero =>
      intro y₁ y₂ _ _ hproj
      exact hproj 0
    | succ q ih =>
      intro y₁ y₂ hy₁ hy₂ hproj
      let fst_q := CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w q) w
      let snd_q := CategoryTheory.Limits.pullback.snd (weilEtaleCechHom w q) w
      have hy₁' : (weilEtaleCechHom w q).left.base (fst_q.left.base y₁) = z := hy₁
      have hy₂' : (weilEtaleCechHom w q).left.base (fst_q.left.base y₂) = z := hy₂
      have hproj_cast_eq : ∀ r : Fin (q + 1),
          weilEtaleCechProj w (q + 1) r.castSucc = fst_q ≫ weilEtaleCechProj w q r := by
        intro r
        simp only [weilEtaleCechProj, weilEtaleCechProjSub, Fin.lastCases_castSucc, fst_q]
        exact rfl
      have hproj_last_eq : weilEtaleCechProj w (q + 1) (Fin.last (q + 1)) = snd_q := by
        simp only [weilEtaleCechProj, weilEtaleCechProjSub, Fin.lastCases_last, snd_q]
        exact rfl
      have hproj' : ∀ r : Fin (q + 1),
          (weilEtaleCechProj w q r).left.base (fst_q.left.base y₁) =
            (weilEtaleCechProj w q r).left.base (fst_q.left.base y₂) :=
        fun r => (congrArg (fun m => m.left.base y₁) (hproj_cast_eq r)).symm.trans
          ((hproj r.castSucc).trans (congrArg (fun m => m.left.base y₂) (hproj_cast_eq r)))
      have hfst_eq : fst_q.left.base y₁ = fst_q.left.base y₂ := ih _ _ hy₁' hy₂' hproj'
      have hsnd_eq : snd_q.left.base y₁ = snd_q.left.base y₂ :=
        (congrArg (fun m => m.left.base y₁) hproj_last_eq).symm.trans
          ((hproj (Fin.last (q + 1))).trans (congrArg (fun m => m.left.base y₂) hproj_last_eq))
      have hsnd_z : w.left.base (snd_q.left.base y₁) = z := by
        have hcond : snd_q.left ≫ w.left = fst_q.left ≫ (weilEtaleCechHom w q).left :=
          congrArg F_et.map
            (CategoryTheory.Limits.pullback.condition (f := weilEtaleCechHom w q) (g := w)).symm
        exact (congrArg (fun m => m.base y₁) hcond).trans hy₁'
      let e_pb := (hPB_cech q).isoPullback
      have hu_eq : e_pb.hom.base y₁ = e_pb.hom.base y₂ := by
        apply hUniquePB (weilEtaleCechHom w q).left z hz
          (fst_q.left.base y₁) (snd_q.left.base y₁) hy₁' hsnd_z
        · exact congrArg (fun m => m.base y₁) (hPB_cech q).isoPullback_hom_fst
        · exact congrArg (fun m => m.base y₁) (hPB_cech q).isoPullback_hom_snd
        · exact (congrArg (fun m => m.base y₂) (hPB_cech q).isoPullback_hom_fst).trans hfst_eq.symm
        · exact (congrArg (fun m => m.base y₂) (hPB_cech q).isoPullback_hom_snd).trans hsnd_eq.symm
      exact (congrArg (fun m => m.base y₁) e_pb.hom_inv_id).symm.trans
        ((congrArg (fun x => e_pb.inv.base x) hu_eq).trans
          (congrArg (fun m => m.base y₂) e_pb.hom_inv_id))

  have hCechSurj : ∀ (z : ↥U.left) (q : ℕ) (tup : Fin (q + 1) → ↥W.left),
      (∀ i : Fin (q + 1), w.left.base (tup i) = z) →
      ∃ y : ↥(weilEtaleCechObj w q).left,
        (weilEtaleCechHom w q).left.base y = z ∧
        ∀ i : Fin (q + 1), (weilEtaleCechProj w q i).left.base y = tup i := by
    intro z q
    induction q with
    | zero =>
      intro tup htup
      refine ⟨tup 0, htup 0, fun i => ?_⟩
      rw [Fin.eq_zero i]
      rfl
    | succ q ih =>
      intro tup htup
      obtain ⟨y', hy'_z, hy'_proj⟩ :=
        ih (fun r => tup r.castSucc) (fun r => htup r.castSucc)
      obtain ⟨u_pb, hu_fst, hu_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := (weilEtaleCechHom w q).left) (g := w.left) y' (tup (Fin.last (q + 1)))
          (hy'_z.trans (htup (Fin.last (q + 1))).symm)
      let e_pb := (hPB_cech q).isoPullback
      let y : ↥(weilEtaleCechObj w (q + 1)).left := e_pb.inv.base u_pb
      have hy_fst : (CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w q) w).left.base y = y' := by
        dsimp [y]
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, (hPB_cech q).isoPullback_inv_fst]
        exact hu_fst
      have hy_snd : (CategoryTheory.Limits.pullback.snd (weilEtaleCechHom w q) w).left.base y =
          tup (Fin.last (q + 1)) := by
        dsimp [y]
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, (hPB_cech q).isoPullback_inv_snd]
        exact hu_snd
      refine ⟨y, ?_, ?_⟩
      · change ((CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w q) w).left ≫
          (weilEtaleCechHom w q).left).base y = z
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hy_fst]
        exact hy'_z
      · intro i
        refine Fin.lastCases ?_ ?_ i
        · simp only [weilEtaleCechProj, weilEtaleCechProjSub, Fin.lastCases_last]
          exact hy_snd
        · intro r
          simp only [weilEtaleCechProj, weilEtaleCechProjSub, Fin.lastCases_castSucc]
          change ((CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w q) w).left ≫
            (weilEtaleCechProj w q r).left).base y = tup r.castSucc
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hy_fst]
          exact hy'_proj r

  
  let PtU := { z : ↥U.left // IsClosed ({U.hom.base z} : Set ↥C.left) }
  let PtCech (q : ℕ) := { y : ↥(weilEtaleCechObj w q).left //
    IsClosed ({(weilEtaleCechObj w q).hom.base y} : Set ↥C.left) }
  let T (q : ℕ) := { x : PtU × (Fin (q + 1) → ↥W.left) //
    ∀ i : Fin (q + 1), w.left.base (x.2 i) = x.1.1 }
  let ψ_map : ∀ q : ℕ, PtCech q → T q := fun q y =>
    ⟨(⟨(weilEtaleCechHom w q).left.base y.1, by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
          CategoryTheory.MorphismProperty.Over.w (weilEtaleCechHom w q)]
        exact y.2⟩,
      fun i => (weilEtaleCechProj w q i).left.base y.1),
      fun i => congrArg (fun m => m.left.base y.1) (weilEtaleCechProjSub w q i).2⟩
  have hψ_bij : ∀ q : ℕ, Function.Bijective (ψ_map q) := by
    intro q
    constructor
    · intro y₁ y₂ h
      have hz_eq : (weilEtaleCechHom w q).left.base y₁.1 =
          (weilEtaleCechHom w q).left.base y₂.1 :=
        congrArg (fun x : T q => x.1.1.1) h
      have hproj_eq : ∀ i : Fin (q + 1),
          (weilEtaleCechProj w q i).left.base y₁.1 =
            (weilEtaleCechProj w q i).left.base y₂.1 :=
        congrFun (congrArg (fun x : T q => x.1.2) h)
      exact Subtype.ext (hCechInj ((weilEtaleCechHom w q).left.base y₁.1)
        (ψ_map q y₁).1.1.2 q y₁.1 y₂.1 rfl hz_eq.symm hproj_eq)
    · intro x
      obtain ⟨y₀, hy₀_z, hy₀_proj⟩ := hCechSurj x.1.1.1 q x.1.2 x.2
      have hy₀_cl : IsClosed ({(weilEtaleCechObj w q).hom.base y₀} : Set ↥C.left) := by
        rw [← CategoryTheory.MorphismProperty.Over.w (weilEtaleCechHom w q),
          AlgebraicGeometry.Scheme.Hom.comp_apply, hy₀_z]
        exact x.1.1.2
      refine ⟨⟨y₀, hy₀_cl⟩, ?_⟩
      exact Subtype.ext (Prod.ext (Subtype.ext hy₀_z) (funext hy₀_proj))
  let e_cech : ∀ q : ℕ, PtCech q ≃ T q := fun q => Equiv.ofBijective (ψ_map q) (hψ_bij q)
  let δ_T : ∀ (q : ℕ) (j : Fin (q + 2)), T (q + 1) → T q := fun q j x =>
    ⟨(x.1.1, x.1.2 ∘ j.succAbove), fun i => x.2 (j.succAbove i)⟩
  have hFace_T : ∀ (q : ℕ) (j : Fin (q + 2)) (y : PtCech (q + 1)),
      e_cech q ⟨(weilEtaleCechFace w q j).left.base y.1, by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
          CategoryTheory.MorphismProperty.Over.w (weilEtaleCechFace w q j)]
        exact y.2⟩ = δ_T q j (e_cech (q + 1) y) := by
    intro q j y
    apply Subtype.ext
    apply Prod.ext
    · apply Subtype.ext
      simp only [e_cech, Equiv.ofBijective_apply, ψ_map, δ_T]
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply]
      exact congrArg (fun m => m.left.base y.1) (hFaceHom q j)
    · funext i
      simp only [e_cech, Equiv.ofBijective_apply, ψ_map, δ_T, Function.comp_apply]
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply]
      exact congrArg (fun m => m.left.base y.1) (hFaceProj q j i)

  intro c hc_fin hc_cocycle
  let c₀ : T (p + 1) → ℤ := fun x => c ((e_cech (p + 1)).symm x)
  have hc₀_fin : { x : T (p + 1) | c₀ x ≠ 0 }.Finite := by
    refine (hc_fin.image (e_cech (p + 1))).subset ?_
    intro x hx
    exact ⟨(e_cech (p + 1)).symm x, hx, (e_cech (p + 1)).apply_symm_apply x⟩
  have hc₀_cocycle : ∀ z₀ : T (p + 2),
      (Finset.univ.sum fun j : Fin (p + 3) => (-1 : ℤ) ^ (j : ℕ) * c₀ (δ_T (p + 1) j z₀)) = 0 := by
    intro z₀
    have h0 := hc_cocycle ((e_cech (p + 2)).symm z₀)
    rw [← h0]
    apply Finset.sum_congr rfl
    intro j _
    congr 1
    dsimp [c₀]
    congr 1
    apply (e_cech (p + 1)).injective
    rw [(e_cech (p + 1)).apply_symm_apply, hFace_T (p + 1) j ((e_cech (p + 2)).symm z₀),
      (e_cech (p + 2)).apply_symm_apply]

  choose s₀ hs₀ using fun z : PtU => w.left.surjective z.1
  let κ_T : ∀ q : ℕ, T q → T (q + 1) := fun q x =>
    ⟨(x.1.1, Fin.cons (s₀ x.1.1) x.1.2), Fin.cases (hs₀ x.1.1) x.2⟩
  let b₀ : T p → ℤ := fun x => c₀ (κ_T p x)
  have hb₀_fin : { x : T p | b₀ x ≠ 0 }.Finite := by
    let A₀ : Set PtU := (fun y : T (p + 1) => y.1.1) '' { y : T (p + 1) | c₀ y ≠ 0 }
    have hA₀_fin : A₀.Finite := hc₀_fin.image _
    let γ : ∀ z : PtU, (Fin (p + 1) → { v : ↥W.left // w.left.base v = z.1 }) → T p :=
      fun z f => ⟨(z, fun i => (f i).1), fun i => (f i).2⟩
    have hγ_fin : ∀ z ∈ A₀, (Set.range (γ z)).Finite := by
      intro z _
      haveI : Finite { v : ↥W.left // w.left.base v = z.1 } := (hFinFiber z.1 z.2).to_subtype
      exact Set.finite_range (γ z)
    refine (hA₀_fin.biUnion hγ_fin).subset ?_
    intro x hx
    rw [Set.mem_iUnion₂]
    refine ⟨x.1.1, ⟨κ_T p x, hx, rfl⟩, ⟨fun i => ⟨x.1.2 i, x.2 i⟩, ?_⟩⟩
    exact Subtype.ext (Prod.ext rfl rfl)

  have hb₀_eq : ∀ x : T (p + 1),
      (Finset.univ.sum fun i : Fin (p + 2) => (-1 : ℤ) ^ (i : ℕ) * b₀ (δ_T p i x)) = c₀ x := by
    intro x
    have hz := hc₀_cocycle (κ_T (p + 1) x)
    rw [Fin.sum_univ_succ] at hz
    have h0_term : δ_T (p + 1) 0 (κ_T (p + 1) x) = x := by
      apply Subtype.ext
      refine Prod.ext rfl ?_
      funext m
      simp [δ_T, κ_T]
    have hsucc_term : ∀ i : Fin (p + 2),
        δ_T (p + 1) i.succ (κ_T (p + 1) x) = κ_T p (δ_T p i x) := by
      intro i
      apply Subtype.ext
      refine Prod.ext rfl ?_
      funext r
      refine Fin.cases ?_ ?_ r
      · simp [δ_T, κ_T]
      · intro m
        simp [δ_T, κ_T, Fin.succ_succAbove_succ]
    have hterm_succ : ∀ i : Fin (p + 2),
        (-1 : ℤ) ^ (i.succ : ℕ) * c₀ (δ_T (p + 1) i.succ (κ_T (p + 1) x)) =
          -((-1 : ℤ) ^ (i : ℕ) * b₀ (δ_T p i x)) := by
      intro i
      rw [hsucc_term i, Fin.val_succ, pow_succ']
      dsimp [b₀]
      ring
    simp only [Fin.val_zero, pow_zero, one_mul, h0_term, hterm_succ,
      Finset.sum_neg_distrib] at hz
    omega

  let b : PtCech p → ℤ := fun y => b₀ (e_cech p y)
  refine ⟨b, ?_, ?_⟩
  · refine (hb₀_fin.image (e_cech p).symm).subset ?_
    intro y hy
    exact ⟨e_cech p y, hy, (e_cech p).symm_apply_apply y⟩
  · intro y
    have hsum : (Finset.univ.sum fun j : Fin (p + 2) =>
        (-1 : ℤ) ^ (j : ℕ) *
          b ⟨(weilEtaleCechFace w p j).left.base y.1, by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
              CategoryTheory.MorphismProperty.Over.w (weilEtaleCechFace w p j)]
            exact y.2⟩) =
        Finset.univ.sum fun j : Fin (p + 2) =>
          (-1 : ℤ) ^ (j : ℕ) * b₀ (δ_T p j (e_cech (p + 1) y)) := by
      apply Finset.sum_congr rfl
      intro j _
      congr 1
      dsimp [b]
      rw [hFace_T p j y]
    rw [hsum, hb₀_eq (e_cech (p + 1) y)]
    dsimp [c₀]
    rw [(e_cech (p + 1)).symm_apply_apply]

theorem weil_tsen_c1_galois_units_cohomology_vanishing (k : Type u) [Field k] [IsAlgClosed k]
    (E L : Type u) [Field E] [Field L]
    [Algebra (FractionRing (Polynomial k)) E]
    [FiniteDimensional (FractionRing (Polynomial k)) E]
    [Algebra E L] [FiniteDimensional E L] [IsGalois E L]
    (n : ℕ) (hn : 1 ≤ n) :
    Subsingleton ↥(groupCohomology (weilGalUnitsRep E L) n) :=
by
  classical
  
  have s1_homog : ∀ (K s : ℕ), s < K → ∀ (d : Fin s → ℕ), (∀ j : Fin s, 1 ≤ d j) →
      ∀ (Q : Fin s → MvPolynomial (Fin K) k), (∀ j : Fin s, (Q j).IsHomogeneous (d j)) →
        ∃ c : Fin K → k, c ≠ 0 ∧ ∀ j : Fin s, MvPolynomial.eval c (Q j) = 0 := by
    intro K s hsK d hd Q hQ
    let R := MvPolynomial (Fin K) k
    let m₀ : Ideal R := MvPolynomial.vanishingIdeal k {(0 : Fin K → k)}
    have hm₀_max : m₀.IsMaximal := by
      dsimp [m₀]
      infer_instance
    have hm₀_prime : m₀.IsPrime := hm₀_max.isPrime
    have hQ_mem : ∀ j : Fin s, Q j ∈ m₀ := by
      intro j
      rw [MvPolynomial.mem_vanishingIdeal_iff]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_eq]
      apply Finset.sum_eq_zero
      intro m hm
      have hm_ne : (Q j).coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
      have hm_deg := hQ j hm_ne
      have hm0 : m ≠ 0 := by
        rintro rfl
        have hdj := hd j
        simp at hm_deg
        omega
      have hex_i : ∃ i : Fin K, m i ≠ 0 := by
        by_contra! hall
        exact hm0 (Finsupp.ext hall)
      obtain ⟨i, hi⟩ := hex_i
      have hi_supp : i ∈ m.support := Finsupp.mem_support_iff.mpr hi
      rw [Finset.prod_eq_zero hi_supp (zero_pow hi), mul_zero]
    let S : Finset R := Finset.univ.image Q
    have hS_card : S.card ≤ s := Finset.card_image_le.trans (by simp)
    let I : Ideal R := Ideal.span (S : Set R)
    have hI_le : I ≤ m₀ := Ideal.span_le.mpr (by
      intro f hf
      rcases Finset.mem_image.mp (Finset.mem_coe.mp hf) with ⟨j, -, rfl⟩
      exact hQ_mem j)
    obtain ⟨p, hp_min, hp_le⟩ := Ideal.exists_minimalPrimes_le hI_le
    haveI hp_prime : p.IsPrime := hp_min.1.1
    have hI_le_p : I ≤ p := hp_min.1.2
    have hp_ht : p.height ≤ (s : ℕ∞) :=
      (Ideal.height_le_card_of_mem_minimalPrimes_span_finset hp_min).trans (Nat.cast_le.mpr hS_card)
    let φ : ℕ → (R →+* R) := fun r =>
      MvPolynomial.eval₂Hom MvPolynomial.C (fun i : Fin K => if i.1 < r then 0 else MvPolynomial.X i)
    let q : ℕ → Ideal R := fun r => RingHom.ker (φ r)
    have hq_prime : ∀ r, (q r).IsPrime := fun r => RingHom.ker_isPrime (φ r)
    have hφ_comp : ∀ r, (φ (r + 1)).comp (φ r) = φ (r + 1) := by
      intro r
      apply MvPolynomial.ringHom_ext'
      · refine RingHom.ext fun a => ?_
        change φ (r + 1) (φ r (MvPolynomial.C a)) = φ (r + 1) (MvPolynomial.C a)
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
      · intro i
        simp only [RingHom.comp_apply, φ, MvPolynomial.eval₂Hom_X']
        by_cases h1 : i.1 < r
        · have h2 : i.1 < r + 1 := by omega
          rw [if_pos h1, if_pos h2, map_zero]
        · rw [if_neg h1, MvPolynomial.eval₂Hom_X']
    have hq_le : ∀ r, q r ≤ q (r + 1) := by
      intro r f hf
      change φ (r + 1) f = 0
      rw [← hφ_comp r]
      change φ (r + 1) (φ r f) = 0
      rw [hf, map_zero]
    have hq_lt : ∀ r, r < K → q r < q (r + 1) := by
      intro r hr
      refine lt_of_le_not_ge (hq_le r) (fun hge => ?_)
      let idx : Fin K := ⟨r, hr⟩
      have hin : (MvPolynomial.X idx : R) ∈ q (r + 1) := by
        change φ (r + 1) (MvPolynomial.X idx) = 0
        rw [MvPolynomial.eval₂Hom_X', if_pos (Nat.lt_succ_self r)]
      have hout : (MvPolynomial.X idx : R) ∉ q r := by
        change φ r (MvPolynomial.X idx) ≠ 0
        rw [MvPolynomial.eval₂Hom_X', if_neg (lt_irrefl r)]
        exact MvPolynomial.X_ne_zero idx
      exact hout (hge hin)
    have hq_ht : ∀ r, r ≤ K → (r : ℕ∞) ≤ (q r).height := by
      intro r
      induction r with
      | zero =>
        intro _
        exact zero_le'
      | succ r ih =>
        intro hr
        by_contra! hlt
        have hle_r : (q (r + 1)).height ≤ (r : ℕ∞) := by
          rw [Nat.cast_add, Nat.cast_one] at hlt
          exact Order.le_of_lt_add_one hlt
        haveI : (q (r + 1)).IsPrime := hq_prime (r + 1)
        haveI : (q r).IsPrime := hq_prime r
        have hlt_r : (q r).height < (r : ℕ∞) :=
          (Ideal.height_le_iff.mp hle_r) (q r) (hq_prime r) (hq_lt r (by omega))
        exact not_lt_of_ge (ih (by omega)) hlt_r
    have hqK_eq : q K = m₀ := by
      have hφK : φ K = MvPolynomial.C.comp (MvPolynomial.eval 0) := by
        apply MvPolynomial.ringHom_ext'
        · refine RingHom.ext fun a => ?_
          simp only [φ, MvPolynomial.eval₂Hom_C, RingHom.comp_apply, MvPolynomial.eval_C]
        · intro i
          rw [RingHom.comp_apply, MvPolynomial.eval_X, Pi.zero_apply, map_zero]
          change φ K (MvPolynomial.X i) = 0
          rw [MvPolynomial.eval₂Hom_X', if_pos i.isLt]
      ext f
      have hL : (f ∈ q K) ↔ (MvPolynomial.C (MvPolynomial.eval 0 f) : R) = 0 := by
        change φ K f = 0 ↔ _
        rw [hφK]
        rfl
      have hR : (f ∈ m₀) ↔ MvPolynomial.eval 0 f = 0 := by
        dsimp [m₀]
        rw [MvPolynomial.mem_vanishingIdeal_iff]
        exact ⟨fun h => h 0 (Set.mem_singleton 0),
          fun h x hx => by rw [Set.mem_singleton_iff.mp hx]; exact h⟩
      rw [hL, hR]
      exact ⟨fun h => MvPolynomial.C_injective (Fin K) k (h.trans (map_zero _).symm),
        fun h => by rw [h, map_zero]⟩
    have hm₀_ht : (K : ℕ∞) ≤ m₀.height := hqK_eq ▸ hq_ht K le_rfl
    have hp_ne : p ≠ m₀ := by
      intro heq
      subst heq
      exact not_lt_of_ge hm₀_ht (lt_of_le_of_lt hp_ht (Nat.cast_lt.mpr hsK))
    have hNS : MvPolynomial.vanishingIdeal k (MvPolynomial.zeroLocus k p) = p :=
      MvPolynomial.IsPrime.vanishingIdeal_zeroLocus p
    have hex_c : ∃ c ∈ MvPolynomial.zeroLocus k p, c ≠ 0 := by
      by_contra! hall
      apply hp_ne
      apply le_antisymm hp_le
      rw [← hNS]
      intro f hf
      rw [MvPolynomial.mem_vanishingIdeal_iff] at hf ⊢
      intro c hc
      rw [hall c hc]
      exact hf 0 (Set.mem_singleton 0)
    obtain ⟨c, hc_mem, hc_ne⟩ := hex_c
    refine ⟨c, hc_ne, fun j => ?_⟩
    have hj_p : Q j ∈ p :=
      hI_le_p (Ideal.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem Q (Finset.mem_univ j))))
    exact (MvPolynomial.mem_zeroLocus_iff.mp hc_mem) (Q j) hj_p
  
  have s2_tsen : ∀ (F : Type u) [Field F]
      [Algebra (FractionRing (Polynomial k)) F]
      [FiniteDimensional (FractionRing (Polynomial k)) F]
      (d N : ℕ), 1 ≤ d → d < N →
      ∀ (P : MvPolynomial (Fin N) F), P.IsHomogeneous d →
        ∃ x : Fin N → F, x ≠ 0 ∧ MvPolynomial.eval x P = 0 := by
    intro F _ _ _ d N hd hdN P hP
    let A_pol := Polynomial k
    let K₀ := FractionRing A_pol
    let m := Module.finrank K₀ F
    have hm : 1 ≤ m := Module.finrank_pos
    let b : Module.Basis (Fin m) K₀ F := Module.finBasis K₀ F
    let τ := Fin N × Fin m
    let linForm : Fin N → MvPolynomial τ F :=
      fun i => ∑ v : Fin m, MvPolynomial.C (b v) * MvPolynomial.X (i, v)
    have hlin_hom : ∀ i : Fin N, (linForm i).IsHomogeneous 1 := by
      intro i
      apply MvPolynomial.IsHomogeneous.sum
      intro v _
      simpa using (MvPolynomial.isHomogeneous_C τ (b v)).mul (MvPolynomial.isHomogeneous_X F (i, v))
    let P_hat : MvPolynomial τ F := MvPolynomial.eval₂ MvPolynomial.C linForm P
    have hprod_lin : ∀ (S : Finset (Fin N)) (α : Fin N →₀ ℕ),
        (∏ i ∈ S, (linForm i) ^ (α i)).IsHomogeneous (∑ i ∈ S, α i) := by
      intro S α
      induction S using Finset.cons_induction with
      | empty =>
        simpa using MvPolynomial.isHomogeneous_C τ (1 : F)
      | cons i s his ih =>
        rw [Finset.prod_cons, Finset.sum_cons]
        have hi_pow : ((linForm i) ^ (α i)).IsHomogeneous (α i) := by
          simpa using (hlin_hom i).pow (α i)
        exact hi_pow.mul ih
    have hP_hat_hom : P_hat.IsHomogeneous d := by
      dsimp [P_hat]
      rw [MvPolynomial.eval₂_eq]
      apply MvPolynomial.IsHomogeneous.sum
      intro α hα
      have hα_ne : P.coeff α ≠ 0 := MvPolynomial.mem_support_iff.mp hα
      have hα_deg : ∑ i ∈ α.support, α i = d := by
        have h1 := hP hα_ne
        simpa [Finsupp.weight_apply, Finsupp.sum] using h1
      have hmon := hprod_lin α.support α
      rw [hα_deg] at hmon
      simpa using (MvPolynomial.isHomogeneous_C τ (P.coeff α)).mul hmon
    let P_tilde : Fin m → MvPolynomial τ K₀ :=
      fun u => ∑ β ∈ P_hat.support, MvPolynomial.monomial β (b.coord u (P_hat.coeff β))
    have hcoeff_tilde : ∀ (u : Fin m) (γ : τ →₀ ℕ),
        (P_tilde u).coeff γ = b.coord u (P_hat.coeff γ) := by
      intro u γ
      dsimp [P_tilde]
      rw [MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_monomial]
      by_cases hγ : γ ∈ P_hat.support
      · rw [Finset.sum_eq_single γ]
        · simp
        · intro β _ hβ
          exact if_neg (fun (h : β = γ) => hβ h)
        · intro habs
          exact False.elim (habs hγ)
      · rw [Finset.sum_eq_zero]
        · have h0 : P_hat.coeff γ = 0 := MvPolynomial.notMem_support_iff.mp hγ
          rw [h0, map_zero]
        · intro β hβ
          exact if_neg (fun (h : β = γ) => hγ (h ▸ hβ))
    have hP_tilde_hom : ∀ u : Fin m, (P_tilde u).IsHomogeneous d := by
      intro u γ hγ
      rw [hcoeff_tilde] at hγ
      exact hP_hat_hom (fun h0 => hγ (by rw [h0, map_zero]))
    let S_coeff : Finset K₀ :=
      Finset.univ.biUnion (fun u : Fin m => (P_tilde u).support.image (P_tilde u).coeff)
    obtain ⟨h_den, hh_den⟩ :=
      IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors A_pol) S_coeff
    have hh_ne_A : (h_den : A_pol) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp h_den.2
    have hh_inj : Function.Injective (algebraMap A_pol K₀) := IsFractionRing.injective A_pol K₀
    have hh_ne_K₀ : algebraMap A_pol K₀ (h_den : A_pol) ≠ 0 :=
      (map_ne_zero_iff (algebraMap A_pol K₀) hh_inj).mpr hh_ne_A
    have h_isInt : ∀ (u : Fin m) (β : τ →₀ ℕ), β ∈ (P_tilde u).support →
        IsLocalization.IsInteger A_pol (h_den • (P_tilde u).coeff β) := by
      intro u β hβ
      apply hh_den
      exact Finset.mem_biUnion.mpr ⟨u, Finset.mem_univ u, Finset.mem_image_of_mem _ hβ⟩
    let liftCoeff : Fin m → (τ →₀ ℕ) → A_pol := fun u β =>
      if hβ : β ∈ (P_tilde u).support then (h_isInt u β hβ).choose else 0
    have hlift_spec : ∀ (u : Fin m) (β : τ →₀ ℕ),
        algebraMap A_pol K₀ (liftCoeff u β) =
          algebraMap A_pol K₀ (h_den : A_pol) * (P_tilde u).coeff β := by
      intro u β
      dsimp [liftCoeff]
      split_ifs with hβ
      · exact (h_isInt u β hβ).choose_spec.trans (by rw [Submonoid.smul_def, Algebra.smul_def])
      · have h0 : (P_tilde u).coeff β = 0 := MvPolynomial.notMem_support_iff.mp hβ
        rw [map_zero, h0, mul_zero]
    let P₀ : Fin m → MvPolynomial τ A_pol :=
      fun u => ∑ β ∈ (P_tilde u).support, MvPolynomial.monomial β (liftCoeff u β)
    have hcoeff_P₀ : ∀ (u : Fin m) (γ : τ →₀ ℕ), (P₀ u).coeff γ = liftCoeff u γ := by
      intro u γ
      dsimp [P₀]
      rw [MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_monomial]
      by_cases hγ : γ ∈ (P_tilde u).support
      · rw [Finset.sum_eq_single γ]
        · simp
        · intro β _ hβ
          exact if_neg (fun (h : β = γ) => hβ h)
        · intro habs
          exact False.elim (habs hγ)
      · rw [Finset.sum_eq_zero]
        · dsimp [liftCoeff]
          rw [dif_neg hγ]
        · intro β hβ
          exact if_neg (fun (h : β = γ) => hγ (h ▸ hβ))
    have hP₀_hom : ∀ u : Fin m, (P₀ u).IsHomogeneous d := by
      intro u γ hγ
      rw [hcoeff_P₀] at hγ
      have hγ_mem : γ ∈ (P_tilde u).support := by
        by_contra hnot
        dsimp [liftCoeff] at hγ
        rw [dif_neg hnot] at hγ
        exact hγ rfl
      exact hP_tilde_hom u (MvPolynomial.mem_support_iff.mp hγ_mem)
    let B : ℕ :=
      Finset.univ.sup (fun u : Fin m => (P₀ u).support.sup (fun β => ((P₀ u).coeff β).natDegree))
    have hB_bound : ∀ (u : Fin m) (β : τ →₀ ℕ) (t : ℕ), B < t → ((P₀ u).coeff β).coeff t = 0 := by
      intro u β t ht
      by_cases hβ : β ∈ (P₀ u).support
      · apply Polynomial.coeff_eq_zero_of_natDegree_lt
        have h1 : ((P₀ u).coeff β).natDegree ≤
            (P₀ u).support.sup (fun γ => ((P₀ u).coeff γ).natDegree) :=
          Finset.le_sup (f := fun γ => ((P₀ u).coeff γ).natDegree) hβ
        have h2 : (P₀ u).support.sup (fun γ => ((P₀ u).coeff γ).natDegree) ≤ B :=
          Finset.le_sup (f := fun v : Fin m => (P₀ v).support.sup (fun γ => ((P₀ v).coeff γ).natDegree))
            (Finset.mem_univ u)
        omega
      · rw [MvPolynomial.notMem_support_iff.mp hβ, Polynomial.coeff_zero]
    let D : ℕ := m * (B + 1) + 1
    let K : ℕ := N * m * (D + 1)
    let e_var : τ × Fin (D + 1) ≃ Fin K :=
      (finProdFinEquiv.prodCongr (Equiv.refl (Fin (D + 1)))).trans finProdFinEquiv
    let R_Y := MvPolynomial (Fin K) k
    let A_ans : τ → Polynomial R_Y :=
      fun p => ∑ t : Fin (D + 1), Polynomial.C (MvPolynomial.X (e_var (p, t))) * Polynomial.X ^ t.1
    let Φ : MvPolynomial τ A_pol →+* Polynomial R_Y :=
      MvPolynomial.eval₂Hom (Polynomial.mapRingHom MvPolynomial.C) A_ans
    let IsGood : ℕ → ℕ → Polynomial R_Y → Prop := fun δ M_bd G =>
      (∀ t : ℕ, (G.coeff t).IsHomogeneous δ) ∧ (∀ t : ℕ, M_bd < t → G.coeff t = 0)
    have hGood_one : IsGood 0 0 (1 : Polynomial R_Y) := by
      refine ⟨fun t => ?_, fun t ht => ?_⟩
      · rcases eq_or_ne t 0 with rfl | ht0
        · simpa using MvPolynomial.isHomogeneous_C (Fin K) (1 : k)
        · simp [Polynomial.coeff_one, ht0]
          intro α hα
          exact False.elim (hα rfl)
      · have ht0 : t ≠ 0 := by omega
        simp [Polynomial.coeff_one, ht0]
    have hGood_mul : ∀ {δ₁ M₁ δ₂ M₂ : ℕ} {G₁ G₂ : Polynomial R_Y},
        IsGood δ₁ M₁ G₁ → IsGood δ₂ M₂ G₂ → IsGood (δ₁ + δ₂) (M₁ + M₂) (G₁ * G₂) := by
      intro δ₁ M₁ δ₂ M₂ G₁ G₂ h₁ h₂
      refine ⟨fun t => ?_, fun t ht => ?_⟩
      · rw [Polynomial.coeff_mul]
        apply MvPolynomial.IsHomogeneous.sum
        intro x _
        exact (h₁.1 x.1).mul (h₂.1 x.2)
      · rw [Polynomial.coeff_mul]
        apply Finset.sum_eq_zero
        intro x hx
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
        by_cases hx1 : M₁ < x.1
        · rw [h₁.2 x.1 hx1, zero_mul]
        · have hx2 : M₂ < x.2 := by omega
          rw [h₂.2 x.2 hx2, mul_zero]
    have hGood_pow : ∀ {G : Polynomial R_Y} (hG : IsGood 1 D G) (e : ℕ),
        IsGood e (e * D) (G ^ e) := by
      intro G hG e
      induction e with
      | zero =>
        simpa using hGood_one
      | succ e ih =>
        rw [pow_succ', Nat.succ_mul]
        simpa [Nat.add_comm] using hGood_mul hG ih
    have hGood_ans : ∀ p : τ, IsGood 1 D (A_ans p) := by
      intro p
      have hcoeff_ans : ∀ t : ℕ, (A_ans p).coeff t =
          if ht : t < D + 1 then MvPolynomial.X (e_var (p, ⟨t, ht⟩)) else 0 := by
        intro t
        dsimp [A_ans]
        rw [Polynomial.finset_sum_coeff]
        simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
        split_ifs with ht
        · rw [Finset.sum_eq_single ⟨t, ht⟩]
          · simp
          · intro j _ hj
            have hne : ¬ (t = j.1) := fun heq => hj (Fin.ext heq.symm)
            simp [hne]
          · intro habs
            exact False.elim (habs (Finset.mem_univ _))
        · apply Finset.sum_eq_zero
          intro j _
          have hne : ¬ (t = j.1) := by omega
          simp [hne]
      refine ⟨fun t => ?_, fun t ht => ?_⟩
      · rw [hcoeff_ans t]
        split_ifs with hlt
        · exact MvPolynomial.isHomogeneous_X k _
        · intro α hα
          exact False.elim (hα rfl)
      · rw [hcoeff_ans t]
        have hnot : ¬ (t < D + 1) := by omega
        exact dif_neg hnot
    have hGood_prod : ∀ (S : Finset τ) (β : τ →₀ ℕ),
        IsGood (∑ p ∈ S, β p) ((∑ p ∈ S, β p) * D) (∏ p ∈ S, (A_ans p) ^ (β p)) := by
      intro S β
      induction S using Finset.cons_induction with
      | empty =>
        simpa using hGood_one
      | cons p s hps ih =>
        rw [Finset.prod_cons, Finset.sum_cons, add_mul]
        exact hGood_mul (hGood_pow (hGood_ans p) (β p)) ih
    have hGood_Φ : ∀ u : Fin m, IsGood d (d * D + B) (Φ (P₀ u)) := by
      intro u
      change IsGood d (d * D + B)
        (MvPolynomial.eval₂ (Polynomial.mapRingHom MvPolynomial.C) A_ans (P₀ u))
      rw [MvPolynomial.eval₂_eq]
      have hterm : ∀ β ∈ (P₀ u).support, IsGood d (d * D + B)
          ((Polynomial.mapRingHom MvPolynomial.C) ((P₀ u).coeff β) *
            ∏ p ∈ β.support, A_ans p ^ β p) := by
        intro β hβ
        have hc_good : IsGood 0 B ((Polynomial.mapRingHom MvPolynomial.C) ((P₀ u).coeff β)) := by
          refine ⟨fun t => ?_, fun t ht => ?_⟩
          · rw [Polynomial.coe_mapRingHom, Polynomial.coeff_map]
            exact MvPolynomial.isHomogeneous_C (Fin K) _
          · rw [Polynomial.coe_mapRingHom, Polynomial.coeff_map, hB_bound u β t ht, map_zero]
        have hβ_deg : ∑ p ∈ β.support, β p = d := by
          have h1 := hP₀_hom u (MvPolynomial.mem_support_iff.mp hβ)
          simpa [Finsupp.weight_apply, Finsupp.sum] using h1
        have hp_good := hGood_prod β.support β
        rw [hβ_deg] at hp_good
        simpa [Nat.add_comm] using hGood_mul hc_good hp_good
      refine ⟨fun t => ?_, fun t ht => ?_⟩
      · rw [Polynomial.finset_sum_coeff]
        apply MvPolynomial.IsHomogeneous.sum
        intro β hβ
        exact (hterm β hβ).1 t
      · rw [Polynomial.finset_sum_coeff]
        apply Finset.sum_eq_zero
        intro β hβ
        exact (hterm β hβ).2 t ht
    let L_deg : ℕ := d * D + B + 1
    let s : ℕ := m * L_deg
    have hsK : s < K := by
      have hmd : m * d + 1 ≤ N * m := by nlinarith
      have hs_lt : s < (m * d + 1) * D := by
        dsimp [s, L_deg, D]
        nlinarith
      have hD_le : (m * d + 1) * D ≤ K := by
        dsimp [K]
        nlinarith
      omega
    let e_eq : Fin m × Fin L_deg ≃ Fin s := finProdFinEquiv
    let Q : Fin s → MvPolynomial (Fin K) k :=
      fun j => (Φ (P₀ (e_eq.symm j).1)).coeff (e_eq.symm j).2.1
    have hQ_hom : ∀ j : Fin s, (Q j).IsHomogeneous d :=
      fun j => (hGood_Φ (e_eq.symm j).1).1 (e_eq.symm j).2.1
    obtain ⟨c_K, hc_ne, hc_ev⟩ := s1_homog K s hsK (fun _ => d) (fun _ => hd) Q hQ_hom
    let f : τ → A_pol :=
      fun p => ∑ t : Fin (D + 1), Polynomial.C (c_K (e_var (p, t))) * Polynomial.X ^ t.1
    have hf_ne : f ≠ 0 := by
      intro hf0
      apply hc_ne
      ext idx
      obtain ⟨⟨p, t⟩, rfl⟩ := e_var.surjective idx
      have hfp : f p = 0 := congrFun hf0 p
      have hcoeff0 : (f p).coeff t.1 = 0 := by rw [hfp, Polynomial.coeff_zero]
      dsimp [f] at hcoeff0
      rw [Polynomial.finset_sum_coeff] at hcoeff0
      rw [Finset.sum_eq_single t] at hcoeff0
      · rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow_self, mul_one] at hcoeff0
        exact hcoeff0
      · intro j _ hj
        rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
          if_neg (fun heq => hj (Fin.ext heq.symm)), mul_zero]
      · intro habs
        exact False.elim (habs (Finset.mem_univ t))
    have hf_ev_P₀ : ∀ u : Fin m, MvPolynomial.eval f (P₀ u) = 0 := by
      intro u
      let ev_R : Polynomial R_Y →+* A_pol := Polynomial.mapRingHom (MvPolynomial.eval c_K)
      have hev_Φ : ev_R (Φ (P₀ u)) = MvPolynomial.eval f (P₀ u) := by
        have hΦ_eq : Φ (P₀ u) =
            MvPolynomial.eval₂ (Polynomial.mapRingHom MvPolynomial.C) A_ans (P₀ u) := rfl
        rw [hΦ_eq, MvPolynomial.eval₂_eq, MvPolynomial.eval_eq, map_sum]
        apply Finset.sum_congr rfl
        intro β _
        rw [map_mul, map_prod]
        congr 1
        · ext t
          dsimp [ev_R]
          rw [Polynomial.coe_mapRingHom, Polynomial.coeff_map, Polynomial.coeff_map,
            MvPolynomial.eval_C]
        · apply Finset.prod_congr rfl
          intro p _
          rw [map_pow]
          congr 1
          dsimp [A_ans, f, ev_R]
          rw [map_sum]
          apply Finset.sum_congr rfl
          intro t _
          rw [Polynomial.coe_mapRingHom, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow,
            Polynomial.map_X, MvPolynomial.eval_X]
      rw [← hev_Φ]
      ext t
      rw [Polynomial.coeff_zero, Polynomial.coe_mapRingHom, Polynomial.coeff_map]
      by_cases ht : t < L_deg
      · let j : Fin s := e_eq (u, ⟨t, ht⟩)
        have hj : e_eq.symm j = (u, ⟨t, ht⟩) := e_eq.symm_apply_apply _
        have hQj := hc_ev j
        dsimp [Q] at hQj
        rwa [hj] at hQj
      · have ht_gt : d * D + B < t := by dsimp [L_deg] at ht; omega
        rw [(hGood_Φ u).2 t ht_gt, map_zero]
    let w : τ → K₀ := fun p => algebraMap A_pol K₀ (f p)
    have hw_ne : w ≠ 0 := by
      intro hw0
      apply hf_ne
      funext p
      exact hh_inj (by simpa [w] using congrFun hw0 p)
    have hw_ev_tilde : ∀ u : Fin m, MvPolynomial.eval w (P_tilde u) = 0 := by
      intro u
      have hmul0 : algebraMap A_pol K₀ (h_den : A_pol) * MvPolynomial.eval w (P_tilde u) = 0 := by
        have h1 : algebraMap A_pol K₀ (MvPolynomial.eval f (P₀ u)) =
            algebraMap A_pol K₀ (h_den : A_pol) * MvPolynomial.eval w (P_tilde u) := by
          rw [MvPolynomial.eval_eq, MvPolynomial.eval_eq, map_sum, Finset.mul_sum]
          have hsupp : (P₀ u).support ⊆ (P_tilde u).support := by
            intro β hβ
            have hne := MvPolynomial.mem_support_iff.mp hβ
            rw [hcoeff_P₀] at hne
            by_contra hnot
            dsimp [liftCoeff] at hne
            rw [dif_neg hnot] at hne
            exact hne rfl
          rw [Finset.sum_subset hsupp]
          · apply Finset.sum_congr rfl
            intro β _
            rw [map_mul, map_prod, hcoeff_P₀, hlift_spec, mul_assoc]
            congr 2
            apply Finset.prod_congr rfl
            intro p _
            rw [map_pow]
          · intro β _ hβ_not
            have h0 : (P₀ u).coeff β = 0 := MvPolynomial.notMem_support_iff.mp hβ_not
            rw [h0, zero_mul, map_zero]
        rw [← h1, hf_ev_P₀ u, map_zero]
      exact (mul_eq_zero.mp hmul0).resolve_left hh_ne_K₀
    let x : Fin N → F := fun i => ∑ v : Fin m, w (i, v) • b v
    have hx_ne : x ≠ 0 := by
      intro hx0
      apply hw_ne
      ext ⟨i, v⟩
      have hxi : x i = 0 := congrFun hx0 i
      have hcoord : b.coord v (x i) = 0 := by rw [hxi, map_zero]
      dsimp [x] at hcoord
      rw [map_sum] at hcoord
      rw [Finset.sum_eq_single v] at hcoord
      · rw [LinearMap.map_smul, b.coord_apply, b.repr_self, Finsupp.single_eq_same,
          smul_eq_mul, mul_one] at hcoord
        exact hcoord
      · intro v' _ hv'
        rw [LinearMap.map_smul, b.coord_apply, b.repr_self,
          Finsupp.single_eq_of_ne (Ne.symm hv'), smul_eq_mul, mul_zero]
      · intro habs
        exact False.elim (habs (Finset.mem_univ v))
    refine ⟨x, hx_ne, ?_⟩
    apply b.ext_elem
    intro v
    rw [map_zero]
    let w_F : τ → F := fun p => algebraMap K₀ F (w p)
    have hev_hat : MvPolynomial.eval x P = MvPolynomial.eval w_F P_hat := by
      dsimp [P_hat]
      rw [MvPolynomial.eval_eq, MvPolynomial.eval₂_eq, map_sum]
      apply Finset.sum_congr rfl
      intro α _
      rw [map_mul, MvPolynomial.eval_C, map_prod]
      congr 1
      apply Finset.prod_congr rfl
      intro i _
      rw [map_pow]
      congr 1
      dsimp [linForm, x, w_F]
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro u _
      rw [map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X, Algebra.smul_def, mul_comm]
    have hcoord_hat : b.coord v (MvPolynomial.eval w_F P_hat) = MvPolynomial.eval w (P_tilde v) := by
      rw [MvPolynomial.eval_eq, MvPolynomial.eval_eq]
      have hsum_smul : (∑ β ∈ P_hat.support, P_hat.coeff β * ∏ p ∈ β.support, w_F p ^ β p) =
          ∑ β ∈ P_hat.support, (∏ p ∈ β.support, w p ^ β p) • P_hat.coeff β := by
        apply Finset.sum_congr rfl
        intro β _
        rw [Algebra.smul_def, mul_comm]
        congr 1
        rw [map_prod]
        apply Finset.prod_congr rfl
        intro p _
        rw [map_pow]
      rw [hsum_smul, map_sum]
      have hsupp_sub : (P_tilde v).support ⊆ P_hat.support := by
        intro β hβ
        have hne := MvPolynomial.mem_support_iff.mp hβ
        rw [hcoeff_tilde] at hne
        exact MvPolynomial.mem_support_iff.mpr (fun h0 => hne (by rw [h0, map_zero]))
      rw [Finset.sum_subset hsupp_sub]
      · apply Finset.sum_congr rfl
        intro β _
        rw [LinearMap.map_smul, smul_eq_mul, mul_comm, hcoeff_tilde]
      · intro β _ hnot
        rw [MvPolynomial.notMem_support_iff.mp hnot, zero_mul]
    change b.coord v (MvPolynomial.eval x P) = 0
    rw [hev_hat, hcoord_hat, hw_ev_tilde v]
  clear s1_homog
  
  have s3_norm : ∀ (F : Type u) [Field F],
      (∀ (d N : ℕ), 1 ≤ d → d < N → ∀ P : MvPolynomial (Fin N) F,
        P.IsHomogeneous d → ∃ x : Fin N → F, x ≠ 0 ∧ MvPolynomial.eval x P = 0) →
      ∀ (L' : Type u) [Field L'] [Algebra F L'] [FiniteDimensional F L'],
        Function.Surjective (Algebra.norm F : L' → F) := by
    intro F _ hC1 L' _ _ _ a
    by_cases ha : a = 0
    · subst ha
      exact ⟨0, (Algebra.norm_eq_zero_iff (R := F) (S := L')).mpr rfl⟩
    let d := Module.finrank F L'
    have hd : 1 ≤ d := Module.finrank_pos
    let e : Module.Basis (Fin d) F L' := Module.finBasis F L'
    let M_mat : Matrix (Fin d) (Fin d) (MvPolynomial (Fin (d + 1)) F) :=
      fun i j => ∑ l : Fin d,
        MvPolynomial.C (Algebra.leftMulMatrix e (e l) i j) * MvPolynomial.X l.succ
    have hM_hom : ∀ i j, (M_mat i j).IsHomogeneous 1 := by
      intro i j
      dsimp [M_mat]
      apply MvPolynomial.IsHomogeneous.sum
      intro l _
      simpa using
        (MvPolynomial.isHomogeneous_C (Fin (d + 1)) (Algebra.leftMulMatrix e (e l) i j)).mul
          (MvPolynomial.isHomogeneous_X F l.succ)
    have hprod_hom : ∀ (S : Finset (Fin d)) (f : Fin d → MvPolynomial (Fin (d + 1)) F),
        (∀ i ∈ S, (f i).IsHomogeneous 1) → (∏ i ∈ S, f i).IsHomogeneous S.card := by
      intro S f hf
      induction S using Finset.cons_induction with
      | empty =>
        simpa using MvPolynomial.isHomogeneous_C (Fin (d + 1)) (1 : F)
      | cons x s hxs ih =>
        rw [Finset.prod_cons, Finset.card_cons]
        have hmul := (hf x (Finset.mem_cons_self x s)).mul
          (ih (fun i hi => hf i (Finset.mem_cons_of_mem hi)))
        exact (Nat.add_comm 1 s.card) ▸ hmul
    have hneg_hom : ∀ {deg_n : ℕ} {P : MvPolynomial (Fin (d + 1)) F},
        P.IsHomogeneous deg_n → (-P).IsHomogeneous deg_n := by
      intro deg_n P hP m hm
      exact hP (by simpa [MvPolynomial.coeff_neg] using hm)
    have hdet_hom : M_mat.det.IsHomogeneous d := by
      rw [Matrix.det_apply]
      apply MvPolynomial.IsHomogeneous.sum
      intro σ _
      have hp : (∏ i : Fin d, M_mat (σ i) i).IsHomogeneous d := by
        simpa [d] using hprod_hom Finset.univ (fun i => M_mat (σ i) i) (fun i _ => hM_hom (σ i) i)
      rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with hσ | hσ
      · simpa [hσ] using hp
      · simpa [hσ] using hneg_hom hp
    let Q : MvPolynomial (Fin (d + 1)) F := M_mat.det - MvPolynomial.C a * (MvPolynomial.X 0) ^ d
    have hQ_hom : Q.IsHomogeneous d := by
      have hterm2 :
          (MvPolynomial.C a * (MvPolynomial.X 0 : MvPolynomial (Fin (d + 1)) F) ^ d).IsHomogeneous d := by
        simpa using
          (MvPolynomial.isHomogeneous_C (Fin (d + 1)) a).mul
            ((MvPolynomial.isHomogeneous_X F (0 : Fin (d + 1))).pow d)
      rw [show Q = M_mat.det + -(MvPolynomial.C a * (MvPolynomial.X 0) ^ d) from sub_eq_add_neg _ _]
      exact hdet_hom.add (hneg_hom hterm2)
    obtain ⟨x, hx_ne, hx_ev⟩ := hC1 d (d + 1) hd (Nat.lt_succ_self d) Q hQ_hom
    let y₁ : L' := ∑ l : Fin d, x l.succ • e l
    have hmat_ev : (MvPolynomial.eval x).mapMatrix M_mat = Algebra.leftMulMatrix e y₁ := by
      have hlin : Algebra.leftMulMatrix e y₁ =
          ∑ l : Fin d, x l.succ • Algebra.leftMulMatrix e (e l) := by
        dsimp [y₁]
        rw [map_sum]
        apply Finset.sum_congr rfl
        intro l _
        exact map_smul (Algebra.leftMulMatrix e) (x l.succ) (e l)
      rw [hlin]
      ext i j
      rw [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.sum_apply]
      dsimp [M_mat]
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro l _
      rw [map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]
      exact mul_comm ((Algebra.leftMulMatrix e) (e l) i j) (x l.succ)
    have hdet_ev : MvPolynomial.eval x M_mat.det = Algebra.norm F y₁ := by
      rw [Algebra.norm_eq_matrix_det e y₁, ← hmat_ev, RingHom.map_det]
    have hnorm_y₁ : Algebra.norm F y₁ = a * (x 0) ^ d := by
      have hsub : MvPolynomial.eval x M_mat.det - a * (x 0) ^ d = 0 := by
        simpa [Q] using hx_ev
      rw [hdet_ev] at hsub
      exact sub_eq_zero.mp hsub
    have hx0 : x 0 ≠ 0 := by
      intro hx0_eq
      have hy₁_zero : y₁ = 0 := by
        apply (Algebra.norm_eq_zero_iff (S := L') (R := F)).mp
        rw [hnorm_y₁, hx0_eq, zero_pow (by omega), mul_zero]
      apply hx_ne
      ext i
      refine Fin.cases hx0_eq (fun l => ?_) i
      have hcoord : e.coord l y₁ = 0 := by rw [hy₁_zero, map_zero]
      dsimp [y₁] at hcoord
      rw [map_sum] at hcoord
      rw [Finset.sum_eq_single l] at hcoord
      · rw [LinearMap.map_smul, e.coord_apply, e.repr_self, Finsupp.single_eq_same,
          smul_eq_mul, mul_one] at hcoord
        exact hcoord
      · intro l' _ hl'
        rw [LinearMap.map_smul, e.coord_apply, e.repr_self,
          Finsupp.single_eq_of_ne (Ne.symm hl'), smul_eq_mul, mul_zero]
      · intro habs
        exact False.elim (habs (Finset.mem_univ l))
    refine ⟨(x 0)⁻¹ • y₁, ?_⟩
    rw [Algebra.smul_def, map_mul, Algebra.norm_algebraMap, hnorm_y₁]
    change ((x 0)⁻¹) ^ d * (a * (x 0) ^ d) = a
    have hpow : ((x 0)⁻¹) ^ d * (x 0) ^ d = 1 := by
      rw [← mul_pow, inv_mul_cancel₀ hx0, one_pow]
    linear_combination a * hpow
  
  have s4_cyc : ∀ (F L' : Type u) [Field F] [Field L']
      [Algebra F L'] [FiniteDimensional F L'] [IsGalois F L'] [IsCyclic Gal(L'/F)],
      Function.Surjective (Algebra.norm F : L' → F) →
      ∀ (m_deg : ℕ), 1 ≤ m_deg → Subsingleton ↥(groupCohomology (weilGalUnitsRep F L') m_deg) := by
    intro F L' _ _ _ _ _ _ hNorm m_deg hm_deg
    let A := weilGalUnitsRep F L'
    let toMulA : ↥A → (L')ˣ := fun y => Additive.toMul (y : Additive (L')ˣ)
    let ofMulA : (L')ˣ → ↥A := fun u => (Additive.ofMul u : Additive (L')ˣ)
    have hto_of : ∀ u : (L')ˣ, toMulA (ofMulA u) = u := fun _ => rfl
    have hof_inj : Function.Injective toMulA := fun _ _ h => h
    have hto_add : ∀ x y : ↥A, toMulA (x + y) = toMulA x * toMulA y := fun _ _ => rfl
    have hto_sub : ∀ x y : ↥A, toMulA (x - y) = toMulA x / toMulA y := fun _ _ =>
      toMul_sub _ _
    have hρ_val : ∀ (σ : Gal(L'/F)) (y : ↥A), (toMulA ((A.ρ σ) y)).val = σ (toMulA y).val :=
      fun _ _ => rfl
    have hρ_mul : ∀ (σ : Gal(L'/F)) (y : ↥A), toMulA ((A.ρ σ) y) = σ • toMulA y := by
