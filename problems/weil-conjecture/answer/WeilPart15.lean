          have hL₂ := (h_ex_lift₁ m W₂ α₂ hα₂).choose_spec
          let L₁ := (h_ex_lift₁ m W₁ (α₂.comp u.toRingHom) hα₁_compat).choose
          have hL₁ := (h_ex_lift₁ m W₁ (α₂.comp u.toRingHom) hα₁_compat).choose_spec
          let _ : CommRing L₂.1 := L₂.2.1
          let _ : Algebra R₁ L₂.1 := L₂.2.2.1
          have _ : Algebra.Etale R₁ L₂.1 := L₂.2.2.2.1.down
          let _ : Algebra L₂.1 Ω := L₂.2.2.2.2.1
          have _ : IsScalarTower R₁ L₂.1 Ω := L₂.2.2.2.2.2.1.down
          let _ : CommRing L₁.1 := L₁.2.1
          let _ : Algebra R₁ L₁.1 := L₁.2.2.1
          have _ : Algebra.Etale R₁ L₁.1 := L₁.2.2.2.1.down
          let _ : Algebra L₁.1 Ω := L₁.2.2.2.2.1
          have _ : IsScalarTower R₁ L₁.1 Ω := L₁.2.2.2.2.2.1.down
          have h_comp_B : (L₂.2.2.2.2.2.2.comp u.toRingHom).comp (algebraMap B₀ W₁) =
