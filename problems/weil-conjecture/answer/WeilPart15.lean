      have h_alg_eq : algebraMap R₀ (MvPolynomial (Fin n) R₀ ⧸ I) =
          θ.symm.toRingHom.comp (algebraMap R₀ S) :=
        RingHom.ext fun r => (θ.symm.commutes r).symm
      have h_et_S : (algebraMap R₀ S).Etale := RingHom.etale_algebraMap.mpr inferInstance
      have h_et_symm : θ.symm.toRingHom.Etale := RingHom.Etale.of_bijective θ.symm.bijective
      have h_et_Q : Algebra.Etale R₀ (MvPolynomial (Fin n) R₀ ⧸ I) := by
        apply RingHom.etale_algebraMap.mp
        rw [h_alg_eq]
        exact RingHom.Etale.stableUnderComposition _ _ h_et_S h_et_symm
      exact ⟨n, I, h_et_Q, ⟨θ⟩⟩
    · intro S₁ S₂ _ _ _ _ _ _ ψ₂ u₁ u₂ hψ₂
      obtain ⟨e, he_one, he_ann⟩ := h_diag S₁ S₂ ψ₂ u₁ u₂ hψ₂
      let S₃ : Type u := Localization.Away e
      have h_et_loc : Algebra.Etale S₂ S₃ := Algebra.Etale.of_isLocalizationAway e
      have h_et_R₀ : Algebra.Etale R₀ S₃ := Algebra.Etale.comp R₀ S₂ S₃
      let v : S₂ →ₐ[R₀] S₃ := IsScalarTower.toAlgHom R₀ S₂ S₃
      have hv_et : v.toRingHom.Etale := RingHom.etale_algebraMap.mpr h_et_loc
      have he_unit : IsUnit (ψ₂ e) := by rw [he_one]; exact isUnit_one
      let ψ₃ : S₃ →+* Ω := IsLocalization.Away.lift e he_unit
      refine ⟨S₃, inferInstance, inferInstance, h_et_R₀, v, ψ₃, hv_et, ?_, ?_⟩
      · exact RingHom.ext fun x => IsLocalization.Away.lift_eq e he_unit x
      · refine AlgHom.ext fun s => ?_
        obtain ⟨u_e, hu_e⟩ := IsLocalization.Away.algebraMap_isUnit (S := S₃) e
        apply sub_eq_zero.mp
        have h_mul : (v (u₁ s) - v (u₂ s)) * algebraMap S₂ S₃ e = 0 := by
          dsimp [v]
          rw [← map_sub, ← map_mul, he_ann s, map_zero]
        rw [← hu_e] at h_mul
        have h_cancel := congrArg (· * (↑(u_e⁻¹) : S₃)) h_mul
        rw [mul_assoc, ← Units.val_mul, mul_inv_cancel, Units.val_one, mul_one, zero_mul] at h_cancel
        exact h_cancel
    · intro S A _ _ _ _ _ _ _ hKerA φ₁ φ₂ hφ
      obtain ⟨e, he_one, he_ann⟩ := h_diag S A (algebraMap A Ω) φ₁ φ₂ hφ
      have he_not_mem : e ∉ IsLocalRing.maximalIdeal A := by
        rw [hKerA, RingHom.mem_ker, he_one]
        exact one_ne_zero
      obtain ⟨u_e, hu_e⟩ := IsLocalRing.notMem_maximalIdeal.mp he_not_mem
      refine AlgHom.ext fun s => ?_
      apply sub_eq_zero.mp
      have h_mul := he_ann s
      rw [← hu_e] at h_mul
      have h_cancel := congrArg (· * (↑(u_e⁻¹) : A)) h_mul
      rw [mul_assoc, ← Units.val_mul, mul_inv_cancel, Units.val_one, mul_one, zero_mul] at h_cancel
      exact h_cancel
  obtain ⟨hPres_quot, hCoeq, hUniq⟩ := h_pillar1

  
  have h_pillar2 :
      ∃ (ℐ : Type u) (_ : CategoryTheory.SmallCategory ℐ) (_ : CategoryTheory.IsFiltered ℐ)
        (R_obj : ℐ → Type u) (_ : ∀ i, CommRing (R_obj i))
        (_ : ∀ i, Algebra R₀ (R_obj i)) (_ : ∀ i, Algebra.Etale R₀ (R_obj i))
        (pt : ∀ i : ℐ, R_obj i →+* Ω)
        (tr : ∀ {i j : ℐ}, (i ⟶ j) → (R_obj i →ₐ[R₀] R_obj j))
        (A : Type u) (_ : CommRing A) (_ : IsLocalRing A)
        (_ : Algebra R₀ A) (_ : Algebra A Ω) (_ : IsScalarTower R₀ A Ω)
        (ι : ∀ i : ℐ, R_obj i →ₐ[R₀] A),
        (∀ i : ℐ, (pt i).comp (algebraMap R₀ (R_obj i)) = algebraMap R₀ Ω) ∧
        (∀ i : ℐ, tr (CategoryTheory.CategoryStruct.id i) = AlgHom.id R₀ (R_obj i)) ∧
        (∀ {i j k : ℐ} (f : i ⟶ j) (g : j ⟶ k),
          tr (CategoryTheory.CategoryStruct.comp f g) = (tr g).comp (tr f)) ∧
        (∀ {i j : ℐ} (f : i ⟶ j), (tr f).toRingHom.Etale) ∧
        (∀ {i j : ℐ} (f : i ⟶ j), (pt j).comp (tr f).toRingHom = pt i) ∧
        IsLocalRing.maximalIdeal A = RingHom.ker (algebraMap A Ω) ∧
        (∀ i : ℐ, (algebraMap A Ω).comp (ι i).toRingHom = pt i) ∧
        (∀ {i j : ℐ} (f : i ⟶ j), (ι j).comp (tr f) = ι i) ∧
        (∀ a : A, ∃ (i : ℐ) (r : R_obj i), ι i r = a) ∧
        (∀ (i : ℐ) (r₁ r₂ : R_obj i),
          ι i r₁ = ι i r₂ → ∃ (k : ℐ) (f : i ⟶ k), tr f r₁ = tr f r₂) ∧
        (∀ (S : Type u) [CommRing S] [Algebra R₀ S] [Algebra.Etale R₀ S] (ψ_S : S →+* Ω),
          ψ_S.comp (algebraMap R₀ S) = algebraMap R₀ Ω →
          ∃ (i : ℐ) (θ : R_obj i ≃ₐ[R₀] S), pt i = ψ_S.comp θ.toRingHom) := by
    let ℐ : Type u :=
      Σ (n : ℕ) (I : Ideal (MvPolynomial (Fin n) R₀)),
        PLift (Algebra.Etale R₀ (MvPolynomial (Fin n) R₀ ⧸ I)) ×
        { pt : (MvPolynomial (Fin n) R₀ ⧸ I) →+* Ω //
          pt.comp (algebraMap R₀ (MvPolynomial (Fin n) R₀ ⧸ I)) = algebraMap R₀ Ω }
    let R_obj : ℐ → Type u := fun i => MvPolynomial (Fin i.1) R₀ ⧸ i.2.1
    let instComm : ∀ i : ℐ, CommRing (R_obj i) :=
      fun i => inferInstanceAs (CommRing (MvPolynomial (Fin i.1) R₀ ⧸ i.2.1))
    let instAlg : ∀ i : ℐ, Algebra R₀ (R_obj i) :=
      fun i => inferInstanceAs (Algebra R₀ (MvPolynomial (Fin i.1) R₀ ⧸ i.2.1))
    let instEt : ∀ i : ℐ, Algebra.Etale R₀ (R_obj i) := fun i => i.2.2.1.down
    let pt : ∀ i : ℐ, R_obj i →+* Ω := fun i => i.2.2.2.1
    have hpt_R₀ : ∀ i : ℐ, (pt i).comp (algebraMap R₀ (R_obj i)) = algebraMap R₀ Ω :=
      fun i => i.2.2.2.2
    let instCat : CategoryTheory.SmallCategory ℐ :=
      { Hom := fun i j =>
          { u : R_obj i →ₐ[R₀] R_obj j //
            u.toRingHom.Etale ∧ (pt j).comp u.toRingHom = pt i }
        id := fun i =>
          ⟨AlgHom.id R₀ (R_obj i), RingHom.Etale.of_bijective Function.bijective_id,
            RingHom.comp_id (pt i)⟩
        comp := fun {i j k} f g =>
          ⟨g.1.comp f.1, RingHom.Etale.stableUnderComposition _ _ f.2.1 g.2.1,
            RingHom.ext fun x =>
              (RingHom.congr_fun g.2.2 (f.1 x)).trans (RingHom.congr_fun f.2.2 x)⟩
        id_comp := fun f => Subtype.ext (AlgHom.comp_id f.1)
        comp_id := fun f => Subtype.ext (AlgHom.id_comp f.1)
        assoc := fun f g h => Subtype.ext (AlgHom.comp_assoc h.1 g.1 f.1).symm }
    let tr : ∀ {i j : ℐ}, (i ⟶ j) → (R_obj i →ₐ[R₀] R_obj j) := fun f => f.1
    have hPres : ∀ (S : Type u) [CommRing S] [Algebra R₀ S] [Algebra.Etale R₀ S]
        (ψ_S : S →+* Ω),
        ψ_S.comp (algebraMap R₀ S) = algebraMap R₀ Ω →
        ∃ (i : ℐ) (θ : R_obj i ≃ₐ[R₀] S), pt i = ψ_S.comp θ.toRingHom := by
      intro S _ _ _ ψ_S hψ_S
      obtain ⟨n, I, hEt_I, ⟨θ⟩⟩ := hPres_quot S
      have h_comp : (ψ_S.comp θ.toRingHom).comp
          (algebraMap R₀ (MvPolynomial (Fin n) R₀ ⧸ I)) = algebraMap R₀ Ω :=
        RingHom.ext fun r₀ => by
          change ψ_S (θ (algebraMap R₀ (MvPolynomial (Fin n) R₀ ⧸ I) r₀)) = algebraMap R₀ Ω r₀
          rw [θ.commutes]
          exact RingHom.congr_fun hψ_S r₀
      exact ⟨⟨n, I, ⟨hEt_I⟩, ⟨ψ_S.comp θ.toRingHom, h_comp⟩⟩, θ, rfl⟩
    obtain ⟨i₀, _⟩ := hPres R₀ (algebraMap R₀ Ω) (RingHom.comp_id _)
    have : Nonempty ℐ := ⟨i₀⟩
    have : CategoryTheory.IsFilteredOrEmpty ℐ := by
      refine CategoryTheory.IsFilteredOrEmpty.mk ?_ ?_
      · intro i₁ i₂
        let S : Type u := TensorProduct R₀ (R_obj i₁) (R_obj i₂)
        have hEt_S : Algebra.Etale R₀ S := Algebra.Etale.comp R₀ (R_obj i₁) S
        let pt₁_alg : R_obj i₁ →ₐ[R₀] Ω := { pt i₁ with commutes' := RingHom.congr_fun (hpt_R₀ i₁) }
        let pt₂_alg : R_obj i₂ →ₐ[R₀] Ω := { pt i₂ with commutes' := RingHom.congr_fun (hpt_R₀ i₂) }
        let ψ_S_alg : S →ₐ[R₀] Ω :=
          Algebra.TensorProduct.lift pt₁_alg pt₂_alg (fun _ _ => Commute.all _ _)
        have hψ_S_R₀ : ψ_S_alg.toRingHom.comp (algebraMap R₀ S) = algebraMap R₀ Ω :=
          RingHom.ext fun r₀ => ψ_S_alg.commutes r₀
        obtain ⟨k, θ, hpt_k⟩ := hPres S ψ_S_alg.toRingHom hψ_S_R₀
        let inc₁ : R_obj i₁ →ₐ[R₀] S := IsScalarTower.toAlgHom R₀ (R_obj i₁) S
        let inc₂ : R_obj i₂ →ₐ[R₀] S := Algebra.TensorProduct.includeRight
        have h_et_inc₁ : inc₁.toRingHom.Etale :=
          RingHom.etale_algebraMap.mpr (inferInstance : Algebra.Etale (R_obj i₁) S)
        let e_comm : TensorProduct R₀ (R_obj i₂) (R_obj i₁) ≃ₐ[R₀] S :=
          Algebra.TensorProduct.comm R₀ (R_obj i₂) (R_obj i₁)
        have h_inc₂_eq : inc₂.toRingHom =
            e_comm.toRingHom.comp (algebraMap (R_obj i₂) (TensorProduct R₀ (R_obj i₂) (R_obj i₁))) :=
          RingHom.ext fun y => rfl
        have h_et_inc₂ : inc₂.toRingHom.Etale := by
          rw [h_inc₂_eq]
          exact RingHom.Etale.stableUnderComposition _ _
            (RingHom.etale_algebraMap.mpr
              (inferInstance : Algebra.Etale (R_obj i₂) (TensorProduct R₀ (R_obj i₂) (R_obj i₁))))
            (RingHom.Etale.of_bijective e_comm.bijective)
        have h_et_symm : θ.symm.toRingHom.Etale := RingHom.Etale.of_bijective θ.symm.bijective
        let f₁ : i₁ ⟶ k :=
          ⟨θ.symm.toAlgHom.comp inc₁,
            RingHom.Etale.stableUnderComposition _ _ h_et_inc₁ h_et_symm,
            RingHom.ext fun x => by
              change pt k (θ.symm (x ⊗ₜ[R₀] 1)) = pt i₁ x
              rw [hpt_k]
              change ψ_S_alg (θ (θ.symm (x ⊗ₜ[R₀] 1))) = pt i₁ x
              rw [θ.apply_symm_apply, Algebra.TensorProduct.lift_tmul]
              change pt i₁ x * pt i₂ 1 = pt i₁ x
              rw [map_one, mul_one]⟩
        let f₂ : i₂ ⟶ k :=
          ⟨θ.symm.toAlgHom.comp inc₂,
            RingHom.Etale.stableUnderComposition _ _ h_et_inc₂ h_et_symm,
            RingHom.ext fun y => by
              change pt k (θ.symm (1 ⊗ₜ[R₀] y)) = pt i₂ y
              rw [hpt_k]
              change ψ_S_alg (θ (θ.symm (1 ⊗ₜ[R₀] y))) = pt i₂ y
              rw [θ.apply_symm_apply, Algebra.TensorProduct.lift_tmul]
              change pt i₁ 1 * pt i₂ y = pt i₂ y
              rw [map_one, one_mul]⟩
        exact ⟨k, f₁, f₂, trivial⟩
      · intro i₁ i₂ f g
        have h_eq_pt : (pt i₂).comp f.1.toRingHom = (pt i₂).comp g.1.toRingHom :=
          f.2.2.trans g.2.2.symm
        obtain ⟨S₃, _, _, _, v, ψ₃, hv_et, hψ₃, hv_eq⟩ :=
          hCoeq (R_obj i₁) (R_obj i₂) (pt i₂) f.1 g.1 h_eq_pt
        have hψ₃_R₀ : ψ₃.comp (algebraMap R₀ S₃) = algebraMap R₀ Ω := by
          have hv_R₀ : v.toRingHom.comp (algebraMap R₀ (R_obj i₂)) = algebraMap R₀ S₃ :=
            RingHom.ext fun r₀ => v.commutes r₀
          rw [← hv_R₀, ← RingHom.comp_assoc, hψ₃, hpt_R₀ i₂]
        obtain ⟨k, θ, hpt_k⟩ := hPres S₃ ψ₃ hψ₃_R₀
        have h_et_symm : θ.symm.toRingHom.Etale := RingHom.Etale.of_bijective θ.symm.bijective
        let h_hom : i₂ ⟶ k :=
          ⟨θ.symm.toAlgHom.comp v,
            RingHom.Etale.stableUnderComposition _ _ hv_et h_et_symm,
            RingHom.ext fun x => by
              change pt k (θ.symm (v x)) = pt i₂ x
              rw [hpt_k]
              change ψ₃ (θ (θ.symm (v x))) = pt i₂ x
              rw [θ.apply_symm_apply]
              exact RingHom.congr_fun hψ₃ x⟩
        refine ⟨k, h_hom, Subtype.ext ?_⟩
        change (θ.symm.toAlgHom.comp v).comp f.1 = (θ.symm.toAlgHom.comp v).comp g.1
        rw [AlgHom.comp_assoc, AlgHom.comp_assoc, hv_eq]
    have : CategoryTheory.IsFiltered ℐ := CategoryTheory.IsFiltered.mk
    let F : CategoryTheory.Functor ℐ CommRingCat.{u} :=
      { obj := fun i => CommRingCat.of (R_obj i)
        map := fun f => CommRingCat.ofHom (tr f).toRingHom
        map_id := fun _ => rfl
        map_comp := fun _ _ => rfl }
    let c_A := CommRingCat.FilteredColimits.colimitCocone F
    let hc_A := CommRingCat.FilteredColimits.colimitCoconeIsColimit F
    let A : Type u := c_A.pt
    let instCommA : CommRing A := inferInstanceAs (CommRing c_A.pt)
    let instAlgR₀A : Algebra R₀ A :=
      ((CommRingCat.Hom.hom (c_A.ι.app i₀)).comp (algebraMap R₀ (R_obj i₀))).toAlgebra
    have h_alg_indep : ∀ i : ℐ,
        (CommRingCat.Hom.hom (c_A.ι.app i)).comp (algebraMap R₀ (R_obj i)) = algebraMap R₀ A := by
      intro i
      let m : ℐ := CategoryTheory.IsFiltered.max i₀ i
      let u₀ : i₀ ⟶ m := CategoryTheory.IsFiltered.leftToMax i₀ i
      let u₁ : i ⟶ m := CategoryTheory.IsFiltered.rightToMax i₀ i
      have hw₀ := c_A.w u₀
      have hw₁ := c_A.w u₁
      refine RingHom.ext fun r₀ => ?_
      have h₁ : (CommRingCat.Hom.hom (c_A.ι.app i)) (algebraMap R₀ (R_obj i) r₀) =
          (CommRingCat.Hom.hom (c_A.ι.app m)) (algebraMap R₀ (R_obj m) r₀) := by
        have := congrArg (fun φ => CommRingCat.Hom.hom φ (algebraMap R₀ (R_obj i) r₀)) hw₁.symm
        exact this.trans (congrArg (CommRingCat.Hom.hom (c_A.ι.app m)) ((tr u₁).commutes r₀))
      have h₀ : algebraMap R₀ A r₀ =
          (CommRingCat.Hom.hom (c_A.ι.app m)) (algebraMap R₀ (R_obj m) r₀) := by
        change (CommRingCat.Hom.hom (c_A.ι.app i₀)) (algebraMap R₀ (R_obj i₀) r₀) = _
        have := congrArg (fun φ => CommRingCat.Hom.hom φ (algebraMap R₀ (R_obj i₀) r₀)) hw₀.symm
        exact this.trans (congrArg (CommRingCat.Hom.hom (c_A.ι.app m)) ((tr u₀).commutes r₀))
      exact h₁.trans h₀.symm
    let ι : ∀ i : ℐ, R_obj i →ₐ[R₀] A := fun i =>
      { CommRingCat.Hom.hom (c_A.ι.app i) with
        commutes' := RingHom.congr_fun (h_alg_indep i) }
    have hι_tr : ∀ {i j : ℐ} (f : i ⟶ j), (ι j).comp (tr f) = ι i := by
      intro i j f
      exact AlgHom.ext fun x => congrArg (fun φ => CommRingCat.Hom.hom φ x) (c_A.w f)
    let c_Ω : CategoryTheory.Limits.Cocone F :=
      { pt := CommRingCat.of Ω
        ι :=
          { app := fun i => CommRingCat.ofHom (pt i)
            naturality := fun {i j} f =>
              CommRingCat.hom_ext (RingHom.ext fun x => RingHom.congr_fun f.2.2 x) } }
    let φ_Ω : A →+* Ω := CommRingCat.Hom.hom (hc_A.desc c_Ω)
    let instAlgAΩ : Algebra A Ω := φ_Ω.toAlgebra
    have hι_pt : ∀ i : ℐ, (algebraMap A Ω).comp (ι i).toRingHom = pt i := by
      intro i
      exact RingHom.ext fun x => congrArg (fun ψ => CommRingCat.Hom.hom ψ x) (hc_A.fac c_Ω i)
    have : IsScalarTower R₀ A Ω := IsScalarTower.of_algebraMap_eq fun r₀ => by
      have h₁ : algebraMap A Ω (algebraMap R₀ A r₀) =
          ((algebraMap A Ω).comp (ι i₀).toRingHom) (algebraMap R₀ (R_obj i₀) r₀) := rfl
      rw [h₁, hι_pt i₀]
      exact (RingHom.congr_fun (hpt_R₀ i₀) r₀).symm
    let ht_A := CategoryTheory.Limits.isColimitOfPreserves (CategoryTheory.forget CommRingCat.{u}) hc_A
    have hSurj : ∀ a : A, ∃ (i : ℐ) (r : R_obj i), ι i r = a := by
      intro a
      exact CategoryTheory.Limits.Types.jointly_surjective_of_isColimit ht_A a
    have hEq : ∀ (i : ℐ) (r₁ r₂ : R_obj i),
        ι i r₁ = ι i r₂ → ∃ (k : ℐ) (f : i ⟶ k), tr f r₁ = tr f r₂ := by
      intro i r₁ r₂ h_eq
      obtain ⟨k₀, g₁, g₂, hg⟩ :=
        (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff
          (F ⋙ CategoryTheory.forget CommRingCat.{u}) ht_A).mp h_eq
      let k : ℐ := CategoryTheory.IsFiltered.coeq g₁ g₂
      let h_co : k₀ ⟶ k := CategoryTheory.IsFiltered.coeqHom g₁ g₂
      have h_cond : g₁ ≫ h_co = g₂ ≫ h_co := CategoryTheory.IsFiltered.coeq_condition g₁ g₂
      refine ⟨k, g₁ ≫ h_co, ?_⟩
      have hg' : tr g₁ r₁ = tr g₂ r₂ := hg
      calc
        tr (g₁ ≫ h_co) r₁ = tr h_co (tr g₁ r₁) := rfl
        _ = tr h_co (tr g₂ r₂) := by rw [hg']
        _ = tr (g₂ ≫ h_co) r₂ := rfl
        _ = tr (g₁ ≫ h_co) r₂ := by rw [h_cond]
    have : Nontrivial A := (algebraMap A Ω).domain_nontrivial
    have h_unit_iff : ∀ a : A, IsUnit a ↔ a ∉ RingHom.ker (algebraMap A Ω) := by
      intro a
      constructor
      · intro ha hmem
        rw [RingHom.mem_ker] at hmem
        exact (ha.map (algebraMap A Ω)).ne_zero hmem
      · intro ha_not_mem
        rw [RingHom.mem_ker] at ha_not_mem
        obtain ⟨i, x, rfl⟩ := hSurj a
        have hx_ne : pt i x ≠ 0 := by
          rw [← hι_pt i]
          exact ha_not_mem
        have hx_unit : IsUnit (pt i x) := IsUnit.mk0 _ hx_ne
        let S_x : Type u := Localization.Away x
        have hEt_loc : Algebra.Etale (R_obj i) S_x := Algebra.Etale.of_isLocalizationAway x
        have hEt_Sx : Algebra.Etale R₀ S_x := Algebra.Etale.comp R₀ (R_obj i) S_x
        let ψ_x : S_x →+* Ω := IsLocalization.Away.lift x hx_unit
        have hψ_x_i : ψ_x.comp (algebraMap (R_obj i) S_x) = pt i :=
          RingHom.ext fun y => IsLocalization.Away.lift_eq x hx_unit y
        have hψ_x_R₀ : ψ_x.comp (algebraMap R₀ S_x) = algebraMap R₀ Ω := by
          have h_sc : algebraMap R₀ S_x =
              (algebraMap (R_obj i) S_x).comp (algebraMap R₀ (R_obj i)) := rfl
          rw [h_sc, ← RingHom.comp_assoc, hψ_x_i, hpt_R₀ i]
