          change div_fn (Additive.ofMul
            ((Units.mk0 (germB₀ h_s) hhs_ne) ^ M_clear * u_Q)) x = _
          rw [ofMul_mul, map_add, ofMul_pow, map_nsmul, Finsupp.add_apply,
