        rw [hcv]
        let 𝔪_x := (hAff_U₀.primeIdealOf ⟨x.1, hx_in⟩).asIdeal
        by_cases hhs_mem : h_s ∈ 𝔪_x
        · have hhs_ge1 : 1 ≤ div_fn (Additive.ofMul (Units.mk0 (germB₀ h_s) hhs_ne)) x :=
