    have hG_type : Presheaf.IsSheaf J (G.obj ⋙ forget AddCommGrpCat.{u}) :=
      Presheaf.isSheaf_comp_of_isSheaf J G.obj (forget AddCommGrpCat.{u}) G.property
    have hbot : (⊥ : Sieve Z) ∈ J Z :=
      (hMemJ Z ⊥).mpr fun z => IsEmpty.elim hZ_emp z
    exact ⟨fun u₁ u₂ => (hG_type.isSheafFor _ hbot).isSeparatedFor.ext fun Y g hg => False.elim hg⟩

  have hAffNerve : ∀ (U W : X.Etale) [U.left.IsSeparated] [AlgebraicGeometry.IsAffine W.left]
      (w : W ⟶ U) (p : ℕ), AlgebraicGeometry.IsAffine (weilEtaleCechObj w p).left := by
    intro U W _ _ w p
    let t_U := CategoryTheory.Limits.terminal.from U.left
    have : AlgebraicGeometry.IsSeparated t_U :=
      (inferInstance : U.left.IsSeparated).isSeparated_terminal_from
    have : AlgebraicGeometry.IsAffineHom (w.left ≫ t_U) :=
      AlgebraicGeometry.isAffineHom_of_isAffine (w.left ≫ t_U)
    have : AlgebraicGeometry.IsAffineHom w.left :=
      AlgebraicGeometry.IsAffineHom.of_comp w.left t_U
    let FgtSch : X.Etale ⥤ AlgebraicGeometry.Scheme.{u} :=
      AlgebraicGeometry.Scheme.Etale.forget X ⋙ CategoryTheory.Over.forget X
    induction p with
    | zero =>
      change AlgebraicGeometry.IsAffine W.left
      infer_instance
    | succ p ih =>
      have : AlgebraicGeometry.IsAffine (weilEtaleCechObj w p).left := ih
      have : AlgebraicGeometry.IsAffine
          (CategoryTheory.Limits.pullback (weilEtaleCechHom w p).left w.left) :=
        AlgebraicGeometry.instIsAffinePullbackSchemeOfIsAffineHom_1
          (weilEtaleCechHom w p).left w.left
      let e_pb : (weilEtaleCechObj w (p + 1)).left ≅
          CategoryTheory.Limits.pullback (weilEtaleCechHom w p).left w.left :=
        CategoryTheory.Limits.PreservesPullback.iso FgtSch (weilEtaleCechHom w p) w
      exact AlgebraicGeometry.IsAffine.of_isIso e_pb.hom

  have hEpiCover : ∀ (G₁ G₂ : Sheaf J AddCommGrpCat.{u}) (π : G₁ ⟶ G₂) [CategoryTheory.Epi π]
      (U : X.Etale) [CompactSpace ↥U.left] (s : ↥(G₂.obj.obj (Opposite.op U))),
      ∃ (W : X.Etale) (_ : AlgebraicGeometry.IsAffine W.left)
        (w : W ⟶ U) (_ : AlgebraicGeometry.Surjective w.left)
        (t : ↥(G₁.obj.obj (Opposite.op W))),
        (π.hom.app (Opposite.op W)).hom t = (G₂.obj.map w.op).hom s := by
    intro G₁ G₂ π _ U _ s
    have hLocS : CategoryTheory.Sheaf.IsLocallySurjective π :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} π).mpr inferInstance
    have : CategoryTheory.Presheaf.IsLocallySurjective J π.hom :=
      (CategoryTheory.Sheaf.isLocallySurjective_sheafToPresheaf_map_iff π).mpr hLocS
    let R : Sieve U := CategoryTheory.Presheaf.imageSieve π.hom s
    have hR : R ∈ J U := CategoryTheory.Presheaf.imageSieve_mem J π.hom s
    have hR_pt : ∀ x : ↥U.left, ∃ (Y : X.Etale) (f : Y ⟶ U) (y : ↥Y.left),
        R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x :=
      (hMemJ U R).mp hR
    choose Y_x f_x y_x hf_x het_x hy_x using hR_pt
    have hAff_pt : ∀ x : ↥U.left, ∃ O : (Y_x x).left.Opens,
        AlgebraicGeometry.IsAffineOpen O ∧ y_x x ∈ O := fun x => by
      obtain ⟨O, hAffO, hyO, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : (Y_x x).left.Opens)) trivial
      exact ⟨O, hAffO, hyO⟩
    choose O_x hAffO_x hyO_x using hAff_pt
    let V_x : ↥U.left → X.Etale := fun x =>
      MorphismProperty.Over.mk ⊤ ((O_x x).ι ≫ (Y_x x).hom)
        (MorphismProperty.comp_mem P_et _ _ inferInstance (Y_x x).prop)
    let j_x : ∀ x : ↥U.left, V_x x ⟶ Y_x x := fun x =>
      MorphismProperty.Over.homMk (O_x x).ι rfl
    let g_x : ∀ x : ↥U.left, V_x x ⟶ U := fun x => j_x x ≫ f_x x
    have hEt_gx : ∀ x : ↥U.left, AlgebraicGeometry.Etale (g_x x).left := fun x => by
      change AlgebraicGeometry.Etale ((O_x x).ι ≫ (f_x x).left)
      have : AlgebraicGeometry.Etale (f_x x).left := het_x x
      exact MorphismProperty.comp_mem P_et _ _ inferInstance inferInstance
    have hLift_x : ∀ x : ↥U.left, ∃ t_x : ↥(G₁.obj.obj (Opposite.op (V_x x))),
        (π.hom.app (Opposite.op (V_x x))).hom t_x = (G₂.obj.map (g_x x).op).hom s := fun x => by
      have hgx_mem : R.arrows (g_x x) := R.downward_closed (hf_x x) (j_x x)
      rwa [CategoryTheory.Presheaf.imageSieve_apply] at hgx_mem
    choose t_x ht_x using hLift_x
    have hOpen_gx : ∀ x : ↥U.left, IsOpen (Set.range (g_x x).left.base) := fun x => by
      have : AlgebraicGeometry.Etale (g_x x).left := hEt_gx x
      rw [← Set.image_univ]
      exact (g_x x).left.isOpenMap _ isOpen_univ
    have hUniv_cov : (Set.univ : Set ↥U.left) ⊆ ⋃ x : ↥U.left, Set.range (g_x x).left.base := by
      intro x _
      refine Set.mem_iUnion.mpr ⟨x, ⟨y_x x, hyO_x x⟩, ?_⟩
      exact hy_x x
    obtain ⟨F₀, hF₀_cov⟩ :=
      isCompact_univ.elim_finite_subcover (fun x : ↥U.left => Set.range (g_x x).left.base)
        hOpen_gx hUniv_cov
    let m := Fintype.card ↥F₀
    let e_F : Fin m ≃ ↥F₀ := (Fintype.equivFin ↥F₀).symm
    let V' : Fin m → X.Etale := fun k => V_x (e_F k).1
    let g' : ∀ k : Fin m, V' k ⟶ U := fun k => g_x (e_F k).1
    let t' : ∀ k : Fin m, ↥(G₁.obj.obj (Opposite.op (V' k))) := fun k => t_x (e_F k).1
    let famSch : Fin m → AlgebraicGeometry.Scheme.{u} := fun k => (V' k).left
    have hAff_fam : ∀ k : Fin m, AlgebraicGeometry.IsAffine (famSch k) :=
      fun k => hAffO_x (e_F k).1
    let W_sch : AlgebraicGeometry.Scheme.{u} := ∐ famSch
    have hAff_W : AlgebraicGeometry.IsAffine W_sch := inferInstance
    let w_sch : W_sch ⟶ U.left := Limits.Sigma.desc (fun k : Fin m => (g' k).left)
    let 𝒰 := AlgebraicGeometry.sigmaOpenCover famSch
    have hOpen_ι : ∀ k : Fin m, AlgebraicGeometry.IsOpenImmersion (Limits.Sigma.ι famSch k) :=
      fun k => by
        rw [← AlgebraicGeometry.sigmaOpenCover_f]
        exact AlgebraicGeometry.Scheme.instIsOpenImmersionF (AlgebraicGeometry.sigmaOpenCover famSch) k
    have hEt_w : AlgebraicGeometry.Etale w_sch := by
      refine AlgebraicGeometry.IsZariskiLocalAtSource.of_openCover (P := P_et) 𝒰 fun k => ?_
      let k' : Fin m := k
      have hf_eq : 𝒰.f k = Limits.Sigma.ι famSch k' :=
        AlgebraicGeometry.sigmaOpenCover_f famSch k'
      have hcomp_k : 𝒰.f k ≫ w_sch = (g' k').left :=
        (congrArg (· ≫ w_sch) hf_eq).trans
          (Limits.Sigma.ι_comp_desc (fun j : Fin m => (g' j).left) k')
      exact hcomp_k.symm ▸ hEt_gx (e_F k').1
    have hSurj_w : AlgebraicGeometry.Surjective w_sch := ⟨fun x => by
      have hx := hF₀_cov (Set.mem_univ x)
      simp only [Set.mem_iUnion] at hx
      rcases hx with ⟨x₀, hx₀, hy₀⟩
      obtain ⟨k, hk⟩ := e_F.surjective ⟨x₀, hx₀⟩
      have hk1 : (e_F k).1 = x₀ := congrArg Subtype.val hk
      rw [← hk1] at hy₀
      rcases hy₀ with ⟨v, hv⟩
      refine ⟨(Limits.Sigma.ι famSch k).base v, ?_⟩
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, Limits.Sigma.ι_comp_desc]
      exact hv⟩
    let W : X.Etale :=
      MorphismProperty.Over.mk ⊤ (w_sch ≫ U.hom)
        (MorphismProperty.comp_mem P_et _ _ hEt_w U.prop)
    let w : W ⟶ U := MorphismProperty.Over.homMk w_sch rfl
    let ι_W : ∀ k : Fin m, V' k ⟶ W := fun k =>
      MorphismProperty.Over.homMk (Limits.Sigma.ι famSch k)
        (by
          change Limits.Sigma.ι famSch k ≫ w_sch ≫ U.hom = (V' k).hom
          rw [← Category.assoc, Limits.Sigma.ι_comp_desc]
          exact MorphismProperty.Over.w (g' k))
    have hι_w : ∀ k : Fin m, ι_W k ≫ w = g' k :=
      fun k => MorphismProperty.Over.Hom.ext (Limits.Sigma.ι_comp_desc _ k)
    let S_W : Sieve W := Sieve.ofArrows V' ι_W
    have hS_W : S_W ∈ J W := by
      rw [hMemJ]
      intro (z : ↥W_sch)
      let k : Fin m := 𝒰.idx z
      obtain ⟨v, hv⟩ := 𝒰.covers z
      have hf_eq : 𝒰.f (𝒰.idx z) = Limits.Sigma.ι famSch k :=
        AlgebraicGeometry.sigmaOpenCover_f famSch k
      rw [hf_eq] at hv
      have : AlgebraicGeometry.IsOpenImmersion (Limits.Sigma.ι famSch k) := hOpen_ι k
      refine ⟨V' k, ι_W k, v, Sieve.ofArrows_mk V' ι_W k, ?_, hv⟩
      change AlgebraicGeometry.Etale (Limits.Sigma.ι famSch k)
      infer_instance
    have hUnpack : ∀ {Y : X.Etale} {f : Y ⟶ W},
        S_W.arrows f → ∃ (k : Fin m) (h : Y ⟶ V' k), f = h ≫ ι_W k := by
      rintro Y f ⟨_, h, _, ⟨k⟩, rfl⟩
      exact ⟨k, h, rfl⟩
    have hG₁_type : Presheaf.IsSheaf J (G₁.obj ⋙ forget AddCommGrpCat.{u}) :=
      Presheaf.isSheaf_comp_of_isSheaf J G₁.obj (forget AddCommGrpCat.{u}) G₁.property
    have hG₂_type : Presheaf.IsSheaf J (G₂.obj ⋙ forget AddCommGrpCat.{u}) :=
      Presheaf.isSheaf_comp_of_isSheaf J G₂.obj (forget AddCommGrpCat.{u}) G₂.property
    have hCompatAux : ∀ {Z : X.Etale} [Nonempty ↥Z.left] {k₁ k₂ : Fin m}
        (v₁ : Z ⟶ V' k₁) (v₂ : Z ⟶ V' k₂),
        v₁ ≫ ι_W k₁ = v₂ ≫ ι_W k₂ →
        (G₁.obj.map v₁.op).hom (t' k₁) = (G₁.obj.map v₂.op).hom (t' k₂) := by
      rintro Z ⟨z⟩ k₁ k₂ v₁ v₂ hcomm'
      have hpt : (Limits.Sigma.ι famSch k₁).base (v₁.left.base z) =
          (Limits.Sigma.ι famSch k₂).base (v₂.left.base z) :=
        congrArg (fun φ : Z ⟶ W => φ.left.base z) hcomm'
      have hk_eq : k₁ = k₂ := by
        by_contra hk_ne
        have hbot : (Limits.Sigma.ι famSch k₁).opensRange ⊓
            (Limits.Sigma.ι famSch k₂).opensRange = ⊥ :=
          disjoint_iff.mp (AlgebraicGeometry.disjoint_opensRange_sigmaι famSch k₁ k₂ hk_ne)
        have hmem : (Limits.Sigma.ι famSch k₁).base (v₁.left.base z) ∈
            ((Limits.Sigma.ι famSch k₁).opensRange ⊓ (Limits.Sigma.ι famSch k₂).opensRange) :=
          ⟨⟨v₁.left.base z, rfl⟩, ⟨v₂.left.base z, hpt.symm⟩⟩
        rw [hbot] at hmem
        exact hmem
      subst hk_eq
      have : AlgebraicGeometry.IsOpenImmersion (Limits.Sigma.ι famSch k₁) := hOpen_ι k₁
      have hleft_eq : v₁.left ≫ Limits.Sigma.ι famSch k₁ = v₂.left ≫ Limits.Sigma.ι famSch k₁ :=
        congrArg (fun φ : Z ⟶ W => φ.left) hcomm'
      have hv_eq : v₁ = v₂ := MorphismProperty.Over.Hom.ext
        ((cancel_mono (Limits.Sigma.ι famSch k₁)).mp hleft_eq)
      rw [hv_eq]
    let fam : Presieve.FamilyOfElements (G₁.obj ⋙ forget AddCommGrpCat.{u}) S_W.arrows :=
      fun Y _ hf => (G₁.obj.map (hUnpack hf).choose_spec.choose.op).hom (t' (hUnpack hf).choose)
    have hFamCompat : fam.Compatible := by
      intro Y₁ Y₂ Z u₁ u₂ f₁ f₂ hf₁ hf₂ hcomm
      dsimp [fam]
      by_cases hZ : Nonempty ↥Z.left
      · have hh₁ : f₁ = (hUnpack hf₁).choose_spec.choose ≫ ι_W (hUnpack hf₁).choose :=
          (hUnpack hf₁).choose_spec.choose_spec
        have hh₂ : f₂ = (hUnpack hf₂).choose_spec.choose ≫ ι_W (hUnpack hf₂).choose :=
          (hUnpack hf₂).choose_spec.choose_spec
        have hcomm' : (u₁ ≫ (hUnpack hf₁).choose_spec.choose) ≫ ι_W (hUnpack hf₁).choose =
            (u₂ ≫ (hUnpack hf₂).choose_spec.choose) ≫ ι_W (hUnpack hf₂).choose := by
          simpa only [Category.assoc, ← hh₁, ← hh₂] using hcomm
        change ((G₁.obj.map (hUnpack hf₁).choose_spec.choose.op ≫ G₁.obj.map u₁.op).hom) _ =
          ((G₁.obj.map (hUnpack hf₂).choose_spec.choose.op ≫ G₁.obj.map u₂.op).hom) _
        rw [← G₁.obj.map_comp, ← G₁.obj.map_comp, ← op_comp, ← op_comp]
        exact @hCompatAux Z hZ _ _ _ _ hcomm'
      · have := hEmpty_sub G₁ Z (not_nonempty_iff.mp hZ)
        exact Subsingleton.elim _ _
    let t : ↥(G₁.obj.obj (Opposite.op W)) :=
      (hG₁_type.isSheafFor _ hS_W).amalgamate fam hFamCompat
    refine ⟨W, hAff_W, w, hSurj_w, t, ?_⟩
    apply (hG₂_type.isSheafFor _ hS_W).isSeparatedFor.ext
    intro Y f hf
    let k := (hUnpack hf).choose
    let h := (hUnpack hf).choose_spec.choose
    have hfh : f = h ≫ ι_W k := (hUnpack hf).choose_spec.choose_spec
    have hglue := (hG₁_type.isSheafFor _ hS_W).valid_glue hFamCompat f hf
    change (G₁.obj.map f.op).hom t = (G₁.obj.map h.op).hom (t' k) at hglue
    have hnatW := congrArg (fun φ => φ.hom t) (π.hom.naturality f.op)
    have hnatV := congrArg (fun φ => φ.hom (t' k)) (π.hom.naturality h.op)
    dsimp at hnatW hnatV
    change (G₂.obj.map f.op).hom ((π.hom.app (Opposite.op W)).hom t) =
      (G₂.obj.map f.op).hom ((G₂.obj.map w.op).hom s)
    rw [← hnatW, hglue, hnatV, ht_x (e_F k).1]
    change ((G₂.obj.map (g' k).op ≫ G₂.obj.map h.op).hom) s =
      ((G₂.obj.map w.op ≫ G₂.obj.map f.op).hom) s
    rw [← G₂.obj.map_comp, ← G₂.obj.map_comp, ← op_comp, ← op_comp, ← hι_w k, ← Category.assoc, hfh]

  have hEq0 : ∀ (G : Sheaf J AddCommGrpCat.{u}) (U W : X.Etale) (w : W ⟶ U)
      [AlgebraicGeometry.Surjective w.left],
      Function.Injective (G.obj.map w.op).hom ∧
        ∀ t : ↥(G.obj.obj (Opposite.op W)),
          weilEtaleCechDiff G.obj w 0 t = 0 →
          ∃ u : ↥(G.obj.obj (Opposite.op U)), (G.obj.map w.op).hom u = t := by
    intro G U W w _
    have hEt_w : AlgebraicGeometry.Etale w.left :=
      MorphismProperty.of_postcomp P_et w.left U.hom U.prop
        (by rw [MorphismProperty.Over.w w]; exact W.prop)
    let S_w : Sieve U := Sieve.ofArrows (fun _ : Unit => W) (fun _ => w)
    have hS_w : S_w ∈ J U := by
      rw [hMemJ]
      intro x
      obtain ⟨y, hy⟩ := w.left.surjective x
      exact ⟨W, w, y, Sieve.ofArrows_mk _ _ (), hEt_w, hy⟩
    have hUnpack : ∀ {Y : X.Etale} {f : Y ⟶ U},
        S_w.arrows f → ∃ h : Y ⟶ W, f = h ≫ w := by
      rintro Y f ⟨_, h, _, ⟨⟨⟩⟩, rfl⟩
      exact ⟨h, rfl⟩
    have hG_type : Presheaf.IsSheaf J (G.obj ⋙ forget AddCommGrpCat.{u}) :=
      Presheaf.isSheaf_comp_of_isSheaf J G.obj (forget AddCommGrpCat.{u}) G.property
    refine ⟨?_, ?_⟩
    · intro u₁ u₂ hu
      apply (hG_type.isSheafFor _ hS_w).isSeparatedFor.ext
      intro Y f hf
      obtain ⟨h, rfl⟩ := hUnpack hf
      change (G.obj.map (h ≫ w).op).hom u₁ = (G.obj.map (h ≫ w).op).hom u₂
      rw [op_comp, G.obj.map_comp]
      exact congrArg (G.obj.map h.op).hom hu
    · intro t ht
      have ht_eq : (G.obj.map (Limits.pullback.fst w w).op).hom t =
          (G.obj.map (Limits.pullback.snd w w).op).hom t := by
        rw [hDiff0 G.obj w t, hFace0_zero, hFace0_one, sub_eq_zero] at ht
        exact ht.symm
      let fam : Presieve.FamilyOfElements (G.obj ⋙ forget AddCommGrpCat.{u}) S_w.arrows :=
        fun Y _ hf => (G.obj.map (hUnpack hf).choose.op).hom t
      have hCompat : fam.Compatible := by
        intro Y₁ Y₂ Z v₁ v₂ f₁ f₂ hf₁ hf₂ hcomm
        dsimp [fam]
        let h₁ := (hUnpack hf₁).choose
        have hh₁ : f₁ = h₁ ≫ w := (hUnpack hf₁).choose_spec
        let h₂ := (hUnpack hf₂).choose
        have hh₂ : f₂ = h₂ ≫ w := (hUnpack hf₂).choose_spec
        have hpb_eq : (v₁ ≫ h₁) ≫ w = (v₂ ≫ h₂) ≫ w := by
          simpa only [Category.assoc, ← hh₁, ← hh₂] using hcomm
        let ell : Z ⟶ Limits.pullback w w := Limits.pullback.lift (v₁ ≫ h₁) (v₂ ≫ h₂) hpb_eq
        have he₁ : v₁ ≫ h₁ = ell ≫ Limits.pullback.fst w w :=
          (Limits.pullback.lift_fst _ _ _).symm
        have he₂ : v₂ ≫ h₂ = ell ≫ Limits.pullback.snd w w :=
          (Limits.pullback.lift_snd _ _ _).symm
        change ((G.obj.map h₁.op ≫ G.obj.map v₁.op).hom) t =
          ((G.obj.map h₂.op ≫ G.obj.map v₂.op).hom) t
        rw [← G.obj.map_comp, ← G.obj.map_comp, ← op_comp, ← op_comp, he₁, he₂,
          op_comp, op_comp, G.obj.map_comp, G.obj.map_comp]
        exact congrArg (G.obj.map ell.op).hom ht_eq
      let u : ↥(G.obj.obj (Opposite.op U)) :=
        (hG_type.isSheafFor _ hS_w).amalgamate fam hCompat
      refine ⟨u, ?_⟩
      have hwm : S_w.arrows w := Sieve.ofArrows_mk _ _ ()
      have hglue := (hG_type.isSheafFor _ hS_w).valid_glue hCompat w hwm
      let h₀ := (hUnpack hwm).choose
      have hh₀ : w = h₀ ≫ w := (hUnpack hwm).choose_spec
      change (G.obj.map w.op).hom u = (G.obj.map h₀.op).hom t at hglue
      rw [hglue]
      let ell₀ : W ⟶ Limits.pullback w w :=
        Limits.pullback.lift h₀ (𝟙 W) (by rw [Category.id_comp]; exact hh₀.symm)
      have he₀ : h₀ = ell₀ ≫ Limits.pullback.fst w w := (Limits.pullback.lift_fst _ _ _).symm
      have he₁ : 𝟙 W = ell₀ ≫ Limits.pullback.snd w w := (Limits.pullback.lift_snd _ _ _).symm
      calc
        (G.obj.map h₀.op).hom t
            = (G.obj.map ell₀.op).hom ((G.obj.map (Limits.pullback.fst w w).op).hom t) := by
              rw [he₀, op_comp, G.obj.map_comp]; rfl
        _ = (G.obj.map ell₀.op).hom ((G.obj.map (Limits.pullback.snd w w).op).hom t) := by
              rw [ht_eq]
        _ = (G.obj.map (𝟙 W).op).hom t := by
              rw [he₁, op_comp, G.obj.map_comp]; rfl
        _ = t := by rw [op_id, G.obj.map_id]; rfl

  
  
  
  obtain ⟨secEquiv, hSecNat, hSecZero⟩ :
      ∃ secEquiv : ∀ (V : X.Etale) (G : Sheaf J AddCommGrpCat.{u}),
          CategoryTheory.Abelian.Ext.{u} (Z_sh V) G 0 ≃ ↥(G.obj.obj (Opposite.op V)),
        (∀ (V : X.Etale) {G₁ G₂ : Sheaf J AddCommGrpCat.{u}}
          (x : CategoryTheory.Abelian.Ext.{u} (Z_sh V) G₁ 0) (φ : G₁ ⟶ G₂),
          secEquiv V G₂ (x.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)) =
            (φ.hom.app (Opposite.op V)).hom (secEquiv V G₁ x)) ∧
        (∀ (V : X.Etale) (G : Sheaf J AddCommGrpCat.{u}), secEquiv V G 0 = 0) := by
    let secE : ∀ (V : X.Etale) (G : Sheaf J AddCommGrpCat.{u}),
        CategoryTheory.Abelian.Ext.{u} (Z_sh V) G 0 ≃ ↥(G.obj.obj (Opposite.op V)) :=
      fun V G => CategoryTheory.Abelian.Ext.homEquiv₀.trans (homEquivSec V G)
    have hNat : ∀ (V : X.Etale) {G₁ G₂ : Sheaf J AddCommGrpCat.{u}}
        (x : CategoryTheory.Abelian.Ext.{u} (Z_sh V) G₁ 0) (φ : G₁ ⟶ G₂),
        secE V G₂ (x.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)) =
          (φ.hom.app (Opposite.op V)).hom (secE V G₁ x) := by
      intro V G₁ G₂ x φ
      have hx := CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply x
      conv_lhs => rw [← hx]
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      dsimp [secE]
      rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply, Equiv.apply_symm_apply]
      exact hHomSecNat V (CategoryTheory.Abelian.Ext.homEquiv₀ x) φ
    refine ⟨secE, hNat, ?_⟩
    intro V G
    have h0 := hNat V (0 : CategoryTheory.Abelian.Ext.{u} (Z_sh V) G 0) (0 : G ⟶ G)
    rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero] at h0
    have hApp0 : ((0 : G ⟶ G).hom.app (Opposite.op V)).hom (secE V G 0) = 0 := by
      have hz : ((0 : G ⟶ G).hom.app (Opposite.op V)) = 0 := by simp
      rw [hz]
      rfl
    exact h0.trans hApp0

  have hInjExtZero : ∀ (I : Sheaf J AddCommGrpCat.{u}) [CategoryTheory.Injective I]
      (V : X.Etale) (n : ℕ), 1 ≤ n →
      ∀ e : CategoryTheory.Abelian.Ext.{u} (Z_sh V) I n, e = 0 := by
    intro I _ V n hn e
    exact ((CategoryTheory.hasInjectiveDimensionLT_iff I 1).mp inferInstance) n hn e

  have hSecExact : ∀ {G I Q : Sheaf J AddCommGrpCat.{u}} [CategoryTheory.Injective I]
      {ι : G ⟶ I} {π : I ⟶ Q} {h0 : ι ≫ π = 0},
      (CategoryTheory.ShortComplex.mk ι π h0).ShortExact →
      ∀ V : X.Etale,
        Function.Injective (ι.hom.app (Opposite.op V)).hom ∧
        (∀ x : ↥(I.obj.obj (Opposite.op V)),
          (π.hom.app (Opposite.op V)).hom x = 0 →
          ∃ y : ↥(G.obj.obj (Opposite.op V)), (ι.hom.app (Opposite.op V)).hom y = x) ∧
        (Subsingleton (CategoryTheory.Abelian.Ext.{u} (Z_sh V) G 1) →
          Function.Surjective (π.hom.app (Opposite.op V)).hom) ∧
        (Function.Surjective (π.hom.app (Opposite.op V)).hom →
          Subsingleton (CategoryTheory.Abelian.Ext.{u} (Z_sh V) G 1)) := by
    intro G I Q _ ι π h0 hSE V
    have : CategoryTheory.Mono ι := hSE.mono_f
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro y₁ y₂ hy
      let g₁ : Z_sh V ⟶ G := (homEquivSec V G).symm y₁
      let g₂ : Z_sh V ⟶ G := (homEquivSec V G).symm y₂
      have hcomp_eq : g₁ ≫ ι = g₂ ≫ ι := by
        apply (homEquivSec V I).injective
        rw [hHomSecNat V g₁ ι, hHomSecNat V g₂ ι,
          Equiv.apply_symm_apply, Equiv.apply_symm_apply, hy]
      have hg_eq : g₁ = g₂ := (cancel_mono ι).mp hcomp_eq
      calc
        y₁ = homEquivSec V G g₁ := (Equiv.apply_symm_apply _ _).symm
        _ = homEquivSec V G g₂ := by rw [hg_eq]
        _ = y₂ := Equiv.apply_symm_apply _ _
    · intro x hx
      let x₀ : CategoryTheory.Abelian.Ext.{u} (Z_sh V) I 0 := (secEquiv V I).symm x
      have hx₀_pi : x₀.comp (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero 0) = 0 := by
        apply (secEquiv V Q).injective
        rw [hSecNat V x₀ π, Equiv.apply_symm_apply, hx, hSecZero]
      obtain ⟨y₀, hy₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ (Z_sh V) hSE x₀ hx₀_pi
      refine ⟨secEquiv V G y₀, ?_⟩
      rw [← hSecNat V y₀ ι, hy₀, Equiv.apply_symm_apply]
    · intro hSub s
      let s₀ : CategoryTheory.Abelian.Ext.{u} (Z_sh V) Q 0 := (secEquiv V Q).symm s
      have hs₀_ext : s₀.comp hSE.extClass (rfl : 0 + 1 = 1) = 0 := Subsingleton.elim _ 0
      obtain ⟨t₀, ht₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ (Z_sh V) hSE s₀ (rfl : 0 + 1 = 1) hs₀_ext
      refine ⟨secEquiv V I t₀, ?_⟩
      rw [← hSecNat V t₀ π, ht₀, Equiv.apply_symm_apply]
    · intro hSurj
      refine ⟨fun e₁ e₂ => ?_⟩
      have heZero : ∀ e : CategoryTheory.Abelian.Ext.{u} (Z_sh V) G 1, e = 0 := by
        intro e
        have he_ι : e.comp (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero 1) = 0 :=
          hInjExtZero I V 1 le_rfl _
        obtain ⟨s₀, hs₀⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (Z_sh V) hSE e he_ι (rfl : 0 + 1 = 1)
        obtain ⟨u, hu⟩ := hSurj (secEquiv V Q s₀)
        let u₀ : CategoryTheory.Abelian.Ext.{u} (Z_sh V) I 0 := (secEquiv V I).symm u
        have hu₀_pi : u₀.comp (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero 0) = s₀ := by
          apply (secEquiv V Q).injective
          rw [hSecNat V u₀ π, Equiv.apply_symm_apply, hu]
        rw [← hs₀, ← hu₀_pi]
        have hex₃ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_sh V) hSE 0 1 rfl
        have hzero := (fun {S : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : S.Exact) =>
          S.zero) hex₃
        exact congrArg (fun φ => φ.hom u₀) hzero
      rw [heZero e₁, heZero e₂]

  have hShift : ∀ {G I Q : Sheaf J AddCommGrpCat.{u}} [CategoryTheory.Injective I]
      {ι : G ⟶ I} {π : I ⟶ Q} {h0 : ι ≫ π = 0},
      (CategoryTheory.ShortComplex.mk ι π h0).ShortExact →
      ∀ (V : X.Etale) (n : ℕ), 1 ≤ n →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} (Z_sh V) Q n) →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} (Z_sh V) G (n + 1)) := by
    intro G I Q _ ι π h0 hSE V n _ hSubQ
    refine ⟨fun e₁ e₂ => ?_⟩
    have heZero : ∀ e : CategoryTheory.Abelian.Ext.{u} (Z_sh V) G (n + 1), e = 0 := by
      intro e
      have he_ι : e.comp (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero (n + 1)) = 0 :=
        hInjExtZero I V (n + 1) (by omega) _
      obtain ⟨q₀, hq₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (Z_sh V) hSE e he_ι
          (rfl : n + 1 = n + 1)
      have hq₀_zero : q₀ = 0 := Subsingleton.elim q₀ 0
      rw [← hq₀, hq₀_zero, CategoryTheory.Abelian.Ext.zero_comp]
    rw [heZero e₁, heZero e₂]

  let CechAcyclic : Sheaf J AddCommGrpCat.{u} → Prop := fun G =>
    ∀ (U W : X.Etale) [CompactSpace ↥U.left] [U.left.IsSeparated]
      [AlgebraicGeometry.IsAffine W.left] (w : W ⟶ U) [AlgebraicGeometry.Surjective w.left]
      (p : ℕ) (c : ↥(G.obj.obj (Opposite.op (weilEtaleCechObj w (p + 1))))),
      weilEtaleCechDiff G.obj w (p + 1) c = 0 →
      ∃ b : ↥(G.obj.obj (Opposite.op (weilEtaleCechObj w p))),
        weilEtaleCechDiff G.obj w p b = c

  have hExt1All : ∀ (G : Sheaf J AddCommGrpCat.{u}), CechAcyclic G →
      ∀ (V : X.Etale) [CompactSpace ↥V.left] [V.left.IsSeparated],
        Subsingleton (CategoryTheory.Abelian.Ext.{u} (Z_sh V) G 1) := by
    intro G hG V _ _
    let I : Sheaf J AddCommGrpCat.{u} := CategoryTheory.Injective.under G
    let ι : G ⟶ I := CategoryTheory.Injective.ι G
    let Q : Sheaf J AddCommGrpCat.{u} := Limits.cokernel ι
    let π : I ⟶ Q := Limits.cokernel.π ι
    have h0 : ι ≫ π = 0 := Limits.cokernel.condition ι
    let SC_G := CategoryTheory.ShortComplex.mk ι π h0
    have : CategoryTheory.Mono SC_G.f := by dsimp [SC_G, ι]; infer_instance
    have : CategoryTheory.Epi SC_G.g := by dsimp [SC_G, π]; infer_instance
    have hSE : SC_G.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι }
    have : CategoryTheory.Epi π := hSE.epi_g
    apply (hSecExact hSE V).2.2.2
    intro s
    obtain ⟨W, hAffW, w, hSurjW, t, ht⟩ := hEpiCover I Q π V s
    have : AlgebraicGeometry.IsAffine W.left := hAffW
    have : AlgebraicGeometry.Surjective w.left := hSurjW
    have hd0_ws : weilEtaleCechDiff Q.obj w 0 ((Q.obj.map w.op).hom s) = 0 := by
      rw [hDiff0 Q.obj w ((Q.obj.map w.op).hom s), hFace0_zero, hFace0_one, sub_eq_zero]
      change ((Q.obj.map w.op ≫ Q.obj.map (Limits.pullback.snd w w).op).hom) s =
        ((Q.obj.map w.op ≫ Q.obj.map (Limits.pullback.fst w w).op).hom) s
      rw [← Q.obj.map_comp, ← Q.obj.map_comp, ← op_comp, ← op_comp, Limits.pullback.condition]
    have hpi_dt : (π.hom.app (Opposite.op (weilEtaleCechObj w 1))).hom
        (weilEtaleCechDiff I.obj w 0 t) = 0 := by
      rw [hDiffNat0 π.hom w t, ht, hd0_ws]
    obtain ⟨c₀, hc₀⟩ := (hSecExact hSE (weilEtaleCechObj w 1)).2.1
      (weilEtaleCechDiff I.obj w 0 t) hpi_dt
    have hdc₀ : weilEtaleCechDiff G.obj w 1 c₀ = 0 := by
      apply (hSecExact hSE (weilEtaleCechObj w 2)).1
      rw [map_zero, hDiffNat ι.hom w 1 c₀, hc₀, hDiffSq I.obj w 0 t]
    obtain ⟨b₀, hb₀⟩ := hG V W w 0 c₀ hdc₀
    let b₀' : ↥(G.obj.obj (Opposite.op W)) := b₀
    have hb₀' : weilEtaleCechDiff G.obj w 0 b₀' = c₀ := hb₀
    let t' : ↥(I.obj.obj (Opposite.op W)) := t - (ι.hom.app (Opposite.op W)).hom b₀'
    have hdt' : weilEtaleCechDiff I.obj w 0 t' = 0 := by
      let t₀ : ↥(I.obj.obj (Opposite.op (weilEtaleCechObj w 0))) := t
      let ib₀ : ↥(I.obj.obj (Opposite.op (weilEtaleCechObj w 0))) :=
        (ι.hom.app (Opposite.op W)).hom b₀'
      have hib₀ : weilEtaleCechDiff I.obj w 0 ib₀ = weilEtaleCechDiff I.obj w 0 t₀ := by
        change weilEtaleCechDiff I.obj w 0 ((ι.hom.app (Opposite.op W)).hom b₀') =
          weilEtaleCechDiff I.obj w 0 t
        rw [← hDiffNat0 ι.hom w b₀', hb₀', hc₀]
      exact (map_sub (weilEtaleCechDiff I.obj w 0) t₀ ib₀).trans
        ((congrArg (weilEtaleCechDiff I.obj w 0 t₀ - ·) hib₀).trans (sub_self _))
    obtain ⟨u, hu⟩ := (hEq0 I V W w).2 t' hdt'
    refine ⟨u, (hEq0 Q V W w).1 ?_⟩
    have hnat_u := congrArg (fun φ => φ.hom u) (π.hom.naturality w.op)
    dsimp at hnat_u
    rw [← hnat_u, hu]
    dsimp [t']
    have hcomp_b₀ : (π.hom.app (Opposite.op W)).hom ((ι.hom.app (Opposite.op W)).hom b₀') = 0 := by
      calc
        (π.hom.app (Opposite.op W)).hom ((ι.hom.app (Opposite.op W)).hom b₀')
            = ((ι ≫ π).hom.app (Opposite.op W)).hom b₀' := rfl
        _ = ((0 : G ⟶ Q).hom.app (Opposite.op W)).hom b₀' := by rw [h0]
        _ = 0 := by
          have hz : ((0 : G ⟶ Q).hom.app (Opposite.op W)) = 0 := by simp
          rw [hz]
          rfl
    rw [map_sub, ht, hcomp_b₀, sub_zero]

  have hExtAll : ∀ (k : ℕ) (G : Sheaf J AddCommGrpCat.{u}), CechAcyclic G →
      ∀ (U : X.Etale) [CompactSpace ↥U.left] [U.left.IsSeparated],
        Subsingleton (CategoryTheory.Abelian.Ext.{u} (Z_sh U) G (k + 1)) := by
    intro k
    induction k with
    | zero =>
      intro G hG U _ _
      exact hExt1All G hG U
    | succ k ih =>
      intro G hG U _ _
      let I : Sheaf J AddCommGrpCat.{u} := CategoryTheory.Injective.under G
      let ι : G ⟶ I := CategoryTheory.Injective.ι G
      let Q : Sheaf J AddCommGrpCat.{u} := Limits.cokernel ι
      let π : I ⟶ Q := Limits.cokernel.π ι
      have h0 : ι ≫ π = 0 := Limits.cokernel.condition ι
      let SC_G := CategoryTheory.ShortComplex.mk ι π h0
      have : CategoryTheory.Mono SC_G.f := by dsimp [SC_G, ι]; infer_instance
      have : CategoryTheory.Epi SC_G.g := by dsimp [SC_G, π]; infer_instance
      have hSE : SC_G.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι }
      have hQ : CechAcyclic Q := by
        intro U' W' _ _ _ w _ p c_Q hc_Q
        have hNerveSec : ∀ m : ℕ,
            Function.Injective (ι.hom.app (Opposite.op (weilEtaleCechObj w m))).hom ∧
            (∀ x : ↥(I.obj.obj (Opposite.op (weilEtaleCechObj w m))),
              (π.hom.app (Opposite.op (weilEtaleCechObj w m))).hom x = 0 →
              ∃ y : ↥(G.obj.obj (Opposite.op (weilEtaleCechObj w m))),
                (ι.hom.app (Opposite.op (weilEtaleCechObj w m))).hom y = x) ∧
            Function.Surjective (π.hom.app (Opposite.op (weilEtaleCechObj w m))).hom := by
          intro m
          have : AlgebraicGeometry.IsAffine (weilEtaleCechObj w m).left := hAffNerve U' W' w m
          have : CompactSpace ↥(weilEtaleCechObj w m).left :=
            AlgebraicGeometry.Scheme.compactSpace_of_isAffine (weilEtaleCechObj w m).left
          have : (weilEtaleCechObj w m).left.IsSeparated := inferInstance
          have hSub1 := hExt1All G hG (weilEtaleCechObj w m)
          exact ⟨(hSecExact hSE _).1, (hSecExact hSE _).2.1, (hSecExact hSE _).2.2.1 hSub1⟩
        obtain ⟨c_tilde, hc_tilde⟩ := (hNerveSec (p + 1)).2.2 c_Q
        have hpi_dc : (π.hom.app (Opposite.op (weilEtaleCechObj w (p + 2)))).hom
            (weilEtaleCechDiff I.obj w (p + 1) c_tilde) = 0 := by
          rw [hDiffNat π.hom w (p + 1) c_tilde, hc_tilde, hc_Q]
        obtain ⟨z_G, hz_G⟩ := (hNerveSec (p + 2)).2.1 _ hpi_dc
        have hdz_G : weilEtaleCechDiff G.obj w (p + 2) z_G = 0 := by
          apply (hNerveSec (p + 3)).1
          rw [map_zero, hDiffNat ι.hom w (p + 2) z_G, hz_G, hDiffSq I.obj w (p + 1) c_tilde]
        obtain ⟨y_G, hy_G⟩ := hG U' W' w (p + 1) z_G hdz_G
        let c_tilde' : ↥(I.obj.obj (Opposite.op (weilEtaleCechObj w (p + 1)))) :=
          c_tilde - (ι.hom.app (Opposite.op (weilEtaleCechObj w (p + 1)))).hom y_G
        have hdc_tilde' : weilEtaleCechDiff I.obj w (p + 1) c_tilde' = 0 := by
          dsimp [c_tilde']
          rw [map_sub, ← hDiffNat ι.hom w (p + 1) y_G, hy_G, hz_G, sub_self]
        obtain ⟨x_I, hx_I⟩ := hInjExact I w p c_tilde' hdc_tilde'
        refine ⟨(π.hom.app (Opposite.op (weilEtaleCechObj w p))).hom x_I, ?_⟩
        rw [← hDiffNat π.hom w p x_I, hx_I]
        dsimp [c_tilde']
        have hcomp_y : (π.hom.app (Opposite.op (weilEtaleCechObj w (p + 1)))).hom
            ((ι.hom.app (Opposite.op (weilEtaleCechObj w (p + 1)))).hom y_G) = 0 := by
          calc
            (π.hom.app (Opposite.op (weilEtaleCechObj w (p + 1)))).hom
                ((ι.hom.app (Opposite.op (weilEtaleCechObj w (p + 1)))).hom y_G)
                = ((ι ≫ π).hom.app (Opposite.op (weilEtaleCechObj w (p + 1)))).hom y_G := rfl
            _ = ((0 : G ⟶ Q).hom.app (Opposite.op (weilEtaleCechObj w (p + 1)))).hom y_G := by
                rw [h0]
            _ = 0 := by
                have hz : ((0 : G ⟶ Q).hom.app (Opposite.op (weilEtaleCechObj w (p + 1)))) = 0 := by
                  simp
                rw [hz]
                rfl
        rw [map_sub, hc_tilde, hcomp_y, sub_zero]
      have hSubQ : Subsingleton (CategoryTheory.Abelian.Ext.{u} (Z_sh U) Q (k + 1)) :=
        ih Q hQ U
      exact hShift hSE U (k + 1) (by omega) hSubQ

  
  
  
  let T_X : X.Etale :=
    MorphismProperty.Over.mk ⊤ (𝟙 X) (MorphismProperty.id_mem P_et X)
  have hT : Limits.IsTerminal T_X :=
    Limits.IsTerminal.ofUniqueHom
      (fun U => MorphismProperty.Over.homMk U.hom (Category.comp_id U.hom))
      (fun U g => MorphismProperty.Over.Hom.ext
        ((Category.comp_id g.left).symm.trans (MorphismProperty.Over.w g)))
  have : CompactSpace ↥T_X.left := by
    change CompactSpace ↥X
    infer_instance
  have : T_X.left.IsSeparated := by
    change X.IsSeparated
    infer_instance
  let Fℤ : Sheaf J AddCommGrpCat.{u} :=
    (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj ℤ_u
  let adjC := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
  let e_Z_hom : ∀ A : AddCommGrpCat.{u}, (ℤ_u ⟶ A) ≃ ↥A := fun A =>
    { toFun := fun f => f.hom (ULift.up (1 : ℤ))
      invFun := fun m => AddCommGrpCat.ofHom
        { toFun := fun n => n.down • m
          map_zero' := zero_zsmul m
          map_add' := fun a b => add_zsmul m a.down b.down }
      left_inv := fun f => by
        apply AddCommGrpCat.ext
        rintro ⟨n⟩
        change n • f.hom (ULift.up (1 : ℤ)) = f.hom (ULift.up n)
        have hn : (ULift.up n : ULift.{u} ℤ) = n • (ULift.up (1 : ℤ) : ULift.{u} ℤ) :=
          ULift.ext _ _ (by simp)
        rw [hn, map_zsmul]
      right_inv := fun m => one_zsmul m }
  let constEquivSec : ∀ G : Sheaf J AddCommGrpCat.{u},
      (Fℤ ⟶ G) ≃ ↥(G.obj.obj (Opposite.op T_X)) :=
    fun G => (adjC.homEquiv ℤ_u G).trans (e_Z_hom _)
  have hConstNat : ∀ {G₁ G₂ : Sheaf J AddCommGrpCat.{u}} (g : Fℤ ⟶ G₁) (φ : G₁ ⟶ G₂),
      constEquivSec G₂ (g ≫ φ) =
        (φ.hom.app (Opposite.op T_X)).hom (constEquivSec G₁ g) := by
    intro G₁ G₂ g φ
    dsimp [constEquivSec]
    rw [adjC.homEquiv_naturality_right]
    rfl
  let α_hom : Z_sh T_X ⟶ Fℤ :=
    (homEquivSec T_X Fℤ).symm (constEquivSec Fℤ (𝟙 Fℤ))
  let α_inv : Fℤ ⟶ Z_sh T_X :=
    (constEquivSec (Z_sh T_X)).symm (homEquivSec T_X (Z_sh T_X) (𝟙 (Z_sh T_X)))
  have hα_inv_hom : α_inv ≫ α_hom = 𝟙 Fℤ := by
    apply (constEquivSec Fℤ).injective
    rw [hConstNat α_inv α_hom, Equiv.apply_symm_apply, ← hHomSecNat T_X (𝟙 (Z_sh T_X)) α_hom,
      Category.id_comp, Equiv.apply_symm_apply]
  obtain ⟨k, rfl⟩ : ∃ k : ℕ, k + 1 = q := ⟨q - 1, by omega⟩
  have : Subsingleton (CategoryTheory.Abelian.Ext.{u} (Z_sh T_X) F (k + 1)) :=
    hExtAll k F hCech T_X
  refine ⟨fun x₁ x₂ => ?_⟩
  have hxZero : ∀ x : F.H (k + 1), x = 0 := by
    intro x
    change (x : CategoryTheory.Abelian.Ext.{u} Fℤ F (k + 1)) = 0
    have hx0 : (CategoryTheory.Abelian.Ext.mk₀ α_hom).comp x (Nat.zero_add (k + 1)) = 0 :=
      Subsingleton.elim _ 0
    calc
      x = (CategoryTheory.Abelian.Ext.mk₀ (𝟙 Fℤ)).comp x (Nat.zero_add (k + 1)) :=
          (CategoryTheory.Abelian.Ext.mk₀_id_comp x).symm
      _ = (CategoryTheory.Abelian.Ext.mk₀ (α_inv ≫ α_hom)).comp x (Nat.zero_add (k + 1)) := by
          rw [hα_inv_hom]
      _ = (CategoryTheory.Abelian.Ext.mk₀ α_inv).comp
            ((CategoryTheory.Abelian.Ext.mk₀ α_hom).comp x (Nat.zero_add (k + 1)))
            (Nat.zero_add (k + 1)) :=
          (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc α_inv α_hom x).symm
      _ = (CategoryTheory.Abelian.Ext.mk₀ α_inv).comp 0 (Nat.zero_add (k + 1)) := by
          rw [hx0]
      _ = 0 := CategoryTheory.Abelian.Ext.comp_zero _ _ _ _ _
  rw [hxZero x₁, hxZero x₂]

theorem weil_etale_generic_gm_isSheaf_and_H0_quot (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral X]
    (hGmSheaf : ∀ S : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (weilEtaleGmPresheaf S)) :
    CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilEtaleKPresheaf X) ∧
    ∀ (hK : CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilEtaleKPresheaf X))
      (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      (δ_pre : weilEtaleKPresheaf X ⟶ G.obj),
      let T_X : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
        (CategoryTheory.CategoryStruct.id X)
        (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id X))
      let δ : weilEtaleKSheaf X ⟶ G :=
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.sheafificationIso ⟨weilEtaleKPresheaf X, hK⟩).inv
          { hom := δ_pre }
      Nonempty ((G.H 0 ⧸
        ((CategoryTheory.Abelian.Ext.mk₀ δ).postcomp
          ((CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ)))
          (Nat.add_zero 0)).range) ≃+
        (↥(G.obj.obj (Opposite.op T_X)) ⧸ (δ_pre.app (Opposite.op T_X)).hom.range)) :=
by
  have hKSheaf : CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilEtaleKPresheaf X) := by
    have : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
    let η : ↥X := genericPoint ↥X
    let X₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (X.presheaf.stalk η)
    let f : X₀ ⟶ X := X.fromSpecStalk η
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have hMult : P_et.IsMultiplicative := inferInstance
    have := hMult.toContainsIdentities
    have := hMult.toIsStableUnderComposition
    have hMemJ : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) (R : CategoryTheory.Sieve U),
        R ∈ S.smallEtaleTopology U ↔
          ∀ x : ↥U.left, ∃ (W : S.Etale) (g : W ⟶ U) (w : ↥W.left),
            R.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left.base w = x := by
      intro S U R
      have hJ_eq :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) S le_rfl
      exact (Eq.to_iff
        (congrArg (fun G : CategoryTheory.GrothendieckTopology (P_et.Over ⊤ S) => R ∈ G U) hJ_eq)).trans
          (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U R)
    let B := CategoryTheory.MorphismProperty.Over.pullback P_et ⊤ f
    have hCompat : CategoryTheory.CompatiblePreserving X₀.smallEtaleTopology B :=
      @CategoryTheory.compatiblePreservingOfFlat _ _ _ _ X₀.smallEtaleTopology B
        (CategoryTheory.flat_of_preservesFiniteLimits B)
    have hCov : CategoryTheory.CoverPreserving X.smallEtaleTopology X₀.smallEtaleTopology B := by
      refine CategoryTheory.CoverPreserving.mk fun {U R} hR => ?_
      rw [hMemJ X₀ (B.obj U)]
      intro z
      let x : ↥U.left := (CategoryTheory.Limits.pullback.fst U.hom f).base z
      obtain ⟨W, g, w, hgR, hg_et, hw⟩ := (hMemJ X U R).mp hR x
      have hmap_left := CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ f g
      have h_top : CategoryTheory.Limits.pullback.fst W.hom f ≫ g.left =
          (B.map g).left ≫ CategoryTheory.Limits.pullback.fst U.hom f :=
        ((congrArg (· ≫ CategoryTheory.Limits.pullback.fst U.hom f) hmap_left).trans
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)).symm
      have h_snd : (B.map g).left ≫ CategoryTheory.Limits.pullback.snd U.hom f =
          CategoryTheory.Limits.pullback.snd W.hom f :=
        (congrArg (· ≫ CategoryTheory.Limits.pullback.snd U.hom f) hmap_left).trans
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      have h_bot : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst U.hom f)
          (CategoryTheory.Limits.pullback.snd U.hom f)
          U.hom f :=
        CategoryTheory.IsPullback.of_hasPullback U.hom f
      have h_outer₁ : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst W.hom f)
          ((B.map g).left ≫ CategoryTheory.Limits.pullback.snd U.hom f)
          W.hom f :=
        h_snd.symm ▸ CategoryTheory.IsPullback.of_hasPullback W.hom f
      have h_outer : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst W.hom f)
          ((B.map g).left ≫ CategoryTheory.Limits.pullback.snd U.hom f)
          (g.left ≫ U.hom) f :=
        (CategoryTheory.MorphismProperty.Over.w g).symm ▸ h_outer₁
      have h_pb : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst W.hom f)
          (B.map g).left
          g.left
          (CategoryTheory.Limits.pullback.fst U.hom f) :=
        CategoryTheory.IsPullback.of_bot h_outer h_top h_bot
      have hBg_et : AlgebraicGeometry.Etale (B.map g).left :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := P_et) h_pb hg_et
