    rwa [hdet_eq]
  have hDC : D_tilde * C = s_det • (1 : Matrix (Fin R_dim) (Fin R_dim) A₁) := by
    have hadj := Matrix.adjugate_mul M_sq
    ext r₁ r₂
    have h_entry := congrFun (congrFun hadj (Fin.castAdd K_pos r₁)) (Fin.castAdd K_pos r₂)
    have hLHS : (M_sq.adjugate * M_sq) (Fin.castAdd K_pos r₁) (Fin.castAdd K_pos r₂) =
        (D_tilde * C) r₁ r₂ := by
      simp only [Matrix.mul_apply, D_tilde, M_sq, Matrix.of_apply, Fin.addCases_left]
    have hRHS : (M_sq.det • (1 : Matrix (Fin N_tot) (Fin N_tot) A₁))
        (Fin.castAdd K_pos r₁) (Fin.castAdd K_pos r₂) =
        (s_det • (1 : Matrix (Fin R_dim) (Fin R_dim) A₁)) r₁ r₂ := by
      simp only [Matrix.smul_apply, Matrix.one_apply, Fin.castAdd_inj, s_det]
    exact hLHS.symm.trans (h_entry.trans hRHS)
  have hCD : C * D_tilde = s_det • P := by
    have hPM_left : ∀ (i : Fin N_tot) (r : Fin R_dim),
        (P * M_sq) i (Fin.castAdd K_pos r) = C i r := by
      intro i r
      calc
        (P * M_sq) i (Fin.castAdd K_pos r) = (P * C) i r := by
          simp only [Matrix.mul_apply, M_sq, Matrix.of_apply, Fin.addCases_left]
        _ = C i r := by rw [hPC]
    have hPM_right : ∀ (i : Fin N_tot) (l : Fin K_pos),
        (P * M_sq) i (Fin.natAdd R_dim l) = 0 := by
      intro i l
      calc
        (P * M_sq) i (Fin.natAdd R_dim l) = (P * J) i l := by
          simp only [Matrix.mul_apply, M_sq, Matrix.of_apply, Fin.addCases_right]
        _ = 0 := by rw [hPJ]; rfl
    have hPM_adj : (P * M_sq) * M_sq.adjugate = C * D_tilde := by
      ext i₁ i₂
      dsimp only [N_tot] at M_sq P C D_tilde hPM_left hPM_right i₁ i₂ ⊢
      rw [Matrix.mul_apply, Matrix.mul_apply, Fin.sum_univ_add]
      simp only [hPM_left, hPM_right, zero_mul, Finset.sum_const_zero, add_zero,
        D_tilde, Matrix.of_apply]
    have hP_adj_rhs : (P * M_sq) * M_sq.adjugate = s_det • P := by
      rw [Matrix.mul_assoc, Matrix.mul_adjugate, Matrix.mul_smul, Matrix.mul_one]
    exact hPM_adj.symm.trans hP_adj_rhs
  let c_col : Fin R_dim → (Fin N_tot → A₁) := fun r i => C i r
  have hc_col_snd : ∀ r : Fin R_dim, (E₁.symm (c_col r)).2 = 0 := by
    intro r
    rw [← hR_mulVec (c_col r)]
    ext l
    exact congrFun (congrFun hRC l) r
  choose ω hω using fun r : Fin R_dim =>
    Ideal.Quotient.mk_surjective (I := I_g) (E₁.symm (c_col r)).1
  have hE_ω : ∀ r : Fin R_dim, E₁ (mk_a I_g (ω r), 0) = c_col r := by
    intro r
    have hpair : (mk_a I_g (ω r), (0 : Fin K_pos → A₁)) = E₁.symm (c_col r) := by
      apply Prod.ext
      · rw [hmk_a I_g, hω r]
      · exact (hc_col_snd r).symm
    rw [hpair, E₁.apply_symm_apply]
  let Φ : R_tilde →ₗ[A₁] (Fin R_dim → A₁) :=
    (Matrix.mulVecLin D_tilde).comp
      (E₁.toLinearMap.comp ((LinearMap.inl A₁ Q (Fin K_pos → A₁)).comp (mk_a I_g)))
  have hΦ_apply : ∀ z : R_tilde, Φ z = D_tilde.mulVec (E₁ (mk_a I_g z, 0)) :=
    fun _ => rfl
  refine ⟨s_det, ω, Φ, hs_det_ev, ?_, ?_, ?_⟩
  · intro w
    have hmem : g_gen * w ∈ I_g := Ideal.mem_span_singleton.mpr ⟨w, rfl⟩
    have hmk0 : mk_a I_g (g_gen * w) = 0 := by
      rw [hmk_a I_g, Ideal.Quotient.eq_zero_iff_mem]
      exact hmem
    dsimp only [Φ]
    rw [LinearMap.comp_apply, LinearMap.comp_apply, LinearMap.comp_apply, hmk0,
      map_zero, map_zero, map_zero]
  · intro r₁ r₂
    rw [hΦ_apply (ω r₁), hE_ω r₁]
    have hmul : (D_tilde.mulVec (c_col r₁)) r₂ = (D_tilde * C) r₂ r₁ := rfl
    rw [hmul, hDC]
    simp [Matrix.one_apply, eq_comm]
  · intro z
    let v : Fin N_tot → A₁ := E₁ (mk_a I_g z, 0)
    have hRv : R.mulVec v = 0 := by
      dsimp only [v]
      rw [hR_mulVec, E₁.symm_apply_apply]
    have hPv : P.mulVec v = v := by
      dsimp only [P]
      rw [Matrix.sub_mulVec, Matrix.one_mulVec, ← Matrix.mulVec_mulVec, hRv,
        Matrix.mulVec_zero, sub_zero]
    have h_cramer_v : C.mulVec (Φ z) = s_det • v := by
      calc
        C.mulVec (Φ z) = C.mulVec (D_tilde.mulVec v) := rfl
        _ = (C * D_tilde).mulVec v := Matrix.mulVec_mulVec v C D_tilde
        _ = (s_det • P).mulVec v := by rw [hCD]
        _ = s_det • (P.mulVec v) := Matrix.smul_mulVec s_det P v
        _ = s_det • v := by rw [hPv]
    let inl_E : R_tilde →ₗ[A₁] (Fin N_tot → A₁) :=
      E₁.toLinearMap.comp ((LinearMap.inl A₁ Q (Fin K_pos → A₁)).comp (mk_a I_g))
    have h_lhs_E : C.mulVec (Φ z) =
        inl_E (Finset.univ.sum fun r : Fin R_dim => algebraMap A₁ R_tilde (Φ z r) * ω r) := by
      have h_sum_eq :
          (Finset.univ.sum fun r : Fin R_dim => algebraMap A₁ R_tilde (Φ z r) * ω r) =
          Finset.univ.sum fun r : Fin R_dim => Φ z r • ω r :=
        Finset.sum_congr rfl fun r _ => (Algebra.smul_def (Φ z r) (ω r)).symm
      rw [h_sum_eq, map_sum]
      ext i
      simp only [Matrix.mulVec, dotProduct, Finset.sum_apply, LinearMap.map_smul,
        Pi.smul_apply, smul_eq_mul]
      refine Finset.sum_congr rfl fun r _ => ?_
      have hω_r : inl_E (ω r) i = C i r := congrFun (hE_ω r) i
      rw [hω_r, mul_comm]
    have h_rhs_E : s_det • v = inl_E (algebraMap A₁ R_tilde s_det * z) := by
      have h_smul_z : algebraMap A₁ R_tilde s_det * z = s_det • z :=
        (Algebra.smul_def s_det z).symm
      rw [h_smul_z, map_smul]
      rfl
    have h_eq_E : inl_E (algebraMap A₁ R_tilde s_det * z) =
        inl_E (Finset.univ.sum fun r : Fin R_dim => algebraMap A₁ R_tilde (Φ z r) * ω r) :=
      h_rhs_E.symm.trans (h_cramer_v.symm.trans h_lhs_E)
    have h_eq_Q : mk_a I_g (algebraMap A₁ R_tilde s_det * z) =
        mk_a I_g (Finset.univ.sum fun r : Fin R_dim => algebraMap A₁ R_tilde (Φ z r) * ω r) :=
      congrArg Prod.fst (E₁.injective h_eq_E)
    have h_sub_Q : mk_a I_g (algebraMap A₁ R_tilde s_det * z -
        (Finset.univ.sum fun r : Fin R_dim => algebraMap A₁ R_tilde (Φ z r) * ω r)) = 0 := by
      rw [map_sub, h_eq_Q, sub_self]
    rw [hmk_a I_g, Ideal.Quotient.eq_zero_iff_mem] at h_sub_Q
    exact h_sub_Q

theorem weil_away_cramer_baseChange_mulVec_iff (k : Type u) [Field k]
    (B₀ : Type u) [CommRing B₀] [Algebra k B₀]
    (A₁ : Type u) [CommRing A₁] [Algebra k A₁]
    (H₁ g₁ : TensorProduct k B₀ A₁)
    (R_dim : ℕ) (s_det : A₁)
    (ω₁ : Fin R_dim → Localization.Away H₁)
    (Φ₁ : Localization.Away H₁ →+ (Fin R_dim → A₁)) :
    (∀ (a : A₁) (z : Localization.Away H₁),
      Φ₁ (algebraMap (TensorProduct k B₀ A₁) (Localization.Away H₁) ((1 : B₀) ⊗ₜ[k] a) * z) =
        a • Φ₁ z) →
    (∀ w : Localization.Away H₁,
      Φ₁ (algebraMap (TensorProduct k B₀ A₁) (Localization.Away H₁) g₁ * w) = 0) →
    (∀ r₁ r₂ : Fin R_dim, Φ₁ (ω₁ r₁) r₂ = if r₁ = r₂ then s_det else 0) →
    (∀ z : Localization.Away H₁,
      algebraMap (TensorProduct k B₀ A₁) (Localization.Away H₁) ((1 : B₀) ⊗ₜ[k] s_det) * z -
        (Finset.univ.sum fun r : Fin R_dim =>
          algebraMap (TensorProduct k B₀ A₁) (Localization.Away H₁)
            ((1 : B₀) ⊗ₜ[k] Φ₁ z r) * ω₁ r) ∈
        Ideal.span ({algebraMap (TensorProduct k B₀ A₁) (Localization.Away H₁) g₁} :
          Set (Localization.Away H₁))) →
    ∀ (A' : Type u) [CommRing A'] [Algebra k A']
      (σ : A₁ →ₐ[k] A') (u_inv : A'),
      σ s_det * u_inv = 1 →
      ∀ (N_V : ℕ) (v_bas : Fin N_V → B₀) (c : Fin N_V → A'),
        let σ_R : TensorProduct k B₀ A₁ →ₐ[k] TensorProduct k B₀ A' :=
          Algebra.TensorProduct.map (AlgHom.id k B₀) σ
        let H' : TensorProduct k B₀ A' := σ_R H₁
        let g' : TensorProduct k B₀ A' := σ_R g₁
        let Θ' : Matrix (Fin R_dim) (Fin N_V) A' :=
          Matrix.of fun r ν =>
            u_inv * σ (Φ₁ (algebraMap (TensorProduct k B₀ A₁) (Localization.Away H₁)
              (v_bas ν ⊗ₜ[k] (1 : A₁))) r)
        Θ'.mulVec c = 0 ↔
          algebraMap (TensorProduct k B₀ A') (Localization.Away H')
            (Finset.univ.sum fun ν : Fin N_V => v_bas ν ⊗ₜ[k] c ν) ∈
            Ideal.span ({algebraMap (TensorProduct k B₀ A') (Localization.Away H') g'} :
              Set (Localization.Away H')) :=
by
  intro hΦ₁_smul hΦ₁_kill _hΦ₁_dual hΦ₁_span A' _ _ σ u_inv h_inv N_V v_bas c σ_R H' g' Θ'
  let ι₁ : TensorProduct k B₀ A₁ →+* Localization.Away H₁ :=
    algebraMap (TensorProduct k B₀ A₁) (Localization.Away H₁)
  let ι' : TensorProduct k B₀ A' →+* Localization.Away H' :=
    algebraMap (TensorProduct k B₀ A') (Localization.Away H')
  let z_ν : Fin N_V → Localization.Away H₁ :=
    fun ν => ι₁ (v_bas ν ⊗ₜ[k] (1 : A₁))
  let V_c : TensorProduct k B₀ A' :=
    Finset.univ.sum fun ν : Fin N_V => v_bas ν ⊗ₜ[k] c ν
  constructor
  · intro h_mv
    let f_hom : TensorProduct k B₀ A₁ →+* Localization.Away H' :=
      ι'.comp σ_R.toRingHom
    have hu_H' : IsUnit (f_hom H₁) := by
      change IsUnit (ι' H')
      exact IsLocalization.Away.algebraMap_isUnit H'
    let σ_tilde : Localization.Away H₁ →+* Localization.Away H' :=
      IsLocalization.Away.lift (S := Localization.Away H₁) H₁ hu_H'
    have hσ_tilde_eq : ∀ x : TensorProduct k B₀ A₁, σ_tilde (ι₁ x) = ι' (σ_R x) :=
      fun x => IsLocalization.Away.lift_eq (S := Localization.Away H₁) H₁ hu_H' x
    let I' : Ideal (Localization.Away H') :=
      Ideal.span ({ι' g'} : Set (Localization.Away H'))
    have h_pushed : ∀ ν : Fin N_V,
        ι' ((1 : B₀) ⊗ₜ[k] σ s_det) * ι' (v_bas ν ⊗ₜ[k] (1 : A')) -
          (Finset.univ.sum fun r : Fin R_dim =>
            ι' ((1 : B₀) ⊗ₜ[k] σ (Φ₁ (z_ν ν) r)) * σ_tilde (ω₁ r)) ∈ I' := by
      intro ν
      obtain ⟨q_ν, hq_ν⟩ := Ideal.mem_span_singleton.mp (hΦ₁_span (z_ν ν))
      rw [Ideal.mem_span_singleton]
      refine ⟨σ_tilde q_ν, ?_⟩
      have h_ap := congrArg σ_tilde hq_ν
      change σ_tilde (ι₁ ((1 : B₀) ⊗ₜ[k] s_det) * ι₁ (v_bas ν ⊗ₜ[k] (1 : A₁)) -
          Finset.univ.sum fun r : Fin R_dim =>
            ι₁ ((1 : B₀) ⊗ₜ[k] Φ₁ (z_ν ν) r) * ω₁ r) =
        σ_tilde (ι₁ g₁ * q_ν) at h_ap
      rw [map_sub, map_mul, map_sum, map_mul, hσ_tilde_eq, hσ_tilde_eq] at h_ap
      simpa only [map_mul, hσ_tilde_eq, σ_R, g', Algebra.TensorProduct.map_tmul,
        AlgHom.id_apply, map_one] using h_ap
    let m_ν : Fin N_V → Localization.Away H' :=
      fun ν => ι' ((1 : B₀) ⊗ₜ[k] (u_inv * c ν))
    have h_sum_mem :
        (Finset.univ.sum fun ν : Fin N_V =>
          m_ν ν * (ι' ((1 : B₀) ⊗ₜ[k] σ s_det) * ι' (v_bas ν ⊗ₜ[k] (1 : A')) -
            (Finset.univ.sum fun r : Fin R_dim =>
              ι' ((1 : B₀) ⊗ₜ[k] σ (Φ₁ (z_ν ν) r)) * σ_tilde (ω₁ r)))) ∈ I' :=
      Submodule.sum_mem I' fun ν _ => I'.mul_mem_left (m_ν ν) (h_pushed ν)
    have hS₁ :
        (Finset.univ.sum fun ν : Fin N_V =>
          m_ν ν * (ι' ((1 : B₀) ⊗ₜ[k] σ s_det) * ι' (v_bas ν ⊗ₜ[k] (1 : A')))) =
        ι' V_c := by
      dsimp only [V_c, m_ν]
      rw [map_sum]
      refine Finset.sum_congr rfl fun ν _ => ?_
      rw [← map_mul, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul,
        Algebra.TensorProduct.tmul_mul_tmul]
      congr 1
      have hb : (1 : B₀) * ((1 : B₀) * v_bas ν) = v_bas ν := by rw [one_mul, one_mul]
      have ha : (u_inv * c ν) * (σ s_det * (1 : A')) = c ν := by
        calc
          (u_inv * c ν) * (σ s_det * (1 : A')) = (σ s_det * u_inv) * c ν := by ring
          _ = 1 * c ν := by rw [h_inv]
          _ = c ν := one_mul (c ν)
      rw [hb, ha]
    have hS₂ :
        (Finset.univ.sum fun ν : Fin N_V =>
          m_ν ν * (Finset.univ.sum fun r : Fin R_dim =>
            ι' ((1 : B₀) ⊗ₜ[k] σ (Φ₁ (z_ν ν) r)) * σ_tilde (ω₁ r))) = 0 := by
      have h_step1 :
          (Finset.univ.sum fun ν : Fin N_V =>
            m_ν ν * (Finset.univ.sum fun r : Fin R_dim =>
              ι' ((1 : B₀) ⊗ₜ[k] σ (Φ₁ (z_ν ν) r)) * σ_tilde (ω₁ r))) =
          Finset.univ.sum fun r : Fin R_dim =>
            (Finset.univ.sum fun ν : Fin N_V =>
              m_ν ν * ι' ((1 : B₀) ⊗ₜ[k] σ (Φ₁ (z_ν ν) r))) * σ_tilde (ω₁ r) := by
        simp_rw [Finset.mul_sum, ← mul_assoc]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun r _ => ?_
        rw [← Finset.sum_mul]
      rw [h_step1]
      refine Finset.sum_eq_zero fun r _ => ?_
      have h_inner :
          (Finset.univ.sum fun ν : Fin N_V =>
            m_ν ν * ι' ((1 : B₀) ⊗ₜ[k] σ (Φ₁ (z_ν ν) r))) =
          ι' ((1 : B₀) ⊗ₜ[k] ((Θ'.mulVec c) r)) := by
        let τ₁ : A' →+ Localization.Away H' :=
          ι'.toAddMonoidHom.comp (TensorProduct.mk k B₀ A' (1 : B₀)).toAddMonoidHom
        have h_term : ∀ ν : Fin N_V,
            m_ν ν * ι' ((1 : B₀) ⊗ₜ[k] σ (Φ₁ (z_ν ν) r)) = τ₁ (Θ' r ν * c ν) := by
          intro ν
          dsimp only [m_ν, τ₁, Θ', z_ν, ι₁]
          simp only [AddMonoidHom.comp_apply, RingHom.toAddMonoidHom_eq_coe,
            AddMonoidHom.coe_coe, Matrix.of_apply]
          change ι' ((1 : B₀) ⊗ₜ[k] (u_inv * c ν)) *
              ι' ((1 : B₀) ⊗ₜ[k] σ (Φ₁ ((algebraMap (TensorProduct k B₀ A₁)
                (Localization.Away H₁)) (v_bas ν ⊗ₜ[k] (1 : A₁))) r)) =
            ι' ((1 : B₀) ⊗ₜ[k] ((u_inv * σ (Φ₁ ((algebraMap (TensorProduct k B₀ A₁)
              (Localization.Away H₁)) (v_bas ν ⊗ₜ[k] (1 : A₁))) r)) * c ν))
          rw [← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
          congr 2
          ring
        simp_rw [h_term]
        rw [← map_sum τ₁]
        rfl
      have h_mv_r : (Θ'.mulVec c) r = 0 := by
        rw [h_mv]
        rfl
      rw [h_inner, h_mv_r, TensorProduct.tmul_zero, map_zero, zero_mul]
    have h_eq :
        (Finset.univ.sum fun ν : Fin N_V =>
          m_ν ν * (ι' ((1 : B₀) ⊗ₜ[k] σ s_det) * ι' (v_bas ν ⊗ₜ[k] (1 : A')) -
            (Finset.univ.sum fun r : Fin R_dim =>
              ι' ((1 : B₀) ⊗ₜ[k] σ (Φ₁ (z_ν ν) r)) * σ_tilde (ω₁ r)))) =
        ι' V_c := by
      simp_rw [mul_sub]
      rw [Finset.sum_sub_distrib, hS₁, hS₂, sub_zero]
    rwa [h_eq] at h_sum_mem
  · intro h_mem
    obtain ⟨w', hw'⟩ := Ideal.mem_span_singleton.mp h_mem
    obtain ⟨m₁, q₁, hq₁⟩ := IsLocalization.Away.surj H' w'
    have h_loc_eq : ι' (V_c * H' ^ m₁) = ι' (g' * q₁) := by
      calc
        ι' (V_c * H' ^ m₁) = ι' V_c * ι' H' ^ m₁ := by rw [map_mul, map_pow]
        _ = (ι' g' * w') * ι' H' ^ m₁ := by rw [hw']
        _ = ι' g' * (w' * ι' H' ^ m₁) := by rw [mul_assoc]
        _ = ι' g' * ι' q₁ := by rw [hq₁]
        _ = ι' (g' * q₁) := by rw [← map_mul]
    obtain ⟨⟨c₂, hc₂⟩, heq₂⟩ :=
      IsLocalization.exists_of_eq (M := Submonoid.powers H') h_loc_eq
    obtain ⟨m₂, hm₂⟩ := (Submonoid.mem_powers_iff c₂ H').mp hc₂
    let M : ℕ := m₁ + m₂
    let Q' : TensorProduct k B₀ A' := H' ^ m₂ * q₁
    have h_clear : H' ^ M * V_c = g' * Q' := by
      dsimp only [M, Q']
      have heq₂' : H' ^ m₂ * (V_c * H' ^ m₁) = H' ^ m₂ * (g' * q₁) := by
        simpa only [← hm₂] using heq₂
      calc
        H' ^ (m₁ + m₂) * V_c = H' ^ m₂ * (V_c * H' ^ m₁) := by rw [pow_add]; ring
        _ = H' ^ m₂ * (g' * q₁) := heq₂'
        _ = g' * (H' ^ m₂ * q₁) := by ring
    let L_inner : Localization.Away H₁ → B₀ → (A' →ₗ[k] (Fin R_dim → A')) :=
      fun w b =>
        { toFun := fun a' r => a' * σ (Φ₁ (w * ι₁ (b ⊗ₜ[k] (1 : A₁))) r)
          map_add' := fun a₁' a₂' => by
            ext r
            simp only [Pi.add_apply, add_mul]
          map_smul' := fun κ a' => by
            ext r
            simp only [RingHom.id_apply, Pi.smul_apply, Algebra.smul_def, mul_assoc] }
    let L_bilin : Localization.Away H₁ → (B₀ →ₗ[k] (A' →ₗ[k] (Fin R_dim → A'))) :=
      fun w =>
        { toFun := fun b => L_inner w b
          map_add' := fun b₁ b₂ => by
            ext a' r
            simp only [L_inner, LinearMap.coe_mk, AddHom.coe_mk, LinearMap.add_apply,
              Pi.add_apply, TensorProduct.add_tmul, map_add, mul_add]
          map_smul' := fun κ b => by
            ext a' r
            simp only [L_inner, LinearMap.coe_mk, AddHom.coe_mk, RingHom.id_apply,
              LinearMap.smul_apply, Pi.smul_apply]
            have h_tmul : (κ • b) ⊗ₜ[k] (1 : A₁) =
                ((1 : B₀) ⊗ₜ[k] algebraMap k A₁ κ) * (b ⊗ₜ[k] (1 : A₁)) := by
              rw [TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
                Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
            have h_arg : w * ι₁ ((κ • b) ⊗ₜ[k] (1 : A₁)) =
                ι₁ ((1 : B₀) ⊗ₜ[k] algebraMap k A₁ κ) * (w * ι₁ (b ⊗ₜ[k] (1 : A₁))) := by
              rw [h_tmul, map_mul, mul_left_comm]
            rw [h_arg, hΦ₁_smul]
            simp only [Pi.smul_apply, smul_eq_mul, map_mul, AlgHom.commutes]
            rw [Algebra.smul_def]
            ring }
    let L : Localization.Away H₁ → (TensorProduct k B₀ A' →ₗ[k] (Fin R_dim → A')) :=
      fun w => TensorProduct.lift (L_bilin w)
    have hL_tmul : ∀ (w : Localization.Away H₁) (b : B₀) (a' : A') (r : Fin R_dim),
        L w (b ⊗ₜ[k] a') r = a' * σ (Φ₁ (w * ι₁ (b ⊗ₜ[k] (1 : A₁))) r) := by
      intro w b a' r
      rfl
    have hL_add_w : ∀ (w₁ w₂ : Localization.Away H₁) (y : TensorProduct k B₀ A'),
        L (w₁ + w₂) y = L w₁ y + L w₂ y := by
      intro w₁ w₂
      have h_lin : L (w₁ + w₂) = L w₁ + L w₂ := by
        apply TensorProduct.ext'
        intro b a'
        ext r
        simp only [LinearMap.add_apply, Pi.add_apply, hL_tmul, add_mul, map_add, mul_add]
      intro y
      rw [h_lin, LinearMap.add_apply]
    have hL_shift : ∀ (x : TensorProduct k B₀ A₁) (w : Localization.Away H₁)
        (y : TensorProduct k B₀ A'),
        L w (σ_R x * y) = L (w * ι₁ x) y := by
      intro x
      refine TensorProduct.inductionOn x ?_ ?_
      · intro b₁ a₁ w y
        refine TensorProduct.inductionOn y ?_ ?_
        · intro b₂ a₂'
          ext r
          have h_mul_R' : σ_R (b₁ ⊗ₜ[k] a₁) * (b₂ ⊗ₜ[k] a₂') =
              (b₁ * b₂) ⊗ₜ[k] (σ a₁ * a₂') := by
            dsimp only [σ_R]
            rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
              Algebra.TensorProduct.tmul_mul_tmul]
          rw [h_mul_R', hL_tmul, hL_tmul]
          have h_prod_R₁ :
              ((1 : B₀) ⊗ₜ[k] a₁) * ((b₁ * b₂) ⊗ₜ[k] (1 : A₁)) =
              (b₁ ⊗ₜ[k] a₁) * (b₂ ⊗ₜ[k] (1 : A₁)) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
              one_mul, mul_one]
          have h_arg :
              (w * ι₁ (b₁ ⊗ₜ[k] a₁)) * ι₁ (b₂ ⊗ₜ[k] (1 : A₁)) =
              ι₁ ((1 : B₀) ⊗ₜ[k] a₁) * (w * ι₁ ((b₁ * b₂) ⊗ₜ[k] (1 : A₁))) := by
            calc
              (w * ι₁ (b₁ ⊗ₜ[k] a₁)) * ι₁ (b₂ ⊗ₜ[k] (1 : A₁)) =
                  w * (ι₁ (b₁ ⊗ₜ[k] a₁) * ι₁ (b₂ ⊗ₜ[k] (1 : A₁))) := by rw [mul_assoc]
              _ = w * ι₁ ((b₁ ⊗ₜ[k] a₁) * (b₂ ⊗ₜ[k] (1 : A₁))) := by rw [← map_mul]
              _ = w * ι₁ (((1 : B₀) ⊗ₜ[k] a₁) * ((b₁ * b₂) ⊗ₜ[k] (1 : A₁))) := by
                rw [← h_prod_R₁]
              _ = w * (ι₁ ((1 : B₀) ⊗ₜ[k] a₁) * ι₁ ((b₁ * b₂) ⊗ₜ[k] (1 : A₁))) := by
                rw [map_mul]
              _ = ι₁ ((1 : B₀) ⊗ₜ[k] a₁) * (w * ι₁ ((b₁ * b₂) ⊗ₜ[k] (1 : A₁))) := by
                rw [mul_left_comm]
          rw [h_arg, hΦ₁_smul]
          simp only [Pi.smul_apply, smul_eq_mul, map_mul]
          ring
        · intro y₁ y₂ ih₁ ih₂
          rw [mul_add, map_add, map_add, ih₁, ih₂]
      · intro x₁ x₂ ih₁ ih₂ w y
        rw [map_add, add_mul, map_add, ih₁, ih₂, ← hL_add_w, ← mul_add, ← map_add]
    have hL_kill : ∀ (u : Localization.Away H₁) (y : TensorProduct k B₀ A'),
        L (ι₁ g₁ * u) y = 0 := by
      intro u
      have h_lin : L (ι₁ g₁ * u) = 0 := by
        apply TensorProduct.ext'
        intro b a'
        ext r
        simp only [LinearMap.zero_apply, Pi.zero_apply, hL_tmul]
        rw [mul_assoc, hΦ₁_kill]
        simp only [Pi.zero_apply, map_zero, mul_zero]
      intro y
      rw [h_lin, LinearMap.zero_apply]
    let inv₁ : Localization.Away H₁ :=
      IsLocalization.Away.invSelf (S := Localization.Away H₁) H₁
    have h_inv₁_pow : inv₁ ^ M * ι₁ (H₁ ^ M) = 1 := by
      rw [map_pow, ← mul_pow, mul_comm,
        IsLocalization.Away.mul_invSelf (S := Localization.Away H₁) H₁, one_pow]
    have hL1_Vc : L 1 V_c = 0 := by
      calc
        L 1 V_c = L (inv₁ ^ M * ι₁ (H₁ ^ M)) V_c := by rw [h_inv₁_pow]
        _ = L (inv₁ ^ M) (σ_R (H₁ ^ M) * V_c) := (hL_shift (H₁ ^ M) (inv₁ ^ M) V_c).symm
        _ = L (inv₁ ^ M) (H' ^ M * V_c) := by rw [map_pow]
        _ = L (inv₁ ^ M) (g' * Q') := by rw [h_clear]
        _ = L (inv₁ ^ M * ι₁ g₁) Q' := hL_shift g₁ (inv₁ ^ M) Q'
        _ = L (ι₁ g₁ * inv₁ ^ M) Q' := by rw [mul_comm]
        _ = 0 := hL_kill (inv₁ ^ M) Q'
    ext r
    have hL1_r : (Finset.univ.sum fun ν : Fin N_V =>
        c ν * σ (Φ₁ (z_ν ν) r)) = 0 := by
      have h0 : L 1 V_c r = 0 := congrFun hL1_Vc r
      dsimp only [V_c] at h0
      rw [map_sum, Finset.sum_apply] at h0
      simpa only [hL_tmul, one_mul, z_ν] using h0
    simp only [Pi.zero_apply, Matrix.mulVec, dotProduct, Θ', Matrix.of_apply, z_ν, ι₁] at hL1_r ⊢
    calc
      (Finset.univ.sum fun ν : Fin N_V =>
          (u_inv * σ (Φ₁ (algebraMap (TensorProduct k B₀ A₁) (Localization.Away H₁)
            (v_bas ν ⊗ₜ[k] (1 : A₁))) r)) * c ν) =
        u_inv * (Finset.univ.sum fun ν : Fin N_V =>
          c ν * σ (Φ₁ (algebraMap (TensorProduct k B₀ A₁) (Localization.Away H₁)
            (v_bas ν ⊗ₜ[k] (1 : A₁))) r)) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun ν _ => ?_
        ring
      _ = u_inv * 0 := by rw [hL1_r]
      _ = 0 := mul_zero u_inv

theorem weil_rel_principalized_quotient_free_and_baseChange (k : Type u) [Field k] [IsAlgClosed k]
    (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [Algebra k B₀]
    (t : B₀) (n : ℕ) (_hn : 1 ≤ n) (b : Fin n → B₀)
    (_hb : Function.Bijective (fun c : Fin n → Polynomial k =>
      Finset.univ.sum fun i : Fin n => Polynomial.aeval t (c i) * b i))
    (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [Algebra k A₀]
    (ev₀ : A₀ →ₐ[k] k)
    (K_pos K_neg : ℕ) (_hK_pos : 1 ≤ K_pos)
    (p_pos : Fin K_pos → (B₀ →ₐ[k] A₀))
    (q_neg : Fin K_neg → (B₀ →ₐ[k] A₀))
    (z_pos : Fin K_pos → B₀)
    (z_neg : Fin K_neg → B₀) :
    let Δ_bar : B₀ :=
      (Finset.univ.prod fun i : Fin K_pos => t - algebraMap k B₀ (ev₀ (p_pos i t))) *
      (Finset.univ.prod fun j : Fin K_neg => t - algebraMap k B₀ (ev₀ (q_neg j t)))
    (∀ i : Fin K_pos,
      let 𝔪_i := RingHom.ker (ev₀.comp (p_pos i)).toRingHom
      let u_i := z_pos i - algebraMap k B₀ (ev₀ (p_pos i (z_pos i)))
      𝔪_i = Ideal.span ({u_i} : Set B₀) ⊔ Ideal.span ({Δ_bar} : Set B₀) • 𝔪_i) →
    (∀ j : Fin K_neg,
      let 𝔫_j := RingHom.ker (ev₀.comp (q_neg j)).toRingHom
      let v_j := z_neg j - algebraMap k B₀ (ev₀ (q_neg j (z_neg j)))
      𝔫_j = Ideal.span ({v_j} : Set B₀) ⊔ Ideal.span ({Δ_bar} : Set B₀) • 𝔫_j) →
    ∀ (N_V : ℕ) (v_bas : Fin N_V → B₀),
    ∃ (a_loc : A₀),
      ev₀ a_loc ≠ 0 ∧
      let A := Localization.Away a_loc
      let R_A := TensorProduct k B₀ A
      let R_dim := (n - 1) * K_pos + K_neg
      let ι_A : A₀ →ₐ[k] A := IsScalarTower.toAlgHom k A₀ A
      let p_A : Fin K_pos → (B₀ →ₐ[k] A) := fun i => ι_A.comp (p_pos i)
      let q_A : Fin K_neg → (B₀ →ₐ[k] A) := fun j => ι_A.comp (q_neg j)
      let μ_pos : Fin K_pos → (R_A →ₐ[k] A) := fun i =>
        Algebra.TensorProduct.productMap (p_A i) (AlgHom.id k A)
      let μ_neg : Fin K_neg → (R_A →ₐ[k] A) := fun j =>
        Algebra.TensorProduct.productMap (q_A j) (AlgHom.id k A)
      let Δ_pos : R_A := Finset.univ.prod fun i : Fin K_pos =>
        t ⊗ₜ[k] (1 : A) - (1 : B₀) ⊗ₜ[k] (p_A i t)
      let Δ_neg : R_A := Finset.univ.prod fun j : Fin K_neg =>
        t ⊗ₜ[k] (1 : A) - (1 : B₀) ⊗ₜ[k] (q_A j t)
      let u_pos : Fin K_pos → R_A := fun i =>
        z_pos i ⊗ₜ[k] (1 : A) - (1 : B₀) ⊗ₜ[k] (p_A i (z_pos i))
      let u_neg : Fin K_neg → R_A := fun j =>
        z_neg j ⊗ₜ[k] (1 : A) - (1 : B₀) ⊗ₜ[k] (q_A j (z_neg j))
      ∃ (H W_num : R_A) (m_W : ℕ) (Θ_A : Matrix (Fin R_dim) (Fin N_V) A),
        H - 1 ∈ Ideal.span ({Δ_pos * Δ_neg} : Set R_A) ∧
        (∀ (i : Fin K_pos) (r : R_A),
          r ∈ RingHom.ker (μ_pos i).toRingHom → H * r ∈ Ideal.span ({u_pos i} : Set R_A)) ∧
        (∀ (j : Fin K_neg) (r : R_A),
          r ∈ RingHom.ker (μ_neg j).toRingHom → H * r ∈ Ideal.span ({u_neg j} : Set R_A)) ∧
        (Finset.univ.prod u_pos) * W_num = H ^ m_W * Δ_pos ∧
        (∀ (A' : Type u) [CommRing A'] [Algebra k A'] (ψ : A →ₐ[k] A') (c : Fin N_V → A'),
          let ψ_R : R_A →ₐ[k] TensorProduct k B₀ A' :=
            Algebra.TensorProduct.map (AlgHom.id k B₀) ψ
          let H' : TensorProduct k B₀ A' := ψ_R H
          let gen' : TensorProduct k B₀ A' :=
            ψ_R (W_num * Finset.univ.prod u_neg)
          (Θ_A.map ψ).mulVec c = 0 ↔
            algebraMap (TensorProduct k B₀ A') (Localization.Away H')
              (Finset.univ.sum fun ν : Fin N_V => v_bas ν ⊗ₜ[k] c ν) ∈
              Ideal.span ({algebraMap (TensorProduct k B₀ A') (Localization.Away H') gen'} :
                Set (Localization.Away H'))) :=
by
  classical
  intro Δ_bar h_pos₀ h_neg₀ N_V v_bas
  obtain ⟨hDomLin, hKerSpan, hMonicBij⟩ :=
    weil_poly_free_tensor_domain_and_monic_quotient k B₀ t n _hn b _hb
  have hRem₀ :
      let Δ_pos₀ : TensorProduct k B₀ A₀ :=
        Finset.univ.prod fun i : Fin K_pos => t ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] p_pos i t
      let Δ_neg₀ : TensorProduct k B₀ A₀ :=
        Finset.univ.prod fun j : Fin K_neg => t ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] q_neg j t
      ∀ r : TensorProduct k B₀ A₀,
        ∃ (q : TensorProduct k B₀ A₀) (c : Fin (n * (K_pos + K_neg)) → A₀),
          r = (Δ_pos₀ * Δ_neg₀) * q +
            Finset.univ.sum fun idx : Fin (n * (K_pos + K_neg)) =>
              (t ^ ((finProdFinEquiv.symm idx).2 : ℕ) * b (finProdFinEquiv.symm idx).1) ⊗ₜ[k] c idx := by
    intro Δ_pos₀ Δ_neg₀ r
    let α₀ : Fin (K_pos + K_neg) → A₀ :=
      Fin.append (fun i => p_pos i t) (fun j => q_neg j t)
    let Δ_S₀ : TensorProduct k B₀ A₀ :=
      Finset.univ.prod fun l : Fin (K_pos + K_neg) => t ⊗ₜ[k] (1 : A₀) - (1 : B₀) ⊗ₜ[k] α₀ l
    have hΔ_eq : Δ_S₀ = Δ_pos₀ * Δ_neg₀ := by
      dsimp only [Δ_S₀, Δ_pos₀, Δ_neg₀, α₀]
      rw [Fin.prod_univ_add]
      simp only [Fin.append_left, Fin.append_right]
    obtain ⟨c, hc⟩ := (hMonicBij A₀ (K_pos + K_neg) α₀).2
      (Ideal.Quotient.mk (Ideal.span ({Δ_S₀} : Set (TensorProduct k B₀ A₀))) r)
    have hmem : r - (Finset.univ.sum fun idx : Fin (n * (K_pos + K_neg)) =>
        (t ^ ((finProdFinEquiv.symm idx).2 : ℕ) * b (finProdFinEquiv.symm idx).1) ⊗ₜ[k] c idx) ∈
        Ideal.span ({Δ_S₀} : Set (TensorProduct k B₀ A₀)) :=
      Ideal.Quotient.eq.mp hc.symm
    rw [Ideal.mem_span_singleton] at hmem
    rcases hmem with ⟨q, hq⟩
    refine ⟨q, c, ?_⟩
    rw [← hΔ_eq, ← hq]
    ring
  obtain ⟨a₁, ha₁, H₁, hH₁_mod, hH₁_pos, hH₁_neg⟩ :=
    weil_two_stage_nakayama_graph_principalization
      k B₀ t n b A₀ ev₀ K_pos K_neg p_pos q_neg z_pos z_neg
      hKerSpan hRem₀ ⟨h_pos₀, h_neg₀⟩
  let ι₁ : A₀ →ₐ[k] Localization.Away a₁ := IsScalarTower.toAlgHom k A₀ (Localization.Away a₁)
  let p₁ : Fin K_pos → (B₀ →ₐ[k] Localization.Away a₁) := fun i => ι₁.comp (p_pos i)
  let q₁ : Fin K_neg → (B₀ →ₐ[k] Localization.Away a₁) := fun j => ι₁.comp (q_neg j)
  let μ_pos₁ : Fin K_pos → (TensorProduct k B₀ (Localization.Away a₁) →ₐ[k] Localization.Away a₁) :=
    fun i => Algebra.TensorProduct.productMap (p₁ i) (AlgHom.id k (Localization.Away a₁))
  let μ_neg₁ : Fin K_neg → (TensorProduct k B₀ (Localization.Away a₁) →ₐ[k] Localization.Away a₁) :=
    fun j => Algebra.TensorProduct.productMap (q₁ j) (AlgHom.id k (Localization.Away a₁))
  let Δ_pos₁ : TensorProduct k B₀ (Localization.Away a₁) := Finset.univ.prod fun i : Fin K_pos =>
    t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (p₁ i t)
  let Δ_neg₁ : TensorProduct k B₀ (Localization.Away a₁) := Finset.univ.prod fun j : Fin K_neg =>
    t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (q₁ j t)
  let u_pos₁ : Fin K_pos → TensorProduct k B₀ (Localization.Away a₁) := fun i =>
    z_pos i ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (p₁ i (z_pos i))
  let u_neg₁ : Fin K_neg → TensorProduct k B₀ (Localization.Away a₁) := fun j =>
    z_neg j ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (q₁ j (z_neg j))
  have ha₁_ne : a₁ ≠ 0 := by
    intro h0
    have : ev₀ a₁ = 0 := by rw [h0, map_zero]
    rw [ha₁] at this
    exact one_ne_zero this
  have hpow_a₁ : Submonoid.powers a₁ ≤ nonZeroDivisors A₀ := by
    rintro _ ⟨m, rfl⟩
    exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero m ha₁_ne)
  have : IsDomain (Localization.Away a₁) := IsLocalization.isDomain_localization hpow_a₁
  have hev₀_unit : IsUnit (ev₀.toRingHom a₁) := by
    rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, ha₁]
    exact isUnit_one
  let ev₁_hom : Localization.Away a₁ →+* k :=
    IsLocalization.Away.lift (S := Localization.Away a₁) a₁ hev₀_unit
  have hev₁_eq : ∀ x : A₀, ev₁_hom (algebraMap A₀ (Localization.Away a₁) x) = ev₀ x :=
    fun x => IsLocalization.Away.lift_eq (S := Localization.Away a₁) a₁ hev₀_unit x
  let ev₁ : Localization.Away a₁ →ₐ[k] k :=
    { ev₁_hom with
      commutes' := fun c => by
        change ev₁_hom (algebraMap k (Localization.Away a₁) c) = c
        rw [IsScalarTower.algebraMap_apply k A₀ (Localization.Away a₁) c]
        exact (hev₁_eq (algebraMap k A₀ c)).trans (ev₀.commutes c) }
  have : IsDomain (TensorProduct k B₀ (Localization.Away a₁)) :=
    (hDomLin (Localization.Away a₁)).1
  have hLinNe₁ : ∀ s₀ : Localization.Away a₁,
      t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] s₀ ≠ 0 :=
    (hDomLin (Localization.Away a₁)).2
  have hμ_pos_H₁ : ∀ i : Fin K_pos, μ_pos₁ i H₁ = 1 := by
    intro i
    have hfac : t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (p₁ i t) ∣ Δ_pos₁ :=
      Finset.dvd_prod_of_mem _ (Finset.mem_univ i)
    rcases hfac with ⟨q_f, hq_f⟩
    have h0 : μ_pos₁ i Δ_pos₁ = 0 := by
      rw [hq_f, map_mul]
      have : μ_pos₁ i (t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (p₁ i t)) = 0 := by
        simp [μ_pos₁, Algebra.TensorProduct.productMap_apply_tmul]
      rw [this, zero_mul]
    have hmod := hH₁_mod
    rw [Ideal.mem_span_singleton] at hmod
    rcases hmod with ⟨q_m, hq_m⟩
    have hsub0 : μ_pos₁ i (H₁ - 1) = 0 := by
      rw [hq_m, map_mul, map_mul, h0, zero_mul, zero_mul]
    rw [map_sub, map_one] at hsub0
    exact sub_eq_zero.mp hsub0
  have hμ_neg_H₁ : ∀ j : Fin K_neg, μ_neg₁ j H₁ = 1 := by
    intro j
    have hfac : t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (q₁ j t) ∣ Δ_neg₁ :=
      Finset.dvd_prod_of_mem _ (Finset.mem_univ j)
    rcases hfac with ⟨q_f, hq_f⟩
    have h0 : μ_neg₁ j Δ_neg₁ = 0 := by
      rw [hq_f, map_mul]
      have : μ_neg₁ j (t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (q₁ j t)) = 0 := by
        simp [μ_neg₁, Algebra.TensorProduct.productMap_apply_tmul]
      rw [this, zero_mul]
    have hmod := hH₁_mod
    rw [Ideal.mem_span_singleton] at hmod
    rcases hmod with ⟨q_m, hq_m⟩
    have hsub0 : μ_neg₁ j (H₁ - 1) = 0 := by
      rw [hq_m, map_mul, map_mul, h0, mul_zero, zero_mul]
    rw [map_sub, map_one] at hsub0
    exact sub_eq_zero.mp hsub0
  have hH₁_ne : H₁ ≠ 0 := by
    intro h0
    have h1 := hμ_pos_H₁ ⟨0, _hK_pos⟩
    rw [h0, map_zero] at h1
    exact zero_ne_one h1
  have hpow_H₁ : Submonoid.powers H₁ ≤
      nonZeroDivisors (TensorProduct k B₀ (Localization.Away a₁)) := by
    rintro _ ⟨m, rfl⟩
    exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero m hH₁_ne)
  have : IsDomain (Localization.Away H₁) := IsLocalization.isDomain_localization hpow_H₁
  have hInj_Rtilde : Function.Injective
      (algebraMap (TensorProduct k B₀ (Localization.Away a₁)) (Localization.Away H₁)) :=
    IsLocalization.injective (Localization.Away H₁) hpow_H₁
  have hex_wpos : ∀ i : Fin K_pos, ∃ w : TensorProduct k B₀ (Localization.Away a₁),
      H₁ * (t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (p₁ i t)) = u_pos₁ i * w := by
    intro i
    have hker : t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (p₁ i t) ∈
        RingHom.ker (μ_pos₁ i).toRingHom := by
      rw [RingHom.mem_ker]
      simp [μ_pos₁, Algebra.TensorProduct.productMap_apply_tmul]
    have hmem := hH₁_pos i _ hker
    rwa [Ideal.mem_span_singleton] at hmem
  choose w_pos hw_pos using hex_wpos
  let W_num₁ : TensorProduct k B₀ (Localization.Away a₁) := Finset.univ.prod w_pos
  have hUW₁ : (Finset.univ.prod u_pos₁) * W_num₁ = H₁ ^ K_pos * Δ_pos₁ := by
    dsimp only [W_num₁, Δ_pos₁]
    rw [← Finset.prod_mul_distrib]
    have hprod : (Finset.univ.prod fun i : Fin K_pos => u_pos₁ i * w_pos i) =
        Finset.univ.prod fun i : Fin K_pos =>
          H₁ * (t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (p₁ i t)) :=
      Finset.prod_congr rfl fun i _ => (hw_pos i).symm
    rw [hprod, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_fin]
  have hu_pos₁_ne : ∀ i : Fin K_pos, u_pos₁ i ≠ 0 := by
    intro i h0
    have hprod_ne :
        H₁ * (t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (p₁ i t)) ≠ 0 :=
      mul_ne_zero hH₁_ne (hLinNe₁ (p₁ i t))
    rw [hw_pos i, h0, zero_mul] at hprod_ne
    exact hprod_ne rfl
  have hu_neg₁_ne : ∀ j : Fin K_neg, u_neg₁ j ≠ 0 := by
    intro j h0
    have hker : t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (q₁ j t) ∈
        RingHom.ker (μ_neg₁ j).toRingHom := by
      rw [RingHom.mem_ker]
      simp [μ_neg₁, Algebra.TensorProduct.productMap_apply_tmul]
    have hmem := hH₁_neg j _ hker
    rw [Ideal.mem_span_singleton] at hmem
    rcases hmem with ⟨w, hw⟩
    have hw' :
        H₁ * (t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (q₁ j t)) =
          u_neg₁ j * w := hw
    have hprod_ne :
        H₁ * (t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] (q₁ j t)) ≠ 0 :=
      mul_ne_zero hH₁_ne (hLinNe₁ (q₁ j t))
    rw [hw', h0, zero_mul] at hprod_ne
    exact hprod_ne rfl
  let g₁ : TensorProduct k B₀ (Localization.Away a₁) := W_num₁ * Finset.univ.prod u_neg₁
  let R_dim : ℕ := (n - 1) * K_pos + K_neg
  have hex_cramer :
      ∃ (s_det : Localization.Away a₁)
        (ω₁ : Fin R_dim → Localization.Away H₁)
        (Φ₁ : Localization.Away H₁ →+ (Fin R_dim → Localization.Away a₁)),
        ev₁ s_det ≠ 0 ∧
        (∀ (a : Localization.Away a₁) (z : Localization.Away H₁),
          Φ₁ (algebraMap (TensorProduct k B₀ (Localization.Away a₁)) (Localization.Away H₁)
            ((1 : B₀) ⊗ₜ[k] a) * z) = a • Φ₁ z) ∧
        (∀ w : Localization.Away H₁,
          Φ₁ (algebraMap (TensorProduct k B₀ (Localization.Away a₁)) (Localization.Away H₁) g₁ * w) = 0) ∧
        (∀ r₁ r₂ : Fin R_dim, Φ₁ (ω₁ r₁) r₂ = if r₁ = r₂ then s_det else 0) ∧
        (∀ z : Localization.Away H₁,
          algebraMap (TensorProduct k B₀ (Localization.Away a₁)) (Localization.Away H₁)
              ((1 : B₀) ⊗ₜ[k] s_det) * z -
            (Finset.univ.sum fun r : Fin R_dim =>
              algebraMap (TensorProduct k B₀ (Localization.Away a₁)) (Localization.Away H₁)
                ((1 : B₀) ⊗ₜ[k] Φ₁ z r) * ω₁ r) ∈
            Ideal.span ({algebraMap (TensorProduct k B₀ (Localization.Away a₁))
              (Localization.Away H₁) g₁} : Set (Localization.Away H₁))) := by
    let φ_A₁_R₁ : Localization.Away a₁ →+* TensorProduct k B₀ (Localization.Away a₁) :=
      (Algebra.TensorProduct.includeRight :
        Localization.Away a₁ →ₐ[k] TensorProduct k B₀ (Localization.Away a₁)).toRingHom
    letI : Algebra (Localization.Away a₁) (Localization.Away H₁) :=
      ((algebraMap (TensorProduct k B₀ (Localization.Away a₁)) (Localization.Away H₁)).comp
        φ_A₁_R₁).toAlgebra
    let invH₁ : Localization.Away H₁ := IsLocalization.Away.invSelf (S := Localization.Away H₁) H₁
    have hmul_invH₁ :
        algebraMap (TensorProduct k B₀ (Localization.Away a₁)) (Localization.Away H₁) H₁ *
          invH₁ = 1 :=
      IsLocalization.Away.mul_invSelf H₁
    let u_pos_t : Fin K_pos → Localization.Away H₁ := fun i =>
      algebraMap (TensorProduct k B₀ (Localization.Away a₁)) (Localization.Away H₁) (u_pos₁ i)
    let u_neg_t : Fin K_neg → Localization.Away H₁ := fun j =>
      algebraMap (TensorProduct k B₀ (Localization.Away a₁)) (Localization.Away H₁) (u_neg₁ j)
    let Δ_pos_t : Localization.Away H₁ :=
      algebraMap (TensorProduct k B₀ (Localization.Away a₁)) (Localization.Away H₁) Δ_pos₁
    let W_plus : Localization.Away H₁ :=
      algebraMap (TensorProduct k B₀ (Localization.Away a₁)) (Localization.Away H₁) W_num₁ *
        invH₁ ^ K_pos
    let g_gen : Localization.Away H₁ :=
      algebraMap (TensorProduct k B₀ (Localization.Away a₁)) (Localization.Away H₁) g₁
    let bas_Δ : Fin (n * K_pos) → Localization.Away H₁ := fun idx =>
      algebraMap (TensorProduct k B₀ (Localization.Away a₁)) (Localization.Away H₁)
        ((t ^ ((finProdFinEquiv.symm idx).2 : ℕ) * b (finProdFinEquiv.symm idx).1) ⊗ₜ[k]
          (1 : Localization.Away a₁))
    have hLiftRetr :
        ∀ (μ : TensorProduct k B₀ (Localization.Away a₁) →ₐ[k] Localization.Away a₁)
          (u : TensorProduct k B₀ (Localization.Away a₁)),
          (∀ a : Localization.Away a₁, μ ((1 : B₀) ⊗ₜ[k] a) = a) →
          μ u = 0 →
          μ H₁ = 1 →
          (∀ r : TensorProduct k B₀ (Localization.Away a₁),
            r ∈ RingHom.ker μ.toRingHom → H₁ * r ∈ Ideal.span ({u} : Set _)) →
          ∃ μ_t : Localization.Away H₁ →ₐ[Localization.Away a₁] Localization.Away a₁,
            RingHom.ker μ_t.toRingHom =
              Ideal.span ({algebraMap _ (Localization.Away H₁) u} : Set (Localization.Away H₁)) := by
      intro μ u hμ_id hμ_u hμ_H hH_ker
      have hUnit : IsUnit (μ.toRingHom H₁) := by
        rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hμ_H]
        exact isUnit_one
      let μ_hom : Localization.Away H₁ →+* Localization.Away a₁ :=
        IsLocalization.Away.lift (S := Localization.Away H₁) H₁ hUnit
      have hμ_eq : ∀ r : TensorProduct k B₀ (Localization.Away a₁),
          μ_hom (algebraMap _ (Localization.Away H₁) r) = μ r :=
        fun r => IsLocalization.Away.lift_eq (S := Localization.Away H₁) H₁ hUnit r
      let μ_t : Localization.Away H₁ →ₐ[Localization.Away a₁] Localization.Away a₁ :=
        { μ_hom with
          commutes' := fun a => by
            change μ_hom (algebraMap _ (Localization.Away H₁) ((1 : B₀) ⊗ₜ[k] a)) = a
            exact (hμ_eq ((1 : B₀) ⊗ₜ[k] a)).trans (hμ_id a) }
      refine ⟨μ_t, le_antisymm ?_ ?_⟩
      · intro z hz
        rw [RingHom.mem_ker] at hz
        obtain ⟨⟨r, ⟨_, m, rfl⟩⟩, hzr⟩ := IsLocalization.surj (Submonoid.powers H₁) z
        dsimp only at hzr
        have hμr : μ r = 0 := by
          have h1 := congrArg μ_hom hzr
          rw [map_mul] at h1
          have hz0 : μ_hom z = 0 := hz
          rw [hz0, zero_mul, hμ_eq r] at h1
          exact h1.symm
        have hr_ker : r ∈ RingHom.ker μ.toRingHom := hμr
        have hmem := hH_ker r hr_ker
        rw [Ideal.mem_span_singleton] at hmem ⊢
        rcases hmem with ⟨q, hq⟩
        refine ⟨algebraMap _ (Localization.Away H₁) q * invH₁ ^ (m + 1), ?_⟩
        have hpow : algebraMap _ (Localization.Away H₁) (H₁ ^ m) * invH₁ ^ m = 1 := by
          rw [map_pow, ← mul_pow, hmul_invH₁, one_pow]
        calc
          z = z * 1 := (mul_one z).symm
          _ = z * (algebraMap _ (Localization.Away H₁) (H₁ ^ m) * invH₁ ^ m) := by rw [hpow]
          _ = (z * algebraMap _ (Localization.Away H₁) (H₁ ^ m)) * invH₁ ^ m := by ring
          _ = algebraMap _ (Localization.Away H₁) r * invH₁ ^ m := by rw [hzr]
          _ = algebraMap _ (Localization.Away H₁) r *
                (algebraMap _ (Localization.Away H₁) H₁ * invH₁) * invH₁ ^ m := by
                rw [hmul_invH₁, mul_one]
          _ = algebraMap _ (Localization.Away H₁) (H₁ * r) * invH₁ ^ (m + 1) := by
                rw [map_mul, pow_succ]; ring
          _ = algebraMap _ (Localization.Away H₁) u *
                (algebraMap _ (Localization.Away H₁) q * invH₁ ^ (m + 1)) := by
                rw [hq, map_mul, mul_assoc]
      · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        change μ_hom (algebraMap _ (Localization.Away H₁) u) = 0
        exact (hμ_eq u).trans hμ_u
    have hPos_t : ∀ i : Fin K_pos, u_pos_t i ≠ 0 ∧
        ∃ μ_i : Localization.Away H₁ →ₐ[Localization.Away a₁] Localization.Away a₁,
          RingHom.ker μ_i.toRingHom = Ideal.span ({u_pos_t i} : Set (Localization.Away H₁)) := by
      intro i
      refine ⟨fun h0 => hu_pos₁_ne i (hInj_Rtilde (h0.trans (map_zero _).symm)), ?_⟩
      exact hLiftRetr (μ_pos₁ i) (u_pos₁ i)
        (fun a => by simp [μ_pos₁, Algebra.TensorProduct.productMap_apply_tmul])
        (by simp [μ_pos₁, u_pos₁, Algebra.TensorProduct.productMap_apply_tmul])
        (hμ_pos_H₁ i)
        (hH₁_pos i)
    have hNeg_t : ∀ j : Fin K_neg, u_neg_t j ≠ 0 ∧
        ∃ ν_j : Localization.Away H₁ →ₐ[Localization.Away a₁] Localization.Away a₁,
          RingHom.ker ν_j.toRingHom = Ideal.span ({u_neg_t j} : Set (Localization.Away H₁)) := by
      intro j
      refine ⟨fun h0 => hu_neg₁_ne j (hInj_Rtilde (h0.trans (map_zero _).symm)), ?_⟩
      exact hLiftRetr (μ_neg₁ j) (u_neg₁ j)
        (fun a => by simp [μ_neg₁, Algebra.TensorProduct.productMap_apply_tmul])
        (by simp [μ_neg₁, u_neg₁, Algebra.TensorProduct.productMap_apply_tmul])
        (hμ_neg_H₁ j)
        (hH₁_neg j)
    have hUW_t : (Finset.univ.prod u_pos_t) * W_plus = Δ_pos_t := by
      dsimp only [u_pos_t, W_plus, Δ_pos_t]
      rw [← map_prod, ← mul_assoc, ← map_mul, hUW₁, map_mul, map_pow]
      have hpow :
          algebraMap _ (Localization.Away H₁) H₁ ^ K_pos * invH₁ ^ K_pos = 1 := by
        rw [← mul_pow, hmul_invH₁, one_pow]
      calc
        (algebraMap _ (Localization.Away H₁) H₁ ^ K_pos *
            algebraMap _ (Localization.Away H₁) Δ_pos₁) * invH₁ ^ K_pos
            = algebraMap _ (Localization.Away H₁) Δ_pos₁ *
                (algebraMap _ (Localization.Away H₁) H₁ ^ K_pos * invH₁ ^ K_pos) := by ring
        _ = algebraMap _ (Localization.Away H₁) Δ_pos₁ := by rw [hpow, mul_one]
    have hg_span_t : Ideal.span ({g_gen} : Set (Localization.Away H₁)) =
        Ideal.span ({W_plus * Finset.univ.prod u_neg_t} : Set (Localization.Away H₁)) := by
      have hrel : W_plus * Finset.univ.prod u_neg_t = g_gen * invH₁ ^ K_pos := by
        dsimp only [W_plus, u_neg_t, g_gen, g₁]
        rw [← map_prod, map_mul]
        ring
      have hpow :
          algebraMap _ (Localization.Away H₁) H₁ ^ K_pos * invH₁ ^ K_pos = 1 := by
        rw [← mul_pow, hmul_invH₁, one_pow]
      apply le_antisymm
      · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
        refine ⟨algebraMap _ (Localization.Away H₁) H₁ ^ K_pos, ?_⟩
        rw [hrel, mul_assoc, mul_comm (invH₁ ^ K_pos), hpow, mul_one]
      · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
        exact ⟨invH₁ ^ K_pos, hrel⟩
    have hBij_Δt : Function.Bijective (fun c : Fin (n * K_pos) → Localization.Away a₁ =>
        Ideal.Quotient.mk (Ideal.span ({Δ_pos_t} : Set (Localization.Away H₁)))
          (Finset.univ.sum fun idx : Fin (n * K_pos) =>
            algebraMap (Localization.Away a₁) (Localization.Away H₁) (c idx) * bas_Δ idx)) := by
      let I₁ : Ideal (TensorProduct k B₀ (Localization.Away a₁)) :=
        Ideal.span ({Δ_pos₁} : Set _)
      let I_t : Ideal (Localization.Away H₁) := Ideal.span ({Δ_pos_t} : Set _)
      have hH₁_sub_mem : H₁ - 1 ∈ I₁ := by
        have hmod := hH₁_mod
        rw [Ideal.mem_span_singleton] at hmod ⊢
        rcases hmod with ⟨q_m, hq_m⟩
        exact ⟨Δ_neg₁ * q_m, by rw [hq_m]; ring⟩
      have hH₁_pow_sub : ∀ m : ℕ, H₁ ^ m - 1 ∈ I₁ := by
        intro m
        induction m with
        | zero =>
          rw [pow_zero, sub_self]
          exact I₁.zero_mem
        | succ m ih =>
          have hsplit : H₁ ^ (m + 1) - 1 = H₁ * (H₁ ^ m - 1) + (H₁ - 1) := by ring
          rw [hsplit]
          exact I₁.add_mem (I₁.mul_mem_left H₁ ih) hH₁_sub_mem
      have hmem_iff : ∀ r : TensorProduct k B₀ (Localization.Away a₁),
          algebraMap _ (Localization.Away H₁) r ∈ I_t ↔ r ∈ I₁ := by
        intro r
        constructor
        · intro hr_t
          rw [Ideal.mem_span_singleton] at hr_t
          rcases hr_t with ⟨z, hz⟩
          obtain ⟨⟨q, ⟨_, m, rfl⟩⟩, hzq⟩ := IsLocalization.surj (Submonoid.powers H₁) z
          dsimp only at hzq
          have heq_t :
              algebraMap _ (Localization.Away H₁) (r * H₁ ^ m) =
                algebraMap _ (Localization.Away H₁) (Δ_pos₁ * q) := by
            rw [map_mul, hz, mul_assoc, hzq, ← map_mul]
          have heq_R₁ : r * H₁ ^ m = Δ_pos₁ * q := hInj_Rtilde heq_t
          have hrH_mem : r * H₁ ^ m ∈ I₁ := by
            rw [Ideal.mem_span_singleton]
            exact ⟨q, heq_R₁⟩
          have hr_diff : r = r * H₁ ^ m - r * (H₁ ^ m - 1) := by ring
          rw [hr_diff]
          exact I₁.sub_mem hrH_mem (I₁.mul_mem_left r (hH₁_pow_sub m))
        · intro hr₁
          rw [Ideal.mem_span_singleton] at hr₁ ⊢
          rcases hr₁ with ⟨q, rfl⟩
          exact ⟨algebraMap _ (Localization.Away H₁) q, map_mul _ _ _⟩
      have hSt_eq : ∀ c : Fin (n * K_pos) → Localization.Away a₁,
          (Finset.univ.sum fun idx : Fin (n * K_pos) =>
            algebraMap (Localization.Away a₁) (Localization.Away H₁) (c idx) * bas_Δ idx) =
          algebraMap _ (Localization.Away H₁)
            (Finset.univ.sum fun idx : Fin (n * K_pos) =>
              (t ^ ((finProdFinEquiv.symm idx).2 : ℕ) * b (finProdFinEquiv.symm idx).1) ⊗ₜ[k]
                c idx) := by
        intro c
        rw [map_sum]
        refine Finset.sum_congr rfl fun idx _ => ?_
        change algebraMap _ (Localization.Away H₁) ((1 : B₀) ⊗ₜ[k] c idx) *
          algebraMap _ (Localization.Away H₁)
            ((t ^ ((finProdFinEquiv.symm idx).2 : ℕ) * b (finProdFinEquiv.symm idx).1) ⊗ₜ[k]
              (1 : Localization.Away a₁)) = _
        rw [← map_mul]
        congr 1
        simp only [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
      have hf₁ := hMonicBij (Localization.Away a₁) K_pos (fun i => p₁ i t)
      constructor
      · intro c₁ c₂ hc_eq
        dsimp only at hc_eq
        rw [hSt_eq c₁, hSt_eq c₂] at hc_eq
        have hsub_t :
            algebraMap _ (Localization.Away H₁)
              ((Finset.univ.sum fun idx : Fin (n * K_pos) =>
                  (t ^ ((finProdFinEquiv.symm idx).2 : ℕ) * b (finProdFinEquiv.symm idx).1) ⊗ₜ[k]
                    c₁ idx) -
                (Finset.univ.sum fun idx : Fin (n * K_pos) =>
                  (t ^ ((finProdFinEquiv.symm idx).2 : ℕ) * b (finProdFinEquiv.symm idx).1) ⊗ₜ[k]
                    c₂ idx)) ∈ I_t := by
          rw [map_sub]
          exact Ideal.Quotient.eq.mp hc_eq
        have hsub₁ := (hmem_iff _).mp hsub_t
        exact hf₁.1 (Ideal.Quotient.eq.mpr hsub₁)
      · intro y
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
        obtain ⟨⟨r, ⟨_, m, rfl⟩⟩, hzr⟩ := IsLocalization.surj (Submonoid.powers H₁) z
        dsimp only at hzr
        have hm_mem := hH₁_pow_sub m
        rw [Ideal.mem_span_singleton] at hm_mem
        rcases hm_mem with ⟨w, hw⟩
        have hz_mod : Ideal.Quotient.mk I_t (algebraMap _ (Localization.Away H₁) r) =
            Ideal.Quotient.mk I_t z := by
          apply Ideal.Quotient.eq.mpr
          rw [Ideal.mem_span_singleton]
          refine ⟨z * algebraMap _ (Localization.Away H₁) w, ?_⟩
          have hw_map :=
            congrArg (algebraMap (TensorProduct k B₀ (Localization.Away a₁)) (Localization.Away H₁)) hw
          rw [map_sub, map_one, map_mul] at hw_map
          calc
            algebraMap _ (Localization.Away H₁) r - z
                = z * algebraMap _ (Localization.Away H₁) (H₁ ^ m) - z := by rw [← hzr]
            _ = z * (algebraMap _ (Localization.Away H₁) (H₁ ^ m) - 1) := by ring
            _ = z * (Δ_pos_t * algebraMap _ (Localization.Away H₁) w) := by
                  dsimp only [Δ_pos_t]; rw [hw_map]
            _ = Δ_pos_t * (z * algebraMap _ (Localization.Away H₁) w) := by ring
        obtain ⟨c, hc⟩ := hf₁.2 (Ideal.Quotient.mk I₁ r)
        refine ⟨c, ?_⟩
        dsimp only
        rw [hSt_eq c]
        have hc_mem := Ideal.Quotient.eq.mp hc
        have hc_mem_t :
            algebraMap _ (Localization.Away H₁)
              (Finset.univ.sum fun idx : Fin (n * K_pos) =>
                (t ^ ((finProdFinEquiv.symm idx).2 : ℕ) * b (finProdFinEquiv.symm idx).1) ⊗ₜ[k]
                  c idx) -
              algebraMap _ (Localization.Away H₁) r ∈ I_t := by
          rw [← map_sub]
          exact (hmem_iff _).mpr hc_mem
        exact (Ideal.Quotient.eq.mpr hc_mem_t).trans hz_mod
    obtain ⟨s_det, ω₁, Φ₁, hs_det, hΦ₁_kill, hΦ₁_dual, hΦ₁_span⟩ :=
      weil_domain_split_quotient_cramer_free_basis
        k (Localization.Away a₁) ev₁ (Localization.Away H₁) n K_pos K_neg _hn
        u_pos_t u_neg_t Δ_pos_t W_plus g_gen bas_Δ
        hPos_t hNeg_t hUW_t hg_span_t hBij_Δt
    exact ⟨s_det, ω₁, Φ₁.toAddMonoidHom, hs_det,
      fun a z => Φ₁.map_smul a z, hΦ₁_kill, hΦ₁_dual, hΦ₁_span⟩
  obtain ⟨s_det, ω₁, Φ₁, hs_det, hΦ₁_smul, hΦ₁_kill, hΦ₁_dual, hΦ₁_span⟩ := hex_cramer
  obtain ⟨⟨a₂, ⟨_, k_s, rfl⟩⟩, hsec_s⟩ := IsLocalization.surj (Submonoid.powers a₁) s_det
  dsimp only at hsec_s
  have ha₂_ev : ev₀ a₂ ≠ 0 := by
    have h1 := congrArg ev₁ hsec_s
    have hev₁_map : ∀ x : A₀, ev₁ (algebraMap A₀ (Localization.Away a₁) x) = ev₀ x := hev₁_eq
    rw [map_mul, map_pow, map_pow, hev₁_map, hev₁_map, ha₁, one_pow, mul_one] at h1
    exact h1 ▸ hs_det
  let a_loc : A₀ := a₁ * a₂
  have ha_loc_ev : ev₀ a_loc ≠ 0 := by
    dsimp only [a_loc]
    rw [map_mul, ha₁, one_mul]
    exact ha₂_ev
  refine ⟨a_loc, ha_loc_ev, ?_⟩
  let ι_A : A₀ →ₐ[k] Localization.Away a_loc :=
    IsScalarTower.toAlgHom k A₀ (Localization.Away a_loc)
  let p_A : Fin K_pos → (B₀ →ₐ[k] Localization.Away a_loc) := fun i => ι_A.comp (p_pos i)
  let q_A : Fin K_neg → (B₀ →ₐ[k] Localization.Away a_loc) := fun j => ι_A.comp (q_neg j)
  let Δ_pos : TensorProduct k B₀ (Localization.Away a_loc) :=
    Finset.univ.prod fun i : Fin K_pos =>
      t ⊗ₜ[k] (1 : Localization.Away a_loc) - (1 : B₀) ⊗ₜ[k] (p_A i t)
  let Δ_neg : TensorProduct k B₀ (Localization.Away a_loc) :=
    Finset.univ.prod fun j : Fin K_neg =>
      t ⊗ₜ[k] (1 : Localization.Away a_loc) - (1 : B₀) ⊗ₜ[k] (q_A j t)
  let u_pos : Fin K_pos → TensorProduct k B₀ (Localization.Away a_loc) := fun i =>
    z_pos i ⊗ₜ[k] (1 : Localization.Away a_loc) - (1 : B₀) ⊗ₜ[k] (p_A i (z_pos i))
  let u_neg : Fin K_neg → TensorProduct k B₀ (Localization.Away a_loc) := fun j =>
    z_neg j ⊗ₜ[k] (1 : Localization.Away a_loc) - (1 : B₀) ⊗ₜ[k] (q_A j (z_neg j))
  let inv_aloc : Localization.Away a_loc :=
    IsLocalization.Away.invSelf (S := Localization.Away a_loc) a_loc
  have hmul_aloc : algebraMap A₀ (Localization.Away a_loc) a_loc * inv_aloc = 1 :=
    IsLocalization.Away.mul_invSelf a_loc
  have hUnit_a₁ : IsUnit (algebraMap A₀ (Localization.Away a_loc) a₁) :=
    ⟨⟨algebraMap A₀ (Localization.Away a_loc) a₁,
      algebraMap A₀ (Localization.Away a_loc) a₂ * inv_aloc,
      by rw [← mul_assoc, ← map_mul]; exact hmul_aloc,
      by calc
        (algebraMap A₀ (Localization.Away a_loc) a₂ * inv_aloc) *
            algebraMap A₀ (Localization.Away a_loc) a₁
            = (algebraMap A₀ (Localization.Away a_loc) a₁ *
                algebraMap A₀ (Localization.Away a_loc) a₂) * inv_aloc := by ring
        _ = algebraMap A₀ (Localization.Away a_loc) a_loc * inv_aloc := by rw [← map_mul]
        _ = 1 := hmul_aloc⟩, rfl⟩
  let lam_hom : Localization.Away a₁ →+* Localization.Away a_loc :=
    IsLocalization.Away.lift (S := Localization.Away a₁) a₁ hUnit_a₁
  have hlam_eq : ∀ x : A₀,
      lam_hom (algebraMap A₀ (Localization.Away a₁) x) =
        algebraMap A₀ (Localization.Away a_loc) x :=
    fun x => IsLocalization.Away.lift_eq (S := Localization.Away a₁) a₁ hUnit_a₁ x
  let lam_alg : Localization.Away a₁ →ₐ[k] Localization.Away a_loc :=
    { lam_hom with
      commutes' := fun c => by
        change lam_hom (algebraMap k (Localization.Away a₁) c) =
          algebraMap k (Localization.Away a_loc) c
        rw [IsScalarTower.algebraMap_apply k A₀ (Localization.Away a₁) c,
          IsScalarTower.algebraMap_apply k A₀ (Localization.Away a_loc) c]
        exact hlam_eq (algebraMap k A₀ c) }
  have hlam_comp : ∀ x : A₀, lam_alg (ι₁ x) = ι_A x := by
    intro x
    rw [IsScalarTower.toAlgHom_apply, IsScalarTower.toAlgHom_apply]
    exact hlam_eq x
  let u_det_inv : Localization.Away a_loc :=
    (algebraMap A₀ (Localization.Away a_loc) a₁) ^ k_s *
      (algebraMap A₀ (Localization.Away a_loc) a₁ * inv_aloc)
  have h_det_inv : lam_alg s_det * u_det_inv = 1 := by
    have h1 := congrArg lam_hom hsec_s
    rw [map_mul, map_pow, map_pow, hlam_eq, hlam_eq] at h1
    change lam_hom s_det *
      ((algebraMap A₀ (Localization.Away a_loc) a₁) ^ k_s *
        (algebraMap A₀ (Localization.Away a_loc) a₁ * inv_aloc)) = 1
    calc
      lam_hom s_det *
          ((algebraMap A₀ (Localization.Away a_loc) a₁) ^ k_s *
            (algebraMap A₀ (Localization.Away a_loc) a₁ * inv_aloc))
          = (lam_hom s_det * (algebraMap A₀ (Localization.Away a_loc) a₁) ^ k_s) *
              (algebraMap A₀ (Localization.Away a_loc) a₁ * inv_aloc) := by ring
      _ = algebraMap A₀ (Localization.Away a_loc) a₂ *
            (algebraMap A₀ (Localization.Away a_loc) a₁ * inv_aloc) := by rw [h1]
      _ = (algebraMap A₀ (Localization.Away a_loc) a₁ *
            algebraMap A₀ (Localization.Away a_loc) a₂) * inv_aloc := by ring
      _ = algebraMap A₀ (Localization.Away a_loc) a_loc * inv_aloc := by rw [← map_mul]
      _ = 1 := hmul_aloc
  let lam_R : TensorProduct k B₀ (Localization.Away a₁) →ₐ[k]
      TensorProduct k B₀ (Localization.Away a_loc) :=
    Algebra.TensorProduct.map (AlgHom.id k B₀) lam_alg
  have hp_lam : ∀ (i : Fin K_pos) (x : B₀), lam_alg (p₁ i x) = p_A i x := fun i x =>
    hlam_comp (p_pos i x)
  have hq_lam : ∀ (j : Fin K_neg) (x : B₀), lam_alg (q₁ j x) = q_A j x := fun j x =>
    hlam_comp (q_neg j x)
  have hlam_upos : ∀ i : Fin K_pos, lam_R (u_pos₁ i) = u_pos i := by
    intro i
    simp only [u_pos₁, u_pos, lam_R, map_sub, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
      map_one, hp_lam]
  have hlam_uneg : ∀ j : Fin K_neg, lam_R (u_neg₁ j) = u_neg j := by
    intro j
    simp only [u_neg₁, u_neg, lam_R, map_sub, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
      map_one, hq_lam]
  have hlam_Δpos : lam_R Δ_pos₁ = Δ_pos := by
    simp only [Δ_pos₁, Δ_pos, map_prod]
    refine Finset.prod_congr rfl fun i _ => ?_
    simp only [lam_R, map_sub, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one, hp_lam]
  have hlam_Δneg : lam_R Δ_neg₁ = Δ_neg := by
    simp only [Δ_neg₁, Δ_neg, map_prod]
    refine Finset.prod_congr rfl fun j _ => ?_
    simp only [lam_R, map_sub, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one, hq_lam]
  let H : TensorProduct k B₀ (Localization.Away a_loc) := lam_R H₁
  let W_num : TensorProduct k B₀ (Localization.Away a_loc) := lam_R W_num₁
  let Θ_A : Matrix (Fin R_dim) (Fin N_V) (Localization.Away a_loc) :=
    Matrix.of fun r ν =>
      u_det_inv * lam_alg (Φ₁ (algebraMap (TensorProduct k B₀ (Localization.Away a₁))
        (Localization.Away H₁) (v_bas ν ⊗ₜ[k] (1 : Localization.Away a₁))) r)
  have hKerPush :
      ∀ (p_s₁ : B₀ →ₐ[k] Localization.Away a₁)
        (p_sA : B₀ →ₐ[k] Localization.Away a_loc)
        (u₁ : TensorProduct k B₀ (Localization.Away a₁))
        (uA : TensorProduct k B₀ (Localization.Away a_loc)),
        (∀ x : B₀, lam_alg (p_s₁ x) = p_sA x) →
        lam_R u₁ = uA →
        (∀ r₁ : TensorProduct k B₀ (Localization.Away a₁),
          r₁ ∈ RingHom.ker
            (Algebra.TensorProduct.productMap p_s₁
              (AlgHom.id k (Localization.Away a₁))).toRingHom →
          H₁ * r₁ ∈ Ideal.span ({u₁} : Set _)) →
        ∀ r : TensorProduct k B₀ (Localization.Away a_loc),
          r ∈ RingHom.ker
            (Algebra.TensorProduct.productMap p_sA
              (AlgHom.id k (Localization.Away a_loc))).toRingHom →
          H * r ∈ Ideal.span ({uA} : Set _) := by
    intro p_s₁ p_sA u₁ uA hp_eq hu_eq hH₁_s
    let J_col : Ideal (TensorProduct k B₀ (Localization.Away a_loc)) :=
      Submodule.comap (LinearMap.mulLeft _ H) (Ideal.span ({uA} : Set _))
    suffices hle :
        RingHom.ker
          (Algebra.TensorProduct.productMap p_sA
            (AlgHom.id k (Localization.Away a_loc))).toRingHom ≤ J_col by
      intro r hr
      exact hle hr
    rw [hKerSpan (Localization.Away a_loc) p_sA, Ideal.span_le]
    intro g hg
    rw [SetLike.mem_coe, Submodule.mem_comap, LinearMap.mulLeft_apply]
    have hex_g₁ : ∃ g₁_el : TensorProduct k B₀ (Localization.Away a₁),
        g₁_el ∈ RingHom.ker
          (Algebra.TensorProduct.productMap p_s₁
            (AlgHom.id k (Localization.Away a₁))).toRingHom ∧
        lam_R g₁_el = g := by
      rcases hg with hg_t | ⟨α, rfl⟩
      · rw [Set.mem_singleton_iff] at hg_t
        subst hg_t
        refine ⟨t ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] p_s₁ t, ?_, ?_⟩
        · rw [RingHom.mem_ker]
          simp [Algebra.TensorProduct.productMap_apply_tmul]
        · simp only [lam_R, map_sub, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one,
            hp_eq]
      · refine ⟨b α ⊗ₜ[k] (1 : Localization.Away a₁) - (1 : B₀) ⊗ₜ[k] p_s₁ (b α), ?_, ?_⟩
        · rw [RingHom.mem_ker]
          simp [Algebra.TensorProduct.productMap_apply_tmul]
        · simp only [lam_R, map_sub, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one,
            hp_eq]
    rcases hex_g₁ with ⟨g₁_el, hg₁_ker, rfl⟩
    have hmem₁ := hH₁_s g₁_el hg₁_ker
    rw [Ideal.mem_span_singleton] at hmem₁ ⊢
    rcases hmem₁ with ⟨q, hq⟩
    refine ⟨lam_R q, ?_⟩
    dsimp only [H]
    rw [← map_mul, hq, map_mul, hu_eq]
  refine ⟨H, W_num, K_pos, Θ_A, ?_, ?_, ?_, ?_, ?_⟩
  · have hmod := hH₁_mod
    rw [Ideal.mem_span_singleton] at hmod ⊢
    rcases hmod with ⟨q, hq⟩
    refine ⟨lam_R q, ?_⟩
    have h1 := congrArg lam_R hq
    rw [map_sub, map_one, map_mul, map_mul, hlam_Δpos, hlam_Δneg] at h1
    exact h1
  · intro i
    exact hKerPush (p₁ i) (p_A i) (u_pos₁ i) (u_pos i) (hp_lam i) (hlam_upos i) (hH₁_pos i)
  · intro j
    exact hKerPush (q₁ j) (q_A j) (u_neg₁ j) (u_neg j) (hq_lam j) (hlam_uneg j) (hH₁_neg j)
  · have h1 := congrArg lam_R hUW₁
    rw [map_mul, map_prod, map_mul, map_pow, hlam_Δpos] at h1
    have hprod_eq : (Finset.univ.prod fun x : Fin K_pos => lam_R (u_pos₁ x)) =
        Finset.univ.prod u_pos :=
      Finset.prod_congr rfl fun i _ => hlam_upos i
    rw [hprod_eq] at h1
    exact h1
  · intro A' _ _ ψ c
    let ψ_R : TensorProduct k B₀ (Localization.Away a_loc) →ₐ[k] TensorProduct k B₀ A' :=
      Algebra.TensorProduct.map (AlgHom.id k B₀) ψ
    let σ : Localization.Away a₁ →ₐ[k] A' := ψ.comp lam_alg
    let u_inv : A' := ψ u_det_inv
    have hσ_inv : σ s_det * u_inv = 1 := by
      dsimp only [σ, u_inv]
      rw [AlgHom.comp_apply, ← map_mul, h_det_inv, map_one]
    let σ_R : TensorProduct k B₀ (Localization.Away a₁) →ₐ[k] TensorProduct k B₀ A' :=
      Algebra.TensorProduct.map (AlgHom.id k B₀) σ
    have hmap_comp : ψ_R.comp lam_R = σ_R := by
      dsimp only [ψ_R, lam_R, σ_R, σ]
      rw [← Algebra.TensorProduct.map_comp, AlgHom.id_comp]
    have heq_H : ψ_R H = σ_R H₁ :=
      congrArg (fun f : TensorProduct k B₀ (Localization.Away a₁) →ₐ[k]
        TensorProduct k B₀ A' => f H₁) hmap_comp
    have heq_g : ψ_R (W_num * Finset.univ.prod u_neg) = σ_R g₁ := by
      have hW_eq : W_num * Finset.univ.prod u_neg = lam_R g₁ := by
        dsimp only [W_num, g₁]
        rw [map_mul, _root_.map_prod lam_R u_neg₁ Finset.univ]
        congr 1
        exact Finset.prod_congr rfl fun j _ => (hlam_uneg j).symm
      rw [hW_eq]
      exact congrArg (fun f : TensorProduct k B₀ (Localization.Away a₁) →ₐ[k]
        TensorProduct k B₀ A' => f g₁) hmap_comp
    have heq_Θ : Θ_A.map ψ =
        (Matrix.of fun r ν =>
          u_inv * σ (Φ₁ (algebraMap (TensorProduct k B₀ (Localization.Away a₁))
            (Localization.Away H₁) (v_bas ν ⊗ₜ[k] (1 : Localization.Away a₁))) r)) := by
      ext r ν
      simp only [Θ_A, Matrix.map_apply, Matrix.of_apply, map_mul, u_inv, σ, AlgHom.comp_apply]
    let P_span : TensorProduct k B₀ A' → TensorProduct k B₀ A' → Prop :=
      fun h_el g_el =>
        algebraMap (TensorProduct k B₀ A') (Localization.Away h_el)
          (Finset.univ.sum fun ν : Fin N_V => v_bas ν ⊗ₜ[k] c ν) ∈
          Ideal.span ({algebraMap (TensorProduct k B₀ A') (Localization.Away h_el) g_el} :
            Set (Localization.Away h_el))
    change (Θ_A.map ψ).mulVec c = 0 ↔ P_span (ψ_R H) (ψ_R (W_num * Finset.univ.prod u_neg))
    rw [heq_Θ, heq_H, heq_g]
    exact weil_away_cramer_baseChange_mulVec_iff
      k B₀ (Localization.Away a₁) H₁ g₁ R_dim s_det ω₁ Φ₁
      hΦ₁_smul hΦ₁_kill hΦ₁_dual hΦ₁_span
      A' σ u_inv hσ_inv N_V v_bas c

theorem weil_determinantal_minor_rank_and_dualNumber_isolation (k : Type u) [Field k] :
    (∀ (R N_V : ℕ) (_hNV : 1 ≤ N_V) (M : Matrix (Fin R) (Fin N_V) k),
      ((∃ v : Fin N_V → k, v ≠ 0 ∧ M.mulVec v = 0) ↔
        ∀ ρ : Fin N_V → Fin R, (M.submatrix ρ id).det = 0) ∧
      ((∀ v₁ v₂ : Fin N_V → k,
          M.mulVec v₁ = 0 → M.mulVec v₂ = 0 → v₂ ≠ 0 → ∃ c : k, v₁ = c • v₂) ↔
        ∃ (ρ : Fin (N_V - 1) → Fin R) (σ : Fin (N_V - 1) → Fin N_V),
          (M.submatrix ρ σ).det ≠ 0)) ∧
    (∀ (R N_V : ℕ) (_hNV : 1 ≤ N_V)
       (M_D : Matrix (Fin R) (Fin N_V) (DualNumber k))
       (v₀ : Fin N_V → k),
      let M_k : Matrix (Fin R) (Fin N_V) k := M_D.map (TrivSqZeroExt.fstHom k k k)
      (∀ ρ : Fin N_V → Fin R, (M_D.submatrix ρ id).det = 0) →
      v₀ ≠ 0 →
      M_k.mulVec v₀ = 0 →
      (∀ v : Fin N_V → k, M_k.mulVec v = 0 → ∃ c : k, v = c • v₀) →
      ∃ g : Fin N_V → k,
        M_D.mulVec (fun ν =>
          TrivSqZeroExt.inl (v₀ ν) + DualNumber.eps * TrivSqZeroExt.inl (g ν)) = 0) ∧
    (∀ (A : Type u) [CommRing A] [Algebra k A] [IsNoetherianRing A]
       (I_det : Ideal A) (ev_star : A →ₐ[k] k),
      I_det ≤ RingHom.ker ev_star.toRingHom →
      (∀ ψ_ε : A →ₐ[k] DualNumber k,
        I_det ≤ RingHom.ker ψ_ε.toRingHom →
        (TrivSqZeroExt.fstHom k k k).comp ψ_ε = ev_star →
        ψ_ε = (TrivSqZeroExt.inlAlgHom k k k).comp ev_star) →
      ∃ s_iso : A,
        ev_star s_iso ≠ 0 ∧
        ∀ 𝔭 : PrimeSpectrum A,
          (I_det ≤ 𝔭.asIdeal ∧ s_iso ∉ 𝔭.asIdeal) ↔
            𝔭.asIdeal = RingHom.ker ev_star.toRingHom) :=
by
  
  have hTrivKerMinor : ∀ (R m : ℕ) (M : Matrix (Fin R) (Fin m) k),
      (∀ v : Fin m → k, M.mulVec v = 0 → v = 0) ↔
        ∃ ρ : Fin m → Fin R, (M.submatrix ρ id).det ≠ 0 := by
    intro R m
    induction m with
    | zero =>
      intro M
      constructor
      · intro _
        exact ⟨Fin.elim0, by simp⟩
      · intro _ v _
        ext i
        exact Fin.elim0 i
    | succ m ih =>
      intro M
      constructor
      · intro hker
        let e₀ : Fin (m + 1) → k := fun j => if j = 0 then 1 else 0
        have he₀_ne : e₀ ≠ 0 := by
          intro h0
          have : e₀ 0 = 0 := congrFun h0 0
          simp [e₀] at this
        have hMe₀_ne : M.mulVec e₀ ≠ 0 := fun h => he₀_ne (hker e₀ h)
        obtain ⟨r₀, hr₀_vec⟩ := Function.ne_iff.mp hMe₀_ne
        have hr₀ : M r₀ 0 ≠ 0 := by
          simpa [Matrix.mulVec, dotProduct, e₀] using hr₀_vec
        let M' : Matrix (Fin R) (Fin m) k :=
          fun r j => M r j.succ - M r 0 * (M r₀ 0)⁻¹ * M r₀ j.succ
        have hM'_ker : ∀ u : Fin m → k, M'.mulVec u = 0 → u = 0 := by
          intro u hu
          let c₀ : k := -(M r₀ 0)⁻¹ * ∑ j : Fin m, M r₀ j.succ * u j
          let v : Fin (m + 1) → k := Fin.cons c₀ u
          have hv : M.mulVec v = 0 := by
            ext r
            have hur : (M'.mulVec u) r = 0 := congrFun hu r
            simp only [Matrix.mulVec, dotProduct] at hur ⊢
            rw [Fin.sum_univ_succ]
            simp only [v, Fin.cons_zero, Fin.cons_succ]
            calc
              M r 0 * c₀ + ∑ j : Fin m, M r j.succ * u j
                = -(∑ j : Fin m, (M r 0 * (M r₀ 0)⁻¹ * M r₀ j.succ) * u j) +
                    ∑ j : Fin m, M r j.succ * u j := by
                  dsimp [c₀]
                  simp only [mul_neg, neg_mul, Finset.mul_sum, Finset.sum_neg_distrib, mul_assoc]
              _ = ∑ j : Fin m, (M r j.succ - M r 0 * (M r₀ 0)⁻¹ * M r₀ j.succ) * u j := by
                  rw [neg_add_eq_sub, ← Finset.sum_sub_distrib]
                  refine Finset.sum_congr rfl fun j _ => ?_
                  ring
              _ = 0 := hur
          have hv0 : v = 0 := hker v hv
          ext j
          have := congrFun hv0 j.succ
          simpa [v] using this
        obtain ⟨ρ', hρ'⟩ := (ih M').mp hM'_ker
        let ρ : Fin (m + 1) → Fin R := Fin.cons r₀ ρ'
        refine ⟨ρ, ?_⟩
        let eSum : Fin 1 ⊕ Fin m ≃ Fin (m + 1) :=
          { toFun := fun x => Sum.casesOn x (fun _ => 0) Fin.succ
            invFun := Fin.cases (Sum.inl 0) Sum.inr
            left_inv := by
              rintro (i | j)
              · simp [Subsingleton.elim 0 i]
              · simp
            right_inv := by
              intro ν
              refine Fin.cases ?_ ?_ ν <;> simp }
        let A₁₁ : Matrix (Fin 1) (Fin 1) k := fun _ _ => M r₀ 0
        let A₁₂ : Matrix (Fin 1) (Fin m) k := fun _ j => M r₀ j.succ
        let A₂₁ : Matrix (Fin m) (Fin 1) k := fun i _ => M (ρ' i) 0
        let A₂₂ : Matrix (Fin m) (Fin m) k := fun i j => M (ρ' i) j.succ
        let A₁₁_inv : Matrix (Fin 1) (Fin 1) k := fun _ _ => (M r₀ 0)⁻¹
        letI : Invertible A₁₁ :=
          { invOf := A₁₁_inv
            invOf_mul_self := by
              ext i j
              fin_cases i; fin_cases j
              rw [Matrix.mul_apply]
              simp [A₁₁, A₁₁_inv, inv_mul_cancel₀ hr₀]
            mul_invOf_self := by
              ext i j
              fin_cases i; fin_cases j
              rw [Matrix.mul_apply]
              simp [A₁₁, A₁₁_inv, mul_inv_cancel₀ hr₀] }
        have hBlock : (M.submatrix ρ id).submatrix eSum eSum =
            Matrix.fromBlocks A₁₁ A₁₂ A₂₁ A₂₂ := by
          ext x y
          rcases x with i | i <;> rcases y with j | j <;>
            simp [Matrix.fromBlocks, eSum, ρ, A₁₁, A₁₂, A₂₁, A₂₂]
        have hSchur : A₂₂ - A₂₁ * ⅟A₁₁ * A₁₂ = M'.submatrix ρ' id := by
          ext i j
          change A₂₂ i j - ((A₂₁ * A₁₁_inv) * A₁₂) i j = M' (ρ' i) j
          rw [Matrix.mul_apply]
          simp only [Finset.univ_unique, Fin.default_eq_zero, Finset.sum_singleton,
            Matrix.mul_apply]
          simp [A₂₂, A₂₁, A₁₁_inv, A₁₂, M']
        have hdet_eq : (M.submatrix ρ id).det = M r₀ 0 * (M'.submatrix ρ' id).det := by
          rw [← Matrix.det_submatrix_equiv_self eSum (M.submatrix ρ id), hBlock,
            Matrix.det_fromBlocks₁₁, hSchur, Matrix.det_fin_one]
        rw [hdet_eq]
        exact mul_ne_zero hr₀ hρ'
      · rintro ⟨ρ, hρ⟩ v hv
        have hsub : (M.submatrix ρ id).mulVec v = 0 := by
          ext i
          exact congrFun hv (ρ i)
        by_contra hv_ne
        exact hρ (Matrix.exists_mulVec_eq_zero_iff.mp ⟨v, hv_ne, hsub⟩)
  refine ⟨?_, ?_, ?_⟩
  
  · intro R N_V _hNV M
    constructor
    · 
      have hnot := (hTrivKerMinor R N_V M).not
      push Not at hnot
      constructor
      · rintro ⟨v, hv_ne, hv_ker⟩
        exact hnot.mp ⟨v, hv_ker, hv_ne⟩
      · intro hall
        obtain ⟨v, hv_ker, hv_ne⟩ := hnot.mpr hall
        exact ⟨v, hv_ne, hv_ker⟩
    · 
      obtain ⟨m, rfl⟩ : ∃ m : ℕ, m + 1 = N_V := ⟨N_V - 1, Nat.sub_add_cancel _hNV⟩
      change (∀ v₁ v₂ : Fin (m + 1) → k,
          M.mulVec v₁ = 0 → M.mulVec v₂ = 0 → v₂ ≠ 0 → ∃ c : k, v₁ = c • v₂) ↔
        ∃ (ρ : Fin m → Fin R) (σ : Fin m → Fin (m + 1)), (M.submatrix ρ σ).det ≠ 0
      have hRHS_iff :
          (∃ (ρ : Fin m → Fin R) (σ : Fin m → Fin (m + 1)), (M.submatrix ρ σ).det ≠ 0) ↔
            ∃ σ : Fin m → Fin (m + 1),
              ∀ u : Fin m → k, (M.submatrix id σ).mulVec u = 0 → u = 0 := by
        rw [exists_comm]
        exact exists_congr fun σ => (hTrivKerMinor R m (M.submatrix id σ)).symm
      rw [hRHS_iff]
      constructor
      · intro h_le1
        by_cases hEx : ∃ v₀ : Fin (m + 1) → k, v₀ ≠ 0 ∧ M.mulVec v₀ = 0
        · obtain ⟨v₀, hv₀_ne, hv₀_ker⟩ := hEx
          obtain ⟨j₀, hj₀⟩ := Function.ne_iff.mp hv₀_ne
          refine ⟨j₀.succAbove, ?_⟩
          intro u hu
          let w : Fin (m + 1) → k := j₀.insertNth 0 u
          have hw : M.mulVec w = 0 := by
            ext r
            have hur : ((M.submatrix id j₀.succAbove).mulVec u) r = 0 := congrFun hu r
            dsimp [Matrix.mulVec, dotProduct, w] at hur ⊢
            rw [Fin.sum_univ_succAbove _ j₀]
            simp [hur]
          obtain ⟨c, hc⟩ := h_le1 w v₀ hw hv₀_ker hv₀_ne
          have hcj₀ : (0 : k) = c * v₀ j₀ := by
            have := congrFun hc j₀
            simpa [w] using this
          have hc0 : c = 0 := by
            rcases mul_eq_zero.mp hcj₀.symm with rfl | h0
            · rfl
            · exact False.elim (hj₀ h0)
          have hw0 : w = 0 := by simpa [hc0] using hc
          ext i
          have := congrFun hw0 (j₀.succAbove i)
          simpa [w] using this
        · push Not at hEx
          let p₀ : Fin (m + 1) := 0
          refine ⟨p₀.succAbove, ?_⟩
          intro u hu
          let w : Fin (m + 1) → k := p₀.insertNth 0 u
          have hw : M.mulVec w = 0 := by
            ext r
            have hur : ((M.submatrix id p₀.succAbove).mulVec u) r = 0 := congrFun hu r
            dsimp [Matrix.mulVec, dotProduct, w] at hur ⊢
            rw [Fin.sum_univ_succAbove _ p₀]
            simp [hur]
          have hw0 : w = 0 := by
            by_contra hw_ne
            exact hEx w hw_ne hw
          ext i
          have := congrFun hw0 (p₀.succAbove i)
          simpa [w] using this
      · rintro ⟨σ, hσ⟩
        have hσ_inj : Function.Injective σ := by
