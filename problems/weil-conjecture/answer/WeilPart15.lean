            _ = ν + ↑u_unit := by rw [hu_unit]
            _ = 1 * ν + ↑u_unit := by rw [one_mul]
            _ = (↑u_unit * ↑u_unit⁻¹) * ν + ↑u_unit := by rw [h1]
            _ = ↑u_unit * (1 - (-(↑u_unit⁻¹ * ν))) := by ring
        have h_pow_unit : IsUnit (x ^ (q ^ n)) := h_eq_pow ▸ u_unit.isUnit.mul h_one_add
        exact (isUnit_pow_iff (pow_ne_zero n hq_ne)).mp h_pow_unit
    have _ : IsLocalRing C := hLocC
    refine ⟨hLocC, ?_⟩
    ext b
    constructor
    · intro hb
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal] at hb
      rw [IsLocalRing.mem_maximalIdeal]
      intro hb_unit
      exact hb (hb_unit.map ι_B)
    · intro hb
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal]
      have hnil : IsNilpotent (ι_B b) := hJ_nil (Ideal.mem_map_of_mem _ hb)
      exact hnil.not_isUnit
  obtain ⟨hLocC, hComapBC⟩ := hFiber
  have _ : IsLocalRing (TensorProduct A Ω B) := hLocC
  refine ⟨hLocC, ?_⟩
  intro W _ _ _ β₀ hβ₀
  let C : Type u := TensorProduct A Ω B
  let ι_B : B →ₐ[A] C := Algebra.TensorProduct.includeRight
  let q : Ideal W := Ideal.comap β₀ (IsLocalRing.maximalIdeal C)
  have hq_prime : q.IsPrime := Ideal.comap_isPrime β₀ (IsLocalRing.maximalIdeal C)
  have hq_over : Ideal.comap (algebraMap B W) q = 𝔪_B := by
    change Ideal.comap (β₀.comp (algebraMap B W)) (IsLocalRing.maximalIdeal C) = 𝔪_B
    rw [hβ₀]
    exact hComapBC
  obtain ⟨S', hFG_S', r₀, hr₀_q, hAway_bij⟩ :=
