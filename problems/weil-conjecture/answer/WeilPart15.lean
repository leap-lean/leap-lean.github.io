    weil_smooth_proj_curve_principal_deg_zero_and_riemann_surj k C hProjC
  obtain ⟨hFinTors, hCardMod⟩ :=
    weil_smooth_proj_curve_picZero_divisible_and_torsion_finite k C hProjC ℓ hℓ hRiemann
  let Fℤ := (CategoryTheory.constantSheaf C.left.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let G := weilEtaleGmSheaf C.left
  let F_ℓ := weilEtaleTorsionSheaf C.left ℓ
  let SC := CategoryTheory.ShortComplex.mk ι_kum p_kum h0
  have hp_ext : ∀ (q : ℕ) (x : G.H q),
      x.comp (CategoryTheory.Abelian.Ext.mk₀ p_kum) (Nat.add_zero q) = ℓ • x := by
    intro q x
    rw [hp_kum]
    have hnsmul : ∀ (n : ℕ),
        x.comp (CategoryTheory.Abelian.Ext.mk₀ (n • CategoryTheory.CategoryStruct.id G))
          (Nat.add_zero q) = n • x := by
      intro n
      induction n with
      | zero =>
        simp [CategoryTheory.Abelian.Ext.mk₀_zero]
      | succ n ih =>
        rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add, CategoryTheory.Abelian.Ext.comp_add,
          ih, CategoryTheory.Abelian.Ext.comp_mk₀_id, succ_nsmul]
    exact hnsmul ℓ
  
  have hSubGe3 : ∀ q : ℕ, 3 ≤ q → Subsingleton (weilEtaleTorsionH C.left ℓ q) := by
    intro q hq
    obtain ⟨n₀, rfl⟩ : ∃ n₀ : ℕ, n₀ + 1 = q := ⟨q - 1, by omega⟩
    have hn₀ : 2 ≤ n₀ := by omega
    have : Subsingleton (G.H n₀) := hVanGm n₀ hn₀
    have : Subsingleton (G.H (n₀ + 1)) := hVanGm (n₀ + 1) (by omega)
    refine ⟨fun a₁ a₂ => ?_⟩
    have ha0 : ∀ a : F_ℓ.H (n₀ + 1), a = 0 := by
      intro a
      have hi0 : a.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero (n₀ + 1)) = 0 :=
        Subsingleton.elim _ _
      obtain ⟨c, hc⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hSE a hi0 (rfl : n₀ + 1 = n₀ + 1)
      have hc0 : c = 0 := Subsingleton.elim _ _
      rw [← hc, hc0]
      exact (hSE.extClass.postcomp Fℤ (rfl : n₀ + 1 = n₀ + 1)).map_zero
    rw [ha0 a₁, ha0 a₂]
  
  have hpδ_zero : ∀ (n₀ : ℕ) (y : G.H n₀),
      ((y.comp (CategoryTheory.Abelian.Ext.mk₀ SC.g) (Nat.add_zero n₀)).comp
        hSE.extClass (rfl : n₀ + 1 = n₀ + 1)) = 0 := by
    intro n₀ y
    have hex₃ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' Fℤ hSE n₀ (n₀ + 1) rfl
    have hzero := (fun {S : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : S.Exact) => S.zero) hex₃
    exact congrArg (fun φ => φ.hom y) hzero
  
  have hFin1 : Finite (weilEtaleTorsionH C.left ℓ 1) := by
    let i₁ : F_ℓ.H 1 →+ G.H 1 :=
      (CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp Fℤ (Nat.add_zero 1)
    have hδ0_zero : ∀ z : G.H 0, z.comp hSE.extClass (rfl : 0 + 1 = 1) = 0 := by
      intro z
      obtain ⟨y, hy⟩ := hDiv0 z
      have hpy : y.comp (CategoryTheory.Abelian.Ext.mk₀ SC.g) (Nat.add_zero 0) = z := by
        dsimp [SC]
        rw [hp_ext 0 y, hy]
      rw [← hpy]
      exact hpδ_zero 0 y
    have hi₁_inj : Function.Injective i₁ := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      obtain ⟨z, hz⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hSE a ha (rfl : 0 + 1 = 1)
      rw [← hz, hδ0_zero z]
    have hi₁_tors : ∀ a : F_ℓ.H 1, ℓ • e₁ (i₁ a) = 0 := by
      intro a
      rw [← map_nsmul, ← hp_ext 1 (i₁ a)]
      have hex₂ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' Fℤ hSE 1
      have hzero := (fun {S : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : S.Exact) => S.zero) hex₂
      have hpa0 : (i₁ a).comp (CategoryTheory.Abelian.Ext.mk₀ SC.g) (Nat.add_zero 1) = 0 :=
        congrArg (fun φ => φ.hom a) hzero
      dsimp [SC] at hpa0
      rw [hpa0, map_zero]
    let emb : weilEtaleTorsionH C.left ℓ 1 → { c : weilCurveClGroup C.left // ℓ • c = 0 } :=
      fun a => ⟨e₁ (i₁ a), hi₁_tors a⟩
    have hemb_inj : Function.Injective emb := by
      intro a₁ a₂ h
      exact hi₁_inj (e₁.injective (congrArg Subtype.val h))
    exact Finite.of_injective emb hemb_inj
  
  have hCard2 : Nat.card (weilEtaleTorsionH C.left ℓ 2) = ℓ := by
    let δ₁ : G.H 1 →+ weilEtaleTorsionH C.left ℓ 2 :=
      hSE.extClass.postcomp Fℤ (rfl : 1 + 1 = 2)
    have : Subsingleton (G.H 2) := hVanGm 2 le_rfl
    have hδ₁_surj : Function.Surjective δ₁ := by
      intro a
      have hi2 : a.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero 2) = 0 :=
        Subsingleton.elim _ _
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hSE a hi2 (rfl : 1 + 1 = 2)
    let ψ : weilCurveClGroup C.left →+ weilEtaleTorsionH C.left ℓ 2 :=
      δ₁.comp e₁.symm.toAddMonoidHom
    have hψ_surj : Function.Surjective ψ := hδ₁_surj.comp e₁.symm.surjective
    let H_ℓ : AddSubgroup (weilCurveClGroup C.left) :=
      (zsmulAddGroupHom (ℓ : ℤ) : weilCurveClGroup C.left →+ weilCurveClGroup C.left).range
    have hker : ψ.ker = H_ℓ := by
      ext c
      simp only [AddMonoidHom.mem_ker, H_ℓ, AddMonoidHom.mem_range, zsmulAddGroupHom_apply,
        natCast_zsmul, ψ, AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom]
      constructor
      · intro hc
        obtain ⟨y, hy⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ hSE (e₁.symm c) (rfl : 1 + 1 = 2) hc
        refine ⟨e₁ y, ?_⟩
        rw [← map_nsmul, ← hp_ext 1 y]
        have hy' : y.comp (CategoryTheory.Abelian.Ext.mk₀ p_kum) (Nat.add_zero 1) = e₁.symm c := hy
        rw [hy', e₁.apply_symm_apply]
      · rintro ⟨d, rfl⟩
        rw [map_nsmul]
        change (ℓ • e₁.symm d).comp hSE.extClass (rfl : 1 + 1 = 2) = 0
        rw [← hp_ext 1 (e₁.symm d)]
        exact hpδ_zero 1 (e₁.symm d)
    have hcard_quot : Nat.card (weilCurveClGroup C.left ⧸ ψ.ker) = ℓ := by
      rwa [hker]
    rw [← Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective ψ hψ_surj).toEquiv]
    exact hcard_quot
  have hFin2 : Finite (weilEtaleTorsionH C.left ℓ 2) :=
    Nat.finite_of_card_ne_zero (by rw [hCard2]; exact hPrime.ne_zero)
  refine ⟨?_, hSubGe3, hCard0, hCard2⟩
  intro q
  match q with
  | 0 => exact hFin0
  | 1 => exact hFin1
  | 2 => exact hFin2
  | q' + 3 =>
    have : Subsingleton (weilEtaleTorsionH C.left ℓ (q' + 3)) := hSubGe3 (q' + 3) (by omega)
    exact Finite.of_subsingleton

theorem weil_etale_mod_prime_injective_higherDirectImage_isZero (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S)
    (I : CategoryTheory.Sheaf X.smallEtaleTopology
      (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))))
    [CategoryTheory.Injective I] (q : ℕ) (hq : 1 ≤ q) :
    CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage f q
        ((CategoryTheory.Sheaf.composeAndSheafify X.smallEtaleTopology
          (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
            AddCommGrpCat.{u})).obj I)) :=
by
  cases q with
  | zero => omega
  | succ n =>
    have hPrime : Nat.Prime ℓ := Fact.out
    have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero
    let _ : NeZero ℓ := ⟨hℓ_ne⟩
    let J_X := X.smallEtaleTopology
    let R_ℓ := ULift.{u, 0} (ZMod ℓ)
    let Fgt := CategoryTheory.forget₂ (ModuleCat.{u, u} R_ℓ) AddCommGrpCat.{u}
    let U_I := (CategoryTheory.Sheaf.composeAndSheafify J_X Fgt).obj I
    
    let φ_ring : ℤ →+* R_ℓ := Int.castRingHom R_ℓ
    let e_Z := (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
    let adj_ext := ModuleCat.extendRestrictScalarsAdj φ_ring
    let iso_fgt : (ModuleCat.restrictScalars φ_ring).comp
        (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}) ≅ Fgt :=
      CategoryTheory.NatIso.ofComponents
        (fun M =>
          { hom := AddCommGrpCat.ofHom (RestrictScalars.addEquiv ℤ R_ℓ M).toAddMonoidHom
            inv := AddCommGrpCat.ofHom (RestrictScalars.addEquiv ℤ R_ℓ M).symm.toAddMonoidHom
            hom_inv_id := rfl
            inv_hom_id := rfl })
        (fun _ => rfl)
    let L_0 := e_Z.symm.functor.comp (ModuleCat.extendScalars φ_ring)
    let adj_fgt : L_0 ⊣ Fgt := (e_Z.symm.toAdjunction.comp adj_ext).ofNatIsoRight iso_fgt
    have hSheaf_Fgt : ∀ K : CategoryTheory.Sheaf J_X (ModuleCat.{u, u} R_ℓ),
        CategoryTheory.Presheaf.IsSheaf J_X (K.obj.comp Fgt) := by
      intro K E
      refine CategoryTheory.Presieve.isSheaf_iso J_X ?_ (K.property (L_0.obj E))
      exact CategoryTheory.NatIso.ofComponents
        (fun U => (adj_fgt.homEquiv E (K.obj.obj U)).toIso)
        (fun {U V} u =>
          CategoryTheory.ConcreteCategory.hom_ext _ _ fun g =>
            adj_fgt.homEquiv_naturality_right g (K.obj.map u))
    let G₀ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} := ⟨I.obj.comp Fgt, hSheaf_Fgt I⟩
    let e_UI : G₀ ≅ U_I := CategoryTheory.sheafificationIso G₀
    
    have h_nsmul_apply : ∀ (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (m : ℕ)
        (U : (X.Etale)ᵒᵖ) (x : ↑(F.obj.obj U)),
        ((m • CategoryTheory.CategoryStruct.id F).hom.app U).hom x = m • x := by
      intro F m U x
      induction m with
      | zero =>
        rw [zero_nsmul, zero_nsmul]
        rfl
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul]
        exact congrArg (· + x) ih
    have hRℓ_cast : ((ℓ : ℕ) : R_ℓ) = 0 :=
      ULift.ext _ _ (CharP.cast_eq_zero (ZMod ℓ) ℓ)
    have hG₀_tor : ℓ • CategoryTheory.CategoryStruct.id G₀ = 0 := by
      apply CategoryTheory.Sheaf.hom_ext
      ext U x
      rw [h_nsmul_apply G₀ ℓ U x]
      let x' : ↑(I.obj.obj U) := x
      change ℓ • x' = 0
      rw [← Nat.cast_smul_eq_nsmul R_ℓ ℓ x', hRℓ_cast, zero_smul]
    let J : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} := CategoryTheory.Injective.under G₀
    let ι : G₀ ⟶ J := CategoryTheory.Injective.ι G₀
    let m_J : J ⟶ J := ℓ • CategoryTheory.CategoryStruct.id J
    let H : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} := CategoryTheory.Limits.kernel m_J
    let κ : H ⟶ J := CategoryTheory.Limits.kernel.ι m_J
    have hι_mJ : ι ≫ m_J = 0 := by
      dsimp [m_J]
      rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
        ← CategoryTheory.Category.id_comp ι, ← CategoryTheory.Preadditive.nsmul_comp,
        hG₀_tor, CategoryTheory.Limits.zero_comp]
    let α₀ : G₀ ⟶ H := CategoryTheory.Limits.kernel.lift m_J ι hι_mJ
    have hα₀_κ : α₀ ≫ κ = ι := CategoryTheory.Limits.kernel.lift_ι m_J ι hι_mJ
    have _ : CategoryTheory.Mono α₀ := by
      have : CategoryTheory.Mono (α₀ ≫ κ) := by
        rw [hα₀_κ]
        infer_instance
      exact CategoryTheory.mono_of_mono α₀ κ
    have hH_tor : ℓ • CategoryTheory.CategoryStruct.id H = 0 := by
      rw [← CategoryTheory.cancel_mono κ, CategoryTheory.Limits.zero_comp,
        CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.comp_id κ, ← CategoryTheory.Preadditive.comp_nsmul]
      exact CategoryTheory.Limits.kernel.condition m_J
    have hH_el : ∀ (U : (X.Etale)ᵒᵖ) (x : ↑(H.obj.obj U)), ℓ • x = 0 := by
      intro U x
      rw [← h_nsmul_apply H ℓ U x, hH_tor]
      rfl
    have h_mod_nsmul : ∀ (U : (X.Etale)ᵒᵖ) (m : ℕ) (x : ↑(H.obj.obj U)),
        m • x = (m % ℓ) • x := by
      intro U m x
      conv_lhs => rw [← Nat.div_add_mod m ℓ]
      rw [add_nsmul, mul_comm, mul_nsmul', hH_el U x, nsmul_zero, zero_add]
    let instMod : ∀ U : (X.Etale)ᵒᵖ, Module R_ℓ ↑(H.obj.obj U) := fun U =>
      { smul := fun r x => r.down.val • x
        one_smul := fun x => by
          change (1 : ZMod ℓ).val • x = x
          rw [ZMod.val_one_eq_one_mod, ← h_mod_nsmul U 1 x, one_nsmul]
        mul_smul := fun r s x => by
          change (r.down * s.down).val • x = r.down.val • (s.down.val • x)
          rw [ZMod.val_mul, ← h_mod_nsmul U (r.down.val * s.down.val) x, mul_nsmul']
        smul_zero := fun r => nsmul_zero r.down.val
        smul_add := fun r x y => nsmul_add x y r.down.val
        add_smul := fun r s x => by
          change (r.down + s.down).val • x = r.down.val • x + s.down.val • x
          rw [ZMod.val_add, ← h_mod_nsmul U (r.down.val + s.down.val) x, add_nsmul]
        zero_smul := fun x => by
          change (0 : ZMod ℓ).val • x = 0
          rw [ZMod.val_zero, zero_nsmul] }
    have hRℓ_smul_eq : ∀ {M : Type u} [AddCommGroup M] [Module R_ℓ M]
        (r : R_ℓ) (m : M), r • m = r.down.val • m := by
      intro M _ _ r m
      have hr : ((r.down.val : ℕ) : R_ℓ) = r :=
        ULift.ext _ _ (ZMod.natCast_zmod_val r.down)
      conv_lhs => rw [← hr]
      exact Nat.cast_smul_eq_nsmul R_ℓ r.down.val m
    have hRℓ_lin : ∀ {M₁ M₂ : Type u} [AddCommGroup M₁] [Module R_ℓ M₁]
        [AddCommGroup M₂] [Module R_ℓ M₂] (g : M₁ →+ M₂) (r : R_ℓ) (m : M₁),
        g (r • m) = r • g m := by
      intro M₁ M₂ _ _ _ _ g r m
      rw [hRℓ_smul_eq r m, hRℓ_smul_eq r (g m), map_nsmul]
    let P_H : (X.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R_ℓ :=
      { obj := fun U => @ModuleCat.of R_ℓ _ ↑(H.obj.obj U) _ (instMod U)
        map := fun {U V} u =>
          letI := instMod U
          letI := instMod V
          ModuleCat.ofHom
            { toAddHom := (H.obj.map u).hom.toAddHom
              map_smul' := hRℓ_lin (H.obj.map u).hom }
        map_id := fun U => by
          let _ := instMod U
          apply ModuleCat.hom_ext
          ext x
          exact congrArg (fun φ : H.obj.obj U ⟶ H.obj.obj U => φ.hom x) (H.obj.map_id U)
        map_comp := fun {U V W} u v => by
          let _ := instMod U
          let _ := instMod V
          let _ := instMod W
          apply ModuleCat.hom_ext
          ext x
          exact congrArg (fun φ : H.obj.obj U ⟶ H.obj.obj W => φ.hom x) (H.obj.map_comp u v) }
    let H_mod : CategoryTheory.Sheaf J_X (ModuleCat.{u, u} R_ℓ) :=
      ⟨P_H, CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J_X P_H Fgt H.property⟩
    let α_mod : I ⟶ H_mod :=
      { hom :=
          { app := fun U =>
              letI := instMod U
              let g_U : ↑(I.obj.obj U) →+ ↑(H.obj.obj U) :=
                { toFun := fun x => (α₀.hom.app U).hom x
                  map_zero' := (α₀.hom.app U).hom.map_zero
                  map_add' := (α₀.hom.app U).hom.map_add }
              ModuleCat.ofHom
                { toAddHom := g_U.toAddHom
                  map_smul' := hRℓ_lin g_U }
            naturality := fun {U V} u => by
              let _ := instMod U
              let _ := instMod V
              apply ModuleCat.hom_ext
              ext x
              exact congrArg (fun φ : G₀.obj.obj U ⟶ H.obj.obj V => φ.hom x)
                (α₀.hom.naturality u) } }
    have _ : CategoryTheory.Mono α_mod := by
      constructor
      intro K g₁ g₂ hg
      let K_ab : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} := ⟨K.obj.comp Fgt, hSheaf_Fgt K⟩
      let g₁_ab : K_ab ⟶ G₀ := ⟨CategoryTheory.Functor.whiskerRight g₁.hom Fgt⟩
      let g₂_ab : K_ab ⟶ G₀ := ⟨CategoryTheory.Functor.whiskerRight g₂.hom Fgt⟩
      have hg_ab : g₁_ab ≫ α₀ = g₂_ab ≫ α₀ := by
        apply CategoryTheory.Sheaf.hom_ext
        ext U x
        exact congrArg (fun ψ : K ⟶ H_mod => (ψ.hom.app U).hom x) hg
      have h_eq_ab : g₁_ab = g₂_ab := (CategoryTheory.cancel_mono α₀).mp hg_ab
      apply CategoryTheory.Sheaf.hom_ext
      ext U x
      exact congrArg (fun ψ : K_ab ⟶ G₀ => (ψ.hom.app U).hom x) h_eq_ab
    let ρ_mod : H_mod ⟶ I :=
      CategoryTheory.Injective.factorThru (CategoryTheory.CategoryStruct.id I) α_mod
    have h_αρ_mod : α_mod ≫ ρ_mod = CategoryTheory.CategoryStruct.id I :=
      CategoryTheory.Injective.comp_factorThru (CategoryTheory.CategoryStruct.id I) α_mod
    let ρ₀ : H ⟶ G₀ := ⟨CategoryTheory.Functor.whiskerRight ρ_mod.hom Fgt⟩
    have h_αρ₀ : α₀ ≫ ρ₀ = CategoryTheory.CategoryStruct.id G₀ := by
      apply CategoryTheory.Sheaf.hom_ext
      ext U x
      exact congrArg (fun ψ : I ⟶ I => (ψ.hom.app U).hom x) h_αρ_mod
    let α : U_I ⟶ H := e_UI.inv ≫ α₀
    let ρ : H ⟶ U_I := ρ₀ ≫ e_UI.hom
    have h_αρ : α ≫ ρ = CategoryTheory.CategoryStruct.id U_I := by
      dsimp [α, ρ]
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc α₀ ρ₀,
        h_αρ₀, CategoryTheory.Category.id_comp, e_UI.inv_hom_id]
    
    let sh := CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
    let Z_sh : X.Etale → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
      fun V => sh.obj ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free)
    have hDiv : ∀ (V : X.Etale) (g : Z_sh V ⟶ J), ∃ h : Z_sh V ⟶ J, h ≫ m_J = g := by
      intro V g
      let P_V := (CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free
      have : ∀ T : (X.Etale)ᵒᵖ,
          CategoryTheory.Mono ((ℓ • CategoryTheory.CategoryStruct.id P_V).app T) := by
        intro T
        change CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id (P_V.obj T))
        rw [AddCommGrpCat.mono_iff_injective]
        intro a b hab
        have hab' : ℓ • a = ℓ • b := by
          have h_app : ∀ (m : ℕ) (z : ↑(P_V.obj T)),
              (m • CategoryTheory.CategoryStruct.id (P_V.obj T)).hom z = m • z := by
            intro m z
            induction m with
            | zero =>
              rw [zero_nsmul, zero_nsmul]
              rfl
            | succ k ih =>
              rw [succ_nsmul, succ_nsmul]
              exact congrArg (· + z) ih
          rw [← h_app ℓ a, ← h_app ℓ b]
          exact hab
        let e_fs := FreeAbelianGroup.equivFinsupp (T.unop ⟶ V)
        let a' : FreeAbelianGroup (T.unop ⟶ V) := a
        let b' : FreeAbelianGroup (T.unop ⟶ V) := b
        have hab_fs : e_fs (ℓ • a') = e_fs (ℓ • b') := congrArg e_fs (hab' : ℓ • a' = ℓ • b')
        rw [map_nsmul, map_nsmul] at hab_fs
        exact e_fs.injective (nsmul_right_injective hℓ_ne hab_fs)
      have _ : CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id P_V) :=
        CategoryTheory.NatTrans.mono_of_mono_app (ℓ • CategoryTheory.CategoryStruct.id P_V)
      have _ : CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id (Z_sh V)) := by
        have h_map : sh.map (ℓ • CategoryTheory.CategoryStruct.id P_V) =
            ℓ • CategoryTheory.CategoryStruct.id (Z_sh V) := by
          rw [sh.map_nsmul, sh.map_id]
        rw [← h_map]
        infer_instance
      let h : Z_sh V ⟶ J :=
        CategoryTheory.Injective.factorThru g (ℓ • CategoryTheory.CategoryStruct.id (Z_sh V))
      refine ⟨h, ?_⟩
      dsimp [m_J]
      rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
