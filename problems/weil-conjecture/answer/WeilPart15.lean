      { obj := fun A => ModuleCat.of R_ℓ (↥A ⧸ (nsmulAddMonoidHom ℓ : ↥A →+ ↥A).range)
        map := fun {A B} f =>
          ModuleCat.ofHom
            { toAddHom := (QuotientAddGroup.lift _
                ((QuotientAddGroup.mk' _).comp f.hom)
