    have hft_hom : RingHom.FiniteType α_x.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hft_map
    let L := ↥(X.residueField x)
    let _ : Algebra k L := α_x.hom.toAlgebra
    have : Algebra.FiniteType k L := hft_hom
    have hbij : Function.Bijective α_x.hom := hZariski L
    let e_x : k ≃+* L := RingEquiv.ofBijective α_x.hom hbij
    let β_x : X.residueField x ⟶ CommRingCat.of k := CommRingCat.ofHom e_x.symm.toRingHom
