  have hInfPt : Infinite Pt := by
    by_contra hNotInf
    rw [not_infinite_iff_finite] at hNotInf
    have : JacobsonSpace ↥C.left := AlgebraicGeometry.LocallyOfFiniteType.jacobsonSpace C.hom
    let S : Set ↥C.left := ⋃ x : Pt, ({x.1} : Set ↥C.left)
    have hClosedS : IsClosed S := isClosed_iUnion_of_finite (fun x : Pt => x.2)
    have hSurjPt : ∀ y : ↥C.left, ∃ x : Pt, x.1 = y := by
      intro y
      by_contra hy_not
      have hy_compl : y ∈ Sᶜ := by
        simp only [S, Set.mem_compl_iff, Set.mem_iUnion, Set.mem_singleton_iff, not_exists]
        exact fun x hx => hy_not ⟨x, hx.symm⟩
      obtain ⟨z, hz_compl, hz_cl⟩ :=
        (jacobsonSpace_iff_locallyClosed.mp inferInstance) Sᶜ ⟨y, hy_compl⟩
          hClosedS.isOpen_compl.isLocallyClosed
      rw [mem_closedPoints_iff] at hz_cl
      exact hz_compl (Set.mem_iUnion.mpr ⟨⟨z, hz_cl⟩, rfl⟩)
    have : Finite ↥C.left := Finite.of_surjective Subtype.val hSurjPt
    have : DiscreteTopology ↥C.left :=
      DiscreteTopology.of_finite_of_isClosed_singleton fun y => by
        obtain ⟨x, rfl⟩ := hSurjPt y
        exact x.2
    have hle0 : topologicalKrullDim C.left ≤ 0 :=
      topologicalKrullDim_zero_of_discreteTopology ↥C.left
    have hdim1 : topologicalKrullDim C.left = (1 : WithBot ℕ∞) :=
      hSmoothKrullDim 1 C inferInstance
    rw [hdim1] at hle0
    have hpos : (0 : WithBot ℕ∞) < (1 : WithBot ℕ∞) :=
      WithBot.coe_lt_coe.mpr (WithTop.coe_lt_coe.mpr Nat.zero_lt_one)
    exact not_le_of_gt hpos hle0
  have : Infinite Pt := hInfPt
  
  have hDenseOfFT : ∀ (W : AlgebraicGeometry.Scheme.{u}) (g : W ⟶ S_k)
      [AlgebraicGeometry.LocallyOfFiniteType g] (Z U : Set ↥W),
      IsClosed Z → IsOpen U → (Z ∩ U).Nonempty →
      ∃ w ∈ Z ∩ U, IsClosed ({w} : Set ↥W) := by
    intro W g _ Z U hZ hU hne
    have : JacobsonSpace ↥W := AlgebraicGeometry.LocallyOfFiniteType.jacobsonSpace g
    obtain ⟨w, hw_in, hw_cl⟩ :=
      (jacobsonSpace_iff_locallyClosed.mp inferInstance) (Z ∩ U) hne
        (hZ.isLocallyClosed.inter hU.isLocallyClosed)
    rw [mem_closedPoints_iff] at hw_cl
    exact ⟨w, hw_in, hw_cl⟩
  have hSecClosed : ∀ (X : AlgebraicGeometry.Scheme.{u}) (f : X ⟶ S_k)
      [AlgebraicGeometry.IsProper f] (σ : S_k ⟶ X),
      σ ≫ f = 𝟙 S_k → IsClosed ({σ.base p₀} : Set ↥X) := by
    intro X f _ σ hσ
    have : AlgebraicGeometry.IsClosedImmersion (σ ≫ f) := by
      rw [hσ]
      infer_instance
    have : AlgebraicGeometry.IsClosedImmersion σ :=
      AlgebraicGeometry.IsClosedImmersion.of_comp σ f
    have hp₀_univ : ({p₀} : Set ↥S_k) = Set.univ :=
      Set.eq_univ_of_forall fun q => Subsingleton.elim q p₀
    have hp₀_cl : IsClosed ({p₀} : Set ↥S_k) := by
      rw [hp₀_univ]
      exact isClosed_univ
    simpa only [Set.image_singleton] using σ.isClosedMap {p₀} hp₀_cl
  have hSecInj : ∀ (X : AlgebraicGeometry.Scheme.{u}) (f : X ⟶ S_k)
      (τ₁ τ₂ : S_k ⟶ X),
      τ₁ ≫ f = 𝟙 S_k → τ₂ ≫ f = 𝟙 S_k → τ₁.base p₀ = τ₂.base p₀ → τ₁ = τ₂ := by
    intro X f τ₁ τ₂ h₁ h₂ heq
    have hFactorEq : ∀ (y₁ y₂ : ↥X) (hy : y₁ = y₂)
        (γ₁ : X.residueField y₁ ⟶ CommRingCat.of k)
        (γ₂ : X.residueField y₂ ⟶ CommRingCat.of k),
        (AlgebraicGeometry.Spec.map γ₁ ≫ X.fromSpecResidueField y₁) ≫ f = 𝟙 S_k →
        (AlgebraicGeometry.Spec.map γ₂ ≫ X.fromSpecResidueField y₂) ≫ f = 𝟙 S_k →
        AlgebraicGeometry.Spec.map γ₁ ≫ X.fromSpecResidueField y₁ =
          AlgebraicGeometry.Spec.map γ₂ ≫ X.fromSpecResidueField y₂ := by
      intro y₁ y₂ hy
      subst hy
      intro γ₁ γ₂ hc₁ hc₂
      let α_y : CommRingCat.of k ⟶ X.residueField y₁ :=
        AlgebraicGeometry.Spec.preimage (X.fromSpecResidueField y₁ ≫ f)
      have hα_y : AlgebraicGeometry.Spec.map α_y = X.fromSpecResidueField y₁ ≫ f :=
        AlgebraicGeometry.Spec.map_preimage _
      have hα₁ : α_y ≫ γ₁ = 𝟙 (CommRingCat.of k) := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id, hα_y,
          ← CategoryTheory.Category.assoc, hc₁]
      have hα₂ : α_y ≫ γ₂ = 𝟙 (CommRingCat.of k) := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id, hα_y,
          ← CategoryTheory.Category.assoc, hc₂]
      have hγ_eq : γ₁ = γ₂ := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro z
        have hev₁ : γ₁.hom (α_y.hom (γ₁.hom z)) = γ₁.hom z :=
          congrArg (fun φ : CommRingCat.of k ⟶ CommRingCat.of k => φ.hom (γ₁.hom z)) hα₁
        have hev₂ : γ₂.hom (α_y.hom (γ₁.hom z)) = γ₁.hom z :=
          congrArg (fun φ : CommRingCat.of k ⟶ CommRingCat.of k => φ.hom (γ₁.hom z)) hα₂
        have hz : α_y.hom (γ₁.hom z) = z := RingHom.injective γ₁.hom hev₁
        rw [hz] at hev₂
        exact hev₂.symm
      rw [hγ_eq]
    have hfac₁ :=
      AlgebraicGeometry.Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField k X τ₁
    have hfac₂ :=
      AlgebraicGeometry.Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField k X τ₂
    have hy_eq : τ₁ (IsLocalRing.closedPoint k) = τ₂ (IsLocalRing.closedPoint k) := by
      rw [Subsingleton.elim (IsLocalRing.closedPoint k) p₀]
      exact heq
    rw [← hfac₁, ← hfac₂]
    exact hFactorEq _ _ hy_eq _ _ (hfac₁.symm ▸ h₁) (hfac₂.symm ▸ h₂)
  have hUniqueSec : ∀ (X : AlgebraicGeometry.Scheme.{u}) (f : X ⟶ S_k)
      [AlgebraicGeometry.IsProper f] (x : ↥X),
      IsClosed ({x} : Set ↥X) →
      ∃! σ : S_k ⟶ X, σ ≫ f = 𝟙 S_k ∧ σ.base p₀ = x := by
    intro X f _ x hx
    have : JacobsonSpace ↥X := AlgebraicGeometry.LocallyOfFiniteType.jacobsonSpace f
