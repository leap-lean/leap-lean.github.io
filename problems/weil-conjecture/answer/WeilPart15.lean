      split_ifs with hmem
      · rfl
      · rw [Finsupp.notMem_support_iff.mp hmem, map_zero]
    have : NoZeroDivisors (TensorProduct k A B) := by
      refine ⟨fun {u v} huv => ?_⟩
      by_contra hne
      push_neg at hne
      rcases hne with ⟨hu, hv⟩
      obtain ⟨fu, rfl⟩ := hDecomp u
      obtain ⟨fv, rfl⟩ := hDecomp v
      have hfu_ne : fu ≠ 0 := by
