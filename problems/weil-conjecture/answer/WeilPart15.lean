theorem weil_smooth_proj_curve_closedPt_valuation_bijection (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    [AlgebraicGeometry.IsProper C.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (hDim : topologicalKrullDim C.left = (1 : WithBot ℕ∞)) :
    let Pt := { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }
    let K := ↑C.left.functionField
    ∃ (φ_k : k →+* K)
      (_P₀ : Pt)
      (t₀ : K)
      (n₀ : ℕ)
      (b₀ : Fin n₀ → K)
      (V_pt : Pt → ValuationSubring K),
      (∀ p : Polynomial k, Polynomial.eval₂ φ_k t₀ p = 0 → p = 0) ∧
      (∀ z : K, ∃ (p : Fin n₀ → Polynomial k) (q : Polynomial k),
        q ≠ 0 ∧
        z * Polynomial.eval₂ φ_k t₀ q =
          ∑ i : Fin n₀, Polynomial.eval₂ φ_k t₀ (p i) * b₀ i) ∧
      Function.Injective V_pt ∧
      (∀ x : Pt,
        (∀ c : k, φ_k c ∈ V_pt x) ∧
        V_pt x ≠ ⊤ ∧
        IsDiscreteValuationRing ↥(V_pt x) ∧
        (∀ z : ↥(V_pt x), ∃ (c : k) (hc : φ_k c ∈ V_pt x),
          z - ⟨φ_k c, hc⟩ ∈ IsLocalRing.maximalIdeal ↥(V_pt x)) ∧
        (∃ e_x : ↑(C.left.presheaf.stalk x.1) ≃+* ↥(V_pt x),
          ∀ r : ↑(C.left.presheaf.stalk x.1), (e_x r : K) = algebraMap _ K r)) ∧
      (∀ W : ValuationSubring K, (∀ c : k, φ_k c ∈ W) → W ≠ ⊤ → ∃ x : Pt, V_pt x = W) :=
by
  classical
  have h_alg_s2 : ∀ (S : Type u) [CommRing S] [IsDomain S] [Algebra k S]
      (K : Type u) [Field K] [Algebra S K] [IsFractionRing S K]
      (f : Polynomial k →+* S),
      f.comp Polynomial.C = algebraMap k S →
      f.Etale →
      (∃ 𝔪₀ : Ideal S, 𝔪₀.IsMaximal ∧ 𝔪₀ ≠ ⊥) ∧
      (∀ p : Polynomial k,
        Polynomial.eval₂ ((algebraMap S K).comp (algebraMap k S)) (algebraMap S K (f Polynomial.X)) p = 0 → p = 0) ∧
      (∃ (n₀ : ℕ) (b₀ : Fin n₀ → K),
        ∀ z : K, ∃ (p : Fin n₀ → Polynomial k) (q : Polynomial k),
          q ≠ 0 ∧
          z * Polynomial.eval₂ ((algebraMap S K).comp (algebraMap k S)) (algebraMap S K (f Polynomial.X)) q =
            ∑ i : Fin n₀,
              Polynomial.eval₂ ((algebraMap S K).comp (algebraMap k S)) (algebraMap S K (f Polynomial.X)) (p i) * b₀ i) := by
    intro S _ _ _ K _ _ _ f hf_comp hf_et
    let R₀ : Type u := Polynomial k
    let _ : Algebra R₀ S := f.toAlgebra
    have hEt_RS : Algebra.Etale R₀ S := hf_et.toAlgebra
    have hTower_kRS : IsScalarTower k R₀ S := IsScalarTower.of_algebraMap_eq' hf_comp.symm
    have hf_inj : Function.Injective f := by
      have : Module.Flat R₀ S := inferInstance
      have : Module.IsTorsionFree R₀ S := Module.Flat.isTorsionFree
      exact (faithfulSMul_iff_algebraMap_injective R₀ S).mp inferInstance
    have hFT_kS : Algebra.FiniteType k S := by
      have : Algebra.FiniteType k R₀ := inferInstance
      have : Algebra.FiniteType R₀ S := inferInstance
      exact Algebra.FiniteType.trans ‹Algebra.FiniteType k R₀› ‹Algebra.FiniteType R₀ S›
    have hPart1 : ∃ 𝔪₀ : Ideal S, 𝔪₀.IsMaximal ∧ 𝔪₀ ≠ ⊥ := by
      obtain ⟨𝔪₀, hMax⟩ := Ideal.exists_maximal S
      refine ⟨𝔪₀, hMax, ?_⟩
      intro h_bot
      let L₀ := S ⧸ 𝔪₀
      let _ : Field L₀ := Ideal.Quotient.field 𝔪₀
      have hFT_L₀ : Algebra.FiniteType k L₀ :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k 𝔪₀) Ideal.Quotient.mk_surjective
      obtain ⟨m, ψ, hψ_surj⟩ := (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k) (S := L₀)).mp hFT_L₀
      have hker_max : (RingHom.ker ψ.toRingHom).IsMaximal :=
        RingHom.ker_isMaximal_of_surjective ψ.toRingHom hψ_surj
      obtain ⟨a, ha_ker⟩ :=
        (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := RingHom.ker ψ.toRingHom)).mp hker_max
      obtain ⟨P, hP⟩ := hψ_surj (Ideal.Quotient.mk 𝔪₀ (f Polynomial.X))
      let c : k := MvPolynomial.eval a P
      have hP_mem : P - MvPolynomial.C c ∈ RingHom.ker ψ.toRingHom := by
        rw [ha_ker, MvPolynomial.mem_vanishingIdeal_singleton_iff]
        simp [c]
      have hψ_eq : ψ P = algebraMap k L₀ c := by
        have h0 : ψ (P - MvPolynomial.C c) = 0 := hP_mem
        rw [map_sub, ← MvPolynomial.algebraMap_eq, ψ.commutes, sub_eq_zero] at h0
        exact h0
      have hmk_eq : Ideal.Quotient.mk 𝔪₀ (f Polynomial.X) = Ideal.Quotient.mk 𝔪₀ (f (Polynomial.C c)) := by
        rw [← hP, hψ_eq]
        have hc : f (Polynomial.C c) = algebraMap k S c := RingHom.congr_fun hf_comp c
        rw [hc]
        rfl
      have hdiff_mem : f Polynomial.X - f (Polynomial.C c) ∈ 𝔪₀ := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hmk_eq, sub_self]
      rw [h_bot, Ideal.mem_bot, sub_eq_zero] at hdiff_mem
      have hXC : (Polynomial.X : Polynomial k) = Polynomial.C c := hf_inj hdiff_mem
      have h10 : (1 : k) = 0 := by
        simpa using congrArg (fun p : Polynomial k => p.coeff 1) hXC
      exact one_ne_zero h10
    let φ_S : k →+* K := (algebraMap S K).comp (algebraMap k S)
    let t₀ : K := algebraMap S K (f Polynomial.X)
    have heval_eq : ∀ p : Polynomial k, Polynomial.eval₂ φ_S t₀ p = algebraMap S K (f p) := by
      intro p
      change Polynomial.eval₂RingHom φ_S t₀ p = ((algebraMap S K).comp f) p
      congr 1
      apply Polynomial.ringHom_ext'
      · ext c
        change Polynomial.eval₂ φ_S t₀ (Polynomial.C c) = algebraMap S K (f (Polynomial.C c))
        rw [Polynomial.eval₂_C]
        have hc : f (Polynomial.C c) = algebraMap k S c := RingHom.congr_fun hf_comp c
        rw [hc]
        rfl
      · simp [t₀]
    have hSK_inj : Function.Injective (algebraMap S K) := IsFractionRing.injective S K
    have hPart2 : ∀ p : Polynomial k, Polynomial.eval₂ φ_S t₀ p = 0 → p = 0 := by
      intro p hp
      rw [heval_eq] at hp
      exact (map_eq_zero_iff f hf_inj).mp ((map_eq_zero_iff (algebraMap S K) hSK_inj).mp hp)
    let _ : Algebra R₀ K := ((algebraMap S K).comp f).toAlgebra
    have hRK_inj : Function.Injective (algebraMap R₀ K) := hSK_inj.comp hf_inj
    have : FaithfulSMul R₀ K := (faithfulSMul_iff_algebraMap_injective R₀ K).mpr hRK_inj
    let F₀ : Type u := FractionRing R₀
    let _ : Algebra F₀ K := FractionRing.liftAlgebra R₀ K
    have : IsScalarTower R₀ F₀ K := FractionRing.isScalarTower_liftAlgebra R₀ K
    let B : Type u := TensorProduct R₀ F₀ S
    have : Algebra.Etale F₀ B := Algebra.Etale.baseChange R₀ S F₀
    have hFinB : Module.Finite F₀ B := by
      obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSep⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod F₀ B).mp inferInstance
      let _ : Finite I := hFinI
      let _ : ∀ i, Field (Ai i) := hFieldAi
      let _ : ∀ i, Algebra F₀ (Ai i) := hAlgAi
      have : ∀ i, Module.Finite F₀ (Ai i) := fun i => (hFinSep i).1
      have : Module.Finite F₀ (∀ i : I, Ai i) := Module.Finite.pi
      exact Module.Finite.equiv e_prod.symm.toLinearEquiv
    let g_SK : S →ₐ[R₀] K :=
      { toRingHom := algebraMap S K
        commutes' := fun _ => rfl }
    let ψ_BK : B →ₐ[F₀] K :=
      Algebra.TensorProduct.lift (Algebra.ofId F₀ K) g_SK (fun _ _ => Commute.all _ _)
    let L₀ : Subalgebra F₀ K := ψ_BK.range
    have hFinL₀ : FiniteDimensional F₀ ↥L₀ :=
      Module.Finite.of_surjective ψ_BK.rangeRestrict.toLinearMap
        (fun ⟨_, b, hb⟩ => ⟨b, Subtype.ext hb⟩)
    have hL₀_inv : ∀ y ∈ L₀, y⁻¹ ∈ L₀ := by
      intro y hy
      by_cases hy0 : y = 0
      · subst hy0; rw [inv_zero]; exact L₀.zero_mem
      · let y_sub : ↥L₀ := ⟨y, hy⟩
        let mul_y : ↥L₀ →ₗ[F₀] ↥L₀ := LinearMap.mulLeft F₀ y_sub
        have h_inj : Function.Injective mul_y := by
          intro w₁ w₂ hw
          apply Subtype.ext
          have hw' : y * (w₁ : K) = y * (w₂ : K) := congrArg Subtype.val hw
          exact mul_left_cancel₀ hy0 hw'
        have h_surj : Function.Surjective mul_y := LinearMap.injective_iff_surjective.mp h_inj
        obtain ⟨w, hw⟩ := h_surj 1
        have hw_K : y * (w : K) = 1 := congrArg Subtype.val hw
        have hinv : y⁻¹ = (w : K) := by
          apply mul_left_cancel₀ hy0
          rw [mul_inv_cancel₀ hy0, hw_K]
        rw [hinv]
        exact w.2
    have hψ_surj : Function.Surjective ψ_BK.toLinearMap := by
      intro z
      obtain ⟨⟨s, t⟩, hst⟩ := IsLocalization.surj (nonZeroDivisors S) z
      dsimp only at hst
      have ht_ne : (t : S) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp t.2
      have hKt_ne : algebraMap S K (t : S) ≠ 0 :=
        (map_ne_zero_iff (algebraMap S K) hSK_inj).mpr ht_ne
      have hs_mem : algebraMap S K s ∈ L₀ := by
        refine ⟨(1 : F₀) ⊗ₜ[R₀] s, ?_⟩
        change (Algebra.TensorProduct.lift (Algebra.ofId F₀ K) g_SK (fun _ _ => Commute.all _ _))
          ((1 : F₀) ⊗ₜ[R₀] s) = algebraMap S K s
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      have ht_mem : algebraMap S K (t : S) ∈ L₀ := by
        refine ⟨(1 : F₀) ⊗ₜ[R₀] (t : S), ?_⟩
        change (Algebra.TensorProduct.lift (Algebra.ofId F₀ K) g_SK (fun _ _ => Commute.all _ _))
          ((1 : F₀) ⊗ₜ[R₀] (t : S)) = algebraMap S K (t : S)
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      have hz_eq : z = algebraMap S K s * (algebraMap S K (t : S))⁻¹ := by
        apply mul_right_cancel₀ hKt_ne
        rw [mul_assoc, inv_mul_cancel₀ hKt_ne, mul_one, hst]
      have hz_mem : z ∈ L₀ := by
        rw [hz_eq]
        exact L₀.mul_mem hs_mem (hL₀_inv _ ht_mem)
      exact hz_mem
    have hFinK : Module.Finite F₀ K := Module.Finite.of_surjective ψ_BK.toLinearMap hψ_surj
    obtain ⟨n₀, Φ, hΦ_surj⟩ := @Module.Finite.exists_fin' F₀ K _ _ _ hFinK
    let b₀ : Fin n₀ → K := fun i => Φ (Pi.single i 1)
    refine ⟨hPart1, hPart2, n₀, b₀, ?_⟩
    intro z
    obtain ⟨c, rfl⟩ := hΦ_surj z
    have hc_sum : Φ c = ∑ i : Fin n₀, algebraMap F₀ K (c i) * b₀ i := by
      have hc_eq : c = ∑ i : Fin n₀, c i • Pi.single i (1 : F₀) := by
        ext j; simp [Pi.single_apply]
      conv_lhs => rw [hc_eq, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Φ.map_smul, Algebra.smul_def]
    choose st hst using fun i : Fin n₀ => IsLocalization.surj (nonZeroDivisors R₀) (c i)
    let p₀ : Fin n₀ → R₀ := fun i => (st i).1
    let q₀ : Fin n₀ → R₀ := fun i => ((st i).2 : R₀)
    have hq₀_ne : ∀ i : Fin n₀, q₀ i ≠ 0 :=
      fun i => mem_nonZeroDivisors_iff_ne_zero.mp (st i).2.2
    let q : Polynomial k := ∏ j : Fin n₀, q₀ j
    have hq_ne : q ≠ 0 := Finset.prod_ne_zero_iff.mpr fun j _ => hq₀_ne j
    let p : Fin n₀ → Polynomial k := fun i => p₀ i * ∏ j ∈ Finset.univ.erase i, q₀ j
    refine ⟨p, q, hq_ne, ?_⟩
    rw [hc_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    have h_prod : q₀ i * ∏ j ∈ Finset.univ.erase i, q₀ j = q :=
      Finset.mul_prod_erase Finset.univ q₀ (Finset.mem_univ i)
    have hci_q : c i * algebraMap R₀ F₀ q = algebraMap R₀ F₀ (p i) := by
      calc c i * algebraMap R₀ F₀ q
          = (c i * algebraMap R₀ F₀ (q₀ i)) * algebraMap R₀ F₀ (∏ j ∈ Finset.univ.erase i, q₀ j) := by
            rw [← h_prod, map_mul, mul_assoc]
        _ = algebraMap R₀ F₀ (p i) := by
            rw [hst i, ← map_mul]
    have hci_K : algebraMap F₀ K (c i) * Polynomial.eval₂ φ_S t₀ q = Polynomial.eval₂ φ_S t₀ (p i) := by
      rw [heval_eq q, heval_eq (p i)]
      change algebraMap F₀ K (c i) * algebraMap R₀ K q = algebraMap R₀ K (p i)
      rw [IsScalarTower.algebraMap_apply R₀ F₀ K q, IsScalarTower.algebraMap_apply R₀ F₀ K (p i),
        ← map_mul, hci_q]
    calc (algebraMap F₀ K (c i) * b₀ i) * Polynomial.eval₂ φ_S t₀ q
        = (algebraMap F₀ K (c i) * Polynomial.eval₂ φ_S t₀ q) * b₀ i := by ring
      _ = Polynomial.eval₂ φ_S t₀ (p i) * b₀ i := by rw [hci_K]

  have h_alg_s3 : ∀ (S : Type u) [CommRing S] [IsDomain S] [Algebra k S]
      (f : Polynomial k →+* S),
      f.comp Polynomial.C = algebraMap k S →
      f.Etale →
      ∀ (q : Ideal S) [q.IsMaximal]
        (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R] [Algebra S R]
        [IsLocalization.AtPrime R q],
        IsDiscreteValuationRing R ∧
        (∀ r : R, ∃ c : k, r - algebraMap S R (algebraMap k S c) ∈ IsLocalRing.maximalIdeal R) := by
    intro S _ _ _ f hf_comp hf_et q _ R _ _ _ _ _
    let R₀ : Type u := Polynomial k
    let _ : Algebra R₀ S := f.toAlgebra
    have hEt_RS : Algebra.Etale R₀ S := hf_et.toAlgebra
    have hTower_kRS : IsScalarTower k R₀ S := IsScalarTower.of_algebraMap_eq' hf_comp.symm
    have hf_inj : Function.Injective f := by
      have : Module.Flat R₀ S := inferInstance
      have : Module.IsTorsionFree R₀ S := Module.Flat.isTorsionFree
      exact (faithfulSMul_iff_algebraMap_injective R₀ S).mp inferInstance
    have hFT_kS : Algebra.FiniteType k S := by
      have : Algebra.FiniteType k R₀ := inferInstance
      have : Algebra.FiniteType R₀ S := inferInstance
      exact Algebra.FiniteType.trans ‹Algebra.FiniteType k R₀› ‹Algebra.FiniteType R₀ S›
    have hNoethS : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing k S
    have hNoethR : IsNoetherianRing R := IsLocalization.isNoetherianRing q.primeCompl R hNoethS
    let L_q := S ⧸ q
    let _ : Field L_q := Ideal.Quotient.field q
    have hSurj_q : Function.Surjective (algebraMap k L_q) := by
      have hFT_Lq : Algebra.FiniteType k L_q :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k q) Ideal.Quotient.mk_surjective
      obtain ⟨m, ψ, hψ_surj⟩ := (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k) (S := L_q)).mp hFT_Lq
      have hker_max : (RingHom.ker ψ.toRingHom).IsMaximal :=
        RingHom.ker_isMaximal_of_surjective ψ.toRingHom hψ_surj
      obtain ⟨a, ha_ker⟩ :=
        (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := RingHom.ker ψ.toRingHom)).mp hker_max
      intro y
      obtain ⟨P, rfl⟩ := hψ_surj y
      refine ⟨MvPolynomial.eval a P, ?_⟩
      have hP_mem : P - MvPolynomial.C (MvPolynomial.eval a P) ∈ RingHom.ker ψ.toRingHom := by
        rw [ha_ker, MvPolynomial.mem_vanishingIdeal_singleton_iff]
        simp
      have h0 : ψ (P - MvPolynomial.C (MvPolynomial.eval a P)) = 0 := hP_mem
      rw [map_sub, ← MvPolynomial.algebraMap_eq, ψ.commutes, sub_eq_zero] at h0
      exact h0.symm
    obtain ⟨c_x, hc_x⟩ := hSurj_q (Ideal.Quotient.mk q (f Polynomial.X))
    let π_P : Polynomial k := Polynomial.X - Polynomial.C c_x
    have hπ_P_ne : π_P ≠ 0 := Polynomial.X_sub_C_ne_zero c_x
    let π_S : S := f π_P
    have hπ_S_ne : π_S ≠ 0 := fun h0 => hπ_P_ne (hf_inj (h0.trans (map_zero f).symm))
    have hπ_S_mem : π_S ∈ q := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change Ideal.Quotient.mk q (f (Polynomial.X - Polynomial.C c_x)) = 0
      rw [map_sub, map_sub]
      have hc_eq : f (Polynomial.C c_x) = algebraMap k S c_x := RingHom.congr_fun hf_comp c_x
      rw [hc_eq]
      change Ideal.Quotient.mk q (f Polynomial.X) - algebraMap k L_q c_x = 0
      rw [hc_x, sub_self]
    let I_π : Ideal S := Ideal.span ({π_S} : Set S)
    let Q_π : Type u := S ⧸ I_π
    have h_et_Q : Algebra.Etale k Q_π := by
      let _ : Algebra R₀ k := (Polynomial.evalRingHom c_x).toAlgebra
      have : Algebra.Etale k (TensorProduct R₀ k S) := Algebra.Etale.baseChange R₀ S k
      have hg₁_comm : ∀ p : R₀, algebraMap k Q_π (Polynomial.eval c_x p) = Ideal.Quotient.mk I_π (f p) := by
        intro p
        obtain ⟨h, hh⟩ := @Polynomial.X_sub_C_dvd_sub_C_eval k c_x _ p
        have hf_sub : f p - algebraMap k S (Polynomial.eval c_x p) = π_S * f h := by
          have hc_ev : f (Polynomial.C (Polynomial.eval c_x p)) = algebraMap k S (Polynomial.eval c_x p) :=
            RingHom.congr_fun hf_comp (Polynomial.eval c_x p)
          calc f p - algebraMap k S (Polynomial.eval c_x p)
              = f (p - Polynomial.C (Polynomial.eval c_x p)) := by rw [map_sub, hc_ev]
            _ = f (π_P * h) := congrArg f hh
            _ = π_S * f h := map_mul f π_P h
        have h_mem : f p - algebraMap k S (Polynomial.eval c_x p) ∈ I_π :=
          Ideal.mem_span_singleton.mpr ⟨f h, hf_sub⟩
        have h_eq0 : Ideal.Quotient.mk I_π (f p - algebraMap k S (Polynomial.eval c_x p)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr h_mem
        rw [map_sub, sub_eq_zero] at h_eq0
        exact h_eq0.symm
      let g₁ : k →ₐ[R₀] Q_π :=
        { toRingHom := algebraMap k Q_π
          commutes' := hg₁_comm }
      let g₂ : S →ₐ[R₀] Q_π :=
        { toRingHom := Ideal.Quotient.mk I_π
          commutes' := fun _ => rfl }
      let φ_fwd_alg : TensorProduct R₀ k S →ₐ[R₀] Q_π :=
        Algebra.TensorProduct.lift g₁ g₂ (fun _ _ => Commute.all _ _)
      let φ_fwd : TensorProduct R₀ k S →+* Q_π := φ_fwd_alg.toRingHom
      let ι_R_alg : S →ₐ[R₀] TensorProduct R₀ k S :=
        Algebra.TensorProduct.includeRight (R := R₀) (A := k) (B := S)
      have h_ker_ι : ∀ r ∈ I_π, ι_R_alg r = 0 := by
        intro r hr
        have h_le : I_π ≤ RingHom.ker ι_R_alg.toRingHom := by
          rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
          change (1 : k) ⊗ₜ[R₀] (f π_P) = 0
          have h_smul : f π_P = π_P • (1 : S) := by
            change f π_P = f π_P * 1
            rw [mul_one]
          rw [h_smul, ← TensorProduct.smul_tmul]
          have h_ev0 : π_P • (1 : k) = 0 := by
            change Polynomial.eval c_x (Polynomial.X - Polynomial.C c_x) * 1 = 0
            simp
          rw [h_ev0, TensorProduct.zero_tmul]
        exact h_le hr
      let φ_inv_alg : Q_π →ₐ[R₀] TensorProduct R₀ k S := Ideal.Quotient.liftₐ I_π ι_R_alg h_ker_ι
      let φ_inv : Q_π →+* TensorProduct R₀ k S := φ_inv_alg.toRingHom
      have h_right_inv : ∀ x : Q_π, φ_fwd (φ_inv x) = x := by
        intro x
        obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective x
        change φ_fwd_alg ((1 : k) ⊗ₜ[R₀] s) = Ideal.Quotient.mk I_π s
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      have h_left_inv : ∀ t : TensorProduct R₀ k S, φ_inv (φ_fwd t) = t := by
        have h_lin : (φ_inv_alg.comp φ_fwd_alg).toLinearMap = LinearMap.id := by
          apply TensorProduct.ext'
          intro a s
          change φ_inv_alg (φ_fwd_alg (a ⊗ₜ[R₀] s)) = a ⊗ₜ[R₀] s
          have hfwd : φ_fwd_alg (a ⊗ₜ[R₀] s) = Ideal.Quotient.mk I_π (algebraMap k S a * s) := by
            rw [Algebra.TensorProduct.lift_tmul, map_mul]
            rfl
          rw [hfwd]
          change (1 : k) ⊗ₜ[R₀] (algebraMap k S a * s) = a ⊗ₜ[R₀] s
          have ha_f : algebraMap k S a * s = (Polynomial.C a) • s := by
            change algebraMap k S a * s = f (Polynomial.C a) * s
            rw [← RingHom.congr_fun hf_comp a]
            rfl
          rw [ha_f, ← TensorProduct.smul_tmul]
          have ha_k : (Polynomial.C a) • (1 : k) = a := by
            change Polynomial.eval c_x (Polynomial.C a) * 1 = a
            simp
          rw [ha_k]
        intro t
        exact LinearMap.congr_fun h_lin t
      let e_ring : TensorProduct R₀ k S ≃+* Q_π :=
        { φ_fwd with
          invFun := φ_inv
          left_inv := h_left_inv
          right_inv := h_right_inv }
      let e_alg : TensorProduct R₀ k S ≃ₐ[k] Q_π :=
        AlgEquiv.ofRingEquiv (f := e_ring) fun a => by
          change φ_fwd_alg (a ⊗ₜ[R₀] (1 : S)) = algebraMap k Q_π a
          rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
          rfl
      exact Algebra.Etale.of_equiv e_alg
    have h_idem : ∀ s : S, ∃ w b : S, s * (1 - s * w) = π_S * b := by
      obtain ⟨I, _, L, hFieldL, hAlgL, e_prod, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod k Q_π).mp h_et_Q
      let _ : ∀ i, Field (L i) := hFieldL
      let _ : ∀ i, Algebra k (L i) := hAlgL
      intro s
      let u : ∀ i : I, L i := e_prod (Ideal.Quotient.mk I_π s)
      let v : ∀ i : I, L i := fun i => (u i)⁻¹
      have huv : u * (1 - u * v) = 0 := by
        ext i
        simp only [Pi.mul_apply, Pi.sub_apply, Pi.one_apply, Pi.zero_apply, v]
        by_cases hi : u i = 0
        · simp [hi]
        · rw [mul_inv_cancel₀ hi, sub_self, mul_zero]
      obtain ⟨w, hw⟩ := Ideal.Quotient.mk_surjective (e_prod.symm v)
      have h_mk0 : Ideal.Quotient.mk I_π (s * (1 - s * w)) = 0 := by
        apply e_prod.injective
        have h1 : Ideal.Quotient.mk I_π (s * (1 - s * w)) =
            Ideal.Quotient.mk I_π s * (1 - Ideal.Quotient.mk I_π s * e_prod.symm v) := by
          rw [map_mul, map_sub, map_one, map_mul, hw]
        rw [map_zero, h1, map_mul, map_sub, map_one, map_mul, e_prod.apply_symm_apply]
        exact huv
      rw [Ideal.Quotient.eq_zero_iff_mem] at h_mk0
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp h_mk0
      exact ⟨w, b, hb⟩
    let ι : S →+* R := algebraMap S R
    have h_le_nzd : q.primeCompl ≤ nonZeroDivisors S := by
      intro t ht
      refine mem_nonZeroDivisors_of_ne_zero fun h0 => ?_
      exact ht (h0 ▸ q.zero_mem)
    have hι_inj : Function.Injective ι := IsLocalization.injective R h_le_nzd
    have h_map_q : Ideal.map ι q = IsLocalRing.maximalIdeal R :=
      IsLocalization.AtPrime.map_eq_maximalIdeal q R
    have h_under_m : Ideal.comap ι (IsLocalRing.maximalIdeal R) = q :=
      IsLocalization.AtPrime.under_maximalIdeal R q
    have hιπ_mem : ι π_S ∈ IsLocalRing.maximalIdeal R := by
      rw [← h_map_q]
      exact Ideal.mem_map_of_mem ι hπ_S_mem
    have hιπ_ne : ι π_S ≠ 0 := (map_ne_zero_iff ι hι_inj).mpr hπ_S_ne
    have hNotField : ¬IsField R := by
      intro hF
      obtain ⟨u_inv, hu_inv⟩ := hF.mul_inv_cancel hιπ_ne
      have hu : IsUnit (ι π_S) := isUnit_iff_exists_inv.mpr ⟨u_inv, hu_inv⟩
      exact (IsLocalRing.notMem_maximalIdeal.mpr hu) hιπ_mem
    have h_prin : Submodule.IsPrincipal (IsLocalRing.maximalIdeal R) := by
      refine ⟨⟨ι π_S, ?_⟩⟩
      apply le_antisymm
      · intro z hz
        obtain ⟨⟨s, t⟩, hzt⟩ := IsLocalization.surj q.primeCompl z
        dsimp only at hzt
        have hs_mem : s ∈ q := by
          rw [← h_under_m, Ideal.mem_comap, ← hzt]
          exact Ideal.mul_mem_right (ι t) (IsLocalRing.maximalIdeal R) hz
        obtain ⟨w, b, hswb⟩ := h_idem s
        have hιs_mem : ι s ∈ IsLocalRing.maximalIdeal R := by
          rw [← h_map_q]
          exact Ideal.mem_map_of_mem ι hs_mem
        have h1_not_mem : 1 - ι s * ι w ∉ IsLocalRing.maximalIdeal R := by
          intro h_mem
          have h1 : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
            have h_add := (IsLocalRing.maximalIdeal R).add_mem h_mem
              (Ideal.mul_mem_right (ι w) (IsLocalRing.maximalIdeal R) hιs_mem)
            rwa [sub_add_cancel] at h_add
          exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
            ((IsLocalRing.maximalIdeal R).eq_top_of_isUnit_mem h1 isUnit_one)
        have hu₁ : IsUnit (1 - ι s * ι w) := IsLocalRing.notMem_maximalIdeal.mp h1_not_mem
        have hu₂ : IsUnit (ι t) := IsLocalization.map_units R t
        let U : Rˣ := hu₂.unit * hu₁.unit
        have hU_eq : z * (U : R) = ι π_S * ι b := by
          calc z * (U : R)
              = (z * ι t) * (1 - ι s * ι w) := by
                change z * (ι t * (1 - ι s * ι w)) = _
                ring
            _ = ι s * (1 - ι s * ι w) := by rw [hzt]
            _ = ι (s * (1 - s * w)) := by simp [ι]
            _ = ι (π_S * b) := by rw [hswb]
            _ = ι π_S * ι b := map_mul ι π_S b
        rw [Submodule.mem_span_singleton]
        refine ⟨ι b * ↑U⁻¹, ?_⟩
        calc (ι b * ↑U⁻¹) • ι π_S
            = (ι π_S * ι b) * ↑U⁻¹ := by rw [smul_eq_mul]; ring
          _ = (z * (U : R)) * ↑U⁻¹ := by rw [← hU_eq]
          _ = z := by rw [mul_assoc, Units.mul_inv, mul_one]
      · rw [← Ideal.span, Ideal.span_singleton_le_iff_mem]
        exact hιπ_mem
    have hDVR : IsDiscreteValuationRing R :=
      ((IsDiscreteValuationRing.TFAE R hNotField).out 5 1).mp h_prin
    refine ⟨hDVR, ?_⟩
    intro r
    obtain ⟨⟨s, t⟩, hrt⟩ := IsLocalization.surj q.primeCompl r
    dsimp only at hrt
    have ht_bar_ne : Ideal.Quotient.mk q (t : S) ≠ 0 :=
      Ideal.Quotient.eq_zero_iff_mem.not.mpr t.2
    obtain ⟨c, hc⟩ := hSurj_q (Ideal.Quotient.mk q s * (Ideal.Quotient.mk q (t : S))⁻¹)
    refine ⟨c, ?_⟩
    have h_bar_eq : Ideal.Quotient.mk q (s - algebraMap k S c * (t : S)) = 0 := by
      rw [map_sub, map_mul]
      change Ideal.Quotient.mk q s - algebraMap k L_q c * Ideal.Quotient.mk q (t : S) = 0
      rw [hc, inv_mul_cancel_right₀ ht_bar_ne, sub_self]
    have h_mem_q : s - algebraMap k S c * (t : S) ∈ q :=
      Ideal.Quotient.eq_zero_iff_mem.mp h_bar_eq
    have h_mem_m : (r - ι (algebraMap k S c)) * ι t ∈ IsLocalRing.maximalIdeal R := by
      have h1 : ι (s - algebraMap k S c * (t : S)) ∈ IsLocalRing.maximalIdeal R := by
        rw [← h_map_q]
        exact Ideal.mem_map_of_mem ι h_mem_q
      rw [map_sub, map_mul, ← hrt] at h1
      convert h1 using 1
      ring
    let ut : Rˣ := (IsLocalization.map_units R t).unit
    have h_mul_inv := Ideal.mul_mem_right (↑ut⁻¹ : R) (IsLocalRing.maximalIdeal R) h_mem_m
    have h_ut : ι t * (↑ut⁻¹ : R) = 1 := ut.mul_inv
    rwa [mul_assoc, h_ut, mul_one] at h_mul_inv

  have h_alg_s4 : ∀ (K : Type u) [Field K],
      (∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Algebra R K] [IsFractionRing R K],
        ∃ (V : ValuationSubring K) (e : R ≃+* ↥V),
          V ≠ ⊤ ∧
          IsDiscreteValuationRing ↥V ∧
          (∀ r : R, (e r : K) = algebraMap R K r) ∧
          (∀ z : K, z ∈ V ↔ ∃ r : R, algebraMap R K r = z)) ∧
      (∀ (V W : ValuationSubring K),
        IsDiscreteValuationRing ↥V → V ≤ W → W ≠ ⊤ → V = W) := by
    intro K _
    refine ⟨?_, ?_⟩
    · intro R _ _ _ _ _
      let ι : R →+* K := algebraMap R K
      have hι_inj : Function.Injective ι := IsFractionRing.injective R K
      have : ValuationRing R := of_isDiscreteValuationRing R
      have h_tot := (ValuationRing.iff_dvd_total (R := R)).mp inferInstance
      have h_or : ∀ z : K, z ∈ ι.range ∨ z⁻¹ ∈ ι.range := by
        intro z
        obtain ⟨⟨a, b⟩, hzb⟩ := IsLocalization.surj (nonZeroDivisors R) z
        dsimp only at hzb
        have hb_ne : (b : R) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b.2
        have hKb_ne : ι b ≠ 0 := (map_ne_zero_iff ι hι_inj).mpr hb_ne
        have hz_eq : z = ι a * (ι b)⁻¹ := by
          apply mul_right_cancel₀ hKb_ne
          rw [mul_assoc, inv_mul_cancel₀ hKb_ne, mul_one, hzb]
        rcases h_tot.total (b : R) a with ⟨c, rfl⟩ | ⟨c, hbc⟩
        · left
          refine ⟨c, ?_⟩
          rw [hz_eq, map_mul, mul_right_comm, mul_inv_cancel₀ hKb_ne, one_mul]
        · by_cases ha0 : a = 0
          · left
            subst ha0
            refine ⟨0, ?_⟩
            simp [hz_eq]
          · right
            have hKa_ne : ι a ≠ 0 := (map_ne_zero_iff ι hι_inj).mpr ha0
            refine ⟨c, ?_⟩
            rw [hz_eq, mul_inv_rev, inv_inv, hbc, map_mul, mul_right_comm,
              mul_inv_cancel₀ hKa_ne, one_mul]
      let V : ValuationSubring K := ValuationSubring.ofSubring ι.range h_or
      have hV_mem : ∀ z : K, z ∈ V ↔ ∃ r : R, ι r = z :=
        fun z => ValuationSubring.mem_ofSubring ι.range h_or z
      let f_res : R →+* ↥V :=
        { toFun := fun r => ⟨ι r, (hV_mem (ι r)).mpr ⟨r, rfl⟩⟩
          map_one' := Subtype.ext (map_one ι)
          map_mul' := fun x y => Subtype.ext (map_mul ι x y)
          map_zero' := Subtype.ext (map_zero ι)
          map_add' := fun x y => Subtype.ext (map_add ι x y) }
