  · 
    obtain ⟨hV₂, θ₂, hθ₂_1, hθ₂_2⟩ := hPullbackCube P_d.hom P_d.hom V₁ hV₁ V₁ hV₁
    let fstPP := CategoryTheory.Limits.pullback.fst P_d.hom P_d.hom
