      intro u
      induction u using TensorProduct.inductionOn
      · rename_i ω₀ z
        obtain ⟨n, c, hc⟩ := IsPurelyInseparable.pow_mem κ_A q z
        obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective (R := A) c
