      change ev₀ G (((CategoryTheory.Abelian.Ext.mk₀ δ).postcomp Fℤ (Nat.add_zero 0)) x) = ev₀ G y
      rw [hev_nat δ x, (ev₀ (weilEtaleKSheaf X)).apply_symm_apply]
      change (δ_pre.app (Opposite.op T_X)).hom ((e_sh.inv.hom.app (Opposite.op T_X)).hom s') =
