  have h𝔮'_prime : 𝔮'.IsPrime := Ideal.comap_isPrime j q
  have hClear : ∀ w : W, ∃ (N : ℕ) (s_w : ↥S'), w * j r₀ ^ N = j s_w := by
    intro w
    obtain ⟨u, hu⟩ := hAway_bij.surjective (algebraMap W (Localization.Away (j r₀)) w)
    obtain ⟨n₁, s₀, hs₀⟩ := IsLocalization.Away.surj r₀ u
    have hmap_r : Localization.awayMap j r₀ (algebraMap ↥S' (Localization.Away r₀) r₀) =
