    rw [← CategoryTheory.Category.assoc m₅ d₀ iR, hs₅,
      CategoryTheory.Category.assoc f₄ inv_tp iR, hs_tp, hs₄,
      ← CategoryTheory.Category.assoc m₃ f₃ s₀_fst, hs₃,
      CategoryTheory.Category.assoc f₂ sec_left s₀_fst, hs_sec,
      ← CategoryTheory.Category.assoc m₂ f₂ φ'_map, hs₂]
