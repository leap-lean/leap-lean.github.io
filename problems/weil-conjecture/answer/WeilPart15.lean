      rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem] at hk
      exact ⟨k, by rw [← map_pow]; exact hI_AB_ker hk⟩
    obtain ⟨q, hq⟩ := ExpChar.exists κ_A
    have hq_ne : q ≠ 0 := expChar_ne_zero κ_A q
    have _ : ExpChar Ω q := by
