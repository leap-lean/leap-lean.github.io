        (∀ (Y : S.Etale) (f : Y ⟶ U) (a : ↥A),
          (∀ y : ↥Y.left, s (f.left.base y) = a) →
          (F_m.obj.map f.op).hom t = (F_m.obj.map (hT.from Y).op).hom (η.hom a)) →
