        (CategoryTheory.homOfLE (U.left.basicOpen_le g_sep)).op
    exact (congrArg CommRingCat.Hom.hom hcomp).symm
  obtain ⟨hDomD, hInjD, hGenD, hMaxD, hFinD⟩ := hAway_g D
  have : IsDomain D := hDomD
  have hV₀_inj : Function.Injective hV₀.fromSpec.base :=
    hV₀.isOpenImmersion_fromSpec.base_open.injective
  refine ⟨W₀, hW₀, V₀, hV₀, hu₀, e, hDomD, ?_, ?_, ?_, ?_, ?_⟩
  · rw [happ_eq]
    exact hInjD
  · intro q hq hc
