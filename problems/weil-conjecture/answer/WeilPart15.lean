      SC.ShortExact →
      (∀ (p : ℕ), 1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p SC.X₂)) →
      (∀ [_hc : B_f.IsContinuous S.smallEtaleTopology X.smallEtaleTopology],
        let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u}
          S.smallEtaleTopology X.smallEtaleTopology
