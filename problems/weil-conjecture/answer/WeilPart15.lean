          (adj_g'₀.unit.app F).hom.app (Opposite.op (B_f.obj (weilAffGeomPbcEtObj R₀ R'))) ≫
            (G.obj.map (e_fun.inv.app (weilAffGeomPbcEtObj R₀ R')).op ≫
