              (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₂ R₃) (AlgHom.id R₁ (B₁ m))).toRingHom.comp α₂)) →
        ∀ (F : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of B₀)).smallEtaleTopology AddCommGrpCat.{u})
          (hClopen : ∀ (D : Type u) [CommRing D] [Algebra B₀ D] [Algebra.Etale B₀ D]
            (D_f : Fin r → Type u) [∀ m, CommRing (D_f m)]
            (e : D ≃+* (∀ m : Fin r, D_f m)),
            let S_B := AlgebraicGeometry.Spec (CommRingCat.of B₀)
            let π : ∀ m : Fin r, D →+* D_f m := fun m => (Pi.evalRingHom D_f m).comp e.toRingHom
            ∃ (hEt_comp : ∀ m : Fin r, ((π m).comp (algebraMap B₀ D)).Etale),
              let V_m : ∀ m : Fin r, S_B.Etale := fun m =>
                CategoryTheory.MorphismProperty.Over.mk
                  (P := (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
                  ⊤
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((π m).comp (algebraMap B₀ D))))
                  ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
                    (hEt_comp m))
              let v_m : ∀ m : Fin r, V_m m ⟶ weilAffGeomPbcEtObj B₀ D := fun m =>
                CategoryTheory.MorphismProperty.Over.homMk
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π m)))
                  ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
                    (congrArg AlgebraicGeometry.Spec.map (CommRingCat.ofHom_comp _ _).symm))
                  trivial
              Function.Bijective
                (fun (t : ↥(F.obj.obj (Opposite.op (weilAffGeomPbcEtObj B₀ D)))) (m : Fin r) =>
                  (F.obj.map (Opposite.op (v_m m))) t))
          (M : AddCommGrpCat.{u})
          (β_fam : ∀ (R' : Type u) [CommRing R'] [Algebra R₀ R'] [Algebra.Etale R₀ R']
            (φ' : R' →+* Ω), φ'.comp (algebraMap R₀ R') = algebraMap R₀ Ω →
            ∀ (m : Fin r),
              { β : TensorProduct R₀ B₀ R' →+* C_m m //
                β.comp (algebraMap B₀ (TensorProduct R₀ B₀ R')) = ψ_m m ∧
                ∀ (b : B₀) (r' : R'), β (b ⊗ₜ[R₀] r') = (φ' r') ⊗ₜ[R₁] (b₁_hom m b) }),
          ∃ (diagMap : (∀ m : Fin r,
                { d_m // weilAffGeomPbcPointedCompat B₀ (C_m m) (ψ_m m) F M d_m }) →
              { c // weilAffGeomPbcBaseCompat R₀ B₀ Ω F M c }),
            Function.Bijective diagMap ∧
            ∀ (d : ∀ m : Fin r,
                { d_m // weilAffGeomPbcPointedCompat B₀ (C_m m) (ψ_m m) F M d_m })
              (R' : Type u) [CommRing R'] [Algebra R₀ R'] [Algebra.Etale R₀ R']
              (φ' : R' →+* Ω) (hφ' : φ'.comp (algebraMap R₀ R') = algebraMap R₀ Ω),
              (diagMap d).1 R' φ' hφ' =
                ∑ m : Fin r,
                  (d m).1 (TensorProduct R₀ B₀ R')
                    (β_fam R' φ' hφ' m).1 (β_fam R' φ' hφ' m).2.1) := by
    intro R₀ B₀ Ω _ _ _ _ _ R₁ _ _ _ _ _ r B₁ _ _ e₁ b₁_hom C_m ψ_m
    have h_etMap_eq : ∀ {R : Type u} [CommRing R]
        (W₁ W₂ W₃ : Type u) [CommRing W₁] [Algebra R W₁] [Algebra.Etale R W₁]
        [CommRing W₂] [Algebra R W₂] [Algebra.Etale R W₂]
        [CommRing W₃] [Algebra R W₃] [Algebra.Etale R W₃]
        (u : W₁ →ₐ[R] W₂) (v : W₂ →ₐ[R] W₃) (w : W₁ →ₐ[R] W₃),
        v.toRingHom.comp u.toRingHom = w.toRingHom →
        weilAffGeomPbcEtMap R v ≫ weilAffGeomPbcEtMap R u = weilAffGeomPbcEtMap R w := by
      intro R _ W₁ W₂ W₃ _ _ _ _ _ _ _ _ _ u v w hvw
      apply (AlgebraicGeometry.Scheme.Etale.forget (AlgebraicGeometry.Spec (CommRingCat.of R))).map_injective
      apply CategoryTheory.Over.OverMorphism.ext
      exact (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
        (congrArg AlgebraicGeometry.Spec.map
          ((CommRingCat.ofHom_comp _ _).symm.trans (congrArg CommRingCat.ofHom hvw)))

    have h_map_precomp : ∀ {R : Type u} [CommRing R]
        (G : CategoryTheory.Sheaf (AlgebraicGeometry.Spec (CommRingCat.of R)).smallEtaleTopology AddCommGrpCat.{u})
        {M₀ : AddCommGrpCat.{u}}
        (W₁ W₂ W₃ : Type u) [CommRing W₁] [Algebra R W₁] [Algebra.Etale R W₁]
        [CommRing W₂] [Algebra R W₂] [Algebra.Etale R W₂]
        [CommRing W₃] [Algebra R W₃] [Algebra.Etale R W₃]
        (u : W₁ →ₐ[R] W₂) (v : W₂ →ₐ[R] W₃) (w : W₁ →ₐ[R] W₃),
        v.toRingHom.comp u.toRingHom = w.toRingHom →
        ∀ (rest : G.obj.obj (Opposite.op (weilAffGeomPbcEtObj R W₃)) ⟶ M₀),
          G.obj.map (weilAffGeomPbcEtMap R u).op ≫
            (G.obj.map (weilAffGeomPbcEtMap R v).op ≫ rest) =
          G.obj.map (weilAffGeomPbcEtMap R w).op ≫ rest := by
      intro R _ G M₀ W₁ W₂ W₃ _ _ _ _ _ _ _ _ _ u v w hvw rest
      have h_et := h_etMap_eq W₁ W₂ W₃ u v w hvw
      exact (CategoryTheory.Category.assoc _ _ _).symm.trans
        (congrArg (· ≫ rest) ((G.obj.map_comp _ _).symm.trans
          (congrArg (fun f => G.obj.map f.op) h_et)))

    have h_et_sq_map : ∀ {S : AlgebraicGeometry.Scheme.{u}}
        (G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        {V₁ V₂ V₃ V₄ : S.Etale}
        (a : V₂ ⟶ V₁) (b : V₃ ⟶ V₂) (c : V₃ ⟶ V₄) (d : V₄ ⟶ V₁),
        b ≫ a = c ≫ d →
        G.obj.map a.op ≫ G.obj.map b.op = G.obj.map d.op ≫ G.obj.map c.op := by
      intro S G V₁ V₂ V₃ V₄ a b c d hsq
      exact (G.obj.map_comp a.op b.op).symm.trans
        ((congrArg (fun f => G.obj.map f.op) hsq).trans (G.obj.map_comp d.op c.op))

    have h_cat_orth : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u} 𝒜] [CategoryTheory.Preadditive 𝒜]
        {X Y Z W : 𝒜} (i : X ⟶ Y) (p : Y ⟶ Z) (q : Z ⟶ W),
        i ≫ p = 0 → i ≫ (p ≫ q) = 0 := by
      intro 𝒜 _ _ X Y Z W i p q h0
      exact (CategoryTheory.Category.assoc i p q).symm.trans
        ((congrArg (· ≫ q) h0).trans (CategoryTheory.Limits.zero_comp))

    have h_cat_id_cancel : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u} 𝒜]
        {X Y W : 𝒜} (i : X ⟶ Y) (p : Y ⟶ X) (q : X ⟶ W),
        i ≫ p = 𝟙 X → i ≫ (p ≫ q) = q := by
      intro 𝒜 _ X Y W i p q hid
      exact (CategoryTheory.Category.assoc i p q).symm.trans
        ((congrArg (· ≫ q) hid).trans (CategoryTheory.Category.id_comp q))

    have h_comp_sum_r : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u} 𝒜]
        [CategoryTheory.Preadditive 𝒜] {X Y Z : 𝒜}
        (f : X ⟶ Y) (g : Fin r → (Y ⟶ Z)),
        f ≫ ∑ k : Fin r, g k = ∑ k : Fin r, f ≫ g k := by
      intro 𝒜 _ _ X Y Z f g
      rw [Preadditive.comp_sum]

    have h_base_split : ∀ (R₂ : Type u) [CommRing R₂] [Algebra R₀ R₂] [Algebra R₁ R₂]
        [IsScalarTower R₀ R₁ R₂],
        ∃ e_R₂ : TensorProduct R₀ B₀ R₂ ≃+* (∀ m : Fin r, TensorProduct R₁ R₂ (B₁ m)),
          ∀ (m : Fin r) (b : B₀) (r₂ : R₂),
            e_R₂ (b ⊗ₜ[R₀] r₂) m = r₂ ⊗ₜ[R₁] (b₁_hom m b) := by
      intro R₂ _ _ _ _
      let fwd_m : ∀ m : Fin r, TensorProduct R₀ B₀ R₂ →+* TensorProduct R₁ R₂ (B₁ m) := fun m =>
        let T_m := TensorProduct R₁ R₂ (B₁ m)
        let f₁ : B₀ →ₐ[R₀] T_m :=
          { (Algebra.TensorProduct.includeRight : B₁ m →ₐ[R₁] T_m).toRingHom.comp (b₁_hom m) with
            commutes' := fun r₀ => by
              have hb₁ : b₁_hom m (algebraMap R₀ B₀ r₀) =
                  algebraMap R₁ (B₁ m) (algebraMap R₀ R₁ r₀) := by
                have h_inc : ((1 : R₁) ⊗ₜ[R₀] algebraMap R₀ B₀ r₀) =
                    algebraMap R₁ (TensorProduct R₀ R₁ B₀) (algebraMap R₀ R₁ r₀) := by
                  rw [Algebra.algebraMap_eq_smul_one (R := R₀) (A := B₀) r₀,
                    ← TensorProduct.smul_tmul, Algebra.TensorProduct.algebraMap_apply,
                    Algebra.algebraMap_self, RingHom.id_apply,
                    Algebra.algebraMap_eq_smul_one (R := R₀) (A := R₁) r₀]
                change e₁ ((1 : R₁) ⊗ₜ[R₀] algebraMap R₀ B₀ r₀) m = _
                rw [h_inc, AlgEquiv.commutes]
                rfl
              change (1 : R₂) ⊗ₜ[R₁] (b₁_hom m (algebraMap R₀ B₀ r₀)) = (algebraMap R₀ R₂ r₀) ⊗ₜ[R₁] 1
              rw [hb₁, Algebra.algebraMap_eq_smul_one (R := R₁) (A := B₁ m),
                ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
                IsScalarTower.algebraMap_apply R₀ R₁ R₂] }
        let f₂ : R₂ →ₐ[R₀] T_m :=
          { Algebra.TensorProduct.includeLeftRingHom with commutes' := fun _ => rfl }
        (Algebra.TensorProduct.productMap f₁ f₂).toRingHom
      let fwd : TensorProduct R₀ B₀ R₂ →+* (∀ m : Fin r, TensorProduct R₁ R₂ (B₁ m)) :=
        RingHom.pi fwd_m
      have h_fwd_tmul : ∀ (m : Fin r) (b : B₀) (r₂ : R₂),
          fwd (b ⊗ₜ[R₀] r₂) m = r₂ ⊗ₜ[R₁] (b₁_hom m b) := by
        intro m b r₂
        change ((1 : R₂) ⊗ₜ[R₁] (b₁_hom m b)) * (r₂ ⊗ₜ[R₁] (1 : B₁ m)) = r₂ ⊗ₜ[R₁] (b₁_hom m b)
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
      let inv_assoc : TensorProduct R₀ R₁ B₀ →ₐ[R₀] TensorProduct R₀ B₀ R₂ :=
        (Algebra.TensorProduct.comm R₀ R₂ B₀).toAlgHom.comp
          (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₀ R₁ R₂) (AlgHom.id R₀ B₀))
      have h_inv_smul : ∀ (r₁ : R₁) (w : TensorProduct R₀ R₁ B₀),
          inv_assoc (r₁ • w) = ((1 : B₀) ⊗ₜ[R₀] (algebraMap R₁ R₂ r₁)) * inv_assoc w := by
        intro r₁ w
        have h_eq : r₁ • w = (r₁ ⊗ₜ[R₀] (1 : B₀)) * w := by
          induction w using TensorProduct.inductionOn with
          | tmul a b =>
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
            rfl
          | add x y ihx ihy => rw [smul_add, mul_add, ihx, ihy]
        rw [h_eq, map_mul]
        rfl
      let bwd_m : ∀ m : Fin r, TensorProduct R₁ R₂ (B₁ m) →+ TensorProduct R₀ B₀ R₂ := fun m =>
        let M_tgt := TensorProduct R₀ B₀ R₂
        let _ : Algebra R₁ M_tgt :=
          ((Algebra.TensorProduct.includeRight : R₂ →ₐ[R₀] M_tgt).toRingHom.comp
            (algebraMap R₁ R₂)).toAlgebra
        let blin : R₂ →ₗ[R₁] B₁ m →ₗ[R₁] M_tgt :=
          { toFun := fun r₂ =>
              { toFun := fun bm => ((1 : B₀) ⊗ₜ[R₀] r₂) * inv_assoc (e₁.symm (Pi.single m bm))
                map_add' := fun x y => by rw [Pi.single_add, map_add, map_add, mul_add]
                map_smul' := fun r₁ x => by
                  dsimp
                  rw [Pi.single_smul, map_smul e₁.symm, h_inv_smul, Algebra.smul_def]
                  exact mul_left_comm ((1 : B₀) ⊗ₜ[R₀] r₂)
                    ((1 : B₀) ⊗ₜ[R₀] algebraMap R₁ R₂ r₁) _ }
            map_add' := fun r₂ r₂' => by
              ext bm
              dsimp
              rw [TensorProduct.tmul_add, add_mul]
            map_smul' := fun r₁ r₂ => by
              ext bm
              dsimp
              rw [Algebra.smul_def (R := R₁) (A := R₂), Algebra.smul_def (R := R₁) (A := M_tgt)]
              change ((1 : B₀) ⊗ₜ[R₀] (algebraMap R₁ R₂ r₁ * r₂)) * _ =
                ((1 : B₀) ⊗ₜ[R₀] algebraMap R₁ R₂ r₁) * (((1 : B₀) ⊗ₜ[R₀] r₂) * _)
              rw [← mul_assoc, Algebra.TensorProduct.tmul_mul_tmul, one_mul] }
        (TensorProduct.lift blin).toAddMonoidHom
      let bwd : (∀ m : Fin r, TensorProduct R₁ R₂ (B₁ m)) → TensorProduct R₀ B₀ R₂ :=
        fun z => ∑ m : Fin r, bwd_m m (z m)
      have h_bwd_tmul : ∀ (m : Fin r) (r₂ : R₂) (bm : B₁ m),
          bwd_m m (r₂ ⊗ₜ[R₁] bm) = ((1 : B₀) ⊗ₜ[R₀] r₂) * inv_assoc (e₁.symm (Pi.single m bm)) :=
        fun _ _ _ => rfl
      have h_fwd_inv_assoc : ∀ (w : TensorProduct R₀ R₁ B₀) (k : Fin r),
          fwd (inv_assoc w) k = (1 : R₂) ⊗ₜ[R₁] (e₁ w k) := by
        intro w k
        induction w using TensorProduct.inductionOn with
        | tmul r₁ b =>
          change fwd (b ⊗ₜ[R₀] algebraMap R₁ R₂ r₁) k = (1 : R₂) ⊗ₜ[R₁] (e₁ (r₁ ⊗ₜ[R₀] b) k)
          rw [h_fwd_tmul]
          have he₁_smul : e₁ (r₁ ⊗ₜ[R₀] b) = r₁ • e₁ (1 ⊗ₜ[R₀] b) := by
            have h_smul : r₁ ⊗ₜ[R₀] b = r₁ • ((1 : R₁) ⊗ₜ[R₀] b) := by
              change r₁ ⊗ₜ[R₀] b = (r₁ * 1) ⊗ₜ[R₀] b
              rw [mul_one]
            rw [h_smul, map_smul e₁]
          rw [he₁_smul, Pi.smul_apply]
          change (algebraMap R₁ R₂ r₁) ⊗ₜ[R₁] (b₁_hom k b) = (1 : R₂) ⊗ₜ[R₁] (r₁ • b₁_hom k b)
          rw [TensorProduct.tmul_smul, Algebra.smul_def, Algebra.TensorProduct.algebraMap_apply,
            Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        | add x y ihx ihy =>
          rw [map_add, map_add, Pi.add_apply, ihx, ihy, ← TensorProduct.tmul_add, map_add, Pi.add_apply]
      have h_left : Function.LeftInverse bwd fwd := by
        intro x
        dsimp [bwd]
        induction x using TensorProduct.inductionOn with
        | tmul b r₂ =>
          have h_term : ∀ m : Fin r, bwd_m m (fwd (b ⊗ₜ[R₀] r₂) m) =
              ((1 : B₀) ⊗ₜ[R₀] r₂) * inv_assoc (e₁.symm (Pi.single m (e₁ (1 ⊗ₜ[R₀] b) m))) := by
            intro m
            rw [h_fwd_tmul, h_bwd_tmul]
            rfl
          simp_rw [h_term, ← Finset.mul_sum, ← map_sum, Finset.univ_sum_single, e₁.symm_apply_apply]
          have h_inv_1b : inv_assoc ((1 : R₁) ⊗ₜ[R₀] b) = b ⊗ₜ[R₀] (1 : R₂) := by
            change (Algebra.TensorProduct.comm R₀ R₂ B₀) ((algebraMap R₁ R₂ 1) ⊗ₜ[R₀] b) = b ⊗ₜ[R₀] 1
            rw [map_one]
            rfl
          rw [h_inv_1b, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
        | add x y ihx ihy => simp only [map_add, Pi.add_apply, Finset.sum_add_distrib, ihx, ihy]
      have h_right : Function.RightInverse bwd fwd := by
        intro z
        ext k
        dsimp [bwd]
        rw [map_sum, Finset.sum_apply, Finset.sum_eq_single k]
        · suffices ∀ t : TensorProduct R₁ R₂ (B₁ k), fwd (bwd_m k t) k = t from this (z k)
          intro t
          induction t using TensorProduct.inductionOn with
          | tmul r₂ bm =>
            rw [h_bwd_tmul, map_mul, Pi.mul_apply, h_fwd_tmul, h_fwd_inv_assoc,
              e₁.apply_symm_apply, Pi.single_eq_same, Algebra.TensorProduct.tmul_mul_tmul,
              mul_one, map_one (b₁_hom k), one_mul]
          | add x y ihx ihy => rw [map_add, map_add, Pi.add_apply, ihx, ihy]
        · intro m _ hmk
          suffices ∀ t : TensorProduct R₁ R₂ (B₁ m), fwd (bwd_m m t) k = 0 from this (z m)
          intro t
          induction t using TensorProduct.inductionOn with
          | tmul r₂ bm =>
            rw [h_bwd_tmul, map_mul, Pi.mul_apply, h_fwd_tmul, h_fwd_inv_assoc,
              e₁.apply_symm_apply, Pi.single_eq_of_ne (Ne.symm hmk), TensorProduct.tmul_zero,
              mul_zero]
          | add x y ihx ihy => rw [map_add, map_add, Pi.add_apply, ihx, ihy, add_zero]
        · intro hk
          exact False.elim (hk (Finset.mem_univ k))
      exact ⟨RingEquiv.ofBijective fwd ⟨h_left.injective, h_right.surjective⟩, h_fwd_tmul⟩
    refine ⟨h_base_split, ?_⟩
    intro h2bc F hClopen M β_fam
    have h_sum_app : ∀ {A : AddCommGrpCat.{u}} (s : Finset (Fin r))
        (g : Fin r → (A ⟶ A)) (x : A),
        (∑ m ∈ s, g m) x = ∑ m ∈ s, g m x := by
      intro A s g x
      induction s using Finset.induction_on with
      | empty => rfl
      | insert a s ha ih =>
        rw [Finset.sum_insert ha, Finset.sum_insert ha]
        exact congrArg (_ + ·) ih

    have h_clopen_pkg : ∀ (R₂ : Type u) [CommRing R₂] [Algebra R₀ R₂] [Algebra R₁ R₂]
        [IsScalarTower R₀ R₁ R₂] [Algebra.Etale R₀ R₂],
        let D₂ := TensorProduct R₀ B₀ R₂
        let D₂_f : Fin r → Type u := fun k => TensorProduct R₁ R₂ (B₁ k)
        let alg_k : ∀ k : Fin r, Algebra B₀ (D₂_f k) := fun k =>
          ((Algebra.TensorProduct.includeRight : B₁ k →ₐ[R₁] D₂_f k).toRingHom.comp (b₁_hom k)).toAlgebra
        ∃ (pkg : Σ (et_k : ∀ k : Fin r, PLift (@Algebra.Etale B₀ (D₂_f k) _ _ (alg_k k)))
            (_ : ∀ k : Fin r, @AlgHom B₀ D₂ (D₂_f k) _ _ _ _ (alg_k k)),
            ∀ m : Fin r,
              F.obj.obj (Opposite.op (@weilAffGeomPbcEtObj B₀ _ (D₂_f m) _ (alg_k m) (et_k m).down)) ⟶
                F.obj.obj (Opposite.op (weilAffGeomPbcEtObj B₀ D₂))),
          (∀ (k : Fin r) (b : B₀) (r₂ : R₂), pkg.2.1 k (b ⊗ₜ[R₀] r₂) = r₂ ⊗ₜ[R₁] (b₁_hom k b)) ∧
          (∀ m : Fin r,
            pkg.2.2 m ≫ F.obj.map (@weilAffGeomPbcEtMap B₀ _ D₂ (D₂_f m) _ _ _ _ (alg_k m) (pkg.1 m).down (pkg.2.1 m)).op = 𝟙 _) ∧
          (∀ m k : Fin r, k ≠ m →
            pkg.2.2 m ≫ F.obj.map (@weilAffGeomPbcEtMap B₀ _ D₂ (D₂_f k) _ _ _ _ (alg_k k) (pkg.1 k).down (pkg.2.1 k)).op = 0) ∧
          (∑ m : Fin r,
            F.obj.map (@weilAffGeomPbcEtMap B₀ _ D₂ (D₂_f m) _ _ _ _ (alg_k m) (pkg.1 m).down (pkg.2.1 m)).op ≫ pkg.2.2 m = 𝟙 _) ∧
          (∀ (s₁ s₂ : F.obj.obj (Opposite.op (weilAffGeomPbcEtObj B₀ D₂))),
            (∀ k : Fin r,
              (F.obj.map (@weilAffGeomPbcEtMap B₀ _ D₂ (D₂_f k) _ _ _ _ (alg_k k) (pkg.1 k).down (pkg.2.1 k)).op) s₁ =
              (F.obj.map (@weilAffGeomPbcEtMap B₀ _ D₂ (D₂_f k) _ _ _ _ (alg_k k) (pkg.1 k).down (pkg.2.1 k)).op) s₂) →
            s₁ = s₂) := by
      intro R₂ _ _ _ _ _ D₂ D₂_f alg_k
      obtain ⟨e₂, he₂⟩ := h_base_split R₂
      obtain ⟨h_et_raw, h_bij⟩ := hClopen D₂ D₂_f e₂
      let π_raw : ∀ k : Fin r, D₂ →+* D₂_f k := fun k => (Pi.evalRingHom D₂_f k).comp e₂.toRingHom
      have h_comp_eq : ∀ k : Fin r, (π_raw k).comp (algebraMap B₀ D₂) =
          @algebraMap B₀ (D₂_f k) _ _ (alg_k k) := by
        intro k
