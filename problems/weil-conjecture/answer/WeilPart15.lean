              rw [Scheme.Hom.comp_appTop, Category.assoc, Scheme.ΓSpecIso_naturality incR]
            exact (congrArg (fun φ : (Y_p p).left.presheaf.obj (Opposite.op ⊤) ⟶ T_cat =>
