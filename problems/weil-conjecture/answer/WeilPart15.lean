  let SecC := { σ : S_k ⟶ C.left // σ ≫ C.hom = 𝟙 S_k }
  have hPowInd : ∀ n : ℕ,
      let P_n := weilCurvePowOver k C n
      AlgebraicGeometry.IsIntegral P_n.left ∧
      AlgebraicGeometry.IsProper P_n.hom ∧
      AlgebraicGeometry.SmoothOfRelativeDimension n P_n.hom ∧
      (∀ j : Fin n, weilCurvePowProj k C n j ≫ C.hom = P_n.hom) ∧
      (∀ τ : Fin n → SecC,
        ∃! σ_P : { σ : S_k ⟶ P_n.left // σ ≫ P_n.hom = 𝟙 S_k },
          ∀ j : Fin n, σ_P.1 ≫ weilCurvePowProj k C n j = (τ j).1) := by
    intro n
    induction n with
    | zero =>
      change AlgebraicGeometry.IsIntegral S_k ∧
        AlgebraicGeometry.IsProper (𝟙 S_k) ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 0 (𝟙 S_k) ∧
        (∀ j : Fin 0, (Fin.elim0 j : S_k ⟶ C.left) ≫ C.hom = 𝟙 S_k) ∧
        (∀ τ : Fin 0 → SecC,
          ∃! σ_P : { σ : S_k ⟶ S_k // σ ≫ 𝟙 S_k = 𝟙 S_k },
            ∀ j : Fin 0, σ_P.1 ≫ Fin.elim0 j = (τ j).1)
      refine ⟨inferInstance, inferInstance, inferInstance, fun j => Fin.elim0 j, fun τ => ?_⟩
      refine ⟨⟨𝟙 S_k, CategoryTheory.Category.comp_id _⟩, fun j => Fin.elim0 j, ?_⟩
      rintro ⟨σ', hσ'⟩ _
      apply Subtype.ext
      dsimp only
      rwa [CategoryTheory.Category.comp_id] at hσ'
    | succ n ih =>
      set P_n := weilCurvePowOver k C n
      rcases ih with ⟨hInt_n, hProp_n, hSm_n, hProjComm_n, hTupleSec_n⟩
      have : AlgebraicGeometry.IsIntegral P_n.left := hInt_n
      have : AlgebraicGeometry.IsProper P_n.hom := hProp_n
      have : AlgebraicGeometry.SmoothOfRelativeDimension n P_n.hom := hSm_n
      let fst_n := CategoryTheory.Limits.pullback.fst P_n.hom C.hom
      let snd_n := CategoryTheory.Limits.pullback.snd P_n.hom C.hom
      change AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback P_n.hom C.hom) ∧
        AlgebraicGeometry.IsProper (fst_n ≫ P_n.hom) ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (n + 1) (fst_n ≫ P_n.hom) ∧
        (∀ j : Fin (n + 1),
          Fin.cases snd_n (fun i => fst_n ≫ weilCurvePowProj k C n i) j ≫ C.hom =
            fst_n ≫ P_n.hom) ∧
        (∀ τ : Fin (n + 1) → SecC,
          ∃! σ_P : { σ : S_k ⟶ CategoryTheory.Limits.pullback P_n.hom C.hom //
              σ ≫ (fst_n ≫ P_n.hom) = 𝟙 S_k },
            ∀ j : Fin (n + 1),
              σ_P.1 ≫ Fin.cases snd_n (fun i => fst_n ≫ weilCurvePowProj k C n i) j = (τ j).1)
      have hPb_n := CategoryTheory.IsPullback.of_hasPullback P_n.hom C.hom
      have hInt_succ : AlgebraicGeometry.IsIntegral
          (CategoryTheory.Limits.pullback P_n.hom C.hom) :=
        hPbInt P_n.left C.left P_n.hom C.hom
      have : AlgebraicGeometry.IsProper fst_n :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_n.flip hPropC
      have hProp_succ : AlgebraicGeometry.IsProper (fst_n ≫ P_n.hom) := inferInstance
      have : AlgebraicGeometry.SmoothOfRelativeDimension 1 fst_n :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_n.flip
          inferInstance
      have hSm_1n : AlgebraicGeometry.SmoothOfRelativeDimension (1 + n) (fst_n ≫ P_n.hom) :=
        inferInstance
      have hSm_succ : AlgebraicGeometry.SmoothOfRelativeDimension (n + 1) (fst_n ≫ P_n.hom) :=
        Nat.add_comm 1 n ▸ hSm_1n
      refine ⟨hInt_succ, hProp_succ, hSm_succ, ?_, ?_⟩
      · intro j
        refine Fin.cases ?_ ?_ j
        · exact CategoryTheory.Limits.pullback.condition.symm
        · intro i
          simp only [Fin.cases_succ]
          rw [CategoryTheory.Category.assoc, hProjComm_n i]
      · intro τ
        obtain ⟨σ_prev, h_prev_match, h_prev_uniq⟩ := hTupleSec_n (fun i : Fin n => τ i.succ)
        have h_lift_comm : σ_prev.1 ≫ P_n.hom = (τ 0).1 ≫ C.hom :=
          σ_prev.2.trans (τ 0).2.symm
        let s_next : S_k ⟶ CategoryTheory.Limits.pullback P_n.hom C.hom :=
          CategoryTheory.Limits.pullback.lift σ_prev.1 (τ 0).1 h_lift_comm
        have hs_next_hom : s_next ≫ (fst_n ≫ P_n.hom) = 𝟙 S_k := by
          rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
          exact σ_prev.2
        refine ⟨⟨s_next, hs_next_hom⟩, ?_, ?_⟩
        · intro j
          refine Fin.cases ?_ ?_ j
          · exact CategoryTheory.Limits.pullback.lift_snd _ _ _
          · intro i
            simp only [Fin.cases_succ]
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
            exact h_prev_match i
        · rintro ⟨σ', hσ'_hom⟩ hσ'_match
          apply Subtype.ext
          dsimp only
          have hσ'_fst_hom : (σ' ≫ fst_n) ≫ P_n.hom = 𝟙 S_k := by
            rw [CategoryTheory.Category.assoc]
            exact hσ'_hom
          have hσ'_prev : (⟨σ' ≫ fst_n, hσ'_fst_hom⟩ :
              { σ : S_k ⟶ P_n.left // σ ≫ P_n.hom = 𝟙 S_k }) = σ_prev := by
            apply h_prev_uniq
            intro i
            dsimp only
            rw [CategoryTheory.Category.assoc]
            simpa only [Fin.cases_succ] using hσ'_match i.succ
          have h1 : σ' ≫ fst_n = s_next ≫ fst_n := by
            have hprev_val : σ' ≫ fst_n = σ_prev.1 := congrArg Subtype.val hσ'_prev
            rw [hprev_val, CategoryTheory.Limits.pullback.lift_fst]
          have h2 : σ' ≫ snd_n = s_next ≫ snd_n := by
            rw [CategoryTheory.Limits.pullback.lift_snd]
            simpa only [Fin.cases_zero] using hσ'_match 0
          exact CategoryTheory.Limits.pullback.hom_ext h1 h2
  
  rcases hPowInd d with ⟨hIntP, hPropP, hSmP, hProjComm, hTupleSec⟩
  have : AlgebraicGeometry.IsIntegral P_d.left := hIntP
  have : AlgebraicGeometry.IsProper P_d.hom := hPropP
  have : AlgebraicGeometry.SmoothOfRelativeDimension d P_d.hom := hSmP
  have hCompP : CompactSpace ↥P_d.left :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace P_d.hom
  have : AlgebraicGeometry.IsLocallyNoetherian P_d.left :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian P_d.hom
  have : AlgebraicGeometry.IsNoetherian P_d.left :=
    (AlgebraicGeometry.isNoetherian_iff P_d.left).mpr ⟨inferInstance, hCompP⟩
  have hNoethP : TopologicalSpace.NoetherianSpace ↥P_d.left :=
    AlgebraicGeometry.IsNoetherian.noetherianSpace
  have hDimP : topologicalKrullDim P_d.left = (d : WithBot ℕ∞) :=
    hSmoothKrullDim d P_d hIntP
  let PP := CategoryTheory.Limits.pullback P_d.hom P_d.hom
  let fstPP := CategoryTheory.Limits.pullback.fst P_d.hom P_d.hom
  let sndPP := CategoryTheory.Limits.pullback.snd P_d.hom P_d.hom
  have hPb_PP := CategoryTheory.IsPullback.of_hasPullback P_d.hom P_d.hom
  have : AlgebraicGeometry.IsProper sndPP :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_PP hPropP
  have : AlgebraicGeometry.IsProper fstPP :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_PP.flip hPropP
  have hDenseP : ∀ (Z U : Set ↥P_d.left), IsClosed Z → IsOpen U → (Z ∩ U).Nonempty →
      ∃ z ∈ Z ∩ U, IsClosed ({z} : Set ↥P_d.left) :=
    hDenseOfFT P_d.left P_d.hom
  have hDensePP : ∀ (Z U : Set ↥PP), IsClosed Z → IsOpen U → (Z ∩ U).Nonempty →
      ∃ w ∈ Z ∩ U, IsClosed ({w} : Set ↥PP) :=
    hDenseOfFT PP (fstPP ≫ P_d.hom)
  have hPtToTuple : ∀ z : ↥P_d.left, IsClosed ({z} : Set ↥P_d.left) →
      ∃ Q : Fin d → Pt, weilCurvePowMatchesTuple k C z Q := by
    intro z hz
    obtain ⟨σ_z, ⟨hσ_comp, hσ_pt⟩, _⟩ := hUniqueSec P_d.left P_d.hom z hz
    have hcl_coord : ∀ j : Fin d, IsClosed ({(weilCurvePowProj k C d j).base z} : Set ↥C.left) := by
      intro j
      have hsec_j : (σ_z ≫ weilCurvePowProj k C d j) ≫ C.hom = 𝟙 S_k := by
        rw [CategoryTheory.Category.assoc, hProjComm j, hσ_comp]
      have hcl := hSecClosed C.left C.hom (σ_z ≫ weilCurvePowProj k C d j) hsec_j
      rwa [AlgebraicGeometry.Scheme.Hom.comp_apply, hσ_pt] at hcl
    exact ⟨fun j => ⟨(weilCurvePowProj k C d j).base z, hcl_coord j⟩, hz, fun _ => rfl⟩
  have hTupleToPt : ∀ Q : Fin d → Pt, ∃! z : ↥P_d.left, weilCurvePowMatchesTuple k C z Q := by
    intro Q
    let τ : Fin d → SecC := fun j =>
      ⟨(hUniqueSec C.left C.hom (Q j).1 (Q j).2).choose,
        (hUniqueSec C.left C.hom (Q j).1 (Q j).2).choose_spec.1.1⟩
    have hτ_pt : ∀ j : Fin d, (τ j).1.base p₀ = (Q j).1 :=
      fun j => (hUniqueSec C.left C.hom (Q j).1 (Q j).2).choose_spec.1.2
    obtain ⟨σ_P, hσ_match, hσ_uniq⟩ := hTupleSec τ
    let z₀ : ↥P_d.left := σ_P.1.base p₀
    have hz₀_cl : IsClosed ({z₀} : Set ↥P_d.left) := hSecClosed P_d.left P_d.hom σ_P.1 σ_P.2
    have hz₀_coord : ∀ j : Fin d, (weilCurvePowProj k C d j).base z₀ = (Q j).1 := by
      intro j
      dsimp [z₀]
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hσ_match j, hτ_pt j]
    refine ⟨z₀, ⟨hz₀_cl, hz₀_coord⟩, ?_⟩
    rintro z' ⟨hz'_cl, hz'_coord⟩
    obtain ⟨σ', ⟨hσ'_comp, hσ'_pt⟩, _⟩ := hUniqueSec P_d.left P_d.hom z' hz'_cl
    have hσ'_eq : (⟨σ', hσ'_comp⟩ : { σ : S_k ⟶ P_d.left // σ ≫ P_d.hom = 𝟙 S_k }) = σ_P := by
      apply hσ_uniq
      intro j
      have hsec_j : (σ' ≫ weilCurvePowProj k C d j) ≫ C.hom = 𝟙 S_k := by
        rw [CategoryTheory.Category.assoc, hProjComm j, hσ'_comp]
      have hpt_j : (σ' ≫ weilCurvePowProj k C d j).base p₀ = (Q j).1 := by
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hσ'_pt, hz'_coord j]
      exact (hUniqueSec C.left C.hom (Q j).1 (Q j).2).choose_spec.2
        (σ' ≫ weilCurvePowProj k C d j) ⟨hsec_j, hpt_j⟩
    rw [← hσ'_pt, congrArg (fun s : { σ : S_k ⟶ P_d.left // σ ≫ P_d.hom = 𝟙 S_k } => s.1.base p₀) hσ'_eq]
  have hSliceHom : ∀ r : ↥P_d.left, IsClosed ({r} : Set ↥P_d.left) →
      ∃ g_r : P_d.left ⟶ PP,
        AlgebraicGeometry.IsClosedImmersion g_r ∧
        (∀ z : ↥P_d.left, fstPP.base (g_r.base z) = z) ∧
        (∀ z : ↥P_d.left, sndPP.base (g_r.base z) = r) ∧
        Set.range g_r.base = sndPP.base ⁻¹' {r} := by
    intro r hr
    obtain ⟨s_r, ⟨hs_r_comp, hs_r_pt⟩, _⟩ := hUniqueSec P_d.left P_d.hom r hr
    have : AlgebraicGeometry.IsClosedImmersion (s_r ≫ P_d.hom) := by
      rw [hs_r_comp]
      infer_instance
    have : AlgebraicGeometry.IsClosedImmersion s_r :=
      AlgebraicGeometry.IsClosedImmersion.of_comp s_r P_d.hom
    have hcomm_r : 𝟙 P_d.left ≫ P_d.hom = (P_d.hom ≫ s_r) ≫ P_d.hom := by
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
        hs_r_comp, CategoryTheory.Category.comp_id]
    let g_r : P_d.left ⟶ PP :=
      CategoryTheory.Limits.pullback.lift (𝟙 P_d.left) (P_d.hom ≫ s_r) hcomm_r
    have hgfst : g_r ≫ fstPP = 𝟙 P_d.left := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hgsnd : g_r ≫ sndPP = P_d.hom ≫ s_r := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hOuter : CategoryTheory.IsPullback (g_r ≫ fstPP) P_d.hom P_d.hom (s_r ≫ P_d.hom) := by
      rw [hgfst, hs_r_comp]
      exact CategoryTheory.IsPullback.id_horiz P_d.hom
    have hPb_r : CategoryTheory.IsPullback g_r P_d.hom sndPP s_r :=
      CategoryTheory.IsPullback.of_right hOuter hgsnd hPb_PP
    have hCl_g : AlgebraicGeometry.IsClosedImmersion g_r :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_r.flip inferInstance
    have hfst_z : ∀ z : ↥P_d.left, fstPP.base (g_r.base z) = z := by
      intro z
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hgfst]
      rfl
    have hsnd_z : ∀ z : ↥P_d.left, sndPP.base (g_r.base z) = r := by
      intro z
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hgsnd,
        AlgebraicGeometry.Scheme.Hom.comp_apply, Subsingleton.elim (P_d.hom.base z) p₀]
      exact hs_r_pt
    refine ⟨g_r, hCl_g, hfst_z, hsnd_z, ?_⟩
    ext w
    simp only [Set.mem_range, Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · rintro ⟨z, rfl⟩
      exact hsnd_z z
    · intro hw
      obtain ⟨z, hz, _⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_r w p₀
          (hw.trans hs_r_pt.symm)
      exact ⟨z, hz⟩
  have hClosedPP : ∀ w : ↥PP,
      IsClosed ({w} : Set ↥PP) ↔
        IsClosed ({fstPP.base w} : Set ↥P_d.left) ∧
        IsClosed ({sndPP.base w} : Set ↥P_d.left) := by
    intro w
    constructor
    · intro hw
      exact ⟨by simpa only [Set.image_singleton] using fstPP.isClosedMap {w} hw,
        by simpa only [Set.image_singleton] using sndPP.isClosedMap {w} hw⟩
    · rintro ⟨h1, h2⟩
      obtain ⟨g_r, hCl_g, hfst_z, _, hRange_r⟩ := hSliceHom (sndPP.base w) h2
      have : AlgebraicGeometry.IsClosedImmersion g_r := hCl_g
      have hw_in : w ∈ Set.range g_r.base := by
        rw [hRange_r]
        rfl
      rcases hw_in with ⟨z, rfl⟩
      rw [hfst_z z] at h1
      simpa only [Set.image_singleton] using g_r.isClosedMap {z} h1
  have hPairPP : ∀ z₁ z₂ : ↥P_d.left,
      IsClosed ({z₁} : Set ↥P_d.left) → IsClosed ({z₂} : Set ↥P_d.left) →
      ∃! w : ↥PP, IsClosed ({w} : Set ↥PP) ∧ fstPP.base w = z₁ ∧ sndPP.base w = z₂ := by
    intro z₁ z₂ hz₁ hz₂
    obtain ⟨g_r, _, hfst_z, hsnd_z, hRange_r⟩ := hSliceHom z₂ hz₂
    let w₀ : ↥PP := g_r.base z₁
    have hw₀_cl : IsClosed ({w₀} : Set ↥PP) :=
      (hClosedPP w₀).mpr ⟨by rw [hfst_z]; exact hz₁, by rw [hsnd_z]; exact hz₂⟩
    refine ⟨w₀, ⟨hw₀_cl, hfst_z z₁, hsnd_z z₁⟩, ?_⟩
    rintro w' ⟨_, hw'₁, hw'₂⟩
    have hw'_in : w' ∈ Set.range g_r.base := by
      rw [hRange_r]
      exact hw'₂
    rcases hw'_in with ⟨z', rfl⟩
    rw [hfst_z z'] at hw'₁
    rw [hw'₁]
  have hSlice : ∀ r : ↥P_d.left, IsClosed ({r} : Set ↥P_d.left) →
      ∃ f_slice : ↥P_d.left → ↥PP,
        Continuous f_slice ∧
        (∀ z : ↥P_d.left, fstPP.base (f_slice z) = z) ∧
        (∀ z : ↥P_d.left, sndPP.base (f_slice z) = r) ∧
