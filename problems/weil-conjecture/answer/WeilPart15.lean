    have hLiftMap_id : ∀ (T : Z.Etale) (h : Φ T), liftMap (𝟙 T) h = 𝟙 (liftObj T h) :=
      fun _ _ => MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)
    have hLiftMap_comp : ∀ {T₁ T₂ T₃ : Z.Etale} (u : T₁ ⟶ T₂) (v : T₂ ⟶ T₃) (h₃ : Φ T₃),
