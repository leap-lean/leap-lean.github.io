    intro Z W A _ _ _ _ E_W res_W
    letI : Zero A := Limits.HasZeroObject.zero' A
    haveI : E_W.IsContinuous W.toScheme.smallEtaleTopology Z.smallEtaleTopology := hOpenCont W
    let Φ : Z.Etale → Prop := fun T => Set.range T.hom.base ⊆ Set.range W.ι.base
    have hΦ_mono : ∀ {T₁ T₂ : Z.Etale} (u : T₁ ⟶ T₂), Φ T₂ → Φ T₁ := by
      intro T₁ T₂ u h₂ z ⟨x, hx⟩
      have hw : (u.left ≫ T₂.hom).base x = T₁.hom.base x :=
        congrArg (fun k : T₁.left ⟶ Z => k.base x) (MorphismProperty.Over.w u)
      exact h₂ ⟨u.left.base x, ((Scheme.Hom.comp_apply u.left T₂.hom x).symm.trans hw).trans hx⟩
    let liftObj : ∀ (T : Z.Etale), Φ T → W.toScheme.Etale := fun T hT =>
      let t := AlgebraicGeometry.IsOpenImmersion.lift W.ι T.hom hT
      have ht : t ≫ W.ι = T.hom := AlgebraicGeometry.IsOpenImmersion.lift_fac W.ι T.hom hT
      have hEt : AlgebraicGeometry.Etale t := by
        have : AlgebraicGeometry.Etale (t ≫ W.ι) := ht.symm ▸ T.prop
        exact AlgebraicGeometry.Etale.of_comp t W.ι
      MorphismProperty.Over.mk ⊤ t hEt
    let liftIso : ∀ (T : Z.Etale) (hT : Φ T), E_W.obj (liftObj T hT) ≅ T := fun T hT =>
      MorphismProperty.Over.isoMk (Iso.refl T.left)
        ((Category.id_comp _).trans (AlgebraicGeometry.IsOpenImmersion.lift_fac W.ι T.hom hT).symm)
    have hEW : ∀ (Y : W.toScheme.Etale), Φ (E_W.obj Y) := by
      intro Y z ⟨x, hx⟩
      exact ⟨Y.hom.base x, (Scheme.Hom.comp_apply Y.hom W.ι x).symm.trans hx⟩
    let counitLiftIso : ∀ (Y : W.toScheme.Etale), liftObj (E_W.obj Y) (hEW Y) ≅ Y := fun Y =>
      MorphismProperty.Over.isoMk (Iso.refl Y.left)
        ((Category.id_comp _).trans
          ((cancel_mono W.ι).mp (AlgebraicGeometry.IsOpenImmersion.lift_fac W.ι (E_W.obj Y).hom (hEW Y))).symm)
    let liftMap : ∀ {T₁ T₂ : Z.Etale} (u : T₁ ⟶ T₂) (h₂ : Φ T₂),
        liftObj T₁ (hΦ_mono u h₂) ⟶ liftObj T₂ h₂ := fun {T₁ T₂} u h₂ =>
      MorphismProperty.Over.homMk u.left
        ((cancel_mono W.ι).mp
          ((Category.assoc u.left _ W.ι).trans
            ((congrArg (u.left ≫ ·) (AlgebraicGeometry.IsOpenImmersion.lift_fac W.ι T₂.hom h₂)).trans
