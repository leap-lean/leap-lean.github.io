        topologicalKrullDim ↥O = (n_D : WithBot ℕ∞) := by
      intro T _ V D _ n_D hOpenD e_VD O hO_ne hOV
      let O_V : TopologicalSpace.Opens ↥V :=
        ⟨{ v : ↥V | v.1 ∈ O }, O.isOpen.preimage continuous_subtype_val⟩
      let O_D : TopologicalSpace.Opens (PrimeSpectrum D) :=
        ⟨e_VD.symm ⁻¹' (O_V : Set ↥V), O_V.isOpen.preimage e_VD.symm.continuous⟩
      have hOD_ne : (O_D : Set (PrimeSpectrum D)).Nonempty := by
        rcases hO_ne with ⟨t, htO⟩
        refine ⟨e_VD ⟨t, hOV htO⟩, ?_⟩
        change e_VD.symm (e_VD ⟨t, hOV htO⟩) ∈ O_V
        rw [e_VD.symm_apply_apply]
        exact htO
      let e₁ : ↥O ≃ₜ ↥O_V :=
        { toFun := fun x => ⟨⟨x.1, hOV x.2⟩, x.2⟩
          invFun := fun y => ⟨y.1.1, y.2⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl
          continuous_toFun := Continuous.subtype_mk
            (Continuous.subtype_mk continuous_subtype_val _) _
          continuous_invFun := Continuous.subtype_mk
            (continuous_subtype_val.comp continuous_subtype_val) _ }
      have he₂_mem : ∀ y : ↥O_V, e_VD y.1 ∈ O_D := fun y => by
        change e_VD.symm (e_VD y.1) ∈ O_V
        rw [e_VD.symm_apply_apply]
        exact y.2
      let e₂ : ↥O_V ≃ₜ ↥O_D :=
        { toFun := fun y => ⟨e_VD y.1, he₂_mem y⟩
          invFun := fun z => ⟨e_VD.symm z.1, z.2⟩
          left_inv := fun y => Subtype.ext (e_VD.symm_apply_apply y.1)
          right_inv := fun z => Subtype.ext (e_VD.apply_symm_apply z.1)
          continuous_toFun := Continuous.subtype_mk
            (e_VD.continuous.comp continuous_subtype_val) he₂_mem
          continuous_invFun := Continuous.subtype_mk
            (e_VD.symm.continuous.comp continuous_subtype_val) (fun z => z.2) }
      have hHomeo := e₁.trans e₂
      exact (IsHomeomorph.topologicalKrullDim_eq hHomeo hHomeo.isHomeomorph).trans
        (hOpenD O_D hOD_ne)
    have hU₀_ne : (U₀ : Set ↥Z₀).Nonempty := ⟨u_w, hw_VQ⟩
    have hU₀_sub : ∀ O : TopologicalSpace.Opens ↥Z₀,
        (O : Set ↥Z₀).Nonempty → O ≤ U₀ → topologicalKrullDim ↥O = (m_dim : WithBot ℕ∞) :=
      hSubOpenDim U₀ m_dim hOpenB e_B
    have hZ₀_cov : ∀ z : ↥Z₀, ∃ U_z : TopologicalSpace.Opens ↥Z₀,
        z ∈ U_z ∧ topologicalKrullDim ↥U_z = (m_dim : WithBot ℕ∞) := by
      intro z
      obtain ⟨V_z, hVz, hz_Vz, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := Q) (x := z.1) (U := ⊤) trivial
      let R_z_cat : CommRingCat.{u} := Q.presheaf.obj (Opposite.op V_z)
      let e_spec_z : ↥V_z ≃ₜ PrimeSpectrum R_z_cat := AlgebraicGeometry.Scheme.homeoOfIso hVz.isoSpec
      obtain ⟨hpz_prime, hAlgz, hFTz, e_z, _⟩ :=
        hAffineChart Q fQ Z₀ hClosedZ₀ hIrredZ₀ V_z hVz ⟨z.1, z.2, hz_Vz⟩ e_spec_z
      let p_z : Ideal R_z_cat := PrimeSpectrum.vanishingIdeal (e_spec_z '' { v : ↥V_z | v.1 ∈ Z₀ })
      have : p_z.IsPrime := hpz_prime
      let B_z : Type u := R_z_cat ⧸ p_z
      letI : Algebra k B_z := hAlgz
      have : Algebra.FiniteType k B_z := hFTz
      have : IsDomain B_z := Ideal.Quotient.isDomain p_z
      obtain ⟨m_z, _, _, _, _, _, hOpenBz⟩ := hDomainPkg B_z
      let U_z : TopologicalSpace.Opens ↥Z₀ :=
        ⟨{ y : ↥Z₀ | y.1 ∈ V_z }, V_z.isOpen.preimage continuous_subtype_val⟩
      have hUz_sub : ∀ O : TopologicalSpace.Opens ↥Z₀,
          (O : Set ↥Z₀).Nonempty → O ≤ U_z → topologicalKrullDim ↥O = (m_z : WithBot ℕ∞) :=
        hSubOpenDim U_z m_z hOpenBz e_z
      let W_inter : TopologicalSpace.Opens ↥Z₀ := U₀ ⊓ U_z
      have hW_ne : (W_inter : Set ↥Z₀).Nonempty :=
        nonempty_preirreducible_inter U₀.isOpen U_z.isOpen hU₀_ne ⟨z, hz_Vz⟩
      have hW_eq1 : topologicalKrullDim ↥W_inter = (m_dim : WithBot ℕ∞) :=
        hU₀_sub W_inter hW_ne inf_le_left
      have hW_eq2 : topologicalKrullDim ↥W_inter = (m_z : WithBot ℕ∞) :=
        hUz_sub W_inter hW_ne inf_le_right
      have hmz_eq : (m_z : WithBot ℕ∞) = (m_dim : WithBot ℕ∞) := hW_eq2.symm.trans hW_eq1
      refine ⟨U_z, hz_Vz, ?_⟩
      rw [← hmz_eq]
      exact hUz_sub U_z ⟨z, hz_Vz⟩ le_rfl
    have hDimZ₀_le : topologicalKrullDim ↥Z₀ ≤ (m_dim : WithBot ℕ∞) := by
      have : Nonempty (TopologicalSpace.IrreducibleCloseds ↥Z₀) :=
        ⟨⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥Z₀, isClosed_univ⟩⟩
      rw [topologicalKrullDim, Order.krullDim_eq_iSup_length]
      refine WithBot.coe_le_coe.mpr (iSup_le fun p => ?_)
      obtain ⟨x₀, hx₀_p0⟩ := (p 0).isIrreducible'.nonempty
      obtain ⟨U_x, hx₀_U, hDim_Ux⟩ := hZ₀_cov x₀
      let D_U : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥U_x := fun i =>
        { carrier := Subtype.val ⁻¹' (p i : Set ↥Z₀)
          isIrreducible' := by
            refine ⟨⟨⟨x₀, hx₀_U⟩, p.monotone (Fin.zero_le i) hx₀_p0⟩, ?_⟩
            intro W₁ W₂ hW₁ hW₂ hSW₁ hSW₂
            have hW₁' : IsOpen (Subtype.val '' W₁ : Set ↥Z₀) := U_x.isOpen.isOpenMap_subtype_val W₁ hW₁
            have hW₂' : IsOpen (Subtype.val '' W₂ : Set ↥Z₀) := U_x.isOpen.isOpenMap_subtype_val W₂ hW₂
            rcases hSW₁ with ⟨v₁, hv₁p, hv₁W⟩
            rcases hSW₂ with ⟨v₂, hv₂p, hv₂W⟩
            obtain ⟨y, hyp, ⟨a₁, ha₁W, rfl⟩, ⟨a₂, ha₂W, h_eq⟩⟩ :=
              (p i).isIrreducible'.isPreirreducible (Subtype.val '' W₁) (Subtype.val '' W₂)
                hW₁' hW₂' ⟨v₁.1, hv₁p, v₁, hv₁W, rfl⟩ ⟨v₂.1, hv₂p, v₂, hv₂W, rfl⟩
            have ha_eq : a₂ = a₁ := Subtype.ext h_eq
            exact ⟨a₁, hyp, ha₁W, ha_eq ▸ ha₂W⟩
          isClosed' := (p i).isClosed'.preimage continuous_subtype_val }
      have hStep_DU : ∀ i : Fin p.length, D_U i.castSucc < D_U i.succ := by
        intro i
        have hp_lt : p i.castSucc < p i.succ := p.step i
        have hle : D_U i.castSucc ≤ D_U i.succ := fun u hu => le_of_lt hp_lt hu
        have hnotle : ¬ (D_U i.succ ≤ D_U i.castSucc) := by
          intro hge
          have hUnion : (p i.succ : Set ↥Z₀) ⊆
              (p i.castSucc : Set ↥Z₀) ∪ (U_x : Set ↥Z₀)ᶜ := by
            intro y hy
            by_cases hyU : y ∈ U_x
            · left; exact hge (show ⟨y, hyU⟩ ∈ D_U i.succ from hy)
            · right; exact hyU
          have hx₀_succ : x₀ ∈ (p i.succ : Set ↥Z₀) := p.monotone (Fin.zero_le i.succ) hx₀_p0
          obtain ⟨y_c, hy_c, hy_l⟩ : ∃ y_c, y_c ∈ (p i.succ : Set ↥Z₀) ∧
              y_c ∉ (p i.castSucc : Set ↥Z₀) := SetLike.exists_of_lt hp_lt
          obtain ⟨z_c, hz_succ, hz_nl, hz_nr⟩ :=
            (p i.succ).isIrreducible'.isPreirreducible
              (p i.castSucc : Set ↥Z₀)ᶜ ((U_x : Set ↥Z₀)ᶜ)ᶜ
              (p i.castSucc).isClosed'.isOpen_compl
              U_x.isOpen.isClosed_compl.isOpen_compl
              ⟨y_c, hy_c, hy_l⟩
              ⟨x₀, hx₀_succ, fun hc => hc hx₀_U⟩
          rcases hUnion hz_succ with hl | hr
          · exact hz_nl hl
          · exact hz_nr hr
        exact lt_of_le_not_ge hle hnotle
      let q_U : LTSeries (TopologicalSpace.IrreducibleCloseds ↥U_x) :=
        { length := p.length, toFun := D_U, step := hStep_DU }
      have hq_le : (p.length : WithBot ℕ∞) ≤ topologicalKrullDim ↥U_x :=
        (Order.le_krullDim_iff (n := p.length)).mpr ⟨q_U, rfl⟩
      rw [hDim_Ux] at hq_le
      exact WithBot.coe_le_coe.mp hq_le
    
    have hDimUY : topologicalKrullDim ↥U_Y = (e_dim : WithBot ℕ∞) :=
      (IsHomeomorph.topologicalKrullDim_eq e_A e_A.isHomeomorph).trans
        ((PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim A).trans hDimA_eq)
    have hDimY_ge : (d : WithBot ℕ∞) ≤ topologicalKrullDim ↥Y := by
      have hm_le_e_wb : (m_dim : WithBot ℕ∞) ≤ (e_dim : WithBot ℕ∞) :=
        WithBot.coe_le_coe.mpr (ENat.natCast_le_natCast.mpr hm_le_e)
      have he_le_Y : (e_dim : WithBot ℕ∞) ≤ topologicalKrullDim ↥Y := by
        rw [← hDimUY]
        exact Topology.IsInducing.topologicalKrullDim_le
          U_Y.isOpen.isOpenEmbedding_subtypeVal.isInducing
      exact hDimZ₀_ge.trans (hDimZ₀_le.trans (hm_le_e_wb.trans he_le_Y))
    have hY_univ : Y = Set.univ := by
      by_contra hY_ne
      obtain ⟨l_Y, hlY_len⟩ := (Order.le_krullDim_iff (n := d)).mp hDimY_ge
      let P_pt : Fin (l_Y.length + 1) → TopologicalSpace.IrreducibleCloseds ↥P.left := fun i =>
        { carrier := Subtype.val '' (l_Y i : Set ↥Y)
          isIrreducible' := (l_Y i).isIrreducible'.image Subtype.val
            continuous_subtype_val.continuousOn
          isClosed' := hClosedY.isClosedMap_subtype_val _ (l_Y i).isClosed' }
      have hStep_P : ∀ i : Fin l_Y.length, P_pt i.castSucc < P_pt i.succ := by
        intro i
        have hl_lt : l_Y i.castSucc < l_Y i.succ := l_Y.step i
        have hle : P_pt i.castSucc ≤ P_pt i.succ := Set.image_mono (le_of_lt hl_lt)
        have hnotle : ¬ (P_pt i.succ ≤ P_pt i.castSucc) := by
          intro hge
          have hEq_img : Subtype.val '' (l_Y i.castSucc : Set ↥Y) =
              Subtype.val '' (l_Y i.succ : Set ↥Y) := le_antisymm hle hge
          have hEq_set : (l_Y i.castSucc : Set ↥Y) = (l_Y i.succ : Set ↥Y) :=
            (Set.image_eq_image Subtype.val_injective).mp hEq_img
          apply ne_of_lt hl_lt
          ext y
          exact Set.ext_iff.mp hEq_set y
        exact lt_of_le_not_ge hle hnotle
      let l_P : LTSeries (TopologicalSpace.IrreducibleCloseds ↥P.left) :=
        { length := l_Y.length, toFun := P_pt, step := hStep_P }
      let topP : TopologicalSpace.IrreducibleCloseds ↥P.left :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥P.left, isClosed_univ⟩
      have hLast_lt_top : RelSeries.last l_P < topP := by
        apply lt_of_le_of_ne (show RelSeries.last l_P ≤ topP from Set.subset_univ _)
        intro hEq
        apply hY_ne
        apply Set.eq_univ_of_univ_subset
        intro x _
        have hx_last : x ∈ ((RelSeries.last l_P : TopologicalSpace.IrreducibleCloseds ↥P.left) : Set ↥P.left) := by
          rw [hEq]
          trivial
        rcases hx_last with ⟨y, _, rfl⟩
        exact y.2
      let l_ext := l_P.snoc topP hLast_lt_top
      have hExt_len : l_ext.length = d + 1 := by
        change (l_P.snoc topP hLast_lt_top).length = d + 1
        rw [RelSeries.snoc_length]
        exact congrArg (· + 1) hlY_len
      have hd1_le : ((d + 1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥P.left :=
        (Order.le_krullDim_iff (n := d + 1)).mpr ⟨l_ext, hExt_len⟩
      rw [hDimP] at hd1_le
      have hd1_enat : ((d + 1 : ℕ) : ℕ∞) ≤ (d : ℕ∞) := WithBot.coe_le_coe.mp hd1_le
      have hd1_nat : d + 1 ≤ d := ENat.natCast_le_natCast.mp hd1_enat
      omega
    exact Set.eq_univ_of_univ_subset (hY_univ ▸ Set.image_mono hZ₀_sub)

theorem weil_smooth_proj_curve_picZero_divisible_and_torsion_finite (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    (hProjC : IsProjectiveOverField k C)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hRiemann :
      ∃ (deg_Cl : weilCurveClGroup C.left →+ ℤ)
        (P₀ : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) })
        (M : ℕ),
        (∀ D : ({ x : ↥C.left // IsClosed ({x} : Set ↥C.left) } →₀ ℤ),
          deg_Cl (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C.left) D) =
            D.sum (fun _ n => n)) ∧
        deg_Cl (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C.left) (Finsupp.single P₀ 1)) = 1 ∧
        ∀ c : weilCurveClGroup C.left, deg_Cl c = 0 →
          ∃ Q : Fin M → { x : ↥C.left // IsClosed ({x} : Set ↥C.left) },
            QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C.left)
              ((Finset.univ.sum fun j : Fin M => Finsupp.single (Q j) (1 : ℤ)) -
                Finsupp.single P₀ (M : ℤ)) = c) :
    Finite { c : weilCurveClGroup C.left // ℓ • c = 0 } ∧
    Nat.card (weilCurveClGroup C.left ⧸
      (zsmulAddGroupHom (ℓ : ℤ) : weilCurveClGroup C.left →+ weilCurveClGroup C.left).range) = ℓ :=
by
  classical
  rcases hRiemann with ⟨deg_Cl, P₀, M, hdeg, hP₀, hSurjM⟩
  let Pt := { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }
  let Cl := weilCurveClGroup C.left
  let mkCl : (Pt →₀ ℤ) →+ Cl := QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C.left)
  let e₀ : Cl := mkCl (Finsupp.single P₀ 1)
  have he₀ : deg_Cl e₀ = 1 := hP₀
  have hPrime : Nat.Prime ℓ := Fact.out
  haveI : NeZero ℓ := ⟨hPrime.ne_zero⟩
  have hℓ_int_ne : (ℓ : ℤ) ≠ 0 := Int.natCast_ne_zero.mpr hPrime.ne_zero
  have hDeg0 : ∀ D ∈ weilCurvePrincipalSubgroup C.left, D.sum (fun _ n => n) = 0 := by
    intro D hD
    rw [← hdeg D]
    have hmk0 : mkCl D = 0 := (QuotientAddGroup.eq_zero_iff D).mpr hD
    change deg_Cl (mkCl D) = 0
    rw [hmk0, map_zero]
  let Φ : ∀ (d : ℕ), (Fin d → Pt) → Cl :=
    fun d Q => mkCl (weilCurveDivSum C.left Q - Finsupp.single P₀ (d : ℤ))
  let SurjAt : ℕ → Prop := fun d => ∀ c : Cl, deg_Cl c = 0 → ∃ Q : Fin d → Pt, Φ d Q = c
  have hSurjAt_M : SurjAt M := hSurjM
  have hex_d : ∃ d : ℕ, SurjAt d := ⟨M, hSurjAt_M⟩
  let d₀ : ℕ := Nat.find hex_d
  have hSurj_d₀ : SurjAt d₀ := Nat.find_spec hex_d
  have hMin_d₀ : ∀ m < d₀, ¬ SurjAt m := fun m hm => Nat.find_min hex_d hm
  suffices hZeroPkg :
      (∀ c : Cl, deg_Cl c = 0 → ∃ c' : Cl, ℓ • c' = c) ∧
      Finite { c : Cl // deg_Cl c = 0 ∧ ℓ • c = 0 } by
    rcases hZeroPkg with ⟨H_div, H_fin⟩
    haveI : Finite { c : Cl // deg_Cl c = 0 ∧ ℓ • c = 0 } := H_fin
    constructor
    · let incl : { c : Cl // ℓ • c = 0 } → { c : Cl // deg_Cl c = 0 ∧ ℓ • c = 0 } :=
        fun x => ⟨x.1, by
          have h1 : deg_Cl (ℓ • x.1) = 0 := by rw [x.2, map_zero]
          rw [map_nsmul, nsmul_eq_mul] at h1
          exact (mul_eq_zero.mp h1).resolve_left hℓ_int_ne, x.2⟩
      exact Finite.of_injective incl (fun x₁ x₂ h =>
        Subtype.ext (by simpa [incl] using congrArg Subtype.val h))
    · let π_mod : Cl →+ ZMod ℓ := (Int.castAddHom (ZMod ℓ)).comp deg_Cl
      have hπ_surj : Function.Surjective π_mod := by
        intro z
        refine ⟨(z.val : ℤ) • e₀, ?_⟩
        simp [π_mod, he₀, zsmul_eq_mul, ZMod.natCast_zmod_val]
      have hker : π_mod.ker =
          (zsmulAddGroupHom (ℓ : ℤ) :
            weilCurveClGroup C.left →+ weilCurveClGroup C.left).range := by
        ext c
        simp only [AddMonoidHom.mem_ker, π_mod, AddMonoidHom.comp_apply, Int.coe_castAddHom,
          AddMonoidHom.mem_range, zsmulAddGroupHom_apply]
        constructor
        · intro hc
          obtain ⟨q, hq⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd (deg_Cl c) ℓ).mp hc
          let c₀ : Cl := c - ((ℓ : ℤ) * q) • e₀
          have hc₀ : deg_Cl c₀ = 0 := by
            simp [c₀, he₀, zsmul_eq_mul, hq]
          obtain ⟨c', hc'⟩ := H_div c₀ hc₀
          refine ⟨c' + q • e₀, ?_⟩
          rw [zsmul_add, ← mul_zsmul, natCast_zsmul, hc']
          dsimp [c₀]
          abel
        · rintro ⟨d, rfl⟩
          have h1 : π_mod ((ℓ : ℤ) • d) = (ℓ : ℤ) • π_mod d := map_zsmul π_mod (ℓ : ℤ) d
          change π_mod ((ℓ : ℤ) • d) = 0
          rw [h1, zsmul_eq_mul, Int.cast_natCast, CharP.cast_eq_zero, zero_mul]
      rw [← hker, Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective π_mod hπ_surj).toEquiv]
      exact Nat.card_zmod ℓ
  by_cases hd₀_zero : d₀ = 0
  · have hSurj0 : SurjAt 0 := hd₀_zero ▸ hSurj_d₀
    have hCl0_zero : ∀ c : Cl, deg_Cl c = 0 → c = 0 := by
      intro c hc
      obtain ⟨Q, hQ⟩ := hSurj0 c hc
      rw [← hQ]
      simp [Φ, weilCurveDivSum]
    constructor
    · intro c hc
      refine ⟨0, ?_⟩
      rw [nsmul_zero, hCl0_zero c hc]
    · have : Subsingleton { c : Cl // deg_Cl c = 0 ∧ ℓ • c = 0 } :=
        ⟨fun a b => Subtype.ext ((hCl0_zero a.1 a.2.1).trans (hCl0_zero b.1 b.2.1).symm)⟩
      exact Finite.of_subsingleton
  · have hd₀ : 1 ≤ d₀ := Nat.one_le_iff_ne_zero.mpr hd₀_zero
    have hSum_single : ∀ (x : Pt) (m : ℤ), (Finsupp.single x m).sum (fun _ n => n) = m :=
      fun _ _ => Finsupp.sum_single_index rfl
    have hSum_sub : ∀ (D₁ D₂ : Pt →₀ ℤ),
        (D₁ - D₂).sum (fun _ n => n) = D₁.sum (fun _ n => n) - D₂.sum (fun _ n => n) := by
      intro D₁ D₂
      rw [← hdeg, ← hdeg, ← hdeg]
      exact map_sub (deg_Cl.comp mkCl) D₁ D₂
    have hDeg_divSum : ∀ {d : ℕ} (Q : Fin d → Pt),
        deg_Cl (mkCl (weilCurveDivSum C.left Q)) = (d : ℤ) := by
      intro d Q
      dsimp [weilCurveDivSum]
      rw [map_sum, map_sum]
      have h1 : ∀ j : Fin d, deg_Cl (mkCl (Finsupp.single (Q j) (1 : ℤ))) = 1 := by
        intro j
        rw [hdeg, hSum_single]
      simp [h1]
    have hSum_divSum : ∀ {d : ℕ} (Q : Fin d → Pt),
        (weilCurveDivSum C.left Q).sum (fun _ n => n) = (d : ℤ) := by
      intro d Q
      rw [← hdeg, hDeg_divSum]
    have hDeg_Φ : ∀ {d : ℕ} (Q : Fin d → Pt), deg_Cl (Φ d Q) = 0 := by
      intro d Q
      dsimp [Φ]
      rw [map_sub, map_sub, hDeg_divSum, hdeg, hSum_single, sub_self]
    have hEff_divSum : ∀ {d : ℕ} (Q : Fin d → Pt) (x : Pt), 0 ≤ weilCurveDivSum C.left Q x := by
      intro d Q x
      dsimp [weilCurveDivSum]
      rw [Finsupp.finsetSum_apply]
      refine Finset.sum_nonneg fun j _ => ?_
      simp only [Finsupp.single_apply]
      split_ifs <;> omega
    have hSub_of_mkCl_eq : ∀ (D₁ D₂ : Pt →₀ ℤ),
        mkCl D₁ = mkCl D₂ →
        weilCurveEffSubsingleton C.left D₁ →
        weilCurveEffSubsingleton C.left D₂ := by
      intro D₁ D₂ hEq hSub₁
