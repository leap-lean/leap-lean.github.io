    let e_sm := CategoryTheory.equivSmallModel.{u} Y₂.AffineEtale
    let ι₂ : CategoryTheory.Functor Y₂.AffineEtale Y₂.Etale :=
      AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂
    let G₂ : CategoryTheory.Functor (CategoryTheory.SmallModel.{u} Y₂.AffineEtale) Y₂.Etale :=
      e_sm.inverse ⋙ ι₂
    have _ : ι₂.Full := inferInstance
    have _ : ι₂.Faithful := inferInstance
    have _ : G₂.Full := CategoryTheory.Functor.Full.comp e_sm.inverse ι₂
    have _ : G₂.Faithful := CategoryTheory.Functor.Faithful.comp e_sm.inverse ι₂
    have h_cd : G₂.IsCoverDense Y₂.smallEtaleTopology := by
      constructor
      intro U
      rw [h_mem_etale]
      intro x
      obtain ⟨W, hW_aff, hxW, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := (⊤ : U.left.Opens)) trivial
      have _ : AlgebraicGeometry.IsAffine W.toScheme := hW_aff
      let R_W : CommRingCat.{u} := W.toScheme.presheaf.obj (Opposite.op ⊤)
      let j_W : AlgebraicGeometry.Spec R_W ⟶ U.left := W.toScheme.isoSpec.inv ≫ W.ι
