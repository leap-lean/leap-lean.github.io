            exact h1.trans (congrArg (fun φ : A₀ →ₐ[k] k => φ a) hev_star_comp)
          have hΦ₂_fst : ∀ a : A₀, (Φ₂ a).fst = ev₀_hom a := by
            intro a
            change (TrivSqZeroExt.inl (ev_star_A (ι_A a))).fst = ev₀_hom a
            rw [TrivSqZeroExt.fst_inl]
            exact congrArg (fun φ : A₀ →ₐ[k] k => φ a) hev_star_comp
          have hΦ_eq_zt : ∀ j : Fin d, Φ₁ (q_coord j (z_tilde j)) = Φ₂ (q_coord j (z_tilde j)) := by
            intro j
            rw [hDualEq (Φ₁ (q_coord j (z_tilde j))), hDualEq (Φ₂ (q_coord j (z_tilde j))),
              hΦ₁_fst, hΦ₂_fst]
            have hsnd1 : (Φ₁ (q_coord j (z_tilde j))).snd = 0 := hc_zero j
            have hsnd2 : (Φ₂ (q_coord j (z_tilde j))).snd = 0 := rfl
            rw [hsnd1, hsnd2]
          have hΦ_eq_zet : ∀ j : Fin d, Φ₁ (q_coord j (z_et j)) = Φ₂ (q_coord j (z_et j)) := by
            intro j
            have hdiff_mem : q_coord j (z_tilde j - z_et j) ∈ (RingHom.ker ev₀_hom) ^ 2 := by
              have hker_le : Ideal.map (q_coord j)
                  ((hAff_U₀.primeIdealOf ⟨(Q₀ j).1, hQ₀_in j⟩).asIdeal) ≤
                  RingHom.ker ev₀_hom := by
                rw [Ideal.map_le_iff_le_comap]
                intro b hb
                have hkj := (hev₀_coord j).choose_spec
                have hmem : b ∈ RingHom.ker (ev₀_hom.comp (q_coord j)) := by
                  rwa [hkj]
                exact hmem
              have hsq_le : Ideal.map (q_coord j)
                  (((hAff_U₀.primeIdealOf ⟨(Q₀ j).1, hQ₀_in j⟩).asIdeal) ^ 2) ≤
                  (RingHom.ker ev₀_hom) ^ 2 := by
                rw [Ideal.map_pow]
                exact pow_le_pow_left' hker_le 2
              exact hsq_le (Ideal.mem_map_of_mem (q_coord j) (hzt_sq j))
            have hΦ₁_diff : Φ₁ (q_coord j (z_tilde j)) - Φ₁ (q_coord j (z_et j)) = 0 := by
              rw [← map_sub, ← map_sub]; exact hDualKerSq ev₀_hom Φ₁ hΦ₁_fst _ hdiff_mem
            have hΦ₂_diff : Φ₂ (q_coord j (z_tilde j)) - Φ₂ (q_coord j (z_et j)) = 0 := by
              rw [← map_sub, ← map_sub]; exact hDualKerSq ev₀_hom Φ₂ hΦ₂_fst _ hdiff_mem
            rw [← sub_eq_zero.mp hΦ₁_diff, ← sub_eq_zero.mp hΦ₂_diff, hΦ_eq_zt j]
          have hΦ₁₂ : Φ₁ = Φ₂ :=
            hDualV₁ ⟨z_ref, hz_ref_in⟩ Q₀ ev₀_hom g_et z_et Φ₁ Φ₂
              hz₀_match hev₀_id hev₀_ker
              (fun j => ⟨hg_et j, hz_et j⟩)
              (RingHom.ext fun c => (ψ_ε.comp ι_A).commutes c)
              (RingHom.ext fun c =>
                (((TrivSqZeroExt.inlAlgHom k k k).comp ev_star_A).comp ι_A).commutes c)
              (fun a => ⟨hΦ₁_fst a, hΦ₂_fst a⟩)
              hΦ_eq_zet
          have hψ_hom : ψ_ε.toRingHom =
              ((TrivSqZeroExt.inlAlgHom k k k).comp ev_star_A).toRingHom :=
            IsLocalization.ringHom_ext (Submonoid.powers a_loc) hΦ₁₂
          apply AlgHom.ext
          intro x_A
          exact congrArg (fun φ : A →+* DualNumber k => φ x_A) hψ_hom
        
        obtain ⟨s_iso, hs_iso_ne, hs_iso_iff⟩ :=
          hNakIso A I_det ev_star_A hIdet_le hDualRigid
        obtain ⟨⟨num_iso, ⟨_, k_iso, rfl⟩⟩, hsec_iso⟩ :=
          IsLocalization.surj (Submonoid.powers a_loc) s_iso
        dsimp only at hsec_iso
        let W : Set ↥P_d.left := (P_d.left.basicOpen (a_loc * num_iso) : Set ↥P_d.left)
        have hz_in_W : z_ref ∈ W :=
          (hBasicOpenAwayIff hV₁ a_loc s_iso num_iso k_iso hsec_iso
            ⟨z_ref, hz_ref_in⟩ ev₀_hom hev₀_ker).mpr ⟨ha_loc, hs_iso_ne⟩
        refine ⟨W, (P_d.left.basicOpen _).isOpen, hz_in_W, ?_⟩
        ext y
        simp only [Set.mem_inter_iff, Set.mem_compl_iff, Set.mem_singleton_iff]
        constructor
        · rintro ⟨hy_not_O, hy_W⟩
          have hy_V₁ : y ∈ V₁ := P_d.left.basicOpen_le (a_loc * num_iso) hy_W
          let 𝔭₀ : PrimeSpectrum A₀ := hV₁.primeIdealOf ⟨y, hy_V₁⟩
          have ha_num_not : a_loc * num_iso ∉ 𝔭₀.asIdeal :=
            (hMemBasicOpen hV₁ (a_loc * num_iso) ⟨y, hy_V₁⟩).mp hy_W
          have ha_not : a_loc ∉ 𝔭₀.asIdeal :=
            fun hm => ha_num_not (Ideal.mul_mem_right _ _ hm)
          have hnum_not : num_iso ∉ 𝔭₀.asIdeal :=
            fun hm => ha_num_not (Ideal.mul_mem_left _ _ hm)
          have hDisj : Disjoint (Submonoid.powers a_loc : Set A₀) (𝔭₀.asIdeal : Set A₀) := by
            rw [Set.disjoint_left]
            rintro _ ⟨m, rfl⟩ hm_in
            exact ha_not (𝔭₀.isPrime.mem_of_pow_mem m hm_in)
          let 𝔭_A_id : Ideal A := Ideal.map (algebraMap A₀ A) 𝔭₀.asIdeal
          have h𝔭_A_prime : 𝔭_A_id.IsPrime :=
            IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers a_loc) A
              𝔭₀.asIdeal 𝔭₀.isPrime hDisj
          have h𝔭_comap : Ideal.comap (algebraMap A₀ A) 𝔭_A_id = 𝔭₀.asIdeal :=
            IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers a_loc) A
              𝔭₀.isPrime hDisj
          have hs_not_𝔭A : s_iso ∉ 𝔭_A_id := by
            intro hs_in
            have hnum_in_A : algebraMap A₀ A num_iso ∈ 𝔭_A_id := by
              rw [← hsec_iso]; exact Ideal.mul_mem_right _ 𝔭_A_id hs_in
            have hnum_in_0 : num_iso ∈ Ideal.comap (algebraMap A₀ A) 𝔭_A_id := hnum_in_A
            rw [h𝔭_comap] at hnum_in_0
            exact hnum_not hnum_in_0
          have hIdet_𝔭A : I_det ≤ 𝔭_A_id := by
            rw [Ideal.span_le]
            rintro _ ⟨ρ, rfl⟩
            have hy_not_ρ : y ∉ P_d.left.basicOpen (a_loc * num_det ρ) := by
              intro hmem; apply hy_not_O
              simp only [O_loc, Set.mem_iUnion]; exact ⟨ρ, hmem⟩
            have hprod_in : a_loc * num_det ρ ∈ 𝔭₀.asIdeal := by
              by_contra hnot
              exact hy_not_ρ ((hMemBasicOpen hV₁ _ ⟨y, hy_V₁⟩).mpr hnot)
            have hnum_ρ_in : num_det ρ ∈ 𝔭₀.asIdeal :=
              (𝔭₀.isPrime.mem_or_mem hprod_in).resolve_left ha_not
            have hdet_mul_in : (Θ_A.submatrix ρ id).det *
                algebraMap A₀ A (a_loc ^ k_det ρ) ∈ 𝔭_A_id := by
              rw [hsec_det ρ]; exact Ideal.mem_map_of_mem (algebraMap A₀ A) hnum_ρ_in
            have hpow_not : algebraMap A₀ A (a_loc ^ k_det ρ) ∉ 𝔭_A_id := by
              intro hp
              have hp0 : a_loc ^ k_det ρ ∈ 𝔭₀.asIdeal := by
                rw [← h𝔭_comap]; exact hp
              exact ha_not (𝔭₀.isPrime.mem_of_pow_mem _ hp0)
            exact (h𝔭_A_prime.mem_or_mem hdet_mul_in).resolve_right hpow_not
          have h𝔭A_eq : 𝔭_A_id = RingHom.ker ev_star_A.toRingHom :=
            (hs_iso_iff ⟨𝔭_A_id, h𝔭_A_prime⟩).mp ⟨hIdet_𝔭A, hs_not_𝔭A⟩
          have h𝔭₀_eq : 𝔭₀ = hV₁.primeIdealOf ⟨z_ref, hz_ref_in⟩ := by
            apply PrimeSpectrum.ext
            rw [← h𝔭_comap, h𝔭A_eq, ← hev₀_ker]
            ext a
            simp only [Ideal.mem_comap, RingHom.mem_ker]
            change ev_star_A (ι_A a) = 0 ↔ ev₀_hom a = 0
            have hea : ev_star_A (ι_A a) = ev₀_hom a :=
              congrArg (fun φ : A₀ →ₐ[k] k => φ a) hev_star_comp
            rw [hea]
          have hy_eq := congrArg hV₁.fromSpec.base h𝔭₀_eq
          rwa [hV₁.fromSpec_primeIdealOf, hV₁.fromSpec_primeIdealOf] at hy_eq
        · rintro rfl
          exact ⟨hz₀_not_O, hz_in_W⟩
    choose O_loc hOpen_O hSound_O hComp_O hIso_O using hLocal3
    let U_open : Set ↥P_d.left := ⋃ p₀ : Idx3, O_loc p₀
    let F_R : Set ↥P_d.left := U_openᶜ
    refine ⟨F_R, (isOpen_iUnion hOpen_O).isClosed_compl, ?_, ?_⟩
    · intro z Q hz_match
      dsimp [F_R, U_open]
      rw [Set.mem_compl_iff]
      simp only [Set.mem_iUnion, not_exists]
      constructor
      · intro hall
        by_contra hNotRel
        exact hall ⟨(z, Q), hz_match⟩ (hComp_O ⟨(z, Q), hz_match⟩ hNotRel)
      · intro hRel p₀ hz_in
        exact hSound_O p₀ z Q hz_match hz_in hRel
    · intro z_star Q_star hz_match hz_FR hDist hEffSub
      let p_star : Idx3 := ⟨(z_star, Q_star), hz_match⟩
      have hz_not_O : z_star ∉ O_loc p_star := by
        intro h_in
        exact hz_FR (Set.mem_iUnion.mpr ⟨p_star, h_in⟩)
      obtain ⟨W, hOpen_W, hz_W, hIso_loc⟩ :=
        hIso_O p_star hz_not_O hDist hEffSub
      refine ⟨W, hOpen_W, hz_W, ?_⟩
      apply Set.Subset.antisymm
      · intro y ⟨hy_FR, hy_W⟩
        have hy_not_O : y ∉ O_loc p_star :=
          fun h_in => hy_FR (Set.mem_iUnion.mpr ⟨p_star, h_in⟩)
        have : y ∈ (O_loc p_star)ᶜ ∩ W := ⟨hy_not_O, hy_W⟩
        rwa [hIso_loc] at this
      · rintro y rfl
        exact ⟨hz_FR, hz_W⟩

theorem weil_proper_correspondence_surj_of_isolated_fiber_and_discrete_finite (k : Type u) [Field k] [IsAlgClosed k]
    (P : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral P.left] [AlgebraicGeometry.IsProper P.hom]
    (d : ℕ) (hd : 1 ≤ d)
    (hDimP : topologicalKrullDim P.left = (d : WithBot ℕ∞)) :
    (∀ (S : Set ↥P.left),
      (∀ x ∈ S, ∃ W : Set ↥P.left, IsOpen W ∧ x ∈ W ∧ S ∩ W = {x}) →
      Finite ↥S) ∧
    (∀ (Z : Set ↥(CategoryTheory.Limits.pullback P.hom P.hom)) (U : Set ↥P.left),
      IsClosed Z →
      IsOpen U → U.Nonempty →
      (CategoryTheory.Limits.pullback.fst P.hom P.hom).base '' Z = Set.univ →
      (∀ (w : ↥(CategoryTheory.Limits.pullback P.hom P.hom)),
        w ∈ Z →
        IsClosed ({w} : Set ↥(CategoryTheory.Limits.pullback P.hom P.hom)) →
        (CategoryTheory.Limits.pullback.fst P.hom P.hom).base w ∈ U →
        ∃ W : Set ↥(CategoryTheory.Limits.pullback P.hom P.hom), IsOpen W ∧ w ∈ W ∧
          (Z ∩ (CategoryTheory.Limits.pullback.snd P.hom P.hom).base ⁻¹'
            {(CategoryTheory.Limits.pullback.snd P.hom P.hom).base w}) ∩ W = {w}) →
      (CategoryTheory.Limits.pullback.snd P.hom P.hom).base '' Z = Set.univ) :=
by
  classical
  let _ := hd
  let B_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  have : CompactSpace ↥B_k := inferInstance
  have : AlgebraicGeometry.IsNoetherian B_k := inferInstance
  have : JacobsonSpace ↥B_k := inferInstance
  have : AlgebraicGeometry.IsLocallyNoetherian P.left :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian P.hom
  have : CompactSpace ↥P.left :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace P.hom
  have : AlgebraicGeometry.IsNoetherian P.left := {}
  have : TopologicalSpace.NoetherianSpace ↥P.left :=
    AlgebraicGeometry.IsNoetherian.noetherianSpace (X := P.left)
  have : IrreducibleSpace ↥P.left :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral P.left
  refine ⟨?_, ?_⟩
  · intro S hS
    have : TopologicalSpace.NoetherianSpace ↥S := TopologicalSpace.NoetherianSpace.set S
    have : CompactSpace ↥S := TopologicalSpace.NoetherianSpace.compactSpace ↥S
    have : DiscreteTopology ↥S := by
      rw [discreteTopology_iff_isOpen_singleton]
      intro a
      obtain ⟨W, hOpenW, haW, hSW⟩ := hS a.1 a.2
      have hEq : ({a} : Set ↥S) = Subtype.val ⁻¹' W := by
        ext b
        simp only [Set.mem_singleton_iff, Set.mem_preimage]
        constructor
        · rintro rfl; exact haW
        · intro hbW
          apply Subtype.ext
          have hbSW : b.1 ∈ S ∩ W := ⟨b.2, hbW⟩
          rwa [hSW, Set.mem_singleton_iff] at hbSW
      rw [hEq]
      exact hOpenW.preimage continuous_subtype_val
    exact finite_of_compact_of_discrete
  · intro Z U hClosedZ hOpenU hNeU hFstSurj hIso
    
    have hFinUnionIrr : ∀ {α ι : Type u} [TopologicalSpace α] {C : Set α}
        (hC : IsIrreducible C) (F : Finset ι) (g_set : ι → Set α),
        (∀ i ∈ F, IsClosed (g_set i)) →
        C ⊆ (⋃ i ∈ F, g_set i) →
        ∃ i ∈ F, C ⊆ g_set i := by
      intro α ι _ C hC F g_set
      induction F using Finset.induction_on with
      | empty =>
        intro _ hSub
        obtain ⟨x, hx⟩ := hC.nonempty
        have hx' := hSub hx
        simp at hx'
      | @insert i₀ F' _ ih =>
        intro hCl hSub
        by_cases h0 : C ⊆ g_set i₀
        · exact ⟨i₀, Finset.mem_insert_self i₀ F', h0⟩
        · have hRest : C ⊆ ⋃ i ∈ F', g_set i := by
            intro x hx
            by_contra hx_not
            obtain ⟨x₀, hx₀C, hx₀_not⟩ : ∃ x₀, x₀ ∈ C ∧ x₀ ∉ g_set i₀ := by
              by_contra hall
              apply h0
              intro y hy
              by_contra hy_not
              exact hall ⟨y, hy, hy_not⟩
            have hCl0 : IsClosed (g_set i₀) := hCl i₀ (Finset.mem_insert_self i₀ F')
            have hClF' : IsClosed (⋃ i ∈ F', g_set i) :=
              F'.finite_toSet.isClosed_biUnion (fun i hi =>
                hCl i (Finset.mem_insert_of_mem (Finset.mem_coe.mp hi)))
            obtain ⟨z, hzC, hz0, hzF'⟩ :=
              hC.isPreirreducible (g_set i₀)ᶜ (⋃ i ∈ F', g_set i)ᶜ
                hCl0.isOpen_compl hClF'.isOpen_compl ⟨x₀, hx₀C, hx₀_not⟩ ⟨x, hx, hx_not⟩
            have hz_in := hSub hzC
            simp only [Set.mem_iUnion, Finset.mem_insert] at hz_in
            rcases hz_in with ⟨i, rfl | hiF', hzi⟩
            · exact hz0 hzi
            · exact hzF' (Set.mem_biUnion hiF' hzi)
          obtain ⟨i, hi, hCi⟩ :=
            ih (fun j hj => hCl j (Finset.mem_insert_of_mem hj)) hRest
          exact ⟨i, Finset.mem_insert_of_mem hi, hCi⟩
    
    let Q := CategoryTheory.Limits.pullback P.hom P.hom
    let fst := CategoryTheory.Limits.pullback.fst P.hom P.hom
    let snd := CategoryTheory.Limits.pullback.snd P.hom P.hom
    let fQ : Q ⟶ B_k := fst ≫ P.hom
    have : AlgebraicGeometry.IsProper fst := inferInstance
    have : AlgebraicGeometry.IsProper snd := inferInstance
    have : AlgebraicGeometry.IsProper fQ := inferInstance
    have : AlgebraicGeometry.LocallyOfFiniteType P.hom := inferInstance
    have : AlgebraicGeometry.LocallyOfFiniteType fQ := inferInstance
    have : AlgebraicGeometry.IsLocallyNoetherian Q :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian fQ
    have : CompactSpace ↥Q :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace fQ
    have : AlgebraicGeometry.IsNoetherian Q := {}
    have : TopologicalSpace.NoetherianSpace ↥Q :=
      AlgebraicGeometry.IsNoetherian.noetherianSpace (X := Q)
    have : JacobsonSpace ↥Q :=
      AlgebraicGeometry.LocallyOfFiniteType.jacobsonSpace fQ
    
    obtain ⟨S_comp, hFin_comp, hCl_comp, hIrr_comp, hZ_eq⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hClosedZ
    have hUniv_sub : (Set.univ : Set ↥P.left) ⊆
        ⋃ K ∈ hFin_comp.toFinset, fst.base '' K := by
      intro y _
      have hy : y ∈ fst.base '' Z := by rw [hFstSurj]; trivial
      rcases hy with ⟨w, hwZ, rfl⟩
      rw [hZ_eq, Set.mem_sUnion] at hwZ
      rcases hwZ with ⟨K, hK_mem, hwK⟩
      exact Set.mem_biUnion (hFin_comp.mem_toFinset.mpr hK_mem) ⟨w, hwK, rfl⟩
    obtain ⟨Z₀, hZ₀_fin, hUniv_Z₀⟩ :=
      hFinUnionIrr (IrreducibleSpace.isIrreducible_univ ↥P.left) hFin_comp.toFinset
        (fun K => fst.base '' K)
        (fun K hK => fst.isClosedMap K (hCl_comp K (hFin_comp.mem_toFinset.mp hK)))
        hUniv_sub
    have hZ₀_mem : Z₀ ∈ S_comp := hFin_comp.mem_toFinset.mp hZ₀_fin
    have hZ₀_sub : Z₀ ⊆ Z := hZ_eq ▸ Set.subset_sUnion_of_mem hZ₀_mem
    have hClosedZ₀ : IsClosed Z₀ := hCl_comp Z₀ hZ₀_mem
    have hIrredZ₀ : IsIrreducible Z₀ := hIrr_comp Z₀ hZ₀_mem
    have hFstZ₀ : fst.base '' Z₀ = Set.univ := Set.eq_univ_of_univ_subset hUniv_Z₀
    have : IrreducibleSpace ↥Z₀ := Subtype.irreducibleSpace hIrredZ₀
    have : TopologicalSpace.NoetherianSpace ↥Z₀ := TopologicalSpace.NoetherianSpace.set Z₀
    let f₀ : ↥Z₀ → ↥P.left := fun z => fst.base z.1
    have hf₀_cont : Continuous f₀ := fst.continuous.comp continuous_subtype_val
    have hf₀_closed : IsClosedMap f₀ := fst.isClosedMap.comp hClosedZ₀.isClosedMap_subtype_val
    have hSingleLift : ∀ (K : Set ↥Z₀) (C : TopologicalSpace.IrreducibleCloseds ↥P.left),
        IsClosed K → (C : Set ↥P.left) ⊆ f₀ '' K →
        ∃ K' : TopologicalSpace.IrreducibleCloseds ↥Z₀,
          (K' : Set ↥Z₀) ⊆ K ∧ f₀ '' (K' : Set ↥Z₀) = (C : Set ↥P.left) := by
      intro K C hClosedK hC_sub
      let L : Set ↥Z₀ := K ∩ f₀ ⁻¹' (C : Set ↥P.left)
      have hClosedL : IsClosed L := hClosedK.inter (C.isClosed'.preimage hf₀_cont)
      have hf₀L : f₀ '' L = (C : Set ↥P.left) := by
        apply Set.Subset.antisymm
        · rintro _ ⟨z, ⟨_, hzC⟩, rfl⟩; exact hzC
        · intro y hyC
          rcases hC_sub hyC with ⟨z, hzK, rfl⟩
          exact ⟨z, ⟨hzK, hyC⟩, rfl⟩
      obtain ⟨F_L, hFinL, hClL, hIrrL, hL_eq⟩ :=
        TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hClosedL
      have hC_cov : (C : Set ↥P.left) ⊆ ⋃ M ∈ hFinL.toFinset, f₀ '' M := by
        intro y hyC
        rw [← hf₀L] at hyC
        rcases hyC with ⟨z, hzL, rfl⟩
        rw [hL_eq, Set.mem_sUnion] at hzL
        rcases hzL with ⟨M, hM_mem, hzM⟩
        exact Set.mem_biUnion (hFinL.mem_toFinset.mpr hM_mem) ⟨z, hzM, rfl⟩
      obtain ⟨M, hM_fin, hC_subM⟩ :=
        hFinUnionIrr C.isIrreducible' hFinL.toFinset (fun M => f₀ '' M)
          (fun M hM => hf₀_closed M (hClL M (hFinL.mem_toFinset.mp hM))) hC_cov
      have hM_mem : M ∈ F_L := hFinL.mem_toFinset.mp hM_fin
      have hM_subL : M ⊆ L := hL_eq ▸ Set.subset_sUnion_of_mem hM_mem
      refine ⟨⟨M, hIrrL M hM_mem, hClL M hM_mem⟩, hM_subL.trans Set.inter_subset_left, ?_⟩
      exact Set.Subset.antisymm ((Set.image_mono hM_subL).trans (le_of_eq hf₀L)) hC_subM
    have hDimZ₀_ge : (d : WithBot ℕ∞) ≤ topologicalKrullDim ↥Z₀ := by
      have hd_le_P : (d : WithBot ℕ∞) ≤ topologicalKrullDim ↥P.left := le_of_eq hDimP.symm
      obtain ⟨p, hp_len⟩ := (Order.le_krullDim_iff (n := d)).mp hd_le_P
      have hChainLift : ∀ (r : ℕ) (hr : r ≤ p.length),
          ∃ q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Z₀),
            q.length = r ∧
