        let q₃ := CategoryTheory.Limits.pullback.fst U_S₂.hom f₂
        let q₄ := CategoryTheory.Limits.pullback.fst U_S₁.hom eS.inv
        let q₅ := CategoryTheory.Limits.pullback.fst U.hom eS.hom
        change (q₁ ≫ q₂) ≫ (q₃ ≫ (q₄ ≫ q₅)) = q₁ ≫ ((q₂ ≫ (q₃ ≫ q₄)) ≫ q₅)
        exact (CategoryTheory.Category.assoc q₁ q₂ _).trans
          (congrArg (q₁ ≫ ·)
            ((congrArg (q₂ ≫ ·) (CategoryTheory.Category.assoc q₃ q₄ q₅).symm).trans
              (CategoryTheory.Category.assoc q₂ (q₃ ≫ q₄) q₅).symm))
      have hs₃ : m₃ ≫ (m₂ ≫ (m₁ ≫ P₀)) =
          (CategoryTheory.Limits.pullback.fst ((B_site f₁).obj U_S₁).hom g'₁ ≫
              CategoryTheory.Limits.pullback.fst U_S₁.hom f₁) ≫
            CategoryTheory.Limits.pullback.fst U.hom eS.hom := by
        refine (congrArg (m₃ ≫ ·) hs₂).trans ?_
        refine (CategoryTheory.Category.assoc m₃ _ _).symm.trans ?_
        refine (congrArg (· ≫ _) (h_map_fst g'₁ (e_B_f₁.hom.app U_S₁))).trans ?_
        let r₁ := CategoryTheory.Limits.pullback.fst ((B_site f₁).obj U_S₁).hom g'₁
        let r₂ := (e_B_f₁.hom.app U_S₁).left
        let r₃ := CategoryTheory.Limits.pullback.fst U_X₂.hom eX.hom ≫
          CategoryTheory.Limits.pullback.fst U_S₂.hom f₂ ≫
          CategoryTheory.Limits.pullback.fst U_S₁.hom eS.inv
        let r₄ := CategoryTheory.Limits.pullback.fst U.hom eS.hom
        exact (CategoryTheory.Category.assoc r₁ r₂ (r₃ ≫ r₄)).trans
          ((congrArg (r₁ ≫ ·)
              ((CategoryTheory.Category.assoc r₂ r₃ r₄).symm.trans
                (congrArg (· ≫ r₄) (h_eBf₁_fst U_S₁)))).trans
            (CategoryTheory.Category.assoc r₁ _ r₄).symm)
      have hs₄ : m₄ ≫ (m₃ ≫ (m₂ ≫ (m₁ ≫ P₀))) =
          CategoryTheory.Limits.pullback.fst ((B_site g₁).obj U_S₁).hom f' ≫
            (CategoryTheory.Limits.pullback.fst U_S₁.hom g₁ ≫
              CategoryTheory.Limits.pullback.fst U.hom eS.hom) := by
        refine (congrArg (m₄ ≫ ·) hs₃).trans ?_
        refine (CategoryTheory.Category.assoc m₄ _ _).symm.trans ?_
        exact (congrArg (· ≫ _) (h_efun_inv_fst g'₁ f₁ f' g₁ hpb₁.w U_S₁)).trans
          (CategoryTheory.Category.assoc _ _ _)
      have hs₅ : m₅ ≫ (m₄ ≫ (m₃ ≫ (m₂ ≫ (m₁ ≫ P₀)))) =
          CategoryTheory.Limits.pullback.fst ((B_site g₂).obj U).hom f' ≫
            CategoryTheory.Limits.pullback.fst U.hom g₂ := by
        refine (congrArg (m₅ ≫ ·) hs₄).trans ?_
        refine (CategoryTheory.Category.assoc m₅ _ _).symm.trans ?_
        refine (congrArg (· ≫ _) (h_map_fst f' (e_B_g.hom.app U))).trans ?_
        exact (CategoryTheory.Category.assoc _ _ _).trans
          (congrArg (CategoryTheory.Limits.pullback.fst ((B_site g₂).obj U).hom f' ≫ ·)
            (CategoryTheory.MorphismProperty.Over.pullbackComp_left_fst_fst g₁ eS.hom U))
      have h_assoc_all : ((((m₅ ≫ m₄) ≫ m₃) ≫ m₂) ≫ m₁) ≫ P₀ =
          m₅ ≫ (m₄ ≫ (m₃ ≫ (m₂ ≫ (m₁ ≫ P₀)))) :=
        (CategoryTheory.Category.assoc _ m₁ P₀).trans
          ((CategoryTheory.Category.assoc _ m₂ _).trans
            ((CategoryTheory.Category.assoc _ m₃ _).trans
              (CategoryTheory.Category.assoc m₅ m₄ _)))
      exact h_assoc_all.trans (hs₅.trans (h_efun_inv_fst g'₂ f₂ f' g₂ hpb₂.w U).symm)
    · 
      intro I₁ _ q hq
      let R_ℓ := ULift.{u, 0} (ZMod ℓ)
      let Fgt := CategoryTheory.forget₂ (ModuleCat.{u, u} R_ℓ) AddCommGrpCat.{u}
      have hInj_equiv : ∀ {C D : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C]
          [CategoryTheory.Category.{u + 1, u + 1} D] (E : C ≌ D)
          (J : D) [CategoryTheory.Injective J],
          CategoryTheory.Injective (E.inverse.obj J) :=
        fun E J _ => CategoryTheory.Injective.injective_of_adjoint E.toAdjunction J
      let eqv_mod := eqv_sh eX (ModuleCat.{u, u} R_ℓ)
      let I₂ := eqv_mod.inverse.obj I₁
      have : CategoryTheory.Injective I₂ := hInj_equiv eqv_mod I₁
      
      let adj_ℤ := (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ)
        AddCommGrpCat.{u}).asEquivalence.symm.toAdjunction
      let adj_ext := ModuleCat.extendRestrictScalarsAdj (Int.castRingHom R_ℓ)
      let iso_fgt : (ModuleCat.restrictScalars (Int.castRingHom R_ℓ)).comp
          (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}) ≅ Fgt :=
        CategoryTheory.NatIso.ofComponents
          (fun M =>
            { hom := AddCommGrpCat.ofHom (AddMonoidHom.id _)
              inv := AddCommGrpCat.ofHom (AddMonoidHom.id _)
              hom_inv_id := by ext x; rfl
              inv_hom_id := by ext x; rfl })
          (fun _ => by ext x; rfl)
      let L₀ := (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ)
        AddCommGrpCat.{u}).asEquivalence.symm.functor.comp
        (ModuleCat.extendScalars (Int.castRingHom R_ℓ))
      let adj_fgt : L₀ ⊣ Fgt := (adj_ℤ.comp adj_ext).ofNatIsoRight iso_fgt
      have hIsSheaf_Fgt : ∀ (Z : AlgebraicGeometry.Scheme.{u})
          (M : CategoryTheory.Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} R_ℓ)),
          CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (M.obj.comp Fgt) := by
        intro Z M E
        let e_coy : M.obj.comp (CategoryTheory.coyoneda.obj (Opposite.op (L₀.obj E))) ≅
            (M.obj.comp Fgt).comp (CategoryTheory.coyoneda.obj (Opposite.op E)) :=
          CategoryTheory.NatIso.ofComponents
            (fun W => (adj_fgt.homEquiv E (M.obj.obj W)).toIso)
            (fun {W₁ W₂} u => by
              ext ψ
              exact (adj_fgt.homEquiv_naturality_right ψ (M.obj.map u)).symm)
        exact CategoryTheory.Presieve.isSheaf_iso Z.smallEtaleTopology e_coy
          (M.property (L₀.obj E))
      let U_direct : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
          CategoryTheory.Sheaf Z.smallEtaleTopology (ModuleCat.{u, u} R_ℓ) →
            CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
        fun Z M => ⟨M.obj.comp Fgt, hIsSheaf_Fgt Z M⟩
      let U_sh := fun (Z : AlgebraicGeometry.Scheme.{u}) =>
        CategoryTheory.Sheaf.composeAndSheafify Z.smallEtaleTopology Fgt
      let eqv_X := eqv_sh eX AddCommGrpCat.{u}
      let pf_eX_inv := (B_site eX.inv).sheafPushforwardContinuous AddCommGrpCat.{u}
        X₁.smallEtaleTopology X₂.smallEtaleTopology
      let pf_g'₁ := (B_site g'₁).sheafPushforwardContinuous AddCommGrpCat.{u}
        X₁.smallEtaleTopology X'.smallEtaleTopology
      let pf_g'₂ := (B_site g'₂).sheafPushforwardContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X'.smallEtaleTopology
      let pb_g'₁ := (B_site g'₁).sheafPullback AddCommGrpCat.{u}
        X₁.smallEtaleTopology X'.smallEtaleTopology
      let pb_g'₂ := (B_site g'₂).sheafPullback AddCommGrpCat.{u}
        X₂.smallEtaleTopology X'.smallEtaleTopology
      let adj_g'₁ := (B_site g'₁).sheafAdjunctionContinuous AddCommGrpCat.{u}
        X₁.smallEtaleTopology X'.smallEtaleTopology
      let adj_g'₂ := (B_site g'₂).sheafAdjunctionContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X'.smallEtaleTopology
      let pf_eX_hom := (B_site eX.hom).sheafPushforwardContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology
      let e_B_g' : B_site g'₂ ≅ (B_site eX.hom).comp (B_site g'₁) :=
        CategoryTheory.MorphismProperty.Over.pullbackComp g'₁ eX.hom
      let _ := CategoryTheory.Functor.isContinuous_comp (B_site eX.hom) (B_site g'₁)
        X₂.smallEtaleTopology X₁.smallEtaleTopology X'.smallEtaleTopology
      let α_g' : pf_g'₁.comp pf_eX_hom ≅ pf_g'₂ :=
        CategoryTheory.Functor.sheafPushforwardContinuousComp (B_site eX.hom) (B_site g'₁)
            AddCommGrpCat.{u} X₂.smallEtaleTopology X₁.smallEtaleTopology X'.smallEtaleTopology ≪≫
          (CategoryTheory.Functor.sheafPushforwardContinuousIso e_B_g' AddCommGrpCat.{u}
            X₂.smallEtaleTopology X'.smallEtaleTopology).symm
      let adj_g'₂' := (eqv_X.toAdjunction.comp adj_g'₁).ofNatIsoRight α_g'
      let u_g' : pf_eX_inv.comp pb_g'₁ ≅ pb_g'₂ := adj_g'₂'.leftAdjointUniq adj_g'₂
      let e_U₁ : (U_sh X₁).obj I₁ ≅ U_direct X₁ I₁ :=
        (CategoryTheory.sheafificationIso (U_direct X₁ I₁)).symm
      let e_U₂ : U_direct X₂ I₂ ≅ (U_sh X₂).obj I₂ :=
        CategoryTheory.sheafificationIso (U_direct X₂ I₂)
      have h_Udir_eq : pf_eX_hom.obj (U_direct X₁ I₁) = U_direct X₂ I₂ := rfl
      let e_X₁ : (U_sh X₁).obj I₁ ≅ pf_eX_inv.obj ((U_sh X₂).obj I₂) :=
        e_U₁ ≪≫ (eqv_X.counitIso.app (U_direct X₁ I₁)).symm ≪≫
          pf_eX_inv.mapIso (CategoryTheory.eqToIso h_Udir_eq ≪≫ e_U₂)
      let e_pb : pb_g'₁.obj ((U_sh X₁).obj I₁) ≅ pb_g'₂.obj ((U_sh X₂).obj I₂) :=
        pb_g'₁.mapIso e_X₁ ≪≫ u_g'.app ((U_sh X₂).obj I₂)
      let wLeft : CategoryTheory.Functor
          (CategoryTheory.Functor (Opposite X'.Etale) AddCommGrpCat.{u})
          (CategoryTheory.Functor (Opposite S'.Etale) AddCommGrpCat.{u}) :=
        { obj := fun P => (B_site f').op.comp P
          map := fun α => CategoryTheory.Functor.whiskerLeft (B_site f').op α }
      let Rq : CategoryTheory.Functor
          (CategoryTheory.Sheaf X'.smallEtaleTopology AddCommGrpCat.{u})
          (CategoryTheory.Sheaf S'.smallEtaleTopology AddCommGrpCat.{u}) :=
        (CategoryTheory.Sheaf.cohomologyPresheafFunctor X'.smallEtaleTopology q).comp
          (wLeft.comp (CategoryTheory.presheafToSheaf S'.smallEtaleTopology AddCommGrpCat.{u}))
      exact (hInj₂ I₂ q hq).of_iso (Rq.mapIso e_pb)

theorem weil_pbc_affine_open_target_localization (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S) :
    (∀ (U : S.Opens), AlgebraicGeometry.IsAffineOpen U → WeilCanonicalModPrimePBC ℓ (f ∣_ U)) →
    WeilCanonicalModPrimePBC ℓ f :=
by
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  
  have hSite : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      let B_h : CategoryTheory.Functor Y₂.Etale Y₁.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
      ∃ (hc : B_h.IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology),
        let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y₂.smallEtaleTopology Y₁.smallEtaleTopology
        ∃ (hr : pf_h.IsRightAdjoint),
          (B_h.sheafPullback AddCommGrpCat.{u}
            Y₂.smallEtaleTopology Y₁.smallEtaleTopology).Additive := by
    intro Y₁ Y₂ h B_h
    have : Limits.PreservesFiniteLimits B_h :=
      MorphismProperty.Over.instPreservesFiniteLimitsTopPullback (@AlgebraicGeometry.Etale) h
    have : RepresentablyFlat B_h := flat_of_preservesFiniteLimits B_h
    have hCompat : CompatiblePreserving Y₁.smallEtaleTopology B_h :=
      compatiblePreservingOfFlat Y₁.smallEtaleTopology B_h
    have hMemEt : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (W : Z.Etale) (R : Sieve W),
        R ∈ Z.smallEtaleTopology W ↔
          ∀ (x : ↥W.left), ∃ (V : Z.Etale) (u : V ⟶ W) (v : ↥V.left),
            R.arrows u ∧ AlgebraicGeometry.Etale u.left ∧ u.left.base v = x := by
      intro Z W R
      change R ∈ Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) Z W ↔ _
      rw [Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) Z (le_refl _)]
      exact Scheme.mem_toGrothendieck_smallPretopology W R
    have hCov : CoverPreserving Y₂.smallEtaleTopology Y₁.smallEtaleTopology B_h := by
      refine ⟨fun {W} {R} hR => (hMemEt (B_h.obj W) _).mpr fun y => ?_⟩
      obtain ⟨V, u, v, huR, _, hv⟩ :=
        (hMemEt W R).mp hR ((Limits.pullback.fst W.hom h).base y)
      have hpb_top : IsPullback ((B_h.map u).left) (Limits.pullback.fst V.hom h)
          (Limits.pullback.fst W.hom h) u.left := by
        refine IsPullback.of_right ?_ (Limits.pullback.lift_fst _ _ _)
          (IsPullback.of_hasPullback W.hom h).flip
        have hw : u.left ≫ W.hom = V.hom := MorphismProperty.Over.w u
        have hsnd : (B_h.map u).left ≫ Limits.pullback.snd W.hom h =
            Limits.pullback.snd V.hom h := MorphismProperty.Over.w (B_h.map u)
        rw [hw, hsnd]
        exact (IsPullback.of_hasPullback V.hom h).flip
      let e_pb := hpb_top.isoPullback
      obtain ⟨z₀, hz₀_fst, _⟩ := Scheme.Pullback.exists_preimage_pullback y v hv.symm
      refine ⟨B_h.obj V, B_h.map u, e_pb.inv.base z₀,
        ⟨V, u, 𝟙 (B_h.obj V), huR, (Category.id_comp _).symm⟩, ?_, ?_⟩
      · have : AlgebraicGeometry.Etale ((B_h.map u).left ≫ (B_h.obj W).hom) :=
          (MorphismProperty.Over.w (B_h.map u)).symm ▸ (B_h.obj V).prop
        have : AlgebraicGeometry.Etale (B_h.obj W).hom := (B_h.obj W).prop
        exact AlgebraicGeometry.Etale.of_comp ((B_h.map u).left) (B_h.obj W).hom
      · have hcomp : e_pb.inv ≫ (B_h.map u).left =
            Limits.pullback.fst (Limits.pullback.fst W.hom h) u.left :=
          (Iso.inv_comp_eq e_pb).mpr hpb_top.isoPullback_hom_fst.symm
        exact (Scheme.Hom.comp_apply e_pb.inv ((B_h.map u).left) z₀).symm.trans
          ((congrArg (fun k : _ ⟶ (B_h.obj W).left => k.base z₀) hcomp).trans hz₀_fst)
    have hc : B_h.IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology :=
      Functor.isContinuous_of_coverPreserving hCompat hCov
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let ι₂ : Functor Y₂.AffineEtale Y₂.Etale := Scheme.AffineEtale.Spec Y₂
    let J_aff := Scheme.AffineEtale.topology Y₂
    have : ι₂.IsContinuous J_aff Y₂.smallEtaleTopology := inferInstance
    have : (ι₂.sheafPushforwardContinuous AddCommGrpCat.{u}
        J_aff Y₂.smallEtaleTopology).IsEquivalence := inferInstance
    let M₂ := SmallModel.{u} Y₂.AffineEtale
    let e_sm : Y₂.AffineEtale ≌ M₂ := equivSmallModel.{u} Y₂.AffineEtale
    let J_M : GrothendieckTopology M₂ := e_sm.inverse.inducedTopology J_aff
    have : e_sm.inverse.IsContinuous J_M J_aff := inferInstance
    have : (e_sm.inverse.sheafPushforwardContinuous AddCommGrpCat.{u}
        J_M J_aff).IsEquivalence := inferInstance
    let I₂ : Functor M₂ Y₂.Etale := e_sm.inverse ⋙ ι₂
    have : I₂.IsContinuous J_M Y₂.smallEtaleTopology :=
      Functor.isContinuous_comp e_sm.inverse ι₂ J_M J_aff Y₂.smallEtaleTopology
    let pf_I₂ := I₂.sheafPushforwardContinuous AddCommGrpCat.{u} J_M Y₂.smallEtaleTopology
    have hEq_I₂ : pf_I₂.IsEquivalence := by
      let iso_I₂ := Functor.sheafPushforwardContinuousComp e_sm.inverse ι₂
        AddCommGrpCat.{u} J_M J_aff Y₂.smallEtaleTopology
      exact Functor.isEquivalence_of_iso iso_I₂
    let K : Functor M₂ Y₁.Etale := I₂ ⋙ B_h
    have : K.IsContinuous J_M Y₁.smallEtaleTopology :=
      Functor.isContinuous_comp I₂ B_h J_M Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let pf_K := K.sheafPushforwardContinuous AddCommGrpCat.{u} J_M Y₁.smallEtaleTopology
    have : pf_K.IsRightAdjoint := inferInstance
    let adj_K := K.sheafAdjunctionContinuous AddCommGrpCat.{u} J_M Y₁.smallEtaleTopology
    let e_I₂ := @Functor.asEquivalence _ _ _ _ pf_I₂ hEq_I₂
    let iso_K : pf_h ⋙ pf_I₂ ≅ pf_K :=
      Functor.sheafPushforwardContinuousComp I₂ B_h
        AddCommGrpCat.{u} J_M Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let iso_rhs : pf_K ⋙ e_I₂.inverse ≅ pf_h :=
      Functor.isoWhiskerRight iso_K.symm e_I₂.inverse ≪≫
        Functor.associator pf_h pf_I₂ e_I₂.inverse ≪≫
        Functor.isoWhiskerLeft pf_h e_I₂.unitIso.symm ≪≫
        Functor.rightUnitor pf_h
    let adj_comp : (pf_I₂ ⋙ K.sheafPullback AddCommGrpCat.{u} J_M Y₁.smallEtaleTopology) ⊣ pf_h :=
      (e_I₂.toAdjunction.comp adj_K).ofNatIsoRight iso_rhs
    have hr : pf_h.IsRightAdjoint := adj_comp.isRightAdjoint
    let pb_h := B_h.sheafPullback AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    have : pf_h.Additive :=
      { map_add := fun {_ _ _ _} => Sheaf.hom_ext (NatTrans.ext (funext fun _ => rfl)) }
    have hAdd : pb_h.Additive := adj_h.left_adjoint_additive
    exact ⟨hc, hr, hAdd⟩

  
  have hOpenCont : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (W : Z.Opens),
      let E_W : CategoryTheory.Functor W.toScheme.Etale Z.Etale :=
        CategoryTheory.MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤
          (inferInstance : AlgebraicGeometry.Etale W.ι)
      E_W.IsContinuous W.toScheme.smallEtaleTopology Z.smallEtaleTopology := by
    intro Z W E_W
    have : E_W.Faithful := ⟨fun {Y₁ Y₂} {u₁ u₂} h => by
      apply MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
      exact congrArg (fun k => k.left) h⟩
    have : E_W.Full :=
      { map_surjective := fun {Y₁ Y₂} u =>
          ⟨MorphismProperty.Over.homMk u.left
            ((cancel_mono W.ι).mp ((Category.assoc u.left Y₂.hom W.ι).trans (MorphismProperty.Over.w u)))
            trivial,
           MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)⟩ }
    have hCompat : CompatiblePreserving Z.smallEtaleTopology E_W :=
      compatiblePreservingOfDownwardsClosed Z.smallEtaleTopology E_W (fun {c d} u =>
        have hEq : (u.left ≫ c.hom) ≫ W.ι = d.hom :=
          (Category.assoc u.left c.hom W.ι).trans (MorphismProperty.Over.w u)
        have hEt : AlgebraicGeometry.Etale (u.left ≫ c.hom) := by
          have : AlgebraicGeometry.Etale ((u.left ≫ c.hom) ≫ W.ι) := hEq.symm ▸ d.prop
          exact AlgebraicGeometry.Etale.of_comp (u.left ≫ c.hom) W.ι
        ⟨MorphismProperty.Over.mk ⊤ (u.left ≫ c.hom) hEt,
         MorphismProperty.Over.isoMk (Iso.refl d.left)
           ((Category.id_comp _).trans hEq.symm)⟩)
    have hMemEt : ∀ {S₀ : AlgebraicGeometry.Scheme.{u}} (U₀ : S₀.Etale) (R : Sieve U₀),
        R ∈ S₀.smallEtaleTopology U₀ ↔
          ∀ (x : ↥U₀.left), ∃ (V : S₀.Etale) (u : V ⟶ U₀) (v : ↥V.left),
            R.arrows u ∧ AlgebraicGeometry.Etale u.left ∧ u.left.base v = x := by
      intro S₀ U₀ R
      change R ∈ Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) S₀ U₀ ↔ _
      rw [Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
