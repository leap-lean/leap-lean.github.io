    hComapBS' ▸ IsLocalRing.maximalIdeal.isMaximal B
  have _ : 𝔮'.IsMaximal := by
    apply Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap B ↥S')
