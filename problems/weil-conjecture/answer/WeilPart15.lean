            (Y'.left.presheaf.map (homOfLE le_top).op).hom (x_fam g hg) :=
        fun V => (hLocal V).choose_spec.1
      have ha_sec_uniq : ∀ (V : U.left.affineOpens) (a' : ↑(U.left.presheaf.obj (Opposite.op V.1))),
