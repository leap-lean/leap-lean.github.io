theorem weil_etale_higherDirectImage_shortExact_calculus {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S) :
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
