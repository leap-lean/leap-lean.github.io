  have hs_det_ev : ev₁ s_det ≠ 0 := by
    have hC₀_ev : C₀.map ev₁ = C_bar := by
      ext i r
      simp [C₀, ev₁.commutes]
    have hP_ev : P.map ev₁ = 1 - J_bar * R_bar := by
      ext i₁ i₂
      simp [P, J_bar, R_bar, Matrix.sub_apply, Matrix.mul_apply, Matrix.one_apply]
    have hC_ev : C.map ev₁ = C_bar := by
      dsimp only [C]
      rw [Matrix.map_mul, hP_ev, hC₀_ev, Matrix.sub_mul, Matrix.one_mul, Matrix.mul_assoc,
        hRC_bar, Matrix.mul_zero, sub_zero]
    have hM_ev : (ev₁.toRingHom).mapMatrix M_sq = M_bar := by
      ext i j
