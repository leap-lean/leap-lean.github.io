    Matrix.of fun i j => Fin.addCases (fun r : Fin R_dim => C_bar i r) (fun l : Fin K_pos => J_bar i l) j
  have hM_bar_inj : Function.Injective M_bar.mulVec := by
    change Function.Injective (Matrix.mulVecLin M_bar)
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro u hu
    rw [LinearMap.mem_ker] at hu
    let x : Fin R_dim → k := fun r => u (Fin.castAdd K_pos r)
    let y : Fin K_pos → k := fun l => u (Fin.natAdd R_dim l)
    have h_decomp : M_bar.mulVec u = C_bar.mulVec x + J_bar.mulVec y := by
      ext i
      dsimp only [N_tot] at M_bar u ⊢
      simp only [Matrix.mulVec, dotProduct, M_bar, Matrix.of_apply, Pi.add_apply]
      rw [Fin.sum_univ_add]
      simp only [Fin.addCases_left, Fin.addCases_right, x, y]
    have h_sum0 : C_bar.mulVec x + J_bar.mulVec y = 0 := h_decomp ▸ hu
    have hy0 : y = 0 := by
