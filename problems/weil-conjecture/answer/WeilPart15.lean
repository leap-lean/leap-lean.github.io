        intro V₀ V₁ hVV
        apply ha_sec_uniq V₀
        intro Y' g hg W' hW' hW'_le₀
        exact (happLE_res_LE g.left hVV hW'_le₀ (a_sec V₁)).trans
          (ha_sec_spec V₁ g hg W' hW' _)
      have hcompat_U : TopCat.Presheaf.IsCompatible U.left.presheaf
          (fun V : U.left.affineOpens => V.1) a_sec := by
        intro V₁ V₂
        apply hsec_ext U.left (V₁.1 ⊓ V₂.1)
        intro x hx
        obtain ⟨V₀_open, hV₀_aff, hx₀, hV₀_le⟩ := exists_isAffineOpen_mem_and_subset hx
        let V₀ : U.left.affineOpens := ⟨V₀_open, hV₀_aff⟩
        have hle₁ : V₀.1 ≤ V₁.1 := le_trans hV₀_le inf_le_left
        have hle₂ : V₀.1 ≤ V₂.1 := le_trans hV₀_le inf_le_right
        have hg₁ := TopCat.Presheaf.germ_res_apply U.left.presheaf (homOfLE hV₀_le) x hx₀
