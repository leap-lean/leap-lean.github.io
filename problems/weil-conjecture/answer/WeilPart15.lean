        exact ⟨⟨R₃, hCR₃, hAlg₁₃, ⟨hEt₁₃⟩, hAlg₃Ω, ⟨hTow₁₃Ω⟩, α_tilde⟩, hB, hSp⟩
      refine ⟨fun c m =>
        ⟨fun W₀ _ _ _ α₀ hα₀ =>
