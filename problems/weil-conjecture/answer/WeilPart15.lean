  have hφ_Δ_bij : Function.Bijective φ_Δ := by
    have hfun : (⇑φ_Δ : (Fin (n * K_pos) → A₁) → R_tilde ⧸ I_Δ) =
        fun c => Ideal.Quotient.mk I_Δ
          (Finset.univ.sum fun idx : Fin (n * K_pos) =>
