  have h_sum_app : ∀ {A : AddCommGrpCat.{u}} {r : ℕ} (s : Finset (Fin r))
      (g : Fin r → (A ⟶ A)) (x : A),
      (∑ m ∈ s, g m) x = ∑ m ∈ s, g m x := by
    intro A r s g x
    induction s using Finset.induction_on with
    | empty => rfl
    | insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha]
      exact congrArg (_ + ·) ih
  have h_sheaf_sq_postcomp : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
      (ℋ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      {M₀ : AddCommGrpCat.{u}} {V₁ V₂ V₃ V₄ : Z.Etale}
      (a : V₂ ⟶ V₁) (b : V₃ ⟶ V₂) (c : V₄ ⟶ V₁) (d : V₃ ⟶ V₄),
      b ≫ a = d ≫ c →
      ∀ (rest : ℋ.obj.obj (Opposite.op V₃) ⟶ M₀),
        ℋ.obj.map a.op ≫ (ℋ.obj.map b.op ≫ rest) =
          ℋ.obj.map c.op ≫ (ℋ.obj.map d.op ≫ rest) := by
    intro Z ℋ M₀ V₁ V₂ V₃ V₄ a b c d hsq rest
    have h_m : ℋ.obj.map a.op ≫ ℋ.obj.map b.op = ℋ.obj.map c.op ≫ ℋ.obj.map d.op :=
      (ℋ.obj.map_comp a.op b.op).symm.trans
        ((congrArg (fun f => ℋ.obj.map f.op) hsq).trans (ℋ.obj.map_comp c.op d.op))
    exact (CategoryTheory.Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ rest) h_m).trans (CategoryTheory.Category.assoc _ _ _))
