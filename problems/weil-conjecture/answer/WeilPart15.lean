  have _ : Module.Finite κ_A κ_B := Module.Finite.of_restrictScalars_finite A κ_A κ_B
  have _ : Algebra.IsAlgebraic κ_A κ_B := Algebra.IsAlgebraic.of_finite κ_A κ_B
