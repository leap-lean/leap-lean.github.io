    intro Z W E_W B_W hc_B R_EW R_BW res_W pf_W adj_site
    have : E_W.IsContinuous W.toScheme.smallEtaleTopology Z.smallEtaleTopology := hOpenCont W
    let adj_pre : R_EW ⊣ R_BW := Adjunction.mkOfUnitCounit
      { unit :=
