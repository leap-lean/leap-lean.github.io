          rw [← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        · rename_i x y hx hy
          rw [map_add, map_add, hx, hy, map_add]
      intro x hx
      have h0 : Ideal.Quotient.mk J x = 0 := by
        change q_J x = 0
        rw [← hψ_comp x, hx, map_zero]
