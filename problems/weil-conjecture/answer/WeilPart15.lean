    let Q_cat := Y₀.left.presheaf.obj (Opposite.op W_op)
    let ρ_V : CommRingCat.of ↥L₀ ⟶ P_cat := Spec.preimage (hAffV.isoSpec.inv ≫ V.ι ≫ T₀.hom)
    let ρ_W : CommRingCat.of ↥L₀ ⟶ Q_cat := Spec.preimage (hAffW.isoSpec.inv ≫ W_op.ι ≫ Y₀.hom)
    let τ_PQ : P_cat ⟶ Q_cat :=
      Spec.preimage (hAffW.isoSpec.inv ≫ (φ₀.left ∣_ V) ≫ hAffV.isoSpec.hom)
    letI : Algebra ↥L₀ ↑P_cat := ρ_V.hom.toAlgebra
    letI : Algebra ↥L₀ ↑Q_cat := ρ_W.hom.toAlgebra
    letI : Algebra ↑P_cat ↑Q_cat := τ_PQ.hom.toAlgebra
    have h_ρτ : ρ_V ≫ τ_PQ = ρ_W := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Spec.map_preimage]
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
      rw [morphismRestrict_ι_assoc, Over.w φ₀]
    haveI : IsScalarTower ↥L₀ ↑P_cat ↑Q_cat := IsScalarTower.of_algebraMap_eq fun x => by
      change ρ_W.hom x = τ_PQ.hom (ρ_V.hom x)
      exact congr_arg (fun f : CommRingCat.of ↥L₀ ⟶ Q_cat => f.hom x) h_ρτ.symm
    have hFT_P : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ ↑P_cat))) := by
      have heq : Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ ↑P_cat)) =
          hAffV.isoSpec.inv ≫ (V.ι ≫ T₀.hom) := Spec.map_preimage _
      rw [heq]
      exact (MorphismProperty.cancel_left_of_respectsIso (P := @LocallyOfFiniteType.{u})
        hAffV.isoSpec.inv _).mpr
        (IsZariskiLocalAtSource.comp (P := @LocallyOfFiniteType.{u}) ‹LocallyOfFiniteType T₀.hom› V.ι)
    haveI : Algebra.FiniteType ↥L₀ ↑P_cat :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType.{u})).mp hFT_P
    have hFT_fV : LocallyOfFiniteType (φ₀.left ∣_ V) := by
      obtain ⟨⟨e_arr⟩, _⟩ := hRestrictArrowIso φ₀.left (hV_le_U₀ j)
      exact (MorphismProperty.arrow_mk_iso_iff (@LocallyOfFiniteType.{u}) e_arr).mp inferInstance
    have hFT_PQ_spec : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap ↑P_cat ↑Q_cat))) := by
      have heq : Spec.map (CommRingCat.ofHom (algebraMap ↑P_cat ↑Q_cat)) =
          hAffW.isoSpec.inv ≫ (φ₀.left ∣_ V) ≫ hAffV.isoSpec.hom := Spec.map_preimage _
      rw [heq]
      exact (MorphismProperty.cancel_left_of_respectsIso (P := @LocallyOfFiniteType.{u})
        hAffW.isoSpec.inv _).mpr
        ((MorphismProperty.cancel_right_of_respectsIso (P := @LocallyOfFiniteType.{u})
          (φ₀.left ∣_ V) hAffV.isoSpec.hom).mpr hFT_fV)
    haveI : Algebra.FiniteType ↑P_cat ↑Q_cat :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType.{u})).mp hFT_PQ_spec
    haveI : Algebra.FiniteType ↥L₀ ↑Q_cat :=
      Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType ↥L₀ ↑P_cat)
        (inferInstance : Algebra.FiniteType ↑P_cat ↑Q_cat)
    have hArrowPQ : ∀ (Ω : Type u) [Field Ω] [Algebra ↥L₀ Ω]
        (Y_Ω T_Ω : CategoryTheory.Over (Spec (CommRingCat.of Ω)))
        (φ_Ω : Y_Ω ⟶ T_Ω) (r_Y : Y_Ω.left ⟶ Y₀.left) (r_X : T_Ω.left ⟶ T₀.left),
        IsPullback r_Y Y_Ω.hom Y₀.hom (Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ Ω))) →
        IsPullback r_X T_Ω.hom T₀.hom (Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ Ω))) →
        r_Y ≫ φ₀.left = φ_Ω.left ≫ r_X →
        Nonempty (Arrow.mk (φ_Ω.left ∣_ (TopologicalSpace.Opens.map r_X.base).obj V) ≅
          Arrow.mk (Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.map (AlgHom.id Ω Ω)
              (IsScalarTower.toAlgHom ↥L₀ ↑P_cat ↑Q_cat)).toRingHom))) := by
      intro Ω _ _ Y_Ω T_Ω φ_Ω r_Y r_X hrY hrX hComm_Ω
      let V_Ω : T_Ω.left.Opens := (TopologicalSpace.Opens.map r_X.base).obj V
      let W_Ω : Y_Ω.left.Opens := (TopologicalSpace.Opens.map φ_Ω.left.base).obj V_Ω
      let W_Ω' : Y_Ω.left.Opens := (TopologicalSpace.Opens.map r_Y.base).obj W_op
      have hW_eq : W_Ω = W_Ω' := by
        ext y
        change (φ_Ω.left ≫ r_X).base y ∈ V ↔ (r_Y ≫ φ₀.left).base y ∈ V
        rw [hComm_Ω]
      obtain ⟨θ_V, hθ_V_fst, hθ_V_snd⟩ :=
        hPullbackAffine ↥L₀ Ω T₀.left T₀.hom T_Ω.left T_Ω.hom r_X hrX V hAffV rfl
      obtain ⟨θ_W', hθ_W'_fst, hθ_W'_snd⟩ :=
        hPullbackAffine ↥L₀ Ω Y₀.left Y₀.hom Y_Ω.left Y_Ω.hom r_Y hrY W_op hAffW rfl
      let e_W_eq : (W_Ω : Scheme.{u}) ≅ (W_Ω' : Scheme.{u}) := Y_Ω.left.isoOfEq hW_eq
      let θ_W : (W_Ω : Scheme.{u}) ≅ Spec (CommRingCat.of (TensorProduct ↥L₀ Ω ↑Q_cat)) :=
        e_W_eq ≪≫ θ_W'
      let g_Ω := (Algebra.TensorProduct.map (AlgHom.id Ω Ω)
        (IsScalarTower.toAlgHom ↥L₀ ↑P_cat ↑Q_cat)).toRingHom
      have hp_tenP :=
        (isPullback_SpecMap_of_isPushout _ _ _ _
          (CommRingCat.isPushout_tensorProduct ↥L₀ Ω ↑P_cat)).flip
      have h_sq_Ω : θ_W.hom ≫ Spec.map (CommRingCat.ofHom g_Ω) =
          (φ_Ω.left ∣_ V_Ω) ≫ θ_V.hom := by
        apply hp_tenP.hom_ext
        · rw [Category.assoc, Category.assoc, hθ_V_fst, ← Spec.map_comp]
          have h_g_inr : CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom ≫
              CommRingCat.ofHom g_Ω =
              τ_PQ ≫ CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom := by
            ext p
            exact Algebra.TensorProduct.map_tmul _ _ (1 : Ω) p
          rw [h_g_inr, Spec.map_comp]
          change (e_W_eq.hom ≫ θ_W'.hom) ≫
              (Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) ≫
                Spec.map τ_PQ) = _
          rw [Category.assoc, ← Category.assoc θ_W'.hom, hθ_W'_fst, Spec.map_preimage]
          simp only [Category.assoc, Iso.hom_inv_id_assoc]
          have h_eq_V : e_W_eq.hom ≫ (r_Y ∣_ W_op) ≫ (φ₀.left ∣_ V) =
              (φ_Ω.left ∣_ V_Ω) ≫ (r_X ∣_ V) := by
            apply (cancel_mono V.ι).mp
            have hL : (e_W_eq.hom ≫ (r_Y ∣_ W_op) ≫ (φ₀.left ∣_ V)) ≫ V.ι =
                e_W_eq.hom ≫ W_Ω'.ι ≫ r_Y ≫ φ₀.left := by
              simp only [Category.assoc]
              rw [morphismRestrict_ι, ← Category.assoc (r_Y ∣_ W_op),
                morphismRestrict_ι r_Y W_op, Category.assoc]
            have hR : ((φ_Ω.left ∣_ V_Ω) ≫ (r_X ∣_ V)) ≫ V.ι =
                W_Ω.ι ≫ φ_Ω.left ≫ r_X := by
              simp only [Category.assoc]
              rw [morphismRestrict_ι, ← Category.assoc (φ_Ω.left ∣_ V_Ω),
                morphismRestrict_ι φ_Ω.left V_Ω, Category.assoc]
            rw [hL, hR, Scheme.isoOfEq_hom_ι_assoc, hComm_Ω]
          rw [← Category.assoc _ _ hAffV.isoSpec.hom, ← Category.assoc _ _ hAffV.isoSpec.hom,
            h_eq_V, Category.assoc]
        · rw [Category.assoc, Category.assoc, ← Spec.map_comp]
          have h_g_inl : CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫
              CommRingCat.ofHom g_Ω =
              CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom := by
            ext c
            change g_Ω (c ⊗ₜ[↥L₀] (1 : ↑P_cat)) = c ⊗ₜ[↥L₀] (1 : ↑Q_cat)
            simp [g_Ω]
          rw [h_g_inl]
          change (e_W_eq.hom ≫ θ_W'.hom) ≫
              Spec.map (CommRingCat.ofHom (algebraMap Ω (TensorProduct ↥L₀ Ω ↑Q_cat))) =
            (φ_Ω.left ∣_ V_Ω) ≫ (θ_V.hom ≫
              Spec.map (CommRingCat.ofHom (algebraMap Ω (TensorProduct ↥L₀ Ω ↑P_cat))))
          rw [Category.assoc, hθ_W'_snd, hθ_V_snd, Scheme.isoOfEq_hom_ι_assoc,
            morphismRestrict_ι_assoc, Over.w φ_Ω]
      exact ⟨Arrow.isoMk θ_W θ_V h_sq_Ω⟩
    let V_k : (weilBaseChangeOver F (AlgebraicClosure F) X).left.Opens :=
      (TopologicalSpace.Opens.map p_X.base).obj V
    have hVk_le : V_k ≤ U_bar := by
      rw [← hOpen]
      exact (TopologicalSpace.Opens.map p_X.base).monotone (hV_le_U₀ j)
    have hEt_Vk : Etale (φ_bar.left ∣_ V_k) := by
      obtain ⟨⟨e_arr_k⟩, _⟩ := hRestrictArrowIso φ_bar.left hVk_le
      exact (MorphismProperty.arrow_mk_iso_iff (@Etale.{u}) e_arr_k).mp inferInstance
    obtain ⟨e_pq_k⟩ :=
      hArrowPQ (AlgebraicClosure F) W (weilBaseChangeOver F (AlgebraicClosure F) X)
        φ_bar p_W p_X hpW hpX hComm
    have hEt_spec_k : Etale (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.map (AlgHom.id (AlgebraicClosure F) (AlgebraicClosure F))
          (IsScalarTower.toAlgHom ↥L₀ ↑P_cat ↑Q_cat)).toRingHom)) :=
      (MorphismProperty.arrow_mk_iso_iff (@Etale.{u}) e_pq_k).mp hEt_Vk
    have hEt_ring_k : RingHom.Etale (Algebra.TensorProduct.map
        (AlgHom.id (AlgebraicClosure F) (AlgebraicClosure F))
        (IsScalarTower.toAlgHom ↥L₀ ↑P_cat ↑Q_cat)).toRingHom :=
      (HasRingHomProperty.Spec_iff (P := @Etale.{u})).mp hEt_spec_k
    obtain ⟨L_j, hLE_j, hFD_j, hEt_j_all⟩ := hAlgEtale L₀ ↑P_cat ↑Q_cat hEt_ring_k
    refine ⟨L_j, hLE_j, hFD_j, ?_⟩
    intro L₁ hLE₁ hLj_L₁ Y₁ T₁ φ₁ q_Y q_X hqY hqX hComm₁
    letI : Algebra ↥L₀ ↥L₁ := (IntermediateField.inclusion hLE₁).toRingHom.toAlgebra
    have hEt_ring_1 := hEt_j_all L₁ hLE₁ hLj_L₁
    have hEt_spec_1 : Etale (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.map (AlgHom.id ↥L₁ ↥L₁)
          (IsScalarTower.toAlgHom ↥L₀ ↑P_cat ↑Q_cat)).toRingHom)) :=
      (HasRingHomProperty.Spec_iff (P := @Etale.{u})).mpr hEt_ring_1
    obtain ⟨e_pq_1⟩ := hArrowPQ ↥L₁ Y₁ T₁ φ₁ q_Y q_X hqY hqX hComm₁
    exact (MorphismProperty.arrow_mk_iso_iff (@Etale.{u}) e_pq_1).mpr hEt_spec_1
  choose L_et_j hLE_et_j hFD_et_j hEt_j using hEach_et
  haveI : ∀ j : covU.I₀, FiniteDimensional F ↥(L_et_j j) := hFD_et_j
  haveI : FiniteDimensional F ↥(⨆ j : covU.I₀, L_et_j j) :=
    IntermediateField.finiteDimensional_iSup_of_finite
  let L_et : IntermediateField F (AlgebraicClosure F) := L₀ ⊔ ⨆ j : covU.I₀, L_et_j j
  haveI : FiniteDimensional F ↥L_et :=
    IntermediateField.finiteDimensional_sup L₀ (⨆ j : covU.I₀, L_et_j j)
  let L₁ : IntermediateField F (AlgebraicClosure F) := L_sm ⊔ L_et
  have hLE : L₀ ≤ L₁ := le_trans hLE_sm le_sup_left
  haveI : FiniteDimensional F ↥L₁ := IntermediateField.finiteDimensional_sup L_sm L_et
  letI : Algebra ↥L₀ ↥L₁ := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
  let Y₁ := weilBaseChangeOver ↥L₀ ↥L₁ Y₀
  let T₁ := weilBaseChangeOver F ↥L₁ X
  let s_F_L₀ := Spec.map (CommRingCat.ofHom (algebraMap F ↥L₀))
  let s_F_L₁ := Spec.map (CommRingCat.ofHom (algebraMap F ↥L₁))
  let s_L₀_L₁ := Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ ↥L₁))
  let s_L₀_k := Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ (AlgebraicClosure F)))
  let s_L₁_k := Spec.map (CommRingCat.ofHom (algebraMap ↥L₁ (AlgebraicClosure F)))
  have hs_F : s_F_L₁ = s_L₀_L₁ ≫ s_F_L₀ := by
    change Spec.map _ = Spec.map _ ≫ Spec.map _
    rw [← Spec.map_comp]
    rfl
  have hs_k : s_L₀_k = s_L₁_k ≫ s_L₀_L₁ := by
    change Spec.map _ = Spec.map _ ≫ Spec.map _
    rw [← Spec.map_comp]
    rfl
  let q_Y : Y₁.left ⟶ Y₀.left := Limits.pullback.fst Y₀.hom s_L₀_L₁
  have hqY : IsPullback q_Y Y₁.hom Y₀.hom s_L₀_L₁ := IsPullback.of_hasPullback Y₀.hom s_L₀_L₁
  let fst_F₀ : T₀.left ⟶ X.left := Limits.pullback.fst X.hom s_F_L₀
  let fst_F₁ : T₁.left ⟶ X.left := Limits.pullback.fst X.hom s_F_L₁
  have hpF₀ : IsPullback fst_F₀ T₀.hom X.hom s_F_L₀ :=
    IsPullback.of_hasPullback X.hom s_F_L₀
  have hpF₁ : IsPullback fst_F₁ T₁.hom X.hom s_F_L₁ :=
    IsPullback.of_hasPullback X.hom s_F_L₁
  let q_X : T₁.left ⟶ T₀.left :=
    hpF₀.lift fst_F₁ (T₁.hom ≫ s_L₀_L₁) (by rw [hpF₁.w, hs_F, Category.assoc])
  have hqX : IsPullback q_X T₁.hom T₀.hom s_L₀_L₁ := by
    refine IsPullback.of_right ?_ (hpF₀.lift_snd _ _ _) hpF₀
    have hq_fst : q_X ≫ fst_F₀ = fst_F₁ := hpF₀.lift_fst _ _ _
    rw [hq_fst, ← hs_F]
    exact hpF₁
  let f₁ : Y₁.left ⟶ T₁.left :=
    hqX.lift (q_Y ≫ φ₀.left) Y₁.hom (by rw [Category.assoc, Over.w φ₀, hqY.w])
  let φ₁ : Y₁ ⟶ T₁ := Over.homMk f₁ (hqX.lift_snd _ _ _)
  have hComm₁ : q_Y ≫ φ₀.left = φ₁.left ≫ q_X := (hqX.lift_fst _ _ _).symm
  let U₁ : T₁.left.Opens := (TopologicalSpace.Opens.map q_X.base).obj U₀
  let p_W₁ : W.left ⟶ Y₁.left :=
    hqY.lift p_W (W.hom ≫ s_L₁_k) (by
      rw [hpW.w]; change W.hom ≫ s_L₀_k = _; rw [hs_k, Category.assoc])
  have hpW₁ : IsPullback p_W₁ W.hom Y₁.hom s_L₁_k := by
    refine IsPullback.of_right ?_ (hqY.lift_snd _ _ _) hqY
    have hpW_fst : p_W₁ ≫ q_Y = p_W := hqY.lift_fst _ _ _
    rw [hpW_fst, ← hs_k]
    exact hpW
  let p_X₁ : (weilBaseChangeOver F (AlgebraicClosure F) X).left ⟶ T₁.left :=
    hqX.lift p_X ((weilBaseChangeOver F (AlgebraicClosure F) X).hom ≫ s_L₁_k) (by
      rw [hpX.w]; change _ ≫ s_L₀_k = _; rw [hs_k, Category.assoc])
  have hpX₁ : IsPullback p_X₁ (weilBaseChangeOver F (AlgebraicClosure F) X).hom T₁.hom s_L₁_k := by
    refine IsPullback.of_right ?_ (hqX.lift_snd _ _ _) hqX
    have hpX_fst : p_X₁ ≫ q_X = p_X := hqX.lift_fst _ _ _
    rw [hpX_fst, ← hs_k]
    exact hpX
  have hComm_bar₁ : p_W₁ ≫ φ₁.left = φ_bar.left ≫ p_X₁ := by
    apply hqX.hom_ext
    · rw [Category.assoc, ← hComm₁, ← Category.assoc, hqY.lift_fst, hComm,
        Category.assoc, hqX.lift_fst]
    · change (p_W₁ ≫ f₁) ≫ T₁.hom = (φ_bar.left ≫ p_X₁) ≫ T₁.hom
      rw [Category.assoc, hqX.lift_snd, hqY.lift_snd, Category.assoc, hqX.lift_snd,
        ← Category.assoc, Over.w φ_bar]
  have hOpen_bar₁ : (TopologicalSpace.Opens.map p_X₁.base).obj U₁ = U_bar := by
    rw [← hOpen]
    have hpX_comp : p_X₁ ≫ q_X = p_X := hqX.lift_fst _ _ _
    ext x
    change (p_X₁ ≫ q_X).base x ∈ U₀ ↔ p_X.base x ∈ U₀
    rw [hpX_comp]
  have hMod₁ : IsBaseChangeAlterationModel F X W φ_bar U_bar L₁ Y₁ φ₁ U₁ :=
    ⟨p_W₁, p_X₁, hpW₁, hpX₁, hComm_bar₁, hOpen_bar₁⟩
  have hSm₁ : SmoothOfRelativeDimension d Y₁.hom := by
    let A₁ : covY.I₀ → Y₁.left.Opens := fun i => (TopologicalSpace.Opens.map q_Y.base).obj (A_sm i)
    have hSup_A₁ : (⨆ i : covY.I₀, A₁ i) = ⊤ := by
      apply le_antisymm le_top
      intro y _
      have hy : q_Y.base y ∈ (⊤ : Y₀.left.Opens) := trivial
      rw [← hSup_A] at hy
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hi⟩
    refine (IsZariskiLocalAtSource.iff_of_iSup_eq_top
      (P := @SmoothOfRelativeDimension.{u} d) A₁ hSup_A₁).mpr ?_
    intro i
    have hLi_L₁ : L_sm_i i ≤ L₁ :=
      le_trans (le_trans (le_iSup L_sm_i i) le_sup_right) le_sup_left
    have hLoc₁ := hSm_i i L₁ hLE hLi_L₁
    obtain ⟨θ₁, _, hθ₁_snd⟩ :=
      hPullbackAffine ↥L₀ ↥L₁ Y₀.left Y₀.hom Y₁.left Y₁.hom q_Y hqY (A_sm i) (hAff_A i) rfl
    have hSm_spec₁ : SmoothOfRelativeDimension d
        (Spec.map (CommRingCat.ofHom
          (algebraMap ↥L₁ (TensorProduct ↥L₀ ↥L₁ ↑(Y₀.left.presheaf.obj (Opposite.op (A_sm i))))))) :=
      (HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension.{u} d)).mpr hLoc₁
    rw [← hθ₁_snd]
    exact (MorphismProperty.cancel_left_of_respectsIso (P := @SmoothOfRelativeDimension.{u} d)
      θ₁.hom _).mpr hSm_spec₁
  have hEt₁ : Etale (φ₁.left ∣_ U₁) := by
    let V₁ : covU.I₀ → T₁.left.Opens := fun j => (TopologicalSpace.Opens.map q_X.base).obj (V_et j)
    have hV₁_le : ∀ j : covU.I₀, V₁ j ≤ U₁ :=
      fun j => (TopologicalSpace.Opens.map q_X.base).monotone (hV_le_U₀ j)
    let V'₁ : covU.I₀ → (U₁ : Scheme.{u}).Opens :=
      fun j => (TopologicalSpace.Opens.map U₁.ι.base).obj (V₁ j)
    have hSup_V'₁ : (⨆ j : covU.I₀, V'₁ j) = ⊤ := by
      apply le_antisymm le_top
      intro u _
      have hu₀ : q_X.base (U₁.ι.base u) ∈ U₀ := u.2
      let y₀ : ↥(U₀ : Scheme.{u}) := ⟨q_X.base (U₁.ι.base u), hu₀⟩
      have hy₀ : y₀ ∈ (⊤ : (U₀ : Scheme.{u}).Opens) := trivial
      rw [← hSup_V'] at hy₀
      obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hy₀
      refine TopologicalSpace.Opens.mem_iSup.mpr ⟨j, ?_⟩
      change q_X.base (U₁.ι.base u) ∈ U₀.ι.base '' (V'_et j : Set ↥(U₀ : Scheme.{u}))
      exact ⟨y₀, hj, rfl⟩
    refine (IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := @Etale.{u}) V'₁ hSup_V'₁).mpr ?_
    intro j
    have hLj_L₁ : L_et_j j ≤ L₁ :=
      le_trans (le_trans (le_iSup L_et_j j) le_sup_right) le_sup_right
    have hEt_V₁j : Etale (φ₁.left ∣_ V₁ j) :=
      hEt_j j L₁ hLE hLj_L₁ Y₁ T₁ φ₁ q_Y q_X hqY hqX hComm₁
    obtain ⟨⟨e_arr₁⟩, _⟩ := hRestrictArrowIso φ₁.left (hV₁_le j)
    exact (MorphismProperty.arrow_mk_iso_iff (@Etale.{u}) e_arr₁).mpr hEt_V₁j
  exact ⟨L₁, hLE, inferInstance, φ₁, U₁, hMod₁, hSm₁, hEt₁⟩

theorem weil_descent_projective_alteration_from_algClosure (F : Type u) [Finite F] [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible X.hom]
    [AlgebraicGeometry.IsProper X.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (V₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))))
    (π₀ : V₀ ⟶ weilBaseChangeOver F (AlgebraicClosure F) X)
    (hIntV₀ : AlgebraicGeometry.IsIntegral V₀.left)
    (hπ₀ : IsGenFiniteEtaleAlterationOver (AlgebraicClosure F) π₀)
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))))
    (φ_V : W ⟶ V₀)
    (hIntW : AlgebraicGeometry.IsIntegral W.left)
    (hProjW : IsProjectiveOverField (AlgebraicClosure F) W)
    (hSmW : AlgebraicGeometry.SmoothOfRelativeDimension d W.hom)
    (hφ_V : IsGenFiniteEtaleAlterationOver (AlgebraicClosure F) φ_V) :
    HasSmoothProjectiveAlteration F d X :=
by
  let φ_bar : W ⟶ weilBaseChangeOver F (AlgebraicClosure F) X := φ_V ≫ π₀
  obtain ⟨hProp_bar, hSurj_bar, U_bar, hU_bar, hFin_bar, hEt_bar, hSurjU_bar⟩ :=
    weil_comp_isGenFiniteEtaleAlterationOver (AlgebraicClosure F)
      (weilBaseChangeOver F (AlgebraicClosure F) X) V₀ W π₀ hIntV₀ hπ₀ φ_V hφ_V
  obtain ⟨L₀, hFD₀, Y₀, φ₀, U₀, hProj₀, hMod₀⟩ :=
    weil_spread_out_projective_alteration_model F X W hProjW φ_bar U_bar
  obtain ⟨hPropY₀, _, _, _, hFin₀, _⟩ :=
    weil_descent_isFinite_and_proper_surjective_of_model F X W φ_bar U_bar
      hProp_bar hSurj_bar hU_bar hFin_bar hSurjU_bar L₀ Y₀ φ₀ U₀ hProj₀ hMod₀
  have : AlgebraicGeometry.SmoothOfRelativeDimension d W.hom := hSmW
  have : FiniteDimensional F ↥L₀ := hFD₀
  obtain ⟨L₁, hLE, hFD₁, hEnl⟩ :=
    weil_enlarge_field_smooth_and_etale_of_model F X d W φ_bar U_bar hEt_bar
      L₀ Y₀ φ₀ U₀ hPropY₀ hFin₀ hMod₀
  let : Algebra ↥L₀ ↥L₁ := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
  obtain ⟨φ₁, U₁, hMod₁, hSm₁, hEt₁⟩ := hEnl
  let Y₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₁)) :=
    weilBaseChangeOver ↥L₀ ↥L₁ Y₀
  have hProj₁ : IsProjectiveOverField ↥L₁ Y₁ :=
    weil_isProjectiveOverField_baseChange ↥L₀ ↥L₁ Y₀ hProj₀
  obtain ⟨hPropY₁, hPropφ₁, hSurjφ₁, hU₁, hFin₁, hSurjU₁⟩ :=
    weil_descent_isFinite_and_proper_surjective_of_model F X W φ_bar U_bar
      hProp_bar hSurj_bar hU_bar hFin_bar hSurjU_bar L₁ Y₁ φ₁ U₁ hProj₁ hMod₁
  obtain ⟨p_W, _, hpW, _, _, _⟩ := hMod₁
  have : Algebra.IsAlgebraic ↥L₁ (AlgebraicClosure F) :=
    Algebra.IsAlgebraic.tower_top (K := F) (L := ↥L₁) (A := AlgebraicClosure F)
  have hGeomIrred₁ : AlgebraicGeometry.GeometricallyIrreducible Y₁.hom :=
    weil_geometricallyIrreducible_of_algClosure_pullback ↥L₁ (AlgebraicClosure F)
      Y₁ W hIntW p_W hpW
  exact ⟨↥L₁, inferInstance, inferInstance, hFD₁, Y₁,
    hGeomIrred₁, hPropY₁, hSm₁, hProj₁,
    φ₁, hPropφ₁, hSurjφ₁, U₁, hU₁, hFin₁, hEt₁, hSurjU₁⟩

theorem weil_smooth_projective_alteration (F : Type u) [Finite F] [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible X.hom]
    [AlgebraicGeometry.IsProper X.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom] :
    HasSmoothProjectiveAlteration F d X :=
by
  let k : Type u := AlgebraicClosure F
  obtain ⟨V₀, π₀, hIntV₀, hProjV₀, hDimV₀, hπ₀⟩ :=
    weil_chow_projective_modification_over_algClosure F X d
  have hSnc : ∀ (m : ℕ)
      (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (_ : AlgebraicGeometry.IsIntegral V.left)
      (_ : IsProjectiveOverField k V)
      (_ : topologicalKrullDim V.left = (m : WithBot ℕ∞))
      (U_V : V.left.Opens) (_ : Nonempty U_V),
      ∃ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (Z_W : Set W.left) (φ : W ⟶ V),
        AlgebraicGeometry.IsIntegral W.left ∧
        IsProjectiveOverField k W ∧
        AlgebraicGeometry.SmoothOfRelativeDimension m W.hom ∧
        IsSncDivisorSupport k m W Z_W ∧
        IsGenFiniteEtaleAlterationOver k φ ∧
        φ.left.base ⁻¹' ((U_V : Set V.left)ᶜ) ⊆ Z_W := by
    intro m
    induction m with
    | zero =>
      intro V hIntV hProjV hDimV U_V hUV
      exact weil_algClosed_dim_zero_snc_alteration k V hIntV hProjV hDimV U_V hUV
    | succ m ih =>
      intro V hIntV hProjV hDimV U_V hUV
      obtain ⟨B, U_B, hIntB, hProjB, hDimB, hUB, C, f, n, τ, hCurve, hIntC, hProjC, β, hβ, hBdry⟩ :=
        weil_algClosed_curve_fibration_semistable_alteration k m V hIntV hProjV hDimV U_V hUV
      obtain ⟨B₁, Z_B₁, ψ, hIntB₁, hProjB₁, hSmB₁, hSncB₁, hψ, hψBdry⟩ :=
        ih B hIntB hProjB hDimB U_B hUB
      exact weil_snc_base_semistable_curve_toroidal_resolution
        k m V U_V hUV B U_B hIntB hProjB hDimB hUB C f n τ hCurve hIntC hProjC β hβ hBdry
        B₁ Z_B₁ ψ hIntB₁ hProjB₁ hSmB₁ hSncB₁ hψ hψBdry
  have hIrredV₀ : IrreducibleSpace ↥V₀.left :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral V₀.left hIntV₀
  obtain ⟨x₀⟩ := hIrredV₀.toNonempty
  have hTopV₀ : Nonempty (⊤ : V₀.left.Opens) := ⟨⟨x₀, trivial⟩⟩
  obtain ⟨W, _Z_W, φ_V, hIntW, hProjW, hSmW, _hSncW, hφ_V, _hBdryW⟩ :=
    hSnc d V₀ hIntV₀ hProjV₀ hDimV₀ ⊤ hTopV₀
  exact weil_descent_projective_alteration_from_algClosure
    F X d V₀ π₀ hIntV₀ hπ₀ W φ_V hIntW hProjW hSmW hφ_V

theorem weil_etale_constructible_mod_prime_extraction_over_algClosed (k : Type u) [Field k] [IsAlgClosed k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i : ℕ) :
    WeilIsConstructibleModPrimeSheaf ℓ X.left (weilEtaleTorsionSheaf X.left ℓ) ∧
    (WeilIsConstructibleModPrimeSheaf ℓ (AlgebraicGeometry.Spec (CommRingCat.of k))
      (weilEtaleHigherDirectImage X.hom i (weilEtaleTorsionSheaf X.left ℓ)) →
      Finite (weilEtaleTorsionH X.left ℓ i)) :=
by
  classical
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let isoToAddEquiv : ∀ {M N : AddCommGrpCat.{u}}, (M ≅ N) → ((M : Type u) ≃+ (N : Type u)) :=
    fun e =>
      { toFun := e.hom.hom
        invFun := e.inv.hom
        left_inv := fun x => ConcreteCategory.congr_hom e.hom_inv_id x
        right_inv := fun y => ConcreteCategory.congr_hom e.inv_hom_id y
        map_add' := map_add e.hom.hom }
  let pb_id_left : ∀ {Y S : AlgebraicGeometry.Scheme.{u}} (f : Y ⟶ S),
      CategoryTheory.Limits.pullback (CategoryTheory.CategoryStruct.id S) f ≅ Y :=
    fun {Y S} f =>
      { hom := CategoryTheory.Limits.pullback.snd (CategoryTheory.CategoryStruct.id S) f
        inv := CategoryTheory.Limits.pullback.lift f (CategoryTheory.CategoryStruct.id Y) (by simp)
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        inv_hom_id := CategoryTheory.Limits.pullback.lift_snd _ _ _ }
  let pb_id_right : ∀ {W S : AlgebraicGeometry.Scheme.{u}} (g : W ⟶ S),
      CategoryTheory.Limits.pullback g (CategoryTheory.CategoryStruct.id S) ≅ W :=
    fun {W S} g =>
      { hom := CategoryTheory.Limits.pullback.fst g (CategoryTheory.CategoryStruct.id S)
        inv := CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id W) g (by simp)
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
        inv_hom_id := CategoryTheory.Limits.pullback.lift_fst _ _ _ }

  
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have : NeZero ℓ := ⟨hℓ_prime.ne_zero⟩
  let A_ℓ : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  have hFin_Aℓ : Finite A_ℓ := Finite.of_equiv (ZMod ℓ) Equiv.ulift.symm
  have hTors_Aℓ : ℓ • CategoryTheory.CategoryStruct.id A_ℓ = 0 := by
    ext ⟨x⟩
    apply ULift.ext
    change ℓ • x = 0
    rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
  let C_X := CategoryTheory.constantSheaf X.left.smallEtaleTopology AddCommGrpCat.{u}
  have : C_X.Additive := by
    dsimp [C_X, CategoryTheory.constantSheaf]
    infer_instance
  let F := weilEtaleTorsionSheaf X.left ℓ
  have hTors_F : ℓ • CategoryTheory.CategoryStruct.id F = 0 := by
    change ℓ • CategoryTheory.CategoryStruct.id (C_X.obj A_ℓ) = 0
    rw [← C_X.map_id, ← C_X.map_nsmul, hTors_Aℓ, C_X.map_zero]

  
  have h_etale_term : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S)) := by
    intro S
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom) trivial) ?_
    intro U m
    apply (AlgebraicGeometry.Scheme.Etale.forget S).map_injective
    apply CategoryTheory.Over.OverMorphism.ext
    exact (CategoryTheory.Category.comp_id m.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w m)

  
  have h_mem_etale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S W R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) S
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)).trans hiff

  
  have h_s2_const : ∀ (X₁ X₂ : AlgebraicGeometry.Scheme.{u}) (h : X₁ ⟶ X₂)
      (A : AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h
        ((CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj A)
        ((CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj A) := by
    intro X₁ X₂ h A
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_h : CategoryTheory.Functor X₂.Etale X₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    
    have hT₂ : CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id X₂)) :=
      h_etale_term X₂
    have : CategoryTheory.Limits.HasTerminal X₂.Etale := hT₂.hasTerminal
    have : CategoryTheory.Limits.HasPullbacks X₂.Etale :=
      CategoryTheory.MorphismProperty.Over.hasPullbacks (@AlgebraicGeometry.Etale) X₂
    have : CategoryTheory.Limits.HasFiniteLimits X₂.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have : CategoryTheory.Limits.PreservesFiniteLimits B_h :=
      CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback
        (@AlgebraicGeometry.Etale) h
    have : CategoryTheory.RepresentablyFlat B_h :=
      CategoryTheory.flat_of_preservesFiniteLimits B_h
    have hCompat : CategoryTheory.CompatiblePreserving X₁.smallEtaleTopology B_h :=
      CategoryTheory.compatiblePreservingOfFlat X₁.smallEtaleTopology B_h
    have hCover : CategoryTheory.CoverPreserving X₂.smallEtaleTopology X₁.smallEtaleTopology B_h := by
      constructor
      intro U S hS
      have hS' := (h_mem_etale X₂ U S).mp hS
      refine (h_mem_etale X₁ (B_h.obj U) _).mpr ?_
      intro z
      let fst_U : (B_h.obj U).left ⟶ U.left := CategoryTheory.Limits.pullback.fst U.hom h
      obtain ⟨Y, f, y, hfS, hfEt, hy⟩ := hS' (fst_U.base z)
      have h_outer : CategoryTheory.IsPullback
          ((B_h.map f).left ≫ CategoryTheory.Limits.pullback.snd U.hom h)
          (CategoryTheory.Limits.pullback.fst Y.hom h) h (f.left ≫ U.hom) := by
        have hw₁ : (B_h.map f).left ≫ CategoryTheory.Limits.pullback.snd U.hom h =
            CategoryTheory.Limits.pullback.snd Y.hom h :=
          CategoryTheory.MorphismProperty.Over.w (B_h.map f)
        have hw₂ : f.left ≫ U.hom = Y.hom := CategoryTheory.MorphismProperty.Over.w f
        rw [hw₁, hw₂]
        exact (CategoryTheory.IsPullback.of_hasPullback Y.hom h).flip
      have h_comm_left : (B_h.map f).left ≫ fst_U =
          CategoryTheory.Limits.pullback.fst Y.hom h ≫ f.left := by
        dsimp [B_h, fst_U, CategoryTheory.MorphismProperty.Over.pullback]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h_right : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.snd U.hom h) fst_U h U.hom :=
        (CategoryTheory.IsPullback.of_hasPullback U.hom h).flip
      have hp_left : CategoryTheory.IsPullback
          (B_h.map f).left (CategoryTheory.Limits.pullback.fst Y.hom h) fst_U f.left :=
        CategoryTheory.IsPullback.of_right h_outer h_comm_left h_right
      let e_pb := hp_left.isoPullback
      obtain ⟨p, hp_fst, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hy.symm
      refine ⟨B_h.obj Y, B_h.map f, e_pb.inv.base p, ?_, ?_, ?_⟩
      · exact ⟨Y, f, 𝟙 (B_h.obj Y), hfS, (CategoryTheory.Category.id_comp _).symm⟩
      · exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hp_left.flip hfEt
      · have heq : e_pb.inv ≫ (B_h.map f).left =
            CategoryTheory.Limits.pullback.fst fst_U f.left := by
          rw [Iso.inv_comp_eq]
          exact (CategoryTheory.IsPullback.isoPullback_hom_fst hp_left).symm
        calc
          (B_h.map f).left.base (e_pb.inv.base p) = (e_pb.inv ≫ (B_h.map f).left).base p := rfl
          _ = (CategoryTheory.Limits.pullback.fst fst_U f.left).base p := by rw [heq]
          _ = z := hp_fst
    have hCont : B_h.IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCover
    
    let ι₂ : CategoryTheory.Functor X₂.AffineEtale X₂.Etale :=
      AlgebraicGeometry.Scheme.AffineEtale.Spec X₂
    let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology X₂
    have : ι₂.IsContinuous J_aff X₂.smallEtaleTopology := by
      dsimp [ι₂]
      infer_instance
    let P_ι := ι₂.sheafPushforwardContinuous AddCommGrpCat.{u} J_aff X₂.smallEtaleTopology
    have : P_ι.IsEquivalence := by
      dsimp [P_ι, ι₂, J_aff]
      infer_instance
    let M₂ : Type u := CategoryTheory.SmallModel.{u} X₂.AffineEtale
    let e_sm : X₂.AffineEtale ≌ M₂ := CategoryTheory.equivSmallModel.{u} X₂.AffineEtale
    let J_M : CategoryTheory.GrothendieckTopology M₂ := e_sm.inverse.inducedTopology J_aff
    let P_sm := e_sm.inverse.sheafPushforwardContinuous AddCommGrpCat.{u} J_M J_aff
    have : P_sm.IsEquivalence := by
      dsimp [P_sm, J_M]
      infer_instance
    let K : CategoryTheory.Functor M₂ X₁.Etale := (e_sm.inverse.comp ι₂).comp B_h
    have : (e_sm.inverse.comp ι₂).IsContinuous J_M X₂.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp e_sm.inverse ι₂ J_M J_aff X₂.smallEtaleTopology
    have : K.IsContinuous J_M X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp (e_sm.inverse.comp ι₂) B_h J_M
        X₂.smallEtaleTopology X₁.smallEtaleTopology
    let P_push := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let P_K := K.sheafPushforwardContinuous AddCommGrpCat.{u} J_M X₁.smallEtaleTopology
    let e_tot : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u} ≌
        CategoryTheory.Sheaf J_M AddCommGrpCat.{u} :=
      P_ι.asEquivalence.trans P_sm.asEquivalence
    have hPK : P_push.comp e_tot.functor ≅ P_K :=
      (CategoryTheory.Functor.associator P_push P_ι P_sm).symm ≪≫
        CategoryTheory.Functor.isoWhiskerLeft P_push
          (CategoryTheory.Functor.sheafPushforwardContinuousComp e_sm.inverse ι₂ AddCommGrpCat.{u}
            J_M J_aff X₂.smallEtaleTopology).symm ≪≫
        CategoryTheory.Functor.sheafPushforwardContinuousComp (e_sm.inverse.comp ι₂) B_h
          AddCommGrpCat.{u} J_M X₂.smallEtaleTopology X₁.smallEtaleTopology
    have hIso : P_K.comp e_tot.inverse ≅ P_push :=
      (CategoryTheory.Functor.isoWhiskerRight hPK.symm e_tot.inverse) ≪≫
        CategoryTheory.Functor.associator P_push e_tot.functor e_tot.inverse ≪≫
        CategoryTheory.Functor.isoWhiskerLeft P_push e_tot.unitIso.symm ≪≫
        CategoryTheory.Functor.rightUnitor P_push
    let adj_K := K.sheafAdjunctionContinuous AddCommGrpCat.{u} J_M X₁.smallEtaleTopology
    have hRA : P_push.IsRightAdjoint :=
      (CategoryTheory.Adjunction.ofNatIsoRight (e_tot.toAdjunction.comp adj_K) hIso).isRightAdjoint
    
    let T₁ := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id X₁)
    let T₂ := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id X₂)
    have hT₁ : CategoryTheory.Limits.IsTerminal T₁ := h_etale_term X₁
    let e_T : B_h.obj T₂ ≅ T₁ :=
      CategoryTheory.MorphismProperty.Over.isoMk (pb_id_left h)
        (CategoryTheory.Category.comp_id _)
    let adj₁ := CategoryTheory.constantSheafAdj X₁.smallEtaleTopology AddCommGrpCat.{u} hT₁
    let adj₂ := (CategoryTheory.constantSheafAdj X₂.smallEtaleTopology AddCommGrpCat.{u} hT₂).comp
      (B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology)
    let Γ₁ := (CategoryTheory.sheafSections X₁.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₁)
    let Γ₂ := (CategoryTheory.sheafSections X₂.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₂)
    have hΓ_iso : P_push.comp Γ₂ ≅ Γ₁ :=
      CategoryTheory.NatIso.ofComponents
        (fun ℱ => ℱ.obj.mapIso e_T.op.symm)
        (fun {ℱ₁ ℱ₂} φ => by
          dsimp [P_push, Γ₁, Γ₂, CategoryTheory.sheafSections]
          exact (φ.hom.naturality e_T.inv.op).symm)
    let adj₂' := CategoryTheory.Adjunction.ofNatIsoRight adj₂ hΓ_iso
    let e_const := CategoryTheory.Adjunction.leftAdjointUniq adj₂' adj₁
    exact ⟨hCont, hRA, ⟨e_const.app A⟩⟩

  
  have h_s2_ret : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂) (σ : X₂ ⟶ X₁),
