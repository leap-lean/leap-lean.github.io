  have hEpiQuasiEquiv : ∀ {𝒞 𝒟 : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞] [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
      (F : 𝒞 ⥤ 𝒟) (G : 𝒟 ⥤ 𝒞),
      Nonempty (𝟭 𝒞 ≅ F ⋙ G) → Nonempty (G ⋙ F ≅ 𝟭 𝒟) →
      ∀ {A₁ A₂ : 𝒞} (α : A₁ ⟶ A₂) [CategoryTheory.Epi α], CategoryTheory.Epi (F.map α) := by
    intro 𝒞 𝒟 _ _ F G ⟨η⟩ ⟨ε⟩ A₁ A₂ α _
    constructor
    intro Z u₁ u₂ hu
    have hG : G.map (F.map α) ≫ G.map u₁ = G.map (F.map α) ≫ G.map u₂ := by
      rw [← G.map_comp, hu, G.map_comp]
    have hη := η.hom.naturality α
    dsimp at hη
    have h1 : α ≫ η.hom.app A₂ ≫ G.map u₁ = α ≫ η.hom.app A₂ ≫ G.map u₂ := by
      rw [← CategoryTheory.Category.assoc, hη, CategoryTheory.Category.assoc, hG,
        ← CategoryTheory.Category.assoc, ← hη, CategoryTheory.Category.assoc]
    have h2 : G.map u₁ = G.map u₂ :=
      (CategoryTheory.cancel_epi (η.hom.app A₂)).mp ((CategoryTheory.cancel_epi α).mp h1)
    have hF : F.map (G.map u₁) = F.map (G.map u₂) := congrArg F.map h2
    have hε₁ := ε.hom.naturality u₁
    have hε₂ := ε.hom.naturality u₂
    dsimp at hε₁ hε₂
    have h3 : ε.hom.app (F.obj A₂) ≫ u₁ = ε.hom.app (F.obj A₂) ≫ u₂ := by
      rw [← hε₁, hF, hε₂]
    exact (CategoryTheory.cancel_epi (ε.hom.app (F.obj A₂))).mp h3

