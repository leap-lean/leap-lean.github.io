  obtain ⟨hGmSheaf, hDiv0⟩ := weil_etale_gm_isSheaf_and_proj_H0_divisible
  obtain ⟨hKSheaf, Div_sh, ι_gm, div_mor, h0, valDiv, hSE, hValProp, hValNat, ⟨e_Cl⟩⟩ :=
