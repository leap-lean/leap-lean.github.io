        · dsimp only [proj_succ, f_succ]
          rw [Fin.cases_succ, Category.assoc, hProjHom_n i]
      obtain ⟨hV_succ, θ, hθ₁, hθ₂⟩ :=
        hPullbackCube P_n.hom C.hom V_n hV_n U₀ hU₀
      let V_succ : Q_sch.Opens :=
        (TopologicalSpace.Opens.map π₁.base).obj V_n ⊓
        (TopologicalSpace.Opens.map π₂.base).obj U₀
      have hSet_succ : (V_succ : Set ↥Q_sch) =
          { z : ↥Q_sch | ∀ j : Fin (n + 1), (proj_succ j).base z ∈ U₀ } := by
        ext z
