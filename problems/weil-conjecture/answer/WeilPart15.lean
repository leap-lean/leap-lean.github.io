  let C₀ : Matrix (Fin N_tot) (Fin R_dim) A₁ := C_bar.map (algebraMap k A₁)
  let P : Matrix (Fin N_tot) (Fin N_tot) A₁ := 1 - J * R
  let C : Matrix (Fin N_tot) (Fin R_dim) A₁ := P * C₀
  have hRP : R * P = 0 := by
    dsimp only [P]
    rw [Matrix.mul_sub, Matrix.mul_one, ← Matrix.mul_assoc, hRJ, Matrix.one_mul, sub_self]
  have hRC : R * C = 0 := by
    dsimp only [C]
    rw [← Matrix.mul_assoc, hRP, Matrix.zero_mul]
  have hPJ : P * J = 0 := by
