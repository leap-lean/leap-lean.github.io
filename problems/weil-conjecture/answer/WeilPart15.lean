    have hCl_Z₁ : IsClosed Z₁ := U₁.isOpen.isClosed_compl
    have hNe_Z₁ : Z₁ ≠ Set.univ :=
      fun huniv => (show z₀.1 ∈ Z₁ by rw [huniv]; trivial) hz₀_U₁
    have hNonempty_Z₁ : Z₁.Nonempty := by
      by_contra h_emp
      rw [Set.not_nonempty_iff_eq_empty, Set.compl_empty_iff] at h_emp
      exact hU₁_ne_top (TopologicalSpace.Opens.ext h_emp)
    obtain ⟨y₁, hy₁⟩ := hNonempty_Z₁
    let z₁ : Pt := ⟨y₁, (hProperClosed Z₁ hCl_Z₁ hNe_Z₁).1 y₁ hy₁⟩
    have hz₁ : z₁.1 ∉ U₁ := hy₁
    obtain ⟨T₀, S₁_sec, hBT₀, hBS₁, hMulOne⟩ := hPairH v₀ v₁
    let t : ↑(C.left.presheaf.obj (Opposite.op U₀)) := (ι.left.app (H v₀)).hom T₀
    let s : ↑(C.left.presheaf.obj (Opposite.op U₁)) := (ι.left.app (H v₁)).hom S₁_sec
    have hBasic_t : C.left.basicOpen t = U₀ ⊓ U₁ := by
      dsimp [t, U₀, U₁]
      rw [← ι.left.preimage_basicOpen T₀, hBT₀]
      rfl
    have hBasic_s : C.left.basicOpen s = U₁ ⊓ U₀ := by
      dsimp [s, U₀, U₁]
      rw [← ι.left.preimage_basicOpen S₁_sec, hBS₁]
      rfl
    have hts : (C.left.germToFunctionField U₀).hom t *
        (C.left.germToFunctionField U₁).hom s = 1 := by
      let W : C.left.Opens := (TopologicalSpace.Opens.map ι.left.base).obj (H v₀ ⊓ H v₁)
      have hWU₀ : W ≤ U₀ := fun _ hx => hx.1
      have hWU₁ : W ≤ U₁ := fun _ hx => hx.2
      obtain ⟨w₀, hw₀⟩ :=
        nonempty_preirreducible_inter U₀.isOpen U₁.isOpen ⟨x_base.1, hx_base_U₀⟩ ⟨z₀.1, hz₀_U₁⟩
      have : Nonempty ↥(W : Scheme.{u}) := ⟨⟨w₀, hw₀⟩⟩
      have hnat₀ := Scheme.Hom.naturality ι.left
        (CategoryTheory.homOfLE (inf_le_left : H v₀ ⊓ H v₁ ≤ H v₀)).op
      have hnat₁ := Scheme.Hom.naturality ι.left
        (CategoryTheory.homOfLE (inf_le_right : H v₀ ⊓ H v₁ ≤ H v₁)).op
      have ht_W :
          (C.left.presheaf.map (homOfLE hWU₀).op).hom t =
            (ι.left.app (H v₀ ⊓ H v₁)).hom
              (((weilProjectiveSpaceOver k N).left.presheaf.map
                (homOfLE (inf_le_left : H v₀ ⊓ H v₁ ≤ H v₀)).op).hom T₀) := by
        have hmap_eq :
            ((TopologicalSpace.Opens.map ι.left.base).map
              (homOfLE (inf_le_left : H v₀ ⊓ H v₁ ≤ H v₀))).op =
            (homOfLE hWU₀).op := Subsingleton.elim _ _
        have h1 := (congrArg (fun g => g.hom T₀) hnat₀).symm
        change (C.left.presheaf.map ((TopologicalSpace.Opens.map ι.left.base).map
            (homOfLE (inf_le_left : H v₀ ⊓ H v₁ ≤ H v₀))).op).hom t = _ at h1
        rwa [hmap_eq] at h1
      have hs_W :
          (C.left.presheaf.map (homOfLE hWU₁).op).hom s =
            (ι.left.app (H v₀ ⊓ H v₁)).hom
              (((weilProjectiveSpaceOver k N).left.presheaf.map
                (homOfLE (inf_le_right : H v₀ ⊓ H v₁ ≤ H v₁)).op).hom S₁_sec) := by
        have hmap_eq :
            ((TopologicalSpace.Opens.map ι.left.base).map
              (homOfLE (inf_le_right : H v₀ ⊓ H v₁ ≤ H v₁))).op =
            (homOfLE hWU₁).op := Subsingleton.elim _ _
        have h1 := (congrArg (fun g => g.hom S₁_sec) hnat₁).symm
        change (C.left.presheaf.map ((TopologicalSpace.Opens.map ι.left.base).map
            (homOfLE (inf_le_right : H v₀ ⊓ H v₁ ≤ H v₁))).op).hom s = _ at h1
        rwa [hmap_eq] at h1
      have hW_mul :
          (C.left.presheaf.map (homOfLE hWU₀).op).hom t *
            (C.left.presheaf.map (homOfLE hWU₁).op).hom s = 1 := by
        rw [ht_W, hs_W, ← map_mul, hMulOne, map_one]
      have hres₀ : C.left.presheaf.map (homOfLE hWU₀).op ≫
          C.left.germToFunctionField W = C.left.germToFunctionField U₀ :=
        TopCat.Presheaf.germ_res C.left.presheaf (homOfLE hWU₀)
          (genericPoint ↥C.left) _
      have hres₁ : C.left.presheaf.map (homOfLE hWU₁).op ≫
          C.left.germToFunctionField W = C.left.germToFunctionField U₁ :=
        TopCat.Presheaf.germ_res C.left.presheaf (homOfLE hWU₁)
          (genericPoint ↥C.left) _
      have hg0 := congrArg (fun f => f.hom t) hres₀
      have hg1 := congrArg (fun f => f.hom s) hres₁
      change (C.left.germToFunctionField W).hom
          ((C.left.presheaf.map (homOfLE hWU₀).op).hom t) =
        (C.left.germToFunctionField U₀).hom t at hg0
      change (C.left.germToFunctionField W).hom
          ((C.left.presheaf.map (homOfLE hWU₁).op).hom s) =
        (C.left.germToFunctionField U₁).hom s at hg1
      rw [← hg0, ← hg1, ← map_mul, hW_mul, map_one]
    exact ⟨U₀, U₁, hNeU₀, hNeU₁, t, s, hAffU₀, hAffU₁, hS_sub, hCov,
      ⟨z₀, hz₀⟩, ⟨z₁, hz₁⟩, hts, hBasic_t, hBasic_s,
      hFT_aff U₀ hAffU₀, hFT_aff U₁ hAffU₁, hBinaryGlue U₀ U₁ hCov⟩
  have hGlobalStalkConst : ∀ z : K,
      (∀ x : Pt, ∃ r : ↑(C.left.presheaf.stalk x.1), algebraMap _ K r = z) ↔
        z ∈ Set.range k_to_K := by
    obtain ⟨U₀, U₁, hNeU₀, hNeU₁, _, _, hAffU₀, hAffU₁, _, hCov,
      _, _, _, _, _, _, _, hGlobal⟩ := hTwoChart ∅
    have : Nonempty ↥(U₀ : Scheme.{u}) := hNeU₀
    have : Nonempty ↥(U₁ : Scheme.{u}) := hNeU₁
    let φ₀ : k →+* ↑(C.left.presheaf.obj (Opposite.op U₀)) :=
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
        (CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp U₀.ι C.hom).appTop
          (U₀.topIso).hom)).hom
    let φ₁ : k →+* ↑(C.left.presheaf.obj (Opposite.op U₁)) :=
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
        (CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp U₁.ι C.hom).appTop
          (U₁.topIso).hom)).hom
    intro z
    constructor
    · intro hAll
      obtain ⟨b₀, hb₀⟩ := (hStalkReg U₀ hAffU₀ z).mpr (fun x _ => hAll x)
      obtain ⟨b₁, hb₁⟩ := (hStalkReg U₁ hAffU₁ z).mpr (fun x _ => hAll x)
      obtain ⟨c, hc⟩ := hGlobal b₀ b₁ (hb₀.trans hb₁.symm)
      refine ⟨c, ?_⟩
      have hcomp₀ := congrArg (fun f : k →+* K => f c) (hCompOpen U₀)
      change (C.left.germToFunctionField U₀).hom (φ₀ c) = k_to_K c at hcomp₀
      rw [← hcomp₀, ← hc, hb₀]
    · rintro ⟨c, rfl⟩ x
      have hx_top : x.1 ∈ (⊤ : C.left.Opens) := trivial
      rw [← hCov] at hx_top
      rcases hx_top with hx₀ | hx₁
      · refine ⟨(C.left.presheaf.germ U₀ x.1 hx₀).hom (φ₀ c), ?_⟩
        rw [Scheme.algebraMap_germ_eq_germToFunctionField C.left hx₀ (φ₀ c)]
        exact congrArg (fun f : k →+* K => f c) (hCompOpen U₀)
      · refine ⟨(C.left.presheaf.germ U₁ x.1 hx₁).hom (φ₁ c), ?_⟩
        rw [Scheme.algebraMap_germ_eq_germToFunctionField C.left hx₁ (φ₁ c)]
        exact congrArg (fun f : k →+* K => f c) (hCompOpen U₁)
  exact ⟨hPropC, k_to_K, hCompOpen, hStalkReg, hFinStalkPole, hGlobalStalkConst, hTwoChart⟩

theorem weil_dvr_valuation_family_principal_divisor_and_subsingleton (k : Type u) [Field k]
    (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral X]
    (k_to_K : k →+* ↑X.functionField)
    (V_pt : { x : ↥X // IsClosed ({x} : Set ↥X) } → ValuationSubring ↑X.functionField)
    (_hDVR_V : ∀ x : { x : ↥X // IsClosed ({x} : Set ↥X) },
      IsDiscreteValuationRing ↥(V_pt x) ∧
      ∃ e_x : ↑(X.presheaf.stalk x.1) ≃+* ↥(V_pt x),
        ∀ r : ↑(X.presheaf.stalk x.1), (e_x r : ↑X.functionField) = algebraMap _ ↑X.functionField r)
    (_hFinPole : ∀ u : Units ↑X.functionField,
      Set.Finite { x : { x : ↥X // IsClosed ({x} : Set ↥X) } | (u : ↑X.functionField) ∉ V_pt x })
    (_hGlobalConst : ∀ z : ↑X.functionField,
      (∀ x : { x : ↥X // IsClosed ({x} : Set ↥X) }, z ∈ V_pt x) ↔ z ∈ Set.range k_to_K)
    (_hRes_k : ∀ (x : { x : ↥X // IsClosed ({x} : Set ↥X) }) (z : ↥(V_pt x)),
      ∃ (c : k) (hc : k_to_K c ∈ V_pt x),
        z - ⟨k_to_K c, hc⟩ ∈ IsLocalRing.maximalIdeal ↥(V_pt x)) :
    ∃ div_fn : Additive (Units ↑X.functionField) →+ ({ x : ↥X // IsClosed ({x} : Set ↥X) } →₀ ℤ),
      (∀ (u : Units ↑X.functionField) (x : { x : ↥X // IsClosed ({x} : Set ↥X) }),
        (u : ↑X.functionField) ∈ V_pt x ↔ 0 ≤ div_fn (Additive.ofMul u) x) ∧
      div_fn.range = weilCurvePrincipalSubgroup X ∧
      (∀ (u₁ u₂ : Units ↑X.functionField)
         (h : (u₁ : ↑X.functionField) + (u₂ : ↑X.functionField) ≠ 0)
         (x : { x : ↥X // IsClosed ({x} : Set ↥X) }),
        min (div_fn (Additive.ofMul u₁) x) (div_fn (Additive.ofMul u₂) x) ≤
          div_fn (Additive.ofMul (Units.mk0 ((u₁ : ↑X.functionField) + (u₂ : ↑X.functionField)) h)) x) ∧
      (∀ (c : Units k),
        div_fn (Additive.ofMul (Units.map k_to_K.toMonoidHom c)) = 0) ∧
      (∀ x : { x : ↥X // IsClosed ({x} : Set ↥X) },
        IsDiscreteValuationRing ↑(X.presheaf.stalk x.1) ∧
        (∀ u : Units ↑X.functionField,
          (0 ≤ div_fn (Additive.ofMul u) x ↔
            ∃ r : ↑(X.presheaf.stalk x.1), algebraMap _ ↑X.functionField r = (u : ↑X.functionField)) ∧
          (1 ≤ div_fn (Additive.ofMul u) x ↔
            ∃ r ∈ IsLocalRing.maximalIdeal ↑(X.presheaf.stalk x.1),
              algebraMap _ ↑X.functionField r = (u : ↑X.functionField)))) ∧
      (∀ D : { x : ↥X // IsClosed ({x} : Set ↥X) } →₀ ℤ,
        weilCurveEffSubsingleton X D ↔
          ∀ u₁ u₂ : Units ↑X.functionField,
            (∀ x : { x : ↥X // IsClosed ({x} : Set ↥X) },
              0 ≤ div_fn (Additive.ofMul u₁) x + D x) →
            (∀ x : { x : ↥X // IsClosed ({x} : Set ↥X) },
              0 ≤ div_fn (Additive.ofMul u₂) x + D x) →
            ∃ c : k, (u₁ : ↑X.functionField) = k_to_K c * (u₂ : ↑X.functionField)) ∧
      (∀ (P₀ : { x : ↥X // IsClosed ({x} : Set ↥X) })
         (D : { x : ↥X // IsClosed ({x} : Set ↥X) } →₀ ℤ),
        (∀ E' : { x : ↥X // IsClosed ({x} : Set ↥X) } →₀ ℤ,
          (∀ x, 0 ≤ E' x) →
          QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) E' =
            QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) D →
          E' P₀ = 0) →
        weilCurveEffSubsingleton X D) :=
by
  classical
  let Pt : Type u := { x : ↥X // IsClosed ({x} : Set ↥X) }
  let K : Type u := ↑X.functionField
  
  have hSinglePlace : ∀ (V : ValuationSubring K), IsDiscreteValuationRing ↥V →
      ∃ v : Additive (Units K) →+ ℤ,
        (∀ u : Units K, (u : K) ∈ V ↔ 0 ≤ v (Additive.ofMul u)) ∧
        (∀ u : Units K,
          1 ≤ v (Additive.ofMul u) ↔ ∃ z ∈ IsLocalRing.maximalIdeal ↥V, (z : K) = (u : K)) ∧
        (∀ (u₁ u₂ : Units K) (h : (u₁ : K) + (u₂ : K) ≠ 0),
          min (v (Additive.ofMul u₁)) (v (Additive.ofMul u₂)) ≤
            v (Additive.ofMul (Units.mk0 ((u₁ : K) + (u₂ : K)) h))) ∧
        (∀ u : Units K,
          ∃ (a b : ↥V) (na nb : ℕ),
            a ≠ 0 ∧ b ≠ 0 ∧
            (a : K) = (u : K) * (b : K) ∧
            Ideal.span ({a} : Set ↥V) = (IsLocalRing.maximalIdeal ↥V) ^ na ∧
            Ideal.span ({b} : Set ↥V) = (IsLocalRing.maximalIdeal ↥V) ^ nb ∧
            v (Additive.ofMul u) = (na : ℤ) - (nb : ℤ)) ∧
        (∀ (u : Units K) (a b : ↥V) (na nb : ℕ),
          a ≠ 0 → b ≠ 0 →
          (a : K) = (u : K) * (b : K) →
          Ideal.span ({a} : Set ↥V) = (IsLocalRing.maximalIdeal ↥V) ^ na →
          Ideal.span ({b} : Set ↥V) = (IsLocalRing.maximalIdeal ↥V) ^ nb →
          v (Additive.ofMul u) = (na : ℤ) - (nb : ℤ)) := by
    intro V hDVR
    have : IsDiscreteValuationRing ↥V := hDVR
    let mV : Ideal ↥V := IsLocalRing.maximalIdeal ↥V
    let π : ↥V := Submodule.IsPrincipal.generator mV
    have hπ_span : Ideal.span ({π} : Set ↥V) = mV :=
      Submodule.IsPrincipal.span_singleton_generator mV
    have hm_ne_bot : mV ≠ ⊥ := IsDiscreteValuationRing.not_a_field'
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hm_ne_bot
      rw [← hπ_span, h0, Ideal.span_singleton_eq_bot]
    have hm_ne_top : mV ≠ ⊤ := (IsLocalRing.maximalIdeal.isMaximal ↥V).ne_top
    have hπ_not_unit : ¬ IsUnit π := by
      intro hu
      apply hm_ne_top
      rw [← hπ_span]
      exact Ideal.span_singleton_eq_top.mpr hu
    have hSA : StrictAnti (fun n : ℕ => mV ^ n) := by
      refine strictAnti_nat_of_succ_lt fun n =>
        lt_of_le_of_ne (Ideal.pow_le_pow_right (Nat.le_succ n)) ?_
      intro heq
      have hmem : π ^ n ∈ Ideal.span ({π ^ (n + 1)} : Set ↥V) := by
        rw [← Ideal.span_singleton_pow, hπ_span, heq, ← hπ_span, Ideal.span_singleton_pow]
        exact Ideal.subset_span (Set.mem_singleton _)
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp hmem
      have hcancel : π ^ n * 1 = π ^ n * (π * r) := by
        calc
          π ^ n * 1 = π ^ n := mul_one _
          _ = π ^ (n + 1) * r := hr
          _ = π ^ n * (π * r) := by rw [pow_succ, mul_assoc]
      have h1 : (1 : ↥V) = π * r := mul_left_cancel₀ (pow_ne_zero n hπ_ne) hcancel
      exact hπ_not_unit (isUnit_iff_exists_inv.mpr ⟨r, h1.symm⟩)
    have hex_ord : ∀ (a : ↥V), a ≠ 0 → ∃ n : ℕ, Ideal.span ({a} : Set ↥V) = mV ^ n := by
      intro a ha
      exact exists_maximalIdeal_pow_eq_of_principal ↥V inferInstance (Ideal.span ({a} : Set ↥V))
        (Ideal.span_singleton_eq_bot.not.mpr ha)
    choose ord hord_spec using hex_ord
    have hord_ge1_iff : ∀ (a : ↥V) (ha : a ≠ 0), 1 ≤ ord a ha ↔ a ∈ mV := by
      intro a ha
      rw [← hSA.le_iff_ge, pow_one, ← hord_spec a ha, Ideal.span_singleton_le_iff_mem]
    have hu_ne : ∀ {z : K} (hz : z ∈ V), z ≠ 0 → (⟨z, hz⟩ : ↥V) ≠ 0 :=
      fun _ hz_ne h0 => hz_ne (congrArg Subtype.val h0)
    have hinv_mem : ∀ {u : Units K}, (u : K) ∉ V → ((u⁻¹ : Units K) : K) ∈ V := by
      intro u hu
      rcases ValuationSubring.mem_or_inv_mem V (u : K) with h | h
      · exact False.elim (hu h)
      · rwa [Units.val_inv_eq_inv_val]
    have hinv_in_m : ∀ {u : Units K} (hu : (u : K) ∉ V),
        (⟨((u⁻¹ : Units K) : K), hinv_mem hu⟩ : ↥V) ∈ mV := by
      intro u hu
      by_contra hnot
      have hunit : IsUnit (⟨((u⁻¹ : Units K) : K), hinv_mem hu⟩ : ↥V) :=
        IsLocalRing.notMem_maximalIdeal.mp hnot
      obtain ⟨w, hw⟩ := isUnit_iff_exists_inv.mp hunit
      have hw_K : ((u⁻¹ : Units K) : K) * (w : K) = 1 := congrArg Subtype.val hw
      have hu_eq : (w : K) = (u : K) := by
        calc
          (w : K) = (u : K) * (((u⁻¹ : Units K) : K) * (w : K)) := by
            rw [← mul_assoc, Units.mul_inv, one_mul]
          _ = (u : K) := by rw [hw_K, mul_one]
      exact hu (hu_eq ▸ w.2)
    let v0 : Units K → ℤ := fun u =>
      if hu : (u : K) ∈ V then
        (ord ⟨(u : K), hu⟩ (hu_ne hu u.ne_zero) : ℤ)
      else
        - (ord ⟨((u⁻¹ : Units K) : K), hinv_mem hu⟩ (hu_ne (hinv_mem hu) (u⁻¹).ne_zero) : ℤ)
    have hspan_one : Ideal.span ({(1 : ↥V)} : Set ↥V) = mV ^ 0 := by
      rw [Ideal.span_singleton_one, pow_zero, Ideal.one_eq_top]
    have hEx0 : ∀ u : Units K,
        ∃ (a b : ↥V) (na nb : ℕ),
          a ≠ 0 ∧ b ≠ 0 ∧
          (a : K) = (u : K) * (b : K) ∧
          Ideal.span ({a} : Set ↥V) = mV ^ na ∧
          Ideal.span ({b} : Set ↥V) = mV ^ nb ∧
          v0 u = (na : ℤ) - (nb : ℤ) := by
      intro u
      by_cases hu : (u : K) ∈ V
      · refine ⟨⟨(u : K), hu⟩, 1, ord ⟨(u : K), hu⟩ (hu_ne hu u.ne_zero), 0,
          hu_ne hu u.ne_zero, one_ne_zero, ?_, hord_spec _ _, hspan_one, ?_⟩
        · change (u : K) = (u : K) * 1
          rw [mul_one]
        · simp [v0, hu]
      · refine ⟨1, ⟨((u⁻¹ : Units K) : K), hinv_mem hu⟩, 0,
          ord ⟨((u⁻¹ : Units K) : K), hinv_mem hu⟩ (hu_ne (hinv_mem hu) (u⁻¹).ne_zero),
          one_ne_zero, hu_ne (hinv_mem hu) (u⁻¹).ne_zero, ?_, hspan_one, hord_spec _ _, ?_⟩
        · change (1 : K) = (u : K) * ((u⁻¹ : Units K) : K)
          exact (Units.mul_inv u).symm
        · simp [v0, hu]
    have hUniq0 : ∀ (u : Units K) (a b : ↥V) (na nb : ℕ),
        a ≠ 0 → b ≠ 0 →
        (a : K) = (u : K) * (b : K) →
        Ideal.span ({a} : Set ↥V) = mV ^ na →
        Ideal.span ({b} : Set ↥V) = mV ^ nb →
        v0 u = (na : ℤ) - (nb : ℤ) := by
      intro u a b na nb _ _ hab hspan_a hspan_b
      obtain ⟨a₀, b₀, na₀, nb₀, _, _, hab₀, hspan_a₀, hspan_b₀, hv0⟩ := hEx0 u
      have hmul_eq : a * b₀ = a₀ * b := by
        apply Subtype.ext
        change (a : K) * (b₀ : K) = (a₀ : K) * (b : K)
        rw [hab, hab₀]
        ring
      have hpow_eq : mV ^ (na + nb₀) = mV ^ (na₀ + nb) := by
        rw [pow_add, pow_add, ← hspan_a, ← hspan_b₀, ← hspan_a₀, ← hspan_b,
          Ideal.span_singleton_mul_span_singleton, Ideal.span_singleton_mul_span_singleton, hmul_eq]
      have hnat_eq : na + nb₀ = na₀ + nb := hSA.injective hpow_eq
      omega
    have hv0_one : v0 1 = 0 := by
      have h := hUniq0 1 1 1 0 0 one_ne_zero one_ne_zero (by simp) hspan_one hspan_one
      omega
    have hv0_mul : ∀ u₁ u₂ : Units K, v0 (u₁ * u₂) = v0 u₁ + v0 u₂ := by
      intro u₁ u₂
      obtain ⟨a₁, b₁, na₁, nb₁, ha₁, hb₁, hab₁, hsa₁, hsb₁, hv₁⟩ := hEx0 u₁
      obtain ⟨a₂, b₂, na₂, nb₂, ha₂, hb₂, hab₂, hsa₂, hsb₂, hv₂⟩ := hEx0 u₂
      have hv12 := hUniq0 (u₁ * u₂) (a₁ * a₂) (b₁ * b₂) (na₁ + na₂) (nb₁ + nb₂)
        (mul_ne_zero ha₁ ha₂) (mul_ne_zero hb₁ hb₂)
        (by
          change (a₁ : K) * (a₂ : K) = ((u₁ : K) * (u₂ : K)) * ((b₁ : K) * (b₂ : K))
          rw [hab₁, hab₂]
          ring)
        (by rw [← Ideal.span_singleton_mul_span_singleton, hsa₁, hsa₂, ← pow_add])
        (by rw [← Ideal.span_singleton_mul_span_singleton, hsb₁, hsb₂, ← pow_add])
      omega
    obtain ⟨v, hv_apply⟩ :
        ∃ v : Additive (Units K) →+ ℤ, ∀ u : Units K, v (Additive.ofMul u) = v0 u := by
      refine ⟨{ toFun := fun x => v0 (Additive.toMul x)
                map_zero' := by rw [toMul_zero, hv0_one]
                map_add' := fun x y => by rw [toMul_add, hv0_mul] }, ?_⟩
      intro u
      rfl
    have hEx : ∀ u : Units K,
        ∃ (a b : ↥V) (na nb : ℕ),
          a ≠ 0 ∧ b ≠ 0 ∧
          (a : K) = (u : K) * (b : K) ∧
          Ideal.span ({a} : Set ↥V) = mV ^ na ∧
          Ideal.span ({b} : Set ↥V) = mV ^ nb ∧
          v (Additive.ofMul u) = (na : ℤ) - (nb : ℤ) := by
      intro u
      rw [hv_apply]
      exact hEx0 u
    have hUniq : ∀ (u : Units K) (a b : ↥V) (na nb : ℕ),
        a ≠ 0 → b ≠ 0 →
        (a : K) = (u : K) * (b : K) →
        Ideal.span ({a} : Set ↥V) = mV ^ na →
        Ideal.span ({b} : Set ↥V) = mV ^ nb →
        v (Additive.ofMul u) = (na : ℤ) - (nb : ℤ) := by
      intro u a b na nb ha hb hab hsa hsb
      rw [hv_apply]
      exact hUniq0 u a b na nb ha hb hab hsa hsb
    have hv_mem : ∀ u : Units K, (u : K) ∈ V ↔ 0 ≤ v (Additive.ofMul u) := by
      intro u
      rw [hv_apply]
      by_cases hu : (u : K) ∈ V
      · simp [v0, hu]
      · constructor
        · intro h; exact False.elim (hu h)
        · intro hnonneg
          have hge1 : 1 ≤ ord ⟨((u⁻¹ : Units K) : K), hinv_mem hu⟩
              (hu_ne (hinv_mem hu) (u⁻¹).ne_zero) :=
            (hord_ge1_iff _ _).mpr (hinv_in_m hu)
          simp only [v0, hu, ↓reduceDIte] at hnonneg
          omega
    have hv_max : ∀ u : Units K,
        1 ≤ v (Additive.ofMul u) ↔ ∃ z ∈ mV, (z : K) = (u : K) := by
      intro u
      constructor
      · intro h1
        have hu : (u : K) ∈ V := (hv_mem u).mpr (by omega)
        rw [hv_apply] at h1
        simp only [v0, hu, ↓reduceDIte] at h1
        have h1_nat : 1 ≤ ord ⟨(u : K), hu⟩ (hu_ne hu u.ne_zero) := by omega
        exact ⟨⟨(u : K), hu⟩, (hord_ge1_iff _ _).mp h1_nat, rfl⟩
      · rintro ⟨z, hz_m, hz_eq⟩
        have hu : (u : K) ∈ V := hz_eq ▸ z.2
        have hz_sub : (⟨(u : K), hu⟩ : ↥V) = z := Subtype.ext hz_eq.symm
        have h1_nat : 1 ≤ ord ⟨(u : K), hu⟩ (hu_ne hu u.ne_zero) :=
          (hord_ge1_iff _ _).mpr (hz_sub ▸ hz_m)
        rw [hv_apply]
        simp only [v0, hu, ↓reduceDIte]
        omega
    have hv_ultra_le : ∀ (w₁ w₂ : Units K) (hw : (w₁ : K) + (w₂ : K) ≠ 0),
        v (Additive.ofMul w₁) ≤ v (Additive.ofMul w₂) →
        v (Additive.ofMul w₁) ≤ v (Additive.ofMul (Units.mk0 ((w₁ : K) + (w₂ : K)) hw)) := by
      intro w₁ w₂ hw hle
      have hq_nonneg : 0 ≤ v (Additive.ofMul (w₂ * w₁⁻¹)) := by
        rw [ofMul_mul, ofMul_inv, map_add, map_neg]
        omega
      have hq_mem : ((w₂ * w₁⁻¹ : Units K) : K) ∈ V := (hv_mem _).mpr hq_nonneg
      have h1q_mem : (1 : K) + ((w₂ * w₁⁻¹ : Units K) : K) ∈ V :=
        V.toSubring.add_mem V.one_mem hq_mem
      have hmul_sum : (w₁ : K) * ((1 : K) + ((w₂ * w₁⁻¹ : Units K) : K)) = (w₁ : K) + (w₂ : K) := by
        change (w₁ : K) * (1 + (w₂ : K) * ((w₁⁻¹ : Units K) : K)) = (w₁ : K) + (w₂ : K)
        rw [mul_add, mul_one, ← mul_assoc, mul_comm (w₁ : K) (w₂ : K), mul_assoc,
          Units.mul_inv, mul_one]
      have h1q_ne : (1 : K) + ((w₂ * w₁⁻¹ : Units K) : K) ≠ 0 :=
        right_ne_zero_of_mul (hmul_sum.symm ▸ hw)
      let u_fac : Units K := Units.mk0 ((1 : K) + ((w₂ * w₁⁻¹ : Units K) : K)) h1q_ne
      have hfac_nonneg : 0 ≤ v (Additive.ofMul u_fac) := (hv_mem u_fac).mp h1q_mem
      have hu_sum_eq : Units.mk0 ((w₁ : K) + (w₂ : K)) hw = w₁ * u_fac :=
        Units.ext hmul_sum.symm
      rw [hu_sum_eq, ofMul_mul, map_add]
      omega
    have hv_ultra : ∀ (u₁ u₂ : Units K) (h : (u₁ : K) + (u₂ : K) ≠ 0),
        min (v (Additive.ofMul u₁)) (v (Additive.ofMul u₂)) ≤
          v (Additive.ofMul (Units.mk0 ((u₁ : K) + (u₂ : K)) h)) := by
      intro u₁ u₂ h
      rcases le_total (v (Additive.ofMul u₁)) (v (Additive.ofMul u₂)) with hle | hle
      · rw [min_eq_left hle]
        exact hv_ultra_le u₁ u₂ h hle
      · rw [min_eq_right hle]
        have h' : (u₂ : K) + (u₁ : K) ≠ 0 := add_comm (u₁ : K) (u₂ : K) ▸ h
        have heq_u : Units.mk0 ((u₁ : K) + (u₂ : K)) h = Units.mk0 ((u₂ : K) + (u₁ : K)) h' :=
          Units.ext (add_comm _ _)
        rw [heq_u]
        exact hv_ultra_le u₂ u₁ h' hle
    exact ⟨v, hv_mem, hv_max, hv_ultra, hEx, hUniq⟩

  
  choose v_pt hv_mem hv_max hv_ultra hv_ex hv_uniq using
    fun x : Pt => hSinglePlace (V_pt x) (_hDVR_V x).1

  have hSuppFin : ∀ u : Units K,
      Set.Finite ({ x : Pt | (u : K) ∉ V_pt x } ∪ { x : Pt | ((u⁻¹ : Units K) : K) ∉ V_pt x }) :=
    fun u => (_hFinPole u).union (_hFinPole u⁻¹)
  have hSuppMem : ∀ (a : Additive (Units K)) (x : Pt),
      v_pt x a ≠ 0 → x ∈ (hSuppFin (Additive.toMul a)).toFinset := by
    intro a x hne
    rw [Set.Finite.mem_toFinset]
    let u := Additive.toMul a
    have ha : a = Additive.ofMul u := rfl
    rw [ha] at hne
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · left
      intro hu
      have h0 := (hv_mem x u).mp hu
      omega
    · right
      intro hu_inv
      have h0 : 0 ≤ v_pt x (Additive.ofMul u⁻¹) := (hv_mem x u⁻¹).mp hu_inv
      rw [ofMul_inv, map_neg] at h0
      omega

  obtain ⟨div_fn, hdiv_apply⟩ :
      ∃ div_fn : Additive (Units K) →+ (Pt →₀ ℤ),
        ∀ (a : Additive (Units K)) (x : Pt), div_fn a x = v_pt x a := by
    refine ⟨{ toFun := fun a => Finsupp.onFinset (hSuppFin (Additive.toMul a)).toFinset
                (fun x => v_pt x a) (hSuppMem a)
              map_zero' := by
                ext x
                simp [Finsupp.onFinset_apply]
              map_add' := fun a b => by
                ext x
                simp [Finsupp.onFinset_apply] }, ?_⟩
    intro a x
    simp [Finsupp.onFinset_apply]

  
  have hStalk : ∀ x : Pt,
      IsDiscreteValuationRing ↑(X.presheaf.stalk x.1) ∧
      (∀ u : Units K,
        (0 ≤ div_fn (Additive.ofMul u) x ↔
          ∃ r : ↑(X.presheaf.stalk x.1), algebraMap _ K r = (u : K)) ∧
        (1 ≤ div_fn (Additive.ofMul u) x ↔
          ∃ r ∈ IsLocalRing.maximalIdeal ↑(X.presheaf.stalk x.1),
            algebraMap _ K r = (u : K))) ∧
      (∀ (f : Units K) (d : ℤ),
        (∃ (a b : ↑(X.presheaf.stalk x.1)) (na nb : ℕ),
          a ≠ 0 ∧ b ≠ 0 ∧
          algebraMap _ K a = (f : K) * algebraMap _ K b ∧
          Ideal.span ({a} : Set ↑(X.presheaf.stalk x.1)) =
            (IsLocalRing.maximalIdeal ↑(X.presheaf.stalk x.1)) ^ na ∧
          Ideal.span ({b} : Set ↑(X.presheaf.stalk x.1)) =
            (IsLocalRing.maximalIdeal ↑(X.presheaf.stalk x.1)) ^ nb ∧
          d = (na : ℤ) - (nb : ℤ)) ↔
        (∃ (a b : ↥(V_pt x)) (na nb : ℕ),
          a ≠ 0 ∧ b ≠ 0 ∧
          (a : K) = (f : K) * (b : K) ∧
          Ideal.span ({a} : Set ↥(V_pt x)) = (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ na ∧
          Ideal.span ({b} : Set ↥(V_pt x)) = (IsLocalRing.maximalIdeal ↥(V_pt x)) ^ nb ∧
          d = (na : ℤ) - (nb : ℤ))) := by
    intro x
    let Rx : Type u := ↑(X.presheaf.stalk x.1)
    let mx : Ideal Rx := IsLocalRing.maximalIdeal Rx
    let mVx : Ideal ↥(V_pt x) := IsLocalRing.maximalIdeal ↥(V_pt x)
    obtain ⟨hDVR_Vx, e_x, he_x⟩ := _hDVR_V x
    have : IsDiscreteValuationRing ↥(V_pt x) := hDVR_Vx
    have hDVR_Rx : IsDiscreteValuationRing Rx :=
      IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing e_x.symm
    have hMapMax : Ideal.map e_x mx = mVx := by
      have : mx.IsMaximal := IsLocalRing.maximalIdeal.isMaximal Rx
      have hmax : (Ideal.map e_x mx).IsMaximal := Ideal.map_isMaximal_of_equiv e_x
      exact (IsLocalRing.isMaximal_iff ↥(V_pt x)).mp hmax
    have hMapMaxSymm : Ideal.map e_x.symm mVx = mx := by
      have : mVx.IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥(V_pt x)
      have hmax : (Ideal.map e_x.symm mVx).IsMaximal := Ideal.map_isMaximal_of_equiv e_x.symm
      exact (IsLocalRing.isMaximal_iff Rx).mp hmax
    refine ⟨hDVR_Rx, ?_, ?_⟩
    · intro u
      rw [hdiv_apply]
      constructor
      · rw [← hv_mem x u]
        constructor
        · intro hu
          refine ⟨e_x.symm ⟨(u : K), hu⟩, ?_⟩
          rw [← he_x, e_x.apply_symm_apply]
        · rintro ⟨r, hr⟩
          rw [← hr, ← he_x]
          exact (e_x r).2
      · rw [hv_max x u]
        constructor
        · rintro ⟨z, hz_m, hz_eq⟩
          refine ⟨e_x.symm z, ?_, ?_⟩
          · change e_x.symm z ∈ mx
            rw [← hMapMaxSymm]
            exact Ideal.mem_map_of_mem e_x.symm hz_m
          · rw [← he_x, e_x.apply_symm_apply, hz_eq]
        · rintro ⟨r, hr_m, hr_eq⟩
          refine ⟨e_x r, ?_, ?_⟩
          · change e_x r ∈ mVx
            rw [← hMapMax]
            exact Ideal.mem_map_of_mem e_x hr_m
          · rw [he_x, hr_eq]
    · intro f d
      constructor
      · rintro ⟨a, b, na, nb, ha, hb, hab, hsa, hsb, hd⟩
        refine ⟨e_x a, e_x b, na, nb,
          (map_ne_zero_iff e_x e_x.injective).mpr ha,
          (map_ne_zero_iff e_x e_x.injective).mpr hb,
          ?_, ?_, ?_, hd⟩
        · rw [he_x, he_x, hab]
        · have hmap := congrArg (Ideal.map e_x) hsa
          rwa [Ideal.map_span, Set.image_singleton, Ideal.map_pow, hMapMax] at hmap
        · have hmap := congrArg (Ideal.map e_x) hsb
          rwa [Ideal.map_span, Set.image_singleton, Ideal.map_pow, hMapMax] at hmap
      · rintro ⟨a, b, na, nb, ha, hb, hab, hsa, hsb, hd⟩
        refine ⟨e_x.symm a, e_x.symm b, na, nb,
          (map_ne_zero_iff e_x.symm e_x.symm.injective).mpr ha,
          (map_ne_zero_iff e_x.symm e_x.symm.injective).mpr hb,
          ?_, ?_, ?_, hd⟩
        · rw [← he_x, ← he_x, e_x.apply_symm_apply, e_x.apply_symm_apply, hab]
        · have hmap := congrArg (Ideal.map e_x.symm) hsa
          rwa [Ideal.map_span, Set.image_singleton, Ideal.map_pow, hMapMaxSymm] at hmap
        · have hmap := congrArg (Ideal.map e_x.symm) hsb
          rwa [Ideal.map_span, Set.image_singleton, Ideal.map_pow, hMapMaxSymm] at hmap

  have hRange : div_fn.range = weilCurvePrincipalSubgroup X := by
    let S_gen : Set (Pt →₀ ℤ) :=
      { D : Pt →₀ ℤ |
        ∃ f : Units K,
          ∀ x : Pt,
            let Rx := ↑(X.presheaf.stalk x.1)
            let mx := IsLocalRing.maximalIdeal Rx
            ∃ (a b : Rx) (na nb : ℕ),
              a ≠ 0 ∧ b ≠ 0 ∧
              algebraMap Rx K a = (f : K) * algebraMap Rx K b ∧
              Ideal.span ({a} : Set Rx) = mx ^ na ∧
              Ideal.span ({b} : Set Rx) = mx ^ nb ∧
              D x = (na : ℤ) - (nb : ℤ) }
    have hSetEq : (div_fn.range : Set (Pt →₀ ℤ)) = S_gen := by
      ext D
      simp only [SetLike.mem_coe, AddMonoidHom.mem_range]
      constructor
      · rintro ⟨a_mul, rfl⟩
        let f : Units K := Additive.toMul a_mul
        refine ⟨f, fun x => ?_⟩
        rw [((hStalk x).2.2 f (div_fn a_mul x))]
        obtain ⟨a, b, na, nb, ha, hb, hab, hsa, hsb, hv⟩ := hv_ex x f
        refine ⟨a, b, na, nb, ha, hb, hab, hsa, hsb, ?_⟩
        rw [hdiv_apply]
        exact hv
      · rintro ⟨f, hf⟩
        refine ⟨Additive.ofMul f, ?_⟩
        ext x
        obtain ⟨a, b, na, nb, ha, hb, hab, hsa, hsb, hd⟩ :=
          ((hStalk x).2.2 f (D x)).mp (hf x)
        rw [hdiv_apply, hd]
        exact hv_uniq x f a b na nb ha hb hab hsa hsb
    change div_fn.range = AddSubgroup.closure S_gen
    rw [← hSetEq, AddSubgroup.closure_eq]

  
  have hConst : ∀ (c : Units k),
      div_fn (Additive.ofMul (Units.map k_to_K.toMonoidHom c)) = 0 := by
    intro c
    let u_c : Units K := Units.map k_to_K.toMonoidHom c
    have hmem_pos : ∀ x : Pt, 0 ≤ div_fn (Additive.ofMul u_c) x := by
      intro x
      rw [hdiv_apply, ← hv_mem x u_c]
      exact (_hGlobalConst (u_c : K)).mpr ⟨(c : k), rfl⟩ x
    have hmem_neg : ∀ x : Pt, 0 ≤ div_fn (Additive.ofMul u_c⁻¹) x := by
      intro x
      rw [hdiv_apply, ← hv_mem x u_c⁻¹]
      exact (_hGlobalConst ((u_c⁻¹ : Units K) : K)).mpr ⟨((c⁻¹ : Units k) : k), rfl⟩ x
    ext x
    change div_fn (Additive.ofMul u_c) x = 0
    have h1 := hmem_pos x
    have h2 := hmem_neg x
    rw [ofMul_inv, map_neg, Finsupp.neg_apply] at h2
    omega

  have hMkEq_add : ∀ (D : Pt →₀ ℤ) (u : Units K),
      QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) (div_fn (Additive.ofMul u) + D) =
        QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) D := by
    intro D u
    rw [← sub_eq_zero, ← map_sub, add_sub_cancel_right,
      QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff, ← hRange]
    exact ⟨Additive.ofMul u, rfl⟩

  have hMkEq_iff : ∀ (E' D : Pt →₀ ℤ),
      QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) E' =
        QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) D →
      ∃ u : Units K, E' = div_fn (Additive.ofMul u) + D := by
    intro E' D hEq
    have hmem : E' - D ∈ div_fn.range := by
      rw [hRange, ← QuotientAddGroup.eq_zero_iff, ← QuotientAddGroup.mk'_apply, map_sub]
      exact sub_eq_zero.mpr hEq
    obtain ⟨a, ha⟩ := hmem
    refine ⟨Additive.toMul a, ?_⟩
    change E' = div_fn a + D
    rw [ha, sub_add_cancel]

  have hEffIff : ∀ D : Pt →₀ ℤ,
      weilCurveEffSubsingleton X D ↔
        ∀ u₁ u₂ : Units K,
          (∀ x : Pt, 0 ≤ div_fn (Additive.ofMul u₁) x + D x) →
          (∀ x : Pt, 0 ≤ div_fn (Additive.ofMul u₂) x + D x) →
          ∃ c : k, (u₁ : K) = k_to_K c * (u₂ : K) := by
    intro D
    constructor
    · intro hSub u₁ u₂ h₁ h₂
      let E₁ : Pt →₀ ℤ := div_fn (Additive.ofMul u₁) + D
      let E₂ : Pt →₀ ℤ := div_fn (Additive.ofMul u₂) + D
      have hSubEq :
          (⟨E₁, h₁, hMkEq_add D u₁⟩ :
            { E' : Pt →₀ ℤ // (∀ x, 0 ≤ E' x) ∧
              QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) E' =
                QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) D }) =
          ⟨E₂, h₂, hMkEq_add D u₂⟩ :=
        @Subsingleton.elim _ hSub _ _
      have hE_eq : E₁ = E₂ := congrArg Subtype.val hSubEq
      have hdiv_eq : div_fn (Additive.ofMul u₁) = div_fn (Additive.ofMul u₂) :=
        add_right_cancel hE_eq
      have hq_zero : div_fn (Additive.ofMul (u₁ * u₂⁻¹)) = 0 := by
        rw [ofMul_mul, ofMul_inv, map_add, map_neg, hdiv_eq, add_neg_cancel]
      have hq_mem : ∀ x : Pt, ((u₁ * u₂⁻¹ : Units K) : K) ∈ V_pt x := by
        intro x
        rw [hv_mem x (u₁ * u₂⁻¹), ← hdiv_apply, hq_zero]
        rfl
      obtain ⟨c, hc⟩ := (_hGlobalConst ((u₁ * u₂⁻¹ : Units K) : K)).mp hq_mem
      refine ⟨c, ?_⟩
      calc
        (u₁ : K) = ((u₁ * u₂⁻¹ : Units K) : K) * (u₂ : K) := by
          change (u₁ : K) = (u₁ : K) * ((u₂⁻¹ : Units K) : K) * (u₂ : K)
          rw [mul_assoc, Units.inv_mul, mul_one]
        _ = k_to_K c * (u₂ : K) := by rw [← hc]
    · intro hProp
      refine ⟨fun a₁ a₂ => Subtype.ext ?_⟩
      obtain ⟨u₁, hu₁⟩ := hMkEq_iff a₁.1 D a₁.2.2
      obtain ⟨u₂, hu₂⟩ := hMkEq_iff a₂.1 D a₂.2.2
      have h₁ : ∀ x : Pt, 0 ≤ div_fn (Additive.ofMul u₁) x + D x := by
        intro x
        have hx := a₁.2.1 x
        rwa [hu₁, Finsupp.add_apply] at hx
      have h₂ : ∀ x : Pt, 0 ≤ div_fn (Additive.ofMul u₂) x + D x := by
        intro x
        have hx := a₂.2.1 x
        rwa [hu₂, Finsupp.add_apply] at hx
      obtain ⟨c, hc⟩ := hProp u₁ u₂ h₁ h₂
      have hc_ne : c ≠ 0 := by
        intro hc0
        rw [hc0, map_zero, zero_mul] at hc
        exact u₁.ne_zero hc
      have hu₁_eq : u₁ = Units.map k_to_K.toMonoidHom (Units.mk0 c hc_ne) * u₂ :=
        Units.ext hc
      rw [hu₁, hu₂, hu₁_eq, ofMul_mul, map_add, hConst, zero_add]

  have hMinEff : ∀ (P₀ : Pt) (D : Pt →₀ ℤ),
      (∀ E' : Pt →₀ ℤ,
        (∀ x, 0 ≤ E' x) →
        QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) E' =
          QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) D →
        E' P₀ = 0) →
      weilCurveEffSubsingleton X D := by
    intro P₀ D hZero
    rw [hEffIff D]
    intro u₁ u₂ h₁ h₂
    have hE₁_P₀ : div_fn (Additive.ofMul u₁) P₀ + D P₀ = 0 :=
      hZero (div_fn (Additive.ofMul u₁) + D) h₁ (hMkEq_add D u₁)
    have hE₂_P₀ : div_fn (Additive.ofMul u₂) P₀ + D P₀ = 0 :=
      hZero (div_fn (Additive.ofMul u₂) + D) h₂ (hMkEq_add D u₂)
    let q : Units K := u₁ * u₂⁻¹
    have hq_P₀ : div_fn (Additive.ofMul q) P₀ = 0 := by
      change div_fn (Additive.ofMul (u₁ * u₂⁻¹)) P₀ = 0
      rw [ofMul_mul, ofMul_inv, map_add, map_neg, Finsupp.add_apply, Finsupp.neg_apply]
      omega
    have hq_mem : (q : K) ∈ V_pt P₀ := by
      rw [hv_mem P₀ q, ← hdiv_apply]
      omega
    obtain ⟨c, hc_mem, hz_diff⟩ := _hRes_k P₀ ⟨(q : K), hq_mem⟩
    refine ⟨c, ?_⟩
    by_contra hne
    have hdiff_ne : (q : K) - k_to_K c ≠ 0 := by
      intro h0
      apply hne
      have hqc : (q : K) = k_to_K c := sub_eq_zero.mp h0
      calc
        (u₁ : K) = (q : K) * (u₂ : K) := by
          change (u₁ : K) = (u₁ : K) * ((u₂⁻¹ : Units K) : K) * (u₂ : K)
          rw [mul_assoc, Units.inv_mul, mul_one]
        _ = k_to_K c * (u₂ : K) := by rw [hqc]
    let u_δ : Units K := Units.mk0 ((q : K) - k_to_K c) hdiff_ne
    have hu_δ_ge1 : 1 ≤ div_fn (Additive.ofMul u_δ) P₀ := by
      rw [hdiv_apply, hv_max P₀ u_δ]
      exact ⟨⟨(q : K), hq_mem⟩ - ⟨k_to_K c, hc_mem⟩, hz_diff, rfl⟩
    have hc_ne : c ≠ 0 := by
      intro hc0
      have hu_δ_eq : u_δ = q := by
        apply Units.ext
        change (q : K) - k_to_K c = (q : K)
        rw [hc0, map_zero, sub_zero]
      rw [hu_δ_eq, hq_P₀] at hu_δ_ge1
      omega
    let w₂ : Units K :=
      Units.map k_to_K.toMonoidHom (Units.mk0 (-c) (neg_ne_zero.mpr hc_ne)) * u₂
    have hw₂_div : div_fn (Additive.ofMul w₂) = div_fn (Additive.ofMul u₂) := by
      change div_fn (Additive.ofMul
        (Units.map k_to_K.toMonoidHom (Units.mk0 (-c) (neg_ne_zero.mpr hc_ne)) * u₂)) = _
      rw [ofMul_mul, map_add, hConst, zero_add]
    have hsum_eq : (u₁ : K) + (w₂ : K) = (u₁ : K) - k_to_K c * (u₂ : K) := by
      change (u₁ : K) + k_to_K (-c) * (u₂ : K) = (u₁ : K) - k_to_K c * (u₂ : K)
      rw [map_neg, neg_mul, sub_eq_add_neg]
    have hsum_ne : (u₁ : K) + (w₂ : K) ≠ 0 := by
      rw [hsum_eq]
      exact sub_ne_zero.mpr hne
    let u₃ : Units K := Units.mk0 ((u₁ : K) + (w₂ : K)) hsum_ne
    have hu₃_fac : u₃ = u_δ * u₂ := by
      apply Units.ext
      change (u₁ : K) + (w₂ : K) = ((q : K) - k_to_K c) * (u₂ : K)
      rw [hsum_eq, sub_mul]
      congr 1
      change (u₁ : K) = (u₁ : K) * ((u₂⁻¹ : Units K) : K) * (u₂ : K)
      rw [mul_assoc, Units.inv_mul, mul_one]
    let E₃ : Pt →₀ ℤ := div_fn (Additive.ofMul u₃) + D
    have hE₃_pos : ∀ x : Pt, 0 ≤ E₃ x := by
      intro x
      have hult : min (div_fn (Additive.ofMul u₁) x) (div_fn (Additive.ofMul w₂) x) ≤
          div_fn (Additive.ofMul u₃) x := by
        rw [hdiv_apply, hdiv_apply, hdiv_apply]
        exact hv_ultra x u₁ w₂ hsum_ne
      rw [hw₂_div] at hult
      have h1x := h₁ x
      have h2x := h₂ x
      change 0 ≤ div_fn (Additive.ofMul u₃) x + D x
      omega
    have hE₃_P₀_zero : E₃ P₀ = 0 := hZero E₃ hE₃_pos (hMkEq_add D u₃)
    have hE₃_P₀_ge1 : 1 ≤ E₃ P₀ := by
      change 1 ≤ div_fn (Additive.ofMul u₃) P₀ + D P₀
      rw [hu₃_fac, ofMul_mul, map_add, Finsupp.add_apply]
      omega
    omega

  refine ⟨div_fn, ?_, hRange, ?_, hConst, ?_, hEffIff, hMinEff⟩
  · intro u x
    rw [hdiv_apply]
    exact hv_mem x u
  · intro u₁ u₂ h x
    rw [hdiv_apply, hdiv_apply, hdiv_apply]
    exact hv_ultra x u₁ u₂ h
  · intro x
    exact ⟨(hStalk x).1, (hStalk x).2.1⟩

theorem weil_standardSmooth_dim_one_away_taylor_etale_coord (k : Type u) [Field k]
    (B₀ : Type u) [CommRing B₀]
    (φ_k : k →+* B₀)
    (q : Ideal B₀) [q.IsPrime]
    (f₀ : B₀) (_hf₀ : f₀ ∉ q)
    (c₀ : k) (_hc₀ : f₀ - φ_k c₀ ∈ q)
    (_hSm : RingHom.IsStandardSmoothOfRelativeDimension 1
      ((algebraMap B₀ (Localization.Away f₀)).comp φ_k)) :
    ∃ (g_x z_x : B₀),
      g_x ∉ q ∧
      (Polynomial.eval₂RingHom
        ((algebraMap B₀ (Localization.Away g_x)).comp φ_k)
        (algebraMap B₀ (Localization.Away g_x) z_x)).Etale :=
by
  suffices hGen₀ : ∀ (S₀ : Type u) [CommRing S₀] [Algebra B₀ S₀] [IsLocalization.Away f₀ S₀],
      RingHom.IsStandardSmoothOfRelativeDimension 1 ((algebraMap B₀ S₀).comp φ_k) →
      ∃ (g_x z_x : B₀),
        g_x ∉ q ∧
        (Polynomial.eval₂RingHom
          ((algebraMap B₀ (Localization.Away g_x)).comp φ_k)
          (algebraMap B₀ (Localization.Away g_x) z_x)).Etale from
    hGen₀ (Localization.Away f₀) _hSm
  intro S₀ _ _ _ hSm₀
  let ι_f₀ : B₀ →+* S₀ := algebraMap B₀ S₀
  let _ : Algebra k B₀ := φ_k.toAlgebra
  let _ : Algebra k S₀ := (ι_f₀.comp φ_k).toAlgebra
  have _ : IsScalarTower k B₀ S₀ := IsScalarTower.of_algebraMap_eq' rfl
  have _ : Algebra.IsStandardSmooth k S₀ := (hSm₀.isStandardSmooth).toAlgebra
  obtain ⟨g_mv, hg_mv_comp, hg_mv_et⟩ := hSm₀.exists_etale_mvPolynomial
  let e_poly : MvPolynomial (Fin 1) k ≃ₐ[k] Polynomial k := MvPolynomial.uniqueAlgEquiv k (Fin 1)
  let ψ_w : Polynomial k →+* S₀ := g_mv.comp e_poly.symm.toRingHom
  let w_x : S₀ := ψ_w Polynomial.X
  have hψ_w_C : ∀ c : k, ψ_w (Polynomial.C c) = algebraMap k S₀ c := by
    intro c
    have hcomm : e_poly.symm (Polynomial.C c) = MvPolynomial.C c := e_poly.symm.commutes c
    change g_mv (e_poly.symm (Polynomial.C c)) = (ι_f₀.comp φ_k) c
    rw [hcomm, ← hg_mv_comp]
    rfl
  have hψ_w_et : ψ_w.Etale :=
    RingHom.Etale.stableUnderComposition _ _
      (RingHom.Etale.of_bijective e_poly.symm.bijective) hg_mv_et
  have hBasis0 : ∃ e_Ω0 : S₀ ≃ₗ[S₀] Ω[S₀⁄k],
      ∀ s : S₀, e_Ω0 s = s • KaehlerDifferential.D k S₀ w_x := by
    let _ : Algebra (Polynomial k) S₀ := ψ_w.toAlgebra
    have _ : IsScalarTower k (Polynomial k) S₀ :=
      IsScalarTower.of_algebraMap_eq fun c => (hψ_w_C c).symm
    have _ : Algebra.Etale (Polynomial k) S₀ := RingHom.etale_algebraMap.mp hψ_w_et
    let e_tp0 : TensorProduct (Polynomial k) S₀ Ω[Polynomial k⁄k] ≃ₗ[S₀] S₀ :=
      (TensorProduct.AlgebraTensorModule.congr
        (LinearEquiv.refl S₀ S₀) (KaehlerDifferential.polynomialEquiv k)).trans
        (TensorProduct.AlgebraTensorModule.rid (Polynomial k) S₀ S₀)
    let e_Ω0 : S₀ ≃ₗ[S₀] Ω[S₀⁄k] :=
      e_tp0.symm.trans (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k (Polynomial k) S₀)
    have he1 : e_Ω0 1 = KaehlerDifferential.D k S₀ w_x := by
      dsimp [e_Ω0, e_tp0]
      rw [one_smul,
        KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
        KaehlerDifferential.mapBaseChange_tmul, one_smul,
        KaehlerDifferential.map_D k k (Polynomial k) S₀ Polynomial.X]
      rfl
    refine ⟨e_Ω0, fun s => ?_⟩
    calc
      e_Ω0 s = e_Ω0 (s • (1 : S₀)) := by rw [smul_eq_mul, mul_one]
      _ = s • e_Ω0 1 := e_Ω0.map_smul s 1
      _ = s • KaehlerDifferential.D k S₀ w_x := by rw [he1]
  obtain ⟨e_Ω0, he_Ω0⟩ := hBasis0
  have hc₀_ne : c₀ ≠ 0 := by
    intro hc0
    apply _hf₀
    have hmem : f₀ - φ_k 0 ∈ q := hc0 ▸ _hc₀
    rwa [map_zero, sub_zero] at hmem
  let M_q : Ideal S₀ := Ideal.map ι_f₀ q
  have hDisj : Disjoint (Submonoid.powers f₀ : Set B₀) (q : Set B₀) :=
    (Ideal.disjoint_powers_iff_notMem f₀ (Ideal.IsPrime.isRadical ‹q.IsPrime›)).mpr _hf₀
  have hMq_prime : M_q.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f₀) S₀ q ‹q.IsPrime› hDisj
  have h1_not_Mq : (1 : S₀) ∉ M_q := by
    intro h1
    exact hMq_prime.ne_top ((Ideal.eq_top_iff_one M_q).mpr h1)
  obtain ⟨m, a, hw_x⟩ := IsLocalization.Away.surj f₀ w_x
  let δ : B₀ := φ_k ((c₀⁻¹) ^ m) * f₀ ^ m - 1
  let z_x : B₀ := a * φ_k ((c₀⁻¹) ^ m) * (1 - δ)
  have hδ_q : δ ∈ q := by
    let π_q : B₀ →+* B₀ ⧸ q := Ideal.Quotient.mk q
    have hf₀_mod : π_q f₀ = π_q (φ_k c₀) := Ideal.Quotient.eq.mpr _hc₀
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change π_q (φ_k ((c₀⁻¹) ^ m) * f₀ ^ m - 1) = 0
    rw [map_sub, map_mul, π_q.map_pow f₀ m, hf₀_mod, ← π_q.map_pow, ← φ_k.map_pow c₀ m,
      ← π_q.map_mul, ← φ_k.map_mul, ← mul_pow, inv_mul_cancel₀ hc₀_ne, one_pow,
      map_one, map_one, sub_self]
  have hδ_Mq : ι_f₀ δ ∈ M_q := Ideal.mem_map_of_mem ι_f₀ hδ_q
  have hz_x_eq : ι_f₀ z_x = w_x * (1 - (ι_f₀ δ) ^ 2) := by
    have hunit_fm : IsUnit (ι_f₀ f₀ ^ m) := IsLocalization.Away.algebraMap_pow_isUnit f₀ m
    apply hunit_fm.mul_right_cancel
    have hδ_expand : ι_f₀ (φ_k ((c₀⁻¹) ^ m)) * ι_f₀ f₀ ^ m = 1 + ι_f₀ δ := by
      dsimp [δ]
      rw [map_sub, map_mul, ι_f₀.map_pow f₀ m, map_one]
      ring
    calc
      ι_f₀ z_x * ι_f₀ f₀ ^ m
          = ι_f₀ a * (ι_f₀ (φ_k ((c₀⁻¹) ^ m)) * ι_f₀ f₀ ^ m) * (1 - ι_f₀ δ) := by
            dsimp [z_x]
            rw [map_mul, map_mul, map_sub, map_one]
            ring
      _ = (w_x * ι_f₀ f₀ ^ m) * (1 + ι_f₀ δ) * (1 - ι_f₀ δ) := by
            rw [← hw_x, hδ_expand]
      _ = (w_x * (1 - (ι_f₀ δ) ^ 2)) * ι_f₀ f₀ ^ m := by ring
  let D₀ : Derivation k S₀ Ω[S₀⁄k] := KaehlerDifferential.D k S₀
  let s_δ : S₀ := e_Ω0.symm (D₀ (ι_f₀ δ))
  have hD_δ : D₀ (ι_f₀ δ) = s_δ • D₀ w_x := by
    have h1 : e_Ω0 s_δ = D₀ (ι_f₀ δ) := e_Ω0.apply_symm_apply _
    exact h1.symm.trans (he_Ω0 s_δ)
  let u : S₀ := (1 - (ι_f₀ δ) ^ 2) - 2 * w_x * ι_f₀ δ * s_δ
  have hD_zx : D₀ (ι_f₀ z_x) = u • D₀ w_x := by
    have hz_sq : ι_f₀ z_x = w_x * (1 - ι_f₀ δ * ι_f₀ δ) := by
      rw [hz_x_eq, sq]
    have hD_δ2 : D₀ (1 - ι_f₀ δ * ι_f₀ δ) = (-(2 * ι_f₀ δ * s_δ)) • D₀ w_x := by
      rw [Derivation.map_sub, D₀.map_one_eq_zero, zero_sub, D₀.leibniz, hD_δ,
        smul_smul, ← add_smul, ← neg_smul]
      congr 1
      ring
    rw [hz_sq, D₀.leibniz, hD_δ2, smul_smul, ← add_smul]
    congr 1
    dsimp [u]
    ring
  have hu_not_Mq : u ∉ M_q := by
    intro hu_in
    have h1_sub_u : 1 - u ∈ M_q := by
      have heq : 1 - u = ι_f₀ δ * (ι_f₀ δ + 2 * w_x * s_δ) := by
        dsimp [u]
        ring
      rw [heq]
      exact M_q.mul_mem_right _ hδ_Mq
    have h1_in : (1 - u) + u ∈ M_q := M_q.add_mem h1_sub_u hu_in
    rw [sub_add_cancel] at h1_in
    exact h1_not_Mq h1_in
  obtain ⟨r, h, hu_clear⟩ := IsLocalization.Away.surj f₀ u
  have hh_not_q : h ∉ q := by
    intro hh_in
    have hh_Mq : ι_f₀ h ∈ M_q := Ideal.mem_map_of_mem ι_f₀ hh_in
    rw [← hu_clear] at hh_Mq
    rcases hMq_prime.mem_or_mem hh_Mq with hu_in | hpow_in
    · exact hu_not_Mq hu_in
    · have hunit_fr : IsUnit (ι_f₀ f₀ ^ r) := IsLocalization.Away.algebraMap_pow_isUnit f₀ r
      rcases hunit_fr.exists_right_inv with ⟨v_inv, hv_inv⟩
      have h1_in : ι_f₀ f₀ ^ r * v_inv ∈ M_q := M_q.mul_mem_right v_inv hpow_in
      rw [hv_inv] at h1_in
      exact h1_not_Mq h1_in
  let g_x : B₀ := h * f₀
  have hg_x_not_q : g_x ∉ q := Ideal.IsPrime.mul_notMem ‹q.IsPrime› hh_not_q _hf₀
  refine ⟨g_x, z_x, hg_x_not_q, ?_⟩
  suffices hGen₁ : ∀ (S₁ : Type u) [CommRing S₁] [Algebra S₀ S₁]
      [IsLocalization.Away (ι_f₀ h) S₁],
      (Polynomial.eval₂RingHom
        ((algebraMap B₀ (Localization.Away g_x)).comp φ_k)
        (algebraMap B₀ (Localization.Away g_x) z_x)).Etale from
    hGen₁ (Localization.Away (ι_f₀ h))
  intro S₁ _ _ _
  let _ : Algebra B₀ S₁ := ((algebraMap S₀ S₁).comp ι_f₀).toAlgebra
  have _ : IsScalarTower B₀ S₀ S₁ := IsScalarTower.of_algebraMap_eq' rfl
  let _ : Algebra k S₁ := ((algebraMap B₀ S₁).comp φ_k).toAlgebra
  have _ : IsScalarTower k B₀ S₁ := IsScalarTower.of_algebraMap_eq' rfl
  have _ : IsScalarTower k S₀ S₁ := IsScalarTower.of_algebraMap_eq' rfl
  let _ : SMulCommClass k S₀ S₁ := SMulCommClass.of_commMonoid k S₀ S₁
  let ψ₁ : Polynomial k →+* S₁ :=
    Polynomial.eval₂RingHom ((algebraMap B₀ S₁).comp φ_k) (algebraMap B₀ S₁ z_x)
  let _ : Algebra (Polynomial k) S₁ := ψ₁.toAlgebra
  have _ : IsScalarTower k (Polynomial k) S₁ :=
    IsScalarTower.of_algebraMap_eq fun c => (Polynomial.eval₂_C _ _).symm
  have hu_unit : IsUnit (algebraMap S₀ S₁ u) := by
    have hmul : algebraMap S₀ S₁ u * algebraMap S₀ S₁ (ι_f₀ f₀ ^ r) =
        algebraMap S₀ S₁ (ι_f₀ h) := by
      rw [← map_mul, hu_clear]
    have hh_unit : IsUnit (algebraMap S₀ S₁ (ι_f₀ h)) :=
      IsLocalization.Away.algebraMap_isUnit (ι_f₀ h)
    rw [← hmul] at hh_unit
    exact isUnit_of_mul_isUnit_left hh_unit
  have _ : Algebra.Smooth S₀ S₁ := Algebra.Smooth.of_isLocalization_Away (ι_f₀ h)
  have _ : Algebra.Smooth k S₁ := Algebra.Smooth.comp k S₀ S₁
  have _ : Algebra.FinitePresentation (Polynomial k) S₁ :=
    Algebra.FinitePresentation.of_restrict_scalars_finitePresentation k (Polynomial k) S₁
  have _ : Algebra.FormallyEtale S₀ S₁ :=
    Algebra.FormallyEtale.of_isLocalization (Submonoid.powers (ι_f₀ h))
  let M_map : TensorProduct (Polynomial k) S₁ Ω[Polynomial k⁄k] →ₗ[S₁] Ω[S₁⁄k] :=
    KaehlerDifferential.mapBaseChange k (Polynomial k) S₁
  let e_dom : TensorProduct (Polynomial k) S₁ Ω[Polynomial k⁄k] ≃ₗ[S₁] S₁ :=
    (TensorProduct.AlgebraTensorModule.congr
      (LinearEquiv.refl S₁ S₁) (KaehlerDifferential.polynomialEquiv k)).trans
      (TensorProduct.AlgebraTensorModule.rid (Polynomial k) S₁ S₁)
  let e_tp1 : TensorProduct S₀ S₁ Ω[S₀⁄k] ≃ₗ[S₁] S₁ :=
    (TensorProduct.AlgebraTensorModule.congr
      (LinearEquiv.refl S₁ S₁) e_Ω0.symm).trans
      (TensorProduct.AlgebraTensorModule.rid S₀ S₁ S₁)
  let e_cod : S₁ ≃ₗ[S₁] Ω[S₁⁄k] :=
    e_tp1.symm.trans (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k S₀ S₁)
  have he_cod_1 : e_cod 1 = KaehlerDifferential.D k S₁ (algebraMap S₀ S₁ w_x) := by
    dsimp [e_cod, e_tp1]
    rw [he_Ω0 1, one_smul,
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
      KaehlerDifferential.mapBaseChange_tmul, one_smul,
      KaehlerDifferential.map_D k k S₀ S₁ w_x]
  have hM_gen : M_map (e_dom.symm 1) = e_cod (algebraMap S₀ S₁ u) := by
    have he_dom_1 : e_dom.symm 1 =
        (1 : S₁) ⊗ₜ[Polynomial k] KaehlerDifferential.D k (Polynomial k) Polynomial.X := by
      dsimp [e_dom]
      rw [one_smul]
    have hψ₁_X : algebraMap (Polynomial k) S₁ Polynomial.X = algebraMap S₀ S₁ (ι_f₀ z_x) := by
      change ψ₁ Polynomial.X = algebraMap S₀ S₁ (ι_f₀ z_x)
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      rfl
    have he_cod_u : e_cod (algebraMap S₀ S₁ u) =
        (algebraMap S₀ S₁ u) • KaehlerDifferential.D k S₁ (algebraMap S₀ S₁ w_x) := by
      calc
        e_cod (algebraMap S₀ S₁ u) = e_cod ((algebraMap S₀ S₁ u) • (1 : S₁)) := by
          rw [smul_eq_mul, mul_one]
        _ = (algebraMap S₀ S₁ u) • e_cod 1 := e_cod.map_smul _ 1
        _ = (algebraMap S₀ S₁ u) • KaehlerDifferential.D k S₁ (algebraMap S₀ S₁ w_x) := by
          rw [he_cod_1]
    rw [he_dom_1, he_cod_u]
    dsimp [M_map]
    rw [KaehlerDifferential.mapBaseChange_tmul, one_smul,
      KaehlerDifferential.map_D k k (Polynomial k) S₁ Polynomial.X,
      hψ₁_X, ← KaehlerDifferential.map_D k k S₀ S₁ (ι_f₀ z_x)]
    change KaehlerDifferential.map k k S₀ S₁ (D₀ (ι_f₀ z_x)) = _
    rw [hD_zx, map_smul, algebraMap_smul, KaehlerDifferential.map_D k k S₀ S₁ w_x]
  let L_end : S₁ →ₗ[S₁] S₁ :=
    e_cod.symm.toLinearMap.comp (M_map.comp e_dom.symm.toLinearMap)
  have hL_apply : ∀ t : S₁, L_end t = t * algebraMap S₀ S₁ u := by
    intro t
    have hL_1 : L_end 1 = algebraMap S₀ S₁ u := by
      dsimp [L_end]
      rw [hM_gen, e_cod.symm_apply_apply]
    calc
      L_end t = L_end (t • (1 : S₁)) := by rw [smul_eq_mul, mul_one]
      _ = t • L_end 1 := L_end.map_smul t 1
      _ = t * algebraMap S₀ S₁ u := by rw [hL_1, smul_eq_mul]
  have hL_bij : Function.Bijective L_end := by
    rcases hu_unit.exists_right_inv with ⟨v_inv, hv_inv⟩
    constructor
    · intro t₁ t₂ ht
      rw [hL_apply, hL_apply] at ht
      exact hu_unit.mul_right_cancel ht
    · intro y
      refine ⟨y * v_inv, ?_⟩
      rw [hL_apply, mul_assoc]
      have hcomm : v_inv * algebraMap S₀ S₁ u = 1 := by
        rw [mul_comm]
        exact hv_inv
      rw [hcomm, mul_one]
  have hM_bij : Function.Bijective M_map := by
    have hM_eq : (M_map : TensorProduct (Polynomial k) S₁ Ω[Polynomial k⁄k] → Ω[S₁⁄k]) =
        e_cod ∘ L_end ∘ e_dom := by
      ext x
      dsimp [L_end]
      rw [e_dom.symm_apply_apply, e_cod.apply_symm_apply]
    rw [hM_eq]
    exact e_cod.bijective.comp (hL_bij.comp e_dom.bijective)
  have hSub_Ω : Subsingleton Ω[S₁⁄Polynomial k] := by
    have h0 : ∀ ω : Ω[S₁⁄Polynomial k], ω = 0 := by
      intro ω
      obtain ⟨η, rfl⟩ := KaehlerDifferential.map_surjective k (Polynomial k) S₁ ω
      obtain ⟨ξ, rfl⟩ := hM_bij.2 η
      exact (KaehlerDifferential.exact_mapBaseChange_map k (Polynomial k) S₁ (M_map ξ)).mpr ⟨ξ, rfl⟩
    exact ⟨fun a b => (h0 a).trans (h0 b).symm⟩
  have hSub_H1 : Subsingleton (Algebra.H1Cotangent (Polynomial k) S₁) := by
    have h0 : ∀ x : Algebra.H1Cotangent (Polynomial k) S₁, x = 0 := by
      intro x
      have hδM : M_map (Algebra.H1Cotangent.δ k (Polynomial k) S₁ x) = 0 :=
        (Algebra.H1Cotangent.exact_δ_mapBaseChange k (Polynomial k) S₁ _).mpr ⟨x, rfl⟩
      have hδ0 : Algebra.H1Cotangent.δ k (Polynomial k) S₁ x = 0 :=
        hM_bij.1 (hδM.trans M_map.map_zero.symm)
      obtain ⟨y, rfl⟩ := (Algebra.H1Cotangent.exact_map_δ k (Polynomial k) S₁ x).mp hδ0
      have hy0 : y = 0 := Subsingleton.elim y 0
      rw [hy0, map_zero]
    exact ⟨fun a b => (h0 a).trans (h0 b).symm⟩
  have _ : Algebra.FormallyEtale (Polynomial k) S₁ := Algebra.FormallyEtale.mk hSub_Ω hSub_H1
  have _ : Algebra.Etale (Polynomial k) S₁ := Algebra.Etale.mk
  have hψ₁_et : ψ₁.Etale := RingHom.etale_algebraMap.mpr inferInstance
  have _ : IsLocalization.Away g_x S₁ := IsLocalization.Away.mul S₀ S₁ f₀ h
  let e_loc : S₁ ≃ₐ[B₀] Localization.Away g_x :=
    IsLocalization.algEquiv (Submonoid.powers g_x) S₁ (Localization.Away g_x)
  let ψ_g : Polynomial k →+* Localization.Away g_x :=
    Polynomial.eval₂RingHom
      ((algebraMap B₀ (Localization.Away g_x)).comp φ_k)
      (algebraMap B₀ (Localization.Away g_x) z_x)
  have hcomp_ψ : e_loc.toRingHom.comp ψ₁ = ψ_g := by
    apply Polynomial.ringHom_ext'
    · ext c
      dsimp [ψ₁, ψ_g]
      rw [Polynomial.eval₂_C, Polynomial.eval₂_C]
      exact e_loc.commutes (φ_k c)
    · dsimp [ψ₁, ψ_g]
      rw [Polynomial.eval₂_X, Polynomial.eval₂_X]
      exact e_loc.commutes z_x
  change ψ_g.Etale
  rw [← hcomp_ψ]
  exact RingHom.Etale.stableUnderComposition _ _ hψ₁_et
    (RingHom.Etale.of_bijective e_loc.bijective)

theorem weil_valuative_integral_pid_free_basis_and_pole_truncation (k : Type u) [Field k]
    (K : Type u) [Field K]
    (B₀ B₁ : Type u) [CommRing B₀] [IsDomain B₀] [CommRing B₁] [IsDomain B₁]
    (k_to_K : k →+* K)
    (φ₀ : k →+* B₀) (_hFT₀ : φ₀.FiniteType)
    (φ₁ : k →+* B₁) (_hFT₁ : φ₁.FiniteType)
    (ι₀ : B₀ →+* K) (_hInj₀ : Function.Injective ι₀) (_hComp₀ : ι₀.comp φ₀ = k_to_K)
    (ι₁ : B₁ →+* K) (_hInj₁ : Function.Injective ι₁) (_hComp₁ : ι₁.comp φ₁ = k_to_K)
    (t : B₀) (s : B₁)
    (_hts : ι₀ t * ι₁ s = 1)
    (_ht_inj : Function.Injective (Polynomial.eval₂RingHom φ₀ t))
    (_hs_inj : Function.Injective (Polynomial.eval₂RingHom φ₁ s))
    (_hVal₀ : ∀ V : ValuationSubring K,
      (∀ c : k, k_to_K c ∈ V) → V ≠ ⊤ → ι₀ t ∈ V → ∀ b : B₀, ι₀ b ∈ V)
    (_hVal₁ : ∀ V : ValuationSubring K,
      (∀ c : k, k_to_K c ∈ V) → V ≠ ⊤ → ι₁ s ∈ V → ∀ b : B₁, ι₁ b ∈ V)
    (_hGlobal : ∀ (b₀ : B₀) (b₁ : B₁), ι₀ b₀ = ι₁ b₁ → ∃ c : k, b₀ = φ₀ c) :
    (∃ (n : ℕ) (b : Fin n → B₀),
      1 ≤ n ∧
      Function.Bijective (fun c : Fin n → Polynomial k =>
        Finset.univ.sum fun i : Fin n => Polynomial.eval₂RingHom φ₀ t (c i) * b i)) ∧
    (∀ K_pos : ℕ,
      ∃ (N_V : ℕ) (v_bas : Fin N_V → B₀),
        1 ≤ N_V ∧
        Function.Injective (fun coeff : Fin N_V → k =>
          Finset.univ.sum fun i : Fin N_V => φ₀ (coeff i) * v_bas i) ∧
        ∀ F : B₀,
          (∃ coeff : Fin N_V → k,
            F = Finset.univ.sum fun i : Fin N_V => φ₀ (coeff i) * v_bas i) ↔
          (∃ G : B₁, ι₁ G = (ι₁ s) ^ K_pos * ι₀ F)) :=
by
  classical
  have hSingleBasis : ∀ (B : Type u) [CommRing B] [IsDomain B]
      (φ : k →+* B) (_ : φ.FiniteType)
      (ι : B →+* K) (_ : Function.Injective ι) (_ : ι.comp φ = k_to_K)
      (u : B) (_ : Function.Injective (Polynomial.eval₂RingHom φ u))
      (_ : ∀ V : ValuationSubring K,
        (∀ c : k, k_to_K c ∈ V) → V ≠ ⊤ → ι u ∈ V → ∀ b : B, ι b ∈ V),
      ∃ (n : ℕ) (b : Fin n → B),
        1 ≤ n ∧
        Function.Bijective (fun c : Fin n → Polynomial k =>
          Finset.univ.sum fun i : Fin n => Polynomial.eval₂RingHom φ u (c i) * b i) := by
    intro B _ _ φ hFT ι hInj hComp u hu_inj hVal
    let ψ : Polynomial k →+* B := Polynomial.eval₂RingHom φ u
    let ψ_K : Polynomial k →+* K := ι.comp ψ
    let _ : Algebra (Polynomial k) B := ψ.toAlgebra
    let _ : Algebra (Polynomial k) K := ψ_K.toAlgebra
    have hψC : ψ.comp Polynomial.C = φ := by
      ext c
      simp [ψ]
    have hFT_ψ : ψ.FiniteType := by
      have hcomp_ft : (ψ.comp Polynomial.C).FiniteType := hψC.symm ▸ hFT
      exact RingHom.FiniteType.of_comp_finiteType hcomp_ft
    have _ : Algebra.FiniteType (Polynomial k) B := hFT_ψ
    let ι_alg : B →ₐ[Polynomial k] K :=
      { ι with commutes' := fun _ => rfl }
    have hInt_B : ∀ x : B, _root_.IsIntegral (Polynomial k) x := by
      intro x
      refine (isIntegral_algHom_iff ι_alg hInj).mp ?_
      rw [← mem_integralClosure_iff (Polynomial k) K, ← Subalgebra.mem_toSubring]
      by_contra hx_not
      obtain ⟨V, hIC_le, hx_not_V⟩ :=
        Subring.exists_le_valuationSubring_of_isIntegrallyClosedIn hx_not
      have hVk : ∀ c : k, k_to_K c ∈ V := by
        intro c
        have hc_mem : ψ_K (Polynomial.C c) ∈ (integralClosure (Polynomial k) K).toSubring :=
          (integralClosure (Polynomial k) K).algebraMap_mem (Polynomial.C c)
        have hc_V : ψ_K (Polynomial.C c) ∈ V := hIC_le hc_mem
        have hc_eq : ψ_K (Polynomial.C c) = k_to_K c := by
          change ι (Polynomial.eval₂RingHom φ u (Polynomial.C c)) = k_to_K c
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          exact RingHom.congr_fun hComp c
        rwa [hc_eq] at hc_V
      have hV_ne_top : V ≠ ⊤ := by
        intro htop
        apply hx_not_V
        rw [htop]
        exact ValuationSubring.mem_top (ι x)
      have hu_V : ι u ∈ V := by
        have hX_mem : ψ_K Polynomial.X ∈ (integralClosure (Polynomial k) K).toSubring :=
          (integralClosure (Polynomial k) K).algebraMap_mem Polynomial.X
        have hX_V : ψ_K Polynomial.X ∈ V := hIC_le hX_mem
        have hX_eq : ψ_K Polynomial.X = ι u := by
          change ι (Polynomial.eval₂RingHom φ u Polynomial.X) = ι u
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        rwa [hX_eq] at hX_V
      exact hx_not_V (hVal V hVk hV_ne_top hu_V x)
    have _ : Algebra.IsIntegral (Polynomial k) B := ⟨hInt_B⟩
    have _ : Module.Finite (Polynomial k) B := Algebra.IsIntegral.finite
    have _ : Module.IsTorsionFree (Polynomial k) B :=
      Module.isTorsionFree_iff_algebraMap_injective.mpr hu_inj
    have _ : Module.Free (Polynomial k) B :=
      Module.free_of_finite_type_torsion_free'
    let I := Module.Free.ChooseBasisIndex (Polynomial k) B
    let bas₀ : Module.Basis I (Polynomial k) B := Module.Free.chooseBasis (Polynomial k) B
    have _ : _root_.Finite I := Module.Finite.finite_basis bas₀
    let _ : Fintype I := Fintype.ofFinite I
    have _ : Nonempty I := bas₀.index_nonempty
    let n : ℕ := Fintype.card I
    have hn : 1 ≤ n := Fintype.card_pos
    let bas : Module.Basis (Fin n) (Polynomial k) B := bas₀.reindex (Fintype.equivFin I)
    let b : Fin n → B := fun i => bas i
    refine ⟨n, b, hn, ?_⟩
    have hfun_eq : (fun c : Fin n → Polynomial k =>
        Finset.univ.sum fun i : Fin n => Polynomial.eval₂RingHom φ u (c i) * b i) =
        ⇑bas.equivFun.symm := by
      ext c
      rw [bas.equivFun_symm_apply]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Algebra.smul_def]
      rfl
    rw [hfun_eq]
    exact bas.equivFun.symm.bijective
  refine ⟨hSingleBasis B₀ φ₀ _hFT₀ ι₀ _hInj₀ _hComp₀ t _ht_inj _hVal₀, ?_⟩
  obtain ⟨m, w, _hm, hw_bij⟩ :=
    hSingleBasis B₁ φ₁ _hFT₁ ι₁ _hInj₁ _hComp₁ s _hs_inj _hVal₁
  intro K_pos
  let _ : Algebra k B₀ := φ₀.toAlgebra
  let _ : Algebra k B₁ := φ₁.toAlgebra
  have halg₀ : algebraMap k B₀ = φ₀ := rfl
  have halg₁ : algebraMap k B₁ = φ₁ := rfl
  have hComp01 : ∀ c : k, ι₁ (φ₁ c) = ι₀ (φ₀ c) := fun c =>
    (RingHom.congr_fun _hComp₁ c).trans (RingHom.congr_fun _hComp₀ c).symm
  let W : Submodule k B₀ :=
    { carrier := { F : B₀ | ∃ G : B₁, ι₁ G = (ι₁ s) ^ K_pos * ι₀ F }
      zero_mem' := ⟨0, by simp⟩
      add_mem' := by
        rintro F₁ F₂ ⟨G₁, hG₁⟩ ⟨G₂, hG₂⟩
        refine ⟨G₁ + G₂, ?_⟩
        rw [map_add, hG₁, hG₂, map_add, mul_add]
      smul_mem' := by
        rintro c F ⟨G, hG⟩
        refine ⟨φ₁ c * G, ?_⟩
        rw [Algebra.smul_def, halg₀, map_mul, map_mul, hComp01 c, hG]
        ring }
  have h1W : (1 : B₀) ∈ W := ⟨s ^ K_pos, by simp⟩
  have _ : Nontrivial ↥W :=
    ⟨⟨⟨1, h1W⟩, ⟨0, W.zero_mem⟩, fun h => one_ne_zero (congrArg Subtype.val h)⟩⟩
  let γ_fn : ↥W → B₁ := fun x => x.2.choose
  have hγ : ∀ x : ↥W, ι₁ (γ_fn x) = (ι₁ s) ^ K_pos * ι₀ x.1 := fun x => x.2.choose_spec
  let γ : ↥W →ₗ[k] B₁ :=
    { toFun := γ_fn
      map_add' := fun x y => _hInj₁ <| by
        simp only [map_add, hγ, Submodule.coe_add, mul_add]
      map_smul' := fun c x => _hInj₁ <| by
        simp only [RingHom.id_apply, hγ, SetLike.val_smul, Algebra.smul_def, halg₀, halg₁,
          map_mul, hComp01]
        ring }
  let Ψ_lin : (Fin m → Polynomial k) →ₗ[k] B₁ :=
    { toFun := fun d => Finset.univ.sum fun j : Fin m => Polynomial.eval₂RingHom φ₁ s (d j) * w j
      map_add' := fun d₁ d₂ => by
        simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
      map_smul' := fun c d => by
        rw [RingHom.id_apply, Algebra.smul_def c (Finset.univ.sum _), halg₁, Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [Pi.smul_apply, Polynomial.smul_eq_C_mul, map_mul, Polynomial.coe_eval₂RingHom,
          Polynomial.eval₂_C, mul_assoc] }
  let Ψ_w : (Fin m → Polynomial k) ≃ₗ[k] B₁ := LinearEquiv.ofBijective Ψ_lin hw_bij
  let π_trunc : (Fin m → Polynomial k) →ₗ[k] (Fin m → Fin K_pos → k) :=
    { toFun := fun d j r => (d j).coeff r.1
      map_add' := fun d₁ d₂ => by
        funext j r
        exact Polynomial.coeff_add (d₁ j) (d₂ j) r.1
      map_smul' := fun c d => by
        funext j r
        exact Polynomial.coeff_smul c (d j) r.1 }
  let Λ : ↥W →ₗ[k] (Fin m → Fin K_pos → k) :=
    π_trunc.comp (Ψ_w.symm.toLinearMap.comp γ)
  have hs_ne : ι₁ s ≠ 0 := right_ne_zero_of_mul_eq_one _hts
  have hs_pow : (ι₁ s) ^ K_pos ≠ 0 := pow_ne_zero K_pos hs_ne
  have hker_le : LinearMap.ker Λ ≤ Submodule.span k {(⟨1, h1W⟩ : ↥W)} := by
    rintro ⟨F, hF⟩ hx_ker
    rw [LinearMap.mem_ker] at hx_ker
    let x : ↥W := ⟨F, hF⟩
    let d : Fin m → Polynomial k := Ψ_w.symm (γ x)
    have hΨd : Ψ_w d = γ x := Ψ_w.apply_symm_apply (γ x)
    have hdvd : ∀ j : Fin m, Polynomial.X ^ K_pos ∣ d j := by
      intro j
      rw [Polynomial.X_pow_dvd_iff]
      intro r hr
      exact congrFun (congrFun hx_ker j) ⟨r, hr⟩
    let q : Fin m → Polynomial k := fun j => (hdvd j).choose
    have hq : ∀ j : Fin m, d j = Polynomial.X ^ K_pos * q j := fun j => (hdvd j).choose_spec
    let H : B₁ := Finset.univ.sum fun j : Fin m => Polynomial.eval₂RingHom φ₁ s (q j) * w j
    have hγ_eq : γ x = s ^ K_pos * H := by
      rw [← hΨd]
      change (Finset.univ.sum fun j : Fin m => Polynomial.eval₂RingHom φ₁ s (d j) * w j) =
        s ^ K_pos * H
      dsimp only [H]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [hq j, map_mul, map_pow, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, mul_assoc]
    have hK_eq : (ι₁ s) ^ K_pos * ι₀ F = (ι₁ s) ^ K_pos * ι₁ H := by
      calc
        (ι₁ s) ^ K_pos * ι₀ F = ι₁ (γ x) := (hγ x).symm
        _ = ι₁ (s ^ K_pos * H) := by rw [hγ_eq]
        _ = (ι₁ s) ^ K_pos * ι₁ H := by rw [map_mul, map_pow]
    have hFH : ι₀ F = ι₁ H := mul_left_cancel₀ hs_pow hK_eq
    obtain ⟨c, hc⟩ := _hGlobal F H hFH
    rw [Submodule.mem_span_singleton]
    refine ⟨c, Subtype.ext ?_⟩
    change φ₀ c * 1 = F
    rw [mul_one, hc]
  have _ : FiniteDimensional k ↥(Submodule.span k {(⟨1, h1W⟩ : ↥W)}) :=
    (Submodule.fg_iff_finiteDimensional _).mp (Submodule.fg_span_singleton _)
  have _ : FiniteDimensional k ↥(LinearMap.ker Λ) :=
    Submodule.finiteDimensional_of_le hker_le
  have _ : Module.Finite k (↥W ⧸ LinearMap.ker Λ) :=
    Module.Finite.equiv (LinearMap.quotKerEquivRange Λ).symm
  have _ : Module.Finite k ↥W :=
    Module.Finite.of_submodule_quotient (LinearMap.ker Λ)
  let J := Module.Free.ChooseBasisIndex k ↥W
  let w_bas₀ : Module.Basis J k ↥W := Module.Free.chooseBasis k ↥W
  have _ : _root_.Finite J := Module.Finite.finite_basis w_bas₀
  let _ : Fintype J := Fintype.ofFinite J
  have _ : Nonempty J := w_bas₀.index_nonempty
  let N_V : ℕ := Fintype.card J
  have hNV : 1 ≤ N_V := Fintype.card_pos
  let w_bas : Module.Basis (Fin N_V) k ↥W := w_bas₀.reindex (Fintype.equivFin J)
  let v_bas : Fin N_V → B₀ := fun i => (w_bas i).1
  have hSum_val : ∀ coeff : Fin N_V → k,
      (w_bas.equivFun.symm coeff).1 =
        Finset.univ.sum fun i : Fin N_V => φ₀ (coeff i) * v_bas i := by
    intro coeff
    rw [w_bas.equivFun_symm_apply, Submodule.coe_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [SetLike.val_smul, Algebra.smul_def]
    rfl
  refine ⟨N_V, v_bas, hNV, ?_, ?_⟩
  · intro coeff₁ coeff₂ h_eq
    apply w_bas.equivFun.symm.injective
    apply Subtype.ext
    rw [hSum_val, hSum_val]
    exact h_eq
  · intro F
    constructor
    · rintro ⟨coeff, rfl⟩
      rw [← hSum_val coeff]
      exact (w_bas.equivFun.symm coeff).2
    · intro hF
      let coeff : Fin N_V → k := w_bas.equivFun ⟨F, hF⟩
      refine ⟨coeff, ?_⟩
      rw [← hSum_val coeff, w_bas.equivFun.symm_apply_apply]

theorem weil_curve_dvr_principal_divisor_and_affine_chart (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    (hProjC : IsProjectiveOverField k C)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom] :
    WeilCurveDivisorAndAffineChartHolds k C ∧
    ∀ (P₀ : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) })
      (D : ({ x : ↥C.left // IsClosed ({x} : Set ↥C.left) } →₀ ℤ)),
      (∀ E' : ({ x : ↥C.left // IsClosed ({x} : Set ↥C.left) } →₀ ℤ),
        (∀ x, 0 ≤ E' x) →
        QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C.left) E' =
          QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C.left) D →
        E' P₀ = 0) →
      weilCurveEffSubsingleton C.left D :=
by
  classical
  have : IrreducibleSpace ↥C.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C.left
  
  have hDimC : topologicalKrullDim C.left = (1 : WithBot ℕ∞) :=
    weil_smooth_integral_krullDim_over_field k 1 C inferInstance
  have hDimOpen : ∀ U : C.left.Opens, Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}) →
      topologicalKrullDim ↥(U : AlgebraicGeometry.Scheme.{u}) = (1 : WithBot ℕ∞) := by
    intro U hNe
    have : Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}) := hNe
    let U_over : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (U.ι ≫ C.hom)
    have : AlgebraicGeometry.IsIntegral U_over.left :=
      (inferInstance : AlgebraicGeometry.IsIntegral (U : AlgebraicGeometry.Scheme.{u}))
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 U_over.hom :=
      (inferInstance : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (U.ι ≫ C.hom))
    exact weil_smooth_integral_krullDim_over_field k 1 U_over inferInstance

  
  let Pt := { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }
  let K := ↑C.left.functionField
  obtain ⟨hPropC, k_to_K, hCompOpen, hStalkReg, hFinStalkPole, hGlobalStalkConst, hTwoChart⟩ :=
    weil_proj_curve_dual_hyperplane_cover_stalkReg_and_global_const k C hProjC hDimC hDimOpen
  have : AlgebraicGeometry.IsProper C.hom := hPropC
  obtain ⟨φ_k_bij, P_base, _, _, _, V_pt, _, _, _, hV_props, hV_surj⟩ :=
    weil_smooth_proj_curve_closedPt_valuation_bijection k C hDimC

  
  have hMemV_iff : ∀ (x : Pt) (z : K),
      z ∈ V_pt x ↔ ∃ r : ↑(C.left.presheaf.stalk x.1), algebraMap _ K r = z := by
    intro x z
    obtain ⟨e_x, he_x⟩ := (hV_props x).2.2.2.2
    constructor
    · intro hz
      refine ⟨e_x.symm ⟨z, hz⟩, ?_⟩
      rw [← he_x (e_x.symm ⟨z, hz⟩), e_x.apply_symm_apply]
    · rintro ⟨r, rfl⟩
      rw [← he_x r]
      exact (e_x r).2
  have hFinPole : ∀ u : Units K, Set.Finite { x : Pt | (u : K) ∉ V_pt x } := by
    intro u
    have hset : { x : Pt | (u : K) ∉ V_pt x } =
        { x : Pt | ¬ ∃ r : ↑(C.left.presheaf.stalk x.1), algebraMap _ K r = (u : K) } := by
      ext x
      simp only [Set.mem_setOf_eq, hMemV_iff]
    rw [hset]
    exact hFinStalkPole (u : K)
  have hGlobalConst : ∀ z : K, (∀ x : Pt, z ∈ V_pt x) ↔ z ∈ Set.range k_to_K := by
    intro z
    simp_rw [hMemV_iff]
    exact hGlobalStalkConst z
  have hRange_sub : Set.range φ_k_bij ⊆ Set.range k_to_K := by
    rintro _ ⟨a, rfl⟩
    exact (hGlobalConst (φ_k_bij a)).mp (fun x => (hV_props x).1 a)
  have hRange_eq : Set.range φ_k_bij = Set.range k_to_K := by
    apply Set.Subset.antisymm hRange_sub
    rintro _ ⟨d, rfl⟩
    have hd : k_to_K d ∈ V_pt P_base :=
      (hGlobalConst (k_to_K d)).mpr ⟨d, rfl⟩ P_base
    obtain ⟨a, ha, hdiff_mem⟩ := (hV_props P_base).2.2.2.1 ⟨k_to_K d, hd⟩
    obtain ⟨b, hb⟩ : φ_k_bij a ∈ Set.range k_to_K := hRange_sub ⟨a, rfl⟩
    have hdb : d = b := by
      by_contra hne
      have hsub_ne : d - b ≠ 0 := sub_ne_zero.mpr hne
      have hinv_mem : k_to_K (d - b)⁻¹ ∈ V_pt P_base :=
        (hGlobalConst (k_to_K (d - b)⁻¹)).mpr ⟨(d - b)⁻¹, rfl⟩ P_base
      have hmul_one :
          ((⟨k_to_K d, hd⟩ : ↥(V_pt P_base)) - ⟨φ_k_bij a, ha⟩) *
            ⟨k_to_K (d - b)⁻¹, hinv_mem⟩ = 1 := by
        apply Subtype.ext
        change (k_to_K d - φ_k_bij a) * k_to_K (d - b)⁻¹ = 1
        rw [← hb, ← map_sub, ← map_mul, mul_inv_cancel₀ hsub_ne, map_one]
      have hunit : IsUnit ((⟨k_to_K d, hd⟩ : ↥(V_pt P_base)) - ⟨φ_k_bij a, ha⟩) :=
        isUnit_iff_exists_inv.mpr ⟨⟨k_to_K (d - b)⁻¹, hinv_mem⟩, hmul_one⟩
      exact IsLocalRing.notMem_maximalIdeal.mpr hunit hdiff_mem
    exact ⟨a, hb.symm.trans (congrArg k_to_K hdb.symm)⟩
  have hRes_k : ∀ (x : Pt) (z : ↥(V_pt x)),
      ∃ (c : k) (hc : k_to_K c ∈ V_pt x),
        z - ⟨k_to_K c, hc⟩ ∈ IsLocalRing.maximalIdeal ↥(V_pt x) := by
    intro x z
    obtain ⟨a, ha, hmem⟩ := (hV_props x).2.2.2.1 z
    have ha_range : φ_k_bij a ∈ Set.range k_to_K := by
      rw [← hRange_eq]
      exact ⟨a, rfl⟩
    obtain ⟨c, hc_eq⟩ := ha_range
    have hc : k_to_K c ∈ V_pt x := hc_eq.symm ▸ ha
    refine ⟨c, hc, ?_⟩
    have hsub_eq : (⟨k_to_K c, hc⟩ : ↥(V_pt x)) = ⟨φ_k_bij a, ha⟩ :=
      Subtype.ext hc_eq
    rwa [hsub_eq]
  have hValCenter : ∀ W : ValuationSubring K,
      (∀ c : k, k_to_K c ∈ W) → W ≠ ⊤ → ∃ x : Pt, V_pt x = W := by
    intro W hWk hW_ne
    apply hV_surj W _ hW_ne
    intro a
    have ha_range : φ_k_bij a ∈ Set.range k_to_K := by
      rw [← hRange_eq]
      exact ⟨a, rfl⟩
    obtain ⟨c, hc_eq⟩ := ha_range
    rw [← hc_eq]
    exact hWk c

  
  obtain ⟨div_fn, hMemV_div, hRange, hUltra, hConst, hDVR, hEffIff, hMinEff⟩ :=
    weil_dvr_valuation_family_principal_divisor_and_subsingleton k C.left k_to_K V_pt
      (fun x => ⟨(hV_props x).2.2.1, (hV_props x).2.2.2.2⟩)
      hFinPole hGlobalConst hRes_k

  
  have hEvalInj_of_not_range : ∀ {B : Type u} [CommRing B] (φ : k →+* B) (ι : B →+* K) (u : B),
      ι.comp φ = k_to_K → ι u ∉ Set.range k_to_K →
      Function.Injective (Polynomial.eval₂RingHom φ u) := by
    intro B _ φ ι u hComp hu_not_k p₁ p₂ hp
    let _ : Algebra k K := k_to_K.toAlgebra
    have hp_sub : Polynomial.eval₂ φ u (p₁ - p₂) = 0 := by
      change Polynomial.eval₂RingHom φ u (p₁ - p₂) = 0
      rw [map_sub, hp, sub_self]
    have haeval : Polynomial.aeval (ι u) (p₁ - p₂) = 0 := by
      rw [Polynomial.aeval_def]
      change Polynomial.eval₂ k_to_K (ι u) (p₁ - p₂) = 0
      rw [← hComp, ← Polynomial.hom_eval₂, hp_sub, map_zero]
    by_contra hne
    have hAlg : IsAlgebraic k (ι u) := ⟨p₁ - p₂, sub_ne_zero.mpr hne, haeval⟩
    have hInt_u : _root_.IsIntegral k (ι u) := IsAlgebraic.isIntegral hAlg
    let P_min := minpoly k (ι u)
    have hIrr : Irreducible P_min := minpoly.irreducible hInt_u
    have hMon : P_min.Monic := minpoly.monic hInt_u
    have hDeg : P_min.degree = 1 := IsAlgClosed.degree_eq_one_of_irreducible k hIrr
    have hForm := Polynomial.eq_X_add_C_of_degree_le_one hDeg.le
    have hNatDeg : P_min.natDegree = 1 := Polynomial.natDegree_eq_of_degree_eq_some hDeg
    have hCoeff1 : P_min.coeff 1 = 1 := by
      rw [← hNatDeg]
      exact hMon.leadingCoeff
    have hEv : Polynomial.aeval (ι u) P_min = 0 := minpoly.aeval k (ι u)
    rw [hForm, hCoeff1] at hEv
    simp only [map_one, one_mul, map_add, Polynomial.aeval_X, Polynomial.aeval_C] at hEv
    apply hu_not_k
    refine ⟨-P_min.coeff 0, ?_⟩
    change k_to_K (-P_min.coeff 0) = ι u
    rw [map_neg, neg_eq_iff_add_eq_zero, add_comm]
    exact hEv

  refine ⟨⟨k_to_K, div_fn, hRange, hUltra, hConst, hDVR, hEffIff, ?_⟩, hMinEff⟩
  
  intro S_pts
  obtain ⟨U₀, U₁, hNeU₀, hNeU₁, t, s, hAffU₀, hAffU₁, hS_sub, hCov,
      ⟨z₀, hz₀⟩, ⟨z₁, hz₁⟩, hts, hBasic_t, hBasic_s, hFT₀, hFT₁, hGlobal⟩ :=
    hTwoChart S_pts
  have : Nonempty ↥(U₀ : AlgebraicGeometry.Scheme.{u}) := hNeU₀
  have : Nonempty ↥(U₁ : AlgebraicGeometry.Scheme.{u}) := hNeU₁
  let B₀ := ↑(C.left.presheaf.obj (Opposite.op U₀))
  let B₁ := ↑(C.left.presheaf.obj (Opposite.op U₁))
  let ι₀ : B₀ →+* K := (C.left.germToFunctionField U₀).hom
  let ι₁ : B₁ →+* K := (C.left.germToFunctionField U₁).hom
  let φ₀ : k →+* B₀ :=
    (CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
      (CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp U₀.ι C.hom).appTop
        (U₀.topIso).hom)).hom
  let φ₁ : k →+* B₁ :=
    (CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
      (CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp U₁.ι C.hom).appTop
        (U₁.topIso).hom)).hom
  have hComp₀ : ι₀.comp φ₀ = k_to_K := hCompOpen U₀
  have hComp₁ : ι₁.comp φ₁ = k_to_K := hCompOpen U₁
  have : IsDomain B₀ := AlgebraicGeometry.IsIntegral.component_integral U₀
  have : IsDomain B₁ := AlgebraicGeometry.IsIntegral.component_integral U₁
  have hInj₀ : Function.Injective ι₀ :=
    AlgebraicGeometry.Scheme.germToFunctionField_injective C.left U₀
  have hInj₁ : Function.Injective ι₁ :=
    AlgebraicGeometry.Scheme.germToFunctionField_injective C.left U₁
  have ht_ne : ι₀ t ≠ 0 := left_ne_zero_of_mul_eq_one hts
  have hs_ne : ι₁ s ≠ 0 := right_ne_zero_of_mul_eq_one hts
  let u_t : Units K := Units.mk0 (ι₀ t) ht_ne
  let u_s : Units K := Units.mk0 (ι₁ s) hs_ne
  have huts_one : u_t * u_s = 1 := Units.ext hts
  have hdiv_ts_zero : div_fn (Additive.ofMul u_t) + div_fn (Additive.ofMul u_s) = 0 := by
    rw [← map_add, ← ofMul_mul, huts_one, ofMul_one, map_zero]
  have hdiv_s_eq : ∀ x : Pt,
      div_fn (Additive.ofMul u_s) x = - div_fn (Additive.ofMul u_t) x := by
    intro x
    have hx0 : div_fn (Additive.ofMul u_t) x + div_fn (Additive.ofMul u_s) x = 0 :=
      congrArg (fun D : Pt →₀ ℤ => D x) hdiv_ts_zero
    omega

  
  have ht_pole : ∀ x : Pt, x.1 ∉ U₀ → div_fn (Additive.ofMul u_t) x < 0 := by
    intro x hx_not₀
    have hx_top : x.1 ∈ (⊤ : C.left.Opens) := TopologicalSpace.Opens.mem_top x.1
    rw [← hCov] at hx_top
    have hx₁ : x.1 ∈ U₁ := hx_top.resolve_left hx_not₀
    have hx_not_bs : x.1 ∉ C.left.basicOpen s := by
      rw [hBasic_s]
      intro hx_inter
      exact hx_not₀ hx_inter.2
    let r_s : ↑(C.left.presheaf.stalk x.1) := (C.left.presheaf.germ U₁ x.1 hx₁).hom s
    have hnot_unit : ¬ IsUnit r_s := by
      intro hu
      exact hx_not_bs ((AlgebraicGeometry.RingedSpace.mem_basicOpen C.left.toRingedSpace s x.1 hx₁).mpr hu)
    have hrs_mem : r_s ∈ IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk x.1) := by
      by_contra hnot_mem
      exact hnot_unit (IsLocalRing.notMem_maximalIdeal.mp hnot_mem)
    have hrs_K : algebraMap ↑(C.left.presheaf.stalk x.1) K r_s = (u_s : K) :=
      AlgebraicGeometry.Scheme.algebraMap_germ_eq_germToFunctionField C.left hx₁ s
    have hge1 : 1 ≤ div_fn (Additive.ofMul u_s) x :=
      ((hDVR x).2 u_s).2.mpr ⟨r_s, hrs_mem, hrs_K⟩
    have hs_neg := hdiv_s_eq x
    omega
  have hs_pole : ∀ x : Pt, x.1 ∉ U₁ → div_fn (Additive.ofMul u_s) x < 0 := by
    intro x hx_not₁
    have hx_top : x.1 ∈ (⊤ : C.left.Opens) := TopologicalSpace.Opens.mem_top x.1
    rw [← hCov] at hx_top
    have hx₀ : x.1 ∈ U₀ := hx_top.resolve_right hx_not₁
    have hx_not_bt : x.1 ∉ C.left.basicOpen t := by
      rw [hBasic_t]
      intro hx_inter
      exact hx_not₁ hx_inter.2
    let r_t : ↑(C.left.presheaf.stalk x.1) := (C.left.presheaf.germ U₀ x.1 hx₀).hom t
    have hnot_unit : ¬ IsUnit r_t := by
      intro hu
      exact hx_not_bt ((AlgebraicGeometry.RingedSpace.mem_basicOpen C.left.toRingedSpace t x.1 hx₀).mpr hu)
    have hrt_mem : r_t ∈ IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk x.1) := by
      by_contra hnot_mem
      exact hnot_unit (IsLocalRing.notMem_maximalIdeal.mp hnot_mem)
    have hrt_K : algebraMap ↑(C.left.presheaf.stalk x.1) K r_t = (u_t : K) :=
      AlgebraicGeometry.Scheme.algebraMap_germ_eq_germToFunctionField C.left hx₀ t
    have hge1 : 1 ≤ div_fn (Additive.ofMul u_t) x :=
      ((hDVR x).2 u_t).2.mpr ⟨r_t, hrt_mem, hrt_K⟩
    have hs_neg := hdiv_s_eq x
    omega

  have ht_not_k : ι₀ t ∉ Set.range k_to_K := by
    rintro ⟨c, hc⟩
    have hc_ne : c ≠ 0 := by
      intro hc0
      rw [hc0, map_zero] at hc
      exact ht_ne hc.symm
    have hut_eq : u_t = Units.map k_to_K.toMonoidHom (Units.mk0 c hc_ne) :=
      Units.ext hc.symm
    have h0 : div_fn (Additive.ofMul u_t) z₀ = 0 := by
      rw [hut_eq, hConst]
      rfl
    have hlt := ht_pole z₀ hz₀
    omega
  have hs_not_k : ι₁ s ∉ Set.range k_to_K := by
    rintro ⟨c, hc⟩
    have hc_ne : c ≠ 0 := by
      intro hc0
      rw [hc0, map_zero] at hc
      exact hs_ne hc.symm
    have hus_eq : u_s = Units.map k_to_K.toMonoidHom (Units.mk0 c hc_ne) :=
      Units.ext hc.symm
    have h0 : div_fn (Additive.ofMul u_s) z₁ = 0 := by
      rw [hus_eq, hConst]
      rfl
    have hlt := hs_pole z₁ hz₁
    omega

  have ht_inj : Function.Injective (Polynomial.eval₂RingHom φ₀ t) :=
    hEvalInj_of_not_range φ₀ ι₀ t hComp₀ ht_not_k
  have hs_inj : Function.Injective (Polynomial.eval₂RingHom φ₁ s) :=
    hEvalInj_of_not_range φ₁ ι₁ s hComp₁ hs_not_k
  have hVal₀ : ∀ V : ValuationSubring K,
      (∀ c : k, k_to_K c ∈ V) → V ≠ ⊤ → ι₀ t ∈ V → ∀ b : B₀, ι₀ b ∈ V := by
    intro V hVk hV_ne htV b
    obtain ⟨x, rfl⟩ := hValCenter V hVk hV_ne
    have hx₀ : x.1 ∈ U₀ := by
      by_contra hx_not₀
      have h0 : 0 ≤ div_fn (Additive.ofMul u_t) x := (hMemV_div u_t x).mp htV
      have hlt := ht_pole x hx_not₀
      omega
    exact (hMemV_iff x (ι₀ b)).mpr
      ⟨(C.left.presheaf.germ U₀ x.1 hx₀).hom b,
        AlgebraicGeometry.Scheme.algebraMap_germ_eq_germToFunctionField C.left hx₀ b⟩
  have hVal₁ : ∀ V : ValuationSubring K,
      (∀ c : k, k_to_K c ∈ V) → V ≠ ⊤ → ι₁ s ∈ V → ∀ b : B₁, ι₁ b ∈ V := by
    intro V hVk hV_ne hsV b
    obtain ⟨x, rfl⟩ := hValCenter V hVk hV_ne
    have hx₁ : x.1 ∈ U₁ := by
      by_contra hx_not₁
      have h0 : 0 ≤ div_fn (Additive.ofMul u_s) x := (hMemV_div u_s x).mp hsV
      have hlt := hs_pole x hx_not₁
      omega
    exact (hMemV_iff x (ι₁ b)).mpr
      ⟨(C.left.presheaf.germ U₁ x.1 hx₁).hom b,
        AlgebraicGeometry.Scheme.algebraMap_germ_eq_germToFunctionField C.left hx₁ b⟩

  
  obtain ⟨hFreeBasis, hPoleTrunc⟩ :=
    weil_valuative_integral_pid_free_basis_and_pole_truncation
      k K B₀ B₁ k_to_K φ₀ hFT₀ φ₁ hFT₁ ι₀ hInj₀ hComp₀ ι₁ hInj₁ hComp₁
      t s hts ht_inj hs_inj hVal₀ hVal₁ hGlobal

  refine ⟨U₀, hNeU₀, t, hAffU₀, hS_sub, hComp₀, ⟨ht_ne, ht_pole⟩, hFreeBasis, ?_, ?_⟩
  · 
    intro x hx₀
    let y_U₀ : ↥U₀ := ⟨x.1, hx₀⟩
    let p_x : PrimeSpectrum B₀ := hAffU₀.primeIdealOf y_U₀
    let q : Ideal B₀ := p_x.asIdeal
    have : q.IsPrime := p_x.isPrime
    obtain ⟨U_k, _, V, hAffV, hxV, e_V, hSm_V⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 C.hom).mp inferInstance x.1
    have hIdealBot : ∀ (I : Ideal k), I ≠ ⊤ → I = ⊥ := by
      intro I hI
      ext c
      simp only [Ideal.mem_bot]
      refine ⟨fun hc => ?_, fun hc => hc.symm ▸ I.zero_mem⟩
      by_contra hc_ne
      apply hI
      rw [Ideal.eq_top_iff_one]
      have hmem : c⁻¹ * c ∈ I := I.mul_mem_left c⁻¹ hc
      rwa [inv_mul_cancel₀ hc_ne] at hmem
    have hUk_top : U_k = ⊤ := by
      ext p
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      have hx_in : C.hom.base x.1 ∈ U_k := e_V hxV
      have hp_eq : p = C.hom.base x.1 := by
        apply PrimeSpectrum.ext
        exact (hIdealBot (p : PrimeSpectrum k).asIdeal (p : PrimeSpectrum k).isPrime.ne_top).trans
          (hIdealBot (C.hom.base x.1 : PrimeSpectrum k).asIdeal
            (C.hom.base x.1 : PrimeSpectrum k).isPrime.ne_top).symm
      rwa [hp_eq]
    subst hUk_top
    obtain ⟨f₀, f₁, hBasic_eq, hx_f₀⟩ :=
      AlgebraicGeometry.exists_basicOpen_le_affine_inter hAffU₀ hAffV x.1 ⟨hx₀, hxV⟩
    have hf₀_not_q : f₀ ∉ q := by
      have hpre := hAffU₀.fromSpec_preimage_basicOpen f₀
      have hp_mem : p_x ∈
          (TopologicalSpace.Opens.map hAffU₀.fromSpec.base).obj (C.left.basicOpen f₀) := by
        change hAffU₀.fromSpec.base p_x ∈ C.left.basicOpen f₀
        rw [hAffU₀.fromSpec_primeIdealOf y_U₀]
        exact hx_f₀
      rw [hpre] at hp_mem
      exact hp_mem
    have hSm_f₀ : RingHom.IsStandardSmoothOfRelativeDimension 1
        ((algebraMap B₀ (Localization.Away f₀)).comp φ₀) := by
      let e_spec : k ≃+*
          ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤)) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv
      let alg_spec : Algebra k
          ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤)) :=
        e_spec.toRingHom.toAlgebra
      have hLoc_spec : @IsLocalization.Away k _ (1 : k)
          ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤)) _ alg_spec :=
        @IsLocalization.away_of_isUnit_of_bijective k
          ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤)) _ _ alg_spec
          (1 : k) isUnit_one e_spec.bijective
      have hSm_espec : RingHom.IsStandardSmoothOfRelativeDimension 0 e_spec.toRingHom :=
        @RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway k _
          ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤)) _ alg_spec
          (1 : k) hLoc_spec
      have hSm_kV : RingHom.IsStandardSmoothOfRelativeDimension (1 + 0)
          ((C.hom.appLE ⊤ V e_V).hom.comp e_spec.toRingHom) :=
        hSm_V.comp hSm_espec
      have : IsLocalization.Away f₁ ↑(C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₁))) :=
        hAffV.isLocalization_basicOpen f₁
      have hSm_Vf₁ : RingHom.IsStandardSmoothOfRelativeDimension 0
          (algebraMap ↑(C.left.presheaf.obj (Opposite.op V))
            ↑(C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₁)))) :=
        RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway f₁
      have hSm_kf₁ : RingHom.IsStandardSmoothOfRelativeDimension (0 + (1 + 0))
          ((algebraMap ↑(C.left.presheaf.obj (Opposite.op V))
              ↑(C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₁)))).comp
            ((C.hom.appLE ⊤ V e_V).hom.comp e_spec.toRingHom)) :=
        hSm_Vf₁.comp hSm_kV
      have : IsLocalization.Away f₀ ↑(C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₀))) :=
        hAffU₀.isLocalization_basicOpen f₀
      let iso_f10 : C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₁)) ≅
          C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₀)) :=
        C.left.presheaf.mapIso (eqToIso hBasic_eq).op
      let e_loc0 : ↑(C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₀))) ≃ₐ[B₀]
          Localization.Away f₀ :=
        IsLocalization.algEquiv (Submonoid.powers f₀) _ (Localization.Away f₀)
      let e_f1_loc : ↑(C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₁))) ≃+*
          Localization.Away f₀ :=
        iso_f10.commRingCatIsoToRingEquiv.trans e_loc0.toRingEquiv
      let alg_ef1 : Algebra ↑(C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₁)))
          (Localization.Away f₀) :=
        e_f1_loc.toRingHom.toAlgebra
      have hLoc_ef1 : @IsLocalization.Away
          ↑(C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₁))) _
          (1 : ↑(C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₁))))
          (Localization.Away f₀) _ alg_ef1 :=
        @IsLocalization.away_of_isUnit_of_bijective
          ↑(C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₁)))
          (Localization.Away f₀) _ _ alg_ef1 1 isUnit_one e_f1_loc.bijective
      have hSm_ef1 : RingHom.IsStandardSmoothOfRelativeDimension 0 e_f1_loc.toRingHom :=
        @RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway
          ↑(C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₁))) _
          (Localization.Away f₀) _ alg_ef1 1 hLoc_ef1
      have hSm_comp : RingHom.IsStandardSmoothOfRelativeDimension (0 + (0 + (1 + 0)))
          (e_f1_loc.toRingHom.comp
            ((algebraMap ↑(C.left.presheaf.obj (Opposite.op V))
                ↑(C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₁)))).comp
              ((C.hom.appLE ⊤ V e_V).hom.comp e_spec.toRingHom))) :=
        hSm_ef1.comp hSm_kf₁
      have hHom_eq :
          e_f1_loc.toRingHom.comp
            ((algebraMap ↑(C.left.presheaf.obj (Opposite.op V))
                ↑(C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₁)))).comp
              ((C.hom.appLE ⊤ V e_V).hom.comp e_spec.toRingHom)) =
          (algebraMap B₀ (Localization.Away f₀)).comp φ₀ := by
        have h_alg_V :
            algebraMap ↑(C.left.presheaf.obj (Opposite.op V))
              ↑(C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₁))) =
            (C.left.presheaf.map (homOfLE (C.left.basicOpen_le f₁)).op).hom := rfl
        have h_alg_U0 :
            ∀ b : B₀,
              e_loc0 ((C.left.presheaf.map (homOfLE (C.left.basicOpen_le f₀)).op).hom b) =
                algebraMap B₀ (Localization.Away f₀) b :=
          fun b => e_loc0.commutes b
        have he_f0 : C.left.basicOpen f₀ ≤ (TopologicalSpace.Opens.map C.hom.base).obj ⊤ :=
          fun _ _ => Set.mem_univ _
        have h_lhs :
            C.hom.appLE ⊤ V e_V ≫
              C.left.presheaf.map (homOfLE (C.left.basicOpen_le f₁)).op ≫
              iso_f10.hom =
            C.hom.appLE ⊤ (C.left.basicOpen f₀) he_f0 := by
          dsimp [iso_f10]
          simp
        have h_u0_top :
            U₀.ι.appTop ≫ U₀.topIso.hom =
              C.left.presheaf.map (homOfLE (le_top : U₀ ≤ ⊤)).op := by
          simp [AlgebraicGeometry.Scheme.Opens.topIso, AlgebraicGeometry.Scheme.Hom.appTop]
          exact (C.left.presheaf.map_comp _ _).symm.trans
            (congrArg C.left.presheaf.map (Subsingleton.elim _ _))
        have h_rhs :
            ((U₀.ι ≫ C.hom).appTop ≫ U₀.topIso.hom) ≫
              C.left.presheaf.map (homOfLE (C.left.basicOpen_le f₀)).op =
            C.hom.appLE ⊤ (C.left.basicOpen f₀) he_f0 := by
          rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, Category.assoc,
            Category.assoc (C.hom.appTop), ← Category.assoc U₀.ι.appTop, h_u0_top]
          dsimp only [AlgebraicGeometry.Scheme.Hom.appTop, AlgebraicGeometry.Scheme.Hom.appLE]
          exact (Category.assoc _ _ _).trans
            (congrArg (C.hom.app ⊤ ≫ ·)
              ((C.left.presheaf.map_comp _ _).symm.trans
                (congrArg C.left.presheaf.map (Subsingleton.elim _ _))))
        have h_cat := h_lhs.trans h_rhs.symm
        ext c
        let c_top := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom c
        have hc :
            iso_f10.hom.hom
              ((C.left.presheaf.map (homOfLE (C.left.basicOpen_le f₁)).op).hom
                ((C.hom.appLE ⊤ V e_V).hom c_top)) =
            (C.left.presheaf.map (homOfLE (C.left.basicOpen_le f₀)).op).hom (φ₀ c) :=
          congrArg (fun g => g.hom c_top) h_cat
        change e_loc0 (iso_f10.hom.hom
            ((algebraMap ↑(C.left.presheaf.obj (Opposite.op V))
                ↑(C.left.presheaf.obj (Opposite.op (C.left.basicOpen f₁))))
              ((C.hom.appLE ⊤ V e_V).hom c_top))) =
          algebraMap B₀ (Localization.Away f₀) (φ₀ c)
        rw [h_alg_V, hc, h_alg_U0]
      rw [← hHom_eq]
      exact hSm_comp
    obtain ⟨e_x, he_x⟩ := (hV_props x).2.2.2.2
    let Rx := ↑(C.left.presheaf.stalk x.1)
    let r₀ : Rx := (C.left.presheaf.germ U₀ x.1 hx₀).hom f₀
    obtain ⟨c₀, hc₀_mem, hc₀_res⟩ := hRes_k x (e_x r₀)
    let r_c : Rx := (C.left.presheaf.germ U₀ x.1 hx₀).hom (φ₀ c₀)
    have he_rc : e_x r_c = ⟨k_to_K c₀, hc₀_mem⟩ := by
      apply Subtype.ext
      rw [he_x r_c]
      change algebraMap Rx K ((C.left.presheaf.germ U₀ x.1 hx₀).hom (φ₀ c₀)) = k_to_K c₀
      rw [AlgebraicGeometry.Scheme.algebraMap_germ_eq_germToFunctionField C.left hx₀ (φ₀ c₀)]
      exact RingHom.congr_fun hComp₀ c₀
    have hdiff_stalk :
        (C.left.presheaf.germ U₀ x.1 hx₀).hom (f₀ - φ₀ c₀) ∈ IsLocalRing.maximalIdeal Rx := by
      rw [IsLocalRing.mem_maximalIdeal]
      intro hu
      have hu_ex : IsUnit (e_x ((C.left.presheaf.germ U₀ x.1 hx₀).hom (f₀ - φ₀ c₀))) :=
        hu.map e_x.toRingHom.toMonoidHom
      have hex_eq : e_x ((C.left.presheaf.germ U₀ x.1 hx₀).hom (f₀ - φ₀ c₀)) =
          e_x r₀ - ⟨k_to_K c₀, hc₀_mem⟩ := by
        rw [map_sub, map_sub, he_rc]
      rw [hex_eq] at hu_ex
      exact IsLocalRing.notMem_maximalIdeal.mpr hu_ex hc₀_res
    have hc₀_q : f₀ - φ₀ c₀ ∈ q := by
      let alg_stalk : Algebra B₀ ↑(C.left.presheaf.stalk ↑y_U₀) :=
        TopCat.Presheaf.algebra_section_stalk C.left.presheaf y_U₀
      have hLoc_stalk :
          @IsLocalization.AtPrime B₀ _ ↑(C.left.presheaf.stalk ↑y_U₀) _ alg_stalk q _ :=
        hAffU₀.isLocalization_stalk y_U₀
      have halg_eq :
          @algebraMap B₀ ↑(C.left.presheaf.stalk ↑y_U₀) _ _ alg_stalk (f₀ - φ₀ c₀) =
            (C.left.presheaf.germ U₀ x.1 hx₀).hom (f₀ - φ₀ c₀) :=
        DFunLike.congr_fun (TopCat.Presheaf.stalk_open_algebraMap C.left.presheaf y_U₀)
          (f₀ - φ₀ c₀)
      exact (@IsLocalization.AtPrime.to_map_mem_maximal_iff B₀ _
        ↑(C.left.presheaf.stalk ↑y_U₀) _ alg_stalk q _ hLoc_stalk (f₀ - φ₀ c₀) _).mp
        (halg_eq.symm ▸ hdiff_stalk)
    obtain ⟨g_x, z_x, hg_x_not_q, hEt_zx⟩ :=
      weil_standardSmooth_dim_one_away_taylor_etale_coord
        k B₀ φ₀ q f₀ hf₀_not_q c₀ hc₀_q hSm_f₀
    refine ⟨g_x, z_x, ?_, hEt_zx⟩
    have hpre_g := hAffU₀.fromSpec_preimage_basicOpen g_x
    have hp_in : p_x ∈ PrimeSpectrum.basicOpen g_x := hg_x_not_q
    rw [← hpre_g] at hp_in
    have hfrom_in : hAffU₀.fromSpec.base p_x ∈ C.left.basicOpen g_x := hp_in
    rwa [hAffU₀.fromSpec_primeIdealOf y_U₀] at hfrom_in
  · 
    intro K_pos
    obtain ⟨N_V, v_bas, hNV, hInj_v, hSpan_iff⟩ := hPoleTrunc K_pos
    refine ⟨N_V, v_bas, hNV, hInj_v, fun F => (hSpan_iff F).trans ?_⟩
    by_cases hF0 : F = 0
    · subst hF0
      constructor
      · intro _ x hF
        exact False.elim (hF (map_zero ι₀))
      · intro _
        exact ⟨0, by rw [map_zero, map_zero, mul_zero]⟩
    · have hF_ne : ι₀ F ≠ 0 := fun h0 => hF0 (hInj₀ (h0.trans (map_zero ι₀).symm))
      let u_F : Units K := Units.mk0 (ι₀ F) hF_ne
      let u_z : Units K := u_s ^ K_pos * u_F
      have huz_val : (u_z : K) = (ι₁ s) ^ K_pos * ι₀ F := by
        simp [u_z, u_s, u_F]
      have hdiv_uz : ∀ x : Pt,
          div_fn (Additive.ofMul u_z) x =
            -(K_pos : ℤ) * div_fn (Additive.ofMul u_t) x + div_fn (Additive.ofMul u_F) x := by
        intro x
        have h1 : Additive.ofMul u_z = K_pos • Additive.ofMul u_s + Additive.ofMul u_F := rfl
        rw [h1, map_add, map_nsmul, Finsupp.add_apply, Finsupp.smul_apply, hdiv_s_eq x]
        simp [nsmul_eq_mul]
      constructor
      · rintro ⟨G, hG⟩ x hF' ht' hx_not₀
        have hx_top : x.1 ∈ (⊤ : C.left.Opens) := TopologicalSpace.Opens.mem_top x.1
        rw [← hCov] at hx_top
        have hx₁ : x.1 ∈ U₁ := hx_top.resolve_left hx_not₀
        obtain ⟨r, hr⟩ := (hStalkReg U₁ hAffU₁ (u_z : K)).mp ⟨G, hG.trans huz_val.symm⟩ x hx₁
        have hnonneg : 0 ≤ div_fn (Additive.ofMul u_z) x :=
          ((hDVR x).2 u_z).1.mpr ⟨r, hr⟩
        rw [hdiv_uz x] at hnonneg
        have huF_eq : Units.mk0 (ι₀ F) hF' = u_F := rfl
        have hut_eq : Units.mk0 (ι₀ t) ht' = u_t := rfl
        rw [huF_eq, hut_eq]
        linarith
      · intro hBound
        rw [← huz_val]
        apply (hStalkReg U₁ hAffU₁ (u_z : K)).mpr
        intro x hx₁
        apply ((hDVR x).2 u_z).1.mp
        rw [hdiv_uz x]
        by_cases hx₀ : x.1 ∈ U₀
        · have hs_nonneg : 0 ≤ div_fn (Additive.ofMul u_s) x :=
            ((hDVR x).2 u_s).1.mpr
              ⟨(C.left.presheaf.germ U₁ x.1 hx₁).hom s,
                AlgebraicGeometry.Scheme.algebraMap_germ_eq_germToFunctionField C.left hx₁ s⟩
          have hF_nonneg : 0 ≤ div_fn (Additive.ofMul u_F) x :=
            ((hDVR x).2 u_F).1.mpr
              ⟨(C.left.presheaf.germ U₀ x.1 hx₀).hom F,
                AlgebraicGeometry.Scheme.algebraMap_germ_eq_germToFunctionField C.left hx₀ F⟩
          have hK_nonneg : (0 : ℤ) ≤ (K_pos : ℤ) := Nat.cast_nonneg K_pos
          have ht_nonpos : div_fn (Additive.ofMul u_t) x ≤ 0 := by
            have := hdiv_s_eq x
            omega
          nlinarith
        · have hb := hBound x hF_ne ht_ne hx₀
          linarith

theorem weil_curve_pow_scheme_geom_closedPts_and_offDiag_open (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    (hProjC : IsProjectiveOverField k C)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (d : ℕ) :
    let P_d := weilCurvePowOver k C d
    let Pt := { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }
    AlgebraicGeometry.IsIntegral P_d.left ∧
    AlgebraicGeometry.IsProper P_d.hom ∧
    CompactSpace ↥P_d.left ∧
    TopologicalSpace.NoetherianSpace ↥P_d.left ∧
    topologicalKrullDim P_d.left = (d : WithBot ℕ∞) ∧
    (∀ (Z U : Set ↥P_d.left), IsClosed Z → IsOpen U → (Z ∩ U).Nonempty →
      ∃ z ∈ Z ∩ U, IsClosed ({z} : Set ↥P_d.left)) ∧
    (∀ (Z U : Set ↥(CategoryTheory.Limits.pullback P_d.hom P_d.hom)),
      IsClosed Z → IsOpen U → (Z ∩ U).Nonempty →
      ∃ w ∈ Z ∩ U, IsClosed ({w} : Set ↥(CategoryTheory.Limits.pullback P_d.hom P_d.hom))) ∧
    (∀ z : ↥P_d.left, IsClosed ({z} : Set ↥P_d.left) →
      ∃ Q : Fin d → Pt, weilCurvePowMatchesTuple k C z Q) ∧
    (∀ Q : Fin d → Pt, ∃! z : ↥P_d.left, weilCurvePowMatchesTuple k C z Q) ∧
    (∀ w : ↥(CategoryTheory.Limits.pullback P_d.hom P_d.hom),
      IsClosed ({w} : Set ↥(CategoryTheory.Limits.pullback P_d.hom P_d.hom)) ↔
        IsClosed ({(CategoryTheory.Limits.pullback.fst P_d.hom P_d.hom).base w} : Set ↥P_d.left) ∧
        IsClosed ({(CategoryTheory.Limits.pullback.snd P_d.hom P_d.hom).base w} : Set ↥P_d.left)) ∧
    (∀ z₁ z₂ : ↥P_d.left,
      IsClosed ({z₁} : Set ↥P_d.left) → IsClosed ({z₂} : Set ↥P_d.left) →
      ∃! w : ↥(CategoryTheory.Limits.pullback P_d.hom P_d.hom),
        IsClosed ({w} : Set ↥(CategoryTheory.Limits.pullback P_d.hom P_d.hom)) ∧
        (CategoryTheory.Limits.pullback.fst P_d.hom P_d.hom).base w = z₁ ∧
        (CategoryTheory.Limits.pullback.snd P_d.hom P_d.hom).base w = z₂) ∧
    (∀ r : ↥P_d.left, IsClosed ({r} : Set ↥P_d.left) →
      ∃ f_slice : ↥P_d.left → ↥(CategoryTheory.Limits.pullback P_d.hom P_d.hom),
        Continuous f_slice ∧
        (∀ z : ↥P_d.left, (CategoryTheory.Limits.pullback.fst P_d.hom P_d.hom).base (f_slice z) = z) ∧
        (∀ z : ↥P_d.left, (CategoryTheory.Limits.pullback.snd P_d.hom P_d.hom).base (f_slice z) = r) ∧
        Set.range f_slice = (CategoryTheory.Limits.pullback.snd P_d.hom P_d.hom).base ⁻¹' {r}) ∧
    (∃ U_dist : Set ↥P_d.left, IsOpen U_dist ∧ U_dist.Nonempty ∧
      ∀ (z : ↥P_d.left) (Q : Fin d → Pt),
        weilCurvePowMatchesTuple k C z Q →
        (z ∈ U_dist ↔ ∀ i j : Fin d, i ≠ j → Q i ≠ Q j)) :=
by
  classical
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let p₀ : ↥S_k := default
  let P_d := weilCurvePowOver k C d
  let Pt := { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }
  
  have hSmoothKrullDim : ∀ (n_dim : ℕ)
      (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
      AlgebraicGeometry.IsIntegral Y.left →
      [AlgebraicGeometry.SmoothOfRelativeDimension n_dim Y.hom] →
      topologicalKrullDim Y.left = (n_dim : WithBot ℕ∞) := by
    intro n_dim Y hInt _
    have h_open_nhds : ∀ (T : Type u) [TopologicalSpace T] [Nonempty T],
        (∀ x : T, ∃ V : TopologicalSpace.Opens T,
          x ∈ V ∧ topologicalKrullDim ↥V = (n_dim : WithBot ℕ∞)) →
        topologicalKrullDim T = (n_dim : WithBot ℕ∞) := by
      intro T _ hne hcov
      obtain ⟨t₀⟩ := hne
      apply le_antisymm
      · have : Nonempty (TopologicalSpace.IrreducibleCloseds T) :=
          ⟨⟨closure {t₀}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
        change Order.krullDim (TopologicalSpace.IrreducibleCloseds T) ≤ ((n_dim : ℕ∞) : WithBot ℕ∞)
        rw [Order.krullDim_eq_iSup_length]
        refine WithBot.coe_le_coe.mpr (iSup_le fun l => ?_)
        obtain ⟨x, hxF₀⟩ := (l 0).isIrreducible.nonempty
        obtain ⟨V, hxV, hDimV⟩ := hcov x
        let G : Fin (l.length + 1) → Set ↥V :=
          fun i => Subtype.val ⁻¹' ((l i : TopologicalSpace.IrreducibleCloseds T) : Set T)
        have hxG : ∀ i : Fin (l.length + 1), (⟨x, hxV⟩ : ↥V) ∈ G i :=
          fun i => l.strictMono.monotone (Fin.zero_le i) hxF₀
        let G' : Fin (l.length + 1) → TopologicalSpace.IrreducibleCloseds ↥V :=
          fun i =>
            { carrier := G i
              isIrreducible' := ⟨⟨⟨x, hxV⟩, hxG i⟩,
                (l i).isIrreducible.isPreirreducible.preimage V.isOpen.isOpenEmbedding_subtypeVal⟩
              isClosed' := (l i).isClosed.preimage continuous_subtype_val }
        have hStrict : StrictMono G' := by
          intro i j hij
          have hle : G' i ≤ G' j := fun y hy => l.strictMono.monotone (le_of_lt hij) hy
          refine lt_of_le_not_ge hle (fun hge => ?_)
          have hsub : ((l j : TopologicalSpace.IrreducibleCloseds T) : Set T) ⊆
              ((l i : TopologicalSpace.IrreducibleCloseds T) : Set T) ∪ (V : Set T)ᶜ := by
            intro y hy
            by_cases hyV : y ∈ V
            · exact Or.inl (@hge ⟨y, hyV⟩ hy)
            · exact Or.inr hyV
          rcases isPreirreducible_iff_isClosed_union_isClosed.mp
              (l j).isIrreducible.isPreirreducible
              ((l i : TopologicalSpace.IrreducibleCloseds T) : Set T) (V : Set T)ᶜ
              (l i).isClosed V.isOpen.isClosed_compl hsub with
            h1 | h2
          · exact not_le_of_gt (l.strictMono hij) h1
          · exact h2 (l.strictMono.monotone (Fin.zero_le j) hxF₀) hxV
        let l_V : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V) :=
          { length := l.length
            toFun := G'
            step := fun _ => hStrict Fin.castSucc_lt_succ }
        exact WithBot.coe_le_coe.mp ((Order.LTSeries.length_le_krullDim l_V).trans_eq hDimV)
      · obtain ⟨V₀, _, hDimV₀⟩ := hcov t₀
        exact hDimV₀.symm.trans_le (topologicalKrullDim_subspace_le T (V₀ : Set T))
    have h_trdeg : ∀ (S : Type u) [CommRing S] [IsDomain S] [Algebra k S]
        [Algebra (MvPolynomial (Fin n_dim) k) S] [IsScalarTower k (MvPolynomial (Fin n_dim) k) S]
        [Algebra.Etale (MvPolynomial (Fin n_dim) k) S],
        Algebra.FiniteType k S ∧ Algebra.trdeg k S = (n_dim : Cardinal.{u}) := by
      intro S _ _ _ _ _ _
      let R₀ : Type u := MvPolynomial (Fin n_dim) k
      have hFT : Algebra.FiniteType k S :=
        Algebra.FiniteType.trans (S := R₀) inferInstance inferInstance
      refine ⟨hFT, ?_⟩
      have : Algebra.Smooth R₀ S := inferInstance
      have : Module.Flat R₀ S := inferInstance
      have : Module.IsTorsionFree R₀ S := Module.Flat.isTorsionFree
      have : FaithfulSMul R₀ S := inferInstance
      have hInjR₀S : Function.Injective (algebraMap R₀ S) :=
        (faithfulSMul_iff_algebraMap_injective R₀ S).mp inferInstance
      let K₀ : Type u := FractionRing R₀
      let M : Submonoid S := Algebra.algebraMapSubmonoid S (nonZeroDivisors R₀)
      let B' : Type u := TensorProduct R₀ S K₀
      have : IsLocalization M B' := IsLocalization.tensor K₀ (nonZeroDivisors R₀)
      have hM : M ≤ nonZeroDivisors S := by
        rintro m ⟨r, hr, rfl⟩
        exact mem_nonZeroDivisors_of_ne_zero (fun h0 =>
          nonZeroDivisors.ne_zero hr (hInjR₀S (h0.trans (map_zero (algebraMap R₀ S)).symm)))
      have : IsDomain B' := IsLocalization.isDomain_of_le_nonZeroDivisors B' hM
      have hInjSB' : Function.Injective (algebraMap S B') := IsLocalization.injective B' hM
      have : FaithfulSMul S B' := (faithfulSMul_iff_algebraMap_injective S B').mpr hInjSB'
      have : FaithfulSMul k S :=
        (faithfulSMul_iff_algebraMap_injective k S).mpr (RingHom.injective (algebraMap k S))
      have : IsScalarTower k S B' := inferInstance
      have : Algebra.IsAlgebraic S B' := IsLocalization.isAlgebraic B' M
      have h_trdeg_SB' : Algebra.trdeg k S = Algebra.trdeg k B' := by
        have hadd := trdeg_add_eq k S (A := B')
        rw [trdeg_eq_zero (R := S) (A := B'), add_zero] at hadd
        exact hadd
      let B : Type u := TensorProduct R₀ K₀ S
      let e_comm : B ≃ₐ[R₀] B' := Algebra.TensorProduct.comm R₀ K₀ S
      have : IsDomain B := MulEquiv.isDomain B' e_comm.toMulEquiv
      let e_k : B ≃ₐ[k] B' := e_comm.restrictScalars k
      have h_trdeg_BB' : Algebra.trdeg k B = Algebra.trdeg k B' := AlgEquiv.trdeg_eq e_k
      have : Algebra.Etale K₀ B := Algebra.Etale.baseChange R₀ S K₀
      obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSep⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K₀ B).mp inferInstance
      have : Algebra.IsAlgebraic K₀ B := by
        let _ : Finite I := hFinI
        let _ : ∀ i : I, Field (Ai i) := hFieldAi
        let _ : ∀ i : I, Algebra K₀ (Ai i) := hAlgAi
        have : ∀ i : I, Module.Finite K₀ (Ai i) := fun i => (hFinSep i).1
        have : Module.Finite K₀ ((i : I) → Ai i) := Module.Finite.pi
        have : Module.Finite K₀ B := Module.Finite.equiv e_prod.symm.toLinearEquiv
        have : Algebra.IsIntegral K₀ B := Algebra.IsIntegral.of_finite K₀ B
        exact Algebra.IsIntegral.isAlgebraic
      have : FaithfulSMul K₀ B :=
        (faithfulSMul_iff_algebraMap_injective K₀ B).mpr (RingHom.injective (algebraMap K₀ B))
      have : FaithfulSMul k K₀ :=
        (faithfulSMul_iff_algebraMap_injective k K₀).mpr (RingHom.injective (algebraMap k K₀))
      have : IsScalarTower k K₀ B := inferInstance
      have h_trdeg_K₀B : Algebra.trdeg k K₀ = Algebra.trdeg k B := by
        have hadd := trdeg_add_eq k K₀ (A := B)
        rw [trdeg_eq_zero (R := K₀) (A := B), add_zero] at hadd
        exact hadd
      have : FaithfulSMul k R₀ :=
        (faithfulSMul_iff_algebraMap_injective k R₀).mpr (RingHom.injective (algebraMap k R₀))
      have : FaithfulSMul R₀ K₀ :=
        (faithfulSMul_iff_algebraMap_injective R₀ K₀).mpr (IsFractionRing.injective R₀ K₀)
      have : Algebra.IsAlgebraic R₀ K₀ := IsLocalization.isAlgebraic K₀ (nonZeroDivisors R₀)
      have h_trdeg_R₀K₀ : Algebra.trdeg k R₀ = Algebra.trdeg k K₀ := by
        have hadd := trdeg_add_eq k R₀ (A := K₀)
        rw [trdeg_eq_zero (R := R₀) (A := K₀), add_zero] at hadd
        exact hadd
      have h_trdeg_R₀ : Algebra.trdeg k R₀ = (n_dim : Cardinal.{u}) := by
        rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype (Fin n_dim), Fintype.card_fin,
          Cardinal.lift_natCast]
      exact h_trdeg_SB'.trans (h_trdeg_BB'.symm.trans (h_trdeg_K₀B.symm.trans
        (h_trdeg_R₀K₀.symm.trans h_trdeg_R₀)))
    have h_krull_ft : ∀ (S : Type u) [CommRing S] [IsDomain S] [Algebra k S]
        [Algebra.FiniteType k S],
