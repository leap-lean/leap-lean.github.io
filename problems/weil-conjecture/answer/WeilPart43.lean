        have hn_ja := congrArg (fun k => k.hom (θ_of A₁ Y g))
          ((C_S.map φ).hom.naturality (Opposite.op (j_a a)))
        exact hc.trans (congrArg (((C_S.obj A₂).obj.map (Opposite.op u₀)).hom) hn_ja.symm)
      have hrhs : ((C_S.obj A₂).obj.map (Opposite.op u₀)).hom
          (((C_S.obj A₂).obj.map (Opposite.op (j_a a))).hom (θ_of A₂ Y (g.map φ.hom))) =
          ((C_S.obj A₂).obj.map (Opposite.op (u₀ ≫ j_a a))).hom (θ_of A₂ Y (g.map φ.hom)) :=
        congrArg (fun k => k.hom (θ_of A₂ Y (g.map φ.hom)))
          ((C_S.obj A₂).obj.map_comp (Opposite.op (j_a a)) (Opposite.op u₀)).symm
      exact hlhs.trans ((congrArg (((C_S.obj A₂).obj.map (Opposite.op u₀)).hom) h_on_Ya).trans hrhs)
    have hCS_shortExact : ∀ {A₁ A₂ A₃ : AddCommGrpCat.{u}} (f : A₁ ⟶ A₂) (p : A₂ ⟶ A₃)
        (hfp : f ≫ p = 0),
        Function.Injective f.hom →
        Function.Surjective p.hom →
        (∀ x : ↥A₂, p.hom x = 0 → ∃ y : ↥A₁, f.hom y = x) →
        (CategoryTheory.ShortComplex.mk (C_S.map f) (C_S.map p)
          (by rw [← C_S.map_comp, hfp, C_S.map_zero])).ShortExact := by
      intro A₁ A₂ A₃ f p hfp hf_inj hp_surj hexact
      have h0_CS : C_S.map f ≫ C_S.map p = 0 := by rw [← C_S.map_comp, hfp, C_S.map_zero]
      have : CategoryTheory.Epi p := (AddCommGrpCat.epi_iff_surjective p).mpr hp_surj
      have : CategoryTheory.Epi (C_S.map p) := C_S.map_epi p
      have hLC_inj : ∀ Y : S.Etale,
          Function.Injective
            (fun g : LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y).left ↥A₁ =>
              g.map f.hom) := by
        intro Y g₁ g₂ hge
        ext y
        exact hf_inj (LocallyConstant.congr_fun hge y)
      have hLC_lift : ∀ (Y : S.Etale)
          (g₂ : LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y).left ↥A₂),
          g₂.map p.hom = 0 →
          ∃ g₁ : LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y).left ↥A₁,
            g₁.map f.hom = g₂ := by
        intro Y g₂ hg₂
        have hex_pt : ∀ y : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y).left,
            ∃ a₁ : ↥A₁, f.hom a₁ = g₂ y := by
          intro y
          apply hexact (g₂ y)
          exact LocallyConstant.congr_fun hg₂ y
        let h_fun : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y).left → ↥A₁ :=
          fun y => Classical.choose (hex_pt y)
        have hh_fun : ∀ y, f.hom (h_fun y) = g₂ y :=
          fun y => Classical.choose_spec (hex_pt y)
        have hh_lc : IsLocallyConstant h_fun := by
          intro s
          rw [isOpen_iff_forall_mem_open]
          intro y hy
          refine ⟨g₂ ⁻¹' {g₂ y}, ?_, g₂.isLocallyConstant {g₂ y}, rfl⟩
          intro y' hy'
          have heq : h_fun y' = h_fun y :=
            hf_inj (by rw [hh_fun, hh_fun]; exact hy')
          show h_fun y' ∈ s
          rwa [heq]
        refine ⟨⟨h_fun, hh_lc⟩, ?_⟩
        ext y
        exact hh_fun y
      have hKerLift : ∀ {𝒦 : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
          (g' : 𝒦 ⟶ C_S.obj A₂), g' ≫ C_S.map p = 0 →
          ∃ l : 𝒦 ⟶ C_S.obj A₁, l ≫ C_S.map f = g' ∧
            ∀ m : 𝒦 ⟶ C_S.obj A₁, m ≫ C_S.map f = g' → m = l := by
        intro 𝒦 g' hg'
        have hZeroAt : ∀ (Y : S.Etale) (k : ↑(𝒦.obj.obj (Opposite.op Y))),
            ((θ_equiv A₂ Y).symm ((g'.hom.app (Opposite.op Y)).hom k)).map p.hom = 0 := by
          intro Y k
          apply ((hθ_spec A₃).1 Y).1
          have hsymm_Y : θ_of A₂ Y ((θ_equiv A₂ Y).symm ((g'.hom.app (Opposite.op Y)).hom k)) =
              (g'.hom.app (Opposite.op Y)).hom k :=
            (θ_equiv A₂ Y).apply_symm_apply _
          rw [map_zero (θ_of A₃ Y), ← hθ_map p Y _, hsymm_Y]
          exact congrArg (fun t => (t.hom.app (Opposite.op Y)).hom k) hg'
