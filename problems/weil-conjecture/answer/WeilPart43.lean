      have hSpec_φ : AlgebraicGeometry.Spec.map φ_ring = h_aff :=
        AlgebraicGeometry.Spec.map_preimage h_aff
      have hEt_ring : RingHom.Etale φ_ring.hom := by
        have h1 : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_ring) := by
          rwa [hSpec_φ]
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp h1
