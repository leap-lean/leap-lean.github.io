        let j_F : B r →ₐ[F] B_V r :=
          { (j_B r).toRingHom with
            commutes' := fun c => by
              change j_B r (algebraMap F (B r) c) = algebraMap F (B_V r) c
              rw [IsScalarTower.algebraMap_apply F R₀ (B r), (j_B r).commutes,
