                ((𝒢.obj.map q_Z.op).hom (g_c c))
                (Or.inr ⟨c, l₁, q_Z, hl₁_fst, hl₁_snd.symm, fun z => by
                  rw [hnat_t (l₁.base z)]
                  have hpt : u_V.base (l₁.base z) = l₂.base z :=
                    congrArg (fun k => k.base z) hl₁_uV
                  rw [hpt]; exact (v_O.base z).2, rfl⟩)
              rw [h_rhs, h_lhs]
          have hpsi_add : ∀ (U : Y.Etale) (t₁ t₂ : ↑(𝒥_h.obj.obj (Opposite.op U))),
              psi_fun U (t₁ + t₂) = psi_fun U t₁ + psi_fun U t₂ := by
            intro U t₁ t₂
            let h_U := (Fgt_Y.obj U).hom
            have : AlgebraicGeometry.Etale h_U := U.prop
            let U_V := CategoryTheory.Limits.pullback h_U ι_Y
            let fst_U := CategoryTheory.Limits.pullback.fst h_U ι_Y
            let snd_U := CategoryTheory.Limits.pullback.snd h_U ι_Y
            let f₁ := triv_h U t₁
            let f₂ := triv_h U t₂
            have ht₁_mem : f₁ ∈ Set.range (triv_h U) := ⟨t₁, rfl⟩
            have ht₂_mem : f₂ ∈ Set.range (triv_h U) := ⟨t₂, rfl⟩
            rw [(hSpec_h U).2] at ht₁_mem ht₂_mem
            obtain ⟨⟨W₀₁, hW₀₁_top, hW₀₁_zero⟩, _⟩ := ht₁_mem
            obtain ⟨⟨W₀₂, hW₀₂_top, hW₀₂_zero⟩, _⟩ := ht₂_mem
            let W₀ : (Fgt_Y.obj U).left.Opens := W₀₁ ⊓ W₀₂
            have hW₀_top : ((TopologicalSpace.Opens.map h_U.base).obj U_Y) ⊔ W₀ = ⊤ := by
              dsimp [W₀]; rw [sup_inf_left, hW₀₁_top, hW₀₂_top, top_inf_eq]
            have hW₀_z1 : ∀ y : ↥U_V, fst_U.base y ∈ W₀ → f₁ y = 0 :=
              fun y hy => hW₀₁_zero y hy.1
            have hW₀_z2 : ∀ y : ↥U_V, fst_U.base y ∈ W₀ → f₂ y = 0 :=
              fun y hy => hW₀₂_zero y hy.2
            have hW₀_z12 : ∀ y : ↥U_V, fst_U.base y ∈ W₀ → triv_h U (t₁ + t₂) y = 0 := by
              intro y hy
              rw [map_add, LocallyConstant.add_apply, hW₀_z1 y hy, hW₀_z2 y hy, add_zero]
            let O_pair : C_vec × C_vec → U_V.Opens := fun p =>
              ⟨f₁ ⁻¹' {p.1}, f₁.isLocallyConstant {p.1}⟩ ⊓
                ⟨f₂ ⁻¹' {p.2}, f₂.isLocallyConstant {p.2}⟩
            let obj_add : Unit ⊕ (C_vec × C_vec) → Y.Etale := fun idx =>
              match idx with
              | Sum.inl () => AlgebraicGeometry.Scheme.Etale.mk (W₀.ι ≫ h_U)
              | Sum.inr p => AlgebraicGeometry.Scheme.Etale.mk ((O_pair p).ι ≫ fst_U ≫ h_U)
            let mor_add : ∀ idx : Unit ⊕ (C_vec × C_vec), obj_add idx ⟶ U := fun idx =>
              match idx with
              | Sum.inl () => CategoryTheory.MorphismProperty.Over.homMk W₀.ι rfl trivial
              | Sum.inr p =>
