      have hΔ_p₂ : ∀ i : Fin m, Δ i ≫ p₂ = d_V (equiv_Γ i) := by
        intro i
        dsimp only [Δ, p₂, d_V]
        rw [← AlgebraicGeometry.Spec.map_comp]
        congr 1
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro s
        change μ (equiv_Γ i) (Algebra.TensorProduct.includeRight s) = (equiv_Γ i).symm s
        dsimp only [μ]
        rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.lift_tmul]
        simp
