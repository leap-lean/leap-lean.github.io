          intro w
          let U_w : Set ↥W_U := j_W.base ⁻¹' (V_of w)
          obtain ⟨_, hw_V, u₀_pt, rfl⟩ := hDense (V_of w) (hV_spec w).1 ⟨w, (hV_spec w).2.1⟩
          have : Nonempty ↥U_w := ⟨⟨u₀_pt, hw_V⟩⟩
          have : Nonempty A := ⟨g u₀_pt⟩
          have hUw_preirred : IsPreirreducible U_w := by
            intro B₁ B₂ hB₁ hB₂ hInt₁ hInt₂
            have hImOpen : IsOpen (V_of w ∩ Set.range j_W.base) :=
              (hV_spec w).1.inter hj_open_emb.isOpen_range
            have hImPre : IsPreirreducible (V_of w ∩ Set.range j_W.base) :=
              (hV_spec w).2.2.open_subset hImOpen Set.inter_subset_left
            have hNe₁ : ((V_of w ∩ Set.range j_W.base) ∩ (j_W.base '' B₁)).Nonempty := by
              rcases hInt₁ with ⟨u, huUw, huB₁⟩
              exact ⟨j_W.base u, ⟨huUw, u, rfl⟩, u, huB₁, rfl⟩
            have hNe₂ : ((V_of w ∩ Set.range j_W.base) ∩ (j_W.base '' B₂)).Nonempty := by
              rcases hInt₂ with ⟨u, huUw, huB₂⟩
              exact ⟨j_W.base u, ⟨huUw, u, rfl⟩, u, huB₂, rfl⟩
            obtain ⟨_, ⟨hxV, u, rfl⟩, ⟨u₁_pt, hu₁, heq₁⟩, ⟨u₂_pt, hu₂, heq₂⟩⟩ :=
              hImPre (j_W.base '' B₁) (j_W.base '' B₂)
                (hj_open_emb.isOpenMap B₁ hB₁) (hj_open_emb.isOpenMap B₂ hB₂) hNe₁ hNe₂
            have h1 : u₁_pt = u := hj_open_emb.injective heq₁
            have h2 : u₂_pt = u := hj_open_emb.injective heq₂
            exact ⟨u, hxV, h1 ▸ hu₁, h2 ▸ hu₂⟩
          have hUw_conn : _root_.IsPreconnected U_w := hUw_preirred.isPreconnected
          have : PreconnectedSpace ↥U_w := Subtype.preconnectedSpace hUw_conn
          let g_sub : LocallyConstant ↥U_w A := g.comap ⟨Subtype.val, continuous_subtype_val⟩
          obtain ⟨a, ha⟩ := LocallyConstant.exists_eq_const g_sub
          refine ⟨a, fun u hu => ?_⟩
          exact LocallyConstant.congr_fun ha ⟨u, hu⟩
        let g_hat : ↥W → A := fun w => Classical.choose (hConst_on_preimage w)
        have hg_hat : ∀ (w : ↥W) (u : ↥W_U), j_W.base u ∈ V_of w → g u = g_hat w :=
          fun w => Classical.choose_spec (hConst_on_preimage w)
        have hg_hat_loc : ∀ (w w' : ↥W), w' ∈ V_of w → g_hat w' = g_hat w := by
          intro w w' hw'
          have hIntOpen : IsOpen (V_of w ∩ V_of w') := (hV_spec w).1.inter (hV_spec w').1
          obtain ⟨_, ⟨hu_w, hu_w'⟩, u, rfl⟩ :=
            hDense (V_of w ∩ V_of w') hIntOpen ⟨w', hw', (hV_spec w').2.1⟩
          exact (hg_hat w' u hu_w').symm.trans (hg_hat w u hu_w)
        have hIsLC : IsLocallyConstant g_hat := by
          intro s
          rw [isOpen_iff_forall_mem_open]
          intro w hw
          refine ⟨V_of w, ?_, (hV_spec w).1, (hV_spec w).2.1⟩
          intro w' hw'
          show g_hat w' ∈ s
          rw [hg_hat_loc w w' hw']
          exact hw
        refine ⟨⟨g_hat, hIsLC⟩, ?_⟩
        ext u
        exact (hg_hat (j_W.base u) u (hV_spec (j_W.base u)).2.1).symm
  
  
  
