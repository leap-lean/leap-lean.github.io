              rw [hcancel, h𝔪, Ideal.mem_span_singleton]; exact ⟨e, by ring⟩
            have hℓ_pow_not_𝔪 : ((ℓ ^ (r_lvl + 1) : ℕ) : 𝔒) ∉ 𝔪 := by
