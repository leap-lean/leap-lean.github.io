  have hℓ_pos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have hZModShift : ∀ (c : ℕ) (x : ZMod (ℓ ^ (r + c + 1))),
      (ℓ ^ c) • x = 0 →
      ZMod.castHom (pow_dvd_pow ℓ (by omega : r + 1 ≤ r + c + 1)) (ZMod (ℓ ^ (r + 1))) x = 0 := by
    intro c x hx
    haveI : NeZero (ℓ ^ (r + c + 1)) := ⟨(pow_pos hℓ_pos _).ne'⟩
    set v : ℕ := x.val
    have hmul : ((ℓ ^ c * v : ℕ) : ZMod (ℓ ^ (r + c + 1))) = 0 := by
      rw [Nat.cast_mul, ZMod.natCast_zmod_val, ← nsmul_eq_mul, hx]
    have hdvd : ℓ ^ (r + c + 1) ∣ ℓ ^ c * v := (ZMod.natCast_eq_zero_iff _ _).mp hmul
    have hpow_eq : ℓ ^ (r + c + 1) = ℓ ^ c * ℓ ^ (r + 1) := by
      rw [← pow_add]
      congr 1
      omega
    rw [hpow_eq] at hdvd
    have hdvd_val : ℓ ^ (r + 1) ∣ v :=
      (Nat.mul_dvd_mul_iff_left (pow_pos hℓ_pos c)).mp hdvd
    rw [ZMod.castHom_apply, ZMod.cast_eq_val]
    exact (ZMod.natCast_eq_zero_iff v (ℓ ^ (r + 1))).mpr hdvd_val

  have hIterTower : ∀ c₀ : ℕ,
      letI := D.hCR (r + c₀); letI := D.hAR_B (r + c₀)
      ∃ ι_rc : D.B_V r →ₐ[Localization.Away Δ_F] D.B_V (r + c₀),
