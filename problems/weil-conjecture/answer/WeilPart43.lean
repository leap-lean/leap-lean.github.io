      have horth_int : dotProduct x_hat_int (J_int.mulVec v_Q_int) = 0 := by
        dsimp only [x_hat_int, lam]
        rw [sub_dotProduct, smul_dotProduct, smul_dotProduct, h_orbit_pair, ha_int_spec]
        change (ℓ : PadicInt ℓ) ^ C₁ * b_int -
          (((μ₀⁻¹ : (PadicInt ℓ)ˣ) : PadicInt ℓ) * b_int) *
            ((μ₀ : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ C₁) = 0
        have hunit : ((μ₀⁻¹ : (PadicInt ℓ)ˣ) : PadicInt ℓ) * (μ₀ : PadicInt ℓ) = 1 :=
          Units.inv_mul μ₀
        calc (ℓ : PadicInt ℓ) ^ C₁ * b_int -
              (((μ₀⁻¹ : (PadicInt ℓ)ˣ) : PadicInt ℓ) * b_int) *
                ((μ₀ : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ C₁)
            = (ℓ : PadicInt ℓ) ^ C₁ * b_int -
                (((μ₀⁻¹ : (PadicInt ℓ)ˣ) : PadicInt ℓ) * (μ₀ : PadicInt ℓ)) *
                  (b_int * (ℓ : PadicInt ℓ) ^ C₁) := by ring
          _ = (ℓ : PadicInt ℓ) ^ C₁ * b_int - 1 * (b_int * (ℓ : PadicInt ℓ) ^ C₁) := by rw [hunit]
          _ = 0 := by ring
      have horth_K : dotProduct (ι₀ ∘ x_hat_int) (J_V.mulVec v_Q) = 0 := by
        have hmap := congrArg ι₀ horth_int
        rw [map_zero, RingHom.map_dotProduct, hMapMulVec, hJ_int_eq, hv_Q_int_eq,
          Matrix.smul_mulVec, Matrix.mulVec_smul, dotProduct_smul, dotProduct_smul,
          smul_eq_mul, smul_eq_mul] at hmap
        rcases mul_eq_zero.mp hmap with h1 | h2
        · exact absurd h1 hd_J
        · rcases mul_eq_zero.mp h2 with h3 | h4
          · exact absurd h3 hd_w
          · exact h4
      have hu_int : (u.val).mulVec x_hat_int = x_hat_int := by
        funext i
        apply hι_inj
        rw [RingHom.map_mulVec ι₀ u.val x_hat_int i]
        have hact := congrFun (hu_act (ι₀ ∘ x_hat_int)) i
        rw [horth_K, mul_zero, zero_smul, add_zero] at hact
        exact hact
      change ((u.val).map π_r).mulVec (π_r ∘ x_hat_int) = π_r ∘ x_hat_int
      rw [← hMapMulVec π_r u.val x_hat_int, hu_int]
  · 
    let v_Q_adap : Fin N → PadicInt ℓ := (P_chg⁻¹).val.mulVec v_Q_int
    let v_Q_mid : Fin M → PadicInt ℓ := fun k => v_Q_adap ⟨M₀ + k.1, by omega⟩
    have hv_Q_adap_eq : v_Q_adap = (G_adap g_Q).mulVec w_adap := by
      dsimp only [v_Q_adap, v_Q_int, G_adap, w_adap]
      rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec]
      congr 1
      rw [mul_assoc ((P_chg⁻¹).val * g_Q.val), Units.mul_inv, mul_one]
    have hv_Q_mid_eq : v_Q_mid = (midBlk (G_adap g_Q)).mulVec w_mid := by
      funext k₁
      dsimp only [v_Q_mid, midBlk, w_mid]
      rw [hv_Q_adap_eq]
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply]
      apply hSumMid
      intro j hj
      by_cases hlt : j.1 < M₀
      · rw [hG_adap_rad_col g_Q hg_Q ⟨M₀ + k₁.1, by omega⟩ j hlt (by dsimp; omega), zero_mul]
      · have hge : M₀ + M ≤ j.1 := by omega
        rw [hw_adap_bot j hge, mul_zero]
    have hw_mid_inv : (midBlk (G_adap g_Q⁻¹)).mulVec v_Q_mid = w_mid := by
      rw [hv_Q_mid_eq, Matrix.mulVec_mulVec, ← hMidBlk_mul g_Q⁻¹ (G_V.inv_mem hg_Q) g_Q hg_Q,
        inv_mul_cancel, hG_adap_one, hMidBlk_one, Matrix.one_mulVec]
    have hex_kQ : ∃ k_Q : Fin M, ¬ ((ℓ : PadicInt ℓ) ^ (C₂ + 1) ∣ v_Q_mid k_Q) := by
      by_contra hall
      push_neg at hall
      choose q hq using hall
      have hv_smul : v_Q_mid = (ℓ : PadicInt ℓ) ^ (C₂ + 1) • q := funext hq
      have hw_smul : w_mid = (ℓ : PadicInt ℓ) ^ (C₂ + 1) •
          ((midBlk (G_adap g_Q⁻¹)).mulVec q) := by
        rw [← hw_mid_inv, hv_smul, Matrix.mulVec_smul]
      let z : PadicInt ℓ := ((midBlk (G_adap g_Q⁻¹)).mulVec q) k₀
      have hw_z : w_mid k₀ = (ℓ : PadicInt ℓ) ^ (C₂ + 1) * z := congrFun hw_smul k₀
      have hpow_ne : (ℓ : PadicInt ℓ) ^ (C₂ + 1) ≠ 0 :=
        left_ne_zero_of_mul (hw_z ▸ hw_mid_k₀)
      have hz_ne : z ≠ 0 := right_ne_zero_of_mul (hw_z ▸ hw_mid_k₀)
      have hval := congrArg PadicInt.valuation hw_z
      rw [PadicInt.valuation_mul hpow_ne hz_ne, PadicInt.valuation_pow,
        PadicInt.valuation_p] at hval
      change C₂ = (C₂ + 1) * 1 + z.valuation at hval
      omega
    obtain ⟨k_Q, hk_Q_ndvd⟩ := hex_kQ
    have hv_Q_ne : v_Q_mid k_Q ≠ 0 := by
      intro h0
      exact hk_Q_ndvd (h0 ▸ dvd_zero _)
    let v_star : ℕ := (v_Q_mid k_Q).valuation
    let μ_Q : (PadicInt ℓ)ˣ := PadicInt.unitCoeff hv_Q_ne
    have hv_Q_spec : v_Q_mid k_Q = (μ_Q : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ v_star :=
      PadicInt.unitCoeff_spec hv_Q_ne
    have hv_star_le : v_star ≤ C₂ := by
      by_contra hgt
      have hge : C₂ + 1 ≤ v_star := by omega
      apply hk_Q_ndvd
      refine ⟨(μ_Q : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ (v_star - (C₂ + 1)), ?_⟩
      have hsub : (C₂ + 1) + (v_star - (C₂ + 1)) = v_star := Nat.add_sub_of_le hge
      calc v_Q_mid k_Q
          = (μ_Q : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ ((C₂ + 1) + (v_star - (C₂ + 1))) := by
              rw [hsub, hv_Q_spec]
        _ = (ℓ : PadicInt ℓ) ^ (C₂ + 1) *
              ((μ_Q : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ (v_star - (C₂ + 1))) := by
              rw [pow_add]
              ring
    intro v_mod
    let u_pad : Fin N → PadicInt ℓ := fun j =>
      if h : M₀ ≤ j.1 ∧ j.1 < M₀ + M then
        ((v_mod ⟨j.1 - M₀, by omega⟩).val : PadicInt ℓ)
      else 0
    let e_hat : Fin (M₀ + M) → ZMod (ℓ ^ (r + 1)) := fun i =>
      π_r ((ℓ : PadicInt ℓ) ^ C₂ * u_pad ⟨i.1, by omega⟩)
    refine ⟨e_hat, ?_, ?_, ?_⟩
    · intro i hi
      dsimp only [e_hat, u_pad]
      have hcond : ¬(M₀ ≤ i.1 ∧ i.1 < M₀ + M) := by omega
      rw [dif_neg hcond, mul_zero, map_zero]
    · intro k
      dsimp only [e_hat, u_pad]
      have hcond : M₀ ≤ M₀ + k.1 ∧ M₀ + k.1 < M₀ + M := by omega
      have hk_eq : (⟨(M₀ + k.1) - M₀, by omega⟩ : Fin M) = k := Fin.ext (by dsimp; omega)
      rw [dif_pos hcond, hk_eq, map_mul, map_pow, map_natCast, map_natCast,
        ZMod.natCast_zmod_val, nsmul_eq_mul, Nat.cast_pow]
    · intro u _ c hu_act hMidFix
      let U_adap : Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))) :=
        P_inv_r * ((u.val).map π_r) * P_r
      have hU_adap_eq : U_adap = (G_adap u).map π_r := by
        dsimp only [U_adap, G_adap, P_r, P_inv_r]
        rw [hMapMul, hMapMul]
      let w_Δ : Fin N → PadicInt ℓ := (G_adap u).mulVec u_pad - u_pad
      let m_Q : Fin N := ⟨M₀ + k_Q.1, by omega⟩
      have hw_Δ_mQ_mod : π_r (w_Δ m_Q) = 0 := by
        dsimp only [w_Δ, Pi.sub_apply]
        rw [map_sub]
        have h1 : π_r (((G_adap u).mulVec u_pad) m_Q) = v_mod k_Q := by
          have hsum_int : ((G_adap u).mulVec u_pad) m_Q =
              ∑ k₂ : Fin M, G_adap u m_Q ⟨M₀ + k₂.1, by omega⟩ *
                ((v_mod k₂).val : PadicInt ℓ) := by
            simp only [Matrix.mulVec, dotProduct]
            rw [hSumMid]
            · refine Finset.sum_congr rfl fun k₂ _ => ?_
              dsimp only [u_pad]
              have hcond : M₀ ≤ M₀ + k₂.1 ∧ M₀ + k₂.1 < M₀ + M := by omega
              have hk₂_eq : (⟨(M₀ + k₂.1) - M₀, by omega⟩ : Fin M) = k₂ :=
                Fin.ext (by dsimp; omega)
              rw [dif_pos hcond, hk₂_eq]
            · intro j hj
              dsimp only [u_pad]
              rw [dif_neg hj, mul_zero]
          rw [hsum_int, map_sum]
          have hmid_kQ := congrFun hMidFix k_Q
          simp only [Matrix.mulVec, dotProduct, Matrix.of_apply] at hmid_kQ
          refine Eq.trans ?_ hmid_kQ
          refine Finset.sum_congr rfl fun k₂ _ => ?_
          rw [map_mul, map_natCast, ZMod.natCast_zmod_val]
          change π_r (G_adap u m_Q ⟨M₀ + k₂.1, by omega⟩) * v_mod k₂ =
            U_adap m_Q ⟨M₀ + k₂.1, by omega⟩ * v_mod k₂
          rw [hU_adap_eq, Matrix.map_apply]
        have h2 : π_r (u_pad m_Q) = v_mod k_Q := by
          dsimp only [u_pad, m_Q]
          have hcond : M₀ ≤ M₀ + k_Q.1 ∧ M₀ + k_Q.1 < M₀ + M := by omega
          have hkQ_eq : (⟨(M₀ + k_Q.1) - M₀, by omega⟩ : Fin M) = k_Q :=
            Fin.ext (by dsimp; omega)
          rw [dif_pos hcond, hkQ_eq, map_natCast, ZMod.natCast_zmod_val]
        rw [h1, h2, sub_self]
      have hker_mQ : w_Δ m_Q ∈ RingHom.ker π_r := RingHom.mem_ker.mpr hw_Δ_mQ_mod
      rw [PadicInt.ker_toZModPow (r + 1), Ideal.mem_span_singleton] at hker_mQ
      obtain ⟨q_u, hq_u⟩ := hker_mQ
      
      let x_tilde_K : Fin N → Padic ℓ := ((P_chg.val).map ι₀).mulVec (ι₀ ∘ u_pad)
      let τ_u : Padic ℓ := (ι₀ d_w)⁻¹ * (c * dotProduct x_tilde_K (J_V.mulVec v_Q))
      have hw_Δ_K : ∀ i : Fin N, ι₀ (w_Δ i) = τ_u * ι₀ (v_Q_adap i) := by
        have hdiff_K : ((u.val).map ι₀).mulVec x_tilde_K - x_tilde_K =
            τ_u • (ι₀ ∘ v_Q_int) := by
          have hact := hu_act x_tilde_K
          have hsub : ((u.val).map ι₀).mulVec x_tilde_K - x_tilde_K =
              (c * dotProduct x_tilde_K (J_V.mulVec v_Q)) • v_Q :=
            sub_eq_iff_eq_add'.mpr hact
          rw [hsub, hv_Q_int_eq, smul_smul]
          dsimp only [τ_u]
          have hsc : (ι₀ d_w)⁻¹ * (c * dotProduct x_tilde_K (J_V.mulVec v_Q)) * ι₀ d_w =
              c * dotProduct x_tilde_K (J_V.mulVec v_Q) := by
            calc (ι₀ d_w)⁻¹ * (c * dotProduct x_tilde_K (J_V.mulVec v_Q)) * ι₀ d_w
                = (c * dotProduct x_tilde_K (J_V.mulVec v_Q)) * ((ι₀ d_w)⁻¹ * ι₀ d_w) := by ring
              _ = c * dotProduct x_tilde_K (J_V.mulVec v_Q) := by
                  rw [inv_mul_cancel₀ hd_w, mul_one]
          rw [hsc]
        intro i
        have hmul_left := congrFun
          (congrArg (((P_chg⁻¹).val.map ι₀).mulVec) hdiff_K) i
        rw [Matrix.mulVec_sub, Matrix.mulVec_smul] at hmul_left
        have hL1 : (((P_chg⁻¹).val.map ι₀).mulVec (((u.val).map ι₀).mulVec x_tilde_K)) i =
            ι₀ (((G_adap u).mulVec u_pad) i) := by
          dsimp only [x_tilde_K, G_adap]
          rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, ← hMapMul, ← hMapMul,
            ← RingHom.map_mulVec]
        have hL2 : (((P_chg⁻¹).val.map ι₀).mulVec x_tilde_K) i = ι₀ (u_pad i) := by
          dsimp only [x_tilde_K]
          rw [Matrix.mulVec_mulVec, ← hMapMul, Units.inv_mul, hMapOne, Matrix.one_mulVec]
          rfl
        have hR : (((P_chg⁻¹).val.map ι₀).mulVec (ι₀ ∘ v_Q_int)) i = ι₀ (v_Q_adap i) :=
          (RingHom.map_mulVec ι₀ (P_chg⁻¹).val v_Q_int i).symm
        simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul] at hmul_left
        rw [hL1, hL2, hR] at hmul_left
        dsimp only [w_Δ, Pi.sub_apply]
        rw [map_sub]
        exact hmul_left
      
      let s_u : PadicInt ℓ :=
        q_u * ((μ_Q⁻¹ : (PadicInt ℓ)ˣ) : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ (C₂ - v_star)
      have hτ_scaled : ι₀ ((ℓ : PadicInt ℓ) ^ C₂) * τ_u =
          ι₀ ((ℓ : PadicInt ℓ) ^ (r + 1) * s_u) := by
        have hmQ := hw_Δ_K m_Q
        have hv_mQ : v_Q_adap m_Q = (μ_Q : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ v_star := hv_Q_spec
        rw [hq_u, hv_mQ] at hmQ
        let f_inv : PadicInt ℓ :=
          ((μ_Q⁻¹ : (PadicInt ℓ)ˣ) : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ (C₂ - v_star)
        have hmQ_mul := congrArg (· * ι₀ f_inv) hmQ
        have hRHS : (τ_u * ι₀ ((μ_Q : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ v_star)) * ι₀ f_inv =
            ι₀ ((ℓ : PadicInt ℓ) ^ C₂) * τ_u := by
          have hint_prod : ((μ_Q : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ v_star) * f_inv =
              (ℓ : PadicInt ℓ) ^ C₂ := by
            dsimp only [f_inv]
            have hunit : (μ_Q : PadicInt ℓ) * ((μ_Q⁻¹ : (PadicInt ℓ)ˣ) : PadicInt ℓ) = 1 :=
              Units.mul_inv μ_Q
            have hsub : v_star + (C₂ - v_star) = C₂ := Nat.add_sub_of_le hv_star_le
            calc ((μ_Q : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ v_star) *
                  (((μ_Q⁻¹ : (PadicInt ℓ)ˣ) : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ (C₂ - v_star))
                = ((μ_Q : PadicInt ℓ) * ((μ_Q⁻¹ : (PadicInt ℓ)ˣ) : PadicInt ℓ)) *
                    ((ℓ : PadicInt ℓ) ^ v_star * (ℓ : PadicInt ℓ) ^ (C₂ - v_star)) := by ring
              _ = 1 * (ℓ : PadicInt ℓ) ^ (v_star + (C₂ - v_star)) := by rw [hunit, ← pow_add]
              _ = (ℓ : PadicInt ℓ) ^ C₂ := by rw [one_mul, hsub]
          calc (τ_u * ι₀ ((μ_Q : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ v_star)) * ι₀ f_inv
              = τ_u * ι₀ (((μ_Q : PadicInt ℓ) * (ℓ : PadicInt ℓ) ^ v_star) * f_inv) := by
                  rw [mul_assoc, ← map_mul]
            _ = ι₀ ((ℓ : PadicInt ℓ) ^ C₂) * τ_u := by rw [hint_prod, mul_comm]
        have hLHS : ι₀ ((ℓ : PadicInt ℓ) ^ (r + 1) * q_u) * ι₀ f_inv =
            ι₀ ((ℓ : PadicInt ℓ) ^ (r + 1) * s_u) := by
          rw [← map_mul]
          congr 1
          dsimp only [s_u, f_inv]
          ring
        exact hRHS.symm.trans (hmQ_mul.symm.trans hLHS)
      have hw_Δ_ann : ∀ i : Fin N, π_r ((ℓ : PadicInt ℓ) ^ C₂ * w_Δ i) = 0 := by
        intro i
        have hdvd_i : (ℓ : PadicInt ℓ) ^ (r + 1) ∣ (ℓ : PadicInt ℓ) ^ C₂ * w_Δ i := by
          refine ⟨s_u * v_Q_adap i, hι_inj ?_⟩
          rw [map_mul, hw_Δ_K i, ← mul_assoc, hτ_scaled, ← map_mul, mul_assoc]
        rw [← RingHom.mem_ker, PadicInt.ker_toZModPow (r + 1), Ideal.mem_span_singleton]
        exact hdvd_i
      
      funext i₁
      let n₁ : Fin N := ⟨i₁.1, by omega⟩
      have htop_diff :
          ((Matrix.of fun a b : Fin (M₀ + M) =>
            U_adap ⟨a.1, by omega⟩ ⟨b.1, by omega⟩).mulVec e_hat) i₁ - e_hat i₁ =
            π_r ((ℓ : PadicInt ℓ) ^ C₂ * w_Δ n₁) := by
        have htop_sum :
            ((Matrix.of fun a b : Fin (M₀ + M) =>
              U_adap ⟨a.1, by omega⟩ ⟨b.1, by omega⟩).mulVec e_hat) i₁ =
              π_r ((ℓ : PadicInt ℓ) ^ C₂ * (((G_adap u).mulVec u_pad) n₁)) := by
          have hint_sum : (ℓ : PadicInt ℓ) ^ C₂ * (((G_adap u).mulVec u_pad) n₁) =
              ∑ i₂ : Fin (M₀ + M), G_adap u n₁ ⟨i₂.1, by omega⟩ *
                ((ℓ : PadicInt ℓ) ^ C₂ * u_pad ⟨i₂.1, by omega⟩) := by
            simp only [Matrix.mulVec, dotProduct, Finset.mul_sum]
            rw [hSumTop]
            · refine Finset.sum_congr rfl fun i₂ _ => ?_
              ring
            · intro j hj
              have hcond : ¬(M₀ ≤ j.1 ∧ j.1 < M₀ + M) := by omega
              dsimp only [u_pad]
              rw [dif_neg hcond, mul_zero, mul_zero]
          rw [hint_sum, map_sum]
          simp only [Matrix.mulVec, dotProduct, Matrix.of_apply]
          refine Finset.sum_congr rfl fun i₂ _ => ?_
          rw [map_mul]
          change U_adap n₁ ⟨i₂.1, by omega⟩ * e_hat i₂ =
            π_r (G_adap u n₁ ⟨i₂.1, by omega⟩) * e_hat i₂
          rw [hU_adap_eq, Matrix.map_apply]
        rw [htop_sum]
        dsimp only [e_hat, w_Δ, n₁, Pi.sub_apply]
        rw [← map_sub, mul_sub]
      rw [hw_Δ_ann n₁] at htop_diff
      exact sub_eq_zero.mp htop_diff

theorem weil_mid_dev_projLine_puncture_affine_charts (F : Type u) [Field F]
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (_hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (_hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (_hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (_hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (_hU₀_eq : (U₀ : Set ↥(weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal }) :
    let D₀ := weilProjectiveSpaceOver F 1
    let R_std := Polynomial F
    let R_laur := Localization.Away (Polynomial.X : Polynomial F)
    let j₀_std : R_std →+* R_laur := algebraMap R_std R_laur
    let j₁_std : R_std →+* R_laur :=
      (Polynomial.aeval (IsLocalization.Away.invSelf (S := R_laur) (Polynomial.X : Polynomial F))).toRingHom
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∀ (u₀_std u₁_std : AlgebraicGeometry.Spec (CommRingCat.of R_std) ⟶ D₀.left),
      AlgebraicGeometry.IsOpenImmersion u₀_std →
      AlgebraicGeometry.IsOpenImmersion u₁_std →
      u₀_std ≫ D₀.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
      u₁_std ≫ D₀.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
      Set.range u₀_std.base ∪ Set.range u₁_std.base = Set.univ →
      CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₀_std))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₁_std))
        u₀_std u₁_std →
      ∀ (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme)
        (_heU_eq : CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R₀))) j_aff),
        (∀ z : ↥D₀.left, z ∉ (U₀ : Set ↥D₀.left) →
          z = s_inf.base default ∨
          ∃ (a : F) (p_a : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))),
            a ∈ S_aff ∧
            p_a.asIdeal = Ideal.span {Polynomial.X - Polynomial.C a} ∧
            z = j_aff.base p_a) ∧
        (∃ (r_inf : Polynomial F) (h_inf : R₀),
          Polynomial.eval 0 r_inf ≠ 0 ∧
          h_inf ≠ 0 ∧
          ∃ (ι_inf : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away r_inf)) ⟶ D₀.left)
            (p_inf : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away r_inf)))
            (ψ_inf : R₀ →+*
              Localization.Away (algebraMap (Polynomial F) (Localization.Away r_inf) Polynomial.X))
            (β_inv : Localization.Away
              (algebraMap (Polynomial F) (Localization.Away r_inf) Polynomial.X) →+* RatFunc F),
            AlgebraicGeometry.IsOpenImmersion ι_inf ∧
            @IsLocalization.Away R₀ _ h_inf
              (Localization.Away (algebraMap (Polynomial F) (Localization.Away r_inf) Polynomial.X))
              _ ψ_inf.toAlgebra ∧
            Ideal.comap (algebraMap (Polynomial F) (Localization.Away r_inf)) p_inf.asIdeal =
              Ideal.span {Polynomial.X} ∧
            ι_inf.base p_inf = s_inf.base default ∧
            ι_inf.base ⁻¹' (U₀ : Set ↥D₀.left) =
              { q : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away r_inf)) |
                algebraMap (Polynomial F) (Localization.Away r_inf) Polynomial.X ∉ q.asIdeal } ∧
            CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  (algebraMap (Localization.Away r_inf)
                    (Localization.Away
                      (algebraMap (Polynomial F) (Localization.Away r_inf) Polynomial.X)))))
                ι_inf =
              CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_inf))
                (CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι) ∧
            β_inv.comp ((algebraMap (Localization.Away r_inf)
              (Localization.Away
                (algebraMap (Polynomial F) (Localization.Away r_inf) Polynomial.X))).comp
                (algebraMap (Polynomial F) (Localization.Away r_inf))) =
              (Polynomial.aeval (RatFunc.X : RatFunc F)⁻¹).toRingHom ∧
            β_inv.comp (ψ_inf.comp (algebraMap (Polynomial F) R₀)) =
              algebraMap (Polynomial F) (RatFunc F)) :=
by
  intro D₀ R_std R_laur j₀_std j₁_std R₀ u₀_std u₁_std hu₀_open hu₁_open hu₀_hom hu₁_hom hcov hpb e_U _heU_eq
  
  have hSpecIdeal : ∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B)
      (x : AlgebraicGeometry.Spec (CommRingCat.of B)),
      ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).base x).asIdeal =
        Ideal.comap φ x.asIdeal := by
    intro A B _ _ φ x
    rw [AlgebraicGeometry.Spec.map_apply]
    rfl
  have hSpecComp : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
      (φ : A →+* B) (ψ : B →+* C),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ.comp φ)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) := by
    intro A B C _ _ _ φ ψ
    rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
  have hSpecId : ∀ (A : Type u) [CommRing A],
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id A)) =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of A)) := by
    intro A _
    rw [CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
  have hOfHomPreimage : ∀ {A B : Type u} [CommRing A] [CommRing B]
      (f : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A)),
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (AlgebraicGeometry.Spec.preimage f).hom) = f := by
    intro A B _ _ f
    have h : CommRingCat.ofHom (AlgebraicGeometry.Spec.preimage f).hom =
        AlgebraicGeometry.Spec.preimage f :=
      CommRingCat.Hom.ext (RingHom.ext fun _ => rfl)
    rw [h, AlgebraicGeometry.Spec.map_preimage]
  have hSpecHomInj : ∀ {A B : Type u} [CommRing A] [CommRing B] {φ ψ : A →+* B},
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) → φ = ψ := by
    intro A B _ _ φ ψ h
    have h1 := AlgebraicGeometry.Spec.map_injective h
    apply RingHom.ext
    intro x
    exact congrArg (fun (g : CommRingCat.of A ⟶ CommRingCat.of B) => g.hom x) h1
  have hAlgC : ∀ (A : Type u) [CommRing A] [Algebra F A] [Algebra (Polynomial F) A]
      [IsScalarTower F (Polynomial F) A] (c : F),
      algebraMap F A c = algebraMap (Polynomial F) A (Polynomial.C c) := by
    intro A _ _ _ _ c
    exact IsScalarTower.algebraMap_apply F (Polynomial F) A c
  have hAevalC : ∀ {A : Type u} [CommRing A] [Algebra F A] (x : A) (c : F),
      ((Polynomial.aeval x).toRingHom : Polynomial F →+* A) (Polynomial.C c) =
        algebraMap F A c := by
    intro A _ _ x c
    exact Polynomial.aeval_C x c
  have hCompApp : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
      {g : B →+* C} {f : A →+* B} {h : A →+* C},
      g.comp f = h → ∀ x : A, g (f x) = h x := by
    intro A B C _ _ _ g f h heq x
    exact RingHom.congr_fun heq x
  have hLocAwayMem : ∀ {A : Type u} [CommRing A] (S : Type u) [CommRing S] [Algebra A S]
      (r : A) [IsLocalization.Away r S] (q : PrimeSpectrum A),
      r ∉ q.asIdeal ↔ ∃ p : PrimeSpectrum S, PrimeSpectrum.comap (algebraMap A S) p = q := by
    intro A _ S _ _ r _ q
    have hmem : (q ∈ (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum A))) ↔
        q ∈ Set.range (PrimeSpectrum.comap (algebraMap A S)) := by
      rw [PrimeSpectrum.localization_away_comap_range S r]
    exact hmem
  have hMaxSubC : ∀ (c : F),
      (Ideal.span {Polynomial.X - Polynomial.C c} : Ideal (Polynomial F)).IsMaximal :=
    fun c => PrincipalIdealRing.isMaximal_of_irreducible (Polynomial.irreducible_X_sub_C c)
  have hMaxX : (Ideal.span {Polynomial.X} : Ideal (Polynomial F)).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible Polynomial.irreducible_X
  have hEqSpanSubC : ∀ (c : F) (I : Ideal (Polynomial F)), I.IsPrime →
      Polynomial.X - Polynomial.C c ∈ I →
      I = Ideal.span {Polynomial.X - Polynomial.C c} := by
    intro c I hI hmem
    refine ((hMaxSubC c).eq_of_le hI.ne_top ?_).symm
    intro y hy
    rw [Ideal.mem_span_singleton] at hy
    rcases hy with ⟨g, rfl⟩
    exact I.mul_mem_right g hmem
  have hEqSpanX : ∀ (I : Ideal (Polynomial F)), I.IsPrime →
      Polynomial.X ∈ I → I = Ideal.span {Polynomial.X} := by
    intro I hI hmem
    refine (hMaxX.eq_of_le hI.ne_top ?_).symm
    intro y hy
    rw [Ideal.mem_span_singleton] at hy
    rcases hy with ⟨g, rfl⟩
    exact I.mul_mem_right g hmem
  have hUnitOfDvd : ∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B) {d r : A},
      IsUnit (φ r) → d ∣ r → IsUnit (φ d) := by
    intro A B _ _ φ d r hr ⟨g, hg⟩
    rw [hg, map_mul] at hr
    exact isUnit_of_mul_isUnit_left hr
  have hRangeSinf : ∀ z : ↥D₀.left, z ∉ Set.range j_aff.base ↔ z = s_inf.base default := by
    intro z
    change z ∈ (Set.range j_aff.base)ᶜ ↔ z = s_inf.base default
    rw [_hsinf_compl]
    constructor
    · rintro ⟨y, rfl⟩
      exact congrArg s_inf.base (Subsingleton.elim y default)
    · rintro rfl
      exact ⟨default, rfl⟩

  
  have hExhaust : ∀ z : ↥D₀.left, z ∉ (U₀ : Set ↥D₀.left) →
      z = s_inf.base default ∨
      ∃ (a : F) (p_a : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))),
        a ∈ S_aff ∧
        p_a.asIdeal = Ideal.span {Polynomial.X - Polynomial.C a} ∧
        z = j_aff.base p_a := by
    intro z hz
    by_cases hmem : z ∈ Set.range j_aff.base
    · right
      rcases hmem with ⟨p_a, hp_eq⟩
      have hex : ∃ a ∈ S_aff, Polynomial.X - Polynomial.C a ∈ p_a.asIdeal := by
        by_contra hnone
        apply hz
        rw [_hU₀_eq]
        refine ⟨p_a, ?_, hp_eq⟩
        intro a ha h_in
        exact hnone ⟨a, ha, h_in⟩
      rcases hex with ⟨a, ha, h_in⟩
      exact ⟨a, p_a, ha, hEqSpanSubC a p_a.asIdeal p_a.isPrime h_in, hp_eq.symm⟩
    · left
      exact (hRangeSinf z).mp hmem
  refine ⟨hExhaust, ?_⟩

  let ξ_laur : R_laur := IsLocalization.Away.invSelf (S := R_laur) (Polynomial.X : Polynomial F)
  have hX_mul_ξ : j₀_std Polynomial.X * ξ_laur = 1 :=
    IsLocalization.Away.mul_invSelf (S := R_laur) (Polynomial.X : Polynomial F)

  
  have hStep4 : ∃ (w'_inf : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶ D₀.left)
      (p₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)))
      (b : F)
      (Φ_ov : Localization.Away (Polynomial.X - Polynomial.C b : Polynomial F) ≃ₐ[F] R_laur),
      AlgebraicGeometry.IsOpenImmersion w'_inf ∧
      p₀.asIdeal = Ideal.span {Polynomial.X} ∧
      w'_inf.base p₀ = s_inf.base default ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_ov.toRingEquiv.toRingHom) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (Polynomial F)
            (Localization.Away (Polynomial.X - Polynomial.C b : Polynomial F)))) ≫ j_aff) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₀_std) ≫ w'_inf ∧
      (∀ a : F, a ≠ 0 →
        Φ_ov (algebraMap (Polynomial F)
            (Localization.Away (Polynomial.X - Polynomial.C b : Polynomial F))
            (Polynomial.X - Polynomial.C b)) ≠
          j₀_std (Polynomial.C a * Polynomial.X)) := by
    
    have hj₁_X : j₁_std Polynomial.X = ξ_laur := Polynomial.aeval_X ξ_laur
    have hj₁_C : ∀ c : F, j₁_std (Polynomial.C c) = j₀_std (Polynomial.C c) := by
      intro c
      exact (hAevalC ξ_laur c).trans (hAlgC R_laur c)
    have hUnit_j₁X : IsUnit (j₁_std Polynomial.X) := by
      rw [hj₁_X]
      exact ⟨⟨ξ_laur, j₀_std Polynomial.X, by rw [mul_comm, hX_mul_ξ], hX_mul_ξ⟩, rfl⟩
    let τ_laur : R_laur →+* R_laur := IsLocalization.Away.lift (S := R_laur) Polynomial.X hUnit_j₁X
    have hτ_j₀ : τ_laur.comp j₀_std = j₁_std := by
      apply RingHom.ext; intro p
      exact IsLocalization.Away.lift_eq (S := R_laur) Polynomial.X hUnit_j₁X p
    have hτ_ξ : τ_laur ξ_laur = j₀_std Polynomial.X := by
      have h1 : τ_laur (j₀_std Polynomial.X * ξ_laur) = τ_laur 1 := congrArg τ_laur hX_mul_ξ
      rw [map_mul, map_one] at h1
      have h2 : τ_laur (j₀_std Polynomial.X) = ξ_laur :=
        (hCompApp hτ_j₀ Polynomial.X).trans hj₁_X
      rw [h2] at h1
      calc τ_laur ξ_laur
        _ = (j₀_std Polynomial.X * ξ_laur) * τ_laur ξ_laur := by rw [hX_mul_ξ, one_mul]
        _ = j₀_std Polynomial.X * (ξ_laur * τ_laur ξ_laur) := by rw [mul_assoc]
        _ = j₀_std Polynomial.X := by rw [h1, mul_one]
    have hτ_j₁ : τ_laur.comp j₁_std = j₀_std := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext; intro c
        simp only [RingHom.comp_apply, hj₁_C]
        exact (hCompApp hτ_j₀ (Polynomial.C c)).trans (hj₁_C c)
      · simp only [RingHom.comp_apply, hj₁_X, hτ_ξ]
    have hτ_inv : τ_laur.comp τ_laur = RingHom.id R_laur := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial F))
      rw [RingHom.comp_assoc, hτ_j₀, hτ_j₁, RingHom.id_comp]
    let g₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₀_std)
    let g₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₁_std)
    let e_τ : CategoryTheory.Iso
        (AlgebraicGeometry.Spec (CommRingCat.of R_laur))
        (AlgebraicGeometry.Spec (CommRingCat.of R_laur)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_laur)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_laur)
        hom_inv_id := by rw [← hSpecComp, hτ_inv, hSpecId]
        inv_hom_id := by rw [← hSpecComp, hτ_inv, hSpecId] }
    have heτ_g₀ : e_τ.hom ≫ g₀ = g₁ := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_laur) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₀_std) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₁_std)
      rw [← hSpecComp, hτ_j₀]
    have heτ_g₁ : e_τ.hom ≫ g₁ = g₀ := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_laur) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₁_std) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₀_std)
      rw [← hSpecComp, hτ_j₁]
    have hpb_symm : CategoryTheory.IsPullback g₀ g₁ u₁_std u₀_std := by
      refine hpb.flip.of_iso e_τ (CategoryTheory.Iso.refl _)
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_ ?_ ?_
      · simp [heτ_g₀]; rfl
      · simp [heτ_g₁]; rfl
      · simp
      · simp
    let pt_inf : ↥D₀.left := s_inf.base default
    have hSelectChart : ∃ (w_inf w_other : AlgebraicGeometry.Spec (CommRingCat.of R_std) ⟶ D₀.left),
        AlgebraicGeometry.IsOpenImmersion w_inf ∧
        AlgebraicGeometry.IsOpenImmersion w_other ∧
        w_inf ≫ D₀.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
        w_other ≫ D₀.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
        Set.range w_inf.base ∪ Set.range w_other.base = Set.univ ∧
        CategoryTheory.IsPullback g₀ g₁ w_inf w_other ∧
        pt_inf ∈ Set.range w_inf.base := by
      have hpt_univ : pt_inf ∈ (Set.univ : Set ↥D₀.left) := Set.mem_univ pt_inf
      rw [← hcov] at hpt_univ
      rcases hpt_univ with h0 | h1
      · exact ⟨u₀_std, u₁_std, hu₀_open, hu₁_open, hu₀_hom, hu₁_hom, hcov, hpb, h0⟩
      · refine ⟨u₁_std, u₀_std, hu₁_open, hu₀_open, hu₁_hom, hu₀_hom, ?_, hpb_symm, h1⟩
        rw [Set.union_comm, hcov]
    rcases hSelectChart with
      ⟨w_inf, w_other, hw_inf_open, hw_other_open, hw_inf_hom, hw_other_hom, hw_cov, hpb_w, hpt_in_w⟩

    
    let dF : AlgebraicGeometry.Spec (CommRingCat.of F) := default
    have hLiftSec : ∀ (w : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶ D₀.left)
        (_ : AlgebraicGeometry.IsOpenImmersion w)
        (_ : w ≫ D₀.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
        (s : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ D₀.left)
        (_ : s ≫ D₀.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
        (_ : s.base default ∈ Set.range w.base),
        ∃ (c₀ : F) (q : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))),
          q.asIdeal = Ideal.span {Polynomial.X - Polynomial.C c₀} ∧
          w.base q = s.base default := by
      intro w hw_op hw_h s hs_sec hs_mem
      have h_sub : Set.range ⇑s ⊆ Set.range ⇑w := by
        rintro _ ⟨y, rfl⟩
        rw [Subsingleton.elim y default]
        exact hs_mem
      let s_tilde := AlgebraicGeometry.IsOpenImmersion.lift w s h_sub
      have hs_fac : s_tilde ≫ w = s := AlgebraicGeometry.IsOpenImmersion.lift_fac w s h_sub
      let ψ : Polynomial F →+* F := (AlgebraicGeometry.Spec.preimage s_tilde).hom
      have hψ_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) = s_tilde :=
        hOfHomPreimage s_tilde
      have hψ_C : ψ.comp Polynomial.C = RingHom.id F := by
        apply hSpecHomInj
        rw [hSpecComp, hψ_map, hSpecId, ← hw_h, ← CategoryTheory.Category.assoc, hs_fac, hs_sec]
      let c₀ : F := ψ Polynomial.X
      let q : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) := s_tilde.base dF
      have hq_w : w.base q = s.base default := by
        have h1 : w.base q = s.base dF := by
          change (w.base (s_tilde.base dF)) = s.base dF
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hs_fac]
        exact h1.trans (congrArg s.base (Subsingleton.elim dF default))
      have hq_id : q.asIdeal = Ideal.span {Polynomial.X - Polynomial.C c₀} := by
        apply hEqSpanSubC c₀ q.asIdeal q.isPrime
        have hq_eq : q.asIdeal = Ideal.comap ψ dF.asIdeal := by
          change (s_tilde.base dF).asIdeal = _
          rw [← hψ_map]
          exact hSpecIdeal ψ dF
        rw [hq_eq, Ideal.mem_comap, map_sub]
        have hC : ψ (Polynomial.C c₀) = c₀ := hCompApp hψ_C c₀
        rw [hC, sub_self]
        exact Ideal.zero_mem _
      exact ⟨c₀, q, hq_id, hq_w⟩

    have hw_other_pre : ∀ q : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)),
        w_other.base q ∈ Set.range w_inf.base ↔ Polynomial.X ∉ q.asIdeal := by
      intro q
      constructor
      · rintro ⟨p, hp⟩
        obtain ⟨r, hr₀, hr₁⟩ := AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_w p q hp
        let r' := e_τ.hom.base r
        have hq_r' : g₀.base r' = q := by
          have hcomp : (e_τ.hom ≫ g₀).base r = g₁.base r := by rw [heτ_g₀]
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply] at hcomp
          exact hcomp.trans hr₁
        intro hX_in
        rw [← hq_r'] at hX_in
        have hX_r' : j₀_std Polynomial.X ∈ r'.asIdeal := by
          have hid := hSpecIdeal j₀_std r'
          change Polynomial.X ∈ (g₀.base r').asIdeal at hX_in
          rwa [hid, Ideal.mem_comap] at hX_in
        have hUnit_X : IsUnit (j₀_std Polynomial.X) :=
          IsLocalization.map_units R_laur ⟨Polynomial.X, Submonoid.mem_powers Polynomial.X⟩
        exact r'.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem r'.asIdeal hX_r' hUnit_X)
      · intro hX_not
        rcases (hLocAwayMem R_laur (Polynomial.X : Polynomial F) q).mp hX_not with ⟨r'_raw, hr'⟩
        let r' : AlgebraicGeometry.Spec (CommRingCat.of R_laur) := r'_raw
        let r : AlgebraicGeometry.Spec (CommRingCat.of R_laur) := e_τ.inv.base r'
        have hg₁_r : g₁.base r = q := by
          have h1 : g₁ = e_τ.hom ≫ g₀ := heτ_g₀.symm
          rw [h1]
          change (e_τ.hom ≫ g₀).base (e_τ.inv.base r') = q
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply,
            ← AlgebraicGeometry.Scheme.Hom.comp_apply e_τ.inv e_τ.hom r', e_τ.inv_hom_id]
          change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₀_std) r') = q
          rw [AlgebraicGeometry.Spec.map_apply]
          exact hr'
        refine ⟨g₀.base r, ?_⟩
        have hw_comm : (g₀ ≫ w_inf).base r = (g₁ ≫ w_other).base r := by rw [hpb_w.w]
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply, hg₁_r]
          at hw_comm
        exact hw_comm

    let ev0 : Polynomial F →+* F := Polynomial.evalRingHom 0
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ D₀.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0) ≫ w_other
    have hs₀_sec : s₀ ≫ D₀.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)) := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0) ≫ w_other) ≫ D₀.hom = _
      rw [CategoryTheory.Category.assoc, hw_other_hom, ← hSpecComp]
      have hev_C : ev0.comp Polynomial.C = RingHom.id F := by
        apply RingHom.ext; intro c
        simp [ev0]
      rw [hev_C, hSpecId]
    let q_orig : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) :=
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0)).base dF
    have hq_orig_id : q_orig.asIdeal = Ideal.span {Polynomial.X} := by
      apply hEqSpanX q_orig.asIdeal q_orig.isPrime
      rw [hSpecIdeal ev0 dF, Ideal.mem_comap]
      have hevX : ev0 Polynomial.X = 0 := by simp [ev0]
      rw [hevX]
      exact Ideal.zero_mem _
    let pt_0 : ↥D₀.left := s₀.base default
    have hpt0_eq : pt_0 = w_other.base q_orig := by
      have hd : (default : AlgebraicGeometry.Spec (CommRingCat.of F)) = dF :=
        Subsingleton.elim _ _
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0) ≫ w_other).base default = _
      rw [hd, AlgebraicGeometry.Scheme.Hom.comp_apply]
    have hRangeWinf : ∀ z : ↥D₀.left, z ∈ Set.range w_inf.base ↔ z ≠ pt_0 := by
      intro z
      constructor
      · rintro ⟨p, rfl⟩ h_eq
        have h_in : pt_0 ∈ Set.range w_inf.base := ⟨p, h_eq⟩
        rw [hpt0_eq, hw_other_pre] at h_in
        apply h_in
        rw [hq_orig_id]
        exact Ideal.mem_span_singleton_self Polynomial.X
      · intro hne
        by_contra hnot
        have hz_univ : z ∈ (Set.univ : Set ↥D₀.left) := Set.mem_univ z
        rw [← hw_cov] at hz_univ
        rcases hz_univ with h_in | ⟨q, rfl⟩
        · exact hnot h_in
        · have hX_in : Polynomial.X ∈ q.asIdeal := by
            by_contra hX_not
            exact hnot ((hw_other_pre q).mpr hX_not)
          have hq_eq : q = q_orig := by
            apply PrimeSpectrum.ext
            rw [hEqSpanX q.asIdeal q.isPrime hX_in, hq_orig_id]
          exact hne (by rw [hq_eq, hpt0_eq])

    
    obtain ⟨c_inf, p_cinf, hp_cinf_id, hp_cinf_w⟩ :=
      hLiftSec w_inf hw_inf_open hw_inf_hom s_inf _hsinf_sec hpt_in_w
    let φ_sh : Polynomial F →+* Polynomial F :=
      (Polynomial.aeval (Polynomial.X + Polynomial.C c_inf : Polynomial F)).toRingHom
    let φ_sh_inv : Polynomial F →+* Polynomial F :=
      (Polynomial.aeval (Polynomial.X - Polynomial.C c_inf : Polynomial F)).toRingHom
    have hφ_sh_id₁ : φ_sh.comp φ_sh_inv = RingHom.id (Polynomial F) := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext; intro c; simp [φ_sh, φ_sh_inv]
      · simp [φ_sh, φ_sh_inv]
    have hφ_sh_id₂ : φ_sh_inv.comp φ_sh = RingHom.id (Polynomial F) := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext; intro c; simp [φ_sh, φ_sh_inv]
      · simp [φ_sh, φ_sh_inv]
    let e_sh : CategoryTheory.Iso
        (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)))
        (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sh)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sh_inv)
        hom_inv_id := by rw [← hSpecComp, hφ_sh_id₁, hSpecId]
        inv_hom_id := by rw [← hSpecComp, hφ_sh_id₂, hSpecId] }
    have he_sh_open : AlgebraicGeometry.IsOpenImmersion e_sh.hom :=
      @AlgebraicGeometry.IsOpenImmersion.of_isIso _ _ e_sh.hom e_sh.isIso_hom
    let w'_inf : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶ D₀.left :=
      e_sh.hom ≫ w_inf
    have hw'_open : AlgebraicGeometry.IsOpenImmersion w'_inf :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion)
        e_sh.hom w_inf he_sh_open hw_inf_open
    have hw'_hom : w'_inf ≫ D₀.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sh) ≫ w_inf) ≫ D₀.hom = _
      rw [CategoryTheory.Category.assoc, hw_inf_hom, ← hSpecComp]
      have hC : φ_sh.comp Polynomial.C = Polynomial.C := by
        apply RingHom.ext; intro c; simp [φ_sh]
      rw [hC]
    have hRangeW' : Set.range w'_inf.base = Set.range w_inf.base := by
      ext z
      constructor
      · rintro ⟨q, rfl⟩
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
        exact ⟨e_sh.hom.base q, rfl⟩
      · rintro ⟨p, rfl⟩
        refine ⟨e_sh.inv.base p, ?_⟩
        change (e_sh.hom ≫ w_inf).base (e_sh.inv.base p) = w_inf.base p
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply,
          ← AlgebraicGeometry.Scheme.Hom.comp_apply e_sh.inv e_sh.hom p, e_sh.inv_hom_id]
        rfl
    let p₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) := q_orig
    have hp₀_id : p₀.asIdeal = Ideal.span {Polynomial.X} := hq_orig_id
    have he_sh_p₀ : e_sh.hom.base p₀ = p_cinf := by
      apply PrimeSpectrum.ext
      rw [hp_cinf_id]
      apply hEqSpanSubC c_inf (e_sh.hom.base p₀).asIdeal (e_sh.hom.base p₀).isPrime
      rw [hSpecIdeal φ_sh p₀, Ideal.mem_comap, hp₀_id]
      have hval : φ_sh (Polynomial.X - Polynomial.C c_inf) = Polynomial.X := by
        simp [φ_sh]
      rw [hval]
      exact Ideal.mem_span_singleton_self Polynomial.X
    have hw'_p₀ : w'_inf.base p₀ = pt_inf := by
      change (e_sh.hom ≫ w_inf).base p₀ = s_inf.base default
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply, he_sh_p₀, hp_cinf_w]

    have hpt0_ne_inf : pt_0 ≠ pt_inf := by
      intro h_eq
      exact ((hRangeWinf pt_inf).mp hpt_in_w) h_eq.symm
    have hpt0_in_jaff : pt_0 ∈ Set.range j_aff.base := by
      by_contra hnot
      exact hpt0_ne_inf ((hRangeSinf pt_0).mp hnot)
    obtain ⟨b, q_b, hqb_id, hqb_jaff⟩ :=
      hLiftSec j_aff _hj_open _hj_hom s₀ hs₀_sec hpt0_in_jaff
    have hqb_pt0 : j_aff.base q_b = pt_0 := hqb_jaff
    have hp_cinf_pt : w_inf.base p_cinf = pt_inf := hp_cinf_w

    let R_Xb := Localization.Away (Polynomial.X - Polynomial.C b : Polynomial F)
    let f_Xb := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R_Xb))
    let ι_Xb : AlgebraicGeometry.Spec (CommRingCat.of R_Xb) ⟶ D₀.left := f_Xb ≫ j_aff
    let ι_v0 : AlgebraicGeometry.Spec (CommRingCat.of R_laur) ⟶ D₀.left := g₀ ≫ w'_inf
    have hf_Xb_open : AlgebraicGeometry.IsOpenImmersion f_Xb :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (S := R_Xb)
        (Polynomial.X - Polynomial.C b : Polynomial F)
    have hg₀_open : AlgebraicGeometry.IsOpenImmersion g₀ :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (S := R_laur)
        (Polynomial.X : Polynomial F)
    have hι_Xb_open : AlgebraicGeometry.IsOpenImmersion ι_Xb :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion)
        f_Xb j_aff hf_Xb_open _hj_open
    have hι_v0_open : AlgebraicGeometry.IsOpenImmersion ι_v0 :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion)
        g₀ w'_inf hg₀_open hw'_open
    have hjaff_inj : Function.Injective j_aff.base := _hj_open.base_open.injective
    have hw'_inj : Function.Injective w'_inf.base := hw'_open.base_open.injective
    have hRange_ov : Set.range ⇑ι_Xb = Set.range ⇑ι_v0 := by
      ext z
      have hL : z ∈ Set.range ⇑ι_Xb ↔ z ≠ pt_inf ∧ z ≠ pt_0 := by
        constructor
        · rintro ⟨r, rfl⟩
          change (f_Xb ≫ j_aff).base r ≠ pt_inf ∧ (f_Xb ≫ j_aff).base r ≠ pt_0
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
          refine ⟨?_, ?_⟩
          · intro h_eq
            have hmem : pt_inf ∈ Set.range j_aff.base := ⟨f_Xb.base r, h_eq⟩
            exact hmem.elim fun p hp => ((hRangeSinf pt_inf).mpr rfl) ⟨p, hp⟩
          · intro h_eq
            rw [← hqb_pt0] at h_eq
            have hfr : f_Xb.base r = q_b := hjaff_inj h_eq
            have h_in : Polynomial.X - Polynomial.C b ∈ (f_Xb.base r).asIdeal := by
              rw [hfr, hqb_id]
              exact Ideal.mem_span_singleton_self _
            rw [hSpecIdeal (algebraMap (Polynomial F) R_Xb) r, Ideal.mem_comap] at h_in
            have hUnit_Xb : IsUnit (algebraMap (Polynomial F) R_Xb (Polynomial.X - Polynomial.C b)) :=
              IsLocalization.map_units R_Xb
                ⟨Polynomial.X - Polynomial.C b, Submonoid.mem_powers (Polynomial.X - Polynomial.C b)⟩
            exact r.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem r.asIdeal h_in hUnit_Xb)
        · rintro ⟨hne_inf, hne_0⟩
          have hz_jaff : z ∈ Set.range j_aff.base := by
            by_contra hnot
            exact hne_inf ((hRangeSinf z).mp hnot)
          rcases hz_jaff with ⟨q, rfl⟩
          have hq_ne : q ≠ q_b := by
            intro hq_eq
            subst hq_eq
            exact hne_0 hqb_pt0
          have h_notin : Polynomial.X - Polynomial.C b ∉ q.asIdeal := by
            intro h_in
            apply hq_ne
            apply PrimeSpectrum.ext
            rw [hEqSpanSubC b q.asIdeal q.isPrime h_in, hqb_id]
          rcases (hLocAwayMem R_Xb (Polynomial.X - Polynomial.C b : Polynomial F) q).mp h_notin
            with ⟨r_raw, hr⟩
          let r : AlgebraicGeometry.Spec (CommRingCat.of R_Xb) := r_raw
          refine ⟨r, ?_⟩
          change (f_Xb ≫ j_aff).base r = j_aff.base q
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
          congr 1
      have hR : z ∈ Set.range ⇑ι_v0 ↔ z ≠ pt_inf ∧ z ≠ pt_0 := by
        constructor
        · rintro ⟨r, rfl⟩
          change (g₀ ≫ w'_inf).base r ≠ pt_inf ∧ (g₀ ≫ w'_inf).base r ≠ pt_0
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
          refine ⟨?_, ?_⟩
          · intro h_eq
            rw [← hw'_p₀] at h_eq
            have hgr : g₀.base r = p₀ := hw'_inj h_eq
            have h_in : Polynomial.X ∈ (g₀.base r).asIdeal := by
              rw [hgr, hp₀_id]
              exact Ideal.mem_span_singleton_self _
            rw [hSpecIdeal j₀_std r, Ideal.mem_comap] at h_in
            have hUnit_X : IsUnit (j₀_std Polynomial.X) :=
              IsLocalization.map_units R_laur ⟨Polynomial.X, Submonoid.mem_powers Polynomial.X⟩
            exact r.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem r.asIdeal h_in hUnit_X)
          · intro h_eq
            have hmem : pt_0 ∈ Set.range w'_inf.base := ⟨g₀.base r, h_eq⟩
            rw [hRangeW', hRangeWinf] at hmem
            exact hmem rfl
        · rintro ⟨hne_inf, hne_0⟩
          have hz_w' : z ∈ Set.range w'_inf.base := by
            rw [hRangeW', hRangeWinf]
            exact hne_0
          rcases hz_w' with ⟨q, rfl⟩
          have hq_ne : q ≠ p₀ := by
            intro hq_eq
            subst hq_eq
            exact hne_inf hw'_p₀
          have h_notin : Polynomial.X ∉ q.asIdeal := by
            intro h_in
            apply hq_ne
            apply PrimeSpectrum.ext
            rw [hEqSpanX q.asIdeal q.isPrime h_in, hp₀_id]
          rcases (hLocAwayMem R_laur (Polynomial.X : Polynomial F) q).mp h_notin with ⟨r_raw, hr⟩
          let r : AlgebraicGeometry.Spec (CommRingCat.of R_laur) := r_raw
          refine ⟨r, ?_⟩
          change (g₀ ≫ w'_inf).base r = w'_inf.base q
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
          congr 1
      exact hL.trans hR.symm

    let e_ov := @AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq _ _ _
      ι_Xb ι_v0 hι_Xb_open hι_v0_open hRange_ov
    have he_ov_inv : e_ov.inv ≫ ι_Xb = ι_v0 :=
      @AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac _ _ _
        ι_Xb ι_v0 hι_Xb_open hι_v0_open hRange_ov
    let φ_ov_hom : R_Xb →+* R_laur := (AlgebraicGeometry.Spec.preimage e_ov.inv).hom
    let φ_ov_inv : R_laur →+* R_Xb := (AlgebraicGeometry.Spec.preimage e_ov.hom).hom
    have hφ_ov_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_ov_hom) = e_ov.inv :=
      hOfHomPreimage e_ov.inv
    have hφ_ov_map_inv : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_ov_inv) = e_ov.hom :=
      hOfHomPreimage e_ov.hom
    have hφ_ov_id₁ : φ_ov_hom.comp φ_ov_inv = RingHom.id R_laur := by
      apply hSpecHomInj
      rw [hSpecComp, hφ_ov_map, hφ_ov_map_inv, e_ov.inv_hom_id, hSpecId]
    have hφ_ov_id₂ : φ_ov_inv.comp φ_ov_hom = RingHom.id R_Xb := by
      apply hSpecHomInj
      rw [hSpecComp, hφ_ov_map_inv, hφ_ov_map, e_ov.hom_inv_id, hSpecId]
    have hφ_ov_geom : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_ov_hom) ≫ ι_Xb = ι_v0 := by
      rw [hφ_ov_map, he_ov_inv]
    have hφ_ov_F : ∀ c : F, φ_ov_hom (algebraMap F R_Xb c) = algebraMap F R_laur c := by
      have hcomp_hom :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_ov_hom) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R_Xb)) ≫
              j_aff)) ≫ D₀.hom =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₀_std) ≫ w'_inf) ≫ D₀.hom :=
        congrArg (· ≫ D₀.hom) hφ_ov_geom
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, _hj_hom,
        CategoryTheory.Category.assoc, hw'_hom, ← hSpecComp, ← hSpecComp, ← hSpecComp] at hcomp_hom
      have hEqF := hSpecHomInj hcomp_hom
      intro c
      have hc : φ_ov_hom (algebraMap (Polynomial F) R_Xb (Polynomial.C c)) =
          j₀_std (Polynomial.C c) := by
        simpa only [RingHom.comp_apply] using RingHom.congr_fun hEqF c
      rw [hAlgC R_Xb c, hAlgC R_laur c]
      exact hc
    let Φ_ov : R_Xb ≃ₐ[F] R_laur :=
      { toFun := φ_ov_hom
        invFun := φ_ov_inv
        left_inv := fun x => RingHom.congr_fun hφ_ov_id₂ x
        right_inv := fun x => RingHom.congr_fun hφ_ov_id₁ x
        map_mul' := map_mul φ_ov_hom
        map_add' := map_add φ_ov_hom
        commutes' := hφ_ov_F }

    
    have hNoPos : ∀ a : F, a ≠ 0 →
        Φ_ov (algebraMap (Polynomial F) R_Xb (Polynomial.X - Polynomial.C b)) ≠
          j₀_std (Polynomial.C a * Polynomial.X) := by
      intro a ha_ne h_pos
      let q_avoid : Polynomial F := 1 - Polynomial.C c_inf * Polynomial.X
      have hq_av_ev0 : Polynomial.eval 0 q_avoid = 1 := by simp [q_avoid]
      have hq_av_ne : q_avoid ≠ 0 := by
        intro h0
        rw [h0, Polynomial.eval_zero] at hq_av_ev0
        exact zero_ne_one hq_av_ev0
      let R_av := Localization.Away q_avoid
      let μ_av : AlgebraicGeometry.Spec (CommRingCat.of R_av) ⟶ D₀.left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R_av)) ≫ w_other
      have h_sub_av : Set.range ⇑μ_av ⊆ Set.range ⇑j_aff := by
        rintro _ ⟨q_pt, rfl⟩
        by_contra hnot
        have h_eq_inf : μ_av.base q_pt = pt_inf := (hRangeSinf (μ_av.base q_pt)).mp hnot
        rw [← hp_cinf_pt] at h_eq_inf
        let q'_pt := (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (Polynomial F) R_av))).base q_pt
        have h_eq_w : w_inf.base p_cinf = w_other.base q'_pt := by
          simpa [μ_av, q'_pt, AlgebraicGeometry.Scheme.Hom.comp_apply] using h_eq_inf.symm
        obtain ⟨r_pt, hr₀, hr₁⟩ :=
          AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_w p_cinf q'_pt h_eq_w
        have hj₁_qav : j₁_std q_avoid =
            j₀_std (Polynomial.X - Polynomial.C c_inf) * ξ_laur := by
          dsimp [q_avoid]
          rw [map_sub, map_one, map_mul, hj₁_C, hj₁_X, map_sub, sub_mul, hX_mul_ξ]
        have h_in_r0 : j₀_std (Polynomial.X - Polynomial.C c_inf) ∈ r_pt.asIdeal := by
          have h1 : Polynomial.X - Polynomial.C c_inf ∈ (g₀.base r_pt).asIdeal := by
            rw [hr₀, hp_cinf_id]
            exact Ideal.mem_span_singleton_self _
          rwa [hSpecIdeal j₀_std r_pt, Ideal.mem_comap] at h1
        have h_in_r1 : j₁_std q_avoid ∈ r_pt.asIdeal := by
          rw [hj₁_qav]
          exact r_pt.asIdeal.mul_mem_right ξ_laur h_in_r0
        have h_in_q' : q_avoid ∈ q'_pt.asIdeal := by
          rw [← hr₁, hSpecIdeal j₁_std r_pt, Ideal.mem_comap]
          exact h_in_r1
        have h_in_q : algebraMap (Polynomial F) R_av q_avoid ∈ q_pt.asIdeal := by
          rwa [hSpecIdeal (algebraMap (Polynomial F) R_av) q_pt, Ideal.mem_comap] at h_in_q'
        have hUnit_qav : IsUnit (algebraMap (Polynomial F) R_av q_avoid) :=
          IsLocalization.map_units R_av ⟨q_avoid, Submonoid.mem_powers q_avoid⟩
        exact q_pt.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q_pt.asIdeal h_in_q hUnit_qav)
      let μ_tilde := AlgebraicGeometry.IsOpenImmersion.lift j_aff μ_av h_sub_av
      have hμ_fac : μ_tilde ≫ j_aff = μ_av :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac j_aff μ_av h_sub_av
      let α_av : Polynomial F →+* R_av := (AlgebraicGeometry.Spec.preimage μ_tilde).hom
      have hα_geom : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_av) ≫ j_aff = μ_av := by
        rw [hOfHomPreimage μ_tilde, hμ_fac]

      let prod_tr : Polynomial F := Polynomial.X * q_avoid
      have hprod_tr_ne : prod_tr ≠ 0 := mul_ne_zero Polynomial.X_ne_zero hq_av_ne
      let R_tr := Localization.Away prod_tr
      let ι_tr : Polynomial F →+* R_tr := algebraMap (Polynomial F) R_tr
      have hι_tr_inj : Function.Injective ι_tr :=
        IsLocalization.injective R_tr (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hprod_tr_ne))
      have hUnit_prod_tr : IsUnit (ι_tr prod_tr) :=
        IsLocalization.map_units R_tr ⟨prod_tr, Submonoid.mem_powers prod_tr⟩
      have hUnit_X_tr : IsUnit (ι_tr Polynomial.X) :=
        hUnitOfDvd ι_tr hUnit_prod_tr ⟨q_avoid, rfl⟩
      have hUnit_q_tr : IsUnit (ι_tr q_avoid) :=
        hUnitOfDvd ι_tr hUnit_prod_tr ⟨Polynomial.X, mul_comm Polynomial.X q_avoid⟩
      let u_w : R_trˣ := hUnit_X_tr.unit
      have hu_w_val : (u_w : R_tr) = ι_tr Polynomial.X := rfl
      let ρ_av : R_av →+* R_tr := IsLocalization.Away.lift (S := R_av) q_avoid hUnit_q_tr
      have hρ_av_comp : ρ_av.comp (algebraMap (Polynomial F) R_av) = ι_tr := by
        apply RingHom.ext; intro p
        exact IsLocalization.Away.lift_eq (S := R_av) q_avoid hUnit_q_tr p
      let δ_tr : R_laur →+* R_tr := IsLocalization.Away.lift (S := R_laur) Polynomial.X hUnit_X_tr
      have hδ_tr_comp : δ_tr.comp j₀_std = ι_tr := by
        apply RingHom.ext; intro p
        exact IsLocalization.Away.lift_eq (S := R_laur) Polynomial.X hUnit_X_tr p
      have hδ_tr_ξ : δ_tr ξ_laur = ↑(u_w⁻¹) := by
        have h1 : δ_tr (j₀_std Polynomial.X * ξ_laur) = δ_tr 1 := congrArg δ_tr hX_mul_ξ
        rw [map_mul, map_one] at h1
        have h2 : δ_tr (j₀_std Polynomial.X) = (u_w : R_tr) :=
          hCompApp hδ_tr_comp Polynomial.X
        rw [h2] at h1
        calc δ_tr ξ_laur
          _ = (↑(u_w⁻¹) * (u_w : R_tr)) * δ_tr ξ_laur := by rw [Units.inv_mul, one_mul]
          _ = ↑(u_w⁻¹) * ((u_w : R_tr) * δ_tr ξ_laur) := by rw [mul_assoc]
          _ = ↑(u_w⁻¹) := by rw [h1, mul_one]
      let γ_u : R_laur →+* R_tr := δ_tr.comp τ_laur
      have hγ_u_j₁ : γ_u.comp j₁_std = ι_tr := by
        change δ_tr.comp (τ_laur.comp j₁_std) = ι_tr
        rw [hτ_j₁, hδ_tr_comp]
      have hγ_u_X : γ_u (j₀_std Polynomial.X) = ↑(u_w⁻¹) := by
        change δ_tr (τ_laur (j₀_std Polynomial.X)) = ↑(u_w⁻¹)
        rw [hCompApp hτ_j₀ Polynomial.X, hj₁_X, hδ_tr_ξ]
      have hγ_u_C : ∀ c : F, γ_u (j₀_std (Polynomial.C c)) = ι_tr (Polynomial.C c) := by
        intro c
        change δ_tr (τ_laur (j₀_std (Polynomial.C c))) = ι_tr (Polynomial.C c)
        rw [hCompApp hτ_j₀ (Polynomial.C c), hj₁_C, hCompApp hδ_tr_comp (Polynomial.C c)]
      let γ_v0 : Polynomial F →+* R_tr := (γ_u.comp j₀_std).comp φ_sh_inv
      have hγ_v0_X : γ_v0 Polynomial.X = ↑(u_w⁻¹) * ι_tr q_avoid := by
        have h1 : γ_v0 Polynomial.X = ↑(u_w⁻¹) - ι_tr (Polynomial.C c_inf) := by
          change γ_u (j₀_std (φ_sh_inv Polynomial.X)) = _
          have hsh : φ_sh_inv Polynomial.X = Polynomial.X - Polynomial.C c_inf := by simp [φ_sh_inv]
          rw [hsh, map_sub, map_sub, hγ_u_X, hγ_u_C]
        have h2 : (↑(u_w⁻¹) - ι_tr (Polynomial.C c_inf)) * (u_w : R_tr) = ι_tr q_avoid := by
          rw [sub_mul, Units.inv_mul, hu_w_val, ← map_mul, ← map_one ι_tr, ← map_sub]
        rw [h1, ← h2]
        calc ↑(u_w⁻¹) - ι_tr (Polynomial.C c_inf)
          _ = (↑(u_w⁻¹) - ι_tr (Polynomial.C c_inf)) * ((u_w : R_tr) * ↑(u_w⁻¹)) := by
              rw [Units.mul_inv, mul_one]
          _ = ↑(u_w⁻¹) * ((↑(u_w⁻¹) - ι_tr (Polynomial.C c_inf)) * (u_w : R_tr)) := by ring
      have hUnit_γ_v0 : IsUnit (γ_v0 Polynomial.X) := by
        rw [hγ_v0_X]
        exact IsUnit.mul u_w⁻¹.isUnit hUnit_q_tr
      let γ_v : R_laur →+* R_tr := IsLocalization.Away.lift (S := R_laur) Polynomial.X hUnit_γ_v0
      have hγ_v_j₀ : γ_v.comp j₀_std = γ_v0 := by
        apply RingHom.ext; intro p
        exact IsLocalization.Away.lift_eq (S := R_laur) Polynomial.X hUnit_γ_v0 p
      have hγ_v_sh : (γ_v.comp j₀_std).comp φ_sh = γ_u.comp j₀_std := by
        rw [hγ_v_j₀, RingHom.comp_assoc, hφ_sh_id₂, RingHom.comp_id]
      have hEq_tr_geom :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ρ_av.comp α_av)) ≫ j_aff =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((γ_v.comp φ_ov_hom).comp (algebraMap (Polynomial F) R_Xb))) ≫ j_aff := by
        calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ρ_av.comp α_av)) ≫ j_aff
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_av) ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_av) ≫ j_aff) := by
              rw [hSpecComp, CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_tr) ≫ w_other := by
              rw [hα_geom]
              change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_av) ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R_av)) ≫
                  w_other) = _
              rw [← CategoryTheory.Category.assoc, ← hSpecComp, hρ_av_comp]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_u) ≫ (g₁ ≫ w_other) := by
              rw [← hγ_u_j₁, hSpecComp, CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_u) ≫ (g₀ ≫ w_inf) := by
              rw [hpb_w.w]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (γ_u.comp j₀_std)) ≫ w_inf := by
              rw [← CategoryTheory.Category.assoc, ← hSpecComp]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((γ_v.comp j₀_std).comp φ_sh)) ≫ w_inf := by
              rw [hγ_v_sh]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_v) ≫ ι_v0 := by
              change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((γ_v.comp j₀_std).comp φ_sh)) ≫ w_inf =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_v) ≫
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₀_std) ≫
                    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sh) ≫ w_inf))
              rw [hSpecComp, hSpecComp, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_v) ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_ov_hom) ≫ ι_Xb) := by
              rw [hφ_ov_geom]
          _ = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((γ_v.comp φ_ov_hom).comp (algebraMap (Polynomial F) R_Xb))) ≫ j_aff := by
              change AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_v) ≫
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_ov_hom) ≫
                    (AlgebraicGeometry.Spec.map
                      (CommRingCat.ofHom (algebraMap (Polynomial F) R_Xb)) ≫ j_aff)) = _
              rw [hSpecComp (algebraMap (Polynomial F) R_Xb) (γ_v.comp φ_ov_hom),
                hSpecComp φ_ov_hom γ_v, CategoryTheory.Category.assoc,
                CategoryTheory.Category.assoc]
      have hEq_tr_hom : ρ_av.comp α_av =
          (γ_v.comp φ_ov_hom).comp (algebraMap (Polynomial F) R_Xb) :=
        hSpecHomInj ((cancel_mono j_aff).mp hEq_tr_geom)
      have hEval_Xb : ρ_av (α_av (Polynomial.X - Polynomial.C b)) =
          γ_v (Φ_ov (algebraMap (Polynomial F) R_Xb (Polynomial.X - Polynomial.C b))) := by
        have hc := RingHom.congr_fun hEq_tr_hom (Polynomial.X - Polynomial.C b)
        simp only [RingHom.comp_apply] at hc
        exact hc
      rcases IsLocalization.surj (Submonoid.powers q_avoid) (α_av (Polynomial.X - Polynomial.C b))
        with ⟨⟨P_num, s_av⟩, hsurj_av⟩
      rcases s_av with ⟨_, N_av, rfl⟩
      dsimp only at hsurj_av
      have hsurj_tr : ρ_av (α_av (Polynomial.X - Polynomial.C b)) * ι_tr (q_avoid ^ N_av) = ι_tr P_num := by
        have h1 := congrArg ρ_av hsurj_av
        simp only [map_mul] at h1
        rwa [hCompApp hρ_av_comp (q_avoid ^ N_av), hCompApp hρ_av_comp P_num] at h1
      have hγ_v_CaX : γ_v (j₀_std (Polynomial.C a * Polynomial.X)) =
          ι_tr (Polynomial.C a) * (↑(u_w⁻¹) * ι_tr q_avoid) := by
        rw [hCompApp hγ_v_j₀ (Polynomial.C a * Polynomial.X), map_mul, hγ_v0_X]
        congr 1
        change γ_u (j₀_std (φ_sh_inv (Polynomial.C a))) = ι_tr (Polynomial.C a)
        have hsh_a : φ_sh_inv (Polynomial.C a) = Polynomial.C a := by simp [φ_sh_inv]
        rw [hsh_a, hγ_u_C]
      rw [h_pos, hγ_v_CaX] at hEval_Xb
      have hPoly_tr : ι_tr (Polynomial.X * P_num) =
          ι_tr (Polynomial.C a * (q_avoid * q_avoid ^ N_av)) := by
        rw [map_mul, ← hsurj_tr, hEval_Xb]
        calc ι_tr Polynomial.X * ((ι_tr (Polynomial.C a) * (↑(u_w⁻¹) * ι_tr q_avoid)) * ι_tr (q_avoid ^ N_av))
          _ = ι_tr (Polynomial.C a) * ((u_w : R_tr) * ↑(u_w⁻¹)) * (ι_tr q_avoid * ι_tr (q_avoid ^ N_av)) := by
            rw [hu_w_val]; ring
          _ = ι_tr (Polynomial.C a) * 1 * (ι_tr q_avoid * ι_tr (q_avoid ^ N_av)) := by
            rw [Units.mul_inv]
          _ = ι_tr (Polynomial.C a * (q_avoid * q_avoid ^ N_av)) := by
            simp [map_mul]
      have hPoly_eq : Polynomial.X * P_num = Polynomial.C a * (q_avoid * q_avoid ^ N_av) :=
        hι_tr_inj hPoly_tr
      have hEv0 := congrArg (Polynomial.eval 0) hPoly_eq
      simp only [Polynomial.eval_mul, Polynomial.eval_X, zero_mul, Polynomial.eval_C,
        Polynomial.eval_pow, hq_av_ev0, one_pow, mul_one] at hEv0
      exact ha_ne hEv0.symm
    exact ⟨w'_inf, p₀, b, Φ_ov, hw'_open, hp₀_id, hw'_p₀, hφ_ov_geom, hNoPos⟩

  rcases hStep4 with ⟨w'_inf, p₀, b, Φ_ov, hw'_open, hp₀_id, hw'_p₀, hφ_ov_geom, hNoPos⟩
  let R_Xb := Localization.Away (Polynomial.X - Polynomial.C b : Polynomial F)

  
  have hStep3 : ∃ a : F, a ≠ 0 ∧
      Φ_ov (algebraMap (Polynomial F) R_Xb (Polynomial.X - Polynomial.C b)) =
        j₀_std (Polynomial.C a) * ξ_laur := by
    let sh_b : Polynomial F ≃ₐ[F] Polynomial F :=
      AlgEquiv.ofAlgHom
        (Polynomial.aeval (Polynomial.X - Polynomial.C b : Polynomial F))
        (Polynomial.aeval (Polynomial.X + Polynomial.C b : Polynomial F))
        (by apply Polynomial.algHom_ext; simp)
        (by apply Polynomial.algHom_ext; simp)
    have hUnit_shb_fwd : IsUnit
        (((algebraMap (Polynomial F) R_Xb).comp sh_b.toRingEquiv.toRingHom) Polynomial.X) := by
      change IsUnit (algebraMap (Polynomial F) R_Xb (sh_b Polynomial.X))
      have hsh : sh_b Polynomial.X = Polynomial.X - Polynomial.C b := Polynomial.aeval_X _
      rw [hsh]
      exact IsLocalization.map_units R_Xb
        ⟨Polynomial.X - Polynomial.C b, Submonoid.mem_powers (Polynomial.X - Polynomial.C b)⟩
    have hUnit_shb_bwd : IsUnit
        ((j₀_std.comp sh_b.symm.toRingEquiv.toRingHom) (Polynomial.X - Polynomial.C b)) := by
      change IsUnit (j₀_std (sh_b.symm (Polynomial.X - Polynomial.C b)))
      have hsh : sh_b.symm (Polynomial.X - Polynomial.C b) = Polynomial.X := by
        simp [sh_b]
      rw [hsh]
      exact IsLocalization.map_units R_laur ⟨Polynomial.X, Submonoid.mem_powers Polynomial.X⟩
    let σ_b_fwd : R_laur →+* R_Xb := IsLocalization.Away.lift (S := R_laur) Polynomial.X hUnit_shb_fwd
    let σ_b_bwd : R_Xb →+* R_laur :=
      IsLocalization.Away.lift (S := R_Xb) (Polynomial.X - Polynomial.C b) hUnit_shb_bwd
    have hσ_fwd_comp : σ_b_fwd.comp j₀_std =
        (algebraMap (Polynomial F) R_Xb).comp sh_b.toRingEquiv.toRingHom := by
      apply RingHom.ext; intro p
      exact IsLocalization.Away.lift_eq (S := R_laur) Polynomial.X hUnit_shb_fwd p
    have hσ_bwd_comp : σ_b_bwd.comp (algebraMap (Polynomial F) R_Xb) =
        j₀_std.comp sh_b.symm.toRingEquiv.toRingHom := by
      apply RingHom.ext; intro p
      exact IsLocalization.Away.lift_eq (S := R_Xb) (Polynomial.X - Polynomial.C b) hUnit_shb_bwd p
    have hσ_id₁ : σ_b_bwd.comp σ_b_fwd = RingHom.id R_laur := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial F))
      rw [RingHom.comp_assoc, hσ_fwd_comp, ← RingHom.comp_assoc, hσ_bwd_comp]
      apply RingHom.ext; intro p
      simp only [RingHom.comp_apply, RingHom.id_apply]
      change j₀_std (sh_b.symm (sh_b p)) = j₀_std p
      rw [AlgEquiv.symm_apply_apply]
    have hσ_id₂ : σ_b_fwd.comp σ_b_bwd = RingHom.id R_Xb := by
      apply IsLocalization.ringHom_ext
        (Submonoid.powers (Polynomial.X - Polynomial.C b : Polynomial F))
      rw [RingHom.comp_assoc, hσ_bwd_comp, ← RingHom.comp_assoc, hσ_fwd_comp]
      apply RingHom.ext; intro p
      simp only [RingHom.comp_apply, RingHom.id_apply]
      change algebraMap (Polynomial F) R_Xb (sh_b (sh_b.symm p)) = algebraMap (Polynomial F) R_Xb p
      rw [AlgEquiv.apply_symm_apply]
    have hσ_F : ∀ c : F, σ_b_fwd (algebraMap F R_laur c) = algebraMap F R_Xb c := by
      intro c
      rw [hAlgC R_laur c, hAlgC R_Xb c]
      have hc := hCompApp hσ_fwd_comp (Polynomial.C c)
      simp only [RingHom.comp_apply] at hc
      have hsh_c : sh_b.toRingEquiv.toRingHom (Polynomial.C c) = Polynomial.C c := by
        change sh_b (Polynomial.C c) = Polynomial.C c
        simp [sh_b]
      rw [hsh_c] at hc
      exact hc
    let Sig_b : R_laur ≃ₐ[F] R_Xb :=
      { toFun := σ_b_fwd
        invFun := σ_b_bwd
        left_inv := fun x => RingHom.congr_fun hσ_id₁ x
        right_inv := fun x => RingHom.congr_fun hσ_id₂ x
        map_mul' := map_mul σ_b_fwd
        map_add' := map_add σ_b_fwd
        commutes' := hσ_F }
    let Θ_laur : R_laur ≃ₐ[F] R_laur := Sig_b.trans Φ_ov
    have hΘ_X : Θ_laur (j₀_std Polynomial.X) =
        Φ_ov (algebraMap (Polynomial F) R_Xb (Polynomial.X - Polynomial.C b)) := by
      change Φ_ov (σ_b_fwd (j₀_std Polynomial.X)) = _
      have hc := hCompApp hσ_fwd_comp Polynomial.X
      simp only [RingHom.comp_apply] at hc
      have hsh : sh_b.toRingEquiv.toRingHom Polynomial.X = Polynomial.X - Polynomial.C b :=
        Polynomial.aeval_X _
      rw [hc, hsh]

    have hj₀_inj : Function.Injective j₀_std :=
      IsLocalization.injective R_laur
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero Polynomial.X_ne_zero))
    let u_gen : R_laurˣ :=
      ⟨j₀_std Polynomial.X, ξ_laur, hX_mul_ξ, by rw [mul_comm, hX_mul_ξ]⟩
    let c_U : Fˣ →* R_laurˣ := Units.map (algebraMap F R_laur).toMonoidHom
    have hUnitClass : ∀ z : R_laurˣ, ∃ (u_c : Fˣ) (d : ℤ), z = c_U u_c * u_gen ^ d := by
      intro z
      rcases IsLocalization.surj (Submonoid.powers (Polynomial.X : Polynomial F)) (z : R_laur)
        with ⟨⟨p_u, s_u⟩, hp_u⟩
      rcases s_u with ⟨_, n_u, rfl⟩
      dsimp only at hp_u
      rcases IsLocalization.surj (Submonoid.powers (Polynomial.X : Polynomial F)) (↑(z⁻¹) : R_laur)
        with ⟨⟨q_u, t_u⟩, hq_u⟩
      rcases t_u with ⟨_, m_u, rfl⟩
      dsimp only at hq_u
      have hpq_laur : j₀_std (p_u * q_u) = j₀_std (Polynomial.X ^ (n_u + m_u)) := by
        rw [map_mul]
        have hp_u' : (z : R_laur) * j₀_std (Polynomial.X ^ n_u) = j₀_std p_u := hp_u
        have hq_u' : ↑(z⁻¹) * j₀_std (Polynomial.X ^ m_u) = j₀_std q_u := hq_u
        rw [← hp_u', ← hq_u', pow_add, map_mul]
        calc ((z : R_laur) * j₀_std (Polynomial.X ^ n_u)) * (↑(z⁻¹) * j₀_std (Polynomial.X ^ m_u))
          _ = ((z : R_laur) * ↑(z⁻¹)) * (j₀_std (Polynomial.X ^ n_u) * j₀_std (Polynomial.X ^ m_u)) := by ring
          _ = j₀_std (Polynomial.X ^ n_u) * j₀_std (Polynomial.X ^ m_u) := by rw [Units.mul_inv, one_mul]
      have hp_dvd : p_u ∣ Polynomial.X ^ (n_u + m_u) := ⟨q_u, (hj₀_inj hpq_laur).symm⟩
      rcases (dvd_prime_pow Polynomial.prime_X (n_u + m_u)).mp hp_dvd with ⟨k_u, _, hassoc⟩
      rcases hassoc.symm with ⟨u_poly, hu_poly⟩
      have hu_poly_isUnit : IsUnit (u_poly : Polynomial F) := u_poly.isUnit
      rcases Polynomial.isUnit_iff.mp hu_poly_isUnit with ⟨c_val, hc_unit, hc_eq⟩
      rcases hc_unit with ⟨u_c, rfl⟩
      let d : ℤ := (k_u : ℤ) - (n_u : ℤ)
      refine ⟨u_c, d, ?_⟩
      have hmul_eq : (z * u_gen ^ n_u : R_laurˣ) = (c_U u_c * u_gen ^ d) * u_gen ^ n_u := by
        apply Units.ext
        have hd_add : u_gen ^ d * u_gen ^ n_u = u_gen ^ k_u := by
          rw [← zpow_natCast u_gen n_u, ← zpow_add, sub_add_cancel, zpow_natCast]
        rw [mul_assoc, hd_add]
        change (z : R_laur) * (j₀_std Polynomial.X) ^ n_u =
          algebraMap F R_laur (u_c : F) * (j₀_std Polynomial.X) ^ k_u
        have hp_u' : (z : R_laur) * j₀_std (Polynomial.X ^ n_u) = j₀_std p_u := hp_u
        rw [← map_pow, hp_u', hAlgC R_laur (u_c : F)]
        change j₀_std p_u = j₀_std (Polynomial.C (u_c : F)) * (j₀_std Polynomial.X) ^ k_u
        rw [hc_eq, ← map_pow, ← map_mul, mul_comm (u_poly : Polynomial F) (Polynomial.X ^ k_u), hu_poly]
      exact mul_right_cancel hmul_eq

    let Θ_U : R_laurˣ →* R_laurˣ := Units.map Θ_laur.toRingEquiv.toRingHom.toMonoidHom
    let Θ'_U : R_laurˣ →* R_laurˣ := Units.map Θ_laur.symm.toRingEquiv.toRingHom.toMonoidHom
    obtain ⟨u_a, d_exp, hΘ_gen⟩ := hUnitClass (Θ_U u_gen)
    obtain ⟨u_a', d'_exp, hΘ'_gen⟩ := hUnitClass (Θ'_U u_gen)
    have hΘ_cU : ∀ v : Fˣ, Θ_U (c_U v) = c_U v := by
      intro v
      apply Units.ext
      exact Θ_laur.commutes (v : F)
    have hGen_id : u_gen = c_U (u_a' * u_a ^ d'_exp) * u_gen ^ (d_exp * d'_exp) := by
      have h1 : Θ_U (Θ'_U u_gen) = u_gen := by
        apply Units.ext
        exact Θ_laur.apply_symm_apply (u_gen : R_laur)
      rw [hΘ'_gen, map_mul, hΘ_cU, map_zpow, hΘ_gen, mul_zpow, ← zpow_mul, ← c_U.map_zpow,
        ← mul_assoc, ← c_U.map_mul] at h1
      exact h1.symm
    have hd_mul : d_exp * d'_exp = 1 := by
      let M_abs : ℕ := (d_exp * d'_exp).natAbs
      have hnonneg : 0 ≤ d_exp * d'_exp + (M_abs : ℤ) := by
        have hle := neg_le_abs (d_exp * d'_exp)
        have habs : |(d_exp * d'_exp)| = (M_abs : ℤ) := (Int.natCast_natAbs (d_exp * d'_exp)).symm
        linarith
      let K_nat : ℕ := (d_exp * d'_exp + (M_abs : ℤ)).toNat
      have hK_eq : (K_nat : ℤ) = d_exp * d'_exp + (M_abs : ℤ) := Int.toNat_of_nonneg hnonneg
      have hPow_eq : u_gen ^ (1 + M_abs) = c_U (u_a' * u_a ^ d'_exp) * u_gen ^ K_nat := by
        have hmul := congrArg (· * u_gen ^ M_abs) hGen_id
        have hL : u_gen * u_gen ^ M_abs = u_gen ^ (1 + M_abs) := by
          rw [pow_add, pow_one]
        have hR : (c_U (u_a' * u_a ^ d'_exp) * u_gen ^ (d_exp * d'_exp)) * u_gen ^ M_abs =
            c_U (u_a' * u_a ^ d'_exp) * u_gen ^ K_nat := by
          rw [mul_assoc, ← zpow_natCast u_gen M_abs, ← zpow_add, ← hK_eq, zpow_natCast]
        rwa [hL, hR] at hmul
      have hVal_eq : j₀_std (Polynomial.X ^ (1 + M_abs)) =
          j₀_std (Polynomial.C ((u_a' * u_a ^ d'_exp : Fˣ) : F) * Polynomial.X ^ K_nat) := by
        have hv := congrArg (fun x : R_laurˣ => (x : R_laur)) hPow_eq
        change (j₀_std Polynomial.X) ^ (1 + M_abs) =
          algebraMap F R_laur ((u_a' * u_a ^ d'_exp : Fˣ) : F) * (j₀_std Polynomial.X) ^ K_nat at hv
        rw [← map_pow, hAlgC R_laur ((u_a' * u_a ^ d'_exp : Fˣ) : F)] at hv
        simpa only [map_mul, map_pow] using hv
      have hPoly_deg := congrArg Polynomial.natDegree (hj₀_inj hVal_eq)
      rw [Polynomial.natDegree_X_pow,
        Polynomial.natDegree_C_mul_X_pow K_nat _ (Units.ne_zero _)] at hPoly_deg
      have hZ : ((1 + M_abs : ℕ) : ℤ) = (K_nat : ℤ) := congrArg Nat.cast hPoly_deg
      rw [Nat.cast_add, Nat.cast_one, hK_eq] at hZ
      linarith
    let a : F := (u_a : F)
    have ha_ne : a ≠ 0 := u_a.ne_zero
    have hd_neg_one : d_exp = -1 := by
      rcases Int.mul_eq_one_iff_eq_one_or_neg_one.mp hd_mul with ⟨rfl, _⟩ | ⟨rfl, _⟩
      · exfalso
        apply hNoPos a ha_ne
        rw [← hΘ_X]
        have hv := congrArg (fun x : R_laurˣ => (x : R_laur)) hΘ_gen
        change Θ_laur (j₀_std Polynomial.X) = algebraMap F R_laur a * (u_gen ^ (1 : ℤ) : R_laurˣ) at hv
        rw [zpow_one, hAlgC R_laur a] at hv
        exact hv.trans (map_mul j₀_std (Polynomial.C a) Polynomial.X).symm
      · rfl
    refine ⟨a, ha_ne, ?_⟩
    rw [← hΘ_X]
    have hv := congrArg (fun x : R_laurˣ => (x : R_laur)) hΘ_gen
    rw [hd_neg_one] at hv
    change Θ_laur (j₀_std Polynomial.X) = algebraMap F R_laur a * (u_gen ^ (-1 : ℤ) : R_laurˣ) at hv
    rw [zpow_neg_one, hAlgC R_laur a] at hv
    exact hv

  rcases hStep3 with ⟨a, ha_ne, hΦ_inv⟩

  
  let r_inf : Polynomial F :=
    (1 - Polynomial.C b * Polynomial.X) * ∏ s ∈ S_aff, (1 - Polynomial.C s * Polynomial.X)
  let h_inf : R₀ := algebraMap (Polynomial F) R₀ (Polynomial.X * (Polynomial.X - Polynomial.C b))
  have hr_inf_ev0 : Polynomial.eval 0 r_inf ≠ 0 := by
    have hev : Polynomial.evalRingHom (0 : F) r_inf = 1 := by
      dsimp only [r_inf]
      rw [map_mul, map_prod]
      simp
    change Polynomial.eval 0 r_inf = 1 at hev
    rw [hev]
    exact one_ne_zero
  let P_S : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)
  have hPS_ne : P_S ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun s _ => Polynomial.X_sub_C_ne_zero s
  have hR₀_inj : Function.Injective (algebraMap (Polynomial F) R₀) :=
    IsLocalization.injective R₀ (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hPS_ne))
  have hh_inf_ne : h_inf ≠ 0 := by
    intro h0
    rw [← map_zero (algebraMap (Polynomial F) R₀)] at h0
    exact mul_ne_zero Polynomial.X_ne_zero (Polynomial.X_sub_C_ne_zero b) (hR₀_inj h0)

  let R_inf₀ := Localization.Away r_inf
  let t_inf₀ : R_inf₀ := algebraMap (Polynomial F) R_inf₀ Polynomial.X
  let R_inf_U := Localization.Away t_inf₀
  let j_inf_U : R_inf₀ →+* R_inf_U := algebraMap R_inf₀ R_inf_U

  have hr_notin_p₀ : r_inf ∉ p₀.asIdeal := by
    rw [hp₀_id, Ideal.mem_span_singleton]
    rintro ⟨g_r, hg_r⟩
    apply hr_inf_ev0
    rw [hg_r, Polynomial.eval_mul, Polynomial.eval_X, zero_mul]
  rcases (hLocAwayMem R_inf₀ r_inf p₀).mp hr_notin_p₀ with ⟨p_inf_raw, hp_inf_eq⟩
  let p_inf : AlgebraicGeometry.Spec (CommRingCat.of R_inf₀) := p_inf_raw
  have hp_inf_comap : Ideal.comap (algebraMap (Polynomial F) R_inf₀) p_inf.asIdeal =
      Ideal.span {Polynomial.X} := by
    change (PrimeSpectrum.comap (algebraMap (Polynomial F) R_inf₀) p_inf_raw).asIdeal = _
    rw [hp_inf_eq, hp₀_id]
  have hp_inf_uniq : ∀ q : AlgebraicGeometry.Spec (CommRingCat.of R_inf₀),
      Ideal.comap (algebraMap (Polynomial F) R_inf₀) q.asIdeal = Ideal.span {Polynomial.X} →
      q = p_inf := by
    intro q hq
    apply PrimeSpectrum.localization_comap_injective R_inf₀ (Submonoid.powers r_inf)
    apply PrimeSpectrum.ext
    change Ideal.comap (algebraMap (Polynomial F) R_inf₀) q.asIdeal = _
    rw [hq, ← hp_inf_comap]
    rfl

  have hUnit_rinf : IsUnit (algebraMap (Polynomial F) R_inf₀ r_inf) :=
    IsLocalization.map_units R_inf₀ ⟨r_inf, Submonoid.mem_powers r_inf⟩
  have hw₀_unit : IsUnit (algebraMap (Polynomial F) R_inf₀ (1 - Polynomial.C b * Polynomial.X)) :=
    hUnitOfDvd (algebraMap (Polynomial F) R_inf₀) hUnit_rinf ⟨_, rfl⟩
  have hws_unit : ∀ s ∈ S_aff,
      IsUnit (algebraMap (Polynomial F) R_inf₀ (1 - Polynomial.C s * Polynomial.X)) := by
    intro s hs
    exact hUnitOfDvd (algebraMap (Polynomial F) R_inf₀) hUnit_rinf
      (dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem _ hs) _)
  let u_w₀ : R_inf₀ˣ := hw₀_unit.unit
  have hu_w₀_val : (u_w₀ : R_inf₀) =
      algebraMap (Polynomial F) R_inf₀ (1 - Polynomial.C b * Polynomial.X) := rfl
  have hUnit_Ca_inf₀ : IsUnit (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a)) := by
    rw [← hAlgC R_inf₀ a]
    exact (IsUnit.mk0 a ha_ne).map (algebraMap F R_inf₀)

  let η₀ : Polynomial F →+* R_inf₀ :=
    (Polynomial.aeval
      (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a * Polynomial.X) * ↑(u_w₀⁻¹))).toRingHom
  have hη₀_C : ∀ d : F, η₀ (Polynomial.C d) = algebraMap (Polynomial F) R_inf₀ (Polynomial.C d) := by
    intro d
    exact (hAevalC _ d).trans (hAlgC R_inf₀ d)
  have hη₀_open : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom η₀)) := by
    let q_v : Polynomial F :=
      (Polynomial.C a + Polynomial.C b * Polynomial.X) *
        ∏ s ∈ S_aff, (Polynomial.C a + Polynomial.C (b - s) * Polynomial.X)
    let R_v0 := Localization.Away q_v
    have hη₀_lin : ∀ c : F, η₀ (Polynomial.C a + Polynomial.C c * Polynomial.X) =
        algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) *
          algebraMap (Polynomial F) R_inf₀ (1 - Polynomial.C (b - c) * Polynomial.X) * ↑(u_w₀⁻¹) := by
      intro c
      have hX : η₀ Polynomial.X =
          algebraMap (Polynomial F) R_inf₀ (Polynomial.C a * Polynomial.X) * ↑(u_w₀⁻¹) :=
        Polynomial.aeval_X _
      rw [map_add, map_mul, hη₀_C, hη₀_C, hX]
      have hpoly : Polynomial.C a * (1 - Polynomial.C b * Polynomial.X) +
          Polynomial.C c * (Polynomial.C a * Polynomial.X) =
          Polynomial.C a * (1 - Polynomial.C (b - c) * Polynomial.X) := by
        rw [map_sub]
        ring
      calc algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) +
            algebraMap (Polynomial F) R_inf₀ (Polynomial.C c) *
              (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a * Polynomial.X) * ↑(u_w₀⁻¹))
        _ = (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) * ((u_w₀ : R_inf₀) * ↑(u_w₀⁻¹))) +
            (algebraMap (Polynomial F) R_inf₀ (Polynomial.C c) *
              algebraMap (Polynomial F) R_inf₀ (Polynomial.C a * Polynomial.X)) * ↑(u_w₀⁻¹) := by
            rw [Units.mul_inv, mul_one, mul_assoc]
        _ = (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) * (u_w₀ : R_inf₀) +
              algebraMap (Polynomial F) R_inf₀ (Polynomial.C c) *
                algebraMap (Polynomial F) R_inf₀ (Polynomial.C a * Polynomial.X)) * ↑(u_w₀⁻¹) := by
            ring
        _ = algebraMap (Polynomial F) R_inf₀
              (Polynomial.C a * (1 - Polynomial.C b * Polynomial.X) +
                Polynomial.C c * (Polynomial.C a * Polynomial.X)) * ↑(u_w₀⁻¹) := by
            rw [hu_w₀_val, ← map_mul, ← map_mul, ← map_add]
        _ = algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) *
              algebraMap (Polynomial F) R_inf₀ (1 - Polynomial.C (b - c) * Polynomial.X) * ↑(u_w₀⁻¹) := by
            rw [hpoly, map_mul]
    have hη₀_b : η₀ (Polynomial.C a + Polynomial.C b * Polynomial.X) =
        algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) * ↑(u_w₀⁻¹) := by
      rw [hη₀_lin b, sub_self, map_zero, zero_mul, sub_zero, map_one, mul_one]
    have hUnit_η₀_qv : IsUnit (η₀ q_v) := by
      dsimp [q_v]
      rw [map_mul, map_prod]
      refine IsUnit.mul ?_ ?_
      · rw [hη₀_b]
        exact IsUnit.mul hUnit_Ca_inf₀ u_w₀⁻¹.isUnit
      · refine Finset.prod_induction _ IsUnit (fun _ _ => IsUnit.mul) isUnit_one ?_
        intro s hs
        rw [hη₀_lin (b - s), sub_sub_cancel]
        exact IsUnit.mul (IsUnit.mul hUnit_Ca_inf₀ (hws_unit s hs)) u_w₀⁻¹.isUnit
    let η_hom : R_v0 →+* R_inf₀ := IsLocalization.Away.lift (S := R_v0) q_v hUnit_η₀_qv
    have hη_comp : η_hom.comp (algebraMap (Polynomial F) R_v0) = η₀ := by
      apply RingHom.ext; intro p
      exact IsLocalization.Away.lift_eq (S := R_v0) q_v hUnit_η₀_qv p

    have hUnit_qv : IsUnit (algebraMap (Polynomial F) R_v0 q_v) :=
      IsLocalization.map_units R_v0 ⟨q_v, Submonoid.mem_powers q_v⟩
    have hv₀_unit : IsUnit
        (algebraMap (Polynomial F) R_v0 (Polynomial.C a + Polynomial.C b * Polynomial.X)) :=
      hUnitOfDvd (algebraMap (Polynomial F) R_v0) hUnit_qv ⟨_, rfl⟩
    have hvs_unit : ∀ s ∈ S_aff, IsUnit
        (algebraMap (Polynomial F) R_v0 (Polynomial.C a + Polynomial.C (b - s) * Polynomial.X)) := by
      intro s hs
      exact hUnitOfDvd (algebraMap (Polynomial F) R_v0) hUnit_qv
        (dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem _ hs) _)
    let u_v₀ : R_v0ˣ := hv₀_unit.unit
    have hu_v₀_val : (u_v₀ : R_v0) =
        algebraMap (Polynomial F) R_v0 (Polynomial.C a + Polynomial.C b * Polynomial.X) := rfl
    have hUnit_Ca_v0 : IsUnit (algebraMap (Polynomial F) R_v0 (Polynomial.C a)) := by
      rw [← hAlgC R_v0 a]
      exact (IsUnit.mk0 a ha_ne).map (algebraMap F R_v0)
    let ξ₀ : Polynomial F →+* R_v0 :=
      (Polynomial.aeval (algebraMap (Polynomial F) R_v0 Polynomial.X * ↑(u_v₀⁻¹))).toRingHom
    have hξ₀_C : ∀ d : F, ξ₀ (Polynomial.C d) = algebraMap (Polynomial F) R_v0 (Polynomial.C d) := by
      intro d
      exact (hAevalC _ d).trans (hAlgC R_v0 d)
    have hξ₀_lin : ∀ c : F, ξ₀ (1 - Polynomial.C c * Polynomial.X) =
        algebraMap (Polynomial F) R_v0 (Polynomial.C a + Polynomial.C (b - c) * Polynomial.X) *
          ↑(u_v₀⁻¹) := by
      intro c
      have hX : ξ₀ Polynomial.X = algebraMap (Polynomial F) R_v0 Polynomial.X * ↑(u_v₀⁻¹) :=
        Polynomial.aeval_X _
      rw [map_sub, map_one, map_mul, hξ₀_C, hX]
      have hpoly : (Polynomial.C a + Polynomial.C b * Polynomial.X) -
          Polynomial.C c * Polynomial.X =
          Polynomial.C a + Polynomial.C (b - c) * Polynomial.X := by
        rw [map_sub]
        ring
      calc (1 : R_v0) - algebraMap (Polynomial F) R_v0 (Polynomial.C c) *
              (algebraMap (Polynomial F) R_v0 Polynomial.X * ↑(u_v₀⁻¹))
        _ = (u_v₀ : R_v0) * ↑(u_v₀⁻¹) -
            (algebraMap (Polynomial F) R_v0 (Polynomial.C c) *
              algebraMap (Polynomial F) R_v0 Polynomial.X) * ↑(u_v₀⁻¹) := by
            rw [Units.mul_inv, mul_assoc]
        _ = ((u_v₀ : R_v0) - algebraMap (Polynomial F) R_v0 (Polynomial.C c) *
              algebraMap (Polynomial F) R_v0 Polynomial.X) * ↑(u_v₀⁻¹) := by ring
        _ = algebraMap (Polynomial F) R_v0
              ((Polynomial.C a + Polynomial.C b * Polynomial.X) -
                Polynomial.C c * Polynomial.X) * ↑(u_v₀⁻¹) := by
            rw [hu_v₀_val, ← map_mul, ← map_sub]
        _ = algebraMap (Polynomial F) R_v0 (Polynomial.C a + Polynomial.C (b - c) * Polynomial.X) *
              ↑(u_v₀⁻¹) := by rw [hpoly]
    have hξ₀_b : ξ₀ (1 - Polynomial.C b * Polynomial.X) =
        algebraMap (Polynomial F) R_v0 (Polynomial.C a) * ↑(u_v₀⁻¹) := by
      rw [hξ₀_lin b, sub_self, map_zero, zero_mul, add_zero]
    have hUnit_ξ₀_rinf : IsUnit (ξ₀ r_inf) := by
      dsimp [r_inf]
      rw [map_mul, map_prod]
      refine IsUnit.mul ?_ ?_
      · rw [hξ₀_b]
        exact IsUnit.mul hUnit_Ca_v0 u_v₀⁻¹.isUnit
      · refine Finset.prod_induction _ IsUnit (fun _ _ => IsUnit.mul) isUnit_one ?_
        intro s hs
        rw [hξ₀_lin s]
        exact IsUnit.mul (hvs_unit s hs) u_v₀⁻¹.isUnit
    let ξ_hom : R_inf₀ →+* R_v0 := IsLocalization.Away.lift (S := R_inf₀) r_inf hUnit_ξ₀_rinf
    have hξ_comp : ξ_hom.comp (algebraMap (Polynomial F) R_inf₀) = ξ₀ := by
      apply RingHom.ext; intro p
      exact IsLocalization.Away.lift_eq (S := R_inf₀) r_inf hUnit_ξ₀_rinf p

    have hη_uv₀_inv : η_hom ↑(u_v₀⁻¹) =
        algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹) * (u_w₀ : R_inf₀) := by
      have h1 : η_hom ((u_v₀ : R_v0) * ↑(u_v₀⁻¹)) = η_hom 1 := congrArg η_hom (Units.mul_inv u_v₀)
      rw [map_mul, map_one] at h1
      have h2 : η_hom (u_v₀ : R_v0) = algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) * ↑(u_w₀⁻¹) := by
        rw [hu_v₀_val]
        exact (hCompApp hη_comp _).trans hη₀_b
      rw [h2] at h1
      have hCancel : (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹) * (u_w₀ : R_inf₀)) *
          (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) * ↑(u_w₀⁻¹)) = 1 := by
        have ha_inv : Polynomial.C a⁻¹ * Polynomial.C a = (1 : Polynomial F) := by
          rw [← Polynomial.C_mul, inv_mul_cancel₀ ha_ne, Polynomial.C_1]
        calc (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹) * (u_w₀ : R_inf₀)) *
              (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) * ↑(u_w₀⁻¹))
          _ = (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹) *
                algebraMap (Polynomial F) R_inf₀ (Polynomial.C a)) *
                ((u_w₀ : R_inf₀) * ↑(u_w₀⁻¹)) := by ring
          _ = 1 := by rw [← map_mul, ha_inv, map_one, Units.mul_inv, mul_one]
      calc η_hom ↑(u_v₀⁻¹)
        _ = ((algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹) * (u_w₀ : R_inf₀)) *
              (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) * ↑(u_w₀⁻¹))) * η_hom ↑(u_v₀⁻¹) := by
            rw [hCancel, one_mul]
        _ = (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹) * (u_w₀ : R_inf₀)) *
              ((algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) * ↑(u_w₀⁻¹)) * η_hom ↑(u_v₀⁻¹)) := by
            rw [mul_assoc]
        _ = algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹) * (u_w₀ : R_inf₀) := by
            rw [h1, mul_one]
    have hξ_uw₀_inv : ξ_hom ↑(u_w₀⁻¹) =
        algebraMap (Polynomial F) R_v0 (Polynomial.C a⁻¹) * (u_v₀ : R_v0) := by
      have h1 : ξ_hom ((u_w₀ : R_inf₀) * ↑(u_w₀⁻¹)) = ξ_hom 1 := congrArg ξ_hom (Units.mul_inv u_w₀)
      rw [map_mul, map_one] at h1
      have h2 : ξ_hom (u_w₀ : R_inf₀) = algebraMap (Polynomial F) R_v0 (Polynomial.C a) * ↑(u_v₀⁻¹) := by
        rw [hu_w₀_val]
        exact (hCompApp hξ_comp _).trans hξ₀_b
      rw [h2] at h1
      have hCancel : (algebraMap (Polynomial F) R_v0 (Polynomial.C a⁻¹) * (u_v₀ : R_v0)) *
          (algebraMap (Polynomial F) R_v0 (Polynomial.C a) * ↑(u_v₀⁻¹)) = 1 := by
        have ha_inv : Polynomial.C a⁻¹ * Polynomial.C a = (1 : Polynomial F) := by
          rw [← Polynomial.C_mul, inv_mul_cancel₀ ha_ne, Polynomial.C_1]
        calc (algebraMap (Polynomial F) R_v0 (Polynomial.C a⁻¹) * (u_v₀ : R_v0)) *
              (algebraMap (Polynomial F) R_v0 (Polynomial.C a) * ↑(u_v₀⁻¹))
          _ = (algebraMap (Polynomial F) R_v0 (Polynomial.C a⁻¹) *
                algebraMap (Polynomial F) R_v0 (Polynomial.C a)) *
                ((u_v₀ : R_v0) * ↑(u_v₀⁻¹)) := by ring
          _ = 1 := by rw [← map_mul, ha_inv, map_one, Units.mul_inv, mul_one]
      calc ξ_hom ↑(u_w₀⁻¹)
        _ = ((algebraMap (Polynomial F) R_v0 (Polynomial.C a⁻¹) * (u_v₀ : R_v0)) *
              (algebraMap (Polynomial F) R_v0 (Polynomial.C a) * ↑(u_v₀⁻¹))) * ξ_hom ↑(u_w₀⁻¹) := by
            rw [hCancel, one_mul]
        _ = (algebraMap (Polynomial F) R_v0 (Polynomial.C a⁻¹) * (u_v₀ : R_v0)) *
              ((algebraMap (Polynomial F) R_v0 (Polynomial.C a) * ↑(u_v₀⁻¹)) * ξ_hom ↑(u_w₀⁻¹)) := by
            rw [mul_assoc]
        _ = algebraMap (Polynomial F) R_v0 (Polynomial.C a⁻¹) * (u_v₀ : R_v0) := by
            rw [h1, mul_one]
    have hηξ_id : η_hom.comp ξ_hom = RingHom.id R_inf₀ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers r_inf)
      rw [RingHom.comp_assoc, hξ_comp, RingHom.id_comp]
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext; intro c
        simp only [RingHom.comp_apply]
        rw [hξ₀_C c, hCompApp hη_comp (Polynomial.C c), hη₀_C c]
      · simp only [RingHom.comp_apply]
        have hX1 : ξ₀ Polynomial.X = algebraMap (Polynomial F) R_v0 Polynomial.X * ↑(u_v₀⁻¹) :=
          Polynomial.aeval_X _
        have hX2 : η_hom (algebraMap (Polynomial F) R_v0 Polynomial.X) =
            algebraMap (Polynomial F) R_inf₀ (Polynomial.C a * Polynomial.X) * ↑(u_w₀⁻¹) :=
          (hCompApp hη_comp Polynomial.X).trans (Polynomial.aeval_X _)
        rw [hX1, map_mul, hX2, hη_uv₀_inv, map_mul]
        have ha_inv : Polynomial.C a * Polynomial.C a⁻¹ = (1 : Polynomial F) := by
          rw [← Polynomial.C_mul, mul_inv_cancel₀ ha_ne, Polynomial.C_1]
        calc (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) *
                algebraMap (Polynomial F) R_inf₀ Polynomial.X * ↑(u_w₀⁻¹)) *
              (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹) * (u_w₀ : R_inf₀))
          _ = (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) *
                algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹)) *
              (↑(u_w₀⁻¹) * (u_w₀ : R_inf₀)) * algebraMap (Polynomial F) R_inf₀ Polynomial.X := by ring
          _ = algebraMap (Polynomial F) R_inf₀ Polynomial.X := by
            rw [← map_mul, ha_inv, map_one, Units.inv_mul, mul_one, one_mul]
    have hξη_id : ξ_hom.comp η_hom = RingHom.id R_v0 := by
      apply IsLocalization.ringHom_ext (Submonoid.powers q_v)
      rw [RingHom.comp_assoc, hη_comp, RingHom.id_comp]
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext; intro c
        simp only [RingHom.comp_apply]
        rw [hη₀_C c, hCompApp hξ_comp (Polynomial.C c), hξ₀_C c]
      · simp only [RingHom.comp_apply]
        have hX1 : η₀ Polynomial.X =
            algebraMap (Polynomial F) R_inf₀ (Polynomial.C a * Polynomial.X) * ↑(u_w₀⁻¹) :=
          Polynomial.aeval_X _
        have hX2 : ξ_hom (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a * Polynomial.X)) =
            algebraMap (Polynomial F) R_v0 (Polynomial.C a) *
              (algebraMap (Polynomial F) R_v0 Polynomial.X * ↑(u_v₀⁻¹)) := by
          rw [hCompApp hξ_comp (Polynomial.C a * Polynomial.X), map_mul, hξ₀_C a]
          congr 1
          exact Polynomial.aeval_X _
        rw [hX1, map_mul, hX2, hξ_uw₀_inv]
        have ha_inv : Polynomial.C a * Polynomial.C a⁻¹ = (1 : Polynomial F) := by
          rw [← Polynomial.C_mul, mul_inv_cancel₀ ha_ne, Polynomial.C_1]
        calc (algebraMap (Polynomial F) R_v0 (Polynomial.C a) *
                (algebraMap (Polynomial F) R_v0 Polynomial.X * ↑(u_v₀⁻¹))) *
              (algebraMap (Polynomial F) R_v0 (Polynomial.C a⁻¹) * (u_v₀ : R_v0))
          _ = (algebraMap (Polynomial F) R_v0 (Polynomial.C a) *
                algebraMap (Polynomial F) R_v0 (Polynomial.C a⁻¹)) *
              (↑(u_v₀⁻¹) * (u_v₀ : R_v0)) * algebraMap (Polynomial F) R_v0 Polynomial.X := by ring
          _ = algebraMap (Polynomial F) R_v0 Polynomial.X := by
            rw [← map_mul, ha_inv, map_one, Units.inv_mul, mul_one, one_mul]
    let e_v_inf : CategoryTheory.Iso
        (AlgebraicGeometry.Spec (CommRingCat.of R_inf₀))
        (AlgebraicGeometry.Spec (CommRingCat.of R_v0)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom η_hom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ξ_hom)
        hom_inv_id := by rw [← hSpecComp, hηξ_id, hSpecId]
        inv_hom_id := by rw [← hSpecComp, hξη_id, hSpecId] }
    rw [← hη_comp, hSpecComp]
    exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion)
      e_v_inf.hom (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R_v0)))
      (@AlgebraicGeometry.IsOpenImmersion.of_isIso _ _ e_v_inf.hom e_v_inf.isIso_hom)
      (AlgebraicGeometry.IsOpenImmersion.of_isLocalization (S := R_v0) q_v)

  let ι_inf : AlgebraicGeometry.Spec (CommRingCat.of R_inf₀) ⟶ D₀.left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom η₀) ≫ w'_inf
  have hι_inf_open : AlgebraicGeometry.IsOpenImmersion ι_inf :=
    CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom η₀)) w'_inf hη₀_open hw'_open
  have hι_inf_pt : ι_inf.base p_inf = s_inf.base default := by
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom η₀) ≫ w'_inf).base p_inf = _
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
    have h_eq_p₀ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom η₀)).base p_inf = p₀ := by
      apply PrimeSpectrum.ext
      rw [hp₀_id]
      apply hEqSpanX _ ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom η₀)).base p_inf).isPrime
      rw [hSpecIdeal η₀ p_inf, Ideal.mem_comap]
      have hX : η₀ Polynomial.X =
          t_inf₀ * (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) * ↑(u_w₀⁻¹)) := by
        change Polynomial.aeval _ Polynomial.X = _
        rw [Polynomial.aeval_X, map_mul]
        ring
      rw [hX]
      apply p_inf.asIdeal.mul_mem_right
      have h_in : Polynomial.X ∈ Ideal.comap (algebraMap (Polynomial F) R_inf₀) p_inf.asIdeal := by
        rw [hp_inf_comap]
        exact Ideal.mem_span_singleton_self Polynomial.X
      exact h_in
    rw [h_eq_p₀, hw'_p₀]

  
  let τ_inv : R_inf_U := IsLocalization.Away.invSelf (S := R_inf_U) t_inf₀
  have ht_mul_τ : j_inf_U t_inf₀ * τ_inv = 1 :=
    IsLocalization.Away.mul_invSelf (S := R_inf_U) t_inf₀
  have hUnit_τ_inv : IsUnit τ_inv :=
    ⟨⟨τ_inv, j_inf_U t_inf₀, by rw [mul_comm, ht_mul_τ], ht_mul_τ⟩, rfl⟩
  let φ₀_U : Polynomial F →+* R_inf_U := (Polynomial.aeval τ_inv).toRingHom
  have hφ₀_C : ∀ c : F, φ₀_U (Polynomial.C c) =
      j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C c)) := by
    intro c
    rw [hAevalC τ_inv c, ← hAlgC R_inf₀ c]
    exact IsScalarTower.algebraMap_apply F R_inf₀ R_inf_U c
  have hφ₀_sub : ∀ c : F, φ₀_U (Polynomial.X - Polynomial.C c) =
      τ_inv * j_inf_U (algebraMap (Polynomial F) R_inf₀ (1 - Polynomial.C c * Polynomial.X)) := by
    intro c
    have hX : φ₀_U Polynomial.X = τ_inv := Polynomial.aeval_X τ_inv
    rw [map_sub, hX, hφ₀_C c, map_sub (algebraMap (Polynomial F) R_inf₀),
      map_one (algebraMap (Polynomial F) R_inf₀), map_mul (algebraMap (Polynomial F) R_inf₀),
      map_sub j_inf_U, map_one j_inf_U, map_mul j_inf_U, mul_sub, mul_one]
    congr 1
    change j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C c)) =
      τ_inv * (j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C c)) * j_inf_U t_inf₀)
    calc j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C c))
      _ = j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C c)) * (j_inf_U t_inf₀ * τ_inv) := by
          rw [ht_mul_τ, mul_one]
      _ = τ_inv * (j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C c)) * j_inf_U t_inf₀) := by ring
  have hUnit_φ₀_b : IsUnit (φ₀_U (Polynomial.X - Polynomial.C b)) := by
    rw [hφ₀_sub b]
    exact IsUnit.mul hUnit_τ_inv (hw₀_unit.map j_inf_U)
  have hUnit_φ₀_PS : IsUnit (φ₀_U P_S) := by
    dsimp [P_S]
    rw [map_prod]
    refine Finset.prod_induction _ IsUnit (fun _ _ => IsUnit.mul) isUnit_one ?_
    intro s hs
    rw [hφ₀_sub s]
    exact IsUnit.mul hUnit_τ_inv ((hws_unit s hs).map j_inf_U)
  let ψ_inf : R₀ →+* R_inf_U := IsLocalization.Away.lift (S := R₀) P_S hUnit_φ₀_PS
  let φ_Xb : R_Xb →+* R_inf_U := IsLocalization.Away.lift (S := R_Xb) (Polynomial.X - Polynomial.C b) hUnit_φ₀_b
  have hψ_inf_comp : ψ_inf.comp (algebraMap (Polynomial F) R₀) = φ₀_U := by
    apply RingHom.ext; intro p
    exact IsLocalization.Away.lift_eq (S := R₀) P_S hUnit_φ₀_PS p
  have hφ_Xb_comp : φ_Xb.comp (algebraMap (Polynomial F) R_Xb) = φ₀_U := by
    apply RingHom.ext; intro p
    exact IsLocalization.Away.lift_eq (S := R_Xb) (Polynomial.X - Polynomial.C b) hUnit_φ₀_b p

  have hUnit_jη₀_X : IsUnit ((j_inf_U.comp η₀) Polynomial.X) := by
    change IsUnit (j_inf_U (η₀ Polynomial.X))
    have hX : η₀ Polynomial.X =
        algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) * t_inf₀ * ↑(u_w₀⁻¹) := by
      change Polynomial.aeval _ Polynomial.X = _
      rw [Polynomial.aeval_X, map_mul]
    rw [hX, map_mul, map_mul]
    exact IsUnit.mul
      (IsUnit.mul (hUnit_Ca_inf₀.map j_inf_U)
        (IsLocalization.map_units R_inf_U ⟨t_inf₀, Submonoid.mem_powers t_inf₀⟩))
      (u_w₀⁻¹.isUnit.map j_inf_U)
  let η_laur : R_laur →+* R_inf_U := IsLocalization.Away.lift (S := R_laur) Polynomial.X hUnit_jη₀_X
  have hη_laur_comp : η_laur.comp j₀_std = j_inf_U.comp η₀ := by
    apply RingHom.ext; intro p
    exact IsLocalization.Away.lift_eq (S := R_laur) Polynomial.X hUnit_jη₀_X p
  have hη_laur_ξ : η_laur ξ_laur =
      j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹)) * τ_inv *
        j_inf_U (u_w₀ : R_inf₀) := by
    have h1 : η_laur (j₀_std Polynomial.X * ξ_laur) = η_laur 1 := congrArg η_laur hX_mul_ξ
    rw [map_mul, map_one] at h1
    have h2 : η_laur (j₀_std Polynomial.X) =
        j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a)) * j_inf_U t_inf₀ *
          j_inf_U ↑(u_w₀⁻¹) := by
      have hc : η_laur (j₀_std Polynomial.X) = j_inf_U (η₀ Polynomial.X) :=
        hCompApp hη_laur_comp Polynomial.X
      rw [hc]
      have hX : η₀ Polynomial.X =
          algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) * t_inf₀ * ↑(u_w₀⁻¹) := by
        change Polynomial.aeval _ Polynomial.X = _
        rw [Polynomial.aeval_X, map_mul]
      rw [hX, map_mul, map_mul]
    rw [h2] at h1
    have hCancel : (j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹)) * τ_inv *
        j_inf_U (u_w₀ : R_inf₀)) *
        (j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a)) * j_inf_U t_inf₀ *
          j_inf_U ↑(u_w₀⁻¹)) = 1 := by
      have ha_inv : Polynomial.C a⁻¹ * Polynomial.C a = (1 : Polynomial F) := by
        rw [← Polynomial.C_mul, inv_mul_cancel₀ ha_ne, Polynomial.C_1]
      have hu_inv : j_inf_U (u_w₀ : R_inf₀) * j_inf_U ↑(u_w₀⁻¹) = 1 := by
        rw [← map_mul, Units.mul_inv, map_one]
      calc (j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹)) * τ_inv *
              j_inf_U (u_w₀ : R_inf₀)) *
            (j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a)) * j_inf_U t_inf₀ *
              j_inf_U ↑(u_w₀⁻¹))
        _ = j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹) *
              algebraMap (Polynomial F) R_inf₀ (Polynomial.C a)) *
            (j_inf_U t_inf₀ * τ_inv) *
            (j_inf_U (u_w₀ : R_inf₀) * j_inf_U ↑(u_w₀⁻¹)) := by
            rw [map_mul]; ring
        _ = 1 := by rw [← map_mul, ha_inv, map_one, map_one, ht_mul_τ, hu_inv, mul_one, mul_one]
    calc η_laur ξ_laur
      _ = ((j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹)) * τ_inv *
              j_inf_U (u_w₀ : R_inf₀)) *
            (j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a)) * j_inf_U t_inf₀ *
              j_inf_U ↑(u_w₀⁻¹))) * η_laur ξ_laur := by rw [hCancel, one_mul]
      _ = (j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹)) * τ_inv *
            j_inf_U (u_w₀ : R_inf₀)) *
          ((j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a)) * j_inf_U t_inf₀ *
              j_inf_U ↑(u_w₀⁻¹)) * η_laur ξ_laur) := by rw [mul_assoc]
      _ = j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹)) * τ_inv *
            j_inf_U (u_w₀ : R_inf₀) := by rw [h1, mul_one]

  let φ_ov_hom : R_Xb →+* R_laur := Φ_ov.toRingEquiv.toRingHom
  have hη_Φ_eq : η_laur.comp φ_ov_hom = φ_Xb := by
    apply IsLocalization.ringHom_ext
      (Submonoid.powers (Polynomial.X - Polynomial.C b : Polynomial F))
    rw [hφ_Xb_comp]
    have hC : ∀ c : F,
        ((η_laur.comp φ_ov_hom).comp (algebraMap (Polynomial F) R_Xb)) (Polynomial.C c) =
          φ₀_U (Polynomial.C c) := by
      intro c
      simp only [RingHom.comp_apply]
      rw [← hAlgC R_Xb c]
      have hcomm : φ_ov_hom (algebraMap F R_Xb c) = algebraMap F R_laur c := Φ_ov.commutes c
      have hc : η_laur (j₀_std (Polynomial.C c)) = j_inf_U (η₀ (Polynomial.C c)) :=
        hCompApp hη_laur_comp (Polynomial.C c)
      rw [hcomm, hAlgC R_laur c, hc, hη₀_C c, hφ₀_C c]
    apply Polynomial.ringHom_ext'
    · apply RingHom.ext; intro c; exact hC c
    · have hsub_eq :
          ((η_laur.comp φ_ov_hom).comp (algebraMap (Polynomial F) R_Xb))
            (Polynomial.X - Polynomial.C b) =
          φ₀_U (Polynomial.X - Polynomial.C b) := by
        simp only [RingHom.comp_apply]
        change η_laur (Φ_ov (algebraMap (Polynomial F) R_Xb (Polynomial.X - Polynomial.C b))) = _
        have hc : η_laur (j₀_std (Polynomial.C a)) = j_inf_U (η₀ (Polynomial.C a)) :=
          hCompApp hη_laur_comp (Polynomial.C a)
        rw [hΦ_inv, map_mul, hη_laur_ξ, hc, hη₀_C a, hφ₀_sub b, ← hu_w₀_val]
        have ha_inv : Polynomial.C a * Polynomial.C a⁻¹ = (1 : Polynomial F) := by
          rw [← Polynomial.C_mul, mul_inv_cancel₀ ha_ne, Polynomial.C_1]
        calc j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a)) *
              (j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹)) * τ_inv *
                j_inf_U (u_w₀ : R_inf₀))
          _ = j_inf_U (algebraMap (Polynomial F) R_inf₀ (Polynomial.C a) *
                algebraMap (Polynomial F) R_inf₀ (Polynomial.C a⁻¹)) *
              (τ_inv * j_inf_U (u_w₀ : R_inf₀)) := by
              rw [map_mul]; ring
          _ = τ_inv * j_inf_U (u_w₀ : R_inf₀) := by
              rw [← map_mul, ha_inv, map_one, map_one, one_mul]
      have hX_split : (Polynomial.X : Polynomial F) =
          (Polynomial.X - Polynomial.C b) + Polynomial.C b := by ring
      calc ((η_laur.comp φ_ov_hom).comp (algebraMap (Polynomial F) R_Xb)) Polynomial.X
        _ = ((η_laur.comp φ_ov_hom).comp (algebraMap (Polynomial F) R_Xb))
              ((Polynomial.X - Polynomial.C b) + Polynomial.C b) :=
            congrArg ((η_laur.comp φ_ov_hom).comp (algebraMap (Polynomial F) R_Xb)) hX_split
        _ = φ₀_U ((Polynomial.X - Polynomial.C b) + Polynomial.C b) := by
            rw [map_add, map_add, hsub_eq, hC b]
        _ = φ₀_U Polynomial.X := congrArg φ₀_U hX_split.symm

  have hOverlap_geom :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_inf_U) ≫ ι_inf =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_inf) ≫ (e_U.hom ≫ U₀.ι) := by
    calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_inf_U) ≫ ι_inf
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (j_inf_U.comp η₀)) ≫ w'_inf := by
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_inf_U) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom η₀) ≫ w'_inf) = _
          rw [← CategoryTheory.Category.assoc, ← hSpecComp]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom η_laur) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₀_std) ≫ w'_inf) := by
          rw [← hη_laur_comp, hSpecComp, CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom η_laur) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_ov_hom) ≫
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (Polynomial F) R_Xb)) ≫ j_aff)) := by
          rw [← hφ_ov_geom]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Xb) ≫
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (Polynomial F) R_Xb)) ≫ j_aff) := by
          rw [← CategoryTheory.Category.assoc, ← hSpecComp, hη_Φ_eq]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀_U) ≫ j_aff := by
          rw [← CategoryTheory.Category.assoc, ← hSpecComp, hφ_Xb_comp]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_inf) ≫ (e_U.hom ≫ U₀.ι) := by
          rw [_heU_eq, ← CategoryTheory.Category.assoc, ← hSpecComp, hψ_inf_comp]

  
  have hLoc_hinf : @IsLocalization.Away R₀ _ h_inf R_inf_U _ ψ_inf.toAlgebra := by
    let _ : Algebra R₀ R_inf_U := ψ_inf.toAlgebra
    let R_h := Localization.Away h_inf
    have hUnit_ψ_hinf : IsUnit (ψ_inf h_inf) := by
      dsimp [h_inf]
      rw [hCompApp hψ_inf_comp (Polynomial.X * (Polynomial.X - Polynomial.C b)), map_mul]
      have hX : φ₀_U Polynomial.X = τ_inv := Polynomial.aeval_X τ_inv
      rw [hX]
      exact IsUnit.mul hUnit_τ_inv hUnit_φ₀_b
    let Ψ_fwd : R_h →+* R_inf_U := IsLocalization.Away.lift (S := R_h) h_inf hUnit_ψ_hinf
    have hΨ_fwd_comp : Ψ_fwd.comp (algebraMap R₀ R_h) = ψ_inf := by
      apply RingHom.ext; intro x
      exact IsLocalization.Away.lift_eq (S := R_h) h_inf hUnit_ψ_hinf x
    let g_X : Polynomial F →+* R_h := (algebraMap R₀ R_h).comp (algebraMap (Polynomial F) R₀)
    have hUnit_gX_prod : IsUnit (g_X (Polynomial.X * (Polynomial.X - Polynomial.C b))) :=
      IsLocalization.map_units R_h ⟨h_inf, Submonoid.mem_powers h_inf⟩
    have hUnit_gX_X : IsUnit (g_X Polynomial.X) :=
      hUnitOfDvd g_X hUnit_gX_prod ⟨Polynomial.X - Polynomial.C b, rfl⟩
    have hUnit_gX_Xb : IsUnit (g_X (Polynomial.X - Polynomial.C b)) :=
      hUnitOfDvd g_X hUnit_gX_prod ⟨Polynomial.X, mul_comm _ _⟩
    have hUnit_gX_PS : IsUnit (g_X P_S) :=
      (IsLocalization.map_units R₀ ⟨P_S, Submonoid.mem_powers P_S⟩).map (algebraMap R₀ R_h)
    let u_gX : R_hˣ := hUnit_gX_X.unit
    have hu_gX_val : (u_gX : R_h) = g_X Polynomial.X := rfl
    let θ₀ : Polynomial F →+* R_h := (Polynomial.aeval (↑(u_gX⁻¹) : R_h)).toRingHom
    have hθ₀_C : ∀ c : F, θ₀ (Polynomial.C c) = g_X (Polynomial.C c) := by
      intro c
      rw [hAevalC (↑(u_gX⁻¹) : R_h) c, IsScalarTower.algebraMap_apply F R₀ R_h c, hAlgC R₀ c]
      rfl
    have hθ₀_sub : ∀ c : F, θ₀ (1 - Polynomial.C c * Polynomial.X) =
        g_X (Polynomial.X - Polynomial.C c) * ↑(u_gX⁻¹) := by
      intro c
      have hX : θ₀ Polynomial.X = ↑(u_gX⁻¹) := Polynomial.aeval_X _
      rw [map_sub, map_one, map_mul, hθ₀_C c, hX, map_sub, sub_mul, ← hu_gX_val, Units.mul_inv]
    have hUnit_θ₀_rinf : IsUnit (θ₀ r_inf) := by
      dsimp [r_inf]
      rw [map_mul, map_prod]
      refine IsUnit.mul ?_ ?_
      · rw [hθ₀_sub b]
        exact IsUnit.mul hUnit_gX_Xb u_gX⁻¹.isUnit
      · refine Finset.prod_induction _ IsUnit (fun _ _ => IsUnit.mul) isUnit_one ?_
        intro s hs
        rw [hθ₀_sub s]
        exact IsUnit.mul
          (hUnitOfDvd g_X hUnit_gX_PS (Finset.dvd_prod_of_mem _ hs))
          u_gX⁻¹.isUnit
    let θ₁ : R_inf₀ →+* R_h := IsLocalization.Away.lift (S := R_inf₀) r_inf hUnit_θ₀_rinf
    have hθ₁_comp : θ₁.comp (algebraMap (Polynomial F) R_inf₀) = θ₀ := by
      apply RingHom.ext; intro p
      exact IsLocalization.Away.lift_eq (S := R_inf₀) r_inf hUnit_θ₀_rinf p
    have hθ₁_t : θ₁ t_inf₀ = ↑(u_gX⁻¹) :=
      (hCompApp hθ₁_comp Polynomial.X).trans (Polynomial.aeval_X _)
    have hUnit_θ₁_t : IsUnit (θ₁ t_inf₀) := by
      rw [hθ₁_t]; exact u_gX⁻¹.isUnit
    let Ψ_bwd : R_inf_U →+* R_h := IsLocalization.Away.lift (S := R_inf_U) t_inf₀ hUnit_θ₁_t
    have hΨ_bwd_comp : Ψ_bwd.comp j_inf_U = θ₁ := by
      apply RingHom.ext; intro x
      exact IsLocalization.Away.lift_eq (S := R_inf_U) t_inf₀ hUnit_θ₁_t x
    have hΨ_bwd_τ : Ψ_bwd τ_inv = (u_gX : R_h) := by
      have h1 : Ψ_bwd (j_inf_U t_inf₀ * τ_inv) = Ψ_bwd 1 := congrArg Ψ_bwd ht_mul_τ
      rw [map_mul, map_one] at h1
      have h2 : Ψ_bwd (j_inf_U t_inf₀) = ↑(u_gX⁻¹) :=
        (hCompApp hΨ_bwd_comp t_inf₀).trans hθ₁_t
      rw [h2] at h1
      calc Ψ_bwd τ_inv
        _ = ((u_gX : R_h) * ↑(u_gX⁻¹)) * Ψ_bwd τ_inv := by rw [Units.mul_inv, one_mul]
        _ = (u_gX : R_h) * (↑(u_gX⁻¹) * Ψ_bwd τ_inv) := by rw [mul_assoc]
        _ = (u_gX : R_h) := by rw [h1, mul_one]
    have hΨ_fwd_ugX_inv : Ψ_fwd ↑(u_gX⁻¹) = j_inf_U t_inf₀ := by
      have h1 : Ψ_fwd ((u_gX : R_h) * ↑(u_gX⁻¹)) = Ψ_fwd 1 :=
        congrArg Ψ_fwd (Units.mul_inv u_gX)
      rw [map_mul, map_one] at h1
      have h2 : Ψ_fwd (u_gX : R_h) = τ_inv := by
        rw [hu_gX_val]
        change Ψ_fwd (algebraMap R₀ R_h (algebraMap (Polynomial F) R₀ Polynomial.X)) = _
        rw [hCompApp hΨ_fwd_comp _, hCompApp hψ_inf_comp Polynomial.X]
        exact Polynomial.aeval_X τ_inv
      rw [h2] at h1
      calc Ψ_fwd ↑(u_gX⁻¹)
        _ = (j_inf_U t_inf₀ * τ_inv) * Ψ_fwd ↑(u_gX⁻¹) := by rw [ht_mul_τ, one_mul]
        _ = j_inf_U t_inf₀ * (τ_inv * Ψ_fwd ↑(u_gX⁻¹)) := by rw [mul_assoc]
        _ = j_inf_U t_inf₀ := by rw [h1, mul_one]
    have hΨ_id₁ : Ψ_bwd.comp Ψ_fwd = RingHom.id R_h := by
      apply IsLocalization.ringHom_ext (Submonoid.powers h_inf)
      rw [RingHom.comp_assoc, hΨ_fwd_comp, RingHom.id_comp]
      apply IsLocalization.ringHom_ext (Submonoid.powers P_S)
      rw [RingHom.comp_assoc, hψ_inf_comp]
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext; intro c
        simp only [RingHom.comp_apply]
        rw [hφ₀_C c, hCompApp hΨ_bwd_comp _, hCompApp hθ₁_comp (Polynomial.C c), hθ₀_C c]
        rfl
      · simp only [RingHom.comp_apply]
        have hX : φ₀_U Polynomial.X = τ_inv := Polynomial.aeval_X τ_inv
        rw [hX, hΨ_bwd_τ, hu_gX_val]
        rfl
    have hΨ_id₂ : Ψ_fwd.comp Ψ_bwd = RingHom.id R_inf_U := by
      apply IsLocalization.ringHom_ext (Submonoid.powers t_inf₀)
      rw [RingHom.comp_assoc, hΨ_bwd_comp, RingHom.id_comp]
      apply IsLocalization.ringHom_ext (Submonoid.powers r_inf)
      rw [RingHom.comp_assoc, hθ₁_comp]
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext; intro c
        simp only [RingHom.comp_apply]
        rw [hθ₀_C c]
        change Ψ_fwd (algebraMap R₀ R_h (algebraMap (Polynomial F) R₀ (Polynomial.C c))) = _
        rw [hCompApp hΨ_fwd_comp _, hCompApp hψ_inf_comp (Polynomial.C c), hφ₀_C c]
      · simp only [RingHom.comp_apply]
        have hX : θ₀ Polynomial.X = ↑(u_gX⁻¹) := Polynomial.aeval_X _
        rw [hX, hΨ_fwd_ugX_inv]
    let e_Rh : R_h ≃ₐ[R₀] R_inf_U :=
      { toFun := Ψ_fwd
        invFun := Ψ_bwd
        left_inv := fun x => RingHom.congr_fun hΨ_id₁ x
        right_inv := fun x => RingHom.congr_fun hΨ_id₂ x
        map_mul' := map_mul Ψ_fwd
        map_add' := map_add Ψ_fwd
        commutes' := fun x => hCompApp hΨ_fwd_comp x }
    exact IsLocalization.isLocalization_of_algEquiv (Submonoid.powers h_inf) e_Rh

  
  have hPre_U₀ : ι_inf.base ⁻¹' (U₀ : Set ↥D₀.left) =
      { q : AlgebraicGeometry.Spec (CommRingCat.of R_inf₀) | t_inf₀ ∉ q.asIdeal } := by
    ext q
    constructor
    · intro hqU ht_in
      have hX_in : Polynomial.X ∈ Ideal.comap (algebraMap (Polynomial F) R_inf₀) q.asIdeal := ht_in
      have hq_eq : q = p_inf :=
        hp_inf_uniq q
          (hEqSpanX _ (PrimeSpectrum.comap (algebraMap (Polynomial F) R_inf₀) q).isPrime hX_in)
      have h_in_U₀ : ι_inf.base p_inf ∈ (U₀ : Set ↥D₀.left) := by
        rw [← hq_eq]
        exact hqU
      rw [hι_inf_pt, _hU₀_eq] at h_in_U₀
      rcases h_in_U₀ with ⟨p', _, hp'_eq⟩
      exact ((hRangeSinf (s_inf.base default)).mpr rfl) ⟨p', hp'_eq⟩
    · intro ht_not
      rcases (hLocAwayMem R_inf_U t_inf₀ q).mp ht_not with ⟨q_U_raw, hq_U⟩
      let q_U : AlgebraicGeometry.Spec (CommRingCat.of R_inf_U) := q_U_raw
      have hq_map : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_inf_U)).base q_U = q := by
        rw [AlgebraicGeometry.Spec.map_apply]
        exact hq_U
      change ι_inf.base q ∈ (U₀ : Set ↥D₀.left)
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι U₀, ← hq_map,
        ← AlgebraicGeometry.Scheme.Hom.comp_apply, hOverlap_geom,
        AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply]
      exact ⟨_, rfl⟩

  
  let β₀ : Polynomial F →+* RatFunc F :=
    (Polynomial.aeval (RatFunc.X : RatFunc F)⁻¹).toRingHom
  have hβ₀_X : β₀ Polynomial.X = (RatFunc.X : RatFunc F)⁻¹ := Polynomial.aeval_X _
  have hβ₀_sub_ne : ∀ c : F, β₀ (1 - Polynomial.C c * Polynomial.X) ≠ 0 := by
    intro c h0
    have h1 : (1 : RatFunc F) - algebraMap F (RatFunc F) c * (RatFunc.X : RatFunc F)⁻¹ = 0 := by
      simpa [β₀] using h0
    have h2 : ((1 : RatFunc F) - algebraMap F (RatFunc F) c * (RatFunc.X : RatFunc F)⁻¹) *
        (RatFunc.X : RatFunc F) = 0 := by rw [h1, zero_mul]
    rw [sub_mul, one_mul, mul_assoc, inv_mul_cancel₀ RatFunc.X_ne_zero, mul_one, sub_eq_zero,
      ← RatFunc.algebraMap_X, hAlgC (RatFunc F) c] at h2
    have hXC := RatFunc.algebraMap_injective F h2
    have hdeg := congrArg Polynomial.natDegree hXC
    simp at hdeg
  have hUnit_β₀_rinf : IsUnit (β₀ r_inf) := by
    apply IsUnit.mk0
    dsimp [r_inf]
    rw [map_mul, map_prod]
    exact mul_ne_zero (hβ₀_sub_ne b)
      (Finset.prod_ne_zero_iff.mpr fun s _ => hβ₀_sub_ne s)
  let β₁ : R_inf₀ →+* RatFunc F := IsLocalization.Away.lift (S := R_inf₀) r_inf hUnit_β₀_rinf
  have hβ₁_comp : β₁.comp (algebraMap (Polynomial F) R_inf₀) = β₀ := by
    apply RingHom.ext; intro p
    exact IsLocalization.Away.lift_eq (S := R_inf₀) r_inf hUnit_β₀_rinf p
  have hβ₁_t : β₁ t_inf₀ = (RatFunc.X : RatFunc F)⁻¹ :=
    (hCompApp hβ₁_comp Polynomial.X).trans hβ₀_X
  have hUnit_β₁_t : IsUnit (β₁ t_inf₀) := by
    rw [hβ₁_t]
    exact IsUnit.mk0 _ (inv_ne_zero RatFunc.X_ne_zero)
  let β_inv : R_inf_U →+* RatFunc F := IsLocalization.Away.lift (S := R_inf_U) t_inf₀ hUnit_β₁_t
  have hβ_inv_comp : β_inv.comp j_inf_U = β₁ := by
    apply RingHom.ext; intro x
    exact IsLocalization.Away.lift_eq (S := R_inf_U) t_inf₀ hUnit_β₁_t x
  have hβ_inv_aeval :
      β_inv.comp (j_inf_U.comp (algebraMap (Polynomial F) R_inf₀)) = β₀ := by
    rw [← RingHom.comp_assoc, hβ_inv_comp, hβ₁_comp]
  have hβ_inv_τ : β_inv τ_inv = (RatFunc.X : RatFunc F) := by
    have h1 : β_inv (j_inf_U t_inf₀ * τ_inv) = β_inv 1 := congrArg β_inv ht_mul_τ
    rw [map_mul, map_one] at h1
    have h2 : β_inv (j_inf_U t_inf₀) = (RatFunc.X : RatFunc F)⁻¹ :=
      (hCompApp hβ_inv_comp t_inf₀).trans hβ₁_t
    rw [h2] at h1
    calc β_inv τ_inv
      _ = ((RatFunc.X : RatFunc F) * (RatFunc.X : RatFunc F)⁻¹) * β_inv τ_inv := by
          rw [mul_inv_cancel₀ RatFunc.X_ne_zero, one_mul]
      _ = (RatFunc.X : RatFunc F) * ((RatFunc.X : RatFunc F)⁻¹ * β_inv τ_inv) := by
          rw [mul_assoc]
      _ = (RatFunc.X : RatFunc F) := by rw [h1, mul_one]
  have hβ_inv_R₀ : β_inv.comp (ψ_inf.comp (algebraMap (Polynomial F) R₀)) =
      algebraMap (Polynomial F) (RatFunc F) := by
    rw [hψ_inf_comp]
    apply Polynomial.ringHom_ext'
    · apply RingHom.ext; intro c
      simp only [RingHom.comp_apply]
      rw [hφ₀_C c, hCompApp hβ_inv_comp _, hCompApp hβ₁_comp (Polynomial.C c)]
      exact (hAevalC (RatFunc.X : RatFunc F)⁻¹ c).trans (hAlgC (RatFunc F) c)
    · simp only [RingHom.comp_apply]
      have hX : φ₀_U Polynomial.X = τ_inv := Polynomial.aeval_X τ_inv
      rw [hX, hβ_inv_τ, RatFunc.algebraMap_X]

  exact ⟨r_inf, h_inf, hr_inf_ev0, hh_inf_ne, ι_inf, p_inf, ψ_inf, β_inv,
    hι_inf_open, hLoc_hinf, hp_inf_comap, hι_inf_pt, hPre_U₀,
    hOverlap_geom, hβ_inv_aeval, hβ_inv_R₀⟩

theorem weil_mid_dev_puncture_etale_inertia_coset_sheet (F : Type u) [Finite F] [Field F]
    (D : AlgebraicGeometry.Scheme.{u}) (U₀ : D.Opens)
    (R₀ : Type u) [CommRing R₀] [IsDomain R₀]
    [Algebra R₀ (RatFunc F)] [IsFractionRing R₀ (RatFunc F)]
    (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme)
    (B_r L_r : Type u) [CommRing B_r] [IsDomain B_r] [Field L_r]
    [Algebra F B_r] [Algebra R₀ B_r]
    [Algebra F L_r] [Algebra (RatFunc F) L_r] [Algebra B_r L_r] [Algebra R₀ L_r]
    [IsScalarTower F (RatFunc F) L_r] [IsScalarTower R₀ B_r L_r]
    [IsScalarTower R₀ (RatFunc F) L_r]
    [Module.Finite R₀ B_r] [Algebra.Etale R₀ B_r]
    [IsFractionRing B_r L_r] [IsIntegralClosure B_r R₀ L_r]
    [FiniteDimensional (RatFunc F) L_r] [IsGalois (RatFunc F) L_r]
    (A_s : Type u) [CommRing A_s] [IsDomain A_s]
    [Algebra F A_s] [Algebra A_s (RatFunc F)] [IsFractionRing A_s (RatFunc F)]
    [Algebra A_s L_r] [IsScalarTower F A_s (RatFunc F)] [IsScalarTower A_s (RatFunc F) L_r]
    (e_poly : Polynomial F ≃ₐ[F] A_s) (a₀ : F) (r_s : A_s)
    (hr_s : r_s ∉ Ideal.span {e_poly (Polynomial.X - Polynomial.C a₀)})
    (R_s₀ R_s_U : Type u) [CommRing R_s₀] [CommRing R_s_U]
    [Algebra A_s R_s₀] [IsLocalization.Away r_s R_s₀]
    [Algebra R_s₀ R_s_U]
    [IsLocalization.Away (algebraMap A_s R_s₀ (e_poly (Polynomial.X - Polynomial.C a₀))) R_s_U]
    (h_s : R₀) (hh_s : h_s ≠ 0)
    (ι_s : AlgebraicGeometry.Spec (CommRingCat.of R_s₀) ⟶ D)
    [AlgebraicGeometry.IsOpenImmersion ι_s]
    (p_s : AlgebraicGeometry.Spec (CommRingCat.of R_s₀))
    (hp_s : Ideal.comap (algebraMap A_s R_s₀) p_s.asIdeal =
      Ideal.span {e_poly (Polynomial.X - Polynomial.C a₀)})
    (ψ_s : R₀ →+* R_s_U)
    (hψ_loc : @IsLocalization.Away R₀ _ h_s R_s_U _ ψ_s.toAlgebra)
    (β_s : R_s_U →+* RatFunc F)
    (hU₀_pre : ι_s.base ⁻¹' (U₀ : Set ↥D) =
      { q : AlgebraicGeometry.Spec (CommRingCat.of R_s₀) |
        algebraMap A_s R_s₀ (e_poly (Polynomial.X - Polynomial.C a₀)) ∉ q.asIdeal })
    (hι_comp : CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_s₀ R_s_U))) ι_s =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s))
        (CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι))
    (hβ_As : β_s.comp ((algebraMap R_s₀ R_s_U).comp (algebraMap A_s R_s₀)) =
      algebraMap A_s (RatFunc F))
    (hβ_R₀ : (algebraMap (RatFunc F) L_r).comp (β_s.comp ψ_s) = algebraMap R₀ L_r)
    (W : D.Etale) (x : ↥((AlgebraicGeometry.Scheme.Etale.forget D).obj W).left)
    (hx_eq : ((AlgebraicGeometry.Scheme.Etale.forget D).obj W).hom.base x = ι_s.base p_s) :
    let t_s : A_s := e_poly (Polynomial.X - Polynomial.C a₀)
    let V_r := AlgebraicGeometry.Spec (CommRingCat.of B_r)
    let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r))) e_U.hom
    ∃ (Q₀ : Ideal ↥(integralClosure A_s L_r))
      (W'' : D.Etale)
      (u_ref : Quiver.Hom W'' W)
      (x'' : ↥((AlgebraicGeometry.Scheme.Etale.forget D).obj W'').left)
      (H_I : Subgroup (B_r ≃ₐ[R₀] B_r))
      (C₀ : Set ↥(CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj
          ((weilEtaleSitePullback U₀.ι).obj W'')).hom π_r)),
      Q₀.IsPrime ∧
      Ideal.comap (algebraMap A_s ↥(integralClosure A_s L_r)) Q₀ = Ideal.span {t_s} ∧
      AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget D).map u_ref).left ∧
      ((AlgebraicGeometry.Scheme.Etale.forget D).map u_ref).left.base x'' = x ∧
      (∀ σ_B ∈ H_I, ∃ σ_L : L_r ≃ₐ[RatFunc F] L_r,
        (∀ z : L_r, IsIntegral F z → σ_L z = z) ∧
        (∀ b : B_r, σ_L (algebraMap B_r L_r b) = algebraMap B_r L_r (σ_B b)) ∧
        (∀ y : ↥(integralClosure A_s L_r),
          σ_L (y : L_r) - (y : L_r) ∈
            Subtype.val '' (Q₀ : Set ↥(integralClosure A_s L_r)))) ∧
      (let h_W''_U := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj
         ((weilEtaleSitePullback U₀.ι).obj W'')).hom
       let W''_r := CategoryTheory.Limits.pullback h_W''_U π_r
       C₀.Nonempty ∧ IsClopen C₀ ∧ _root_.IsPreconnected C₀ ∧
       (∀ y : ↥W''_r, ∃ (σ : B_r ≃ₐ[R₀] B_r) (m_σ : Quiver.Hom W''_r W''_r),
         CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W''_U π_r) =
           CategoryTheory.Limits.pullback.fst h_W''_U π_r ∧
         CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W''_U π_r) =
           CategoryTheory.CategoryStruct.comp
             (CategoryTheory.Limits.pullback.snd h_W''_U π_r)
             (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) ∧
         y ∈ m_σ.base '' C₀) ∧
       ∀ (σ : B_r ≃ₐ[R₀] B_r) (m_σ : Quiver.Hom W''_r W''_r),
         CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W''_U π_r) =
           CategoryTheory.Limits.pullback.fst h_W''_U π_r →
         CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W''_U π_r) =
           CategoryTheory.CategoryStruct.comp
             (CategoryTheory.Limits.pullback.snd h_W''_U π_r)
             (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
         (σ ∈ H_I → m_σ.base '' C₀ ⊆ C₀) ∧
         (σ ∉ H_I → Disjoint C₀ (m_σ.base '' C₀))) :=
by
  
  have h_s2 :
      ∀ (F K L A_s : Type u) [Finite F] [Field F] [Field K] [Field L]
        [CommRing A_s] [IsDomain A_s]
        [Algebra F A_s] [Algebra A_s K] [IsFractionRing A_s K]
        [Algebra F K] [IsScalarTower F A_s K]
        [Algebra F L] [Algebra K L] [Algebra A_s L]
        [IsScalarTower F K L] [IsScalarTower A_s K L]
        [FiniteDimensional K L] [IsGalois K L]
        (e_poly : Polynomial F ≃ₐ[F] A_s) (a₀ : F),
        let t_s : A_s := e_poly (Polynomial.X - Polynomial.C a₀)
        let C_L := ↥(integralClosure A_s L)
        ∃ (Q₀ : Ideal C_L) (K_I C_I : Type u)
          (_ : Field K_I) (_ : CommRing C_I) (_ : IsDomain C_I) (_ : IsDedekindDomain C_I)
          (_ : Algebra A_s C_I) (_ : Algebra A_s K_I) (_ : Algebra C_I K_I)
          (_ : IsScalarTower A_s C_I K_I) (_ : IsFractionRing C_I K_I)
          (_ : Algebra K K_I) (_ : IsScalarTower A_s K K_I)
          (_ : FiniteDimensional K K_I) (_ : Algebra.IsSeparable K K_I)
          (_ : IsIntegralClosure C_I A_s K_I) (_ : Module.Finite A_s C_I)
          (_ : Algebra K_I L) (_ : IsScalarTower K K_I L)
          (_ : FiniteDimensional K_I L) (_ : IsGalois K_I L)
          (j_CI : C_I →ₐ[A_s] C_L) (P_I : Ideal C_I),
          (Q₀.IsPrime ∧ Ideal.comap (algebraMap A_s C_L) Q₀ = Ideal.span {t_s}) ∧
          (Function.Injective j_CI ∧
            ∀ c : C_I, (j_CI c : L) = algebraMap K_I L (algebraMap C_I K_I c)) ∧
          (P_I.IsMaximal ∧ P_I ≠ ⊥ ∧
            Ideal.comap (algebraMap A_s C_I) P_I = Ideal.span {t_s} ∧
            algebraMap A_s C_I t_s ∉ P_I ^ 2) ∧
          (Ideal.comap j_CI.toRingHom Q₀ = P_I ∧
            (∀ Q : Ideal C_L, Q.IsPrime → Ideal.comap j_CI.toRingHom Q = P_I → Q = Q₀) ∧
            (∀ y : C_L, ∃ c : C_I, y - j_CI c ∈ Q₀)) ∧
          (∀ σ_L : L ≃ₐ[K] L,
            ((∀ y : C_L, σ_L (y : L) - (y : L) ∈ Subtype.val '' (Q₀ : Set C_L)) ↔
              (∀ x : K_I, σ_L (algebraMap K_I L x) = algebraMap K_I L x)) ∧
            ((∀ y : C_L, σ_L (y : L) - (y : L) ∈ Subtype.val '' (Q₀ : Set C_L)) →
              ∀ z : L, _root_.IsIntegral F z → σ_L z = z)) := by
    clear * -
    classical
    intro F K L A_s _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ e_poly a₀ t_s C_L
    have _ : IsPrincipalIdealRing A_s :=
      IsPrincipalIdealRing.of_surjective e_poly.toRingHom e_poly.surjective
    have _ : IsDedekindDomain A_s := inferInstance
    let p_poly : Ideal (Polynomial F) := Ideal.span {Polynomial.X - Polynomial.C a₀}
    let p_s : Ideal A_s := Ideal.span {t_s}
    have ht_s_ne : t_s ≠ 0 :=
      (map_ne_zero_iff e_poly e_poly.injective).mpr (Polynomial.monic_X_sub_C a₀).ne_zero
    have hp_s_ne : p_s ≠ ⊥ := mt Ideal.span_singleton_eq_bot.mp ht_s_ne
    have hp_map : Ideal.map e_poly.toRingHom p_poly = p_s := by
      dsimp [p_poly, p_s, t_s]
      rw [Ideal.map_span, Set.image_singleton]
      rfl
    let e_quot_As : (Polynomial F ⧸ p_poly) ≃+* (A_s ⧸ p_s) :=
      Ideal.quotientEquiv p_poly p_s e_poly.toRingEquiv hp_map.symm
    have hp_s_max : p_s.IsMaximal :=
      PrincipalIdealRing.isMaximal_of_irreducible
        ((MulEquiv.irreducible_iff e_poly.toRingEquiv.toMulEquiv).mpr
          (Polynomial.irreducible_X_sub_C a₀))
    have _ : p_s.IsMaximal := hp_s_max
    have _ : Finite (A_s ⧸ p_s) := by
      have hsurj : Function.Surjective
          (fun c : F => e_quot_As (Ideal.Quotient.mk p_poly (Polynomial.C c))) := by
        intro z
        obtain ⟨q, rfl⟩ := e_quot_As.surjective z
        obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective q
        refine ⟨Polynomial.eval a₀ f, congrArg e_quot_As ?_⟩
        symm
        rw [Ideal.Quotient.eq]
        have hroot : Polynomial.IsRoot (f - Polynomial.C (Polynomial.eval a₀ f)) a₀ := by
          simp
        exact Ideal.mem_span_singleton.mpr (Polynomial.dvd_iff_isRoot.mpr hroot)
      exact Finite.of_surjective _ hsurj
    have _ : IsDedekindDomain C_L := integralClosure.isDedekindDomain A_s K L
    have _ : IsFractionRing C_L L := integralClosure.isFractionRing_of_finite_extension K L
    have _ : Module.Finite A_s C_L := IsIntegralClosure.finite A_s K L C_L
    have _ : FaithfulSMul A_s C_L := FaithfulSMul.of_field_isFractionRing A_s C_L K L
    obtain ⟨Q₀, hQ₀_mem⟩ := p_s.nonempty_primesOver (S := C_L)
    have hQ₀_prime : Q₀.IsPrime := hQ₀_mem.1
    have hQ₀_lies : Q₀.LiesOver p_s := hQ₀_mem.2
    have _ : Q₀.IsPrime := hQ₀_prime
    have _ : Q₀.LiesOver p_s := hQ₀_lies
    have hQ₀_comap : Ideal.comap (algebraMap A_s C_L) Q₀ = p_s := hQ₀_lies.over.symm
    have _ : Algebra.IsIntegral A_s C_L := Algebra.IsIntegral.of_finite A_s C_L
    have hQ₀_ne_bot : Q₀ ≠ ⊥ := by
      intro hbot
      apply hp_s_ne
      rw [← hQ₀_comap, hbot]
      ext a
      simp
    have hQ₀_max : Q₀.IsMaximal :=
      (⟨Q₀, hQ₀_prime, hQ₀_ne_bot⟩ : IsDedekindDomain.HeightOneSpectrum C_L).isMaximal
    have _ : Q₀.IsMaximal := hQ₀_max
    let G := (L ≃ₐ[K] L)
    have _ : IsGaloisGroup G A_s C_L := IsGaloisGroup.of_isFractionRing G A_s C_L K L
    let I_L : Subgroup G := (Submodule.toAddSubgroup Q₀).inertia G
    let F_I : IntermediateField K L := IntermediateField.fixedField I_L
    let K_I : Type u := ↥F_I
