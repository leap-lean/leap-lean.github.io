        (by rw [CategoryTheory.Category.assoc, hd_B_π σ, CategoryTheory.Limits.pullback.condition])

    have hm_B_fst : ∀ (W : U.Etale) (σ : B ≃ₐ[R₀] B),
        m_B_act W σ ≫ CategoryTheory.Limits.pullback.fst
          (((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom) π_B_r =
