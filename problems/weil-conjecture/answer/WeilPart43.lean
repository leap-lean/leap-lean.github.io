                  (Category.comp_id (p_μ μ)).symm.trans
                    ((congrArg (p_μ μ ≫ ·)
                        (CategoryTheory.Limits.pullback.lift_fst
                          (f := g₁ ≫ ι_Y) (g := ι_Y) (𝟙 Z_sch) g₂ _).symm).trans
                      ((Category.assoc (p_μ μ) diag₁₂ _).symm.trans
                        ((congrArg (· ≫ _)
                            (CategoryTheory.Limits.pullback.condition
                              (f := diag₁₂) (g := δ_Z μ))).trans
                          ((Category.assoc _ (δ_Z μ) _).trans
                            ((congrArg (_ ≫ ·) (hδZ_props μ).1).trans (Category.comp_id _))))))
                have hg₂_eq : p_μ μ ≫ g₂ = p_μ μ ≫ g₁ ≫ v_Y μ :=
                  (congrArg (p_μ μ ≫ ·)
                      (CategoryTheory.Limits.pullback.lift_snd
                        (f := g₁ ≫ ι_Y) (g := ι_Y) (𝟙 Z_sch) g₂ _).symm).trans
                    ((Category.assoc (p_μ μ) diag₁₂ _).symm.trans
                      ((congrArg (· ≫ _)
                          (CategoryTheory.Limits.pullback.condition
                            (f := diag₁₂) (g := δ_Z μ))).trans
                        ((Category.assoc _ (δ_Z μ) _).trans
                          ((congrArg (_ ≫ ·) (hδZ_props μ).2.1).trans
                            (congrArg (· ≫ (g₁ ≫ v_Y μ)) hp_eq_r.symm)))))
                by_cases hc₁₂ : c₁ = ((ρ_mod μ⁻¹).val).mulVec c₂
                · have hmor_et : u_μ μ ≫ q₂ = (u_μ μ ≫ q₁) ≫ B_h.map (u₀_aut μ) := by
                    apply Fgt_Y.map_injective
                    apply CategoryTheory.Over.OverMorphism.ext
                    change p_μ μ ≫ (Fgt_Y.map q₂).left =
                      (p_μ μ ≫ (Fgt_Y.map q₁).left) ≫ (Fgt_Y.map (B_h.map (u₀_aut μ))).left
                    have hBh : (Fgt_Y.map (B_h.map (u₀_aut μ))).left = v_Y μ := by
                      apply CategoryTheory.Limits.pullback.hom_ext
                      · exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans (hv_q μ).symm
                      · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans (hv_ι μ).symm
                    have lhs_eq : p_μ μ ≫ (Fgt_Y.map q₂).left = p_μ μ ≫ g₂ :=
                      congrArg (p_μ μ ≫ ·) hq₂_snd
                    have rhs_eq : (p_μ μ ≫ (Fgt_Y.map q₁).left) ≫
                          (Fgt_Y.map (B_h.map (u₀_aut μ))).left =
                        p_μ μ ≫ g₁ ≫ v_Y μ :=
                      (congrArg (· ≫ _) (congrArg (p_μ μ ≫ ·) hq₁_snd)).trans
                        ((Category.assoc _ _ _).trans (congrArg ((p_μ μ ≫ g₁) ≫ ·) hBh))
                    exact lhs_eq.trans (hg₂_eq.trans rhs_eq.symm)
                  have hstep1 : (𝒢.obj.map (u_μ μ).op).hom ((𝒢.obj.map q₁.op).hom (g_c c₁)) =
                      (𝒢.obj.map (u_μ μ ≫ q₁).op).hom (g_c c₁) :=
                    (ConcreteCategory.congr_hom (𝒢.obj.map_comp q₁.op (u_μ μ).op) (g_c c₁)).symm
                  have hstep2 : (𝒢.obj.map (u_μ μ ≫ q₁).op).hom (g_c c₁) =
                      (𝒢.obj.map (u_μ μ ≫ q₁).op).hom
                        ((𝒢.obj.map (B_h.map (u₀_aut μ)).op).hom (g_c c₂)) :=
                    congrArg (𝒢.obj.map (u_μ μ ≫ q₁).op).hom
                      ((congrArg g_c hc₁₂).trans (hg_deck μ c₂).symm)
                  have hstep3 : (𝒢.obj.map (u_μ μ ≫ q₁).op).hom
                        ((𝒢.obj.map (B_h.map (u₀_aut μ)).op).hom (g_c c₂)) =
                      (𝒢.obj.map ((u_μ μ ≫ q₁) ≫ B_h.map (u₀_aut μ)).op).hom (g_c c₂) :=
                    (ConcreteCategory.congr_hom
                      (𝒢.obj.map_comp (B_h.map (u₀_aut μ)).op (u_μ μ ≫ q₁).op) (g_c c₂)).symm
                  have hstep4 : (𝒢.obj.map ((u_μ μ ≫ q₁) ≫ B_h.map (u₀_aut μ)).op).hom (g_c c₂) =
                      (𝒢.obj.map (u_μ μ ≫ q₂).op).hom (g_c c₂) :=
                    congrArg (fun k => (𝒢.obj.map k.op).hom (g_c c₂)) hmor_et.symm
                  have hstep5 : (𝒢.obj.map (u_μ μ ≫ q₂).op).hom (g_c c₂) =
                      (𝒢.obj.map (u_μ μ).op).hom ((𝒢.obj.map q₂.op).hom (g_c c₂)) :=
                    ConcreteCategory.congr_hom (𝒢.obj.map_comp q₂.op (u_μ μ).op) (g_c c₂)
                  exact hstep1.trans (hstep2.trans (hstep3.trans (hstep4.trans hstep5)))
                · have hEmp : IsEmpty ↥(Fgt_Y.obj (P_et μ)).left := by
                    refine ⟨fun x => hc₁₂ ?_⟩
                    let m_μ : U_V ⟶ U_V :=
                      CategoryTheory.Limits.pullback.lift fst_U (snd_U ≫ v_Y μ)
                        (by rw [Category.assoc, hv_ι μ, CategoryTheory.Limits.pullback.condition])
                    have hl_m : p_μ μ ≫ l₂ = (p_μ μ ≫ l₁) ≫ m_μ := by
                      apply CategoryTheory.Limits.pullback.hom_ext
                      · rw [Category.assoc, hl₂_fst, Category.assoc,
                          CategoryTheory.Limits.pullback.lift_fst, Category.assoc, hl₁_fst]
                      · rw [Category.assoc, Category.assoc,
                          CategoryTheory.Limits.pullback.lift_snd]
                        exact hg₂_eq
                    have hpt : l₂.base ((p_μ μ).base x) = m_μ.base (l₁.base ((p_μ μ).base x)) :=
                      congrArg (fun k => k.base x) hl_m
                    have hc₂_eq : c₂ = ((ρ_mod μ).val).mulVec c₁ := by
                      rw [← hl₂_c ((p_μ μ).base x), hpt,
                        hf_eqv μ m_μ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                          (CategoryTheory.Limits.pullback.lift_snd _ _ _),
                        hl₁_c ((p_μ μ).base x)]
                      rfl
                    rw [hc₂_eq, Matrix.mulVec_mulVec, ← Units.val_mul, ← map_mul,
                      inv_mul_cancel, map_one, Units.val_one, Matrix.one_mulVec]
                  exact @Subsingleton.elim _ (hSubOfEmpty 𝒢 (P_et μ) hEmp) _ _
          have hExPsi : ∀ (U : Y.Etale) (t : ↑(𝒥_h.obj.obj (Opposite.op U))),
              ∃! x_U : ↑(𝒢.obj.obj (Opposite.op U)),
                ∀ {Z : Y.Etale} (w : Z ⟶ U) (val : ↑(𝒢.obj.obj (Opposite.op Z))),
                  IsLevelArrow t w val → (𝒢.obj.map w.op).hom x_U = val := by
            intro U t
            let h_U := (Fgt_Y.obj U).hom
            let U_V := CategoryTheory.Limits.pullback h_U ι_Y
            let fst_U := CategoryTheory.Limits.pullback.fst h_U ι_Y
            let snd_U := CategoryTheory.Limits.pullback.snd h_U ι_Y
            let f := triv_h U t
            have : AlgebraicGeometry.Etale h_U := U.prop
            have ht_mem : f ∈ Set.range (triv_h U) := ⟨t, rfl⟩
            rw [(hSpec_h U).2] at ht_mem
            obtain ⟨⟨W₀, hW₀_top, hW₀_zero⟩, _⟩ := ht_mem
            let obj_cov : Unit ⊕ C_vec → Y.Etale := fun idx =>
              match idx with
              | Sum.inl () => AlgebraicGeometry.Scheme.Etale.mk (W₀.ι ≫ h_U)
              | Sum.inr c =>
                  let O_c : U_V.Opens := ⟨f ⁻¹' {c}, f.isLocallyConstant {c}⟩
                  AlgebraicGeometry.Scheme.Etale.mk (O_c.ι ≫ fst_U ≫ h_U)
            let mor_cov : ∀ idx : Unit ⊕ C_vec, obj_cov idx ⟶ U := fun idx =>
              match idx with
              | Sum.inl () => CategoryTheory.MorphismProperty.Over.homMk W₀.ι rfl trivial
              | Sum.inr c =>
                  let O_c : U_V.Opens := ⟨f ⁻¹' {c}, f.isLocallyConstant {c}⟩
                  CategoryTheory.MorphismProperty.Over.homMk (O_c.ι ≫ fst_U) rfl trivial
            let gen_val : ∀ idx : Unit ⊕ C_vec, ↑(𝒢.obj.obj (Opposite.op (obj_cov idx))) := fun idx =>
              match idx with
              | Sum.inl () => 0
              | Sum.inr c =>
                  let O_c : U_V.Opens := ⟨f ⁻¹' {c}, f.isLocallyConstant {c}⟩
                  let q_c : obj_cov (Sum.inr c) ⟶ E₀ :=
                    CategoryTheory.MorphismProperty.Over.homMk (O_c.ι ≫ snd_U)
                      ((Category.assoc O_c.ι snd_U ι_Y).trans
                        (congrArg (O_c.ι ≫ ·)
                          (CategoryTheory.Limits.pullback.condition (f := h_U) (g := ι_Y)).symm))
                      trivial
                  (𝒢.obj.map q_c.op).hom (g_c c)
            have hIsLvl_pull : ∀ (idx : Unit ⊕ C_vec) {Z : Y.Etale} (v : Z ⟶ obj_cov idx),
                IsLevelArrow t (v ≫ mor_cov idx) ((𝒢.obj.map v.op).hom (gen_val idx)) := by
              intro idx Z v
              rcases idx with ⟨⟩ | c
              · left
                refine ⟨fun y ⟨z, hz⟩ => hW₀_zero y ?_, map_zero _⟩
                have h1 : (Fgt_Y.map (v ≫ mor_cov (Sum.inl ()))).left.base z =
                    W₀.ι.base ((Fgt_Y.map v).left.base z) := rfl
                rw [← hz, h1, ← SetLike.mem_coe, ← hOpensRange W₀]
                exact ⟨(Fgt_Y.map v).left.base z, rfl⟩
              · right
                let O_c : U_V.Opens := ⟨f ⁻¹' {c}, f.isLocallyConstant {c}⟩
                let q_c : obj_cov (Sum.inr c) ⟶ E₀ :=
                  CategoryTheory.MorphismProperty.Over.homMk (O_c.ι ≫ snd_U)
                    ((Category.assoc O_c.ι snd_U ι_Y).trans
                      (congrArg (O_c.ι ≫ ·)
                        (CategoryTheory.Limits.pullback.condition (f := h_U) (g := ι_Y)).symm))
                    trivial
                refine ⟨c, (Fgt_Y.map v).left ≫ O_c.ι, v ≫ q_c,
                  Category.assoc _ _ _, (Category.assoc _ _ _).symm,
                  fun z => ((Fgt_Y.map v).left.base z).2, ?_⟩
                exact (ConcreteCategory.congr_hom (𝒢.obj.map_comp q_c.op v.op) (g_c c)).symm
            let S_cov := CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows obj_cov mor_cov)
            have hS_mem : S_cov ∈ Y.smallEtaleTopology U := hYCoverMem U W₀ f hW₀_top
            let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
            have hex_fac : ∀ ⦃Z : Y.Etale⦄ (w : Z ⟶ U), S_cov.arrows w →
                ∃ (idx : Unit ⊕ C_vec) (v : Z ⟶ obj_cov idx), v ≫ mor_cov idx = w := by
              intro Z w ⟨_, v, _, hpres, hvw⟩
              rcases hpres with ⟨idx⟩
              exact ⟨idx, v, hvw⟩
            let sec_on_S : ∀ ⦃Z : Y.Etale⦄ (w : Z ⟶ U), S_cov.arrows w →
                ↑(𝒢.obj.obj (Opposite.op Z)) := fun Z w hw =>
              let idx := Classical.choose (hex_fac w hw)
              let v := Classical.choose (Classical.choose_spec (hex_fac w hw))
              (𝒢.obj.map v.op).hom (gen_val idx)
            have hsec_lvl : ∀ ⦃Z : Y.Etale⦄ (w : Z ⟶ U) (hw : S_cov.arrows w),
                IsLevelArrow t w (sec_on_S w hw) := by
              intro Z w hw
              let idx := Classical.choose (hex_fac w hw)
              let v := Classical.choose (Classical.choose_spec (hex_fac w hw))
              have hvw : v ≫ mor_cov idx = w :=
                Classical.choose_spec (Classical.choose_spec (hex_fac w hw))
              have hlvl := hIsLvl_pull idx v
              dsimp only [sec_on_S]; rwa [hvw] at hlvl
            let fam : CategoryTheory.Presieve.FamilyOfElements
                (𝒢.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ)) S_cov.arrows :=
              fun Z w hw => AddCommGrpCat.ofHom
                { toFun := fun n => n.down • sec_on_S w hw
                  map_zero' := zero_zsmul _
                  map_add' := fun m n => add_zsmul _ m.down n.down }
            have hcompat : fam.Compatible := by
              intro Y₁ Y₂ Z' g₁ g₂ f₁ f₂ h₁ h₂ hcomm
              change fam f₁ h₁ ≫ 𝒢.obj.map g₁.op = fam f₂ h₂ ≫ 𝒢.obj.map g₂.op
              ext ⟨n⟩
              change (𝒢.obj.map g₁.op).hom (n • sec_on_S f₁ h₁) =
                (𝒢.obj.map g₂.op).hom (n • sec_on_S f₂ h₂)
              rw [map_zsmul, map_zsmul]; congr 1
              let idx₁ := Classical.choose (hex_fac f₁ h₁)
              let v₁ := Classical.choose (Classical.choose_spec (hex_fac f₁ h₁))
              have hv₁ : v₁ ≫ mor_cov idx₁ = f₁ :=
                Classical.choose_spec (Classical.choose_spec (hex_fac f₁ h₁))
              let idx₂ := Classical.choose (hex_fac f₂ h₂)
              let v₂ := Classical.choose (Classical.choose_spec (hex_fac f₂ h₂))
              have hv₂ : v₂ ≫ mor_cov idx₂ = f₂ :=
                Classical.choose_spec (Classical.choose_spec (hex_fac f₂ h₂))
              change (𝒢.obj.map g₁.op).hom ((𝒢.obj.map v₁.op).hom (gen_val idx₁)) =
                (𝒢.obj.map g₂.op).hom ((𝒢.obj.map v₂.op).hom (gen_val idx₂))
              rw [← 𝒢.obj.map_comp_apply, ← 𝒢.obj.map_comp_apply, ← op_comp, ← op_comp]
              have hw₁ : (g₁ ≫ v₁) ≫ mor_cov idx₁ = g₁ ≫ f₁ := by rw [Category.assoc, hv₁]
              have hw₂ : (g₂ ≫ v₂) ≫ mor_cov idx₂ = g₁ ≫ f₁ := by
                rw [Category.assoc, hv₂, hcomm]
              have hl₁ := hIsLvl_pull idx₁ (g₁ ≫ v₁)
              have hl₂ := hIsLvl_pull idx₂ (g₂ ≫ v₂)
              rw [hw₁] at hl₁; rw [hw₂] at hl₂
              exact hRoofEq t (g₁ ≫ f₁) _ _ hl₁ hl₂
            obtain ⟨g_amalg, hg_amalg, _⟩ := 𝒢.property Aℤ S_cov hS_mem fam hcompat
            let x_U : ↑(𝒢.obj.obj (Opposite.op U)) := g_amalg.hom (ULift.up 1)
            have hx_on_S : ∀ ⦃Z : Y.Etale⦄ (w : Z ⟶ U) (hw : S_cov.arrows w),
                (𝒢.obj.map w.op).hom x_U = sec_on_S w hw := fun Z w hw => by
              have h0 : g_amalg ≫ 𝒢.obj.map w.op = fam w hw := hg_amalg w hw
              have h1 := congrArg (fun m : Aℤ ⟶ _ => m.hom (ULift.up 1)) h0
              simpa [fam, x_U] using h1
            have hx_prop : ∀ {Z : Y.Etale} (w : Z ⟶ U) (val : ↑(𝒢.obj.obj (Opposite.op Z))),
                IsLevelArrow t w val → (𝒢.obj.map w.op).hom x_U = val := by
              intro Z w val hval
              let S_w := S_cov.pullback w
              have hSw_mem : S_w ∈ Y.smallEtaleTopology Z :=
                Y.smallEtaleTopology.pullback_stable w hS_mem
              apply sub_eq_zero.mp
              refine hSheafEqZero 𝒢 S_w hSw_mem ((𝒢.obj.map w.op).hom x_U - val) ?_
              intro Z' u hu
              have huS : S_cov.arrows (u ≫ w) := hu
              rw [map_sub, sub_eq_zero, ← 𝒢.obj.map_comp_apply, ← op_comp, hx_on_S (u ≫ w) huS]
              apply hRoofEq t (u ≫ w) _ _ (hsec_lvl (u ≫ w) huS)
              rcases hval with ⟨hz, rfl⟩ | ⟨c, l, q_Z, hl_fst, hq_snd, hl_c, rfl⟩
              · left
                refine ⟨fun y ⟨z', hz'⟩ => hz y ?_, map_zero _⟩
                exact ⟨(Fgt_Y.map u).left.base z', hz'⟩
              · right
                refine ⟨c, (Fgt_Y.map u).left ≫ l, u ≫ q_Z, ?_, ?_,
                  fun z' => hl_c ((Fgt_Y.map u).left.base z'), ?_⟩
                · rw [Category.assoc, hl_fst]; rfl
                · exact (congrArg ((Fgt_Y.map u).left ≫ ·) hq_snd).trans
                    (Category.assoc _ _ _).symm
                · exact (ConcreteCategory.congr_hom (𝒢.obj.map_comp q_Z.op u.op) (g_c c)).symm
            refine ⟨x_U, hx_prop, fun x' hx' => ?_⟩
            apply sub_eq_zero.mp
            refine hSheafEqZero 𝒢 S_cov hS_mem (x' - x_U) ?_
            intro Z w hw
            rw [map_sub, sub_eq_zero, hx_on_S w hw]
            exact hx' w (sec_on_S w hw) (hsec_lvl w hw)
          let psi_fun : ∀ U : Y.Etale,
              ↑(𝒥_h.obj.obj (Opposite.op U)) → ↑(𝒢.obj.obj (Opposite.op U)) :=
            fun U t => Classical.choose (hExPsi U t)
          have hpsi_spec : ∀ (U : Y.Etale) (t : ↑(𝒥_h.obj.obj (Opposite.op U)))
              {Z : Y.Etale} (w : Z ⟶ U) (val : ↑(𝒢.obj.obj (Opposite.op Z))),
              IsLevelArrow t w val → (𝒢.obj.map w.op).hom (psi_fun U t) = val :=
            fun U t => (Classical.choose_spec (hExPsi U t)).1
          have hpsi_uniq : ∀ (U : Y.Etale) (t : ↑(𝒥_h.obj.obj (Opposite.op U)))
              (x' : ↑(𝒢.obj.obj (Opposite.op U))),
              (∀ {Z : Y.Etale} (w : Z ⟶ U) (val : ↑(𝒢.obj.obj (Opposite.op Z))),
                IsLevelArrow t w val → (𝒢.obj.map w.op).hom x' = val) →
              x' = psi_fun U t :=
            fun U t x' hx' => (Classical.choose_spec (hExPsi U t)).2 x' hx'
          have hpsi_zero : ∀ U : Y.Etale, psi_fun U 0 = 0 := fun U => by
            symm; apply hpsi_uniq U 0 0
            intro Z w val hval; rw [map_zero]
            have h0_lvl : IsLevelArrow (U := U) 0 w 0 :=
              Or.inl ⟨fun y _ => by rw [map_zero]; rfl, rfl⟩
            exact hRoofEq 0 w 0 val h0_lvl hval
          have hpsi_sY : ∀ c : C_vec, psi_fun E₀ (s_Y c) = g_c c := fun c => by
            let l_id : (Fgt_Y.obj E₀).left ⟶ CategoryTheory.Limits.pullback h_E₀ ι_Y := γ_Y 1
            have hl_fst : l_id ≫ CategoryTheory.Limits.pullback.fst h_E₀ ι_Y =
                (Fgt_Y.map (𝟙 E₀)).left :=
              (hγY_props 1).1
            have hl_snd : (Fgt_Y.map (𝟙 E₀)).left =
                l_id ≫ CategoryTheory.Limits.pullback.snd h_E₀ ι_Y := by
              have hid_E₀ : (Fgt_Y.map (𝟙 E₀)).left = 𝟙 V_Y := rfl
              rw [hid_E₀]; symm
              change γ_Y 1 ≫ CategoryTheory.Limits.pullback.snd h_E₀ ι_Y = 𝟙 V_Y
              rw [(hγY_props 1).2, Category.id_comp]
              apply hpb_Y.hom_ext
              · rw [hv_q 1, ha_one, Category.comp_id, Category.id_comp]
              · rw [hv_ι 1, Category.id_comp]
            have hl_c : ∀ e : ↥(Fgt_Y.obj E₀).left, triv_h E₀ (s_Y c) (l_id.base e) = c := fun e => by
              have h1 := hs_Y_spec c 1 e
              rw [map_one, Units.val_one, Matrix.one_mulVec] at h1
              exact h1
            have hval_id := hpsi_spec E₀ (s_Y c) (𝟙 E₀) (g_c c)
              (Or.inr ⟨c, l_id, 𝟙 E₀, hl_fst, hl_snd, hl_c,
                by rw [op_id, 𝒢.obj.map_id]; rfl⟩)
            simpa only [op_id, 𝒢.obj.map_id, AddCommGrpCat.id_apply] using hval_id
          have hpsi_nat : ∀ {U₁ U₂ : Y.Etale} (u : U₁ ⟶ U₂)
              (t : ↑(𝒥_h.obj.obj (Opposite.op U₂))),
              (𝒢.obj.map u.op).hom (psi_fun U₂ t) =
                psi_fun U₁ ((𝒥_h.obj.map u.op).hom t) := by
            intro U₁ U₂ u t
            let h₁ := (Fgt_Y.obj U₁).hom
            let h₂ := (Fgt_Y.obj U₂).hom
            have : AlgebraicGeometry.Etale h₁ := U₁.prop
            have : AlgebraicGeometry.Etale h₂ := U₂.prop
            let U₁_V := CategoryTheory.Limits.pullback h₁ ι_Y
            let U₂_V := CategoryTheory.Limits.pullback h₂ ι_Y
            let fst₁ := CategoryTheory.Limits.pullback.fst h₁ ι_Y
            let snd₁ := CategoryTheory.Limits.pullback.snd h₁ ι_Y
            let fst₂ := CategoryTheory.Limits.pullback.fst h₂ ι_Y
            let snd₂ := CategoryTheory.Limits.pullback.snd h₂ ι_Y
            let u_V : U₁_V ⟶ U₂_V :=
              CategoryTheory.Limits.pullback.lift (fst₁ ≫ (Fgt_Y.map u).left) snd₁
                (by rw [Category.assoc, CategoryTheory.Over.w (Fgt_Y.map u),
                      CategoryTheory.Limits.pullback.condition])
            have hnat_t : ∀ y₁ : ↥U₁_V, triv_h U₁ ((𝒥_h.obj.map u.op).hom t) y₁ =
                triv_h U₂ t (u_V.base y₁) :=
              hNat_h u u_V (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                (CategoryTheory.Limits.pullback.lift_snd _ _ _) t
            let f₂ := triv_h U₂ t
            have ht_mem : f₂ ∈ Set.range (triv_h U₂) := ⟨t, rfl⟩
            rw [(hSpec_h U₂).2] at ht_mem
            obtain ⟨⟨W₀, hW₀_top, hW₀_zero⟩, _⟩ := ht_mem
            let obj_cov₂ : Unit ⊕ C_vec → Y.Etale := fun idx =>
              match idx with
              | Sum.inl () => AlgebraicGeometry.Scheme.Etale.mk (W₀.ι ≫ h₂)
              | Sum.inr c =>
                  let O_c : U₂_V.Opens := ⟨f₂ ⁻¹' {c}, f₂.isLocallyConstant {c}⟩
                  AlgebraicGeometry.Scheme.Etale.mk (O_c.ι ≫ fst₂ ≫ h₂)
            let mor_cov₂ : ∀ idx : Unit ⊕ C_vec, obj_cov₂ idx ⟶ U₂ := fun idx =>
              match idx with
              | Sum.inl () => CategoryTheory.MorphismProperty.Over.homMk W₀.ι rfl trivial
              | Sum.inr c =>
                  let O_c : U₂_V.Opens := ⟨f₂ ⁻¹' {c}, f₂.isLocallyConstant {c}⟩
