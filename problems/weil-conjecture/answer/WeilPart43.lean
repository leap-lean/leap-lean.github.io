          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (j_B (r + 1)).toRingHom) ≫ p_ιB := by
        dsimp only [p_ιB]
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        congr 1
        exact CommRingCat.hom_ext (RingHom.ext fun b => (hj_B r).2.1 b)
      have hSq : m_ι_V ≫ q_W_r = q_W_succ ≫ m_ι_B := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, hqr_fst, hmV_fst,
            CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hqs_fst]
        · rw [CategoryTheory.Category.assoc, hqr_snd,
            ← CategoryTheory.Category.assoc m_ι_V, hmV_snd, CategoryTheory.Category.assoc,
            hp_j_comm, CategoryTheory.Category.assoc q_W_succ,
            CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc q_W_succ, hqs_snd, CategoryTheory.Category.assoc]
      apply ((htriv_L r).2 W).1
      ext z k
      obtain ⟨y, rfl⟩ := hqr_surj z
      obtain ⟨y_up, rfl⟩ := hmV_surj y
      have hPt : q_W_r.base (m_ι_V.base y_up) = m_ι_B.base (q_W_succ.base y_up) :=
        congrArg (fun g => g.base y_up) hSq
      have hL1 : (((τ_ℰ r ≫ π_ℒ r).hom.app (Opposite.op W)) s_up) =
          ((π_ℒ r).hom.app (Opposite.op W)) (((τ_ℰ r).hom.app (Opposite.op W)) s_up) := rfl
      have hR1 : (((π_ℒ (r + 1) ≫ τ_ℒ r).hom.app (Opposite.op W)) s_up) =
          ((τ_ℒ r).hom.app (Opposite.op W))
            (((π_ℒ (r + 1)).hom.app (Opposite.op W)) s_up) := rfl
      change triv_L r W (((τ_ℰ r ≫ π_ℒ r).hom.app (Opposite.op W)) s_up)
          (q_W_r.base (m_ι_V.base y_up)) k =
        triv_L r W (((π_ℒ (r + 1) ≫ τ_ℒ r).hom.app (Opposite.op W)) s_up)
          (q_W_r.base (m_ι_V.base y_up)) k
      rw [hL1, hR1, hπ_ℒ_spec r W q_W_r hqr_fst hqr_snd _ (m_ι_V.base y_up),
        hτ_ℰ_spec r W m_ι_V hmV_fst hmV_snd s_up y_up, hPt,
        ((htriv_L r).2 W).2.2 _ m_ι_B
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          (q_W_succ.base y_up) k,
        hπ_ℒ_spec (r + 1) W q_W_succ hqs_fst hqs_snd s_up y_up]
      rfl
  · 
    intro r W
    refine ⟨fun s_E y => hι_ℰ_spec r W s_E y,
      fun s_V y k => congrFun (hπ_𝒬_spec r W s_V y) k,
      fun q_W hq_fst hq_snd s_E y k => congrFun (hπ_ℒ_spec r W q_W hq_fst hq_snd s_E y) k⟩

theorem weil_mid_dev_geom_triv_const_field_galois_factor (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F) (K : ℕ) (Λ : Type) [CommRing Λ] :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∀ (a₀ : F) (_ha₀ : a₀ ∉ S_aff)
      (B_r L_r : Type u)
      [CommRing B_r] [IsDomain B_r] [Field L_r]
      [Algebra F B_r] [Algebra (Polynomial F) B_r] [Algebra R₀ B_r]
      [Algebra F L_r] [Algebra (Polynomial F) L_r] [Algebra (RatFunc F) L_r]
      [Algebra B_r L_r] [Algebra R₀ L_r]
      [IsScalarTower F (Polynomial F) B_r] [IsScalarTower (Polynomial F) R₀ B_r]
      [IsScalarTower F (RatFunc F) L_r] [IsScalarTower (Polynomial F) (RatFunc F) L_r]
      [IsScalarTower (Polynomial F) B_r L_r] [IsScalarTower R₀ B_r L_r]
      [Module.Finite R₀ B_r] [Algebra.Etale R₀ B_r]
      [IsFractionRing B_r L_r] [IsIntegralClosure B_r R₀ L_r]
      [FiniteDimensional (RatFunc F) L_r] [IsGalois (RatFunc F) L_r]
      (_hQ_u_r : ∃ Q_u : Ideal B_r, Q_u.IsMaximal ∧
        Ideal.comap (algebraMap (Polynomial F) B_r) Q_u =
          Ideal.span {Polynomial.X - Polynomial.C a₀} ∧
        ∃ σ_u : B_r ≃ₐ[R₀] B_r, ∀ b : B_r, σ_u.symm b - b ^ Nat.card F ∈ Q_u)
      (ρ_𝒢 : (B_r ≃ₐ[R₀] B_r) →* (Matrix (Fin K) (Fin K) Λ)ˣ)
      (_hGeom_triv : ∀ τ : B_r ≃ₐ[R₀] B_r, (∀ x : B_r, IsIntegral F x → τ x = x) → ρ_𝒢 τ = 1),
      ∃ (k : Type u) (_ : Finite k) (_ : Field k) (_ : Algebra F k)
        (_ : Module.Finite F k) (_ : Algebra.Etale F k)
        (ι_k : k →ₐ[F] B_r)
        (res_k : (B_r ≃ₐ[R₀] B_r) →* (k ≃ₐ[F] k))
        (ρ_bar : (k ≃ₐ[F] k) →* (Matrix (Fin K) (Fin K) Λ)ˣ),
        Function.Surjective res_k ∧
        (∀ (σ : B_r ≃ₐ[R₀] B_r) (c : k), σ (ι_k c) = ι_k (res_k σ c)) ∧
        (∀ σ : B_r ≃ₐ[R₀] B_r, ρ_bar (res_k σ) = ρ_𝒢 σ) ∧
        let R₀_k := Localization.Away
          ((∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)).map (algebraMap F k))
        ∃ (_ : IsDomain R₀_k) (_ : Algebra R₀ R₀_k) (_ : Algebra R₀_k B_r)
          (_ : IsScalarTower R₀ R₀_k B_r) (_ : Module.Finite R₀_k B_r) (_ : Algebra.Etale R₀_k B_r)
          (e_Rk : TensorProduct F R₀ k ≃+* R₀_k)
          (m_gal : ℕ) (equiv_Γ : Fin m_gal ≃ (B_r ≃ₐ[R₀_k] B_r))
          (e_gal : Fin m_gal → TensorProduct R₀_k B_r B_r),
          Function.Injective (algebraMap R₀_k B_r) ∧
          (∀ c : k, algebraMap R₀_k B_r (algebraMap k R₀_k c) = ι_k c) ∧
          (∀ r₀ : R₀, e_Rk (TensorProduct.tmul F r₀ 1) = algebraMap R₀ R₀_k r₀) ∧
          (∀ c : k, e_Rk (TensorProduct.tmul F 1 c) = algebraMap k R₀_k c) ∧
          (∀ i : Fin m_gal, e_gal i * e_gal i = e_gal i) ∧
          (∀ i j : Fin m_gal, i ≠ j → e_gal i * e_gal j = 0) ∧
          (∑ i : Fin m_gal, e_gal i) = 1 ∧
          (∀ i j : Fin m_gal,
            Algebra.TensorProduct.lift (AlgHom.id B_r B_r) (equiv_Γ j).symm.toAlgHom
              (fun _ _ => mul_comm _ _) (e_gal i) = if i = j then 1 else 0) ∧
          (∀ (i : Fin m_gal) (z : TensorProduct R₀_k B_r B_r),
            z * e_gal i = TensorProduct.tmul R₀_k
              (Algebra.TensorProduct.lift (AlgHom.id B_r B_r) (equiv_Γ i).symm.toAlgHom
                (fun _ _ => mul_comm _ _) z) (1 : B_r) * e_gal i) ∧
          (∀ τ : B_r ≃ₐ[R₀_k] B_r,
            ∃ σ : B_r ≃ₐ[R₀] B_r, (∀ b : B_r, σ b = τ b) ∧ ρ_𝒢 σ = 1) :=
by
  intro R₀ a₀ _ha₀ B_r L_r _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _hQ_u_r ρ_𝒢 _hGeom_triv
  classical
  
  let Δ_aff : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s)
  have hΔ_aff_monic : Δ_aff.Monic :=
    Polynomial.monic_prod_of_monic S_aff _ (fun s _ => Polynomial.monic_X_sub_C s)
  let _ : IsScalarTower F R₀ B_r := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply F (Polynomial F) B_r,
      IsScalarTower.algebraMap_apply (Polynomial F) R₀ B_r,
      ← IsScalarTower.algebraMap_apply F (Polynomial F) R₀]
  let _ : IsScalarTower F (Polynomial F) L_r := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply F (RatFunc F) L_r,
      IsScalarTower.algebraMap_apply F (Polynomial F) (RatFunc F),
      ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r]
  let _ : IsScalarTower F B_r L_r := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply F (Polynomial F) L_r,
      IsScalarTower.algebraMap_apply (Polynomial F) B_r L_r,
      ← IsScalarTower.algebraMap_apply F (Polynomial F) B_r]
  let _ : IsScalarTower F R₀ L_r := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply F B_r L_r,
      IsScalarTower.algebraMap_apply F R₀ B_r,
      ← IsScalarTower.algebraMap_apply R₀ B_r L_r]

  
  let F_const : IntermediateField F L_r := algebraicClosure F L_r
  let k : Type u := ↥F_const
  let instFld_k : Field k := inferInstance
  let instAlg_Fk : Algebra F k := inferInstance
  let _ : IsIntegralClosure k F L_r := algebraicClosure.isIntegralClosure F L_r
  let _ : Algebra.IsIntegral F k := IsIntegralClosure.isIntegral_algebra F L_r
  have hk_int : ∀ c : k, _root_.IsIntegral F (algebraMap k L_r c) :=
    fun c => (IsIntegralClosure.isIntegral_iff (A := k)).mpr ⟨c, rfl⟩
  let x₀ : L_r := algebraMap (RatFunc F) L_r RatFunc.X
  let φ₀ : Polynomial k →ₐ[k] L_r := Polynomial.aeval x₀
  have hφ₀_inj : Function.Injective φ₀ := by
    rw [injective_iff_map_eq_zero]
    intro Q hQ0
    by_contra hQ_ne
    have hx₀_alg : IsAlgebraic k x₀ := ⟨Q, hQ_ne, hQ0⟩
    have hx₀_int_k : _root_.IsIntegral k x₀ := isAlgebraic_iff_isIntegral.mp hx₀_alg
    have hx₀_int_F : _root_.IsIntegral F x₀ := isIntegral_trans x₀ hx₀_int_k
    have hX_int_F : _root_.IsIntegral F (RatFunc.X : RatFunc F) :=
      (isIntegral_algHom_iff (IsScalarTower.toAlgHom F (RatFunc F) L_r)
        (algebraMap (RatFunc F) L_r).injective).mp hx₀_int_F
    obtain ⟨P, hP_ne, hP_eval⟩ := isAlgebraic_iff_isIntegral.mpr hX_int_F
    rw [← RatFunc.algebraMap_X, Polynomial.aeval_algebraMap_apply,
      Polynomial.aeval_X_left_apply] at hP_eval
    exact hP_ne (IsFractionRing.injective (Polynomial F) (RatFunc F)
      (hP_eval.trans (map_zero _).symm))
  have h_aeval_F : ∀ f : Polynomial F, Polynomial.aeval x₀ f = algebraMap (Polynomial F) L_r f := by
    intro f
    have heq : (Polynomial.aeval x₀ : Polynomial F →ₐ[F] L_r) =
        IsScalarTower.toAlgHom F (Polynomial F) L_r := by
      apply Polynomial.algHom_ext
      simp only [Polynomial.aeval_X, IsScalarTower.toAlgHom_apply, x₀, ← RatFunc.algebraMap_X,
        IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r]
    exact AlgHom.congr_fun heq f
  let ι_b := Module.Basis.ofVectorSpaceIndex F k
  let b_k : Module.Basis ι_b F k := Module.Basis.ofVectorSpace F k
  have hb_lin : LinearIndependent (RatFunc F) (fun i : ι_b => algebraMap k L_r (b_k i)) := by
    rw [linearIndependent_iff']
    intro s g hsum i₀ hi₀
    obtain ⟨d, hd⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors (Polynomial F)) s g
    let p : ι_b → Polynomial F := fun i =>
      if hi : i ∈ s then Classical.choose (hd i hi) else 0
    have hp : ∀ i (hi : i ∈ s),
        algebraMap (Polynomial F) (RatFunc F) (p i) =
          algebraMap (Polynomial F) (RatFunc F) (d : Polynomial F) * g i := by
      intro i hi
      simp only [p, hi, ↓reduceDIte]
      exact (Classical.choose_spec (hd i hi)).trans (Algebra.smul_def (d : Polynomial F) (g i))
    let Q : Polynomial k := ∑ i ∈ s, (p i).map (algebraMap F k) * Polynomial.C (b_k i)
    have hφ₀_Q : φ₀ Q = 0 := by
      dsimp only [Q, φ₀]
      rw [map_sum]
      have hterm : ∀ i ∈ s,
          Polynomial.aeval x₀ ((p i).map (algebraMap F k) * Polynomial.C (b_k i)) =
            algebraMap (Polynomial F) L_r (d : Polynomial F) *
              (g i • algebraMap k L_r (b_k i)) := by
        intro i hi
        rw [map_mul, Polynomial.aeval_map_algebraMap k x₀ (p i), h_aeval_F (p i),
          Polynomial.aeval_C, IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r (p i),
          hp i hi, map_mul, ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r,
          Algebra.smul_def, mul_assoc]
      rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum, hsum, mul_zero]
    have hQ_zero : Q = 0 := hφ₀_inj (hφ₀_Q.trans (map_zero φ₀).symm)
    have hp_zero : p i₀ = 0 := by
      ext n
      rw [Polynomial.coeff_zero]
      have hcoeff : Q.coeff n = ∑ i ∈ s, ((p i).coeff n) • b_k i := by
        dsimp only [Q]
        rw [Polynomial.finsetSum_coeff]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Polynomial.coeff_mul_C, Polynomial.coeff_map, ← Algebra.smul_def]
      rw [hQ_zero, Polynomial.coeff_zero] at hcoeff
      exact linearIndependent_iff'.mp b_k.linearIndependent s
        (fun i => (p i).coeff n) hcoeff.symm i₀ hi₀
    have hd_ne : (d : Polynomial F) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp d.2
    have hd_rf_ne : algebraMap (Polynomial F) (RatFunc F) (d : Polynomial F) ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective (Polynomial F) (RatFunc F))).mpr hd_ne
    have hmul0 := hp i₀ hi₀
    rw [hp_zero, map_zero] at hmul0
    exact (mul_eq_zero.mp hmul0.symm).resolve_left hd_rf_ne
  let _ : Finite ι_b := hb_lin.finite
  have hModFin_Fk : Module.Finite F k := Module.Finite.of_basis b_k
  let _ : Module.Finite F k := hModFin_Fk
  have hFin_k : Finite k := Module.finite_of_finite F
  let _ : Finite k := hFin_k
  let _ : Fintype F := Fintype.ofFinite F
  let _ : Fintype k := Fintype.ofFinite k
  let _ : PerfectField F := PerfectField.ofFinite
  let _ : Algebra.IsAlgebraic F k := Algebra.IsAlgebraic.of_finite F k
  let _ : Algebra.IsSeparable F k := Algebra.IsAlgebraic.isSeparable_of_perfectField
  let _ : Algebra.FormallyEtale F k := Algebra.FormallyEtale.of_isSeparable F k
  let _ : Algebra.FinitePresentation F k :=
    (Algebra.FinitePresentation.of_finiteType (R := F) (A := k)).mp inferInstance
  have hEt_Fk : Algebra.Etale F k := Algebra.Etale.mk
  let _ : Algebra.Etale F k := hEt_Fk

  let ι_K : RatFunc k →ₐ[k] L_r := IsFractionRing.liftAlgHom (K := RatFunc k) hφ₀_inj
  let _ : Algebra (Polynomial k) L_r := φ₀.toRingHom.toAlgebra
  let _ : Algebra (RatFunc k) L_r := ι_K.toRingHom.toAlgebra
  let _ : IsScalarTower k (Polynomial k) L_r :=
    IsScalarTower.of_algebraMap_eq fun c => (φ₀.commutes c).symm
  let _ : IsScalarTower k (RatFunc k) L_r :=
    IsScalarTower.of_algebraMap_eq fun c => (ι_K.commutes c).symm
  let _ : IsScalarTower (Polynomial k) (RatFunc k) L_r :=
    IsScalarTower.of_algebraMap_eq fun p =>
      ((IsFractionRing.liftAlgHom_apply (K := RatFunc k) hφ₀_inj
        (algebraMap (Polynomial k) (RatFunc k) p)).trans
        (IsFractionRing.lift_algebraMap hφ₀_inj p)).symm
  have hX_eq : algebraMap (RatFunc k) L_r RatFunc.X = algebraMap (RatFunc F) L_r RatFunc.X := by
    rw [← RatFunc.algebraMap_X, ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_r]
    exact Polynomial.aeval_X x₀
  let ψ_FK : Polynomial F →+* RatFunc k :=
    (algebraMap (Polynomial k) (RatFunc k)).comp (Polynomial.mapRingHom (algebraMap F k))
  have hψ_inj : Function.Injective ψ_FK :=
    (IsFractionRing.injective (Polynomial k) (RatFunc k)).comp
      (Polynomial.map_injective _ (algebraMap F k).injective)
  let j_FK : RatFunc F →+* RatFunc k := IsFractionRing.lift hψ_inj
  let _ : Algebra (RatFunc F) (RatFunc k) := j_FK.toAlgebra
  let _ : IsScalarTower (RatFunc F) (RatFunc k) L_r := by
    apply IsScalarTower.of_algebraMap_eq'
    apply IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial F))
    apply Polynomial.ringHom_ext'
    · ext c
      symm
      change algebraMap (RatFunc k) L_r
          (j_FK (algebraMap (Polynomial F) (RatFunc F) (Polynomial.C c))) =
        algebraMap (RatFunc F) L_r (algebraMap (Polynomial F) (RatFunc F) (Polynomial.C c))
      rw [IsFractionRing.lift_algebraMap hψ_inj]
      dsimp only [ψ_FK]
      rw [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
        ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_r,
        ← Polynomial.algebraMap_eq,
        ← IsScalarTower.algebraMap_apply k (Polynomial k) L_r,
        ← IsScalarTower.algebraMap_apply F k L_r,
        ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r,
        ← Polynomial.algebraMap_eq,
        ← IsScalarTower.algebraMap_apply F (Polynomial F) L_r]
    · symm
      change algebraMap (RatFunc k) L_r
          (j_FK (algebraMap (Polynomial F) (RatFunc F) Polynomial.X)) =
        algebraMap (RatFunc F) L_r (algebraMap (Polynomial F) (RatFunc F) Polynomial.X)
      rw [IsFractionRing.lift_algebraMap hψ_inj]
      dsimp only [ψ_FK]
      rw [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X,
        RatFunc.algebraMap_X, RatFunc.algebraMap_X, hX_eq]
  let _ : FiniteDimensional (RatFunc k) L_r :=
    Module.Finite.of_restrictScalars_finite (RatFunc F) (RatFunc k) L_r
  let _ : IsGalois (RatFunc k) L_r :=
    IsGalois.tower_top_of_isGalois (RatFunc F) (RatFunc k) L_r

  
  have hk_lift : ∀ c : k, ∃ b : B_r, algebraMap B_r L_r b = algebraMap k L_r c :=
    fun c => (IsIntegralClosure.isIntegral_iff (R := R₀) (A := B_r) (B := L_r)).mp
      (_root_.IsIntegral.tower_top (R := F) (A := R₀) (hk_int c))
  let ι_fun : k → B_r := fun c => Classical.choose (hk_lift c)
  have hι_fun : ∀ c : k, algebraMap B_r L_r (ι_fun c) = algebraMap k L_r c :=
    fun c => Classical.choose_spec (hk_lift c)
  let ι_k : k →ₐ[F] B_r :=
    { toFun := ι_fun
      map_one' := IsFractionRing.injective B_r L_r (by rw [hι_fun, map_one, map_one])
      map_mul' := fun x y => IsFractionRing.injective B_r L_r
        (by rw [hι_fun, map_mul, map_mul, hι_fun, hι_fun])
      map_zero' := IsFractionRing.injective B_r L_r (by rw [hι_fun, map_zero, map_zero])
      map_add' := fun x y => IsFractionRing.injective B_r L_r
        (by rw [hι_fun, map_add, map_add, hι_fun, hι_fun])
      commutes' := fun a => IsFractionRing.injective B_r L_r (by
        rw [hι_fun, ← IsScalarTower.algebraMap_apply F k L_r,
          ← IsScalarTower.algebraMap_apply F B_r L_r]) }
  have hι_k_L : ∀ c : k, algebraMap B_r L_r (ι_k c) = algebraMap k L_r c := hι_fun
  have hRange_ιk : ∀ b : B_r, _root_.IsIntegral F b ↔ ∃ c : k, ι_k c = b := by
    intro b
    constructor
    · intro hb
      have hy : _root_.IsIntegral F (algebraMap B_r L_r b) :=
        hb.map (IsScalarTower.toAlgHom F B_r L_r)
      obtain ⟨c, hc⟩ := (IsIntegralClosure.isIntegral_iff (R := F) (A := k) (B := L_r)).mp hy
      exact ⟨c, IsFractionRing.injective B_r L_r ((hι_k_L c).trans hc)⟩
    · rintro ⟨c, rfl⟩
      exact (Algebra.IsIntegral.isIntegral (R := F) c).map ι_k

  
  have hσ_map_k : ∀ (σ : B_r ≃ₐ[R₀] B_r) (c : k), ∃ c' : k, ι_k c' = σ (ι_k c) := by
    intro σ c
    apply (hRange_ιk (σ (ι_k c))).mp
    exact ((Algebra.IsIntegral.isIntegral (R := F) c).map ι_k).map
      (σ.restrictScalars F).toAlgHom
  let g_fun : (B_r ≃ₐ[R₀] B_r) → k → k :=
    fun σ c => Classical.choose (hσ_map_k σ c)
  have hg_fun : ∀ (σ : B_r ≃ₐ[R₀] B_r) (c : k), ι_k (g_fun σ c) = σ (ι_k c) :=
    fun σ c => Classical.choose_spec (hσ_map_k σ c)
  have hι_k_inj : Function.Injective ι_k := ι_k.injective
  let res_k_equiv : (B_r ≃ₐ[R₀] B_r) → (k ≃ₐ[F] k) := fun σ =>
    { toFun := g_fun σ
      invFun := g_fun σ.symm
      left_inv := fun c => hι_k_inj (by rw [hg_fun, hg_fun, σ.symm_apply_apply])
      right_inv := fun c => hι_k_inj (by rw [hg_fun, hg_fun, σ.apply_symm_apply])
      map_mul' := fun x y => hι_k_inj (by rw [hg_fun, map_mul, map_mul, map_mul, hg_fun, hg_fun])
      map_add' := fun x y => hι_k_inj (by rw [hg_fun, map_add, map_add, map_add, hg_fun, hg_fun])
      commutes' := fun a => hι_k_inj (by
        rw [hg_fun, ι_k.commutes, IsScalarTower.algebraMap_apply F R₀ B_r, σ.commutes]) }
  let res_k : (B_r ≃ₐ[R₀] B_r) →* (k ≃ₐ[F] k) :=
    { toFun := res_k_equiv
      map_one' := by
        apply AlgEquiv.ext
        intro c
        exact hι_k_inj (by change ι_k (g_fun 1 c) = ι_k c; rw [hg_fun]; rfl)
      map_mul' := fun σ₁ σ₂ => by
        apply AlgEquiv.ext
        intro c
        exact hι_k_inj (by
          change ι_k (g_fun (σ₁ * σ₂) c) = ι_k (g_fun σ₁ (g_fun σ₂ c))
          rw [hg_fun, AlgEquiv.mul_apply, ← hg_fun σ₂ c, ← hg_fun σ₁]) }
  have hι_k_equiv : ∀ (σ : B_r ≃ₐ[R₀] B_r) (c : k), σ (ι_k c) = ι_k (res_k σ c) :=
    fun σ c => (hg_fun σ c).symm

  obtain ⟨Q_u, hQ_max, _, σ_u, hσ_u⟩ := _hQ_u_r
  have h1_not_Qu : (1 : B_r) ∉ Q_u := Q_u.ne_top_iff_one.mp hQ_max.ne_top
  let γ₀ : k ≃ₐ[F] k := res_k σ_u.symm
  have hγ₀_frob : γ₀ = FiniteField.frobeniusAlgEquivOfAlgebraic F k := by
    apply AlgEquiv.ext
    intro c
    have hdiff_Qu : ι_k (γ₀ c - c ^ Nat.card F) ∈ Q_u := by
      rw [map_sub, map_pow, ← hι_k_equiv σ_u.symm c]
      exact hσ_u (ι_k c)
    have hdiff_zero : γ₀ c - c ^ Nat.card F = 0 := by
      by_contra hne
      have h1 : (1 : B_r) ∈ Q_u := by
        have hmul : ι_k (γ₀ c - c ^ Nat.card F) * ι_k ((γ₀ c - c ^ Nat.card F)⁻¹) ∈ Q_u :=
          Q_u.mul_mem_right _ hdiff_Qu
        rwa [← map_mul, mul_inv_cancel₀ hne, map_one] at hmul
      exact h1_not_Qu h1
    rw [sub_eq_zero.mp hdiff_zero, FiniteField.frobeniusAlgEquivOfAlgebraic_apply,
      Nat.card_eq_fintype_card]
  let _ : IsGalois F k := GaloisField.instIsGaloisOfFinite
  have hcard_zpow : Nat.card ↥(Subgroup.zpowers γ₀) = Nat.card (k ≃ₐ[F] k) := by
    rw [Nat.card_zpowers, hγ₀_frob, FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic,
      IsGalois.card_aut_eq_finrank]
  have hzpow_top : Subgroup.zpowers γ₀ = ⊤ := Subgroup.eq_top_of_card_eq _ hcard_zpow
  have hres_surj : Function.Surjective res_k := by
    intro γ
    have hmem : γ ∈ Subgroup.zpowers γ₀ := by
      rw [hzpow_top]
      exact Subgroup.mem_top γ
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hmem
    exact ⟨σ_u.symm ^ n, map_zpow res_k σ_u.symm n⟩

  have hρ_eq_of_res : ∀ σ₁ σ₂ : B_r ≃ₐ[R₀] B_r, res_k σ₁ = res_k σ₂ → ρ_𝒢 σ₁ = ρ_𝒢 σ₂ := by
    intro σ₁ σ₂ h_eq
    let τ : B_r ≃ₐ[R₀] B_r := σ₁ * σ₂⁻¹
    have hres_τ : res_k τ = 1 := by
      dsimp [τ]
      rw [map_mul, map_inv, h_eq, mul_inv_cancel]
    have hτ_triv : ρ_𝒢 τ = 1 := by
      apply _hGeom_triv τ
      intro x hx
      obtain ⟨c, rfl⟩ := (hRange_ιk x).mp hx
      rw [hι_k_equiv τ c, hres_τ, AlgEquiv.one_apply]
    dsimp [τ] at hτ_triv
    rw [map_mul, map_inv] at hτ_triv
    exact mul_inv_eq_one.mp hτ_triv
  let s_inv : (k ≃ₐ[F] k) → (B_r ≃ₐ[R₀] B_r) := Function.surjInv hres_surj
  have hs_inv : ∀ γ : k ≃ₐ[F] k, res_k (s_inv γ) = γ := Function.rightInverse_surjInv hres_surj
  let ρ_bar : (k ≃ₐ[F] k) →* (Matrix (Fin K) (Fin K) Λ)ˣ :=
    { toFun := fun γ => ρ_𝒢 (s_inv γ)
      map_one' := (hρ_eq_of_res (s_inv 1) 1 (by rw [hs_inv, map_one])).trans ρ_𝒢.map_one
      map_mul' := fun γ₁ γ₂ =>
        (hρ_eq_of_res (s_inv (γ₁ * γ₂)) (s_inv γ₁ * s_inv γ₂)
          (by rw [hs_inv, map_mul, hs_inv, hs_inv])).trans (ρ_𝒢.map_mul _ _) }
  have hρ_bar_eq : ∀ σ : B_r ≃ₐ[R₀] B_r, ρ_bar (res_k σ) = ρ_𝒢 σ :=
    fun σ => hρ_eq_of_res (s_inv (res_k σ)) σ (hs_inv (res_k σ))

  
  refine ⟨k, hFin_k, instFld_k, instAlg_Fk, hModFin_Fk, hEt_Fk,
    ι_k, res_k, ρ_bar, hres_surj, hι_k_equiv, hρ_bar_eq, ?_⟩
  intro R₀_k
  let Δ_k : Polynomial k := Δ_aff.map (algebraMap F k)
  have hΔ_k_monic : Δ_k.Monic := hΔ_aff_monic.map (algebraMap F k)
  have hΔ_k_ne : Δ_k ≠ 0 := hΔ_k_monic.ne_zero
  have hDom_Rk : IsDomain R₀_k :=
    IsLocalization.isDomain_localization
      (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hΔ_k_ne))
  let _ : IsDomain R₀_k := hDom_Rk

  have hΔ_k_rf_ne : algebraMap (Polynomial k) (RatFunc k) Δ_k ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective (Polynomial k) (RatFunc k))).mpr hΔ_k_ne
  have hΔ_k_rf_unit : IsUnit (algebraMap (Polynomial k) (RatFunc k) Δ_k) :=
    IsUnit.mk0 _ hΔ_k_rf_ne
  let j_Rk_RFk : R₀_k →+* RatFunc k := IsLocalization.Away.lift Δ_k hΔ_k_rf_unit
  let _ : Algebra R₀_k (RatFunc k) := j_Rk_RFk.toAlgebra
  let _ : IsScalarTower (Polynomial k) R₀_k (RatFunc k) :=
    IsScalarTower.of_algebraMap_eq fun p =>
      (IsLocalization.Away.lift_eq Δ_k hΔ_k_rf_unit p).symm
  let _ : IsFractionRing R₀_k (RatFunc k) :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization
      (Submonoid.powers Δ_k) R₀_k (RatFunc k)
  let _ : Algebra R₀_k L_r :=
    ((algebraMap (RatFunc k) L_r).comp (algebraMap R₀_k (RatFunc k))).toAlgebra
  let _ : IsScalarTower R₀_k (RatFunc k) L_r := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let _ : IsScalarTower (Polynomial k) R₀_k L_r := by
    refine IsScalarTower.of_algebraMap_eq fun p => ?_
    rw [IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_r,
      IsScalarTower.algebraMap_apply (Polynomial k) R₀_k (RatFunc k),
      ← IsScalarTower.algebraMap_apply R₀_k (RatFunc k) L_r]

  
  let ψ_R₀ : Polynomial F →+* R₀_k :=
    (algebraMap (Polynomial k) R₀_k).comp (Polynomial.mapRingHom (algebraMap F k))
  have hψ_R₀_unit : IsUnit (ψ_R₀ Δ_aff) :=
    IsLocalization.Away.algebraMap_isUnit (S := R₀_k) Δ_k
  let j_R₀_Rk : R₀ →+* R₀_k := IsLocalization.Away.lift Δ_aff hψ_R₀_unit
  let instAlg_R₀_Rk : Algebra R₀ R₀_k := j_R₀_Rk.toAlgebra
  let _ : Algebra R₀ R₀_k := instAlg_R₀_Rk
  have hj_R₀_Rk_eq : ∀ p : Polynomial F,
      algebraMap R₀ R₀_k (algebraMap (Polynomial F) R₀ p) =
        algebraMap (Polynomial k) R₀_k (p.map (algebraMap F k)) :=
    fun p => IsLocalization.Away.lift_eq Δ_aff hψ_R₀_unit p
  let _ : IsScalarTower F R₀ R₀_k := by
    refine IsScalarTower.of_algebraMap_eq fun a => ?_
    have ha1 : algebraMap F R₀ a = algebraMap (Polynomial F) R₀ (Polynomial.C a) :=
      IsScalarTower.algebraMap_apply F (Polynomial F) R₀ a
    have ha2 : algebraMap F R₀_k a =
        algebraMap (Polynomial k) R₀_k (Polynomial.C (algebraMap F k a)) :=
      (IsScalarTower.algebraMap_apply F k R₀_k a).trans
        (IsScalarTower.algebraMap_apply k (Polynomial k) R₀_k (algebraMap F k a))
    rw [ha1, hj_R₀_Rk_eq, Polynomial.map_C, ← ha2]

  
  let x_B : B_r := algebraMap (Polynomial F) B_r Polynomial.X
  let θ_kX : Polynomial k →+* B_r := Polynomial.eval₂RingHom ι_k.toRingHom x_B
  have hθ_comp : θ_kX.comp (Polynomial.mapRingHom (algebraMap F k)) =
      algebraMap (Polynomial F) B_r := by
    apply Polynomial.ringHom_ext'
    · ext a
      change Polynomial.eval₂ ι_k.toRingHom x_B ((Polynomial.C a).map (algebraMap F k)) =
        algebraMap (Polynomial F) B_r (Polynomial.C a)
      rw [Polynomial.map_C, Polynomial.eval₂_C]
      change ι_k (algebraMap F k a) = algebraMap (Polynomial F) B_r (Polynomial.C a)
      rw [ι_k.commutes]
      exact IsScalarTower.algebraMap_apply F (Polynomial F) B_r a
    · change Polynomial.eval₂ ι_k.toRingHom x_B (Polynomial.X.map (algebraMap F k)) = x_B
      rw [Polynomial.map_X, Polynomial.eval₂_X]
  have hθ_map : ∀ p : Polynomial F,
      θ_kX (p.map (algebraMap F k)) = algebraMap R₀ B_r (algebraMap (Polynomial F) R₀ p) := by
    intro p
    have h1 := congrFun (congrArg DFunLike.coe hθ_comp) p
    simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom] at h1
    rw [h1, IsScalarTower.algebraMap_apply (Polynomial F) R₀ B_r]
  have hθ_Δ_unit : IsUnit (θ_kX Δ_k) := by
    change IsUnit (θ_kX (Δ_aff.map (algebraMap F k)))
    rw [hθ_map Δ_aff]
    exact (IsLocalization.Away.algebraMap_isUnit (S := R₀) Δ_aff).map (algebraMap R₀ B_r)
  let j_Rk_Br : R₀_k →+* B_r := IsLocalization.Away.lift Δ_k hθ_Δ_unit
  let instAlg_Rk_Br : Algebra R₀_k B_r := j_Rk_Br.toAlgebra
  let _ : Algebra R₀_k B_r := instAlg_Rk_Br
  have hj_Rk_Br_eq : ∀ q : Polynomial k,
      algebraMap R₀_k B_r (algebraMap (Polynomial k) R₀_k q) = θ_kX q :=
    fun q => IsLocalization.Away.lift_eq Δ_k hθ_Δ_unit q
  have hι_k_comp : ∀ c : k, algebraMap R₀_k B_r (algebraMap k R₀_k c) = ι_k c := by
    intro c
    have hc1 : algebraMap k R₀_k c = algebraMap (Polynomial k) R₀_k (Polynomial.C c) :=
      IsScalarTower.algebraMap_apply k (Polynomial k) R₀_k c
    rw [hc1, hj_Rk_Br_eq]
    exact Polynomial.eval₂_C _ _
  have hST_R₀_Rk_Br : IsScalarTower R₀ R₀_k B_r := by
    apply IsScalarTower.of_algebraMap_eq'
    apply IsLocalization.ringHom_ext (Submonoid.powers Δ_aff)
    refine RingHom.ext fun p => ?_
    simp only [RingHom.comp_apply, hj_R₀_Rk_eq, hj_Rk_Br_eq]
    exact (hθ_map p).symm
  let _ : IsScalarTower R₀ R₀_k B_r := hST_R₀_Rk_Br
  let _ : IsScalarTower R₀_k B_r L_r := by
    apply IsScalarTower.of_algebraMap_eq'
    apply IsLocalization.ringHom_ext (Submonoid.powers Δ_k)
    apply Polynomial.ringHom_ext'
    · ext c
      symm
      change algebraMap B_r L_r
          (algebraMap R₀_k B_r (algebraMap (Polynomial k) R₀_k (Polynomial.C c))) =
        algebraMap R₀_k L_r (algebraMap (Polynomial k) R₀_k (Polynomial.C c))
      rw [hj_Rk_Br_eq]
      change algebraMap B_r L_r (Polynomial.eval₂ ι_k.toRingHom x_B (Polynomial.C c)) = _
      rw [Polynomial.eval₂_C]
      change algebraMap B_r L_r (ι_k c) = _
      rw [hι_k_L c, ← IsScalarTower.algebraMap_apply (Polynomial k) R₀_k L_r]
      exact IsScalarTower.algebraMap_apply k (Polynomial k) L_r c
    · symm
      change algebraMap B_r L_r
          (algebraMap R₀_k B_r (algebraMap (Polynomial k) R₀_k Polynomial.X)) =
        algebraMap R₀_k L_r (algebraMap (Polynomial k) R₀_k Polynomial.X)
      rw [hj_Rk_Br_eq]
      change algebraMap B_r L_r (Polynomial.eval₂ ι_k.toRingHom x_B Polynomial.X) = _
      rw [Polynomial.eval₂_X]
      dsimp only [x_B]
      rw [← IsScalarTower.algebraMap_apply (Polynomial F) B_r L_r,
        IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r,
        RatFunc.algebraMap_X, ← hX_eq, ← RatFunc.algebraMap_X,
        ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_r,
        ← IsScalarTower.algebraMap_apply (Polynomial k) R₀_k L_r]
  let _ : IsScalarTower R₀ R₀_k L_r := by
    refine IsScalarTower.of_algebraMap_eq fun r₀ => ?_
    rw [IsScalarTower.algebraMap_apply R₀ B_r L_r,
      IsScalarTower.algebraMap_apply R₀ R₀_k B_r,
      ← IsScalarTower.algebraMap_apply R₀_k B_r L_r]

  
  let Φ : TensorProduct F R₀ k →ₐ[R₀] R₀_k :=
    Algebra.TensorProduct.lift (Algebra.ofId R₀ R₀_k)
      (IsScalarTower.toAlgHom F k R₀_k) (fun _ _ => mul_comm _ _)
  have hΦ_tmul : ∀ (r₀ : R₀) (c : k),
      Φ (TensorProduct.tmul F r₀ c) = algebraMap R₀ R₀_k r₀ * algebraMap k R₀_k c :=
    fun r₀ c => Algebra.TensorProduct.lift_tmul _ _ _ r₀ c
  let x_T : TensorProduct F R₀ k :=
    TensorProduct.tmul F (algebraMap (Polynomial F) R₀ Polynomial.X) 1
  let ψ₀ : Polynomial k →+* TensorProduct F R₀ k :=
    Polynomial.eval₂RingHom
      (Algebra.TensorProduct.includeRight (R := F) (A := R₀) (B := k)).toRingHom x_T
  have hψ₀_comp : ψ₀.comp (Polynomial.mapRingHom (algebraMap F k)) =
      (Algebra.TensorProduct.includeLeftRingHom (R := F) (A := R₀) (B := k)).comp
        (algebraMap (Polynomial F) R₀) := by
    apply Polynomial.ringHom_ext'
    · ext a
      simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C]
      change Polynomial.eval₂
          (Algebra.TensorProduct.includeRight (R := F) (A := R₀) (B := k)).toRingHom x_T
          (Polynomial.C (algebraMap F k a)) =
        TensorProduct.tmul F (algebraMap (Polynomial F) R₀ (Polynomial.C a)) (1 : k)
      rw [Polynomial.eval₂_C]
      change TensorProduct.tmul F (1 : R₀) (algebraMap F k a) = _
      have ha_R₀ : algebraMap F R₀ a = algebraMap (Polynomial F) R₀ (Polynomial.C a) :=
        IsScalarTower.algebraMap_apply F (Polynomial F) R₀ a
      rw [Algebra.algebraMap_eq_smul_one a,
        ← TensorProduct.smul_tmul a (1 : R₀) (1 : k),
        ← Algebra.algebraMap_eq_smul_one a, ha_R₀]
    · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X]
      exact Polynomial.eval₂_X _ x_T
  have hψ₀_map : ∀ p : Polynomial F,
      ψ₀ (p.map (algebraMap F k)) =
        TensorProduct.tmul F (algebraMap (Polynomial F) R₀ p) (1 : k) := by
    intro p
    exact congrFun (congrArg DFunLike.coe hψ₀_comp) p
  have hψ₀_Δ_unit : IsUnit (ψ₀ Δ_k) := by
    change IsUnit (ψ₀ (Δ_aff.map (algebraMap F k)))
    have h_eq : ψ₀ (Δ_aff.map (algebraMap F k)) =
        Algebra.TensorProduct.includeLeftRingHom (R := F) (A := R₀) (B := k)
          (algebraMap (Polynomial F) R₀ Δ_aff) := hψ₀_map Δ_aff
    rw [h_eq]
    exact (IsLocalization.Away.algebraMap_isUnit (S := R₀) Δ_aff).map _
  let Ψ : R₀_k →+* TensorProduct F R₀ k := IsLocalization.Away.lift Δ_k hψ₀_Δ_unit
  have hΨ_eq : ∀ q : Polynomial k, Ψ (algebraMap (Polynomial k) R₀_k q) = ψ₀ q :=
    fun q => IsLocalization.Away.lift_eq Δ_k hψ₀_Δ_unit q
  have hΨ_R₀_hom : Ψ.comp (algebraMap R₀ R₀_k) =
      Algebra.TensorProduct.includeLeftRingHom (R := F) (A := R₀) (B := k) := by
    apply IsLocalization.ringHom_ext (Submonoid.powers Δ_aff)
    refine RingHom.ext fun p => ?_
    simp only [RingHom.comp_apply, hj_R₀_Rk_eq, hΨ_eq]
    exact hψ₀_map p
  have hΨ_R₀ : ∀ r₀ : R₀, Ψ (algebraMap R₀ R₀_k r₀) = TensorProduct.tmul F r₀ 1 :=
    fun r₀ => congrFun (congrArg DFunLike.coe hΨ_R₀_hom) r₀
  have hΨ_k : ∀ c : k, Ψ (algebraMap k R₀_k c) = TensorProduct.tmul F 1 c := by
    intro c
    have hc1 : algebraMap k R₀_k c = algebraMap (Polynomial k) R₀_k (Polynomial.C c) :=
      IsScalarTower.algebraMap_apply k (Polynomial k) R₀_k c
    rw [hc1, hΨ_eq]
    exact Polynomial.eval₂_C _ _
  let ψ_alg : R₀_k →ₐ[F] TensorProduct F R₀ k :=
    { Ψ with
      commutes' := fun a => by
        change Ψ (algebraMap F R₀_k a) = algebraMap F (TensorProduct F R₀ k) a
        rw [IsScalarTower.algebraMap_apply F R₀ R₀_k a, hΨ_R₀]
        rfl }
  have hΨΦ_lin : ψ_alg.toLinearMap.comp (Φ.restrictScalars F).toLinearMap = LinearMap.id := by
    apply TensorProduct.ext'
    intro r₀ c
    change Ψ (Φ (TensorProduct.tmul F r₀ c)) = TensorProduct.tmul F r₀ c
    rw [hΦ_tmul, map_mul, hΨ_R₀, hΨ_k, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  have hΨΦ : Function.LeftInverse Ψ Φ :=
    fun z => congrFun (congrArg DFunLike.coe hΨΦ_lin) z
  have hΦΨ_hom : Φ.toRingHom.comp Ψ = RingHom.id R₀_k := by
    apply IsLocalization.ringHom_ext (Submonoid.powers Δ_k)
    apply Polynomial.ringHom_ext'
    · ext c
      simp only [RingHom.comp_apply, RingHom.id_apply, hΨ_eq]
      change Φ (Polynomial.eval₂ _ x_T (Polynomial.C c)) = _
      rw [Polynomial.eval₂_C]
      change Φ (TensorProduct.tmul F 1 c) = _
      rw [hΦ_tmul, map_one, one_mul]
      exact IsScalarTower.algebraMap_apply k (Polynomial k) R₀_k c
    · simp only [RingHom.comp_apply, RingHom.id_apply, hΨ_eq]
      change Φ (Polynomial.eval₂ _ x_T Polynomial.X) = _
      rw [Polynomial.eval₂_X]
      dsimp only [x_T]
      rw [hΦ_tmul, map_one, mul_one, hj_R₀_Rk_eq, Polynomial.map_X]
  have hΦΨ : Function.RightInverse Ψ Φ :=
    fun w => congrFun (congrArg DFunLike.coe hΦΨ_hom) w
  let e_Rk : TensorProduct F R₀ k ≃+* R₀_k :=
    { Φ.toRingHom with
      invFun := Ψ
      left_inv := hΨΦ
      right_inv := hΦΨ }
  let e_Rk_alg : TensorProduct F R₀ k ≃ₐ[R₀] R₀_k :=
    AlgEquiv.ofRingEquiv (f := e_Rk) (fun r₀ => Φ.commutes r₀)
  have he_Rk_left : ∀ r₀ : R₀, e_Rk (TensorProduct.tmul F r₀ 1) = algebraMap R₀ R₀_k r₀ := by
    intro r₀
    change Φ (TensorProduct.tmul F r₀ 1) = _
    rw [hΦ_tmul, map_one, mul_one]
  have he_Rk_right : ∀ c : k, e_Rk (TensorProduct.tmul F 1 c) = algebraMap k R₀_k c := by
    intro c
    change Φ (TensorProduct.tmul F 1 c) = _
    rw [hΦ_tmul, map_one, one_mul]

  
  let _ : Module.Finite R₀ R₀_k := Module.Finite.equiv e_Rk_alg.toLinearEquiv
  let _ : Algebra.IsIntegral R₀ R₀_k := Algebra.IsIntegral.of_finite R₀ R₀_k
  let hEt_base : Algebra.Etale R₀ (TensorProduct F R₀ k) := Algebra.Etale.baseChange F k R₀
  let _ : Algebra.Etale R₀ R₀_k :=
    @Algebra.Etale.of_equiv R₀ (TensorProduct F R₀ k) R₀_k _ _ _ _ _ hEt_base e_Rk_alg
  have hModFin_Rk_Br : Module.Finite R₀_k B_r :=
    Module.Finite.of_restrictScalars_finite R₀ R₀_k B_r
  let _ : Module.Finite R₀_k B_r := hModFin_Rk_Br
  have hEt_Rk_Br : Algebra.Etale R₀_k B_r :=
    Algebra.Etale.of_restrictScalars R₀ R₀_k B_r
  let _ : Algebra.Etale R₀_k B_r := hEt_Rk_Br
  let _ : IsIntegralClosure B_r R₀_k L_r :=
    IsIntegralClosure.tower_top (R := R₀) (A := R₀_k) (B := L_r) (C := B_r)

  have hInj_Rk_Br : Function.Injective (algebraMap R₀_k B_r) := by
    intro r₁ r₂ hr
    have hL : algebraMap B_r L_r (algebraMap R₀_k B_r r₁) =
        algebraMap B_r L_r (algebraMap R₀_k B_r r₂) :=
      congrArg (algebraMap B_r L_r) hr
    rw [← IsScalarTower.algebraMap_apply R₀_k B_r L_r,
      ← IsScalarTower.algebraMap_apply R₀_k B_r L_r,
      IsScalarTower.algebraMap_apply R₀_k (RatFunc k) L_r,
      IsScalarTower.algebraMap_apply R₀_k (RatFunc k) L_r] at hL
    exact IsFractionRing.injective R₀_k (RatFunc k) ((algebraMap (RatFunc k) L_r).injective hL)

  
  let μ : (B_r ≃ₐ[R₀_k] B_r) → TensorProduct R₀_k B_r B_r →ₐ[B_r] B_r :=
    fun σ => Algebra.TensorProduct.lift (AlgHom.id B_r B_r) σ.symm.toAlgHom (fun _ _ => mul_comm _ _)
  let toGal : (B_r ≃ₐ[R₀_k] B_r) → (L_r ≃ₐ[RatFunc k] L_r) :=
    fun σ => IsFractionRing.fieldEquivOfAlgEquiv (RatFunc k) L_r L_r σ
  have h_toGal : ∀ (σ : B_r ≃ₐ[R₀_k] B_r) (s : B_r),
      toGal σ (algebraMap B_r L_r s) = algebraMap B_r L_r (σ s) :=
    fun σ s => IsFractionRing.fieldEquivOfAlgEquiv_algebraMap (RatFunc k) L_r L_r σ s
  let e_IC : B_r ≃ₐ[R₀_k] ↥(integralClosure R₀_k L_r) :=
    IsIntegralClosure.equiv R₀_k B_r L_r ↥(integralClosure R₀_k L_r)
  let fromGal : (L_r ≃ₐ[RatFunc k] L_r) → (B_r ≃ₐ[R₀_k] B_r) :=
    fun ψ => (e_IC.trans (AlgEquiv.mapIntegralClosure (ψ.restrictScalars R₀_k))).trans e_IC.symm
  have h_fromGal : ∀ (ψ : L_r ≃ₐ[RatFunc k] L_r) (s : B_r),
      algebraMap B_r L_r (fromGal ψ s) = ψ (algebraMap B_r L_r s) := by
    intro ψ s
    have h1 := IsIntegralClosure.algebraMap_equiv R₀_k B_r L_r
      ↥(integralClosure R₀_k L_r) (fromGal ψ s)
    have h2 := IsIntegralClosure.algebraMap_equiv R₀_k B_r L_r
      ↥(integralClosure R₀_k L_r) s
    change (↑(e_IC (fromGal ψ s)) : L_r) = algebraMap B_r L_r (fromGal ψ s) at h1
    change (↑(e_IC s) : L_r) = algebraMap B_r L_r s at h2
    rw [← h1, ← h2]
    dsimp [fromGal]
    rw [e_IC.apply_symm_apply]
    exact AlgEquiv.coe_mapIntegralClosure (ψ.restrictScalars R₀_k) (e_IC s)
  let equiv_aut : (B_r ≃ₐ[R₀_k] B_r) ≃ (L_r ≃ₐ[RatFunc k] L_r) :=
    { toFun := toGal
      invFun := fromGal
      left_inv := fun σ => by
        ext s
        apply IsFractionRing.injective B_r L_r
        rw [h_fromGal, h_toGal]
      right_inv := fun ψ => by
        have hring : (toGal (fromGal ψ)).toRingHom = ψ.toRingHom := by
          apply IsLocalization.ringHom_ext (nonZeroDivisors B_r)
          ext s
          exact (h_toGal (fromGal ψ) s).trans (h_fromGal ψ s)
        ext x
        exact congrFun (congrArg DFunLike.coe hring) x }
  let _ : Fintype (L_r ≃ₐ[RatFunc k] L_r) := AlgEquiv.fintype (RatFunc k) L_r
  let m_gal : ℕ := Fintype.card (L_r ≃ₐ[RatFunc k] L_r)
  have hm_finrank : m_gal = Module.finrank (RatFunc k) L_r :=
    Nat.card_eq_fintype_card.symm.trans (IsGalois.card_aut_eq_finrank (RatFunc k) L_r)
  let equiv_Γ : Fin m_gal ≃ (B_r ≃ₐ[R₀_k] B_r) :=
    (Fintype.equivFin (L_r ≃ₐ[RatFunc k] L_r)).symm.trans equiv_aut.symm
  have hμ_tmul : ∀ (σ : B_r ≃ₐ[R₀_k] B_r) (s₁ s₂ : B_r),
      μ σ (TensorProduct.tmul R₀_k s₁ s₂) = s₁ * σ.symm s₂ :=
    fun σ s₁ s₂ => Algebra.TensorProduct.lift_tmul (AlgHom.id B_r B_r) σ.symm.toAlgHom
      (fun _ _ => mul_comm _ _) s₁ s₂
  have hμ_sec : ∀ (σ : B_r ≃ₐ[R₀_k] B_r) (s : B_r),
      μ σ (TensorProduct.tmul R₀_k s 1) = s := by
    intro σ s
    rw [hμ_tmul, map_one, mul_one]
  have hKerIdem : ∀ σ : B_r ≃ₐ[R₀_k] B_r,
      ∃ f : TensorProduct R₀_k B_r B_r,
        IsIdempotentElem f ∧
        RingHom.ker (μ σ).toRingHom = Ideal.span ({f} : Set (TensorProduct R₀_k B_r B_r)) := by
    intro σ
    have hμ_surj : Function.Surjective (μ σ) := fun s => ⟨TensorProduct.tmul R₀_k s 1, hμ_sec σ s⟩
    have hFG : (RingHom.ker (μ σ).toRingHom).FG :=
      Algebra.FinitePresentation.ker_fG_of_surjective (μ σ) hμ_surj
    have hIdemI : IsIdempotentElem (RingHom.ker (μ σ).toRingHom) := by
      let _ : Algebra (TensorProduct R₀_k B_r B_r) B_r := (μ σ).toRingHom.toAlgebra
      have _ : IsScalarTower B_r (TensorProduct R₀_k B_r B_r) B_r :=
        IsScalarTower.of_algebraMap_eq fun s => ((μ σ).commutes s).symm
      have _ : Algebra.Etale (TensorProduct R₀_k B_r B_r) B_r :=
        Algebra.Etale.of_restrictScalars B_r (TensorProduct R₀_k B_r B_r) B_r
      exact (Algebra.FormallyEtale.iff_of_surjective
        (R := TensorProduct R₀_k B_r B_r) (S := B_r) hμ_surj).mp inferInstance
    exact (Ideal.isIdempotentElem_iff_of_fg _ hFG).mp hIdemI
  let f_gal : Fin m_gal → TensorProduct R₀_k B_r B_r :=
    fun i => Classical.choose (hKerIdem (equiv_Γ i))
  have hf_spec : ∀ i : Fin m_gal,
      IsIdempotentElem (f_gal i) ∧
      RingHom.ker (μ (equiv_Γ i)).toRingHom =
        Ideal.span ({f_gal i} : Set (TensorProduct R₀_k B_r B_r)) :=
    fun i => Classical.choose_spec (hKerIdem (equiv_Γ i))
  let e_gal : Fin m_gal → TensorProduct R₀_k B_r B_r := fun i => 1 - f_gal i
  have hf_idem : ∀ i : Fin m_gal, f_gal i * f_gal i = f_gal i := fun i => (hf_spec i).1.eq
  have he_idem : ∀ i : Fin m_gal, e_gal i * e_gal i = e_gal i := by
    intro i
    dsimp [e_gal]
    calc (1 - f_gal i) * (1 - f_gal i)
        = 1 - f_gal i - f_gal i + f_gal i * f_gal i := by ring
      _ = 1 - f_gal i - f_gal i + f_gal i := by rw [hf_idem i]
      _ = 1 - f_gal i := by ring
  have hfe_zero : ∀ i : Fin m_gal, f_gal i * e_gal i = 0 := by
    intro i
    dsimp [e_gal]
    rw [mul_sub, mul_one, hf_idem i, sub_self]
  have hμ_diag : ∀ i : Fin m_gal, μ (equiv_Γ i) (e_gal i) = 1 := by
    intro i
    have hf_ker : f_gal i ∈ RingHom.ker (μ (equiv_Γ i)).toRingHom := by
      rw [(hf_spec i).2]
      exact Ideal.mem_span_singleton_self (f_gal i)
    change (μ (equiv_Γ i)) (f_gal i) = 0 at hf_ker
    dsimp [e_gal]
    rw [map_sub, map_one, hf_ker, sub_zero]
  have h_absorb : ∀ (i : Fin m_gal) (z : TensorProduct R₀_k B_r B_r),
      z * e_gal i = TensorProduct.tmul R₀_k (μ (equiv_Γ i) z) 1 * e_gal i := by
    intro i z
    have hw_ker : z - TensorProduct.tmul R₀_k (μ (equiv_Γ i) z) 1 ∈
        RingHom.ker (μ (equiv_Γ i)).toRingHom := by
      change μ (equiv_Γ i) (z - TensorProduct.tmul R₀_k (μ (equiv_Γ i) z) 1) = 0
      rw [map_sub, hμ_sec (equiv_Γ i) (μ (equiv_Γ i) z), sub_self]
    rw [(hf_spec i).2, Ideal.mem_span_singleton] at hw_ker
    rcases hw_ker with ⟨c, hc⟩
    have hsub_zero : (z - TensorProduct.tmul R₀_k (μ (equiv_Γ i) z) 1) * e_gal i = 0 := by
      rw [hc]
      calc (f_gal i * c) * e_gal i = c * (f_gal i * e_gal i) := by ring
        _ = c * 0 := by rw [hfe_zero i]
        _ = 0 := mul_zero c
    rw [sub_mul] at hsub_zero
    exact sub_eq_zero.mp hsub_zero
  have hμ_kronecker : ∀ i j : Fin m_gal, μ (equiv_Γ j) (e_gal i) = if i = j then 1 else 0 := by
    intro i j
    by_cases hij : i = j
    · subst hij
      simp only [↓reduceIte, hμ_diag i]
    · simp only [hij, ↓reduceIte]
      have hex_s : ∃ s : B_r, (equiv_Γ i).symm s ≠ (equiv_Γ j).symm s := by
        by_contra h_all
        apply hij
        apply equiv_Γ.injective
        ext t
        have ht_eq : (equiv_Γ i).symm (equiv_Γ i t) = (equiv_Γ j).symm (equiv_Γ i t) := by
          by_contra hne
          exact h_all ⟨equiv_Γ i t, hne⟩
        have ht := congrArg (equiv_Γ j) ht_eq
        rw [(equiv_Γ i).symm_apply_apply, (equiv_Γ j).apply_symm_apply] at ht
        exact ht.symm
      rcases hex_s with ⟨s, hs_ne⟩
      have habs_s := h_absorb i (TensorProduct.tmul R₀_k 1 s)
      rw [hμ_tmul (equiv_Γ i) 1 s, one_mul] at habs_s
      have hmap_j := congrArg (μ (equiv_Γ j)) habs_s
      rw [map_mul, map_mul, hμ_tmul (equiv_Γ j) 1 s, one_mul,
        hμ_sec (equiv_Γ j) ((equiv_Γ i).symm s)] at hmap_j
      have hmul_zero :
          ((equiv_Γ j).symm s - (equiv_Γ i).symm s) * μ (equiv_Γ j) (e_gal i) = 0 := by
        rw [sub_mul, hmap_j, sub_self]
      rcases mul_eq_zero.mp hmul_zero with hdiff | heval
      · exact False.elim (hs_ne (sub_eq_zero.mp hdiff).symm)
      · exact heval
  have he_orth : ∀ i j : Fin m_gal, i ≠ j → e_gal i * e_gal j = 0 := by
    intro i j hij
    have hker_ij : e_gal i ∈ RingHom.ker (μ (equiv_Γ j)).toRingHom := by
      change μ (equiv_Γ j) (e_gal i) = 0
      rw [hμ_kronecker i j]
      simp only [hij, ↓reduceIte]
    rw [(hf_spec j).2, Ideal.mem_span_singleton] at hker_ij
    rcases hker_ij with ⟨c, hc⟩
    rw [hc]
    calc (f_gal j * c) * e_gal j = c * (f_gal j * e_gal j) := by ring
      _ = c * 0 := by rw [hfe_zero j]
      _ = 0 := mul_zero c

  
  have _ : Algebra.Smooth R₀_k B_r := inferInstance
  have _ : Module.Flat R₀_k B_r := Algebra.Smooth.flat R₀_k B_r
  have _ : Module.Flat R₀_k (RatFunc k) := IsLocalization.flat (RatFunc k) (nonZeroDivisors R₀_k)
  have _ : Module.Flat R₀_k L_r := Module.Flat.trans R₀_k (RatFunc k) L_r
  let j_SL : B_r →ₐ[R₀_k] L_r := IsScalarTower.toAlgHom R₀_k B_r L_r
  have hj_SL_inj : Function.Injective j_SL := IsFractionRing.injective B_r L_r
  let ι₁ : TensorProduct R₀_k B_r B_r →ₐ[R₀_k] TensorProduct R₀_k L_r L_r :=
    Algebra.TensorProduct.map j_SL j_SL
  have hι₁_eq : ι₁.toLinearMap = TensorProduct.map j_SL.toLinearMap j_SL.toLinearMap := by
    apply TensorProduct.ext'
    intro s₁ s₂
    rfl
  have hι₁_inj : Function.Injective ι₁ := by
    change Function.Injective ι₁.toLinearMap
    rw [hι₁_eq]
    exact TensorProduct.map_injective_of_flat_flat
      j_SL.toLinearMap j_SL.toLinearMap hj_SL_inj hj_SL_inj
  let _ : IsScalarTower R₀_k L_r (TensorProduct (RatFunc k) L_r L_r) := by
    refine IsScalarTower.of_algebraMap_eq fun r => ?_
    change TensorProduct.tmul (RatFunc k)
        (algebraMap (RatFunc k) L_r (algebraMap R₀_k (RatFunc k) r)) (1 : L_r) =
      TensorProduct.tmul (RatFunc k) (algebraMap R₀_k L_r r) (1 : L_r)
    rw [← IsScalarTower.algebraMap_apply R₀_k (RatFunc k) L_r]
  let φ_RL_KL : TensorProduct R₀_k L_r L_r →ₐ[L_r] TensorProduct (RatFunc k) L_r L_r :=
    Algebra.TensorProduct.lift
      (Algebra.TensorProduct.includeLeft (R := RatFunc k) (S := L_r) (A := L_r) (B := L_r))
      ((Algebra.TensorProduct.includeRight (R := RatFunc k) (A := L_r) (B := L_r)).restrictScalars R₀_k)
      (fun _ _ => mul_comm _ _)
  have hφ_tmul : ∀ x y : L_r,
      φ_RL_KL (TensorProduct.tmul R₀_k x y) = TensorProduct.tmul (RatFunc k) x y := by
    intro x y
    have h := Algebra.TensorProduct.lift_tmul
      (Algebra.TensorProduct.includeLeft (R := RatFunc k) (S := L_r) (A := L_r) (B := L_r))
      ((Algebra.TensorProduct.includeRight (R := RatFunc k) (A := L_r) (B := L_r)).restrictScalars R₀_k)
      (fun _ _ => mul_comm _ _) x y
    change φ_RL_KL (TensorProduct.tmul R₀_k x y) =
      TensorProduct.tmul (RatFunc k) x (1 : L_r) * TensorProduct.tmul (RatFunc k) (1 : L_r) y at h
    rw [h, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  have hφ_inj : Function.Injective φ_RL_KL := by
    let u₁ : RatFunc k →+* TensorProduct R₀_k L_r L_r :=
      (Algebra.TensorProduct.includeLeftRingHom (R := R₀_k) (A := L_r) (B := L_r)).comp
        (algebraMap (RatFunc k) L_r)
    let u₂ : RatFunc k →+* TensorProduct R₀_k L_r L_r :=
      (Algebra.TensorProduct.includeRight (R := R₀_k) (A := L_r) (B := L_r)).toRingHom.comp
        (algebraMap (RatFunc k) L_r)
    have hu_eq : u₁ = u₂ := by
      apply IsLocalization.ringHom_ext (nonZeroDivisors R₀_k)
      ext r
      dsimp [u₁, u₂]
      rw [← IsScalarTower.algebraMap_apply R₀_k (RatFunc k) L_r]
      change TensorProduct.tmul R₀_k (algebraMap R₀_k L_r r) 1 =
        TensorProduct.tmul R₀_k 1 (algebraMap R₀_k L_r r)
      have h1 : algebraMap R₀_k L_r r = r • (1 : L_r) := Algebra.algebraMap_eq_smul_one r
      rw [h1, TensorProduct.smul_tmul]
    have hk_comm : ∀ q : RatFunc k,
        TensorProduct.tmul R₀_k (algebraMap (RatFunc k) L_r q) (1 : L_r) =
          TensorProduct.tmul R₀_k (1 : L_r) (algebraMap (RatFunc k) L_r q) :=
      fun q => congrFun (congrArg DFunLike.coe hu_eq) q
    let g_K : L_r →ₐ[RatFunc k] TensorProduct R₀_k L_r L_r :=
      { (Algebra.TensorProduct.includeRight (R := R₀_k) (A := L_r) (B := L_r)).toRingHom with
        commutes' := fun q => by
          change TensorProduct.tmul R₀_k (1 : L_r) (algebraMap (RatFunc k) L_r q) =
            algebraMap (RatFunc k) (TensorProduct R₀_k L_r L_r) q
          rw [IsScalarTower.algebraMap_apply (RatFunc k) L_r (TensorProduct R₀_k L_r L_r)]
          exact (hk_comm q).symm }
    let ψ_KL_RL : TensorProduct (RatFunc k) L_r L_r →ₐ[L_r] TensorProduct R₀_k L_r L_r :=
      Algebra.TensorProduct.lift
        (Algebra.TensorProduct.includeLeft (R := R₀_k) (S := L_r) (A := L_r) (B := L_r))
        g_K
        (fun _ _ => mul_comm _ _)
    have h_comp : ((ψ_KL_RL.comp φ_RL_KL).restrictScalars R₀_k).toLinearMap = LinearMap.id := by
      apply TensorProduct.ext'
      intro x y
      change ψ_KL_RL (φ_RL_KL (TensorProduct.tmul R₀_k x y)) = TensorProduct.tmul R₀_k x y
      rw [hφ_tmul]
      have h := Algebra.TensorProduct.lift_tmul
        (Algebra.TensorProduct.includeLeft (R := R₀_k) (S := L_r) (A := L_r) (B := L_r))
        g_K (fun _ _ => mul_comm _ _) x y
      change ψ_KL_RL (TensorProduct.tmul (RatFunc k) x y) =
        TensorProduct.tmul R₀_k x (1 : L_r) * TensorProduct.tmul R₀_k (1 : L_r) y at h
      rw [h, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    have h_left_inv : Function.LeftInverse ψ_KL_RL φ_RL_KL :=
      fun w => congrFun (congrArg DFunLike.coe h_comp) w
    exact h_left_inv.injective
  let ι_tot : TensorProduct R₀_k B_r B_r →+* TensorProduct (RatFunc k) L_r L_r :=
    φ_RL_KL.toRingHom.comp ι₁.toRingHom
  have hι_tot_inj : Function.Injective ι_tot := hφ_inj.comp hι₁_inj
  have hι_tot_tmul : ∀ s₁ s₂ : B_r,
      ι_tot (TensorProduct.tmul R₀_k s₁ s₂) =
        TensorProduct.tmul (RatFunc k) (algebraMap B_r L_r s₁) (algebraMap B_r L_r s₂) := by
    intro s₁ s₂
    change φ_RL_KL (ι₁ (TensorProduct.tmul R₀_k s₁ s₂)) = _
    rw [Algebra.TensorProduct.map_tmul]
    exact hφ_tmul (j_SL s₁) (j_SL s₂)
  let μ_L : Fin m_gal → TensorProduct (RatFunc k) L_r L_r →ₐ[L_r] L_r :=
    fun j => Algebra.TensorProduct.lift (AlgHom.id L_r L_r)
      (toGal (equiv_Γ j)).symm.toAlgHom (fun _ _ => mul_comm _ _)
  have hμ_L_compat : ∀ (j : Fin m_gal) (z : TensorProduct R₀_k B_r B_r),
      μ_L j (ι_tot z) = algebraMap B_r L_r (μ (equiv_Γ j) z) := by
    intro j
    let lhs_alg : TensorProduct R₀_k B_r B_r →ₐ[R₀_k] L_r :=
      (((μ_L j).restrictScalars R₀_k).comp (φ_RL_KL.restrictScalars R₀_k)).comp ι₁
    let rhs_alg : TensorProduct R₀_k B_r B_r →ₐ[R₀_k] L_r :=
      (IsScalarTower.toAlgHom R₀_k B_r L_r).comp ((μ (equiv_Γ j)).restrictScalars R₀_k)
    have hlhs_eq : lhs_alg.toLinearMap = rhs_alg.toLinearMap := by
      apply TensorProduct.ext'
      intro s₁ s₂
      change μ_L j (ι_tot (TensorProduct.tmul R₀_k s₁ s₂)) =
        algebraMap B_r L_r (μ (equiv_Γ j) (TensorProduct.tmul R₀_k s₁ s₂))
      rw [hι_tot_tmul, hμ_tmul, map_mul]
      have h := Algebra.TensorProduct.lift_tmul (AlgHom.id L_r L_r)
        (toGal (equiv_Γ j)).symm.toAlgHom (fun _ _ => mul_comm _ _)
        (algebraMap B_r L_r s₁) (algebraMap B_r L_r s₂)
      change μ_L j (TensorProduct.tmul (RatFunc k) (algebraMap B_r L_r s₁) (algebraMap B_r L_r s₂)) =
        algebraMap B_r L_r s₁ * (toGal (equiv_Γ j)).symm (algebraMap B_r L_r s₂) at h
      rw [h]
      congr 1
      apply (toGal (equiv_Γ j)).injective
      rw [(toGal (equiv_Γ j)).apply_symm_apply, h_toGal, (equiv_Γ j).apply_symm_apply]
    intro z
    exact congrFun (congrArg DFunLike.coe hlhs_eq) z
  let e_bar : Fin m_gal → TensorProduct (RatFunc k) L_r L_r := fun i => ι_tot (e_gal i)
  have hμ_L_ebar : ∀ i j : Fin m_gal, μ_L j (e_bar i) = if i = j then 1 else 0 := by
    intro i j
    dsimp [e_bar]
    rw [hμ_L_compat j (e_gal i), hμ_kronecker i j]
    split_ifs <;> simp
  let Φ_lin : (Fin m_gal → L_r) →ₗ[L_r] TensorProduct (RatFunc k) L_r L_r :=
    { toFun := fun c => ∑ i : Fin m_gal, c i • e_bar i
      map_add' := fun c₁ c₂ => by
        simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
      map_smul' := fun a c => by
        simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.smul_sum, mul_smul] }
  let Θ_lin : TensorProduct (RatFunc k) L_r L_r →ₗ[L_r] (Fin m_gal → L_r) :=
    LinearMap.pi fun j => (μ_L j).toLinearMap
  have hΘΦ : ∀ c : Fin m_gal → L_r, Θ_lin (Φ_lin c) = c := by
    intro c
    ext j
    change μ_L j (∑ i : Fin m_gal, c i • e_bar i) = c j
    rw [map_sum]
    have hterm : ∀ i : Fin m_gal, μ_L j (c i • e_bar i) = if i = j then c i else 0 := by
      intro i
      rw [map_smul, smul_eq_mul, hμ_L_ebar i j, mul_ite, mul_one, mul_zero]
    simp_rw [hterm]
    simp
  have hΦ_inj : Function.Injective Φ_lin := Function.LeftInverse.injective hΘΦ
  have _ : Module.Finite (RatFunc k) (TensorProduct (RatFunc k) L_r L_r) :=
    Module.Finite.tensorProduct (RatFunc k) L_r L_r
  have _ : FiniteDimensional L_r (TensorProduct (RatFunc k) L_r L_r) :=
    Module.Finite.of_restrictScalars_finite (RatFunc k) L_r (TensorProduct (RatFunc k) L_r L_r)
  have hfinrank_eq :
      Module.finrank L_r (Fin m_gal → L_r) =
        Module.finrank L_r (TensorProduct (RatFunc k) L_r L_r) := by
    rw [Module.finrank_pi, Fintype.card_fin,
      @Module.finrank_tensorProduct L_r (RatFunc k) L_r L_r, Module.finrank_self, one_mul,
      hm_finrank]
  have hΦ_surj : Function.Surjective Φ_lin :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfinrank_eq).mp hΦ_inj
  have hsum_bar : (∑ i : Fin m_gal, e_bar i) = 1 := by
    set w₀ : TensorProduct (RatFunc k) L_r L_r := 1 - ∑ i : Fin m_gal, e_bar i
    have hΘw₀ : Θ_lin w₀ = 0 := by
      ext j
      change μ_L j (1 - ∑ i : Fin m_gal, e_bar i) = 0
      rw [map_sub, map_one, map_sum]
      simp_rw [hμ_L_ebar]
      simp
    obtain ⟨c₀, hc₀⟩ := hΦ_surj w₀
    have hc₀_zero : c₀ = 0 := by
      rw [← hΘΦ c₀, hc₀, hΘw₀]
    have hw₀_zero : w₀ = 0 := by
      rw [← hc₀, hc₀_zero, map_zero]
    exact (sub_eq_zero.mp hw₀_zero).symm
  have hsum_e : (∑ i : Fin m_gal, e_gal i) = 1 := by
    apply hι_tot_inj
    rw [map_sum, map_one]
    exact hsum_bar

  
  have hAut_Rk_triv : ∀ τ : B_r ≃ₐ[R₀_k] B_r,
      ∃ σ : B_r ≃ₐ[R₀] B_r, (∀ b : B_r, σ b = τ b) ∧ ρ_𝒢 σ = 1 := by
    intro τ
    let σ : B_r ≃ₐ[R₀] B_r := τ.restrictScalars R₀
    refine ⟨σ, fun _ => rfl, ?_⟩
    apply _hGeom_triv σ
    intro x hx
    obtain ⟨c, rfl⟩ := (hRange_ιk x).mp hx
    rw [← hι_k_comp c]
    exact τ.commutes (algebraMap k R₀_k c)

  exact ⟨hDom_Rk, instAlg_R₀_Rk, instAlg_Rk_Br, hST_R₀_Rk_Br, hModFin_Rk_Br, hEt_Rk_Br,
    e_Rk, m_gal, equiv_Γ, e_gal, hInj_Rk_Br, hι_k_comp, he_Rk_left, he_Rk_right,
    he_idem, he_orth, hsum_e, hμ_kronecker, h_absorb, hAut_Rk_triv⟩

theorem weil_mid_dev_etale_over_p1_preirreducible_open_cover (F : Type u) [Field F] :
    let D₀ := weilProjectiveSpaceOver F 1
    ∀ [AlgebraicGeometry.IsIntegral D₀.left]
      (u_chart₀ u_chart₁ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶ D₀.left)
      (_hu₀_open : AlgebraicGeometry.IsOpenImmersion u_chart₀)
      (_hu₁_open : AlgebraicGeometry.IsOpenImmersion u_chart₁)
      (_hcov : Set.range u_chart₀.base ∪ Set.range u_chart₁.base = Set.univ)
      (U₀ : D₀.left.Opens)
      (_hU₀_ne : Nonempty ↥U₀.toScheme)
      (X : AlgebraicGeometry.Scheme.{u})
      (h_X : X ⟶ D₀.left) [AlgebraicGeometry.Etale h_X]
      (M : Type),
      Function.Bijective
        (fun f : LocallyConstant ↥X M =>
          f.comap (CategoryTheory.Limits.pullback.fst h_X U₀.ι).base.hom) :=
by
  classical
  intro D₀ _ u_chart₀ u_chart₁ hu₀_open hu₁_open hcov U₀ hU₀_ne X h_X _ M
  
  have hAwayDom : ∀ (A : Type u) [CommRing A] [Algebra (Polynomial F) A]
      [Algebra.Etale (Polynomial F) A] (q : Ideal A) [q.IsPrime],
      ∃ f₀ : A, f₀ ∉ q ∧ IsDomain (Localization.Away f₀) := by
    intro A _ _ _ q _
    let P_F := Polynomial F
    have : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing P_F A
    let R_q : Type u := Localization.AtPrime q
    have : IsNoetherianRing R_q := IsLocalization.isNoetherianRing q.primeCompl R_q inferInstance
    let p₀ : Ideal P_F := Ideal.comap (algebraMap P_F A) q
    have : p₀.IsPrime := Ideal.IsPrime.comap (algebraMap P_F A)
    let R₀ : Type u := Localization.AtPrime p₀
    have hcomap_Rq : Ideal.comap (algebraMap P_F R_q) (IsLocalRing.maximalIdeal R_q) = p₀ := by
      have hA : Ideal.comap (algebraMap A R_q) (IsLocalRing.maximalIdeal R_q) = q :=
        IsLocalization.AtPrime.under_maximalIdeal R_q q
      rw [IsScalarTower.algebraMap_eq P_F A R_q, ← Ideal.comap_comap, hA]
    have hunit_PF : ∀ s : p₀.primeCompl, IsUnit (algebraMap P_F R_q s.1) := by
      intro s
      apply IsLocalRing.notMem_maximalIdeal.mp
      intro hmem
      have hmem' : s.1 ∈ Ideal.comap (algebraMap P_F R_q) (IsLocalRing.maximalIdeal R_q) := hmem
      rw [hcomap_Rq] at hmem'
      exact s.2 hmem'
    let ψ₀ : R₀ →+* R_q := IsLocalization.lift hunit_PF
    let _ : Algebra R₀ R_q := ψ₀.toAlgebra
    have : IsScalarTower P_F R₀ R_q :=
      ⟨fun p r z => by
        change ψ₀ (p • r) * z = p • (ψ₀ r * z)
        rw [Algebra.smul_def p r, map_mul, IsLocalization.lift_eq hunit_PF p, mul_assoc,
          Algebra.smul_def p (ψ₀ r * z)]⟩
    have : IsLocalHom (algebraMap R₀ R_q) :=
      ⟨fun z hz => by
        change IsUnit (ψ₀ z) at hz
        obtain ⟨⟨p, s⟩, hps⟩ := IsLocalization.surj p₀.primeCompl z
        have hmul_u : IsUnit (ψ₀ (z * algebraMap P_F R₀ s.1)) := by
          rw [map_mul, IsLocalization.lift_eq hunit_PF s.1]
          exact hz.mul (hunit_PF s)
        rw [hps] at hmul_u
        change IsUnit (ψ₀ (algebraMap P_F R₀ p)) at hmul_u
        rw [IsLocalization.lift_eq hunit_PF p] at hmul_u
        have hp_not : p ∉ p₀ := by
          intro hp_mem
          have hp_max : algebraMap P_F R_q p ∈ IsLocalRing.maximalIdeal R_q := by
            change p ∈ Ideal.comap (algebraMap P_F R_q) (IsLocalRing.maximalIdeal R_q)
            rwa [hcomap_Rq]
          exact (IsLocalRing.notMem_maximalIdeal.mpr hmul_u) hp_max
        have hp_u_R₀ : IsUnit (algebraMap P_F R₀ p) :=
          IsLocalization.map_units R₀ (⟨p, hp_not⟩ : p₀.primeCompl)
        rw [← hps] at hp_u_R₀
        exact isUnit_of_mul_isUnit_left hp_u_R₀⟩
    have : Algebra.FormallyUnramified A R_q :=
      Algebra.FormallyUnramified.of_isLocalization q.primeCompl
    have : Algebra.FormallyUnramified P_F R_q :=
      Algebra.FormallyUnramified.comp P_F A R_q
    have : Algebra.FormallyUnramified R₀ R_q :=
      Algebra.FormallyUnramified.localization_base p₀.primeCompl
    have : Algebra.EssFiniteType P_F A := Algebra.EssFiniteType.of_finiteType P_F A
    have : Algebra.EssFiniteType A R_q := Algebra.EssFiniteType.of_isLocalization R_q q.primeCompl
    have : Algebra.EssFiniteType P_F R_q := Algebra.EssFiniteType.comp P_F A R_q
    have : Algebra.EssFiniteType R₀ R_q := Algebra.EssFiniteType.of_comp P_F R₀ R_q
    let π_P : P_F := Submodule.IsPrincipal.generator p₀
    have hp₀_span : p₀ = Ideal.span ({π_P} : Set P_F) :=
      (Submodule.IsPrincipal.span_singleton_generator p₀).symm
    have hmax_R₀ : IsLocalRing.maximalIdeal R₀ = Ideal.span ({algebraMap P_F R₀ π_P} : Set R₀) := by
      calc
        IsLocalRing.maximalIdeal R₀ = Ideal.map (algebraMap P_F R₀) p₀ :=
          (IsLocalization.AtPrime.map_eq_maximalIdeal p₀ R₀).symm
        _ = Ideal.map (algebraMap P_F R₀) (Ideal.span ({π_P} : Set P_F)) :=
          congrArg (Ideal.map (algebraMap P_F R₀)) hp₀_span
        _ = Ideal.span ({algebraMap P_F R₀ π_P} : Set R₀) := by
          rw [Ideal.map_span, Set.image_singleton]
    let π_q : R_q := algebraMap P_F R_q π_P
    have hmax_Rq : IsLocalRing.maximalIdeal R_q = Ideal.span ({π_q} : Set R_q) := by
      rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := R₀) (S := R_q), hmax_R₀,
        Ideal.map_span, Set.image_singleton]
      congr 1
      ext r
      simp only [Set.mem_singleton_iff]
      change r = ψ₀ (algebraMap P_F R₀ π_P) ↔ r = π_q
      rw [IsLocalization.lift_eq hunit_PF π_P]
    have : IsDomain R_q := by
      by_cases hπP : π_P = 0
      · have hmax_bot : IsLocalRing.maximalIdeal R_q = ⊥ := by
          rw [hmax_Rq]
          have hπq0 : π_q = 0 := by
            dsimp [π_q]
            rw [hπP, map_zero]
          rw [hπq0, Ideal.span_singleton_eq_bot]
        have : NoZeroDivisors R_q :=
          ⟨fun {x y} hxy => by
            by_cases hx : x = 0
            · exact Or.inl hx
            · right
              have hx_not : x ∉ IsLocalRing.maximalIdeal R_q := by
                rw [hmax_bot, Ideal.mem_bot]
                exact hx
              obtain ⟨u, rfl⟩ := IsLocalRing.notMem_maximalIdeal.mp hx_not
              calc y
                  = 1 * y := (one_mul y).symm
                _ = (↑u⁻¹ * ↑u) * y := by rw [Units.inv_mul]
                _ = ↑u⁻¹ * (↑u * y) := mul_assoc _ _ _
                _ = ↑u⁻¹ * 0 := by rw [hxy]
                _ = 0 := mul_zero _⟩
        exact NoZeroDivisors.to_isDomain R_q
      · have : Module.Flat A R_q := IsLocalization.flat R_q q.primeCompl
        have : Module.Flat P_F R_q := Module.Flat.trans P_F A R_q
        have : Module.IsTorsionFree P_F R_q := Module.Flat.isTorsionFree
        have hnzd_pow : ∀ (k : ℕ) (z : R_q), π_q ^ k * z = 0 → z = 0 := by
          intro k
          induction k with
          | zero =>
            intro z hz
            simpa using hz
          | succ k ih =>
            intro z hz
            have hz' : π_q ^ k * (π_q * z) = 0 := by
              rw [← mul_assoc, ← pow_succ]
              exact hz
            have h1 : π_q * z = 0 := ih (π_q * z) hz'
            have hsmul : π_P • z = 0 := by
              rw [Algebra.smul_def]
              exact h1
            exact (smul_eq_zero_iff_right hπP).mp hsmul
        have hkrull : (⨅ n : ℕ, IsLocalRing.maximalIdeal R_q ^ n) = ⊥ :=
          Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal R_q)
            (IsLocalRing.maximalIdeal.isMaximal R_q).ne_top
        have hdecomp : ∀ x : R_q, x ≠ 0 → ∃ (n : ℕ) (u : R_q), IsUnit u ∧ x = π_q ^ n * u := by
          intro x hx
          have hx_not_bot : x ∉ (⊥ : Ideal R_q) := by simp [hx]
          rw [← hkrull, Ideal.mem_iInf] at hx_not_bot
          push Not at hx_not_bot
          obtain ⟨N, hN⟩ := hx_not_bot
          have hN_ne : N ≠ 0 := by
            intro h0
            rw [h0, pow_zero, Ideal.one_eq_top] at hN
            exact hN Submodule.mem_top
          have hex_n : ∃ n : ℕ, x ∉ IsLocalRing.maximalIdeal R_q ^ (n + 1) :=
            ⟨N - 1, by rwa [Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hN_ne)]⟩
          let n₀ := Nat.find hex_n
          have hn₀_spec : x ∉ IsLocalRing.maximalIdeal R_q ^ (n₀ + 1) := Nat.find_spec hex_n
          have hn₀_mem : x ∈ IsLocalRing.maximalIdeal R_q ^ n₀ := by
            rcases Nat.eq_zero_or_pos n₀ with h0 | hpos
            · rw [h0, pow_zero, Ideal.one_eq_top]
              exact Submodule.mem_top
            · obtain ⟨m, hm⟩ : ∃ m : ℕ, m + 1 = n₀ := ⟨n₀ - 1, Nat.sub_add_cancel hpos⟩
              have hlt : m < n₀ := by omega
              have hmin := Nat.find_min hex_n hlt
              rw [hm] at hmin
              exact not_not.mp hmin
          rw [hmax_Rq, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hn₀_mem
          obtain ⟨u, hu⟩ := hn₀_mem
          have hx_eq : x = π_q ^ n₀ * u := by rw [← hu, mul_comm]
          have hu_unit : IsUnit u := by
            apply IsLocalRing.notMem_maximalIdeal.mp
            intro hu_mem
            rw [hmax_Rq, Ideal.mem_span_singleton'] at hu_mem
            obtain ⟨v, hv⟩ := hu_mem
            have hx_in : x ∈ Ideal.span ({π_q} : Set R_q) ^ (n₀ + 1) := by
              rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton']
              refine ⟨v, ?_⟩
              rw [hx_eq, ← hv, pow_succ]
              ring
            rw [← hmax_Rq] at hx_in
            exact hn₀_spec hx_in
          exact ⟨n₀, u, hu_unit, hx_eq⟩
        have : NoZeroDivisors R_q :=
          ⟨fun {x y} hxy => by
            by_contra hne
            push Not at hne
            obtain ⟨n, u, hu, rfl⟩ := hdecomp x hne.1
            obtain ⟨m, v, hv, rfl⟩ := hdecomp y hne.2
            have hmul : π_q ^ (n + m) * (u * v) = 0 := by
              calc
                π_q ^ (n + m) * (u * v) = (π_q ^ n * u) * (π_q ^ m * v) := by rw [pow_add]; ring
                _ = 0 := hxy
            exact (hu.mul hv).ne_zero (hnzd_pow (n + m) (u * v) hmul)⟩
        exact NoZeroDivisors.to_isDomain R_q
    let K : Ideal A := RingHom.ker (algebraMap A R_q)
    obtain ⟨S, hS⟩ := Ideal.fg_of_isNoetherianRing K
    have hex : ∀ b ∈ K, ∃ m : ↥q.primeCompl, (m : A) * b = 0 := by
      intro b hb
      exact (IsLocalization.map_eq_zero_iff q.primeCompl R_q b).mp (RingHom.mem_ker.mp hb)
    let s_fn : A → A := fun b =>
      if hb : b ∈ K then ((Classical.choose (hex b hb) : ↥q.primeCompl) : A) else 1
    have hs_notMem : ∀ b ∈ K, s_fn b ∉ q := by
      intro b hb
      simp only [s_fn, hb, ↓reduceDIte]
      exact (Classical.choose (hex b hb)).2
    have hs_mul : ∀ b ∈ K, s_fn b * b = 0 := by
      intro b hb
      simp only [s_fn, hb, ↓reduceDIte]
      exact Classical.choose_spec (hex b hb)
    have hS_sub : ∀ b ∈ S, b ∈ K := by
      intro b hb
      rw [← hS]
      exact Ideal.subset_span hb
    let f₀ : A := ∏ b ∈ S, s_fn b
    have hf₀ : f₀ ∉ q := by
      intro hmem
      obtain ⟨b, hbS, hbq⟩ := (Ideal.IsPrime.prod_mem_iff (p := q)).mp hmem
      exact hs_notMem b (hS_sub b hbS) hbq
    have hann : ∀ x ∈ K, f₀ * x = 0 := by
      let L : Ideal A := LinearMap.ker (LinearMap.mulLeft A f₀)
      have hle : K ≤ L := by
        rw [← hS, Ideal.span_le]
        intro b hbS
        rw [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.mulLeft_apply]
        obtain ⟨t, ht⟩ := Finset.dvd_prod_of_mem s_fn hbS
        have hf₀_eq : f₀ = s_fn b * t := ht
        calc f₀ * b
            = (s_fn b * t) * b := by rw [hf₀_eq]
          _ = t * (s_fn b * b) := by ring
          _ = t * 0 := by rw [hs_mul b (hS_sub b hbS)]
          _ = 0 := mul_zero t
      intro x hx
      exact LinearMap.mem_ker.mp (hle hx)
    let A₀ : Type u := Localization.Away f₀
    have hu : IsUnit (algebraMap A R_q f₀) := IsLocalization.map_units R_q (⟨f₀, hf₀⟩ : ↥q.primeCompl)
    let ψ : A₀ →+* R_q := IsLocalization.Away.lift f₀ hu
    have hψ_inj : Function.Injective ψ := by
      rw [_root_.injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨n, x, hzx⟩ := IsLocalization.Away.surj f₀ z
      have hxK : x ∈ K := by
        rw [RingHom.mem_ker, ← IsLocalization.Away.lift_eq (S := A₀) f₀ hu x]
        change ψ (algebraMap A A₀ x) = 0
        rw [← hzx, map_mul, hz, zero_mul]
      have hxf₀ : x * f₀ = 0 := by
        rw [mul_comm]
        exact hann x hxK
      have hz_pow : z * (algebraMap A A₀ f₀) ^ (n + 1) = 0 := by
        calc z * (algebraMap A A₀ f₀) ^ (n + 1)
            = (z * (algebraMap A A₀ f₀) ^ n) * algebraMap A A₀ f₀ := by rw [pow_succ, mul_assoc]
          _ = algebraMap A A₀ x * algebraMap A A₀ f₀ := by rw [hzx]
          _ = algebraMap A A₀ (x * f₀) := (map_mul (algebraMap A A₀) x f₀).symm
          _ = algebraMap A A₀ 0 := by rw [hxf₀]
          _ = 0 := map_zero (algebraMap A A₀)
      obtain ⟨u_pow, hu_pow⟩ :=
        (IsLocalization.Away.algebraMap_isUnit (S := A₀) f₀).pow (n + 1)
      rw [← hu_pow] at hz_pow
      calc z
          = z * 1 := (mul_one z).symm
        _ = z * (↑u_pow * ↑u_pow⁻¹) := by rw [Units.mul_inv]
        _ = (z * ↑u_pow) * ↑u_pow⁻¹ := (mul_assoc z _ _).symm
        _ = 0 * ↑u_pow⁻¹ := by rw [hz_pow]
        _ = 0 := zero_mul _
    exact ⟨f₀, hf₀, Function.Injective.isDomain ψ hψ_inj⟩

  
  let i_X := CategoryTheory.Limits.pullback.fst h_X U₀.ι
  have hSingleChart :
      ∀ (u_chart : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶ D₀.left)
        [AlgebraicGeometry.IsOpenImmersion u_chart] (x : ↥X),
        h_X.base x ∈ Set.range u_chart.base →
        ∃ O : Set ↥X,
          x ∈ O ∧ IsOpen O ∧ IsPreirreducible O ∧ (O ∩ Set.range i_X.base).Nonempty := by
    intro u_chart _ x hx_chart
    let P_spec := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F))
    let W_chart := CategoryTheory.Limits.pullback h_X u_chart
    let p₁ : W_chart ⟶ X := CategoryTheory.Limits.pullback.fst h_X u_chart
    let p₂ : W_chart ⟶ P_spec := CategoryTheory.Limits.pullback.snd h_X u_chart
    have hx_p₁ : x ∈ Set.range (p₁.base : ↥W_chart → ↥X) := by
      rw [AlgebraicGeometry.IsOpenImmersion.range_pullbackFst u_chart h_X]
      change h_X.base x ∈ (AlgebraicGeometry.Scheme.Hom.opensRange u_chart : Set ↥D₀.left)
      rwa [AlgebraicGeometry.Scheme.Hom.coe_opensRange]
    obtain ⟨w₀, hw₀_eq⟩ := hx_p₁
    have : AlgebraicGeometry.Etale p₂ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback h_X u_chart)
        (inferInstance : AlgebraicGeometry.Etale h_X)
    obtain ⟨V_W, hVW, hw₀_mem, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := w₀) (U := (⊤ : W_chart.Opens)) (Set.mem_univ w₀)
    let R_V : CommRingCat.{u} := W_chart.presheaf.obj (Opposite.op V_W)
    have : AlgebraicGeometry.IsOpenImmersion hVW.fromSpec := hVW.isOpenImmersion_fromSpec
    let g_spec : AlgebraicGeometry.Spec R_V ⟶ P_spec := hVW.fromSpec ≫ p₂
    have hg_et : AlgebraicGeometry.Etale g_spec := inferInstance
    let φ_cat : CommRingCat.of (Polynomial F) ⟶ R_V :=
      (AlgebraicGeometry.Spec.fullyFaithful.preimage g_spec).unop
    have hφ_map : AlgebraicGeometry.Spec.map φ_cat = g_spec :=
      AlgebraicGeometry.Spec.fullyFaithful.map_preimage g_spec
    have hφ_et_mor : RingHom.Etale φ_cat.hom := by
      rw [← hφ_map] at hg_et
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hg_et
    let _ : Algebra (Polynomial F) (↑R_V) := φ_cat.hom.toAlgebra
    have : Algebra.Etale (Polynomial F) (↑R_V) := RingHom.etale_algebraMap.mp hφ_et_mor
    let pt₀ : ↥(AlgebraicGeometry.Spec R_V) := hVW.primeIdealOf ⟨w₀, hw₀_mem⟩
    let q₀ : Ideal (↑R_V) := pt₀.asIdeal
    have : q₀.IsPrime := pt₀.isPrime
    obtain ⟨f₀, hf₀_notMem, hDom_away⟩ := hAwayDom (↑R_V) q₀
    have : IsDomain (Localization.Away f₀) := hDom_away
    let S_away := AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f₀))
    let loc_mor : S_away ⟶ AlgebraicGeometry.Spec R_V :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↑R_V) (Localization.Away f₀)))
    have : AlgebraicGeometry.IsOpenImmersion loc_mor :=
      AlgebraicGeometry.Scheme.isOpenImmersion_SpecMap_localizationAway f₀
    let ι_x : S_away ⟶ X := loc_mor ≫ hVW.fromSpec ≫ p₁
    let O_x : Set ↥X := Set.range (ι_x.base : ↥S_away → ↥X)
    have hx_mem : x ∈ O_x := by
      have hpt₀_basic : (pt₀ : PrimeSpectrum (↑R_V)) ∈ PrimeSpectrum.basicOpen f₀ :=
        (PrimeSpectrum.mem_basicOpen f₀ pt₀).mpr hf₀_notMem
      have hrange_loc :
          Set.range (loc_mor.base : ↥S_away → ↥(AlgebraicGeometry.Spec R_V)) =
            (PrimeSpectrum.basicOpen f₀ : Set (PrimeSpectrum (↑R_V))) := by
        change Set.range ⇑(AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (↑R_V) (Localization.Away f₀)))).base = _
        rw [AlgebraicGeometry.Spec.map_base]
        exact PrimeSpectrum.localization_away_comap_range (Localization.Away f₀) f₀
      have hpt₀_range : pt₀ ∈ Set.range (loc_mor.base : ↥S_away → ↥(AlgebraicGeometry.Spec R_V)) := by
        rw [hrange_loc]
        exact hpt₀_basic
      obtain ⟨z₀, hz₀⟩ := hpt₀_range
      refine ⟨z₀, ?_⟩
      change p₁.base (hVW.fromSpec.base (loc_mor.base z₀)) = x
      rw [hz₀, hVW.fromSpec_primeIdealOf ⟨w₀, hw₀_mem⟩, hw₀_eq]
    have hOx_open : IsOpen O_x :=
      (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding ι_x).isOpen_range
    have : IrreducibleSpace ↥S_away := inferInstance
    have hOx_pre : IsPreirreducible O_x := by
      have huniv : IsPreirreducible (Set.univ : Set ↥S_away) :=
        PreirreducibleSpace.isPreirreducible_univ
      have himg := huniv.image _ (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding ι_x).continuous.continuousOn
      rwa [Set.image_univ] at himg
    have hVB_open : IsOpen ((h_X.base : ↥X → ↥D₀.left) '' O_x) :=
      AlgebraicGeometry.Scheme.Hom.isOpenMap h_X O_x hOx_open
    have hVB_ne : (Set.univ ∩ ((h_X.base : ↥X → ↥D₀.left) '' O_x)).Nonempty :=
      ⟨h_X.base x, Set.mem_univ _, x, hx_mem, rfl⟩
    obtain ⟨u_pt⟩ := hU₀_ne
    have hU₀_set_ne : (Set.univ ∩ (U₀ : Set ↥D₀.left)).Nonempty := by
      refine ⟨U₀.ι.base u_pt, Set.mem_univ _, ?_⟩
      have hmem_range : U₀.ι.base u_pt ∈ Set.range (U₀.ι.base : ↥U₀.toScheme → ↥D₀.left) :=
        ⟨u_pt, rfl⟩
      rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at hmem_range
    have : IrreducibleSpace ↥D₀.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral D₀.left
    obtain ⟨b, _, ⟨y, hy_Ox, hy_eq⟩, hb_U₀⟩ :=
      (PreirreducibleSpace.isPreirreducible_univ (X := ↥D₀.left))
        ((h_X.base : ↥X → ↥D₀.left) '' O_x) (U₀ : Set ↥D₀.left)
        hVB_open U₀.isOpen hVB_ne hU₀_set_ne
    have hy_iX : y ∈ Set.range (i_X.base : ↥(CategoryTheory.Limits.pullback h_X U₀.ι) → ↥X) := by
      rw [AlgebraicGeometry.IsOpenImmersion.range_pullbackFst U₀.ι h_X,
        AlgebraicGeometry.Scheme.Opens.opensRange_ι]
      change h_X.base y ∈ (U₀ : Set ↥D₀.left)
      rwa [hy_eq]
    exact ⟨O_x, hx_mem, hOx_open, hOx_pre, ⟨y, hy_Ox, hy_iX⟩⟩

  have hcov_nhds : ∀ x : ↥X,
      ∃ O : Set ↥X,
        x ∈ O ∧ IsOpen O ∧ IsPreirreducible O ∧ (O ∩ Set.range i_X.base).Nonempty := by
    intro x
    have hmem_univ : h_X.base x ∈ (Set.univ : Set ↥D₀.left) := Set.mem_univ _
    rw [← hcov] at hmem_univ
    rcases hmem_univ with hx₀ | hx₁
    · exact hSingleChart u_chart₀ x hx₀
    · exact hSingleChart u_chart₁ x hx₁

  
  let Y := ↥(CategoryTheory.Limits.pullback h_X U₀.ι)
  let j : C(Y, ↥X) := i_X.base.hom
  have hj_open : Topology.IsOpenEmbedding j :=
    AlgebraicGeometry.Scheme.Hom.isOpenEmbedding i_X
  have hConst : ∀ {Z : Type u} [TopologicalSpace Z] {S : Set Z},
      IsPreirreducible S → ∀ (h : LocallyConstant Z M) {z₁ z₂ : Z},
        z₁ ∈ S → z₂ ∈ S → h z₁ = h z₂ := by
    intro Z _ S hS h z₁ z₂ hz₁ hz₂
    exact h.apply_eq_of_isPreconnected hS.isPreconnected hz₁ hz₂
  let O_x : ↥X → Set ↥X := fun x => (hcov_nhds x).choose
  have hOx_mem : ∀ x : ↥X, x ∈ O_x x := fun x => (hcov_nhds x).choose_spec.1
  have hOx_open : ∀ x : ↥X, IsOpen (O_x x) := fun x => (hcov_nhds x).choose_spec.2.1
  have hOx_pre : ∀ x : ↥X, IsPreirreducible (O_x x) := fun x => (hcov_nhds x).choose_spec.2.2.1
  have hex_y : ∀ x : ↥X, ∃ y : Y, j y ∈ O_x x := by
    intro x
    obtain ⟨z, hzO, y, rfl⟩ := (hcov_nhds x).choose_spec.2.2.2
    exact ⟨y, hzO⟩
  let y_x : ↥X → Y := fun x => (hex_y x).choose
  have hy_x : ∀ x : ↥X, j (y_x x) ∈ O_x x := fun x => (hex_y x).choose_spec
  constructor
  · intro f₁ f₂ h_eq
    have h_eq' : f₁.comap j = f₂.comap j := h_eq
    ext x
    calc f₁ x
        = f₁ (j (y_x x)) := hConst (hOx_pre x) f₁ (hOx_mem x) (hy_x x)
      _ = (f₁.comap j) (y_x x) := (LocallyConstant.coe_comap_apply j f₁ (y_x x)).symm
      _ = (f₂.comap j) (y_x x) := by rw [h_eq']
      _ = f₂ (j (y_x x)) := LocallyConstant.coe_comap_apply j f₂ (y_x x)
      _ = f₂ x := hConst (hOx_pre x) f₂ (hy_x x) (hOx_mem x)
  · intro g
    let g_tilde : ↥X → M := fun x => g (y_x x)
    have hg_loc : IsLocallyConstant g_tilde := by
      rw [IsLocallyConstant.iff_exists_open]
      intro x
      refine ⟨O_x x, hOx_open x, hOx_mem x, fun x' hx' => ?_⟩
      have hne₁ : (O_x x ∩ O_x x').Nonempty := ⟨x', hx', hOx_mem x'⟩
      have hne₂ : (O_x x ∩ Set.range j).Nonempty := ⟨j (y_x x), hy_x x, y_x x, rfl⟩
      obtain ⟨z, hz_x, hz_x', y_star, rfl⟩ :=
        hOx_pre x (O_x x') (Set.range j) (hOx_open x') hj_open.isOpen_range hne₁ hne₂
      have hpre_x : IsPreirreducible (j ⁻¹' O_x x) := (hOx_pre x).preimage hj_open
      have hpre_x' : IsPreirreducible (j ⁻¹' O_x x') := (hOx_pre x').preimage hj_open
      have h1 : g (y_x x') = g y_star :=
        hConst hpre_x' g (hy_x x') hz_x'
      have h2 : g y_star = g (y_x x) :=
        hConst hpre_x g hz_x (hy_x x)
      exact h1.trans h2
    refine ⟨⟨g_tilde, hg_loc⟩, ?_⟩
    ext y
    change g (y_x (j y)) = g y
    have hpre : IsPreirreducible (j ⁻¹' O_x (j y)) := (hOx_pre (j y)).preimage hj_open
    exact hConst hpre g (hy_x (j y)) (hOx_mem (j y))

theorem weil_mid_dev_const_field_pushforward_sheaf_iso (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (K : ℕ) (Λ : Type) [CommRing Λ] :
    let D₀ := weilProjectiveSpaceOver F 1
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∀ (_hLC_ext : ∀ (X : AlgebraicGeometry.Scheme.{u}) (h_X : X ⟶ D₀.left)
        [AlgebraicGeometry.Etale h_X],
        Function.Bijective
          (fun f : LocallyConstant ↥X (Fin K → Λ) =>
            f.comap (CategoryTheory.Limits.pullback.fst h_X U₀.ι).base.hom))
      (B_r : Type u) [CommRing B_r] [IsDomain B_r]
      [Algebra F B_r] [Algebra (Polynomial F) B_r] [Algebra R₀ B_r]
      [IsScalarTower F (Polynomial F) B_r] [IsScalarTower (Polynomial F) R₀ B_r]
      (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme)
      (_heU_eq : CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R₀))) j_aff)
      (ρ_𝒢 : (B_r ≃ₐ[R₀] B_r) →* (Matrix (Fin K) (Fin K) Λ)ˣ)
      (𝒢₀ : CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
      (triv_𝒢 : ∀ W : U₀.toScheme.Etale,
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of B_r)
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r))) e_U.hom
        let W_r := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom π_r
        ↑(𝒢₀.obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_r (Fin K → Λ))
      (_htriv_𝒢 :
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of B_r)
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r))) e_U.hom
        (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
          let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
          let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
          let W₁_r := CategoryTheory.Limits.pullback h₁ π_r
          let W₂_r := CategoryTheory.Limits.pullback h₂ π_r
          ∀ (u_r : Quiver.Hom W₁_r W₂_r),
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.fst h₂ π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.fst h₁ π_r)
                ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.snd h₂ π_r) =
              CategoryTheory.Limits.pullback.snd h₁ π_r →
            ∀ (s : ↑(𝒢₀.obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_r),
              triv_𝒢 W₁ ((𝒢₀.obj.map (Opposite.op u)) s) y₁ =
                triv_𝒢 W₂ s (u_r.base y₁)) ∧
        ∀ W : U₀.toScheme.Etale,
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
          let W_r := CategoryTheory.Limits.pullback h_W π_r
          Function.Injective (triv_𝒢 W) ∧
          Set.range (triv_𝒢 W) =
            { f | ∀ (σ : B_r ≃ₐ[R₀] B_r) (m_σ : Quiver.Hom W_r W_r),
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W π_r) =
                CategoryTheory.Limits.pullback.fst h_W π_r →
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W π_r) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W π_r)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
              ∀ y : ↥W_r, f (m_σ.base y) = ((ρ_𝒢 σ).val).mulVec (f y) })
      (k : Type u) [Finite k] [Field k] [Algebra F k] [Module.Finite F k] [Algebra.Etale F k]
      (ι_k : k →ₐ[F] B_r)
      (res_k : (B_r ≃ₐ[R₀] B_r) →* (k ≃ₐ[F] k))
      (ρ_bar : (k ≃ₐ[F] k) →* (Matrix (Fin K) (Fin K) Λ)ˣ)
      (_hres_surj : Function.Surjective res_k)
      (_hι_k_equiv : ∀ (σ : B_r ≃ₐ[R₀] B_r) (c : k), σ (ι_k c) = ι_k (res_k σ c))
      (_hρ_bar_eq : ∀ σ : B_r ≃ₐ[R₀] B_r, ρ_bar (res_k σ) = ρ_𝒢 σ),
      let R₀_k := Localization.Away
        ((∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)).map (algebraMap F k))
      ∀ [IsDomain R₀_k] [Algebra R₀ R₀_k] [Algebra R₀_k B_r]
        [IsScalarTower R₀ R₀_k B_r] [Module.Finite R₀_k B_r] [Algebra.Etale R₀_k B_r]
        (e_Rk : TensorProduct F R₀ k ≃+* R₀_k)
        (m_gal : ℕ) (equiv_Γ : Fin m_gal ≃ (B_r ≃ₐ[R₀_k] B_r))
        (e_gal : Fin m_gal → TensorProduct R₀_k B_r B_r),
        Function.Injective (algebraMap R₀_k B_r) →
        (∀ c : k, algebraMap R₀_k B_r (algebraMap k R₀_k c) = ι_k c) →
        (∀ r₀ : R₀, e_Rk (TensorProduct.tmul F r₀ 1) = algebraMap R₀ R₀_k r₀) →
        (∀ c : k, e_Rk (TensorProduct.tmul F 1 c) = algebraMap k R₀_k c) →
        (∀ i : Fin m_gal, e_gal i * e_gal i = e_gal i) →
        (∀ i j : Fin m_gal, i ≠ j → e_gal i * e_gal j = 0) →
        (∑ i : Fin m_gal, e_gal i) = 1 →
        (∀ i j : Fin m_gal,
          Algebra.TensorProduct.lift (AlgHom.id B_r B_r) (equiv_Γ j).symm.toAlgHom
            (fun _ _ => mul_comm _ _) (e_gal i) = if i = j then 1 else 0) →
        (∀ (i : Fin m_gal) (z : TensorProduct R₀_k B_r B_r),
          z * e_gal i = TensorProduct.tmul R₀_k
            (Algebra.TensorProduct.lift (AlgHom.id B_r B_r) (equiv_Γ i).symm.toAlgHom
              (fun _ _ => mul_comm _ _) z) (1 : B_r) * e_gal i) →
        (∀ τ : B_r ≃ₐ[R₀_k] B_r,
          ∃ σ : B_r ≃ₐ[R₀] B_r, (∀ b : B_r, σ b = τ b) ∧ ρ_𝒢 σ = 1) →
        let D_k := (weilBaseChangeOver F k D₀).left
        let f_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
        let π_k : Quiver.Hom D_k D₀.left := CategoryTheory.Limits.pullback.fst D₀.hom f_k
        AlgebraicGeometry.Etale π_k ∧
        ∃ (𝒢_tilde : CategoryTheory.Sheaf D₀.left.smallEtaleTopology AddCommGrpCat.{u})
          (triv_tilde : ∀ W : D₀.left.Etale,
            let W_k := CategoryTheory.Limits.pullback
              ((AlgebraicGeometry.Scheme.Etale.forget D₀.left).obj W).hom π_k
            ↑(𝒢_tilde.obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_k (Fin K → Λ)),
          (∀ {W₁ W₂ : D₀.left.Etale} (u : Quiver.Hom W₁ W₂),
            let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget D₀.left).obj W₁).hom
            let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget D₀.left).obj W₂).hom
            ∀ (u_k : Quiver.Hom
                (CategoryTheory.Limits.pullback h₁ π_k)
                (CategoryTheory.Limits.pullback h₂ π_k)),
              CategoryTheory.CategoryStruct.comp u_k (CategoryTheory.Limits.pullback.fst h₂ π_k) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.fst h₁ π_k)
                  ((AlgebraicGeometry.Scheme.Etale.forget D₀.left).map u).left →
              CategoryTheory.CategoryStruct.comp u_k (CategoryTheory.Limits.pullback.snd h₂ π_k) =
                CategoryTheory.Limits.pullback.snd h₁ π_k →
              ∀ (s : ↑(𝒢_tilde.obj.obj (Opposite.op W₂)))
                (y₁ : ↥(CategoryTheory.Limits.pullback h₁ π_k)),
                triv_tilde W₁ ((𝒢_tilde.obj.map (Opposite.op u)) s) y₁ =
                  triv_tilde W₂ s (u_k.base y₁)) ∧
          (∀ W : D₀.left.Etale,
            let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D₀.left).obj W).hom
            let W_k := CategoryTheory.Limits.pullback h_W π_k
            Function.Injective (triv_tilde W) ∧
            Set.range (triv_tilde W) =
              { f | ∀ (γ : k ≃ₐ[F] k) (m_γ : Quiver.Hom W_k W_k),
                CategoryTheory.CategoryStruct.comp m_γ
                    (CategoryTheory.Limits.pullback.fst h_W π_k) =
                  CategoryTheory.Limits.pullback.fst h_W π_k →
                CategoryTheory.CategoryStruct.comp m_γ
                    (CategoryTheory.Limits.pullback.snd h_W π_k) =
                  CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.Limits.pullback.snd h_W π_k)
                    (CategoryTheory.Limits.pullback.lift π_k
                      ((weilBaseChangeOver F k D₀).hom ≫
                        AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.symm.toRingHom))
                      (CategoryTheory.Limits.pullback.condition.trans
                        ((congrArg ((weilBaseChangeOver F k D₀).hom ≫ ·)
                          ((congrArg AlgebraicGeometry.Spec.map
                            ((congrArg CommRingCat.ofHom (RingHom.ext γ.symm.commutes).symm).trans
                              (CommRingCat.ofHom_comp _ _).symm)).trans
                            (AlgebraicGeometry.Spec.map_comp _ _))).trans
                          (CategoryTheory.Category.assoc _ _ _).symm))) →
                ∀ y : ↥W_k, f (m_γ.base y) = ((ρ_bar γ).val).mulVec (f y) }) ∧
          Nonempty (𝒢_tilde ≅ weilEtaleHigherDirectImage U₀.ι 0 𝒢₀) :=
by
  intro D₀ R₀ _hLC_ext
    B_r _ _ _ _ _ _ _
    e_U _heU_eq ρ_𝒢 𝒢₀ triv_𝒢 _htriv_𝒢
    k _ _ _ _ _
    ι_k res_k ρ_bar _hres_surj _hι_k_equiv _hρ_bar_eq
    R₀_k
    _ _ _ _ _ _
    e_Rk m_gal equiv_Γ e_gal
    hInj_Rk hι_k_comp he_Rk_left he_Rk_right
    _hIdemp _hOrth hSum _hEval hAbsorb hAut_Rk_triv
    D_k f_k π_k
  classical

  
  
  
  
  let P_Et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale.{u}
  let P_Surj : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Surjective.{u}
  have hPEt_comp : P_Et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  have hEt_fk : AlgebraicGeometry.Etale f_k :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_Et) (Q := @RingHom.Etale)).mpr
      (RingHom.etale_algebraMap.mpr inferInstance)
  have hEt_πk : AlgebraicGeometry.Etale π_k :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := P_Et) (CategoryTheory.IsPullback.of_hasPullback D₀.hom f_k).flip hEt_fk

  let g_F_R₀ : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of F) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F R₀))
  have heU_base : e_U.hom ≫ (U₀.ι ≫ D₀.hom) = g_F_R₀ := by
    rw [← CategoryTheory.Category.assoc, _heU_eq, CategoryTheory.Category.assoc, hj_hom,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]

  let U_k : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback U₀.ι π_k
  let fst_Uk : U_k ⟶ U₀.toScheme := CategoryTheory.Limits.pullback.fst U₀.ι π_k
  let snd_Uk : U_k ⟶ D_k := CategoryTheory.Limits.pullback.snd U₀.ι π_k
  let snd_Dk : D_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    (weilBaseChangeOver F k D₀).hom
  have hPb_Uk : CategoryTheory.IsPullback fst_Uk (snd_Uk ≫ snd_Dk) (U₀.ι ≫ D₀.hom) f_k :=
    (CategoryTheory.IsPullback.of_hasPullback U₀.ι π_k).paste_vert
      (CategoryTheory.IsPullback.of_hasPullback D₀.hom f_k)

  let p_R₀ : AlgebraicGeometry.Spec (CommRingCat.of R₀_k) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₀_k))
  let p_k : AlgebraicGeometry.Spec (CommRingCat.of R₀_k) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R₀_k))
  let iso_eRk : AlgebraicGeometry.Spec (CommRingCat.of R₀_k) ≅
      AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F R₀ k)) :=
    { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_Rk.toRingHom)
      inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_Rk.symm.toRingHom)
      hom_inv_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hid : e_Rk.toRingHom.comp e_Rk.symm.toRingHom = RingHom.id R₀_k :=
          RingHom.ext fun x => e_Rk.apply_symm_apply x
        rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      inv_hom_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hid : e_Rk.symm.toRingHom.comp e_Rk.toRingHom = RingHom.id _ :=
          RingHom.ext fun x => e_Rk.symm_apply_apply x
        rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
  let iso_Rk : AlgebraicGeometry.Spec (CommRingCat.of R₀_k) ≅
      CategoryTheory.Limits.pullback g_F_R₀ f_k :=
    iso_eRk ≪≫ (AlgebraicGeometry.pullbackSpecIso F R₀ k).symm
  have hiso_Rk_fst : iso_Rk.hom ≫ CategoryTheory.Limits.pullback.fst g_F_R₀ f_k = p_R₀ := by
    change iso_eRk.hom ≫ (AlgebraicGeometry.pullbackSpecIso F R₀ k).inv ≫
      CategoryTheory.Limits.pullback.fst g_F_R₀ f_k = p_R₀
    rw [AlgebraicGeometry.pullbackSpecIso_inv_fst F R₀ k]
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_Rk.toRingHom) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) = p_R₀
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact congrArg AlgebraicGeometry.Spec.map
      (congrArg CommRingCat.ofHom (RingHom.ext fun r₀ => he_Rk_left r₀))
  have hiso_Rk_snd : iso_Rk.hom ≫ CategoryTheory.Limits.pullback.snd g_F_R₀ f_k = p_k := by
    change iso_eRk.hom ≫ (AlgebraicGeometry.pullbackSpecIso F R₀ k).inv ≫
      CategoryTheory.Limits.pullback.snd g_F_R₀ f_k = p_k
    rw [AlgebraicGeometry.pullbackSpecIso_inv_snd F R₀ k]
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_Rk.toRingHom) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) =
        p_k
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact congrArg AlgebraicGeometry.Spec.map
      (congrArg CommRingCat.ofHom (RingHom.ext fun c => he_Rk_right c))
  have hcomm_Rk₀ : p_R₀ ≫ g_F_R₀ = p_k ≫ f_k := by
    rw [← hiso_Rk_fst, ← hiso_Rk_snd, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition]
  have hPb_Rk₀ : CategoryTheory.IsPullback p_R₀ p_k g_F_R₀ f_k :=
    CategoryTheory.IsPullback.of_iso_pullback ⟨hcomm_Rk₀⟩ iso_Rk hiso_Rk_fst hiso_Rk_snd
  have hPb_eU : CategoryTheory.IsPullback e_U.hom g_F_R₀ (U₀.ι ≫ D₀.hom)
      (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F))) :=
    CategoryTheory.IsPullback.of_horiz_isIso ⟨heU_base.trans (CategoryTheory.Category.comp_id _).symm⟩
  have hPb_Spec : CategoryTheory.IsPullback (p_R₀ ≫ e_U.hom) p_k (U₀.ι ≫ D₀.hom) f_k := by
    have h := hPb_Rk₀.paste_horiz hPb_eU
    rwa [CategoryTheory.Category.comp_id] at h
  let e_Uk : AlgebraicGeometry.Spec (CommRingCat.of R₀_k) ≅ U_k :=
    CategoryTheory.IsPullback.isoIsPullback _ _ hPb_Spec hPb_Uk
  have heUk_fst : e_Uk.hom ≫ fst_Uk = p_R₀ ≫ e_U.hom :=
    CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPb_Spec hPb_Uk
  have heUk_snd : e_Uk.hom ≫ (snd_Uk ≫ snd_Dk) = p_k :=
    CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPb_Spec hPb_Uk

  let V_r : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of B_r)
  let π_r : V_r ⟶ U₀.toScheme :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r)) ≫ e_U.hom
  let π₀_rk : V_r ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀_k) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀_k B_r))
  let π_rk : V_r ⟶ U_k := π₀_rk ≫ e_Uk.hom
  let q_k : V_r ⟶ D_k := π_rk ≫ snd_Uk

  have hπrk_fst : π_rk ≫ fst_Uk = π_r := by
    change (π₀_rk ≫ e_Uk.hom) ≫ fst_Uk = _
    rw [CategoryTheory.Category.assoc, heUk_fst, ← CategoryTheory.Category.assoc]
    congr 1
    dsimp only [π₀_rk, p_R₀]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← IsScalarTower.algebraMap_eq R₀ R₀_k B_r]
  have hqk_πk : q_k ≫ π_k = π_r ≫ U₀.ι := by
    change (π_rk ≫ snd_Uk) ≫ π_k = _
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition,
      ← CategoryTheory.Category.assoc, hπrk_fst]
  have hqk_sndDk : q_k ≫ snd_Dk = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_k.toRingHom) := by
    change (π₀_rk ≫ e_Uk.hom ≫ snd_Uk) ≫ snd_Dk = _
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, heUk_snd]
    dsimp only [π₀_rk, p_k]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact congrArg AlgebraicGeometry.Spec.map
      (congrArg CommRingCat.ofHom (RingHom.ext hι_k_comp))

  let d_Br : (B_r ≃ₐ[R₀] B_r) → (V_r ⟶ V_r) :=
    fun σ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)
  let d_ker : (B_r ≃ₐ[R₀_k] B_r) → (V_r ⟶ V_r) :=
    fun τ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom)
  let v_aut : (k ≃ₐ[F] k) → (D_k ⟶ D_k) := fun γ =>
    CategoryTheory.Limits.pullback.lift π_k
      ((weilBaseChangeOver F k D₀).hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.symm.toRingHom))
      (CategoryTheory.Limits.pullback.condition.trans
        ((congrArg ((weilBaseChangeOver F k D₀).hom ≫ ·)
          ((congrArg AlgebraicGeometry.Spec.map
            ((congrArg CommRingCat.ofHom (RingHom.ext γ.symm.commutes).symm).trans
              (CommRingCat.ofHom_comp _ _).symm)).trans
            (AlgebraicGeometry.Spec.map_comp _ _))).trans
          (CategoryTheory.Category.assoc _ _ _).symm))
  have hv_aut_fst : ∀ γ : k ≃ₐ[F] k, v_aut γ ≫ π_k = π_k :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hv_aut_snd : ∀ γ : k ≃ₐ[F] k,
      v_aut γ ≫ snd_Dk = snd_Dk ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.symm.toRingHom) :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hdBr_πr : ∀ σ : B_r ≃ₐ[R₀] B_r, d_Br σ ≫ π_r = π_r := by
    intro σ
    dsimp only [d_Br, π_r]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    have hcomm : σ.symm.toRingHom.comp (algebraMap R₀ B_r) = algebraMap R₀ B_r :=
      RingHom.ext σ.symm.commutes
    rw [hcomm]
  have hqk_equiv : ∀ σ : B_r ≃ₐ[R₀] B_r, d_Br σ ≫ q_k = q_k ≫ v_aut (res_k σ) := by
    intro σ
    apply CategoryTheory.Limits.pullback.hom_ext
    · change (d_Br σ ≫ q_k) ≫ π_k = (q_k ≫ v_aut (res_k σ)) ≫ π_k
      calc (d_Br σ ≫ q_k) ≫ π_k
          = d_Br σ ≫ (q_k ≫ π_k) := CategoryTheory.Category.assoc _ _ _
        _ = (d_Br σ ≫ π_r) ≫ U₀.ι := by rw [hqk_πk, ← CategoryTheory.Category.assoc]
        _ = π_r ≫ U₀.ι := by rw [hdBr_πr σ]
        _ = q_k ≫ π_k := hqk_πk.symm
        _ = q_k ≫ (v_aut (res_k σ) ≫ π_k) := by rw [hv_aut_fst]
        _ = (q_k ≫ v_aut (res_k σ)) ≫ π_k := (CategoryTheory.Category.assoc _ _ _).symm
    · change (d_Br σ ≫ q_k) ≫ snd_Dk = (q_k ≫ v_aut (res_k σ)) ≫ snd_Dk
      have hlhs : (d_Br σ ≫ q_k) ≫ snd_Dk =
          d_Br σ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_k.toRingHom) := by
        rw [CategoryTheory.Category.assoc, hqk_sndDk]
      have hrhs : (q_k ≫ v_aut (res_k σ)) ≫ snd_Dk =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_k.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (res_k σ).symm.toRingHom) := by
        rw [CategoryTheory.Category.assoc, hv_aut_snd, ← CategoryTheory.Category.assoc, hqk_sndDk]
      rw [hlhs, hrhs]
      dsimp only [d_Br]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      refine congrArg AlgebraicGeometry.Spec.map
        (congrArg CommRingCat.ofHom (RingHom.ext fun c => ?_))
      change σ.symm (ι_k c) = ι_k ((res_k σ).symm c)
      have heq := congrArg σ.symm (_hι_k_equiv σ ((res_k σ).symm c))
      rw [σ.symm_apply_apply, (res_k σ).apply_symm_apply] at heq
      exact heq.symm

  
  
  
  
  have hEt_π₀rk : AlgebraicGeometry.Etale π₀_rk :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_Et) (Q := @RingHom.Etale)).mpr
      (RingHom.etale_algebraMap.mpr inferInstance)
  have hEt_πrk : AlgebraicGeometry.Etale π_rk :=
    CategoryTheory.MorphismProperty.IsStableUnderComposition.comp_mem
      (P := P_Et) π₀_rk e_Uk.hom hEt_π₀rk
      (CategoryTheory.MorphismProperty.of_isIso P_Et e_Uk.hom)
  have hSurj_π₀rk : AlgebraicGeometry.Surjective π₀_rk := by
    rw [AlgebraicGeometry.surjective_iff]
    intro P
    have hker : RingHom.ker (algebraMap R₀_k B_r) ≤ P.asIdeal := by
      intro r hr
      have hr0 : r = 0 := hInj_Rk ((RingHom.mem_ker.mp hr).trans (map_zero _).symm)
      rw [hr0]
      exact P.asIdeal.zero_mem
    have : P.asIdeal.IsPrime := P.isPrime
    obtain ⟨Q, hQ, hUnder⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain (S := B_r) P.asIdeal hker
    exact ⟨⟨Q, hQ⟩, PrimeSpectrum.ext hUnder⟩
  have hSurj_πrk : AlgebraicGeometry.Surjective π_rk :=
    CategoryTheory.MorphismProperty.IsStableUnderComposition.comp_mem
      (P := P_Surj) π₀_rk e_Uk.hom hSurj_π₀rk
      (CategoryTheory.MorphismProperty.of_isIso P_Surj e_Uk.hom)
  have hdker_πrk : ∀ τ : B_r ≃ₐ[R₀_k] B_r, d_ker τ ≫ π_rk = π_rk := by
    intro τ
    dsimp only [d_ker, π_rk, π₀_rk]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    have hcomm : τ.symm.toRingHom.comp (algebraMap R₀_k B_r) = algebraMap R₀_k B_r :=
      RingHom.ext τ.symm.commutes
    rw [hcomm]

  let A_tens := TensorProduct R₀_k B_r B_r
  let T_rk : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of A_tens)
  let p₁_rk : T_rk ⟶ V_r :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)
  let p₂_rk : T_rk ⟶ V_r :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom)
  have hComm_T₀ : p₁_rk ≫ π₀_rk = p₂_rk ≫ π₀_rk := by
    have hf₁ := AlgebraicGeometry.pullbackSpecIso_inv_fst R₀_k B_r B_r
    have hf₂ := AlgebraicGeometry.pullbackSpecIso_inv_snd R₀_k B_r B_r
    change _ ≫ _ = p₁_rk at hf₁
    change _ ≫ _ = p₂_rk at hf₂
    rw [← hf₁, ← hf₂, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition]
  have hPb_T₀ : CategoryTheory.IsPullback p₁_rk p₂_rk π₀_rk π₀_rk :=
    CategoryTheory.IsPullback.of_iso_pullback ⟨hComm_T₀⟩
      (AlgebraicGeometry.pullbackSpecIso R₀_k B_r B_r).symm
      (AlgebraicGeometry.pullbackSpecIso_inv_fst R₀_k B_r B_r)
      (AlgebraicGeometry.pullbackSpecIso_inv_snd R₀_k B_r B_r)
  have hPb_eUk_iso : CategoryTheory.IsPullback (𝟙 V_r) π₀_rk π_rk e_Uk.hom :=
    CategoryTheory.IsPullback.of_horiz_isIso ⟨CategoryTheory.Category.id_comp π_rk⟩
  have hPb_T : CategoryTheory.IsPullback p₁_rk p₂_rk π_rk π_rk := by
    have h := hPb_T₀.paste_horiz hPb_eUk_iso
    rwa [CategoryTheory.Category.comp_id] at h

  let μ_gal : (B_r ≃ₐ[R₀_k] B_r) → (A_tens →ₐ[B_r] B_r) :=
    fun τ => Algebra.TensorProduct.lift (AlgHom.id B_r B_r) τ.symm.toAlgHom
      (fun _ _ => Commute.all _ _)
  let Δ_gal : Fin m_gal → (V_r ⟶ T_rk) :=
    fun i => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (μ_gal (equiv_Γ i)).toRingHom)
  have hΔ_p₁ : ∀ i : Fin m_gal, Δ_gal i ≫ p₁_rk = 𝟙 V_r := by
    intro i
    dsimp only [Δ_gal, p₁_rk]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hid : (μ_gal (equiv_Γ i)).toRingHom.comp Algebra.TensorProduct.includeLeftRingHom =
        RingHom.id B_r := by
      apply RingHom.ext
      intro b
      change μ_gal (equiv_Γ i) (Algebra.TensorProduct.includeLeftRingHom b) = b
      dsimp only [μ_gal]
      rw [Algebra.TensorProduct.includeLeftRingHom_apply, Algebra.TensorProduct.lift_tmul]
      simp
    rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
  have hΔ_p₂ : ∀ i : Fin m_gal, Δ_gal i ≫ p₂_rk = d_ker (equiv_Γ i) := by
    intro i
    dsimp only [Δ_gal, p₂_rk, d_ker]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    refine congrArg AlgebraicGeometry.Spec.map
      (congrArg CommRingCat.ofHom (RingHom.ext fun b => ?_))
    change μ_gal (equiv_Γ i) (Algebra.TensorProduct.includeRight b) = (equiv_Γ i).symm b
    dsimp only [μ_gal]
    rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.lift_tmul]
    simp
  have hDiag_surj : ∀ P : ↥T_rk, ∃ (i : Fin m_gal) (v₀ : ↥V_r), (Δ_gal i).base v₀ = P := by
    intro P
    have h1_not_mem : (1 : A_tens) ∉ (P : PrimeSpectrum A_tens).asIdeal :=
      fun h1 => (P : PrimeSpectrum A_tens).isPrime.ne_top
        ((P : PrimeSpectrum A_tens).asIdeal.eq_top_iff_one.mpr h1)
    have hex_i : ∃ i : Fin m_gal, e_gal i ∉ (P : PrimeSpectrum A_tens).asIdeal := by
      by_contra hNo
      apply h1_not_mem
      rw [← hSum]
      refine Submodule.sum_mem (P : PrimeSpectrum A_tens).asIdeal fun i _ => ?_
      by_contra hi
      exact hNo ⟨i, hi⟩
    obtain ⟨i, hi⟩ := hex_i
    let v₀ : PrimeSpectrum B_r :=
      PrimeSpectrum.comap Algebra.TensorProduct.includeLeftRingHom P
    refine ⟨i, v₀, PrimeSpectrum.ext (Ideal.ext fun z => ?_)⟩
    change TensorProduct.tmul R₀_k (μ_gal (equiv_Γ i) z) 1 ∈ (P : PrimeSpectrum A_tens).asIdeal ↔
      z ∈ (P : PrimeSpectrum A_tens).asIdeal
    constructor
    · intro h1
      have hmul : TensorProduct.tmul R₀_k (μ_gal (equiv_Γ i) z) 1 * e_gal i ∈
          (P : PrimeSpectrum A_tens).asIdeal :=
        Ideal.mul_mem_right (e_gal i) _ h1
      rw [← hAbsorb i z] at hmul
      exact ((P : PrimeSpectrum A_tens).isPrime.mem_or_mem hmul).resolve_right hi
    · intro hz
      have hmul : z * e_gal i ∈ (P : PrimeSpectrum A_tens).asIdeal :=
        Ideal.mul_mem_right (e_gal i) _ hz
      rw [hAbsorb i z] at hmul
      exact ((P : PrimeSpectrum A_tens).isPrime.mem_or_mem hmul).resolve_right hi

  have hTorsor_orbits : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (h_Z : Z ⟶ U_k)
      (z₁ z₂ : ↥(CategoryTheory.Limits.pullback h_Z π_rk)),
      (CategoryTheory.Limits.pullback.fst h_Z π_rk).base z₁ =
        (CategoryTheory.Limits.pullback.fst h_Z π_rk).base z₂ →
      ∃ (τ : B_r ≃ₐ[R₀_k] B_r)
        (m' : CategoryTheory.Limits.pullback h_Z π_rk ⟶ CategoryTheory.Limits.pullback h_Z π_rk),
        m' ≫ CategoryTheory.Limits.pullback.fst h_Z π_rk =
          CategoryTheory.Limits.pullback.fst h_Z π_rk ∧
        m' ≫ CategoryTheory.Limits.pullback.snd h_Z π_rk =
          CategoryTheory.Limits.pullback.snd h_Z π_rk ≫ d_ker τ ∧
        m'.base z₁ = z₂ := by
    intro Z h_Z z₁ z₂ hz_eq
    let Z_V := CategoryTheory.Limits.pullback h_Z π_rk
    let fst_Z := CategoryTheory.Limits.pullback.fst h_Z π_rk
    let snd_Z := CategoryTheory.Limits.pullback.snd h_Z π_rk
    let Q_Z := CategoryTheory.Limits.pullback fst_Z fst_Z
    let q₁ := CategoryTheory.Limits.pullback.fst fst_Z fst_Z
    let q₂ := CategoryTheory.Limits.pullback.snd fst_Z fst_Z
    obtain ⟨w, hw₁, hw₂⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z₁ z₂ hz_eq
    have hφ_cond : (q₁ ≫ snd_Z) ≫ π_rk = (q₂ ≫ snd_Z) ≫ π_rk := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.condition]
    let φ_T : Q_Z ⟶ T_rk := hPb_T.lift (q₁ ≫ snd_Z) (q₂ ≫ snd_Z) hφ_cond
    have hφ_p₁ : φ_T ≫ p₁_rk = q₁ ≫ snd_Z := hPb_T.lift_fst _ _ _
    have hφ_p₂ : φ_T ≫ p₂_rk = q₂ ≫ snd_Z := hPb_T.lift_snd _ _ _
    have hOuter_Q : CategoryTheory.IsPullback q₁ (φ_T ≫ p₂_rk) (snd_Z ≫ π_rk) π_rk := by
      rw [hφ_p₂, ← CategoryTheory.Limits.pullback.condition]
      exact (CategoryTheory.IsPullback.of_hasPullback fst_Z fst_Z).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback h_Z π_rk)
    have hMid_Q : CategoryTheory.IsPullback q₁ φ_T snd_Z p₁_rk :=
      CategoryTheory.IsPullback.of_bot hOuter_Q hφ_p₁.symm hPb_T
    obtain ⟨i, v₀, hv₀⟩ := hDiag_surj (φ_T.base w)
    let τ := equiv_Γ i
    have hm'_cond : fst_Z ≫ h_Z = (snd_Z ≫ d_ker τ) ≫ π_rk := by
      rw [CategoryTheory.Category.assoc, hdker_πrk τ, CategoryTheory.Limits.pullback.condition]
    let m' : Z_V ⟶ Z_V := CategoryTheory.Limits.pullback.lift fst_Z (snd_Z ≫ d_ker τ) hm'_cond
    have hm'_fst : m' ≫ fst_Z = fst_Z := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hm'_snd : m' ≫ snd_Z = snd_Z ≫ d_ker τ := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hδ_cond : 𝟙 Z_V ≫ fst_Z = m' ≫ fst_Z :=
      (CategoryTheory.Category.id_comp fst_Z).trans hm'_fst.symm
    let δ_Z : Z_V ⟶ Q_Z := CategoryTheory.Limits.pullback.lift (𝟙 Z_V) m' hδ_cond
    have hδ_q₁ : δ_Z ≫ q₁ = 𝟙 Z_V := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hδ_q₂ : δ_Z ≫ q₂ = m' := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hComm_top : snd_Z ≫ Δ_gal i = δ_Z ≫ φ_T := by
      apply hPb_T.hom_ext
      · rw [CategoryTheory.Category.assoc, hΔ_p₁ i, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.assoc, hφ_p₁, ← CategoryTheory.Category.assoc, hδ_q₁,
          CategoryTheory.Category.id_comp]
      · rw [CategoryTheory.Category.assoc, hΔ_p₂ i, CategoryTheory.Category.assoc, hφ_p₂,
          ← CategoryTheory.Category.assoc, hδ_q₂, hm'_snd]
    have hVert_top : CategoryTheory.IsPullback snd_Z (δ_Z ≫ q₁) (Δ_gal i ≫ p₁_rk) snd_Z := by
      rw [hδ_q₁, hΔ_p₁ i]
      exact CategoryTheory.IsPullback.of_vert_isIso
        ⟨(CategoryTheory.Category.comp_id snd_Z).trans
          (CategoryTheory.Category.id_comp snd_Z).symm⟩
    have hTop_Q : CategoryTheory.IsPullback snd_Z δ_Z (Δ_gal i) φ_T :=
      CategoryTheory.IsPullback.of_bot hVert_top hComm_top hMid_Q.flip
    obtain ⟨z', _, hz'_w⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hTop_Q v₀ w hv₀
    have hz'_eq : z' = z₁ := by
      calc z' = (𝟙 Z_V : Z_V ⟶ Z_V).base z' := rfl
        _ = (δ_Z ≫ q₁).base z' := congrArg (fun g : Z_V ⟶ Z_V => g.base z') hδ_q₁.symm
        _ = q₁.base (δ_Z.base z') := rfl
        _ = q₁.base w := by rw [hz'_w]
        _ = z₁ := hw₁
    refine ⟨τ, m', hm'_fst, hm'_snd, ?_⟩
    calc m'.base z₁ = m'.base z' := by rw [hz'_eq]
      _ = (δ_Z ≫ q₂).base z' := congrArg (fun g : Z_V ⟶ Z_V => g.base z') hδ_q₂.symm
      _ = q₂.base (δ_Z.base z') := rfl
      _ = q₂.base w := by rw [hz'_w]
      _ = z₂ := hw₂

  
  
  
  let Fgt_D := AlgebraicGeometry.Scheme.Etale.forget D₀.left
  let Fgt_U := AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme
  let B_U : CategoryTheory.Functor D₀.left.Etale U₀.toScheme.Etale :=
    weilEtaleSitePullback U₀.ι

  let h_W_of : ∀ W : D₀.left.Etale, (Fgt_D.obj W).left ⟶ D₀.left :=
    fun W => (Fgt_D.obj W).hom
  let W_k_of : D₀.left.Etale → AlgebraicGeometry.Scheme.{u} :=
    fun W => CategoryTheory.Limits.pullback (h_W_of W) π_k
  let fst_Wk : ∀ W : D₀.left.Etale, W_k_of W ⟶ (Fgt_D.obj W).left :=
    fun W => CategoryTheory.Limits.pullback.fst (h_W_of W) π_k
  let snd_Wk : ∀ W : D₀.left.Etale, W_k_of W ⟶ D_k :=
    fun W => CategoryTheory.Limits.pullback.snd (h_W_of W) π_k
  let W_kU_of : D₀.left.Etale → AlgebraicGeometry.Scheme.{u} :=
    fun W => CategoryTheory.Limits.pullback (fst_Wk W ≫ h_W_of W) U₀.ι
  let i_Wk : ∀ W : D₀.left.Etale, W_kU_of W ⟶ W_k_of W :=
    fun W => CategoryTheory.Limits.pullback.fst (fst_Wk W ≫ h_W_of W) U₀.ι
  let snd_WkU : ∀ W : D₀.left.Etale, W_kU_of W ⟶ U₀.toScheme :=
    fun W => CategoryTheory.Limits.pullback.snd (fst_Wk W ≫ h_W_of W) U₀.ι
  let h_WU_of : ∀ W : D₀.left.Etale, (Fgt_U.obj (B_U.obj W)).left ⟶ U₀.toScheme :=
    fun W => (Fgt_U.obj (B_U.obj W)).hom
  let fst_WU : ∀ W : D₀.left.Etale, (Fgt_U.obj (B_U.obj W)).left ⟶ (Fgt_D.obj W).left :=
    fun W => CategoryTheory.Limits.pullback.fst (h_W_of W) U₀.ι
  let W_Ur_of : D₀.left.Etale → AlgebraicGeometry.Scheme.{u} :=
    fun W => CategoryTheory.Limits.pullback (h_WU_of W) π_r
  let fst_WUr : ∀ W : D₀.left.Etale, W_Ur_of W ⟶ (Fgt_U.obj (B_U.obj W)).left :=
    fun W => CategoryTheory.Limits.pullback.fst (h_WU_of W) π_r
  let snd_WUr : ∀ W : D₀.left.Etale, W_Ur_of W ⟶ V_r :=
    fun W => CategoryTheory.Limits.pullback.snd (h_WU_of W) π_r

  have hΦ_W_cond : ∀ W : D₀.left.Etale,
      (fst_WUr W ≫ fst_WU W) ≫ h_W_of W = (snd_WUr W ≫ q_k) ≫ π_k := by
    intro W
    have hWU_cond : fst_WU W ≫ h_W_of W = h_WU_of W ≫ U₀.ι :=
      CategoryTheory.Limits.pullback.condition
    have hWUr_cond : fst_WUr W ≫ h_WU_of W = snd_WUr W ≫ π_r :=
      CategoryTheory.Limits.pullback.condition
    calc (fst_WUr W ≫ fst_WU W) ≫ h_W_of W
        = fst_WUr W ≫ (fst_WU W ≫ h_W_of W) := CategoryTheory.Category.assoc _ _ _
      _ = (fst_WUr W ≫ h_WU_of W) ≫ U₀.ι := by rw [hWU_cond, CategoryTheory.Category.assoc]
      _ = snd_WUr W ≫ (π_r ≫ U₀.ι) := by rw [hWUr_cond, CategoryTheory.Category.assoc]
      _ = snd_WUr W ≫ (q_k ≫ π_k) := by rw [hqk_πk]
      _ = (snd_WUr W ≫ q_k) ≫ π_k := (CategoryTheory.Category.assoc _ _ _).symm
  let Φ_W : ∀ W : D₀.left.Etale, W_Ur_of W ⟶ W_k_of W :=
    fun W => CategoryTheory.Limits.pullback.lift
      (fst_WUr W ≫ fst_WU W) (snd_WUr W ≫ q_k) (hΦ_W_cond W)
  have hΦ_W_fst : ∀ W : D₀.left.Etale, Φ_W W ≫ fst_Wk W = fst_WUr W ≫ fst_WU W :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hΦ_W_snd : ∀ W : D₀.left.Etale, Φ_W W ≫ snd_Wk W = snd_WUr W ≫ q_k :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hΦ_U_cond : ∀ W : D₀.left.Etale,
      Φ_W W ≫ (fst_Wk W ≫ h_W_of W) = (fst_WUr W ≫ h_WU_of W) ≫ U₀.ι := by
    intro W
    have hWU_cond : fst_WU W ≫ h_W_of W = h_WU_of W ≫ U₀.ι :=
      CategoryTheory.Limits.pullback.condition
    rw [← CategoryTheory.Category.assoc, hΦ_W_fst W, CategoryTheory.Category.assoc, hWU_cond,
      CategoryTheory.Category.assoc]
  let Φ_U : ∀ W : D₀.left.Etale, W_Ur_of W ⟶ W_kU_of W :=
    fun W => CategoryTheory.Limits.pullback.lift
      (Φ_W W) (fst_WUr W ≫ h_WU_of W) (hΦ_U_cond W)
  have hΦ_U_fst : ∀ W : D₀.left.Etale, Φ_U W ≫ i_Wk W = Φ_W W :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hΦ_U_snd : ∀ W : D₀.left.Etale, Φ_U W ≫ snd_WkU W = fst_WUr W ≫ h_WU_of W :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hh_WkU_cond : ∀ W : D₀.left.Etale,
      snd_WkU W ≫ U₀.ι = (i_Wk W ≫ snd_Wk W) ≫ π_k := by
    intro W
    have h1 : i_Wk W ≫ (fst_Wk W ≫ h_W_of W) = snd_WkU W ≫ U₀.ι :=
      CategoryTheory.Limits.pullback.condition
    have h2 : fst_Wk W ≫ h_W_of W = snd_Wk W ≫ π_k :=
      CategoryTheory.Limits.pullback.condition
    calc snd_WkU W ≫ U₀.ι
        = i_Wk W ≫ (fst_Wk W ≫ h_W_of W) := h1.symm
      _ = i_Wk W ≫ (snd_Wk W ≫ π_k) := by rw [h2]
      _ = (i_Wk W ≫ snd_Wk W) ≫ π_k := (CategoryTheory.Category.assoc _ _ _).symm
  let h_WkU : ∀ W : D₀.left.Etale, W_kU_of W ⟶ U_k :=
    fun W => CategoryTheory.Limits.pullback.lift
      (snd_WkU W) (i_Wk W ≫ snd_Wk W) (hh_WkU_cond W)
  have hh_WkU_fst : ∀ W : D₀.left.Etale, h_WkU W ≫ fst_Uk = snd_WkU W :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hh_WkU_snd : ∀ W : D₀.left.Etale, h_WkU W ≫ snd_Uk = i_Wk W ≫ snd_Wk W :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hPb_cube : ∀ W : D₀.left.Etale,
      CategoryTheory.IsPullback (Φ_U W) (snd_WUr W) (h_WkU W) π_rk := by
    intro W
    have hsq : Φ_U W ≫ h_WkU W = snd_WUr W ≫ π_rk := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hh_WkU_fst W, hΦ_U_snd W,
          CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc, hπrk_fst]
      · change (Φ_U W ≫ h_WkU W) ≫ snd_Uk = (snd_WUr W ≫ π_rk) ≫ snd_Uk
        rw [CategoryTheory.Category.assoc, hh_WkU_snd W, ← CategoryTheory.Category.assoc,
          hΦ_U_fst W, hΦ_W_snd W, CategoryTheory.Category.assoc]
    have hl_U_cond : ∀ s : CategoryTheory.Limits.PullbackCone (h_WkU W) π_rk,
        (s.fst ≫ i_Wk W ≫ fst_Wk W) ≫ h_W_of W = (s.fst ≫ snd_WkU W) ≫ U₀.ι := by
      intro s
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
    let l_U : ∀ s : CategoryTheory.Limits.PullbackCone (h_WkU W) π_rk,
        s.pt ⟶ (Fgt_U.obj (B_U.obj W)).left :=
      fun s => CategoryTheory.Limits.pullback.lift
        (s.fst ≫ i_Wk W ≫ fst_Wk W) (s.fst ≫ snd_WkU W) (hl_U_cond s)
    have hl_U_fst : ∀ s : CategoryTheory.Limits.PullbackCone (h_WkU W) π_rk,
        l_U s ≫ fst_WU W = s.fst ≫ i_Wk W ≫ fst_Wk W :=
      fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hl_U_snd : ∀ s : CategoryTheory.Limits.PullbackCone (h_WkU W) π_rk,
        l_U s ≫ h_WU_of W = s.fst ≫ snd_WkU W :=
      fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hlift_cond : ∀ s : CategoryTheory.Limits.PullbackCone (h_WkU W) π_rk,
        l_U s ≫ h_WU_of W = s.snd ≫ π_r := by
      intro s
      have h1 : (s.fst ≫ h_WkU W) ≫ fst_Uk = (s.snd ≫ π_rk) ≫ fst_Uk :=
        congrArg (· ≫ fst_Uk) s.condition
      rw [CategoryTheory.Category.assoc, hh_WkU_fst W,
        CategoryTheory.Category.assoc, hπrk_fst] at h1
      exact (hl_U_snd s).trans h1
    let lift_s : ∀ s : CategoryTheory.Limits.PullbackCone (h_WkU W) π_rk,
        s.pt ⟶ W_Ur_of W :=
      fun s => CategoryTheory.Limits.pullback.lift (l_U s) s.snd (hlift_cond s)
    have hlift_fst_WUr : ∀ s : CategoryTheory.Limits.PullbackCone (h_WkU W) π_rk,
        lift_s s ≫ fst_WUr W = l_U s :=
      fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hlift_snd_WUr : ∀ s : CategoryTheory.Limits.PullbackCone (h_WkU W) π_rk,
        lift_s s ≫ snd_WUr W = s.snd :=
      fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hsq lift_s
        (fun s => by
          have hb : s.fst ≫ i_Wk W ≫ snd_Wk W = s.snd ≫ q_k := by
            have h2 : (s.fst ≫ h_WkU W) ≫ snd_Uk = (s.snd ≫ π_rk) ≫ snd_Uk :=
              congrArg (· ≫ snd_Uk) s.condition
            rwa [CategoryTheory.Category.assoc, hh_WkU_snd W, CategoryTheory.Category.assoc] at h2
          apply CategoryTheory.Limits.pullback.hom_ext
          · change (lift_s s ≫ Φ_U W) ≫ i_Wk W = s.fst ≫ i_Wk W
            rw [CategoryTheory.Category.assoc, hΦ_U_fst W]
            apply CategoryTheory.Limits.pullback.hom_ext
            · change (lift_s s ≫ Φ_W W) ≫ fst_Wk W = (s.fst ≫ i_Wk W) ≫ fst_Wk W
              rw [CategoryTheory.Category.assoc, hΦ_W_fst W, ← CategoryTheory.Category.assoc,
                hlift_fst_WUr s, hl_U_fst s, CategoryTheory.Category.assoc]
            · change (lift_s s ≫ Φ_W W) ≫ snd_Wk W = (s.fst ≫ i_Wk W) ≫ snd_Wk W
              rw [CategoryTheory.Category.assoc, hΦ_W_snd W, ← CategoryTheory.Category.assoc,
                hlift_snd_WUr s, ← hb, CategoryTheory.Category.assoc]
          · change (lift_s s ≫ Φ_U W) ≫ snd_WkU W = s.fst ≫ snd_WkU W
            rw [CategoryTheory.Category.assoc, hΦ_U_snd W, ← CategoryTheory.Category.assoc,
              hlift_fst_WUr s, hl_U_snd s])
        hlift_snd_WUr
        (fun s m hm_fst hm_snd => by
          apply CategoryTheory.Limits.pullback.hom_ext
          · change m ≫ fst_WUr W = lift_s s ≫ fst_WUr W
            rw [hlift_fst_WUr s]
            apply CategoryTheory.Limits.pullback.hom_ext
            · change (m ≫ fst_WUr W) ≫ fst_WU W = l_U s ≫ fst_WU W
              rw [hl_U_fst s, CategoryTheory.Category.assoc, ← hΦ_W_fst W, ← hΦ_U_fst W,
                ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, hm_fst,
                CategoryTheory.Category.assoc]
            · change (m ≫ fst_WUr W) ≫ h_WU_of W = l_U s ≫ h_WU_of W
              rw [hl_U_snd s, CategoryTheory.Category.assoc, ← hΦ_U_snd W,
                ← CategoryTheory.Category.assoc, hm_fst]
          · change m ≫ snd_WUr W = lift_s s ≫ snd_WUr W
            rw [hlift_snd_WUr s, hm_snd]))

  have hEt_ΦU : ∀ W : D₀.left.Etale, AlgebraicGeometry.Etale (Φ_U W) :=
    fun W => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := P_Et) (hPb_cube W).flip hEt_πrk
  have hSurj_ΦU : ∀ W : D₀.left.Etale, AlgebraicGeometry.Surjective (Φ_U W) :=
    fun W => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := P_Surj) (hPb_cube W).flip hSurj_πrk

  let m_γ_can : ∀ (W : D₀.left.Etale) (_ : k ≃ₐ[F] k), W_k_of W ⟶ W_k_of W :=
    fun W γ => CategoryTheory.Limits.pullback.lift
      (fst_Wk W) (snd_Wk W ≫ v_aut γ)
      (by rw [CategoryTheory.Category.assoc, hv_aut_fst γ, CategoryTheory.Limits.pullback.condition])
  have hm_γ_can_fst : ∀ (W : D₀.left.Etale) (γ : k ≃ₐ[F] k),
      m_γ_can W γ ≫ fst_Wk W = fst_Wk W :=
    fun _ _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hm_γ_can_snd : ∀ (W : D₀.left.Etale) (γ : k ≃ₐ[F] k),
      m_γ_can W γ ≫ snd_Wk W = snd_Wk W ≫ v_aut γ :=
    fun _ _ => CategoryTheory.Limits.pullback.lift_snd _ _ _

  let m_σ_can : ∀ (W : D₀.left.Etale) (_ : B_r ≃ₐ[R₀] B_r), W_Ur_of W ⟶ W_Ur_of W :=
    fun W σ => CategoryTheory.Limits.pullback.lift
      (fst_WUr W) (snd_WUr W ≫ d_Br σ)
      (by rw [CategoryTheory.Category.assoc, hdBr_πr σ, CategoryTheory.Limits.pullback.condition])
  have hm_σ_can_fst : ∀ (W : D₀.left.Etale) (σ : B_r ≃ₐ[R₀] B_r),
      m_σ_can W σ ≫ fst_WUr W = fst_WUr W :=
    fun _ _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hm_σ_can_snd : ∀ (W : D₀.left.Etale) (σ : B_r ≃ₐ[R₀] B_r),
      m_σ_can W σ ≫ snd_WUr W = snd_WUr W ≫ d_Br σ :=
    fun _ _ => CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hm_γ_eq : ∀ (W : D₀.left.Etale) (γ : k ≃ₐ[F] k) (m_γ : W_k_of W ⟶ W_k_of W),
      m_γ ≫ fst_Wk W = fst_Wk W →
      m_γ ≫ snd_Wk W = snd_Wk W ≫ v_aut γ →
      m_γ = m_γ_can W γ := by
    intro W γ m_γ hf hs
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact hf.trans (hm_γ_can_fst W γ).symm
    · exact hs.trans (hm_γ_can_snd W γ).symm

  have hm_σ_eq : ∀ (W : D₀.left.Etale) (σ : B_r ≃ₐ[R₀] B_r) (m_σ : W_Ur_of W ⟶ W_Ur_of W),
      m_σ ≫ fst_WUr W = fst_WUr W →
      m_σ ≫ snd_WUr W = snd_WUr W ≫ d_Br σ →
      m_σ = m_σ_can W σ := by
    intro W σ m_σ hf hs
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact hf.trans (hm_σ_can_fst W σ).symm
    · exact hs.trans (hm_σ_can_snd W σ).symm

  have hΦ_W_deck : ∀ (W : D₀.left.Etale) (σ : B_r ≃ₐ[R₀] B_r),
      m_σ_can W σ ≫ Φ_W W = Φ_W W ≫ m_γ_can W (res_k σ) := by
    intro W σ
    apply CategoryTheory.Limits.pullback.hom_ext
    · change (m_σ_can W σ ≫ Φ_W W) ≫ fst_Wk W = (Φ_W W ≫ m_γ_can W (res_k σ)) ≫ fst_Wk W
      calc (m_σ_can W σ ≫ Φ_W W) ≫ fst_Wk W
          = m_σ_can W σ ≫ (Φ_W W ≫ fst_Wk W) := CategoryTheory.Category.assoc _ _ _
        _ = (m_σ_can W σ ≫ fst_WUr W) ≫ fst_WU W := by
            rw [hΦ_W_fst W, CategoryTheory.Category.assoc]
        _ = fst_WUr W ≫ fst_WU W := by rw [hm_σ_can_fst W σ]
        _ = Φ_W W ≫ fst_Wk W := (hΦ_W_fst W).symm
        _ = Φ_W W ≫ (m_γ_can W (res_k σ) ≫ fst_Wk W) := by rw [hm_γ_can_fst W (res_k σ)]
        _ = (Φ_W W ≫ m_γ_can W (res_k σ)) ≫ fst_Wk W :=
            (CategoryTheory.Category.assoc _ _ _).symm
    · change (m_σ_can W σ ≫ Φ_W W) ≫ snd_Wk W = (Φ_W W ≫ m_γ_can W (res_k σ)) ≫ snd_Wk W
      calc (m_σ_can W σ ≫ Φ_W W) ≫ snd_Wk W
          = m_σ_can W σ ≫ (Φ_W W ≫ snd_Wk W) := CategoryTheory.Category.assoc _ _ _
        _ = (m_σ_can W σ ≫ snd_WUr W) ≫ q_k := by
            rw [hΦ_W_snd W, ← CategoryTheory.Category.assoc]
        _ = snd_WUr W ≫ (d_Br σ ≫ q_k) := by
            rw [hm_σ_can_snd W σ, CategoryTheory.Category.assoc]
        _ = (snd_WUr W ≫ q_k) ≫ v_aut (res_k σ) := by
            rw [hqk_equiv σ, ← CategoryTheory.Category.assoc]
        _ = Φ_W W ≫ (snd_Wk W ≫ v_aut (res_k σ)) := by
            rw [← hΦ_W_snd W, CategoryTheory.Category.assoc]
        _ = Φ_W W ≫ (m_γ_can W (res_k σ) ≫ snd_Wk W) := by rw [hm_γ_can_snd W (res_k σ)]
        _ = (Φ_W W ≫ m_γ_can W (res_k σ)) ≫ snd_Wk W :=
            (CategoryTheory.Category.assoc _ _ _).symm

  have hΦ_U_fib : ∀ (W : D₀.left.Etale) (y₁ y₂ : ↥(W_Ur_of W)),
      (Φ_U W).base y₁ = (Φ_U W).base y₂ →
      ∃ σ : B_r ≃ₐ[R₀] B_r, (m_σ_can W σ).base y₁ = y₂ ∧ ρ_𝒢 σ = 1 := by
    intro W y₁ y₂ hy_eq
    let e_pb := (hPb_cube W).isoPullback
    have he_fst : e_pb.hom ≫ CategoryTheory.Limits.pullback.fst (h_WkU W) π_rk = Φ_U W :=
      (hPb_cube W).isoPullback_hom_fst
    have he_snd : e_pb.hom ≫ CategoryTheory.Limits.pullback.snd (h_WkU W) π_rk = snd_WUr W :=
      (hPb_cube W).isoPullback_hom_snd
    have he_inv_fst : e_pb.inv ≫ Φ_U W = CategoryTheory.Limits.pullback.fst (h_WkU W) π_rk :=
      (hPb_cube W).isoPullback_inv_fst
    have he_inv_snd : e_pb.inv ≫ snd_WUr W = CategoryTheory.Limits.pullback.snd (h_WkU W) π_rk :=
      (hPb_cube W).isoPullback_inv_snd
    have hpt_eq : (CategoryTheory.Limits.pullback.fst (h_WkU W) π_rk).base (e_pb.hom.base y₁) =
        (CategoryTheory.Limits.pullback.fst (h_WkU W) π_rk).base (e_pb.hom.base y₂) := by
      have h1 := congrArg (fun g => g.base y₁) he_fst
      have h2 := congrArg (fun g => g.base y₂) he_fst
      exact h1.trans (hy_eq.trans h2.symm)
    obtain ⟨τ, m', hm'_fst, hm'_snd, hm'_pt⟩ :=
      hTorsor_orbits (W_kU_of W) (h_WkU W) (e_pb.hom.base y₁) (e_pb.hom.base y₂) hpt_eq
    obtain ⟨σ, hστ, hρ_σ⟩ := hAut_Rk_triv τ
    have hd_eq : d_ker τ = d_Br σ := by
      dsimp only [d_ker, d_Br]
      refine congrArg AlgebraicGeometry.Spec.map
        (congrArg CommRingCat.ofHom (RingHom.ext fun b => ?_))
      change τ.symm b = σ.symm b
      apply σ.injective
      rw [hστ (τ.symm b), τ.apply_symm_apply, σ.apply_symm_apply]
    let m_τ : W_Ur_of W ⟶ W_Ur_of W := e_pb.hom ≫ m' ≫ e_pb.inv
    have hm_τ_ΦU : m_τ ≫ Φ_U W = Φ_U W := by
      calc (e_pb.hom ≫ m' ≫ e_pb.inv) ≫ Φ_U W
          = e_pb.hom ≫ m' ≫ (e_pb.inv ≫ Φ_U W) := by
              rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        _ = e_pb.hom ≫ (m' ≫ CategoryTheory.Limits.pullback.fst (h_WkU W) π_rk) := by
              rw [he_inv_fst]
        _ = e_pb.hom ≫ CategoryTheory.Limits.pullback.fst (h_WkU W) π_rk := by rw [hm'_fst]
        _ = Φ_U W := he_fst
    have hm_τ_fst : m_τ ≫ fst_WUr W = fst_WUr W := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (m_τ ≫ fst_WUr W) ≫ fst_WU W = fst_WUr W ≫ fst_WU W
        calc (m_τ ≫ fst_WUr W) ≫ fst_WU W
            = m_τ ≫ (fst_WUr W ≫ fst_WU W) := CategoryTheory.Category.assoc _ _ _
          _ = m_τ ≫ ((Φ_U W ≫ i_Wk W) ≫ fst_Wk W) := by rw [← hΦ_W_fst W, ← hΦ_U_fst W]
          _ = ((m_τ ≫ Φ_U W) ≫ i_Wk W) ≫ fst_Wk W := by
                rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc]
          _ = (Φ_U W ≫ i_Wk W) ≫ fst_Wk W := by rw [hm_τ_ΦU]
          _ = fst_WUr W ≫ fst_WU W := by rw [hΦ_U_fst W, hΦ_W_fst W]
      · change (m_τ ≫ fst_WUr W) ≫ h_WU_of W = fst_WUr W ≫ h_WU_of W
        calc (m_τ ≫ fst_WUr W) ≫ h_WU_of W
            = m_τ ≫ (fst_WUr W ≫ h_WU_of W) := CategoryTheory.Category.assoc _ _ _
          _ = (m_τ ≫ Φ_U W) ≫ snd_WkU W := by
                rw [← hΦ_U_snd W, ← CategoryTheory.Category.assoc]
          _ = Φ_U W ≫ snd_WkU W := by rw [hm_τ_ΦU]
          _ = fst_WUr W ≫ h_WU_of W := hΦ_U_snd W
    have hm_τ_snd : m_τ ≫ snd_WUr W = snd_WUr W ≫ d_Br σ := by
      calc (e_pb.hom ≫ m' ≫ e_pb.inv) ≫ snd_WUr W
          = e_pb.hom ≫ m' ≫ (e_pb.inv ≫ snd_WUr W) := by
              rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        _ = e_pb.hom ≫ (m' ≫ CategoryTheory.Limits.pullback.snd (h_WkU W) π_rk) := by
              rw [he_inv_snd]
        _ = (e_pb.hom ≫ CategoryTheory.Limits.pullback.snd (h_WkU W) π_rk) ≫ d_ker τ := by
              rw [hm'_snd, CategoryTheory.Category.assoc]
        _ = snd_WUr W ≫ d_Br σ := by rw [he_snd, hd_eq]
    have hm_τ_eq : m_τ = m_σ_can W σ := hm_σ_eq W σ m_τ hm_τ_fst hm_τ_snd
    refine ⟨σ, ?_, hρ_σ⟩
    rw [← hm_τ_eq]
    calc (e_pb.hom ≫ m' ≫ e_pb.inv).base y₁
        = e_pb.inv.base (m'.base (e_pb.hom.base y₁)) := rfl
      _ = e_pb.inv.base (e_pb.hom.base y₂) := by rw [hm'_pt]
      _ = (e_pb.hom ≫ e_pb.inv).base y₂ := rfl
      _ = (𝟙 (W_Ur_of W) : W_Ur_of W ⟶ W_Ur_of W).base y₂ := by rw [e_pb.hom_inv_id]
      _ = y₂ := rfl

  have hΦ_W_nat : ∀ {W₁ W₂ : D₀.left.Etale} (u : W₁ ⟶ W₂)
      (u_k : W_k_of W₁ ⟶ W_k_of W₂)
      (u_r : W_Ur_of W₁ ⟶ W_Ur_of W₂),
      u_k ≫ fst_Wk W₂ = fst_Wk W₁ ≫ (Fgt_D.map u).left →
      u_k ≫ snd_Wk W₂ = snd_Wk W₁ →
      u_r ≫ fst_WUr W₂ = fst_WUr W₁ ≫ (Fgt_U.map (B_U.map u)).left →
      u_r ≫ snd_WUr W₂ = snd_WUr W₁ →
      Φ_W W₁ ≫ u_k = u_r ≫ Φ_W W₂ := by
    intro W₁ W₂ u u_k u_r huk_fst huk_snd hur_fst hur_snd
    have hBU_fst : (Fgt_U.map (B_U.map u)).left ≫ fst_WU W₂ = fst_WU W₁ ≫ (Fgt_D.map u).left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    apply CategoryTheory.Limits.pullback.hom_ext
    · change (Φ_W W₁ ≫ u_k) ≫ fst_Wk W₂ = (u_r ≫ Φ_W W₂) ≫ fst_Wk W₂
      calc (Φ_W W₁ ≫ u_k) ≫ fst_Wk W₂
          = Φ_W W₁ ≫ (u_k ≫ fst_Wk W₂) := CategoryTheory.Category.assoc _ _ _
        _ = (Φ_W W₁ ≫ fst_Wk W₁) ≫ (Fgt_D.map u).left := by
              rw [huk_fst, CategoryTheory.Category.assoc]
        _ = fst_WUr W₁ ≫ (fst_WU W₁ ≫ (Fgt_D.map u).left) := by
              rw [hΦ_W_fst W₁, CategoryTheory.Category.assoc]
        _ = (fst_WUr W₁ ≫ (Fgt_U.map (B_U.map u)).left) ≫ fst_WU W₂ := by
              rw [← hBU_fst, CategoryTheory.Category.assoc]
        _ = u_r ≫ (fst_WUr W₂ ≫ fst_WU W₂) := by
              rw [← hur_fst, CategoryTheory.Category.assoc]
        _ = u_r ≫ (Φ_W W₂ ≫ fst_Wk W₂) := by rw [hΦ_W_fst W₂]
        _ = (u_r ≫ Φ_W W₂) ≫ fst_Wk W₂ := (CategoryTheory.Category.assoc _ _ _).symm
    · change (Φ_W W₁ ≫ u_k) ≫ snd_Wk W₂ = (u_r ≫ Φ_W W₂) ≫ snd_Wk W₂
      calc (Φ_W W₁ ≫ u_k) ≫ snd_Wk W₂
          = Φ_W W₁ ≫ (u_k ≫ snd_Wk W₂) := CategoryTheory.Category.assoc _ _ _
        _ = snd_WUr W₁ ≫ q_k := by rw [huk_snd, hΦ_W_snd W₁]
        _ = u_r ≫ (snd_WUr W₂ ≫ q_k) := by rw [← hur_snd, CategoryTheory.Category.assoc]
        _ = u_r ≫ (Φ_W W₂ ≫ snd_Wk W₂) := by rw [hΦ_W_snd W₂]
        _ = (u_r ≫ Φ_W W₂) ≫ snd_Wk W₂ := (CategoryTheory.Category.assoc _ _ _).symm

  
  
  
  
  let A_vec := Fin K → Λ

  have hEt_Wk_D₀ : ∀ W : D₀.left.Etale, AlgebraicGeometry.Etale (fst_Wk W ≫ h_W_of W) := by
    intro W
    have hEt_fstWk : AlgebraicGeometry.Etale (fst_Wk W) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := P_Et) (CategoryTheory.IsPullback.of_hasPullback (h_W_of W) π_k).flip hEt_πk
    exact CategoryTheory.MorphismProperty.comp_mem P_Et (fst_Wk W) (h_W_of W) hEt_fstWk W.prop

  have hBij_WkU : ∀ W : D₀.left.Etale,
      Function.Bijective
        (fun f : LocallyConstant ↥(W_k_of W) A_vec => f.comap (i_Wk W).base.hom) := by
    intro W
    have : AlgebraicGeometry.Etale (fst_Wk W ≫ h_W_of W) := hEt_Wk_D₀ W
    exact _hLC_ext (W_k_of W) (fst_Wk W ≫ h_W_of W)

  have hInj_ΦW : ∀ W : D₀.left.Etale,
      Function.Injective
        (fun f : LocallyConstant ↥(W_k_of W) A_vec => f.comap (Φ_W W).base.hom) := by
    intro W f₁ f₂ hfeq
    have : AlgebraicGeometry.Surjective (Φ_U W) := hSurj_ΦU W
    apply (hBij_WkU W).1
    apply LocallyConstant.ext
    intro z
    obtain ⟨y, rfl⟩ := (Φ_U W).surjective z
    have hpt : (i_Wk W).base ((Φ_U W).base y) = (Φ_W W).base y := by
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hΦ_U_fst W]
    change f₁ ((i_Wk W).base ((Φ_U W).base y)) = f₂ ((i_Wk W).base ((Φ_U W).base y))
    rw [hpt]
    exact congrArg (fun g : LocallyConstant ↥(W_Ur_of W) A_vec => g y) hfeq

  have hEquiv_iff : ∀ (W : D₀.left.Etale) (f : LocallyConstant ↥(W_k_of W) A_vec),
      (∀ (γ : k ≃ₐ[F] k) (x : ↥(W_k_of W)),
        f ((m_γ_can W γ).base x) = ((ρ_bar γ).val).mulVec (f x)) ↔
      (∀ (σ : B_r ≃ₐ[R₀] B_r) (y : ↥(W_Ur_of W)),
        (f.comap (Φ_W W).base.hom) ((m_σ_can W σ).base y) =
          ((ρ_𝒢 σ).val).mulVec ((f.comap (Φ_W W).base.hom) y)) := by
    intro W f
    constructor
    · intro hfk σ y
      change f ((Φ_W W).base ((m_σ_can W σ).base y)) =
        ((ρ_𝒢 σ).val).mulVec (f ((Φ_W W).base y))
      have hpt : (Φ_W W).base ((m_σ_can W σ).base y) =
          (m_γ_can W (res_k σ)).base ((Φ_W W).base y) := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hΦ_W_deck W σ,
          AlgebraicGeometry.Scheme.Hom.comp_apply]
      rw [hpt, hfk (res_k σ) ((Φ_W W).base y), _hρ_bar_eq σ]
    · intro hfr γ
      obtain ⟨σ, hσ⟩ := _hres_surj γ
      let g₁ : LocallyConstant ↥(W_k_of W) A_vec := f.comap (m_γ_can W γ).base.hom
      let g₂ : LocallyConstant ↥(W_k_of W) A_vec := f.map (fun v => ((ρ_bar γ).val).mulVec v)
      have hg_eq : g₁ = g₂ := by
        apply hInj_ΦW W
        apply LocallyConstant.ext
        intro y
        change f ((m_γ_can W γ).base ((Φ_W W).base y)) =
          ((ρ_bar γ).val).mulVec (f ((Φ_W W).base y))
        rw [← hσ]
        have hpt : (m_γ_can W (res_k σ)).base ((Φ_W W).base y) =
            (Φ_W W).base ((m_σ_can W σ).base y) := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, ← hΦ_W_deck W σ,
            AlgebraicGeometry.Scheme.Hom.comp_apply]
        rw [hpt, _hρ_bar_eq σ]
        exact hfr σ y
      intro x
      exact congrArg (fun g : LocallyConstant ↥(W_k_of W) A_vec => g x) hg_eq

  have hDescend : ∀ (W : D₀.left.Etale) (f_r : LocallyConstant ↥(W_Ur_of W) A_vec),
      (∀ (σ : B_r ≃ₐ[R₀] B_r) (y : ↥(W_Ur_of W)),
        f_r ((m_σ_can W σ).base y) = ((ρ_𝒢 σ).val).mulVec (f_r y)) →
      ∃ f : LocallyConstant ↥(W_k_of W) A_vec,
        (∀ (γ : k ≃ₐ[F] k) (x : ↥(W_k_of W)),
          f ((m_γ_can W γ).base x) = ((ρ_bar γ).val).mulVec (f x)) ∧
        f.comap (Φ_W W).base.hom = f_r := by
    intro W f_r hfr
    have : AlgebraicGeometry.Etale (Φ_U W) := hEt_ΦU W
    have : AlgebraicGeometry.Surjective (Φ_U W) := hSurj_ΦU W
    have hFib_const : ∀ y₁ y₂ : ↥(W_Ur_of W), (Φ_U W).base y₁ = (Φ_U W).base y₂ →
        f_r y₁ = f_r y₂ := by
      intro y₁ y₂ hy_eq
      obtain ⟨σ, hm_pt, hρ_one⟩ := hΦ_U_fib W y₁ y₂ hy_eq
      calc f_r y₁ = (1 : Matrix (Fin K) (Fin K) Λ).mulVec (f_r y₁) := (Matrix.one_mulVec _).symm
        _ = ((ρ_𝒢 σ).val).mulVec (f_r y₁) := by rw [hρ_one]; rfl
        _ = f_r ((m_σ_can W σ).base y₁) := (hfr σ y₁).symm
        _ = f_r y₂ := by rw [hm_pt]
    let g₀ : ↥(W_kU_of W) → A_vec :=
      fun z => f_r (Classical.choose ((Φ_U W).surjective z))
    have hg₀_comp : ∀ y : ↥(W_Ur_of W), g₀ ((Φ_U W).base y) = f_r y :=
      fun y => hFib_const _ y (Classical.choose_spec ((Φ_U W).surjective ((Φ_U W).base y)))
    have hg₀_lc : IsLocallyConstant g₀ := by
      intro S_set
      have hpre : g₀ ⁻¹' S_set = (Φ_U W).base '' (f_r ⁻¹' S_set) := by
        ext z
        simp only [Set.mem_preimage, Set.mem_image]
        constructor
        · intro hz
          exact ⟨Classical.choose ((Φ_U W).surjective z), hz,
            Classical.choose_spec ((Φ_U W).surjective z)⟩
        · rintro ⟨y, hy, rfl⟩
          rwa [hg₀_comp y]
      rw [hpre]
      exact (Φ_U W).isOpenMap _ (f_r.isLocallyConstant S_set)
    let g : LocallyConstant ↥(W_kU_of W) A_vec := ⟨g₀, hg₀_lc⟩
    obtain ⟨f, hf_comap⟩ := (hBij_WkU W).2 g
    have hf_comap' : f.comap (i_Wk W).base.hom = g := hf_comap
    have hf_ΦW : f.comap (Φ_W W).base.hom = f_r := by
      apply LocallyConstant.ext
      intro y
      have hpt : (Φ_W W).base y = (i_Wk W).base ((Φ_U W).base y) := by
        rw [← hΦ_U_fst W, AlgebraicGeometry.Scheme.Hom.comp_apply]
      calc (f.comap (Φ_W W).base.hom) y
          = f ((Φ_W W).base y) := rfl
        _ = (f.comap (i_Wk W).base.hom) ((Φ_U W).base y) := by
            change f ((Φ_W W).base y) = f ((i_Wk W).base ((Φ_U W).base y))
            rw [hpt]
        _ = g ((Φ_U W).base y) := by rw [hf_comap']
        _ = f_r y := hg₀_comp y
    refine ⟨f, (hEquiv_iff W f).mpr ?_, hf_ΦW⟩
    rw [hf_ΦW]
    exact hfr

  have hMem_site : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (W : Z.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ Z.smallEtaleTopology W ↔
        ∀ x : ↥W.left,
          ∃ (Y : Z.Etale) (g : Y ⟶ W) (y : ↥Y.left),
            R.arrows g ∧ P_Et g.left ∧ g.left.base y = x := by
    intro Z W R
    have heq : Z.smallGrothendieckTopology P_Et =
        (AlgebraicGeometry.Scheme.smallPretopology P_Et P_Et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        Z (le_refl P_Et)
    exact (iff_of_eq (congrArg
      (fun J : CategoryTheory.GrothendieckTopology Z.Etale => R ∈ J W) heq)).trans
      (@AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology P_Et P_Et Z hPEt_comp
        inferInstance inferInstance inferInstance inferInstance W R)
  have : CategoryTheory.MorphismProperty.HasPullbacksAlong P_Et U₀.ι :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P_Et U₀.ι :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have hBU_eq : B_U = CategoryTheory.MorphismProperty.Over.pullback P_Et ⊤ U₀.ι := rfl
  let T_D : D₀.left.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 D₀.left)
  have hTerm_D : CategoryTheory.Limits.IsTerminal T_D :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun E => CategoryTheory.MorphismProperty.Over.homMk E.hom
        (CategoryTheory.Category.comp_id E.hom))
      (fun E m => CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.comp_id m.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w m)))
  have : CategoryTheory.Limits.HasTerminal D₀.left.Etale := hTerm_D.hasTerminal
  have : CategoryTheory.Limits.HasPullbacks D₀.left.Etale :=
    CategoryTheory.MorphismProperty.Over.hasPullbacks P_Et D₀.left
  have : CategoryTheory.Limits.HasFiniteLimits D₀.left.Etale :=
    CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
  have : CategoryTheory.Limits.PreservesFiniteLimits B_U := by
    rw [hBU_eq]
    exact CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback P_Et U₀.ι
  have : CategoryTheory.RepresentablyFlat B_U :=
    CategoryTheory.flat_of_preservesFiniteLimits B_U
  have hCompat_U : CategoryTheory.CompatiblePreserving U₀.toScheme.smallEtaleTopology B_U :=
    CategoryTheory.compatiblePreservingOfFlat U₀.toScheme.smallEtaleTopology B_U
  have hCov_U : CategoryTheory.CoverPreserving
      D₀.left.smallEtaleTopology U₀.toScheme.smallEtaleTopology B_U := by
    refine ⟨fun {U} {R} hR =>
      (hMem_site U₀.toScheme (B_U.obj U) (R.functorPushforward B_U)).mpr fun z => ?_⟩
    let fstU := CategoryTheory.Limits.pullback.fst U.hom U₀.ι
    obtain ⟨Y, g, y, hgR, _, hy⟩ := (hMem_site D₀.left U R).mp hR (fstU.base z)
    have hBg_mem : (R.functorPushforward B_U).arrows (B_U.map g) :=
      CategoryTheory.Sieve.image_mem_functorPushforward B_U R hgR
    have hBg_w : (B_U.map g).left ≫ (B_U.obj U).hom = (B_U.obj Y).hom :=
      CategoryTheory.MorphismProperty.Over.w (B_U.map g)
    have hBg_et : P_Et (B_U.map g).left :=
      CategoryTheory.MorphismProperty.of_postcomp P_Et (B_U.map g).left (B_U.obj U).hom
        (B_U.obj U).prop (by rw [hBg_w]; exact (B_U.obj Y).prop)
    let fstY := CategoryTheory.Limits.pullback.fst Y.hom U₀.ι
    have hOuter : CategoryTheory.IsPullback
        ((B_U.map g).left ≫ (B_U.obj U).hom) fstY U₀.ι (g.left ≫ U.hom) := by
      rw [hBg_w, CategoryTheory.MorphismProperty.Over.w g]
      exact (CategoryTheory.IsPullback.of_hasPullback Y.hom U₀.ι).flip
    have hRight : CategoryTheory.IsPullback (B_U.obj U).hom fstU U₀.ι U.hom :=
      (CategoryTheory.IsPullback.of_hasPullback U.hom U₀.ι).flip
    have hCommSq : (B_U.map g).left ≫ fstU = fstY ≫ g.left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hLeft : CategoryTheory.IsPullback (B_U.map g).left fstY fstU g.left :=
      CategoryTheory.IsPullback.of_right hOuter hCommSq hRight
    obtain ⟨w₀, hw₀_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hy.symm
    refine ⟨B_U.obj Y, B_U.map g, hLeft.isoPullback.inv.base w₀, hBg_mem, hBg_et, ?_⟩
    have hinv : (hLeft.isoPullback.inv ≫ (B_U.map g).left).base w₀ =
        (CategoryTheory.Limits.pullback.fst fstU g.left).base w₀ :=
      congrArg (fun k => k.base w₀) hLeft.isoPullback_inv_fst
    exact hinv.trans hw₀_fst
  have hCont_U : B_U.IsContinuous
      D₀.left.smallEtaleTopology U₀.toScheme.smallEtaleTopology :=
    CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat_U hCov_U

  let J_D := D₀.left.smallEtaleTopology
  let J_U := U₀.toScheme.smallEtaleTopology
  let P_U := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
    B_U AddCommGrpCat.{u} _ J_D J_U hCont_U
  let 𝒢_tilde : CategoryTheory.Sheaf J_D AddCommGrpCat.{u} := P_U.obj 𝒢₀

  have hSec_desc : ∀ (W : D₀.left.Etale)
      (s : ↑(𝒢₀.obj.obj (Opposite.op (B_U.obj W)))),
      ∃ f : LocallyConstant ↥(W_k_of W) A_vec,
        (∀ (γ : k ≃ₐ[F] k) (x : ↥(W_k_of W)),
          f ((m_γ_can W γ).base x) = ((ρ_bar γ).val).mulVec (f x)) ∧
        f.comap (Φ_W W).base.hom = triv_𝒢 (B_U.obj W) s := by
    intro W s
    apply hDescend W (triv_𝒢 (B_U.obj W) s)
    have hmem : triv_𝒢 (B_U.obj W) s ∈ Set.range (triv_𝒢 (B_U.obj W)) := ⟨s, rfl⟩
    rw [(_htriv_𝒢.2 (B_U.obj W)).2] at hmem
    intro σ y
    exact hmem σ (m_σ_can W σ)
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _) y

  let triv_tilde_raw : ∀ W : D₀.left.Etale,
      ↑(𝒢₀.obj.obj (Opposite.op (B_U.obj W))) →+ LocallyConstant ↥(W_k_of W) A_vec :=
    fun W =>
      { toFun := fun s => Classical.choose (hSec_desc W s)
        map_zero' := by
          apply hInj_ΦW W
          change (Classical.choose (hSec_desc W 0)).comap (Φ_W W).base.hom =
            (0 : LocallyConstant ↥(W_k_of W) A_vec).comap (Φ_W W).base.hom
          rw [(Classical.choose_spec (hSec_desc W 0)).2, map_zero]
          rfl
        map_add' := fun s₁ s₂ => by
          apply hInj_ΦW W
          change (Classical.choose (hSec_desc W (s₁ + s₂))).comap (Φ_W W).base.hom =
            (Classical.choose (hSec_desc W s₁) +
              Classical.choose (hSec_desc W s₂)).comap (Φ_W W).base.hom
          rw [(Classical.choose_spec (hSec_desc W (s₁ + s₂))).2, map_add]
          apply LocallyConstant.ext
          intro y
          change triv_𝒢 (B_U.obj W) s₁ y + triv_𝒢 (B_U.obj W) s₂ y =
            (Classical.choose (hSec_desc W s₁)).comap (Φ_W W).base.hom y +
              (Classical.choose (hSec_desc W s₂)).comap (Φ_W W).base.hom y
          rw [(Classical.choose_spec (hSec_desc W s₁)).2,
            (Classical.choose_spec (hSec_desc W s₂)).2] }
  let triv_tilde : ∀ W : D₀.left.Etale,
      ↑(𝒢_tilde.obj.obj (Opposite.op W)) →+ LocallyConstant ↥(W_k_of W) A_vec :=
    triv_tilde_raw

  
  
  
  
  let S_pre := CategoryTheory.sheafToPresheaf J_U AddCommGrpCat.{u}
  let L_U := CategoryTheory.presheafToSheaf J_U AddCommGrpCat.{u}
  let adj_sh := CategoryTheory.sheafificationAdjunction J_U AddCommGrpCat.{u}
  have : S_pre.Additive := adj_sh.right_adjoint_additive
  let adj_ab := CategoryTheory.Adjunction.whiskerRight (Opposite U₀.toScheme.Etale)
    (AddCommGrpCat.adj :
      CategoryTheory.Adjunction AddCommGrpCat.free (CategoryTheory.forget AddCommGrpCat.{u}))
  let P_E : U₀.toScheme.Etale →
      CategoryTheory.Functor (Opposite U₀.toScheme.Etale) AddCommGrpCat.{u} :=
    fun E => (CategoryTheory.yoneda.obj E).comp AddCommGrpCat.free
  let F_E : U₀.toScheme.Etale → CategoryTheory.Sheaf J_U AddCommGrpCat.{u} :=
    fun E => L_U.obj (P_E E)
  let e₁ : ∀ E : U₀.toScheme.Etale,
      CategoryTheory.Abelian.Ext (F_E E) 𝒢₀ 0 ≃ (F_E E ⟶ 𝒢₀) :=
    fun E => (CategoryTheory.Abelian.Ext.addEquiv₀ (X := F_E E) (Y := 𝒢₀)).toEquiv
  let e₂ : ∀ E : U₀.toScheme.Etale, (F_E E ⟶ 𝒢₀) ≃ (P_E E ⟶ S_pre.obj 𝒢₀) :=
    fun E => adj_sh.homEquiv (P_E E) 𝒢₀
  let e₃ : ∀ E : U₀.toScheme.Etale,
      (P_E E ⟶ S_pre.obj 𝒢₀) ≃
        (CategoryTheory.yoneda.obj E ⟶
          (S_pre.obj 𝒢₀).comp (CategoryTheory.forget AddCommGrpCat.{u})) :=
    fun E => adj_ab.homEquiv (CategoryTheory.yoneda.obj E) (S_pre.obj 𝒢₀)
  let e₄ : ∀ E : U₀.toScheme.Etale,
      (CategoryTheory.yoneda.obj E ⟶
          (S_pre.obj 𝒢₀).comp (CategoryTheory.forget AddCommGrpCat.{u})) ≃
        ↥((S_pre.obj 𝒢₀).obj (Opposite.op E)) :=
    fun _ => CategoryTheory.yonedaEquiv
  let evHom : ∀ E : U₀.toScheme.Etale, (F_E E ⟶ 𝒢₀) ≃ ↥((S_pre.obj 𝒢₀).obj (Opposite.op E)) :=
    fun E => (e₂ E).trans ((e₃ E).trans (e₄ E))
  let u₀_gen : ∀ E : U₀.toScheme.Etale, ↥((P_E E).obj (Opposite.op E)) :=
    fun E => (CategoryTheory.ConcreteCategory.hom
      ((adj_ab.unit.app (CategoryTheory.yoneda.obj E)).app (Opposite.op E))) (𝟙 E)
  let gen_E : ∀ E : U₀.toScheme.Etale, ↥((S_pre.obj (F_E E)).obj (Opposite.op E)) :=
    fun E => (CategoryTheory.ConcreteCategory.hom
      ((adj_sh.unit.app (P_E E)).app (Opposite.op E))) (u₀_gen E)
  have hevHom : ∀ (E : U₀.toScheme.Etale) (g : F_E E ⟶ 𝒢₀),
      evHom E g =
        (CategoryTheory.ConcreteCategory.hom ((S_pre.map g).app (Opposite.op E))) (gen_E E) := by
    intro E g
    dsimp [evHom, e₂, e₃, e₄, gen_E, u₀_gen]
    rw [CategoryTheory.yonedaEquiv_apply, adj_ab.homEquiv_unit, adj_sh.homEquiv_unit]
    rfl
  let addEquivObj : ∀ E : U₀.toScheme.Etale,
      CategoryTheory.Abelian.Ext (F_E E) 𝒢₀ 0 ≃+ ↥((S_pre.obj 𝒢₀).obj (Opposite.op E)) :=
    fun E => AddEquiv.mk' ((e₁ E).trans (evHom E)) (by
      intro α β
      dsimp [e₁]
      rw [map_add, hevHom, hevHom, hevHom, S_pre.map_add]
      rfl)
  let isoShRev : (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).obj 𝒢₀ ≅ S_pre.obj 𝒢₀ :=
    CategoryTheory.NatIso.ofComponents
      (fun W_op => (addEquivObj W_op.unop).toAddCommGrpIso)
      (by
        intro W₁ W₂ v
        let E₁ := W₁.unop
        let E₂ := W₂.unop
        let u : E₂ ⟶ E₁ := v.unop
        apply AddCommGrpCat.ext
        intro α
        let α' : CategoryTheory.Abelian.Ext (F_E E₁) 𝒢₀ 0 := α
        let g : F_E E₁ ⟶ 𝒢₀ := CategoryTheory.Abelian.Ext.addEquiv₀ α'
        let φ_u : F_E E₂ ⟶ F_E E₁ :=
          L_U.map (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u)
            AddCommGrpCat.free)
        have hmap : (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).obj 𝒢₀).map v) α =
            CategoryTheory.Abelian.Ext.mk₀ (φ_u ≫ g) := by
          change (CategoryTheory.Abelian.Ext.mk₀ φ_u).comp α' (Nat.zero_add 0) = _
          rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α']
          exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ φ_u g
        change (addEquivObj E₂)
            ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).obj 𝒢₀).map v) α) =
          ((S_pre.obj 𝒢₀).map v) ((addEquivObj E₁) α)
        rw [hmap]
        have hlhs : (addEquivObj E₂) (CategoryTheory.Abelian.Ext.mk₀ (φ_u ≫ g)) =
            evHom E₂ (φ_u ≫ g) := by
          change evHom E₂ (CategoryTheory.Abelian.Ext.addEquiv₀
            (CategoryTheory.Abelian.Ext.mk₀ (φ_u ≫ g))) = _
          rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply (φ_u ≫ g),
            AddEquiv.apply_symm_apply]
        have hrhs : (addEquivObj E₁) α' = evHom E₁ g := rfl
        rw [hlhs, hrhs]
        dsimp [evHom, e₂, e₃, e₄, φ_u]
        rw [adj_sh.homEquiv_naturality_left,
          ← CategoryTheory.Functor.whiskeringRight_obj_map,
          adj_ab.homEquiv_naturality_left,
          ← CategoryTheory.yonedaEquiv_naturality]
        rfl)

  let L_D := CategoryTheory.presheafToSheaf J_D AddCommGrpCat.{u}
  let W_U := (CategoryTheory.Functor.whiskeringLeft
    (Opposite D₀.left.Etale) (Opposite U₀.toScheme.Etale) AddCommGrpCat.{u}).obj B_U.op
  have : CategoryTheory.IsIso
      (CategoryTheory.sheafificationAdjunction J_D AddCommGrpCat.{u}).counit :=
    CategoryTheory.sheafification_reflective
  let ε_D := CategoryTheory.asIso
    ((CategoryTheory.sheafificationAdjunction J_D AddCommGrpCat.{u}).counit.app 𝒢_tilde)
  let iso_H0 : 𝒢_tilde ≅ weilEtaleHigherDirectImage U₀.ι 0 𝒢₀ :=
    ε_D.symm ≪≫
      L_D.mapIso
        ((CategoryTheory.Functor.sheafPushforwardContinuousCompSheafToPresheafIso
            B_U AddCommGrpCat.{u} J_D J_U).app 𝒢₀ ≪≫
          W_U.mapIso isoShRev.symm)

  
  
  
  refine ⟨hEt_πk, 𝒢_tilde, triv_tilde, ?_, ?_, ⟨iso_H0⟩⟩
  · intro W₁ W₂ u h₁ h₂ u_k huk_fst huk_snd s y₁
    let u_U := B_U.map u
    have hu_r_cond : (fst_WUr W₁ ≫ (Fgt_U.map u_U).left) ≫ h_WU_of W₂ = snd_WUr W₁ ≫ π_r := by
      rw [CategoryTheory.Category.assoc, (Fgt_U.map u_U).w,
        CategoryTheory.Limits.pullback.condition]
    let u_r : W_Ur_of W₁ ⟶ W_Ur_of W₂ :=
      CategoryTheory.Limits.pullback.lift
        (fst_WUr W₁ ≫ (Fgt_U.map u_U).left) (snd_WUr W₁) hu_r_cond
    have hur_fst : u_r ≫ fst_WUr W₂ = fst_WUr W₁ ≫ (Fgt_U.map u_U).left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hur_snd : u_r ≫ snd_WUr W₂ = snd_WUr W₁ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hcomm_nat : Φ_W W₁ ≫ u_k = u_r ≫ Φ_W W₂ :=
      hΦ_W_nat u u_k u_r huk_fst huk_snd hur_fst hur_snd
    have hfun_eq : triv_tilde W₁ ((𝒢_tilde.obj.map (Opposite.op u)) s) =
        (triv_tilde W₂ s).comap u_k.base.hom := by
      apply hInj_ΦW W₁
      apply LocallyConstant.ext
      intro z₁
      have hlhs : ((triv_tilde W₁ ((𝒢_tilde.obj.map (Opposite.op u)) s)).comap
          (Φ_W W₁).base.hom) z₁ =
          triv_𝒢 (B_U.obj W₁) ((𝒢₀.obj.map (Opposite.op u_U)) s) z₁ := by
        have hspec := (Classical.choose_spec
          (hSec_desc W₁ ((𝒢_tilde.obj.map (Opposite.op u)) s))).2
        exact congrArg (fun g : LocallyConstant ↥(W_Ur_of W₁) A_vec => g z₁) hspec
      rw [hlhs, _htriv_𝒢.1 u_U u_r hur_fst hur_snd s z₁]
      have hpt : u_k.base ((Φ_W W₁).base z₁) = (Φ_W W₂).base (u_r.base z₁) := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hcomm_nat,
          AlgebraicGeometry.Scheme.Hom.comp_apply]
      change _ = triv_tilde W₂ s (u_k.base ((Φ_W W₁).base z₁))
      rw [hpt]
      have hspec₂ := (Classical.choose_spec (hSec_desc W₂ s)).2
      exact (congrArg (fun g : LocallyConstant ↥(W_Ur_of W₂) A_vec => g (u_r.base z₁)) hspec₂).symm
    exact congrArg (fun g : LocallyConstant ↥(W_k_of W₁) A_vec => g y₁) hfun_eq
  · intro W h_W W_k
    refine ⟨?_, ?_⟩
    · intro s₁ s₂ hseq
      apply (_htriv_𝒢.2 (B_U.obj W)).1
      rw [← (Classical.choose_spec (hSec_desc W s₁)).2,
        ← (Classical.choose_spec (hSec_desc W s₂)).2]
      exact congrArg (fun f : LocallyConstant ↥(W_k_of W) A_vec => f.comap (Φ_W W).base.hom) hseq
    · ext f
      simp only [Set.mem_range, Set.mem_ofPred]
      constructor
      · rintro ⟨s, rfl⟩ γ m_γ hm_fst hm_snd y
        have hm_eq : m_γ = m_γ_can W γ := hm_γ_eq W γ m_γ hm_fst hm_snd
        rw [hm_eq]
        exact (Classical.choose_spec (hSec_desc W s)).1 γ y
      · intro hf_equiv
        have hf_can : ∀ (γ : k ≃ₐ[F] k) (x : ↥(W_k_of W)),
            f ((m_γ_can W γ).base x) = ((ρ_bar γ).val).mulVec (f x) :=
          fun γ x => hf_equiv γ (m_γ_can W γ)
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) x
        have hfr_can := (hEquiv_iff W f).mp hf_can
        have hfr_mem : f.comap (Φ_W W).base.hom ∈ Set.range (triv_𝒢 (B_U.obj W)) := by
          rw [(_htriv_𝒢.2 (B_U.obj W)).2]
          intro σ m_σ hm_fst hm_snd y
          have hm_eq : m_σ = m_σ_can W σ := hm_σ_eq W σ m_σ hm_fst hm_snd
          rw [hm_eq]
          exact hfr_can σ y
        obtain ⟨s, hs⟩ := hfr_mem
        refine ⟨s, ?_⟩
        apply hInj_ΦW W
        exact (Classical.choose_spec (hSec_desc W s)).2.trans hs

theorem weil_mid_dev_baseChange_galois_sheaf_pullback_const (F : Type u) [Finite F] [Field F]
    (Y₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (k : Type u) [Finite k] [Field k] [Algebra F k] [Module.Finite F k] [Algebra.Etale F k]
    (K : ℕ) (Λ : Type) [CommRing Λ]
    (ρ_bar : (k ≃ₐ[F] k) →* (Matrix (Fin K) (Fin K) Λ)ˣ) :
    let Y_k := (weilBaseChangeOver F k Y₀).left
    let f_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
    let π_k : Quiver.Hom Y_k Y₀.left := CategoryTheory.Limits.pullback.fst Y₀.hom f_k
    let A_K : AddCommGrpCat.{u} :=
      AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin K → Λ))
    let C_Yk := (CategoryTheory.constantSheaf Y_k.smallEtaleTopology AddCommGrpCat.{u}).obj A_K
    ∀ [AlgebraicGeometry.Etale π_k]
      (_hMem_Y₀ : ∀ (W : Y₀.left.Etale) (R_sieve : CategoryTheory.Sieve W),
        R_sieve ∈ Y₀.left.smallEtaleTopology W ↔
          ∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget Y₀.left).obj W).left,
            ∃ (Y : Y₀.left.Etale) (f : Y ⟶ W)
              (y : ↥((AlgebraicGeometry.Scheme.Etale.forget Y₀.left).obj Y).left),
              R_sieve.arrows f ∧
              AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget Y₀.left).map f).left ∧
              ((AlgebraicGeometry.Scheme.Etale.forget Y₀.left).map f).left.base y = x)
      (_hMem_Yk : ∀ (W : Y_k.Etale) (R_sieve : CategoryTheory.Sieve W),
        R_sieve ∈ Y_k.smallEtaleTopology W ↔
          ∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget Y_k).obj W).left,
            ∃ (Y : Y_k.Etale) (f : Y ⟶ W)
              (y : ↥((AlgebraicGeometry.Scheme.Etale.forget Y_k).obj Y).left),
              R_sieve.arrows f ∧
              AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget Y_k).map f).left ∧
              ((AlgebraicGeometry.Scheme.Etale.forget Y_k).map f).left.base y = x)
      (hCont_k : (weilEtaleSitePullback π_k).IsContinuous
        Y₀.left.smallEtaleTopology Y_k.smallEtaleTopology)
      (_hAdj_k : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback π_k) AddCommGrpCat.{u} _
        Y₀.left.smallEtaleTopology Y_k.smallEtaleTopology hCont_k).IsRightAdjoint)
      (hT_Yk : CategoryTheory.Limits.IsTerminal (AlgebraicGeometry.Scheme.Etale.mk (𝟙 Y_k)))
      (θ_Yk : ∀ Y : Y_k.Etale,
        LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget Y_k).obj Y).left ↥A_K →+
          ↑(C_Yk.obj.obj (Opposite.op Y)))
      (_hθ_bij : ∀ Y : Y_k.Etale, Function.Bijective (θ_Yk Y))
      (_hθ_nat : ∀ {Y₁ Y₂ : Y_k.Etale} (f : Y₁ ⟶ Y₂)
        (g : LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget Y_k).obj Y₂).left ↥A_K),
        (C_Yk.obj.map (Opposite.op f)).hom (θ_Yk Y₂ g) =
          θ_Yk Y₁ (g.comap ((AlgebraicGeometry.Scheme.Etale.forget Y_k).map f).left.base.hom))
      (_hθ_unit : ∀ a : ↥A_K,
        θ_Yk (AlgebraicGeometry.Scheme.Etale.mk (𝟙 Y_k)) (LocallyConstant.const _ a) =
          ((CategoryTheory.constantSheafAdj Y_k.smallEtaleTopology AddCommGrpCat.{u}
            hT_Yk).unit.app A_K).hom a)
      (𝒢_tilde : CategoryTheory.Sheaf Y₀.left.smallEtaleTopology AddCommGrpCat.{u})
      (triv_tilde : ∀ W : Y₀.left.Etale,
        let W_k := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget Y₀.left).obj W).hom π_k
        ↑(𝒢_tilde.obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_k (Fin K → Λ))
      (_htriv_tilde_nat : ∀ {W₁ W₂ : Y₀.left.Etale} (u : Quiver.Hom W₁ W₂),
        let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget Y₀.left).obj W₁).hom
        let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget Y₀.left).obj W₂).hom
        ∀ (u_k : Quiver.Hom
            (CategoryTheory.Limits.pullback h₁ π_k)
            (CategoryTheory.Limits.pullback h₂ π_k)),
          CategoryTheory.CategoryStruct.comp u_k (CategoryTheory.Limits.pullback.fst h₂ π_k) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst h₁ π_k)
              ((AlgebraicGeometry.Scheme.Etale.forget Y₀.left).map u).left →
          CategoryTheory.CategoryStruct.comp u_k (CategoryTheory.Limits.pullback.snd h₂ π_k) =
            CategoryTheory.Limits.pullback.snd h₁ π_k →
          ∀ (s : ↑(𝒢_tilde.obj.obj (Opposite.op W₂)))
            (y₁ : ↥(CategoryTheory.Limits.pullback h₁ π_k)),
            triv_tilde W₁ ((𝒢_tilde.obj.map (Opposite.op u)) s) y₁ =
              triv_tilde W₂ s (u_k.base y₁))
      (_htriv_tilde_range : ∀ W : Y₀.left.Etale,
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget Y₀.left).obj W).hom
        let W_k := CategoryTheory.Limits.pullback h_W π_k
        Function.Injective (triv_tilde W) ∧
        Set.range (triv_tilde W) =
          { f | ∀ (γ : k ≃ₐ[F] k) (m_γ : Quiver.Hom W_k W_k),
            CategoryTheory.CategoryStruct.comp m_γ
                (CategoryTheory.Limits.pullback.fst h_W π_k) =
              CategoryTheory.Limits.pullback.fst h_W π_k →
            CategoryTheory.CategoryStruct.comp m_γ
                (CategoryTheory.Limits.pullback.snd h_W π_k) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W π_k)
                (CategoryTheory.Limits.pullback.lift π_k
                  ((weilBaseChangeOver F k Y₀).hom ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.symm.toRingHom))
                  (CategoryTheory.Limits.pullback.condition.trans
                    ((congrArg ((weilBaseChangeOver F k Y₀).hom ≫ ·)
                      ((congrArg AlgebraicGeometry.Spec.map
                        ((congrArg CommRingCat.ofHom (RingHom.ext γ.symm.commutes).symm).trans
                          (CommRingCat.ofHom_comp _ _).symm)).trans
                        (AlgebraicGeometry.Spec.map_comp _ _))).trans
                      (CategoryTheory.Category.assoc _ _ _).symm))) →
            ∀ y : ↥W_k, f (m_γ.base y) = ((ρ_bar γ).val).mulVec (f y) }),
      WeilIsEtaleSheafPullback π_k 𝒢_tilde C_Yk :=
by
  classical
  intro Y_k f_k π_k A_K C_Yk hEt_πk _hMem_Y₀ _hMem_Yk hCont_k _hAdj_k hT_Yk θ_Yk _hθ_bij
    _hθ_nat _hθ_unit 𝒢_tilde triv_tilde _htriv_tilde_nat _htriv_tilde_range
  let _ := _hθ_bij
  let _ : AlgebraicGeometry.Etale π_k := hEt_πk
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let FgtU := AlgebraicGeometry.Scheme.Etale.forget Y₀.left
  let FgtV := AlgebraicGeometry.Scheme.Etale.forget Y_k

  
  let _ : Fintype (k ≃ₐ[F] k) := AlgEquiv.fintype F k
  let m : ℕ := Fintype.card (k ≃ₐ[F] k)
  have hm_finrank : m = Module.finrank F k :=
    Nat.card_eq_fintype_card.symm.trans (IsGalois.card_aut_eq_finrank F k)
  let equiv_Γ : Fin m ≃ (k ≃ₐ[F] k) := (Fintype.equivFin (k ≃ₐ[F] k)).symm
  let μ : (k ≃ₐ[F] k) → (TensorProduct F k k →ₐ[k] k) :=
    fun γ => Algebra.TensorProduct.lift (AlgHom.id k k) γ.symm.toAlgHom (fun _ _ => mul_comm _ _)
  have hμ_tmul : ∀ (γ : k ≃ₐ[F] k) (x y : k),
      μ γ (TensorProduct.tmul F x y) = x * γ.symm y :=
    fun γ x y => Algebra.TensorProduct.lift_tmul (AlgHom.id k k) γ.symm.toAlgHom
      (fun _ _ => mul_comm _ _) x y
  have hμ_sec : ∀ (γ : k ≃ₐ[F] k) (x : k), μ γ (TensorProduct.tmul F x 1) = x := by
    intro γ x
    rw [hμ_tmul, map_one, mul_one]
  have hKerIdem : ∀ γ : k ≃ₐ[F] k,
      ∃ f : TensorProduct F k k,
        IsIdempotentElem f ∧
        RingHom.ker (μ γ).toRingHom = Ideal.span ({f} : Set (TensorProduct F k k)) := by
    intro γ
    have hμ_surj : Function.Surjective (μ γ) := fun x => ⟨TensorProduct.tmul F x 1, hμ_sec γ x⟩
    have hFG : (RingHom.ker (μ γ).toRingHom).FG :=
      Algebra.FinitePresentation.ker_fG_of_surjective (μ γ) hμ_surj
    have hIdemI : IsIdempotentElem (RingHom.ker (μ γ).toRingHom) := by
      let _ : Algebra (TensorProduct F k k) k := (μ γ).toRingHom.toAlgebra
      have _ : IsScalarTower k (TensorProduct F k k) k :=
        IsScalarTower.of_algebraMap_eq fun x => ((μ γ).commutes x).symm
      have _ : Algebra.Etale (TensorProduct F k k) k :=
        Algebra.Etale.of_restrictScalars k (TensorProduct F k k) k
      exact (Algebra.FormallyEtale.iff_of_surjective
        (R := TensorProduct F k k) (S := k) hμ_surj).mp inferInstance
    exact (Ideal.isIdempotentElem_iff_of_fg _ hFG).mp hIdemI
  let f_idem : Fin m → TensorProduct F k k := fun i => Classical.choose (hKerIdem (equiv_Γ i))
  have hf_spec : ∀ i : Fin m,
      IsIdempotentElem (f_idem i) ∧
      RingHom.ker (μ (equiv_Γ i)).toRingHom =
        Ideal.span ({f_idem i} : Set (TensorProduct F k k)) :=
    fun i => Classical.choose_spec (hKerIdem (equiv_Γ i))
  let e : Fin m → TensorProduct F k k := fun i => 1 - f_idem i
  have hf_idem : ∀ i : Fin m, f_idem i * f_idem i = f_idem i := fun i => (hf_spec i).1.eq
  have hfe_zero : ∀ i : Fin m, f_idem i * e i = 0 := by
    intro i
    dsimp [e]
    rw [mul_sub, mul_one, hf_idem i, sub_self]
  have hμ_diag : ∀ i : Fin m, μ (equiv_Γ i) (e i) = 1 := by
    intro i
    have hf_ker : f_idem i ∈ RingHom.ker (μ (equiv_Γ i)).toRingHom := by
      rw [(hf_spec i).2]
      exact Ideal.mem_span_singleton_self (f_idem i)
    change (μ (equiv_Γ i)) (f_idem i) = 0 at hf_ker
    dsimp [e]
    rw [map_sub, map_one, hf_ker, sub_zero]
  have h_absorb : ∀ (i : Fin m) (z : TensorProduct F k k),
      z * e i = TensorProduct.tmul F (μ (equiv_Γ i) z) 1 * e i := by
    intro i z
    have hw_ker : z - TensorProduct.tmul F (μ (equiv_Γ i) z) 1 ∈
        RingHom.ker (μ (equiv_Γ i)).toRingHom := by
      change μ (equiv_Γ i) (z - TensorProduct.tmul F (μ (equiv_Γ i) z) 1) = 0
      rw [map_sub, hμ_sec (equiv_Γ i) (μ (equiv_Γ i) z), sub_self]
    rw [(hf_spec i).2, Ideal.mem_span_singleton] at hw_ker
    rcases hw_ker with ⟨c, hc⟩
    have hsub_zero : (z - TensorProduct.tmul F (μ (equiv_Γ i) z) 1) * e i = 0 := by
      rw [hc]
      calc (f_idem i * c) * e i = c * (f_idem i * e i) := by ring
        _ = c * 0 := by rw [hfe_zero i]
        _ = 0 := mul_zero c
    rw [sub_mul] at hsub_zero
    exact sub_eq_zero.mp hsub_zero
  have hμ_kronecker : ∀ i j : Fin m, μ (equiv_Γ j) (e i) = if i = j then 1 else 0 := by
    intro i j
    by_cases hij : i = j
    · subst hij
      simp only [↓reduceIte, hμ_diag i]
    · simp only [hij, ↓reduceIte]
      have hex_s : ∃ s : k, (equiv_Γ i).symm s ≠ (equiv_Γ j).symm s := by
        by_contra h_all
        apply hij
        apply equiv_Γ.injective
        ext t
        have ht_eq : (equiv_Γ i).symm (equiv_Γ i t) = (equiv_Γ j).symm (equiv_Γ i t) := by
          by_contra hne
          exact h_all ⟨equiv_Γ i t, hne⟩
        have ht := congrArg (equiv_Γ j) ht_eq
        rw [(equiv_Γ i).symm_apply_apply, (equiv_Γ j).apply_symm_apply] at ht
        exact ht.symm
      rcases hex_s with ⟨s, hs_ne⟩
      have habs_s := h_absorb i (TensorProduct.tmul F 1 s)
      rw [hμ_tmul (equiv_Γ i) 1 s, one_mul] at habs_s
      have hmap_j := congrArg (μ (equiv_Γ j)) habs_s
      rw [map_mul, map_mul, hμ_tmul (equiv_Γ j) 1 s, one_mul,
        hμ_sec (equiv_Γ j) ((equiv_Γ i).symm s)] at hmap_j
      have hmul_zero : ((equiv_Γ j).symm s - (equiv_Γ i).symm s) * μ (equiv_Γ j) (e i) = 0 := by
        rw [sub_mul, hmap_j, sub_self]
      rcases mul_eq_zero.mp hmul_zero with hdiff | heval
      · exact False.elim (hs_ne (sub_eq_zero.mp hdiff).symm)
      · exact heval
  have he_orth : ∀ i j : Fin m, i ≠ j → e i * e j = 0 := by
    intro i j hij
    have hker_ij : e i ∈ RingHom.ker (μ (equiv_Γ j)).toRingHom := by
      change μ (equiv_Γ j) (e i) = 0
      rw [hμ_kronecker i j]
      simp only [hij, ↓reduceIte]
    rw [(hf_spec j).2, Ideal.mem_span_singleton] at hker_ij
    rcases hker_ij with ⟨c, hc⟩
    rw [hc]
    calc (f_idem j * c) * e j = c * (f_idem j * e j) := by ring
      _ = c * 0 := by rw [hfe_zero j]
      _ = 0 := mul_zero c
  let Φ_lin : (Fin m → k) →ₗ[k] TensorProduct F k k :=
    { toFun := fun c => ∑ i : Fin m, c i • e i
      map_add' := fun c₁ c₂ => by
        simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
      map_smul' := fun a c => by
        simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.smul_sum, mul_smul] }
  let Θ_lin : TensorProduct F k k →ₗ[k] (Fin m → k) :=
    LinearMap.pi fun j => (μ (equiv_Γ j)).toLinearMap
  have hΘΦ : ∀ c : Fin m → k, Θ_lin (Φ_lin c) = c := by
    intro c
    ext j
    change μ (equiv_Γ j) (∑ i : Fin m, c i • e i) = c j
    rw [map_sum]
    have hterm : ∀ i : Fin m, μ (equiv_Γ j) (c i • e i) = if i = j then c i else 0 := by
      intro i
      rw [map_smul, smul_eq_mul, hμ_kronecker i j, mul_ite, mul_one, mul_zero]
    simp_rw [hterm]
    simp
  have hΦ_inj : Function.Injective Φ_lin := Function.LeftInverse.injective hΘΦ
  have _ : Module.Finite F (TensorProduct F k k) := Module.Finite.tensorProduct F k k
  have _ : FiniteDimensional k (TensorProduct F k k) :=
    Module.Finite.of_restrictScalars_finite F k (TensorProduct F k k)
  have hfinrank_eq : Module.finrank k (Fin m → k) = Module.finrank k (TensorProduct F k k) := by
    rw [Module.finrank_pi, Fintype.card_fin,
      @Module.finrank_tensorProduct k F k k, Module.finrank_self, one_mul, hm_finrank]
  have hΦ_surj : Function.Surjective Φ_lin :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfinrank_eq).mp hΦ_inj
  have hsum_e : (∑ i : Fin m, e i) = 1 := by
    set w₀ : TensorProduct F k k := 1 - ∑ i : Fin m, e i
    have hΘw₀ : Θ_lin w₀ = 0 := by
      ext j
      change μ (equiv_Γ j) (1 - ∑ i : Fin m, e i) = 0
      rw [map_sub, map_one, map_sum]
      simp_rw [hμ_kronecker]
      simp
    obtain ⟨c₀, hc₀⟩ := hΦ_surj w₀
    have hc₀_zero : c₀ = 0 := by rw [← hΘΦ c₀, hc₀, hΘw₀]
    have hw₀_zero : w₀ = 0 := by rw [← hc₀, hc₀_zero, map_zero]
    exact (sub_eq_zero.mp hw₀_zero).symm

  
  let Spec_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let q_k : Y_k ⟶ Spec_k := (weilBaseChangeOver F k Y₀).hom
  let d_k : (k ≃ₐ[F] k) → (Spec_k ⟶ Spec_k) :=
    fun γ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.symm.toRingHom)
  let s_mor : (k ≃ₐ[F] k) → (Y_k ⟶ Y_k) := fun γ =>
    CategoryTheory.Limits.pullback.lift π_k
      ((weilBaseChangeOver F k Y₀).hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.symm.toRingHom))
      (CategoryTheory.Limits.pullback.condition.trans
        ((congrArg ((weilBaseChangeOver F k Y₀).hom ≫ ·)
          ((congrArg AlgebraicGeometry.Spec.map
            ((congrArg CommRingCat.ofHom (RingHom.ext γ.symm.commutes).symm).trans
              (CommRingCat.ofHom_comp _ _).symm)).trans
            (AlgebraicGeometry.Spec.map_comp _ _))).trans
          (CategoryTheory.Category.assoc _ _ _).symm))
  have hSurj_fk : AlgebraicGeometry.Surjective f_k := by
    rw [AlgebraicGeometry.surjective_iff]
    intro P
    have hker : RingHom.ker (algebraMap F k) ≤ P.asIdeal := by
      intro r hr
      have hr0 : r = 0 :=
        (algebraMap F k).injective ((RingHom.mem_ker.mp hr).trans (map_zero _).symm)
      rw [hr0]
      exact P.asIdeal.zero_mem
    have : P.asIdeal.IsPrime := P.isPrime
    obtain ⟨Q, hQ, hUnder⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain (S := k) P.asIdeal hker
    exact ⟨⟨Q, hQ⟩, PrimeSpectrum.ext hUnder⟩
  have hSurj_πk : AlgebraicGeometry.Surjective π_k :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.Surjective.{u})
      (CategoryTheory.IsPullback.of_hasPullback Y₀.hom f_k).flip hSurj_fk
  have hs_fst : ∀ γ : k ≃ₐ[F] k, s_mor γ ≫ π_k = π_k :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hs_snd : ∀ γ : k ≃ₐ[F] k, s_mor γ ≫ q_k = q_k ≫ d_k γ :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hd_one : d_k 1 = 𝟙 Spec_k := by
    dsimp only [d_k]
    have h1 : CommRingCat.ofHom (1 : k ≃ₐ[F] k).symm.toRingHom = 𝟙 (CommRingCat.of k) :=
      CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
    rw [h1, AlgebraicGeometry.Spec.map_id]
  have hd_mul : ∀ γ₁ γ₂ : k ≃ₐ[F] k, d_k γ₁ ≫ d_k γ₂ = d_k (γ₂ * γ₁) := by
    intro γ₁ γ₂
    dsimp only [d_k]
    rw [← AlgebraicGeometry.Spec.map_comp]
    rfl
  have hs_one : s_mor 1 = 𝟙 Y_k := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · change s_mor 1 ≫ π_k = 𝟙 Y_k ≫ π_k
      exact (hs_fst 1).trans (CategoryTheory.Category.id_comp π_k).symm
    · change s_mor 1 ≫ q_k = 𝟙 Y_k ≫ q_k
      rw [hs_snd 1, hd_one, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
  have hs_mul : ∀ γ₁ γ₂ : k ≃ₐ[F] k, s_mor γ₁ ≫ s_mor γ₂ = s_mor (γ₂ * γ₁) := by
    intro γ₁ γ₂
    apply CategoryTheory.Limits.pullback.hom_ext
    · change (s_mor γ₁ ≫ s_mor γ₂) ≫ π_k = s_mor (γ₂ * γ₁) ≫ π_k
      rw [CategoryTheory.Category.assoc, hs_fst γ₂, hs_fst γ₁, hs_fst (γ₂ * γ₁)]
    · change (s_mor γ₁ ≫ s_mor γ₂) ≫ q_k = s_mor (γ₂ * γ₁) ≫ q_k
      rw [CategoryTheory.Category.assoc, hs_snd γ₂, ← CategoryTheory.Category.assoc,
        hs_snd γ₁, CategoryTheory.Category.assoc, hd_mul γ₁ γ₂, hs_snd (γ₂ * γ₁)]

  let t_mor : (k ≃ₐ[F] k) → (Y_k ⟶ Y_k) := fun γ => s_mor γ⁻¹
  have ht_s : ∀ γ : k ≃ₐ[F] k, t_mor γ ≫ s_mor γ = 𝟙 Y_k := by
    intro γ
    dsimp only [t_mor]
    rw [hs_mul, mul_inv_cancel, hs_one]
  have hs_t : ∀ γ : k ≃ₐ[F] k, s_mor γ ≫ t_mor γ = 𝟙 Y_k := by
    intro γ
    dsimp only [t_mor]
    rw [hs_mul, inv_mul_cancel, hs_one]
  have ht_one : t_mor 1 = 𝟙 Y_k := by
    dsimp only [t_mor]
    rw [inv_one, hs_one]
  have ht_et : ∀ γ : k ≃ₐ[F] k, AlgebraicGeometry.Etale (t_mor γ) := by
    intro γ
    have : CategoryTheory.IsIso (t_mor γ) := ⟨⟨s_mor γ, ht_s γ, hs_t γ⟩⟩
    exact inferInstance
  have ht_π : ∀ γ : k ≃ₐ[F] k, t_mor γ ≫ (𝟙 Y_k ≫ π_k) = 𝟙 Y_k ≫ π_k := by
    intro γ
    rw [CategoryTheory.Category.id_comp]
    exact hs_fst γ⁻¹

  let T_gal : AlgebraicGeometry.Scheme.{u} :=
    AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F k k))
  let p₁ : T_gal ⟶ Spec_k :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)
  let p₂ : T_gal ⟶ Spec_k :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom)
  have hComm₀ : p₁ ≫ f_k = p₂ ≫ f_k := by
    have hf₁ : (AlgebraicGeometry.pullbackSpecIso F k k).inv ≫
        CategoryTheory.Limits.pullback.fst f_k f_k = p₁ :=
      AlgebraicGeometry.pullbackSpecIso_inv_fst F k k
    have hf₂ : (AlgebraicGeometry.pullbackSpecIso F k k).inv ≫
        CategoryTheory.Limits.pullback.snd f_k f_k = p₂ :=
      AlgebraicGeometry.pullbackSpecIso_inv_snd F k k
    rw [← hf₁, ← hf₂, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition]
  have hPb_T : CategoryTheory.IsPullback p₁ p₂ f_k f_k :=
    CategoryTheory.IsPullback.of_iso_pullback ⟨hComm₀⟩
      (AlgebraicGeometry.pullbackSpecIso F k k).symm
      (AlgebraicGeometry.pullbackSpecIso_inv_fst F k k)
      (AlgebraicGeometry.pullbackSpecIso_inv_snd F k k)
  let Δ : Fin m → (Spec_k ⟶ T_gal) :=
    fun i => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (μ (equiv_Γ i)).toRingHom)
  have hΔ_p₁ : ∀ i : Fin m, Δ i ≫ p₁ = 𝟙 Spec_k := by
    intro i
    dsimp only [Δ, p₁]
    rw [← AlgebraicGeometry.Spec.map_comp]
    have hid : CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫
        CommRingCat.ofHom (μ (equiv_Γ i)).toRingHom = 𝟙 (CommRingCat.of k) := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro s
      change μ (equiv_Γ i) (Algebra.TensorProduct.includeLeftRingHom s) = s
      rw [Algebra.TensorProduct.includeLeftRingHom_apply]
      exact hμ_sec (equiv_Γ i) s
    rw [hid, AlgebraicGeometry.Spec.map_id]
  have hΔ_p₂ : ∀ i : Fin m, Δ i ≫ p₂ = d_k (equiv_Γ i) := by
    intro i
    dsimp only [Δ, p₂, d_k]
    rw [← AlgebraicGeometry.Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro s
    change μ (equiv_Γ i) (Algebra.TensorProduct.includeRight s) = (equiv_Γ i).symm s
    rw [Algebra.TensorProduct.includeRight_apply, hμ_tmul, one_mul]
  let D_open : Fin m → Set ↥T_gal := fun i => (PrimeSpectrum.basicOpen (e i)).1
  have hRange_Δ : ∀ i : Fin m, Set.range (Δ i).base = D_open i := by
    intro i
    ext P
    constructor
    · rintro ⟨q, rfl⟩
      apply (PrimeSpectrum.mem_basicOpen (e i) _).mpr
      intro he
      have hmem : μ (equiv_Γ i) (e i) ∈ q.asIdeal := he
      rw [hμ_diag i] at hmem
      exact q.isPrime.ne_top (q.asIdeal.eq_top_iff_one.mpr hmem)
    · intro hP
      have he : e i ∉ (P : PrimeSpectrum (TensorProduct F k k)).asIdeal :=
        (PrimeSpectrum.mem_basicOpen (e i) P).mp hP
      let q : PrimeSpectrum k :=
        PrimeSpectrum.comap Algebra.TensorProduct.includeLeftRingHom P
      refine ⟨q, PrimeSpectrum.ext (Ideal.ext fun z => ?_)⟩
      change TensorProduct.tmul F (μ (equiv_Γ i) z) 1 ∈
          (P : PrimeSpectrum (TensorProduct F k k)).asIdeal ↔
        z ∈ (P : PrimeSpectrum (TensorProduct F k k)).asIdeal
      constructor
      · intro h1
        have hmul := Ideal.mul_mem_right (e i) _ h1
        rw [← h_absorb i z] at hmul
        exact ((P : PrimeSpectrum (TensorProduct F k k)).isPrime.mem_or_mem hmul).resolve_right he
      · intro hz
        have hmul := Ideal.mul_mem_right (e i) _ hz
        rw [h_absorb i z] at hmul
        exact ((P : PrimeSpectrum (TensorProduct F k k)).isPrime.mem_or_mem hmul).resolve_right he
  have hDisj_D : ∀ i j : Fin m, i ≠ j → Disjoint (D_open i) (D_open j) := by
    intro i j hij
    rw [Set.disjoint_left]
    intro P hi hj
    have hi' : e i ∉ P.asIdeal := (PrimeSpectrum.mem_basicOpen (e i) P).mp hi
    have hj' : e j ∉ P.asIdeal := (PrimeSpectrum.mem_basicOpen (e j) P).mp hj
    have h0 : e i * e j ∈ P.asIdeal := by
      rw [he_orth i j hij]
      exact P.asIdeal.zero_mem
    rcases P.isPrime.mem_or_mem h0 with h | h
    · exact hi' h
    · exact hj' h
  have hCov_D : (⋃ i : Fin m, D_open i) = Set.univ := by
    rw [Set.eq_univ_iff_forall]
    intro P
    by_contra hNot
    have hAll : ∀ i : Fin m, e i ∈ P.asIdeal := by
      intro i
      by_contra hi
      exact hNot (Set.mem_iUnion.mpr ⟨i, (PrimeSpectrum.mem_basicOpen (e i) P).mpr hi⟩)
    have h1 : (1 : TensorProduct F k k) ∈ P.asIdeal := by
      rw [← hsum_e]
      exact Submodule.sum_mem P.asIdeal fun i _ => hAll i
    exact P.isPrime.ne_top (P.asIdeal.eq_top_iff_one.mpr h1)

  have hSheets : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (g_Y : Z ⟶ Y_k),
      let Z_Yk := CategoryTheory.Limits.pullback (g_Y ≫ π_k) π_k
      ∃ δ : (k ≃ₐ[F] k) → (Z ⟶ Z_Yk),
        (∀ γ : k ≃ₐ[F] k,
          δ γ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π_k) π_k = 𝟙 Z ∧
          δ γ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π_k) π_k = g_Y ≫ s_mor γ ∧
          AlgebraicGeometry.Etale (δ γ) ∧
          IsOpen (Set.range (δ γ).base)) ∧
        (∀ γ₁ γ₂ : k ≃ₐ[F] k, γ₁ ≠ γ₂ →
          Disjoint (Set.range (δ γ₁).base) (Set.range (δ γ₂).base)) ∧
        (⋃ γ : k ≃ₐ[F] k, Set.range (δ γ).base) = Set.univ ∧
        (∀ (γ τ : k ≃ₐ[F] k) (m_τ : Z_Yk ⟶ Z_Yk),
          m_τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π_k) π_k =
            CategoryTheory.Limits.pullback.fst (g_Y ≫ π_k) π_k →
          m_τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π_k) π_k =
            CategoryTheory.Limits.pullback.snd (g_Y ≫ π_k) π_k ≫ s_mor τ →
          δ γ ≫ m_τ = δ (τ * γ)) := by
    intro Z g_Y Z_Yk
    let fst_Y := CategoryTheory.Limits.pullback.fst (g_Y ≫ π_k) π_k
    let snd_Y := CategoryTheory.Limits.pullback.snd (g_Y ≫ π_k) π_k
    have hδ_cond : ∀ γ : k ≃ₐ[F] k, 𝟙 Z ≫ (g_Y ≫ π_k) = (g_Y ≫ s_mor γ) ≫ π_k := fun γ => by
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hs_fst γ]
    let δ : (k ≃ₐ[F] k) → (Z ⟶ Z_Yk) :=
      fun γ => CategoryTheory.Limits.pullback.lift (𝟙 Z) (g_Y ≫ s_mor γ) (hδ_cond γ)
    have hδ_fst : ∀ γ : k ≃ₐ[F] k, δ γ ≫ fst_Y = 𝟙 Z :=
      fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hδ_snd : ∀ γ : k ≃ₐ[F] k, δ γ ≫ snd_Y = g_Y ≫ s_mor γ :=
      fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hEt_fstY : AlgebraicGeometry.Etale fst_Y :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Etale.{u})
        (CategoryTheory.IsPullback.of_hasPullback (g_Y ≫ π_k) π_k).flip hEt_πk
    have hEt_δ : ∀ γ : k ≃ₐ[F] k, AlgebraicGeometry.Etale (δ γ) := by
      intro γ
      apply CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (δ γ) fst_Y hEt_fstY
      rw [hδ_fst γ]
      exact inferInstance
    have hπk_hom : π_k ≫ Y₀.hom = q_k ≫ f_k := CategoryTheory.Limits.pullback.condition
    have hq_cond : (fst_Y ≫ (g_Y ≫ q_k)) ≫ f_k = (snd_Y ≫ q_k) ≫ f_k := by
      calc (fst_Y ≫ (g_Y ≫ q_k)) ≫ f_k
          = fst_Y ≫ g_Y ≫ (q_k ≫ f_k) := by simp only [CategoryTheory.Category.assoc]
        _ = fst_Y ≫ g_Y ≫ (π_k ≫ Y₀.hom) := by rw [← hπk_hom]
        _ = (fst_Y ≫ (g_Y ≫ π_k)) ≫ Y₀.hom := by simp only [CategoryTheory.Category.assoc]
        _ = (snd_Y ≫ π_k) ≫ Y₀.hom := by rw [CategoryTheory.Limits.pullback.condition]
        _ = snd_Y ≫ (π_k ≫ Y₀.hom) := by simp only [CategoryTheory.Category.assoc]
        _ = snd_Y ≫ (q_k ≫ f_k) := by rw [hπk_hom]
        _ = (snd_Y ≫ q_k) ≫ f_k := by simp only [CategoryTheory.Category.assoc]
    let q_Z : Z_Yk ⟶ T_gal := hPb_T.lift (fst_Y ≫ (g_Y ≫ q_k)) (snd_Y ≫ q_k) hq_cond
    have hq_p₁ : q_Z ≫ p₁ = fst_Y ≫ (g_Y ≫ q_k) := hPb_T.lift_fst _ _ _
    have hq_p₂ : q_Z ≫ p₂ = snd_Y ≫ q_k := hPb_T.lift_snd _ _ _
    have hPb_paste : CategoryTheory.IsPullback (snd_Y ≫ q_k) fst_Y f_k ((g_Y ≫ π_k) ≫ Y₀.hom) :=
      ((CategoryTheory.IsPullback.of_hasPullback (g_Y ≫ π_k) π_k).flip).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback Y₀.hom f_k).flip
    have hPb_outer_bot : CategoryTheory.IsPullback (q_Z ≫ p₂) fst_Y f_k ((g_Y ≫ q_k) ≫ f_k) := by
      have hbot_eq : (g_Y ≫ π_k) ≫ Y₀.hom = (g_Y ≫ q_k) ≫ f_k := by
        rw [CategoryTheory.Category.assoc, hπk_hom, CategoryTheory.Category.assoc]
      rwa [hq_p₂, ← hbot_eq]
    have hPb_bot : CategoryTheory.IsPullback q_Z fst_Y p₁ (g_Y ≫ q_k) :=
      CategoryTheory.IsPullback.of_right hPb_outer_bot hq_p₁ hPb_T.flip
    have hComm_top : ∀ i : Fin m, (g_Y ≫ q_k) ≫ Δ i = δ (equiv_Γ i) ≫ q_Z := by
      intro i
      apply hPb_T.hom_ext
      · rw [CategoryTheory.Category.assoc, hΔ_p₁ i, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.assoc, hq_p₁, ← CategoryTheory.Category.assoc,
          hδ_fst (equiv_Γ i), CategoryTheory.Category.id_comp]
      · calc ((g_Y ≫ q_k) ≫ Δ i) ≫ p₂
            = (g_Y ≫ q_k) ≫ (Δ i ≫ p₂) := CategoryTheory.Category.assoc _ _ _
          _ = (g_Y ≫ q_k) ≫ d_k (equiv_Γ i) := by rw [hΔ_p₂ i]
          _ = g_Y ≫ (q_k ≫ d_k (equiv_Γ i)) := CategoryTheory.Category.assoc _ _ _
          _ = g_Y ≫ (s_mor (equiv_Γ i) ≫ q_k) := by rw [← hs_snd (equiv_Γ i)]
          _ = (g_Y ≫ s_mor (equiv_Γ i)) ≫ q_k := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (δ (equiv_Γ i) ≫ snd_Y) ≫ q_k := by rw [← hδ_snd (equiv_Γ i)]
          _ = δ (equiv_Γ i) ≫ (snd_Y ≫ q_k) := CategoryTheory.Category.assoc _ _ _
          _ = δ (equiv_Γ i) ≫ (q_Z ≫ p₂) := by rw [← hq_p₂]
          _ = (δ (equiv_Γ i) ≫ q_Z) ≫ p₂ := (CategoryTheory.Category.assoc _ _ _).symm
    have hPb_top : ∀ i : Fin m, CategoryTheory.IsPullback (g_Y ≫ q_k) (δ (equiv_Γ i)) (Δ i) q_Z := by
      intro i
      have hVert : CategoryTheory.IsPullback (g_Y ≫ q_k)
          (δ (equiv_Γ i) ≫ fst_Y) (Δ i ≫ p₁) (g_Y ≫ q_k) := by
        rw [hδ_fst (equiv_Γ i), hΔ_p₁ i]
        exact CategoryTheory.IsPullback.of_vert_isIso
          ⟨(CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm⟩
      exact CategoryTheory.IsPullback.of_bot hVert (hComm_top i) hPb_bot
    have hRange_δ : ∀ i : Fin m, Set.range (δ (equiv_Γ i)).base = q_Z.base ⁻¹' D_open i := by
      intro i
      rw [← hRange_Δ i]
      ext z
      constructor
      · rintro ⟨y, rfl⟩
        exact ⟨(g_Y ≫ q_k).base y, congrArg (fun h : Z ⟶ T_gal => h.base y) (hComm_top i)⟩
      · rintro ⟨v, hv⟩
        obtain ⟨y, _, hyz⟩ :=
          AlgebraicGeometry.Scheme.exists_preimage_of_isPullback (hPb_top i) v z hv
        exact ⟨y, hyz⟩
    refine ⟨δ, ?_, ?_, ?_, ?_⟩
    · intro γ
      refine ⟨hδ_fst γ, hδ_snd γ, hEt_δ γ, ?_⟩
      let i := equiv_Γ.symm γ
      have hγ : equiv_Γ i = γ := equiv_Γ.apply_symm_apply γ
      rw [← hγ, hRange_δ i]
      exact (PrimeSpectrum.basicOpen (e i)).2.preimage q_Z.continuous
    · intro γ₁ γ₂ hne
      let i := equiv_Γ.symm γ₁
      let j := equiv_Γ.symm γ₂
      have hij : i ≠ j := equiv_Γ.symm.injective.ne hne
      rw [← equiv_Γ.apply_symm_apply γ₁, ← equiv_Γ.apply_symm_apply γ₂,
        hRange_δ i, hRange_δ j]
      exact (hDisj_D i j hij).preimage q_Z.base
    · rw [Set.eq_univ_iff_forall]
      intro z
      have hz : q_Z.base z ∈ (⋃ i : Fin m, D_open i) := by
        rw [hCov_D]
        exact Set.mem_univ _
      obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hz
      have hz_i : z ∈ Set.range (δ (equiv_Γ i)).base := by
        rw [hRange_δ i]
        exact hi
      exact Set.mem_iUnion.mpr ⟨equiv_Γ i, hz_i⟩
    · intro γ τ m_τ hm_fst hm_snd
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hm_fst, hδ_fst γ, hδ_fst (τ * γ)]
      · rw [CategoryTheory.Category.assoc, hm_snd, ← CategoryTheory.Category.assoc,
          hδ_snd γ, CategoryTheory.Category.assoc, hs_mul γ τ, hδ_snd (τ * γ)]

  
  let m_can : ∀ {X : AlgebraicGeometry.Scheme.{u}} (h : X ⟶ Y₀.left) (γ : k ≃ₐ[F] k),
      CategoryTheory.Limits.pullback h π_k ⟶ CategoryTheory.Limits.pullback h π_k :=
    fun {X} h γ =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst h π_k)
        (CategoryTheory.Limits.pullback.snd h π_k ≫ s_mor γ)
        (by rw [CategoryTheory.Category.assoc, hs_fst γ, CategoryTheory.Limits.pullback.condition])
  have hm_can_eq : ∀ {X : AlgebraicGeometry.Scheme.{u}} (h : X ⟶ Y₀.left) (γ : k ≃ₐ[F] k)
      (m_γ : CategoryTheory.Limits.pullback h π_k ⟶ CategoryTheory.Limits.pullback h π_k),
      m_γ ≫ CategoryTheory.Limits.pullback.fst h π_k = CategoryTheory.Limits.pullback.fst h π_k →
      m_γ ≫ CategoryTheory.Limits.pullback.snd h π_k =
        CategoryTheory.Limits.pullback.snd h π_k ≫ s_mor γ →
      m_γ = m_can h γ := by
    intro X h γ m_γ hfst hsnd
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [hfst, CategoryTheory.Limits.pullback.lift_fst]
    · rw [hsnd, CategoryTheory.Limits.pullback.lift_snd]

  let u_can : ∀ {W₁ W₂ : Y₀.left.Etale} (u : W₁ ⟶ W₂),
      CategoryTheory.Limits.pullback (FgtU.obj W₁).hom π_k ⟶
        CategoryTheory.Limits.pullback (FgtU.obj W₂).hom π_k :=
    fun {W₁ W₂} u =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (FgtU.obj W₁).hom π_k ≫ (FgtU.map u).left)
        (CategoryTheory.Limits.pullback.snd (FgtU.obj W₁).hom π_k)
        (by rw [CategoryTheory.Category.assoc, (FgtU.map u).w,
              CategoryTheory.Limits.pullback.condition])
  have hu_can_fst : ∀ {W₁ W₂ : Y₀.left.Etale} (u : W₁ ⟶ W₂),
      u_can u ≫ CategoryTheory.Limits.pullback.fst (FgtU.obj W₂).hom π_k =
        CategoryTheory.Limits.pullback.fst (FgtU.obj W₁).hom π_k ≫ (FgtU.map u).left :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hu_can_snd : ∀ {W₁ W₂ : Y₀.left.Etale} (u : W₁ ⟶ W₂),
      u_can u ≫ CategoryTheory.Limits.pullback.snd (FgtU.obj W₂).hom π_k =
        CategoryTheory.Limits.pullback.snd (FgtU.obj W₁).hom π_k :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hu_can_eq : ∀ {W₁ W₂ : Y₀.left.Etale} (u : W₁ ⟶ W₂)
      (u_k : CategoryTheory.Limits.pullback (FgtU.obj W₁).hom π_k ⟶
        CategoryTheory.Limits.pullback (FgtU.obj W₂).hom π_k),
      u_k ≫ CategoryTheory.Limits.pullback.fst (FgtU.obj W₂).hom π_k =
        CategoryTheory.Limits.pullback.fst (FgtU.obj W₁).hom π_k ≫ (FgtU.map u).left →
      u_k ≫ CategoryTheory.Limits.pullback.snd (FgtU.obj W₂).hom π_k =
        CategoryTheory.Limits.pullback.snd (FgtU.obj W₁).hom π_k →
      u_k = u_can u := by
    intro W₁ W₂ u u_k hfst hsnd
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [hfst, CategoryTheory.Limits.pullback.lift_fst]
    · rw [hsnd, CategoryTheory.Limits.pullback.lift_snd]
  have hu_et : ∀ {Y₁ Y₂ : Y₀.left.Etale} (u : Y₁ ⟶ Y₂),
      AlgebraicGeometry.Etale (FgtU.map u).left := by
    intro Y₁ Y₂ u
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      (FgtU.map u).left (FgtU.obj Y₂).hom Y₂.prop (by rw [(FgtU.map u).w]; exact Y₁.prop)

  have htriv_comap : ∀ {W₁ W₂ : Y₀.left.Etale} (u : W₁ ⟶ W₂)
      (s : ↑(𝒢_tilde.obj.obj (Opposite.op W₂))),
      triv_tilde W₁ ((𝒢_tilde.obj.map (Opposite.op u)).hom s) =
        (triv_tilde W₂ s).comap (u_can u).base.hom := by
    intro W₁ W₂ u s
    apply LocallyConstant.ext
    intro y₁
    exact _htriv_tilde_nat u (u_can u) (hu_can_fst u) (hu_can_snd u) s y₁
  have htriv_equiv : ∀ (W : Y₀.left.Etale)
      (s : ↑(𝒢_tilde.obj.obj (Opposite.op W)))
      (γ : k ≃ₐ[F] k)
      (y : ↥(CategoryTheory.Limits.pullback (FgtU.obj W).hom π_k)),
      triv_tilde W s ((m_can (FgtU.obj W).hom γ).base y) =
        ((ρ_bar γ).val).mulVec (triv_tilde W s y) := by
    intro W s γ y
    have hmem : triv_tilde W s ∈ Set.range (triv_tilde W) := ⟨s, rfl⟩
    rw [(_htriv_tilde_range W).2] at hmem
    exact hmem γ (m_can (FgtU.obj W).hom γ)
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _) y
  have htriv_mem_range : ∀ (W : Y₀.left.Etale)
      (f : LocallyConstant ↥(CategoryTheory.Limits.pullback (FgtU.obj W).hom π_k) (Fin K → Λ)),
      (∀ γ y, f ((m_can (FgtU.obj W).hom γ).base y) = ((ρ_bar γ).val).mulVec (f y)) →
      f ∈ Set.range (triv_tilde W) := by
    intro W f hf
    rw [(_htriv_tilde_range W).2]
    intro γ m_γ hfst hsnd y
    rw [hm_can_eq (FgtU.obj W).hom γ m_γ hfst hsnd]
    exact hf γ y

  have hSheetPkg : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (g_Y : Z ⟶ Y_k),
      let Z_Yk := CategoryTheory.Limits.pullback (g_Y ≫ π_k) π_k
      ∃ δ : (k ≃ₐ[F] k) → (Z ⟶ Z_Yk),
        (∀ γ : k ≃ₐ[F] k,
          δ γ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π_k) π_k = 𝟙 Z ∧
          δ γ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π_k) π_k = g_Y ≫ s_mor γ ∧
          AlgebraicGeometry.Etale (δ γ) ∧
          IsOpen (Set.range (δ γ).base)) ∧
        (⋃ γ : k ≃ₐ[F] k, Set.range (δ γ).base) = Set.univ ∧
        (∀ f₁ f₂ : LocallyConstant ↥Z_Yk (Fin K → Λ),
          (∀ γ y, f₁ ((m_can (g_Y ≫ π_k) γ).base y) = ((ρ_bar γ).val).mulVec (f₁ y)) →
          (∀ γ y, f₂ ((m_can (g_Y ≫ π_k) γ).base y) = ((ρ_bar γ).val).mulVec (f₂ y)) →
          f₁.comap (δ 1).base.hom = f₂.comap (δ 1).base.hom →
          f₁ = f₂) ∧
        (∀ g : LocallyConstant ↥Z (Fin K → Λ),
          ∃ f : LocallyConstant ↥Z_Yk (Fin K → Λ),
            (∀ γ y, f ((m_can (g_Y ≫ π_k) γ).base y) = ((ρ_bar γ).val).mulVec (f y)) ∧
            ∀ (γ : k ≃ₐ[F] k) (z : ↥Z), f ((δ γ).base z) = ((ρ_bar γ).val).mulVec (g z)) := by
    intro Z g_Y Z_Yk
    obtain ⟨δ, hδ_props, hδ_disj, hδ_cov, hδ_var⟩ := hSheets Z g_Y
    refine ⟨δ, hδ_props, hδ_cov, ?_, ?_⟩
    · intro f₁ f₂ hf₁ hf₂ hcomap
      apply LocallyConstant.ext
      intro w
      have hw_univ : w ∈ (⋃ γ : k ≃ₐ[F] k, Set.range (δ γ).base) := by
        rw [hδ_cov]; exact Set.mem_univ w
      obtain ⟨γ, z, rfl⟩ := Set.mem_iUnion.mp hw_univ
      have hvar : δ 1 ≫ m_can (g_Y ≫ π_k) γ = δ γ := by
        rw [hδ_var 1 γ (m_can (g_Y ≫ π_k) γ)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _), mul_one]
      have hpt : (m_can (g_Y ≫ π_k) γ).base ((δ 1).base z) = (δ γ).base z := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hvar]
      have hz_eq : f₁ ((δ 1).base z) = f₂ ((δ 1).base z) :=
        congrArg (fun h : LocallyConstant ↥Z (Fin K → Λ) => h z) hcomap
      rw [← hpt, hf₁ γ ((δ 1).base z), hf₂ γ ((δ 1).base z), hz_eq]
    · intro g
      have hex : ∀ w : ↥Z_Yk, ∃ γ : k ≃ₐ[F] k, w ∈ Set.range (δ γ).base :=
        fun w => Set.mem_iUnion.mp (hδ_cov ▸ Set.mem_univ w)
      let γ_of : ↥Z_Yk → (k ≃ₐ[F] k) := fun w => Classical.choose (hex w)
      have hγ_of : ∀ w : ↥Z_Yk, w ∈ Set.range (δ (γ_of w)).base :=
        fun w => Classical.choose_spec (hex w)
      let f_fun : ↥Z_Yk → (Fin K → Λ) :=
        fun w => ((ρ_bar (γ_of w)).val).mulVec
          (g ((CategoryTheory.Limits.pullback.fst (g_Y ≫ π_k) π_k).base w))
      have hf_sheet : ∀ (γ : k ≃ₐ[F] k) (z : ↥Z),
          f_fun ((δ γ).base z) = ((ρ_bar γ).val).mulVec (g z) := by
        intro γ z
        have hγ_eq : γ_of ((δ γ).base z) = γ := by
          by_contra hne
          exact Set.disjoint_left.mp (hδ_disj _ _ hne) (hγ_of ((δ γ).base z)) ⟨z, rfl⟩
        have hfst_z :
            (CategoryTheory.Limits.pullback.fst (g_Y ≫ π_k) π_k).base ((δ γ).base z) = z := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, (hδ_props γ).1]
          rfl
        dsimp only [f_fun]
        rw [hγ_eq, hfst_z]
      have hf_lc : IsLocallyConstant f_fun := by
        intro S_set
        have hpre : f_fun ⁻¹' S_set =
            ⋃ γ : k ≃ₐ[F] k,
              (δ γ).base '' (g ⁻¹' (((ρ_bar γ).val).mulVec ⁻¹' S_set)) := by
          ext w
          simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_image]
          constructor
          · intro hw
            obtain ⟨γ, z, rfl⟩ := hex w
            rw [hf_sheet γ z] at hw
            exact ⟨γ, z, hw, rfl⟩
          · rintro ⟨γ, z, hz, rfl⟩
            rwa [hf_sheet γ z]
        rw [hpre]
        refine isOpen_iUnion fun γ => ?_
        have : AlgebraicGeometry.Etale (δ γ) := (hδ_props γ).2.2.1
        exact (δ γ).isOpenMap _ (g.isLocallyConstant _)
      refine ⟨⟨f_fun, hf_lc⟩, ?_, hf_sheet⟩
      intro τ w
      obtain ⟨γ, z, rfl⟩ := hex w
      have hvar : δ γ ≫ m_can (g_Y ≫ π_k) τ = δ (τ * γ) :=
        hδ_var γ τ (m_can (g_Y ≫ π_k) τ)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      have hpt : (m_can (g_Y ≫ π_k) τ).base ((δ γ).base z) = (δ (τ * γ)).base z := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hvar]
      change f_fun ((m_can (g_Y ≫ π_k) τ).base ((δ γ).base z)) =
        ((ρ_bar τ).val).mulVec (f_fun ((δ γ).base z))
      rw [hpt, hf_sheet (τ * γ) z, hf_sheet γ z, map_mul ρ_bar τ γ, Units.val_mul,
        ← Matrix.mulVec_mulVec]

  
  have := hCont_k
  have := _hAdj_k
  let B_k : CategoryTheory.Functor Y₀.left.Etale Y_k.Etale := weilEtaleSitePullback π_k
  let P_k := B_k.sheafPushforwardContinuous AddCommGrpCat.{u}
    Y₀.left.smallEtaleTopology Y_k.smallEtaleTopology
  let L_k := B_k.sheafPullback AddCommGrpCat.{u}
    Y₀.left.smallEtaleTopology Y_k.smallEtaleTopology
  let adj_k := B_k.sheafAdjunctionContinuous AddCommGrpCat.{u}
    Y₀.left.smallEtaleTopology Y_k.smallEtaleTopology
  let T_Yk : Y_k.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 Y_k)
  let adj_const := CategoryTheory.constantSheafAdj Y_k.smallEtaleTopology AddCommGrpCat.{u} hT_Yk

  let lcUp : ∀ (X : Type u) [TopologicalSpace X],
      LocallyConstant X (Fin K → Λ) →+ LocallyConstant X ↥A_K :=
    fun X _ =>
      { toFun := LocallyConstant.map ULift.up
        map_zero' := LocallyConstant.ext fun _ => rfl
        map_add' := fun _ _ => LocallyConstant.ext fun _ => rfl }
  let α_app : ∀ W_op : (Y₀.left.Etale)ᵒᵖ,
      𝒢_tilde.obj.obj W_op ⟶ ((P_k.obj C_Yk).obj).obj W_op :=
    fun W_op =>
      AddCommGrpCat.ofHom
        ((θ_Yk (B_k.obj W_op.unop)).comp ((lcUp _).comp (triv_tilde W_op.unop)))
  have hB_map_left : ∀ {W₁ W₂ : Y₀.left.Etale} (u : W₁ ⟶ W₂),
      (FgtV.map (B_k.map u)).left = u_can u := by
    intro W₁ W₂ u
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) π_k :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) π_k :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    apply hu_can_eq u
    · exact (congrArg (· ≫ CategoryTheory.Limits.pullback.fst (FgtU.obj W₂).hom π_k)
        (CategoryTheory.MorphismProperty.Over.pullback_map_left
          (@AlgebraicGeometry.Etale) ⊤ π_k u)).trans
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
    · exact (congrArg (· ≫ CategoryTheory.Limits.pullback.snd (FgtU.obj W₂).hom π_k)
        (CategoryTheory.MorphismProperty.Over.pullback_map_left
          (@AlgebraicGeometry.Etale) ⊤ π_k u)).trans
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
  have hα_nat : ∀ ⦃X Y : (Y₀.left.Etale)ᵒᵖ⦄ (f : X ⟶ Y),
      𝒢_tilde.obj.map f ≫ α_app Y = α_app X ≫ ((P_k.obj C_Yk).obj).map f := by
    intro X Y f
    let u : Y.unop ⟶ X.unop := f.unop
    have hf_eq : f = Opposite.op u := rfl
    rw [hf_eq]
    apply AddCommGrpCat.ext
    intro s
    change θ_Yk (B_k.obj Y.unop)
        (lcUp _ (triv_tilde Y.unop ((𝒢_tilde.obj.map (Opposite.op u)).hom s))) =
      (C_Yk.obj.map (Opposite.op (B_k.map u))).hom
        (θ_Yk (B_k.obj X.unop) (lcUp _ (triv_tilde X.unop s)))
    rw [htriv_comap u s, _hθ_nat (B_k.map u) (lcUp _ (triv_tilde X.unop s)), hB_map_left u]
    rfl
  let α_tilde : 𝒢_tilde ⟶ P_k.obj C_Yk :=
    CategoryTheory.ObjectProperty.homMk { app := α_app, naturality := hα_nat }
  let α : L_k.obj 𝒢_tilde ⟶ C_Yk := (adj_k.homEquiv 𝒢_tilde C_Yk).symm α_tilde
  have hα_unit : adj_k.unit.app 𝒢_tilde ≫ P_k.map α = α_tilde :=
    (adj_k.homEquiv_unit 𝒢_tilde C_Yk α).symm.trans
      ((adj_k.homEquiv 𝒢_tilde C_Yk).apply_symm_apply α_tilde)

  have h1Yk_π_et : AlgebraicGeometry.Etale (𝟙 Y_k ≫ π_k) :=
    CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
      (𝟙 Y_k) π_k inferInstance hEt_πk
  let Y_tilde : Y₀.left.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 Y_k ≫ π_k)
  obtain ⟨δ_Y, hδY_props, hδY_cov, hUniq_Y, hLift_Y⟩ := hSheetPkg Y_k (𝟙 Y_k)

  let f_lift : ↥A_K →
      LocallyConstant ↥(CategoryTheory.Limits.pullback (𝟙 Y_k ≫ π_k) π_k) (Fin K → Λ) :=
    fun a => Classical.choose (hLift_Y (LocallyConstant.const ↥Y_k a.down))
  have hf_lift_equiv : ∀ (a : ↥A_K) (γ : k ≃ₐ[F] k)
      (y : ↥(CategoryTheory.Limits.pullback (𝟙 Y_k ≫ π_k) π_k)),
      f_lift a ((m_can (𝟙 Y_k ≫ π_k) γ).base y) = ((ρ_bar γ).val).mulVec (f_lift a y) :=
    fun a => (Classical.choose_spec (hLift_Y (LocallyConstant.const ↥Y_k a.down))).1
  have hf_lift_sheet : ∀ (a : ↥A_K) (γ : k ≃ₐ[F] k) (y : ↥Y_k),
      f_lift a ((δ_Y γ).base y) = ((ρ_bar γ).val).mulVec a.down :=
    fun a => (Classical.choose_spec (hLift_Y (LocallyConstant.const ↥Y_k a.down))).2
  have hf_lift_mem : ∀ a : ↥A_K, f_lift a ∈ Set.range (triv_tilde Y_tilde) :=
    fun a => htriv_mem_range Y_tilde (f_lift a) (hf_lift_equiv a)
  let sec_fun : ↥A_K → ↑(𝒢_tilde.obj.obj (Opposite.op Y_tilde)) :=
    fun a => Classical.choose (hf_lift_mem a)
  have hsec_triv : ∀ a : ↥A_K, triv_tilde Y_tilde (sec_fun a) = f_lift a :=
    fun a => Classical.choose_spec (hf_lift_mem a)
  have hsec_sheet : ∀ (a : ↥A_K) (γ : k ≃ₐ[F] k) (y : ↥Y_k),
      triv_tilde Y_tilde (sec_fun a) ((δ_Y γ).base y) = ((ρ_bar γ).val).mulVec a.down := by
    intro a γ y
    exact (congrArg (fun g : LocallyConstant _ _ => g ((δ_Y γ).base y)) (hsec_triv a)).trans
      (hf_lift_sheet a γ y)
  let secHom : A_K ⟶ 𝒢_tilde.obj.obj (Opposite.op Y_tilde) :=
    AddCommGrpCat.ofHom
      { toFun := sec_fun
        map_zero' := by
          apply (_htriv_tilde_range Y_tilde).1
          apply hUniq_Y _ _ (htriv_equiv Y_tilde (sec_fun 0)) (htriv_equiv Y_tilde 0)
          apply LocallyConstant.ext
          intro y
          have hz_pt : triv_tilde Y_tilde 0 ((δ_Y 1).base y) = 0 :=
            congrArg (fun g : LocallyConstant _ _ => g ((δ_Y 1).base y))
              (map_zero (triv_tilde Y_tilde))
          change triv_tilde Y_tilde (sec_fun 0) ((δ_Y 1).base y) =
            triv_tilde Y_tilde 0 ((δ_Y 1).base y)
          rw [hz_pt, hsec_sheet 0 1 y]
          exact Matrix.mulVec_zero _
        map_add' := fun a₁ a₂ => by
          apply (_htriv_tilde_range Y_tilde).1
          apply hUniq_Y _ _ (htriv_equiv Y_tilde (sec_fun (a₁ + a₂)))
            (htriv_equiv Y_tilde (sec_fun a₁ + sec_fun a₂))
          apply LocallyConstant.ext
          intro y
          have ha_pt : triv_tilde Y_tilde (sec_fun a₁ + sec_fun a₂) ((δ_Y 1).base y) =
              triv_tilde Y_tilde (sec_fun a₁) ((δ_Y 1).base y) +
                triv_tilde Y_tilde (sec_fun a₂) ((δ_Y 1).base y) :=
            congrArg (fun g : LocallyConstant _ _ => g ((δ_Y 1).base y))
              (map_add (triv_tilde Y_tilde) (sec_fun a₁) (sec_fun a₂))
          change triv_tilde Y_tilde (sec_fun (a₁ + a₂)) ((δ_Y 1).base y) =
            triv_tilde Y_tilde (sec_fun a₁ + sec_fun a₂) ((δ_Y 1).base y)
          rw [ha_pt, hsec_sheet (a₁ + a₂) 1 y, hsec_sheet a₁ 1 y, hsec_sheet a₂ 1 y]
          exact Matrix.mulVec_add _ a₁.down a₂.down }

  let u_deck : (k ≃ₐ[F] k) → (Y_tilde ⟶ Y_tilde) :=
    fun γ =>
      (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful Y₀.left).preimage
        (CategoryTheory.Over.homMk (t_mor γ) (ht_π γ))
  have hu_deck_left : ∀ γ : k ≃ₐ[F] k, (FgtU.map (u_deck γ)).left = t_mor γ :=
    fun γ => congrArg CategoryTheory.Over.Hom.left
      ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful Y₀.left).map_preimage _)

  let ε_mor : (k ≃ₐ[F] k) → (Y_k ⟶ CategoryTheory.Limits.pullback (𝟙 Y_k ≫ π_k) π_k) :=
    fun γ => t_mor γ ≫ δ_Y γ
  have hε_snd : ∀ γ : k ≃ₐ[F] k,
      ε_mor γ ≫ CategoryTheory.Limits.pullback.snd (𝟙 Y_k ≫ π_k) π_k = 𝟙 Y_k := by
    intro γ
    dsimp only [ε_mor]
    rw [CategoryTheory.Category.assoc, (hδY_props γ).2.1, CategoryTheory.Category.id_comp, ht_s γ]
  have hε_fst : ∀ γ : k ≃ₐ[F] k,
      ε_mor γ ≫ CategoryTheory.Limits.pullback.fst (𝟙 Y_k ≫ π_k) π_k = t_mor γ := by
    intro γ
    dsimp only [ε_mor]
    rw [CategoryTheory.Category.assoc, (hδY_props γ).1, CategoryTheory.Category.comp_id]
  have hε_one : ε_mor 1 = δ_Y 1 :=
    (congrArg (· ≫ δ_Y 1) ht_one).trans (CategoryTheory.Category.id_comp (δ_Y 1))
  let ε_et : (k ≃ₐ[F] k) → (T_Yk ⟶ B_k.obj Y_tilde) :=
    fun γ =>
      (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful Y_k).preimage
        (CategoryTheory.Over.homMk (ε_mor γ) (hε_snd γ))
  have hε_et_left : ∀ γ : k ≃ₐ[F] k, (FgtV.map (ε_et γ)).left = ε_mor γ :=
    fun γ => congrArg CategoryTheory.Over.Hom.left
      ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful Y_k).map_preimage _)

  let η_Ytilde : 𝒢_tilde.obj.obj (Opposite.op Y_tilde) ⟶
      (L_k.obj 𝒢_tilde).obj.obj (Opposite.op (B_k.obj Y_tilde)) :=
    (adj_k.unit.app 𝒢_tilde).hom.app (Opposite.op Y_tilde)
  let γ₀ : A_K ⟶ (L_k.obj 𝒢_tilde).obj.obj (Opposite.op T_Yk) :=
    secHom ≫ η_Ytilde ≫ (L_k.obj 𝒢_tilde).obj.map (Opposite.op (ε_et 1))
  let β : C_Yk ⟶ L_k.obj 𝒢_tilde := (adj_const.homEquiv A_K (L_k.obj 𝒢_tilde)).symm γ₀
  have hβ_unit : adj_const.unit.app A_K ≫ β.hom.app (Opposite.op T_Yk) = γ₀ :=
    (adj_const.homEquiv_unit A_K (L_k.obj 𝒢_tilde) β).symm.trans
      ((adj_const.homEquiv A_K (L_k.obj 𝒢_tilde)).apply_symm_apply γ₀)

  have hUnit_eval : secHom ≫ α_tilde.hom.app (Opposite.op Y_tilde) ≫
      C_Yk.obj.map (Opposite.op (ε_et 1)) = adj_const.unit.app A_K := by
    apply AddCommGrpCat.ext
    intro a
    have h1 := _hθ_nat (ε_et 1) (lcUp _ (triv_tilde Y_tilde (sec_fun a)))
    have hcomap : (lcUp _ (triv_tilde Y_tilde (sec_fun a))).comap
        ((AlgebraicGeometry.Scheme.Etale.forget Y_k).map (ε_et 1)).left.base.hom =
        LocallyConstant.const _ a := by
      apply LocallyConstant.ext
      intro y
      have hy_pt : ((AlgebraicGeometry.Scheme.Etale.forget Y_k).map (ε_et 1)).left.base y =
          (δ_Y 1).base y :=
        congrArg (fun m_hom : Y_k ⟶ CategoryTheory.Limits.pullback (𝟙 Y_k ≫ π_k) π_k =>
          m_hom.base y) ((hε_et_left 1).trans hε_one)
      change ULift.up (triv_tilde Y_tilde (sec_fun a)
        (((AlgebraicGeometry.Scheme.Etale.forget Y_k).map (ε_et 1)).left.base y)) = a
      rw [hy_pt, hsec_sheet a 1 y, map_one ρ_bar, Units.val_one, Matrix.one_mulVec]
      rfl
    exact h1.trans ((congrArg (θ_Yk T_Yk) hcomap).trans (_hθ_unit a))

  have hβα : β ≫ α = 𝟙 C_Yk := by
    apply (adj_const.homEquiv A_K C_Yk).injective
    apply AddCommGrpCat.ext
    intro a
    have h1 := congrArg (fun m_hom => m_hom.hom a) (adj_const.homEquiv_unit A_K C_Yk (β ≫ α))
    have h2 := congrArg (fun m_hom => m_hom.hom a) (adj_const.homEquiv_unit A_K C_Yk (𝟙 C_Yk))
    have hβ_a : (β.hom.app (Opposite.op T_Yk)).hom ((adj_const.unit.app A_K).hom a) = γ₀.hom a :=
      congrArg (fun m_hom => m_hom.hom a) hβ_unit
    have hnat_a : (α.hom.app (Opposite.op T_Yk)).hom
        (((L_k.obj 𝒢_tilde).obj.map (Opposite.op (ε_et 1))).hom (η_Ytilde.hom (secHom.hom a))) =
        (C_Yk.obj.map (Opposite.op (ε_et 1))).hom
          ((α.hom.app (Opposite.op (B_k.obj Y_tilde))).hom (η_Ytilde.hom (secHom.hom a))) :=
      congrArg (fun m_hom => m_hom.hom (η_Ytilde.hom (secHom.hom a)))
        (α.hom.naturality (Opposite.op (ε_et 1)))
    have hα_a : (α.hom.app (Opposite.op (B_k.obj Y_tilde))).hom (η_Ytilde.hom (secHom.hom a)) =
        (α_tilde.hom.app (Opposite.op Y_tilde)).hom (secHom.hom a) :=
      congrArg (fun k_hom : 𝒢_tilde ⟶ P_k.obj C_Yk =>
        (k_hom.hom.app (Opposite.op Y_tilde)).hom (secHom.hom a)) hα_unit
    have hunit_a : (C_Yk.obj.map (Opposite.op (ε_et 1))).hom
        ((α_tilde.hom.app (Opposite.op Y_tilde)).hom (secHom.hom a)) =
        (adj_const.unit.app A_K).hom a :=
      congrArg (fun m_hom => m_hom.hom a) hUnit_eval
    exact h1.trans
      ((congrArg (α.hom.app (Opposite.op T_Yk)).hom hβ_a).trans
        (hnat_a.trans
          ((congrArg (C_Yk.obj.map (Opposite.op (ε_et 1))).hom hα_a).trans
            (hunit_a.trans h2.symm))))

  have hδ_ucan : ∀ γ : k ≃ₐ[F] k, δ_Y 1 ≫ u_can (u_deck γ) = ε_mor γ := by
    intro γ
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc (δ_Y 1) (u_can (u_deck γ)) _).trans
        ((congrArg (δ_Y 1 ≫ ·) (hu_can_fst (u_deck γ))).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ _) (hδY_props 1).1).trans
              ((CategoryTheory.Category.id_comp _).trans
                ((hu_deck_left γ).trans (hε_fst γ).symm)))))
    · exact (CategoryTheory.Category.assoc (δ_Y 1) (u_can (u_deck γ)) _).trans
        ((congrArg (δ_Y 1 ≫ ·) (hu_can_snd (u_deck γ))).trans
          ((congrArg (· ≫ _) hε_one.symm).trans
            ((hε_snd 1).trans (hε_snd γ).symm)))

  have hε_deck : ∀ γ : k ≃ₐ[F] k, ε_et 1 ≫ B_k.map (u_deck γ) = ε_et γ := by
    intro γ
    apply (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful Y_k).map_injective
    apply CategoryTheory.Over.OverMorphism.ext
    exact (congrArg CategoryTheory.Over.Hom.left
      (FgtV.map_comp (ε_et 1) (B_k.map (u_deck γ)))).trans
      ((congrArg₂ CategoryTheory.CategoryStruct.comp
        ((hε_et_left 1).trans hε_one) (hB_map_left (u_deck γ))).trans
        ((hδ_ucan γ).trans (hε_et_left γ).symm))

  have hDeck_cov : CategoryTheory.Sieve.ofArrows (fun _ : k ≃ₐ[F] k => T_Yk)
      (fun γ => ε_et 1 ≫ B_k.map (u_deck γ)) ∈ Y_k.smallEtaleTopology (B_k.obj Y_tilde) := by
    rw [_hMem_Yk (B_k.obj Y_tilde)]
    intro z
    have hz_univ : z ∈ (⋃ γ : k ≃ₐ[F] k, Set.range (δ_Y γ).base) := by
      rw [hδY_cov]; exact Set.mem_univ z
    obtain ⟨γ, x, rfl⟩ := Set.mem_iUnion.mp hz_univ
    refine ⟨T_Yk, ε_et 1 ≫ B_k.map (u_deck γ), (s_mor γ).base x,
      CategoryTheory.Sieve.ofArrows_mk _ _ γ, ?_, ?_⟩
    · change AlgebraicGeometry.Etale (FgtV.map (ε_et 1 ≫ B_k.map (u_deck γ))).left
      rw [hε_deck γ, hε_et_left γ]
      exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        (t_mor γ) (δ_Y γ) (ht_et γ) (hδY_props γ).2.2.1
    · have hmor : (FgtV.map (ε_et 1 ≫ B_k.map (u_deck γ))).left = t_mor γ ≫ δ_Y γ := by
        rw [hε_deck γ, hε_et_left γ]
      have hpt : ((AlgebraicGeometry.Scheme.Etale.forget Y_k).map
          (ε_et 1 ≫ B_k.map (u_deck γ))).left.base ((s_mor γ).base x) =
          (t_mor γ ≫ δ_Y γ).base ((s_mor γ).base x) :=
        congrArg (fun m_hom : Y_k ⟶ CategoryTheory.Limits.pullback (𝟙 Y_k ≫ π_k) π_k =>
          m_hom.base ((s_mor γ).base x)) hmor
      have hst_pt : (t_mor γ ≫ δ_Y γ).base ((s_mor γ).base x) = (δ_Y γ).base x :=
        (AlgebraicGeometry.Scheme.Hom.comp_apply (t_mor γ) (δ_Y γ) ((s_mor γ).base x)).trans
          ((congrArg (δ_Y γ).base
            (AlgebraicGeometry.Scheme.Hom.comp_apply (s_mor γ) (t_mor γ) x).symm).trans
            (congrArg (fun m_hom : Y_k ⟶ Y_k => (δ_Y γ).base (m_hom.base x)) (hs_t γ)))
      exact hpt.trans hst_pt

  let φ_deck : (k ≃ₐ[F] k) → (A_K ⟶ A_K) :=
    fun γ => AddCommGrpCat.ofHom
      { toFun := fun a => ULift.up (((ρ_bar γ).val).mulVec a.down)
        map_zero' := congrArg ULift.up (Matrix.mulVec_zero _)
        map_add' := fun a₁ a₂ => congrArg ULift.up (Matrix.mulVec_add _ a₁.down a₂.down) }
  have hDeck_inter : ∀ γ : k ≃ₐ[F] k,
      secHom ≫ 𝒢_tilde.obj.map (Opposite.op (u_deck γ)) = φ_deck γ ≫ secHom := by
    intro γ
    apply AddCommGrpCat.ext
    intro a
    apply (_htriv_tilde_range Y_tilde).1
    apply hUniq_Y _ _
      (htriv_equiv Y_tilde ((𝒢_tilde.obj.map (Opposite.op (u_deck γ))).hom (sec_fun a)))
      (htriv_equiv Y_tilde (sec_fun ((φ_deck γ).hom a)))
    apply LocallyConstant.ext
    intro y
    have htriv_u_pt :
        triv_tilde Y_tilde ((𝒢_tilde.obj.map (Opposite.op (u_deck γ))).hom (sec_fun a))
          ((δ_Y 1).base y) =
        triv_tilde Y_tilde (sec_fun a) ((u_can (u_deck γ)).base ((δ_Y 1).base y)) :=
      congrArg (fun g : LocallyConstant _ _ => g ((δ_Y 1).base y)) (htriv_comap (u_deck γ) (sec_fun a))
    have hpt : (u_can (u_deck γ)).base ((δ_Y 1).base y) = (δ_Y γ).base ((t_mor γ).base y) := by
      have h1 := hε_deck γ
      have h2 := congrArg (fun k_hom => (FgtV.map k_hom).left) h1
      rw [FgtV.map_comp] at h2
      change (FgtV.map (ε_et 1)).left ≫ (FgtV.map (B_k.map (u_deck γ))).left =
        (FgtV.map (ε_et γ)).left at h2
      rw [hε_et_left 1, hε_one, hB_map_left (u_deck γ), hε_et_left γ] at h2
      have h3 := congrArg
        (fun k_hom : Y_k ⟶ CategoryTheory.Limits.pullback (𝟙 Y_k ≫ π_k) π_k => k_hom.base y) h2
      have hL_pt : (δ_Y 1 ≫ u_can (u_deck γ)).base y =
          (u_can (u_deck γ)).base ((δ_Y 1).base y) :=
        AlgebraicGeometry.Scheme.Hom.comp_apply (δ_Y 1) (u_can (u_deck γ)) y
      have hR_pt : (ε_mor γ).base y = (δ_Y γ).base ((t_mor γ).base y) :=
        AlgebraicGeometry.Scheme.Hom.comp_apply (t_mor γ) (δ_Y γ) y
      exact hL_pt.symm.trans (h3.trans hR_pt)
    change triv_tilde Y_tilde ((𝒢_tilde.obj.map (Opposite.op (u_deck γ))).hom (sec_fun a))
        ((δ_Y 1).base y) =
      triv_tilde Y_tilde (sec_fun ((φ_deck γ).hom a)) ((δ_Y 1).base y)
    rw [htriv_u_pt, hpt, hsec_sheet a γ ((t_mor γ).base y), hsec_sheet ((φ_deck γ).hom a) 1 y,
      map_one ρ_bar, Units.val_one, Matrix.one_mulVec]
    rfl

  let Φ_LHS : 𝒢_tilde ⟶ P_k.obj (L_k.obj 𝒢_tilde) := α_tilde ≫ P_k.map β
  let Φ_RHS : 𝒢_tilde ⟶ P_k.obj (L_k.obj 𝒢_tilde) := adj_k.unit.app 𝒢_tilde

  have hUniv_Ytilde : secHom ≫ Φ_LHS.hom.app (Opposite.op Y_tilde) =
      secHom ≫ Φ_RHS.hom.app (Opposite.op Y_tilde) := by
    change (secHom ≫ Φ_LHS.hom.app (Opposite.op Y_tilde) :
        A_K ⟶ (L_k.obj 𝒢_tilde).obj.obj (Opposite.op (B_k.obj Y_tilde))) =
      secHom ≫ Φ_RHS.hom.app (Opposite.op Y_tilde)
    apply (L_k.obj 𝒢_tilde).property.hom_ext_ofArrows
      (fun γ : k ≃ₐ[F] k => ε_et 1 ≫ B_k.map (u_deck γ)) hDeck_cov
    intro γ
    apply AddCommGrpCat.ext
    intro a
    have hL1 : ((L_k.obj 𝒢_tilde).obj.map (Opposite.op (ε_et 1 ≫ B_k.map (u_deck γ)))).hom
        ((β.hom.app (Opposite.op (B_k.obj Y_tilde))).hom
          ((α_tilde.hom.app (Opposite.op Y_tilde)).hom (secHom.hom a))) =
        (β.hom.app (Opposite.op T_Yk)).hom
          ((C_Yk.obj.map (Opposite.op (ε_et 1 ≫ B_k.map (u_deck γ)))).hom
            ((α_tilde.hom.app (Opposite.op Y_tilde)).hom (secHom.hom a))) :=
      congrArg (fun m_hom => m_hom.hom ((α_tilde.hom.app (Opposite.op Y_tilde)).hom (secHom.hom a)))
        (β.hom.naturality (Opposite.op (ε_et 1 ≫ B_k.map (u_deck γ)))).symm
    have hL2 : (C_Yk.obj.map (Opposite.op (ε_et 1 ≫ B_k.map (u_deck γ)))).hom
        ((α_tilde.hom.app (Opposite.op Y_tilde)).hom (secHom.hom a)) =
        (C_Yk.obj.map (Opposite.op (ε_et 1))).hom
          ((C_Yk.obj.map (Opposite.op (B_k.map (u_deck γ)))).hom
            ((α_tilde.hom.app (Opposite.op Y_tilde)).hom (secHom.hom a))) :=
      congrArg (fun m_hom => m_hom.hom ((α_tilde.hom.app (Opposite.op Y_tilde)).hom (secHom.hom a)))
        (C_Yk.obj.map_comp (Opposite.op (B_k.map (u_deck γ))) (Opposite.op (ε_et 1)))
    have hL3 : (C_Yk.obj.map (Opposite.op (B_k.map (u_deck γ)))).hom
        ((α_tilde.hom.app (Opposite.op Y_tilde)).hom (secHom.hom a)) =
        (α_tilde.hom.app (Opposite.op Y_tilde)).hom
          ((𝒢_tilde.obj.map (Opposite.op (u_deck γ))).hom (secHom.hom a)) :=
      congrArg (fun m_hom => m_hom.hom (secHom.hom a))
        (α_tilde.hom.naturality (Opposite.op (u_deck γ))).symm
    have hL4 : (𝒢_tilde.obj.map (Opposite.op (u_deck γ))).hom (secHom.hom a) =
        secHom.hom ((φ_deck γ).hom a) :=
      congrArg (fun m_hom => m_hom.hom a) (hDeck_inter γ)
    have hL5 : (C_Yk.obj.map (Opposite.op (ε_et 1))).hom
        ((α_tilde.hom.app (Opposite.op Y_tilde)).hom (secHom.hom ((φ_deck γ).hom a))) =
        (adj_const.unit.app A_K).hom ((φ_deck γ).hom a) :=
      congrArg (fun m_hom => m_hom.hom ((φ_deck γ).hom a)) hUnit_eval
    have hL6 : (β.hom.app (Opposite.op T_Yk)).hom
        ((adj_const.unit.app A_K).hom ((φ_deck γ).hom a)) =
        γ₀.hom ((φ_deck γ).hom a) :=
      congrArg (fun m_hom => m_hom.hom ((φ_deck γ).hom a)) hβ_unit
    have hL_pt : ((L_k.obj 𝒢_tilde).obj.map (Opposite.op (ε_et 1 ≫ B_k.map (u_deck γ)))).hom
        ((Φ_LHS.hom.app (Opposite.op Y_tilde)).hom (secHom.hom a)) =
        γ₀.hom ((φ_deck γ).hom a) :=
      hL1.trans
        ((congrArg (β.hom.app (Opposite.op T_Yk)).hom
          (hL2.trans
            ((congrArg (C_Yk.obj.map (Opposite.op (ε_et 1))).hom
              (hL3.trans (congrArg (α_tilde.hom.app (Opposite.op Y_tilde)).hom hL4))).trans
              hL5))).trans hL6)
    have hR1 : ((L_k.obj 𝒢_tilde).obj.map (Opposite.op (ε_et 1 ≫ B_k.map (u_deck γ)))).hom
        (η_Ytilde.hom (secHom.hom a)) =
        ((L_k.obj 𝒢_tilde).obj.map (Opposite.op (ε_et 1))).hom
          (((L_k.obj 𝒢_tilde).obj.map (Opposite.op (B_k.map (u_deck γ)))).hom
            (η_Ytilde.hom (secHom.hom a))) :=
      congrArg (fun m_hom => m_hom.hom (η_Ytilde.hom (secHom.hom a)))
        ((L_k.obj 𝒢_tilde).obj.map_comp (Opposite.op (B_k.map (u_deck γ))) (Opposite.op (ε_et 1)))
    have hR2 : ((L_k.obj 𝒢_tilde).obj.map (Opposite.op (B_k.map (u_deck γ)))).hom
        (η_Ytilde.hom (secHom.hom a)) =
        η_Ytilde.hom ((𝒢_tilde.obj.map (Opposite.op (u_deck γ))).hom (secHom.hom a)) :=
      congrArg (fun m_hom => m_hom.hom (secHom.hom a))
        (Φ_RHS.hom.naturality (Opposite.op (u_deck γ))).symm
    have hR_pt : ((L_k.obj 𝒢_tilde).obj.map (Opposite.op (ε_et 1 ≫ B_k.map (u_deck γ)))).hom
        ((Φ_RHS.hom.app (Opposite.op Y_tilde)).hom (secHom.hom a)) =
        γ₀.hom ((φ_deck γ).hom a) :=
      hR1.trans
        (congrArg ((L_k.obj 𝒢_tilde).obj.map (Opposite.op (ε_et 1))).hom
          (hR2.trans (congrArg η_Ytilde.hom hL4)))
    exact hL_pt.trans hR_pt.symm

  let zHom : ∀ {M : AddCommGrpCat.{u}} (_ : ↥M), AddCommGrpCat.of (ULift.{u} ℤ) ⟶ M :=
    fun {M} m_el => AddCommGrpCat.ofHom
      { toFun := fun z => z.down • m_el
        map_zero' := zero_zsmul m_el
        map_add' := fun z₁ z₂ => add_zsmul m_el z₁.down z₂.down }

  have hΦ_eq : Φ_LHS = Φ_RHS := by
    apply CategoryTheory.Sheaf.hom_ext
    ext W_op : 2
    let W := W_op.unop
    have hW_op : W_op = Opposite.op W := rfl
    rw [hW_op]
    apply AddCommGrpCat.ext
    intro s
    let h_W := (FgtU.obj W).hom
    let W_k := CategoryTheory.Limits.pullback h_W π_k
    let fst_W := CategoryTheory.Limits.pullback.fst h_W π_k
    let snd_W := CategoryTheory.Limits.pullback.snd h_W π_k
    have hpb_W := CategoryTheory.IsPullback.of_hasPullback h_W π_k
    have hfst_et : AlgebraicGeometry.Etale fst_W :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_W.flip hEt_πk
    have hfst_surj : AlgebraicGeometry.Surjective fst_W :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_W.flip hSurj_πk
    have hsnd_et : AlgebraicGeometry.Etale snd_W :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_W W.prop
    have hsnd_π_et : AlgebraicGeometry.Etale (snd_W ≫ π_k) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) snd_W π_k hsnd_et hEt_πk
    let W_k_tilde : Y₀.left.Etale := AlgebraicGeometry.Scheme.Etale.mk (snd_W ≫ π_k)
    let p_W : W_k_tilde ⟶ W :=
      (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful Y₀.left).preimage
        (CategoryTheory.Over.homMk fst_W CategoryTheory.Limits.pullback.condition)
    have hp_W_left : (FgtU.map p_W).left = fst_W :=
      congrArg CategoryTheory.Over.Hom.left
        ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful Y₀.left).map_preimage _)
    let s₁ : ↑(𝒢_tilde.obj.obj (Opposite.op W_k_tilde)) :=
      (𝒢_tilde.obj.map (Opposite.op p_W)).hom s
    obtain ⟨δ_W, hδW_props, _, _, _⟩ := hSheetPkg W_k snd_W
    let g_s : LocallyConstant ↥W_k (Fin K → Λ) := (triv_tilde W_k_tilde s₁).comap (δ_W 1).base.hom
    let U_a : ↥A_K → W_k.Opens :=
      fun a => ⟨g_s ⁻¹' {a.down}, g_s.isLocallyConstant {a.down}⟩
    let g_a : ∀ a : ↥A_K, (U_a a).toScheme ⟶ Y_k := fun a => (U_a a).ι ≫ snd_W
    have hg_a_π_et : ∀ a : ↥A_K, AlgebraicGeometry.Etale (g_a a ≫ π_k) :=
      fun a => CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        (g_a a) π_k (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          (U_a a).ι snd_W inferInstance hsnd_et) hEt_πk
    let Y_W : ↥A_K → Y₀.left.Etale := fun a =>
      have : AlgebraicGeometry.Etale (g_a a ≫ π_k) := hg_a_π_et a
      AlgebraicGeometry.Scheme.Etale.mk (g_a a ≫ π_k)
    let j_a : ∀ a : ↥A_K, Y_W a ⟶ W_k_tilde :=
      fun a =>
        (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful Y₀.left).preimage
          (CategoryTheory.Over.homMk (U_a a).ι
            (CategoryTheory.Category.assoc (U_a a).ι snd_W π_k))
    have hj_a_left : ∀ a : ↥A_K, (FgtU.map (j_a a)).left = (U_a a).ι :=
      fun a => congrArg CategoryTheory.Over.Hom.left
        ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful Y₀.left).map_preimage _)
    let k_W : ∀ a : ↥A_K, Y_W a ⟶ W := fun a => j_a a ≫ p_W
    let q_W : ∀ a : ↥A_K, Y_W a ⟶ Y_tilde :=
      fun a =>
        (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful Y₀.left).preimage
          (CategoryTheory.Over.homMk (g_a a)
            (by change g_a a ≫ (𝟙 Y_k ≫ π_k) = g_a a ≫ π_k; rw [CategoryTheory.Category.id_comp]))
    have hq_W_left : ∀ a : ↥A_K, (FgtU.map (q_W a)).left = g_a a :=
      fun a => congrArg CategoryTheory.Over.Hom.left
        ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful Y₀.left).map_preimage _)

    have hCov_W : CategoryTheory.Sieve.ofArrows Y_W k_W ∈ Y₀.left.smallEtaleTopology W := by
      rw [_hMem_Y₀ W]
      intro x
      obtain ⟨z, rfl⟩ := fst_W.surjective x
      let a : ↥A_K := ULift.up (g_s z)
      let y_pt : ↥(U_a a).toScheme := ⟨z, rfl⟩
      refine ⟨Y_W a, k_W a, y_pt, CategoryTheory.Sieve.ofArrows_mk Y_W k_W a,
        hu_et (k_W a), ?_⟩
      have hk_left : (FgtU.map (k_W a)).left = (U_a a).ι ≫ fst_W :=
        (congrArg CategoryTheory.Over.Hom.left (FgtU.map_comp (j_a a) p_W)).trans
          (congrArg₂ CategoryTheory.CategoryStruct.comp (hj_a_left a) hp_W_left)
      have hpt := congrArg (fun m_hom : (U_a a).toScheme ⟶ (FgtU.obj W).left => m_hom.base y_pt)
        hk_left
      exact hpt.trans (AlgebraicGeometry.Scheme.Hom.comp_apply (U_a a).ι fst_W y_pt)

    have hSec_eq : ∀ a : ↥A_K,
        (𝒢_tilde.obj.map (Opposite.op (k_W a))).hom s =
          (𝒢_tilde.obj.map (Opposite.op (q_W a))).hom (secHom.hom a) := by
      intro a
      have hk_map : 𝒢_tilde.obj.map (Opposite.op (k_W a)) =
          𝒢_tilde.obj.map (Opposite.op p_W) ≫ 𝒢_tilde.obj.map (Opposite.op (j_a a)) :=
        𝒢_tilde.obj.map_comp (Opposite.op p_W) (Opposite.op (j_a a))
      refine (congrArg (fun m_hom => m_hom.hom s) hk_map).trans ?_
      change (𝒢_tilde.obj.map (Opposite.op (j_a a))).hom s₁ =
        (𝒢_tilde.obj.map (Opposite.op (q_W a))).hom (sec_fun a)
      obtain ⟨δ_Ua, hδUa_props, _, hUniq_Ua, _⟩ := hSheetPkg (U_a a).toScheme (g_a a)
      apply (_htriv_tilde_range (Y_W a)).1
      apply hUniq_Ua _ _
        (htriv_equiv (Y_W a) ((𝒢_tilde.obj.map (Opposite.op (j_a a))).hom s₁))
        (htriv_equiv (Y_W a) ((𝒢_tilde.obj.map (Opposite.op (q_W a))).hom (sec_fun a)))
      apply LocallyConstant.ext
      intro y
      have hj_comm : δ_Ua 1 ≫ u_can (j_a a) = (U_a a).ι ≫ δ_W 1 := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc (δ_Ua 1) (u_can (j_a a)) _).trans
            ((congrArg (δ_Ua 1 ≫ ·) (hu_can_fst (j_a a))).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ _) (hδUa_props 1).1).trans
                  ((CategoryTheory.Category.id_comp _).trans
                    ((hj_a_left a).trans
                      ((CategoryTheory.Category.comp_id (U_a a).ι).symm.trans
                        ((congrArg ((U_a a).ι ≫ ·) (hδW_props 1).1.symm).trans
                          (CategoryTheory.Category.assoc _ _ _).symm)))))))
        · exact (CategoryTheory.Category.assoc (δ_Ua 1) (u_can (j_a a)) _).trans
            ((congrArg (δ_Ua 1 ≫ ·) (hu_can_snd (j_a a))).trans
              ((hδUa_props 1).2.1.trans
                ((congrArg (g_a a ≫ ·) hs_one).trans
                  ((CategoryTheory.Category.comp_id (g_a a)).trans
                    ((CategoryTheory.Category.comp_id ((U_a a).ι ≫ snd_W)).symm.trans
                      ((congrArg (((U_a a).ι ≫ snd_W) ≫ ·) hs_one.symm).trans
                        ((CategoryTheory.Category.assoc (U_a a).ι snd_W (s_mor 1)).trans
                          ((congrArg ((U_a a).ι ≫ ·) (hδW_props 1).2.1.symm).trans
                            (CategoryTheory.Category.assoc _ _ _).symm))))))))
      have hq_comm : δ_Ua 1 ≫ u_can (q_W a) = g_a a ≫ δ_Y 1 := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc (δ_Ua 1) (u_can (q_W a)) _).trans
            ((congrArg (δ_Ua 1 ≫ ·) (hu_can_fst (q_W a))).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ _) (hδUa_props 1).1).trans
                  ((CategoryTheory.Category.id_comp _).trans
                    ((hq_W_left a).trans
                      ((CategoryTheory.Category.comp_id (g_a a)).symm.trans
                        ((congrArg (g_a a ≫ ·) (hδY_props 1).1.symm).trans
                          (CategoryTheory.Category.assoc _ _ _).symm)))))))
        · exact (CategoryTheory.Category.assoc (δ_Ua 1) (u_can (q_W a)) _).trans
            ((congrArg (δ_Ua 1 ≫ ·) (hu_can_snd (q_W a))).trans
              ((hδUa_props 1).2.1.trans
                ((congrArg (g_a a ≫ ·) hs_one).trans
                  ((CategoryTheory.Category.comp_id (g_a a)).trans
                    ((congrArg (g_a a ≫ ·) (hε_snd 1).symm).trans
                      ((congrArg (fun m_hom => g_a a ≫ m_hom ≫ _) hε_one).trans
                        (CategoryTheory.Category.assoc _ _ _).symm))))))
      have hL_comap :
          triv_tilde (Y_W a) ((𝒢_tilde.obj.map (Opposite.op (j_a a))).hom s₁) ((δ_Ua 1).base y) =
          triv_tilde W_k_tilde s₁ ((u_can (j_a a)).base ((δ_Ua 1).base y)) :=
        congrArg (fun g : LocallyConstant _ _ => g ((δ_Ua 1).base y)) (htriv_comap (j_a a) s₁)
      have hL_pt :
          triv_tilde (Y_W a) ((𝒢_tilde.obj.map (Opposite.op (j_a a))).hom s₁) ((δ_Ua 1).base y) =
          a.down := by
        have h1 : (u_can (j_a a)).base ((δ_Ua 1).base y) =
            (δ_W 1).base ((U_a a).ι.base y) :=
          (AlgebraicGeometry.Scheme.Hom.comp_apply (δ_Ua 1) (u_can (j_a a)) y).symm.trans
            ((congrArg (fun m_hom => m_hom.base y) hj_comm).trans
              (AlgebraicGeometry.Scheme.Hom.comp_apply (U_a a).ι (δ_W 1) y))
        exact hL_comap.trans
          ((congrArg (triv_tilde W_k_tilde s₁) h1).trans y.2)
      have hR_comap :
          triv_tilde (Y_W a) ((𝒢_tilde.obj.map (Opposite.op (q_W a))).hom (sec_fun a))
            ((δ_Ua 1).base y) =
          triv_tilde Y_tilde (sec_fun a) ((u_can (q_W a)).base ((δ_Ua 1).base y)) :=
        congrArg (fun g : LocallyConstant _ _ => g ((δ_Ua 1).base y))
          (htriv_comap (q_W a) (sec_fun a))
      have hR_pt :
          triv_tilde (Y_W a) ((𝒢_tilde.obj.map (Opposite.op (q_W a))).hom (sec_fun a))
            ((δ_Ua 1).base y) =
          a.down := by
        have h1 : (u_can (q_W a)).base ((δ_Ua 1).base y) =
            (δ_Y 1).base ((g_a a).base y) :=
          (AlgebraicGeometry.Scheme.Hom.comp_apply (δ_Ua 1) (u_can (q_W a)) y).symm.trans
            ((congrArg (fun m_hom => m_hom.base y) hq_comm).trans
              (AlgebraicGeometry.Scheme.Hom.comp_apply (g_a a) (δ_Y 1) y))
        have h2 : triv_tilde Y_tilde (sec_fun a) ((δ_Y 1).base ((g_a a).base y)) = a.down := by
          rw [hsec_sheet a 1 ((g_a a).base y), map_one ρ_bar, Units.val_one, Matrix.one_mulVec]
        exact hR_comap.trans ((congrArg (triv_tilde Y_tilde (sec_fun a)) h1).trans h2)
      exact hL_pt.trans hR_pt.symm

    let ℋ := P_k.obj (L_k.obj 𝒢_tilde)
    have hz_eq : zHom ((Φ_LHS.hom.app (Opposite.op W)).hom s) =
        zHom ((Φ_RHS.hom.app (Opposite.op W)).hom s) := by
      apply ℋ.property.hom_ext_ofArrows k_W hCov_W
      intro a
      apply AddCommGrpCat.ext
      intro z
      change (ℋ.obj.map (Opposite.op (k_W a))).hom
          (z.down • (Φ_LHS.hom.app (Opposite.op W)).hom s) =
        (ℋ.obj.map (Opposite.op (k_W a))).hom
          (z.down • (Φ_RHS.hom.app (Opposite.op W)).hom s)
      rw [map_zsmul, map_zsmul]
      congr 1
      have hnat_L := congrArg (fun m_hom => m_hom.hom s) (Φ_LHS.hom.naturality (Opposite.op (k_W a)))
      have hnat_R := congrArg (fun m_hom => m_hom.hom s) (Φ_RHS.hom.naturality (Opposite.op (k_W a)))
      change (Φ_LHS.hom.app (Opposite.op (Y_W a))).hom
          ((𝒢_tilde.obj.map (Opposite.op (k_W a))).hom s) =
        (ℋ.obj.map (Opposite.op (k_W a))).hom ((Φ_LHS.hom.app (Opposite.op W)).hom s) at hnat_L
      change (Φ_RHS.hom.app (Opposite.op (Y_W a))).hom
          ((𝒢_tilde.obj.map (Opposite.op (k_W a))).hom s) =
        (ℋ.obj.map (Opposite.op (k_W a))).hom ((Φ_RHS.hom.app (Opposite.op W)).hom s) at hnat_R
      rw [← hnat_L, ← hnat_R, hSec_eq a]
      have hq_L := congrArg (fun m_hom => m_hom.hom (secHom.hom a))
        (Φ_LHS.hom.naturality (Opposite.op (q_W a)))
      have hq_R := congrArg (fun m_hom => m_hom.hom (secHom.hom a))
        (Φ_RHS.hom.naturality (Opposite.op (q_W a)))
      change (Φ_LHS.hom.app (Opposite.op (Y_W a))).hom
          ((𝒢_tilde.obj.map (Opposite.op (q_W a))).hom (secHom.hom a)) =
        (ℋ.obj.map (Opposite.op (q_W a))).hom
          ((Φ_LHS.hom.app (Opposite.op Y_tilde)).hom (secHom.hom a)) at hq_L
      change (Φ_RHS.hom.app (Opposite.op (Y_W a))).hom
          ((𝒢_tilde.obj.map (Opposite.op (q_W a))).hom (secHom.hom a)) =
        (ℋ.obj.map (Opposite.op (q_W a))).hom
          ((Φ_RHS.hom.app (Opposite.op Y_tilde)).hom (secHom.hom a)) at hq_R
      rw [hq_L, hq_R]
      congr 1
      exact congrArg (fun m_hom => m_hom.hom a) hUniv_Ytilde
    have h1 := congrArg (fun m_hom => m_hom.hom (ULift.up (1 : ℤ))) hz_eq
    simpa only [zHom, AddCommGrpCat.hom_ofHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk,
      one_zsmul] using h1

  have hαβ : α ≫ β = 𝟙 (L_k.obj 𝒢_tilde) := by
    apply (adj_k.homEquiv 𝒢_tilde (L_k.obj 𝒢_tilde)).injective
    have hL_eq : adj_k.homEquiv 𝒢_tilde (L_k.obj 𝒢_tilde) (α ≫ β) = Φ_LHS := by
      rw [adj_k.homEquiv_unit, P_k.map_comp, ← CategoryTheory.Category.assoc, hα_unit]
    have hR_eq : adj_k.homEquiv 𝒢_tilde (L_k.obj 𝒢_tilde) (𝟙 (L_k.obj 𝒢_tilde)) = Φ_RHS := by
      rw [adj_k.homEquiv_unit, P_k.map_id]
      exact CategoryTheory.Category.comp_id _
    exact hL_eq.trans (hΦ_eq.trans hR_eq.symm)

  exact ⟨hCont_k, _hAdj_k, ⟨CategoryTheory.Iso.mk α β hαβ hβα⟩⟩

theorem weil_mid_dev_geom_trivial_pushforward_h1_subsingleton (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hu₀_mem : Set.range u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left))
    (ℓ r K : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    let D₀ := weilProjectiveSpaceOver F 1
    let pr_D : Quiver.Hom (weilGeomScheme F D₀) D₀.left :=
      CategoryTheory.Limits.pullback.fst D₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
    ∀ (a₀ : F) (_ha₀ : a₀ ∉ S_aff)
      (B_r L_r : Type u)
      [CommRing B_r] [IsDomain B_r] [Field L_r]
      [Algebra F B_r] [Algebra (Polynomial F) B_r] [Algebra R₀ B_r]
      [Algebra F L_r] [Algebra (Polynomial F) L_r] [Algebra (RatFunc F) L_r]
      [Algebra B_r L_r] [Algebra R₀ L_r]
      [IsScalarTower F (Polynomial F) B_r] [IsScalarTower (Polynomial F) R₀ B_r]
      [IsScalarTower F (RatFunc F) L_r] [IsScalarTower (Polynomial F) (RatFunc F) L_r]
      [IsScalarTower (Polynomial F) B_r L_r] [IsScalarTower R₀ B_r L_r]
      [Module.Finite R₀ B_r] [Algebra.Etale R₀ B_r]
      [IsFractionRing B_r L_r] [IsIntegralClosure B_r R₀ L_r]
      [FiniteDimensional (RatFunc F) L_r] [IsGalois (RatFunc F) L_r]
      (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme)
      (_heU_eq : CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R₀))) j_aff)
      (_hQ_u_r : ∃ Q_u : Ideal B_r, Q_u.IsMaximal ∧
        Ideal.comap (algebraMap (Polynomial F) B_r) Q_u =
          Ideal.span {Polynomial.X - Polynomial.C a₀} ∧
        ∃ σ_u : B_r ≃ₐ[R₀] B_r, ∀ b : B_r, σ_u.symm b - b ^ Nat.card F ∈ Q_u)
      (ρ_𝒢 : (B_r ≃ₐ[R₀] B_r) →* (Matrix (Fin K) (Fin K) (ZMod (ℓ ^ (r + 1))))ˣ)
      (_hGeom_triv : ∀ τ : B_r ≃ₐ[R₀] B_r, (∀ x : B_r, IsIntegral F x → τ x = x) → ρ_𝒢 τ = 1)
      (𝒢₀ : CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
      (triv_𝒢 : ∀ W : U₀.toScheme.Etale,
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of B_r)
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r))) e_U.hom
        let W_r := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom π_r
        ↑(𝒢₀.obj.obj (Opposite.op W)) →+
          (LocallyConstant ↥W_r (Fin K → ZMod (ℓ ^ (r + 1)))))
      (_htriv_𝒢 :
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of B_r)
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r))) e_U.hom
        (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
          let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
          let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
          let W₁_r := CategoryTheory.Limits.pullback h₁ π_r
          let W₂_r := CategoryTheory.Limits.pullback h₂ π_r
          ∀ (u_r : Quiver.Hom W₁_r W₂_r),
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.fst h₂ π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.fst h₁ π_r)
                ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.snd h₂ π_r) =
              CategoryTheory.Limits.pullback.snd h₁ π_r →
            ∀ (s : ↑(𝒢₀.obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_r),
              triv_𝒢 W₁ ((𝒢₀.obj.map (Opposite.op u)) s) y₁ =
                triv_𝒢 W₂ s (u_r.base y₁)) ∧
        ∀ W : U₀.toScheme.Etale,
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
          let W_r := CategoryTheory.Limits.pullback h_W π_r
          Function.Injective (triv_𝒢 W) ∧
          Set.range (triv_𝒢 W) =
            { f | ∀ (σ : B_r ≃ₐ[R₀] B_r) (m_σ : Quiver.Hom W_r W_r),
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W π_r) =
                CategoryTheory.Limits.pullback.fst h_W π_r →
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W π_r) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W π_r)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
              ∀ y : ↥W_r, f (m_σ.base y) = ((ρ_𝒢 σ).val).mulVec (f y) })
      (hCont_pr : (weilEtaleSitePullback pr_D).IsContinuous
        D₀.left.smallEtaleTopology (weilGeomScheme F D₀).smallEtaleTopology)
      (hAdj_pr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback pr_D) AddCommGrpCat.{u} _
        D₀.left.smallEtaleTopology (weilGeomScheme F D₀).smallEtaleTopology hCont_pr).IsRightAdjoint),
      Subsingleton
        (((@CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback pr_D) AddCommGrpCat.{u} _
          D₀.left.smallEtaleTopology (weilGeomScheme F D₀).smallEtaleTopology
          hCont_pr hAdj_pr).obj (weilEtaleHigherDirectImage U₀.ι 0 𝒢₀)).H 1) :=
by
  intro R₀ D₀ pr_D a₀ ha₀ B_r L_r _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
    e_U heU_eq hQ_u_r ρ_𝒢 hGeom_triv 𝒢₀ triv_𝒢 htriv_𝒢 hCont_pr hAdj_pr
  let Λ := ZMod (ℓ ^ (r + 1))
  let S := weilGeomScheme F D₀

  
  obtain ⟨pt₀⟩ := (inferInstance : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of F)))
  have hU₀_ne : Nonempty ↥U₀.toScheme := ⟨⟨u₀.base pt₀, hu₀_mem ⟨pt₀, rfl⟩⟩⟩
  have hH1_mod_ℓ : Subsingleton (weilEtaleTorsionH S ℓ 1) :=
    (weil_smooth_pencil_projLine_geom_and_simply_connected F ℓ hℓ).2.2.2.2
  obtain ⟨u_chart₀, u_chart₁, hu₀_open, hu₁_open, -, -, hcov_charts, -⟩ :=
    weil_projLine_sc_two_chart_laurent_atlas F
  have hInt_D₀ : AlgebraicGeometry.IsIntegral D₀.left :=
    (weil_projectiveSpace_integral_krullDim_and_dim_zero_iso F 1).1
  have _ : AlgebraicGeometry.IsIntegral D₀.left := hInt_D₀
  have hLC_ext : ∀ (X : AlgebraicGeometry.Scheme.{u}) (h_X : X ⟶ D₀.left)
      [AlgebraicGeometry.Etale h_X],
      Function.Bijective
        (fun f : LocallyConstant ↥X (Fin K → Λ) =>
          f.comap (CategoryTheory.Limits.pullback.fst h_X U₀.ι).base.hom) :=
    fun X h_X _ =>
