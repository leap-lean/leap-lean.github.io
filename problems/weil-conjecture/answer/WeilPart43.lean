      fun A Y => AddEquiv.ofBijective (θ_of A Y) ((hθ_spec A).1 Y)
    have hθ_map : ∀ {A₁ A₂ : AddCommGrpCat.{u}} (φ : A₁ ⟶ A₂) (Y : S.Etale)
        (g : LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y).left ↥A₁),
        ((C_S.map φ).hom.app (Opposite.op Y)).hom (θ_of A₁ Y g) =
          θ_of A₂ Y (g.map φ.hom) := by
      intro A₁ A₂ φ Y g
      let U_a : ↥A₁ → Y.left.Opens :=
        fun a => ⟨g ⁻¹' {a}, g.isLocallyConstant {a}⟩
      let Y_a : ↥A₁ → S.Etale :=
        fun a => AlgebraicGeometry.Scheme.Etale.mk ((U_a a).ι ≫ Y.hom)
      let j_a : ∀ a : ↥A₁, Y_a a ⟶ Y :=
        fun a => CategoryTheory.MorphismProperty.Over.homMk (U_a a).ι rfl
