        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom
        let W_r := CategoryTheory.Limits.pullback h_W π_r
        ∃ δ' : (B_V ≃ₐ[R₀] B_V) →
            (((AlgebraicGeometry.Scheme.Etale.forget U).obj W).left ⟶ W_r),
          (∀ σ : B_V ≃ₐ[R₀] B_V,
            δ' σ ≫ CategoryTheory.Limits.pullback.fst h_W π_r = 𝟙 _) ∧
          ((⋃ σ : B_V ≃ₐ[R₀] B_V, Set.range (δ' σ).base) = Set.univ) ∧
          (∀ (σ τ : B_V ≃ₐ[R₀] B_V), δ' σ ≫ m_act W τ = δ' (τ * σ)) ∧
          ∀ (K_dim : ℕ)
            (ρ_X : (B_V ≃ₐ[R₀] B_V) →* (Matrix (Fin K_dim) (Fin K_dim) (ZMod m_mod))ˣ)
            (φ₀ : LocallyConstant ↥(((AlgebraicGeometry.Scheme.Etale.forget U).obj W).left)
              (Fin K_dim → ZMod m_mod)),
            ∃ F : LocallyConstant ↥W_r (Fin K_dim → ZMod m_mod),
              (∀ (σ : B_V ≃ₐ[R₀] B_V)
                 (x : ↥(((AlgebraicGeometry.Scheme.Etale.forget U).obj W).left)),
                F ((δ' σ).base x) = ((ρ_X σ).val).mulVec (φ₀ x)) ∧
              (∀ (τ : B_V ≃ₐ[R₀] B_V) (m_τ : W_r ⟶ W_r),
                m_τ ≫ CategoryTheory.Limits.pullback.fst h_W π_r =
                  CategoryTheory.Limits.pullback.fst h_W π_r →
                m_τ ≫ CategoryTheory.Limits.pullback.snd h_W π_r =
                  CategoryTheory.Limits.pullback.snd h_W π_r ≫ d_V τ →
