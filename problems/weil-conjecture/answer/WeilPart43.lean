      have hx₃ : x₃' = 0 := @Subsingleton.elim ((E_S.obj A₃).H 1) hSub3 x₃' 0
      obtain ⟨x₁', hx₁'⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ hSE_map x₂' hx₃
      have hx₁_zero : x₁' = 0 := @Subsingleton.elim ((E_S.obj A₁).H 1) hSub1 x₁' 0
      rw [← hx₁', hx₁_zero, CategoryTheory.Abelian.Ext.zero_comp]
    exact Subsingleton.intro fun a b => (hZero2 a).trans (hZero2 b).symm
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_pos : 0 < ℓ := hPrime.pos
  have hZModPow : ∀ s : ℕ,
      Subsingleton ((E_S.obj (AddCommGrpCat.of (ZMod (ℓ ^ (s + 1))))).H 1) := by
    intro s
    induction s with
    | zero =>
      change Subsingleton (weilEtaleTorsionH S (ℓ ^ (0 + 1)) 1)
      rw [Nat.zero_add, pow_one]
