by
  have _ := hj_open; have _ := hU₀_eq; have _ := hℓ
  
  
  
  have h_s9 (F : Type u) [Finite F] [Field F]
      (R₀ B_r L_r k_L E : Type u)
      [CommRing R₀] [IsDomain R₀] [CommRing B_r] [IsDomain B_r] [Field L_r]
      [Finite k_L] [Field k_L] [Field E]
      [Algebra (Polynomial F) R₀]
      [Algebra F B_r] [Algebra (Polynomial F) B_r] [Algebra R₀ B_r]
      [Algebra F L_r] [Algebra (Polynomial F) L_r] [Algebra (RatFunc F) L_r]
      [Algebra B_r L_r] [Algebra R₀ L_r] [Algebra R₀ (RatFunc F)]
      [IsScalarTower F (Polynomial F) B_r] [IsScalarTower (Polynomial F) R₀ B_r]
      [IsScalarTower F (RatFunc F) L_r] [IsScalarTower (Polynomial F) (RatFunc F) L_r]
      [IsScalarTower (Polynomial F) B_r L_r]
      [IsScalarTower R₀ B_r L_r] [IsScalarTower R₀ (RatFunc F) L_r]
      [IsFractionRing R₀ (RatFunc F)]
      [IsFractionRing B_r L_r] [IsIntegralClosure B_r R₀ L_r]
      [FiniteDimensional (RatFunc F) L_r] [IsGalois (RatFunc F) L_r]
      [Algebra F k_L] [Algebra k_L L_r] [Algebra k_L E]
      [Algebra (RatFunc k_L) E] [Algebra (RatFunc k_L) L_r] [Algebra E L_r]
      [IsScalarTower F k_L L_r] [IsScalarTower k_L (RatFunc k_L) L_r]
      [IsScalarTower k_L E L_r] [IsScalarTower (RatFunc k_L) E L_r]
      [FiniteDimensional (RatFunc k_L) L_r] [IsGalois (RatFunc k_L) L_r]
      (hk_int : ∀ c : k_L, IsIntegral F (algebraMap k_L L_r c))
      (hE_int : ∀ x : E, IsIntegral k_L x → x ∈ Set.range (algebraMap k_L E))
      (hGal_fix : ∀ (σ_K : L_r ≃ₐ[RatFunc k_L] L_r) (x : L_r), IsIntegral F x → σ_K x = x)
      (M : ℕ) (Λ : Type) [CommRing Λ]
      (ρ_G : (B_r ≃ₐ[R₀] B_r) →* (Matrix (Fin M) (Fin M) Λ)ˣ)
      (hρ_geom : ∀ τ : B_r ≃ₐ[R₀] B_r, (∀ x : B_r, IsIntegral F x → τ x = x) → (ρ_G τ).val = 1) :
      ∃ (ι_kB : k_L →ₐ[F] B_r)
        (res_k : (B_r ≃ₐ[R₀] B_r) →* (k_L ≃ₐ[F] k_L))
        (ρ_bar : (k_L ≃ₐ[F] k_L) →* (Matrix (Fin M) (Fin M) Λ)ˣ),
        (Algebra.Etale F k_L ∧ IsGalois F k_L ∧ Algebra.IsAlgebraic F k_L) ∧
        (Function.Surjective res_k ∧
          (∀ (σ : B_r ≃ₐ[R₀] B_r) (c : k_L), σ (ι_kB c) = ι_kB (res_k σ c)) ∧
          (∀ σ : B_r ≃ₐ[R₀] B_r, ρ_bar (res_k σ) = ρ_G σ)) ∧
        (∀ (Q_u : Ideal B_r) (σ_u : B_r ≃ₐ[R₀] B_r),
          Q_u.IsMaximal →
          (∀ b : B_r, σ_u.symm b - b ^ Nat.card F ∈ Q_u) →
