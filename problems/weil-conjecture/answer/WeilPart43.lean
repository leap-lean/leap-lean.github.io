            (@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
              (AlgebraicClosure F) _ _ _).symm (ι_0 c) = ι_0 (res_k σ_u c)) := by
    classical
    have hGal_Fk : IsGalois F k_L := @GaloisField.instIsGaloisOfFinite F k_L _ _ _ _
    have hSep_Fk : Algebra.IsSeparable F k_L := inferInstance
    have hAlg_Fk : Algebra.IsAlgebraic F k_L := inferInstance
    have hFin_Fk : Module.Finite F k_L := Module.Finite.of_finite
    have hFT_Fk : Algebra.FiniteType F k_L := Module.Finite.finiteType k_L
    have hFP_Fk : Algebra.FinitePresentation F k_L := Algebra.FinitePresentation.of_finiteType.mp hFT_Fk
    have hFE_Fk : Algebra.FormallyEtale F k_L := Algebra.FormallyEtale.of_isSeparable F k_L
    have hEt_Fk : Algebra.Etale F k_L := @Algebra.Etale.mk F k_L _ _ _ hFE_Fk hFP_Fk
    have : IsScalarTower F (Polynomial F) L_r :=
      IsScalarTower.of_algebraMap_eq fun c => by
        rw [IsScalarTower.algebraMap_apply F (RatFunc F) L_r,
          IsScalarTower.algebraMap_apply F (Polynomial F) (RatFunc F),
          ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L_r]
    have : IsScalarTower F B_r L_r :=
      IsScalarTower.of_algebraMap_eq fun c => by
        rw [IsScalarTower.algebraMap_apply F (Polynomial F) L_r,
          IsScalarTower.algebraMap_apply (Polynomial F) B_r L_r,
          ← IsScalarTower.algebraMap_apply F (Polynomial F) B_r]
    let _ : Algebra F R₀ := ((algebraMap (Polynomial F) R₀).comp (algebraMap F (Polynomial F))).toAlgebra
    have : IsScalarTower F (Polynomial F) R₀ := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have : IsScalarTower F R₀ B_r :=
      IsScalarTower.of_algebraMap_eq fun c => by
        rw [IsScalarTower.algebraMap_apply F (Polynomial F) B_r,
          IsScalarTower.algebraMap_apply (Polynomial F) R₀ B_r,
          ← IsScalarTower.algebraMap_apply F (Polynomial F) R₀]
    have : IsScalarTower F R₀ L_r :=
      IsScalarTower.of_algebraMap_eq fun c => by
        rw [IsScalarTower.algebraMap_apply F B_r L_r,
          IsScalarTower.algebraMap_apply F R₀ B_r,
          ← IsScalarTower.algebraMap_apply R₀ B_r L_r]
    have hInj_BL : Function.Injective (algebraMap B_r L_r) := IsFractionRing.injective B_r L_r
    have hk_in_B : ∀ c : k_L, ∃ b : B_r, algebraMap B_r L_r b = algebraMap k_L L_r c := by
      intro c
      have h1 : IsIntegral F (algebraMap k_L L_r c) := hk_int c
      have h2 : IsIntegral R₀ (algebraMap k_L L_r c) := IsIntegral.tower_top h1
      exact (IsIntegralClosure.isIntegral_iff (A := B_r)).mp h2
    let ι_fun : k_L → B_r := fun c => Classical.choose (hk_in_B c)
    have hι_fun : ∀ c : k_L, algebraMap B_r L_r (ι_fun c) = algebraMap k_L L_r c :=
      fun c => Classical.choose_spec (hk_in_B c)
    let ι_kB : k_L →ₐ[F] B_r :=
      { toFun := ι_fun
        map_one' := hInj_BL (by rw [hι_fun, map_one, map_one])
        map_mul' := fun x y => hInj_BL (by rw [hι_fun, map_mul, map_mul, hι_fun, hι_fun])
        map_zero' := hInj_BL (by rw [hι_fun, map_zero, map_zero])
        map_add' := fun x y => hInj_BL (by rw [hι_fun, map_add, map_add, hι_fun, hι_fun])
        commutes' := fun r => hInj_BL (by
          rw [hι_fun, ← IsScalarTower.algebraMap_apply F k_L L_r,
            ← IsScalarTower.algebraMap_apply F B_r L_r]) }
    have hι_apply : ∀ c : k_L, algebraMap B_r L_r (ι_kB c) = algebraMap k_L L_r c := hι_fun
    have hι_inj : Function.Injective ι_kB := ι_kB.toRingHom.injective
    have hInt_iff_range : ∀ b : B_r, IsIntegral F b ↔ b ∈ Set.range ι_kB := by
      intro b
      constructor
      · intro hb
        let z : L_r := algebraMap B_r L_r b
        have hz_F : IsIntegral F z := hb.map (IsScalarTower.toAlgHom F B_r L_r)
        have hz_fix : z ∈ IntermediateField.fixedField (⊤ : Subgroup (L_r ≃ₐ[RatFunc k_L] L_r)) := by
          rw [IntermediateField.mem_fixedField_iff]
          intro σ_K _
          exact hGal_fix σ_K z hz_F
        rw [IsGalois.fixedField_top, IntermediateField.mem_bot] at hz_fix
        rcases hz_fix with ⟨r, hr⟩
        have hrE : algebraMap E L_r (algebraMap (RatFunc k_L) E r) = z := by
          rw [← IsScalarTower.algebraMap_apply (RatFunc k_L) E L_r, hr]
        have hz_k : IsIntegral k_L z := IsIntegral.tower_top hz_F
        have hr_int : IsIntegral k_L (algebraMap (RatFunc k_L) E r) :=
          (isIntegral_algHom_iff (IsScalarTower.toAlgHom k_L E L_r)
            (algebraMap E L_r).injective).mp (hrE.symm ▸ hz_k)
        rcases hE_int _ hr_int with ⟨c, hc⟩
        refine ⟨c, hInj_BL ?_⟩
        rw [hι_apply c, IsScalarTower.algebraMap_apply k_L E L_r c, hc, hrE]
      · rintro ⟨c, rfl⟩
        exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom F B_r L_r) hInj_BL).mp
          (by rw [IsScalarTower.toAlgHom_apply, hι_apply]; exact hk_int c)
    have hσ_comm_F : ∀ (σ : B_r ≃ₐ[R₀] B_r) (r : F),
        σ (algebraMap F B_r r) = algebraMap F B_r r := by
