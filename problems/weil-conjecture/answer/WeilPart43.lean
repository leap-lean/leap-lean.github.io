  let _ : ∀ r, Algebra R₀ (L_fld r) := hARL
  have _ : ∀ r, IsScalarTower F (Polynomial F) (B r) := hST_FPB
  have _ : ∀ r, IsScalarTower (Polynomial F) R₀ (B r) := hST_PRB
  have _ : ∀ r, IsScalarTower F (RatFunc F) (L_fld r) := hST_FKL
  have _ : ∀ r, IsScalarTower (Polynomial F) (RatFunc F) (L_fld r) := hST_PKL
