  let _ : AlgebraicGeometry.IsProper P.Z_tilde.hom := P.hProp_Ztilde
  let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) P.Z_tilde.hom := P.hSm_Ztilde
  let _ : AlgebraicGeometry.Flat P.f₀.left := P.hFlat_f₀
  let _ : AlgebraicGeometry.IsProper P.f₀.left := P.hProp_f₀
  let _ : AlgebraicGeometry.Surjective P.f₀.left := P.hSurj_f₀
  let _ : AlgebraicGeometry.GeometricallyIrreducible P.Z_u₀.hom := P.hGeom_Zu₀
  let _ : AlgebraicGeometry.IsProper P.Z_u₀.hom := P.hProp_Zu₀
  let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) P.Z_u₀.hom := P.hSm_Zu₀
  have hSing_copy := hSing
  obtain ⟨hj_open, hj_hom, hsinf_sec, hsinf_compl, hU₀_eq, hu₀_mem, hSm_U₀,
    _, _, _, _, _, _, _, _, hx_inf_odp, hx_aff_odp, _⟩ := hSing_copy
  have h1d : WeilSingDevIs1dPencilOdpDatum F m P.Z_tilde P.f₀ P.u₀ j_aff s_inf S_aff U₀ :=
    ⟨hj_open, hj_hom, hsinf_sec, hsinf_compl, hU₀_eq, hu₀_mem, hSm_U₀, hx_inf_odp, hx_aff_odp⟩

  let modUnitsHom : ∀ r : ℕ,
      (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ →*
        (Matrix (Fin D.N) (Fin D.N) (ZMod (ℓ ^ (r + 1))))ˣ :=
    fun r => Units.map
      ((PadicInt.toZModPow (r + 1)).mapMatrix :
        Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ) →+*
          Matrix (Fin D.N) (Fin D.N) (ZMod (ℓ ^ (r + 1)))).toMonoidHom

  have hUnitMulInv : ∀ g : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ,
      ((g.val).map ι) * (((g⁻¹).val).map ι) = 1 ∧
      (((g⁻¹).val).map ι) * ((g.val).map ι) = 1 := by
    intro g
    constructor
    · rw [← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply, ← map_mul, Units.mul_inv, map_one]
    · rw [← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply, ← map_mul, Units.inv_mul, map_one]

  have hSkew_pair : ∀ x y : Fin D.N → K,
      dotProduct x (D.J_V.mulVec y) = - dotProduct y (D.J_V.mulVec x) := by
    intro x y
    calc dotProduct x (D.J_V.mulVec y)
        = dotProduct (Matrix.vecMul x D.J_V) y := Matrix.dotProduct_mulVec x D.J_V y
      _ = dotProduct (D.J_V.transpose.mulVec x) y := by rw [Matrix.mulVec_transpose]
      _ = dotProduct ((-D.J_V).mulVec x) y := by rw [D.hJV_skew]
      _ = dotProduct (-(D.J_V.mulVec x)) y := by rw [Matrix.neg_mulVec]
      _ = - dotProduct (D.J_V.mulVec x) y := neg_dotProduct _ _
      _ = - dotProduct y (D.J_V.mulVec x) := by rw [dotProduct_comm]

  have hSelf_zero : ∀ x : Fin D.N → K, dotProduct x (D.J_V.mulVec x) = 0 := by
    intro x
    have h := hSkew_pair x x
    have h2 : (2 : K) * dotProduct x (D.J_V.mulVec x) = 0 := by linear_combination h
    exact (mul_eq_zero.mp h2).resolve_left two_ne_zero

  have hGV_pair : ∀ g ∈ D.G_V, ∀ x y : Fin D.N → K,
      dotProduct (((g.val).map ι).mulVec x) (D.J_V.mulVec (((g.val).map ι).mulVec y)) =
        dotProduct x (D.J_V.mulVec y) := by
    intro g hg x y
    let U := (g.val).map ι
    calc dotProduct (U.mulVec x) (D.J_V.mulVec (U.mulVec y))
        = dotProduct (Matrix.vecMul x U.transpose) ((D.J_V * U).mulVec y) := by
            rw [← Matrix.mulVec_transpose, Matrix.transpose_transpose, Matrix.mulVec_mulVec]
      _ = dotProduct x (U.transpose.mulVec ((D.J_V * U).mulVec y)) := by
            rw [← Matrix.dotProduct_mulVec]
      _ = dotProduct x ((U.transpose * D.J_V * U).mulVec y) := by
            rw [Matrix.mulVec_mulVec, Matrix.mul_assoc]
      _ = dotProduct x (D.J_V.mulVec y) := by rw [D.hGV_sp g hg]

  have hRigidity_nz : ∀ (u : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ), u ∈ D.G_V →
      ∀ (w : Fin D.N → K) (φ : (Fin D.N → K) →ₗ[K] K),
        (∀ x : Fin D.N → K, ((u.val).map ι).mulVec x = x + (φ x) • w) →
        w ≠ 0 → φ ≠ 0 →
        ∃ c : K, c ≠ 0 ∧ ∀ x : Fin D.N → K, φ x = c * dotProduct x (D.J_V.mulVec w) := by
    intro u hu w φ hU_act hw hφ
    have hRel : ∀ x y : Fin D.N → K,
        φ y * dotProduct x (D.J_V.mulVec w) = φ x * dotProduct y (D.J_V.mulVec w) := by
      intro x y
      have h := hGV_pair u hu x y
      rw [hU_act x, hU_act y, Matrix.mulVec_add, Matrix.mulVec_smul] at h
      simp only [add_dotProduct, dotProduct_add, smul_dotProduct, dotProduct_smul,
        smul_eq_mul, hSelf_zero w, mul_zero, add_zero] at h
      rw [hSkew_pair w y] at h
      linear_combination h
    have hφ_ex : ∃ x₀ : Fin D.N → K, φ x₀ ≠ 0 := by
      by_contra h_all
      exact hφ (LinearMap.ext fun x => Classical.not_not.mp fun hx => h_all ⟨x, hx⟩)
    obtain ⟨x₀, hx₀⟩ := hφ_ex
    have hJw_ne : D.J_V.mulVec w ≠ 0 := by
      intro h0
      have hUnit : IsUnit D.J_V :=
        (Matrix.isUnit_iff_isUnit_det D.J_V).mpr (IsUnit.mk0 _ D.hJV_det)
      obtain ⟨uJ, huJ⟩ := hUnit
      have hw0 : w = 0 := by
        calc w = (1 : Matrix (Fin D.N) (Fin D.N) K).mulVec w := (Matrix.one_mulVec w).symm
          _ = (uJ⁻¹.val * uJ.val).mulVec w := by rw [Units.inv_mul]
          _ = uJ⁻¹.val.mulVec (D.J_V.mulVec w) := by rw [huJ, Matrix.mulVec_mulVec]
          _ = 0 := by rw [h0, Matrix.mulVec_zero]
      exact hw hw0
    obtain ⟨j, hj⟩ := Function.ne_iff.mp hJw_ne
    let y₀ : Fin D.N → K := Pi.single j 1
    have hy₀ : dotProduct y₀ (D.J_V.mulVec w) ≠ 0 := by simpa [y₀] using hj
    have hx₀_dot_ne : dotProduct x₀ (D.J_V.mulVec w) ≠ 0 := by
      intro h0
      have h := hRel x₀ y₀
      rw [h0, mul_zero] at h
      exact mul_ne_zero hx₀ hy₀ h.symm
    refine ⟨φ x₀ * (dotProduct x₀ (D.J_V.mulVec w))⁻¹,
      mul_ne_zero hx₀ (inv_ne_zero hx₀_dot_ne), fun y => ?_⟩
    have h := hRel x₀ y
    calc φ y = (φ y * dotProduct x₀ (D.J_V.mulVec w)) * (dotProduct x₀ (D.J_V.mulVec w))⁻¹ := by
          rw [mul_assoc, mul_inv_cancel₀ hx₀_dot_ne, mul_one]
      _ = (φ x₀ * dotProduct y (D.J_V.mulVec w)) * (dotProduct x₀ (D.J_V.mulVec w))⁻¹ := by
          rw [h]
      _ = (φ x₀ * (dotProduct x₀ (D.J_V.mulVec w))⁻¹) * dotProduct y (D.J_V.mulVec w) := by
          ring

  have hSubmodClosed : ∀ (E : Submodule K (Fin D.N → K))
      (g : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ) (x : Fin D.N → K),
      (∀ r : ℕ, ∃ h : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ,
        (h.val).map (PadicInt.toZModPow (r + 1)) = (g.val).map (PadicInt.toZModPow (r + 1)) ∧
        ((h.val).map ι).mulVec x - x ∈ E) →
      ((g.val).map ι).mulVec x - x ∈ E := by
    intro E g x hApprox
    set v : Fin D.N → K := ((g.val).map ι).mulVec x - x
    by_contra hv_notMem
    obtain ⟨ψ, hψ_ne, hψ_ker⟩ :=
      Submodule.exists_dual_map_eq_bot_of_notMem hv_notMem (Module.Projective.of_free)
    have hψ_zero : ∀ z ∈ E, ψ z = 0 := by
      intro z hz
      have hm : ψ z ∈ Submodule.map ψ E := ⟨z, hz, rfl⟩
      rwa [hψ_ker, Submodule.mem_bot] at hm
    have hι_norm : ∀ z : PadicInt ℓ, ‖ι z‖ ≤ 1 := fun z => z.2
    let C : ℝ := ∑ i : Fin D.N, ∑ j : Fin D.N, ‖x j * ψ (Pi.single i 1)‖
    have hBound : ∀ r : ℕ, ‖ψ v‖ ≤ ((ℓ : ℝ)⁻¹) ^ (r + 1) * C := by
      intro r
      obtain ⟨h_r, hh_mod, hh_mem⟩ := hApprox r
      set w_r : Fin D.N → K := ((h_r.val).map ι).mulVec x - x
      have hψ_diff : ψ v = ψ (v - w_r) := by
        conv_rhs => rw [map_sub, hψ_zero w_r hh_mem, sub_zero]
      have hpi_decomp : ∀ u : Fin D.N → K, u = ∑ i : Fin D.N, u i • Pi.single i (1 : K) := by
        intro u; ext k; simp [Pi.single_apply]
      have hvw_coord : ∀ i : Fin D.N,
          (v - w_r) i = ∑ j : Fin D.N, ι (g.val i j - h_r.val i j) * x j := by
        intro i
        simp only [v, w_r, Pi.sub_apply, sub_sub_sub_cancel_right, Matrix.mulVec, dotProduct,
          Matrix.map_apply, Finset.sum_sub_distrib, map_sub, sub_mul]
      have hψ_sum : ψ v =
          ∑ i : Fin D.N, ∑ j : Fin D.N, ι (g.val i j - h_r.val i j) * (x j * ψ (Pi.single i 1)) := by
        rw [hψ_diff, hpi_decomp (v - w_r), map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_smul, hvw_coord i, smul_eq_mul, Finset.sum_mul]
        refine Finset.sum_congr rfl fun j _ => mul_assoc _ _ _
      have hentry_bound : ∀ i j : Fin D.N,
          ‖ι (g.val i j - h_r.val i j)‖ ≤ ((ℓ : ℝ)⁻¹) ^ (r + 1) := by
        intro i j
        have hmod_eq : PadicInt.toZModPow (r + 1) (h_r.val i j) =
            PadicInt.toZModPow (r + 1) (g.val i j) := by
          have := congrArg (fun M => M i j) hh_mod
          simpa [Matrix.map_apply] using this
        have hker : g.val i j - h_r.val i j ∈ RingHom.ker (PadicInt.toZModPow (r + 1)) := by
          rw [RingHom.mem_ker, map_sub, hmod_eq, sub_self]
        rw [PadicInt.ker_toZModPow (r + 1), Ideal.mem_span_singleton] at hker
        obtain ⟨z_ij, hz_ij⟩ := hker
        have hmap : ι (g.val i j - h_r.val i j) = (ℓ : K) ^ (r + 1) * ι z_ij := by
          rw [hz_ij, map_mul, map_pow, map_natCast]
        rw [hmap, norm_mul, norm_pow, Padic.norm_p]
        calc ((ℓ : ℝ)⁻¹) ^ (r + 1) * ‖ι z_ij‖
            ≤ ((ℓ : ℝ)⁻¹) ^ (r + 1) * 1 :=
              mul_le_mul_of_nonneg_left (hι_norm z_ij) (by positivity)
          _ = ((ℓ : ℝ)⁻¹) ^ (r + 1) := mul_one _
      rw [hψ_sum]
      calc ‖∑ i : Fin D.N, ∑ j : Fin D.N, ι (g.val i j - h_r.val i j) * (x j * ψ (Pi.single i 1))‖
          ≤ ∑ i : Fin D.N, ‖∑ j : Fin D.N, ι (g.val i j - h_r.val i j) * (x j * ψ (Pi.single i 1))‖ :=
            norm_sum_le _ _
        _ ≤ ∑ i : Fin D.N, ∑ j : Fin D.N, ‖ι (g.val i j - h_r.val i j) * (x j * ψ (Pi.single i 1))‖ :=
            Finset.sum_le_sum fun i _ => norm_sum_le _ _
        _ = ∑ i : Fin D.N, ∑ j : Fin D.N, ‖ι (g.val i j - h_r.val i j)‖ * ‖x j * ψ (Pi.single i 1)‖ := by
            refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => norm_mul _ _
        _ ≤ ∑ i : Fin D.N, ∑ j : Fin D.N, ((ℓ : ℝ)⁻¹) ^ (r + 1) * ‖x j * ψ (Pi.single i 1)‖ :=
            Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ =>
              mul_le_mul_of_nonneg_right (hentry_bound i j) (norm_nonneg _)
        _ = ((ℓ : ℝ)⁻¹) ^ (r + 1) * C := by
            dsimp [C]; simp only [Finset.mul_sum]
    have hψ_pos : 0 < ‖ψ v‖ := norm_pos_iff.mpr hψ_ne
    have hℓ_gt1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).one_lt
    have hℓ_pos : (0 : ℝ) < (ℓ : ℝ) := by linarith
    obtain ⟨r, hr⟩ := pow_unbounded_of_one_lt (C / ‖ψ v‖) hℓ_gt1
    have hr1 : C / ‖ψ v‖ < (ℓ : ℝ) ^ (r + 1) :=
      hr.trans_le (pow_le_pow_right₀ hℓ_gt1.le (Nat.le_succ r))
    rw [div_lt_iff₀ hψ_pos] at hr1
    have hb := hBound r
    have hmul : ‖ψ v‖ * (ℓ : ℝ) ^ (r + 1) ≤ C := by
      calc ‖ψ v‖ * (ℓ : ℝ) ^ (r + 1)
          ≤ (((ℓ : ℝ)⁻¹) ^ (r + 1) * C) * (ℓ : ℝ) ^ (r + 1) :=
            mul_le_mul_of_nonneg_right hb (by positivity)
        _ = (((ℓ : ℝ)⁻¹ * (ℓ : ℝ)) ^ (r + 1)) * C := by ring
        _ = C := by rw [inv_mul_cancel₀ hℓ_pos.ne', one_pow, one_mul]
    linarith

  have hAbelianImageSES : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] {X Y : 𝒞} (f : Quiver.Hom X Y),
      (∃ h0₁ : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.kernel.ι f) (CategoryTheory.Limits.factorThruImage f) = 0,
        (CategoryTheory.ShortComplex.mk
          (CategoryTheory.Limits.kernel.ι f) (CategoryTheory.Limits.factorThruImage f) h0₁).ShortExact) ∧
      (∃ h0₂ : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.image.ι f) (CategoryTheory.Limits.cokernel.π f) = 0,
        (CategoryTheory.ShortComplex.mk
          (CategoryTheory.Limits.image.ι f) (CategoryTheory.Limits.cokernel.π f) h0₂).ShortExact) := by
    intro 𝒞 _ _ X Y f
    have h0₁ : CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Limits.kernel.ι f) (CategoryTheory.Limits.factorThruImage f) = 0 := by
      rw [← CategoryTheory.cancel_mono (CategoryTheory.Limits.image.ι f),
        CategoryTheory.Category.assoc, CategoryTheory.Limits.image.fac,
        CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
    have h0₂ : CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Limits.image.ι f) (CategoryTheory.Limits.cokernel.π f) = 0 := by
      rw [← CategoryTheory.cancel_epi (CategoryTheory.Limits.factorThruImage f),
        ← CategoryTheory.Category.assoc, CategoryTheory.Limits.image.fac,
        CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.comp_zero]
    refine ⟨⟨h0₁, ?_⟩, ⟨h0₂, ?_⟩⟩
    · let SC₁ := CategoryTheory.ShortComplex.mk
        (CategoryTheory.Limits.kernel.ι f) (CategoryTheory.Limits.factorThruImage f) h0₁
      let e := CategoryTheory.Abelian.coimageIsoImage' f
      have hfac : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.factorThruImage f) e.inv =
          CategoryTheory.Limits.cokernel.π (CategoryTheory.Limits.kernel.ι f) :=
        CategoryTheory.Abelian.factorThruImage_comp_coimageIsoImage'_inv f
      let cf₁ := CategoryTheory.Limits.CokernelCofork.ofπ
        (CategoryTheory.Limits.factorThruImage f) h0₁
      have hColim₁ : CategoryTheory.Limits.IsColimit cf₁ :=
        CategoryTheory.Limits.Cofork.IsColimit.mk cf₁
          (fun s => CategoryTheory.CategoryStruct.comp e.inv
            (CategoryTheory.Limits.cokernel.desc (CategoryTheory.Limits.kernel.ι f) s.π
              (s.condition.trans CategoryTheory.Limits.zero_comp)))
          (fun s => by
            change CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.factorThruImage f)
              (CategoryTheory.CategoryStruct.comp e.inv _) = s.π
            rw [← CategoryTheory.Category.assoc, hfac, CategoryTheory.Limits.cokernel.π_desc])
          (fun s m hm => by
            apply (CategoryTheory.cancel_epi (CategoryTheory.Limits.factorThruImage f)).mp
            refine hm.trans ?_; symm
            change CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.factorThruImage f)
              (CategoryTheory.CategoryStruct.comp e.inv _) = s.π
            rw [← CategoryTheory.Category.assoc, hfac, CategoryTheory.Limits.cokernel.π_desc])
      exact CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_g_is_cokernel SC₁ hColim₁)
        inferInstance inferInstance
    · let SC₂ := CategoryTheory.ShortComplex.mk
        (CategoryTheory.Limits.image.ι f) (CategoryTheory.Limits.cokernel.π f) h0₂
      let cf₂ := CategoryTheory.Limits.CokernelCofork.ofπ
        (CategoryTheory.Limits.cokernel.π f) h0₂
      have hColim₂ : CategoryTheory.Limits.IsColimit cf₂ :=
        CategoryTheory.Limits.Cofork.IsColimit.mk cf₂
          (fun s => CategoryTheory.Limits.cokernel.desc f s.π (by
            calc CategoryTheory.CategoryStruct.comp f s.π
                = CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.CategoryStruct.comp
                      (CategoryTheory.Limits.factorThruImage f)
                      (CategoryTheory.Limits.image.ι f)) s.π := by
                    rw [CategoryTheory.Limits.image.fac f]
              _ = CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.Limits.factorThruImage f)
                    (CategoryTheory.CategoryStruct.comp
                      (CategoryTheory.Limits.image.ι f) s.π) :=
                    CategoryTheory.Category.assoc _ _ _
              _ = 0 := by
                    rw [s.condition, CategoryTheory.Limits.zero_comp,
                      CategoryTheory.Limits.comp_zero]))
          (fun s => CategoryTheory.Limits.cokernel.π_desc f s.π _)
          (fun s m hm => by
            apply (CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π f)).mp
            exact hm.trans (CategoryTheory.Limits.cokernel.π_desc f s.π _).symm)
      exact CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_g_is_cokernel SC₂ hColim₂)
        inferInstance inferInstance

  have hSheafKerZeroBij : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (ℱ₁ ℱ₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (φ : Quiver.Hom ℱ₁ ℱ₂) (W : S.Etale),
      Function.Injective (φ.hom.app (Opposite.op W)) →
      Function.Bijective
        ((0 : Quiver.Hom (CategoryTheory.Limits.kernel φ)
          (CategoryTheory.Limits.kernel φ)).hom.app (Opposite.op W)) := by
    intro S ℱ₁ ℱ₂ φ W hInj
    let J := S.smallEtaleTopology
    let 𝒦 := CategoryTheory.Limits.kernel φ
    let ι_k : Quiver.Hom 𝒦 ℱ₁ := CategoryTheory.Limits.kernel.ι φ
    have _ : CategoryTheory.Mono ((CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map ι_k) :=
      CategoryTheory.Functor.map_mono (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}) ι_k
    have hMonoApp : CategoryTheory.Mono (ι_k.hom.app (Opposite.op W)) :=
      CategoryTheory.Functor.map_mono
        ((CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op W))
        ((CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map ι_k)
    have hι_inj : Function.Injective (ι_k.hom.app (Opposite.op W)) :=
      (AddCommGrpCat.mono_iff_injective (ι_k.hom.app (Opposite.op W))).mp hMonoApp
    have hSub : ∀ s : ↑(𝒦.obj.obj (Opposite.op W)), s = 0 := by
      intro s
      apply hι_inj; rw [map_zero]; apply hInj; rw [map_zero]
      have hcond : ((CategoryTheory.CategoryStruct.comp ι_k φ).hom.app (Opposite.op W)) s = 0 := by
        rw [CategoryTheory.Limits.kernel.condition]; rfl
      exact hcond
    refine ⟨fun s₁ s₂ _ => (hSub s₁).trans (hSub s₂).symm, fun s => ⟨0, ?_⟩⟩
    exact (map_zero _).trans (hSub s).symm

  have hDirectImageZeroProps : ∀ (U S : AlgebraicGeometry.Scheme.{u})
      (B : CategoryTheory.Functor S.Etale U.Etale)
      (hCont : B.IsContinuous S.smallEtaleTopology U.smallEtaleTopology)
      (R0 : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u} →
        CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (R0_map : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}},
        Quiver.Hom ℱ₁ ℱ₂ → Quiver.Hom (R0 ℱ₁) (R0 ℱ₂))
      (Θ : ∀ ℱ : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u},
        CategoryTheory.Iso
          ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B AddCommGrpCat.{u} _
            S.smallEtaleTopology U.smallEtaleTopology hCont).obj ℱ) (R0 ℱ)),
      (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : Quiver.Hom ℱ₁ ℱ₂),
        CategoryTheory.CategoryStruct.comp
          ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B AddCommGrpCat.{u} _
            S.smallEtaleTopology U.smallEtaleTopology hCont).map φ) (Θ ℱ₂).hom =
        CategoryTheory.CategoryStruct.comp (Θ ℱ₁).hom (R0_map φ)) →
      (∀ {ℱ₁ ℱ₂ ℱ₃ : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : Quiver.Hom ℱ₁ ℱ₂) (ψ : Quiver.Hom ℱ₂ ℱ₃),
        R0_map (CategoryTheory.CategoryStruct.comp φ ψ) =
          CategoryTheory.CategoryStruct.comp (R0_map φ) (R0_map ψ)) ∧
      (∀ (ℱ : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}) (M : ℕ),
        R0_map (M • CategoryTheory.CategoryStruct.id ℱ) =
          M • CategoryTheory.CategoryStruct.id (R0 ℱ)) := by
    intro U S B hCont R0 R0_map Θ hΘ
    let P_f := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B AddCommGrpCat.{u} _
      S.smallEtaleTopology U.smallEtaleTopology hCont
    have hR0_eq : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}}
        (φ : Quiver.Hom ℱ₁ ℱ₂),
        R0_map φ = CategoryTheory.CategoryStruct.comp (Θ ℱ₁).inv
          (CategoryTheory.CategoryStruct.comp (P_f.map φ) (Θ ℱ₂).hom) := by
      intro ℱ₁ ℱ₂ φ
      rw [hΘ φ, ← CategoryTheory.Category.assoc, (Θ ℱ₁).inv_hom_id, CategoryTheory.Category.id_comp]
    have hP_zero : ∀ (ℱ₁ ℱ₂ : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}),
        P_f.map (0 : Quiver.Hom ℱ₁ ℱ₂) = 0 := by
      intro ℱ₁ ℱ₂; apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext W; rfl
    have hP_add : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}}
        (a b : Quiver.Hom ℱ₁ ℱ₂), P_f.map (a + b) = P_f.map a + P_f.map b := by
      intro ℱ₁ ℱ₂ a b; apply CategoryTheory.Sheaf.hom_ext; apply CategoryTheory.NatTrans.ext; funext W; rfl
    have hP_nsmul : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}}
        (M : ℕ) (a : Quiver.Hom ℱ₁ ℱ₂), P_f.map (M • a) = M • P_f.map a := by
      intro ℱ₁ ℱ₂ M a
      induction M with
      | zero => rw [zero_smul, zero_smul, hP_zero]
      | succ M ih => rw [succ_nsmul, succ_nsmul, hP_add, ih]
    refine ⟨?_, ?_⟩
    · intro ℱ₁ ℱ₂ ℱ₃ φ ψ
      rw [hR0_eq (CategoryTheory.CategoryStruct.comp φ ψ), hR0_eq φ, hR0_eq ψ, P_f.map_comp]
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
    · intro ℱ M
      rw [hR0_eq, hP_nsmul, P_f.map_id, CategoryTheory.Preadditive.nsmul_comp,
        CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.id_comp, (Θ ℱ).inv_hom_id]

  have hHigherDirectImageTors : ∀ {X S : AlgebraicGeometry.Scheme.{u}}
      (f : Quiver.Hom X S) (m_tor q_deg : ℕ),
      m_tor • CategoryTheory.CategoryStruct.id
        (weilEtaleHigherDirectImage f q_deg (weilEtaleTorsionSheaf X m_tor)) = 0 := by
    intro X S f m_tor q_deg
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m_tor))
    have hAM : m_tor • CategoryTheory.CategoryStruct.id AM = 0 := by
      have h_app : ∀ (n : ℕ) (x : AM), ((n • CategoryTheory.CategoryStruct.id AM) x).down = n • x.down := by
        intro n x
        induction n with
        | zero => rw [zero_nsmul, zero_nsmul]; rfl
        | succ n ih =>
          rw [succ_nsmul, succ_nsmul]
          change ((n • CategoryTheory.CategoryStruct.id AM) x).down + x.down = n • x.down + x.down
          rw [ih]
      apply AddCommGrpCat.ext; intro x; apply ULift.ext
      rw [h_app, nsmul_eq_mul, ZMod.natCast_self, zero_mul]; rfl
    let C_X := CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}
    let T_X : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 X)
    have hT_X : CategoryTheory.Limits.IsTerminal T_X :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun E => CategoryTheory.MorphismProperty.Over.homMk E.hom (CategoryTheory.Category.comp_id E.hom) trivial)
        (fun E g => CategoryTheory.MorphismProperty.Comma.Hom.ext
          ((CategoryTheory.Category.comp_id g.left).symm.trans (CategoryTheory.MorphismProperty.Over.w g))
          (Subsingleton.elim _ _))
    let adj_C := CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u} hT_X
    let _ : CategoryTheory.Limits.PreservesFiniteColimits C_X :=
      (CategoryTheory.Adjunction.leftAdjoint_preservesColimits.{0, 0} adj_C).preservesFiniteColimits
    let _ : C_X.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products C_X
    have hFM : m_tor • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf X m_tor) = 0 := by
      change m_tor • CategoryTheory.CategoryStruct.id (C_X.obj AM) = 0
      rw [← C_X.map_id, ← C_X.map_nsmul, hAM, C_X.map_zero]
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_f : S.Etale ⥤ X.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let P_f : (Opposite X.Etale) ⥤ AddCommGrpCat.{u} :=
      CategoryTheory.Sheaf.cohomologyPresheaf (weilEtaleTorsionSheaf X m_tor) q_deg
    have hExt_nsmul : ∀ {A : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        (x : CategoryTheory.Abelian.Ext A (weilEtaleTorsionSheaf X m_tor) q_deg) (k : ℕ),
        (CategoryTheory.Abelian.Ext.mk₀
          (k • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf X m_tor))).postcomp A
          (Nat.add_zero q_deg) x = k • x := by
      intro A x k
      change x.comp (CategoryTheory.Abelian.Ext.mk₀ (k • CategoryTheory.CategoryStruct.id _))
        (Nat.add_zero q_deg) = k • x
      induction k with
      | zero =>
        rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero]
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
          CategoryTheory.Abelian.Ext.comp_add, ih, CategoryTheory.Abelian.Ext.comp_mk₀_id]
    have hBP : m_tor • CategoryTheory.CategoryStruct.id (B_f.op ⋙ P_f) = 0 := by
      apply CategoryTheory.NatTrans.ext; funext W
      have h_app : ∀ (n : ℕ) (x : (B_f.op ⋙ P_f).obj W),
          ((n • CategoryTheory.CategoryStruct.id (B_f.op ⋙ P_f)).app W) x = n • x := by
        intro n x
        induction n with
        | zero => rw [zero_nsmul, zero_nsmul]; rfl
        | succ n ih =>
          rw [succ_nsmul, succ_nsmul]
          change ((n • CategoryTheory.CategoryStruct.id (B_f.op ⋙ P_f)).app W) x + x = n • x + x
          rw [ih]
      apply AddCommGrpCat.ext; intro x
      rw [h_app m_tor x]
      let x' : CategoryTheory.Abelian.Ext _ (weilEtaleTorsionSheaf X m_tor) q_deg := x
      change m_tor • x' = 0
      rw [← hExt_nsmul x' m_tor, hFM]
      change x'.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : Quiver.Hom _ _))
        (Nat.add_zero q_deg) = 0
      rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
    let _ : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).Additive :=
      CategoryTheory.Functor.additive_of_preserves_binary_products _
    change m_tor • CategoryTheory.CategoryStruct.id
      ((CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj (B_f.op ⋙ P_f)) = 0
    rw [← (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map_id,
      ← (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map_nsmul, hBP,
      (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map_zero]

  have hPadicMatrixLift : ∀ (N_mat : ℕ)
      (A : ∀ r : ℕ, (Matrix (Fin N_mat) (Fin N_mat) (ZMod (ℓ ^ (r + 1))))ˣ),
      (∀ r : ℕ,
        (A (r + 1)).val.map
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) =
          (A r).val) →
      ∃ g : (Matrix (Fin N_mat) (Fin N_mat) (PadicInt ℓ))ˣ,
        ∀ r : ℕ, (g.val).map (PadicInt.toZModPow (r + 1)) = (A r).val := by
    intro N_mat A hCompat
    have hPrime : Nat.Prime ℓ := Fact.out
    have hInvCompat : ∀ r : ℕ,
        (A (r + 1))⁻¹.val.map
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) =
          (A r)⁻¹.val := by
      intro r
      let φ := ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
      have hmul : (A r).val * ((A (r + 1))⁻¹.val.map φ) = 1 := by
        rw [← hCompat r, ← Matrix.map_mul, Units.mul_inv]
        ext i j; simp only [Matrix.map_apply, Matrix.one_apply]
        split_ifs
        · exact φ.map_one
        · exact φ.map_zero
      have hleft : (A r)⁻¹.val * ((A r).val * ((A (r + 1))⁻¹.val.map φ)) = (A r)⁻¹.val * 1 :=
        congrArg ((A r)⁻¹.val * ·) hmul
      rwa [← Matrix.mul_assoc, Units.inv_mul, Matrix.one_mul, Matrix.mul_one] at hleft
    have hLiftEntry : ∀ (seq : ∀ r : ℕ, ZMod (ℓ ^ (r + 1))),
        (∀ r : ℕ, ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
          (seq (r + 1)) = seq r) →
        ∃ z : PadicInt ℓ, ∀ r : ℕ, PadicInt.toZModPow (r + 1) z = seq r := by
      intro seq hseq
      let seq0 : ∀ k : ℕ, ZMod (ℓ ^ k) := fun k =>
        match k with
        | 0 => 0
        | r + 1 => seq r
      let f_hom : ∀ k : ℕ, Polynomial ℤ →+* ZMod (ℓ ^ k) :=
        fun k => (Polynomial.aeval (seq0 k)).toRingHom
      have hf_step : ∀ k : ℕ,
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k))).comp (f_hom (k + 1)) =
            f_hom k := by
        intro k
        cases k with
        | zero =>
          have _ : Subsingleton (ZMod (ℓ ^ 0)) := by rw [pow_zero]; infer_instance
          apply RingHom.ext; intro n; exact Subsingleton.elim _ _
        | succ r =>
          apply Polynomial.ringHom_ext
          · intro c; simp [f_hom]
          · simp only [RingHom.comp_apply, f_hom, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
              Polynomial.aeval_X, seq0]
            exact hseq r
      have hf_compat : ∀ (k1 k2 : ℕ) (hk : k1 ≤ k2),
          (ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k1))).comp (f_hom k2) = f_hom k1 := by
        intro k1 k2 hk
        induction k2, hk using Nat.le_induction with
        | base => apply RingHom.ext; intro p; simp
        | succ k2 hk_le ih =>
          have hcast_comp : (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ_of_le hk_le)) (ZMod (ℓ ^ k1))) =
              (ZMod.castHom (pow_dvd_pow ℓ hk_le) (ZMod (ℓ ^ k1))).comp
                (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k2)) (ZMod (ℓ ^ k2))) := by
            apply RingHom.ext; intro x; simp
          rw [hcast_comp, RingHom.comp_assoc, hf_step k2, ih]
      let ψ : Polynomial ℤ →+* PadicInt ℓ := PadicInt.lift hf_compat
      refine ⟨ψ Polynomial.X, fun r => ?_⟩
      have hspec := PadicInt.lift_spec hf_compat (r + 1)
      have hX := RingHom.congr_fun hspec Polynomial.X
      simpa [ψ, f_hom, seq0] using hX
    have hPadicEq : ∀ x y : PadicInt ℓ,
        (∀ r : ℕ, PadicInt.toZModPow (r + 1) x = PadicInt.toZModPow (r + 1) y) → x = y := by
      intro x y hxy
      have hdiff : ∀ r : ℕ, x - y ∈ RingHom.ker (PadicInt.toZModPow (r + 1)) := by
        intro r; rw [RingHom.mem_ker, map_sub, hxy r, sub_self]
      have hzero : (x - y : PadicInt ℓ) = 0 := by
        by_contra hne
        have hne_K : ((x - y : PadicInt ℓ) : Padic ℓ) ≠ 0 := fun h0 => hne (Subtype.ext h0)
        have hnorm_pos : 0 < ‖((x - y : PadicInt ℓ) : Padic ℓ)‖ := norm_pos_iff.mpr hne_K
        have h_gt1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hPrime.one_lt
        obtain ⟨r, hr⟩ := pow_unbounded_of_one_lt (‖((x - y : PadicInt ℓ) : Padic ℓ)‖⁻¹) h_gt1
        have hmem := hdiff r
        rw [PadicInt.ker_toZModPow] at hmem
        obtain ⟨u, hu⟩ := Ideal.mem_span_singleton.mp hmem
        have hle : ‖((x - y : PadicInt ℓ) : Padic ℓ)‖ ≤ ((ℓ : ℝ) ^ (r + 1))⁻¹ := by
          have hval : ((x - y : PadicInt ℓ) : Padic ℓ) = (ℓ : Padic ℓ) ^ (r + 1) * (u : Padic ℓ) := by
            simpa using congrArg (Subtype.val : PadicInt ℓ → Padic ℓ) hu
          rw [hval, norm_mul, Padic.norm_p_pow, zpow_neg, zpow_natCast]
          exact mul_le_of_le_one_right (inv_nonneg.mpr (pow_nonneg (by positivity) _)) u.2
        have hlt : ((ℓ : ℝ) ^ (r + 1))⁻¹ < ‖((x - y : PadicInt ℓ) : Padic ℓ)‖ := by
          have hpos_pow : (0 : ℝ) < (ℓ : ℝ) ^ (r + 1) := pow_pos (by positivity) _
          rw [inv_lt_comm₀ hpos_pow hnorm_pos]
          exact lt_trans hr (pow_lt_pow_right₀ h_gt1 (Nat.lt_succ_self r))
        exact not_lt_of_ge hle hlt
      exact sub_eq_zero.mp hzero
    have hA_ij : ∀ (i j : Fin N_mat) (r : ℕ),
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
          ((A (r + 1)).val i j) = (A r).val i j := fun i j r => by
      have := congrFun (congrFun (hCompat r) i) j
      simpa [Matrix.map_apply] using this
    have hAinv_ij : ∀ (i j : Fin N_mat) (r : ℕ),
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
          ((A (r + 1))⁻¹.val i j) = (A r)⁻¹.val i j := fun i j r => by
      have := congrFun (congrFun (hInvCompat r) i) j
      simpa [Matrix.map_apply] using this
    let M : Matrix (Fin N_mat) (Fin N_mat) (PadicInt ℓ) := fun i j =>
      Classical.choose (hLiftEntry (fun r => (A r).val i j) (hA_ij i j))
    let M_inv : Matrix (Fin N_mat) (Fin N_mat) (PadicInt ℓ) := fun i j =>
      Classical.choose (hLiftEntry (fun r => (A r)⁻¹.val i j) (hAinv_ij i j))
    have hM : ∀ r : ℕ, M.map (PadicInt.toZModPow (r + 1)) = (A r).val := by
      intro r; ext i j
      exact Classical.choose_spec (hLiftEntry (fun r => (A r).val i j) (hA_ij i j)) r
    have hM_inv : ∀ r : ℕ, M_inv.map (PadicInt.toZModPow (r + 1)) = (A r)⁻¹.val := by
      intro r; ext i j
      exact Classical.choose_spec (hLiftEntry (fun r => (A r)⁻¹.val i j) (hAinv_ij i j)) r
    have hMM_inv : M * M_inv = 1 := by
      ext i j; apply hPadicEq; intro r
      have h1 : (M * M_inv).map (PadicInt.toZModPow (r + 1)) =
          (1 : Matrix (Fin N_mat) (Fin N_mat) (PadicInt ℓ)).map (PadicInt.toZModPow (r + 1)) := by
        rw [Matrix.map_mul, hM r, hM_inv r, Units.mul_inv]
        ext a b; simp only [Matrix.map_apply, Matrix.one_apply]; split_ifs <;> simp
      exact congrFun (congrFun h1 i) j
    have hM_invM : M_inv * M = 1 := by
      ext i j; apply hPadicEq; intro r
      have h1 : (M_inv * M).map (PadicInt.toZModPow (r + 1)) =
          (1 : Matrix (Fin N_mat) (Fin N_mat) (PadicInt ℓ)).map (PadicInt.toZModPow (r + 1)) := by
        rw [Matrix.map_mul, hM_inv r, hM r, Units.inv_mul]
        ext a b; simp only [Matrix.map_apply, Matrix.one_apply]; split_ifs <;> simp
      exact congrFun (congrFun h1 i) j
    exact ⟨⟨M, M_inv, hMM_inv, hM_invM⟩, hM⟩

  have hZModUnipPow : ∀ (r N_mat : ℕ)
      (A : (Matrix (Fin N_mat) (Fin N_mat) (ZMod (ℓ ^ (r + 1))))ˣ),
      (A.val - 1) ^ 2 = 0 → A ^ (ℓ ^ (r + 1)) = 1 := by
    intro r N_mat A hUnip
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, Units.val_one]
    set M := A.val - 1
    have hA : A.val = 1 + M := by simp [M]
    have hPow : ∀ n : ℕ, (1 + M) ^ n = 1 + (n : ZMod (ℓ ^ (r + 1))) • M := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [pow_succ (1 + M) n, ih, add_mul, one_mul, mul_add, mul_one, smul_mul_assoc,
          ← sq, hUnip, smul_zero, add_zero, Nat.cast_succ, add_smul, one_smul,
          add_assoc, add_comm M ((n : ZMod (ℓ ^ (r + 1))) • M)]
    rw [hA, hPow (ℓ ^ (r + 1)), ZMod.natCast_self, zero_smul, add_zero]

  have hPadicQuotModel : ∀ (H₁ H₂ : ℕ → Type u) [∀ r, AddCommGroup (H₁ r)] [∀ r, AddCommGroup (H₂ r)]
      (τ₁ : ∀ r : ℕ, H₁ (r + 1) →+ H₁ r)
      (τ₂ : ∀ r : ℕ, H₂ (r + 1) →+ H₂ r)
      (f₁ : ∀ r : ℕ, H₁ r →+ H₁ r)
      (f₂ : ∀ r : ℕ, H₂ r →+ H₂ r)
      (q : ∀ r : ℕ, H₁ r →+ H₂ r)
      (sys₁ : AddSubgroup (∀ r : ℕ, H₁ r))
      (sys₂ : AddSubgroup (∀ r : ℕ, H₂ r))
      (V₁ : Type u) [AddCommGroup V₁] [Module (Padic ℓ) V₁] [Module.Finite (Padic ℓ) V₁]
      (frob₁ : V₁ →ₗ[Padic ℓ] V₁)
      (equiv₁ : TensorProduct ℤ ℚ ↥sys₁ ≃+ V₁),
      (∀ (r : ℕ) (w : H₁ r), (ℓ ^ (r + 1)) • w = 0) →
      (∀ (r : ℕ) (w : H₂ r), (ℓ ^ (r + 1)) • w = 0) →
      (∀ r : ℕ, Finite (H₁ r)) →
      (∀ r : ℕ, Function.Surjective (q r)) →
      (∀ (r : ℕ) (x : H₁ (r + 1)), q r (τ₁ r x) = τ₂ r (q (r + 1) x)) →
      (∀ (r : ℕ) (x : H₁ r), q r (f₁ r x) = f₂ r (q r x)) →
      (∀ (r : ℕ) (x : H₁ (r + 1)), τ₁ r (f₁ (r + 1) x) = f₁ r (τ₁ r x)) →
      (∀ (r : ℕ) (y : H₂ (r + 1)), τ₂ r (f₂ (r + 1) y) = f₂ r (τ₂ r y)) →
      (∀ x : (∀ r : ℕ, H₁ r), x ∈ sys₁ ↔ ∀ r : ℕ, τ₁ r (x (r + 1)) = x r) →
      (∀ y : (∀ r : ℕ, H₂ r), y ∈ sys₂ ↔ ∀ r : ℕ, τ₂ r (y (r + 1)) = y r) →
      (∀ (z : PadicInt ℓ) (x y : ↥sys₁),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r) →
          equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) y) =
            (z : Padic ℓ) • equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x)) →
      (∀ (x y : ↥sys₁),
        (∀ r : ℕ, y.1 r = f₁ r (x.1 r)) →
          frob₁ (equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x)) =
            equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) y)) →
      ∃ (V₂ : Type u) (_ : AddCommGroup V₂) (_ : Module (Padic ℓ) V₂)
        (_ : Module.Finite (Padic ℓ) V₂)
        (frob₂ : V₂ →ₗ[Padic ℓ] V₂)
        (equiv₂ : TensorProduct ℤ ℚ ↥sys₂ ≃+ V₂),
        (∀ (z : PadicInt ℓ) (x y : ↥sys₂),
          (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r) →
            equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) y) =
              (z : Padic ℓ) • equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) x)) ∧
        (∀ (x y : ↥sys₂),
          (∀ r : ℕ, y.1 r = f₂ r (x.1 r)) →
            frob₂ (equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) x)) =
              equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) y)) := by
    intro H₁ H₂ _ _ τ₁ τ₂ f₁ f₂ q sys₁ sys₂ V₁ _ _ _ frob₁ equiv₁
      hTors₁ hTors₂ hFin₁ hq_surj hq_τ hq_f hf₁_τ hf₂_τ hsys₁ hsys₂ hsmul₁ hfrob₁
    have hPrime : Nat.Prime ℓ := Fact.out
    let q_sys : ↥sys₁ →+ ↥sys₂ :=
      { toFun := fun x => ⟨fun r => q r (x.1 r), (hsys₂ _).mpr fun r => by
          rw [← hq_τ r (x.1 (r + 1)), (hsys₁ x.1).mp x.2 r]⟩
        map_zero' := Subtype.ext (funext fun r => map_zero (q r))
        map_add' := fun x y => Subtype.ext (funext fun r => map_add (q r) (x.1 r) (y.1 r)) }
    have hq_sys_surj : Function.Surjective q_sys := by
      intro y
      let K_fib : ℕ → Type u := fun r => { x_r : H₁ r // q r x_r = y.1 r }
      let step : ∀ r : ℕ, K_fib (r + 1) → K_fib r := fun r x_succ =>
        ⟨τ₁ r x_succ.1, by rw [hq_τ r x_succ.1, x_succ.2, (hsys₂ y.1).mp y.2 r]⟩
      let iter : ∀ (b a : ℕ), a ≤ b → K_fib b → K_fib a :=
        Nat.rec
          (fun a h x => Eq.mp (congrArg K_fib (Nat.eq_zero_of_le_zero h).symm) x)
          (fun b' rec_b' a h x =>
            if h' : a ≤ b' then rec_b' a h' (step b' x)
            else Eq.mp (congrArg K_fib (by omega : b' + 1 = a)) x)
      have h_iter_id : ∀ (a : ℕ) (ha : a ≤ a) (x : K_fib a), iter a a ha x = x := by
        intro a ha x
        cases a with
        | zero => rfl
        | succ a' =>
          change (if h' : a' + 1 ≤ a' then iter a' (a' + 1) h' (step a' x) else x) = x
          have hnot : ¬ (a' + 1 ≤ a') := Nat.not_succ_le_self a'
          simp only [hnot, ↓reduceDIte]
      have h_iter_comp : ∀ (c a b : ℕ) (hab : a ≤ b) (hbc : b ≤ c) (x : K_fib c),
          iter c a (le_trans hab hbc) x = iter b a hab (iter c b hbc x) := by
        intro c
        induction c with
        | zero =>
          intro a b hab hbc x
          have hb : b = 0 := Nat.eq_zero_of_le_zero hbc; subst hb
          have ha : a = 0 := Nat.eq_zero_of_le_zero hab; subst ha; rfl
        | succ c' ih =>
          intro a b hab hbc x
          by_cases hbc' : b ≤ c'
          · have hac' : a ≤ c' := le_trans hab hbc'
            change (if h' : a ≤ c' then iter c' a h' (step c' x) else _) =
              iter b a hab (if h' : b ≤ c' then iter c' b h' (step c' x) else _)
            simp only [hac', hbc', ↓reduceDIte]
            exact ih a b hab hbc' (step c' x)
          · have hb_eq : b = c' + 1 := by omega
            subst hb_eq; rw [h_iter_id (c' + 1) hbc x]
      let F_inv : CategoryTheory.Functor ℕᵒᵖ (Type u) :=
        { obj := fun n => K_fib (Opposite.unop n)
          map := fun {n₁ n₂} f => TypeCat.ofHom
            (iter (Opposite.unop n₁) (Opposite.unop n₂) (CategoryTheory.leOfHom f.unop))
          map_id := fun n =>
            congrArg TypeCat.ofHom (funext fun x => h_iter_id (Opposite.unop n) _ x)
          map_comp := fun {n₁ n₂ n₃} f g =>
            congrArg TypeCat.ofHom (funext fun x =>
              h_iter_comp (Opposite.unop n₁) (Opposite.unop n₃) (Opposite.unop n₂)
                (CategoryTheory.leOfHom g.unop) (CategoryTheory.leOfHom f.unop) x) }
      have _ : ∀ j : ℕᵒᵖ, Finite (F_inv.obj j) := fun j => by
        have _ := hFin₁ (Opposite.unop j); exact Subtype.finite
      have _ : ∀ j : ℕᵒᵖ, Nonempty (F_inv.obj j) := fun j => by
        obtain ⟨x_j, hx_j⟩ := hq_surj (Opposite.unop j) (y.1 (Opposite.unop j))
        exact ⟨⟨x_j, hx_j⟩⟩
      obtain ⟨sec, hsec⟩ := nonempty_sections_of_finite_inverse_system F_inv
      refine ⟨⟨fun r => (sec (Opposite.op r)).1, (hsys₁ _).mpr fun r => ?_⟩, ?_⟩
      · have hstep := hsec (CategoryTheory.homOfLE (Nat.le_succ r)).op
        have h1 : (F_inv.map (CategoryTheory.homOfLE (Nat.le_succ r)).op)
            (sec (Opposite.op (r + 1))) = step r (sec (Opposite.op (r + 1))) := by
          change (if h' : r ≤ r then iter r r h' (step r (sec (Opposite.op (r + 1)))) else _) = _
          have hrr : r ≤ r := le_refl r
          simp only [hrr, ↓reduceDIte]
          exact h_iter_id r hrr _
        rw [h1] at hstep; exact congrArg Subtype.val hstep
      · apply Subtype.ext; ext r; exact (sec (Opposite.op r)).2
    have hRatSmul : ∀ {S W : Type u} [AddCommGroup S] [AddCommGroup W] [Module (Padic ℓ) W]
        (E : TensorProduct ℤ ℚ S ≃+ W) (a : ℚ) (s : S),
        E (TensorProduct.tmul ℤ a s) = (a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s) := by
      intro S W _ _ _ E a s
      let m_num : ℤ := a.num; let d_den : ℕ := a.den
      have hd_pos : 0 < d_den := a.pos
      have hd_ne_K : (d_den : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hd_pos.ne'
      have hda : (d_den : ℚ) * a = (m_num : ℚ) := by
        dsimp [d_den, m_num]; rw [mul_comm]; exact Rat.mul_den_eq_num a
      have h_tens : d_den • (TensorProduct.tmul ℤ a s) =
          m_num • (TensorProduct.tmul ℤ (1 : ℚ) s) := by
        calc d_den • (TensorProduct.tmul ℤ a s)
            = (d_den : ℤ) • (TensorProduct.tmul ℤ a s) := (natCast_zsmul _ _).symm
          _ = TensorProduct.tmul ℤ ((d_den : ℤ) • a) s :=
                (TensorProduct.smul_tmul' (d_den : ℤ) a s).symm
          _ = TensorProduct.tmul ℤ ((d_den : ℚ) * a) s := by rw [zsmul_eq_mul, Int.cast_natCast]
          _ = TensorProduct.tmul ℤ (m_num • (1 : ℚ)) s := by rw [hda, zsmul_eq_mul, mul_one]
          _ = m_num • TensorProduct.tmul ℤ (1 : ℚ) s :=
                TensorProduct.smul_tmul' m_num (1 : ℚ) s
      have hE_eq : d_den • E (TensorProduct.tmul ℤ a s) =
          m_num • E (TensorProduct.tmul ℤ (1 : ℚ) s) := by
        rw [← map_nsmul, ← map_zsmul, h_tens]
      have hK_lhs : d_den • E (TensorProduct.tmul ℤ a s) =
          (d_den : Padic ℓ) • E (TensorProduct.tmul ℤ a s) :=
        (Nat.cast_smul_eq_nsmul (Padic ℓ) d_den _).symm
      have hK_rhs : m_num • E (TensorProduct.tmul ℤ (1 : ℚ) s) =
          (d_den : Padic ℓ) • ((a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s)) := by
        rw [← Int.cast_smul_eq_zsmul (Padic ℓ) m_num, ← mul_smul]
        congr 1
        have hda_K := congrArg (Rat.cast : ℚ → Padic ℓ) hda
        push_cast at hda_K; exact hda_K.symm
      rw [hK_lhs, hK_rhs] at hE_eq
      calc E (TensorProduct.tmul ℤ a s)
          = ((d_den : Padic ℓ)⁻¹ * (d_den : Padic ℓ)) • E (TensorProduct.tmul ℤ a s) := by
              rw [inv_mul_cancel₀ hd_ne_K, one_smul]
        _ = (d_den : Padic ℓ)⁻¹ • ((d_den : Padic ℓ) • E (TensorProduct.tmul ℤ a s)) :=
              mul_smul _ _ _
        _ = (d_den : Padic ℓ)⁻¹ •
              ((d_den : Padic ℓ) • ((a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s))) := by
              rw [hE_eq]
        _ = ((d_den : Padic ℓ)⁻¹ * (d_den : Padic ℓ)) •
              ((a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s)) :=
              (mul_smul _ _ _).symm
        _ = (a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s) := by
              rw [inv_mul_cancel₀ hd_ne_K, one_smul]
    have hMod_nsmul : ∀ {A : Type u} [AddCommGroup A] {N : ℕ} (w : A),
        N • w = 0 → ∀ k : ℕ, (k % N) • w = k • w := by
      intro A _ N w hNw k
      conv_rhs => rw [← Nat.div_add_mod k N]
      rw [add_nsmul, mul_comm N (k / N), mul_nsmul', hNw, smul_zero, zero_add]
    have hz_mem₁ : ∀ (z : PadicInt ℓ) (x : ↥sys₁),
        (fun r => (PadicInt.toZModPow (r + 1) z).val • x.1 r) ∈ sys₁ := by
      intro z x; rw [hsys₁]; intro r
      rw [map_nsmul, (hsys₁ x.1).mp x.2 r]
      have hcast : PadicInt.toZModPow (r + 1) z =
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
            (PadicInt.toZModPow (r + 2) z) :=
        (RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow (r + 1) (r + 2)
          (Nat.le_succ (r + 1))) z).symm
      have hcast_val : (PadicInt.toZModPow (r + 1) z).val =
          (PadicInt.toZModPow (r + 2) z).val % (ℓ ^ (r + 1)) := by
        rw [hcast, ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.val_natCast]
      rw [hcast_val, hMod_nsmul (x.1 r) (hTors₁ r (x.1 r))]
    have hz_mem₂ : ∀ (z : PadicInt ℓ) (y : ↥sys₂),
        (fun r => (PadicInt.toZModPow (r + 1) z).val • y.1 r) ∈ sys₂ := by
      intro z y; rw [hsys₂]; intro r
      rw [map_nsmul, (hsys₂ y.1).mp y.2 r]
      have hcast : PadicInt.toZModPow (r + 1) z =
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
            (PadicInt.toZModPow (r + 2) z) :=
        (RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow (r + 1) (r + 2)
          (Nat.le_succ (r + 1))) z).symm
      have hcast_val : (PadicInt.toZModPow (r + 1) z).val =
          (PadicInt.toZModPow (r + 2) z).val % (ℓ ^ (r + 1)) := by
        rw [hcast, ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.val_natCast]
      rw [hcast_val, hMod_nsmul (y.1 r) (hTors₂ r (y.1 r))]
    let S_z : PadicInt ℓ → (↥sys₁ →+ ↥sys₁) := fun z =>
      { toFun := fun x => ⟨fun r => (PadicInt.toZModPow (r + 1) z).val • x.1 r, hz_mem₁ z x⟩
        map_zero' := Subtype.ext (funext fun _ => smul_zero _)
        map_add' := fun x y => Subtype.ext (funext fun r => smul_add _ (x.1 r) (y.1 r)) }
    let T_z : PadicInt ℓ → (↥sys₂ →+ ↥sys₂) := fun z =>
      { toFun := fun y => ⟨fun r => (PadicInt.toZModPow (r + 1) z).val • y.1 r, hz_mem₂ z y⟩
        map_zero' := Subtype.ext (funext fun _ => smul_zero _)
        map_add' := fun x y => Subtype.ext (funext fun r => smul_add _ (x.1 r) (y.1 r)) }
    let F_act : ↥sys₁ →+ ↥sys₁ :=
      { toFun := fun x => ⟨fun r => f₁ r (x.1 r), (hsys₁ _).mpr fun r => by
          rw [hf₁_τ r (x.1 (r + 1)), (hsys₁ x.1).mp x.2 r]⟩
        map_zero' := Subtype.ext (funext fun r => map_zero (f₁ r))
        map_add' := fun x y => Subtype.ext (funext fun r => map_add (f₁ r) (x.1 r) (y.1 r)) }
    let G_act : ↥sys₂ →+ ↥sys₂ :=
      { toFun := fun y => ⟨fun r => f₂ r (y.1 r), (hsys₂ _).mpr fun r => by
          rw [hf₂_τ r (y.1 (r + 1)), (hsys₂ y.1).mp y.2 r]⟩
        map_zero' := Subtype.ext (funext fun r => map_zero (f₂ r))
        map_add' := fun x y => Subtype.ext (funext fun r => map_add (f₂ r) (x.1 r) (y.1 r)) }
    let Q_rat : TensorProduct ℤ ℚ ↥sys₁ →ₗ[ℚ] TensorProduct ℤ ℚ ↥sys₂ :=
      LinearMap.baseChange ℚ q_sys.toIntLinearMap
    have hQ_surj : Function.Surjective Q_rat :=
      LinearMap.lTensor_surjective ℚ hq_sys_surj
    have hEquiv_Sz : ∀ (z : PadicInt ℓ) (w : TensorProduct ℤ ℚ ↥sys₁),
        equiv₁ (LinearMap.lTensor ℚ (S_z z).toIntLinearMap w) = (z : Padic ℓ) • equiv₁ w := by
      intro z w
      refine @TensorProduct.inductionOn ℤ _ ℚ ↥sys₁ _ _ _ _
        (fun u => equiv₁ (LinearMap.lTensor ℚ (S_z z).toIntLinearMap u) = (z : Padic ℓ) • equiv₁ u)
        w ?_ ?_
      · intro a x
        rw [LinearMap.lTensor_tmul, AddMonoidHom.coe_toIntLinearMap,
          hRatSmul equiv₁ a (S_z z x), hsmul₁ z x (S_z z x) (fun _ => rfl),
          hRatSmul equiv₁ a x, ← mul_smul, ← mul_smul, mul_comm]
      · intro u₁ u₂ ih₁ ih₂; rw [map_add, map_add, ih₁, ih₂, map_add, smul_add]
    have hEquiv_qsmul : ∀ (q₀ : ℚ) (w : TensorProduct ℤ ℚ ↥sys₁),
        equiv₁ (q₀ • w) = (q₀ : Padic ℓ) • equiv₁ w := by
      intro q₀ w
      refine @TensorProduct.inductionOn ℤ _ ℚ ↥sys₁ _ _ _ _
        (fun u => equiv₁ (q₀ • u) = (q₀ : Padic ℓ) • equiv₁ u) w ?_ ?_
      · intro a x
        rw [TensorProduct.smul_tmul', smul_eq_mul, hRatSmul equiv₁ (q₀ * a) x,
          hRatSmul equiv₁ a x, ← mul_smul]
        push_cast; rfl
      · intro u₁ u₂ ih₁ ih₂; rw [smul_add, map_add, ih₁, ih₂, map_add, smul_add]
    have hQ_qsmul : ∀ (q₀ : ℚ) (w : TensorProduct ℤ ℚ ↥sys₁),
        Q_rat (q₀ • w) = q₀ • Q_rat w := fun q₀ w => Q_rat.map_smul q₀ w
    have hEquiv_Fact : ∀ (w : TensorProduct ℤ ℚ ↥sys₁),
        equiv₁ (LinearMap.lTensor ℚ F_act.toIntLinearMap w) = frob₁ (equiv₁ w) := by
      intro w
      refine @TensorProduct.inductionOn ℤ _ ℚ ↥sys₁ _ _ _ _
        (fun u => equiv₁ (LinearMap.lTensor ℚ F_act.toIntLinearMap u) = frob₁ (equiv₁ u)) w ?_ ?_
      · intro a x
        rw [LinearMap.lTensor_tmul, AddMonoidHom.coe_toIntLinearMap,
          hRatSmul equiv₁ a (F_act x), hRatSmul equiv₁ a x, map_smul,
          hfrob₁ x (F_act x) (fun _ => rfl)]
      · intro u₁ u₂ ih₁ ih₂; rw [map_add, map_add, ih₁, ih₂, map_add, map_add]
    have hQ_Sz : ∀ (z : PadicInt ℓ) (w : TensorProduct ℤ ℚ ↥sys₁),
        Q_rat (LinearMap.lTensor ℚ (S_z z).toIntLinearMap w) =
          LinearMap.lTensor ℚ (T_z z).toIntLinearMap (Q_rat w) := by
      intro z w
      refine @TensorProduct.inductionOn ℤ _ ℚ ↥sys₁ _ _ _ _
        (fun u => Q_rat (LinearMap.lTensor ℚ (S_z z).toIntLinearMap u) =
          LinearMap.lTensor ℚ (T_z z).toIntLinearMap (Q_rat u)) w ?_ ?_
      · intro a x
        simp only [Q_rat, LinearMap.baseChange_tmul, LinearMap.lTensor_tmul,
          AddMonoidHom.coe_toIntLinearMap]
        refine congrArg (TensorProduct.tmul ℤ a) ?_
        apply Subtype.ext; ext r; exact map_nsmul (q r) _ (x.1 r)
      · intro u₁ u₂ ih₁ ih₂; rw [map_add, map_add, ih₁, ih₂, map_add, map_add]
    have hQ_Fact : ∀ (w : TensorProduct ℤ ℚ ↥sys₁),
        Q_rat (LinearMap.lTensor ℚ F_act.toIntLinearMap w) =
          LinearMap.lTensor ℚ G_act.toIntLinearMap (Q_rat w) := by
      intro w
      refine @TensorProduct.inductionOn ℤ _ ℚ ↥sys₁ _ _ _ _
        (fun u => Q_rat (LinearMap.lTensor ℚ F_act.toIntLinearMap u) =
          LinearMap.lTensor ℚ G_act.toIntLinearMap (Q_rat u)) w ?_ ?_
      · intro a x
        simp only [Q_rat, LinearMap.baseChange_tmul, LinearMap.lTensor_tmul,
          AddMonoidHom.coe_toIntLinearMap]
        refine congrArg (TensorProduct.tmul ℤ a) ?_
        apply Subtype.ext; ext r; exact hq_f r (x.1 r)
      · intro u₁ u₂ ih₁ ih₂; rw [map_add, map_add, ih₁, ih₂, map_add, map_add]
    let φ_ker : V₁ →+ TensorProduct ℤ ℚ ↥sys₂ :=
      Q_rat.toAddMonoidHom.comp equiv₁.symm.toAddMonoidHom
    let W_ker : Submodule (Padic ℓ) V₁ :=
      { carrier := { v : V₁ | φ_ker v = 0 }
        zero_mem' := map_zero φ_ker
        add_mem' := fun {v₁ v₂} hv₁ hv₂ => by
          change φ_ker (v₁ + v₂) = 0; rw [map_add, hv₁, hv₂, add_zero]
        smul_mem' := fun c v hv => by
          change Q_rat (equiv₁.symm (c • v)) = 0
          have hQw : Q_rat (equiv₁.symm v) = 0 := hv
          have h_gt1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hPrime.one_lt
          obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ‖c‖ h_gt1
          have hnorm_le : ‖(ℓ : Padic ℓ) ^ k * c‖ ≤ 1 := by
            rw [norm_mul, Padic.norm_p_pow, zpow_neg, zpow_natCast]
            have hpos : (0 : ℝ) < (ℓ : ℝ) ^ k := pow_pos (by positivity) k
            rw [inv_mul_le_iff₀ hpos, mul_one]; exact le_of_lt hk
          let z : PadicInt ℓ := ⟨(ℓ : Padic ℓ) ^ k * c, hnorm_le⟩
          have hz_coe : (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * c := rfl
          have hℓk_ne : ((ℓ : Padic ℓ) ^ k) ≠ 0 :=
            pow_ne_zero k (Nat.cast_ne_zero.mpr hPrime.ne_zero)
          let q₀ : ℚ := ((ℓ : ℚ) ^ k)⁻¹
          have hc_eq : c = (q₀ : Padic ℓ) * (z : Padic ℓ) := by
            dsimp [q₀]; push_cast; rw [hz_coe, ← mul_assoc, inv_mul_cancel₀ hℓk_ne, one_mul]
          let w := equiv₁.symm v
          have hv_eq : v = equiv₁ w := (equiv₁.apply_symm_apply v).symm
          have hcw : c • v = equiv₁ (q₀ • LinearMap.lTensor ℚ (S_z z).toIntLinearMap w) := by
            rw [hv_eq, hEquiv_qsmul, hEquiv_Sz, ← mul_smul, ← hc_eq]
          rw [hcw, AddEquiv.symm_apply_apply, hQ_qsmul, hQ_Sz z w, hQw, map_zero, smul_zero] }
    have hW_frob : ∀ v ∈ W_ker, frob₁ v ∈ W_ker := by
      intro v hv
      change Q_rat (equiv₁.symm (frob₁ v)) = 0
      have hQw : Q_rat (equiv₁.symm v) = 0 := hv
      let w := equiv₁.symm v
      have hfw : frob₁ v = equiv₁ (LinearMap.lTensor ℚ F_act.toIntLinearMap w) := by
        rw [hEquiv_Fact w, equiv₁.apply_symm_apply]
      rw [hfw, AddEquiv.symm_apply_apply, hQ_Fact w, hQw, map_zero]
    let V₂ := V₁ ⧸ W_ker
    let frob₂ : V₂ →ₗ[Padic ℓ] V₂ :=
      Submodule.mapQ W_ker W_ker frob₁ (fun v hv => hW_frob v hv)
    let π_quot : TensorProduct ℤ ℚ ↥sys₁ →+ V₂ :=
      (Submodule.mkQ W_ker).toAddMonoidHom.comp equiv₁.toAddMonoidHom
    have hπ_quot_surj : Function.Surjective π_quot :=
      (Submodule.mkQ_surjective W_ker).comp equiv₁.surjective
    have hker_eq : Q_rat.toAddMonoidHom.ker = π_quot.ker := by
      ext w
      rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_ker]
      change Q_rat w = 0 ↔ Submodule.mkQ W_ker (equiv₁ w) = 0
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      change Q_rat w = 0 ↔ Q_rat (equiv₁.symm (equiv₁ w)) = 0
      rw [AddEquiv.symm_apply_apply]
    let e_Q := QuotientAddGroup.quotientKerEquivOfSurjective Q_rat.toAddMonoidHom hQ_surj
    let e_π := QuotientAddGroup.quotientKerEquivOfSurjective π_quot hπ_quot_surj
    let e_mid : (TensorProduct ℤ ℚ ↥sys₁ ⧸ Q_rat.toAddMonoidHom.ker) ≃+
        (TensorProduct ℤ ℚ ↥sys₁ ⧸ π_quot.ker) :=
      QuotientAddGroup.quotientAddEquivOfEq hker_eq
    let equiv₂ : TensorProduct ℤ ℚ ↥sys₂ ≃+ V₂ :=
      e_Q.symm.trans (e_mid.trans e_π)
    have hequiv₂_Q : ∀ w : TensorProduct ℤ ℚ ↥sys₁,
        equiv₂ (Q_rat w) = Submodule.mkQ W_ker (equiv₁ w) := by
      intro w
      change e_π (e_mid (e_Q.symm (e_Q (QuotientAddGroup.mk w)))) = π_quot w
      rw [AddEquiv.symm_apply_apply]; rfl
    refine ⟨V₂, inferInstance, inferInstance, inferInstance, frob₂, equiv₂, ?_, ?_⟩
    · intro z x' y' hxy'
      obtain ⟨x, rfl⟩ := hq_sys_surj x'
      have hy' : y' = q_sys (S_z z x) := by
        apply Subtype.ext; ext r; rw [hxy' r]; exact (map_nsmul (q r) _ (x.1 r)).symm
      rw [hy']
      have h1 : TensorProduct.tmul ℤ (1 : ℚ) (q_sys x) =
