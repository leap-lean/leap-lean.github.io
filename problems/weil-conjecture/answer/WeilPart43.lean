              (hMapH_comp (iso_L r).hom (iso_L r).inv _).symm
          _ = mapH₀ (iso_L r).inv
                (mapH₀ (L₀.map (β₂₀ r) ≫ (iso_L r).hom) x₀) :=
              congrArg (mapH₀ (iso_L r).inv) (hMapH_comp (L₀.map (β₂₀ r)) (iso_L r).hom x₀)
          _ = mapH₀ (iso_L r).inv
                (mapH₀ ((iso_E r).inv ≫ (L₀.map (β₂₀ r) ≫ (iso_L r).hom)) x) :=
              congrArg (mapH₀ (iso_L r).inv)
                (hMapH_comp (iso_E r).inv (L₀.map (β₂₀ r) ≫ (iso_L r).hom) x)
          _ = mapH₀ (iso_L r).inv (mapH₀ (β₂_bar r) x) := rfl
          _ = 0 := by rw [hx, map_zero]
      have hC₂_x₀ : (ℓ ^ C₂) • x₀ = 0 :=
        (hH1Exact X₀ S₀ L₀ hAdd hColim hLim
          (ℛ₀ r) (ℰ₀ r) (ℒ₀ r) (α₂₀ r) (β₂₀ r) hMono₂ h0₂ hEx₂ (ℓ ^ C₂) hCok₂).2
          (hSub₀ r).2 x₀ hβ₂_x₀
      calc (ℓ ^ C₂) • x
          = (ℓ ^ C₂) • mapH₀ (CategoryTheory.CategoryStruct.id _) x := by
            rw [hMapH_id]
        _ = (ℓ ^ C₂) • mapH₀ ((iso_E r).inv ≫ (iso_E r).hom) x := by
            rw [(iso_E r).inv_hom_id]
        _ = (ℓ ^ C₂) • mapH₀ (iso_E r).hom x₀ := by
            rw [← hMapH_comp]
        _ = mapH₀ (iso_E r).hom ((ℓ ^ C₂) • x₀) :=
            (map_nsmul (mapH₀ (iso_E r).hom) (ℓ ^ C₂) x₀).symm
        _ = 0 := by rw [hC₂_x₀, map_zero]

    exact ⟨α₁_bar, β₂_bar, hα₁_iso, hβ₂_iso, hTors_M, hα₁_τ_H, hβ₂_τ_H, hq₁_pow_surj, hq₂_pow_ker⟩

  
  let S := weilGeomScheme F Y₀
  let pr_Y : Quiver.Hom S Y₀.left :=
    CategoryTheory.Limits.pullback.fst Y₀.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
  have _ : CategoryTheory.Limits.HasColimitsOfShape CategoryTheory.Limits.WalkingParallelPair
      (CategoryTheory.Sheaf Y₀.left.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
  have _ : CategoryTheory.Limits.HasColimitsOfShape CategoryTheory.Limits.WalkingParallelPair
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
  let _ : CategoryTheory.Abelian
      (CategoryTheory.Sheaf Y₀.left.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
  let _ : CategoryTheory.Abelian
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
  let _ : CategoryTheory.HasExt.{u}
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance

  let hCont_pr := E_mid.hCont_pr
  let hAdj_pr := E_mid.hAdj_pr
  let L_pr := @CategoryTheory.Functor.sheafPullback _ _ _ _
    (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
    Y₀.left.smallEtaleTopology S.smallEtaleTopology hCont_pr hAdj_pr
  obtain ⟨hAdd_L, hColim_L, hLim_L⟩ :=
    (weil_transv_etale_sheaf_pullback_exact S Y₀.left pr_Y).2 hCont_pr hAdj_pr
  obtain ⟨_, hFrobNat⟩ :=
    weil_transv_geom_base_sheaf_frob_action_existence_and_naturality F Y₀ 1 hCont_pr hAdj_pr

  obtain ⟨α₁_bar, β₂_bar, hα₁_iso, hβ₂_iso, hTors_Emid, hα₁_τ_H, hβ₂_τ_H,
      hq₁_pow_surj, hq₂_pow_ker⟩ :=
    hSheafGaugeBridge Y₀.left S L_pr hAdd_L hColim_L hLim_L
      ℛ_D ℰ_D 𝒱_D 𝒬_D ℒ_D τ_ℰ_D τ_𝒱_D τ_ℒ_D α₁ β₁ α₂ β₂
      E_mid.ℳ_bar E_push.ℳ_bar W_mid.ℳ_bar
      E_mid.τ_bar E_push.τ_bar W_mid.τ_bar
      E_mid.iso_bar E_push.iso_bar W_mid.iso_bar
      E_mid.hτ_bar E_push.hτ_bar W_mid.hτ_bar
      hTor_ℰ hSeq₁ hSeq₂ (fun r => hSub_outer r hCont_pr hAdj_pr)

  let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let mapH : ∀ {𝒜 ℬ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}},
      Quiver.Hom 𝒜 ℬ → (𝒜.H 1 →+ ℬ.H 1) :=
    fun f => (CategoryTheory.Abelian.Ext.mk₀ f).postcomp Fℤ (Nat.add_zero 1)

  have hα₁_frob : ∀ (r : ℕ) (x : (E_mid.ℳ_bar r).H 1),
      mapH (α₁_bar r) (E_mid.frobTorsion r x) =
        E_push.frobTorsion r (mapH (α₁_bar r) x) :=
    fun r x => hFrobNat (ℰ_D r) (𝒱_D r) (E_mid.ℳ_bar r) (E_push.ℳ_bar r)
      (E_mid.iso_bar r) (E_push.iso_bar r)
      (E_mid.frobTorsion r) (E_push.frobTorsion r)
      (α₁ r) (α₁_bar r)
      (E_mid.hfrobTorsion r) (E_push.hfrobTorsion r) (hα₁_iso r) x

  have hβ₂_frob : ∀ (r : ℕ) (x : (E_mid.ℳ_bar r).H 1),
      mapH (β₂_bar r) (E_mid.frobTorsion r x) =
        W_mid.frobTorsion r (mapH (β₂_bar r) x) :=
    fun r x => hFrobNat (ℰ_D r) (ℒ_D r) (E_mid.ℳ_bar r) (W_mid.ℳ_bar r)
      (E_mid.iso_bar r) (W_mid.iso_bar r)
      (E_mid.frobTorsion r) (W_mid.frobTorsion r)
      (β₂ r) (β₂_bar r)
      (E_mid.hfrobTorsion r) (W_mid.hfrobTorsion r) (hβ₂_iso r) x

  have hEmid_frob_τ : ∀ (r : ℕ) (x : (E_mid.ℳ_bar (r + 1)).H 1),
      mapH (E_mid.τ_bar r) (E_mid.frobTorsion (r + 1) x) =
        E_mid.frobTorsion r (mapH (E_mid.τ_bar r) x) :=
    fun r x => hFrobNat (ℰ_D (r + 1)) (ℰ_D r) (E_mid.ℳ_bar (r + 1)) (E_mid.ℳ_bar r)
      (E_mid.iso_bar (r + 1)) (E_mid.iso_bar r)
      (E_mid.frobTorsion (r + 1)) (E_mid.frobTorsion r)
      (τ_ℰ_D r) (E_mid.τ_bar r)
      (E_mid.hfrobTorsion (r + 1)) (E_mid.hfrobTorsion r) (E_mid.hτ_bar r) x

  obtain ⟨π_surj, hπ_frob, hπ_surj_gen, _⟩ :=
    hPadicTowerMap
      (fun r => (E_mid.ℳ_bar r).H 1) (fun r => (E_push.ℳ_bar r).H 1)
      (fun r => mapH (E_mid.τ_bar r)) (fun r => mapH (E_push.τ_bar r))
      E_mid.frobTorsion E_push.frobTorsion
      (fun r => mapH (α₁_bar r))
      E_mid.sysSubgroup E_push.sysSubgroup
      E_mid.V E_push.V E_mid.frob E_push.frob E_mid.equiv E_push.equiv
      hTors_Emid hα₁_τ_H hα₁_frob hEmid_frob_τ
      E_mid.hsys E_push.hsys E_mid.hsmul E_push.hsmul E_mid.hfrob E_push.hfrob
  have hπ_surj : Function.Surjective π_surj := hπ_surj_gen hFin_Emid C₁ hq₁_pow_surj

  obtain ⟨ι_inj, hι_frob, _, hι_inj_gen⟩ :=
    hPadicTowerMap
      (fun r => (E_mid.ℳ_bar r).H 1) (fun r => (W_mid.ℳ_bar r).H 1)
      (fun r => mapH (E_mid.τ_bar r)) (fun r => mapH (W_mid.τ_bar r))
      E_mid.frobTorsion W_mid.frobTorsion
      (fun r => mapH (β₂_bar r))
      E_mid.sysSubgroup W_mid.sysSubgroup
      E_mid.V W_mid.V E_mid.frob W_mid.frob E_mid.equiv W_mid.equiv
      hTors_Emid hβ₂_τ_H hβ₂_frob hEmid_frob_τ
      E_mid.hsys W_mid.hsys E_mid.hsmul W_mid.hsmul E_mid.hfrob W_mid.hfrob
  have hι_inj : Function.Injective ι_inj := hι_inj_gen C₂ hq₂_pow_ker

  exact hRoofCharpoly (Padic ℓ) (AlgebraicClosure (Padic ℓ))
    E_mid.V E_push.V W_mid.V E_mid.frob E_push.frob W_mid.frob
    π_surj ι_inj hπ_surj hπ_frob hι_inj hι_frob γ' hγ'_push

theorem weil_mid_dev_p1_nonisotropic_orbit_mid_ext_transfer (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (hu₀_mem : Set.range u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (M_Zu_mid : WeilEllAdicCohomologyModel F Z_u₀ ℓ (2 * m + 1))
    (D : WeilMidDevSmoothMonodromyPackage.{u} F m Z_tilde f₀ u₀ Z_u₀ j_aff S_aff U₀ ℓ M_Zu_mid)
    (E_push : WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ 1
      (fun r => weilEtaleHigherDirectImage U₀.ι 0 (D.𝒱₀ r))
      (fun r => weilEtaleHigherDirectImageMap U₀.ι 0 (D.τ_𝒱 r)))
    (γ' : AlgebraicClosure (Padic ℓ))
    (hγ'_push : γ' ∈ ((E_push.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)))
    (E_van E_perp E_rad : Submodule (Padic ℓ) (Fin D.N → Padic ℓ))
    (hE_perp : ∀ x : Fin D.N → Padic ℓ,
      x ∈ E_perp ↔ ∀ y ∈ E_van, dotProduct x (D.J_V.mulVec y) = 0)
    (hE_rad : E_rad = E_van ⊓ E_perp)
    (hGV_van : ∀ g ∈ D.G_V, ∀ x : Fin D.N → Padic ℓ,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x - x ∈ E_van)
    (hGV_perp : ∀ g ∈ D.G_V, ∀ x ∈ E_perp,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x = x)
    (w_inf : Fin D.N → Padic ℓ) (w_aff : F → (Fin D.N → Padic ℓ))
    (hw_inf_van : w_inf ∈ E_van) (hw_inf_ni : w_inf ∉ E_perp)
    (hw_aff_van : ∀ a ∈ S_aff, w_aff a ∈ E_van) (hw_aff_ni : ∀ a ∈ S_aff, w_aff a ∉ E_perp)
    (hInert_all : ∀ r : ℕ,
      letI := D.hCR r; letI := D.hFld r; letI := D.hAF_L r; letI := D.hAP_L r
      letI := D.hARF_L r; letI := D.hABL r; letI := D.hAR_B r
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      let C₀_r := integralClosure (Polynomial F) (D.L_V r)
      let A_inf_r := Algebra.adjoin F
        ({algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹} : Set (D.L_V r))
      let t_inf_r : ↥A_inf_r :=
        ⟨algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹, Algebra.self_mem_adjoin_singleton F _⟩
      let C_inf_r := integralClosure ↥A_inf_r (D.L_V r)
      (∀ a ∈ S_aff, ∀ Q : Ideal ↥C₀_r, Q.IsPrime →
        Ideal.comap (algebraMap (Polynomial F) ↥C₀_r) Q =
          Ideal.span {Polynomial.X - Polynomial.C a} →
        ∃ g_Q ∈ D.G_V,
          ∀ (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r) (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
            (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) →
            (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
              algebraMap (D.B_V r) (D.L_V r) (σ_B b)) →
            (∀ y : ↥C₀_r,
              σ_L (y : D.L_V r) - (y : D.L_V r) ∈ Subtype.val '' (Q : Set ↥C₀_r)) →
            ∃ u ∈ D.G_V,
              (D.ρ_V r σ_B).val = (u.val).map (PadicInt.toZModPow (r + 1)) ∧
              ∃ c : Padic ℓ, ∀ x : Fin D.N → Padic ℓ,
                ((u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
                  x + (c * dotProduct x (D.J_V.mulVec
                    (((g_Q.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf))) •
                    (((g_Q.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf)) ∧
      (∀ Q_inf : Ideal ↥C_inf_r, Q_inf.IsPrime →
        Ideal.comap (algebraMap ↥A_inf_r ↥C_inf_r) Q_inf = Ideal.span {t_inf_r} →
        ∃ g_Q ∈ D.G_V,
          ∀ (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r) (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
            (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) →
            (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
              algebraMap (D.B_V r) (D.L_V r) (σ_B b)) →
            (∀ y : ↥C_inf_r,
              σ_L (y : D.L_V r) - (y : D.L_V r) ∈ Subtype.val '' (Q_inf : Set ↥C_inf_r)) →
            ∃ u ∈ D.G_V,
              (D.ρ_V r σ_B).val = (u.val).map (PadicInt.toZModPow (r + 1)) ∧
              ∃ c : Padic ℓ, ∀ x : Fin D.N → Padic ℓ,
                ((u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
                  x + (c * dotProduct x (D.J_V.mulVec
                    (((g_Q.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf))) •
                    (((g_Q.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf)))
    (hInert_wit :
      (∃ (c_inf : Padic ℓ) (u_inf : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ),
        c_inf ≠ 0 ∧ u_inf ∈ D.G_V ∧
        (∀ x : Fin D.N → Padic ℓ,
          ((u_inf.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
            x + (c_inf * dotProduct x (D.J_V.mulVec w_inf)) • w_inf) ∧
        ∀ r : ℕ,
          letI := D.hCR r; letI := D.hFld r; letI := D.hAF_L r; letI := D.hARF_L r
          letI := D.hABL r; letI := D.hAR_B r
          let R₀ := Localization.Away
            (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
          let A_inf_r := Algebra.adjoin F
            ({algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹} : Set (D.L_V r))
          let t_inf_r : ↥A_inf_r :=
            ⟨algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹,
              Algebra.self_mem_adjoin_singleton F _⟩
          let C_inf_r := integralClosure ↥A_inf_r (D.L_V r)
          ∃ (Q_inf : Ideal ↥C_inf_r)
            (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r)
            (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
            Q_inf.IsPrime ∧
            Ideal.comap (algebraMap ↥A_inf_r ↥C_inf_r) Q_inf = Ideal.span {t_inf_r} ∧
            (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) ∧
            (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
              algebraMap (D.B_V r) (D.L_V r) (σ_B b)) ∧
            (∀ y : ↥C_inf_r,
              σ_L (y : D.L_V r) - (y : D.L_V r) ∈ Subtype.val '' (Q_inf : Set ↥C_inf_r)) ∧
            (D.ρ_V r σ_B).val = (u_inf.val).map (PadicInt.toZModPow (r + 1))) ∧
      (∀ a ∈ S_aff,
        ∃ (c_a : Padic ℓ) (u_a : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ),
          c_a ≠ 0 ∧ u_a ∈ D.G_V ∧
          (∀ x : Fin D.N → Padic ℓ,
            ((u_a.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
              x + (c_a * dotProduct x (D.J_V.mulVec (w_aff a))) • w_aff a) ∧
          ∀ r : ℕ,
            letI := D.hCR r; letI := D.hFld r; letI := D.hAF_L r; letI := D.hAP_L r
            letI := D.hARF_L r; letI := D.hABL r; letI := D.hAR_B r
            let R₀ := Localization.Away
              (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
            let C₀_r := integralClosure (Polynomial F) (D.L_V r)
            ∃ (Q : Ideal ↥C₀_r)
              (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r)
              (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
              Q.IsPrime ∧
              Ideal.comap (algebraMap (Polynomial F) ↥C₀_r) Q =
                Ideal.span {Polynomial.X - Polynomial.C a} ∧
              (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) ∧
              (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
                algebraMap (D.B_V r) (D.L_V r) (σ_B b)) ∧
              (∀ y : ↥C₀_r,
                σ_L (y : D.L_V r) - (y : D.L_V r) ∈ Subtype.val '' (Q : Set ↥C₀_r)) ∧
              (D.ρ_V r σ_B).val = (u_a.val).map (PadicInt.toZModPow (r + 1))))
    (M₀ M M₂ : ℕ) (hM : 1 ≤ M) (hSum : M₀ + M + M₂ = D.N)
    (P_chg : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ)
    (J : Matrix (Fin M) (Fin M) (Padic ℓ))
    (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
    (F_u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ)
    (F_mat : ∀ (d : ℕ) (P_poly : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P_poly → Matrix (Fin M) (Fin M) (PadicInt ℓ))
    (Δ : Set (Fin M → Padic ℓ))
    (ℒ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
    (τ_ℒ : ∀ r : ℕ, Quiver.Hom (ℒ₀ (r + 1)) (ℒ₀ r))
    (hBasis : ∀ x : Fin D.N → Padic ℓ,
      (x ∈ E_rad ↔ ∀ i : Fin D.N, M₀ ≤ i.1 →
        (((P_chg⁻¹).val.map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x) i = 0) ∧
      (x ∈ E_van ↔ ∀ i : Fin D.N, M₀ + M ≤ i.1 →
        (((P_chg⁻¹).val.map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x) i = 0))
    (hBridge : WeilMidDevTowerWithBlockBridge.{u} F m D M₀ M M₂ hSum P_chg J G_geom F_u F_mat Δ
      ℒ₀ τ_ℒ) :
    ∃ (W_mid : WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ 1
        (fun r => weilEtaleHigherDirectImage U₀.ι 0 (ℒ₀ r))
        (fun r => weilEtaleHigherDirectImageMap U₀.ι 0 (τ_ℒ r))),
      γ' ∈ ((W_mid.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)) :=
by
  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  let D₀ := weilProjectiveSpaceOver F 1
