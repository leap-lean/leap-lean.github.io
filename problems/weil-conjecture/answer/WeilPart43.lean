        change j_B r (algebraMap (Polynomial F) (B r) p) = algebraMap (Polynomial F) (B_V r) p
        rw [IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B r), (j_B r).commutes,
          ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B_V r)]
      rw [hcomp_PF, hQu_comap]
    · dsimp only
      rw [Ideal.comap_comap, ← hQu_trans, Ideal.comap_comap]
      congr 1; apply RingHom.ext; intro b; exact hι_B_spec r b
    · obtain ⟨σ_u_B, hσu_comm, hσu_ρ⟩ := (hρ_spec r).2.2.1 σ_u_V
      refine ⟨σ_u_B, ?_, ?_⟩
      · intro b
        have hsymm : j_B r (σ_u_B.symm b) = σ_u_V.symm (j_B r b) := by
          apply σ_u_V.injective
          rw [hσu_comm (σ_u_B.symm b), σ_u_B.apply_symm_apply, σ_u_V.apply_symm_apply]
        change j_B r (σ_u_B.symm b - b ^ Nat.card F) ∈ Q_u_V r
        rw [map_sub, map_pow, hsymm]
        exact hσu_frob (j_B r b)
      · ext k₁ k₂
        rw [congrArg Units.val hσu_ρ, (hρ_mid_spec r).1 σ_u_V k₁ k₂, ← hFu_mid]
        dsimp only
        have hAdap_eq :
            ((P_chg⁻¹).val.map (PadicInt.toZModPow (r + 1)) * (ρ_V r σ_u_V).val *
              (P_chg.val.map (PadicInt.toZModPow (r + 1)))) =
            ((P_chg⁻¹).val * F_V_u.val * P_chg.val).map (PadicInt.toZModPow (r + 1)) := by
          rw [hσu_mat, ← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply,
            ← RingHom.mapMatrix_apply, ← map_mul, ← map_mul]; rfl
        rw [hAdap_eq]; rfl
  · 
    intro d P_poly hP
    obtain ⟨Q_P_V, hQP_V⟩ := hQ_P d P_poly hP
    refine ⟨fun r => Ideal.comap (j_B r).toRingHom (Q_P_V r), fun r => ?_⟩
    obtain ⟨hQP_max, hQP_comap, hQP_trans, σ_P_V, hσP_frob, hσP_mat⟩ := hQP_V r
    have _ : (Q_P_V r).IsMaximal := hQP_max
    have hj_int : (j_B r).toRingHom.IsIntegral := by
      let _ : Algebra (B r) (B_V r) := (j_B r).toRingHom.toAlgebra
      have _ : IsScalarTower R₀ (B r) (B_V r) :=
        IsScalarTower.of_algebraMap_eq fun z => ((j_B r).commutes z).symm
      have _ : Algebra.IsIntegral R₀ (B_V r) := Algebra.IsIntegral.of_finite R₀ (B_V r)
      have hI : Algebra.IsIntegral (B r) (B_V r) := Algebra.IsIntegral.tower_top R₀
      exact fun y => hI.isIntegral y
    refine ⟨Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (j_B r).toRingHom hj_int (Q_P_V r),
      ?_, ?_, ?_⟩
    · rw [Ideal.comap_comap]
      have hcomp_PF : (j_B r).toRingHom.comp (algebraMap (Polynomial F) (B r)) =
          algebraMap (Polynomial F) (B_V r) := by
        apply RingHom.ext; intro p; simp only [RingHom.comp_apply]
        change j_B r (algebraMap (Polynomial F) (B r) p) = algebraMap (Polynomial F) (B_V r) p
        rw [IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B r), (j_B r).commutes,
          ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B_V r)]
      rw [hcomp_PF, hQP_comap]
    · dsimp only
      rw [Ideal.comap_comap, ← hQP_trans, Ideal.comap_comap]
      congr 1; apply RingHom.ext; intro b; exact hι_B_spec r b
    · obtain ⟨σ_P_B, hσP_comm, hσP_ρ⟩ := (hρ_spec r).2.2.1 σ_P_V
      refine ⟨σ_P_B, ?_, ?_⟩
      · intro b
        have hsymm : j_B r (σ_P_B.symm b) = σ_P_V.symm (j_B r b) := by
          apply σ_P_V.injective
          rw [hσP_comm (σ_P_B.symm b), σ_P_B.apply_symm_apply, σ_P_V.apply_symm_apply]
        change j_B r (σ_P_B.symm b - b ^ (Nat.card F ^ d)) ∈ Q_P_V r
        rw [map_sub, map_pow, hsymm]
        exact hσP_frob (j_B r b)
      · ext k₁ k₂
        rw [congrArg Units.val hσP_ρ, (hρ_mid_spec r).1 σ_P_V k₁ k₂, ← hFmat_mid d P_poly hP]
        dsimp only
        have hAdap_eq :
            ((P_chg⁻¹).val.map (PadicInt.toZModPow (r + 1)) * (ρ_V r σ_P_V).val *
              (P_chg.val.map (PadicInt.toZModPow (r + 1)))) =
            ((P_chg⁻¹).val * (F_V_mat d P_poly hP) * P_chg.val).map (PadicInt.toZModPow (r + 1)) := by
          rw [hσP_mat, ← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply,
            ← RingHom.mapMatrix_apply, ← map_mul, ← map_mul]; rfl
        rw [hAdap_eq]; rfl
  · 
    exact fun r => ⟨hι_L_inj r, hι_L_PF r, hj_B_spec r⟩
  · 
    intro r
    refine ⟨hj_B_inj r, fun b => (hι_B_spec r b).symm, ?_⟩
    intro τ
    obtain ⟨σ, hσ_comm, hσ_ρ⟩ := (hρ_spec r).2.2.1 τ
    refine ⟨((hρ_mid_spec r).2.1 τ).1, ((hρ_mid_spec r).2.1 τ).2,
      (hρ_mid_spec r).2.2 τ, σ, hσ_comm, ?_⟩
    intro k₁ k₂
    rw [congrArg Units.val hσ_ρ, (hρ_mid_spec r).1 τ k₁ k₂]

theorem weil_mid_dev_dedekind_galois_inertia_lift (F A K E L : Type u) [Field F] [CommRing A] [IsDedekindDomain A]
    [Field K] [Field E] [Field L]
    [Algebra F A] [Algebra F K] [Algebra F E] [Algebra F L]
    [Algebra A K] [IsFractionRing A K]
    [Algebra K E] [Algebra K L] [Algebra E L] [Algebra A E] [Algebra A L]
    [IsScalarTower F A K] [IsScalarTower F K E] [IsScalarTower F K L]
    [IsScalarTower A K E] [IsScalarTower A K L] [IsScalarTower K E L] [IsScalarTower A E L]
    [FiniteDimensional K E] [IsGalois K E] [FiniteDimensional K L] [IsGalois K L]
    (p : Ideal A) (hp_ne : p ≠ ⊥) [p.IsMaximal]
    (Q_E : Ideal ↥(integralClosure A E)) (hQE_prime : Q_E.IsPrime)
    (hQE_over : Ideal.comap (algebraMap A ↥(integralClosure A E)) Q_E = p)
    (σ_E : E ≃ₐ[K] E)
    (hσE_inert : ∀ y : ↥(integralClosure A E),
      σ_E (y : E) - (y : E) ∈ Subtype.val '' (Q_E : Set ↥(integralClosure A E))) :
    ∃ (Q_L : Ideal ↥(integralClosure A L)) (σ_L : L ≃ₐ[K] L),
      Q_L.IsPrime ∧
      Ideal.comap (algebraMap A ↥(integralClosure A L)) Q_L = p ∧
      (∀ x : E, σ_L (algebraMap E L x) = algebraMap E L (σ_E x)) ∧
      (∀ z : ↥(integralClosure A L),
        σ_L (z : L) - (z : L) ∈ Subtype.val '' (Q_L : Set ↥(integralClosure A L))) ∧
      (∀ c : L, IsIntegral F c → σ_L c = c) :=
by
  open Pointwise in
  let _ := hp_ne
  have _ : FiniteDimensional E L := FiniteDimensional.right K E L
  have _ : IsGalois E L := IsGalois.tower_top_of_isGalois K E L
  have _ : IsScalarTower F A L := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply F K L c, IsScalarTower.algebraMap_apply F A K c,
      ← IsScalarTower.algebraMap_apply A K L]
  let B := ↥(integralClosure A E)
  let C := ↥(integralClosure A L)
  have _ : IsDedekindDomain B := integralClosure.isDedekindDomain A K E
  have _ : IsDedekindDomain C := integralClosure.isDedekindDomain A K L
  have _ : IsFractionRing B E := integralClosure.isFractionRing_of_finite_extension K E
  have _ : IsFractionRing C L := integralClosure.isFractionRing_of_finite_extension K L
  let _ : Algebra B L :=
    { algebraMap := (algebraMap E L).comp (algebraMap B E)
      commutes' := fun _ _ => mul_comm _ _
      smul_def' := fun b x => Algebra.smul_def (b : E) x }
  have _ : IsScalarTower B E L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let j_BC : B →+* C :=
    { toFun := fun b => ⟨algebraMap E L (b : E), IsIntegral.map (IsScalarTower.toAlgHom A E L) b.2⟩
      map_one' := Subtype.ext (map_one (algebraMap E L))
      map_mul' := fun x y => Subtype.ext (map_mul (algebraMap E L) (x : E) (y : E))
      map_zero' := Subtype.ext (map_zero (algebraMap E L))
      map_add' := fun x y => Subtype.ext (map_add (algebraMap E L) (x : E) (y : E)) }
  let _ : Algebra B C := j_BC.toAlgebra
  have _ : IsScalarTower A B C :=
    IsScalarTower.of_algebraMap_eq fun a => Subtype.ext (IsScalarTower.algebraMap_apply A E L a)
  have _ : IsScalarTower B C L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have _ : Algebra.IsIntegral B C := Algebra.IsIntegral.tower_top A
  have _ : FaithfulSMul B C := FaithfulSMul.of_field_isFractionRing B C E L
  have _ : SMulCommClass (E ≃ₐ[K] E) A E :=
    ⟨fun δ a x => by
      rw [AlgEquiv.smul_def, AlgEquiv.smul_def, Algebra.smul_def, Algebra.smul_def, map_mul,
        IsScalarTower.algebraMap_apply A K E a, δ.commutes]⟩
  have _ : SMulCommClass (L ≃ₐ[K] L) A L :=
    ⟨fun δ a x => by
      rw [AlgEquiv.smul_def, AlgEquiv.smul_def, Algebra.smul_def, Algebra.smul_def, map_mul,
        IsScalarTower.algebraMap_apply A K L a, δ.commutes]⟩
  have _ : SMulCommClass (L ≃ₐ[E] L) A L :=
    ⟨fun δ a x => by
      rw [AlgEquiv.smul_def, AlgEquiv.smul_def, Algebra.smul_def, Algebra.smul_def, map_mul,
        IsScalarTower.algebraMap_apply A E L a, δ.commutes]⟩
  have _ : IsGaloisGroup (L ≃ₐ[K] L) A C :=
    IsGaloisGroup.of_isFractionRing (L ≃ₐ[K] L) A C K L
  have _ : IsGaloisGroup (L ≃ₐ[E] L) B C :=
    IsGaloisGroup.of_isFractionRing (L ≃ₐ[E] L) B C E L
  have h_restr_inv : ∀ δ : L ≃ₐ[E] L, (δ.restrictScalars K)⁻¹ = (δ⁻¹).restrictScalars K :=
    fun _ => AlgEquiv.ext fun _ => rfl
  have h_restr_smul_elem : ∀ (δ : L ≃ₐ[E] L) (z : C), (δ.restrictScalars K) • z = δ • z :=
    fun _ _ => Subtype.ext rfl
  have h_restr_smul_ideal : ∀ (δ : L ≃ₐ[E] L) (I : Ideal C), (δ.restrictScalars K) • I = δ • I := by
    intro δ I
    ext z
    rw [Ideal.mem_pointwise_smul_iff_inv_smul_mem, Ideal.mem_pointwise_smul_iff_inv_smul_mem,
      h_restr_inv, h_restr_smul_elem]
  have _ : Q_E.IsPrime := hQE_prime
  have _ : Q_E.LiesOver p := (Ideal.liesOver_iff Q_E p).mpr hQE_over.symm
  have h_nonempty : Nonempty ↑(Q_E.primesOver C) := Ideal.nonempty_primesOver (S := C) Q_E
  obtain ⟨Q_L, hQL_prime, hQL_over_QE⟩ := Classical.choice h_nonempty
  have _ : Q_L.IsPrime := hQL_prime
  have _ : Q_L.LiesOver Q_E := hQL_over_QE
  have _ : Q_L.LiesOver p := Ideal.LiesOver.trans Q_L Q_E p
  have hQL_over_p : Ideal.comap (algebraMap A C) Q_L = p :=
    ((Ideal.liesOver_iff Q_L p).mp inferInstance).symm
  have hσE_sub : ∀ b : B, σ_E • b - b ∈ Q_E := by
    intro b
    obtain ⟨q, hq_mem, hq_val⟩ := hσE_inert b
    have hq_eq : σ_E • b - b = q := Subtype.ext hq_val.symm
    rwa [hq_eq]
  have hσE_mem_iff : ∀ b : B, σ_E • b ∈ Q_E ↔ b ∈ Q_E := by
    intro b
    refine ⟨fun h => ?_, fun hb => ?_⟩
    · have h1 : b = σ_E • b - (σ_E • b - b) := by abel
      rw [h1]
      exact Q_E.sub_mem h (hσE_sub b)
    · have h1 : σ_E • b = (σ_E • b - b) + b := by abel
      rw [h1]
      exact Q_E.add_mem (hσE_sub b) hb
  obtain ⟨τ_0, hτ0_norm⟩ := AlgEquiv.restrictNormalHom_surjective L σ_E
  have hτ0_ext : ∀ x : E, τ_0 (algebraMap E L x) = algebraMap E L (σ_E x) := by
    intro x
    have h := AlgEquiv.restrictNormal_commutes τ_0 E x
    rw [show τ_0.restrictNormal E = σ_E from hτ0_norm] at h
    exact h.symm
  have hτ0_B : ∀ b : B, τ_0 • algebraMap B C b = algebraMap B C (σ_E • b) :=
    fun b => Subtype.ext (hτ0_ext (b : E))
  let Q'_L : Ideal C := τ_0⁻¹ • Q_L
  have _ : Q'_L.IsPrime := Ideal.IsPrime.smul (τ_0⁻¹)
  have h_under_eq : Ideal.under B Q'_L = Ideal.under B Q_L := by
    ext b
    change algebraMap B C b ∈ τ_0⁻¹ • Q_L ↔ algebraMap B C b ∈ Q_L
    rw [Ideal.mem_pointwise_smul_iff_inv_smul_mem, inv_inv, hτ0_B]
    have hover : Q_E = Ideal.comap (algebraMap B C) Q_L := Ideal.over_def Q_L Q_E
    change algebraMap B C (σ_E • b) ∈ Q_L ↔ algebraMap B C b ∈ Q_L
    have h1 : (algebraMap B C (σ_E • b) ∈ Q_L) ↔ σ_E • b ∈ Q_E := by rw [hover]; rfl
    have h2 : (algebraMap B C b ∈ Q_L) ↔ b ∈ Q_E := by rw [hover]; rfl
    rw [h1, h2]
    exact hσE_mem_iff b
  obtain ⟨g, hg_Q⟩ :=
    Algebra.IsInvariant.exists_smul_of_under_eq B C (L ≃ₐ[E] L) Q'_L Q_L h_under_eq
  let g_K : L ≃ₐ[K] L := g.restrictScalars K
  let τ_1 : L ≃ₐ[K] L := τ_0 * g_K⁻¹
  have hτ1_stab : τ_1 ∈ MulAction.stabilizer (L ≃ₐ[K] L) Q_L := by
    rw [MulAction.mem_stabilizer_iff]
    have hg_K_Q : (g_K * τ_0⁻¹) • Q_L = Q_L := by
      rw [mul_smul, h_restr_smul_ideal]
      exact hg_Q.symm
    have hτ1_eq : τ_1 = (g_K * τ_0⁻¹)⁻¹ := by
      dsimp [τ_1]
      rw [mul_inv_rev, inv_inv]
    calc τ_1 • Q_L = (g_K * τ_0⁻¹)⁻¹ • ((g_K * τ_0⁻¹) • Q_L) := by rw [← hτ1_eq, hg_K_Q]
      _ = Q_L := inv_smul_smul (g_K * τ_0⁻¹) Q_L
  have hτ1_ext : ∀ x : E, τ_1 (algebraMap E L x) = algebraMap E L (σ_E x) := by
    intro x
    dsimp [τ_1, g_K]
    rw [g.symm.commutes x, hτ0_ext x]
  have hτ1_B : ∀ b : B, τ_1 • algebraMap B C b = algebraMap B C (σ_E • b) :=
    fun b => Subtype.ext (hτ1_ext (b : E))
  let θ_1 : (C ⧸ Q_L) ≃+* (C ⧸ Q_L) :=
    (Ideal.Quotient.stabilizerHom Q_L p (L ≃ₐ[K] L) ⟨τ_1, hτ1_stab⟩).toRingEquiv
  have hθ1_mk : ∀ z : C, θ_1 (Ideal.Quotient.mk Q_L z) = Ideal.Quotient.mk Q_L (τ_1 • z) :=
    fun z => Ideal.Quotient.stabilizerHom_apply Q_L p (L ≃ₐ[K] L) ⟨τ_1, hτ1_stab⟩ z
  have hθ1_comm : ∀ q : B ⧸ Q_E,
      θ_1 (algebraMap (B ⧸ Q_E) (C ⧸ Q_L) q) = algebraMap (B ⧸ Q_E) (C ⧸ Q_L) q := by
    intro q
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective q
    have halg : algebraMap (B ⧸ Q_E) (C ⧸ Q_L) (Ideal.Quotient.mk Q_E b) =
        Ideal.Quotient.mk Q_L (algebraMap B C b) := rfl
    rw [halg, hθ1_mk, hτ1_B, Ideal.Quotient.eq]
    rw [← map_sub]
    have hover : Q_E = Ideal.comap (algebraMap B C) Q_L := Ideal.over_def Q_L Q_E
    have hmem : σ_E • b - b ∈ Ideal.comap (algebraMap B C) Q_L := by
      rw [← hover]
      exact hσE_sub b
    exact hmem
  let τ_bar_1 : (C ⧸ Q_L) ≃ₐ[B ⧸ Q_E] (C ⧸ Q_L) := AlgEquiv.ofRingEquiv (f := θ_1) hθ1_comm
  obtain ⟨δ_2, hδ_2⟩ :=
    Ideal.Quotient.stabilizerHom_surjective (L ≃ₐ[E] L) Q_E Q_L τ_bar_1
  let σ_L : L ≃ₐ[K] L := (δ_2.1.restrictScalars K)⁻¹ * τ_1
  have hσL_ext : ∀ x : E, σ_L (algebraMap E L x) = algebraMap E L (σ_E x) := by
    intro x
    dsimp [σ_L]
    rw [hτ1_ext x]
    exact δ_2.1.symm.commutes (σ_E x)
  have hσL_sub : ∀ z : C, σ_L • z - z ∈ Q_L := by
    intro z
    let Φ := Ideal.Quotient.stabilizerHom Q_L Q_E (L ≃ₐ[E] L)
    have h1 : (Φ δ_2) (Ideal.Quotient.mk Q_L z) = Ideal.Quotient.mk Q_L (τ_1 • z) := by
      change (Ideal.Quotient.stabilizerHom Q_L Q_E (L ≃ₐ[E] L) δ_2) (Ideal.Quotient.mk Q_L z) = _
      rw [hδ_2]
      exact hθ1_mk z
    have h2 := congrArg (Φ δ_2⁻¹) h1
    have hlhs : (Φ δ_2⁻¹) ((Φ δ_2) (Ideal.Quotient.mk Q_L z)) = Ideal.Quotient.mk Q_L z := by
      change ((Φ δ_2⁻¹) * (Φ δ_2)) (Ideal.Quotient.mk Q_L z) = _
      rw [← map_mul, inv_mul_cancel, map_one, AlgEquiv.one_apply]
    have hrhs : (Φ δ_2⁻¹) (Ideal.Quotient.mk Q_L (τ_1 • z)) =
        Ideal.Quotient.mk Q_L (σ_L • z) := by
      rw [Ideal.Quotient.stabilizerHom_apply]
      have hsmul : δ_2⁻¹ • (τ_1 • z) = σ_L • z := Subtype.ext rfl
      rw [hsmul]
    rw [hlhs, hrhs] at h2
    exact Ideal.Quotient.eq.mp h2.symm
  have hσL_inert : ∀ z : C, σ_L (z : L) - (z : L) ∈ Subtype.val '' (Q_L : Set C) :=
    fun z => ⟨σ_L • z - z, hσL_sub z, rfl⟩
  have hσL_int : ∀ c : L, IsIntegral F c → σ_L c = c := by
    intro c hc
    by_contra hc_ne
    let σ_LF : L ≃ₐ[F] L := σ_L.restrictScalars F
    have hσc : IsIntegral F (σ_L c) := IsIntegral.map σ_LF hc
    have hd_F : IsIntegral F (σ_L c - c) := IsIntegral.sub hσc hc
    have hd_ne : σ_L c - c ≠ 0 := sub_ne_zero.mpr hc_ne
    have hd_inv_F : IsIntegral F (σ_L c - c)⁻¹ := IsIntegral.inv hd_F
    have hc_A : IsIntegral A c := IsIntegral.tower_top hc
    have hd_inv_A : IsIntegral A (σ_L c - c)⁻¹ := IsIntegral.tower_top hd_inv_F
    let z_c : C := ⟨c, hc_A⟩
    let z_inv : C := ⟨(σ_L c - c)⁻¹, hd_inv_A⟩
    have h_prod_mem : z_inv * (σ_L • z_c - z_c) ∈ Q_L :=
      Q_L.mul_mem_left z_inv (hσL_sub z_c)
    have h_prod_one : z_inv * (σ_L • z_c - z_c) = 1 := by
      apply Subtype.ext
      change (σ_L c - c)⁻¹ * (σ_L c - c) = 1
      exact inv_mul_cancel₀ hd_ne
    rw [h_prod_one] at h_prod_mem
    exact hQL_prime.ne_top (Q_L.eq_top_iff_one.mpr h_prod_mem)
  exact ⟨Q_L, σ_L, hQL_prime, hQL_over_p, hσL_ext, hσL_inert, hσL_int⟩

theorem weil_mid_dev_galois_tower_sheaf_descent (F : Type u) [Field F]
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (ℓ M : ℕ)
    (B L_fld : ℕ → Type u)
    [∀ r, CommRing (B r)] [∀ r, IsDomain (B r)] [∀ r, Field (L_fld r)]
    [∀ r, Algebra (Polynomial F) (B r)]
    [∀ r, Algebra
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B r)]
    [∀ r, Algebra (Polynomial F) (L_fld r)]
    [∀ r, Algebra (RatFunc F) (L_fld r)]
    [∀ r, Algebra (B r) (L_fld r)]
    [∀ r, Algebra
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (L_fld r)]
    [∀ r, IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B r)]
    [∀ r, IsScalarTower (Polynomial F) (RatFunc F) (L_fld r)]
    [∀ r, IsScalarTower (Polynomial F) (B r) (L_fld r)]
    [∀ r, IsScalarTower
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
      (B r) (L_fld r)]
    [∀ r, Module.Finite
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B r)]
    [∀ r, Algebra.Etale
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B r)]
    [∀ r, IsFractionRing (B r) (L_fld r)]
    [∀ r, IsIntegralClosure (B r)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (L_fld r)]
    [∀ r, FiniteDimensional (RatFunc F) (L_fld r)]
    [∀ r, IsGalois (RatFunc F) (L_fld r)]
    (ρ : ∀ r : ℕ,
      (B r ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))]
        B r) →* (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ)
    (ι_B : ∀ r : ℕ,
      B r →ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))]
        B (r + 1))
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U₀.toScheme)
    (hCompat_B : ∀ r : ℕ, Function.Injective (ι_B r) ∧
      ∀ τ : B (r + 1) ≃ₐ[Localization.Away
          (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B (r + 1),
        ∃ σ : B r ≃ₐ[Localization.Away
            (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B r,
          (∀ b : B r, τ (ι_B r b) = ι_B r (σ b)) ∧
          ((ρ (r + 1) τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) _) =
            (ρ r σ).val) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∃ (ℒ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
      (τ_ℒ : ∀ r : ℕ, Quiver.Hom (ℒ₀ (r + 1)) (ℒ₀ r))
      (triv : ∀ (r : ℕ) (W : U₀.toScheme.Etale),
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r)))) e_U.hom
        let W_r := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom π_r
        ↑((ℒ₀ r).obj.obj (Opposite.op W)) →+
          LocallyConstant ↥W_r (Fin M → ZMod (ℓ ^ (r + 1)))),
      ∀ r : ℕ,
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r)))) e_U.hom
        let π_succ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (B (r + 1)))) U₀.toScheme :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B (r + 1))))) e_U.hom
        let A_r : AddCommGrpCat.{u} :=
          AddCommGrpCat.uliftFunctor.{u, 0}.obj
            (AddCommGrpCat.of (Fin M → ZMod (ℓ ^ (r + 1))))
        WeilIsEtaleSheafPullback π_r (ℒ₀ r)
          ((CategoryTheory.constantSheaf V_r.smallEtaleTopology AddCommGrpCat.{u}).obj A_r) ∧
        (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
          let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
          let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
          let W₁_r := CategoryTheory.Limits.pullback h₁ π_r
          let W₂_r := CategoryTheory.Limits.pullback h₂ π_r
          ∀ (u_r : Quiver.Hom W₁_r W₂_r),
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.fst h₂ π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.fst h₁ π_r)
                ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.snd h₂ π_r) =
              CategoryTheory.Limits.pullback.snd h₁ π_r →
            ∀ (s : ↑((ℒ₀ r).obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_r),
              triv r W₁ (((ℒ₀ r).obj.map (Opposite.op u)) s) y₁ =
                triv r W₂ s (u_r.base y₁)) ∧
        ∀ (W : U₀.toScheme.Etale),
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
          let W_r := CategoryTheory.Limits.pullback h_W π_r
          let W_succ := CategoryTheory.Limits.pullback h_W π_succ
          Function.Injective (triv r W) ∧
          Set.range (triv r W) =
            { f | ∀ (σ : B r ≃ₐ[R₀] B r) (m_σ : Quiver.Hom W_r W_r),
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W π_r) =
                CategoryTheory.Limits.pullback.fst h_W π_r →
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W π_r) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W π_r)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
              ∀ y : ↥W_r, f (m_σ.base y) = ((ρ r σ).val).mulVec (f y) } ∧
          ∀ (s_up : ↑((ℒ₀ (r + 1)).obj.obj (Opposite.op W)))
            (m_ι : Quiver.Hom W_succ W_r),
            CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.fst h_W π_r) =
              CategoryTheory.Limits.pullback.fst h_W π_succ →
            CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.snd h_W π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W π_succ)
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B r).toRingHom)) →
            ∀ (y_up : ↥W_succ) (i : Fin M),
              triv r W (((τ_ℒ r).hom.app (Opposite.op W)) s_up) (m_ι.base y_up) i =
                ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
                  (triv (r + 1) W s_up y_up i) :=
by
  classical
  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  obtain ⟨hAlgIdemp, hR₀Pkg, hRelPkg⟩ := weil_etale_galois_domain_idempotents_and_aut_lift.{u}
  obtain ⟨hDom_R₀, instAlg_R₀K, hFrac_R₀K, hST_R₀KL_gen⟩ := hR₀Pkg F S_aff
  have _ : IsDomain R₀ := hDom_R₀
  let _ : Algebra R₀ (RatFunc F) := instAlg_R₀K
  have _ : IsFractionRing R₀ (RatFunc F) := hFrac_R₀K
  have _ : ∀ r, IsScalarTower R₀ (RatFunc F) (L_fld r) :=
    fun r => hST_R₀KL_gen (B r) (L_fld r)
  obtain ⟨hMemSite, hPullAdjSite, hConstEquivSite⟩ :=
    weil_etale_constant_sheaf_locallyConstant_equiv_and_pullback_adj.{u}
  let V_sch : ℕ → AlgebraicGeometry.Scheme.{u} :=
    fun r => AlgebraicGeometry.Spec (CommRingCat.of (B r))
  let π_sch : ∀ r : ℕ, V_sch r ⟶ U₀.toScheme :=
    fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
  let A_grp : ℕ → AddCommGrpCat.{u} :=
    fun r => AddCommGrpCat.uliftFunctor.{u, 0}.obj
      (AddCommGrpCat.of (Fin M → ZMod (ℓ ^ (r + 1))))
  have hLevel : ∀ r : ℕ,
      ∃ (ℰ : CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
        (triv : ∀ W : U₀.toScheme.Etale,
          let W_V := CategoryTheory.Limits.pullback
            ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom (π_sch r)
          ↑(ℰ.obj.obj (Opposite.op W)) →+
            LocallyConstant ↥W_V (Fin M → ZMod (ℓ ^ (r + 1)))),
        WeilIsEtaleSheafPullback (π_sch r) ℰ
          ((CategoryTheory.constantSheaf (V_sch r).smallEtaleTopology AddCommGrpCat.{u}).obj
            (A_grp r)) ∧
        (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
          let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
          let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
          let W₁_V := CategoryTheory.Limits.pullback h₁ (π_sch r)
          let W₂_V := CategoryTheory.Limits.pullback h₂ (π_sch r)
          ∀ (u_V : Quiver.Hom W₁_V W₂_V),
            CategoryTheory.CategoryStruct.comp u_V
                (CategoryTheory.Limits.pullback.fst h₂ (π_sch r)) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.fst h₁ (π_sch r))
                ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
            CategoryTheory.CategoryStruct.comp u_V
                (CategoryTheory.Limits.pullback.snd h₂ (π_sch r)) =
              CategoryTheory.Limits.pullback.snd h₁ (π_sch r) →
            ∀ (s : ↑(ℰ.obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_V),
              triv W₁ ((ℰ.obj.map (Opposite.op u)) s) y₁ =
                triv W₂ s (u_V.base y₁)) ∧
        (∀ W : U₀.toScheme.Etale,
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
          let W_V := CategoryTheory.Limits.pullback h_W (π_sch r)
          Function.Injective (triv W) ∧
          Set.range (triv W) =
            { f | ∀ (σ : B r ≃ₐ[R₀] B r) (m_σ : Quiver.Hom W_V W_V),
              CategoryTheory.CategoryStruct.comp m_σ
                  (CategoryTheory.Limits.pullback.fst h_W (π_sch r)) =
                CategoryTheory.Limits.pullback.fst h_W (π_sch r) →
              CategoryTheory.CategoryStruct.comp m_σ
                  (CategoryTheory.Limits.pullback.snd h_W (π_sch r)) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W (π_sch r))
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
              ∀ y : ↥W_V, f (m_σ.base y) = ((ρ r σ).val).mulVec (f y) }) := by
    intro r
    obtain ⟨hInj_r, m_r, equiv_r, e_r, hIdemp_r, hOrth_r, hSum_r, hEval_r, hAbsorb_r⟩ :=
      hAlgIdemp R₀ (B r) (RatFunc F) (L_fld r)
    obtain ⟨⟨hπ_et_r, hπ_surj_r⟩, _, hSheets_r⟩ :=
      weil_scheme_galois_torsor_clopen_sheets.{u} R₀ (B r) hInj_r m_r equiv_r e_r
        hIdemp_r hOrth_r hSum_r hEval_r hAbsorb_r U₀.toScheme e_U
    obtain ⟨hCont_r, hAdj_r⟩ := hPullAdjSite (V_sch r) U₀.toScheme (π_sch r)
    obtain ⟨hT_Vr, θ_Vr, hθ_bij_r, hθ_nat_r, hθ_unit_r⟩ :=
      hConstEquivSite (V_sch r) (A_grp r)
    exact weil_etale_galois_rep_sheaf_and_pullback_iso.{u} R₀ (B r) U₀.toScheme e_U
      hπ_et_r hπ_surj_r hSheets_r (hMemSite U₀.toScheme) (hMemSite (V_sch r))
      hCont_r hAdj_r M (ZMod (ℓ ^ (r + 1))) (ρ r) hT_Vr θ_Vr
      hθ_bij_r (@hθ_nat_r) hθ_unit_r
  let ℒ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u} :=
    fun r => Classical.choose (hLevel r)
  let triv : ∀ (r : ℕ) (W : U₀.toScheme.Etale),
      let W_V := CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom (π_sch r)
      ↑((ℒ₀ r).obj.obj (Opposite.op W)) →+
        LocallyConstant ↥W_V (Fin M → ZMod (ℓ ^ (r + 1))) :=
    fun r => Classical.choose (Classical.choose_spec (hLevel r))
  have hLevel_spec : ∀ r : ℕ,
      WeilIsEtaleSheafPullback (π_sch r) (ℒ₀ r)
        ((CategoryTheory.constantSheaf (V_sch r).smallEtaleTopology AddCommGrpCat.{u}).obj
          (A_grp r)) ∧
      (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
        let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
        let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
        let W₁_V := CategoryTheory.Limits.pullback h₁ (π_sch r)
        let W₂_V := CategoryTheory.Limits.pullback h₂ (π_sch r)
        ∀ (u_V : Quiver.Hom W₁_V W₂_V),
          CategoryTheory.CategoryStruct.comp u_V
              (CategoryTheory.Limits.pullback.fst h₂ (π_sch r)) =
