      · exact hChartPreirred u₀ w h0
      · exact hChartPreirred u₁ w h1
    let W_U := CategoryTheory.Limits.pullback h_W U₀.ι
    let j_W : W_U ⟶ W := CategoryTheory.Limits.pullback.fst h_W U₀.ι
    have : AlgebraicGeometry.IsOpenImmersion j_W :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback h_W U₀.ι).flip inferInstance
    have hj_open_emb : Topology.IsOpenEmbedding j_W.base := j_W.isOpenEmbedding
    have hDense : ∀ O : Set ↥W, IsOpen O → O.Nonempty → (O ∩ Set.range j_W.base).Nonempty := by
      intro O hO hOne
      have hImOpen : IsOpen (h_W.base '' O) := h_W.isOpenMap O hO
      have hImNe : (Set.univ ∩ (h_W.base '' O)).Nonempty := by
        rw [Set.univ_inter]; exact hOne.image h_W.base
      have hUOpen : IsOpen (Set.range U₀.ι.base) := U₀.ι.isOpenEmbedding.isOpen_range
      have hUNe : (Set.univ ∩ Set.range U₀.ι.base).Nonempty := by
        rw [Set.univ_inter]
        rcases hU₀_ne with ⟨u⟩
