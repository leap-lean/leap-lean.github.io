    obtain ⟨⟨_, hSurj_rel⟩, _, _⟩ :=
      weil_scheme_galois_torsor_clopen_sheets B B_V hInj_rel
        m_rel equiv_rel e_rel hIdemp_rel hOrth_rel hSum_rel hEval_rel hAbsorb_rel
        V_B_r (CategoryTheory.Iso.refl V_B_r)
    let p_jB : V_r ⟶ V_B_r := AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_B.toRingHom)
    have hSurj_jB : AlgebraicGeometry.Surjective p_jB := by
      change AlgebraicGeometry.Surjective
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B B_V)))
      have hid : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B B_V)) ≫
          (CategoryTheory.Iso.refl V_B_r).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B B_V)) :=
        CategoryTheory.Category.comp_id _
