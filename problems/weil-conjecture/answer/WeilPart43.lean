                  trivial
              have h_1 : (𝒥_h.obj.map u_p.op).hom t₁ = (𝒥_h.obj.map q_p.op).hom (s_Y c₁) :=
                hu_1 c₁ E_p u_p l_p q_p rfl rfl (fun e => e.2.1)
              have h_2 : (𝒥_h.obj.map u_p.op).hom t₂ = (𝒥_h.obj.map q_p.op).hom (s_Y c₂) :=
                hu_2 c₂ E_p u_p l_p q_p rfl rfl (fun e => e.2.2)
              have h_12 : (𝒥_h.obj.map u_p.op).hom (t₁ + t₂) =
                  (𝒥_h.obj.map q_p.op).hom (s_Y (c₁ + c₂)) :=
                hu_12 (c₁ + c₂) E_p u_p l_p q_p rfl rfl (fun e => by
                  rw [map_add, LocallyConstant.add_apply]
