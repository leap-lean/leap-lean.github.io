      have h0 := hZModShift D.c_iso _ hij
      change π_cast ((D.ρ_V r' σ').val i j - (1 : Matrix (Fin D.N) (Fin D.N) _) i j) = 0 at h0
      rw [map_sub] at h0
      rw [Matrix.map_apply, sub_eq_zero.mp h0]
      by_cases h : i = j <;> simp [Matrix.one_apply, h]
    have hρ1 : D.ρ_V r σ_r = D.ρ_V r 1 := by
