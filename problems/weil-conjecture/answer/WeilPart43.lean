              change q_inv (q_fwd (Submodule.Quotient.mk v)) = Submodule.Quotient.mk v
              simp [q_fwd, q_inv]
          right_inv := fun y => by
            induction y using Submodule.Quotient.induction_on with
            | _ w =>
              change q_fwd (q_inv (Submodule.Quotient.mk w)) = Submodule.Quotient.mk w
              simp [q_fwd, q_inv] }
      have he_quot_conj : e_quot.conj (Submodule.mapQ U_van U_van M_Zu_mid.frob hVan_inv) =
          Submodule.mapQ E_van E_van F_Q.mulVecLin hVan_F := by
        apply LinearMap.ext
        intro y
        induction y using Submodule.Quotient.induction_on with
        | _ w =>
          change q_fwd (Submodule.mapQ U_van U_van M_Zu_mid.frob hVan_inv
            (q_inv (Submodule.Quotient.mk w))) =
            Submodule.mapQ E_van E_van F_Q.mulVecLin hVan_F (Submodule.Quotient.mk w)
          simp only [q_fwd, q_inv, Submodule.mapQ_apply, LinearEquiv.coe_coe, D.hFVu_frob,
            D.e_V.apply_symm_apply, Matrix.mulVecLin_apply]
          rfl
      refine ⟨M, hM, J, G_geom, F_u, F_mat, Δ, ℒ₀, τ_ℒ, W_mid, U_rad, U_van, hU_le,
        hRad_inv, hVan_inv, hJ_skew, hJ_det, hG_sp, hΔ_ne, hΔ_nz, hΔ_span, hΔ_orb, hΔ_inv,
        hΔ_transv, hFu_norm, hFu_sim, hFmat_sim, ?_, hTowerInert, hγ'_mid⟩
      intro d P_poly hP hd hFact_P hFin_P hFin_P' M_ZP_mid k hk
      let _ : Fact (Irreducible P_poly) := hFact_P
      let _ : Finite (AdjoinRoot P_poly) := hFin_P'
      rw [D.hFVmat_trace d P_poly hP hd hFin_P M_ZP_mid k hk,
        hBlockTr hRad_F hVan_F d P_poly hP k hd hk,
        ← he_rad_conj, ← hConjPow e_rad (M_Zu_mid.frob.restrict hRad_inv) (d * k),
        LinearMap.trace_conj',
        ← he_quot_conj,
        ← hConjPow e_quot (Submodule.mapQ U_van U_van M_Zu_mid.frob hVan_inv) (d * k),
        LinearMap.trace_conj']

theorem weil_transv_singular_pencil_vanishing_devissage (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z₁.hom]
    [AlgebraicGeometry.IsProper Z₁.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z₁.hom]
    (P : WeilRationalLefschetzPencil F m Z₁)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (ι_disc : C_disc ⟶ weilProjectiveSpaceOver F 2)
    (U_disc_reg : C_disc.left.Opens)
    (hSing : WeilTransvTriIsSingularDatum F m Z₁ P j_aff s_inf S_aff U₀ C_disc ι_disc U_disc_reg)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (M_Ztilde : WeilEllAdicCohomologyModel F P.Z_tilde ℓ (2 * m + 2))
    (M_Zu : ∀ i : ℕ, WeilEllAdicCohomologyModel F P.Z_u₀ ℓ i)
    (γ' : AlgebraicClosure (Padic ℓ))
    (hγ' : γ' ∈ ((M_Ztilde.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ))) :
    γ' ^ 2 = ((Nat.card F : AlgebraicClosure (Padic ℓ)) ^ (m + 1)) ^ 2 ∨
    ((∃ α_low ∈ (((M_Zu (2 * m)).frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)),
        γ' = (Nat.card F : AlgebraicClosure (Padic ℓ)) * α_low) ∨
      γ' ∈ (((M_Zu (2 * m + 2)).frob).charpoly).aroots (AlgebraicClosure (Padic ℓ))) ∨
    ∃ (M : ℕ) (_ : 1 ≤ M)
      (J : Matrix (Fin M) (Fin M) (Padic ℓ))
      (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
      (F_u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ)
      (F_mat : ∀ (d : ℕ) (P_poly : Polynomial F),
        IsGoodAffineCurveClosedPointPoly S_aff d P_poly → Matrix (Fin M) (Fin M) (PadicInt ℓ))
      (Δ : Set (Fin M → Padic ℓ))
      (α_num β_den : List (AlgebraicClosure (Padic ℓ)))
      (ℒ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
      (τ_ℒ : ∀ r : ℕ, Quiver.Hom (ℒ₀ (r + 1)) (ℒ₀ r))
      (W_mid : WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ 1
        (fun r => weilEtaleHigherDirectImage U₀.ι 0 (ℒ₀ r))
        (fun r => weilEtaleHigherDirectImageMap U₀.ι 0 (τ_ℒ r))),
      J.transpose = -J ∧
      J.det ≠ 0 ∧
      (∀ g ∈ G_geom,
        ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
          ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = J) ∧
      Δ.Nonempty ∧
      (∀ v ∈ Δ, v ≠ 0) ∧
      Submodule.span (Padic ℓ) Δ = ⊤ ∧
      (∀ v₁ ∈ Δ, ∀ v₂ ∈ Δ, ∃ h ∈ G_geom,
        ((h.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec v₁ = v₂) ∧
      (∀ g ∈ G_geom, ∀ v ∈ Δ,
        ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec v ∈ Δ) ∧
      (∀ v ∈ Δ, ∀ t : PadicInt ℓ,
        ∃ g ∈ G_geom,
          ∀ x : Fin M → Padic ℓ,
            ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
              x + ((t : Padic ℓ) * dotProduct x (J.mulVec v)) • v) ∧
      (∀ (k : ℕ) (g : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ), g ∈ G_geom →
        ∃ h ∈ Subgroup.closure
          { u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ |
            u ∈ G_geom ∧ ∃ v ∈ Δ, ∃ c : Padic ℓ,
              ∀ x : Fin M → Padic ℓ,
                ((u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
                  x + (c * dotProduct x (J.mulVec v)) • v },
          (h.val).map (PadicInt.toZModPow k) = (g.val).map (PadicInt.toZModPow k)) ∧
      (∀ g ∈ G_geom, F_u * g * F_u⁻¹ ∈ G_geom) ∧
      (((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
        ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) =
          ((Nat.card F : Padic ℓ) ^ (2 * m + 1)) • J) ∧
      (∀ (d : ℕ) (P_poly : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly),
        ((F_mat d P_poly hP).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
          ((F_mat d P_poly hP).map (algebraMap (PadicInt ℓ) (Padic ℓ))) =
            ((Nat.card F : Padic ℓ) ^ ((2 * m + 1) * d)) • J) ∧
      (∀ α ∈ α_num, ∃ i ≤ 2 * (2 * m + 1),
        α ∈ (((M_Zu i).frob).charpoly).aroots (AlgebraicClosure (Padic ℓ))) ∧
      (∀ β ∈ β_den, ∃ i ≤ 2 * (2 * m + 1),
        β ∈ (((M_Zu i).frob).charpoly).aroots (AlgebraicClosure (Padic ℓ))) ∧
      (∀ (d : ℕ) (P_poly : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly),
        1 ≤ d →
        let _ : Fact (Irreducible P_poly) := ⟨hP.2.1⟩
        ∀ (hFin_P : Finite (AdjoinRoot P_poly)),
          let _ : Finite (AdjoinRoot P_poly) := hFin_P
          ∀ (M_ZP : ∀ i : ℕ, WeilEllAdicCohomologyModel (AdjoinRoot P_poly)
              (weilTransvTriClosedPointFiber F P.f₀ j_aff P_poly) ℓ i)
            (k : ℕ),
            1 ≤ k →
            algebraMap (Padic ℓ) (AlgebraicClosure (Padic ℓ))
              (∑ i ∈ Finset.Iic (2 * (2 * m + 1)),
                (-1) ^ i * LinearMap.trace (Padic ℓ) (M_ZP i).V ((M_ZP i).frob ^ k)) =
              ((β_den.map (· ^ d)).map (· ^ k)).sum -
                ((α_num.map (· ^ d)).map (· ^ k)).sum -
                Matrix.trace
                  (((F_mat d P_poly hP).map
                    (algebraMap (PadicInt ℓ) (AlgebraicClosure (Padic ℓ)))) ^ k)) ∧
      WeilTransvTriCurveSymplecticTower.{u} F S_aff j_aff U₀ P.u₀ ℓ M G_geom F_u F_mat ℒ₀ τ_ℒ ∧
      γ' ∈ ((W_mid.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)) :=
by
  classical
  let K := Padic ℓ
  let L := AlgebraicClosure (Padic ℓ)
  let _ : AlgebraicGeometry.GeometricallyIrreducible P.Z_tilde.hom := P.hGeom_Ztilde
  let _ : AlgebraicGeometry.IsProper P.Z_tilde.hom := P.hProp_Ztilde
  let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) P.Z_tilde.hom := P.hSm_Ztilde
  let _ : AlgebraicGeometry.Flat P.f₀.left := P.hFlat_f₀
  let _ : AlgebraicGeometry.IsProper P.f₀.left := P.hProp_f₀
  let _ : AlgebraicGeometry.Surjective P.f₀.left := P.hSurj_f₀
  let _ : AlgebraicGeometry.GeometricallyIrreducible P.Z_u₀.hom := P.hGeom_Zu₀
  let _ : AlgebraicGeometry.IsProper P.Z_u₀.hom := P.hProp_Zu₀
  let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) P.Z_u₀.hom := P.hSm_Zu₀

  
  have hSing' := hSing
  obtain ⟨hj_open, hj_hom, hsinf_sec, hsinf_compl, hU₀_eq, hu₀_mem, hSm_U₀,
    _, _, _, _, _, _, _, _, hx_inf, hx_aff, _⟩ := hSing'
  have h1d : WeilSingDevIs1dPencilOdpDatum F m P.Z_tilde P.f₀ P.u₀ j_aff s_inf S_aff U₀ :=
    ⟨hj_open, hj_hom, hsinf_sec, hsinf_compl, hU₀_eq, hu₀_mem, hSm_U₀, hx_inf, hx_aff⟩

  
  obtain ⟨E2_2, E2_1, E2_0, hLeray⟩ :=
    weil_sing_dev_p1_leray_eigenvalue_trichotomy F m P.Z_tilde P.f₀ ℓ hℓ M_Ztilde γ' hγ'
  obtain ⟨hOuter2, hOuter0⟩ :=
    weil_sing_dev_outer_leray_milnor_specialization F m P.Z_tilde P.hProj_Ztilde P.f₀
      P.hFibIrred_f₀ P.u₀ P.hu₀_sec P.Z_u₀ P.hProj_Zu₀ P.ι_Zu₀ P.hPb_Zu₀
      j_aff s_inf S_aff U₀ h1d ℓ hℓ (M_Zu (2 * m)) (M_Zu (2 * m + 2)) E2_2 E2_0 γ'
  rcases hLeray with hγ'_2 | hγ'_1 | hγ'_0
  · exact Or.inr (Or.inl (Or.inl (hOuter2 hγ'_2)))
  · 
    rcases weil_sing_dev_middle_degree_symplectic_devissage F m Z₁ P j_aff s_inf S_aff U₀
        C_disc ι_disc U_disc_reg hSing ℓ hℓ (M_Zu (2 * m + 1)) E2_1 γ' hγ'_1 with
      hSq | ⟨M, hM, J, G_geom, F_u, F_mat, Δ, ℒ₀, τ_ℒ, W_mid, U_rad, U_van,
        hU_le, hRad_inv, hVan_inv, hJ_skew, hJ_det, hG_sp, hΔ_ne, hΔ_nz, hΔ_span,
        hΔ_orb, hΔ_inv, hΔ_transv, hFu_norm, hFu_sim, hF_sim, hMidTr, hTowerInert, hγ'_mid⟩
    · exact Or.inl hSq
    · right; right
      
      let S_gen : Set ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ) :=
        { u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ |
          u ∈ G_geom ∧ ∃ v ∈ Δ, ∃ c : Padic ℓ,
            ∀ x : Fin M → Padic ℓ,
              ((u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
                x + (c * dotProduct x (J.mulVec v)) • v }
      let H_Δ := Subgroup.closure S_gen
      have hH_le : H_Δ ≤ G_geom := (Subgroup.closure_le G_geom).mpr (fun _ hu => hu.1)
      have hS_conj : ∀ g ∈ G_geom, ∀ u ∈ S_gen, g * u * g⁻¹ ∈ S_gen := by
        intro g hg u ⟨hu_G, v, hv, c, hu_act⟩
        let ι := algebraMap (PadicInt ℓ) (Padic ℓ)
        let G := (g.val).map ι
        let G_inv := ((g⁻¹).val).map ι
        let U_mat := (u.val).map ι
        have hGG_inv : G * G_inv = 1 := by
          dsimp [G, G_inv]
          rw [← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply, ← map_mul, Units.mul_inv,
            map_one]
        refine ⟨G_geom.mul_mem (G_geom.mul_mem hg hu_G) (G_geom.inv_mem hg),
          G.mulVec v, hΔ_inv g hg v hv, c, fun x => ?_⟩
        set y := G_inv.mulVec x
        have hGy : G.mulVec y = x := by
          dsimp [y]
          rw [Matrix.mulVec_mulVec, hGG_inv, Matrix.one_mulVec]
        have hdot : dotProduct y (J.mulVec v) = dotProduct x (J.mulVec (G.mulVec v)) := by
          have hsp := hG_sp g hg
          calc dotProduct y (J.mulVec v)
              = dotProduct y ((G.transpose * J * G).mulVec v) := by rw [hsp]
            _ = dotProduct y (G.transpose.mulVec ((J * G).mulVec v)) := by
                rw [Matrix.mul_assoc, Matrix.mulVec_mulVec]
            _ = dotProduct (Matrix.vecMul y G.transpose) ((J * G).mulVec v) := by
                rw [Matrix.dotProduct_mulVec]
            _ = dotProduct (G.mulVec y) ((J * G).mulVec v) := by
                rw [← Matrix.mulVec_transpose, Matrix.transpose_transpose]
            _ = dotProduct x (J.mulVec (G.mulVec v)) := by
                rw [hGy, Matrix.mulVec_mulVec]
        have hmul_map : ((g * u * g⁻¹).val).map ι = G * U_mat * G_inv := by
          dsimp [G, U_mat, G_inv]
          simp only [← RingHom.mapMatrix_apply, map_mul]
        rw [hmul_map, Matrix.mul_assoc, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
        change G.mulVec (U_mat.mulVec y) = _
        rw [hu_act y, Matrix.mulVec_add, Matrix.mulVec_smul, hGy, hdot]
      have hH_norm : ∀ g ∈ G_geom, ∀ h ∈ H_Δ, g * h * g⁻¹ ∈ H_Δ := by
        intro g hg h hh
        induction hh using Subgroup.closure_induction with
        | mem u hu => exact Subgroup.subset_closure (hS_conj g hg u hu)
        | one => simp [H_Δ.one_mem]
        | mul a b _ _ iha ihb =>
          have heq : g * (a * b) * g⁻¹ = (g * a * g⁻¹) * (g * b * g⁻¹) := by group
          rw [heq]
          exact H_Δ.mul_mem iha ihb
        | inv a _ iha =>
          have heq : g * a⁻¹ * g⁻¹ = (g * a * g⁻¹)⁻¹ := by group
          rw [heq]
          exact H_Δ.inv_mem iha
      obtain ⟨a₀, ha₀, B, L_fld, hCR, hDom, hFld, hAF_B, hAP_B, hAR_B,
        hAF_L, hAP_L, hARF_L, hABL, hARL, hST1, hST2, hST3, hST4, hST5, hST6,
        hFin_B, hEt_B, hFrac, hIntCl, hFD_L, hGal_L, ρ, ι_B, e_U,
        hu₀_eq, heU_eq, hρ_inj, hG_surj, hG_mem, hι_compat, hQ_u, hQ_P, hTriv, hInert⟩ :=
        hTowerInert
      have hTower :
          WeilTransvTriCurveSymplecticTower.{u} F S_aff j_aff U₀ P.u₀ ℓ M G_geom F_u F_mat ℒ₀ τ_ℒ :=
        ⟨a₀, ha₀, B, L_fld, hCR, hDom, hFld, hAF_B, hAP_B, hAR_B,
          hAF_L, hAP_L, hARF_L, hABL, hARL, hST1, hST2, hST3, hST4, hST5, hST6,
          hFin_B, hEt_B, hFrac, hIntCl, hFD_L, hGal_L, ρ, ι_B, e_U,
          hu₀_eq, heU_eq, hρ_inj, hG_surj, hG_mem, hι_compat, hQ_u, hQ_P, hTriv⟩
      have hDense : ∀ (k : ℕ) (g : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ), g ∈ G_geom →
          ∃ h ∈ H_Δ, (h.val).map (PadicInt.toZModPow k) = (g.val).map (PadicInt.toZModPow k) := by
        intro k g hg
        cases k with
        | zero =>
          have : Subsingleton (ZMod (ℓ ^ 0)) := by
            rw [pow_zero]
            infer_instance
          refine ⟨1, H_Δ.one_mem, ?_⟩
          ext i j
          exact Subsingleton.elim _ _
        | succ r =>
          let _ := hCR r
          let _ := hDom r
          let _ := hFld r
          let _ := hAF_B r
          let _ := hAP_B r
          let _ := hAR_B r
          let _ := hAF_L r
          let _ := hAP_L r
          let _ := hARF_L r
          let _ := hABL r
          let _ := hARL r
          let _ := hST1 r
          let _ := hST2 r
          let _ := hST3 r
          let _ := hST4 r
          let _ := hST5 r
          let _ := hST6 r
          let _ := hFin_B r
          let _ := hEt_B r
          let _ := hFrac r
          let _ := hIntCl r
          let _ := hFD_L r
          let _ := hGal_L r
          obtain ⟨hInert_aff, hInert_inf⟩ := hInert r
          refine weil_sing_dev_p1_unramified_galois_inertia_density F S_aff ℓ M r hℓ hM
            G_geom H_Δ hH_le hH_norm (B r) (L_fld r) (ρ r) (hρ_inj r)
            (fun g' hg' => hG_surj r g' hg')
            (fun σ hσ => hG_mem r σ hσ) ⟨?_, ?_⟩ g hg
          · intro a ha Q hQ hQ_comap σ_L σ_B hσ_int hσ_ext hσ_inert
            obtain ⟨u, hu, hu_eq⟩ :=
              hInert_aff a ha Q hQ hQ_comap σ_L σ_B hσ_int hσ_ext hσ_inert
            exact ⟨u, Subgroup.subset_closure hu, hu_eq⟩
          · intro Q_inf hQ_inf hQ_comap σ_L σ_B hσ_int hσ_ext hσ_inert
            obtain ⟨u, hu, hu_eq⟩ :=
              hInert_inf Q_inf hQ_inf hQ_comap σ_L σ_B hσ_int hσ_ext hσ_inert
            exact ⟨u, Subgroup.subset_closure hu, hu_eq⟩

      
      have h_sub_quot_charpoly : ∀ (W : Type u) [AddCommGroup W] [Module K W] [Module.Finite K W]
          (Φ : W →ₗ[K] W) (U : Submodule K W)
          (hU_inv : ∀ x ∈ U, Φ x ∈ U)
          (hU_comap : U ≤ Submodule.comap Φ U),
          (Φ.restrict hU_inv).charpoly * (Submodule.mapQ U U Φ hU_comap).charpoly =
            Φ.charpoly := by
        intro W _ _ _ Φ U hU_inv hU_comap
        obtain ⟨C, hCompl⟩ := Submodule.exists_isCompl U
        let e : (↥U × ↥C) ≃ₗ[K] W := Submodule.prodEquivOfIsCompl U C hCompl
        let q_C : (W ⧸ U) ≃ₗ[K] ↥C := Submodule.quotientEquivOfIsCompl U C hCompl
        let Ψ : (↥U × ↥C) →ₗ[K] (↥U × ↥C) := e.symm.conj Φ
        have hchar_Ψ : Ψ.charpoly = Φ.charpoly := LinearEquiv.charpoly_conj e.symm Φ
        let b₁ := Module.finBasis K ↥U
        let b₂ := Module.finBasis K ↥C
        let b := b₁.prod b₂
        let A := LinearMap.toMatrix b b Ψ
        have hchar_A : A.charpoly = Ψ.charpoly := LinearMap.charpoly_toMatrix Ψ b
        let f_U : ↥U →ₗ[K] ↥U := Φ.restrict hU_inv
        let f_Q : (W ⧸ U) →ₗ[K] (W ⧸ U) := Submodule.mapQ U U Φ hU_comap
        let f_C : ↥C →ₗ[K] ↥C := q_C.conj f_Q
        have hΨ_left : ∀ u : ↥U, Ψ (u, 0) = (f_U u, 0) := by
          intro u
          change e.symm (Φ (e (u, 0))) = (f_U u, 0)
          have he : e (u, 0) = u.1 := by
            rw [Submodule.coe_prodEquivOfIsCompl']
            simp
          rw [he]
          have hΦu : Φ u.1 = (f_U u).1 := rfl
          rw [hΦu]
          exact Submodule.prodEquivOfIsCompl_symm_apply_left U C hCompl (f_U u)
        have hΨ_right_snd : ∀ c : ↥C, (Ψ (0, c)).2 = f_C c := by
          intro c
          set p := Ψ (0, c)
          have hp : e p = Φ c.1 := by
            dsimp [p, Ψ, LinearEquiv.conj_apply]
            have hec : e (0, c) = c.1 := by
              rw [Submodule.coe_prodEquivOfIsCompl']
              simp
            rw [hec, e.apply_symm_apply]
          have hep : (p.1 : W) + (p.2 : W) = Φ c.1 := by
            rw [← Submodule.coe_prodEquivOfIsCompl' U C hCompl p]
            exact hp
          have hmk_c : q_C.symm c = Submodule.Quotient.mk c.1 := by
            apply q_C.injective
            rw [q_C.apply_symm_apply, Submodule.quotientEquivOfIsCompl_apply_mk_right]
          change p.2 = q_C (f_Q (q_C.symm c))
          rw [hmk_c]
          change p.2 = q_C (Submodule.Quotient.mk (Φ c.1))
          have hp1_zero : (Submodule.Quotient.mk (p.1 : W) : W ⧸ U) = 0 :=
            (Submodule.Quotient.mk_eq_zero U).mpr p.1.2
          rw [← hep, Submodule.Quotient.mk_add, hp1_zero, zero_add,
            Submodule.quotientEquivOfIsCompl_apply_mk_right]
        let A₁₁ := LinearMap.toMatrix b₁ b₁ f_U
        let A₁₂ := Matrix.of fun i j => A (Sum.inl i) (Sum.inr j)
        let A₂₂ := LinearMap.toMatrix b₂ b₂ f_C
        have hA_blocks : A = Matrix.fromBlocks A₁₁ A₁₂ 0 A₂₂ := by
          ext i j
          cases i with
          | inl i₁ =>
            cases j with
            | inl j₁ =>
              simp only [Matrix.fromBlocks_apply₁₁, A, A₁₁, LinearMap.toMatrix_apply, b,
                Module.Basis.prod_apply, Sum.elim_inl, Function.comp_apply, LinearMap.coe_inl,
                hΨ_left, Module.Basis.prod_repr_inl]
            | inr j₂ =>
              rfl
          | inr i₂ =>
            cases j with
            | inl j₁ =>
              simp only [Matrix.fromBlocks_apply₂₁, Matrix.zero_apply, A, LinearMap.toMatrix_apply,
                b, Module.Basis.prod_apply, Sum.elim_inl, Function.comp_apply, LinearMap.coe_inl,
                hΨ_left, Module.Basis.prod_repr_inr, map_zero, Finsupp.zero_apply]
            | inr j₂ =>
              simp only [Matrix.fromBlocks_apply₂₂, A, A₂₂, LinearMap.toMatrix_apply, b,
                Module.Basis.prod_apply, Sum.elim_inr, Function.comp_apply, LinearMap.coe_inr,
                Module.Basis.prod_repr_inr, hΨ_right_snd]
        have hchar_blocks : A.charpoly = A₁₁.charpoly * A₂₂.charpoly := by
          rw [hA_blocks, Matrix.charpoly_fromBlocks_zero₂₁]
        have hchar_11 : A₁₁.charpoly = f_U.charpoly := LinearMap.charpoly_toMatrix f_U b₁
        have hchar_22 : A₂₂.charpoly = f_Q.charpoly :=
          (LinearMap.charpoly_toMatrix f_C b₂).trans (LinearEquiv.charpoly_conj q_C f_Q)
        rw [← hchar_11, ← hchar_22, ← hchar_blocks, hchar_A, hchar_Ψ]

      let Φ_mid := (M_Zu (2 * m + 1)).frob
      let f_rad := Φ_mid.restrict hRad_inv
      let f_quot := Submodule.mapQ U_van U_van Φ_mid hVan_inv
      have hRadQuot_dvd : f_rad.charpoly ∣ Φ_mid.charpoly ∧ f_quot.charpoly ∣ Φ_mid.charpoly := by
        have hVan_inv' : ∀ x ∈ U_van, Φ_mid x ∈ U_van := fun x hx => hVan_inv hx
        have h1 := h_sub_quot_charpoly (M_Zu (2 * m + 1)).V Φ_mid U_van hVan_inv' hVan_inv
        have hdvd_quot : f_quot.charpoly ∣ Φ_mid.charpoly :=
          ⟨(Φ_mid.restrict hVan_inv').charpoly, by rw [← h1, mul_comm]⟩
        have hdvd_van : (Φ_mid.restrict hVan_inv').charpoly ∣ Φ_mid.charpoly :=
          ⟨f_quot.charpoly, h1.symm⟩
        let Φ_van : ↥U_van →ₗ[K] ↥U_van := Φ_mid.restrict hVan_inv'
        let U_rad' : Submodule K ↥U_van := U_rad.comap U_van.subtype
        have hRad'_inv : ∀ y ∈ U_rad', Φ_van y ∈ U_rad' := fun y hy => hRad_inv y.1 hy
        have h2 := h_sub_quot_charpoly ↥U_van Φ_van U_rad' hRad'_inv hRad'_inv
        have hdvd_rad' : (Φ_van.restrict hRad'_inv).charpoly ∣ Φ_van.charpoly := ⟨_, h2.symm⟩
        let e_rad : ↥U_rad ≃ₗ[K] ↥U_rad' :=
          { toFun := fun x => ⟨⟨x.1, hU_le x.2⟩, x.2⟩
            invFun := fun y => ⟨y.1.1, y.2⟩
            left_inv := fun _ => rfl
            right_inv := fun _ => rfl
            map_add' := fun _ _ => rfl
            map_smul' := fun _ _ => rfl }
        have hconj : e_rad.conj f_rad = Φ_van.restrict hRad'_inv := by
          ext x
          rfl
        have hchar_rad : f_rad.charpoly = (Φ_van.restrict hRad'_inv).charpoly := by
          rw [← hconj, LinearEquiv.charpoly_conj]
        rw [hchar_rad]
        exact ⟨dvd_trans hdvd_rad' hdvd_van, hdvd_quot⟩
      have h_aroots_of_dvd : ∀ {p q : Polynomial K},
          q.Monic → p ∣ q → ∀ {α : L}, α ∈ p.aroots L → α ∈ q.aroots L := by
        intro p q hq hdvd α hα
        rcases hdvd with ⟨r, rfl⟩
        have hp_ne : p ≠ 0 := left_ne_zero_of_mul hq.ne_zero
        have hp_map_ne : p.map (algebraMap K L) ≠ 0 := Polynomial.map_ne_zero hp_ne
        have hpr_map_ne : (p * r).map (algebraMap K L) ≠ 0 := (hq.map (algebraMap K L)).ne_zero
        rw [Polynomial.aroots_def, Polynomial.mem_roots hp_map_ne] at hα
        rw [Polynomial.aroots_def, Polynomial.mem_roots hpr_map_ne, Polynomial.IsRoot.def,
          Polynomial.map_mul, Polynomial.eval_mul, hα.eq_zero, zero_mul]

      
      let β_den : List L :=
        (List.range (2 * m + 2)).flatMap (fun j => (((M_Zu (2 * j)).frob).charpoly.aroots L).toList)
      let α_num : List L :=
        ((List.range (2 * m + 1)).filter (· ≠ m)).flatMap
            (fun j => (((M_Zu (2 * j + 1)).frob).charpoly.aroots L).toList) ++
          (f_rad.charpoly.aroots L).toList ++
          (f_quot.charpoly.aroots L).toList
      have hα_mem : ∀ α ∈ α_num, ∃ i ≤ 2 * (2 * m + 1),
          α ∈ (((M_Zu i).frob).charpoly).aroots L := by
        intro α hα
        simp only [α_num, List.mem_append, List.mem_flatMap, List.mem_filter, List.mem_range,
          decide_eq_true_eq, Multiset.mem_toList] at hα
        rcases hα with (⟨j, ⟨hj_lt, _⟩, hα_j⟩ | hα_rad) | hα_quot
        · exact ⟨2 * j + 1, by omega, hα_j⟩
        · exact ⟨2 * m + 1, by omega,
            h_aroots_of_dvd (LinearMap.charpoly_monic Φ_mid) hRadQuot_dvd.1 hα_rad⟩
        · exact ⟨2 * m + 1, by omega,
            h_aroots_of_dvd (LinearMap.charpoly_monic Φ_mid) hRadQuot_dvd.2 hα_quot⟩
      have hβ_mem : ∀ β ∈ β_den, ∃ i ≤ 2 * (2 * m + 1),
          β ∈ (((M_Zu i).frob).charpoly).aroots L := by
        intro β hβ
        simp only [β_den, List.mem_flatMap, List.mem_range, Multiset.mem_toList] at hβ
        rcases hβ with ⟨j, hj_lt, hβ_j⟩
        exact ⟨2 * j, by omega, hβ_j⟩

      
      have h_mat_trace_algClosed : ∀ (n : ℕ) (C : Matrix (Fin n) (Fin n) L) (s : ℕ),
          Matrix.trace (C ^ s) = ((C.charpoly.roots).map (· ^ s)).sum := by
        intro n C s
        let T : Module.End L (Fin n → L) := Matrix.toLin' C
        have htr_eq : Matrix.trace (C ^ s) = LinearMap.trace L (Fin n → L) (T ^ s) := by
          rw [LinearMap.trace_eq_matrix_trace L (Pi.basisFun L (Fin n)) (T ^ s)]
          have hmat :
              LinearMap.toMatrix (Pi.basisFun L (Fin n)) (Pi.basisFun L (Fin n)) (T ^ s) = C ^ s := by
            change Matrix.toLin'.symm (T ^ s) = C ^ s
            rw [← Matrix.toLin'_pow]
            exact Matrix.toLin'.symm_apply_apply (C ^ s)
          rw [hmat]
        have hchar_T : T.charpoly = C.charpoly := Matrix.charpoly_toLin' C
        rw [htr_eq, ← hchar_T]
        have hInt : DirectSum.IsInternal T.maxGenEigenspace :=
          DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
            (Module.End.independent_maxGenEigenspace T)
            (Module.End.iSup_maxGenEigenspace_eq_top T)
        have hrk : ∀ μ : L, Module.finrank L ↥(T.maxGenEigenspace μ) =
            Multiset.count μ (T.charpoly.roots) := by
          intro μ
          rw [LinearMap.finrank_maxGenEigenspace_eq T μ, Polynomial.count_roots]
        have hmem_supp : ∀ μ : L, T.maxGenEigenspace μ ≠ ⊥ ↔ μ ∈ (T.charpoly.roots).toFinset := by
          intro μ
          rw [ne_eq, ← Submodule.finrank_eq_zero, ← ne_eq, ← Nat.pos_iff_ne_zero, hrk μ,
            Multiset.count_pos, Multiset.mem_toFinset]
        have hSupp : {μ : L | T.maxGenEigenspace μ ≠ ⊥} = ↑((T.charpoly.roots).toFinset) := by
          ext μ
          exact (hmem_supp μ).trans Finset.mem_coe.symm
        have hFin_supp : {μ : L | T.maxGenEigenspace μ ≠ ⊥}.Finite := by
          rw [hSupp]
          exact Finset.finite_toSet _
        have hFin_eq : hFin_supp.toFinset = (T.charpoly.roots).toFinset := by
          ext μ
          exact hFin_supp.mem_toFinset.trans (hmem_supp μ)
        have hf1 : ∀ μ : L, Set.MapsTo T (T.maxGenEigenspace μ) (T.maxGenEigenspace μ) :=
          fun μ => Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.refl T) μ
        have hfs : ∀ μ : L, Set.MapsTo (T ^ s) (T.maxGenEigenspace μ) (T.maxGenEigenspace μ) :=
          fun μ => Module.End.mapsTo_maxGenEigenspace_of_comm ((Commute.refl T).pow_right s) μ
        rw [LinearMap.trace_eq_sum_trace_restrict' hInt hFin_supp hfs, hFin_eq,
          Finset.sum_multiset_map_count (T.charpoly.roots) (· ^ s)]
        refine Finset.sum_congr rfl fun μ _ => ?_
        let T_μ : Module.End L ↥(T.maxGenEigenspace μ) := T.restrict (fun x hx => hf1 μ hx)
        have hrestrict_pow : (T ^ s).restrict (hfs μ) = T_μ ^ s := by
          have haux : ∀ (k : ℕ) (hk : Set.MapsTo (T ^ k) (T.maxGenEigenspace μ) (T.maxGenEigenspace μ)),
              (T ^ k).restrict hk = T_μ ^ k := by
            intro k
            induction k with
            | zero =>
              intro hk
              apply LinearMap.ext; intro x; apply Subtype.ext; rfl
            | succ k ih =>
              intro hk
              have hk' : Set.MapsTo (T ^ k) (T.maxGenEigenspace μ) (T.maxGenEigenspace μ) :=
                Module.End.mapsTo_maxGenEigenspace_of_comm ((Commute.refl T).pow_right k) μ
              apply LinearMap.ext; intro x; apply Subtype.ext
              have hx : (T ^ k) x.1 = ((T_μ ^ k) x).1 :=
                congrArg Subtype.val (LinearMap.congr_fun (ih hk') x)
              change (T ^ (k + 1)) x.1 = ((T_μ ^ (k + 1)) x).1
              rw [pow_succ', pow_succ', Module.End.mul_eq_comp, Module.End.mul_eq_comp,
                LinearMap.comp_apply, LinearMap.comp_apply]
              change T ((T ^ k) x.1) = T ((T_μ ^ k) x).1
              rw [hx]
          exact haux s (hfs μ)
        rw [hrestrict_pow]
        let id_μ : Module.End L ↥(T.maxGenEigenspace μ) := 1
        let id_n : Module.End L (Fin n → L) := 1
        let ν : Module.End L ↥(T.maxGenEigenspace μ) := T_μ - μ • id_μ
        have hν_pow : ∀ (k : ℕ) (x : ↥(T.maxGenEigenspace μ)),
            ((ν ^ k) x).1 = (((T - μ • id_n) ^ k) x.1) := by
          intro k
          induction k with
          | zero => intro x; rfl
          | succ k ih =>
            intro x
            rw [pow_succ', pow_succ', Module.End.mul_eq_comp, Module.End.mul_eq_comp,
              LinearMap.comp_apply, LinearMap.comp_apply]
            change T ((ν ^ k) x).1 - μ • ((ν ^ k) x).1 =
              T (((T - μ • id_n) ^ k) x.1) - μ • (((T - μ • id_n) ^ k) x.1)
            rw [ih x]
        have hNil : IsNilpotent ν := by
          refine ⟨Module.finrank L (Fin n → L), ?_⟩
          apply LinearMap.ext; intro x; apply Subtype.ext
          have hx_mem : x.1 ∈ (T.genEigenspace μ) ↑(Module.finrank L (Fin n → L)) := by
            rw [← Module.End.maxGenEigenspace_eq_genEigenspace_finrank T μ]
            exact x.2
          have hx_ker : ((T - μ • id_n) ^ Module.finrank L (Fin n → L)) x.1 = 0 :=
            LinearMap.mem_ker.mp (Module.End.mem_genEigenspace_nat.mp hx_mem)
          simp only [LinearMap.zero_apply, Submodule.coe_zero]
          exact (hν_pow (Module.finrank L (Fin n → L)) x).trans hx_ker
        have hT_eq : T_μ = ν + μ • id_μ := (sub_add_cancel T_μ (μ • id_μ)).symm
        have hComm : Commute ν (μ • id_μ) := (Commute.one_right ν).smul_right μ
        rw [hT_eq, hComm.add_pow s, Finset.sum_range_succ', map_add, map_sum]
        have hsum_zero : ∑ k ∈ Finset.range s,
            LinearMap.trace L ↥(T.maxGenEigenspace μ)
              (ν ^ (k + 1) * (μ • id_μ) ^ (s - (k + 1)) * ↑(s.choose (k + 1))) = 0 := by
          refine Finset.sum_eq_zero fun k _ => ?_
          set g_k : Module.End L ↥(T.maxGenEigenspace μ) :=
            (μ • id_μ) ^ (s - (k + 1)) * ↑(s.choose (k + 1))
          have hcomm_gk : Commute (ν ^ (k + 1)) g_k :=
            ((hComm.pow_left (k + 1)).pow_right (s - (k + 1))).mul_right
              (Nat.commute_cast (ν ^ (k + 1)) (s.choose (k + 1)))
          have hnil_prod : IsNilpotent (ν ^ (k + 1) * g_k) :=
            hcomm_gk.isNilpotent_mul_right (IsNilpotent.pow_succ k hNil)
          rw [mul_assoc]
          exact isNilpotent_iff_eq_zero.mp (LinearMap.isNilpotent_trace_of_isNilpotent hnil_prod)
        rw [hsum_zero, zero_add, pow_zero, one_mul, Nat.choose_zero_right, Nat.cast_one, mul_one]
        change LinearMap.trace L ↥(T.maxGenEigenspace μ)
          ((μ • (1 : Module.End L ↥(T.maxGenEigenspace μ))) ^ s) = _
        rw [smul_pow, one_pow, map_smul, LinearMap.trace_one, hrk μ, smul_eq_mul, nsmul_eq_mul,
          mul_comm]

      have h_lin_trace_aroots : ∀ (W : Type u) [AddCommGroup W] [Module K W] [Module.Finite K W]
          (Φ : W →ₗ[K] W) (d k : ℕ),
          algebraMap K L (LinearMap.trace K W (Φ ^ (d * k))) =
            ((((Φ.charpoly.aroots L).toList).map (· ^ d)).map (· ^ k)).sum := by
        intro W _ _ _ Φ d k
        let n := Module.finrank K W
        let b : Module.Basis (Fin n) K W := Module.finBasis K W
        let C₀ : Matrix (Fin n) (Fin n) K := LinearMap.toMatrix b b Φ
        let C : Matrix (Fin n) (Fin n) L := C₀.map (algebraMap K L)
        have hpow_mat : ∀ s : ℕ, LinearMap.toMatrix b b (Φ ^ s) = C₀ ^ s := by
          intro s
          induction s with
          | zero => exact LinearMap.toMatrix_one b
          | succ s ih =>
            rw [pow_succ, pow_succ, Module.End.mul_eq_comp, LinearMap.toMatrix_comp b b b, ih]
        have htr1 : LinearMap.trace K W (Φ ^ (d * k)) = Matrix.trace (C₀ ^ (d * k)) := by
          rw [LinearMap.trace_eq_matrix_trace K b (Φ ^ (d * k)), hpow_mat]
        have htr2 : algebraMap K L (Matrix.trace (C₀ ^ (d * k))) = Matrix.trace (C ^ (d * k)) := by
          have h1 : algebraMap K L (Matrix.trace (C₀ ^ (d * k))) =
              Matrix.trace ((C₀ ^ (d * k)).map (algebraMap K L)) := by
            simp only [Matrix.trace, Matrix.diag, Matrix.map_apply, map_sum]
          have h2 : (C₀ ^ (d * k)).map (algebraMap K L) = C ^ (d * k) :=
            (RingHom.mapMatrix (algebraMap K L)).map_pow C₀ (d * k)
          rw [h1, h2]
        have hchar : C.charpoly = Φ.charpoly.map (algebraMap K L) := by
          dsimp [C, C₀]
          rw [Matrix.charpoly_map, LinearMap.charpoly_toMatrix Φ b]
        rw [htr1, htr2, h_mat_trace_algClosed n C (d * k), hchar, ← Polynomial.aroots_def]
        set M_roots := Φ.charpoly.aroots L
        rw [List.map_map]
        have hfun : ((· ^ k) ∘ (· ^ d) : L → L) = (· ^ (d * k)) := by
          ext x
          simp [pow_mul]
        rw [hfun, ← Multiset.sum_coe, ← Multiset.map_coe, Multiset.coe_toList]

      
      have h_list_flatMap_pow_sum : ∀ (l : List ℕ) (g : ℕ → List L) (d k : ℕ),
          (((l.flatMap g).map (· ^ d)).map (· ^ k)).sum =
            (l.map (fun a => (((g a).map (· ^ d)).map (· ^ k)).sum)).sum := by
        intro l g d k
        induction l with
        | nil => simp
        | cons x xs ih =>
          simp only [List.flatMap_cons, List.map_append, List.sum_append, List.map_cons,
            List.sum_cons, ih]
      have h_finset_sum_eq_list_sum : ∀ (n : ℕ) (h : ℕ → L),
          ∑ j ∈ Finset.range n, h j = ((List.range n).map h).sum := by
        intro n h
        rw [Finset.range_eq_Ico]
        induction n with
        | zero => simp
        | succ n ih =>
          rw [← Finset.range_eq_Ico] at ih ⊢
          rw [Finset.sum_range_succ, List.range_succ, List.map_append, List.sum_append, ih]
          simp
      have h_finset_filter_sum_eq_list_sum : ∀ (n : ℕ) (h : ℕ → L),
          ∑ j ∈ (Finset.range n).filter (· ≠ m), h j =
            (((List.range n).filter (· ≠ m)).map h).sum := by
        intro n h
        induction n with
        | zero => simp
        | succ n ih =>
          rw [Finset.range_add_one, Finset.filter_insert, List.range_succ, List.filter_append]
          by_cases hnm : n ≠ m
          · simp [hnm, Finset.sum_insert, List.map_append, List.sum_append, ih, add_comm]
          · simp [hnm, ih]

      have hFibTr : ∀ (d : ℕ) (P_poly : Polynomial F)
          (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly),
          1 ≤ d →
          let _ : Fact (Irreducible P_poly) := ⟨hP.2.1⟩
          ∀ (hFin_P : Finite (AdjoinRoot P_poly)),
            let _ : Finite (AdjoinRoot P_poly) := hFin_P
            ∀ (M_ZP : ∀ i : ℕ, WeilEllAdicCohomologyModel (AdjoinRoot P_poly)
                (weilTransvTriClosedPointFiber F P.f₀ j_aff P_poly) ℓ i)
              (k : ℕ),
              1 ≤ k →
              algebraMap K L
                (∑ i ∈ Finset.Iic (2 * (2 * m + 1)),
                  (-1) ^ i * LinearMap.trace K (M_ZP i).V ((M_ZP i).frob ^ k)) =
                ((β_den.map (· ^ d)).map (· ^ k)).sum -
                  ((α_num.map (· ^ d)).map (· ^ k)).sum -
                  Matrix.trace
                    (((F_mat d P_poly hP).map (algebraMap (PadicInt ℓ) L)) ^ k) := by
        intro d P_poly hP hd hFact_P hFin_P hFin_P' M_ZP k hk
        let _ : Fact (Irreducible P_poly) := hFact_P
        let _ : Finite (AdjoinRoot P_poly) := hFin_P'
        let f_tr : ℕ → K := fun i => LinearMap.trace K (M_ZP i).V ((M_ZP i).frob ^ k)
        have hPart : ∑ i ∈ Finset.Iic (2 * (2 * m + 1)), (-1 : K) ^ i * f_tr i =
            (∑ j ∈ Finset.range (2 * m + 2), f_tr (2 * j)) -
              (∑ j ∈ (Finset.range (2 * m + 1)).filter (· ≠ m), f_tr (2 * j + 1)) -
              f_tr (2 * m + 1) := by
          let E := (Finset.range (2 * m + 2)).image (fun j => 2 * j)
          let O := (Finset.range (2 * m + 1)).image (fun j => 2 * j + 1)
          have hdisj : Disjoint E O := by
            rw [Finset.disjoint_left]
            intro x hxE hxO
            rcases Finset.mem_image.mp hxE with ⟨j₁, _, rfl⟩
            rcases Finset.mem_image.mp hxO with ⟨j₂, _, hEq⟩
            omega
          have hunion : Finset.Iic (2 * (2 * m + 1)) = E ∪ O := by
            ext i
            simp only [Finset.mem_Iic, Finset.mem_union, E, O, Finset.mem_image, Finset.mem_range]
            constructor
            · intro hi
              rcases Nat.even_or_odd' i with ⟨j, rfl | rfl⟩
              · left; exact ⟨j, by omega, rfl⟩
              · right; exact ⟨j, by omega, rfl⟩
            · rintro (⟨j, hj, rfl⟩ | ⟨j, hj, rfl⟩) <;> omega
          have hinj_E : Function.Injective (fun j : ℕ => 2 * j) := fun a b h => by
            dsimp at h; omega
          have hinj_O : Function.Injective (fun j : ℕ => 2 * j + 1) := fun a b h => by
            dsimp at h; omega
          rw [hunion, Finset.sum_union hdisj, Finset.sum_image (fun a _ b _ h => hinj_E h),
            Finset.sum_image (fun a _ b _ h => hinj_O h)]
          have hE_sum : ∑ j ∈ Finset.range (2 * m + 2), (-1 : K) ^ (2 * j) * f_tr (2 * j) =
              ∑ j ∈ Finset.range (2 * m + 2), f_tr (2 * j) := by
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [pow_mul, neg_one_sq, one_pow, one_mul]
          have hO_sum : ∑ j ∈ Finset.range (2 * m + 1), (-1 : K) ^ (2 * j + 1) * f_tr (2 * j + 1) =
              - ∑ j ∈ Finset.range (2 * m + 1), f_tr (2 * j + 1) := by
            rw [← Finset.sum_neg_distrib]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [pow_add, pow_mul, neg_one_sq, one_pow, pow_one, one_mul, neg_one_mul]
          have hm_mem : m ∈ Finset.range (2 * m + 1) := Finset.mem_range.mpr (by omega)
          have hfilter_eq :
              (Finset.range (2 * m + 1)).filter (· ≠ m) = (Finset.range (2 * m + 1)).erase m := by
            ext j
            simp [Finset.mem_erase, and_comm]
          have hsplit_O : ∑ j ∈ Finset.range (2 * m + 1), f_tr (2 * j + 1) =
              (∑ j ∈ (Finset.range (2 * m + 1)).filter (· ≠ m), f_tr (2 * j + 1)) +
                f_tr (2 * m + 1) := by
            rw [hfilter_eq, Finset.sum_erase_add _ _ hm_mem]
          rw [hE_sum, hO_sum, hsplit_O]
          ring
        change algebraMap K L (∑ i ∈ Finset.Iic (2 * (2 * m + 1)), (-1 : K) ^ i * f_tr i) = _
        rw [hPart, map_sub, map_sub, map_sum, map_sum]
        have hEven_eq : ∑ j ∈ Finset.range (2 * m + 2), algebraMap K L (f_tr (2 * j)) =
            ((β_den.map (· ^ d)).map (· ^ k)).sum := by
          have hcongr : ∑ j ∈ Finset.range (2 * m + 2), algebraMap K L (f_tr (2 * j)) =
              ∑ j ∈ Finset.range (2 * m + 2),
                (((((M_Zu (2 * j)).frob.charpoly.aroots L).toList).map (· ^ d)).map (· ^ k)).sum := by
            refine Finset.sum_congr rfl fun j hj => ?_
            have hj_lt : j < 2 * m + 2 := Finset.mem_range.mp hj
            have htr_j := weil_sing_dev_outer_smooth_closed_point_traces F m P.Z_tilde
              P.hProj_Ztilde P.f₀ P.hFibIrred_f₀ P.u₀ P.hu₀_sec P.Z_u₀ P.hProj_Zu₀
              P.ι_Zu₀ P.hPb_Zu₀ j_aff s_inf S_aff U₀ h1d ℓ hℓ
              (2 * j) (by omega) (by omega) (M_Zu (2 * j)) d P_poly hP hd hFin_P
              (M_ZP (2 * j)) k hk
            dsimp [f_tr]
            rw [htr_j, ← pow_mul, h_lin_trace_aroots (M_Zu (2 * j)).V (M_Zu (2 * j)).frob d k]
          rw [hcongr, h_finset_sum_eq_list_sum]
          dsimp [β_den]
          rw [h_list_flatMap_pow_sum]
        have hOdd_eq :
            ∑ j ∈ (Finset.range (2 * m + 1)).filter (· ≠ m), algebraMap K L (f_tr (2 * j + 1)) =
            (((((List.range (2 * m + 1)).filter (· ≠ m)).flatMap
                (fun j => (((M_Zu (2 * j + 1)).frob).charpoly.aroots L).toList)).map (· ^ d)).map
              (· ^ k)).sum := by
          have hcongr :
              ∑ j ∈ (Finset.range (2 * m + 1)).filter (· ≠ m), algebraMap K L (f_tr (2 * j + 1)) =
              ∑ j ∈ (Finset.range (2 * m + 1)).filter (· ≠ m),
                (((((M_Zu (2 * j + 1)).frob.charpoly.aroots L).toList).map (· ^ d)).map
                  (· ^ k)).sum := by
            refine Finset.sum_congr rfl fun j hj => ?_
            simp only [Finset.mem_filter, Finset.mem_range] at hj
            have htr_j := weil_sing_dev_outer_smooth_closed_point_traces F m P.Z_tilde
              P.hProj_Ztilde P.f₀ P.hFibIrred_f₀ P.u₀ P.hu₀_sec P.Z_u₀ P.hProj_Zu₀
              P.ι_Zu₀ P.hPb_Zu₀ j_aff s_inf S_aff U₀ h1d ℓ hℓ
              (2 * j + 1) (by omega) (by omega) (M_Zu (2 * j + 1)) d P_poly hP hd hFin_P
              (M_ZP (2 * j + 1)) k hk
            dsimp [f_tr]
            rw [htr_j, ← pow_mul,
              h_lin_trace_aroots (M_Zu (2 * j + 1)).V (M_Zu (2 * j + 1)).frob d k]
          rw [hcongr, h_finset_filter_sum_eq_list_sum, h_list_flatMap_pow_sum]
        have hMid_eq : algebraMap K L (f_tr (2 * m + 1)) =
            ((((f_rad.charpoly.aroots L).toList).map (· ^ d)).map (· ^ k)).sum +
              ((((f_quot.charpoly.aroots L).toList).map (· ^ d)).map (· ^ k)).sum +
              Matrix.trace (((F_mat d P_poly hP).map (algebraMap (PadicInt ℓ) L)) ^ k) := by
          dsimp [f_tr]
          rw [hMidTr d P_poly hP hd hFin_P (M_ZP (2 * m + 1)) k hk, map_add, map_add,
            h_lin_trace_aroots ↥U_rad f_rad d k,
            h_lin_trace_aroots ((M_Zu (2 * m + 1)).V ⧸ U_van) f_quot d k]
          congr 1
          let A_mat := F_mat d P_poly hP
          have hcomp : (⇑(algebraMap K L) ∘ ⇑(algebraMap (PadicInt ℓ) K)) =
              ⇑(algebraMap (PadicInt ℓ) L) := rfl
          have htr1 : algebraMap K L (Matrix.trace ((A_mat.map (algebraMap (PadicInt ℓ) K)) ^ k)) =
              Matrix.trace (((A_mat.map (algebraMap (PadicInt ℓ) K)) ^ k).map (algebraMap K L)) := by
            simp only [Matrix.trace, Matrix.diag, Matrix.map_apply, map_sum]
          have hpow : ((A_mat.map (algebraMap (PadicInt ℓ) K)) ^ k).map (algebraMap K L) =
              ((A_mat.map (algebraMap (PadicInt ℓ) K)).map (algebraMap K L)) ^ k :=
            (RingHom.mapMatrix (algebraMap K L)).map_pow (A_mat.map (algebraMap (PadicInt ℓ) K)) k
          rw [htr1, hpow, Matrix.map_map, hcomp]
        have hα_sum : ((α_num.map (· ^ d)).map (· ^ k)).sum =
            (((((List.range (2 * m + 1)).filter (· ≠ m)).flatMap
                (fun j => (((M_Zu (2 * j + 1)).frob).charpoly.aroots L).toList)).map (· ^ d)).map
              (· ^ k)).sum +
            ((((f_rad.charpoly.aroots L).toList).map (· ^ d)).map (· ^ k)).sum +
            ((((f_quot.charpoly.aroots L).toList).map (· ^ d)).map (· ^ k)).sum := by
          dsimp [α_num]
          simp only [List.map_append, List.sum_append]
        rw [hEven_eq, hOdd_eq, hMid_eq, hα_sum]
        ring

      exact ⟨M, hM, J, G_geom, F_u, F_mat, Δ, α_num, β_den, ℒ₀, τ_ℒ, W_mid,
        hJ_skew, hJ_det, hG_sp, hΔ_ne, hΔ_nz, hΔ_span, hΔ_orb, hΔ_inv, hΔ_transv,
        hDense, hFu_norm, hFu_sim, hF_sim, hα_mem, hβ_mem, hFibTr, hTower, hγ'_mid⟩
  · rcases hOuter0 hγ'_0 with hSq | hHigh
    · exact Or.inl hSq
    · exact Or.inr (Or.inl (Or.inr hHigh))

theorem weil_curve_tower_rep_sheaf_construction (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (ℓ N : ℕ) [Fact (Nat.Prime ℓ)] (hN : 1 ≤ N)
    (H_geom : Subgroup ((Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ))
    (A_u : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (A_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin N) (Fin N) (PadicInt ℓ))
    (hRep : WeilCurveRepTower.{u} F S_aff j_aff U₀ u₀ ℓ N H_geom A_u A_mat) :
    ∃ (ℰ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
      (τ_ℰ : ∀ r : ℕ, Quiver.Hom (ℰ₀ (r + 1)) (ℰ₀ r)),
      WeilCurveRepSheafTower.{u} F S_aff j_aff U₀ u₀ ℓ N H_geom A_u A_mat ℰ₀ τ_ℰ :=
by
  classical
  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  rcases hRep with ⟨a₀, ha₀, B, L_fld,
    hCR, hDom, hFld,
    hAF_B, hAP_B, hAR_B,
    hAF_L, hAP_L, hARF_L,
    hABL, hARL,
    hST_FPB, hST_PRB, hST_FKL, hST_PKL, hST_PBL, hST_RBL,
    hFin_B, hEt_B, hFrac_B, hIntCl_B, hFD_L, hGal_L,
    τ_rep, ι_B, e_U,
    hu₀_eq, heU_eq, hSurjG, hImG, hCompat_B, hQu, hQP⟩
  let _ : ∀ r, CommRing (B r) := hCR
  have _ : ∀ r, IsDomain (B r) := hDom
  let _ : ∀ r, Field (L_fld r) := hFld
  let _ : ∀ r, Algebra F (B r) := hAF_B
  let _ : ∀ r, Algebra (Polynomial F) (B r) := hAP_B
  let _ : ∀ r, Algebra R₀ (B r) := hAR_B
  let _ : ∀ r, Algebra F (L_fld r) := hAF_L
  let _ : ∀ r, Algebra (Polynomial F) (L_fld r) := hAP_L
  let _ : ∀ r, Algebra (RatFunc F) (L_fld r) := hARF_L
  let _ : ∀ r, Algebra (B r) (L_fld r) := hABL
  let _ : ∀ r, Algebra R₀ (L_fld r) := hARL
  have _ : ∀ r, IsScalarTower F (Polynomial F) (B r) := hST_FPB
  have _ : ∀ r, IsScalarTower (Polynomial F) R₀ (B r) := hST_PRB
  have _ : ∀ r, IsScalarTower F (RatFunc F) (L_fld r) := hST_FKL
  have _ : ∀ r, IsScalarTower (Polynomial F) (RatFunc F) (L_fld r) := hST_PKL
  have _ : ∀ r, IsScalarTower (Polynomial F) (B r) (L_fld r) := hST_PBL
  have _ : ∀ r, IsScalarTower R₀ (B r) (L_fld r) := hST_RBL
  have _ : ∀ r, Module.Finite R₀ (B r) := hFin_B
  have _ : ∀ r, Algebra.Etale R₀ (B r) := hEt_B
  have _ : ∀ r, IsFractionRing (B r) (L_fld r) := hFrac_B
  have _ : ∀ r, IsIntegralClosure (B r) R₀ (L_fld r) := hIntCl_B
  have _ : ∀ r, FiniteDimensional (RatFunc F) (L_fld r) := hFD_L
  have _ : ∀ r, IsGalois (RatFunc F) (L_fld r) := hGal_L
  obtain ⟨hAlgIdemp, hR₀Pkg, hRelPkg⟩ := weil_etale_galois_domain_idempotents_and_aut_lift.{u}
  obtain ⟨hDom_R₀, instAlg_R₀K, hFrac_R₀K, hST_R₀KL_gen⟩ := hR₀Pkg F S_aff
  have _ : IsDomain R₀ := hDom_R₀
  let _ : Algebra R₀ (RatFunc F) := instAlg_R₀K
  have _ : IsFractionRing R₀ (RatFunc F) := hFrac_R₀K
  have _ : ∀ r, IsScalarTower R₀ (RatFunc F) (L_fld r) := fun r => hST_R₀KL_gen (B r) (L_fld r)
  obtain ⟨hMemSite, hPullAdjSite, hConstEquivSite⟩ :=
    weil_etale_constant_sheaf_locallyConstant_equiv_and_pullback_adj.{u}
  let V_sch : ℕ → AlgebraicGeometry.Scheme.{u} :=
    fun r => AlgebraicGeometry.Spec (CommRingCat.of (B r))
  let π_sch : ∀ r : ℕ, V_sch r ⟶ U₀.toScheme :=
    fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
  let A_grp : ℕ → AddCommGrpCat.{u} :=
    fun r => AddCommGrpCat.uliftFunctor.{u, 0}.obj
      (AddCommGrpCat.of (Fin N → ZMod (ℓ ^ (r + 1))))
  have hLevel : ∀ r : ℕ,
      ∃ (ℰ : CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
        (triv : ∀ W : U₀.toScheme.Etale,
          let W_V := CategoryTheory.Limits.pullback
            ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom (π_sch r)
          ↑(ℰ.obj.obj (Opposite.op W)) →+
            LocallyConstant ↥W_V (Fin N → ZMod (ℓ ^ (r + 1)))),
        WeilIsEtaleSheafPullback (π_sch r) ℰ
          ((CategoryTheory.constantSheaf (V_sch r).smallEtaleTopology AddCommGrpCat.{u}).obj
            (A_grp r)) ∧
        (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
          let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
          let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
          let W₁_V := CategoryTheory.Limits.pullback h₁ (π_sch r)
          let W₂_V := CategoryTheory.Limits.pullback h₂ (π_sch r)
          ∀ (u_V : Quiver.Hom W₁_V W₂_V),
            CategoryTheory.CategoryStruct.comp u_V
                (CategoryTheory.Limits.pullback.fst h₂ (π_sch r)) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.fst h₁ (π_sch r))
                ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
            CategoryTheory.CategoryStruct.comp u_V
                (CategoryTheory.Limits.pullback.snd h₂ (π_sch r)) =
              CategoryTheory.Limits.pullback.snd h₁ (π_sch r) →
            ∀ (s : ↑(ℰ.obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_V),
              triv W₁ ((ℰ.obj.map (Opposite.op u)) s) y₁ =
                triv W₂ s (u_V.base y₁)) ∧
        (∀ W : U₀.toScheme.Etale,
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
          let W_V := CategoryTheory.Limits.pullback h_W (π_sch r)
          Function.Injective (triv W) ∧
          Set.range (triv W) =
            { f | ∀ (σ : B r ≃ₐ[R₀] B r) (m_σ : Quiver.Hom W_V W_V),
              CategoryTheory.CategoryStruct.comp m_σ
                  (CategoryTheory.Limits.pullback.fst h_W (π_sch r)) =
                CategoryTheory.Limits.pullback.fst h_W (π_sch r) →
              CategoryTheory.CategoryStruct.comp m_σ
                  (CategoryTheory.Limits.pullback.snd h_W (π_sch r)) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W (π_sch r))
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
              ∀ y : ↥W_V, f (m_σ.base y) = ((τ_rep r σ).val).mulVec (f y) }) := by
    intro r
    obtain ⟨hInj_r, m_r, equiv_r, e_r, hIdemp_r, hOrth_r, hSum_r, hEval_r, hAbsorb_r⟩ :=
      hAlgIdemp R₀ (B r) (RatFunc F) (L_fld r)
    obtain ⟨⟨hπ_et_r, hπ_surj_r⟩, _, hSheets_r⟩ :=
      weil_scheme_galois_torsor_clopen_sheets.{u} R₀ (B r) hInj_r m_r equiv_r e_r
        hIdemp_r hOrth_r hSum_r hEval_r hAbsorb_r U₀.toScheme e_U
    obtain ⟨hCont_r, hAdj_r⟩ := hPullAdjSite (V_sch r) U₀.toScheme (π_sch r)
    obtain ⟨hT_Vr, θ_Vr, hθ_bij_r, hθ_nat_r, hθ_unit_r⟩ :=
      hConstEquivSite (V_sch r) (A_grp r)
    exact weil_etale_galois_rep_sheaf_and_pullback_iso.{u} R₀ (B r) U₀.toScheme e_U
      hπ_et_r hπ_surj_r hSheets_r (hMemSite U₀.toScheme) (hMemSite (V_sch r))
      hCont_r hAdj_r N (ZMod (ℓ ^ (r + 1))) (τ_rep r) hT_Vr θ_Vr
      hθ_bij_r (@hθ_nat_r) hθ_unit_r
  let ℰ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u} :=
    fun r => Classical.choose (hLevel r)
  let triv : ∀ (r : ℕ) (W : U₀.toScheme.Etale),
      let W_V := CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom (π_sch r)
      ↑((ℰ₀ r).obj.obj (Opposite.op W)) →+
        LocallyConstant ↥W_V (Fin N → ZMod (ℓ ^ (r + 1))) :=
    fun r => Classical.choose (Classical.choose_spec (hLevel r))
  have hLevel_spec : ∀ r : ℕ,
      WeilIsEtaleSheafPullback (π_sch r) (ℰ₀ r)
        ((CategoryTheory.constantSheaf (V_sch r).smallEtaleTopology AddCommGrpCat.{u}).obj
          (A_grp r)) ∧
      (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
        let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
        let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
        let W₁_V := CategoryTheory.Limits.pullback h₁ (π_sch r)
        let W₂_V := CategoryTheory.Limits.pullback h₂ (π_sch r)
        ∀ (u_V : Quiver.Hom W₁_V W₂_V),
          CategoryTheory.CategoryStruct.comp u_V
              (CategoryTheory.Limits.pullback.fst h₂ (π_sch r)) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst h₁ (π_sch r))
              ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
          CategoryTheory.CategoryStruct.comp u_V
              (CategoryTheory.Limits.pullback.snd h₂ (π_sch r)) =
            CategoryTheory.Limits.pullback.snd h₁ (π_sch r) →
          ∀ (s : ↑((ℰ₀ r).obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_V),
            triv r W₁ (((ℰ₀ r).obj.map (Opposite.op u)) s) y₁ =
              triv r W₂ s (u_V.base y₁)) ∧
      (∀ W : U₀.toScheme.Etale,
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
        let W_V := CategoryTheory.Limits.pullback h_W (π_sch r)
        Function.Injective (triv r W) ∧
        Set.range (triv r W) =
          { f | ∀ (σ : B r ≃ₐ[R₀] B r) (m_σ : Quiver.Hom W_V W_V),
            CategoryTheory.CategoryStruct.comp m_σ
                (CategoryTheory.Limits.pullback.fst h_W (π_sch r)) =
              CategoryTheory.Limits.pullback.fst h_W (π_sch r) →
            CategoryTheory.CategoryStruct.comp m_σ
                (CategoryTheory.Limits.pullback.snd h_W (π_sch r)) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W (π_sch r))
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
            ∀ y : ↥W_V, f (m_σ.base y) = ((τ_rep r σ).val).mulVec (f y) }) :=
    fun r => Classical.choose_spec (Classical.choose_spec (hLevel r))
  have hTrans : ∀ r : ℕ,
      ∃ τ_r : Quiver.Hom (ℰ₀ (r + 1)) (ℰ₀ r),
        ∀ (W : U₀.toScheme.Etale),
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
          let W_r := CategoryTheory.Limits.pullback h_W (π_sch r)
          let W_succ := CategoryTheory.Limits.pullback h_W (π_sch (r + 1))
          ∀ (s_up : ↑((ℰ₀ (r + 1)).obj.obj (Opposite.op W)))
            (m_ι : Quiver.Hom W_succ W_r),
            CategoryTheory.CategoryStruct.comp m_ι
                (CategoryTheory.Limits.pullback.fst h_W (π_sch r)) =
              CategoryTheory.Limits.pullback.fst h_W (π_sch (r + 1)) →
            CategoryTheory.CategoryStruct.comp m_ι
                (CategoryTheory.Limits.pullback.snd h_W (π_sch r)) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W (π_sch (r + 1)))
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B r).toRingHom)) →
            ∀ (y_up : ↥W_succ) (i : Fin N),
              triv r W ((τ_r.hom.app (Opposite.op W)) s_up) (m_ι.base y_up) i =
                ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
                  (triv (r + 1) W s_up y_up i) := by
    intro r
    let p_ι : V_sch (r + 1) ⟶ V_sch r :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B r).toRingHom)
    have hp_ι_π : p_ι ≫ π_sch r = π_sch (r + 1) := by
      dsimp only [p_ι, π_sch]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      have hcomm : CommRingCat.ofHom (algebraMap R₀ (B r)) ≫
          CommRingCat.ofHom (ι_B r).toRingHom =
          CommRingCat.ofHom (algebraMap R₀ (B (r + 1))) :=
        CommRingCat.hom_ext (RingHom.ext fun x => (ι_B r).commutes x)
      rw [hcomm]
    obtain ⟨hLift_aut, hRelAlg⟩ :=
      hRelPkg R₀ (RatFunc F) (B r) (L_fld r) (B (r + 1)) (L_fld (r + 1)) (ι_B r)
        (hCompat_B r).1
    let _ : Algebra (B r) (B (r + 1)) := (ι_B r).toRingHom.toAlgebra
    let _ : Algebra (B r) (L_fld (r + 1)) :=
      ((algebraMap (B (r + 1)) (L_fld (r + 1))).comp (ι_B r).toRingHom).toAlgebra
    have _ : IsScalarTower R₀ (B r) (B (r + 1)) :=
      IsScalarTower.of_algebraMap_eq fun x => ((ι_B r).commutes x).symm
    obtain ⟨hST_BB, hFin_BB, hEt_BB, hIntCl_BB, instL_rel, hST_BLL, hFD_LL, hGal_LL⟩ :=
      hRelAlg
    have _ : IsScalarTower (B r) (B (r + 1)) (L_fld (r + 1)) := hST_BB
    have _ : Module.Finite (B r) (B (r + 1)) := hFin_BB
    have _ : Algebra.Etale (B r) (B (r + 1)) := hEt_BB
    have _ : IsIntegralClosure (B (r + 1)) (B r) (L_fld (r + 1)) := hIntCl_BB
    let _ : Algebra (L_fld r) (L_fld (r + 1)) := instL_rel
    have _ : IsScalarTower (B r) (L_fld r) (L_fld (r + 1)) := hST_BLL
    have _ : FiniteDimensional (L_fld r) (L_fld (r + 1)) := hFD_LL
    have _ : IsGalois (L_fld r) (L_fld (r + 1)) := hGal_LL
    obtain ⟨hInj_rel, m_rel, equiv_rel, e_rel_idemp, hIdemp_rel, hOrth_rel, hSum_rel,
        hEval_rel, hAbsorb_rel⟩ :=
      hAlgIdemp (B r) (B (r + 1)) (L_fld r) (L_fld (r + 1))
    obtain ⟨⟨hπ_rel_et, hπ_rel_surj⟩, hTors_rel, _⟩ :=
      weil_scheme_galois_torsor_clopen_sheets.{u} (B r) (B (r + 1)) hInj_rel m_rel equiv_rel
        e_rel_idemp hIdemp_rel hOrth_rel hSum_rel hEval_rel hAbsorb_rel
        (V_sch r) (CategoryTheory.Iso.refl (V_sch r))
    let π_rel : V_sch (r + 1) ⟶ V_sch r :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (B r) (B (r + 1)))) ≫
        (CategoryTheory.Iso.refl (V_sch r)).hom
    have hπ_rel_eq : π_rel = p_ι := CategoryTheory.Category.comp_id p_ι
    let cast_r : ZMod (ℓ ^ (r + 1 + 1)) →+* ZMod (ℓ ^ (r + 1)) :=
      ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
    let mapVec : (Fin N → ZMod (ℓ ^ (r + 1 + 1))) → (Fin N → ZMod (ℓ ^ (r + 1))) :=
      fun v i => cast_r (v i)
    let m_ι_can : ∀ W : U₀.toScheme.Etale,
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
        CategoryTheory.Limits.pullback h_W (π_sch (r + 1)) ⟶
          CategoryTheory.Limits.pullback h_W (π_sch r) :=
      fun W =>
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst h_W (π_sch (r + 1)))
          (CategoryTheory.Limits.pullback.snd h_W (π_sch (r + 1)) ≫ p_ι)
          (by rw [CategoryTheory.Category.assoc, hp_ι_π,
                CategoryTheory.Limits.pullback.condition])
    have hm_ι_pb : ∀ W : U₀.toScheme.Etale,
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
        CategoryTheory.IsPullback (m_ι_can W)
          (CategoryTheory.Limits.pullback.snd h_W (π_sch (r + 1)))
          (CategoryTheory.Limits.pullback.snd h_W (π_sch r)) π_rel := by
      intro W
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
      have hOuter : CategoryTheory.IsPullback
          (m_ι_can W ≫ CategoryTheory.Limits.pullback.fst h_W (π_sch r))
          (CategoryTheory.Limits.pullback.snd h_W (π_sch (r + 1)))
          h_W (π_rel ≫ π_sch r) := by
        rw [CategoryTheory.Limits.pullback.lift_fst, hπ_rel_eq, hp_ι_π]
        exact CategoryTheory.IsPullback.of_hasPullback h_W (π_sch (r + 1))
      have hComm : m_ι_can W ≫ CategoryTheory.Limits.pullback.snd h_W (π_sch r) =
          CategoryTheory.Limits.pullback.snd h_W (π_sch (r + 1)) ≫ π_rel := by
        rw [CategoryTheory.Limits.pullback.lift_snd, hπ_rel_eq]
      exact CategoryTheory.IsPullback.of_right hOuter hComm
        (CategoryTheory.IsPullback.of_hasPullback h_W (π_sch r))
    have hm_ι_et : ∀ W : U₀.toScheme.Etale, AlgebraicGeometry.Etale (m_ι_can W) :=
      fun W => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (hm_ι_pb W).flip hπ_rel_et
    have hm_ι_surj : ∀ W : U₀.toScheme.Etale, AlgebraicGeometry.Surjective (m_ι_can W) :=
      fun W => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (hm_ι_pb W).flip hπ_rel_surj
    have hPointwise : ∀ (W : U₀.toScheme.Etale)
        (s_up : ↑((ℰ₀ (r + 1)).obj.obj (Opposite.op W))),
        ∃ s_down : ↑((ℰ₀ r).obj.obj (Opposite.op W)),
          ∀ (y_up : ↥(CategoryTheory.Limits.pullback
              ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
              (π_sch (r + 1))))
            (i : Fin N),
            triv r W s_down ((m_ι_can W).base y_up) i =
              cast_r (triv (r + 1) W s_up y_up i) := by
      intro W s_up
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
      let W_r := CategoryTheory.Limits.pullback h_W (π_sch r)
      let W_succ := CategoryTheory.Limits.pullback h_W (π_sch (r + 1))
      let f_up := triv (r + 1) W s_up
      let f_cast : LocallyConstant ↥W_succ (Fin N → ZMod (ℓ ^ (r + 1))) :=
        LocallyConstant.map mapVec f_up
      have hf_up_equiv : ∀ (τ : B (r + 1) ≃ₐ[R₀] B (r + 1)) (m_τ : Quiver.Hom W_succ W_succ),
          m_τ ≫ CategoryTheory.Limits.pullback.fst h_W (π_sch (r + 1)) =
            CategoryTheory.Limits.pullback.fst h_W (π_sch (r + 1)) →
          m_τ ≫ CategoryTheory.Limits.pullback.snd h_W (π_sch (r + 1)) =
            CategoryTheory.Limits.pullback.snd h_W (π_sch (r + 1)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
          ∀ y : ↥W_succ, f_up (m_τ.base y) = ((τ_rep (r + 1) τ).val).mulVec (f_up y) := by
        have hmem : f_up ∈ Set.range (triv (r + 1) W) := ⟨s_up, rfl⟩
        rw [(hLevel_spec (r + 1)).2.2 W |>.2] at hmem
        exact hmem
      have hFibConst : ∀ y₁ y₂ : ↥W_succ,
          (m_ι_can W).base y₁ = (m_ι_can W).base y₂ → f_cast y₁ = f_cast y₂ := by
        intro y₁ y₂ hy_eq
        let e_iso := (hm_ι_pb W).isoPullback
        let snd_r := CategoryTheory.Limits.pullback.snd h_W (π_sch r)
        have hz_eq : (CategoryTheory.Limits.pullback.fst snd_r π_rel).base
            (e_iso.hom.base y₁) =
            (CategoryTheory.Limits.pullback.fst snd_r π_rel).base
              (e_iso.hom.base y₂) := by
          have h1 : (e_iso.hom ≫ CategoryTheory.Limits.pullback.fst snd_r π_rel).base y₁ =
              (m_ι_can W).base y₁ :=
            congrArg (fun k => k.base y₁) (hm_ι_pb W).isoPullback_hom_fst
          have h2 : (e_iso.hom ≫ CategoryTheory.Limits.pullback.fst snd_r π_rel).base y₂ =
              (m_ι_can W).base y₂ :=
            congrArg (fun k => k.base y₂) (hm_ι_pb W).isoPullback_hom_fst
          exact h1.trans (hy_eq.trans h2.symm)
        obtain ⟨δ, m_δ_rel, hmδ_fst, hmδ_snd, hmδ_pt⟩ :=
          (hTors_rel W_r snd_r).2.2 (e_iso.hom.base y₁) (e_iso.hom.base y₂) hz_eq
        let m_δ : W_succ ⟶ W_succ := e_iso.hom ≫ m_δ_rel ≫ e_iso.inv
        have hmδ_y : m_δ.base y₁ = y₂ := by
          change e_iso.inv.base (m_δ_rel.base (e_iso.hom.base y₁)) = y₂
          rw [hmδ_pt]
          exact congrArg (fun k : W_succ ⟶ W_succ => k.base y₂) e_iso.hom_inv_id
        have hmδ_mι : m_δ ≫ m_ι_can W = m_ι_can W := by
          dsimp only [m_δ]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            (hm_ι_pb W).isoPullback_inv_fst, hmδ_fst, (hm_ι_pb W).isoPullback_hom_fst]
        have hmδ_fst_succ : m_δ ≫ CategoryTheory.Limits.pullback.fst h_W (π_sch (r + 1)) =
            CategoryTheory.Limits.pullback.fst h_W (π_sch (r + 1)) := by
          have hlift : m_ι_can W ≫ CategoryTheory.Limits.pullback.fst h_W (π_sch r) =
              CategoryTheory.Limits.pullback.fst h_W (π_sch (r + 1)) :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          rw [← hlift, ← CategoryTheory.Category.assoc, hmδ_mι]
        have hmδ_snd_succ : m_δ ≫ CategoryTheory.Limits.pullback.snd h_W (π_sch (r + 1)) =
            CategoryTheory.Limits.pullback.snd h_W (π_sch (r + 1)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom δ.symm.toRingHom) := by
          dsimp only [m_δ]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            (hm_ι_pb W).isoPullback_inv_snd, hmδ_snd, ← CategoryTheory.Category.assoc,
            (hm_ι_pb W).isoPullback_hom_snd]
        let τ : B (r + 1) ≃ₐ[R₀] B (r + 1) := δ.restrictScalars R₀
        have hτ_symm : τ.symm.toRingHom = δ.symm.toRingHom := rfl
        have hf_y₂ : f_up y₂ = ((τ_rep (r + 1) τ).val).mulVec (f_up y₁) := by
          rw [← hmδ_y]
          exact hf_up_equiv τ m_δ hmδ_fst_succ (hτ_symm ▸ hmδ_snd_succ) y₁
        obtain ⟨σ, hτσ, hMat⟩ := (hCompat_B r).2 τ
        have hσ_eq1 : σ = 1 := by
          ext b
          apply (hCompat_B r).1
          rw [← hτσ b]
          exact δ.commutes b
        have hMat1 : ((τ_rep (r + 1) τ).val).map cast_r = 1 := by
          rw [hMat, hσ_eq1, map_one]
          rfl
        symm
        ext i
        change cast_r (f_up y₂ i) = cast_r (f_up y₁ i)
        rw [hf_y₂, RingHom.map_mulVec]
        change (((τ_rep (r + 1) τ).val).map cast_r).mulVec (f_cast y₁) i = f_cast y₁ i
        rw [hMat1, Matrix.one_mulVec]
      have _ : AlgebraicGeometry.Etale (m_ι_can W) := hm_ι_et W
      have _ : AlgebraicGeometry.Surjective (m_ι_can W) := hm_ι_surj W
      have hSurj_base : Function.Surjective (m_ι_can W).base := (m_ι_can W).surjective
      let sec : ↥W_r → ↥W_succ := fun x => Classical.choose (hSurj_base x)
      have hsec : ∀ x : ↥W_r, (m_ι_can W).base (sec x) = x :=
        fun x => Classical.choose_spec (hSurj_base x)
      let f_down_fun : ↥W_r → (Fin N → ZMod (ℓ ^ (r + 1))) := fun x => f_cast (sec x)
      have hf_down_comp : ∀ y : ↥W_succ, f_down_fun ((m_ι_can W).base y) = f_cast y :=
        fun y => hFibConst (sec ((m_ι_can W).base y)) y (hsec ((m_ι_can W).base y))
      have hf_down_lc : IsLocallyConstant f_down_fun := by
        intro S_set
        have hpre : f_down_fun ⁻¹' S_set = (m_ι_can W).base '' (f_cast ⁻¹' S_set) := by
          ext x
          constructor
          · intro hx
            exact ⟨sec x, hx, hsec x⟩
          · rintro ⟨y, hy, rfl⟩
            change f_down_fun ((m_ι_can W).base y) ∈ S_set
            rwa [hf_down_comp y]
        rw [hpre]
        exact (m_ι_can W).isOpenMap _ (f_cast.isLocallyConstant S_set)
      let f_lc : LocallyConstant ↥W_r (Fin N → ZMod (ℓ ^ (r + 1))) :=
        ⟨f_down_fun, hf_down_lc⟩
      have hf_lc_mem : f_lc ∈ Set.range (triv r W) := by
        rw [(hLevel_spec r).2.2 W |>.2]
        intro σ m_σ hmσ_fst hmσ_snd x
        obtain ⟨y, rfl⟩ := hSurj_base x
        obtain ⟨τ, hτ_lift⟩ := hLift_aut σ
        have hτ_symm_comm : CommRingCat.ofHom σ.symm.toRingHom ≫
            CommRingCat.ofHom (ι_B r).toRingHom =
            CommRingCat.ofHom (ι_B r).toRingHom ≫
              CommRingCat.ofHom τ.symm.toRingHom := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro b
          apply τ.injective
          change τ (ι_B r (σ.symm b)) = τ (τ.symm (ι_B r b))
          rw [hτ_lift (σ.symm b), σ.apply_symm_apply, τ.apply_symm_apply]
        have hp_ι_deck : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) ≫ p_ι =
            p_ι ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) := by
          dsimp only [p_ι]
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp, hτ_symm_comm]
        have hm_τ_cond : CategoryTheory.Limits.pullback.fst h_W (π_sch (r + 1)) ≫ h_W =
            (CategoryTheory.Limits.pullback.snd h_W (π_sch (r + 1)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom)) ≫
              π_sch (r + 1) := by
          rw [CategoryTheory.Category.assoc]
          have hτ_π : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) ≫
              π_sch (r + 1) = π_sch (r + 1) := by
            dsimp only [π_sch]
            rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
            have hcomm : CommRingCat.ofHom (algebraMap R₀ (B (r + 1))) ≫
                CommRingCat.ofHom τ.symm.toRingHom =
                CommRingCat.ofHom (algebraMap R₀ (B (r + 1))) :=
              CommRingCat.hom_ext (RingHom.ext fun z => τ.symm.commutes z)
            rw [hcomm]
          rw [hτ_π, CategoryTheory.Limits.pullback.condition]
        let m_τ : W_succ ⟶ W_succ :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst h_W (π_sch (r + 1)))
            (CategoryTheory.Limits.pullback.snd h_W (π_sch (r + 1)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom))
            hm_τ_cond
        have hm_τ_mι : m_τ ≫ m_ι_can W = m_ι_can W ≫ m_σ := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst,
              hmσ_fst, CategoryTheory.Limits.pullback.lift_fst]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, hmσ_snd,
              ← CategoryTheory.Category.assoc (m_ι_can W),
              CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc m_τ,
              CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hp_ι_deck]
        have hm_pt : m_σ.base ((m_ι_can W).base y) = (m_ι_can W).base (m_τ.base y) :=
          (congrArg (fun k : W_succ ⟶ W_r => k.base y) hm_τ_mι).symm
        obtain ⟨σ', hτσ', hMat'⟩ := (hCompat_B r).2 τ
        have hσ'_eq : σ' = σ := by
          ext b
          apply (hCompat_B r).1
          rw [← hτσ' b, hτ_lift b]
        rw [hσ'_eq] at hMat'
        change f_down_fun (m_σ.base ((m_ι_can W).base y)) =
          ((τ_rep r σ).val).mulVec (f_down_fun ((m_ι_can W).base y))
        rw [hm_pt, hf_down_comp (m_τ.base y), hf_down_comp y]
        ext i
        change cast_r (f_up (m_τ.base y) i) = ((τ_rep r σ).val).mulVec (f_cast y) i
        have hf_mτ := hf_up_equiv τ m_τ
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) y
        rw [hf_mτ, RingHom.map_mulVec]
        change (((τ_rep (r + 1) τ).val).map cast_r).mulVec (f_cast y) i = _
        rw [hMat']
      obtain ⟨s_down, hs_down⟩ := hf_lc_mem
      refine ⟨s_down, fun y_up i => ?_⟩
      rw [hs_down]
      exact congrFun (hf_down_comp y_up) i
    let τ_fun : ∀ W : U₀.toScheme.Etale,
        ↑((ℰ₀ (r + 1)).obj.obj (Opposite.op W)) → ↑((ℰ₀ r).obj.obj (Opposite.op W)) :=
      fun W s_up => Classical.choose (hPointwise W s_up)
    have hτ_spec : ∀ (W : U₀.toScheme.Etale)
        (s_up : ↑((ℰ₀ (r + 1)).obj.obj (Opposite.op W)))
        (y_up : ↥(CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
          (π_sch (r + 1))))
        (i : Fin N),
        triv r W (τ_fun W s_up) ((m_ι_can W).base y_up) i =
          cast_r (triv (r + 1) W s_up y_up i) :=
      fun W s_up => Classical.choose_spec (hPointwise W s_up)
    let τ_app : ∀ W_op : (U₀.toScheme.Etale)ᵒᵖ,
        (ℰ₀ (r + 1)).obj.obj W_op ⟶ (ℰ₀ r).obj.obj W_op :=
      fun W_op =>
        let W := Opposite.unop W_op
        have _ : AlgebraicGeometry.Surjective (m_ι_can W) := hm_ι_surj W
        have hSurj_W : Function.Surjective (m_ι_can W).base := (m_ι_can W).surjective
        have hInj_W : Function.Injective (triv r W) := (hLevel_spec r).2.2 W |>.1
        AddCommGrpCat.ofHom
          { toFun := τ_fun W
            map_zero' := by
              apply hInj_W
              ext x i
              obtain ⟨y_up, rfl⟩ := hSurj_W x
              rw [hτ_spec W 0 y_up i, map_zero, LocallyConstant.zero_apply, Pi.zero_apply,
                map_zero, map_zero, LocallyConstant.zero_apply, Pi.zero_apply]
            map_add' := fun s₁ s₂ => by
              apply hInj_W
              ext x i
              obtain ⟨y_up, rfl⟩ := hSurj_W x
              rw [hτ_spec W (s₁ + s₂) y_up i, map_add, LocallyConstant.add_apply, Pi.add_apply,
                map_add, map_add, LocallyConstant.add_apply, Pi.add_apply,
                hτ_spec W s₁ y_up i, hτ_spec W s₂ y_up i] }
    have hτ_nat : ∀ ⦃X Y : (U₀.toScheme.Etale)ᵒᵖ⦄ (f : X ⟶ Y),
        (ℰ₀ (r + 1)).obj.map f ≫ τ_app Y = τ_app X ≫ (ℰ₀ r).obj.map f := by
      intro X Y f
      let W₂ := Opposite.unop X
      let W₁ := Opposite.unop Y
      let u : W₁ ⟶ W₂ := f.unop
      have hf_eq : f = Opposite.op u := rfl
      rw [hf_eq]
      apply AddCommGrpCat.ext
      intro s₂
      have _ : AlgebraicGeometry.Surjective (m_ι_can W₁) := hm_ι_surj W₁
      have hSurj_1 : Function.Surjective (m_ι_can W₁).base := (m_ι_can W₁).surjective
      have hInj_1 : Function.Injective (triv r W₁) := (hLevel_spec r).2.2 W₁ |>.1
      apply hInj_1
      ext x₁ i
      obtain ⟨y₁, rfl⟩ := hSurj_1 x₁
      let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
      let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
      let u_left := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left
      have hu_w : u_left ≫ h₂ = h₁ :=
        ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).w
      let u_r : CategoryTheory.Limits.pullback h₁ (π_sch r) ⟶
          CategoryTheory.Limits.pullback h₂ (π_sch r) :=
        CategoryTheory.Limits.pullback.map h₁ (π_sch r) h₂ (π_sch r)
          u_left (𝟙 (V_sch r)) (𝟙 U₀.toScheme)
          (by rw [CategoryTheory.Category.comp_id, hu_w])
          (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      let u_succ : CategoryTheory.Limits.pullback h₁ (π_sch (r + 1)) ⟶
          CategoryTheory.Limits.pullback h₂ (π_sch (r + 1)) :=
        CategoryTheory.Limits.pullback.map h₁ (π_sch (r + 1)) h₂ (π_sch (r + 1))
          u_left (𝟙 (V_sch (r + 1))) (𝟙 U₀.toScheme)
          (by rw [CategoryTheory.Category.comp_id, hu_w])
          (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      have hu_r_fst : u_r ≫ CategoryTheory.Limits.pullback.fst h₂ (π_sch r) =
          CategoryTheory.Limits.pullback.fst h₁ (π_sch r) ≫ u_left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hu_r_snd : u_r ≫ CategoryTheory.Limits.pullback.snd h₂ (π_sch r) =
          CategoryTheory.Limits.pullback.snd h₁ (π_sch r) := by
        exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
          (CategoryTheory.Category.comp_id _)
      have hu_succ_fst : u_succ ≫ CategoryTheory.Limits.pullback.fst h₂ (π_sch (r + 1)) =
          CategoryTheory.Limits.pullback.fst h₁ (π_sch (r + 1)) ≫ u_left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hu_succ_snd : u_succ ≫ CategoryTheory.Limits.pullback.snd h₂ (π_sch (r + 1)) =
          CategoryTheory.Limits.pullback.snd h₁ (π_sch (r + 1)) := by
        exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
          (CategoryTheory.Category.comp_id _)
      have hm_comm : m_ι_can W₁ ≫ u_r = u_succ ≫ m_ι_can W₂ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            hu_r_fst, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst, hu_succ_fst]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            hu_r_snd, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc, hu_succ_snd]
      have hm_pt : u_r.base ((m_ι_can W₁).base y₁) = (m_ι_can W₂).base (u_succ.base y₁) :=
        congrArg (fun k => k.base y₁) hm_comm
      change triv r W₁ (τ_fun W₁ (((ℰ₀ (r + 1)).obj.map (Opposite.op u)) s₂))
          ((m_ι_can W₁).base y₁) i =
        triv r W₁ (((ℰ₀ r).obj.map (Opposite.op u)) (τ_fun W₂ s₂))
          ((m_ι_can W₁).base y₁) i
      rw [hτ_spec W₁ _ y₁ i,
        (hLevel_spec (r + 1)).2.1 u u_succ hu_succ_fst hu_succ_snd s₂ y₁,
        (hLevel_spec r).2.1 u u_r hu_r_fst hu_r_snd (τ_fun W₂ s₂) ((m_ι_can W₁).base y₁),
        hm_pt, hτ_spec W₂ s₂ (u_succ.base y₁) i]
    refine ⟨{ hom := { app := τ_app, naturality := hτ_nat } }, ?_⟩
    intro W _ _ _ s_up m_ι hm_fst hm_snd y_up i
    have hm_eq : m_ι = m_ι_can W := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact hm_fst.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      · exact hm_snd.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
    rw [hm_eq]
    exact hτ_spec W s_up y_up i
  let τ_ℰ : ∀ r : ℕ, Quiver.Hom (ℰ₀ (r + 1)) (ℰ₀ r) :=
    fun r => Classical.choose (hTrans r)
  have hτ_ℰ_spec := fun r => Classical.choose_spec (hTrans r)
  refine ⟨ℰ₀, τ_ℰ, a₀, ha₀, B, L_fld,
    hCR, hDom, hFld,
    hAF_B, hAP_B, hAR_B,
    hAF_L, hAP_L, hARF_L,
    hABL, hARL,
    hST_FPB, hST_PRB, hST_FKL, hST_PKL, hST_PBL, hST_RBL,
    hFin_B, hEt_B, hFrac_B, hIntCl_B, hFD_L, hGal_L,
    τ_rep, ι_B, e_U,
    hu₀_eq, heU_eq, hSurjG, hImG, hCompat_B, hQu, hQP,
    triv, fun r => ?_⟩
  refine ⟨(hLevel_spec r).1, (hLevel_spec r).2.1, fun W => ?_⟩
  exact ⟨(hLevel_spec r).2.2 W |>.1, (hLevel_spec r).2.2 W |>.2, hτ_ℰ_spec r W⟩

theorem weil_curve_tower_zero_ext_models_and_dir_surj (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hu₀_mem : Set.range u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left))
    (ℓ N : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F) (hN : 1 ≤ N)
    (H_geom : Subgroup ((Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ))
    (A_u : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (A_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin N) (Fin N) (PadicInt ℓ))
    (ℰ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
    (τ_ℰ : ∀ r : ℕ, Quiver.Hom (ℰ₀ (r + 1)) (ℰ₀ r))
    (hSh : WeilCurveRepSheafTower.{u} F S_aff j_aff U₀ u₀ ℓ N H_geom A_u A_mat ℰ₀ τ_ℰ) :
    ∃ (𝒥₀ : ℕ → CategoryTheory.Sheaf (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
        AddCommGrpCat.{u})
      (τ_𝒥 : ∀ r : ℕ, Quiver.Hom (𝒥₀ (r + 1)) (𝒥₀ r))
      (M_c : ∀ i : ℕ, WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ i
        𝒥₀ τ_𝒥),
      WeilCurveZeroExtSystem.{u} F S_aff j_aff U₀ u₀ ℓ N H_geom A_u A_mat 𝒥₀ τ_𝒥 ∧
      Subsingleton (M_c 0).V ∧
      ∀ (W_dir : WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ 1
          (fun r => weilEtaleHigherDirectImage U₀.ι 0 (ℰ₀ r))
          (fun r => weilEtaleHigherDirectImageMap U₀.ι 0 (τ_ℰ r))),
        ∃ π_dir : (M_c 1).V →ₗ[Padic ℓ] W_dir.V,
          Function.Surjective π_dir ∧
          ∀ v : (M_c 1).V, π_dir ((M_c 1).frob v) = W_dir.frob (π_dir v) :=
by
  obtain ⟨𝒥₀, τ_𝒥, ι_bock, ρ_bock, ι_ext,
    hZExt, hTors_𝒥, hTors_𝒟, hSES_bock, hιτ_bock, hτι_bock, hρ0_bock, hρsucc_bock,
    hMono_ext, hCompat_ext, hBij_ext⟩ :=
    weil_curve_zero_ext_sheaf_and_dir_inclusion F S_aff j_aff hj_open U₀ u₀ ℓ N hN
      H_geom A_u A_mat ℰ₀ τ_ℰ hSh
  have hGeom0 :=
    weil_curve_zero_ext_geom_h0_and_mod_prime_finite F S_aff j_aff hj_open hj_hom
      s_inf hsinf_sec hsinf_compl U₀ hU₀_eq u₀ hu₀_sec hu₀_mem
      ℓ N hℓ hN H_geom A_u A_mat 𝒥₀ τ_𝒥 hZExt
  obtain ⟨hModel_build, hModel_surj⟩ :=
    weil_transv_sheaf_model_builder_and_frob_naturality F (weilProjectiveSpaceOver F 1) ℓ
  have hEx_Mc := fun i : ℕ =>
    hModel_build i 𝒥₀ τ_𝒥 ι_bock ρ_bock hTors_𝒥 hSES_bock hιτ_bock hτι_bock
      hρ0_bock hρsucc_bock (fun hCont_pr hAdj_pr => (hGeom0 hCont_pr hAdj_pr).2 i)
  let M_c : ∀ i : ℕ,
      WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ i 𝒥₀ τ_𝒥 :=
    fun i => Classical.choose (hEx_Mc i)
  have hSub_Mc0 : Subsingleton (M_c 0).V :=
    (Classical.choose_spec (hEx_Mc 0)).2 (fun hCont_pr hAdj_pr => (hGeom0 hCont_pr hAdj_pr).1)
  have hFin_Mc1 : ∀ r : ℕ, Finite (((M_c 1).ℳ_bar r).H 1) :=
    (Classical.choose_spec (hEx_Mc 1)).1
  refine ⟨𝒥₀, τ_𝒥, M_c, hZExt, hSub_Mc0, fun W_dir => ?_⟩
  have hCoker_H1 := fun r : ℕ =>
    weil_curve_open_iso_cokernel_geom_h1_subsingleton F S_aff j_aff hj_open hj_hom
      s_inf hsinf_sec hsinf_compl U₀ hU₀_eq
      (𝒥₀ r) (weilEtaleHigherDirectImage U₀.ι 0 (ℰ₀ r)) (ι_ext r) (hBij_ext r)
  exact hModel_surj 1 𝒥₀ (fun r => weilEtaleHigherDirectImage U₀.ι 0 (ℰ₀ r))
    τ_𝒥 (fun r => weilEtaleHigherDirectImageMap U₀.ι 0 (τ_ℰ r))
    (M_c 1) W_dir ι_ext hTors_𝒥 hTors_𝒟 hFin_Mc1 hMono_ext hCompat_ext hCoker_H1

theorem weil_coinv_projLine_proper_smooth_geomIrred (K : Type u) [Field K] :
    AlgebraicGeometry.GeometricallyIrreducible (weilProjectiveSpaceOver K 1).hom ∧
    AlgebraicGeometry.IsProper (weilProjectiveSpaceOver K 1).hom ∧
    AlgebraicGeometry.SmoothOfRelativeDimension 1 (weilProjectiveSpaceOver K 1).hom :=
by
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) K
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let D₀ := weilProjectiveSpaceOver K 1
  have halg0 : ∀ c : K, (algebraMap K ↥(𝒜 0) c).1 = MvPolynomial.C c := fun _ => rfl
  let e₀ : K ≃+* ↥(𝒜 0) :=
    { toFun := algebraMap K ↥(𝒜 0)
      invFun := fun p => p.1.coeff 0
      left_inv := fun c => by
        change ((algebraMap K ↥(𝒜 0) c).1).coeff 0 = c
        rw [halg0, MvPolynomial.coeff_zero_C]
      right_inv := fun p => by
        apply Subtype.ext
        rw [halg0]
        ext m
        by_cases hm : m = 0
        · subst hm; simp
        · have hC0 : (MvPolynomial.C (p.1.coeff 0)).coeff m = 0 := by
            rw [MvPolynomial.coeff_C]
            simp [Ne.symm hm]
          rw [hC0]
          symm
          by_contra hne
          have hp : MvPolynomial.IsHomogeneous p.1 0 := p.2
          have hdeg : m 0 + m 1 = 0 := by
            have hw := hp hne
            rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (fun _ => zero_mul _)] at hw
            simpa [Fin.sum_univ_two] using hw
          apply hm
          rw [Finsupp.ext_iff, Fin.forall_fin_two]
          simp only [Finsupp.coe_zero, Pi.zero_apply]
          omega
      map_mul' := map_mul (algebraMap K ↥(𝒜 0))
      map_add' := map_add (algebraMap K ↥(𝒜 0)) }
  let _ : IsScalarTower K ↥(𝒜 0) (MvPolynomial (Fin 2) K) :=
    @IsScalarTower.of_algebraMap_eq K ↥(𝒜 0) (MvPolynomial (Fin 2) K) _ _ _ _ _ _ fun _ => rfl
  let _ : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin 2) K) :=
    Algebra.FiniteType.of_restrictScalars_finiteType K ↥(𝒜 0) (MvPolynomial (Fin 2) K)
  have hIsoMap0 : IsIso (CommRingCat.ofHom (algebraMap K ↥(𝒜 0))) :=
    (inferInstance : IsIso e₀.toCommRingCatIso.hom)
  have hProp : AlgebraicGeometry.IsProper D₀.hom := by
    change AlgebraicGeometry.IsProper
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥(𝒜 0))))
    infer_instance
  let U : Fin 2 → D₀.left.Opens := fun a => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)
  have hU_top : (⨆ a : Fin 2, U a) = ⊤ := by
    apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top'
    · intro a
      exact ⟨1, MvPolynomial.isHomogeneous_X K a⟩
    · rw [eq_top_iff]
      intro f _
      have hadj : (⊤ : Subalgebra K (MvPolynomial (Fin 2) K)) ≤
          (Algebra.adjoin ↥(𝒜 0)
            (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K))).restrictScalars K := by
        rw [← MvPolynomial.adjoin_range_X]
        exact Algebra.adjoin_le Algebra.subset_adjoin
      exact hadj trivial
  have hChartEquiv : ∀ a : Fin 2,
      ∃ e : MvPolynomial (Fin 1) K ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a),
        (RingEquiv.toRingHom e).comp MvPolynomial.C =
          (HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap K ↥(𝒜 0)) := by
    intro a
    let b : Fin 2 := if a = 0 then 1 else 0
    have hba : b ≠ a := by fin_cases a <;> decide
    let X_a : MvPolynomial (Fin 2) K := MvPolynomial.X a
    let X_b : MvPolynomial (Fin 2) K := MvPolynomial.X b
    have hX_a : X_a ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X K a
    have hX_b1 : X_b ∈ 𝒜 (1 • 1) := by
      rw [one_smul]
      exact MvPolynomial.isHomogeneous_X K b
    let φ₀ : K →+* HomogeneousLocalization.Away 𝒜 X_a :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers X_a)).comp
        (algebraMap K ↥(𝒜 0))
    let t_a : HomogeneousLocalization.Away 𝒜 X_a :=
      HomogeneousLocalization.Away.mk 𝒜 hX_a 1 X_b hX_b1
    let Φ_a : MvPolynomial (Fin 1) K →+* HomogeneousLocalization.Away 𝒜 X_a :=
      MvPolynomial.eval₂Hom φ₀ (fun _ : Fin 1 => t_a)
    let ev_a : MvPolynomial (Fin 2) K →+* MvPolynomial (Fin 1) K :=
      MvPolynomial.eval₂Hom MvPolynomial.C
        (fun i : Fin 2 => if i = a then 1 else MvPolynomial.X 0)
    have hev_X : ∀ i : Fin 2,
        ev_a (MvPolynomial.X i) = (if i = a then 1 else MvPolynomial.X 0) :=
      fun i => MvPolynomial.eval₂Hom_X' MvPolynomial.C
        (fun j : Fin 2 => if j = a then 1 else MvPolynomial.X 0) i
    have hev_Xa : ev_a X_a = 1 := by
      change ev_a (MvPolynomial.X a) = 1
      rw [hev_X a]
      simp
    have hUnit_a : IsUnit (ev_a X_a) := by
      rw [hev_Xa]
      exact isUnit_one
    let valHom : HomogeneousLocalization.Away 𝒜 X_a →+* Localization.Away X_a :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := fun _ _ => HomogeneousLocalization.val_mul _ _
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := fun _ _ => HomogeneousLocalization.val_add _ _ }
    let Ψ_tilde : Localization.Away X_a →+* MvPolynomial (Fin 1) K :=
      Localization.awayLift ev_a X_a hUnit_a
    let Ψ_a : HomogeneousLocalization.Away 𝒜 X_a →+* MvPolynomial (Fin 1) K :=
      Ψ_tilde.comp valHom
    have hΨ_mk : ∀ (g : MvPolynomial (Fin 2) K) (n : ℕ)
        (hn : X_a ^ n ∈ Submonoid.powers X_a),
        Ψ_tilde (Localization.mk g ⟨X_a ^ n, hn⟩) = ev_a g := by
      intro g n hn
      have h1 := Localization.awayLift_mk ev_a X_a g 1 (by rw [hev_Xa, mul_one]) n
      simpa using h1
    have hφ₀_val : ∀ c : K,
        (φ₀ c).val = Localization.mk (MvPolynomial.C c) 1 := fun _ => rfl
    have hLeft : ∀ p : MvPolynomial (Fin 1) K, Ψ_a (Φ_a p) = p := by
      suffices hcomp : Ψ_a.comp Φ_a = RingHom.id (MvPolynomial (Fin 1) K) from
        fun p => RingHom.congr_fun hcomp p
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change Ψ_tilde (Φ_a (MvPolynomial.C c)).val = MvPolynomial.C c
        have h1_sub : (1 : Submonoid.powers X_a) =
            ⟨X_a ^ 0, pow_mem (Submonoid.mem_powers X_a) 0⟩ :=
          Subtype.ext (pow_zero X_a).symm
        have hc_val : (Φ_a (MvPolynomial.C c)).val =
            Localization.mk (MvPolynomial.C c)
              ⟨X_a ^ 0, pow_mem (Submonoid.mem_powers X_a) 0⟩ := by
          rw [MvPolynomial.eval₂Hom_C, hφ₀_val, h1_sub]
        rw [hc_val, hΨ_mk]
        exact MvPolynomial.eval₂Hom_C _ _ c
      · intro u
        rw [Subsingleton.elim u 0]
        change Ψ_tilde (Φ_a (MvPolynomial.X 0)).val = MvPolynomial.X 0
        rw [MvPolynomial.eval₂Hom_X', HomogeneousLocalization.Away.val_mk, hΨ_mk]
        change ev_a (MvPolynomial.X b) = MvPolynomial.X 0
        rw [hev_X b]
        simp [hba]
    let s₁ : Submonoid.powers X_a := ⟨X_a, Submonoid.mem_powers X_a⟩
    have hPowMk : ∀ (g : MvPolynomial (Fin 2) K) (n : ℕ),
        (Localization.mk g s₁) ^ n = Localization.mk (g ^ n) (s₁ ^ n) := by
      intro g n
      induction n with
      | zero =>
        rw [pow_zero, pow_zero, pow_zero]
        exact Localization.mk_one.symm
      | succ n ih =>
        rw [pow_succ, ih, Localization.mk_mul, pow_succ, pow_succ]
    have hSumMk : ∀ (S : Finset (Fin 2 →₀ ℕ))
        (g : (Fin 2 →₀ ℕ) → MvPolynomial (Fin 2) K) (s : Submonoid.powers X_a),
        (∑ m ∈ S, Localization.mk (g m) s) = Localization.mk (∑ m ∈ S, g m) s := by
      intro S g s
      classical
      induction S using Finset.induction_on with
      | empty =>
        rw [Finset.sum_empty, Finset.sum_empty, Localization.mk_zero]
      | @insert m S hm ih =>
        rw [Finset.sum_insert hm, Finset.sum_insert hm, ih, Localization.add_mk_self]
    let Θ_a : MvPolynomial (Fin 2) K →+* Localization.Away X_a :=
      valHom.comp (Φ_a.comp ev_a)
    have hΘ_C : ∀ c : K, Θ_a (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
      intro c
      change (Φ_a (ev_a (MvPolynomial.C c))).val = _
      rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
      rfl
    have hΘ_X : ∀ i : Fin 2, Θ_a (MvPolynomial.X i) = Localization.mk (MvPolynomial.X i) s₁ := by
      intro i
      change (Φ_a (ev_a (MvPolynomial.X i))).val = _
      rw [hev_X i]
      split_ifs with hia
      · subst hia
        rw [map_one, HomogeneousLocalization.val_one]
        exact (Localization.mk_self s₁).symm
      · have hib : i = b := by
          fin_cases a <;> fin_cases i <;> simp_all [b]
        subst hib
        rw [MvPolynomial.eval₂Hom_X', HomogeneousLocalization.Away.val_mk]
        congr 1
        apply Subtype.ext
        exact pow_one X_a
    have hRight : ∀ z : HomogeneousLocalization.Away 𝒜 X_a, Φ_a (Ψ_a z) = z := by
      intro z
      refine Quotient.inductionOn' z fun w => ?_
      change Φ_a (Ψ_a (HomogeneousLocalization.mk w)) = HomogeneousLocalization.mk w
      apply (HomogeneousLocalization.ext_iff_val _ _).mpr
      let d := w.deg
      let f := w.num.1
      have hf : MvPolynomial.IsHomogeneous f d := w.num.2
      obtain ⟨k, hk⟩ := w.den_mem
      dsimp only at hk
      have hkd : k = d := by
        have hden_hom : MvPolynomial.IsHomogeneous (X_a ^ k) d := by
          rw [hk]
          exact w.den.2
        have hcoeff_ne : (X_a ^ k).coeff (Finsupp.single a k) ≠ 0 := by
          dsimp [X_a]
          rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.coeff_monomial]
          simp
        have hw := hden_hom hcoeff_ne
        rw [Finsupp.weight_apply, Finsupp.sum_single_index (zero_mul _)] at hw
        simpa using hw
      have hden_eq : (⟨w.den.1, w.den_mem⟩ : Submonoid.powers X_a) = s₁ ^ d := by
        apply Subtype.ext
        rw [← hk, hkd]
        rfl
      have hz_val : (HomogeneousLocalization.mk w).val = Localization.mk f (s₁ ^ d) := by
        rw [HomogeneousLocalization.val_mk, hden_eq]
      have hΨz : Ψ_a (HomogeneousLocalization.mk w) = ev_a f := by
        change Ψ_tilde (HomogeneousLocalization.mk w).val = ev_a f
        rw [hz_val]
        exact hΨ_mk f d (s₁ ^ d).2
      change (Φ_a (Ψ_a (HomogeneousLocalization.mk w))).val = (HomogeneousLocalization.mk w).val
      rw [hΨz, hz_val]
      change Θ_a f = Localization.mk f (s₁ ^ d)
      conv_lhs => rw [MvPolynomial.as_sum f]
      rw [map_sum]
      have hterm : ∀ m ∈ f.support,
          Θ_a (MvPolynomial.monomial m (f.coeff m)) =
            Localization.mk (MvPolynomial.monomial m (f.coeff m)) (s₁ ^ d) := by
        intro m hm
        have hm_ne : f.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
        have hm_deg : m 0 + m 1 = d := by
          have hw := hf hm_ne
          rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (fun _ => zero_mul _)] at hw
          simpa [Fin.sum_univ_two] using hw
        have hmon : MvPolynomial.monomial m (f.coeff m) =
            MvPolynomial.C (f.coeff m) *
              (MvPolynomial.X 0 ^ m 0 * MvPolynomial.X 1 ^ m 1) := by
          rw [MvPolynomial.monomial_eq,
            Finsupp.prod_of_support_subset m (Finset.subset_univ _) _ (fun _ _ => pow_zero _),
            Fin.prod_univ_two]
        rw [hmon, map_mul, map_mul, map_pow, map_pow, hΘ_C, hΘ_X 0, hΘ_X 1,
          hPowMk _ (m 0), hPowMk _ (m 1), Localization.mk_mul, Localization.mk_mul,
          one_mul, ← pow_add, hm_deg]
      rw [Finset.sum_congr rfl hterm, hSumMk, ← MvPolynomial.as_sum f]
    refine ⟨{ Φ_a with
              invFun := Ψ_a
              left_inv := hLeft
              right_inv := hRight }, ?_⟩
    apply RingHom.ext
    intro c
    exact MvPolynomial.eval₂Hom_C _ _ c
  let specIsoOfRingEquiv : ∀ {R S : Type u} [CommRing R] [CommRing S] (e : R ≃+* S),
      AlgebraicGeometry.Spec (CommRingCat.of S) ≅ AlgebraicGeometry.Spec (CommRingCat.of R) :=
    fun e =>
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.symm.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            e.toRingHom_comp_symm_toRingHom, CommRingCat.ofHom_id,
            AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            e.symm_toRingHom_comp_toRingHom, CommRingCat.ofHom_id,
            AlgebraicGeometry.Spec.map_id] }
  choose e_chart he_chart using hChartEquiv
  have hXa_mem : ∀ a : Fin 2, MvPolynomial.X a ∈ 𝒜 1 :=
    fun a => MvPolynomial.isHomogeneous_X K a
  let iso_chart : ∀ a : Fin 2,
      (U a).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) K)) :=
    fun a =>
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a)
        (hXa_mem a) zero_lt_one ≪≫
      specIsoOfRingEquiv (e_chart a)
  let ι : Fin 2 →
      (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) K)) ⟶ D₀.left) :=
    fun a => (iso_chart a).inv ≫ (U a).ι
  have hRange_iso_comp : ∀ {A B C : AlgebraicGeometry.Scheme.{u}}
      (e : A ≅ B) (g : A ⟶ C),
      Set.range (e.inv ≫ g).base = Set.range g.base := by
    intro A B C e g
    ext x
    simp only [Set.mem_range, AlgebraicGeometry.Scheme.Hom.comp_apply]
    exact ⟨fun ⟨y, hy⟩ => ⟨e.inv.base y, hy⟩,
      fun ⟨z, hz⟩ => ⟨e.hom.base z, by
        have hez : e.inv.base (e.hom.base z) = z := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, Iso.hom_inv_id]
          rfl
        rw [hez, hz]⟩⟩
  have hOpen_ι : ∀ a : Fin 2, AlgebraicGeometry.IsOpenImmersion (ι a) :=
    fun _ => inferInstance
  have hRange_ι : ∀ a : Fin 2, Set.range (ι a).base = (U a : Set ↥D₀.left) := by
    intro a
    exact (hRange_iso_comp (iso_chart a) (U a).ι).trans
      (AlgebraicGeometry.Scheme.Opens.range_ι (U a))
  have hComp_ι : ∀ a : Fin 2,
      ι a ≫ D₀.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
    intro a
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e_chart a).symm.toRingHom) ≫
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a)
          (hXa_mem a) zero_lt_one).inv) ≫
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)).ι ≫
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥(𝒜 0)))) = _
    rw [Category.assoc,
      AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι_assoc 𝒜 (MvPolynomial.X a)
        (hXa_mem a) zero_lt_one,
      AlgebraicGeometry.Proj.awayι_toSpecZero_assoc 𝒜 (MvPolynomial.X a)
        (hXa_mem a) zero_lt_one,
      ← AlgebraicGeometry.Spec.map_comp_assoc, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    rw [RingHom.comp_assoc, ← he_chart a, ← RingHom.comp_assoc,
      RingEquiv.symm_toRingHom_comp_toRingHom, RingHom.id_comp]
  have hSmA1 : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin 1) K))) := by
    rw [AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension.{u} 1)]
    apply RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
    change RingHom.IsStandardSmoothOfRelativeDimension 1
      (algebraMap K (MvPolynomial (Fin 1) K))
    rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
    have hsm := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial K (Fin 1)
    rwa [Nat.card_fin] at hsm
  have hSm : AlgebraicGeometry.SmoothOfRelativeDimension 1 D₀.hom := by
    apply @AlgebraicGeometry.IsZariskiLocalAtSource.of_iSup_eq_top
      (@AlgebraicGeometry.SmoothOfRelativeDimension.{u} 1)
      (@AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
        (@AlgebraicGeometry.SmoothOfRelativeDimension.{u} 1) _ _)
      _ _ D₀.hom (Fin 2) U hU_top
    intro a
    have hfac : (U a).ι ≫ D₀.hom =
        (iso_chart a).hom ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin 1) K)) := by
      rw [← hComp_ι a]
      change (U a).ι ≫ D₀.hom = (iso_chart a).hom ≫ ((iso_chart a).inv ≫ (U a).ι) ≫ D₀.hom
      rw [Category.assoc, Iso.hom_inv_id_assoc]
    rw [hfac]
    have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
        ((iso_chart a).hom ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin 1) K))) :=
      inferInstance
    simpa only [Nat.zero_add] using h01
  have hNotIrrel : ¬ (HomogeneousIdeal.irrelevant 𝒜 ≤ ⊥) := by
    intro hle
    have hX0_irrel : MvPolynomial.X (0 : Fin 2) ∈ HomogeneousIdeal.irrelevant 𝒜 := by
      rw [HomogeneousIdeal.mem_irrelevant_iff]
      exact DirectSum.decompose_of_mem_ne 𝒜 (MvPolynomial.isHomogeneous_X K 0) (by decide)
    have hX0_bot : MvPolynomial.X (0 : Fin 2) ∈ (⊥ : HomogeneousIdeal 𝒜) := hle hX0_irrel
    exact MvPolynomial.X_ne_zero (0 : Fin 2) hX0_bot
  let η₀ : D₀.left := ⟨⊥, Ideal.isPrime_bot, hNotIrrel⟩
  have hη₀_mem : ∀ a : Fin 2, η₀ ∈ U a := by
    intro a
    exact (ProjectiveSpectrum.mem_basicOpen 𝒜 (MvPolynomial.X a) η₀).mpr
      (MvPolynomial.X_ne_zero a)
  have hGeom : AlgebraicGeometry.GeometricallyIrreducible D₀.hom := by
    refine AlgebraicGeometry.GeometricallyIrreducible.mk ?_
    intro K' _ y Z fst snd hpb
    let _ : Algebra K K' := (AlgebraicGeometry.Spec.preimage y).hom.toAlgebra
    have hy_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K')) = y :=
      AlgebraicGeometry.Spec.map_preimage y
    have hSurj_y : AlgebraicGeometry.Surjective y :=
      ⟨fun x => ⟨Classical.arbitrary _, Subsingleton.elim _ x⟩⟩
    have hSurj_fst : AlgebraicGeometry.Surjective fst :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip hSurj_y
    obtain ⟨z₀₁, hz₀₁⟩ := hSurj_fst.1 η₀
    let V : Fin 2 → Z.Opens := fun a => (TopologicalSpace.Opens.map fst.base).obj (U a)
    have hz₀₁_V : ∀ a : Fin 2, z₀₁ ∈ V a := by
      intro a
      change fst.base z₀₁ ∈ U a
      rw [hz₀₁]
      exact hη₀_mem a
    have hPairwise : _root_.Pairwise (Function.onFun (fun x1 x2 => ¬Disjoint x1 x2) V) := by
      intro a₁ a₂ _ hdisj
      have hbot : z₀₁ ∈ (⊥ : Z.Opens) :=
        hdisj.le_bot ⟨hz₀₁_V a₁, hz₀₁_V a₂⟩
      exact hbot
    have hCover : TopologicalSpace.IsOpenCover V := by
      refine TopologicalSpace.IsOpenCover.mk ?_
      rw [eq_top_iff]
      intro z _
      have hzU : fst.base z ∈ (⊤ : D₀.left.Opens) := trivial
      rw [← hU_top, TopologicalSpace.Opens.mem_iSup] at hzU
      obtain ⟨a, ha⟩ := hzU
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ha⟩
    have hPreV : ∀ a : Fin 2, PreirreducibleSpace ↥(V a) := by
      intro a
      let _ := hOpen_ι a
      let W := CategoryTheory.Limits.pullback fst (ι a)
      let p_Z : W ⟶ Z := CategoryTheory.Limits.pullback.fst fst (ι a)
      let p_A : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) K)) :=
        CategoryTheory.Limits.pullback.snd fst (ι a)
      have hpb_outer : CategoryTheory.IsPullback p_A (p_Z ≫ snd)
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K'))) := by
        have h1 := (CategoryTheory.IsPullback.of_hasPullback fst (ι a)).flip.paste_vert hpb
        rwa [hComp_ι a, ← hy_eq] at h1
      let e_tens : MvPolynomial (Fin 1) K' ≃+* TensorProduct K (MvPolynomial (Fin 1) K) K' :=
        (MvPolynomial.algebraTensorAlgEquiv K K').toRingEquiv.symm.trans
          (Algebra.TensorProduct.comm K K' (MvPolynomial (Fin 1) K)).toRingEquiv
      let iso_W : W ≅ AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) K')) :=
        hpb_outer.isoPullback ≪≫
          AlgebraicGeometry.pullbackSpecIso K (MvPolynomial (Fin 1) K) K' ≪≫
          specIsoOfRingEquiv e_tens
      have _ : IrreducibleSpace
          ↥(AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) K'))) :=
        PrimeSpectrum.irreducibleSpace
      have hPre_range : IsPreirreducible (Set.range (iso_W.inv ≫ p_Z).base) := by
        rw [← Set.image_univ]
        exact PreirreducibleSpace.isPreirreducible_univ.image (iso_W.inv ≫ p_Z).base
          (AlgebraicGeometry.Scheme.Hom.continuous (iso_W.inv ≫ p_Z)).continuousOn
      have hRange_eq : Set.range (iso_W.inv ≫ p_Z).base = (V a : Set ↥Z) := by
        rw [hRange_iso_comp iso_W p_Z,
          AlgebraicGeometry.Scheme.Pullback.range_fst, hRange_ι a]
        rfl
      rw [hRange_eq] at hPre_range
      exact Subtype.preirreducibleSpace hPre_range
    have _ : PreirreducibleSpace ↥Z :=
      PreirreducibleSpace.of_isOpenCover hPairwise hCover hPreV
    exact @IrreducibleSpace.mk ↥Z _ _ ⟨z₀₁⟩
  exact ⟨hGeom, hProp, hSm⟩

theorem weil_coinv_geom_const_field_tower_and_galois_sheets (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (a₀ : F) (ha₀ : a₀ ∉ S_aff)
    [IsDomain (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))]
    (B L_fld : ℕ → Type u)
    [∀ r, CommRing (B r)] [∀ r, IsDomain (B r)] [∀ r, Field (L_fld r)]
    [∀ r, Algebra F (B r)] [∀ r, Algebra (Polynomial F) (B r)]
    [∀ r, Algebra
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B r)]
    [∀ r, Algebra F (L_fld r)] [∀ r, Algebra (Polynomial F) (L_fld r)]
    [∀ r, Algebra (RatFunc F) (L_fld r)]
    [∀ r, Algebra (B r) (L_fld r)]
    [∀ r, Algebra
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (L_fld r)]
    [∀ r, IsScalarTower F (Polynomial F) (B r)]
    [∀ r, IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B r)]
    [∀ r, IsScalarTower F (RatFunc F) (L_fld r)]
    [∀ r, IsScalarTower (Polynomial F) (RatFunc F) (L_fld r)]
    [∀ r, IsScalarTower (Polynomial F) (B r) (L_fld r)]
    [∀ r, IsScalarTower
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
      (B r) (L_fld r)]
    [∀ r, Module.Finite
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B r)]
    [∀ r, Algebra.Etale
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B r)]
    [∀ r, IsFractionRing (B r) (L_fld r)]
    [∀ r, IsIntegralClosure (B r)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (L_fld r)]
    (ι_B : ∀ r : ℕ,
      B r →ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))]
        B (r + 1))
    (Q_u : ∀ r : ℕ, Ideal (B r))
    (σ_u : ∀ r : ℕ,
      B r ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B r)
    (hQu : ∀ r : ℕ,
      (Q_u r).IsMaximal ∧
      Ideal.comap (algebraMap (Polynomial F) (B r)) (Q_u r) =
        Ideal.span {Polynomial.X - Polynomial.C a₀} ∧
      ∀ b : B r, (σ_u r).symm b - b ^ Nat.card F ∈ Q_u r)
    (hInj_a : ∀ r : ℕ,
      Function.Injective
        (algebraMap
          (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B r)))
    (m_a : ℕ → ℕ)
    (equiv_Γa : ∀ r : ℕ,
      Fin (m_a r) ≃
        (B r ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))]
          B r))
    (e_a : ∀ r : ℕ,
      Fin (m_a r) →
        TensorProduct
          (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
          (B r) (B r))
    (hIdemp_a : ∀ r : ℕ,
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      (∀ i : Fin (m_a r), e_a r i * e_a r i = e_a r i) ∧
      (∀ i j : Fin (m_a r), i ≠ j → e_a r i * e_a r j = 0) ∧
      (∑ i : Fin (m_a r), e_a r i) = 1 ∧
      (∀ i j : Fin (m_a r),
        Algebra.TensorProduct.lift (AlgHom.id (B r) (B r)) (equiv_Γa r j).symm.toAlgHom
          (fun _ _ => mul_comm _ _) (e_a r i) = if i = j then 1 else 0) ∧
      (∀ (i : Fin (m_a r)) (z : TensorProduct R₀ (B r) (B r)),
        z * e_a r i = TensorProduct.tmul R₀
          (Algebra.TensorProduct.lift (AlgHom.id (B r) (B r)) (equiv_Γa r i).symm.toAlgHom
            (fun _ _ => mul_comm _ _) z) (1 : B r) * e_a r i)) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    let k := AlgebraicClosure F
    let ψ_frob := (@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) k _ _ _).symm
    let R0_bar := TensorProduct F R₀ k
    IsDomain R0_bar ∧
    ∃ (B_bar : ℕ → Type u)
      (_ : ∀ r, CommRing (B_bar r))
      (_ : ∀ r, IsDomain (B_bar r))
      (_ : ∀ r, Algebra R0_bar (B_bar r))
      (_ : ∀ r, Module.Finite R0_bar (B_bar r))
      (_ : ∀ r, Algebra.Etale R0_bar (B_bar r))
      (q_B : ∀ r : ℕ, B r →+* B_bar r)
      (q_k : ∀ r : ℕ, k →+* B_bar r)
      (ι_Bbar : ∀ r : ℕ, B_bar r →ₐ[R0_bar] B_bar (r + 1))
      (φ_frob : ∀ r : ℕ, B_bar r →+* B_bar r)
      (m_g : ℕ → ℕ)
      (equiv_Γg : ∀ r : ℕ, Fin (m_g r) ≃ (B_bar r ≃ₐ[R0_bar] B_bar r))
      (e_bar : ∀ r : ℕ, Fin (m_g r) → TensorProduct R0_bar (B_bar r) (B_bar r)),
      ∀ r : ℕ,
        Function.Injective (algebraMap R0_bar (B_bar r)) ∧
        (∀ (z : R₀) (c : k),
          algebraMap R0_bar (B_bar r) (TensorProduct.tmul F z c) =
            q_B r (algebraMap R₀ (B r) z) * q_k r c) ∧
        (∀ {A : Type u} [CommRing A] (f₁ f₂ : B_bar r →+* A),
          (∀ b : B r, f₁ (q_B r b) = f₂ (q_B r b)) →
          (∀ c : k, f₁ (q_k r c) = f₂ (q_k r c)) →
          f₁ = f₂) ∧
        (∀ b : B r, q_B (r + 1) (ι_B r b) = ι_Bbar r (q_B r b)) ∧
        (∀ b : B r, φ_frob r (q_B r b) = q_B r (σ_u r b)) ∧
        (∀ c : k, φ_frob r (q_k r c) = q_k r (ψ_frob c)) ∧
        (∀ tau_bar : B_bar r ≃ₐ[R0_bar] B_bar r,
          ∃ σ : B r ≃ₐ[R₀] B r,
            (∀ x : B r, IsIntegral F x → σ x = x) ∧
            ∀ b : B r, tau_bar (q_B r b) = q_B r (σ b)) ∧
        (∀ σ : B r ≃ₐ[R₀] B r,
          (∀ x : B r, IsIntegral F x → σ x = x) →
          ∃ sigma_bar : B_bar r ≃ₐ[R0_bar] B_bar r,
            ∀ b : B r, sigma_bar (q_B r b) = q_B r (σ b)) ∧
        (∀ i : Fin (m_g r), e_bar r i * e_bar r i = e_bar r i) ∧
        (∀ i j : Fin (m_g r), i ≠ j → e_bar r i * e_bar r j = 0) ∧
        (∑ i : Fin (m_g r), e_bar r i) = 1 ∧
        (∀ i j : Fin (m_g r),
          Algebra.TensorProduct.lift (AlgHom.id (B_bar r) (B_bar r))
            (equiv_Γg r j).symm.toAlgHom
            (fun _ _ => mul_comm _ _) (e_bar r i) = if i = j then 1 else 0) ∧
        (∀ (i : Fin (m_g r)) (z : TensorProduct R0_bar (B_bar r) (B_bar r)),
          z * e_bar r i = TensorProduct.tmul R0_bar
            (Algebra.TensorProduct.lift (AlgHom.id (B_bar r) (B_bar r))
              (equiv_Γg r i).symm.toAlgHom
              (fun _ _ => mul_comm _ _) z) (1 : B_bar r) * e_bar r i) :=
by
  intro R₀ k ψ_frob R0_bar
  
  let liftRingHom : ∀ (E₀ B₀ k₀ C₀ : Type u) [CommRing E₀] [CommRing B₀]
      [CommRing k₀] [CommRing C₀] [Algebra E₀ B₀] [Algebra E₀ k₀]
      (f_B : B₀ →+* C₀) (f_k : k₀ →+* C₀),
      (∀ x : E₀, f_B (algebraMap E₀ B₀ x) = f_k (algebraMap E₀ k₀ x)) →
      { φ : TensorProduct E₀ B₀ k₀ →+* C₀ //
        ∀ (b : B₀) (c : k₀), φ (TensorProduct.tmul E₀ b c) = f_B b * f_k c } := by
    intro E₀ B₀ k₀ C₀ _ _ _ _ _ _ f_B f_k hcomp
    let _ : Algebra E₀ C₀ := (f_B.comp (algebraMap E₀ B₀)).toAlgebra
    let g_B : B₀ →ₐ[E₀] C₀ := { f_B with commutes' := fun _ => rfl }
    let g_k : k₀ →ₐ[E₀] C₀ := { f_k with commutes' := fun x => (hcomp x).symm }
    exact ⟨(Algebra.TensorProduct.lift g_B g_k (fun _ _ => Commute.all _ _)).toRingHom,
      fun b c => Algebra.TensorProduct.lift_tmul g_B g_k _ b c⟩

  
  have hST_FR0B : ∀ r : ℕ, IsScalarTower F R₀ (B r) := fun r =>
    IsScalarTower.of_algebraMap_eq fun c => by
      rw [IsScalarTower.algebraMap_apply F (Polynomial F) R₀ c,
        ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B r),
        ← IsScalarTower.algebraMap_apply F (Polynomial F) (B r)]
  let _ : ∀ r : ℕ, IsScalarTower F R₀ (B r) := hST_FR0B

  
  have hs1 : ∃ (E : ℕ → Type u)
      (_ : ∀ r, Field (E r))
      (_ : ∀ r, Finite (E r))
      (_ : ∀ r, Algebra F (E r))
      (_ : ∀ r, Algebra (E r) (B r))
      (_ : ∀ r, IsScalarTower F (E r) (B r))
      (_ : ∀ r, Algebra (E r) k)
      (_ : ∀ r, IsScalarTower F (E r) k)
      (ι_E : ∀ r : ℕ, E r →ₐ[F] E (r + 1))
      (σ_E : ∀ r : ℕ, E r →ₐ[F] E r),
      ∀ r : ℕ,
        (∀ b : B r, IsIntegral F b ↔ ∃ x : E r, algebraMap (E r) (B r) x = b) ∧
        (∀ x : E r,
          algebraMap (E (r + 1)) (B (r + 1)) (ι_E r x) = ι_B r (algebraMap (E r) (B r) x)) ∧
        (∀ x : E r, algebraMap (E (r + 1)) k (ι_E r x) = algebraMap (E r) k x) ∧
        (∀ x : E r, algebraMap (E r) (B r) (σ_E r x) = σ_u r (algebraMap (E r) (B r) x)) ∧
        (∀ x : E r, algebraMap (E r) k (σ_E r x) = ψ_frob (algebraMap (E r) k x)) := by
    let g₀ : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)
    let E_sub : ∀ r : ℕ, Subalgebra F (B r) := fun r => integralClosure F (B r)
    let E : ℕ → Type u := fun r => ↥(E_sub r)
    have hIsField : ∀ r : ℕ, IsField (E r) := by
      intro r
      have : Algebra.IsIntegral F (E r) :=
        ⟨fun x => (isIntegral_algHom_iff (E_sub r).val Subtype.val_injective).mp x.2⟩
      have : IsIntegralClosure (E r) F (B r) := integralClosure.isIntegralClosure F (B r)
      exact IsIntegralClosure.isField (A := E r) (B := B r) (Field.toIsField F)
    let instFieldE : ∀ r : ℕ, Field (E r) := fun r => (hIsField r).toField
    let _ : ∀ r : ℕ, Field (E r) := instFieldE
    let instAlgFE : ∀ r : ℕ, Algebra F (E r) := fun r => inferInstance
    let instAlgEB : ∀ r : ℕ, Algebra (E r) (B r) := fun r => inferInstance
    let instST_FEB : ∀ r : ℕ, IsScalarTower F (E r) (B r) := fun r => inferInstance
    have hc₀_ne : g₀.eval a₀ ≠ 0 := by
      dsimp [g₀]
      rw [Polynomial.eval_prod]
      refine Finset.prod_ne_zero_iff.mpr fun s hs => ?_
      rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
      exact sub_ne_zero.mpr fun h => ha₀ (h ▸ hs)
    have hQu_eval : ∀ (r : ℕ) (P : Polynomial F),
        Ideal.Quotient.mk (Q_u r) (algebraMap (Polynomial F) (B r) P) =
          algebraMap F (B r ⧸ Q_u r) (P.eval a₀) := by
      intro r
      let π_Q : B r →+* (B r ⧸ Q_u r) := Ideal.Quotient.mk (Q_u r)
      suffices hhom : π_Q.comp (algebraMap (Polynomial F) (B r)) =
          (algebraMap F (B r ⧸ Q_u r)).comp (Polynomial.evalRingHom a₀) from
        fun P => RingHom.congr_fun hhom P
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C]
        change π_Q (algebraMap (Polynomial F) (B r) (algebraMap F (Polynomial F) c)) = _
        rw [← IsScalarTower.algebraMap_apply F (Polynomial F) (B r) c]
        rfl
      · simp only [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_X]
        have hmem : Polynomial.X - Polynomial.C a₀ ∈
            Ideal.comap (algebraMap (Polynomial F) (B r)) (Q_u r) := by
          rw [(hQu r).2.1]
          exact Ideal.mem_span_singleton_self _
        have hmem' : algebraMap (Polynomial F) (B r) Polynomial.X -
            algebraMap (Polynomial F) (B r) (Polynomial.C a₀) ∈ Q_u r := by
          rw [← map_sub]
          exact hmem
        have heq : π_Q (algebraMap (Polynomial F) (B r) Polynomial.X) =
            π_Q (algebraMap (Polynomial F) (B r) (Polynomial.C a₀)) :=
          sub_eq_zero.mp (by rw [← map_sub]; exact Ideal.Quotient.eq_zero_iff_mem.mpr hmem')
        rw [heq]
        change π_Q (algebraMap (Polynomial F) (B r) (algebraMap F (Polynomial F) a₀)) = _
        rw [← IsScalarTower.algebraMap_apply F (Polynomial F) (B r) a₀]
        rfl
    have hFin_quot : ∀ r : ℕ, Finite (B r ⧸ Q_u r) := by
      intro r
      classical
      let _ : (Q_u r).IsMaximal := (hQu r).1
      let _ : Field (B r ⧸ Q_u r) := Ideal.Quotient.field (Q_u r)
      let π_Q : B r →+* (B r ⧸ Q_u r) := Ideal.Quotient.mk (Q_u r)
      have hR0_in_F : ∀ z : R₀,
          ∃ a : F, π_Q (algebraMap R₀ (B r) z) = algebraMap F (B r ⧸ Q_u r) a := by
        intro z
        obtain ⟨⟨P, m⟩, hzm⟩ := IsLocalization.surj (Submonoid.powers g₀) z
        obtain ⟨n, hn⟩ := m.2
        have h1 : π_Q (algebraMap R₀ (B r) (z * algebraMap (Polynomial F) R₀ m.1)) =
            π_Q (algebraMap R₀ (B r) (algebraMap (Polynomial F) R₀ P)) := by
          rw [hzm]
        rw [map_mul, map_mul, ← hn, map_pow, map_pow, map_pow,
          ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B r) g₀,
          ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B r) P,
          hQu_eval r g₀, hQu_eval r P, ← map_pow] at h1
        refine ⟨P.eval a₀ * ((g₀.eval a₀) ^ n)⁻¹, ?_⟩
        have hcn_ne : (g₀.eval a₀) ^ n ≠ 0 := pow_ne_zero n hc₀_ne
        have hunit : algebraMap F (B r ⧸ Q_u r) ((g₀.eval a₀) ^ n) *
            algebraMap F (B r ⧸ Q_u r) (((g₀.eval a₀) ^ n)⁻¹) = 1 := by
          rw [← map_mul, mul_inv_cancel₀ hcn_ne, map_one]
        calc
          π_Q (algebraMap R₀ (B r) z)
              = π_Q (algebraMap R₀ (B r) z) *
                  (algebraMap F (B r ⧸ Q_u r) ((g₀.eval a₀) ^ n) *
                    algebraMap F (B r ⧸ Q_u r) (((g₀.eval a₀) ^ n)⁻¹)) := by
                rw [hunit, mul_one]
          _ = (π_Q (algebraMap R₀ (B r) z) * algebraMap F (B r ⧸ Q_u r) ((g₀.eval a₀) ^ n)) *
                algebraMap F (B r ⧸ Q_u r) (((g₀.eval a₀) ^ n)⁻¹) := by ring
          _ = algebraMap F (B r ⧸ Q_u r) (P.eval a₀) *
                algebraMap F (B r ⧸ Q_u r) (((g₀.eval a₀) ^ n)⁻¹) := by rw [h1]
          _ = algebraMap F (B r ⧸ Q_u r) (P.eval a₀ * ((g₀.eval a₀) ^ n)⁻¹) := by rw [← map_mul]
      obtain ⟨S_B, hS_B⟩ := Module.Finite.fg_top (R := R₀) (M := B r)
      have hspan_κ : (⊤ : Submodule F (B r ⧸ Q_u r)) ≤
          Submodule.span F ((S_B.image π_Q : Finset (B r ⧸ Q_u r)) : Set (B r ⧸ Q_u r)) := by
        intro y _
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
        have hb : b ∈ Submodule.span R₀ (S_B : Set (B r)) := by
          rw [hS_B]
          exact Submodule.mem_top
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hb
        · intro s hs
          exact Submodule.subset_span
            (Finset.mem_coe.mpr (Finset.mem_image_of_mem π_Q (Finset.mem_coe.mp hs)))
        · change π_Q 0 ∈ _
          rw [map_zero]
          exact Submodule.zero_mem _
        · intro x₁ x₂ _ _ hx₁ hx₂
          change π_Q (x₁ + x₂) ∈ _
          rw [map_add]
          exact Submodule.add_mem _ hx₁ hx₂
        · intro z x₁ _ hx₁
          change π_Q (z • x₁) ∈ _
          rw [Algebra.smul_def, map_mul]
          obtain ⟨a, ha⟩ := hR0_in_F z
          rw [ha, ← Algebra.smul_def]
          exact Submodule.smul_mem _ a hx₁
      let _ : Module.Finite F (B r ⧸ Q_u r) :=
        ⟨⟨S_B.image π_Q, le_antisymm le_top hspan_κ⟩⟩
      exact Module.finite_of_finite F
    have instFinE : ∀ r : ℕ, Finite (E r) := by
      intro r
      let _ : (Q_u r).IsMaximal := (hQu r).1
      let _ : Field (B r ⧸ Q_u r) := Ideal.Quotient.field (Q_u r)
      let _ : Finite (B r ⧸ Q_u r) := hFin_quot r
      let φ_quot : E r →+* (B r ⧸ Q_u r) :=
        (Ideal.Quotient.mk (Q_u r)).comp (algebraMap (E r) (B r))
      exact Finite.of_injective φ_quot φ_quot.injective
    let _ : ∀ r : ℕ, Finite (E r) := instFinE
    let ι_E : ∀ r : ℕ, E r →ₐ[F] E (r + 1) := fun r =>
      { toFun := fun x => ⟨ι_B r x.1, IsIntegral.map (ι_B r) x.2⟩
        map_one' := Subtype.ext (map_one (ι_B r))
        map_mul' := fun x y => Subtype.ext (map_mul (ι_B r) x.1 y.1)
        map_zero' := Subtype.ext (map_zero (ι_B r))
        map_add' := fun x y => Subtype.ext (map_add (ι_B r) x.1 y.1)
        commutes' := fun c => Subtype.ext ((ι_B r).restrictScalars F |>.commutes c) }
    let σ_E : ∀ r : ℕ, E r →ₐ[F] E r := fun r =>
      { toFun := fun x => ⟨σ_u r x.1, IsIntegral.map (σ_u r) x.2⟩
        map_one' := Subtype.ext (map_one (σ_u r))
        map_mul' := fun x y => Subtype.ext (map_mul (σ_u r) x.1 y.1)
        map_zero' := Subtype.ext (map_zero (σ_u r))
        map_add' := fun x y => Subtype.ext (map_add (σ_u r) x.1 y.1)
        commutes' := fun c => Subtype.ext ((σ_u r).toAlgHom.restrictScalars F |>.commutes c) }
    have hσE_pow : ∀ (r : ℕ) (x : E r), (σ_E r x) ^ Nat.card F = x := by
      intro r x
      let _ : (Q_u r).IsMaximal := (hQu r).1
      let _ : Field (B r ⧸ Q_u r) := Ideal.Quotient.field (Q_u r)
      let φ_quot : E r →+* (B r ⧸ Q_u r) :=
        (Ideal.Quotient.mk (Q_u r)).comp (algebraMap (E r) (B r))
      have hsymm_eq : ∀ y : E r,
          (⟨(σ_u r).symm y.1, IsIntegral.map (σ_u r).symm y.2⟩ : E r) = y ^ Nat.card F := by
        intro y
        apply φ_quot.injective
        rw [← sub_eq_zero, ← map_sub]
        change Ideal.Quotient.mk (Q_u r) ((σ_u r).symm y.1 - y.1 ^ Nat.card F) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr ((hQu r).2.2 y.1)
      refine (hsymm_eq (σ_E r x)).symm.trans ?_
      apply Subtype.ext
      exact (σ_u r).symm_apply_apply x.1
    let X_seq : ℕ → Type u := fun r => (E r →ₐ[F] k)
    let f_seq : ∀ r : ℕ, X_seq (r + 1) ⟶ X_seq r :=
      fun r => TypeCat.ofHom (fun φ => φ.comp (ι_E r))
    let F_inv : ℕᵒᵖ ⥤ Type u := CategoryTheory.Functor.ofOpSequence f_seq
    let _ : ∀ j : ℕᵒᵖ, Finite (F_inv.obj j) := fun j =>
      Finite.of_fintype (E j.unop →ₐ[F] k)
    let _ : ∀ j : ℕᵒᵖ, Nonempty (F_inv.obj j) := fun j =>
      let _ : Algebra.IsAlgebraic F (E j.unop) := Algebra.IsAlgebraic.of_finite F (E j.unop)
      ⟨IsAlgClosed.lift (R := F) (S := E j.unop) (M := k)⟩
    obtain ⟨κ_sec, hκ_sec⟩ := nonempty_sections_of_finite_inverse_system F_inv
    let κ : ∀ r : ℕ, E r →ₐ[F] k := fun r => κ_sec (Opposite.op r)
    have hκ_compat : ∀ (r : ℕ) (x : E r), κ (r + 1) (ι_E r x) = κ r x := by
      intro r x
      have hsec_step := hκ_sec (CategoryTheory.homOfLE (Nat.le_succ r)).op
      rw [CategoryTheory.Functor.ofOpSequence_map_homOfLE_succ f_seq r] at hsec_step
      exact AlgHom.congr_fun hsec_step x
    let instAlgEk : ∀ r : ℕ, Algebra (E r) k := fun r => (κ r).toRingHom.toAlgebra
    let instST_FEk : ∀ r : ℕ, IsScalarTower F (E r) k := fun r =>
      let _ : Algebra (E r) k := instAlgEk r
      IsScalarTower.of_algebraMap_eq fun c => ((κ r).commutes c).symm
    refine ⟨E, instFieldE, instFinE, instAlgFE, instAlgEB, instST_FEB,
      instAlgEk, instST_FEk, ι_E, σ_E, fun r => ?_⟩
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · intro b
      exact ⟨fun hb => ⟨⟨b, hb⟩, rfl⟩, fun ⟨x, hx⟩ => hx ▸ x.2⟩
    · intro x
      rfl
    · intro x
      exact hκ_compat r x
    · intro x
      rfl
    · intro x
      change κ r (σ_E r x) = ψ_frob (κ r x)
      let frob_k := @FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) k _ _ _
      have hfrob_eq : frob_k (κ r (σ_E r x)) = κ r x := by
        have happ : frob_k (κ r (σ_E r x)) =
            (κ r (σ_E r x)) ^ (@Fintype.card F (Fintype.ofFinite F)) :=
          @FiniteField.frobeniusAlgEquivOfAlgebraic_apply F _ (Fintype.ofFinite F) k _ _ _ _
        rw [happ, ← @Nat.card_eq_fintype_card F (Fintype.ofFinite F), ← map_pow, hσE_pow r x]
      change _ = frob_k.symm (κ r x)
      rw [← hfrob_eq, AlgEquiv.symm_apply_apply]

  obtain ⟨E, instFieldE, instFinE, instAlgFE, instAlgEB, instST_FEB,
    instAlgEk, instST_FEk, ι_E, σ_E, hE_spec⟩ := hs1
  let _ : ∀ r : ℕ, Field (E r) := instFieldE
  let _ : ∀ r : ℕ, Finite (E r) := instFinE
  let _ : ∀ r : ℕ, Algebra F (E r) := instAlgFE
  let _ : ∀ r : ℕ, Algebra (E r) (B r) := instAlgEB
  let _ : ∀ r : ℕ, IsScalarTower F (E r) (B r) := instST_FEB
  let _ : ∀ r : ℕ, Algebra (E r) k := instAlgEk
  let _ : ∀ r : ℕ, IsScalarTower F (E r) k := instST_FEk

  
  let B_bar : ℕ → Type u := fun r => TensorProduct (E r) (B r) k
  let instCommRingBbar : ∀ r : ℕ, CommRing (B_bar r) := fun _ => inferInstance
  let q_B : ∀ r : ℕ, B r →+* B_bar r :=
    fun r => (Algebra.TensorProduct.includeLeft : B r →ₐ[E r] B_bar r).toRingHom
  let q_k : ∀ r : ℕ, k →+* B_bar r :=
    fun r => (Algebra.TensorProduct.includeRight : k →ₐ[E r] B_bar r).toRingHom
  let φ_R0bar : ∀ r : ℕ,
      { φ : R0_bar →+* B_bar r //
        ∀ (z : R₀) (c : k), φ (TensorProduct.tmul F z c) =
          q_B r (algebraMap R₀ (B r) z) * q_k r c } := fun r =>
    liftRingHom F R₀ k (B_bar r) ((q_B r).comp (algebraMap R₀ (B r))) (q_k r) fun a => by
      rw [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply F R₀ (B r) a,
        IsScalarTower.algebraMap_apply F (E r) (B r) a,
        IsScalarTower.algebraMap_apply F (E r) k a]
      change TensorProduct.tmul (E r) (algebraMap (E r) (B r) (algebraMap F (E r) a)) 1 =
        TensorProduct.tmul (E r) 1 (algebraMap (E r) k (algebraMap F (E r) a))
      rw [Algebra.algebraMap_eq_smul_one (A := B r),
        TensorProduct.smul_tmul (algebraMap F (E r) a) (1 : B r) (1 : k),
        ← Algebra.algebraMap_eq_smul_one]
  let instAlgR0bar : ∀ r : ℕ, Algebra R0_bar (B_bar r) := fun r => (φ_R0bar r).1.toAlgebra
  let _ : ∀ r : ℕ, Algebra R0_bar (B_bar r) := instAlgR0bar
  have hAlg_tmul : ∀ (r : ℕ) (z : R₀) (c : k),
      algebraMap R0_bar (B_bar r) (TensorProduct.tmul F z c) =
        TensorProduct.tmul (E r) (algebraMap R₀ (B r) z) c := by
    intro r z c
    change (φ_R0bar r).1 (TensorProduct.tmul F z c) = _
    rw [(φ_R0bar r).2 z c]
    change TensorProduct.tmul (E r) (algebraMap R₀ (B r) z) 1 * TensorProduct.tmul (E r) 1 c = _
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]

  
  have hs2 : ∀ (E₀ B₀ L₀ : Type u) [Field E₀] [Finite E₀] [CommRing B₀] [IsDomain B₀]
      [Field L₀] [Algebra E₀ B₀] [Algebra B₀ L₀] [Algebra E₀ L₀] [IsScalarTower E₀ B₀ L₀]
      [IsFractionRing B₀ L₀] [Algebra E₀ k] [Algebra.IsAlgebraic E₀ k],
      (∀ z : L₀, IsIntegral E₀ z → ∃ x : E₀, algebraMap E₀ L₀ x = z) →
      IsDomain (TensorProduct E₀ B₀ k) := by
    intro E₀ B₀ L₀ _ _ _ _ _ _ _ _ _ _ _ _ hIntCl_E
    let ι_BL : B₀ →ₐ[E₀] L₀ := IsScalarTower.toAlgHom E₀ B₀ L₀
    have hInj_BL : Function.Injective ι_BL := IsFractionRing.injective B₀ L₀
    let φ_BL : TensorProduct E₀ B₀ k →ₐ[E₀] TensorProduct E₀ L₀ k :=
      Algebra.TensorProduct.map ι_BL (AlgHom.id E₀ k)
    have hφ_eq : φ_BL.toLinearMap = LinearMap.rTensor k ι_BL.toLinearMap :=
      TensorProduct.ext' fun _ _ => rfl
    have hInj_φ : Function.Injective φ_BL := by
      change Function.Injective φ_BL.toLinearMap
      rw [hφ_eq]
      exact Module.Flat.rTensor_preserves_injective_linearMap ι_BL.toLinearMap hInj_BL
    suffices hDom_Lk : IsDomain (TensorProduct E₀ L₀ k) from
      Function.Injective.isDomain φ_BL.toRingHom hInj_φ
    have hNontriv_Lk : Nontrivial (TensorProduct E₀ L₀ k) := by
      let b_k := Module.Basis.ofVectorSpace E₀ k
      have hne_idx : Nonempty (Module.Basis.ofVectorSpaceIndex E₀ k) := by
        by_contra h_empty
        rw [not_nonempty_iff] at h_empty
        have h10 : b_k.repr (1 : k) = b_k.repr (0 : k) := by
          ext i
          exact False.elim (h_empty.false i)
        exact one_ne_zero (b_k.repr.injective h10)
      obtain ⟨i₀⟩ := hne_idx
      let b_Lk := Algebra.TensorProduct.basis L₀ b_k
      refine ⟨⟨b_Lk i₀, 0, fun h => ?_⟩⟩
      have h1 : b_Lk.repr (b_Lk i₀) i₀ = b_Lk.repr 0 i₀ := by rw [h]
      rw [Module.Basis.repr_self, Finsupp.single_eq_same, map_zero, Finsupp.coe_zero,
        Pi.zero_apply] at h1
      exact one_ne_zero h1
    have hIrr_map : ∀ (P : Polynomial E₀), P.Monic → Irreducible P →
        Irreducible (P.map (algebraMap E₀ L₀)) := by
      intro P hMon hIrr
      let P_L := P.map (algebraMap E₀ L₀)
      have hInj_EL : Function.Injective (algebraMap E₀ L₀) := RingHom.injective (algebraMap E₀ L₀)
      have hMon_L : P_L.Monic := hMon.map (algebraMap E₀ L₀)
      have hdeg_pos : 0 < P_L.natDegree := by
        rw [Polynomial.natDegree_map_eq_of_injective hInj_EL]
        exact hIrr.natDegree_pos
      have hnot_unit : ¬ IsUnit P_L := by
        intro hu
        have h0 := Polynomial.natDegree_eq_zero_of_isUnit hu
        omega
      have hMon_descend : ∀ (f : Polynomial L₀), f.Monic → f ∣ P_L →
          ∃ f₀ : Polynomial E₀, f₀.map (algebraMap E₀ L₀) = f := by
        intro f hf_mon ⟨g, hfg⟩
        let Ω := AlgebraicClosure L₀
        let ι_LΩ : L₀ →+* Ω := algebraMap L₀ Ω
        have hInj_LΩ : Function.Injective ι_LΩ := RingHom.injective ι_LΩ
        let f_Ω : Polynomial Ω := f.map ι_LΩ
        have hfΩ_mon : f_Ω.Monic := hf_mon.map ι_LΩ
        have hfΩ_splits : f_Ω.Splits := IsAlgClosed.splits f_Ω
        have hfΩ_prod : f_Ω = (f_Ω.roots.map fun r => Polynomial.X - Polynomial.C r).prod :=
          Polynomial.Splits.eq_prod_roots_of_monic hfΩ_splits hfΩ_mon
        have hroots_int : ∀ r ∈ f_Ω.roots, r ∈ integralClosure E₀ Ω := by
          intro r hr
          have heval_f : f_Ω.eval r = 0 := Polynomial.isRoot_of_mem_roots hr
          have heval_P : (P.map (algebraMap E₀ Ω)).eval r = 0 := by
            have hmap_eq : P.map (algebraMap E₀ Ω) = P_L.map ι_LΩ := by
              dsimp [P_L]
              rw [Polynomial.map_map]
              rfl
            rw [hmap_eq, hfg, Polynomial.map_mul, Polynomial.eval_mul, heval_f, zero_mul]
          refine ⟨P, hMon, ?_⟩
          rwa [Polynomial.eval₂_eq_eval_map]
        have hprod_coeff_int : ∀ (M : Multiset Ω),
            (∀ r ∈ M, r ∈ integralClosure E₀ Ω) →
            ∀ n : ℕ, ((M.map fun r => Polynomial.X - Polynomial.C r).prod).coeff n ∈
              integralClosure E₀ Ω := by
          intro M
          refine Multiset.induction_on M ?_ ?_
          · intro _ n
            simp only [Multiset.map_zero, Multiset.prod_zero, Polynomial.coeff_one]
            split_ifs
            · exact one_mem (integralClosure E₀ Ω)
            · exact zero_mem (integralClosure E₀ Ω)
          · intro r M' ih hM n
            have hr_int : r ∈ integralClosure E₀ Ω := hM r (Multiset.mem_cons_self r M')
            have hM'_int : ∀ s ∈ M', s ∈ integralClosure E₀ Ω :=
              fun s hs => hM s (Multiset.mem_cons_of_mem hs)
            simp only [Multiset.map_cons, Multiset.prod_cons]
            set Q := (M'.map fun s => Polynomial.X - Polynomial.C s).prod
            rw [sub_mul, Polynomial.coeff_sub, Polynomial.coeff_C_mul]
            refine sub_mem ?_ (mul_mem hr_int (ih hM'_int n))
            cases n with
            | zero =>
              rw [Polynomial.coeff_X_mul_zero]
              exact zero_mem (integralClosure E₀ Ω)
            | succ m =>
              rw [Polynomial.coeff_X_mul]
              exact ih hM'_int m
        have hf_coeff_E : ∀ n : ℕ, ∃ a : E₀, algebraMap E₀ L₀ a = f.coeff n := by
          intro n
          have hΩ_int : IsIntegral E₀ (ι_LΩ (f.coeff n)) := by
            have hc : f_Ω.coeff n = ι_LΩ (f.coeff n) := Polynomial.coeff_map ι_LΩ n
            rw [← hc, hfΩ_prod]
            exact hprod_coeff_int f_Ω.roots hroots_int n
          have hL_int : IsIntegral E₀ (f.coeff n) :=
            (isIntegral_algHom_iff (IsScalarTower.toAlgHom E₀ L₀ Ω) hInj_LΩ).mp hΩ_int
          exact hIntCl_E (f.coeff n) hL_int
        choose a ha using hf_coeff_E
        let f₀ : Polynomial E₀ :=
          ∑ n ∈ Finset.range (f.natDegree + 1), Polynomial.C (a n) * Polynomial.X ^ n
        refine ⟨f₀, ?_⟩
        ext n
        rw [Polynomial.coeff_map]
        dsimp [f₀]
        simp only [Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
          mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_range]
        split_ifs with hn
        · exact ha n
        · rw [map_zero]
          exact (Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)).symm
      refine ⟨hnot_unit, fun u v huv => ?_⟩
      have hPL_ne : P_L ≠ 0 := hMon_L.ne_zero
      have hu_ne : u ≠ 0 := fun h => hPL_ne (by change P.map _ = 0; rw [huv, h, zero_mul])
      have hv_ne : v ≠ 0 := fun h => hPL_ne (by change P.map _ = 0; rw [huv, h, mul_zero])
      let cu : L₀ := u.leadingCoeff
      let cv : L₀ := v.leadingCoeff
      have hcu_ne : cu ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hu_ne
      have hcv_ne : cv ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hv_ne
      let f : Polynomial L₀ := u * Polynomial.C cu⁻¹
      let g : Polynomial L₀ := v * Polynomial.C cv⁻¹
      have hf_mon : f.Monic := Polynomial.monic_mul_leadingCoeff_inv hu_ne
      have hg_mon : g.Monic := Polynomial.monic_mul_leadingCoeff_inv hv_ne
      have hcuv : cu * cv = 1 := by
        dsimp [cu, cv]
        rw [← Polynomial.leadingCoeff_mul, ← huv, hMon_L.leadingCoeff]
      have hfg : f * g = P_L := by
        dsimp [f, g]
        calc
          (u * Polynomial.C cu⁻¹) * (v * Polynomial.C cv⁻¹)
              = (u * v) * (Polynomial.C cu⁻¹ * Polynomial.C cv⁻¹) := by ring
          _ = (u * v) * Polynomial.C (cu⁻¹ * cv⁻¹) := by rw [← Polynomial.C_mul]
          _ = P_L * Polynomial.C ((cu * cv)⁻¹) := by
                rw [← mul_inv]
                exact congrArg (· * Polynomial.C ((cu * cv)⁻¹)) huv.symm
          _ = P_L := by rw [hcuv, inv_one, Polynomial.C_1, mul_one]
      obtain ⟨f₀, hf₀⟩ := hMon_descend f hf_mon ⟨g, hfg.symm⟩
      obtain ⟨g₀_p, hg₀_p⟩ := hMon_descend g hg_mon ⟨f, by rw [mul_comm, hfg]⟩
      have hf₀g₀ : P = f₀ * g₀_p := by
        apply Polynomial.map_injective _ hInj_EL
        rw [Polynomial.map_mul, hf₀, hg₀_p, hfg]
      rcases hIrr.isUnit_or_isUnit hf₀g₀ with hu₀ | hv₀
      · left
        have hfu : IsUnit f := by
          rw [← hf₀]
          exact hu₀.map (Polynomial.mapRingHom (algebraMap E₀ L₀))
        have hu_eq : u = f * Polynomial.C cu := by
          dsimp [f]
          rw [mul_assoc, ← Polynomial.C_mul, inv_mul_cancel₀ hcu_ne, Polynomial.C_1, mul_one]
        rw [hu_eq]
        exact hfu.mul (Polynomial.isUnit_C.mpr hcu_ne.isUnit)
      · right
        have hgv : IsUnit g := by
          rw [← hg₀_p]
          exact hv₀.map (Polynomial.mapRingHom (algebraMap E₀ L₀))
        have hv_eq : v = g * Polynomial.C cv := by
          dsimp [g]
          rw [mul_assoc, ← Polynomial.C_mul, inv_mul_cancel₀ hcv_ne, Polynomial.C_1, mul_one]
        rw [hv_eq]
        exact hgv.mul (Polynomial.isUnit_C.mpr hcv_ne.isUnit)
    have hNZD : NoZeroDivisors (TensorProduct E₀ L₀ k) :=
      ⟨fun {u₁ u₂} hu_mul => by
        obtain ⟨S₁, hS₁⟩ := TensorProduct.exists_finset u₁
        obtain ⟨S₂, hS₂⟩ := TensorProduct.exists_finset u₂
        classical
        let S_k : Finset k := S₁.image Prod.snd ∪ S₂.image Prod.snd
        let K₀ : IntermediateField E₀ k := IntermediateField.adjoin E₀ (S_k : Set k)
        have hInt_Sk : ∀ x ∈ (S_k : Set k), IsIntegral E₀ x :=
          fun x _ => (Algebra.IsAlgebraic.isIntegral (K := E₀) (A := k)).isIntegral x
        let _ : FiniteDimensional E₀ ↥K₀ := IntermediateField.finiteDimensional_adjoin hInt_Sk
        have hmem₁ : ∀ p ∈ S₁, p.2 ∈ K₀ := fun p hp =>
          IntermediateField.subset_adjoin E₀ (S_k : Set k)
            (Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_image_of_mem Prod.snd hp)))
        have hmem₂ : ∀ q ∈ S₂, q.2 ∈ K₀ := fun q hq =>
          IntermediateField.subset_adjoin E₀ (S_k : Set k)
            (Finset.mem_coe.mpr (Finset.mem_union_right _ (Finset.mem_image_of_mem Prod.snd hq)))
        let u₁' : TensorProduct E₀ L₀ ↥K₀ :=
          ∑ p ∈ S₁.attach, TensorProduct.tmul E₀ p.1.1 ⟨p.1.2, hmem₁ p.1 p.2⟩
        let u₂' : TensorProduct E₀ L₀ ↥K₀ :=
          ∑ q ∈ S₂.attach, TensorProduct.tmul E₀ q.1.1 ⟨q.1.2, hmem₂ q.1 q.2⟩
        let ι_K : TensorProduct E₀ L₀ ↥K₀ →ₐ[E₀] TensorProduct E₀ L₀ k :=
          Algebra.TensorProduct.map (AlgHom.id E₀ L₀) K₀.val
        have hιK_eq : ι_K.toLinearMap = LinearMap.lTensor L₀ K₀.val.toLinearMap :=
          TensorProduct.ext' fun _ _ => rfl
        have hInj_ιK : Function.Injective ι_K := by
          change Function.Injective ι_K.toLinearMap
          rw [hιK_eq]
          exact Module.Flat.lTensor_preserves_injective_linearMap K₀.val.toLinearMap
            Subtype.val_injective
        have hu₁_map : ι_K u₁' = u₁ := by
          dsimp [u₁', ι_K]
          rw [map_sum, hS₁, ← Finset.sum_attach S₁]
          rfl
        have hu₂_map : ι_K u₂' = u₂ := by
          dsimp [u₂', ι_K]
          rw [map_sum, hS₂, ← Finset.sum_attach S₂]
          rfl
        have hu'_mul : u₁' * u₂' = 0 :=
          hInj_ιK (by rw [map_mul, hu₁_map, hu₂_map, hu_mul, map_zero])
        obtain ⟨α, hα⟩ := Field.exists_primitive_element_of_finite_bot E₀ ↥K₀
        have hα_int : IsIntegral E₀ α := Algebra.IsIntegral.isIntegral α
        let P : Polynomial E₀ := minpoly E₀ α
        have hP_mon : P.Monic := minpoly.monic hα_int
        have hP_irr : Irreducible P := minpoly.irreducible hα_int
        let e_K : AdjoinRoot P ≃ₐ[E₀] ↥K₀ :=
          (IntermediateField.adjoinRootEquivAdjoin E₀ hα_int).trans
            ((IntermediateField.equivOfEq hα).trans IntermediateField.topEquiv)
        let e_TP1 : TensorProduct E₀ L₀ ↥K₀ ≃ₐ[E₀] TensorProduct E₀ L₀ (AdjoinRoot P) :=
          Algebra.TensorProduct.congr (AlgEquiv.refl : L₀ ≃ₐ[E₀] L₀) e_K.symm
        let P_L : Polynomial L₀ := P.map (algebraMap E₀ L₀)
        have hPL_irr : Irreducible P_L := hIrr_map P hP_mon hP_irr
        let _ : Fact (Irreducible P_L) := ⟨hPL_irr⟩
        let _ : Field (AdjoinRoot P_L) := inferInstance
        have hroot_PL : Polynomial.eval₂ ((AdjoinRoot.of P_L).comp (algebraMap E₀ L₀))
            (AdjoinRoot.root P_L) P = 0 := by
          rw [← Polynomial.eval₂_map]
          exact AdjoinRoot.eval₂_root P_L
        let g_AR : AdjoinRoot P →+* AdjoinRoot P_L :=
          AdjoinRoot.lift ((AdjoinRoot.of P_L).comp (algebraMap E₀ L₀))
            (AdjoinRoot.root P_L) hroot_PL
        obtain ⟨Φ_AR, hΦ_AR⟩ := liftRingHom E₀ L₀ (AdjoinRoot P) (AdjoinRoot P_L)
          (AdjoinRoot.of P_L) g_AR fun x => (AdjoinRoot.lift_of hroot_PL).symm
        have hroot_TP : Polynomial.eval₂ (algebraMap L₀ (TensorProduct E₀ L₀ (AdjoinRoot P)))
            (TensorProduct.tmul E₀ (1 : L₀) (AdjoinRoot.root P)) P_L = 0 := by
          let incR : AdjoinRoot P →+* TensorProduct E₀ L₀ (AdjoinRoot P) :=
            (Algebra.TensorProduct.includeRight :
              AdjoinRoot P →ₐ[E₀] TensorProduct E₀ L₀ (AdjoinRoot P)).toRingHom
          have htmul : TensorProduct.tmul E₀ (1 : L₀) (AdjoinRoot.root P) =
              incR (AdjoinRoot.root P) := rfl
          dsimp [P_L]
          rw [Polynomial.eval₂_map]
          have hcomp_eq :
              (algebraMap L₀ (TensorProduct E₀ L₀ (AdjoinRoot P))).comp (algebraMap E₀ L₀) =
                incR.comp (AdjoinRoot.of P) := by
            ext x
            change TensorProduct.tmul E₀ (algebraMap E₀ L₀ x) 1 =
              TensorProduct.tmul E₀ 1 (algebraMap E₀ (AdjoinRoot P) x)
            rw [Algebra.algebraMap_eq_smul_one (A := L₀),
              TensorProduct.smul_tmul x (1 : L₀) (1 : AdjoinRoot P),
              ← Algebra.algebraMap_eq_smul_one]
          rw [hcomp_eq, htmul, ← Polynomial.hom_eval₂, AdjoinRoot.eval₂_root P, map_zero]
        let Ψ_AR : AdjoinRoot P_L →+* TensorProduct E₀ L₀ (AdjoinRoot P) :=
          AdjoinRoot.lift (algebraMap L₀ (TensorProduct E₀ L₀ (AdjoinRoot P)))
            (TensorProduct.tmul E₀ (1 : L₀) (AdjoinRoot.root P)) hroot_TP
        have hΨΦ : ∀ w : TensorProduct E₀ L₀ (AdjoinRoot P), Ψ_AR (Φ_AR w) = w := by
          intro w
          refine TensorProduct.inductionOn (motive := fun w => Ψ_AR (Φ_AR w) = w) w ?_ ?_
          · intro l z
            rw [hΦ_AR l z, map_mul]
            have hl : Ψ_AR (AdjoinRoot.of P_L l) = TensorProduct.tmul E₀ l 1 :=
              AdjoinRoot.lift_of hroot_TP
            have hz : Ψ_AR (g_AR z) = TensorProduct.tmul E₀ 1 z := by
              have hhom_eq : Ψ_AR.comp g_AR =
                  (Algebra.TensorProduct.includeRight :
                    AdjoinRoot P →ₐ[E₀] TensorProduct E₀ L₀ (AdjoinRoot P)).toRingHom := by
                apply AdjoinRoot.ringHom_ext
                · ext x
                  change Ψ_AR (g_AR (AdjoinRoot.of P x)) =
                    TensorProduct.tmul E₀ 1 (algebraMap E₀ (AdjoinRoot P) x)
                  dsimp only [Ψ_AR, g_AR]
                  rw [AdjoinRoot.lift_of hroot_PL, RingHom.comp_apply,
                    AdjoinRoot.lift_of hroot_TP]
                  change TensorProduct.tmul E₀ (algebraMap E₀ L₀ x) 1 =
                    TensorProduct.tmul E₀ 1 (algebraMap E₀ (AdjoinRoot P) x)
                  rw [Algebra.algebraMap_eq_smul_one (A := L₀),
                    TensorProduct.smul_tmul x (1 : L₀) (1 : AdjoinRoot P),
                    ← Algebra.algebraMap_eq_smul_one]
                · dsimp only [Ψ_AR, g_AR]
                  rw [RingHom.comp_apply, AdjoinRoot.lift_root hroot_PL,
                    AdjoinRoot.lift_root hroot_TP]
                  rfl
              exact RingHom.congr_fun hhom_eq z
            rw [hl, hz, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          · intro x y hx hy
            rw [map_add, map_add, hx, hy]
        have hInj_Φ : Function.Injective Φ_AR := Function.HasLeftInverse.injective ⟨Ψ_AR, hΨΦ⟩
        let θ : TensorProduct E₀ L₀ ↥K₀ →+* AdjoinRoot P_L := Φ_AR.comp e_TP1.toRingHom
        have hInj_θ : Function.Injective θ := hInj_Φ.comp e_TP1.injective
        have hθ_mul : θ u₁' * θ u₂' = 0 := by rw [← map_mul, hu'_mul, map_zero]
        rcases mul_eq_zero.mp hθ_mul with h1 | h2
        · left
          rw [← hu₁_map, hInj_θ (h1.trans (map_zero θ).symm), map_zero]
        · right
          rw [← hu₂_map, hInj_θ (h2.trans (map_zero θ).symm), map_zero]⟩
    exact @NoZeroDivisors.to_isDomain (TensorProduct E₀ L₀ k) _ hNontriv_Lk hNZD

  
  have instDomBbar : ∀ r : ℕ, IsDomain (B_bar r) := by
    intro r
    have hST_FFXL : IsScalarTower F (Polynomial F) (L_fld r) :=
      IsScalarTower.of_algebraMap_eq fun a => by
        rw [IsScalarTower.algebraMap_apply F (RatFunc F) (L_fld r) a,
          IsScalarTower.algebraMap_apply F (Polynomial F) (RatFunc F) a,
          ← IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) (L_fld r)]
    let _ : IsScalarTower F (Polynomial F) (L_fld r) := hST_FFXL
    have hST_FBL : IsScalarTower F (B r) (L_fld r) :=
      IsScalarTower.of_algebraMap_eq fun a => by
        rw [IsScalarTower.algebraMap_apply F (Polynomial F) (L_fld r) a,
          IsScalarTower.algebraMap_apply (Polynomial F) (B r) (L_fld r),
          ← IsScalarTower.algebraMap_apply F (Polynomial F) (B r)]
    let _ : IsScalarTower F (B r) (L_fld r) := hST_FBL
    let _ : IsScalarTower F R₀ (L_fld r) :=
      IsScalarTower.of_algebraMap_eq fun a => by
        rw [IsScalarTower.algebraMap_apply F (B r) (L_fld r) a,
          IsScalarTower.algebraMap_apply F R₀ (B r) a,
          ← IsScalarTower.algebraMap_apply R₀ (B r) (L_fld r)]
    let _ : Algebra (E r) (L_fld r) :=
      ((algebraMap (B r) (L_fld r)).comp (algebraMap (E r) (B r))).toAlgebra
    let _ : IsScalarTower (E r) (B r) (L_fld r) := IsScalarTower.of_algebraMap_eq fun _ => rfl
    let _ : IsScalarTower F (E r) (L_fld r) :=
      IsScalarTower.of_algebraMap_eq fun a => by
        rw [IsScalarTower.algebraMap_apply F (B r) (L_fld r) a,
          IsScalarTower.algebraMap_apply F (E r) (B r) a]
        rfl
    let _ : Algebra.IsAlgebraic (E r) k := Algebra.IsAlgebraic.tower_top (K := F) (E r)
    let _ : Algebra.IsIntegral F (E r) := Algebra.IsIntegral.of_finite F (E r)
    refine hs2 (E r) (B r) (L_fld r) fun z hz => ?_
    have hzF : IsIntegral F z := isIntegral_trans z hz
    have hzR0 : IsIntegral R₀ z := IsIntegral.tower_top hzF
    obtain ⟨b, rfl⟩ :=
      (IsIntegralClosure.isIntegral_iff (A := B r) (R := R₀) (B := L_fld r)).mp hzR0
    have hInj_BL : Function.Injective (IsScalarTower.toAlgHom F (B r) (L_fld r)) :=
      IsFractionRing.injective (B r) (L_fld r)
    have hbF : IsIntegral F b :=
      (isIntegral_algHom_iff (IsScalarTower.toAlgHom F (B r) (L_fld r)) hInj_BL).mp hzF
    obtain ⟨x, hx⟩ := ((hE_spec r).1 b).mp hbF
    exact ⟨x, congrArg (algebraMap (B r) (L_fld r)) hx⟩
  let _ : ∀ r : ℕ, IsDomain (B_bar r) := instDomBbar

  
  have hs3 : ∀ r : ℕ,
      Function.Injective (algebraMap R0_bar (B_bar r)) ∧
      Module.Finite R0_bar (B_bar r) ∧
      Algebra.Etale R0_bar (B_bar r) := by
    intro r
    let g₀ : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)
    have hg₀_mon : g₀.Monic :=
      Polynomial.monic_prod_of_monic _ _ fun s _ => Polynomial.monic_X_sub_C s
    have hInj_FR0 : Function.Injective (algebraMap (Polynomial F) R₀) :=
      IsLocalization.injective R₀ (Submonoid.powers_le.mpr hg₀_mon.mem_nonZeroDivisors)
    have hInj_FX : Function.Injective (algebraMap (Polynomial F) (B r)) := by
      intro P₁ P₂ hP
      apply hInj_FR0
      apply hInj_a r
      rwa [← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B r),
        ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B r)]
    let X_B : B r := algebraMap (Polynomial F) (B r) Polynomial.X
    have haeval_FX : (Polynomial.aeval X_B : Polynomial F →ₐ[F] B r) =
        IsScalarTower.toAlgHom F (Polynomial F) (B r) := by
      apply Polynomial.algHom_ext
      simp [X_B]
    have hNotInt_E : ¬ IsIntegral (E r) X_B := by
      intro hIntE
      let _ : Algebra.IsIntegral F (E r) := Algebra.IsIntegral.of_finite F (E r)
      have hIntF : IsIntegral F X_B := isIntegral_trans X_B hIntE
      rcases hIntF with ⟨M, hM_mon, hM_eval⟩
      have hM0 : algebraMap (Polynomial F) (B r) M = 0 := by
        rw [← IsScalarTower.toAlgHom_apply F (Polynomial F) (B r) M, ← haeval_FX]
        exact hM_eval
      exact hM_mon.ne_zero (hInj_FX (hM0.trans (map_zero _).symm))
    let R_E := TensorProduct F R₀ (E r)
    let ψ_E : R_E →ₐ[F] B r :=
      Algebra.TensorProduct.lift
        (IsScalarTower.toAlgHom F R₀ (B r))
        (IsScalarTower.toAlgHom F (E r) (B r))
        (fun _ _ => Commute.all _ _)
    have hInj_ψE : Function.Injective ψ_E := by
      classical
      refine injective_iff_map_eq_zero ψ_E |>.mpr fun u hu => ?_
      let b_E := Module.Basis.ofVectorSpace F (E r)
      let ι_idx := Module.Basis.ofVectorSpaceIndex F (E r)
      let _ : Finite ι_idx := Finite.of_injective b_E b_E.injective
      let _ : Fintype ι_idx := Fintype.ofFinite ι_idx
      let b_RE : Module.Basis ι_idx R₀ R_E := Algebra.TensorProduct.basis R₀ b_E
      have hb_RE_apply : ∀ i : ι_idx, b_RE i = TensorProduct.tmul F (1 : R₀) (b_E i) := by
        intro i
        apply b_RE.repr.injective
        rw [Module.Basis.repr_self, Algebra.TensorProduct.basis_repr_tmul,
          Module.Basis.repr_self, one_smul, Finsupp.mapRange_single, map_one]
      have hu_sum : u = ∑ i : ι_idx, TensorProduct.tmul F (b_RE.repr u i) (b_E i) := by
        conv_lhs => rw [← Module.Basis.sum_repr b_RE u]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [hb_RE_apply i, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      have hψ_sum :
          ∑ i : ι_idx, algebraMap R₀ (B r) (b_RE.repr u i) *
            algebraMap (E r) (B r) (b_E i) = 0 := by
        have h1 := congrArg ψ_E hu_sum
        rw [hu, map_sum] at h1
        exact h1.symm
      have hsurj : ∀ i : ι_idx, ∃ (n : ℕ) (p : Polynomial F),
          (b_RE.repr u i) * (algebraMap (Polynomial F) R₀ g₀) ^ n =
            algebraMap (Polynomial F) R₀ p := by
        intro i
        obtain ⟨⟨p, m⟩, hpm⟩ := IsLocalization.surj (Submonoid.powers g₀) (b_RE.repr u i)
        obtain ⟨n, hn⟩ := m.2
        dsimp only at hn hpm
        exact ⟨n, p, by rw [← map_pow, hn, hpm]⟩
      choose n_i p_i hnp using hsurj
      let N_tot : ℕ := ∑ i : ι_idx, n_i i
      have hn_le : ∀ i : ι_idx, n_i i ≤ N_tot :=
        fun i => Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
      let P_i : ι_idx → Polynomial F := fun i => p_i i * g₀ ^ (N_tot - n_i i)
      have hP_clear : ∀ i : ι_idx,
          (b_RE.repr u i) * (algebraMap (Polynomial F) R₀ g₀) ^ N_tot =
            algebraMap (Polynomial F) R₀ (P_i i) := by
        intro i
        have hsub : n_i i + (N_tot - n_i i) = N_tot := Nat.add_sub_of_le (hn_le i)
        calc
          (b_RE.repr u i) * (algebraMap (Polynomial F) R₀ g₀) ^ N_tot
              = ((b_RE.repr u i) * (algebraMap (Polynomial F) R₀ g₀) ^ (n_i i)) *
                  (algebraMap (Polynomial F) R₀ g₀) ^ (N_tot - n_i i) := by
                rw [mul_assoc, ← pow_add, hsub]
          _ = algebraMap (Polynomial F) R₀ (p_i i) *
                algebraMap (Polynomial F) R₀ (g₀ ^ (N_tot - n_i i)) := by
                rw [hnp i, map_pow]
          _ = algebraMap (Polynomial F) R₀ (P_i i) := by rw [← map_mul]
      have hB_sum : ∑ i : ι_idx,
          algebraMap (Polynomial F) (B r) (P_i i) * algebraMap (E r) (B r) (b_E i) = 0 := by
        calc
          ∑ i : ι_idx, algebraMap (Polynomial F) (B r) (P_i i) *
              algebraMap (E r) (B r) (b_E i)
              = ∑ i : ι_idx,
                  (algebraMap R₀ (B r) (b_RE.repr u i) * algebraMap (E r) (B r) (b_E i)) *
                    algebraMap R₀ (B r) ((algebraMap (Polynomial F) R₀ g₀) ^ N_tot) := by
                refine Finset.sum_congr rfl fun i _ => ?_
                have h1 := congrArg (algebraMap R₀ (B r)) (hP_clear i)
                rw [map_mul, ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B r)] at h1
                rw [← h1]
                ring
          _ = (∑ i : ι_idx, algebraMap R₀ (B r) (b_RE.repr u i) *
                algebraMap (E r) (B r) (b_E i)) *
                algebraMap R₀ (B r) ((algebraMap (Polynomial F) R₀ g₀) ^ N_tot) := by
                rw [← Finset.sum_mul]
          _ = 0 := by rw [hψ_sum, zero_mul]
      let Q : Polynomial (E r) :=
        ∑ i : ι_idx, (P_i i).map (algebraMap F (E r)) * Polynomial.C (b_E i)
      have hQ_eval : Polynomial.aeval X_B Q = 0 := by
        dsimp [Q]
        rw [map_sum, ← hB_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_mul, Polynomial.aeval_map_algebraMap, Polynomial.aeval_C, haeval_FX,
          IsScalarTower.toAlgHom_apply]
      have hQ_zero : Q = 0 := by
        by_contra hQ_ne
        refine hNotInt_E ⟨Q * Polynomial.C Q.leadingCoeff⁻¹,
          Polynomial.monic_mul_leadingCoeff_inv hQ_ne, ?_⟩
        rw [← Polynomial.aeval_def, map_mul, hQ_eval, zero_mul]
      have hPi_zero : ∀ j : ι_idx, P_i j = 0 := by
        intro j
        ext d
        rw [Polynomial.coeff_zero]
        have hcoeff : Q.coeff d = 0 := by rw [hQ_zero, Polynomial.coeff_zero]
        have hQ_d : Q.coeff d = ∑ i : ι_idx, ((P_i i).coeff d) • b_E i := by
          dsimp [Q]
          rw [Polynomial.finsetSum_coeff]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Polynomial.coeff_mul_C, Polynomial.coeff_map, Algebra.smul_def]
        rw [hQ_d] at hcoeff
        have hrepr := congrArg (fun x => b_E.repr x j) hcoeff
        simp only [map_sum, map_smul, Module.Basis.repr_self, smul_eq_mul, map_zero,
          Finsupp.finsetSum_apply, Finsupp.coe_smul, Pi.smul_apply, Finsupp.coe_zero,
          Pi.zero_apply] at hrepr
        simp only [Finsupp.single_apply, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
          Finset.mem_univ, ↓reduceIte] at hrepr
        exact hrepr
      have hg₀_unit : IsUnit ((algebraMap (Polynomial F) R₀ g₀) ^ N_tot) :=
        (IsLocalization.Away.algebraMap_isUnit (S := R₀) g₀).pow N_tot
      have hrepr_zero : b_RE.repr u = 0 := by
        ext j
        rw [Finsupp.coe_zero, Pi.zero_apply]
        have h0 : (b_RE.repr u j) * (algebraMap (Polynomial F) R₀ g₀) ^ N_tot = 0 := by
          rw [hP_clear j, hPi_zero j, map_zero]
        rcases hg₀_unit with ⟨u_g, hu_g⟩
        rw [← hu_g] at h0
        have h0' := congrArg (· * (↑u_g⁻¹ : R₀)) h0
        simp only [mul_assoc, Units.mul_inv, mul_one, zero_mul] at h0'
        exact h0'
      exact b_RE.repr.injective (hrepr_zero.trans (map_zero _).symm)
    have hInj_bar : Function.Injective (algebraMap R0_bar (B_bar r)) := by
      let _ : Algebra (E r) R_E :=
        (Algebra.TensorProduct.includeRight : E r →ₐ[F] R_E).toRingHom.toAlgebra
      let ψ_E_lin : R_E →ₗ[E r] B r :=
        { toFun := ψ_E
          map_add' := map_add ψ_E
          map_smul' := fun y w => by
            change ψ_E (TensorProduct.tmul F 1 y * w) = y • ψ_E w
            have hψy : ψ_E (TensorProduct.tmul F 1 y) = algebraMap (E r) (B r) y := by
              dsimp [ψ_E]
              rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul,
                IsScalarTower.toAlgHom_apply]
            rw [map_mul, hψy, Algebra.smul_def] }
      have hInj_rT : Function.Injective (LinearMap.rTensor k ψ_E_lin) :=
        Module.Flat.rTensor_preserves_injective_linearMap ψ_E_lin hInj_ψE
      let f_R0 : R₀ →+* TensorProduct (E r) R_E k :=
        (Algebra.TensorProduct.includeLeft : R_E →ₐ[E r] TensorProduct (E r) R_E k).toRingHom.comp
          (Algebra.TensorProduct.includeLeft : R₀ →ₐ[F] R_E).toRingHom
      let f_k : k →+* TensorProduct (E r) R_E k :=
        (Algebra.TensorProduct.includeRight : k →ₐ[E r] TensorProduct (E r) R_E k).toRingHom
      obtain ⟨e₀_fwd, he₀_fwd⟩ := liftRingHom F R₀ k (TensorProduct (E r) R_E k)
        f_R0 f_k fun c => by
          change TensorProduct.tmul (E r) (TensorProduct.tmul F (algebraMap F R₀ c) (1 : E r))
              (1 : k) =
            TensorProduct.tmul (E r) (1 : R_E) (algebraMap F k c)
          have h1 : TensorProduct.tmul F (algebraMap F R₀ c) (1 : E r) =
              TensorProduct.tmul F (1 : R₀) (algebraMap F (E r) c) := by
            rw [Algebra.algebraMap_eq_smul_one (A := R₀),
              TensorProduct.smul_tmul c (1 : R₀) (1 : E r), ← Algebra.algebraMap_eq_smul_one]
          rw [h1]
          change TensorProduct.tmul (E r)
            (algebraMap (E r) R_E (algebraMap F (E r) c)) (1 : k) = _
          rw [Algebra.algebraMap_eq_smul_one (A := R_E),
            TensorProduct.smul_tmul (algebraMap F (E r) c) (1 : R_E) (1 : k),
            ← Algebra.algebraMap_eq_smul_one, IsScalarTower.algebraMap_apply F (E r) k]
      let g_RE : R_E →+* R0_bar :=
        (Algebra.TensorProduct.map (AlgHom.id F R₀) (IsScalarTower.toAlgHom F (E r) k)).toRingHom
      let g_k : k →+* R0_bar :=
        (Algebra.TensorProduct.includeRight : k →ₐ[F] R0_bar).toRingHom
      obtain ⟨e₀_inv, he₀_inv⟩ := liftRingHom (E r) R_E k R0_bar g_RE g_k fun _ => rfl
      have he₀_left_inv : ∀ w : R0_bar, e₀_inv (e₀_fwd w) = w := by
        intro w
        refine TensorProduct.inductionOn (motive := fun w => e₀_inv (e₀_fwd w) = w) w ?_ ?_
        · intro z c
          rw [he₀_fwd z c, map_mul]
          change e₀_inv (TensorProduct.tmul (E r) (TensorProduct.tmul F z (1 : E r)) (1 : k)) *
            e₀_inv (TensorProduct.tmul (E r) (1 : R_E) c) = TensorProduct.tmul F z c
          rw [he₀_inv, he₀_inv]
          change (TensorProduct.tmul F z (algebraMap (E r) k 1) *
              TensorProduct.tmul F (1 : R₀) (1 : k)) *
            (g_RE 1 * TensorProduct.tmul F (1 : R₀) c) = TensorProduct.tmul F z c
          rw [map_one, g_RE.map_one, one_mul, Algebra.TensorProduct.tmul_mul_tmul,
            Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_one, one_mul, one_mul]
        · intro x y hx hy
          rw [map_add, map_add, hx, hy]
      have hInj_e₀ : Function.Injective e₀_fwd :=
        Function.HasLeftInverse.injective ⟨e₀_inv, he₀_left_inv⟩
      have hcomp_alg : ∀ w : R0_bar,
          algebraMap R0_bar (B_bar r) w = LinearMap.rTensor k ψ_E_lin (e₀_fwd w) := by
        intro w
        refine TensorProduct.inductionOn
          (motive := fun w =>
            algebraMap R0_bar (B_bar r) w = LinearMap.rTensor k ψ_E_lin (e₀_fwd w))
          w ?_ ?_
        · intro z c
          rw [hAlg_tmul r z c, he₀_fwd z c]
          change _ = LinearMap.rTensor k ψ_E_lin
            (TensorProduct.tmul (E r) (TensorProduct.tmul F z (1 : E r)) (1 : k) *
              TensorProduct.tmul (E r) (1 : R_E) c)
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, LinearMap.rTensor_tmul]
          change _ = TensorProduct.tmul (E r) (ψ_E (TensorProduct.tmul F z 1)) c
          dsimp [ψ_E]
          rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one, IsScalarTower.toAlgHom_apply]
        · intro x y hx hy
          rw [map_add, map_add, map_add, hx, hy]
      intro w₁ w₂ hw
      apply hInj_e₀
      apply hInj_rT
      rwa [← hcomp_alg w₁, ← hcomp_alg w₂]
    have hFinEt : Module.Finite R0_bar (B_bar r) ∧ Algebra.Etale R0_bar (B_bar r) := by
      let _ : Algebra.FormallyEtale F (E r) := Algebra.FormallyEtale.of_isSeparable F (E r)
      let _ : Algebra.FiniteType F (E r) := Module.Finite.finiteType (E r)
      let _ : Algebra.FinitePresentation F (E r) :=
        (Algebra.FinitePresentation.of_finiteType (R := F) (A := E r)).mp inferInstance
      let _ : Algebra.Etale F (E r) := ⟨inferInstance, inferInstance⟩
      let _ : Algebra.Etale R₀ R_E := Algebra.Etale.baseChange F (E r) R₀
      let _ : Algebra R_E (B r) := ψ_E.toRingHom.toAlgebra
      let _ : IsScalarTower R₀ R_E (B r) :=
        { smul_assoc := fun z u b => by
            have hzu : z • u = TensorProduct.tmul F z (1 : E r) * u := by
              refine TensorProduct.inductionOn
                (motive := fun u => z • u = TensorProduct.tmul F z (1 : E r) * u) u ?_ ?_
              · intro z' y
                rw [TensorProduct.smul_tmul', Algebra.TensorProduct.tmul_mul_tmul,
                  smul_eq_mul, one_mul]
              · intro x y hx hy
                rw [smul_add, mul_add, hx, hy]
            rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def]
            change ψ_E (z • u) * b = algebraMap R₀ (B r) z * (ψ_E u * b)
            rw [hzu, map_mul, ← mul_assoc]
            congr 1
            dsimp [ψ_E]
            rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one,
              IsScalarTower.toAlgHom_apply] }
      let _ : Module.Finite R_E (B r) := Module.Finite.of_restrictScalars_finite R₀ R_E (B r)
      let _ : Algebra.Etale R_E (B r) := Algebra.Etale.of_restrictScalars R₀ R_E (B r)
      let _ : Algebra R_E R0_bar :=
        (Algebra.TensorProduct.map (AlgHom.id F R₀)
          (IsScalarTower.toAlgHom F (E r) k)).toRingHom.toAlgebra
      let _ : Algebra.Etale R0_bar (TensorProduct R_E R0_bar (B r)) :=
        Algebra.Etale.baseChange R_E (B r) R0_bar
      let _ : Module.Finite R0_bar (TensorProduct R_E R0_bar (B r)) := inferInstance
      obtain ⟨Φ_bc_ring, hΦ_bc⟩ := liftRingHom R_E R0_bar (B r) (B_bar r)
        (algebraMap R0_bar (B_bar r)) (q_B r) fun u => by
          refine TensorProduct.inductionOn
            (motive := fun u =>
              algebraMap R0_bar (B_bar r) (algebraMap R_E R0_bar u) = q_B r (ψ_E u))
            u ?_ ?_
          · intro z y
            change algebraMap R0_bar (B_bar r) (TensorProduct.tmul F z (algebraMap (E r) k y)) =
              TensorProduct.tmul (E r) (algebraMap R₀ (B r) z * algebraMap (E r) (B r) y) (1 : k)
            rw [hAlg_tmul r z (algebraMap (E r) k y), mul_comm (algebraMap R₀ (B r) z),
              ← Algebra.smul_def, TensorProduct.smul_tmul y (algebraMap R₀ (B r) z) (1 : k),
              Algebra.algebraMap_eq_smul_one (A := k)]
          · intro x y hx hy
            rw [map_add, map_add, map_add, map_add, hx, hy]
      let Φ_bc : TensorProduct R_E R0_bar (B r) →ₐ[R0_bar] B_bar r :=
        { Φ_bc_ring with
          commutes' := fun rbar => by
            change Φ_bc_ring (TensorProduct.tmul R_E rbar 1) = algebraMap R0_bar (B_bar r) rbar
            rw [hΦ_bc rbar 1, map_one, mul_one] }
      let f_B_inv : B r →+* TensorProduct R_E R0_bar (B r) :=
        (Algebra.TensorProduct.includeRight : B r →ₐ[R_E] TensorProduct R_E R0_bar (B r)).toRingHom
      let f_k_inv : k →+* TensorProduct R_E R0_bar (B r) :=
        (Algebra.TensorProduct.includeLeft :
          R0_bar →ₐ[R_E] TensorProduct R_E R0_bar (B r)).toRingHom.comp
          (Algebra.TensorProduct.includeRight : k →ₐ[F] R0_bar).toRingHom
      obtain ⟨Ψ_bc, hΨ_bc⟩ := liftRingHom (E r) (B r) k (TensorProduct R_E R0_bar (B r))
        f_B_inv f_k_inv fun y => by
          change TensorProduct.tmul R_E (1 : R0_bar) (algebraMap (E r) (B r) y) =
            TensorProduct.tmul R_E
              (TensorProduct.tmul F (1 : R₀) (algebraMap (E r) k y)) (1 : B r)
          have h1 : algebraMap (E r) (B r) y =
              algebraMap R_E (B r) (TensorProduct.tmul F (1 : R₀) y) := by
            change _ = ψ_E (TensorProduct.tmul F 1 y)
            dsimp [ψ_E]
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul, IsScalarTower.toAlgHom_apply]
          rw [h1, Algebra.algebraMap_eq_smul_one (A := B r),
            ← TensorProduct.smul_tmul (TensorProduct.tmul F (1 : R₀) y) (1 : R0_bar) (1 : B r),
            Algebra.smul_def, mul_one]
          rfl
      have h_left_inv : ∀ w : TensorProduct R_E R0_bar (B r), Ψ_bc (Φ_bc w) = w := by
        intro w
        refine TensorProduct.inductionOn
          (motive := fun w => Ψ_bc (Φ_bc w) = w) w ?_ ?_
        · intro rbar b
          refine TensorProduct.inductionOn
            (motive := fun rbar =>
              Ψ_bc (Φ_bc (TensorProduct.tmul R_E rbar b)) = TensorProduct.tmul R_E rbar b)
            rbar ?_ ?_
          · intro z c
            change Ψ_bc (Φ_bc_ring (TensorProduct.tmul R_E (TensorProduct.tmul F z c) b)) =
              TensorProduct.tmul R_E (TensorProduct.tmul F z c) b
            rw [hΦ_bc, hAlg_tmul r z c]
            change Ψ_bc (TensorProduct.tmul (E r) (algebraMap R₀ (B r) z) c *
              TensorProduct.tmul (E r) b 1) = _
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, hΨ_bc]
            change TensorProduct.tmul R_E 1 (algebraMap R₀ (B r) z * b) *
              TensorProduct.tmul R_E (TensorProduct.tmul F 1 c) 1 = _
            have hz_eq : algebraMap R₀ (B r) z * b =
                (TensorProduct.tmul F z (1 : E r)) • b := by
              change _ = ψ_E (TensorProduct.tmul F z 1) * b
              dsimp [ψ_E]
              rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one,
                IsScalarTower.toAlgHom_apply]
            rw [hz_eq,
              ← TensorProduct.smul_tmul (TensorProduct.tmul F z (1 : E r)) (1 : R0_bar) b,
              Algebra.smul_def, mul_one]
            change TensorProduct.tmul R_E
                (TensorProduct.tmul F z (algebraMap (E r) k 1)) b *
              TensorProduct.tmul R_E (TensorProduct.tmul F (1 : R₀) c) (1 : B r) = _
            rw [map_one, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
              Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          · intro x y hx hy
            rw [TensorProduct.add_tmul, map_add, map_add, hx, hy]
        · intro x y hx hy
          rw [map_add, map_add, hx, hy]
      have h_right_inv : ∀ w : B_bar r, Φ_bc (Ψ_bc w) = w := by
        intro w
        refine TensorProduct.inductionOn (motive := fun w => Φ_bc (Ψ_bc w) = w) w ?_ ?_
        · intro b c
          rw [hΨ_bc b c, map_mul]
          change Φ_bc_ring (TensorProduct.tmul R_E 1 b) *
            Φ_bc_ring (TensorProduct.tmul R_E (TensorProduct.tmul F 1 c) 1) =
              TensorProduct.tmul (E r) b c
          rw [hΦ_bc, hΦ_bc, map_one, one_mul, map_one, mul_one, hAlg_tmul r 1 c, map_one]
          change TensorProduct.tmul (E r) b 1 * TensorProduct.tmul (E r) 1 c = _
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        · intro x y hx hy
          rw [map_add, map_add, hx, hy]
      let e_bc : TensorProduct R_E R0_bar (B r) ≃ₐ[R0_bar] B_bar r :=
        AlgEquiv.ofBijective Φ_bc ⟨Function.HasLeftInverse.injective ⟨Ψ_bc, h_left_inv⟩,
          Function.HasRightInverse.surjective ⟨Ψ_bc, h_right_inv⟩⟩
      exact ⟨Module.Finite.equiv e_bc.toLinearEquiv,
        @Algebra.Etale.of_equiv R0_bar (TensorProduct R_E R0_bar (B r)) (B_bar r)
          _ _ _ _ _ _ e_bc⟩
    exact ⟨hInj_bar, hFinEt.1, hFinEt.2⟩

  have hDomR0bar : IsDomain R0_bar :=
    Function.Injective.isDomain (algebraMap R0_bar (B_bar 0)) (hs3 0).1
  have instFinBbar : ∀ r : ℕ, Module.Finite R0_bar (B_bar r) := fun r => (hs3 r).2.1
  have instEtBbar : ∀ r : ℕ, Algebra.Etale R0_bar (B_bar r) := fun r => (hs3 r).2.2

  
  have hs4 : ∀ r : ℕ,
      (∀ tau_bar : B_bar r ≃ₐ[R0_bar] B_bar r,
        ∃ σ : B r ≃ₐ[R₀] B r,
          (∀ x : B r, IsIntegral F x → σ x = x) ∧
          ∀ b : B r, tau_bar (q_B r b) = q_B r (σ b)) ∧
      (∀ σ : B r ≃ₐ[R₀] B r,
        (∀ x : B r, IsIntegral F x → σ x = x) →
        ∃ sigma_bar : B_bar r ≃ₐ[R0_bar] B_bar r,
          ∀ b : B r, sigma_bar (q_B r b) = q_B r (σ b)) ∧
      ∃ (m_g : ℕ)
        (equiv_Γg : Fin m_g ≃ (B_bar r ≃ₐ[R0_bar] B_bar r))
        (e_bar : Fin m_g → TensorProduct R0_bar (B_bar r) (B_bar r)),
        (∀ i : Fin m_g, e_bar i * e_bar i = e_bar i) ∧
        (∀ i j : Fin m_g, i ≠ j → e_bar i * e_bar j = 0) ∧
        (∑ i : Fin m_g, e_bar i) = 1 ∧
        (∀ i j : Fin m_g,
          Algebra.TensorProduct.lift (AlgHom.id (B_bar r) (B_bar r))
            (equiv_Γg j).symm.toAlgHom
            (fun _ _ => mul_comm _ _) (e_bar i) = if i = j then 1 else 0) ∧
        (∀ (i : Fin m_g) (z : TensorProduct R0_bar (B_bar r) (B_bar r)),
          z * e_bar i = TensorProduct.tmul R0_bar
            (Algebra.TensorProduct.lift (AlgHom.id (B_bar r) (B_bar r))
              (equiv_Γg i).symm.toAlgHom
              (fun _ _ => mul_comm _ _) z) (1 : B_bar r) * e_bar i) := by
    intro r
    have hR0bar_cross : ∀ rbar : R0_bar,
        TensorProduct.tmul R0_bar (algebraMap R0_bar (B_bar r) rbar) (1 : B_bar r) =
          TensorProduct.tmul R0_bar (1 : B_bar r) (algebraMap R0_bar (B_bar r) rbar) := by
      intro rbar
      rw [Algebra.algebraMap_eq_smul_one rbar]
      exact TensorProduct.smul_tmul rbar (1 : B_bar r) (1 : B_bar r)
    have hqk_alg : ∀ c : k,
        q_k r c = algebraMap R0_bar (B_bar r) (TensorProduct.tmul F 1 c) := by
      intro c
      rw [hAlg_tmul r 1 c, map_one]
      rfl
    have hqB_R0 : ∀ z : R₀,
        q_B r (algebraMap R₀ (B r) z) =
          algebraMap R0_bar (B_bar r) (TensorProduct.tmul F z 1) := by
      intro z
      rw [hAlg_tmul r z 1]
      rfl
    have hqB_E : ∀ y : E r,
        q_B r (algebraMap (E r) (B r) y) =
          algebraMap R0_bar (B_bar r) (TensorProduct.tmul F 1 (algebraMap (E r) k y)) := by
      intro y
      rw [← hqk_alg]
      change TensorProduct.tmul (E r) (algebraMap (E r) (B r) y) 1 =
        TensorProduct.tmul (E r) 1 (algebraMap (E r) k y)
      rw [Algebra.algebraMap_eq_smul_one (A := B r),
        TensorProduct.smul_tmul y (1 : B r) (1 : k), ← Algebra.algebraMap_eq_smul_one]
    let T_bar := TensorProduct R0_bar (B_bar r) (B_bar r)
    let f_L : B r →+* T_bar :=
      (Algebra.TensorProduct.includeLeft : B_bar r →ₐ[R0_bar] T_bar).toRingHom.comp (q_B r)
    let f_R : B r →+* T_bar :=
      (Algebra.TensorProduct.includeRight : B_bar r →ₐ[R0_bar] T_bar).toRingHom.comp (q_B r)
    obtain ⟨Φ₂, hΦ₂⟩ := liftRingHom R₀ (B r) (B r) T_bar f_L f_R fun z => by
      change TensorProduct.tmul R0_bar (q_B r (algebraMap R₀ (B r) z)) 1 =
        TensorProduct.tmul R0_bar 1 (q_B r (algebraMap R₀ (B r) z))
      rw [hqB_R0 z]
      exact hR0bar_cross _
    have hΦ₂_tmul : ∀ b₁ b₂ : B r,
        Φ₂ (TensorProduct.tmul R₀ b₁ b₂) =
          TensorProduct.tmul R0_bar (q_B r b₁) (q_B r b₂) := by
      intro b₁ b₂
      rw [hΦ₂ b₁ b₂]
      change TensorProduct.tmul R0_bar (q_B r b₁) 1 *
        TensorProduct.tmul R0_bar 1 (q_B r b₂) = _
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    have hΦ₂_E_sub : ∀ y : E r,
        Φ₂ (TensorProduct.tmul R₀ (algebraMap (E r) (B r) y) 1 -
          TensorProduct.tmul R₀ 1 (algebraMap (E r) (B r) y)) = 0 := by
      intro y
      rw [map_sub, hΦ₂_tmul, hΦ₂_tmul, map_one, hqB_E y, hR0bar_cross, sub_self]
    let P_geom : (B r ≃ₐ[R₀] B r) → Prop := fun σ => ∀ x : B r, IsIntegral F x → σ x = x
    have hP_symm : ∀ σ : B r ≃ₐ[R₀] B r, P_geom σ → P_geom σ.symm := by
      intro σ hσ x hx
      have hx' : IsIntegral F (σ.symm x) := IsIntegral.map σ.symm hx
      have h1 := hσ (σ.symm x) hx'
      rw [σ.apply_symm_apply] at h1
      exact h1.symm
    have hΦ₂_vanish : ∀ i : Fin (m_a r), ¬ P_geom (equiv_Γa r i) → Φ₂ (e_a r i) = 0 := by
      intro i hnot
      have hnot_symm : ¬ P_geom (equiv_Γa r i).symm :=
        fun hs => hnot ((equiv_Γa r i).symm_symm ▸ hP_symm (equiv_Γa r i).symm hs)
      dsimp [P_geom] at hnot_symm
      push Not at hnot_symm
      rcases hnot_symm with ⟨x₀, hx₀_int, hx₀_ne⟩
      have hsymm_int : IsIntegral F ((equiv_Γa r i).symm x₀) :=
        IsIntegral.map (equiv_Γa r i).symm hx₀_int
      obtain ⟨y₀, hy₀⟩ := ((hE_spec r).1 x₀).mp hx₀_int
      obtain ⟨y₁, hy₁⟩ := ((hE_spec r).1 ((equiv_Γa r i).symm x₀)).mp hsymm_int
      have hy_ne : y₀ - y₁ ≠ 0 := by
        intro h0
        have hy_eq : y₀ = y₁ := sub_eq_zero.mp h0
        exact hx₀_ne (by rw [← hy₁, ← hy₀, hy_eq])
      let w : TensorProduct R₀ (B r) (B r) :=
        TensorProduct.tmul R₀ x₀ 1 - TensorProduct.tmul R₀ 1 x₀
      have hw_ker : Φ₂ w = 0 := by
        dsimp [w]
        rw [← hy₀]
        exact hΦ₂_E_sub y₀
      have habs := (hIdemp_a r).2.2.2.2 i w
      have hμw : Algebra.TensorProduct.lift (AlgHom.id (B r) (B r))
          (equiv_Γa r i).symm.toAlgHom (fun _ _ => mul_comm _ _) w =
            algebraMap (E r) (B r) (y₀ - y₁) := by
        dsimp [w]
        rw [map_sub]
        change x₀ * (equiv_Γa r i).symm 1 - 1 * (equiv_Γa r i).symm x₀ = _
        rw [map_one, mul_one, one_mul, ← hy₁, ← hy₀, map_sub]
      rw [hμw] at habs
      have h0 := congrArg Φ₂ habs
      rw [map_mul, hw_ker, zero_mul, map_mul, hΦ₂_tmul, map_one] at h0
      let u_inv : T_bar :=
        TensorProduct.tmul R0_bar (q_B r (algebraMap (E r) (B r) ((y₀ - y₁)⁻¹))) 1
      calc
        Φ₂ (e_a r i) = 1 * Φ₂ (e_a r i) := (one_mul _).symm
        _ = (u_inv * TensorProduct.tmul R0_bar
              (q_B r (algebraMap (E r) (B r) (y₀ - y₁))) 1) * Φ₂ (e_a r i) := by
            dsimp [u_inv]
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← map_mul, ← map_mul,
              inv_mul_cancel₀ hy_ne, map_one, map_one]
            rfl
        _ = u_inv * (TensorProduct.tmul R0_bar
              (q_B r (algebraMap (E r) (B r) (y₀ - y₁))) 1 * Φ₂ (e_a r i)) := by ring
        _ = u_inv * 0 := by rw [← h0]
        _ = 0 := mul_zero _
    let liftGeomAut : ∀ (σ : B r ≃ₐ[R₀] B r), P_geom σ → (B_bar r ≃ₐ[R0_bar] B_bar r) :=
      fun σ hσ =>
        let hσ_E : ∀ y : E r, σ (algebraMap (E r) (B r) y) = algebraMap (E r) (B r) y :=
          fun y => hσ (algebraMap (E r) (B r) y) (((hE_spec r).1 _).mpr ⟨y, rfl⟩)
        let σ_E : B r ≃ₐ[E r] B r := { σ.toRingEquiv with commutes' := hσ_E }
        let e_E : B_bar r ≃ₐ[E r] B_bar r :=
          Algebra.TensorProduct.congr σ_E (AlgEquiv.refl : k ≃ₐ[E r] k)
        { e_E.toRingEquiv with
          commutes' := fun w => by
            refine TensorProduct.inductionOn
              (motive := fun w =>
                e_E (algebraMap R0_bar (B_bar r) w) = algebraMap R0_bar (B_bar r) w)
              w ?_ ?_
            · intro z c
              rw [hAlg_tmul r z c]
              change TensorProduct.tmul (E r) (σ (algebraMap R₀ (B r) z)) c = _
              rw [σ.commutes z]
            · intro x y hx hy
              rw [map_add, map_add, hx, hy] }
    have hlift_qB : ∀ (σ : B r ≃ₐ[R₀] B r) (hσ : P_geom σ) (b : B r),
        liftGeomAut σ hσ (q_B r b) = q_B r (σ b) := fun _ _ _ => rfl
    have hlift_symm : ∀ (σ : B r ≃ₐ[R₀] B r) (hσ : P_geom σ),
        (liftGeomAut σ hσ).symm = liftGeomAut σ.symm (hP_symm σ hσ) := by
      intro σ hσ
      apply AlgEquiv.ext
      intro w
      refine TensorProduct.inductionOn
        (motive := fun w => (liftGeomAut σ hσ).symm w = liftGeomAut σ.symm (hP_symm σ hσ) w)
        w ?_ ?_
      · intro b c
        apply (liftGeomAut σ hσ).injective
        rw [AlgEquiv.apply_symm_apply]
        change TensorProduct.tmul (E r) b c = TensorProduct.tmul (E r) (σ (σ.symm b)) c
        rw [σ.apply_symm_apply]
      · intro x y hx hy
        rw [map_add, map_add, hx, hy]
    let μ_bar : (B_bar r ≃ₐ[R0_bar] B_bar r) → (T_bar →ₐ[B_bar r] B_bar r) := fun τ =>
      Algebra.TensorProduct.lift (AlgHom.id (B_bar r) (B_bar r)) τ.symm.toAlgHom
        (fun _ _ => mul_comm _ _)
    have hμ_Φ₂ : ∀ (σ : B r ≃ₐ[R₀] B r) (hσ : P_geom σ) (z : TensorProduct R₀ (B r) (B r)),
        μ_bar (liftGeomAut σ hσ) (Φ₂ z) =
          q_B r (Algebra.TensorProduct.lift (AlgHom.id (B r) (B r)) σ.symm.toAlgHom
            (fun _ _ => mul_comm _ _) z) := by
      intro σ hσ z
      refine TensorProduct.inductionOn
        (motive := fun z =>
          μ_bar (liftGeomAut σ hσ) (Φ₂ z) =
            q_B r (Algebra.TensorProduct.lift (AlgHom.id (B r) (B r)) σ.symm.toAlgHom
              (fun _ _ => mul_comm _ _) z))
        z ?_ ?_
      · intro b₁ b₂
        rw [hΦ₂_tmul]
        change q_B r b₁ * (liftGeomAut σ hσ).symm (q_B r b₂) = q_B r (b₁ * σ.symm b₂)
        rw [hlift_symm σ hσ, map_mul]
        rfl
      · intro x y hx hy
        rw [map_add, map_add, map_add, map_add, hx, hy]
    have habs_geom : ∀ (i : Fin (m_a r)) (hi : P_geom (equiv_Γa r i)) (z : T_bar),
        z * Φ₂ (e_a r i) =
          TensorProduct.tmul R0_bar
            (μ_bar (liftGeomAut (equiv_Γa r i) hi) z) (1 : B_bar r) * Φ₂ (e_a r i) := by
      intro i hi
      let τ_i := liftGeomAut (equiv_Γa r i) hi
      let P_abs : T_bar → Prop := fun z =>
        z * Φ₂ (e_a r i) = TensorProduct.tmul R0_bar (μ_bar τ_i z) 1 * Φ₂ (e_a r i)
      have hadd : ∀ z₁ z₂, P_abs z₁ → P_abs z₂ → P_abs (z₁ + z₂) := by
        intro z₁ z₂ hz₁ hz₂
        dsimp [P_abs] at hz₁ hz₂ ⊢
        rw [add_mul, hz₁, hz₂, map_add, TensorProduct.add_tmul, add_mul]
      have hmul : ∀ z₁ z₂, P_abs z₁ → P_abs z₂ → P_abs (z₁ * z₂) := by
        intro z₁ z₂ hz₁ hz₂
        dsimp [P_abs] at hz₁ hz₂ ⊢
        calc
          (z₁ * z₂) * Φ₂ (e_a r i) = z₁ * (z₂ * Φ₂ (e_a r i)) := mul_assoc _ _ _
          _ = z₁ * (TensorProduct.tmul R0_bar (μ_bar τ_i z₂) 1 * Φ₂ (e_a r i)) := by rw [hz₂]
          _ = TensorProduct.tmul R0_bar (μ_bar τ_i z₂) 1 * (z₁ * Φ₂ (e_a r i)) := by ring
          _ = TensorProduct.tmul R0_bar (μ_bar τ_i z₂) 1 *
                (TensorProduct.tmul R0_bar (μ_bar τ_i z₁) 1 * Φ₂ (e_a r i)) := by rw [hz₁]
          _ = (TensorProduct.tmul R0_bar (μ_bar τ_i z₁) 1 *
                TensorProduct.tmul R0_bar (μ_bar τ_i z₂) 1) * Φ₂ (e_a r i) := by ring
          _ = TensorProduct.tmul R0_bar (μ_bar τ_i (z₁ * z₂)) 1 * Φ₂ (e_a r i) := by
              rw [map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
      have hleft : ∀ u : B_bar r, P_abs (TensorProduct.tmul R0_bar u 1) := by
        intro u
        dsimp [P_abs]
        have hμu : μ_bar τ_i (TensorProduct.tmul R0_bar u 1) = u := by
          change u * τ_i.symm 1 = u
          rw [map_one, mul_one]
        rw [hμu]
      have hright_qB : ∀ b : B r, P_abs (TensorProduct.tmul R0_bar 1 (q_B r b)) := by
        intro b
        dsimp [P_abs]
        have h1 : TensorProduct.tmul R0_bar (1 : B_bar r) (q_B r b) =
            Φ₂ (TensorProduct.tmul R₀ 1 b) := by
          rw [hΦ₂_tmul, map_one]
        rw [h1, ← map_mul, (hIdemp_a r).2.2.2.2 i (TensorProduct.tmul R₀ 1 b),
          map_mul, hΦ₂_tmul, map_one, hμ_Φ₂ (equiv_Γa r i) hi]
      have hright_qk : ∀ c : k, P_abs (TensorProduct.tmul R0_bar 1 (q_k r c)) := by
        intro c
        have h1 : TensorProduct.tmul R0_bar (1 : B_bar r) (q_k r c) =
            TensorProduct.tmul R0_bar (q_k r c) 1 := by
          rw [hqk_alg c, ← hR0bar_cross]
        rw [h1]
        exact hleft (q_k r c)
      have hright : ∀ u₂ : B_bar r, P_abs (TensorProduct.tmul R0_bar 1 u₂) := by
        intro u₂
        refine TensorProduct.inductionOn
          (motive := fun u₂ => P_abs (TensorProduct.tmul R0_bar 1 u₂)) u₂ ?_ ?_
        · intro b c
          have hbc : TensorProduct.tmul (E r) b c = q_B r b * q_k r c := by
            change _ = TensorProduct.tmul (E r) b 1 * TensorProduct.tmul (E r) 1 c
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          have hbc' : TensorProduct.tmul R0_bar (1 : B_bar r) (TensorProduct.tmul (E r) b c) =
              TensorProduct.tmul R0_bar 1 (q_B r b) *
                TensorProduct.tmul R0_bar 1 (q_k r c) := by
            rw [hbc, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
          rw [hbc']
          exact hmul _ _ (hright_qB b) (hright_qk c)
        · intro x y hx hy
          rw [TensorProduct.tmul_add]
          exact hadd _ _ hx hy
      intro z
      refine TensorProduct.inductionOn (motive := P_abs) z ?_ hadd
      intro u₁ u₂
      have hu : TensorProduct.tmul R0_bar u₁ u₂ =
          TensorProduct.tmul R0_bar u₁ 1 * TensorProduct.tmul R0_bar 1 u₂ := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [hu]
      exact hmul _ _ (hleft u₁) (hright u₂)
    classical
    let J_geom : Finset (Fin (m_a r)) := Finset.univ.filter (fun i => P_geom (equiv_Γa r i))
    have hsum_J : ∑ i ∈ J_geom, Φ₂ (e_a r i) = 1 := by
      have h1 := congrArg Φ₂ (hIdemp_a r).2.2.1
      rw [map_sum, map_one, ← Finset.sum_filter_add_sum_filter_not Finset.univ
        (fun i : Fin (m_a r) => P_geom (equiv_Γa r i))] at h1
      have hnot0 : ∑ i ∈ Finset.univ.filter (fun i : Fin (m_a r) => ¬ P_geom (equiv_Γa r i)),
          Φ₂ (e_a r i) = 0 :=
        Finset.sum_eq_zero fun i hi => hΦ₂_vanish i (Finset.mem_filter.mp hi).2
      rw [hnot0, add_zero] at h1
      exact h1
    have htau_surj : ∀ tau_bar : B_bar r ≃ₐ[R0_bar] B_bar r,
        ∃ i : ↥J_geom,
          tau_bar = liftGeomAut (equiv_Γa r i.1) (Finset.mem_filter.mp i.2).2 := by
      intro tau_bar
      have hsum_eval : ∑ i ∈ J_geom, μ_bar tau_bar (Φ₂ (e_a r i)) = 1 := by
        rw [← map_sum, hsum_J, map_one]
      have hex_ne : ∃ i ∈ J_geom, μ_bar tau_bar (Φ₂ (e_a r i)) ≠ 0 := by
        by_contra h_all0
        push Not at h_all0
        rw [Finset.sum_eq_zero h_all0] at hsum_eval
        exact one_ne_zero hsum_eval.symm
      rcases hex_ne with ⟨i₀, hi₀_mem, hi₀_ne⟩
      have hi₀_geom : P_geom (equiv_Γa r i₀) := (Finset.mem_filter.mp hi₀_mem).2
      have hv_idem : μ_bar tau_bar (Φ₂ (e_a r i₀)) * μ_bar tau_bar (Φ₂ (e_a r i₀)) =
          μ_bar tau_bar (Φ₂ (e_a r i₀)) := by
        rw [← map_mul, ← map_mul, (hIdemp_a r).1 i₀]
      have hv_one : μ_bar tau_bar (Φ₂ (e_a r i₀)) = 1 := by
        have hmul0 : μ_bar tau_bar (Φ₂ (e_a r i₀)) *
            (μ_bar tau_bar (Φ₂ (e_a r i₀)) - 1) = 0 := by
          rw [mul_sub, mul_one, hv_idem, sub_self]
        rcases mul_eq_zero.mp hmul0 with hv0 | hv1
        · exact False.elim (hi₀_ne hv0)
        · exact sub_eq_zero.mp hv1
      refine ⟨⟨i₀, hi₀_mem⟩, ?_⟩
      have hsymm_eq : ∀ u : B_bar r,
          tau_bar.symm u = (liftGeomAut (equiv_Γa r i₀) hi₀_geom).symm u := by
        intro u
        have habs := congrArg (μ_bar tau_bar)
          (habs_geom i₀ hi₀_geom (TensorProduct.tmul R0_bar 1 u))
        rw [map_mul, map_mul, hv_one, mul_one, mul_one] at habs
        have hl : μ_bar tau_bar (TensorProduct.tmul R0_bar 1 u) = tau_bar.symm u := by
          change 1 * tau_bar.symm u = _
          exact one_mul _
        have hr : μ_bar tau_bar
            (TensorProduct.tmul R0_bar (μ_bar (liftGeomAut (equiv_Γa r i₀) hi₀_geom)
              (TensorProduct.tmul R0_bar 1 u)) 1) =
            (liftGeomAut (equiv_Γa r i₀) hi₀_geom).symm u := by
          change (1 * (liftGeomAut (equiv_Γa r i₀) hi₀_geom).symm u) * tau_bar.symm 1 = _
          rw [map_one, mul_one, one_mul]
        rw [hl, hr] at habs
        exact habs
      apply AlgEquiv.ext
      intro u
      apply tau_bar.symm.injective
      rw [tau_bar.symm_apply_apply, hsymm_eq, AlgEquiv.symm_apply_apply]
    have htau_inj : Function.Injective
        (fun i : ↥J_geom =>
          liftGeomAut (equiv_Γa r i.1) (Finset.mem_filter.mp i.2).2) := by
      intro i₁ i₂ heq
      dsimp only at heq
      apply Subtype.ext
      have h1 : μ_bar (liftGeomAut (equiv_Γa r i₁.1) (Finset.mem_filter.mp i₁.2).2)
          (Φ₂ (e_a r i₁.1)) =
        μ_bar (liftGeomAut (equiv_Γa r i₂.1) (Finset.mem_filter.mp i₂.2).2)
          (Φ₂ (e_a r i₁.1)) := by
        rw [heq]
      rw [hμ_Φ₂, hμ_Φ₂, (hIdemp_a r).2.2.2.1 i₁.1 i₁.1,
        (hIdemp_a r).2.2.2.1 i₁.1 i₂.1] at h1
      simp only [↓reduceIte, map_one] at h1
      by_contra hne
      simp only [hne, ↓reduceIte, map_zero] at h1
      exact one_ne_zero h1
    refine ⟨?_, ?_, ?_⟩
    · intro tau_bar
      obtain ⟨i, rfl⟩ := htau_surj tau_bar
      exact ⟨equiv_Γa r i.1, (Finset.mem_filter.mp i.2).2,
        fun b => hlift_qB (equiv_Γa r i.1) (Finset.mem_filter.mp i.2).2 b⟩
    · intro σ hσ
      exact ⟨liftGeomAut σ hσ, fun b => hlift_qB σ hσ b⟩
    · let m_g : ℕ := J_geom.card
      let e_fin : Fin m_g ≃ ↥J_geom := (Finset.equivFin J_geom).symm
      let e_aut : ↥J_geom ≃ (B_bar r ≃ₐ[R0_bar] B_bar r) :=
        Equiv.ofBijective
          (fun i : ↥J_geom => liftGeomAut (equiv_Γa r i.1) (Finset.mem_filter.mp i.2).2)
          ⟨htau_inj, fun τ => by obtain ⟨i, hi⟩ := htau_surj τ; exact ⟨i, hi.symm⟩⟩
      let equiv_Γg : Fin m_g ≃ (B_bar r ≃ₐ[R0_bar] B_bar r) := e_fin.trans e_aut
      let e_bar : Fin m_g → T_bar := fun i => Φ₂ (e_a r (e_fin i).1)
      refine ⟨m_g, equiv_Γg, e_bar, ?_, ?_, ?_, ?_, ?_⟩
      · intro i
        dsimp [e_bar]
        rw [← map_mul, (hIdemp_a r).1]
      · intro i j hij
        dsimp [e_bar]
        have hne : (e_fin i).1 ≠ (e_fin j).1 :=
          fun h => hij (e_fin.injective (Subtype.ext h))
        rw [← map_mul, (hIdemp_a r).2.1 _ _ hne, map_zero]
      · dsimp [e_bar]
        rw [← hsum_J, ← Finset.sum_attach J_geom]
        exact Equiv.sum_comp e_fin (fun x : ↥J_geom => Φ₂ (e_a r x.1))
      · intro i j
        change μ_bar (equiv_Γg j) (Φ₂ (e_a r (e_fin i).1)) = if i = j then 1 else 0
        have hΓj : equiv_Γg j =
            liftGeomAut (equiv_Γa r (e_fin j).1) (Finset.mem_filter.mp (e_fin j).2).2 := rfl
        rw [hΓj, hμ_Φ₂, (hIdemp_a r).2.2.2.1]
        by_cases hij : i = j
        · subst hij
          simp only [↓reduceIte, map_one]
        · have hne : (e_fin i).1 ≠ (e_fin j).1 :=
            fun h => hij (e_fin.injective (Subtype.ext h))
          simp only [hne, hij, ↓reduceIte, map_zero]
      · intro i z
        exact habs_geom (e_fin i).1 (Finset.mem_filter.mp (e_fin i).2).2 z

  choose m_g equiv_Γg e_bar hIdemp_g using fun r => (hs4 r).2.2

  
  let ι_Bbar_raw : ∀ r : ℕ,
      { φ : B_bar r →+* B_bar (r + 1) //
        ∀ (b : B r) (c : k), φ (TensorProduct.tmul (E r) b c) =
          q_B (r + 1) (ι_B r b) * q_k (r + 1) c } := fun r =>
    liftRingHom (E r) (B r) k (B_bar (r + 1))
      ((q_B (r + 1)).comp (ι_B r).toRingHom) (q_k (r + 1)) fun x => by
        change q_B (r + 1) (ι_B r (algebraMap (E r) (B r) x)) =
          q_k (r + 1) (algebraMap (E r) k x)
        rw [← (hE_spec r).2.1 x, ← (hE_spec r).2.2.1 x]
        change TensorProduct.tmul (E (r + 1))
            (algebraMap (E (r + 1)) (B (r + 1)) (ι_E r x)) 1 =
          TensorProduct.tmul (E (r + 1)) 1 (algebraMap (E (r + 1)) k (ι_E r x))
        rw [Algebra.algebraMap_eq_smul_one (A := B (r + 1)),
          TensorProduct.smul_tmul (ι_E r x) (1 : B (r + 1)) (1 : k),
          ← Algebra.algebraMap_eq_smul_one]
  let ι_Bbar : ∀ r : ℕ, B_bar r →ₐ[R0_bar] B_bar (r + 1) := fun r =>
    { (ι_Bbar_raw r).1 with
      commutes' := fun w => by
        refine TensorProduct.inductionOn
          (motive := fun w =>
            (ι_Bbar_raw r).1 (algebraMap R0_bar (B_bar r) w) =
              algebraMap R0_bar (B_bar (r + 1)) w)
          w ?_ ?_
        · intro z c
          rw [hAlg_tmul r z c, (ι_Bbar_raw r).2, (ι_B r).commutes z]
          exact ((φ_R0bar (r + 1)).2 z c).symm
        · intro x y hx hy
          rw [map_add, map_add, map_add, hx, hy] }

  let φ_frob_raw : ∀ r : ℕ,
      { φ : B_bar r →+* B_bar r //
        ∀ (b : B r) (c : k), φ (TensorProduct.tmul (E r) b c) =
          q_B r (σ_u r b) * q_k r (ψ_frob c) } := fun r =>
    liftRingHom (E r) (B r) k (B_bar r)
      ((q_B r).comp (σ_u r).toRingHom) ((q_k r).comp ψ_frob.toRingHom) fun x => by
        change q_B r (σ_u r (algebraMap (E r) (B r) x)) =
          q_k r (ψ_frob (algebraMap (E r) k x))
        rw [← (hE_spec r).2.2.2.1 x, ← (hE_spec r).2.2.2.2 x]
        change TensorProduct.tmul (E r) (algebraMap (E r) (B r) (σ_E r x)) 1 =
          TensorProduct.tmul (E r) 1 (algebraMap (E r) k (σ_E r x))
        rw [Algebra.algebraMap_eq_smul_one (A := B r),
          TensorProduct.smul_tmul (σ_E r x) (1 : B r) (1 : k),
          ← Algebra.algebraMap_eq_smul_one]
  let φ_frob : ∀ r : ℕ, B_bar r →+* B_bar r := fun r => (φ_frob_raw r).1

  refine ⟨hDomR0bar, B_bar, instCommRingBbar, instDomBbar, instAlgR0bar,
    instFinBbar, instEtBbar, q_B, q_k, ι_Bbar, φ_frob, m_g, equiv_Γg, e_bar, fun r => ?_⟩
  refine ⟨(hs3 r).1, (φ_R0bar r).2, ?_, ?_, ?_, ?_, (hs4 r).1, (hs4 r).2.1,
    (hIdemp_g r).1, (hIdemp_g r).2.1, (hIdemp_g r).2.2.1, (hIdemp_g r).2.2.2.1,
    (hIdemp_g r).2.2.2.2⟩
  · intro A _ f₁ f₂ hfB hfk
    apply RingHom.ext
    intro w
    refine TensorProduct.inductionOn (motive := fun w => f₁ w = f₂ w) w ?_ ?_
    · intro b c
      have hbc : TensorProduct.tmul (E r) b c = q_B r b * q_k r c := by
        change _ = TensorProduct.tmul (E r) b 1 * TensorProduct.tmul (E r) 1 c
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [hbc, map_mul, map_mul, hfB b, hfk c]
    · intro x y hx hy
      rw [map_add, map_add, hx, hy]
  · intro b
    change q_B (r + 1) (ι_B r b) = (ι_Bbar_raw r).1 (TensorProduct.tmul (E r) b 1)
    rw [(ι_Bbar_raw r).2 b 1, map_one, mul_one]
  · intro b
    change (φ_frob_raw r).1 (TensorProduct.tmul (E r) b 1) = q_B r (σ_u r b)
    rw [(φ_frob_raw r).2 b 1, map_one, map_one, mul_one]
  · intro c
    change (φ_frob_raw r).1 (TensorProduct.tmul (E r) 1 c) = q_k r (ψ_frob c)
    rw [(φ_frob_raw r).2 1 c, map_one, map_one, one_mul]

