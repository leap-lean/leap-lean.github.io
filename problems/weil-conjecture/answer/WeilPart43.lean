          let mor_W : ∀ idx : Unit ⊕ C_vec, obj_W idx ⟶ W := fun idx =>
            match idx with
            | Sum.inl () => CategoryTheory.MorphismProperty.Over.homMk W₀.ι rfl trivial
            | Sum.inr c =>
                let O_c : W_0.Opens := ⟨f_W ⁻¹' {c}, f_W.isLocallyConstant {c}⟩
                CategoryTheory.MorphismProperty.Over.homMk (O_c.ι ≫ fst_W) rfl trivial
          let obj_BW : Unit ⊕ C_vec → Y.Etale := fun idx => B_h.obj (obj_W idx)
          let mor_BW : ∀ idx : Unit ⊕ C_vec, obj_BW idx ⟶ B_h.obj W :=
            fun idx => B_h.map (mor_W idx)
          let S_BW := CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows obj_BW mor_BW)
          have hSBW_mem : S_BW ∈ Y.smallEtaleTopology (B_h.obj W) := by
            refine (hMemSite Y (B_h.obj W) _).mpr fun e => ?_
            let p_W : (Fgt_Y.obj (B_h.obj W)).left ⟶ (Fgt_D.obj W).left :=
              CategoryTheory.Limits.pullback.fst h_W h
            let h_E : (Fgt_Y.obj (B_h.obj W)).left ⟶ Y :=
              CategoryTheory.Limits.pullback.snd h_W h
            have hx_top : p_W.base e ∈ (((TopologicalSpace.Opens.map h_W.base).obj U₀) ⊔ W₀) := by
              rw [hW₀_top]; trivial
            have hLiftArrow : ∀ (idx : Unit ⊕ C_vec) (x_i : ↥(Fgt_D.obj (obj_W idx)).left),
