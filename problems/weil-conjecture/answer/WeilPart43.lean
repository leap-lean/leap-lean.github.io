              rw [h_12, h_1, h_2,
                ← hpsi_nat q_p (s_Y (c₁ + c₂)),
                ← hpsi_nat q_p (s_Y c₁),
                ← hpsi_nat q_p (s_Y c₂),
                hpsi_sY (c₁ + c₂), hpsi_sY c₁, hpsi_sY c₂, hg_add, map_add]
          let ψ : 𝒥_h ⟶ 𝒢 :=
            { hom :=
                { app := fun opU => AddCommGrpCat.ofHom
                    { toFun := psi_fun opU.unop
                      map_zero' := hpsi_zero opU.unop
                      map_add' := hpsi_add opU.unop }
                  naturality := fun {opU₂ opU₁} u_op =>
                    AddCommGrpCat.ext fun t => (hpsi_nat u_op.unop t).symm } }
          refine ⟨ψ, ?_⟩
          apply CategoryTheory.Sheaf.hom_ext
          ext opW s
          let W := opW.unop
          let h_W := (Fgt_D.obj W).hom
          have : AlgebraicGeometry.Etale h_W := W.prop
          let W_0 := CategoryTheory.Limits.pullback h_W (π₀ ≫ U₀.ι)
          let fst_W := CategoryTheory.Limits.pullback.fst h_W (π₀ ≫ U₀.ι)
          let snd_W := CategoryTheory.Limits.pullback.snd h_W (π₀ ≫ U₀.ι)
          let f_W := triv₀ W s
          obtain ⟨W₀, hW₀_top, hj₀_zero, hu_eq⟩ := hBaseLevel W s
          let obj_W : Unit ⊕ C_vec → D₀.Etale := fun idx =>
            match idx with
            | Sum.inl () => AlgebraicGeometry.Scheme.Etale.mk (W₀.ι ≫ h_W)
