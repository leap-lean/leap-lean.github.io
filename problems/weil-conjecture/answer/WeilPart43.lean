              change TensorProduct.tmul R (1 : L) (algebraMap K L k) =
                algebraMap K (TensorProduct R L L) k
              rw [IsScalarTower.algebraMap_apply K L (TensorProduct R L L)]
              exact (hk_comm k).symm }
        let ψ_KL_RL : TensorProduct K L L →ₐ[L] TensorProduct R L L :=
          Algebra.TensorProduct.lift
            (Algebra.TensorProduct.includeLeft (R := R) (S := L) (A := L) (B := L))
            g_K
            (fun _ _ => mul_comm _ _)
        have h_comp : ((ψ_KL_RL.comp φ_RL_KL).restrictScalars R).toLinearMap = LinearMap.id := by
          apply TensorProduct.ext'
          intro x y
          change ψ_KL_RL (φ_RL_KL (TensorProduct.tmul R x y)) = TensorProduct.tmul R x y
          rw [hφ_tmul]
          have h := Algebra.TensorProduct.lift_tmul
            (Algebra.TensorProduct.includeLeft (R := R) (S := L) (A := L) (B := L))
            g_K (fun _ _ => mul_comm _ _) x y
          change ψ_KL_RL (TensorProduct.tmul K x y) =
            TensorProduct.tmul R x (1 : L) * TensorProduct.tmul R (1 : L) y at h
          rw [h, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        have h_left_inv : Function.LeftInverse ψ_KL_RL φ_RL_KL :=
          fun w => congrFun (congrArg DFunLike.coe h_comp) w
        exact h_left_inv.injective
      let ι_tot : TensorProduct R S S →+* TensorProduct K L L :=
        φ_RL_KL.toRingHom.comp ι₁.toRingHom
      have hι_tot_inj : Function.Injective ι_tot := hφ_inj.comp hι₁_inj
      have hι_tot_tmul : ∀ s₁ s₂ : S,
          ι_tot (TensorProduct.tmul R s₁ s₂) =
            TensorProduct.tmul K (algebraMap S L s₁) (algebraMap S L s₂) := by
        intro s₁ s₂
        change φ_RL_KL (ι₁ (TensorProduct.tmul R s₁ s₂)) = _
        rw [Algebra.TensorProduct.map_tmul]
        exact hφ_tmul (j_SL s₁) (j_SL s₂)
      let μ_L : Fin m → TensorProduct K L L →ₐ[L] L :=
        fun j => Algebra.TensorProduct.lift (AlgHom.id L L)
          (toGal (equiv_Γ j)).symm.toAlgHom (fun _ _ => mul_comm _ _)
      have hμ_L_compat : ∀ (j : Fin m) (z : TensorProduct R S S),
          μ_L j (ι_tot z) = algebraMap S L (μ (equiv_Γ j) z) := by
        intro j
        let lhs_alg : TensorProduct R S S →ₐ[R] L :=
          (((μ_L j).restrictScalars R).comp (φ_RL_KL.restrictScalars R)).comp ι₁
        let rhs_alg : TensorProduct R S S →ₐ[R] L :=
          (IsScalarTower.toAlgHom R S L).comp ((μ (equiv_Γ j)).restrictScalars R)
        have hlhs_eq : lhs_alg.toLinearMap = rhs_alg.toLinearMap := by
          apply TensorProduct.ext'
          intro s₁ s₂
          change μ_L j (ι_tot (TensorProduct.tmul R s₁ s₂)) =
            algebraMap S L (μ (equiv_Γ j) (TensorProduct.tmul R s₁ s₂))
          rw [hι_tot_tmul, hμ_tmul, map_mul]
          have h := Algebra.TensorProduct.lift_tmul (AlgHom.id L L)
            (toGal (equiv_Γ j)).symm.toAlgHom (fun _ _ => mul_comm _ _)
            (algebraMap S L s₁) (algebraMap S L s₂)
          change μ_L j (TensorProduct.tmul K (algebraMap S L s₁) (algebraMap S L s₂)) =
            algebraMap S L s₁ * (toGal (equiv_Γ j)).symm (algebraMap S L s₂) at h
          rw [h]
          congr 1
          apply (toGal (equiv_Γ j)).injective
          rw [(toGal (equiv_Γ j)).apply_symm_apply, h_toGal, (equiv_Γ j).apply_symm_apply]
        intro z
        exact congrFun (congrArg DFunLike.coe hlhs_eq) z
      let e_bar : Fin m → TensorProduct K L L := fun i => ι_tot (e i)
      have hμ_L_ebar : ∀ i j : Fin m, μ_L j (e_bar i) = if i = j then 1 else 0 := by
        intro i j
        dsimp [e_bar]
        rw [hμ_L_compat j (e i), hμ_kronecker i j]
        split_ifs <;> simp
      let Φ_lin : (Fin m → L) →ₗ[L] TensorProduct K L L :=
        { toFun := fun c => ∑ i : Fin m, c i • e_bar i
          map_add' := fun c₁ c₂ => by
            simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
          map_smul' := fun a c => by
            simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.smul_sum, mul_smul] }
      let Θ_lin : TensorProduct K L L →ₗ[L] (Fin m → L) :=
        LinearMap.pi fun j => (μ_L j).toLinearMap
      have hΘΦ : ∀ c : Fin m → L, Θ_lin (Φ_lin c) = c := by
        intro c
        ext j
        change μ_L j (∑ i : Fin m, c i • e_bar i) = c j
        rw [map_sum]
        have hterm : ∀ i : Fin m, μ_L j (c i • e_bar i) = if i = j then c i else 0 := by
          intro i
          rw [map_smul, smul_eq_mul, hμ_L_ebar i j, mul_ite, mul_one, mul_zero]
        simp_rw [hterm]
        simp
      have hΦ_inj : Function.Injective Φ_lin :=
        Function.LeftInverse.injective hΘΦ
      have _ : Module.Finite K (TensorProduct K L L) := Module.Finite.tensorProduct K L L
      have _ : FiniteDimensional L (TensorProduct K L L) :=
        Module.Finite.of_restrictScalars_finite K L (TensorProduct K L L)
      have hfinrank_eq :
          Module.finrank L (Fin m → L) = Module.finrank L (TensorProduct K L L) := by
        rw [Module.finrank_pi, Fintype.card_fin,
          @Module.finrank_tensorProduct L K L L, Module.finrank_self, one_mul, hm_finrank]
      have hΦ_surj : Function.Surjective Φ_lin :=
        (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfinrank_eq).mp hΦ_inj
      have hsum_bar : (∑ i : Fin m, e_bar i) = 1 := by
        set w₀ : TensorProduct K L L := 1 - ∑ i : Fin m, e_bar i
        have hΘw₀ : Θ_lin w₀ = 0 := by
          ext j
          change μ_L j (1 - ∑ i : Fin m, e_bar i) = 0
          rw [map_sub, map_one, map_sum]
          simp_rw [hμ_L_ebar]
          simp
        obtain ⟨c₀, hc₀⟩ := hΦ_surj w₀
        have hc₀_zero : c₀ = 0 := by
          rw [← hΘΦ c₀, hc₀, hΘw₀]
        have hw₀_zero : w₀ = 0 := by
          rw [← hc₀, hc₀_zero, map_zero]
        exact (sub_eq_zero.mp hw₀_zero).symm
      have hsum_e : (∑ i : Fin m, e i) = 1 := by
        apply hι_tot_inj
        rw [map_sum, map_one]
        exact hsum_bar
      exact ⟨hInjRS, m, equiv_Γ, e, he_idem, he_orth, hsum_e, hμ_kronecker, h_absorb⟩
    have hSchemeTors :
        ∀ (R S : Type u) [CommRing R] [IsDomain R] [CommRing S] [IsDomain S]
          [Algebra R S] [Module.Finite R S] [Algebra.Etale R S]
          (_hInj : Function.Injective (algebraMap R S))
          (m : ℕ) (equiv_Γ : Fin m ≃ (S ≃ₐ[R] S)) (e : Fin m → TensorProduct R S S)
          (_hIdemp : ∀ i : Fin m, e i * e i = e i)
          (_hOrth : ∀ i j : Fin m, i ≠ j → e i * e j = 0)
          (_hSum : (∑ i : Fin m, e i) = 1)
          (_hEval : ∀ i j : Fin m,
            Algebra.TensorProduct.lift (AlgHom.id S S) (equiv_Γ j).symm.toAlgHom
