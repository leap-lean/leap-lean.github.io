        (P_I : Ideal C_I) (_hPI_max : P_I.IsMaximal)
        (_hPI_over : Ideal.comap (algebraMap A_s C_I) P_I =
          Ideal.span {e_poly (Polynomial.X - Polynomial.C a₀)})
        (_hPI_sq : algebraMap A_s C_I (e_poly (Polynomial.X - Polynomial.C a₀)) ∉ P_I ^ 2),
        ∃ (θ : C_I) (g : Polynomial A_s),
          (g.Monic ∧ Polynomial.aeval θ g = 0 ∧ Algebra.adjoin K {algebraMap C_I K_I θ} = ⊤) ∧
          (let δ_s : C_I := algebraMap A_s C_I r_s * Polynomial.aeval θ (Polynomial.derivative g)
           δ_s ∉ P_I ∧
           ∀ (E_s : Type u) [CommRing E_s] [Algebra A_s E_s] [Algebra C_I E_s]
             [IsScalarTower A_s C_I E_s] [IsLocalization.Away δ_s E_s],
             Algebra.Etale A_s E_s) := by
    clear * -
    classical
    intro F K K_I A_s C_I _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
      e_poly a₀ r_s hr_s P_I hPI_max hPI_over hPI_sq
    let t_s : A_s := e_poly (Polynomial.X - Polynomial.C a₀)
    have _ : IsPrincipalIdealRing A_s :=
      IsPrincipalIdealRing.of_surjective e_poly.toRingHom e_poly.surjective
    have _ : IsDedekindDomain A_s := inferInstance
    have _ : Infinite A_s := Infinite.of_injective e_poly e_poly.injective
    have _ : P_I.IsMaximal := hPI_max
    have _ : FaithfulSMul A_s C_I := FaithfulSMul.of_field_isFractionRing A_s C_I K K_I
    have hInj_As_K : Function.Injective (algebraMap A_s K) := IsFractionRing.injective A_s K
    have hInj_CI_KI : Function.Injective (algebraMap C_I K_I) := IsFractionRing.injective C_I K_I
    let p_poly : Ideal (Polynomial F) := Ideal.span {Polynomial.X - Polynomial.C a₀}
    let p_s : Ideal A_s := Ideal.span {t_s}
    have ht_s_ne : t_s ≠ 0 :=
      (map_ne_zero_iff e_poly e_poly.injective).mpr (Polynomial.monic_X_sub_C a₀).ne_zero
    have hp_s_max : p_s.IsMaximal :=
      PrincipalIdealRing.isMaximal_of_irreducible
        ((MulEquiv.irreducible_iff e_poly.toRingEquiv.toMulEquiv).mpr
          (Polynomial.irreducible_X_sub_C a₀))
    have _ : p_s.IsMaximal := hp_s_max
    have hp_map : Ideal.map e_poly.toRingHom p_poly = p_s := by
      dsimp [p_poly, p_s, t_s]
      rw [Ideal.map_span, Set.image_singleton]
      rfl
    let e_quot_As : (Polynomial F ⧸ p_poly) ≃+* (A_s ⧸ p_s) :=
      Ideal.quotientEquiv p_poly p_s e_poly.toRingEquiv hp_map.symm
    have _ : Finite (A_s ⧸ p_s) := by
      have hsurj : Function.Surjective
          (fun c : F => e_quot_As (Ideal.Quotient.mk p_poly (Polynomial.C c))) := by
        intro z
        obtain ⟨q, rfl⟩ := e_quot_As.surjective z
        obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective q
        refine ⟨Polynomial.eval a₀ f, congrArg e_quot_As ?_⟩
        symm
        rw [Ideal.Quotient.eq]
        have hroot : Polynomial.IsRoot (f - Polynomial.C (Polynomial.eval a₀ f)) a₀ := by simp
        exact Ideal.mem_span_singleton.mpr (Polynomial.dvd_iff_isRoot.mpr hroot)
      exact Finite.of_surjective _ hsurj
    
    let t_CI : C_I := algebraMap A_s C_I t_s
    have ht_CI_mem : t_CI ∈ P_I := by
      change t_s ∈ Ideal.comap (algebraMap A_s C_I) P_I
      rw [hPI_over]
      exact Ideal.mem_span_singleton_self t_s
    have h_dvd_t : P_I ∣ Ideal.span {t_CI} :=
      Ideal.dvd_iff_le.mpr ((Ideal.span_singleton_le_iff_mem P_I).mpr ht_CI_mem)
    rcases h_dvd_t with ⟨𝔞, h_span_mul⟩
    have hCop : IsCoprime P_I 𝔞 := by
      rw [Ideal.isCoprime_iff_sup_eq]
      by_contra hne_top
      have hsup_eq : P_I = P_I ⊔ 𝔞 := hPI_max.eq_of_le hne_top le_sup_left
      have h𝔞_le : 𝔞 ≤ P_I := le_sup_right.trans hsup_eq.symm.le
      have hle_sq : Ideal.span {t_CI} ≤ P_I ^ 2 := by
        rw [h_span_mul, sq]
        exact Ideal.mul_mono_right h𝔞_le
      exact hPI_sq (hle_sq (Ideal.mem_span_singleton_self t_CI))
    have h_inf_eq : P_I ⊓ 𝔞 = Ideal.span {t_CI} :=
      (Ideal.mul_eq_inf_of_coprime (Ideal.isCoprime_iff_sup_eq.mp hCop)).symm.trans h_span_mul.symm
    let k₀ := A_s ⧸ p_s
    let k₁ := C_I ⧸ P_I
    let _ : Field k₀ := Ideal.Quotient.field p_s
    let _ : Field k₁ := Ideal.Quotient.field P_I
    let _ : Algebra k₀ k₁ :=
      (Ideal.quotientMap P_I (algebraMap A_s C_I) (le_of_eq hPI_over.symm)).toAlgebra
    have _ : IsScalarTower A_s k₀ k₁ := IsScalarTower.of_algebraMap_eq' rfl
    have _ : Module.Finite A_s k₁ :=
      Module.Finite.of_surjective (Ideal.Quotient.mkₐ A_s P_I).toLinearMap
        Ideal.Quotient.mk_surjective
    have _ : FiniteDimensional k₀ k₁ := Module.Finite.of_restrictScalars_finite A_s k₀ k₁
    have _ : Finite k₁ := Module.finite_of_finite k₀
    have _ : Algebra.IsSeparable k₀ k₁ := inferInstance
    obtain ⟨α₀, hα₀⟩ := Field.exists_primitive_element k₀ k₁
    let α_bar : k₁ := if α₀ = 0 then 1 else α₀
    have hα_ne : α_bar ≠ 0 := by
      dsimp [α_bar]
      split_ifs with h
      · exact one_ne_zero
      · exact h
    have hα_if : IntermediateField.adjoin k₀ ({α_bar} : Set k₁) = ⊤ := by
      dsimp [α_bar]
      split_ifs with h
      · subst h
        rw [eq_top_iff, ← hα₀, IntermediateField.adjoin_le_iff]
        simp
      · exact hα₀
    let e_crt_ring : (C_I ⧸ (P_I ⊓ 𝔞)) ≃+* k₁ × (C_I ⧸ 𝔞) :=
      Ideal.quotientInfEquivQuotientProd P_I 𝔞 hCop
    obtain ⟨θ₀, hθ₀_mk⟩ :=
      Ideal.Quotient.mk_surjective (I := P_I ⊓ 𝔞) (e_crt_ring.symm (α_bar, 0))
    have hθ₀_pair : e_crt_ring (Ideal.Quotient.mk (P_I ⊓ 𝔞) θ₀) = (α_bar, 0) := by
      rw [hθ₀_mk, e_crt_ring.apply_symm_apply]
    have hθ₀_PI : Ideal.Quotient.mk P_I θ₀ = α_bar := congrArg Prod.fst hθ₀_pair
    have hθ₀_𝔞 : Ideal.Quotient.mk 𝔞 θ₀ = 0 := congrArg Prod.snd hθ₀_pair
    
    obtain ⟨γ, hγ⟩ := Field.exists_primitive_element K K_I
    have hLoc_KI : IsLocalization (Algebra.algebraMapSubmonoid C_I (nonZeroDivisors A_s)) K_I :=
      IsIntegralClosure.isLocalization A_s K K_I C_I
    obtain ⟨⟨β, s_den⟩, hβ_sec⟩ :=
      @IsLocalization.surj _ _ (Algebra.algebraMapSubmonoid C_I (nonZeroDivisors A_s)) K_I _ _
        hLoc_KI γ
    rcases s_den with ⟨_, ⟨a_den, ha_den, rfl⟩⟩
    let β_K : K_I := algebraMap C_I K_I β
    have ha_den_ne : a_den ≠ 0 := nonZeroDivisors.ne_zero ha_den
    have ha_den_K_ne : algebraMap A_s K a_den ≠ 0 := (map_ne_zero_iff _ hInj_As_K).mpr ha_den_ne
    have hβ_eq : γ * algebraMap K K_I (algebraMap A_s K a_den) = β_K := by
      rw [← IsScalarTower.algebraMap_apply A_s K K_I,
        IsScalarTower.algebraMap_apply A_s C_I K_I]
      exact hβ_sec
    have hβ_if : IntermediateField.adjoin K ({β_K} : Set K_I) = ⊤ := by
      rw [eq_top_iff, ← hγ, IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
      have hmem_β : β_K ∈ IntermediateField.adjoin K ({β_K} : Set K_I) :=
        IntermediateField.mem_adjoin_simple_self K β_K
      have hmem_a : algebraMap K K_I (algebraMap A_s K a_den) ∈
          IntermediateField.adjoin K ({β_K} : Set K_I) :=
        (IntermediateField.adjoin K ({β_K} : Set K_I)).algebraMap_mem _
      have hγ_eq : γ = β_K * (algebraMap K K_I (algebraMap A_s K a_den))⁻¹ := by
        rw [← hβ_eq, mul_assoc, mul_inv_cancel₀
          ((map_ne_zero_iff _ (algebraMap K K_I).injective).mpr ha_den_K_ne), mul_one]
      rw [hγ_eq]
      exact mul_mem hmem_β (inv_mem hmem_a)
    have hβ_adj : Algebra.adjoin K ({β_K} : Set K_I) = ⊤ := by
      rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
        (Algebra.IsAlgebraic.isAlgebraic β_K)]
      exact congrArg IntermediateField.toSubalgebra hβ_if
    let Ω := AlgebraicClosure K
    let Emb := (K_I →ₐ[K] Ω)
    have hEmb_β_inj : ∀ τ₁ τ₂ : Emb, τ₁ ≠ τ₂ → τ₁ β_K ≠ τ₂ β_K := by
      intro τ₁ τ₂ hne heq
      apply hne
      have htop_le : (⊤ : Subalgebra K K_I) ≤ AlgHom.equalizer τ₁ τ₂ := by
        rw [← hβ_adj, Algebra.adjoin_le_iff, Set.singleton_subset_iff]
        exact heq
      ext x
      exact htop_le Algebra.mem_top
    let θ₀_K : K_I := algebraMap C_I K_I θ₀
    let t_Ω : Ω := algebraMap K Ω (algebraMap A_s K t_s)
    have ht_Ω_ne : t_Ω ≠ 0 :=
      (map_ne_zero_iff _ (algebraMap K Ω).injective).mpr
        ((map_ne_zero_iff _ hInj_As_K).mpr ht_s_ne)
    let bad_fn : Emb × Emb → Ω := fun p =>
      (p.1 θ₀_K - p.2 θ₀_K) / (t_Ω * (p.2 β_K - p.1 β_K))
    let φ_As_Ω : A_s →+* Ω := (algebraMap K Ω).comp (algebraMap A_s K)
    have hφ_As_Ω_inj : Function.Injective φ_As_Ω :=
      (algebraMap K Ω).injective.comp hInj_As_K
    have hRange_inf : (Set.range φ_As_Ω).Infinite :=
      Set.infinite_range_of_injective hφ_As_Ω_inj
    have hBad_fin : (Set.range bad_fn).Finite := Set.finite_range bad_fn
    obtain ⟨_, ⟨h, rfl⟩, hh_not_bad⟩ := (hRange_inf.sdiff hBad_fin).nonempty
    let θ : C_I := θ₀ + algebraMap A_s C_I (t_s * h) * β
    let θ_K : K_I := algebraMap C_I K_I θ
    have hθ_K_eq : θ_K = θ₀_K + algebraMap K K_I (algebraMap A_s K t_s * algebraMap A_s K h) * β_K := by
      dsimp [θ_K, θ, θ₀_K, β_K]
      rw [map_add, map_mul, ← IsScalarTower.algebraMap_apply A_s C_I K_I,
        IsScalarTower.algebraMap_apply A_s K K_I, map_mul]
    have hEmb_θ_inj : Function.Injective (fun τ : Emb => τ θ_K) := by
      intro τ₁ τ₂ heq
      have heq' : τ₁ θ_K = τ₂ θ_K := heq
      by_contra hne
      have hβ_diff_ne : τ₂ β_K - τ₁ β_K ≠ 0 :=
        sub_ne_zero.mpr (hEmb_β_inj τ₂ τ₁ (Ne.symm hne))
      have hden_ne : t_Ω * (τ₂ β_K - τ₁ β_K) ≠ 0 := mul_ne_zero ht_Ω_ne hβ_diff_ne
      have hexp : ∀ τ : Emb, τ θ_K = τ θ₀_K + t_Ω * φ_As_Ω h * τ β_K := fun τ => by
        rw [hθ_K_eq, map_add, map_mul, AlgHom.commutes, map_mul]
        rfl
      have hlin : τ₁ θ₀_K - τ₂ θ₀_K = φ_As_Ω h * (t_Ω * (τ₂ β_K - τ₁ β_K)) := by
        have h0 : (τ₁ θ₀_K + t_Ω * φ_As_Ω h * τ₁ β_K) -
            (τ₂ θ₀_K + t_Ω * φ_As_Ω h * τ₂ β_K) = 0 := by
          rw [← hexp τ₁, ← hexp τ₂, heq', sub_self]
        linear_combination h0
      have hh_eq : φ_As_Ω h = bad_fn (τ₁, τ₂) := by
        dsimp [bad_fn]
        rw [hlin, mul_div_cancel_right₀ _ hden_ne]
      exact hh_not_bad ⟨(τ₁, τ₂), hh_eq.symm⟩
    let E_θ : IntermediateField K K_I := IntermediateField.adjoin K ({θ_K} : Set K_I)
    have _ : Algebra.IsSeparable K E_θ := Algebra.isSeparable_tower_bot_of_isSeparable K E_θ K_I
    have hRes_inj : Function.Injective (fun τ : Emb => τ.comp E_θ.val) := by
      intro τ₁ τ₂ heq
      apply hEmb_θ_inj
      exact AlgHom.congr_fun heq ⟨θ_K, IntermediateField.mem_adjoin_simple_self K θ_K⟩
    have hFinrank_eq : Module.finrank K E_θ = Module.finrank K K_I := by
      have hle1 : Module.finrank K K_I ≤ Module.finrank K E_θ := by
        rw [← AlgHom.card K K_I Ω, ← AlgHom.card K E_θ Ω]
        exact Fintype.card_le_of_injective _ hRes_inj
      exact le_antisymm (Submodule.finrank_le E_θ.toSubmodule) hle1
    have hE_θ_top : E_θ = ⊤ := by
      have hsub_top : E_θ.toSubmodule = ⊤ := Submodule.eq_top_of_finrank_eq hFinrank_eq
      ext x
      change x ∈ E_θ.toSubmodule ↔ _
      rw [hsub_top]
      simp
    have hadj_θ : Algebra.adjoin K ({θ_K} : Set K_I) = ⊤ := by
      rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
        (Algebra.IsAlgebraic.isAlgebraic θ_K)]
      exact congrArg IntermediateField.toSubalgebra hE_θ_top
    
    have hθ_int : _root_.IsIntegral A_s θ := IsIntegralClosure.isIntegral A_s K_I θ
    let g : Polynomial A_s := minpoly A_s θ
    have hg_monic : g.Monic := minpoly.monic hθ_int
    have hg_aeval : Polynomial.aeval θ g = 0 := minpoly.aeval A_s θ
    let L_θ : C_I →ₗ[A_s] C_I := Algebra.lmul A_s C_I θ
    let χ : Polynomial A_s := L_θ.charpoly
    have hχ_monic : χ.Monic := LinearMap.charpoly_monic L_θ
    have hL_aeval_one : ∀ p : Polynomial A_s, (Polynomial.aeval L_θ p) 1 = Polynomial.aeval θ p := by
      intro p
      induction p using Polynomial.induction_on' with
      | add p₁ p₂ ih₁ ih₂ =>
        rw [map_add, map_add, LinearMap.add_apply, ih₁, ih₂]
      | monomial n a =>
        rw [Polynomial.aeval_monomial, Polynomial.aeval_monomial]
        have hpow : ∀ k : ℕ, (L_θ ^ k) 1 = θ ^ k := by
          intro k
          induction k with
          | zero => simp
          | succ k ih =>
            rw [pow_succ', Module.End.mul_apply, ih, pow_succ']
            rfl
        rw [Module.End.mul_apply, hpow n, Module.algebraMap_end_apply, Algebra.smul_def]
    have hχ_aeval : Polynomial.aeval θ χ = 0 := by
      rw [← hL_aeval_one χ, LinearMap.aeval_self_charpoly L_θ, LinearMap.zero_apply]
    have hg_dvd_χ : g ∣ χ := minpoly.isIntegrallyClosed_dvd hθ_int hχ_aeval
    let ι := Module.Free.ChooseBasisIndex A_s C_I
    let b : Module.Basis ι A_s C_I := Module.Free.chooseBasis A_s C_I
    have hBasis_KI_lin : LinearIndependent K (fun i : ι => algebraMap C_I K_I (b i)) := by
      rw [linearIndependent_iff']
      intro s c hsum i hi
      let sec_fn : ι → A_s × ↥(nonZeroDivisors A_s) :=
        fun j => IsLocalization.sec (nonZeroDivisors A_s) (c j)
      let D_sub : ↥(nonZeroDivisors A_s) := ∏ j ∈ s, (sec_fn j).2
      have hD_ne : (D_sub : A_s) ≠ 0 := nonZeroDivisors.ne_zero D_sub.2
      have hD_K_ne : algebraMap A_s K (D_sub : A_s) ≠ 0 := (map_ne_zero_iff _ hInj_As_K).mpr hD_ne
      let r_fn : ι → A_s := fun j =>
        if j ∈ s then (sec_fn j).1 * ∏ k ∈ s.erase j, ((sec_fn k).2 : A_s) else 0
      have hr_eq : ∀ j ∈ s, algebraMap A_s K (r_fn j) = algebraMap A_s K (D_sub : A_s) * c j := by
        intro j hj
        dsimp [r_fn]
        rw [ite_eq_left_iff.mpr (fun h => absurd hj h), map_mul]
        have hsec : algebraMap A_s K (sec_fn j).1 = algebraMap A_s K ((sec_fn j).2 : A_s) * c j :=
          IsLocalization.sec_spec' (M := nonZeroDivisors A_s) (c j)
        have hD_split : (D_sub : A_s) =
            ((sec_fn j).2 : A_s) * ∏ k ∈ s.erase j, ((sec_fn k).2 : A_s) := by
          dsimp [D_sub]
          rw [Submonoid.coe_finsetProd]
          exact (Finset.mul_prod_erase s (fun k => ((sec_fn k).2 : A_s)) hj).symm
        rw [hD_split, map_mul, mul_right_comm, ← hsec]
      have hsum_CI : ∑ j ∈ s, r_fn j • b j = 0 := by
        apply hInj_CI_KI
        rw [map_zero, map_sum]
        have hmul0 : algebraMap K K_I (algebraMap A_s K (D_sub : A_s)) *
            (∑ j ∈ s, c j • algebraMap C_I K_I (b j)) = 0 := by
          rw [hsum, mul_zero]
        rw [Finset.mul_sum] at hmul0
        refine Eq.trans ?_ hmul0
        refine Finset.sum_congr rfl fun j hj => ?_
        rw [Algebra.smul_def (r_fn j) (b j), map_mul, ← IsScalarTower.algebraMap_apply A_s C_I K_I,
          IsScalarTower.algebraMap_apply A_s K K_I, hr_eq j hj, map_mul, Algebra.smul_def, mul_assoc]
      have hr_i : r_fn i = 0 :=
        linearIndependent_iff'.mp b.linearIndependent s r_fn hsum_CI i hi
      have hmul_ci : algebraMap A_s K (D_sub : A_s) * c i = 0 := by
        rw [← hr_eq i hi, hr_i, map_zero]
      exact (mul_eq_zero.mp hmul_ci).resolve_left hD_K_ne
    have hBasis_KI_span : ⊤ ≤ Submodule.span K (Set.range fun i : ι => algebraMap C_I K_I (b i)) := by
      intro z _
      obtain ⟨⟨c_z, s_z⟩, hcz_eq⟩ :=
        @IsLocalization.surj _ _ (Algebra.algebraMapSubmonoid C_I (nonZeroDivisors A_s)) K_I _ _
          hLoc_KI z
      rcases s_z with ⟨_, ⟨a_z, ha_z, rfl⟩⟩
      have haz_K_ne : algebraMap A_s K a_z ≠ 0 :=
        (map_ne_zero_iff _ hInj_As_K).mpr (nonZeroDivisors.ne_zero ha_z)
      have hcz_sum : c_z = ∑ i : ι, b.repr c_z i • b i := (b.sum_repr c_z).symm
      have hz_eq : z = (algebraMap A_s K a_z)⁻¹ • algebraMap C_I K_I c_z := by
        have h1 : z * algebraMap K K_I (algebraMap A_s K a_z) = algebraMap C_I K_I c_z := by
          rw [← IsScalarTower.algebraMap_apply A_s K K_I,
            IsScalarTower.algebraMap_apply A_s C_I K_I]
          exact hcz_eq
        rw [Algebra.smul_def, map_inv₀, ← h1, mul_comm z _, ← mul_assoc,
          inv_mul_cancel₀ ((map_ne_zero_iff _ (algebraMap K K_I).injective).mpr haz_K_ne), one_mul]
      rw [hz_eq, hcz_sum, map_sum, Finset.smul_sum]
      refine Submodule.sum_mem _ fun i _ => ?_
      have hterm : (algebraMap A_s K a_z)⁻¹ • algebraMap C_I K_I (b.repr c_z i • b i) =
          ((algebraMap A_s K a_z)⁻¹ * algebraMap A_s K (b.repr c_z i)) •
            algebraMap C_I K_I (b i) := by
        rw [Algebra.smul_def (b.repr c_z i), map_mul, ← IsScalarTower.algebraMap_apply A_s C_I K_I,
          IsScalarTower.algebraMap_apply A_s K K_I, Algebra.smul_def, Algebra.smul_def, map_mul,
          mul_assoc]
      rw [hterm]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    let b_KI : Module.Basis ι K K_I := Module.Basis.mk hBasis_KI_lin hBasis_KI_span
    have hdeg_g_eq_χ : g.natDegree = χ.natDegree := by
      have _ : FaithfulSMul A_s K_I := FaithfulSMul.of_field_isFractionRing A_s K_I K K_I
      have hmin_eq : minpoly K θ_K = g.map (algebraMap A_s K) := by
        have hθ_K_int_As : _root_.IsIntegral A_s θ_K :=
          _root_.IsIntegral.map (IsScalarTower.toAlgHom A_s C_I K_I) hθ_int
        have hmin_KI := minpoly.isIntegrallyClosed_eq_field_fractions' K hθ_K_int_As
        have hmin_As : minpoly A_s θ_K = g :=
          minpoly.algHom_eq (IsScalarTower.toAlgHom A_s C_I K_I) hInj_CI_KI θ
        rw [hmin_KI, hmin_As]
      have hdeg_g : g.natDegree = Module.finrank K K_I := by
        rw [← hg_monic.natDegree_map (algebraMap A_s K), ← hmin_eq,
          ← IntermediateField.adjoin.finrank (Algebra.IsIntegral.isIntegral θ_K)]
        exact hFinrank_eq
      have hdeg_χ : χ.natDegree = Module.finrank K K_I := by
        rw [LinearMap.charpoly_natDegree, Module.finrank_eq_card_basis b,
          Module.finrank_eq_card_basis b_KI]
      exact hdeg_g.trans hdeg_χ.symm
    rcases hg_dvd_χ with ⟨q_χ, hq_χ⟩
    have hq_monic : q_χ.Monic := hg_monic.of_mul_monic_left (hq_χ ▸ hχ_monic)
    have hq_deg0 : q_χ.natDegree = 0 := by
      have hdeg_mul : χ.natDegree = g.natDegree + q_χ.natDegree := by
