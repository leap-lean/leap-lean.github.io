      let Ψ : W_r ⟶ P_W := CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst h_W π_r)
        (CategoryTheory.Limits.pullback.snd h_W π_r)
        ((congrArg (CategoryTheory.Limits.pullback.fst h_W π_r ≫ ·) hg_Y).trans
