    have hSE : (CategoryTheory.ShortComplex.mk f g h0).ShortExact :=
      { exact := hEx }
    have hSE_map : ((CategoryTheory.ShortComplex.mk f g h0).map E_S).ShortExact :=
      hSE.map_of_exact E_S
    have hZero2 : ∀ x₂ : (E_S.obj A₂).H 1, x₂ = 0 := by
      intro x₂
      let x₂' : CategoryTheory.Abelian.Ext Fℤ (E_S.obj A₂) 1 := x₂
      change x₂' = 0
      let x₃' : CategoryTheory.Abelian.Ext Fℤ (E_S.obj A₃) 1 :=
