            ∀ (s₂ : ↑(ℱ₂.obj.obj (Opposite.op W)))
              (y : ↥(CategoryTheory.Limits.pullback h_W π₂)),
              triv₁ W ((ψ.hom.app (Opposite.op W)) s₂) (q_W.base y) = Φ (triv₂ W s₂ y) := by
    intro V₁ V₂ π₁ π₂ p₁₂ hp₁₂ hEt_p hSurj_p Γ₁ Γ₂ _ _ v_aut₁ v_aut₂ hv_aut₂
      res hres_surj hres_comm hFib K₁ K₂ Λ₁ Λ₂ _ _ ρ₁ ρ₂ ℱ₁ ℱ₂ triv₁ triv₂ htriv₁ htriv₂ Φ hΦ
    let q_can : ∀ W : U.Etale,
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom
        CategoryTheory.Limits.pullback h_W π₂ ⟶ CategoryTheory.Limits.pullback h_W π₁ :=
      fun W =>
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst h_W π₂)
          (CategoryTheory.Limits.pullback.snd h_W π₂ ≫ p₁₂)
          (by rw [CategoryTheory.Category.assoc, hp₁₂, CategoryTheory.Limits.pullback.condition])
    have hq_pb : ∀ W : U.Etale,
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom
        CategoryTheory.IsPullback (q_can W)
          (CategoryTheory.Limits.pullback.snd h_W π₂)
          (CategoryTheory.Limits.pullback.snd h_W π₁) p₁₂ := by
      intro W
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom
      have hOuter : CategoryTheory.IsPullback
          (q_can W ≫ CategoryTheory.Limits.pullback.fst h_W π₁)
          (CategoryTheory.Limits.pullback.snd h_W π₂)
          h_W (p₁₂ ≫ π₁) := by
        rw [CategoryTheory.Limits.pullback.lift_fst, hp₁₂]
        exact CategoryTheory.IsPullback.of_hasPullback h_W π₂
      exact CategoryTheory.IsPullback.of_right hOuter
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback h_W π₁)
    have hq_et : ∀ W : U.Etale, AlgebraicGeometry.Etale (q_can W) := fun W =>
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (hq_pb W).flip hEt_p
    have hq_surj : ∀ W : U.Etale, AlgebraicGeometry.Surjective (q_can W) := fun W =>
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (hq_pb W).flip hSurj_p
    have hEx : ∀ (W : U.Etale) (s₂ : ↑(ℱ₂.obj.obj (Opposite.op W))),
        let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom
        ∃ s₁ : ↑(ℱ₁.obj.obj (Opposite.op W)),
          ∀ y : ↥(CategoryTheory.Limits.pullback h_W π₂),
            triv₁ W s₁ ((q_can W).base y) = Φ (triv₂ W s₂ y) := by
      intro W s₂
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom
      let W₁ := CategoryTheory.Limits.pullback h_W π₁
      let W₂ := CategoryTheory.Limits.pullback h_W π₂
      let f_map : LocallyConstant ↥W₂ (Fin K₁ → Λ₁) :=
        ⟨fun y => Φ (triv₂ W s₂ y), fun S => (triv₂ W s₂).isLocallyConstant (Φ ⁻¹' S)⟩
      have hf_const : ∀ y₁ y₂ : ↥W₂,
          (q_can W).base y₁ = (q_can W).base y₂ → f_map y₁ = f_map y₂ := by
        intro y₁ y₂ hy_eq
        let e_pb := (hq_pb W).isoPullback
        let z₁ := e_pb.hom.base y₁
        let z₂ := e_pb.hom.base y₂
        have hz_eq : (CategoryTheory.Limits.pullback.fst
              (CategoryTheory.Limits.pullback.snd h_W π₁) p₁₂).base z₁ =
            (CategoryTheory.Limits.pullback.fst
              (CategoryTheory.Limits.pullback.snd h_W π₁) p₁₂).base z₂ := by
          have h1 := congrArg (fun k : W₂ ⟶ W₁ => k.base y₁) (hq_pb W).isoPullback_hom_fst
          have h2 := congrArg (fun k : W₂ ⟶ W₁ => k.base y₂) (hq_pb W).isoPullback_hom_fst
          exact h1.trans (hy_eq.trans h2.symm)
        obtain ⟨τ, m_τ, hres1, hm_fst, hm_snd, hm_pt⟩ :=
          hFib W₁ (CategoryTheory.Limits.pullback.snd h_W π₁) z₁ z₂ hz_eq
        let m'_τ : W₂ ⟶ W₂ := e_pb.hom ≫ m_τ ≫ e_pb.inv
        have hm'_q : m'_τ ≫ q_can W = q_can W := by
          dsimp only [m'_τ, e_pb]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            (hq_pb W).isoPullback_inv_fst, hm_fst, (hq_pb W).isoPullback_hom_fst]
        have hm'_fst : m'_τ ≫ CategoryTheory.Limits.pullback.fst h_W π₂ =
            CategoryTheory.Limits.pullback.fst h_W π₂ := by
          have h1 : q_can W ≫ CategoryTheory.Limits.pullback.fst h_W π₁ =
              CategoryTheory.Limits.pullback.fst h_W π₂ :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          rw [← h1, ← CategoryTheory.Category.assoc, hm'_q]
        have hm'_snd : m'_τ ≫ CategoryTheory.Limits.pullback.snd h_W π₂ =
            CategoryTheory.Limits.pullback.snd h_W π₂ ≫ v_aut₂ τ := by
          dsimp only [m'_τ, e_pb]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            (hq_pb W).isoPullback_inv_snd, hm_snd, ← CategoryTheory.Category.assoc,
            (hq_pb W).isoPullback_hom_snd]
        have hm'_pt : m'_τ.base y₁ = y₂ := by
          change e_pb.inv.base (m_τ.base z₁) = y₂
          rw [hm_pt]
          exact congrArg (fun k : W₂ ⟶ W₂ => k.base y₂) e_pb.hom_inv_id
        have hs₂_mem : triv₂ W s₂ ∈ Set.range (triv₂ W) := ⟨s₂, rfl⟩
        rw [(htriv₂.2 W).2] at hs₂_mem
        change Φ (triv₂ W s₂ y₁) = Φ (triv₂ W s₂ y₂)
        rw [← hm'_pt, hs₂_mem τ m'_τ hm'_fst hm'_snd y₁, hΦ, hres1, map_one, Units.val_one,
          Matrix.one_mulVec]
      have _ : AlgebraicGeometry.Surjective (q_can W) := hq_surj W
      have _ : AlgebraicGeometry.Etale (q_can W) := hq_et W
      let sec_pt : ↥W₁ → ↥W₂ := fun x => Classical.choose ((q_can W).surjective x)
      have hsec_pt : ∀ x : ↥W₁, (q_can W).base (sec_pt x) = x :=
        fun x => Classical.choose_spec ((q_can W).surjective x)
      let f₁_fun : ↥W₁ → (Fin K₁ → Λ₁) := fun x => f_map (sec_pt x)
      have hf₁_eval : ∀ y : ↥W₂, f₁_fun ((q_can W).base y) = f_map y :=
        fun y => hf_const _ y (hsec_pt ((q_can W).base y))
      have hf₁_lc : IsLocallyConstant f₁_fun := by
        intro S
        have hpre : f₁_fun ⁻¹' S = (q_can W).base '' (f_map ⁻¹' S) := by
          ext x
          simp only [Set.mem_preimage, Set.mem_image]
          constructor
          · intro hx
            exact ⟨sec_pt x, hx, hsec_pt x⟩
          · rintro ⟨y, hy, rfl⟩
            rwa [hf₁_eval y]
        rw [hpre]
        exact (q_can W).isOpenMap _ (f_map.isLocallyConstant S)
      let f₁ : LocallyConstant ↥W₁ (Fin K₁ → Λ₁) := ⟨f₁_fun, hf₁_lc⟩
      have hf₁_mem : f₁ ∈ Set.range (triv₁ W) := by
        rw [(htriv₁.2 W).2]
        intro σ m_σ hm_fst hm_snd x
        obtain ⟨τ, rfl⟩ := hres_surj σ
        obtain ⟨y, rfl⟩ := (q_can W).surjective x
        let m_τ : W₂ ⟶ W₂ :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst h_W π₂)
            (CategoryTheory.Limits.pullback.snd h_W π₂ ≫ v_aut₂ τ)
            (by rw [CategoryTheory.Category.assoc, hv_aut₂ τ,
                  CategoryTheory.Limits.pullback.condition])
        have hcomm_q : m_τ ≫ q_can W = q_can W ≫ m_σ := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc, hm_fst,
              CategoryTheory.Limits.pullback.lift_fst]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc m_τ, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.assoc, hres_comm τ,
              CategoryTheory.Category.assoc (q_can W), hm_snd,
              ← CategoryTheory.Category.assoc (q_can W), CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.assoc]
        have hpt : m_σ.base ((q_can W).base y) = (q_can W).base (m_τ.base y) :=
          congrArg (fun k : W₂ ⟶ W₁ => k.base y) hcomm_q.symm
        have hs₂_mem : triv₂ W s₂ ∈ Set.range (triv₂ W) := ⟨s₂, rfl⟩
        rw [(htriv₂.2 W).2] at hs₂_mem
        change f₁_fun (m_σ.base ((q_can W).base y)) =
          ((ρ₁ (res τ)).val).mulVec (f₁_fun ((q_can W).base y))
        rw [hpt, hf₁_eval (m_τ.base y), hf₁_eval y]
        change Φ (triv₂ W s₂ (m_τ.base y)) = ((ρ₁ (res τ)).val).mulVec (Φ (triv₂ W s₂ y))
        rw [hs₂_mem τ m_τ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) y, hΦ]
      obtain ⟨s₁, hs₁⟩ := hf₁_mem
      refine ⟨s₁, fun y => ?_⟩
      rw [hs₁]
      exact hf₁_eval y
    let ψ_fun : ∀ W : U.Etale, ↑(ℱ₂.obj.obj (Opposite.op W)) → ↑(ℱ₁.obj.obj (Opposite.op W)) :=
      fun W s₂ => Classical.choose (hEx W s₂)
    have hψ_spec : ∀ (W : U.Etale) (s₂ : ↑(ℱ₂.obj.obj (Opposite.op W))) y,
        triv₁ W (ψ_fun W s₂) ((q_can W).base y) = Φ (triv₂ W s₂ y) :=
      fun W s₂ => Classical.choose_spec (hEx W s₂)
    let ψ : ℱ₂ ⟶ ℱ₁ :=
      { hom :=
          { app := fun W_op =>
              let W := Opposite.unop W_op
              AddCommGrpCat.ofHom
                { toFun := ψ_fun W
                  map_zero' := by
                    have _ : AlgebraicGeometry.Surjective (q_can W) := hq_surj W
                    apply (htriv₁.2 W).1
                    apply LocallyConstant.ext
                    intro x
                    obtain ⟨y, rfl⟩ := (q_can W).surjective x
                    rw [hψ_spec W 0 y, map_zero, LocallyConstant.zero_apply, map_zero, map_zero,
                      LocallyConstant.zero_apply]
                  map_add' := fun a b => by
                    have _ : AlgebraicGeometry.Surjective (q_can W) := hq_surj W
                    apply (htriv₁.2 W).1
                    apply LocallyConstant.ext
                    intro x
                    obtain ⟨y, rfl⟩ := (q_can W).surjective x
                    rw [hψ_spec W (a + b) y, map_add, LocallyConstant.add_apply, map_add,
                      map_add, LocallyConstant.add_apply, hψ_spec W a y, hψ_spec W b y] }
            naturality := by
              intro X Y f_op
              let W_b := Opposite.unop X
              let W_a := Opposite.unop Y
              let u : W_a ⟶ W_b := f_op.unop
              have hf_eq : f_op = Opposite.op u := rfl
              rw [hf_eq]
              apply AddCommGrpCat.ext
              intro s₂
              have _ : AlgebraicGeometry.Surjective (q_can W_a) := hq_surj W_a
              apply (htriv₁.2 W_a).1
              apply LocallyConstant.ext
              intro x_a
              obtain ⟨y_a, rfl⟩ := (q_can W_a).surjective x_a
              let h_a := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W_a).hom
              let h_b := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W_b).hom
              let u_left := ((AlgebraicGeometry.Scheme.Etale.forget U).map u).left
              have hu_w : u_left ≫ h_b = h_a :=
                ((AlgebraicGeometry.Scheme.Etale.forget U).map u).w
              let u₁ : CategoryTheory.Limits.pullback h_a π₁ ⟶
                  CategoryTheory.Limits.pullback h_b π₁ :=
                CategoryTheory.Limits.pullback.lift
                  (CategoryTheory.Limits.pullback.fst h_a π₁ ≫ u_left)
                  (CategoryTheory.Limits.pullback.snd h_a π₁)
                  (by rw [CategoryTheory.Category.assoc, hu_w,
                        CategoryTheory.Limits.pullback.condition])
              let u₂ : CategoryTheory.Limits.pullback h_a π₂ ⟶
                  CategoryTheory.Limits.pullback h_b π₂ :=
                CategoryTheory.Limits.pullback.lift
                  (CategoryTheory.Limits.pullback.fst h_a π₂ ≫ u_left)
                  (CategoryTheory.Limits.pullback.snd h_a π₂)
                  (by rw [CategoryTheory.Category.assoc, hu_w,
                        CategoryTheory.Limits.pullback.condition])
              have hcomm_qu : q_can W_a ≫ u₁ = u₂ ≫ q_can W_b := by
                apply CategoryTheory.Limits.pullback.hom_ext
                · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                    ← CategoryTheory.Category.assoc (q_can W_a),
                    CategoryTheory.Limits.pullback.lift_fst,
                    CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                    CategoryTheory.Limits.pullback.lift_fst]
                · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                    CategoryTheory.Limits.pullback.lift_snd,
                    CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                    ← CategoryTheory.Category.assoc u₂, CategoryTheory.Limits.pullback.lift_snd]
              have hpt : u₁.base ((q_can W_a).base y_a) = (q_can W_b).base (u₂.base y_a) :=
                congrArg (fun k => k.base y_a) hcomm_qu
              change triv₁ W_a (ψ_fun W_a ((ℱ₂.obj.map (Opposite.op u)) s₂))
                  ((q_can W_a).base y_a) =
                triv₁ W_a ((ℱ₁.obj.map (Opposite.op u)) (ψ_fun W_b s₂))
                  ((q_can W_a).base y_a)
              rw [hψ_spec W_a _ y_a,
                htriv₂.1 u u₂ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                  (CategoryTheory.Limits.pullback.lift_snd _ _ _) s₂ y_a,
                htriv₁.1 u u₁ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                  (CategoryTheory.Limits.pullback.lift_snd _ _ _) (ψ_fun W_b s₂)
                  ((q_can W_a).base y_a),
                hpt, hψ_spec W_b s₂ (u₂.base y_a)] } }
    refine ⟨fun W => ⟨q_can W, CategoryTheory.Limits.pullback.lift_fst _ _ _,
        CategoryTheory.Limits.pullback.lift_snd _ _ _, ?_⟩,
      ψ, fun W q_W hq_fst hq_snd s₂ y => ?_⟩
    · have _ : AlgebraicGeometry.Surjective (q_can W) := hq_surj W
      exact (q_can W).surjective
    · have hq_eq : q_W = q_can W := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact hq_fst.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
        · exact hq_snd.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
      rw [hq_eq]
      exact hψ_spec W s₂ y
  
