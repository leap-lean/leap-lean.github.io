                   CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd h_W π_r)
                     (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
                 ∀ y : ↥W_r, f (m_σ.base y) = ((ρ_P σ).val).mulVec (f y) } ∧
