      obtain ⟨δ, hδ_spec, hδ_disj, hδ_cov, hδ_mul⟩ := hSheets Y_left g_Y
      let δ' : (B_V ≃ₐ[R₀] B_V) → (Y_left ⟶ W_r) := fun σ => δ σ ≫ Φ
      have hδ'_fst : ∀ σ : B_V ≃ₐ[R₀] B_V,
          δ' σ ≫ CategoryTheory.Limits.pullback.fst h_W π_r = 𝟙 Y_left :=
        fun σ => (CategoryTheory.Category.assoc (δ σ) Φ _).trans
          ((congrArg (δ σ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            (hδ_spec σ).1)
      have hδ'_range : ∀ σ : B_V ≃ₐ[R₀] B_V,
