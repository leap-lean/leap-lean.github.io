              (∀ (σ τ : S ≃ₐ[R] S) (m_τ : Y_V ⟶ Y_V),
                m_τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π =
                  CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π →
                m_τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π =
                  CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
                δ σ ≫ m_τ = δ (τ * σ))) := by
      clear * -
      intro R S _ _ _ _ _ _ _ hInj m equiv_Γ e _ hOrth hSum hEval hAbsorb U e_U V π
      let P_Et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
        @AlgebraicGeometry.Etale.{u}
      let P_Surj : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
        @AlgebraicGeometry.Surjective.{u}
      let π₀ : V ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S))
      let d_V : (S ≃ₐ[R] S) → (V ⟶ V) :=
        fun σ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)
      have hEt_π₀ : AlgebraicGeometry.Etale π₀ :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_Et) (Q := @RingHom.Etale)).mpr
          (RingHom.etale_algebraMap.mpr inferInstance)
      have hEt_π : AlgebraicGeometry.Etale π :=
        CategoryTheory.MorphismProperty.IsStableUnderComposition.comp_mem
          (P := P_Et) π₀ e_U.hom hEt_π₀
          (CategoryTheory.MorphismProperty.of_isIso P_Et e_U.hom)
      have hSurj_π₀ : AlgebraicGeometry.Surjective π₀ := by
        rw [AlgebraicGeometry.surjective_iff]
        intro P
        have hker : RingHom.ker (algebraMap R S) ≤ P.asIdeal := by
          intro r hr
          have hr0 : r = 0 := hInj ((RingHom.mem_ker.mp hr).trans (map_zero (algebraMap R S)).symm)
          rw [hr0]
          exact P.asIdeal.zero_mem
        have : P.asIdeal.IsPrime := P.isPrime
        obtain ⟨Q, hQ, hUnder⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain (S := S) P.asIdeal hker
        exact ⟨⟨Q, hQ⟩, PrimeSpectrum.ext hUnder⟩
      have hSurj_π : AlgebraicGeometry.Surjective π :=
        CategoryTheory.MorphismProperty.IsStableUnderComposition.comp_mem
          (P := P_Surj) π₀ e_U.hom hSurj_π₀
          (CategoryTheory.MorphismProperty.of_isIso P_Surj e_U.hom)
      have hDeck_π : ∀ σ : S ≃ₐ[R] S, d_V σ ≫ π = π := by
        intro σ
        dsimp only [π, d_V]
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        have hcomm : CommRingCat.ofHom (algebraMap R S) ≫ CommRingCat.ofHom σ.symm.toRingHom =
