    obtain ⟨hLinMax, _, _, A_inf_F, hCR_Ainf, hDD_Ainf, hAlgF_Ainf, hAlgAinf_RF, hFrac_Ainf,
      hAlgAinf_E, hAlgAinf_L, hST_FAinfRF, hST_AinfRFE, hST_AinfRFL, hST_AinfEL,
      e_inf, t_K, he_X, htK_map, htK_ne, htK_max, _, hInf_transfer⟩ :=
