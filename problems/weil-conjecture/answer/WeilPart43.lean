                CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
              δ σ ≫ m_τ = δ (τ * σ)) := by
        intro Y g_Y Y_V
        let fst_YV := CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π
        let snd_YV := CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π
        have hδ_cond : ∀ σ : S ≃ₐ[R] S, 𝟙 Y ≫ (g_Y ≫ π) = (g_Y ≫ d_V σ) ≫ π := fun σ => by
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hDeck_π σ]
        let δ : (S ≃ₐ[R] S) → (Y ⟶ Y_V) :=
          fun σ => CategoryTheory.Limits.pullback.lift (𝟙 Y) (g_Y ≫ d_V σ) (hδ_cond σ)
        have hδ_fst : ∀ σ : S ≃ₐ[R] S, δ σ ≫ fst_YV = 𝟙 Y :=
          fun σ => CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hδ_snd : ∀ σ : S ≃ₐ[R] S, δ σ ≫ snd_YV = g_Y ≫ d_V σ :=
          fun σ => CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hEt_fstYV : AlgebraicGeometry.Etale fst_YV :=
