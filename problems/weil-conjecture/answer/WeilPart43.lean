      have hSheets : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V),
          let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ π) π
          ∃ δ : (S ≃ₐ[R] S) → (Y ⟶ Y_V),
