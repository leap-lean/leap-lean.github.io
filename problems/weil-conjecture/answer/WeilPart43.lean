        refine ⟨f₀, ?_⟩
        ext u
        exact (hEmptyW.false (j_W.base u)).elim
      · rw [not_isEmpty_iff] at hEmptyW
        let V_of : ↥W → Set ↥W := fun w => Classical.choose (hWPreirred w)
        have hV_spec : ∀ w : ↥W, IsOpen (V_of w) ∧ w ∈ V_of w ∧ IsPreirreducible (V_of w) :=
