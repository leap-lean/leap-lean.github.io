          rw [hw_z_eq]
          exact (IsIntegral.map (τ_frob.symm.restrictScalars F).toAlgHom hx_b).sub (hx_b.pow q)
        have hw_z_zero : w_z = 0 :=
          hFIntMemProperEqZero hQF_prime.ne_top hw_z_mem hw_z_int
        have hdiff0 : τ_frob.symm x_b - x_b ^ q = 0 := by rw [← hw_z_eq, hw_z_zero]; rfl
        apply IsFractionRing.injective (D.B_V r) (D.L_V r)
        rw [← hτ_B_symm_compat b, map_pow]
        exact sub_eq_zero.mp hdiff0
      obtain ⟨hQu_max, _, _, σ_u_r, hσ_u_pow, hσ_u_ρ⟩ := hQu_all r
      have hσ_u_symm_Fint : ∀ b : D.B_V r, IsIntegral F b → σ_u_r.symm b = b ^ q := by
        intro b hb
        letI : IsScalarTower F R₀_base (D.B_V r) := hST_F_R₀_B
        have hsymm_int : IsIntegral F (σ_u_r.symm b) :=
          IsIntegral.map (σ_u_r.symm.restrictScalars F).toAlgHom hb
        have hdiff0 : σ_u_r.symm b - b ^ q = 0 :=
          hFIntMemProperEqZero hQu_max.ne_top (hσ_u_pow b) (hsymm_int.sub (hb.pow q))
        exact sub_eq_zero.mp hdiff0
      let δ_r : D.B_V r ≃ₐ[R₀_base] D.B_V r := τ_B_r * σ_u_r⁻¹
      have hδ_r_int : ∀ b : D.B_V r, IsIntegral F b → δ_r b = b := by
        intro b hb
        change τ_B_r (σ_u_r.symm b) = b
        rw [hσ_u_symm_Fint b hb, ← hτ_B_symm_Fint b hb, AlgEquiv.apply_symm_apply]
      obtain ⟨g_r, hg_r_G, hg_r_mod⟩ := D.hG_mem r δ_r hδ_r_int
      obtain ⟨σ_L_wit, σ_B_wit, _, hComp_wit, hInert_wit, hρ_wit⟩ := hu_inf_lift r
      have hInert_wit_QF : ∀ y : ↥C_inf_F,
          σ_L_wit (y : D.L_V r) - (y : D.L_V r) ∈ Subtype.val '' (Q_F : Set ↥C_inf_F) := by
        intro y
        dsimp only [Q_F]
        rw [hQF_img, ← he_inf_F_symm y]
        exact hInert_wit (e_inf_F_cl.symm y)
      have hConj_L := hτ_frob_conj σ_L_wit hInert_wit_QF
      have hpow_wit_compat : ∀ (n : ℕ) (b : D.B_V r),
          (σ_L_wit ^ n) (algebraMap (D.B_V r) (D.L_V r) b) =
            algebraMap (D.B_V r) (D.L_V r) ((σ_B_wit ^ n) b) := by
        intro n
        induction n with
        | zero => intro b; rfl
        | succ n ih =>
          intro b
          rw [pow_succ', pow_succ']
          change σ_L_wit ((σ_L_wit ^ n) (algebraMap (D.B_V r) (D.L_V r) b)) =
            algebraMap (D.B_V r) (D.L_V r) (σ_B_wit ((σ_B_wit ^ n) b))
          rw [ih b, hComp_wit]
      have hConj_B : τ_B_r⁻¹ * σ_B_wit * τ_B_r = σ_B_wit ^ q := by
        apply AlgEquiv.ext; intro b
        apply IsFractionRing.injective (D.B_V r) (D.L_V r)
        have hL_b := AlgEquiv.congr_fun hConj_L (algebraMap (D.B_V r) (D.L_V r) b)
        rw [hpow_wit_compat q b] at hL_b
        have hlhs : (τ_frob⁻¹ * σ_L_wit * τ_frob) (algebraMap (D.B_V r) (D.L_V r) b) =
            algebraMap (D.B_V r) (D.L_V r) ((τ_B_r⁻¹ * σ_B_wit * τ_B_r) b) := by
          change τ_frob.symm (σ_L_wit (τ_frob (algebraMap (D.B_V r) (D.L_V r) b))) =
            algebraMap (D.B_V r) (D.L_V r) (τ_B_r.symm (σ_B_wit (τ_B_r b)))
          rw [hτ_B_compat, hComp_wit, hτ_B_symm_compat]
        exact hlhs.symm.trans hL_b
      have hτ_eq_δ : τ_B_r = δ_r * σ_u_r := by dsimp [δ_r]; group
      let π_mod := modUnitsHom r
      have hπ_δ : D.ρ_V r δ_r = π_mod g_r := Units.ext hg_r_mod
      have hπ_u : D.ρ_V r σ_B_wit = π_mod u_inf_wit := Units.ext hρ_wit
      have hπ_F : D.ρ_V r σ_u_r = π_mod D.F_V_u := Units.ext hσ_u_ρ
      have hgr_conj_u : g_r⁻¹ * u_inf_wit * g_r = u_inf_wit := by
        calc g_r⁻¹ * u_inf_wit * g_r = g_r⁻¹ * (u_inf_wit * g_r) := mul_assoc _ _ _
          _ = g_r⁻¹ * (g_r * u_inf_wit) := by rw [← hGV_comm_uinf g_r hg_r_G]
          _ = u_inf_wit := inv_mul_cancel_left g_r u_inf_wit
      have hπ_τ : D.ρ_V r τ_B_r = π_mod (g_r * D.F_V_u) := by
        rw [hτ_eq_δ, map_mul, hπ_δ, hπ_F, ← map_mul]
      have hπ_conj : π_mod (D.F_V_u⁻¹ * u_inf_wit * D.F_V_u) = π_mod (u_inf_wit ^ q) := by
        have hgrp : D.F_V_u⁻¹ * u_inf_wit * D.F_V_u =
            (g_r * D.F_V_u)⁻¹ * u_inf_wit * (g_r * D.F_V_u) := by
          conv_lhs => rw [← hgr_conj_u]
          group
        calc π_mod (D.F_V_u⁻¹ * u_inf_wit * D.F_V_u)
            = π_mod ((g_r * D.F_V_u)⁻¹ * u_inf_wit * (g_r * D.F_V_u)) := by rw [hgrp]
          _ = (π_mod (g_r * D.F_V_u))⁻¹ * π_mod u_inf_wit * π_mod (g_r * D.F_V_u) := by
                rw [map_mul, map_mul, map_inv]
          _ = (D.ρ_V r τ_B_r)⁻¹ * D.ρ_V r σ_B_wit * D.ρ_V r τ_B_r := by
                rw [← hπ_τ, ← hπ_u]
          _ = D.ρ_V r (τ_B_r⁻¹ * σ_B_wit * τ_B_r) := by
                rw [← map_inv, ← map_mul, ← map_mul]
          _ = D.ρ_V r (σ_B_wit ^ q) := by rw [hConj_B]
          _ = π_mod (u_inf_wit ^ q) := by rw [map_pow, hπ_u, ← map_pow]
      have hπ_comm : π_mod (u_inf_wit * D.F_V_u) = π_mod (D.F_V_u * u_inf_wit ^ q) := by
        calc π_mod (u_inf_wit * D.F_V_u)
            = π_mod (D.F_V_u * (D.F_V_u⁻¹ * u_inf_wit * D.F_V_u)) := by
                congr 1; group
          _ = π_mod D.F_V_u * π_mod (D.F_V_u⁻¹ * u_inf_wit * D.F_V_u) := map_mul _ _ _
          _ = π_mod D.F_V_u * π_mod (u_inf_wit ^ q) := by rw [hπ_conj]
          _ = π_mod (D.F_V_u * u_inf_wit ^ q) := (map_mul _ _ _).symm
      exact congrArg Units.val hπ_comm
    have hComm_K : U_inf_K * F_Q = F_Q * (U_inf_K ^ q) := by
      let w_diff := (u_inf_wit * D.F_V_u) * (D.F_V_u * u_inf_wit ^ q)⁻¹
      have hw_diff_id : ∀ x : Fin D.N → K, ((w_diff.val).map ι).mulVec x = x := by
        intro x
        have hbot : ((w_diff.val).map ι).mulVec x - x ∈ (⊥ : Submodule K (Fin D.N → K)) := by
          refine hSubmodClosed ⊥ w_diff x fun r => ?_
          let π_mod := modUnitsHom r
          have hπ_eq : π_mod (u_inf_wit * D.F_V_u) = π_mod (D.F_V_u * u_inf_wit ^ q) :=
            Units.ext (hModComm_all r)
          have hπ_one : π_mod w_diff = π_mod 1 := by
            dsimp [w_diff]; rw [map_mul, map_inv, hπ_eq, mul_inv_cancel, map_one]
          refine ⟨1, (congrArg Units.val hπ_one).symm, ?_⟩
          change ((1 : Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ)).map ι).mulVec x - x ∈ ⊥
          rw [← RingHom.mapMatrix_apply, map_one, Matrix.one_mulVec, sub_self]
          exact Submodule.zero_mem ⊥
        rwa [Submodule.mem_bot, sub_eq_zero] at hbot
      have hw_diff_val1 : w_diff.val = 1 := by
        ext i' j'
        have hv := congrFun (hw_diff_id (Pi.single j' 1)) i'
        simp only [Matrix.mulVec, dotProduct, Pi.single_apply, mul_boole,
          Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte] at hv
        by_cases hij : i' = j'
        · subst hij
          rw [Matrix.one_apply_eq]
          simpa [ι] using hv
        · apply Subtype.ext
          have hji : j' ≠ i' := Ne.symm hij
          simpa [ι, hij, hji] using hv
      have hu_eq : u_inf_wit * D.F_V_u = D.F_V_u * u_inf_wit ^ q :=
        mul_inv_eq_one.mp (Units.ext hw_diff_val1)
      have hval_eq : u_inf_wit.val * D.F_V_u.val = D.F_V_u.val * (u_inf_wit.val ^ q) := by
        have := congrArg Units.val hu_eq
        simpa only [Units.val_mul, Units.val_pow_eq_pow_val] using this
      dsimp [U_inf_K, F_Q]
      simp only [← RingHom.mapMatrix_apply, ← map_pow, ← map_mul, hval_eq]
    have hUpow : ∀ (n : ℕ) (x : Fin D.N → K),
        (U_inf_K ^ n).mulVec x =
          x + ((n : K) * c_inf * dotProduct x (D.J_V.mulVec w_inf)) • w_inf := by
      intro n
      induction n with
      | zero => intro x; simp
      | succ n ih =>
        intro x
        rw [pow_succ', ← Matrix.mulVec_mulVec, ih x, Matrix.mulVec_add, Matrix.mulVec_smul,
          hU_act_K x, hU_act_K w_inf, hSelf_zero w_inf, mul_zero, zero_smul, add_zero]
        push_cast
        have h1 : c_inf * dotProduct x (D.J_V.mulVec w_inf) +
            (n : K) * c_inf * dotProduct x (D.J_V.mulVec w_inf) =
            ((n : K) + 1) * c_inf * dotProduct x (D.J_V.mulVec w_inf) := by ring
        rw [add_assoc, add_right_inj, ← add_smul, h1]
    have hJw_ne : D.J_V.mulVec w_inf ≠ 0 := by
      intro h0
      have hUnit : IsUnit D.J_V :=
        (Matrix.isUnit_iff_isUnit_det D.J_V).mpr (IsUnit.mk0 _ D.hJV_det)
      obtain ⟨uJ, huJ⟩ := hUnit
      apply hw_nz
      calc w_inf = (1 : Matrix (Fin D.N) (Fin D.N) K).mulVec w_inf := (Matrix.one_mulVec _).symm
        _ = (uJ⁻¹.val * uJ.val).mulVec w_inf := by rw [Units.inv_mul]
        _ = uJ⁻¹.val.mulVec (D.J_V.mulVec w_inf) := by rw [huJ, Matrix.mulVec_mulVec]
        _ = 0 := by rw [h0, Matrix.mulVec_zero]
    obtain ⟨j₀, hj₀⟩ := Function.ne_iff.mp hJw_ne
    let y₀ : Fin D.N → K := Pi.single j₀ 1
    have hy₀_dot : dotProduct y₀ (D.J_V.mulVec w_inf) ≠ 0 := by simpa [y₀] using hj₀
    have hComm_vec : ∀ z : Fin D.N → K,
        (c_inf * dotProduct (F_Q.mulVec z) (D.J_V.mulVec w_inf)) • w_inf =
          ((q : K) * c_inf * dotProduct z (D.J_V.mulVec w_inf)) • (F_Q.mulVec w_inf) := by
      intro z
      have h : (U_inf_K * F_Q).mulVec z = (F_Q * (U_inf_K ^ q)).mulVec z :=
        congrArg (fun M => M.mulVec z) hComm_K
      rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hU_act_K (F_Q.mulVec z),
        hUpow q z, Matrix.mulVec_add, Matrix.mulVec_smul] at h
      exact add_left_cancel h
    let z₀ := F_inv_Q.mulVec y₀
    have hFz₀ : F_Q.mulVec z₀ = y₀ := by
      dsimp [z₀, F_Q, F_inv_Q]
      rw [Matrix.mulVec_mulVec, (hUnitMulInv D.F_V_u).1, Matrix.one_mulVec]
    have hRel₀ := hComm_vec z₀
    rw [hFz₀] at hRel₀
    have hsc_ne : (q : K) * c_inf * dotProduct z₀ (D.J_V.mulVec w_inf) ≠ 0 := by
      intro h0
      rw [h0, zero_smul] at hRel₀
      exact (smul_ne_zero (mul_ne_zero hc_inf_ne hy₀_dot) hw_nz) hRel₀
    let lam : K := (c_inf * dotProduct y₀ (D.J_V.mulVec w_inf)) *
      ((q : K) * c_inf * dotProduct z₀ (D.J_V.mulVec w_inf))⁻¹
    have hF_winf : F_Q.mulVec w_inf = lam • w_inf := by
      have hsmul : ((q : K) * c_inf * dotProduct z₀ (D.J_V.mulVec w_inf))⁻¹ •
          (((q : K) * c_inf * dotProduct z₀ (D.J_V.mulVec w_inf)) • (F_Q.mulVec w_inf)) =
        ((q : K) * c_inf * dotProduct z₀ (D.J_V.mulVec w_inf))⁻¹ •
          ((c_inf * dotProduct y₀ (D.J_V.mulVec w_inf)) • w_inf) :=
        congrArg (fun v => ((q : K) * c_inf * dotProduct z₀ (D.J_V.mulVec w_inf))⁻¹ • v)
          hRel₀.symm
      rwa [inv_smul_smul₀ hsc_ne, smul_smul, mul_comm] at hsmul
    have hDot_F : ∀ x : Fin D.N → K,
        dotProduct (F_Q.mulVec x) (D.J_V.mulVec w_inf) =
          ((q : K) * lam) * dotProduct x (D.J_V.mulVec w_inf) := by
      intro x
      have h := hComm_vec x
      rw [hF_winf, smul_smul] at h
      obtain ⟨i₀, hi₀⟩ := Function.ne_iff.mp hw_nz
      have hi := congrFun h i₀
      simp only [Pi.smul_apply, smul_eq_mul] at hi
      have hmul_eq : c_inf * dotProduct (F_Q.mulVec x) (D.J_V.mulVec w_inf) =
          (q : K) * c_inf * dotProduct x (D.J_V.mulVec w_inf) * lam :=
        mul_right_cancel₀ hi₀ hi
      apply mul_left_cancel₀ hc_inf_ne
      linear_combination hmul_eq
    have hSim_pair : ∀ x : Fin D.N → K,
        dotProduct (F_Q.mulVec x) (D.J_V.mulVec (F_Q.mulVec w_inf)) =
          ((q : K) ^ (2 * m + 1)) * dotProduct x (D.J_V.mulVec w_inf) := by
      intro x
      calc dotProduct (F_Q.mulVec x) (D.J_V.mulVec (F_Q.mulVec w_inf))
          = dotProduct (Matrix.vecMul x F_Q.transpose) ((D.J_V * F_Q).mulVec w_inf) := by
              rw [← Matrix.mulVec_transpose, Matrix.transpose_transpose, Matrix.mulVec_mulVec]
        _ = dotProduct x (F_Q.transpose.mulVec ((D.J_V * F_Q).mulVec w_inf)) := by
              rw [← Matrix.dotProduct_mulVec]
        _ = dotProduct x ((F_Q.transpose * D.J_V * F_Q).mulVec w_inf) := by
              rw [Matrix.mulVec_mulVec, Matrix.mul_assoc]
        _ = dotProduct x ((((q : K) ^ (2 * m + 1)) • D.J_V).mulVec w_inf) := by
              dsimp [F_Q, q]; rw [D.hFVu_sim]
        _ = ((q : K) ^ (2 * m + 1)) * dotProduct x (D.J_V.mulVec w_inf) := by
              rw [Matrix.smul_mulVec, dotProduct_smul, smul_eq_mul]
    have hlam_sq : lam ^ 2 = (q : K) ^ (2 * m) := by
      have h1 := hSim_pair y₀
      rw [hF_winf, Matrix.mulVec_smul, dotProduct_smul, smul_eq_mul, hDot_F y₀] at h1
      have h2 : lam * ((q : K) * lam * dotProduct y₀ (D.J_V.mulVec w_inf)) =
          (q : K) ^ (2 * m + 1) * dotProduct y₀ (D.J_V.mulVec w_inf) := h1
      have h3 : (q : K) * lam ^ 2 = (q : K) * (q : K) ^ (2 * m) := by
        apply mul_right_cancel₀ hy₀_dot
        calc (q : K) * lam ^ 2 * dotProduct y₀ (D.J_V.mulVec w_inf)
            = lam * ((q : K) * lam * dotProduct y₀ (D.J_V.mulVec w_inf)) := by ring
          _ = (q : K) ^ (2 * m + 1) * dotProduct y₀ (D.J_V.mulVec w_inf) := h2
          _ = (q : K) * (q : K) ^ (2 * m) * dotProduct y₀ (D.J_V.mulVec w_inf) := by
              rw [pow_succ', mul_assoc]
      exact mul_left_cancel₀ hq_ne_K h3
    have hFsq_map : (D.F_V_u.val ^ 2).map ι = F_Q ^ 2 := by
      dsimp [F_Q]; simp only [← RingHom.mapMatrix_apply, map_pow]
    have hFrob_winf : ∀ x : Fin D.N → K,
        dotProduct
          (((D.F_V_u.val ^ 2).map ι).mulVec x - ((q : K) ^ (2 * m + 2)) • x)
          (D.J_V.mulVec w_inf) = 0 := by
      intro x
      rw [hFsq_map, sub_dotProduct, smul_dotProduct, smul_eq_mul, sq F_Q,
        ← Matrix.mulVec_mulVec, hDot_F (F_Q.mulVec x), hDot_F x]
      calc (q : K) * lam * ((q : K) * lam * dotProduct x (D.J_V.mulVec w_inf)) -
            (q : K) ^ (2 * m + 2) * dotProduct x (D.J_V.mulVec w_inf)
          = ((q : K) ^ 2 * lam ^ 2 - (q : K) ^ (2 * m + 2)) *
              dotProduct x (D.J_V.mulVec w_inf) := by ring
        _ = ((q : K) ^ 2 * (q : K) ^ (2 * m) - (q : K) ^ (2 * m + 2)) *
              dotProduct x (D.J_V.mulVec w_inf) := by rw [hlam_sq]
        _ = 0 := by
            have hpow : (q : K) ^ 2 * (q : K) ^ (2 * m) = (q : K) ^ (2 * m + 2) := by
              rw [← pow_add, add_comm]
            rw [hpow, sub_self, zero_mul]
    refine ⟨hFrob_winf, fun a ha x => ?_⟩
    obtain ⟨h_a, hh_a_G, c_a, hc_a_ne, hh_a_eq⟩ := hConj4 a ha
    have hwa_collin : w_aff a = c_a⁻¹ • w_inf := by
      rw [← hFix_winf h_a hh_a_G, hh_a_eq, inv_smul_smul₀ hc_a_ne]
    rw [hwa_collin, Matrix.mulVec_smul, dotProduct_smul, hFrob_winf x, smul_zero]

  exact ⟨E_push, w_inf, w_aff, hγ'_push, hConj2, hConj3, hConj4, hConj5⟩

theorem weil_mid_dev_padic_saturated_flag_and_symplectic_subquotient (ℓ N : ℕ) [Fact (Nat.Prime ℓ)]
    (J_V : Matrix (Fin N) (Fin N) (Padic ℓ))
    (hJV_skew : J_V.transpose = -J_V)
    (hJV_det : J_V.det ≠ 0)
    (G_V : Subgroup ((Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ))
    (hGV_sp : ∀ g ∈ G_V,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J_V *
        ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = J_V)
    (F_V_u : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (hFVu_norm : ∀ g ∈ G_V, F_V_u * g * F_V_u⁻¹ ∈ G_V)
    (μ_u : Padic ℓ)
    (hFVu_sim :
      ((F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J_V *
        ((F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = μ_u • J_V)
    (E_van E_perp E_rad : Submodule (Padic ℓ) (Fin N → Padic ℓ))
    (hE_perp : ∀ x : Fin N → Padic ℓ,
      x ∈ E_perp ↔ ∀ y ∈ E_van, dotProduct x (J_V.mulVec y) = 0)
    (hE_rad : E_rad = E_van ⊓ E_perp)
    (w_inf : Fin N → Padic ℓ) (hw_van : w_inf ∈ E_van) (hw_noniso : w_inf ∉ E_perp)
    (hSpan_orb : Submodule.span (Padic ℓ)
      { v : Fin N → Padic ℓ |
        ∃ g ∈ G_V, ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf = v } = E_van)
    (hGV_van : ∀ g ∈ G_V, ∀ x : Fin N → Padic ℓ,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x - x ∈ E_van)
    (hGV_perp : ∀ g ∈ G_V, ∀ x ∈ E_perp,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x = x)
    (hFVu_van : ∀ x ∈ E_van,
      ((F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x ∈ E_van)
    (hFVu_rad : ∀ x ∈ E_rad,
      ((F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x ∈ E_rad)
    (c_tr : Padic ℓ) (hc_tr : c_tr ≠ 0)
    (hTransv : ∀ t : PadicInt ℓ, ∃ g ∈ G_V, ∀ x : Fin N → Padic ℓ,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
        x + ((t : Padic ℓ) * c_tr * dotProduct x (J_V.mulVec w_inf)) • w_inf) :
    ∃ (M₀ M M₂ : ℕ) (_ : 1 ≤ M) (hSum : M₀ + M + M₂ = N)
      (P_chg : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
      (J : Matrix (Fin M) (Fin M) (Padic ℓ))
      (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
      (F_u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ)
      (Δ : Set (Fin M → Padic ℓ)),
      let conjP : Matrix (Fin N) (Fin N) (PadicInt ℓ) → Matrix (Fin N) (Fin N) (PadicInt ℓ) :=
        fun A => (P_chg⁻¹).val * A * P_chg.val
      let midBlk : Matrix (Fin N) (Fin N) (PadicInt ℓ) → Matrix (Fin M) (Fin M) (PadicInt ℓ) :=
        fun A k₁ k₂ => conjP A ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩
      (J.transpose = -J ∧ J.det ≠ 0) ∧
      (∀ g ∈ G_geom,
        ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
          ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = J) ∧
      (Δ.Nonempty ∧
        (∀ v ∈ Δ, v ≠ 0) ∧
        Submodule.span (Padic ℓ) Δ = ⊤ ∧
        (∀ v₁ ∈ Δ, ∀ v₂ ∈ Δ, ∃ h ∈ G_geom,
          ((h.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec v₁ = v₂) ∧
        (∀ g ∈ G_geom, ∀ v ∈ Δ,
          ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec v ∈ Δ) ∧
        (∀ v ∈ Δ, ∀ t : PadicInt ℓ, ∃ g ∈ G_geom, ∀ x : Fin M → Padic ℓ,
          ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
            x + ((t : Padic ℓ) * dotProduct x (J.mulVec v)) • v)) ∧
      ((∀ g ∈ G_geom, F_u * g * F_u⁻¹ ∈ G_geom) ∧
        ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
          ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = μ_u • J) ∧
      (∀ x : Fin N → Padic ℓ,
        (x ∈ E_rad ↔ ∀ i : Fin N, M₀ ≤ i.1 →
          (((P_chg⁻¹).val.map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x) i = 0) ∧
        (x ∈ E_van ↔ ∀ i : Fin N, M₀ + M ≤ i.1 →
          (((P_chg⁻¹).val.map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x) i = 0)) ∧
      midBlk F_V_u.val = F_u.val ∧
      (∀ U ∈ ({F_V_u.val, (F_V_u⁻¹).val} : Set (Matrix (Fin N) (Fin N) (PadicInt ℓ))),
        (∀ i j : Fin N, (M₀ ≤ i.1 ∧ j.1 < M₀) → conjP U i j = 0) ∧
        (∀ i j : Fin N, (M₀ + M ≤ i.1 ∧ j.1 < M₀ + M) → conjP U i j = 0)) ∧
      ((∀ g ∈ G_V,
          (∀ i j : Fin N, (M₀ ≤ i.1 ∧ j.1 < M₀) → conjP g.val i j = 0) ∧
          (∀ i j : Fin N, (M₀ + M ≤ i.1 ∧ j.1 < M₀ + M) → conjP g.val i j = 0) ∧
          (∀ i j : Fin N, i.1 < M₀ → j.1 < M₀ → conjP g.val i j = if i = j then 1 else 0) ∧
          (∀ i j : Fin N, M₀ + M ≤ i.1 → M₀ + M ≤ j.1 →
            conjP g.val i j = if i = j then 1 else 0) ∧
          ∃ h ∈ G_geom, h.val = midBlk g.val) ∧
        (∀ h ∈ G_geom, ∃ g ∈ G_V, h.val = midBlk g.val)) ∧
      (∀ (u g₀ : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ) (c : Padic ℓ),
        u ∈ G_V → g₀ ∈ G_V →
        (∀ x : Fin N → Padic ℓ,
          ((u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
            x + (c * dotProduct x (J_V.mulVec
              (((g₀.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf))) •
              (((g₀.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf)) →
        ∃ u_bar ∈ G_geom,
          u_bar.val = midBlk u.val ∧
          ∃ v ∈ Δ, ∃ c' : Padic ℓ, ∀ x : Fin M → Padic ℓ,
            ((u_bar.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
              x + (c' * dotProduct x (J.mulVec v)) • v) ∧
      (∀ (g_P : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ), g_P ∈ G_V →
        ∀ (d : ℕ),
          (((midBlk (g_P.val * (F_V_u.val ^ d))).map
              (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
            ((midBlk (g_P.val * (F_V_u.val ^ d))).map
              (algebraMap (PadicInt ℓ) (Padic ℓ))) = (μ_u ^ d) • J) ∧
          ∀ (hRad_inv : ∀ y ∈ E_rad,
              ((F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin y ∈ E_rad)
            (hVan_inv : E_van ≤ Submodule.comap
              ((F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin E_van)
            (k : ℕ),
            1 ≤ d → 1 ≤ k →
            Matrix.trace (((g_P.val * (F_V_u.val ^ d)).map
                (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ k) =
              LinearMap.trace (Padic ℓ) ↥E_rad
                ((((F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin.restrict
                  hRad_inv) ^ (d * k)) +
                LinearMap.trace (Padic ℓ) ((Fin N → Padic ℓ) ⧸ E_van)
                  ((Submodule.mapQ E_van E_van
                    ((F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin
                    hVan_inv) ^ (d * k)) +
                Matrix.trace (((midBlk (g_P.val * (F_V_u.val ^ d))).map
                  (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ k)) :=
by
  classical
  have _ := hJV_det
  let 𝒪 := PadicInt ℓ
  let K := Padic ℓ
  let ι : 𝒪 →+* K := algebraMap 𝒪 K
  have hι_inj : Function.Injective ι := IsFractionRing.injective 𝒪 K
  have hRad_le_Van : E_rad ≤ E_van := hE_rad ▸ inf_le_left
  have hRad_le_Perp : E_rad ≤ E_perp := hE_rad ▸ inf_le_right
  have hw_not_rad : w_inf ∉ E_rad := fun hm => hw_noniso (hRad_le_Perp hm)

  
  
  
  let Λ := Fin N → 𝒪
  let ι_vec : Λ →ₗ[𝒪] (Fin N → K) :=
    { toFun := fun z i => ι (z i)
      map_add' := fun z₁ z₂ => funext fun i => map_add ι (z₁ i) (z₂ i)
      map_smul' := fun r z => funext fun i => by
        change ι (r * z i) = ι r * ι (z i)
        exact map_mul ι r (z i) }
  have hι_vec_smul : ∀ (r : 𝒪) (z : Λ), ι_vec (r • z) = (ι r) • ι_vec z := by
    intro r z
    ext i
    change ι (r * z i) = ι r * ι (z i)
    exact map_mul ι r (z i)

  let Λ₀ : Submodule 𝒪 Λ := (E_rad.restrictScalars 𝒪).comap ι_vec
  let Λ₁ : Submodule 𝒪 Λ := (E_van.restrictScalars 𝒪).comap ι_vec
  have hΛ₀_le_Λ₁ : Λ₀ ≤ Λ₁ := fun _ hz => hRad_le_Van hz
  let Λ₀₁ : Submodule 𝒪 ↥Λ₁ := Λ₀.comap Λ₁.subtype

  have hTF₀ : Module.IsTorsionFree 𝒪 ↥Λ₀ :=
    Module.IsTorsionFree.of_smul_eq_zero fun r u hru => by
      by_cases hr : r = 0
      · exact Or.inl hr
      · right
        apply Subtype.ext
        ext i
        have hi : r * u.1 i = 0 := by
          simpa [Pi.smul_apply, smul_eq_mul] using congrFun (congrArg Subtype.val hru) i
        exact (mul_eq_zero.mp hi).resolve_left hr

  have hTF₁ : Module.IsTorsionFree 𝒪 (↥Λ₁ ⧸ Λ₀₁) :=
    Module.IsTorsionFree.of_smul_eq_zero fun r q hrq => by
      by_cases hr : r = 0
      · exact Or.inl hr
      · right
        obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective Λ₀₁ q
        rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hrq
        have hmem : ι_vec (r • y.1) ∈ E_rad := hrq
        rw [hι_vec_smul] at hmem
        have hιr : ι r ≠ 0 := fun h0 => hr (hι_inj (h0.trans (map_zero ι).symm))
        have hy0 : ι_vec y.1 ∈ E_rad := by
          simpa [inv_smul_smul₀ hιr] using E_rad.smul_mem (ι r)⁻¹ hmem
        exact (Submodule.Quotient.mk_eq_zero Λ₀₁).mpr hy0

  have hTF₂ : Module.IsTorsionFree 𝒪 (Λ ⧸ Λ₁) :=
    Module.IsTorsionFree.of_smul_eq_zero fun r q hrq => by
      by_cases hr : r = 0
      · exact Or.inl hr
      · right
        obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective Λ₁ q
        rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hrq
        have hmem : ι_vec (r • z) ∈ E_van := hrq
        rw [hι_vec_smul] at hmem
        have hιr : ι r ≠ 0 := fun h0 => hr (hι_inj (h0.trans (map_zero ι).symm))
        have hz0 : ι_vec z ∈ E_van := by
          simpa [inv_smul_smul₀ hιr] using E_van.smul_mem (ι r)⁻¹ hmem
        exact (Submodule.Quotient.mk_eq_zero Λ₁).mpr hz0

  have : Module.IsTorsionFree 𝒪 ↥Λ₀ := hTF₀
  have : Module.IsTorsionFree 𝒪 (↥Λ₁ ⧸ Λ₀₁) := hTF₁
  have : Module.IsTorsionFree 𝒪 (Λ ⧸ Λ₁) := hTF₂
  have : Module.Finite 𝒪 (↥Λ₁ ⧸ Λ₀₁) :=
    Module.Finite.of_surjective Λ₀₁.mkQ (Submodule.mkQ_surjective Λ₀₁)
  have : Module.Finite 𝒪 (Λ ⧸ Λ₁) :=
    Module.Finite.of_surjective Λ₁.mkQ (Submodule.mkQ_surjective Λ₁)
  have : Module.Free 𝒪 ↥Λ₀ := Module.free_of_finite_type_torsion_free'
  have : Module.Free 𝒪 (↥Λ₁ ⧸ Λ₀₁) := Module.free_of_finite_type_torsion_free'
  have : Module.Free 𝒪 (Λ ⧸ Λ₁) := Module.free_of_finite_type_torsion_free'

  let M₀ : ℕ := Module.finrank 𝒪 ↥Λ₀
  let M : ℕ := Module.finrank 𝒪 (↥Λ₁ ⧸ Λ₀₁)
  let M₂ : ℕ := Module.finrank 𝒪 (Λ ⧸ Λ₁)
  let b₀ : Module.Basis (Fin M₀) 𝒪 ↥Λ₀ := Module.finBasis 𝒪 ↥Λ₀
  let b₁_bar : Module.Basis (Fin M) 𝒪 (↥Λ₁ ⧸ Λ₀₁) := Module.finBasis 𝒪 (↥Λ₁ ⧸ Λ₀₁)
  let b₂_bar : Module.Basis (Fin M₂) 𝒪 (Λ ⧸ Λ₁) := Module.finBasis 𝒪 (Λ ⧸ Λ₁)

  let v₁ : Fin M → ↥Λ₁ := fun k =>
    Classical.choose (Submodule.Quotient.mk_surjective Λ₀₁ (b₁_bar k))
  have hv₁ : ∀ k : Fin M, Λ₀₁.mkQ (v₁ k) = b₁_bar k := fun k =>
    Classical.choose_spec (Submodule.Quotient.mk_surjective Λ₀₁ (b₁_bar k))
  let v₂ : Fin M₂ → Λ := fun c =>
    Classical.choose (Submodule.Quotient.mk_surjective Λ₁ (b₂_bar c))
  have hv₂ : ∀ c : Fin M₂, Λ₁.mkQ (v₂ c) = b₂_bar c := fun c =>
    Classical.choose_spec (Submodule.Quotient.mk_surjective Λ₁ (b₂_bar c))

  let s₁ : (↥Λ₁ ⧸ Λ₀₁) →ₗ[𝒪] ↥Λ₁ := b₁_bar.constr 𝒪 v₁
  have hs₁ : ∀ q : ↥Λ₁ ⧸ Λ₀₁, Λ₀₁.mkQ (s₁ q) = q := by
    have hcomp : Λ₀₁.mkQ ∘ₗ s₁ = LinearMap.id :=
      b₁_bar.ext fun k => by simp [s₁, hv₁ k]
    exact fun q => LinearMap.congr_fun hcomp q

  let s₂ : (Λ ⧸ Λ₁) →ₗ[𝒪] Λ := b₂_bar.constr 𝒪 v₂
  have hs₂ : ∀ r : Λ ⧸ Λ₁, Λ₁.mkQ (s₂ r) = r := by
    have hcomp : Λ₁.mkQ ∘ₗ s₂ = LinearMap.id :=
      b₂_bar.ext fun c => by simp [s₂, hv₂ c]
    exact fun r => LinearMap.congr_fun hcomp r

  let incl₀₁ : ↥Λ₀ →ₗ[𝒪] ↥Λ₁ := Submodule.inclusion hΛ₀_le_Λ₁
  have h_proj₀_mem : ∀ y : ↥Λ₁, (y - s₁ (Λ₀₁.mkQ y)).1 ∈ Λ₀ := by
    intro y
    change y - s₁ (Λ₀₁.mkQ y) ∈ Λ₀₁
    rw [← Submodule.Quotient.mk_eq_zero]
    change Λ₀₁.mkQ (y - s₁ (Λ₀₁.mkQ y)) = 0
    rw [map_sub, hs₁, sub_self]

  let proj₀ : ↥Λ₁ →ₗ[𝒪] ↥Λ₀ :=
    { toFun := fun y => ⟨(y - s₁ (Λ₀₁.mkQ y)).1, h_proj₀_mem y⟩
      map_add' := fun y₁ y₂ => by
        apply Subtype.ext
        simp only [map_add, Submodule.coe_add, Submodule.coe_sub]
        abel
      map_smul' := fun r y => by
        apply Subtype.ext
        simp only [map_smul, Submodule.coe_smul_of_tower, Submodule.coe_sub, RingHom.id_apply,
          smul_sub] }

  have hproj₀_val : ∀ y : ↥Λ₁, (proj₀ y).1 = (y - s₁ (Λ₀₁.mkQ y)).1 := fun _ => rfl

  let e₁ : (↥Λ₀ × (↥Λ₁ ⧸ Λ₀₁)) ≃ₗ[𝒪] ↥Λ₁ :=
    { toFun := fun p => incl₀₁ p.1 + s₁ p.2
      invFun := fun y => (proj₀ y, Λ₀₁.mkQ y)
      map_add' := fun p q => by simp only [Prod.fst_add, Prod.snd_add, map_add]; abel
      map_smul' := fun r p => by
        simp only [Prod.smul_fst, Prod.smul_snd, map_smul, RingHom.id_apply, smul_add]
      left_inv := fun ⟨u, q⟩ => by
        have hmk_u : Λ₀₁.mkQ (incl₀₁ u) = 0 :=
          (Submodule.Quotient.mk_eq_zero Λ₀₁).mpr u.2
        have hmk : Λ₀₁.mkQ (incl₀₁ u + s₁ q) = q := by
          rw [map_add, hmk_u, zero_add, hs₁]
        ext1
        · apply Subtype.ext
          rw [hproj₀_val, hmk, add_sub_cancel_right]
          rfl
        · exact hmk
      right_inv := fun y => by
        apply Subtype.ext
        change (proj₀ y).1 + (s₁ (Λ₀₁.mkQ y)).1 = y.1
        rw [hproj₀_val, Submodule.coe_sub]
        exact sub_add_cancel y.1 (s₁ (Λ₀₁.mkQ y)).1 }

  have h_proj₁_mem : ∀ z : Λ, z - s₂ (Λ₁.mkQ z) ∈ Λ₁ := by
    intro z
    rw [← Submodule.Quotient.mk_eq_zero]
    change Λ₁.mkQ (z - s₂ (Λ₁.mkQ z)) = 0
    rw [map_sub, hs₂, sub_self]

  let proj₁ : Λ →ₗ[𝒪] ↥Λ₁ :=
    { toFun := fun z => ⟨z - s₂ (Λ₁.mkQ z), h_proj₁_mem z⟩
      map_add' := fun z₁ z₂ => by
        apply Subtype.ext
        simp only [map_add, Submodule.coe_add]
        abel
      map_smul' := fun r z => by
        apply Subtype.ext
        simp only [map_smul, Submodule.coe_smul_of_tower, RingHom.id_apply, smul_sub] }
  have hproj₁_val : ∀ z : Λ, (proj₁ z).1 = z - s₂ (Λ₁.mkQ z) := fun _ => rfl

  let e₂ : (↥Λ₁ × (Λ ⧸ Λ₁)) ≃ₗ[𝒪] Λ :=
    { toFun := fun p => p.1.1 + s₂ p.2
      invFun := fun z => (proj₁ z, Λ₁.mkQ z)
      map_add' := fun p q => by simp only [Prod.fst_add, Prod.snd_add, Submodule.coe_add, map_add]; abel
      map_smul' := fun r p => by
        simp only [Prod.smul_fst, Prod.smul_snd, Submodule.coe_smul_of_tower, map_smul,
          RingHom.id_apply, smul_add]
      left_inv := fun ⟨w, r⟩ => by
        have hmk_w : Λ₁.mkQ w.1 = 0 := (Submodule.Quotient.mk_eq_zero Λ₁).mpr w.2
        have hmk : Λ₁.mkQ (w.1 + s₂ r) = r := by
          rw [map_add, hmk_w, zero_add, hs₂]
        ext1
        · apply Subtype.ext
          rw [hproj₁_val, hmk, add_sub_cancel_right]
        · exact hmk
      right_inv := fun z => sub_add_cancel z (s₂ (Λ₁.mkQ z)) }

  have hSum : M₀ + M + M₂ = N := by
    let b_Λ : Module.Basis ((Fin M₀ ⊕ Fin M) ⊕ Fin M₂) 𝒪 Λ :=
      (((b₀.prod b₁_bar).map e₁).prod b₂_bar).map e₂
    have h1 := Module.finrank_eq_card_basis b_Λ
    have h2 := Module.finrank_eq_card_basis (Pi.basisFun 𝒪 (Fin N))
    rw [h1] at h2
    simpa [Fintype.card_sum, Fintype.card_fin] using h2

  let splitEquiv : (((Fin M₀ → 𝒪) × (Fin M → 𝒪)) × (Fin M₂ → 𝒪)) ≃ₗ[𝒪] (Fin N → 𝒪) :=
    { toFun := fun p i =>
        if h₀ : i.1 < M₀ then p.1.1 ⟨i.1, h₀⟩
        else if h₁ : i.1 < M₀ + M then p.1.2 ⟨i.1 - M₀, by omega⟩
        else p.2 ⟨i.1 - (M₀ + M), by omega⟩
      invFun := fun f =>
        ((fun a => f ⟨a.1, by omega⟩, fun k => f ⟨M₀ + k.1, by omega⟩),
          fun c => f ⟨M₀ + M + c.1, by omega⟩)
      map_add' := fun p q => by
        ext i; dsimp; split_ifs <;> rfl
      map_smul' := fun r p => by
        ext i; dsimp; split_ifs <;> rfl
      left_inv := fun ⟨⟨f₀, f₁⟩, f₂⟩ => by
        ext x
        · dsimp
          simp only [x.2, ↓reduceDIte]
        · dsimp
          have hn₀ : ¬ (M₀ + x.1 < M₀) := by omega
          have h₁ : M₀ + x.1 < M₀ + M := by omega
          simp only [hn₀, h₁, ↓reduceDIte]
          congr 1; ext; dsimp; omega
        · dsimp
          have hn₀ : ¬ (M₀ + M + x.1 < M₀) := by omega
          have hn₁ : ¬ (M₀ + M + x.1 < M₀ + M) := by omega
          simp only [hn₀, hn₁, ↓reduceDIte]
          congr 1; ext; dsimp; omega
      right_inv := fun f => by
        ext i; dsimp
        split_ifs with h₀ h₁ <;> congr 1 <;> ext <;> dsimp <;> omega }

  let Φ : (Fin N → 𝒪) ≃ₗ[𝒪] (Fin N → 𝒪) :=
    (e₂.symm.trans ((e₁.symm.trans (b₀.equivFun.prodCongr b₁_bar.equivFun)).prodCongr
      b₂_bar.equivFun)).trans splitEquiv

  have hΦ_mid : ∀ z : Λ, ∀ k : Fin M,
      Φ z ⟨M₀ + k.1, by omega⟩ = b₁_bar.equivFun (Λ₀₁.mkQ (proj₁ z)) k := by
    intro z k
    change (splitEquiv.symm (Φ z)).1.2 k = _
    dsimp [Φ]
    rw [splitEquiv.symm_apply_apply]
    rfl

  have hΦ_high : ∀ z : Λ, ∀ c : Fin M₂,
      Φ z ⟨M₀ + M + c.1, by omega⟩ = b₂_bar.equivFun (Λ₁.mkQ z) c := by
    intro z c
    change (splitEquiv.symm (Φ z)).2 c = _
    dsimp [Φ]
    rw [splitEquiv.symm_apply_apply]
    rfl

  have hΛ₁_iff : ∀ z : Λ, z ∈ Λ₁ ↔ ∀ i : Fin N, M₀ + M ≤ i.1 → Φ z i = 0 := by
    intro z
    constructor
    · intro hz i hi
      have hmk0 : Λ₁.mkQ z = 0 := (Submodule.Quotient.mk_eq_zero Λ₁).mpr hz
      let c : Fin M₂ := ⟨i.1 - (M₀ + M), by omega⟩
      have hi_eq : i = ⟨M₀ + M + c.1, by omega⟩ := by ext; dsimp [c]; omega
      rw [hi_eq, hΦ_high z c, hmk0, map_zero, Pi.zero_apply]
    · intro hzero
      have hfun0 : b₂_bar.equivFun (Λ₁.mkQ z) = 0 := by
        ext c
        rw [← hΦ_high z c]
        exact hzero ⟨M₀ + M + c.1, by omega⟩ (by dsimp; omega)
      have hmk0 : Λ₁.mkQ z = 0 := b₂_bar.equivFun.map_eq_zero_iff.mp hfun0
      exact (Submodule.Quotient.mk_eq_zero Λ₁).mp hmk0

  have hΛ₀_iff : ∀ z : Λ, z ∈ Λ₀ ↔ ∀ i : Fin N, M₀ ≤ i.1 → Φ z i = 0 := by
    intro z
    constructor
    · intro hz₀ i hi
      have hz₁ : z ∈ Λ₁ := hΛ₀_le_Λ₁ hz₀
      by_cases hi₂ : M₀ + M ≤ i.1
      · exact (hΛ₁_iff z).mp hz₁ i hi₂
      · have hmk₁ : Λ₁.mkQ z = 0 := (Submodule.Quotient.mk_eq_zero Λ₁).mpr hz₁
        have hproj₁_eq : proj₁ z = ⟨z, hz₁⟩ := by
          apply Subtype.ext
          rw [hproj₁_val, hmk₁, map_zero, sub_zero]
        have hmk₀₁ : Λ₀₁.mkQ (proj₁ z) = 0 := by
          rw [hproj₁_eq]
          exact (Submodule.Quotient.mk_eq_zero Λ₀₁).mpr hz₀
        let k : Fin M := ⟨i.1 - M₀, by omega⟩
        have hi_eq : i = ⟨M₀ + k.1, by omega⟩ := by ext; dsimp [k]; omega
        rw [hi_eq, hΦ_mid z k, hmk₀₁, map_zero, Pi.zero_apply]
    · intro hzero
      have hz₁ : z ∈ Λ₁ := (hΛ₁_iff z).mpr fun i hi => hzero i (by omega)
      have hmk₁ : Λ₁.mkQ z = 0 := (Submodule.Quotient.mk_eq_zero Λ₁).mpr hz₁
      have hproj₁_eq : proj₁ z = ⟨z, hz₁⟩ := by
        apply Subtype.ext
        rw [hproj₁_val, hmk₁, map_zero, sub_zero]
      have hfun0 : b₁_bar.equivFun (Λ₀₁.mkQ (proj₁ z)) = 0 := by
        ext k
        rw [← hΦ_mid z k]
        exact hzero ⟨M₀ + k.1, by omega⟩ (by dsimp; omega)
      have hmk₀₁ : Λ₀₁.mkQ (proj₁ z) = 0 := b₁_bar.equivFun.map_eq_zero_iff.mp hfun0
      rw [hproj₁_eq] at hmk₀₁
      exact (Submodule.Quotient.mk_eq_zero Λ₀₁).mp hmk₀₁

  let P_mat : Matrix (Fin N) (Fin N) 𝒪 := LinearMap.toMatrix' Φ.symm.toLinearMap
  let Q_mat : Matrix (Fin N) (Fin N) 𝒪 := LinearMap.toMatrix' Φ.toLinearMap
  have hPQ : P_mat * Q_mat = 1 := by
    rw [← LinearMap.toMatrix'_comp, LinearEquiv.comp_coe, LinearEquiv.self_trans_symm,
      LinearEquiv.refl_toLinearMap, LinearMap.toMatrix'_id]
  have hQP : Q_mat * P_mat = 1 := by
    rw [← LinearMap.toMatrix'_comp, LinearEquiv.comp_coe, LinearEquiv.symm_trans_self,
      LinearEquiv.refl_toLinearMap, LinearMap.toMatrix'_id]
  let P_chg : (Matrix (Fin N) (Fin N) 𝒪)ˣ := ⟨P_mat, Q_mat, hPQ, hQP⟩
  have hQ_mulVec : ∀ z : Λ, Q_mat.mulVec z = Φ z := fun z =>
    congrFun (congrArg DFunLike.coe (Matrix.toLin'_toMatrix' Φ.toLinearMap)) z

  let P_K : Matrix (Fin N) (Fin N) K := P_mat.map ι
  let Q_K : Matrix (Fin N) (Fin N) K := Q_mat.map ι
  have hPQ_K : P_K * Q_K = 1 := by
    dsimp [P_K, Q_K]
    rw [← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply, ← map_mul, hPQ, map_one]
  have hQP_K : Q_K * P_K = 1 := by
    dsimp [P_K, Q_K]
    rw [← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply, ← map_mul, hQP, map_one]

  have hQK_ι_vec : ∀ (z : Λ) (i : Fin N), (Q_K.mulVec (ι_vec z)) i = ι (Φ z i) := by
    intro z i
    have h1 : (Q_K.mulVec (ι_vec z)) i = ι ((Q_mat.mulVec z) i) := by
      simp only [Q_K, Matrix.mulVec, dotProduct, Matrix.map_apply, ι_vec, LinearMap.coe_mk,
        AddHom.coe_mk, map_sum, map_mul]
    rw [h1, hQ_mulVec]

  have hBasis : ∀ x : Fin N → K,
      (x ∈ E_rad ↔ ∀ i : Fin N, M₀ ≤ i.1 → (Q_K.mulVec x) i = 0) ∧
      (x ∈ E_van ↔ ∀ i : Fin N, M₀ + M ≤ i.1 → (Q_K.mulVec x) i = 0) := by
    intro x
    let a_num : Fin N → 𝒪 := fun j =>
      Classical.choose (IsFractionRing.div_surjective (A := 𝒪) (x j))
    let d_den : Fin N → 𝒪 := fun j =>
      Classical.choose (Classical.choose_spec (IsFractionRing.div_surjective (A := 𝒪) (x j)))
    have hd_spec : ∀ j : Fin N,
        d_den j ∈ nonZeroDivisors 𝒪 ∧ ι (a_num j) / ι (d_den j) = x j := fun j =>
      Classical.choose_spec (Classical.choose_spec (IsFractionRing.div_surjective (A := 𝒪) (x j)))
    have hd_ne : ∀ j : Fin N, d_den j ≠ 0 := fun j =>
      mem_nonZeroDivisors_iff_ne_zero.mp (hd_spec j).1
    let s : 𝒪 := ∏ j : Fin N, d_den j
    have hs_ne : s ≠ 0 := Finset.prod_ne_zero_iff.mpr fun j _ => hd_ne j
    have hιs_ne : ι s ≠ 0 := fun h0 => hs_ne (hι_inj (h0.trans (map_zero ι).symm))
    let z : Λ := fun j => a_num j * ∏ r ∈ Finset.univ.erase j, d_den r
    have hz_eq : ι_vec z = (ι s) • x := by
      ext j
      have hιd_ne : ι (d_den j) ≠ 0 := fun h0 => hd_ne j (hι_inj (h0.trans (map_zero ι).symm))
      have ha_eq : ι (a_num j) = x j * ι (d_den j) :=
        (div_eq_iff hιd_ne).mp (hd_spec j).2
      have hprod_s : ι s = ι (d_den j) * ∏ r ∈ Finset.univ.erase j, ι (d_den r) := by
        dsimp [s]
        rw [map_prod, ← Finset.mul_prod_erase Finset.univ (fun r => ι (d_den r)) (Finset.mem_univ j)]
      change ι (a_num j * ∏ r ∈ Finset.univ.erase j, d_den r) = ι s * x j
      rw [map_mul, map_prod, ha_eq, hprod_s]
      ring
    have hΦ_coord : ∀ i : Fin N, Φ z i = 0 ↔ (Q_K.mulVec x) i = 0 := by
      intro i
      have hvec : (Q_K.mulVec (ι_vec z)) i = ι s * (Q_K.mulVec x) i := by
        rw [hz_eq, Matrix.mulVec_smul, Pi.smul_apply, smul_eq_mul]
      rw [hQK_ι_vec] at hvec
      constructor
      · intro h0
        rw [h0, map_zero] at hvec
        exact (mul_eq_zero.mp hvec.symm).resolve_left hιs_ne
      · intro h0
        rw [h0, mul_zero] at hvec
        exact hι_inj (hvec.trans (map_zero ι).symm)
    have hsmul_mem : ∀ U : Submodule K (Fin N → K), x ∈ U ↔ z ∈ (U.restrictScalars 𝒪).comap ι_vec := by
      intro U
      change x ∈ U ↔ ι_vec z ∈ U
      rw [hz_eq]
      constructor
      · exact fun hx => U.smul_mem (ι s) hx
      · intro hsx
        simpa [inv_smul_smul₀ hιs_ne] using U.smul_mem (ι s)⁻¹ hsx
    refine ⟨?_, ?_⟩
    · rw [hsmul_mem E_rad, hΛ₀_iff]
      exact forall_congr' fun i => imp_congr_right fun _ => hΦ_coord i
    · rw [hsmul_mem E_van, hΛ₁_iff]
      exact forall_congr' fun i => imp_congr_right fun _ => hΦ_coord i

  have hM : 1 ≤ M := by
    by_contra hM0
    have hM_eq : M = 0 := by omega
    have hw_rad : w_inf ∈ E_rad := by
      rw [(hBasis w_inf).1]
      intro i hi
      exact (hBasis w_inf).2.mp hw_van i (by omega)
    exact hw_not_rad hw_rad

  
  
  
  let conjP : Matrix (Fin N) (Fin N) 𝒪 → Matrix (Fin N) (Fin N) 𝒪 :=
    fun A => (P_chg⁻¹).val * A * P_chg.val
  let midBlk : Matrix (Fin N) (Fin N) 𝒪 → Matrix (Fin M) (Fin M) 𝒪 :=
    fun A k₁ k₂ => conjP A ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩

  let emb₀ : Fin M₀ ↪ Fin N :=
    ⟨fun a => ⟨a.1, by omega⟩, fun a b h => Fin.ext (by simpa using congrArg Fin.val h)⟩
  let emb₁ : Fin M ↪ Fin N :=
    ⟨fun k => ⟨M₀ + k.1, by omega⟩, fun a b h => Fin.ext (by
      have hv : M₀ + a.1 = M₀ + b.1 := congrArg Fin.val h
      omega)⟩
  let emb₂ : Fin M₂ ↪ Fin N :=
    ⟨fun c => ⟨M₀ + M + c.1, by omega⟩, fun a b h => Fin.ext (by
      have hv : M₀ + M + a.1 = M₀ + M + b.1 := congrArg Fin.val h
      omega)⟩

  have hemb₀ : ∀ a : Fin M₀, (emb₀ a).1 = a.1 := fun _ => rfl
  have hemb₁ : ∀ k : Fin M, (emb₁ k).1 = M₀ + k.1 := fun _ => rfl
  have hemb₂ : ∀ c : Fin M₂, (emb₂ c).1 = M₀ + M + c.1 := fun _ => rfl

  let S₀ : Finset (Fin N) := Finset.univ.map emb₀
  let S₁ : Finset (Fin N) := Finset.univ.map emb₁
  let S₂ : Finset (Fin N) := Finset.univ.map emb₂

  have hMemS₀ : ∀ r : Fin N, r ∈ S₀ ↔ r.1 < M₀ := by
    intro r
    simp only [S₀, Finset.mem_map, Finset.mem_univ, true_and]
    refine ⟨fun ⟨a, ha⟩ => ?_, fun hr => ⟨⟨r.1, hr⟩, ?_⟩⟩
    · rw [← ha, hemb₀]; exact a.2
    · apply Fin.ext; rw [hemb₀]

  have hMemS₁ : ∀ r : Fin N, r ∈ S₁ ↔ (M₀ ≤ r.1 ∧ r.1 < M₀ + M) := by
    intro r
    simp only [S₁, Finset.mem_map, Finset.mem_univ, true_and]
    refine ⟨fun ⟨k, hk⟩ => ?_, fun ⟨h1, h2⟩ => ⟨⟨r.1 - M₀, by omega⟩, ?_⟩⟩
    · rw [← hk, hemb₁]; omega
    · apply Fin.ext; rw [hemb₁]; dsimp; omega

  have hMemS₂ : ∀ r : Fin N, r ∈ S₂ ↔ M₀ + M ≤ r.1 := by
    intro r
    simp only [S₂, Finset.mem_map, Finset.mem_univ, true_and]
    refine ⟨fun ⟨c, hc⟩ => ?_, fun hr => ⟨⟨r.1 - (M₀ + M), by omega⟩, ?_⟩⟩
    · rw [← hc, hemb₂]; omega
    · apply Fin.ext; rw [hemb₂]; dsimp; omega

  let isTriR : ∀ {R : Type} [Zero R], Matrix (Fin N) (Fin N) R → Prop :=
    fun X =>
      (∀ i j : Fin N, (M₀ ≤ i.1 ∧ j.1 < M₀) → X i j = 0) ∧
      (∀ i j : Fin N, (M₀ + M ≤ i.1 ∧ j.1 < M₀ + M) → X i j = 0)

  let blk₀₀ : ∀ {R : Type}, Matrix (Fin N) (Fin N) R → Matrix (Fin M₀) (Fin M₀) R :=
    fun X a₁ a₂ => X (emb₀ a₁) (emb₀ a₂)
  let blk₁₁ : ∀ {R : Type}, Matrix (Fin N) (Fin N) R → Matrix (Fin M) (Fin M) R :=
    fun X k₁ k₂ => X (emb₁ k₁) (emb₁ k₂)
  let blk₂₂ : ∀ {R : Type}, Matrix (Fin N) (Fin N) R → Matrix (Fin M₂) (Fin M₂) R :=
    fun X c₁ c₂ => X (emb₂ c₁) (emb₂ c₂)

  have hTri_one : ∀ {R : Type} [CommRing R], isTriR (1 : Matrix (Fin N) (Fin N) R) := by
    intro R _
    refine ⟨fun i j ⟨hi, hj⟩ => Matrix.one_apply_ne (by intro h; rw [h] at hi; omega),
      fun i j ⟨hi, hj⟩ => Matrix.one_apply_ne (by intro h; rw [h] at hi; omega)⟩

  have hBlk_one : ∀ {R : Type} [CommRing R],
      blk₀₀ (1 : Matrix (Fin N) (Fin N) R) = 1 ∧
      blk₁₁ (1 : Matrix (Fin N) (Fin N) R) = 1 ∧
      blk₂₂ (1 : Matrix (Fin N) (Fin N) R) = 1 := by
    intro R _
    refine ⟨?_, ?_, ?_⟩
    · ext a₁ a₂; simp [blk₀₀, Matrix.one_apply, emb₀.injective.eq_iff]
    · ext k₁ k₂; simp [blk₁₁, Matrix.one_apply, emb₁.injective.eq_iff]
    · ext c₁ c₂; simp [blk₂₂, Matrix.one_apply, emb₂.injective.eq_iff]

  have hTri_mul : ∀ {R : Type} [CommRing R] (X Y : Matrix (Fin N) (Fin N) R),
      isTriR X → isTriR Y →
      isTriR (X * Y) ∧
      blk₀₀ (X * Y) = blk₀₀ X * blk₀₀ Y ∧
      blk₁₁ (X * Y) = blk₁₁ X * blk₁₁ Y ∧
      blk₂₂ (X * Y) = blk₂₂ X * blk₂₂ Y := by
    intro R _ X Y hX hY
    refine ⟨⟨?_, ?_⟩, ?_, ?_, ?_⟩
    · intro i j ⟨hi, hj⟩
      rw [Matrix.mul_apply]
      refine Finset.sum_eq_zero fun r _ => ?_
      by_cases hr : r.1 < M₀
      · rw [hX.1 i r ⟨hi, hr⟩, zero_mul]
      · rw [hY.1 r j ⟨by omega, hj⟩, mul_zero]
    · intro i j ⟨hi, hj⟩
      rw [Matrix.mul_apply]
      refine Finset.sum_eq_zero fun r _ => ?_
      by_cases hr : r.1 < M₀ + M
      · rw [hX.2 i r ⟨hi, hr⟩, zero_mul]
      · rw [hY.2 r j ⟨by omega, hj⟩, mul_zero]
    · ext a₁ a₂
      rw [Matrix.mul_apply]
      dsimp [blk₀₀]
      rw [Matrix.mul_apply, ← Finset.sum_subset (Finset.subset_univ S₀), Finset.sum_map]
      intro r _ hrS₀
      rw [hMemS₀] at hrS₀
      rw [hY.1 r (emb₀ a₂) ⟨by omega, by rw [hemb₀]; exact a₂.2⟩, mul_zero]
    · ext k₁ k₂
      rw [Matrix.mul_apply]
      dsimp [blk₁₁]
      rw [Matrix.mul_apply, ← Finset.sum_subset (Finset.subset_univ S₁), Finset.sum_map]
      intro r _ hrS₁
      rw [hMemS₁] at hrS₁
      by_cases hr₀ : r.1 < M₀
      · rw [hX.1 (emb₁ k₁) r ⟨by rw [hemb₁]; omega, hr₀⟩, zero_mul]
      · rw [hY.2 r (emb₁ k₂) ⟨by omega, by rw [hemb₁]; omega⟩, mul_zero]
    · ext c₁ c₂
      rw [Matrix.mul_apply]
      dsimp [blk₂₂]
      rw [Matrix.mul_apply, ← Finset.sum_subset (Finset.subset_univ S₂), Finset.sum_map]
      intro r _ hrS₂
      rw [hMemS₂] at hrS₂
      rw [hX.2 (emb₂ c₁) r ⟨by rw [hemb₂]; omega, by omega⟩, zero_mul]

  have hTri_pow : ∀ {R : Type} [CommRing R] (X : Matrix (Fin N) (Fin N) R),
      isTriR X → ∀ s : ℕ,
        isTriR (X ^ s) ∧
        blk₀₀ (X ^ s) = (blk₀₀ X) ^ s ∧
        blk₁₁ (X ^ s) = (blk₁₁ X) ^ s ∧
        blk₂₂ (X ^ s) = (blk₂₂ X) ^ s := by
    intro R _ X hX s
    induction s with
    | zero =>
      simp only [pow_zero]
      exact ⟨hTri_one, hBlk_one⟩
    | succ s ih =>
      obtain ⟨hs_tri, hs0, hs1, hs2⟩ := ih
      obtain ⟨hm_tri, hm0, hm1, hm2⟩ := hTri_mul (X ^ s) X hs_tri hX
      simp only [pow_succ]
      rw [hm0, hm1, hm2, hs0, hs1, hs2]
      exact ⟨hm_tri, rfl, rfl, rfl⟩

  have hTrace_blocks : ∀ {R : Type} [CommRing R] (X : Matrix (Fin N) (Fin N) R),
      Matrix.trace X = Matrix.trace (blk₀₀ X) + Matrix.trace (blk₂₂ X) + Matrix.trace (blk₁₁ X) := by
    intro R _ X
    have hDisj01 : Disjoint S₀ S₁ := by
      rw [Finset.disjoint_left]
      intro r hr0 hr1
      rw [hMemS₀] at hr0; rw [hMemS₁] at hr1; omega
    have hDisj012 : Disjoint (S₀ ∪ S₁) S₂ := by
      rw [Finset.disjoint_left]
      intro r hr01 hr2
      rw [Finset.mem_union, hMemS₀, hMemS₁] at hr01; rw [hMemS₂] at hr2; omega
    have hUniv : S₀ ∪ S₁ ∪ S₂ = Finset.univ := by
      ext r
      simp only [Finset.mem_union, hMemS₀, hMemS₁, hMemS₂, Finset.mem_univ, iff_true]
      omega
    simp only [Matrix.trace, Matrix.diag]
    rw [← hUniv, Finset.sum_union hDisj012, Finset.sum_union hDisj01,
      Finset.sum_map, Finset.sum_map, Finset.sum_map]
    dsimp [blk₀₀, blk₁₁, blk₂₂]
    ring

  have hConjP_one : conjP 1 = 1 := by
    dsimp [conjP]
    rw [Matrix.mul_one]
    exact hQP
  have hConjP_mul : ∀ A B : Matrix (Fin N) (Fin N) 𝒪, conjP (A * B) = conjP A * conjP B := by
    intro A B
    dsimp [conjP, P_chg]
    calc Q_mat * (A * B) * P_mat
        = Q_mat * A * 1 * B * P_mat := by simp [Matrix.mul_assoc]
      _ = Q_mat * A * (P_mat * Q_mat) * B * P_mat := by rw [hPQ]
      _ = (Q_mat * A * P_mat) * (Q_mat * B * P_mat) := by simp [Matrix.mul_assoc]
  have hConjP_pow : ∀ (A : Matrix (Fin N) (Fin N) 𝒪) (s : ℕ), conjP (A ^ s) = (conjP A) ^ s := by
    intro A s
    induction s with
    | zero => simp [hConjP_one]
    | succ s ih => rw [pow_succ, pow_succ, hConjP_mul, ih]

  have hMulVecSingle : ∀ {R : Type} [CommRing R] (B : Matrix (Fin N) (Fin N) R) (i j : Fin N),
      (B.mulVec (Pi.single j 1)) i = B i j := by
    intro R _ B i j
    simp [Matrix.mulVec, dotProduct, Pi.single_apply]

  let p_vec : Fin N → (Fin N → K) := fun j => P_K.mulVec (Pi.single j 1)
  have hQK_pvec : ∀ j : Fin N, Q_K.mulVec (p_vec j) = Pi.single j 1 := by
    intro j
    dsimp [p_vec]
    rw [Matrix.mulVec_mulVec, hQP_K, Matrix.one_mulVec]

  have hpvec_rad : ∀ j : Fin N, j.1 < M₀ → p_vec j ∈ E_rad := by
    intro j hj
    rw [(hBasis (p_vec j)).1, hQK_pvec j]
    intro i hi
    have hne : i ≠ j := by intro h; rw [h] at hi; omega
    simp [hne]

  have hpvec_van : ∀ j : Fin N, j.1 < M₀ + M → p_vec j ∈ E_van := by
    intro j hj
    rw [(hBasis (p_vec j)).2, hQK_pvec j]
    intro i hi
    have hne : i ≠ j := by intro h; rw [h] at hi; omega
    simp [hne]

  have hConjP_entry_K : ∀ (B : Matrix (Fin N) (Fin N) 𝒪) (i j : Fin N),
      ι (conjP B i j) = (Q_K.mulVec ((B.map ι).mulVec (p_vec j))) i := by
    intro B i j
    have hmap : (conjP B).map ι = Q_K * (B.map ι) * P_K := by
      dsimp [conjP, P_chg, P_K, Q_K]
      simp only [← RingHom.mapMatrix_apply, map_mul]
    calc ι (conjP B i j)
        = ((conjP B).map ι) i j := rfl
      _ = (Q_K * (B.map ι) * P_K) i j := by rw [hmap]
      _ = ((Q_K * (B.map ι) * P_K).mulVec (Pi.single j 1)) i := (hMulVecSingle _ i j).symm
      _ = (Q_K.mulVec ((B.map ι).mulVec (p_vec j))) i := by
          dsimp [p_vec]
          rw [Matrix.mul_assoc, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]

  have hTri_of_stab : ∀ B : Matrix (Fin N) (Fin N) 𝒪,
      (∀ x ∈ E_rad, (B.map ι).mulVec x ∈ E_rad) →
      (∀ x ∈ E_van, (B.map ι).mulVec x ∈ E_van) →
      isTriR (conjP B) := by
    intro B hBrad hBvan
    refine ⟨fun i j ⟨hi, hj⟩ => ?_, fun i j ⟨hi, hj⟩ => ?_⟩
    · apply hι_inj
      rw [map_zero, hConjP_entry_K]
      exact (hBasis _).1.mp (hBrad (p_vec j) (hpvec_rad j hj)) i hi
    · apply hι_inj
      rw [map_zero, hConjP_entry_K]
      exact (hBasis _).2.mp (hBvan (p_vec j) (hpvec_van j hj)) i hi

  have hUnitMulInv : ∀ {n : ℕ} (g : (Matrix (Fin n) (Fin n) 𝒪)ˣ),
      ((g.val).map ι) * (((g⁻¹).val).map ι) = 1 ∧
      (((g⁻¹).val).map ι) * ((g.val).map ι) = 1 := by
    intro n g
    constructor
    · rw [← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply, ← map_mul, Units.mul_inv, map_one]
    · rw [← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply, ← map_mul, Units.inv_mul, map_one]

  let F_K : Matrix (Fin N) (Fin N) K := (F_V_u.val).map ι
  let Finv_K : Matrix (Fin N) (Fin N) K := ((F_V_u⁻¹).val).map ι

  have hFinv_stab : ∀ U : Submodule K (Fin N → K),
      (∀ x ∈ U, F_K.mulVec x ∈ U) → ∀ y ∈ U, Finv_K.mulVec y ∈ U := by
    intro U hU y hy
    let fU : ↥U →ₗ[K] ↥U := F_K.mulVecLin.restrict hU
    have hfU_inj : Function.Injective fU := by
      intro a b hab
      apply Subtype.ext
      have hval : F_K.mulVec a.1 = F_K.mulVec b.1 := congrArg Subtype.val hab
      calc a.1 = (1 : Matrix (Fin N) (Fin N) K).mulVec a.1 := (Matrix.one_mulVec _).symm
        _ = (Finv_K * F_K).mulVec a.1 := by rw [(hUnitMulInv F_V_u).2]
        _ = Finv_K.mulVec (F_K.mulVec a.1) := (Matrix.mulVec_mulVec _ _ _).symm
        _ = Finv_K.mulVec (F_K.mulVec b.1) := by rw [hval]
        _ = (Finv_K * F_K).mulVec b.1 := Matrix.mulVec_mulVec _ _ _
        _ = b.1 := by rw [(hUnitMulInv F_V_u).2, Matrix.one_mulVec]
    obtain ⟨⟨x, hx⟩, hx_eq⟩ := (LinearMap.injective_iff_surjective.mp hfU_inj) ⟨y, hy⟩
    have hFx : F_K.mulVec x = y := congrArg Subtype.val hx_eq
    have hinv_x : Finv_K.mulVec y = x := by
      rw [← hFx, Matrix.mulVec_mulVec, (hUnitMulInv F_V_u).2, Matrix.one_mulVec]
    rwa [hinv_x]

  have hFu_val_tri : isTriR (conjP F_V_u.val) := hTri_of_stab F_V_u.val hFVu_rad hFVu_van
  have hFu_inv_tri : isTriR (conjP (F_V_u⁻¹).val) :=
    hTri_of_stab (F_V_u⁻¹).val (hFinv_stab E_rad hFVu_rad) (hFinv_stab E_van hFVu_van)

  have hFu_tri : ∀ U ∈ ({F_V_u.val, (F_V_u⁻¹).val} : Set (Matrix (Fin N) (Fin N) 𝒪)),
      isTriR (conjP U) := by
    intro U hU
    rcases hU with rfl | hU_inv
    · exact hFu_val_tri
    · rw [Set.mem_singleton_iff] at hU_inv
      rw [hU_inv]
      exact hFu_inv_tri

  have hFu_mul_inv : midBlk F_V_u.val * midBlk (F_V_u⁻¹).val = 1 := by
    change blk₁₁ (conjP F_V_u.val) * blk₁₁ (conjP (F_V_u⁻¹).val) = 1
    rw [← (hTri_mul _ _ hFu_val_tri hFu_inv_tri).2.2.1, ← hConjP_mul, Units.mul_inv,
      hConjP_one, hBlk_one.2.1]
  have hFu_inv_mul : midBlk (F_V_u⁻¹).val * midBlk F_V_u.val = 1 := by
    change blk₁₁ (conjP (F_V_u⁻¹).val) * blk₁₁ (conjP F_V_u.val) = 1
    rw [← (hTri_mul _ _ hFu_inv_tri hFu_val_tri).2.2.1, ← hConjP_mul, Units.inv_mul,
      hConjP_one, hBlk_one.2.1]
  let F_u : (Matrix (Fin M) (Fin M) 𝒪)ˣ :=
    ⟨midBlk F_V_u.val, midBlk (F_V_u⁻¹).val, hFu_mul_inv, hFu_inv_mul⟩

  have hGV_outer : ∀ g ∈ G_V,
      isTriR (conjP g.val) ∧
      (∀ i j : Fin N, i.1 < M₀ → j.1 < M₀ → conjP g.val i j = if i = j then 1 else 0) ∧
      (∀ i j : Fin N, M₀ + M ≤ i.1 → M₀ + M ≤ j.1 →
        conjP g.val i j = if i = j then 1 else 0) := by
    intro g hg
    have hg_rad_fix : ∀ x ∈ E_rad, ((g.val).map ι).mulVec x = x :=
      fun x hx => hGV_perp g hg x (hRad_le_Perp hx)
    have hg_rad_stab : ∀ x ∈ E_rad, ((g.val).map ι).mulVec x ∈ E_rad :=
      fun x hx => by rw [hg_rad_fix x hx]; exact hx
    have hg_van_stab : ∀ x ∈ E_van, ((g.val).map ι).mulVec x ∈ E_van := by
      intro x hx
      have hdiff := hGV_van g hg x
      have heq : ((g.val).map ι).mulVec x = (((g.val).map ι).mulVec x - x) + x := by abel
      rw [heq]
      exact E_van.add_mem hdiff hx
    refine ⟨hTri_of_stab g.val hg_rad_stab hg_van_stab, ?_, ?_⟩
    · intro i j hi hj
      apply hι_inj
      rw [hConjP_entry_K, hg_rad_fix (p_vec j) (hpvec_rad j hj), hQK_pvec j]
      by_cases hij : i = j
      · subst hij; simp
      · simp [hij]
    · intro i j hi hj
      apply hι_inj
      have hdiff_mem := hGV_van g hg (p_vec j)
      have hdiff_zero := (hBasis _).2.mp hdiff_mem i hi
      rw [Matrix.mulVec_sub, Pi.sub_apply, sub_eq_zero] at hdiff_zero
      rw [hConjP_entry_K, hdiff_zero, hQK_pvec j]
      by_cases hij : i = j
      · subst hij; simp
      · simp [hij]

  
  have hConjPowLin : ∀ {W₁ W₂ : Type} [AddCommGroup W₁] [Module K W₁]
      [AddCommGroup W₂] [Module K W₂] (e : W₁ ≃ₗ[K] W₂) (T : W₁ →ₗ[K] W₁) (s : ℕ),
      e.conj (T ^ s) = (e.conj T) ^ s := by
    intro W₁ W₂ _ _ _ _ e T s
    induction s with
    | zero => ext x; simp [LinearEquiv.conj_apply]
    | succ s ih =>
      rw [pow_succ', pow_succ', ← ih, Module.End.mul_eq_comp, Module.End.mul_eq_comp]
      ext x; simp [LinearEquiv.conj_apply]

  have hLinTraceToMatrix : ∀ {m : ℕ} {W : Type} [AddCommGroup W] [Module K W]
      (e : W ≃ₗ[K] (Fin m → K)) (T : W →ₗ[K] W) (B : Matrix (Fin m) (Fin m) K) (s : ℕ),
      (∀ c : Fin m → K, e (T (e.symm c)) = B.mulVec c) →
      LinearMap.trace K W (T ^ s) = Matrix.trace (B ^ s) := by
    intro m W _ _ e T B s hconj
    have he_eq : e.conj T = Matrix.toLin' B := LinearMap.ext hconj
    rw [← LinearMap.trace_conj' (T ^ s) e, hConjPowLin e T s, he_eq, ← Matrix.toLin'_pow,
      LinearMap.trace_eq_matrix_trace K (Pi.basisFun K (Fin m)) (Matrix.toLin' (B ^ s))]
    have hmat : LinearMap.toMatrix (Pi.basisFun K (Fin m)) (Pi.basisFun K (Fin m))
        (Matrix.toLin' (B ^ s)) = B ^ s :=
      Matrix.toLin'.symm_apply_apply (B ^ s)
    rw [hmat]

  have hCoset_trace : ∀ (g_P : (Matrix (Fin N) (Fin N) 𝒪)ˣ), g_P ∈ G_V →
      ∀ (d : ℕ)
        (hRad_inv : ∀ y ∈ E_rad, F_K.mulVecLin y ∈ E_rad)
        (hVan_inv : E_van ≤ Submodule.comap F_K.mulVecLin E_van)
        (k : ℕ),
        Matrix.trace (((g_P.val * (F_V_u.val ^ d)).map ι) ^ k) =
          LinearMap.trace K ↥E_rad ((F_K.mulVecLin.restrict hRad_inv) ^ (d * k)) +
            LinearMap.trace K ((Fin N → K) ⧸ E_van)
              ((Submodule.mapQ E_van E_van F_K.mulVecLin hVan_inv) ^ (d * k)) +
            Matrix.trace (((midBlk (g_P.val * (F_V_u.val ^ d))).map ι) ^ k) := by
    intro g_P hg_P d hRad_inv hVan_inv k
    let C₀ : Matrix (Fin N) (Fin N) 𝒪 := g_P.val * (F_V_u.val ^ d)
    let C : Matrix (Fin N) (Fin N) K := C₀.map ι
    let C_tilde : Matrix (Fin N) (Fin N) K := (conjP C₀).map ι
    have hC_tilde_eq : C_tilde = Q_K * C * P_K := by
      dsimp [C_tilde, C, conjP, P_chg, P_K, Q_K]
      simp only [← RingHom.mapMatrix_apply, map_mul]
    have hC_tilde_pow : ∀ s : ℕ, C_tilde ^ s = Q_K * (C ^ s) * P_K := by
      intro s
      induction s with
      | zero => simp [hQP_K]
      | succ s ih =>
        rw [pow_succ, pow_succ, ih, hC_tilde_eq]
        calc (Q_K * C ^ s * P_K) * (Q_K * C * P_K)
            = Q_K * (C ^ s * (P_K * Q_K) * C) * P_K := by simp [Matrix.mul_assoc]
          _ = Q_K * (C ^ s * C) * P_K := by rw [hPQ_K, Matrix.mul_one]
    have htr_sim : Matrix.trace (C ^ k) = Matrix.trace (C_tilde ^ k) := by
      rw [hC_tilde_pow k, Matrix.trace_mul_comm, ← Matrix.mul_assoc, hPQ_K, Matrix.one_mul]

    let F_tilde : Matrix (Fin N) (Fin N) K := (conjP F_V_u.val).map ι
    let G_tilde : Matrix (Fin N) (Fin N) K := (conjP g_P.val).map ι
    have hTri_map : ∀ A : Matrix (Fin N) (Fin N) 𝒪, isTriR A → isTriR (A.map ι) := by
      intro A hA
      exact ⟨fun i j h => by simp [Matrix.map_apply, hA.1 i j h],
        fun i j h => by simp [Matrix.map_apply, hA.2 i j h]⟩
    have hF_tilde_tri : isTriR F_tilde := hTri_map _ hFu_val_tri
    have hG_tilde_tri : isTriR G_tilde := hTri_map _ (hGV_outer g_P hg_P).1
    have hG_blk00 : blk₀₀ G_tilde = 1 := by
      ext a₁ a₂
      dsimp [blk₀₀, G_tilde]
      rw [(hGV_outer g_P hg_P).2.1 (emb₀ a₁) (emb₀ a₂) (by rw [hemb₀]; exact a₁.2) (by rw [hemb₀]; exact a₂.2)]
      by_cases h : a₁ = a₂
      · subst h; simp
      · have hne : emb₀ a₁ ≠ emb₀ a₂ := emb₀.injective.ne h
        simp [h, hne]
    have hG_blk22 : blk₂₂ G_tilde = 1 := by
      ext c₁ c₂
      dsimp [blk₂₂, G_tilde]
      rw [(hGV_outer g_P hg_P).2.2 (emb₂ c₁) (emb₂ c₂) (by rw [hemb₂]; omega) (by rw [hemb₂]; omega)]
      by_cases h : c₁ = c₂
      · subst h; simp
      · have hne : emb₂ c₁ ≠ emb₂ c₂ := emb₂.injective.ne h
        simp [h, hne]

    have hC_tilde_prod : C_tilde = G_tilde * (F_tilde ^ d) := by
      dsimp [C_tilde, C₀, G_tilde, F_tilde]
      rw [hConjP_mul, hConjP_pow]
      simp only [← RingHom.mapMatrix_apply, map_mul, map_pow]

    obtain ⟨hFd_tri, hFd_00, _, hFd_22⟩ := hTri_pow F_tilde hF_tilde_tri d
    obtain ⟨hC_tri, hC_00, _, hC_22⟩ := hTri_mul G_tilde (F_tilde ^ d) hG_tilde_tri hFd_tri
    rw [← hC_tilde_prod] at hC_tri hC_00 hC_22
    obtain ⟨_, hCk_00, hCk_11, hCk_22⟩ := hTri_pow C_tilde hC_tri k
    rw [hC_00, hG_blk00, one_mul, hFd_00, ← pow_mul] at hCk_00
    rw [hC_22, hG_blk22, one_mul, hFd_22, ← pow_mul] at hCk_22
    have hblk11_C : blk₁₁ C_tilde = (midBlk C₀).map ι := by ext k₁ k₂; rfl
    have hCk_11' : blk₁₁ (C_tilde ^ k) = ((midBlk C₀).map ι) ^ k := by
      rw [← hblk11_C]; exact hCk_11

    
    let ext₀ : (Fin M₀ → K) →ₗ[K] (Fin N → K) :=
      { toFun := fun c i => if h : i.1 < M₀ then c ⟨i.1, h⟩ else 0
        map_add' := fun c₁ c₂ => by ext i; simp only [Pi.add_apply]; split_ifs <;> simp
        map_smul' := fun r c => by
          ext i; simp only [Pi.smul_apply, RingHom.id_apply]; split_ifs <;> simp }
    have hext₀_apply : ∀ (c : Fin M₀ → K) (i : Fin N),
        ext₀ c i = if h : i.1 < M₀ then c ⟨i.1, h⟩ else 0 := fun _ _ => rfl
    let proj_K₀ : (Fin N → K) →ₗ[K] (Fin M₀ → K) :=
      { toFun := fun v a => v (emb₀ a)
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    have hproj_K₀_apply : ∀ (v : Fin N → K) (a : Fin M₀), proj_K₀ v a = v (emb₀ a) :=
      fun _ _ => rfl
    have hext₀_rad : ∀ c : Fin M₀ → K, P_K.mulVec (ext₀ c) ∈ E_rad := by
      intro c
      rw [(hBasis _).1]
      intro i hi
      rw [Matrix.mulVec_mulVec, hQP_K, Matrix.one_mulVec, hext₀_apply]
      have hn : ¬ (i.1 < M₀) := by omega
      simp only [hn, ↓reduceDIte]
    let e_rad : ↥E_rad ≃ₗ[K] (Fin M₀ → K) :=
      { toFun := fun y => proj_K₀ (Q_K.mulVec y.1)
        invFun := fun c => ⟨P_K.mulVec (ext₀ c), hext₀_rad c⟩
        map_add' := fun y₁ y₂ => by
          change proj_K₀ (Q_K.mulVec (y₁.1 + y₂.1)) = _
          rw [Matrix.mulVec_add, map_add]
        map_smul' := fun r y => by
          change proj_K₀ (Q_K.mulVec (r • y.1)) = _
          rw [Matrix.mulVec_smul, map_smul, RingHom.id_apply]
        left_inv := fun y => by
          apply Subtype.ext
          have hhat : ext₀ (proj_K₀ (Q_K.mulVec y.1)) = Q_K.mulVec y.1 := by
            ext i
            rw [hext₀_apply]
            split_ifs with h
            · rfl
            · exact ((hBasis y.1).1.mp y.2 i (by omega)).symm
          change P_K.mulVec (ext₀ (proj_K₀ (Q_K.mulVec y.1))) = y.1
          rw [hhat, Matrix.mulVec_mulVec, hPQ_K, Matrix.one_mulVec]
        right_inv := fun c => by
          ext a
          change proj_K₀ (Q_K.mulVec (P_K.mulVec (ext₀ c))) a = c a
          rw [Matrix.mulVec_mulVec, hQP_K, Matrix.one_mulVec, hproj_K₀_apply, hext₀_apply]
          have ha : (emb₀ a).1 < M₀ := by rw [hemb₀]; exact a.2
          simp only [ha, ↓reduceDIte]
          congr 1 }

    have hF_tilde_eq : F_tilde = Q_K * F_K * P_K := by
      dsimp [F_tilde, F_K, conjP, P_chg, P_K, Q_K]
      simp only [← RingHom.mapMatrix_apply, map_mul]

    have htr_rad : LinearMap.trace K ↥E_rad ((F_K.mulVecLin.restrict hRad_inv) ^ (d * k)) =
        Matrix.trace ((blk₀₀ F_tilde) ^ (d * k)) := by
      refine hLinTraceToMatrix e_rad (F_K.mulVecLin.restrict hRad_inv) (blk₀₀ F_tilde) (d * k) ?_
      intro c
      ext a₁
      have hval : e_rad ((F_K.mulVecLin.restrict hRad_inv) (e_rad.symm c)) a₁ =
          (F_tilde.mulVec (ext₀ c)) (emb₀ a₁) := by
        change (Q_K.mulVec (F_K.mulVec (P_K.mulVec (ext₀ c)))) (emb₀ a₁) = _
        rw [hF_tilde_eq, Matrix.mul_assoc, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
      rw [hval, Matrix.mulVec, dotProduct, ← Finset.sum_subset (Finset.subset_univ S₀),
        Finset.sum_map]
      · simp only [Matrix.mulVec, dotProduct]
        refine Finset.sum_congr rfl fun a₂ _ => ?_
        rw [hext₀_apply]
        have ha₂ : (emb₀ a₂).1 < M₀ := by rw [hemb₀]; exact a₂.2
        simp only [ha₂, ↓reduceDIte]
        rfl
      · intro r _ hrS₀
        rw [hMemS₀] at hrS₀
        rw [hext₀_apply]
        simp only [hrS₀, ↓reduceDIte, mul_zero]

    
    let ext₂ : (Fin M₂ → K) →ₗ[K] (Fin N → K) :=
      { toFun := fun c i => if h : M₀ + M ≤ i.1 then c ⟨i.1 - (M₀ + M), by omega⟩ else 0
        map_add' := fun c₁ c₂ => by ext i; simp only [Pi.add_apply]; split_ifs <;> simp
        map_smul' := fun r c => by
          ext i; simp only [Pi.smul_apply, RingHom.id_apply]; split_ifs <;> simp }
    have hext₂_apply : ∀ (c : Fin M₂ → K) (i : Fin N),
        ext₂ c i = if h : M₀ + M ≤ i.1 then c ⟨i.1 - (M₀ + M), by omega⟩ else 0 :=
      fun _ _ => rfl
    let proj_K₂ : (Fin N → K) →ₗ[K] (Fin M₂ → K) :=
      { toFun := fun v c => v (emb₂ c)
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    have hproj_K₂_apply : ∀ (v : Fin N → K) (c : Fin M₂), proj_K₂ v c = v (emb₂ c) :=
      fun _ _ => rfl
    let ψ_raw : (Fin N → K) →ₗ[K] (Fin M₂ → K) := proj_K₂ ∘ₗ Q_K.mulVecLin
    have hψ_ker : E_van ≤ LinearMap.ker ψ_raw := by
      intro x hx
      ext c
      exact (hBasis x).2.mp hx (emb₂ c) (by rw [hemb₂]; omega)
    let e_quot : ((Fin N → K) ⧸ E_van) ≃ₗ[K] (Fin M₂ → K) :=
      { E_van.liftQ ψ_raw hψ_ker with
        invFun := fun c => Submodule.Quotient.mk (P_K.mulVec (ext₂ c))
        left_inv := fun q => by
          obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective E_van q
          change Submodule.Quotient.mk (P_K.mulVec (ext₂ (E_van.liftQ ψ_raw hψ_ker (Submodule.Quotient.mk x)))) =
            Submodule.Quotient.mk x
          rw [Submodule.liftQ_apply, Submodule.Quotient.eq]
          rw [(hBasis _).2]
          intro i hi
          rw [Matrix.mulVec_sub, Matrix.mulVec_mulVec, hQP_K, Matrix.one_mulVec, Pi.sub_apply,
            hext₂_apply]
          simp only [hi, ↓reduceDIte]
          change (Q_K.mulVec x) (emb₂ ⟨i.1 - (M₀ + M), by omega⟩) - (Q_K.mulVec x) i = 0
          have hidx : emb₂ ⟨i.1 - (M₀ + M), by omega⟩ = i := by
            apply Fin.ext; rw [hemb₂]; dsimp; omega
          rw [hidx, sub_self]
        right_inv := fun c => by
          change E_van.liftQ ψ_raw hψ_ker (Submodule.Quotient.mk (P_K.mulVec (ext₂ c))) = c
          rw [Submodule.liftQ_apply]
          ext c₁
          change proj_K₂ (Q_K.mulVec (P_K.mulVec (ext₂ c))) c₁ = c c₁
          rw [Matrix.mulVec_mulVec, hQP_K, Matrix.one_mulVec, hproj_K₂_apply, hext₂_apply]
          have hc₁ : M₀ + M ≤ (emb₂ c₁).1 := by rw [hemb₂]; omega
          simp only [hc₁, ↓reduceDIte]
          congr 1; apply Fin.ext; dsimp; rw [hemb₂]; omega }

    have htr_quot : LinearMap.trace K ((Fin N → K) ⧸ E_van)
        ((Submodule.mapQ E_van E_van F_K.mulVecLin hVan_inv) ^ (d * k)) =
        Matrix.trace ((blk₂₂ F_tilde) ^ (d * k)) := by
      refine hLinTraceToMatrix e_quot (Submodule.mapQ E_van E_van F_K.mulVecLin hVan_inv)
        (blk₂₂ F_tilde) (d * k) ?_
      intro c
      ext c₁
      have hval : e_quot ((Submodule.mapQ E_van E_van F_K.mulVecLin hVan_inv) (e_quot.symm c)) c₁ =
          (F_tilde.mulVec (ext₂ c)) (emb₂ c₁) := by
        change ψ_raw (F_K.mulVec (P_K.mulVec (ext₂ c))) c₁ = _
        change (Q_K.mulVec (F_K.mulVec (P_K.mulVec (ext₂ c)))) (emb₂ c₁) = _
        rw [hF_tilde_eq, Matrix.mul_assoc, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
      rw [hval, Matrix.mulVec, dotProduct, ← Finset.sum_subset (Finset.subset_univ S₂),
        Finset.sum_map]
      · simp only [Matrix.mulVec, dotProduct]
        refine Finset.sum_congr rfl fun c₂ _ => ?_
        rw [hext₂_apply]
        have hc₂ : M₀ + M ≤ (emb₂ c₂).1 := by rw [hemb₂]; omega
        simp only [hc₂, ↓reduceDIte]
        change F_tilde (emb₂ c₁) (emb₂ c₂) * c ⟨(emb₂ c₂).1 - (M₀ + M), _⟩ =
          blk₂₂ F_tilde c₁ c₂ * c c₂
        congr 2; apply Fin.ext; dsimp; rw [hemb₂]; omega
      · intro r _ hrS₂
        rw [hMemS₂] at hrS₂
        rw [hext₂_apply]
        simp only [hrS₂, ↓reduceDIte, mul_zero]

    rw [htr_sim, hTrace_blocks (C_tilde ^ k), hCk_00, hCk_22, hCk_11', htr_rad, htr_quot]

  
  
  
  let J_tilde : Matrix (Fin N) (Fin N) K := P_K.transpose * J_V * P_K
  let J : Matrix (Fin M) (Fin M) K := c_tr • blk₁₁ J_tilde
  let midVec : (Fin N → K) → (Fin M → K) := fun z k => (Q_K.mulVec z) (emb₁ k)

  have hJ_tilde_skew : J_tilde.transpose = -J_tilde := by
    dsimp [J_tilde]
    rw [Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose, hJV_skew,
      Matrix.neg_mul, Matrix.mul_neg, ← Matrix.mul_assoc]

  have hJ_skew : J.transpose = -J := by
    ext k₁ k₂
    change c_tr * (J_tilde.transpose (emb₁ k₁) (emb₁ k₂)) = -(c_tr * J_tilde (emb₁ k₁) (emb₁ k₂))
    rw [hJ_tilde_skew, Matrix.neg_apply, mul_neg]

  have hPK_pair : ∀ u v : Fin N → K,
      dotProduct (P_K.mulVec u) (J_V.mulVec (P_K.mulVec v)) = dotProduct u (J_tilde.mulVec v) := by
    intro u v
    calc dotProduct (P_K.mulVec u) (J_V.mulVec (P_K.mulVec v))
        = dotProduct (Matrix.vecMul u P_K.transpose) ((J_V * P_K).mulVec v) := by
            rw [← Matrix.mulVec_transpose, Matrix.transpose_transpose, Matrix.mulVec_mulVec]
      _ = dotProduct u (P_K.transpose.mulVec ((J_V * P_K).mulVec v)) := by
            rw [← Matrix.dotProduct_mulVec]
      _ = dotProduct u (J_tilde.mulVec v) := by
            dsimp [J_tilde]
            rw [Matrix.mulVec_mulVec, Matrix.mul_assoc]

  have hJ_tilde_rad_left : ∀ p q : Fin N, p.1 < M₀ → q.1 < M₀ + M → J_tilde p q = 0 := by
    intro p q hp hq
    have hp_perp : p_vec p ∈ E_perp := hRad_le_Perp (hpvec_rad p hp)
    have hq_van : p_vec q ∈ E_van := hpvec_van q hq
    have h0 := (hE_perp (p_vec p)).mp hp_perp (p_vec q) hq_van
    rw [hPK_pair] at h0
    simpa [Matrix.mulVec, dotProduct, Pi.single_apply] using h0

  have hJ_tilde_rad_right : ∀ p q : Fin N, p.1 < M₀ + M → q.1 < M₀ → J_tilde p q = 0 := by
    intro p q hp hq
    have hqp : J_tilde q p = 0 := hJ_tilde_rad_left q p hq hp
    have htr : J_tilde.transpose p q = (-J_tilde) p q := congrFun (congrFun hJ_tilde_skew p) q
    change J_tilde q p = -J_tilde p q at htr
    rw [hqp] at htr
    exact neg_eq_zero.mp htr.symm

  have hCollapse : ∀ u v : Fin N → K,
      (∀ p : Fin N, M₀ + M ≤ p.1 → u p = 0) →
      (∀ q : Fin N, M₀ + M ≤ q.1 → v q = 0) →
      c_tr * dotProduct u (J_tilde.mulVec v) =
        dotProduct (fun r => u (emb₁ r)) (J.mulVec (fun s => v (emb₁ s))) := by
    intro u v hu hv
    have hInner_S₁ : ∀ r : Fin M,
        (J_tilde.mulVec v) (emb₁ r) = ∑ s : Fin M, J_tilde (emb₁ r) (emb₁ s) * v (emb₁ s) := by
      intro r
      rw [Matrix.mulVec, dotProduct, ← Finset.sum_subset (Finset.subset_univ S₁), Finset.sum_map]
      intro q _ hqS₁
      rw [hMemS₁] at hqS₁
      by_cases hq_hi : M₀ + M ≤ q.1
      · rw [hv q hq_hi, mul_zero]
      · rw [hJ_tilde_rad_right (emb₁ r) q (by rw [hemb₁]; omega) (by omega), zero_mul]
    have hOuter_S₁ : dotProduct u (J_tilde.mulVec v) =
        ∑ r : Fin M, u (emb₁ r) * (∑ s : Fin M, J_tilde (emb₁ r) (emb₁ s) * v (emb₁ s)) := by
      rw [dotProduct, ← Finset.sum_subset (Finset.subset_univ S₁), Finset.sum_map]
      · refine Finset.sum_congr rfl fun r _ => by rw [hInner_S₁ r]
      · intro p _ hpS₁
        rw [hMemS₁] at hpS₁
        by_cases hp_hi : M₀ + M ≤ p.1
        · rw [hu p hp_hi, zero_mul]
        · have hin0 : (J_tilde.mulVec v) p = 0 := by
            rw [Matrix.mulVec, dotProduct]
            refine Finset.sum_eq_zero fun q _ => ?_
            by_cases hq_hi : M₀ + M ≤ q.1
            · rw [hv q hq_hi, mul_zero]
            · rw [hJ_tilde_rad_left p q (by omega) (by omega), zero_mul]
          rw [hin0, mul_zero]
    rw [hOuter_S₁, Finset.mul_sum]
    simp only [dotProduct, Matrix.mulVec]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [← mul_assoc, mul_comm c_tr (u (emb₁ r)), mul_assoc, Finset.mul_sum]
    refine congrArg (u (emb₁ r) * ·) (Finset.sum_congr rfl fun s _ => ?_)
    change c_tr * (J_tilde (emb₁ r) (emb₁ s) * v (emb₁ s)) =
      (c_tr * J_tilde (emb₁ r) (emb₁ s)) * v (emb₁ s)
    ring

  have hPair_mid : ∀ x ∈ E_van, ∀ y ∈ E_van,
      c_tr * dotProduct x (J_V.mulVec y) = dotProduct (midVec x) (J.mulVec (midVec y)) := by
    intro x hx y hy
    have hx_eq : P_K.mulVec (Q_K.mulVec x) = x := by
      rw [Matrix.mulVec_mulVec, hPQ_K, Matrix.one_mulVec]
    have hy_eq : P_K.mulVec (Q_K.mulVec y) = y := by
      rw [Matrix.mulVec_mulVec, hPQ_K, Matrix.one_mulVec]
    conv_lhs => rw [← hx_eq, ← hy_eq, hPK_pair]
    exact hCollapse (Q_K.mulVec x) (Q_K.mulVec y) ((hBasis x).2.mp hx) ((hBasis y).2.mp hy)

  let ext₁ : (Fin M → K) → (Fin N → K) :=
    fun u i => if h : M₀ ≤ i.1 ∧ i.1 < M₀ + M then u ⟨i.1 - M₀, by omega⟩ else 0
  let liftMid : (Fin M → K) → (Fin N → K) := fun u => P_K.mulVec (ext₁ u)

  have hQK_liftMid : ∀ u : Fin M → K, Q_K.mulVec (liftMid u) = ext₁ u := by
    intro u
    dsimp [liftMid]
    rw [Matrix.mulVec_mulVec, hQP_K, Matrix.one_mulVec]

  have hmidVec_liftMid : ∀ u : Fin M → K, midVec (liftMid u) = u := by
    intro u
    ext k
    dsimp [midVec]
    rw [hQK_liftMid]
    dsimp [ext₁]
    have hk_in : M₀ ≤ (emb₁ k).1 ∧ (emb₁ k).1 < M₀ + M := by rw [hemb₁]; omega
    simp only [hk_in, and_self, ↓reduceDIte]
    congr 1; apply Fin.ext; dsimp; rw [hemb₁]; omega

  have hliftMid_van : ∀ u : Fin M → K, liftMid u ∈ E_van := by
    intro u
    rw [(hBasis _).2, hQK_liftMid]
    intro i hi
    dsimp [ext₁]
    have hn : ¬ (M₀ ≤ i.1 ∧ i.1 < M₀ + M) := by omega
    simp only [hn, ↓reduceDIte]

  have hJV_skew_pair : ∀ x y : Fin N → K,
      dotProduct x (J_V.mulVec y) = -dotProduct y (J_V.mulVec x) := by
    intro x y
    calc dotProduct x (J_V.mulVec y)
        = dotProduct (Matrix.vecMul x J_V) y := Matrix.dotProduct_mulVec x J_V y
      _ = dotProduct (J_V.transpose.mulVec x) y := by rw [Matrix.mulVec_transpose]
      _ = dotProduct ((-J_V).mulVec x) y := by rw [hJV_skew]
      _ = -dotProduct y (J_V.mulVec x) := by
          rw [Matrix.neg_mulVec, neg_dotProduct, dotProduct_comm]

  have hJ_det : J.det ≠ 0 := by
    intro hdet0
    obtain ⟨u, hu_ne, hJu⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet0
    let x := liftMid u
    have hx_van : x ∈ E_van := hliftMid_van u
    have hx_perp : x ∈ E_perp := by
      rw [hE_perp]
      intro y hy
      have hpair := hPair_mid y hy x hx_van
      rw [hmidVec_liftMid u, hJu, dotProduct_zero] at hpair
      have hyx : dotProduct y (J_V.mulVec x) = 0 :=
        (mul_eq_zero.mp hpair).resolve_left hc_tr
      rw [hJV_skew_pair x y, hyx, neg_zero]
    have hx_rad : x ∈ E_rad := by
      rw [hE_rad]
      exact ⟨hx_van, hx_perp⟩
    apply hu_ne
    ext k
    rw [← hmidVec_liftMid u]
    exact (hBasis x).1.mp hx_rad (emb₁ k) (by rw [hemb₁]; omega)

  have hSim_desc : ∀ (A : Matrix (Fin N) (Fin N) 𝒪) (μ : K),
      (∀ i j : Fin N, (M₀ + M ≤ i.1 ∧ j.1 < M₀ + M) → conjP A i j = 0) →
      (A.map ι).transpose * J_V * (A.map ι) = μ • J_V →
      ((midBlk A).map ι).transpose * J * ((midBlk A).map ι) = μ • J := by
    intro A μ hA_van hA_sim
    let A_tilde : Matrix (Fin N) (Fin N) K := (conjP A).map ι
    have hPA : P_K * A_tilde = (A.map ι) * P_K := by
      have hmap : A_tilde = Q_K * (A.map ι) * P_K := by
        dsimp [A_tilde, conjP, P_chg, P_K, Q_K]
        simp only [← RingHom.mapMatrix_apply, map_mul]
      rw [hmap, ← Matrix.mul_assoc, ← Matrix.mul_assoc, hPQ_K, Matrix.one_mul]
    have hPA_tr : A_tilde.transpose * P_K.transpose = P_K.transpose * (A.map ι).transpose := by
      simpa only [Matrix.transpose_mul] using congrArg Matrix.transpose hPA
    have hAt_sim : A_tilde.transpose * J_tilde * A_tilde = μ • J_tilde := by
      dsimp [J_tilde]
      calc A_tilde.transpose * (P_K.transpose * J_V * P_K) * A_tilde
          = (A_tilde.transpose * P_K.transpose) * J_V * (P_K * A_tilde) := by
              simp [Matrix.mul_assoc]
        _ = P_K.transpose * ((A.map ι).transpose * J_V * (A.map ι)) * P_K := by
              rw [hPA_tr, hPA]
              simp [Matrix.mul_assoc]
        _ = P_K.transpose * (μ • J_V) * P_K := by rw [hA_sim]
        _ = μ • (P_K.transpose * J_V * P_K) := by
              rw [Matrix.mul_smul, Matrix.smul_mul]
    ext k₁ k₂
    let u : Fin N → K := fun p => A_tilde p (emb₁ k₁)
    let v : Fin N → K := fun q => A_tilde q (emb₁ k₂)
    have hu : ∀ p : Fin N, M₀ + M ≤ p.1 → u p = 0 := by
      intro p hp
      dsimp [u, A_tilde]
      rw [hA_van p (emb₁ k₁) ⟨hp, by rw [hemb₁]; omega⟩, map_zero]
    have hv : ∀ q : Fin N, M₀ + M ≤ q.1 → v q = 0 := by
      intro q hq
      dsimp [v, A_tilde]
      rw [hA_van q (emb₁ k₂) ⟨hq, by rw [hemb₁]; omega⟩, map_zero]
    have hlhs : (((midBlk A).map ι).transpose * J * ((midBlk A).map ι)) k₁ k₂ =
        dotProduct (fun r => u (emb₁ r)) (J.mulVec (fun s => v (emb₁ s))) := by
      rw [Matrix.mul_assoc]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.map_apply,
        dotProduct, Matrix.mulVec]
      rfl
    have hrhs_entry : dotProduct u (J_tilde.mulVec v) =
        (A_tilde.transpose * J_tilde * A_tilde) (emb₁ k₁) (emb₁ k₂) := by
      rw [Matrix.mul_assoc]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, dotProduct,
        Matrix.mulVec, u, v]
    rw [hlhs, ← hCollapse u v hu hv, hrhs_entry, hAt_sim]
    change c_tr * (μ * J_tilde (emb₁ k₁) (emb₁ k₂)) = μ * (c_tr * J_tilde (emb₁ k₁) (emb₁ k₂))
    ring

  
  
  
  have hGV_mid_inv : ∀ g : ↥G_V,
      midBlk g.1.val * midBlk (g.1⁻¹).val = 1 ∧
      midBlk (g.1⁻¹).val * midBlk g.1.val = 1 := by
    intro g
    have htri_g : isTriR (conjP g.1.val) := (hGV_outer g.1 g.2).1
    have htri_gi : isTriR (conjP (g.1⁻¹).val) := (hGV_outer g.1⁻¹ (G_V.inv_mem g.2)).1
    constructor
    · change blk₁₁ (conjP g.1.val) * blk₁₁ (conjP (g.1⁻¹).val) = 1
      rw [← (hTri_mul _ _ htri_g htri_gi).2.2.1, ← hConjP_mul, Units.mul_inv, hConjP_one,
        hBlk_one.2.1]
    · change blk₁₁ (conjP (g.1⁻¹).val) * blk₁₁ (conjP g.1.val) = 1
      rw [← (hTri_mul _ _ htri_gi htri_g).2.2.1, ← hConjP_mul, Units.inv_mul, hConjP_one,
        hBlk_one.2.1]

  let π_G : ↥G_V →* (Matrix (Fin M) (Fin M) 𝒪)ˣ :=
    { toFun := fun g =>
        ⟨midBlk g.1.val, midBlk (g.1⁻¹).val, (hGV_mid_inv g).1, (hGV_mid_inv g).2⟩
      map_one' := Units.ext (by
        change blk₁₁ (conjP 1) = 1
        rw [hConjP_one, hBlk_one.2.1])
      map_mul' := fun a b => Units.ext (by
        change blk₁₁ (conjP (a.1.val * b.1.val)) = blk₁₁ (conjP a.1.val) * blk₁₁ (conjP b.1.val)
        rw [hConjP_mul]
        exact (hTri_mul _ _ (hGV_outer a.1 a.2).1 (hGV_outer b.1 b.2).1).2.2.1) }

  let G_geom : Subgroup ((Matrix (Fin M) (Fin M) 𝒪)ˣ) := Subgroup.map π_G ⊤
  have hπ_G_val : ∀ g : ↥G_V, (π_G g).val = midBlk g.1.val := fun _ => rfl

  have hG_sp : ∀ h ∈ G_geom, ((h.val).map ι).transpose * J * ((h.val).map ι) = J := by
    rintro h ⟨g, -, rfl⟩
    rw [hπ_G_val]
    have h1 := hSim_desc g.1.val 1 (hGV_outer g.1 g.2).1.2 (by rw [one_smul]; exact hGV_sp g.1 g.2)
    simpa [one_smul] using h1

  have hFu_norm_geom : ∀ h ∈ G_geom, F_u * h * F_u⁻¹ ∈ G_geom := by
    rintro h ⟨g, -, rfl⟩
    let g' : ↥G_V := ⟨F_V_u * g.1 * F_V_u⁻¹, hFVu_norm g.1 g.2⟩
    refine ⟨g', Subgroup.mem_top g', ?_⟩
    apply Units.ext
    change blk₁₁ (conjP (F_V_u.val * g.1.val * (F_V_u⁻¹).val)) =
      blk₁₁ (conjP F_V_u.val) * blk₁₁ (conjP g.1.val) * blk₁₁ (conjP (F_V_u⁻¹).val)
    rw [hConjP_mul, hConjP_mul]
    obtain ⟨htri1, _, hmul1, _⟩ := hTri_mul _ _ hFu_val_tri (hGV_outer g.1 g.2).1
    obtain ⟨_, _, hmul2, _⟩ := hTri_mul _ _ htri1 hFu_inv_tri
    rw [hmul2, hmul1]

  have hFu_sim_J : ((F_u.val).map ι).transpose * J * ((F_u.val).map ι) = μ_u • J :=
    hSim_desc F_V_u.val μ_u hFu_val_tri.2 hFVu_sim

  let midVecLin : (Fin N → K) →ₗ[K] (Fin M → K) :=
    { toFun := midVec
      map_add' := fun x y => by ext k; dsimp [midVec]; rw [Matrix.mulVec_add, Pi.add_apply]
      map_smul' := fun r x => by
        ext k; dsimp [midVec]; rw [Matrix.mulVec_smul, Pi.smul_apply, smul_eq_mul] }

  have hMidVec_equivar : ∀ (A : Matrix (Fin N) (Fin N) 𝒪),
      isTriR (conjP A) → ∀ y ∈ E_van,
        midVecLin ((A.map ι).mulVec y) = ((midBlk A).map ι).mulVec (midVecLin y) := by
    intro A hAtri y hy
    let y_hat := Q_K.mulVec y
    have hy_eq : P_K.mulVec y_hat = y := by
      dsimp [y_hat]; rw [Matrix.mulVec_mulVec, hPQ_K, Matrix.one_mulVec]
    let A_tilde : Matrix (Fin N) (Fin N) K := (conjP A).map ι
    have hAt_eq : Q_K.mulVec ((A.map ι).mulVec y) = A_tilde.mulVec y_hat := by
      have hmap : A_tilde = Q_K * (A.map ι) * P_K := by
        dsimp [A_tilde, conjP, P_chg, P_K, Q_K]
        simp only [← RingHom.mapMatrix_apply, map_mul]
      rw [← hy_eq, hmap, Matrix.mul_assoc, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
    ext k₁
    change (Q_K.mulVec ((A.map ι).mulVec y)) (emb₁ k₁) = _
    rw [hAt_eq, Matrix.mulVec, dotProduct, ← Finset.sum_subset (Finset.subset_univ S₁),
      Finset.sum_map]
    · simp only [Matrix.mulVec, dotProduct, Matrix.map_apply]
      rfl
    · intro r _ hrS₁
      rw [hMemS₁] at hrS₁
      by_cases hr₀ : r.1 < M₀
      · have h0 : A_tilde (emb₁ k₁) r = 0 := by
          dsimp [A_tilde]
          rw [hAtri.1 (emb₁ k₁) r ⟨by rw [hemb₁]; omega, hr₀⟩, map_zero]
        rw [h0, zero_mul]
      · dsimp [y_hat]
        rw [(hBasis y).2.mp hy r (by omega), mul_zero]

  let v₀ : Fin M → K := midVecLin w_inf
  let Δ : Set (Fin M → K) :=
    { v : Fin M → K | ∃ h ∈ G_geom, ((h.val).map ι).mulVec v₀ = v }

  have hv₀_mem : v₀ ∈ Δ := by
    refine ⟨1, G_geom.one_mem, ?_⟩
    change ((1 : Matrix (Fin M) (Fin M) 𝒪).map ι).mulVec v₀ = v₀
    rw [← RingHom.mapMatrix_apply, map_one, Matrix.one_mulVec]

  have hv₀_ne : v₀ ≠ 0 := by
    intro hv₀
    apply hw_not_rad
    rw [(hBasis w_inf).1]
    intro i hi
    by_cases hi₂ : i.1 < M₀ + M
    · let k : Fin M := ⟨i.1 - M₀, by omega⟩
      have hi_eq : i = emb₁ k := by apply Fin.ext; rw [hemb₁]; dsimp [k]; omega
      rw [hi_eq]
      exact congrFun hv₀ k
    · exact (hBasis w_inf).2.mp hw_van i (by omega)

  have hΔ_nz : ∀ v ∈ Δ, v ≠ 0 := by
    rintro v ⟨h, -, rfl⟩ hv0
    apply hv₀_ne
    calc v₀ = (1 : Matrix (Fin M) (Fin M) K).mulVec v₀ := (Matrix.one_mulVec v₀).symm
      _ = ((((h⁻¹).val).map ι) * ((h.val).map ι)).mulVec v₀ := by rw [(hUnitMulInv h).2]
      _ = (((h⁻¹).val).map ι).mulVec (((h.val).map ι).mulVec v₀) := (Matrix.mulVec_mulVec _ _ _).symm
      _ = 0 := by rw [hv0, Matrix.mulVec_zero]

  have hΔ_span : Submodule.span K Δ = ⊤ := by
    rw [Submodule.eq_top_iff']
    intro x
    let Ω : Set (Fin N → K) :=
      { v : Fin N → K | ∃ g ∈ G_V, ((g.val).map ι).mulVec w_inf = v }
    have hx_mem : liftMid x ∈ Submodule.span K Ω := by
      rw [hSpan_orb]
      exact hliftMid_van x
    have hx_map : x ∈ Submodule.map midVecLin (Submodule.span K Ω) :=
      ⟨liftMid x, hx_mem, hmidVec_liftMid x⟩
    have hmap_le : Submodule.map midVecLin (Submodule.span K Ω) ≤ Submodule.span K Δ := by
      rw [LinearMap.map_span_le]
      rintro y ⟨g, hg, rfl⟩
      apply Submodule.subset_span
      refine ⟨π_G ⟨g, hg⟩, ⟨⟨g, hg⟩, Subgroup.mem_top _, rfl⟩, ?_⟩
      exact (hMidVec_equivar g.val (hGV_outer g hg).1 w_inf hw_van).symm
    exact hmap_le hx_map

  have hΔ_orb : ∀ v₁ ∈ Δ, ∀ v₂ ∈ Δ, ∃ h ∈ G_geom, ((h.val).map ι).mulVec v₁ = v₂ := by
    rintro v₁ ⟨h₁, hh₁, rfl⟩ v₂ ⟨h₂, hh₂, rfl⟩
    refine ⟨h₂ * h₁⁻¹, G_geom.mul_mem hh₂ (G_geom.inv_mem hh₁), ?_⟩
    have hmul : ((h₂ * h₁⁻¹).val).map ι = ((h₂.val).map ι) * (((h₁⁻¹).val).map ι) := by
      rw [Units.val_mul, ← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply,
        ← RingHom.mapMatrix_apply, map_mul]
    rw [hmul, Matrix.mulVec_mulVec, Matrix.mul_assoc, (hUnitMulInv h₁).2, Matrix.mul_one]

  have hΔ_inv : ∀ g ∈ G_geom, ∀ v ∈ Δ, ((g.val).map ι).mulVec v ∈ Δ := by
    rintro g hg v ⟨h, hh, rfl⟩
    refine ⟨g * h, G_geom.mul_mem hg hh, ?_⟩
    have hmul : ((g * h).val).map ι = ((g.val).map ι) * ((h.val).map ι) := by
      rw [Units.val_mul, ← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply,
        ← RingHom.mapMatrix_apply, map_mul]
    rw [hmul, Matrix.mulVec_mulVec]

  have hTransv_v₀ : ∀ t : PadicInt ℓ, ∃ h₀ ∈ G_geom, ∀ x : Fin M → Padic ℓ,
      ((h₀.val).map ι).mulVec x = x + ((t : Padic ℓ) * dotProduct x (J.mulVec v₀)) • v₀ := by
    intro t
    obtain ⟨g, hg, hg_act⟩ := hTransv t
    refine ⟨π_G ⟨g, hg⟩, ⟨⟨g, hg⟩, Subgroup.mem_top _, rfl⟩, fun x => ?_⟩
    rw [hπ_G_val]
    have heq := hMidVec_equivar g.val (hGV_outer g hg).1 (liftMid x) (hliftMid_van x)
    have hx_id : midVecLin (liftMid x) = x := hmidVec_liftMid x
    rw [hx_id] at heq
    rw [← heq, hg_act (liftMid x), map_add, map_smul, hx_id]
    have hpair := hPair_mid (liftMid x) (hliftMid_van x) w_inf hw_van
    change x + ((t : Padic ℓ) * c_tr * dotProduct (liftMid x) (J_V.mulVec w_inf)) • v₀ = _
    rw [mul_assoc (t : Padic ℓ), hpair, hmidVec_liftMid x]
    rfl

  have hΔ_transv : ∀ v ∈ Δ, ∀ t : PadicInt ℓ, ∃ g ∈ G_geom, ∀ x : Fin M → Padic ℓ,
      ((g.val).map ι).mulVec x = x + ((t : Padic ℓ) * dotProduct x (J.mulVec v)) • v := by
    rintro v ⟨γ, hγ, rfl⟩ t
    obtain ⟨h₀, hh₀, hh₀_act⟩ := hTransv_v₀ t
    let Γ := (γ.val).map ι
    let Γ_inv := ((γ⁻¹).val).map ι
    refine ⟨γ * h₀ * γ⁻¹, G_geom.mul_mem (G_geom.mul_mem hγ hh₀) (G_geom.inv_mem hγ), fun x => ?_⟩
    set y := Γ_inv.mulVec x
    have hΓy : Γ.mulVec y = x := by
      dsimp [y, Γ, Γ_inv]
      rw [Matrix.mulVec_mulVec, (hUnitMulInv γ).1, Matrix.one_mulVec]
    have hdot : dotProduct y (J.mulVec v₀) = dotProduct x (J.mulVec (Γ.mulVec v₀)) := by
      have hsp : Γ.transpose * J * Γ = J := hG_sp γ hγ
      calc dotProduct y (J.mulVec v₀)
          = dotProduct y ((Γ.transpose * J * Γ).mulVec v₀) := by rw [hsp]
        _ = dotProduct y (Γ.transpose.mulVec ((J * Γ).mulVec v₀)) := by
              rw [Matrix.mul_assoc, Matrix.mulVec_mulVec]
        _ = dotProduct (Matrix.vecMul y Γ.transpose) ((J * Γ).mulVec v₀) := by
              rw [Matrix.dotProduct_mulVec]
        _ = dotProduct (Γ.mulVec y) ((J * Γ).mulVec v₀) := by
              rw [← Matrix.mulVec_transpose, Matrix.transpose_transpose]
        _ = dotProduct x (J.mulVec (Γ.mulVec v₀)) := by
              rw [hΓy, Matrix.mulVec_mulVec]
    have hmul : ((γ * h₀ * γ⁻¹).val).map ι = Γ * ((h₀.val).map ι) * Γ_inv := by
      dsimp [Γ, Γ_inv]
      simp only [← RingHom.mapMatrix_apply, map_mul]
    rw [hmul, Matrix.mul_assoc, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
    change Γ.mulVec (((h₀.val).map ι).mulVec y) = _
    rw [hh₀_act y, Matrix.mulVec_add, Matrix.mulVec_smul, hΓy, hdot]

  have hTransv_proj : ∀ (u g₀ : (Matrix (Fin N) (Fin N) 𝒪)ˣ) (c : K),
      u ∈ G_V → g₀ ∈ G_V →
      (∀ x : Fin N → K,
        ((u.val).map ι).mulVec x =
          x + (c * dotProduct x (J_V.mulVec (((g₀.val).map ι).mulVec w_inf))) •
            (((g₀.val).map ι).mulVec w_inf)) →
      ∃ u_bar ∈ G_geom,
        u_bar.val = midBlk u.val ∧
        ∃ v ∈ Δ, ∃ c' : K, ∀ x : Fin M → K,
          ((u_bar.val).map ι).mulVec x =
            x + (c' * dotProduct x (J.mulVec v)) • v := by
    intro u g₀ c hu hg₀ hu_act
    let w' : Fin N → K := ((g₀.val).map ι).mulVec w_inf
    have hw'_van : w' ∈ E_van := by
      rw [← hSpan_orb]
      exact Submodule.subset_span ⟨g₀, hg₀, rfl⟩
    let h₀ := π_G ⟨g₀, hg₀⟩
    have hh₀_G : h₀ ∈ G_geom := ⟨⟨g₀, hg₀⟩, Subgroup.mem_top _, rfl⟩
    let v : Fin M → K := midVecLin w'
    have hv_Δ : v ∈ Δ := by
      refine ⟨h₀, hh₀_G, ?_⟩
      exact (hMidVec_equivar g₀.val (hGV_outer g₀ hg₀).1 w_inf hw_van).symm
    let u_bar := π_G ⟨u, hu⟩
    have hubar_G : u_bar ∈ G_geom := ⟨⟨u, hu⟩, Subgroup.mem_top _, rfl⟩
    refine ⟨u_bar, hubar_G, rfl, v, hv_Δ, c * c_tr⁻¹, fun x => ?_⟩
    change ((midBlk u.val).map ι).mulVec x = _
    have heq := hMidVec_equivar u.val (hGV_outer u hu).1 (liftMid x) (hliftMid_van x)
    have hx_id : midVecLin (liftMid x) = x := hmidVec_liftMid x
    rw [hx_id] at heq
    rw [← heq, hu_act (liftMid x), map_add, map_smul, hx_id]
    have hpair := hPair_mid (liftMid x) (hliftMid_van x) w' hw'_van
    rw [hmidVec_liftMid x] at hpair
    have hsc : c * dotProduct (liftMid x) (J_V.mulVec w') =
        (c * c_tr⁻¹) * dotProduct x (J.mulVec v) := by
      calc c * dotProduct (liftMid x) (J_V.mulVec w')
          = (c * c_tr⁻¹) * (c_tr * dotProduct (liftMid x) (J_V.mulVec w')) := by
              rw [mul_assoc, inv_mul_cancel_left₀ hc_tr]
        _ = (c * c_tr⁻¹) * dotProduct x (J.mulVec v) := by rw [hpair]; rfl
    change x + (c * dotProduct (liftMid x) (J_V.mulVec w')) • v = _
    rw [hsc]

  have hFd_sim : ∀ d : ℕ,
      isTriR (conjP (F_V_u.val ^ d)) ∧
      ((F_V_u.val ^ d).map ι).transpose * J_V * ((F_V_u.val ^ d).map ι) = (μ_u ^ d) • J_V := by
    intro d
    induction d with
    | zero =>
      simp only [pow_zero, one_smul]
      have hmap1 : (1 : Matrix (Fin N) (Fin N) 𝒪).map ι = 1 := by
        rw [← RingHom.mapMatrix_apply, map_one]
      rw [hConjP_one, hmap1, Matrix.transpose_one, Matrix.one_mul, Matrix.mul_one]
      exact ⟨hTri_one, rfl⟩
    | succ d ih =>
      obtain ⟨hd_tri, hd_sim⟩ := ih
      have htri_next : isTriR (conjP (F_V_u.val ^ (d + 1))) := by
        rw [pow_succ, hConjP_mul]
        exact (hTri_mul _ _ hd_tri hFu_val_tri).1
      refine ⟨htri_next, ?_⟩
      have hmap_mul : (F_V_u.val ^ (d + 1)).map ι = ((F_V_u.val ^ d).map ι) * F_K := by
        rw [pow_succ]
        simp only [F_K, ← RingHom.mapMatrix_apply, map_mul]
      rw [hmap_mul, Matrix.transpose_mul]
      calc F_K.transpose * ((F_V_u.val ^ d).map ι).transpose * J_V *
            (((F_V_u.val ^ d).map ι) * F_K)
          = F_K.transpose * (((F_V_u.val ^ d).map ι).transpose * J_V *
              ((F_V_u.val ^ d).map ι)) * F_K := by simp [Matrix.mul_assoc]
        _ = F_K.transpose * ((μ_u ^ d) • J_V) * F_K := by rw [hd_sim]
        _ = (μ_u ^ d) • (F_K.transpose * J_V * F_K) := by
              rw [Matrix.mul_smul, Matrix.smul_mul]
        _ = (μ_u ^ d) • (μ_u • J_V) := by rw [hFVu_sim]
        _ = (μ_u ^ (d + 1)) • J_V := by rw [smul_smul, pow_succ]

  have hCoset_sim : ∀ (g_P : (Matrix (Fin N) (Fin N) 𝒪)ˣ), g_P ∈ G_V → ∀ d : ℕ,
      ((midBlk (g_P.val * (F_V_u.val ^ d))).map ι).transpose * J *
        ((midBlk (g_P.val * (F_V_u.val ^ d))).map ι) = (μ_u ^ d) • J := by
    intro g_P hg_P d
    obtain ⟨hd_tri, hd_sim⟩ := hFd_sim d
    have htri_coset : isTriR (conjP (g_P.val * (F_V_u.val ^ d))) := by
      rw [hConjP_mul]
      exact (hTri_mul _ _ (hGV_outer g_P hg_P).1 hd_tri).1
    refine hSim_desc (g_P.val * (F_V_u.val ^ d)) (μ_u ^ d) htri_coset.2 ?_
    have hmap_mul : (g_P.val * (F_V_u.val ^ d)).map ι =
        ((g_P.val).map ι) * ((F_V_u.val ^ d).map ι) := by
      simp only [← RingHom.mapMatrix_apply, map_mul]
    rw [hmap_mul, Matrix.transpose_mul]
    calc ((F_V_u.val ^ d).map ι).transpose * ((g_P.val).map ι).transpose * J_V *
          (((g_P.val).map ι) * ((F_V_u.val ^ d).map ι))
        = ((F_V_u.val ^ d).map ι).transpose *
            (((g_P.val).map ι).transpose * J_V * ((g_P.val).map ι)) *
            ((F_V_u.val ^ d).map ι) := by simp [Matrix.mul_assoc]
      _ = ((F_V_u.val ^ d).map ι).transpose * J_V * ((F_V_u.val ^ d).map ι) := by
            rw [hGV_sp g_P hg_P]
      _ = (μ_u ^ d) • J_V := hd_sim

  
  
  
  refine ⟨M₀, M, M₂, hM, hSum, P_chg, J, G_geom, F_u, Δ,
    ⟨hJ_skew, hJ_det⟩, hG_sp,
    ⟨⟨v₀, hv₀_mem⟩, hΔ_nz, hΔ_span, hΔ_orb, hΔ_inv, hΔ_transv⟩,
    ⟨hFu_norm_geom, hFu_sim_J⟩, hBasis, rfl, hFu_tri,
    ⟨?_, ?_⟩, hTransv_proj, ?_⟩
  · intro g hg
    obtain ⟨htri, h00, h22⟩ := hGV_outer g hg
    exact ⟨htri.1, htri.2, h00, h22, π_G ⟨g, hg⟩, ⟨⟨g, hg⟩, Subgroup.mem_top _, rfl⟩, rfl⟩
  · rintro h ⟨⟨g, hg⟩, -, rfl⟩
    exact ⟨g, hg, rfl⟩
  · intro g_P hg_P d
    exact ⟨hCoset_sim g_P hg_P d,
      fun hRad_inv hVan_inv k _ _ => hCoset_trace g_P hg_P d hRad_inv hVan_inv k⟩

theorem weil_mid_dev_r0_galois_block_quotient_tower (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (ℓ N : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (M₀ M M₂ : ℕ) (hM : 1 ≤ M) (hSum : M₀ + M + M₂ = N)
    (P_chg : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (G_V : Subgroup ((Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ))
    (F_V_u : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (F_V_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin N) (Fin N) (PadicInt ℓ))
    (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
    (F_u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ)
    (F_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin M) (Fin M) (PadicInt ℓ))
    (hFu_mid : (fun k₁ k₂ : Fin M =>
      ((P_chg⁻¹).val * F_V_u.val * P_chg.val) ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩) =
        F_u.val)
    (hFmat_mid : ∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
      (fun k₁ k₂ : Fin M =>
        ((P_chg⁻¹).val * (F_V_mat d P hP) * P_chg.val)
          ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩) = F_mat d P hP)
    (hFu_tri : ∀ U ∈ ({F_V_u.val, (F_V_u⁻¹).val} : Set (Matrix (Fin N) (Fin N) (PadicInt ℓ))),
      (∀ i j : Fin N, (M₀ ≤ i.1 ∧ j.1 < M₀) → ((P_chg⁻¹).val * U * P_chg.val) i j = 0) ∧
      (∀ i j : Fin N, (M₀ + M ≤ i.1 ∧ j.1 < M₀ + M) → ((P_chg⁻¹).val * U * P_chg.val) i j = 0))
    (hGV_blk :
      (∀ g ∈ G_V,
        (∀ i j : Fin N, (M₀ ≤ i.1 ∧ j.1 < M₀) →
          ((P_chg⁻¹).val * g.val * P_chg.val) i j = 0) ∧
        (∀ i j : Fin N, (M₀ + M ≤ i.1 ∧ j.1 < M₀ + M) →
          ((P_chg⁻¹).val * g.val * P_chg.val) i j = 0) ∧
        (∀ i j : Fin N, i.1 < M₀ → j.1 < M₀ →
          ((P_chg⁻¹).val * g.val * P_chg.val) i j = if i = j then 1 else 0) ∧
        (∀ i j : Fin N, M₀ + M ≤ i.1 → M₀ + M ≤ j.1 →
          ((P_chg⁻¹).val * g.val * P_chg.val) i j = if i = j then 1 else 0) ∧
        ∃ h ∈ G_geom, h.val = fun k₁ k₂ : Fin M =>
          ((P_chg⁻¹).val * g.val * P_chg.val) ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩) ∧
      (∀ h ∈ G_geom, ∃ g ∈ G_V, h.val = fun k₁ k₂ : Fin M =>
        ((P_chg⁻¹).val * g.val * P_chg.val) ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩))
    (a₀ : F) (_ha₀ : a₀ ∉ S_aff)
    (B_V L_V : ℕ → Type u)
    (hCR : ∀ r, CommRing (B_V r))
    (hDom : ∀ r, IsDomain (B_V r))
    (hFld : ∀ r, Field (L_V r))
    (hAF_B : ∀ r, Algebra F (B_V r))
    (hAP_B : ∀ r, Algebra (Polynomial F) (B_V r))
    (hAR_B : ∀ r, Algebra
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B_V r))
    (hAF_L : ∀ r, Algebra F (L_V r))
    (hAP_L : ∀ r, Algebra (Polynomial F) (L_V r))
    (hARF_L : ∀ r, Algebra (RatFunc F) (L_V r))
    (hABL : ∀ r, Algebra (B_V r) (L_V r))
    (hARL : ∀ r, Algebra
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (L_V r))
    (hST1 : ∀ r, letI := hCR r; letI := hAF_B r; letI := hAP_B r
      IsScalarTower F (Polynomial F) (B_V r))
    (hST2 : ∀ r, letI := hCR r; letI := hAP_B r; letI := hAR_B r
      IsScalarTower (Polynomial F)
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B_V r))
    (hST3 : ∀ r, letI := hFld r; letI := hAF_L r; letI := hARF_L r
      IsScalarTower F (RatFunc F) (L_V r))
    (hST4 : ∀ r, letI := hFld r; letI := hAP_L r; letI := hARF_L r
      IsScalarTower (Polynomial F) (RatFunc F) (L_V r))
    (hST5 : ∀ r, letI := hCR r; letI := hFld r; letI := hAP_B r; letI := hABL r; letI := hAP_L r
      IsScalarTower (Polynomial F) (B_V r) (L_V r))
    (hST6 : ∀ r, letI := hCR r; letI := hFld r; letI := hAR_B r; letI := hABL r; letI := hARL r
      IsScalarTower
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
        (B_V r) (L_V r))
    (hFin_B : ∀ r, letI := hCR r; letI := hAR_B r
      Module.Finite
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B_V r))
    (hEt_B : ∀ r, letI := hCR r; letI := hAR_B r
      Algebra.Etale
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B_V r))
    (hFrac : ∀ r, letI := hCR r; letI := hFld r; letI := hABL r
      IsFractionRing (B_V r) (L_V r))
    (hIntCl : ∀ r, letI := hCR r; letI := hFld r; letI := hABL r; letI := hARL r
      IsIntegralClosure (B_V r)
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (L_V r))
    (hFD_L : ∀ r, letI := hFld r; letI := hARF_L r
      FiniteDimensional (RatFunc F) (L_V r))
    (hGal_L : ∀ r, letI := hFld r; letI := hARF_L r
      IsGalois (RatFunc F) (L_V r))
    (ρ_V : ∀ r : ℕ, letI := hCR r; letI := hAR_B r
      (B_V r ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))]
        B_V r) →* (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))))ˣ)
    (ι_BV : ∀ r : ℕ, letI := hCR r; letI := hCR (r + 1); letI := hAR_B r; letI := hAR_B (r + 1)
      B_V r →ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))]
        B_V (r + 1))
    (_hρ_inj : ∀ r : ℕ, Function.Injective (ρ_V r))
    (hG_surj : ∀ (r : ℕ) (g : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ), g ∈ G_V →
      letI := hCR r; letI := hAF_B r; letI := hAR_B r
      ∃ σ : B_V r ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B_V r,
        (∀ x : B_V r, IsIntegral F x → σ x = x) ∧
        (ρ_V r σ).val = (g.val).map (PadicInt.toZModPow (r + 1)))
    (hG_mem : ∀ (r : ℕ),
      letI := hCR r; letI := hAF_B r; letI := hAR_B r
      ∀ σ : B_V r ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B_V r,
        (∀ x : B_V r, IsIntegral F x → σ x = x) →
        ∃ g ∈ G_V, (ρ_V r σ).val = (g.val).map (PadicInt.toZModPow (r + 1)))
    (hι_compat : ∀ r : ℕ,
      letI := hCR r; letI := hCR (r + 1); letI := hAR_B r; letI := hAR_B (r + 1)
      Function.Injective (ι_BV r) ∧
      ∀ τ : B_V (r + 1) ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B_V (r + 1),
        ∃ σ : B_V r ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B_V r,
          (∀ b : B_V r, τ (ι_BV r b) = ι_BV r (σ b)) ∧
          ((ρ_V (r + 1) τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) _) =
            (ρ_V r σ).val)
    (hQ_u : ∃ Q_u : ∀ r : ℕ, letI := hCR r; Ideal (B_V r),
      ∀ r : ℕ,
        letI := hCR r; letI := hCR (r + 1); letI := hAP_B r; letI := hAR_B r
        (Q_u r).IsMaximal ∧
        Ideal.comap (algebraMap (Polynomial F) (B_V r)) (Q_u r) =
          Ideal.span {Polynomial.X - Polynomial.C a₀} ∧
        Ideal.comap (ι_BV r).toRingHom (Q_u (r + 1)) = Q_u r ∧
        ∃ σ_u : B_V r ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B_V r,
          (∀ b : B_V r, σ_u.symm b - b ^ Nat.card F ∈ Q_u r) ∧
          (ρ_V r σ_u).val = (F_V_u.val).map (PadicInt.toZModPow (r + 1)))
    (hQ_P : ∀ (d : ℕ) (P_poly : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly),
      ∃ Q_P : ∀ r : ℕ, letI := hCR r; Ideal (B_V r),
        ∀ r : ℕ,
          letI := hCR r; letI := hCR (r + 1); letI := hAP_B r; letI := hAR_B r
          (Q_P r).IsMaximal ∧
          Ideal.comap (algebraMap (Polynomial F) (B_V r)) (Q_P r) = Ideal.span {P_poly} ∧
          Ideal.comap (ι_BV r).toRingHom (Q_P (r + 1)) = Q_P r ∧
          ∃ σ : B_V r ≃ₐ[Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B_V r,
            (∀ b : B_V r, σ.symm b - b ^ (Nat.card F ^ d) ∈ Q_P r) ∧
            (ρ_V r σ).val = (F_V_mat d P_poly hP).map (PadicInt.toZModPow (r + 1))) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∃ (B L_fld : ℕ → Type u)
      (_ : ∀ r, CommRing (B r)) (_ : ∀ r, IsDomain (B r)) (_ : ∀ r, Field (L_fld r))
      (_ : ∀ r, Algebra F (B r)) (_ : ∀ r, Algebra (Polynomial F) (B r)) (_ : ∀ r, Algebra R₀ (B r))
      (_ : ∀ r, Algebra F (L_fld r)) (_ : ∀ r, Algebra (Polynomial F) (L_fld r))
      (_ : ∀ r, Algebra (RatFunc F) (L_fld r))
      (_ : ∀ r, Algebra (B r) (L_fld r)) (_ : ∀ r, Algebra R₀ (L_fld r))
      (_ : ∀ r, IsScalarTower F (Polynomial F) (B r))
      (_ : ∀ r, IsScalarTower (Polynomial F) R₀ (B r))
      (_ : ∀ r, IsScalarTower F (RatFunc F) (L_fld r))
      (_ : ∀ r, IsScalarTower (Polynomial F) (RatFunc F) (L_fld r))
      (_ : ∀ r, IsScalarTower (Polynomial F) (B r) (L_fld r))
      (_ : ∀ r, IsScalarTower R₀ (B r) (L_fld r))
      (_ : ∀ r, Module.Finite R₀ (B r)) (_ : ∀ r, Algebra.Etale R₀ (B r))
      (_ : ∀ r, IsFractionRing (B r) (L_fld r)) (_ : ∀ r, IsIntegralClosure (B r) R₀ (L_fld r))
      (_ : ∀ r, FiniteDimensional (RatFunc F) (L_fld r))
      (_ : ∀ r, IsGalois (RatFunc F) (L_fld r))
      (ρ : ∀ r : ℕ, (B r ≃ₐ[R₀] B r) →* (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ)
      (ι_B : ∀ r : ℕ, B r →ₐ[R₀] B (r + 1))
      (j_B : ∀ r : ℕ, letI := hCR r; letI := hAR_B r; B r →ₐ[R₀] B_V r)
      (ι_L : ∀ r : ℕ, letI := hFld r; letI := hARF_L r; L_fld r →ₐ[RatFunc F] L_V r),
      (∀ r : ℕ, Function.Injective (ρ r)) ∧
      (∀ (r : ℕ) (g : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ), g ∈ G_geom →
        ∃ σ : B r ≃ₐ[R₀] B r,
          (∀ x : B r, IsIntegral F x → σ x = x) ∧
          (ρ r σ).val = (g.val).map (PadicInt.toZModPow (r + 1))) ∧
      (∀ (r : ℕ) (σ : B r ≃ₐ[R₀] B r),
        (∀ x : B r, IsIntegral F x → σ x = x) →
        ∃ g ∈ G_geom, (ρ r σ).val = (g.val).map (PadicInt.toZModPow (r + 1))) ∧
      (∀ r : ℕ, Function.Injective (ι_B r) ∧
        ∀ τ : B (r + 1) ≃ₐ[R₀] B (r + 1),
          ∃ σ : B r ≃ₐ[R₀] B r,
            (∀ b : B r, τ (ι_B r b) = ι_B r (σ b)) ∧
            ((ρ (r + 1) τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) _) =
              (ρ r σ).val) ∧
      (∃ Q_u : ∀ r : ℕ, Ideal (B r),
        ∀ r : ℕ, (Q_u r).IsMaximal ∧
          Ideal.comap (algebraMap (Polynomial F) (B r)) (Q_u r) =
            Ideal.span {Polynomial.X - Polynomial.C a₀} ∧
          Ideal.comap (ι_B r).toRingHom (Q_u (r + 1)) = Q_u r ∧
          ∃ σ_u : B r ≃ₐ[R₀] B r,
            (∀ b : B r, σ_u.symm b - b ^ Nat.card F ∈ Q_u r) ∧
            (ρ r σ_u).val = (F_u.val).map (PadicInt.toZModPow (r + 1))) ∧
      (∀ (d : ℕ) (P : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P),
        ∃ Q_P : ∀ r : ℕ, Ideal (B r),
          ∀ r : ℕ, (Q_P r).IsMaximal ∧
            Ideal.comap (algebraMap (Polynomial F) (B r)) (Q_P r) = Ideal.span {P} ∧
            Ideal.comap (ι_B r).toRingHom (Q_P (r + 1)) = Q_P r ∧
            ∃ σ : B r ≃ₐ[R₀] B r,
              (∀ b : B r, σ.symm b - b ^ (Nat.card F ^ d) ∈ Q_P r) ∧
              (ρ r σ).val = (F_mat d P hP).map (PadicInt.toZModPow (r + 1))) ∧
      (∀ r : ℕ,
        letI := hCR r; letI := hFld r; letI := hAP_L r
        letI := hARF_L r; letI := hABL r; letI := hAR_B r
        Function.Injective (ι_L r) ∧
        (∀ p : Polynomial F,
          ι_L r (algebraMap (Polynomial F) (L_fld r) p) = algebraMap (Polynomial F) (L_V r) p) ∧
        (∀ b : B r,
          algebraMap (B_V r) (L_V r) (j_B r b) = ι_L r (algebraMap (B r) (L_fld r) b))) ∧
      (∀ r : ℕ,
        letI := hCR r; letI := hCR (r + 1); letI := hAF_B r
        letI := hAR_B r; letI := hAR_B (r + 1)
        Function.Injective (j_B r) ∧
        (∀ b : B r, ι_BV r (j_B r b) = j_B (r + 1) (ι_B r b)) ∧
        ∀ τ : B_V r ≃ₐ[R₀] B_V r,
          let A_adap := ((P_chg⁻¹).val.map (PadicInt.toZModPow (r + 1))) *
            (ρ_V r τ).val * (P_chg.val.map (PadicInt.toZModPow (r + 1)))
          (∀ (i j : Fin N), (M₀ ≤ i.1 ∧ j.1 < M₀) → A_adap i j = 0) ∧
          (∀ (i j : Fin N), (M₀ + M ≤ i.1 ∧ j.1 < M₀ + M) → A_adap i j = 0) ∧
          ((∀ x : B_V r, IsIntegral F x → τ x = x) →
            (∀ (i j : Fin N), i.1 < M₀ → j.1 < M₀ → A_adap i j = if i = j then 1 else 0) ∧
            (∀ (i j : Fin N), M₀ + M ≤ i.1 → M₀ + M ≤ j.1 →
              A_adap i j = if i = j then 1 else 0)) ∧
          ∃ σ : B r ≃ₐ[R₀] B r,
            (∀ b : B r, τ (j_B r b) = j_B r (σ b)) ∧
            ∀ (k₁ k₂ : Fin M),
              A_adap ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩ = (ρ r σ).val k₁ k₂) :=
by
  classical
  let _ := hℓ; let _ := hM
  intro R₀
  let K := RatFunc F
  let Δ_aff : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s)
  have hΔ_monic : Δ_aff.Monic :=
    Polynomial.monic_prod_of_monic _ _ fun s _ => Polynomial.monic_X_sub_C s
  have hΔ_ne : Δ_aff ≠ 0 := hΔ_monic.ne_zero
  have hSub_nzd : Submonoid.powers Δ_aff ≤ nonZeroDivisors (Polynomial F) := by
    rintro _ ⟨n, rfl⟩
    exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n hΔ_ne)
  have _ : IsDomain R₀ := IsLocalization.isDomain_localization hSub_nzd
  have _ : IsDedekindDomain R₀ := IsLocalization.isDedekindDomain (Polynomial F) hSub_nzd R₀
  have hΔK_ne : algebraMap (Polynomial F) K Δ_aff ≠ 0 := fun h0 =>
    hΔ_ne (IsFractionRing.injective (Polynomial F) K (h0.trans (map_zero _).symm))
  let _ : Algebra R₀ K := (IsLocalization.Away.lift Δ_aff (IsUnit.mk0 _ hΔK_ne)).toAlgebra
  have _ : IsScalarTower (Polynomial F) R₀ K :=
    IsScalarTower.of_algebraMap_eq fun p =>
      (IsLocalization.Away.lift_eq Δ_aff (IsUnit.mk0 _ hΔK_ne) p).symm
  have _ : IsFractionRing R₀ K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers Δ_aff) R₀ K
  let _ : ∀ r, CommRing (B_V r) := hCR
  have _ : ∀ r, IsDomain (B_V r) := hDom
  let _ : ∀ r, Field (L_V r) := hFld
  let _ : ∀ r, Algebra F (B_V r) := hAF_B
  let _ : ∀ r, Algebra (Polynomial F) (B_V r) := hAP_B
  let _ : ∀ r, Algebra R₀ (B_V r) := hAR_B
  let _ : ∀ r, Algebra F (L_V r) := hAF_L
  let _ : ∀ r, Algebra (Polynomial F) (L_V r) := hAP_L
  let _ : ∀ r, Algebra K (L_V r) := hARF_L
  let _ : ∀ r, Algebra (B_V r) (L_V r) := hABL
  let _ : ∀ r, Algebra R₀ (L_V r) := hARL
  have _ : ∀ r, IsScalarTower F (Polynomial F) (B_V r) := hST1
  have _ : ∀ r, IsScalarTower (Polynomial F) R₀ (B_V r) := hST2
  have _ : ∀ r, IsScalarTower F K (L_V r) := hST3
  have _ : ∀ r, IsScalarTower (Polynomial F) K (L_V r) := hST4
  have _ : ∀ r, IsScalarTower (Polynomial F) (B_V r) (L_V r) := hST5
  have _ : ∀ r, IsScalarTower R₀ (B_V r) (L_V r) := hST6
  have _ : ∀ r, Module.Finite R₀ (B_V r) := hFin_B
  have _ : ∀ r, Algebra.Etale R₀ (B_V r) := hEt_B
  have _ : ∀ r, IsFractionRing (B_V r) (L_V r) := hFrac
  have _ : ∀ r, IsIntegralClosure (B_V r) R₀ (L_V r) := hIntCl
  have _ : ∀ r, FiniteDimensional K (L_V r) := hFD_L
  have _ : ∀ r, IsGalois K (L_V r) := hGal_L
  have _ : ∀ r, IsScalarTower F R₀ (B_V r) := fun r => by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply F (Polynomial F) (B_V r),
      IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B_V r),
      ← IsScalarTower.algebraMap_apply F (Polynomial F) R₀]
  have _ : ∀ r, IsScalarTower F (B_V r) (L_V r) := fun r => by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply F K (L_V r),
      IsScalarTower.algebraMap_apply F (Polynomial F) K,
      ← IsScalarTower.algebraMap_apply (Polynomial F) K (L_V r),
      IsScalarTower.algebraMap_apply (Polynomial F) (B_V r) (L_V r),
      ← IsScalarTower.algebraMap_apply F (Polynomial F) (B_V r)]
  have _ : ∀ r, IsScalarTower R₀ K (L_V r) := fun r => by
    refine IsScalarTower.of_algebraMap_eq' ?_
    refine IsLocalization.ringHom_ext (Submonoid.powers Δ_aff) ?_
    apply RingHom.ext
    intro p
    simp only [RingHom.comp_apply]
    rw [← IsScalarTower.algebraMap_apply (Polynomial F) R₀ K,
      ← IsScalarTower.algebraMap_apply (Polynomial F) K (L_V r),
      IsScalarTower.algebraMap_apply R₀ (B_V r) (L_V r),
      ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (B_V r),
      ← IsScalarTower.algebraMap_apply (Polynomial F) (B_V r) (L_V r)]

  
  have hConstFinite : ∀ (L : Type u) [Field L] [Algebra F L] [Algebra K L]
      [IsScalarTower F K L] [FiniteDimensional K L], Finite ↥(algebraicClosure F L) := by
    intro L _ _ _ _ _
    let k := ↥(algebraicClosure F L)
    let b := Module.Basis.ofVectorSpace F k
    let x₀ : L := algebraMap K L RatFunc.X
    have hPF_L : ∀ P : Polynomial F,
        algebraMap K L (algebraMap (Polynomial F) K P) = Polynomial.aeval x₀ P := by
      intro P
      let φ₁ : Polynomial F →ₐ[F] L :=
        (IsScalarTower.toAlgHom F K L).comp
          { (algebraMap (Polynomial F) K) with
            commutes' := fun c => (IsScalarTower.algebraMap_apply F (Polynomial F) K c).symm }
      have hφ : φ₁ = Polynomial.aeval x₀ := by
        apply Polynomial.algHom_ext
        change algebraMap K L (algebraMap (Polynomial F) K Polynomial.X) =
          Polynomial.aeval x₀ Polynomial.X
        rw [RatFunc.algebraMap_X, Polynomial.aeval_X]
      exact DFunLike.congr_fun hφ P
    have hx₀_trans : ∀ Q : Polynomial k, Polynomial.aeval x₀ Q = 0 → Q = 0 := by
      intro Q hQ
      by_contra hQ_ne
      have hx₀_int_k : IsIntegral k x₀ := isAlgebraic_iff_isIntegral.mp ⟨Q, hQ_ne, hQ⟩
      have _ : Algebra.IsIntegral F k := Algebra.IsAlgebraic.isIntegral
      have hx₀_int_F : IsIntegral F x₀ := isIntegral_trans x₀ hx₀_int_k
      have hX_int_F : IsIntegral F (RatFunc.X : K) :=
        (isIntegral_algHom_iff (IsScalarTower.toAlgHom F K L) (algebraMap K L).injective).mp
          hx₀_int_F
      obtain ⟨P, hP_ne, hP_eval⟩ := isAlgebraic_iff_isIntegral.mpr hX_int_F
      have hP_eq : Polynomial.aeval (RatFunc.X : K) P = algebraMap (Polynomial F) K P := by
        let ψ : Polynomial F →ₐ[F] K :=
          { (algebraMap (Polynomial F) K) with
            commutes' := fun c => (IsScalarTower.algebraMap_apply F (Polynomial F) K c).symm }
        have hψ : Polynomial.aeval (RatFunc.X : K) = ψ := by
          apply Polynomial.algHom_ext
          rw [Polynomial.aeval_X]
          exact RatFunc.algebraMap_X.symm
        exact DFunLike.congr_fun hψ P
      rw [hP_eq] at hP_eval
      exact hP_ne (IsFractionRing.injective (Polynomial F) K (hP_eval.trans (map_zero _).symm))
    have hLI : LinearIndependent K (fun i => (b i : L)) := by
      rw [linearIndependent_iff']
      intro s r hr i₀ hi₀
      obtain ⟨⟨d, hd_mem⟩, hd_int⟩ :=
        IsLocalization.exist_integer_multiples (nonZeroDivisors (Polynomial F)) s r
      have hd_ne : d ≠ 0 := nonZeroDivisors.ne_zero hd_mem
      have hdK_ne : algebraMap (Polynomial F) K d ≠ 0 := fun h0 =>
        hd_ne (IsFractionRing.injective (Polynomial F) K (h0.trans (map_zero _).symm))
      let p : ↑(Module.Basis.ofVectorSpaceIndex F k) → Polynomial F :=
        fun i => if hi : i ∈ s then Classical.choose (hd_int i hi) else 0
      have hp : ∀ i ∈ s, algebraMap (Polynomial F) K (p i) = algebraMap (Polynomial F) K d * r i := by
        intro i hi
        simp only [p, hi, ↓reduceDIte]
        exact (Classical.choose_spec (hd_int i hi)).trans (Algebra.smul_def d (r i))
      let Q : Polynomial k := ∑ i ∈ s, (p i).map (algebraMap F k) * Polynomial.C (b i)
      have hQ_eval : Polynomial.aeval x₀ Q = 0 := by
        dsimp [Q]
        rw [map_sum]
        have hmul : algebraMap K L (algebraMap (Polynomial F) K d) *
            (∑ i ∈ s, r i • (b i : L)) = 0 := by rw [hr, mul_zero]
        rw [Finset.mul_sum] at hmul
        refine Eq.trans ?_ hmul
        refine Finset.sum_congr rfl fun i hi => ?_
        rw [map_mul, Polynomial.aeval_C, Polynomial.aeval_map_algebraMap, ← hPF_L (p i), hp i hi]
        have hbL : (algebraMap k L) (b i) = (b i : L) := rfl
        rw [hbL, Algebra.smul_def, map_mul]
        ring
      have hQ0 : Q = 0 := hx₀_trans Q hQ_eval
      have hp0 : p i₀ = 0 := by
        ext n
        have hcoeff : Q.coeff n = 0 := by rw [hQ0, Polynomial.coeff_zero]
        dsimp [Q] at hcoeff
        rw [Polynomial.finsetSum_coeff] at hcoeff
        have hcoeff' : ∑ i ∈ s, ((p i).coeff n) • b i = 0 := by
          refine Eq.trans ?_ hcoeff
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Polynomial.coeff_mul_C, Polynomial.coeff_map, Algebra.smul_def]
        exact linearIndependent_iff'.mp b.linearIndependent s (fun i => (p i).coeff n)
          hcoeff' i₀ hi₀
      have hdp : algebraMap (Polynomial F) K d * r i₀ = 0 := by
        have h1 := (hp i₀ hi₀).symm
        rw [hp0, map_zero] at h1
        exact h1
      exact (mul_eq_zero.mp hdp).resolve_left hdK_ne
    have hcard_lt := LinearIndependent.lt_aleph0_of_finiteDimensional hLI
    have _ : Finite (Module.Basis.ofVectorSpaceIndex F k) :=
      Cardinal.lt_aleph0_iff_finite.mp hcard_lt
    have _ : Module.Finite F k := Module.Finite.of_basis b
    exact Module.finite_of_finite F
  have _ : ∀ r, Finite ↥(algebraicClosure F (L_V r)) := fun r => hConstFinite (L_V r)

  
  have hArtinFrob : ∀ (k : Type u) [Finite k] [Field k] [Algebra F k]
      (φ : k ≃ₐ[F] k), (∀ c : k, φ c = c ^ Nat.card F) →
      ∀ α : k ≃ₐ[F] k, ∃ e : ℕ, α = φ ^ e := by
    intro k _ _ _ φ hφ
    let G := (k ≃ₐ[F] k)
    have _ : Finite G := Finite.of_injective (fun g : G => (g : k → k)) DFunLike.coe_injective
    let _ : Fintype G := Fintype.ofFinite G
    let H : Subgroup G := Subgroup.zpowers φ
    let E₀ : IntermediateField F k := IntermediateField.fixedField H
    have hq : 2 ≤ Nat.card F := Finite.one_lt_card
    let P₀ : Polynomial k := Polynomial.X ^ Nat.card F - Polynomial.X
    have hP₀_ne : P₀ ≠ 0 := by
      intro h0
      have h1 := congrArg (fun p : Polynomial k => p.coeff (Nat.card F)) h0
      simp only [P₀, Polynomial.coeff_sub, Polynomial.coeff_X_pow_self, Polynomial.coeff_X,
        Polynomial.coeff_zero] at h1
      split_ifs at h1 with heq
      · omega
      · exact one_ne_zero (sub_zero (1 : k) ▸ h1)
    have hP₀_deg : P₀.natDegree ≤ Nat.card F := by
      dsimp [P₀]
      refine (Polynomial.natDegree_sub_le _ _).trans ?_
      rw [Polynomial.natDegree_X_pow, Polynomial.natDegree_X]
      omega
    let _ : Fintype ↥E₀ := Fintype.ofFinite ↥E₀
    have hSub : Finset.image (algebraMap ↥E₀ k) Finset.univ ≤ P₀.roots.toFinset := by
      intro x hx
      rw [Finset.mem_image] at hx
      rcases hx with ⟨y, _, rfl⟩
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP₀_ne, Polynomial.IsRoot.def]
      dsimp [P₀]
      rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X]
      have hy_fix : φ (y : k) = (y : k) :=
        (IntermediateField.mem_fixedField_iff H (y : k)).mp y.2 φ (Subgroup.mem_zpowers φ)
      rw [← hφ (y : k), hy_fix, sub_self]
    have hCard_E₀ : Nat.card ↥E₀ ≤ Nat.card F := by
      rw [Nat.card_eq_fintype_card, ← Finset.card_univ,
        ← Finset.card_image_of_injective Finset.univ (algebraMap ↥E₀ k).injective]
      exact (Finset.card_le_card hSub).trans ((Multiset.toFinset_card_le _).trans
        ((Polynomial.card_roots' P₀).trans hP₀_deg))
    let b_k := Module.Basis.ofVectorSpace F k
    have _ : Finite (Module.Basis.ofVectorSpaceIndex F k) := Finite.of_injective b_k b_k.injective
    have _ : FiniteDimensional F k := Module.Finite.of_basis b_k
    have hfr_pos : 0 < Module.finrank F ↥E₀ := Module.finrank_pos
    rw [Module.natCard_eq_pow_finrank (K := F) (V := ↥E₀)] at hCard_E₀
    have hfr_le : Module.finrank F ↥E₀ ≤ 1 :=
      (Nat.pow_le_pow_iff_right (by omega : 1 < Nat.card F)).mp (by simpa using hCard_E₀)
    have hfr_eq1 : Module.finrank F ↥E₀ = 1 := by omega
    have hCard_H : Nat.card ↥H = Module.finrank F k := by
      have h1 := IntermediateField.finrank_fixedField_eq_card H
      have h2 := Module.finrank_mul_finrank F ↥E₀ k
      rw [hfr_eq1, one_mul] at h2
      exact h1.symm.trans h2
    have hCard_top_le : Nat.card G ≤ Module.finrank F k := by
      have h1 := IntermediateField.finrank_fixedField_eq_card (⊤ : Subgroup G)
      have h2 := Module.finrank_mul_finrank F ↥(IntermediateField.fixedField (⊤ : Subgroup G)) k
      have hpos : 0 < Module.finrank F ↥(IntermediateField.fixedField (⊤ : Subgroup G)) :=
        Module.finrank_pos
      have hcard_top : Nat.card ↥(⊤ : Subgroup G) = Nat.card G :=
        Nat.card_congr Subgroup.topEquiv.toEquiv
      rw [hcard_top] at h1
      rw [h1] at h2
      nlinarith
    have hH_le : Nat.card ↥H ≤ Nat.card G :=
      Nat.card_le_card_of_injective (Subtype.val : ↥H → G) Subtype.val_injective
    have hH_top : H = ⊤ := Subgroup.eq_top_of_card_eq H (by omega)
    intro α
    have hα_mem : α ∈ H := by rw [hH_top]; trivial
    rcases Subgroup.mem_zpowers_iff.mp hα_mem with ⟨z, rfl⟩
    let m : ℕ := Fintype.card G
    have hm_pos : 0 < m := Fintype.card_pos
    have hφ_m : φ ^ m = 1 := pow_card_eq_one
    let e : ℕ := (z % (m : ℤ)).toNat
    have hm_z : (0 : ℤ) < (m : ℤ) := by exact_mod_cast hm_pos
    have hz_nonneg : 0 ≤ z % (m : ℤ) := Int.emod_nonneg z hm_z.ne'
    have he_cast : (e : ℤ) = z % (m : ℤ) := Int.toNat_of_nonneg hz_nonneg
    have hz_eq : z = (m : ℤ) * (z / (m : ℤ)) + (e : ℤ) := by
      rw [he_cast, add_comm]
      exact (Int.emod_add_mul_ediv z (m : ℤ)).symm
    refine ⟨e, ?_⟩
    rw [hz_eq, zpow_add, zpow_mul, zpow_natCast, zpow_natCast, hφ_m, one_zpow, one_mul]

  
  have hBlockTri : ∀ {R : Type} [CommRing R],
      let IsBlkTri : Matrix (Fin N) (Fin N) R → Prop := fun A =>
        (∀ i j : Fin N, (M₀ ≤ i.1 ∧ j.1 < M₀) → A i j = 0) ∧
        (∀ i j : Fin N, (M₀ + M ≤ i.1 ∧ j.1 < M₀ + M) → A i j = 0)
      let mid : Matrix (Fin N) (Fin N) R → Matrix (Fin M) (Fin M) R := fun A k₁ k₂ =>
        A ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩
      (IsBlkTri 1 ∧ mid 1 = 1) ∧
      (∀ A B, IsBlkTri A → IsBlkTri B → IsBlkTri (A * B) ∧ mid (A * B) = mid A * mid B) ∧
      (∀ A, IsBlkTri A → ∀ e : ℕ, IsBlkTri (A ^ e)) := by
    intro R _ IsBlkTri mid
    have hOne : IsBlkTri 1 ∧ mid 1 = 1 := by
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · intro i j ⟨hi, hj⟩
        rw [Matrix.one_apply_ne]
        intro heq; have hval := congrArg Fin.val heq; omega
      · intro i j ⟨hi, hj⟩
        rw [Matrix.one_apply_ne]
        intro heq; have hval := congrArg Fin.val heq; omega
      · ext k₁ k₂
        change (1 : Matrix (Fin N) (Fin N) R) ⟨M₀ + k₁.1, _⟩ ⟨M₀ + k₂.1, _⟩ =
          (1 : Matrix (Fin M) (Fin M) R) k₁ k₂
        by_cases hk : k₁ = k₂
        · subst hk; simp
        · rw [Matrix.one_apply_ne hk, Matrix.one_apply_ne]
          intro heq; apply hk; ext
          have hval := congrArg Fin.val heq; dsimp at hval; omega
    have hMul : ∀ A B, IsBlkTri A → IsBlkTri B → IsBlkTri (A * B) ∧ mid (A * B) = mid A * mid B := by
      intro A B hA hB
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · intro i j ⟨hi, hj⟩
        rw [Matrix.mul_apply]
        refine Finset.sum_eq_zero fun t _ => ?_
        by_cases ht : t.1 < M₀
        · rw [hA.1 i t ⟨hi, ht⟩, zero_mul]
        · rw [hB.1 t j ⟨by omega, hj⟩, mul_zero]
      · intro i j ⟨hi, hj⟩
        rw [Matrix.mul_apply]
        refine Finset.sum_eq_zero fun t _ => ?_
        by_cases ht : t.1 < M₀ + M
        · rw [hA.2 i t ⟨hi, ht⟩, zero_mul]
        · rw [hB.2 t j ⟨by omega, hj⟩, mul_zero]
      · ext k₁ k₂
        let emb : Fin M → Fin N := fun s => ⟨M₀ + s.1, by omega⟩
        have hemb_inj : Function.Injective emb := by
          intro s₁ s₂ hs; ext; have hval := congrArg Fin.val hs; dsimp [emb] at hval; omega
        change (A * B) ⟨M₀ + k₁.1, _⟩ ⟨M₀ + k₂.1, _⟩ = (mid A * mid B) k₁ k₂
        rw [Matrix.mul_apply, Matrix.mul_apply]
        change ∑ t : Fin N, A ⟨M₀ + k₁.1, _⟩ t * B t ⟨M₀ + k₂.1, _⟩ =
          ∑ s : Fin M, A ⟨M₀ + k₁.1, _⟩ (emb s) * B (emb s) ⟨M₀ + k₂.1, _⟩
        rw [← Finset.sum_image (f := fun t : Fin N =>
          A ⟨M₀ + k₁.1, by omega⟩ t * B t ⟨M₀ + k₂.1, by omega⟩) (fun s₁ _ s₂ _ h => hemb_inj h)]
        refine (Finset.sum_subset (Finset.subset_univ _) ?_).symm
        intro t _ ht_not
        by_cases ht1 : t.1 < M₀
        · rw [hA.1 ⟨M₀ + k₁.1, by omega⟩ t ⟨by simp, ht1⟩, zero_mul]
        · by_cases ht2 : t.1 < M₀ + M
          · exfalso; apply ht_not; rw [Finset.mem_image]
            refine ⟨⟨t.1 - M₀, by omega⟩, Finset.mem_univ _, ?_⟩
            ext; dsimp [emb]; omega
          · rw [hB.2 t ⟨M₀ + k₂.1, by omega⟩ ⟨by omega, by simp⟩, mul_zero]
    refine ⟨hOne, hMul, ?_⟩
    intro A hA e
    induction e with
    | zero => simpa [pow_zero] using hOne.1
    | succ e ih => rw [pow_succ]; exact (hMul (A ^ e) A ih hA).1

  
  obtain ⟨Q_u_V, hQu_V⟩ := hQ_u
  have hMidPkg : ∀ r : ℕ,
      let π_r := PadicInt.toZModPow (r + 1)
      let A_adap : (B_V r ≃ₐ[R₀] B_V r) → Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))) :=
        fun τ => ((P_chg⁻¹).val.map π_r) * (ρ_V r τ).val * (P_chg.val.map π_r)
      ∃ ρ_mid : (B_V r ≃ₐ[R₀] B_V r) →* (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ,
        (∀ (τ : B_V r ≃ₐ[R₀] B_V r) (k₁ k₂ : Fin M),
          (ρ_mid τ).val k₁ k₂ = A_adap τ ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩) ∧
        (∀ τ : B_V r ≃ₐ[R₀] B_V r,
          (∀ i j : Fin N, (M₀ ≤ i.1 ∧ j.1 < M₀) → A_adap τ i j = 0) ∧
          (∀ i j : Fin N, (M₀ + M ≤ i.1 ∧ j.1 < M₀ + M) → A_adap τ i j = 0)) ∧
        (∀ τ : B_V r ≃ₐ[R₀] B_V r, (∀ x : B_V r, IsIntegral F x → τ x = x) →
          (∀ i j : Fin N, i.1 < M₀ → j.1 < M₀ → A_adap τ i j = if i = j then 1 else 0) ∧
          (∀ i j : Fin N, M₀ + M ≤ i.1 → M₀ + M ≤ j.1 →
            A_adap τ i j = if i = j then 1 else 0)) := by
    intro r π_r A_adap
    obtain ⟨hQu_max, _, _, σ_u, hσu_frob, hσu_mat⟩ := hQu_V r
    have _ : IsScalarTower F R₀ (L_V r) := by
      refine IsScalarTower.of_algebraMap_eq fun c => ?_
      rw [IsScalarTower.algebraMap_apply F (B_V r) (L_V r),
        IsScalarTower.algebraMap_apply F R₀ (B_V r),
        ← IsScalarTower.algebraMap_apply R₀ (B_V r) (L_V r)]
    let k_V := ↥(algebraicClosure F (L_V r))
    have hj_BL_inj : Function.Injective (algebraMap (B_V r) (L_V r)) :=
      IsFractionRing.injective (B_V r) (L_V r)
    have hk_ex : ∀ c : k_V, ∃ b : B_V r, algebraMap (B_V r) (L_V r) b = c.1 := by
      intro c
      have hc_int_F : IsIntegral F c.1 :=
        isAlgebraic_iff_isIntegral.mp (mem_algebraicClosure_iff.mp c.2)
      have hc_int_R₀ : IsIntegral R₀ c.1 := IsIntegral.tower_top hc_int_F
      exact (IsIntegralClosure.isIntegral_iff (A := B_V r) (R := R₀) (B := L_V r)).mp hc_int_R₀
    let ι_k_fun : k_V → B_V r := fun c => Classical.choose (hk_ex c)
    have hι_k_spec : ∀ c : k_V, algebraMap (B_V r) (L_V r) (ι_k_fun c) = c.1 :=
      fun c => Classical.choose_spec (hk_ex c)
    let ι_k : k_V →ₐ[F] B_V r :=
      { toFun := ι_k_fun
        map_one' := hj_BL_inj (by rw [hι_k_spec, map_one]; rfl)
        map_mul' := fun a b => hj_BL_inj (by rw [hι_k_spec, map_mul, hι_k_spec, hι_k_spec]; rfl)
        map_zero' := hj_BL_inj (by rw [hι_k_spec, map_zero]; rfl)
        map_add' := fun a b => hj_BL_inj (by rw [hι_k_spec, map_add, hι_k_spec, hι_k_spec]; rfl)
        commutes' := fun c => hj_BL_inj (by
          rw [hι_k_spec, ← IsScalarTower.algebraMap_apply F (B_V r) (L_V r)]; rfl) }
    have hι_k_inj : Function.Injective ι_k := by
      intro a b hab; apply Subtype.ext
      rw [← hι_k_spec a, ← hι_k_spec b]
      exact congrArg (algebraMap (B_V r) (L_V r)) hab
    have hτ_kV : ∀ (τ : B_V r ≃ₐ[R₀] B_V r) (c : k_V),
        algebraMap (B_V r) (L_V r) (τ (ι_k c)) ∈ algebraicClosure F (L_V r) := by
      intro τ c
      rw [mem_algebraicClosure_iff]
      have hc_int : IsIntegral F (ι_k c) := by
        have hcL : IsIntegral F c.1 :=
          isAlgebraic_iff_isIntegral.mp (mem_algebraicClosure_iff.mp c.2)
        rw [← hι_k_spec c] at hcL
        exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom F (B_V r) (L_V r)) hj_BL_inj).mp hcL
      have hτ_int : IsIntegral F (τ (ι_k c)) := hc_int.map (τ.restrictScalars F).toAlgHom
      exact isAlgebraic_iff_isIntegral.mpr (hτ_int.map (IsScalarTower.toAlgHom F (B_V r) (L_V r)))
    let Φ_fun : (B_V r ≃ₐ[R₀] B_V r) → k_V → k_V :=
      fun τ c => ⟨algebraMap (B_V r) (L_V r) (τ (ι_k c)), hτ_kV τ c⟩
    have hΦ_spec : ∀ (τ : B_V r ≃ₐ[R₀] B_V r) (c : k_V), ι_k (Φ_fun τ c) = τ (ι_k c) :=
      fun τ c => hj_BL_inj (hι_k_spec (Φ_fun τ c))
    let Φ_const : (B_V r ≃ₐ[R₀] B_V r) →* (k_V ≃ₐ[F] k_V) :=
      { toFun := fun τ =>
          { toFun := Φ_fun τ
            invFun := Φ_fun τ.symm
            left_inv := fun c => hι_k_inj (by rw [hΦ_spec, hΦ_spec, τ.symm_apply_apply])
            right_inv := fun c => hι_k_inj (by rw [hΦ_spec, hΦ_spec, τ.apply_symm_apply])
            map_mul' := fun a b =>
              hι_k_inj (by rw [hΦ_spec, map_mul, map_mul, map_mul, hΦ_spec, hΦ_spec])
            map_add' := fun a b =>
              hι_k_inj (by rw [hΦ_spec, map_add, map_add, map_add, hΦ_spec, hΦ_spec])
            commutes' := fun c => hι_k_inj (by
              rw [hΦ_spec, ι_k.commutes, IsScalarTower.algebraMap_apply F R₀ (B_V r),
                τ.commutes]) }
        map_one' := AlgEquiv.ext fun c =>
          hι_k_inj (by change ι_k (Φ_fun 1 c) = ι_k c; rw [hΦ_spec]; rfl)
        map_mul' := fun τ₁ τ₂ => AlgEquiv.ext fun c => hι_k_inj (by
          change ι_k (Φ_fun (τ₁ * τ₂) c) = ι_k (Φ_fun τ₁ (Φ_fun τ₂ c))
          rw [hΦ_spec, AlgEquiv.mul_apply, ← hΦ_spec, ← hΦ_spec]) }
    let φ : k_V ≃ₐ[F] k_V := Φ_const (σ_u⁻¹)
    have hφ_pow : ∀ c : k_V, φ c = c ^ Nat.card F := by
      intro c
      let _ : Field (B_V r ⧸ Q_u_V r) := @Ideal.Quotient.field (B_V r) _ (Q_u_V r) hQu_max
      let q_k : k_V →+* (B_V r ⧸ Q_u_V r) := (Ideal.Quotient.mk (Q_u_V r)).comp ι_k.toRingHom
      apply q_k.injective
      rw [← sub_eq_zero, ← map_sub]
      change Ideal.Quotient.mk (Q_u_V r) (ι_k (φ c - c ^ Nat.card F)) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, map_sub, map_pow]
      have h1 : ι_k (φ c) = σ_u.symm (ι_k c) := hΦ_spec (σ_u⁻¹) c
      rw [h1]
      exact hσu_frob (ι_k c)
    have hArtin := hArtinFrob k_V φ hφ_pow
    obtain ⟨hBlkOne, hBlkMul, hBlkPow⟩ := hBlockTri (R := ZMod (ℓ ^ (r + 1)))
    let IsBlkTri : Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))) → Prop := fun A =>
      (∀ i j : Fin N, (M₀ ≤ i.1 ∧ j.1 < M₀) → A i j = 0) ∧
      (∀ i j : Fin N, (M₀ + M ≤ i.1 ∧ j.1 < M₀ + M) → A i j = 0)
    let mid : Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))) →
        Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))) :=
      fun A k₁ k₂ => A ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩
    have hP_inv_mul : ((P_chg⁻¹).val.map π_r) * (P_chg.val.map π_r) = 1 := by
      rw [← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply, ← map_mul, Units.inv_mul, map_one]
    have hP_mul_inv : (P_chg.val.map π_r) * ((P_chg⁻¹).val.map π_r) = 1 := by
      rw [← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply, ← map_mul, Units.mul_inv, map_one]
    have hAdap_one : A_adap 1 = 1 := by
      dsimp [A_adap]; rw [map_one, Units.val_one, Matrix.mul_one, hP_inv_mul]
    have hAdap_mul : ∀ τ₁ τ₂ : B_V r ≃ₐ[R₀] B_V r, A_adap (τ₁ * τ₂) = A_adap τ₁ * A_adap τ₂ := by
      intro τ₁ τ₂; dsimp [A_adap]; rw [map_mul, Units.val_mul]
      calc ((P_chg⁻¹).val.map π_r) * ((ρ_V r τ₁).val * (ρ_V r τ₂).val) * (P_chg.val.map π_r)
          = (((P_chg⁻¹).val.map π_r) * (ρ_V r τ₁).val) * 1 *
              ((ρ_V r τ₂).val * (P_chg.val.map π_r)) := by
              simp only [Matrix.mul_one, Matrix.mul_assoc]
        _ = (((P_chg⁻¹).val.map π_r) * (ρ_V r τ₁).val) *
              ((P_chg.val.map π_r) * ((P_chg⁻¹).val.map π_r)) *
              ((ρ_V r τ₂).val * (P_chg.val.map π_r)) := by rw [hP_mul_inv]
        _ = (((P_chg⁻¹).val.map π_r) * (ρ_V r τ₁).val * (P_chg.val.map π_r)) *
              (((P_chg⁻¹).val.map π_r) * (ρ_V r τ₂).val * (P_chg.val.map π_r)) := by
              simp only [Matrix.mul_assoc]
    have hσu_inv_mat : (ρ_V r (σ_u⁻¹)).val = ((F_V_u⁻¹).val).map π_r := by
      have hmul1 : (ρ_V r σ_u).val * (((F_V_u⁻¹).val).map π_r) = 1 := by
        rw [hσu_mat, ← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply, ← map_mul,
          Units.mul_inv, map_one]
      calc (ρ_V r (σ_u⁻¹)).val
          = (ρ_V r (σ_u⁻¹)).val * 1 := (Matrix.mul_one _).symm
        _ = (ρ_V r (σ_u⁻¹)).val * ((ρ_V r σ_u).val * (((F_V_u⁻¹).val).map π_r)) := by rw [hmul1]
        _ = ((ρ_V r (σ_u⁻¹)).val * (ρ_V r σ_u).val) * (((F_V_u⁻¹).val).map π_r) := by
              rw [Matrix.mul_assoc]
        _ = ((ρ_V r (σ_u⁻¹ * σ_u)).val) * (((F_V_u⁻¹).val).map π_r) := by
              rw [map_mul, Units.val_mul]
        _ = ((F_V_u⁻¹).val).map π_r := by
              rw [inv_mul_cancel, map_one, Units.val_one, Matrix.one_mul]
    have hFu_inv_tri := hFu_tri (F_V_u⁻¹).val (Or.inr rfl)
    have hAdap_σu_inv_tri : IsBlkTri (A_adap (σ_u⁻¹)) := by
      have heq : A_adap (σ_u⁻¹) = ((P_chg⁻¹).val * (F_V_u⁻¹).val * P_chg.val).map π_r := by
        dsimp [A_adap]
        rw [hσu_inv_mat, ← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply,
          ← RingHom.mapMatrix_apply, ← map_mul, ← map_mul]; rfl
      rw [heq]
      exact ⟨fun i j hij => by simp only [Matrix.map_apply, hFu_inv_tri.1 i j hij, map_zero],
        fun i j hij => by simp only [Matrix.map_apply, hFu_inv_tri.2 i j hij, map_zero]⟩
    have hAdap_pow : ∀ (τ : B_V r ≃ₐ[R₀] B_V r) (e : ℕ), A_adap (τ ^ e) = (A_adap τ) ^ e := by
      intro τ e
      induction e with
      | zero => rw [pow_zero τ, pow_zero (A_adap τ), hAdap_one]
      | succ e ih => rw [pow_succ τ e, pow_succ (A_adap τ) e, hAdap_mul, ih]
    have hAdap_tri : ∀ τ : B_V r ≃ₐ[R₀] B_V r, IsBlkTri (A_adap τ) := by
      intro τ
      obtain ⟨e, he⟩ := hArtin (Φ_const τ)
      let τ₀ : B_V r ≃ₐ[R₀] B_V r := τ * σ_u ^ e
      have hτ₀_int : ∀ x : B_V r, IsIntegral F x → τ₀ x = x := by
        intro x hx
        have hx_L : IsIntegral F (algebraMap (B_V r) (L_V r) x) :=
          hx.map (IsScalarTower.toAlgHom F (B_V r) (L_V r))
        have hx_alg : algebraMap (B_V r) (L_V r) x ∈ algebraicClosure F (L_V r) :=
          mem_algebraicClosure_iff.mpr (isAlgebraic_iff_isIntegral.mpr hx_L)
        let c : k_V := ⟨algebraMap (B_V r) (L_V r) x, hx_alg⟩
        have hxc : x = ι_k c := hj_BL_inj (hι_k_spec c).symm
        have hΦ_τ₀ : Φ_const τ₀ = 1 := by
          dsimp [τ₀]; rw [map_mul, he]
          change φ ^ e * Φ_const (σ_u ^ e) = 1
          dsimp [φ]
          rw [← map_pow, ← map_mul, inv_pow, inv_mul_cancel, map_one]
        rw [hxc, ← hΦ_spec τ₀ c]
        have h1 : Φ_fun τ₀ c = c := AlgEquiv.congr_fun hΦ_τ₀ c
        rw [h1]
      obtain ⟨g₀, hg₀_mem, hg₀_mat⟩ := hG_mem r τ₀ hτ₀_int
      have hAdap_τ₀_eq : A_adap τ₀ = ((P_chg⁻¹).val * g₀.val * P_chg.val).map π_r := by
        dsimp [A_adap]
        rw [hg₀_mat, ← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply,
          ← RingHom.mapMatrix_apply, ← map_mul, ← map_mul]; rfl
      have hAdap_τ₀_tri : IsBlkTri (A_adap τ₀) := by
        rw [hAdap_τ₀_eq]
        exact ⟨fun i j hij =>
            by simp only [Matrix.map_apply, (hGV_blk.1 g₀ hg₀_mem).1 i j hij, map_zero],
          fun i j hij =>
            by simp only [Matrix.map_apply, (hGV_blk.1 g₀ hg₀_mem).2.1 i j hij, map_zero]⟩
      have hτ_decomp : τ = τ₀ * (σ_u⁻¹) ^ e := by
        dsimp [τ₀]; rw [inv_pow, mul_assoc, mul_inv_cancel, mul_one]
      rw [hτ_decomp, hAdap_mul, hAdap_pow]
      exact (hBlkMul _ _ hAdap_τ₀_tri (hBlkPow _ hAdap_σu_inv_tri e)).1
    have hMid_one : mid (A_adap 1) = 1 := by rw [hAdap_one]; exact hBlkOne.2
    have hMid_mul : ∀ τ₁ τ₂ : B_V r ≃ₐ[R₀] B_V r,
        mid (A_adap (τ₁ * τ₂)) = mid (A_adap τ₁) * mid (A_adap τ₂) := by
      intro τ₁ τ₂; rw [hAdap_mul]; exact (hBlkMul _ _ (hAdap_tri τ₁) (hAdap_tri τ₂)).2
    let ρ_mid : (B_V r ≃ₐ[R₀] B_V r) →* (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ :=
      { toFun := fun τ =>
          { val := mid (A_adap τ)
            inv := mid (A_adap (τ⁻¹))
            val_inv := by rw [← hMid_mul, mul_inv_cancel, hMid_one]
            inv_val := by rw [← hMid_mul, inv_mul_cancel, hMid_one] }
        map_one' := Units.ext hMid_one
        map_mul' := fun τ₁ τ₂ => Units.ext (hMid_mul τ₁ τ₂) }
    refine ⟨ρ_mid, fun _ _ _ => rfl, hAdap_tri, ?_⟩
    intro τ hτ_int
    obtain ⟨g, hg_mem, hg_mat⟩ := hG_mem r τ hτ_int
    have hAdap_eq : A_adap τ = ((P_chg⁻¹).val * g.val * P_chg.val).map π_r := by
      dsimp [A_adap]
      rw [hg_mat, ← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply,
        ← RingHom.mapMatrix_apply, ← map_mul, ← map_mul]; rfl
    rw [hAdap_eq]
    refine ⟨fun i j hi hj => ?_, fun i j hi hj => ?_⟩
    · simp only [Matrix.map_apply, (hGV_blk.1 g hg_mem).2.2.1 i j hi hj]
      split_ifs <;> simp
    · simp only [Matrix.map_apply, (hGV_blk.1 g hg_mem).2.2.2.1 i j hi hj]
      split_ifs <;> simp

  let ρ_mid : ∀ r : ℕ, (B_V r ≃ₐ[R₀] B_V r) →*
      (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ :=
    fun r => Classical.choose (hMidPkg r)
  have hρ_mid_spec := fun r => Classical.choose_spec (hMidPkg r)

  
  let res_V : ∀ r : ℕ, (L_V r ≃ₐ[K] L_V r) ≃* (B_V r ≃ₐ[R₀] B_V r) :=
    fun r => galRestrict R₀ K (L_V r) (B_V r)
  let ρ_L : ∀ r : ℕ, (L_V r ≃ₐ[K] L_V r) →*
      (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ :=
    fun r => (ρ_mid r).comp (res_V r).toMonoidHom
  let K_L : ∀ r : ℕ, Subgroup (L_V r ≃ₐ[K] L_V r) := fun r => (ρ_L r).ker
  have _ : ∀ r, (K_L r).Normal := fun r => (ρ_L r).normal_ker
  let E_int : ∀ r : ℕ, IntermediateField K (L_V r) :=
    fun r => IntermediateField.fixedField (K_L r)
  let L_fld : ℕ → Type u := fun r => ↥(E_int r)
  let _ : ∀ r, Field (L_fld r) := fun r => inferInstance
  let _ : ∀ r, Algebra K (L_fld r) := fun r => inferInstance
  let _ : ∀ r, Algebra F (L_fld r) := fun r => inferInstance
  let _ : ∀ r, Algebra (Polynomial F) (L_fld r) := fun r => inferInstance
  have _ : ∀ r, IsScalarTower F K (L_fld r) := fun r => inferInstance
  have _ : ∀ r, IsScalarTower (Polynomial F) K (L_fld r) := fun r => inferInstance
  let _ : ∀ r, Algebra R₀ (L_fld r) :=
    fun r => ((algebraMap K (L_fld r)).comp (algebraMap R₀ K)).toAlgebra
  have _ : ∀ r, IsScalarTower R₀ K (L_fld r) :=
    fun _ => IsScalarTower.of_algebraMap_eq fun _ => rfl
  have _ : ∀ r, IsScalarTower (Polynomial F) R₀ (L_fld r) := fun r => by
    refine IsScalarTower.of_algebraMap_eq fun p => ?_
    rw [IsScalarTower.algebraMap_apply (Polynomial F) K (L_fld r),
      IsScalarTower.algebraMap_apply (Polynomial F) R₀ K]
    rfl
  have _ : ∀ r, IsScalarTower F (Polynomial F) (L_fld r) := fun r => by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply F K (L_fld r),
      IsScalarTower.algebraMap_apply F (Polynomial F) K,
      ← IsScalarTower.algebraMap_apply (Polynomial F) K (L_fld r)]
  have _ : ∀ r, IsScalarTower F R₀ (L_fld r) := fun r => by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply F (Polynomial F) (L_fld r),
      IsScalarTower.algebraMap_apply F (Polynomial F) R₀,
      ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (L_fld r)]
  have hGal_Lr : ∀ r, IsGalois K (L_fld r) :=
    fun r => IsGalois.of_fixedField_normal_subgroup (K_L r)
  have hFD_Lr : ∀ r, FiniteDimensional K (L_fld r) := fun _ => inferInstance

  let B : ℕ → Type u := fun r => ↥(integralClosure R₀ (L_fld r))
  let _ : ∀ r, CommRing (B r) := fun _ => inferInstance
  have _ : ∀ r, IsDomain (B r) := fun _ => inferInstance
  let _ : ∀ r, Algebra R₀ (B r) := fun _ => inferInstance
  let _ : ∀ r, Algebra (Polynomial F) (B r) := fun _ => inferInstance
  let _ : ∀ r, Algebra F (B r) := fun _ => inferInstance
  let _ : ∀ r, Algebra (B r) (L_fld r) := fun _ => inferInstance
  have _ : ∀ r, IsScalarTower R₀ (B r) (L_fld r) := fun _ => inferInstance
  have _ : ∀ r, IsScalarTower (Polynomial F) R₀ (B r) := fun _ => inferInstance
  have _ : ∀ r, IsScalarTower F (Polynomial F) (B r) := fun _ => inferInstance
  have _ : ∀ r, IsScalarTower (Polynomial F) (B r) (L_fld r) := fun _ => inferInstance
  have _ : ∀ r, IsScalarTower F (B r) (L_fld r) := fun r => by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply F (Polynomial F) (L_fld r),
      IsScalarTower.algebraMap_apply (Polynomial F) (B r) (L_fld r),
      ← IsScalarTower.algebraMap_apply F (Polynomial F) (B r)]
  have hIntCl_Br : ∀ r, IsIntegralClosure (B r) R₀ (L_fld r) := fun _ => inferInstance
  have hFrac_Br : ∀ r, IsFractionRing (B r) (L_fld r) :=
    fun r => IsIntegralClosure.isFractionRing_of_finite_extension R₀ K (L_fld r) (B r)
  have hFin_Br : ∀ r, Module.Finite R₀ (B r) :=
    fun r => IsIntegralClosure.finite R₀ K (L_fld r) (B r)
  have _ : ∀ r, Finite ↥(algebraicClosure F (L_fld r)) := fun r => hConstFinite (L_fld r)

  
  let ι_L : ∀ r : ℕ, L_fld r →ₐ[K] L_V r := fun r => (E_int r).val
  have hι_L_inj : ∀ r, Function.Injective (ι_L r) := fun r => (E_int r).val.injective
  have hι_L_PF : ∀ (r : ℕ) (p : Polynomial F),
      ι_L r (algebraMap (Polynomial F) (L_fld r) p) = algebraMap (Polynomial F) (L_V r) p := by
    intro r p
    rw [IsScalarTower.algebraMap_apply (Polynomial F) K (L_fld r), (ι_L r).commutes,
      ← IsScalarTower.algebraMap_apply (Polynomial F) K (L_V r)]
  have hι_L_F : ∀ (r : ℕ) (c : F),
      ι_L r (algebraMap F (L_fld r) c) = algebraMap F (L_V r) c := by
    intro r c
    rw [IsScalarTower.algebraMap_apply F K (L_fld r), (ι_L r).commutes,
      ← IsScalarTower.algebraMap_apply F K (L_V r)]
  have hι_L_R₀ : ∀ (r : ℕ) (z : R₀),
      ι_L r (algebraMap R₀ (L_fld r) z) = algebraMap R₀ (L_V r) z := by
    intro r z
    rw [IsScalarTower.algebraMap_apply R₀ K (L_fld r), (ι_L r).commutes,
      ← IsScalarTower.algebraMap_apply R₀ K (L_V r)]
  let ι_LR₀ : ∀ r : ℕ, L_fld r →ₐ[R₀] L_V r :=
    fun r => { (ι_L r).toRingHom with commutes' := hι_L_R₀ r }
  have hj_ex : ∀ (r : ℕ) (b : B r),
      ∃ y : B_V r, algebraMap (B_V r) (L_V r) y = ι_L r (algebraMap (B r) (L_fld r) b) := by
    intro r b
    have hb_int : IsIntegral R₀ (algebraMap (B r) (L_fld r) b) := b.2
    have hL_int : IsIntegral R₀ (ι_L r (algebraMap (B r) (L_fld r) b)) :=
      (isIntegral_algHom_iff (ι_LR₀ r) (hι_L_inj r)).mpr hb_int
    exact (IsIntegralClosure.isIntegral_iff (A := B_V r) (R := R₀) (B := L_V r)).mp hL_int
  let j_B : ∀ r : ℕ, B r →ₐ[R₀] B_V r := fun r =>
    let j_fun : B r → B_V r := fun b => Classical.choose (hj_ex r b)
    have hj_spec : ∀ b : B r,
        algebraMap (B_V r) (L_V r) (j_fun b) = ι_L r (algebraMap (B r) (L_fld r) b) :=
      fun b => Classical.choose_spec (hj_ex r b)
    have hj_LV_inj : Function.Injective (algebraMap (B_V r) (L_V r)) :=
      IsFractionRing.injective (B_V r) (L_V r)
    { toFun := j_fun
      map_one' := hj_LV_inj (by rw [hj_spec, map_one, map_one, map_one])
      map_mul' := fun x y =>
        hj_LV_inj (by rw [hj_spec, map_mul, map_mul, map_mul, hj_spec, hj_spec])
      map_zero' := hj_LV_inj (by rw [hj_spec, map_zero, map_zero, map_zero])
      map_add' := fun x y =>
        hj_LV_inj (by rw [hj_spec, map_add, map_add, map_add, hj_spec, hj_spec])
      commutes' := fun z => hj_LV_inj (by
        rw [hj_spec, ← IsScalarTower.algebraMap_apply R₀ (B r) (L_fld r), hι_L_R₀,
          IsScalarTower.algebraMap_apply R₀ (B_V r) (L_V r)]) }
  have hj_B_spec : ∀ (r : ℕ) (b : B r),
      algebraMap (B_V r) (L_V r) (j_B r b) = ι_L r (algebraMap (B r) (L_fld r) b) :=
    fun r b => Classical.choose_spec (hj_ex r b)
  have hj_B_inj : ∀ r : ℕ, Function.Injective (j_B r) := by
    intro r a b hab
    apply IsFractionRing.injective (B r) (L_fld r)
    apply hι_L_inj r
    rw [← hj_B_spec r a, ← hj_B_spec r b, hab]

  
  have hEtaleOfProj : ∀ (S : Type u) [CommRing S] [Algebra R₀ S]
      [Algebra.FinitePresentation R₀ S] [Module.Projective R₀ S] [Algebra.FormallyUnramified R₀ S],
      Algebra.Etale R₀ S := by
    intro S _ _ _ _ _
    have hFE : Algebra.FormallyEtale R₀ S := by
      rw [Algebra.FormallyEtale.iff_comp_bijective]
      intro A _ _ I hI2
      refine ⟨(Algebra.FormallyUnramified.iff_comp_injective).mp inferInstance I hI2, ?_⟩
      intro f_bar
      obtain ⟨t, ht_ann, ht_mul⟩ :=
        (Algebra.FormallyUnramified.iff_exists_tensorProduct (R := R₀) (S := S)).mp inferInstance
      let q : A →ₐ[R₀] A ⧸ I := Ideal.Quotient.mkₐ R₀ I
      obtain ⟨ℓ_lin, hℓ_lift⟩ := Module.projective_lifting_property
        q.toLinearMap f_bar.toLinearMap Ideal.Quotient.mk_surjective
      have hq_ℓ : ∀ s : S, q (ℓ_lin s) = f_bar s := fun s => LinearMap.congr_fun hℓ_lift s
      have h_mem_I : ∀ a : A, q a = 0 ↔ a ∈ I := fun _ => Ideal.Quotient.eq_zero_iff_mem
      have hI_mul_zero : ∀ a b : A, a ∈ I → b ∈ I → a * b = 0 := by
        intro a b ha hb
        have hmem : a * b ∈ I ^ 2 := by rw [sq]; exact Ideal.mul_mem_mul ha hb
        rwa [hI2, Submodule.mem_bot] at hmem
      let δ : S → S → A := fun x y => ℓ_lin (x * y) - ℓ_lin x * ℓ_lin y
      have hδ_mem : ∀ x y : S, δ x y ∈ I := by
        intro x y
        rw [← h_mem_I]; dsimp [δ]
        rw [map_sub, hq_ℓ, map_mul, map_mul, hq_ℓ, hq_ℓ, sub_self]
      have hℓ1_sub : ℓ_lin 1 - 1 ∈ I := by
        rw [← h_mem_I, map_sub, hq_ℓ, map_one, map_one, sub_self]
      have hℓ_mul_I : ∀ (u v : S) (n : A), n ∈ I → ℓ_lin (u * v) * n = ℓ_lin u * (ℓ_lin v * n) := by
        intro u v n hn
        have h0 : δ u v * n = 0 := hI_mul_zero _ _ (hδ_mem u v) hn
        dsimp [δ] at h0; linear_combination h0
      have hℓ1_I : ∀ n : A, n ∈ I → ℓ_lin 1 * n = n := by
        intro n hn
        have h0 : (ℓ_lin 1 - 1) * n = 0 := hI_mul_zero _ _ hℓ1_sub hn
        linear_combination h0
      have hℓ_alg : ∀ (c : R₀) (x : S),
          ℓ_lin (algebraMap R₀ S c * x) = algebraMap R₀ A c * ℓ_lin x := by
        intro c x; rw [← Algebra.smul_def, map_smul, Algebra.smul_def]
      let T_map : S → (TensorProduct R₀ S S →ₗ[R₀] A) := fun y =>
        TensorProduct.lift (LinearMap.mk₂ R₀ (fun u v => ℓ_lin u * δ v y)
          (fun u₁ u₂ v => by simp only [map_add, add_mul])
          (fun c u v => by simp only [Algebra.smul_def, hℓ_alg]; ring)
          (fun u v₁ v₂ => by simp only [δ, add_mul, map_add]; ring)
          (fun c u v => by simp only [δ, Algebra.smul_def, mul_assoc, hℓ_alg]; ring))
      let d : S → A := fun y => T_map y t
      have hd_mem : ∀ y : S, d y ∈ I := by
        intro y
        have hqT : q.toLinearMap.comp (T_map y) = 0 := by
          refine TensorProduct.ext' fun u v => ?_
          simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, T_map, TensorProduct.lift.tmul,
            LinearMap.mk₂_apply, LinearMap.zero_apply, map_mul, (h_mem_I _).mpr (hδ_mem v y),
            mul_zero]
        exact (h_mem_I (d y)).mp (LinearMap.congr_fun hqT t)
      have h_shift : ∀ x y : S, T_map y ((1 ⊗ₜ[R₀] x) * t) = ℓ_lin x * d y := by
        intro x y
        have heq_t : (1 ⊗ₜ[R₀] x) * t = (x ⊗ₜ[R₀] 1) * t :=
          sub_eq_zero.mp (by simpa [sub_mul] using ht_ann x)
        rw [heq_t]
        have hlin : (T_map y).comp (LinearMap.mulLeft R₀ (x ⊗ₜ[R₀] (1 : S))) =
            (LinearMap.mulLeft R₀ (ℓ_lin x)).comp (T_map y) := by
          refine TensorProduct.ext' fun u v => ?_
          simp only [LinearMap.comp_apply, LinearMap.mulLeft_apply, T_map,
            Algebra.TensorProduct.tmul_mul_tmul, TensorProduct.lift.tmul, LinearMap.mk₂_apply,
            one_mul]
          exact hℓ_mul_I x u (δ v y) (hδ_mem v y)
        exact LinearMap.congr_fun hlin t
      have h_cocycle_rel : ∀ x y : S, δ x y - ℓ_lin x * d y + d (x * y) - ℓ_lin y * d x = 0 := by
        intro x y
        let C_lin : TensorProduct R₀ S S →ₗ[R₀] A :=
          TensorProduct.lift (LinearMap.mk₂ R₀
            (fun u v => ℓ_lin (u * v) * δ x y - ℓ_lin u * δ (v * x) y +
              ℓ_lin u * δ v (x * y) - ℓ_lin y * (ℓ_lin u * δ v x))
            (fun u₁ u₂ v => by simp only [add_mul, map_add]; ring)
            (fun c u v => by simp only [Algebra.smul_def, mul_assoc, hℓ_alg]; ring)
            (fun u v₁ v₂ => by simp only [δ, mul_add, add_mul, map_add]; ring)
            (fun c u v => by
              have hmul_c : ∀ a : S, u * (algebraMap R₀ S c * a) = algebraMap R₀ S c * (u * a) :=
                fun _ => by ring
              simp only [δ, Algebra.smul_def, mul_assoc, hmul_c, hℓ_alg]; ring))
        have hC_zero : C_lin = 0 := by
          refine TensorProduct.ext' fun u v => ?_
          simp only [C_lin, TensorProduct.lift.tmul, LinearMap.mk₂_apply, LinearMap.zero_apply]
          rw [hℓ_mul_I u v (δ x y) (hδ_mem x y)]
          dsimp [δ]; rw [mul_assoc v x y]; ring
        let R_lin : TensorProduct R₀ S S →ₗ[R₀] A :=
          ((LinearMap.mulRight R₀ (δ x y)).comp
              (ℓ_lin.comp (Algebra.TensorProduct.lmul' R₀).toLinearMap)) -
            (T_map y).comp (LinearMap.mulLeft R₀ ((1 : S) ⊗ₜ[R₀] x)) +
            T_map (x * y) -
            (LinearMap.mulLeft R₀ (ℓ_lin y)).comp (T_map x)
        have hC_eq : C_lin = R_lin := by
          refine TensorProduct.ext' fun u v => ?_
          simp only [C_lin, R_lin, T_map, LinearMap.add_apply, LinearMap.sub_apply,
            LinearMap.comp_apply, LinearMap.mulRight_apply, LinearMap.mulLeft_apply,
            AlgHom.toLinearMap_apply, Algebra.TensorProduct.tmul_mul_tmul,
            Algebra.TensorProduct.lmul'_apply_tmul, TensorProduct.lift.tmul, LinearMap.mk₂_apply,
            one_mul, mul_comm x v]
        have h0 : R_lin t = 0 := by rw [← hC_eq, hC_zero, LinearMap.zero_apply]
        simp only [R_lin, LinearMap.add_apply, LinearMap.sub_apply, LinearMap.comp_apply,
          LinearMap.mulRight_apply, LinearMap.mulLeft_apply, AlgHom.toLinearMap_apply] at h0
        rw [ht_mul, hℓ1_I (δ x y) (hδ_mem x y), h_shift x y] at h0
        exact h0
      let φ_fun : S → A := fun x => ℓ_lin x + d x
      have hφ_add : ∀ x y : S, φ_fun (x + y) = φ_fun x + φ_fun y := by
        intro x y
        have hd_add : T_map (x + y) = T_map x + T_map y := by
          refine TensorProduct.ext' fun u v => ?_
          simp only [T_map, LinearMap.add_apply, TensorProduct.lift.tmul, LinearMap.mk₂_apply, δ,
            mul_add, map_add]; ring
        dsimp [φ_fun, d]; rw [map_add, LinearMap.congr_fun hd_add t, LinearMap.add_apply]; ring
      have hφ_smul : ∀ (r₀ : R₀) (x : S), φ_fun (r₀ • x) = r₀ • φ_fun x := by
        intro r₀ x
        have hd_smul : T_map (r₀ • x) = r₀ • T_map x := by
          refine TensorProduct.ext' fun u v => ?_
          have hvr : v * (algebraMap R₀ S r₀ * x) = algebraMap R₀ S r₀ * (v * x) := by ring
          simp only [T_map, LinearMap.smul_apply, TensorProduct.lift.tmul, LinearMap.mk₂_apply, δ,
            Algebra.smul_def, hvr, hℓ_alg]; ring
        dsimp [φ_fun, d]; rw [map_smul, LinearMap.congr_fun hd_smul t, LinearMap.smul_apply, smul_add]
      have hφ_mul : ∀ x y : S, φ_fun (x * y) = φ_fun x * φ_fun y := by
        intro x y
        have hdd : d x * d y = 0 := hI_mul_zero _ _ (hd_mem x) (hd_mem y)
        have hc := h_cocycle_rel x y
        dsimp [φ_fun, δ] at hc ⊢
        linear_combination hc - hdd
      have hφ_one : φ_fun 1 = 1 := by
        have h_idem : φ_fun 1 = φ_fun 1 * φ_fun 1 := by simpa [one_mul] using hφ_mul 1 1
        have h_mem1 : φ_fun 1 - 1 ∈ I := by
          dsimp [φ_fun]
          have h1 : ℓ_lin 1 + d 1 - 1 = (ℓ_lin 1 - 1) + d 1 := by ring
          rw [h1]; exact I.add_mem hℓ1_sub (hd_mem 1)
        have h_sq0 : (φ_fun 1 - 1) * (φ_fun 1 - 1) = 0 := hI_mul_zero _ _ h_mem1 h_mem1
        linear_combination -h_idem - h_sq0
      let φ : S →ₐ[R₀] A :=
        { toFun := φ_fun
          map_one' := hφ_one
          map_mul' := hφ_mul
          map_zero' := by simpa using hφ_smul 0 0
          map_add' := hφ_add
          commutes' := fun r₀ => by
            rw [Algebra.algebraMap_eq_smul_one, hφ_smul, hφ_one, Algebra.smul_def, mul_one] }
      refine ⟨φ, ?_⟩
      ext x
      change q (ℓ_lin x + d x) = f_bar x
      rw [map_add, hq_ℓ x, (h_mem_I (d x)).mpr (hd_mem x), add_zero]
    exact @Algebra.Etale.mk R₀ S _ _ _ hFE inferInstance

  have hEt_Br : ∀ r, Algebra.Etale R₀ (B r) := by
    intro r
    have hFT_S : Algebra.FiniteType R₀ (B r) := inferInstance
    have _ : Algebra.FinitePresentation R₀ (B r) := Algebra.FinitePresentation.of_finiteType.mp hFT_S
    have hInj_RS : Function.Injective (algebraMap R₀ (B r)) := by
      intro a b hab
      apply IsFractionRing.injective R₀ K
      apply (algebraMap K (L_fld r)).injective
      rw [← IsScalarTower.algebraMap_apply R₀ K (L_fld r),
        ← IsScalarTower.algebraMap_apply R₀ K (L_fld r),
        IsScalarTower.algebraMap_apply R₀ (B r) (L_fld r),
        IsScalarTower.algebraMap_apply R₀ (B r) (L_fld r), hab]
    have _ : Module.IsTorsionFree R₀ (B r) :=
      (Module.isTorsionFree_iff_algebraMap_injective).mpr hInj_RS
    have _ : Module.Flat R₀ (B r) := inferInstance
    have _ : Module.FinitePresentation R₀ (B r) := Module.finitePresentation_of_finite R₀ (B r)
    have _ : Module.Projective R₀ (B r) := Module.Flat.projective_of_finitePresentation
    have _ : IsDedekindDomain (B r) :=
      IsIntegralClosure.isDedekindDomain R₀ K (L_fld r) (B r)
    let _ : Algebra (B r) (B_V r) := (j_B r).toRingHom.toAlgebra
    have _ : IsScalarTower R₀ (B r) (B_V r) :=
      IsScalarTower.of_algebraMap_eq fun z => ((j_B r).commutes z).symm
    have _ : Module.IsTorsionFree (B r) (B_V r) :=
      (Module.isTorsionFree_iff_algebraMap_injective).mpr (hj_B_inj r)
    have _ : Algebra.IsIntegral R₀ (B_V r) := Algebra.IsIntegral.of_finite R₀ (B_V r)
    have _ : Algebra.IsIntegral (B r) (B_V r) := Algebra.IsIntegral.tower_top R₀
    have _ : Algebra.FormallyUnramified R₀ (B r) := by
      rw [← Algebra.unramifiedLocus_eq_univ_iff, Set.eq_univ_iff_forall]
      intro x
      have hbot : Ideal.under (B r) (⊥ : Ideal (B_V r)) ≤ x.asIdeal := by
        rw [Ideal.under, Ideal.comap_bot_of_injective (algebraMap (B r) (B_V r)) (hj_B_inj r)]
        exact bot_le
      obtain ⟨P, _, hP_prime, hP_over⟩ :=
        Ideal.exists_ideal_over_prime_of_isIntegral x.asIdeal (⊥ : Ideal (B_V r)) hbot
      have _ : P.IsPrime := hP_prime
      have _ : P.LiesOver x.asIdeal := ⟨hP_over.symm⟩
      have hUnram_T : Algebra.unramifiedLocus R₀ (B_V r) = Set.univ :=
        Algebra.unramifiedLocus_eq_univ_iff.mpr inferInstance
      have _ : Algebra.IsUnramifiedAt R₀ P := by
        have hm : (⟨P, hP_prime⟩ : PrimeSpectrum (B_V r)) ∈ Algebra.unramifiedLocus R₀ (B_V r) := by
          rw [hUnram_T]; trivial
        exact hm
      exact Algebra.IsUnramifiedAt.of_liesOver R₀ x.asIdeal P
    exact hEtaleOfProj (B r)

  
  let res_B : ∀ r : ℕ, (L_fld r ≃ₐ[K] L_fld r) ≃* (B r ≃ₐ[R₀] B r) :=
    fun r => galRestrict R₀ K (L_fld r) (B r)
  have hQuotPkg : ∀ r : ℕ,
      ∃ ρ_r : (B r ≃ₐ[R₀] B r) →* (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ,
        Function.Injective ρ_r ∧
        (∀ y : B_V r, y ∈ Set.range (j_B r) ↔ ∀ τ : B_V r ≃ₐ[R₀] B_V r, ρ_mid r τ = 1 → τ y = y) ∧
        (∀ τ : B_V r ≃ₐ[R₀] B_V r, ∃ σ : B r ≃ₐ[R₀] B r,
          (∀ b : B r, τ (j_B r b) = j_B r (σ b)) ∧ ρ_r σ = ρ_mid r τ) ∧
        (∀ τ_B : B r ≃ₐ[R₀] B r, ∃ τ_V : B_V r ≃ₐ[R₀] B_V r,
          (∀ b : B r, τ_V (j_B r b) = j_B r (τ_B b)) ∧ ρ_r τ_B = ρ_mid r τ_V) := by
    intro r
    let _ : Algebra (L_fld r) (L_V r) := (ι_L r).toRingHom.toAlgebra
    have _ : IsScalarTower K (L_fld r) (L_V r) :=
      IsScalarTower.of_algebraMap_eq fun k => ((ι_L r).commutes k).symm
    let π_gal : (L_V r ≃ₐ[K] L_V r) →* (L_fld r ≃ₐ[K] L_fld r) :=
      AlgEquiv.restrictNormalHom (L_fld r)
    have hπ_surj : Function.Surjective π_gal := AlgEquiv.restrictNormalHom_surjective (L_V r)
    have hπ_ker : π_gal.ker = K_L r := by
      ext g
      rw [MonoidHom.mem_ker]
      have hfix : g ∈ (E_int r).fixingSubgroup ↔ ∀ x : L_fld r, π_gal g x = x := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        refine ⟨fun h x => ?_, fun h x hx => ?_⟩
        · apply hι_L_inj r
          change algebraMap (L_fld r) (L_V r) ((g.restrictNormal (L_fld r)) x) =
            algebraMap (L_fld r) (L_V r) x
          rw [AlgEquiv.restrictNormal_commutes]
          exact h x.1 x.2
        · have h1 := congrArg (algebraMap (L_fld r) (L_V r)) (h ⟨x, hx⟩)
          change algebraMap (L_fld r) (L_V r) ((g.restrictNormal (L_fld r)) ⟨x, hx⟩) = x at h1
          rw [AlgEquiv.restrictNormal_commutes] at h1
          exact h1
      have hEq_fix : (E_int r).fixingSubgroup = K_L r :=
        IntermediateField.fixingSubgroup_fixedField (K_L r)
      rw [← hEq_fix, hfix]
      exact ⟨fun hg x => by rw [hg]; rfl, fun hg => AlgEquiv.ext hg⟩
    have hker_le : π_gal.ker ≤ (ρ_L r).ker := by rw [hπ_ker]
    let ρ_Q := QuotientGroup.lift π_gal.ker (ρ_L r) hker_le
    have hρ_Q_inj : Function.Injective ρ_Q := by
      rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
      intro q hq
      rcases QuotientGroup.mk_surjective q with ⟨g, rfl⟩
      rw [MonoidHom.mem_ker, QuotientGroup.lift_mk] at hq
      have hg : g ∈ K_L r := hq
      rw [← hπ_ker] at hg
      exact (QuotientGroup.eq_one_iff g).mpr hg
    let e_gal := QuotientGroup.quotientKerEquivOfSurjective π_gal hπ_surj
    let ρ_bar : (L_fld r ≃ₐ[K] L_fld r) →*
        (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ :=
      ρ_Q.comp e_gal.symm.toMonoidHom
    have hρ_bar_inj : Function.Injective ρ_bar := hρ_Q_inj.comp e_gal.symm.injective
    have hρ_bar_apply : ∀ g : L_V r ≃ₐ[K] L_V r, ρ_bar (π_gal g) = ρ_L r g := by
      intro g
      have he : e_gal.symm (π_gal g) = QuotientGroup.mk g := by
        apply e_gal.injective; rw [e_gal.apply_symm_apply]; rfl
      change ρ_Q (e_gal.symm (π_gal g)) = ρ_L r g
      rw [he, QuotientGroup.lift_mk]
    let ρ_r : (B r ≃ₐ[R₀] B r) →* (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ :=
      ρ_bar.comp (res_B r).symm.toMonoidHom
    have hρ_r_inj : Function.Injective ρ_r := hρ_bar_inj.comp (res_B r).symm.injective
    have hj_LV_inj : Function.Injective (algebraMap (B_V r) (L_V r)) :=
      IsFractionRing.injective (B_V r) (L_V r)
    have hDesc : ∀ τ : B_V r ≃ₐ[R₀] B_V r, ∃ σ : B r ≃ₐ[R₀] B r,
        (∀ b : B r, τ (j_B r b) = j_B r (σ b)) ∧ ρ_r σ = ρ_mid r τ := by
      intro τ
      let τ_L : L_V r ≃ₐ[K] L_V r := (res_V r).symm τ
      let σ_L : L_fld r ≃ₐ[K] L_fld r := π_gal τ_L
      let σ : B r ≃ₐ[R₀] B r := res_B r σ_L
      refine ⟨σ, ?_, ?_⟩
      · intro b
        apply hj_LV_inj
        have h1 : algebraMap (B_V r) (L_V r) (τ (j_B r b)) =
            τ_L (algebraMap (B_V r) (L_V r) (j_B r b)) := by
          have hτ : τ = res_V r τ_L := ((res_V r).apply_symm_apply τ).symm
          rw [hτ]
          exact algebraMap_galRestrict_apply R₀ τ_L (j_B r b)
        have h2 : algebraMap (B r) (L_fld r) (σ b) = σ_L (algebraMap (B r) (L_fld r) b) :=
          algebraMap_galRestrict_apply R₀ σ_L b
        rw [h1, hj_B_spec, hj_B_spec, h2]
        exact (AlgEquiv.restrictNormal_commutes τ_L (L_fld r) (algebraMap (B r) (L_fld r) b)).symm
      · change ρ_bar ((res_B r).symm (res_B r (π_gal τ_L))) = ρ_mid r τ
        rw [(res_B r).symm_apply_apply, hρ_bar_apply]
        change ρ_mid r (res_V r ((res_V r).symm τ)) = ρ_mid r τ
        rw [(res_V r).apply_symm_apply]
    have hLift : ∀ τ_B : B r ≃ₐ[R₀] B r, ∃ τ_V : B_V r ≃ₐ[R₀] B_V r,
        (∀ b : B r, τ_V (j_B r b) = j_B r (τ_B b)) ∧ ρ_r τ_B = ρ_mid r τ_V := by
      intro τ_B
      obtain ⟨τ_L, hτ_L⟩ := hπ_surj ((res_B r).symm τ_B)
      let τ_V : B_V r ≃ₐ[R₀] B_V r := res_V r τ_L
      obtain ⟨σ, hσ_comm, hσ_ρ⟩ := hDesc τ_V
      have hσ_eq : σ = τ_B := by
        apply (res_B r).symm.injective
        apply hρ_bar_inj
        have h1 : ρ_bar ((res_B r).symm σ) = ρ_mid r τ_V := hσ_ρ
        have h2 : ρ_bar ((res_B r).symm τ_B) = ρ_mid r τ_V := by
          rw [← hτ_L, hρ_bar_apply]; rfl
        exact h1.trans h2.symm
      rw [hσ_eq] at hσ_comm hσ_ρ
      exact ⟨τ_V, hσ_comm, hσ_ρ⟩
    have hRange : ∀ y : B_V r,
        y ∈ Set.range (j_B r) ↔ ∀ τ : B_V r ≃ₐ[R₀] B_V r, ρ_mid r τ = 1 → τ y = y := by
      intro y
      refine ⟨?_, ?_⟩
      · rintro ⟨b, rfl⟩ τ hτ
        obtain ⟨σ, hσ_comm, hσ_ρ⟩ := hDesc τ
        have hσ1 : σ = 1 := hρ_r_inj (by rw [hσ_ρ, hτ, map_one])
        rw [hσ_comm, hσ1]; rfl
      · intro hy
        let z_V : L_V r := algebraMap (B_V r) (L_V r) y
        have hz_fix : z_V ∈ E_int r := by
          rw [IntermediateField.mem_fixedField_iff]
          intro g hg
          have hρ_g : ρ_mid r (res_V r g) = 1 := hg
          have hy_g : res_V r g y = y := hy (res_V r g) hρ_g
          have hgal : algebraMap (B_V r) (L_V r) (res_V r g y) =
              g (algebraMap (B_V r) (L_V r) y) := algebraMap_galRestrict_apply R₀ g y
          dsimp [z_V]; rw [← hgal, hy_g]
        let z : L_fld r := ⟨z_V, hz_fix⟩
        have hz_V_int : IsIntegral R₀ z_V :=
          (IsIntegralClosure.isIntegral R₀ (L_V r) y).map
            (IsScalarTower.toAlgHom R₀ (B_V r) (L_V r))
        have hz_int : IsIntegral R₀ z :=
          (isIntegral_algHom_iff (ι_LR₀ r) (hι_L_inj r)).mp hz_V_int
        let b : B r := ⟨z, hz_int⟩
        exact ⟨b, hj_LV_inj (by rw [hj_B_spec]; rfl)⟩
    exact ⟨ρ_r, hρ_r_inj, hRange, hDesc, hLift⟩

  let ρ : ∀ r : ℕ, (B r ≃ₐ[R₀] B r) →* (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ :=
    fun r => Classical.choose (hQuotPkg r)
  have hρ_spec := fun r => Classical.choose_spec (hQuotPkg r)

  
  have hArtinSurj : ∀ (E K_top : Type u) [Field E] [Field K_top] [Finite K_top]
      [Algebra E K_top] {H_grp : Type u} [Group H_grp] (Ψ : H_grp →* (K_top ≃ₐ[E] K_top)),
      (∀ v : K_top, (∀ h : H_grp, Ψ h v = v) → v ∈ Set.range (algebraMap E K_top)) →
      Function.Surjective Ψ := by
    intro E K_top _ _ _ _ H_grp _ Ψ hFix
    let b_K := Module.Basis.ofVectorSpace E K_top
    have _ : Finite (Module.Basis.ofVectorSpaceIndex E K_top) :=
      Finite.of_injective b_K b_K.injective
    have _ : FiniteDimensional E K_top := Module.Finite.of_basis b_K
    let G_k := (K_top ≃ₐ[E] K_top)
    have _ : Finite G_k :=
      Finite.of_injective (fun g : G_k => (g : K_top → K_top)) DFunLike.coe_injective
    let I_sub : Subgroup G_k := Ψ.range
    let F_I : IntermediateField E K_top := IntermediateField.fixedField I_sub
    have hFI_bot : F_I = ⊥ := by
      ext v
      rw [IntermediateField.mem_bot]
      refine ⟨fun hv => ?_, fun ⟨c, hc⟩ => hc ▸ F_I.algebraMap_mem c⟩
      exact hFix v fun h => (IntermediateField.mem_fixedField_iff I_sub v).mp hv (Ψ h) ⟨h, rfl⟩
    have hfr_FI : Module.finrank E ↥F_I = 1 := by
      rw [hFI_bot]; exact IntermediateField.finrank_bot
    have hCard_I : Nat.card ↥I_sub = Module.finrank E K_top := by
      have h1 := IntermediateField.finrank_fixedField_eq_card I_sub
      have h2 := Module.finrank_mul_finrank E ↥F_I K_top
      rw [hfr_FI, one_mul] at h2
      exact h1.symm.trans h2
    have hCard_Gk : Nat.card G_k ≤ Module.finrank E K_top := by
      have h1 := IntermediateField.finrank_fixedField_eq_card (⊤ : Subgroup G_k)
      have h2 := Module.finrank_mul_finrank E
        ↥(IntermediateField.fixedField (⊤ : Subgroup G_k)) K_top
      have hpos : 0 < Module.finrank E
          ↥(IntermediateField.fixedField (⊤ : Subgroup G_k)) := Module.finrank_pos
      have htop : Nat.card ↥(⊤ : Subgroup G_k) = Nat.card G_k :=
        Nat.card_congr Subgroup.topEquiv.toEquiv
      rw [htop] at h1; rw [h1] at h2; nlinarith
    have hI_le : Nat.card ↥I_sub ≤ Nat.card G_k :=
      Nat.card_le_card_of_injective (Subtype.val : ↥I_sub → G_k) Subtype.val_injective
    have hI_top : I_sub = ⊤ := Subgroup.eq_top_of_card_eq I_sub (by omega)
    intro α; have hα : α ∈ I_sub := by rw [hI_top]; trivial
    exact hα

  have hGeomLiftGen : ∀ (B₁ L₁ B₂ L₂ : Type u)
      [CommRing B₁] [IsDomain B₁] [Field L₁]
      [Algebra F B₁] [Algebra R₀ B₁] [Algebra F L₁] [Algebra K L₁] [Algebra B₁ L₁] [Algebra R₀ L₁]
      [IsScalarTower F B₁ L₁] [IsScalarTower F R₀ L₁] [IsScalarTower R₀ B₁ L₁] [IsScalarTower R₀ K L₁]
      [IsFractionRing B₁ L₁] [IsIntegralClosure B₁ R₀ L₁] [FiniteDimensional K L₁] [IsGalois K L₁]
      [CommRing B₂] [IsDomain B₂] [Field L₂]
      [Algebra F B₂] [Algebra R₀ B₂] [Algebra F L₂] [Algebra K L₂] [Algebra B₂ L₂] [Algebra R₀ L₂]
      [IsScalarTower F K L₂] [IsScalarTower F B₂ L₂] [IsScalarTower R₀ B₂ L₂] [IsScalarTower R₀ K L₂]
      [IsFractionRing B₂ L₂] [IsIntegralClosure B₂ R₀ L₂] [FiniteDimensional K L₂] [IsGalois K L₂]
      [Finite ↥(algebraicClosure F L₁)] [Finite ↥(algebraicClosure F L₂)]
      (j_B₁ : B₁ →ₐ[R₀] B₂) (ι_L₁ : L₁ →ₐ[K] L₂),
      (∀ c : F, ι_L₁ (algebraMap F L₁ c) = algebraMap F L₂ c) →
      (∀ b : B₁, algebraMap B₂ L₂ (j_B₁ b) = ι_L₁ (algebraMap B₁ L₁ b)) →
      ∀ σ : B₁ ≃ₐ[R₀] B₁, (∀ x : B₁, IsIntegral F x → σ x = x) →
      ∃ τ : B₂ ≃ₐ[R₀] B₂,
        (∀ x : B₂, IsIntegral F x → τ x = x) ∧
        ∀ b : B₁, τ (j_B₁ b) = j_B₁ (σ b) := by
    intro B₁ L₁ B₂ L₂ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
      j_B₁ ι_L₁ hι_F hj_spec σ hσ_int
    have hι_inj : Function.Injective ι_L₁ := ι_L₁.injective
    have hj_LV_inj : Function.Injective (algebraMap B₂ L₂) := IsFractionRing.injective B₂ L₂
    let res₁ : (L₁ ≃ₐ[K] L₁) ≃* (B₁ ≃ₐ[R₀] B₁) := galRestrict R₀ K L₁ B₁
    let res₂ : (L₂ ≃ₐ[K] L₂) ≃* (B₂ ≃ₐ[R₀] B₂) := galRestrict R₀ K L₂ B₂
    let _ : Algebra L₁ L₂ := ι_L₁.toRingHom.toAlgebra
    have _ : IsScalarTower K L₁ L₂ := IsScalarTower.of_algebraMap_eq fun k => (ι_L₁.commutes k).symm
    have _ : IsScalarTower F L₁ L₂ := IsScalarTower.of_algebraMap_eq fun c => (hι_F c).symm
    have _ : FiniteDimensional L₁ L₂ := Module.Finite.of_restrictScalars_finite K L₁ L₂
    have _ : IsGalois L₁ L₂ := IsGalois.tower_top_of_isGalois K L₁ L₂
    let k₁ := ↥(algebraicClosure F L₁)
    let k₂ := ↥(algebraicClosure F L₂)
    have hk_sub : ∀ c : k₁, ι_L₁ c.1 ∈ algebraicClosure F L₂ := by
      intro c; rw [mem_algebraicClosure_iff]
      have hc_int : IsIntegral F c.1 :=
        isAlgebraic_iff_isIntegral.mp (mem_algebraicClosure_iff.mp c.2)
      exact isAlgebraic_iff_isIntegral.mpr (hc_int.map (IsScalarTower.toAlgHom F L₁ L₂))
    let ι_k : k₁ →+* k₂ :=
      { toFun := fun c => ⟨ι_L₁ c.1, hk_sub c⟩
        map_one' := Subtype.ext (map_one ι_L₁)
        map_mul' := fun a b => Subtype.ext (map_mul ι_L₁ a.1 b.1)
        map_zero' := Subtype.ext (map_zero ι_L₁)
        map_add' := fun a b => Subtype.ext (map_add ι_L₁ a.1 b.1) }
    let _ : Algebra k₁ k₂ := ι_k.toAlgebra
    have hδ_k₂ : ∀ (δ : L₂ ≃ₐ[L₁] L₂) (v : k₂), δ v.1 ∈ algebraicClosure F L₂ := by
      intro δ v; rw [mem_algebraicClosure_iff]
      have hv_int : IsIntegral F v.1 :=
        isAlgebraic_iff_isIntegral.mp (mem_algebraicClosure_iff.mp v.2)
      exact isAlgebraic_iff_isIntegral.mpr (hv_int.map (δ.restrictScalars F).toAlgHom)
    let Ψ : (L₂ ≃ₐ[L₁] L₂) →* (k₂ ≃ₐ[k₁] k₂) :=
      { toFun := fun δ =>
          { toFun := fun v => ⟨δ v.1, hδ_k₂ δ v⟩
            invFun := fun v => ⟨δ.symm v.1, hδ_k₂ δ.symm v⟩
            left_inv := fun v => Subtype.ext (δ.symm_apply_apply v.1)
            right_inv := fun v => Subtype.ext (δ.apply_symm_apply v.1)
            map_mul' := fun a b => Subtype.ext (map_mul δ a.1 b.1)
            map_add' := fun a b => Subtype.ext (map_add δ a.1 b.1)
            commutes' := fun c => Subtype.ext (δ.commutes c.1) }
        map_one' := AlgEquiv.ext fun _ => rfl
        map_mul' := fun _ _ => AlgEquiv.ext fun _ => rfl }
    have hΨ_surj : Function.Surjective Ψ := by
      refine hArtinSurj k₁ k₂ Ψ fun v hv => ?_
      have hv_fix : v.1 ∈ IntermediateField.fixedField
          ((⊥ : IntermediateField L₁ L₂).fixingSubgroup) := by
        rw [IntermediateField.mem_fixedField_iff]
        intro δ _
        exact congrArg Subtype.val (hv δ)
      rw [IsGalois.fixedField_fixingSubgroup (⊥ : IntermediateField L₁ L₂),
        IntermediateField.mem_bot] at hv_fix
      rcases hv_fix with ⟨x, hx⟩
      have hx_int : IsIntegral F x := by
        have hv_int : IsIntegral F v.1 :=
          isAlgebraic_iff_isIntegral.mp (mem_algebraicClosure_iff.mp v.2)
        rw [← hx] at hv_int
        exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom F L₁ L₂) hι_inj).mp hv_int
      have hx_alg : x ∈ algebraicClosure F L₁ :=
        mem_algebraicClosure_iff.mpr (isAlgebraic_iff_isIntegral.mpr hx_int)
      exact ⟨⟨x, hx_alg⟩, Subtype.ext hx⟩
    let σ_E : L₁ ≃ₐ[K] L₁ := res₁.symm σ
    have hσE_k₁ : ∀ c : k₁, σ_E c.1 = c.1 := by
      intro c
      have hc_int_F : IsIntegral F c.1 :=
        isAlgebraic_iff_isIntegral.mp (mem_algebraicClosure_iff.mp c.2)
      have hc_int_R₀ : IsIntegral R₀ c.1 := IsIntegral.tower_top hc_int_F
      obtain ⟨b_c, hb_c⟩ :=
        (IsIntegralClosure.isIntegral_iff (A := B₁) (R := R₀) (B := L₁)).mp hc_int_R₀
      have hbc_int_F : IsIntegral F b_c := by
        rw [← hb_c] at hc_int_F
        exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom F B₁ L₁)
          (IsFractionRing.injective B₁ L₁)).mp hc_int_F
      have hσ_bc : σ b_c = b_c := hσ_int b_c hbc_int_F
      have hgal : algebraMap B₁ L₁ (res₁ σ_E b_c) = σ_E (algebraMap B₁ L₁ b_c) :=
        algebraMap_galRestrict_apply R₀ σ_E b_c
      have hσ_eq : res₁ σ_E = σ := res₁.apply_symm_apply σ
      rw [hσ_eq, hσ_bc, hb_c] at hgal
      exact hgal.symm
    obtain ⟨τ₀, hτ₀_ext⟩ := AlgEquiv.restrictNormalHom_surjective L₂ σ_E
    have hτ₀_LR : ∀ x : L₁, τ₀ (ι_L₁ x) = ι_L₁ (σ_E x) := by
      intro x
      have h1 := (AlgEquiv.restrictNormal_commutes τ₀ L₁ x).symm
      change τ₀ (algebraMap L₁ L₂ x) = algebraMap L₁ L₂ (σ_E x)
      rw [h1]
      exact congrArg (algebraMap L₁ L₂) (AlgEquiv.congr_fun hτ₀_ext x)
    have hτ₀_k₂ : ∀ (γ : L₂ ≃ₐ[K] L₂) (v : k₂), γ v.1 ∈ algebraicClosure F L₂ := by
      intro γ v; rw [mem_algebraicClosure_iff]
      have hv_int : IsIntegral F v.1 :=
        isAlgebraic_iff_isIntegral.mp (mem_algebraicClosure_iff.mp v.2)
      exact isAlgebraic_iff_isIntegral.mpr (hv_int.map (γ.restrictScalars F).toAlgHom)
    let α₀ : k₂ ≃ₐ[k₁] k₂ :=
      { toFun := fun v => ⟨τ₀ v.1, hτ₀_k₂ τ₀ v⟩
        invFun := fun v => ⟨τ₀.symm v.1, hτ₀_k₂ τ₀.symm v⟩
        left_inv := fun v => Subtype.ext (τ₀.symm_apply_apply v.1)
        right_inv := fun v => Subtype.ext (τ₀.apply_symm_apply v.1)
        map_mul' := fun a b => Subtype.ext (map_mul τ₀ a.1 b.1)
        map_add' := fun a b => Subtype.ext (map_add τ₀ a.1 b.1)
        commutes' := fun c => Subtype.ext (by
          change τ₀ (ι_L₁ c.1) = ι_L₁ c.1
          rw [hτ₀_LR c.1, hσE_k₁ c]) }
    obtain ⟨δ, hδ⟩ := hΨ_surj α₀
    let τ_L : L₂ ≃ₐ[K] L₂ := (δ.restrictScalars K)⁻¹ * τ₀
    let τ : B₂ ≃ₐ[R₀] B₂ := res₂ τ_L
    refine ⟨τ, ?_, ?_⟩
    · intro x hx
      apply hj_LV_inj
      have hx_L : IsIntegral F (algebraMap B₂ L₂ x) :=
        hx.map (IsScalarTower.toAlgHom F B₂ L₂)
      have hx_alg : algebraMap B₂ L₂ x ∈ algebraicClosure F L₂ :=
        mem_algebraicClosure_iff.mpr (isAlgebraic_iff_isIntegral.mpr hx_L)
      let v : k₂ := ⟨algebraMap B₂ L₂ x, hx_alg⟩
      have hgal : algebraMap B₂ L₂ (res₂ τ_L x) = τ_L (algebraMap B₂ L₂ x) :=
        algebraMap_galRestrict_apply R₀ τ_L x
      dsimp [τ]; rw [hgal]
      change δ.symm (τ₀ v.1) = v.1
      have hα_eq : Ψ δ v = α₀ v := by rw [hδ]
      have hval : δ v.1 = τ₀ v.1 := congrArg Subtype.val hα_eq
      rw [← hval, δ.symm_apply_apply]
    · intro b
      apply hj_LV_inj
      have hgal1 : algebraMap B₂ L₂ (res₂ τ_L (j_B₁ b)) = τ_L (algebraMap B₂ L₂ (j_B₁ b)) :=
        algebraMap_galRestrict_apply R₀ τ_L (j_B₁ b)
      have hgal2 : algebraMap B₁ L₁ (res₁ σ_E b) = σ_E (algebraMap B₁ L₁ b) :=
        algebraMap_galRestrict_apply R₀ σ_E b
      have hσ_eq : res₁ σ_E = σ := res₁.apply_symm_apply σ
      rw [hσ_eq] at hgal2
      dsimp [τ]; rw [hgal1, hj_spec, hj_spec, hgal2]
      change δ.symm (τ₀ (ι_L₁ (algebraMap B₁ L₁ b))) = ι_L₁ (σ_E (algebraMap B₁ L₁ b))
      rw [hτ₀_LR]
      exact δ.symm.commutes (σ_E (algebraMap B₁ L₁ b))

  have hGeomLift : ∀ (r : ℕ) (σ : B r ≃ₐ[R₀] B r),
      (∀ x : B r, IsIntegral F x → σ x = x) →
      ∃ τ : B_V r ≃ₐ[R₀] B_V r,
        (∀ x : B_V r, IsIntegral F x → τ x = x) ∧
        ∀ b : B r, τ (j_B r b) = j_B r (σ b) :=
    fun r σ hσ_int => hGeomLiftGen (B r) (L_fld r) (B_V r) (L_V r) (j_B r) (ι_L r)
      (hι_L_F r) (hj_B_spec r) σ hσ_int

  
  have hCastMid : ∀ (r : ℕ) (τ' : B_V (r + 1) ≃ₐ[R₀] B_V (r + 1)) (τ₀ : B_V r ≃ₐ[R₀] B_V r),
      let cast_r := ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
      ((ρ_V (r + 1) τ').val).map cast_r = (ρ_V r τ₀).val →
      ((ρ_mid (r + 1) τ').val).map cast_r = (ρ_mid r τ₀).val := by
    intro r τ' τ₀ cast_r hρ_cast
    have hcomp : cast_r.comp (PadicInt.toZModPow (r + 2)) = PadicInt.toZModPow (r + 1) :=
      PadicInt.zmod_cast_comp_toZModPow (p := ℓ) (r + 1) (r + 2) (Nat.le_succ (r + 1))
    have hMatCast : ∀ U : Matrix (Fin N) (Fin N) (PadicInt ℓ),
        (U.map (PadicInt.toZModPow (r + 2))).map cast_r = U.map (PadicInt.toZModPow (r + 1)) := by
      intro U; ext i j
      simp only [Matrix.map_apply]
      exact RingHom.congr_fun hcomp (U i j)
    have hAdap_cast :
        (((P_chg⁻¹).val.map (PadicInt.toZModPow (r + 2)) * (ρ_V (r + 1) τ').val *
            (P_chg.val.map (PadicInt.toZModPow (r + 2)))).map cast_r) =
          ((P_chg⁻¹).val.map (PadicInt.toZModPow (r + 1)) * (ρ_V r τ₀).val *
            (P_chg.val.map (PadicInt.toZModPow (r + 1)))) := by
      rw [← RingHom.mapMatrix_apply, map_mul, map_mul]
      simp only [RingHom.mapMatrix_apply, hMatCast, hρ_cast]
    ext k₁ k₂
    rw [(hρ_mid_spec r).1 τ₀ k₁ k₂]
    change cast_r ((ρ_mid (r + 1) τ').val k₁ k₂) = _
    rw [(hρ_mid_spec (r + 1)).1 τ' k₁ k₂]
    dsimp only
    exact congrArg (fun X => X ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩) hAdap_cast

  have hι_B_ex : ∀ (r : ℕ) (b : B r), ∃ b' : B (r + 1), j_B (r + 1) b' = ι_BV r (j_B r b) := by
    intro r b
    rw [← Set.mem_range, (hρ_spec (r + 1)).2.1]
    intro τ' hτ'_ker
    obtain ⟨τ₀, hτ₀_comm, hτ₀_cast⟩ := (hι_compat r).2 τ'
    have hmid_cast := hCastMid r τ' τ₀ hτ₀_cast
    have hτ₀_ker : ρ_mid r τ₀ = 1 := by
      apply Units.ext
      rw [← hmid_cast, hτ'_ker, Units.val_one, Units.val_one]
      ext k₁ k₂
      let cast_r := ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
      change cast_r ((1 : Matrix (Fin M) (Fin M) _) k₁ k₂) = (1 : Matrix (Fin M) (Fin M) _) k₁ k₂
