        rw [hAff.range_fromSpec]
        exact hw₁_mem
      rcases hw₁_spec with ⟨q, rfl⟩
      obtain ⟨O₀, hO₀_open, hq_O₀, hO₀_pre⟩ := hSpecPreirredNbhd B q
