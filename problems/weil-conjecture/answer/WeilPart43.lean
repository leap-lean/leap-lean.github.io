    | succ c' ih =>
      obtain ⟨ι_prev, hι_prev_inj, hRes_prev⟩ := ih
      letI := D.hCR (r + c'); letI := D.hCR (r + c' + 1)
      letI := D.hAR_B (r + c'); letI := D.hAR_B (r + c' + 1)
      let ι_next : D.B_V r →ₐ[Localization.Away Δ_F] D.B_V (r + (c' + 1)) :=
        (D.ι_BV (r + c')).comp ι_prev
      have hι_next_inj : Function.Injective ι_next :=
        (D.hι_compat (r + c')).1.comp hι_prev_inj
      refine ⟨ι_next, hι_next_inj, fun σ' => ?_⟩
      obtain ⟨σ_mid, hmid_comm, hmid_ρ⟩ := (D.hι_compat (r + c')).2 σ'
      obtain ⟨σ_r, hr_comm, hr_ρ⟩ := hRes_prev σ_mid
      refine ⟨σ_r, fun b => ?_, ?_⟩
      · change σ' (D.ι_BV (r + c') (ι_prev b)) = D.ι_BV (r + c') (ι_prev (σ_r b))
        rw [hmid_comm, hr_comm]
      · rw [← hr_ρ, ← hmid_ρ]
        ext i j
        simp only [Matrix.map_apply]
        have hcomp :
            (ZMod.castHom (pow_dvd_pow ℓ (by omega : r + 1 ≤ r + c' + 1))
                (ZMod (ℓ ^ (r + 1)))).comp
              (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + c' + 1)))
                (ZMod (ℓ ^ (r + c' + 1)))) =
            ZMod.castHom (pow_dvd_pow ℓ (by omega : r + 1 ≤ r + (c' + 1) + 1))
              (ZMod (ℓ ^ (r + 1))) := by
          ext; simp
        exact (RingHom.congr_fun hcomp ((D.ρ_V (r + (c' + 1)) σ').val i j)).symm

  obtain ⟨ι_rc, hι_rc_inj, hRes_rc⟩ := hIterTower D.c_iso
  letI := D.hCR r'; letI := D.hDom r'; letI := D.hFld r'
  letI := D.hAF_B r'; letI := D.hAP_B r'; letI := D.hAR_B r'
  letI := D.hAF_L r'; letI := D.hAP_L r'; letI := D.hARF_L r'
