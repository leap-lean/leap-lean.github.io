                  CategoryTheory.Over.w (Fgt_Y.map (mor_BW idx))
                have hw2 : u_i ≫ h_W = h_Wi :=
                  CategoryTheory.Over.w (Fgt_D.map (mor_W idx))
                rw [hw1, hw2]
                exact (CategoryTheory.IsPullback.of_hasPullback h_Wi h).flip
              have h_comm : v_i ≫ p_W =
                  CategoryTheory.Limits.pullback.fst h_Wi h ≫ u_i := by
                dsimp [v_i, u_i, h_Wi, Fgt_Y, Fgt_D, mor_BW, B_h, weilEtaleSitePullback,
                  CategoryTheory.MorphismProperty.Over.pullback, p_W]
                exact CategoryTheory.Limits.pullback.lift_fst _ _ _
              have hp_left : CategoryTheory.IsPullback
                  v_i
                  (CategoryTheory.Limits.pullback.fst h_Wi h)
                  p_W u_i :=
                CategoryTheory.IsPullback.of_right h_outer h_comm
                  (CategoryTheory.IsPullback.of_hasPullback h_W h).flip
              have hEt_BW : AlgebraicGeometry.Etale v_i :=
                CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
                  hp_left.flip hEt_i
