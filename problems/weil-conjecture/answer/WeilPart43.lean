  letI := D.hFin_B r'; letI := D.hEt_B r'; letI := D.hFrac r'
  letI := D.hIntCl r'; letI := D.hFD_L r'; letI := D.hGal_L r'

  have hFix_rc : ∀ σ' : D.B_V r' ≃ₐ[Localization.Away Δ_F] D.B_V r',
      (ℓ ^ D.c_iso) • ((D.ρ_V r' σ').val - 1) = 0 →
      ∀ b : D.B_V r, σ' (ι_rc b) = ι_rc b := by
    intro σ' hAnn b
    obtain ⟨σ_r, hr_comm, hr_ρ⟩ := hRes_rc σ'
    have hMap1 : ((D.ρ_V r' σ').val).map
        (ZMod.castHom (pow_dvd_pow ℓ (by omega : r + 1 ≤ r' + 1)) (ZMod (ℓ ^ (r + 1)))) = 1 := by
      let π_cast := ZMod.castHom (pow_dvd_pow ℓ (by omega : r + 1 ≤ r' + 1)) (ZMod (ℓ ^ (r + 1)))
      ext i j
      have hij : (ℓ ^ D.c_iso) •
          ((D.ρ_V r' σ').val i j - (1 : Matrix (Fin D.N) (Fin D.N) _) i j) = 0 := by
        simpa only [Matrix.smul_apply, Matrix.sub_apply, Matrix.zero_apply] using
