    refine ⟨Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (j_B r).toRingHom hj_int (Q_u_V r),
      ?_, ?_, ?_⟩
    · rw [Ideal.comap_comap]
      have hcomp_PF : (j_B r).toRingHom.comp (algebraMap (Polynomial F) (B r)) =
