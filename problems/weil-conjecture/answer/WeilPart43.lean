    have : AlgebraicGeometry.IsFinite π₀ := hFin_π₀
    have : AlgebraicGeometry.Etale π₀ := hEt_π₀
    have : AlgebraicGeometry.Surjective π₀ := hSurj_π₀
    let ι₀ : V₀ ⟶ D₀ := π₀ ≫ U₀.ι
    have : AlgebraicGeometry.Etale ι₀ :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) π₀ U₀.ι
        hEt_π₀ inferInstance
    have ha_ι : ∀ σ : Γ₀, a σ ≫ ι₀ = ι₀ := fun σ => by
      dsimp [ι₀]; rw [← Category.assoc, ha_π σ]
    have ha_et : ∀ σ : Γ₀, AlgebraicGeometry.Etale (a σ) := fun σ => by
      have _ : CategoryTheory.IsIso (a σ) :=
        ⟨⟨a σ⁻¹, by rw [← ha_mul, inv_mul_cancel, ha_one],
          by rw [← ha_mul, mul_inv_cancel, ha_one]⟩⟩
      infer_instance
    let C_vec := Fin K → ZMod ℓ
    let M_act : Γ₀ → (C_vec →+ C_vec) :=
      fun σ => (Matrix.mulVecLin (ρ_mod σ).val).toAddMonoidHom
    have : NeZero ℓ := ⟨hPrime.ne_zero⟩
    have hOpensRange : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (O : Z.Opens),
        Set.range O.ι.base = (O : Set ↥Z) := fun {Z} O => by
      change (O.ι.opensRange : Set ↥Z) = (O : Set ↥Z)
      rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
    have hRange_ι₀ : Set.range ι₀.base = (U₀ : Set D₀) := by
      ext x; constructor
      · rintro ⟨v, rfl⟩; rw [← hOpensRange U₀]; exact ⟨π₀.base v, rfl⟩
      · intro hx
        obtain ⟨u, hu⟩ := (hOpensRange U₀).symm ▸ hx
        obtain ⟨v, hv⟩ := π₀.surjective u
        exact ⟨v, by change U₀.ι.base (π₀.base v) = x; rw [hv, hu]⟩
    have hSheafEqZero : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
        (𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
        {E : Z.Etale} (S : CategoryTheory.Sieve E),
        S ∈ Z.smallEtaleTopology E →
        ∀ (s : ↑(𝒢.obj.obj (Opposite.op E))),
          (∀ ⦃E' : Z.Etale⦄ (u : E' ⟶ E), S.arrows u → (𝒢.obj.map u.op).hom s = 0) →
          s = 0 := by
      intro Z 𝒢 E S hS s hs0
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let α_s : Aℤ ⟶ 𝒢.obj.obj (Opposite.op E) :=
        AddCommGrpCat.ofHom
          { toFun := fun n => n.down • s
            map_zero' := zero_zsmul s
            map_add' := fun m n => add_zsmul s m.down n.down }
      let fam0 : CategoryTheory.Presieve.FamilyOfElements
          (𝒢.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ)) S.arrows :=
        fun E' _ _ => (0 : Aℤ ⟶ 𝒢.obj.obj (Opposite.op E'))
      have hcompat0 : fam0.Compatible := fun _ _ _ _ _ _ _ _ _ _ => by
        change (0 : Aℤ ⟶ _) ≫ _ = (0 : Aℤ ⟶ _) ≫ _
        rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.zero_comp]
      have hamalg_s : fam0.IsAmalgamation α_s := fun E' u hu => by
        change α_s ≫ 𝒢.obj.map u.op = 0
        ext ⟨n⟩; change (𝒢.obj.map u.op).hom (n • s) = 0
        rw [map_zsmul, hs0 u hu, zsmul_zero]
      have hamalg_0 : fam0.IsAmalgamation (0 : Aℤ ⟶ 𝒢.obj.obj (Opposite.op E)) :=
        fun _ u _ => by
          change (0 : Aℤ ⟶ _) ≫ 𝒢.obj.map u.op = 0
          exact CategoryTheory.Limits.zero_comp
      have hα0 : α_s = 0 := (𝒢.property Aℤ S hS fam0 hcompat0).unique hamalg_s hamalg_0
      have h1 := congrArg (fun m : Aℤ ⟶ 𝒢.obj.obj (Opposite.op E) => m.hom (ULift.up 1)) hα0
      simpa [α_s] using h1
    have hSubOfEmpty : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
        (𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
        (E : Z.Etale),
        IsEmpty ↥((AlgebraicGeometry.Scheme.Etale.forget Z).obj E).left →
        Subsingleton ↑(𝒢.obj.obj (Opposite.op E)) := by
      intro Z 𝒢 E hEmp
      have hBot : (⊥ : CategoryTheory.Sieve E) ∈ Z.smallEtaleTopology E :=
        (hMemSite Z E ⊥).mpr fun x => hEmp.elim x
      refine ⟨fun s₁ s₂ => sub_eq_zero.mp ?_⟩
      exact hSheafEqZero 𝒢 ⊥ hBot (s₁ - s₂) fun _ _ hu => False.elim hu
    have hBuildSheetLC : ∀ {Z P : AlgebraicGeometry.Scheme.{u}}
        (fst : P ⟶ Z) (δ : Γ₀ → (Z ⟶ P)),
        (∀ σ : Γ₀, δ σ ≫ fst = 𝟙 Z) →
        (∀ σ : Γ₀, IsOpen (Set.range (δ σ).base)) →
        (∀ σ₁ σ₂ : Γ₀, σ₁ ≠ σ₂ → Disjoint (Set.range (δ σ₁).base) (Set.range (δ σ₂).base)) →
        (⋃ σ : Γ₀, Set.range (δ σ).base) = Set.univ →
        ∀ (val : Γ₀ → LocallyConstant ↥Z C_vec),
          ∃ F : LocallyConstant ↥P C_vec,
            ∀ (σ : Γ₀) (z : ↥Z), F ((δ σ).base z) = val σ z := by
      intro Z P fst δ h_fst h_open h_disj h_univ val
      have hex : ∀ y : ↥P, ∃ σ : Γ₀, y ∈ Set.range (δ σ).base := fun y => by
        have hy : y ∈ (⋃ σ : Γ₀, Set.range (δ σ).base) := h_univ.symm ▸ Set.mem_univ y
        exact Set.mem_iUnion.mp hy
      let σ_of : ↥P → Γ₀ := fun y => Classical.choose (hex y)
      have hσ_mem : ∀ y : ↥P, y ∈ Set.range (δ (σ_of y)).base :=
        fun y => Classical.choose_spec (hex y)
      have hσ_eq : ∀ (σ : Γ₀) (z : ↥Z), σ_of ((δ σ).base z) = σ := by
        intro σ z; by_contra hne
        exact Set.disjoint_left.mp (h_disj _ _ hne) (hσ_mem ((δ σ).base z)) ⟨z, rfl⟩
      have hfst_δ : ∀ (σ : Γ₀) (z : ↥Z), fst.base ((δ σ).base z) = z := fun σ z =>
        congrArg (fun m : Z ⟶ Z => m.base z) (h_fst σ)
      let toFun : ↥P → C_vec := fun y => val (σ_of y) (fst.base y)
      have htoFun_δ : ∀ (σ : Γ₀) (z : ↥Z), toFun ((δ σ).base z) = val σ z := fun σ z => by
        dsimp [toFun]; rw [hσ_eq σ z, hfst_δ σ z]
      have hlc : IsLocallyConstant toFun := by
        intro T
        have hpre : toFun ⁻¹' T =
            ⋃ σ : Γ₀, (Set.range (δ σ).base ∩ fst.base ⁻¹' ((val σ) ⁻¹' T)) := by
          ext y; simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_inter_iff]
          constructor
          · intro hy
            let σ := σ_of y
            obtain ⟨z, hz⟩ := hσ_mem y
            refine ⟨σ, ⟨z, hz⟩, ?_⟩
            rw [← hz, hfst_δ]
            have hy' : toFun ((δ σ).base z) ∈ T := hz.symm ▸ hy
            rwa [htoFun_δ] at hy'
          · rintro ⟨σ, ⟨z, rfl⟩, hzT⟩
            rw [hfst_δ] at hzT; rw [htoFun_δ]; exact hzT
        rw [hpre]
        exact isOpen_iUnion fun σ =>
          (h_open σ).inter (fst.continuous.isOpen_preimage _ ((val σ).isLocallyConstant T))
      exact ⟨⟨toFun, hlc⟩, htoFun_δ⟩
    have hSheetsOfPullback : ∀ {Y V_Y : AlgebraicGeometry.Scheme.{u}}
        (q_Y : V_Y ⟶ V₀) (ι_Y : V_Y ⟶ Y) (h : Y ⟶ D₀)
        (hpb_Y : CategoryTheory.IsPullback q_Y ι_Y ι₀ h)
        (v_Y : Γ₀ → (V_Y ⟶ V_Y))
        (_hv_q : ∀ σ : Γ₀, v_Y σ ≫ q_Y = q_Y ≫ a σ)
        (_hv_ι : ∀ σ : Γ₀, v_Y σ ≫ ι_Y = ι_Y)
        (Z : AlgebraicGeometry.Scheme.{u}) (g_Z : Z ⟶ V_Y),
        let P_Y := CategoryTheory.Limits.pullback (g_Z ≫ ι_Y) ι_Y
        ∃ δ_Y : Γ₀ → (Z ⟶ P_Y),
          (∀ σ : Γ₀,
            δ_Y σ ≫ CategoryTheory.Limits.pullback.fst (g_Z ≫ ι_Y) ι_Y = 𝟙 Z ∧
            δ_Y σ ≫ CategoryTheory.Limits.pullback.snd (g_Z ≫ ι_Y) ι_Y = g_Z ≫ v_Y σ ∧
            AlgebraicGeometry.Etale (δ_Y σ) ∧
            IsOpen (Set.range (δ_Y σ).base)) ∧
          (∀ σ₁ σ₂ : Γ₀, σ₁ ≠ σ₂ →
            Disjoint (Set.range (δ_Y σ₁).base) (Set.range (δ_Y σ₂).base)) ∧
          (⋃ σ : Γ₀, Set.range (δ_Y σ).base) = Set.univ ∧
          (∀ (σ τ : Γ₀) (m_τ : P_Y ⟶ P_Y),
            m_τ ≫ CategoryTheory.Limits.pullback.fst (g_Z ≫ ι_Y) ι_Y =
              CategoryTheory.Limits.pullback.fst (g_Z ≫ ι_Y) ι_Y →
            m_τ ≫ CategoryTheory.Limits.pullback.snd (g_Z ≫ ι_Y) ι_Y =
              CategoryTheory.Limits.pullback.snd (g_Z ≫ ι_Y) ι_Y ≫ v_Y τ →
            δ_Y σ ≫ m_τ = δ_Y (τ * σ)) := by
      intro Y V_Y q_Y ι_Y h hpb_Y v_Y hv_q hv_ι Z g_Z P_Y
      let P_0 := CategoryTheory.Limits.pullback ((g_Z ≫ q_Y) ≫ π₀) π₀
      obtain ⟨δ_0, hδ0_props, hδ0_disj, hδ0_univ⟩ := hSheets_π₀ Z (g_Z ≫ q_Y)
      let fst_Y := CategoryTheory.Limits.pullback.fst (g_Z ≫ ι_Y) ι_Y
      let snd_Y := CategoryTheory.Limits.pullback.snd (g_Z ≫ ι_Y) ι_Y
      let fst_0 := CategoryTheory.Limits.pullback.fst ((g_Z ≫ q_Y) ≫ π₀) π₀
      let snd_0 := CategoryTheory.Limits.pullback.snd ((g_Z ≫ q_Y) ≫ π₀) π₀
      have hto0_cond : fst_Y ≫ (g_Z ≫ q_Y) ≫ π₀ = (snd_Y ≫ q_Y) ≫ π₀ := by
        apply (CategoryTheory.cancel_mono U₀.ι).mp
        calc (fst_Y ≫ (g_Z ≫ q_Y) ≫ π₀) ≫ U₀.ι
            = fst_Y ≫ g_Z ≫ (q_Y ≫ ι₀) := by simp only [ι₀, Category.assoc]
          _ = (fst_Y ≫ (g_Z ≫ ι_Y)) ≫ h := by rw [hpb_Y.w]; simp only [Category.assoc]
          _ = snd_Y ≫ (ι_Y ≫ h) := by
              rw [CategoryTheory.Limits.pullback.condition, Category.assoc]
          _ = (snd_Y ≫ q_Y ≫ π₀) ≫ U₀.ι := by rw [← hpb_Y.w]; simp only [ι₀, Category.assoc]
      let to_0 : P_Y ⟶ P_0 := CategoryTheory.Limits.pullback.lift fst_Y (snd_Y ≫ q_Y) hto0_cond
      have hmV_cond : snd_0 ≫ ι₀ = (fst_0 ≫ g_Z ≫ ι_Y) ≫ h := by
        calc snd_0 ≫ ι₀ = (snd_0 ≫ π₀) ≫ U₀.ι := (Category.assoc _ _ _).symm
          _ = (fst_0 ≫ (g_Z ≫ q_Y) ≫ π₀) ≫ U₀.ι := by
              rw [CategoryTheory.Limits.pullback.condition]
          _ = fst_0 ≫ g_Z ≫ (q_Y ≫ ι₀) := by simp only [ι₀, Category.assoc]
          _ = (fst_0 ≫ g_Z ≫ ι_Y) ≫ h := by rw [hpb_Y.w]; simp only [Category.assoc]
      let m_V : P_0 ⟶ V_Y := hpb_Y.lift snd_0 (fst_0 ≫ g_Z ≫ ι_Y) hmV_cond
      let to_Y : P_0 ⟶ P_Y := CategoryTheory.Limits.pullback.lift fst_0 m_V
        (hpb_Y.lift_snd _ _ _).symm
      have h_0Y : to_0 ≫ to_Y = 𝟙 P_Y := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst, Category.id_comp]
        · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, Category.id_comp]
          apply hpb_Y.hom_ext
          · rw [Category.assoc, hpb_Y.lift_fst, CategoryTheory.Limits.pullback.lift_snd]
          · rw [Category.assoc, hpb_Y.lift_snd, CategoryTheory.Limits.pullback.lift_fst_assoc,
              CategoryTheory.Limits.pullback.condition]
      have h_Y0 : to_Y ≫ to_0 = 𝟙 P_0 := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst, Category.id_comp]
        · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd_assoc, hpb_Y.lift_fst, Category.id_comp]
      let iso_P : P_0 ≅ P_Y :=
        { hom := to_Y, inv := to_0, hom_inv_id := h_Y0, inv_hom_id := h_0Y }
      have : CategoryTheory.IsIso to_Y := ⟨⟨to_0, h_Y0, h_0Y⟩⟩
      have hEt_toY : AlgebraicGeometry.Etale to_Y := inferInstance
      let homeo_P := AlgebraicGeometry.Scheme.homeoOfIso iso_P
      let δ_Y : Γ₀ → (Z ⟶ P_Y) := fun σ => δ_0 σ ≫ to_Y
      have hv_mul : ∀ σ₁ σ₂ : Γ₀, v_Y (σ₁ * σ₂) = v_Y σ₂ ≫ v_Y σ₁ := fun σ₁ σ₂ => by
        apply hpb_Y.hom_ext
        · rw [hv_q, Category.assoc, hv_q, ← Category.assoc, hv_q, Category.assoc, ha_mul]
        · rw [hv_ι, Category.assoc, hv_ι, hv_ι]
      refine ⟨δ_Y, ?_, ?_, ?_, ?_⟩
      · intro σ
        obtain ⟨h1, h2, h3, h4⟩ := hδ0_props σ
        refine ⟨?_, ?_, ?_, ?_⟩
        · dsimp [δ_Y]; rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, h1]
        · dsimp [δ_Y]; rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
          apply hpb_Y.hom_ext
          · rw [Category.assoc, hpb_Y.lift_fst, h2]; simp only [Category.assoc, hv_q]
          · rw [Category.assoc, hpb_Y.lift_snd, ← Category.assoc (δ_0 σ), h1,
              Category.id_comp, Category.assoc, hv_ι]
        · exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            (δ_0 σ) to_Y h3 hEt_toY
        · have hrng : Set.range (δ_Y σ).base = homeo_P '' Set.range (δ_0 σ).base := by
            ext y; constructor
            · rintro ⟨z, rfl⟩; exact ⟨(δ_0 σ).base z, ⟨z, rfl⟩, rfl⟩
            · rintro ⟨w, ⟨z, rfl⟩, rfl⟩; exact ⟨z, rfl⟩
          rw [hrng]; exact homeo_P.isOpenMap _ h4
      · intro σ₁ σ₂ hne
        refine Set.disjoint_left.mpr fun y ⟨z₁, hz₁⟩ ⟨z₂, hz₂⟩ => ?_
        have heq : (δ_0 σ₁).base z₁ = (δ_0 σ₂).base z₂ :=
          homeo_P.injective (hz₁.trans hz₂.symm)
        exact Set.disjoint_left.mp (hδ0_disj σ₁ σ₂ hne) ⟨z₁, rfl⟩ ⟨z₂, heq.symm⟩
      · ext y; simp only [Set.mem_iUnion, Set.mem_range, Set.mem_univ, iff_true]
        have hw : to_0.base y ∈ (⋃ σ : Γ₀, Set.range (δ_0 σ).base) :=
          hδ0_univ.symm ▸ Set.mem_univ _
        obtain ⟨σ, z, hz⟩ := Set.mem_iUnion.mp hw
        refine ⟨σ, z, ?_⟩
        calc (δ_Y σ).base z = to_Y.base ((δ_0 σ).base z) := rfl
          _ = to_Y.base (to_0.base y) := by rw [hz]
          _ = (to_0 ≫ to_Y).base y := rfl
          _ = y := by rw [h_0Y]; rfl
      · intro σ τ m_τ hm_fst hm_snd
        have h1 := (hδ0_props σ)
        have h1' := (hδ0_props (τ * σ))
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [Category.assoc, hm_fst]; dsimp [δ_Y]
          rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, h1.1,
            Category.assoc, CategoryTheory.Limits.pullback.lift_fst, h1'.1]
        · rw [Category.assoc, hm_snd]
          have hsnd_σ : δ_Y σ ≫ snd_Y = g_Z ≫ v_Y σ := by
            dsimp [δ_Y]; rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
            apply hpb_Y.hom_ext
            · rw [Category.assoc, hpb_Y.lift_fst, h1.2.1]; simp only [Category.assoc, hv_q]
            · rw [Category.assoc, hpb_Y.lift_snd, ← Category.assoc (δ_0 σ), h1.1,
                Category.id_comp, Category.assoc, hv_ι]
          have hsnd_τσ : δ_Y (τ * σ) ≫ snd_Y = g_Z ≫ v_Y (τ * σ) := by
            dsimp [δ_Y]; rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
            apply hpb_Y.hom_ext
            · rw [Category.assoc, hpb_Y.lift_fst, h1'.2.1]; simp only [Category.assoc, hv_q]
            · rw [Category.assoc, hpb_Y.lift_snd, ← Category.assoc (δ_0 (τ * σ)), h1'.1,
                Category.id_comp, Category.assoc, hv_ι]
          rw [← Category.assoc (δ_Y σ), hsnd_σ, hsnd_τσ, hv_mul τ σ, Category.assoc]
    let Fgt_D := AlgebraicGeometry.Scheme.Etale.forget D₀
    let V₀_et : D₀.Etale := AlgebraicGeometry.Scheme.Etale.mk ι₀
    let h_V₀ := (Fgt_D.obj V₀_et).hom
    have hpb_D₀ : CategoryTheory.IsPullback (𝟙 V₀) ι₀ ι₀ (𝟙 D₀) :=
      CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [Category.id_comp, Category.comp_id]⟩
    obtain ⟨γ₀_raw, hγ₀_raw_props, hγ₀_raw_disj, hγ₀_raw_univ, hγ₀_raw_deck⟩ :=
      hSheetsOfPullback (𝟙 V₀) ι₀ (𝟙 D₀) hpb_D₀ a
        (fun σ => by rw [Category.comp_id, Category.id_comp]) ha_ι V₀ (𝟙 V₀)
    let tr₀_hom : CategoryTheory.Limits.pullback (𝟙 V₀ ≫ ι₀) ι₀ ⟶
        CategoryTheory.Limits.pullback h_V₀ (π₀ ≫ U₀.ι) :=
      CategoryTheory.Limits.pullback.lift (f := h_V₀) (g := π₀ ≫ U₀.ι)
        (CategoryTheory.Limits.pullback.fst (𝟙 V₀ ≫ ι₀) ι₀ :
          CategoryTheory.Limits.pullback (𝟙 V₀ ≫ ι₀) ι₀ ⟶ (Fgt_D.obj V₀_et).left)
        (CategoryTheory.Limits.pullback.snd (𝟙 V₀ ≫ ι₀) ι₀)
        (by
          have hc := CategoryTheory.Limits.pullback.condition (f := 𝟙 V₀ ≫ ι₀) (g := ι₀)
          rw [Category.id_comp] at hc; exact hc)
    let tr₀_inv : CategoryTheory.Limits.pullback h_V₀ (π₀ ≫ U₀.ι) ⟶
        CategoryTheory.Limits.pullback (𝟙 V₀ ≫ ι₀) ι₀ :=
      CategoryTheory.Limits.pullback.lift (f := 𝟙 V₀ ≫ ι₀) (g := ι₀)
        (CategoryTheory.Limits.pullback.fst h_V₀ (π₀ ≫ U₀.ι) :
          CategoryTheory.Limits.pullback h_V₀ (π₀ ≫ U₀.ι) ⟶ V₀)
        (CategoryTheory.Limits.pullback.snd h_V₀ (π₀ ≫ U₀.ι))
        ((congrArg ((CategoryTheory.Limits.pullback.fst h_V₀ (π₀ ≫ U₀.ι) :
              CategoryTheory.Limits.pullback h_V₀ (π₀ ≫ U₀.ι) ⟶ V₀) ≫ ·)
            (Category.id_comp ι₀).symm).trans
          (CategoryTheory.Limits.pullback.condition (f := h_V₀) (g := π₀ ≫ U₀.ι)))
    have htr₀_hom_fst : tr₀_hom ≫ CategoryTheory.Limits.pullback.fst h_V₀ (π₀ ≫ U₀.ι) =
        CategoryTheory.Limits.pullback.fst (𝟙 V₀ ≫ ι₀) ι₀ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have htr₀_hom_snd : tr₀_hom ≫ CategoryTheory.Limits.pullback.snd h_V₀ (π₀ ≫ U₀.ι) =
        CategoryTheory.Limits.pullback.snd (𝟙 V₀ ≫ ι₀) ι₀ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have htr₀_inv_fst : tr₀_inv ≫ CategoryTheory.Limits.pullback.fst (𝟙 V₀ ≫ ι₀) ι₀ =
        CategoryTheory.Limits.pullback.fst h_V₀ (π₀ ≫ U₀.ι) :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have htr₀_inv_snd : tr₀_inv ≫ CategoryTheory.Limits.pullback.snd (𝟙 V₀ ≫ ι₀) ι₀ =
        CategoryTheory.Limits.pullback.snd h_V₀ (π₀ ≫ U₀.ι) :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have htr₀_1 : tr₀_hom ≫ tr₀_inv = 𝟙 _ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (Category.assoc _ _ _).trans
          ((congrArg (tr₀_hom ≫ ·) htr₀_inv_fst).trans
            (htr₀_hom_fst.trans (Category.id_comp _).symm))
      · exact (Category.assoc _ _ _).trans
          ((congrArg (tr₀_hom ≫ ·) htr₀_inv_snd).trans
