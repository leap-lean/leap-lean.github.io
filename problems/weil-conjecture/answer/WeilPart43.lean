  · 
    refine ⟨fun r => Ideal.comap (j_B r).toRingHom (Q_u_V r), fun r => ?_⟩
    obtain ⟨hQu_max, hQu_comap, hQu_trans, σ_u_V, hσu_frob, hσu_mat⟩ := hQu_V r
