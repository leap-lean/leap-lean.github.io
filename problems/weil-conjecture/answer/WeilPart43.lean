theorem weil_mid_dev_geom_base_shortExact_delta_frob_comm (F : Type u) [Finite F] [Field F]
    (Y₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F))) :
    let S := weilGeomScheme F Y₀
    let pr_Y : Quiver.Hom S Y₀.left :=
      CategoryTheory.Limits.pullback.fst Y₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
    ∀ (hCont_pr : (weilEtaleSitePullback pr_Y).IsContinuous
          Y₀.left.smallEtaleTopology S.smallEtaleTopology)
      (hAdj_pr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
        Y₀.left.smallEtaleTopology S.smallEtaleTopology hCont_pr).IsRightAdjoint),
      let L_pr := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
        Y₀.left.smallEtaleTopology S.smallEtaleTopology hCont_pr hAdj_pr
      ∀ [L_pr.Additive]
        (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf Y₀.left.smallEtaleTopology AddCommGrpCat.{u}))
        (hSC_bar : (SC.map L_pr).ShortExact)
        (f₃ : (L_pr.obj SC.X₃).H 0 →+ (L_pr.obj SC.X₃).H 0)
        (f₁ : (L_pr.obj SC.X₁).H 1 →+ (L_pr.obj SC.X₁).H 1),
        WeilTransvTriIsGeomBaseSheafAction F Y₀ SC.X₃ (L_pr.obj SC.X₃)
          hCont_pr hAdj_pr (CategoryTheory.Iso.refl _) 0 f₃ →
        WeilTransvTriIsGeomBaseSheafAction F Y₀ SC.X₁ (L_pr.obj SC.X₁)
          hCont_pr hAdj_pr (CategoryTheory.Iso.refl _) 1 f₁ →
        ∀ z : (L_pr.obj SC.X₃).H 0,
          f₁ (z.comp hSC_bar.extClass (Nat.zero_add 1)) =
            (f₃ z).comp hSC_bar.extClass (Nat.zero_add 1) :=
by
  intro S pr_Y hCont_pr hAdj_pr L_pr _ SC hSC_bar f₃ f₁ hf₃ hf₁ z
  let J₀ := Y₀.left.smallEtaleTopology
  let J := S.smallEtaleTopology
  let _ : CategoryTheory.Limits.HasColimitsOfShape CategoryTheory.Limits.WalkingParallelPair
      (CategoryTheory.Sheaf J₀ AddCommGrpCat.{u}) := inferInstance
  let _ : CategoryTheory.Limits.HasColimitsOfShape CategoryTheory.Limits.WalkingParallelPair
      (CategoryTheory.Sheaf J AddCommGrpCat.{u}) := inferInstance
  let _ : CategoryTheory.Abelian (CategoryTheory.Sheaf J AddCommGrpCat.{u}) := inferInstance
  let _ : CategoryTheory.HasExt.{u} (CategoryTheory.Sheaf J AddCommGrpCat.{u}) := inferInstance

  have hPillar_Mate :
      ∀ (C D : Type (u + 1)) [CategoryTheory.Category.{u + 1, u + 1} C]
        [CategoryTheory.Category.{u + 1, u + 1} D]
        (L : CategoryTheory.Functor C D) (R : CategoryTheory.Functor D C)
        (adj : L ⊣ R) (P : CategoryTheory.Functor D D)
        (Θ : CategoryTheory.NatTrans R (CategoryTheory.Functor.comp P R))
        (X₁ X₂ : C) (ψ₀ : Quiver.Hom X₁ X₂)
        (α₁ : Quiver.Hom (L.obj X₁) (P.obj (L.obj X₁)))
        (α₂ : Quiver.Hom (L.obj X₂) (P.obj (L.obj X₂))),
      adj.homEquiv X₁ (P.obj (L.obj X₁)) α₁ =
        CategoryTheory.CategoryStruct.comp (adj.unit.app X₁) (Θ.app (L.obj X₁)) →
      adj.homEquiv X₂ (P.obj (L.obj X₂)) α₂ =
        CategoryTheory.CategoryStruct.comp (adj.unit.app X₂) (Θ.app (L.obj X₂)) →
      CategoryTheory.CategoryStruct.comp α₁ (P.map (L.map ψ₀)) =
        CategoryTheory.CategoryStruct.comp (L.map ψ₀) α₂ := by
    intro C D _ _ L R adj P Θ X₁ X₂ ψ₀ α₁ α₂ hadj₁ hadj₂
    apply (adj.homEquiv X₁ (P.obj (L.obj X₂))).injective
    have h_unit : adj.unit.app X₁ ≫ R.map (L.map ψ₀) = ψ₀ ≫ adj.unit.app X₂ :=
      (adj.unit.naturality ψ₀).symm
    have h_Θ : R.map (L.map ψ₀) ≫ Θ.app (L.obj X₂) =
        Θ.app (L.obj X₁) ≫ R.map (P.map (L.map ψ₀)) :=
      Θ.naturality (L.map ψ₀)
    calc adj.homEquiv X₁ (P.obj (L.obj X₂)) (α₁ ≫ P.map (L.map ψ₀))
        = adj.unit.app X₁ ≫ R.map (α₁ ≫ P.map (L.map ψ₀)) :=
          adj.homEquiv_unit X₁ (P.obj (L.obj X₂)) (α₁ ≫ P.map (L.map ψ₀))
      _ = (adj.unit.app X₁ ≫ R.map α₁) ≫ R.map (P.map (L.map ψ₀)) := by
          rw [R.map_comp, Category.assoc]
      _ = adj.homEquiv X₁ (P.obj (L.obj X₁)) α₁ ≫ R.map (P.map (L.map ψ₀)) := by
          rw [adj.homEquiv_unit]
      _ = adj.unit.app X₁ ≫ (Θ.app (L.obj X₁) ≫ R.map (P.map (L.map ψ₀))) := by
          rw [hadj₁, Category.assoc]
      _ = (adj.unit.app X₁ ≫ R.map (L.map ψ₀)) ≫ Θ.app (L.obj X₂) := by
          rw [← h_Θ, Category.assoc]
      _ = ψ₀ ≫ (adj.unit.app X₂ ≫ Θ.app (L.obj X₂)) := by
          rw [h_unit, Category.assoc]
      _ = ψ₀ ≫ adj.homEquiv X₂ (P.obj (L.obj X₂)) α₂ := by
          rw [← hadj₂]
      _ = (ψ₀ ≫ adj.unit.app X₂) ≫ R.map α₂ := by
          rw [adj.homEquiv_unit, Category.assoc]
      _ = adj.unit.app X₁ ≫ R.map (L.map ψ₀ ≫ α₂) := by
          rw [← h_unit, R.map_comp, Category.assoc]
      _ = adj.homEquiv X₁ (P.obj (L.obj X₂)) (L.map ψ₀ ≫ α₂) :=
          (adj.homEquiv_unit X₁ (P.obj (L.obj X₂)) (L.map ψ₀ ≫ α₂)).symm

  have hPillar_Ext :
      ∀ (A : Type (u + 1)) [CategoryTheory.Category.{u + 1, u + 1} A]
        [CategoryTheory.Abelian A] [CategoryTheory.HasExt.{u} A]
        (P : CategoryTheory.Functor A A)
        (hAdd : P.Additive)
        (hLim : CategoryTheory.Limits.PreservesFiniteLimits P)
        (hColim : CategoryTheory.Limits.PreservesFiniteColimits P)
        (U : A)
        (S_bar : CategoryTheory.ShortComplex A)
        (hS_bar : S_bar.ShortExact)
        (α_U : Quiver.Hom U (P.obj U))
        (α₁ : Quiver.Hom S_bar.X₁ (P.obj S_bar.X₁))
        (β₁ : Quiver.Hom (P.obj S_bar.X₁) S_bar.X₁)
        (α₂ : Quiver.Hom S_bar.X₂ (P.obj S_bar.X₂))
        (α₃ : Quiver.Hom S_bar.X₃ (P.obj S_bar.X₃))
        (β₃ : Quiver.Hom (P.obj S_bar.X₃) S_bar.X₃),
      CategoryTheory.CategoryStruct.comp α₁ β₁ =
        CategoryTheory.CategoryStruct.id S_bar.X₁ →
      CategoryTheory.CategoryStruct.comp β₃ α₃ =
        CategoryTheory.CategoryStruct.id (P.obj S_bar.X₃) →
      CategoryTheory.CategoryStruct.comp α₁ (P.map S_bar.f) =
        CategoryTheory.CategoryStruct.comp S_bar.f α₂ →
      CategoryTheory.CategoryStruct.comp α₂ (P.map S_bar.g) =
        CategoryTheory.CategoryStruct.comp S_bar.g α₃ →
      ∀ (f₃ : CategoryTheory.Abelian.Ext.{u} U S_bar.X₃ 0 →+
            CategoryTheory.Abelian.Ext.{u} U S_bar.X₃ 0)
        (f₁ : CategoryTheory.Abelian.Ext.{u} U S_bar.X₁ 1 →+
            CategoryTheory.Abelian.Ext.{u} U S_bar.X₁ 1),
        (∀ w : CategoryTheory.Abelian.Ext.{u} U S_bar.X₃ 0,
          f₃ w = (CategoryTheory.Abelian.Ext.mk₀ β₃).postcomp U (Nat.add_zero 0)
            ((CategoryTheory.Abelian.Ext.mk₀ α_U).comp
              ((@CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ P
                hAdd hLim hColim _ _ U S_bar.X₃ 0) w)
              (Nat.zero_add 0))) →
        (∀ v : CategoryTheory.Abelian.Ext.{u} U S_bar.X₁ 1,
          f₁ v = (CategoryTheory.Abelian.Ext.mk₀ β₁).postcomp U (Nat.add_zero 1)
            ((CategoryTheory.Abelian.Ext.mk₀ α_U).comp
              ((@CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ P
                hAdd hLim hColim _ _ U S_bar.X₁ 1) v)
              (Nat.zero_add 1))) →
        ∀ z : CategoryTheory.Abelian.Ext.{u} U S_bar.X₃ 0,
          f₁ (z.comp hS_bar.extClass (Nat.zero_add 1)) =
            (f₃ z).comp hS_bar.extClass (Nat.zero_add 1) := by
    intro A _ _ _ P hAdd hLim hColim U S_bar hS_bar α_U α₁ β₁ α₂ α₃ β₃
      hαβ₁ hβα₃ hcomm₁₂ hcomm₂₃ f₃ f₁ hf₃ hf₁ z
    let _ := hAdd
    let _ := hLim
    let _ := hColim
    have hS_P : (S_bar.map P).ShortExact := hS_bar.map_of_exact P
    let φ_α : S_bar ⟶ S_bar.map P :=
      { τ₁ := α₁
        τ₂ := α₂
        τ₃ := α₃
        comm₁₂ := hcomm₁₂
        comm₂₃ := hcomm₂₃ }
    let u := CategoryTheory.Abelian.Ext.mk₀ α_U
    let y := CategoryTheory.Abelian.Ext.mapExactFunctor P z
    let a₁ := CategoryTheory.Abelian.Ext.mk₀ α₁
    let b₁ := CategoryTheory.Abelian.Ext.mk₀ β₁
    let a₃ := CategoryTheory.Abelian.Ext.mk₀ α₃
    let b₃ := CategoryTheory.Abelian.Ext.mk₀ β₃
    let e := hS_bar.extClass
    let e_P := hS_P.extClass
    have h_nat_α : e.comp a₁ (Nat.add_zero 1) = a₃.comp e_P (Nat.zero_add 1) :=
      CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS_bar hS_P φ_α
    have h_nat : e_P.comp b₁ (Nat.add_zero 1) = b₃.comp e (Nat.zero_add 1) := by
      calc e_P.comp b₁ (Nat.add_zero 1)
          = ((CategoryTheory.Abelian.Ext.mk₀
              (CategoryTheory.CategoryStruct.id (P.obj S_bar.X₃))).comp e_P
              (Nat.zero_add 1)).comp b₁ (Nat.add_zero 1) := by
            rw [CategoryTheory.Abelian.Ext.mk₀_id_comp]
        _ = ((b₃.comp a₃ (Nat.add_zero 0)).comp e_P
              (Nat.zero_add 1)).comp b₁ (Nat.add_zero 1) := by
            rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hβα₃]
        _ = (b₃.comp (a₃.comp e_P (Nat.zero_add 1))
              (Nat.zero_add 1)).comp b₁ (Nat.add_zero 1) := by
            rw [CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero b₃ a₃ e_P
              (Nat.zero_add 1)]
        _ = (b₃.comp (e.comp a₁ (Nat.add_zero 1))
              (Nat.zero_add 1)).comp b₁ (Nat.add_zero 1) := by
            rw [← h_nat_α]
        _ = b₃.comp ((e.comp a₁ (Nat.add_zero 1)).comp b₁ (Nat.add_zero 1))
              (Nat.zero_add 1) :=
            CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero b₃
              (e.comp a₁ (Nat.add_zero 1)) b₁ (Nat.zero_add 1)
        _ = b₃.comp (e.comp (a₁.comp b₁ (Nat.add_zero 0)) (Nat.add_zero 1))
              (Nat.zero_add 1) := by
            rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero e a₁ b₁
              (Nat.add_zero 1)]
        _ = b₃.comp e (Nat.zero_add 1) := by
            rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hαβ₁,
              CategoryTheory.Abelian.Ext.comp_mk₀_id]
    have he_map : CategoryTheory.Abelian.Ext.mapExactFunctor P e = e_P :=
      CategoryTheory.Abelian.Ext.mapExactFunctor_extClass P hS_bar
    rw [hf₁ (z.comp e (Nat.zero_add 1)), hf₃ z]
    change (u.comp (CategoryTheory.Abelian.Ext.mapExactFunctor P (z.comp e (Nat.zero_add 1)))
        (Nat.zero_add 1)).comp b₁ (Nat.add_zero 1) =
      ((u.comp y (Nat.add_zero 0)).comp b₃ (Nat.add_zero 0)).comp e (Nat.zero_add 1)
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp P z e (Nat.zero_add 1), he_map]
    change (u.comp (y.comp e_P (Nat.zero_add 1)) (Nat.zero_add 1)).comp b₁ (Nat.add_zero 1) = _
    rw [← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero u y e_P (Nat.zero_add 1),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (u.comp y (Nat.add_zero 0)) e_P b₁ (Nat.zero_add 1),
      h_nat,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
        (u.comp y (Nat.add_zero 0)) b₃ e (Nat.zero_add 1)]

  rcases hf₁ with ⟨G₁, hG₁_obj, hG₁_map, hCont₁, hAdd, hLim, hColim,
    T₁, hT₁, μ₁, hT₁_l, hT₁_h, _, ν₁, hν₁, α₁, β₁, hαβ₁, _, hadj₁_raw, hf₁_eq⟩
  let _ := hCont₁
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  let B_pr : CategoryTheory.Functor Y₀.left.Etale S.Etale := weilEtaleSitePullback pr_Y
  let P := G₁.sheafPushforwardContinuous AddCommGrpCat.{u} J J
  let R_pr := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
    B_pr AddCommGrpCat.{u} _ J₀ J hCont_pr
  let adj_pr := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
    B_pr AddCommGrpCat.{u} _ J₀ J hCont_pr hAdj_pr
  let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let adj_const := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT₁
  let αℤ : Quiver.Hom Fℤ (P.obj Fℤ) :=
    (adj_const.homEquiv (AddCommGrpCat.of (ULift.{u} ℤ)) (P.obj Fℤ)).symm
      (CategoryTheory.CategoryStruct.comp
        (adj_const.unit.app (AddCommGrpCat.of (ULift.{u} ℤ)))
        (Fℤ.obj.map (Opposite.op μ₁)))

  let Θ_ν : CategoryTheory.NatTrans R_pr (CategoryTheory.Functor.comp P R_pr) :=
    { app := fun ℋ => CategoryTheory.ObjectProperty.homMk
        ({ app := fun W => ℋ.obj.map (Opposite.op (ν₁.app (Opposite.unop W)))
           naturality := fun {_ _} u =>
             (((ℋ.obj.map_comp _ _).symm.trans
               (congrArg ℋ.obj.map (CategoryTheory.op_comp.symm.trans
                 (congrArg Quiver.Hom.op (ν₁.naturality u.unop))))).trans
               ((congrArg ℋ.obj.map CategoryTheory.op_comp).trans
                 (ℋ.obj.map_comp _ _))).symm } :
          CategoryTheory.NatTrans (R_pr.obj ℋ).obj
            ((CategoryTheory.Functor.comp P R_pr).obj ℋ).obj)
      naturality := fun {_ _} φ =>
        CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun W =>
          (φ.hom.naturality (Opposite.op (ν₁.app (Opposite.unop W)))).symm)) }

  have hEt_ext : ∀ {U₁ U₂ : S.Etale} {k₁ k₂ : Quiver.Hom U₁ U₂},
      (Fgt.map k₁).left = (Fgt.map k₂).left → k₁ = k₂ :=
    fun h => Fgt.map_injective (CategoryTheory.Over.OverMorphism.ext h)

  have hCleanAdj : ∀ (ℱ₀ : CategoryTheory.Sheaf J₀ AddCommGrpCat.{u})
      (α' : Quiver.Hom (L_pr.obj ℱ₀) (P.obj (L_pr.obj ℱ₀))),
      (∀ W : Y₀.left.Etale,
        (adj_pr.homEquiv ℱ₀ (P.obj (L_pr.obj ℱ₀))
          (CategoryTheory.CategoryStruct.comp (CategoryTheory.Iso.refl (L_pr.obj ℱ₀)).hom α')).hom.app
          (Opposite.op W) =
        CategoryTheory.CategoryStruct.comp
          ((adj_pr.homEquiv ℱ₀ (L_pr.obj ℱ₀)
            (CategoryTheory.Iso.refl (L_pr.obj ℱ₀)).hom).hom.app (Opposite.op W))
          ((L_pr.obj ℱ₀).obj.map (Opposite.op (ν₁.app W)))) →
      adj_pr.homEquiv ℱ₀ (P.obj (L_pr.obj ℱ₀)) α' =
        CategoryTheory.CategoryStruct.comp (adj_pr.unit.app ℱ₀) (Θ_ν.app (L_pr.obj ℱ₀)) := by
    intro ℱ₀ α' hraw
    have h1 : adj_pr.homEquiv ℱ₀ (P.obj (L_pr.obj ℱ₀))
        (CategoryTheory.CategoryStruct.comp (CategoryTheory.Iso.refl (L_pr.obj ℱ₀)).hom α') =
      CategoryTheory.CategoryStruct.comp
        (adj_pr.homEquiv ℱ₀ (L_pr.obj ℱ₀) (CategoryTheory.Iso.refl (L_pr.obj ℱ₀)).hom)
        (Θ_ν.app (L_pr.obj ℱ₀)) :=
      CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun W =>
        hraw (Opposite.unop W)))
    exact (congrArg (adj_pr.homEquiv ℱ₀ (P.obj (L_pr.obj ℱ₀)))
      (CategoryTheory.Category.id_comp α')).symm.trans
      (h1.trans (congrArg (fun k => CategoryTheory.CategoryStruct.comp k (Θ_ν.app (L_pr.obj ℱ₀)))
        ((adj_pr.homEquiv_unit ℱ₀ (L_pr.obj ℱ₀)
            (CategoryTheory.CategoryStruct.id (L_pr.obj ℱ₀))).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp (adj_pr.unit.app ℱ₀))
              (R_pr.map_id (L_pr.obj ℱ₀))).trans
            (CategoryTheory.Category.comp_id (adj_pr.unit.app ℱ₀))))))

  have hadj₁ : adj_pr.homEquiv SC.X₁ (P.obj (L_pr.obj SC.X₁)) α₁ =
      CategoryTheory.CategoryStruct.comp (adj_pr.unit.app SC.X₁) (Θ_ν.app (L_pr.obj SC.X₁)) :=
    hCleanAdj SC.X₁ α₁ hadj₁_raw

  let α₂ : Quiver.Hom (L_pr.obj SC.X₂) (P.obj (L_pr.obj SC.X₂)) :=
    (adj_pr.homEquiv SC.X₂ (P.obj (L_pr.obj SC.X₂))).symm
      (CategoryTheory.CategoryStruct.comp (adj_pr.unit.app SC.X₂) (Θ_ν.app (L_pr.obj SC.X₂)))
  have hadj₂ : adj_pr.homEquiv SC.X₂ (P.obj (L_pr.obj SC.X₂)) α₂ =
      CategoryTheory.CategoryStruct.comp (adj_pr.unit.app SC.X₂) (Θ_ν.app (L_pr.obj SC.X₂)) :=
    (adj_pr.homEquiv SC.X₂ (P.obj (L_pr.obj SC.X₂))).apply_symm_apply _

  have hAlign₃ :
      ∃ (α₃ : Quiver.Hom (L_pr.obj SC.X₃) (P.obj (L_pr.obj SC.X₃)))
        (β₃ : Quiver.Hom (P.obj (L_pr.obj SC.X₃)) (L_pr.obj SC.X₃)),
        CategoryTheory.CategoryStruct.comp β₃ α₃ =
          CategoryTheory.CategoryStruct.id (P.obj (L_pr.obj SC.X₃)) ∧
        adj_pr.homEquiv SC.X₃ (P.obj (L_pr.obj SC.X₃)) α₃ =
          CategoryTheory.CategoryStruct.comp (adj_pr.unit.app SC.X₃) (Θ_ν.app (L_pr.obj SC.X₃)) ∧
        ∀ w : (L_pr.obj SC.X₃).H 0,
          f₃ w = (CategoryTheory.Abelian.Ext.mk₀ β₃).postcomp Fℤ (Nat.add_zero 0)
            ((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp
              ((@CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ P
                hAdd hLim hColim _ _ Fℤ (L_pr.obj SC.X₃) 0) w)
              (Nat.zero_add 0)) := by
    rcases hf₃ with ⟨G', hG'_obj, hG'_map, hCont', hAdd', hLim', hColim',
      T', hT', μ', hT'_l, hT'_h, _, ν', hν', α₃, β₃, _, hβα₃, hadj₃_raw, hf₃_eq⟩
    have hG_obj_eq : ∀ U : S.Etale, G'.obj U = G₁.obj U := fun U =>
      CategoryTheory.MorphismProperty.Comma.ext
        ((hG'_obj U).1.trans (hG₁_obj U).1.symm)
        (Subsingleton.elim _ _)
        ((hG'_obj U).2.trans (hG₁_obj U).2.symm)
    have hG_eq : G' = G₁ := by
      refine @CategoryTheory.Functor.ext _ _ _ _ G' G₁ hG_obj_eq ?_
      intro U₁ U₂ u
      apply hEt_ext
      let FgtL := CategoryTheory.Functor.comp Fgt (CategoryTheory.Over.forget S)
      change FgtL.map (G'.map u) =
        FgtL.map (CategoryTheory.CategoryStruct.comp
          (CategoryTheory.eqToHom (hG_obj_eq U₁))
          (CategoryTheory.CategoryStruct.comp (G₁.map u)
            (CategoryTheory.eqToHom (hG_obj_eq U₂).symm)))
      rw [FgtL.map_comp, FgtL.map_comp,
        CategoryTheory.eqToHom_map, CategoryTheory.eqToHom_map]
      exact eq_of_heq (((hG'_map u).trans (hG₁_map u).symm).trans
        ((CategoryTheory.comp_eqToHom_heq _ _).symm.trans
          (CategoryTheory.eqToHom_comp_heq _ _).symm))
    subst G'
    have hCont_eq : hCont' = hCont₁ := Subsingleton.elim _ _
    subst hCont'
    have hAdd_eq : hAdd' = hAdd := Subsingleton.elim _ _
    subst hAdd'
    have hLim_eq : hLim' = hLim := Subsingleton.elim _ _
    subst hLim'
    have hColim_eq : hColim' = hColim := Subsingleton.elim _ _
    subst hColim'
    have hT_eq : T' = T₁ :=
      CategoryTheory.MorphismProperty.Comma.ext
        (hT'_l.trans hT₁_l.symm) (Subsingleton.elim _ _) (hT'_h.trans hT₁_h.symm)
    subst T'
    have hterm_eq : hT' = hT₁ :=
      (@CategoryTheory.Limits.IsLimit.subsingleton _ _ _ _ _).elim hT' hT₁
    subst hT'
    have hμ_eq : μ' = μ₁ := CategoryTheory.Limits.IsTerminal.hom_ext hT₁ μ' μ₁
    subst μ'
    have hν_eq : ∀ W : Y₀.left.Etale, ν'.app W = ν₁.app W := by
      intro W
      apply hEt_ext
      exact CategoryTheory.Limits.pullback.hom_ext
        (eq_of_heq (((hν' W).1).trans ((hν₁ W).1).symm))
        (eq_of_heq (((hν' W).2).trans ((hν₁ W).2).symm))
    refine ⟨α₃, β₃, hβα₃, hCleanAdj SC.X₃ α₃ (fun W => ?_), hf₃_eq⟩
    rw [← hν_eq W]
    exact hadj₃_raw W

  obtain ⟨α₃, β₃, hβα₃, hadj₃, hf₃_eq⟩ := hAlign₃

  have hcomm₁₂ : CategoryTheory.CategoryStruct.comp α₁ (P.map (SC.map L_pr).f) =
      CategoryTheory.CategoryStruct.comp (SC.map L_pr).f α₂ :=
    hPillar_Mate (CategoryTheory.Sheaf J₀ AddCommGrpCat.{u})
      (CategoryTheory.Sheaf J AddCommGrpCat.{u})
      L_pr R_pr adj_pr P Θ_ν SC.X₁ SC.X₂ SC.f α₁ α₂ hadj₁ hadj₂

  have hcomm₂₃ : CategoryTheory.CategoryStruct.comp α₂ (P.map (SC.map L_pr).g) =
      CategoryTheory.CategoryStruct.comp (SC.map L_pr).g α₃ :=
    hPillar_Mate (CategoryTheory.Sheaf J₀ AddCommGrpCat.{u})
      (CategoryTheory.Sheaf J AddCommGrpCat.{u})
      L_pr R_pr adj_pr P Θ_ν SC.X₂ SC.X₃ SC.g α₂ α₃ hadj₂ hadj₃

  exact hPillar_Ext (CategoryTheory.Sheaf J AddCommGrpCat.{u})
    P hAdd hLim hColim Fℤ (SC.map L_pr) hSC_bar αℤ α₁ β₁ α₂ α₃ β₃
    hαβ₁ hβα₃ hcomm₁₂ hcomm₂₃ f₃ f₁ hf₃_eq hf₁_eq z

theorem weil_mid_dev_p1_isotropic_skyscraper_bound (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (hu₀_mem : Set.range u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (M_Zu_mid : WeilEllAdicCohomologyModel F Z_u₀ ℓ (2 * m + 1))
    (D : WeilMidDevSmoothMonodromyPackage.{u} F m Z_tilde f₀ u₀ Z_u₀ j_aff S_aff U₀ ℓ M_Zu_mid)
    (E_push : WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ 1
      (fun r => weilEtaleHigherDirectImage U₀.ι 0 (D.𝒱₀ r))
      (fun r => weilEtaleHigherDirectImageMap U₀.ι 0 (D.τ_𝒱 r)))
    (γ' : AlgebraicClosure (Padic ℓ))
    (hγ'_push : γ' ∈ ((E_push.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)))
    (E_perp : Submodule (Padic ℓ) (Fin D.N → Padic ℓ))
    (w_inf : Fin D.N → Padic ℓ) (w_aff : F → (Fin D.N → Padic ℓ))
    (hE_perp_eq : ∀ x : Fin D.N → Padic ℓ,
      x ∈ E_perp ↔ dotProduct x (D.J_V.mulVec w_inf) = 0)
    (hGV_perp : ∀ g ∈ D.G_V, ∀ x ∈ E_perp,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x = x)
    (hGV_quot_iso : ∀ g ∈ D.G_V, ∀ x : Fin D.N → Padic ℓ,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x - x ∈ E_perp)
    (hFVu_perp : ∀ x ∈ E_perp,
      ((D.F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x ∈ E_perp)
    (hInert_perp : ∀ r : ℕ,
      letI := D.hCR r; letI := D.hFld r; letI := D.hAF_L r; letI := D.hAP_L r
      letI := D.hARF_L r; letI := D.hABL r; letI := D.hAR_B r
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      let C₀_r := integralClosure (Polynomial F) (D.L_V r)
      let A_inf_r := Algebra.adjoin F
        ({algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹} : Set (D.L_V r))
      let t_inf_r : ↥A_inf_r :=
        ⟨algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹, Algebra.self_mem_adjoin_singleton F _⟩
      let C_inf_r := integralClosure ↥A_inf_r (D.L_V r)
      (∀ a ∈ S_aff, ∀ Q : Ideal ↥C₀_r, Q.IsPrime →
        Ideal.comap (algebraMap (Polynomial F) ↥C₀_r) Q =
          Ideal.span {Polynomial.X - Polynomial.C a} →
        ∀ (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r) (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
          (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) →
          (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
            algebraMap (D.B_V r) (D.L_V r) (σ_B b)) →
