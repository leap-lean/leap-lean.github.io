                      have hcond : snd₂ ≫ ι_Y = fst₂ ≫ h₂ :=
                        CategoryTheory.Limits.pullback.condition.symm
                      rw [Category.assoc, hcond, ← Category.assoc, hl₂_fst,
                        CategoryTheory.Over.w (Fgt_Y.map (w ≫ u))]) trivial
              have h_rhs := hpsi_spec U₂ t (w ≫ u) ((𝒢.obj.map q_Z.op).hom (g_c c))
