      obtain ⟨τ₀, hτ₀_comm, hτ₀_cast⟩ := (hι_compat r).2 τ'
      obtain ⟨σ_B, hσ_comm, hσ_ρ⟩ := (hρ_spec r).2.2.1 τ₀
