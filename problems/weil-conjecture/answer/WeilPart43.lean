              obtain ⟨hj_1, _⟩ := hYLevel U t₁ W₀ hW₀_top hW₀_z1
              obtain ⟨hj_2, _⟩ := hYLevel U t₂ W₀ hW₀_top hW₀_z2
              dsimp [mor_add]; rw [hj_12, hj_1, hj_2, hpsi_zero, add_zero]
            · obtain ⟨_, hu_12⟩ := hYLevel U (t₁ + t₂) W₀ hW₀_top hW₀_z12
              obtain ⟨_, hu_1⟩ := hYLevel U t₁ W₀ hW₀_top hW₀_z1
              obtain ⟨_, hu_2⟩ := hYLevel U t₂ W₀ hW₀_top hW₀_z2
              let E_p := obj_add (Sum.inr (c₁, c₂))
              let u_p := mor_add (Sum.inr (c₁, c₂))
              let l_p : (Fgt_Y.obj E_p).left ⟶ U_V := (O_pair (c₁, c₂)).ι
              let q_p : E_p ⟶ E₀ :=
                CategoryTheory.MorphismProperty.Over.homMk (l_p ≫ snd_U)
