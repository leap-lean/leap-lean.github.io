                 ∀ y : ↥W_r, f (m_σ.base y) = ((ρ_C σ).val).mulVec (f y) })) ∧
          SC₁.X₁ = weilEtaleHigherDirectImage U₀.ι 0 𝒫_r ∧
          SC₁.X₂ = weilEtaleHigherDirectImage U₀.ι 0 𝒱_r ∧
          SC₁.X₃ = ℱ_r ∧
          SC₁.ShortExact ∧
          SC₂.X₁ = ℱ_r ∧
          SC₂.X₂ = weilEtaleHigherDirectImage U₀.ι 0 𝒞_r ∧
          SC₂.X₃ = 𝒮_r ∧
          SC₂.ShortExact ∧
          (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id 𝒮_r = 0 ∧
          (∀ W : (weilProjectiveSpaceOver F 1).left.Etale,
            Set.range ((AlgebraicGeometry.Scheme.Etale.forget
              (weilProjectiveSpaceOver F 1).left).obj W).hom.base ⊆
              (U₀ : Set (weilProjectiveSpaceOver F 1).left) →
            Subsingleton ↑(𝒮_r.obj.obj (Opposite.op W))) :=
by
  classical
  subst hSum
  intro R₀ B_r L_r _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
    ρ_V_r e_U 𝒱_r triv_V ⟨hNat_V, hInjRange_V⟩ P_mod hTrig
  let Λ := ZMod (ℓ ^ (r + 1))
  let Γ := (B_r ≃ₐ[R₀] B_r)
  let D₀ := weilProjectiveSpaceOver F 1

  
  have hPinv_mul_P : (P_mod⁻¹).val * P_mod.val = 1 := by
    rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
  have hP_mul_Pinv : P_mod.val * (P_mod⁻¹).val = 1 := by
    rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
  let A_mat : Γ → Matrix (Fin (M₀ + 1)) (Fin (M₀ + 1)) Λ :=
    fun τ => (P_mod⁻¹).val * (ρ_V_r τ).val * P_mod.val
  have hA_one : A_mat 1 = 1 := by
    change (P_mod⁻¹).val * (ρ_V_r 1).val * P_mod.val = 1
    rw [map_one, Units.val_one, mul_one, hPinv_mul_P]
  have hA_mul : ∀ τ₁ τ₂ : Γ, A_mat (τ₁ * τ₂) = A_mat τ₁ * A_mat τ₂ := by
    intro τ₁ τ₂
    change (P_mod⁻¹).val * (ρ_V_r (τ₁ * τ₂)).val * P_mod.val =
      ((P_mod⁻¹).val * (ρ_V_r τ₁).val * P_mod.val) *
        ((P_mod⁻¹).val * (ρ_V_r τ₂).val * P_mod.val)
    rw [map_mul, Units.val_mul]
    calc (P_mod⁻¹).val * ((ρ_V_r τ₁).val * (ρ_V_r τ₂).val) * P_mod.val
        = (P_mod⁻¹).val * (ρ_V_r τ₁).val * 1 * (ρ_V_r τ₂).val * P_mod.val := by
            simp [mul_assoc]
      _ = (P_mod⁻¹).val * (ρ_V_r τ₁).val * (P_mod.val * (P_mod⁻¹).val) *
            (ρ_V_r τ₂).val * P_mod.val := by rw [hP_mul_Pinv]
      _ = ((P_mod⁻¹).val * (ρ_V_r τ₁).val * P_mod.val) *
            ((P_mod⁻¹).val * (ρ_V_r τ₂).val * P_mod.val) := by simp [mul_assoc]
  have hA_bot : ∀ (τ : Γ) (j : Fin M₀), A_mat τ (Fin.last M₀) j.castSucc = 0 := by
    intro τ j
    have hlast : (Fin.last M₀ : Fin (M₀ + 1)) = ⟨M₀, by omega⟩ := Fin.ext rfl
    rw [hlast]
    exact hTrig τ j.castSucc j.2
  let B_P : Γ → Matrix (Fin M₀) (Fin M₀) Λ :=
    fun τ i j => A_mat τ i.castSucc j.castSucc
  let B_C : Γ → Matrix (Fin 1) (Fin 1) Λ :=
    fun τ _ _ => A_mat τ (Fin.last M₀) (Fin.last M₀)
  have hBP_one : B_P 1 = 1 := by
    ext i j
    change A_mat 1 i.castSucc j.castSucc = (1 : Matrix (Fin M₀) (Fin M₀) Λ) i j
    rw [hA_one]
    simp [Matrix.one_apply, Fin.castSucc_inj]
  have hBC_one : B_C 1 = 1 := by
    ext a b
    change A_mat 1 (Fin.last M₀) (Fin.last M₀) = (1 : Matrix (Fin 1) (Fin 1) Λ) a b
    rw [hA_one, Fin.eq_zero a, Fin.eq_zero b]
    simp
  have hBP_mul : ∀ τ₁ τ₂ : Γ, B_P (τ₁ * τ₂) = B_P τ₁ * B_P τ₂ := by
    intro τ₁ τ₂
    ext i j
    change A_mat (τ₁ * τ₂) i.castSucc j.castSucc = ∑ k : Fin M₀, B_P τ₁ i k * B_P τ₂ k j
    rw [hA_mul, Matrix.mul_apply, Fin.sum_univ_castSucc, hA_bot τ₂ j, mul_zero, add_zero]
  have hBC_mul : ∀ τ₁ τ₂ : Γ, B_C (τ₁ * τ₂) = B_C τ₁ * B_C τ₂ := by
    intro τ₁ τ₂
    ext a b
    change A_mat (τ₁ * τ₂) (Fin.last M₀) (Fin.last M₀) = ∑ k : Fin 1, B_C τ₁ a k * B_C τ₂ k b
    rw [hA_mul, Matrix.mul_apply, Fin.sum_univ_castSucc, Fin.sum_univ_one]
    have h0 : (∑ k : Fin M₀, A_mat τ₁ (Fin.last M₀) k.castSucc *
        A_mat τ₂ k.castSucc (Fin.last M₀)) = 0 :=
      Finset.sum_eq_zero fun k _ => by rw [hA_bot τ₁ k, zero_mul]
    rw [h0, zero_add]
  let ρ_P : Γ →* (Matrix (Fin M₀) (Fin M₀) Λ)ˣ :=
    { toFun := fun τ =>
        { val := B_P τ
          inv := B_P τ⁻¹
          val_inv := by rw [← hBP_mul, mul_inv_cancel, hBP_one]
          inv_val := by rw [← hBP_mul, inv_mul_cancel, hBP_one] }
      map_one' := Units.ext hBP_one
      map_mul' := fun τ₁ τ₂ => Units.ext (hBP_mul τ₁ τ₂) }
  let ρ_C : Γ →* (Matrix (Fin 1) (Fin 1) Λ)ˣ :=
    { toFun := fun τ =>
        { val := B_C τ
          inv := B_C τ⁻¹
          val_inv := by rw [← hBC_mul, mul_inv_cancel, hBC_one]
          inv_val := by rw [← hBC_mul, inv_mul_cancel, hBC_one] }
      map_one' := Units.ext hBC_one
      map_mul' := fun τ₁ τ₂ => Units.ext (hBC_mul τ₁ τ₂) }
  have hρP_val : ∀ (τ : Γ) (i j : Fin M₀),
      (ρ_P τ).val i j = A_mat τ ⟨i.1, by omega⟩ ⟨j.1, by omega⟩ := by
    intro τ i j
    have hi : (⟨i.1, by omega⟩ : Fin (M₀ + 1)) = i.castSucc := Fin.ext rfl
    have hj : (⟨j.1, by omega⟩ : Fin (M₀ + 1)) = j.castSucc := Fin.ext rfl
    rw [hi, hj]
    rfl
  have hρC_val : ∀ τ : Γ, (ρ_C τ).val 0 0 = A_mat τ ⟨M₀, by omega⟩ ⟨M₀, by omega⟩ := by
    intro τ
    have hlast : (⟨M₀, by omega⟩ : Fin (M₀ + 1)) = Fin.last M₀ := Fin.ext rfl
    rw [hlast]
    rfl

  let pad_P : (Fin M₀ → Λ) →+ (Fin (M₀ + 1) → Λ) :=
    { toFun := fun u k => if hk : k.1 < M₀ then u ⟨k.1, hk⟩ else 0
      map_zero' := by ext k; dsimp; split_ifs <;> rfl
      map_add' := fun u₁ u₂ => by ext k; dsimp; split_ifs <;> simp }
  let pad_C : (Fin 1 → Λ) →+ (Fin (M₀ + 1) → Λ) :=
    { toFun := fun w k => if k.1 < M₀ then 0 else w 0
      map_zero' := by ext k; dsimp; split_ifs <;> rfl
      map_add' := fun w₁ w₂ => by ext k; dsimp; split_ifs <;> simp }
  let emb_P : (Fin M₀ → Λ) →+ (Fin (M₀ + 1) → Λ) :=
    (P_mod.val.mulVecLin).toAddMonoidHom.comp pad_P
  let unemb_P : (Fin (M₀ + 1) → Λ) →+ (Fin M₀ → Λ) :=
    { toFun := fun v i => ((P_mod⁻¹).val.mulVec v) i.castSucc
      map_zero' := by ext i; simp [Matrix.mulVec_zero]
      map_add' := fun v₁ v₂ => by ext i; simp [Matrix.mulVec_add] }
  let proj_C : (Fin (M₀ + 1) → Λ) →+ (Fin 1 → Λ) :=
    { toFun := fun v _ => ((P_mod⁻¹).val.mulVec v) (Fin.last M₀)
      map_zero' := by ext a; simp [Matrix.mulVec_zero]
      map_add' := fun v₁ v₂ => by ext a; simp [Matrix.mulVec_add] }
  let sec_C : (Fin 1 → Λ) →+ (Fin (M₀ + 1) → Λ) :=
    (P_mod.val.mulVecLin).toAddMonoidHom.comp pad_C

  have hPinv_P : ∀ x : Fin (M₀ + 1) → Λ,
      (P_mod⁻¹).val.mulVec (P_mod.val.mulVec x) = x := fun x => by
    rw [Matrix.mulVec_mulVec, hPinv_mul_P, Matrix.one_mulVec]
  have hP_Pinv : ∀ x : Fin (M₀ + 1) → Λ,
      P_mod.val.mulVec ((P_mod⁻¹).val.mulVec x) = x := fun x => by
    rw [Matrix.mulVec_mulVec, hP_mul_Pinv, Matrix.one_mulVec]
  have hpadP_cast : ∀ (u : Fin M₀ → Λ) (i : Fin M₀), pad_P u i.castSucc = u i := by
    intro u i
    change (if hk : i.1 < M₀ then u ⟨i.1, hk⟩ else 0) = u i
    simp [i.2]
  have hpadP_last : ∀ u : Fin M₀ → Λ, pad_P u (Fin.last M₀) = 0 := by
    intro u
    change (if hk : M₀ < M₀ then u ⟨M₀, hk⟩ else 0) = 0
    simp
  have hunemb_emb : ∀ u : Fin M₀ → Λ, unemb_P (emb_P u) = u := by
    intro u; ext i
    change ((P_mod⁻¹).val.mulVec (P_mod.val.mulVec (pad_P u))) i.castSucc = u i
    rw [hPinv_P, hpadP_cast]
  have hproj_emb : ∀ u : Fin M₀ → Λ, proj_C (emb_P u) = 0 := by
    intro u; ext a
    change ((P_mod⁻¹).val.mulVec (P_mod.val.mulVec (pad_P u))) (Fin.last M₀) = 0
    rw [hPinv_P, hpadP_last]
  have hemb_unemb : ∀ v : Fin (M₀ + 1) → Λ, proj_C v = 0 → emb_P (unemb_P v) = v := by
    intro v hv
    have hv_last : ((P_mod⁻¹).val.mulVec v) (Fin.last M₀) = 0 := congrFun hv 0
    have hpad_eq : pad_P (unemb_P v) = (P_mod⁻¹).val.mulVec v := by
      ext k
      by_cases hk : k.1 < M₀
      · change (if h : k.1 < M₀ then unemb_P v ⟨k.1, h⟩ else 0) = _
        simp only [hk, ↓reduceDIte]
        change ((P_mod⁻¹).val.mulVec v) (⟨k.1, hk⟩ : Fin M₀).castSucc = _
        have hk_eq : (⟨k.1, hk⟩ : Fin M₀).castSucc = k := Fin.ext rfl
        rw [hk_eq]
      · have hk_last : k = Fin.last M₀ := Fin.ext (by simp only [Fin.val_last]; have := k.2; omega)
        rw [hk_last, hpadP_last, hv_last]
    change P_mod.val.mulVec (pad_P (unemb_P v)) = v
    rw [hpad_eq, hP_Pinv]
  have hproj_sec : ∀ w : Fin 1 → Λ, proj_C (sec_C w) = w := by
    intro w; ext a
    rw [Fin.eq_zero a]
    change ((P_mod⁻¹).val.mulVec (P_mod.val.mulVec (pad_C w))) (Fin.last M₀) = w 0
    rw [hPinv_P]
    change (if M₀ < M₀ then 0 else w 0) = w 0
    simp
  have hemb_equiv : ∀ (σ : Γ) (u : Fin M₀ → Λ),
      ((ρ_V_r σ).val).mulVec (emb_P u) = emb_P (((ρ_P σ).val).mulVec u) := by
    intro σ u
    have hconj : (ρ_V_r σ).val * P_mod.val = P_mod.val * A_mat σ := by
      calc (ρ_V_r σ).val * P_mod.val
          = 1 * ((ρ_V_r σ).val * P_mod.val) := (one_mul _).symm
        _ = (P_mod.val * (P_mod⁻¹).val) * ((ρ_V_r σ).val * P_mod.val) := by rw [hP_mul_Pinv]
        _ = P_mod.val * A_mat σ := by dsimp only [A_mat]; simp [mul_assoc]
    change ((ρ_V_r σ).val).mulVec (P_mod.val.mulVec (pad_P u)) =
      P_mod.val.mulVec (pad_P (((ρ_P σ).val).mulVec u))
    rw [Matrix.mulVec_mulVec, hconj, ← Matrix.mulVec_mulVec]
    congr 1
    ext k
    rw [Matrix.mulVec, dotProduct, Fin.sum_univ_castSucc, hpadP_last u, mul_zero, add_zero]
    simp_rw [hpadP_cast u]
    by_cases hk : k.1 < M₀
    · have hk_eq : k = (⟨k.1, hk⟩ : Fin M₀).castSucc := Fin.ext rfl
      rw [hk_eq, hpadP_cast]
      rfl
    · have hk_last : k = Fin.last M₀ := Fin.ext (by simp only [Fin.val_last]; have := k.2; omega)
      rw [hk_last, hpadP_last]
      exact Finset.sum_eq_zero fun j _ => by rw [hA_bot σ j, zero_mul]
  have hproj_equiv : ∀ (σ : Γ) (v : Fin (M₀ + 1) → Λ),
      proj_C (((ρ_V_r σ).val).mulVec v) = ((ρ_C σ).val).mulVec (proj_C v) := by
    intro σ v
    ext a
    rw [Fin.eq_zero a]
    set v' := (P_mod⁻¹).val.mulVec v
    have hv_eq : v = P_mod.val.mulVec v' := (hP_Pinv v).symm
    change ((P_mod⁻¹).val.mulVec (((ρ_V_r σ).val).mulVec v)) (Fin.last M₀) =
      (((ρ_C σ).val).mulVec (proj_C v)) 0
    conv_lhs => rw [hv_eq]
    rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec]
    change (A_mat σ).mulVec v' (Fin.last M₀) = (((ρ_C σ).val).mulVec (proj_C v)) 0
    rw [Matrix.mulVec, dotProduct, Fin.sum_univ_castSucc]
    have h0 : (∑ j : Fin M₀, A_mat σ (Fin.last M₀) j.castSucc * v' j.castSucc) = 0 :=
      Finset.sum_eq_zero fun j _ => by rw [hA_bot σ j, zero_mul]
    rw [h0, zero_add, Matrix.mulVec, dotProduct, Fin.sum_univ_one]
    rfl

  
  obtain ⟨hIdemp_all, hR₀_all, _⟩ := weil_etale_galois_domain_idempotents_and_aut_lift
  obtain ⟨hDom_R₀, instAlg_R₀_RF, hR₀_RF_rest⟩ := hR₀_all F S_aff
  have : IsDomain R₀ := hDom_R₀
  letI : Algebra R₀ (RatFunc F) := instAlg_R₀_RF
  obtain ⟨hFrac_R₀_RF, hST_R₀_RF_all⟩ := hR₀_RF_rest
  have : IsFractionRing R₀ (RatFunc F) := hFrac_R₀_RF
  have : IsScalarTower R₀ (RatFunc F) L_r := hST_R₀_RF_all B_r L_r
  obtain ⟨hInj_RB, m_Γ, equiv_Γ, e_idemp, hIdemp, hOrth, hSum_e, hEval_e, hAbsorb_e⟩ :=
    hIdemp_all R₀ B_r (RatFunc F) L_r
  obtain ⟨⟨hπ_et, hπ_surj⟩, hTorsor, hSheets⟩ :=
    weil_scheme_galois_torsor_clopen_sheets R₀ B_r hInj_RB m_Γ equiv_Γ e_idemp
      hIdemp hOrth hSum_e hEval_e hAbsorb_e U₀.toScheme e_U
  let V_r := AlgebraicGeometry.Spec (CommRingCat.of B_r)
  let π_r : V_r ⟶ U₀.toScheme :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r)) ≫ e_U.hom
  obtain ⟨hMem_all, hContAdj_all, hConst_all⟩ :=
    weil_etale_constant_sheaf_locallyConstant_equiv_and_pullback_adj
  have hMem_U := hMem_all U₀.toScheme
  have hMem_V := hMem_all V_r
  have hMem_D := hMem_all D₀.left
  obtain ⟨hCont_π, hAdj_π⟩ := hContAdj_all V_r U₀.toScheme π_r
  let A_P : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin M₀ → Λ))
  let A_C : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin 1 → Λ))
  obtain ⟨hT_VP, θ_VP, hθP_bij, hθP_nat, hθP_unit⟩ := hConst_all V_r A_P
  obtain ⟨hT_VC, θ_VC, hθC_bij, hθC_nat, hθC_unit⟩ := hConst_all V_r A_C
  obtain ⟨𝒫_r, triv_P, _, hNat_P, hInjRange_P⟩ :=
    weil_etale_galois_rep_sheaf_and_pullback_iso R₀ B_r U₀.toScheme e_U
      hπ_et hπ_surj hSheets hMem_U hMem_V hCont_π hAdj_π M₀ Λ ρ_P
      hT_VP θ_VP hθP_bij hθP_nat hθP_unit
  obtain ⟨𝒞_r, triv_C, _, hNat_C, hInjRange_C⟩ :=
    weil_etale_galois_rep_sheaf_and_pullback_iso R₀ B_r U₀.toScheme e_U
      hπ_et hπ_surj hSheets hMem_U hMem_V hCont_π hAdj_π 1 Λ ρ_C
      hT_VC θ_VC hθC_bij hθC_nat hθC_unit

  
  let FgtU := AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme
  let FgtD := AlgebraicGeometry.Scheme.Etale.forget D₀.left
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let zHom : ∀ {G : AddCommGrpCat.{u}} (_ : ↑G), Aℤ ⟶ G := fun g =>
    AddCommGrpCat.ofHom
      { toFun := fun n => n.down • g
        map_zero' := zero_zsmul g
        map_add' := fun a b => add_zsmul g a.down b.down }

  let u_can : ∀ {W₁ W₂ : U₀.toScheme.Etale} (u : W₁ ⟶ W₂),
      CategoryTheory.Limits.pullback (FgtU.obj W₁).hom π_r ⟶
        CategoryTheory.Limits.pullback (FgtU.obj W₂).hom π_r :=
    fun {W₁ W₂} u =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (FgtU.obj W₁).hom π_r ≫ (FgtU.map u).left)
        (CategoryTheory.Limits.pullback.snd (FgtU.obj W₁).hom π_r)
        (by rw [CategoryTheory.Category.assoc, (FgtU.map u).w,
              CategoryTheory.Limits.pullback.condition])

  have hι_mem : ∀ (W : U₀.toScheme.Etale) (s₁ : ↑(𝒫_r.obj.obj (Opposite.op W))),
      (LocallyConstant.mapAddMonoidHom emb_P) (triv_P W s₁) ∈ Set.range (triv_V W) := by
    intro W s₁
    rw [(hInjRange_V W).2]
    intro σ m_σ hm_fst hm_snd y
    have hs₁_eq : (triv_P W s₁) (m_σ.base y) = ((ρ_P σ).val).mulVec ((triv_P W s₁) y) := by
      have hmem : triv_P W s₁ ∈ Set.range (triv_P W) := ⟨s₁, rfl⟩
      rw [(hInjRange_P W).2] at hmem
      exact hmem σ m_σ hm_fst hm_snd y
    change emb_P ((triv_P W s₁) (m_σ.base y)) =
      ((ρ_V_r σ).val).mulVec (emb_P ((triv_P W s₁) y))
    rw [hs₁_eq, hemb_equiv]
  let ι_fun : ∀ (W : U₀.toScheme.Etale),
      ↑(𝒫_r.obj.obj (Opposite.op W)) → ↑(𝒱_r.obj.obj (Opposite.op W)) :=
    fun W s₁ => Classical.choose (hι_mem W s₁)
  have hι_spec : ∀ (W : U₀.toScheme.Etale) (s₁ : ↑(𝒫_r.obj.obj (Opposite.op W))),
      triv_V W (ι_fun W s₁) = (LocallyConstant.mapAddMonoidHom emb_P) (triv_P W s₁) :=
    fun W s₁ => Classical.choose_spec (hι_mem W s₁)
  let ι_P : 𝒫_r ⟶ 𝒱_r :=
    { hom :=
        { app := fun W_op => AddCommGrpCat.ofHom
            { toFun := ι_fun W_op.unop
              map_zero' := (hInjRange_V W_op.unop).1 <| by
                rw [hι_spec, map_zero, map_zero, map_zero]
              map_add' := fun a b => (hInjRange_V W_op.unop).1 <| by
                rw [hι_spec, map_add, map_add, map_add, hι_spec, hι_spec] }
          naturality := fun {W₂_op W₁_op} u_op => by
            let W₁ := W₁_op.unop
            let W₂ := W₂_op.unop
            let u : W₁ ⟶ W₂ := u_op.unop
            apply AddCommGrpCat.ext
            intro s₂
            apply (hInjRange_V W₁).1
            apply LocallyConstant.ext
            intro y₁
            have h1 : triv_V W₁ (ι_fun W₁ ((𝒫_r.obj.map (Opposite.op u)).hom s₂)) y₁ =
                emb_P (triv_P W₁ ((𝒫_r.obj.map (Opposite.op u)).hom s₂) y₁) := by
              rw [hι_spec]; rfl
            have h2 := hNat_P u (u_can u)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _) s₂ y₁
            have h3 := hNat_V u (u_can u)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _) (ι_fun W₂ s₂) y₁
            have h4 : triv_V W₂ (ι_fun W₂ s₂) ((u_can u).base y₁) =
                emb_P (triv_P W₂ s₂ ((u_can u).base y₁)) := by
              rw [hι_spec]; rfl
            exact (h1.trans (congrArg emb_P h2)).trans (h3.trans h4).symm } }

  have hπ_mem : ∀ (W : U₀.toScheme.Etale) (s₂ : ↑(𝒱_r.obj.obj (Opposite.op W))),
      (LocallyConstant.mapAddMonoidHom proj_C) (triv_V W s₂) ∈ Set.range (triv_C W) := by
    intro W s₂
    rw [(hInjRange_C W).2]
    intro σ m_σ hm_fst hm_snd y
    have hs₂_eq : (triv_V W s₂) (m_σ.base y) = ((ρ_V_r σ).val).mulVec ((triv_V W s₂) y) := by
      have hmem : triv_V W s₂ ∈ Set.range (triv_V W) := ⟨s₂, rfl⟩
      rw [(hInjRange_V W).2] at hmem
      exact hmem σ m_σ hm_fst hm_snd y
    change proj_C ((triv_V W s₂) (m_σ.base y)) =
      ((ρ_C σ).val).mulVec (proj_C ((triv_V W s₂) y))
    rw [hs₂_eq, hproj_equiv]
  let π_fun : ∀ (W : U₀.toScheme.Etale),
      ↑(𝒱_r.obj.obj (Opposite.op W)) → ↑(𝒞_r.obj.obj (Opposite.op W)) :=
    fun W s₂ => Classical.choose (hπ_mem W s₂)
  have hπ_spec : ∀ (W : U₀.toScheme.Etale) (s₂ : ↑(𝒱_r.obj.obj (Opposite.op W))),
      triv_C W (π_fun W s₂) = (LocallyConstant.mapAddMonoidHom proj_C) (triv_V W s₂) :=
    fun W s₂ => Classical.choose_spec (hπ_mem W s₂)
  let π_C : 𝒱_r ⟶ 𝒞_r :=
    { hom :=
        { app := fun W_op => AddCommGrpCat.ofHom
            { toFun := π_fun W_op.unop
              map_zero' := (hInjRange_C W_op.unop).1 <| by
                rw [hπ_spec, map_zero, map_zero, map_zero]
              map_add' := fun a b => (hInjRange_C W_op.unop).1 <| by
                rw [hπ_spec, map_add, map_add, map_add, hπ_spec, hπ_spec] }
          naturality := fun {W₂_op W₁_op} u_op => by
            let W₁ := W₁_op.unop
            let W₂ := W₂_op.unop
            let u : W₁ ⟶ W₂ := u_op.unop
            apply AddCommGrpCat.ext
            intro s₂
            apply (hInjRange_C W₁).1
            apply LocallyConstant.ext
            intro y₁
            have h1 : triv_C W₁ (π_fun W₁ ((𝒱_r.obj.map (Opposite.op u)).hom s₂)) y₁ =
                proj_C (triv_V W₁ ((𝒱_r.obj.map (Opposite.op u)).hom s₂) y₁) := by
              rw [hπ_spec]; rfl
            have h2 := hNat_V u (u_can u)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _) s₂ y₁
            have h3 := hNat_C u (u_can u)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _) (π_fun W₂ s₂) y₁
            have h4 : triv_C W₂ (π_fun W₂ s₂) ((u_can u).base y₁) =
                proj_C (triv_V W₂ s₂ ((u_can u).base y₁)) := by
              rw [hπ_spec]; rfl
            exact (h1.trans (congrArg proj_C h2)).trans (h3.trans h4).symm } }

  have h0_U : ι_P ≫ π_C = 0 := by
    apply CategoryTheory.Sheaf.hom_ext
    ext W_op s₁
    apply (hInjRange_C W_op.unop).1
    change triv_C W_op.unop (π_fun W_op.unop (ι_fun W_op.unop s₁)) = triv_C W_op.unop 0
    rw [hπ_spec, hι_spec, map_zero]
    apply LocallyConstant.ext
    intro y
    exact hproj_emb (triv_P W_op.unop s₁ y)

  have hι_app_inj : ∀ W : U₀.toScheme.Etale,
      Function.Injective ((ι_P.hom.app (Opposite.op W)).hom) := by
    intro W a b hab
    apply (hInjRange_P W).1
    apply LocallyConstant.ext
    intro y
    have hV : triv_V W (ι_fun W a) y = triv_V W (ι_fun W b) y :=
      congrArg (fun s => triv_V W s y) hab
    rw [hι_spec, hι_spec] at hV
    have hE : emb_P (triv_P W a y) = emb_P (triv_P W b y) := hV
    have hU := congrArg unemb_P hE
    rwa [hunemb_emb, hunemb_emb] at hU

  have hMono_ιP : CategoryTheory.Mono ι_P :=
    ⟨fun {𝒯} g₁ g₂ hg => by
      apply CategoryTheory.Sheaf.hom_ext
      ext W_op t
      exact hι_app_inj W_op.unop
        (congrArg (fun m : 𝒯 ⟶ 𝒱_r => (m.hom.app W_op).hom t) hg)⟩

  have hk_lift : ∀ {𝒯 : CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u}}
      (k : 𝒯 ⟶ 𝒱_r), k ≫ π_C = 0 → ∃ l : 𝒯 ⟶ 𝒫_r, l ≫ ι_P = k := by
    intro 𝒯 k hk
    have hk_pre : ∀ (W : U₀.toScheme.Etale) (t : ↑(𝒯.obj.obj (Opposite.op W))),
        ∃ s₁ : ↑(𝒫_r.obj.obj (Opposite.op W)),
          (ι_P.hom.app (Opposite.op W)).hom s₁ = (k.hom.app (Opposite.op W)).hom t := by
      intro W t
      let f₂ := triv_V W ((k.hom.app (Opposite.op W)).hom t)
      have hf₂_proj : ∀ y, proj_C (f₂ y) = 0 := by
        intro y
        have h0_t : π_fun W ((k.hom.app (Opposite.op W)).hom t) = 0 :=
          congrArg (fun m : 𝒯 ⟶ 𝒞_r => (m.hom.app (Opposite.op W)).hom t) hk
        have htriv0 : triv_C W (π_fun W ((k.hom.app (Opposite.op W)).hom t)) y = 0 := by
          rw [h0_t, map_zero]; rfl
        rw [hπ_spec] at htriv0
        exact htriv0
      let f₁ := (LocallyConstant.mapAddMonoidHom unemb_P) f₂
      have hf₁_emb : (LocallyConstant.mapAddMonoidHom emb_P) f₁ = f₂ := by
        apply LocallyConstant.ext
        intro y
        exact hemb_unemb (f₂ y) (hf₂_proj y)
      have hf₁_mem : f₁ ∈ Set.range (triv_P W) := by
        rw [(hInjRange_P W).2]
        intro σ m_σ hm_fst hm_snd y
        have hf₂_eq : f₂ (m_σ.base y) = ((ρ_V_r σ).val).mulVec (f₂ y) := by
          have hmem : f₂ ∈ Set.range (triv_V W) := ⟨_, rfl⟩
          rw [(hInjRange_V W).2] at hmem
          exact hmem σ m_σ hm_fst hm_snd y
        have hy_eq : f₂ y = emb_P (f₁ y) := (hemb_unemb (f₂ y) (hf₂_proj y)).symm
        have heq_emb : emb_P (f₁ (m_σ.base y)) = emb_P (((ρ_P σ).val).mulVec (f₁ y)) := by
          calc emb_P (f₁ (m_σ.base y))
              = f₂ (m_σ.base y) := hemb_unemb (f₂ (m_σ.base y)) (hf₂_proj _)
            _ = ((ρ_V_r σ).val).mulVec (f₂ y) := hf₂_eq
            _ = ((ρ_V_r σ).val).mulVec (emb_P (f₁ y)) := by rw [hy_eq]
            _ = emb_P (((ρ_P σ).val).mulVec (f₁ y)) := hemb_equiv σ (f₁ y)
        have hU := congrArg unemb_P heq_emb
        rwa [hunemb_emb, hunemb_emb] at hU
      obtain ⟨s₁, hs₁⟩ := hf₁_mem
      refine ⟨s₁, (hInjRange_V W).1 ?_⟩
      change triv_V W (ι_fun W s₁) = f₂
      rw [hι_spec, hs₁, hf₁_emb]
    let l : 𝒯 ⟶ 𝒫_r :=
      { hom :=
          { app := fun W_op => AddCommGrpCat.ofHom
              { toFun := fun t => Classical.choose (hk_pre W_op.unop t)
                map_zero' := hι_app_inj W_op.unop <| by
                  rw [Classical.choose_spec (hk_pre W_op.unop 0), map_zero, map_zero]
                map_add' := fun a b => hι_app_inj W_op.unop <| by
                  rw [Classical.choose_spec (hk_pre W_op.unop (a + b)), map_add, map_add,
                    Classical.choose_spec (hk_pre W_op.unop a),
                    Classical.choose_spec (hk_pre W_op.unop b)] }
            naturality := fun {W₂_op W₁_op} u_op => by
              let W₁ := W₁_op.unop
              let W₂ := W₂_op.unop
              let u : W₁ ⟶ W₂ := u_op.unop
              apply AddCommGrpCat.ext
              intro t
              apply hι_app_inj W₁
              have hL1 := Classical.choose_spec (hk_pre W₁ ((𝒯.obj.map (Opposite.op u)).hom t))
              have hnat_k := congrArg (fun m => m.hom t) (k.hom.naturality (Opposite.op u))
              have hnat_ι := congrArg
                (fun m => m.hom (Classical.choose (hk_pre W₂ t)))
                (ι_P.hom.naturality (Opposite.op u))
              have hR1 := congrArg ((𝒱_r.obj.map (Opposite.op u)).hom)
                (Classical.choose_spec (hk_pre W₂ t))
              exact (hL1.trans hnat_k).trans (hnat_ι.trans hR1).symm } }
    refine ⟨l, ?_⟩
    apply CategoryTheory.Sheaf.hom_ext
    ext W_op t
    exact Classical.choose_spec (hk_pre W_op.unop t)

  have hKer_U : CategoryTheory.Limits.IsLimit
      (CategoryTheory.Limits.KernelFork.ofι ι_P h0_U) :=
    CategoryTheory.Limits.KernelFork.IsLimit.ofι ι_P h0_U
      (fun k hk => Classical.choose (hk_lift k hk))
      (fun k hk => Classical.choose_spec (hk_lift k hk))
      (fun k hk m hm =>
        (CategoryTheory.cancel_mono ι_P).mp
          (hm.trans (Classical.choose_spec (hk_lift k hk)).symm))

  let SC_U := CategoryTheory.ShortComplex.mk ι_P π_C h0_U
  have hEx_U : SC_U.Exact :=
    CategoryTheory.ShortComplex.exact_of_f_is_kernel SC_U hKer_U

  have : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Surjective : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  have hLocLift : ∀ (W : U₀.toScheme.Etale) (c : ↑(𝒞_r.obj.obj (Opposite.op W))),
      ∃ (Y : U₀.toScheme.Etale) (f : Y ⟶ W) (s₂ : ↑(𝒱_r.obj.obj (Opposite.op Y))),
        AlgebraicGeometry.Etale ((FgtU.map f).left) ∧
        AlgebraicGeometry.Surjective ((FgtU.map f).left) ∧
        (π_C.hom.app (Opposite.op Y)).hom s₂ = (𝒞_r.obj.map (Opposite.op f)).hom c := by
    intro W c
    let h_W := (FgtU.obj W).hom
    let W_r := CategoryTheory.Limits.pullback h_W π_r
    let fst_W := CategoryTheory.Limits.pullback.fst h_W π_r
    let snd_W := CategoryTheory.Limits.pullback.snd h_W π_r
    obtain ⟨⟨hfst_et, hfst_surj⟩, _, _⟩ := hTorsor (FgtU.obj W).left h_W
    have hsnd_et : AlgebraicGeometry.Etale snd_W :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback h_W π_r) W.prop
    have hsnd_π_et : AlgebraicGeometry.Etale (snd_W ≫ π_r) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        snd_W π_r hsnd_et hπ_et
    let Y : U₀.toScheme.Etale := AlgebraicGeometry.Scheme.Etale.mk (snd_W ≫ π_r)
    let f : Y ⟶ W :=
      CategoryTheory.MorphismProperty.Over.homMk fst_W CategoryTheory.Limits.pullback.condition
    let Y_r := CategoryTheory.Limits.pullback (snd_W ≫ π_r) π_r
    let fst_Y := CategoryTheory.Limits.pullback.fst (snd_W ≫ π_r) π_r
    let snd_Y := CategoryTheory.Limits.pullback.snd (snd_W ≫ π_r) π_r
    obtain ⟨δ, hδ_props, hδ_disj, hδ_cov, hδ_deck⟩ := hSheets W_r snd_W
    have hz_ex : ∀ z : ↥Y_r, ∃ σ : Γ, z ∈ Set.range (δ σ).base := fun z =>
      Set.mem_iUnion.mp (hδ_cov.symm ▸ Set.mem_univ z)
    let σ_of : ↥Y_r → Γ := fun z => Classical.choose (hz_ex z)
    have hσ_mem : ∀ z : ↥Y_r, z ∈ Set.range (δ (σ_of z)).base :=
      fun z => Classical.choose_spec (hz_ex z)
    have hσ_eq : ∀ {z : ↥Y_r} {σ : Γ}, z ∈ Set.range (δ σ).base → σ_of z = σ := by
      intro z σ hz
      by_contra hne
      exact Set.disjoint_left.mp (hδ_disj (σ_of z) σ hne) (hσ_mem z) hz
    have hδ_fst_eq : ∀ {z : ↥Y_r} {σ : Γ},
        z ∈ Set.range (δ σ).base → (δ σ).base (fst_Y.base z) = z := by
      rintro _ σ ⟨x, rfl⟩
      have h1 : fst_Y.base ((δ σ).base x) = x :=
        congrArg (fun q : W_r ⟶ W_r => q.base x) (hδ_props σ).1
      rw [h1]
    let c' : ↑(𝒞_r.obj.obj (Opposite.op Y)) := (𝒞_r.obj.map (Opposite.op f)).hom c
    let f₃ : LocallyConstant ↥Y_r (Fin 1 → Λ) := triv_C Y c'
    let φ₀ : ↥Y_r → ↥Y_r := fun z => (δ 1).base (fst_Y.base z)
    have hφ₀_cont : Continuous φ₀ := (δ 1).continuous.comp fst_Y.continuous
    let g₂ : ↥Y_r → (Fin (M₀ + 1) → Λ) :=
      fun z => ((ρ_V_r (σ_of z)).val).mulVec (sec_C (f₃ (φ₀ z)))
    have hg₂_lc : IsLocallyConstant g₂ := by
      rw [IsLocallyConstant.iff_exists_open]
      intro z
      let U_z : Set ↥Y_r :=
        Set.range (δ (σ_of z)).base ∩ (φ₀ ⁻¹' (f₃ ⁻¹' {f₃ (φ₀ z)}))
      refine ⟨U_z, (hδ_props (σ_of z)).2.2.2.inter
        ((f₃.isLocallyConstant {f₃ (φ₀ z)}).preimage hφ₀_cont),
        ⟨hσ_mem z, rfl⟩, fun z' hz' => ?_⟩
      have h1 : σ_of z' = σ_of z := hσ_eq hz'.1
      have h2 : f₃ (φ₀ z') = f₃ (φ₀ z) := hz'.2
      dsimp only [g₂]
      rw [h1, h2]
    let f₂ : LocallyConstant ↥Y_r (Fin (M₀ + 1) → Λ) := ⟨g₂, hg₂_lc⟩
    have hf₂_mem : f₂ ∈ Set.range (triv_V Y) := by
      rw [(hInjRange_V Y).2]
      intro τ m_τ hm_fst hm_snd z
      let z' : ↥Y_r := z
      let m_τ' : Y_r ⟶ Y_r := m_τ
      let σ := σ_of z'
      let x := fst_Y.base z'
      have hz_eq : z' = (δ σ).base x := (hδ_fst_eq (hσ_mem z')).symm
      have hm_deck : δ σ ≫ m_τ' = δ (τ * σ) := hδ_deck σ τ m_τ' hm_fst hm_snd
      have hmz_eq : m_τ'.base z' = (δ (τ * σ)).base x :=
        (congrArg m_τ'.base hz_eq).trans
          (congrArg (fun q : W_r ⟶ Y_r => q.base x) hm_deck)
      have hσ_mz : σ_of (m_τ'.base z') = τ * σ := hσ_eq ⟨x, hmz_eq.symm⟩
      have hfst_mz : fst_Y.base (m_τ'.base z') = x :=
        congrArg (fun q : Y_r ⟶ W_r => q.base z') hm_fst
      have hφ₀_mz : φ₀ (m_τ'.base z') = φ₀ z' := congrArg (δ 1).base hfst_mz
      change ((ρ_V_r (σ_of (m_τ'.base z'))).val).mulVec (sec_C (f₃ (φ₀ (m_τ'.base z')))) =
        ((ρ_V_r τ).val).mulVec (((ρ_V_r σ).val).mulVec (sec_C (f₃ (φ₀ z'))))
      rw [hσ_mz, hφ₀_mz, map_mul, Units.val_mul, Matrix.mulVec_mulVec]
    obtain ⟨s₂, hs₂⟩ := hf₂_mem
    refine ⟨Y, f, s₂, hfst_et, hfst_surj, (hInjRange_C Y).1 ?_⟩
    change triv_C Y (π_fun Y s₂) = f₃
    rw [hπ_spec, hs₂]
    apply LocallyConstant.ext
    intro z
    let z' : ↥Y_r := z
    let σ := σ_of z'
    let x := fst_Y.base z'
    have hz_eq : z' = (δ σ).base x := (hδ_fst_eq (hσ_mem z')).symm
    obtain ⟨m_σ, ⟨hm_fst, hm_snd⟩, _⟩ := (hTorsor W_r (snd_W ≫ π_r)).2.1 σ
    have hm_φ₀ : m_σ.base (φ₀ z') = z' :=
      (congrArg (fun q : W_r ⟶ Y_r => q.base x) (hδ_deck 1 σ m_σ hm_fst hm_snd)).trans
        ((congrArg (fun γ : Γ => (δ γ).base x) (mul_one σ)).trans hz_eq.symm)
    have hf₃_eq : f₃ (m_σ.base (φ₀ z')) = ((ρ_C σ).val).mulVec (f₃ (φ₀ z')) := by
      have hmem : f₃ ∈ Set.range (triv_C Y) := ⟨c', rfl⟩
      rw [(hInjRange_C Y).2] at hmem
      exact hmem σ m_σ hm_fst hm_snd (φ₀ z')
    change proj_C (((ρ_V_r σ).val).mulVec (sec_C (f₃ (φ₀ z')))) = f₃ z'
    rw [hproj_equiv, hproj_sec, ← hf₃_eq, hm_φ₀]

  have hEpi_πC : CategoryTheory.Epi π_C :=
    ⟨fun {𝒬} β₁ β₂ hβ => by
      apply CategoryTheory.Sheaf.hom_ext
      ext W_op c
      let W := W_op.unop
      obtain ⟨Y, f, s₂, hf_et, hf_surj, hs₂⟩ := hLocLift W c
      have : AlgebraicGeometry.Surjective ((FgtU.map f).left) := hf_surj
      have hCov : CategoryTheory.Sieve.ofArrows (fun _ : Unit => Y) (fun _ => f) ∈
          U₀.toScheme.smallEtaleTopology W := by
        rw [hMem_U W]
        intro x
        obtain ⟨y, hy⟩ := ((FgtU.map f).left).surjective x
        exact ⟨Y, f, y, CategoryTheory.Sieve.ofArrows_mk _ _ (), hf_et, hy⟩
      have hz_eq : zHom ((β₁.hom.app (Opposite.op W)).hom c) =
          zHom ((β₂.hom.app (Opposite.op W)).hom c) := by
        apply 𝒬.property.hom_ext_ofArrows (fun _ : Unit => f) hCov
        intro _
        apply AddCommGrpCat.ext
        rintro ⟨n⟩
        change (𝒬.obj.map (Opposite.op f)).hom (n • (β₁.hom.app (Opposite.op W)).hom c) =
          (𝒬.obj.map (Opposite.op f)).hom (n • (β₂.hom.app (Opposite.op W)).hom c)
        rw [map_zsmul, map_zsmul]
        congr 1
        have hn₁ := congrArg (fun m => m.hom c) (β₁.hom.naturality (Opposite.op f))
        have hn₂ := congrArg (fun m => m.hom c) (β₂.hom.naturality (Opposite.op f))
        dsimp at hn₁ hn₂
        rw [← hn₁, ← hn₂, ← hs₂]
        exact congrArg (fun m : 𝒱_r ⟶ 𝒬 => (m.hom.app (Opposite.op Y)).hom s₂) hβ
      simpa [zHom, one_zsmul] using congrArg (fun m => m.hom (ULift.up (1 : ℤ))) hz_eq⟩

  have hSE_U : SC_U.ShortExact :=
    CategoryTheory.ShortComplex.ShortExact.mk' hEx_U inferInstance inferInstance

  
  obtain ⟨hCont_U, Θ_U, hΘ_nat⟩ :=
    weil_zero_ext_direct_image_zero_functor_iso U₀.toScheme D₀.left U₀.ι
  obtain ⟨hCont_U', hAdj_U'⟩ := hContAdj_all U₀.toScheme D₀.left U₀.ι
  have hCont_eq : hCont_U = hCont_U' := Subsingleton.elim _ _
  subst hCont_eq
  have : (weilEtaleSitePullback U₀.ι).IsContinuous
      D₀.left.smallEtaleTopology U₀.toScheme.smallEtaleTopology := hCont_U
  let P_U := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
    (weilEtaleSitePullback U₀.ι) AddCommGrpCat.{u} _
    D₀.left.smallEtaleTopology U₀.toScheme.smallEtaleTopology hCont_U
  have : P_U.IsRightAdjoint := hAdj_U'
  have : CategoryTheory.Limits.PreservesFiniteLimits P_U := inferInstance
  have : P_U.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products P_U

  let M_P := weilEtaleHigherDirectImage U₀.ι 0 𝒫_r
  let M_V := weilEtaleHigherDirectImage U₀.ι 0 𝒱_r
  let M_C := weilEtaleHigherDirectImage U₀.ι 0 𝒞_r
  let α : M_P ⟶ M_V := weilEtaleHigherDirectImageMap U₀.ι 0 ι_P
  let β : M_V ⟶ M_C := weilEtaleHigherDirectImageMap U₀.ι 0 π_C
  have h0_D : α ≫ β = 0 := by
    rw [← CategoryTheory.cancel_epi (Θ_U 𝒫_r).hom, CategoryTheory.Limits.comp_zero,
      ← CategoryTheory.Category.assoc, ← hΘ_nat ι_P, CategoryTheory.Category.assoc,
      ← hΘ_nat π_C, ← CategoryTheory.Category.assoc, ← P_U.map_comp, h0_U, P_U.map_zero,
      CategoryTheory.Limits.zero_comp]
  let SC_D := CategoryTheory.ShortComplex.mk α β h0_D
  have hPU_ex_mono : (SC_U.map P_U).Exact ∧ CategoryTheory.Mono (P_U.map ι_P) :=
    (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono P_U).mp
      inferInstance SC_U hSE_U
  let iso_SC : SC_U.map P_U ≅ SC_D :=
    CategoryTheory.ShortComplex.isoMk (Θ_U 𝒫_r) (Θ_U 𝒱_r) (Θ_U 𝒞_r)
      (hΘ_nat ι_P).symm (hΘ_nat π_C).symm
  obtain ⟨hEx_D, hMono_α⟩ :=
    (CategoryTheory.ShortComplex.exact_and_mono_f_iff_of_iso iso_SC).mp hPU_ex_mono
  have : CategoryTheory.Mono α := hMono_α

  let ℱ_r := CategoryTheory.Limits.cokernel α
  let g₁ : M_V ⟶ ℱ_r := CategoryTheory.Limits.cokernel.π α
  let SC₁ := CategoryTheory.ShortComplex.mk α g₁ (CategoryTheory.Limits.cokernel.condition α)
  have hSC₁_SE : SC₁.ShortExact :=
    CategoryTheory.ShortComplex.ShortExact.mk'
      (CategoryTheory.ShortComplex.exact_of_g_is_cokernel SC₁
        (CategoryTheory.Limits.cokernelIsCokernel α))
      inferInstance inferInstance

  let f₂ : ℱ_r ⟶ M_C := CategoryTheory.Limits.cokernel.desc α β h0_D
  have hMono_f₂ : CategoryTheory.Mono f₂ := hEx_D.mono_cokernelDesc
  let 𝒮_r := CategoryTheory.Limits.cokernel β
  let g₂ : M_C ⟶ 𝒮_r := CategoryTheory.Limits.cokernel.π β
  have h0₂ : f₂ ≫ g₂ = 0 := by
    rw [← CategoryTheory.cancel_epi g₁, CategoryTheory.Limits.comp_zero,
      ← CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.π_desc,
      CategoryTheory.Limits.cokernel.condition]
  let SC₂ := CategoryTheory.ShortComplex.mk f₂ g₂ h0₂
  have hColim_g₂ : CategoryTheory.Limits.IsColimit
      (CategoryTheory.Limits.CokernelCofork.ofπ g₂ h0₂) :=
    CategoryTheory.Limits.CokernelCofork.IsColimit.ofπ g₂ h0₂
      (fun {Z} k hk => CategoryTheory.Limits.cokernel.desc β k <| by
        rw [← CategoryTheory.Limits.cokernel.π_desc α β h0_D,
          CategoryTheory.Category.assoc, hk, CategoryTheory.Limits.comp_zero])
      (fun {Z} k _ => CategoryTheory.Limits.cokernel.π_desc _ _ _)
      (fun {Z} k _ m hm => by
        rw [← CategoryTheory.cancel_epi g₂, hm,
          CategoryTheory.Limits.cokernel.π_desc])
  have hSC₂_SE : SC₂.ShortExact :=
    CategoryTheory.ShortComplex.ShortExact.mk'
      (CategoryTheory.ShortComplex.exact_of_g_is_cokernel SC₂ hColim_g₂)
      inferInstance inferInstance

  have hTor_C : (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id 𝒞_r = 0 := by
    apply CategoryTheory.Sheaf.hom_ext
    ext W_op s
    apply (hInjRange_C W_op.unop).1
    have happ : ∀ n : ℕ,
        ((n • CategoryTheory.CategoryStruct.id 𝒞_r).hom.app W_op).hom s = n • s := by
      intro n
      induction n with
      | zero => rfl
      | succ n ih =>
        rw [succ_nsmul, succ_nsmul, ← ih]
        rfl
    have hzero : ((0 : 𝒞_r ⟶ 𝒞_r).hom.app W_op).hom s = 0 := rfl
    rw [happ (ℓ ^ (r + 1)), hzero, map_nsmul, map_zero]
    ext y a
    change (ℓ ^ (r + 1)) • (triv_C W_op.unop s y a) = 0
    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  have hTor_PU : (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id (P_U.obj 𝒞_r) = 0 := by
    change (ℓ ^ (r + 1)) • 𝟙 (P_U.obj 𝒞_r) = 0
    rw [← P_U.map_id, ← CategoryTheory.Functor.map_nsmul, hTor_C, P_U.map_zero]
  have hTor_MC : (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id M_C = 0 := by
    change (ℓ ^ (r + 1)) • 𝟙 M_C = 0
    have hid : (Θ_U 𝒞_r).inv ≫ 𝟙 (P_U.obj 𝒞_r) ≫ (Θ_U 𝒞_r).hom = 𝟙 M_C := by
      rw [CategoryTheory.Category.id_comp, (Θ_U 𝒞_r).inv_hom_id]
    rw [← hid, ← CategoryTheory.Preadditive.comp_nsmul,
      ← CategoryTheory.Preadditive.nsmul_comp, hTor_PU,
      CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
  have hTor_S : (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id 𝒮_r = 0 := by
    change (ℓ ^ (r + 1)) • 𝟙 𝒮_r = 0
    rw [← CategoryTheory.cancel_epi g₂, CategoryTheory.Limits.comp_zero,
      CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
      ← CategoryTheory.Category.id_comp g₂, ← CategoryTheory.Preadditive.nsmul_comp,
      hTor_MC, CategoryTheory.Limits.zero_comp]

  
  let B_U := weilEtaleSitePullback U₀.ι
  have hSheafEqZero_D : ∀ (ℱ : CategoryTheory.Sheaf D₀.left.smallEtaleTopology AddCommGrpCat.{u})
      {E : D₀.left.Etale} (R : CategoryTheory.Sieve E),
      R ∈ D₀.left.smallEtaleTopology E →
      ∀ (g : ↑(ℱ.obj.obj (Opposite.op E))),
        (∀ ⦃E' : D₀.left.Etale⦄ (u : E' ⟶ E), R.arrows u → (ℱ.obj.map (Opposite.op u)).hom g = 0) →
        g = 0 := by
    intro ℱ E R hR g hg0
    let α_g : Aℤ ⟶ ℱ.obj.obj (Opposite.op E) := zHom g
    let fam0 : CategoryTheory.Presieve.FamilyOfElements
        (ℱ.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ)) R.arrows :=
      fun E' _ _ => (0 : Aℤ ⟶ ℱ.obj.obj (Opposite.op E'))
    have hcompat0 : fam0.Compatible := by
      intro Y₁ Y₂ Z' k₁ k₂ f₁' f₂' _ _ _
      change (0 : Aℤ ⟶ _) ≫ ℱ.obj.map k₁.op = (0 : Aℤ ⟶ _) ≫ ℱ.obj.map k₂.op
      rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.zero_comp]
    have hamalg_g : fam0.IsAmalgamation α_g := by
      intro E' u hu
      change α_g ≫ ℱ.obj.map u.op = 0
      apply AddCommGrpCat.ext
      rintro ⟨n⟩
      change (ℱ.obj.map (Opposite.op u)).hom (n • g) = 0
      rw [map_zsmul, hg0 u hu, zsmul_zero]
    have hamalg_0 : fam0.IsAmalgamation (0 : Aℤ ⟶ ℱ.obj.obj (Opposite.op E)) := by
      intro E' u _
      change (0 : Aℤ ⟶ _) ≫ ℱ.obj.map u.op = 0
      exact CategoryTheory.Limits.zero_comp
    have hα0 : α_g = 0 := (ℱ.property Aℤ R hR fam0 hcompat0).unique hamalg_g hamalg_0
    simpa [α_g, zHom, one_zsmul] using
      congrArg (fun m : Aℤ ⟶ ℱ.obj.obj (Opposite.op E) => m.hom (ULift.up (1 : ℤ))) hα0

  have hg₂_vanish : ∀ (W' : D₀.left.Etale),
      Set.range (FgtD.obj W').hom.base ⊆ (U₀ : Set D₀.left) →
      ∀ m : ↑(M_C.obj.obj (Opposite.op W')), (g₂.hom.app (Opposite.op W')).hom m = 0 := by
    intro W' hW' m
    let h_W' := (FgtD.obj W').hom
    have hW'_range : Set.range h_W'.base ⊆ Set.range U₀.ι.base := by
      rwa [AlgebraicGeometry.Scheme.Opens.range_ι]
    let h_U : (FgtD.obj W').left ⟶ U₀.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U₀.ι h_W' hW'_range
    have hh_U : h_U ≫ U₀.ι = h_W' :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U₀.ι h_W' hW'_range
    let W'_U : U₀.toScheme.Etale := B_U.obj W'
    let fst' : (FgtU.obj W'_U).left ⟶ (FgtD.obj W').left :=
      CategoryTheory.Limits.pullback.fst h_W' U₀.ι
    let snd' : (FgtU.obj W'_U).left ⟶ U₀.toScheme :=
      CategoryTheory.Limits.pullback.snd h_W' U₀.ι
    have hfst'_et : AlgebraicGeometry.Etale fst' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback h_W' U₀.ι).flip inferInstance
    let sec' : (FgtD.obj W').left ⟶ (FgtU.obj W'_U).left :=
      CategoryTheory.Limits.pullback.lift (𝟙 _) h_U
        ((CategoryTheory.Category.id_comp h_W').trans hh_U.symm)
    have hfst'_surj : AlgebraicGeometry.Surjective fst' :=
      ⟨fun x => ⟨sec'.base x,
        congrArg (fun q : (FgtD.obj W').left ⟶ (FgtD.obj W').left => q.base x)
          (CategoryTheory.Limits.pullback.lift_fst (𝟙 _) h_U
            ((CategoryTheory.Category.id_comp h_W').trans hh_U.symm))⟩⟩
    let c_U : ↑(𝒞_r.obj.obj (Opposite.op W'_U)) :=
      (((Θ_U 𝒞_r).inv.hom.app (Opposite.op W')).hom m)
    obtain ⟨Y_U, p_U, s_V, hp_et, hp_surj, hs_V⟩ := hLocLift W'_U c_U
    let g_U := (FgtU.obj Y_U).hom
    let fst_raw := CategoryTheory.Limits.pullback.fst h_W' U₀.ι
    let snd_raw := CategoryTheory.Limits.pullback.snd h_W' U₀.ι
    let p_U_left : (FgtU.obj Y_U).left ⟶ CategoryTheory.Limits.pullback h_W' U₀.ι :=
      (FgtU.map p_U).left
    have hp_w : p_U_left ≫ snd_raw = g_U := (FgtU.map p_U).w
    have hgU_et : AlgebraicGeometry.Etale (g_U ≫ U₀.ι) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        g_U U₀.ι Y_U.prop inferInstance
    let Y_D : D₀.left.Etale := AlgebraicGeometry.Scheme.Etale.mk (g_U ≫ U₀.ι)
    let f_D_left : (FgtU.obj Y_U).left ⟶ (FgtD.obj W').left :=
      p_U_left ≫ fst_raw
    have hf_D_w : f_D_left ≫ h_W' = g_U ≫ U₀.ι :=
      (CategoryTheory.Category.assoc p_U_left fst_raw h_W').trans
        ((congrArg (p_U_left ≫ ·) CategoryTheory.Limits.pullback.condition).trans
          ((CategoryTheory.Category.assoc p_U_left snd_raw U₀.ι).symm.trans
            (congrArg (· ≫ U₀.ι) hp_w)))
    let f_D : Y_D ⟶ W' := CategoryTheory.MorphismProperty.Over.homMk f_D_left hf_D_w
    have hfD_et : AlgebraicGeometry.Etale ((FgtD.map f_D).left) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        (FgtU.map p_U).left fst' hp_et hfst'_et
    have hfD_surj : AlgebraicGeometry.Surjective ((FgtD.map f_D).left) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Surjective)
        (FgtU.map p_U).left fst' hp_surj hfst'_surj
    let fst_YD := CategoryTheory.Limits.pullback.fst (g_U ≫ U₀.ι) U₀.ι
    let snd_YD := CategoryTheory.Limits.pullback.snd (g_U ≫ U₀.ι) U₀.ι
    have he_Y_w : fst_YD ≫ g_U = snd_YD := by
      rw [← CategoryTheory.cancel_mono U₀.ι, CategoryTheory.Category.assoc]
      exact CategoryTheory.Limits.pullback.condition
    let e_Y : B_U.obj Y_D ⟶ Y_U := CategoryTheory.MorphismProperty.Over.homMk fst_YD he_Y_w
    have he_comp : e_Y ≫ p_U = B_U.map f_D := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      let bfD_left : CategoryTheory.Limits.pullback (g_U ≫ U₀.ι) U₀.ι ⟶
          CategoryTheory.Limits.pullback h_W' U₀.ι :=
        (FgtU.map (B_U.map f_D)).left
      change fst_YD ≫ p_U_left = bfD_left
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Category.assoc fst_YD p_U_left fst_raw).trans
          (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      · exact (CategoryTheory.Category.assoc fst_YD p_U_left snd_raw).trans
          ((congrArg (fst_YD ≫ ·) hp_w).trans
            (he_Y_w.trans ((FgtU.map (B_U.map f_D)).w).symm))
    let s_V' : ↑((P_U.obj 𝒱_r).obj.obj (Opposite.op Y_D)) :=
      (𝒱_r.obj.map (Opposite.op e_Y)).hom s_V
    have hPU_eq : ((P_U.map π_C).hom.app (Opposite.op Y_D)).hom s_V' =
        (((Θ_U 𝒞_r).inv.hom.app (Opposite.op Y_D)).hom
          ((M_C.obj.map (Opposite.op f_D)).hom m)) := by
      have h1 : ((P_U.map π_C).hom.app (Opposite.op Y_D)).hom s_V' =
          (𝒞_r.obj.map (Opposite.op e_Y)).hom ((π_C.hom.app (Opposite.op Y_U)).hom s_V) :=
        congrArg (fun k => k.hom s_V) (π_C.hom.naturality (Opposite.op e_Y))
      have h1' : (𝒞_r.obj.map (Opposite.op e_Y)).hom ((π_C.hom.app (Opposite.op Y_U)).hom s_V) =
          (𝒞_r.obj.map (Opposite.op e_Y)).hom ((𝒞_r.obj.map (Opposite.op p_U)).hom c_U) :=
        congrArg (𝒞_r.obj.map (Opposite.op e_Y)).hom hs_V
      have hcomp_C : (𝒞_r.obj.map (Opposite.op (e_Y ≫ p_U))).hom c_U =
          (𝒞_r.obj.map (Opposite.op e_Y)).hom ((𝒞_r.obj.map (Opposite.op p_U)).hom c_U) :=
        congrArg (fun k => k.hom c_U) (𝒞_r.obj.map_comp (Opposite.op p_U) (Opposite.op e_Y))
      have he_C : (𝒞_r.obj.map (Opposite.op (e_Y ≫ p_U))).hom c_U =
          (𝒞_r.obj.map (Opposite.op (B_U.map f_D))).hom c_U :=
        congrArg (fun q => (𝒞_r.obj.map (Opposite.op q)).hom c_U) he_comp
      have h2 : (𝒞_r.obj.map (Opposite.op (B_U.map f_D))).hom c_U =
          (((Θ_U 𝒞_r).inv.hom.app (Opposite.op Y_D)).hom
            ((M_C.obj.map (Opposite.op f_D)).hom m)) :=
        (congrArg (fun k => k.hom m) ((Θ_U 𝒞_r).inv.hom.naturality (Opposite.op f_D))).symm
      exact h1.trans (h1'.trans (hcomp_C.symm.trans (he_C.trans h2)))
    have hm_fD : (M_C.obj.map (Opposite.op f_D)).hom m =
        (β.hom.app (Opposite.op Y_D)).hom
          (((Θ_U 𝒱_r).hom.hom.app (Opposite.op Y_D)).hom s_V') := by
      have happly := congrArg (((Θ_U 𝒞_r).hom.hom.app (Opposite.op Y_D)).hom) hPU_eq
      have hinv_hom : (((Θ_U 𝒞_r).hom.hom.app (Opposite.op Y_D)).hom
          (((Θ_U 𝒞_r).inv.hom.app (Opposite.op Y_D)).hom
            ((M_C.obj.map (Opposite.op f_D)).hom m))) =
          (M_C.obj.map (Opposite.op f_D)).hom m :=
        congrArg (fun k : M_C ⟶ M_C => (k.hom.app (Opposite.op Y_D)).hom
          ((M_C.obj.map (Opposite.op f_D)).hom m)) (Θ_U 𝒞_r).inv_hom_id
      have hnat_β := congrArg (fun k : P_U.obj 𝒱_r ⟶ M_C => (k.hom.app (Opposite.op Y_D)).hom s_V')
        (hΘ_nat π_C)
      exact hinv_hom.symm.trans (happly.symm.trans hnat_β)
    have hfD_zero : (𝒮_r.obj.map (Opposite.op f_D)).hom
        ((g₂.hom.app (Opposite.op W')).hom m) = 0 := by
      have hnat_g₂ := congrArg (fun k => k.hom m) (g₂.hom.naturality (Opposite.op f_D))
      dsimp at hnat_g₂
      rw [← hnat_g₂, hm_fD]
      exact congrArg
        (fun k : M_V ⟶ 𝒮_r => (k.hom.app (Opposite.op Y_D)).hom
          (((Θ_U 𝒱_r).hom.hom.app (Opposite.op Y_D)).hom s_V'))
        (CategoryTheory.Limits.cokernel.condition β)
    let R_fD := CategoryTheory.Sieve.ofArrows (fun _ : Unit => Y_D) (fun _ => f_D)
    have : AlgebraicGeometry.Surjective ((FgtD.map f_D).left) := hfD_surj
    have hCov_D : R_fD ∈ D₀.left.smallEtaleTopology W' := by
      rw [hMem_D W']
      intro x
      obtain ⟨y, hy⟩ := ((FgtD.map f_D).left).surjective x
      exact ⟨Y_D, f_D, y, CategoryTheory.Sieve.ofArrows_mk _ _ (), hfD_et, hy⟩
    refine hSheafEqZero_D 𝒮_r R_fD hCov_D ((g₂.hom.app (Opposite.op W')).hom m) ?_
    rintro E' u ⟨Z', hZ', _, ⟨⟩, rfl⟩
    have hmap_comp := congrArg
      (fun k => k.hom ((g₂.hom.app (Opposite.op W')).hom m))
      (𝒮_r.obj.map_comp (Opposite.op f_D) (Opposite.op hZ'))
    exact hmap_comp.trans
      ((congrArg (𝒮_r.obj.map (Opposite.op hZ')).hom hfD_zero).trans (map_zero _))

  let K_sub : ∀ W : D₀.left.Etale, AddSubgroup ↑(𝒮_r.obj.obj (Opposite.op W)) :=
    fun W =>
      { carrier := { s | ∀ (W' : D₀.left.Etale) (u : W' ⟶ W),
          Set.range (FgtD.obj W').hom.base ⊆ (U₀ : Set D₀.left) →
          (𝒮_r.obj.map (Opposite.op u)).hom s = 0 }
        zero_mem' := fun _ u _ => map_zero (𝒮_r.obj.map (Opposite.op u)).hom
        add_mem' := fun {a b} ha hb W' u hW' => by
          rw [map_add, ha W' u hW', hb W' u hW', add_zero]
        neg_mem' := fun {a} ha W' u hW' => by
          rw [map_neg, ha W' u hW', neg_zero] }
  let K_pre : D₀.left.Etaleᵒᵖ ⥤ AddCommGrpCat.{u} :=
    { obj := fun opW => AddCommGrpCat.of ↥(K_sub opW.unop)
      map := fun {opW₂ opW₁} v => AddCommGrpCat.ofHom
        { toFun := fun x => ⟨(𝒮_r.obj.map v).hom x.1, fun W' u hW' => by
            have hcomp := congrArg (fun k => k.hom x.1)
              (𝒮_r.obj.map_comp v (Opposite.op u))
            dsimp at hcomp
            rw [← hcomp]
            exact x.2 W' (u ≫ v.unop) hW'⟩
          map_zero' := Subtype.ext (map_zero _)
          map_add' := fun a b => Subtype.ext (map_add _ a.1 b.1) }
      map_id := fun opW => AddCommGrpCat.ext fun x => Subtype.ext <|
        congrArg (fun k => k.hom x.1) (𝒮_r.obj.map_id opW)
      map_comp := fun {opW₃ opW₂ opW₁} u v => AddCommGrpCat.ext fun x => Subtype.ext <|
        congrArg (fun k => k.hom x.1) (𝒮_r.obj.map_comp u v) }
  let ι_K_pre : K_pre ⟶ 𝒮_r.obj :=
    { app := fun opW => AddCommGrpCat.ofHom (K_sub opW.unop).subtype
      naturality := fun _ _ _ => AddCommGrpCat.ext fun _ => rfl }
  have hK_sheaf : CategoryTheory.Presheaf.IsSheaf D₀.left.smallEtaleTopology K_pre := by
    intro A E S hS fam hcompat
    let fam_S : CategoryTheory.Presieve.FamilyOfElements
        (𝒮_r.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op A)) S.arrows :=
      fun E' u hu => fam u hu ≫ ι_K_pre.app (Opposite.op E')
    have hcompat_S : fam_S.Compatible := by
      intro Y₁ Y₂ Z' k₁ k₂ f₁' f₂' h₁ h₂ hcomm
      have hc := hcompat k₁ k₂ h₁ h₂ hcomm
      change (fam f₁' h₁ ≫ K_pre.map k₁.op) = (fam f₂' h₂ ≫ K_pre.map k₂.op) at hc
      change (fam f₁' h₁ ≫ ι_K_pre.app (Opposite.op Y₁)) ≫ 𝒮_r.obj.map k₁.op =
        (fam f₂' h₂ ≫ ι_K_pre.app (Opposite.op Y₂)) ≫ 𝒮_r.obj.map k₂.op
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← ι_K_pre.naturality k₁.op, ← ι_K_pre.naturality k₂.op,
        ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, hc]
    obtain ⟨g, hg_amalg, hg_uniq⟩ := 𝒮_r.property A S hS fam_S hcompat_S
    have hg_mem : ∀ a : ↑A, g.hom a ∈ K_sub E := by
      intro a W' u hW'
      let S' := CategoryTheory.Sieve.pullback u S
      have hS' : S' ∈ D₀.left.smallEtaleTopology W' :=
        D₀.left.smallEtaleTopology.pullback_stable u hS
      refine hSheafEqZero_D 𝒮_r S' hS' ((𝒮_r.obj.map (Opposite.op u)).hom (g.hom a)) ?_
      intro Z w hw
      have hwS : S.arrows (w ≫ u) := hw
      have hZw : (𝒮_r.obj.map (Opposite.op (w ≫ u))).hom (g.hom a) =
          ((fam (w ≫ u) hwS).hom a).1 :=
        congrArg (fun k => k.hom a) (hg_amalg (w ≫ u) hwS)
      have hZ_sub : Set.range (FgtD.obj Z).hom.base ⊆ (U₀ : Set D₀.left) := by
        rintro _ ⟨z, rfl⟩
        have hw_hom : (FgtD.obj Z).hom = (FgtD.map w).left ≫ (FgtD.obj W').hom :=
          ((FgtD.map w).w).symm
        rw [hw_hom]
        exact hW' ⟨(FgtD.map w).left.base z, rfl⟩
      have hZ_zero : ((fam (w ≫ u) hwS).hom a).1 = 0 :=
        (congrArg (fun k => k.hom ((fam (w ≫ u) hwS).hom a).1)
          (𝒮_r.obj.map_id (Opposite.op Z))).symm.trans
          (((fam (w ≫ u) hwS).hom a).2 Z (𝟙 Z) hZ_sub)
      have hmap_wu : (𝒮_r.obj.map (Opposite.op w)).hom
          ((𝒮_r.obj.map (Opposite.op u)).hom (g.hom a)) =
          (𝒮_r.obj.map (Opposite.op (w ≫ u))).hom (g.hom a) :=
        (congrArg (fun k => k.hom (g.hom a))
          (𝒮_r.obj.map_comp (Opposite.op u) (Opposite.op w))).symm
      exact hmap_wu.trans (hZw.trans hZ_zero)
    let g_K : A ⟶ K_pre.obj (Opposite.op E) :=
      AddCommGrpCat.ofHom
        { toFun := fun a => ⟨g.hom a, hg_mem a⟩
          map_zero' := Subtype.ext (map_zero g.hom)
          map_add' := fun a b => Subtype.ext (map_add g.hom a b) }
    refine ⟨g_K, fun E' u hu => ?_, fun t ht => ?_⟩
    · apply AddCommGrpCat.ext
      intro a
      exact Subtype.ext (congrArg (fun k => k.hom a) (hg_amalg u hu))
    · have ht_S : fam_S.IsAmalgamation (t ≫ ι_K_pre.app (Opposite.op E)) := by
        intro E' u hu
        change (t ≫ ι_K_pre.app (Opposite.op E)) ≫ 𝒮_r.obj.map u.op =
          fam u hu ≫ ι_K_pre.app (Opposite.op E')
        rw [CategoryTheory.Category.assoc, ← ι_K_pre.naturality u.op,
          ← CategoryTheory.Category.assoc]
        exact congrArg (· ≫ ι_K_pre.app (Opposite.op E')) (ht u hu)
      have heq_S := hg_uniq (t ≫ ι_K_pre.app (Opposite.op E)) ht_S
      apply AddCommGrpCat.ext
      intro a
      exact Subtype.ext (congrArg (fun k => k.hom a) heq_S)

  let 𝒦 : CategoryTheory.Sheaf D₀.left.smallEtaleTopology AddCommGrpCat.{u} :=
    ⟨K_pre, hK_sheaf⟩
  let ι_K : 𝒦 ⟶ 𝒮_r := ⟨ι_K_pre⟩
  have hMono_ιK : CategoryTheory.Mono ι_K :=
    ⟨fun {𝒯} m₁ m₂ hm => by
      apply CategoryTheory.Sheaf.hom_ext
      ext opW t
      exact congrArg (fun k : 𝒯 ⟶ 𝒮_r => (k.hom.app opW).hom t) hm⟩
  let g₂_tilde : M_C ⟶ 𝒦 :=
    { hom :=
        { app := fun opW => AddCommGrpCat.ofHom
            { toFun := fun m => ⟨(g₂.hom.app opW).hom m, fun W' u hW' => by
                have hnat := congrArg (fun k => k.hom m) (g₂.hom.naturality (Opposite.op u))
                dsimp at hnat
                rw [← hnat]
                exact hg₂_vanish W' hW' ((M_C.obj.map (Opposite.op u)).hom m)⟩
              map_zero' := Subtype.ext (map_zero _)
              map_add' := fun a b => Subtype.ext (map_add _ a b) }
          naturality := fun {opW₂ opW₁} v => AddCommGrpCat.ext fun m => Subtype.ext <|
            congrArg (fun k => k.hom m) (g₂.hom.naturality v) } }
  have hg₂_fac : g₂_tilde ≫ ι_K = g₂ := by
    apply CategoryTheory.Sheaf.hom_ext
    ext opW m
    rfl
  have hβ_g₂tilde : β ≫ g₂_tilde = 0 := by
    rw [← CategoryTheory.cancel_mono ι_K, CategoryTheory.Limits.zero_comp,
      CategoryTheory.Category.assoc, hg₂_fac]
    exact CategoryTheory.Limits.cokernel.condition β
  let r_K : 𝒮_r ⟶ 𝒦 := CategoryTheory.Limits.cokernel.desc β g₂_tilde hβ_g₂tilde
  have hrK_id : r_K ≫ ι_K = 𝟙 𝒮_r := by
    rw [← CategoryTheory.cancel_epi g₂, CategoryTheory.Category.comp_id,
      ← CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.π_desc, hg₂_fac]

  have hSub_U₀ : ∀ W : D₀.left.Etale,
      Set.range (FgtD.obj W).hom.base ⊆ (U₀ : Set D₀.left) →
      Subsingleton ↑(𝒮_r.obj.obj (Opposite.op W)) := by
    intro W hW
    refine ⟨fun s₁ s₂ => ?_⟩
    have hzero : ∀ s : ↑(𝒮_r.obj.obj (Opposite.op W)), s = 0 := by
      intro s
      have hs_id : ((r_K ≫ ι_K).hom.app (Opposite.op W)).hom s = s := by
        rw [hrK_id]; rfl
      have hs_mem : s ∈ K_sub W := by
        rw [← hs_id]
        exact ((r_K.hom.app (Opposite.op W)).hom s).2
      have h1 := hs_mem W (𝟙 W) hW
      exact (congrArg (fun k => k.hom s) (𝒮_r.obj.map_id (Opposite.op W))).symm.trans h1
    exact (hzero s₁).trans (hzero s₂).symm

  refine ⟨ρ_P, ρ_C, 𝒫_r, 𝒞_r, triv_P, triv_C, ℱ_r, 𝒮_r, SC₁, SC₂,
    hρP_val, hρC_val,
    ⟨fun u u_r h1 h2 => ⟨hNat_P u u_r h1 h2, hNat_C u u_r h1 h2⟩,
     fun W => ⟨(hInjRange_P W).1, (hInjRange_P W).2,
               (hInjRange_C W).1, (hInjRange_C W).2⟩⟩,
    rfl, rfl, rfl, hSC₁_SE,
    rfl, rfl, rfl, hSC₂_SE,
    hTor_S, hSub_U₀⟩

theorem weil_mid_dev_iso_geom_const_pushforward_and_frob_char (F : Type u) [Finite F] [Field F]
