      (ℳ₀.obj.map (Opposite.op u)).hom (Θ_push W₂ s) =
        Θ_push W₁ ((𝒢_0.obj.map (Opposite.op ((weilEtaleSitePullback U₀.ι).map u))).hom s) :=
    fun u s => congrArg (fun k => k.hom s) ((Θ_ι 𝒢_0).hom.hom.naturality (Opposite.op u)).symm
  obtain ⟨τ_k, Ξ, hτ_snd, hΞ_nat, hΞ_twist⟩ :=
    h_s11 F D₀ U₀ R₀ B_r k_L ι_kB e_U hπ_base res_k hres_surj hres_comm
      M (ZMod (ℓ ^ (r + 1))) ρ_G ρ_bar hρ_fac hTors_B hSheets_k
      𝒢_0 triv_G hTriv_G ℳ₀ Θ_push hΘ_nat hExt_LC
  let P1_bar := weilProjectiveSpaceOver (AlgebraicClosure F) 1
  have : AlgebraicGeometry.IsIntegral P1_bar.left :=
    (weil_projectiveSpace_integral_krullDim_and_dim_zero_iso (AlgebraicClosure F) 1).1
  let e_S : S ≅ P1_bar.left := (CategoryTheory.Over.forget _).mapIso e_P
  have hSurj_eS : Function.Surjective e_S.inv.base := fun s =>
    ⟨e_S.hom.base s, congrArg (fun k => k.base s) e_S.hom_inv_id⟩
  have : Nonempty ↥S := Nonempty.map e_S.inv.base inferInstance
  have : PreconnectedSpace ↥S := ⟨by
    rw [← hSurj_eS.range_eq, ← Set.image_univ]
    exact isPreconnected_univ.image _ e_S.inv.base.hom.continuous.continuousOn⟩
  have : ConnectedSpace ↥S := ⟨inferInstance⟩
  rcases weil_etale_constant_sheaf_locallyConstant_equiv_and_pullback_adj with
    ⟨hMem_all, _, hConst_all⟩
  let N_mod := ℓ ^ (r + 1)
  have : NeZero N_mod := ⟨pow_ne_zero (r + 1) (Fact.out : Nat.Prime ℓ).ne_zero⟩
  let A_M := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin M → ZMod N_mod))
  obtain ⟨hT_S, θ_S, hθ_bij, hθ_nat, hθ_unit⟩ := hConst_all S A_M
  obtain ⟨⟨iso_const⟩, hFrob_h0⟩ :=
    h_s12 F D₀ k_L hSurj_fk hSheets_S M N_mod ρ_bar ℳ₀ τ_k hτ_snd
      Ξ hΞ_nat hΞ_twist (hMem_all D₀.left) (hMem_all S)
      hT_S θ_S hθ_bij hθ_nat hθ_unit hCont_pr hAdj_pr
  have hSub_const : Subsingleton
      (((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj A_M).H 1) :=
    h_s13 S ℓ r M hH1_mod_ℓ (hMem_all S) (hConst_all S)
  have hSub_L : Subsingleton ((L_pr.obj ℳ₀).H 1) := by
    let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    refine ⟨fun a b => ?_⟩
    have h_eq : ((CategoryTheory.Abelian.Ext.mk₀ iso_const.inv).postcomp Fℤ
        (Nat.add_zero 1)) a =
      ((CategoryTheory.Abelian.Ext.mk₀ iso_const.inv).postcomp Fℤ
        (Nat.add_zero 1)) b :=
      @Subsingleton.elim _ hSub_const _ _
    have h_back := congrArg
      ((CategoryTheory.Abelian.Ext.mk₀ iso_const.hom).postcomp Fℤ (Nat.add_zero 1))
      h_eq
    change (a.comp (CategoryTheory.Abelian.Ext.mk₀ iso_const.inv) (Nat.add_zero 1)).comp
        (CategoryTheory.Abelian.Ext.mk₀ iso_const.hom) (Nat.add_zero 1) =
      (b.comp (CategoryTheory.Abelian.Ext.mk₀ iso_const.inv) (Nat.add_zero 1)).comp
        (CategoryTheory.Abelian.Ext.mk₀ iso_const.hom) (Nat.add_zero 1) at h_back
    rwa [CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero,
      CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Iso.inv_hom_id,
      CategoryTheory.Abelian.Ext.comp_mk₀_id,
      CategoryTheory.Abelian.Ext.comp_mk₀_id] at h_back
  refine ⟨⟨iso_const⟩, hSub_L, ?_⟩
  intro hM1 a₀ _ Q_u σ_u μ_bar hQ_max _ hQ_frob hρ_μ f_M hf_M x
  have hρ_bar_μ : (ρ_bar (res_k σ_u)).val ⟨0, by omega⟩ ⟨0, by omega⟩ = μ_bar := by
    rw [hρ_fac σ_u]
    exact hρ_μ
  exact hFrob_h0 hM1 (res_k σ_u) μ_bar (hFrob_k Q_u σ_u hQ_max hQ_frob) hρ_bar_μ f_M hf_M x

theorem weil_mid_dev_iso_punctual_skyscraper_cover_surj (F : Type u) [Finite F] [Field F]
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    [AlgebraicGeometry.IsProper (weilProjectiveSpaceOver F 1).hom] :
    let D₀ := weilProjectiveSpaceOver F 1
    let S := weilGeomScheme F D₀
    let pr_D : Quiver.Hom S D₀.left :=
      CategoryTheory.Limits.pullback.fst D₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
    let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    ∀ (hCont_pr : (weilEtaleSitePullback pr_D).IsContinuous
          D₀.left.smallEtaleTopology S.smallEtaleTopology)
      (hAdj_pr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback pr_D) AddCommGrpCat.{u} _
        D₀.left.smallEtaleTopology S.smallEtaleTopology hCont_pr).IsRightAdjoint),
      let L_pr := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback pr_D) AddCommGrpCat.{u} _
        D₀.left.smallEtaleTopology S.smallEtaleTopology hCont_pr hAdj_pr
      ∀ (A₀ : AddCommGrpCat.{u})
        (ℳ₀ 𝒮₀ : CategoryTheory.Sheaf D₀.left.smallEtaleTopology AddCommGrpCat.{u})
        (q_S : Quiver.Hom ℳ₀ 𝒮₀) [CategoryTheory.Epi q_S],
        Nonempty (((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj A₀) ≅
          L_pr.obj ℳ₀) →
        (∀ W : D₀.left.Etale,
          Set.range ((AlgebraicGeometry.Scheme.Etale.forget D₀.left).obj W).hom.base ⊆
            (U₀ : Set D₀.left) →
          Subsingleton ↑(𝒮₀.obj.obj (Opposite.op W))) →
        ∃ (n_cov : ℕ)
          (ℛ : Fin n_cov → CategoryTheory.Sheaf D₀.left.smallEtaleTopology AddCommGrpCat.{u})
          (η : ∀ j : Fin n_cov, Quiver.Hom 𝒮₀ (ℛ j)),
          (∀ z : (L_pr.obj 𝒮₀).H 0,
            (∀ j : Fin n_cov,
              ((CategoryTheory.Abelian.Ext.mk₀ (L_pr.map (η j))).postcomp Fℤ
                (Nat.add_zero 0)) z = 0) →
            z = 0) ∧
          (∀ (j : Fin n_cov) (y : (L_pr.obj (ℛ j)).H 0),
            ∃ x : (L_pr.obj ℳ₀).H 0,
              ((CategoryTheory.Abelian.Ext.mk₀
                (L_pr.map (CategoryTheory.CategoryStruct.comp q_S (η j)))).postcomp Fℤ
                (Nat.add_zero 0)) x = y) :=
by
  classical
  intro D₀ S pr_D Fℤ hCont_pr hAdj_pr L_pr A₀ ℳ₀ 𝒮₀ q_S _hEpi_q hConst hS_U₀

  
  
  
  have hEtale_ext : ∀ {X : Scheme.{u}} {U₁ U₂ : X.Etale} {f g : U₁ ⟶ U₂},
      ((Scheme.Etale.forget X).map f).left = ((Scheme.Etale.forget X).map g).left → f = g := by
    intro X U₁ U₂ f g h
    apply (Scheme.Etale.forget X).map_injective
    exact CategoryTheory.Over.OverMorphism.ext h

  have hEtale_mem : ∀ (X : Scheme.{u}) (W : X.Etale) (R : Sieve W),
      R ∈ X.smallEtaleTopology W ↔
        ∀ x : ↥((Scheme.Etale.forget X).obj W).left,
          ∃ (Y : X.Etale) (f : Y ⟶ W) (y : ↥((Scheme.Etale.forget X).obj Y).left),
            R.arrows f ∧
            Etale ((Scheme.Etale.forget X).map f).left ∧
            ((Scheme.Etale.forget X).map f).left.base y = x := by
    intro X W R
    let P : MorphismProperty Scheme.{u} := @AlgebraicGeometry.Etale
    have _ : P.IsStableUnderComposition :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have h1 : X.smallEtaleTopology = (Scheme.smallPretopology P P (S := X)).toGrothendieck :=
      Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology X (le_refl P)
    have h2 := Scheme.mem_toGrothendieck_smallPretopology (P := P) (Q := P) (S := X) W R
    erw [h1]
    exact h2

  let O_pre : ∀ (X : Scheme.{u}) (O : X.Opens) (U : X.Etale),
      ((Scheme.Etale.forget X).obj U).left.Opens :=
    fun X O U => (TopologicalSpace.Opens.map ((Scheme.Etale.forget X).obj U).hom.base).obj O

  let F_obj : ∀ (X : Scheme.{u}) (O : X.Opens), X.Etale → X.Etale := fun X O U =>
    letI : Etale ((Scheme.Etale.forget X).obj U).hom := U.prop
    letI : IsOpenImmersion (O_pre X O U).ι := (O_pre X O U).instIsOpenImmersionι
    Scheme.Etale.mk ((O_pre X O U).ι ≫ ((Scheme.Etale.forget X).obj U).hom)

  let F_map : ∀ (X : Scheme.{u}) (O : X.Opens) {U₁ U₂ : X.Etale},
      (U₁ ⟶ U₂) → (F_obj X O U₁ ⟶ F_obj X O U₂) := fun X O {U₁ U₂} g =>
    let O₁ := O_pre X O U₁
    let O₂ := O_pre X O U₂
    letI : IsOpenImmersion O₁.ι := O₁.instIsOpenImmersionι
    letI : IsOpenImmersion O₂.ι := O₂.instIsOpenImmersionι
    let g_left := ((Scheme.Etale.forget X).map g).left
    have hrange : Set.range (O₁.ι ≫ g_left).base ⊆ Set.range O₂.ι.base := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      change ((Scheme.Etale.forget X).obj U₂).hom.base ((O₁.ι ≫ g_left).base z) ∈ O
      have hw : g_left ≫ ((Scheme.Etale.forget X).obj U₂).hom =
          ((Scheme.Etale.forget X).obj U₁).hom :=
        CategoryTheory.Over.w ((Scheme.Etale.forget X).map g)
      have hz : ((Scheme.Etale.forget X).obj U₁).hom.base (O₁.ι.base z) ∈ O := z.2
      have heq : ((Scheme.Etale.forget X).obj U₂).hom.base ((O₁.ι ≫ g_left).base z) =
          ((Scheme.Etale.forget X).obj U₁).hom.base (O₁.ι.base z) := by
        rw [← Scheme.Hom.comp_apply, Category.assoc, hw, Scheme.Hom.comp_apply]
      rwa [heq]
    let m : O₁.toScheme ⟶ O₂.toScheme := IsOpenImmersion.lift O₂.ι (O₁.ι ≫ g_left) hrange
    MorphismProperty.Over.homMk m
      (by
        change m ≫ (O₂.ι ≫ ((Scheme.Etale.forget X).obj U₂).hom) =
          O₁.ι ≫ ((Scheme.Etale.forget X).obj U₁).hom
        rw [← Category.assoc, IsOpenImmersion.lift_fac, Category.assoc,
          CategoryTheory.Over.w ((Scheme.Etale.forget X).map g)])
      trivial

  let π_raw : ∀ (X : Scheme.{u}) (O : X.Opens) (U : X.Etale), F_obj X O U ⟶ U :=
    fun X O U => MorphismProperty.Over.homMk (O_pre X O U).ι rfl trivial

  have hπ_raw_nat : ∀ (X : Scheme.{u}) (O : X.Opens) {U₁ U₂ : X.Etale} (g : U₁ ⟶ U₂),
      F_map X O g ≫ π_raw X O U₂ = π_raw X O U₁ ≫ g := by
    intro X O U₁ U₂ g
    apply hEtale_ext
    let O₂ := O_pre X O U₂
    have _ : IsOpenImmersion O₂.ι := O₂.instIsOpenImmersionι
    change IsOpenImmersion.lift O₂.ι _ _ ≫ O₂.ι = _
    exact IsOpenImmersion.lift_fac O₂.ι _ _

  have hπ_raw_mono : ∀ (X : Scheme.{u}) (O : X.Opens) (U : X.Etale), Mono (π_raw X O U) := by
    intro X O U
    refine ⟨fun {Z} g₁ g₂ h => hEtale_ext ?_⟩
    let O_U := O_pre X O U
    have _ : IsOpenImmersion O_U.ι := O_U.instIsOpenImmersionι
    have hleft : ((Scheme.Etale.forget X).map g₁).left ≫ O_U.ι =
        ((Scheme.Etale.forget X).map g₂).left ≫ O_U.ι :=
      congrArg (fun k => ((Scheme.Etale.forget X).map k).left) h
    exact (cancel_mono O_U.ι).mp hleft

  let F_open : ∀ (X : Scheme.{u}) (O : X.Opens), X.Etale ⥤ X.Etale := fun X O =>
    { obj := F_obj X O
      map := F_map X O
      map_id := fun U => by
        have := hπ_raw_mono X O U
        apply (cancel_mono (π_raw X O U)).mp
        rw [hπ_raw_nat, Category.comp_id, Category.id_comp]
      map_comp := fun {U₁ U₂ U₃} g₁ g₂ => by
        have := hπ_raw_mono X O U₃
        apply (cancel_mono (π_raw X O U₃)).mp
        rw [hπ_raw_nat, Category.assoc, hπ_raw_nat,
          ← Category.assoc (π_raw X O U₁), ← hπ_raw_nat, Category.assoc] }

  let π_open : ∀ (X : Scheme.{u}) (O : X.Opens) (U : X.Etale),
      (F_open X O).obj U ⟶ U := π_raw

  have hπ_nat : ∀ (X : Scheme.{u}) (O : X.Opens) {U₁ U₂ : X.Etale} (g : U₁ ⟶ U₂),
      (F_open X O).map g ≫ π_open X O U₂ = π_open X O U₁ ≫ g := hπ_raw_nat

  have hπ_mono : ∀ (X : Scheme.{u}) (O : X.Opens) (U : X.Etale),
      Mono (π_open X O U) := hπ_raw_mono

  have hπ_etale : ∀ (X : Scheme.{u}) (O : X.Opens) (U : X.Etale),
      Etale ((Scheme.Etale.forget X).map (π_open X O U)).left := by
    intro X O U
    let O_U := O_pre X O U
    have _ : IsOpenImmersion O_U.ι := O_U.instIsOpenImmersionι
    change Etale O_U.ι
    infer_instance

  have hOpen_sec : ∀ (X : Scheme.{u}) (O : X.Opens) {Y : X.Etale},
      Set.range ((Scheme.Etale.forget X).obj Y).hom.base ⊆ (O : Set X) →
      ∃ δ : Y ⟶ (F_open X O).obj Y, δ ≫ π_open X O Y = 𝟙 Y := by
    intro X O Y hsub
    let Y_left : Scheme.{u} := ((Scheme.Etale.forget X).obj Y).left
    let O_Y := O_pre X O Y
    have _ : IsOpenImmersion O_Y.ι := O_Y.instIsOpenImmersionι
    have hr : Set.range (𝟙 Y_left : Scheme.Hom Y_left Y_left).base ⊆ Set.range O_Y.ι.base := by
      rw [Scheme.Opens.range_ι]
      rintro y ⟨y', hy'⟩
      have : y' = y := hy'
      subst this
      exact hsub ⟨y', rfl⟩
    let d_left : Y_left ⟶ O_Y.toScheme := IsOpenImmersion.lift O_Y.ι (𝟙 Y_left) hr
    refine ⟨MorphismProperty.Over.homMk d_left
      (by
        change d_left ≫ (O_Y.ι ≫ ((Scheme.Etale.forget X).obj Y).hom) =
          ((Scheme.Etale.forget X).obj Y).hom
        rw [← Category.assoc, IsOpenImmersion.lift_fac, Category.id_comp])
      trivial, ?_⟩
    apply hEtale_ext
    change d_left ≫ O_Y.ι = 𝟙 Y_left
    exact IsOpenImmersion.lift_fac O_Y.ι _ _

  have hOpen_cont : ∀ (X : Scheme.{u}) (O : X.Opens),
      (F_open X O).IsContinuous X.smallEtaleTopology X.smallEtaleTopology := by
    intro X O
    apply Functor.isContinuous_of_coverPreserving
    · refine ⟨fun ℱ {Z} {T} {x} hx {Y₁ Y₂} {W} f₁ f₂ {g₁ g₂} hg₁ hg₂ hcomm => ?_⟩
      have hW_sub : Set.range ((Scheme.Etale.forget X).obj W).hom.base ⊆ (O : Set X) := by
        rintro _ ⟨w, rfl⟩
        have hw : (((Scheme.Etale.forget X).map (f₁ ≫ π_open X O Y₁)).left ≫
            ((Scheme.Etale.forget X).obj Y₁).hom).base w =
            ((Scheme.Etale.forget X).obj W).hom.base w :=
          congrArg (fun k => k.base w)
            (CategoryTheory.Over.w ((Scheme.Etale.forget X).map (f₁ ≫ π_open X O Y₁)))
        rw [← hw, Scheme.Hom.comp_apply]
        let f₁_left : ((Scheme.Etale.forget X).obj W).left ⟶ (O_pre X O Y₁).toScheme :=
          ((Scheme.Etale.forget X).map f₁).left
        have heq_base : ((Scheme.Etale.forget X).map (f₁ ≫ π_open X O Y₁)).left.base w =
            (O_pre X O Y₁).ι.base (f₁_left.base w) := by
          change (f₁_left ≫ (O_pre X O Y₁).ι).base w = _
          exact Scheme.Hom.comp_apply _ _ _
        rw [heq_base]
        exact (f₁_left.base w).2
      obtain ⟨δ, hδ⟩ := hOpen_sec X O hW_sub
      have h_factor : ∀ {Y : X.Etale} (u : W ⟶ (F_open X O).obj Y),
          u = δ ≫ (F_open X O).map (u ≫ π_open X O Y) := by
        intro Y u
        have := hπ_mono X O Y
        apply (cancel_mono (π_open X O Y)).mp
        rw [Category.assoc, hπ_nat X O (u ≫ π_open X O Y), ← Category.assoc, hδ, Category.id_comp]
      have hcomm' : (f₁ ≫ π_open X O Y₁) ≫ g₁ = (f₂ ≫ π_open X O Y₂) ≫ g₂ := by
        have h1 := congrArg (· ≫ π_open X O Z) hcomm
        change (f₁ ≫ (F_open X O).map g₁) ≫ π_open X O Z =
          (f₂ ≫ (F_open X O).map g₂) ≫ π_open X O Z at h1
        rw [Category.assoc f₁, hπ_nat X O g₁, Category.assoc f₂, hπ_nat X O g₂,
          ← Category.assoc f₁, ← Category.assoc f₂] at h1
        exact h1
      have hcompat := hx (f₁ ≫ π_open X O Y₁) (f₂ ≫ π_open X O Y₂) hg₁ hg₂ hcomm'
      change (ℱ.obj.map (Opposite.op ((F_open X O).map (f₁ ≫ π_open X O Y₁)))) (x g₁ hg₁) =
        (ℱ.obj.map (Opposite.op ((F_open X O).map (f₂ ≫ π_open X O Y₂)))) (x g₂ hg₂) at hcompat
      have hf₁_eq := h_factor f₁
      have hf₂_eq := h_factor f₂
      change (ℱ.obj.map f₁.op) (x g₁ hg₁) = (ℱ.obj.map f₂.op) (x g₂ hg₂)
      rw [hf₁_eq, hf₂_eq, op_comp, ℱ.obj.map_comp, op_comp, ℱ.obj.map_comp]
      exact congrArg (ℱ.obj.map δ.op) hcompat
    · refine ⟨fun {U} {R} hR => ?_⟩
      rw [hEtale_mem] at hR ⊢
      intro x
      let O_U := O_pre X O U
      have _ : IsOpenImmersion O_U.ι := O_U.instIsOpenImmersionι
      have _ : Etale O_U.ι := inferInstance
      let x' : ↥O_U.toScheme := x
      obtain ⟨Y, f, y, hfR, hfEt, hy⟩ := hR (O_U.ι.base x')
      let O_Y := O_pre X O Y
      have _ : IsOpenImmersion O_Y.ι := O_Y.instIsOpenImmersionι
      have _ : Etale O_Y.ι := inferInstance
      have hy_mem : y ∈ O_Y := by
        change ((Scheme.Etale.forget X).obj Y).hom.base y ∈ O
        have hw := congrArg (fun k => k.base y)
          (CategoryTheory.Over.w ((Scheme.Etale.forget X).map f))
        rw [← hw, Scheme.Hom.comp_apply, hy]
        exact x'.2
      have hy_range : y ∈ Set.range O_Y.ι.base := by
        rwa [Scheme.Opens.range_ι]
      obtain ⟨y₀, hy₀⟩ := hy_range
      let y₀' : ↥((Scheme.Etale.forget X).obj ((F_open X O).obj Y)).left := y₀
      refine ⟨(F_open X O).obj Y, (F_open X O).map f, y₀',
        ⟨Y, f, 𝟙 ((F_open X O).obj Y), hfR, (Category.id_comp _).symm⟩, ?_, ?_⟩
      · let map_left : O_Y.toScheme ⟶ O_U.toScheme :=
          ((Scheme.Etale.forget X).map ((F_open X O).map f)).left
        have hcomp_et : Etale (map_left ≫ O_U.ι) := by
          have hfac : map_left ≫ O_U.ι = O_Y.ι ≫ ((Scheme.Etale.forget X).map f).left :=
            congrArg (fun k => ((Scheme.Etale.forget X).map k).left) (hπ_nat X O f)
          rw [hfac]
          have _ : Etale ((Scheme.Etale.forget X).map f).left := hfEt
          infer_instance
        exact @MorphismProperty.of_postcomp _ _ (@AlgebraicGeometry.Etale)
          (@AlgebraicGeometry.Etale) _ _ _ _ map_left O_U.ι inferInstance hcomp_et
      · apply (Scheme.Hom.isOpenEmbedding O_U.ι).injective
        let map_left : O_Y.toScheme ⟶ O_U.toScheme :=
          ((Scheme.Etale.forget X).map ((F_open X O).map f)).left
        have hfac : map_left ≫ O_U.ι = O_Y.ι ≫ ((Scheme.Etale.forget X).map f).left :=
          congrArg (fun k => ((Scheme.Etale.forget X).map k).left) (hπ_nat X O f)
        have hfac' := congrArg (fun k => k.base y₀) hfac
        rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hfac'
        change O_U.ι.base (map_left.base y₀) = O_U.ι.base x'
        rw [hfac', hy₀, hy]

  
  
  
  let m_aff : ℕ := S_aff.card
  let n_cov : ℕ := m_aff + 1
  let e_aff : Fin m_aff ≃ ↥S_aff := S_aff.equivFin.symm
  let pt_F : ↥(Spec (CommRingCat.of F)) := Classical.arbitrary _
  have hptF_bot : pt_F.asIdeal = ⊥ := by
    ext c
    simp only [Ideal.mem_bot]
    refine ⟨fun hc => ?_, fun h0 => h0.symm ▸ pt_F.asIdeal.zero_mem⟩
    by_contra hne
    apply pt_F.isPrime.ne_top
    rw [Ideal.eq_top_iff_one]
    have h1 : c * c⁻¹ = (1 : F) := mul_inv_cancel₀ hne
    rw [← h1]
    exact pt_F.asIdeal.mul_mem_right c⁻¹ hc

  let s_pt : F → (Spec (CommRingCat.of F) ⟶ Spec (CommRingCat.of (Polynomial F))) :=
    fun a => Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a))
  let q_pt : F → ↥(Spec (CommRingCat.of (Polynomial F))) :=
    fun a => (s_pt a).base pt_F

  have hq_mem : ∀ (a : F) (f : Polynomial F), f ∈ (q_pt a).asIdeal ↔ f.eval a = 0 := by
    intro a f
    have hq_id : (q_pt a).asIdeal = Ideal.comap (Polynomial.evalRingHom a) pt_F.asIdeal := by
      dsimp [q_pt, s_pt]
      rw [Spec.map_apply]
      rfl
    rw [hq_id, hptF_bot, Ideal.mem_comap, Ideal.mem_bot, Polynomial.coe_evalRingHom]

  have hq_eq : ∀ (a : F) (p : ↥(Spec (CommRingCat.of (Polynomial F)))),
      Polynomial.X - Polynomial.C a ∈ p.asIdeal ↔ p = q_pt a := by
    intro a p
    refine ⟨fun hXa => ?_, fun hp => ?_⟩
    · apply PrimeSpectrum.ext
      ext f
      rw [hq_mem]
      have hdvd : Polynomial.X - Polynomial.C a ∣ f - Polynomial.C (f.eval a) := by
        rw [Polynomial.dvd_iff_isRoot]
        simp [Polynomial.IsRoot]
      rcases hdvd with ⟨g, hg⟩
      have hdiff : f - Polynomial.C (f.eval a) ∈ p.asIdeal := by
        rw [hg]
        exact p.asIdeal.mul_mem_right g hXa
      refine ⟨fun hfp => ?_, fun hfev => ?_⟩
      · by_contra hne
        apply p.isPrime.ne_top
        rw [Ideal.eq_top_iff_one]
        have hc_mem : Polynomial.C (f.eval a) ∈ p.asIdeal := by
          have : Polynomial.C (f.eval a) = f - (f - Polynomial.C (f.eval a)) := by ring
          rw [this]
          exact p.asIdeal.sub_mem hfp hdiff
        have h1 : Polynomial.C (f.eval a) * Polynomial.C (f.eval a)⁻¹ = (1 : Polynomial F) := by
          rw [← Polynomial.C_mul, mul_inv_cancel₀ hne, Polynomial.C_1]
        rw [← h1]
        exact p.asIdeal.mul_mem_right _ hc_mem
      · rw [hfev, Polynomial.C_0, sub_zero] at hdiff
        exact hdiff
    · rw [hp, hq_mem]
      simp

  let s_sec : Fin n_cov → (Spec (CommRingCat.of F) ⟶ D₀.left) :=
    Fin.cases s_inf (fun i => s_pt (e_aff i).1 ≫ j_aff)

  have hs_sec : ∀ j : Fin n_cov, s_sec j ≫ D₀.hom = 𝟙 (Spec (CommRingCat.of F)) := by
    refine Fin.cases hsinf_sec (fun i => ?_)
    dsimp [s_sec, s_pt, D₀]
    rw [Category.assoc, hj_hom, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hcid : (Polynomial.evalRingHom (e_aff i).1).comp Polynomial.C = RingHom.id F := by
      ext c
      simp
    rw [hcid, CommRingCat.ofHom_id, Spec.map_id]

  let x_pt : Fin n_cov → ↥D₀.left := fun j => (s_sec j).base pt_F

  have hrange_s : ∀ j : Fin n_cov, Set.range (s_sec j).base = {x_pt j} := by
    intro j
    ext z
    simp only [Set.mem_range, Set.mem_singleton_iff, x_pt]
    exact ⟨fun ⟨p, hp⟩ => by rw [← hp, Subsingleton.elim p pt_F], fun hz => ⟨pt_F, hz.symm⟩⟩

  have hClosed_x : ∀ j : Fin n_cov, IsClosed ({x_pt j} : Set ↥D₀.left) := by
    intro j
    have _ : IsSeparated D₀.hom := IsProper.toIsSeparated
    have _ : IsClosedImmersion (s_sec j ≫ D₀.hom) := by
      rw [hs_sec j]
      infer_instance
    have _ : IsClosedImmersion (s_sec j) := IsClosedImmersion.of_comp (s_sec j) D₀.hom
    rw [← hrange_s j]
    exact (IsClosedImmersion.isClosedEmbedding (s_sec j)).isClosed_range

  have hx0_not_aff : x_pt 0 ∉ Set.range j_aff.base := by
    have hmem : x_pt 0 ∈ Set.range s_inf.base := ⟨pt_F, rfl⟩
    rw [← hsinf_compl] at hmem
    exact hmem

  have hj_inj : Function.Injective j_aff.base :=
    (Scheme.Hom.isOpenEmbedding j_aff).injective

  have hx_inj : Function.Injective x_pt := by
    intro j₁ j₂
    cases j₁ using Fin.cases with
    | zero =>
      cases j₂ using Fin.cases with
      | zero => intro _; rfl
      | succ i₂ =>
        intro h
        exfalso
        apply hx0_not_aff
        rw [h]
        exact ⟨q_pt (e_aff i₂).1, rfl⟩
    | succ i₁ =>
      cases j₂ using Fin.cases with
      | zero =>
        intro h
        exfalso
        apply hx0_not_aff
        rw [← h]
        exact ⟨q_pt (e_aff i₁).1, rfl⟩
      | succ i₂ =>
        intro h
        have hq : q_pt (e_aff i₁).1 = q_pt (e_aff i₂).1 := hj_inj h
        have hX : Polynomial.X - Polynomial.C (e_aff i₁).1 ∈ (q_pt (e_aff i₂).1).asIdeal := by
          rw [← hq]
          exact (hq_eq (e_aff i₁).1 _).mpr rfl
        rw [hq_mem] at hX
        simp only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hX
        have hi : i₁ = i₂ := e_aff.injective (Subtype.ext hX.symm)
        rw [hi]

  have hU₀_iff : ∀ z : ↥D₀.left, z ∈ (U₀ : Set ↥D₀.left) ↔ ∀ j : Fin n_cov, z ≠ x_pt j := by
    intro z
    rw [hU₀_eq]
    refine ⟨?_, ?_⟩
    · rintro ⟨p, hp, rfl⟩ j
      refine Fin.cases ?_ ?_ j
      · intro h0
        exact hx0_not_aff ⟨p, h0⟩
      · intro i hi
        have hpq : p = q_pt (e_aff i).1 := hj_inj hi
        exact hp (e_aff i).1 (e_aff i).2 ((hq_eq (e_aff i).1 p).mpr hpq)
    · intro hall
      have hz_aff : z ∈ Set.range j_aff.base := by
        by_contra hnot
        have hinf : z ∈ Set.range s_inf.base := by rwa [← hsinf_compl]
        have hs0 : Set.range s_inf.base = {x_pt 0} := hrange_s 0
        rw [hs0, Set.mem_singleton_iff] at hinf
        exact hall 0 hinf
      rcases hz_aff with ⟨p, rfl⟩
      refine ⟨p, fun a ha hmem => ?_, rfl⟩
      have hpq : p = q_pt a := (hq_eq a p).mp hmem
      let i : Fin m_aff := e_aff.symm ⟨a, ha⟩
      have hai : (e_aff i).1 = a := congrArg Subtype.val (e_aff.apply_symm_apply ⟨a, ha⟩)
      apply hall i.succ
      dsimp [x_pt, s_sec]
      rw [hpq, hai]

  let W_comp : Fin n_cov → D₀.left.Opens :=
    fun j => ⟨({x_pt j} : Set ↥D₀.left)ᶜ, (hClosed_x j).isOpen_compl⟩
  let V_cov : Fin n_cov → D₀.left.Opens := fun j =>
    ⟨(⋃ i ∈ ({i : Fin n_cov | i ≠ j} : Set (Fin n_cov)), ({x_pt i} : Set ↥D₀.left))ᶜ,
      ((Set.toFinite _).isClosed_biUnion (fun i _ => hClosed_x i)).isOpen_compl⟩

  have hW_mem : ∀ (j : Fin n_cov) (z : ↥D₀.left), z ∈ W_comp j ↔ z ≠ x_pt j := by
    intro j z
    rfl

  have hV_mem : ∀ (j : Fin n_cov) (z : ↥D₀.left),
      z ∈ V_cov j ↔ ∀ i : Fin n_cov, i ≠ j → z ≠ x_pt i := by
    intro j z
    change z ∈ (⋃ i ∈ ({i : Fin n_cov | i ≠ j} : Set (Fin n_cov)), ({x_pt i} : Set ↥D₀.left))ᶜ ↔ _
    simp [Set.mem_compl_iff]

  have hCov_univ : (⋃ j : Fin n_cov, (V_cov j : Set ↥D₀.left)) = Set.univ := by
    ext z
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    by_cases hz : ∃ j : Fin n_cov, z = x_pt j
    · rcases hz with ⟨j, rfl⟩
      exact ⟨j, (hV_mem j (x_pt j)).mpr (fun i hij h_eq => hij (hx_inj h_eq.symm))⟩
    · exact ⟨0, (hV_mem 0 z).mpr (fun i _ h_eq => hz ⟨i, h_eq⟩)⟩

  have hVW_univ : ∀ j : Fin n_cov,
      (V_cov j : Set ↥D₀.left) ∪ (W_comp j : Set ↥D₀.left) = Set.univ := by
    intro j
    ext z
    simp only [Set.mem_union, Set.mem_univ, iff_true]
    by_cases hzj : z = x_pt j
    · left
      rw [hzj]
      exact (hV_mem j (x_pt j)).mpr (fun i hij h_eq => hij (hx_inj h_eq.symm))
    · right
      exact hzj

  have hVW_inter : ∀ j : Fin n_cov,
      ((V_cov j : Set ↥D₀.left) ∩ (W_comp j : Set ↥D₀.left)) ⊆ (U₀ : Set ↥D₀.left) := by
    intro j z ⟨hzV, hzW⟩
    rw [hU₀_iff]
    intro i
    by_cases hij : i = j
    · rw [hij]
      exact (hW_mem j z).mp hzW
    · exact (hV_mem j z).mp hzV i hij

  have hV_sub_W : ∀ i j : Fin n_cov, i ≠ j →
      (V_cov i : Set ↥D₀.left) ⊆ (W_comp j : Set ↥D₀.left) := by
    intro i j hij z hzV
    exact (hV_mem i z).mp hzV j hij.symm

  
  let f_alg : Spec (CommRingCat.of (AlgebraicClosure F)) ⟶ Spec (CommRingCat.of F) :=
    Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))
  let pr_k : S ⟶ Spec (CommRingCat.of (AlgebraicClosure F)) :=
    Limits.pullback.snd D₀.hom f_alg
  let pt_k : ↥(Spec (CommRingCat.of (AlgebraicClosure F))) := Classical.arbitrary _
  let s_bar : Fin n_cov → (Spec (CommRingCat.of (AlgebraicClosure F)) ⟶ S) :=
    fun j => Limits.pullback.lift (f_alg ≫ s_sec j) (𝟙 _)
      (by rw [Category.assoc, hs_sec j, Category.comp_id, Category.id_comp])
  let x_bar : Fin n_cov → ↥S := fun j => (s_bar j).base pt_k

  have hW_bar_iff : ∀ (j : Fin n_cov) (z : ↥S),
      pr_D.base z ∈ (W_comp j : Set ↥D₀.left) ↔ z ≠ x_bar j := by
    intro j z
    suffices h_eq_iff : pr_D.base z = x_pt j ↔ z = x_bar j by
      exact not_congr h_eq_iff
    refine ⟨fun hpr => ?_, fun hz => ?_⟩
    · have h_right : IsPullback pr_k pr_D f_alg D₀.hom :=
        (IsPullback.of_hasPullback D₀.hom f_alg).flip
      have h_top_id : s_bar j ≫ pr_k = 𝟙 _ := Limits.pullback.lift_snd _ _ _
      have _ : IsIso (s_bar j ≫ pr_k) := by rw [h_top_id]; infer_instance
      have _ : IsIso (s_sec j ≫ D₀.hom) := by rw [hs_sec j]; infer_instance
      have h_outer : IsPullback (s_bar j ≫ pr_k) f_alg f_alg (s_sec j ≫ D₀.hom) :=
        IsPullback.of_horiz_isIso
          ⟨by rw [h_top_id, hs_sec j, Category.id_comp, Category.comp_id]⟩
      have h_left : IsPullback (s_bar j) f_alg pr_D (s_sec j) :=
        IsPullback.of_right h_outer (Limits.pullback.lift_fst _ _ _) h_right
      have h_pre : z ∈ pr_D.base ⁻¹' Set.range (s_sec j).base := by
        change pr_D.base z ∈ Set.range (s_sec j).base
        rw [hrange_s j, Set.mem_singleton_iff]
        exact hpr
      rw [← Scheme.Pullback.range_fst pr_D (s_sec j)] at h_pre
      rcases h_pre with ⟨q, hq⟩
      let q₀ : ↥(Spec (CommRingCat.of (AlgebraicClosure F))) := h_left.isoPullback.inv.base q
      have hq₀ : h_left.isoPullback.hom.base q₀ = q := by
        change (h_left.isoPullback.inv ≫ h_left.isoPullback.hom).base q = q
        rw [h_left.isoPullback.inv_hom_id]
        rfl
      have hsb : (s_bar j).base q₀ = z := by
        rw [← h_left.isoPullback_hom_fst, Scheme.Hom.comp_apply, hq₀, hq]
      rw [← hsb, Subsingleton.elim q₀ pt_k]
    · rw [hz]
      change (s_bar j ≫ pr_D).base pt_k = (s_sec j).base pt_F
      have hfst : s_bar j ≫ pr_D = f_alg ≫ s_sec j := Limits.pullback.lift_fst _ _ _
      rw [hfst, Scheme.Hom.comp_apply, Subsingleton.elim (f_alg.base pt_k) pt_F]

  
  
  
  let J_D := D₀.left.smallEtaleTopology
  let ℛ : Fin n_cov → Sheaf J_D AddCommGrpCat.{u} := fun j =>
    letI := hOpen_cont D₀.left (V_cov j)
    ((F_open D₀.left (V_cov j)).sheafPushforwardContinuous AddCommGrpCat.{u} J_D J_D).obj 𝒮₀

  let η : ∀ j : Fin n_cov, 𝒮₀ ⟶ ℛ j := fun j =>
    { hom :=
      { app := fun U => 𝒮₀.obj.map (Opposite.op (π_open D₀.left (V_cov j) U.unop))
        naturality := fun {U₁ U₂} g => by
          change 𝒮₀.obj.map g ≫ 𝒮₀.obj.map (Opposite.op (π_open D₀.left (V_cov j) U₂.unop)) =
            𝒮₀.obj.map (Opposite.op (π_open D₀.left (V_cov j) U₁.unop)) ≫
              𝒮₀.obj.map (Opposite.op ((F_open D₀.left (V_cov j)).map g.unop))
          rw [← 𝒮₀.obj.map_comp, ← 𝒮₀.obj.map_comp]
          congr 1
          change Opposite.op (π_open D₀.left (V_cov j) U₂.unop ≫ g.unop) =
            Opposite.op ((F_open D₀.left (V_cov j)).map g.unop ≫ π_open D₀.left (V_cov j) U₁.unop)
          rw [hπ_nat D₀.left (V_cov j) g.unop] } }

  have hR_W : ∀ (j : Fin n_cov) (U : D₀.left.Etale),
      Set.range ((Scheme.Etale.forget D₀.left).obj U).hom.base ⊆ (W_comp j : Set ↥D₀.left) →
      Subsingleton ↑((ℛ j).obj.obj (Opposite.op U)) := by
    intro j U hU_W
    change Subsingleton ↑(𝒮₀.obj.obj (Opposite.op ((F_open D₀.left (V_cov j)).obj U)))
    refine hS_U₀ ((F_open D₀.left (V_cov j)).obj U) ?_
    rintro _ ⟨y, rfl⟩
    apply hVW_inter j
    let O_V := O_pre D₀.left (V_cov j) U
    have hyV : ((Scheme.Etale.forget D₀.left).obj U).hom.base (O_V.ι.base y) ∈ V_cov j := y.2
    have hyW : ((Scheme.Etale.forget D₀.left).obj U).hom.base (O_V.ι.base y) ∈ W_comp j :=
      hU_W ⟨O_V.ι.base y, rfl⟩
    exact ⟨hyV, hyW⟩

  let P_set : (D₀.left.Etale)ᵒᵖ ⥤ Type u := ((CategoryTheory.sheafForget J_D).obj 𝒮₀).obj
  have hSheaf_S₀ : Presieve.IsSheaf J_D P_set :=
    (isSheaf_iff_isSheaf_of_type J_D P_set).mp ((sheafForget J_D).obj 𝒮₀).property

  let R_UW : ∀ (j : Fin n_cov) (U : D₀.left.Etale), Presieve U := fun j U {Y} f =>
    (∃ hY : Y = (F_open D₀.left (V_cov j)).obj U, hY ▸ f = π_open D₀.left (V_cov j) U) ∨
    (∃ hY : Y = (F_open D₀.left (W_comp j)).obj U, hY ▸ f = π_open D₀.left (W_comp j) U)

  have hCov_UW : ∀ (j : Fin n_cov) (U : D₀.left.Etale),
      Sieve.generate (R_UW j U) ∈ J_D U := by
    intro j U
    rw [hEtale_mem]
    intro u
    have hu_univ : ((Scheme.Etale.forget D₀.left).obj U).hom.base u ∈
        (V_cov j : Set ↥D₀.left) ∪ (W_comp j : Set ↥D₀.left) := by
      rw [hVW_univ j]
      trivial
    rcases hu_univ with huV | huW
    · let O_V := O_pre D₀.left (V_cov j) U
      have _ : IsOpenImmersion O_V.ι := O_V.instIsOpenImmersionι
      have hu_r : u ∈ Set.range O_V.ι.base := by
        rw [Scheme.Opens.range_ι]
        exact huV
      rcases hu_r with ⟨y, hy⟩
      exact ⟨(F_open D₀.left (V_cov j)).obj U, π_open D₀.left (V_cov j) U, y,
        ⟨_, 𝟙 _, π_open D₀.left (V_cov j) U, Or.inl ⟨rfl, rfl⟩, Category.id_comp _⟩,
        hπ_etale D₀.left (V_cov j) U, hy⟩
    · let O_W := O_pre D₀.left (W_comp j) U
      have _ : IsOpenImmersion O_W.ι := O_W.instIsOpenImmersionι
      have hu_r : u ∈ Set.range O_W.ι.base := by
        rw [Scheme.Opens.range_ι]
        exact huW
      rcases hu_r with ⟨y, hy⟩
      exact ⟨(F_open D₀.left (W_comp j)).obj U, π_open D₀.left (W_comp j) U, y,
        ⟨_, 𝟙 _, π_open D₀.left (W_comp j) U, Or.inr ⟨rfl, rfl⟩, Category.id_comp _⟩,
        hπ_etale D₀.left (W_comp j) U, hy⟩

  have h_amalg_ex : ∀ (j : Fin n_cov) (U : D₀.left.Etale)
      (r : ↑((ℛ j).obj.obj (Opposite.op U))),
      ∃! s : ↑(𝒮₀.obj.obj (Opposite.op U)),
        (𝒮₀.obj.map (Opposite.op (π_open D₀.left (V_cov j) U))).hom s = r ∧
        (𝒮₀.obj.map (Opposite.op (π_open D₀.left (W_comp j) U))).hom s = 0 := by
    intro j U r
    have hSh := hSheaf_S₀.isSheafFor (R_UW j U) (hCov_UW j U)
    have hFW_sub : Set.range ((Scheme.Etale.forget D₀.left).obj
        ((F_open D₀.left (W_comp j)).obj U)).hom.base ⊆ (W_comp j : Set ↥D₀.left) := by
      rintro _ ⟨y, rfl⟩
      exact y.2
    let x_fam : Presieve.FamilyOfElements P_set (R_UW j U) := fun Y f hf =>
      if hW : Set.range ((Scheme.Etale.forget D₀.left).obj Y).hom.base ⊆
          (W_comp j : Set ↥D₀.left) then
        (0 : ↑(𝒮₀.obj.obj (Opposite.op Y)))
      else
        have hY : Y = (F_open D₀.left (V_cov j)).obj U := by
          rcases hf with ⟨h1, _⟩ | ⟨h2, _⟩
          · exact h1
          · exfalso; subst h2; exact hW hFW_sub
        Eq.ndrec (motive := fun Z => ↑(𝒮₀.obj.obj (Opposite.op Z))) r hY.symm
    have hx_V : x_fam (π_open D₀.left (V_cov j) U) (Or.inl ⟨rfl, rfl⟩) = r := by
      by_cases hW : Set.range ((Scheme.Etale.forget D₀.left).obj
          ((F_open D₀.left (V_cov j)).obj U)).hom.base ⊆ (W_comp j : Set ↥D₀.left)
      · have hSub : Subsingleton ↑(𝒮₀.obj.obj
            (Opposite.op ((F_open D₀.left (V_cov j)).obj U))) := by
          refine hS_U₀ _ ?_
          rintro _ ⟨y, rfl⟩
          exact hVW_inter j ⟨y.2, hW ⟨y, rfl⟩⟩
        exact @Subsingleton.elim _ hSub _ _
      · exact dite_eq_right_iff.mpr fun h => False.elim (hW h)
    have hx_compat : x_fam.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      have hf₁_cases := hf₁
      have hf₂_cases := hf₂
      rcases hf₁_cases with ⟨hY₁, hf₁'⟩ | ⟨hY₁, hf₁'⟩ <;>
        rcases hf₂_cases with ⟨hY₂, hf₂'⟩ | ⟨hY₂, hf₂'⟩
      · subst hY₁; subst hY₂
        dsimp only at hf₁' hf₂'
        have hf₁_eq : f₁ = π_open D₀.left (V_cov j) U := hf₁'
        have hf₂_eq : f₂ = π_open D₀.left (V_cov j) U := hf₂'
        rw [hf₁_eq, hf₂_eq] at hcomm
        have := hπ_mono D₀.left (V_cov j) U
        have hg : g₁ = g₂ := (cancel_mono (π_open D₀.left (V_cov j) U)).mp hcomm
        subst hg
        have hxf : x_fam f₁ hf₁ = x_fam f₂ hf₂ := by
          revert hf₁ hf₂
          rw [hf₁_eq, hf₂_eq]
          intro _ _
          rfl
        rw [hxf]
      · subst hY₁; subst hY₂
        have hSubZ : Subsingleton ↑(𝒮₀.obj.obj (Opposite.op Z)) := by
          refine hS_U₀ Z ?_
          rintro _ ⟨z, rfl⟩
          apply hVW_inter j
          have hw₁ := congrArg (fun k => k.base z)
            (CategoryTheory.Over.w ((Scheme.Etale.forget D₀.left).map g₁))
          have hw₂ := congrArg (fun k => k.base z)
            (CategoryTheory.Over.w ((Scheme.Etale.forget D₀.left).map g₂))
          exact ⟨by rw [← hw₁]; exact (((Scheme.Etale.forget D₀.left).map g₁).left.base z).2,
            by rw [← hw₂]; exact (((Scheme.Etale.forget D₀.left).map g₂).left.base z).2⟩
        exact @Subsingleton.elim _ hSubZ _ _
      · subst hY₁; subst hY₂
        have hSubZ : Subsingleton ↑(𝒮₀.obj.obj (Opposite.op Z)) := by
          refine hS_U₀ Z ?_
          rintro _ ⟨z, rfl⟩
          apply hVW_inter j
          have hw₁ := congrArg (fun k => k.base z)
            (CategoryTheory.Over.w ((Scheme.Etale.forget D₀.left).map g₁))
          have hw₂ := congrArg (fun k => k.base z)
            (CategoryTheory.Over.w ((Scheme.Etale.forget D₀.left).map g₂))
          exact ⟨by rw [← hw₂]; exact (((Scheme.Etale.forget D₀.left).map g₂).left.base z).2,
            by rw [← hw₁]; exact (((Scheme.Etale.forget D₀.left).map g₁).left.base z).2⟩
        exact @Subsingleton.elim _ hSubZ _ _
      · subst hY₁; subst hY₂
        have hxf₁ : x_fam f₁ hf₁ =
            (0 : ↑(𝒮₀.obj.obj (Opposite.op ((F_open D₀.left (W_comp j)).obj U)))) :=
          dite_eq_left_iff.mpr fun h => False.elim (h hFW_sub)
        change (𝒮₀.obj.map g₁.op).hom (x_fam f₁ hf₁) =
          (𝒮₀.obj.map g₂.op).hom (x_fam f₂ hf₂)
        rw [hxf₁, map_zero, map_zero]
    let s₀ : ↑(𝒮₀.obj.obj (Opposite.op U)) := hSh.amalgamate x_fam hx_compat
    have hs₀_V : (𝒮₀.obj.map (Opposite.op (π_open D₀.left (V_cov j) U))).hom s₀ = r := by
      have hv := hSh.valid_glue hx_compat (π_open D₀.left (V_cov j) U) (Or.inl ⟨rfl, rfl⟩)
      exact hv.trans hx_V
    have hs₀_W : (𝒮₀.obj.map (Opposite.op (π_open D₀.left (W_comp j) U))).hom s₀ = 0 := by
      have hv := hSh.valid_glue hx_compat (π_open D₀.left (W_comp j) U) (Or.inr ⟨rfl, rfl⟩)
      have hx_W : x_fam (π_open D₀.left (W_comp j) U) (Or.inr ⟨rfl, rfl⟩) =
          (0 : ↑(𝒮₀.obj.obj (Opposite.op ((F_open D₀.left (W_comp j)).obj U)))) :=
        dite_eq_left_iff.mpr fun h => False.elim (h hFW_sub)
      exact hv.trans hx_W
    refine ⟨s₀, ⟨hs₀_V, hs₀_W⟩, ?_⟩
    rintro s' ⟨hs'_V, hs'_W⟩
    refine hSh.isSeparatedFor (fun Y f _ => P_set.map f.op s') s' s₀
      (fun _ _ _ => rfl) (fun Y f hf => ?_)
    change (𝒮₀.obj.map f.op).hom s₀ = (𝒮₀.obj.map f.op).hom s'
    rcases hf with ⟨hY, hf'⟩ | ⟨hY, hf'⟩
    · subst hY
      dsimp only at hf'
      rw [hf']
      exact hs₀_V.trans hs'_V.symm
    · subst hY
      dsimp only at hf'
      rw [hf']
      exact hs₀_W.trans hs'_W.symm

  let σ_fun : ∀ (j : Fin n_cov) (U : D₀.left.Etale),
      ↑((ℛ j).obj.obj (Opposite.op U)) → ↑(𝒮₀.obj.obj (Opposite.op U)) :=
    fun j U r => (h_amalg_ex j U r).choose

  have hσ_spec : ∀ (j : Fin n_cov) (U : D₀.left.Etale) (r : ↑((ℛ j).obj.obj (Opposite.op U))),
      (𝒮₀.obj.map (Opposite.op (π_open D₀.left (V_cov j) U))).hom (σ_fun j U r) = r ∧
      (𝒮₀.obj.map (Opposite.op (π_open D₀.left (W_comp j) U))).hom (σ_fun j U r) = 0 :=
    fun j U r => (h_amalg_ex j U r).choose_spec.1

  have hσ_uniq : ∀ (j : Fin n_cov) (U : D₀.left.Etale) (r : ↑((ℛ j).obj.obj (Opposite.op U)))
      (s : ↑(𝒮₀.obj.obj (Opposite.op U))),
      (𝒮₀.obj.map (Opposite.op (π_open D₀.left (V_cov j) U))).hom s = r →
      (𝒮₀.obj.map (Opposite.op (π_open D₀.left (W_comp j) U))).hom s = 0 →
      s = σ_fun j U r :=
    fun j U r s h1 h2 => (h_amalg_ex j U r).choose_spec.2 s ⟨h1, h2⟩

  let σ : ∀ j : Fin n_cov, ℛ j ⟶ 𝒮₀ := fun j =>
    { hom :=
      { app := fun U => AddCommGrpCat.ofHom
          { toFun := σ_fun j U.unop
            map_zero' := (hσ_uniq j U.unop 0 0 (map_zero _) (map_zero _)).symm
            map_add' := fun r₁ r₂ => (hσ_uniq j U.unop (r₁ + r₂)
              (σ_fun j U.unop r₁ + σ_fun j U.unop r₂)
              (by rw [map_add, (hσ_spec j U.unop r₁).1, (hσ_spec j U.unop r₂).1])
              (by rw [map_add, (hσ_spec j U.unop r₁).2, (hσ_spec j U.unop r₂).2, add_zero])).symm }
        naturality := fun {U₁ U₂} g => by
          ext r
          change σ_fun j U₂.unop (((ℛ j).obj.map g).hom r) =
            (𝒮₀.obj.map g).hom (σ_fun j U₁.unop r)
          apply (hσ_uniq j U₂.unop (((ℛ j).obj.map g).hom r) _ ?_ ?_).symm
          · have hnat := hπ_nat D₀.left (V_cov j) g.unop
            have h1 : g ≫ Opposite.op (π_open D₀.left (V_cov j) U₂.unop) =
                Opposite.op (π_open D₀.left (V_cov j) U₁.unop) ≫
                  Opposite.op ((F_open D₀.left (V_cov j)).map g.unop) := by
              change Opposite.op (π_open D₀.left (V_cov j) U₂.unop ≫ g.unop) =
                Opposite.op ((F_open D₀.left (V_cov j)).map g.unop ≫
                  π_open D₀.left (V_cov j) U₁.unop)
              rw [hnat]
            change ((𝒮₀.obj.map g ≫ 𝒮₀.obj.map (Opposite.op (π_open D₀.left (V_cov j) U₂.unop))).hom)
              (σ_fun j U₁.unop r) = _
            rw [← 𝒮₀.obj.map_comp, h1, 𝒮₀.obj.map_comp]
            change (((ℛ j).obj.map g).hom)
              ((𝒮₀.obj.map (Opposite.op (π_open D₀.left (V_cov j) U₁.unop))).hom
                (σ_fun j U₁.unop r)) = _
            rw [(hσ_spec j U₁.unop r).1]
          · have hnat := hπ_nat D₀.left (W_comp j) g.unop
            have h1 : g ≫ Opposite.op (π_open D₀.left (W_comp j) U₂.unop) =
                Opposite.op (π_open D₀.left (W_comp j) U₁.unop) ≫
                  Opposite.op ((F_open D₀.left (W_comp j)).map g.unop) := by
              change Opposite.op (π_open D₀.left (W_comp j) U₂.unop ≫ g.unop) =
                Opposite.op ((F_open D₀.left (W_comp j)).map g.unop ≫
                  π_open D₀.left (W_comp j) U₁.unop)
              rw [hnat]
            change ((𝒮₀.obj.map g ≫ 𝒮₀.obj.map (Opposite.op (π_open D₀.left (W_comp j) U₂.unop))).hom)
              (σ_fun j U₁.unop r) = 0
            rw [← 𝒮₀.obj.map_comp, h1, 𝒮₀.obj.map_comp]
            change ((𝒮₀.obj.map (Opposite.op ((F_open D₀.left (W_comp j)).map g.unop))).hom)
              ((𝒮₀.obj.map (Opposite.op (π_open D₀.left (W_comp j) U₁.unop))).hom
                (σ_fun j U₁.unop r)) = 0
            rw [(hσ_spec j U₁.unop r).2, map_zero] } }

  have hRetr : ∀ j : Fin n_cov, σ j ≫ η j = 𝟙 (ℛ j) := by
    intro j
    ext U r
    exact (hσ_spec j U.unop r).1

  have hOrth : ∀ (i j : Fin n_cov), i ≠ j → σ j ≫ η i = 0 := by
    intro i j hij
    ext U r
    let O_Vi := O_pre D₀.left (V_cov i) U.unop
    let O_Wj := O_pre D₀.left (W_comp j) U.unop
    have _ : IsOpenImmersion O_Vi.ι := O_Vi.instIsOpenImmersionι
    have _ : IsOpenImmersion O_Wj.ι := O_Wj.instIsOpenImmersionι
    have hr : Set.range O_Vi.ι.base ⊆ Set.range O_Wj.ι.base := by
      rw [Scheme.Opens.range_ι, Scheme.Opens.range_ι]
      intro u hu
      exact hV_sub_W i j hij hu
    let lift_ij : O_Vi.toScheme ⟶ O_Wj.toScheme := IsOpenImmersion.lift O_Wj.ι O_Vi.ι hr
    let mor_ij : (F_open D₀.left (V_cov i)).obj U.unop ⟶
        (F_open D₀.left (W_comp j)).obj U.unop :=
      MorphismProperty.Over.homMk lift_ij
        (by
          change lift_ij ≫ (O_Wj.ι ≫ _) = O_Vi.ι ≫ _
          rw [← Category.assoc, IsOpenImmersion.lift_fac])
        trivial
    have hfac : mor_ij ≫ π_open D₀.left (W_comp j) U.unop =
        π_open D₀.left (V_cov i) U.unop := by
      apply hEtale_ext
      exact IsOpenImmersion.lift_fac O_Wj.ι O_Vi.ι hr
    change (𝒮₀.obj.map (π_open D₀.left (V_cov i) U.unop).op).hom
      (σ_fun j U.unop r) = 0
    rw [← hfac, op_comp, 𝒮₀.obj.map_comp]
    change (𝒮₀.obj.map mor_ij.op).hom
      ((𝒮₀.obj.map (Opposite.op (π_open D₀.left (W_comp j) U.unop))).hom (σ_fun j U.unop r)) = 0
    rw [(hσ_spec j U.unop r).2, map_zero]

  have hSum_id : (∑ j : Fin n_cov, η j ≫ σ j) = 𝟙 𝒮₀ := by
    ext U s
    let R_all : Presieve U.unop := fun {Y} f =>
      ∃ i : Fin n_cov, ∃ hY : Y = (F_open D₀.left (V_cov i)).obj U.unop,
        hY ▸ f = π_open D₀.left (V_cov i) U.unop
    have hCov_all : Sieve.generate R_all ∈ J_D U.unop := by
      rw [hEtale_mem]
      intro u
      have hu : ((Scheme.Etale.forget D₀.left).obj U.unop).hom.base u ∈
          ⋃ i : Fin n_cov, (V_cov i : Set ↥D₀.left) := by
        rw [hCov_univ]
        trivial
      rw [Set.mem_iUnion] at hu
      rcases hu with ⟨i, hui⟩
      let O_Vi := O_pre D₀.left (V_cov i) U.unop
      have _ : IsOpenImmersion O_Vi.ι := O_Vi.instIsOpenImmersionι
      have hu_r : u ∈ Set.range O_Vi.ι.base := by
        rw [Scheme.Opens.range_ι]
        exact hui
      rcases hu_r with ⟨y, hy⟩
      exact ⟨(F_open D₀.left (V_cov i)).obj U.unop, π_open D₀.left (V_cov i) U.unop, y,
        ⟨_, 𝟙 _, π_open D₀.left (V_cov i) U.unop, ⟨i, rfl, rfl⟩, Category.id_comp _⟩,
        hπ_etale D₀.left (V_cov i) U.unop, hy⟩
    have hSh_all := hSheaf_S₀.isSheafFor R_all hCov_all
    let s_lhs : ↑(𝒮₀.obj.obj U) := (((∑ j : Fin n_cov, η j ≫ σ j).hom.app U).hom) s
    change s_lhs = s
    refine hSh_all.isSeparatedFor (fun Y f _ => P_set.map f.op s_lhs) s_lhs s
      (fun _ _ _ => rfl) (fun Y f hf => ?_)
    change (𝒮₀.obj.map f.op).hom s = (𝒮₀.obj.map f.op).hom s_lhs
    rcases hf with ⟨i, hY, hf'⟩
    subst hY
    dsimp only at hf'
    rw [hf']
    symm
    change (((∑ j : Fin n_cov, η j ≫ σ j) ≫ η i).hom.app U).hom s = ((η i).hom.app U).hom s
    rw [Preadditive.sum_comp]
    have hsum_eq : (∑ j : Fin n_cov, (η j ≫ σ j) ≫ η i) = η i := by
      rw [Finset.sum_eq_single i]
      · rw [Category.assoc, hRetr i, Category.comp_id]
      · intro j _ hij
        rw [Category.assoc, hOrth i j hij.symm, Limits.comp_zero]
      · intro hi; exact False.elim (hi (Finset.mem_univ i))
    rw [hsum_eq]

  
  
  
  let J_S := S.smallEtaleTopology
  let W_bar : Fin n_cov → S.Opens :=
    fun j => (TopologicalSpace.Opens.map pr_D.base).obj (W_comp j)

  have hR_bar_W : ∀ j : Fin n_cov,
      Subsingleton ↑((L_pr.obj (ℛ j)).obj.obj (Opposite.op (Scheme.Etale.mk (W_bar j).ι))) := by
    intro j
    let ℛ₀ := ℛ j
    let ℛ_bar := L_pr.obj ℛ₀
    have _ := hCont_pr
    have _ := hAdj_pr
    have _ := hOpen_cont S (W_bar j)
    let B := weilEtaleSitePullback pr_D
    let R_pr := B.sheafPushforwardContinuous AddCommGrpCat.{u} J_D J_S
    let adj_pr : L_pr ⊣ R_pr := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J_D J_S
    let ℋ : Sheaf J_S AddCommGrpCat.{u} :=
      ((F_open S (W_bar j)).sheafPushforwardContinuous AddCommGrpCat.{u} J_S J_S).obj ℛ_bar
    let ρ : ℛ_bar ⟶ ℋ :=
      { hom :=
        { app := fun Y => ℛ_bar.obj.map (Opposite.op (π_open S (W_bar j) Y.unop))
          naturality := fun {Y₁ Y₂} g => by
            change ℛ_bar.obj.map g ≫ ℛ_bar.obj.map (Opposite.op (π_open S (W_bar j) Y₂.unop)) =
              ℛ_bar.obj.map (Opposite.op (π_open S (W_bar j) Y₁.unop)) ≫
                ℛ_bar.obj.map (Opposite.op ((F_open S (W_bar j)).map g.unop))
            rw [← ℛ_bar.obj.map_comp, ← ℛ_bar.obj.map_comp]
            congr 1
            change Opposite.op (π_open S (W_bar j) Y₂.unop ≫ g.unop) =
              Opposite.op ((F_open S (W_bar j)).map g.unop ≫ π_open S (W_bar j) Y₁.unop)
            rw [hπ_nat S (W_bar j) g.unop] } }
    let ρ_tilde : ℛ₀ ⟶ R_pr.obj ℋ := (adj_pr.homEquiv ℛ₀ ℋ) ρ
    have hρ_tilde_zero : ρ_tilde = 0 := by
      ext U x_sec
      let U_W := (F_open D₀.left (W_comp j)).obj U.unop
      let ι_U : U_W ⟶ U.unop := π_open D₀.left (W_comp j) U.unop
      let Z₁ := (F_open S (W_bar j)).obj (B.obj U.unop)
      let Z₂ := (F_open S (W_bar j)).obj (B.obj U_W)
      let π_Z₁ : Z₁ ⟶ B.obj U.unop := π_open S (W_bar j) (B.obj U.unop)
      let α_U : Z₂ ⟶ Z₁ := (F_open S (W_bar j)).map (B.map ι_U)
      have hZ₁_sub : Set.range ((Scheme.Etale.forget S).obj Z₁).hom.base ⊆
          (W_bar j : Set ↥S) := by
        rintro _ ⟨z, rfl⟩
        exact z.2
      obtain ⟨δ_Z₁, hδ_Z₁⟩ := hOpen_sec S (W_bar j) hZ₁_sub
      let Z₁_left : Scheme.{u} := ((Scheme.Etale.forget S).obj Z₁).left
      let U_left : Scheme.{u} := ((Scheme.Etale.forget D₀.left).obj U.unop).left
      let hU_D : U_left ⟶ D₀.left := ((Scheme.Etale.forget D₀.left).obj U.unop).hom
      let O_WU : U_left.Opens := O_pre D₀.left (W_comp j) U.unop
      have _ : IsOpenImmersion O_WU.ι := O_WU.instIsOpenImmersionι
      let π_Z₁_left : Z₁_left ⟶ Limits.pullback hU_D pr_D :=
        ((Scheme.Etale.forget S).map π_Z₁).left
      let p₁ : Z₁_left ⟶ U_left := π_Z₁_left ≫ Limits.pullback.fst hU_D pr_D
      let p₂ : Z₁_left ⟶ S := π_Z₁_left ≫ Limits.pullback.snd hU_D pr_D
      have hp_cond : p₁ ≫ hU_D = p₂ ≫ pr_D := by
        change (π_Z₁_left ≫ Limits.pullback.fst hU_D pr_D) ≫ hU_D =
          (π_Z₁_left ≫ Limits.pullback.snd hU_D pr_D) ≫ pr_D
        rw [Category.assoc π_Z₁_left, Limits.pullback.condition, Category.assoc π_Z₁_left]
      have hp₁_range : Set.range p₁.base ⊆ Set.range O_WU.ι.base := by
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨z, rfl⟩
        change (p₁ ≫ hU_D).base z ∈ W_comp j
        rw [hp_cond, Scheme.Hom.comp_apply]
        exact hZ₁_sub ⟨z, rfl⟩
      let p₁'_raw : Z₁_left ⟶ O_WU.toScheme := IsOpenImmersion.lift O_WU.ι p₁ hp₁_range
      have hp₁'_fac : p₁'_raw ≫ O_WU.ι = p₁ := IsOpenImmersion.lift_fac O_WU.ι p₁ hp₁_range
      let p₁' : Z₁_left ⟶ ((Scheme.Etale.forget D₀.left).obj U_W).left := p₁'_raw
      have hp'_comm : p₁' ≫ ((Scheme.Etale.forget D₀.left).obj U_W).hom = p₂ ≫ pr_D := by
        change p₁'_raw ≫ (O_WU.ι ≫ hU_D) = p₂ ≫ pr_D
        rw [← Category.assoc, hp₁'_fac]
        exact hp_cond
      let γ_left : Z₁_left ⟶ Limits.pullback ((Scheme.Etale.forget D₀.left).obj U_W).hom pr_D :=
        Limits.pullback.lift p₁' p₂ hp'_comm
      let γ_U : Z₁ ⟶ B.obj U_W :=
        MorphismProperty.Over.homMk γ_left (Limits.pullback.lift_snd _ _ _) trivial
      have hγ_comp : γ_U ≫ B.map ι_U = π_Z₁ := by
        apply hEtale_ext
        let b_map_left : Limits.pullback ((Scheme.Etale.forget D₀.left).obj U_W).hom pr_D ⟶
            Limits.pullback hU_D pr_D :=
          ((Scheme.Etale.forget S).map (B.map ι_U)).left
        change γ_left ≫ b_map_left = π_Z₁_left
        apply Limits.pullback.hom_ext
        · rw [Category.assoc γ_left]
          have hB_fst : b_map_left ≫ Limits.pullback.fst hU_D pr_D =
              Limits.pullback.fst ((Scheme.Etale.forget D₀.left).obj U_W).hom pr_D ≫
                ((Scheme.Etale.forget D₀.left).map ι_U).left :=
            Limits.pullback.lift_fst _ _ _
          rw [hB_fst, ← Category.assoc γ_left]
          have hγ_fst : γ_left ≫
              Limits.pullback.fst ((Scheme.Etale.forget D₀.left).obj U_W).hom pr_D = p₁' :=
            Limits.pullback.lift_fst p₁' p₂ hp'_comm
          rw [hγ_fst]
          exact hp₁'_fac
        · rw [Category.assoc γ_left]
          have hB_snd : b_map_left ≫ Limits.pullback.snd hU_D pr_D =
              Limits.pullback.snd ((Scheme.Etale.forget D₀.left).obj U_W).hom pr_D :=
            Limits.pullback.lift_snd _ _ _
          rw [hB_snd]
          exact Limits.pullback.lift_snd p₁' p₂ hp'_comm
      let β_U : Z₁ ⟶ Z₂ := δ_Z₁ ≫ (F_open S (W_bar j)).map γ_U
      have hβα : β_U ≫ α_U = 𝟙 Z₁ := by
        have := hπ_mono S (W_bar j) (B.obj U.unop)
        apply (cancel_mono π_Z₁).mp
        dsimp [β_U, α_U]
        rw [Category.assoc δ_Z₁, ← Functor.map_comp, hγ_comp, Category.assoc,
          hπ_nat S (W_bar j) π_Z₁, ← Category.assoc δ_Z₁, hδ_Z₁]
      have hnat_ρ := congrArg (fun m => m.hom x_sec) (ρ_tilde.hom.naturality ι_U.op)
      dsimp at hnat_ρ
      have hSub_UW : Subsingleton ↑(ℛ₀.obj.obj (Opposite.op U_W)) :=
        hR_W j U_W (by rintro _ ⟨y, rfl⟩; exact y.2)
      have hx_UW_zero : (ℛ₀.obj.map ι_U.op).hom x_sec = 0 :=
        @Subsingleton.elim _ hSub_UW _ _
      rw [hx_UW_zero, map_zero] at hnat_ρ
      have h_id_app := congrArg (ℛ_bar.obj.map β_U.op).hom hnat_ρ.symm
      have h_zero_rhs : (ℛ_bar.obj.map β_U.op).hom 0 = 0 := map_zero _
      have h_id_app' := h_id_app.trans h_zero_rhs
      have hcomp_id : (ℛ_bar.obj.map β_U.op).hom
          (((R_pr.obj ℋ).obj.map ι_U.op).hom ((ρ_tilde.hom.app U).hom x_sec)) =
          (ρ_tilde.hom.app U).hom x_sec := by
