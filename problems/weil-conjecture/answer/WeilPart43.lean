          (U : AlgebraicGeometry.Scheme.{u})
          (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R)) U),
          let V := AlgebraicGeometry.Spec (CommRingCat.of S)
          let π : V ⟶ U :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S)) ≫ e_U.hom
          (AlgebraicGeometry.Etale π ∧ AlgebraicGeometry.Surjective π) ∧
          (∀ (W : AlgebraicGeometry.Scheme.{u}) (h_W : W ⟶ U),
            let W_V := CategoryTheory.Limits.pullback h_W π
            (AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.fst h_W π) ∧
              AlgebraicGeometry.Surjective (CategoryTheory.Limits.pullback.fst h_W π)) ∧
            (∀ σ : S ≃ₐ[R] S,
              ∃! m_σ : W_V ⟶ W_V,
                m_σ ≫ CategoryTheory.Limits.pullback.fst h_W π =
                  CategoryTheory.Limits.pullback.fst h_W π ∧
                m_σ ≫ CategoryTheory.Limits.pullback.snd h_W π =
                  CategoryTheory.Limits.pullback.snd h_W π ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) ∧
            (∀ y₁ y₂ : ↥W_V,
