        (q_can W).base ((m_act W τ).base y) = (m_B_act W (res τ)).base ((q_can W).base y) := by
      intro W τ y
      have h := congrArg (fun m => m.base y) (hm_q_comm W τ)
      simpa only [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Function.comp_apply] using h

    
    have hDiagExt : ∀ (W : U.Etale)
        (g_Y : ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).left ⟶ V_r),
