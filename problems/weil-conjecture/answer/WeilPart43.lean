            apply sub_eq_zero.mp
            refine hSheafEqZero 𝒢 S₁ hS₁_mem
              ((𝒢.obj.map u.op).hom (psi_fun U₂ t) -
                psi_fun U₁ ((𝒥_h.obj.map u.op).hom t)) ?_
            intro Z w hw
            have hwS₂ : S₂.arrows (w ≫ u) := hw
            rcases hwS₂ with ⟨_, v, _, hpres, hvwu⟩
            rcases hpres with ⟨idx⟩
            rw [map_sub, sub_eq_zero, ← 𝒢.obj.map_comp_apply, ← op_comp]
            rcases idx with ⟨⟩ | c
            · have h_rhs := hpsi_spec U₂ t (w ≫ u) 0 (Or.inl ⟨fun y₂ ⟨z, hz⟩ => by
                apply hW₀_zero y₂
                have h1 : (Fgt_Y.map (w ≫ u)).left.base z =
                    W₀.ι.base ((Fgt_Y.map v).left.base z) :=
                  congrArg (fun k => (Fgt_Y.map k).left.base z) hvwu.symm
                rw [← hz, h1, ← SetLike.mem_coe, ← hOpensRange W₀]
                exact ⟨(Fgt_Y.map v).left.base z, rfl⟩, rfl⟩)
              have h_lhs := hpsi_spec U₁ ((𝒥_h.obj.map u.op).hom t) w 0
                (Or.inl ⟨fun y₁ ⟨z, hz⟩ => by
                  rw [hnat_t y₁]
                  apply hW₀_zero (u_V.base y₁)
                  have h1 : fst₂.base (u_V.base y₁) =
                      (Fgt_Y.map u).left.base (fst₁.base y₁) :=
                    congrArg (fun k : U₁_V ⟶ (Fgt_Y.obj U₂).left => k.base y₁)
                      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                  have h2 : (Fgt_Y.map u).left.base ((Fgt_Y.map w).left.base z) =
                      W₀.ι.base ((Fgt_Y.map v).left.base z) :=
                    congrArg (fun k => (Fgt_Y.map k).left.base z) hvwu.symm
                  rw [h1, ← hz, h2, ← SetLike.mem_coe, ← hOpensRange W₀]
                  exact ⟨(Fgt_Y.map v).left.base z, rfl⟩, rfl⟩)
              rw [h_rhs, h_lhs]
            · let O_c : U₂_V.Opens := ⟨f₂ ⁻¹' {c}, f₂.isLocallyConstant {c}⟩
              let v_O : (Fgt_Y.obj Z).left ⟶ O_c.toScheme := (Fgt_Y.map v).left
              have hwu_left : (Fgt_Y.map (w ≫ u)).left =
                  v_O ≫ O_c.ι ≫ fst₂ :=
                congrArg (fun k => (Fgt_Y.map k).left) hvwu.symm
              let l₂ : (Fgt_Y.obj Z).left ⟶ U₂_V := v_O ≫ O_c.ι
              have hl₂_fst : l₂ ≫ fst₂ = (Fgt_Y.map (w ≫ u)).left := by
                dsimp [l₂]; rw [Category.assoc]; exact hwu_left.symm
              let l₁ : (Fgt_Y.obj Z).left ⟶ U₁_V :=
                CategoryTheory.Limits.pullback.lift (Fgt_Y.map w).left (l₂ ≫ snd₂)
                  (by
                    calc (Fgt_Y.map w).left ≫ h₁
                        = (Fgt_Y.obj Z).hom := CategoryTheory.Over.w (Fgt_Y.map w)
                      _ = (Fgt_Y.map (w ≫ u)).left ≫ h₂ :=
                            (CategoryTheory.Over.w (Fgt_Y.map (w ≫ u))).symm
                      _ = (l₂ ≫ fst₂) ≫ h₂ := by rw [hl₂_fst]
                      _ = (l₂ ≫ snd₂) ≫ ι_Y := by
                            rw [Category.assoc l₂ fst₂ h₂,
                              CategoryTheory.Limits.pullback.condition (f := h₂) (g := ι_Y),
                              ← Category.assoc l₂ snd₂ ι_Y])
              have hl₁_fst : l₁ ≫ fst₁ = (Fgt_Y.map w).left :=
                CategoryTheory.Limits.pullback.lift_fst _ _ _
              have hl₁_snd : l₁ ≫ snd₁ = l₂ ≫ snd₂ :=
                CategoryTheory.Limits.pullback.lift_snd _ _ _
              have hl₁_uV : l₁ ≫ u_V = l₂ := by
                apply CategoryTheory.Limits.pullback.hom_ext
                · dsimp [u_V, fst₁, fst₂]
                  rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, ← Category.assoc]
                  change (l₁ ≫ fst₁) ≫ (Fgt_Y.map u).left = l₂ ≫ fst₂
                  rw [hl₁_fst, hl₂_fst]; rfl
                · dsimp [u_V, snd₁, snd₂]
                  rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
