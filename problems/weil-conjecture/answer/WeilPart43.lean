        ∀ (ι_0 : (↥B₂_0 ⧸ I_h₀) →+* L_Sigma)
          (Ψ : (L₂ ≃ₐ[K₂] L₂) →* (L_Sigma ≃ₐ[K₁] L_Sigma)),
          (∀ g : MvPolynomial (Fin 2) k,
            ι_0 (Ideal.Quotient.mk I_h₀ (algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0 g)) =
              algebraMap K₁ L_Sigma (θ_0 g)) →
          (let D_0 : Subalgebra k K₁ := θ_0.range
           letI : Algebra ↥D_0 L_Sigma :=
             ((algebraMap K₁ L_Sigma).comp D_0.val.toRingHom).toAlgebra
           ∀ z : L_Sigma, z ∈ Set.range ι_0 ↔ IsIntegral ↥D_0 z) →
          (∀ (σ : L₂ ≃ₐ[K₂] L₂) (y y' : ↥B₂_0),
            (y' : L₂) = σ (y : L₂) →
            (Ψ σ) (ι_0 (Ideal.Quotient.mk I_h₀ y)) = ι_0 (Ideal.Quotient.mk I_h₀ y')) →
          ∀ (ev₂ : R₂ →ₐ[k] k) (s₂ : R₂) (s₁ : K₁) (p : Fin 2 → k)
            (Q₂ : Ideal ↥(integralClosure R₂ L_Sigma)),
            Q₂.IsPrime →
            Ideal.comap (algebraMap R₂ ↥(integralClosure R₂ L_Sigma)) Q₂ =
              RingHom.ker ev₂.toRingHom →
            ev₂ s₂ ≠ 0 →
            s₁ ∈ θ_0.range →
            s₁ * algebraMap R₂ K₁ s₂ = 1 →
            (∀ f ∈ θ_0.range, ∃ (n : ℕ) (r₂ : R₂),
              f * (algebraMap R₂ K₁ s₂) ^ n = algebraMap R₂ K₁ r₂) →
            (∀ r₂ : R₂, ∃ n : ℕ, algebraMap R₂ K₁ r₂ * s₁ ^ n ∈ θ_0.range) →
            (∀ j : Fin 2, ∃ u_j : R₂,
              algebraMap R₂ K₁ s₂ * θ_0 (MvPolynomial.X j) = algebraMap R₂ K₁ u_j ∧
              ev₂ u_j = ev₂ s₂ * p j) →
            MvPolynomial.eval p h₀ = 0 ∧
            ∃ 𝔐₀ : Ideal ↥B₂_0,
              𝔐₀.IsMaximal ∧
              (∀ g : MvPolynomial (Fin 2) k,
                algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0 g ∈ 𝔐₀ ↔
                  MvPolynomial.eval p g = 0) ∧
              (∀ σ : L₂ ≃ₐ[K₂] L₂,
                (∀ y : ↥B₂_0, ∃ z ∈ 𝔐₀, (z : L₂) = σ y.1 - y.1) ↔
                (∀ w : ↥(integralClosure R₂ L_Sigma),
                  (Ψ σ) (w : L_Sigma) - (w : L_Sigma) ∈
                    Subtype.val '' (Q₂ : Set ↥(integralClosure R₂ L_Sigma)))) := by
    intro K₂ L₂ K₁ L_Sigma R₂ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ φ_0 h₀ θ_0
    let A := MvPolynomial (Fin 2) k
    letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp φ_0).toAlgebra
    intro B₂_0 I_h₀ ι_0 Ψ hι0_align hι0_range hΨ_compat
    intro ev₂ s₂ s₁ p Q₂ hQ₂_prime hQ₂_comap hs₂_ev hs₁_mem hs₁₂_one hClear_D hClear_R hCoord
    haveI : Q₂.IsPrime := hQ₂_prime
    have hClearIntegral : ∀ {A₀ B₀ F₀ : Type u} [CommRing A₀] [CommRing B₀] [Field F₀]
        [Algebra A₀ F₀] [Algebra B₀ F₀] (t_B : B₀),
        (∀ a : A₀, ∃ (n : ℕ) (b : B₀),
          algebraMap A₀ F₀ a * (algebraMap B₀ F₀ t_B) ^ n = algebraMap B₀ F₀ b) →
        ∀ x : F₀, IsIntegral A₀ x → ∃ N : ℕ, IsIntegral B₀ ((algebraMap B₀ F₀ t_B) ^ N * x) := by
      rintro A₀ B₀ F₀ _ _ _ _ _ t_B hClear x ⟨P, hP_mon, hP_eval⟩
      set d := P.natDegree with hd_def
      rcases Nat.eq_zero_or_pos d with hd0 | hd_pos
      · have hP1 : P = 1 := Polynomial.eq_one_of_monic_natDegree_zero hP_mon hd0
        rw [hP1, Polynomial.eval₂_one] at hP_eval
        exact False.elim (one_ne_zero hP_eval)
      · choose n_fn b_fn hb_fn using fun i : ℕ => hClear (P.coeff i)
        let N : ℕ := ∑ i ∈ Finset.range d, n_fn i
        have hn_le : ∀ i ∈ Finset.range d, n_fn i ≤ N * (d - i) := by
          intro i hi
          have h1 : n_fn i ≤ N := Finset.single_le_sum (fun _ _ => Nat.zero_le _) hi
          have h2 : 1 ≤ d - i := Nat.sub_pos_of_lt (Finset.mem_range.mp hi)
          exact h1.trans (Nat.le_mul_of_pos_right N h2)
        let R_sum : Polynomial B₀ :=
          ∑ i ∈ Finset.range d,
            Polynomial.monomial i (b_fn i * t_B ^ (N * (d - i) - n_fn i))
        let Q : Polynomial B₀ := Polynomial.X ^ d + R_sum
        have hR_natDeg : R_sum.natDegree ≤ d - 1 := by
          refine (Polynomial.natDegree_sum_le (Finset.range d) _).trans ?_
          rw [Finset.fold_max_le]
          refine ⟨Nat.zero_le _, fun i hi => ?_⟩
          exact (Polynomial.natDegree_monomial_le _).trans
            (Nat.le_sub_one_of_lt (Finset.mem_range.mp hi))
        have hQ_mon : Q.Monic := by
          apply Polynomial.monic_X_pow_add
          refine lt_of_le_of_lt Polynomial.degree_le_natDegree ?_
          exact WithBot.coe_lt_coe.mpr (lt_of_le_of_lt hR_natDeg (Nat.sub_lt hd_pos Nat.one_pos))
        let s : F₀ := algebraMap B₀ F₀ t_B
        refine ⟨N, Q, hQ_mon, ?_⟩
        have hP_decomp : P = (∑ i ∈ Finset.range d, Polynomial.monomial i (P.coeff i)) +
            Polynomial.X ^ d := by
          conv_lhs => rw [Polynomial.as_sum_range' P (d + 1) (Nat.lt_succ_self d)]
          rw [Finset.sum_range_succ]
          congr 1
          have hlead : P.coeff d = 1 := by rw [hd_def]; exact hP_mon.leadingCoeff
          rw [hlead, ← Polynomial.C_mul_X_pow_eq_monomial, map_one, one_mul]
        have hP_sum : (∑ i ∈ Finset.range d, algebraMap A₀ F₀ (P.coeff i) * x ^ i) + x ^ d = 0 := by
          rw [hP_decomp, Polynomial.eval₂_add, Polynomial.eval₂_finsetSum,
            Polynomial.eval₂_X_pow] at hP_eval
          convert hP_eval using 2
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.eval₂_mul, Polynomial.eval₂_C,
            Polynomial.eval₂_X_pow]
        dsimp [Q, R_sum]
        rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum]
        have hSum_eq :
            (∑ x_1 ∈ Finset.range d,
              Polynomial.eval₂ (algebraMap B₀ F₀) (s ^ N * x)
                (Polynomial.monomial x_1 (b_fn x_1 * t_B ^ (N * (d - x_1) - n_fn x_1)))) =
            ∑ i ∈ Finset.range d, s ^ (N * d) * (algebraMap A₀ F₀ (P.coeff i) * x ^ i) := by
          refine Finset.sum_congr rfl fun i hi => ?_
          rw [← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.eval₂_mul, Polynomial.eval₂_C,
            Polynomial.eval₂_X_pow, map_mul, map_pow]
          change (algebraMap B₀ F₀ (b_fn i) * s ^ (N * (d - i) - n_fn i)) * (s ^ N * x) ^ i =
            s ^ (N * d) * (algebraMap A₀ F₀ (P.coeff i) * x ^ i)
          rw [← hb_fn i, mul_pow, ← pow_mul]
          have hexp : n_fn i + (N * (d - i) - n_fn i) + N * i = N * d := by
            rw [Nat.add_sub_of_le (hn_le i hi), ← Nat.mul_add,
              Nat.sub_add_cancel (le_of_lt (Finset.mem_range.mp hi))]
          calc
            (algebraMap A₀ F₀ (P.coeff i) * s ^ n_fn i * s ^ (N * (d - i) - n_fn i)) *
                (s ^ (N * i) * x ^ i) =
                (s ^ n_fn i * s ^ (N * (d - i) - n_fn i) * s ^ (N * i)) *
                (algebraMap A₀ F₀ (P.coeff i) * x ^ i) := by ring
            _ = s ^ (n_fn i + (N * (d - i) - n_fn i) + N * i) *
                (algebraMap A₀ F₀ (P.coeff i) * x ^ i) := by rw [pow_add, pow_add]
            _ = s ^ (N * d) * (algebraMap A₀ F₀ (P.coeff i) * x ^ i) := by rw [hexp]
        rw [hSum_eq, ← Finset.mul_sum, mul_pow, ← pow_mul]
        calc
          s ^ (N * d) * x ^ d +
              s ^ (N * d) * ∑ i ∈ Finset.range d, algebraMap A₀ F₀ (P.coeff i) * x ^ i =
              s ^ (N * d) *
                ((∑ i ∈ Finset.range d, algebraMap A₀ F₀ (P.coeff i) * x ^ i) + x ^ d) := by ring
          _ = 0 := by rw [hP_sum, mul_zero]
    let D_0 : Subalgebra k K₁ := θ_0.range
    letI : Algebra ↥D_0 L_Sigma := ((algebraMap K₁ L_Sigma).comp D_0.val.toRingHom).toAlgebra
    let C₂ := integralClosure R₂ L_Sigma
    let φ₀ : ↥B₂_0 →+* L_Sigma := ι_0.comp (Ideal.Quotient.mk I_h₀)
    let s1_bar : L_Sigma := algebraMap K₁ L_Sigma s₁
    let s2_bar : L_Sigma := algebraMap R₂ L_Sigma s₂
    let s2_tilde : ↥C₂ := algebraMap R₂ ↥C₂ s₂
    have hs2_tilde_val : (s2_tilde : L_Sigma) = s2_bar := rfl
    have hs2_bar_K₁ : s2_bar = algebraMap K₁ L_Sigma (algebraMap R₂ K₁ s₂) :=
      IsScalarTower.algebraMap_apply R₂ K₁ L_Sigma s₂
    have hs12_bar : s1_bar * s2_bar = 1 := by
      rw [hs2_bar_K₁, ← map_mul, hs₁₂_one, map_one]
    have hs2_tilde_notMem : ∀ n : ℕ, s2_tilde ^ n ∉ Q₂ := by
      intro n hmem
      have h1 : s2_tilde ∈ Q₂ := hQ₂_prime.mem_of_pow_mem n hmem
      have h2 : s₂ ∈ Ideal.comap (algebraMap R₂ ↥C₂) Q₂ := h1
      rw [hQ₂_comap, RingHom.mem_ker] at h2
      exact hs₂_ev h2
    have hClaimA : ∀ y : ↥B₂_0, ∃ (N : ℕ) (w : ↥C₂), (w : L_Sigma) = s2_bar ^ N * φ₀ y := by
      intro y
      have hIntD : IsIntegral ↥D_0 (φ₀ y) := (hι0_range (φ₀ y)).mp ⟨Ideal.Quotient.mk I_h₀ y, rfl⟩
      have hClearD' : ∀ a : ↥D_0, ∃ (n : ℕ) (r₂ : R₂),
          algebraMap ↥D_0 L_Sigma a * (algebraMap R₂ L_Sigma s₂) ^ n =
            algebraMap R₂ L_Sigma r₂ := by
        intro a
        obtain ⟨n, r₂, hr₂⟩ := hClear_D a.1 a.2
        refine ⟨n, r₂, ?_⟩
        change algebraMap K₁ L_Sigma a.1 * s2_bar ^ n = algebraMap R₂ L_Sigma r₂
        rw [hs2_bar_K₁, ← map_pow, ← map_mul, hr₂, ← IsScalarTower.algebraMap_apply R₂ K₁ L_Sigma]
      obtain ⟨N, hIntR⟩ := hClearIntegral s₂ hClearD' (φ₀ y) hIntD
      exact ⟨N, ⟨s2_bar ^ N * φ₀ y, hIntR⟩, rfl⟩
    have hClaimB : ∀ w : ↥C₂, ∃ (M : ℕ) (y : ↥B₂_0), φ₀ y = s1_bar ^ M * (w : L_Sigma) := by
      intro w
      let s₁_D : ↥D_0 := ⟨s₁, hs₁_mem⟩
      have hClearR' : ∀ r₂ : R₂, ∃ (n : ℕ) (b : ↥D_0),
          algebraMap R₂ L_Sigma r₂ * (algebraMap ↥D_0 L_Sigma s₁_D) ^ n =
            algebraMap ↥D_0 L_Sigma b := by
        intro r₂
        obtain ⟨n, hn⟩ := hClear_R r₂
        refine ⟨n, ⟨algebraMap R₂ K₁ r₂ * s₁ ^ n, hn⟩, ?_⟩
        change algebraMap R₂ L_Sigma r₂ * (algebraMap K₁ L_Sigma s₁) ^ n =
          algebraMap K₁ L_Sigma (algebraMap R₂ K₁ r₂ * s₁ ^ n)
        rw [IsScalarTower.algebraMap_apply R₂ K₁ L_Sigma, ← map_pow, ← map_mul]
      obtain ⟨M, hIntD⟩ := hClearIntegral s₁_D hClearR' (w : L_Sigma) w.2
      obtain ⟨ybar, hybar⟩ := (hι0_range (s1_bar ^ M * (w : L_Sigma))).mpr hIntD
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective ybar
      exact ⟨M, y, hybar⟩
    let 𝔐₀ : Ideal ↥B₂_0 :=
      { carrier := { y : ↥B₂_0 | ∃ (N : ℕ) (q : ↥C₂), q ∈ Q₂ ∧ (q : L_Sigma) = s2_bar ^ N * φ₀ y }
        zero_mem' := ⟨0, 0, Q₂.zero_mem, by simp⟩
        add_mem' := by
          rintro y₁ y₂ ⟨N₁, q₁, hq₁_mem, hq₁_eq⟩ ⟨N₂, q₂, hq₂_mem, hq₂_eq⟩
          refine ⟨N₁ + N₂, s2_tilde ^ N₂ * q₁ + s2_tilde ^ N₁ * q₂,
            Q₂.add_mem (Q₂.mul_mem_left _ hq₁_mem) (Q₂.mul_mem_left _ hq₂_mem), ?_⟩
          change (s2_tilde : L_Sigma) ^ N₂ * (q₁ : L_Sigma) + (s2_tilde : L_Sigma) ^ N₁ * (q₂ : L_Sigma) =
            s2_bar ^ (N₁ + N₂) * φ₀ (y₁ + y₂)
          rw [hs2_tilde_val, hq₁_eq, hq₂_eq, map_add]
          ring
        smul_mem' := by
          rintro c y ⟨N, q, hq_mem, hq_eq⟩
          obtain ⟨M, z_c, hzc_eq⟩ := hClaimA c
          refine ⟨M + N, z_c * q, Q₂.mul_mem_left _ hq_mem, ?_⟩
          change (z_c : L_Sigma) * (q : L_Sigma) = s2_bar ^ (M + N) * φ₀ (c * y)
          rw [hzc_eq, hq_eq, map_mul]
          ring }
    have hKey : ∀ (y : ↥B₂_0) (N : ℕ) (z : ↥C₂),
        (z : L_Sigma) = s2_bar ^ N * φ₀ y → (y ∈ 𝔐₀ ↔ z ∈ Q₂) := by
      intro y N z hz_eq
      constructor
      · rintro ⟨N', q, hq_mem, hq_eq⟩
        have hmul_eq : s2_tilde ^ N' * z = s2_tilde ^ N * q := by
          apply Subtype.ext
          change (s2_tilde : L_Sigma) ^ N' * (z : L_Sigma) = (s2_tilde : L_Sigma) ^ N * (q : L_Sigma)
          rw [hs2_tilde_val, hz_eq, hq_eq]
          ring
        have hprod_mem : s2_tilde ^ N' * z ∈ Q₂ := by
          rw [hmul_eq]
          exact Q₂.mul_mem_left _ hq_mem
        exact (hQ₂_prime.mem_or_mem hprod_mem).resolve_left (hs2_tilde_notMem N')
      · intro hz_mem
        exact ⟨N, z, hz_mem, hz_eq⟩
    have h𝔐₀_prime : 𝔐₀.IsPrime := by
      rw [Ideal.isPrime_iff]
      refine ⟨?_, ?_⟩
      · intro htop
        have h1 : (1 : ↥B₂_0) ∈ 𝔐₀ := htop ▸ Submodule.mem_top
        have h1_Q₂ : (1 : ↥C₂) ∈ Q₂ := (hKey 1 0 1 (by simp)).mp h1
        exact hQ₂_prime.ne_top (Ideal.eq_top_iff_one Q₂ |>.mpr h1_Q₂)
      · intro a b hab
        obtain ⟨N_a, z_a, hza⟩ := hClaimA a
        obtain ⟨N_b, z_b, hzb⟩ := hClaimA b
        have hzab : ((z_a * z_b : ↥C₂) : L_Sigma) = s2_bar ^ (N_a + N_b) * φ₀ (a * b) := by
          change (z_a : L_Sigma) * (z_b : L_Sigma) = s2_bar ^ (N_a + N_b) * φ₀ (a * b)
          rw [hza, hzb, map_mul]
          ring
        have hmem_ab : z_a * z_b ∈ Q₂ := (hKey (a * b) (N_a + N_b) (z_a * z_b) hzab).mp hab
        rcases hQ₂_prime.mem_or_mem hmem_ab with hza_mem | hzb_mem
        · exact Or.inl ((hKey a N_a z_a hza).mpr hza_mem)
        · exact Or.inr ((hKey b N_b z_b hzb).mpr hzb_mem)
    have hEval_clear : ∀ g : A, ∃ (N : ℕ) (r_g : R₂),
        s2_bar ^ N * algebraMap K₁ L_Sigma (θ_0 g) = algebraMap R₂ L_Sigma r_g ∧
        ev₂ r_g = (ev₂ s₂) ^ N * MvPolynomial.eval p g := by
      intro g
      induction g using MvPolynomial.induction_on with
      | C c =>
        refine ⟨0, algebraMap k R₂ c, ?_, ?_⟩
        · simp only [pow_zero, one_mul]
          change algebraMap K₁ L_Sigma (θ_0 (algebraMap k A c)) =
            algebraMap R₂ L_Sigma (algebraMap k R₂ c)
          rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R₂ K₁ L_Sigma,
            ← IsScalarTower.algebraMap_apply k R₂ K₁]
        · simp
      | add g₁ g₂ ih₁ ih₂ =>
        obtain ⟨N₁, r₁, hr₁_eq, hr₁_ev⟩ := ih₁
        obtain ⟨N₂, r₂, hr₂_eq, hr₂_ev⟩ := ih₂
        refine ⟨N₁ + N₂, s₂ ^ N₂ * r₁ + s₂ ^ N₁ * r₂, ?_, ?_⟩
        · simp only [map_add, map_mul, map_pow]
          change s2_bar ^ (N₁ + N₂) * (algebraMap K₁ L_Sigma (θ_0 g₁) + algebraMap K₁ L_Sigma (θ_0 g₂)) =
            s2_bar ^ N₂ * algebraMap R₂ L_Sigma r₁ + s2_bar ^ N₁ * algebraMap R₂ L_Sigma r₂
          rw [← hr₁_eq, ← hr₂_eq]
          ring
        · simp only [map_add, map_mul, map_pow, hr₁_ev, hr₂_ev]
          ring
      | mul_X g₁ j ih₁ =>
        obtain ⟨N₁, r₁, hr₁_eq, hr₁_ev⟩ := ih₁
        obtain ⟨u_j, hu_eq, hu_ev⟩ := hCoord j
        refine ⟨N₁ + 1, r₁ * u_j, ?_, ?_⟩
        · rw [map_mul, map_mul, map_mul]
          have hXj : s2_bar * algebraMap K₁ L_Sigma (θ_0 (MvPolynomial.X j)) =
              algebraMap R₂ L_Sigma u_j := by
            rw [hs2_bar_K₁, ← map_mul, hu_eq, ← IsScalarTower.algebraMap_apply R₂ K₁ L_Sigma]
          calc
            s2_bar ^ (N₁ + 1) * (algebraMap K₁ L_Sigma (θ_0 g₁) *
                algebraMap K₁ L_Sigma (θ_0 (MvPolynomial.X j))) =
                (s2_bar ^ N₁ * algebraMap K₁ L_Sigma (θ_0 g₁)) *
                (s2_bar * algebraMap K₁ L_Sigma (θ_0 (MvPolynomial.X j))) := by ring
            _ = algebraMap R₂ L_Sigma r₁ * algebraMap R₂ L_Sigma u_j := by rw [hr₁_eq, hXj]
        · rw [map_mul, map_mul, MvPolynomial.eval_X, hr₁_ev, hu_ev]
          ring
    have hEval_iff : ∀ g : A, algebraMap A ↥B₂_0 g ∈ 𝔐₀ ↔ MvPolynomial.eval p g = 0 := by
      intro g
      obtain ⟨N, r_g, hrg_eq, hrg_ev⟩ := hEval_clear g
      let z_g : ↥C₂ := algebraMap R₂ ↥C₂ r_g
      have hzg_val : (z_g : L_Sigma) = s2_bar ^ N * φ₀ (algebraMap A ↥B₂_0 g) := by
        change algebraMap R₂ L_Sigma r_g =
          s2_bar ^ N * ι_0 (Ideal.Quotient.mk I_h₀ (algebraMap A ↥B₂_0 g))
        rw [hι0_align g, hrg_eq]
      rw [hKey (algebraMap A ↥B₂_0 g) N z_g hzg_val]
      change r_g ∈ Ideal.comap (algebraMap R₂ ↥C₂) Q₂ ↔ MvPolynomial.eval p g = 0
      rw [hQ₂_comap, RingHom.mem_ker]
      change ev₂ r_g = 0 ↔ MvPolynomial.eval p g = 0
      rw [hrg_ev, mul_eq_zero]
      exact ⟨fun h => h.resolve_left (pow_ne_zero N hs₂_ev), fun h => Or.inr h⟩
    have hh₀_eval : MvPolynomial.eval p h₀ = 0 := by
      rw [← hEval_iff h₀]
      refine ⟨0, 0, Q₂.zero_mem, ?_⟩
      have hmk0 : Ideal.Quotient.mk I_h₀ (algebraMap A ↥B₂_0 h₀) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      change (0 : L_Sigma) = s2_bar ^ 0 * ι_0 (Ideal.Quotient.mk I_h₀ (algebraMap A ↥B₂_0 h₀))
      rw [hmk0, map_zero, mul_zero]
    have h𝔐₀_max : 𝔐₀.IsMaximal := by
      haveI : 𝔐₀.IsPrime := h𝔐₀_prime
      have hUnder_eq : Ideal.under A 𝔐₀ = RingHom.ker (MvPolynomial.eval p) := by
        ext g
        exact hEval_iff g
      have hEval_surj : Function.Surjective (MvPolynomial.eval p) :=
        fun c => ⟨MvPolynomial.C c, MvPolynomial.eval_C c⟩
      have hUnder_max : (Ideal.under A 𝔐₀).IsMaximal := by
        rw [hUnder_eq]
        exact RingHom.ker_isMaximal_of_surjective (MvPolynomial.eval p) hEval_surj
      exact Ideal.IsIntegral.isMaximal_of_isMaximal_under (R := A) 𝔐₀ hUnder_max
    refine ⟨hh₀_eval, 𝔐₀, h𝔐₀_max, hEval_iff, fun σ => ?_⟩
    let γ : L_Sigma ≃ₐ[K₁] L_Sigma := Ψ σ
    have hγ_s₁ : γ s1_bar = s1_bar := γ.commutes s₁
