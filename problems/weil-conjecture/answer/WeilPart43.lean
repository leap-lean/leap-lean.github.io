                       Subtype.val '' (Q_a_k : Set ↥(integralClosure (Polynomial k) M_r)))) :=
by
  intro hΔ_k K₂ x₁ x₂ homCoord eval_c φ_K₂ d_Sigma d_disc H_Sigma F_disc_hom P₀ P₁ P₂ L₂
    _ _ _ _ hd_Sigma hd_disc hHom_HSigma hHom_Fdisc
    hP₀_mon hP₀_deg hP₁_deg hP₂_deg hIrr_H0 hIrr_F0 hEval_HSigma
    hSm_HSigma hCharts_Sigma hDisj_T0 hTransv_0
    hPts_Saff hConv_Saff hPt_inf hPoles_P₀ hCodim1_unram hTame_disc
  obtain ⟨hPurity2D, h3Chart⟩ := weil_net_purity_regular_surface_freeness_and_etale k
  obtain ⟨hEtale_3charts, hLocFree_3charts⟩ :=
    h3Chart d_disc F_disc_hom L₂ hd_disc hHom_Fdisc hIrr_F0 hCodim1_unram
  let ι_alg : MvPolynomial (Fin 2) k →ₐ[k] K₂ :=
    { toRingHom := algebraMap (MvPolynomial (Fin 2) k) K₂
      commutes' := fun _ => rfl }
  have hφ0_alg : φ_K₂ 0 = ι_alg := by
    apply MvPolynomial.algHom_ext
    intro j
    fin_cases j
    · dsimp [φ_K₂, ι_alg, homCoord, x₁]
      rw [MvPolynomial.aeval_X]
      exact div_one _
    · dsimp [φ_K₂, ι_alg, homCoord, x₂]
      rw [MvPolynomial.aeval_X]
      exact div_one _
  have hφ0 : (φ_K₂ 0).toRingHom = algebraMap (MvPolynomial (Fin 2) k) K₂ :=
    congrArg AlgHom.toRingHom hφ0_alg
  have hEtale_0_std :
      letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
        ((algebraMap K₂ L₂).comp (algebraMap (MvPolynomial (Fin 2) k) K₂)).toAlgebra
      let B₂_0 := integralClosure (MvPolynomial (Fin 2) k) L₂
      @RingHom.Etale
        (Localization.Away (eval_c 0 F_disc_hom))
        (Localization.Away (algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0 (eval_c 0 F_disc_hom)))
        _ _
        (Localization.awayMap (algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0)
          (eval_c 0 F_disc_hom)) := by
    have h0 := hEtale_3charts 0
    dsimp only at h0 ⊢
    rwa [hφ0] at h0
  have hTame_std :
      letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
        ((algebraMap K₂ L₂).comp (algebraMap (MvPolynomial (Fin 2) k) K₂)).toAlgebra
      let B₂_0 := integralClosure (MvPolynomial (Fin 2) k) L₂
      ∀ (Q_C : Ideal ↥B₂_0), Q_C.IsPrime →
        Ideal.comap (algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0) Q_C =
          Ideal.span {eval_c 0 F_disc_hom} →
        ringChar k = 0 ∨
        Nat.Coprime (ringChar k)
          (Nat.card { σ : L₂ ≃ₐ[K₂] L₂ //
            ∀ y : ↥B₂_0, σ (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q_C : Set ↥B₂_0) }) := by
    have hT := hTame_disc
    dsimp only at hT ⊢
    rwa [hφ0] at hT
  have hWit_0 :
      ∃ p_wit : Fin 2 → k,
        MvPolynomial.eval p_wit (eval_c 0 H_Sigma) = 0 ∧
        MvPolynomial.eval p_wit (eval_c 0 F_disc_hom) = 0 :=
    ⟨![P₁.coeff d_Sigma, P₂.coeff d_Sigma], hPt_inf.2, hPt_inf.1⟩
  obtain ⟨hLocalDVR_std, hInertiaEq_std⟩ :=
    weil_net_abhyankar_transverse_dvr_and_inertia_eq k L₂
      (eval_c 0 H_Sigma) (eval_c 0 F_disc_hom)
      hPurity2D hIrr_H0 hIrr_F0 hWit_0 (hSm_HSigma 0) hTransv_0 hEtale_0_std hTame_std
  have hLocalDVR_0 :
      ∀ (B_bar : Type u) [CommRing B_bar]
        (𝔪_bar : Ideal B_bar) [𝔪_bar.IsPrime]
        (R_bar : Type u) [CommRing R_bar] [Algebra B_bar R_bar]
        [IsLocalization.AtPrime R_bar 𝔪_bar],
        𝔪_bar.IsMaximal →
        (letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
           ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
         let B₂_0 := integralClosure (MvPolynomial (Fin 2) k) L₂
         let I_h₀ : Ideal ↥B₂_0 :=
           Ideal.span {algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0 (eval_c 0 H_Sigma)}
         Nonempty ((↥B₂_0 ⧸ I_h₀) ≃+* B_bar)) →
        IsDomain R_bar ∧ IsIntegrallyClosed R_bar := by
    dsimp only
    rwa [hφ0]
  have hInertiaEq_0 :
      ∀ p : Fin 2 → k,
        MvPolynomial.eval p (eval_c 0 H_Sigma) = 0 →
        MvPolynomial.eval p (eval_c 0 F_disc_hom) = 0 →
        letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
          ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
        let B₂_0 := integralClosure (MvPolynomial (Fin 2) k) L₂
        ∀ (𝔐₀ : Ideal ↥B₂_0), 𝔐₀.IsMaximal →
          (∀ g : MvPolynomial (Fin 2) k,
            algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0 g ∈ 𝔐₀ ↔ MvPolynomial.eval p g = 0) →
          ∃ Q_C : Ideal ↥B₂_0,
            Q_C.IsPrime ∧
            (∀ x : ↥B₂_0, x ∈ Q_C → x ∈ 𝔐₀) ∧
            Ideal.comap (algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0) Q_C =
              Ideal.span {eval_c 0 F_disc_hom} ∧
            ∀ σ : L₂ ≃ₐ[K₂] L₂,
              (∀ y : ↥B₂_0, ∃ z ∈ Q_C, (z : L₂) = σ y.1 - y.1) ↔
              (∀ y : ↥B₂_0, ∃ z ∈ 𝔐₀, (z : L₂) = σ y.1 - y.1) := by
    dsimp only
    rwa [hφ0]
  have hESZ_connected :=
    weil_net_esz_three_chart_trace_dual_connected k d_Sigma H_Sigma L₂
      hd_Sigma hHom_HSigma hIrr_H0 hLocFree_3charts
  exact ⟨hEtale_3charts,
    weil_net_curve_cover_gluing_and_galois_conj
      k S_aff_k a_k _ha_k Δ_k R₀_k _hR₀_k hΔ_k
      d_Sigma d_disc H_Sigma F_disc_hom P₀ P₁ P₂ L₂
      hd_Sigma hd_disc hHom_HSigma hHom_Fdisc
      hP₀_mon hP₀_deg hP₁_deg hP₂_deg hIrr_H0 hIrr_F0 hEval_HSigma
      hSm_HSigma hCharts_Sigma hDisj_T0 hTransv_0
      hPts_Saff hConv_Saff hPt_inf hPoles_P₀
      hEtale_3charts hLocFree_3charts hLocalDVR_0 hInertiaEq_0 hESZ_connected⟩

theorem weil_mid_dev_odp_net_level_inertia_conjugacy (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z₁.hom]
    [AlgebraicGeometry.IsProper Z₁.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z₁.hom]
    (P : WeilRationalLefschetzPencil F m Z₁)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (ι_disc : C_disc ⟶ weilProjectiveSpaceOver F 2)
    (U_disc_reg : C_disc.left.Opens)
    (hSing : WeilTransvTriIsSingularDatum F m Z₁ P j_aff s_inf S_aff U₀ C_disc ι_disc U_disc_reg)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (M_Zu_mid : WeilEllAdicCohomologyModel F P.Z_u₀ ℓ (2 * m + 1))
    (D : WeilMidDevSmoothMonodromyPackage.{u} F m P.Z_tilde P.f₀ P.u₀ P.Z_u₀ j_aff S_aff U₀ ℓ
      M_Zu_mid)
    (hDN : 1 ≤ D.N)
    (r : ℕ)
    (a : F) (ha : a ∈ S_aff) :
    letI := D.hCR r; letI := D.hFld r; letI := D.hAF_B r; letI := D.hAR_B r
    letI := D.hAF_L r; letI := D.hAP_L r; letI := D.hARF_L r; letI := D.hABL r
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    let C₀_r := integralClosure (Polynomial F) (D.L_V r)
    let A_inf_r := Algebra.adjoin F
      ({algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹} : Set (D.L_V r))
    let t_inf_r : ↥A_inf_r :=
      ⟨algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹, Algebra.self_mem_adjoin_singleton F _⟩
    let C_inf_r := integralClosure ↥A_inf_r (D.L_V r)
    ∀ (Q_inf : Ideal ↥C_inf_r), Q_inf.IsPrime →
      Ideal.comap (algebraMap ↥A_inf_r ↥C_inf_r) Q_inf = Ideal.span {t_inf_r} →
      ∀ (Q_a : Ideal ↥C₀_r), Q_a.IsPrime →
        Ideal.comap (algebraMap (Polynomial F) ↥C₀_r) Q_a =
          Ideal.span {Polynomial.X - Polynomial.C a} →
        ∃ τ_B : D.B_V r ≃ₐ[R₀] D.B_V r,
          (∀ x : D.B_V r, IsIntegral F x → τ_B x = x) ∧
          (∀ σ_B : D.B_V r ≃ₐ[R₀] D.B_V r,
            (∃ σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r,
              (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) ∧
              (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
                algebraMap (D.B_V r) (D.L_V r) (σ_B b)) ∧
              (∀ y : ↥C_inf_r,
                σ_L (y : D.L_V r) - (y : D.L_V r) ∈ Subtype.val '' (Q_inf : Set ↥C_inf_r))) ↔
            (∃ σ'_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r,
              (∀ x : D.L_V r, IsIntegral F x → σ'_L x = x) ∧
              (∀ b : D.B_V r, σ'_L (algebraMap (D.B_V r) (D.L_V r) b) =
                algebraMap (D.B_V r) (D.L_V r) ((τ_B * σ_B * τ_B⁻¹) b)) ∧
              (∀ y : ↥C₀_r,
                σ'_L (y : D.L_V r) - (y : D.L_V r) ∈ Subtype.val '' (Q_a : Set ↥C₀_r)))) :=
by
  letI := D.hCR r; letI := D.hDom r; letI := D.hFld r
  letI := D.hAF_B r; letI := D.hAP_B r; letI := D.hAR_B r
  letI := D.hAF_L r; letI := D.hAP_L r; letI := D.hARF_L r; letI := D.hABL r; letI := D.hARL r
  letI := D.hST1 r; letI := D.hST2 r; letI := D.hST3 r
  letI := D.hST4 r; letI := D.hST5 r; letI := D.hST6 r
  letI := D.hFin_B r; letI := D.hEt_B r; letI := D.hFrac r
  letI := D.hIntCl r; letI := D.hFD_L r; letI := D.hGal_L r
  intro R₀ C₀_r A_inf_r t_inf_r C_inf_r Q_inf hQ_inf_prime hQ_inf_comap Q_a hQ_a_prime hQ_a_comap

  
  have hLocAwayHom : ∀ {A B : Type u} [CommRing A] [IsDomain A] [CommRing B] [IsDomain B]
      (φ : A →+* B) (_ : Function.Injective φ)
      (dA : A) (_ : dA ≠ 0) (dB : B) (_ : dB ≠ 0) (_ : φ dA = dB),
      IsDomain (Localization.Away dA) ∧
      IsDomain (Localization.Away dB) ∧
      ∃ j : Localization.Away dA →+* Localization.Away dB,
        Function.Injective j ∧
        j.comp (algebraMap A (Localization.Away dA)) =
          (algebraMap B (Localization.Away dB)).comp φ := by
    intro A B _ _ _ _ φ hφ dA hdA dB hdB hd
    have hDomA : IsDomain (Localization.Away dA) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away dA)
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hdA))
    have hDomB : IsDomain (Localization.Away dB) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away dB)
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hdB))
    let ψ : A →+* Localization.Away dB := (algebraMap B (Localization.Away dB)).comp φ
    have hUnit : IsUnit (ψ dA) := by
      change IsUnit (algebraMap B (Localization.Away dB) (φ dA))
      rw [hd]
      exact IsLocalization.Away.algebraMap_isUnit dB
    let j : Localization.Away dA →+* Localization.Away dB :=
      IsLocalization.Away.lift (S := Localization.Away dA) dA (g := ψ) hUnit
    have hj_comp : j.comp (algebraMap A (Localization.Away dA)) = ψ :=
      RingHom.ext fun x => IsLocalization.Away.lift_eq (S := Localization.Away dA) dA hUnit x
    have hj_inj : Function.Injective j := by
      letI : IsDomain (Localization.Away dA) := hDomA
      letI : IsDomain (Localization.Away dB) := hDomB
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨p, ⟨_, n, rfl⟩⟩, hpz⟩ := IsLocalization.surj (Submonoid.powers dA) z
      have hpz' : z * (algebraMap A (Localization.Away dA) dA) ^ n =
          algebraMap A (Localization.Away dA) p := by
        simpa only [map_pow] using hpz
      have hmap0 : ψ p = 0 := by
        calc ψ p = j (algebraMap A (Localization.Away dA) p) :=
              (RingHom.congr_fun hj_comp p).symm
          _ = j (z * (algebraMap A (Localization.Away dA) dA) ^ n) := by rw [← hpz']
          _ = j z * j ((algebraMap A (Localization.Away dA) dA) ^ n) := map_mul _ _ _
          _ = 0 := by rw [hz, zero_mul]
      have hAlgB_inj : Function.Injective (algebraMap B (Localization.Away dB)) :=
        IsLocalization.injective (Localization.Away dB)
          (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hdB))
      have hpB0 : φ p = 0 :=
        hAlgB_inj (hmap0.trans (map_zero (algebraMap B (Localization.Away dB))).symm)
      have hp0 : p = 0 := hφ (hpB0.trans (map_zero φ).symm)
      rw [hp0, map_zero] at hpz'
      have hAlgA_inj : Function.Injective (algebraMap A (Localization.Away dA)) :=
        IsLocalization.injective (Localization.Away dA)
          (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hdA))
      have hd_pow_ne : (algebraMap A (Localization.Away dA) dA) ^ n ≠ 0 :=
        pow_ne_zero n ((map_ne_zero_iff _ hAlgA_inj).mpr hdA)
      exact (mul_eq_zero.mp hpz').resolve_right hd_pow_ne
    exact ⟨hDomA, hDomB, j, hj_inj, hj_comp⟩

  let k := AlgebraicClosure F
  let S_aff_k : Finset k := S_aff.map ⟨algebraMap F k, (algebraMap F k).injective⟩
  let a_k : k := algebraMap F k a
  have ha_k : a_k ∈ S_aff_k := Finset.mem_map_of_mem ⟨algebraMap F k, (algebraMap F k).injective⟩ ha
  have hMem_Saff_k : ∀ x : k, x ∈ S_aff_k ↔ ∃ s ∈ S_aff, algebraMap F k s = x := by
    intro x
    simp [S_aff_k]
  let Δ_F : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s)
  let Δ_k : Polynomial k := ∏ s_k ∈ S_aff_k, (Polynomial.X - Polynomial.C s_k)
  let R₀_k := Localization.Away Δ_k
  have hMon_F : Δ_F.Monic :=
    Polynomial.monic_prod_of_monic S_aff _ (fun s _ => Polynomial.monic_X_sub_C s)
  have hMon_k : Δ_k.Monic :=
    Polynomial.monic_prod_of_monic S_aff_k _ (fun s_k _ => Polynomial.monic_X_sub_C s_k)
  have hDelta_map : (Polynomial.mapRingHom (algebraMap F k)) Δ_F = Δ_k := by
    change Δ_F.map (algebraMap F k) = Δ_k
    dsimp [Δ_F, Δ_k, S_aff_k]
    rw [Polynomial.map_prod, Finset.prod_map]
    refine Finset.prod_congr rfl fun s _ => ?_
    rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
    rfl
  have hDelta_map_symm : Δ_k = Δ_F.map (algebraMap F k) := hDelta_map.symm
  have hinj_poly : Function.Injective (Polynomial.mapRingHom (algebraMap F k)) :=
    Polynomial.map_injective (algebraMap F k) (algebraMap F k).injective
  obtain ⟨_hDom_R₀, _hDom_R₀k, j_R₀k, hj_R₀k_inj, hj_R₀k_comp⟩ :=
    hLocAwayHom (Polynomial.mapRingHom (algebraMap F k)) hinj_poly
      Δ_F hMon_F.ne_zero Δ_k hMon_k.ne_zero hDelta_map

  
  have hAdjoin_Ainf : Algebra.adjoin F ({t_inf_r} : Set ↥A_inf_r) = ⊤ := by
    rw [eq_top_iff]
    rintro ⟨y, hy⟩ -
    induction hy using Algebra.adjoin_induction with
    | mem z hz =>
      rw [Set.mem_singleton_iff] at hz
      subst hz
      exact Algebra.self_mem_adjoin_singleton F t_inf_r
    | algebraMap c =>
      exact Subalgebra.algebraMap_mem _ c
    | add _ _ _ _ ih₁ ih₂ =>
      exact Subalgebra.add_mem _ ih₁ ih₂
    | mul _ _ _ _ ih₁ ih₂ =>
      exact Subalgebra.mul_mem _ ih₁ ih₂

  obtain ⟨B_k, M_r, hCR_Bk, hDom_Bk, hFld_Mr, hAk_Bk, hAP_Bk, hAR_Bk,
      hAk_Mr, hAP_Mr, hARF_Mr, hABM, hARM,
      hST1_Bk, hST2_Bk, hST3_Mr, hST4_Mr, hST5_Mr, hST6_Mr,
      hFin_Bk, hEt_Bk, hFrac_Bk, hIntCl_Bk, hFD_Mr, hGal_Mr,
      j_Bk, A_inf_k, hCR_Ainfk, hAk_Ainfk, hAM_Ainfk, hST_Ainfk,
      t_inf_k, Q_inf_k, Q_a_k,
      hj_Bk_inj, hj_Bk_comp, hj_Bk_adjoin,
      hA_inf_k_inj, ht_inf_k_eq, hA_inf_k_top,
      hQ_inf_k_prime, hQ_inf_k_comap, hQ_a_k_prime, hQ_a_k_comap, hDescent⟩ :=
    weil_mid_dev_net_const_field_algClosure_inertia_bridge
      F S_aff a ha R₀ k R₀_k a_k Δ_F Δ_k
      (inferInstance : IsLocalization.Away Δ_F R₀)
      (inferInstance : IsLocalization.Away Δ_k R₀_k)
      j_R₀k (D.B_V r) (D.L_V r) ↥A_inf_r t_inf_r Q_inf Q_a
      rfl rfl hDelta_map_symm hj_R₀k_inj hj_R₀k_comp
      Subtype.val_injective rfl hAdjoin_Ainf
      hQ_inf_prime hQ_inf_comap hQ_a_prime hQ_a_comap
  letI := hCR_Bk; letI := hDom_Bk; letI := hFld_Mr
  letI := hAk_Bk; letI := hAP_Bk; letI := hAR_Bk
  letI := hAk_Mr; letI := hAP_Mr; letI := hARF_Mr; letI := hABM; letI := hARM
  letI := hST1_Bk; letI := hST2_Bk; letI := hST3_Mr
  letI := hST4_Mr; letI := hST5_Mr; letI := hST6_Mr
  letI := hFin_Bk; letI := hEt_Bk; letI := hFrac_Bk
  letI := hIntCl_Bk; letI := hFD_Mr; letI := hGal_Mr
  letI := hCR_Ainfk; letI := hAk_Ainfk; letI := hAM_Ainfk; letI := hST_Ainfk

  
  let r' : ℕ := r + D.c_iso
  obtain ⟨d_Sigma, d_disc, H_Sigma, F_disc_hom, P₀, P₁, P₂, L₂,
      hFld_L₂, hAlg_L₂, hFD_L₂, hGal_L₂,
      hd_Sigma, hd_disc, hHom_HSigma, hHom_Fdisc,
      hP₀_mon, hP₀_deg, hP₁_deg, hP₂_deg, hIrr_H0, hIrr_F0, hEval_HSigma,
      hSm_HSigma, hCharts_Sigma, hDisj_T0, hTransv_0, hPts_Saff, hConv_Saff, hPt_inf, hPoles_P₀,
      hCodim1_unram, hTame_disc, hOpenTriv⟩ :=
    weil_mid_dev_net_p2_smooth_monodromy_and_odp_tameness
      F m Z₁ P j_aff s_inf S_aff U₀ C_disc ι_disc U_disc_reg hSing ℓ hℓ r' a ha
      k S_aff_k Δ_F Δ_k (Localization.Away Δ_F) R₀_k
      (inferInstance : IsLocalization.Away Δ_F (Localization.Away Δ_F))
      (inferInstance : IsLocalization.Away Δ_k R₀_k)
      hMem_Saff_k rfl rfl
  letI := hFld_L₂; letI := hAlg_L₂; letI := hFD_L₂; letI := hGal_L₂

  obtain ⟨hEtale_3charts, B_Sigma, L_Sigma, hCR_BSigma, hDom_BSigma, hFld_LSigma,
      hAk_BSigma, hAP_BSigma, hAR_BSigma, hAk_LSigma, hAP_LSigma, hARF_LSigma, hABL_Sigma,
      hARL_Sigma, hST1_BSigma, hST2_BSigma, hST3_LSigma, hST4_LSigma, hST5_LSigma, hST6_LSigma,
      hFin_BSigma, hEt_BSigma, hFrac_BSigma, hIntCl_BSigma, hFD_LSigma, hGal_LSigma,
      hEx_ψ0, hConjSubfield⟩ :=
    weil_mid_dev_net_surface_purity_esz_and_abhyankar_conj
