      intro W g_Y hg_Y h_W W_r
      let Y_left := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).left
      let P_W := CategoryTheory.Limits.pullback (g_Y ≫ π_r) π_r
      let Φ : P_W ⟶ W_r := CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (g_Y ≫ π_r) π_r)
        (CategoryTheory.Limits.pullback.snd (g_Y ≫ π_r) π_r)
        ((congrArg (CategoryTheory.Limits.pullback.fst (g_Y ≫ π_r) π_r ≫ ·) hg_Y.symm).trans
