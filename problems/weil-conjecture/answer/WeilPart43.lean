            map_zero' := by
              apply hInj_W
              ext x i
              obtain ⟨y_up, rfl⟩ := hSurj_W x
              rw [hτ_spec W 0 y_up i, map_zero, LocallyConstant.zero_apply, Pi.zero_apply,
                map_zero, map_zero, LocallyConstant.zero_apply, Pi.zero_apply]
            map_add' := fun s₁ s₂ => by
              apply hInj_W
              ext x i
              obtain ⟨y_up, rfl⟩ := hSurj_W x
              rw [hτ_spec W (s₁ + s₂) y_up i, map_add, LocallyConstant.add_apply, Pi.add_apply,
                map_add, map_add, LocallyConstant.add_apply, Pi.add_apply,
                hτ_spec W s₁ y_up i, hτ_spec W s₂ y_up i] }
    have hτ_nat : ∀ ⦃X Y : (U₀.toScheme.Etale)ᵒᵖ⦄ (f : X ⟶ Y),
        (ℒ₀ (r + 1)).obj.map f ≫ τ_app Y = τ_app X ≫ (ℒ₀ r).obj.map f := by
      intro X Y f
      let W₂ := Opposite.unop X
      let W₁ := Opposite.unop Y
      let u : W₁ ⟶ W₂ := f.unop
      have hf_eq : f = Opposite.op u := rfl
      rw [hf_eq]
      apply AddCommGrpCat.ext
      intro s₂
      have _ : AlgebraicGeometry.Surjective (m_ι_can W₁) := hm_ι_surj W₁
      have hSurj_1 : Function.Surjective (m_ι_can W₁).base := (m_ι_can W₁).surjective
      have hInj_1 : Function.Injective (triv r W₁) := (hLevel_spec r).2.2 W₁ |>.1
      apply hInj_1
      ext x₁ i
      obtain ⟨y₁, rfl⟩ := hSurj_1 x₁
      let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
      let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
      let u_left := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left
      have hu_w : u_left ≫ h₂ = h₁ :=
        ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).w
      let u_r : CategoryTheory.Limits.pullback h₁ (π_sch r) ⟶
          CategoryTheory.Limits.pullback h₂ (π_sch r) :=
        CategoryTheory.Limits.pullback.map h₁ (π_sch r) h₂ (π_sch r)
          u_left (𝟙 (V_sch r)) (𝟙 U₀.toScheme)
          (by rw [CategoryTheory.Category.comp_id, hu_w])
          (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      let u_succ : CategoryTheory.Limits.pullback h₁ (π_sch (r + 1)) ⟶
          CategoryTheory.Limits.pullback h₂ (π_sch (r + 1)) :=
        CategoryTheory.Limits.pullback.map h₁ (π_sch (r + 1)) h₂ (π_sch (r + 1))
          u_left (𝟙 (V_sch (r + 1))) (𝟙 U₀.toScheme)
          (by rw [CategoryTheory.Category.comp_id, hu_w])
          (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      have hu_r_fst : u_r ≫ CategoryTheory.Limits.pullback.fst h₂ (π_sch r) =
          CategoryTheory.Limits.pullback.fst h₁ (π_sch r) ≫ u_left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hu_r_snd : u_r ≫ CategoryTheory.Limits.pullback.snd h₂ (π_sch r) =
          CategoryTheory.Limits.pullback.snd h₁ (π_sch r) := by
        exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
          (CategoryTheory.Category.comp_id _)
      have hu_succ_fst : u_succ ≫ CategoryTheory.Limits.pullback.fst h₂ (π_sch (r + 1)) =
          CategoryTheory.Limits.pullback.fst h₁ (π_sch (r + 1)) ≫ u_left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hu_succ_snd : u_succ ≫ CategoryTheory.Limits.pullback.snd h₂ (π_sch (r + 1)) =
          CategoryTheory.Limits.pullback.snd h₁ (π_sch (r + 1)) := by
        exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
          (CategoryTheory.Category.comp_id _)
      have hm_comm : m_ι_can W₁ ≫ u_r = u_succ ≫ m_ι_can W₂ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            hu_r_fst, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst, hu_succ_fst]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            hu_r_snd, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc, hu_succ_snd]
      have hm_pt : u_r.base ((m_ι_can W₁).base y₁) = (m_ι_can W₂).base (u_succ.base y₁) :=
        congrArg (fun k => k.base y₁) hm_comm
      change triv r W₁ (τ_fun W₁ (((ℒ₀ (r + 1)).obj.map (Opposite.op u)) s₂))
          ((m_ι_can W₁).base y₁) i =
        triv r W₁ (((ℒ₀ r).obj.map (Opposite.op u)) (τ_fun W₂ s₂))
          ((m_ι_can W₁).base y₁) i
      rw [hτ_spec W₁ _ y₁ i,
        (hLevel_spec (r + 1)).2.1 u u_succ hu_succ_fst hu_succ_snd s₂ y₁,
        (hLevel_spec r).2.1 u u_r hu_r_fst hu_r_snd (τ_fun W₂ s₂) ((m_ι_can W₁).base y₁),
        hm_pt, hτ_spec W₂ s₂ (u_succ.base y₁) i]
    refine ⟨{ hom := { app := τ_app, naturality := hτ_nat } }, ?_⟩
    intro W _ _ _ s_up m_ι hm_fst hm_snd y_up i
    have hm_eq : m_ι = m_ι_can W := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact hm_fst.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      · exact hm_snd.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
    rw [hm_eq]
    exact hτ_spec W s_up y_up i
  let τ_ℒ : ∀ r : ℕ, Quiver.Hom (ℒ₀ (r + 1)) (ℒ₀ r) :=
    fun r => Classical.choose (hTrans r)
  have hτ_ℒ_spec := fun r => Classical.choose_spec (hTrans r)
  refine ⟨ℒ₀, τ_ℒ, triv, fun r => ?_⟩
  refine ⟨(hLevel_spec r).1, (hLevel_spec r).2.1, fun W => ?_⟩
  exact ⟨(hLevel_spec r).2.2 W |>.1, (hLevel_spec r).2.2 W |>.2, hτ_ℒ_spec r W⟩

theorem weil_mid_dev_symplectic_subquotient_tower_descent (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (M_Zu_mid : WeilEllAdicCohomologyModel F Z_u₀ ℓ (2 * m + 1))
    (D : WeilMidDevSmoothMonodromyPackage.{u} F m Z_tilde f₀ u₀ Z_u₀ j_aff S_aff U₀ ℓ M_Zu_mid)
    (E_van E_perp E_rad : Submodule (Padic ℓ) (Fin D.N → Padic ℓ))
    (hE_perp : ∀ x : Fin D.N → Padic ℓ,
      x ∈ E_perp ↔ ∀ y ∈ E_van, dotProduct x (D.J_V.mulVec y) = 0)
    (hE_rad : E_rad = E_van ⊓ E_perp)
    (w_inf : Fin D.N → Padic ℓ) (hw_van : w_inf ∈ E_van) (hw_noniso : w_inf ∉ E_perp)
    (hSpan_orb : Submodule.span (Padic ℓ)
      { v : Fin D.N → Padic ℓ |
        ∃ g ∈ D.G_V, ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf = v } = E_van)
    (hGV_van : ∀ g ∈ D.G_V, ∀ x : Fin D.N → Padic ℓ,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x - x ∈ E_van)
    (hGV_perp : ∀ g ∈ D.G_V, ∀ x ∈ E_perp,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x = x)
    (hFVu_van : ∀ x ∈ E_van,
      ((D.F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x ∈ E_van)
    (hFVu_rad : ∀ x ∈ E_rad,
      ((D.F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x ∈ E_rad)
    (c_tr : Padic ℓ) (hc_tr : c_tr ≠ 0)
    (hTransv : ∀ t : PadicInt ℓ, ∃ g ∈ D.G_V, ∀ x : Fin D.N → Padic ℓ,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
        x + ((t : Padic ℓ) * c_tr * dotProduct x (D.J_V.mulVec w_inf)) • w_inf)
    (hInert_raw : ∀ r : ℕ,
      letI := D.hCR r; letI := D.hFld r; letI := D.hAF_L r; letI := D.hAP_L r
      letI := D.hARF_L r; letI := D.hABL r; letI := D.hAR_B r
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      let C₀_r := integralClosure (Polynomial F) (D.L_V r)
      let A_inf_r := Algebra.adjoin F
        ({algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹} : Set (D.L_V r))
      let t_inf_r : ↥A_inf_r :=
        ⟨algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹, Algebra.self_mem_adjoin_singleton F _⟩
      let C_inf_r := integralClosure ↥A_inf_r (D.L_V r)
      (∀ a ∈ S_aff, ∀ Q : Ideal ↥C₀_r, Q.IsPrime →
        Ideal.comap (algebraMap (Polynomial F) ↥C₀_r) Q =
          Ideal.span {Polynomial.X - Polynomial.C a} →
        ∀ (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r) (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
          (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) →
          (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
            algebraMap (D.B_V r) (D.L_V r) (σ_B b)) →
          (∀ y : ↥C₀_r,
            σ_L (y : D.L_V r) - (y : D.L_V r) ∈ Subtype.val '' (Q : Set ↥C₀_r)) →
          ∃ u ∈ D.G_V,
            (D.ρ_V r σ_B).val = (u.val).map (PadicInt.toZModPow (r + 1)) ∧
            ∃ g₀ ∈ D.G_V, ∃ c : Padic ℓ, ∀ x : Fin D.N → Padic ℓ,
              ((u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
                x + (c * dotProduct x (D.J_V.mulVec
                  (((g₀.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf))) •
                  (((g₀.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf)) ∧
      (∀ Q_inf : Ideal ↥C_inf_r, Q_inf.IsPrime →
        Ideal.comap (algebraMap ↥A_inf_r ↥C_inf_r) Q_inf = Ideal.span {t_inf_r} →
        ∀ (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r) (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
          (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) →
          (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
            algebraMap (D.B_V r) (D.L_V r) (σ_B b)) →
          (∀ y : ↥C_inf_r,
            σ_L (y : D.L_V r) - (y : D.L_V r) ∈ Subtype.val '' (Q_inf : Set ↥C_inf_r)) →
          ∃ u ∈ D.G_V,
            (D.ρ_V r σ_B).val = (u.val).map (PadicInt.toZModPow (r + 1)) ∧
            ∃ g₀ ∈ D.G_V, ∃ c : Padic ℓ, ∀ x : Fin D.N → Padic ℓ,
              ((u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
                x + (c * dotProduct x (D.J_V.mulVec
                  (((g₀.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf))) •
                  (((g₀.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf))) :
    ∃ (M₀ M M₂ : ℕ) (_ : 1 ≤ M) (hSum : M₀ + M + M₂ = D.N)
      (P_chg : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ)
      (J : Matrix (Fin M) (Fin M) (Padic ℓ))
      (G_geom : Subgroup ((Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ))
      (F_u : (Matrix (Fin M) (Fin M) (PadicInt ℓ))ˣ)
      (F_mat : ∀ (d : ℕ) (P_poly : Polynomial F),
        IsGoodAffineCurveClosedPointPoly S_aff d P_poly → Matrix (Fin M) (Fin M) (PadicInt ℓ))
      (Δ : Set (Fin M → Padic ℓ))
      (ℒ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
      (τ_ℒ : ∀ r : ℕ, Quiver.Hom (ℒ₀ (r + 1)) (ℒ₀ r)),
      (J.transpose = -J ∧ J.det ≠ 0) ∧
      (∀ g ∈ G_geom,
        ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
          ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = J) ∧
      (Δ.Nonempty ∧
        (∀ v ∈ Δ, v ≠ 0) ∧
        Submodule.span (Padic ℓ) Δ = ⊤ ∧
        (∀ v₁ ∈ Δ, ∀ v₂ ∈ Δ, ∃ h ∈ G_geom,
          ((h.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec v₁ = v₂) ∧
        (∀ g ∈ G_geom, ∀ v ∈ Δ,
          ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec v ∈ Δ) ∧
        (∀ v ∈ Δ, ∀ t : PadicInt ℓ, ∃ g ∈ G_geom, ∀ x : Fin M → Padic ℓ,
          ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
            x + ((t : Padic ℓ) * dotProduct x (J.mulVec v)) • v)) ∧
      ((∀ g ∈ G_geom, F_u * g * F_u⁻¹ ∈ G_geom) ∧
        ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
          ((F_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) =
            ((Nat.card F : Padic ℓ) ^ (2 * m + 1)) • J) ∧
      (∀ (d : ℕ) (P_poly : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly),
        ((F_mat d P_poly hP).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J *
          ((F_mat d P_poly hP).map (algebraMap (PadicInt ℓ) (Padic ℓ))) =
            ((Nat.card F : Padic ℓ) ^ ((2 * m + 1) * d)) • J) ∧
      (∀ x : Fin D.N → Padic ℓ,
        (x ∈ E_rad ↔ ∀ i : Fin D.N, M₀ ≤ i.1 →
          (((P_chg⁻¹).val.map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x) i = 0) ∧
        (x ∈ E_van ↔ ∀ i : Fin D.N, M₀ + M ≤ i.1 →
          (((P_chg⁻¹).val.map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x) i = 0)) ∧
      (∀ (hRad_inv : ∀ y ∈ E_rad,
          ((D.F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin y ∈ E_rad)
        (hVan_inv : E_van ≤ Submodule.comap
          ((D.F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin E_van)
        (d : ℕ) (P_poly : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly)
        (k : ℕ),
        1 ≤ d → 1 ≤ k →
        Matrix.trace (((D.F_V_mat d P_poly hP).map (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ k) =
          LinearMap.trace (Padic ℓ) ↥E_rad
            ((((D.F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin.restrict hRad_inv) ^
              (d * k)) +
            LinearMap.trace (Padic ℓ) ((Fin D.N → Padic ℓ) ⧸ E_van)
              ((Submodule.mapQ E_van E_van
                ((D.F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVecLin hVan_inv) ^
                (d * k)) +
            Matrix.trace (((F_mat d P_poly hP).map (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ k)) ∧
      WeilMidDevTowerWithBlockBridge.{u} F m D M₀ M M₂ hSum P_chg J G_geom F_u F_mat Δ ℒ₀ τ_ℒ :=
by
  classical
  let K := Padic ℓ
  let 𝒪 := PadicInt ℓ
  let ι := algebraMap 𝒪 K
  let μ_u : K := (Nat.card F : K) ^ (2 * m + 1)

  
  obtain ⟨M₀, M, M₂, hM, hSum, P_chg, J, G_geom, F_u, Δ,
    hJ_pkg, hG_sp, hΔ_pkg, hFu_pkg, hBasis, hFu_mid, hFu_tri, hGV_blk,
    hTransv_proj, hCoset_pkg⟩ :=
    weil_mid_dev_padic_saturated_flag_and_symplectic_subquotient
      ℓ D.N D.J_V D.hJV_skew D.hJV_det D.G_V D.hGV_sp D.F_V_u D.hFVu_norm
      μ_u D.hFVu_sim E_van E_perp E_rad hE_perp hE_rad w_inf hw_van hw_noniso
      hSpan_orb hGV_van hGV_perp hFVu_van hFVu_rad c_tr hc_tr hTransv

  let midBlk : Matrix (Fin D.N) (Fin D.N) 𝒪 → Matrix (Fin M) (Fin M) 𝒪 :=
    fun A k₁ k₂ =>
      ((P_chg⁻¹).val * A * P_chg.val) ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩

  let F_mat : ∀ (d : ℕ) (P_poly : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P_poly → Matrix (Fin M) (Fin M) 𝒪 :=
    fun d P_poly hP => midBlk (D.F_V_mat d P_poly hP)

  have hFmat_sim : ∀ (d : ℕ) (P_poly : Polynomial F)
      (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly),
      ((F_mat d P_poly hP).map ι).transpose * J * ((F_mat d P_poly hP).map ι) =
        ((Nat.card F : K) ^ ((2 * m + 1) * d)) • J := by
    intro d P_poly hP
    obtain ⟨g_P, hg_P, hCoset⟩ := D.hFVmat_coset d P_poly hP
    change ((midBlk (D.F_V_mat d P_poly hP)).map ι).transpose * J *
      ((midBlk (D.F_V_mat d P_poly hP)).map ι) = _
    rw [hCoset, (hCoset_pkg g_P hg_P d).1]
    dsimp [μ_u]
    rw [← pow_mul]

  have hBlockTr : ∀ (hRad_inv : ∀ y ∈ E_rad, ((D.F_V_u.val).map ι).mulVecLin y ∈ E_rad)
      (hVan_inv : E_van ≤ Submodule.comap ((D.F_V_u.val).map ι).mulVecLin E_van)
      (d : ℕ) (P_poly : Polynomial F) (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly)
      (k : ℕ),
      1 ≤ d → 1 ≤ k →
      Matrix.trace (((D.F_V_mat d P_poly hP).map ι) ^ k) =
        LinearMap.trace K ↥E_rad
          ((((D.F_V_u.val).map ι).mulVecLin.restrict hRad_inv) ^ (d * k)) +
          LinearMap.trace K ((Fin D.N → K) ⧸ E_van)
            ((Submodule.mapQ E_van E_van ((D.F_V_u.val).map ι).mulVecLin hVan_inv) ^ (d * k)) +
          Matrix.trace (((F_mat d P_poly hP).map ι) ^ k) := by
    intro hRad_inv hVan_inv d P_poly hP k hd hk
    obtain ⟨g_P, hg_P, hCoset⟩ := D.hFVmat_coset d P_poly hP
    change Matrix.trace (((D.F_V_mat d P_poly hP).map ι) ^ k) = _ + _ +
      Matrix.trace (((midBlk (D.F_V_mat d P_poly hP)).map ι) ^ k)
    rw [hCoset]
    exact (hCoset_pkg g_P hg_P d).2 hRad_inv hVan_inv k hd hk

  
  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  obtain ⟨B, L_fld,
    hCR_B, hDom_B, hFld_L,
    hAF_B, hAP_B, hAR_B,
    hAF_L, hAP_L, hARF_L,
    hABL, hARL,
    hST_FPB, hST_PRB, hST_FKL, hST_PKL, hST_PBL, hST_RBL,
    hFin_B, hEt_B, hFrac_B, hIntCl_B, hFD_L, hGal_L,
    ρ, ι_B, j_B, ι_L,
    hρ_inj, hG_surj, hG_mem, hCompat_B, hQu, hQP, hιL_compat, hjB_bridge⟩ :=
    weil_mid_dev_r0_galois_block_quotient_tower
      F S_aff ℓ D.N hℓ M₀ M M₂ hM hSum P_chg
      D.G_V D.F_V_u D.F_V_mat G_geom F_u F_mat
      hFu_mid (fun _ _ _ => rfl) hFu_tri hGV_blk
      D.a₀ D.ha₀ D.B_V D.L_V
      D.hCR D.hDom D.hFld
      D.hAF_B D.hAP_B D.hAR_B
      D.hAF_L D.hAP_L D.hARF_L
      D.hABL D.hARL
