            ↑((C_S.obj A₁).obj.obj (Opposite.op Y)) :=
          fun Y k => θ_of A₁ Y (Classical.choose (hLC_lift Y _ (hZeroAt Y k)))
        have hlift_map : ∀ (Y : S.Etale) (k : ↑(𝒦.obj.obj (Opposite.op Y))),
            ((C_S.map f).hom.app (Opposite.op Y)).hom (lift_fun Y k) =
              (g'.hom.app (Opposite.op Y)).hom k := by
          intro Y k
          dsimp only [lift_fun]
          rw [hθ_map f Y, Classical.choose_spec (hLC_lift Y _ (hZeroAt Y k))]
          exact (θ_equiv A₂ Y).apply_symm_apply _
        have hf_app_inj : ∀ Y : S.Etale,
            Function.Injective (((C_S.map f).hom.app (Opposite.op Y)).hom) := by
          intro Y s₁ s₂ hs
          rw [← (θ_equiv A₁ Y).apply_symm_apply s₁, ← (θ_equiv A₁ Y).apply_symm_apply s₂] at hs ⊢
          show θ_of A₁ Y _ = θ_of A₁ Y _
          congr 1
          apply hLC_inj Y
          apply ((hθ_spec A₂).1 Y).1
          rw [← hθ_map f Y _, ← hθ_map f Y _]
          exact hs
        let l : 𝒦 ⟶ C_S.obj A₁ := CategoryTheory.ObjectProperty.homMk
          { app := fun Y_op => AddCommGrpCat.ofHom
              { toFun := lift_fun Y_op.unop
                map_zero' := hf_app_inj Y_op.unop (by
                  rw [hlift_map, map_zero, map_zero])
                map_add' := fun k₁ k₂ => hf_app_inj Y_op.unop (by
                  rw [hlift_map, map_add, map_add, hlift_map, hlift_map]) }
            naturality := fun {Y₁_op Y₂_op} u_op => by
              ext k
              apply hf_app_inj Y₂_op.unop
              have hn_f := congrArg (fun t => t.hom (lift_fun Y₁_op.unop k))
                ((C_S.map f).hom.naturality u_op)
              have hn_g := congrArg (fun t => t.hom k) (g'.hom.naturality u_op)
              exact (hlift_map Y₂_op.unop _).trans (hn_g.trans
                ((congrArg (((C_S.obj A₂).obj.map u_op).hom) (hlift_map Y₁_op.unop k).symm).trans
                  hn_f.symm)) }
        have hl_fac : l ≫ C_S.map f = g' := by
          apply CategoryTheory.Sheaf.hom_ext
          ext Y_op k
          exact hlift_map Y_op.unop k
        refine ⟨l, hl_fac, fun m hm => ?_⟩
        apply CategoryTheory.Sheaf.hom_ext
        ext Y_op k
        apply hf_app_inj Y_op.unop
        exact (congrArg (fun t => (t.hom.app Y_op).hom k) hm).trans
          (congrArg (fun t => (t.hom.app Y_op).hom k) hl_fac).symm
      have hIsLim : CategoryTheory.Limits.IsLimit
          (CategoryTheory.Limits.KernelFork.ofι (C_S.map f) h0_CS) :=
        CategoryTheory.Limits.KernelFork.IsLimit.ofι (C_S.map f) h0_CS
          (fun {𝒦} g' hg' => Classical.choose (hKerLift g' hg'))
          (fun {𝒦} g' hg' => (Classical.choose_spec (hKerLift g' hg')).1)
          (fun {𝒦} g' hg' m hm => (Classical.choose_spec (hKerLift g' hg')).2 m hm)
      have : CategoryTheory.Mono (C_S.map f) := CategoryTheory.Limits.mono_of_isLimit_fork hIsLim
      exact { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hIsLim }
    have hSub_of_SE : ∀ {X₁ X₂ X₃ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        {f : X₁ ⟶ X₂} {g : X₂ ⟶ X₃} {h0 : f ≫ g = 0},
        (CategoryTheory.ShortComplex.mk f g h0).ShortExact →
        Subsingleton (X₁.H 1) →
        Subsingleton (X₃.H 1) →
        Subsingleton (X₂.H 1) := by
      intro X₁ X₂ X₃ f g h0 hSE hSub₁ hSub₃
      refine ⟨fun a b => sub_eq_zero.mp ?_⟩
      let d : X₂.H 1 := a - b
      have hd_g : d.comp (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.add_zero 1) = 0 :=
        @Subsingleton.elim (X₃.H 1) hSub₃ _ _
      obtain ⟨x₁, hx₁⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ hSE d hd_g
      have hx₁_zero : x₁ = 0 := @Subsingleton.elim (X₁.H 1) hSub₁ _ _
      show d = 0
      rw [← hx₁, hx₁_zero, CategoryTheory.Abelian.Ext.zero_comp]
    have hPrime : Nat.Prime ℓ := Fact.out
    have hℓ_pos : 0 < ℓ := hPrime.pos
    have hBockstein : ∀ s : ℕ, Subsingleton (weilEtaleTorsionH S (ℓ ^ (s + 1)) 1) := by
      intro s
      induction s with
      | zero =>
        simpa only [zero_add, pow_one] using hH1_mod_ℓ
      | succ s ih =>
        have hpow_pos : 0 < ℓ ^ (s + 1) := pow_pos hℓ_pos (s + 1)
        have : NeZero ℓ := ⟨hPrime.ne_zero⟩
        have : NeZero (ℓ ^ (s + 1)) := ⟨hpow_pos.ne'⟩
        have : NeZero (ℓ ^ (s + 2)) := ⟨(pow_pos hℓ_pos (s + 2)).ne'⟩
        have hpow_succ : ℓ ^ (s + 2) = ℓ ^ (s + 1) * ℓ := pow_succ ℓ (s + 1)
        let ι_z : ZMod (ℓ ^ (s + 1)) →+ ZMod (ℓ ^ (s + 2)) :=
          { toFun := fun x => ((x.val * ℓ : ℕ) : ZMod (ℓ ^ (s + 2)))
            map_zero' := by simp
            map_add' := fun x y => by
              rw [← Nat.cast_add, ZMod.natCast_eq_natCast_iff]
              have hmod : (x + y).val ≡ x.val + y.val [MOD ℓ ^ (s + 1)] := by
                rw [ZMod.val_add]
                exact Nat.mod_modEq (x.val + y.val) (ℓ ^ (s + 1))
              rw [hpow_succ, ← add_mul]
              exact hmod.mul_right' ℓ }
        let π_z : ZMod (ℓ ^ (s + 2)) →+ ZMod ℓ :=
          (ZMod.castHom (dvd_pow_self ℓ (by omega)) (ZMod ℓ)).toAddMonoidHom
        have hι_inj : Function.Injective ι_z := by
          intro x y hxy
          have hlt_x : x.val * ℓ < ℓ ^ (s + 2) := by
            rw [hpow_succ]; exact Nat.mul_lt_mul_of_pos_right (ZMod.val_lt x) hℓ_pos
          have hlt_y : y.val * ℓ < ℓ ^ (s + 2) := by
            rw [hpow_succ]; exact Nat.mul_lt_mul_of_pos_right (ZMod.val_lt y) hℓ_pos
          have hval := congrArg ZMod.val hxy
          dsimp [ι_z] at hval
          rw [ZMod.val_natCast_of_lt hlt_x, ZMod.val_natCast_of_lt hlt_y] at hval
          exact ZMod.val_injective _ (Nat.eq_of_mul_eq_mul_right hℓ_pos hval)
        have hπ_surj : Function.Surjective π_z :=
          ZMod.castHom_surjective (dvd_pow_self ℓ (by omega))
        have hπ_comp_ι : ∀ x : ZMod (ℓ ^ (s + 1)), π_z (ι_z x) = 0 := by
          intro x
          show ZMod.castHom (dvd_pow_self ℓ (by omega)) (ZMod ℓ) ((x.val * ℓ : ℕ) : ZMod (ℓ ^ (s + 2))) = 0
          rw [map_natCast, Nat.cast_mul, CharP.cast_eq_zero (ZMod ℓ) ℓ, mul_zero]
        have h_exact_z : ∀ z : ZMod (ℓ ^ (s + 2)), π_z z = 0 → ∃ x : ZMod (ℓ ^ (s + 1)), ι_z x = z := by
          intro z hz
          have hz_cast : (z.val : ZMod ℓ) = 0 := by
            have h1 : π_z (z.val : ZMod (ℓ ^ (s + 2))) = (z.val : ZMod ℓ) :=
              map_natCast (ZMod.castHom (dvd_pow_self ℓ (by omega)) (ZMod ℓ)) z.val
            rw [ZMod.natCast_zmod_val] at h1
            exact h1.symm.trans hz
          rcases (ZMod.natCast_eq_zero_iff z.val ℓ).mp hz_cast with ⟨q, hq⟩
          have hq_lt : q < ℓ ^ (s + 1) := by
            have hlt := ZMod.val_lt z
            rw [hq, hpow_succ, mul_comm ℓ q] at hlt
            exact lt_of_mul_lt_mul_right hlt hℓ_pos.le
          refine ⟨(q : ZMod (ℓ ^ (s + 1))), ?_⟩
          show (((q : ZMod (ℓ ^ (s + 1))).val * ℓ : ℕ) : ZMod (ℓ ^ (s + 2))) = z
          rw [ZMod.val_natCast_of_lt hq_lt, mul_comm q ℓ, ← hq, ZMod.natCast_zmod_val]
        let U := AddCommGrpCat.uliftFunctor.{u, 0}
        let f_u : U.obj (AddCommGrpCat.of (ZMod (ℓ ^ (s + 1)))) ⟶
            U.obj (AddCommGrpCat.of (ZMod (ℓ ^ (s + 2)))) :=
          U.map (AddCommGrpCat.ofHom ι_z)
        let p_u : U.obj (AddCommGrpCat.of (ZMod (ℓ ^ (s + 2)))) ⟶
            U.obj (AddCommGrpCat.of (ZMod ℓ)) :=
          U.map (AddCommGrpCat.ofHom π_z)
        have hfp_u : f_u ≫ p_u = 0 := by
          ext ⟨x⟩
          exact congrArg ULift.up (hπ_comp_ι x)
        have hf_u_inj : Function.Injective f_u.hom := by
          rintro ⟨x⟩ ⟨y⟩ hxy
          exact congrArg ULift.up (hι_inj (congrArg ULift.down hxy))
        have hp_u_surj : Function.Surjective p_u.hom := by
          rintro ⟨w⟩
          rcases hπ_surj w with ⟨z, rfl⟩
          exact ⟨ULift.up z, rfl⟩
        have hex_u : ∀ x : ↥(U.obj (AddCommGrpCat.of (ZMod (ℓ ^ (s + 2))))),
            p_u.hom x = 0 → ∃ y : ↥(U.obj (AddCommGrpCat.of (ZMod (ℓ ^ (s + 1))))), f_u.hom y = x := by
          rintro ⟨z⟩ hz
          rcases h_exact_z z (congrArg ULift.down hz) with ⟨x, rfl⟩
          exact ⟨ULift.up x, rfl⟩
        have hSE := hCS_shortExact f_u p_u hfp_u hf_u_inj hp_u_surj hex_u
        exact hSub_of_SE hSE ih hH1_mod_ℓ
    let R := ZMod (ℓ ^ (r + 1))
    let U := AddCommGrpCat.uliftFunctor.{u, 0}
    let A_vec : ℕ → AddCommGrpCat.{u} := fun n => U.obj (AddCommGrpCat.of (Fin n → R))
    have hVec : ∀ n : ℕ, Subsingleton ((C_S.obj (A_vec n)).H 1) := by
      intro n
      induction n with
