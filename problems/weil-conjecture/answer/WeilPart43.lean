    let f_lin : V₁ →ₗ[Padic ℓ] V₂ :=
      { toFun := fun v => equiv₂ (Ψ_rat (equiv₁.symm v))
        map_add' := fun v₁ v₂ => by rw [map_add, map_add, map_add]
        map_smul' := fun c v => by
          dsimp only [RingHom.id_apply]
          have h_gt1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hPrime.one_lt
          obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ‖c‖ h_gt1
          have hnorm_le : ‖(ℓ : Padic ℓ) ^ k * c‖ ≤ 1 := by
            rw [norm_mul, Padic.norm_p_pow, zpow_neg, zpow_natCast]
            have hpos : (0 : ℝ) < (ℓ : ℝ) ^ k := pow_pos (by positivity) k
            rw [inv_mul_le_iff₀ hpos, mul_one]; exact le_of_lt hk
          let z : PadicInt ℓ := ⟨(ℓ : Padic ℓ) ^ k * c, hnorm_le⟩
          have hz_coe : (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * c := rfl
          have hℓk_ne : ((ℓ : Padic ℓ) ^ k) ≠ 0 :=
            pow_ne_zero k (Nat.cast_ne_zero.mpr hPrime.ne_zero)
          let q₀ : ℚ := ((ℓ : ℚ) ^ k)⁻¹
          have hc_eq : c = (q₀ : Padic ℓ) * (z : Padic ℓ) := by
            dsimp [q₀]; push_cast; rw [hz_coe, ← mul_assoc, inv_mul_cancel₀ hℓk_ne, one_mul]
          let w := equiv₁.symm v
          have hv_eq : v = equiv₁ w := (equiv₁.apply_symm_apply v).symm
          have hcw : c • v = equiv₁ (q₀ • LinearMap.lTensor ℚ (S_z z).toIntLinearMap w) := by
            rw [hv_eq, hEquiv₁_qsmul, hEquiv₁_Sz, ← mul_smul, ← hc_eq]
          rw [hcw, AddEquiv.symm_apply_apply, Ψ_rat.map_smul, hΨ_Sz, hEquiv₂_qsmul,
            hEquiv₂_Tz, ← mul_smul, ← hc_eq] }
    have hf_inj : Function.Injective f_lin :=
      equiv₂.injective.comp (hΨ_rat_inj.comp equiv₁.symm.injective)
    have hf_inter : ∀ v : V₁, f_lin (frob₁ v) = frob₂ (f_lin v) := by
      intro v
      let w := equiv₁.symm v
      have hfv : frob₁ v = equiv₁ (LinearMap.lTensor ℚ F_act.toIntLinearMap w) := by
        rw [hEquiv₁_Fact w, equiv₁.apply_symm_apply]
      change equiv₂ (Ψ_rat (equiv₁.symm (frob₁ v))) = frob₂ (equiv₂ (Ψ_rat w))
      rw [hfv, AddEquiv.symm_apply_apply, hΨ_Fact w, hEquiv₂_Gact]
    let L_alg := AlgebraicClosure (Padic ℓ)
    obtain ⟨g_inv, hg_inv⟩ :=
      LinearMap.exists_leftInverse_of_injective f_lin (LinearMap.ker_eq_bot.mpr hf_inj)
    let Φ_L : Module.End L_alg (TensorProduct (Padic ℓ) L_alg V₁) := LinearMap.baseChange L_alg frob₁
    let Ψ_L : Module.End L_alg (TensorProduct (Padic ℓ) L_alg V₂) := LinearMap.baseChange L_alg frob₂
    let f_L := LinearMap.baseChange L_alg f_lin
    let g_L := LinearMap.baseChange L_alg g_inv
    have hg_L : g_L ∘ₗ f_L = LinearMap.id := by
      rw [← LinearMap.baseChange_comp, hg_inv, LinearMap.baseChange_id]
    have hf_L : Function.Injective f_L := by
      intro x y hxy
      have hgx := congrArg g_L hxy
      simpa only [← LinearMap.comp_apply, hg_L, LinearMap.id_apply] using hgx
    have hInter_comp : f_lin ∘ₗ frob₁ = frob₂ ∘ₗ f_lin := LinearMap.ext hf_inter
    have hInter_L : f_L ∘ₗ Φ_L = Ψ_L ∘ₗ f_L := by
      rw [← LinearMap.baseChange_comp, hInter_comp, LinearMap.baseChange_comp]
    have hγ_roots : γ' ∈ (Φ_L.charpoly).roots := by
      rw [LinearMap.charpoly_baseChange, ← Polynomial.aroots_def]; exact hγ'
    have hγ_isRoot : (Φ_L.charpoly).IsRoot γ' :=
      (Polynomial.mem_roots (LinearMap.charpoly_monic Φ_L).ne_zero).mp hγ_roots
    have hγ_eigen : Φ_L.HasEigenvalue γ' :=
      (Module.End.hasEigenvalue_iff_isRoot_charpoly Φ_L γ').mpr hγ_isRoot
    obtain ⟨v, hv⟩ := hγ_eigen.exists_hasEigenvector
    have hw_ne : f_L v ≠ 0 := fun h0 => hv.2 (hf_L (h0.trans (map_zero f_L).symm))
    have hw_eq : Ψ_L (f_L v) = γ' • (f_L v) := by
      calc Ψ_L (f_L v) = (Ψ_L ∘ₗ f_L) v := rfl
        _ = (f_L ∘ₗ Φ_L) v := by rw [← hInter_L]
        _ = f_L (Φ_L v) := rfl
        _ = f_L (γ' • v) := by rw [hv.apply_eq_smul]
        _ = γ' • f_L v := map_smul f_L γ' v
    have hw_eigenvec : Ψ_L.HasEigenvector γ' (f_L v) :=
      ⟨Module.End.mem_eigenspace_iff.mpr hw_eq, hw_ne⟩
    have hw_eigenval : Ψ_L.HasEigenvalue γ' :=
      Module.End.hasEigenvalue_of_hasEigenvector hw_eigenvec
    have hw_isRoot : (Ψ_L.charpoly).IsRoot γ' :=
      (Module.End.hasEigenvalue_iff_isRoot_charpoly Ψ_L γ').mp hw_eigenval
    have hw_roots : γ' ∈ (Ψ_L.charpoly).roots :=
      (Polynomial.mem_roots (LinearMap.charpoly_monic Ψ_L).ne_zero).mpr hw_isRoot
    rw [Polynomial.aroots_def, ← LinearMap.charpoly_baseChange]; exact hw_roots

  have hFIntMemProperEqZero : ∀ {R_dom : Type u} [CommRing R_dom] [IsDomain R_dom] [Algebra F R_dom]
      {Q : Ideal R_dom}, Q ≠ ⊤ → ∀ {z : R_dom}, z ∈ Q → IsIntegral F z → z = 0 := by
    intro R_dom _ _ _ Q hQ_ne z hz_mem hz_int
    let p := minpoly F z
    have hp_irr : Irreducible p := minpoly.irreducible hz_int
    have hp_eval : Polynomial.aeval z p = 0 := minpoly.aeval F z
    have hdiv : Polynomial.aeval z p =
        z * Polynomial.aeval z p.divX + algebraMap F R_dom (p.coeff 0) := by
      conv_lhs => rw [← Polynomial.X_mul_divX_add p]
      rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
    by_cases hc0 : p.coeff 0 = 0
    · have hmul0 : z * Polynomial.aeval z p.divX = 0 := by
        rw [hdiv, hc0, map_zero, add_zero] at hp_eval; exact hp_eval
      have hp_fac : p = Polynomial.X * p.divX := by
        conv_lhs => rw [← Polynomial.X_mul_divX_add p, hc0, Polynomial.C_0, add_zero]
      have hu_divX : IsUnit p.divX :=
        (hp_irr.isUnit_or_isUnit hp_fac).resolve_left Polynomial.not_isUnit_X
      have hu_eval : IsUnit (Polynomial.aeval z p.divX) :=
        hu_divX.map (Polynomial.aeval z).toMonoidHom
      exact (mul_eq_zero.mp hmul0).resolve_right hu_eval.ne_zero
    · exfalso
      have hc_mem : algebraMap F R_dom (p.coeff 0) ∈ Q := by
        have h1 : algebraMap F R_dom (p.coeff 0) = -(z * Polynomial.aeval z p.divX) := by
          linear_combination -(hp_eval.symm.trans hdiv)
        rw [h1]; exact Q.neg_mem (Q.mul_mem_right _ hz_mem)
      exact hQ_ne (Ideal.eq_top_of_isUnit_mem Q hc_mem ((IsUnit.mk0 _ hc0).map (algebraMap F R_dom)))

  have hAinfQuotCardAndEll : ∀ (A_ring : Type u) [CommRing A_ring] [Algebra F A_ring]
      (e_inf : Polynomial F ≃ₐ[F] A_ring) (t_F : A_ring),
      e_inf Polynomial.X = t_F →
      Nat.card (A_ring ⧸ Ideal.span ({t_F} : Set A_ring)) = Nat.card F ∧
      (ℓ : A_ring ⧸ Ideal.span ({t_F} : Set A_ring)) ≠ 0 := by
    intro A_ring _ _ e_inf t_F ht_F
    have hPrime : Nat.Prime ℓ := Fact.out
    let I_X : Ideal (Polynomial F) := Ideal.span {Polynomial.X}
    let I_t : Ideal A_ring := Ideal.span {t_F}
    have hMap : I_t = Ideal.map e_inf.toRingEquiv I_X := by
      dsimp [I_t, I_X]; rw [Ideal.map_span, Set.image_singleton]
      exact congrArg (fun x => Ideal.span {x}) ht_F.symm
    let eq₁ : (Polynomial F ⧸ I_X) ≃+* (A_ring ⧸ I_t) :=
      Ideal.quotientEquiv I_X I_t e_inf.toRingEquiv hMap
    have hKer : RingHom.ker (Polynomial.evalRingHom (0 : F)) = I_X := by
      rw [Polynomial.ker_evalRingHom, Polynomial.C_0, sub_zero]
    have hSurj : Function.Surjective (Polynomial.evalRingHom (0 : F)) :=
      fun c => ⟨Polynomial.C c, Polynomial.eval_C⟩
    let eq₀ : (Polynomial F ⧸ RingHom.ker (Polynomial.evalRingHom (0 : F))) ≃+* F :=
      RingHom.quotientKerEquivOfSurjective hSurj
    let eq_tot : F ≃+* (A_ring ⧸ I_t) :=
      eq₀.symm.trans ((Ideal.quotEquivOfEq hKer).trans eq₁)
    refine ⟨Nat.card_congr eq_tot.symm.toEquiv, ?_⟩
    intro h0
    have hF0 : (ℓ : F) = 0 := by
      apply eq_tot.injective; rw [map_natCast, map_zero]; exact h0
    have hdvd : ringChar F ∣ ℓ := (ringChar.spec F ℓ).mp hF0
    rcases hPrime.eq_one_or_self_of_dvd (ringChar F) hdvd with h1 | heq
    · exact (CharP.char_is_prime F (ringChar F)).ne_one h1
    · exact hℓ heq.symm

  have hRestrictAut : ∀ {R_b K_b B_b L_b : Type u}
      [CommRing R_b] [Field K_b] [CommRing B_b] [Field L_b]
      [Algebra R_b K_b] [Algebra R_b B_b] [Algebra K_b L_b] [Algebra B_b L_b] [Algebra R_b L_b]
      [IsScalarTower R_b K_b L_b] [IsScalarTower R_b B_b L_b]
      [IsIntegralClosure B_b R_b L_b]
      (σ : L_b ≃ₐ[K_b] L_b),
      ∃ σ_B : B_b ≃ₐ[R_b] B_b, ∀ b : B_b, σ (algebraMap B_b L_b b) = algebraMap B_b L_b (σ_B b) := by
    intro R_b K_b B_b L_b _ _ _ _ _ _ _ _ _ _ _ _ σ
    have hInj : Function.Injective (algebraMap B_b L_b) :=
      IsIntegralClosure.algebraMap_injective B_b R_b L_b
    let σ_R : L_b ≃ₐ[R_b] L_b := σ.restrictScalars R_b
    have hFwd : ∀ b : B_b, IsIntegral R_b (σ_R (algebraMap B_b L_b b)) := fun b =>
      IsIntegral.map (σ_R.toAlgHom.comp (IsScalarTower.toAlgHom R_b B_b L_b))
        (IsIntegralClosure.isIntegral R_b L_b b)
    have hInv : ∀ b : B_b, IsIntegral R_b (σ_R.symm (algebraMap B_b L_b b)) := fun b =>
      IsIntegral.map (σ_R.symm.toAlgHom.comp (IsScalarTower.toAlgHom R_b B_b L_b))
        (IsIntegralClosure.isIntegral R_b L_b b)
    let toFun : B_b → B_b := fun b => IsIntegralClosure.mk' B_b (σ_R (algebraMap B_b L_b b)) (hFwd b)
    let invFun : B_b → B_b := fun b =>
      IsIntegralClosure.mk' B_b (σ_R.symm (algebraMap B_b L_b b)) (hInv b)
    have h_to : ∀ b : B_b, algebraMap B_b L_b (toFun b) = σ (algebraMap B_b L_b b) :=
      fun b => IsIntegralClosure.algebraMap_mk' B_b (σ_R (algebraMap B_b L_b b)) (hFwd b)
    have h_inv : ∀ b : B_b, algebraMap B_b L_b (invFun b) = σ.symm (algebraMap B_b L_b b) :=
      fun b => IsIntegralClosure.algebraMap_mk' B_b (σ_R.symm (algebraMap B_b L_b b)) (hInv b)
    refine ⟨{
      toFun := toFun
      invFun := invFun
      left_inv := fun b => hInj (by rw [h_inv, h_to, σ.symm_apply_apply])
      right_inv := fun b => hInj (by rw [h_to, h_inv, σ.apply_symm_apply])
      map_mul' := fun x y => hInj (by rw [h_to, map_mul, map_mul, map_mul, h_to, h_to])
      map_add' := fun x y => hInj (by rw [h_to, map_add, map_add, map_add, h_to, h_to])
      commutes' := fun r => hInj (by
        rw [h_to, ← IsScalarTower.algebraMap_apply R_b B_b L_b]
        exact σ_R.commutes r)
    }, fun b => (h_to b).symm⟩

  have hIntClEquiv : ∀ {A₁ A₂ L_f : Type u} [CommRing A₁] [CommRing A₂] [Field L_f]
      [Algebra A₁ L_f] [Algebra A₂ L_f],
      (∀ a : A₁, IsIntegral A₂ (algebraMap A₁ L_f a)) →
      (∀ b : A₂, IsIntegral A₁ (algebraMap A₂ L_f b)) →
      ∃ e : ↥(integralClosure A₁ L_f) ≃+* ↥(integralClosure A₂ L_f),
        (∀ x : ↥(integralClosure A₁ L_f), (e x : L_f) = (x : L_f)) ∧
        (∀ y : ↥(integralClosure A₂ L_f), (e.symm y : L_f) = (y : L_f)) ∧
        ∀ Q₁ : Ideal ↥(integralClosure A₁ L_f), Q₁.IsPrime →
          let Q₂ : Ideal ↥(integralClosure A₂ L_f) := Ideal.comap e.symm.toRingHom Q₁
          Q₂.IsPrime ∧
          Subtype.val '' (Q₂ : Set ↥(integralClosure A₂ L_f)) =
            Subtype.val '' (Q₁ : Set ↥(integralClosure A₁ L_f)) := by
    intro A₁ A₂ L_f _ _ _ _ _ hAB hBA
    have hImp : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] [Algebra R₁ L_f] [Algebra R₂ L_f],
        (∀ r : R₁, IsIntegral R₂ (algebraMap R₁ L_f r)) →
        ∀ z : L_f, IsIntegral R₁ z → IsIntegral R₂ z := by
      intro R₁ R₂ _ _ _ _ hR z hz
      let C₂' : Subalgebra R₂ L_f := integralClosure R₂ L_f
      have _ : Algebra.IsIntegral R₂ ↥C₂' := IsIntegralClosure.isIntegral_algebra R₂ L_f
      let φ₁ : R₁ →+* ↥C₂' := (algebraMap R₁ L_f).codRestrict C₂'.toSubring hR
      let _ : Algebra R₁ ↥C₂' := φ₁.toAlgebra
      have _ : IsScalarTower R₁ ↥C₂' L_f := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      have hz_C₂ : IsIntegral ↥C₂' z := IsIntegral.tower_top hz
      exact isIntegral_trans z hz_C₂
    let e : ↥(integralClosure A₁ L_f) ≃+* ↥(integralClosure A₂ L_f) :=
      { toFun := fun x => ⟨x.1, hImp hAB x.1 x.2⟩
        invFun := fun y => ⟨y.1, hImp hBA y.1 y.2⟩
        left_inv := fun _ => Subtype.ext rfl
        right_inv := fun _ => Subtype.ext rfl
        map_mul' := fun _ _ => Subtype.ext rfl
        map_add' := fun _ _ => Subtype.ext rfl }
    refine ⟨e, fun _ => rfl, fun _ => rfl, fun Q₁ hQ₁ =>
      ⟨Ideal.comap_isPrime e.symm.toRingHom Q₁, ?_⟩⟩
    ext z
    constructor
    · rintro ⟨y, hy, rfl⟩; exact ⟨e.symm y, hy, rfl⟩
    · rintro ⟨x, hx, rfl⟩
      exact ⟨e x, by change e.symm (e x) ∈ Q₁; rwa [e.symm_apply_apply], rfl⟩

  have hGalPrimeConj : ∀ (A₂ K₂ L_f : Type u)
      [CommRing A₂] [IsDedekindDomain A₂] [Field K₂] [Field L_f]
      [Algebra A₂ K₂] [IsFractionRing A₂ K₂]
      [Algebra K₂ L_f] [Algebra A₂ L_f] [IsScalarTower A₂ K₂ L_f]
      [FiniteDimensional K₂ L_f] [IsGalois K₂ L_f]
      (t₂ : A₂),
      (Ideal.span ({t₂} : Set A₂)).IsMaximal →
      ∀ (Q₂ Q₂_star : Ideal ↥(integralClosure A₂ L_f)),
        Q₂.IsPrime → Q₂_star.IsPrime →
        algebraMap A₂ L_f t₂ ∈ Subtype.val '' (Q₂ : Set ↥(integralClosure A₂ L_f)) →
        algebraMap A₂ L_f t₂ ∈ Subtype.val '' (Q₂_star : Set ↥(integralClosure A₂ L_f)) →
        ∃ τ_K : L_f ≃ₐ[K₂] L_f,
          ∀ (σ : L_f →+* L_f),
            (∀ y : ↥(integralClosure A₂ L_f),
              σ (y : L_f) - (y : L_f) ∈ Subtype.val '' (Q₂ : Set ↥(integralClosure A₂ L_f))) →
            (∀ y : ↥(integralClosure A₂ L_f),
              τ_K.symm (σ (τ_K (y : L_f))) - (y : L_f) ∈
                Subtype.val '' (Q₂_star : Set ↥(integralClosure A₂ L_f))) := by
    intro A₂ K₂ L_f _ _ _ _ _ _ _ _ _ _ _ t₂ hMax Q₂ Q₂_star hQ₂_prime hQ₂_star_prime
      ht_Q₂ ht_Q₂_star
    exact (open scoped Pointwise in by
      let C₂ := ↥(integralClosure A₂ L_f)
      let _ : IsDomain A₂ :=
        Function.Injective.isDomain (algebraMap A₂ K₂) (IsFractionRing.injective A₂ K₂)
      have _ : IsFractionRing C₂ L_f := integralClosure.isFractionRing_of_finite_extension K₂ L_f
      have _ : FaithfulSMul A₂ C₂ := FaithfulSMul.of_field_isFractionRing A₂ C₂ K₂ L_f
      have _ : IsGaloisGroup (L_f ≃ₐ[K₂] L_f) A₂ C₂ :=
        IsGaloisGroup.of_isFractionRing (L_f ≃ₐ[K₂] L_f) A₂ C₂ K₂ L_f
      have _ : Algebra.IsInvariant A₂ C₂ (L_f ≃ₐ[K₂] L_f) := inferInstance
      let p₂ : Ideal A₂ := Ideal.span {t₂}
      have hUnder : ∀ Q : Ideal C₂, Q.IsPrime →
          algebraMap A₂ L_f t₂ ∈ Subtype.val '' (Q : Set C₂) → Ideal.under A₂ Q = p₂ := by
        intro Q hQp ⟨z, hz, hz_eq⟩
        have ht_mem : algebraMap A₂ C₂ t₂ ∈ Q := by
          have hzeq : z = algebraMap A₂ C₂ t₂ := Subtype.ext hz_eq
          rwa [← hzeq]
        have hle : p₂ ≤ Ideal.under A₂ Q :=
          Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ht_mem)
        have hcomap_prime : (Ideal.under A₂ Q).IsPrime := hQp.comap (algebraMap A₂ C₂)
        exact (hMax.eq_of_le hcomap_prime.ne_top hle).symm
      have hEqUnder : Ideal.under A₂ Q₂_star = Ideal.under A₂ Q₂ :=
        (hUnder Q₂_star hQ₂_star_prime ht_Q₂_star).trans (hUnder Q₂ hQ₂_prime ht_Q₂).symm
      obtain ⟨τ_K, hτ_smul⟩ :=
        Algebra.IsInvariant.exists_smul_of_under_eq A₂ C₂ (L_f ≃ₐ[K₂] L_f) Q₂_star Q₂ hEqUnder
      refine ⟨τ_K, fun σ hσ_inert y => ?_⟩
      let y' : C₂ := τ_K • y
      have hy'_coe : (y' : L_f) = τ_K (y : L_f) := rfl
      obtain ⟨w, hw_Q₂, hw_coe⟩ := hσ_inert y'
      rw [SetLike.mem_coe, hτ_smul] at hw_Q₂
      have hw_star : τ_K⁻¹ • w ∈ Q₂_star :=
        Ideal.mem_pointwise_smul_iff_inv_smul_mem.mp hw_Q₂
      refine ⟨τ_K⁻¹ • w, hw_star, ?_⟩
      change τ_K.symm (w : L_f) = _
      rw [hw_coe, hy'_coe, map_sub, AlgEquiv.symm_apply_apply])

  have hDedekindConj : ∀ (A_ded K_ded L_ded : Type u)
      [CommRing A_ded] [IsDedekindDomain A_ded] [Field K_ded] [Field L_ded]
      [Algebra A_ded K_ded] [IsFractionRing A_ded K_ded]
      [Algebra K_ded L_ded] [Algebra A_ded L_ded] [IsScalarTower A_ded K_ded L_ded]
      [FiniteDimensional K_ded L_ded] [IsGalois K_ded L_ded]
      (p : Ideal A_ded), p ≠ ⊥ → [p.IsMaximal] → [Finite (A_ded ⧸ p)] →
      ∀ (r_lvl : ℕ), (ℓ : A_ded ⧸ p) ≠ 0 →
      ∀ (Q : Ideal ↥(integralClosure A_ded L_ded)) [Q.IsPrime],
      Ideal.comap (algebraMap A_ded ↥(integralClosure A_ded L_ded)) Q = p →
      (∀ σ : L_ded ≃ₐ[K_ded] L_ded,
        (∀ y : ↥(integralClosure A_ded L_ded),
          σ (y : L_ded) - (y : L_ded) ∈
            Subtype.val '' (Q : Set ↥(integralClosure A_ded L_ded))) →
        σ ^ (ℓ ^ (r_lvl + 1)) = 1) →
      ∃ τ_frob : L_ded ≃ₐ[K_ded] L_ded,
        (∀ y : ↥(integralClosure A_ded L_ded),
          (y : L_ded) ∈ Subtype.val '' (Q : Set ↥(integralClosure A_ded L_ded)) ↔
            τ_frob (y : L_ded) ∈ Subtype.val '' (Q : Set ↥(integralClosure A_ded L_ded))) ∧
        (∀ y : ↥(integralClosure A_ded L_ded),
          τ_frob.symm (y : L_ded) - (y : L_ded) ^ Nat.card (A_ded ⧸ p) ∈
            Subtype.val '' (Q : Set ↥(integralClosure A_ded L_ded))) ∧
        (∀ σ : L_ded ≃ₐ[K_ded] L_ded,
          (∀ y : ↥(integralClosure A_ded L_ded),
            σ (y : L_ded) - (y : L_ded) ∈
              Subtype.val '' (Q : Set ↥(integralClosure A_ded L_ded))) →
          τ_frob⁻¹ * σ * τ_frob = σ ^ Nat.card (A_ded ⧸ p)) := by
    intro A_ded K_ded L_ded _ _ _ _ _ _ _ _ _ _ _ p hp_ne _ _ r_lvl hℓ_ne Q _ hQ_comap hExp
    exact (open scoped Pointwise in by
      have hInj_AK : Function.Injective (algebraMap A_ded K_ded) :=
        IsFractionRing.injective A_ded K_ded
      let _ : IsDomain A_ded := Function.Injective.isDomain (algebraMap A_ded K_ded) hInj_AK
      let _ : Algebra.IsSeparable K_ded L_ded := IsGalois.to_isSeparable
      let C := ↥(integralClosure A_ded L_ded)
      have _ : IsDedekindDomain C := integralClosure.isDedekindDomain A_ded K_ded L_ded
      have _ : IsFractionRing C L_ded :=
        integralClosure.isFractionRing_of_finite_extension K_ded L_ded
      have _ : Module.Finite A_ded C := IsIntegralClosure.finite A_ded K_ded L_ded C
      have _ : Algebra.IsIntegral A_ded C := IsIntegralClosure.isIntegral_algebra A_ded L_ded
      have _ : FaithfulSMul A_ded C :=
        FaithfulSMul.of_field_isFractionRing A_ded C K_ded L_ded
      have _ : IsGaloisGroup (L_ded ≃ₐ[K_ded] L_ded) A_ded C :=
        IsGaloisGroup.of_isFractionRing (L_ded ≃ₐ[K_ded] L_ded) A_ded C K_ded L_ded
      have hQ_under : Ideal.under A_ded Q = p := hQ_comap
      have _ : Q.LiesOver p := (Ideal.liesOver_iff Q p).mpr hQ_under.symm
      have _ : Q.IsMaximal :=
        Ideal.IsIntegral.isMaximal_of_isMaximal_under (R := A_ded) Q
          (hQ_under.symm ▸ inferInstance)
      have hQ_ne_bot : Q ≠ ⊥ := by
        intro h0
        have hInj_AC : Function.Injective (algebraMap A_ded C) := by
          intro a₁ a₂ ha
          have haL : algebraMap A_ded L_ded a₁ = algebraMap A_ded L_ded a₂ := by
            rw [IsScalarTower.algebraMap_apply A_ded C L_ded,
              IsScalarTower.algebraMap_apply A_ded C L_ded, ha]
          rw [IsScalarTower.algebraMap_apply A_ded K_ded L_ded,
            IsScalarTower.algebraMap_apply A_ded K_ded L_ded] at haL
          exact hInj_AK ((algebraMap K_ded L_ded).injective haL)
        have hp0 : p = ⊥ := by
          rw [← hQ_comap, h0]; ext a; simp only [Ideal.mem_comap, Ideal.mem_bot]
          exact ⟨fun ha => hInj_AC (ha.trans (map_zero _).symm), fun ha => by rw [ha, map_zero]⟩
        exact hp_ne hp0
      have hCoeMemImgQ : ∀ y : C, (y : L_ded) ∈ Subtype.val '' (Q : Set C) ↔ y ∈ Q := by
        intro y
        constructor
        · rintro ⟨z, hz, hzy⟩
          have hyz : z = y := Subtype.ext hzy
          rwa [← hyz]
        · intro hy; exact ⟨y, hy, rfl⟩
      have hSmulCoe : ∀ (γ : L_ded ≃ₐ[K_ded] L_ded) (y : C), ((γ • y : C) : L_ded) = γ (y : L_ded) :=
        fun _ _ => rfl
      let κ_A := A_ded ⧸ p
      let κ_Q := C ⧸ Q
      let _ : Field κ_A := Ideal.Quotient.field p
      let _ : Field κ_Q := Ideal.Quotient.field Q
      let _ : Fintype κ_A := Fintype.ofFinite κ_A
      set q_card := Nat.card κ_A
      have hq_card : Fintype.card κ_A = q_card := Fintype.card_eq_nat_card
      have _ : Algebra.IsAlgebraic κ_A κ_Q := by
        refine ⟨fun x => ?_⟩
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
        obtain ⟨f, hf_monic, hf_eval⟩ := Algebra.IsIntegral.isIntegral (R := A_ded) y
        refine ⟨f.map (Ideal.Quotient.mk p), (hf_monic.map (Ideal.Quotient.mk p)).ne_zero, ?_⟩
        rw [Polynomial.aeval_def, Polynomial.eval₂_map]
        have hcomm : (algebraMap κ_A κ_Q).comp (Ideal.Quotient.mk p) =
            (Ideal.Quotient.mk Q).comp (algebraMap A_ded C) := RingHom.ext fun _ => rfl
        rw [hcomm, ← Polynomial.hom_eval₂, hf_eval, map_zero]
      let φ_frob : κ_Q ≃ₐ[κ_A] κ_Q := FiniteField.frobeniusAlgEquivOfAlgebraic κ_A κ_Q
      have hφ_frob_apply : ∀ x : κ_Q, φ_frob x = x ^ q_card := by
        intro x; change x ^ Fintype.card κ_A = x ^ q_card; rw [hq_card]
      obtain ⟨τ_sub, hτ_quot⟩ :=
        Ideal.Quotient.stabilizerHom_surjective (L_ded ≃ₐ[K_ded] L_ded) p Q φ_frob.symm
      let τ_frob : L_ded ≃ₐ[K_ded] L_ded := τ_sub.1
      have hτ_stab_iff : ∀ y : C, y ∈ Q ↔ τ_frob • y ∈ Q := by
        intro y
        have hmk : Ideal.Quotient.stabilizerHom Q p (L_ded ≃ₐ[K_ded] L_ded) τ_sub
            (Ideal.Quotient.mk Q y) = Ideal.Quotient.mk Q (τ_frob • y) := rfl
        rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.eq_zero_iff_mem, ← hmk]
        exact ⟨fun h0 => by rw [h0, map_zero],
          fun h0 => (Ideal.Quotient.stabilizerHom Q p (L_ded ≃ₐ[K_ded] L_ded) τ_sub).injective
            (h0.trans (map_zero _).symm)⟩
      have hτ_inv_stab_iff : ∀ y : C, y ∈ Q ↔ τ_frob⁻¹ • y ∈ Q := by
        intro y; conv_lhs => rw [← smul_inv_smul τ_frob y]
        exact (hτ_stab_iff (τ_frob⁻¹ • y)).symm
      have hτ_symm_pow : ∀ y : C, τ_frob⁻¹ • y - y ^ q_card ∈ Q := by
        intro y
        have hinv_quot : Ideal.Quotient.stabilizerHom Q p (L_ded ≃ₐ[K_ded] L_ded) (τ_sub⁻¹) =
            φ_frob := by
          rw [map_inv]; apply AlgEquiv.ext; intro x
          change (Ideal.Quotient.stabilizerHom Q p (L_ded ≃ₐ[K_ded] L_ded) τ_sub).symm x = φ_frob x
          rw [hτ_quot]; rfl
        have hmk := AlgEquiv.congr_fun hinv_quot (Ideal.Quotient.mk Q y)
        have hmk_lhs : Ideal.Quotient.stabilizerHom Q p (L_ded ≃ₐ[K_ded] L_ded) (τ_sub⁻¹)
            (Ideal.Quotient.mk Q y) = Ideal.Quotient.mk Q (τ_frob⁻¹ • y) := rfl
        rw [hmk_lhs, hφ_frob_apply, ← map_pow] at hmk
        exact Ideal.Quotient.eq.mp hmk
      let 𝔒 := Localization.AtPrime Q
      have _ : IsDiscreteValuationRing 𝔒 :=
        IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain C hQ_ne_bot 𝔒
      obtain ⟨ϖ, hϖ_irr⟩ := IsDiscreteValuationRing.exists_irreducible 𝔒
      let 𝔪 : Ideal 𝔒 := IsLocalRing.maximalIdeal 𝔒
      have h𝔪_prime : 𝔪.IsPrime := (IsLocalRing.maximalIdeal.isMaximal 𝔒).isPrime
      have h𝔪 : 𝔪 = Ideal.span {ϖ} := Irreducible.maximalIdeal_eq hϖ_irr
      have hϖ_ne : ϖ ≠ 0 := hϖ_irr.ne_zero
      have h𝔪_pow : ∀ k : ℕ, 𝔪 ^ k = Ideal.span {ϖ ^ k} := by
        intro k; rw [h𝔪, Ideal.span_singleton_pow]
      have hComap_𝔪 : Ideal.comap (algebraMap C 𝔒) 𝔪 = Q :=
        IsLocalization.AtPrime.under_maximalIdeal 𝔒 Q
      have hC_units_L : ∀ s : Q.primeCompl, IsUnit (algebraMap C L_ded s.1) := by
        intro s
        have hs_ne0 : (s.1 : C) ≠ 0 := fun h0 => s.2 (h0 ▸ Q.zero_mem)
        have hsL_ne0 : algebraMap C L_ded s.1 ≠ 0 :=
          (map_ne_zero_iff _ (IsFractionRing.injective C L_ded)).mpr hs_ne0
        exact IsUnit.mk0 _ hsL_ne0
      let φ_L : 𝔒 →+* L_ded := IsLocalization.lift (M := Q.primeCompl) (g := algebraMap C L_ded) hC_units_L
      have hφ_L_alg : ∀ y : C, φ_L (algebraMap C 𝔒 y) = (y : L_ded) :=
        fun y => IsLocalization.lift_eq hC_units_L y
      have hφ_L_inj : Function.Injective φ_L := by
        rw [injective_iff_map_eq_zero]; intro z hz
        obtain ⟨⟨y, s⟩, hys⟩ := IsLocalization.surj Q.primeCompl z
        have hyL : (y : L_ded) = 0 := by
          calc (y : L_ded) = φ_L (algebraMap C 𝔒 y) := (hφ_L_alg y).symm
            _ = φ_L (z * algebraMap C 𝔒 s.1) := by rw [hys]
            _ = φ_L z * φ_L (algebraMap C 𝔒 s.1) := map_mul φ_L _ _
            _ = 0 := by rw [hz, zero_mul]
        have hy0 : y = 0 := Subtype.ext hyL
        have hz_mul : z * algebraMap C 𝔒 s.1 = 0 := by rw [hys, hy0, map_zero]
        exact (IsLocalization.map_units 𝔒 s).mul_left_eq_zero.mp hz_mul
      let actC : (L_ded ≃ₐ[K_ded] L_ded) → (C →+* C) :=
        MulSemiringAction.toRingHom (L_ded ≃ₐ[K_ded] L_ded) C
      have hSubComap : ∀ (γ : L_ded ≃ₐ[K_ded] L_ded), (∀ y : C, y ∈ Q ↔ γ • y ∈ Q) →
          Q.primeCompl ≤ Submonoid.comap (actC γ) Q.primeCompl := by
        intro γ hγ s hs; change γ • s ∉ Q; exact fun hmem => hs ((hγ s).mpr hmem)
      let act : ∀ (γ : L_ded ≃ₐ[K_ded] L_ded), (∀ y : C, y ∈ Q ↔ γ • y ∈ Q) → (𝔒 →+* 𝔒) :=
        fun γ hγ => IsLocalization.map 𝔒 (actC γ) (hSubComap γ hγ)
      have hφ_map : ∀ (γ : L_ded ≃ₐ[K_ded] L_ded)
          (hsub : Q.primeCompl ≤ Submonoid.comap (actC γ) Q.primeCompl) (z : 𝔒),
          φ_L (IsLocalization.map 𝔒 (actC γ) hsub z) = γ (φ_L z) := by
        intro γ hsub
        have heq : φ_L.comp (IsLocalization.map 𝔒 (actC γ) hsub) =
            γ.toRingEquiv.toRingHom.comp φ_L := by
          apply IsLocalization.ringHom_ext Q.primeCompl; ext y
          rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply,
            IsLocalization.map_eq hsub y, hφ_L_alg, hφ_L_alg]
          exact hSmulCoe γ y
        exact fun z => RingHom.congr_fun heq z
      have hφ_act : ∀ (γ : L_ded ≃ₐ[K_ded] L_ded) (hγ : ∀ y : C, y ∈ Q ↔ γ • y ∈ Q) (z : 𝔒),
          φ_L (act γ hγ z) = γ (φ_L z) := fun γ hγ z => hφ_map γ (hSubComap γ hγ) z
      have hact_mem_𝔪 : ∀ (γ : L_ded ≃ₐ[K_ded] L_ded) (hγ : ∀ y : C, y ∈ Q ↔ γ • y ∈ Q) (z : 𝔒),
          z ∈ 𝔪 ↔ act γ hγ z ∈ 𝔪 := by
        intro γ hγ z
        obtain ⟨⟨y, s⟩, hys⟩ := IsLocalization.surj Q.primeCompl z
        have h1 : z ∈ 𝔪 ↔ y ∈ Q := by
          have hu : IsUnit (algebraMap C 𝔒 s.1) := IsLocalization.map_units 𝔒 s
          have hmul : z ∈ 𝔪 ↔ z * algebraMap C 𝔒 s.1 ∈ 𝔪 := by
            constructor
            · intro hz; exact 𝔪.mul_mem_right _ hz
            · intro hzs; rcases hu with ⟨u, hu_eq⟩
              have := 𝔪.mul_mem_right (↑u⁻¹ : 𝔒) hzs
              rwa [← hu_eq, mul_assoc, Units.mul_inv, mul_one] at this
          rw [hmul, hys, ← Ideal.mem_comap, hComap_𝔪]
        have h2 : act γ hγ z ∈ 𝔪 ↔ γ • y ∈ Q := by
          have hs' : γ • s.1 ∉ Q := fun hm => s.2 ((hγ s.1).mpr hm)
          have hu' : IsUnit (algebraMap C 𝔒 (γ • s.1)) :=
            IsLocalization.map_units 𝔒 (⟨γ • s.1, hs'⟩ : Q.primeCompl)
          have hys' : act γ hγ z * algebraMap C 𝔒 (γ • s.1) = algebraMap C 𝔒 (γ • y) := by
            have h := congrArg (act γ hγ) hys; rw [map_mul] at h; dsimp only [act] at h ⊢
            rw [IsLocalization.map_eq (hSubComap γ hγ) s.1,
              IsLocalization.map_eq (hSubComap γ hγ) y] at h
            exact h
          have hmul' : act γ hγ z ∈ 𝔪 ↔ act γ hγ z * algebraMap C 𝔒 (γ • s.1) ∈ 𝔪 := by
            constructor
            · intro hz; exact 𝔪.mul_mem_right _ hz
            · intro hzs; rcases hu' with ⟨u, hu_eq⟩
              have := 𝔪.mul_mem_right (↑u⁻¹ : 𝔒) hzs
              rwa [← hu_eq, mul_assoc, Units.mul_inv, mul_one] at this
          rw [hmul', hys', ← Ideal.mem_comap, hComap_𝔪]
        rw [h1, h2]; exact hγ y
      have hInertIff : ∀ σ : L_ded ≃ₐ[K_ded] L_ded,
          (∀ y : C, σ (y : L_ded) - (y : L_ded) ∈ Subtype.val '' (Q : Set C)) ↔
            ∀ y : C, σ • y - y ∈ Q := by
        intro σ
        constructor
        · intro h y
          have hL : ((σ • y - y : C) : L_ded) ∈ Subtype.val '' (Q : Set C) := h y
          exact (hCoeMemImgQ (σ • y - y)).mp hL
        · intro h y; exact (hCoeMemImgQ (σ • y - y)).mpr (h y)
      have hInertStab : ∀ (σ : L_ded ≃ₐ[K_ded] L_ded), (∀ y : C, σ • y - y ∈ Q) →
          (∀ y : C, y ∈ Q ↔ σ • y ∈ Q) := by
        intro σ hσ y
        constructor
        · intro hy; have h1 := Q.add_mem (hσ y) hy; rwa [sub_add_cancel] at h1
        · intro hσy; have h1 := Q.sub_mem hσy (hσ y); rwa [sub_sub_cancel] at h1
      have hInertMod𝔪 : ∀ (σ : L_ded ≃ₐ[K_ded] L_ded) (hσ : ∀ y : C, σ • y - y ∈ Q) (z : 𝔒),
          act σ (hInertStab σ hσ) z - z ∈ 𝔪 := by
        intro σ hσ z
        obtain ⟨⟨y, s⟩, hys⟩ := IsLocalization.surj Q.primeCompl z
        have hs' : σ • s.1 ∉ Q := fun hm => s.2 ((hInertStab σ hσ s.1).mpr hm)
        have hu : IsUnit (algebraMap C 𝔒 s.1) := IsLocalization.map_units 𝔒 s
        have hu' : IsUnit (algebraMap C 𝔒 (σ • s.1)) :=
          IsLocalization.map_units 𝔒 (⟨σ • s.1, hs'⟩ : Q.primeCompl)
        have hys' : act σ (hInertStab σ hσ) z * algebraMap C 𝔒 (σ • s.1) =
            algebraMap C 𝔒 (σ • y) := by
          have h := congrArg (act σ (hInertStab σ hσ)) hys; rw [map_mul] at h
          dsimp only [act] at h ⊢
          rw [IsLocalization.map_eq (hSubComap σ (hInertStab σ hσ)) s.1,
            IsLocalization.map_eq (hSubComap σ (hInertStab σ hσ)) y] at h
          exact h
        have hprod_mem : (act σ (hInertStab σ hσ) z - z) *
            (algebraMap C 𝔒 s.1 * algebraMap C 𝔒 (σ • s.1)) ∈ 𝔪 := by
          have hcalc : (act σ (hInertStab σ hσ) z - z) *
              (algebraMap C 𝔒 s.1 * algebraMap C 𝔒 (σ • s.1)) =
              algebraMap C 𝔒 s.1 * (act σ (hInertStab σ hσ) z * algebraMap C 𝔒 (σ • s.1)) -
                algebraMap C 𝔒 (σ • s.1) * (z * algebraMap C 𝔒 s.1) := by ring
          rw [hcalc, hys', hys, ← map_mul, ← map_mul, ← map_sub, ← Ideal.mem_comap, hComap_𝔪]
          have hdecomp : s.1 * (σ • y) - (σ • s.1) * y =
              s.1 * (σ • y - y) - y * (σ • s.1 - s.1) := by ring
          rw [hdecomp]
          exact Q.sub_mem (Q.mul_mem_left _ (hσ y)) (Q.mul_mem_left _ (hσ s.1))
        rcases hu.mul hu' with ⟨u_tot, hu_tot⟩
        have := 𝔪.mul_mem_right (↑u_tot⁻¹ : 𝔒) hprod_mem
        rwa [← hu_tot, mul_assoc, Units.mul_inv, mul_one] at this
      have hFrobInvMod𝔪 : ∀ z : 𝔒, act τ_frob⁻¹ hτ_inv_stab_iff z - z ^ q_card ∈ 𝔪 := by
        intro z
        obtain ⟨⟨y, s⟩, hys⟩ := IsLocalization.surj Q.primeCompl z
        have hs' : τ_frob⁻¹ • s.1 ∉ Q := fun hm => s.2 ((hτ_inv_stab_iff s.1).mpr hm)
        have hu_q : IsUnit ((algebraMap C 𝔒 s.1) ^ q_card) :=
          (IsLocalization.map_units 𝔒 s).pow q_card
        have hu' : IsUnit (algebraMap C 𝔒 (τ_frob⁻¹ • s.1)) :=
          IsLocalization.map_units 𝔒 (⟨τ_frob⁻¹ • s.1, hs'⟩ : Q.primeCompl)
        have hys' : act τ_frob⁻¹ hτ_inv_stab_iff z * algebraMap C 𝔒 (τ_frob⁻¹ • s.1) =
            algebraMap C 𝔒 (τ_frob⁻¹ • y) := by
          have h := congrArg (act τ_frob⁻¹ hτ_inv_stab_iff) hys; rw [map_mul] at h
          dsimp only [act] at h ⊢
          rw [IsLocalization.map_eq (hSubComap τ_frob⁻¹ hτ_inv_stab_iff) s.1,
            IsLocalization.map_eq (hSubComap τ_frob⁻¹ hτ_inv_stab_iff) y] at h
          exact h
        have hys_q : z ^ q_card * (algebraMap C 𝔒 s.1) ^ q_card =
            algebraMap C 𝔒 (y ^ q_card) := by
          rw [← mul_pow, hys, map_pow]
        have hprod_mem : (act τ_frob⁻¹ hτ_inv_stab_iff z - z ^ q_card) *
            ((algebraMap C 𝔒 s.1) ^ q_card * algebraMap C 𝔒 (τ_frob⁻¹ • s.1)) ∈ 𝔪 := by
          have hcalc : (act τ_frob⁻¹ hτ_inv_stab_iff z - z ^ q_card) *
              ((algebraMap C 𝔒 s.1) ^ q_card * algebraMap C 𝔒 (τ_frob⁻¹ • s.1)) =
              (algebraMap C 𝔒 s.1) ^ q_card *
                (act τ_frob⁻¹ hτ_inv_stab_iff z * algebraMap C 𝔒 (τ_frob⁻¹ • s.1)) -
              algebraMap C 𝔒 (τ_frob⁻¹ • s.1) *
                (z ^ q_card * (algebraMap C 𝔒 s.1) ^ q_card) := by ring
          rw [hcalc, hys', hys_q, ← map_pow, ← map_mul, ← map_mul, ← map_sub,
            ← Ideal.mem_comap, hComap_𝔪]
          have hdecomp : s.1 ^ q_card * (τ_frob⁻¹ • y) - (τ_frob⁻¹ • s.1) * y ^ q_card =
              s.1 ^ q_card * (τ_frob⁻¹ • y - y ^ q_card) -
                y ^ q_card * (τ_frob⁻¹ • s.1 - s.1 ^ q_card) := by ring
          rw [hdecomp]
          exact Q.sub_mem (Q.mul_mem_left _ (hτ_symm_pow y))
            (Q.mul_mem_left _ (hτ_symm_pow s.1))
        rcases hu_q.mul hu' with ⟨u_tot, hu_tot⟩
        have := 𝔪.mul_mem_right (↑u_tot⁻¹ : 𝔒) hprod_mem
        rwa [← hu_tot, mul_assoc, Units.mul_inv, mul_one] at this
      have hℓ_not_mem_𝔪 : (ℓ : 𝔒) ∉ 𝔪 := by
        intro hmem
        have hmem_Q : (ℓ : C) ∈ Q := by
          rw [← hComap_𝔪, Ideal.mem_comap, map_natCast]; exact hmem
        have hmem_p : (ℓ : A_ded) ∈ p := by
          rw [← hQ_comap, Ideal.mem_comap, map_natCast]; exact hmem_Q
        exact hℓ_ne ((Ideal.Quotient.eq_zero_iff_mem).mpr hmem_p)
      have hϖ_div : ∀ (γ : L_ded ≃ₐ[K_ded] L_ded) (hγ : ∀ y : C, y ∈ Q ↔ γ • y ∈ Q),
          ∃ u : 𝔒, u ∉ 𝔪 ∧ act γ hγ ϖ = u * ϖ := by
        intro γ hγ
        have hγ_inv : ∀ y : C, y ∈ Q ↔ γ⁻¹ • y ∈ Q := by
          intro y
          conv_lhs => rw [← smul_inv_smul γ y]
          exact (hγ (γ⁻¹ • y)).symm
        have h1 : act γ hγ ϖ ∈ Ideal.span {ϖ} := by
          rw [← h𝔪]
          exact (hact_mem_𝔪 γ hγ ϖ).mp (by rw [h𝔪]; exact Ideal.mem_span_singleton_self ϖ)
        obtain ⟨u, hu⟩ := Ideal.mem_span_singleton.mp h1
        have hu' : act γ hγ ϖ = u * ϖ := by rw [hu, mul_comm]
        refine ⟨u, ?_, hu'⟩
        intro hu_mem
        have h2 : act γ⁻¹ hγ_inv ϖ ∈ Ideal.span {ϖ} := by
          rw [← h𝔪]
          exact (hact_mem_𝔪 γ⁻¹ hγ_inv ϖ).mp (by rw [h𝔪]; exact Ideal.mem_span_singleton_self ϖ)
        obtain ⟨w, hw⟩ := Ideal.mem_span_singleton.mp h2
        have hcomp : act γ⁻¹ hγ_inv (act γ hγ ϖ) = ϖ := by
          apply hφ_L_inj; rw [hφ_map, hφ_map]; exact γ.symm_apply_apply (φ_L ϖ)
        rw [hu', map_mul, hw] at hcomp
        have hprod1 : act γ⁻¹ hγ_inv u * w = 1 := by
          apply mul_right_cancel₀ hϖ_ne
          calc act γ⁻¹ hγ_inv u * w * ϖ = act γ⁻¹ hγ_inv u * (ϖ * w) := by ring
            _ = 1 * ϖ := by rw [hcomp, one_mul]
        have hu_inv_mem : act γ⁻¹ hγ_inv u ∈ 𝔪 := (hact_mem_𝔪 γ⁻¹ hγ_inv u).mp hu_mem
        have h1_mem : (1 : 𝔒) ∈ 𝔪 := hprod1 ▸ 𝔪.mul_mem_right w hu_inv_mem
        exact (IsLocalRing.maximalIdeal.isMaximal 𝔒).ne_top
          (Ideal.eq_top_of_isUnit_mem 𝔪 h1_mem isUnit_one)
      have hTrivOfUnitOne : ∀ (σ : L_ded ≃ₐ[K_ded] L_ded) (hσ : ∀ y : C, σ • y - y ∈ Q) (u : 𝔒),
          act σ (hInertStab σ hσ) ϖ = u * ϖ → u - 1 ∈ 𝔪 → σ = 1 := by
        intro σ hσ u hu_eq hu1
