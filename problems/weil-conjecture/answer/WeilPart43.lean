    have _ : IsGalois L_fld L_V := hGal_LL

    obtain ⟨hInj_rel, m_rel, equiv_rel, e_rel, hIdemp_rel, hOrth_rel, hSum_rel, hEval_rel, hAbsorb_rel⟩ :=
