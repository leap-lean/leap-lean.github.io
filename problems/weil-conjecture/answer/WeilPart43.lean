        ∃ u ∈ S_gen, (ρ r σ_B).val = (u.val).map π_r := by
      intro σ_E σ_B σ_L τ_B hσEB hσLE hτB ⟨u_V, hu_V, hu_mod, g₀, hg₀, c, hu_act⟩
      have hτ_jB : ∀ b : B r, τ_B (j_B r b) = j_B r (σ_B b) := by
        intro b
        apply IsFractionRing.injective (D.B_V r) L
        rw [← hτB (j_B r b), (hιL_compat r).2.2 b]
        change σ_L (algebraMap E L (algebraMap (B r) E b)) = _
        rw [hσLE, hσEB b]
        exact ((hιL_compat r).2.2 (σ_B b)).symm
      obtain ⟨_, _, _, σ', hσ'_jB, hσ'_blk⟩ := (hjB_bridge r).2.2 τ_B
      have hσ'_eq : σ' = σ_B := by
        ext b
        apply (hjB_bridge r).1
        rw [← hσ'_jB b, hτ_jB b]
      rw [hσ'_eq] at hσ'_blk
      obtain ⟨u_bar, hu_bar_G, hu_bar_val, v, hv, c', hu_bar_act⟩ :=
        hTransv_proj u_V g₀ c hu_V hg₀ hu_act
      refine ⟨u_bar, ⟨hu_bar_G, v, hv, c', hu_bar_act⟩, ?_⟩
      ext k₁ k₂
      rw [← hσ'_blk k₁ k₂]
      have hAdap : ((P_chg⁻¹).val.map π_r) * (D.ρ_V r τ_B).val * (P_chg.val.map π_r) =
          ((P_chg⁻¹).val * u_V.val * P_chg.val).map π_r := by
        rw [hu_mod, ← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply,
          ← RingHom.mapMatrix_apply, ← map_mul, ← map_mul]
        rfl
      change (((P_chg⁻¹).val.map π_r) * (D.ρ_V r τ_B).val * (P_chg.val.map π_r))
          ⟨M₀ + k₁.1, _⟩ ⟨M₀ + k₂.1, _⟩ =
        ((u_bar.val).map π_r) k₁ k₂
      rw [hAdap, hu_bar_val]
      rfl

    refine ⟨?_, ?_⟩
    · 
      intro a ha Q hQ_prime hQ_over σ_E σ_B _hσE_int hσEB hσE_inert
      let p_a : Ideal (Polynomial F) := Ideal.span {Polynomial.X - Polynomial.C a}
      have hp_ne : p_a ≠ ⊥ := (hLinMax a).1
      have _ : p_a.IsMaximal := (hLinMax a).2.1
      obtain ⟨Q_L, σ_L, hQL_prime, hQL_over, hσLE, hσL_inert, hσL_int⟩ :=
        weil_mid_dev_dedekind_galois_inertia_lift
          F (Polynomial F) (RatFunc F) E L p_a hp_ne Q hQ_prime hQ_over σ_E hσE_inert
      obtain ⟨τ_B, hτB⟩ := hR0Restrict σ_L
      exact hProjSGen σ_E σ_B σ_L τ_B hσEB hσLE hτB
        (hRaw_aff a ha Q_L hQL_prime hQL_over σ_L τ_B hσL_int hτB hσL_inert)
    · 
      let _ : CommRing A_inf_F := hCR_Ainf
      let _ : IsDedekindDomain A_inf_F := hDD_Ainf
      let _ : Algebra F A_inf_F := hAlgF_Ainf
      let _ : Algebra A_inf_F (RatFunc F) := hAlgAinf_RF
      have _ : IsFractionRing A_inf_F (RatFunc F) := hFrac_Ainf
      let _ : Algebra A_inf_F E := hAlgAinf_E
      let _ : Algebra A_inf_F L := hAlgAinf_L
      have _ : IsScalarTower F A_inf_F (RatFunc F) := hST_FAinfRF
      have _ : IsScalarTower A_inf_F (RatFunc F) E := hST_AinfRFE
      have _ : IsScalarTower A_inf_F (RatFunc F) L := hST_AinfRFL
      have _ : IsScalarTower A_inf_F E L := hST_AinfEL
      have _ : IsScalarTower F A_inf_F E := by
        refine IsScalarTower.of_algebraMap_eq fun c => ?_
        rw [IsScalarTower.algebraMap_apply F (RatFunc F) E c,
          IsScalarTower.algebraMap_apply F A_inf_F (RatFunc F) c,
          ← IsScalarTower.algebraMap_apply A_inf_F (RatFunc F) E]
      let A_inf_E := Algebra.adjoin F ({algebraMap (RatFunc F) E (RatFunc.X)⁻¹} : Set E)
      let t_inf_E : ↥A_inf_E :=
        ⟨algebraMap (RatFunc F) E (RatFunc.X)⁻¹, Algebra.self_mem_adjoin_singleton F _⟩
      let C_inf_E := integralClosure ↥A_inf_E E
      intro Q_inf hQinf_prime hQinf_over σ_E σ_B _hσE_int hσEB hσE_inert
      let u_E : E := algebraMap (RatFunc F) E (RatFunc.X)⁻¹
      have hu_E_tK : algebraMap A_inf_F E t_K = u_E := by
        rw [IsScalarTower.algebraMap_apply A_inf_F (RatFunc F) E t_K, htK_map]
      have hIntSub_E : ∀ (R₁ R₂ : Type u) [CommRing R₁] [CommRing R₂]
          [Algebra R₁ E] [Algebra R₂ E],
          (∀ b : R₂, IsIntegral R₁ (algebraMap R₂ E b)) →
          ∀ x : E, IsIntegral R₂ x → IsIntegral R₁ x := by
        intro R₁ R₂ _ _ _ _ h21 x hx
        let g : R₂ →+* ↥(integralClosure R₁ E) :=
          { toFun := fun b => ⟨algebraMap R₂ E b, h21 b⟩
            map_one' := Subtype.ext (map_one _)
            map_mul' := fun a b => Subtype.ext (map_mul _ a b)
            map_zero' := Subtype.ext (map_zero _)
            map_add' := fun a b => Subtype.ext (map_add _ a b) }
        let _ : Algebra R₂ ↥(integralClosure R₁ E) := g.toAlgebra
        have _ : IsScalarTower R₂ ↥(integralClosure R₁ E) E :=
          IsScalarTower.of_algebraMap_eq fun _ => rfl
        have hx' : IsIntegral ↥(integralClosure R₁ E) x :=
          IsIntegral.tower_top (R := R₂) (A := ↥(integralClosure R₁ E)) hx
        exact isIntegral_trans (R := R₁) (A := ↥(integralClosure R₁ E)) x hx'
      have h01_E : ∀ w : A_inf_F, IsIntegral ↥A_inf_E (algebraMap A_inf_F E w) := by
        intro w
        let α₁ : Polynomial F →ₐ[F] E :=
          (IsScalarTower.toAlgHom F A_inf_F E).comp e_inf.toAlgHom
        have hα₁_eq : α₁ = Polynomial.aeval u_E := by
          apply Polynomial.algHom_ext
          change algebraMap A_inf_F E (e_inf Polynomial.X) = Polynomial.aeval u_E Polynomial.X
          rw [he_X, Polynomial.aeval_X, hu_E_tK]
        have hw_eq : algebraMap A_inf_F E w = Polynomial.aeval u_E (e_inf.symm w) := by
          have h1 : α₁ (e_inf.symm w) = algebraMap A_inf_F E w := by
            change algebraMap A_inf_F E (e_inf (e_inf.symm w)) = _
            rw [e_inf.apply_symm_apply]
          rw [← h1, hα₁_eq]
        change algebraMap A_inf_F E w ∈ C_inf_E
        rw [hw_eq]
        refine Polynomial.induction_on' (e_inf.symm w) ?_ ?_
        · intro p₁ p₂ hp₁ hp₂
          rw [map_add]
          exact C_inf_E.add_mem hp₁ hp₂
        · intro n c
          rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow,
            Polynomial.aeval_C, Polynomial.aeval_X]
          have hc : algebraMap F E c ∈ C_inf_E :=
            IsIntegral.tower_top (R := F) (A := ↥A_inf_E) isIntegral_algebraMap
          have hu : u_E ∈ C_inf_E := C_inf_E.algebraMap_mem t_inf_E
          exact C_inf_E.mul_mem hc (C_inf_E.pow_mem hu n)
      have h10_E : ∀ z : ↥A_inf_E, IsIntegral A_inf_F (algebraMap ↥A_inf_E E z) := by
        intro z
        have hz_range : z.1 ∈ (Polynomial.aeval u_E : Polynomial F →ₐ[F] E).range := by
          rw [← Algebra.adjoin_singleton_eq_range_aeval F u_E]
          exact z.2
        rcases hz_range with ⟨P, hP⟩
        have hP' : Polynomial.aeval u_E P = z.1 := hP
        change z.1 ∈ integralClosure A_inf_F E
        rw [← hP']
        refine Polynomial.induction_on' P ?_ ?_
        · intro p₁ p₂ hp₁ hp₂
          rw [map_add]
          exact (integralClosure A_inf_F E).add_mem hp₁ hp₂
        · intro n c
          rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow,
            Polynomial.aeval_C, Polynomial.aeval_X]
          have hc : algebraMap F E c ∈ integralClosure A_inf_F E := by
            rw [IsScalarTower.algebraMap_apply F A_inf_F E c]
            exact (integralClosure A_inf_F E).algebraMap_mem _
          have hu : u_E ∈ integralClosure A_inf_F E := by
            rw [← hu_E_tK]
            exact (integralClosure A_inf_F E).algebraMap_mem t_K
          exact (integralClosure A_inf_F E).mul_mem hc
            ((integralClosure A_inf_F E).pow_mem hu n)
      let θ_E : ↥(integralClosure A_inf_F E) ≃+* ↥C_inf_E :=
        { toFun := fun y => ⟨y.1, hIntSub_E ↥A_inf_E A_inf_F h01_E y.1 y.2⟩
          invFun := fun z => ⟨z.1, hIntSub_E A_inf_F ↥A_inf_E h10_E z.1 z.2⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl
          map_mul' := fun _ _ => rfl
          map_add' := fun _ _ => rfl }
      have _ : Q_inf.IsPrime := hQinf_prime
      let Q_inf_FE : Ideal ↥(integralClosure A_inf_F E) := Ideal.comap θ_E.toRingHom Q_inf
      have hQinf_FE_prime : Q_inf_FE.IsPrime := Ideal.IsPrime.comap θ_E.toRingHom
      have _ : Q_inf_FE.IsPrime := hQinf_FE_prime
      have hQinf_FE_over :
          Ideal.comap (algebraMap A_inf_F ↥(integralClosure A_inf_F E)) Q_inf_FE =
            Ideal.span {t_K} := by
        let p_FE := Ideal.comap (algebraMap A_inf_F ↥(integralClosure A_inf_F E)) Q_inf_FE
        have hp_FE_prime : p_FE.IsPrime :=
          Ideal.IsPrime.comap (algebraMap A_inf_F ↥(integralClosure A_inf_F E))
        have htinf_mem : t_inf_E ∈ Ideal.comap (algebraMap ↥A_inf_E ↥C_inf_E) Q_inf := by
          rw [hQinf_over]
          exact Ideal.mem_span_singleton_self t_inf_E
        have hθ_tK : θ_E (algebraMap A_inf_F ↥(integralClosure A_inf_F E) t_K) =
            algebraMap ↥A_inf_E ↥C_inf_E t_inf_E := Subtype.ext hu_E_tK
        have htK_mem : t_K ∈ p_FE := by
          change θ_E (algebraMap A_inf_F ↥(integralClosure A_inf_F E) t_K) ∈ Q_inf
          rw [hθ_tK]
          exact htinf_mem
        exact (htK_max.eq_of_le hp_FE_prime.ne_top
          (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr htK_mem))).symm
      have hσE_inert_FE : ∀ y : ↥(integralClosure A_inf_F E),
          σ_E (y : E) - (y : E) ∈
            Subtype.val '' (Q_inf_FE : Set ↥(integralClosure A_inf_F E)) := by
        intro y
        obtain ⟨w, hw, hw_eq⟩ := hσE_inert (θ_E y)
        refine ⟨θ_E.symm w, ?_, hw_eq⟩
        change θ_E (θ_E.symm w) ∈ Q_inf
        simpa using hw
      have _ : (Ideal.span {t_K} : Ideal A_inf_F).IsMaximal := htK_max
      obtain ⟨Q_inf_FL, σ_L, hQFL_prime, hQFL_over, hσLE, hσL_inert_FL, hσL_int⟩ :=
        weil_mid_dev_dedekind_galois_inertia_lift
          F A_inf_F (RatFunc F) E L (Ideal.span {t_K}) htK_ne
          Q_inf_FE hQinf_FE_prime hQinf_FE_over σ_E hσE_inert_FE
      obtain ⟨Q_inf_L, hQL_prime, hQL_over, hQL_img⟩ :=
        hInf_transfer Q_inf_FL hQFL_prime hQFL_over
      have hσL_inert := hQL_img σ_L hσL_inert_FL
      obtain ⟨τ_B, hτB⟩ := hR0Restrict σ_L
      exact hProjSGen σ_E σ_B σ_L τ_B hσEB hσLE hτB
        (hRaw_inf Q_inf_L hQL_prime hQL_over σ_L τ_B hσL_int hτB hσL_inert)

  have hBridge :
      WeilMidDevTowerWithBlockBridge.{u} F m D M₀ M M₂ hSum P_chg J G_geom F_u F_mat Δ ℒ₀ τ_ℒ :=
    ⟨D.a₀, D.ha₀, B, L_fld,
      hCR_B, hDom_B, hFld_L,
      hAF_B, hAP_B, hAR_B,
      hAF_L, hAP_L, hARF_L,
      hABL, hARL,
      hST_FPB, hST_PRB, hST_FKL, hST_PKL, hST_PBL, hST_RBL,
      hFin_B, hEt_B, hFrac_B, hIntCl_B, hFD_L, hGal_L,
      ρ, ι_B, D.e_U,
      D.hu₀_eq, D.heU_eq, hρ_inj, hG_surj, hG_mem, hCompat_B, hQu, hQP,
      ⟨triv, hTriv⟩, hInert_desc, ⟨rfl, j_B, hjB_bridge⟩⟩

  exact ⟨M₀, M, M₂, hM, hSum, P_chg, J, G_geom, F_u, F_mat, Δ, ℒ₀, τ_ℒ,
    hJ_pkg, hG_sp, hΔ_pkg, hFu_pkg, hFmat_sim, hBasis, hBlockTr, hBridge⟩

theorem weil_mid_dev_iso_adapted_lattice_and_galois_trig (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (ℓ N q_wt : ℕ) [Fact (Nat.Prime ℓ)]
    (J_V : Matrix (Fin N) (Fin N) (Padic ℓ)) (hJV_det : J_V.det ≠ 0)
    (G_V : Subgroup ((Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ))
    (F_V_u : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (E_perp : Submodule (Padic ℓ) (Fin N → Padic ℓ))
    (w_inf : Fin N → Padic ℓ) (hw_nz : w_inf ≠ 0)
    (hE_perp_eq : ∀ x : Fin N → Padic ℓ, x ∈ E_perp ↔ dotProduct x (J_V.mulVec w_inf) = 0)
    (hGV_perp : ∀ g ∈ G_V, ∀ x ∈ E_perp,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x = x)
    (hGV_quot_iso : ∀ g ∈ G_V, ∀ x : Fin N → Padic ℓ,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x - x ∈ E_perp)
    (hFVu_perp : ∀ x ∈ E_perp,
      ((F_V_u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x ∈ E_perp)
    (hFrob_sq_inf : ∀ x : Fin N → Padic ℓ,
      dotProduct
        (((F_V_u.val ^ 2).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x -
          ((Nat.card F : Padic ℓ) ^ (2 * q_wt)) • x)
        (J_V.mulVec w_inf) = 0) :
    ∃ (M₀ : ℕ) (hSum : M₀ + 1 = N)
      (P_chg : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
      (μ_F : (PadicInt ℓ)ˣ),
      (μ_F.val : PadicInt ℓ) ^ 2 = ((Nat.card F : PadicInt ℓ) ^ q_wt) ^ 2 ∧
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      ∀ (r : ℕ) (B_r : Type u) [CommRing B_r] [IsDomain B_r]
        [Algebra F B_r] [Algebra (Polynomial F) B_r] [Algebra R₀ B_r]
        [IsScalarTower F (Polynomial F) B_r] [IsScalarTower (Polynomial F) R₀ B_r]
        [Module.Finite R₀ B_r]
        (ρ_r : (B_r ≃ₐ[R₀] B_r) →* (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))))ˣ)
        (a₀ : F),
        a₀ ∉ S_aff →
        (∀ σ : B_r ≃ₐ[R₀] B_r,
          (∀ x : B_r, IsIntegral F x → σ x = x) →
          ∃ g ∈ G_V, (ρ_r σ).val = (g.val).map (PadicInt.toZModPow (r + 1))) →
        ∀ (Q_u : Ideal B_r) (σ_u : B_r ≃ₐ[R₀] B_r),
          Q_u.IsMaximal →
          Ideal.comap (algebraMap (Polynomial F) B_r) Q_u =
            Ideal.span {Polynomial.X - Polynomial.C a₀} →
          (∀ b : B_r, σ_u.symm b - b ^ Nat.card F ∈ Q_u) →
          (ρ_r σ_u).val = (F_V_u.val).map (PadicInt.toZModPow (r + 1)) →
          let A_adap : (B_r ≃ₐ[R₀] B_r) → Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))) :=
            fun τ => ((P_chg⁻¹).val.map (PadicInt.toZModPow (r + 1))) *
              (ρ_r τ).val * (P_chg.val.map (PadicInt.toZModPow (r + 1)))
          (∀ (τ : B_r ≃ₐ[R₀] B_r) (j : Fin N),
            j.1 < M₀ → A_adap τ ⟨M₀, by omega⟩ j = 0) ∧
          (∀ τ : B_r ≃ₐ[R₀] B_r,
            (∀ x : B_r, IsIntegral F x → τ x = x) →
            (∀ (i j : Fin N), i.1 < M₀ → j.1 < M₀ →
              A_adap τ i j = if i = j then 1 else 0) ∧
            A_adap τ ⟨M₀, by omega⟩ ⟨M₀, by omega⟩ = 1) ∧
          A_adap σ_u ⟨M₀, by omega⟩ ⟨M₀, by omega⟩ =
            PadicInt.toZModPow (r + 1) μ_F.val :=
by
  classical
  let K := Padic ℓ
  let 𝒪 := PadicInt ℓ
  let ι : 𝒪 →+* K := algebraMap 𝒪 K
  have hι_inj : Function.Injective ι := IsFractionRing.injective 𝒪 K
  let v_star : Fin N → K := J_V.mulVec w_inf
  have hv_ne : v_star ≠ 0 := by
    intro h0
    dsimp [v_star] at h0
    have hUnit : IsUnit J_V := (Matrix.isUnit_iff_isUnit_det J_V).mpr (IsUnit.mk0 _ hJV_det)
    obtain ⟨uJ, huJ⟩ := hUnit
    have hw0 : w_inf = 0 := by
      calc w_inf = (1 : Matrix (Fin N) (Fin N) K).mulVec w_inf := (Matrix.one_mulVec w_inf).symm
        _ = ((uJ⁻¹).val * uJ.val).mulVec w_inf := by rw [Units.inv_mul]
        _ = (uJ⁻¹).val.mulVec (J_V.mulVec w_inf) := by rw [huJ, Matrix.mulVec_mulVec]
        _ = 0 := by rw [h0, Matrix.mulVec_zero]
    exact hw_nz hw0
  obtain ⟨j₀, hj₀⟩ := Function.ne_iff.mp hv_ne
  have hN_pos : 0 < N := by have := j₀.2; omega
  let M₀ : ℕ := N - 1
  have hSum : M₀ + 1 = N := by omega
  let m_last : Fin N := ⟨M₀, by omega⟩
  have hj_lt_iff : ∀ j : Fin N, j.1 < M₀ ↔ j ≠ m_last := by
    intro j
    rw [ne_eq, Fin.ext_iff]
    change j.1 < M₀ ↔ j.1 ≠ M₀
    omega
  obtain ⟨j_max, _, hj_max⟩ :=
    Finset.exists_max_image Finset.univ (fun j : Fin N => ‖v_star j‖) ⟨j₀, Finset.mem_univ j₀⟩
  have hv_max_ne : v_star j_max ≠ 0 := by
    intro h0
    have hle := hj_max j₀ (Finset.mem_univ j₀)
    rw [h0, norm_zero] at hle
    exact hj₀ (norm_le_zero_iff.mp hle)
  let u_star : Fin N → 𝒪 := fun j =>
    ⟨v_star j / v_star j_max, by
      rw [norm_div]
      exact div_le_one_of_le₀ (hj_max j (Finset.mem_univ j)) (norm_nonneg _)⟩
  have hu_max : u_star j_max = 1 := Subtype.ext (div_self hv_max_ne)
  have hu_scale : ∀ j : Fin N, ι (u_star j) * v_star j_max = v_star j := by
    intro j
    change (v_star j / v_star j_max) * v_star j_max = v_star j
    exact div_mul_cancel₀ (v_star j) hv_max_ne
  let π : Equiv.Perm (Fin N) := Equiv.swap j_max m_last
  let w : Fin N → 𝒪 := fun k => u_star (π k)
  have hw_last : w m_last = 1 := by
    dsimp [w, π]
    rw [Equiv.swap_apply_right, hu_max]
  let E_mat : Matrix (Fin N) (Fin N) 𝒪 :=
    Matrix.of fun i k => if i = m_last ∧ k ≠ m_last then w k else 0
  let U_mat : Matrix (Fin N) (Fin N) 𝒪 := 1 + E_mat
  let U_inv : Matrix (Fin N) (Fin N) 𝒪 := 1 - E_mat
  let S_mat : Matrix (Fin N) (Fin N) 𝒪 :=
    Matrix.of fun i j => if i = π j then (1 : 𝒪) else 0
  let P : Matrix (Fin N) (Fin N) 𝒪 := S_mat * U_inv
  let Q : Matrix (Fin N) (Fin N) 𝒪 := U_mat * S_mat
  have hEE : E_mat * E_mat = 0 := by
    ext i l
    simp only [Matrix.mul_apply, Matrix.zero_apply, E_mat, Matrix.of_apply]
    refine Finset.sum_eq_zero fun k _ => ?_
    by_cases hk : k = m_last <;> simp [hk]
  have hUU : U_mat * U_inv = 1 := by
    dsimp [U_mat, U_inv]
    rw [add_mul, one_mul, mul_sub, mul_one, hEE, sub_zero, sub_add_cancel]
  have hUinvU : U_inv * U_mat = 1 := by
    dsimp [U_mat, U_inv]
    rw [sub_mul, one_mul, mul_add, mul_one, hEE, add_zero, add_sub_cancel_right]
  have hSS : S_mat * S_mat = 1 := by
    ext i l
    simp only [Matrix.mul_apply, S_mat, Matrix.of_apply, Matrix.one_apply]
    rw [Finset.sum_eq_single (π l)]
    · simp [π, Equiv.swap_apply_self]
    · intro k _ hk
      simp [hk]
    · intro hmem
      exact absurd (Finset.mem_univ (π l)) hmem
  have hPQ : P * Q = 1 := by
    calc P * Q = S_mat * (U_inv * U_mat) * S_mat := by
          dsimp [P, Q]; simp only [Matrix.mul_assoc]
      _ = S_mat * 1 * S_mat := by rw [hUinvU]
      _ = 1 := by rw [Matrix.mul_one, hSS]
  have hQP : Q * P = 1 := by
    calc Q * P = U_mat * (S_mat * S_mat) * U_inv := by
          dsimp [P, Q]; simp only [Matrix.mul_assoc]
      _ = U_mat * 1 * U_inv := by rw [hSS]
      _ = 1 := by rw [Matrix.mul_one, hUU]
  let P_chg : (Matrix (Fin N) (Fin N) 𝒪)ˣ := ⟨P, Q, hPQ, hQP⟩
  have hU_last : ∀ k : Fin N, U_mat m_last k = w k := by
    intro k
    simp only [U_mat, Matrix.add_apply, Matrix.one_apply, E_mat, Matrix.of_apply]
    by_cases hk : k = m_last
    · subst hk
      simp [hw_last]
    · have hne : m_last ≠ k := fun h => hk h.symm
      simp [hk, hne]
  have hQ_last : ∀ l : Fin N, Q m_last l = u_star l := by
    intro l
    simp only [Q, Matrix.mul_apply, hU_last, S_mat, Matrix.of_apply]
    rw [Finset.sum_eq_single (π l)]
    · simp [w, π, Equiv.swap_apply_self]
    · intro k _ hk
      simp [hk]
    · intro hmem
      exact absurd (Finset.mem_univ (π l)) hmem
  let P_K : Matrix (Fin N) (Fin N) K := P.map ι
  let Q_K : Matrix (Fin N) (Fin N) K := Q.map ι
  have hQP_K : Q_K * P_K = 1 := by
    dsimp [P_K, Q_K]
    rw [← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply, ← map_mul, hQP, map_one]
  have hQK_last_dot : ∀ x : Fin N → K,
      (Q_K.mulVec x) m_last * v_star j_max = dotProduct x v_star := by
    intro x
    simp only [Matrix.mulVec, dotProduct, Q_K, Matrix.map_apply, hQ_last, Finset.sum_mul]
    refine Finset.sum_congr rfl fun l _ => ?_
    calc (ι (u_star l) * x l) * v_star j_max
        = x l * (ι (u_star l) * v_star j_max) := by ring
      _ = x l * v_star l := by rw [hu_scale l]
  have hE_perp_QK : ∀ x : Fin N → K, x ∈ E_perp ↔ (Q_K.mulVec x) m_last = 0 := by
    intro x
    rw [hE_perp_eq x]
    change dotProduct x v_star = 0 ↔ (Q_K.mulVec x) m_last = 0
    rw [← hQK_last_dot x, mul_eq_zero, or_iff_left hv_max_ne]
  have hRow_last_mul : ∀ (A B : Matrix (Fin N) (Fin N) 𝒪),
      (∀ k : Fin N, k ≠ m_last → A m_last k = 0) →
      ∀ j : Fin N, (A * B) m_last j = A m_last m_last * B m_last j := by
    intro A B hA j
    rw [Matrix.mul_apply, Finset.sum_eq_single m_last]
    · intro k _ hk
      rw [hA k hk, zero_mul]
    · intro hmem
      exact absurd (Finset.mem_univ m_last) hmem
  let e_vec : Fin N → (Fin N → K) := fun j => Pi.single j 1
  have he_last : e_vec m_last m_last = 1 := Pi.single_eq_same m_last 1
  let c_vec : Fin N → (Fin N → K) := fun j => P_K.mulVec (e_vec j)
  have hQK_c : ∀ j : Fin N, Q_K.mulVec (c_vec j) = e_vec j := by
    intro j
    dsimp [c_vec]
    rw [Matrix.mulVec_mulVec, hQP_K, Matrix.one_mulVec]
  have hc_perp : ∀ j : Fin N, j ≠ m_last → c_vec j ∈ E_perp := by
    intro j hj
    rw [hE_perp_QK, hQK_c]
    exact Pi.single_eq_of_ne hj.symm 1
  have hEntry_QK : ∀ (M : Matrix (Fin N) (Fin N) 𝒪) (i j : Fin N),
      ι ((Q * M * P) i j) = (Q_K.mulVec ((M.map ι).mulVec (c_vec j))) i := by
    intro M i j
    have hmap : (Q * M * P).map ι = Q_K * (M.map ι) * P_K := by
      dsimp [P_K, Q_K]
      simp only [← RingHom.mapMatrix_apply, map_mul]
    calc ι ((Q * M * P) i j)
        = ((Q * M * P).map ι) i j := rfl
      _ = ((Q_K * (M.map ι) * P_K).mulVec (e_vec j)) i := by
          rw [hmap, Matrix.mulVec_single_one]; rfl
      _ = (Q_K.mulVec ((M.map ι).mulVec (c_vec j))) i := by
          dsimp [c_vec]
          rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, Matrix.mul_assoc]
  let F_adap : Matrix (Fin N) (Fin N) 𝒪 := Q * F_V_u.val * P
  let F_adap_inv : Matrix (Fin N) (Fin N) 𝒪 := Q * (F_V_u⁻¹).val * P
  have hConj_mul : ∀ A B : Matrix (Fin N) (Fin N) 𝒪,
      (Q * A * P) * (Q * B * P) = Q * (A * B) * P := by
    intro A B
    calc (Q * A * P) * (Q * B * P)
        = Q * A * (P * Q) * B * P := by simp only [Matrix.mul_assoc]
      _ = Q * (A * B) * P := by rw [hPQ, Matrix.mul_one]; simp only [Matrix.mul_assoc]
  have hFadap_mul_inv : F_adap * F_adap_inv = 1 := by
    dsimp [F_adap, F_adap_inv]
    rw [hConj_mul, Units.mul_inv, Matrix.mul_one, hQP]
  have hFadap_bot : ∀ j : Fin N, j ≠ m_last → F_adap m_last j = 0 := by
    intro j hj
    apply hι_inj
    rw [map_zero, hEntry_QK]
    exact (hE_perp_QK _).mp (hFVu_perp (c_vec j) (hc_perp j hj))
  let μ₀ : 𝒪 := F_adap m_last m_last
  let ν₀ : 𝒪 := F_adap_inv m_last m_last
  have hμν : μ₀ * ν₀ = 1 := by
    have h1 := hRow_last_mul F_adap F_adap_inv hFadap_bot m_last
    rw [hFadap_mul_inv, Matrix.one_apply_eq] at h1
    exact h1.symm
  let μ_F : 𝒪ˣ := ⟨μ₀, ν₀, hμν, mul_comm μ₀ ν₀ ▸ hμν⟩
  have hFadap_pow_conj : ∀ e : ℕ, F_adap ^ e = Q * (F_V_u.val ^ e) * P := by
    intro e
    induction e with
    | zero =>
      rw [pow_zero, pow_zero, Matrix.mul_one, hQP]
    | succ e ih =>
      rw [pow_succ', pow_succ', ih]
      exact hConj_mul F_V_u.val (F_V_u.val ^ e)
  have hFadap_pow_bot : ∀ (e : ℕ) (j : Fin N), j ≠ m_last → (F_adap ^ e) m_last j = 0 := by
    intro e
    induction e with
    | zero =>
      intro j hj
      exact Matrix.one_apply_ne hj.symm
    | succ e ih =>
      intro j hj
      rw [pow_succ', hRow_last_mul F_adap (F_adap ^ e) hFadap_bot j, ih j hj, mul_zero]
  have hμ_sq : (μ_F.val : 𝒪) ^ 2 = ((Nat.card F : 𝒪) ^ q_wt) ^ 2 := by
    apply hι_inj
    have hsq_entry : (F_adap ^ 2) m_last m_last = μ_F.val ^ 2 := by
      rw [sq, sq]
      exact hRow_last_mul F_adap F_adap hFadap_bot m_last
    have hdot1 : dotProduct (((F_V_u.val ^ 2).map ι).mulVec (c_vec m_last)) v_star =
        ι (μ_F.val ^ 2) * v_star j_max := by
      rw [← hQK_last_dot, ← hEntry_QK (F_V_u.val ^ 2) m_last m_last,
        ← hFadap_pow_conj 2, hsq_entry]
    have hdot2 : dotProduct (((Nat.card F : K) ^ (2 * q_wt)) • c_vec m_last) v_star =
        ((Nat.card F : K) ^ (2 * q_wt)) * v_star j_max := by
      rw [smul_dotProduct, smul_eq_mul, ← hQK_last_dot, hQK_c, he_last, one_mul]
    have hfrob := hFrob_sq_inf (c_vec m_last)
    change dotProduct (((F_V_u.val ^ 2).map ι).mulVec (c_vec m_last) -
      ((Nat.card F : K) ^ (2 * q_wt)) • c_vec m_last) v_star = 0 at hfrob
    rw [sub_dotProduct, hdot1, hdot2, ← sub_mul, mul_eq_zero, or_iff_left hv_max_ne,
      sub_eq_zero] at hfrob
    calc ι (μ_F.val ^ 2) = (Nat.card F : K) ^ (2 * q_wt) := hfrob
      _ = ((Nat.card F : K) ^ q_wt) ^ 2 := by rw [mul_comm 2 q_wt, pow_mul]
      _ = ι (((Nat.card F : 𝒪) ^ q_wt) ^ 2) := by simp only [map_pow, map_natCast]
  have hGV_adap_left : ∀ g ∈ G_V, ∀ (i j : Fin N), j ≠ m_last →
      (Q * g.val * P) i j = if i = j then 1 else 0 := by
    intro g hg i j hj
    apply hι_inj
    rw [hEntry_QK, hGV_perp g hg (c_vec j) (hc_perp j hj), hQK_c]
    dsimp [e_vec]
    rw [Pi.single_apply, apply_ite ι, map_one, map_zero]
  have hGV_adap_bot_last : ∀ g ∈ G_V, (Q * g.val * P) m_last m_last = 1 := by
    intro g hg
    have hmem := hGV_quot_iso g hg (c_vec m_last)
    rw [hE_perp_QK, Matrix.mulVec_sub, Pi.sub_apply, ← hEntry_QK g.val m_last m_last,
      hQK_c, he_last, sub_eq_zero] at hmem
    apply hι_inj
    rwa [map_one]
  have hGV_Fpow_bot : ∀ g ∈ G_V, ∀ (e : ℕ) (j : Fin N), j ≠ m_last →
      (Q * (g.val * F_V_u.val ^ e) * P) m_last j = 0 := by
    intro g hg e j hj
    rw [← hConj_mul, ← hFadap_pow_conj e]
    have hg_bot : ∀ k : Fin N, k ≠ m_last → (Q * g.val * P) m_last k = 0 := by
      intro k hk
      rw [hGV_adap_left g hg m_last k hk, if_neg hk.symm]
    rw [hRow_last_mul (Q * g.val * P) (F_adap ^ e) hg_bot j, hFadap_pow_bot e j hj, mul_zero]
  refine ⟨M₀, hSum, P_chg, μ_F, hμ_sq, ?_⟩
  intro R₀ r B_r _ _ _ _ _ _ _ _ ρ_r a₀ ha₀ hG_mem Q_u σ_u hQu_max hQu_comap hσu_frob hσu_mat A_adap
  let Δ_aff : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)
  letI : Ideal.IsMaximal Q_u := hQu_max
  letI : Field (B_r ⧸ Q_u) := Ideal.Quotient.field Q_u
  let π_Q : B_r →+* (B_r ⧸ Q_u) := Ideal.Quotient.mk Q_u
  have hPoly_mod : ∀ p : Polynomial F,
      π_Q (algebraMap (Polynomial F) B_r p) = algebraMap F (B_r ⧸ Q_u) (p.eval a₀) := by
    intro p
    have hroot : (p - Polynomial.C (p.eval a₀)).IsRoot a₀ := by
      rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_C, sub_self]
    obtain ⟨q_p, hq_p⟩ := Polynomial.dvd_iff_isRoot.mpr hroot
    have hX_mem : Polynomial.X - Polynomial.C a₀ ∈
        Ideal.comap (algebraMap (Polynomial F) B_r) Q_u := by
      rw [hQu_comap]
      exact Ideal.mem_span_singleton_self _
    have hX_Qu : algebraMap (Polynomial F) B_r (Polynomial.X - Polynomial.C a₀) ∈ Q_u := hX_mem
    have hdiff_Qu : algebraMap (Polynomial F) B_r p - algebraMap F B_r (p.eval a₀) ∈ Q_u := by
      have hC : algebraMap (Polynomial F) B_r (Polynomial.C (p.eval a₀)) =
          algebraMap F B_r (p.eval a₀) := by
        rw [← Polynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply F (Polynomial F) B_r]
      rw [← hC, ← map_sub, hq_p, map_mul]
      exact Q_u.mul_mem_right _ hX_Qu
    have hq0 : π_Q (algebraMap (Polynomial F) B_r p - algebraMap F B_r (p.eval a₀)) = 0 :=
      (Ideal.Quotient.eq_zero_iff_mem).mpr hdiff_Qu
    rw [map_sub, sub_eq_zero] at hq0
    exact hq0
  have hΔ_ev : Δ_aff.eval a₀ ≠ 0 := by
    rw [show Δ_aff = ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F) from rfl,
      Polynomial.eval_prod, Finset.prod_ne_zero_iff]
    intro s hs
    rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_ne_zero]
    intro heq
    exact ha₀ (heq ▸ hs)
  have hR0_mod : ∀ r₀ : R₀, ∃ c : F,
      π_Q (algebraMap R₀ B_r r₀) = algebraMap F (B_r ⧸ Q_u) c := by
    intro r₀
    obtain ⟨n, p, hpn⟩ := IsLocalization.Away.surj Δ_aff r₀
    have hmap := congrArg (fun z : R₀ => π_Q (algebraMap R₀ B_r z)) hpn
    simp only [map_mul, map_pow, ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B_r,
      hPoly_mod] at hmap
    have hd_ne : (Δ_aff.eval a₀) ^ n ≠ 0 := pow_ne_zero n hΔ_ev
    refine ⟨p.eval a₀ * ((Δ_aff.eval a₀) ^ n)⁻¹, ?_⟩
    rw [map_mul, ← hmap, mul_assoc, ← map_pow, ← map_mul, mul_inv_cancel₀ hd_ne, map_one, mul_one]
  obtain ⟨S_gen, hS_fin, hS_span⟩ :=
    Submodule.fg_def.mp (Module.Finite.fg_top (R := R₀) (M := B_r))
  let T_gen : Set (B_r ⧸ Q_u) := π_Q '' S_gen
  let M_F : Submodule F (B_r ⧸ Q_u) := Submodule.span F T_gen
  let W_sub : Submodule R₀ B_r :=
    { carrier := { b : B_r | π_Q b ∈ M_F }
      zero_mem' := by simp [M_F.zero_mem]
      add_mem' := fun {a b} ha hb => by
        change π_Q (a + b) ∈ M_F
        rw [map_add]
        exact M_F.add_mem ha hb
      smul_mem' := fun r₀ {b} hb => by
        change π_Q (r₀ • b) ∈ M_F
        obtain ⟨c, hc⟩ := hR0_mod r₀
        rw [Algebra.smul_def, map_mul, hc, ← Algebra.smul_def]
        exact M_F.smul_mem c hb }
  have hW_top : (⊤ : Submodule R₀ B_r) ≤ W_sub := by
    rw [← hS_span, Submodule.span_le]
    intro s hs
    exact Submodule.subset_span ⟨s, hs, rfl⟩
  have hMF_top : M_F = ⊤ := by
    rw [eq_top_iff]
    intro y _
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact hW_top Submodule.mem_top
  letI : Module.Finite F (B_r ⧸ Q_u) :=
    ⟨Submodule.fg_def.mpr ⟨T_gen, hS_fin.image π_Q, hMF_top⟩⟩
  letI : Finite (B_r ⧸ Q_u) := Module.finite_of_finite F
  let K_const := ↥(integralClosure F B_r)
  letI : Algebra.IsIntegral F K_const := IsIntegralClosure.isIntegral_algebra F B_r
  letI : Field K_const :=
    (isField_of_isIntegral_of_isField' (R := F) (S := K_const) (Field.toIsField F)).toField
  let ι_KQ : K_const →+* (B_r ⧸ Q_u) := π_Q.comp (integralClosure F B_r).val
  letI : Finite K_const := Finite.of_injective ι_KQ ι_KQ.injective
  letI : Fintype F := Fintype.ofFinite F
  let bK := Module.Basis.ofVectorSpace F K_const
  letI : Finite ↥(Module.Basis.ofVectorSpaceIndex F K_const) :=
    Finite.of_injective bK bK.injective
  letI : Module.Finite F K_const := Module.Finite.of_basis bK
  letI : Algebra.IsAlgebraic F K_const := Algebra.IsAlgebraic.of_finite F K_const
  letI : IsScalarTower F R₀ B_r := IsScalarTower.of_algebraMap_eq fun c => by
    rw [IsScalarTower.algebraMap_apply F (Polynomial F) B_r c,
      IsScalarTower.algebraMap_apply F (Polynomial F) R₀ c,
      ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B_r]
  let resK : (B_r ≃ₐ[R₀] B_r) →* (K_const ≃ₐ[F] K_const) :=
    { toFun := fun τ => (τ.restrictScalars F).mapIntegralClosure
      map_one' := by ext x; rfl
      map_mul' := fun τ₁ τ₂ => by ext x; rfl }
  have hresK_inv : (resK σ_u)⁻¹ = FiniteField.frobeniusAlgEquivOfAlgebraic F K_const := by
    apply AlgEquiv.ext
    intro c
    apply ι_KQ.injective
    apply sub_eq_zero.mp
    rw [← map_sub]
    have hcoe1 : (((resK σ_u)⁻¹) c).1 = σ_u.symm c.1 := by
      rw [← map_inv]
      rfl
    have hcoe2 : ((FiniteField.frobeniusAlgEquivOfAlgebraic F K_const) c).1 = c.1 ^ Nat.card F := by
      rw [FiniteField.coe_frobeniusAlgEquivOfAlgebraic, ← Nat.card_eq_fintype_card]
      rfl
    change π_Q ((((resK σ_u)⁻¹) c).1 -
      ((FiniteField.frobeniusAlgEquivOfAlgebraic F K_const) c).1) = 0
    rw [hcoe1, hcoe2, Ideal.Quotient.eq_zero_iff_mem]
    exact hσu_frob c.1
  letI : Finite (K_const ≃ₐ[F] K_const) :=
    Finite.of_injective (fun g : K_const ≃ₐ[F] K_const => (g : K_const → K_const))
      DFunLike.coe_injective
  have hzpow_top : Subgroup.zpowers (resK σ_u) = ⊤ := by
    apply Subgroup.eq_top_of_card_eq
    rw [Nat.card_zpowers, ← orderOf_inv, hresK_inv,
      FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic F K_const,
      IsGalois.card_aut_eq_finrank F K_const]
  have hFactor : ∀ τ : B_r ≃ₐ[R₀] B_r,
      ∃ (e : ℕ) (τ_geom : B_r ≃ₐ[R₀] B_r),
        τ = τ_geom * σ_u ^ e ∧ (∀ x : B_r, IsIntegral F x → τ_geom x = x) := by
    intro τ
    have hmem_zpow : resK τ ∈ Subgroup.zpowers (resK σ_u) := by
      rw [hzpow_top]
      exact Subgroup.mem_top _
    have hmem_pow : resK τ ∈ Submonoid.powers (resK σ_u) :=
      (IsOfFinOrder.mem_powers_iff_mem_zpowers (isOfFinOrder_of_finite (resK σ_u))).mpr hmem_zpow
    rw [Submonoid.mem_powers_iff] at hmem_pow
    obtain ⟨e, he⟩ := hmem_pow
    let τ_geom : B_r ≃ₐ[R₀] B_r := τ * (σ_u ^ e)⁻¹
    refine ⟨e, τ_geom, (inv_mul_cancel_right τ (σ_u ^ e)).symm, fun x hx => ?_⟩
    have hres_geom : resK τ_geom = 1 := by
      dsimp [τ_geom]
      rw [map_mul, map_inv, map_pow, he, mul_inv_cancel]
    let xK : K_const := ⟨x, (mem_integralClosure_iff F B_r).mpr hx⟩
    exact congrArg Subtype.val (AlgEquiv.congr_fun hres_geom xK)
  let π_r : 𝒪 →+* ZMod (ℓ ^ (r + 1)) := PadicInt.toZModPow (r + 1)
  have hA_adap_eq : ∀ (τ : B_r ≃ₐ[R₀] B_r) (M : Matrix (Fin N) (Fin N) 𝒪),
      (ρ_r τ).val = M.map π_r → A_adap τ = (Q * M * P).map π_r := by
    intro τ M hM
    dsimp [A_adap]
    have hQ_val : (P_chg⁻¹).val = Q := rfl
    have hP_val : P_chg.val = P := rfl
    rw [hQ_val, hP_val, hM, ← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply,
      ← RingHom.mapMatrix_apply, ← map_mul, ← map_mul, RingHom.mapMatrix_apply]
  refine ⟨?_, ?_, ?_⟩
  · intro τ j hj
    obtain ⟨e, τ_geom, hτ_eq, hτ_geom⟩ := hFactor τ
    obtain ⟨g, hg, hg_mat⟩ := hG_mem τ_geom hτ_geom
    have hρ_τ : (ρ_r τ).val = (g.val * F_V_u.val ^ e).map π_r := by
      rw [hτ_eq, map_mul, map_pow, Units.val_mul, Units.val_pow_eq_pow_val, hg_mat, hσu_mat,
        ← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply, ← map_pow, ← map_mul,
        RingHom.mapMatrix_apply]
    rw [hA_adap_eq τ (g.val * F_V_u.val ^ e) hρ_τ]
    change π_r ((Q * (g.val * F_V_u.val ^ e) * P) m_last j) = 0
    rw [hGV_Fpow_bot g hg e j ((hj_lt_iff j).mp hj), map_zero]
  · intro τ hτ
    obtain ⟨g, hg, hg_mat⟩ := hG_mem τ hτ
    have hA_g := hA_adap_eq τ g.val hg_mat
    refine ⟨?_, ?_⟩
    · intro i j _ hj
      rw [hA_g, Matrix.map_apply, hGV_adap_left g hg i j ((hj_lt_iff j).mp hj),
        apply_ite π_r, map_one, map_zero]
    · rw [hA_g]
      change π_r ((Q * g.val * P) m_last m_last) = 1
      rw [hGV_adap_bot_last g hg, map_one]
  · rw [hA_adap_eq σ_u F_V_u.val hσu_mat]
    change π_r (F_adap m_last m_last) = π_r μ_F.val
    rfl

theorem weil_mid_dev_iso_open_exact_and_push_devissage (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (ℓ r N M₀ : ℕ) [Fact (Nat.Prime ℓ)] (hSum : M₀ + 1 = N) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∀ (B_r L_r : Type u) [CommRing B_r] [IsDomain B_r] [Field L_r]
      [Algebra F B_r] [Algebra (Polynomial F) B_r] [Algebra R₀ B_r]
      [Algebra F L_r] [Algebra (Polynomial F) L_r] [Algebra (RatFunc F) L_r]
      [Algebra B_r L_r] [Algebra R₀ L_r]
      [IsScalarTower F (Polynomial F) B_r] [IsScalarTower (Polynomial F) R₀ B_r]
      [IsScalarTower F (RatFunc F) L_r] [IsScalarTower (Polynomial F) (RatFunc F) L_r]
      [IsScalarTower (Polynomial F) B_r L_r] [IsScalarTower R₀ B_r L_r]
      [Module.Finite R₀ B_r] [Algebra.Etale R₀ B_r]
      [IsFractionRing B_r L_r] [IsIntegralClosure B_r R₀ L_r]
      [FiniteDimensional (RatFunc F) L_r] [IsGalois (RatFunc F) L_r]
      (ρ_V_r : (B_r ≃ₐ[R₀] B_r) →* (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))))ˣ)
      (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme)
      (𝒱_r : CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
      (triv_V : ∀ W : U₀.toScheme.Etale,
        let π_r : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B_r)) U₀.toScheme :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r))) e_U.hom
        let W_r := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom π_r
        ↑(𝒱_r.obj.obj (Opposite.op W)) →+
          LocallyConstant ↥W_r (Fin N → ZMod (ℓ ^ (r + 1)))),
      (let π_r : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B_r)) U₀.toScheme :=
         CategoryTheory.CategoryStruct.comp
           (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_r))) e_U.hom
       (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
         let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
         let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
         ∀ (u_r : Quiver.Hom
             (CategoryTheory.Limits.pullback h₁ π_r)
             (CategoryTheory.Limits.pullback h₂ π_r)),
           CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.fst h₂ π_r) =
             CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst h₁ π_r)
               ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
           CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.snd h₂ π_r) =
             CategoryTheory.Limits.pullback.snd h₁ π_r →
           ∀ (s : ↑(𝒱_r.obj.obj (Opposite.op W₂)))
             (y₁ : ↥(CategoryTheory.Limits.pullback h₁ π_r)),
             triv_V W₁ ((𝒱_r.obj.map (Opposite.op u)) s) y₁ = triv_V W₂ s (u_r.base y₁)) ∧
       (∀ W : U₀.toScheme.Etale,
         let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
         let W_r := CategoryTheory.Limits.pullback h_W π_r
